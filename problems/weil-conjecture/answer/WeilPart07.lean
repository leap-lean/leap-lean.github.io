            φ_open.base ⁻¹' closure ({η_E} : Set ↥X) := by
          refine closure_minimal ?_ (isClosed_closure.preimage φ_open.continuous)
          rw [Set.singleton_subset_iff]
          change φ_open.base q_η ∈ closure ({η_E} : Set ↥X)
          rw [hφ_qη]
          exact subset_closure (Set.mem_singleton η_E)
        exact h_pre_sub hw_cl
      exact ⟨z, hz_mem_E, hz_ne⟩
    by_contra hNotNonempty
    have hSub : E ⊆ (U_aff : Set ↥X) := fun y hy => by
      by_contra hy_not
      exact hNotNonempty ⟨y, hy, hy_not⟩
    have hE_cl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
    let I_E := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨E, hE_cl⟩
    let E_sch := I_E.subscheme
    let ι_E : E_sch ⟶ X := I_E.subschemeι
    have _ : AlgebraicGeometry.IsClosedImmersion ι_E := inferInstance
    have hRange : Set.range ι_E.base = E :=
      (I_E.range_subschemeι).trans (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal ⟨E, hE_cl⟩)
    have hPre_top : (TopologicalSpace.Opens.map ι_E.base).obj U_aff = ⊤ := by
      ext w
      simp only [TopologicalSpace.Opens.map_coe, Set.mem_preimage, SetLike.mem_coe,
        TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      exact hSub (hRange ▸ ⟨w, rfl⟩)
    have hAff_pre : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map ι_E.base).obj U_aff) :=
      hAff.preimage ι_E
    rw [hPre_top] at hAff_pre
    have _ : AlgebraicGeometry.IsAffine (⊤ : E_sch.Opens).toScheme := hAff_pre
    have _ : AlgebraicGeometry.IsAffine E_sch :=
      AlgebraicGeometry.isAffine_of_isAffineHom E_sch.topIso.inv
    let π_E : E_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of K') := ι_E ≫ f
    have _ : AlgebraicGeometry.IsProper π_E := inferInstance
    have _ : AlgebraicGeometry.IsAffineHom π_E := AlgebraicGeometry.isAffineHom_of_isAffine π_E
    have hFin_π : AlgebraicGeometry.IsFinite π_E :=
      AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨inferInstance, inferInstance⟩
    have hFin_app : (π_E.app ⊤).hom.Finite :=
      ((AlgebraicGeometry.isFinite_iff π_E).mp hFin_π).2 ⊤ (isAffineOpen_top _)
    let e_K' : K' ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of K')).presheaf.obj (Opposite.op ⊤)) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).symm.commRingCatIsoToRingEquiv
    have hFin_hom : ((π_E.app ⊤).hom.comp e_K'.toRingHom).Finite :=
      RingHom.finite_respectsIso.right (π_E.app ⊤).hom e_K' hFin_app
    let A_E : Type u := ↑(E_sch.presheaf.obj (Opposite.op ⊤))
    let _ : Algebra K' A_E := ((π_E.app ⊤).hom.comp e_K'.toRingHom).toAlgebra
    have _ : Module.Finite K' A_E := RingHom.finite_algebraMap.mp hFin_hom
    have _ : Algebra.IsIntegral K' A_E := Algebra.IsIntegral.of_finite K' A_E
    have hClosed_pt : ∀ 𝔭 : PrimeSpectrum A_E, IsClosed ({𝔭} : Set (PrimeSpectrum A_E)) := by
      intro 𝔭
      have _ : 𝔭.asIdeal.IsPrime := 𝔭.isPrime
      have _ : Algebra.IsIntegral K' (A_E ⧸ 𝔭.asIdeal) :=
        ⟨fun y => Quotient.inductionOn' y fun a =>
          (Algebra.IsIntegral.isIntegral (R := K') a).map (Ideal.Quotient.mkₐ K' 𝔭.asIdeal)⟩
      have hInj : Function.Injective (algebraMap K' (A_E ⧸ 𝔭.asIdeal)) := RingHom.injective _
      have hField : IsField (A_E ⧸ 𝔭.asIdeal) :=
        (Algebra.IsIntegral.isField_iff_isField hInj).mp (Field.toIsField K')
      have hMax : 𝔭.asIdeal.IsMaximal := Ideal.Quotient.maximal_of_isField 𝔭.asIdeal hField
      exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal 𝔭).mpr hMax
    obtain ⟨w_η, hw_η⟩ : ∃ w : ↥E_sch, ι_E.base w = η_E := by
      rw [← Set.mem_range, hRange]
      exact hη_mem
    let 𝔭_η : PrimeSpectrum A_E := E_sch.isoSpec.hom.base w_η
    have hw_closed : IsClosed ({w_η} : Set ↥E_sch) := by
      have h_pre : E_sch.isoSpec.hom.base ⁻¹' ({𝔭_η} : Set (PrimeSpectrum A_E)) = {w_η} := by
        ext w
        simp only [Set.mem_singleton_iff]
        constructor
        · intro h_eq
          have h_inv := congrArg E_sch.isoSpec.inv.base h_eq
          change (E_sch.isoSpec.hom ≫ E_sch.isoSpec.inv).base w =
            (E_sch.isoSpec.hom ≫ E_sch.isoSpec.inv).base w_η at h_inv
          rw [E_sch.isoSpec.hom_inv_id] at h_inv
          exact h_inv
        · rintro rfl
          rfl
      rw [← h_pre]
      exact (hClosed_pt 𝔭_η).preimage E_sch.isoSpec.hom.continuous
    have hη_closed : IsClosed ({η_E} : Set ↥X) := by
      have h_img : ι_E.base '' ({w_η} : Set ↥E_sch) = {η_E} := by
        rw [Set.image_singleton, hw_η]
      rw [← h_img]
      exact ι_E.isClosedEmbedding.isClosedMap {w_η} hw_closed
    have hE_singleton : E = {η_E} := by
      rw [← hη_cl, hη_closed.closure_eq]
    obtain ⟨z, hz_E, hz_ne⟩ := hz_exists
    rw [hE_singleton, Set.mem_singleton_iff] at hz_E
    exact hz_ne hz_E
  have _ : AlgebraicGeometry.IsProper g := hSemi.1.2.2.1
  have _ : AlgebraicGeometry.LocallyOfFinitePresentation g := hSemi.1.2.2.2.1
  have _ : AlgebraicGeometry.IsProper snd_s := inferInstance
  have _ : AlgebraicGeometry.LocallyOfFinitePresentation snd_s := inferInstance
  have _ : CompactSpace ↥X_s :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace snd_s
  have hCov : ∀ y : ↥X_s, HasSpreadSmoothOrNodalAt snd_s y := (hSemi.2.2.2 K' s).2
  have hRed : AlgebraicGeometry.IsReduced X_s := hPart1 X_s snd_s hCov
  obtain ⟨hSingFin, hGenSm⟩ := hPart2 X_s snd_s hCov
  refine ⟨hRed, hSingFin, ?_⟩
  intro E hE
  obtain ⟨η_E, hη_mem, hη_cl, V_sm, hη_V, hSm⟩ := hGenSm E hE
  exact ⟨⟨η_E, hη_mem, hη_cl, V_sm, hη_V, hSm⟩,
    fun U_aff hAff => hPart3 X_s snd_s E hE η_E hη_mem hη_cl V_sm hη_V hSm U_aff hAff⟩

theorem weil_sup1_complementary_subscheme_nodal_branch_smooth (K : Type u) [Field K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ) :
    let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
    let Y := CategoryTheory.Limits.pullback g s₀
    let sndY := CategoryTheory.Limits.pullback.snd g s₀
    let Y'_set : Set ↥Y := ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E'
    let Δ : Set ↥Y := Z ∩ Y'_set
    let A_nod : Type u :=
      MvPolynomial (Fin 2) k₀ ⧸
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) k₀))
    let c_nod : k₀ →+* A_nod := (Ideal.Quotient.mk _).comp MvPolynomial.C
    (∀ (S₀ : Type u) [CommRing S₀] [Algebra k₀ S₀] [Algebra.FinitePresentation k₀ S₀]
        (p : Ideal S₀) [p.IsPrime]
        (T₀ : Type u) [CommRing T₀] [Algebra k₀ T₀] [Algebra S₀ T₀]
        [IsScalarTower k₀ S₀ T₀] [Algebra.Etale S₀ T₀]
        (q : Ideal T₀) [q.IsPrime],
      p = Ideal.comap (algebraMap S₀ T₀) q →
      ∀ (φ_poly : Polynomial k₀ →+* T₀),
        φ_poly.Etale →
        φ_poly.comp Polynomial.C = algebraMap k₀ T₀ →
        ∃ f : S₀, f ∉ p ∧
          RingHom.IsStandardSmoothOfRelativeDimension 1
            (algebraMap k₀ (Localization.Away f))) →
    (∀ (R B : Type u) [CommRing R] [IsNoetherianRing R] [IsReduced R]
        [CommRing B] [Algebra R B] [Algebra.Etale R B], IsReduced B) →
    (∀ (B : Type u) [CommRing B] (φ₂ : A_nod →+* B),
      φ₂.Etale →
      ∀ (q : Ideal B) [q.IsPrime],
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈ q →
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∈ q →
        (let B_q := Localization.AtPrime q
         let 𝔓 : Fin 2 → Ideal B_q := fun i =>
           Ideal.span ({algebraMap B B_q (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)))} : Set B_q)
         (𝔓 0).IsPrime ∧ (𝔓 1).IsPrime ∧
         ¬ (𝔓 0 ≤ 𝔓 1) ∧ ¬ (𝔓 1 ≤ 𝔓 0) ∧
         (∀ Q : Ideal B_q, Q.IsPrime → 𝔓 0 ≤ Q ∨ 𝔓 1 ≤ Q) ∧
         (∀ (i : Fin 2) (Q : Ideal B_q),
           Q.IsPrime → 𝔓 i ≤ Q → Q = 𝔓 i ∨ Q = IsLocalRing.maximalIdeal B_q)) ∧
        (∀ i : Fin 2,
          ∃ ψ_q : Polynomial k₀ →+*
              (B ⧸ Ideal.span ({φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))} : Set B)),
            ψ_q.Etale ∧
            ψ_q.comp Polynomial.C = (Ideal.Quotient.mk _).comp (φ₂.comp c_nod))) →
    ∃ (Y'_sch : AlgebraicGeometry.Scheme.{u}) (ιY' : Y'_sch ⟶ Y),
      AlgebraicGeometry.IsClosedImmersion ιY' ∧
      AlgebraicGeometry.IsReduced Y'_sch ∧
      Set.range ιY'.base = Y'_set ∧
      ∀ q : ↥Y'_sch, ιY'.base q ∈ Δ →
        ∃ V_sm : Y'_sch.Opens,
          q ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ ιY' ≫ sndY) :=
by
  intro k₀ s₀ Y sndY Y'_set Δ A_nod c_nod hEtaleDesc hRedEtale hNodalBranch
  
  have hPillar1 : ∀ (Y₀ : AlgebraicGeometry.Scheme.{u})
      (snd₀ : Y₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
      (S_cl : Set ↥Y₀) (hCl : IsClosed S_cl),
      let I : Y₀.IdealSheafData :=
        AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨S_cl, hCl⟩
      AlgebraicGeometry.IsClosedImmersion I.subschemeι ∧
      AlgebraicGeometry.IsReduced I.subscheme ∧
      Set.range I.subschemeι.base = S_cl ∧
      (∀ (q : ↥I.subscheme) (W_Y : Y₀.Opens) (hW_Y : AlgebraicGeometry.IsAffineOpen W_Y)
          (hy : I.subschemeι.base q ∈ W_Y),
        let S : Type u := ↑(Y₀.presheaf.obj (Opposite.op W_Y))
        letI : Algebra k₀ S :=
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
            snd₀.appLE ⊤ W_Y (fun _ _ => trivial)).hom.toAlgebra
        let p_y : Ideal S := (hW_Y.primeIdealOf ⟨I.subschemeι.base q, hy⟩).asIdeal
        let I_S : Ideal S := I.ideal ⟨W_Y, hW_Y⟩
        ∀ (f : S), f ∉ p_y →
          RingHom.IsStandardSmoothOfRelativeDimension 1
            (algebraMap k₀ (Localization.Away (Ideal.Quotient.mk I_S f))) →
          ∃ V_sm : I.subscheme.Opens,
            q ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ I.subschemeι ≫ snd₀)) := by
    clear hEtaleDesc hRedEtale hNodalBranch c_nod A_nod Δ Y'_set sndY Y s₀
      hUnstab ιZ Z_sch Z hSemi ι τ g C σ_K n p_K C_K hPkg hMaxNeBot
    intro Y₀ snd₀ S_cl hCl
    let I : Y₀.IdealSheafData :=
      AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨S_cl, hCl⟩
    have hCl_sub : AlgebraicGeometry.IsClosedImmersion I.subschemeι := inferInstance
    have hRange_sub : Set.range I.subschemeι.base = S_cl := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
        AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    have hRed_sub : AlgebraicGeometry.IsReduced I.subscheme := by
      have hStalkLoc : ∀ (X₀ : AlgebraicGeometry.Scheme.{u}) (W₀ : X₀.Opens)
          (hW₀ : AlgebraicGeometry.IsAffineOpen W₀) (x₀ : ↥W₀),
          _root_.IsReduced ↑(X₀.presheaf.obj (Opposite.op W₀)) →
          _root_.IsReduced ↑(X₀.presheaf.stalk x₀.1) := by
        intro X₀ W₀ hW₀ x₀ hRed₀
        haveI : IsLocalization.AtPrime (↑(X₀.presheaf.stalk x₀.1)) (hW₀.primeIdealOf x₀).asIdeal :=
          hW₀.isLocalization_stalk x₀
        exact isReduced_localizationPreserves
          (hW₀.primeIdealOf x₀).asIdeal.primeCompl (↑(X₀.presheaf.stalk x₀.1)) hRed₀
      refine @AlgebraicGeometry.isReduced_of_isReduced_stalk I.subscheme (fun x => ?_)
      obtain ⟨W_Y, hW_Y, hxY, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (TopologicalSpace.Opens.mem_top (I.subschemeι.base x))
      let U : Y₀.affineOpens := ⟨W_Y, hW_Y⟩
      let W' : I.subscheme.Opens := (TopologicalSpace.Opens.map I.subschemeι.base).obj W_Y
      have hW' : AlgebraicGeometry.IsAffineOpen W' := hW_Y.preimage I.subschemeι
      have hx' : x ∈ W' := hxY
      have hRadU : (I.ideal U).IsRadical := by
        rw [AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal]
        exact PrimeSpectrum.isRadical_vanishingIdeal _
      haveI : _root_.IsReduced (↑(Y₀.presheaf.obj (Opposite.op W_Y)) ⧸ I.ideal U) :=
        (Ideal.isRadical_iff_quotient_reduced _).mp hRadU
      let e_sub := (I.subschemeObjIso U).commRingCatIsoToRingEquiv
      have hRedW' : _root_.IsReduced ↑(I.subscheme.presheaf.obj (Opposite.op W')) :=
        isReduced_of_injective e_sub e_sub.injective
      exact hStalkLoc I.subscheme W' hW' ⟨x, hx'⟩ hRedW'
    refine ⟨hCl_sub, hRed_sub, hRange_sub, ?_⟩
    intro q W_Y hW_Y hy S p_y I_S f hf_not hSm_fbar
    let U_aff : Y₀.affineOpens := ⟨W_Y, hW_Y⟩
    let φ_k₀S : k₀ →+* S :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        snd₀.appLE ⊤ W_Y (fun _ _ => trivial)).hom
    letI : Algebra k₀ S := φ_k₀S.toAlgebra
    let p_pt := hW_Y.primeIdealOf ⟨I.subschemeι.base q, hy⟩
    let W' : I.subscheme.Opens := (TopologicalSpace.Opens.map I.subschemeι.base).obj W_Y
    have hW' : AlgebraicGeometry.IsAffineOpen W' := hW_Y.preimage I.subschemeι
    have hq_W' : q ∈ W' := hy
    let S' : Type u := ↑(I.subscheme.presheaf.obj (Opposite.op W'))
    let f' : S' := (I.subschemeι.app W_Y).hom f
    let V_sm : I.subscheme.Opens := I.subscheme.basicOpen f'
    have hq_Vsm : q ∈ V_sm := by
      let p_q := hW'.primeIdealOf ⟨q, hq_W'⟩
      have hSpec_sub := hW_Y.SpecMap_appLE_fromSpec I.subschemeι hW' le_rfl
      have hbase := congrArg (fun h => h.base p_q) hSpec_sub
      change hW_Y.fromSpec.base ((AlgebraicGeometry.Spec.map (I.subschemeι.appLE W_Y W' le_rfl)).base p_q) =
        I.subschemeι.base (hW'.fromSpec.base p_q) at hbase
      have hq_from : hW'.fromSpec.base p_q = q := hW'.fromSpec_primeIdealOf ⟨q, hq_W'⟩
      have hy_from : hW_Y.fromSpec.base p_pt = I.subschemeι.base q :=
        hW_Y.fromSpec_primeIdealOf ⟨I.subschemeι.base q, hy⟩
      rw [hq_from, ← hy_from] at hbase
      have hpq_eq : (AlgebraicGeometry.Spec.map (I.subschemeι.appLE W_Y W' le_rfl)).base p_q = p_pt :=
        (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding hW_Y.fromSpec).injective hbase
      have hf'_not : f' ∉ p_q.asIdeal := by
        intro hmem
        apply hf_not
        have hId := congrArg PrimeSpectrum.asIdeal hpq_eq
        change Ideal.comap (I.subschemeι.appLE W_Y W' le_rfl).hom p_q.asIdeal = p_y at hId
        rw [← hId, Ideal.mem_comap, ← AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
        exact hmem
      have hp_q_bo : p_q ∈ (TopologicalSpace.Opens.map hW'.fromSpec.base).obj V_sm := by
        rw [hW'.fromSpec_preimage_basicOpen f']
        change (p_q : PrimeSpectrum S') ∈ PrimeSpectrum.basicOpen f'
        rw [PrimeSpectrum.mem_basicOpen]
        exact hf'_not
      change hW'.fromSpec.base p_q ∈ V_sm at hp_q_bo
      rwa [hq_from] at hp_q_bo
    refine ⟨V_sm, hq_Vsm, ?_⟩
    have hAff_Vsm : AlgebraicGeometry.IsAffineOpen V_sm := hW'.basicOpen f'
    haveI : AlgebraicGeometry.IsAffine V_sm.toScheme := hAff_Vsm
    refine AlgebraicGeometry.SmoothOfRelativeDimension.mk (fun _ =>
      ⟨⊤, AlgebraicGeometry.isAffineOpen_top _, ⊤, AlgebraicGeometry.isAffineOpen_top _,
        TopologicalSpace.Opens.mem_top _, fun _ _ => trivial, ?_⟩)
    let S₀' : Type u := S ⧸ I_S
    let f_bar : S₀' := Ideal.Quotient.mk I_S f
    let e_sub : S' ≃+* S₀' := (I.subschemeObjIso U_aff).commRingCatIsoToRingEquiv
    have he_sub_app : ∀ a : S, e_sub ((I.subschemeι.app W_Y).hom a) = Ideal.Quotient.mk I_S a := by
      intro a
      have happ : I.subschemeι.app W_Y ≫ (I.subschemeObjIso U_aff).hom =
          CommRingCat.ofHom (Ideal.Quotient.mk I_S) := by
        rw [I.subschemeι_app U_aff, CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.comp_id]
      exact congrArg (fun h => h.hom a) happ
    have he_sub_symm_app : ∀ a : S, e_sub.symm (Ideal.Quotient.mk I_S a) = (I.subschemeι.app W_Y).hom a := by
      intro a
      exact e_sub.injective (by rw [e_sub.apply_symm_apply, he_sub_app])
    have hf'_eq : e_sub.symm f_bar = f' := he_sub_symm_app f
    let R_Vsm : Type u := ↑(I.subscheme.presheaf.obj (Opposite.op V_sm))
    haveI : IsLocalization.Away f' R_Vsm := hW'.isLocalization_basicOpen f'
    have hMapPow : Submonoid.map e_sub.symm.toMonoidHom (Submonoid.powers f_bar) = Submonoid.powers f' := by
      ext y_pow
      simp only [Submonoid.mem_map, Submonoid.mem_powers_iff]
      constructor
      · rintro ⟨_, ⟨d, rfl⟩, rfl⟩
        refine ⟨d, ?_⟩
        change f' ^ d = e_sub.symm (f_bar ^ d)
        rw [map_pow, hf'_eq]
      · rintro ⟨d, rfl⟩
        refine ⟨f_bar ^ d, ⟨d, rfl⟩, ?_⟩
        change e_sub.symm (f_bar ^ d) = f' ^ d
        rw [map_pow, hf'_eq]
    let e_loc : Localization.Away f_bar ≃+* R_Vsm :=
      IsLocalization.ringEquivOfRingEquiv (Localization.Away f_bar) R_Vsm e_sub.symm hMapPow
    let T_top : Type u := ↑(V_sm.toScheme.presheaf.obj (Opposite.op ⊤))
    let e_top : R_Vsm ≃+* T_top := V_sm.topIso.symm.commRingCatIsoToRingEquiv
    let θ : Localization.Away f_bar ≃+* T_top := e_loc.trans e_top
    let φ_top : CommRingCat.of k₀ ⟶ V_sm.toScheme.presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        (V_sm.ι ≫ I.subschemeι ≫ snd₀).appLE ⊤ ⊤ (fun _ _ => trivial)
    have h_le_Vsm : (⊤ : V_sm.toScheme.Opens) ≤ (TopologicalSpace.Opens.map V_sm.ι.base).obj W' := by
      intro x _
      exact I.subscheme.basicOpen_le f' x.2
    have h_Vsm_app : (I.subscheme.presheaf.map
          (CategoryTheory.homOfLE (I.subscheme.basicOpen_le f')).op ≫ V_sm.topIso.inv) =
        V_sm.ι.appLE W' ⊤ h_le_Vsm := by
      refine Eq.trans ?_ (AlgebraicGeometry.Scheme.Opens.ι_appLE V_sm W' ⊤ h_le_Vsm).symm
      refine Eq.trans (congrArg (fun g => I.subscheme.presheaf.map
        (CategoryTheory.homOfLE (I.subscheme.basicOpen_le f')).op ≫ g)
        (AlgebraicGeometry.Scheme.Opens.topIso_inv V_sm)) ?_
      exact (I.subscheme.presheaf.map_comp _ _).symm.trans
        (congrArg (fun u => I.subscheme.presheaf.map u) (Subsingleton.elim _ _))
