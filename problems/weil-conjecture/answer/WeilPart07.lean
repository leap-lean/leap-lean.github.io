    intro S _ φ_RS
    obtain ⟨Φ, _, hPb, _⟩ := hBase_pkg ↥V S φ_RS 1
    exact ⟨Φ, hPb⟩
  
  
  
  have hFib_all : ∀ P : PrimeSpectrum ↥V,
      let s_P := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))
