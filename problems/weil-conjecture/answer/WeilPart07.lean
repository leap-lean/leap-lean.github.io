    have hSm_Vsm : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ f) := by
      have _ : CategoryTheory.IsIso hV_sm.isoSpec.hom := inferInstance
      have _ : AlgebraicGeometry.IsOpenImmersion hV_sm.isoSpec.hom := inferInstance
