        exact ⟨h, rfl⟩
      · right
        have hle : (x : ℕ) ≤ (y : ℕ) := Nat.le_of_not_lt h
        have hlt : x < y.succ := Nat.lt_succ_of_le hle
        rw [Fin.succAbove_of_lt_succ x y hlt]
        exact ⟨hle, rfl⟩
    
    have hex_ins : ∀ (a : Fin (N + 1)) (K : {K : Fin (p + 1) → Fin (N + 1) // StrictMono K}),
        a ∉ Finset.univ.image K.1 →
        ∃ (I' : {I' : Fin (p + 2) → Fin (N + 1) // StrictMono I'}) (r : Fin (p + 2)),
          Finset.univ.image I'.1 = insert a (Finset.univ.image K.1) ∧ I'.1 r = a := by
      intro a K ha
      have hcard : (insert a (Finset.univ.image K.1)).card = p + 2 := by
        rw [Finset.card_insert_of_notMem ha,
          Finset.card_image_of_injective _ K.2.injective, Finset.card_fin]
      let e := (insert a (Finset.univ.image K.1)).orderEmbOfFin hcard
      let I' : {I' : Fin (p + 2) → Fin (N + 1) // StrictMono I'} := ⟨⇑e, e.strictMono⟩
      have himg : Finset.univ.image I'.1 = insert a (Finset.univ.image K.1) :=
        himg_orderEmb _ hcard
      have ha_mem : a ∈ Finset.univ.image I'.1 := by
        rw [himg]
        exact Finset.mem_insert_self a _
      rcases Finset.mem_image.mp ha_mem with ⟨r, _, hr⟩
      exact ⟨I', r, himg, hr⟩
    let Ψ : Fin (N + 1) → {K : Fin (p + 1) → Fin (N + 1) // StrictMono K} → F :=
      fun a K =>
        if ha : a ∈ Finset.univ.image K.1 then 0
        else
          let I' := Classical.choose (hex_ins a K ha)
          let r := Classical.choose (Classical.choose_spec (hex_ins a K ha))
          (-1 : F) ^ (r : ℕ) * ξ I'
    have hΨ_of_mem : ∀ (a : Fin (N + 1)) (K : {K : Fin (p + 1) → Fin (N + 1) // StrictMono K}),
        a ∈ Finset.univ.image K.1 → Ψ a K = 0 := by
      intro a K ha
      dsimp [Ψ]
      exact dif_pos ha
    have hΨ_of_notMem : ∀ (a : Fin (N + 1)) (K : {K : Fin (p + 1) → Fin (N + 1) // StrictMono K})
        (ha : a ∉ Finset.univ.image K.1)
        (I' : {I' : Fin (p + 2) → Fin (N + 1) // StrictMono I'}) (r' : Fin (p + 2)),
        Finset.univ.image I'.1 = insert a (Finset.univ.image K.1) →
        I'.1 r' = a →
        Ψ a K = (-1 : F) ^ (r' : ℕ) * ξ I' := by
      intro a K ha I' r' himg' hr'
      dsimp [Ψ]
      rw [dif_neg ha]
      let I₀ := Classical.choose (hex_ins a K ha)
      let r₀ := Classical.choose (Classical.choose_spec (hex_ins a K ha))
      obtain ⟨himg₀, hr₀⟩ := Classical.choose_spec (Classical.choose_spec (hex_ins a K ha))
      have hr₀' : I₀.1 r₀ = a := hr₀
      have hI_eq : I₀ = I' :=
        Subtype.ext (strictMono_eq_of_image_eq I₀.2 I'.2 (himg₀.trans himg'.symm))
      have hr_eq : r₀ = r' := by
        apply I'.2.injective
        have hval : I'.1 r₀ = a := by rw [← hI_eq]; exact hr₀'
        exact hval.trans hr'.symm
      change (-1 : F) ^ (r₀ : ℕ) * ξ I₀ = (-1 : F) ^ (r' : ℕ) * ξ I'
      rw [hI_eq, hr_eq]
    have hΨ_supp : ∀ (a : Fin (N + 1)) (K : {K : Fin (p + 1) → Fin (N + 1) // StrictMono K}),
        Ψ a K = 0 ∨
        ∃ (I' : {I' : Fin (p + 2) → Fin (N + 1) // StrictMono I'}) (r : ℕ),
          Finset.univ.image I'.1 = insert a (Finset.univ.image K.1) ∧
          Ψ a K = (-1 : F) ^ r * ξ I' := by
      intro a K
      by_cases ha : a ∈ Finset.univ.image K.1
      · exact Or.inl (hΨ_of_mem a K ha)
      · obtain ⟨I', r', himg', hr'⟩ := hex_ins a K ha
        exact Or.inr ⟨I', (r' : ℕ), himg', hΨ_of_notMem a K ha I' r' himg' hr'⟩
    
    have hneg1_sq : ∀ n : ℕ, (-1 : F) ^ n * (-1 : F) ^ n = 1 := by
      intro n
      rw [← mul_pow]
      norm_num
    have hΨ_cob : ∀ (a : Fin (N + 1)) (I : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I}),
        (∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
          Ψ a ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩) = ξ I := by
      intro a I
      let S_I := Finset.univ.image I.1
      by_cases ha : a ∈ S_I
      · rcases Finset.mem_image.mp ha with ⟨q₀, _, hq₀⟩
        rw [Finset.sum_eq_single q₀]
        · let K₀ : {K : Fin (p + 1) → Fin (N + 1) // StrictMono K} :=
            ⟨I.1 ∘ q₀.succAbove, I.2.comp (Fin.strictMono_succAbove q₀)⟩
          have himg_K₀ : Finset.univ.image K₀.1 = S_I.erase a := by
            dsimp [K₀, S_I]
            rw [image_comp_succAbove I.1 I.2 q₀, hq₀]
          have ha_notMem : a ∉ Finset.univ.image K₀.1 := by
            rw [himg_K₀]
            exact Finset.notMem_erase a S_I
          have himg_I : Finset.univ.image I.1 = insert a (Finset.univ.image K₀.1) := by
            rw [himg_K₀, Finset.insert_erase ha]
          have hval := hΨ_of_notMem a K₀ ha_notMem I q₀ himg_I hq₀
          change (-1 : F) ^ (q₀ : ℕ) * Ψ a K₀ = ξ I
          rw [hval, ← mul_assoc, hneg1_sq, one_mul]
        · intro q _ hq_ne
          let K_q : {K : Fin (p + 1) → Fin (N + 1) // StrictMono K} :=
            ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩
          have ha_mem_Kq : a ∈ Finset.univ.image K_q.1 := by
            dsimp [K_q]
            rw [image_comp_succAbove I.1 I.2 q]
            refine Finset.mem_erase.mpr ⟨?_, ha⟩
            intro heq
            exact hq_ne (I.2.injective (heq.symm.trans hq₀.symm))
          change (-1 : F) ^ (q : ℕ) * Ψ a K_q = 0
          rw [hΨ_of_mem a K_q ha_mem_Kq, mul_zero]
        · intro habs
          exact False.elim (habs (Finset.mem_univ q₀))
      · have hcard_J : (insert a S_I).card = p + 3 := by
          dsimp [S_I] at ha ⊢
          rw [Finset.card_insert_of_notMem ha,
            Finset.card_image_of_injective _ I.2.injective, Finset.card_fin]
        let e_J := (insert a S_I).orderEmbOfFin hcard_J
        let J : {J : Fin (p + 3) → Fin (N + 1) // StrictMono J} := ⟨⇑e_J, e_J.strictMono⟩
        have himg_J : Finset.univ.image J.1 = insert a S_I := himg_orderEmb _ hcard_J
        have ha_mem_J : a ∈ Finset.univ.image J.1 := by
          rw [himg_J]
          exact Finset.mem_insert_self a S_I
        rcases Finset.mem_image.mp ha_mem_J with ⟨r₀, _, hr₀⟩
        have hJ_r₀ : (⟨J.1 ∘ r₀.succAbove, J.2.comp (Fin.strictMono_succAbove r₀)⟩ :
            {I' : Fin (p + 2) → Fin (N + 1) // StrictMono I'}) = I := by
          apply Subtype.ext
          apply strictMono_eq_of_image_eq (J.2.comp (Fin.strictMono_succAbove r₀)) I.2
          rw [image_comp_succAbove J.1 J.2 r₀, himg_J, hr₀, Finset.erase_insert ha]
        have hterm_q : ∀ q : Fin (p + 2),
            (-1 : F) ^ (r₀ : ℕ) *
              ((-1 : F) ^ (r₀.succAbove q : ℕ) *
                ξ ⟨J.1 ∘ (r₀.succAbove q).succAbove,
                  J.2.comp (Fin.strictMono_succAbove (r₀.succAbove q))⟩) =
              -((-1 : F) ^ (q : ℕ) *
                Ψ a ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩) := by
          intro q
          let q_tilde : Fin (p + 3) := r₀.succAbove q
          let I'_q : {I' : Fin (p + 2) → Fin (N + 1) // StrictMono I'} :=
            ⟨J.1 ∘ q_tilde.succAbove, J.2.comp (Fin.strictMono_succAbove q_tilde)⟩
          let K_q : {K : Fin (p + 1) → Fin (N + 1) // StrictMono K} :=
            ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩
          have hJ_q_tilde : J.1 q_tilde = I.1 q := by
            have hfun := congrArg Subtype.val hJ_r₀
            exact congrFun hfun q
          have hIq_ne_a : I.1 q ≠ a := by
            intro heq
            apply ha
            rw [← heq]
            exact Finset.mem_image_of_mem I.1 (Finset.mem_univ q)
          have himg_Kq : Finset.univ.image K_q.1 = S_I.erase (I.1 q) :=
            image_comp_succAbove I.1 I.2 q
          have ha_notMem_Kq : a ∉ Finset.univ.image K_q.1 := by
            rw [himg_Kq]
            intro hmem
            exact ha (Finset.mem_of_mem_erase hmem)
          have himg_Iq : Finset.univ.image I'_q.1 = insert a (Finset.univ.image K_q.1) := by
            dsimp [I'_q]
            rw [image_comp_succAbove J.1 J.2 q_tilde, himg_J, hJ_q_tilde, himg_Kq]
            ext y
            simp only [Finset.mem_erase, Finset.mem_insert]
            constructor
            · rintro ⟨hyq, rfl | hyS⟩
              · exact Or.inl rfl
              · exact Or.inr ⟨hyq, hyS⟩
            · rintro (rfl | ⟨hyq, hyS⟩)
              · exact ⟨hIq_ne_a.symm, Or.inl rfl⟩
              · exact ⟨hyq, Or.inr hyS⟩
          have hr₀_ne_q_tilde : r₀ ≠ q_tilde := (Fin.succAbove_ne r₀ q).symm
          obtain ⟨r_q, hr_q⟩ := Fin.exists_succAbove_eq hr₀_ne_q_tilde
          have hIq_rq : I'_q.1 r_q = a := by
            dsimp [I'_q]
            rw [hr_q, hr₀]
          have hΨ_eq := hΨ_of_notMem a K_q ha_notMem_Kq I'_q r_q himg_Iq hIq_rq
          have hnat_eq : (q_tilde : ℕ) + (r₀ : ℕ) = (q : ℕ) + (r_q : ℕ) + 1 := by
            have hr_val : (q_tilde.succAbove r_q : ℕ) = (r₀ : ℕ) := congrArg Fin.val hr_q
            rcases succAbove_val_cases r₀ q with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
              rcases succAbove_val_cases q_tilde r_q with ⟨h3, h4⟩ | ⟨h3, h4⟩
            · dsimp [q_tilde] at h3 h4 hr_val
              omega
            · dsimp [q_tilde] at h3 h4 hr_val
              omega
            · dsimp [q_tilde] at h3 h4 hr_val
              omega
            · dsimp [q_tilde] at h3 h4 hr_val
              omega
          change (-1 : F) ^ (r₀ : ℕ) * ((-1 : F) ^ (q_tilde : ℕ) * ξ I'_q) =
            -((-1 : F) ^ (q : ℕ) * Ψ a K_q)
          rw [hΨ_eq]
          calc
            (-1 : F) ^ (r₀ : ℕ) * ((-1 : F) ^ (q_tilde : ℕ) * ξ I'_q) =
                ((-1 : F) ^ (q_tilde : ℕ) * (-1 : F) ^ (r₀ : ℕ)) * ξ I'_q := by ring
            _ = (-1 : F) ^ ((q_tilde : ℕ) + (r₀ : ℕ)) * ξ I'_q := by rw [← pow_add]
            _ = (-1 : F) ^ ((q : ℕ) + (r_q : ℕ) + 1) * ξ I'_q := by rw [hnat_eq]
            _ = -((-1 : F) ^ (q : ℕ) * ((-1 : F) ^ (r_q : ℕ) * ξ I'_q)) := by
              rw [pow_succ, pow_add]
              ring
        have hcoc := hξ_cocycle J
        rw [Fin.sum_univ_succAbove _ r₀, hJ_r₀] at hcoc
        have hmul : (-1 : F) ^ (r₀ : ℕ) *
            ((-1 : F) ^ (r₀ : ℕ) * ξ I +
              ∑ q : Fin (p + 2), (-1 : F) ^ (r₀.succAbove q : ℕ) *
                ξ ⟨J.1 ∘ (r₀.succAbove q).succAbove,
                  J.2.comp (Fin.strictMono_succAbove (r₀.succAbove q))⟩) = 0 := by
          rw [hcoc, mul_zero]
        rw [mul_add, ← mul_assoc, hneg1_sq, one_mul, Finset.mul_sum] at hmul
        simp_rw [hterm_q] at hmul
        rw [Finset.sum_neg_distrib, ← sub_eq_add_neg] at hmul
        exact (sub_eq_zero.mp hmul).symm
    
    have hΨ_mem_ins : ∀ (j : Fin s) (K : {I : Fin (p + 1) → Fin (N + 1) // StrictMono I}),
        (t_loc (K.1 0)) ^ k * Ψ (a_idx j) K ∈
          D_ε (insert (a_idx j) (Finset.univ.image K.1)) := by
      intro j K
      let S_ins := insert (a_idx j) (Finset.univ.image K.1)
      rcases hΨ_supp (a_idx j) K with hzero | ⟨I', r, himg', hval⟩
      · rw [hzero, mul_zero]
        exact (D_ε S_ins).zero_mem
      · rw [hval]
        have hS_ne : S_ins.Nonempty := Finset.insert_nonempty _ _
        have hK0_mem : K.1 0 ∈ S_ins :=
          Finset.mem_insert_of_mem (Finset.mem_image_of_mem K.1 (Finset.mem_univ 0))
        have hI'0_mem : I'.1 0 ∈ S_ins := by
          dsimp [S_ins]
          rw [← himg']
          exact Finset.mem_image_of_mem I'.1 (Finset.mem_univ 0)
        have hrat : t_loc (K.1 0) / t_loc (I'.1 0) ∈ D_ε S_ins :=
          ht_ratio_ε S_ins hS_ne (K.1 0) hK0_mem (I'.1 0) hI'0_mem
        have hξ_I' : (t_loc (I'.1 0)) ^ k * ξ I' ∈ D_ε S_ins := by
          have h := hξ_mem I'
          rwa [himg'] at h
        have htI'_ne : (t_loc (I'.1 0)) ^ k ≠ 0 := pow_ne_zero k (ht_ne (I'.1 0))
        have heq : (t_loc (K.1 0)) ^ k * ((-1 : F) ^ r * ξ I') =
            ((-1 : F) ^ r * (t_loc (K.1 0) / t_loc (I'.1 0)) ^ k) *
              ((t_loc (I'.1 0)) ^ k * ξ I') := by
          rw [div_pow]
          have hdiv : (t_loc (K.1 0)) ^ k / (t_loc (I'.1 0)) ^ k * (t_loc (I'.1 0)) ^ k =
              (t_loc (K.1 0)) ^ k := div_mul_cancel₀ _ htI'_ne
          calc
            (t_loc (K.1 0)) ^ k * ((-1 : F) ^ r * ξ I') =
                ((t_loc (K.1 0)) ^ k / (t_loc (I'.1 0)) ^ k * (t_loc (I'.1 0)) ^ k) *
                  ((-1 : F) ^ r * ξ I') := by rw [hdiv]
            _ = ((-1 : F) ^ r * ((t_loc (K.1 0)) ^ k / (t_loc (I'.1 0)) ^ k)) *
                  ((t_loc (I'.1 0)) ^ k * ξ I') := by ring
        rw [heq]
        have hneg1_mem : (-1 : F) ^ r ∈ D_ε S_ins :=
          (D_ε S_ins).pow_mem ((D_ε S_ins).neg_mem (D_ε S_ins).one_mem) r
        exact (D_ε S_ins).mul_mem
          ((D_ε S_ins).mul_mem hneg1_mem ((D_ε S_ins).pow_mem hrat k))
          hξ_I'
    have hex_r_cech : ∀ (j : Fin s) (K : {I : Fin (p + 1) → Fin (N + 1) // StrictMono I}),
        ∃ r : ℕ, (f j) ^ r * ((t_loc (K.1 0)) ^ k * Ψ (a_idx j) K) ∈
          D_ε (Finset.univ.image K.1) := by
      intro j K
      have hSK_ne : (Finset.univ.image K.1).Nonempty :=
        ⟨K.1 0, Finset.mem_image_of_mem K.1 (Finset.mem_univ 0)⟩
      exact hclear_ins j (Finset.univ.image K.1) hSK_ne _ (hΨ_mem_ins j K)
    choose r_cech hr_cech using hex_r_cech
    let R_cech : ℕ :=
      (Finset.univ : Finset (Fin s × {I : Fin (p + 1) → Fin (N + 1) // StrictMono I})).sup
        (fun x => r_cech x.1 x.2)
    obtain ⟨β_cech, hβ_cech_mem, hβ_cech_sum⟩ :=
      hPow R_ε s f α hfα hsum R_cech
    let η : {I : Fin (p + 1) → Fin (N + 1) // StrictMono I} → F :=
      fun K => ∑ j : Fin s, β_cech j * (f j) ^ R_cech * Ψ (a_idx j) K
    refine ⟨η, ?_, ?_⟩
    · intro K
      have hSK_ne : (Finset.univ.image K.1).Nonempty :=
        ⟨K.1 0, Finset.mem_image_of_mem K.1 (Finset.mem_univ 0)⟩
      dsimp [η]
      rw [Finset.mul_sum]
      refine (D_ε (Finset.univ.image K.1)).sum_mem fun j _ => ?_
      have hle_R : r_cech j K ≤ R_cech :=
        Finset.le_sup
          (f := fun x : Fin s × {I : Fin (p + 1) → Fin (N + 1) // StrictMono I} => r_cech x.1 x.2)
          (Finset.mem_univ (j, K))
      have hclear_jK : (f j) ^ R_cech * ((t_loc (K.1 0)) ^ k * Ψ (a_idx j) K) ∈
          D_ε (Finset.univ.image K.1) :=
        hpow_le (D_ε (Finset.univ.image K.1)) (f j) _ (r_cech j K) R_cech
          (hRε_le _ hSK_ne (hfα j).1) hle_R (hr_cech j K)
      have heq : (t_loc (K.1 0)) ^ k * (β_cech j * (f j) ^ R_cech * Ψ (a_idx j) K) =
          β_cech j * ((f j) ^ R_cech * ((t_loc (K.1 0)) ^ k * Ψ (a_idx j) K)) := by ring
      rw [heq]
      exact (D_ε (Finset.univ.image K.1)).mul_mem (hRε_le _ hSK_ne (hβ_cech_mem j)) hclear_jK
    · intro I
      have hstep : ∀ q : Fin (p + 2),
          (-1 : F) ^ (q : ℕ) *
            η ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩ =
            ∑ j : Fin s, β_cech j * (f j) ^ R_cech *
              ((-1 : F) ^ (q : ℕ) *
                Ψ (a_idx j) ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩) := by
        intro q
        dsimp [η]
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring
      simp_rw [hstep]
      rw [Finset.sum_comm]
      calc
        (∑ j : Fin s, ∑ q : Fin (p + 2), β_cech j * (f j) ^ R_cech *
            ((-1 : F) ^ (q : ℕ) *
              Ψ (a_idx j) ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩)) =
            ∑ j : Fin s, β_cech j * (f j) ^ R_cech *
              (∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
                Ψ (a_idx j) ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩) :=
          Finset.sum_congr rfl fun j _ => (Finset.mul_sum _ _ _).symm
        _ = ∑ j : Fin s, β_cech j * (f j) ^ R_cech * ξ I :=
          Finset.sum_congr rfl fun j _ => by rw [hΨ_cob (a_idx j) I]
        _ = (∑ j : Fin s, β_cech j * (f j) ^ R_cech) * ξ I := (Finset.sum_mul _ _ _).symm
        _ = ξ I := by rw [hβ_cech_sum, one_mul]

theorem weil_subring_twoChart_descent_intersection_and_cokernel_fg (K : Type u) [Field K] (V : ValuationSubring K)
    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (N : ℕ) (B : Finset (Fin (N + 1)) → Subring F)
    (hB_mono : ∀ (S S' : Finset (Fin (N + 1))), S.Nonempty → S ⊆ S' → B S ≤ B S')
    (R_t0 R_t1 : Subring F) (t₀ s₁ : F)
    (d₀ : ℕ) (gen₀ : Fin d₀ → F)
    (d₁ : ℕ) (gen₁ : Fin d₁ → F)
    (hPencil : IsTwoChartPencilSubringSystem V F φ_VF R_t0 R_t1 t₀ s₁ d₀ gen₀ d₁ gen₁)
    (hR01_eq : Subring.closure ((R_t0 : Set F) ∪ {s₁}) = Subring.closure ((R_t1 : Set F) ∪ {t₀}))
    (hInter : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
      Subring.closure ((B S : Set F) ∪ (R_t0 : Set F)) ⊓
        Subring.closure ((B S : Set F) ∪ (R_t1 : Set F)) = B S)
    (hClear_ov : ∀ S : Finset (Fin (N + 1)), 2 ≤ S.card →
      ∃ (n₀ n₁ r₀ r₁ : ℕ) (f α : Fin r₀ → F) (h γ : Fin r₁ → F),
        (∀ i, f i ∈ B S ∧ α i ∈ B S) ∧
        (∀ j, h j ∈ B S ∧ γ j ∈ B S) ∧
        (∑ i, α i * f i) + (∑ j, γ j * h j) = 1 ∧
        (∀ i, (f i) ^ n₀ * t₀ ∈ B S ∧ ∀ μ, (f i) ^ n₀ * gen₀ μ ∈ B S) ∧
        (∀ j, (h j) ^ n₁ * s₁ ∈ B S ∧ ∀ ν, (h j) ^ n₁ * gen₁ ν ∈ B S))
    (r_a : Fin (N + 1) → ℕ)
    (P_a : ∀ a : Fin (N + 1), Fin (r_a a) → Ideal ↥V)
    (ρ_a : ∀ (a : Fin (N + 1)) (j : Fin (r_a a)), ↥(B {a}) →+* (↥V ⧸ P_a a j))
    (hρ_V : ∀ (a : Fin (N + 1)) (j : Fin (r_a a)) (v : ↥V) (hv : φ_VF v ∈ B {a}),
