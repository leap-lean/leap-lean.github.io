theorem weil_separated_scheme_affine_cech_acyclicity_and_laurent_split (Y : AlgebraicGeometry.Scheme.{u})
    (hAffInter : ∀ U₁ U₂ : Y.Opens,
      AlgebraicGeometry.IsAffineOpen U₁ →
      AlgebraicGeometry.IsAffineOpen U₂ →
      AlgebraicGeometry.IsAffineOpen (U₁ ⊓ U₂)) :
    (∀ (U V₀ V₁ : Y.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      AlgebraicGeometry.IsAffineOpen V₀ →
      AlgebraicGeometry.IsAffineOpen V₁ →
      U ≤ V₀ ⊔ V₁ →
      ∀ (f₀ : ↑(Y.presheaf.obj (Opposite.op V₀)))
        (s₁ : ↑(Y.presheaf.obj (Opposite.op V₁))),
        Y.basicOpen f₀ = V₀ ⊓ V₁ →
        Y.basicOpen s₁ = V₀ ⊓ V₁ →
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom f₀ *
          (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom s₁ = 1 →
        ∀ (m₀ : ℕ) (g : ↑(Y.presheaf.obj (Opposite.op (U ⊓ (V₀ ⊓ V₁))))),
          ∃ (c₀ : ↑(Y.presheaf.obj (Opposite.op (U ⊓ V₀))))
            (c₁ : ↑(Y.presheaf.obj (Opposite.op (U ⊓ V₁)))),
            g =
              ((Y.presheaf.map (CategoryTheory.homOfLE
                (inf_le_right.trans inf_le_right : U ⊓ (V₀ ⊓ V₁) ≤ V₁)).op).hom s₁) ^ m₀ *
              (Y.presheaf.map (CategoryTheory.homOfLE
                (inf_le_inf_left U inf_le_left : U ⊓ (V₀ ⊓ V₁) ≤ U ⊓ V₀)).op).hom c₀ -
              (Y.presheaf.map (CategoryTheory.homOfLE
                (inf_le_inf_left U inf_le_right : U ⊓ (V₀ ⊓ V₁) ≤ U ⊓ V₁)).op).hom c₁) ∧
    (∀ (U : Y.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      ∀ (N : ℕ) (V_cov : Fin (N + 1) → Y.Opens),
        (∀ a : Fin (N + 1), V_cov a ≤ U) →
        (∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (V_cov a)) →
        (⨆ a : Fin (N + 1), V_cov a) = U →
        ∀ (q : ℕ)
          (α : ∀ I : {I : Fin (q + 2) → Fin (N + 1) // StrictMono I},
            ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image I.1) V_cov)))),
          (∀ J : {J : Fin (q + 3) → Fin (N + 1) // StrictMono J},
            (∑ r : Fin (q + 3),
              (-1 : ℤ) ^ (r : ℕ) •
                (Y.presheaf.map (CategoryTheory.homOfLE
                  (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                    Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove t))))).op).hom
                  (α ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩)) = 0) →
          ∃ β : ∀ K : {K : Fin (q + 1) → Fin (N + 1) // StrictMono K},
              ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image K.1) V_cov))),
            ∀ I : {I : Fin (q + 2) → Fin (N + 1) // StrictMono I},
              (∑ r : Fin (q + 2),
                (-1 : ℤ) ^ (r : ℕ) •
                  (Y.presheaf.map (CategoryTheory.homOfLE
                    (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                      Finset.mem_image_of_mem I.1 (Finset.mem_univ (r.succAbove t))))).op).hom
                    (β ⟨I.1 ∘ r.succAbove, I.2.comp (Fin.strictMono_succAbove r)⟩)) = α I) :=
by
  have hY_map_comp : ∀ {U₁ U₂ U₃ : Y.Opens} (h₁ : U₂ ≤ U₁) (h₂ : U₃ ≤ U₂)
      (x : ↑(Y.presheaf.obj (Opposite.op U₁))),
      (Y.presheaf.map (CategoryTheory.homOfLE h₂).op).hom
        ((Y.presheaf.map (CategoryTheory.homOfLE h₁).op).hom x) =
      (Y.presheaf.map (CategoryTheory.homOfLE (h₂.trans h₁)).op).hom x := by
    intro U₁ U₂ U₃ h₁ h₂ x
    have hop : (CategoryTheory.homOfLE h₁).op ≫ (CategoryTheory.homOfLE h₂).op =
        (CategoryTheory.homOfLE (h₂.trans h₁)).op :=
      congrArg Quiver.Hom.op
        (Subsingleton.elim
          (CategoryTheory.homOfLE h₂ ≫ CategoryTheory.homOfLE h₁)
          (CategoryTheory.homOfLE (h₂.trans h₁)))
    change (Y.presheaf.map (CategoryTheory.homOfLE h₁).op ≫
      Y.presheaf.map (CategoryTheory.homOfLE h₂).op).hom x = _
    rw [← CategoryTheory.Functor.map_comp, hop]
  have hY_map_id : ∀ {U₁ : Y.Opens} (h₁ : U₁ ≤ U₁)
      (x : ↑(Y.presheaf.obj (Opposite.op U₁))),
      (Y.presheaf.map (CategoryTheory.homOfLE h₁).op).hom x = x := by
    intro U₁ h₁ x
    have hid : (CategoryTheory.homOfLE h₁).op = 𝟙 (Opposite.op U₁) :=
      congrArg Quiver.Hom.op (Subsingleton.elim (CategoryTheory.homOfLE h₁) (𝟙 U₁))
    rw [hid, CategoryTheory.Functor.map_id]
    rfl
  
  have hHomotopy : ∀ (N : ℕ) (V_cov : Fin (N + 1) → Y.Opens) (q : ℕ)
      (α : ∀ I : {I : Fin (q + 2) → Fin (N + 1) // StrictMono I},
        ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image I.1) V_cov)))),
      (∀ J : {J : Fin (q + 3) → Fin (N + 1) // StrictMono J},
        (∑ r : Fin (q + 3),
          (-1 : ℤ) ^ (r : ℕ) •
            (Y.presheaf.map (CategoryTheory.homOfLE
              (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove t))))).op).hom
              (α ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩)) = 0) →
      ∀ (a : Fin (N + 1)),
        ∃ η_a : ∀ K : {K : Fin (q + 1) → Fin (N + 1) // StrictMono K},
            ↑(Y.presheaf.obj (Opposite.op (V_cov a ⊓ Finset.inf (Finset.univ.image K.1) V_cov))),
          ∀ I : {I : Fin (q + 2) → Fin (N + 1) // StrictMono I},
            (∑ r : Fin (q + 2),
              (-1 : ℤ) ^ (r : ℕ) •
                (Y.presheaf.map (CategoryTheory.homOfLE
                  (inf_le_inf_left (V_cov a)
                    (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                      Finset.mem_image_of_mem I.1 (Finset.mem_univ (r.succAbove t)))))).op).hom
                  (η_a ⟨I.1 ∘ r.succAbove, I.2.comp (Fin.strictMono_succAbove r)⟩)) =
            (Y.presheaf.map (CategoryTheory.homOfLE
              (inf_le_right : V_cov a ⊓ Finset.inf (Finset.univ.image I.1) V_cov ≤
                Finset.inf (Finset.univ.image I.1) V_cov)).op).hom (α I) := by
    intro N V_cov q α hα a
    have hInsert : ∀ (m : ℕ) (g : Fin m → Fin (N + 1)),
        StrictMono g → a ∉ Set.range g →
        ∃ (g' : Fin (m + 1) → Fin (N + 1)) (_ : StrictMono g') (p : Fin (m + 1)),
          g' p = a ∧ g' ∘ p.succAbove = g := by
      intro m g hg ha
      let S₀ : Finset (Fin (N + 1)) := Finset.univ.image g
      have ha_S₀ : a ∉ S₀ := by
        intro hmem
        rw [Finset.mem_image] at hmem
        obtain ⟨t, _, rfl⟩ := hmem
        exact ha ⟨t, rfl⟩
      have hcard₀ : S₀.card = m := by
        rw [Finset.card_image_of_injective _ hg.injective, Finset.card_fin]
      let S : Finset (Fin (N + 1)) := insert a S₀
      have hcard : S.card = m + 1 := by
        rw [Finset.card_insert_of_notMem ha_S₀, hcard₀]
      let e := S.orderEmbOfFin hcard
      have hrange : Set.range ⇑e = (S : Set (Fin (N + 1))) := Finset.range_orderEmbOfFin S hcard
      have ha_mem : a ∈ Set.range ⇑e := by
        rw [hrange]
        exact Finset.mem_insert_self a S₀
      obtain ⟨p, hp⟩ := ha_mem
      refine ⟨⇑e, e.strictMono, p, hp, ?_⟩
      have hsub_e : ∀ t : Fin m, e (p.succAbove t) ∈ S₀ := by
        intro t
        have hmem : e (p.succAbove t) ∈ (S : Set (Fin (N + 1))) := by
          rw [← hrange]
          exact ⟨p.succAbove t, rfl⟩
        rw [Finset.mem_coe, Finset.mem_insert] at hmem
        rcases hmem with heq | hmem₀
        · exfalso
          exact p.succAbove_ne t (e.injective (heq.trans hp.symm))
        · exact hmem₀
      have he1 : (⇑e ∘ p.succAbove) = ⇑(S₀.orderEmbOfFin hcard₀) :=
        Finset.orderEmbOfFin_unique hcard₀ hsub_e (e.strictMono.comp (Fin.strictMono_succAbove p))
      have he2 : g = ⇑(S₀.orderEmbOfFin hcard₀) :=
        Finset.orderEmbOfFin_unique hcard₀
          (fun t => Finset.mem_image_of_mem g (Finset.mem_univ t)) hg
      exact he1.trans he2.symm
    have hUnique : ∀ (m : ℕ) (g : Fin m → Fin (N + 1)) (_ : StrictMono g)
        (I₁ I₂ : {I : Fin (m + 1) → Fin (N + 1) // StrictMono I})
        (p₁ p₂ : Fin (m + 1)),
        I₁.1 p₁ = a → I₁.1 ∘ p₁.succAbove = g →
        I₂.1 p₂ = a → I₂.1 ∘ p₂.succAbove = g →
        I₁ = I₂ ∧ p₁ = p₂ := by
      intro m g hg I₁ I₂ p₁ p₂ hp₁ hcomp₁ hp₂ hcomp₂
      have ha : a ∉ Set.range g := by
        rintro ⟨t, rfl⟩
        have ht : I₁.1 (p₁.succAbove t) = I₁.1 p₁ := (congrFun hcomp₁ t).trans hp₁.symm
        exact p₁.succAbove_ne t (I₁.2.injective ht)
      let S₀ : Finset (Fin (N + 1)) := Finset.univ.image g
      have ha_S₀ : a ∉ S₀ := by
        intro hmem
        rw [Finset.mem_image] at hmem
        obtain ⟨t, _, rfl⟩ := hmem
        exact ha ⟨t, rfl⟩
      have hcard : (insert a S₀).card = m + 1 := by
        rw [Finset.card_insert_of_notMem ha_S₀,
          Finset.card_image_of_injective _ hg.injective, Finset.card_fin]
      have hmem_I : ∀ (I' : {I : Fin (m + 1) → Fin (N + 1) // StrictMono I}) (p' : Fin (m + 1)),
          I'.1 p' = a → I'.1 ∘ p'.succAbove = g →
          ∀ s : Fin (m + 1), I'.1 s ∈ insert a S₀ := by
        intro I' p' hp' hcomp' s
        by_cases hs : s = p'
        · rw [hs, hp']
          exact Finset.mem_insert_self a S₀
        · obtain ⟨t, rfl⟩ := Fin.exists_succAbove_eq hs
          have hgt : I'.1 (p'.succAbove t) = g t := congrFun hcomp' t
          rw [hgt]
          exact Finset.mem_insert_of_mem (Finset.mem_image_of_mem g (Finset.mem_univ t))
      have hI₁_eq : I₁.1 = ⇑((insert a S₀).orderEmbOfFin hcard) :=
        Finset.orderEmbOfFin_unique hcard (hmem_I I₁ p₁ hp₁ hcomp₁) I₁.2
      have hI₂_eq : I₂.1 = ⇑((insert a S₀).orderEmbOfFin hcard) :=
        Finset.orderEmbOfFin_unique hcard (hmem_I I₂ p₂ hp₂ hcomp₂) I₂.2
      have hI_val : I₁.1 = I₂.1 := hI₁_eq.trans hI₂_eq.symm
      refine ⟨Subtype.ext hI_val, I₁.2.injective ?_⟩
      rw [hp₁, ← hp₂, hI_val]
    have hInf_le : ∀ {m : ℕ} {g : Fin m → Fin (N + 1)} {g' : Fin (m + 1) → Fin (N + 1)}
        {p : Fin (m + 1)},
        g' p = a → g' ∘ p.succAbove = g →
        V_cov a ⊓ Finset.inf (Finset.univ.image g) V_cov ≤
          Finset.inf (Finset.univ.image g') V_cov := by
      intro m g g' p hp hcomp
      refine Finset.le_inf fun b hb => ?_
      rw [Finset.mem_image] at hb
      obtain ⟨s, _, rfl⟩ := hb
      by_cases hs : s = p
      · rw [hs, hp]
        exact inf_le_left
      · obtain ⟨t, rfl⟩ := Fin.exists_succAbove_eq hs
        have hgt : g' (p.succAbove t) = g t := congrFun hcomp t
        rw [hgt]
        exact inf_le_right.trans (Finset.inf_le (Finset.mem_image_of_mem g (Finset.mem_univ t)))
    have hα_res_eq : ∀ {I₁ I₂ : {I : Fin (q + 2) → Fin (N + 1) // StrictMono I}}
        (hI : I₁ = I₂) {W_sub : Y.Opens}
        (h₁ : W_sub ≤ Finset.inf (Finset.univ.image I₁.1) V_cov)
        (h₂ : W_sub ≤ Finset.inf (Finset.univ.image I₂.1) V_cov),
        (Y.presheaf.map (CategoryTheory.homOfLE h₁).op).hom (α I₁) =
        (Y.presheaf.map (CategoryTheory.homOfLE h₂).op).hom (α I₂) := by
      intro I₁ I₂ hI _ _ _
      subst hI
      rfl
    classical
    let η_a : ∀ K : {K : Fin (q + 1) → Fin (N + 1) // StrictMono K},
        ↑(Y.presheaf.obj (Opposite.op (V_cov a ⊓ Finset.inf (Finset.univ.image K.1) V_cov))) :=
      fun K =>
        if ha : a ∈ Set.range K.1 then 0
        else
          let hEx := hInsert (q + 1) K.1 K.2 ha
          let g' := Classical.choose hEx
          let hEx1 := Classical.choose_spec hEx
          let hg' := Classical.choose hEx1
          let hEx2 := Classical.choose_spec hEx1
          let p := Classical.choose hEx2
          let hp := Classical.choose_spec hEx2
          (-1 : ℤ) ^ (p : ℕ) •
            (Y.presheaf.map (CategoryTheory.homOfLE (hInf_le hp.1 hp.2)).op).hom
              (α ⟨g', hg'⟩)
    have hη_char : ∀ (K : {K : Fin (q + 1) → Fin (N + 1) // StrictMono K})
        (I' : {I : Fin (q + 2) → Fin (N + 1) // StrictMono I})
        (p' : Fin (q + 2))
        (hp' : I'.1 p' = a) (hcomp' : I'.1 ∘ p'.succAbove = K.1)
        (hle' : V_cov a ⊓ Finset.inf (Finset.univ.image K.1) V_cov ≤
          Finset.inf (Finset.univ.image I'.1) V_cov),
        η_a K = (-1 : ℤ) ^ (p' : ℕ) •
          (Y.presheaf.map (CategoryTheory.homOfLE hle').op).hom (α I') := by
      intro K I' p' hp' hcomp' hle'
      have ha : a ∉ Set.range K.1 := by
        rintro ⟨t, rfl⟩
        have ht : I'.1 (p'.succAbove t) = I'.1 p' := (congrFun hcomp' t).trans hp'.symm
        exact p'.succAbove_ne t (I'.2.injective ht)
