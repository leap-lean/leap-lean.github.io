        change (Y.presheaf.map (CategoryTheory.homOfLE hle_V₁).op).hom f₁_Y =
          (fstY.appLE V₁ V₁_Y le_rfl).hom
            ((C.presheaf.map (CategoryTheory.homOfLE (le_sup_left : V₁ ≤ W_compl)).op).hom f₁_gl) at hev
        rwa [hf₁_V₁] at hev
      have hbo : z ∈ Y.basicOpen ((fstY.appLE V₁ V₁_Y le_rfl).hom f₁) := by
        rw [← hres_f₁, AlgebraicGeometry.Scheme.basicOpen_res]
        exact ⟨hzV₁, hmem⟩
      exact hf1_vanish_Z z hz hzV₁ hbo
    · let V₀_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₀
      let U_ZY : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj U₁
      have hzV₀ : fstY.base z ∈ V₀ := C.basicOpen_le eZ hzUZ
      have hle_UZY_W : U_ZY ≤ W_Y :=
        (TopologicalSpace.Opens.map fstY.base).monotone (le_sup_right : U₁ ≤ W_compl)
