  · intro m₀ f₁_bar hSeed
    rcases hSeed with ⟨hm₀_ge6, ⟨x₀_f₁, xZ_f₁, hx₀_mem, hx₀_res, hxZ_eq, hY'_sub, hxZ_vanish⟩,
