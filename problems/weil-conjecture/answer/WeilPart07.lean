      obtain ⟨Q, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      apply h_ker_le_I
      change Φ (P - Q) = 0
      rw [map_sub, sub_eq_zero]
      exact hxy
    exact hΦ_bar_inj.isDomain Φ_bar
  have hChart_all : ∀ a : Fin (N + 1),
      ((∃ θ : Polynomial ↥V →+* ↥(B {a}),
          Function.Injective θ ∧ θ.Etale ∧ ∀ v : ↥V, (θ (Polynomial.C v) : F) = φ_VF v) ∨
       (∃ (α : ↥V) (θ : (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C α}) →+* ↥(B {a})),
          α ≠ 0 ∧ Function.Injective θ ∧ θ.Etale ∧
          ∀ v : ↥V, (θ (Ideal.Quotient.mk _ (MvPolynomial.C v)) : F) = φ_VF v)) ∧
      ∃ ρ : ∀ j : Fin (r_a a), ↥(B {a}) →+* (↥V ⧸ P_a a j),
        (∀ (j : Fin (r_a a)) (v : ↥V) (hv : φ_VF v ∈ B {a}),
          ρ j ⟨φ_VF v, hv⟩ = Ideal.Quotient.mk (P_a a j) v) ∧
        (∀ u : ↥(B {a}),
          (∀ j : Fin (r_a a), ρ j u = 0) →
          C_semi.basicOpen ((φ_cov {a} (Finset.singleton_nonempty a)).symm u) ≤ U_dom) := by
    intro a
    let hSa := Finset.singleton_nonempty a
    obtain ⟨hAff_a, hSpec_a⟩ := hFromSpec {a} hSa
    obtain ⟨hLoc_et, hLoc_sec⟩ := h_part3 ↥V C_semi g_semi F φ_VF η_semi hη_comm
      (Finset.inf {a} W) hAff_a (B {a}) (φ_cov {a} hSa) hSpec_a
    refine ⟨?_, ?_⟩
    · rcases hEtChart a with ⟨W_et, e, hWa_le, hEt, he_comm⟩ |
          ⟨W_et, α, e, hWa_le, hα, hEt, he_comm⟩
      · have h_inf_le : Finset.inf {a} W ≤ W_et :=
          le_of_eq_of_le Finset.inf_singleton hWa_le
        exact Or.inl (@hLoc_et (Polynomial ↥V) inferInstance inferInstance
          Polynomial.C W_et e h_inf_le hEt he_comm)
      · have h_inf_le : Finset.inf {a} W ≤ W_et :=
          le_of_eq_of_le Finset.inf_singleton hWa_le
        let I_α : Ideal (MvPolynomial (Fin 2) ↥V) :=
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C α}
        obtain ⟨θ, hInj_θ, hEt_θ, h_base⟩ :=
          @hLoc_et (MvPolynomial (Fin 2) ↥V ⧸ I_α) inferInstance (h_nodal_isDomain α hα)
            ((Ideal.Quotient.mk I_α).comp MvPolynomial.C) W_et e h_inf_le hEt he_comm
        exact Or.inr ⟨α, θ, hα, hInj_θ, hEt_θ, h_base⟩
    · have hσ_inf : ∀ j : Fin (r_a a),
          σ_a a j ≫ g_semi =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (P_a a j))) ∧
          Set.range (σ_a a j).base ⊆ ((Finset.inf {a} W : C_semi.Opens) : Set ↥C_semi) := by
        rw [Finset.inf_singleton]
        exact (hBadSec a).1
      have hdiff_inf : ((Finset.inf {a} W : C_semi.Opens) : Set ↥C_semi) \
          (U_dom : Set ↥C_semi) ⊆ ⋃ j : Fin (r_a a), Set.range (σ_a a j).base := by
        rw [Finset.inf_singleton]
        exact (hBadSec a).2
      exact hLoc_sec U_dom (r_a a) (P_a a) (σ_a a) hσ_inf hdiff_inf
  have hρ_ex : ∀ a : Fin (N + 1),
      ∃ ρ : ∀ j : Fin (r_a a), ↥(B {a}) →+* (↥V ⧸ P_a a j),
        (∀ (j : Fin (r_a a)) (v : ↥V) (hv : φ_VF v ∈ B {a}),
          ρ j ⟨φ_VF v, hv⟩ = Ideal.Quotient.mk (P_a a j) v) ∧
        (∀ u : ↥(B {a}),
          (∀ j : Fin (r_a a), ρ j u = 0) →
          C_semi.basicOpen ((φ_cov {a} (Finset.singleton_nonempty a)).symm u) ≤ U_dom) :=
    fun a => (hChart_all a).2
  choose ρ_a hρ_V hBadUdom using hρ_ex
  have hEtCov : IsEtaleSubringCoverOverValuation V F φ_VF N B r_a P_a ρ_a :=
    ⟨hInjVF, hEtCov_sub, fun a => ⟨(hChart_all a).1, hρ_V a⟩⟩
  exact ⟨N, W, tag, B, t_loc, φ_cov, r_a, P_a, ρ_a, hCov, hDisj, hFromSpec, hEtCov, hBadUdom⟩

theorem weil_segre_domination_twoChart_subring_bridge (K : Type u) [Field K] (V : ValuationSubring K)
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSep : AlgebraicGeometry.IsSeparated g_semi)
    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (η_semi : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_semi)
    (C_tilde : AlgebraicGeometry.Scheme.{u})
    (g_tilde : C_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (q : C_tilde ⟶ C_semi)
    (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_tilde)
    (U_dom : C_semi.Opens)
    (b : ℕ) (K_bad : Fin b → Set ↥C_semi) (y_bad : Fin b → ↥C_semi)
    (V_tilde₀ V_tilde₁ : C_tilde.Opens)
    (T₀ : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀)))
    (S₁ : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₁)))
    (hDom : IsSegreTwoChartCurveDomination V g_semi F φ_VF η_semi C_tilde g_tilde q η_tilde
      U_dom b K_bad y_bad V_tilde₀ V_tilde₁ T₀ S₁)
    (N : ℕ) (W : Fin (N + 1) → C_semi.Opens)
    (B : Finset (Fin (N + 1)) → Subring F)
    (φ_cov : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
      ↑(C_semi.presheaf.obj (Opposite.op (Finset.inf S W))) ≃+* ↥(B S))
    (hSupW : (⨆ a : Fin (N + 1), W a) = ⊤)
    (hCovAff : ∀ (S : Finset (Fin (N + 1))) (hS : S.Nonempty),
      Nonempty ↥(Finset.inf S W) ∧
      ∃ hAff : AlgebraicGeometry.IsAffineOpen (Finset.inf S W),
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((B S).subtype.comp (φ_cov S hS).toRingHom)) ≫
          hAff.fromSpec = η_semi) :
    ∃ (R_t0 R_t1 : Subring F) (t₀ s₁ : F)
      (d₀ : ℕ) (gen₀ : Fin d₀ → F)
      (d₁ : ℕ) (gen₁ : Fin d₁ → F),
      IsTwoChartPencilSubringSystem V F φ_VF R_t0 R_t1 t₀ s₁ d₀ gen₀ d₁ gen₁ ∧
      Subring.closure ((R_t0 : Set F) ∪ {s₁}) = Subring.closure ((R_t1 : Set F) ∪ {t₀}) ∧
      (∀ (S : Finset (Fin (N + 1))), S.Nonempty →
        Subring.closure ((B S : Set F) ∪ (R_t0 : Set F)) ⊓
          Subring.closure ((B S : Set F) ∪ (R_t1 : Set F)) = B S) ∧
      (∀ (S : Finset (Fin (N + 1))) (hS : S.Nonempty)
         (u : ↑(C_semi.presheaf.obj (Opposite.op (Finset.inf S W)))),
        C_semi.basicOpen u ≤ U_dom →
        let u_F : F := ((φ_cov S hS) u : F)
        ∃ (N₀ n₀ n₁ r₀ r₁ : ℕ) (f α : Fin r₀ → F) (h γ : Fin r₁ → F),
          (∀ i : Fin r₀, f i ∈ B S ∧ α i ∈ B S) ∧
          (∀ j : Fin r₁, h j ∈ B S ∧ γ j ∈ B S) ∧
          (∑ i : Fin r₀, α i * f i) + (∑ j : Fin r₁, γ j * h j) = u_F ^ N₀ ∧
          (∀ i : Fin r₀, (f i) ^ n₀ * u_F ^ N₀ * t₀ ∈ B S ∧
            ∀ μ : Fin d₀, (f i) ^ n₀ * u_F ^ N₀ * gen₀ μ ∈ B S) ∧
          (∀ j : Fin r₁, (h j) ^ n₁ * u_F ^ N₀ * s₁ ∈ B S ∧
            ∀ ν : Fin d₁, (h j) ^ n₁ * u_F ^ N₀ * gen₁ ν ∈ B S)) ∧
      (∀ R_ε ∈ ({R_t0, R_t1, Subring.closure ((R_t0 : Set F) ∪ {s₁})} : Set (Subring F)),
        ∃ (s : ℕ) (a_idx : Fin s → Fin (N + 1)) (f α : Fin s → F),
          (∀ j : Fin s, f j ∈ R_ε ∧ α j ∈ R_ε) ∧
          (∑ j : Fin s, α j * f j) = 1 ∧
          ∀ (j : Fin s), ∀ b ∈ B {a_idx j}, ∃ n : ℕ, (f j) ^ n * b ∈ R_ε) :=
by
  classical
  
  have compat_appLE : ∀ {X Y : Scheme.{u}} (f : Y ⟶ X)
      (η_X : Spec (CommRingCat.of F) ⟶ X) (η_Y : Spec (CommRingCat.of F) ⟶ Y),
      η_Y ≫ f = η_X →
      ∀ {U : X.Opens} (hU : IsAffineOpen U) (ψ_U : ↑(X.presheaf.obj (Opposite.op U)) →+* F),
        Spec.map (CommRingCat.ofHom ψ_U) ≫ hU.fromSpec = η_X →
      ∀ {V_o : Y.Opens} (hV : IsAffineOpen V_o) (ψ_V : ↑(Y.presheaf.obj (Opposite.op V_o)) →+* F),
        Spec.map (CommRingCat.ofHom ψ_V) ≫ hV.fromSpec = η_Y →
      ∀ (hle : V_o ≤ f ⁻¹ᵁ U) (s : ↑(X.presheaf.obj (Opposite.op U))),
        ψ_V ((f.appLE U V_o hle).hom s) = ψ_U s := by
    intro X Y f η_X η_Y hη U hU ψ_U hψ_U V_o hV ψ_V hψ_V hle s
    have h1 := IsAffineOpen.SpecMap_appLE_fromSpec f hU hV hle
    have h2 : Spec.map (f.appLE U V_o hle ≫ CommRingCat.ofHom ψ_V) ≫ hU.fromSpec =
        Spec.map (CommRingCat.ofHom ψ_U) ≫ hU.fromSpec := by
      rw [Spec.map_comp, Category.assoc, h1, ← Category.assoc, hψ_V, hη, hψ_U]
    exact congrArg (fun φ => φ.hom s) (Spec.map_injective ((cancel_mono hU.fromSpec).mp h2))
  have compat_res : ∀ {X : Scheme.{u}} (η_X : Spec (CommRingCat.of F) ⟶ X)
      {U : X.Opens} (hU : IsAffineOpen U) (ψ_U : ↑(X.presheaf.obj (Opposite.op U)) →+* F),
        Spec.map (CommRingCat.ofHom ψ_U) ≫ hU.fromSpec = η_X →
      ∀ {V_o : X.Opens} (hV : IsAffineOpen V_o) (ψ_V : ↑(X.presheaf.obj (Opposite.op V_o)) →+* F),
        Spec.map (CommRingCat.ofHom ψ_V) ≫ hV.fromSpec = η_X →
      ∀ (hle : V_o ≤ U) (s : ↑(X.presheaf.obj (Opposite.op U))),
        ψ_V ((X.presheaf.map (homOfLE hle).op).hom s) = ψ_U s := by
    intro X η_X U hU ψ_U hψ_U V_o hV ψ_V hψ_V hle s
    have h1 := IsAffineOpen.map_fromSpec hU hV (homOfLE hle).op
    have h2 : Spec.map (X.presheaf.map (homOfLE hle).op ≫ CommRingCat.ofHom ψ_V) ≫ hU.fromSpec =
        Spec.map (CommRingCat.ofHom ψ_U) ≫ hU.fromSpec := by
      rw [Spec.map_comp, Category.assoc, h1, hψ_V, hψ_U]
    exact congrArg (fun φ => φ.hom s) (Spec.map_injective ((cancel_mono hU.fromSpec).mp h2))
  let ptF : PrimeSpectrum F := ⊥
  have eta_mem_affineOpen : ∀ {X : Scheme.{u}} (η_X : Spec (CommRingCat.of F) ⟶ X)
      {U : X.Opens} (hU : IsAffineOpen U) (ψ_U : ↑(X.presheaf.obj (Opposite.op U)) →+* F),
      Spec.map (CommRingCat.ofHom ψ_U) ≫ hU.fromSpec = η_X →
      η_X.base ptF ∈ U := by
    intro X η_X U hU ψ_U hψ_U
    change η_X.base ptF ∈ (U : Set X)
    rw [← hU.range_fromSpec, ← hψ_U]
    exact ⟨(Spec.map (CommRingCat.ofHom ψ_U)).base ptF, rfl⟩
  have eta_mem_basicOpen : ∀ {X : Scheme.{u}} (η_X : Spec (CommRingCat.of F) ⟶ X)
      {U : X.Opens} (hU : IsAffineOpen U) (ψ_U : ↑(X.presheaf.obj (Opposite.op U)) →+* F),
      Spec.map (CommRingCat.ofHom ψ_U) ≫ hU.fromSpec = η_X →
      ∀ (f_sec : ↑(X.presheaf.obj (Opposite.op U))), ψ_U f_sec ≠ 0 →
      η_X.base ptF ∈ X.basicOpen f_sec := by
    intro X η_X U hU ψ_U hψ_U f_sec hf
    let p : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U)) :=
      (Spec.map (CommRingCat.ofHom ψ_U)).base ptF
    have hp : p ∈ PrimeSpectrum.basicOpen f_sec := by
      rw [PrimeSpectrum.mem_basicOpen]
      intro hmem
      have hmemF : ψ_U f_sec ∈ ptF.asIdeal := hmem
      exact ptF.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem ptF.asIdeal hmemF (IsUnit.mk0 _ hf))
    have hp' : (Spec.map (CommRingCat.ofHom ψ_U)).base ptF ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen f_sec := by
      rwa [hU.fromSpec_preimage_basicOpen]
    rw [← hψ_U]
    exact hp'
  
  obtain ⟨_hInjVF, hη_semi, hη_q, hInt_tilde, _hProp_gt, _hLfp_gt, _hProp_q,
    hq_g, hq_bij, hAffEmb_semi, hAffEmb_tilde, hIso_Udom, _hUdom_compl, _hKbad_cl,
    _hKbad_disj, _hKbad_sec, hSupV, hAffV0, hNeV0, hAffV1, hNeV1, hV01_T₀, hV01_S₁,
    hTS_one, ⟨c₀, d₀, gen₀_dom, hc₀, hspan₀⟩, ⟨c₁, d₁, gen₁_dom, hc₁, hspan₁⟩⟩ := hDom
  have hη_tilde : η_tilde ≫ g_tilde = Spec.map (CommRingCat.ofHom φ_VF) := by
    rw [← hq_g, ← Category.assoc, hη_q, hη_semi]
  have hq_ptF : q.base (η_tilde.base ptF) = η_semi.base ptF := by
    change (η_tilde ≫ q).base ptF = η_semi.base ptF
    rw [hη_q]
  
  
  
  have hAff₀₁ : IsAffineOpen (V_tilde₀ ⊓ V_tilde₁) := hV01_T₀.symm ▸ hAffV0.basicOpen T₀
  have hIrred : IrreducibleSpace ↥C_tilde := @irreducibleSpace_of_isIntegral C_tilde hInt_tilde
  have hNe₀₁ : Nonempty ↥(V_tilde₀ ⊓ V_tilde₁) := by
    obtain ⟨⟨x₀, hx₀⟩⟩ := hNeV0
    obtain ⟨⟨x₁, hx₁⟩⟩ := hNeV1
    obtain ⟨x, hx⟩ := nonempty_preirreducible_inter V_tilde₀.isOpen V_tilde₁.isOpen ⟨x₀, hx₀⟩ ⟨x₁, hx₁⟩
    exact ⟨⟨x, hx⟩⟩
  obtain ⟨ψ₀, _hInj₀, hψ₀⟩ := hAffEmb_tilde V_tilde₀ hAffV0 hNeV0
  obtain ⟨ψ₁, _hInj₁, hψ₁⟩ := hAffEmb_tilde V_tilde₁ hAffV1 hNeV1
  obtain ⟨ψ₀₁, _hInj₀₁, hψ₀₁⟩ := hAffEmb_tilde (V_tilde₀ ⊓ V_tilde₁) hAff₀₁ hNe₀₁
  have hT₀_res : ψ₀₁ ((C_tilde.presheaf.map (homOfLE inf_le_left).op).hom T₀) = ψ₀ T₀ :=
    compat_res η_tilde hAffV0 ψ₀ hψ₀ hAff₀₁ ψ₀₁ hψ₀₁ inf_le_left T₀
  have hS₁_res : ψ₀₁ ((C_tilde.presheaf.map (homOfLE inf_le_right).op).hom S₁) = ψ₁ S₁ :=
    compat_res η_tilde hAffV1 ψ₁ hψ₁ hAff₀₁ ψ₀₁ hψ₀₁ inf_le_right S₁
  have hts_mul : ψ₀ T₀ * ψ₁ S₁ = 1 := by
    rw [← hT₀_res, ← hS₁_res, ← map_mul, hTS_one, map_one]
  let S_V := Spec (CommRingCat.of ↥V)
  let hTop_SV : IsAffineOpen (⊤ : S_V.Opens) := isAffineOpen_top S_V
  let ψ_SV : ↑(S_V.presheaf.obj (Opposite.op ⊤)) →+* F :=
    φ_VF.comp (Scheme.ΓSpecIso (CommRingCat.of ↥V)).hom.hom
  have hψ_SV : Spec.map (CommRingCat.ofHom ψ_SV) ≫ hTop_SV.fromSpec =
      Spec.map (CommRingCat.ofHom φ_VF) := by
    have hfrom : hTop_SV.fromSpec = Spec.map (Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv := by
      rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv]
    have hhom : CommRingCat.ofHom ψ_SV =
        (Scheme.ΓSpecIso (CommRingCat.of ↥V)).hom ≫ CommRingCat.ofHom φ_VF := rfl
    rw [hfrom, hhom, Spec.map_comp, Category.assoc, ← Spec.map_comp, Iso.inv_hom_id,
      Spec.map_id, Category.comp_id]
  have hψ₀_c₀ : ∀ v : ↥V, ψ₀ (c₀ v) = φ_VF v := by
    intro v
    rw [hc₀ v]
    have h := compat_appLE g_tilde (Spec.map (CommRingCat.ofHom φ_VF)) η_tilde hη_tilde
      hTop_SV ψ_SV hψ_SV hAffV0 ψ₀ hψ₀ le_top
      ((Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv.hom v)
    exact h.trans (by simp [ψ_SV])
  have hψ₁_c₁ : ∀ v : ↥V, ψ₁ (c₁ v) = φ_VF v := by
    intro v
    rw [hc₁ v]
    have h := compat_appLE g_tilde (Spec.map (CommRingCat.ofHom φ_VF)) η_tilde hη_tilde
      hTop_SV ψ_SV hψ_SV hAffV1 ψ₁ hψ₁ le_top
      ((Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv.hom v)
    exact h.trans (by simp [ψ_SV])
  have hcomp₀ : ψ₀.comp c₀ = φ_VF := RingHom.ext hψ₀_c₀
  have hcomp₁ : ψ₁.comp c₁ = φ_VF := RingHom.ext hψ₁_c₁
  let R_t0 : Subring F := ψ₀.range
  let R_t1 : Subring F := ψ₁.range
  let t₀ : F := ψ₀ T₀
  let s₁ : F := ψ₁ S₁
  let gen₀ : Fin d₀ → F := fun μ => ψ₀ (gen₀_dom μ)
  let gen₁ : Fin d₁ → F := fun ν => ψ₁ (gen₁_dom ν)
  have hPencil : IsTwoChartPencilSubringSystem V F φ_VF R_t0 R_t1 t₀ s₁ d₀ gen₀ d₁ gen₁ := by
    refine ⟨⟨T₀, rfl⟩, ⟨S₁, rfl⟩, hts_mul,
      fun v => ⟨⟨c₀ v, hψ₀_c₀ v⟩, ⟨c₁ v, hψ₁_c₁ v⟩⟩,
      fun μ => ⟨gen₀_dom μ, rfl⟩,
      fun ν => ⟨gen₁_dom ν, rfl⟩, ?_, ?_⟩
    · rintro _ ⟨w₀, rfl⟩
      obtain ⟨P, rfl⟩ := hspan₀ w₀
      refine ⟨P, ?_⟩
      simp_rw [map_sum, map_mul, Polynomial.hom_eval₂, hcomp₀]
      rfl
    · rintro _ ⟨w₁, rfl⟩
      obtain ⟨P, rfl⟩ := hspan₁ w₁
      refine ⟨P, ?_⟩
      simp_rw [map_sum, map_mul, Polynomial.hom_eval₂, hcomp₁]
      rfl
  have hCl₀ : Subring.closure ((R_t0 : Set F) ∪ {s₁}) = ψ₀₁.range := by
    apply le_antisymm
    · rw [Subring.closure_le]
      rintro z (⟨a, rfl⟩ | rfl)
      · exact ⟨(C_tilde.presheaf.map (homOfLE inf_le_left).op).hom a,
          compat_res η_tilde hAffV0 ψ₀ hψ₀ hAff₀₁ ψ₀₁ hψ₀₁ inf_le_left a⟩
      · exact ⟨(C_tilde.presheaf.map (homOfLE inf_le_right).op).hom S₁, hS₁_res⟩
    · rintro z ⟨x_loc, rfl⟩
      let alg₀ : Algebra ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀))
          ↑(C_tilde.presheaf.obj (Opposite.op (V_tilde₀ ⊓ V_tilde₁))) :=
        (C_tilde.presheaf.map (homOfLE inf_le_left).op).hom.toAlgebra
      letI := alg₀
      have hLoc₀ : IsLocalization.Away T₀ ↑(C_tilde.presheaf.obj (Opposite.op (V_tilde₀ ⊓ V_tilde₁))) :=
        hAffV0.isLocalization_of_eq_basicOpen T₀ (homOfLE inf_le_left) hV01_T₀
      obtain ⟨n, a, hna⟩ := @IsLocalization.Away.surj _ _ _ _ _ T₀ hLoc₀ x_loc
      have hna_F : ψ₀₁ x_loc * t₀ ^ n = ψ₀ a := by
        have h1 := congrArg ψ₀₁ hna
        rw [map_mul, map_pow] at h1
        have h_alg_T : ψ₀₁ (algebraMap ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀)) _ T₀) = t₀ :=
          hT₀_res
        have h_alg_a : ψ₀₁ (algebraMap ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀)) _ a) = ψ₀ a :=
          compat_res η_tilde hAffV0 ψ₀ hψ₀ hAff₀₁ ψ₀₁ hψ₀₁ inf_le_left a
        rwa [h_alg_T, h_alg_a] at h1
      have h_eq : ψ₀₁ x_loc = ψ₀ a * s₁ ^ n := by
        calc
          ψ₀₁ x_loc = ψ₀₁ x_loc * (t₀ * s₁) ^ n := by rw [hts_mul, one_pow, mul_one]
