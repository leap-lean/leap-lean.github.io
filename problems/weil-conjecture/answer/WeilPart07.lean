    let π_poly : Polynomial R₀ →+* Polynomial (R₀ ⧸ P_id) :=
      Polynomial.mapRingHom (Ideal.Quotient.mk P_id)
    have hπ_surj : Function.Surjective π_poly :=
      Polynomial.map_surjective _ Ideal.Quotient.mk_surjective
    have hπ_ker : RingHom.ker π_poly = Ideal.map Polynomial.C P_id := by
      rw [Polynomial.ker_mapRingHom, Ideal.mk_ker]
    obtain ⟨ψ, hψ_et, _⟩ :=
      etale_quotient_of_surjective (Polynomial R₀) (Polynomial (R₀ ⧸ P_id)) D φ π_poly hφ hπ_surj
    let J_D : Ideal D := Ideal.map φ (RingHom.ker π_poly)
    have hJD_eq : J_D = Ideal.map (φ.comp Polynomial.C) P_id := by
      dsimp [J_D]
      rw [hπ_ker, Ideal.map_map]
    have hJD_p : J_D ≤ p := hJD_eq ▸ hp_min.1.2
    have hJD_q : J_D ≤ q := hJD_eq ▸ hq_ge
    have hJD_m : J_D ≤ m_x := le_trans hJD_p hpm
    let q_D : D →+* (D ⧸ J_D) := Ideal.Quotient.mk J_D
    have hqD_surj : Function.Surjective q_D := Ideal.Quotient.mk_surjective
    have hqD_ker : RingHom.ker q_D = J_D := Ideal.mk_ker
    let p_bar : Ideal (D ⧸ J_D) := Ideal.map q_D p
    let q_bar : Ideal (D ⧸ J_D) := Ideal.map q_D q
    let m_bar : Ideal (D ⧸ J_D) := Ideal.map q_D m_x
    haveI hp_bar_prime : p_bar.IsPrime :=
      Ideal.map_isPrime_of_surjective hqD_surj (hqD_ker.trans_le hJD_p)
    haveI hq_bar_prime : q_bar.IsPrime :=
      Ideal.map_isPrime_of_surjective hqD_surj (hqD_ker.trans_le hJD_q)
    haveI : m_bar.IsPrime :=
      Ideal.map_isPrime_of_surjective hqD_surj (hqD_ker.trans_le hJD_m)
    have hp_comap : Ideal.comap q_D p_bar = p := by
      rw [Ideal.comap_map_of_surjective' q_D hqD_surj, hqD_ker, sup_eq_left.mpr hJD_p]
    have hq_comap : Ideal.comap q_D q_bar = q := by
      rw [Ideal.comap_map_of_surjective' q_D hqD_surj, hqD_ker, sup_eq_left.mpr hJD_q]
    letI : Algebra (Polynomial (R₀ ⧸ P_id)) (D ⧸ J_D) := ψ.toAlgebra
    haveI : Algebra.Etale (Polynomial (R₀ ⧸ P_id)) (D ⧸ J_D) := hψ_et.toAlgebra
    obtain ⟨s, hs_not_m, hDom_s⟩ := hEtDom (Polynomial (R₀ ⧸ P_id)) (D ⧸ J_D) m_bar
    haveI : IsDomain (Localization.Away s) := hDom_s
    have hs_not_p : s ∉ p_bar := fun hs => hs_not_m (Ideal.map_mono hpm hs)
    have hs_not_q : s ∉ q_bar := fun hs => hs_not_m (Ideal.map_mono hqm hs)
    let loc : (D ⧸ J_D) →+* Localization.Away s := algebraMap (D ⧸ J_D) (Localization.Away s)
    let r₀ : Ideal (D ⧸ J_D) := RingHom.ker loc
    haveI : r₀.IsPrime := RingHom.ker_isPrime loc
    have hr₀_le_p : r₀ ≤ p_bar := by
      intro x hx
      obtain ⟨⟨m, hm⟩, hmx⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers s) (Localization.Away s) x).mp hx
      have hm_not : m ∉ p_bar := (Submonoid.powers_le (P := p_bar.primeCompl)).mpr hs_not_p hm
      exact (hp_bar_prime.mem_or_mem (hmx ▸ p_bar.zero_mem)).resolve_left hm_not
    have hr₀_le_q : r₀ ≤ q_bar := by
      intro x hx
      obtain ⟨⟨m, hm⟩, hmx⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers s) (Localization.Away s) x).mp hx
      have hm_not : m ∉ q_bar := (Submonoid.powers_le (P := q_bar.primeCompl)).mpr hs_not_q hm
      exact (hq_bar_prime.mem_or_mem (hmx ▸ q_bar.zero_mem)).resolve_left hm_not
    have hp_le_r₀ : p_bar ≤ r₀ := by
      have hr_prime : (Ideal.comap q_D r₀).IsPrime := Ideal.IsPrime.comap q_D
      have hJD_r₀ : J_D ≤ Ideal.comap q_D r₀ := by
        intro x hx
        change q_D x ∈ r₀
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx]
        exact r₀.zero_mem
      have hr_ge : Ideal.map (φ.comp Polynomial.C) P_id ≤ Ideal.comap q_D r₀ := by
        rw [← hJD_eq]
        exact hJD_r₀
      have hr_le : Ideal.comap q_D r₀ ≤ p := hp_comap ▸ Ideal.comap_mono hr₀_le_p
      have hp_le := hp_min.2 ⟨hr_prime, hr_ge⟩ hr_le
      calc
        p_bar = Ideal.map q_D p := rfl
        _ ≤ Ideal.map q_D (Ideal.comap q_D r₀) := Ideal.map_mono hp_le
        _ = r₀ := Ideal.map_comap_of_surjective q_D hqD_surj r₀
    have hp_le_q_bar : p_bar ≤ q_bar := le_trans hp_le_r₀ hr₀_le_q
    rw [← hp_comap, ← hq_comap]
    exact Ideal.comap_mono hp_le_q_bar
