    exact ⟨V_sm, hx₀_Vsm, hSm_Vsm⟩
  have h_step6 :
      ∀ (A' : Type u) [CommRing A'] [Algebra R A']
        [Module.Flat R A'] [Algebra.FinitePresentation R A']
        (P : Ideal A') [hP_prime : P.IsPrime],
        Ideal.map (algebraMap R A') (IsLocalRing.maximalIdeal R) ≤ P →
        RingHom.IsStandardSmoothOfRelativeDimension 1
          (Ideal.quotientMap
            (Ideal.map (algebraMap R A') (IsLocalRing.maximalIdeal R))
            (algebraMap R A') Ideal.le_comap_map) →
        ∃ (r N : ℕ)
          (π_alg : MvPolynomial (Fin (r + N + 1)) R →ₐ[R] A')
          (Q : Fin (r + N) → MvPolynomial (Fin (r + N + 1)) R)
          (S₀ : MvPolynomial (Fin (r + N + 1)) R),
          Function.Surjective π_alg ∧
          (∀ j : Fin (r + N), π_alg (Q j) = 0) ∧
          π_alg S₀ ∉ P ∧
          π_alg (Matrix.of fun (i j : Fin (r + N)) => MvPolynomial.pderiv i.succ (Q j)).det ∉ P ∧
          (∀ f : MvPolynomial (Fin (r + N + 1)) R,
            π_alg f = 0 → S₀ * f ∈ Ideal.span (Set.range Q)) := by
    intro A' _ _ _ _ P hP_prime hmP hSmBar
    classical
    let m_R : Ideal R := IsLocalRing.maximalIdeal R
    let k_bar := R ⧸ m_R
    let m_A' : Ideal A' := Ideal.map (algebraMap R A') m_R
    let A'_bar := A' ⧸ m_A'
    let q_m : A' →+* A'_bar := Ideal.Quotient.mk m_A'
    let φ_bar : k_bar →+* A'_bar := Ideal.quotientMap m_A' (algebraMap R A') Ideal.le_comap_map
    let _ : Algebra k_bar A'_bar := φ_bar.toAlgebra
    have hSmAlg : Algebra.IsStandardSmoothOfRelativeDimension 1 k_bar A'_bar :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mp hSmBar
    obtain ⟨ι, σ, hFin_σ, hFin_ι, P₀, hdim₀⟩ := hSmAlg.out
    let r : ℕ := Nat.card σ
    have hcard_ι : Nat.card ι = r + 1 := by
      change Nat.card ι - Nat.card σ = 1 at hdim₀
      omega
    let e_σ : Fin r ≃ σ := (Finite.equivFinOfCardEq (rfl : Nat.card σ = r)).symm
    have hex_i₀ : ∃ i₀ : ι, i₀ ∉ Set.range P₀.map := by
      by_contra hall
      have hsurj_map : Function.Surjective P₀.map := fun i =>
        Classical.not_not.mp fun h => hall ⟨i, h⟩
      let e_bad : σ ≃ ι := Equiv.ofBijective P₀.map ⟨P₀.map_inj, hsurj_map⟩
      have h_eq : Nat.card σ = Nat.card ι := Nat.card_congr e_bad
      omega
    obtain ⟨i₀, hi₀⟩ := hex_i₀
    let g_ι : Fin (r + 1) → ι := Fin.cases i₀ (fun a => P₀.map (e_σ a))
    have hg_inj : Function.Injective g_ι := by
      intro x y
      refine Fin.cases ?_ ?_ x
      · refine Fin.cases ?_ ?_ y
        · intro _
          rfl
        · intro b hb
          dsimp [g_ι] at hb
          exact False.elim (hi₀ ⟨e_σ b, hb.symm⟩)
      · intro a
        refine Fin.cases ?_ ?_ y
        · intro ha
          dsimp [g_ι] at ha
          exact False.elim (hi₀ ⟨e_σ a, ha⟩)
        · intro b hab
          dsimp [g_ι] at hab
          exact congrArg Fin.succ (e_σ.injective (P₀.map_inj hab))
    let _ : Fintype ι := Fintype.ofFinite ι
    have hg_bij : Function.Bijective g_ι := by
      rw [Fintype.bijective_iff_injective_and_card]
      refine ⟨hg_inj, ?_⟩
      rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, hcard_ι]
    let e_ι : Fin (r + 1) ≃ ι := Equiv.ofBijective g_ι hg_bij
    let P₁ : Algebra.SubmersivePresentation k_bar A'_bar (Fin (r + 1)) (Fin r) :=
      P₀.reindex e_ι e_σ
    have hP₁_map : ∀ a : Fin r, P₁.map a = a.succ := by
      intro a
      apply e_ι.injective
      change e_ι (e_ι.symm (P₀.map (e_σ a))) = g_ι a.succ
      simp [g_ι]
    have hFT : Algebra.FiniteType R A' := inferInstance
    obtain ⟨N, f_gen, hf_gen⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT
    let x_gen : Fin N → A' := fun d => f_gen (MvPolynomial.X d)
    have hx_surj : Function.Surjective (MvPolynomial.aeval (R := R) x_gen) := by
      have h_eq : MvPolynomial.aeval (R := R) x_gen = f_gen := by
        apply MvPolynomial.algHom_ext
        intro d
        rw [MvPolynomial.aeval_X]
      rw [h_eq]
      exact hf_gen
    choose y_gen hy_gen using fun k : Fin (r + 1) => Ideal.Quotient.mk_surjective (P₁.val k)
    let ι_Y : Fin (r + 1) → Fin (r + N + 1) :=
      Fin.cases 0 (fun a : Fin r => (Fin.castAdd N a).succ)
    let ι_X : Fin N → Fin (r + N + 1) :=
      fun d : Fin N => (Fin.natAdd r d).succ
    have hι_Y_inj : Function.Injective ι_Y := by
      intro x y
      refine Fin.cases ?_ ?_ x
      · refine Fin.cases ?_ ?_ y
        · intro _
          rfl
        · intro b hb
          dsimp [ι_Y] at hb
          exact False.elim (Fin.succ_ne_zero _ hb.symm)
      · intro a
        refine Fin.cases ?_ ?_ y
        · intro ha
          dsimp [ι_Y] at ha
          exact False.elim (Fin.succ_ne_zero _ ha)
        · intro b hab
          dsimp [ι_Y] at hab
          have hval := congrArg Fin.val (Fin.succ_inj.mp hab)
          simp at hval
          exact congrArg Fin.succ (Fin.ext hval)
    have hι_X_not_Y : ∀ d : Fin N, ι_X d ∉ Set.range ι_Y := by
      intro d ⟨k, hk⟩
      refine Fin.cases ?_ ?_ k hk
      · intro h0
        dsimp [ι_Y, ι_X] at h0
        exact Fin.succ_ne_zero _ h0.symm
      · intro a ha
        dsimp [ι_Y, ι_X] at ha
        have hval := congrArg Fin.val (Fin.succ_inj.mp ha)
        simp at hval
        omega
    let z_gen : Fin (r + N + 1) → A' :=
      Fin.cases (y_gen 0) (Fin.addCases (fun a : Fin r => y_gen a.succ) x_gen)
    have hz_Y : z_gen ∘ ι_Y = y_gen := by
      ext k
      refine Fin.cases ?_ ?_ k
      · simp [z_gen, ι_Y]
      · intro a
        simp [z_gen, ι_Y]
    have hz_X : z_gen ∘ ι_X = x_gen := by
      ext d
      simp [z_gen, ι_X]
    let P_big := MvPolynomial (Fin (r + N + 1)) R
    let π_alg : P_big →ₐ[R] A' := MvPolynomial.aeval z_gen
    have hSurj : Function.Surjective π_alg := by
      intro a
      obtain ⟨p, rfl⟩ := hx_surj a
      refine ⟨MvPolynomial.rename ι_X p, ?_⟩
      change (MvPolynomial.aeval z_gen) (MvPolynomial.rename ι_X p) = (MvPolynomial.aeval x_gen) p
      rw [MvPolynomial.aeval_rename, hz_X]
    let K_ker : Ideal P_big := RingHom.ker π_alg.toRingHom
    have hK_fg : K_ker.FG := Algebra.FinitePresentation.ker_fg_of_mvPolynomial π_alg hSurj
    let pi_bar_alg : MvPolynomial (Fin (r + N + 1)) k_bar →ₐ[k_bar] A'_bar :=
