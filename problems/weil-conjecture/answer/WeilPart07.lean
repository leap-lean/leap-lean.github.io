      have h_rat : (t_loc (J.1 0) / t_loc (I_q.1 0)) ^ k ∈ A (Finset.univ.image J.1) :=
        Subring.pow_mem _ (hA_rat _ hne_J _ (Finset.mem_image_of_mem _ (Finset.mem_univ 0))
