      IsUnit.of_mul_eq_one (algebraMap A (Localization.Away X01) (MvPolynomial.X 1) * ↑(u01_unit⁻¹))
        (by rw [← mul_assoc, hmul_loc, Units.mul_inv])
    have huX1_loc : IsUnit (algebraMap A (Localization.Away X01) (MvPolynomial.X 1)) :=
      IsUnit.of_mul_eq_one (algebraMap A (Localization.Away X01) (MvPolynomial.X 0) * ↑(u01_unit⁻¹))
        (by rw [← mul_assoc, mul_comm (algebraMap A _ (MvPolynomial.X 1)), hmul_loc, Units.mul_inv])
    let ψ₀₁ : HomogeneousLocalization.Away 𝒜 X01 →+* S :=
      (Localization.awayLift ev₀ X01 hu01).comp
        (algebraMap (HomogeneousLocalization.Away 𝒜 X01) (Localization.Away X01))
    have h_eq0 : ψ₀₁.comp (HomogeneousLocalization.awayMap 𝒜 (hXa 1) (rfl : X01 = _)) =
        ψ_chart (ρ_open U₀₁) 0 (fun b => resL (![1, f_sec] b)) (by rw [hv₀_U₀, map_one]) := by
      have hu0_X0 : IsUnit (ev₀ (MvPolynomial.X 0)) := by rw [hev0_X0]; exact isUnit_one
      have hL : Localization.awayLift ev₀ (MvPolynomial.X 0) hu0_X0 =
          (Localization.awayLift ev₀ X01 hu01).comp
            (Localization.awayLift (algebraMap A (Localization.Away X01))
              (MvPolynomial.X 0) huX0_loc) := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (MvPolynomial.X 0 : A))
        apply RingHom.ext
        intro p
        simp only [RingHom.comp_apply]
        dsimp only [Localization.awayLift]
        rw [IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq]
      ext z
      simp only [RingHom.comp_apply, ψ₀₁, ψ_chart, hv0_eq]
      change (Localization.awayLift ev₀ X01 hu01)
          (HomogeneousLocalization.val (HomogeneousLocalization.awayMap 𝒜 (hXa 1) rfl z)) =
        (Localization.awayLift ev₀ (MvPolynomial.X 0) hu0_X0) (HomogeneousLocalization.val z)
      rw [HomogeneousLocalization.val_awayMap, hL, RingHom.comp_apply]
    have h_eq1 : ψ₀₁.comp (HomogeneousLocalization.awayMap 𝒜 (hXa 0)
        (mul_comm (MvPolynomial.X 0) (MvPolynomial.X 1) : X01 = MvPolynomial.X 1 * MvPolynomial.X 0)) =
        ψ_chart (ρ_open U₀₁) 1 (fun b => resR (![r_pole i, 1] b))
          (by rw [hv₁_pole i, map_one]) := by
      by_cases hSub : Subsingleton R
      · have : Subsingleton S := RingHom.codomain_trivial (ρ_open U₀₁)
        ext z
        exact Subsingleton.elim _ _
      · rw [not_subsingleton_iff_nontrivial] at hSub
        have hu0_X1 : IsUnit (ev₀ (MvPolynomial.X 1)) :=
          IsUnit.of_mul_eq_one r_bar (by rw [hev0_X1]; exact hfr)
        have hL1 : Localization.awayLift ev₀ (MvPolynomial.X 1) hu0_X1 =
            (Localization.awayLift ev₀ X01 hu01).comp
              (Localization.awayLift (algebraMap A (Localization.Away X01))
                (MvPolynomial.X 1) huX1_loc) := by
          apply IsLocalization.ringHom_ext (Submonoid.powers (MvPolynomial.X 1 : A))
          apply RingHom.ext
          intro p
          simp only [RingHom.comp_apply]
          dsimp only [Localization.awayLift]
          rw [IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq]
        ext z
        simp only [RingHom.comp_apply, ψ₀₁, ψ_chart, hv1_eq]
        change (Localization.awayLift ev₀ X01 hu01)
            (HomogeneousLocalization.val (HomogeneousLocalization.awayMap 𝒜 (hXa 0) _ z)) =
          (Localization.awayLift ev₁ (MvPolynomial.X 1) _) (HomogeneousLocalization.val z)
        rw [HomogeneousLocalization.val_awayMap, ← RingHom.comp_apply, ← hL1]
        refine Quotient.inductionOn' z (fun t => ?_)
        obtain ⟨m, hm⟩ := t.den_mem
        have hd_eq : m = t.deg := by
          let q : A := (MvPolynomial.X 1 : A) ^ m
          have hden_hom : t.den.1.IsHomogeneous t.deg :=
            (MvPolynomial.mem_homogeneousSubmodule t.deg t.den.1).mp t.den.2
          have hq_deg : q.IsHomogeneous t.deg := by simpa [q, hm] using hden_hom
          have hq_m : q.IsHomogeneous m := by
            simpa [q, one_mul] using (MvPolynomial.isHomogeneous_X R (1 : Fin (1 + 1))).pow m
          have hq_ne : q ≠ 0 := by
            intro hq0
            have heval := congrArg (MvPolynomial.eval₂Hom (RingHom.id R) (fun _ => (1 : R))) hq0
            simp [q] at heval
          have hsupp : q.support.Nonempty := by
            rw [Finset.nonempty_iff_ne_empty]
            intro hemp
            apply hq_ne
            rw [MvPolynomial.as_sum q, hemp, Finset.sum_empty]
          obtain ⟨d₀, hd₀⟩ := hsupp
          have hd₀_ne := MvPolynomial.mem_support_iff.mp hd₀
          exact (hq_m hd₀_ne).symm.trans (hq_deg hd₀_ne)
        have hpow_mem : (MvPolynomial.X 1 : A) ^ m ∈ Submonoid.powers (MvPolynomial.X 1 : A) :=
          ⟨m, rfl⟩
        have ht_val : HomogeneousLocalization.val (HomogeneousLocalization.mk t) =
            Localization.mk t.num.1 ⟨(MvPolynomial.X 1 : A) ^ m, hpow_mem⟩ := by
          rw [HomogeneousLocalization.val_mk]
          congr 1
          exact Subtype.ext hm.symm
        rw [show (Quotient.mk'' t : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1)) =
            HomogeneousLocalization.mk t from rfl, ht_val]
        rw [Localization.awayLift_mk ev₀ (MvPolynomial.X 1) t.num.1 r_bar
          (by rw [hev0_X1]; exact hfr) m]
        rw [Localization.awayLift_mk ev₁ (MvPolynomial.X 1) t.num.1 1
          (by rw [hev1_X1, mul_one]) m, one_pow, mul_one, hd_eq]
        have hP_hom : t.num.1.IsHomogeneous t.deg :=
          (MvPolynomial.mem_homogeneousSubmodule t.deg t.num.1).mp t.num.2
        conv_lhs => rw [MvPolynomial.as_sum t.num.1]
        conv_rhs => rw [MvPolynomial.as_sum t.num.1]
        rw [map_sum, Finset.sum_mul, map_sum]
        refine Finset.sum_congr rfl (fun s hs => ?_)
        have hs_deg : s 0 + s 1 = t.deg := by
          have hne := MvPolynomial.mem_support_iff.mp hs
          have hw := hP_hom hne
          simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using hw
        rw [MvPolynomial.eval₂Hom_monomial, MvPolynomial.eval₂Hom_monomial]
        simp only [Finsupp.prod_fintype _ _ (fun _ => pow_zero _), ev₀, ev₁]
        have hf0 : (![1, f_bar] : Fin (1 + 1) → S) 0 = 1 := rfl
        have hf1 : (![1, f_bar] : Fin (1 + 1) → S) 1 = f_bar := rfl
        have hr0 : (![r_bar, 1] : Fin (1 + 1) → S) 0 = r_bar := rfl
        have hr1 : (![r_bar, 1] : Fin (1 + 1) → S) 1 = 1 := rfl
        rw [Fin.prod_univ_two, Fin.prod_univ_two, hf0, hf1, hr0, hr1,
          one_pow, one_mul, one_pow, mul_one]
        have hr_deg : r_bar ^ t.deg = r_bar ^ s 0 * r_bar ^ s 1 := by
          rw [← hs_deg, pow_add]
        rw [hr_deg, mul_assoc]
        congr 1
        calc
          f_bar ^ s 1 * (r_bar ^ s 0 * r_bar ^ s 1) =
              r_bar ^ s 0 * (f_bar * r_bar) ^ s 1 := by ring
          _ = r_bar ^ s 0 := by rw [hfr, one_pow, mul_one]
    have hX01_deg0 : X01 ∈ 𝒜 (1 + 1) :=
      SetLike.GradedMonoid.toGradedMul.mul_mem (hXa 0) (hXa 1)
    have hX01_deg1 : X01 ∈ 𝒜 (1 + 1) := by
      have h := SetLike.GradedMonoid.toGradedMul.mul_mem (hXa 1) (hXa 0)
      rwa [mul_comm] at h
    have hpos2 : 0 < 1 + 1 := Nat.zero_lt_succ 1
    have h_side0 : AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (R := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0)) (S := S)
            (ψ_chart (ρ_open U₀₁) 0 (fun b => resL (![1, f_sec] b)) (by rw [hv₀_U₀, map_one]))) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hXa 0) zero_lt_one =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (R := HomogeneousLocalization.Away 𝒜 X01) (S := S) ψ₀₁) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 X01 hX01_deg0 hpos2 := by
      rw [← h_eq0]
      have hc : CommRingCat.ofHom (R := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0)) (S := S)
          (ψ₀₁.comp (HomogeneousLocalization.awayMap 𝒜 (hXa 1) (rfl : X01 = _))) =
          CommRingCat.ofHom (R := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0))
            (S := HomogeneousLocalization.Away 𝒜 X01)
            (HomogeneousLocalization.awayMap 𝒜 (hXa 1) (rfl : X01 = _)) ≫
          CommRingCat.ofHom (R := HomogeneousLocalization.Away 𝒜 X01) (S := S) ψ₀₁ := rfl
      rw [hc, AlgebraicGeometry.Spec.map_comp, Category.assoc,
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hXa 0) zero_lt_one (hXa 1)
          (rfl : X01 = MvPolynomial.X 0 * MvPolynomial.X 1)]
    have h_side1 : AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (R := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1)) (S := S)
            (ψ_chart (ρ_open U₀₁) 1 (fun b => resR (![r_pole i, 1] b))
              (by rw [hv₁_pole i, map_one]))) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) (hXa 1) zero_lt_one =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (R := HomogeneousLocalization.Away 𝒜 X01) (S := S) ψ₀₁) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 X01 hX01_deg1 hpos2 := by
      rw [← h_eq1]
      have hc : CommRingCat.ofHom (R := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1)) (S := S)
          (ψ₀₁.comp (HomogeneousLocalization.awayMap 𝒜 (hXa 0)
            (mul_comm (MvPolynomial.X 0) (MvPolynomial.X 1)))) =
          CommRingCat.ofHom (R := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1))
            (S := HomogeneousLocalization.Away 𝒜 X01)
            (HomogeneousLocalization.awayMap 𝒜 (hXa 0)
              (mul_comm (MvPolynomial.X 0) (MvPolynomial.X 1))) ≫
          CommRingCat.ofHom (R := HomogeneousLocalization.Away 𝒜 X01) (S := S) ψ₀₁ := rfl
      rw [hc, AlgebraicGeometry.Spec.map_comp, Category.assoc,
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hXa 1) zero_lt_one (hXa 0)
          (mul_comm (MvPolynomial.X 0) (MvPolynomial.X 1))]
    rw [h_side0, h_side1]
  
  let J : Type u := ULift.{u} (Option (Fin (r_pts + 1)))
  let U_all : J → C_semi.Opens := fun j =>
    match j with
    | ⟨none⟩ => U₀
    | ⟨some i⟩ => W' i
  let f_all : ∀ j : J, (U_all j).toScheme ⟶ P := fun j =>
    match j with
    | ⟨none⟩ => π₀
    | ⟨some i⟩ => π_pole i
  have hIsCov : TopologicalSpace.IsOpenCover U_all := by
    change (⨆ j : J, U_all j) = ⊤
    refine le_antisymm le_top ?_
    rw [← hCov_top]
    exact sup_le (le_iSup U_all ⟨none⟩) (iSup_le fun i => le_iSup U_all ⟨some i⟩)
  let 𝒰 := C_semi.openCoverOfIsOpenCover U_all hIsCov
  have h_homOfLE_comp : ∀ {V₁ V₂ V₃ : C_semi.Opens} (h₁₂ : V₁ ≤ V₂) (h₂₃ : V₂ ≤ V₃),
      C_semi.homOfLE h₁₂ ≫ C_semi.homOfLE h₂₃ = C_semi.homOfLE (h₁₂.trans h₂₃) := by
    intro V₁ V₂ V₃ h₁₂ h₂₃
    apply (cancel_mono V₃.ι).mp
    rw [Category.assoc, C_semi.homOfLE_ι, C_semi.homOfLE_ι, C_semi.homOfLE_ι]
  have hPair : ∀ j₁ j₂ : J,
      C_semi.homOfLE (inf_le_left : U_all j₁ ⊓ U_all j₂ ≤ U_all j₁) ≫ f_all j₁ =
        C_semi.homOfLE (inf_le_right : U_all j₁ ⊓ U_all j₂ ≤ U_all j₂) ≫ f_all j₂ := by
    rintro ⟨j₁⟩ ⟨j₂⟩
    cases j₁ with
    | none =>
      cases j₂ with
      | none => rfl
      | some j => exact hAgree j
    | some i =>
      cases j₂ with
      | none =>
        have hcomm : W' i ⊓ U₀ ≤ U₀ ⊓ W' i := le_inf inf_le_right inf_le_left
        calc
          C_semi.homOfLE inf_le_left ≫ π_pole i =
              (C_semi.homOfLE hcomm ≫ C_semi.homOfLE inf_le_right) ≫ π_pole i := by
            rw [h_homOfLE_comp]
          _ = C_semi.homOfLE hcomm ≫ (C_semi.homOfLE inf_le_right ≫ π_pole i) := by
            rw [Category.assoc]
          _ = C_semi.homOfLE hcomm ≫ (C_semi.homOfLE inf_le_left ≫ π₀) := by
            rw [← hAgree i]
          _ = (C_semi.homOfLE hcomm ≫ C_semi.homOfLE inf_le_left) ≫ π₀ := by
            rw [← Category.assoc]
          _ = C_semi.homOfLE inf_le_right ≫ π₀ := by
            rw [h_homOfLE_comp]
      | some j =>
        by_cases hij : i = j
        · subst hij
          rfl
        · have hle₀ : W' i ⊓ W' j ≤ U₀ := hSep i j hij
          have h_to_i : W' i ⊓ W' j ≤ U₀ ⊓ W' i := le_inf hle₀ inf_le_left
          have h_to_j : W' i ⊓ W' j ≤ U₀ ⊓ W' j := le_inf hle₀ inf_le_right
          calc
            C_semi.homOfLE inf_le_left ≫ π_pole i =
                (C_semi.homOfLE h_to_i ≫ C_semi.homOfLE inf_le_right) ≫ π_pole i := by
              rw [h_homOfLE_comp]
            _ = C_semi.homOfLE h_to_i ≫ (C_semi.homOfLE inf_le_left ≫ π₀) := by
              rw [Category.assoc, ← hAgree i]
            _ = C_semi.homOfLE hle₀ ≫ π₀ := by
              rw [← Category.assoc, h_homOfLE_comp]
            _ = (C_semi.homOfLE h_to_j ≫ C_semi.homOfLE inf_le_left) ≫ π₀ := by
              rw [h_homOfLE_comp]
            _ = C_semi.homOfLE h_to_j ≫ (C_semi.homOfLE inf_le_right ≫ π_pole j) := by
              rw [Category.assoc, hAgree j]
            _ = C_semi.homOfLE inf_le_right ≫ π_pole j := by
              rw [← Category.assoc, h_homOfLE_comp]
  have hglue : ∀ j₁ j₂ : 𝒰.I₀,
      CategoryTheory.Limits.pullback.fst (𝒰.f j₁) (𝒰.f j₂) ≫ f_all j₁ =
        CategoryTheory.Limits.pullback.snd (𝒰.f j₁) (𝒰.f j₂) ≫ f_all j₂ := by
    intro (j₁ : J) (j₂ : J)
    let fst := CategoryTheory.Limits.pullback.fst (𝒰.f j₁) (𝒰.f j₂)
    let snd := CategoryTheory.Limits.pullback.snd (𝒰.f j₁) (𝒰.f j₂)
    let q : CategoryTheory.Limits.pullback (𝒰.f j₁) (𝒰.f j₂) ⟶ C_semi := fst ≫ (U_all j₁).ι
    have hq_snd : q = snd ≫ (U_all j₂).ι := CategoryTheory.Limits.pullback.condition
    have hrange : Set.range q.base ⊆ Set.range (U_all j₁ ⊓ U_all j₂).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      refine ⟨(fst.base z).2, ?_⟩
      have hz_eq : q.base z = (snd ≫ (U_all j₂).ι).base z := by
        rw [hq_snd]
      rw [hz_eq]
      exact (snd.base z).2
    let ℓ := AlgebraicGeometry.IsOpenImmersion.lift (U_all j₁ ⊓ U_all j₂).ι q hrange
    have hfst : fst = ℓ ≫ C_semi.homOfLE inf_le_left := by
      apply (cancel_mono (U_all j₁).ι).mp
      rw [Category.assoc, C_semi.homOfLE_ι, AlgebraicGeometry.IsOpenImmersion.lift_fac]
      rfl
    have hsnd : snd = ℓ ≫ C_semi.homOfLE inf_le_right := by
      apply (cancel_mono (U_all j₂).ι).mp
      rw [Category.assoc, C_semi.homOfLE_ι, AlgebraicGeometry.IsOpenImmersion.lift_fac]
      exact hq_snd.symm
    change fst ≫ f_all j₁ = snd ≫ f_all j₂
    rw [hfst, hsnd]
    exact (Category.assoc _ _ _).trans
      ((congrArg (ℓ ≫ ·) (hPair j₁ j₂)).trans (Category.assoc _ _ _).symm)
  let π : C_semi ⟶ P := 𝒰.glueMorphisms f_all hglue
  have hπ_U₀ : U₀.ι ≫ π = π₀ := 𝒰.ι_glueMorphisms f_all hglue ⟨none⟩
  have hπ_pole : ∀ i : Fin (r_pts + 1), (W' i).ι ≫ π = π_pole i :=
    fun i => 𝒰.ι_glueMorphisms f_all hglue ⟨some i⟩
  refine ⟨(π : C_semi ⟶ (weilProjectiveSpaceOver ↥V 1).left), ?_, ?_⟩
  · change π ≫ p_hom = g_semi
    apply 𝒰.hom_ext
    rintro ⟨j⟩
    cases j with
    | none =>
      change U₀.ι ≫ (π ≫ p_hom) = U₀.ι ≫ g_semi
      rw [← Category.assoc, hπ_U₀]
      exact hChart_comm U₀ 0 ![1, f_sec] hv₀_U₀
    | some i =>
      change (W' i).ι ≫ (π ≫ p_hom) = (W' i).ι ≫ g_semi
      rw [← Category.assoc, hπ_pole i]
      exact hChart_comm (W' i) 1 ![r_pole i, 1] (hv₁_pole i)
  · change ((TopologicalSpace.Opens.map π.base).obj D0 : Set ↥C_semi) = (U₀ : Set ↥C_semi)
    ext x
    constructor
    · intro hπx
      have hx_top : x ∈ (⊤ : C_semi.Opens) := trivial
      rw [← hCov_top] at hx_top
      rcases hx_top with hxU₀ | hx_sup
      · exact hxU₀
      · change x ∈ ⨆ i : Fin (r_pts + 1), W' i at hx_sup
        rw [TopologicalSpace.Opens.mem_iSup] at hx_sup
        rcases hx_sup with ⟨i, hxi⟩
        have hbase_i : (π_pole i).base ⟨x, hxi⟩ = π.base x := by
          rw [← hπ_pole i]
          rfl
        have hmem_D0 : (π_pole i).base ⟨x, hxi⟩ ∈ D0 := by
          rw [hbase_i]
          exact hπx
        exact ((hPre_i i ⟨x, hxi⟩).mp hmem_D0).1
    · intro hxU₀
      have hbase_0 : π₀.base ⟨x, hxU₀⟩ = π.base x := by
        rw [← hπ_U₀]
        rfl
      change π.base x ∈ D0
      rw [← hbase_0]
      exact hPre₀ ⟨x, hxU₀⟩

theorem weil_strictlySemistable_polar_divisor_section_lift (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_semi : C_semi ⟶ C')
    (τ_semi : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
    (ι_semi : C_K ⟶ C_semi)
    (hUnemb : IsUnembeddedSemistablePointedModel V p_K n σ_K g' τ'
      C_semi g_semi f_semi τ_semi ι_semi)
    (r_pts k₁ : ℕ)
    (σ_bar : Fin (r_pts + 1) →
      (AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.maximalIdeal ↥V).ResidueField) ⟶
        CategoryTheory.Limits.pullback g_semi
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (π_bar : CategoryTheory.Limits.pullback g_semi
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))) ⟶
      (weilProjectiveSpaceOver (IsLocalRing.maximalIdeal ↥V).ResidueField 1).left)
    (hPolar : IsClosedFiberPolarProjLineMap (IsLocalRing.maximalIdeal ↥V).ResidueField
      (CategoryTheory.Limits.pullback.snd g_semi
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
      r_pts k₁ σ_bar π_bar)
