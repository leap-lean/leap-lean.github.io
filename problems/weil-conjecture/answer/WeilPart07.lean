    · intro W X₁ X₂ g₁ g₂ ψ₁ hψ₁ ψ₂ hψ₂ u hu hc hX_twist
      let φ₁ := AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜_V ψ₁ hψ₁
      let φ₂ := AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜_V ψ₂ hψ₂
      let Φ₁ := g₁ ≫ φ₁
      let Φ₂ := g₂ ≫ φ₂
      have hHomog_twist : ∀ (d : ℕ) (H : MvPolynomial (Fin (N' + 1)) ↥V),
          H.IsHomogeneous d →
          g₂.appTop.hom (ψ₂ H) = u ^ d * g₁.appTop.hom (ψ₁ H) := by
        intro d H hH
