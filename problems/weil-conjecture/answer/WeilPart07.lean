  have hPart1 : ∀ U₁ U₂ : Y.Opens,
      AlgebraicGeometry.IsAffineOpen U₁ →
      AlgebraicGeometry.IsAffineOpen U₂ →
      AlgebraicGeometry.IsAffineOpen (U₁ ⊓ U₂) := by
