    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (hInjVF : Function.Injective φ_VF)
    (N : ℕ)
    (B : Finset (Fin (N + 1)) → Subring F)
    (t_loc : Fin (N + 1) → F)
    (k : ℕ)
    (hB_V : ∀ S : Finset (Fin (N + 1)), S.Nonempty → ∀ v : ↥V, φ_VF v ∈ B S)
    (hB_mono : ∀ S S' : Finset (Fin (N + 1)), S.Nonempty → S ⊆ S' → B S ≤ B S')
    (ht_mem : ∀ a : Fin (N + 1), t_loc a ∈ B {a} ∧ t_loc a ≠ 0)
    (ht_ratio : ∀ S : Finset (Fin (N + 1)), S.Nonempty →
      ∀ a ∈ S, ∀ b ∈ S, t_loc a / t_loc b ∈ B S)
    (hModels : ∀ S_F : Finset F, HasNoetherianDoubleComplexModelAt V F φ_VF N B t_loc k S_F)
    (hAcyclic_mod : ∀ (p : ℕ) (ξ : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I} → F),
