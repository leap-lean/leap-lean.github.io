            ψ_loc_ring (IsLocalization.Away.invSelf g) =
                ψ_loc_ring (IsLocalization.Away.invSelf g) *
                  (ψ_poly s * mk_ext (MvPolynomial.X Z_idx)) := by
              rw [h_sZ, mul_one]
            _ = (ψ_poly s * ψ_loc_ring (IsLocalization.Away.invSelf g)) *
                  mk_ext (MvPolynomial.X Z_idx) := by ring
            _ = mk_ext (MvPolynomial.X Z_idx) := by rw [h_inv, one_mul]
        · intro k
          change ψ_loc_ring (φ₀ (MvPolynomial.X (Fin.castSucc k))) =
            mk_ext (MvPolynomial.X (Fin.castSucc k))
          have h1 : φ₀ (MvPolynomial.X (Fin.castSucc k)) =
              algebraMap A' (Localization.Away g) (π_alg (MvPolynomial.X k)) := by
            change (MvPolynomial.aeval w) (MvPolynomial.X (Fin.castSucc k)) = _
            rw [MvPolynomial.aeval_X, hw_castSucc]
          rw [h1, hψ_loc_algMap, hψ_A'_apply]
          change mk_ext (MvPolynomial.rename Fin.castSucc (MvPolynomial.X k)) = _
          rw [MvPolynomial.rename_X]
      ext q
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
      exact AlgHom.congr_fun hcomp p
    let e_loc : Q_ext ≃ₐ[R] Localization.Away g := AlgEquiv.ofAlgHom Φ Ψ hΦΨ hΨΦ
    let P_pre : Algebra.PreSubmersivePresentation R Q_ext (Fin (r + N + 2)) (Fin (r + N + 1)) :=
      Algebra.PreSubmersivePresentation.naive (v := v) Fin.succ (Fin.succ_injective _)
    have hZ_not_range : Z_idx ∉ Set.range (Fin.castSucc : Fin (r + N + 1) → Fin (r + N + 2)) := by
      rintro ⟨k, hk⟩
      have hlt := Fin.castSucc_lt_last k
      rw [hk] at hlt
      exact lt_irrefl _ hlt
    have hpderiv_Z_rename : ∀ p : MvPolynomial (Fin (r + N + 1)) R,
        MvPolynomial.pderiv Z_idx (MvPolynomial.rename Fin.castSucc p) = 0 := by
      intro p
      apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
      intro hmem
      have himg := MvPolynomial.vars_rename Fin.castSucc p hmem
      rcases Finset.mem_image.mp himg with ⟨k, _, hk⟩
      exact hZ_not_range ⟨k, hk⟩
    let M_lift : Matrix (Fin (r + N)) (Fin (r + N)) (MvPolynomial (Fin (r + N + 1)) R) :=
      Matrix.of fun (i j : Fin (r + N)) => MvPolynomial.pderiv i.succ (Q j)
    let B₁₁ : Matrix (Fin (r + N)) (Fin (r + N)) P_ext :=
      (MvPolynomial.rename Fin.castSucc).toRingHom.mapMatrix M_lift
    let B₁₂ : Matrix (Fin (r + N)) (Fin 1) P_ext :=
      Matrix.of fun i _ =>
        P_pre.jacobiMatrix (finSumFinEquiv (Sum.inl i)) (finSumFinEquiv (Sum.inr 0))
    let B₂₂ : Matrix (Fin 1) (Fin 1) P_ext :=
      Matrix.of fun _ _ => MvPolynomial.rename Fin.castSucc s
    have h_inl_eq : ∀ i : Fin (r + N),
        finSumFinEquiv (Sum.inl i : Fin (r + N) ⊕ Fin 1) = Fin.castSucc i := by
      intro i
      ext
      simp
    have h_inr_eq : ∀ x : Fin 1,
        finSumFinEquiv (Sum.inr x : Fin (r + N) ⊕ Fin 1) = Fin.last (r + N) := by
      intro x
      ext
      simp
    have h_blocks :
        Matrix.reindex finSumFinEquiv.symm finSumFinEquiv.symm P_pre.jacobiMatrix =
          Matrix.fromBlocks B₁₁ B₁₂ 0 B₂₂ := by
      refine Matrix.ext fun x y => ?_
      rcases x with i | a <;> rcases y with j | b
      · change P_pre.jacobiMatrix (finSumFinEquiv (Sum.inl i)) (finSumFinEquiv (Sum.inl j)) =
          MvPolynomial.rename Fin.castSucc (MvPolynomial.pderiv i.succ (Q j))
        rw [h_inl_eq i, h_inl_eq j]
        dsimp only [P_pre]
        rw [Algebra.PreSubmersivePresentation.jacobiMatrix_naive]
        have hsucc : (Fin.castSucc i).succ = Fin.castSucc i.succ := by
          ext
          simp
        dsimp only [v]
        rw [hsucc, Fin.lastCases_castSucc]
        exact MvPolynomial.pderiv_rename (Fin.castSucc_injective _) i.succ (Q j)
      · have hb : b = 0 := Subsingleton.elim b 0
        subst hb
        rfl
      · change P_pre.jacobiMatrix (finSumFinEquiv (Sum.inr a)) (finSumFinEquiv (Sum.inl j)) = 0
        rw [h_inr_eq a, h_inl_eq j]
        dsimp only [P_pre]
        rw [Algebra.PreSubmersivePresentation.jacobiMatrix_naive]
        have hlast_succ : (Fin.last (r + N)).succ = Z_idx := by
          ext
          simp [Z_idx]
        dsimp only [v]
        rw [hlast_succ, Fin.lastCases_castSucc]
        exact hpderiv_Z_rename (Q j)
      · change P_pre.jacobiMatrix (finSumFinEquiv (Sum.inr a)) (finSumFinEquiv (Sum.inr b)) =
          MvPolynomial.rename Fin.castSucc s
        rw [h_inr_eq a, h_inr_eq b]
        dsimp only [P_pre]
        rw [Algebra.PreSubmersivePresentation.jacobiMatrix_naive]
        have hlast_succ : (Fin.last (r + N)).succ = Z_idx := by
          ext
          simp [Z_idx]
        dsimp only [v]
        rw [hlast_succ, Fin.lastCases_last, map_sub, Derivation.leibniz, MvPolynomial.pderiv_one,
          hpderiv_Z_rename s, MvPolynomial.pderiv_X_self]
        simp
    have hdet : P_pre.jacobiMatrix.det =
        MvPolynomial.rename Fin.castSucc Δ_lift * MvPolynomial.rename Fin.castSucc s := by
      rw [← Matrix.det_reindex_self finSumFinEquiv.symm P_pre.jacobiMatrix, h_blocks,
        Matrix.det_fromBlocks_zero₂₁]
      have hdet11 : B₁₁.det = MvPolynomial.rename Fin.castSucc Δ_lift := by
        dsimp only [B₁₁, Δ_lift, M_lift]
        exact (RingHom.map_det (MvPolynomial.rename Fin.castSucc).toRingHom M_lift).symm
      have hdet22 : B₂₂.det = MvPolynomial.rename Fin.castSucc s := by
        simp [B₂₂]
      rw [hdet11, hdet22]
    have hUnit_jac : IsUnit P_pre.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      have halg_eq : (algebraMap P_pre.Ring Q_ext) P_pre.jacobiMatrix.det =
          mk_ext P_pre.jacobiMatrix.det := rfl
      rw [halg_eq, hdet, map_mul]
      change IsUnit (ψ_poly Δ_lift * ψ_poly s)
      refine isUnit_iff_exists_inv.mpr ⟨ψ_poly S₀ * mk_ext (MvPolynomial.X Z_idx) ^ 2, ?_⟩
      calc
        (ψ_poly Δ_lift * ψ_poly s) * (ψ_poly S₀ * mk_ext (MvPolynomial.X Z_idx) ^ 2) =
            ((ψ_poly S₀ * ψ_poly Δ_lift) * mk_ext (MvPolynomial.X Z_idx)) *
              (ψ_poly s * mk_ext (MvPolynomial.X Z_idx)) := by ring
        _ = (ψ_poly s * mk_ext (MvPolynomial.X Z_idx)) *
              (ψ_poly s * mk_ext (MvPolynomial.X Z_idx)) := by
          simp only [s, map_mul]
        _ = 1 := by rw [h_sZ, mul_one]
    let P_sub : Algebra.SubmersivePresentation R (Localization.Away g)
        (Fin (r + N + 2)) (Fin (r + N + 1)) :=
      (Algebra.SubmersivePresentation.mk P_pre hUnit_jac).ofAlgEquiv e_loc
    have hdim : P_sub.dimension = 1 := by
      dsimp only [P_sub]
      change ((Algebra.SubmersivePresentation.mk P_pre hUnit_jac).toPresentation.ofAlgEquiv e_loc).dimension = 1
      rw [Algebra.Presentation.dimension_ofAlgEquiv]
      change Nat.card (Fin (r + N + 2)) - Nat.card (Fin (r + N + 1)) = 1
      simp only [Nat.card_fin]
      omega
    exact P_sub.isStandardSmoothOfRelativeDimension hdim
  
  intro k₀ s₀ y₀ W_sm hy₀ hSm
  obtain ⟨A'_cat, φ, P, hP_prime, hFlat_φ, hFP_φ, hmP, hSmBar, hLift⟩ :=
    h_step5 y₀ W_sm hy₀ hSm
  let _ : Algebra R (↑A'_cat) := φ.toAlgebra
  have _ : Module.Flat R (↑A'_cat) := RingHom.flat_algebraMap_iff.mp hFlat_φ
  have _ : Algebra.FinitePresentation R (↑A'_cat) :=
    RingHom.finitePresentation_algebraMap.mp hFP_φ
  have _ : P.IsPrime := hP_prime
  obtain ⟨r, N, π_alg, Q, S₀, hSurj, hQ, hS₀_not_P, hΔ_not_P, hAnn⟩ :=
    h_step6 (↑A'_cat) P hmP hSmBar
  let Δ_lift : MvPolynomial (Fin (r + N + 1)) R :=
    (Matrix.of fun (i j : Fin (r + N)) => MvPolynomial.pderiv i.succ (Q j)).det
  let g : ↑A'_cat := π_alg (S₀ * Δ_lift)
  have hg_not_P : g ∉ P := by
    change π_alg (S₀ * Δ_lift) ∉ P
    rw [map_mul]
    intro hmem
    exact (hP_prime.mem_or_mem hmem).elim hS₀_not_P hΔ_not_P
  have hStd : Algebra.IsStandardSmoothOfRelativeDimension 1 R (Localization.Away g) :=
    h_step7 (↑A'_cat) r N π_alg hSurj Q hQ S₀ hAnn
  have hStd_hom : RingHom.IsStandardSmoothOfRelativeDimension 1
      ((algebraMap (↑A'_cat) (Localization.Away g)).comp φ) := by
    have halg : (algebraMap (↑A'_cat) (Localization.Away g)).comp φ =
        algebraMap R (Localization.Away g) := by
      ext c
      exact (IsScalarTower.algebraMap_apply R (↑A'_cat) (Localization.Away g) c).symm
    rw [halg]
    exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hStd
  exact hLift g hg_not_P hStd_hom

theorem weil_sup1_pencil_pullback_splits_and_smooth_lift (K : Type u) [Field K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ)
    (V₀ V₁ : C.Opens)
    (h₀ : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁))) :
    let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
    let Y := CategoryTheory.Limits.pullback g s₀
    let fstY := CategoryTheory.Limits.pullback.fst g s₀
    let sndY := CategoryTheory.Limits.pullback.snd g s₀
    let Y'_set : Set ↥Y := ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E'
    let Δ : Set ↥Y := Z ∩ Y'_set
    let R₀ := C.presheaf.obj (Opposite.op V₀)
    let R₁ := C.presheaf.obj (Opposite.op V₁)
    letI : Algebra ↥V ↑R₀ := (
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₀ le_top).hom.toAlgebra
    letI : Algebra ↥V ↑R₁ := (
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₁ le_top).hom.toAlgebra
    AlgebraicGeometry.IsAffineOpen V₀ →
    AlgebraicGeometry.IsAffineOpen V₁ →
    V₀ ⊔ V₁ = ⊤ →
    C.basicOpen h₀ = V₀ ⊓ V₁ →
    C.basicOpen t₀ = V₀ ⊓ V₁ →
    (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom h₀ *
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom t₀ = 1 →
    (Polynomial.aeval (R := ↥V) h₀).toRingHom.Finite →
    (Polynomial.aeval (R := ↥V) t₀).toRingHom.Finite →
    (∀ q ∈ Δ, fstY.base q ∈ V₁) →
    (∀ y : ↥Y, fstY.base y ∈ V₀ → fstY.base y ∉ (C.basicOpen h₀ : Set C) →
      ∃ W_sm : Y.Opens,
        y ∈ W_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ sndY)) →
    (∀ (K' : Type u) [Field K'] [IsAlgClosed K']
        (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      AlgebraicGeometry.IsReduced (CategoryTheory.Limits.pullback g s) ∧
      ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s),
        ∀ U_aff : (CategoryTheory.Limits.pullback g s).Opens,
          AlgebraicGeometry.IsAffineOpen U_aff →
          (E \ (U_aff : Set ↥(CategoryTheory.Limits.pullback g s))).Nonempty) →
    (∀ (R : Type u) [CommRing R] [Algebra ↥V R],
      Module.Flat ↥V R →
      Algebra.FinitePresentation ↥V R →
      ∀ (x : R), (Polynomial.aeval (R := ↥V) x).toRingHom.Finite →
      ∀ (P : Polynomial ↥V), P.Monic →
      (let I_m : Ideal R := Ideal.map (algebraMap ↥V R) (IsLocalRing.maximalIdeal ↥V)
       let q_m : R →+* R ⧸ I_m := Ideal.Quotient.mk I_m
       ∀ b : R ⧸ I_m, q_m (Polynomial.aeval x P) * b = 0 → b = 0) →
      Module.Free ↥V (R ⧸ Ideal.span ({Polynomial.aeval x P} : Set R)) ∧
      Module.Finite ↥V (R ⧸ Ideal.span ({Polynomial.aeval x P} : Set R))) →
    (∀ (R : Type u) [CommRing R] [Algebra ↥V R] (h u₀ : R),
      Module.Free ↥V (R ⧸ Ideal.span ({h} : Set R)) →
      Module.Finite ↥V (R ⧸ Ideal.span ({h} : Set R)) →
      (let I_mh : Ideal R :=
         Ideal.map (algebraMap ↥V R) (IsLocalRing.maximalIdeal ↥V) ⊔ Ideal.span ({h} : Set R)
       let π_bar : R →+* R ⧸ I_mh := Ideal.Quotient.mk I_mh
       π_bar u₀ * π_bar u₀ = π_bar u₀) →
      ∃ eZ eY : R,
        eZ + eY = 1 ∧
        eZ * eY ∈ Ideal.span ({h} : Set R) ∧
        (let I_mh : Ideal R :=
           Ideal.map (algebraMap ↥V R) (IsLocalRing.maximalIdeal ↥V) ⊔ Ideal.span ({h} : Set R)
         Ideal.Quotient.mk I_mh eZ = Ideal.Quotient.mk I_mh u₀ ∧
         Ideal.Quotient.mk I_mh eY = 1 - Ideal.Quotient.mk I_mh u₀) ∧
        Module.Free ↥V (R ⧸ Ideal.span ({h, eY} : Set R)) ∧
        Module.Finite ↥V (R ⧸ Ideal.span ({h, eY} : Set R)) ∧
        Module.Free ↥V (R ⧸ Ideal.span ({h, eZ} : Set R)) ∧
        Module.Finite ↥V (R ⧸ Ideal.span ({h, eZ} : Set R))) →
    ∃ eZ eY : ↑R₀,
      (∀ r : ℕ, 1 ≤ r →
        Module.Free ↥V (↑R₀ ⧸ Ideal.span ({h₀ ^ r} : Set ↑R₀)) ∧
        Module.Finite ↥V (↑R₀ ⧸ Ideal.span ({h₀ ^ r} : Set ↑R₀)) ∧
        Nontrivial (↑R₀ ⧸ Ideal.span ({h₀ ^ r} : Set ↑R₀))) ∧
      (∀ r : ℕ, 1 ≤ r →
        Module.Free ↥V (↑R₁ ⧸ Ideal.span ({t₀ ^ r} : Set ↑R₁)) ∧
        Module.Finite ↥V (↑R₁ ⧸ Ideal.span ({t₀ ^ r} : Set ↑R₁)) ∧
        Nontrivial (↑R₁ ⧸ Ideal.span ({t₀ ^ r} : Set ↑R₁))) ∧
      (∀ Q : Polynomial ↥V, Q.Monic →
        Module.Free ↥V (↑R₁ ⧸ Ideal.span ({Polynomial.aeval t₀ Q} : Set ↑R₁)) ∧
        Module.Finite ↥V (↑R₁ ⧸ Ideal.span ({Polynomial.aeval t₀ Q} : Set ↑R₁))) ∧
      eZ + eY = 1 ∧
      eZ * eY ∈ Ideal.span ({h₀} : Set ↑R₀) ∧
      Module.Free ↥V (↑R₀ ⧸ Ideal.span ({h₀, eY} : Set ↑R₀)) ∧
      Module.Finite ↥V (↑R₀ ⧸ Ideal.span ({h₀, eY} : Set ↑R₀)) ∧
      Nontrivial (↑R₀ ⧸ Ideal.span ({h₀, eY} : Set ↑R₀)) ∧
      Module.Free ↥V (↑R₀ ⧸ Ideal.span ({h₀, eZ} : Set ↑R₀)) ∧
      Module.Finite ↥V (↑R₀ ⧸ Ideal.span ({h₀, eZ} : Set ↑R₀)) ∧
      Nontrivial (↑R₀ ⧸ Ideal.span ({h₀, eZ} : Set ↑R₀)) ∧
      (∀ x : ↥V₀, x.1 ∉ (C.basicOpen h₀ : Set C) →
        ∃ V_sm : C.Opens, x.1 ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g)) ∧
      (∀ (K' : Type u) [Field K'] [IsAlgClosed K']
          (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
          (E : Set ↥(CategoryTheory.Limits.pullback g s)),
        E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s) →
        (((CategoryTheory.Limits.pullback.fst g s).base ⁻¹' ((V₀ ⊓ V₁ : C.Opens) : Set C)) ∩ E).Nonempty) ∧
      Z ⊆ fstY.base ⁻¹' ((V₁ ⊔ C.basicOpen eZ : C.Opens) : Set C) ∧
      Y'_set ⊆ fstY.base ⁻¹' ((V₁ ⊔ C.basicOpen eY : C.Opens) : Set C) ∧
      (∀ E' ∈ (irreducibleComponents ↥Y) \ {Z}, (E' \ fstY.base ⁻¹' (V₁ : Set C)).Nonempty) :=
by
  classical
  intro k₀ s₀ Y fstY sndY Y'_set Δ R₀ R₁
  let φ₀ : ↥V →+* ↑R₀ := (
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₀ le_top).hom
  let φ₁ : ↥V →+* ↑R₁ := (
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₁ le_top).hom
  let _ : Algebra ↥V ↑R₀ := φ₀.toAlgebra
  let _ : Algebra ↥V ↑R₁ := φ₁.toAlgebra
  intro hAff₀ hAff₁ hCov hBas₀ hBas₁ hInv hFin₀ hFin₁ hΔ_V₁ hSmY_inf hFibNonAff hAlgFree hAlgHensel
  
  have _ : (IsLocalRing.maximalIdeal ↥V).IsPrime := inferInstance
  have _ : IsAlgClosed k₀ := hPkg.2.2.2.2.1 (IsLocalRing.maximalIdeal ↥V) hMaxNeBot
  obtain ⟨hRedY, hNonAffY⟩ := hFibNonAff k₀ s₀
  
  have hFlatG : AlgebraicGeometry.Flat g := hSemi.1.2.1
  have hLFPG : AlgebraicGeometry.LocallyOfFinitePresentation g := hSemi.1.2.2.2.1
  obtain ⟨hFlatφ₀_imp, hFPφ₀_imp, ψ₀, _hOpenψ₀, hRangeψ₀, hCompψ₀, hBasψ₀, hRedMinψ₀_imp⟩ :=
    weil_localRing_affineOpen_closedFiber_pullback_spec ↥V C g V₀ hAff₀
  obtain ⟨hFlatφ₁_imp, hFPφ₁_imp, ψ₁, _hOpenψ₁, hRangeψ₁, _hCompψ₁, hBasψ₁, hRedMinψ₁_imp⟩ :=
    weil_localRing_affineOpen_closedFiber_pullback_spec ↥V C g V₁ hAff₁
  have hFlatR₀ : Module.Flat ↥V ↑R₀ := hFlatφ₀_imp hFlatG
  have hFPR₀ : Algebra.FinitePresentation ↥V ↑R₀ := hFPφ₀_imp hLFPG
  have hFlatR₁ : Module.Flat ↥V ↑R₁ := hFlatφ₁_imp hFlatG
  have hFPR₁ : Algebra.FinitePresentation ↥V ↑R₁ := hFPφ₁_imp hLFPG
  obtain ⟨hRedR₀_bar, hMinψ₀⟩ := hRedMinψ₀_imp hRedY
  obtain ⟨hRedR₁_bar, hMinψ₁⟩ := hRedMinψ₁_imp hRedY
  
  obtain ⟨hOverlapGen, hNzdImp⟩ :=
    weil_twoAffineCover_monic_eval_nonZeroDivisor ↥V C g V₀ V₁ h₀ t₀
      hAff₀ hAff₁ hCov hBas₀ hBas₁ hInv
  have hC13 : ∀ (K' : Type u) [Field K'] [IsAlgClosed K']
      (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (E : Set ↥(CategoryTheory.Limits.pullback g s)),
      E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s) →
      (((CategoryTheory.Limits.pullback.fst g s).base ⁻¹' ((V₀ ⊓ V₁ : C.Opens) : Set C)) ∩ E).Nonempty := by
    intro K' _ _ s E hE
    exact hOverlapGen K' s E hE ((hFibNonAff K' s).2 E hE)
  obtain ⟨hNzd_h₀, hNzd_t₀, hNzd_Q⟩ :=
    hNzdImp hNonAffY ψ₀ ψ₁ hRangeψ₀ hBasψ₀ hRedR₀_bar hMinψ₀ hRangeψ₁ hBasψ₁ hRedR₁_bar hMinψ₁
  
  have hFreeFin_h₀ : ∀ r : ℕ,
      Module.Free ↥V (↑R₀ ⧸ Ideal.span ({h₀ ^ r} : Set ↑R₀)) ∧
      Module.Finite ↥V (↑R₀ ⧸ Ideal.span ({h₀ ^ r} : Set ↑R₀)) := by
    intro r
    have haeval : Polynomial.aeval (R := ↥V) h₀ (Polynomial.X ^ r) = h₀ ^ r := by
      rw [map_pow, Polynomial.aeval_X]
    have h1 := hAlgFree ↑R₀ hFlatR₀ hFPR₀ h₀ hFin₀ (Polynomial.X ^ r) (Polynomial.monic_X_pow r)
      (by
        intro I_m q_m b hb
        rw [haeval] at hb
        exact hNzd_h₀ r b hb)
    rwa [haeval] at h1
  have hFreeFin_t₀ : ∀ r : ℕ,
      Module.Free ↥V (↑R₁ ⧸ Ideal.span ({t₀ ^ r} : Set ↑R₁)) ∧
      Module.Finite ↥V (↑R₁ ⧸ Ideal.span ({t₀ ^ r} : Set ↑R₁)) := by
    intro r
    have haeval : Polynomial.aeval (R := ↥V) t₀ (Polynomial.X ^ r) = t₀ ^ r := by
      rw [map_pow, Polynomial.aeval_X]
    have h1 := hAlgFree ↑R₁ hFlatR₁ hFPR₁ t₀ hFin₁ (Polynomial.X ^ r) (Polynomial.monic_X_pow r)
      (by
        intro I_m q_m b hb
        rw [haeval] at hb
        exact hNzd_t₀ r b hb)
    rwa [haeval] at h1
  have hC3 : ∀ Q : Polynomial ↥V, Q.Monic →
      Module.Free ↥V (↑R₁ ⧸ Ideal.span ({Polynomial.aeval t₀ Q} : Set ↑R₁)) ∧
      Module.Finite ↥V (↑R₁ ⧸ Ideal.span ({Polynomial.aeval t₀ Q} : Set ↑R₁)) := by
    intro Q hQ
    exact hAlgFree ↑R₁ hFlatR₁ hFPR₁ t₀ hFin₁ Q hQ (by
      intro I_m q_m b hb
      rw [Polynomial.aeval_def] at hb
      exact hNzd_Q Q hQ b hb)
  
  have hAff_s₀ : AlgebraicGeometry.IsAffineHom s₀ := AlgebraicGeometry.isAffineHom_of_isAffine s₀
  let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.IsAffineHom) g :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have _ : AlgebraicGeometry.IsAffineHom fstY :=
    CategoryTheory.MorphismProperty.pullback_fst (P := @AlgebraicGeometry.IsAffineHom) g s₀ hAff_s₀
  have hAff₀_Y : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map fstY.base).obj V₀) :=
    hAff₀.preimage fstY
  have hAff₁_Y : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map fstY.base).obj V₁) :=
    hAff₁.preimage fstY
  have hC16 : ∀ E' ∈ (irreducibleComponents ↥Y) \ {Z}, (E' \ fstY.base ⁻¹' (V₁ : Set C)).Nonempty := by
    intro E' hE'
    exact hNonAffY E' hE'.1 ((TopologicalSpace.Opens.map fstY.base).obj V₁) hAff₁_Y
  have hNt_t₀ : ∀ r : ℕ, 1 ≤ r → Nontrivial (↑R₁ ⧸ Ideal.span ({t₀ ^ r} : Set ↑R₁)) := by
    obtain ⟨y₁, hy₁Z, hy₁_notV₀⟩ :=
      hNonAffY Z hUnstab.1 ((TopologicalSpace.Opens.map fstY.base).obj V₀) hAff₀_Y
    have hy₁_V₁ : fstY.base y₁ ∈ V₁ := by
      have htop : fstY.base y₁ ∈ (⊤ : C.Opens) := trivial
      rw [← hCov] at htop
      rcases htop with h0 | h1
      · exact False.elim (hy₁_notV₀ h0)
      · exact h1
    have hy₁_not_t₀ : fstY.base y₁ ∉ (C.basicOpen t₀ : Set C) := by
      rw [hBas₁]
      intro hmem
      exact hy₁_notV₀ hmem.1
    let p₁ : PrimeSpectrum ↑R₁ := hAff₁.primeIdealOf ⟨fstY.base y₁, hy₁_V₁⟩
    have hp₁_pt : hAff₁.fromSpec.base p₁ = fstY.base y₁ :=
      hAff₁.fromSpec_primeIdealOf ⟨fstY.base y₁, hy₁_V₁⟩
    have ht₀_mem : t₀ ∈ p₁.asIdeal := by
      by_contra ht₀_nmem
      have hbasic : p₁ ∈ (PrimeSpectrum.basicOpen t₀ : Set (PrimeSpectrum ↑R₁)) := ht₀_nmem
      rw [← hAff₁.fromSpec_preimage_basicOpen t₀] at hbasic
      change hAff₁.fromSpec.base p₁ ∈ (C.basicOpen t₀ : Set C) at hbasic
      rw [hp₁_pt] at hbasic
      exact hy₁_not_t₀ hbasic
    intro r hr
    have hpow_mem : t₀ ^ r ∈ p₁.asIdeal := Ideal.pow_mem_of_mem p₁.asIdeal ht₀_mem r hr
    have hspan_ne_top : Ideal.span ({t₀ ^ r} : Set ↑R₁) ≠ ⊤ := by
      intro htop
      apply p₁.isPrime.ne_top
      exact top_unique (htop ▸ Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hpow_mem))
    exact Ideal.Quotient.nontrivial_iff.mpr hspan_ne_top
  
  have hZ_closed : IsClosed Z := isClosed_of_mem_irreducibleComponents Z hUnstab.1
  have hY'_closed : IsClosed Y'_set := hUnstab.2.2.2.2.2.1
  have hY'_ne : Y'_set.Nonempty := hUnstab.2.2.2.2.2.2.1
  have hZY'_univ : Z ∪ Y'_set = Set.univ := hUnstab.2.2.2.2.2.2.2.1
  have hZ_inf_ne : (Z \ fstY.base ⁻¹' (V₁ : Set C)).Nonempty :=
    hNonAffY Z hUnstab.1 ((TopologicalSpace.Opens.map fstY.base).obj V₁) hAff₁_Y
  have hY'_inf_ne : (Y'_set \ fstY.base ⁻¹' (V₁ : Set C)).Nonempty := by
    obtain ⟨y, hy⟩ := hY'_ne
    obtain ⟨E', hE'_mem, _⟩ := Set.mem_iUnion₂.mp hy
    obtain ⟨y', hy'E', hy'_notV₁⟩ := hC16 E' hE'_mem
    exact ⟨y', Set.subset_biUnion_of_mem hE'_mem hy'E', hy'_notV₁⟩
  obtain ⟨hNt_h₀, u₀, hu₀_idem, hTransfer⟩ :=
    weil_closedFiber_infinity_clopen_idempotent_witness ↥V C g V₀ V₁ h₀
      hCov hBas₀ ψ₀ hRangeψ₀ hBasψ₀ Z Y'_set
      hZ_closed hY'_closed hZY'_univ hΔ_V₁ hZ_inf_ne hY'_inf_ne
  have hFreeFin_h₀_1 :
      Module.Free ↥V (↑R₀ ⧸ Ideal.span ({h₀} : Set ↑R₀)) ∧
      Module.Finite ↥V (↑R₀ ⧸ Ideal.span ({h₀} : Set ↑R₀)) := by
    have h1 := hFreeFin_h₀ 1
    rwa [pow_one] at h1
  obtain ⟨eZ, eY, he_sum, he_mul, ⟨heZ_mk, heY_mk⟩, hFree_eY, hFin_eY, hFree_eZ, hFin_eZ⟩ :=
    hAlgHensel ↑R₀ h₀ u₀ hFreeFin_h₀_1.1 hFreeFin_h₀_1.2 hu₀_idem
  obtain ⟨hNt_eY, hNt_eZ, hC14, hC15⟩ := hTransfer eZ eY heZ_mk heY_mk
  
  have hC12 : ∀ x : ↥V₀, x.1 ∉ (C.basicOpen h₀ : Set C) →
      ∃ V_sm : C.Opens, x.1 ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g) := by
    intro x hx_not_h₀
    let p_x : PrimeSpectrum ↑R₀ := hAff₀.primeIdealOf x
    have hp_x_pt : hAff₀.fromSpec.base p_x = x.1 := hAff₀.fromSpec_primeIdealOf x
    have hh₀_px : h₀ ∈ p_x.asIdeal := by
      by_contra hh₀_nmem
      have hbasic : p_x ∈ (PrimeSpectrum.basicOpen h₀ : Set (PrimeSpectrum ↑R₀)) := hh₀_nmem
      rw [← hAff₀.fromSpec_preimage_basicOpen h₀] at hbasic
      change hAff₀.fromSpec.base p_x ∈ (C.basicOpen h₀ : Set C) at hbasic
      rw [hp_x_pt] at hbasic
      exact hx_not_h₀ hbasic
    let J_h₀ : Ideal ↑R₀ := Ideal.span ({h₀} : Set ↑R₀)
    let B := ↑R₀ ⧸ J_h₀
    let q_h : ↑R₀ →+* B := Ideal.Quotient.mk J_h₀
    have _ : Module.Finite ↥V B := hFreeFin_h₀_1.2
    have _ : Algebra.IsIntegral ↥V B := Algebra.IsIntegral.of_finite ↥V B
    have hJ_le_px : J_h₀ ≤ p_x.asIdeal := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hh₀_px)
    have hsurj_qh : Function.Surjective q_h := Ideal.Quotient.mk_surjective
    have hker_qh : RingHom.ker q_h ≤ p_x.asIdeal := by rwa [Ideal.mk_ker]
    have hcomap_map_px : Ideal.comap q_h (Ideal.map q_h p_x.asIdeal) = p_x.asIdeal := by
      rw [Ideal.comap_map_of_surjective q_h hsurj_qh]
      exact sup_eq_left.mpr hker_qh
    have halg_B : algebraMap ↥V B = q_h.comp φ₀ := rfl
    have hcomap_V : Ideal.comap (algebraMap ↥V B) (Ideal.map q_h p_x.asIdeal) =
        Ideal.comap φ₀ p_x.asIdeal := by
      rw [halg_B, ← Ideal.comap_comap, hcomap_map_px]
    have _ : (Ideal.comap φ₀ p_x.asIdeal).IsPrime := Ideal.comap_isPrime φ₀ p_x.asIdeal
    have hle_max : Ideal.comap (algebraMap ↥V B) (Ideal.map q_h p_x.asIdeal) ≤
        IsLocalRing.maximalIdeal ↥V := by
      rw [hcomap_V]
      exact IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
    obtain ⟨Q_bar, hQ_ge, hQ_prime, hQ_over⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral (IsLocalRing.maximalIdeal ↥V)
        (Ideal.map q_h p_x.asIdeal) hle_max
    let q₀ : PrimeSpectrum ↑R₀ := ⟨Ideal.comap q_h Q_bar, Ideal.comap_isPrime q_h Q_bar⟩
    have hpx_le_q₀ : p_x.asIdeal ≤ q₀.asIdeal := fun a ha =>
      hQ_ge (Ideal.mem_map_of_mem q_h ha)
    have hh₀_q₀ : h₀ ∈ q₀.asIdeal := by
      change q_h h₀ ∈ Q_bar
      have h0 : q_h h₀ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [h0]
      exact Q_bar.zero_mem
    let I_m0 : Ideal ↑R₀ := Ideal.map φ₀ (IsLocalRing.maximalIdeal ↥V)
    have hIm0_le_q₀ : I_m0 ≤ q₀.asIdeal := by
      rw [Ideal.map_le_iff_le_comap]
      have hcomp : Ideal.comap φ₀ q₀.asIdeal = Ideal.under ↥V Q_bar := by
        change Ideal.comap φ₀ (Ideal.comap q_h Q_bar) = Ideal.comap (algebraMap ↥V B) Q_bar
        rw [halg_B, ← Ideal.comap_comap]
      rw [hcomp, hQ_over]
    have hsurj_Im0 : Function.Surjective (Ideal.Quotient.mk I_m0) := Ideal.Quotient.mk_surjective
    have hker_Im0 : RingHom.ker (Ideal.Quotient.mk I_m0) ≤ q₀.asIdeal := by rwa [Ideal.mk_ker]
    have _ : (Ideal.map (Ideal.Quotient.mk I_m0) q₀.asIdeal).IsPrime :=
      Ideal.map_isPrime_of_surjective hsurj_Im0 hker_Im0
    let q_bar : PrimeSpectrum (↑R₀ ⧸ I_m0) :=
      ⟨Ideal.map (Ideal.Quotient.mk I_m0) q₀.asIdeal, inferInstance⟩
    have hSpec_qbar :
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I_m0))).base q_bar = q₀ := by
      apply PrimeSpectrum.ext
      ext a
      change Ideal.Quotient.mk I_m0 a ∈ Ideal.map (Ideal.Quotient.mk I_m0) q₀.asIdeal ↔ a ∈ q₀.asIdeal
      constructor
      · intro ha
        have hcomap : a ∈ Ideal.comap (Ideal.Quotient.mk I_m0)
            (Ideal.map (Ideal.Quotient.mk I_m0) q₀.asIdeal) := ha
        rw [Ideal.comap_map_of_surjective _ hsurj_Im0] at hcomap
        exact sup_eq_left.mpr hker_Im0 ▸ hcomap
      · intro ha
        exact Ideal.mem_map_of_mem (Ideal.Quotient.mk I_m0) ha
    let y₀ : ↥Y := ψ₀.base q_bar
    have hy₀_fst : fstY.base y₀ = hAff₀.fromSpec.base q₀ := by
      have h_eval := congrArg (fun f => f.base q_bar) hCompψ₀
      change fstY.base (ψ₀.base q_bar) =
        hAff₀.fromSpec.base
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I_m0))).base q_bar) at h_eval
      rw [hSpec_qbar] at h_eval
      exact h_eval
    have hy₀_V₀ : fstY.base y₀ ∈ V₀ := by
      rw [hy₀_fst]
      have hmem : hAff₀.fromSpec.base q₀ ∈ Set.range hAff₀.fromSpec.base := ⟨q₀, rfl⟩
      rwa [hAff₀.range_fromSpec] at hmem
    have hy₀_not_h₀ : fstY.base y₀ ∉ (C.basicOpen h₀ : Set C) := by
      rw [hy₀_fst]
      intro hmem
      have hbasic : q₀ ∈ (PrimeSpectrum.basicOpen h₀ : Set (PrimeSpectrum ↑R₀)) := by
        rw [← hAff₀.fromSpec_preimage_basicOpen h₀]
        exact hmem
      exact hbasic hh₀_q₀
    obtain ⟨W_sm, hy₀_W, hSm_W⟩ := hSmY_inf y₀ hy₀_V₀ hy₀_not_h₀
    obtain ⟨V_sm, hy₀_Vsm, hSm_Vsm⟩ :=
      weil_localRing_flat_lfp_fiber_smoothOfRelDim_lift ↥V C g hFlatG hLFPG y₀ W_sm hy₀_W hSm_W
    rw [hy₀_fst] at hy₀_Vsm
    refine ⟨V_sm, ?_, hSm_Vsm⟩
    let S_open : Set (PrimeSpectrum ↑R₀) := hAff₀.fromSpec.base ⁻¹' (V_sm : Set C)
    have hOpen : IsOpen S_open := V_sm.2.preimage hAff₀.fromSpec.continuous
    obtain ⟨I_cl, hI_cl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal S_openᶜ).mp hOpen.isClosed_compl
    by_contra hx_nmem
    have hpx_compl : p_x ∈ S_openᶜ := by
      change hAff₀.fromSpec.base p_x ∉ (V_sm : Set C)
      rwa [hp_x_pt]
    rw [hI_cl] at hpx_compl
    have hI_le_px : (I_cl : Set ↑R₀) ⊆ (p_x.asIdeal : Set ↑R₀) := hpx_compl
    have hq₀_zero : q₀ ∈ PrimeSpectrum.zeroLocus (I_cl : Set ↑R₀) :=
      hI_le_px.trans hpx_le_q₀
    rw [← hI_cl] at hq₀_zero
    exact hq₀_zero hy₀_Vsm
  exact ⟨eZ, eY,
    fun r hr => ⟨(hFreeFin_h₀ r).1, (hFreeFin_h₀ r).2, hNt_h₀ r hr⟩,
    fun r hr => ⟨(hFreeFin_t₀ r).1, (hFreeFin_t₀ r).2, hNt_t₀ r hr⟩,
    hC3, he_sum, he_mul,
    hFree_eY, hFin_eY, hNt_eY,
    hFree_eZ, hFin_eZ, hNt_eZ,
    hC12, hC13, hC14, hC15, hC16⟩

theorem weil_sup1_hyperplane_henselian_divisor_split (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ) :
    ∃ (V₀ V₁ : C.Opens)
      (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
      (t₀ : ↑(C.presheaf.obj (Opposite.op V₁))),
      IsUnstableP1HenselianPencil V g n τ Z V₀ V₁ h₀ eZ eY t₀ :=
by
  let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
  have : AlgebraicGeometry.IsProper g := hSemi.1.2.2.1
  have : AlgebraicGeometry.LocallyOfFinitePresentation g := hSemi.1.2.2.2.1
  let sndY := CategoryTheory.Limits.pullback.snd g s₀
  have : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Spec (CommRingCat.of k₀)) :=
    AlgebraicGeometry.isNoetherian_Spec.mpr inferInstance
  have : AlgebraicGeometry.IsLocallyNoetherian (CategoryTheory.Limits.pullback g s₀) :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian sndY
  have : CompactSpace ↥(CategoryTheory.Limits.pullback g s₀) :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace sndY
  have : AlgebraicGeometry.IsNoetherian (CategoryTheory.Limits.pullback g s₀) := ⟨⟩
  have hFinY : (irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀)).Finite :=
    AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian
  obtain ⟨hFibAll, Y'_sch, ιY', hClY', hRedY', hRangeY', hSmY'⟩ :=
    weil_sup1_geom_fiber_reduced_sing_and_branch_smooth K m V hMaxNeBot hPkg
      C_K p_K n σ_K C g τ ι hSemi Z Z_sch ιZ hUnstab
  have : (IsLocalRing.maximalIdeal ↥V).IsPrime := inferInstance
  have : IsAlgClosed k₀ := hPkg.2.2.2.2.1 (IsLocalRing.maximalIdeal ↥V) hMaxNeBot
  obtain ⟨hRedY, hSingFin, hCompY⟩ := hFibAll k₀ s₀
  obtain ⟨V₀, V₁, h₀, t₀, u₁_V₁, u₁_V₀,
      hAff₀, hAff₁, hCov, hBas₀, hBas₁, hInv, hFin₀, hFin₁,
      hSec, hΔ_V₁, hSmY_inf, hKoszEq, hKoszΔ, hKoszInf, hKoszAff⟩ :=
    weil_sup1_vandermonde_gl_pencil_and_koszul_witness K m V hMaxNeBot hPkg
      C_K p_K n σ_K C g τ ι hSemi Z Z_sch ιZ hUnstab
      hFinY hRedY hSingFin hCompY Y'_sch ιY' hClY' hRangeY'
  obtain ⟨hAlgFree, hAlgHensel⟩ :=
    weil_sup1_valuation_flat_quotient_freeness_and_hensel_idempotent K m V hMaxNeBot hPkg
  obtain ⟨eZ, eY, hP9, hP10, hP11, hP12, hP13,
      hP14_free, hP14_fin, hP14_nt, hP15_free, hP15_fin, hP15_nt,
      hP18, hP19, hP22, hP23, hP24⟩ :=
    weil_sup1_pencil_pullback_splits_and_smooth_lift K m V hMaxNeBot hPkg
      C_K p_K n σ_K C g τ ι hSemi Z Z_sch ιZ hUnstab V₀ V₁ h₀ t₀
      hAff₀ hAff₁ hCov hBas₀ hBas₁ hInv hFin₀ hFin₁ hΔ_V₁ hSmY_inf
      (fun K' _ _ s => ⟨(hFibAll K' s).1, fun E hE => ((hFibAll K' s).2.2 E hE).2⟩)
      hAlgFree hAlgHensel
  exact ⟨V₀, V₁, h₀, eZ, eY, t₀,
    hAff₀, hAff₁, hCov, hBas₀, hBas₁, hInv, hFin₀, hFin₁,
    hP9, hP10, hP11, hP12, hP13,
    hP14_free, hP14_fin, hP14_nt, hP15_free, hP15_fin, hP15_nt,
    hSec, hΔ_V₁, hP18, hP19, hFinY, hRedY, hP22, hP23, hP24,
    ⟨Y'_sch, ιY', hClY', hRedY', hRangeY', hSmY',
      u₁_V₁, u₁_V₀, hKoszEq, hKoszΔ, hKoszInf, hKoszAff⟩⟩

theorem weil_sup1_proj_line_two_chart_cohomology (k₀ : Type u) [Field k₀]
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (p_Z : Z_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (isoP1 : Z_sch ≅ (weilProjectiveSpaceOver k₀ 1).left)
    (h_pZ : p_Z = isoP1.hom ≫ (weilProjectiveSpaceOver k₀ 1).hom)
    (U₀ U₁ : Z_sch.Opens)
    (hAff₀ : AlgebraicGeometry.IsAffineOpen U₀)
    (hAff₁ : AlgebraicGeometry.IsAffineOpen U₁)
    (hNe₀ : Nonempty ↥U₀)
    (hNe₁ : Nonempty ↥U₁)
    (hCov : U₀ ⊔ U₁ = ⊤) :
    let A₀ := Z_sch.presheaf.obj (Opposite.op U₀)
    let A₁ := Z_sch.presheaf.obj (Opposite.op U₁)
    let A₀₁ := Z_sch.presheaf.obj (Opposite.op (U₀ ⊓ U₁))
    let res₀ : ↑A₀ →+* ↑A₀₁ :=
      (Z_sch.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op).hom
    let res₁ : ↑A₁ →+* ↑A₀₁ :=
      (Z_sch.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op).hom
    let c₀ : k₀ →+* ↑A₀ :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE p_Z ⊤ U₀ le_top).hom
    let c₁ : k₀ →+* ↑A₁ :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE p_Z ⊤ U₁ le_top).hom
    (∀ (a₀ : ↑A₀) (a₁ : ↑A₁), res₀ a₀ = res₁ a₁ → ∃ c : k₀, a₀ = c₀ c ∧ a₁ = c₁ c) ∧
    (∀ z : ↑A₀₁, ∃ (a₀ : ↑A₀) (a₁ : ↑A₁), res₀ a₀ - res₁ a₁ = z) :=
by
  intro A₀ A₁ A₀₁ res₀ res₁ c₀ c₁
  
  let P : AlgebraicGeometry.Scheme.{u} := (weilProjectiveSpaceOver k₀ 1).left
  let p_P : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀) := (weilProjectiveSpaceOver k₀ 1).hom
  let W₀ : P.Opens := weilProjBasicOpen k₀ 1 0
  let W₁ : P.Opens := weilProjBasicOpen k₀ 1 1
  let B₀ : Type u := ↑(P.presheaf.obj (Opposite.op W₀))
  let B₁ : Type u := ↑(P.presheaf.obj (Opposite.op W₁))
  let B₀₁ : Type u := ↑(P.presheaf.obj (Opposite.op (W₀ ⊓ W₁)))
  let rW₀ : B₀ →+* B₀₁ :=
    (P.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀ ⊓ W₁ ≤ W₀)).op).hom
  let rW₁ : B₁ →+* B₀₁ :=
    (P.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀ ⊓ W₁ ≤ W₁)).op).hom
  have hProjCharts :
      ∃ (hAff : ∀ a : Fin 2, AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen k₀ 1 a))
        (c_R : ∀ a : Fin 2, k₀ →+* ↑(P.presheaf.obj (Opposite.op (weilProjBasicOpen k₀ 1 a))))
        (e₀ : Polynomial k₀ ≃+* B₀)
        (e₁ : Polynomial k₀ ≃+* B₁),
        W₀ ⊔ W₁ = ⊤ ∧
        (∀ (a : Fin 2) (c : k₀),
          c_R a c = ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE p_P ⊤ (weilProjBasicOpen k₀ 1 a) le_top).hom c) ∧
        (∀ c : k₀, e₀ (Polynomial.C c) = c_R 0 c) ∧
        (∀ c : k₀, e₁ (Polynomial.C c) = c_R 1 c) ∧
        W₀ ⊓ W₁ = P.basicOpen (e₀ Polynomial.X) ∧
        (∀ c : k₀, rW₀ (e₀ (Polynomial.C c)) = rW₁ (e₁ (Polynomial.C c))) ∧
        rW₀ (e₀ Polynomial.X) * rW₁ (e₁ Polynomial.X) = 1 := by
    classical
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let hX_mem : ∀ b : Fin 2, MvPolynomial.X b ∈ 𝒜 1 :=
      fun b => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k₀ b)
    let hAff : ∀ a : Fin 2, AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen k₀ 1 a) :=
      fun a => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X a) (hX_mem a) zero_lt_one
    let c_R : ∀ a : Fin 2,
        k₀ →+* ↑(P.presheaf.obj (Opposite.op (weilProjBasicOpen k₀ 1 a))) :=
      fun a =>
        (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a)).hom.comp
          ((HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap k₀ ↥(𝒜 0)))
    let t_R : ∀ a : Fin 2, Fin 2 →
        ↑(P.presheaf.obj (Opposite.op (weilProjBasicOpen k₀ 1 a))) :=
      fun a b =>
        (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a)).hom
          (HomogeneousLocalization.Away.mk 𝒜 (hX_mem a) 1 (MvPolynomial.X b) (hX_mem b))
    have halg0 : ∀ r : k₀, (algebraMap k₀ ↥(𝒜 0) r : MvPolynomial (Fin 2) k₀) = MvPolynomial.C r := by
      intro r
      rw [Algebra.algebraMap_eq_smul_one]
      change r • (1 : MvPolynomial (Fin 2) k₀) = MvPolynomial.C r
      rw [Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]
    have hIrrel : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) k₀)) := by
      intro p hp
      have hp0_proj : GradedRing.proj 𝒜 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      have hp_sum : (∑ i ∈ (DirectSum.decompose 𝒜 p).support,
          (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin 2) k₀)) = p :=
        DirectSum.sum_support_decompose 𝒜 p
      have hcoeff0 : p.coeff 0 = 0 := by
        rw [← hp_sum, MvPolynomial.coeff_sum]
        apply Finset.sum_eq_zero
        intro i _
        by_cases hi : i = 0
        · subst hi
          have h0 : (DirectSum.decompose 𝒜 p 0 : MvPolynomial (Fin 2) k₀) = 0 := hp0_proj
          rw [h0]
          simp
        · have hmem_i : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin 2) k₀) ∈ 𝒜 i :=
            (DirectSum.decompose 𝒜 p i).2
          have hhom_i : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin 2) k₀).IsHomogeneous i :=
            (MvPolynomial.mem_homogeneousSubmodule i _).mp hmem_i
          by_contra hne0
          have hdeg0 := hhom_i hne0
          simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at hdeg0
          exact hi hdeg0.symm
      have hrange : (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) k₀)) =
          MvPolynomial.X '' (Set.univ : Set (Fin 2)) := Set.image_univ.symm
      rw [hrange, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm_ne : m ≠ 0 := by
        intro hm0
        subst hm0
        exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
      have hex : ∃ a : Fin 2, m a ≠ 0 := by
        by_contra hall
        exact hm_ne (Finsupp.ext fun a => Classical.not_not.mp fun h => hall ⟨a, h⟩)
      rcases hex with ⟨a, ha⟩
      exact ⟨a, Set.mem_univ a, ha⟩
    have hiSupW : (⨆ a : Fin 2, weilProjBasicOpen k₀ 1 a) = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X hIrrel
    have hCovW : W₀ ⊔ W₁ = ⊤ := by
      rw [eq_top_iff]
      intro x _
      have hx : x ∈ ⨆ a : Fin 2, weilProjBasicOpen k₀ 1 a := by rw [hiSupW]; trivial
      obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      fin_cases a
      · exact Or.inl ha
      · exact Or.inr ha
    have hBridge : ∀ a : Fin 2,
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a)) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hX_mem a) zero_lt_one =
        (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜
          (MvPolynomial.X a) (hX_mem a) zero_lt_one).fromSpec := by
      intro a
      let f : MvPolynomial (Fin 2) k₀ := MvPolynomial.X a
      let hf : f ∈ 𝒜 1 := hX_mem a
      let U : (AlgebraicGeometry.Proj 𝒜).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 f
      let hU : AlgebraicGeometry.IsAffineOpen U :=
        AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 f hf zero_lt_one
      let B_f : CommRingCat.{u} := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)
      have hg_eq : U.toSpecΓ ≫ AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Proj.awayToSection 𝒜 f) =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).hom := by
        rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_hom]
        let g₁ : U.toScheme ⟶ AlgebraicGeometry.Spec B_f :=
          U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f)
        let g₂ : U.toScheme ⟶ AlgebraicGeometry.Spec B_f :=
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜 f
        change g₁ = g₂
        have happ : g₁.appTop = g₂.appTop := by
          dsimp only [g₁, g₂]
          rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
            AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop]
          change (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f)).appTop ≫
              ((AlgebraicGeometry.Scheme.ΓSpecIso _).hom ≫ U.topIso.inv) =
            (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜 f).app ⊤
          rw [AlgebraicGeometry.Proj.basicOpenToSpec_app_top]
          have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
            (AlgebraicGeometry.Proj.awayToSection 𝒜 f)
          rw [← Category.assoc, hnat, Category.assoc]
        let e_adj := AlgebraicGeometry.ΓSpec.adjunction.homEquiv U.toScheme (Opposite.op B_f)
        apply e_adj.symm.injective
        apply Quiver.Hom.unop_inj
        let φ₁ : B_f ⟶ U.toScheme.presheaf.obj (Opposite.op ⊤) := (e_adj.symm g₁).unop
        let φ₂ : B_f ⟶ U.toScheme.presheaf.obj (Opposite.op ⊤) := (e_adj.symm g₂).unop
        have h1 := AlgebraicGeometry.ΓSpecIso_inv_ΓSpec_adjunction_homEquiv φ₁
        have h2 := AlgebraicGeometry.ΓSpecIso_inv_ΓSpec_adjunction_homEquiv φ₂
        have hg₁ : (AlgebraicGeometry.ΓSpec.adjunction.homEquiv U.toScheme (Opposite.op B_f))
            φ₁.op = g₁ := e_adj.apply_symm_apply g₁
        have hg₂ : (AlgebraicGeometry.ΓSpec.adjunction.homEquiv U.toScheme (Opposite.op B_f))
            φ₂.op = g₂ := e_adj.apply_symm_apply g₂
        rw [hg₁] at h1
        rw [hg₂] at h2
        change φ₁ = φ₂
        rw [← h1, ← h2, happ]
      have hiso_hom : hU.isoSpec.hom = U.toSpecΓ := AlgebraicGeometry.IsAffineOpen.isoSpec_hom hU
      have hspec_eq : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f) =
          hU.isoSpec.inv ≫ (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).hom := by
        rw [← hiso_hom] at hg_eq
        rw [← hg_eq, Iso.inv_hom_id_assoc]
      rw [hspec_eq, ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 f hf zero_lt_one,
        Category.assoc, Iso.hom_inv_id_assoc, AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
    have hc_Spec : ∀ a : Fin 2,
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_R a)) =
          (hAff a).fromSpec ≫ p_P := by
      intro a
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a)).hom.comp
            ((HomogeneousLocalization.fromZeroRingHom 𝒜
              (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap k₀ ↥(𝒜 0))))) =
        (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜
          (MvPolynomial.X a) (hX_mem a) zero_lt_one).fromSpec ≫
          (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₀ ↥(𝒜 0))))
      have hc_hom : CommRingCat.ofHom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a)).hom.comp
            ((HomogeneousLocalization.fromZeroRingHom 𝒜
              (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap k₀ ↥(𝒜 0)))) =
          CommRingCat.ofHom (algebraMap k₀ ↥(𝒜 0)) ≫
            CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜
              (Submonoid.powers (MvPolynomial.X a))) ≫
            AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a) := by
        apply CommRingCat.hom_ext
        rfl
      rw [hc_hom, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜 (MvPolynomial.X a) (hX_mem a) zero_lt_one]
      simp only [← Category.assoc]
      rw [hBridge a, Category.assoc]
    have hc_eq : ∀ (a : Fin 2) (c : k₀),
        c_R a c = ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          AlgebraicGeometry.Scheme.Hom.appLE p_P ⊤ (weilProjBasicOpen k₀ 1 a) le_top).hom c := by
      intro a c
      let R₀ := CommRingCat.of k₀
      have hTop : AlgebraicGeometry.IsAffineOpen (⊤ : (AlgebraicGeometry.Spec R₀).Opens) :=
        AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec R₀)
      have hSpec_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_R a)) =
          AlgebraicGeometry.Spec.map
            ((AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv ≫
              AlgebraicGeometry.Scheme.Hom.appLE p_P ⊤ (weilProjBasicOpen k₀ 1 a) le_top) := by
        rw [hc_Spec a, ← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p_P hTop (hAff a) le_top,
          AlgebraicGeometry.IsAffineOpen.fromSpec_top, AlgebraicGeometry.Scheme.isoSpec_Spec_inv R₀,
          ← AlgebraicGeometry.Spec.map_comp]
      exact congrArg (fun f => f.hom c) (AlgebraicGeometry.Spec.map_injective hSpec_eq)
    have hDehomPoly : ∀ (a a' : Fin 2), a' ≠ a →
        ∃ e : Polynomial k₀ ≃+* ↑(P.presheaf.obj (Opposite.op (weilProjBasicOpen k₀ 1 a))),
          (∀ r : k₀, e (Polynomial.C r) = c_R a r) ∧
          e Polynomial.X = t_R a a' := by
      intro a a' hne
      let X_a : MvPolynomial (Fin 2) k₀ := MvPolynomial.X a
      let S_a : Submonoid (MvPolynomial (Fin 2) k₀) := Submonoid.powers X_a
      let ι_a : k₀ →+* HomogeneousLocalization.Away 𝒜 X_a :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 S_a).comp (algebraMap k₀ ↥(𝒜 0))
      let t_tilde : HomogeneousLocalization.Away 𝒜 X_a :=
        HomogeneousLocalization.Away.mk 𝒜 (hX_mem a) 1 (MvPolynomial.X a') (hX_mem a')
      let α : Polynomial k₀ →+* HomogeneousLocalization.Away 𝒜 X_a :=
        Polynomial.eval₂RingHom ι_a t_tilde
      let w : Fin 2 → Polynomial k₀ := fun j => if j = a then 1 else Polynomial.X
      let dehom : MvPolynomial (Fin 2) k₀ →+* Polynomial k₀ :=
        MvPolynomial.eval₂Hom Polynomial.C w
      have hdehom_Xa : dehom X_a = 1 := by simp [dehom, w, X_a]
      have hdehom_S : ∀ y : S_a, dehom y.1 = 1 := by
        rintro ⟨_, n, rfl⟩
        simp [map_pow, hdehom_Xa]
      have hy_unit : ∀ y : S_a, IsUnit (dehom y.1) := fun y => by
        rw [hdehom_S y]
        exact isUnit_one
      let β_loc : Localization S_a →+* Polynomial k₀ := IsLocalization.lift hy_unit
      have hβ_loc_mk : ∀ (p : MvPolynomial (Fin 2) k₀) (y : S_a),
          β_loc (Localization.mk p y) = dehom p := by
        intro p y
        rw [Localization.mk_eq_mk']
        dsimp only [β_loc]
        rw [IsLocalization.lift_mk'_spec, hdehom_S y, one_mul]
      let valHom : HomogeneousLocalization.Away 𝒜 X_a →+* Localization S_a :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := fun u v => HomogeneousLocalization.val_mul u v
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := fun u v => HomogeneousLocalization.val_add u v }
      let β : HomogeneousLocalization.Away 𝒜 X_a →+* Polynomial k₀ := β_loc.comp valHom
      have hval_ι : ∀ r : k₀, (ι_a r).val = Localization.mk (MvPolynomial.C r) 1 := by
        intro r
        change (HomogeneousLocalization.mk
          ⟨0, algebraMap k₀ ↥(𝒜 0) r, 1, Submonoid.one_mem S_a⟩).val =
          Localization.mk (MvPolynomial.C r) 1
        rw [HomogeneousLocalization.val_mk, halg0 r]
        rfl
      have hleft : Function.LeftInverse β α := by
        have hcomp : β.comp α = RingHom.id (Polynomial k₀) := by
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            simp [α, β, valHom, hval_ι, hβ_loc_mk, dehom]
          · simp [α, β, valHom, t_tilde, HomogeneousLocalization.Away.val_mk, hβ_loc_mk,
              dehom, w, hne]
        intro q
        exact RingHom.congr_fun hcomp q
      have hright : Function.RightInverse β α := by
        intro z
        let φ : MvPolynomial (Fin 2) k₀ →+* Localization S_a := valHom.comp (α.comp dehom)
        have hφ_C : ∀ r : k₀, φ (MvPolynomial.C r) = Localization.mk (MvPolynomial.C r) 1 := by
          intro r
          simp [φ, dehom, α, valHom, hval_ι]
        have hφ_X : ∀ j : Fin 2,
            φ (MvPolynomial.X j) =
              Localization.mk (MvPolynomial.X j) ⟨X_a, Submonoid.mem_powers X_a⟩ := by
          intro j
          by_cases hj : j = a
          · subst hj
            have h1 : φ X_a = 1 := by simp [φ, hdehom_Xa]
            rw [h1]
            exact (Localization.mk_self (⟨X_a, Submonoid.mem_powers X_a⟩ : S_a)).symm
          · have hja' : j = a' := by
              fin_cases a <;> fin_cases a' <;> fin_cases j <;> simp_all
            rw [hja']
            have h2 : φ (MvPolynomial.X a') = t_tilde.val := by
              simp [φ, dehom, w, hne, α, valHom]
            rw [h2, HomogeneousLocalization.Away.val_mk]
            congr 1
            apply Subtype.ext
            exact pow_one X_a
        have hφ_prod : ∀ (d : Fin 2 →₀ ℕ) (s : Finset (Fin 2)),
            φ (∏ j ∈ s, MvPolynomial.X j ^ d j) =
              Localization.mk (∏ j ∈ s, MvPolynomial.X j ^ d j)
                ⟨X_a ^ (∑ j ∈ s, d j), S_a.pow_mem (Submonoid.mem_powers X_a) (∑ j ∈ s, d j)⟩ := by
          intro d s
          induction s using Finset.induction_on with
          | empty => simp
          | @insert j s hj ih =>
            rw [Finset.prod_insert hj, Finset.sum_insert hj, map_mul, map_pow, hφ_X j, ih,
              Localization.mk_pow, Localization.mk_mul]
            congr 1
            apply Subtype.ext
            change X_a ^ d j * X_a ^ (∑ i ∈ s, d i) = X_a ^ (d j + ∑ i ∈ s, d i)
            rw [← pow_add]
        have hφ_monomial : ∀ (d : Fin 2 →₀ ℕ) (c : k₀),
            φ (MvPolynomial.monomial d c) =
              Localization.mk (MvPolynomial.monomial d c)
                ⟨X_a ^ (∑ j ∈ d.support, d j),
                  S_a.pow_mem (Submonoid.mem_powers X_a) (∑ j ∈ d.support, d j)⟩ := by
          intro d c
          rw [MvPolynomial.monomial_eq, Finsupp.prod, map_mul, hφ_C c, hφ_prod d d.support,
            Localization.mk_mul]
          congr 1
          apply Subtype.ext
          exact one_mul _
        have hφ_homog : ∀ (n : ℕ) (p : MvPolynomial (Fin 2) k₀),
            p.IsHomogeneous n →
            φ p = Localization.mk p ⟨X_a ^ n, S_a.pow_mem (Submonoid.mem_powers X_a) n⟩ := by
          intro n p hp
          let y_n : S_a := ⟨X_a ^ n, S_a.pow_mem (Submonoid.mem_powers X_a) n⟩
          have hsum_eq : ∀ s : Finset (Fin 2 →₀ ℕ),
              (∀ d ∈ s, (∑ j ∈ d.support, d j) = n) →
              φ (∑ d ∈ s, MvPolynomial.monomial d (p.coeff d)) =
                Localization.mk (∑ d ∈ s, MvPolynomial.monomial d (p.coeff d)) y_n := by
            intro s
            induction s using Finset.induction_on with
            | empty =>
              intro _
              simp [Localization.mk_zero]
            | @insert d s hd ih =>
              intro hs
              have hd_n : (∑ j ∈ d.support, d j) = n := hs d (Finset.mem_insert_self d s)
              have hs_n : ∀ d' ∈ s, (∑ j ∈ d'.support, d' j) = n :=
                fun d' hd' => hs d' (Finset.mem_insert_of_mem hd')
              rw [Finset.sum_insert hd, map_add, hφ_monomial d (p.coeff d), ih hs_n]
              have hy_eq : (⟨X_a ^ (∑ j ∈ d.support, d j),
                  S_a.pow_mem (Submonoid.mem_powers X_a) (∑ j ∈ d.support, d j)⟩ : S_a) = y_n := by
                apply Subtype.ext
                exact congrArg (X_a ^ ·) hd_n
              rw [hy_eq, Localization.add_mk_self]
          have hp_supp : ∀ d ∈ p.support, (∑ j ∈ d.support, d j) = n := by
            intro d hd
            have hdeg := hp (MvPolynomial.mem_support_iff.mp hd)
            simpa [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, mul_one] using hdeg
          conv_lhs => rw [MvPolynomial.as_sum p]
          conv_rhs => rw [MvPolynomial.as_sum p]
          exact hsum_eq p.support hp_supp
