      exact ⟨c, by rw [hc₀_e, he₀_C c, hc_eq 0 c], by rw [hc₁_e, he₁_C c, hc_eq 1 c]⟩
    · intro ξ
      obtain ⟨⟨b, ⟨_, N, rfl⟩⟩, hsurj⟩ :=
