        exact RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hc₂) θ
      let res_Ω : ↑(W.presheaf.obj (Opposite.op ⊤)) →+* ↑(W.presheaf.obj (Opposite.op (Ω a))) :=
