        (hTwoChartClear (B_β {a}) (u_v ^ N₀) hw₀_Bβ
          n₀ n₁ r₀ r₁ f α h γ hfα_β hhγ_β hsum_β hfc_β hhc_β).2 (e_win p) he_cl
      rw [← pow_mul] at hzeq
      rw [← hDβ0_eq {a} hSa] at hz₀
      rw [← hDβ1_eq {a} hSa] at hz₁
      exact ⟨N₀ * R, z₀, hz₀, z₁, hz₁, hzeq⟩
    have hBa_cl : B_β {a} = Subring.closure (Set.range ψ_β ∪ (Y_a a : Set F)) :=
      (hBβ_a a).2.2.1
    obtain ⟨G_Q, hGQ_mem, hGQ_span⟩ :=
      hShiftedCokernel ↥R_β ψ_β (Y_a a) (B_β {a}) hBa_cl (r_a a) c_β W_a hWa_mul
        ι_win e_win hAnn_win
    refine ⟨G_Q, ?_, ?_⟩
    · intro g hg
      obtain ⟨b, hb, p, rfl⟩ := hGQ_mem g hg
      have hb_D01 : b ∈ D_β01 {a} := by
        rw [hDβ01_eq0 {a}]
        exact Subring.subset_closure (Set.mem_union_left _ (hBβa_D0 hb))
      exact (D_β01 {a}).mul_mem hb_D01 (he_D01 p)
    · intro z hz
      obtain ⟨z₀', hz₀', z₁', hz₁', b_win, hb_win, hz_laur⟩ := hLaurent z hz
      let b_vec : ι_win → F := fun p => b_win p.1 (p.2 : ℕ)
      have hb_vec_mem : ∀ p : ι_win, b_vec p ∈ B_β {a} := fun p => hb_win p.1 p.2.1 p.2.2
      obtain ⟨w_rem, ⟨z₀'', hz₀'', z₁'', hz₁'', rfl⟩, coeff_GQ, hspan_eq⟩ :=
        hGQ_span b_vec hb_vec_mem
      have hwin_eq :
          (∑ μ : Fin d₀, ∑ q ∈ Finset.Ico 1 M_pole, b_win μ q * (s₁ ^ q * gen₀ μ)) =
            ∑ p : ι_win, b_vec p * e_win p := by
        dsimp [ι_win, b_vec, e_win]
        rw [Fintype.sum_prod_type]
        refine Finset.sum_congr rfl fun μ _ => ?_
        exact (Finset.sum_coe_sort (Finset.Ico 1 M_pole)
          (fun q => b_win μ q * (s₁ ^ q * gen₀ μ))).symm
      refine ⟨z₀' + z₀'', (D_β0 {a}).add_mem hz₀' hz₀'',
        z₁' + z₁'', (D_β1 {a}).add_mem hz₁' hz₁'', coeff_GQ, ?_⟩
      rw [hz_laur, hwin_eq, hspan_eq]
      dsimp [ψ_β]
      ring
  · 
    have hPOU_ext : ∀ (R_ε : Subring F) (s_p : ℕ) (a_idx : Fin s_p → Fin (N + 1))
        (f_p α_p : Fin s_p → F) (N_p : Fin s_p → ℕ),
        (∀ r : ↥R_β, ψ_β r ∈ R_ε) →
        (∀ j : Fin s_p, f_p j ∈ R_ε ∧ α_p j ∈ R_ε ∧
          ∀ y ∈ Y_a (a_idx j), (f_p j) ^ (N_p j) * y ∈ R_ε) →
        (∑ j : Fin s_p, α_p j * f_p j) = 1 →
        let D_ε : Finset (Fin (N + 1)) → Subring F :=
          fun S => Subring.closure ((B_β S : Set F) ∪ (R_ε : Set F))
        ∃ (s : ℕ) (a_i : Fin s → Fin (N + 1)) (f α : Fin s → F),
          (∀ j : Fin s, f j ∈ R_ε ∧ α j ∈ R_ε) ∧
          (∑ j : Fin s, α j * f j) = 1 ∧
          (∀ (j : Fin s), ∀ w ∈ D_ε {a_i j}, ∃ r : ℕ, (f j) ^ r * w ∈ R_ε) ∧
          (∀ (j : Fin s) (S : Finset (Fin (N + 1))), S.Nonempty →
            ∀ w ∈ D_ε (insert (a_i j) S), ∃ r : ℕ, (f j) ^ r * w ∈ D_ε S) := by
      intro R_ε s_p a_idx f_p α_p N_p hC_Rε hp_Rε hsum_Rε D_ε
      refine ⟨s_p, a_idx, f_p, α_p, fun j => ⟨(hp_Rε j).1, (hp_Rε j).2.1⟩, hsum_Rε, ?_, ?_⟩
      · intro j w hw
        have hD_le : D_ε {a_idx j} ≤ Subring.closure ((R_ε : Set F) ∪ (Y_a (a_idx j) : Set F)) := by
          rw [Subring.closure_le]
          rintro z (hz | hz)
          · revert z
            change B_β {a_idx j} ≤ Subring.closure ((R_ε : Set F) ∪ (Y_a (a_idx j) : Set F))
            rw [(hBβ_a (a_idx j)).2.2.1, Subring.closure_le]
            rintro z (⟨r, rfl⟩ | hzY)
            · exact Subring.subset_closure (Set.mem_union_left _ (hC_Rε r))
            · exact Subring.subset_closure (Set.mem_union_right _ hzY)
          · exact Subring.subset_closure (Set.mem_union_left _ hz)
        obtain ⟨m, hm⟩ := hPowClear R_ε (Y_a (a_idx j) : Set F) ((f_p j) ^ (N_p j))
          (R_ε.pow_mem (hp_Rε j).1 (N_p j))
          (fun y hy => (hp_Rε j).2.2 y hy) w (hD_le hw)
        rw [← pow_mul] at hm
        exact ⟨N_p j * m, hm⟩
      · intro j S hS w hw
        have hR_DS : R_ε ≤ D_ε S := fun z hz => Subring.subset_closure (Set.mem_union_right _ hz)
        have hD_ins_le : D_ε (insert (a_idx j) S) ≤
            Subring.closure ((D_ε S : Set F) ∪ (Y_a (a_idx j) : Set F)) := by
          rw [Subring.closure_le]
          rintro z (hz | hz)
          · revert z
            change B_β (insert (a_idx j) S) ≤
              Subring.closure ((D_ε S : Set F) ∪ (Y_a (a_idx j) : Set F))
            rw [(hBβ_S (insert (a_idx j) S) (Finset.insert_nonempty _ S)).2.2.2, Subring.closure_le]
            intro z hz
            rcases Set.mem_iUnion₂.mp hz with ⟨b, hb_ins, hzb⟩
            rcases Finset.mem_insert.mp hb_ins with rfl | hbS
            · clear hz
              revert z hzb
              change B_β {a_idx j} ≤ Subring.closure ((D_ε S : Set F) ∪ (Y_a (a_idx j) : Set F))
              rw [(hBβ_a (a_idx j)).2.2.1, Subring.closure_le]
              rintro z (⟨r, rfl⟩ | hzY)
              · exact Subring.subset_closure (Set.mem_union_left _ (hR_DS (hC_Rε r)))
              · exact Subring.subset_closure (Set.mem_union_right _ hzY)
            · have hb_le : B_β {b} ≤ B_β S :=
                hBβ_mono {b} S (Finset.singleton_nonempty b) (Finset.singleton_subset_iff.mpr hbS)
              exact Subring.subset_closure
                (Set.mem_union_left _ (Subring.subset_closure (Set.mem_union_left _ (hb_le hzb))))
          · exact Subring.subset_closure (Set.mem_union_left _ (hR_DS hz))
        obtain ⟨m, hm⟩ := hPowClear (D_ε S) (Y_a (a_idx j) : Set F) ((f_p j) ^ (N_p j))
          ((D_ε S).pow_mem (hR_DS (hp_Rε j).1) (N_p j))
          (fun y hy => hR_DS ((hp_Rε j).2.2 y hy)) w (hD_ins_le hw)
        rw [← pow_mul] at hm
        exact ⟨N_p j * m, hm⟩
    intro R_ε D_ε hcases
    rcases hcases with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact hPOU_ext R_β0 s_p0 a_idx0 f_p0 α_p0 N_p0 hCβ_Rβ0 hp0_β hsum_p0
    · exact hPOU_ext R_β1 s_p1 a_idx1 f_p1 α_p1 N_p1 hCβ_Rβ1 hp1_β hsum_p1
    · exact hPOU_ext R_β01 s_p01 a_idx01 f_p01 α_p01 N_p01
        (fun r => Subring.subset_closure (Set.mem_union_left _ (hCβ_Rβ0 r))) hp01_β hsum_p01

theorem weil_strictlySemistable_good_cover_and_noetherian_doubleComplex (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS : IsStrictlySemistableCurveOverValuation V g_semi)
    (hProp : AlgebraicGeometry.IsProper g_semi)
    (r_pts : ℕ)
    (γ_div : Fin (r_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
    (W_div : Fin (r_pts + 1) → C_semi.Opens)
    (t_div : ∀ i : Fin (r_pts + 1), ↑(C_semi.presheaf.obj (Opposite.op (W_div i))))
    (hLift : IsLiftedSmoothDivisorSystem V g_semi r_pts γ_div W_div t_div)
    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (η_semi : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_semi)
    (C_tilde : AlgebraicGeometry.Scheme.{u})
    (g_tilde : C_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (q : C_tilde ⟶ C_semi)
    (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_tilde)
    (U_dom : C_semi.Opens)
    (b : ℕ) (K_bad : Fin b → Set ↥C_semi) (y_bad : Fin b → ↥C_semi)
    (V_tilde₀ V_tilde₁ : C_tilde.Opens)
    (T₀ : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀)))
    (S₁ : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₁)))
    (hDom : IsSegreTwoChartCurveDomination V g_semi F φ_VF η_semi C_tilde g_tilde q η_tilde
      U_dom b K_bad y_bad V_tilde₀ V_tilde₁ T₀ S₁) :
    ∃ (N : ℕ) (W : Fin (N + 1) → C_semi.Opens)
      (tag : Fin (N + 1) → Option (Fin (r_pts + 1)))
      (B : Finset (Fin (N + 1)) → Subring F)
      (t_loc : Fin (N + 1) → F)
      (φ_cov : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
        ↑(C_semi.presheaf.obj (Opposite.op (Finset.inf S W))) ≃+* ↥(B S)),
      IsDivisorAdaptedSubringCover V g_semi r_pts γ_div W_div t_div F φ_VF N W tag B t_loc φ_cov ∧
      ∀ (k : ℕ) (S_F : Finset F), HasNoetherianDoubleComplexModelAt V F φ_VF N B t_loc k S_F :=
by
  have hSep : AlgebraicGeometry.IsSeparated g_semi := hSS.2.2.1
  have ⟨hInjVF, hη_comm, _hηq, _hIntCt, _hPropGt, _hLfpGt, _hPropQ, _hqg,
    _hqBij, hAffEmb, _hAffEmbCt, _hIsoUdom, hUdom_compl, hKbad_cl, hKbad_disj,
    hKbad_sec, _hRestDom⟩ := hDom
  obtain ⟨N, W, tag, B, t_loc, φ_cov, r_a, P_a, ρ_a, hCov, hDisj, hFromSpec, hEtCov, hBadUdom⟩ :=
    weil_strictlySemistable_divisorAdapted_etale_cover_and_badLocus K V C_semi g_semi hSS hProp
      r_pts γ_div W_div t_div hLift F φ_VF hInjVF η_semi hη_comm hAffEmb
      U_dom b K_bad y_bad hUdom_compl hKbad_cl hKbad_disj hKbad_sec
  have ⟨_hInjVF', hSupW, hCov_aff, hCov_mono, ht_mem, ht_ratio, _hCov_tag, _hCov_div⟩ := hCov
  have hCovAff : ∀ (S : Finset (Fin (N + 1))) (hS : S.Nonempty),
      Nonempty ↥(Finset.inf S W) ∧
      ∃ hAff : AlgebraicGeometry.IsAffineOpen (Finset.inf S W),
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((B S).subtype.comp (φ_cov S hS).toRingHom)) ≫
          hAff.fromSpec = η_semi :=
    fun S hS => ⟨(hCov_aff S hS).2.1, hFromSpec S hS⟩
  obtain ⟨R_t0, R_t1, t₀, s₁, d₀, gen₀, d₁, gen₁, hPencil, hR01_eq, hInter, hClear, hPOU⟩ :=
    weil_segre_domination_twoChart_subring_bridge K V C_semi g_semi hSep F φ_VF η_semi
      C_tilde g_tilde q η_tilde U_dom b K_bad y_bad V_tilde₀ V_tilde₁ T₀ S₁ hDom
      N W B φ_cov hSupW hCovAff
  obtain ⟨g_a, Y_a, c_aj, hBase, hFactory⟩ :=
    weil_noetherian_localSubring_etale_cover_descent_and_monic_flatness K V F φ_VF
      N B r_a P_a ρ_a hEtCov
  have hB_mono : ∀ (S S' : Finset (Fin (N + 1))), S.Nonempty → S ⊆ S' → B S ≤ B S' :=
    fun S S' hS hsub => (hCov_mono S S' hS (hS.mono hsub) hsub).1
  have hClear_ov : ∀ S : Finset (Fin (N + 1)), 2 ≤ S.card →
      ∃ (n₀ n₁ r₀ r₁ : ℕ) (f α : Fin r₀ → F) (h γ : Fin r₁ → F),
        (∀ i, f i ∈ B S ∧ α i ∈ B S) ∧
        (∀ j, h j ∈ B S ∧ γ j ∈ B S) ∧
        (∑ i, α i * f i) + (∑ j, γ j * h j) = 1 ∧
        (∀ i, (f i) ^ n₀ * t₀ ∈ B S ∧ ∀ μ, (f i) ^ n₀ * gen₀ μ ∈ B S) ∧
        (∀ j, (h j) ^ n₁ * s₁ ∈ B S ∧ ∀ ν, (h j) ^ n₁ * gen₁ ν ∈ B S) := by
    intro S hcard
    obtain ⟨a, a', ha, ha', hne⟩ := Finset.one_lt_card_iff.mp hcard
    have hS : S.Nonempty := ⟨a, ha⟩
    have hbasic :
        C_semi.basicOpen (1 : ↑(C_semi.presheaf.obj (Opposite.op (Finset.inf S W)))) ≤ U_dom := by
      rw [AlgebraicGeometry.Scheme.basicOpen_one]
      exact le_trans (le_inf (Finset.inf_le ha) (Finset.inf_le ha')) (hDisj a a' hne)
    obtain ⟨N₀, n₀, n₁, r₀, r₁, f, α, h, γ, hfα, hhγ, hsum, hf_mem, hh_mem⟩ :=
      hClear S hS 1 hbasic
    have hu1 : (((φ_cov S hS) 1 : ↥(B S)) : F) = 1 := by
      rw [map_one]
      rfl
    refine ⟨n₀, n₁, r₀, r₁, f, α, h, γ, hfα, hhγ, ?_, ?_, ?_⟩
    · rw [hsum, hu1, one_pow]
    · intro i
      have hfi := hf_mem i
      rwa [hu1, one_pow, mul_one] at hfi
    · intro j
      have hhj := hh_mem j
      rwa [hu1, one_pow, mul_one] at hhj
  have hρ_V : ∀ (a : Fin (N + 1)) (j : Fin (r_a a)) (v : ↥V) (hv : φ_VF v ∈ B {a}),
      ρ_a a j ⟨φ_VF v, hv⟩ = Ideal.Quotient.mk (P_a a j) v :=
    fun a => (hEtCov.2.2 a).2
  have hClear_bad : ∀ (a : Fin (N + 1)) (u : ↥(B {a})),
      (∀ j : Fin (r_a a), ρ_a a j u = 0) →
      ∃ (N₀ n₀ n₁ r₀ r₁ : ℕ) (f α : Fin r₀ → F) (h γ : Fin r₁ → F),
        (∀ i, f i ∈ B {a} ∧ α i ∈ B {a}) ∧
        (∀ j, h j ∈ B {a} ∧ γ j ∈ B {a}) ∧
        (∑ i, α i * f i) + (∑ j, γ j * h j) = (u : F) ^ N₀ ∧
        (∀ i, (f i) ^ n₀ * (u : F) ^ N₀ * t₀ ∈ B {a} ∧
          ∀ μ, (f i) ^ n₀ * (u : F) ^ N₀ * gen₀ μ ∈ B {a}) ∧
        (∀ j, (h j) ^ n₁ * (u : F) ^ N₀ * s₁ ∈ B {a} ∧
          ∀ ν, (h j) ^ n₁ * (u : F) ^ N₀ * gen₁ ν ∈ B {a}) := by
    intro a u hu
    let hSa : ({a} : Finset (Fin (N + 1))).Nonempty := Finset.singleton_nonempty a
    have hbasic := hBadUdom a u hu
    have hcl := hClear {a} hSa ((φ_cov {a} hSa).symm u) hbasic
    dsimp only at hcl
    rw [RingEquiv.apply_symm_apply] at hcl
    exact hcl
  obtain ⟨S_V_tc, S_F_tc, hTwoChart⟩ :=
    weil_subring_twoChart_descent_intersection_and_cokernel_fg K V F φ_VF
      N B hB_mono R_t0 R_t1 t₀ s₁ d₀ gen₀ d₁ gen₁ hPencil hR01_eq hInter
      hClear_ov r_a P_a ρ_a hρ_V hClear_bad hPOU g_a Y_a c_aj hBase
  refine ⟨N, W, tag, B, t_loc, φ_cov, hCov, ?_⟩
  intro k S_F
  classical
  let S_F_tloc : Finset F :=
    Finset.univ.biUnion (fun a : Fin (N + 1) =>
      Finset.univ.image (fun b : Fin (N + 1) => t_loc a / t_loc b))
  let S_F_all : Finset F := S_F ∪ S_F_tc ∪ S_F_tloc
  obtain ⟨R_β, B_β, hNoeth, hLocRing, hLocHom, hSV_mem, hBβ_mono, hBβ_S, hBβ_a⟩ :=
    hFactory S_V_tc S_F_all
  have hBβ_for_tc : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
      (∀ z ∈ S_F_tc, z ∈ B S → z ∈ B_β S) ∧
      B_β S ≤ B S ∧
      (∀ r : ↥R_β, φ_VF (R_β.subtype r) ∈ B_β S) ∧
      B_β S = Subring.closure (⋃ a ∈ S, (B_β {a} : Set F)) := by
    intro S hS
    obtain ⟨hz_all, hclos, hR, _hV, hle, _hFlatBij⟩ := hBβ_S S hS
    exact ⟨fun z hz hB => hz_all z (Finset.mem_union_left _ (Finset.mem_union_right _ hz)) hB,
      hle, hR, hclos⟩
  obtain ⟨R_β0, R_β1, R_β01, D_β0, D_β1, D_β01,
      ht₀_β, hs₁_β, hR_mem, hgen₀_β, hspan₀_β, hR01_β,
      hD_mono, hD_S, hSplit_ov, hCok_Q, hPOU_β⟩ :=
    hTwoChart R_β B_β hSV_mem hBβ_mono hBβ_for_tc hBβ_a
  have ht_ratio_β : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
      ∀ a ∈ S, ∀ b ∈ S, t_loc a / t_loc b ∈ B_β S := by
    intro S hS a ha b hb
    have hmem_tloc : t_loc a / t_loc b ∈ S_F_tloc :=
      Finset.mem_biUnion.mpr ⟨a, Finset.mem_univ a,
        Finset.mem_image.mpr ⟨b, Finset.mem_univ b, rfl⟩⟩
    exact (hBβ_S S hS).1 (t_loc a / t_loc b) (Finset.mem_union_right _ hmem_tloc)
      (ht_ratio S hS a ha b hb)
  have hD_struct : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
      R_β0 ≤ D_β0 S ∧ R_β1 ≤ D_β1 S ∧ R_β01 ≤ D_β01 S ∧
      D_β0 S ≤ D_β01 S ∧ D_β1 S ≤ D_β01 S ∧
      D_β01 S = Subring.closure ((D_β0 S : Set F) ∪ {s₁}) ∧
      D_β01 S = Subring.closure ((D_β1 S : Set F) ∪ {t₀}) ∧
      (∀ a ∈ S, ∀ b ∈ S, t_loc a / t_loc b ∈ D_β0 S ∧ t_loc a / t_loc b ∈ D_β1 S) := by
    intro S hS
    obtain ⟨hB0, hB1, hR0, hR1, hR01', hD0_01, hD1_01, _hInf, hCl0, hCl1⟩ := hD_S S hS
    refine ⟨hR0, hR1, hR01', hD0_01, hD1_01, hCl0, hCl1, fun a ha b hb => ?_⟩
    have htr := ht_ratio_β S hS a ha b hb
    exact ⟨hB0 htr, hB1 htr⟩
  obtain ⟨hGM, hCech⟩ :=
    weil_subring_partitionOfUnity_cech_acyclicity_and_dualBasis_span K V F φ_VF
      N t_loc k R_β t₀ s₁ d₀ gen₀ R_β0 R_β1 R_β01 D_β0 D_β1 D_β01
      (fun a => (ht_mem a).2) hPencil.2.2.1 ht₀_β hs₁_β hR_mem hgen₀_β hspan₀_β hR01_β
      hD_mono hD_struct hPOU_β
  refine ⟨R_β, B_β, D_β0, D_β1, D_β01, hNoeth, hLocRing, hLocHom, ?_, ?_, hSplit_ov, hCok_Q, hGM, hCech⟩
  · intro S hS
    obtain ⟨hz_all, _hclos, hR, hV, hle, hFlatBij⟩ := hBβ_S S hS
    obtain ⟨hB0, hB1, _hR0, _hR1, _hR01', hD0_01, hD1_01, hInf, _hCl0, _hCl1⟩ := hD_S S hS
    exact ⟨fun z hz hB => hz_all z (Finset.mem_union_left _ (Finset.mem_union_left _ hz)) hB,
      hR, hV, hle, hB0, hB1, hD0_01, hD1_01, hInf, ht_ratio_β S hS, hFlatBij⟩
  · intro S S' hS hsub
    obtain ⟨hD0, hD1, hD01⟩ := hD_mono S S' hS hsub
    exact ⟨hBβ_mono S S' hS hsub, hD0, hD1, hD01⟩

theorem weil_closed_fiber_pullback_affine_bezout_and_divisor_reduction (K : Type u) [Field K]
    (V : ValuationSubring K)
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSep : AlgebraicGeometry.IsSeparated g_semi)
    (r_pts : ℕ)
    (σ_bar : Fin (r_pts + 1) →
      (AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.maximalIdeal ↥V).ResidueField) ⟶
        CategoryTheory.Limits.pullback g_semi
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
