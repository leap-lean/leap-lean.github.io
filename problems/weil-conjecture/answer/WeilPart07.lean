        have hemb_mem : ∀ w : PrimeSpectrum D, emb w ∈ E_P := by
          intro w
          have hle : q₀ ≤ PrimeSpectrum.comap (Ideal.Quotient.mk q₀.asIdeal) w := by
            intro x hx
            change Ideal.Quotient.mk q₀.asIdeal x ∈ w.asIdeal
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx]
            exact w.asIdeal.zero_mem
          have hSpec : q₀ ⤳ PrimeSpectrum.comap (Ideal.Quotient.mk q₀.asIdeal) w :=
