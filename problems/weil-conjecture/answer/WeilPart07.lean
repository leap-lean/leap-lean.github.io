        (fun b : Fin r => MvPolynomial.rename ι_Y (P₁.relation b))
        (fun d : Fin N => MvPolynomial.X (ι_X d) - MvPolynomial.rename ι_Y (G_bar d))
    let I_bar : Ideal (MvPolynomial (Fin (r + N + 1)) k_bar) := Ideal.span (Set.range Q_bar)
    have hpi_bar_Y : pi_bar_alg.comp (MvPolynomial.rename ι_Y) = MvPolynomial.aeval P₁.val := by
      apply MvPolynomial.algHom_ext
      intro k
      change (MvPolynomial.aeval (q_m ∘ z_gen)) (MvPolynomial.rename ι_Y (MvPolynomial.X k)) =
        (MvPolynomial.aeval P₁.val) (MvPolynomial.X k)
      rw [MvPolynomial.rename_X, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      change q_m ((z_gen ∘ ι_Y) k) = P₁.val k
      rw [hz_Y]
      exact hy_gen k
    have hpi_bar_Q_bar : ∀ j : Fin (r + N), pi_bar_alg (Q_bar j) = 0 := by
      intro j
      refine Fin.addCases ?_ ?_ j
      · intro b
        dsimp only [Q_bar]
        rw [Fin.addCases_left]
        have h1 := AlgHom.congr_fun hpi_bar_Y (P₁.relation b)
        dsimp at h1
        rw [h1]
        exact P₁.relation_mem_ker b
      · intro d
        dsimp only [Q_bar]
        rw [Fin.addCases_right, map_sub]
        have h1 : pi_bar_alg (MvPolynomial.X (ι_X d)) = q_m (x_gen d) := by
