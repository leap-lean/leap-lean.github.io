    have hι_inj : Function.Injective ι_P := Ideal.injective_algebraMap_quotient_residueField P_id
    let S_P : Subring P_id.ResidueField := ι_P.range
    have h_tot : ∀ z : P_id.ResidueField, z ∈ S_P ∨ z⁻¹ ∈ S_P := by
      intro z
      obtain ⟨a_bar, b_bar, hb_nzd, hz_eq⟩ := IsFractionRing.div_surjective (A := ↥V ⧸ P_id) z
      have hb_bar_ne : b_bar ≠ 0 := nonZeroDivisors.ne_zero hb_nzd
      have hι_b_ne : ι_P b_bar ≠ 0 := fun h => hb_bar_ne (hι_inj (h.trans (map_zero ι_P).symm))
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a_bar
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b_bar
      have hb_ne : b ≠ 0 := fun h => hb_bar_ne (by rw [h, map_zero])
      have hbK_ne : (b : K) ≠ 0 := fun h => hb_ne (Subtype.ext h)
      by_cases haP : a ∈ P_id
      · left
        have ha0 : (Ideal.Quotient.mk P_id a) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr haP
        rw [← hz_eq, ha0, map_zero, zero_div]
        exact S_P.zero_mem
      · have ha_bar_ne : Ideal.Quotient.mk P_id a ≠ 0 :=
          fun h => haP (Ideal.Quotient.eq_zero_iff_mem.mp h)
        have hι_a_ne : ι_P (Ideal.Quotient.mk P_id a) ≠ 0 :=
          fun h => ha_bar_ne (hι_inj (h.trans (map_zero ι_P).symm))
        have ha_ne : a ≠ 0 := fun h => haP (h ▸ P_id.zero_mem)
        have haK_ne : (a : K) ≠ 0 := fun h => ha_ne (Subtype.ext h)
