              Polynomial.X ^ r₀ * Polynomial.X ^ (r - r₀) := by
            rw [← pow_add, ← hr_split]
          have h_cancel : ((Polynomial.X : Polynomial k₀) - 1) ^ r₁ =
              Polynomial.X ^ (r - r₀) * (Polynomial.X - 1) ^ r := by
            apply mul_left_cancel₀ (pow_ne_zero r₀ (Polynomial.X_ne_zero : (Polynomial.X : Polynomial k₀) ≠ 0))
            rw [hPow_eq, hXr, mul_assoc]
          have h_eval := congrArg (Polynomial.eval (0 : k₀)) h_cancel
          simp only [Polynomial.eval_pow, Polynomial.eval_sub, Polynomial.eval_X,
            Polynomial.eval_one, Polynomial.eval_mul, zero_sub,
            zero_pow (by omega : r - r₀ ≠ 0), zero_mul] at h_eval
          exact (IsUnit.pow r₁ isUnit_one.neg).ne_zero h_eval
        · exact heq
        · exfalso
          have hr₀_split : r₀ = r + (r₀ - r) := (Nat.add_sub_of_le (le_of_lt hgt)).symm
          have hXr₀ : (Polynomial.X : Polynomial k₀) ^ r₀ =
              Polynomial.X ^ r * Polynomial.X ^ (r₀ - r) := by
            rw [← pow_add, ← hr₀_split]
          have h_cancel :
              (Polynomial.X : Polynomial k₀) ^ (r₀ - r) * (Polynomial.X - 1) ^ r₁ =
              (Polynomial.X - 1) ^ r := by
            apply mul_left_cancel₀ (pow_ne_zero r (Polynomial.X_ne_zero : (Polynomial.X : Polynomial k₀) ≠ 0))
            rw [← mul_assoc, ← hXr₀, hPow_eq]
          have h_eval := congrArg (Polynomial.eval (0 : k₀)) h_cancel
          simp only [Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_sub,
            Polynomial.eval_X, Polynomial.eval_one, zero_sub,
            zero_pow (by omega : r₀ - r ≠ 0), zero_mul] at h_eval
