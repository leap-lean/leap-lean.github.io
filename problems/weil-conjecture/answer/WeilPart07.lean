        intro s
        have hm : C.presheaf.map (CategoryTheory.homOfLE (le_sup_right : U₁ ≤ W_compl)).op ≫
            fstY.appLE U₁ U_ZY le_rfl =
            fstY.appLE W_compl W_Y le_rfl ≫ Y.presheaf.map (CategoryTheory.homOfLE hle_UZY_W).op := by
