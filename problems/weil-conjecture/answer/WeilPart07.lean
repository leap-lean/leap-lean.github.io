            change z * ψ_a (u_a ^ (k + n)) = ψ_a w_a
            have hψu : ψ_a (u_a ^ (k + n)) =
                algebraMap ↥(B_R S) (Mₛ r) (r.1 ^ k) * algebraMap ↥(B_R S) (Mₛ r) (r.1 ^ n) := by
              change algebraMap ↥(B_R S) (Mₛ r) (Subring.inclusion hle_a_S (u_a ^ (k + n))) = _
              rw [map_pow, hu_eq, pow_add, map_mul]
            have hψw : ψ_a w_a = algebraMap ↥(B_R S) (Mₛ r) w * algebraMap ↥(B_R S) (Mₛ r) (r.1 ^ n) := by
