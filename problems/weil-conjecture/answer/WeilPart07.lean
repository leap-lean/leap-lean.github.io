            Finset.sum_congr rfl fun j _ => mul_assoc _ _ _
    rw [hswap]
    calc
      (∑ j : Fin s,
          (Y.presheaf.map (CategoryTheory.homOfLE (hS_aff _ (hI_ne I)).1).op).hom (c j) *
