        · left
          let u : ↥V := ⟨(a : K) / (b : K), hmem⟩
          have hub : u * b = a := Subtype.ext (div_mul_cancel₀ (a : K) hbK_ne)
          have h_eq : ι_P (Ideal.Quotient.mk P_id u) * ι_P (Ideal.Quotient.mk P_id b) =
              ι_P (Ideal.Quotient.mk P_id a) := by
            rw [← map_mul, ← map_mul, hub]
          have hz_u : z = ι_P (Ideal.Quotient.mk P_id u) := by
            rw [← hz_eq, ← h_eq, mul_div_cancel_right₀ _ hι_b_ne]
          rw [hz_u]
          exact ⟨Ideal.Quotient.mk P_id u, rfl⟩
        · right
          let w : ↥V := ⟨((a : K) / (b : K))⁻¹, hinv⟩
          have hwa : w * a = b := Subtype.ext (by
            change ((a : K) / (b : K))⁻¹ * (a : K) = (b : K)
            rw [inv_div, div_mul_cancel₀ (b : K) haK_ne])
          have h_eq : ι_P (Ideal.Quotient.mk P_id w) * ι_P (Ideal.Quotient.mk P_id a) =
              ι_P (Ideal.Quotient.mk P_id b) := by
            rw [← map_mul, ← map_mul, hwa]
          have hinv_w : z⁻¹ = ι_P (Ideal.Quotient.mk P_id w) := by
            rw [← hz_eq, inv_div, ← h_eq, mul_div_cancel_right₀ _ hι_a_ne]
          rw [hinv_w]
