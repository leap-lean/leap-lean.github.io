        rw [Fin.sum_univ_succAbove _ p₀] at hcoc
        convert hcoc using 2
        · rw [map_zsmul, hY_map_comp]
          congr 1
          have hJI : (⟨J.1 ∘ p₀.succAbove, J.2.comp (Fin.strictMono_succAbove p₀)⟩ :
