  have poly_etale_incidence_abstract :
      ∀ (R₀ : Type u) [CommRing R₀]
        (P_id : Ideal R₀) [P_id.IsPrime]
        (_ : IsIntegrallyClosed (R₀ ⧸ P_id))
        (D : Type u) [CommRing D] (φ : Polynomial R₀ →+* D),
        φ.Etale →
        ∀ (p q m_x : Ideal D) [p.IsPrime] [q.IsPrime] [m_x.IsPrime],
          p ∈ (Ideal.map (φ.comp Polynomial.C) P_id).minimalPrimes →
          Ideal.map (φ.comp Polynomial.C) P_id ≤ q →
          p ≤ m_x → q ≤ m_x → p ≤ q := by
    clear * - hEtDom etale_quotient_of_surjective
    intro R₀ _ P_id _ hIC_RP D _ φ hφ p q m_x _ _ _ hp_min hq_ge hpm hqm
