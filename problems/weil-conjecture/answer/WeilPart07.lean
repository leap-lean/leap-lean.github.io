        fun a => W.basicOpen (g₁.appTop.hom (ψ₁ (MvPolynomial.X a)))
      have hpre₁ : ∀ a : Fin (N' + 1), (TopologicalSpace.Opens.map Φ₁.base).obj (D a) = Ω a := by
        intro a
        change (TopologicalSpace.Opens.map g₁.base).obj
          ((TopologicalSpace.Opens.map φ₁.base).obj (D a)) = Ω a
        rw [AlgebraicGeometry.Proj.fromOfGlobalSections_preimage_basicOpen 𝒜_V ψ₁ hψ₁ zero_lt_one (hX_mem a),
          AlgebraicGeometry.Scheme.Hom.preimage_basicOpen]
        rfl
      have hpre₂ : ∀ a : Fin (N' + 1), (TopologicalSpace.Opens.map Φ₂.base).obj (D a) = Ω a := by
        intro a
        change (TopologicalSpace.Opens.map g₂.base).obj
          ((TopologicalSpace.Opens.map φ₂.base).obj (D a)) = Ω a
        rw [AlgebraicGeometry.Proj.fromOfGlobalSections_preimage_basicOpen 𝒜_V ψ₂ hψ₂ zero_lt_one (hX_mem a),
          AlgebraicGeometry.Scheme.Hom.preimage_basicOpen]
        change W.basicOpen (g₂.appTop.hom (ψ₂ (MvPolynomial.X a))) = Ω a
        rw [hX_twist a, AlgebraicGeometry.Scheme.basicOpen_mul,
          AlgebraicGeometry.Scheme.basicOpen_of_isUnit W hu, top_inf_eq]
      have hΩ_cov : TopologicalSpace.IsOpenCover (fun i : ULift.{u} (Fin (N' + 1)) => Ω i.down) := by
        dsimp [TopologicalSpace.IsOpenCover]
        rw [eq_top_iff]
        intro w _
        have hw : Φ₁.base w ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜_V).Opens) := trivial
        rw [← hCov_P, TopologicalSpace.Opens.mem_iSup] at hw
        rcases hw with ⟨a, hwa⟩
        rw [TopologicalSpace.Opens.mem_iSup]
        refine ⟨ULift.up a, ?_⟩
        change w ∈ Ω a
        rw [← hpre₁ a]
        exact hwa
      let covW := W.openCoverOfIsOpenCover (fun i : ULift.{u} (Fin (N' + 1)) => Ω i.down) hΩ_cov
      apply AlgebraicGeometry.Scheme.Cover.hom_ext covW
      intro idx
      let a := idx.down
      change (Ω a).ι ≫ Φ₁ = (Ω a).ι ≫ Φ₂
      let hle₁ : Ω a ≤ (TopologicalSpace.Opens.map Φ₁.base).obj (D a) := le_of_eq (hpre₁ a).symm
      let hle₂ : Ω a ≤ (TopologicalSpace.Opens.map Φ₂.base).obj (D a) := le_of_eq (hpre₂ a).symm
