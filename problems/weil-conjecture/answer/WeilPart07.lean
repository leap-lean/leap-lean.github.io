  obtain ⟨E, hE_mem, hE_sub⟩ := hClosedComp U₀ hU₀ p₀ q_B_pt hp₀_eq hp₀_le_qB hqB_min
  obtain ⟨i, hqi_E⟩ := hHit_bar E hE_mem
