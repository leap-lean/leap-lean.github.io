        refine ⟨Tx ∪ Ty, Subring.mul_mem _ (Subring.closure_mono ?_ hTx) (Subring.closure_mono ?_ hTy)⟩
        · exact Set.union_subset_union_left U (Set.image_mono (by intro v hv; exact Finset.mem_coe.mpr (Finset.mem_union_left Ty hv)))
        · exact Set.union_subset_union_left U (Set.image_mono (by intro v hv; exact Finset.mem_coe.mpr (Finset.mem_union_right Tx hv)))
    have hBS_eq : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
