      have hZ₀_cl : IsClosed Z₀ := hD_cl.preimage ℓ.base.hom.continuous
      have hU₁₂_ne : Nonempty ↥U₁₂ := by
        have h1 : (U_x x₁ : Set ↥X).Nonempty := ⟨x₁, hx_Ux x₁⟩
        have h2 : (U_x x₂ : Set ↥X).Nonempty := ⟨x₂, hx_Ux x₂⟩
        obtain ⟨u, hu⟩ :=
          (IrreducibleSpace.isIrreducible_univ (X := ↥X)).2 (U_x x₁) (U_x x₂)
            (U_x x₁).2 (U_x x₂).2 (by simpa using h1) (by simpa using h2)
        exact ⟨⟨u, hu.2⟩⟩
      haveI : Nonempty ↥U'₁.toScheme := ⟨⟨x₁, hx₁_U'₁⟩⟩
      haveI : AlgebraicGeometry.IsIntegral U'₁.toScheme :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion U'₁.ι
      have hInc_open : IsOpen (Set.range inc.base) :=
        (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding inc).isOpen_range
      have hInc_ne : (Set.range inc.base).Nonempty := by
        obtain ⟨u₀⟩ := hU₁₂_ne
        exact ⟨inc.base u₀, ⟨u₀, rfl⟩⟩
      have hInc_sub_Z₀ : Set.range inc.base ⊆ Z₀ := by
        rintro _ ⟨u, rfl⟩
        change (inc ≫ ℓ).base u ∈ D_Δ
        rw [hinc_ℓ]
        exact ⟨U₁₂.ι.base u, rfl⟩
      have hZ₀_univ : Z₀ = Set.univ := by
        by_contra hNe
        have hComplOpen : IsOpen Z₀ᶜ := hZ₀_cl.isOpen_compl
        have hComplNe : Z₀ᶜ.Nonempty := Set.nonempty_iff_ne_empty.mpr
          (fun h => hNe (Set.compl_empty_iff.mp h))
        obtain ⟨w, _, hwZ, hwCompl⟩ :=
          (IrreducibleSpace.isIrreducible_univ (X := ↥U'₁.toScheme)).2
            (Set.range inc.base) Z₀ᶜ hInc_open hComplOpen
            (by simpa using hInc_ne) (by simpa using hComplNe)
        exact hwCompl (hInc_sub_Z₀ hwZ)
      let pt₁ : ↥U'₁.toScheme := ⟨x₁, hx₁_U'₁⟩
      have hx₁_Z₀ : pt₁ ∈ Z₀ := by rw [hZ₀_univ]; trivial
      obtain ⟨w, hw_eq⟩ := hx₁_Z₀
      have hw_fst : x₁ = w := by
        have h1 := congrArg (CategoryTheory.Limits.pullback.fst ψ ψ).base hw_eq
        have hfst_diag : (CategoryTheory.Limits.pullback.diagonal ψ ≫
            CategoryTheory.Limits.pullback.fst ψ ψ).base w = w := by simp
        have hfst_ℓ : (ℓ ≫ CategoryTheory.Limits.pullback.fst ψ ψ).base pt₁ = x₁ := by
          have hl : ℓ ≫ CategoryTheory.Limits.pullback.fst ψ ψ = U'₁.ι :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          rw [hl]; rfl
        exact hfst_ℓ.symm.trans (h1.symm.trans hfst_diag)
      have hw_snd : (g₀ ≫ (U_x x₂).ι).base pt₁ = w := by
        have h2 := congrArg (CategoryTheory.Limits.pullback.snd ψ ψ).base hw_eq
        have hsnd_diag : (CategoryTheory.Limits.pullback.diagonal ψ ≫
            CategoryTheory.Limits.pullback.snd ψ ψ).base w = w := by simp
        have hsnd_ℓ : (ℓ ≫ CategoryTheory.Limits.pullback.snd ψ ψ).base pt₁ =
            (g₀ ≫ (U_x x₂).ι).base pt₁ := by
          have hr : ℓ ≫ CategoryTheory.Limits.pullback.snd ψ ψ = g₀ ≫ (U_x x₂).ι :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          rw [hr]
        exact hsnd_ℓ.symm.trans (h2.symm.trans hsnd_diag)
      let y₁_in_U₂ : ↥(U_x x₂) := g₀.base pt₁
      have hy₁_val : y₁_in_U₂.1 = x₁ := by
        change (U_x x₂).ι.base (g₀.base ⟨x₁, hx₁_U'₁⟩) = x₁
        exact hw_snd.trans hw_fst.symm
      have hEq_U₂ : y₁_in_U₂ = ⟨x₂, hx_Ux x₂⟩ := by
        apply AlgebraicGeometry.Scheme.Hom.injective ((U_x x₂).ι ≫ ψ)
        have h1 : ((U_x x₂).ι ≫ ψ).base y₁_in_U₂ = ψ.base y₁_in_U₂.1 := rfl
        rw [h1, hy₁_val, hx_eq]; rfl
      exact hy₁_val.symm.trans (congrArg Subtype.val hEq_U₂)
    have : IsDomain B' := inferInstance
    have : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of B')) :=
      PrimeSpectrum.irreducibleSpace
    have hRange_open : IsOpen (Set.range ψ.base) := by
      have hEq : Set.range ψ.base = ⋃ x : ↥X, Set.range ((U_x x).ι ≫ ψ).base := by
        ext y
        simp only [Set.mem_range, Set.mem_iUnion]
        constructor
        · rintro ⟨x, rfl⟩; exact ⟨x, ⟨x, hx_Ux x⟩, rfl⟩
        · rintro ⟨x, u, rfl⟩; exact ⟨(U_x x).ι.base u, rfl⟩
      rw [hEq]
      exact isOpen_iUnion fun x =>
        haveI := hOpen_Ux x
        (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding ((U_x x).ι ≫ ψ)).isOpen_range
    have hRange_closed : IsClosed (Set.range ψ.base) := by
      rw [← Set.image_univ]
      exact AlgebraicGeometry.Scheme.Hom.isClosedMap ψ Set.univ isClosed_univ
    have hRange_ne : (Set.range ψ.base).Nonempty := by
      obtain ⟨x₀⟩ := (inferInstance : Nonempty ↥X)
      exact ⟨ψ.base x₀, ⟨x₀, rfl⟩⟩
    have hRange_univ : Set.range ψ.base = Set.univ :=
      IsClopen.eq_univ ⟨hRange_closed, hRange_open⟩ hRange_ne
    have hSurj_ψ : AlgebraicGeometry.Surjective ψ :=
      ⟨Set.range_eq_univ.mp hRange_univ⟩
    let W_cov : ↥X → (AlgebraicGeometry.Spec (CommRingCat.of B')).Opens := fun x =>
      letI := hOpen_Ux x
      ((U_x x).ι ≫ ψ).opensRange
    have hW_top : (⨆ x : ↥X, W_cov x) = ⊤ := by
      rw [eq_top_iff]
      intro y _
      obtain ⟨x, rfl⟩ := hSurj_ψ.surj y
      rw [TopologicalSpace.Opens.mem_iSup]
      exact ⟨x, ⟨⟨x, hx_Ux x⟩, rfl⟩⟩
    have hOpen_ψ : AlgebraicGeometry.IsOpenImmersion ψ := by
      rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := @AlgebraicGeometry.IsOpenImmersion) W_cov hW_top]
      intro x
      haveI := hOpen_Ux x
      have hPre_le : (TopologicalSpace.Opens.map ψ.base).obj (W_cov x) ≤ U_x x := by
        intro z hz
        obtain ⟨u, hu⟩ := hz
        have hEq : (U_x x).ι.base u = z := hInj_ψ hu
        rw [← hEq]; exact u.2
      have hcomp_x : (ψ ∣_ W_cov x) ≫ (W_cov x).ι =
          X.homOfLE hPre_le ≫ ((U_x x).ι ≫ ψ) := by
        rw [AlgebraicGeometry.morphismRestrict_ι]
        simp
      haveI : AlgebraicGeometry.IsOpenImmersion ((ψ ∣_ W_cov x) ≫ (W_cov x).ι) := by
        rw [hcomp_x]; infer_instance
      exact AlgebraicGeometry.IsOpenImmersion.of_comp (ψ ∣_ W_cov x) (W_cov x).ι
    have hIso_ψ : CategoryTheory.IsIso ψ := by
      have hEq := AlgebraicGeometry.isomorphisms_eq_isOpenImmersion_inf_surjective
      have hMem : ((@AlgebraicGeometry.IsOpenImmersion : MorphismProperty Scheme) ⊓
          @AlgebraicGeometry.Surjective) ψ := ⟨hOpen_ψ, hSurj_ψ⟩
      rw [← hEq] at hMem
      exact hMem
    exact AlgebraicGeometry.IsAffine.of_isIso ψ
  
  
  
  have hAff_pre : ∀ a : Fin (1 + 1),
      AlgebraicGeometry.IsAffineOpen
        ((TopologicalSpace.Opens.map π.base).obj (weilProjBasicOpen R 1 a)) := by
    intro a
    let W_a := weilProjBasicOpen R 1 a
    let hAff_a := hAff_P1 R a
    let X_a : C_semi.Opens := (TopologicalSpace.Opens.map π.base).obj W_a
    by_cases hne : Nonempty ↥X_a
    · haveI : Nonempty ↥X_a.toScheme := hne
      have hInt_Xa : AlgebraicGeometry.IsIntegral X_a.toScheme :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion X_a.ι
      have hLiftOpen : ∀ (U : X_a.toScheme.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
          Nonempty ↥U →
          ∃ (W_U : C_semi.Opens) (hWU : AlgebraicGeometry.IsAffineOpen W_U) (_ : Nonempty ↥W_U)
            (e_ring : ↑(C_semi.presheaf.obj (Opposite.op W_U)) ≃+*
              ↑(X_a.toScheme.presheaf.obj (Opposite.op U))),
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ring.toRingHom) ≫ hWU.fromSpec =
              hU.fromSpec ≫ X_a.ι := by
        intro U hU hneU
        let k_U := hU.fromSpec ≫ X_a.ι
        haveI : AlgebraicGeometry.IsOpenImmersion k_U := inferInstance
        let W_U : C_semi.Opens := (AlgebraicGeometry.Scheme.Hom.opensFunctor X_a.ι).obj U
        have hWU : AlgebraicGeometry.IsAffineOpen W_U :=
          (AlgebraicGeometry.Scheme.Hom.isAffineOpen_iff_of_isOpenImmersion X_a.ι).mpr hU
        obtain ⟨u₀⟩ := hneU
        have hneWU : Nonempty ↥W_U := ⟨⟨X_a.ι.base u₀.1, ⟨u₀.1, u₀.2, rfl⟩⟩⟩
        have hRange_eq : Set.range k_U.base = Set.range hWU.fromSpec.base := by
          rw [hWU.range_fromSpec]
          change Set.range (X_a.ι.base ∘ hU.fromSpec.base) = X_a.ι.base '' (U : Set ↥X_a.toScheme)
          rw [Set.range_comp, hU.range_fromSpec]
        let θ_U := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq k_U hWU.fromSpec hRange_eq
        have hθ_fac : θ_U.hom ≫ hWU.fromSpec = k_U :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac k_U hWU.fromSpec hRange_eq
        let r_hom := (AlgebraicGeometry.Spec.preimage θ_U.hom).hom
        let r_inv := (AlgebraicGeometry.Spec.preimage θ_U.inv).hom
        have hr_id1 : r_inv.comp r_hom = RingHom.id _ := by
          have hCat : AlgebraicGeometry.Spec.preimage θ_U.hom ≫
              AlgebraicGeometry.Spec.preimage θ_U.inv = 𝟙 _ := by
            apply AlgebraicGeometry.Spec.map_injective
            rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
              AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Iso.inv_hom_id,
              AlgebraicGeometry.Spec.map_id]
          exact congrArg CommRingCat.Hom.hom hCat
        have hr_id2 : r_hom.comp r_inv = RingHom.id _ := by
          have hCat : AlgebraicGeometry.Spec.preimage θ_U.inv ≫
              AlgebraicGeometry.Spec.preimage θ_U.hom = 𝟙 _ := by
            apply AlgebraicGeometry.Spec.map_injective
            rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
              AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Iso.hom_inv_id,
              AlgebraicGeometry.Spec.map_id]
          exact congrArg CommRingCat.Hom.hom hCat
        let e_ring : ↑(C_semi.presheaf.obj (Opposite.op W_U)) ≃+*
            ↑(X_a.toScheme.presheaf.obj (Opposite.op U)) :=
          { r_hom with
            invFun := r_inv
            left_inv := fun x => RingHom.congr_fun hr_id1 x
            right_inv := fun x => RingHom.congr_fun hr_id2 x }
        refine ⟨W_U, hWU, hneWU, e_ring, ?_⟩
        change AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage θ_U.hom) ≫
          hWU.fromSpec = k_U
        rw [AlgebraicGeometry.Spec.map_preimage, hθ_fac]
      obtain ⟨pt_a⟩ := hne
      obtain ⟨_, ⟨U₀, hU₀_aff, rfl⟩, hpt_U₀, _⟩ :=
        (AlgebraicGeometry.Scheme.isBasis_affineOpens X_a.toScheme).exists_subset_of_mem_open
          (Set.mem_univ pt_a) isOpen_univ
      obtain ⟨W₀, hW₀_aff, hneW₀, e₀, he₀_spec⟩ := hLiftOpen U₀ hU₀_aff ⟨⟨pt_a, hpt_U₀⟩⟩
      obtain ⟨φ₀, _, hφ₀_spec⟩ := hFuncC W₀ hW₀_aff hneW₀
      have hRange_η : Set.range η_C.base ⊆ Set.range X_a.ι.base := by
        rintro _ ⟨q, rfl⟩
        have h1 : η_C = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom e₀.symm.toRingHom ≫ φ₀) ≫ hU₀_aff.fromSpec ≫ X_a.ι := by
          rw [← he₀_spec, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
          have hcomp_e : CommRingCat.ofHom e₀.toRingHom ≫
              (CommRingCat.ofHom e₀.symm.toRingHom ≫ φ₀) = φ₀ := by
            rw [← CategoryTheory.Category.assoc, ← CommRingCat.ofHom_comp]
            have : e₀.symm.toRingHom.comp e₀.toRingHom = RingHom.id _ :=
              RingHom.ext fun x => e₀.symm_apply_apply x
            rw [this, CommRingCat.ofHom_id, CategoryTheory.Category.id_comp]
          rw [hcomp_e, hφ₀_spec]
        rw [h1]
        exact ⟨hU₀_aff.fromSpec.base
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom ≫ φ₀)).base q), rfl⟩
      let η_Xa : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X_a.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift X_a.ι η_C hRange_η
      have hη_Xa_fac : η_Xa ≫ X_a.ι = η_C :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac X_a.ι η_C hRange_η
      have hNorm_Xa : IsAffineNormalScheme X_a.toScheme := by
        intro U hU hneU
        obtain ⟨W_U, hWU, hneWU, e_ring, _⟩ := hLiftOpen U hU hneU
        obtain ⟨hDomW, hIC_W⟩ := hNormC W_U hWU hneWU
        refine ⟨?_, IsIntegrallyClosed.of_equiv e_ring⟩
        exact Function.Injective.isDomain e_ring.symm.toRingHom e_ring.symm.injective
      have hFunc_Xa : IsSchemeFunctionField X_a.toScheme F η_Xa := by
        intro U hU hneU
        obtain ⟨W_U, hWU, hneWU, e_ring, he_spec⟩ := hLiftOpen U hU hneU
        obtain ⟨φ_W, hFracW, hφW_spec⟩ := hFuncC W_U hWU hneWU
        let i_symm : ↑(X_a.toScheme.presheaf.obj (Opposite.op U)) →+*
            ↑(C_semi.presheaf.obj (Opposite.op W_U)) := e_ring.symm.toRingHom
        let φ_U := CommRingCat.ofHom i_symm ≫ φ_W
        refine ⟨φ_U, ?_, ?_⟩
        · letI : Algebra ↑(C_semi.presheaf.obj (Opposite.op W_U)) F := φ_W.hom.toAlgebra
          haveI : IsFractionRing ↑(C_semi.presheaf.obj (Opposite.op W_U)) F := hFracW
          letI : Algebra ↑(X_a.toScheme.presheaf.obj (Opposite.op U)) F := φ_U.hom.toAlgebra
          refine
            { map_units := fun ⟨u, hu⟩ => by
                have hu' : e_ring.symm u ∈ nonZeroDivisors _ := by
                  rw [mem_nonZeroDivisors_iff_right] at hu ⊢
                  intro x hx
                  apply e_ring.injective
                  rw [map_zero]
                  apply hu (e_ring x)
                  have h1 := congrArg e_ring hx
                  simpa [map_mul] using h1
                exact IsLocalization.map_units F ⟨e_ring.symm u, hu'⟩
              surj := fun z => by
                obtain ⟨⟨w, s, hs⟩, hz⟩ :=
                  IsLocalization.surj (nonZeroDivisors ↑(C_semi.presheaf.obj (Opposite.op W_U))) z
                have hs' : e_ring s ∈ nonZeroDivisors _ := by
                  rw [mem_nonZeroDivisors_iff_right] at hs ⊢
                  intro x hx
                  apply e_ring.symm.injective
                  rw [map_zero]
                  apply hs (e_ring.symm x)
                  have h1 := congrArg e_ring.symm hx
                  simpa [map_mul] using h1
                refine ⟨⟨e_ring w, ⟨e_ring s, hs'⟩⟩, ?_⟩
                change z * φ_W.hom (e_ring.symm (e_ring s)) = φ_W.hom (e_ring.symm (e_ring w))
                rw [e_ring.symm_apply_apply, e_ring.symm_apply_apply]
                exact hz
              exists_of_eq := fun {x₁ x₂} hx => by
                have hx' : φ_W.hom (e_ring.symm x₁) = φ_W.hom (e_ring.symm x₂) := hx
                have hinj := IsFractionRing.injective
                  ↑(C_semi.presheaf.obj (Opposite.op W_U)) F
                have hEq : x₁ = x₂ := e_ring.symm.injective (hinj hx')
                exact ⟨1, by simp [hEq]⟩ }
        · rw [← cancel_mono X_a.ι, CategoryTheory.Category.assoc, hη_Xa_fac]
          dsimp [φ_U]
          rw [← he_spec, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
          have hcomp_e : CommRingCat.ofHom e_ring.toRingHom ≫
              (CommRingCat.ofHom i_symm ≫ φ_W) = φ_W := by
            rw [← CategoryTheory.Category.assoc, ← CommRingCat.ofHom_comp]
            have : i_symm.comp e_ring.toRingHom = RingHom.id _ :=
              RingHom.ext fun x => e_ring.symm_apply_apply x
            rw [this, CommRingCat.ofHom_id, CategoryTheory.Category.id_comp]
          rw [hcomp_e, hφW_spec]
      let A_a : Type u := ↑((weilProjectiveSpaceOver R 1).left.presheaf.obj (Opposite.op W_a))
      have hRange_Wa : Set.range W_a.ι.base = Set.range hAff_a.fromSpec.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι, hAff_a.range_fromSpec]
      let e_Wa := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq W_a.ι hAff_a.fromSpec hRange_Wa
      haveI : AlgebraicGeometry.IsProper π := hProp_π
      haveI : AlgebraicGeometry.IsProper (π ∣_ W_a) := inferInstance
      let f_a : X_a.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of A_a) :=
        (π ∣_ W_a) ≫ e_Wa.hom
      have hProp_fa : AlgebraicGeometry.IsProper f_a := by
        have hfe : f_a ≫ e_Wa.inv = π ∣_ W_a := by
          dsimp [f_a]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
            CategoryTheory.Category.comp_id]
        haveI : AlgebraicGeometry.IsProper (f_a ≫ e_Wa.inv) := hfe.symm ▸ inferInstance
        exact AlgebraicGeometry.IsProper.of_comp f_a e_Wa.inv
      have hfa_comm : f_a ≫ hAff_a.fromSpec = X_a.ι ≫ π := by
        dsimp [f_a]
        rw [CategoryTheory.Category.assoc,
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac W_a.ι hAff_a.fromSpec hRange_Wa,
          AlgebraicGeometry.morphismRestrict_ι]
      have hFinFib_fa : ∀ y : ↥(AlgebraicGeometry.Spec (CommRingCat.of A_a)),
          (f_a.base ⁻¹' {y}).Finite := by
        intro y
        have hSub : X_a.ι.base '' (f_a.base ⁻¹' {y}) ⊆ π.base ⁻¹' {hAff_a.fromSpec.base y} := by
          rintro _ ⟨x, hxy, rfl⟩
          rw [Set.mem_preimage, Set.mem_singleton_iff] at hxy ⊢
          change (X_a.ι ≫ π).base x = hAff_a.fromSpec.base y
          rw [← hfa_comm, AlgebraicGeometry.Scheme.Hom.comp_apply, hxy]
        have hInj_Xa : Function.Injective X_a.ι.base :=
          AlgebraicGeometry.Scheme.Hom.injective X_a.ι
        exact ((hFinFib_π (hAff_a.fromSpec.base y)).subset hSub).of_finite_image hInj_Xa.injOn
      exact hZMT A_a X_a.toScheme f_a hInt_Xa hNorm_Xa η_Xa hFunc_Xa hProp_fa hFinFib_fa
    · have hBot : X_a = ⊥ := by
        ext z
        exact ⟨fun hz => False.elim (hne ⟨z, hz⟩), False.elim⟩
      change AlgebraicGeometry.IsAffineOpen X_a
      rw [hBot]
      exact AlgebraicGeometry.isAffineOpen_bot C_semi
  have hAffHom_π : AlgebraicGeometry.IsAffineHom π := by
    apply AlgebraicGeometry.isAffineHom_of_forall_exists_isAffineOpen
    intro y
    have hy_top : y ∈ (⊤ : (weilProjectiveSpaceOver R 1).left.Opens) := trivial
    rw [← hCov_P1, TopologicalSpace.Opens.mem_iSup] at hy_top
    obtain ⟨a, hya⟩ := hy_top
    exact ⟨weilProjBasicOpen R 1 a, hya, hAff_P1 R a, hAff_pre a⟩
  exact AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨hProp_π, hAffHom_π⟩

theorem weil_finite_over_projLine_closedImmersion_projSpace (R : Type u) [CommRing R]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (π : C ⟶ (weilProjectiveSpaceOver R 1).left)
    (hFin : AlgebraicGeometry.IsFinite π)
    (hComm : π ≫ (weilProjectiveSpaceOver R 1).hom = g) :
    ∃ (M : ℕ) (ιP : C ⟶ (weilProjectiveSpaceOver R M).left),
      AlgebraicGeometry.IsClosedImmersion ιP ∧
      ιP ≫ (weilProjectiveSpaceOver R M).hom = g :=
by
  classical
  
  
  
  have hProjPkg : ∀ (N : ℕ),
      ∃ (hAff : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
        (c_R : ∀ a : Fin (N + 1),
          R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen R N a))))
        (t_R : ∀ a : Fin (N + 1), Fin (N + 1) →
          ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen R N a)))),
        AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R N).hom ∧
        (⨆ a : Fin (N + 1), weilProjBasicOpen R N a) = ⊤ ∧
        (∀ a : Fin (N + 1),
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_R a)) =
            (hAff a).fromSpec ≫ (weilProjectiveSpaceOver R N).hom) ∧
        (∀ a : Fin (N + 1), t_R a a = 1) ∧
        (∀ a : Fin (N + 1),
          Subring.closure (Set.range (c_R a) ∪ Set.range (t_R a)) = ⊤) ∧
        (∀ (a : Fin (N + 1)) (A : Type u) [CommRing A] (ρ : R →+* A) (v : Fin (N + 1) → A),
          v a = 1 →
          ∃ (ψ : ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen R N a))) →+* A),
            ψ.comp (c_R a) = ρ ∧ ∀ b : Fin (N + 1), ψ (t_R a b) = v b) ∧
        (∀ a a' : Fin (N + 1),
          (weilProjectiveSpaceOver R N).left.basicOpen (t_R a a') =
            weilProjBasicOpen R N a ⊓ weilProjBasicOpen R N a') ∧
        (∀ (a a' : Fin (N + 1)) (r : R),
          ((weilProjectiveSpaceOver R N).left.presheaf.map
            (CategoryTheory.homOfLE inf_le_right).op).hom (c_R a' r) =
          ((weilProjectiveSpaceOver R N).left.presheaf.map
            (CategoryTheory.homOfLE inf_le_left).op).hom (c_R a r)) ∧
        (∀ (a a' b : Fin (N + 1)),
          ((weilProjectiveSpaceOver R N).left.presheaf.map
            (CategoryTheory.homOfLE inf_le_right).op).hom (t_R a' b) *
          ((weilProjectiveSpaceOver R N).left.presheaf.map
            (CategoryTheory.homOfLE inf_le_left).op).hom (t_R a a') =
          ((weilProjectiveSpaceOver R N).left.presheaf.map
            (CategoryTheory.homOfLE inf_le_left).op).hom (t_R a b)) := by
    intro N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hX_mem : ∀ b : Fin (N + 1), MvPolynomial.X b ∈ 𝒜 1 :=
      fun b => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R b)
    let hAff : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a) :=
      fun a => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜
        (MvPolynomial.X a) (hX_mem a) zero_lt_one
