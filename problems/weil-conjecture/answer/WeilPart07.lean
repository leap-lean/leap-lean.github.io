            ext k; simp only [Pi.add_apply, smul_add, Finset.sum_add_distrib]
          map_smul' := fun r v => by
            ext k
            simp only [Pi.smul_apply, RingHom.id_apply, Finset.smul_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
