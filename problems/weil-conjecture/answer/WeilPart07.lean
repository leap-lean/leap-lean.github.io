            ((fstY.appLE V₀ V₀_Y le_rfl).hom s) := by
        intro s
        have hm : C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le eZ)).op ≫
            fstY.appLE U₁ U_ZY le_rfl =
            fstY.appLE V₀ V₀_Y le_rfl ≫ Y.presheaf.map (CategoryTheory.homOfLE hle_UZY_V₀).op := by
          rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
        exact RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hm) s
      have hmul_Y := congrArg (fstY.appLE U₁ U_ZY le_rfl).hom hf₁_Z_mul
      rw [map_mul, hpull_W, hpull_V₀, hpull_V₀, map_pow] at hmul_Y
