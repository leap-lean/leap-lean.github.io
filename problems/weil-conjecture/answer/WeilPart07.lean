    have hη_bot : (g_semi.base (η_semi.base pt₀)).asIdeal = ⊥ := by
      have h₁ := (AlgebraicGeometry.Scheme.Hom.comp_apply η_semi g_semi pt₀').symm
      have h₂ := congrArg (fun h => h pt₀') hη_semi
      have hBase : g_semi.base (η_semi.base pt₀) =
           PrimeSpectrum.comap (φ_KF.comp V.subtype) pt₀ := h₁.trans h₂
      have hAsIdeal : (g_semi.base (η_semi.base pt₀)).asIdeal =
          Ideal.comap (φ_KF.comp V.subtype) pt₀.asIdeal :=
        congrArg PrimeSpectrum.asIdeal hBase
      rw [hAsIdeal, hpt₀_bot]
      ext x
      simp only [Ideal.mem_comap, Submodule.mem_bot]
      exact ⟨fun hx => (φ_KF.injective.comp Subtype.val_injective) (by simpa using hx),
        fun hx => by simp [hx]⟩
    rintro ⟨_, ⟨ν, rfl⟩, _, ⟨j, rfl⟩, pt, hpt_eq⟩
    have hBot_eq : (g_semi.base ((σ_fn ν j).base pt)).asIdeal = ⊥ := by
      rw [hpt_eq, hη_bot]
    let pt' : ↥(AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ P_fn ν j))) := pt
    have h₁' := (AlgebraicGeometry.Scheme.Hom.comp_apply (σ_fn ν j) g_semi pt').symm
    have h₂' := congrArg (fun h => h pt') (hσ_z_comm (z_fn ν j))
    have hBase' : g_semi.base ((σ_fn ν j).base pt) =
        PrimeSpectrum.comap (Ideal.Quotient.mk (P_fn ν j)) pt := h₁'.trans h₂'
    have hComap_eq : (g_semi.base ((σ_fn ν j).base pt)).asIdeal =
        Ideal.comap (Ideal.Quotient.mk (P_fn ν j)) pt.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hBase'
    rw [hComap_eq] at hBot_eq
    have hLe_bot : P_fn ν j ≤ ⊥ := by
      rw [← Ideal.mk_ker (I := P_fn ν j), ← hBot_eq]
      intro x hx
      rw [RingHom.mem_ker] at hx
      change Ideal.Quotient.mk (P_fn ν j) x ∈ pt.asIdeal
      rw [hx]
      exact pt.asIdeal.zero_mem
    exact hS_inf_ne_bot (z_fn ν j) (le_bot_iff.mp hLe_bot)
  let V_dom : C_tilde.Opens := (TopologicalSpace.Opens.map q.base).obj U_dom
  obtain ⟨η_C, η_X, hIntV, hIntU, hNormU, hProp_res, hDomC, hη_res, hFuncV, hFuncU, hLocQF⟩ :=
    weil_open_subscheme_birational_locallyQuasiFinite_setup
      C_tilde C_semi F q η_tilde η_semi hInt_tilde hInt_semi hNorm_semi
      hProp_q hη_q hFunc_tilde hFunc_semi U_dom hη_mem hFin_fib
  have hIso_dom : CategoryTheory.IsIso (q ∣_ U_dom) :=
    weil_birational_proper_iso_of_locallyQuasiFinite_normal
      V_dom.toScheme U_dom.toScheme F
      (q ∣_ U_dom) η_C η_X hIntV hIntU hNormU hProp_res hDomC hη_res hFuncV hFuncU hLocQF
  
  refine ⟨U_dom, b, K_bad, y_bad, hIso_dom, ?_, ?_, ?_, ?_⟩
  · change (Z_badᶜ)ᶜ = Z_bad
    exact compl_compl Z_bad
  · intro ν
    obtain ⟨z₀, hz₀⟩ := hFib_nonempty ν
    let j₀ : Fin (r_fn ν) := (e_fib ν).symm ⟨z₀, hz₀⟩
    have hy_j₀ : y_bad ν = (σ_fn ν j₀).base (m_bar (z_fn ν j₀)) :=
      (hz_fn_y ν j₀).symm
    refine ⟨hKbad_cl ν, ?_, ?_⟩
    · exact Set.mem_iUnion.mpr ⟨j₀, m_bar (z_fn ν j₀), hy_j₀.symm⟩
    · rw [← hz_fn_y ν j₀]
      exact hy_of_max (z_fn ν j₀)
  · intro ν ν' hne
    by_contra hNotDisj
    obtain ⟨w, hw_ν, hw_ν'⟩ := Set.not_disjoint_iff.mp hNotDisj
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hw_ν
    obtain ⟨j', hj'⟩ := Set.mem_iUnion.mp hw_ν'
    have hRangeNotDisj : ¬ Disjoint (Set.range (σ_fn ν j).base) (Set.range (σ_fn ν' j').base) :=
      Set.not_disjoint_iff.mpr ⟨w, hj, hj'⟩
    have : (P_fn ν j).IsPrime := hPrime_Pz (z_fn ν j)
    have : (P_fn ν' j').IsPrime := hPrime_Pz (z_fn ν' j')
    have hEq_y : (σ_fn ν j).base (m_bar (z_fn ν j)) =
        (σ_fn ν' j').base (m_bar (z_fn ν' j')) :=
      hSpecUniq (P_fn ν j) (P_fn ν' j') (σ_fn ν j) (σ_fn ν' j')
        (hσ_z_comm (z_fn ν j)) (hσ_z_comm (z_fn ν' j')) hRangeNotDisj
        (m_bar (z_fn ν j)) (m_bar (z_fn ν' j'))
        (hm_bar_comap (z_fn ν j)) (hm_bar_comap (z_fn ν' j'))
    have hEq_ybad : y_bad ν = y_bad ν' := by
      rw [← hz_fn_y ν j, ← hz_fn_y ν' j']
      exact hEq_y
    exact hne (e_bad.injective (Subtype.ext hEq_ybad))
  · intro ν
    refine ⟨r_fn ν, P_fn ν, fun j => hPrime_Pz (z_fn ν j), σ_fn ν, ?_, rfl⟩
    intro j
    refine ⟨hS_inf_ne_bot (z_fn ν j), hσ_z_comm (z_fn ν j), ?_⟩
    intro pt hpt
    rw [hm_bar_uniq (z_fn ν j) pt hpt]
    exact hz_fn_y ν j

theorem weil_closedFiber_curve_linear_pencil_matrix_avoidance (K : Type u) [Field K]
    (V : ValuationSubring K)
    (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (q_V : ↥V →+* k₀)
    (hq_surj : Function.Surjective q_V)
    (hq_ker : RingHom.ker q_V = IsLocalRing.maximalIdeal ↥V)
    (F : Type u) [Field F]
    (φ_KF : K →+* F)
    (hTwoVar : ∀ (W : ValuationSubring F)
        (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W)
        (P : Ideal ↥V) [P.IsPrime],
      (∀ c : ↥V,
        ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P)) →
      ¬ ∃ (t₁ t₂ : ↥W),
        ∀ (Q : MvPolynomial (Fin 2) ↥V),
          (∃ d : Fin 2 →₀ ℕ, Q.coeff d ∉ P) →
          MvPolynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ![t₁, t₂] Q ∉
            IsLocalRing.maximalIdeal ↥W)
    (M : ℕ) (h1M : 1 ≤ M)
    (A : Fin (M + 1) → Type u) [∀ a : Fin (M + 1), CommRing (A a)]
    (c_A : ∀ a : Fin (M + 1), ↥V →+* A a)
    (t_A : ∀ a : Fin (M + 1), Fin (M + 1) → A a)
    (ht_diag : ∀ a : Fin (M + 1), t_A a a = 1)
    (hGen : ∀ a : Fin (M + 1), Subring.closure (Set.range (c_A a) ∪ Set.range (t_A a)) = ⊤)
    (hEmb : ∀ a : Fin (M + 1), Nontrivial (A a) →
      ∃ ψ : A a →+* F, Function.Injective ψ ∧ ∀ v : ↥V, ψ (c_A a v) = φ_KF (V.subtype v))
    (a₀ : Fin (M + 1))
    (p₀ : PrimeSpectrum (A a₀))
    (hp₀ : Ideal.comap (c_A a₀) p₀.asIdeal = IsLocalRing.maximalIdeal ↥V) :
    ∃ (A_mat B_mat : Matrix (Fin (M + 1)) (Fin (M + 1)) ↥V),
      A_mat * B_mat = 1 ∧
      B_mat * A_mat = 1 ∧
      (∑ j : Fin (M + 1), c_A a₀ (A_mat ⟨0, by omega⟩ j) * t_A a₀ j) ∉ p₀.asIdeal ∧
      (∑ j : Fin (M + 1), c_A a₀ (A_mat ⟨1, by omega⟩ j) * t_A a₀ j) ∉ p₀.asIdeal ∧
      ∀ (a : Fin (M + 1)) (p : PrimeSpectrum (A a)),
        Ideal.comap (c_A a) p.asIdeal = IsLocalRing.maximalIdeal ↥V →
        (∑ j : Fin (M + 1), c_A a (A_mat ⟨0, by omega⟩ j) * t_A a j) ∉ p.asIdeal ∨
        (∑ j : Fin (M + 1), c_A a (A_mat ⟨1, by omega⟩ j) * t_A a j) ∉ p.asIdeal :=
by
  let σ : k₀ → ↥V := fun x => Classical.choose (hq_surj x)
  have hσ : Function.RightInverse σ q_V := fun x => Classical.choose_spec (hq_surj x)
  have hMax_𝔪 : (IsLocalRing.maximalIdeal ↥V).IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥V
  have hPrime_𝔪 : (IsLocalRing.maximalIdeal ↥V).IsPrime := hMax_𝔪.isPrime
  have : Infinite k₀ := inferInstance
  let i₀ : Fin (M + 1) := ⟨0, by omega⟩
  let i₁ : Fin (M + 1) := ⟨1, by omega⟩
  have hi01 : i₀ ≠ i₁ := by
    intro h
    have hval := congrArg Fin.val h
    dsimp [i₀, i₁] at hval
    omega
  
  have hTransUniv : ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra k₀ R]
      (J : Ideal R), J ≠ ⊤ → ∀ y : R, y ∈ J → y ≠ 0 →
      ∀ (n : ℕ) (P : Polynomial k₀), P.natDegree = n → P ≠ 0 → Polynomial.aeval y P ≠ 0 := by
    intro R _ _ _ J hJ y hy_mem hy_ne n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro P hn hP_ne heval
      have hdiv : Polynomial.X * P.divX + Polynomial.C (P.coeff 0) = P :=
        Polynomial.X_mul_divX_add P
      have hstep : y * Polynomial.aeval y P.divX + algebraMap k₀ R (P.coeff 0) = 0 := by
        have h1 := congrArg (Polynomial.aeval y) hdiv
        rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, heval] at h1
        exact h1
      by_cases hc0 : P.coeff 0 = 0
      · by_cases hn0 : n = 0
        · apply hP_ne
          rw [Polynomial.eq_C_of_natDegree_eq_zero (hn.trans hn0), hc0, map_zero]
        · have hdiv_ne : P.divX ≠ 0 := by
            intro h0
            apply hP_ne
            rw [← hdiv, h0, hc0, mul_zero, map_zero, add_zero]
          have hdeg_lt : P.divX.natDegree < n := by
            rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one, hn]
            omega
          have hprod0 : y * Polynomial.aeval y P.divX = 0 := by
            rw [hc0, map_zero, add_zero] at hstep
            exact hstep
          have hdiv_eval0 : Polynomial.aeval y P.divX = 0 :=
            (mul_eq_zero.mp hprod0).resolve_left hy_ne
          exact ih P.divX.natDegree hdeg_lt P.divX rfl hdiv_ne hdiv_eval0
      · apply hJ
        rw [Ideal.eq_top_iff_one]
        have hc_mem : algebraMap k₀ R (P.coeff 0) ∈ J := by
          have heq : algebraMap k₀ R (P.coeff 0) = -(y * Polynomial.aeval y P.divX) := by
            linear_combination hstep
          rw [heq]
          exact J.neg_mem (J.mul_mem_right _ hy_mem)
        have h1_mem : algebraMap k₀ R (P.coeff 0)⁻¹ * algebraMap k₀ R (P.coeff 0) ∈ J :=
          J.mul_mem_left _ hc_mem
        rwa [← map_mul, inv_mul_cancel₀ hc0, map_one] at h1_mem
  
  have hNoChain : ∀ (a : Fin (M + 1)) (Q₀ Q₁ Q₂ : Ideal (A a)),
      Q₀.IsPrime → Q₁.IsPrime → Q₂.IsPrime →
      Ideal.comap (c_A a) Q₀ = IsLocalRing.maximalIdeal ↥V → ¬ (Q₀ < Q₁ ∧ Q₁ < Q₂) := by
    intro a Q₀ Q₁ Q₂ hQ₀ hQ₁ hQ₂ hQ₀_comap ⟨hQ01, hQ12⟩
    have : Q₀.IsPrime := hQ₀
    have : Q₁.IsPrime := hQ₁
    have : Q₂.IsPrime := hQ₂
    have hNontriv_A : Nontrivial (A a) :=
      ⟨⟨0, 1, fun h01 => hQ₀.ne_top ((Ideal.eq_top_iff_one Q₀).mpr (h01 ▸ Q₀.zero_mem))⟩⟩
    obtain ⟨ψ, hψ_inj, hψ_compat⟩ := hEmb a hNontriv_A
    have hDomA : IsDomain (A a) := Function.Injective.isDomain ψ hψ_inj
    let D := A a ⧸ Q₀
    let τ₀ : A a →+* D := Ideal.Quotient.mk Q₀
    have : IsDomain D := Ideal.Quotient.isDomain Q₀
    have hker_D : RingHom.ker q_V ≤ RingHom.ker (τ₀.comp (c_A a)) := by
      intro v hv
      rw [hq_ker, ← hQ₀_comap, Ideal.mem_comap] at hv
      rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact hv
    let ι_D : k₀ →+* D := q_V.liftOfRightInverseAux σ hσ (τ₀.comp (c_A a)) hker_D
    have hι_D : ∀ v : ↥V, ι_D (q_V v) = τ₀ (c_A a v) :=
      fun v => RingHom.liftOfRightInverseAux_comp_apply q_V σ hσ (τ₀.comp (c_A a)) hker_D v
    let : Algebra k₀ D := ι_D.toAlgebra
    obtain ⟨u₁, hu₁_Q₁, hu₁_not_Q₀⟩ := SetLike.exists_of_lt hQ01
    obtain ⟨u₂, hu₂_Q₂, hu₂_not_Q₁⟩ := SetLike.exists_of_lt hQ12
    let x₁ : D := τ₀ u₁
    let x₂ : D := τ₀ u₂
    have hx₁_ne : x₁ ≠ 0 := fun h => hu₁_not_Q₀ (Ideal.Quotient.eq_zero_iff_mem.mp h)
    let J₁ : Ideal D := Ideal.map τ₀ Q₁
    let J₂ : Ideal D := Ideal.map τ₀ Q₂
    have hJ₁_comap : Ideal.comap τ₀ J₁ = Q₁ := by
      rw [Ideal.comap_map_of_surjective' τ₀ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
        sup_eq_left.mpr hQ01.le]
    have hJ₂_comap : Ideal.comap τ₀ J₂ = Q₂ := by
      rw [Ideal.comap_map_of_surjective' τ₀ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
        sup_eq_left.mpr (hQ01.le.trans hQ12.le)]
    have hJ₁_prime : J₁.IsPrime := by
      refine ⟨?_, ?_⟩
      · intro htop
        apply hQ₁.ne_top
        rw [← hJ₁_comap, htop]
        rfl
      · intro z₁ z₂ hz
        obtain ⟨b₁, rfl⟩ := Ideal.Quotient.mk_surjective z₁
        obtain ⟨b₂, rfl⟩ := Ideal.Quotient.mk_surjective z₂
        have hmem : b₁ * b₂ ∈ Q₁ := by
          rw [← hJ₁_comap]
          exact hz
        rcases hQ₁.mem_or_mem hmem with h1 | h2
        · exact Or.inl (Ideal.mem_map_of_mem τ₀ h1)
        · exact Or.inr (Ideal.mem_map_of_mem τ₀ h2)
    have hx₁_J₁ : x₁ ∈ J₁ := Ideal.mem_map_of_mem τ₀ hu₁_Q₁
    have hx₂_J₂ : x₂ ∈ J₂ := Ideal.mem_map_of_mem τ₀ hu₂_Q₂
    have hx₂_not_J₁ : x₂ ∉ J₁ := fun h => hu₂_not_Q₁ (by rw [← hJ₁_comap]; exact h)
    let D₁ := D ⧸ J₁
    have : IsDomain D₁ := Ideal.Quotient.isDomain J₁
    let π₁ : D →ₐ[k₀] D₁ := Ideal.Quotient.mkₐ k₀ J₁
    let J'₂ : Ideal D₁ := Ideal.map π₁.toRingHom J₂
    have hJ'₂_comap : Ideal.comap π₁.toRingHom J'₂ = J₂ := by
      have hsurj₁ : Function.Surjective π₁.toRingHom := Ideal.Quotient.mk_surjective
      have hker₁ : RingHom.ker π₁.toRingHom = J₁ := Ideal.mk_ker
      rw [Ideal.comap_map_of_surjective' π₁.toRingHom hsurj₁, hker₁,
        sup_eq_left.mpr (Ideal.map_mono hQ12.le)]
    have hJ'₂_ne_top : J'₂ ≠ ⊤ := by
      intro htop
      apply hQ₂.ne_top
      rw [← hJ₂_comap, ← hJ'₂_comap, htop]
      rfl
    have hx₂_bar_mem : π₁ x₂ ∈ J'₂ := Ideal.mem_map_of_mem π₁.toRingHom hx₂_J₂
    have hx₂_bar_ne : π₁ x₂ ≠ 0 := fun h => hx₂_not_J₁ (Ideal.Quotient.eq_zero_iff_mem.mp h)
    have haeval_x₂ : ∀ P : Polynomial k₀, P ≠ 0 → Polynomial.aeval x₂ P ∉ J₁ := by
      intro P hP hmem
      have h0 : π₁ (Polynomial.aeval x₂ P) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      rw [← Polynomial.aeval_algHom_apply π₁ x₂ P] at h0
      exact hTransUniv D₁ J'₂ hJ'₂_ne_top (π₁ x₂) hx₂_bar_mem hx₂_bar_ne P.natDegree P rfl hP h0
    have hBiv : ∀ F₀ : MvPolynomial (Fin 2) k₀, F₀ ≠ 0 →
        MvPolynomial.eval₂ ι_D ![x₁, x₂] F₀ ≠ 0 := by
      intro F₀ hF₀
      have hsupp_ne : F₀.support.Nonempty := MvPolynomial.support_nonempty.mpr hF₀
      let S_deg := F₀.support.image (fun d => d 0)
      let deg₀ : ℕ := S_deg.min' (hsupp_ne.image _)
      have hdeg₀_mem : deg₀ ∈ S_deg := Finset.min'_mem S_deg (hsupp_ne.image _)
      obtain ⟨d_star, hd_star_supp, hd_star_0⟩ := Finset.mem_image.mp hdeg₀_mem
      have hd_star_coeff : F₀.coeff d_star ≠ 0 := MvPolynomial.mem_support_iff.mp hd_star_supp
      let supp_eq := F₀.support.filter (fun d => d 0 = deg₀)
      let supp_gt := F₀.support.filter (fun d => ¬ d 0 = deg₀)
      let P_slice : Polynomial k₀ :=
        ∑ d ∈ supp_eq, Polynomial.monomial (d 1) (F₀.coeff d)
      have hP_slice_ne : P_slice ≠ 0 := by
        intro hP0
        apply hd_star_coeff
        have hc : P_slice.coeff (d_star 1) = 0 := by rw [hP0, Polynomial.coeff_zero]
        dsimp [P_slice] at hc
        rw [Polynomial.finsetSum_coeff] at hc
        have hsum_eq :
            (∑ d ∈ supp_eq, (Polynomial.monomial (d 1) (F₀.coeff d)).coeff (d_star 1)) =
              F₀.coeff d_star := by
          rw [Finset.sum_eq_single d_star]
          · simp
          · intro d hd hne
            rw [Polynomial.coeff_monomial, ite_eq_right_iff]
            intro h1
            exfalso
            apply hne
            exact Finsupp.ext
              (Fin.forall_fin_two.mpr ⟨(Finset.mem_filter.mp hd).2.trans hd_star_0.symm, h1⟩)
          · intro hnot
            exact False.elim (hnot (Finset.mem_filter.mpr ⟨hd_star_supp, hd_star_0⟩))
        rw [hsum_eq] at hc
        exact hc
      have hP_not_J₁ : Polynomial.aeval x₂ P_slice ∉ J₁ := haeval_x₂ P_slice hP_slice_ne
      let R_rem : D :=
        ∑ d ∈ supp_gt, ι_D (F₀.coeff d) * x₁ ^ (d 0 - deg₀ - 1) * x₂ ^ (d 1)
      have heval_eq :
          MvPolynomial.eval₂ ι_D ![x₁, x₂] F₀ =
            x₁ ^ deg₀ * (Polynomial.aeval x₂ P_slice + x₁ * R_rem) := by
        rw [MvPolynomial.eval₂_eq']
        have hprod : ∀ d : Fin 2 →₀ ℕ,
            (∏ j : Fin 2, (![x₁, x₂] j) ^ (d j)) = x₁ ^ (d 0) * x₂ ^ (d 1) := by
          intro d
          rw [Fin.prod_univ_two]
          rfl
        simp_rw [hprod]
        rw [← Finset.sum_filter_add_sum_filter_not F₀.support (fun d => d 0 = deg₀)]
        have hsum_L :
            (∑ d ∈ supp_eq, ι_D (F₀.coeff d) * (x₁ ^ (d 0) * x₂ ^ (d 1))) =
              x₁ ^ deg₀ * Polynomial.aeval x₂ P_slice := by
          dsimp [P_slice]
          rw [map_sum, Finset.mul_sum]
          refine Finset.sum_congr rfl fun d hd => ?_
          have hd0 : d 0 = deg₀ := (Finset.mem_filter.mp hd).2
          rw [hd0, Polynomial.aeval_monomial]
          change ι_D (F₀.coeff d) * (x₁ ^ deg₀ * x₂ ^ (d 1)) =
            x₁ ^ deg₀ * (ι_D (F₀.coeff d) * x₂ ^ (d 1))
          ring
        have hsum_R :
            (∑ d ∈ supp_gt, ι_D (F₀.coeff d) * (x₁ ^ (d 0) * x₂ ^ (d 1))) =
              x₁ ^ deg₀ * (x₁ * R_rem) := by
          dsimp [R_rem]
          rw [Finset.mul_sum, Finset.mul_sum]
          refine Finset.sum_congr rfl fun d hd => ?_
          obtain ⟨hd_supp, hd_ne⟩ := Finset.mem_filter.mp hd
          have hd_ge : deg₀ ≤ d 0 :=
            Finset.min'_le S_deg (d 0) (Finset.mem_image_of_mem _ hd_supp)
          have hd_split : d 0 = deg₀ + 1 + (d 0 - deg₀ - 1) := by omega
          conv_lhs => rw [hd_split, pow_add, pow_add, pow_one]
          ring
        change (∑ d ∈ supp_eq, ι_D (F₀.coeff d) * (x₁ ^ (d 0) * x₂ ^ (d 1))) +
            (∑ d ∈ supp_gt, ι_D (F₀.coeff d) * (x₁ ^ (d 0) * x₂ ^ (d 1))) = _
        rw [hsum_L, hsum_R, ← mul_add]
      intro heval0
      rw [heval_eq] at heval0
      have hfac0 : Polynomial.aeval x₂ P_slice + x₁ * R_rem = 0 :=
        (mul_eq_zero.mp heval0).resolve_left (pow_ne_zero deg₀ hx₁_ne)
      apply hP_not_J₁
      have heq : Polynomial.aeval x₂ P_slice = -(x₁ * R_rem) := by
        linear_combination hfac0
      rw [heq]
      exact J₁.neg_mem (J₁.mul_mem_right R_rem hx₁_J₁)
    
    have hψ_unit : ∀ y : Q₀.primeCompl, IsUnit (ψ y.1) := by
      intro y
      have hy_ne : y.1 ≠ 0 := fun h0 => y.2 (h0 ▸ Q₀.zero_mem)
      have hψ_ne : ψ y.1 ≠ 0 := fun h0 => hy_ne (hψ_inj (h0.trans (map_zero ψ).symm))
      exact Ne.isUnit hψ_ne
    let B_loc := Localization.AtPrime Q₀
    let ψ_loc : B_loc →+* F := IsLocalization.lift hψ_unit
    obtain ⟨W, hW_mem, hLocal_ρ⟩ := IsLocalRing.exists_factor_valuationRing ψ_loc
    let ρ_loc : B_loc →+* ↥W := ψ_loc.codRestrict W.toSubring hW_mem
    have : IsLocalHom ρ_loc := hLocal_ρ
    let ρ_B : A a →+* ↥W := ρ_loc.comp (algebraMap (A a) B_loc)
    have hρ_B_val : ∀ b : A a, (ρ_B b : F) = ψ b := by
      intro b
      change ψ_loc (algebraMap (A a) B_loc b) = ψ b
      exact IsLocalization.lift_eq hψ_unit b
    have hcomap_ρ_loc :
        Ideal.comap ρ_loc (IsLocalRing.maximalIdeal ↥W) = IsLocalRing.maximalIdeal B_loc := by
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
      · intro z hz
        rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hz
        exact fun hu => hz (IsLocalHom.map_nonunit z hu)
    have hcomap_ρ_B : Ideal.comap ρ_B (IsLocalRing.maximalIdeal ↥W) = Q₀ := by
      rw [← Ideal.comap_comap, hcomap_ρ_loc]
      exact Localization.AtPrime.under_maximalIdeal
    have hV_W : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W := by
      intro c
      rw [← hψ_compat c, ← hρ_B_val (c_A a c)]
      exact (ρ_B (c_A a c)).2
    have hDom_W : ∀ c : ↥V,
        ((⟨φ_KF (V.subtype c), hV_W c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ IsLocalRing.maximalIdeal ↥V) := by
      intro c
      have hsub_eq : (⟨φ_KF (V.subtype c), hV_W c⟩ : ↥W) = ρ_B (c_A a c) := by
        apply Subtype.ext
        change φ_KF (V.subtype c) = (ρ_B (c_A a c) : F)
        rw [hρ_B_val, hψ_compat]
      rw [hsub_eq, ← Ideal.mem_comap, hcomap_ρ_B, ← hQ₀_comap, Ideal.mem_comap]
    apply hTwoVar W hV_W (IsLocalRing.maximalIdeal ↥V) hDom_W
    refine ⟨ρ_B u₁, ρ_B u₂, ?_⟩
    intro Q ⟨d₀, hd₀⟩
    let F₀ : MvPolynomial (Fin 2) k₀ := MvPolynomial.map q_V Q
    have hF₀_ne : F₀ ≠ 0 := by
      intro h0
      apply hd₀
      rw [← hq_ker, RingHom.mem_ker]
      have hc := congrArg (fun P : MvPolynomial (Fin 2) k₀ => P.coeff d₀) h0
      simpa [F₀, MvPolynomial.coeff_map] using hc
    have heval_F₀ : MvPolynomial.eval₂ ι_D ![x₁, x₂] F₀ ≠ 0 := hBiv F₀ hF₀_ne
    have h_hom_D : ι_D.comp q_V = τ₀.comp (c_A a) := RingHom.ext hι_D
    have h_pts_D : (![x₁, x₂] : Fin 2 → D) = ⇑τ₀ ∘ ![u₁, u₂] :=
      funext (Fin.forall_fin_two.mpr ⟨rfl, rfl⟩)
    have hτ₀_eval :
        τ₀ (MvPolynomial.eval₂ (c_A a) ![u₁, u₂] Q) = MvPolynomial.eval₂ ι_D ![x₁, x₂] F₀ := by
      dsimp [F₀]
      rw [MvPolynomial.eval₂_map, h_hom_D, h_pts_D,
        ← MvPolynomial.eval₂_comp_left τ₀ (c_A a) ![u₁, u₂] Q]
    have hnot_Q₀ : MvPolynomial.eval₂ (c_A a) ![u₁, u₂] Q ∉ Q₀ := by
      intro hmem
      apply heval_F₀
      rw [← hτ₀_eval, Ideal.Quotient.eq_zero_iff_mem]
      exact hmem
    have h_hom_W :
        (φ_KF.comp V.subtype).codRestrict W.toSubring hV_W = ρ_B.comp (c_A a) := by
      ext c
      change φ_KF (V.subtype c) = (ρ_B (c_A a c) : F)
      rw [hρ_B_val, hψ_compat]
    have h_pts_W : (![ρ_B u₁, ρ_B u₂] : Fin 2 → ↥W) = ⇑ρ_B ∘ ![u₁, u₂] :=
      funext (Fin.forall_fin_two.mpr ⟨rfl, rfl⟩)
    rw [h_hom_W, h_pts_W, ← MvPolynomial.eval₂_comp_left ρ_B (c_A a) ![u₁, u₂] Q]
    intro hmem_W
    apply hnot_Q₀
    rw [← hcomap_ρ_B]
    exact hmem_W
  
  have hChartFin : ∀ a : Fin (M + 1),
      ∃ S_min : Set (PrimeSpectrum (A a)),
        S_min.Finite ∧
        (∀ q ∈ S_min, Ideal.comap (c_A a) q.asIdeal = IsLocalRing.maximalIdeal ↥V) ∧
        ∀ f : A a, (∀ q ∈ S_min, f ∉ q.asIdeal) →
          {p : PrimeSpectrum (A a) |
            Ideal.comap (c_A a) p.asIdeal = IsLocalRing.maximalIdeal ↥V ∧ f ∈ p.asIdeal}.Finite := by
    intro a
    let I_a : Ideal (A a) := Ideal.map (c_A a) (IsLocalRing.maximalIdeal ↥V)
    let B_bar := A a ⧸ I_a
    let π_a : A a →+* B_bar := Ideal.Quotient.mk I_a
    have hIa_le_iff : ∀ (P : Ideal (A a)) [P.IsPrime],
        I_a ≤ P ↔ Ideal.comap (c_A a) P = IsLocalRing.maximalIdeal ↥V := by
      intro P hP
      rw [Ideal.map_le_iff_le_comap]
      constructor
      · intro hle
        exact le_antisymm (IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)) hle
      · intro heq
        exact heq.ge
    have hker_bar : RingHom.ker q_V ≤ RingHom.ker (π_a.comp (c_A a)) := by
      intro v hv
      rw [hq_ker] at hv
      rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem (c_A a) hv
    let ι_bar : k₀ →+* B_bar := q_V.liftOfRightInverseAux σ hσ (π_a.comp (c_A a)) hker_bar
    have hι_bar : ∀ v : ↥V, ι_bar (q_V v) = π_a (c_A a v) :=
      fun v => RingHom.liftOfRightInverseAux_comp_apply q_V σ hσ (π_a.comp (c_A a)) hker_bar v
    let : Algebra k₀ B_bar := ι_bar.toAlgebra
    let Φ_a : MvPolynomial (Fin (M + 1)) k₀ →ₐ[k₀] B_bar :=
      MvPolynomial.aeval (fun j => π_a (t_A a j))
    have hΦ_surj : Function.Surjective Φ_a.toRingHom := by
      have hsub_top : Φ_a.toRingHom.range.comap π_a = ⊤ := by
        rw [eq_top_iff, ← hGen a, Subring.closure_le]
        rintro x (⟨v, rfl⟩ | ⟨j, rfl⟩)
        · refine ⟨MvPolynomial.C (q_V v), ?_⟩
          change Φ_a (MvPolynomial.C (q_V v)) = π_a (c_A a v)
          rw [MvPolynomial.aeval_C]
          exact hι_bar v
        · refine ⟨MvPolynomial.X j, ?_⟩
          change Φ_a (MvPolynomial.X j) = π_a (t_A a j)
          exact MvPolynomial.aeval_X _ j
      intro y
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hx : x ∈ Φ_a.toRingHom.range.comap π_a := by
        rw [hsub_top]
        trivial
      exact hx
    have : IsNoetherianRing B_bar :=
      isNoetherianRing_of_surjective _ _ Φ_a.toRingHom hΦ_surj
    have hDichot : ∀ (q_bar : Ideal B_bar), q_bar.IsPrime →
        q_bar ∈ minimalPrimes B_bar ∨ q_bar.IsMaximal := by
      intro q_bar hq_prime
      by_contra h_neither
      rw [not_or] at h_neither
      obtain ⟨hq_not_min, hq_not_max⟩ := h_neither
      have : q_bar.IsPrime := hq_prime
      obtain ⟨q₀_bar, hq₀_min, hq₀_le⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ q_bar)
      have hq₀_in_min : q₀_bar ∈ minimalPrimes B_bar := hq₀_min
      have hq₀_prime : q₀_bar.IsPrime := hq₀_min.1.1
      have hq₀_lt : q₀_bar < q_bar :=
        lt_of_le_of_ne hq₀_le (fun heq => hq_not_min (heq ▸ hq₀_in_min))
      obtain ⟨q₂_bar, hq₂_max, hq_le₂⟩ := Ideal.exists_le_maximal q_bar hq_prime.ne_top
      have hq₂_prime : q₂_bar.IsPrime := hq₂_max.isPrime
      have hq_lt₂ : q_bar < q₂_bar :=
        lt_of_le_of_ne hq_le₂ (fun heq => hq_not_max (heq ▸ hq₂_max))
      let Q₀ : Ideal (A a) := Ideal.comap π_a q₀_bar
      let Q₁ : Ideal (A a) := Ideal.comap π_a q_bar
      let Q₂ : Ideal (A a) := Ideal.comap π_a q₂_bar
      have hQ₀_p : Q₀.IsPrime := hq₀_prime.comap π_a
      have hQ₁_p : Q₁.IsPrime := hq_prime.comap π_a
      have hQ₂_p : Q₂.IsPrime := hq₂_prime.comap π_a
      have hQ₀_lt : Q₀ < Q₁ := by
        refine lt_of_le_of_ne (Ideal.comap_mono hq₀_lt.le) fun heq => hq₀_lt.ne ?_
        rw [← Ideal.map_comap_of_surjective π_a Ideal.Quotient.mk_surjective q₀_bar,
          ← Ideal.map_comap_of_surjective π_a Ideal.Quotient.mk_surjective q_bar]
        exact congrArg (Ideal.map π_a) heq
      have hQ₁_lt : Q₁ < Q₂ := by
        refine lt_of_le_of_ne (Ideal.comap_mono hq_lt₂.le) fun heq => hq_lt₂.ne ?_
        rw [← Ideal.map_comap_of_surjective π_a Ideal.Quotient.mk_surjective q_bar,
          ← Ideal.map_comap_of_surjective π_a Ideal.Quotient.mk_surjective q₂_bar]
        exact congrArg (Ideal.map π_a) heq
      have hIa_le_Q₀ : I_a ≤ Q₀ := by
        intro x hx
        rw [Ideal.mem_comap, (Ideal.Quotient.eq_zero_iff_mem).mpr hx]
        exact q₀_bar.zero_mem
      have hQ₀_comap : Ideal.comap (c_A a) Q₀ = IsLocalRing.maximalIdeal ↥V := (hIa_le_iff Q₀).mp hIa_le_Q₀
      exact hNoChain a Q₀ Q₁ Q₂ hQ₀_p hQ₁_p hQ₂_p hQ₀_comap ⟨hQ₀_lt, hQ₁_lt⟩
    let M₀ : Set (PrimeSpectrum B_bar) :=
      {q_bar : PrimeSpectrum B_bar | q_bar.asIdeal ∈ minimalPrimes B_bar}
    let S_min : Set (PrimeSpectrum (A a)) := PrimeSpectrum.comap π_a '' M₀
    have hM₀_fin : M₀.Finite :=
      (minimalPrimes.finite_of_isNoetherianRing B_bar).preimage
        (fun _ _ _ _ h => PrimeSpectrum.ext h)
    refine ⟨S_min, hM₀_fin.image _, ?_, ?_⟩
    · rintro q ⟨q_bar, _, rfl⟩
      apply (hIa_le_iff (PrimeSpectrum.comap π_a q_bar).asIdeal).mp
      intro x hx
      change π_a x ∈ q_bar.asIdeal
      rw [(Ideal.Quotient.eq_zero_iff_mem).mpr hx]
      exact q_bar.asIdeal.zero_mem
    · intro f hf_avoid
      let f_bar : B_bar := π_a f
      let M_f : Set (PrimeSpectrum B_bar) :=
        {p_bar : PrimeSpectrum B_bar | p_bar.asIdeal ∈ (Ideal.span {f_bar}).minimalPrimes}
      have hMf_fin : M_f.Finite :=
        (Ideal.finite_minimalPrimes_of_isNoetherianRing B_bar (Ideal.span {f_bar})).preimage
          (fun _ _ _ _ h => PrimeSpectrum.ext h)
      refine (hMf_fin.image (PrimeSpectrum.comap π_a)).subset ?_
      rintro p ⟨hp_comap, hf_mem⟩
      have hIa_le_p : I_a ≤ p.asIdeal := (hIa_le_iff p.asIdeal).mpr hp_comap
      let p_bar : Ideal B_bar := Ideal.map π_a p.asIdeal
      have hp_bar_comap : Ideal.comap π_a p_bar = p.asIdeal := by
        rw [Ideal.comap_map_of_surjective' π_a Ideal.Quotient.mk_surjective, Ideal.mk_ker,
          sup_eq_left.mpr hIa_le_p]
      have hp_bar_prime : p_bar.IsPrime := by
        refine ⟨?_, ?_⟩
        · intro htop
          apply p.isPrime.ne_top
          rw [← hp_bar_comap, htop]
          rfl
        · intro z₁ z₂ hz
          obtain ⟨b₁, rfl⟩ := Ideal.Quotient.mk_surjective z₁
          obtain ⟨b₂, rfl⟩ := Ideal.Quotient.mk_surjective z₂
          have hmem : b₁ * b₂ ∈ p.asIdeal := by
            rw [← hp_bar_comap]
            exact hz
          rcases p.isPrime.mem_or_mem hmem with h1 | h2
          · exact Or.inl (Ideal.mem_map_of_mem π_a h1)
          · exact Or.inr (Ideal.mem_map_of_mem π_a h2)
      refine ⟨⟨p_bar, hp_bar_prime⟩, ?_, PrimeSpectrum.ext hp_bar_comap⟩
      change p_bar ∈ (Ideal.span {f_bar}).minimalPrimes
      refine ⟨⟨hp_bar_prime,
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (Ideal.mem_map_of_mem π_a hf_mem))⟩, ?_⟩
      rintro q_bar ⟨hq_bar_p, hspan_le_q⟩ hq_le_p
      rcases hDichot q_bar hq_bar_p with hq_min | hq_max
      · exfalso
        have hq_Smin : PrimeSpectrum.comap π_a ⟨q_bar, hq_bar_p⟩ ∈ S_min :=
          ⟨⟨q_bar, hq_bar_p⟩, hq_min, rfl⟩
        exact hf_avoid _ hq_Smin (hspan_le_q (Ideal.subset_span rfl))
      · exact (hq_max.eq_of_le hp_bar_prime.ne_top hq_le_p).ge
  choose S_min hS_min_fin hS_min_comap hS_zero_fin using hChartFin
  
  let K_sub : ∀ (a : Fin (M + 1)) (p : PrimeSpectrum (A a)),
      Ideal.comap (c_A a) p.asIdeal = IsLocalRing.maximalIdeal ↥V → Submodule k₀ (Fin (M + 1) → k₀) :=
    fun a p hp =>
      let π_ap : A a →+* (A a ⧸ p.asIdeal) := Ideal.Quotient.mk p.asIdeal
      have hker_ap : RingHom.ker q_V ≤ RingHom.ker (π_ap.comp (c_A a)) := by
        intro v hv
        rw [hq_ker, ← hp, Ideal.mem_comap] at hv
        rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
        exact hv
      let ι_ap : k₀ →+* (A a ⧸ p.asIdeal) :=
        q_V.liftOfRightInverseAux σ hσ (π_ap.comp (c_A a)) hker_ap
      { carrier := {w : Fin (M + 1) → k₀ |
          (∑ j : Fin (M + 1), ι_ap (w j) * π_ap (t_A a j)) = 0}
        add_mem' := by
          intro w₁ w₂ hw₁ hw₂
          change (∑ j : Fin (M + 1), ι_ap (w₁ j + w₂ j) * π_ap (t_A a j)) = 0
          have hsplit :
              (∑ j : Fin (M + 1), ι_ap (w₁ j + w₂ j) * π_ap (t_A a j)) =
                (∑ j : Fin (M + 1), ι_ap (w₁ j) * π_ap (t_A a j)) +
                  (∑ j : Fin (M + 1), ι_ap (w₂ j) * π_ap (t_A a j)) := by
            rw [← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_add, add_mul]
          rw [hsplit, hw₁, hw₂, add_zero]
        zero_mem' := by
          change (∑ j : Fin (M + 1), ι_ap 0 * π_ap (t_A a j)) = 0
          simp
        smul_mem' := by
          intro c w hw
          change (∑ j : Fin (M + 1), ι_ap (c * w j) * π_ap (t_A a j)) = 0
          have hmul :
              (∑ j : Fin (M + 1), ι_ap (c * w j) * π_ap (t_A a j)) =
                ι_ap c * (∑ j : Fin (M + 1), ι_ap (w j) * π_ap (t_A a j)) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_mul, mul_assoc]
          rw [hmul, hw, mul_zero] }
  have hK_ne_top : ∀ (a : Fin (M + 1)) (p : PrimeSpectrum (A a))
      (hp : Ideal.comap (c_A a) p.asIdeal = IsLocalRing.maximalIdeal ↥V), K_sub a p hp ≠ ⊤ := by
    intro a p hp htop
    have : IsDomain (A a ⧸ p.asIdeal) := Ideal.Quotient.isDomain p.asIdeal
    have hmem : (Pi.single a (1 : k₀) : Fin (M + 1) → k₀) ∈ K_sub a p hp := by
      rw [htop]
      trivial
    let π_ap : A a →+* (A a ⧸ p.asIdeal) := Ideal.Quotient.mk p.asIdeal
    have hker_ap : RingHom.ker q_V ≤ RingHom.ker (π_ap.comp (c_A a)) := by
      intro v hv
      rw [hq_ker, ← hp, Ideal.mem_comap] at hv
      rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact hv
    let ι_ap : k₀ →+* (A a ⧸ p.asIdeal) :=
      q_V.liftOfRightInverseAux σ hσ (π_ap.comp (c_A a)) hker_ap
    change (∑ j : Fin (M + 1), ι_ap ((Pi.single a (1 : k₀) : Fin (M + 1) → k₀) j) * π_ap (t_A a j)) = 0 at hmem
    rw [Finset.sum_eq_single a] at hmem
    · rw [Pi.single_eq_same, map_one, one_mul, ht_diag a, map_one] at hmem
      exact one_ne_zero hmem
    · intro j _ hja
      rw [Pi.single_eq_of_ne hja, map_zero, zero_mul]
    · intro ha
      exact False.elim (ha (Finset.mem_univ a))
  have hK_iff : ∀ (a : Fin (M + 1)) (p : PrimeSpectrum (A a))
      (hp : Ideal.comap (c_A a) p.asIdeal = IsLocalRing.maximalIdeal ↥V)
      (w : Fin (M + 1) → k₀) (r : Fin (M + 1) → ↥V),
      (∀ j : Fin (M + 1), q_V (r j) = w j) →
      (w ∉ K_sub a p hp ↔ (∑ j : Fin (M + 1), c_A a (r j) * t_A a j) ∉ p.asIdeal) := by
    intro a p hp w r hr
    apply not_congr
    let π_ap : A a →+* (A a ⧸ p.asIdeal) := Ideal.Quotient.mk p.asIdeal
    have hker_ap : RingHom.ker q_V ≤ RingHom.ker (π_ap.comp (c_A a)) := by
      intro v hv
      rw [hq_ker, ← hp, Ideal.mem_comap] at hv
      rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact hv
    let ι_ap : k₀ →+* (A a ⧸ p.asIdeal) :=
      q_V.liftOfRightInverseAux σ hσ (π_ap.comp (c_A a)) hker_ap
    have hι_ap : ∀ v : ↥V, ι_ap (q_V v) = π_ap (c_A a v) :=
      fun v => RingHom.liftOfRightInverseAux_comp_apply q_V σ hσ (π_ap.comp (c_A a)) hker_ap v
    change (∑ j : Fin (M + 1), ι_ap (w j) * π_ap (t_A a j)) = 0 ↔ _
    have hsum_eq :
        (∑ j : Fin (M + 1), ι_ap (w j) * π_ap (t_A a j)) =
          π_ap (∑ j : Fin (M + 1), c_A a (r j) * t_A a j) := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← hr j, hι_ap (r j), map_mul]
    rw [hsum_eq, Ideal.Quotient.eq_zero_iff_mem]
  
  have hFin_Smin : ∀ a : Fin (M + 1), Finite ↥(S_min a) :=
    fun a => (hS_min_fin a).to_subtype
  let fam₀ : Option (Σ a : Fin (M + 1), ↥(S_min a)) → Submodule k₀ (Fin (M + 1) → k₀) :=
    fun idx => match idx with
      | none => K_sub a₀ p₀ hp₀
      | some ⟨a, q⟩ => K_sub a q.1 (hS_min_comap a q.1 q.2)
  have hfam₀_ne_top : ∀ idx, fam₀ idx ≠ ⊤ := by
    rintro (_ | ⟨a, q⟩)
    · exact hK_ne_top a₀ p₀ hp₀
    · exact hK_ne_top a q.1 (hS_min_comap a q.1 q.2)
  obtain ⟨v₀_bar, hv₀_avoid⟩ := Submodule.exists_forall_notMem_of_forall_ne_top fam₀ hfam₀_ne_top
  have hv₀_ne : v₀_bar ≠ 0 := by
    intro h0
    apply hv₀_avoid none
    rw [h0]
    exact (fam₀ none).zero_mem
  let r₀ : Fin (M + 1) → ↥V := fun j => σ (v₀_bar j)
  have hr₀ : ∀ j : Fin (M + 1), q_V (r₀ j) = v₀_bar j := fun j => hσ (v₀_bar j)
  let f₀_chart : ∀ a : Fin (M + 1), A a :=
    fun a => ∑ j : Fin (M + 1), c_A a (r₀ j) * t_A a j
  have hf₀_avoid_Smin : ∀ (a : Fin (M + 1)) (q : PrimeSpectrum (A a)),
      q ∈ S_min a → f₀_chart a ∉ q.asIdeal := by
    intro a q hq
    exact (hK_iff a q (hS_min_comap a q hq) v₀_bar r₀ hr₀).mp (hv₀_avoid (some ⟨a, ⟨q, hq⟩⟩))
  
  let S_zero : ∀ a : Fin (M + 1), Set (PrimeSpectrum (A a)) :=
    fun a => {p : PrimeSpectrum (A a) |
      Ideal.comap (c_A a) p.asIdeal = IsLocalRing.maximalIdeal ↥V ∧ f₀_chart a ∈ p.asIdeal}
  have hFin_Szero : ∀ a : Fin (M + 1), Finite ↥(S_zero a) :=
    fun a => (hS_zero_fin a (f₀_chart a) (hf₀_avoid_Smin a)).to_subtype
  have hSpan_ne_top : Submodule.span k₀ {v₀_bar} ≠ ⊤ := by
    intro htop
    have he₀ : (Pi.single i₀ (1 : k₀) : Fin (M + 1) → k₀) ∈ Submodule.span k₀ {v₀_bar} := by
      rw [htop]
      trivial
    have he₁ : (Pi.single i₁ (1 : k₀) : Fin (M + 1) → k₀) ∈ Submodule.span k₀ {v₀_bar} := by
      rw [htop]
      trivial
    obtain ⟨c₀, hc₀⟩ := Submodule.mem_span_singleton.mp he₀
    obtain ⟨c₁, hc₁⟩ := Submodule.mem_span_singleton.mp he₁
    have hc₀_0 : c₀ * v₀_bar i₀ = 1 := by
      have h := congrFun hc₀ i₀
      simpa [Pi.single_eq_same] using h
    have hc₀_ne : c₀ ≠ 0 := fun h0 => by
      rw [h0, zero_mul] at hc₀_0
      exact zero_ne_one hc₀_0
    have hc₀_1 : c₀ * v₀_bar i₁ = 0 := by
      have h := congrFun hc₀ i₁
      simpa [Pi.single_eq_of_ne hi01.symm] using h
    have hv₀_i₁ : v₀_bar i₁ = 0 := (mul_eq_zero.mp hc₀_1).resolve_left hc₀_ne
    have hc₁_1 : c₁ * v₀_bar i₁ = 1 := by
      have h := congrFun hc₁ i₁
      simpa [Pi.single_eq_same] using h
    rw [hv₀_i₁, mul_zero] at hc₁_1
    exact zero_ne_one hc₁_1
  let fam₁ : (Bool ⊕ (Σ a : Fin (M + 1), ↥(S_zero a))) → Submodule k₀ (Fin (M + 1) → k₀) :=
    fun idx => match idx with
      | Sum.inl false => K_sub a₀ p₀ hp₀
      | Sum.inl true => Submodule.span k₀ {v₀_bar}
      | Sum.inr ⟨a, p⟩ => K_sub a p.1 p.2.1
  have hfam₁_ne_top : ∀ idx, fam₁ idx ≠ ⊤ := by
    rintro ((_ | _) | ⟨a, p⟩)
    · exact hK_ne_top a₀ p₀ hp₀
    · exact hSpan_ne_top
    · exact hK_ne_top a p.1 p.2.1
  obtain ⟨v₁_bar, hv₁_avoid⟩ := Submodule.exists_forall_notMem_of_forall_ne_top fam₁ hfam₁_ne_top
  let r₁ : Fin (M + 1) → ↥V := fun j => σ (v₁_bar j)
  have hr₁ : ∀ j : Fin (M + 1), q_V (r₁ j) = v₁_bar j := fun j => hσ (v₁_bar j)
  
  have hv₁_not_span : v₁_bar ∉ Submodule.span k₀ {v₀_bar} := hv₁_avoid (Sum.inl true)
  have hnot_smul : ∀ c : k₀, c • v₀_bar ≠ v₁_bar :=
    fun c hc => hv₁_not_span (Submodule.mem_span_singleton.mpr ⟨c, hc⟩)
  have hv01_ne : v₀_bar ≠ v₁_bar := by
    intro heq
    exact hnot_smul 1 (by rw [one_smul, heq])
  have hs : LinearIndepOn k₀ id ({v₀_bar, v₁_bar} : Set (Fin (M + 1) → k₀)) :=
    (linearIndepOn_pair_iff id hv01_ne hv₀_ne).mpr hnot_smul
  let B_ext := Module.Basis.extend hs
  let I_ext := ↥(hs.extend (Set.subset_univ _))
  let : Fintype I_ext := FiniteDimensional.fintypeBasisIndex B_ext
  have hcard_eq : Fintype.card I_ext = Fintype.card (Fin (M + 1)) := by
    rw [← Module.finrank_eq_card_basis B_ext,
      ← Module.finrank_eq_card_basis (Pi.basisFun k₀ (Fin (M + 1)))]
  let e₀ : Fin (M + 1) ≃ I_ext := (Fintype.equivOfCardEq hcard_eq).symm
  have hsub_ext : ({v₀_bar, v₁_bar} : Set (Fin (M + 1) → k₀)) ⊆ hs.extend (Set.subset_univ _) :=
    Module.Basis.subset_extend hs
  let x₀_ext : I_ext := ⟨v₀_bar, hsub_ext (Set.mem_insert v₀_bar {v₁_bar})⟩
  let x₁_ext : I_ext := ⟨v₁_bar, hsub_ext (Set.mem_insert_of_mem v₀_bar rfl)⟩
  have hx01_ne : x₀_ext ≠ x₁_ext := fun h => hv01_ne (congrArg Subtype.val h)
  let e₁ : Fin (M + 1) ≃ I_ext := (Equiv.swap i₀ (e₀.symm x₀_ext)).trans e₀
  have he₁_i₀ : e₁ i₀ = x₀_ext := by
    dsimp [e₁]
    rw [Equiv.swap_apply_left, e₀.apply_symm_apply]
  let e₂ : Fin (M + 1) ≃ I_ext := (Equiv.swap i₁ (e₁.symm x₁_ext)).trans e₁
  have he₂_i₁ : e₂ i₁ = x₁_ext := by
    dsimp [e₂]
    rw [Equiv.swap_apply_left, e₁.apply_symm_apply]
  have he₂_i₀ : e₂ i₀ = x₀_ext := by
    dsimp [e₂]
    have hi0_ne_symm : i₀ ≠ e₁.symm x₁_ext := by
      intro h
      apply hx01_ne
      rw [← he₁_i₀, h, e₁.apply_symm_apply]
    rw [Equiv.swap_apply_of_ne_of_ne hi01 hi0_ne_symm, he₁_i₀]
  let B_fin : Module.Basis (Fin (M + 1)) k₀ (Fin (M + 1) → k₀) := B_ext.reindex e₂.symm
  have hB_i₀ : B_fin i₀ = v₀_bar := by
    dsimp [B_fin]
    rw [Module.Basis.reindex_apply, Equiv.symm_symm, he₂_i₀, Module.Basis.extend_apply_self]
  have hB_i₁ : B_fin i₁ = v₁_bar := by
    dsimp [B_fin]
    rw [Module.Basis.reindex_apply, Equiv.symm_symm, he₂_i₁, Module.Basis.extend_apply_self]
  let M_bar : Matrix (Fin (M + 1)) (Fin (M + 1)) k₀ := fun m l => B_fin m l
  let C_mat : Matrix (Fin (M + 1)) (Fin (M + 1)) k₀ :=
    fun j m => (B_fin.repr (Pi.single j (1 : k₀))) m
  have hCM : C_mat * M_bar = 1 := by
    ext j l
    rw [Matrix.mul_apply, Matrix.one_apply]
    have hrepr := congrFun (B_fin.sum_repr (Pi.single j (1 : k₀))) l
    rw [Finset.sum_apply] at hrepr
    dsimp [C_mat, M_bar]
    have hsum_eq :
        (∑ m : Fin (M + 1), (B_fin.repr (Pi.single j (1 : k₀))) m * B_fin m l) =
          (Pi.single j (1 : k₀) : Fin (M + 1) → k₀) l := by
      simpa [Pi.smul_apply, smul_eq_mul] using hrepr
    rw [hsum_eq, Pi.single_apply]
    by_cases hlj : l = j
    · subst hlj
      simp
    · simp [hlj, Ne.symm hlj]
  have hM_det_ne : M_bar.det ≠ 0 := by
    intro h0
    have hdet := congrArg Matrix.det hCM
    rw [Matrix.det_mul, h0, mul_zero, Matrix.det_one] at hdet
    exact zero_ne_one hdet
  let A_mat : Matrix (Fin (M + 1)) (Fin (M + 1)) ↥V :=
    fun i j => if i = i₀ then r₀ j else if i = i₁ then r₁ j else σ (M_bar i j)
  have hA_row0 : ∀ j : Fin (M + 1), A_mat i₀ j = r₀ j := by
    intro j
    simp [A_mat]
  have hA_row1 : ∀ j : Fin (M + 1), A_mat i₁ j = r₁ j := by
    intro j
    simp [A_mat, hi01.symm]
  have hmap_A : q_V.mapMatrix A_mat = M_bar := by
    ext i j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply]
    by_cases hi0 : i = i₀
    · subst hi0
      simp [A_mat, hr₀ j, M_bar, hB_i₀]
    · by_cases hi1 : i = i₁
      · subst hi1
        simp [A_mat, hi0, hr₁ j, M_bar, hB_i₁]
      · simp [A_mat, hi0, hi1, hσ (M_bar i j)]
  have hdet_unit : IsUnit A_mat.det := by
    apply IsLocalRing.notMem_maximalIdeal.mp
    rw [← hq_ker, RingHom.mem_ker, RingHom.map_det, hmap_A]
    exact hM_det_ne
  let B_mat : Matrix (Fin (M + 1)) (Fin (M + 1)) ↥V := A_mat⁻¹
  refine ⟨A_mat, B_mat, Matrix.mul_nonsing_inv A_mat hdet_unit,
    Matrix.nonsing_inv_mul A_mat hdet_unit, ?_, ?_, ?_⟩
  · simp_rw [show (⟨0, by omega⟩ : Fin (M + 1)) = i₀ from rfl, hA_row0]
    exact (hK_iff a₀ p₀ hp₀ v₀_bar r₀ hr₀).mp (hv₀_avoid none)
  · simp_rw [show (⟨1, by omega⟩ : Fin (M + 1)) = i₁ from rfl, hA_row1]
    exact (hK_iff a₀ p₀ hp₀ v₁_bar r₁ hr₁).mp (hv₁_avoid (Sum.inl false))
  · intro a p hp
    simp_rw [show (⟨0, by omega⟩ : Fin (M + 1)) = i₀ from rfl, hA_row0,
      show (⟨1, by omega⟩ : Fin (M + 1)) = i₁ from rfl, hA_row1]
    by_cases hf_in : f₀_chart a ∈ p.asIdeal
    · right
      have hp_zero : p ∈ S_zero a := ⟨hp, hf_in⟩
      exact (hK_iff a p hp v₁_bar r₁ hr₁).mp (hv₁_avoid (Sum.inr ⟨a, ⟨p, hp_zero⟩⟩))
    · left
      exact hf_in

theorem weil_commRing_projSpace_invertible_matrix_automorphism (R : Type u) [CommRing R] (M : ℕ)
    (hAff : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R M a))
    (c_R : ∀ a : Fin (M + 1),
      R →+* ↑((weilProjectiveSpaceOver R M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R M a))))
    (t_R : ∀ a : Fin (M + 1), Fin (M + 1) →
      ↑((weilProjectiveSpaceOver R M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R M a))))
    (hCoord : IsCommRingProjCoordSystem R M hAff c_R t_R)
    (A B : Matrix (Fin (M + 1)) (Fin (M + 1)) R)
    (hAB : A * B = 1) (hBA : B * A = 1) :
    ∃ (Φ : (weilProjectiveSpaceOver R M).left ≅ (weilProjectiveSpaceOver R M).left),
      Φ.hom ≫ (weilProjectiveSpaceOver R M).hom = (weilProjectiveSpaceOver R M).hom ∧
      ∀ b i : Fin (M + 1),
        (weilProjectiveSpaceOver R M).left.basicOpen
          (∑ j : Fin (M + 1), c_R b (A i j) * t_R b j) ≤
          (TopologicalSpace.Opens.map Φ.hom.base).obj (weilProjBasicOpen R M i) :=
by
  obtain ⟨_hProp, hSup_D0, hSpec_c0, _hPoly, ht_diag0, hGen0, hUniv0, hInter0, hc_res0, ht_res0⟩ := hCoord
  have hMain : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (π : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (D : Fin (M + 1) → X.Opens)
      (hAffX : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (D a))
      (c_X : ∀ a : Fin (M + 1), R →+* ↑(X.presheaf.obj (Opposite.op (D a))))
      (t_X : ∀ a : Fin (M + 1), Fin (M + 1) → ↑(X.presheaf.obj (Opposite.op (D a)))),
      (⨆ a : Fin (M + 1), D a) = ⊤ →
      (∀ a : Fin (M + 1),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_X a)) = (hAffX a).fromSpec ≫ π) →
      (∀ a : Fin (M + 1), t_X a a = 1) →
      (∀ a : Fin (M + 1), Subring.closure (Set.range (c_X a) ∪ Set.range (t_X a)) = ⊤) →
      (∀ (a : Fin (M + 1)) (S : Type u) [CommRing S] (ρ : R →+* S) (v : Fin (M + 1) → S),
        v a = 1 →
        ∃ (ψ : ↑(X.presheaf.obj (Opposite.op (D a))) →+* S),
          ψ.comp (c_X a) = ρ ∧ ∀ k : Fin (M + 1), ψ (t_X a k) = v k) →
      (∀ a a' : Fin (M + 1), X.basicOpen (t_X a a') = D a ⊓ D a') →
      (∀ (a a' : Fin (M + 1)) (r : R),
        (X.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (c_X a' r) =
        (X.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (c_X a r)) →
      (∀ (a a' k : Fin (M + 1)),
        (X.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (t_X a' k) *
        (X.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (t_X a a') =
        (X.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (t_X a k)) →
      ∃ (Φ : X ≅ X),
        Φ.hom ≫ π = π ∧
        ∀ b i : Fin (M + 1),
          X.basicOpen (∑ j : Fin (M + 1), c_X b (A i j) * t_X b j) ≤
            (TopologicalSpace.Opens.map Φ.hom.base).obj (D i) := by
    intro X π D hAffX c_X t_X hSup_D hSpec_c ht_diag hGen hUniv hInter hc_res ht_res
    let u : Matrix (Fin (M + 1)) (Fin (M + 1)) R → ∀ b : Fin (M + 1), Fin (M + 1) →
        ↑(X.presheaf.obj (Opposite.op (D b))) :=
      fun M_mat b i => ∑ j : Fin (M + 1), c_X b (M_mat i j) * t_X b j
    have hResComp : ∀ {V₁ V₂ V₃ : X.Opens} (h12 : V₁ ≤ V₂) (h23 : V₂ ≤ V₃)
        (s : ↑(X.presheaf.obj (Opposite.op V₃))),
        (X.presheaf.map (CategoryTheory.homOfLE h12).op).hom
          ((X.presheaf.map (CategoryTheory.homOfLE h23).op).hom s) =
        (X.presheaf.map (CategoryTheory.homOfLE (h12.trans h23)).op).hom s := by
      intro V₁ V₂ V₃ h12 h23 s
      have hmor : CategoryTheory.homOfLE h12 ≫ CategoryTheory.homOfLE h23 =
          CategoryTheory.homOfLE (h12.trans h23) := CategoryTheory.homOfLE_comp h12 h23
      have hmap : X.presheaf.map (CategoryTheory.homOfLE (h12.trans h23)).op =
          X.presheaf.map (CategoryTheory.homOfLE h23).op ≫
            X.presheaf.map (CategoryTheory.homOfLE h12).op := by
        rw [← hmor, CategoryTheory.op_comp, X.presheaf.map_comp]
      exact (congrArg (fun φ => φ.hom s) hmap).symm
    have hRingExt : ∀ (a : Fin (M + 1)) {S : Type u} [CommRing S]
        (φ₁ φ₂ : ↑(X.presheaf.obj (Opposite.op (D a))) →+* S),
        (∀ r : R, φ₁ (c_X a r) = φ₂ (c_X a r)) →
        (∀ k : Fin (M + 1), φ₁ (t_X a k) = φ₂ (t_X a k)) →
        φ₁ = φ₂ := by
      intro a S _ φ₁ φ₂ hc ht
      have hSub : Set.range (c_X a) ∪ Set.range (t_X a) ⊆ (RingHom.eqLocus φ₁ φ₂ : Set _) := by
        rintro x (⟨r, rfl⟩ | ⟨k, rfl⟩)
        · exact hc r
        · exact ht k
      have hTop : (⊤ : Subring ↑(X.presheaf.obj (Opposite.op (D a)))) ≤ RingHom.eqLocus φ₁ φ₂ := by
        rw [← hGen a]
        exact Subring.closure_le.mpr hSub
      exact RingHom.ext fun x => hTop trivial
    have hHomOfLE_isoSpec : ∀ {V₁ V₂ : X.Opens}
        (h1 : AlgebraicGeometry.IsAffineOpen V₁)
        (h2 : AlgebraicGeometry.IsAffineOpen V₂) (hle : V₁ ≤ V₂),
        X.homOfLE hle ≫ h2.isoSpec.hom =
          h1.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (X.presheaf.map (CategoryTheory.homOfLE hle).op) := by
      intro V₁ V₂ h1 h2 hle
      have : AlgebraicGeometry.IsOpenImmersion h2.fromSpec := h2.isOpenImmersion_fromSpec
      apply (CategoryTheory.cancel_mono h2.fromSpec).mp
      rw [CategoryTheory.Category.assoc, h2.isoSpec_hom_fromSpec, X.homOfLE_ι hle,
        CategoryTheory.Category.assoc, h2.map_fromSpec h1 (CategoryTheory.homOfLE hle).op,
        h1.isoSpec_hom_fromSpec]
    have hMatRowSum : ∀ {S : Type u} [CommRing S]
        (A' B' : Matrix (Fin (M + 1)) (Fin (M + 1)) R) (hBA' : B' * A' = 1)
        (γ : R →+* S) (τ : Fin (M + 1) → S) (m : Fin (M + 1)),
        (∑ k : Fin (M + 1), γ (B' m k) * (∑ j : Fin (M + 1), γ (A' k j) * τ j)) = τ m := by
      intro S _ A' B' hBA' γ τ m
      calc
        (∑ k : Fin (M + 1), γ (B' m k) * (∑ j : Fin (M + 1), γ (A' k j) * τ j))
            = ∑ k : Fin (M + 1), ∑ j : Fin (M + 1), (γ (B' m k) * γ (A' k j)) * τ j := by
              refine Finset.sum_congr rfl fun k _ => ?_
              rw [Finset.mul_sum]
              exact Finset.sum_congr rfl fun j _ => (mul_assoc _ _ _).symm
        _ = ∑ j : Fin (M + 1), ∑ k : Fin (M + 1), (γ (B' m k) * γ (A' k j)) * τ j :=
              Finset.sum_comm
        _ = ∑ j : Fin (M + 1), γ ((B' * A') m j) * τ j := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [← Finset.sum_mul, Matrix.mul_apply, map_sum]
              congr 1
              exact Finset.sum_congr rfl fun k _ => (map_mul γ _ _).symm
        _ = ∑ j : Fin (M + 1), γ ((1 : Matrix (Fin (M + 1)) (Fin (M + 1)) R) m j) * τ j := by
              rw [hBA']
        _ = ∑ j : Fin (M + 1), (if m = j then τ j else 0) := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [Matrix.one_apply]
              split_ifs <;> simp
        _ = τ m := by simp
    have hConstruct : ∀ (A' B' : Matrix (Fin (M + 1)) (Fin (M + 1)) R),
        B' * A' = 1 →
        ∃ (Φ : X ⟶ X),
          Φ ≫ π = π ∧
          (∀ b i : Fin (M + 1),
            X.basicOpen (u A' b i) ≤ (TopologicalSpace.Opens.map Φ.base).obj (D i)) ∧
          ((⨆ p : Fin (M + 1) × Fin (M + 1), X.basicOpen (u A' p.1 p.2)) = ⊤) ∧
          (∀ b i : Fin (M + 1),
            let U_bi : X.Opens := X.basicOpen (u A' b i)
            let res_bi := (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le (u A' b i))).op).hom
            ∃ ψ : ↑(X.presheaf.obj (Opposite.op (D i))) →+* ↑(X.presheaf.obj (Opposite.op U_bi)),
              U_bi.ι ≫ Φ =
                ((hAffX b).basicOpen (u A' b i)).isoSpec.hom ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
                  (hAffX i).fromSpec ∧
              (∀ r : R, ψ (c_X i r) = res_bi (c_X b r)) ∧
              (∀ k : Fin (M + 1), ψ (t_X i k) * res_bi (u A' b i) = res_bi (u A' b k))) := by
      intro A' B' hBA'
      let U : Fin (M + 1) → Fin (M + 1) → X.Opens := fun b i => X.basicOpen (u A' b i)
      let hAff_U : ∀ b i : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (U b i) :=
        fun b i => (hAffX b).basicOpen (u A' b i)
      have hCocycle : ∀ (b b' : Fin (M + 1)) (W : X.Opens) (hWb : W ≤ D b) (hWb' : W ≤ D b'),
          IsUnit ((X.presheaf.map (CategoryTheory.homOfLE hWb).op).hom (t_X b b')) ∧
          (∀ r : R,
            (X.presheaf.map (CategoryTheory.homOfLE hWb').op).hom (c_X b' r) =
              (X.presheaf.map (CategoryTheory.homOfLE hWb).op).hom (c_X b r)) ∧
          (∀ m : Fin (M + 1),
            (X.presheaf.map (CategoryTheory.homOfLE hWb').op).hom (u A' b' m) *
              (X.presheaf.map (CategoryTheory.homOfLE hWb).op).hom (t_X b b') =
              (X.presheaf.map (CategoryTheory.homOfLE hWb).op).hom (u A' b m)) := by
        intro b b' W hWb hWb'
        let hW_inf : W ≤ D b ⊓ D b' := le_inf hWb hWb'
        let α_inf := (X.presheaf.map (CategoryTheory.homOfLE hW_inf).op).hom
        have hW_bo : W ≤ X.basicOpen (t_X b b') := by
          rw [hInter b b']
          exact hW_inf
        have hUnit : IsUnit ((X.presheaf.map (CategoryTheory.homOfLE hWb).op).hom (t_X b b')) := by
          have h0 : IsUnit ((X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le (t_X b b'))).op).hom
              (t_X b b')) :=
            X.toRingedSpace.isUnit_res_basicOpen (t_X b b')
          have h1 := h0.map (X.presheaf.map (CategoryTheory.homOfLE hW_bo).op).hom
          rwa [hResComp hW_bo (X.basicOpen_le (t_X b b')) (t_X b b')] at h1
        have hc_eq : ∀ r : R,
            (X.presheaf.map (CategoryTheory.homOfLE hWb').op).hom (c_X b' r) =
              (X.presheaf.map (CategoryTheory.homOfLE hWb).op).hom (c_X b r) := by
          intro r
          rw [← hResComp hW_inf (inf_le_right : D b ⊓ D b' ≤ D b') (c_X b' r),
            ← hResComp hW_inf (inf_le_left : D b ⊓ D b' ≤ D b) (c_X b r)]
          exact congrArg α_inf (hc_res b b' r)
        have ht_eq : ∀ j : Fin (M + 1),
            (X.presheaf.map (CategoryTheory.homOfLE hWb').op).hom (t_X b' j) *
              (X.presheaf.map (CategoryTheory.homOfLE hWb).op).hom (t_X b b') =
              (X.presheaf.map (CategoryTheory.homOfLE hWb).op).hom (t_X b j) := by
          intro j
          rw [← hResComp hW_inf (inf_le_right : D b ⊓ D b' ≤ D b') (t_X b' j),
            ← hResComp hW_inf (inf_le_left : D b ⊓ D b' ≤ D b) (t_X b b'),
            ← hResComp hW_inf (inf_le_left : D b ⊓ D b' ≤ D b) (t_X b j),
            ← map_mul α_inf]
          exact congrArg α_inf (ht_res b b' j)
        refine ⟨hUnit, hc_eq, ?_⟩
        intro m
        dsimp only [u]
        rw [map_sum, map_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, map_mul, hc_eq (A' m j), mul_assoc, ht_eq j]
      have hAffInter : ∀ b i b' i' : Fin (M + 1),
          AlgebraicGeometry.IsAffineOpen (U b i ⊓ U b' i') := by
        intro b i b' i'
        let V : X.Opens := D b ⊓ D b'
        let res_VL := (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V ≤ D b)).op).hom
        let res_VR := (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V ≤ D b')).op).hom
        obtain ⟨hUnit_V, _, hu_V⟩ := hCocycle b b' V inf_le_left inf_le_right
        have hAbsorb : U b i ⊓ U b' i' = U b i ⊓ (V ⊓ U b' i') := by
          apply le_antisymm
          · exact le_inf inf_le_left (le_inf (le_inf (inf_le_left.trans (X.basicOpen_le _))
              (inf_le_right.trans (X.basicOpen_le _))) inf_le_right)
          · exact le_inf inf_le_left (inf_le_right.trans inf_le_right)
        have hVU : V ⊓ U b' i' = X.basicOpen (t_X b b' * u A' b i') := by
          have hV_unit : X.basicOpen (res_VL (t_X b b')) = V :=
            X.toRingedSpace.basicOpen_of_isUnit hUnit_V
          calc
            V ⊓ U b' i'
                = X.basicOpen (res_VR (u A' b' i')) :=
                  (X.basicOpen_res (u A' b' i') (CategoryTheory.homOfLE (inf_le_right : V ≤ D b')).op).symm
            _ = X.basicOpen (res_VR (u A' b' i')) ⊓ V :=
                  (inf_eq_left.mpr (X.basicOpen_le _)).symm
            _ = X.basicOpen (res_VR (u A' b' i')) ⊓ X.basicOpen (res_VL (t_X b b')) :=
                  congrArg (X.basicOpen (res_VR (u A' b' i')) ⊓ ·) hV_unit.symm
            _ = X.basicOpen (res_VR (u A' b' i') * res_VL (t_X b b')) :=
                  (X.basicOpen_mul _ _).symm
            _ = X.basicOpen (res_VL (u A' b i')) := by
                  rw [hu_V i']
            _ = V ⊓ X.basicOpen (u A' b i') :=
                  X.basicOpen_res (u A' b i') (CategoryTheory.homOfLE (inf_le_left : V ≤ D b)).op
            _ = X.basicOpen (t_X b b') ⊓ X.basicOpen (u A' b i') :=
                  congrArg (· ⊓ X.basicOpen (u A' b i')) (hInter b b').symm
            _ = X.basicOpen (t_X b b' * u A' b i') :=
                  (X.basicOpen_mul _ _).symm
        have hEqBasic : U b i ⊓ U b' i' = X.basicOpen (u A' b i * (t_X b b' * u A' b i')) := by
          rw [hAbsorb, hVU, ← X.basicOpen_mul]
        rw [hEqBasic]
        exact (hAffX b).basicOpen _
      have hSup : (⨆ p : Fin (M + 1) × Fin (M + 1), U p.1 p.2) = ⊤ := by
        have hCov_b : ∀ b : Fin (M + 1), (⨆ i : Fin (M + 1), U b i) = D b := by
          intro b
          have hOne : (∑ i : Fin (M + 1), c_X b (B' b i) * u A' b i) = 1 := by
            dsimp only [u]
            rw [hMatRowSum A' B' hBA' (c_X b) (t_X b) b, ht_diag b]
          have hSpan : Ideal.span (Set.range (u A' b)) = ⊤ := by
            rw [Ideal.eq_top_iff_one, ← hOne]
            exact Ideal.sum_mem _ fun i _ =>
              Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
          have hRange : (⨆ f : ↥(Set.range (u A' b)), X.basicOpen f.1) = D b :=
            ((hAffX b).iSup_basicOpen_eq_self_iff (s := Set.range (u A' b))).mpr hSpan
          have hEqSup : (⨆ i : Fin (M + 1), U b i) =
              (⨆ f : ↥(Set.range (u A' b)), X.basicOpen f.1) := by
            apply le_antisymm
            · exact iSup_le fun i => le_iSup_of_le ⟨u A' b i, ⟨i, rfl⟩⟩ le_rfl
            · refine iSup_le ?_
              rintro ⟨_, ⟨i, rfl⟩⟩
              exact le_iSup (U b) i
          exact hEqSup.trans hRange
        rw [eq_top_iff, ← hSup_D]
        refine iSup_le fun b => ?_
        rw [← hCov_b b]
        exact iSup_le fun i =>
          le_iSup (fun p : Fin (M + 1) × Fin (M + 1) => U p.1 p.2) (b, i)
      let res_U : ∀ b i : Fin (M + 1),
          ↑(X.presheaf.obj (Opposite.op (D b))) →+* ↑(X.presheaf.obj (Opposite.op (U b i))) :=
        fun b i => (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le (u A' b i))).op).hom
      have hu_unit : ∀ b i : Fin (M + 1), IsUnit (res_U b i (u A' b i)) :=
        fun b i => X.toRingedSpace.isUnit_res_basicOpen (u A' b i)
      let inv_u : ∀ b i : Fin (M + 1), ↑(X.presheaf.obj (Opposite.op (U b i))) :=
        fun b i => ↑((hu_unit b i).unit⁻¹)
      have h_mul_inv : ∀ b i : Fin (M + 1), res_U b i (u A' b i) * inv_u b i = 1 :=
        fun b i => (hu_unit b i).mul_val_inv
      have h_inv_mul : ∀ b i : Fin (M + 1), inv_u b i * res_U b i (u A' b i) = 1 :=
        fun b i => (hu_unit b i).val_inv_mul
      have hψ_ex : ∀ b i : Fin (M + 1),
          ∃ ψ : ↑(X.presheaf.obj (Opposite.op (D i))) →+* ↑(X.presheaf.obj (Opposite.op (U b i))),
            ψ.comp (c_X i) = (res_U b i).comp (c_X b) ∧
            ∀ k : Fin (M + 1), ψ (t_X i k) = res_U b i (u A' b k) * inv_u b i :=
        fun b i => hUniv i (↑(X.presheaf.obj (Opposite.op (U b i))))
          ((res_U b i).comp (c_X b)) (fun k => res_U b i (u A' b k) * inv_u b i) (h_mul_inv b i)
      choose ψ hψ_c_comp hψ_t using hψ_ex
      have hψ_c : ∀ (b i : Fin (M + 1)) (r : R), ψ b i (c_X i r) = res_U b i (c_X b r) :=
        fun b i r => congrArg (fun φ => φ r) (hψ_c_comp b i)
      have hψ_rel : ∀ (b i k : Fin (M + 1)),
          ψ b i (t_X i k) * res_U b i (u A' b i) = res_U b i (u A' b k) := by
        intro b i k
        rw [hψ_t b i k, mul_assoc, h_inv_mul b i, mul_one]
      let f : ∀ p : Fin (M + 1) × Fin (M + 1), (U p.1 p.2).toScheme ⟶ X := fun p =>
        (hAff_U p.1 p.2).isoSpec.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ p.1 p.2)) ≫
          (hAffX p.2).fromSpec
      let 𝒰 := X.openCoverOfIsOpenCover
        (fun p : Fin (M + 1) × Fin (M + 1) => U p.1 p.2) (TopologicalSpace.IsOpenCover.mk hSup)
      have hf : ∀ p q : Fin (M + 1) × Fin (M + 1),
          CategoryTheory.Limits.pullback.fst (𝒰.f p) (𝒰.f q) ≫ f p =
            CategoryTheory.Limits.pullback.snd (𝒰.f p) (𝒰.f q) ≫ f q := by
        rintro ⟨b, i⟩ ⟨b', i'⟩
        change CategoryTheory.Limits.pullback.fst (U b i).ι (U b' i').ι ≫ f (b, i) =
          CategoryTheory.Limits.pullback.snd (U b i).ι (U b' i').ι ≫ f (b', i')
        have hPB := AlgebraicGeometry.isPullback_opens_inf (U b i) (U b' i')
        apply (CategoryTheory.Iso.cancel_iso_hom_left hPB.isoPullback _ _).mp
        rw [hPB.isoPullback_hom_fst_assoc, hPB.isoPullback_hom_snd_assoc]
        let W : X.Opens := U b i ⊓ U b' i'
        let hAff_W : AlgebraicGeometry.IsAffineOpen W := hAffInter b i b' i'
        let hWb : W ≤ D b := (inf_le_left : W ≤ U b i).trans (X.basicOpen_le _)
        let hWb' : W ≤ D b' := (inf_le_right : W ≤ U b' i').trans (X.basicOpen_le _)
        let α_b := (X.presheaf.map (CategoryTheory.homOfLE hWb).op).hom
        let α_b' := (X.presheaf.map (CategoryTheory.homOfLE hWb').op).hom
        let res_LW := (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W ≤ U b i)).op).hom
        let res_RW := (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W ≤ U b' i')).op).hom
        have hα_L : ∀ s, res_LW (res_U b i s) = α_b s :=
          fun s => hResComp (inf_le_left : W ≤ U b i) (X.basicOpen_le (u A' b i)) s
        have hα_R : ∀ s, res_RW (res_U b' i' s) = α_b' s :=
          fun s => hResComp (inf_le_right : W ≤ U b' i') (X.basicOpen_le (u A' b' i')) s
        let φ_L : ↑(X.presheaf.obj (Opposite.op (D i))) →+* ↑(X.presheaf.obj (Opposite.op W)) :=
          res_LW.comp (ψ b i)
        let φ_R : ↑(X.presheaf.obj (Opposite.op (D i'))) →+* ↑(X.presheaf.obj (Opposite.op W)) :=
          res_RW.comp (ψ b' i')
        obtain ⟨hUnit_lam, hc_W, hu_W⟩ := hCocycle b b' W hWb hWb'
        let inv_lam : ↑(X.presheaf.obj (Opposite.op W)) := ↑(hUnit_lam.unit⁻¹)
        have hlam_mul : α_b (t_X b b') * inv_lam = 1 := hUnit_lam.mul_val_inv
        have hu_L_mul : α_b (u A' b i) * res_LW (inv_u b i) = 1 := by
          rw [← hα_L (u A' b i), ← map_mul, h_mul_inv b i, map_one]
        have hu_R_mul : α_b' (u A' b' i') * res_RW (inv_u b' i') = 1 := by
          rw [← hα_R (u A' b' i'), ← map_mul, h_mul_inv b' i', map_one]
        let inv_φ : ↑(X.presheaf.obj (Opposite.op W)) :=
          res_RW (inv_u b' i') * inv_lam * α_b (u A' b i)
        have hφ_mul_one : φ_L (t_X i i') * inv_φ = 1 := by
          have hφ_val : φ_L (t_X i i') = (α_b' (u A' b' i') * α_b (t_X b b')) * res_LW (inv_u b i) := by
            change res_LW (ψ b i (t_X i i')) = _
            rw [hψ_t b i i', map_mul, hα_L (u A' b i'), ← hu_W i']
          rw [hφ_val]
          dsimp only [inv_φ]
          calc
            ((α_b' (u A' b' i') * α_b (t_X b b')) * res_LW (inv_u b i)) *
                (res_RW (inv_u b' i') * inv_lam * α_b (u A' b i))
                = (α_b' (u A' b' i') * res_RW (inv_u b' i')) *
                    (α_b (t_X b b') * inv_lam) *
                    (α_b (u A' b i) * res_LW (inv_u b i)) := by ring
            _ = 1 * 1 * 1 := by rw [hu_R_mul, hlam_mul, hu_L_mul]
            _ = 1 := by ring
        have hUnit_φ : IsUnit (φ_L (t_X i i')) :=
          ⟨⟨φ_L (t_X i i'), inv_φ, hφ_mul_one, (mul_comm _ _).trans hφ_mul_one⟩, rfl⟩
        let Z : X.Opens := X.basicOpen (t_X i i')
        let hAff_Z : AlgebraicGeometry.IsAffineOpen Z := (hAffX i).basicOpen (t_X i i')
        let β_i : ↑(X.presheaf.obj (Opposite.op (D i))) →+* ↑(X.presheaf.obj (Opposite.op Z)) :=
          (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le (t_X i i'))).op).hom
        have : IsLocalization.Away (t_X i i') ↑(X.presheaf.obj (Opposite.op Z)) :=
          (hAffX i).isLocalization_basicOpen (t_X i i')
        let θ : ↑(X.presheaf.obj (Opposite.op Z)) →+* ↑(X.presheaf.obj (Opposite.op W)) :=
          IsLocalization.Away.lift (S := ↑(X.presheaf.obj (Opposite.op Z))) (t_X i i') hUnit_φ
        have hθ_L : θ.comp β_i = φ_L :=
          RingHom.ext fun x =>
            IsLocalization.Away.lift_eq (S := ↑(X.presheaf.obj (Opposite.op Z))) (t_X i i') hUnit_φ x
        let hZ_inf : Z ≤ D i ⊓ D i' := (hInter i i').le
        let hZ_i' : Z ≤ D i' := hZ_inf.trans inf_le_right
        let β_i' : ↑(X.presheaf.obj (Opposite.op (D i'))) →+* ↑(X.presheaf.obj (Opposite.op Z)) :=
          (X.presheaf.map (CategoryTheory.homOfLE hZ_i').op).hom
        obtain ⟨_, hc_Z, _⟩ := hCocycle i i' Z (X.basicOpen_le (t_X i i')) hZ_i'
        have ht_Z : ∀ k : Fin (M + 1), β_i' (t_X i' k) * β_i (t_X i i') = β_i (t_X i k) := by
          intro k
          let α_Z_inf := (X.presheaf.map (CategoryTheory.homOfLE hZ_inf).op).hom
          have h1 : β_i' (t_X i' k) =
              α_Z_inf ((X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D i ⊓ D i' ≤ D i')).op).hom
                (t_X i' k)) :=
            (hResComp hZ_inf (inf_le_right : D i ⊓ D i' ≤ D i') (t_X i' k)).symm
          have h2 : β_i (t_X i i') =
              α_Z_inf ((X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D i ⊓ D i' ≤ D i)).op).hom
                (t_X i i')) :=
            (hResComp hZ_inf (inf_le_left : D i ⊓ D i' ≤ D i) (t_X i i')).symm
          have h3 : β_i (t_X i k) =
              α_Z_inf ((X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D i ⊓ D i' ≤ D i)).op).hom
                (t_X i k)) :=
            (hResComp hZ_inf (inf_le_left : D i ⊓ D i' ≤ D i) (t_X i k)).symm
          rw [h1, h2, h3, ← map_mul α_Z_inf]
          exact congrArg α_Z_inf (ht_res i i' k)
        have hθ_R : θ.comp β_i' = φ_R := by
          apply hRingExt i'
          · intro r
            change θ (β_i' (c_X i' r)) = res_RW (ψ b' i' (c_X i' r))
            rw [hc_Z r, show θ (β_i (c_X i r)) = φ_L (c_X i r) from
              congrArg (fun γ => γ (c_X i r)) hθ_L]
            change res_LW (ψ b i (c_X i r)) = res_RW (ψ b' i' (c_X i' r))
            rw [hψ_c b i r, hψ_c b' i' r, hα_L, hα_R, hc_W r]
          · intro k
            change θ (β_i' (t_X i' k)) = res_RW (ψ b' i' (t_X i' k))
            have hθ_unit : θ (β_i (t_X i i')) * inv_φ = 1 := by
              rw [show θ (β_i (t_X i i')) = φ_L (t_X i i') from
                congrArg (fun γ => γ (t_X i i')) hθ_L]
              exact hφ_mul_one
            have hφ_k : φ_L (t_X i k) =
                (α_b' (u A' b' k) * α_b (t_X b b')) * res_LW (inv_u b i) := by
              change res_LW (ψ b i (t_X i k)) = _
              rw [hψ_t b i k, map_mul, hα_L (u A' b k), ← hu_W k]
            calc
              θ (β_i' (t_X i' k))
                  = θ (β_i' (t_X i' k)) * (θ (β_i (t_X i i')) * inv_φ) := by
                      rw [hθ_unit, mul_one]
              _ = (θ (β_i' (t_X i' k)) * θ (β_i (t_X i i'))) * inv_φ := by ring
              _ = θ (β_i' (t_X i' k) * β_i (t_X i i')) * inv_φ := by rw [← map_mul]
              _ = θ (β_i (t_X i k)) * inv_φ := by rw [ht_Z k]
              _ = φ_L (t_X i k) * inv_φ := by
                    rw [show θ (β_i (t_X i k)) = φ_L (t_X i k) from
                      congrArg (fun γ => γ (t_X i k)) hθ_L]
              _ = ((α_b' (u A' b' k) * α_b (t_X b b')) * res_LW (inv_u b i)) *
                    (res_RW (inv_u b' i') * inv_lam * α_b (u A' b i)) := by
                    rw [hφ_k]
              _ = α_b' (u A' b' k) * (α_b (t_X b b') * inv_lam) *
                    (α_b (u A' b i) * res_LW (inv_u b i)) * res_RW (inv_u b' i') := by ring
              _ = α_b' (u A' b' k) * 1 * 1 * res_RW (inv_u b' i') := by
                    rw [hlam_mul, hu_L_mul]
              _ = α_b' (u A' b' k) * res_RW (inv_u b' i') := by ring
              _ = res_RW (ψ b' i' (t_X i' k)) := by
                    rw [hψ_t b' i' k, map_mul, hα_R (u A' b' k)]
        have hLHS : X.homOfLE (inf_le_left : W ≤ U b i) ≫ f (b, i) =
            hAff_W.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
              hAff_Z.fromSpec := by
          have hcompL : CommRingCat.ofHom (ψ b i) ≫
              X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W ≤ U b i)).op =
              CommRingCat.ofHom β_i ≫ CommRingCat.ofHom θ := by
            rw [← CommRingCat.ofHom_comp, hθ_L]
            rfl
          have hmapZ_i : AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_i) ≫ (hAffX i).fromSpec =
              hAff_Z.fromSpec :=
            (hAffX i).map_fromSpec hAff_Z (CategoryTheory.homOfLE (X.basicOpen_le (t_X i i'))).op
          calc
            X.homOfLE (inf_le_left : W ≤ U b i) ≫ f (b, i)
                = (X.homOfLE (inf_le_left : W ≤ U b i) ≫ (hAff_U b i).isoSpec.hom) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ b i)) ≫ (hAffX i).fromSpec := by
                  dsimp only [f]
                  simp only [CategoryTheory.Category.assoc]
            _ = hAff_W.isoSpec.hom ≫
                  (AlgebraicGeometry.Spec.map
                      (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W ≤ U b i)).op) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ b i))) ≫
                  (hAffX i).fromSpec := by
                  rw [hHomOfLE_isoSpec hAff_W (hAff_U b i) inf_le_left]
                  simp only [CategoryTheory.Category.assoc]
            _ = hAff_W.isoSpec.hom ≫
                  AlgebraicGeometry.Spec.map
                    (CommRingCat.ofHom (ψ b i) ≫
                      X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W ≤ U b i)).op) ≫
                  (hAffX i).fromSpec := by
                  rw [← AlgebraicGeometry.Spec.map_comp]
            _ = hAff_W.isoSpec.hom ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_i) ≫ (hAffX i).fromSpec) := by
                  rw [hcompL, AlgebraicGeometry.Spec.map_comp]
                  simp only [CategoryTheory.Category.assoc]
            _ = hAff_W.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
                  hAff_Z.fromSpec := by
                  rw [hmapZ_i]
        have hRHS : X.homOfLE (inf_le_right : W ≤ U b' i') ≫ f (b', i') =
            hAff_W.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
              hAff_Z.fromSpec := by
          have hcompR : CommRingCat.ofHom (ψ b' i') ≫
              X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W ≤ U b' i')).op =
              CommRingCat.ofHom β_i' ≫ CommRingCat.ofHom θ := by
            rw [← CommRingCat.ofHom_comp, hθ_R]
            rfl
          have hmapZ_i' : AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_i') ≫ (hAffX i').fromSpec =
              hAff_Z.fromSpec :=
            (hAffX i').map_fromSpec hAff_Z (CategoryTheory.homOfLE hZ_i').op
          calc
            X.homOfLE (inf_le_right : W ≤ U b' i') ≫ f (b', i')
                = (X.homOfLE (inf_le_right : W ≤ U b' i') ≫ (hAff_U b' i').isoSpec.hom) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ b' i')) ≫ (hAffX i').fromSpec := by
                  dsimp only [f]
                  simp only [CategoryTheory.Category.assoc]
            _ = hAff_W.isoSpec.hom ≫
                  (AlgebraicGeometry.Spec.map
                      (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W ≤ U b' i')).op) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ b' i'))) ≫
                  (hAffX i').fromSpec := by
                  rw [hHomOfLE_isoSpec hAff_W (hAff_U b' i') inf_le_right]
                  simp only [CategoryTheory.Category.assoc]
            _ = hAff_W.isoSpec.hom ≫
                  AlgebraicGeometry.Spec.map
                    (CommRingCat.ofHom (ψ b' i') ≫
                      X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W ≤ U b' i')).op) ≫
                  (hAffX i').fromSpec := by
                  rw [← AlgebraicGeometry.Spec.map_comp]
            _ = hAff_W.isoSpec.hom ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_i') ≫ (hAffX i').fromSpec) := by
                  rw [hcompR, AlgebraicGeometry.Spec.map_comp]
                  simp only [CategoryTheory.Category.assoc]
            _ = hAff_W.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
                  hAff_Z.fromSpec := by
                  rw [hmapZ_i']
        exact hLHS.trans hRHS.symm
      let Φ : X ⟶ X := 𝒰.glueMorphisms f hf
      have hΦ_chart : ∀ b i : Fin (M + 1), (U b i).ι ≫ Φ = f (b, i) :=
        fun b i => 𝒰.ι_glueMorphisms f hf (b, i)
      have hΦ_comm : Φ ≫ π = π := by
        apply 𝒰.hom_ext
        rintro ⟨b, i⟩
        change (U b i).ι ≫ (Φ ≫ π) = (U b i).ι ≫ π
        have hcomp_c : CommRingCat.ofHom (c_X i) ≫ CommRingCat.ofHom (ψ b i) =
            CommRingCat.ofHom (c_X b) ≫ CommRingCat.ofHom (res_U b i) := by
          rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
          exact congrArg CommRingCat.ofHom (RingHom.ext (hψ_c b i))
        have hmap_U : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (res_U b i)) ≫ (hAffX b).fromSpec =
            (hAff_U b i).fromSpec :=
          (hAffX b).map_fromSpec (hAff_U b i) (CategoryTheory.homOfLE (X.basicOpen_le (u A' b i))).op
        calc
          (U b i).ι ≫ (Φ ≫ π)
              = ((U b i).ι ≫ Φ) ≫ π := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (hAff_U b i).isoSpec.hom ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ b i)) ≫
                ((hAffX i).fromSpec ≫ π) := by
                rw [hΦ_chart b i]
                dsimp only [f]
                simp only [CategoryTheory.Category.assoc]
          _ = (hAff_U b i).isoSpec.hom ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ b i)) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_X i))) := by
                rw [← hSpec_c i]
          _ = (hAff_U b i).isoSpec.hom ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (c_X i) ≫ CommRingCat.ofHom (ψ b i)) := by
                rw [← AlgebraicGeometry.Spec.map_comp]
          _ = (hAff_U b i).isoSpec.hom ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (res_U b i)) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_X b)) := by
                rw [hcomp_c, AlgebraicGeometry.Spec.map_comp]
          _ = (hAff_U b i).isoSpec.hom ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (res_U b i)) ≫
                  (hAffX b).fromSpec) ≫ π := by
                rw [hSpec_c b]
                simp only [CategoryTheory.Category.assoc]
          _ = ((hAff_U b i).isoSpec.hom ≫ (hAff_U b i).fromSpec) ≫ π := by
                rw [hmap_U, CategoryTheory.Category.assoc]
          _ = (U b i).ι ≫ π := by
                rw [(hAff_U b i).isoSpec_hom_fromSpec]
      have hΦ_cov : ∀ b i : Fin (M + 1),
          U b i ≤ (TopologicalSpace.Opens.map Φ.base).obj (D i) := by
        intro b i x hx
        let y : ↥(U b i) := ⟨x, hx⟩
        have hy : ((U b i).ι ≫ Φ).base y = Φ.base x := rfl
        change Φ.base x ∈ D i
        rw [← hy, hΦ_chart b i]
        dsimp only [f]
        rw [← (hAffX i).isoSpec_inv_ι]
        simp only [← CategoryTheory.Category.assoc]
        let z : ↥(D i) :=
          (((hAff_U b i).isoSpec.hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ b i))) ≫
            (hAffX i).isoSpec.inv).base y
        change z.1 ∈ D i
        exact z.2
      exact ⟨Φ, hΦ_comm, hΦ_cov, hSup, fun b i => ⟨ψ b i, hΦ_chart b i, hψ_c b i, hψ_rel b i⟩⟩
    have hCompId : ∀ (A' B' : Matrix (Fin (M + 1)) (Fin (M + 1)) R),
        B' * A' = 1 →
        ∀ (Φ₁ Φ₂ : X ⟶ X),
          (⨆ p : Fin (M + 1) × Fin (M + 1), X.basicOpen (u A' p.1 p.2)) = ⊤ →
          (∀ b i : Fin (M + 1),
            let U_bi : X.Opens := X.basicOpen (u A' b i)
            let res_bi := (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le (u A' b i))).op).hom
            ∃ ψ : ↑(X.presheaf.obj (Opposite.op (D i))) →+* ↑(X.presheaf.obj (Opposite.op U_bi)),
              U_bi.ι ≫ Φ₁ =
                ((hAffX b).basicOpen (u A' b i)).isoSpec.hom ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
                  (hAffX i).fromSpec ∧
              (∀ r : R, ψ (c_X i r) = res_bi (c_X b r)) ∧
              (∀ k : Fin (M + 1), ψ (t_X i k) * res_bi (u A' b i) = res_bi (u A' b k))) →
          (∀ i b : Fin (M + 1),
            let U_ib : X.Opens := X.basicOpen (u B' i b)
            let res_ib := (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le (u B' i b))).op).hom
            ∃ ψ : ↑(X.presheaf.obj (Opposite.op (D b))) →+* ↑(X.presheaf.obj (Opposite.op U_ib)),
              U_ib.ι ≫ Φ₂ =
                ((hAffX i).basicOpen (u B' i b)).isoSpec.hom ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
                  (hAffX b).fromSpec ∧
              (∀ r : R, ψ (c_X b r) = res_ib (c_X i r)) ∧
              (∀ k : Fin (M + 1), ψ (t_X b k) * res_ib (u B' i b) = res_ib (u B' i k))) →
          Φ₁ ≫ Φ₂ = 𝟙 X := by
      intro A' B' hBA' Φ₁ Φ₂ hSup₁ hChart₁ hChart₂
      let 𝒰₁ := X.openCoverOfIsOpenCover
        (fun p : Fin (M + 1) × Fin (M + 1) => X.basicOpen (u A' p.1 p.2))
        (TopologicalSpace.IsOpenCover.mk hSup₁)
      apply 𝒰₁.hom_ext
      rintro ⟨b, i⟩
      let U₁ : X.Opens := X.basicOpen (u A' b i)
      let U₂ : X.Opens := X.basicOpen (u B' i b)
      let hAff_U₁ : AlgebraicGeometry.IsAffineOpen U₁ := (hAffX b).basicOpen (u A' b i)
      let hAff_U₂ : AlgebraicGeometry.IsAffineOpen U₂ := (hAffX i).basicOpen (u B' i b)
      let res₁ : ↑(X.presheaf.obj (Opposite.op (D b))) →+* ↑(X.presheaf.obj (Opposite.op U₁)) :=
        (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le (u A' b i))).op).hom
      let res₂ : ↑(X.presheaf.obj (Opposite.op (D i))) →+* ↑(X.presheaf.obj (Opposite.op U₂)) :=
        (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le (u B' i b))).op).hom
      change U₁.ι ≫ (Φ₁ ≫ Φ₂) = U₁.ι ≫ 𝟙 X
      rw [CategoryTheory.Category.comp_id]
      obtain ⟨ψ₁, hf₁, hc₁, ht₁⟩ := hChart₁ b i
      obtain ⟨ψ₂, hf₂, hc₂, ht₂⟩ := hChart₂ i b
      have hRound : ∀ m : Fin (M + 1), ψ₁ (u B' i m) * res₁ (u A' b i) = res₁ (t_X b m) := by
        intro m
        calc
          ψ₁ (u B' i m) * res₁ (u A' b i)
              = (∑ k : Fin (M + 1), ψ₁ (c_X i (B' m k)) * ψ₁ (t_X i k)) * res₁ (u A' b i) := by
                dsimp only [u]
                rw [map_sum]
                congr 1
                exact Finset.sum_congr rfl fun k _ => map_mul ψ₁ _ _
          _ = ∑ k : Fin (M + 1), res₁ (c_X b (B' m k)) * res₁ (u A' b k) := by
                rw [Finset.sum_mul]
                refine Finset.sum_congr rfl fun k _ => ?_
                rw [hc₁ (B' m k), mul_assoc, ht₁ k]
          _ = ∑ k : Fin (M + 1),
                (res₁.comp (c_X b)) (B' m k) *
                  (∑ j : Fin (M + 1), (res₁.comp (c_X b)) (A' k j) * res₁ (t_X b j)) := by
                refine Finset.sum_congr rfl fun k _ => ?_
                dsimp only [u, RingHom.comp_apply]
                congr 1
                rw [map_sum]
                exact Finset.sum_congr rfl fun j _ => map_mul res₁ _ _
          _ = res₁ (t_X b m) :=
                hMatRowSum A' B' hBA' (res₁.comp (c_X b)) (fun j => res₁ (t_X b j)) m
      have hRound_one : ψ₁ (u B' i b) * res₁ (u A' b i) = 1 := by
        rw [hRound b, ht_diag b, map_one]
      have hUnit_ψ₁ : IsUnit (ψ₁ (u B' i b)) :=
        ⟨⟨ψ₁ (u B' i b), res₁ (u A' b i), hRound_one, (mul_comm _ _).trans hRound_one⟩, rfl⟩
      have : IsLocalization.Away (u B' i b) ↑(X.presheaf.obj (Opposite.op U₂)) :=
        (hAffX i).isLocalization_basicOpen (u B' i b)
      let χ : ↑(X.presheaf.obj (Opposite.op U₂)) →+* ↑(X.presheaf.obj (Opposite.op U₁)) :=
        IsLocalization.Away.lift (S := ↑(X.presheaf.obj (Opposite.op U₂))) (u B' i b) hUnit_ψ₁
      have hχ_res₂ : χ.comp res₂ = ψ₁ :=
        RingHom.ext fun x =>
          IsLocalization.Away.lift_eq (S := ↑(X.presheaf.obj (Opposite.op U₂))) (u B' i b) hUnit_ψ₁ x
      have hχ_ψ₂ : χ.comp ψ₂ = res₁ := by
        apply hRingExt b
        · intro r
          change χ (ψ₂ (c_X b r)) = res₁ (c_X b r)
          rw [hc₂ r, show χ (res₂ (c_X i r)) = ψ₁ (c_X i r) from
            congrArg (fun γ => γ (c_X i r)) hχ_res₂, hc₁ r]
        · intro m
          change χ (ψ₂ (t_X b m)) = res₁ (t_X b m)
          have hχ_unit : χ (res₂ (u B' i b)) * res₁ (u A' b i) = 1 := by
            rw [show χ (res₂ (u B' i b)) = ψ₁ (u B' i b) from
              congrArg (fun γ => γ (u B' i b)) hχ_res₂]
            exact hRound_one
          calc
            χ (ψ₂ (t_X b m))
                = χ (ψ₂ (t_X b m)) * (χ (res₂ (u B' i b)) * res₁ (u A' b i)) := by
                    rw [hχ_unit, mul_one]
            _ = (χ (ψ₂ (t_X b m)) * χ (res₂ (u B' i b))) * res₁ (u A' b i) := by ring
            _ = χ (ψ₂ (t_X b m) * res₂ (u B' i b)) * res₁ (u A' b i) := by rw [← map_mul]
            _ = χ (res₂ (u B' i m)) * res₁ (u A' b i) := by rw [ht₂ m]
            _ = ψ₁ (u B' i m) * res₁ (u A' b i) := by
                  rw [show χ (res₂ (u B' i m)) = ψ₁ (u B' i m) from
                    congrArg (fun γ => γ (u B' i m)) hχ_res₂]
            _ = res₁ (t_X b m) := hRound m
      have hmap_U₂ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom res₂) ≫ (hAffX i).fromSpec =
          hAff_U₂.fromSpec :=
        (hAffX i).map_fromSpec hAff_U₂ (CategoryTheory.homOfLE (X.basicOpen_le (u B' i b))).op
      have hmap_U₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom res₁) ≫ (hAffX b).fromSpec =
          hAff_U₁.fromSpec :=
        (hAffX b).map_fromSpec hAff_U₁ (CategoryTheory.homOfLE (X.basicOpen_le (u A' b i))).op
      calc
        U₁.ι ≫ (Φ₁ ≫ Φ₂)
            = (U₁.ι ≫ Φ₁) ≫ Φ₂ := (CategoryTheory.Category.assoc _ _ _).symm
        _ = hAff_U₁.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (χ.comp res₂)) ≫
              (hAffX i).fromSpec ≫ Φ₂ := by
              rw [hf₁, ← hχ_res₂]
              simp only [CategoryTheory.Category.assoc]
        _ = hAff_U₁.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom res₂) ≫ (hAffX i).fromSpec) ≫ Φ₂ := by
              rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
              simp only [CategoryTheory.Category.assoc]
        _ = hAff_U₁.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫
              hAff_U₂.fromSpec ≫ Φ₂ := by
              rw [hmap_U₂]
        _ = hAff_U₁.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫
              hAff_U₂.isoSpec.inv ≫ (U₂.ι ≫ Φ₂) := by
              rw [← hAff_U₂.isoSpec_inv_ι]
              simp only [CategoryTheory.Category.assoc]
        _ = hAff_U₁.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫
              (hAff_U₂.isoSpec.inv ≫ hAff_U₂.isoSpec.hom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫
              (hAffX b).fromSpec := by
              rw [hf₂]
              simp only [CategoryTheory.Category.assoc]
        _ = hAff_U₁.isoSpec.hom ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂)) ≫
              (hAffX b).fromSpec := by
              rw [CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]
              simp only [CategoryTheory.Category.assoc]
        _ = hAff_U₁.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (χ.comp ψ₂)) ≫
              (hAffX b).fromSpec := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = hAff_U₁.isoSpec.hom ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom res₁) ≫ (hAffX b).fromSpec) := by
              rw [hχ_ψ₂]
        _ = hAff_U₁.isoSpec.hom ≫ hAff_U₁.fromSpec := by
              rw [hmap_U₁]
        _ = U₁.ι := hAff_U₁.isoSpec_hom_fromSpec
    obtain ⟨Φ_A, hComm_A, hCov_A, hSup_A, hChart_A⟩ := hConstruct A B hBA
    obtain ⟨Φ_B, _hComm_B, _hCov_B, hSup_B, hChart_B⟩ := hConstruct B A hAB
    have hAB_id : Φ_A ≫ Φ_B = 𝟙 X := hCompId A B hBA Φ_A Φ_B hSup_A hChart_A hChart_B
    have hBA_id : Φ_B ≫ Φ_A = 𝟙 X := hCompId B A hAB Φ_B Φ_A hSup_B hChart_B hChart_A
    exact ⟨⟨Φ_A, Φ_B, hAB_id, hBA_id⟩, hComm_A, hCov_A⟩
  exact hMain (weilProjectiveSpaceOver R M).left (weilProjectiveSpaceOver R M).hom
    (weilProjBasicOpen R M) hAff c_R t_R hSup_D0 hSpec_c0 ht_diag0 hGen0 hUniv0 hInter0 hc_res0 ht_res0

theorem weil_closedImmersion_twoChart_cover_polynomial_module_finite (R : Type u) [CommRing R] (M : ℕ)
    (hAff : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R M a))
    (c_R : ∀ a : Fin (M + 1),
      R →+* ↑((weilProjectiveSpaceOver R M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R M a))))
    (t_R : ∀ a : Fin (M + 1), Fin (M + 1) →
      ↑((weilProjectiveSpaceOver R M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R M a))))
    (hCoord : IsCommRingProjCoordSystem R M hAff c_R t_R)
    (X : AlgebraicGeometry.Scheme.{u})
    (g : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (ι : X ⟶ (weilProjectiveSpaceOver R M).left)
    (hCl : AlgebraicGeometry.IsClosedImmersion ι)
    (hComm : ι ≫ (weilProjectiveSpaceOver R M).hom = g)
    (i₀ i₁ : Fin (M + 1))
    (hCov01 : (TopologicalSpace.Opens.map ι.base).obj (weilProjBasicOpen R M i₀) ⊔
      (TopologicalSpace.Opens.map ι.base).obj (weilProjBasicOpen R M i₁) = ⊤) :
    let V₀ : X.Opens := (TopologicalSpace.Opens.map ι.base).obj (weilProjBasicOpen R M i₀)
    let T₀ : ↑(X.presheaf.obj (Opposite.op V₀)) :=
      (ι.app (weilProjBasicOpen R M i₀)).hom (t_R i₀ i₁)
    AlgebraicGeometry.IsAffineOpen V₀ ∧
    V₀ ⊓ (TopologicalSpace.Opens.map ι.base).obj (weilProjBasicOpen R M i₁) = X.basicOpen T₀ ∧
    ∃ (c₀ : R →+* ↑(X.presheaf.obj (Opposite.op V₀)))
      (d₀ : ℕ) (gen₀ : Fin d₀ → ↑(X.presheaf.obj (Opposite.op V₀))),
      (∀ r : R, c₀ r =
        (g.appTop ≫ X.presheaf.map (CategoryTheory.homOfLE le_top).op).hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r)) ∧
      ∀ w : ↑(X.presheaf.obj (Opposite.op V₀)),
        ∃ P : Fin d₀ → Polynomial R,
          w = ∑ μ : Fin d₀, Polynomial.eval₂ c₀ T₀ (P μ) * gen₀ μ :=
by
  
  let P_R := weilProjectiveSpaceOver R M
  let D : Fin (M + 1) → P_R.left.Opens := weilProjBasicOpen R M
  obtain ⟨_hProp, _hSup, hSpec_cR, _hPoly, ht_diag_R, hGen_R, _hUniv, hInter_R, hc_res_R,
    ht_res_R⟩ := hCoord
  have _ : AlgebraicGeometry.IsClosedImmersion ι := hCl
  let X_chart : Fin (M + 1) → X.Opens :=
    fun a => (TopologicalSpace.Opens.map ι.base).obj (D a)
  have hAff_X : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (X_chart a) :=
    fun a => (hAff a).preimage ι
  let c_X : ∀ a : Fin (M + 1), R →+* ↑(X.presheaf.obj (Opposite.op (X_chart a))) :=
    fun a => (ι.app (D a)).hom.comp (c_R a)
  let u_X : ∀ a : Fin (M + 1), Fin (M + 1) → ↑(X.presheaf.obj (Opposite.op (X_chart a))) :=
    fun a b => (ι.app (D a)).hom (t_R a b)
  let V₀ : X.Opens := X_chart i₀
  let B₀ : Type u := ↑(X.presheaf.obj (Opposite.op V₀))
  let c₀ : R →+* B₀ := c_X i₀
  let x : Fin (M + 1) → B₀ := u_X i₀
  let T₀ : B₀ := x i₁
  have hAff_V₀ : AlgebraicGeometry.IsAffineOpen V₀ := hAff_X i₀
  have hInter_X : ∀ a b : Fin (M + 1), X_chart a ⊓ X_chart b = X.basicOpen (u_X a b) := by
    intro a b
    have h1 := congrArg (TopologicalSpace.Opens.map ι.base).obj (hInter_R a b)
    rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ι (t_R a b)] at h1
    exact h1.symm
  have hu_diag : ∀ a : Fin (M + 1), u_X a a = 1 := by
    intro a
    change (ι.app (D a)).hom (t_R a a) = 1
    rw [ht_diag_R a, map_one]
  have hx₀ : x i₀ = 1 := hu_diag i₀
  have hGen_X : ∀ a : Fin (M + 1),
      Subring.closure (Set.range (c_X a) ∪ Set.range (u_X a)) = ⊤ := by
    intro a
    have hSurj_app : Function.Surjective (ι.app (D a)).hom :=
      AlgebraicGeometry.Scheme.Hom.app_surjective ι (D a) (hAff a)
    let S_sub : Subring ↑(X.presheaf.obj (Opposite.op (X_chart a))) :=
      Subring.closure (Set.range (c_X a) ∪ Set.range (u_X a))
    have hComap_top : S_sub.comap (ι.app (D a)).hom = ⊤ := by
      rw [eq_top_iff, ← hGen_R a, Subring.closure_le]
      rintro z (⟨r, rfl⟩ | ⟨b, rfl⟩)
      · exact Subring.subset_closure (Or.inl ⟨r, rfl⟩)
      · exact Subring.subset_closure (Or.inr ⟨b, rfl⟩)
    rw [eq_top_iff]
    intro y _
    obtain ⟨z, rfl⟩ := hSurj_app y
    have hz : z ∈ S_sub.comap (ι.app (D a)).hom := by
      rw [hComap_top]
      trivial
    exact hz
  have hSpec_c₀ : hAff_V₀.fromSpec ≫ g = AlgebraicGeometry.Spec.map (CommRingCat.ofHom c₀) := by
    have h1 : hAff_V₀.fromSpec ≫ ι =
        AlgebraicGeometry.Spec.map (ι.appLE (D i₀) V₀ le_rfl) ≫ (hAff i₀).fromSpec :=
      ((hAff i₀).SpecMap_appLE_fromSpec ι hAff_V₀ le_rfl).symm
    have happ : ι.appLE (D i₀) V₀ le_rfl = ι.app (D i₀) :=
      AlgebraicGeometry.Scheme.Hom.appLE_eq_app ι
    have hcomp_hom : CommRingCat.ofHom (c_R i₀) ≫ ι.app (D i₀) = CommRingCat.ofHom c₀ := rfl
    rw [← hComm, ← CategoryTheory.Category.assoc, h1, happ,
      CategoryTheory.Category.assoc, ← hSpec_cR i₀,
      ← AlgebraicGeometry.Spec.map_comp, hcomp_hom]
  have hFromSpec_appTop :
      hAff_V₀.fromSpec.appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op V₀))).hom =
      X.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op := by
    let R₀ := X.presheaf.obj (Opposite.op V₀)
    have hnat := AlgebraicGeometry.Scheme.Hom.naturality hAff_V₀.fromSpec
      (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op
    rw [hAff_V₀.fromSpec_app_self] at hnat
    have h1 := congrArg (fun f => f ≫
      (AlgebraicGeometry.Spec R₀).presheaf.map
        (CategoryTheory.eqToHom hAff_V₀.fromSpec_preimage_self.symm).op) hnat
    simp only [CategoryTheory.Category.assoc] at h1
    let m_lhs : Opposite.op (⊤ : (AlgebraicGeometry.Spec R₀).Opens) ⟶ Opposite.op ⊤ :=
      (CategoryTheory.eqToHom hAff_V₀.fromSpec_preimage_self).op ≫
        (CategoryTheory.eqToHom hAff_V₀.fromSpec_preimage_self.symm).op
    let m_rhs : Opposite.op (⊤ : (AlgebraicGeometry.Spec R₀).Opens) ⟶ Opposite.op ⊤ :=
      ((TopologicalSpace.Opens.map hAff_V₀.fromSpec.base).map
        (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op.unop).op ≫
        (CategoryTheory.eqToHom hAff_V₀.fromSpec_preimage_self.symm).op
    change X.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv ≫
        (AlgebraicGeometry.Spec R₀).presheaf.map m_lhs =
      hAff_V₀.fromSpec.appTop ≫ (AlgebraicGeometry.Spec R₀).presheaf.map m_rhs at h1
    have hid1 : m_lhs = 𝟙 (Opposite.op ⊤) := Subsingleton.elim _ _
    have hid2 : m_rhs = 𝟙 (Opposite.op ⊤) := Subsingleton.elim _ _
    simp only [hid1, hid2, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id] at h1
    have h2 := congrArg (fun f => f ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R₀).hom) h1.symm
    simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
      CategoryTheory.Category.comp_id] at h2
    exact h2
  have hc₀_eq : ∀ r : R, c₀ r =
      (g.appTop ≫ X.presheaf.map (CategoryTheory.homOfLE le_top).op).hom
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r) := by
    intro r
    have hnat_spec := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom c₀)
    have htop := congrArg (fun f => f.appTop ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op V₀))).hom) hSpec_c₀
    simp only [AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc,
      hFromSpec_appTop] at htop
    change g.appTop ≫ X.presheaf.map (CategoryTheory.homOfLE le_top).op =
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c₀)).appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B₀)).hom at htop
    rw [hnat_spec] at htop
    have hinv := congrArg (fun f =>
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ f) htop
    simp only [← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
      CategoryTheory.Category.id_comp] at hinv
    exact (congrArg (fun f => f.hom r) hinv).symm

  
  have hRed : ∀ a : Fin (M + 1),
      ∃ (d_a k_a : ℕ) (P_a Q_a : MvPolynomial (Fin (M + 1)) R),
        P_a.totalDegree ≤ d_a ∧
        Q_a.totalDegree ≤ d_a ∧
        x a ^ (d_a + k_a + 1) =
          x a ^ k_a *
            (∑ e ∈ P_a.support,
              c₀ (P_a.coeff e) * x a ^ (d_a - ∑ b : Fin (M + 1), e b) *
                ∏ b : Fin (M + 1), x b ^ (e b)) +
          x a ^ k_a *
            (∑ e ∈ Q_a.support,
              c₀ (Q_a.coeff e) * x a ^ (d_a - ∑ b : Fin (M + 1), e b) *
                ∏ b : Fin (M + 1), x b ^ (e b)) * T₀ := by
    intro a
    let B_a : Type u := ↑(X.presheaf.obj (Opposite.op (X_chart a)))
    let ev_a : MvPolynomial (Fin (M + 1)) R →+* B_a :=
      MvPolynomial.eval₂Hom (c_X a) (u_X a)
    have hSurj_ev : Function.Surjective ev_a := by
      rw [← RingHom.range_eq_top, eq_top_iff, ← hGen_X a, Subring.closure_le]
      rintro y (⟨r, rfl⟩ | ⟨b, rfl⟩)
      · exact ⟨MvPolynomial.C r, MvPolynomial.eval₂Hom_C _ _ r⟩
      · exact ⟨MvPolynomial.X b, MvPolynomial.eval₂Hom_X' _ _ b⟩
    have hCov_a : X.basicOpen (u_X a i₀) ⊔ X.basicOpen (u_X a i₁) = X_chart a := by
      rw [← hInter_X a i₀, ← hInter_X a i₁, ← inf_sup_left]
      change X_chart a ⊓ (X_chart i₀ ⊔ X_chart i₁) = X_chart a
      rw [hCov01, inf_top_eq]
    let s_pair : Set B_a := {u_X a i₀, u_X a i₁}
    have hSup_a : (⨆ f : s_pair, X.basicOpen f.1) = X_chart a := by
      rw [iSup_subtype, iSup_insert, iSup_singleton]
      exact hCov_a
    have hSpan_top : Ideal.span s_pair = ⊤ :=
      (hAff_X a).iSup_basicOpen_eq_self_iff.mp hSup_a
    have hOne_mem : (1 : B_a) ∈ Ideal.span ({u_X a i₀, u_X a i₁} : Set B_a) := by
      change (1 : B_a) ∈ Ideal.span s_pair
      rw [hSpan_top]
      trivial
    obtain ⟨α_a, β_a, hPart_a⟩ := Ideal.mem_span_pair.mp hOne_mem
    obtain ⟨P_a, hPa⟩ := hSurj_ev α_a
    obtain ⟨Q_a, hQa⟩ := hSurj_ev β_a
    let d_a : ℕ := max P_a.totalDegree Q_a.totalDegree
    have hdegP : P_a.totalDegree ≤ d_a := le_max_left _ _
    have hdegQ : Q_a.totalDegree ≤ d_a := le_max_right _ _
    let W_0a : X.Opens := V₀ ⊓ X_chart a
    let res₀ : B₀ →+* ↑(X.presheaf.obj (Opposite.op W_0a)) :=
      (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ X_chart a ≤ V₀)).op).hom
    let res_a : B_a →+* ↑(X.presheaf.obj (Opposite.op W_0a)) :=
      (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ X_chart a ≤ X_chart a)).op).hom
    have e_0a : W_0a ≤ (TopologicalSpace.Opens.map ι.base).obj (D i₀ ⊓ D a) := le_rfl
    let φ_0a : ↑(P_R.left.presheaf.obj (Opposite.op (D i₀ ⊓ D a))) →+*
        ↑(X.presheaf.obj (Opposite.op W_0a)) :=
      (ι.appLE (D i₀ ⊓ D a) W_0a e_0a).hom
    have hNat_0 : ∀ s : ↑(P_R.left.presheaf.obj (Opposite.op (D i₀))),
        res₀ ((ι.app (D i₀)).hom s) =
          φ_0a ((P_R.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : D i₀ ⊓ D a ≤ D i₀)).op).hom s) := by
      intro s
      have h1 : ι.appLE (D i₀) V₀ le_rfl = ι.app (D i₀) :=
        AlgebraicGeometry.Scheme.Hom.appLE_eq_app ι
      have h2 := AlgebraicGeometry.Scheme.Hom.appLE_map ι (U := D i₀) (V := V₀) le_rfl
        (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ X_chart a ≤ V₀)).op
      have h3 := AlgebraicGeometry.Scheme.Hom.map_appLE ι e_0a
        (CategoryTheory.homOfLE (inf_le_left : D i₀ ⊓ D a ≤ D i₀)).op
      have hcomp : ι.app (D i₀) ≫
          X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ X_chart a ≤ V₀)).op =
        P_R.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D i₀ ⊓ D a ≤ D i₀)).op ≫
          ι.appLE (D i₀ ⊓ D a) W_0a e_0a := by
        rw [← h1, h2, h3]
      exact congrArg (fun f => f.hom s) hcomp
    have hNat_a : ∀ s : ↑(P_R.left.presheaf.obj (Opposite.op (D a))),
        res_a ((ι.app (D a)).hom s) =
          φ_0a ((P_R.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_right : D i₀ ⊓ D a ≤ D a)).op).hom s) := by
      intro s
      have h1 : ι.appLE (D a) (X_chart a) le_rfl = ι.app (D a) :=
        AlgebraicGeometry.Scheme.Hom.appLE_eq_app ι
      have h2 := AlgebraicGeometry.Scheme.Hom.appLE_map ι (U := D a) (V := X_chart a) le_rfl
        (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ X_chart a ≤ X_chart a)).op
      have h3 := AlgebraicGeometry.Scheme.Hom.map_appLE ι e_0a
        (CategoryTheory.homOfLE (inf_le_right : D i₀ ⊓ D a ≤ D a)).op
      have hcomp : ι.app (D a) ≫
          X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ X_chart a ≤ X_chart a)).op =
        P_R.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D i₀ ⊓ D a ≤ D a)).op ≫
          ι.appLE (D i₀ ⊓ D a) W_0a e_0a := by
        rw [← h1, h2, h3]
      exact congrArg (fun f => f.hom s) hcomp
    have hc_ov : ∀ r : R, res₀ (c₀ r) = res_a (c_X a r) := by
      intro r
      change res₀ ((ι.app (D i₀)).hom (c_R i₀ r)) = res_a ((ι.app (D a)).hom (c_R a r))
      rw [hNat_0, hNat_a, hc_res_R i₀ a r]
    have ht_ov : ∀ b : Fin (M + 1), res₀ (x b) = res_a (u_X a b) * res₀ (x a) := by
      intro b
      change res₀ ((ι.app (D i₀)).hom (t_R i₀ b)) =
        res_a ((ι.app (D a)).hom (t_R a b)) * res₀ ((ι.app (D i₀)).hom (t_R i₀ a))
      rw [hNat_0, hNat_a, hNat_0, ← map_mul, ht_res_R i₀ a b]
    have ht_ov_i₀ : res_a (u_X a i₀) * res₀ (x a) = 1 := by
      have h0 := ht_ov i₀
      rw [hx₀, map_one] at h0
      exact h0.symm
    let H_a : MvPolynomial (Fin (M + 1)) R → B₀ := fun F =>
      ∑ e ∈ F.support,
        c₀ (F.coeff e) * x a ^ (d_a - ∑ b : Fin (M + 1), e b) *
          ∏ b : Fin (M + 1), x b ^ (e b)
    have hDehom : ∀ F : MvPolynomial (Fin (M + 1)) R,
        F.totalDegree ≤ d_a →
        res₀ (H_a F) = res₀ (x a) ^ d_a * res_a (ev_a F) := by
      intro F hF
      have hev_eq : ev_a F =
          ∑ e ∈ F.support, c_X a (F.coeff e) * ∏ b : Fin (M + 1), u_X a b ^ (e b) := by
        change MvPolynomial.eval₂Hom (c_X a) (u_X a) F = _
        rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_eq]
        refine Finset.sum_congr rfl fun e _ => ?_
        congr 1
        exact Finsupp.prod_fintype e _ (fun _ => pow_zero _)
      dsimp only [H_a]
      rw [hev_eq, map_sum, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun e he => ?_
      have he_le : (∑ b : Fin (M + 1), e b) ≤ d_a := by
        have h1 : e.sum (fun _ k => k) ≤ F.totalDegree := MvPolynomial.le_totalDegree he
        have h2 : e.sum (fun _ k => k) = ∑ b : Fin (M + 1), e b :=
          Finsupp.sum_fintype e _ (fun _ => rfl)
        omega
      have hprod_eq : res₀ (∏ b : Fin (M + 1), x b ^ (e b)) =
          res_a (∏ b : Fin (M + 1), u_X a b ^ (e b)) *
            res₀ (x a) ^ (∑ b : Fin (M + 1), e b) := by
        rw [map_prod, map_prod, ← Finset.prod_pow_eq_pow_sum, ← Finset.prod_mul_distrib]
        refine Finset.prod_congr rfl fun b _ => ?_
        rw [map_pow, map_pow, ht_ov b, mul_pow]
      rw [map_mul, map_mul, map_mul, map_pow, hc_ov, hprod_eq]
      have hpow_combine : res₀ (x a) ^ (d_a - ∑ b : Fin (M + 1), e b) *
          res₀ (x a) ^ (∑ b : Fin (M + 1), e b) = res₀ (x a) ^ d_a := by
        rw [← pow_add, Nat.sub_add_cancel he_le]
      calc
        res_a (c_X a (F.coeff e)) * res₀ (x a) ^ (d_a - ∑ b : Fin (M + 1), e b) *
            (res_a (∏ b : Fin (M + 1), u_X a b ^ e b) *
              res₀ (x a) ^ ∑ b : Fin (M + 1), e b)
          = (res₀ (x a) ^ (d_a - ∑ b : Fin (M + 1), e b) *
              res₀ (x a) ^ ∑ b : Fin (M + 1), e b) *
            (res_a (c_X a (F.coeff e)) * res_a (∏ b : Fin (M + 1), u_X a b ^ e b)) := by ring
        _ = res₀ (x a) ^ d_a *
            (res_a (c_X a (F.coeff e)) * res_a (∏ b : Fin (M + 1), u_X a b ^ e b)) := by
          rw [hpow_combine]
    have hOv_eq : res₀ (x a ^ (d_a + 1)) = res₀ (H_a P_a + H_a Q_a * T₀) := by
      have hP_ov := hDehom P_a hdegP
      have hQ_ov := hDehom Q_a hdegQ
      have hT_ov : res₀ T₀ = res_a (u_X a i₁) * res₀ (x a) := ht_ov i₁
      have hPart_ov : res_a α_a * res_a (u_X a i₀) + res_a β_a * res_a (u_X a i₁) = 1 := by
        have h := congrArg res_a hPart_a
        rwa [map_add, map_mul, map_mul, map_one] at h
      rw [map_add, map_mul, hP_ov, hQ_ov, hPa, hQa, hT_ov, map_pow, pow_succ]
      calc
        res₀ (x a) ^ d_a * res₀ (x a)
          = res₀ (x a) ^ d_a * res₀ (x a) *
              (res_a α_a * res_a (u_X a i₀) + res_a β_a * res_a (u_X a i₁)) := by
            rw [hPart_ov, mul_one]
        _ = res₀ (x a) ^ d_a * res_a α_a * (res_a (u_X a i₀) * res₀ (x a)) +
            res₀ (x a) ^ d_a * res_a β_a * (res_a (u_X a i₁) * res₀ (x a)) := by ring
        _ = res₀ (x a) ^ d_a * res_a α_a +
            res₀ (x a) ^ d_a * res_a β_a * (res_a (u_X a i₁) * res₀ (x a)) := by
          rw [ht_ov_i₀, mul_one]
    let _ : Algebra B₀ ↑(X.presheaf.obj (Opposite.op W_0a)) := res₀.toAlgebra
    have _ : IsLocalization.Away (x a) ↑(X.presheaf.obj (Opposite.op W_0a)) :=
      hAff_V₀.isLocalization_of_eq_basicOpen (x a)
        (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ X_chart a ≤ V₀)) (hInter_X i₀ a)
    have halg_eq :
        algebraMap B₀ ↑(X.presheaf.obj (Opposite.op W_0a)) (x a ^ (d_a + 1)) =
        algebraMap B₀ ↑(X.presheaf.obj (Opposite.op W_0a)) (H_a P_a + H_a Q_a * T₀) :=
      hOv_eq
    obtain ⟨⟨c_pow, hc_pow⟩, hClear⟩ :=
      (IsLocalization.eq_iff_exists (Submonoid.powers (x a))
        ↑(X.presheaf.obj (Opposite.op W_0a))).mp halg_eq
    obtain ⟨k_a, rfl⟩ := (Submonoid.mem_powers_iff c_pow (x a)).mp hc_pow
    refine ⟨d_a, k_a, P_a, Q_a, hdegP, hdegQ, ?_⟩
    have hpow_eq : x a ^ (d_a + k_a + 1) = x a ^ k_a * x a ^ (d_a + 1) := by
      rw [← pow_add]
      congr 1
      omega
    rw [hpow_eq]
    linear_combination hClear

  
  choose d_fn k_fn P_fn Q_fn hdegP_fn hdegQ_fn hRed_fn using hRed
  let N : Fin (M + 1) → ℕ := fun a => d_fn a + k_fn a + 1
  let S_rem : Finset (Fin (M + 1)) := (Finset.univ.erase i₀).erase i₁
  let Idx : Type := ∀ b : ↥S_rem, Fin (N b.1)
  let d₀ : ℕ := Fintype.card Idx
  let e_idx : Idx ≃ Fin d₀ := Fintype.equivFin Idx
  let gen₀ : Fin d₀ → B₀ :=
    fun μ => ∏ b : ↥S_rem, x b.1 ^ (e_idx.symm μ b : ℕ)
  let InSpan : B₀ → Prop :=
    fun w => ∃ P : Fin d₀ → Polynomial R,
      w = ∑ μ : Fin d₀, Polynomial.eval₂ c₀ T₀ (P μ) * gen₀ μ
  have hSpan_zero : InSpan 0 := by
    refine ⟨fun _ => 0, ?_⟩
    simp [Polynomial.eval₂_zero]
  have hSpan_add : ∀ {w₁ w₂ : B₀}, InSpan w₁ → InSpan w₂ → InSpan (w₁ + w₂) := by
    rintro w₁ w₂ ⟨P₁, rfl⟩ ⟨P₂, rfl⟩
    refine ⟨fun μ => P₁ μ + P₂ μ, ?_⟩
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun μ _ => ?_
    rw [Polynomial.eval₂_add, add_mul]
  have hSpan_neg : ∀ {w : B₀}, InSpan w → InSpan (-w) := by
    rintro w ⟨P, rfl⟩
    refine ⟨fun μ => -P μ, ?_⟩
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun μ _ => ?_
    rw [Polynomial.eval₂_neg, neg_mul]
  have hSpan_poly_mul : ∀ (Q : Polynomial R) {w : B₀},
      InSpan w → InSpan (Polynomial.eval₂ c₀ T₀ Q * w) := by
    rintro Q w ⟨P, rfl⟩
    refine ⟨fun μ => Q * P μ, ?_⟩
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun μ _ => ?_
    rw [Polynomial.eval₂_mul, mul_assoc]
  have hSpan_sum : ∀ {α : Type} (s : Finset α) (f : α → B₀),
      (∀ i ∈ s, InSpan (f i)) → InSpan (∑ i ∈ s, f i) := by
    intro α s f hf
    classical
    induction s using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty]
      exact hSpan_zero
    | @insert i s hi ih =>
      rw [Finset.sum_insert hi]
      exact hSpan_add (hf i (Finset.mem_insert_self i s))
        (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))
  let Q_compl : (Fin (M + 1) → ℕ) → Polynomial R := fun m =>
    ∏ b ∈ Finset.univ \ S_rem, (if b = i₁ then Polynomial.X ^ (m b) else 1)
  have hSplit : ∀ m : Fin (M + 1) → ℕ,
      (∏ b : Fin (M + 1), x b ^ (m b)) =
        Polynomial.eval₂ c₀ T₀ (Q_compl m) * ∏ b ∈ S_rem, x b ^ (m b) := by
    intro m
    rw [← Finset.prod_sdiff (Finset.subset_univ S_rem)]
    congr 1
    symm
    dsimp only [Q_compl]
    rw [← Polynomial.coe_eval₂RingHom, map_prod]
    refine Finset.prod_congr rfl fun b hb => ?_
    rw [Polynomial.coe_eval₂RingHom]
    by_cases hb1 : b = i₁
    · subst hb1
      simp only [↓reduceIte, Polynomial.eval₂_X_pow]
      rfl
    · simp only [hb1, ↓reduceIte, Polynomial.eval₂_one]
      have hb_not : b ∉ S_rem := (Finset.mem_sdiff.mp hb).2
      have hb0 : b = i₀ := by
        by_contra hb0
        exact hb_not (Finset.mem_erase.mpr ⟨hb1, Finset.mem_erase.mpr ⟨hb0, Finset.mem_univ b⟩⟩)
      subst hb0
      rw [hx₀, one_pow]
  have hMon_rem_aux : ∀ D : ℕ, ∀ m : Fin (M + 1) → ℕ,
      (∑ b ∈ S_rem, m b) = D → InSpan (∏ b ∈ S_rem, x b ^ (m b)) := by
    intro D
    induction D using Nat.strong_induction_on with
    | h D ih =>
      intro m hD
      by_cases h_bdd : ∀ b ∈ S_rem, m b < N b
      · let idx₀ : Idx := fun b => ⟨m b.1, h_bdd b.1 b.2⟩
        let μ₀ : Fin d₀ := e_idx idx₀
        have hgen_eq : gen₀ μ₀ = ∏ b ∈ S_rem, x b ^ (m b) := by
          dsimp only [gen₀, μ₀]
          rw [Equiv.symm_apply_apply]
          exact Finset.prod_coe_sort S_rem (fun b => x b ^ (m b))
        refine ⟨fun μ => if μ = μ₀ then 1 else 0, ?_⟩
        rw [← hgen_eq]
        have hsum_single :
            (∑ μ : Fin d₀,
              Polynomial.eval₂ c₀ T₀ (if μ = μ₀ then (1 : Polynomial R) else 0) * gen₀ μ) =
            Polynomial.eval₂ c₀ T₀ (if μ₀ = μ₀ then (1 : Polynomial R) else 0) * gen₀ μ₀ := by
          refine Finset.sum_eq_single μ₀ (fun μ _ hμ => ?_)
            (fun hnot => absurd (Finset.mem_univ μ₀) hnot)
          simp only [hμ, ↓reduceIte, Polynomial.eval₂_zero, zero_mul]
        rw [hsum_single]
        simp only [↓reduceIte, Polynomial.eval₂_one, one_mul]
      · simp only [not_forall, not_lt] at h_bdd
        obtain ⟨a, ha_rem, hma⟩ := h_bdd
        let r_rem : ℕ := m a - N a
        have hm_split : m a = N a + r_rem := (Nat.add_sub_of_le hma).symm
        let m_rest : Fin (M + 1) → ℕ := fun b => if b = a then r_rem else m b
        let R_rest : B₀ := ∏ b ∈ S_rem, x b ^ (m_rest b)
        have hProd_rest : (∏ b ∈ S_rem, x b ^ (m b)) = x a ^ (N a) * R_rest := by
          have h1 := (Finset.mul_prod_erase S_rem (fun b => x b ^ (m b)) ha_rem).symm
          have h2 := (Finset.mul_prod_erase S_rem (fun b => x b ^ (m_rest b)) ha_rem).symm
          have herase_eq :
              (∏ b ∈ S_rem.erase a, x b ^ (m b)) = ∏ b ∈ S_rem.erase a, x b ^ (m_rest b) := by
            refine Finset.prod_congr rfl fun b hb => ?_
            have hba : b ≠ a := (Finset.mem_erase.mp hb).1
            simp only [m_rest, hba, ↓reduceIte]
          rw [h1, herase_eq, hm_split, pow_add, mul_assoc]
          congr 1
          dsimp only [R_rest]
          rw [h2]
          simp only [m_rest, ↓reduceIte]
        have hSum_rest : D = N a + ∑ b ∈ S_rem, m_rest b := by
          rw [← hD, ← Finset.add_sum_erase _ _ ha_rem]
          have h2 := (Finset.add_sum_erase S_rem m_rest ha_rem).symm
          have herase_sum :
              (∑ b ∈ S_rem.erase a, m b) = ∑ b ∈ S_rem.erase a, m_rest b := by
            refine Finset.sum_congr rfl fun b hb => ?_
            have hba : b ≠ a := (Finset.mem_erase.mp hb).1
            simp only [m_rest, hba, ↓reduceIte]
          rw [hm_split, herase_sum, add_assoc]
          congr 1
          rw [h2]
          simp only [m_rest, ↓reduceIte]
        have hTerm_span : ∀ F : MvPolynomial (Fin (M + 1)) R,
            F.totalDegree ≤ d_fn a →
            InSpan (x a ^ (k_fn a) *
              (∑ e ∈ F.support,
                c₀ (F.coeff e) * x a ^ (d_fn a - ∑ b : Fin (M + 1), e b) *
                  ∏ b : Fin (M + 1), x b ^ (e b)) * R_rest) := by
          intro F hF_deg
          rw [Finset.mul_sum, Finset.sum_mul]
          refine hSpan_sum F.support _ fun e he => ?_
          let L_e : ℕ := k_fn a + (d_fn a - ∑ j : Fin (M + 1), e j)
          let m_e : Fin (M + 1) → ℕ :=
            fun b => (if b = a then L_e else 0) + e b + m_rest b
          have hpow_single :
              (∏ b ∈ S_rem, x b ^ (if b = a then L_e else 0)) = x a ^ L_e := by
            rw [Finset.prod_eq_single a]
            · simp only [↓reduceIte]
            · intro b _ hba
              simp only [hba, ↓reduceIte, pow_zero]
            · intro ha_not
              exact absurd ha_rem ha_not
          have hprod_me :
              (∏ b ∈ S_rem, x b ^ (m_e b)) =
                x a ^ (k_fn a) * x a ^ (d_fn a - ∑ j : Fin (M + 1), e j) *
                  (∏ b ∈ S_rem, x b ^ (e b)) * R_rest := by
            have hdist :
                (∏ b ∈ S_rem, x b ^ (m_e b)) =
                  (∏ b ∈ S_rem, x b ^ (if b = a then L_e else 0)) *
                    (∏ b ∈ S_rem, x b ^ (e b)) * R_rest := by
              dsimp only [R_rest, m_e]
              rw [← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
              refine Finset.prod_congr rfl fun b _ => ?_
              rw [pow_add, pow_add]
            rw [hdist, hpow_single]
            dsimp only [L_e]
            rw [pow_add]
          have hterm_eq :
              x a ^ (k_fn a) *
                  (c₀ (F.coeff e) * x a ^ (d_fn a - ∑ b : Fin (M + 1), e b) *
                    ∏ b : Fin (M + 1), x b ^ (e b)) * R_rest =
                Polynomial.eval₂ c₀ T₀ (Polynomial.C (F.coeff e) * Q_compl e) *
                  ∏ b ∈ S_rem, x b ^ (m_e b) := by
            rw [hSplit e, Polynomial.eval₂_mul, Polynomial.eval₂_C, hprod_me]
            ring
          rw [hterm_eq]
          apply hSpan_poly_mul
          have hdeg_lt : (∑ b ∈ S_rem, m_e b) < D := by
            have hsum_me :
                (∑ b ∈ S_rem, m_e b) =
                  L_e + (∑ b ∈ S_rem, e b) + ∑ b ∈ S_rem, m_rest b := by
              dsimp only [m_e]
              rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
              congr 2
              rw [Finset.sum_ite_eq' S_rem a (fun _ => L_e)]
              simp only [ha_rem, ↓reduceIte]
            have hsub_le : (∑ b ∈ S_rem, e b) ≤ ∑ j : Fin (M + 1), e j :=
              Finset.sum_le_sum_of_subset (Finset.subset_univ S_rem)
            have hall_le : (∑ j : Fin (M + 1), e j) ≤ d_fn a := by
              have h1 : e.sum (fun _ k => k) ≤ F.totalDegree := MvPolynomial.le_totalDegree he
              have h2 : e.sum (fun _ k => k) = ∑ j : Fin (M + 1), e j :=
                Finsupp.sum_fintype e _ (fun _ => rfl)
              omega
            rw [hsum_me, hSum_rest]
            dsimp only [L_e, N]
            omega
          exact ih (∑ b ∈ S_rem, m_e b) hdeg_lt m_e rfl
        rw [hProd_rest]
        have hN_eq : x a ^ (N a) * R_rest =
            x a ^ (k_fn a) *
              (∑ e ∈ (P_fn a).support,
                c₀ ((P_fn a).coeff e) * x a ^ (d_fn a - ∑ b : Fin (M + 1), e b) *
                  ∏ b : Fin (M + 1), x b ^ (e b)) * R_rest +
            Polynomial.eval₂ c₀ T₀ Polynomial.X *
              (x a ^ (k_fn a) *
                (∑ e ∈ (Q_fn a).support,
                  c₀ ((Q_fn a).coeff e) * x a ^ (d_fn a - ∑ b : Fin (M + 1), e b) *
                    ∏ b : Fin (M + 1), x b ^ (e b)) * R_rest) := by
          dsimp only [N]
          rw [hRed_fn a, Polynomial.eval₂_X]
          ring
        rw [hN_eq]
        exact hSpan_add (hTerm_span (P_fn a) (hdegP_fn a))
          (hSpan_poly_mul Polynomial.X (hTerm_span (Q_fn a) (hdegQ_fn a)))
  have hMon_rem : ∀ m : Fin (M + 1) → ℕ, InSpan (∏ b ∈ S_rem, x b ^ (m b)) :=
    fun m => hMon_rem_aux (∑ b ∈ S_rem, m b) m rfl
  have hMon_full : ∀ m : Fin (M + 1) → ℕ, InSpan (∏ b : Fin (M + 1), x b ^ (m b)) := by
    intro m
    rw [hSplit m]
    exact hSpan_poly_mul (Q_compl m) (hMon_rem m)
  have hSpan_one : InSpan 1 := by
    have h0 := hMon_full (fun _ => 0)
    simpa using h0
  have hSpan_mul : ∀ {w₁ w₂ : B₀}, InSpan w₁ → InSpan w₂ → InSpan (w₁ * w₂) := by
    rintro w₁ w₂ ⟨P₁, rfl⟩ ⟨P₂, rfl⟩
    rw [Finset.sum_mul]
    refine hSpan_sum Finset.univ _ fun μ₁ _ => ?_
    rw [Finset.mul_sum]
    refine hSpan_sum Finset.univ _ fun μ₂ _ => ?_
    have hmul_assoc :
        (Polynomial.eval₂ c₀ T₀ (P₁ μ₁) * gen₀ μ₁) *
          (Polynomial.eval₂ c₀ T₀ (P₂ μ₂) * gen₀ μ₂) =
        Polynomial.eval₂ c₀ T₀ (P₁ μ₁ * P₂ μ₂) * (gen₀ μ₁ * gen₀ μ₂) := by
      rw [Polynomial.eval₂_mul]
      ring
    rw [hmul_assoc]
    apply hSpan_poly_mul
    let m₁₂ : Fin (M + 1) → ℕ := fun b =>
      if hb : b ∈ S_rem then
        (e_idx.symm μ₁ ⟨b, hb⟩ : ℕ) + (e_idx.symm μ₂ ⟨b, hb⟩ : ℕ)
      else 0
    have hgen_mul : gen₀ μ₁ * gen₀ μ₂ = ∏ b ∈ S_rem, x b ^ (m₁₂ b) := by
      dsimp only [gen₀]
      rw [← Finset.prod_mul_distrib, ← Finset.prod_coe_sort S_rem (fun b => x b ^ (m₁₂ b))]
      refine Finset.prod_congr rfl fun b _ => ?_
      simp only [m₁₂, b.2, ↓reduceDIte, pow_add]
    rw [hgen_mul]
    exact hMon_rem m₁₂
  let W_sub : Subring B₀ :=
    { carrier := {w : B₀ | InSpan w}
      mul_mem' := fun ha hb => hSpan_mul ha hb
      one_mem' := hSpan_one
      add_mem' := fun ha hb => hSpan_add ha hb
      zero_mem' := hSpan_zero
      neg_mem' := fun ha => hSpan_neg ha }
  have hW_top : W_sub = ⊤ := by
    rw [eq_top_iff, ← hGen_X i₀, Subring.closure_le]
    rintro y (⟨r, rfl⟩ | ⟨b, rfl⟩)
    · change InSpan (c₀ r)
      have hc_eq : c₀ r = Polynomial.eval₂ c₀ T₀ (Polynomial.C r) * 1 := by
        rw [Polynomial.eval₂_C, mul_one]
      rw [hc_eq]
      exact hSpan_poly_mul (Polynomial.C r) hSpan_one
    · change InSpan (x b)
      let m_b : Fin (M + 1) → ℕ := fun j => if j = b then 1 else 0
      have hxb_eq : (∏ j : Fin (M + 1), x j ^ (m_b j)) = x b := by
        rw [Finset.prod_eq_single b]
        · simp only [m_b, ↓reduceIte, pow_one]
        · intro j _ hjb
          simp only [m_b, hjb, ↓reduceIte, pow_zero]
        · intro hb_not
          exact absurd (Finset.mem_univ b) hb_not
      rw [← hxb_eq]
      exact hMon_full m_b
  refine ⟨hAff_V₀, hInter_X i₀ i₁, c₀, d₀, gen₀, hc₀_eq, ?_⟩
  intro w
  have hw : w ∈ W_sub := by
    rw [hW_top]
    trivial
  exact hw

theorem weil_projective_curve_over_valuation_twoChart_linear_pencil (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (F : Type u) [Field F] (φ_KF : K →+* F)
    (hEss : letI : Algebra K F := φ_KF.toAlgebra; Algebra.EssFiniteType K F)
    (hTr : letI : Algebra K F := φ_KF.toAlgebra; Algebra.trdeg K F ≤ 1)
    (M : ℕ) (h1M : 1 ≤ M)
    (C_tilde : AlgebraicGeometry.Scheme.{u})
    (g_tilde : C_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (ιP_tilde : C_tilde ⟶ (weilProjectiveSpaceOver ↥V M).left)
    (hInt_tilde : AlgebraicGeometry.IsIntegral C_tilde)
    (hProp_tilde : AlgebraicGeometry.IsProper g_tilde)
    (hSurj_tilde : AlgebraicGeometry.Surjective g_tilde)
    (hClP_tilde : AlgebraicGeometry.IsClosedImmersion ιP_tilde)
    (hCommP_tilde : ιP_tilde ≫ (weilProjectiveSpaceOver ↥V M).hom = g_tilde)
    (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_tilde)
    (hη_tilde : η_tilde ≫ g_tilde = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF.comp V.subtype)))
    (hFunc_tilde : IsSchemeFunctionField C_tilde F η_tilde) :
    ∃ (V_tilde₀ V_tilde₁ : C_tilde.Opens)
      (T₀ : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀)))
      (S₁ : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₁))),
      V_tilde₀ ⊔ V_tilde₁ = ⊤ ∧
      AlgebraicGeometry.IsAffineOpen V_tilde₀ ∧ Nonempty ↥V_tilde₀ ∧
      AlgebraicGeometry.IsAffineOpen V_tilde₁ ∧ Nonempty ↥V_tilde₁ ∧
      V_tilde₀ ⊓ V_tilde₁ = C_tilde.basicOpen T₀ ∧
      V_tilde₀ ⊓ V_tilde₁ = C_tilde.basicOpen S₁ ∧
      (C_tilde.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom T₀ *
        (C_tilde.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom S₁ = 1 ∧
      (∃ (c₀ : ↥V →+* ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀)))
         (d₀ : ℕ) (gen₀ : Fin d₀ → ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀))),
        (∀ v : ↥V, c₀ v =
          (g_tilde.appTop ≫ C_tilde.presheaf.map (CategoryTheory.homOfLE le_top).op).hom
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv.hom v)) ∧
        ∀ w : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀)),
          ∃ P : Fin d₀ → Polynomial ↥V,
            w = ∑ μ : Fin d₀, Polynomial.eval₂ c₀ T₀ (P μ) * gen₀ μ) ∧
      (∃ (c₁ : ↥V →+* ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₁)))
         (d₁ : ℕ) (gen₁ : Fin d₁ → ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₁))),
        (∀ v : ↥V, c₁ v =
          (g_tilde.appTop ≫ C_tilde.presheaf.map (CategoryTheory.homOfLE le_top).op).hom
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv.hom v)) ∧
        ∀ w : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₁)),
          ∃ P : Fin d₁ → Polynomial ↥V,
            w = ∑ μ : Fin d₁, Polynomial.eval₂ c₁ S₁ (P μ) * gen₁ μ) :=
by
  obtain ⟨hAff_proj, c_proj, t_proj, hCoord_proj, _⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg
  let P_V := weilProjectiveSpaceOver ↥V M
  let D : Fin (M + 1) → P_V.left.Opens := weilProjBasicOpen ↥V M
  let hAff_V : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (D a) := hAff_proj ↥V M
  let c_V : ∀ a : Fin (M + 1), ↥V →+* ↑(P_V.left.presheaf.obj (Opposite.op (D a))) :=
    c_proj ↥V M
  let t_V : ∀ a : Fin (M + 1), Fin (M + 1) → ↑(P_V.left.presheaf.obj (Opposite.op (D a))) :=
    t_proj ↥V M
  have hCoord_V : IsCommRingProjCoordSystem ↥V M hAff_V c_V t_V := hCoord_proj ↥V M
  have ⟨_hProp_PV, hSup_D, hSpec_cV, _hPoly_V, ht_diag_V, hGen_V, _hUniv_V, _hInter_V,
    _hc_res_V, ht_res_V⟩ := hCoord_V
  have hTwoVar :=
    (weil_gauss_divisorial_valuation_finiteness_and_trdeg_bound K V F φ_KF hEss hTr).2
  let 𝔪_V : Ideal ↥V := IsLocalRing.maximalIdeal ↥V
  haveI hMax_𝔪 : 𝔪_V.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥V
  haveI hPrime_𝔪 : 𝔪_V.IsPrime := hMax_𝔪.isPrime
  let k₀ : Type u := 𝔪_V.ResidueField
  letI : IsAlgClosed k₀ := hPkg.2.2.2.2.1 𝔪_V hMaxNeBot
  let q_V : ↥V →+* k₀ := algebraMap ↥V k₀
  have hq_surj : Function.Surjective q_V := Ideal.algebraMap_residueField_surjective 𝔪_V
  have hq_ker : RingHom.ker q_V = 𝔪_V := Ideal.ker_algebraMap_residueField 𝔪_V
  haveI : AlgebraicGeometry.IsClosedImmersion ιP_tilde := hClP_tilde
  let C_chart : Fin (M + 1) → C_tilde.Opens :=
    fun a => (TopologicalSpace.Opens.map ιP_tilde.base).obj (D a)
  have hAff_C : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (C_chart a) :=
    fun a => (hAff_V a).preimage ιP_tilde
  let A : Fin (M + 1) → Type u :=
    fun a => ↑(C_tilde.presheaf.obj (Opposite.op (C_chart a)))
  let c_A : ∀ a : Fin (M + 1), ↥V →+* A a :=
    fun a => (ιP_tilde.app (D a)).hom.comp (c_V a)
  let t_A : ∀ a : Fin (M + 1), Fin (M + 1) → A a :=
    fun a j => (ιP_tilde.app (D a)).hom (t_V a j)
  have ht_diag : ∀ a : Fin (M + 1), t_A a a = 1 := by
    intro a
    change (ιP_tilde.app (D a)).hom (t_V a a) = 1
    rw [ht_diag_V a, map_one]
  have hGen : ∀ a : Fin (M + 1),
      Subring.closure (Set.range (c_A a) ∪ Set.range (t_A a)) = ⊤ := by
    intro a
    have hSurj_app : Function.Surjective (ιP_tilde.app (D a)).hom :=
      AlgebraicGeometry.Scheme.Hom.app_surjective ιP_tilde (D a) (hAff_V a)
    let S_sub : Subring (A a) := Subring.closure (Set.range (c_A a) ∪ Set.range (t_A a))
    have hComap_top : S_sub.comap (ιP_tilde.app (D a)).hom = ⊤ := by
      rw [eq_top_iff, ← hGen_V a, Subring.closure_le]
      rintro x (⟨v, rfl⟩ | ⟨j, rfl⟩)
      · exact Subring.subset_closure (Or.inl ⟨v, rfl⟩)
      · exact Subring.subset_closure (Or.inr ⟨j, rfl⟩)
    rw [eq_top_iff]
    intro y _
    obtain ⟨x, rfl⟩ := hSurj_app y
    have hx : x ∈ S_sub.comap (ιP_tilde.app (D a)).hom := by
      rw [hComap_top]
      trivial
    exact hx
  have hSpec_c_A : ∀ a : Fin (M + 1),
      (hAff_C a).fromSpec ≫ g_tilde =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_A a)) := by
    intro a
    have h1 : (hAff_C a).fromSpec ≫ ιP_tilde =
        AlgebraicGeometry.Spec.map (ιP_tilde.appLE (D a) (C_chart a) le_rfl) ≫
          (hAff_V a).fromSpec :=
      ((hAff_V a).SpecMap_appLE_fromSpec ιP_tilde (hAff_C a) le_rfl).symm
    have happ : ιP_tilde.appLE (D a) (C_chart a) le_rfl = ιP_tilde.app (D a) :=
      AlgebraicGeometry.Scheme.Hom.appLE_eq_app ιP_tilde
    have hcomp_hom : CommRingCat.ofHom (c_V a) ≫ ιP_tilde.app (D a) =
        CommRingCat.ofHom (c_A a) := rfl
    rw [← hCommP_tilde, ← CategoryTheory.Category.assoc, h1, happ,
      CategoryTheory.Category.assoc, ← hSpec_cV a,
      ← AlgebraicGeometry.Spec.map_comp, hcomp_hom]
  have hEmb : ∀ a : Fin (M + 1), Nontrivial (A a) →
      ∃ ψ : A a →+* F, Function.Injective ψ ∧ ∀ v : ↥V, ψ (c_A a v) = φ_KF (V.subtype v) := by
    intro a hNontriv
    obtain ⟨q⟩ := PrimeSpectrum.nonempty_iff_nontrivial.mpr hNontriv
    have hNe : Nonempty ↥(C_chart a) := ⟨(hAff_C a).isoSpec.inv.base q⟩
    obtain ⟨φ_F, hFrac, hSpec_η⟩ := hFunc_tilde (C_chart a) (hAff_C a) hNe
    have hInj : Function.Injective φ_F.hom :=
      @IsFractionRing.injective (A a) _ F _ φ_F.hom.toAlgebra hFrac
    refine ⟨φ_F.hom, hInj, ?_⟩
    intro v
    have hSpec_eq :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_F.hom.comp (c_A a))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF.comp V.subtype)) := by
      have hcomp : CommRingCat.ofHom (c_A a) ≫ φ_F =
          CommRingCat.ofHom (φ_F.hom.comp (c_A a)) := rfl
      rw [← hcomp, AlgebraicGeometry.Spec.map_comp, ← hSpec_c_A a,
        ← CategoryTheory.Category.assoc, hSpec_η, hη_tilde]
    have hHom_eq := AlgebraicGeometry.Spec.map_injective hSpec_eq
    exact congrArg (fun f => f.hom v) hHom_eq
  have hComap_c_A : ∀ (a : Fin (M + 1)) (p : PrimeSpectrum (A a)),
      Ideal.comap (c_A a) p.asIdeal =
        (g_tilde.base ((hAff_C a).fromSpec p)).asIdeal := by
    intro a p
    have hpt : ((hAff_C a).fromSpec ≫ g_tilde) p =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_A a))) p :=
      congrArg (fun f => f p) (hSpec_c_A a)
    exact (congrArg PrimeSpectrum.asIdeal hpt).symm
  let m_pt : PrimeSpectrum ↥V := ⟨𝔪_V, hPrime_𝔪⟩
  haveI : AlgebraicGeometry.Surjective g_tilde := hSurj_tilde
  obtain ⟨x₀, hx₀_g⟩ := g_tilde.surjective m_pt
  have hx₀_top : ιP_tilde.base x₀ ∈ (⊤ : P_V.left.Opens) := trivial
  rw [← hSup_D, TopologicalSpace.Opens.mem_iSup] at hx₀_top
  obtain ⟨a₀, hx₀⟩ := hx₀_top
  let p₀ : PrimeSpectrum (A a₀) := (hAff_C a₀).primeIdealOf ⟨x₀, hx₀⟩
  have hp₀ : Ideal.comap (c_A a₀) p₀.asIdeal = 𝔪_V := by
    rw [hComap_c_A a₀ p₀, (hAff_C a₀).fromSpec_primeIdealOf ⟨x₀, hx₀⟩]
    exact congrArg PrimeSpectrum.asIdeal hx₀_g
  obtain ⟨A_mat, B_mat, hAB, hBA, hp0_0, hp0_1, hAvoid⟩ :=
    weil_closedFiber_curve_linear_pencil_matrix_avoidance K V k₀ q_V hq_surj hq_ker
      F φ_KF hTwoVar M h1M A c_A t_A ht_diag hGen hEmb a₀ p₀ hp₀
  obtain ⟨Φ, hΦ_comm, hΦ_cov⟩ :=
    weil_commRing_projSpace_invertible_matrix_automorphism ↥V M hAff_V c_V t_V hCoord_V
      A_mat B_mat hAB hBA
  let ι'_P : C_tilde ⟶ P_V.left := ιP_tilde ≫ Φ.hom
  have hCl'_P : AlgebraicGeometry.IsClosedImmersion ι'_P := inferInstance
  have hComm'_P : ι'_P ≫ P_V.hom = g_tilde := by
    dsimp [ι'_P]
    rw [CategoryTheory.Category.assoc, hΦ_comm, hCommP_tilde]
  let i₀ : Fin (M + 1) := ⟨0, by omega⟩
  let i₁ : Fin (M + 1) := ⟨1, by omega⟩
  let V_tilde₀ : C_tilde.Opens := (TopologicalSpace.Opens.map ι'_P.base).obj (D i₀)
  let V_tilde₁ : C_tilde.Opens := (TopologicalSpace.Opens.map ι'_P.base).obj (D i₁)
  let T₀ : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀)) :=
    (ι'_P.app (D i₀)).hom (t_V i₀ i₁)
  let S₁ : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₁)) :=
    (ι'_P.app (D i₁)).hom (t_V i₁ i₀)
  have hMem_Vtilde : ∀ (b i : Fin (M + 1)) (x : ↥(C_chart b)),
      (∑ j : Fin (M + 1), c_A b (A_mat i j) * t_A b j) ∉
        ((hAff_C b).primeIdealOf x).asIdeal →
      x.1 ∈ (TopologicalSpace.Opens.map ι'_P.base).obj (D i) := by
    intro b i x hx_not_mem
    let s_V : ↑(P_V.left.presheaf.obj (Opposite.op (D b))) :=
      ∑ j : Fin (M + 1), c_V b (A_mat i j) * t_V b j
    let s_C : A b := (ιP_tilde.app (D b)).hom s_V
    have hs_eq : s_C = ∑ j : Fin (M + 1), c_A b (A_mat i j) * t_A b j := by
      dsimp [s_C, s_V, c_A, t_A]
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul]
    have hx_basic_spec : (hAff_C b).primeIdealOf x ∈ PrimeSpectrum.basicOpen s_C := by
      rw [PrimeSpectrum.mem_basicOpen, hs_eq]
      exact hx_not_mem
    rw [← (hAff_C b).fromSpec_preimage_basicOpen s_C] at hx_basic_spec
    have hx_basic_C : x.1 ∈ C_tilde.basicOpen s_C := by
      have hpt := (hAff_C b).fromSpec_primeIdealOf x
      change (hAff_C b).fromSpec ((hAff_C b).primeIdealOf x) ∈ C_tilde.basicOpen s_C at hx_basic_spec
      rwa [hpt] at hx_basic_spec
    have hpre : (TopologicalSpace.Opens.map ιP_tilde.base).obj (P_V.left.basicOpen s_V) =
        C_tilde.basicOpen s_C :=
      AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ιP_tilde s_V
    rw [← hpre] at hx_basic_C
    exact hΦ_cov b i hx_basic_C
  have hx₀_0 : x₀ ∈ V_tilde₀ := hMem_Vtilde a₀ i₀ ⟨x₀, hx₀⟩ hp0_0
  have hx₀_1 : x₀ ∈ V_tilde₁ := hMem_Vtilde a₀ i₁ ⟨x₀, hx₀⟩ hp0_1
  have hNe0 : Nonempty ↥V_tilde₀ := ⟨⟨x₀, hx₀_0⟩⟩
  have hNe1 : Nonempty ↥V_tilde₁ := ⟨⟨x₀, hx₀_1⟩⟩
  have hClosedFib_cov : ∀ z : ↥C_tilde,
      (g_tilde.base z).asIdeal = 𝔪_V → z ∈ V_tilde₀ ⊔ V_tilde₁ := by
    intro z hz_m
    have hz_top : ιP_tilde.base z ∈ (⊤ : P_V.left.Opens) := trivial
    rw [← hSup_D, TopologicalSpace.Opens.mem_iSup] at hz_top
    obtain ⟨b, hzb⟩ := hz_top
    let p_z : PrimeSpectrum (A b) := (hAff_C b).primeIdealOf ⟨z, hzb⟩
    have hp_z : Ideal.comap (c_A b) p_z.asIdeal = 𝔪_V := by
      rw [hComap_c_A b p_z, (hAff_C b).fromSpec_primeIdealOf ⟨z, hzb⟩]
      exact hz_m
    rcases hAvoid b p_z hp_z with h0 | h1
    · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inl (hMem_Vtilde b i₀ ⟨z, hzb⟩ h0))
    · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inr (hMem_Vtilde b i₁ ⟨z, hzb⟩ h1))
  have hCov01 : V_tilde₀ ⊔ V_tilde₁ = ⊤ := by
    rw [eq_top_iff]
    intro z _
    by_contra hz_not
    let Z_compl : Set ↥C_tilde := (V_tilde₀ ⊔ V_tilde₁ : Set ↥C_tilde)ᶜ
    have hZ_cl : IsClosed Z_compl := (V_tilde₀ ⊔ V_tilde₁).isOpen.isClosed_compl
    haveI : AlgebraicGeometry.IsProper g_tilde := hProp_tilde
    have hImg_cl : IsClosed (g_tilde.base '' Z_compl) :=
      g_tilde.isClosedMap Z_compl hZ_cl
    have hz_in_Z : z ∈ Z_compl := hz_not
    let q_z : PrimeSpectrum ↥V := g_tilde.base z
    have hle_m : q_z ≤ m_pt :=
      IsLocalRing.le_maximalIdeal q_z.isPrime.ne_top
    have hm_clos : m_pt ∈ closure ({q_z} : Set (PrimeSpectrum ↥V)) :=
      (PrimeSpectrum.le_iff_mem_closure q_z m_pt).mp hle_m
    have hz_img : q_z ∈ (g_tilde.base '' Z_compl : Set (PrimeSpectrum ↥V)) :=
      ⟨z, hz_in_Z, rfl⟩
    have hm_img : m_pt ∈ (g_tilde.base '' Z_compl : Set (PrimeSpectrum ↥V)) :=
      closure_minimal (Set.singleton_subset_iff.mpr hz_img) hImg_cl hm_clos
    obtain ⟨z', hz'_Z, hz'_m⟩ := hm_img
    exact hz'_Z (hClosedFib_cov z' (congrArg PrimeSpectrum.asIdeal hz'_m))
  obtain ⟨hAff0, hInter0, hFinGen0⟩ :=
    weil_closedImmersion_twoChart_cover_polynomial_module_finite ↥V M hAff_V c_V t_V hCoord_V
      C_tilde g_tilde ι'_P hCl'_P hComm'_P i₀ i₁ hCov01
  have hCov10 : V_tilde₁ ⊔ V_tilde₀ = ⊤ := by
    rw [sup_comm]
    exact hCov01
  obtain ⟨hAff1, hInter1_swap, hFinGen1⟩ :=
    weil_closedImmersion_twoChart_cover_polynomial_module_finite ↥V M hAff_V c_V t_V hCoord_V
      C_tilde g_tilde ι'_P hCl'_P hComm'_P i₁ i₀ hCov10
  have hInter1 : V_tilde₀ ⊓ V_tilde₁ = C_tilde.basicOpen S₁ := by
    rw [inf_comm]
    exact hInter1_swap
  have hProd01 :
      (C_tilde.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom T₀ *
        (C_tilde.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom S₁ = 1 := by
    have hPV_prod :
        (P_V.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : D i₀ ⊓ D i₁ ≤ D i₀)).op).hom (t_V i₀ i₁) *
          (P_V.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_right : D i₀ ⊓ D i₁ ≤ D i₁)).op).hom (t_V i₁ i₀) = 1 := by
      rw [mul_comm, ht_res_V i₀ i₁ i₀, ht_diag_V i₀, map_one]
    have e₀₁ : V_tilde₀ ⊓ V_tilde₁ ≤
        (TopologicalSpace.Opens.map ι'_P.base).obj (D i₀ ⊓ D i₁) := le_rfl
    let φ₀₁ : ↑(P_V.left.presheaf.obj (Opposite.op (D i₀ ⊓ D i₁))) →+*
        ↑(C_tilde.presheaf.obj (Opposite.op (V_tilde₀ ⊓ V_tilde₁))) :=
      (ι'_P.appLE (D i₀ ⊓ D i₁) (V_tilde₀ ⊓ V_tilde₁) e₀₁).hom
    have hNat_L :
        (C_tilde.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : V_tilde₀ ⊓ V_tilde₁ ≤ V_tilde₀)).op).hom T₀ =
          φ₀₁ ((P_V.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : D i₀ ⊓ D i₁ ≤ D i₀)).op).hom (t_V i₀ i₁)) := by
      have h1 : ι'_P.appLE (D i₀) V_tilde₀ le_rfl = ι'_P.app (D i₀) :=
        AlgebraicGeometry.Scheme.Hom.appLE_eq_app ι'_P
      have h2 := AlgebraicGeometry.Scheme.Hom.appLE_map ι'_P (U := D i₀) (V := V_tilde₀) le_rfl
        (CategoryTheory.homOfLE (inf_le_left : V_tilde₀ ⊓ V_tilde₁ ≤ V_tilde₀)).op
      have h3 := AlgebraicGeometry.Scheme.Hom.map_appLE ι'_P e₀₁
        (CategoryTheory.homOfLE (inf_le_left : D i₀ ⊓ D i₁ ≤ D i₀)).op
      have hcomp :
          ι'_P.app (D i₀) ≫
            C_tilde.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : V_tilde₀ ⊓ V_tilde₁ ≤ V_tilde₀)).op =
          P_V.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : D i₀ ⊓ D i₁ ≤ D i₀)).op ≫
            ι'_P.appLE (D i₀ ⊓ D i₁) (V_tilde₀ ⊓ V_tilde₁) e₀₁ := by
        rw [← h1, h2, h3]
      exact congrArg (fun f => f.hom (t_V i₀ i₁)) hcomp
    have hNat_R :
        (C_tilde.presheaf.map
            (CategoryTheory.homOfLE (inf_le_right : V_tilde₀ ⊓ V_tilde₁ ≤ V_tilde₁)).op).hom S₁ =
          φ₀₁ ((P_V.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_right : D i₀ ⊓ D i₁ ≤ D i₁)).op).hom (t_V i₁ i₀)) := by
      have h1 : ι'_P.appLE (D i₁) V_tilde₁ le_rfl = ι'_P.app (D i₁) :=
        AlgebraicGeometry.Scheme.Hom.appLE_eq_app ι'_P
      have h2 := AlgebraicGeometry.Scheme.Hom.appLE_map ι'_P (U := D i₁) (V := V_tilde₁) le_rfl
        (CategoryTheory.homOfLE (inf_le_right : V_tilde₀ ⊓ V_tilde₁ ≤ V_tilde₁)).op
      have h3 := AlgebraicGeometry.Scheme.Hom.map_appLE ι'_P e₀₁
        (CategoryTheory.homOfLE (inf_le_right : D i₀ ⊓ D i₁ ≤ D i₁)).op
      have hcomp :
          ι'_P.app (D i₁) ≫
            C_tilde.presheaf.map
              (CategoryTheory.homOfLE (inf_le_right : V_tilde₀ ⊓ V_tilde₁ ≤ V_tilde₁)).op =
          P_V.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_right : D i₀ ⊓ D i₁ ≤ D i₁)).op ≫
            ι'_P.appLE (D i₀ ⊓ D i₁) (V_tilde₀ ⊓ V_tilde₁) e₀₁ := by
        rw [← h1, h2, h3]
      exact congrArg (fun f => f.hom (t_V i₁ i₀)) hcomp
    rw [hNat_L, hNat_R, ← φ₀₁.map_mul, hPV_prod, φ₀₁.map_one]
  exact ⟨V_tilde₀, V_tilde₁, T₀, S₁,
    hCov01, hAff0, hNe0, hAff1, hNe1, hInter0, hInter1, hProd01, hFinGen0, hFinGen1⟩

theorem weil_strictlySemistable_segre_domination_and_twoChart_pencil (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_semi : C_semi ⟶ C')
    (τ_semi : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
    (ι_semi : C_K ⟶ C_semi)
    (hUnemb : IsUnembeddedSemistablePointedModel V p_K n σ_K g' τ'
      C_semi g_semi f_semi τ_semi ι_semi) :
    ∃ (F : Type u) (_ : Field F) (φ_VF : ↥V →+* F)
      (η_semi : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_semi)
      (C_tilde : AlgebraicGeometry.Scheme.{u})
      (g_tilde : C_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (q : C_tilde ⟶ C_semi)
      (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_tilde)
      (U_dom : C_semi.Opens)
      (b : ℕ) (K_bad : Fin b → Set ↥C_semi) (y_bad : Fin b → ↥C_semi)
      (V_tilde₀ V_tilde₁ : C_tilde.Opens)
      (T₀ : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀)))
      (S₁ : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₁))),
      IsSegreTwoChartCurveDomination V g_semi F φ_VF η_semi C_tilde g_tilde q η_tilde
        U_dom b K_bad y_bad V_tilde₀ V_tilde₁ T₀ S₁ :=
by
  have hSS_semi : IsStrictlySemistableCurveOverValuation V g_semi := hUnemb.1
  have hInt_semi : AlgebraicGeometry.IsIntegral C_semi := hSS_semi.1
  have hProp_semi : AlgebraicGeometry.IsProper g_semi := hUnemb.2.2.2.1
  have hNorm_semi : IsAffineNormalScheme C_semi :=
    (weil_strictlySemistable_isAffineNormal_and_funcField K m V hPkg).2.1 C_semi g_semi hSS_semi
  obtain ⟨F, instFieldF, φ_KF, η_semi, M, h1M, C_tilde, g_tilde, ιP_tilde, q, η_tilde, U_gen,
      hInjVF, hEssTr, hη_semi, hη_q, hFunc_semi, hFunc_tilde,
      hInt_tilde, hProp_tilde, hLfp_tilde, hSurj_tilde, hClP_tilde, hCommP_tilde,
      hProp_q, hq_comm, hBij_q, hIso_gen, hU_gen⟩ :=
    weil_unembedded_semistable_segre_modification_and_pushforward K m V hPkg
      C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK
      C' g' τ' ι' hMod' C_semi g_semi f_semi τ_semi ι_semi hUnemb
  let _ : Field F := instFieldF
  let φ_VF : ↥V →+* F := φ_KF.comp V.subtype
  obtain ⟨hEss, hTr⟩ := hEssTr
  obtain ⟨U_dom, b, K_bad, y_bad, hIso_dom, hCompl_dom, hBad_cl, hBad_disj, hBad_sec⟩ :=
    weil_projective_modification_finite_bad_locus_and_open_iso K m V hPkg
      C_semi g_semi hInt_semi hNorm_semi hProp_semi
      F φ_KF hEss hTr η_semi hη_semi hFunc_semi
      M C_tilde g_tilde ιP_tilde hInt_tilde hProp_tilde hClP_tilde hCommP_tilde
      q hProp_q hq_comm η_tilde hη_q hFunc_tilde U_gen hIso_gen hU_gen
  have hη_tilde : η_tilde ≫ g_tilde = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_VF) := by
    rw [← hq_comm, ← CategoryTheory.Category.assoc, hη_q, hη_semi]
  obtain ⟨V_tilde₀, V_tilde₁, T₀, S₁,
      hCov01, hAff0, hNe0, hAff1, hNe1, hInter0, hInter1, hProd01, hFinGen0, hFinGen1⟩ :=
    weil_projective_curve_over_valuation_twoChart_linear_pencil K m V hMaxNeBot hPkg
      F φ_KF hEss hTr M h1M C_tilde g_tilde ιP_tilde
      hInt_tilde hProp_tilde hSurj_tilde hClP_tilde hCommP_tilde
      η_tilde hη_tilde hFunc_tilde
  have hAffInj_semi : ∀ (W_aff : C_semi.Opens) (hAff : AlgebraicGeometry.IsAffineOpen W_aff),
      Nonempty ↥W_aff →
      ∃ ψ : ↑(C_semi.presheaf.obj (Opposite.op W_aff)) →+* F,
        Function.Injective ψ ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ hAff.fromSpec = η_semi := by
    intro W_aff hAff hNe
    obtain ⟨φ, hFrac, hSpec⟩ := hFunc_semi W_aff hAff hNe
    have hInj : Function.Injective φ.hom :=
      @IsFractionRing.injective ↑(C_semi.presheaf.obj (Opposite.op W_aff)) _ F _
        φ.hom.toAlgebra hFrac
    exact ⟨φ.hom, hInj, hSpec⟩
  have hAffInj_tilde : ∀ (W_aff : C_tilde.Opens) (hAff : AlgebraicGeometry.IsAffineOpen W_aff),
      Nonempty ↥W_aff →
      ∃ ψ : ↑(C_tilde.presheaf.obj (Opposite.op W_aff)) →+* F,
        Function.Injective ψ ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ hAff.fromSpec = η_tilde := by
    intro W_aff hAff hNe
    obtain ⟨φ, hFrac, hSpec⟩ := hFunc_tilde W_aff hAff hNe
    have hInj : Function.Injective φ.hom :=
      @IsFractionRing.injective ↑(C_tilde.presheaf.obj (Opposite.op W_aff)) _ F _
        φ.hom.toAlgebra hFrac
    exact ⟨φ.hom, hInj, hSpec⟩
  exact ⟨F, instFieldF, φ_VF, η_semi, C_tilde, g_tilde, q, η_tilde,
    U_dom, b, K_bad, y_bad, V_tilde₀, V_tilde₁, T₀, S₁,
    hInjVF, hη_semi, hη_q, hInt_tilde, hProp_tilde, hLfp_tilde,
    hProp_q, hq_comm, hBij_q, hAffInj_semi, hAffInj_tilde,
    hIso_dom, hCompl_dom, hBad_cl, hBad_disj, hBad_sec,
    hCov01, hAff0, hNe0, hAff1, hNe1, hInter0, hInter1, hProd01, hFinGen0, hFinGen1⟩

theorem weil_strictlySemistable_divisorAdapted_etale_cover_and_badLocus (K : Type u) [Field K] (V : ValuationSubring K)
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS : IsStrictlySemistableCurveOverValuation V g_semi)
    (hProp : AlgebraicGeometry.IsProper g_semi)
    (r_pts : ℕ)
    (γ_div : Fin (r_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
    (W_div : Fin (r_pts + 1) → C_semi.Opens)
    (t_div : ∀ i : Fin (r_pts + 1), ↑(C_semi.presheaf.obj (Opposite.op (W_div i))))
    (hLift : IsLiftedSmoothDivisorSystem V g_semi r_pts γ_div W_div t_div)
    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (hInjVF : Function.Injective φ_VF)
    (η_semi : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_semi)
    (hη_comm : η_semi ≫ g_semi = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_VF))
    (hAffEmb : ∀ (W_aff : C_semi.Opens) (hAff : AlgebraicGeometry.IsAffineOpen W_aff),
      Nonempty ↥W_aff →
      ∃ ψ : ↑(C_semi.presheaf.obj (Opposite.op W_aff)) →+* F,
        Function.Injective ψ ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ hAff.fromSpec = η_semi)
    (U_dom : C_semi.Opens)
    (b : ℕ) (K_bad : Fin b → Set ↥C_semi) (y_bad : Fin b → ↥C_semi)
    (hUdom_compl : (U_dom : Set ↥C_semi)ᶜ = (⋃ ν : Fin b, K_bad ν))
    (hKbad_cl : ∀ ν : Fin b, IsClosed (K_bad ν) ∧ y_bad ν ∈ K_bad ν ∧
      (g_semi.base (y_bad ν)).asIdeal = IsLocalRing.maximalIdeal ↥V)
    (hKbad_disj : ∀ ν ν' : Fin b, ν ≠ ν' → Disjoint (K_bad ν) (K_bad ν'))
    (hKbad_sec : ∀ ν : Fin b,
      ∃ (r_ν : ℕ) (P_ν : Fin r_ν → Ideal ↥V) (_ : ∀ j, (P_ν j).IsPrime)
        (σ_ν : ∀ j : Fin r_ν, AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ P_ν j)) ⟶ C_semi),
        (∀ j : Fin r_ν,
          P_ν j ≠ ⊥ ∧
          σ_ν j ≫ g_semi = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (P_ν j))) ∧
          ∀ pt : PrimeSpectrum (↥V ⧸ P_ν j),
            Ideal.comap (Ideal.Quotient.mk (P_ν j)) pt.asIdeal = IsLocalRing.maximalIdeal ↥V →
            (σ_ν j).base pt = y_bad ν) ∧
        K_bad ν = ⋃ j : Fin r_ν, Set.range (σ_ν j).base) :
    ∃ (N : ℕ) (W : Fin (N + 1) → C_semi.Opens)
      (tag : Fin (N + 1) → Option (Fin (r_pts + 1)))
      (B : Finset (Fin (N + 1)) → Subring F)
      (t_loc : Fin (N + 1) → F)
      (φ_cov : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
        ↑(C_semi.presheaf.obj (Opposite.op (Finset.inf S W))) ≃+* ↥(B S))
      (r_a : Fin (N + 1) → ℕ)
      (P_a : ∀ a : Fin (N + 1), Fin (r_a a) → Ideal ↥V)
      (ρ_a : ∀ (a : Fin (N + 1)) (j : Fin (r_a a)), ↥(B {a}) →+* (↥V ⧸ P_a a j)),
      IsDivisorAdaptedSubringCover V g_semi r_pts γ_div W_div t_div F φ_VF N W tag B t_loc φ_cov ∧
      (∀ a a' : Fin (N + 1), a ≠ a' → W a ⊓ W a' ≤ U_dom) ∧
      (∀ (S : Finset (Fin (N + 1))) (hS : S.Nonempty),
        ∃ hAff : AlgebraicGeometry.IsAffineOpen (Finset.inf S W),
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((B S).subtype.comp (φ_cov S hS).toRingHom)) ≫
            hAff.fromSpec = η_semi) ∧
      IsEtaleSubringCoverOverValuation V F φ_VF N B r_a P_a ρ_a ∧
      (∀ (a : Fin (N + 1)) (u : ↥(B {a})),
        (∀ j : Fin (r_a a), ρ_a a j u = 0) →
        C_semi.basicOpen ((φ_cov {a} (Finset.singleton_nonempty a)).symm u) ≤ U_dom) :=
by
  
  have h_part1 :
      ∃ (N : ℕ) (W : Fin (N + 1) → C_semi.Opens)
        (tag : Fin (N + 1) → Option (Fin (r_pts + 1)))
        (r_a : Fin (N + 1) → ℕ)
        (P_a : ∀ a : Fin (N + 1), Fin (r_a a) → Ideal ↥V)
        (σ_a : ∀ (a : Fin (N + 1)) (j : Fin (r_a a)),
          AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ P_a a j)) ⟶ C_semi),
        (⨆ a : Fin (N + 1), W a) = ⊤ ∧
        (∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (W a) ∧ Nonempty ↥(W a)) ∧
        (∀ a a' : Fin (N + 1), a ≠ a' → W a ⊓ W a' ≤ U_dom) ∧
        (∀ a : Fin (N + 1),
          (tag a = none →
            Disjoint (W a : Set ↥C_semi) (⋃ i : Fin (r_pts + 1), Set.range (γ_div i).base)) ∧
          ∀ i : Fin (r_pts + 1), tag a = some i → W a ≤ W_div i) ∧
        (∀ i : Fin (r_pts + 1),
          ∃ a : Fin (N + 1), tag a = some i ∧ Set.range (γ_div i).base ⊆ (W a : Set ↥C_semi)) ∧
        (∀ a : Fin (N + 1),
          (∃ (W_et : C_semi.Opens)
              (e : W_et.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
            W a ≤ W_et ∧
            AlgebraicGeometry.Etale e ∧
            W_et.ι ≫ g_semi = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∨
          (∃ (W_et : C_semi.Opens) (α : ↥V)
              (e : W_et.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
                (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
                  {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C α}))),
            W a ≤ W_et ∧
            α ≠ 0 ∧
            AlgebraicGeometry.Etale e ∧
            W_et.ι ≫ g_semi = e ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))) ∧
        (∀ a : Fin (N + 1),
          (∀ j : Fin (r_a a),
            σ_a a j ≫ g_semi =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (P_a a j))) ∧
            Set.range (σ_a a j).base ⊆ (W a : Set ↥C_semi)) ∧
          (W a : Set ↥C_semi) \ (U_dom : Set ↥C_semi) ⊆
            ⋃ j : Fin (r_a a), Set.range (σ_a a j).base) := by
    classical
    let p_max : PrimeSpectrum ↥V := IsLocalRing.closedPoint ↥V
    let x_div : Fin (r_pts + 1) → ↥C_semi := fun i => (γ_div i).base p_max
    have hγ_capture : ∀ (i : Fin (r_pts + 1)) (U : C_semi.Opens),
        x_div i ∈ U → Set.range (γ_div i).base ⊆ (U : Set ↥C_semi) := by
      intro i U hx
      rintro _ ⟨q, rfl⟩
      have h_open : IsOpen ((γ_div i).base ⁻¹' (U : Set ↥C_semi)) :=
        U.isOpen.preimage (γ_div i).base.hom.continuous
      exact (IsLocalRing.specializes_closedPoint q).mem_open h_open hx
    have hx_mem_Wdiv : ∀ i : Fin (r_pts + 1), x_div i ∈ W_div i := by
      intro i
      obtain ⟨h_le, _⟩ := (hLift.1 i).2.2.2.2.1
      exact h_le (trivial : p_max ∈ (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens))
    have hx_inj : Function.Injective x_div := by
      intro i j hij
      by_contra hne
      have h_mem_i : x_div j ∈ (W_div i : Set ↥C_semi) := hij ▸ hx_mem_Wdiv i
      have h_mem_rng : x_div j ∈ Set.range (γ_div j).base := ⟨p_max, rfl⟩
      exact Set.disjoint_left.mp (hLift.2.1 i j hne) h_mem_i h_mem_rng
    have hγ_closed : ∀ i : Fin (r_pts + 1), IsClosed (Set.range (γ_div i).base) := by
      intro i
      have : AlgebraicGeometry.IsClosedImmersion (γ_div i) := (hLift.1 i).2.1
      exact (AlgebraicGeometry.IsClosedImmersion.iff_isPreimmersion (f := γ_div i)).mp inferInstance |>.2
    choose r_ν P_ν hPrime_ν σ_ν hSec_ν hEq_ν using hKbad_sec
    have hσ_closed_eq : ∀ (ν : Fin b) (j : Fin (r_ν ν)),
        ∃ q_max : PrimeSpectrum (↥V ⧸ P_ν ν j),
          (∀ pt : PrimeSpectrum (↥V ⧸ P_ν ν j), pt ⤳ q_max) ∧
          (σ_ν ν j).base q_max = y_bad ν := by
      intro ν j
      have : (P_ν ν j).IsPrime := hPrime_ν ν j
      have : Nontrivial (↥V ⧸ P_ν ν j) := by
        refine ⟨⟨0, 1, fun h => (hPrime_ν ν j).1 ?_⟩⟩
        rw [Ideal.eq_top_iff_one]
        exact Ideal.Quotient.eq_zero_iff_mem.mp h.symm
      let _ : IsLocalRing (↥V ⧸ P_ν ν j) :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk (P_ν ν j)) Ideal.Quotient.mk_surjective
      have : IsLocalHom (Ideal.Quotient.mk (P_ν ν j)) :=
        IsLocalHom.of_surjective (Ideal.Quotient.mk (P_ν ν j)) Ideal.Quotient.mk_surjective
      let q_max : PrimeSpectrum (↥V ⧸ P_ν ν j) := IsLocalRing.closedPoint (↥V ⧸ P_ν ν j)
      have h_comap : Ideal.comap (Ideal.Quotient.mk (P_ν ν j)) q_max.asIdeal =
          IsLocalRing.maximalIdeal ↥V := by
        ext v
        change Ideal.Quotient.mk (P_ν ν j) v ∈ IsLocalRing.maximalIdeal (↥V ⧸ P_ν ν j) ↔
          v ∈ IsLocalRing.maximalIdeal ↥V
        rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal,
          mem_nonunits_iff, mem_nonunits_iff, not_iff_not]
        exact ⟨fun h => isUnit_of_map_unit (Ideal.Quotient.mk (P_ν ν j)) v h, IsUnit.map _⟩
      exact ⟨q_max, IsLocalRing.specializes_closedPoint, (hSec_ν ν j).2.2 q_max h_comap⟩
    have hKbad_capture : ∀ (ν : Fin b) (U : C_semi.Opens),
        y_bad ν ∈ U → K_bad ν ⊆ (U : Set ↥C_semi) := by
      intro ν U hy
      rw [hEq_ν ν, Set.iUnion_subset_iff]
      intro j x hx
      obtain ⟨pt, rfl⟩ := hx
      obtain ⟨q_max, h_spec, hq_eq⟩ := hσ_closed_eq ν j
      have h_open : IsOpen ((σ_ν ν j).base ⁻¹' (U : Set ↥C_semi)) :=
        U.isOpen.preimage (σ_ν ν j).base.hom.continuous
      have hq_mem : q_max ∈ (σ_ν ν j).base ⁻¹' (U : Set ↥C_semi) := by
        change (σ_ν ν j).base q_max ∈ U
        rwa [hq_eq]
      exact (h_spec pt).mem_open h_open hq_mem
    have hKbad_div_disj : ∀ (ν : Fin b) (i : Fin (r_pts + 1)),
        y_bad ν ≠ x_div i → Disjoint (K_bad ν) (Set.range (γ_div i).base) := by
      intro ν i hne
      rw [Set.disjoint_left]
      intro z hz_bad hz_div
      apply hne
      rw [hEq_ν ν] at hz_bad
      obtain ⟨j, pt, rfl⟩ := Set.mem_iUnion.mp hz_bad
      obtain ⟨q_max, h_spec, hq_eq⟩ := hσ_closed_eq ν j
      have h_cl_pre : IsClosed ((σ_ν ν j).base ⁻¹' Set.range (γ_div i).base) :=
        (hγ_closed i).preimage (σ_ν ν j).base.hom.continuous
      have hy_mem_div : y_bad ν ∈ Set.range (γ_div i).base := by
        rw [← hq_eq]
        exact (h_spec pt).mem_closed h_cl_pre hz_div
      obtain ⟨p, hp⟩ := hy_mem_div
      have hp_eq : p = p_max := by
        apply PrimeSpectrum.ext
        have h1 : (γ_div i ≫ g_semi).base p = g_semi.base (y_bad ν) := by
          change g_semi.base ((γ_div i).base p) = _
          rw [hp]
        rw [(hLift.1 i).1] at h1
        change p.asIdeal = IsLocalRing.maximalIdeal ↥V
        have h2 : p = g_semi.base (y_bad ν) := h1
        rw [h2, (hKbad_cl ν).2.2]
      rw [← hp, hp_eq]
    have hEt_nbhd : ∀ y : ↥C_semi,
        ∃ W_y : C_semi.Opens, y ∈ W_y ∧
          ∀ U : C_semi.Opens, U ≤ W_y →
            (∃ (W_et : C_semi.Opens)
                (e : W_et.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
              U ≤ W_et ∧ AlgebraicGeometry.Etale e ∧
              W_et.ι ≫ g_semi = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∨
            (∃ (W_et : C_semi.Opens) (α : ↥V)
                (e : W_et.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
                  (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
                    {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C α}))),
              U ≤ W_et ∧ α ≠ 0 ∧ AlgebraicGeometry.Etale e ∧
              W_et.ι ≫ g_semi = e ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) := by
      intro y
      rcases hSS.2.2.2.2 y with ⟨W_y, e, hy, hEt, hcomm⟩ | ⟨W_y, α, e, hy, hα, hEt, hcomm⟩
      · exact ⟨W_y, hy, fun U hU => Or.inl ⟨W_y, e, hU, hEt, hcomm⟩⟩
      · exact ⟨W_y, hy, fun U hU => Or.inr ⟨W_y, α, e, hU, hα, hEt, hcomm⟩⟩
    choose W_et_of hy_et hEt_inherit using hEt_nbhd
    let Z_div : Set ↥C_semi := ⋃ i : Fin (r_pts + 1), Set.range (γ_div i).base
    have hZ_div_cl : IsClosed Z_div := isClosed_iUnion_of_finite hγ_closed
    let U_noDiv : C_semi.Opens := ⟨Z_divᶜ, hZ_div_cl.isOpen_compl⟩
    let Z_other : Fin b → Set ↥C_semi := fun ν =>
      ⋃ ν' ∈ (Finset.univ.erase ν), K_bad ν'
    have hZ_other_cl : ∀ ν : Fin b, IsClosed (Z_other ν) :=
      fun ν => (Finset.univ.erase ν).finite_toSet.isClosed_biUnion (fun ν' _ => (hKbad_cl ν').1)
    let U_isol : Fin b → C_semi.Opens := fun ν => ⟨(Z_other ν)ᶜ, (hZ_other_cl ν).isOpen_compl⟩
    have hy_isol : ∀ ν : Fin b, y_bad ν ∈ U_isol ν := by
      intro ν h_mem
      obtain ⟨ν', hν'_er, hy_ν'⟩ := Set.mem_iUnion₂.mp h_mem
      have hne : ν ≠ ν' := (Finset.ne_of_mem_erase hν'_er).symm
      exact Set.disjoint_left.mp (hKbad_disj ν ν' hne) (hKbad_cl ν).2.1 hy_ν'
    let tag₁ : Fin b → Option (Fin (r_pts + 1)) := fun ν =>
      if h : ∃ i : Fin (r_pts + 1), y_bad ν = x_div i then some h.choose else none
    have hTier1_ex : ∀ ν : Fin b,
        ∃ W₁ : C_semi.Opens,
          AlgebraicGeometry.IsAffineOpen W₁ ∧
          y_bad ν ∈ W₁ ∧
          W₁ ≤ U_isol ν ∧
          W₁ ≤ W_et_of (y_bad ν) ∧
          (tag₁ ν = none → Disjoint (W₁ : Set ↥C_semi) Z_div) ∧
          (∀ i : Fin (r_pts + 1), tag₁ ν = some i → W₁ ≤ W_div i) := by
      intro ν
      by_cases h : ∃ i : Fin (r_pts + 1), y_bad ν = x_div i
      · let i_ν := h.choose
        have hi_ν : y_bad ν = x_div i_ν := h.choose_spec
        have hy_in : y_bad ν ∈ W_div i_ν ⊓ U_isol ν ⊓ W_et_of (y_bad ν) :=
          ⟨⟨hi_ν.symm ▸ hx_mem_Wdiv i_ν, hy_isol ν⟩, hy_et (y_bad ν)⟩
        obtain ⟨W₁, hAff, hy_W₁, hsub⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hy_in
        have hsub' : W₁ ≤ W_div i_ν ⊓ U_isol ν ⊓ W_et_of (y_bad ν) := hsub
        refine ⟨W₁, hAff, hy_W₁, (hsub'.trans inf_le_left).trans inf_le_right,
          hsub'.trans inf_le_right, ?_, ?_⟩
        · intro h_none
          simp [tag₁, dif_pos h] at h_none
        · intro i h_some
          have hi_eq : i_ν = i := by simpa [tag₁, dif_pos h] using h_some
          rw [← hi_eq]
          exact (hsub'.trans inf_le_left).trans inf_le_left
      · have hy_noDiv : y_bad ν ∈ U_noDiv := by
          intro h_mem
          obtain ⟨i, hi_mem⟩ := Set.mem_iUnion.mp h_mem
          have hne : y_bad ν ≠ x_div i := fun heq => h ⟨i, heq⟩
          exact Set.disjoint_left.mp (hKbad_div_disj ν i hne) (hKbad_cl ν).2.1 hi_mem
        have hy_in : y_bad ν ∈ U_noDiv ⊓ U_isol ν ⊓ W_et_of (y_bad ν) :=
          ⟨⟨hy_noDiv, hy_isol ν⟩, hy_et (y_bad ν)⟩
        obtain ⟨W₁, hAff, hy_W₁, hsub⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hy_in
        have hsub' : W₁ ≤ U_noDiv ⊓ U_isol ν ⊓ W_et_of (y_bad ν) := hsub
        refine ⟨W₁, hAff, hy_W₁, (hsub'.trans inf_le_left).trans inf_le_right,
          hsub'.trans inf_le_right, ?_, ?_⟩
        · intro _
          rw [Set.disjoint_left]
          intro z hz_W₁ hz_div
          have hz_noDiv : z ∈ U_noDiv := ((hsub'.trans inf_le_left).trans inf_le_left) hz_W₁
          exact hz_noDiv hz_div
        · intro i h_some
          simp [tag₁, dif_neg h] at h_some
    choose W₁ hAff₁ hy_W₁ hW₁_isol hW₁_et hW₁_none hW₁_some using hTier1_ex
    let I₂ := {i : Fin (r_pts + 1) // ∀ ν : Fin b, y_bad ν ≠ x_div i}
    have hTier2_ex : ∀ i : I₂,
        ∃ W₂ : C_semi.Opens,
          AlgebraicGeometry.IsAffineOpen W₂ ∧
          x_div i.1 ∈ W₂ ∧
          W₂ ≤ W_div i.1 ∧
          W₂ ≤ U_dom ∧
          W₂ ≤ W_et_of (x_div i.1) := by
      intro i
      have hx_dom : x_div i.1 ∈ U_dom := by
        by_contra hx_ndom
        have hx_bad : x_div i.1 ∈ ⋃ ν : Fin b, K_bad ν := by
          rw [← hUdom_compl]; exact hx_ndom
        obtain ⟨ν, hx_ν⟩ := Set.mem_iUnion.mp hx_bad
        exact Set.disjoint_left.mp (hKbad_div_disj ν i.1 (i.2 ν)) hx_ν ⟨p_max, rfl⟩
      have hx_in : x_div i.1 ∈ W_div i.1 ⊓ U_dom ⊓ W_et_of (x_div i.1) :=
        ⟨⟨hx_mem_Wdiv i.1, hx_dom⟩, hy_et (x_div i.1)⟩
      obtain ⟨W₂, hAff, hx_W₂, hsub⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx_in
      have hsub' : W₂ ≤ W_div i.1 ⊓ U_dom ⊓ W_et_of (x_div i.1) := hsub
      exact ⟨W₂, hAff, hx_W₂, (hsub'.trans inf_le_left).trans inf_le_left,
        (hsub'.trans inf_le_left).trans inf_le_right, hsub'.trans inf_le_right⟩
    choose W₂ hAff₂ hx_W₂ hW₂_div hW₂_dom hW₂_et using hTier2_ex
    let U₁₂ : C_semi.Opens := (⨆ ν : Fin b, W₁ ν) ⊔ (⨆ i : I₂, W₂ i)
    let Z_rem : Set ↥C_semi := (U₁₂ : Set ↥C_semi)ᶜ
    have hZ_rem_sub : Z_rem ⊆ (U_dom : Set ↥C_semi) ∩ (U_noDiv : Set ↥C_semi) := by
      intro z hz_rem
      refine ⟨?_, ?_⟩
      · by_contra hz_ndom
        have hz_bad : z ∈ ⋃ ν : Fin b, K_bad ν := by rw [← hUdom_compl]; exact hz_ndom
        obtain ⟨ν, hz_ν⟩ := Set.mem_iUnion.mp hz_bad
        have hz_W₁ : z ∈ W₁ ν := hKbad_capture ν (W₁ ν) (hy_W₁ ν) hz_ν
        have hz_U₁₂ : z ∈ U₁₂ :=
          (le_sup_left : (⨆ ν' : Fin b, W₁ ν') ≤ U₁₂) (TopologicalSpace.Opens.mem_iSup.mpr ⟨ν, hz_W₁⟩)
        exact hz_rem hz_U₁₂
      · intro hz_div
        obtain ⟨i, hz_i⟩ := Set.mem_iUnion.mp hz_div
        by_cases h : ∃ ν : Fin b, y_bad ν = x_div i
        · obtain ⟨ν, hν⟩ := h
          have hx_in_W₁ : x_div i ∈ W₁ ν := hν ▸ hy_W₁ ν
          have hz_W₁ : z ∈ W₁ ν := hγ_capture i (W₁ ν) hx_in_W₁ hz_i
          have hz_U₁₂ : z ∈ U₁₂ :=
            (le_sup_left : (⨆ ν' : Fin b, W₁ ν') ≤ U₁₂) (TopologicalSpace.Opens.mem_iSup.mpr ⟨ν, hz_W₁⟩)
          exact hz_rem hz_U₁₂
        · push_neg at h
          let i₂ : I₂ := ⟨i, h⟩
          have hz_W₂ : z ∈ W₂ i₂ := hγ_capture i (W₂ i₂) (hx_W₂ i₂) hz_i
          have hz_U₁₂ : z ∈ U₁₂ :=
            (le_sup_right : (⨆ j : I₂, W₂ j) ≤ U₁₂) (TopologicalSpace.Opens.mem_iSup.mpr ⟨i₂, hz_W₂⟩)
          exact hz_rem hz_U₁₂
    have : AlgebraicGeometry.IsProper g_semi := hProp
    have : CompactSpace ↥C_semi :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace g_semi
    have hZ_rem_comp : IsCompact Z_rem := U₁₂.isOpen.isClosed_compl.isCompact
    have hTier3_ex : ∀ z : ↥Z_rem,
        ∃ W₃ : C_semi.Opens,
          AlgebraicGeometry.IsAffineOpen W₃ ∧
          z.1 ∈ W₃ ∧
          W₃ ≤ U_dom ∧
          Disjoint (W₃ : Set ↥C_semi) Z_div ∧
          W₃ ≤ W_et_of z.1 := by
      intro z
      have hz_in : z.1 ∈ U_dom ⊓ U_noDiv ⊓ W_et_of z.1 :=
        ⟨hZ_rem_sub z.2, hy_et z.1⟩
      obtain ⟨W₃, hAff, hz_W₃, hsub⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hz_in
      have hsub' : W₃ ≤ U_dom ⊓ U_noDiv ⊓ W_et_of z.1 := hsub
      refine ⟨W₃, hAff, hz_W₃, (hsub'.trans inf_le_left).trans inf_le_left, ?_, hsub'.trans inf_le_right⟩
      rw [Set.disjoint_left]
      intro w hw_W₃ hw_div
      exact ((hsub'.trans inf_le_left).trans inf_le_right hw_W₃) hw_div
    choose W₃_all hAff₃ hz_W₃ hW₃_dom hW₃_disj hW₃_et using hTier3_ex
    obtain ⟨t_rem, ht_rem_cov⟩ := hZ_rem_comp.elim_finite_subcover
      (fun z : ↥Z_rem => (W₃_all z : Set ↥C_semi))
      (fun z => (W₃_all z).isOpen)
      (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hz_W₃ ⟨x, hx⟩⟩)
    let Idx := Fin b ⊕ (I₂ ⊕ ↥t_rem)
    have hIdx_ne : Nonempty Idx := by
      by_cases h : ∃ ν : Fin b, y_bad ν = x_div 0
      · obtain ⟨ν, _⟩ := h; exact ⟨Sum.inl ν⟩
      · push_neg at h; exact ⟨Sum.inr (Sum.inl ⟨0, h⟩)⟩
    have h_card_pos : 0 < Fintype.card Idx := Fintype.card_pos_iff.mpr hIdx_ne
    let N := Fintype.card Idx - 1
    have h_card_eq : Fintype.card Idx = N + 1 := (Nat.sub_add_cancel h_card_pos).symm
    let eIdx : Fin (N + 1) ≃ Idx := (finCongr h_card_eq).symm.trans (Fintype.equivFin Idx).symm
    let W_idx : Idx → C_semi.Opens
      | Sum.inl ν => W₁ ν
      | Sum.inr (Sum.inl i) => W₂ i
      | Sum.inr (Sum.inr z) => W₃_all z.1
    let tag_idx : Idx → Option (Fin (r_pts + 1))
      | Sum.inl ν => tag₁ ν
      | Sum.inr (Sum.inl i) => some i.1
      | Sum.inr (Sum.inr _) => none
    let r_idx : Idx → ℕ
      | Sum.inl ν => r_ν ν
      | Sum.inr (Sum.inl _) => 0
      | Sum.inr (Sum.inr _) => 0
    let P_idx : ∀ α : Idx, Fin (r_idx α) → Ideal ↥V
      | Sum.inl ν => P_ν ν
      | Sum.inr (Sum.inl _) => Fin.elim0
      | Sum.inr (Sum.inr _) => Fin.elim0
    let σ_idx : ∀ (α : Idx) (j : Fin (r_idx α)),
        AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ P_idx α j)) ⟶ C_semi
      | Sum.inl ν => σ_ν ν
      | Sum.inr (Sum.inl _) => fun j => Fin.elim0 j
      | Sum.inr (Sum.inr _) => fun j => Fin.elim0 j
    let W : Fin (N + 1) → C_semi.Opens := fun a => W_idx (eIdx a)
    let tag : Fin (N + 1) → Option (Fin (r_pts + 1)) := fun a => tag_idx (eIdx a)
    let r_a : Fin (N + 1) → ℕ := fun a => r_idx (eIdx a)
    let P_a : ∀ a : Fin (N + 1), Fin (r_a a) → Ideal ↥V := fun a => P_idx (eIdx a)
    let σ_a : ∀ (a : Fin (N + 1)) (j : Fin (r_a a)),
        AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ P_a a j)) ⟶ C_semi := fun a => σ_idx (eIdx a)
    refine ⟨N, W, tag, r_a, P_a, σ_a, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [eq_top_iff]
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      by_cases hx_U12 : x ∈ U₁₂
      · rcases hx_U12 with hx1 | hx2
        · obtain ⟨ν, hx_ν⟩ := TopologicalSpace.Opens.mem_iSup.mp hx1
          exact ⟨eIdx.symm (Sum.inl ν), by simp [W, W_idx, hx_ν]⟩
        · obtain ⟨i, hx_i⟩ := TopologicalSpace.Opens.mem_iSup.mp hx2
