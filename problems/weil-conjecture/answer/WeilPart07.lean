        _ = res₀_Y (h₀_Y ^ (m₂ + n₂) * b₁ + h₀_Y ^ (m₁ + n₁) * b₂) := by
          rw [res₀_Y.map_add (h₀_Y ^ (m₂ + n₂) * b₁) (h₀_Y ^ (m₁ + n₁) * b₂),
