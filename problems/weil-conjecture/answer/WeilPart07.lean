      fun K =>
        ∑ j : Fin s,
          (Y.presheaf.map (CategoryTheory.homOfLE (hS_aff _ (hK_ne K)).1).op).hom
            (c j * (f j) ^ L) * N_sec j K
    refine ⟨β, fun I => ?_⟩
    have hL_kill : ∀ j : Fin s,
        ((Y.presheaf.map (CategoryTheory.homOfLE (hS_aff _ (hI_ne I)).1).op).hom (f j)) ^ L *
          dN j I =
        ((Y.presheaf.map (CategoryTheory.homOfLE (hS_aff _ (hI_ne I)).1).op).hom (f j)) ^ (M + L) *
          α I := by
      intro j
      have hkill := hl₀ (j, I) L (Finset.le_sup (f := l₀) (Finset.mem_univ (j, I)))
      rw [hkill, ← mul_assoc, ← pow_add, add_comm L M]
    have hswap :
        (∑ r : Fin (q + 2),
          (-1 : ℤ) ^ (r : ℕ) •
            (Y.presheaf.map (CategoryTheory.homOfLE
              (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                Finset.mem_image_of_mem I.1 (Finset.mem_univ (r.succAbove t))))).op).hom
              (β ⟨I.1 ∘ r.succAbove, I.2.comp (Fin.strictMono_succAbove r)⟩)) =
        ∑ j : Fin s,
          (Y.presheaf.map (CategoryTheory.homOfLE (hS_aff _ (hI_ne I)).1).op).hom (c j) *
            (((Y.presheaf.map (CategoryTheory.homOfLE (hS_aff _ (hI_ne I)).1).op).hom (f j)) ^ L *
              dN j I) := by
      calc
        (∑ r : Fin (q + 2),
            (-1 : ℤ) ^ (r : ℕ) •
              (Y.presheaf.map (CategoryTheory.homOfLE
                (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                  Finset.mem_image_of_mem I.1 (Finset.mem_univ (r.succAbove t))))).op).hom
                (β ⟨I.1 ∘ r.succAbove, I.2.comp (Fin.strictMono_succAbove r)⟩))
          = ∑ r : Fin (q + 2), ∑ j : Fin s,
              ((Y.presheaf.map (CategoryTheory.homOfLE (hS_aff _ (hI_ne I)).1).op).hom (c j) *
                ((Y.presheaf.map (CategoryTheory.homOfLE (hS_aff _ (hI_ne I)).1).op).hom (f j)) ^ L) *
                ((-1 : ℤ) ^ (r : ℕ) •
                  (Y.presheaf.map (CategoryTheory.homOfLE
                    (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                      Finset.mem_image_of_mem I.1 (Finset.mem_univ (r.succAbove t))))).op).hom
                    (N_sec j ⟨I.1 ∘ r.succAbove, I.2.comp (Fin.strictMono_succAbove r)⟩)) := by
            refine Finset.sum_congr rfl fun r _ => ?_
            dsimp only [β]
            rw [map_sum, Finset.smul_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_mul, hY_map_comp, map_mul, map_pow,
              zsmul_eq_mul, zsmul_eq_mul, mul_left_comm]
        _ = ∑ j : Fin s,
              ((Y.presheaf.map (CategoryTheory.homOfLE (hS_aff _ (hI_ne I)).1).op).hom (c j) *
                ((Y.presheaf.map (CategoryTheory.homOfLE (hS_aff _ (hI_ne I)).1).op).hom (f j)) ^ L) *
                dN j I := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [← Finset.mul_sum]
        _ = ∑ j : Fin s,
              (Y.presheaf.map (CategoryTheory.homOfLE (hS_aff _ (hI_ne I)).1).op).hom (c j) *
                (((Y.presheaf.map (CategoryTheory.homOfLE (hS_aff _ (hI_ne I)).1).op).hom (f j)) ^ L *
