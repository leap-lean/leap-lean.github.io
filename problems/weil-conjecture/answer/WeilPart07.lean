    change (π'_0 h₀_Y) ^ m₂ * π'_0 a₂ = (π'_0 h₀_Y) ^ m₂ * 0 at hm₂
    rw [mul_zero, ← map_pow, ← map_mul] at hm₂
    let b₂ : ↑R₀_Y := h₀_Y ^ m₂ * a₂
    have hb₂_ker : b₂ ∈ RingHom.ker π'_0 := hm₂
    have hb₂_res : j_Y' * res₀_Y (h₀_Y ^ (m₂ + n₂)) = res₀_Y b₂ := by
      dsimp [b₂]
      rw [pow_add, map_mul, map_mul, ← mul_assoc]
      calc
        j_Y' * res₀_Y (h₀_Y ^ m₂) * res₀_Y (h₀_Y ^ n₂) =
            res₀_Y (h₀_Y ^ m₂) * (j_Y' * res₀_Y (h₀_Y ^ n₂)) := by ring
        _ = res₀_Y (h₀_Y ^ m₂) * res₀_Y a₂ := by rw [ha₂]
    let N : ℕ := (m₁ + n₁) + (m₂ + n₂)
