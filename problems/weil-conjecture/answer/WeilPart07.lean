      (∃ (V_P : ValuationSubring P.asIdeal.ResidueField) (e_VP : (↥V ⧸ P.asIdeal) ≃+* ↥V_P),
        ∀ r : ↥V,
          V_P.subtype (e_VP (Ideal.Quotient.mk P.asIdeal r)) =
            algebraMap ↥V P.asIdeal.ResidueField r) ∧
      IsIntegrallyClosed (↥V ⧸ P.asIdeal) ∧
      (∀ (D : Type u) [CommRing D] (φ : Polynomial ↥V →+* D),
        φ.Etale →
        ∀ (p q m_x : Ideal D) [p.IsPrime] [q.IsPrime] [m_x.IsPrime],
          p ∈ (Ideal.map (φ.comp Polynomial.C) P.asIdeal).minimalPrimes →
