      letI : ∀ I : Simp0 p, Module ↥R_β ↥(B_β (Finset.univ.image I.1)) := fun I => modI I
      have : ∀ I : Simp0 p, Module.Flat ↥R_β ↥(B_β (Finset.univ.image I.1)) :=
        fun I => (hRest_S _ (hne_I I)).2.2.2.2.2.2.1
      exact Module.Flat.of_linearEquiv
        (DirectSum.linearEquivFunOnFintype ↥R_β (Simp0 p)
          (fun I => ↥(B_β (Finset.univ.image I.1)))).symm
    let unscale : ∀ (p : ℕ), C_β p → Simp0 p → F :=
      fun _ m I => (m I : F) / (t_loc (I.1 0)) ^ k
    have hunscale_mul : ∀ (p : ℕ) (m : C_β p) (I : Simp0 p),
        (t_loc (I.1 0)) ^ k * unscale p m I = (m I : F) :=
      fun _ m I => mul_div_cancel₀ (m I : F) (pow_ne_zero k (ht_ne (I.1 0)))
    have hunscale_mem : ∀ (p : ℕ) (m : C_β p) (I : Simp0 p),
        (t_loc (I.1 0)) ^ k * unscale p m I ∈ B_β (Finset.univ.image I.1) := by
      intro p m I; rw [hunscale_mul]; exact (m I).2
    have hd_Bβ : ∀ (p : ℕ) (m : C_β p) (J : Simp0 (p + 1)),
        (t_loc (J.1 0)) ^ k *
          (∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
            unscale p m ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩) ∈
          B_β (Finset.univ.image J.1) :=
      fun p m => hd_mem B_β (fun S S' hS hsub => (hModMono S S' hS hsub).1)
        (fun S hS => (hSub_β S hS).2.2.2.2.2.2) p (unscale p m) (hunscale_mem p m)
    let d_β : ∀ p : ℕ, C_β p →ₗ[↥R_β] C_β (p + 1) := fun p =>
      { toFun := fun m J =>
          ⟨(t_loc (J.1 0)) ^ k *
            (∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
              unscale p m ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩),
            hd_Bβ p m J⟩
        map_add' := fun m₁ m₂ => by
          ext J
          change (t_loc (J.1 0)) ^ k * _ = (t_loc (J.1 0)) ^ k * _ + (t_loc (J.1 0)) ^ k * _
          rw [← mul_add, ← Finset.sum_add_distrib]
          congr 1
          refine Finset.sum_congr rfl fun q _ => ?_
          dsimp only [unscale]
          rw [Pi.add_apply, Subring.coe_add]
          ring
        map_smul' := fun r m => by
          ext J
          dsimp only [unscale]
          change (t_loc (J.1 0)) ^ k *
              (∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
                ((φ_VF (R_β.subtype r) * (m ⟨J.1 ∘ q.succAbove, _⟩ : F)) /
                  (t_loc (J.1 (q.succAbove 0))) ^ k)) =
            φ_VF (R_β.subtype r) *
              ((t_loc (J.1 0)) ^ k *
                (∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
                  ((m ⟨J.1 ∘ q.succAbove, _⟩ : F) / (t_loc (J.1 (q.succAbove 0))) ^ k)))
          simp_rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun q _ => by ring }
    have hd_β_unscale : ∀ (p : ℕ) (m : C_β p) (J : Simp0 (p + 1)),
        unscale (p + 1) (d_β p m) J =
          ∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
            unscale p m ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩ := by
      intro p m J
      dsimp only [unscale, d_β, LinearMap.coe_mk, AddHom.coe_mk]
      exact mul_div_cancel_left₀ _ (pow_ne_zero k (ht_ne (J.1 0)))
    have hd_β_sq : ∀ (p : ℕ) (m : C_β p), d_β (p + 1) (d_β p m) = 0 := by
      intro p m
      ext K
      change (t_loc (K.1 0)) ^ k *
        (∑ r : Fin (p + 3), (-1 : F) ^ (r : ℕ) *
          unscale (p + 1) (d_β p m) ⟨K.1 ∘ r.succAbove, K.2.comp (Fin.strictMono_succAbove r)⟩) = 0
      simp_rw [hd_β_unscale p m]
      rw [hd_sq p (unscale p m) K, mul_zero]
    have h_top : ∀ p : ℕ, N + 1 ≤ p → Subsingleton (C_β p) := by
      intro p hp
      refine ⟨fun m₁ m₂ => funext fun I => False.elim ?_⟩
      have hcard := Fintype.card_le_of_injective I.1 I.2.injective
      simp only [Fintype.card_fin] at hcard
      omega
    have h_fg : ∀ q : ℕ,
        ∃ (L : ℕ) (ω : Fin L → C_β (q + 1)),
          (∀ ℓ : Fin L, d_β (q + 1) (ω ℓ) = 0) ∧
          ∀ x : C_β (q + 1), d_β (q + 1) x = 0 →
            ∃ (z : C_β q) (c : Fin L → ↥R_β), x = d_β q z + ∑ ℓ : Fin L, c ℓ • ω ℓ := by
      intro q
      obtain ⟨L, ω_F, hω_F, hspan_F⟩ := h_s4 K V R_β F φ_VF N k B_β D_β₀ D_β₁ D_β₀₁ t_loc
        ht_ne hSub_β hModMono hOverlap hGQ hGM hAcycD hd_sq hd_mem q
      let ω : Fin L → C_β (q + 1) := fun ℓ I => ⟨(t_loc (I.1 0)) ^ k * ω_F ℓ I, (hω_F ℓ).1 I⟩
      have hω_unscale : ∀ (ℓ : Fin L) (I : Simp0 (q + 1)), unscale (q + 1) (ω ℓ) I = ω_F ℓ I :=
        fun ℓ I => mul_div_cancel_left₀ _ (pow_ne_zero k (ht_ne (I.1 0)))
      refine ⟨L, ω, ?_, ?_⟩
      · intro ℓ
        ext J
        change (t_loc (J.1 0)) ^ k * _ = 0
        simp_rw [hω_unscale ℓ]
        rw [(hω_F ℓ).2 J, mul_zero]
      · intro x hx
        have hx_coc : ∀ J : Simp0 (q + 2),
            (∑ r : Fin (q + 3), (-1 : F) ^ (r : ℕ) *
              unscale (q + 1) x ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩) = 0 := by
          intro J
          rw [← hd_β_unscale (q + 1) x J, hx]
          dsimp only [unscale]
          rw [Pi.zero_apply, ZeroMemClass.coe_zero, zero_div]
        obtain ⟨η_F, c, hη_mem, hη_eq⟩ := hspan_F (unscale (q + 1) x) (hunscale_mem (q + 1) x) hx_coc
        let z : C_β q := fun I => ⟨(t_loc (I.1 0)) ^ k * η_F I, hη_mem I⟩
        have hz_unscale : ∀ I : Simp0 q, unscale q z I = η_F I :=
          fun I => mul_div_cancel_left₀ _ (pow_ne_zero k (ht_ne (I.1 0)))
        refine ⟨z, c, ?_⟩
        ext I
        have hI := congrArg ((t_loc (I.1 0)) ^ k * ·) (hη_eq I)
        rw [hunscale_mul, mul_add] at hI
        simp_rw [← hz_unscale] at hI
        change (x I : F) = (d_β q z I : F) + ((∑ ℓ : Fin L, c ℓ • ω ℓ) I : F)
        rw [hI]
        congr 1
        rw [Finset.mul_sum, Finset.sum_apply]
        push_cast
        refine Finset.sum_congr rfl fun ℓ _ => ?_
        change (t_loc (I.1 0)) ^ k * (φ_VF (R_β.subtype (c ℓ)) * ω_F ℓ I) =
          φ_VF (R_β.subtype (c ℓ)) * ((t_loc (I.1 0)) ^ k * ω_F ℓ I)
        ring
    have h_res : ∀ (q : ℕ) (x : C_β (q + 1)),
        d_β (q + 1) x ∈ (IsLocalRing.maximalIdeal ↥R_β) • (⊤ : Submodule ↥R_β (C_β (q + 2))) →
        ∃ w : C_β q,
          d_β q w - x ∈ (IsLocalRing.maximalIdeal ↥R_β) • (⊤ : Submodule ↥R_β (C_β (q + 1))) := by
      intro q x hx
      let 𝔪_β := IsLocalRing.maximalIdeal ↥R_β
      let 𝔪_V := IsLocalRing.maximalIdeal ↥V
      have h_comp_V : ∀ u : C_β (q + 2),
          u ∈ 𝔪_β • (⊤ : Submodule ↥R_β (C_β (q + 2))) →
          ∀ J : Simp0 (q + 2),
            ∃ (π_J : ↥V) (b_J : F),
              π_J ∈ 𝔪_V ∧ b_J ∈ B (Finset.univ.image J.1) ∧ (u J : F) = φ_VF π_J * b_J := by
        intro u hu
        refine Submodule.smul_induction_on hu ?_ ?_
        · intro r hr m _ J
          have hr_V : R_β.subtype r ∈ 𝔪_V :=
            (IsLocalRing.mem_maximalIdeal (R_β.subtype r)).mpr fun hu_V =>
              (IsLocalRing.mem_maximalIdeal r).mp hr (IsLocalHom.map_nonunit r hu_V)
          exact ⟨R_β.subtype r, (m J : F), hr_V, hle_S _ (hne_I J) (m J).2, rfl⟩
        · intro u₁ u₂ ih₁ ih₂ J
          obtain ⟨π₁, b₁, hπ₁, hb₁, heq₁⟩ := ih₁ J
          obtain ⟨π₂, b₂, hπ₂, hb₂, heq₂⟩ := ih₂ J
          rcases ValuationRing.dvd_total π₁ π₂ with ⟨v, rfl⟩ | ⟨v, rfl⟩
          · refine ⟨π₁, b₁ + φ_VF v * b₂, hπ₁,
              Subring.add_mem _ hb₁ (Subring.mul_mem _ (hB_V _ (hne_I J) v) hb₂), ?_⟩
            change (u₁ J : F) + (u₂ J : F) = _
            rw [heq₁, heq₂, map_mul]
            ring
          · refine ⟨π₂, φ_VF v * b₁ + b₂, hπ₂,
              Subring.add_mem _ (Subring.mul_mem _ (hB_V _ (hne_I J) v) hb₁) hb₂, ?_⟩
            change (u₁ J : F) + (u₂ J : F) = _
            rw [heq₁, heq₂, map_mul]
            ring
      have hx_coc_V := h_comp_V (d_β (q + 1) x) hx
      obtain ⟨η_β, hηβ_mem, hηβ_diff⟩ := h_s3 K V R_β hLocHom F φ_VF N k B B_β t_loc
        ht_ne hB_mono (fun S S' hS hsub => (hModMono S S' hS hsub).1)
        (fun S hS => (hSub_β S hS).2.2.2.2.2.2) hBaseChange_β hAcyclic_mod
        q (unscale (q + 1) x) (hunscale_mem (q + 1) x) hx_coc_V
      let w : C_β q := fun I => ⟨(t_loc (I.1 0)) ^ k * η_β I, hηβ_mem I⟩
      have hw_unscale : ∀ I : Simp0 q, unscale q w I = η_β I :=
        fun I => mul_div_cancel_left₀ _ (pow_ne_zero k (ht_ne (I.1 0)))
      refine ⟨w, ?_⟩
      let diff_x : C_β (q + 1) := d_β q w - x
      have h_sum_pi : diff_x = ∑ I : Simp0 (q + 1), Pi.single I (diff_x I) := by
        ext J; simp
      change diff_x ∈ (IsLocalRing.maximalIdeal ↥R_β) • (⊤ : Submodule ↥R_β (C_β (q + 1)))
      rw [h_sum_pi]
      refine Submodule.sum_mem _ fun I _ => ?_
      obtain ⟨d_I, hd_I_mem, hd_I_eq⟩ := hηβ_diff I (hR_S _ (hne_I I))
      have hdiff_eq : diff_x I = d_I := by
        apply Subtype.ext
        change (d_β q w I : F) - (x I : F) = (d_I : F)
        rw [← hd_I_eq, mul_sub, hunscale_mul]
        congr 1
        dsimp only [d_β, LinearMap.coe_mk, AddHom.coe_mk]
        simp_rw [hw_unscale]
      rw [hdiff_eq]
      letI : Module ↥R_β ↥(B_β (Finset.univ.image I.1)) := modI I
      refine Submodule.smul_induction_on hd_I_mem ?_ ?_
      · intro r hr b_I _
        have h_single_smul : (Pi.single I (r • b_I) : C_β (q + 1)) = r • Pi.single I b_I := by
          ext J
          by_cases hJI : J = I
          · subst hJI; simp
          · simp [Pi.single_eq_of_ne hJI]
        rw [h_single_smul]
        exact Submodule.smul_mem_smul hr Submodule.mem_top
      · intro b₁ b₂ h₁ h₂
        rw [Pi.single_add]
        exact Submodule.add_mem _ h₁ h₂
    have hy_β_mem : ∀ I : Simp0 1,
        (t_loc (I.1 0)) ^ k * y I ∈ B_β (Finset.univ.image I.1) := by
      intro I
      exact (hModS _ (hne_I I)).1 _ (Finset.mem_image_of_mem _ (Finset.mem_univ I)) (hy_mem I)
    let y_β : C_β 1 := fun I => ⟨(t_loc (I.1 0)) ^ k * y I, hy_β_mem I⟩
    have hy_β_coc : d_β 1 y_β = 0 := by
      ext J
      change (t_loc (J.1 0)) ^ k * _ = 0
      have hy_unscale : ∀ I : Simp0 1, unscale 1 y_β I = y I :=
        fun I => mul_div_cancel_left₀ _ (pow_ne_zero k (ht_ne (I.1 0)))
      simp_rw [hy_unscale]
      rw [hy_cocycle J, mul_zero]
    obtain ⟨z_β, hz_β⟩ := h_s5 ↥R_β N C_β d_β hd_β_sq h_top h_fg h_res 0 y_β hy_β_coc
    apply hReconstruct (unscale 0 z_β)
    · intro I
      exact hle_S _ (hne_I I) (hunscale_mem 0 z_β I)
    · intro I
      rw [← hd_β_unscale 0 z_β I, hz_β]
      exact mul_div_cancel_left₀ _ (pow_ne_zero k (ht_ne (I.1 0)))

theorem weil_cocycle_on_tagged_cover_to_polar_projLine_map (K : Type u) [Field K]
    (V : ValuationSubring K)
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (r_pts : ℕ)
    (γ_div : Fin (r_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
    (W_div : Fin (r_pts + 1) → C_semi.Opens)
    (t_div : ∀ i : Fin (r_pts + 1), ↑(C_semi.presheaf.obj (Opposite.op (W_div i))))
    (hLift : IsLiftedSmoothDivisorSystem V g_semi r_pts γ_div W_div t_div)
    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (N : ℕ) (W : Fin (N + 1) → C_semi.Opens)
    (tag : Fin (N + 1) → Option (Fin (r_pts + 1)))
    (B : Finset (Fin (N + 1)) → Subring F)
    (t_loc : Fin (N + 1) → F)
    (φ_cov : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
      ↑(C_semi.presheaf.obj (Opposite.op (Finset.inf S W))) ≃+* ↥(B S))
    (hCov : IsDivisorAdaptedSubringCover V g_semi r_pts γ_div W_div t_div F φ_VF
      N W tag B t_loc φ_cov)
    (k : ℕ) (hk : 1 ≤ k)
    (x_glob : Fin (N + 1) → F)
    (hx_mem : ∀ a : Fin (N + 1), x_glob a ∈ B {a})
    (hx_cocycle : ∀ a b : Fin (N + 1), x_glob b * (t_loc a / t_loc b) ^ k = x_glob a)
    (hx_unit : ∀ (i : Fin (r_pts + 1)) (a : Fin (N + 1)),
      tag a = some i →
      ∀ h_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens) ≤
          (TopologicalSpace.Opens.map (γ_div i).base).obj (Finset.inf {a} W),
        IsUnit
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).hom.hom
            (((γ_div i).appLE (Finset.inf {a} W) ⊤ h_top).hom
              ((φ_cov {a} (Finset.singleton_nonempty a)).symm ⟨x_glob a, hx_mem a⟩)))) :
    ∃ (π : C_semi ⟶ (weilProjectiveSpaceOver ↥V 1).left),
      π ≫ (weilProjectiveSpaceOver ↥V 1).hom = g_semi ∧
      (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) ↥V) :=
        MvPolynomial.gradedAlgebra
       ((TopologicalSpace.Opens.map π.base).obj
         (AlgebraicGeometry.Proj.basicOpen
           (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) ↥V) (MvPolynomial.X 0)) :
         Set ↥C_semi) =
       (⋃ i : Fin (r_pts + 1), Set.range (γ_div i).base)ᶜ) :=
by
  
  have hCl_γ : ∀ i : Fin (r_pts + 1), IsClosed (Set.range (γ_div i).base) := by
    intro i
    haveI : AlgebraicGeometry.IsClosedImmersion (γ_div i) := (hLift.1 i).2.1
    exact (γ_div i).isClosedEmbedding.isClosed_range
  have hZ_cl : IsClosed (⋃ i : Fin (r_pts + 1), Set.range (γ_div i).base) :=
    isClosed_iUnion_of_finite hCl_γ
  let U₀ : C_semi.Opens := ⟨(⋃ i : Fin (r_pts + 1), Set.range (γ_div i).base)ᶜ, hZ_cl.isOpen_compl⟩
  have hBasic_div : ∀ i : Fin (r_pts + 1), C_semi.basicOpen (t_div i) = W_div i ⊓ U₀ := by
    intro i
    apply TopologicalSpace.Opens.ext
    ext x
    have h1 : (C_semi.basicOpen (t_div i) : Set ↥C_semi) =
        (W_div i : Set ↥C_semi) \ Set.range (γ_div i).base := (hLift.1 i).2.2.2.2.2
    change x ∈ (C_semi.basicOpen (t_div i) : Set ↥C_semi) ↔
      x ∈ (W_div i : Set ↥C_semi) ∧ x ∈ (⋃ j : Fin (r_pts + 1), Set.range (γ_div j).base)ᶜ
    rw [h1]
    constructor
    · rintro ⟨hxW, hx_not_i⟩
      refine ⟨hxW, ?_⟩
      intro hxU
      rcases Set.mem_iUnion.mp hxU with ⟨j, hxj⟩
      by_cases hij : i = j
      · subst hij
        exact hx_not_i hxj
      · exact Set.disjoint_left.mp (hLift.2.1 i j hij) hxW hxj
    · rintro ⟨hxW, hx_not_U⟩
      exact ⟨hxW, fun hxi => hx_not_U (Set.mem_iUnion.mpr ⟨i, hxi⟩)⟩
  have h_udiv : ∀ i : Fin (r_pts + 1),
      ∃ u : ↑(C_semi.presheaf.obj (Opposite.op (C_semi.basicOpen (t_div i)))),
        (C_semi.presheaf.map
          (CategoryTheory.homOfLE (C_semi.basicOpen_le (t_div i))).op).hom
            (t_div i) * u = 1 :=
    fun i => (show IsUnit ((C_semi.presheaf.map
      (CategoryTheory.homOfLE (C_semi.basicOpen_le (t_div i))).op).hom (t_div i)) from
        C_semi.toRingedSpace.isUnit_res_basicOpen (t_div i)).exists_right_inv
  choose u_div hu_div using h_udiv
  
  obtain ⟨_hInjVF, hSupW, _hCov_aff, hCov_mono, ht_mem, _ht_ratio, hCov_tag, hCov_cover⟩ := hCov
  let W₁ : Fin (N + 1) → C_semi.Opens := fun a => Finset.inf {a} W
  have hW₁_eq : ∀ a : Fin (N + 1), W₁ a = W a := fun a => Finset.inf_singleton
  let s_loc : ∀ a : Fin (N + 1), ↑(C_semi.presheaf.obj (Opposite.op (W₁ a))) :=
    fun a => (φ_cov {a} (Finset.singleton_nonempty a)).symm ⟨x_glob a, hx_mem a⟩
  have hs_loc_val : ∀ a : Fin (N + 1),
      ((φ_cov {a} (Finset.singleton_nonempty a) (s_loc a) : ↥(B {a})) : F) = x_glob a :=
    fun a => congrArg Subtype.val
      ((φ_cov {a} (Finset.singleton_nonempty a)).apply_symm_apply ⟨x_glob a, hx_mem a⟩)
  have h_τν : ∀ a : Fin (N + 1),
      ∃ (τ : ↑(C_semi.presheaf.obj (Opposite.op (W₁ a))))
        (ν : ↑(C_semi.presheaf.obj (Opposite.op (W₁ a ⊓ U₀)))),
        ((φ_cov {a} (Finset.singleton_nonempty a) τ : ↥(B {a})) : F) = t_loc a ∧
        (C_semi.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₁ a ⊓ U₀ ≤ W₁ a)).op).hom τ *
          ν = 1 ∧
        (∀ (i : Fin (r_pts + 1)), tag a = some i → ∀ (h_le : W₁ a ≤ W_div i),
          τ = (C_semi.presheaf.map (CategoryTheory.homOfLE h_le).op).hom (t_div i)) := by
    intro a
    cases htag : tag a with
    | none =>
      refine ⟨1, 1, ?_, ?_, ?_⟩
      · have ht1 : t_loc a = 1 := ((hCov_tag a).1 htag).2
        rw [ht1, map_one]
        rfl
      · simp
      · intro i hi
        cases hi
    | some i =>
      obtain ⟨hWa_div, h_le, ht_eq⟩ := (hCov_tag a).2 i htag
      have h_bo_le : W₁ a ⊓ U₀ ≤ C_semi.basicOpen (t_div i) := by
        rw [hBasic_div i]
        exact inf_le_inf_right U₀ h_le
      refine ⟨(C_semi.presheaf.map (CategoryTheory.homOfLE h_le).op).hom (t_div i),
        (C_semi.presheaf.map (CategoryTheory.homOfLE h_bo_le).op).hom (u_div i),
        ht_eq.symm, ?_, ?_⟩
      · have hres : (C_semi.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : W₁ a ⊓ U₀ ≤ W₁ a)).op).hom
            ((C_semi.presheaf.map (CategoryTheory.homOfLE h_le).op).hom (t_div i)) =
            (C_semi.presheaf.map (CategoryTheory.homOfLE h_bo_le).op).hom
              ((C_semi.presheaf.map
                (CategoryTheory.homOfLE (C_semi.basicOpen_le (t_div i))).op).hom
                (t_div i)) := by
          change (C_semi.presheaf.map _ ≫ C_semi.presheaf.map _).hom (t_div i) =
