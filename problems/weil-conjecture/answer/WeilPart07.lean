            dsimp only
            rw [AlgEquiv.symm_apply_apply, AlgEquiv.symm_apply_apply, RingEquiv.symm_apply_apply]
          right_inv := fun t => by
            dsimp only
            rw [RingEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]
