    have heZ_𝔓 : eZ ∈ 𝔓 := (h𝔓_prime.mem_or_mem heZeY_𝔓).resolve_right heY_not_𝔓
    letI : Algebra ↥V ↑R₀ := c₀.toAlgebra
    let I_Y' : Ideal ↑R₀ := Ideal.span ({h₀, eZ} : Set ↑R₀)
    let B_Y' := ↑R₀ ⧸ I_Y'
    let q_Y' : ↑R₀ →+* B_Y' := Ideal.Quotient.mk I_Y'
    have hInt_BY' : Algebra.IsIntegral ↥V B_Y' :=
      @Algebra.IsIntegral.of_finite ↥V B_Y' _ _ _ hFin_BY'
    have hker_q_le : RingHom.ker q_Y' ≤ 𝔓 := by
      rw [Ideal.mk_ker, Ideal.span_le]
      intro u hu
      rcases Set.mem_insert_iff.mp hu with rfl | hu'
      · exact hh₀_𝔓
      · rw [Set.mem_singleton_iff.mp hu']
        exact heZ_𝔓
    let 𝔓_bar : Ideal B_Y' := Ideal.map q_Y' 𝔓
    have h𝔓_bar_prime : 𝔓_bar.IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_q_le
    have hunder_le : Ideal.under ↥V 𝔓_bar ≤ 𝔪_V :=
      IsLocalRing.le_maximalIdeal (Ideal.comap_ne_top _ h𝔓_bar_prime.ne_top)
    obtain ⟨𝔐_bar, h𝔓_le_𝔐_bar, h𝔐_bar_prime, h𝔐_under⟩ :=
      @Ideal.exists_ideal_over_prime_of_isIntegral ↥V _ B_Y' _ _ hInt_BY'
        𝔪_V hMaxPrime 𝔓_bar hunder_le
    letI : 𝔐_bar.IsPrime := h𝔐_bar_prime
    let 𝔐 : Ideal ↑R₀ := Ideal.comap q_Y' 𝔐_bar
    have h𝔐_prime : 𝔐.IsPrime := Ideal.IsPrime.comap q_Y'
    have h𝔓_le_𝔐 : 𝔓 ≤ 𝔐 := fun z hz => h𝔓_le_𝔐_bar (Ideal.mem_map_of_mem q_Y' hz)
    have hcomap_c₀ : Ideal.comap c₀ 𝔐 = 𝔪_V := by
      change Ideal.comap (q_Y'.comp c₀) 𝔐_bar = 𝔪_V
      exact h𝔐_under
    have hker_π₀_le : RingHom.ker π₀ ≤ 𝔐 := by
      rw [hKer₀, Ideal.map_le_iff_le_comap, hcomap_c₀]
    let 𝔐_Y : Ideal ↑R₀_Y := Ideal.map π₀ 𝔐
    have h𝔐_Y_prime : 𝔐_Y.IsPrime :=
      @Ideal.map_isPrime_of_surjective _ _ _ _ _ _ _ π₀ hSurj₀ 𝔐 h𝔐_prime hker_π₀_le
    let p_Y : PrimeSpectrum ↑R₀_Y := ⟨𝔐_Y, h𝔐_Y_prime⟩
    have hπ₀_h₀_mem : π₀ h₀ ∈ p_Y.asIdeal := Ideal.mem_map_of_mem π₀ (h𝔓_le_𝔐 hh₀_𝔓)
    have hπ₀_eZ_mem : π₀ eZ ∈ p_Y.asIdeal := Ideal.mem_map_of_mem π₀ (h𝔓_le_𝔐 heZ_𝔓)
    have hπ₀_x₀_mem : π₀ x₀ ∈ p_Y.asIdeal := Ideal.mem_map_of_mem π₀ (h𝔓_le_𝔐 hx₀_𝔓)
    let y₀ : ↥Y := hAff_V₀_Y.fromSpec.base p_Y
    have hpre_bo : ∀ a : ↑R₀, fstY ⁻¹ᵁ C.basicOpen a = Y.basicOpen (π₀ a) := by
      intro a
      rw [fstY.preimage_basicOpen a]
      have happ : fstY.appLE V₀ V₀_Y le_rfl = fstY.app V₀ :=
        AlgebraicGeometry.Scheme.Hom.appLE_eq_app fstY
      rw [← happ]
    have hy₀_bo_iff : ∀ a : ↑R₀, y₀ ∈ (Y.basicOpen (π₀ a) : Set ↥Y) ↔ π₀ a ∉ p_Y.asIdeal := by
      intro a
      change p_Y ∈ (hAff_V₀_Y.fromSpec ⁻¹ᵁ Y.basicOpen (π₀ a)) ↔ π₀ a ∉ p_Y.asIdeal
      rw [hAff_V₀_Y.fromSpec_preimage_basicOpen (π₀ a)]
      rfl
    have hy₀_V₀Y : y₀ ∈ (V₀_Y : Set ↥Y) := by
      rw [← hAff_V₀_Y.range_fromSpec]
      exact ⟨p_Y, rfl⟩
    have hy₀_not_V₁Y : y₀ ∉ (V₁_Y : Set ↥Y) := by
      intro hy₁
      have hy₀₁ : y₀ ∈ ((V₀_Y ⊓ V₁_Y : Y.Opens) : Set ↥Y) := ⟨hy₀_V₀Y, hy₁⟩
      have hy_boh₀ : y₀ ∈ (Y.basicOpen (π₀ h₀) : Set ↥Y) := by
        rw [← hpre_bo h₀, h_bo_h₀]
        exact hy₀₁
      exact (hy₀_bo_iff h₀).mp hy_boh₀ hπ₀_h₀_mem
    have hy₀_not_eZ : fstY.base y₀ ∉ (C.basicOpen eZ : Set C) := by
      intro hyeZ
      have hy_boeZ : y₀ ∈ (Y.basicOpen (π₀ eZ) : Set ↥Y) := by
        rw [← hpre_bo eZ]
        exact hyeZ
      exact (hy₀_bo_iff eZ).mp hy_boeZ hπ₀_eZ_mem
    have hy₀_not_Z : y₀ ∉ Z := by
      intro hyZ
      rcases hZ_sub hyZ with hyV₁ | hyeZ
      · exact hy₀_not_V₁Y hyV₁
      · exact hy₀_not_eZ hyeZ
    have hy₀_univ : y₀ ∈ Z ∪ (⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E') := by
      rw [hCov_ZY']
      trivial
    have hy₀_Y' : y₀ ∈ ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E' :=
      hy₀_univ.resolve_left hy₀_not_Z
    have hy₀_box₀ : y₀ ∈ (Y.basicOpen (π₀ x₀) : Set ↥Y) :=
      hSub ⟨hy₀_Y', hy₀_not_V₁Y⟩
    exact (hy₀_bo_iff x₀).mp hy₀_box₀ hπ₀_x₀_mem
  exact ⟨hDom₀, hDom₁, hDom₀₁, hh₀_ne, ht₀_ne, hLoc₀, hLoc₁,
    hInj₀, hInj₁, hc₀_compat, hc₁_compat, hTorsFree₁,
    hSurj₀, hSurj₁, hSurj₀₁, hKer₁, hKer₀₁,
    hComm₀, hComm₁, hc₁Y_compat, hInj_res₀_Y, hGoingUp⟩

theorem weil_sup1_valuation_saturated_submodule_fg_and_basis_lift (K : Type u) [Field K]
    (V : ValuationSubring K) :
    (∀ (L : ℕ) (N : Submodule ↥V (Fin L → ↥V)),
      (∀ (v : ↥V) (x : Fin L → ↥V), v ≠ 0 → v • x ∈ N → x ∈ N) → N.FG) ∧
    (∀ (R₁ R₁_Y : Type u) [CommRing R₁] [Algebra ↥V R₁] [CommRing R₁_Y]
       [Algebra (IsLocalRing.maximalIdeal ↥V).ResidueField R₁_Y]
       (π₁ : R₁ →+* R₁_Y),
      (∀ v : ↥V, π₁ (algebraMap ↥V R₁ v) =
        algebraMap (IsLocalRing.maximalIdeal ↥V).ResidueField R₁_Y
          (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField v)) →
      Function.Surjective π₁ →
      (∀ (v : ↥V) (r : R₁), v ≠ 0 → v • r = 0 → r = 0) →
      (∀ (M₁ : Submodule ↥V R₁) (f₁_bar : R₁_Y),
        M₁.FG →
        (1 : R₁) ∈ M₁ →
        (∃ u₁ ∈ M₁, π₁ u₁ = f₁_bar) →
        (∀ x ∈ M₁, π₁ x = 0 → x ∈ (IsLocalRing.maximalIdeal ↥V) • M₁) →
        (∀ (c₀ c₁ : (IsLocalRing.maximalIdeal ↥V).ResidueField),
          algebraMap (IsLocalRing.maximalIdeal ↥V).ResidueField R₁_Y c₀ + c₁ • f₁_bar = 0 →
          c₀ = 0 ∧ c₁ = 0) →
        ∃ (N' : ℕ) (f : Fin (N' + 1) → R₁),
          1 ≤ N' ∧
          f 0 = 1 ∧
          π₁ (f (1 : Fin (N' + 1))) = f₁_bar ∧
          (∀ a : Fin (N' + 1), f a ∈ M₁) ∧
          (∀ y : R₁_Y, y ∈ π₁ '' (M₁ : Set R₁) →
            y ∈ Submodule.span (IsLocalRing.maximalIdeal ↥V).ResidueField (Set.range (π₁ ∘ f))) ∧
          (∀ (r : ℕ) (M_r : Submodule ↥V R₁),
            1 ≤ r →
            M_r.FG →
            M₁ ^ r ≤ M_r →
            (∀ x ∈ M_r, π₁ x = 0 → x ∈ (IsLocalRing.maximalIdeal ↥V) • M_r) →
            (∀ x ∈ M_r, π₁ x ∈
              (Submodule.span (IsLocalRing.maximalIdeal ↥V).ResidueField
                (Set.range (π₁ ∘ f))) ^ r) →
            ∃ (D_r : ℕ) (B_r : Fin D_r → MvPolynomial (Fin (N' + 1)) ↥V),
              (∀ i : Fin D_r, B_r i ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) ↥V r) ∧
              (∀ x₁ : R₁, x₁ ∈ M_r ↔
                ∃ c : Fin D_r → ↥V, x₁ = ∑ i : Fin D_r, c i • MvPolynomial.aeval f (B_r i)) ∧
              (∀ c : Fin D_r → ↥V,
                (∑ i : Fin D_r, c i • MvPolynomial.aeval f (B_r i)) = 0 → ∀ i : Fin D_r, c i = 0)))) :=
by
  have hMinDvd : ∀ (n : ℕ) (u : Fin (n + 1) → ↥V),
      ∃ i₀ : Fin (n + 1), ∀ i : Fin (n + 1), u i₀ ∣ u i := by
    intro n
    induction n with
    | zero =>
      intro u
      refine ⟨0, fun i => ?_⟩
      rw [Fin.eq_zero i]
    | succ n ih =>
      intro u
      obtain ⟨j₀, hj₀⟩ := ih (fun j => u j.succ)
      rcases ValuationRing.dvd_total (u 0) (u j₀.succ) with h0 | h1
      · refine ⟨0, fun i => ?_⟩
        refine Fin.cases (dvd_refl (u 0)) (fun j => ?_) i
        exact dvd_trans h0 (hj₀ j)
      · refine ⟨j₀.succ, fun i => ?_⟩
        refine Fin.cases h1 (fun j => ?_) i
        exact hj₀ j
  refine ⟨?_, ?_⟩
  · intro L
    induction L with
    | zero =>
      intro N _hSat
      have hN_bot : N = ⊥ := by
        rw [eq_bot_iff]
        intro x _hx
        rw [Submodule.mem_bot]
        funext i
        exact Fin.elim0 i
      rw [hN_bot]
      exact Submodule.fg_bot
    | succ L ih =>
      intro N hSat
      by_cases hN : N = ⊥
      · rw [hN]
        exact Submodule.fg_bot
      · have ⟨u, hu_mem, hu_ne⟩ : ∃ u ∈ N, u ≠ 0 := by
          by_contra! h_all_zero
          refine hN (eq_bot_iff.mpr fun x hx => ?_)
          rw [h_all_zero x hx]
          exact Submodule.zero_mem ⊥
        obtain ⟨i₀, hdvd⟩ := hMinDvd L u
        have hv₀_ne : u i₀ ≠ 0 := by
          intro h0
          apply hu_ne
          funext j
          exact zero_dvd_iff.mp (h0 ▸ hdvd j)
        let e₀ : Fin (L + 1) → ↥V := fun i =>
          if i = i₀ then 1 else Classical.choose (hdvd i)
        have he₀_i₀ : e₀ i₀ = 1 := by simp [e₀]
        have hv₀_e₀ : u i₀ • e₀ = u := by
          funext i
          simp only [Pi.smul_apply, smul_eq_mul, e₀]
          split_ifs with hi
          · subst hi
            exact mul_one (u i)
          · exact (Classical.choose_spec (hdvd i)).symm
        have he₀_mem : e₀ ∈ N := hSat (u i₀) e₀ hv₀_ne (hv₀_e₀.symm ▸ hu_mem)
        let ι₀ : (Fin L → ↥V) →ₗ[↥V] (Fin (L + 1) → ↥V) :=
          { toFun := fun y => Fin.insertNth (α := fun _ => ↥V) i₀ 0 y
            map_add' := fun y₁ y₂ => by
              funext j
              refine Fin.succAboveCases (α := fun j =>
                Fin.insertNth (α := fun _ => ↥V) i₀ 0 (y₁ + y₂) j =
                  (Fin.insertNth (α := fun _ => ↥V) i₀ 0 y₁ +
                    Fin.insertNth (α := fun _ => ↥V) i₀ 0 y₂) j) i₀ ?_ ?_ j
              · simp [Fin.insertNth_apply_same]
              · intro k
                simp [Fin.insertNth_apply_succAbove]
            map_smul' := fun c y => by
              funext j
              refine Fin.succAboveCases (α := fun j =>
                Fin.insertNth (α := fun _ => ↥V) i₀ 0 (c • y) j =
                  (c • Fin.insertNth (α := fun _ => ↥V) i₀ 0 y) j) i₀ ?_ ?_ j
              · simp [Fin.insertNth_apply_same]
              · intro k
                simp [Fin.insertNth_apply_succAbove] }
        let N₀ : Submodule ↥V (Fin L → ↥V) := Submodule.comap ι₀ N
        have hN₀_sat : ∀ (v : ↥V) (y : Fin L → ↥V), v ≠ 0 → v • y ∈ N₀ → y ∈ N₀ := by
          intro v y hv hvy
          change ι₀ y ∈ N
          have hvy' : v • ι₀ y ∈ N := by
            rw [← map_smul]
            exact hvy
          exact hSat v (ι₀ y) hv hvy'
        have hN₀_fg : N₀.FG := ih N₀ hN₀_sat
        have : RingHomSurjective (RingHom.id ↥V) := ⟨Function.surjective_id⟩
        have hN_eq : N = Submodule.span ↥V {e₀} ⊔ Submodule.map ι₀ N₀ := by
          apply le_antisymm
          · intro x hx
            let x_rem : Fin (L + 1) → ↥V := x - x i₀ • e₀
            have hx_rem_mem : x_rem ∈ N := N.sub_mem hx (N.smul_mem (x i₀) he₀_mem)
            have hx_rem_i₀ : x_rem i₀ = 0 := by
              simp [x_rem, he₀_i₀]
            let y : Fin L → ↥V := Fin.removeNth (α := fun _ => ↥V) i₀ x_rem
            have hιy : ι₀ y = x_rem := by
              change Fin.insertNth (α := fun _ => ↥V) i₀ 0
                (Fin.removeNth (α := fun _ => ↥V) i₀ x_rem) = x_rem
              rw [← hx_rem_i₀]
              exact Fin.insertNth_self_removeNth i₀ x_rem
            have hy_N₀ : y ∈ N₀ := by
              change ι₀ y ∈ N
              rwa [hιy]
            have hx_rem_map : x_rem ∈ Submodule.map ι₀ N₀ := ⟨y, hy_N₀, hιy⟩
            have hx_e₀ : x i₀ • e₀ ∈ Submodule.span ↥V ({e₀} : Set (Fin (L + 1) → ↥V)) :=
              Submodule.smul_mem _ (x i₀) (Submodule.mem_span_singleton_self e₀)
            have hx_sum : x = x i₀ • e₀ + x_rem := by
              dsimp [x_rem]
              abel
            rw [hx_sum]
            exact Submodule.add_mem_sup hx_e₀ hx_rem_map
          · exact sup_le (Submodule.span_le.mpr (Set.singleton_subset_iff.mpr he₀_mem))
              (Submodule.map_comap_le ι₀ N)
        rw [hN_eq]
        exact (Submodule.fg_span_singleton e₀).sup (hN₀_fg.map ι₀)
  · intro R₁ R₁_Y _ _ _ _ π₁ hCompat _hSurj hTorsFree M₁ f₁_bar hM₁_fg h1_mem
      ⟨u₁, hu₁_mem, hu₁_pi⟩ _hM₁_ker _hLinIndep01
    let 𝔪_V : Ideal ↥V := IsLocalRing.maximalIdeal ↥V
    let k₀ := 𝔪_V.ResidueField
    let σ : ↥V →+* k₀ := algebraMap ↥V k₀
    have hσ_surj : Function.Surjective σ := Ideal.algebraMap_residueField_surjective 𝔪_V
    have : RingHomSurjective σ := ⟨hσ_surj⟩
    have : RingHomSurjective (RingHom.id ↥V) := ⟨Function.surjective_id⟩
    let π₁_sl : R₁ →ₛₗ[σ] R₁_Y :=
      { toFun := π₁
        map_add' := map_add π₁
        map_smul' := fun v r => by
          rw [Algebra.smul_def, map_mul, hCompat v, ← Algebra.smul_def] }
    obtain ⟨m, g₀, hg₀⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hM₁_fg
    let N' : ℕ := m + 1
    let f : Fin (N' + 1) → R₁ :=
      Fin.cons (α := fun _ => R₁) 1 (Fin.cons (α := fun _ => R₁) u₁ g₀)
    have hN'_pos : 1 ≤ N' := Nat.le_add_left 1 m
    have hf0 : f 0 = 1 := Fin.cons_zero _ _
    have hf1_eq : f (1 : Fin (N' + 1)) = u₁ := by
      have h1_idx : (1 : Fin (N' + 1)) = (0 : Fin N').succ := by
        ext
        change 1 % (m + 2) = 1
        exact Nat.mod_eq_of_lt (by omega)
      rw [h1_idx]
      simp [f]
    have hf1_pi : π₁ (f (1 : Fin (N' + 1))) = f₁_bar := by
      rw [hf1_eq, hu₁_pi]
    have hf_mem : ∀ a : Fin (N' + 1), f a ∈ M₁ := by
      intro a
      refine Fin.cases ?_ (fun b => ?_) a
      · simpa [f] using h1_mem
      · refine Fin.cases ?_ (fun j => ?_) b
        · simpa [f] using hu₁_mem
        · have hj : g₀ j ∈ M₁ := by
            rw [← hg₀]
            exact Submodule.subset_span ⟨j, rfl⟩
          simpa [f] using hj
    have hf_span_V : Submodule.span ↥V (Set.range f) = M₁ := by
      apply le_antisymm
      · rw [Submodule.span_le]
        rintro _ ⟨a, rfl⟩
        exact hf_mem a
      · rw [← hg₀]
        apply Submodule.span_mono
        rintro _ ⟨j, rfl⟩
        exact ⟨j.succ.succ, by simp [f]⟩
    let S_k : Submodule k₀ R₁_Y := Submodule.span k₀ (Set.range (π₁ ∘ f))
    have hM₁_map : Submodule.map π₁_sl M₁ = S_k := by
      rw [← hf_span_V, Submodule.map_span]
      have h_img : (⇑π₁_sl '' Set.range f) = Set.range (π₁ ∘ f) := by
        rw [← Set.range_comp]
        rfl
      rw [h_img]
    have hf_span_Y : ∀ y : R₁_Y, y ∈ π₁ '' (M₁ : Set R₁) → y ∈ S_k := by
      rintro y ⟨x, hx, rfl⟩
      rw [← hM₁_map]
      exact ⟨x, hx, rfl⟩
    have hLiftPow : ∀ k : ℕ, 1 ≤ k → ∀ y ∈ S_k ^ k, ∃ x ∈ M₁ ^ k, π₁ x = y := by
      intro k hk
      induction k with
      | zero => omega
      | succ k ih =>
        rcases Nat.eq_zero_or_pos k with rfl | hk_pos
        · intro y hy
          rw [zero_add, pow_one] at hy ⊢
          rw [← hM₁_map] at hy
          rcases Submodule.mem_map.mp hy with ⟨x, hx, hxy⟩
          exact ⟨x, hx, hxy⟩
        · intro y hy
          rw [pow_succ] at hy ⊢
          refine Submodule.mul_induction_on hy ?_ ?_
          · intro u_bar hu_bar v_bar hv_bar
            obtain ⟨u, hu, rfl⟩ := ih hk_pos u_bar hu_bar
            rw [← hM₁_map] at hv_bar
            rcases Submodule.mem_map.mp hv_bar with ⟨v, hv, rfl⟩
            exact ⟨u * v, Submodule.mul_mem_mul hu hv, map_mul π₁ u v⟩
          · rintro y₁ y₂ ⟨x₁, hx₁, rfl⟩ ⟨x₂, hx₂, rfl⟩
            exact ⟨x₁ + x₂, Submodule.add_mem _ hx₁ hx₂, map_add π₁ x₁ x₂⟩
    refine ⟨N', f, hN'_pos, hf0, hf1_pi, hf_mem, hf_span_Y, ?_⟩
    intro r M_r hr hMr_fg hPow_le hMr_ker hMr_span
    let 𝒜_r : Submodule ↥V (MvPolynomial (Fin (N' + 1)) ↥V) :=
      MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) ↥V r
    let N_r : Submodule ↥V R₁ :=
      Submodule.map (MvPolynomial.aeval f).toLinearMap 𝒜_r
    have hNr_eq : N_r = M₁ ^ r := by
      dsimp [N_r, 𝒜_r]
      rw [← MvPolynomial.homogeneousSubmodule_one_pow,
        Submodule.map_pow _ (MvPolynomial.aeval f) r,
        MvPolynomial.homogeneousSubmodule_one_eq_span_X]
      have h_map1 : Submodule.map (MvPolynomial.aeval f).toLinearMap
          (Submodule.span ↥V (Set.range MvPolynomial.X)) = M₁ := by
        rw [Submodule.map_span, ← Set.range_comp]
        have hcomp : (⇑(MvPolynomial.aeval f).toLinearMap ∘
            (MvPolynomial.X : Fin (N' + 1) → MvPolynomial (Fin (N' + 1)) ↥V)) = f := by
          funext a
          exact MvPolynomial.aeval_X f a
        rw [hcomp, hf_span_V]
      rw [h_map1]
    have hJac : 𝔪_V ≤ (⊥ : Ideal ↥V).jacobson :=
      IsLocalRing.maximalIdeal_le_jacobson (⊥ : Ideal ↥V)
    have hMr_le_Nr : M_r ≤ N_r := by
      rw [hNr_eq]
      refine Submodule.le_of_le_smul_of_le_jacobson_bot hMr_fg hJac ?_
      intro x hx
      obtain ⟨y, hy_pow, hy_pi⟩ := hLiftPow r hr (π₁ x) (hMr_span x hx)
      have hy_Mr : y ∈ M_r := hPow_le hy_pow
      have hxy_ker : x - y ∈ 𝔪_V • M_r := by
        apply hMr_ker (x - y) (M_r.sub_mem hx hy_Mr)
        rw [map_sub, hy_pi, sub_self]
      have hx_eq : x = y + (x - y) := by abel
      rw [hx_eq]
      exact Submodule.add_mem_sup hy_pow hxy_ker
    let M_bar_r : Submodule k₀ R₁_Y := Submodule.map π₁_sl M_r
    have hM_bar_fg : M_bar_r.FG := hMr_fg.map π₁_sl
    have : Module.Finite k₀ ↥M_bar_r := Module.Finite.iff_fg.mpr hM_bar_fg
    let B_bar0 : Module.Basis (Fin (Module.finrank k₀ ↥M_bar_r)) k₀ ↥M_bar_r :=
      Module.finBasis k₀ ↥M_bar_r
    obtain ⟨D_r, B_vec, hB_indep, hB_repr⟩ :
        ∃ (D_r : ℕ) (B_vec : Fin D_r → ↥M_bar_r),
          LinearIndependent k₀ B_vec ∧
          (∀ x_bar : ↥M_bar_r, ∃ r_bar : Fin D_r → k₀,
            (∑ i : Fin D_r, r_bar i • B_vec i) = x_bar) :=
      ⟨Module.finrank k₀ ↥M_bar_r, ⇑B_bar0, B_bar0.linearIndependent,
       fun x_bar => ⟨fun i => B_bar0.repr x_bar i, B_bar0.sum_repr x_bar⟩⟩
    obtain ⟨b_r, hb_mem, hb_pi⟩ : ∃ b_r : Fin D_r → R₁,
        (∀ i : Fin D_r, b_r i ∈ M_r) ∧ (∀ i : Fin D_r, π₁ (b_r i) = (B_vec i).1) :=
      ⟨fun i => Classical.choose (Submodule.mem_map.mp (B_vec i).2),
       fun i => (Classical.choose_spec (Submodule.mem_map.mp (B_vec i).2)).1,
       fun i => (Classical.choose_spec (Submodule.mem_map.mp (B_vec i).2)).2⟩
    obtain ⟨B_r, hBr_homog, hBr_eval⟩ :
        ∃ B_r : Fin D_r → MvPolynomial (Fin (N' + 1)) ↥V,
          (∀ i : Fin D_r, B_r i ∈ 𝒜_r) ∧
          (∀ i : Fin D_r, MvPolynomial.aeval f (B_r i) = b_r i) :=
      ⟨fun i => Classical.choose (Submodule.mem_map.mp (hMr_le_Nr (hb_mem i))),
       fun i => (Classical.choose_spec (Submodule.mem_map.mp (hMr_le_Nr (hb_mem i)))).1,
       fun i => (Classical.choose_spec (Submodule.mem_map.mp (hMr_le_Nr (hb_mem i)))).2⟩
    refine ⟨D_r, B_r, hBr_homog, ?_, ?_⟩
    · let φ_b : (Fin D_r → ↥V) →ₗ[↥V] R₁ :=
        { toFun := fun c => ∑ i : Fin D_r, c i • b_r i
          map_add' := fun c₁ c₂ => by
            simp [add_smul, Finset.sum_add_distrib]
          map_smul' := fun v c => by
            simp [Finset.smul_sum, mul_smul] }
      let S_b : Submodule ↥V R₁ := LinearMap.range φ_b
      have hSb_le : S_b ≤ M_r := by
        rintro _ ⟨c, rfl⟩
        change (∑ i : Fin D_r, c i • b_r i) ∈ M_r
        exact M_r.sum_mem (fun i _ => M_r.smul_mem (c i) (hb_mem i))
      have hMr_le_Sb : M_r ≤ S_b := by
        refine Submodule.le_of_le_smul_of_le_jacobson_bot hMr_fg hJac ?_
        intro x hx
        let x_bar : ↥M_bar_r := ⟨π₁ x, ⟨x, hx, rfl⟩⟩
        obtain ⟨r_bar, hr_bar⟩ := hB_repr x_bar
        have hrepr := congrArg Subtype.val hr_bar
        simp only [AddSubmonoidClass.coe_finsetSum, SetLike.val_smul] at hrepr
        choose d hd using fun i : Fin D_r => hσ_surj (r_bar i)
        let y : R₁ := φ_b d
        have hy_Sb : y ∈ S_b := ⟨d, rfl⟩
        have hy_Mr : y ∈ M_r := hSb_le hy_Sb
        have hy_pi : π₁ y = π₁ x := by
          change π₁_sl (∑ i : Fin D_r, d i • b_r i) = π₁ x
          rw [map_sum]
          have h_sum_eq : (∑ i : Fin D_r, π₁_sl (d i • b_r i)) =
              ∑ i : Fin D_r, r_bar i • (B_vec i).1 := by
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [LinearMap.map_smulₛₗ]
            change σ (d i) • π₁ (b_r i) = r_bar i • (B_vec i).1
            rw [hd i, hb_pi i]
          rw [h_sum_eq]
          exact hrepr
        have hxy_ker : x - y ∈ 𝔪_V • M_r := by
          apply hMr_ker (x - y) (M_r.sub_mem hx hy_Mr)
          rw [map_sub, hy_pi, sub_self]
        have hx_eq : x = y + (x - y) := by abel
        rw [hx_eq]
        exact Submodule.add_mem_sup hy_Sb hxy_ker
      intro x₁
      simp only [hBr_eval]
      constructor
      · intro hx₁
        rcases hMr_le_Sb hx₁ with ⟨c, rfl⟩
        exact ⟨c, rfl⟩
      · rintro ⟨c, rfl⟩
        exact hSb_le ⟨c, rfl⟩
    · intro c hc_sum j
      simp only [hBr_eval] at hc_sum
      by_contra hcj
      rcases D_r with _ | n
      · exact Fin.elim0 j
      · obtain ⟨i₀, hdvd⟩ := hMinDvd n c
        have hc_i₀_ne : c i₀ ≠ 0 := by
          intro h0
          exact hcj (zero_dvd_iff.mp (h0 ▸ hdvd j))
        let u : Fin (n + 1) → ↥V := fun i =>
          if i = i₀ then 1 else Classical.choose (hdvd i)
        have hu_i₀ : u i₀ = 1 := by simp [u]
        have hu_mul : ∀ i : Fin (n + 1), c i₀ * u i = c i := by
          intro i
          dsimp [u]
          split_ifs with hi
          · subst hi
            exact mul_one (c i)
          · exact (Classical.choose_spec (hdvd i)).symm
        have h_smul_sum : c i₀ • (∑ i : Fin (n + 1), u i • b_r i) = 0 := by
          rw [Finset.smul_sum]
          have h_congr : (∑ i : Fin (n + 1), c i₀ • (u i • b_r i)) =
              ∑ i : Fin (n + 1), c i • b_r i := by
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [← mul_smul, hu_mul i]
          rw [h_congr, hc_sum]
        have h_u_sum : (∑ i : Fin (n + 1), u i • b_r i) = 0 :=
          hTorsFree (c i₀) _ hc_i₀_ne h_smul_sum
        have h_bar_sum : (∑ i : Fin (n + 1), σ (u i) • B_vec i) = 0 := by
          apply Subtype.ext
          simp only [AddSubmonoidClass.coe_finsetSum, SetLike.val_smul, ZeroMemClass.coe_zero]
          have h_pi := congrArg π₁_sl h_u_sum
          rw [map_zero, map_sum] at h_pi
          refine Eq.trans ?_ h_pi
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [LinearMap.map_smulₛₗ]
          change σ (u i) • (B_vec i).1 = σ (u i) • π₁ (b_r i)
          rw [hb_pi i]
        have h_indep := Fintype.linearIndependent_iff.mp hB_indep
          (fun i => σ (u i)) h_bar_sum i₀
        rw [hu_i₀, map_one] at h_indep
        exact one_ne_zero h_indep

theorem weil_sup1_monic_saturation_untwisted_cech_fg (K : Type u) [Field K]
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hSatFG : ∀ (L : ℕ) (N : Submodule ↥V (Fin L → ↥V)),
      (∀ (v : ↥V) (x : Fin L → ↥V), v ≠ 0 → v • x ∈ N → x ∈ N) → N.FG)
    (R₀ R₁ R₀₁ : Type u) [CommRing R₀] [CommRing R₁] [CommRing R₀₁]
    [IsDomain R₀] [IsDomain R₁] [IsDomain R₀₁]
    [Algebra ↥V R₀] [Algebra ↥V R₁] [Algebra ↥V R₀₁]
    (res₀ : R₀ →ₐ[↥V] R₀₁) (res₁ : R₁ →ₐ[↥V] R₀₁)
    (hInj₀ : Function.Injective res₀) (hInj₁ : Function.Injective res₁)
    (h₀ : R₀) (t₀ : R₁)
    (hh₀_ne : h₀ ≠ 0) (ht₀_ne : t₀ ≠ 0)
    (hht : res₀ h₀ * res₁ t₀ = 1)
    (hLoc₀ : @IsLocalization.Away _ _ h₀ R₀₁ _ res₀.toRingHom.toAlgebra)
    (hLoc₁ : @IsLocalization.Away _ _ t₀ R₀₁ _ res₁.toRingHom.toAlgebra)
    (hFin₀ : (Polynomial.aeval (R := ↥V) h₀).toRingHom.Finite)
    (hFin₁ : (Polynomial.aeval (R := ↥V) t₀).toRingHom.Finite)
    (hQuot₀ : ∀ r : ℕ, 1 ≤ r →
      Module.Free ↥V (R₀ ⧸ Ideal.span ({h₀ ^ r} : Set R₀)) ∧
      Module.Finite ↥V (R₀ ⧸ Ideal.span ({h₀ ^ r} : Set R₀)) ∧
      Nontrivial (R₀ ⧸ Ideal.span ({h₀ ^ r} : Set R₀)))
    (hQuot₁ : Module.Free ↥V (R₁ ⧸ Ideal.span ({t₀} : Set R₁)) ∧
      Module.Finite ↥V (R₁ ⧸ Ideal.span ({t₀} : Set R₁)) ∧
      Nontrivial (R₁ ⧸ Ideal.span ({t₀} : Set R₁)))
    (hMonic₁ : ∀ Q : Polynomial ↥V, Q.Monic →
      Module.Free ↥V (R₁ ⧸ Ideal.span ({Polynomial.aeval t₀ Q} : Set R₁))) :
    ∃ (A₀ : ℕ) (W : Submodule ↥V R₁),
      1 ≤ A₀ ∧
      (∀ z : R₀₁, ∃ (x₀ : R₀) (x₁ : R₁), res₁ (t₀ ^ A₀) * res₀ x₀ - res₁ x₁ = z) ∧
      (∀ S : Submodule ↥V R₀₁,
        LinearMap.range res₀.toLinearMap ≤ S →
        LinearMap.range res₁.toLinearMap ≤ S →
        (⊤ : Submodule ↥V (R₀₁ ⧸ S)).FG) ∧
      (∀ x₁ : R₁, x₁ ∈ W ↔ ∃ x₀ : R₀, res₀ x₀ = res₀ (h₀ ^ A₀) * res₁ x₁) ∧
      W.FG :=
by
  let _ := hMaxNeBot
  
  have h_uv_pow : ∀ n : ℕ, (res₀ h₀) ^ n * (res₁ t₀) ^ n = 1 := by
    intro n
    rw [← mul_pow, hht, one_pow]
  have h_vu_pow : ∀ n : ℕ, (res₁ t₀) ^ n * (res₀ h₀) ^ n = 1 := by
    intro n
    rw [mul_comm, h_uv_pow]
  have h_uv_swap : ∀ a b c d : ℕ, a + d = b + c →
       (res₁ t₀) ^ a * (res₀ h₀) ^ b = (res₁ t₀) ^ c * (res₀ h₀) ^ d := by
    intro a b c d habcd
    have h1 : (res₁ t₀) ^ a * (res₀ h₀) ^ b =
        (res₁ t₀) ^ a * (res₀ h₀) ^ b * ((res₀ h₀) ^ c * (res₁ t₀) ^ c) := by
      rw [h_uv_pow c, mul_one]
    have h2 : (res₁ t₀) ^ a * (res₀ h₀) ^ b * ((res₀ h₀) ^ c * (res₁ t₀) ^ c) =
        (res₁ t₀) ^ (a + c) * (res₀ h₀) ^ (b + c) := by
      simp only [pow_add]
      ring
    have h3 : a + c = c + a := Nat.add_comm a c
    have h4 : b + c = d + a := by omega
    have h5 : (res₁ t₀) ^ (c + a) * (res₀ h₀) ^ (d + a) =
        (res₁ t₀) ^ c * (res₀ h₀) ^ d * ((res₀ h₀) ^ a * (res₁ t₀) ^ a) := by
      simp only [pow_add]
      ring
    rw [h1, h2, h3, h4, h5, h_uv_pow a, mul_one]
  have h_sec₀ : ∀ z : R₀₁, ∃ (y : R₀) (p : ℕ), res₀ (h₀ ^ p) * z = res₀ y := by
    let _ : Algebra R₀ R₀₁ := res₀.toRingHom.toAlgebra
    intro z
    let sec := @IsLocalization.Away.sec R₀ _ R₀₁ _ _ h₀ hLoc₀ z
    refine ⟨sec.1, sec.2, ?_⟩
    have hspec := @IsLocalization.Away.sec_spec R₀ _ R₀₁ _ _ h₀ hLoc₀ z
    change z * res₀ (h₀ ^ sec.2) = res₀ sec.1 at hspec
    rwa [mul_comm] at hspec
  have h_sec₁ : ∀ z : R₀₁, ∃ (y : R₁) (p : ℕ), res₁ (t₀ ^ p) * z = res₁ y := by
    let _ : Algebra R₁ R₀₁ := res₁.toRingHom.toAlgebra
    intro z
    let sec := @IsLocalization.Away.sec R₁ _ R₀₁ _ _ t₀ hLoc₁ z
    refine ⟨sec.1, sec.2, ?_⟩
    have hspec := @IsLocalization.Away.sec_spec R₁ _ R₀₁ _ _ t₀ hLoc₁ z
    change z * res₁ (t₀ ^ sec.2) = res₁ sec.1 at hspec
    rwa [mul_comm] at hspec

  
  have h_fin_gen₀ : ∃ s : Finset R₀, ∀ y : R₀, ∃ f : ↥s → Polynomial ↥V,
      y = ∑ w : ↥s, Polynomial.aeval h₀ (f w) * w.1 := by
    let _ : Algebra (Polynomial ↥V) R₀ := (Polynomial.aeval (R := ↥V) h₀).toRingHom.toAlgebra
    have hmod : Module.Finite (Polynomial ↥V) R₀ := hFin₀
    obtain ⟨s, hs⟩ := @Module.Finite.fg_top (Polynomial ↥V) R₀ _ _ _ hmod
    refine ⟨s, fun y => ?_⟩
    have hrange : Set.range (Subtype.val : ↥s → R₀) = (s : Set R₀) := Subtype.range_coe
    have hy : y ∈ Submodule.span (Polynomial ↥V) (Set.range (Subtype.val : ↥s → R₀)) := by
      rw [hrange, hs]
      exact Submodule.mem_top
    obtain ⟨f, hf⟩ := (Submodule.mem_span_range_iff_exists_fun (Polynomial ↥V)).mp hy
    exact ⟨f, hf.symm⟩
  obtain ⟨s₀, hs₀_span⟩ := h_fin_gen₀
  choose b_s n_s hb_s using fun w : ↥s₀ => h_sec₁ (res₀ w.1)
  let A₀ : ℕ := 1 + (Finset.univ : Finset ↥s₀).sup n_s
  have hA₀_pos : 1 ≤ A₀ := by omega
  have hn_s_lt : ∀ w : ↥s₀, n_s w < A₀ := by
    intro w
    have hle : n_s w ≤ (Finset.univ : Finset ↥s₀).sup n_s :=
      Finset.le_sup (f := n_s) (Finset.mem_univ w)
    omega
  have h_clear_s : ∀ (w : ↥s₀) (r : ℕ), n_s w ≤ r →
      res₁ (t₀ ^ r) * res₀ w.1 = res₁ (t₀ ^ (r - n_s w) * b_s w) := by
    intro w r hr
    have hr_eq : r = (r - n_s w) + n_s w := (Nat.sub_add_cancel hr).symm
    calc
      res₁ (t₀ ^ r) * res₀ w.1
        = res₁ (t₀ ^ ((r - n_s w) + n_s w)) * res₀ w.1 := by rw [← hr_eq]
      _ = res₁ (t₀ ^ (r - n_s w)) * (res₁ (t₀ ^ n_s w) * res₀ w.1) := by
          rw [pow_add, map_mul, mul_assoc]
      _ = res₁ (t₀ ^ (r - n_s w) * b_s w) := by rw [hb_s w, ← map_mul]
  have h_monomial_mem : ∀ (M_sub : Submodule ↥V R₀₁),
      (∀ (p m : ℕ) (w : ↥s₀), (res₁ t₀) ^ p * (res₀ h₀) ^ m * res₀ w.1 ∈ M_sub) →
      ∀ z : R₀₁, z ∈ M_sub := by
    intro M_sub hM z
    obtain ⟨y, p, hyp⟩ := h_sec₀ z
    have hz : z = (res₁ t₀) ^ p * res₀ y := by
      calc
        z = (res₁ t₀) ^ p * (res₀ h₀) ^ p * z := by rw [h_vu_pow p, one_mul]
        _ = (res₁ t₀) ^ p * (res₀ (h₀ ^ p) * z) := by rw [map_pow, mul_assoc]
        _ = (res₁ t₀) ^ p * res₀ y := by rw [hyp]
    rw [hz]
    obtain ⟨f, rfl⟩ := hs₀_span y
    rw [map_sum, Finset.mul_sum]
    refine Submodule.sum_mem M_sub fun w _ => ?_
    rw [Polynomial.aeval_eq_sum_range, Finset.sum_mul, map_sum, Finset.mul_sum]
    refine Submodule.sum_mem M_sub fun m _ => ?_
    have hterm : (res₁ t₀) ^ p * res₀ (((f w).coeff m • h₀ ^ m) * w.1) =
        (f w).coeff m • ((res₁ t₀) ^ p * (res₀ h₀) ^ m * res₀ w.1) := by
      rw [smul_mul_assoc, map_smul, map_mul, map_pow, mul_smul_comm, mul_assoc]
    rw [hterm]
    exact M_sub.smul_mem ((f w).coeff m) (hM p m w)
  have hA₀_surj : ∀ z : R₀₁, ∃ (x₀ : R₀) (x₁ : R₁), res₁ (t₀ ^ A₀) * res₀ x₀ - res₁ x₁ = z := by
    let M_surj : Submodule ↥V R₀₁ :=
      { carrier := {z | ∃ (x₀ : R₀) (x₁ : R₁), res₁ (t₀ ^ A₀) * res₀ x₀ - res₁ x₁ = z}
        zero_mem' := ⟨0, 0, by simp⟩
        add_mem' := by
          rintro _ _ ⟨x₀, x₁, rfl⟩ ⟨y₀, y₁, rfl⟩
          refine ⟨x₀ + y₀, x₁ + y₁, ?_⟩
          simp only [map_add]
          ring
        smul_mem' := by
          rintro c _ ⟨x₀, x₁, rfl⟩
          refine ⟨c • x₀, c • x₁, ?_⟩
          rw [map_smul, map_smul, mul_smul_comm, ← smul_sub] }
    intro z
    refine h_monomial_mem M_surj (fun p m w => ?_) z
    by_cases hpm : p ≤ m + A₀
    · refine ⟨h₀ ^ (m + A₀ - p) * w.1, 0, ?_⟩
      have hswap := h_uv_swap p m A₀ (m + A₀ - p) (by omega)
      calc
        res₁ (t₀ ^ A₀) * res₀ (h₀ ^ (m + A₀ - p) * w.1) - res₁ 0
          = ((res₁ t₀) ^ A₀ * (res₀ h₀) ^ (m + A₀ - p)) * res₀ w.1 := by
              rw [map_zero, sub_zero, map_mul, map_pow, map_pow, mul_assoc]
        _ = (res₁ t₀) ^ p * (res₀ h₀) ^ m * res₀ w.1 := by rw [← hswap]
    · have hns_le : n_s w ≤ p - m := by
        have := hn_s_lt w
        omega
      refine ⟨0, -(t₀ ^ (p - m - n_s w) * b_s w), ?_⟩
      have hswap := h_uv_swap p m (p - m) 0 (by omega)
      calc
        res₁ (t₀ ^ A₀) * res₀ 0 - res₁ (-(t₀ ^ (p - m - n_s w) * b_s w))
          = res₁ (t₀ ^ (p - m - n_s w) * b_s w) := by
              rw [map_zero, mul_zero, zero_sub, map_neg, neg_neg]
        _ = ((res₁ t₀) ^ (p - m) * (res₀ h₀) ^ 0) * res₀ w.1 := by
              rw [← h_clear_s w (p - m) hns_le, map_pow, pow_zero, mul_one]
        _ = (res₁ t₀) ^ p * (res₀ h₀) ^ m * res₀ w.1 := by rw [← hswap]
  have hH1_fg : ∀ S : Submodule ↥V R₀₁,
      LinearMap.range res₀.toLinearMap ≤ S →
      LinearMap.range res₁.toLinearMap ≤ S →
      (⊤ : Submodule ↥V (R₀₁ ⧸ S)).FG := by
    intro S hS₀ hS₁
    let g_fn : Fin A₀ × ↥s₀ → R₀₁ := fun p => res₁ (t₀ ^ p.1.1) * res₀ p.2.1
    let T : Submodule ↥V R₀₁ := Submodule.span ↥V (Set.range g_fn)
    have hT_fg : T.FG := Submodule.fg_span (Set.finite_range g_fn)
    have h_top_le : (⊤ : Submodule ↥V R₀₁) ≤ T ⊔ S := by
      intro z _
      refine h_monomial_mem (T ⊔ S) (fun p m w => ?_) z
      by_cases hpm : p ≤ m
      · apply Submodule.mem_sup_right
        apply hS₀
        refine ⟨h₀ ^ (m - p) * w.1, ?_⟩
        have hswap := h_uv_swap p m 0 (m - p) (by omega)
        change res₀ (h₀ ^ (m - p) * w.1) = (res₁ t₀) ^ p * (res₀ h₀) ^ m * res₀ w.1
        rw [hswap, pow_zero, one_mul, map_mul, map_pow]
      · by_cases hpA : p - m < A₀
        · apply Submodule.mem_sup_left
          apply Submodule.subset_span
          refine ⟨(⟨p - m, hpA⟩, w), ?_⟩
          have hswap := h_uv_swap p m (p - m) 0 (by omega)
          dsimp only [g_fn]
          rw [hswap, pow_zero, mul_one, map_pow]
        · apply Submodule.mem_sup_right
          apply hS₁
          have hns_le : n_s w ≤ p - m := by
            have := hn_s_lt w
            omega
          refine ⟨t₀ ^ (p - m - n_s w) * b_s w, ?_⟩
          have hswap := h_uv_swap p m (p - m) 0 (by omega)
          change res₁ (t₀ ^ (p - m - n_s w) * b_s w) = (res₁ t₀) ^ p * (res₀ h₀) ^ m * res₀ w.1
          rw [← h_clear_s w (p - m) hns_le, hswap, pow_zero, mul_one, map_pow]
    have h_top_eq : (⊤ : Submodule ↥V (R₀₁ ⧸ S)) = Submodule.map S.mkQ T := by
      apply le_antisymm
      · intro q _
        obtain ⟨z, rfl⟩ := Submodule.mkQ_surjective S q
        have hz : z ∈ T ⊔ S := h_top_le Submodule.mem_top
        obtain ⟨t_el, ht_el, s_el, hs_el, rfl⟩ := Submodule.mem_sup.mp hz
        have hs0 : S.mkQ s_el = 0 := (Submodule.Quotient.mk_eq_zero S).mpr hs_el
        refine ⟨t_el, ht_el, ?_⟩
        rw [map_add, hs0, add_zero]
      · exact le_top
    rw [h_top_eq]
    exact hT_fg.map S.mkQ

  
  have hCH : ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥V B] (x : B),
      x ≠ 0 →
      (Polynomial.aeval (R := ↥V) x).toRingHom.Finite →
      Module.Free ↥V (B ⧸ Ideal.span ({x} : Set B)) →
      Module.Finite ↥V (B ⧸ Ideal.span ({x} : Set B)) →
      ∃ (d : ℕ) (e : Fin d → B) (P : Polynomial ↥V),
        P.coeff 0 = 1 ∧
        (∀ b : B, ∃ G : Fin d → Polynomial ↥V,
          Polynomial.aeval x P * b = ∑ j : Fin d, Polynomial.aeval x (G j) * e j) ∧
        (∀ G : Fin d → Polynomial ↥V,
          (∑ j : Fin d, Polynomial.aeval x (G j) * e j = 0) → ∀ j : Fin d, G j = 0) := by
    intro B _ _ _ x hx_ne hFin hFree hModFin
    let I_x : Ideal B := Ideal.span ({x} : Set B)
    have _ : Module.Free ↥V (B ⧸ I_x) := hFree
    have _ : Module.Finite ↥V (B ⧸ I_x) := hModFin
    let ι := Module.Free.ChooseBasisIndex ↥V (B ⧸ I_x)
    let _ : Fintype ι := Module.Free.ChooseBasisIndex.fintype ↥V (B ⧸ I_x)
    let d : ℕ := Fintype.card ι
    let b_bar : Module.Basis (Fin d) ↥V (B ⧸ I_x) :=
      (Module.Free.chooseBasis ↥V (B ⧸ I_x)).reindex (Fintype.equivFin ι)
    choose e he using fun j : Fin d => Submodule.mkQ_surjective I_x (b_bar j)
    have h_decomp_mod_x : ∀ b : B, ∃ (c : Fin d → ↥V) (b' : B),
        b = (∑ j : Fin d, Polynomial.aeval x (Polynomial.C (c j)) * e j) + x * b' := by
      intro b
      let c : Fin d → ↥V := fun j => b_bar.repr (I_x.mkQ b) j
      have hker : I_x.mkQ (b - ∑ j : Fin d, c j • e j) = 0 := by
        rw [map_sub, map_sum]
        have hsum_q : (∑ j : Fin d, I_x.mkQ (c j • e j)) = ∑ j : Fin d, c j • b_bar j :=
          Finset.sum_congr rfl fun j _ => by
            rw [← he j]
            rfl
        rw [hsum_q, b_bar.sum_repr (I_x.mkQ b), sub_self]
      have hmem : b - ∑ j : Fin d, c j • e j ∈ I_x :=
        (Submodule.Quotient.mk_eq_zero I_x).mp hker
      obtain ⟨b', hb'⟩ := Ideal.mem_span_singleton.mp hmem
      refine ⟨c, b', ?_⟩
      have hsum : (∑ j : Fin d, c j • e j) =
          ∑ j : Fin d, Polynomial.aeval x (Polynomial.C (c j)) * e j := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [Polynomial.aeval_C, Algebra.smul_def]
      calc
        b = (∑ j : Fin d, c j • e j) + (b - ∑ j : Fin d, c j • e j) := by abel
        _ = (∑ j : Fin d, Polynomial.aeval x (Polynomial.C (c j)) * e j) + x * b' := by
            rw [hb', hsum]
    have hP_exists : ∃ P : Polynomial ↥V,
        P.coeff 0 = 1 ∧
        ∀ b : B, ∃ G : Fin d → Polynomial ↥V,
          Polynomial.aeval x P * b = ∑ j : Fin d, Polynomial.aeval x (G j) * e j := by
      let _ : Algebra (Polynomial ↥V) B := (Polynomial.aeval (R := ↥V) x).toRingHom.toAlgebra
      have hmod : Module.Finite (Polynomial ↥V) B := hFin
      have hFG_top : (⊤ : Submodule (Polynomial ↥V) B).FG :=
        @Module.Finite.fg_top (Polynomial ↥V) B _ _ _ hmod
      let M_e : Submodule (Polynomial ↥V) B := Submodule.span (Polynomial ↥V) (Set.range e)
      let J_X : Ideal (Polynomial ↥V) := Ideal.span ({Polynomial.X} : Set (Polynomial ↥V))
      have h_le_sup : (⊤ : Submodule (Polynomial ↥V) B) ≤ M_e ⊔ J_X • ⊤ := by
        intro b _
        obtain ⟨c, b', rfl⟩ := h_decomp_mod_x b
        refine Submodule.add_mem_sup ?_ ?_
        · refine Submodule.sum_mem M_e fun j _ => ?_
          change (Polynomial.C (c j) : Polynomial ↥V) • e j ∈ M_e
          exact M_e.smul_mem (Polynomial.C (c j)) (Submodule.subset_span ⟨j, rfl⟩)
        · have hx_smul : x * b' = (Polynomial.X : Polynomial ↥V) • b' := by
            change x * b' = Polynomial.aeval x Polynomial.X * b'
            rw [Polynomial.aeval_X]
          rw [hx_smul]
          exact Submodule.smul_mem_smul (Ideal.subset_span rfl) Submodule.mem_top
      obtain ⟨P, hP_mem, hP_smul⟩ :=
        Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup hFG_top le_rfl h_le_sup
      have hP_c0 : P.coeff 0 = 1 := by
        obtain ⟨Q_P, hQ_P⟩ := Ideal.mem_span_singleton.mp hP_mem
        have hc0 := congrArg (fun p : Polynomial ↥V => p.coeff 0) hQ_P
        simp only [Polynomial.coeff_sub, Polynomial.coeff_one_zero, Polynomial.coeff_X_mul_zero] at hc0
        exact sub_eq_zero.mp hc0
      refine ⟨P, hP_c0, fun b => ?_⟩
      have hPb : P • b ∈ M_e := hP_smul ⟨b, Submodule.mem_top, rfl⟩
      obtain ⟨G, hG⟩ := (Submodule.mem_span_range_iff_exists_fun (Polynomial ↥V)).mp hPb
      exact ⟨G, hG.symm⟩
    obtain ⟨P, hP_c0, hP_span⟩ := hP_exists
    have h_indep_deg : ∀ (m : ℕ) (G : Fin d → Polynomial ↥V),
        (∀ j : Fin d, (G j).natDegree < m) →
        (∑ j : Fin d, Polynomial.aeval x (G j) * e j = 0) →
        ∀ j : Fin d, G j = 0 := by
      intro m
      induction m with
      | zero =>
        intro G hdeg _ j
        exact False.elim (Nat.not_lt_zero _ (hdeg j))
      | succ m ih =>
        intro G hdeg hsum j₀
        have hG_split : ∀ j : Fin d, Polynomial.aeval x (G j) * e j =
            x * (Polynomial.aeval x (G j).divX * e j) + ((G j).coeff 0) • e j := by
          intro j
          conv_lhs => rw [← Polynomial.X_mul_divX_add (G j)]
          rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, Algebra.smul_def]
          ring
        have hsum' : x * (∑ j : Fin d, Polynomial.aeval x (G j).divX * e j) +
            ∑ j : Fin d, ((G j).coeff 0) • e j = 0 := by
          rw [Finset.mul_sum, ← Finset.sum_add_distrib]
          simpa only [hG_split] using hsum
        have hquot : ∑ j : Fin d, ((G j).coeff 0) • b_bar j = 0 := by
          have hmk := congrArg I_x.mkQ hsum'
          have hx0 : I_x.mkQ (x * (∑ j : Fin d, Polynomial.aeval x (G j).divX * e j)) = 0 :=
            (Submodule.Quotient.mk_eq_zero I_x).mpr (Ideal.mem_span_singleton.mpr ⟨_, rfl⟩)
          rw [map_add, hx0, zero_add, map_sum, map_zero] at hmk
          have hmk_congr : (∑ j : Fin d, I_x.mkQ (((G j).coeff 0) • e j)) =
              ∑ j : Fin d, ((G j).coeff 0) • b_bar j :=
            Finset.sum_congr rfl fun j _ => by
              rw [← he j]
              rfl
          rwa [hmk_congr] at hmk
        have hc0 : ∀ j : Fin d, (G j).coeff 0 = 0 :=
          Fintype.linearIndependent_iff.mp b_bar.linearIndependent (fun j => (G j).coeff 0) hquot
        rcases Nat.eq_zero_or_pos m with rfl | hm_pos
        · have hdeg0 : (G j₀).natDegree = 0 := Nat.lt_one_iff.mp (hdeg j₀)
          rw [Polynomial.eq_C_of_natDegree_eq_zero hdeg0, hc0 j₀, map_zero]
        · have hsum_div : ∑ j : Fin d, Polynomial.aeval x (G j).divX * e j = 0 := by
            have hc_sum : (∑ j : Fin d, ((G j).coeff 0) • e j) = 0 :=
              Finset.sum_eq_zero fun j _ => by rw [hc0 j, zero_smul]
            rw [hc_sum, add_zero] at hsum'
            exact (mul_eq_zero.mp hsum').resolve_left hx_ne
          have hdiv_deg : ∀ j : Fin d, ((G j).divX).natDegree < m := by
            intro j
            rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one]
            have hj := hdeg j
            omega
          have hdiv0 := ih (fun j => (G j).divX) hdiv_deg hsum_div j₀
          rw [← Polynomial.X_mul_divX_add (G j₀), hdiv0, hc0 j₀, mul_zero, map_zero, add_zero]
    refine ⟨d, e, P, hP_c0, hP_span, fun G hsum => ?_⟩
    exact h_indep_deg ((Finset.univ : Finset (Fin d)).sup (fun j => (G j).natDegree) + 1) G
      (fun j => Nat.lt_succ_of_le
        (Finset.le_sup (f := fun j : Fin d => (G j).natDegree) (Finset.mem_univ j))) hsum

  
  have hQuot₀_1 : Module.Free ↥V (R₀ ⧸ Ideal.span ({h₀} : Set R₀)) ∧
      Module.Finite ↥V (R₀ ⧸ Ideal.span ({h₀} : Set R₀)) ∧
      Nontrivial (R₀ ⧸ Ideal.span ({h₀} : Set R₀)) := by
    have h1 := hQuot₀ 1 le_rfl
    rwa [pow_one] at h1
  obtain ⟨d₀, e, P₀, hP₀_c0, hP₀_span, h_indep₀⟩ :=
    hCH R₀ h₀ hh₀_ne hFin₀ hQuot₀_1.1 hQuot₀_1.2.1
  obtain ⟨d₁, u, P₁, hP₁_c0, hP₁_span, _h_indep₁⟩ :=
    hCH R₁ t₀ ht₀_ne hFin₁ hQuot₁.1 hQuot₁.2.1
  have h_sum_deg_le : ∀ {α : Type} (s : Finset α) (f : α → Polynomial ↥V) (B_deg : ℕ),
      (∀ a ∈ s, (f a).natDegree ≤ B_deg) → (∑ a ∈ s, f a).natDegree ≤ B_deg := by
    intro α s f B_deg hB
    rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
    intro n hn
    rw [Polynomial.finsetSum_coeff]
    exact Finset.sum_eq_zero fun a ha =>
      Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt (hB a ha) hn)
  let revPoly : ℕ → Polynomial ↥V → Polynomial ↥V := fun N P =>
    ∑ i ∈ Finset.range (P.natDegree + 1), Polynomial.C (P.coeff i) * Polynomial.X ^ (N - i)
  have h_rev_deg : ∀ (N : ℕ) (P : Polynomial ↥V), (revPoly N P).natDegree ≤ N := by
    intro N P
    refine h_sum_deg_le (Finset.range (P.natDegree + 1)) _ N fun i _ => ?_
    exact le_trans (Polynomial.natDegree_C_mul_X_pow_le (P.coeff i) (N - i)) (Nat.sub_le N i)
  have h_rev_monic : ∀ P : Polynomial ↥V, P.coeff 0 = 1 →
      (revPoly P.natDegree P).Monic ∧ (revPoly P.natDegree P).natDegree = P.natDegree := by
    intro P hc0
    let r := P.natDegree
    have hcoeff_r : (revPoly r P).coeff r = 1 := by
      dsimp only [revPoly]
      rw [Polynomial.finsetSum_coeff]
      have hcongr : (∑ i ∈ Finset.range (r + 1),
          (Polynomial.C (P.coeff i) * Polynomial.X ^ (r - i)).coeff r) =
          ∑ i ∈ Finset.range (r + 1), (if i = 0 then P.coeff i else 0) := by
        refine Finset.sum_congr rfl fun i hi => ?_
        rw [Polynomial.coeff_C_mul_X_pow]
        have hi_lt : i < r + 1 := Finset.mem_range.mp hi
        have hiff : (r = r - i) ↔ (i = 0) := by omega
        simp only [hiff]
      rw [hcongr, Finset.sum_ite_eq' (Finset.range (r + 1)) 0 (fun i => P.coeff i)]
      simp [hc0]
    have hdeg_ge : r ≤ (revPoly r P).natDegree := by
      by_contra hlt
      have hlt' : (revPoly r P).natDegree < r := Nat.lt_of_not_ge hlt
      have h0 : (revPoly r P).coeff r = 0 := Polynomial.coeff_eq_zero_of_natDegree_lt hlt'
      rw [hcoeff_r] at h0
      exact one_ne_zero h0
    have hdeg_eq : (revPoly r P).natDegree = r := le_antisymm (h_rev_deg r P) hdeg_ge
    refine ⟨?_, hdeg_eq⟩
    rw [Polynomial.Monic.def, Polynomial.leadingCoeff, hdeg_eq, hcoeff_r]
  have h_rev_aeval : ∀ (N : ℕ) (P : Polynomial ↥V) (a b : R₀₁),
      a * b = 1 → P.natDegree ≤ N →
      Polynomial.aeval a (revPoly N P) = a ^ N * Polynomial.aeval b P := by
    intro N P a b hab hNP
    dsimp only [revPoly]
    rw [map_sum, Polynomial.aeval_eq_sum_range, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i hi => ?_
    have hi_le : i ≤ N := by
      have hi_lt : i < P.natDegree + 1 := Finset.mem_range.mp hi
      omega
    have hN_eq : N = (N - i) + i := (Nat.sub_add_cancel hi_le).symm
    rw [map_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow, Algebra.smul_def]
    calc
      (algebraMap ↥V R₀₁) (P.coeff i) * a ^ (N - i)
        = (algebraMap ↥V R₀₁) (P.coeff i) * (a ^ (N - i) * (a * b) ^ i) := by
            rw [hab, one_pow, mul_one]
      _ = (algebraMap ↥V R₀₁) (P.coeff i) * (a ^ ((N - i) + i) * b ^ i) := by
            rw [mul_pow, pow_add, mul_assoc]
      _ = a ^ N * ((algebraMap ↥V R₀₁) (P.coeff i) * b ^ i) := by
            rw [← hN_eq]
            ring

  
  choose y_u m_u hy_u using fun k : Fin d₁ => h_sec₀ (res₁ (u k))
  let N₁ : ℕ := (Finset.univ : Finset (Fin d₁)).sup m_u
  let z_u : Fin d₁ → R₀ := fun k => h₀ ^ (N₁ - m_u k) * y_u k
  have hz_u : ∀ k : Fin d₁, res₀ (h₀ ^ N₁) * res₁ (u k) = res₀ (z_u k) := by
    intro k
    have hle : m_u k ≤ N₁ := Finset.le_sup (f := m_u) (Finset.mem_univ k)
    have hN₁_eq : N₁ = (N₁ - m_u k) + m_u k := (Nat.sub_add_cancel hle).symm
    calc
      res₀ (h₀ ^ N₁) * res₁ (u k)
        = res₀ (h₀ ^ ((N₁ - m_u k) + m_u k)) * res₁ (u k) := by rw [← hN₁_eq]
      _ = res₀ (h₀ ^ (N₁ - m_u k)) * (res₀ (h₀ ^ m_u k) * res₁ (u k)) := by
            rw [pow_add, map_mul, mul_assoc]
      _ = res₀ (z_u k) := by rw [hy_u k, ← map_mul]
  choose A hA_eq using fun k : Fin d₁ => hP₀_span (z_u k)
  let D_A : ℕ := (Finset.univ : Finset (Fin d₁ × Fin d₀)).sup (fun p => (A p.1 p.2).natDegree)
  let D_max : ℕ := A₀ + D_A
  let r₁ : ℕ := P₁.natDegree
  let P₁_tilde : Polynomial ↥V := revPoly r₁ P₁
  obtain ⟨hP₁_tilde_mon, hP₁_tilde_deg⟩ := h_rev_monic P₁ hP₁_c0
  have h_deg_bound : ∀ (x₁ : R₁) (x₀ : R₀),
      res₀ x₀ = res₀ (h₀ ^ A₀) * res₁ x₁ →
      ∀ G : Fin d₀ → Polynomial ↥V,
        Polynomial.aeval h₀ P₀ * x₀ = ∑ j : Fin d₀, Polynomial.aeval h₀ (G j) * e j →
        ∀ j : Fin d₀, (G j).natDegree ≤ D_max := by
    intro x₁ x₀ hx G hG j₀
    obtain ⟨H, hH⟩ := hP₁_span x₁
    let M_H : ℕ := (Finset.univ : Finset (Fin d₁)).sup (fun k => (H k).natDegree)
    let H_hat : Fin d₁ → Polynomial ↥V := fun k => revPoly M_H (H k)
    have hH_hat_aeval : ∀ k : Fin d₁,
        res₀ (Polynomial.aeval h₀ (H_hat k)) =
          (res₀ h₀) ^ M_H * res₁ (Polynomial.aeval t₀ (H k)) := by
      intro k
      have hk_le : (H k).natDegree ≤ M_H :=
        Finset.le_sup (f := fun k : Fin d₁ => (H k).natDegree) (Finset.mem_univ k)
      rw [← Polynomial.aeval_algHom_apply res₀ h₀ (H_hat k),
        ← Polynomial.aeval_algHom_apply res₁ t₀ (H k)]
      exact h_rev_aeval M_H (H k) (res₀ h₀) (res₁ t₀) hht hk_le
    have hP₁_tilde_aeval :
        res₀ (Polynomial.aeval h₀ P₁_tilde) =
          (res₀ h₀) ^ r₁ * res₁ (Polynomial.aeval t₀ P₁) := by
      rw [← Polynomial.aeval_algHom_apply res₀ h₀ P₁_tilde,
        ← Polynomial.aeval_algHom_apply res₁ t₀ P₁]
      exact h_rev_aeval r₁ P₁ (res₀ h₀) (res₁ t₀) hht le_rfl
    have h_res_eq :
        res₀ (∑ j : Fin d₀,
          Polynomial.aeval h₀ (Polynomial.X ^ (M_H + N₁) * P₁_tilde * G j) * e j) =
        res₀ (∑ j : Fin d₀,
          Polynomial.aeval h₀
            (∑ k : Fin d₁, Polynomial.X ^ (A₀ + r₁) * H_hat k * A k j) * e j) := by
      have hLHS :
          res₀ (∑ j : Fin d₀,
            Polynomial.aeval h₀ (Polynomial.X ^ (M_H + N₁) * P₁_tilde * G j) * e j) =
          (res₀ h₀) ^ (A₀ + r₁) * (res₀ h₀) ^ M_H * res₀ (Polynomial.aeval h₀ P₀) *
            res₀ (h₀ ^ N₁) * res₁ (Polynomial.aeval t₀ P₁ * x₁) := by
        have hsum_L : (∑ j : Fin d₀,
            Polynomial.aeval h₀ (Polynomial.X ^ (M_H + N₁) * P₁_tilde * G j) * e j) =
            h₀ ^ (M_H + N₁) * Polynomial.aeval h₀ P₁_tilde *
              (Polynomial.aeval h₀ P₀ * x₀) := by
          rw [hG, Finset.mul_sum (Finset.univ : Finset (Fin d₀))]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [map_mul, map_mul, Polynomial.aeval_X_pow]
          ring
        rw [hsum_L, map_mul, map_mul, map_mul, map_pow, pow_add, hP₁_tilde_aeval,
          hx, map_pow, map_pow, map_mul, pow_add]
        ring
      have hRHS :
          res₀ (∑ j : Fin d₀,
            Polynomial.aeval h₀
              (∑ k : Fin d₁, Polynomial.X ^ (A₀ + r₁) * H_hat k * A k j) * e j) =
          (res₀ h₀) ^ (A₀ + r₁) * (res₀ h₀) ^ M_H * res₀ (Polynomial.aeval h₀ P₀) *
            res₀ (h₀ ^ N₁) * res₁ (Polynomial.aeval t₀ P₁ * x₁) := by
        have hswap_sum : (∑ j : Fin d₀,
            Polynomial.aeval h₀
              (∑ k : Fin d₁, Polynomial.X ^ (A₀ + r₁) * H_hat k * A k j) * e j) =
            ∑ k : Fin d₁, h₀ ^ (A₀ + r₁) * Polynomial.aeval h₀ (H_hat k) *
              (Polynomial.aeval h₀ P₀ * z_u k) := by
          have h_expand_j : ∀ j : Fin d₀,
              Polynomial.aeval h₀ (∑ k : Fin d₁, Polynomial.X ^ (A₀ + r₁) * H_hat k * A k j) * e j =
                ∑ k : Fin d₁, Polynomial.aeval h₀ (Polynomial.X ^ (A₀ + r₁) * H_hat k * A k j) * e j := by
            intro j
            rw [map_sum, Finset.sum_mul]
          simp_rw [h_expand_j]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [hA_eq k, Finset.mul_sum (Finset.univ : Finset (Fin d₀))]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [map_mul, map_mul, Polynomial.aeval_X_pow]
          ring
        rw [hswap_sum, hH, map_sum res₀, map_sum res₁,
          Finset.mul_sum (Finset.univ : Finset (Fin d₁))]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [map_mul, map_mul, map_mul, map_pow, hH_hat_aeval k, ← hz_u k, map_mul]
        ring
      rw [hLHS, hRHS]
    have h_R₀_eq := hInj₀ h_res_eq
    have h_diff_zero :
        ∑ j : Fin d₀, Polynomial.aeval h₀
          (Polynomial.X ^ (M_H + N₁) * P₁_tilde * G j -
            ∑ k : Fin d₁, Polynomial.X ^ (A₀ + r₁) * H_hat k * A k j) * e j = 0 := by
      simp_rw [map_sub, sub_mul, Finset.sum_sub_distrib, h_R₀_eq, sub_self]
    have h_poly_eq :
        Polynomial.X ^ (M_H + N₁) * P₁_tilde * G j₀ =
          ∑ k : Fin d₁, Polynomial.X ^ (A₀ + r₁) * H_hat k * A k j₀ :=
      sub_eq_zero.mp (h_indep₀ _ h_diff_zero j₀)
    by_cases hGj₀ : G j₀ = 0
    · rw [hGj₀, Polynomial.natDegree_zero]
      exact Nat.zero_le _
    · have h_mon_left : (Polynomial.X ^ (M_H + N₁) * P₁_tilde).Monic :=
        (Polynomial.monic_X_pow (M_H + N₁)).mul hP₁_tilde_mon
      have h_deg_left :
          (Polynomial.X ^ (M_H + N₁) * P₁_tilde * G j₀).natDegree =
            M_H + N₁ + r₁ + (G j₀).natDegree := by
        rw [h_mon_left.natDegree_mul' hGj₀,
          (Polynomial.monic_X_pow (M_H + N₁)).natDegree_mul hP₁_tilde_mon,
          Polynomial.natDegree_X_pow, hP₁_tilde_deg]
      have h_deg_right :
          (∑ k : Fin d₁, Polynomial.X ^ (A₀ + r₁) * H_hat k * A k j₀).natDegree ≤
            (A₀ + r₁) + M_H + D_A := by
        refine h_sum_deg_le Finset.univ _ ((A₀ + r₁) + M_H + D_A) fun k _ => ?_
        have hd1 : (Polynomial.X ^ (A₀ + r₁) : Polynomial ↥V).natDegree ≤ A₀ + r₁ :=
          Polynomial.natDegree_X_pow_le (A₀ + r₁)
        have hd2 : (H_hat k).natDegree ≤ M_H := h_rev_deg M_H (H k)
        have hd3 : (A k j₀).natDegree ≤ D_A :=
          Finset.le_sup (f := fun p : Fin d₁ × Fin d₀ => (A p.1 p.2).natDegree)
            (Finset.mem_univ (k, j₀))
        have hm1 := Polynomial.natDegree_mul_le
          (p := Polynomial.X ^ (A₀ + r₁) * H_hat k) (q := A k j₀)
        have hm2 := Polynomial.natDegree_mul_le
          (p := (Polynomial.X ^ (A₀ + r₁) : Polynomial ↥V)) (q := H_hat k)
        omega
      rw [h_poly_eq] at h_deg_left
      have : D_max = A₀ + D_A := rfl
      omega

  
  choose v'_e n_e hv'_e using fun j : Fin d₀ => h_sec₁ (res₀ (e j))
  let N₀ : ℕ := (Finset.univ : Finset (Fin d₀)).sup n_e
  let v_e : Fin d₀ → R₁ := fun j => t₀ ^ (N₀ - n_e j) * v'_e j
  have hv_e : ∀ j : Fin d₀, res₁ (t₀ ^ N₀) * res₀ (e j) = res₁ (v_e j) := by
    intro j
    have hle : n_e j ≤ N₀ := Finset.le_sup (f := n_e) (Finset.mem_univ j)
    have hN₀_eq : N₀ = (N₀ - n_e j) + n_e j := (Nat.sub_add_cancel hle).symm
    calc
      res₁ (t₀ ^ N₀) * res₀ (e j)
        = res₁ (t₀ ^ ((N₀ - n_e j) + n_e j)) * res₀ (e j) := by rw [← hN₀_eq]
      _ = res₁ (t₀ ^ (N₀ - n_e j)) * (res₁ (t₀ ^ n_e j) * res₀ (e j)) := by
            rw [pow_add, map_mul, mul_assoc]
      _ = res₁ (v_e j) := by rw [hv'_e j, ← map_mul]
  let r₀ : ℕ := P₀.natDegree
  let P₀_tilde : Polynomial ↥V := revPoly r₀ P₀
  obtain ⟨hP₀_tilde_mon, _hP₀_tilde_deg⟩ := h_rev_monic P₀ hP₀_c0
  let M_exp : ℕ := max (A₀ + r₀) (D_max + N₀)
  let Q_mon : Polynomial ↥V := Polynomial.X ^ (M_exp - (A₀ + r₀)) * P₀_tilde
  have hQ_mon : Q_mon.Monic := (Polynomial.monic_X_pow _).mul hP₀_tilde_mon
  have hQ_aeval_res :
      res₁ (Polynomial.aeval t₀ Q_mon) =
        (res₁ t₀) ^ (M_exp - A₀) * res₀ (Polynomial.aeval h₀ P₀) := by
    have hM_le : A₀ + r₀ ≤ M_exp := le_max_left _ _
    have hexp : (M_exp - (A₀ + r₀)) + r₀ = M_exp - A₀ := by omega
    have hP₀_tilde_aeval :
        res₁ (Polynomial.aeval t₀ P₀_tilde) =
          (res₁ t₀) ^ r₀ * res₀ (Polynomial.aeval h₀ P₀) := by
      rw [← Polynomial.aeval_algHom_apply res₁ t₀ P₀_tilde,
        ← Polynomial.aeval_algHom_apply res₀ h₀ P₀]
      exact h_rev_aeval r₀ P₀ (res₁ t₀) (res₀ h₀) (by rw [mul_comm, hht]) le_rfl
    dsimp only [Q_mon]
    rw [map_mul, Polynomial.aeval_X_pow, map_mul, map_pow, hP₀_tilde_aeval,
      ← mul_assoc, ← pow_add, hexp]
  have hq_ne : Polynomial.aeval t₀ Q_mon ≠ 0 := by
    intro hq0
    have hres0 : (res₁ t₀) ^ (M_exp - A₀) * res₀ (Polynomial.aeval h₀ P₀) = 0 := by
      rw [← hQ_aeval_res, hq0, map_zero]
    have hP₀_res0 : res₀ (Polynomial.aeval h₀ P₀) = 0 := by
      calc
        res₀ (Polynomial.aeval h₀ P₀)
          = ((res₀ h₀) ^ (M_exp - A₀) * (res₁ t₀) ^ (M_exp - A₀)) *
              res₀ (Polynomial.aeval h₀ P₀) := by rw [h_uv_pow, one_mul]
        _ = (res₀ h₀) ^ (M_exp - A₀) *
              ((res₁ t₀) ^ (M_exp - A₀) * res₀ (Polynomial.aeval h₀ P₀)) := by rw [mul_assoc]
        _ = 0 := by rw [hres0, mul_zero]
    have hP₀_zero : Polynomial.aeval h₀ P₀ = 0 := hInj₀ (by rw [hP₀_res0, map_zero])
    have h1_eq : (1 : R₀) = h₀ * (- Polynomial.aeval h₀ P₀.divX) := by
      have hsplit := congrArg (Polynomial.aeval h₀) (Polynomial.X_mul_divX_add P₀).symm
      rw [hP₀_zero, map_add, map_mul, Polynomial.aeval_X, hP₀_c0,
        Polynomial.aeval_C, map_one] at hsplit
      linear_combination -hsplit
    have h1_mem : (1 : R₀) ∈ Ideal.span ({h₀} : Set R₀) :=
      Ideal.mem_span_singleton.mpr ⟨- Polynomial.aeval h₀ P₀.divX, h1_eq⟩
    have _ : Nontrivial (R₀ ⧸ Ideal.span ({h₀} : Set R₀)) := hQuot₀_1.2.2
    have h1_quot0 : (1 : R₀ ⧸ Ideal.span ({h₀} : Set R₀)) = 0 :=
      (Ideal.Quotient.eq_zero_iff_mem).mpr h1_mem
    exact one_ne_zero h1_quot0
  let L : ℕ := d₀ * (D_max + 1)
  let π_F : (Fin L → ↥V) →ₗ[↥V] R₁ :=
    { toFun := fun α =>
        ∑ p : Fin d₀ × Fin (D_max + 1),
          α (finProdFinEquiv p) • (t₀ ^ (M_exp - N₀ - p.2.1) * v_e p.1)
      map_add' := fun α β => by simp [Pi.add_apply, add_smul, Finset.sum_add_distrib]
      map_smul' := fun c α => by simp [Pi.smul_apply, mul_smul, Finset.smul_sum] }
  have hEnv : ∀ (x₁ : R₁) (x₀ : R₀),
      res₀ x₀ = res₀ (h₀ ^ A₀) * res₁ x₁ →
      ∃ α : Fin L → ↥V, π_F α = Polynomial.aeval t₀ Q_mon * x₁ := by
    intro x₁ x₀ hx
    obtain ⟨G, hG⟩ := hP₀_span x₀
    have hG_deg : ∀ j : Fin d₀, (G j).natDegree < D_max + 1 :=
      fun j => Nat.lt_succ_of_le (h_deg_bound x₁ x₀ hx G hG j)
    let α : Fin L → ↥V := fun l =>
      (G (finProdFinEquiv.symm l).1).coeff (finProdFinEquiv.symm l).2.1
    refine ⟨α, hInj₁ ?_⟩
    have hLHS_π : res₁ (π_F α) =
        (res₁ t₀) ^ M_exp * res₀ (∑ j : Fin d₀, Polynomial.aeval h₀ (G j) * e j) := by
      change res₁ (∑ p : Fin d₀ × Fin (D_max + 1),
          α (finProdFinEquiv p) • (t₀ ^ (M_exp - N₀ - p.2.1) * v_e p.1)) = _
      rw [map_sum, Fintype.sum_prod_type, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Polynomial.aeval_eq_sum_range' (hG_deg j) h₀,
        ← Fin.sum_univ_eq_sum_range (fun s => (G j).coeff s • h₀ ^ s) (D_max + 1),
        Finset.sum_mul, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun s _ => ?_
      have hα_apply : α (finProdFinEquiv (j, s)) = (G j).coeff s.1 := by
        dsimp only [α]
        rw [Equiv.symm_apply_apply]
      have hs_le : s.1 ≤ D_max := Nat.lt_succ_iff.mp s.2
      have hDN_le : D_max + N₀ ≤ M_exp := le_max_right _ _
      have hM_eq : M_exp = (M_exp - N₀ - s.1) + N₀ + s.1 := by omega
      rw [hα_apply, map_smul, smul_mul_assoc, map_smul, mul_smul_comm]
      congr 1
      calc
        res₁ (t₀ ^ (M_exp - N₀ - s.1) * v_e j)
          = res₁ (t₀ ^ (M_exp - N₀ - s.1)) * res₁ (v_e j) := map_mul _ _ _
        _ = (res₁ t₀) ^ (M_exp - N₀ - s.1) * (res₁ (t₀ ^ N₀) * res₀ (e j)) := by
              rw [map_pow, hv_e j]
        _ = (res₁ t₀) ^ (M_exp - N₀ - s.1) * ((res₁ t₀) ^ N₀ * res₀ (e j)) *
              ((res₁ t₀) ^ s.1 * (res₀ h₀) ^ s.1) := by
              rw [map_pow, h_vu_pow s.1, mul_one]
        _ = (res₁ t₀) ^ ((M_exp - N₀ - s.1) + N₀ + s.1) * ((res₀ h₀) ^ s.1 * res₀ (e j)) := by
              simp only [pow_add]
              ring
        _ = (res₁ t₀) ^ M_exp * res₀ (h₀ ^ s.1 * e j) := by
              rw [← hM_eq, map_mul, map_pow]
    have hRHS_Q : res₁ (Polynomial.aeval t₀ Q_mon * x₁) =
        (res₁ t₀) ^ M_exp * res₀ (Polynomial.aeval h₀ P₀ * x₀) := by
      have hA_le : A₀ ≤ M_exp := le_trans (Nat.le_add_right A₀ r₀) (le_max_left _ _)
      have hM_eq : M_exp = (M_exp - A₀) + A₀ := (Nat.sub_add_cancel hA_le).symm
      rw [map_mul, hQ_aeval_res, map_mul, hx, map_pow]
      calc
        (res₁ t₀) ^ (M_exp - A₀) * res₀ (Polynomial.aeval h₀ P₀) * res₁ x₁
          = (res₁ t₀) ^ (M_exp - A₀) * ((res₁ t₀) ^ A₀ * (res₀ h₀) ^ A₀) *
              res₀ (Polynomial.aeval h₀ P₀) * res₁ x₁ := by
              rw [h_vu_pow A₀, mul_one]
        _ = (res₁ t₀) ^ ((M_exp - A₀) + A₀) *
              (res₀ (Polynomial.aeval h₀ P₀) * ((res₀ h₀) ^ A₀ * res₁ x₁)) := by
              rw [pow_add]
              ring
        _ = (res₁ t₀) ^ M_exp *
              (res₀ (Polynomial.aeval h₀ P₀) * ((res₀ h₀) ^ A₀ * res₁ x₁)) := by
              rw [← hM_eq]
    rw [hLHS_π, ← hG, hRHS_Q]

  
  have h_free_torsfree : ∀ (M_free : Type u) [AddCommGroup M_free] [Module ↥V M_free]
      [Module.Free ↥V M_free] (v : ↥V), v ≠ 0 → ∀ m : M_free, v • m = 0 → m = 0 := by
    intro M_free _ _ _ v hv m hvm
    let b := Module.Free.chooseBasis ↥V M_free
    apply b.repr.injective
    rw [map_zero]
    refine Finsupp.ext fun i => ?_
    rw [Finsupp.zero_apply]
    have hi : v * b.repr m i = 0 := by
      have h1 := congrArg (fun f => f i) (b.repr.map_smul v m)
      rw [hvm, map_zero, Finsupp.zero_apply, Finsupp.smul_apply, smul_eq_mul] at h1
      exact h1.symm
    exact (mul_eq_zero.mp hi).resolve_left hv
  let φ_W : R₁ →ₗ[↥V] R₀₁ := (LinearMap.mulLeft ↥V (res₀ (h₀ ^ A₀))).comp res₁.toLinearMap
  let W : Submodule ↥V R₁ := Submodule.comap φ_W (LinearMap.range res₀.toLinearMap)
  have hW_mem : ∀ x₁ : R₁, x₁ ∈ W ↔ ∃ x₀ : R₀, res₀ x₀ = res₀ (h₀ ^ A₀) * res₁ x₁ := by
    intro x₁
    rfl
  have hW_sat : ∀ (v : ↥V) (y₁ : R₁), v ≠ 0 → v • y₁ ∈ W → y₁ ∈ W := by
    intro v y₁ hv hvy₁
    obtain ⟨x₀, hx₀⟩ := (hW_mem (v • y₁)).mp hvy₁
    rw [map_smul, mul_smul_comm] at hx₀
    obtain ⟨z'₀, m, hz'₀⟩ := h_sec₀ (res₁ y₁)
    by_cases hm : m ≤ A₀
    · rw [hW_mem]
      refine ⟨h₀ ^ (A₀ - m) * z'₀, ?_⟩
      have hA_eq : A₀ = (A₀ - m) + m := (Nat.sub_add_cancel hm).symm
      calc
        res₀ (h₀ ^ (A₀ - m) * z'₀)
          = res₀ (h₀ ^ (A₀ - m)) * (res₀ (h₀ ^ m) * res₁ y₁) := by rw [map_mul, hz'₀]
        _ = res₀ (h₀ ^ ((A₀ - m) + m)) * res₁ y₁ := by rw [← mul_assoc, ← map_mul, ← pow_add]
        _ = res₀ (h₀ ^ A₀) * res₁ y₁ := by rw [← hA_eq]
    · let r : ℕ := m - A₀
      have hr : 1 ≤ r := by omega
      have hm_eq : m = r + A₀ := by omega
      have hvz_res : res₀ (v • z'₀) = res₀ (h₀ ^ r * x₀) := by
        rw [map_smul, ← hz'₀, hm_eq, pow_add, map_mul, mul_assoc, ← mul_smul_comm,
          ← hx₀, ← map_mul]
      have hvz : v • z'₀ = h₀ ^ r * x₀ := hInj₀ hvz_res
      let I_r : Ideal R₀ := Ideal.span ({h₀ ^ r} : Set R₀)
      have _ : Module.Free ↥V (R₀ ⧸ I_r) := (hQuot₀ r hr).1
      have hmk_v : v • I_r.mkQ z'₀ = 0 := by
        change I_r.mkQ (v • z'₀) = 0
        rw [hvz]
        exact (Submodule.Quotient.mk_eq_zero I_r).mpr (Ideal.mem_span_singleton.mpr ⟨x₀, rfl⟩)
      have hmk0 : I_r.mkQ z'₀ = 0 := h_free_torsfree (R₀ ⧸ I_r) v hv (I_r.mkQ z'₀) hmk_v
      obtain ⟨x_tilde, hx_tilde⟩ :=
        Ideal.mem_span_singleton.mp ((Submodule.Quotient.mk_eq_zero I_r).mp hmk0)
      rw [hW_mem]
      refine ⟨x_tilde, ?_⟩
      have hmul_r : res₀ (h₀ ^ r) * res₀ x_tilde =
          res₀ (h₀ ^ r) * (res₀ (h₀ ^ A₀) * res₁ y₁) := by
        rw [← map_mul, ← hx_tilde, ← hz'₀, hm_eq, pow_add, map_mul, mul_assoc]
      calc
        res₀ x_tilde
          = ((res₁ t₀) ^ r * (res₀ h₀) ^ r) * res₀ x_tilde := by rw [h_vu_pow r, one_mul]
        _ = (res₁ t₀) ^ r * (res₀ (h₀ ^ r) * res₀ x_tilde) := by rw [map_pow, mul_assoc]
        _ = (res₁ t₀) ^ r * (res₀ (h₀ ^ r) * (res₀ (h₀ ^ A₀) * res₁ y₁)) := by rw [hmul_r]
        _ = ((res₁ t₀) ^ r * (res₀ h₀) ^ r) * (res₀ (h₀ ^ A₀) * res₁ y₁) := by
              rw [map_pow, mul_assoc]
        _ = res₀ (h₀ ^ A₀) * res₁ y₁ := by rw [h_vu_pow r, one_mul]
  let q_mon : R₁ := Polynomial.aeval t₀ Q_mon
  let μ_q : R₁ →ₗ[↥V] R₁ := LinearMap.mulLeft ↥V q_mon
  let M_qW : Submodule ↥V R₁ := Submodule.map μ_q W
  let N_sat : Submodule ↥V (Fin L → ↥V) := Submodule.comap π_F M_qW
  have hN_sat : ∀ (v : ↥V) (α : Fin L → ↥V), v ≠ 0 → v • α ∈ N_sat → α ∈ N_sat := by
    intro v α hv hvα
    obtain ⟨x₁, hx₁W, hx₁_eq⟩ := Submodule.mem_map.mp (Submodule.mem_comap.mp hvα)
    rw [π_F.map_smul] at hx₁_eq
    change q_mon * x₁ = v • π_F α at hx₁_eq
    let I_q : Ideal R₁ := Ideal.span ({q_mon} : Set R₁)
    have _ : Module.Free ↥V (R₁ ⧸ I_q) := hMonic₁ Q_mon hQ_mon
    have hmk_v : v • I_q.mkQ (π_F α) = 0 := by
      change I_q.mkQ (v • π_F α) = 0
      rw [← hx₁_eq]
      exact (Submodule.Quotient.mk_eq_zero I_q).mpr (Ideal.mem_span_singleton.mpr ⟨x₁, rfl⟩)
    have hmk0 : I_q.mkQ (π_F α) = 0 :=
      h_free_torsfree (R₁ ⧸ I_q) v hv (I_q.mkQ (π_F α)) hmk_v
    obtain ⟨y₁, hy₁⟩ :=
      Ideal.mem_span_singleton.mp ((Submodule.Quotient.mk_eq_zero I_q).mp hmk0)
    have hmul_eq : q_mon * (v • y₁) = q_mon * x₁ := by
      rw [mul_smul_comm, ← hy₁, hx₁_eq]
    have hvy₁ : v • y₁ = x₁ := mul_left_cancel₀ hq_ne hmul_eq
    have hy₁W : y₁ ∈ W := hW_sat v y₁ hv (hvy₁ ▸ hx₁W)
    exact Submodule.mem_comap.mpr ⟨y₁, hy₁W, hy₁.symm⟩
  have hN_fg : N_sat.FG := hSatFG L N_sat hN_sat
  have hMqW_le : M_qW ≤ LinearMap.range π_F := by
    rintro _ ⟨x₁, hx₁W, rfl⟩
    obtain ⟨x₀, hx₀⟩ := (hW_mem x₁).mp hx₁W
    exact hEnv x₁ x₀ hx₀
  have hMqW_eq : Submodule.map π_F N_sat = M_qW := by
    rw [Submodule.map_comap_eq, inf_eq_right.mpr hMqW_le]
  have hMqW_fg : M_qW.FG := hMqW_eq ▸ hN_fg.map π_F
  have hμ_inj : Function.Injective μ_q := fun a b hab => mul_left_cancel₀ hq_ne hab
  have hW_fg : W.FG := Submodule.fg_of_fg_map_injective μ_q hμ_inj hMqW_fg
  exact ⟨A₀, W, hA₀_pos, hA₀_surj, hH1_fg, hW_mem, hW_fg⟩

theorem weil_sup1_fractional_quotients_and_twisted_h0_fg (K : Type u) [Field K]
    (V : ValuationSubring K)
    (R₀ R₁ R₀₁ : Type u) [CommRing R₀] [CommRing R₁] [CommRing R₀₁]
    [IsDomain R₀] [IsDomain R₁] [IsDomain R₀₁]
    [Algebra ↥V R₀] [Algebra ↥V R₁] [Algebra ↥V R₀₁]
    (res₀ : R₀ →ₐ[↥V] R₀₁) (res₁ : R₁ →ₐ[↥V] R₀₁)
    (hInj₀ : Function.Injective res₀) (hInj₁ : Function.Injective res₁)
    (h₀ eZ eY : R₀) (t₀ : R₁)
    (hh₀_ne : h₀ ≠ 0)
    (hht : res₀ h₀ * res₁ t₀ = 1)
    (heZ_add : eZ + eY = 1)
    (heZ_mul : eZ * eY ∈ Ideal.span ({h₀} : Set R₀))
    (hLoc₀ : @IsLocalization.Away _ _ h₀ R₀₁ _ res₀.toRingHom.toAlgebra)
    (hQuot₀ : ∀ r : ℕ, 1 ≤ r →
      Module.Free ↥V (R₀ ⧸ Ideal.span ({h₀ ^ r} : Set R₀)) ∧
      Module.Finite ↥V (R₀ ⧸ Ideal.span ({h₀ ^ r} : Set R₀)) ∧
      Nontrivial (R₀ ⧸ Ideal.span ({h₀ ^ r} : Set R₀)))
    (R₀_Y R₁_Y R₀₁_Y : Type u) [CommRing R₀_Y] [CommRing R₁_Y] [CommRing R₀₁_Y]
    (res₀_Y : R₀_Y →+* R₀₁_Y) (res₁_Y : R₁_Y →+* R₀₁_Y)
    (π₀ : R₀ →+* R₀_Y) (π₁ : R₁ →+* R₁_Y) (π₀₁ : R₀₁ →+* R₀₁_Y)
    (hSurj₀ : Function.Surjective π₀) (hSurj₁ : Function.Surjective π₁)
    (hKer₁ : RingHom.ker π₁ = Ideal.map (algebraMap ↥V R₁) (IsLocalRing.maximalIdeal ↥V))
    (hKer₀₁ : RingHom.ker π₀₁ = Ideal.map (algebraMap ↥V R₀₁) (IsLocalRing.maximalIdeal ↥V))
    (hComm₀ : res₀_Y.comp π₀ = π₀₁.comp res₀.toRingHom)
    (hComm₁ : res₁_Y.comp π₁ = π₀₁.comp res₁.toRingHom)
    (A₀ : ℕ) (W : Submodule ↥V R₁)
    (hA₀_pos : 1 ≤ A₀)
    (hA₀_surj : ∀ z : R₀₁, ∃ (x₀ : R₀) (x₁ : R₁), res₁ (t₀ ^ A₀) * res₀ x₀ - res₁ x₁ = z)
    (hH1_fg : ∀ S : Submodule ↥V R₀₁,
      LinearMap.range res₀.toLinearMap ≤ S →
      LinearMap.range res₁.toLinearMap ≤ S →
      (⊤ : Submodule ↥V (R₀₁ ⧸ S)).FG)
    (hW_mem : ∀ x₁ : R₁, x₁ ∈ W ↔ ∃ x₀ : R₀, res₀ x₀ = res₀ (h₀ ^ A₀) * res₁ x₁)
    (hW_fg : W.FG) :
    let I_Z : Ideal R₀ := Ideal.span ({h₀, eY} : Set R₀)
    let I_Z_Y : Ideal R₀_Y := Ideal.span ({π₀ h₀, π₀ eY} : Set R₀_Y)
    (∀ (k : ℕ) (x : R₀), x ∈ I_Z ^ k → ∃ y : R₀, y * h₀ ^ k = eZ ^ k * x) ∧
    (∀ (k₁ k₂ : ℕ) (x₁ x₂ : R₁),
      (∃ y₁ ∈ I_Z ^ k₁, res₀ y₁ = res₀ (h₀ ^ k₁) * res₁ x₁) →
      (∃ y₂ ∈ I_Z ^ k₂, res₀ y₂ = res₀ (h₀ ^ k₂) * res₁ x₂) →
      ∃ y₁₂ ∈ I_Z ^ (k₁ + k₂), res₀ y₁₂ = res₀ (h₀ ^ (k₁ + k₂)) * res₁ (x₁ * x₂)) ∧
    (∀ k : ℕ, 1 ≤ k →
      (∀ z_Y : R₀₁_Y, ∃ x₀_Y ∈ I_Z_Y ^ k, ∃ x₁_Y : R₁_Y,
        res₁_Y (π₁ t₀ ^ k) * res₀_Y x₀_Y - res₁_Y x₁_Y = z_Y) →
      (∀ z : R₀₁, ∃ x₀ ∈ I_Z ^ k, ∃ x₁ : R₁, res₁ (t₀ ^ k) * res₀ x₀ - res₁ x₁ = z) ∧
      ∃ (H₀_k : Submodule ↥V R₁),
        H₀_k.FG ∧
        (∀ x₁ : R₁, x₁ ∈ H₀_k ↔ ∃ x₀ ∈ I_Z ^ k, res₀ x₀ = res₀ (h₀ ^ k) * res₁ x₁) ∧
        (∀ x₁_Y : R₁_Y,
          (∃ x₀_Y ∈ I_Z_Y ^ k, res₀_Y x₀_Y = res₀_Y (π₀ h₀ ^ k) * res₁_Y x₁_Y) ↔
            ∃ x₁ ∈ H₀_k, π₁ x₁ = x₁_Y) ∧
        (∀ x₁ ∈ H₀_k, π₁ x₁ = 0 → x₁ ∈ (IsLocalRing.maximalIdeal ↥V) • H₀_k)) :=
by
  intro I_Z I_Z_Y
  have _ : Function.Injective res₁ ∧ 1 ≤ A₀ := ⟨hInj₁, hA₀_pos⟩
  have hFreeTorsFree : ∀ (M : Type u) [AddCommGroup M] [Module ↥V M] [Module.Free ↥V M]
      (v : ↥V) (x : M), v ≠ 0 → v • x = 0 → x = 0 := by
    intro M _ _ _ v x hv hvx
    let b := Module.Free.chooseBasis ↥V M
    apply b.repr.injective
    rw [map_zero]
    refine Finsupp.ext fun i => ?_
    rw [Finsupp.zero_apply]
    have h1 : (b.repr (v • x)) i = 0 := by rw [hvx, map_zero, Finsupp.zero_apply]
    rw [map_smul, Finsupp.smul_apply, smul_eq_mul] at h1
    exact (mul_eq_zero.mp h1).resolve_left hv
  have hVFreeOfFinTF : ∀ (M : Type u) [AddCommGroup M] [Module ↥V M] [Module.Finite ↥V M],
      (∀ (v : ↥V) (x : M), v ≠ 0 → v • x = 0 → x = 0) → Module.Free ↥V M := by
    intro M _ _ _ hTF
    have hTorsBot : Submodule.torsion ↥V M = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      rw [Submodule.mem_torsion_iff] at hx
      rcases hx with ⟨a, ha⟩
      have ha_ne : (a : ↥V) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp a.2
      have ha' : (a : ↥V) • x = 0 := by simpa [Submonoid.smul_def] using ha
      rw [Submodule.mem_bot]
      exact hTF (a : ↥V) x ha_ne ha'
    have hFlat : Module.Flat ↥V M :=
      (Module.Flat.flat_iff_torsion_eq_bot_of_isBezout (R := ↥V) (M := M)).mpr hTorsBot
    exact Module.free_of_flat_of_isLocalRing
  have hFinIffFG : ∀ (M : Type u) [AddCommGroup M] [Module ↥V M],
      Module.Finite ↥V M ↔ (⊤ : Submodule ↥V M).FG := by
    intro M _ _
    let eTop : ↥(⊤ : Submodule ↥V M) ≃ₗ[↥V] M := Submodule.topEquiv
    constructor
    · intro hFin
      have hFinTop : Module.Finite ↥V ↥(⊤ : Submodule ↥V M) :=
        Module.Finite.of_surjective eTop.symm.toLinearMap eTop.symm.surjective
      exact Module.Finite.iff_fg.mp hFinTop
    · intro hFG
      have hFinTop : Module.Finite ↥V ↥(⊤ : Submodule ↥V M) := Module.Finite.iff_fg.mpr hFG
      exact Module.Finite.of_surjective eTop.toLinearMap eTop.surjective
  have hSpanMul : ∀ (a : R₀) (I : Ideal R₀) (x : R₀),
      x ∈ Ideal.span ({a} : Set R₀) * I ↔ ∃ y ∈ I, x = a * y := by
    intro a I x
    constructor
    · intro hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro u hu w hw
        rcases Ideal.mem_span_singleton.mp hu with ⟨c, rfl⟩
        exact ⟨c * w, I.mul_mem_left c hw, mul_assoc a c w⟩
      · rintro x₁ x₂ ⟨y₁, hy₁, rfl⟩ ⟨y₂, hy₂, rfl⟩
        exact ⟨y₁ + y₂, I.add_mem hy₁ hy₂, (mul_add a y₁ y₂).symm⟩
    · rintro ⟨y, hy, rfl⟩
      exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self a) hy
  have hColon : ∀ (k : ℕ) (x : R₀), x ∈ I_Z ^ k → ∃ y : R₀, y * h₀ ^ k = eZ ^ k * x := by
    let J_colon : ℕ → Ideal R₀ := fun k =>
      { carrier := {x : R₀ | ∃ y : R₀, y * h₀ ^ k = eZ ^ k * x}
        zero_mem' := ⟨0, by simp⟩
        add_mem' := by
          rintro a b ⟨y₁, hy₁⟩ ⟨y₂, hy₂⟩
          exact ⟨y₁ + y₂, by rw [add_mul, mul_add, hy₁, hy₂]⟩
        smul_mem' := by
          rintro c a ⟨y, hy⟩
          refine ⟨c * y, ?_⟩
          rw [smul_eq_mul, mul_assoc, hy, ← mul_assoc, mul_comm c (eZ ^ k), mul_assoc] }
    have hJ1 : I_Z ≤ J_colon 1 := by
      rw [Ideal.span_le]
      intro x hx
      rcases Set.mem_insert_iff.mp hx with hxh | hx'
      · rw [hxh]
        exact ⟨eZ, by ring⟩
      · rw [Set.mem_singleton_iff.mp hx']
        rcases Ideal.mem_span_singleton.mp heZ_mul with ⟨w₀, hw₀⟩
        refine ⟨w₀, ?_⟩
        rw [pow_one, pow_one, mul_comm w₀ h₀, ← hw₀]
    have hJk : ∀ k : ℕ, I_Z ^ k ≤ J_colon k := by
      intro k
      induction k with
      | zero =>
        intro x _
        exact ⟨x, by simp⟩
      | succ k ih =>
        rw [pow_succ, Submodule.mul_le]
        intro a ha b hb
        rcases ih ha with ⟨y_a, hy_a⟩
        rcases hJ1 hb with ⟨y_b, hy_b⟩
        refine ⟨y_a * y_b, ?_⟩
        calc
          (y_a * y_b) * h₀ ^ (k + 1) = (y_a * h₀ ^ k) * (y_b * h₀ ^ 1) := by ring
          _ = (eZ ^ k * a) * (eZ ^ 1 * b) := by rw [hy_a, hy_b]
          _ = eZ ^ (k + 1) * (a * b) := by ring
    intro k x hx
    exact hJk k hx
  have hFree_IZ : ∀ (r k : ℕ), 1 ≤ k →
      Module.Free ↥V (R₀ ⧸ (Ideal.span ({h₀ ^ r} : Set R₀) * I_Z ^ k)) := by
    intro r k hk
    let I_Y' : Ideal R₀ := Ideal.span ({h₀, eZ} : Set R₀)
    have hCop : IsCoprime I_Z I_Y' := by
      rw [Ideal.isCoprime_iff_sup_eq, Ideal.eq_top_iff_one, ← heZ_add]
      exact Submodule.add_mem _
        (Ideal.mem_sup_right (Ideal.subset_span (by simp)))
        (Ideal.mem_sup_left (Ideal.subset_span (by simp)))
    have hCop_k : IsCoprime (I_Z ^ k) (I_Y' ^ k) := hCop.pow
    have hMul_eq : I_Z * I_Y' = Ideal.span ({h₀} : Set R₀) := by
      apply le_antisymm
      · rw [Submodule.mul_le]
        intro a ha b hb
        refine Submodule.span_induction
          (fun x hx => ?_)
          (by simp)
          (fun x₁ x₂ _ _ hx₁ hx₂ => by rw [add_mul]; exact Ideal.add_mem _ hx₁ hx₂)
          (fun c x _ hx => by rw [smul_eq_mul, mul_assoc]; exact Ideal.mul_mem_left _ c hx)
          ha
        rcases Set.mem_insert_iff.mp hx with hxh | hx'
        · rw [hxh]
          exact Ideal.mem_span_singleton.mpr ⟨b, rfl⟩
        · rw [Set.mem_singleton_iff.mp hx']
          refine Submodule.span_induction
            (fun y hy => ?_)
            (by simp)
            (fun y₁ y₂ _ _ hy₁ hy₂ => by rw [mul_add]; exact Ideal.add_mem _ hy₁ hy₂)
            (fun c y _ hy => by
              rw [smul_eq_mul, ← mul_assoc, mul_comm eY c, mul_assoc]
              exact Ideal.mul_mem_left _ c hy)
            hb
          rcases Set.mem_insert_iff.mp hy with hyh | hy'
          · rw [hyh]
            exact Ideal.mem_span_singleton.mpr ⟨eY, mul_comm eY h₀⟩
          · rw [Set.mem_singleton_iff.mp hy', mul_comm]
            exact heZ_mul
      · rw [Ideal.span_singleton_le_iff_mem]
        have hh₀_decomp : h₀ = h₀ * eZ + eY * h₀ := by
          calc
            h₀ = h₀ * 1 := (mul_one h₀).symm
            _ = h₀ * (eZ + eY) := by rw [heZ_add]
            _ = h₀ * eZ + eY * h₀ := by ring
        rw [hh₀_decomp]
        exact Ideal.add_mem _
          (Ideal.mul_mem_mul (Ideal.subset_span (by simp)) (Ideal.subset_span (by simp)))
          (Ideal.mul_mem_mul (Ideal.subset_span (by simp)) (Ideal.subset_span (by simp)))
    have hInf_eq : I_Z ^ k ⊓ I_Y' ^ k = Ideal.span ({h₀ ^ k} : Set R₀) := by
      rw [← Ideal.mul_eq_inf_of_isCoprime hCop_k, ← mul_pow, hMul_eq, Ideal.span_singleton_pow]
    let e_eq_alg : (R₀ ⧸ (I_Z ^ k ⊓ I_Y' ^ k)) ≃ₐ[↥V] (R₀ ⧸ Ideal.span ({h₀ ^ k} : Set R₀)) :=
      { Ideal.quotEquivOfEq hInf_eq with
        commutes' := fun _ => rfl }
    let e_crt_ring := Ideal.quotientInfEquivQuotientProd (I_Z ^ k) (I_Y' ^ k) hCop_k
    let e_crt : (R₀ ⧸ (I_Z ^ k ⊓ I_Y' ^ k)) ≃ₗ[↥V] (R₀ ⧸ I_Z ^ k) × (R₀ ⧸ I_Y' ^ k) :=
      { e_crt_ring with
        map_smul' := fun v q => by
          induction q using Quotient.inductionOn' with
          | h x => rfl }
    let e_prod : (R₀ ⧸ Ideal.span ({h₀ ^ k} : Set R₀)) ≃ₗ[↥V] (R₀ ⧸ I_Z ^ k) × (R₀ ⧸ I_Y' ^ k) :=
      e_eq_alg.symm.toLinearEquiv.trans e_crt
    have hFree_hk : Module.Free ↥V (R₀ ⧸ Ideal.span ({h₀ ^ k} : Set R₀)) := (hQuot₀ k hk).1
    have hFin_hk : Module.Finite ↥V (R₀ ⧸ Ideal.span ({h₀ ^ k} : Set R₀)) := (hQuot₀ k hk).2.1
    have hFin_IZk : Module.Finite ↥V (R₀ ⧸ I_Z ^ k) := by
      let proj₁ : (R₀ ⧸ Ideal.span ({h₀ ^ k} : Set R₀)) →ₗ[↥V] (R₀ ⧸ I_Z ^ k) :=
        (LinearMap.fst ↥V (R₀ ⧸ I_Z ^ k) (R₀ ⧸ I_Y' ^ k)).comp e_prod.toLinearMap
      have hSurj_proj₁ : Function.Surjective proj₁ :=
        (Prod.fst_surjective).comp e_prod.surjective
      exact Module.Finite.of_surjective proj₁ hSurj_proj₁
    have hTF_IZk : ∀ (v : ↥V) (q : R₀ ⧸ I_Z ^ k), v ≠ 0 → v • q = 0 → q = 0 := by
      intro v q hv hvq
      let x := e_prod.symm (q, 0)
      have hvx : v • x = 0 := by
