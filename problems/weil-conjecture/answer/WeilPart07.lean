      obtain ⟨hle_X₁, hnd₁⟩ := hAway_nd X₁ ψ₁ hψ₁ a
      obtain ⟨hle_X₂, hnd₂⟩ := hAway_nd X₂ ψ₂ hψ₂ a
      let W₁_a : X₁.Opens := X₁.basicOpen (ψ₁ (MvPolynomial.X a))
      let W₂_a : X₂.Opens := X₂.basicOpen (ψ₂ (MvPolynomial.X a))
