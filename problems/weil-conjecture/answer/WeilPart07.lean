        intro U hU h𝔭U
        have hOpenImg : IsOpen (hAff_V₁_Y.fromSpec.base '' U) := hf.isOpenMap U hU
        have hqImg : q ∈ hAff_V₁_Y.fromSpec.base '' U := ⟨𝔭, h𝔭U, rfl⟩
        obtain ⟨y', hy'_img, hy'_eq⟩ := mem_closure_iff.mp hcl _ hOpenImg hqImg
        rw [Set.mem_singleton_iff] at hy'_eq
        rcases hy'_img with ⟨𝔭', h𝔭'U, h𝔭'_eq⟩
        have h_eq : 𝔭' = 𝔮 := hf.injective (h𝔭'_eq.trans hy'_eq)
        exact ⟨𝔮, h_eq ▸ h𝔭'U, Set.mem_singleton 𝔮⟩
      intro r hr
      have hsub : closure ({𝔮} : Set _) ⊆ PrimeSpectrum.zeroLocus ({r} : Set _) :=
        closure_minimal
          (by
            intro x hx
            rw [Set.mem_singleton_iff.mp hx]
            exact Set.singleton_subset_iff.mpr hr)
          (PrimeSpectrum.isClosed_zeroLocus {r})
      exact Set.singleton_subset_iff.mp (hsub h𝔭_cl)
    refine ⟨?_, ?_, ?_⟩
    · have hClosedZ : IsClosed Z := isClosed_of_mem_irreducibleComponents Z hZ_comp
      let η_Z : ↥Y := hZ_comp.1.genericPoint
      have hcl_Z : closure ({η_Z} : Set ↥Y) = Z :=
        hZ_comp.1.closure_genericPoint hClosedZ
      have hηZ_mem : η_Z ∈ Z := by
        rw [← hcl_Z]
        exact subset_closure (Set.mem_singleton η_Z)
      have hηZ_V₁ : η_Z ∈ V₁_Y := by
        by_contra hnot
        have hsub : Z ⊆ (V₁_Y : Set ↥Y)ᶜ := by
          rw [← hcl_Z]
          exact closure_minimal (Set.singleton_subset_iff.mpr hnot) V₁_Y.isOpen.isClosed_compl
        exact hsub hqZ hq_V₁
      let 𝔮_Z := hAff_V₁_Y.primeIdealOf ⟨η_Z, hηZ_V₁⟩
      have h𝔮Z_pt : hAff_V₁_Y.fromSpec.base 𝔮_Z = η_Z :=
        hAff_V₁_Y.fromSpec_primeIdealOf ⟨η_Z, hηZ_V₁⟩
      refine ⟨𝔮_Z, hSpec_le 𝔮_Z (by rw [h𝔮Z_pt, hcl_Z]; exact hqZ), ?_, ?_⟩
      · rw [hKer_le_iff V₁_Y hAff_V₁_Y ιZ 𝔮_Z, h𝔮Z_pt, hRange_Z]
        exact hηZ_mem
      · intro hbad
        rw [hKer_le_iff V₁_Y hAff_V₁_Y ιY' 𝔮_Z, h𝔮Z_pt, hRange_Y'] at hbad
        change η_Z ∈ ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E' at hbad
        simp only [Set.mem_iUnion, Set.mem_sdiff, Set.mem_singleton_iff] at hbad
        rcases hbad with ⟨E', ⟨hE'_comp, hE'_ne⟩, hη_E'⟩
        have hClosedE' : IsClosed E' := isClosed_of_mem_irreducibleComponents E' hE'_comp
        have hZ_sub_E' : Z ⊆ E' := by
          rw [← hcl_Z]
          exact closure_minimal (Set.singleton_subset_iff.mpr hη_E') hClosedE'
        have hE'_sub_Z : E' ⊆ Z := hZ_comp.2 hE'_comp.1 hZ_sub_E'
        exact hE'_ne (Set.Subset.antisymm hE'_sub_Z hZ_sub_E')
    · have hqY'_un : q ∈ ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E' := hqY'
      simp only [Set.mem_iUnion, Set.mem_sdiff, Set.mem_singleton_iff] at hqY'_un
      rcases hqY'_un with ⟨E', ⟨hE'_comp, hE'_ne⟩, hqE'⟩
      have hClosedE' : IsClosed E' := isClosed_of_mem_irreducibleComponents E' hE'_comp
      let η_E' : ↥Y := hE'_comp.1.genericPoint
      have hcl_E' : closure ({η_E'} : Set ↥Y) = E' :=
        hE'_comp.1.closure_genericPoint hClosedE'
      have hηE'_mem : η_E' ∈ E' := by
        rw [← hcl_E']
        exact subset_closure (Set.mem_singleton η_E')
      have hηE'_V₁ : η_E' ∈ V₁_Y := by
        by_contra hnot
        have hsub : E' ⊆ (V₁_Y : Set ↥Y)ᶜ := by
          rw [← hcl_E']
          exact closure_minimal (Set.singleton_subset_iff.mpr hnot) V₁_Y.isOpen.isClosed_compl
        exact hsub hqE' hq_V₁
      let 𝔮_Y' := hAff_V₁_Y.primeIdealOf ⟨η_E', hηE'_V₁⟩
      have h𝔮Y'_pt : hAff_V₁_Y.fromSpec.base 𝔮_Y' = η_E' :=
        hAff_V₁_Y.fromSpec_primeIdealOf ⟨η_E', hηE'_V₁⟩
      refine ⟨𝔮_Y', hSpec_le 𝔮_Y' (by rw [h𝔮Y'_pt, hcl_E']; exact hqE'), ?_, ?_⟩
      · rw [hKer_le_iff V₁_Y hAff_V₁_Y ιY' 𝔮_Y', h𝔮Y'_pt, hRange_Y']
        exact Set.mem_biUnion ⟨hE'_comp, hE'_ne⟩ hηE'_mem
      · intro hbad
        rw [hKer_le_iff V₁_Y hAff_V₁_Y ιZ 𝔮_Y', h𝔮Y'_pt, hRange_Z] at hbad
        have hClosedZ : IsClosed Z := isClosed_of_mem_irreducibleComponents Z hZ_comp
        have hE'_sub_Z : E' ⊆ Z := by
          rw [← hcl_E']
          exact closure_minimal (Set.singleton_subset_iff.mpr hbad) hClosedZ
        have hZ_sub_E' : Z ⊆ E' := hE'_comp.2 hZ_comp.1 hE'_sub_Z
        exact hE'_ne (Set.Subset.antisymm hE'_sub_Z hZ_sub_E')
    · rcases hSemistab_Y q with hSm_q | ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, he₁_u₀, he₂_u₀, he₁₂⟩
      · exact False.elim (hNonSm_Δ q ⟨hqZ, hqY'⟩ hSm_q)
      · have hu₀_pre : u₀ ∈ (TopologicalSpace.Opens.map e₁.base).obj V₁_Y := by
          change e₁.base u₀ ∈ (V₁_Y : Set ↥Y)
          rw [he₁_u₀]
          exact hq_V₁
        obtain ⟨W', hAff_W', hu₀_W', hW'_sub⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hu₀_pre
        let D : Type u := ↑(U'.presheaf.obj (Opposite.op W'))
        let 𝔫₀ : PrimeSpectrum D := hAff_W'.primeIdealOf ⟨u₀, hu₀_W'⟩
        have h𝔫₀_pt : hAff_W'.fromSpec.base 𝔫₀ = u₀ :=
          hAff_W'.fromSpec_primeIdealOf ⟨u₀, hu₀_W'⟩
        let ψ₁ : ↑R₁_Y →+* D := (e₁.appLE V₁_Y W' hW'_sub).hom
        let ψ₂ : (MvPolynomial (Fin 2) k₀ ⧸
            Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) k₀))) →+* D :=
          (AlgebraicGeometry.Spec.preimage (hAff_W'.fromSpec ≫ e₂)).hom
        have hψ₁_et : ψ₁.Etale :=
          AlgebraicGeometry.HasRingHomProperty.appLE @AlgebraicGeometry.Etale
            e₁ hEt₁ ⟨V₁_Y, hAff_V₁_Y⟩ ⟨W', hAff_W'⟩ hW'_sub
        have h_comp_et : AlgebraicGeometry.Etale (hAff_W'.fromSpec ≫ e₂) := inferInstance
        have hψ₂_et : ψ₂.Etale := by
          rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale),
            AlgebraicGeometry.Spec.map_preimage]
          exact h_comp_et
        have h_comap_ψ₁ : PrimeSpectrum.comap ψ₁ 𝔫₀ = 𝔭 := by
          have hsq := hAff_V₁_Y.SpecMap_appLE_fromSpec e₁ hAff_W' hW'_sub
          have heval := congrArg (fun f => f.base 𝔫₀) hsq
          change hAff_V₁_Y.fromSpec.base (PrimeSpectrum.comap ψ₁ 𝔫₀) =
            e₁.base (hAff_W'.fromSpec.base 𝔫₀) at heval
          rw [h𝔫₀_pt, he₁_u₀] at heval
          exact hAff_V₁_Y.fromSpec.isOpenEmbedding.injective heval
        have h_X_mem : ∀ i : Fin 2,
            ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ 𝔫₀.asIdeal := by
          have hmap := AlgebraicGeometry.Spec.map_preimage (hAff_W'.fromSpec ≫ e₂)
          have heval := congrArg (fun f => f.base 𝔫₀) hmap
          change PrimeSpectrum.comap ψ₂ 𝔫₀ = e₂.base (hAff_W'.fromSpec.base 𝔫₀) at heval
          rw [h𝔫₀_pt] at heval
          intro i
          change Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (PrimeSpectrum.comap ψ₂ 𝔫₀).asIdeal
          rw [heval]
          exact he₂_u₀ i
        have h_hom_eq : CommRingCat.ofHom (ψ₁.comp c₁_Y) =
            CommRingCat.ofHom (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) := by
          apply AlgebraicGeometry.Spec.map_inj.mp
          have hlhs : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₁.comp c₁_Y)) =
              hAff_W'.fromSpec ≫ e₁ ≫ sndY := by
            have h1 : CommRingCat.ofHom (ψ₁.comp c₁_Y) =
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
                  sndY.appLE ⊤ V₁_Y le_top ≫ e₁.appLE V₁_Y W' hW'_sub := rfl
            rw [h1, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
              ← AlgebraicGeometry.Scheme.isoSpec_Spec_inv,
              ← AlgebraicGeometry.IsAffineOpen.fromSpec_top]
            rw [CategoryTheory.Category.assoc,
              (AlgebraicGeometry.isAffineOpen_top
                (AlgebraicGeometry.Spec (CommRingCat.of k₀))).SpecMap_appLE_fromSpec
                sndY hAff_V₁_Y le_top,
              ← CategoryTheory.Category.assoc,
              hAff_V₁_Y.SpecMap_appLE_fromSpec e₁ hAff_W' hW'_sub,
              CategoryTheory.Category.assoc]
          have hrhs : AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))) =
              hAff_W'.fromSpec ≫ e₁ ≫ sndY := by
            have h2 : CommRingCat.ofHom (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
                CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C) ≫
                  AlgebraicGeometry.Spec.preimage (hAff_W'.fromSpec ≫ e₂) := rfl
            rw [h2, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
              CategoryTheory.Category.assoc, ← he₁₂]
          exact hlhs.trans hrhs.symm
        exact ⟨D, inferInstance, 𝔫₀, ψ₁, ψ₂, hψ₁_et, hψ₂_et, h_comap_ψ₁, h_X_mem,
          congrArg CommRingCat.Hom.hom h_hom_eq⟩
  
  exact ⟨⟨instAlgClosed_k₀, instRed_R1, instNoeth_R1, hInj₀, hInj₁⟩,
    ⟨hAff_VZ0, hAff_VZ1, hNe_VZ0, hNe_VZ1, hCov_VZ, instDom_AZ0, h_h₀_Z_ne, instNontriv_AZ1⟩,
    ⟨⟨w₀_Y, heZeY_Y⟩, hht_Y⟩,
    ⟨hSurj_Z0, hSurj_Z1, hSurj_Z01, hRad_Z1, hIZ_iff, hVan_Z0, hVan_Z1⟩,
    ⟨A'_0, A'_1, A'_01, inferInstance, inferInstance, inferInstance,
      res'_0, res'_1, π'_0, π'_1, π'_01, u₁_V₁, u₁_V₀, α₀, β₀, 𝔭₁, 𝔭₂,
      hComm'_0, hComm'_1, hSurj'_0, hSurj'_1, hSurj'_01, hRad'_1,
      hKer0, hKer1, hKer01, hLoc'_0, hLift0, hu₁_glue, hBezout,
      hu₁_pow_ne, hu₁_basicOpen, hSΔ_eq, hu₁_p1, hu₁_p2, hNodes⟩⟩

theorem weil_sup1_bezout_koszul_veronese_algebra (k₀ : Type u) [Field k₀]
    (R₀ R₁ R₀₁ A_Z0 A_Z1 A_Z01 A'_0 A'_1 A'_01 : Type u)
    [CommRing R₀] [CommRing R₁] [CommRing R₀₁]
    [CommRing A_Z0] [CommRing A_Z1] [CommRing A_Z01]
    [CommRing A'_0] [CommRing A'_1] [CommRing A'_01]
    [IsDomain A_Z0] [Nontrivial A_Z1]
    [Algebra k₀ R₀] [Algebra k₀ R₁] [Algebra k₀ R₀₁]
    (res₀ : R₀ →ₐ[k₀] R₀₁) (res₁ : R₁ →ₐ[k₀] R₀₁)
    (hInj₀ : Function.Injective res₀)
    (hInj₁ : Function.Injective res₁)
    (res_Z0 : A_Z0 →+* A_Z01) (res_Z1 : A_Z1 →+* A_Z01)
    (π_Z0 : R₀ →+* A_Z0) (π_Z1 : R₁ →+* A_Z1) (π_Z01 : R₀₁ →+* A_Z01)
    (hComm_Z0 : res_Z0.comp π_Z0 = π_Z01.comp res₀.toRingHom)
    (hComm_Z1 : res_Z1.comp π_Z1 = π_Z01.comp res₁.toRingHom)
    (hSurj_Z0 : Function.Surjective π_Z0)
    (hSurj_Z1 : Function.Surjective π_Z1)
    (res'_0 : A'_0 →+* A'_01) (res'_1 : A'_1 →+* A'_01)
    (π'_0 : R₀ →+* A'_0) (π'_1 : R₁ →+* A'_1) (π'_01 : R₀₁ →+* A'_01)
    (hComm'_0 : res'_0.comp π'_0 = π'_01.comp res₀.toRingHom)
    (hComm'_1 : res'_1.comp π'_1 = π'_01.comp res₁.toRingHom)
    (hSurj'_0 : Function.Surjective π'_0)
    (hSurj'_1 : Function.Surjective π'_1)
    (hSurj'_01 : Function.Surjective π'_01)
    (hKer0 : RingHom.ker π_Z0 ⊓ RingHom.ker π'_0 = ⊥)
    (hKer1 : RingHom.ker π_Z1 ⊓ RingHom.ker π'_1 = ⊥)
    (hKer01 : RingHom.ker π_Z01 ⊓ RingHom.ker π'_01 = ⊥)
    (hLift0 : ∀ d₀ : R₀, res₀ d₀ ∈ RingHom.ker π_Z01 ⊔ RingHom.ker π'_01 →
      d₀ ∈ RingHom.ker π_Z0 ⊔ RingHom.ker π'_0)
    (h₀ eZ eY w₀ : R₀) (t₀ : R₁)
    (h_h₀_Z_ne : π_Z0 h₀ ≠ 0)
    (heZeY : eZ * eY = h₀ * w₀)
    (hht : res₀ h₀ * res₁ t₀ = 1)
    (hLoc'_0 : @IsLocalization.Away _ _ (π'_0 h₀) A'_01 _ res'_0.toAlgebra)
    (hIZ_iff : ∀ (k : ℕ) (x₀ : R₀),
      x₀ ∈ (Ideal.span ({h₀, eY} : Set R₀)) ^ k ↔ π_Z0 x₀ ∈ Ideal.span {π_Z0 h₀ ^ k})
    (hZ_H0 : ∀ (a₀ : A_Z0) (a₁ : A_Z1), res_Z0 a₀ = res_Z1 a₁ →
      ∃ c : k₀, a₀ = π_Z0 (algebraMap k₀ R₀ c) ∧ a₁ = π_Z1 (algebraMap k₀ R₁ c))
    (hZ_H1 : ∀ z_Z : A_Z01, ∃ (a₀ : A_Z0) (a₁ : A_Z1), res_Z0 a₀ - res_Z1 a₁ = z_Z)
    (ev₁ ev₂ : R₁ →ₐ[k₀] k₀)
    (hSum_iff : ∀ x : R₁, x ∈ RingHom.ker π_Z1 ⊔ RingHom.ker π'_1 ↔ ev₁ x = 0 ∧ ev₂ x = 0)
    (u₁_V₁ : R₁) (u₁_V₀ : R₀) (α₀ β₀ : A'_0)
    (hu₁_glue : res₀ (h₀ ^ 2) * res₁ u₁_V₁ = res₀ u₁_V₀)
    (hu₁_ev₁ : ev₁ u₁_V₁ = 0)
    (hu₁_ev₂ : ev₂ u₁_V₁ = 0)
    (hBezout : α₀ * (π'_0 h₀) ^ 2 + β₀ * (π'_0 u₁_V₀) = 1)
    (hu₁_pow_ne : ∀ K₀ : ℕ, 1 ≤ K₀ → π'_0 (u₁_V₀ ^ K₀) ≠ 0)
    (A₀ : ℕ) (hA₀_pos : 1 ≤ A₀)
    (hA₀_surj : ∀ z : R₀₁, ∃ (x₀ : R₀) (x₁ : R₁), res₁ (t₀ ^ A₀) * res₀ x₀ - res₁ x₁ = z) :
    let I_Z : Ideal R₀ := Ideal.span ({h₀, eY} : Set R₀)
    ∃ (K₀ m₀ : ℕ) (f₁_bar : R₁) (x₀_f₁ xZ_f₁ : R₀),
      1 ≤ K₀ ∧
      m₀ = 2 * K₀ ∧
      6 ≤ m₀ ∧
      x₀_f₁ ∈ I_Z ^ m₀ ∧
      res₀ x₀_f₁ = res₀ (h₀ ^ m₀) * res₁ f₁_bar ∧
      xZ_f₁ * h₀ ^ m₀ = eZ ^ m₀ * x₀_f₁ ∧
      π'_0 x₀_f₁ = π'_0 (u₁_V₀ ^ K₀) ∧
      π_Z0 xZ_f₁ = 0 ∧
      π_Z1 f₁_bar = 0 ∧
      (∀ (c₀ c₁ : k₀), algebraMap k₀ R₁ c₀ + c₁ • f₁_bar = 0 → c₀ = 0 ∧ c₁ = 0) ∧
      (∀ r : ℕ, 1 ≤ r → ∀ z : R₀₁,
        ∃ x₀ ∈ I_Z ^ (r * m₀), ∃ x₁ : R₁,
          res₁ (t₀ ^ (r * m₀)) * res₀ x₀ - res₁ x₁ = z) ∧
      (∀ r : ℕ, 1 ≤ r →
        ∀ x₁ : R₁,
          (∃ x₀ ∈ I_Z ^ (r * m₀), res₀ x₀ = res₀ (h₀ ^ (r * m₀)) * res₁ x₁) →
          x₁ ∈ (Submodule.span k₀
            {u : R₁ | ∃ x₀ ∈ I_Z ^ m₀, res₀ x₀ = res₀ (h₀ ^ m₀) * res₁ u}) ^ r) :=
by
  intro I_Z
  
  have hc_res : ∀ c : k₀, res₀ (algebraMap k₀ R₀ c) = res₁ (algebraMap k₀ R₁ c) := by
    intro c
    rw [res₀.commutes, res₁.commutes]
  have hev₁_c : ∀ c : k₀, ev₁ (algebraMap k₀ R₁ c) = c := fun c => ev₁.commutes c
  have hev₂_c : ∀ c : k₀, ev₂ (algebraMap k₀ R₁ c) = c := fun c => ev₂.commutes c
  have hComm_Z0_pt : ∀ x : R₀, res_Z0 (π_Z0 x) = π_Z01 (res₀ x) :=
    fun x => RingHom.congr_fun hComm_Z0 x
  have hComm_Z1_pt : ∀ x : R₁, res_Z1 (π_Z1 x) = π_Z01 (res₁ x) :=
    fun x => RingHom.congr_fun hComm_Z1 x
  have hComm'_0_pt : ∀ x : R₀, res'_0 (π'_0 x) = π'_01 (res₀ x) :=
    fun x => RingHom.congr_fun hComm'_0 x
  have hComm'_1_pt : ∀ x : R₁, res'_1 (π'_1 x) = π'_01 (res₁ x) :=
    fun x => RingHom.congr_fun hComm'_1 x
  let c'_0 : k₀ →+* A'_0 := π'_0.comp (algebraMap k₀ R₀)
  let c'_1 : k₀ →+* A'_1 := π'_1.comp (algebraMap k₀ R₁)
  have hc'_comm : ∀ c : k₀, res'_0 (c'_0 c) = res'_1 (c'_1 c) := by
    intro c
    dsimp [c'_0, c'_1]
    rw [hComm'_0_pt, hComm'_1_pt, hc_res]
  have hc_Z_comm : ∀ c : k₀, res_Z0 (π_Z0 (algebraMap k₀ R₀ c)) = res_Z1 (π_Z1 (algebraMap k₀ R₁ c)) := by
    intro c
    rw [hComm_Z0_pt, hComm_Z1_pt, hc_res]
  let h'_0 : A'_0 := π'_0 h₀
  let t'_0 : A'_1 := π'_1 t₀
  let u'_0 : A'_0 := π'_0 u₁_V₀
  let u'_1 : A'_1 := π'_1 u₁_V₁
  let H' : A'_01 := res'_0 h'_0
  let T' : A'_01 := res'_1 t'_0
  have hHT' : H' * T' = 1 := by
    dsimp [H', T', h'_0, t'_0]
    rw [hComm'_0_pt, hComm'_1_pt, ← map_mul, hht, map_one]
  have hTH' : T' * H' = 1 := by rw [mul_comm, hHT']
  have hHT'_pow : ∀ n : ℕ, H' ^ n * T' ^ n = 1 := by
    intro n; rw [← mul_pow, hHT', one_pow]
  have hTH'_pow : ∀ n : ℕ, T' ^ n * H' ^ n = 1 := by
    intro n; rw [← mul_pow, hTH', one_pow]
  have ht_res_pow : ∀ n : ℕ, res₁ (t₀ ^ n) * res₀ (h₀ ^ n) = 1 := by
    intro n; rw [map_pow, map_pow, ← mul_pow, mul_comm, hht, one_pow]
  have hu'_glue : res'_0 u'_0 = H' ^ 2 * res'_1 u'_1 := by
    dsimp [u'_0, u'_1, H', h'_0]
    rw [hComm'_0_pt, ← hu₁_glue, map_mul, map_pow, map_pow, ← hComm'_0_pt, ← hComm'_1_pt]

  
  
  
  have h_s1 : ∃ (ev'_1 ev'_2 : A'_1 →+* k₀) (N_sep : ℕ) (g0_sep : A'_0) (g_sep : A'_1),
      (∀ x : R₁, ev'_1 (π'_1 x) = ev₁ x) ∧
      (∀ x : R₁, ev'_2 (π'_1 x) = ev₂ x) ∧
      (∀ (k : ℕ) (c : k₀) (y'_0 : A'_0) (y'_1 : A'_1),
        res'_0 y'_0 = H' ^ k * res'_1 y'_1 →
        ev'_1 y'_1 = c →
        ev'_2 y'_1 = c →
        ∃ (x₀ : R₀) (x₁ : R₁),
          x₀ ∈ I_Z ^ k ∧
          res₀ x₀ = res₀ (h₀ ^ k) * res₁ x₁ ∧
          π_Z0 x₀ = π_Z0 (algebraMap k₀ R₀ c) * (π_Z0 h₀) ^ k ∧
          π'_0 x₀ = y'_0 ∧
          π_Z1 x₁ = π_Z1 (algebraMap k₀ R₁ c) ∧
          π'_1 x₁ = y'_1) ∧
      (∀ (k : ℕ) (x₀ : R₀) (x₁ : R₁),
        x₀ ∈ I_Z ^ k →
        res₀ x₀ = res₀ (h₀ ^ k) * res₁ x₁ →
        ∃ c : k₀,
          π_Z1 x₁ = π_Z1 (algebraMap k₀ R₁ c) ∧
          ev₁ x₁ = c ∧
          ev₂ x₁ = c) ∧
      res'_0 g0_sep = H' ^ N_sep * res'_1 g_sep ∧
      (∀ δ : k₀, (ev'_1 = ev'_2 → δ = 0) →
        ev'_1 (c'_1 δ * g_sep) = δ ∧
        ev'_2 (c'_1 δ * g_sep) = 0) := by
    obtain ⟨σ'_1, hσ'_1⟩ := Function.surjective_iff_hasRightInverse.mp hSurj'_1
    have hker₁ : ∀ x : R₁, x ∈ RingHom.ker π'_1 → ev₁.toRingHom x = 0 := by
      intro x hx
      exact ((hSum_iff x).mp (Submodule.mem_sup_right hx)).1
    have hker₂ : ∀ x : R₁, x ∈ RingHom.ker π'_1 → ev₂.toRingHom x = 0 := by
      intro x hx
      exact ((hSum_iff x).mp (Submodule.mem_sup_right hx)).2
    let ev'_1 : A'_1 →+* k₀ := RingHom.liftOfRightInverseAux π'_1 σ'_1 hσ'_1 ev₁.toRingHom hker₁
    let ev'_2 : A'_1 →+* k₀ := RingHom.liftOfRightInverseAux π'_1 σ'_1 hσ'_1 ev₂.toRingHom hker₂
    have hev'_1 : ∀ x : R₁, ev'_1 (π'_1 x) = ev₁ x :=
      fun x => RingHom.liftOfRightInverseAux_comp_apply π'_1 σ'_1 hσ'_1 ev₁.toRingHom hker₁ x
    have hev'_2 : ∀ x : R₁, ev'_2 (π'_1 x) = ev₂ x :=
      fun x => RingHom.liftOfRightInverseAux_comp_apply π'_1 σ'_1 hσ'_1 ev₂.toRingHom hker₂ x
    have hev'_1_c : ∀ c : k₀, ev'_1 (c'_1 c) = c := by
      intro c; dsimp [c'_1]; rw [hev'_1, hev₁_c]
    have hev'_2_c : ∀ c : k₀, ev'_2 (c'_1 c) = c := by
      intro c; dsimp [c'_1]; rw [hev'_2, hev₂_c]
    
    have hGlue : ∀ (k : ℕ) (c : k₀) (y'_0 : A'_0) (y'_1 : A'_1),
        res'_0 y'_0 = H' ^ k * res'_1 y'_1 →
        ev'_1 y'_1 = c →
        ev'_2 y'_1 = c →
        ∃ (x₀ : R₀) (x₁ : R₁),
          x₀ ∈ I_Z ^ k ∧
          res₀ x₀ = res₀ (h₀ ^ k) * res₁ x₁ ∧
          π_Z0 x₀ = π_Z0 (algebraMap k₀ R₀ c) * (π_Z0 h₀) ^ k ∧
          π'_0 x₀ = y'_0 ∧
          π_Z1 x₁ = π_Z1 (algebraMap k₀ R₁ c) ∧
          π'_1 x₁ = y'_1 := by
      intro k c y'_0 y'_1 hy_glue hy_ev1 hy_ev2
      obtain ⟨r'_1, hr'_1⟩ := hSurj'_1 y'_1
      let r_Z1 : R₁ := algebraMap k₀ R₁ c
      have hdiff1_mem : r_Z1 - r'_1 ∈ RingHom.ker π_Z1 ⊔ RingHom.ker π'_1 := by
        rw [hSum_iff]
        constructor
        · rw [map_sub, hev₁_c, ← hy_ev1, ← hr'_1, hev'_1, sub_self]
        · rw [map_sub, hev₂_c, ← hy_ev2, ← hr'_1, hev'_2, sub_self]
      obtain ⟨j_Z1, hj_Z1, j'_1, hj'_1, hj1_eq⟩ := Submodule.mem_sup.mp hdiff1_mem
      let x₁ : R₁ := r_Z1 - j_Z1
      have hx₁_alt : x₁ = r'_1 + j'_1 := by
        dsimp [x₁]
        linear_combination -hj1_eq
      have hx₁_Z : π_Z1 x₁ = π_Z1 r_Z1 := by
        dsimp [x₁]
        rw [map_sub, RingHom.mem_ker.mp hj_Z1, sub_zero]
      have hx₁_Y' : π'_1 x₁ = y'_1 := by
        rw [hx₁_alt, map_add, hr'_1, RingHom.mem_ker.mp hj'_1, add_zero]
      obtain ⟨r'_0, hr'_0⟩ := hSurj'_0 y'_0
      let r_Z0 : R₀ := algebraMap k₀ R₀ c * h₀ ^ k
      let w_01 : R₀₁ := res₀ (h₀ ^ k) * res₁ x₁
      have hw_Z : res₀ r_Z0 - w_01 ∈ RingHom.ker π_Z01 := by
        rw [RingHom.mem_ker, map_sub, sub_eq_zero]
        dsimp [r_Z0, w_01]
        rw [map_mul, map_mul, map_mul, ← hComm_Z0_pt, ← hComm_Z1_pt, hx₁_Z, ← hc_Z_comm,
          hComm_Z0_pt, mul_comm]
      have hw_Y' : w_01 - res₀ r'_0 ∈ RingHom.ker π'_01 := by
        rw [RingHom.mem_ker, map_sub, sub_eq_zero]
        dsimp [w_01]
        rw [map_mul, ← hComm'_0_pt, ← hComm'_1_pt, map_pow, map_pow, hx₁_Y']
        change H' ^ k * res'_1 y'_1 = π'_01 (res₀ r'_0)
        rw [← hy_glue, ← hr'_0, hComm'_0_pt]
      have hdiff0_res : res₀ (r_Z0 - r'_0) ∈ RingHom.ker π_Z01 ⊔ RingHom.ker π'_01 := by
        have h_split : res₀ (r_Z0 - r'_0) = (res₀ r_Z0 - w_01) + (w_01 - res₀ r'_0) := by
          rw [map_sub]; ring
        rw [h_split]
        exact Submodule.mem_sup.mpr ⟨res₀ r_Z0 - w_01, hw_Z, w_01 - res₀ r'_0, hw_Y', rfl⟩
      obtain ⟨j_Z0, hj_Z0, j'_0, hj'_0, hj0_eq⟩ := Submodule.mem_sup.mp (hLift0 (r_Z0 - r'_0) hdiff0_res)
      let x₀ : R₀ := r_Z0 - j_Z0
      have hx₀_alt : x₀ = r'_0 + j'_0 := by
        dsimp [x₀]
        linear_combination -hj0_eq
      have hx₀_Z_raw : π_Z0 x₀ = π_Z0 r_Z0 := by
        dsimp [x₀]
        rw [map_sub, RingHom.mem_ker.mp hj_Z0, sub_zero]
      have hx₀_Z : π_Z0 x₀ = π_Z0 (algebraMap k₀ R₀ c) * (π_Z0 h₀) ^ k := by
        rw [hx₀_Z_raw]
        dsimp [r_Z0]
        rw [map_mul, map_pow]
      have hx₀_Y' : π'_0 x₀ = y'_0 := by
        rw [hx₀_alt, map_add, hr'_0, RingHom.mem_ker.mp hj'_0, add_zero]
      have hx₀_IZ : x₀ ∈ I_Z ^ k := by
        rw [hIZ_iff k x₀, Ideal.mem_span_singleton]
        exact ⟨π_Z0 (algebraMap k₀ R₀ c), by rw [hx₀_Z, mul_comm]⟩
      have hx₀_res : res₀ x₀ = w_01 := by
        have h_inf : res₀ x₀ - w_01 ∈ RingHom.ker π_Z01 ⊓ RingHom.ker π'_01 := by
          rw [Ideal.mem_inf]
          constructor
          · rw [RingHom.mem_ker, map_sub, ← hComm_Z0_pt, hx₀_Z_raw, hComm_Z0_pt,
              ← map_sub, RingHom.mem_ker.mp hw_Z]
          · have hw_Y'_eq : π'_01 w_01 = π'_01 (res₀ r'_0) := by
              have h := RingHom.mem_ker.mp hw_Y'
              rw [map_sub, sub_eq_zero] at h
              exact h
            rw [RingHom.mem_ker, map_sub, ← hComm'_0_pt, hx₀_Y', ← hr'_0, hComm'_0_pt,
              hw_Y'_eq, sub_self]
        rw [hKer01, Ideal.mem_bot] at h_inf
        exact sub_eq_zero.mp h_inf
      exact ⟨x₀, x₁, hx₀_IZ, hx₀_res, hx₀_Z, hx₀_Y', hx₁_Z, hx₁_Y'⟩
    
    have hUnpack : ∀ (k : ℕ) (x₀ : R₀) (x₁ : R₁),
        x₀ ∈ I_Z ^ k →
        res₀ x₀ = res₀ (h₀ ^ k) * res₁ x₁ →
        ∃ c : k₀,
          π_Z1 x₁ = π_Z1 (algebraMap k₀ R₁ c) ∧
          ev₁ x₁ = c ∧
          ev₂ x₁ = c := by
      intro k x₀ x₁ hx₀_mem hx₀_res
      obtain ⟨a₀, ha₀⟩ := Ideal.mem_span_singleton.mp ((hIZ_iff k x₀).mp hx₀_mem)
      have h_Z01 : π_Z01 (res₀ h₀) ^ k * res_Z0 a₀ = π_Z01 (res₀ h₀) ^ k * res_Z1 (π_Z1 x₁) := by
        calc
          π_Z01 (res₀ h₀) ^ k * res_Z0 a₀ = res_Z0 ((π_Z0 h₀) ^ k * a₀) := by
            rw [map_mul, map_pow, hComm_Z0_pt]
          _ = res_Z0 (π_Z0 x₀) := by rw [← ha₀]
          _ = π_Z01 (res₀ x₀) := hComm_Z0_pt x₀
          _ = π_Z01 (res₀ (h₀ ^ k) * res₁ x₁) := by rw [hx₀_res]
          _ = π_Z01 (res₀ h₀) ^ k * res_Z1 (π_Z1 x₁) := by
            rw [map_mul, map_pow, map_pow, hComm_Z1_pt]
      have h_unit_Z : π_Z01 (res₁ t₀) ^ k * π_Z01 (res₀ h₀) ^ k = 1 := by
        rw [← mul_pow, ← map_mul, mul_comm, hht, map_one, one_pow]
      have ha₀_eq : res_Z0 a₀ = res_Z1 (π_Z1 x₁) := by
        calc
          res_Z0 a₀ = (π_Z01 (res₁ t₀) ^ k * π_Z01 (res₀ h₀) ^ k) * res_Z0 a₀ := by
            rw [h_unit_Z, one_mul]
          _ = π_Z01 (res₁ t₀) ^ k * (π_Z01 (res₀ h₀) ^ k * res_Z0 a₀) := by ring
          _ = π_Z01 (res₁ t₀) ^ k * (π_Z01 (res₀ h₀) ^ k * res_Z1 (π_Z1 x₁)) := by rw [h_Z01]
          _ = (π_Z01 (res₁ t₀) ^ k * π_Z01 (res₀ h₀) ^ k) * res_Z1 (π_Z1 x₁) := by ring
          _ = res_Z1 (π_Z1 x₁) := by rw [h_unit_Z, one_mul]
      obtain ⟨c, _, hc₁⟩ := hZ_H0 a₀ (π_Z1 x₁) ha₀_eq
      have hx₁_ker : x₁ - algebraMap k₀ R₁ c ∈ RingHom.ker π_Z1 ⊔ RingHom.ker π'_1 := by
        apply Submodule.mem_sup_left
        rw [RingHom.mem_ker, map_sub, hc₁, sub_self]
      obtain ⟨hev1_sub, hev2_sub⟩ := (hSum_iff (x₁ - algebraMap k₀ R₁ c)).mp hx₁_ker
      rw [map_sub, hev₁_c, sub_eq_zero] at hev1_sub
      rw [map_sub, hev₂_c, sub_eq_zero] at hev2_sub
      exact ⟨c, hc₁, hev1_sub, hev2_sub⟩
    
    by_cases hEq : ev'_1 = ev'_2
    · refine ⟨ev'_1, ev'_2, 0, 0, 0, hev'_1, hev'_2, hGlue, hUnpack, ?_, ?_⟩
      · simp
      · intro δ hδ
        have hδ0 : δ = 0 := hδ hEq
        subst hδ0
        simp
    · have hSurj_ev1 : Function.Surjective ev'_1 := fun c => ⟨c'_1 c, hev'_1_c c⟩
      have hSurj_ev2 : Function.Surjective ev'_2 := fun c => ⟨c'_1 c, hev'_2_c c⟩
      have hKerNe : RingHom.ker ev'_1 ≠ RingHom.ker ev'_2 := by
        intro hKerEq
        apply hEq
        ext y
        let c : k₀ := ev'_1 y
        have hy_mem1 : y - c'_1 c ∈ RingHom.ker ev'_1 := by
          rw [RingHom.mem_ker, map_sub, hev'_1_c]
          exact sub_self c
        rw [hKerEq] at hy_mem1
        have hy_mem2 : ev'_2 (y - c'_1 c) = 0 := RingHom.mem_ker.mp hy_mem1
        rw [map_sub, hev'_2_c, sub_eq_zero] at hy_mem2
        exact hy_mem2.symm
      have hm₁ : (RingHom.ker ev'_1).IsMaximal := RingHom.ker_isMaximal_of_surjective ev'_1 hSurj_ev1
      have hm₂ : (RingHom.ker ev'_2).IsMaximal := RingHom.ker_isMaximal_of_surjective ev'_2 hSurj_ev2
      have hCoprime : RingHom.ker ev'_1 ⊔ RingHom.ker ev'_2 = ⊤ :=
        Ideal.IsMaximal.coprime_of_ne hm₁ hm₂ hKerNe
      have h1_mem : (1 : A'_1) ∈ RingHom.ker ev'_1 ⊔ RingHom.ker ev'_2 := by
        rw [hCoprime]; trivial
      obtain ⟨m₁, hm₁_mem, g_sep, hg_sep_mem, hm_sum⟩ := Submodule.mem_sup.mp h1_mem
      have hg_ev2 : ev'_2 g_sep = 0 := RingHom.mem_ker.mp hg_sep_mem
      have hg_ev1 : ev'_1 g_sep = 1 := by
        have h_app := congrArg ev'_1 hm_sum
        rw [map_add, map_one, RingHom.mem_ker.mp hm₁_mem, zero_add] at h_app
        exact h_app
      let _ : Algebra A'_0 A'_01 := res'_0.toAlgebra
      have _ : IsLocalization.Away h'_0 A'_01 := hLoc'_0
      obtain ⟨N_sep, g0_sep, hg_loc⟩ := IsLocalization.Away.surj h'_0 (res'_1 g_sep)
      have hg_loc' : res'_1 g_sep * H' ^ N_sep = res'_0 g0_sep := hg_loc
      refine ⟨ev'_1, ev'_2, N_sep, g0_sep, g_sep, hev'_1, hev'_2, hGlue, hUnpack, ?_, ?_⟩
      · rw [← hg_loc', mul_comm]
      · intro δ _
        constructor
        · rw [map_mul, hev'_1_c, hg_ev1, mul_one]
        · rw [map_mul, hg_ev2, mul_zero]

  obtain ⟨ev'_1, ev'_2, N_sep, g0_sep, g_sep, hev'_1, hev'_2, hGlue, hUnpack, hg_glue, hg_ev⟩ := h_s1

  
  
  
  have hu'_ev1 : ev'_1 u'_1 = 0 := by dsimp [u'_1]; rw [hev'_1, hu₁_ev₁]
  have hu'_ev2 : ev'_2 u'_1 = 0 := by dsimp [u'_1]; rw [hev'_2, hu₁_ev₂]
  obtain ⟨x0_U₁, U₁, hx0_U₁_mem, hx0_U₁_res, hx0_U₁_Z_raw, hx0_U₁_Y', hU₁_Z_raw, hU₁_Y'⟩ :=
    hGlue 2 0 u'_0 u'_1 hu'_glue hu'_ev1 hu'_ev2
  have hx0_U₁_Z : π_Z0 x0_U₁ = 0 := by
    rw [hx0_U₁_Z_raw, map_zero, map_zero, zero_mul]
  have hU₁_Z : π_Z1 U₁ = 0 := by
    rw [hU₁_Z_raw, map_zero, map_zero]

  
  let K₁ : Ideal R₀ :=
    { carrier := {x : R₀ | ∃ z : R₀, z * h₀ = eZ * x}
      zero_mem' := ⟨0, by ring⟩
      add_mem' := by
        rintro a b ⟨za, hza⟩ ⟨zb, hzb⟩
        refine ⟨za + zb, ?_⟩
        calc
          (za + zb) * h₀ = za * h₀ + zb * h₀ := by ring
          _ = eZ * a + eZ * b := by rw [hza, hzb]
          _ = eZ * (a + b) := by ring
      smul_mem' := by
        rintro r a ⟨za, hza⟩
        refine ⟨r * za, ?_⟩
        dsimp [smul_eq_mul]
        calc
          (r * za) * h₀ = r * (za * h₀) := by ring
          _ = r * (eZ * a) := by rw [hza]
          _ = eZ * (r * a) := by ring }
  let K₂ : Ideal R₀ :=
    { carrier := {x : R₀ | ∃ z : R₀, z * h₀ ^ 2 = eZ ^ 2 * x}
      zero_mem' := ⟨0, by ring⟩
      add_mem' := by
        rintro a b ⟨za, hza⟩ ⟨zb, hzb⟩
        refine ⟨za + zb, ?_⟩
        calc
          (za + zb) * h₀ ^ 2 = za * h₀ ^ 2 + zb * h₀ ^ 2 := by ring
          _ = eZ ^ 2 * a + eZ ^ 2 * b := by rw [hza, hzb]
          _ = eZ ^ 2 * (a + b) := by ring
      smul_mem' := by
        rintro r a ⟨za, hza⟩
        refine ⟨r * za, ?_⟩
        dsimp [smul_eq_mul]
        calc
          (r * za) * h₀ ^ 2 = r * (za * h₀ ^ 2) := by ring
          _ = r * (eZ ^ 2 * a) := by rw [hza]
          _ = eZ ^ 2 * (r * a) := by ring }
  have hIZ_le_K₁ : I_Z ≤ K₁ := by
    rw [Ideal.span_le]
    intro y hy
    rcases hy with rfl | hy_eq
    · exact ⟨eZ, rfl⟩
    · rw [Set.mem_singleton_iff.mp hy_eq]
      exact ⟨w₀, by rw [mul_comm, ← heZeY]⟩
  have hIZ2_le_K₂ : I_Z ^ 2 ≤ K₂ := by
    rw [sq, Ideal.mul_le]
    intro a ha b hb
    obtain ⟨za, hza⟩ := hIZ_le_K₁ ha
    obtain ⟨zb, hzb⟩ := hIZ_le_K₁ hb
    refine ⟨za * zb, ?_⟩
    calc
      (za * zb) * h₀ ^ 2 = (za * h₀) * (zb * h₀) := by ring
      _ = (eZ * a) * (eZ * b) := by rw [hza, hzb]
      _ = eZ ^ 2 * (a * b) := by ring
  obtain ⟨xZ_U₁, hxZ_U₁_rel⟩ := hIZ2_le_K₂ hx0_U₁_mem
  have hxZ_U₁_Z : π_Z0 xZ_U₁ = 0 := by
    have h_prod : π_Z0 xZ_U₁ * (π_Z0 h₀) ^ 2 = 0 := by
      calc
        π_Z0 xZ_U₁ * (π_Z0 h₀) ^ 2 = π_Z0 (xZ_U₁ * h₀ ^ 2) := by rw [map_mul, map_pow]
        _ = π_Z0 (eZ ^ 2 * x0_U₁) := by rw [hxZ_U₁_rel]
        _ = π_Z0 (eZ ^ 2) * π_Z0 x0_U₁ := by rw [map_mul]
        _ = 0 := by rw [hx0_U₁_Z, mul_zero]
    exact (mul_eq_zero.mp h_prod).resolve_right (pow_ne_zero 2 h_h₀_Z_ne)

  let K₀ : ℕ := A₀ + N_sep + 3
  let m₀ : ℕ := 2 * K₀
  let f₁_bar : R₁ := U₁ ^ K₀
  let x₀_f₁ : R₀ := x0_U₁ ^ K₀
  let xZ_f₁ : R₀ := xZ_U₁ ^ K₀
  have hK₀_pos : 1 ≤ K₀ := by omega
  have hK₀_ne : K₀ ≠ 0 := by omega
  have hm₀_ge6 : 6 ≤ m₀ := by omega
  have hx₀_f₁_mem : x₀_f₁ ∈ I_Z ^ m₀ := by
    dsimp [x₀_f₁, m₀]
    rw [pow_mul]
    exact Ideal.pow_mem_pow hx0_U₁_mem K₀
  have hx₀_f₁_res : res₀ x₀_f₁ = res₀ (h₀ ^ m₀) * res₁ f₁_bar := by
    dsimp [x₀_f₁, f₁_bar, m₀]
    rw [map_pow, hx0_U₁_res, mul_pow, ← map_pow, ← pow_mul, ← map_pow]
  have hxZ_f₁_rel : xZ_f₁ * h₀ ^ m₀ = eZ ^ m₀ * x₀_f₁ := by
    dsimp [xZ_f₁, x₀_f₁, m₀]
    calc
      xZ_U₁ ^ K₀ * h₀ ^ (2 * K₀) = xZ_U₁ ^ K₀ * (h₀ ^ 2) ^ K₀ := by rw [pow_mul]
      _ = (xZ_U₁ * h₀ ^ 2) ^ K₀ := by rw [mul_pow]
      _ = (eZ ^ 2 * x0_U₁) ^ K₀ := by rw [hxZ_U₁_rel]
      _ = (eZ ^ 2) ^ K₀ * x0_U₁ ^ K₀ := by rw [mul_pow]
      _ = eZ ^ (2 * K₀) * x0_U₁ ^ K₀ := by rw [← pow_mul]
  have hx₀_f₁_Y' : π'_0 x₀_f₁ = π'_0 (u₁_V₀ ^ K₀) := by
    dsimp [x₀_f₁]
    rw [map_pow, hx0_U₁_Y', ← map_pow]
  have hxZ_f₁_Z : π_Z0 xZ_f₁ = 0 := by
    dsimp [xZ_f₁]
    rw [map_pow, hxZ_U₁_Z, zero_pow hK₀_ne]
  have hf₁_bar_Z : π_Z1 f₁_bar = 0 := by
    dsimp [f₁_bar]
    rw [map_pow, hU₁_Z, zero_pow hK₀_ne]
  have hLinInd : ∀ (c₀ c₁ : k₀), algebraMap k₀ R₁ c₀ + c₁ • f₁_bar = 0 → c₀ = 0 ∧ c₁ = 0 := by
    intro c₀ c₁ hc
    rw [Algebra.smul_def] at hc
    have hc₀ : c₀ = 0 := by
      have h_Z1 := congrArg π_Z1 hc
      rw [map_add, map_mul, hf₁_bar_Z, mul_zero, add_zero, map_zero] at h_Z1
      exact (π_Z1.comp (algebraMap k₀ R₁)).injective (by simpa using h_Z1)
    refine ⟨hc₀, ?_⟩
    subst hc₀
    rw [map_zero, zero_add] at hc
    by_contra hc₁
    have h_res_zero : res₀ (algebraMap k₀ R₀ c₁ * x₀_f₁) = res₀ 0 := by
      rw [map_zero, map_mul, hc_res, hx₀_f₁_res]
      calc
        res₁ (algebraMap k₀ R₁ c₁) * (res₀ (h₀ ^ m₀) * res₁ f₁_bar) =
            res₀ (h₀ ^ m₀) * res₁ (algebraMap k₀ R₁ c₁ * f₁_bar) := by
          rw [map_mul]; ring
        _ = 0 := by rw [hc, map_zero, mul_zero]
    have h_mul_zero : algebraMap k₀ R₀ c₁ * x₀_f₁ = 0 := hInj₀ h_res_zero
    have hx₀_zero : x₀_f₁ = 0 := by
      calc
        x₀_f₁ = 1 * x₀_f₁ := (one_mul x₀_f₁).symm
        _ = algebraMap k₀ R₀ (c₁⁻¹ * c₁) * x₀_f₁ := by rw [inv_mul_cancel₀ hc₁, map_one]
        _ = algebraMap k₀ R₀ c₁⁻¹ * (algebraMap k₀ R₀ c₁ * x₀_f₁) := by rw [map_mul, mul_assoc]
        _ = 0 := by rw [h_mul_zero, mul_zero]
    have h_pow_zero : π'_0 (u₁_V₀ ^ K₀) = 0 := by
      rw [← hx₀_f₁_Y', hx₀_zero, map_zero]
    exact hu₁_pow_ne K₀ hK₀_pos h_pow_zero

  
  
  
  have hY'_cech : ∀ d : ℕ, A₀ ≤ d → ∀ z' : A'_01,
      ∃ (y'_0 : A'_0) (y'_1 : A'_1), T' ^ d * res'_0 y'_0 - res'_1 y'_1 = z' := by
    intro d hd z'
    obtain ⟨z_t, rfl⟩ := hSurj'_01 z'
    obtain ⟨x₀_t, x₁_t, hx_t⟩ := hA₀_surj z_t
    refine ⟨π'_0 (h₀ ^ (d - A₀) * x₀_t), π'_1 x₁_t, ?_⟩
    have hd_split : d = A₀ + (d - A₀) := (Nat.add_sub_of_le hd).symm
    have hT_pow : T' ^ d = T' ^ A₀ * T' ^ (d - A₀) := by
      conv_lhs => rw [hd_split]
      rw [pow_add]
    have h_term1 : T' ^ d * res'_0 (π'_0 (h₀ ^ (d - A₀) * x₀_t)) =
        π'_01 (res₁ (t₀ ^ A₀) * res₀ x₀_t) := by
      calc
        T' ^ d * res'_0 (π'_0 (h₀ ^ (d - A₀) * x₀_t)) =
            (T' ^ A₀ * T' ^ (d - A₀)) * (H' ^ (d - A₀) * res'_0 (π'_0 x₀_t)) := by
          rw [hT_pow, map_mul, map_mul, map_pow, map_pow]
        _ = T' ^ A₀ * (T' ^ (d - A₀) * H' ^ (d - A₀)) * res'_0 (π'_0 x₀_t) := by ring
        _ = T' ^ A₀ * res'_0 (π'_0 x₀_t) := by rw [hTH'_pow, mul_one]
        _ = π'_01 (res₁ (t₀ ^ A₀) * res₀ x₀_t) := by
          dsimp [T', t'_0]
          rw [hComm'_1_pt, hComm'_0_pt, ← map_pow, ← map_pow, ← map_mul]
    rw [h_term1, hComm'_1_pt, ← map_sub, hx_t]

  have hGlobal_cech : ∀ k : ℕ, A₀ ≤ k → N_sep ≤ k → ∀ z : R₀₁,
      ∃ x₀ ∈ I_Z ^ k, ∃ x₁ : R₁, res₁ (t₀ ^ k) * res₀ x₀ - res₁ x₁ = z := by
    intro k hkA hkN z
    obtain ⟨a₀, a₁, ha_Z⟩ := hZ_H1 (π_Z01 z)
    obtain ⟨y'_0_init, y'_1_init, hy'_init⟩ := hY'_cech k hkA (π'_01 z)
    obtain ⟨r_Z_init, hr_Z_init⟩ := hSurj_Z1 a₁
    let c₂ : k₀ := ev'_2 y'_1_init - ev₂ r_Z_init
    let r_Z1 : R₁ := r_Z_init + algebraMap k₀ R₁ c₂
    let a₀_new : A_Z0 := a₀ + π_Z0 (algebraMap k₀ R₀ c₂)
    let a₁_new : A_Z1 := π_Z1 r_Z1
    have ha_Z_new : res_Z0 a₀_new - res_Z1 a₁_new = π_Z01 z := by
      dsimp [a₀_new, a₁_new, r_Z1]
      rw [map_add, map_add, map_add, hr_Z_init, hc_Z_comm]
      linear_combination ha_Z
    have hev2_match : ev₂ r_Z1 = ev'_2 y'_1_init := by
      dsimp [r_Z1, c₂]
      rw [map_add, hev₂_c]
      ring
    let δ₁ : k₀ := ev₁ r_Z1 - ev'_1 y'_1_init
    have hδ₁_eq : ev'_1 = ev'_2 → δ₁ = 0 := by
      intro hEq
      dsimp [δ₁]
      rw [← hev'_1, hEq, hev'_2, hev2_match, sub_self]
    obtain ⟨hsep1, hsep2⟩ := hg_ev δ₁ hδ₁_eq
    let y'_0 : A'_0 := y'_0_init + c'_0 δ₁ * h'_0 ^ (k - N_sep) * g0_sep
    let y'_1 : A'_1 := y'_1_init + c'_1 δ₁ * g_sep
    have hk_split : (k - N_sep) + N_sep = k := Nat.sub_add_cancel hkN
    have hy'_cech : T' ^ k * res'_0 y'_0 - res'_1 y'_1 = π'_01 z := by
      have h_shift : T' ^ k * res'_0 (c'_0 δ₁ * h'_0 ^ (k - N_sep) * g0_sep) =
          res'_1 (c'_1 δ₁ * g_sep) := by
        calc
          T' ^ k * res'_0 (c'_0 δ₁ * h'_0 ^ (k - N_sep) * g0_sep) =
              T' ^ k * (res'_1 (c'_1 δ₁) * H' ^ (k - N_sep) * (H' ^ N_sep * res'_1 g_sep)) := by
            rw [map_mul, map_mul, hc'_comm, map_pow, hg_glue]
          _ = res'_1 (c'_1 δ₁) * (T' ^ k * (H' ^ (k - N_sep) * H' ^ N_sep)) * res'_1 g_sep := by ring
          _ = res'_1 (c'_1 δ₁) * (T' ^ k * H' ^ k) * res'_1 g_sep := by rw [← pow_add, hk_split]
          _ = res'_1 (c'_1 δ₁ * g_sep) := by rw [hTH'_pow, mul_one, map_mul]
      dsimp [y'_0, y'_1]
      rw [map_add, mul_add, h_shift, map_add]
      linear_combination hy'_init
    have hy'_ev1 : ev'_1 y'_1 = ev₁ r_Z1 := by
      dsimp [y'_1]
      rw [map_add, hsep1]
      dsimp [δ₁]; ring
    have hy'_ev2 : ev'_2 y'_1 = ev₂ r_Z1 := by
      dsimp [y'_1]
      rw [map_add, hsep2, add_zero, hev2_match]
    obtain ⟨r'_1, hr'_1⟩ := hSurj'_1 y'_1
    have hdiff1_mem : r_Z1 - r'_1 ∈ RingHom.ker π_Z1 ⊔ RingHom.ker π'_1 := by
      rw [hSum_iff]
      constructor
      · rw [map_sub, ← hy'_ev1, ← hr'_1, hev'_1, sub_self]
      · rw [map_sub, ← hy'_ev2, ← hr'_1, hev'_2, sub_self]
    obtain ⟨j_Z1, hj_Z1, j'_1, hj'_1, hj1_eq⟩ := Submodule.mem_sup.mp hdiff1_mem
    let x₁ : R₁ := r_Z1 - j_Z1
    have hx₁_alt : x₁ = r'_1 + j'_1 := by dsimp [x₁]; linear_combination -hj1_eq
    have hx₁_Z : π_Z1 x₁ = a₁_new := by
      dsimp [x₁, a₁_new]
      rw [map_sub, RingHom.mem_ker.mp hj_Z1, sub_zero]
    have hx₁_Y' : π'_1 x₁ = y'_1 := by
      rw [hx₁_alt, map_add, hr'_1, RingHom.mem_ker.mp hj'_1, add_zero]
    obtain ⟨r_a0, hr_a0⟩ := hSurj_Z0 a₀_new
    obtain ⟨r'_0, hr'_0⟩ := hSurj'_0 y'_0
    let r_Z0 : R₀ := h₀ ^ k * r_a0
    let w_01 : R₀₁ := res₀ (h₀ ^ k) * (z + res₁ x₁)
    have hw_Z : res₀ r_Z0 - w_01 ∈ RingHom.ker π_Z01 := by
      rw [RingHom.mem_ker, map_sub, sub_eq_zero]
      dsimp [r_Z0, w_01]
      have ha₀_eq : res_Z0 a₀_new = π_Z01 z + res_Z1 a₁_new :=
        sub_eq_iff_eq_add.mp ha_Z_new
      calc
        π_Z01 (res₀ (h₀ ^ k * r_a0)) = π_Z01 (res₀ (h₀ ^ k)) * res_Z0 (π_Z0 r_a0) := by
          rw [map_mul, map_mul, hComm_Z0_pt]
        _ = π_Z01 (res₀ (h₀ ^ k)) * (π_Z01 z + res_Z1 (π_Z1 x₁)) := by
          rw [hr_a0, ha₀_eq, hx₁_Z]
        _ = π_Z01 (res₀ (h₀ ^ k) * (z + res₁ x₁)) := by
          rw [hComm_Z1_pt, map_mul, map_add]
    have hw_Y' : w_01 - res₀ r'_0 ∈ RingHom.ker π'_01 := by
      rw [RingHom.mem_ker, map_sub, sub_eq_zero]
      dsimp [w_01]
      have hz_eq : π'_01 z + res'_1 y'_1 = T' ^ k * res'_0 y'_0 := by
        linear_combination -hy'_cech
      calc
        π'_01 (res₀ (h₀ ^ k) * (z + res₁ x₁)) =
            H' ^ k * (π'_01 z + res'_1 y'_1) := by
          rw [map_mul, map_add, ← hComm'_0_pt, map_pow, map_pow, ← hComm'_1_pt, hx₁_Y']
        _ = H' ^ k * (T' ^ k * res'_0 y'_0) := by rw [hz_eq]
        _ = (H' ^ k * T' ^ k) * res'_0 y'_0 := by ring
        _ = res'_0 y'_0 := by rw [hHT'_pow, one_mul]
        _ = π'_01 (res₀ r'_0) := by rw [← hr'_0, hComm'_0_pt]
    have hdiff0_res : res₀ (r_Z0 - r'_0) ∈ RingHom.ker π_Z01 ⊔ RingHom.ker π'_01 := by
      have h_split : res₀ (r_Z0 - r'_0) = (res₀ r_Z0 - w_01) + (w_01 - res₀ r'_0) := by
        rw [map_sub]; ring
      rw [h_split]
      exact Submodule.mem_sup.mpr ⟨res₀ r_Z0 - w_01, hw_Z, w_01 - res₀ r'_0, hw_Y', rfl⟩
    obtain ⟨j_Z0, hj_Z0, j'_0, hj'_0, hj0_eq⟩ := Submodule.mem_sup.mp (hLift0 (r_Z0 - r'_0) hdiff0_res)
    let x₀ : R₀ := r_Z0 - j_Z0
    have hx₀_alt : x₀ = r'_0 + j'_0 := by dsimp [x₀]; linear_combination -hj0_eq
    have hx₀_Z_raw : π_Z0 x₀ = π_Z0 r_Z0 := by
      dsimp [x₀]; rw [map_sub, RingHom.mem_ker.mp hj_Z0, sub_zero]
    have hx₀_Y' : π'_0 x₀ = y'_0 := by
      rw [hx₀_alt, map_add, hr'_0, RingHom.mem_ker.mp hj'_0, add_zero]
    have hx₀_IZ : x₀ ∈ I_Z ^ k := by
      rw [hIZ_iff k x₀, Ideal.mem_span_singleton]
      refine ⟨a₀_new, ?_⟩
      rw [hx₀_Z_raw]
      dsimp [r_Z0]
      rw [map_mul, map_pow, hr_a0]
    have hx₀_res : res₀ x₀ = w_01 := by
      have h_inf : res₀ x₀ - w_01 ∈ RingHom.ker π_Z01 ⊓ RingHom.ker π'_01 := by
        rw [Ideal.mem_inf]
        constructor
        · rw [RingHom.mem_ker, map_sub, ← hComm_Z0_pt, hx₀_Z_raw, hComm_Z0_pt,
            ← map_sub, RingHom.mem_ker.mp hw_Z]
        · have hw_Y'_eq : π'_01 w_01 = π'_01 (res₀ r'_0) := by
            have h := RingHom.mem_ker.mp hw_Y'
            rw [map_sub, sub_eq_zero] at h
            exact h
          rw [RingHom.mem_ker, map_sub, ← hComm'_0_pt, hx₀_Y', ← hr'_0, hComm'_0_pt,
            hw_Y'_eq, sub_self]
      rw [hKer01, Ideal.mem_bot] at h_inf
      exact sub_eq_zero.mp h_inf
    refine ⟨x₀, hx₀_IZ, x₁, ?_⟩
    calc
      res₁ (t₀ ^ k) * res₀ x₀ - res₁ x₁ =
          (res₁ (t₀ ^ k) * res₀ (h₀ ^ k)) * (z + res₁ x₁) - res₁ x₁ := by
        rw [hx₀_res]; dsimp [w_01]; ring
      _ = z := by rw [ht_res_pow, one_mul]; ring

  have hH1_surj : ∀ r : ℕ, 1 ≤ r → ∀ z : R₀₁,
      ∃ x₀ ∈ I_Z ^ (r * m₀), ∃ x₁ : R₁,
        res₁ (t₀ ^ (r * m₀)) * res₀ x₀ - res₁ x₁ = z := by
    intro r hr z
    have hm_le : m₀ ≤ r * m₀ := Nat.le_mul_of_pos_left m₀ hr
    exact hGlobal_cech (r * m₀) (by omega) (by omega) z

  
  
  
  have hKoszul_Y' : ∀ j : ℕ, A₀ + 4 ≤ 2 * j → N_sep + 4 ≤ 2 * j →
      ∀ (y₀ : A'_0) (y₁ : A'_1),
        res'_0 y₀ = H' ^ (2 * j) * res'_1 y₁ →
        ev'_1 y₁ = 0 →
        ev'_2 y₁ = 0 →
        ∃ (a₀ b₀ : A'_0) (a₁ b₁ : A'_1) (c_b : k₀),
          res'_0 a₀ = H' ^ (2 * j - 2) * res'_1 a₁ ∧
          ev'_1 a₁ = 0 ∧
          ev'_2 a₁ = 0 ∧
          res'_0 b₀ = H' ^ (2 * j - 2) * res'_1 b₁ ∧
          ev'_1 b₁ = c_b ∧
          ev'_2 b₁ = c_b ∧
          a₁ + u'_1 * b₁ = y₁ := by
    intro j hjA hjN y₀ y₁ hy_glue hy_ev1 hy_ev2
    let a0_init : A'_0 := α₀ * y₀
    let b0_init : A'_0 := β₀ * y₀
    have h_bez_y₀ : a0_init * h'_0 ^ 2 + b0_init * u'_0 = y₀ := by
      dsimp [a0_init, b0_init]
      calc
        (α₀ * y₀) * h'_0 ^ 2 + (β₀ * y₀) * u'_0 =
            (α₀ * h'_0 ^ 2 + β₀ * u'_0) * y₀ := by ring
        _ = 1 * y₀ := by rw [hBezout]
        _ = y₀ := one_mul y₀
    obtain ⟨c₀, c₁, hc_cech⟩ :=
      hY'_cech (2 * j - 4) (by omega) (T' ^ (2 * j - 2) * res'_0 b0_init)
    let a0_t : A'_0 := a0_init + u'_0 * c₀
    let a1_t : A'_1 := y₁ + u'_1 * c₁
    let b0_t : A'_0 := b0_init - h'_0 ^ 2 * c₀
    let b1_t : A'_1 := -c₁
    have hj_split1 : 2 * j - 2 = 2 + (2 * j - 4) := by omega
    have hj_split2 : 2 * j = (2 * j - 2) + 2 := by omega
    have hb_t_glue : res'_0 b0_t = H' ^ (2 * j - 2) * res'_1 b1_t := by
      have h_mul_H : H' ^ 2 * res'_0 c₀ - H' ^ (2 * j - 2) * res'_1 c₁ = res'_0 b0_init := by
        have h_lhs : H' ^ (2 * j - 2) * (T' ^ (2 * j - 4) * res'_0 c₀ - res'_1 c₁) =
            H' ^ 2 * res'_0 c₀ - H' ^ (2 * j - 2) * res'_1 c₁ := by
          have h1 : H' ^ (2 * j - 2) * T' ^ (2 * j - 4) = H' ^ 2 := by
            conv_lhs => rw [hj_split1, pow_add]
            rw [mul_assoc, hHT'_pow, mul_one]
          calc
            H' ^ (2 * j - 2) * (T' ^ (2 * j - 4) * res'_0 c₀ - res'_1 c₁) =
                (H' ^ (2 * j - 2) * T' ^ (2 * j - 4)) * res'_0 c₀ -
                  H' ^ (2 * j - 2) * res'_1 c₁ := by ring
            _ = H' ^ 2 * res'_0 c₀ - H' ^ (2 * j - 2) * res'_1 c₁ := by rw [h1]
        have h_rhs : H' ^ (2 * j - 2) * (T' ^ (2 * j - 2) * res'_0 b0_init) = res'_0 b0_init := by
          rw [← mul_assoc, hHT'_pow, one_mul]
        rw [← h_lhs, hc_cech, h_rhs]
      change res'_0 (b0_init - h'_0 ^ 2 * c₀) = H' ^ (2 * j - 2) * res'_1 (-c₁)
      rw [map_sub, map_mul res'_0 (h'_0 ^ 2) c₀, map_pow, map_neg]
      change res'_0 b0_init - H' ^ 2 * res'_0 c₀ = H' ^ (2 * j - 2) * (-res'_1 c₁)
      linear_combination -h_mul_H
    have ha_t_glue : res'_0 a0_t = H' ^ (2 * j - 2) * res'_1 a1_t := by
      have h_sum_t : a0_t * h'_0 ^ 2 + b0_t * u'_0 = y₀ := by
        dsimp [a0_t, b0_t]
        linear_combination h_bez_y₀
      have h_res_sum : res'_0 a0_t * H' ^ 2 = (H' ^ (2 * j - 2) * res'_1 a1_t) * H' ^ 2 := by
        have h_app := congrArg res'_0 h_sum_t
        rw [map_add, map_mul res'_0 a0_t (h'_0 ^ 2), map_pow, map_mul res'_0 b0_t u'_0,
          hb_t_glue, hu'_glue, hy_glue] at h_app
        have hy_pow : H' ^ (2 * j) = H' ^ (2 * j - 2) * H' ^ 2 := by
          conv_lhs => rw [hj_split2, pow_add]
        rw [hy_pow] at h_app
        change res'_0 a0_t * H' ^ 2 + (H' ^ (2 * j - 2) * res'_1 (-c₁)) * (H' ^ 2 * res'_1 u'_1) =
            (H' ^ (2 * j - 2) * H' ^ 2) * res'_1 y₁ at h_app
        change res'_0 a0_t * H' ^ 2 = (H' ^ (2 * j - 2) * res'_1 (y₁ + u'_1 * c₁)) * H' ^ 2
        rw [map_neg] at h_app
        rw [map_add res'_1 y₁ (u'_1 * c₁), map_mul res'_1 u'_1 c₁]
        linear_combination h_app
      calc
        res'_0 a0_t = (res'_0 a0_t * H' ^ 2) * T' ^ 2 := by
          rw [mul_assoc, hHT'_pow, mul_one]
        _ = ((H' ^ (2 * j - 2) * res'_1 a1_t) * H' ^ 2) * T' ^ 2 := by rw [h_res_sum]
        _ = H' ^ (2 * j - 2) * res'_1 a1_t := by
          rw [mul_assoc, hHT'_pow, mul_one]
    have ha1_t_ev1 : ev'_1 a1_t = 0 := by
      dsimp [a1_t]; rw [map_add, map_mul, hy_ev1, hu'_ev1, zero_mul, add_zero]
    have ha1_t_ev2 : ev'_2 a1_t = 0 := by
      dsimp [a1_t]; rw [map_add, map_mul, hy_ev2, hu'_ev2, zero_mul, add_zero]
    
    let lam : k₀ := ev'_1 b1_t - ev'_2 b1_t
    let c_b : k₀ := ev'_2 b1_t
    have hlam_eq : ev'_1 = ev'_2 → lam = 0 := by
      intro hEq; dsimp [lam]; rw [hEq, sub_self]
    obtain ⟨hsep_lam1, hsep_lam2⟩ := hg_ev lam hlam_eq
    let sg_0 : A'_0 := c'_0 lam * h'_0 ^ (2 * j - 4 - N_sep) * g0_sep
    let sg_1 : A'_1 := c'_1 lam * g_sep
    let a₀ : A'_0 := a0_t + u'_0 * sg_0
    let a₁ : A'_1 := a1_t + u'_1 * sg_1
    let b₀ : A'_0 := b0_t - h'_0 ^ 2 * sg_0
    let b₁ : A'_1 := b1_t - sg_1
    have hj_sep_split : 2 + (2 * j - 4 - N_sep) + N_sep = 2 * j - 2 := by omega
    have hsg_glue : res'_0 (h'_0 ^ 2 * sg_0) = H' ^ (2 * j - 2) * res'_1 sg_1 := by
      dsimp [sg_0, sg_1]
      calc
        res'_0 (h'_0 ^ 2 * (c'_0 lam * h'_0 ^ (2 * j - 4 - N_sep) * g0_sep)) =
            H' ^ 2 * (res'_1 (c'_1 lam) * H' ^ (2 * j - 4 - N_sep) * (H' ^ N_sep * res'_1 g_sep)) := by
          rw [map_mul, map_pow, map_mul, map_mul, hc'_comm, map_pow, hg_glue]
        _ = (H' ^ 2 * H' ^ (2 * j - 4 - N_sep) * H' ^ N_sep) * (res'_1 (c'_1 lam) * res'_1 g_sep) := by
          ring
        _ = H' ^ (2 * j - 2) * res'_1 (c'_1 lam * g_sep) := by
          rw [← pow_add, ← pow_add, hj_sep_split, map_mul]
    have husg_glue : res'_0 (u'_0 * sg_0) = H' ^ (2 * j - 2) * res'_1 (u'_1 * sg_1) := by
      calc
        res'_0 (u'_0 * sg_0) = (H' ^ 2 * res'_1 u'_1) * res'_0 sg_0 := by
          rw [map_mul, hu'_glue]
        _ = res'_1 u'_1 * res'_0 (h'_0 ^ 2 * sg_0) := by
          rw [map_mul res'_0 (h'_0 ^ 2) sg_0, map_pow]
          change (H' ^ 2 * res'_1 u'_1) * res'_0 sg_0 = res'_1 u'_1 * (H' ^ 2 * res'_0 sg_0)
          ring
        _ = res'_1 u'_1 * (H' ^ (2 * j - 2) * res'_1 sg_1) := by rw [hsg_glue]
        _ = H' ^ (2 * j - 2) * res'_1 (u'_1 * sg_1) := by
          rw [map_mul res'_1 u'_1 sg_1]; ring
    refine ⟨a₀, b₀, a₁, b₁, c_b, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · change res'_0 (a0_t + u'_0 * sg_0) = H' ^ (2 * j - 2) * res'_1 (a1_t + u'_1 * sg_1)
      rw [map_add res'_0 a0_t (u'_0 * sg_0), ha_t_glue, husg_glue,
        map_add res'_1 a1_t (u'_1 * sg_1), mul_add]
    · change ev'_1 (a1_t + u'_1 * sg_1) = 0
      rw [map_add, map_mul, ha1_t_ev1, hu'_ev1, zero_mul, add_zero]
    · change ev'_2 (a1_t + u'_1 * sg_1) = 0
      rw [map_add, map_mul, ha1_t_ev2, hu'_ev2, zero_mul, add_zero]
    · change res'_0 (b0_t - h'_0 ^ 2 * sg_0) = H' ^ (2 * j - 2) * res'_1 (b1_t - sg_1)
      rw [map_sub, hb_t_glue, hsg_glue, map_sub, mul_sub]
    · dsimp [b₁, sg_1, lam, c_b]
      rw [map_sub, hsep_lam1]; ring
    · dsimp [b₁, sg_1, c_b]
      rw [map_sub, hsep_lam2, sub_zero]
    · dsimp [a₁, b₁, a1_t, b1_t]
      ring

  
  
  
  let M : ℕ → Submodule k₀ R₁ := fun k =>
    Submodule.span k₀ {u : R₁ | ∃ x₀ ∈ I_Z ^ k, res₀ x₀ = res₀ (h₀ ^ k) * res₁ u}
  let M_sub : ℕ → Submodule k₀ R₁ := fun k =>
    { carrier := {u : R₁ | ∃ x₀ ∈ I_Z ^ k, res₀ x₀ = res₀ (h₀ ^ k) * res₁ u}
      zero_mem' := ⟨0, zero_mem _, by simp⟩
      add_mem' := by
        rintro u v ⟨xu, hxu_mem, hxu_eq⟩ ⟨xv, hxv_mem, hxv_eq⟩
        refine ⟨xu + xv, add_mem hxu_mem hxv_mem, ?_⟩
        rw [map_add, hxu_eq, hxv_eq, map_add, mul_add]
      smul_mem' := by
        rintro c u ⟨xu, hxu_mem, hxu_eq⟩
        refine ⟨c • xu, ?_, ?_⟩
        · rw [Algebra.smul_def]
          exact Ideal.mul_mem_left (I_Z ^ k) _ hxu_mem
        · rw [map_smul, hxu_eq, map_smul, mul_smul_comm] }
  have hM_eq : ∀ k : ℕ, M k = M_sub k := fun k => Submodule.span_eq (M_sub k)
  have hM_mem_iff : ∀ (k : ℕ) (u : R₁),
      u ∈ M k ↔ ∃ x₀ ∈ I_Z ^ k, res₀ x₀ = res₀ (h₀ ^ k) * res₁ u := by
    intro k u
    rw [hM_eq k]
    rfl
  have h1_mem_M : ∀ k : ℕ, (1 : R₁) ∈ M k := by
    intro k
    rw [hM_mem_iff]
    refine ⟨h₀ ^ k, Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_insert h₀ {eY})) k, ?_⟩
    rw [map_one, mul_one]
  have hU₁_mem_M2 : U₁ ∈ M 2 := (hM_mem_iff 2 U₁).mpr ⟨x0_U₁, hx0_U₁_mem, hx0_U₁_res⟩

  
  have hStep : ∀ j : ℕ, (A₀ + N_sep) + 4 ≤ 2 * j → M (2 * j) ≤ M 2 * M (2 * j - 2) := by
    intro j hj s₁ hs₁
    obtain ⟨s₀, hs₀_mem, hs₀_res⟩ := (hM_mem_iff (2 * j) s₁).mp hs₁
    obtain ⟨c, hs₁_Z, hs₁_ev1, hs₁_ev2⟩ := hUnpack (2 * j) s₀ s₁ hs₀_mem hs₀_res
    let s1_t : R₁ := s₁ - algebraMap k₀ R₁ c
    let s0_t : R₀ := s₀ - algebraMap k₀ R₀ c * h₀ ^ (2 * j)
    have hs1_t_Z : π_Z1 s1_t = 0 := by
      dsimp [s1_t]; rw [map_sub, hs₁_Z, sub_self]
    have hs1_t_ev1 : ev₁ s1_t = 0 := by
      dsimp [s1_t]
      rw [map_sub, hs₁_ev1, hev₁_c, sub_self]
    have hs1_t_ev2 : ev₂ s1_t = 0 := by
      dsimp [s1_t]
      rw [map_sub, hs₁_ev2, hev₂_c, sub_self]
    have hs0_t_res : res₀ s0_t = res₀ (h₀ ^ (2 * j)) * res₁ s1_t := by
      dsimp [s0_t, s1_t]
      rw [map_sub, map_mul, hs₀_res, hc_res, map_sub]
      ring
    have hy_glue : res'_0 (π'_0 s0_t) = H' ^ (2 * j) * res'_1 (π'_1 s1_t) := by
      dsimp [H', h'_0]
      rw [hComm'_0_pt, hs0_t_res, map_mul, ← hComm'_0_pt, map_pow, map_pow, ← hComm'_1_pt]
    have hy_ev1 : ev'_1 (π'_1 s1_t) = 0 := by rw [hev'_1, hs1_t_ev1]
    have hy_ev2 : ev'_2 (π'_1 s1_t) = 0 := by rw [hev'_2, hs1_t_ev2]
    obtain ⟨a₀, b₀, a₁, b₁, c_b, ha_glue, ha_ev1, ha_ev2, hb_glue, hb_ev1, hb_ev2, hab_sum⟩ :=
      hKoszul_Y' j (by omega) (by omega) (π'_0 s0_t) (π'_1 s1_t) hy_glue hy_ev1 hy_ev2
    obtain ⟨A₀_wit, A₁, hA₀_mem, hA₀_res, _, _, hA₁_Z_raw, hA₁_Y'⟩ :=
      hGlue (2 * j - 2) 0 a₀ a₁ ha_glue ha_ev1 ha_ev2
    obtain ⟨B₀_wit, B₁, hB₀_mem, hB₀_res, _, _, _, hB₁_Y'⟩ :=
      hGlue (2 * j - 2) c_b b₀ b₁ hb_glue hb_ev1 hb_ev2
    have hA₁_Z : π_Z1 A₁ = 0 := by rw [hA₁_Z_raw, map_zero, map_zero]
    have hAB_eq : A₁ + U₁ * B₁ = s1_t := by
      have h_inf : (A₁ + U₁ * B₁) - s1_t ∈ RingHom.ker π_Z1 ⊓ RingHom.ker π'_1 := by
        rw [Ideal.mem_inf]
        constructor
        · rw [RingHom.mem_ker, map_sub, map_add, map_mul, hA₁_Z, hU₁_Z, hs1_t_Z]
          ring
        · rw [RingHom.mem_ker, map_sub, map_add, map_mul, hA₁_Y', hU₁_Y', hB₁_Y',
            sub_eq_zero]
          exact hab_sum
      rw [hKer1, Ideal.mem_bot] at h_inf
      exact sub_eq_zero.mp h_inf
    have hs₁_decomp : s₁ = (c • (1 : R₁)) * 1 + 1 * A₁ + U₁ * B₁ := by
      rw [Algebra.smul_def, mul_one, mul_one, one_mul]
      dsimp [s1_t] at hAB_eq
      linear_combination -hAB_eq
    have hA₁_mem : A₁ ∈ M (2 * j - 2) := (hM_mem_iff (2 * j - 2) A₁).mpr ⟨A₀_wit, hA₀_mem, hA₀_res⟩
    have hB₁_mem : B₁ ∈ M (2 * j - 2) := (hM_mem_iff (2 * j - 2) B₁).mpr ⟨B₀_wit, hB₀_mem, hB₀_res⟩
    rw [hs₁_decomp]
    refine add_mem (add_mem ?_ ?_) ?_
    · exact Submodule.mul_mem_mul ((M 2).smul_mem c (h1_mem_M 2)) (h1_mem_M (2 * j - 2))
    · exact Submodule.mul_mem_mul (h1_mem_M 2) hA₁_mem
    · exact Submodule.mul_mem_mul hU₁_mem_M2 hB₁_mem

  
  have hM_mul : ∀ a b : ℕ, M a * M b ≤ M (a + b) := by
    intro a b
    rw [Submodule.mul_le]
    intro u hu v hv
    obtain ⟨xu, hxu_mem, hxu_eq⟩ := (hM_mem_iff a u).mp hu
    obtain ⟨xv, hxv_mem, hxv_eq⟩ := (hM_mem_iff b v).mp hv
    rw [hM_mem_iff (a + b) (u * v)]
    refine ⟨xu * xv, ?_, ?_⟩
    · rw [pow_add]
      exact Ideal.mul_mem_mul hxu_mem hxv_mem
    · rw [map_mul, hxu_eq, hxv_eq, pow_add, map_mul, map_mul]
      ring
  have hSub_mono : ∀ (P Q P' Q' : Submodule k₀ R₁), P ≤ P' → Q ≤ Q' → P * Q ≤ P' * Q' :=
    fun _ _ _ _ hP hQ => Submodule.mul_le.mpr (fun _ hp _ hq => Submodule.mul_mem_mul (hP hp) (hQ hq))
  have hM2_pow : ∀ d : ℕ, (M 2) ^ (d + 1) ≤ M (2 * (d + 1)) := by
    intro d
    induction d with
    | zero =>
      rw [Submodule.pow_one]
    | succ d ih =>
      rw [Submodule.pow_succ]
      calc
        (M 2) ^ (d + 1) * M 2 ≤ M (2 * (d + 1)) * M 2 := hSub_mono _ _ _ _ ih le_rfl
        _ ≤ M (2 * (d + 1) + 2) := hM_mul (2 * (d + 1)) 2
  have hM2_K₀ : (M 2) ^ K₀ ≤ M m₀ := by
    have hK₀_eq : K₀ = (K₀ - 1) + 1 := (Nat.sub_add_cancel hK₀_pos).symm
    dsimp [m₀]
    rw [hK₀_eq]
    exact hM2_pow (K₀ - 1)

  have hLadder : ∀ b₀ : ℕ, (A₀ + N_sep) + 2 ≤ 2 * b₀ →
      ∀ d : ℕ, M (2 * b₀ + 2 * (d + 1)) ≤ (M 2) ^ (d + 1) * M (2 * b₀) := by
    intro b₀ hb₀ d
    induction d with
    | zero =>
      have h_idx1 : 2 * b₀ + 2 * 1 = 2 * (b₀ + 1) := by omega
      have h_idx2 : 2 * (b₀ + 1) - 2 = 2 * b₀ := by omega
      rw [h_idx1, Submodule.pow_one]
      simpa [h_idx2] using hStep (b₀ + 1) (by omega)
    | succ d ih =>
      have h_idx1 : 2 * b₀ + 2 * (d + 2) = 2 * (b₀ + d + 2) := by omega
      have h_idx2 : 2 * (b₀ + d + 2) - 2 = 2 * b₀ + 2 * (d + 1) := by omega
      have h_step := hStep (b₀ + d + 2) (by omega)
      rw [h_idx2, ← h_idx1] at h_step
      calc
        M (2 * b₀ + 2 * (d + 2)) ≤ M 2 * M (2 * b₀ + 2 * (d + 1)) := h_step
        _ ≤ M 2 * ((M 2) ^ (d + 1) * M (2 * b₀)) := hSub_mono _ _ _ _ le_rfl ih
        _ = (M 2 * (M 2) ^ (d + 1)) * M (2 * b₀) := by rw [mul_assoc]
        _ = (M 2) ^ (d + 2) * M (2 * b₀) := by
          rw [← Submodule.pow_succ' (M 2) (Nat.succ_ne_zero d)]

  have hMain_ind : ∀ n : ℕ, M ((n + 1) * m₀) ≤ (M m₀) ^ (n + 1) := by
    intro n
    induction n with
    | zero =>
      simp only [zero_add, one_mul, Submodule.pow_one, le_rfl]
    | succ n ih =>
      let b₀ : ℕ := (n + 1) * K₀
      have hb₀_ge : K₀ ≤ b₀ := Nat.le_mul_of_pos_left K₀ (Nat.succ_pos n)
      have hb₀_bound : (A₀ + N_sep) + 2 ≤ 2 * b₀ := by omega
      have hK₀_eq : (K₀ - 1) + 1 = K₀ := Nat.sub_add_cancel hK₀_pos
      have h_lhs_eq : (n + 2) * m₀ = 2 * b₀ + 2 * ((K₀ - 1) + 1) := by
        rw [hK₀_eq]
        dsimp [b₀, m₀]
        ring
      have h_mid_eq : 2 * b₀ = (n + 1) * m₀ := by
        dsimp [b₀, m₀]
        ring
      calc
        M ((n + 2) * m₀) = M (2 * b₀ + 2 * ((K₀ - 1) + 1)) := by rw [h_lhs_eq]
        _ ≤ (M 2) ^ ((K₀ - 1) + 1) * M (2 * b₀) := hLadder b₀ hb₀_bound (K₀ - 1)
        _ = (M 2) ^ K₀ * M ((n + 1) * m₀) := by rw [hK₀_eq, h_mid_eq]
        _ ≤ M m₀ * (M m₀) ^ (n + 1) := hSub_mono _ _ _ _ hM2_K₀ ih
        _ = (M m₀) ^ (n + 2) := (Submodule.pow_succ' (M m₀) (Nat.succ_ne_zero n)).symm

  have hVeronese : ∀ r : ℕ, 1 ≤ r →
      ∀ x₁ : R₁,
        (∃ x₀ ∈ I_Z ^ (r * m₀), res₀ x₀ = res₀ (h₀ ^ (r * m₀)) * res₁ x₁) →
        x₁ ∈ (M m₀) ^ r := by
    intro r hr x₁ hx₁
    have hx₁_mem : x₁ ∈ M (r * m₀) := Submodule.subset_span hx₁
    have hr_eq : r = (r - 1) + 1 := (Nat.sub_add_cancel hr).symm
    rw [hr_eq] at hx₁_mem ⊢
    exact hMain_ind (r - 1) hx₁_mem

  exact ⟨K₀, m₀, f₁_bar, x₀_f₁, xZ_f₁,
    hK₀_pos, rfl, hm₀_ge6, hx₀_f₁_mem, hx₀_f₁_res, hxZ_f₁_rel,
    hx₀_f₁_Y', hxZ_f₁_Z, hf₁_bar_Z, hLinInd, hH1_surj, hVeronese⟩

theorem weil_sup1_closed_fiber_koszul_veronese_generation (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ)
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (hPencil : IsUnstableP1HenselianPencil V g n τ Z V₀ V₁ h₀ eZ eY t₀)
    (A₀ : ℕ)
    (hA₀_pos : 1 ≤ A₀)
    (hA₀_surj :
      let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
      let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
      let Y := CategoryTheory.Limits.pullback g s₀
      let fstY := CategoryTheory.Limits.pullback.fst g s₀
      let V₀_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₀
      let V₁_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₁
      ∀ z : ↑(Y.presheaf.obj (Opposite.op (V₀_Y ⊓ V₁_Y))),
        ∃ (x₀ : ↑(Y.presheaf.obj (Opposite.op V₀_Y)))
          (x₁ : ↑(Y.presheaf.obj (Opposite.op V₁_Y))),
          (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀_Y ⊓ V₁_Y ≤ V₁_Y)).op).hom
              ((fstY.appLE V₁ V₁_Y le_rfl).hom (t₀ ^ A₀)) *
            (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op).hom x₀ -
            (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀_Y ⊓ V₁_Y ≤ V₁_Y)).op).hom x₁ = z) :
    ∃ (m₀ : ℕ)
      (f₁_bar : ↑((CategoryTheory.Limits.pullback g
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))).presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst g
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))).base).obj V₁)))),
      IsClosedFiberVeroneseSeed V g Z V₀ V₁ h₀ eZ eY t₀ m₀ f₁_bar :=
by
  let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
  let Y := CategoryTheory.Limits.pullback g s₀
  let fstY := CategoryTheory.Limits.pullback.fst g s₀
  let sndY := CategoryTheory.Limits.pullback.snd g s₀
  let Y'_set : Set ↥Y := ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E'
  let V₀_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₀
  let V₁_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₁
  let R₀_Y := Y.presheaf.obj (Opposite.op V₀_Y)
  let R₁_Y := Y.presheaf.obj (Opposite.op V₁_Y)
  let R₀₁_Y := Y.presheaf.obj (Opposite.op (V₀_Y ⊓ V₁_Y))
  let c₀_Y : k₀ →+* ↑R₀_Y :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE sndY ⊤ V₀_Y le_top).hom
  let c₁_Y : k₀ →+* ↑R₁_Y :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE sndY ⊤ V₁_Y le_top).hom
  let c₀₁_Y : k₀ →+* ↑R₀₁_Y :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE sndY ⊤ (V₀_Y ⊓ V₁_Y) le_top).hom
  letI : Algebra k₀ ↑R₀_Y := c₀_Y.toAlgebra
  letI : Algebra k₀ ↑R₁_Y := c₁_Y.toAlgebra
  letI : Algebra k₀ ↑R₀₁_Y := c₀₁_Y.toAlgebra
  let res₀_Y : ↑R₀_Y →+* ↑R₀₁_Y :=
    (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op).hom
  let res₁_Y : ↑R₁_Y →+* ↑R₀₁_Y :=
    (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀_Y ⊓ V₁_Y ≤ V₁_Y)).op).hom
  let h₀_Y : ↑R₀_Y := (fstY.appLE V₀ V₀_Y le_rfl).hom h₀
  let eZ_Y : ↑R₀_Y := (fstY.appLE V₀ V₀_Y le_rfl).hom eZ
  let eY_Y : ↑R₀_Y := (fstY.appLE V₀ V₀_Y le_rfl).hom eY
  let t₀_Y : ↑R₁_Y := (fstY.appLE V₁ V₁_Y le_rfl).hom t₀
  let I_Z_Y : Ideal ↑R₀_Y := Ideal.span ({h₀_Y, eY_Y} : Set ↑R₀_Y)
  let V₀_Z : Z_sch.Opens := (TopologicalSpace.Opens.map ιZ.base).obj V₀_Y
  let V₁_Z : Z_sch.Opens := (TopologicalSpace.Opens.map ιZ.base).obj V₁_Y
  let A_Z0 := Z_sch.presheaf.obj (Opposite.op V₀_Z)
  let A_Z1 := Z_sch.presheaf.obj (Opposite.op V₁_Z)
  let A_Z01 := Z_sch.presheaf.obj (Opposite.op (V₀_Z ⊓ V₁_Z))
  let res_Z0 : ↑A_Z0 →+* ↑A_Z01 :=
    (Z_sch.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀_Z ⊓ V₁_Z ≤ V₀_Z)).op).hom
  let res_Z1 : ↑A_Z1 →+* ↑A_Z01 :=
    (Z_sch.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀_Z ⊓ V₁_Z ≤ V₁_Z)).op).hom
  let π_Z0 : ↑R₀_Y →+* ↑A_Z0 := (ιZ.app V₀_Y).hom
  let π_Z1 : ↑R₁_Y →+* ↑A_Z1 := (ιZ.app V₁_Y).hom
  let π_Z01 : ↑R₀₁_Y →+* ↑A_Z01 := (ιZ.app (V₀_Y ⊓ V₁_Y)).hom
  obtain ⟨⟨instAlgClosed_k₀, instReduced_R1, instNoeth_R1, hInj₀, hInj₁⟩,
      ⟨hAff_VZ0, hAff_VZ1, hNe_VZ0, hNe_VZ1, hCov_VZ, instDom_AZ0, h_h₀_Z_ne, instNontriv_AZ1⟩,
      ⟨⟨w₀_Y, heZeY⟩, hht⟩,
      ⟨hSurj_Z0, hSurj_Z1, _hSurj_Z01, hRad_Z1, hIZ_iff, hVan_Z0, hVan_Z1⟩,
      ⟨A'_0, A'_1, A'_01, instRingA'0, instRingA'1, instRingA'01,
        res'_0, res'_1, π'_0, π'_1, π'_01, u₁_V₁, u₁_V₀, α₀, β₀, 𝔭₁, 𝔭₂,
        hComm'_0, hComm'_1, hSurj'_0, hSurj'_1, hSurj'_01, hRad'_1,
        hKer0, hKer1, hKer01, hLoc'_0, hLift0, hu₁_glue, hBezout, hu₁_pow_ne, hu₁_basicOpen,
        hSΔ_eq, hu₁_p1, hu₁_p2, hNodes⟩⟩ :=
    weil_sup1_closed_fiber_scheme_to_nodal_rings K m V hMaxNeBot hPkg
      C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK C g τ ι hSemi
      Z Z_sch ιZ hUnstab V₀ V₁ h₀ eZ eY t₀ hPencil
  letI : IsAlgClosed k₀ := instAlgClosed_k₀
  letI : IsReduced ↑R₁_Y := instReduced_R1
  letI : IsNoetherianRing ↑R₁_Y := instNoeth_R1
  letI : IsDomain ↑A_Z0 := instDom_AZ0
  letI : Nontrivial ↑A_Z1 := instNontriv_AZ1
  letI : CommRing A'_0 := instRingA'0
  letI : CommRing A'_1 := instRingA'1
  letI : CommRing A'_01 := instRingA'01
  have hres₀_c : ∀ c : k₀, res₀_Y (algebraMap k₀ ↑R₀_Y c) = algebraMap k₀ ↑R₀₁_Y c := by
    intro c
    have hmap := AlgebraicGeometry.Scheme.Hom.appLE_map sndY (U := ⊤) le_top
      (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op
    exact (congrArg
      (fun f => ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ f).hom c) hmap)
  have hres₁_c : ∀ c : k₀, res₁_Y (algebraMap k₀ ↑R₁_Y c) = algebraMap k₀ ↑R₀₁_Y c := by
    intro c
    have hmap := AlgebraicGeometry.Scheme.Hom.appLE_map sndY (U := ⊤) le_top
      (CategoryTheory.homOfLE (inf_le_right : V₀_Y ⊓ V₁_Y ≤ V₁_Y)).op
    exact (congrArg
      (fun f => ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ f).hom c) hmap)
  let res₀_alg : ↑R₀_Y →ₐ[k₀] ↑R₀₁_Y :=
    { toRingHom := res₀_Y, commutes' := hres₀_c }
  let res₁_alg : ↑R₁_Y →ₐ[k₀] ↑R₀₁_Y :=
    { toRingHom := res₁_Y, commutes' := hres₁_c }
  have hComm_Z0 : res_Z0.comp π_Z0 = π_Z01.comp res₀_alg.toRingHom := by
    have hnat := ιZ.naturality (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op
    have h_op : ((TopologicalSpace.Opens.map ιZ.base).map
        (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op.unop).op =
        (CategoryTheory.homOfLE (inf_le_left : V₀_Z ⊓ V₁_Z ≤ V₀_Z)).op :=
      congrArg Opposite.op (Subsingleton.elim _ _)
    rw [h_op] at hnat
    ext x
    exact (congrArg (fun f => f.hom x) hnat).symm
  have hComm_Z1 : res_Z1.comp π_Z1 = π_Z01.comp res₁_alg.toRingHom := by
    have hnat := ιZ.naturality (CategoryTheory.homOfLE (inf_le_right : V₀_Y ⊓ V₁_Y ≤ V₁_Y)).op
    have h_op : ((TopologicalSpace.Opens.map ιZ.base).map
        (CategoryTheory.homOfLE (inf_le_right : V₀_Y ⊓ V₁_Y ≤ V₁_Y)).op.unop).op =
        (CategoryTheory.homOfLE (inf_le_right : V₀_Z ⊓ V₁_Z ≤ V₁_Z)).op :=
      congrArg Opposite.op (Subsingleton.elim _ _)
    rw [h_op] at hnat
    ext x
    exact (congrArg (fun f => f.hom x) hnat).symm
  obtain ⟨isoP1, hisoP1⟩ := hUnstab.2.2.2.2.1
  obtain ⟨hZ_H0_raw, hZ_H1⟩ :=
    weil_sup1_proj_line_two_chart_cohomology k₀ Z_sch (ιZ ≫ sndY) isoP1 hisoP1
      V₀_Z V₁_Z hAff_VZ0 hAff_VZ1 hNe_VZ0 hNe_VZ1 hCov_VZ
  have hc_Z0 : ∀ c : k₀,
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE (ιZ ≫ sndY) ⊤ V₀_Z le_top).hom c =
      π_Z0 (algebraMap k₀ ↑R₀_Y c) := by
    intro c
    have hcomp := (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ιZ sndY ⊤ V₀_Y V₀_Z
      le_top le_rfl).symm
    rw [AlgebraicGeometry.Scheme.Hom.appLE_eq_app] at hcomp
    exact congrArg
      (fun f => ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ f).hom c) hcomp
  have hc_Z1 : ∀ c : k₀,
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE (ιZ ≫ sndY) ⊤ V₁_Z le_top).hom c =
      π_Z1 (algebraMap k₀ ↑R₁_Y c) := by
    intro c
    have hcomp := (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ιZ sndY ⊤ V₁_Y V₁_Z
      le_top le_rfl).symm
    rw [AlgebraicGeometry.Scheme.Hom.appLE_eq_app] at hcomp
    exact congrArg
      (fun f => ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ f).hom c) hcomp
  have hZ_H0 : ∀ (a₀ : ↑A_Z0) (a₁ : ↑A_Z1), res_Z0 a₀ = res_Z1 a₁ →
      ∃ c : k₀, a₀ = π_Z0 (algebraMap k₀ ↑R₀_Y c) ∧ a₁ = π_Z1 (algebraMap k₀ ↑R₁_Y c) := by
    intro a₀ a₁ h_eq
    obtain ⟨c, ha₀, ha₁⟩ := hZ_H0_raw a₀ a₁ h_eq
    exact ⟨c, ha₀.trans (hc_Z0 c), ha₁.trans (hc_Z1 c)⟩
  obtain ⟨hEv_all, hSum_primes⟩ :=
    weil_sup1_nodal_roof_ideal_sum_eq_inf k₀ ↑R₁_Y
      (RingHom.ker π_Z1) (RingHom.ker π'_1) hRad_Z1 hRad'_1 hKer1 hNodes
  have hp1_mem : RingHom.ker π_Z1 ⊔ RingHom.ker π'_1 ≤ 𝔭₁.asIdeal := by
    have hmem : 𝔭₁ ∈ ({𝔭₁, 𝔭₂} : Set (PrimeSpectrum ↑R₁_Y)) := Set.mem_insert 𝔭₁ {𝔭₂}
    rw [← hSΔ_eq] at hmem
    exact hmem
  have hp2_mem : RingHom.ker π_Z1 ⊔ RingHom.ker π'_1 ≤ 𝔭₂.asIdeal := by
    have hmem : 𝔭₂ ∈ ({𝔭₁, 𝔭₂} : Set (PrimeSpectrum ↑R₁_Y)) :=
      Set.mem_insert_of_mem 𝔭₁ (Set.mem_singleton 𝔭₂)
    rw [← hSΔ_eq] at hmem
    exact hmem
  obtain ⟨ev₁, hev₁_ker⟩ := hEv_all 𝔭₁ hp1_mem
  obtain ⟨ev₂, hev₂_ker⟩ := hEv_all 𝔭₂ hp2_mem
  have hSum_iff : ∀ x : ↑R₁_Y,
      x ∈ RingHom.ker π_Z1 ⊔ RingHom.ker π'_1 ↔ ev₁ x = 0 ∧ ev₂ x = 0 := by
    intro x
    rw [hSum_primes x]
    constructor
    · intro hx
      have hx1 : x ∈ 𝔭₁.asIdeal := hx 𝔭₁ hp1_mem
      have hx2 : x ∈ 𝔭₂.asIdeal := hx 𝔭₂ hp2_mem
      rw [← hev₁_ker] at hx1
      rw [← hev₂_ker] at hx2
      exact ⟨hx1, hx2⟩
    · rintro ⟨hx1, hx2⟩ 𝔭 h𝔭
      have hmem : 𝔭 ∈ ({𝔭₁, 𝔭₂} : Set (PrimeSpectrum ↑R₁_Y)) := by
        rw [← hSΔ_eq]
        exact h𝔭
      rcases hmem with rfl | h_eq2
      · rw [← hev₁_ker]
        exact hx1
      · rw [Set.mem_singleton_iff.mp h_eq2, ← hev₂_ker]
        exact hx2
  have hu₁_ev₁ : ev₁ u₁_V₁ = 0 := by
    have h : u₁_V₁ ∈ RingHom.ker ev₁.toRingHom := by
      rw [hev₁_ker]
      exact hu₁_p1
    exact h
  have hu₁_ev₂ : ev₂ u₁_V₁ = 0 := by
    have h : u₁_V₁ ∈ RingHom.ker ev₂.toRingHom := by
      rw [hev₂_ker]
      exact hu₁_p2
    exact h
  have hA₀_surj' : ∀ z : ↑R₀₁_Y,
      ∃ (x₀ : ↑R₀_Y) (x₁ : ↑R₁_Y),
        res₁_alg (t₀_Y ^ A₀) * res₀_alg x₀ - res₁_alg x₁ = z := by
    intro z
    obtain ⟨x₀, x₁, h_eq⟩ := hA₀_surj z
    refine ⟨x₀, x₁, ?_⟩
    simpa [res₀_alg, res₁_alg, t₀_Y, map_pow] using h_eq
  obtain ⟨K₀, m₀, f₁_bar, x₀_f₁, xZ_f₁,
      hK₀_pos, _hm₀_eq, hm₀_ge6, hx₀_mem, hx₀_glue, hxZ_rel,
      hx₀_Y', hxZ_Z, hf₁_Z, hLinInd, hH1_surj, hVeronese⟩ :=
    weil_sup1_bezout_koszul_veronese_algebra k₀
      ↑R₀_Y ↑R₁_Y ↑R₀₁_Y ↑A_Z0 ↑A_Z1 ↑A_Z01 A'_0 A'_1 A'_01
      res₀_alg res₁_alg hInj₀ hInj₁
      res_Z0 res_Z1 π_Z0 π_Z1 π_Z01 hComm_Z0 hComm_Z1 hSurj_Z0 hSurj_Z1
      res'_0 res'_1 π'_0 π'_1 π'_01 hComm'_0 hComm'_1 hSurj'_0 hSurj'_1 hSurj'_01
      hKer0 hKer1 hKer01 hLift0
      h₀_Y eZ_Y eY_Y w₀_Y t₀_Y h_h₀_Z_ne heZeY hht hLoc'_0 hIZ_iff
      hZ_H0 hZ_H1 ev₁ ev₂ hSum_iff
      u₁_V₁ u₁_V₀ α₀ β₀ hu₁_glue hu₁_ev₁ hu₁_ev₂ hBezout hu₁_pow_ne
      A₀ hA₀_pos hA₀_surj'
  refine ⟨m₀, f₁_bar, hm₀_ge6,
    ⟨x₀_f₁, xZ_f₁, hx₀_mem, hx₀_glue, hxZ_rel,
      hu₁_basicOpen K₀ x₀_f₁ hK₀_pos hx₀_Y', hVan_Z0 xZ_f₁ hxZ_Z⟩,
    hLinInd, hVan_Z1 f₁_bar hf₁_Z, hH1_surj, hVeronese⟩

theorem weil_sup1_relative_pencil_scheme_to_ring_bridge (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ)
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (hPencil : IsUnstableP1HenselianPencil V g n τ Z V₀ V₁ h₀ eZ eY t₀) :
    let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
    let Y := CategoryTheory.Limits.pullback g s₀
    let fstY := CategoryTheory.Limits.pullback.fst g s₀
    let sndY := CategoryTheory.Limits.pullback.snd g s₀
    let V₀_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₀
    let V₁_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₁
    let R₀ := C.presheaf.obj (Opposite.op V₀)
    let R₁ := C.presheaf.obj (Opposite.op V₁)
    let R₀₁ := C.presheaf.obj (Opposite.op (V₀ ⊓ V₁))
    let R₀_Y := Y.presheaf.obj (Opposite.op V₀_Y)
    let R₁_Y := Y.presheaf.obj (Opposite.op V₁_Y)
    let R₀₁_Y := Y.presheaf.obj (Opposite.op (V₀_Y ⊓ V₁_Y))
    let c₀ : ↥V →+* ↑R₀ :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₀ le_top).hom
    let c₁ : ↥V →+* ↑R₁ :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₁ le_top).hom
    let c₀₁ : ↥V →+* ↑R₀₁ :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE g ⊤ (V₀ ⊓ V₁) le_top).hom
    let c₁_Y : k₀ →+* ↑R₁_Y :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE sndY ⊤ V₁_Y le_top).hom
    let res₀_hom : ↑R₀ →+* ↑R₀₁ :=
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom
    let res₁_hom : ↑R₁ →+* ↑R₀₁ :=
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
    let res₀_Y : ↑R₀_Y →+* ↑R₀₁_Y :=
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op).hom
    let res₁_Y : ↑R₁_Y →+* ↑R₀₁_Y :=
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀_Y ⊓ V₁_Y ≤ V₁_Y)).op).hom
    let π₀ : ↑R₀ →+* ↑R₀_Y := (fstY.appLE V₀ V₀_Y le_rfl).hom
    let π₁ : ↑R₁ →+* ↑R₁_Y := (fstY.appLE V₁ V₁_Y le_rfl).hom
    let π₀₁ : ↑R₀₁ →+* ↑R₀₁_Y := (fstY.appLE (V₀ ⊓ V₁) (V₀_Y ⊓ V₁_Y) le_rfl).hom
    IsDomain ↑R₀ ∧ IsDomain ↑R₁ ∧ IsDomain ↑R₀₁ ∧ h₀ ≠ 0 ∧ t₀ ≠ 0 ∧
    @IsLocalization.Away _ _ h₀ ↑R₀₁ _ res₀_hom.toAlgebra ∧
    @IsLocalization.Away _ _ t₀ ↑R₀₁ _ res₁_hom.toAlgebra ∧
    Function.Injective res₀_hom ∧ Function.Injective res₁_hom ∧
    (∀ v : ↥V, res₀_hom (c₀ v) = c₀₁ v) ∧
    (∀ v : ↥V, res₁_hom (c₁ v) = c₀₁ v) ∧
    (∀ (v : ↥V) (r : ↑R₁), v ≠ 0 → c₁ v * r = 0 → r = 0) ∧
    Function.Surjective π₀ ∧ Function.Surjective π₁ ∧ Function.Surjective π₀₁ ∧
    RingHom.ker π₁ = Ideal.map c₁ (IsLocalRing.maximalIdeal ↥V) ∧
    RingHom.ker π₀₁ = Ideal.map c₀₁ (IsLocalRing.maximalIdeal ↥V) ∧
    res₀_Y.comp π₀ = π₀₁.comp res₀_hom ∧
    res₁_Y.comp π₁ = π₀₁.comp res₁_hom ∧
    (∀ v : ↥V, π₁ (c₁ v) = c₁_Y (algebraMap ↥V k₀ v)) ∧
    Function.Injective res₀_Y ∧
    (∀ (m₀ : ℕ) (x₀ : ↑R₀), 1 ≤ m₀ →
      (⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E') \ (V₁_Y : Set Y) ⊆
        (Y.basicOpen (π₀ x₀) : Set Y) →
      ∃ r_u : ℕ, eY ^ r_u ∈ Ideal.span ({h₀ ^ m₀, x₀} : Set ↑R₀)) :=
by
  intro k₀ s₀ Y fstY sndY V₀_Y V₁_Y R₀ R₁ R₀₁ R₀_Y R₁_Y R₀₁_Y
    c₀ c₁ c₀₁ c₁_Y res₀_hom res₁_hom res₀_Y res₁_Y π₀ π₁ π₀₁
  let 𝔪_V : Ideal ↥V := IsLocalRing.maximalIdeal ↥V
  have hMaxPrime : 𝔪_V.IsPrime := (IsLocalRing.maximalIdeal.isMaximal ↥V).isPrime
  have instAlgClosed_k₀ : IsAlgClosed k₀ := @hPkg.2.2.2.2.1 𝔪_V hMaxPrime hMaxNeBot
  have hInt_C : AlgebraicGeometry.IsIntegral C := hSemi.1.1
  rcases hUnstab with ⟨hZ_comp, _, _, _, _, _, _, hCov_ZY', _⟩
  rcases hPencil with ⟨hAff_V₀, hAff_V₁, _hCov_V, h_bo_h₀, h_bo_t₀, hht,
    _hFin₀, _hFin₁, _hQuot₀, hQuot₁_all, _hMonic₁, _heZ_add, heZ_mul,
    _hFree_BZ, _hFin_BZ, _hNontriv_BZ, _hFree_BY', hFin_BY', _hNontriv_BY',
    _hSec, _hDelta_V₁, _hSm_V₀, hMeet_all, _hFin_comp, hRed_Y, hZ_sub, _⟩
  obtain ⟨y_z, hy_z_01, _⟩ := @hMeet_all k₀ _ instAlgClosed_k₀ s₀ Z hZ_comp
  have hNonempty_01 : Nonempty ↥(V₀ ⊓ V₁) := ⟨⟨fstY.base y_z, hy_z_01⟩⟩
  have hNonempty_0 : Nonempty ↥V₀ := ⟨⟨fstY.base y_z, hy_z_01.1⟩⟩
  have hNonempty_1 : Nonempty ↥V₁ := ⟨⟨fstY.base y_z, hy_z_01.2⟩⟩
  have hDom₀ : IsDomain ↑R₀ :=
    @AlgebraicGeometry.IsIntegral.component_integral C hInt_C V₀ hNonempty_0
  have hDom₁ : IsDomain ↑R₁ :=
    @AlgebraicGeometry.IsIntegral.component_integral C hInt_C V₁ hNonempty_1
  have hDom₀₁ : IsDomain ↑R₀₁ :=
    @AlgebraicGeometry.IsIntegral.component_integral C hInt_C (V₀ ⊓ V₁) hNonempty_01
  letI : IsDomain ↑R₀ := hDom₀
  letI : IsDomain ↑R₁ := hDom₁
  letI : IsDomain ↑R₀₁ := hDom₀₁
  have hh₀_ne : h₀ ≠ 0 := by
    intro hh₀
    have h1 : (0 : ↑R₀₁) = 1 := by
      calc
        (0 : ↑R₀₁) = 0 * res₁_hom t₀ := (zero_mul _).symm
        _ = res₀_hom h₀ * res₁_hom t₀ := by rw [hh₀, map_zero]
        _ = 1 := hht
    exact zero_ne_one h1
  have ht₀_ne : t₀ ≠ 0 := by
    intro ht₀
    have h1 : (0 : ↑R₀₁) = 1 := by
      calc
        (0 : ↑R₀₁) = res₀_hom h₀ * 0 := (mul_zero _).symm
        _ = res₀_hom h₀ * res₁_hom t₀ := by rw [ht₀, map_zero]
        _ = 1 := hht
    exact zero_ne_one h1
  have hLoc₀ : @IsLocalization.Away _ _ h₀ ↑R₀₁ _ res₀_hom.toAlgebra :=
    @AlgebraicGeometry.IsAffineOpen.isLocalization_of_eq_basicOpen C V₀ hAff_V₀ h₀ (V₀ ⊓ V₁)
      (CategoryTheory.homOfLE inf_le_left) h_bo_h₀.symm
  have hLoc₁ : @IsLocalization.Away _ _ t₀ ↑R₀₁ _ res₁_hom.toAlgebra :=
    @AlgebraicGeometry.IsAffineOpen.isLocalization_of_eq_basicOpen C V₁ hAff_V₁ t₀ (V₀ ⊓ V₁)
      (CategoryTheory.homOfLE inf_le_right) h_bo_t₀.symm
  have hInj₀ : Function.Injective res₀_hom :=
    @IsLocalization.injective ↑R₀ _ (Submonoid.powers h₀) ↑R₀₁ _ res₀_hom.toAlgebra hLoc₀
      (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hh₀_ne))
  have hInj₁ : Function.Injective res₁_hom :=
    @IsLocalization.injective ↑R₁ _ (Submonoid.powers t₀) ↑R₀₁ _ res₁_hom.toAlgebra hLoc₁
      (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero ht₀_ne))
  have hc₀_compat : ∀ v : ↥V, res₀_hom (c₀ v) = c₀₁ v := by
    intro v
    have h1 :
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
          AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₀ le_top) ≫
          C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
          AlgebraicGeometry.Scheme.Hom.appLE g ⊤ (V₀ ⊓ V₁) le_top := by
      calc
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₀ le_top) ≫
            C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op
          = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
              (AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₀ le_top ≫
                C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op) :=
            CategoryTheory.Category.assoc _ _ _
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
              AlgebraicGeometry.Scheme.Hom.appLE g ⊤ (V₀ ⊓ V₁) le_top :=
            congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫ ·)
              (AlgebraicGeometry.Scheme.Hom.appLE_map g le_top
                (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op)
    exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom h1) v
  have hc₁_compat : ∀ v : ↥V, res₁_hom (c₁ v) = c₀₁ v := by
    intro v
    have h1 :
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
          AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₁ le_top) ≫
          C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
          AlgebraicGeometry.Scheme.Hom.appLE g ⊤ (V₀ ⊓ V₁) le_top := by
      calc
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₁ le_top) ≫
            C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op
          = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
              (AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₁ le_top ≫
                C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op) :=
            CategoryTheory.Category.assoc _ _ _
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
              AlgebraicGeometry.Scheme.Hom.appLE g ⊤ (V₀ ⊓ V₁) le_top :=
