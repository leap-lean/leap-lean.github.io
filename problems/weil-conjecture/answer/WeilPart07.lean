    · intro E hE
      have hE_cl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
      let η_E : ↥X := hE.1.genericPoint
      have hGen : IsGenericPoint η_E E := IsIrreducible.isGenericPoint_genericPoint hE.1 hE_cl
      refine ⟨η_E, hGen.mem, hGen.def, ?_⟩
      by_contra hη_not_sm
      obtain ⟨W_X, hW_X, B, _, φ₁, φ₂, ι_WU, v₀, hφ₂_et, _, hv₀_η, h_ι_comap, hv₀_X, hOffSm⟩ :=
        hChart η_E hη_not_sm
