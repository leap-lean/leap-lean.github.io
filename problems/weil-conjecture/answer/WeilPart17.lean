  let e₂ : (Fℤ ⟶ F_gm) ≃+ (Aℤ ⟶ G₀) :=
    { toEquiv := adj.homEquiv Aℤ F_gm
      map_add' := fun φ₁ φ₂ => by
        change adj.homEquiv Aℤ F_gm (φ₁ + φ₂) =
          adj.homEquiv Aℤ F_gm φ₁ + adj.homEquiv Aℤ F_gm φ₂
        rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
          CategoryTheory.Adjunction.homEquiv_unit]
        change adj.unit.app Aℤ ≫ (φ₁ + φ₂).hom.app (Opposite.op T) =
          adj.unit.app Aℤ ≫ φ₁.hom.app (Opposite.op T) +
            adj.unit.app Aℤ ≫ φ₂.hom.app (Opposite.op T)
        have happ : (φ₁ + φ₂).hom.app (Opposite.op T) =
            φ₁.hom.app (Opposite.op T) + φ₂.hom.app (Opposite.op T) := rfl
        rw [happ, CategoryTheory.Preadditive.comp_add] }
  let e₃ : (Aℤ ⟶ G₀) ≃+ ↥G₀ :=
    { toFun := fun f => f.hom (ULift.up (1 : ℤ))
      invFun := fun m => AddCommGrpCat.ofHom
        { toFun := fun n => n.down • m
          map_zero' := zero_zsmul m
          map_add' := fun a b => add_zsmul m a.down b.down }
      left_inv := fun f => by
        ext ⟨n⟩
        change n • f.hom (ULift.up (1 : ℤ)) = f.hom (ULift.up n)
        rw [← map_zsmul f.hom n (ULift.up (1 : ℤ))]
        congr 1
        ext
        simp
      right_inv := fun m => one_zsmul m
      map_add' := fun _ _ => rfl }
  let α_T : P_gm.obj (Opposite.op T) ≅ G₀ :=
    (CategoryTheory.isoSheafify J hGmSheaf).app (Opposite.op T)
  let e₄ : ↥G₀ ≃+ Additive (Units S) :=
    { toFun := α_T.inv.hom
      invFun := α_T.hom.hom
      left_inv := fun x =>
        congrArg (fun φ : G₀ ⟶ G₀ => φ.hom x) α_T.inv_hom_id
      right_inv := fun y =>
        congrArg (fun φ : P_gm.obj (Opposite.op T) ⟶ P_gm.obj (Opposite.op T) => φ.hom y)
          α_T.hom_inv_id
      map_add' := fun x y => α_T.inv.hom.map_add x y }
  let e_H0 : F_gm.H 0 ≃+ Additive (Units S) := ((e₁.trans e₂).trans e₃).trans e₄

  
  let φ₀ : k →+* D₀.R₀ := (algebraMap (Polynomial k) D₀.R₀).comp Polynomial.C
