    rw [map_sub, hr, sub_self]
  
  let F_U : Sheaf Y_U.smallEtaleTopology AddCommGrpCat.{u} := weilEtaleTorsionSheaf Y_U ℓ
  have hStep7 : Nonempty (weilEtaleHigherDirectImage π_U 0 F_U ≅ pf_πU.obj F_U) := by
    let J_U := Y_U.smallEtaleTopology
    let J_Z := Z.smallEtaleTopology
    let Free_PSh := (Functor.whiskeringRight (Opposite Y_U.Etale) (Type u) AddCommGrpCat.{u}).obj
