        dsimp [ι₀₁_R, A₀₁]; simp
      have hR_split : (((1 : D.R₀₁) ⊗ₜ[D.R₀] ((u₀ : T₀) * σE₀ x)) ⊗ₜ[D.R₀₁] (1 : T₁_ov) : A₀₁) =
