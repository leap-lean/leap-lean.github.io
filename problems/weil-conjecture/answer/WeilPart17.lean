          algebraMap (Polynomial A) D.R₁ ((0 : Fin D.r → Polynomial A) j) * D.b₁ j) := by
      have hL : (Finset.univ.sum fun j : Fin D.r =>
          algebraMap (Polynomial A) D.R₁ (Polynomial.X * f j) * D.b₁ j) =
