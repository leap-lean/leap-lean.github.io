      let R_q := CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q)
      have hR_mem : R_q ∈ AlgebraicGeometry.Scheme.etaleTopology S_k := by
        apply CategoryTheory.Precoverage.generate_mem_toGrothendieck
        exact (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff
          (@AlgebraicGeometry.Etale) q).mpr ⟨hqSurj, hqEt⟩
      obtain ⟨Y, f, hf, y, hy⟩ := P_pt.jointly_surjective R_q hR_mem (𝟙 S_k)
      obtain ⟨W', g, h, hh, rfl⟩ := hf
      cases hh
      let y₀ : S_k ⟶ Y := y
      exact ⟨y₀ ≫ g, (CategoryTheory.Category.assoc y₀ g q).trans hy⟩
    have hTop_Tk : ∀ R ∈ S_k.smallEtaleTopology T_k, R = ⊤ := by
      intro R hR
      let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Etale
      have instComp : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
        CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      have heq : S_k.smallEtaleTopology =
          (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          S_k (le_refl P_et)
      have hiff := AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S_k) T_k R
      have hmem := ((iff_of_eq (congrArg
        (fun J : CategoryTheory.GrothendieckTopology S_k.Etale => R ∈ J T_k) heq)).trans hiff).mp hR
      obtain ⟨W, u, w₀, huR, huEt, _⟩ := hmem (default : ↥S_k)
      have hSubSk : Subsingleton ↥S_k := inferInstance
      have huSurj : Function.Surjective u.left.base :=
        fun x => ⟨w₀, @Subsingleton.elim ↥S_k hSubSk _ x⟩
      obtain ⟨s, hs⟩ := hSplit W.left u.left huEt huSurj
      have hu_hom : u.left = W.hom :=
        (CategoryTheory.Category.comp_id u.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w u)
      have hs_hom : s ≫ W.hom = T_k.hom := by
        rw [← hu_hom]
        exact hs
      let s_et : T_k ⟶ W := CategoryTheory.MorphismProperty.Over.homMk s hs_hom trivial
      have hs_et : s_et ≫ u = 𝟙 T_k := by
        apply (AlgebraicGeometry.Scheme.Etale.forget S_k).map_injective
        apply CategoryTheory.Over.OverMorphism.ext
        exact hs
      have hid_mem : R.arrows (𝟙 T_k) := by
        rw [← hs_et]
        exact R.downward_closed huR s_et
      exact CategoryTheory.Sieve.id_mem_iff_eq_top.mp hid_mem
    have hSky : ∀ (P : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u}),
        CategoryTheory.Limits.IsZero
          ((CategoryTheory.presheafToSheaf S_k.smallEtaleTopology AddCommGrpCat.{u}).obj P) →
        Subsingleton (P.obj (Opposite.op T_k)) := by
      intro P hZeroP
      let M : AddCommGrpCat.{u} := P.obj (Opposite.op T_k)
      have pi_beta : ∀ {I : Type u} {X : AddCommGrpCat.{u}} (g : I → (X ⟶ M)) (i : I),
          CategoryTheory.Limits.Pi.lift g ≫ CategoryTheory.Limits.Pi.π (fun _ : I => M) i = g i := by
        intro I X g i
        simp
      let R_pre : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u} :=
        { obj := fun W => ∏ᶜ (fun _ : (T_k ⟶ Opposite.unop W) => M)
          map := fun {W₁ W₂} f =>
            CategoryTheory.Limits.Pi.lift (fun τ : (T_k ⟶ Opposite.unop W₂) =>
              CategoryTheory.Limits.Pi.π (fun _ : (T_k ⟶ Opposite.unop W₁) => M) (τ ≫ f.unop))
          map_id := fun W => by
            apply CategoryTheory.Limits.Pi.hom_ext
            intro τ
            simp
          map_comp := fun {W₁ W₂ W₃} f g => by
            apply CategoryTheory.Limits.Pi.hom_ext
            intro τ
            simp }
      have hR_sheaf : CategoryTheory.Presheaf.IsSheaf S_k.smallEtaleTopology R_pre := by
        rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
        intro U S hS
        have hτ_mem : ∀ (τ : T_k ⟶ U), S.arrows τ := by
          intro τ
          have hpb : S.pullback τ = ⊤ :=
            hTop_Tk (S.pullback τ) (S_k.smallEtaleTopology.pullback_stable τ hS)
          have hid : (S.pullback τ).arrows (𝟙 T_k) := by rw [hpb]; trivial
          simpa using hid
        let mkObj : (T_k ⟶ U) → S.arrows.category :=
          fun τ => ⟨CategoryTheory.Over.mk τ, hτ_mem τ⟩
        let liftCone : ∀ (s : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ R_pre)),
            s.pt ⟶ ∏ᶜ (fun _ : (T_k ⟶ U) => M) :=
          fun s =>
            CategoryTheory.Limits.Pi.lift (fun τ : (T_k ⟶ U) =>
              s.π.app (Opposite.op (mkObj τ)) ≫
                CategoryTheory.Limits.Pi.π (fun _ : (T_k ⟶ T_k) => M) (𝟙 T_k))
        refine ⟨{
          lift := liftCone
          fac := fun s j => by
            let V : S_k.Etale := j.unop.obj.left
            let u_j : V ⟶ U := j.unop.obj.hom
            let π_j : ∏ᶜ (fun _ : (T_k ⟶ U) => M) ⟶ ∏ᶜ (fun _ : (T_k ⟶ V) => M) :=
              R_pre.map u_j.op
            let s_j : s.pt ⟶ ∏ᶜ (fun _ : (T_k ⟶ V) => M) := s.π.app j
            change liftCone s ≫ π_j = s_j
            apply CategoryTheory.Limits.Pi.hom_ext
            intro ρ
            let mor : mkObj (ρ ≫ u_j) ⟶ j.unop :=
              CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk ρ rfl)
            have hw : s_j ≫ R_pre.map ρ.op = s.π.app (Opposite.op (mkObj (ρ ≫ u_j))) :=
              s.w mor.op
            have h_lhs : (liftCone s ≫ π_j) ≫
                CategoryTheory.Limits.Pi.π (fun _ : (T_k ⟶ V) => M) ρ =
                s.π.app (Opposite.op (mkObj (ρ ≫ u_j))) ≫
                  CategoryTheory.Limits.Pi.π (fun _ : (T_k ⟶ T_k) => M) (𝟙 T_k) := by
              rw [CategoryTheory.Category.assoc]
              dsimp only [π_j, R_pre, liftCone]
              rw [pi_beta, pi_beta]
              rfl
            have h_rhs : s.π.app (Opposite.op (mkObj (ρ ≫ u_j))) ≫
                CategoryTheory.Limits.Pi.π (fun _ : (T_k ⟶ T_k) => M) (𝟙 T_k) =
                s_j ≫ CategoryTheory.Limits.Pi.π (fun _ : (T_k ⟶ V) => M) ρ := by
              rw [← hw, CategoryTheory.Category.assoc]
              dsimp only [R_pre]
              rw [pi_beta]
              change s_j ≫ CategoryTheory.Limits.Pi.π (fun _ : (T_k ⟶ V) => M) (𝟙 T_k ≫ ρ) = _
              rw [CategoryTheory.Category.id_comp]
            exact h_lhs.trans h_rhs
          uniq := fun s m hm => by
            let m' : s.pt ⟶ ∏ᶜ (fun _ : (T_k ⟶ U) => M) := m
            change m' = liftCone s
            apply CategoryTheory.Limits.Pi.hom_ext
            intro τ
            have hm_τ : m' ≫ R_pre.map τ.op = s.π.app (Opposite.op (mkObj τ)) :=
              hm (Opposite.op (mkObj τ))
            dsimp only [liftCone]
            rw [pi_beta, ← hm_τ, CategoryTheory.Category.assoc]
            dsimp only [R_pre]
            rw [pi_beta]
            change m' ≫ CategoryTheory.Limits.Pi.π (fun _ : (T_k ⟶ U) => M) τ =
              m' ≫ CategoryTheory.Limits.Pi.π (fun _ : (T_k ⟶ U) => M) (𝟙 T_k ≫ τ)
            rw [CategoryTheory.Category.id_comp] }⟩
      let α₀ : P ⟶ R_pre :=
        { app := fun W =>
            CategoryTheory.Limits.Pi.lift (fun τ : (T_k ⟶ Opposite.unop W) => P.map τ.op)
          naturality := fun {W₁ W₂} f => by
            apply CategoryTheory.Limits.Pi.hom_ext
            intro τ
            dsimp only [R_pre]
            rw [CategoryTheory.Category.assoc, pi_beta,
              CategoryTheory.Category.assoc, pi_beta, pi_beta, ← P.map_comp]
            rfl }
      have hα_id : α₀.app (Opposite.op T_k) ≫
          CategoryTheory.Limits.Pi.π (fun _ : (T_k ⟶ T_k) => M) (𝟙 T_k) = 𝟙 M := by
        dsimp only [α₀]
        rw [pi_beta]
        change P.map (𝟙 (Opposite.op T_k)) = 𝟙 M
        exact P.map_id (Opposite.op T_k)
      let adj := CategoryTheory.sheafificationAdjunction S_k.smallEtaleTopology AddCommGrpCat.{u}
      let P_sh := (CategoryTheory.presheafToSheaf S_k.smallEtaleTopology AddCommGrpCat.{u}).obj P
      let R_sh : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u} := ⟨R_pre, hR_sheaf⟩
      let r_sh : P_sh ⟶ R_sh := (adj.homEquiv P R_sh).symm α₀
      have hfac : adj.unit.app P ≫ r_sh.hom = α₀ := by
        have h1 := (adj.homEquiv P R_sh).apply_symm_apply α₀
        have h2 := CategoryTheory.Adjunction.homEquiv_unit adj P R_sh r_sh
        exact h2.symm.trans h1
      have hid_zero : 𝟙 P_sh = 0 := (CategoryTheory.Limits.IsZero.iff_id_eq_zero P_sh).mp hZeroP
      have hr_zero : r_sh = 0 := by
        rw [← CategoryTheory.Category.id_comp r_sh, hid_zero, CategoryTheory.Limits.zero_comp]
      have hr_hom_zero : r_sh.hom = 0 := by
        rw [hr_zero]
        rfl
      have hα_zero : α₀ = 0 := by
        rw [← hfac, hr_hom_zero, CategoryTheory.Limits.comp_zero]
      have hidM_zero : (𝟙 M : M ⟶ M) = 0 := by
        rw [← hα_id, hα_zero]
        simp
      refine ⟨fun x y => ?_⟩
      have hx : x = (𝟙 M : M ⟶ M) x := rfl
      have hy : y = (𝟙 M : M ⟶ M) y := rfl
      rw [hx, hy, hidM_zero]
      rfl
    let B_fZ : CategoryTheory.Functor S_k.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f_Z
    have hSub₁ : Subsingleton (((G.cohomologyPresheaf p).obj (Opposite.op (B_fZ.obj T_k)))) :=
      hSky (B_fZ.op.comp (G.cohomologyPresheaf p)) hZero
    obtain ⟨e_B⟩ := hPbTerm f_Z
    let e_coh := (G.cohomologyPresheaf p).mapIso e_B.op
    have hSub₂ : Subsingleton (((G.cohomologyPresheaf p).obj (Opposite.op T_Z))) := by
      refine ⟨fun a b => ?_⟩
      have hab : e_coh.hom a = e_coh.hom b := @Subsingleton.elim _ hSub₁ _ _
      have ha : e_coh.inv (e_coh.hom a) = a := ConcreteCategory.congr_hom e_coh.hom_inv_id a
      have hb : e_coh.inv (e_coh.hom b) = b := ConcreteCategory.congr_hom e_coh.hom_inv_id b
      rw [← ha, ← hb, hab]
    obtain ⟨hTZ⟩ := hTerm Z
    let e_yon : ∀ (W : Opposite Z.Etale), (CategoryTheory.yoneda.obj T_Z).obj W ≅ PUnit.{u + 1} :=
      fun W => Equiv.toIso
        { toFun := fun _ => PUnit.unit
          invFun := fun _ => hTZ.from (Opposite.unop W)
          left_inv := fun g => hTZ.hom_ext _ g
          right_inv := fun ⟨⟩ => rfl }
    let Z_ulift : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let u_hom : AddCommGrpCat.free.obj PUnit.{u + 1} ⟶ Z_ulift :=
      (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} Z_ulift).symm
        (TypeCat.ofHom (fun _ : PUnit.{u + 1} => ULift.up.{u} (1 : ℤ)))
    let gen₀ : AddCommGrpCat.free.obj PUnit.{u + 1} :=
      AddCommGrpCat.adj.unit.app PUnit.{u + 1} PUnit.unit
    let u_inv : Z_ulift ⟶ AddCommGrpCat.free.obj PUnit.{u + 1} :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • gen₀
          map_zero' := zero_zsmul gen₀
          map_add' := fun a b => add_zsmul gen₀ a.down b.down }
    have hu_gen : u_hom gen₀ = ULift.up.{u} (1 : ℤ) := by
      have h1 := (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} Z_ulift).apply_symm_apply
        (TypeCat.ofHom (fun _ : PUnit.{u + 1} => ULift.up.{u} (1 : ℤ)))
      have h2 := CategoryTheory.Adjunction.homEquiv_unit AddCommGrpCat.adj PUnit.{u + 1} Z_ulift u_hom
      exact ConcreteCategory.congr_hom (h2.symm.trans h1) PUnit.unit
    let e_ℤ : AddCommGrpCat.free.obj PUnit.{u + 1} ≅ Z_ulift :=
      { hom := u_hom
        inv := u_inv
        hom_inv_id := by
          apply (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} (AddCommGrpCat.free.obj PUnit.{u + 1})).injective
          have hL := CategoryTheory.Adjunction.homEquiv_unit AddCommGrpCat.adj
            PUnit.{u + 1} (AddCommGrpCat.free.obj PUnit.{u + 1}) (u_hom ≫ u_inv)
          have hR := CategoryTheory.Adjunction.homEquiv_unit AddCommGrpCat.adj
            PUnit.{u + 1} (AddCommGrpCat.free.obj PUnit.{u + 1}) (𝟙 (AddCommGrpCat.free.obj PUnit.{u + 1}))
          rw [hL, hR]
          ext ⟨⟩
          change u_inv (u_hom gen₀) = gen₀
          rw [hu_gen]
          exact one_zsmul gen₀
        inv_hom_id := by
          apply AddCommGrpCat.ext
          rintro ⟨z⟩
          change u_hom (z • gen₀) = ULift.up z
          rw [map_zsmul, hu_gen]
          apply ULift.ext
          exact zsmul_one z }
    let φ_pre : (CategoryTheory.yoneda.obj T_Z).comp AddCommGrpCat.free ≅
        (CategoryTheory.Functor.const (Opposite Z.Etale)).obj Z_ulift :=
      CategoryTheory.NatIso.ofComponents
        (fun W => (AddCommGrpCat.free.mapIso (e_yon W)) ≪≫ e_ℤ)
        (fun {W₁ W₂} f => by
          dsimp
          rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc,
            ← AddCommGrpCat.free.map_comp]
          congr 2)
    let φ_ℤ := (CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).mapIso φ_pre
    let to_H := (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.inv).precomp G (Nat.zero_add p)
    let inv_H := (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.hom).precomp G (Nat.zero_add p)
    have h_right : ∀ (y : CategoryTheory.Abelian.Ext
        ((CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
          ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj Z_ulift)) G p),
        to_H (inv_H y) = y := by
      intro y
      change (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.inv).comp
        ((CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.hom).comp y (Nat.zero_add p)) (Nat.zero_add p) = y
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, φ_ℤ.inv_hom_id,
        CategoryTheory.Abelian.Ext.mk₀_id_comp]
    refine ⟨fun a b => ?_⟩
    have hab : inv_H a = inv_H b := @Subsingleton.elim _ hSub₂ (inv_H a) (inv_H b)
    have ha : to_H (inv_H a) = a := h_right a
    have hb : to_H (inv_H b) = b := h_right b
    rw [← ha, ← hb, hab]

theorem weil_etale_pushforward_leray_bijective_of_shortExact (ℓ : ℕ) {Z' Z : AlgebraicGeometry.Scheme.{u}} (f : Z' ⟶ Z) :
    letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_f : CategoryTheory.Functor Z.Etale Z'.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    ∀ [_hc : B_f.IsContinuous Z.smallEtaleTopology Z'.smallEtaleTopology],
      let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u}
        Z.smallEtaleTopology Z'.smallEtaleTopology
      ∀ [_hr : pf_f.IsRightAdjoint],
        let pb_f := B_f.sheafPullback AddCommGrpCat.{u}
          Z.smallEtaleTopology Z'.smallEtaleTopology
        let adj_f := B_f.sheafAdjunctionContinuous AddCommGrpCat.{u}
          Z.smallEtaleTopology Z'.smallEtaleTopology
        ∀ [_hAdd : pb_f.Additive]
          [_hLim : CategoryTheory.Limits.PreservesFiniteLimits pb_f]
          [_hColim : CategoryTheory.Limits.PreservesFiniteColimits pb_f]
          [_hAdd_pf : pf_f.Additive],
          let Pℤ_Z := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj (AddCommGrpCat.of (ULift.{u} ℤ))
          let Pℤ_Z' := (CategoryTheory.Functor.const (Opposite Z'.Etale)).obj (AddCommGrpCat.of (ULift.{u} ℤ))
          let Fℤ_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ))
          let Fℤ_Z' := (CategoryTheory.constantSheaf Z'.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ))
          let η₀ := CategoryTheory.Functor.whiskerLeft B_f.op
            ((CategoryTheory.sheafificationAdjunction Z'.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ_Z')
          let uℤ := ((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
            Pℤ_Z (pf_f.obj Fℤ_Z')).symm η₀
          let cℤ := (adj_f.homEquiv Fℤ_Z Fℤ_Z').symm uℤ
          ∀ (hcℤ : CategoryTheory.IsIso cℤ),
            (∀ (E : CategoryTheory.Sheaf Z'.smallEtaleTopology AddCommGrpCat.{u}),
              ℓ • CategoryTheory.CategoryStruct.id E = 0 →
              ∃ (SC : CategoryTheory.ShortComplex
                  (CategoryTheory.Sheaf Z'.smallEtaleTopology AddCommGrpCat.{u})),
                SC.X₁ = E ∧
                SC.ShortExact ∧
                (SC.map pf_f).ShortExact ∧
                ℓ • CategoryTheory.CategoryStruct.id SC.X₂ = 0 ∧
                ℓ • CategoryTheory.CategoryStruct.id SC.X₃ = 0 ∧
                ∀ p : ℕ, 1 ≤ p →
                  Subsingleton (SC.X₂.H p) ∧ Subsingleton ((pf_f.obj SC.X₂).H p)) →
            ∀ (q : ℕ) (E : CategoryTheory.Sheaf Z'.smallEtaleTopology AddCommGrpCat.{u}),
              ℓ • CategoryTheory.CategoryStruct.id E = 0 →
              let inv_cℤ := @CategoryTheory.inv _ _ _ _ cℤ hcℤ
              Function.Bijective (fun (x : (pf_f.obj E).H q) =>
                (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app E)).postcomp Fℤ_Z' (Nat.add_zero q)
                  ((CategoryTheory.Abelian.Ext.mk₀ inv_cℤ).precomp (pb_f.obj (pf_f.obj E)) (Nat.zero_add q)
                    ((pb_f.mapExtAddHom Fℤ_Z (pf_f.obj E) q) x))) :=
by
  have hAbstract : ∀ {C D : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C] [CategoryTheory.Abelian C] [CategoryTheory.HasExt.{u} C]
      [CategoryTheory.Category.{u + 1, u + 1} D] [CategoryTheory.Abelian D] [CategoryTheory.HasExt.{u} D]
      (L : CategoryTheory.Functor C D) (R : CategoryTheory.Functor D C) (adj : L ⊣ R)
      [L.Additive] [CategoryTheory.Limits.PreservesFiniteLimits L]
      [CategoryTheory.Limits.PreservesFiniteColimits L] [R.PreservesZeroMorphisms]
      (F_C : C) (F_D : D) (c : L.obj F_C ⟶ F_D) (hc : CategoryTheory.IsIso c),
      (∀ (E : D),
        ℓ • CategoryTheory.CategoryStruct.id E = 0 →
        ∃ (SC : CategoryTheory.ShortComplex D),
          SC.X₁ = E ∧
          SC.ShortExact ∧
          (SC.map R).ShortExact ∧
          ℓ • CategoryTheory.CategoryStruct.id SC.X₂ = 0 ∧
