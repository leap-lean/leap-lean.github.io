        let inv_g := @CategoryTheory.inv _ _ _ _ c_g hc_g
        let inv_f' := @CategoryTheory.inv _ _ _ _ c_f' hc_f'
        let inv_g' := @CategoryTheory.inv _ _ _ _ c_g' hc_g'
        inv_f' ≫ pb_f'.map inv_g ≫ θ.app F_S = inv_g' ≫ pb_g'.map inv_f := by
    intro C_S C_X C_S' C_X' _ _ _ _ pb_f pf_f pb_g pf_g pb_f' pf_f' pb_g' pf_g'
      adj_f adj_g adj_f' adj_g' e_R F_S F_X F_S' F_X' u_f u_g u_f' u_g' hu
      c_f c_g c_f' c_g' θ hc_f hc_g hc_f' hc_g' inv_f inv_g inv_f' inv_g'
    have hCompSymm : ∀ {A₁ A₂ A₃ : Type (u + 1)}
        [CategoryTheory.Category.{u + 1, u + 1} A₁]
        [CategoryTheory.Category.{u + 1, u + 1} A₂]
        [CategoryTheory.Category.{u + 1, u + 1} A₃]
        {L₁ : CategoryTheory.Functor A₁ A₂} {R₁ : CategoryTheory.Functor A₂ A₁}
        {L₂ : CategoryTheory.Functor A₂ A₃} {R₂ : CategoryTheory.Functor A₃ A₂}
        (ad₁ : L₁ ⊣ R₁) (ad₂ : L₂ ⊣ R₂)
        {M₁ : A₁} {M₂ : A₂} {M₃ : A₃}
        (v₁ : M₁ ⟶ R₁.obj M₂) (v₂ : M₂ ⟶ R₂.obj M₃),
        ((ad₁.comp ad₂).homEquiv M₁ M₃)
          (L₂.map ((ad₁.homEquiv M₁ M₂).symm v₁) ≫ (ad₂.homEquiv M₂ M₃).symm v₂) =
        v₁ ≫ R₁.map v₂ := by
      intro A₁ A₂ A₃ _ _ _ L₁ R₁ L₂ R₂ ad₁ ad₂ M₁ M₂ M₃ v₁ v₂
      rw [CategoryTheory.Adjunction.comp_homEquiv]
      dsimp only [Equiv.trans_apply]
      rw [CategoryTheory.Adjunction.homEquiv_naturality_left, Equiv.apply_symm_apply,
        CategoryTheory.Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply]
    have hUninv : θ.app F_S ≫ (pb_g'.map c_f ≫ c_g') = pb_f'.map c_g ≫ c_f' := by
      apply ((adj_g.comp adj_f').homEquiv F_S F_X').injective
      dsimp only [θ, c_f, c_g, c_f', c_g']
      rw [hConjHomEquiv (adj_f.comp adj_g') (adj_g.comp adj_f') e_R F_S F_X',
        hCompSymm adj_f adj_g' u_f u_g', hCompSymm adj_g adj_f' u_g u_f']
      exact hu
    have hcf_inv : c_f ≫ inv_f = CategoryTheory.CategoryStruct.id _ :=
      @CategoryTheory.IsIso.hom_inv_id _ _ _ _ c_f hc_f
    have hcg_inv : inv_g ≫ c_g = CategoryTheory.CategoryStruct.id _ :=
      @CategoryTheory.IsIso.inv_hom_id _ _ _ _ c_g hc_g
    have hcf'_inv : inv_f' ≫ c_f' = CategoryTheory.CategoryStruct.id _ :=
      @CategoryTheory.IsIso.inv_hom_id _ _ _ _ c_f' hc_f'
    have hcg'_inv : c_g' ≫ inv_g' = CategoryTheory.CategoryStruct.id _ :=
      @CategoryTheory.IsIso.hom_inv_id _ _ _ _ c_g' hc_g'
    calc
      inv_f' ≫ pb_f'.map inv_g ≫ θ.app F_S
        = inv_f' ≫ pb_f'.map inv_g ≫ θ.app F_S ≫
            CategoryTheory.CategoryStruct.id (pb_g'.obj (pb_f.obj F_S)) := by
          congr 2
          exact (CategoryTheory.Category.comp_id (θ.app F_S)).symm
      _ = inv_f' ≫ pb_f'.map inv_g ≫ θ.app F_S ≫
            pb_g'.map c_f ≫ (c_g' ≫ inv_g') ≫ pb_g'.map inv_f := by
          rw [hcg'_inv, CategoryTheory.Category.id_comp, ← pb_g'.map_comp, hcf_inv, pb_g'.map_id]
      _ = inv_f' ≫ pb_f'.map inv_g ≫
            (θ.app F_S ≫ (pb_g'.map c_f ≫ c_g')) ≫ inv_g' ≫ pb_g'.map inv_f := by
          simp only [CategoryTheory.Category.assoc]
      _ = inv_f' ≫ (pb_f'.map inv_g ≫ pb_f'.map c_g) ≫ c_f' ≫ inv_g' ≫ pb_g'.map inv_f := by
          rw [hUninv]
          simp only [CategoryTheory.Category.assoc]
      _ = inv_f' ≫ c_f' ≫ inv_g' ≫ pb_g'.map inv_f := by
          rw [← pb_f'.map_comp, hcg_inv, pb_f'.map_id, CategoryTheory.Category.id_comp]
      _ = (inv_f' ≫ c_f') ≫ inv_g' ≫ pb_g'.map inv_f := by
          simp only [CategoryTheory.Category.assoc]
      _ = inv_g' ≫ pb_g'.map inv_f := by
          rw [hcf'_inv, CategoryTheory.Category.id_comp]

  
  have hExtNat : ∀ {C D₁ D₂ ℰ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C] [CategoryTheory.Abelian C]
      [CategoryTheory.EnoughInjectives C] [CategoryTheory.HasExt.{u} C]
      [CategoryTheory.Category.{u + 1, u + 1} D₁] [CategoryTheory.Abelian D₁]
      [CategoryTheory.HasExt.{u} D₁]
      [CategoryTheory.Category.{u + 1, u + 1} D₂] [CategoryTheory.Abelian D₂]
      [CategoryTheory.HasExt.{u} D₂]
      [CategoryTheory.Category.{u + 1, u + 1} ℰ] [CategoryTheory.Abelian ℰ]
      [CategoryTheory.HasExt.{u} ℰ]
      (F₁ : CategoryTheory.Functor C D₁) [F₁.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits F₁]
      [CategoryTheory.Limits.PreservesFiniteColimits F₁]
      (F₂ : CategoryTheory.Functor D₁ ℰ) [F₂.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits F₂]
      [CategoryTheory.Limits.PreservesFiniteColimits F₂]
      (G₁ : CategoryTheory.Functor C D₂) [G₁.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits G₁]
      [CategoryTheory.Limits.PreservesFiniteColimits G₁]
      (G₂ : CategoryTheory.Functor D₂ ℰ) [G₂.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits G₂]
      [CategoryTheory.Limits.PreservesFiniteColimits G₂]
      (τ : CategoryTheory.Functor.comp F₁ F₂ ⟶ CategoryTheory.Functor.comp G₁ G₂)
      (q : ℕ) {X Y : C} (x : CategoryTheory.Abelian.Ext X Y q),
      (CategoryTheory.Abelian.Ext.mapExactFunctor F₂
        (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ x)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (τ.app Y)) (Nat.add_zero q) =
      (CategoryTheory.Abelian.Ext.mk₀ (τ.app X)).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor G₂
          (CategoryTheory.Abelian.Ext.mapExactFunctor G₁ x)) (Nat.zero_add q) := by
    intro C D₁ D₂ ℰ _ _ _ _ _ _ _ _ _ _ _ _ _ F₁ _ _ _ F₂ _ _ _ G₁ _ _ _ G₂ _ _ _ τ q
    induction q with
    | zero =>
      intro X Y x
      let f₀ : X ⟶ Y := CategoryTheory.Abelian.Ext.addEquiv₀ x
      have hx : x = CategoryTheory.Abelian.Ext.mk₀ f₀ := by
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
        exact (CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply x).symm
      rw [hx,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      exact congrArg CategoryTheory.Abelian.Ext.mk₀ (τ.naturality f₀)
    | succ q ih =>
      intro X Y x
      let J : C := CategoryTheory.Injective.under Y
      let ι : Y ⟶ J := CategoryTheory.Injective.ι Y
      let Q : C := CategoryTheory.Limits.cokernel ι
      let π : J ⟶ Q := CategoryTheory.Limits.cokernel.π ι
      let S : CategoryTheory.ShortComplex C :=
        CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hZero : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (q + 1)) = 0 :=
        @CategoryTheory.Abelian.Ext.eq_zero_of_injective C _ _ _ X J q inferInstance _
      obtain ⟨y, hy⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS x hZero (rfl : q + 1 = q + 1)
      let hSF₁ : (S.map F₁).ShortExact := hS.map_of_exact F₁
      let hSF : ((S.map F₁).map F₂).ShortExact := hSF₁.map_of_exact F₂
      let hSG₁ : (S.map G₁).ShortExact := hS.map_of_exact G₁
      let hSG : ((S.map G₁).map G₂).ShortExact := hSG₁.map_of_exact G₂
      let Φ : (S.map F₁).map F₂ ⟶ (S.map G₁).map G₂ :=
        { τ₁ := τ.app Y
          τ₂ := τ.app J
          τ₃ := τ.app Q
          comm₁₂ := (τ.naturality ι).symm
          comm₂₃ := (τ.naturality π).symm }
      have hNatExt : hSF.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (τ.app Y)) (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (τ.app Q)).comp hSG.extClass (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSF hSG Φ
      rw [← hy,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F₁ hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F₂ hSF₁,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G₁ hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G₂ hSG₁]
      let yF := CategoryTheory.Abelian.Ext.mapExactFunctor F₂
        (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ y)
      let yG := CategoryTheory.Abelian.Ext.mapExactFunctor G₂
        (CategoryTheory.Abelian.Ext.mapExactFunctor G₁ y)
      calc
        (yF.comp hSF.extClass rfl).comp
            (CategoryTheory.Abelian.Ext.mk₀ (τ.app Y)) (Nat.add_zero (q + 1))
          = yF.comp (hSF.extClass.comp
              (CategoryTheory.Abelian.Ext.mk₀ (τ.app Y)) (Nat.add_zero 1)) rfl :=
            CategoryTheory.Abelian.Ext.comp_assoc yF hSF.extClass _
              rfl (Nat.add_zero 1) (Nat.add_zero (q + 1))
        _ = yF.comp ((CategoryTheory.Abelian.Ext.mk₀ (τ.app Q)).comp
              hSG.extClass (Nat.zero_add 1)) rfl := by
            rw [hNatExt]
        _ = (yF.comp (CategoryTheory.Abelian.Ext.mk₀ (τ.app Q)) (Nat.add_zero q)).comp
              hSG.extClass rfl :=
            (CategoryTheory.Abelian.Ext.comp_assoc yF
              (CategoryTheory.Abelian.Ext.mk₀ (τ.app Q)) hSG.extClass
              (Nat.add_zero q) (Nat.zero_add 1) (by omega)).symm
        _ = ((CategoryTheory.Abelian.Ext.mk₀ (τ.app X)).comp yG (Nat.zero_add q)).comp
              hSG.extClass rfl := by
            rw [ih y]
        _ = (CategoryTheory.Abelian.Ext.mk₀ (τ.app X)).comp
              (yG.comp hSG.extClass rfl) (Nat.zero_add (q + 1)) :=
            CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (τ.app X)) yG hSG.extClass
              (Nat.zero_add q) rfl (by omega)

  
