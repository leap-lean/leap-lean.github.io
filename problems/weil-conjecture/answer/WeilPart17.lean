        ext; exact heq_mul
      calc gM = (gM * Units.map iL.toMonoidHom u) * (Units.map iL.toMonoidHom u)⁻¹ := by
            rw [mul_inv_cancel_right]
        _ = (Units.map iR.toMonoidHom u * gL) * (Units.map iL.toMonoidHom u)⁻¹ := by rw [← hu_eq]
        _ = gL * (Units.map iR.toMonoidHom u * (Units.map iL.toMonoidHom u)⁻¹) := by
            rw [mul_comm (Units.map iR.toMonoidHom u) gL, mul_assoc]
