                  (hPush_Spec.trans (congrArg (· ≫ AlgebraicGeometry.Spec.map ι₀.appTop) hSpec_fZ))).trans
                  ((CategoryTheory.Category.assoc e_BZ _ _).trans
                    (congrArg (e_BZ ≫ ·) (CategoryTheory.Category.assoc _ _ _).symm))
              have hc₃ : e_BZ ≫ (AlgebraicGeometry.Spec.map ι₀.appTop ≫ U₀_sch.isoSpec.inv) ≫ U_aff.ι =
