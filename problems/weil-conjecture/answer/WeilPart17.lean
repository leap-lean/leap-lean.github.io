  have clear_tensor_t : ∀ v : M.L₁,
      ∃ (m : ℕ) (v₀ : M.L₀), η₁ v = u₀₁ ^ m • M.θ (η₀ v₀) := by
    have clear_L₀ : ∀ z : TensorProduct D.R₀ D.R₀₁ M.L₀,
