              have hc₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B) ≫ g_left =
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_A)) ≫
