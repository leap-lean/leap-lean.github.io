      [AlgebraicGeometry.IsOpenImmersion u₀_X] [AlgebraicGeometry.IsOpenImmersion u₁_X]
      (hcov : Set.range u₀_X.base ∪ Set.range u₁_X.base = Set.univ)
      (g₀ : V₀_Z ⟶ U₀_X) (j₀' : V₀_Z ⟶ Z) [AlgebraicGeometry.IsOpenImmersion j₀']
      (g₁ : V₁_Z ⟶ U₁_X) (j₁' : V₁_Z ⟶ Z) [AlgebraicGeometry.IsOpenImmersion j₁'],
      g₀ ≫ u₀_X = j₀' ≫ q → Set.range j₀'.base = q.base ⁻¹' (Set.range u₀_X.base) → P g₀ →
      g₁ ≫ u₁_X = j₁' ≫ q → Set.range j₁'.base = q.base ⁻¹' (Set.range u₁_X.base) → P g₁ →
      P q := by
    intro P _ Z X U₀_X U₁_X V₀_Z V₁_Z q u₀_X u₁_X _ _ hcov g₀ j₀' _ g₁ j₁' _
      hc₀ hr₀ hg₀ hc₁ hr₁ hg₁
    have hOne : ∀ {U_X V_Z : AlgebraicGeometry.Scheme.{u}} (u_X : U_X ⟶ X)
