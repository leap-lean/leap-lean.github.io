        exact ht1.trans (ht2.trans ht3)
      refine ⟨a_U, ?_, ?_⟩
      · intro Y f hf
        let O_V : U.left.affineOpens → Y.left.Opens :=
          fun V => (TopologicalSpace.Opens.map f.left.base).obj V.1
        have hcovY : (⨆ V : U.left.affineOpens, O_V V) = ⊤ := by
          rw [eq_top_iff]
          intro y _
          rw [TopologicalSpace.Opens.mem_iSup]
          have hy_top : f.left.base y ∈ (⊤ : U.left.Opens) := trivial
          rw [← hcovU, TopologicalSpace.Opens.mem_iSup] at hy_top
          exact hy_top
        apply hGlobalEqOfCover Y.left O_V hcovY
        intro V
        have hrange : Set.range ((O_V V).ι ≫ f.left).base ⊆ Set.range V.1.ι.base := by
          rintro _ ⟨y, rfl⟩
          exact ⟨⟨f.left.base y.1, y.2⟩, rfl⟩
        let f_V : (O_V V).toScheme ⟶ V.1.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift V.1.ι ((O_V V).ι ≫ f.left) hrange
        have hf_V : f_V ≫ V.1.ι = (O_V V).ι ≫ f.left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac V.1.ι ((O_V V).ι ≫ f.left) hrange
        let Y_V : Z.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ ((O_V V).ι ≫ Y.hom)
            (CategoryTheory.MorphismProperty.comp_mem P_et _ _ inferInstance Y.prop)
        let i_V : Y_V ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk (O_V V).ι rfl
        let g_V : Y_V ⟶ W_of V.1 :=
          CategoryTheory.MorphismProperty.Over.homMk f_V
            (by change f_V ≫ V.1.ι ≫ U.hom = (O_V V).ι ≫ Y.hom
                rw [← CategoryTheory.Category.assoc, hf_V, CategoryTheory.Category.assoc,
                  CategoryTheory.MorphismProperty.Over.w f])
        have hg_j : g_V ≫ j_of V.1 = i_V ≫ f :=
          CategoryTheory.MorphismProperty.Over.Hom.ext hf_V
        have hi_f : R.arrows (i_V ≫ f) := R.downward_closed hf i_V
        have hg_R : (R_of V.1).arrows g_V := by
          change R.arrows (g_V ≫ j_of V.1)
          rw [hg_j]
          exact hi_f
        have hLHS : (O_V V).ι.appTop.hom (f.left.appTop.hom a_U) =
            s_fam (g_V ≫ j_of V.1) hg_R := by
          have hc1 : (O_V V).ι.appTop.hom (f.left.appTop.hom a_U) =
              ((O_V V).ι ≫ f.left).appTop.hom a_U :=
            (congrArg (fun φ => φ.hom a_U)
              (AlgebraicGeometry.Scheme.Hom.comp_appTop (O_V V).ι f.left)).symm
          have hc2 : ((O_V V).ι ≫ f.left).appTop.hom a_U = (f_V ≫ V.1.ι).appTop.hom a_U := by
            rw [hf_V]
          have hc3 : (f_V ≫ V.1.ι).appTop.hom a_U = f_V.appTop.hom (V.1.ι.appTop.hom a_U) :=
            congrArg (fun φ => φ.hom a_U)
              (AlgebraicGeometry.Scheme.Hom.comp_appTop f_V V.1.ι)
          have hc4 : f_V.appTop.hom (V.1.ι.appTop.hom a_U) = f_V.appTop.hom (a_top V) :=
            congrArg f_V.appTop.hom (ha_U_V V)
          exact hc1.trans (hc2.trans (hc3.trans (hc4.trans (ha_top_glue V g_V hg_R))))
        have hRHS : (O_V V).ι.appTop.hom (s_fam f hf) = s_fam (i_V ≫ f) hi_f := by
          have hc := hs_compat i_V (𝟙 Y_V) hf hi_f
            (CategoryTheory.Category.id_comp (i_V ≫ f)).symm
          have hid_s : (P_ring.map (𝟙 Y_V).op) (s_fam (i_V ≫ f) hi_f) =
              s_fam (i_V ≫ f) hi_f := by
            rw [CategoryTheory.op_id, P_ring.map_id]
            rfl
          exact hc.trans hid_s
        change (O_V V).ι.appTop.hom (f.left.appTop.hom a_U) =
          (O_V V).ι.appTop.hom (s_fam f hf)
        rw [hLHS, hRHS]
        congr 1
      · intro a' ha'
        let a'_U : ↑(U.left.presheaf.obj (Opposite.op ⊤)) := a'
        change a'_U = a_U
        apply hGlobalEqOfCover U.left (fun V : U.left.affineOpens => V.1) hcovU
        intro V
        rw [ha_U_V V]
        apply ha_top_uniq V
        intro Y f hf
        have hc1 : f.left.appTop.hom (V.1.ι.appTop.hom a'_U) =
            (f ≫ j_of V.1).left.appTop.hom a'_U :=
          (congrArg (fun φ => φ.hom a'_U)
            (AlgebraicGeometry.Scheme.Hom.comp_appTop f.left V.1.ι)).symm
        exact hc1.trans (ha' (f ≫ j_of V.1) hf)
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J (weilEtaleGmPresheaf Z)
      (CategoryTheory.forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    intro U R hR u_fam hu_compat
    have hR_gen : CategoryTheory.Sieve.generate R.arrows ∈ J U := by
      rwa [CategoryTheory.Sieve.generate_sieve]
    let u_at : ∀ {Y : Z.Etale} (f : Y ⟶ U), R.arrows f →
        Units ↑(Y.left.presheaf.obj (Opposite.op ⊤)) :=
      fun {Y} f hf =>
        @Additive.toMul (Units ↑(Y.left.presheaf.obj (Opposite.op ⊤))) (u_fam f hf)
    let a_fam : CategoryTheory.Presieve.FamilyOfElements P_ring R.arrows :=
      fun Y f hf => (u_at f hf).val
    let b_fam : CategoryTheory.Presieve.FamilyOfElements P_ring R.arrows :=
      fun Y f hf => (u_at f hf).inv
    have ha_compat : a_fam.Compatible := by
      intro Y₁ Y₂ Z' g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      have hu_eq : Units.map g₁.left.appTop.hom.toMonoidHom (u_at f₁ hf₁) =
          Units.map g₂.left.appTop.hom.toMonoidHom (u_at f₂ hf₂) :=
        congrArg (@Additive.toMul (Units ↑(Z'.left.presheaf.obj (Opposite.op ⊤))))
          (hu_compat g₁ g₂ hf₁ hf₂ hcomm)
      exact congrArg Units.val hu_eq
    have hb_compat : b_fam.Compatible := by
      intro Y₁ Y₂ Z' g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      have hu_eq : Units.map g₁.left.appTop.hom.toMonoidHom (u_at f₁ hf₁) =
          Units.map g₂.left.appTop.hom.toMonoidHom (u_at f₂ hf₂) :=
        congrArg (@Additive.toMul (Units ↑(Z'.left.presheaf.obj (Opposite.op ⊤))))
          (hu_compat g₁ g₂ hf₁ hf₂ hcomm)
      exact congrArg Units.inv hu_eq
    let a : ↑(U.left.presheaf.obj (Opposite.op ⊤)) :=
      (hRingSheaf.isSheafFor R.arrows hR_gen).amalgamate a_fam ha_compat
    let b : ↑(U.left.presheaf.obj (Opposite.op ⊤)) :=
      (hRingSheaf.isSheafFor R.arrows hR_gen).amalgamate b_fam hb_compat
    have ha_glue : ∀ {Y : Z.Etale} (f : Y ⟶ U) (hf : R.arrows f),
        f.left.appTop.hom a = a_fam f hf :=
      fun f hf => (hRingSheaf.isSheafFor R.arrows hR_gen).valid_glue ha_compat f hf
    have hb_glue : ∀ {Y : Z.Etale} (f : Y ⟶ U) (hf : R.arrows f),
        f.left.appTop.hom b = b_fam f hf :=
      fun f hf => (hRingSheaf.isSheafFor R.arrows hR_gen).valid_glue hb_compat f hf
    have hab : a * b = 1 := by
      apply (hRingSheaf.isSheafFor R.arrows hR_gen).isSeparatedFor.ext
      intro Y f hf
      change f.left.appTop.hom (a * b) = f.left.appTop.hom 1
      rw [map_mul, map_one, ha_glue f hf, hb_glue f hf]
      exact (u_at f hf).val_inv
    have hba : b * a = 1 := (mul_comm b a).trans hab
    let u₀ : Additive (Units ↑(U.left.presheaf.obj (Opposite.op ⊤))) :=
      Additive.ofMul ⟨a, b, hab, hba⟩
    refine ⟨u₀, ?_, ?_⟩
    · intro Y f hf
      apply (@Additive.toMul (Units ↑(Y.left.presheaf.obj (Opposite.op ⊤)))).injective
      apply Units.ext
      exact ha_glue f hf
    · intro u' hu'
      apply (@Additive.toMul (Units ↑(U.left.presheaf.obj (Opposite.op ⊤)))).injective
      apply Units.ext
      apply (hRingSheaf.isSheafFor R.arrows hR_gen).isSeparatedFor.ext
      intro Y f hf
      have hu'_f : Units.map f.left.appTop.hom.toMonoidHom
          (@Additive.toMul (Units ↑(U.left.presheaf.obj (Opposite.op ⊤))) u') =
          u_at f hf :=
        congrArg (@Additive.toMul (Units ↑(Y.left.presheaf.obj (Opposite.op ⊤)))) (hu' f hf)
      exact (congrArg Units.val hu'_f).trans (ha_glue f hf).symm

  
  let η_Gm : ∀ Z : AlgebraicGeometry.Scheme.{u},
      weilEtaleGmPresheaf Z ⟶ (weilEtaleGmSheaf Z).obj :=
    fun Z => (shAdj Z).unit.app (weilEtaleGmPresheaf Z)

  have hIso_ηGm : ∀ Z : AlgebraicGeometry.Scheme.{u}, CategoryTheory.IsIso (η_Gm Z) := by
    intro Z
    dsimp only [η_Gm, shAdj]
    rw [CategoryTheory.sheafificationAdjunction_unit_app]
    exact CategoryTheory.isIso_toSheafify Z.smallEtaleTopology (hGmIsSheaf Z)

  let e_ηGm : ∀ Z : AlgebraicGeometry.Scheme.{u},
      weilEtaleGmPresheaf Z ≅ (weilEtaleGmSheaf Z).obj :=
    fun Z => @CategoryTheory.asIso _ _ _ _ (η_Gm Z) (hIso_ηGm Z)

  let gmHom : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale),
      ↥((weilEtaleGmPresheaf Z).obj (Opposite.op V)) →+ (Z_sh Z V ⟶ weilEtaleGmSheaf Z) :=
    fun Z V =>
      { toFun := fun s => shHom Z V (weilEtaleGmSheaf Z) (((η_Gm Z).app (Opposite.op V)) s)
        map_zero' := by
          change shHom Z V (weilEtaleGmSheaf Z) (((η_Gm Z).app (Opposite.op V)).hom 0) = 0
          rw [map_zero, shHom_zero]
        map_add' := fun s₁ s₂ => by
          change shHom Z V (weilEtaleGmSheaf Z) (((η_Gm Z).app (Opposite.op V)).hom (s₁ + s₂)) = _
          rw [map_add, shHom_add] }

  let gmSec : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale),
      (Z_sh Z V ⟶ weilEtaleGmSheaf Z) → ↥((weilEtaleGmPresheaf Z).obj (Opposite.op V)) :=
    fun Z V φ => ((e_ηGm Z).inv.app (Opposite.op V)) (secOf Z V (weilEtaleGmSheaf Z) φ)

  have gmSec_gmHom : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (s : ↥((weilEtaleGmPresheaf Z).obj (Opposite.op V))),
      gmSec Z V (gmHom Z V s) = s := by
    intro Z V s
    dsimp only [gmSec, gmHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    rw [secOf_shHom]
    change (((e_ηGm Z).hom.app (Opposite.op V) ≫ (e_ηGm Z).inv.app (Opposite.op V)) s) = s
    rw [(e_ηGm Z).hom_inv_id_app]
    rfl

  have gmHom_gmSec : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (φ : Z_sh Z V ⟶ weilEtaleGmSheaf Z),
      gmHom Z V (gmSec Z V φ) = φ := by
    intro Z V φ
    dsimp only [gmSec, gmHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    have h_app : ((η_Gm Z).app (Opposite.op V))
        (((e_ηGm Z).inv.app (Opposite.op V)) (secOf Z V (weilEtaleGmSheaf Z) φ)) =
        secOf Z V (weilEtaleGmSheaf Z) φ := by
      change (((e_ηGm Z).inv.app (Opposite.op V) ≫ (e_ηGm Z).hom.app (Opposite.op V))
        (secOf Z V (weilEtaleGmSheaf Z) φ)) = _
      rw [(e_ηGm Z).inv_hom_id_app]
      rfl
    rw [h_app, shHom_secOf]

  have gmHom_inj : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      {s₁ s₂ : ↥((weilEtaleGmPresheaf Z).obj (Opposite.op V))},
      gmHom Z V s₁ = gmHom Z V s₂ → s₁ = s₂ := by
    intro Z V s₁ s₂ h
    rw [← gmSec_gmHom Z V s₁, ← gmSec_gmHom Z V s₂, h]

  have map_comp_gmHom : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : Z.Etale}
      (u : V₁ ⟶ V₂) (s : ↥((weilEtaleGmPresheaf Z).obj (Opposite.op V₂))),
      Z_sh_map u ≫ gmHom Z V₂ s = gmHom Z V₁ ((weilEtaleGmPresheaf Z).map u.op s) := by
    intro Z V₁ V₂ u s
    dsimp only [gmHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    rw [map_comp_shHom]
    congr 1
    exact congrArg (fun m => m s) ((η_Gm Z).naturality u.op).symm

  
  have heq_top : ∀ Z : AlgebraicGeometry.Scheme.{u},
      Z.smallEtaleTopology = Z.smallEtalePretopology.toGrothendieck :=
    fun Z => AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology Z le_rfl

  have hIsSheafType : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Presieve.IsSheaf Z.smallEtaleTopology
        (F.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
    fun Z F => (CategoryTheory.isSheaf_iff_isSheaf_of_type Z.smallEtaleTopology
      (F.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})).mp
      (CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf
        (J := Z.smallEtaleTopology) (F := CategoryTheory.forget AddCommGrpCat.{u}) F.obj F.property)

  have hSub_empty : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (T : Z.Etale),
      IsEmpty ↥T.left →
      Subsingleton ((F.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}).obj (Opposite.op T)) := by
    intro Z F T hEmp
    let S_emp : CategoryTheory.Sieve T := CategoryTheory.Sieve.generate (fun _ _ => False)
    have hEmp_pre : S_emp ∈ Z.smallEtalePretopology.toGrothendieck T :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := Z) T S_emp).mpr
        (fun x => IsEmpty.elim hEmp x)
    have hEmp_top : S_emp ∈ Z.smallEtaleTopology T := heq_top Z ▸ hEmp_pre
    have hSh := hIsSheafType Z F S_emp hEmp_top
    refine ⟨fun a b => hSh.isSeparatedFor.ext (fun _ _ hf => ?_)⟩
    rcases hf with ⟨_, _, _, hfalse, _⟩
    exact False.elim hfalse

  
  have hproj_last : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {W U : Z.Etale} (w : W ⟶ U) (p : ℕ),
      weilEtaleCechProj w (p + 1) (Fin.last (p + 1)) =
        CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w p) w := by
    intro Z W U w p
    dsimp only [weilEtaleCechProj, weilEtaleCechProjSub]
    rw [Fin.lastCases_last]

  have hproj_cast : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {W U : Z.Etale} (w : W ⟶ U)
      (p : ℕ) (j : Fin (p + 1)),
      weilEtaleCechProj w (p + 1) j.castSucc =
        CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w p) w ≫ weilEtaleCechProj w p j := by
    intro Z W U w p j
    dsimp only [weilEtaleCechProj, weilEtaleCechProjSub]
    rw [Fin.lastCases_castSucc]
    rfl

  have cechLift_proj : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {W U Y : Z.Etale}
      (w : W ⟶ U) (h : Y ⟶ U) (p : ℕ) (g : Fin (p + 1) → (Y ⟶ W))
      (hg : ∀ i, g i ≫ w = h) (i : Fin (p + 1)),
      (weilEtaleCechLiftSub w h p g hg).1 ≫ weilEtaleCechProj w p i = g i := by
    intro Z W U Y w h p
    induction p with
    | zero =>
      intro g hg i
      obtain rfl : i = 0 := Fin.eq_zero i
      exact CategoryTheory.Category.comp_id (g 0)
    | succ p ih =>
      intro g hg i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · rw [hproj_last]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      · rw [hproj_cast]
        exact (CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans
          (ih (fun k => g k.castSucc) (fun k => hg k.castSucc) j)

  have cechObj_hom_ext : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {W U Y : Z.Etale}
      {w : W ⟶ U} {p : ℕ} {l₁ l₂ : Y ⟶ weilEtaleCechObj w p},
      (∀ i : Fin (p + 1), l₁ ≫ weilEtaleCechProj w p i = l₂ ≫ weilEtaleCechProj w p i) →
      l₁ = l₂ := by
    intro Z W U Y w p
    induction p with
    | zero =>
      intro l₁ l₂ h
      have h0 : l₁ ≫ 𝟙 (weilEtaleCechObj w 0) = l₂ ≫ 𝟙 (weilEtaleCechObj w 0) := h 0
      rwa [CategoryTheory.Category.comp_id, CategoryTheory.Category.comp_id] at h0
    | succ p ih =>
      intro l₁ l₂ h
      apply CategoryTheory.Limits.pullback.hom_ext
      · refine ih (fun j => ?_)
        have hj := h j.castSucc
        rw [hproj_cast] at hj
        exact (CategoryTheory.Category.assoc l₁ _ _).trans
          (hj.trans (CategoryTheory.Category.assoc l₂ _ _).symm)
      · have hlast := h (Fin.last (p + 1))
        rwa [hproj_last] at hlast

  have cechFace_proj : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {W U : Z.Etale}
      (w : W ⟶ U) (p : ℕ) (j : Fin (p + 2)) (i : Fin (p + 1)),
      weilEtaleCechFace w p j ≫ weilEtaleCechProj w p i =
        weilEtaleCechProj w (p + 1) (j.succAbove i) :=
    fun w p j i => cechLift_proj w (weilEtaleCechHom w (p + 1)) p _ _ i

  have cechFace_hom : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {W U : Z.Etale}
      (w : W ⟶ U) (p : ℕ) (j : Fin (p + 2)),
      weilEtaleCechFace w p j ≫ weilEtaleCechHom w p = weilEtaleCechHom w (p + 1) :=
    fun w p j => (weilEtaleCechLiftSub w (weilEtaleCechHom w (p + 1)) p
      (fun i => weilEtaleCechProj w (p + 1) (j.succAbove i))
      (fun i => (weilEtaleCechProjSub w (p + 1) (j.succAbove i)).2)).2

  have cechFace_comp : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {W U : Z.Etale}
      (w : W ⟶ U) (m : ℕ) (a b : Fin (m + 2)), a ≤ b →
      weilEtaleCechFace w (m + 1) b.succ ≫ weilEtaleCechFace w m a =
        weilEtaleCechFace w (m + 1) a.castSucc ≫ weilEtaleCechFace w m b := by
    intro Z W U w m a b hab
    have hab' : (a : ℕ) ≤ (b : ℕ) := hab
    apply cechObj_hom_ext
    intro i
    rw [CategoryTheory.Category.assoc, cechFace_proj, cechFace_proj,
      CategoryTheory.Category.assoc, cechFace_proj, cechFace_proj]
    congr 1
    ext
    simp only [Fin.succAbove, Fin.lt_def, Fin.val_succ, Fin.val_castSucc]
    split_ifs <;> simp only [Fin.val_succ, Fin.val_castSucc] at * <;> omega

  
  let ε_psh : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      Z_psh Z (weilEtaleCechObj w 0) ⟶ Z_psh Z (T_Z Z) :=
    fun _ {_} w => Z_psh_map (weilEtaleCechHom w 0)
  let d_psh : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z) (p : ℕ),
      Z_psh Z (weilEtaleCechObj w (p + 1)) ⟶ Z_psh Z (weilEtaleCechObj w p) :=
    fun _ {_} w p => ∑ j : Fin (p + 2), (-1 : ℤ) ^ (j : ℕ) • Z_psh_map (weilEtaleCechFace w p j)

  have d_psh_apply_of : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale}
      (w : W ⟶ T_Z Z) (p : ℕ) (T : (Z.Etale)ᵒᵖ)
      (g : Opposite.unop T ⟶ weilEtaleCechObj w (p + 1)),
      ((d_psh Z w p).app T) (of_psh g) =
        ∑ j : Fin (p + 2), (-1 : ℤ) ^ (j : ℕ) •
          of_psh (g ≫ weilEtaleCechFace w p j) := by
    intro Z W w p T g
    dsimp only [d_psh]
    rw [CategoryTheory.NatTrans.app_sum]
    refine (hom_sum_apply Finset.univ
      (fun j : Fin (p + 2) => ((-1 : ℤ) ^ (j : ℕ) • Z_psh_map (weilEtaleCechFace w p j)).app T)
      (of_psh g)).trans ?_
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [CategoryTheory.NatTrans.app_zsmul, hom_zsmul_apply]
    congr 1

  have hd_psh₀ : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      d_psh Z w 0 ≫ ε_psh Z w = 0 := by
    intro Z W w
    ext T : 2
    refine z_psh_hom_ext _ _ (fun g => ?_)
    change ((ε_psh Z w).app T) (((d_psh Z w 0).app T) (of_psh g)) = 0
    rw [d_psh_apply_of Z w 0 T g, Fin.sum_univ_two, Fin.val_zero, Fin.val_one,
      pow_zero, pow_one, one_smul, neg_one_smul]
    change (FreeAbelianGroup.map fun h : Opposite.unop T ⟶ weilEtaleCechObj w 0 =>
        h ≫ weilEtaleCechHom w 0)
      (FreeAbelianGroup.of (g ≫ weilEtaleCechFace w 0 0) +
       -FreeAbelianGroup.of (g ≫ weilEtaleCechFace w 0 1)) = 0
    rw [map_add, map_neg, FreeAbelianGroup.map_of_apply, FreeAbelianGroup.map_of_apply,
      CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      cechFace_hom w 0 0, cechFace_hom w 0 1, add_neg_cancel]

  have hd_psh_succ : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale}
      (w : W ⟶ T_Z Z) (m : ℕ),
      d_psh Z w (m + 1) ≫ d_psh Z w m = 0 := by
    intro Z W w m
    ext T : 2
    refine z_psh_hom_ext _ _ (fun g => ?_)
    change ((d_psh Z w m).app T).hom (((d_psh Z w (m + 1)).app T) (of_psh g)) = 0
    rw [d_psh_apply_of Z w (m + 1) T g, map_sum]
    simp_rw [map_zsmul]
    have h_inner : ∀ j : Fin (m + 3),
        (-1 : ℤ) ^ (j : ℕ) • ((d_psh Z w m).app T).hom
          (of_psh (g ≫ weilEtaleCechFace w (m + 1) j)) =
        ∑ k : Fin (m + 2), ((-1 : ℤ) ^ (j : ℕ) * (-1 : ℤ) ^ (k : ℕ)) •
          of_psh (g ≫ weilEtaleCechFace w (m + 1) j ≫ weilEtaleCechFace w m k) := by
      intro j
      change (-1 : ℤ) ^ (j : ℕ) • (((d_psh Z w m).app T)
        (of_psh (g ≫ weilEtaleCechFace w (m + 1) j))) = _
      rw [d_psh_apply_of Z w m T (g ≫ weilEtaleCechFace w (m + 1) j), Finset.smul_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [smul_smul, CategoryTheory.Category.assoc]
    simp_rw [h_inner]
    let term : Fin (m + 3) × Fin (m + 2) → (Z_psh Z (weilEtaleCechObj w m)).obj T :=
      fun p => ((-1 : ℤ) ^ (p.1 : ℕ) * (-1 : ℤ) ^ (p.2 : ℕ)) •
        of_psh (g ≫ weilEtaleCechFace w (m + 1) p.1 ≫ weilEtaleCechFace w m p.2)
    change ∑ j : Fin (m + 3), ∑ k : Fin (m + 2), term (j, k) = 0
    rw [← Fintype.sum_prod_type]
    change ∑ p ∈ (Finset.univ : Finset (Fin (m + 3) × Fin (m + 2))), term p = 0
    rw [← Finset.sum_filter_add_sum_filter_not
      (Finset.univ : Finset (Fin (m + 3) × Fin (m + 2)))
      (fun p => (p.2 : ℕ) < (p.1 : ℕ))]
    let S_le : Finset (Fin (m + 2) × Fin (m + 2)) :=
      Finset.univ.filter (fun q => q.1 ≤ q.2)
    have h_lt : ∑ p ∈ Finset.univ.filter (fun p : Fin (m + 3) × Fin (m + 2) => (p.2 : ℕ) < (p.1 : ℕ)),
        term p = ∑ q ∈ S_le, term (q.2.succ, q.1) := by
      symm
      refine Finset.sum_bij (fun q _ => (q.2.succ, q.1)) ?_ ?_ ?_ (fun _ _ => rfl)
      · intro q hq
        rw [Finset.mem_filter] at hq ⊢
        refine ⟨Finset.mem_univ _, ?_⟩
        have hle : (q.1 : ℕ) ≤ (q.2 : ℕ) := hq.2
        simp only [Fin.val_succ]
        omega
      · intro q₁ _ q₂ _ heq
        injection heq with h2 h1
        exact Prod.ext h1 (Fin.succ_injective _ h2)
      · intro p hp
        rw [Finset.mem_filter] at hp
        have hj0 : p.1 ≠ 0 := by
          intro h0
          rw [h0] at hp
          exact Nat.not_lt_zero _ hp.2
        refine ⟨(p.2, p.1.pred hj0), ?_, Prod.ext (Fin.succ_pred p.1 hj0) rfl⟩
        rw [Finset.mem_filter]
        refine ⟨Finset.mem_univ _, ?_⟩
        rw [Fin.le_def, Fin.val_pred]
        exact Nat.le_pred_of_lt hp.2
    have h_ge : ∑ p ∈ Finset.univ.filter (fun p : Fin (m + 3) × Fin (m + 2) => ¬ (p.2 : ℕ) < (p.1 : ℕ)),
        term p = ∑ q ∈ S_le, term (q.1.castSucc, q.2) := by
      symm
      refine Finset.sum_bij (fun q _ => (q.1.castSucc, q.2)) ?_ ?_ ?_ (fun _ _ => rfl)
      · intro q hq
        rw [Finset.mem_filter] at hq ⊢
        refine ⟨Finset.mem_univ _, ?_⟩
        have hle : (q.1 : ℕ) ≤ (q.2 : ℕ) := hq.2
        simp only [Fin.val_castSucc]
        omega
      · intro q₁ _ q₂ _ heq
        injection heq with h1 h2
        exact Prod.ext (Fin.castSucc_injective _ h1) h2
      · intro p hp
        rw [Finset.mem_filter] at hp
        have hj_lt : (p.1 : ℕ) < m + 2 := by
          have hk := p.2.isLt
          omega
        have hj_last : p.1 ≠ Fin.last (m + 2) := by
          intro hl
          rw [hl, Fin.val_last] at hj_lt
          exact Nat.lt_irrefl _ hj_lt
        refine ⟨(p.1.castPred hj_last, p.2), ?_, Prod.ext (Fin.castSucc_castPred p.1 hj_last) rfl⟩
        rw [Finset.mem_filter]
        refine ⟨Finset.mem_univ _, ?_⟩
        dsimp only
        rw [Fin.le_def, Fin.coe_castPred]
        omega
    rw [h_lt, h_ge, ← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero (fun q hq => ?_)
    have hle : q.1 ≤ q.2 := (Finset.mem_filter.mp hq).2
    dsimp only [term]
    rw [cechFace_comp w m q.1 q.2 hle, ← add_smul]
    have hsign : (-1 : ℤ) ^ (q.2.succ : ℕ) * (-1 : ℤ) ^ (q.1 : ℕ) +
        (-1 : ℤ) ^ (q.1.castSucc : ℕ) * (-1 : ℤ) ^ (q.2 : ℕ) = 0 := by
      simp only [Fin.val_succ, Fin.val_castSucc, pow_succ]
      ring
    rw [hsign, zero_smul]

  have exact_of_app_ker_le_range :
      ∀ {Z : AlgebraicGeometry.Scheme.{u}}
        (S : CategoryTheory.ShortComplex ((Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u})),
        (∀ (T : (Z.Etale)ᵒᵖ) (z : S.X₂.obj T),
          S.g.app T z = 0 → ∃ x : S.X₁.obj T, S.f.app T x = z) →
        S.Exact := by
    intro Z S hpt
    rw [CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero]
    ext T : 2
    let ev := (CategoryTheory.evaluation (Z.Etale)ᵒᵖ AddCommGrpCat.{u}).obj T
    have hEx_T : (S.map ev).Exact := by
      rw [CategoryTheory.ShortComplex.ab_exact_iff_ker_le_range]
      intro z hz
      exact hpt T z hz
    have hkc_T : CategoryTheory.Limits.kernel.ι (S.g.app T) ≫
        CategoryTheory.Limits.cokernel.π (S.f.app T) = 0 :=
      (CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero (S.map ev)).mp hEx_T
    have hk_cond : (CategoryTheory.Limits.kernel.ι S.g).app T ≫ S.g.app T = 0 := by
      rw [← CategoryTheory.NatTrans.comp_app, CategoryTheory.Limits.kernel.condition,
        CategoryTheory.NatTrans.app_zero]
    have hc_cond : S.f.app T ≫ (CategoryTheory.Limits.cokernel.π S.f).app T = 0 := by
      rw [← CategoryTheory.NatTrans.comp_app, CategoryTheory.Limits.cokernel.condition,
        CategoryTheory.NatTrans.app_zero]
    let l_k := CategoryTheory.Limits.kernel.lift (S.g.app T)
      ((CategoryTheory.Limits.kernel.ι S.g).app T) hk_cond
    let d_c := CategoryTheory.Limits.cokernel.desc (S.f.app T)
      ((CategoryTheory.Limits.cokernel.π S.f).app T) hc_cond
    have hk_fac : (CategoryTheory.Limits.kernel.ι S.g).app T =
        l_k ≫ CategoryTheory.Limits.kernel.ι (S.g.app T) :=
      (CategoryTheory.Limits.kernel.lift_ι _ _ _).symm
    have hc_fac : (CategoryTheory.Limits.cokernel.π S.f).app T =
        CategoryTheory.Limits.cokernel.π (S.f.app T) ≫ d_c :=
      (CategoryTheory.Limits.cokernel.π_desc _ _ _).symm
    change (CategoryTheory.Limits.kernel.ι S.g).app T ≫
      (CategoryTheory.Limits.cokernel.π S.f).app T = 0
    rw [hk_fac, hc_fac, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc (CategoryTheory.Limits.kernel.ι (S.g.app T)) _ _,
      hkc_T, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  have hEx_psh : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      (CategoryTheory.ShortComplex.mk (d_psh Z w 0) (ε_psh Z w) (hd_psh₀ Z w)).Exact ∧
      ∀ m : ℕ, (CategoryTheory.ShortComplex.mk (d_psh Z w (m + 1)) (d_psh Z w m) (hd_psh_succ Z w m)).Exact := by
    intro Z W w
    let pick : ∀ {T₀ : Z.Etale} (y : T₀ ⟶ T_Z Z),
        Nonempty { f : T₀ ⟶ W // f ≫ w = y } → (T₀ ⟶ W) :=
      fun _ h => (Classical.choice h).1
    have pick_spec : ∀ {T₀ : Z.Etale} (y : T₀ ⟶ T_Z Z)
        (h : Nonempty { f : T₀ ⟶ W // f ≫ w = y }), pick y h ≫ w = y :=
      fun _ h => (Classical.choice h).2
    have pick_congr : ∀ {T₀ : Z.Etale} {y₁ y₂ : T₀ ⟶ T_Z Z} (hy : y₁ = y₂)
        (h₁ : Nonempty { f : T₀ ⟶ W // f ≫ w = y₁ })
        (h₂ : Nonempty { f : T₀ ⟶ W // f ≫ w = y₂ }),
        pick y₁ h₁ = pick y₂ h₂ := by
      intro T₀ y₁ y₂ hy h₁ h₂
      subst hy
      rfl
    let h_fib_ne : ∀ {T₀ : Z.Etale} (p : ℕ) (g : T₀ ⟶ weilEtaleCechObj w p),
        Nonempty { f : T₀ ⟶ W // f ≫ w = g ≫ weilEtaleCechHom w p } :=
      fun p g => ⟨⟨g ≫ weilEtaleCechProj w p 0,
        by rw [CategoryTheory.Category.assoc, (weilEtaleCechProjSub w p 0).2]⟩⟩
    let prepend : ∀ {T₀ : Z.Etale} (p : ℕ) (g : T₀ ⟶ weilEtaleCechObj w p),
        T₀ ⟶ weilEtaleCechObj w (p + 1) :=
      fun p g =>
        (weilEtaleCechLiftSub w (g ≫ weilEtaleCechHom w p) (p + 1)
          (Fin.cases (pick (g ≫ weilEtaleCechHom w p) (h_fib_ne p g))
            (fun i => g ≫ weilEtaleCechProj w p i))
          (fun k => Fin.cases
            (by rw [Fin.cases_zero]; exact pick_spec (g ≫ weilEtaleCechHom w p) (h_fib_ne p g))
            (fun i => by
              rw [Fin.cases_succ, CategoryTheory.Category.assoc, (weilEtaleCechProjSub w p i).2]) k)).1
    have prepend_face_zero : ∀ {T₀ : Z.Etale} (p : ℕ) (g : T₀ ⟶ weilEtaleCechObj w p),
        prepend p g ≫ weilEtaleCechFace w p 0 = g := by
      intro T₀ p g
      apply cechObj_hom_ext
      intro i
      rw [CategoryTheory.Category.assoc, cechFace_proj, Fin.succAbove_zero]
      dsimp only [prepend]
      rw [cechLift_proj, Fin.cases_succ]
    refine ⟨?_, fun m => ?_⟩
    · refine exact_of_app_ker_le_range _ (fun T z hz => ?_)
      let T₀ := Opposite.unop T
      let σ : (Z_psh Z (T_Z Z)).obj T ⟶ (Z_psh Z (weilEtaleCechObj w 0)).obj T :=
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun y : T₀ ⟶ T_Z Z =>
          @dite _ (Nonempty { f : T₀ ⟶ W // f ≫ w = y }) (Classical.propDecidable _)
            (fun h => of_psh (show T₀ ⟶ weilEtaleCechObj w 0 from pick y h)) (fun _ => 0)))
      let s₀ : (Z_psh Z (weilEtaleCechObj w 0)).obj T ⟶ (Z_psh Z (weilEtaleCechObj w 1)).obj T :=
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift
          (fun g : T₀ ⟶ weilEtaleCechObj w 0 => of_psh (prepend 0 g)))
      have h_homotopy₀ :
          s₀ ≫ (d_psh Z w 0).app T + (ε_psh Z w).app T ≫ σ =
            𝟙 ((Z_psh Z (weilEtaleCechObj w 0)).obj T) := by
        refine z_psh_hom_ext _ _ (fun g => ?_)
        change ((d_psh Z w 0).app T) (s₀ (of_psh g)) +
          σ (((ε_psh Z w).app T) (of_psh g)) = of_psh g
        have hs₀_of : s₀ (of_psh g) = of_psh (prepend 0 g) :=
          FreeAbelianGroup.lift_apply_of _ g
        rw [hs₀_of, d_psh_apply_of Z w 0 T (prepend 0 g), Fin.sum_univ_two]
        let p₀ : T₀ ⟶ weilEtaleCechObj w 0 := pick (g ≫ weilEtaleCechHom w 0) (h_fib_ne 0 g)
        have hface0 : prepend 0 g ≫ weilEtaleCechFace w 0 0 = g := prepend_face_zero 0 g
        have hface1 : prepend 0 g ≫ weilEtaleCechFace w 0 1 = p₀ := by
          apply cechObj_hom_ext
          intro i
          obtain rfl : i = 0 := Fin.eq_zero i
          rw [CategoryTheory.Category.assoc, cechFace_proj]
          have hsa : (1 : Fin 2).succAbove 0 = 0 := rfl
          rw [hsa]
          dsimp only [prepend, p₀]
          rw [cechLift_proj, Fin.cases_zero]
          exact (CategoryTheory.Category.comp_id _).symm
        have hσ : σ (((ε_psh Z w).app T) (of_psh g)) = of_psh p₀ := by
          have hmap : ((ε_psh Z w).app T) (of_psh g) = of_psh (g ≫ weilEtaleCechHom w 0) :=
            FreeAbelianGroup.map_of_apply g
          rw [hmap]
          exact (FreeAbelianGroup.lift_apply_of _ (g ≫ weilEtaleCechHom w 0)).trans
            (dite_cond_eq_true (eq_true (h_fib_ne 0 g)))
        rw [hface0, hface1, hσ, Fin.val_zero, Fin.val_one,
          pow_zero, pow_one, one_smul, neg_one_smul, add_assoc, neg_add_cancel, add_zero]
      refine ⟨s₀ z, ?_⟩
      have hid := congrArg
        (fun f : (Z_psh Z (weilEtaleCechObj w 0)).obj T ⟶ (Z_psh Z (weilEtaleCechObj w 0)).obj T => f z)
        h_homotopy₀
      change ((d_psh Z w 0).app T) (s₀ z) + σ (((ε_psh Z w).app T) z) = z at hid
      rw [hz, map_zero, add_zero] at hid
      exact hid
    · refine exact_of_app_ker_le_range _ (fun T z hz => ?_)
      let T₀ := Opposite.unop T
      let s_m : (Z_psh Z (weilEtaleCechObj w m)).obj T ⟶
          (Z_psh Z (weilEtaleCechObj w (m + 1))).obj T :=
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift
          (fun f : T₀ ⟶ weilEtaleCechObj w m => of_psh (prepend m f)))
      let s_m1 : (Z_psh Z (weilEtaleCechObj w (m + 1))).obj T ⟶
          (Z_psh Z (weilEtaleCechObj w (m + 2))).obj T :=
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift
          (fun g : T₀ ⟶ weilEtaleCechObj w (m + 1) => of_psh (prepend (m + 1) g)))
      have h_homotopy_m :
          s_m1 ≫ (d_psh Z w (m + 1)).app T + (d_psh Z w m).app T ≫ s_m =
            𝟙 ((Z_psh Z (weilEtaleCechObj w (m + 1))).obj T) := by
        refine z_psh_hom_ext _ _ (fun g => ?_)
        change ((d_psh Z w (m + 1)).app T) (s_m1 (of_psh g)) +
          s_m (((d_psh Z w m).app T) (of_psh g)) = of_psh g
        have hs_m1_of : s_m1 (of_psh g) = of_psh (prepend (m + 1) g) :=
          FreeAbelianGroup.lift_apply_of _ g
        rw [hs_m1_of, d_psh_apply_of Z w (m + 1) T (prepend (m + 1) g),
          Fin.sum_univ_succ, prepend_face_zero (m + 1) g, Fin.val_zero, pow_zero, one_smul]
        have hface_succ : ∀ k : Fin (m + 2),
            prepend (m + 1) g ≫ weilEtaleCechFace w (m + 1) k.succ =
              prepend m (g ≫ weilEtaleCechFace w m k) := by
          intro k
          apply cechObj_hom_ext
          intro i
          rw [CategoryTheory.Category.assoc, cechFace_proj]
          refine Fin.cases ?_ (fun l => ?_) i
          · rw [Fin.succ_succAbove_zero]
            dsimp only [prepend]
            rw [cechLift_proj, cechLift_proj, Fin.cases_zero, Fin.cases_zero]
            refine pick_congr ?_ _ _
            rw [CategoryTheory.Category.assoc, cechFace_hom w m k]
          · rw [Fin.succ_succAbove_succ]
            dsimp only [prepend]
            rw [cechLift_proj, cechLift_proj, Fin.cases_succ, Fin.cases_succ,
              CategoryTheory.Category.assoc, cechFace_proj]
        have hsum_succ : (∑ k : Fin (m + 2), (-1 : ℤ) ^ (k.succ : ℕ) •
            of_psh (prepend (m + 1) g ≫ weilEtaleCechFace w (m + 1) k.succ)) =
            - s_m (((d_psh Z w m).app T) (of_psh g)) := by
          change _ = - s_m.hom (((d_psh Z w m).app T) (of_psh g))
          rw [d_psh_apply_of Z w m T g, map_sum, ← Finset.sum_neg_distrib]
          refine Finset.sum_congr rfl (fun k _ => ?_)
          rw [hface_succ k, map_zsmul]
          have hs_m_of : s_m.hom (of_psh (g ≫ weilEtaleCechFace w m k)) =
              of_psh (prepend m (g ≫ weilEtaleCechFace w m k)) :=
            FreeAbelianGroup.lift_apply_of _ _
          rw [hs_m_of, Fin.val_succ, pow_succ, mul_neg_one, neg_smul]
        rw [hsum_succ, add_assoc, neg_add_cancel, add_zero]
      refine ⟨s_m1 z, ?_⟩
      have hid := congrArg
        (fun f : (Z_psh Z (weilEtaleCechObj w (m + 1))).obj T ⟶
          (Z_psh Z (weilEtaleCechObj w (m + 1))).obj T => f z) h_homotopy_m
      change ((d_psh Z w (m + 1)).app T) (s_m1 z) + s_m (((d_psh Z w m).app T) z) = z at hid
      rw [hz, map_zero, add_zero] at hid
      exact hid

  
  let d_sh : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z) (p : ℕ),
      Z_sh Z (weilEtaleCechObj w (p + 1)) ⟶ Z_sh Z (weilEtaleCechObj w p) :=
    fun Z {_} w p => (L_sh Z).map (d_psh Z w p)

  let ε_rep : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      Z_sh Z (weilEtaleCechObj w 0) ⟶ Fℤ Z :=
    fun Z {_} w => Z_sh_map (weilEtaleCechHom w 0) ≫ toConst Z

  have d_sh_comp_shHom : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale}
      (w : W ⟶ T_Z Z) (p : ℕ)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (s : F.obj.obj (Opposite.op (weilEtaleCechObj w p))),
      d_sh Z w p ≫ shHom Z (weilEtaleCechObj w p) F s =
        shHom Z (weilEtaleCechObj w (p + 1)) F
          (∑ j : Fin (p + 2), (-1 : ℤ) ^ (j : ℕ) •
            F.obj.map (weilEtaleCechFace w p j).op s) := by
    intro Z W w p F s
    dsimp only [d_sh, shHom]
    rw [← CategoryTheory.Adjunction.homEquiv_naturality_left_symm
      (shAdj Z) (d_psh Z w p) (pshHom Z (weilEtaleCechObj w p) F s)]
    congr 1
    ext T : 2
    refine z_psh_hom_ext _ _ (fun g => ?_)
    change ((pshHom Z (weilEtaleCechObj w p) F s).app T).hom
        (((d_psh Z w p).app T) (of_psh g)) =
      FreeAbelianGroup.lift
        (fun h : Opposite.unop T ⟶ weilEtaleCechObj w (p + 1) =>
          F.obj.map h.op (∑ j : Fin (p + 2), (-1 : ℤ) ^ (j : ℕ) •
            F.obj.map (weilEtaleCechFace w p j).op s)) (of_psh g)
    rw [d_psh_apply_of Z w p T g, map_sum, FreeAbelianGroup.lift_apply_of, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_zsmul, map_zsmul]
    congr 1
    change FreeAbelianGroup.lift (fun h : Opposite.unop T ⟶ weilEtaleCechObj w p => F.obj.map h.op s)
        (of_psh (g ≫ weilEtaleCechFace w p j)) =
      F.obj.map g.op (F.obj.map (weilEtaleCechFace w p j).op s)
    rw [FreeAbelianGroup.lift_apply_of, CategoryTheory.op_comp, F.obj.map_comp]
    rfl

  have d_sh_eq_sum : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale}
      (w : W ⟶ T_Z Z) (p : ℕ),
      d_sh Z w p =
        ∑ j : Fin (p + 2), (-1 : ℤ) ^ (j : ℕ) • Z_sh_map (weilEtaleCechFace w p j) := by
    intro Z W w p
    have hid := d_sh_comp_shHom Z w p (Z_sh Z (weilEtaleCechObj w p))
      (secOf Z (weilEtaleCechObj w p) _ (𝟙 _))
    rw [shHom_secOf, CategoryTheory.Category.comp_id] at hid
    rw [hid, shHom_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [shHom_zsmul, ← map_comp_shHom, shHom_secOf, CategoryTheory.Category.comp_id]

  have d_sh_comp_gmHom : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale}
      (w : W ⟶ T_Z Z) (p : ℕ)
      (s : ↥((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w p)))),
      d_sh Z w p ≫ gmHom Z (weilEtaleCechObj w p) s =
        gmHom Z (weilEtaleCechObj w (p + 1)) (weilEtaleCechDiff (weilEtaleGmPresheaf Z) w p s) := by
    intro Z W w p s
    rw [d_sh_eq_sum, CategoryTheory.Preadditive.sum_comp]
    dsimp only [weilEtaleCechDiff]
    rw [addHom_sum_apply, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [CategoryTheory.Preadditive.zsmul_comp, addHom_zsmul_apply, map_zsmul, map_comp_gmHom]

  have hEpi_ε_rep : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.Etale)
      (w : W ⟶ T_Z Z),
      AlgebraicGeometry.Surjective w.left →
      CategoryTheory.Epi (ε_rep Z w) := by
    intro Z W w hw
    have hEpi_w : CategoryTheory.Epi (Z_sh_map w) := by
      refine ⟨fun {G} h₁ h₂ heq => ?_⟩
      let s₁ := secOf Z (T_Z Z) G h₁
      let s₂ := secOf Z (T_Z Z) G h₂
      have hw_s : G.obj.map w.op s₁ = G.obj.map w.op s₂ := by
        have hsec := congrArg (secOf Z W G) heq
        rwa [secOf_map_comp, secOf_map_comp] at hsec
      have : AlgebraicGeometry.Etale (T_Z Z).hom := (T_Z Z).prop
      have hw_comp_et : AlgebraicGeometry.Etale (w.left ≫ (T_Z Z).hom) :=
        Eq.mp (congrArg AlgebraicGeometry.Etale (CategoryTheory.MorphismProperty.Over.w w).symm) W.prop
      have hEt_w : AlgebraicGeometry.Etale w.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          w.left (T_Z Z).hom (T_Z Z).prop hw_comp_et
      let S_w : CategoryTheory.Sieve (T_Z Z) :=
        CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton w)
      have hSw_pre : S_w ∈ Z.smallEtalePretopology.toGrothendieck (T_Z Z) := by
        refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := Z) (T_Z Z) S_w).mpr
          (fun x => ?_)
        obtain ⟨y, hy⟩ := hw.surj x
        refine ⟨W, w, y, ?_, hEt_w, hy⟩
        exact ⟨W, 𝟙 W, w, CategoryTheory.Presieve.singleton.mk, CategoryTheory.Category.id_comp w⟩
      have hSw : S_w ∈ Z.smallEtaleTopology (T_Z Z) := heq_top Z ▸ hSw_pre
      have hSh_G := hIsSheafType Z G S_w hSw
      have hs_eq : s₁ = s₂ := by
        refine hSh_G.isSeparatedFor.ext (fun T f hf => ?_)
        obtain ⟨_, g, _, ⟨⟩, rfl⟩ := hf
        change G.obj.map (g ≫ w).op s₁ = G.obj.map (g ≫ w).op s₂
        rw [CategoryTheory.op_comp, G.obj.map_comp]
        exact congrArg (G.obj.map g.op) hw_s
      exact secOf_inj Z (T_Z Z) G hs_eq
    have : CategoryTheory.IsIso (toConst Z) := hIso_toConst Z
    change CategoryTheory.Epi (Z_sh_map w ≫ toConst Z)
    exact CategoryTheory.epi_comp (Z_sh_map w) (toConst Z)

  let K₁_im : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
    fun Z {_} w => CategoryTheory.Limits.image (d_sh Z w 0)
  let f₀_im : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      K₁_im Z w ⟶ Z_sh Z (weilEtaleCechObj w 0) :=
    fun Z {_} w => CategoryTheory.Limits.image.ι (d_sh Z w 0)
  let e₀_im : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      Z_sh Z (weilEtaleCechObj w 1) ⟶ K₁_im Z w :=
    fun Z {_} w => CategoryTheory.Limits.factorThruImage (d_sh Z w 0)
  let K₂_im : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
    fun Z {_} w => CategoryTheory.Limits.image (d_sh Z w 1)
  let f₁_im : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      K₂_im Z w ⟶ Z_sh Z (weilEtaleCechObj w 1) :=
    fun Z {_} w => CategoryTheory.Limits.image.ι (d_sh Z w 1)
  let e₁_im : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      Z_sh Z (weilEtaleCechObj w 2) ⟶ K₂_im Z w :=
    fun Z {_} w => CategoryTheory.Limits.factorThruImage (d_sh Z w 1)

  have hd_sh₀ : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      d_sh Z w 0 ≫ ε_rep Z w = 0 := by
    intro Z W w
    dsimp only [d_sh, ε_rep, Z_sh_map]
    rw [← CategoryTheory.Category.assoc, ← (L_sh Z).map_comp,
      show d_psh Z w 0 ≫ Z_psh_map (weilEtaleCechHom w 0) = d_psh Z w 0 ≫ ε_psh Z w from rfl,
      hd_psh₀ Z w, (L_sh Z).map_zero, CategoryTheory.Limits.zero_comp]

  have hd_sh₁ : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      d_sh Z w 1 ≫ d_sh Z w 0 = 0 := by
    intro Z W w
    dsimp only [d_sh]
    rw [← (L_sh Z).map_comp, hd_psh_succ Z w 0, (L_sh Z).map_zero]

  have h₀_w : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      f₀_im Z w ≫ ε_rep Z w = 0 := by
    intro Z W w
    have : CategoryTheory.Epi (e₀_im Z w) := by dsimp only [e₀_im]; infer_instance
    apply (CategoryTheory.cancel_epi (e₀_im Z w)).mp
    rw [CategoryTheory.Limits.comp_zero, ← CategoryTheory.Category.assoc,
      CategoryTheory.Limits.image.fac (d_sh Z w 0), hd_sh₀ Z w]

  have hfg_w : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      f₁_im Z w ≫ e₀_im Z w = 0 := by
    intro Z W w
    have : CategoryTheory.Mono (f₀_im Z w) := by dsimp only [f₀_im]; infer_instance
    have : CategoryTheory.Epi (e₁_im Z w) := by dsimp only [e₁_im]; infer_instance
    apply (CategoryTheory.cancel_mono (f₀_im Z w)).mp
    apply (CategoryTheory.cancel_epi (e₁_im Z w)).mp
    rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero,
      CategoryTheory.Category.assoc, CategoryTheory.Limits.image.fac (d_sh Z w 0),
      ← CategoryTheory.Category.assoc, CategoryTheory.Limits.image.fac (d_sh Z w 1),
      hd_sh₁ Z w]

  have hSE_w : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.Etale)
      (w : W ⟶ T_Z Z) (hw : AlgebraicGeometry.Surjective w.left),
      (CategoryTheory.ShortComplex.mk (f₀_im Z w) (ε_rep Z w) (h₀_w Z w)).ShortExact := by
    intro Z W w hw
    have hf_mono : CategoryTheory.Mono (f₀_im Z w) := by dsimp only [f₀_im]; infer_instance
    have he_epi : CategoryTheory.Epi (e₀_im Z w) := by dsimp only [e₀_im]; infer_instance
    have : CategoryTheory.IsIso (toConst Z) := hIso_toConst Z
    have hd_raw : (L_sh Z).map (d_psh Z w 0) ≫ (L_sh Z).map (ε_psh Z w) = 0 := by
      rw [← (L_sh Z).map_comp, hd_psh₀ Z w, (L_sh Z).map_zero]
    have hEx_raw : (CategoryTheory.ShortComplex.mk
        ((L_sh Z).map (d_psh Z w 0)) ((L_sh Z).map (ε_psh Z w)) hd_raw).Exact :=
      (hEx_psh Z w).1.map (L_sh Z)
    let S_raw := CategoryTheory.ShortComplex.mk
      ((L_sh Z).map (d_psh Z w 0)) ((L_sh Z).map (ε_psh Z w)) hd_raw
    let S₀ := CategoryTheory.ShortComplex.mk (f₀_im Z w) (ε_rep Z w) (h₀_w Z w)
    let φ₀ : S_raw ⟶ S₀ :=
      { τ₁ := e₀_im Z w
        τ₂ := 𝟙 (Z_sh Z (weilEtaleCechObj w 0))
        τ₃ := toConst Z
        comm₁₂ := by
          dsimp only [S_raw, S₀, e₀_im, f₀_im, d_sh]
          rw [CategoryTheory.Category.comp_id, CategoryTheory.Limits.image.fac]
        comm₂₃ := by
          dsimp only [S_raw, S₀, ε_rep, Z_sh_map, ε_psh]
          exact CategoryTheory.Category.id_comp _ }
    have : CategoryTheory.Epi φ₀.τ₁ := he_epi
    have : CategoryTheory.IsIso φ₀.τ₂ := by dsimp only [φ₀]; infer_instance
    have : CategoryTheory.Mono φ₀.τ₃ := by dsimp only [φ₀]; infer_instance
    have hEx₀ : S₀.Exact :=
      (CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ₀).mp hEx_raw
    exact CategoryTheory.ShortComplex.ShortExact.mk' hEx₀ hf_mono (hEpi_ε_rep Z W w hw)

  have hSE_syz : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale} (w : W ⟶ T_Z Z),
      (CategoryTheory.ShortComplex.mk (f₁_im Z w) (e₀_im Z w) (hfg_w Z w)).ShortExact := by
    intro Z W w
    have hf₀_mono : CategoryTheory.Mono (f₀_im Z w) := by dsimp only [f₀_im]; infer_instance
    have hf₁_mono : CategoryTheory.Mono (f₁_im Z w) := by dsimp only [f₁_im]; infer_instance
    have he₀_epi : CategoryTheory.Epi (e₀_im Z w) := by dsimp only [e₀_im]; infer_instance
    have he₁_epi : CategoryTheory.Epi (e₁_im Z w) := by dsimp only [e₁_im]; infer_instance
    have hEx_raw : (CategoryTheory.ShortComplex.mk (d_sh Z w 1) (d_sh Z w 0) (hd_sh₁ Z w)).Exact :=
      ((hEx_psh Z w).2 0).map (L_sh Z)
    have hd_mid : f₁_im Z w ≫ d_sh Z w 0 = 0 := by
      apply (CategoryTheory.cancel_epi (e₁_im Z w)).mp
      rw [CategoryTheory.Limits.comp_zero, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.image.fac (d_sh Z w 1), hd_sh₁ Z w]
    let S_raw := CategoryTheory.ShortComplex.mk (d_sh Z w 1) (d_sh Z w 0) (hd_sh₁ Z w)
    let S_mid := CategoryTheory.ShortComplex.mk (f₁_im Z w) (d_sh Z w 0) hd_mid
    let S_syz := CategoryTheory.ShortComplex.mk (f₁_im Z w) (e₀_im Z w) (hfg_w Z w)
    let ψ₁ : S_raw ⟶ S_mid :=
      { τ₁ := e₁_im Z w
        τ₂ := 𝟙 (Z_sh Z (weilEtaleCechObj w 1))
        τ₃ := 𝟙 (Z_sh Z (weilEtaleCechObj w 0))
        comm₁₂ := by
          dsimp only [S_raw, S_mid, e₁_im, f₁_im]
          rw [CategoryTheory.Category.comp_id, CategoryTheory.Limits.image.fac]
        comm₂₃ := by
          dsimp only [S_raw, S_mid]
          rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp] }
    let ψ₂ : S_syz ⟶ S_mid :=
      { τ₁ := 𝟙 (K₂_im Z w)
        τ₂ := 𝟙 (Z_sh Z (weilEtaleCechObj w 1))
        τ₃ := f₀_im Z w
        comm₁₂ := by
          dsimp only [S_syz, S_mid]
          rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        comm₂₃ := by
          dsimp only [S_syz, S_mid, e₀_im, f₀_im]
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Limits.image.fac] }
    have : CategoryTheory.Epi ψ₁.τ₁ := he₁_epi
    have : CategoryTheory.IsIso ψ₁.τ₂ := by dsimp only [ψ₁]; infer_instance
    have : CategoryTheory.Mono ψ₁.τ₃ := by dsimp only [ψ₁]; infer_instance
    have : CategoryTheory.Epi ψ₂.τ₁ := by dsimp only [ψ₂]; infer_instance
    have : CategoryTheory.IsIso ψ₂.τ₂ := by dsimp only [ψ₂]; infer_instance
    have : CategoryTheory.Mono ψ₂.τ₃ := hf₀_mono
    have hEx_mid : S_mid.Exact :=
      (CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono ψ₁).mp hEx_raw
    have hEx_syz : S_syz.Exact :=
      (CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono ψ₂).mpr hEx_mid
    exact CategoryTheory.ShortComplex.ShortExact.mk' hEx_syz hf₁_mono he₀_epi

  
  have hExist_cbar : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale}
      (w : W ⟶ T_Z Z) (c : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker),
      ∃ cb : K₁_im Z w ⟶ weilEtaleGmSheaf Z,
        e₀_im Z w ≫ cb = gmHom Z (weilEtaleCechObj w 1) c.1 := by
    intro Z W w c
    let φ_c := gmHom Z (weilEtaleCechObj w 1) c.1
    have hd₁_φ : d_sh Z w 1 ≫ φ_c = 0 := by
      dsimp only [φ_c]
      rw [d_sh_comp_gmHom, c.2, map_zero]
    have : CategoryTheory.Epi (e₁_im Z w) := by dsimp only [e₁_im]; infer_instance
    have hf₁_φ : f₁_im Z w ≫ φ_c = 0 := by
      apply (CategoryTheory.cancel_epi (e₁_im Z w)).mp
      rw [CategoryTheory.Limits.comp_zero, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.image.fac (d_sh Z w 1), hd₁_φ]
    have h_ext0 : (CategoryTheory.Abelian.Ext.mk₀ (f₁_im Z w)).comp
        (CategoryTheory.Abelian.Ext.mk₀ φ_c) (Nat.zero_add 0) = 0 := by
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hf₁_φ, CategoryTheory.Abelian.Ext.mk₀_zero]
    obtain ⟨x₁, hx₁⟩ :=
      CategoryTheory.Abelian.Ext.contravariant_sequence_exact₂
        (hSE_syz Z w) (weilEtaleGmSheaf Z) (CategoryTheory.Abelian.Ext.mk₀ φ_c) h_ext0
    obtain ⟨cb, rfl⟩ :=
      (CategoryTheory.Abelian.Ext.mk₀_bijective (K₁_im Z w) (weilEtaleGmSheaf Z)).2 x₁
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hx₁
    exact ⟨cb, (CategoryTheory.Abelian.Ext.mk₀_bijective _ _).1 hx₁⟩

  let c_bar : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale}
      (w : W ⟶ T_Z Z) (c : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker),
      K₁_im Z w ⟶ weilEtaleGmSheaf Z :=
    fun Z {_} w c => Classical.choose (hExist_cbar Z w c)

  have hc_bar : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale}
      (w : W ⟶ T_Z Z) (c : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker),
      e₀_im Z w ≫ c_bar Z w c = gmHom Z (weilEtaleCechObj w 1) c.1 :=
    fun Z {_} w c => Classical.choose_spec (hExist_cbar Z w c)

  have c_bar_eq_of : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W : Z.Etale}
      (w : W ⟶ T_Z Z) (c : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker)
      (cb : K₁_im Z w ⟶ weilEtaleGmSheaf Z),
      e₀_im Z w ≫ cb = gmHom Z (weilEtaleCechObj w 1) c.1 →
      cb = c_bar Z w c := by
    intro Z W w c cb hcb
    have : CategoryTheory.Epi (e₀_im Z w) := by dsimp only [e₀_im]; infer_instance
    exact (CategoryTheory.cancel_epi (e₀_im Z w)).mp (hcb.trans (hc_bar Z w c).symm)

  let cechCl : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.Etale)
      (w : W ⟶ weilEtaleIdTerminal.{u} Z),
      AlgebraicGeometry.Surjective w.left →
      ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker →+ (weilEtaleGmSheaf Z).H 1 :=
    fun Z W w hw =>
      { toFun := fun c =>
          (hSE_w Z W w hw).extClass.comp
            (CategoryTheory.Abelian.Ext.mk₀ (c_bar Z w c)) (Nat.add_zero 1)
        map_zero' := by
          have h0 : (0 : K₁_im Z w ⟶ weilEtaleGmSheaf Z) = c_bar Z w 0 := by
            apply c_bar_eq_of
            rw [CategoryTheory.Limits.comp_zero, AddSubgroup.coe_zero, map_zero]
          rw [← h0, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
        map_add' := fun c₁ c₂ => by
          have hadd : c_bar Z w c₁ + c_bar Z w c₂ = c_bar Z w (c₁ + c₂) := by
            apply c_bar_eq_of
            rw [CategoryTheory.Preadditive.comp_add, hc_bar, hc_bar,
              AddSubgroup.coe_add, map_add]
          rw [← hadd, CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.comp_add] }

  
  have hLift_cech : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.Etale)
      (w : W ⟶ T_Z Z) (hw : AlgebraicGeometry.Surjective w.left)
      (ξ : (weilEtaleGmSheaf Z).H 1),
      (CategoryTheory.Abelian.Ext.mk₀ (ε_rep Z w)).comp ξ (Nat.zero_add 1) = 0 →
      ∃ c : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker,
        cechCl Z W w hw c = ξ := by
    intro Z W w hw ξ hkill
    obtain ⟨x₁, hx₁⟩ :=
      CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃
        (hSE_w Z W w hw) (weilEtaleGmSheaf Z) ξ hkill (Nat.add_zero 1)
    obtain ⟨cb, rfl⟩ :=
      (CategoryTheory.Abelian.Ext.mk₀_bijective (K₁_im Z w) (weilEtaleGmSheaf Z)).2 x₁
    let c_raw := gmSec Z (weilEtaleCechObj w 1) (e₀_im Z w ≫ cb)
    have hc_raw_hom : gmHom Z (weilEtaleCechObj w 1) c_raw = e₀_im Z w ≫ cb :=
      gmHom_gmSec Z (weilEtaleCechObj w 1) (e₀_im Z w ≫ cb)
    have hc_ker : c_raw ∈ (weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker := by
      rw [AddMonoidHom.mem_ker]
      apply gmHom_inj Z (weilEtaleCechObj w 2)
      rw [map_zero, ← d_sh_comp_gmHom, hc_raw_hom, ← CategoryTheory.Category.assoc]
      have hd₁e : d_sh Z w 1 ≫ e₀_im Z w = 0 := by
        rw [← CategoryTheory.Limits.image.fac (d_sh Z w 1), CategoryTheory.Category.assoc,
          hfg_w Z w, CategoryTheory.Limits.comp_zero]
      rw [hd₁e, CategoryTheory.Limits.zero_comp]
    let c : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker := ⟨c_raw, hc_ker⟩
    have hcb_eq : cb = c_bar Z w c := c_bar_eq_of Z w c cb hc_raw_hom.symm
    refine ⟨c, ?_⟩
    dsimp only [cechCl, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    rw [← hcb_eq]
    exact hx₁

  
  have hAffEff : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (S : Type u) [CommRing S]
      (j : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶ Z) [AlgebraicGeometry.Etale j]
      (ξ : (weilEtaleGmSheaf Z).H 1),
      ∃ (T : Type u) (_ : CommRing T) (_ : Algebra S T) (_ : Algebra.Etale S T),
        AlgebraicGeometry.Surjective
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S T))) ∧
        let g_T := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S T)) ≫ j
        ∃ (hEt_T : AlgebraicGeometry.Etale g_T),
          let U_T : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ g_T hEt_T
          let u_T : U_T ⟶ T_Z Z := (hT_Z Z).from U_T
          (CategoryTheory.Abelian.Ext.mk₀ (ε_rep Z u_T)).comp ξ (Nat.zero_add 1) = 0 := by
    intro Z S _ j _ ξ
    let E : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ j inferInstance
    let t_E : E ⟶ T_Z Z := (hT_Z Z).from E
    let G := weilEtaleGmSheaf Z
    let ζ : CategoryTheory.Abelian.Ext (Z_sh Z E) G 1 :=
      (CategoryTheory.Abelian.Ext.mk₀ (ε_rep Z t_E)).comp ξ (Nat.zero_add 1)
    let I_sh : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
      CategoryTheory.Injective.under G
    let u_G : G ⟶ I_sh := CategoryTheory.Injective.ι G
    let Q_sh := CategoryTheory.Limits.cokernel u_G
    let p_G : I_sh ⟶ Q_sh := CategoryTheory.Limits.cokernel.π u_G
    have hSE_G : (CategoryTheory.ShortComplex.mk u_G p_G
        (CategoryTheory.Limits.cokernel.condition u_G)).ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel _
          (CategoryTheory.Limits.cokernelIsCokernel u_G))
        inferInstance inferInstance
    have hζ_u : ζ.comp (CategoryTheory.Abelian.Ext.mk₀ u_G) (Nat.add_zero 1) = 0 :=
      CategoryTheory.Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x_Q, hx_Q⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (Z_sh Z E) hSE_G ζ hζ_u (Nat.zero_add 1)
    obtain ⟨φ_Q, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective (Z_sh Z E) Q_sh).2 x_Q
    let q_sec : Q_sh.obj.obj (Opposite.op E) := secOf Z E Q_sh φ_Q
    have : CategoryTheory.Epi p_G := inferInstance
    have : CategoryTheory.Sheaf.IsLocallySurjective p_G :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' (φ := p_G)).mpr inferInstance
    have hImg_top : CategoryTheory.Presheaf.imageSieve p_G.hom q_sec ∈ Z.smallEtaleTopology E :=
      CategoryTheory.Presheaf.imageSieve_mem Z.smallEtaleTopology p_G.hom q_sec
    have hImg_pre : CategoryTheory.Presheaf.imageSieve p_G.hom q_sec ∈
        Z.smallEtalePretopology.toGrothendieck E := heq_top Z ▸ hImg_top
