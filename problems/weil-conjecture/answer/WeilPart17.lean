    obtain ⟨c_bar, hc_bar⟩ := Ideal.mem_span_singleton.mp hπ₀_e'_sub
    obtain ⟨c, rfl⟩ := hπ₀_surj c_bar
    let e : D.R₀ := e' + g * c
    have he_red : π₀ e = e₀ := by
      dsimp [e]
      rw [map_add, map_mul, hg_red, ← hc_bar]
      ring
    have hspan_eq : Ideal.span {e, g} = Ideal.span {e', g} := by
