  let adj_tot := (CategoryTheory.Adjunction.whiskerRight (Y.Etale)ᵒᵖ AddCommGrpCat.adj).comp
    (CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u})
  have hEfface : ∀ (E : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
