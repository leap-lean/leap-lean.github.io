    · have cocycle_mul : ∀ (E F : WeilTwoChartLineBundle D)
          (e₀ : TensorProduct D.R₀ T₀ E.L₀ ≃ₗ[T₀] T₀)
          (e₁ : TensorProduct D.R₁ T₁ E.L₁ ≃ₗ[T₁] T₁)
          (f₀ : TensorProduct D.R₀ T₀ F.L₀ ≃ₗ[T₀] T₀)
          (f₁ : TensorProduct D.R₁ T₁ F.L₁ ≃ₗ[T₁] T₁)
          (q_E q_F : WeilTwoChartUnitQuad D T₀ T₁),
          WeilIsTwoChartBundleCocycle D E T₀ T₁ e₀ e₁ q_E →
          WeilIsTwoChartBundleCocycle D F T₀ T₁ f₀ f₁ q_F →
          ∃ (ef₀ : TensorProduct D.R₀ T₀ (WeilTwoChartMul D E F).L₀ ≃ₗ[T₀] T₀)
            (ef₁ : TensorProduct D.R₁ T₁ (WeilTwoChartMul D E F).L₁ ≃ₗ[T₁] T₁),
            WeilIsTwoChartBundleCocycle D (WeilTwoChartMul D E F) T₀ T₁ ef₀ ef₁
              (weilTwoChartQuadMul q_E q_F) := by
        intro E F e₀ e₁ f₀ f₁ q_E q_F ⟨hE₀₀, hE₁₁, hE₀₁, hE₁₀⟩ ⟨hF₀₀, hF₁₁, hF₀₁, hF₁₀⟩
        let ef₀ : TensorProduct D.R₀ T₀ (TensorProduct D.R₀ E.L₀ F.L₀) ≃ₗ[T₀] T₀ :=
          (TensorProduct.AlgebraTensorModule.distribBaseChange D.R₀ T₀ E.L₀ F.L₀).trans
            ((TensorProduct.AlgebraTensorModule.congr e₀ f₀).trans
              (TensorProduct.AlgebraTensorModule.rid T₀ T₀ T₀))
        let ef₁ : TensorProduct D.R₁ T₁ (TensorProduct D.R₁ E.L₁ F.L₁) ≃ₗ[T₁] T₁ :=
          (TensorProduct.AlgebraTensorModule.distribBaseChange D.R₁ T₁ E.L₁ F.L₁).trans
            ((TensorProduct.AlgebraTensorModule.congr e₁ f₁).trans
              (TensorProduct.AlgebraTensorModule.rid T₁ T₁ T₁))
        let σE₀ : E.L₀ →ₗ[D.R₀] T₀ := e₀.toLinearMap.restrictScalars D.R₀ ∘ₗ TensorProduct.mk D.R₀ T₀ E.L₀ 1
        let σE₁ : E.L₁ →ₗ[D.R₁] T₁ := e₁.toLinearMap.restrictScalars D.R₁ ∘ₗ TensorProduct.mk D.R₁ T₁ E.L₁ 1
        let σF₀ : F.L₀ →ₗ[D.R₀] T₀ := f₀.toLinearMap.restrictScalars D.R₀ ∘ₗ TensorProduct.mk D.R₀ T₀ F.L₀ 1
        let σF₁ : F.L₁ →ₗ[D.R₁] T₁ := f₁.toLinearMap.restrictScalars D.R₁ ∘ₗ TensorProduct.mk D.R₁ T₁ F.L₁ 1
        let σEF₀ : TensorProduct D.R₀ E.L₀ F.L₀ →ₗ[D.R₀] T₀ :=
          ef₀.toLinearMap.restrictScalars D.R₀ ∘ₗ TensorProduct.mk D.R₀ T₀ _ 1
        let σEF₁ : TensorProduct D.R₁ E.L₁ F.L₁ →ₗ[D.R₁] T₁ :=
          ef₁.toLinearMap.restrictScalars D.R₁ ∘ₗ TensorProduct.mk D.R₁ T₁ _ 1
        have hσEF₀ : ∀ (x : E.L₀) (y : F.L₀), σEF₀ (x ⊗ₜ[D.R₀] y) = σE₀ x * σF₀ y := by
          intro x y
          dsimp [σEF₀, ef₀, σE₀, σF₀]
          simp [mul_comm]
        have hσEF₁ : ∀ (x : E.L₁) (y : F.L₁), σEF₁ (x ⊗ₜ[D.R₁] y) = σE₁ x * σF₁ y := by
          intro x y
          dsimp [σEF₁, ef₁, σE₁, σF₁]
          simp [mul_comm]
        refine ⟨ef₀, ef₁, ?_⟩
        dsimp [WeilTwoChartMul, WeilIsTwoChartBundleCocycle, weilTwoChartQuadMul]
        refine ⟨?_, ?_, ?_, ?_⟩
        · intro z
          change ((1 : T₀) ⊗ₜ[D.R₀] σEF₀ z : TensorProduct D.R₀ T₀ T₀) =
            ((q_E.g₀₀ : TensorProduct D.R₀ T₀ T₀) * (q_F.g₀₀ : TensorProduct D.R₀ T₀ T₀)) *
              (σEF₀ z ⊗ₜ[D.R₀] (1 : T₀))
          induction z using TensorProduct.induction_on with
          | zero => simp
          | tmul x y =>
            rw [hσEF₀]
            have hL : ((1 : T₀) ⊗ₜ[D.R₀] (σE₀ x * σF₀ y) : TensorProduct D.R₀ T₀ T₀) =
                ((1 : T₀) ⊗ₜ[D.R₀] σE₀ x) * ((1 : T₀) ⊗ₜ[D.R₀] σF₀ y) := by simp
            have hR : ((σE₀ x * σF₀ y) ⊗ₜ[D.R₀] (1 : T₀) : TensorProduct D.R₀ T₀ T₀) =
                (σE₀ x ⊗ₜ[D.R₀] (1 : T₀)) * (σF₀ y ⊗ₜ[D.R₀] (1 : T₀)) := by simp
            rw [hL, hE₀₀ x, hF₀₀ y, hR, mul_mul_mul_comm]
          | add z₁ z₂ ih₁ ih₂ =>
            rw [map_add, TensorProduct.tmul_add, TensorProduct.add_tmul, mul_add, ih₁, ih₂]
        · intro z
          change ((1 : T₁) ⊗ₜ[D.R₁] σEF₁ z : TensorProduct D.R₁ T₁ T₁) =
            ((q_E.g₁₁ : TensorProduct D.R₁ T₁ T₁) * (q_F.g₁₁ : TensorProduct D.R₁ T₁ T₁)) *
              (σEF₁ z ⊗ₜ[D.R₁] (1 : T₁))
          induction z using TensorProduct.induction_on with
          | zero => simp
          | tmul x y =>
            rw [hσEF₁]
            have hL : ((1 : T₁) ⊗ₜ[D.R₁] (σE₁ x * σF₁ y) : TensorProduct D.R₁ T₁ T₁) =
                ((1 : T₁) ⊗ₜ[D.R₁] σE₁ x) * ((1 : T₁) ⊗ₜ[D.R₁] σF₁ y) := by simp
            have hR : ((σE₁ x * σF₁ y) ⊗ₜ[D.R₁] (1 : T₁) : TensorProduct D.R₁ T₁ T₁) =
                (σE₁ x ⊗ₜ[D.R₁] (1 : T₁)) * (σF₁ y ⊗ₜ[D.R₁] (1 : T₁)) := by simp
            rw [hL, hE₁₁ x, hF₁₁ y, hR, mul_mul_mul_comm]
          | add z₁ z₂ ih₁ ih₂ =>
            rw [map_add, TensorProduct.tmul_add, TensorProduct.add_tmul, mul_add, ih₁, ih₂]
        · have hlTensor_distrib : ∀ (u : TensorProduct D.R₁ D.R₀₁ E.L₁)
              (v : TensorProduct D.R₁ D.R₀₁ F.L₁),
              (LinearMap.lTensor D.R₀₁ σEF₁
                  ((TensorProduct.AlgebraTensorModule.distribBaseChange D.R₁ D.R₀₁ E.L₁ F.L₁).symm
                    (u ⊗ₜ[D.R₀₁] v)) : T₁_ov) =
                (LinearMap.lTensor D.R₀₁ σE₁ u) * (LinearMap.lTensor D.R₀₁ σF₁ v) := by
            intro u v
            induction u using TensorProduct.induction_on with
            | zero => simp
            | tmul a x₁ =>
              induction v using TensorProduct.induction_on with
              | zero => simp
              | tmul b y₁ =>
                simp [hσEF₁]
              | add v₁ v₂ ihv₁ ihv₂ =>
                rw [TensorProduct.tmul_add, map_add, map_add, map_add, mul_add, ihv₁, ihv₂]
            | add u₁ u₂ ihu₁ ihu₂ =>
              rw [TensorProduct.add_tmul, map_add, map_add, map_add, add_mul, ihu₁, ihu₂]
          let θEF : TensorProduct D.R₀ D.R₀₁ (TensorProduct D.R₀ E.L₀ F.L₀) ≃ₗ[D.R₀₁]
              TensorProduct D.R₁ D.R₀₁ (TensorProduct D.R₁ E.L₁ F.L₁) :=
            (TensorProduct.AlgebraTensorModule.distribBaseChange D.R₀ D.R₀₁ E.L₀ F.L₀).trans
              ((TensorProduct.AlgebraTensorModule.congr E.θ F.θ).trans
                (TensorProduct.AlgebraTensorModule.distribBaseChange D.R₁ D.R₀₁ E.L₁ F.L₁).symm)
          intro z
          change ((1 : T₀_ov) ⊗ₜ[D.R₀₁]
              (LinearMap.lTensor D.R₀₁ σEF₁ (θEF ((1 : D.R₀₁) ⊗ₜ[D.R₀] z))) : A₀₁) =
            ((q_E.g₀₁ : A₀₁) * (q_F.g₀₁ : A₀₁)) *
              (((1 : D.R₀₁) ⊗ₜ[D.R₀] σEF₀ z) ⊗ₜ[D.R₀₁] (1 : T₁_ov))
          induction z using TensorProduct.induction_on with
          | zero => simp
          | tmul x y =>
            have hθ : θEF ((1 : D.R₀₁) ⊗ₜ[D.R₀] (x ⊗ₜ[D.R₀] y)) =
                (TensorProduct.AlgebraTensorModule.distribBaseChange D.R₁ D.R₀₁ E.L₁ F.L₁).symm
                  (E.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] x) ⊗ₜ[D.R₀₁] F.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] y)) := by
              dsimp [θEF]
            rw [hθ, hlTensor_distrib, hσEF₀]
            have hL : ((1 : T₀_ov) ⊗ₜ[D.R₀₁]
                ((LinearMap.lTensor D.R₀₁ σE₁ (E.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] x))) *
                  (LinearMap.lTensor D.R₀₁ σF₁ (F.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] y)))) : A₀₁) =
              ((1 : T₀_ov) ⊗ₜ[D.R₀₁] LinearMap.lTensor D.R₀₁ σE₁ (E.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] x))) *
                ((1 : T₀_ov) ⊗ₜ[D.R₀₁] LinearMap.lTensor D.R₀₁ σF₁ (F.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] y))) := by
              dsimp [A₀₁]; simp
            have hR : (((1 : D.R₀₁) ⊗ₜ[D.R₀] (σE₀ x * σF₀ y)) ⊗ₜ[D.R₀₁] (1 : T₁_ov) : A₀₁) =
                (((1 : D.R₀₁) ⊗ₜ[D.R₀] σE₀ x) ⊗ₜ[D.R₀₁] (1 : T₁_ov)) *
                  (((1 : D.R₀₁) ⊗ₜ[D.R₀] σF₀ y) ⊗ₜ[D.R₀₁] (1 : T₁_ov)) := by
              dsimp [A₀₁, T₀_ov]; simp
            rw [hL, hE₀₁ x, hF₀₁ y, hR, mul_mul_mul_comm]
          | add z₁ z₂ ih₁ ih₂ =>
            rw [TensorProduct.tmul_add, map_add, map_add, map_add,
              TensorProduct.tmul_add, TensorProduct.tmul_add, TensorProduct.add_tmul,
              mul_add, ih₁, ih₂]
        · rw [hE₁₀, hF₁₀, ← map_mul, mul_inv, Units.val_mul]
      intro E e₀ e₁ q hq n
      induction n with
      | zero => exact hTriv
      | succ m ih =>
        obtain ⟨e₀_m, e₁_m, hq_m⟩ := ih
        exact cocycle_mul E (WeilTwoChartPow D E m) e₀ e₁ e₀_m e₁_m q
          (weilTwoChartQuadPow q m) hq hq_m

  
  
  
  · intro B _ D E F T₀ T₁ _ _ _ _ e₀ e₁ f₀ f₁ q_E q_F
      ⟨hE₀₀, hE₁₁, hE₀₁, hE₁₀⟩ ⟨hF₀₀, hF₁₁, hF₀₁, hF₁₀⟩ ⟨α₀, α₁, hα⟩
    let T₀_ov := weilTwoChartOv₀ D T₀
    let T₁_ov := weilTwoChartOv₁ D T₁
    letI : CommRing T₀_ov := inferInstance
    letI : Algebra D.R₀₁ T₀_ov := inferInstance
