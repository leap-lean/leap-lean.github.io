    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let P := G.sheafPushforwardContinuous AddCommGrpCat.{u} J J
    let P_pull := (weilEtaleSitePullback g).sheafPullback AddCommGrpCat.{u} J J
    obtain ⟨η, hη⟩ := @hS4 K _ _ Z G hG_obj hG_map hG_cont hB_cont hB_adj T hT μ
    have hπℤ_align : @weilEtaleConstPullbackHom S S g hB_cont hB_adj T₁ hT₁ T₂ hT₂ Aℤ =
        @weilEtaleConstPullbackHom S S g hB_cont hB_adj T hT T hT Aℤ :=
      @hTermInv S S g hB_cont hB_adj T₁ T hT₁ hT T₂ T hT₂ hT Aℤ
    have hπM_align : @weilEtaleConstPullbackHom S S g hB_cont hB_adj T₁ hT₁ T₂ hT₂ AM =
        @weilEtaleConstPullbackHom S S g hB_cont hB_adj T hT T hT AM :=
      @hTermInv S S g hB_cont hB_adj T₁ T hT₁ hT T₂ T hT₂ hT AM
    let adj := constantSheafAdj J AddCommGrpCat.{u} hT
    let αℤ : C.obj Aℤ ⟶ P.obj (C.obj Aℤ) :=
      (adj.homEquiv Aℤ (P.obj (C.obj Aℤ))).symm (adj.unit.app Aℤ ≫ (C.obj Aℤ).obj.map μ.op)
    let πℤ := @weilEtaleConstPullbackHom S S g hB_cont hB_adj T hT T hT Aℤ
    let πM := @weilEtaleConstPullbackHom S S g hB_cont hB_adj T hT T hT AM
    have hα_inv : (αℤ ≫ η.inv.app (C.obj Aℤ)) ≫ πℤ = 𝟙 (C.obj Aℤ) := by
      rw [Category.assoc]; exact hη Aℤ
    have hι₂' : πℤ ≫ ιℤ = 𝟙 _ := by
      dsimp only [πℤ, g]
      rw [← hπℤ_align]
      exact hι₂
    have hαℤ_rel : αℤ ≫ η.inv.app (C.obj Aℤ) = ιℤ :=
      inv_uniq hα_inv hι₂'
    have hβM_rel : η.hom.app (C.obj AM) ≫ βM = πM := by
      have hM := hη AM
      have hβ_eq : βM = η.inv.app (C.obj AM) ≫ πM :=
        inv_uniq hβ₂ hM
      rw [hβ_eq, η.hom_inv_id_app_assoc]
    rw [hπM_align, hExtIso P_pull P η (C.obj Aℤ) (C.obj AM) i x]
    let η_inv_ℤ : P.obj (C.obj Aℤ) ⟶ P_pull.obj (C.obj Aℤ) := η.inv.app (C.obj Aℤ)
    let η_hom_M : P_pull.obj (C.obj AM) ⟶ P.obj (C.obj AM) := η.hom.app (C.obj AM)
    have hconj5 := ext_conj_eq αℤ η_inv_ℤ η_hom_M βM
      ((P_pull.mapExtAddHom (C.obj Aℤ) (C.obj AM) i) x)
    change _ = (Abelian.Ext.mk₀ (αℤ ≫ η.inv.app (C.obj Aℤ))).comp
      (((P_pull.mapExtAddHom (C.obj Aℤ) (C.obj AM) i) x).comp
        (Abelian.Ext.mk₀ (η.hom.app (C.obj AM) ≫ βM)) (Nat.add_zero i))
      (Nat.zero_add i) at hconj5
    rw [hαℤ_rel, hβM_rel] at hconj5
    exact hconj5.trans
      (Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ιℤ) _ _
        (Nat.zero_add i) (Nat.add_zero i) (by omega)).symm

theorem weil_projLine_finite_cover_closed_bdy_finite_closed_pts (k : Type u) [Field k]
    (C₀ : AlgebraicGeometry.Scheme.{u})
    (q₀ : C₀ ⟶ (weilProjectiveSpaceOver k 1).left)
    [AlgebraicGeometry.IsFinite q₀]
    (K : Set ↥C₀) (hK : IsClosed K) :
    (K ∩ closure (Kᶜ)).Finite ∧ ∀ y ∈ K ∩ closure (Kᶜ), IsClosed ({y} : Set ↥C₀) :=
by
  classical
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) k
  letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let P₁_over := weilProjectiveSpaceOver k 1
  let P₁ : AlgebraicGeometry.Scheme.{u} := P₁_over.left

  
  have hChartEquiv : ∀ a : Fin 2,
      Nonempty (Polynomial k ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a)) := by
    intro a
    let P := MvPolynomial (Fin 2) k
    let b : Fin 2 := if a = 0 then 1 else 0
    have hba : b ≠ a := by
      dsimp [b]; fin_cases a <;> decide
    have hj_eq_b : ∀ j : Fin 2, j ≠ a → j = b := by
      intro j hj
      dsimp [b]
      fin_cases a <;> fin_cases j <;> first | contradiction | rfl
    let Xa : P := MvPolynomial.X a
    let Xb : P := MvPolynomial.X b
    let S : Submonoid P := Submonoid.powers Xa
    let Ra := HomogeneousLocalization.Away 𝒜 Xa
    have hX : ∀ j : Fin 2, MvPolynomial.X j ∈ 𝒜 1 := fun j =>
      (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X j)).mpr
        (MvPolynomial.isHomogeneous_X k j)
    let ι_k : k →+* Ra :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 S).comp (algebraMap k ↥(𝒜 0))
    let t_a : Ra :=
      HomogeneousLocalization.mk ⟨1, ⟨Xb, hX b⟩, ⟨Xa, hX a⟩, Submonoid.mem_powers Xa⟩
    let α : Polynomial k →+* Ra := Polynomial.eval₂RingHom ι_k t_a
    let w : Fin 2 → Polynomial k := fun j => if j = a then 1 else Polynomial.X
    let dehom : P →+* Polynomial k := MvPolynomial.eval₂Hom Polynomial.C w
    have hdehom_S : ∀ y : S, dehom y.1 = 1 := by
      intro y
      obtain ⟨n, hn⟩ := y.2
      have hn' : Xa ^ n = y.1 := hn
      rw [← hn', map_pow]
      have hXa_one : dehom Xa = 1 := by
        change MvPolynomial.eval₂Hom Polynomial.C w (MvPolynomial.X a) = 1
        rw [MvPolynomial.eval₂Hom_X']
        simp [w]
      rw [hXa_one, one_pow]
    have hUnit : ∀ y : S, IsUnit (dehom y.1) := fun y => by
      rw [hdehom_S y]
      exact isUnit_one
    let β_loc : Localization S →+* Polynomial k := IsLocalization.lift hUnit
    have hβ_loc_mk : ∀ (p : P) (y : S), β_loc (Localization.mk p y) = dehom p := by
      intro p y
      rw [Localization.mk_eq_mk']
      exact (IsLocalization.lift_mk'_spec hUnit p (dehom p) y).mpr
        (by rw [hdehom_S y, one_mul])
    let valHom : Ra →+* Localization S :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let β : Ra →+* Polynomial k := β_loc.comp valHom
    have hLeft : ∀ q : Polynomial k, β (α q) = q := by
      have hcomp : β.comp α = RingHom.id (Polynomial k) := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          change β_loc ((Polynomial.eval₂RingHom ι_k t_a) (Polynomial.C c)).val = Polynomial.C c
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          have hval_c : (ι_k c).val = Localization.mk (MvPolynomial.C c) 1 := rfl
          rw [hval_c, hβ_loc_mk]
          exact MvPolynomial.eval₂Hom_C Polynomial.C w c
        · change β_loc ((Polynomial.eval₂RingHom ι_k t_a) Polynomial.X).val = Polynomial.X
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, HomogeneousLocalization.val_mk,
            hβ_loc_mk]
          change MvPolynomial.eval₂Hom Polynomial.C w (MvPolynomial.X b) = Polynomial.X
          rw [MvPolynomial.eval₂Hom_X']
          simp [w, hba]
      intro q
      exact DFunLike.congr_fun hcomp q
    have hRight : ∀ z : Ra, α (β z) = z := by
      let φ : P →+* Localization S := valHom.comp (α.comp dehom)
      have hφ_C : ∀ c : k, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        change ((Polynomial.eval₂RingHom ι_k t_a) (dehom (MvPolynomial.C c))).val =
          Localization.mk (MvPolynomial.C c) 1
        rw [MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rfl
      have hφ_X : ∀ j : Fin 2,
          φ (MvPolynomial.X j) = Localization.mk (MvPolynomial.X j) ⟨Xa, Submonoid.mem_powers Xa⟩ := by
        intro j
        change (α (dehom (MvPolynomial.X j))).val = _
        rw [MvPolynomial.eval₂Hom_X']
        by_cases hj : j = a
        · subst hj
          simp only [w, ↓reduceIte, map_one, HomogeneousLocalization.val_one]
          exact (Localization.mk_self ⟨Xa, Submonoid.mem_powers Xa⟩).symm
        · simp only [w, hj, ↓reduceIte]
          change ((Polynomial.eval₂RingHom ι_k t_a) Polynomial.X).val = _
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hj_eq_b j hj]
          exact HomogeneousLocalization.val_mk _
      have hφ_prod : ∀ (d : Fin 2 →₀ ℕ) (s : Finset (Fin 2)),
          φ (∏ j ∈ s, MvPolynomial.X j ^ d j) =
            Localization.mk (∏ j ∈ s, MvPolynomial.X j ^ d j)
              ⟨Xa ^ (∑ j ∈ s, d j), pow_mem (Submonoid.mem_powers Xa) _⟩ := by
        intro d s
        induction s using Finset.induction_on with
        | empty =>
          simp only [Finset.prod_empty, Finset.sum_empty, pow_zero, map_one]
          exact (Localization.mk_one).symm
        | insert j s hjs ih =>
          rw [Finset.prod_insert hjs, Finset.sum_insert hjs, map_mul, map_pow, hφ_X j,
            Localization.mk_pow, ih, Localization.mk_mul]
          congr 1
          apply Subtype.ext
          exact (pow_add Xa (d j) (∑ i ∈ s, d i)).symm
      have hweight : ∀ d : Fin 2 →₀ ℕ,
          (Finsupp.weight 1) d = ∑ j ∈ d.support, d j := by
        intro d
        simp [Finsupp.weight_apply, Finsupp.sum]
      have hφ_monomial : ∀ (d : Fin 2 →₀ ℕ) (c : k),
          φ (MvPolynomial.monomial d c) =
            Localization.mk (MvPolynomial.monomial d c)
              ⟨Xa ^ ((Finsupp.weight 1) d), pow_mem (Submonoid.mem_powers Xa) _⟩ := by
        intro d c
        rw [MvPolynomial.monomial_eq, map_mul, hφ_C]
        change Localization.mk (MvPolynomial.C c) 1 *
            φ (∏ j ∈ d.support, MvPolynomial.X j ^ d j) = _
        rw [hφ_prod d d.support, Localization.mk_mul]
        congr 1
        apply Subtype.ext
        change 1 * Xa ^ (∑ j ∈ d.support, d j) = Xa ^ ((Finsupp.weight 1) d)
        rw [one_mul, hweight d]
      have h_sum_mk : ∀ (s : Finset (Fin 2 →₀ ℕ))
          (g : (Fin 2 →₀ ℕ) → P) (y : S),
          ∑ d ∈ s, Localization.mk (g d) y = Localization.mk (∑ d ∈ s, g d) y := by
        intro s g y
        induction s using Finset.induction_on with
        | empty =>
          simp [Localization.mk_zero]
        | insert d s hds ih =>
          rw [Finset.sum_insert hds, Finset.sum_insert hds, ih, Localization.add_mk_self]
      have hφ_homog : ∀ (n : ℕ) (p : P), p.IsHomogeneous n →
          φ p = Localization.mk p ⟨Xa ^ n, pow_mem (Submonoid.mem_powers Xa) n⟩ := by
        intro n p hp
        conv_lhs => rw [MvPolynomial.as_sum p]
        rw [map_sum]
        have hterms : ∀ d ∈ p.support,
            φ (MvPolynomial.monomial d (p.coeff d)) =
              Localization.mk (MvPolynomial.monomial d (p.coeff d))
                ⟨Xa ^ n, pow_mem (Submonoid.mem_powers Xa) n⟩ := by
          intro d hd
          rw [hφ_monomial]
          have hdn : (Finsupp.weight 1) d = n := hp (MvPolynomial.mem_support_iff.mp hd)
          congr 1
          apply Subtype.ext
          change Xa ^ ((Finsupp.weight 1) d) = Xa ^ n
          rw [hdn]
        rw [Finset.sum_congr rfl hterms, h_sum_mk, ← MvPolynomial.as_sum p]
      intro z
      refine Quotient.inductionOn' z fun nd => ?_
      obtain ⟨n, hn⟩ := nd.den_mem
      have hn' : Xa ^ n = nd.den.1 := hn
      have hXa_pow_ne : Xa ^ n ≠ 0 := by
        intro h0
        have hev := congrArg (MvPolynomial.eval (fun _ => (1 : k))) h0
        simp [Xa] at hev
      have hex_d : ∃ d₀, (Xa ^ n).coeff d₀ ≠ 0 := by
        by_contra h_all
        push_neg at h_all
        exact hXa_pow_ne (MvPolynomial.ext_iff.mpr fun d => by simp [h_all d])
      obtain ⟨d₀, hd₀⟩ := hex_d
      have hden_homog : (Xa ^ n).IsHomogeneous nd.deg := by
        rw [hn']
        exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
      have hXa_homog : (Xa ^ n).IsHomogeneous n := by
        simpa using (MvPolynomial.isHomogeneous_X k a).pow n
      have hdeg_eq : nd.deg = n := (hden_homog hd₀).symm.trans (hXa_homog hd₀)
      have hnum_homog : nd.num.1.IsHomogeneous n := by
        rw [← hdeg_eq]
        exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
      apply HomogeneousLocalization.val_injective
      have hβ_mk : β (HomogeneousLocalization.mk nd) = dehom nd.num.1 := by
        change β_loc (HomogeneousLocalization.mk nd).val = dehom nd.num.1
        rw [HomogeneousLocalization.val_mk, hβ_loc_mk]
      rw [hβ_mk]
      change φ nd.num.1 = (HomogeneousLocalization.mk nd).val
      rw [hφ_homog n nd.num.1 hnum_homog, HomogeneousLocalization.val_mk]
      congr 1
      apply Subtype.ext
      exact hn'
    exact ⟨{ α with invFun := β, left_inv := hLeft, right_inv := hRight }⟩

  
  have hIrredP₁ : IrreducibleSpace ↥P₁ := by
    change IrreducibleSpace (ProjectiveSpectrum 𝒜)
    have hPrimeBot : (⊥ : HomogeneousIdeal 𝒜).toIdeal.IsPrime := by
      rw [HomogeneousIdeal.toIdeal_bot]
      exact Ideal.isPrime_bot
    have hNotIrrel : ¬ HomogeneousIdeal.irrelevant 𝒜 ≤ ⊥ := by
      intro hle
      let X0 : MvPolynomial (Fin 2) k := MvPolynomial.X 0
      have hX0_mem1 : X0 ∈ 𝒜 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 X0).mpr (MvPolynomial.isHomogeneous_X k 0)
      have hX0_irrel : X0 ∈ HomogeneousIdeal.irrelevant 𝒜 := by
        rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
        exact DirectSum.decompose_of_mem_ne 𝒜 hX0_mem1 (by decide : (1 : ℕ) ≠ 0)
      have hX0_bot : X0 ∈ (⊥ : HomogeneousIdeal 𝒜) := hle hX0_irrel
      have hX0_zero : X0 = 0 := by
        change X0 ∈ (⊥ : HomogeneousIdeal 𝒜).toIdeal at hX0_bot
        rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at hX0_bot
        exact hX0_bot
      have hev := congrArg (MvPolynomial.eval (fun _ => (1 : k))) hX0_zero
      simp [X0] at hev
    let η₀ : ProjectiveSpectrum 𝒜 := ⟨⊥, hPrimeBot, hNotIrrel⟩
    have hη_mem : ∀ (W : Set (ProjectiveSpectrum 𝒜)), IsOpen W → W.Nonempty → η₀ ∈ W := by
      intro W hW ⟨z, hz⟩
      obtain ⟨s, hs⟩ := (ProjectiveSpectrum.isOpen_iff 𝒜 W).mp hW
      by_contra hηW
      have hηWc : η₀ ∈ Wᶜ := hηW
      rw [hs, ProjectiveSpectrum.mem_zeroLocus] at hηWc
      have hzWc : z ∈ ProjectiveSpectrum.zeroLocus 𝒜 s := by
        rw [ProjectiveSpectrum.mem_zeroLocus]
        intro f hf
        have hf_bot : f ∈ (⊥ : HomogeneousIdeal 𝒜) := hηWc hf
        have hf_zero : f = 0 := by
          change f ∈ (⊥ : HomogeneousIdeal 𝒜).toIdeal at hf_bot
          rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at hf_bot
          exact hf_bot
        rw [hf_zero]
        exact zero_mem _
      rw [← hs] at hzWc
      exact hzWc hz
    exact
      { isPreirreducible_univ := fun U V hU hV ⟨u, _, hu⟩ ⟨v, _, hv⟩ =>
          ⟨η₀, trivial, hη_mem U hU ⟨u, hu⟩, hη_mem V hV ⟨v, hv⟩⟩
        toNonempty := ⟨η₀⟩ }
  haveI : IrreducibleSpace ↥P₁ := hIrredP₁

  
  have hSurj₀ : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
    intro p
    have hp1 : p.1 ∈ (1 : Submodule k (MvPolynomial (Fin 2) k)) := by
      rw [← MvPolynomial.homogeneousSubmodule_zero]
      exact p.2
    obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp1
    exact ⟨c, Subtype.ext hc⟩
  have hFT₀ : (algebraMap k ↥(𝒜 0)).FiniteType :=
    RingHom.FiniteType.of_surjective _ hSurj₀
  have : AlgebraicGeometry.LocallyOfFiniteType
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT₀
  have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin 2) k) :=
    @IsScalarTower.of_algebraMap_eq k ↥(𝒜 0) (MvPolynomial (Fin 2) k) _ _ _ _ _ _
      (fun _ => rfl)
  have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin 2) k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin 2) k)
  have hLFT_P₁ : AlgebraicGeometry.LocallyOfFiniteType P₁_over.hom := by
    dsimp [P₁_over, weilProjectiveSpaceOver]
    infer_instance
  have : AlgebraicGeometry.IsLocallyNoetherian P₁ :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian P₁_over.hom
  let f_X : Fin 2 → MvPolynomial (Fin 2) k := MvPolynomial.X
  let U_cov : Fin 2 → (AlgebraicGeometry.Proj 𝒜).Opens :=
    fun a => AlgebraicGeometry.Proj.basicOpen 𝒜 (f_X a)
  have hf_hom : ∀ a : Fin 2, ∃ d : ℕ, f_X a ∈ 𝒜 d :=
    fun a => ⟨1, MvPolynomial.isHomogeneous_X k a⟩
  have hf_adj : Algebra.adjoin (↥(𝒜 0)) (Set.range f_X) = ⊤ := by
    rw [eq_top_iff]
    intro p _
    have hp_k : p ∈ Algebra.adjoin k (Set.range f_X) := by
      rw [MvPolynomial.adjoin_range_X]
      trivial
    have h_le : Algebra.adjoin k (Set.range f_X) ≤
        (Algebra.adjoin (↥(𝒜 0)) (Set.range f_X)).restrictScalars k :=
      Algebra.adjoin_le_iff.mpr Algebra.subset_adjoin
    exact h_le hp_k
  have h_cov_P₁ : (⨆ a : Fin 2, U_cov a) = ⊤ :=
    AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 f_X hf_hom hf_adj
  have : CompactSpace ↥P₁ := by
    change CompactSpace ↥(AlgebraicGeometry.Proj 𝒜)
    rw [← isCompact_univ_iff]
    have huniv : (Set.univ : Set ↥(AlgebraicGeometry.Proj 𝒜)) =
        ⋃ a : Fin 2, (U_cov a : Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
      rw [← TopologicalSpace.Opens.coe_top, ← h_cov_P₁, TopologicalSpace.Opens.coe_iSup]
    rw [huniv]
    exact isCompact_iUnion (fun a =>
      (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (f_X a)
        (MvPolynomial.isHomogeneous_X k a) Nat.one_pos).isCompact)
  haveI : AlgebraicGeometry.IsNoetherian P₁ := {}
  have : AlgebraicGeometry.IsLocallyNoetherian C₀ :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian q₀
  have : CompactSpace ↥C₀ :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace q₀
  haveI : AlgebraicGeometry.IsNoetherian C₀ := {}

  
  have hXa_mem : ∀ a : Fin 2, MvPolynomial.X a ∈ 𝒜 1 := fun a =>
    (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X a)).mpr
      (MvPolynomial.isHomogeneous_X k a)
  have hDimChart : ∀ a : Fin 2, topologicalKrullDim ↥(U_cov a) = (1 : WithBot ℕ∞) := by
    intro a
    obtain ⟨e_a⟩ := hChartEquiv a
    let iso_a : (U_cov a).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) (hXa_mem a) zero_lt_one ≪≫
        CategoryTheory.asIso (AlgebraicGeometry.Spec.map e_a.toCommRingCatIso.hom)
    have hHomeo := (AlgebraicGeometry.Scheme.homeoOfIso iso_a).isHomeomorph.topologicalKrullDim_eq
    change topologicalKrullDim ↥(U_cov a).toScheme = (1 : WithBot ℕ∞)
    rw [hHomeo]
    change topologicalKrullDim (PrimeSpectrum (Polynomial k)) = (1 : WithBot ℕ∞)
    rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim (Polynomial k),
      Polynomial.ringKrullDim_of_isNoetherianRing,
      ringKrullDim_eq_zero_of_field k, zero_add]
  have hDimP₁ : topologicalKrullDim P₁ = (1 : WithBot ℕ∞) := by
    change topologicalKrullDim ↥(AlgebraicGeometry.Proj 𝒜) = (1 : WithBot ℕ∞)
    apply le_antisymm
    · change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥(AlgebraicGeometry.Proj 𝒜)) ≤
        (1 : WithBot ℕ∞)
      refine iSup_le fun (p : LTSeries
          (TopologicalSpace.IrreducibleCloseds ↥(AlgebraicGeometry.Proj 𝒜))) => ?_
      obtain ⟨x₀, hx₀⟩ := (p 0).isIrreducible'.nonempty
      have hx₀_top : x₀ ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜).Opens) := trivial
      rw [← h_cov_P₁, TopologicalSpace.Opens.mem_iSup] at hx₀_top
      obtain ⟨a, hx₀U⟩ := hx₀_top
      let y₀ : ↥(U_cov a) := ⟨x₀, hx₀U⟩
      let S_fun : Fin (p.length + 1) → Set ↥(U_cov a) := fun r =>
        Subtype.val ⁻¹' (p r : Set ↥(AlgebraicGeometry.Proj 𝒜))
      have hCl : ∀ r : Fin (p.length + 1), IsClosed (S_fun r) := fun r =>
        (p r).isClosed'.preimage continuous_subtype_val
      have hNonempty : ∀ r : Fin (p.length + 1), (S_fun r).Nonempty := fun r =>
        ⟨y₀, p.monotone (Fin.zero_le r) hx₀⟩
      have hPre : ∀ r : Fin (p.length + 1), IsPreirreducible (S_fun r) := fun r =>
        IsPreirreducible.preimage (p r).isIrreducible'.isPreirreducible
          (U_cov a).isOpen.isOpenEmbedding_subtypeVal
      let q_fun : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥(U_cov a) :=
        fun r => ⟨S_fun r, ⟨hNonempty r, hPre r⟩, hCl r⟩
      have hStep : ∀ r : Fin p.length, q_fun r.castSucc < q_fun r.succ := by
        intro r
        have hlt_r : p r.castSucc < p r.succ := p.step r
        refine lt_of_le_not_ge ?_ ?_
        · intro y hy
          exact hlt_r.le hy
        · intro hle
          have hsub_union :
              (p r.succ : Set ↥(AlgebraicGeometry.Proj 𝒜)) ⊆
                (p r.castSucc : Set ↥(AlgebraicGeometry.Proj 𝒜)) ∪
                  (U_cov a : Set ↥(AlgebraicGeometry.Proj 𝒜))ᶜ := by
            intro z hz
            by_cases hzU : z ∈ U_cov a
            · exact Or.inl (hle (show (⟨z, hzU⟩ : ↥(U_cov a)) ∈ S_fun r.succ from hz))
            · exact Or.inr hzU
          have hunion :=
            (isPreirreducible_iff_isClosed_union_isClosed.mp
              (p r.succ).isIrreducible'.isPreirreducible)
              (p r.castSucc : Set ↥(AlgebraicGeometry.Proj 𝒜))
              ((U_cov a : Set ↥(AlgebraicGeometry.Proj 𝒜))ᶜ)
              (p r.castSucc).isClosed' (U_cov a).isOpen.isClosed_compl hsub_union
          rcases hunion with hle_p | hcompl
          · exact not_le_of_gt hlt_r hle_p
          · have hx₀_succ : x₀ ∈ (p r.succ : Set ↥(AlgebraicGeometry.Proj 𝒜)) :=
              p.monotone (Fin.zero_le r.succ) hx₀
            exact hcompl hx₀_succ hx₀U
      let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(U_cov a)) :=
        ⟨p.length, q_fun, hStep⟩
      have hlen : (q.length : WithBot ℕ∞) ≤ topologicalKrullDim ↥(U_cov a) :=
        Order.LTSeries.length_le_krullDim q
      simpa [q, hDimChart a] using hlen
    · rw [← hDimChart 0]
      exact topologicalKrullDim_subspace_le ↥(AlgebraicGeometry.Proj 𝒜)
        (U_cov 0 : Set ↥(AlgebraicGeometry.Proj 𝒜))

  
  have hProperBase : ∀ (S : Set ↥P₁), IsClosed S → S ≠ Set.univ →
      S.Finite ∧ ∀ x ∈ S, IsClosed ({x} : Set ↥P₁) := by
    intro S hS_cl hS_ne
    have h_pts : ∀ x ∈ S, IsClosed ({x} : Set ↥P₁) := by
      intro x hx
      have hcx_sub : closure ({x} : Set ↥P₁) ⊆ S :=
        closure_minimal (Set.singleton_subset_iff.mpr hx) hS_cl
      have hcx_ne : closure ({x} : Set ↥P₁) ≠ Set.univ := by
        intro heq
        apply hS_ne
        exact Set.eq_univ_of_univ_subset (heq ▸ hcx_sub)
      rw [← closure_subset_iff_isClosed]
      intro y hy
      rw [Set.mem_singleton_iff]
      by_contra hyx
      have hx_not_cy : x ∉ closure ({y} : Set ↥P₁) := by
        intro hxy
        have hcy_sub : closure ({y} : Set ↥P₁) ⊆ closure ({x} : Set ↥P₁) :=
          closure_minimal (Set.singleton_subset_iff.mpr hy) isClosed_closure
        have hcx_sub_y : closure ({x} : Set ↥P₁) ⊆ closure ({y} : Set ↥P₁) :=
          closure_minimal (Set.singleton_subset_iff.mpr hxy) isClosed_closure
        have heq_cl : closure ({y} : Set ↥P₁) = closure ({x} : Set ↥P₁) :=
          Set.Subset.antisymm hcy_sub hcx_sub_y
        exact hyx (inseparable_iff_closure_eq.mpr heq_cl).eq
      let K₀ : TopologicalSpace.IrreducibleCloseds ↥P₁ :=
        ⟨closure ({y} : Set ↥P₁), isIrreducible_singleton.closure, isClosed_closure⟩
      let K₁ : TopologicalSpace.IrreducibleCloseds ↥P₁ :=
        ⟨closure ({x} : Set ↥P₁), isIrreducible_singleton.closure, isClosed_closure⟩
      let K₂ : TopologicalSpace.IrreducibleCloseds ↥P₁ :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥P₁, isClosed_univ⟩
      have hK₀₁ : K₀ < K₁ := by
        refine lt_of_le_not_ge ?_ ?_
        · exact closure_minimal (Set.singleton_subset_iff.mpr hy) isClosed_closure
        · intro hge
          exact hx_not_cy (hge (subset_closure (Set.mem_singleton x)))
      have hK₁₂ : K₁ < K₂ := by
        refine lt_of_le_not_ge (Set.subset_univ _) ?_
        · intro hge
          exact hcx_ne (Set.eq_univ_of_univ_subset hge)
      let p₀ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥P₁) :=
        RelSeries.singleton _ K₂
      let p₁ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥P₁) :=
        RelSeries.cons p₀ K₁ hK₁₂
      let p₂ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥P₁) :=
        RelSeries.cons p₁ K₀ hK₀₁
      have h_len : (p₂.length : WithBot ℕ∞) ≤ topologicalKrullDim P₁ :=
        Order.LTSeries.length_le_krullDim p₂
      have hp₂_len : p₂.length = 2 := rfl
      rw [hp₂_len, hDimP₁] at h_len
      exact absurd (WithBot.coe_le_coe.mp h_len) (by decide)
    refine ⟨?_, h_pts⟩
    obtain ⟨T, hT_fin, hT_irr, hS_sup⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_closeds_irreducible
        (⟨S, hS_cl⟩ : TopologicalSpace.Closeds ↥P₁)
    have hU_cl : IsClosed (⋃ t ∈ T, (t : Set ↥P₁)) :=
      hT_fin.isClosed_biUnion (fun t _ => t.isClosed)
    have hS_sub : S ⊆ ⋃ t ∈ T, (t : Set ↥P₁) := by
      have h_le : (⟨S, hS_cl⟩ : TopologicalSpace.Closeds ↥P₁) ≤ ⟨⋃ t ∈ T, (t : Set ↥P₁), hU_cl⟩ := by
        rw [hS_sup]
        exact sSup_le (fun t ht => Set.subset_biUnion_of_mem
          (u := fun u : TopologicalSpace.Closeds ↥P₁ => (u : Set ↥P₁)) ht)
      exact h_le
    refine Set.Finite.subset (hT_fin.biUnion ?_) hS_sub
    intro t ht
    have ht_sub : (t : Set ↥P₁) ⊆ S := by
      have h_le : t ≤ (⟨S, hS_cl⟩ : TopologicalSpace.Closeds ↥P₁) := by
        rw [hS_sup]
        exact le_sSup ht
      exact h_le
    obtain ⟨x_t, hx_gen⟩ := QuasiSober.sober (hT_irr t ht) t.isClosed
    have hx_mem : x_t ∈ S := ht_sub (hx_gen.def ▸ subset_closure (Set.mem_singleton x_t))
    have hx_cl : IsClosed ({x_t} : Set ↥P₁) := h_pts x_t hx_mem
    have ht_eq : (t : Set ↥P₁) = {x_t} := by
      rw [← hx_gen.def, hx_cl.closure_eq]
    rw [ht_eq]
    exact Set.finite_singleton x_t

  have h_s3 : ∀ (E F : Set ↥C₀),
      IsClosed E → IsIrreducible E → IsClosed F → F ⊆ E → ¬ E ⊆ F →
      F.Finite ∧ ∀ y ∈ F, IsClosed ({y} : Set ↥C₀) := by
    intro E F hE_cl hE_irr hF_cl hFE hF_ne
    let S : Set ↥P₁ := q₀.base '' F
    have hS_cl : IsClosed S := q₀.isClosedMap F hF_cl
    have hS_ne : S ≠ Set.univ := by
      intro hS_univ
      obtain ⟨η_E, hηE⟩ := QuasiSober.sober hE_irr hE_cl
      have hηE_not_F : η_E ∉ F := by
        intro h_in
        apply hF_ne
        rw [← hηE.def]
        exact closure_minimal (Set.singleton_subset_iff.mpr h_in) hF_cl
      obtain ⟨η_X, hηX⟩ :=
        QuasiSober.sober (IrreducibleSpace.isIrreducible_univ ↥P₁) isClosed_univ
      have hηX_mem_S : η_X ∈ S := hS_univ ▸ Set.mem_univ η_X
      obtain ⟨y, hyF, hy_img⟩ := hηX_mem_S
      have huniv_sub : (Set.univ : Set ↥P₁) ⊆ closure ({q₀.base η_E} : Set ↥P₁) := by
        calc (Set.univ : Set ↥P₁)
            = S := hS_univ.symm
          _ ⊆ q₀.base '' E := Set.image_mono hFE
          _ = q₀.base '' closure ({η_E} : Set ↥C₀) := by rw [hηE.def]
          _ ⊆ closure (q₀.base '' ({η_E} : Set ↥C₀)) :=
              image_closure_subset_closure_image q₀.continuous
          _ = closure ({q₀.base η_E} : Set ↥P₁) := by rw [Set.image_singleton]
      have hcl_eq : closure ({q₀.base η_E} : Set ↥P₁) = closure ({η_X} : Set ↥P₁) := by
        rw [Set.eq_univ_of_univ_subset huniv_sub, hηX.def]
      have hηE_img : q₀.base η_E = η_X :=
        (inseparable_iff_closure_eq.mpr hcl_eq).eq
      let Fib : Set ↥C₀ := q₀.base ⁻¹' ({η_X} : Set ↥P₁)
      letI : DiscreteTopology ↑Fib := (q₀.fiberHomeo η_X).discreteTopology
      let y_fib : ↑Fib := ⟨y, hy_img⟩
      let η_fib : ↑Fib := ⟨η_E, hηE_img⟩
      have hy_open : IsOpen ({y_fib} : Set ↑Fib) := isOpen_discrete _
      rw [isOpen_induced_iff] at hy_open
      obtain ⟨O, hO_open, hO_pre⟩ := hy_open
      have hy_in_O : y ∈ O := by
        have hmem : y_fib ∈ (Subtype.val : ↑Fib → ↥C₀) ⁻¹' O := by
          rw [hO_pre]
          exact Set.mem_singleton y_fib
        exact hmem
      have hy_in_cl : y ∈ closure ({η_E} : Set ↥C₀) := by
        rw [hηE.def]
        exact hFE hyF
      obtain ⟨z, hzO, hz_eq⟩ := mem_closure_iff.mp hy_in_cl O hO_open hy_in_O
      rw [Set.mem_singleton_iff] at hz_eq
      rw [hz_eq] at hzO
      have hη_in_sing : η_fib ∈ ({y_fib} : Set ↑Fib) := by
        rw [← hO_pre]
        exact hzO
      have h_eq_y : η_E = y := congrArg Subtype.val (Set.mem_singleton_iff.mp hη_in_sing)
      exact hηE_not_F (by rwa [h_eq_y])
    obtain ⟨hS_fin, hS_pts⟩ := hProperBase S hS_cl hS_ne
    refine ⟨(q₀.finite_preimage hS_fin).subset (Set.subset_preimage_image q₀.base F), ?_⟩
    intro y hyF
    let x : ↥P₁ := q₀.base y
    have hx_cl : IsClosed ({x} : Set ↥P₁) := hS_pts x ⟨y, hyF, rfl⟩
    have hFx_cl : IsClosed (q₀.base ⁻¹' ({x} : Set ↥P₁)) :=
      hx_cl.preimage q₀.continuous
    letI : DiscreteTopology ↑(q₀.base ⁻¹' ({x} : Set ↥P₁)) :=
      (q₀.fiberHomeo x).discreteTopology
    have hy_disc : IsClosed ({(⟨y, rfl⟩ : ↑(q₀.base ⁻¹' ({x} : Set ↥P₁)))} :
        Set ↑(q₀.base ⁻¹' ({x} : Set ↥P₁))) :=
      isClosed_discrete _
    have h_img : IsClosed ((Subtype.val : ↑(q₀.base ⁻¹' ({x} : Set ↥P₁)) → ↥C₀) ''
        {(⟨y, rfl⟩ : ↑(q₀.base ⁻¹' ({x} : Set ↥P₁)))}) :=
      hFx_cl.isClosedEmbedding_subtypeVal.isClosedMap _ hy_disc
    simpa only [Set.image_singleton] using h_img

  
  let ℰ : Set (Set ↥C₀) := irreducibleComponents ↥C₀
  let K_V : Set ↥C₀ := K ∩ closure (Kᶜ)
  have hℰ_fin : ℰ.Finite :=
    AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian (X := C₀)
  have h_slice : ∀ E ∈ ℰ,
      (E ∩ K_V).Finite ∧ ∀ y ∈ E ∩ K_V, IsClosed ({y} : Set ↥C₀) := by
    intro E hE
    have hE_max : Maximal (fun s : Set ↥C₀ => IsClosed s ∧ IsIrreducible s) E := by
      have hE₀ : E ∈ irreducibleComponents ↥C₀ := hE
      rwa [irreducibleComponents_eq_maximals_closed] at hE₀
    have hE_cl : IsClosed E := hE_max.prop.1
    have hE_irr : IsIrreducible E := hE_max.prop.2
    by_cases hEK : E ⊆ K
    · let ℰ' : Set (Set ↥C₀) := ℰ \ {E}
      have hℰ'_fin : ℰ'.Finite := hℰ_fin.diff
      let E_other : Set ↥C₀ := ⋃ E' ∈ ℰ', E'
      have hEother_cl : IsClosed E_other :=
        hℰ'_fin.isClosed_biUnion (fun E' hE' => isClosed_of_mem_irreducibleComponents E' hE'.1)
      have hKc_sub : Kᶜ ⊆ E_other := by
        intro z hz
        let E' : Set ↥C₀ := irreducibleComponent z
        have hE'_mem : E' ∈ ℰ := irreducibleComponent_mem_irreducibleComponents z
        have hz_E' : z ∈ E' := mem_irreducibleComponent
        have hE'_ne : E' ≠ E := by
          intro heq
          exact hz (hEK (heq ▸ hz_E'))
        exact Set.mem_biUnion ⟨hE'_mem, hE'_ne⟩ hz_E'
      have hclKc_sub : closure (Kᶜ) ⊆ E_other :=
        closure_minimal hKc_sub hEother_cl
      have h_sub_inter : E ∩ K_V ⊆ ⋃ E' ∈ ℰ', (E ∩ E') := by
        rintro y ⟨hyE, _, hy_cl⟩
        obtain ⟨E', hE'mem, hyE'⟩ := Set.mem_iUnion₂.mp (hclKc_sub hy_cl)
        exact Set.mem_biUnion hE'mem ⟨hyE, hyE'⟩
      have h_each_other : ∀ E' ∈ ℰ',
          (E ∩ E').Finite ∧ ∀ y ∈ E ∩ E', IsClosed ({y} : Set ↥C₀) := by
        intro E' hE'
        have hE'_mem : E' ∈ ℰ := hE'.1
        have hE'_ne : E' ≠ E := hE'.2
        have hE'_max : Maximal (fun s : Set ↥C₀ => IsClosed s ∧ IsIrreducible s) E' := by
          have hE'₀ : E' ∈ irreducibleComponents ↥C₀ := hE'_mem
          rwa [irreducibleComponents_eq_maximals_closed] at hE'₀
        have h_not_sub : ¬ E ⊆ E ∩ E' := by
          intro hsub
          have hEE' : E ⊆ E' := hsub.trans Set.inter_subset_right
          have hE'E : E' ⊆ E := hE_max.le_of_ge ⟨hE'_max.prop.1, hE'_max.prop.2⟩ hEE'
          exact hE'_ne (Set.Subset.antisymm hE'E hEE')
        exact h_s3 E (E ∩ E') hE_cl hE_irr (hE_cl.inter hE'_max.prop.1)
          Set.inter_subset_left h_not_sub
      refine ⟨(hℰ'_fin.biUnion (fun E' hE' => (h_each_other E' hE').1)).subset h_sub_inter, ?_⟩
      intro y hy
      obtain ⟨E', hE', hy_inter⟩ := Set.mem_iUnion₂.mp (h_sub_inter hy)
      exact (h_each_other E' hE').2 y hy_inter
    · have h_not_sub : ¬ E ⊆ E ∩ K := by
        intro hsub
        exact hEK (hsub.trans Set.inter_subset_right)
      obtain ⟨hEK_fin, hEK_pts⟩ :=
        h_s3 E (E ∩ K) hE_cl hE_irr (hE_cl.inter hK) Set.inter_subset_left h_not_sub
      have h_sub : E ∩ K_V ⊆ E ∩ K := fun y ⟨hyE, hyK, _⟩ => ⟨hyE, hyK⟩
      exact ⟨hEK_fin.subset h_sub, fun y hy => hEK_pts y (h_sub hy)⟩
  have hKV_eq : K_V = ⋃ E ∈ ℰ, (E ∩ K_V) := by
    ext y
    constructor
    · intro hy
      exact Set.mem_biUnion (irreducibleComponent_mem_irreducibleComponents y)
        ⟨mem_irreducibleComponent, hy⟩
    · intro hy
      obtain ⟨_, _, _, hyKV⟩ := Set.mem_iUnion₂.mp hy
      exact hyKV
  refine ⟨?_, ?_⟩
  · change K_V.Finite
    rw [hKV_eq]
    exact hℰ_fin.biUnion (fun E hE => (h_slice E hE).1)
  · intro y hy
    exact (h_slice (irreducibleComponent y) (irreducibleComponent_mem_irreducibleComponents y)).2
      y ⟨mem_irreducibleComponent, hy⟩

theorem weil_etale_finite_closed_pts_algClosed_H_one_subsingleton (k : Type u) [Field k] [IsAlgClosed k]
    (V₀ : AlgebraicGeometry.Scheme.{u})
    (p_V₀ : V₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
    [AlgebraicGeometry.LocallyOfFiniteType p_V₀]
    (hFin : Finite ↥V₀)
    (hCl : ∀ v : ↥V₀, IsClosed ({v} : Set ↥V₀))
    (𝒢 : CategoryTheory.Sheaf V₀.smallEtaleTopology AddCommGrpCat.{u}) :
    Subsingleton (𝒢.H 1) :=
by
  classical
  
  have hSec_aff : ∀ (U : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine U] [Unique ↥U]
      (p_U : U ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      [AlgebraicGeometry.LocallyOfFiniteType p_U]
      (Y : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥Y]
      (f : Y ⟶ U) [AlgebraicGeometry.Etale f],
      ∃ σ : U ⟶ Y, σ ≫ f = 𝟙 U ∧ AlgebraicGeometry.Etale σ := by
    intro U _ _ p_U _ Y _ f _
    have hU_top : AlgebraicGeometry.IsAffineOpen (⊤ : U.Opens) :=
      AlgebraicGeometry.isAffineOpen_top U
    let R_cat : CommRingCat.{u} := U.presheaf.obj (Opposite.op ⊤)
    let R : Type u := ↑R_cat
    have hfrom_eq : hU_top.fromSpec = U.isoSpec.inv :=
      AlgebraicGeometry.IsAffineOpen.fromSpec_top
    let inv_from : U ⟶ AlgebraicGeometry.Spec R_cat := U.isoSpec.hom
    have h_inv_from : inv_from ≫ hU_top.fromSpec = 𝟙 U := by
      dsimp [inv_from]
      rw [hfrom_eq, CategoryTheory.Iso.hom_inv_id]
    have h_from_inv : hU_top.fromSpec ≫ inv_from = 𝟙 (AlgebraicGeometry.Spec R_cat) := by
      dsimp [inv_from]
      rw [hfrom_eq, CategoryTheory.Iso.inv_hom_id]
    let p₀ : PrimeSpectrum R := inv_from.base (default : ↥U)
    have hSpec_uniq : ∀ pt : PrimeSpectrum R, pt = p₀ := by
      intro pt
      have hu : hU_top.fromSpec.base pt = (default : ↥U) := Subsingleton.elim _ _
      have hid : (hU_top.fromSpec ≫ inv_from).base pt = pt := by
        rw [h_from_inv]
        rfl
      have hcomp : (hU_top.fromSpec ≫ inv_from).base pt =
          inv_from.base (hU_top.fromSpec.base pt) :=
        AlgebraicGeometry.Scheme.Hom.comp_apply hU_top.fromSpec inv_from pt
      exact hid.symm.trans (hcomp.trans (congrArg inv_from.base hu))
    let 𝔪 : Ideal R := p₀.asIdeal
    have hm_prime : 𝔪.IsPrime := p₀.isPrime
    have : Nontrivial R := PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨p₀⟩
    have hm_max : 𝔪.IsMaximal := by
      obtain ⟨M, hM_max, _⟩ := Ideal.exists_le_maximal (⊥ : Ideal R) bot_ne_top
      have hMp₀ : (⟨M, hM_max.isPrime⟩ : PrimeSpectrum R) = p₀ := hSpec_uniq _
      have hM_eq : M = 𝔪 := congrArg PrimeSpectrum.asIdeal hMp₀
      rwa [← hM_eq]
    have hnil_eq : nilradical R = 𝔪 := by
      rw [nilradical_eq_sInf]
      have hset : {J : Ideal R | J.IsPrime} = {𝔪} := by
        ext J
        simp only [Set.mem_singleton_iff]
        exact ⟨fun hJ => congrArg PrimeSpectrum.asIdeal (hSpec_uniq ⟨J, hJ⟩),
          fun hJ => hJ.symm ▸ hm_prime⟩
      rw [hset, sInf_singleton]
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    have hSk_top : AlgebraicGeometry.IsAffineOpen (⊤ : S_k.Opens) :=
      AlgebraicGeometry.isAffineOpen_top S_k
    have hle_k : (⊤ : U.Opens) ≤ (TopologicalSpace.Opens.map p_U.base).obj ⊤ :=
      fun _ _ => trivial
    have hFT_app : (p_U.appLE ⊤ ⊤ hle_k).hom.FiniteType :=
      AlgebraicGeometry.LocallyOfFiniteType.finiteType_appLE p_U hSk_top hU_top hle_k
    let φ_kR : k →+* R :=
      (p_U.appLE ⊤ ⊤ hle_k).hom.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom
    have hSurj_Γ :
        Function.Surjective (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom := by
      intro x
      refine ⟨(AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom x, ?_⟩
      change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom x = x
      rw [CategoryTheory.Iso.hom_inv_id]
      rfl
    have hFT_φ : φ_kR.FiniteType :=
      RingHom.FiniteType.comp hFT_app (RingHom.FiniteType.of_surjective _ hSurj_Γ)
    let _ : Algebra k R := φ_kR.toAlgebra
    have hFT_kR : Algebra.FiniteType k R := hFT_φ
