theorem weil_pbc_projLine_constructible_finite_cover_devissage (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (hA : WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A)
    (hFinCover : ∀ (Y : AlgebraicGeometry.Scheme.{u})
      (π : Y ⟶ CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
        (weilProjectiveSpaceOver k 1).hom)
      [AlgebraicGeometry.IsFinite π],
      WeilEtaleCohomologyPullbackBijective
        (CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
          (π ≫ CategoryTheory.Limits.pullback.fst
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
            (weilProjectiveSpaceOver k 1).hom))
        (weilEtaleTorsionSheaf Y ℓ) 0 ∧
      (∀ q : ℕ, 1 ≤ q →
        WeilEtaleCohomologyPullbackSurjective
          (CategoryTheory.Limits.pullback.snd
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
            (π ≫ CategoryTheory.Limits.pullback.fst
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
              (weilProjectiveSpaceOver k 1).hom))
          (weilEtaleTorsionSheaf Y ℓ) q))
    (F : CategoryTheory.Sheaf
      (CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
        (weilProjectiveSpaceOver k 1).hom).smallEtaleTopology
      AddCommGrpCat.{u})
    (q : ℕ)
    (hF_tor : ℓ • CategoryTheory.CategoryStruct.id F = 0) :
    WeilEtaleCohomologyPullbackBijective
      (CategoryTheory.Limits.pullback.snd
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
        (CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
          (weilProjectiveSpaceOver k 1).hom))
      F q :=
by
  have _ := hA.1
  let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
  let P₁ := weilProjectiveSpaceOver k 1
  let X_A := CategoryTheory.Limits.pullback s_A P₁.hom
  let p₁_A := CategoryTheory.Limits.pullback.fst s_A P₁.hom
  let ι_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom)
  let i₀ := CategoryTheory.Limits.pullback.snd ι_A p₁_A
  have hFinPBC : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S)
      [AlgebraicGeometry.IsFinite f], WeilCanonicalModPrimePBC ℓ f :=
    fun f => weil_pbc_finite_morphism ℓ f
  have hInjZero : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S)
      (I : CategoryTheory.Sheaf X.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))))
      [CategoryTheory.Injective I] (q₀ : ℕ), 1 ≤ q₀ →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f q₀
          ((CategoryTheory.Sheaf.composeAndSheafify X.smallEtaleTopology
            (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
              AddCommGrpCat.{u})).obj I)) :=
    fun f I _ q₀ hq₀ => weil_etale_mod_prime_injective_higherDirectImage_isZero ℓ f I q₀ hq₀
  obtain ⟨hColimBij, hColimZero⟩ :=
    weil_pbc_projLine_filtered_colimit_constructible_descent k ℓ A τ_A hInjZero
  have hEmbed : ∀ (R : Type u) [CommRing R] [Algebra k R] [Algebra.FiniteType k R]
      (p_R : X_A ⟶ CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R))) P₁.hom)
      (G : CategoryTheory.Sheaf
        (CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R))) P₁.hom).smallEtaleTopology
        AddCommGrpCat.{u})
      (F' : CategoryTheory.Sheaf X_A.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsConstructibleModPrimeSheaf ℓ
        (CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R))) P₁.hom) G →
      WeilIsEtaleSheafPullback p_R G F' →
      ∃ (H : CategoryTheory.Sheaf X_A.smallEtaleTopology AddCommGrpCat.{u})
        (u_A : F' ⟶ H),
        CategoryTheory.Mono u_A ∧
        ℓ • CategoryTheory.CategoryStruct.id H = 0 ∧
        WeilEtaleCohomologyPullbackBijective i₀ H 0 ∧
        (∀ r : ℕ, 1 ≤ r → WeilEtaleCohomologyPullbackSurjective i₀ H r) := by
    intro R _ _ _ p_R G F' hG hpb_F
    obtain ⟨Y_bar, π_bar, hFin_πbar, G_fin, u, hu, hIso⟩ :=
      weil_etale_projLine_finiteType_constructible_embed_finite_pushforward
        k ℓ hFinPBC R G hG
    have : AlgebraicGeometry.IsFinite π_bar := hFin_πbar
    exact weil_pbc_projLine_finite_cover_pushforward_specialization
      k ℓ A τ_A hFinPBC hInjZero hFinCover p_R Y_bar π_bar G G_fin u hu hIso F' hpb_F
  have hAll : ∀ (q₀ : ℕ)
      (F₀ : CategoryTheory.Sheaf X_A.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id F₀ = 0 →
      WeilEtaleCohomologyPullbackBijective i₀ F₀ q₀ := by
    intro q₀
    induction q₀ with
    | zero =>
      apply hColimZero
      intro R _ _ _ p_R G F' hG hpb_F
      obtain ⟨H, u_A, hu_A, hH_tor, hH0, _⟩ := hEmbed R p_R G F' hG hpb_F
      exact ⟨H, u_A, hu_A, hH_tor, hH0⟩
    | succ m ih =>
      apply hColimBij (m + 1)
      intro R _ _ _ p_R G F' hF'_tor hG hpb_F
      obtain ⟨H, u_A, hu_A, hH_tor, _, hHpos⟩ := hEmbed R p_R G F' hG hpb_F
      exact weil_etale_cohomology_pullback_effaceable_step
        k ℓ (CategoryTheory.Over.mk (p₁_A ≫ s_A)) i₀ hInjZero m ih
        F' H u_A hF'_tor hH_tor hu_A (hHpos (m + 1) (Nat.le_add_left 1 m))
  exact hAll q F hF_tor

theorem weil_etale_deg_zero_bijective_of_appTop_idempotent_bijective (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {S Y₀ Y : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine S]
    (f_Y : Y ⟶ S) [AlgebraicGeometry.IsSeparated f_Y]
    (h : Y₀ ⟶ Y) [AlgebraicGeometry.IsAffineHom h]
    (hIdem : WeilRingHomIdempotentBijective
      (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop h))) :
    WeilEtaleCohomologyPullbackBijective h (weilEtaleTorsionSheaf Y ℓ) 0 :=
by
  
  have hPart1 :
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_h : CategoryTheory.Functor Y.Etale Y₀.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
      ∃ (_hc : B_h.IsContinuous Y.smallEtaleTopology Y₀.smallEtaleTopology),
        let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} Y.smallEtaleTopology Y₀.smallEtaleTopology
        ∃ (_hr : pf_h.IsRightAdjoint),
          let pb_h := B_h.sheafPullback AddCommGrpCat.{u} Y.smallEtaleTopology Y₀.smallEtaleTopology
          pb_h.Additive ∧
          CategoryTheory.Limits.PreservesFiniteLimits pb_h ∧
          CategoryTheory.Limits.PreservesFiniteColimits pb_h := by
    let EtP : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_h : CategoryTheory.Functor Y.Etale Y₀.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    have hEtMult : CategoryTheory.MorphismProperty.IsMultiplicative EtP := inferInstance
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition EtP :=
      hEtMult.toIsStableUnderComposition
    have : CategoryTheory.MorphismProperty.ContainsIdentities EtP :=
      hEtMult.toContainsIdentities
    have hEt_mor : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {W U : Z.Etale} (g : W ⟶ U),
        AlgebraicGeometry.Etale g.left := by
      intro Z W U g
      have : CategoryTheory.MorphismProperty.HasOfPostcompProperty EtP EtP := inferInstance
      have hw_eq : g.left ≫ U.hom = W.hom := g.w
      have hcomp : EtP (g.left ≫ U.hom) := hw_eq.symm ▸ W.prop
      have hU : EtP U.hom := U.prop
      exact CategoryTheory.MorphismProperty.of_postcomp (W := EtP) (W' := EtP) g.left U.hom hU hcomp
    have hMemTop : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {U : Z.Etale} (R : CategoryTheory.Sieve U),
        R ∈ Z.smallEtaleTopology U ↔
          ∀ x : ↥U.left, ∃ (V : Z.Etale) (f : V ⟶ U), R.arrows f ∧ ∃ y : ↥V.left, f.left y = x := by
      intro Z U R
      have hEqJ :=
        @AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          EtP EtP Z hEtMult.toIsStableUnderComposition inferInstance hEtMult inferInstance inferInstance le_rfl
      have hMemPre :=
        AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := EtP) (Q := EtP) (S := Z) (X := U) (R := R)
      refine (Eq.to_iff (congrArg (fun J => R ∈ J U) hEqJ)).trans (hMemPre.trans ?_)
      exact ⟨fun h x => let ⟨V, f, y, hf, _, hy⟩ := h x; ⟨V, f, hf, y, hy⟩,
        fun h x => let ⟨V, f, hf, y, hy⟩ := h x; ⟨V, f, y, hf, hEt_mor f, hy⟩⟩
    have hPresB : CategoryTheory.Limits.PreservesFiniteLimits B_h :=
      (inferInstance : CategoryTheory.Limits.PreservesFiniteLimits
        (CategoryTheory.MorphismProperty.Over.pullback EtP ⊤ h))
    have : CategoryTheory.RepresentablyFlat B_h :=
      (CategoryTheory.preservesFiniteLimits_iff_flat B_h).mpr hPresB
    have hCovB : CategoryTheory.CoverPreserving Y.smallEtaleTopology Y₀.smallEtaleTopology B_h := by
      refine ⟨?_⟩
      intro U R hR
      rw [hMemTop]
      intro z
      let x : ↥U.left := (CategoryTheory.Limits.pullback.fst U.hom h) z
      obtain ⟨V, f, hfR, y, hy⟩ := (hMemTop R).mp hR x
      have hpb_left : CategoryTheory.IsPullback
          (B_h.map f).left
          (CategoryTheory.Limits.pullback.fst V.hom h)
          (CategoryTheory.Limits.pullback.fst U.hom h)
          f.left := by
        refine CategoryTheory.IsPullback.of_right ?_ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.IsPullback.of_hasPullback U.hom h).flip
        have hcond : (B_h.map f).left ≫ CategoryTheory.Limits.pullback.snd U.hom h =
            CategoryTheory.Limits.pullback.snd V.hom h :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hfw : f.left ≫ U.hom = V.hom := f.w
        rw [hcond, hfw]
        exact (CategoryTheory.IsPullback.of_hasPullback V.hom h).flip
      obtain ⟨w₀, hw₀, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        z y hy.symm
      let w : ↥(B_h.obj V).left := hpb_left.isoPullback.inv w₀
      refine ⟨B_h.obj V, B_h.map f,
        ⟨V, f, 𝟙 (B_h.obj V), hfR, (CategoryTheory.Category.id_comp _).symm⟩, w, ?_⟩
      have hfst : hpb_left.isoPullback.inv ≫ (B_h.map f).left =
          CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.fst U.hom h) f.left :=
        hpb_left.isoPullback_inv_fst
      have happ1 : (B_h.map f).left w = (hpb_left.isoPullback.inv ≫ (B_h.map f).left) w₀ :=
        (AlgebraicGeometry.Scheme.Hom.comp_apply hpb_left.isoPullback.inv (B_h.map f).left w₀).symm
      exact happ1.trans ((congrArg (fun k => k w₀) hfst).trans hw₀)
    have hc : B_h.IsContinuous Y.smallEtaleTopology Y₀.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving
        (CategoryTheory.compatiblePreservingOfFlat Y₀.smallEtaleTopology B_h) hCovB
    let G_aff : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
        CategoryTheory.SmallModel.{u} Z.AffineEtale ⥤ Z.Etale :=
      fun Z => (CategoryTheory.equivSmallModel.{u} Z.AffineEtale).inverse ⋙
        AlgebraicGeometry.Scheme.AffineEtale.Spec Z
    let T_obj : ∀ (Z : AlgebraicGeometry.Scheme.{u}), Z.Etale :=
      fun Z => CategoryTheory.MorphismProperty.Over.mk ⊤ (CategoryTheory.CategoryStruct.id Z)
        (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id Z))
    let ι_obj : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
        Option (CategoryTheory.SmallModel.{u} Z.AffineEtale) → Z.Etale :=
      fun Z o => Option.elim o (T_obj Z) (G_aff Z).obj
    let J_fun : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
        CategoryTheory.InducedCategory Z.Etale (ι_obj Z) ⥤ Z.Etale :=
      fun Z => CategoryTheory.inducedFunctor (ι_obj Z)
    have hJ_ff : ∀ (Z : AlgebraicGeometry.Scheme.{u}), (J_fun Z).FullyFaithful :=
      fun Z => CategoryTheory.fullyFaithfulInducedFunctor (ι_obj Z)
    have : ∀ (Z : AlgebraicGeometry.Scheme.{u}), (J_fun Z).Full :=
      fun Z => (hJ_ff Z).full
    have : ∀ (Z : AlgebraicGeometry.Scheme.{u}), (J_fun Z).Faithful :=
      fun Z => (hJ_ff Z).faithful
    let fgt_left : ∀ (Z : AlgebraicGeometry.Scheme.{u}), Z.Etale ⥤ AlgebraicGeometry.Scheme.{u} :=
      fun Z => CategoryTheory.MorphismProperty.Over.forget EtP ⊤ Z ⋙ CategoryTheory.Over.forget Z
    have hEssAff : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale) [AlgebraicGeometry.IsAffine V.left],
        ∃ u : CategoryTheory.SmallModel.{u} Z.AffineEtale, Nonempty ((G_aff Z).obj u ≅ V) := by
      intro Z V _
      let R_op : CommRingCat.{u}ᵒᵖ := Opposite.op (V.left.presheaf.obj (Opposite.op ⊤))
      have hEt_hom : EtP (V.left.isoSpec.inv ≫ V.hom) := by
        have : AlgebraicGeometry.Etale V.hom := V.prop
        infer_instance
      let A_V : Z.AffineEtale :=
        CategoryTheory.MorphismProperty.CostructuredArrow.mk (P := EtP) (Q := ⊤)
          (F := AlgebraicGeometry.Scheme.Spec) (A := R_op)
          (V.left.isoSpec.inv ≫ V.hom) hEt_hom
      let u : CategoryTheory.SmallModel.{u} Z.AffineEtale :=
        (CategoryTheory.equivSmallModel.{u} Z.AffineEtale).functor.obj A_V
      have e1 : (G_aff Z).obj u ≅ (AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj A_V :=
        (AlgebraicGeometry.Scheme.AffineEtale.Spec Z).mapIso
          ((CategoryTheory.equivSmallModel.{u} Z.AffineEtale).unitIso.symm.app A_V)
      have e2 : (AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj A_V ≅ V :=
        CategoryTheory.MorphismProperty.Over.isoMk V.left.isoSpec.symm rfl
      exact ⟨u, ⟨e1.trans e2⟩⟩
    have hJ_cd : ∀ (Z : AlgebraicGeometry.Scheme.{u}), (J_fun Z).IsCoverDense Z.smallEtaleTopology := by
      intro Z
      constructor
      intro U
      rw [hMemTop]
      intro x
      let Cov := U.left.affineCover
      let idx_x := Cov.idx x
      have : AlgebraicGeometry.IsOpenImmersion (Cov.f idx_x) := Cov.map_prop idx_x
      let V_x : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
        (Cov.f idx_x ≫ U.hom)
        (EtP.comp_mem _ _ (inferInstance : AlgebraicGeometry.Etale (Cov.f idx_x)) U.prop)
      let f_x : V_x ⟶ U := CategoryTheory.MorphismProperty.Over.homMk (Cov.f idx_x) rfl
      have : AlgebraicGeometry.IsAffine V_x.left :=
        (inferInstance : AlgebraicGeometry.IsAffine (Cov.X idx_x))
      obtain ⟨u, ⟨e_u⟩⟩ := hEssAff Z V_x
      obtain ⟨y, hy⟩ := Cov.covers x
      let u_obj : CategoryTheory.InducedCategory Z.Etale (ι_obj Z) := Option.some u
      refine ⟨(J_fun Z).obj u_obj, e_u.hom ≫ f_x,
        ⟨u_obj, 𝟙 ((J_fun Z).obj u_obj), e_u.hom ≫ f_x, CategoryTheory.Category.id_comp _⟩,
        e_u.inv.left y, ?_⟩
      have hcomp_pt : (e_u.hom ≫ f_x).left (e_u.inv.left y) =
          (e_u.inv.left ≫ e_u.hom.left ≫ Cov.f idx_x) y :=
        (AlgebraicGeometry.Scheme.Hom.comp_apply
          e_u.inv.left (e_u.hom.left ≫ Cov.f idx_x) y).symm
      have hinv_hom : e_u.inv.left ≫ e_u.hom.left = 𝟙 V_x.left :=
        ((fgt_left Z).mapIso e_u).inv_hom_id
      have h1 : (e_u.inv.left ≫ e_u.hom.left ≫ Cov.f idx_x) = Cov.f idx_x :=
        (CategoryTheory.Category.assoc e_u.inv.left e_u.hom.left (Cov.f idx_x)).symm.trans
          ((congrArg (· ≫ Cov.f idx_x) hinv_hom).trans (CategoryTheory.Category.id_comp _))
      exact hcomp_pt.trans ((congrArg (fun k => k y) h1).trans hy)
    let K_top := fun (Z : AlgebraicGeometry.Scheme.{u}) =>
      (J_fun Z).inducedTopology Z.smallEtaleTopology
    let E_sh := fun (Z : AlgebraicGeometry.Scheme.{u}) =>
      (J_fun Z).sheafInducedTopologyEquivOfIsCoverDense Z.smallEtaleTopology AddCommGrpCat.{u}
    have hIsAff_G : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (u : CategoryTheory.SmallModel.{u} Z.AffineEtale),
        AlgebraicGeometry.IsAffine ((G_aff Z).obj u).left := by
      intro Z u
      let X_aff : Z.AffineEtale := (CategoryTheory.equivSmallModel.{u} Z.AffineEtale).inverse.obj u
      change AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec X_aff.left.unop)
      infer_instance
    have hAffHom_to_Y : ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W] (w : W ⟶ Y),
        AlgebraicGeometry.IsAffineHom w := by
      intro W _ w
      have : AlgebraicGeometry.IsAffineHom (w ≫ f_Y) :=
        AlgebraicGeometry.isAffineHom_of_isAffine (w ≫ f_Y)
      exact AlgebraicGeometry.IsAffineHom.of_comp w f_Y
    have hTerm_Et : ∀ (Z : AlgebraicGeometry.Scheme.{u}), CategoryTheory.Limits.IsTerminal (T_obj Z) := by
      intro Z
      refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom (CategoryTheory.Category.comp_id U.hom)) ?_
      intro U m
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact (CategoryTheory.Category.comp_id m.left).symm.trans m.w
    let noneY : CategoryTheory.InducedCategory Y.Etale (ι_obj Y) := Option.none
    let noneY₀ : CategoryTheory.InducedCategory Y₀.Etale (ι_obj Y₀) := Option.none
    let someY : CategoryTheory.SmallModel.{u} Y.AffineEtale →
        CategoryTheory.InducedCategory Y.Etale (ι_obj Y) := Option.some
    let someY₀ : CategoryTheory.SmallModel.{u} Y₀.AffineEtale →
        CategoryTheory.InducedCategory Y₀.Etale (ι_obj Y₀) := Option.some
    have hTerm_CY : CategoryTheory.Limits.IsTerminal noneY :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun a => (hJ_ff Y).preimage ((hTerm_Et Y).from ((J_fun Y).obj a)))
        (fun a m => (J_fun Y).map_injective ((hTerm_Et Y).hom_ext _ _))
    have : CategoryTheory.Limits.HasTerminal (CategoryTheory.InducedCategory Y.Etale (ι_obj Y)) :=
      hTerm_CY.hasTerminal
    have : CategoryTheory.Limits.PreservesLimit
        (CategoryTheory.Functor.empty.{0} (CategoryTheory.InducedCategory Y.Etale (ι_obj Y))) (J_fun Y) :=
      CategoryTheory.Limits.preservesLimit_of_preserves_limit_cone hTerm_CY
        { lift := fun s => (hTerm_Et Y).from s.pt
          fac := fun _ j => nomatch j.as
          uniq := fun s m _ => (hTerm_Et Y).hom_ext m ((hTerm_Et Y).from s.pt) }
    have : CategoryTheory.Limits.PreservesLimitsOfShape
        (CategoryTheory.Discrete PEmpty.{1}) (J_fun Y) :=
      CategoryTheory.Limits.preservesLimitsOfShape_pempty_of_preservesTerminal (J_fun Y)
    have hClosed_pb_Y : ∀ {a b c : CategoryTheory.InducedCategory Y.Etale (ι_obj Y)} (p : a ⟶ c) (q : b ⟶ c),
        let A := (J_fun Y).obj a
        let p' := (J_fun Y).map p
        let q' := (J_fun Y).map q
        let fst_sch := CategoryTheory.Limits.pullback.fst p'.left q'.left
        let _ : AlgebraicGeometry.Etale p'.left := hEt_mor p'
        let _ : AlgebraicGeometry.Etale q'.left := hEt_mor q'
        let P_et : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (fst_sch ≫ A.hom)
          (EtP.comp_mem _ _ inferInstance A.prop)
        ∃ (d : CategoryTheory.InducedCategory Y.Etale (ι_obj Y)), Nonempty ((J_fun Y).obj d ≅ P_et) := by
      intro a b c p q A p' q' fst_sch _ _ P_et
      let B := (J_fun Y).obj b
      let C := (J_fun Y).obj c
      let snd_sch := CategoryTheory.Limits.pullback.snd p'.left q'.left
      cases c with
      | some u_c =>
        have hAff_C : AlgebraicGeometry.IsAffine C.left := hIsAff_G Y u_c
        have hAffHom_C : AlgebraicGeometry.IsAffineHom C.hom := @hAffHom_to_Y C.left hAff_C C.hom
        have : AlgebraicGeometry.IsSeparated C.hom :=
          @AlgebraicGeometry.IsSeparated.of_isAffineHom _ _ C.hom hAffHom_C
        have hAff_leg : ∀ (x : CategoryTheory.InducedCategory Y.Etale (ι_obj Y)) (r : x ⟶ someY u_c),
            AlgebraicGeometry.IsAffine ((J_fun Y).obj x).left := by
          intro x r
          cases x with
          | some u_x => exact hIsAff_G Y u_x
          | none =>
            have hr_w : ((J_fun Y).map r).left ≫ C.hom = CategoryTheory.CategoryStruct.id Y :=
              ((J_fun Y).map r).w
            have : AlgebraicGeometry.IsAffineHom (((J_fun Y).map r).left ≫ C.hom) :=
              hr_w.symm ▸ (inferInstance : AlgebraicGeometry.IsAffineHom (CategoryTheory.CategoryStruct.id Y))
            have : AlgebraicGeometry.IsAffineHom ((J_fun Y).map r).left :=
              AlgebraicGeometry.IsAffineHom.of_comp ((J_fun Y).map r).left C.hom
            exact @AlgebraicGeometry.isAffine_of_isAffineHom _ _ ((J_fun Y).map r).left this hAff_C
        have hAff_A : AlgebraicGeometry.IsAffine A.left := hAff_leg a p
        have hAff_B : AlgebraicGeometry.IsAffine B.left := hAff_leg b q
        have hAff_p : AlgebraicGeometry.IsAffineHom p'.left :=
          @AlgebraicGeometry.isAffineHom_of_isAffine _ _ p'.left hAff_A hAff_C
        have hAff_snd : AlgebraicGeometry.IsAffineHom snd_sch :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback p'.left q'.left) hAff_p
        have : AlgebraicGeometry.IsAffine P_et.left :=
          @AlgebraicGeometry.isAffine_of_isAffineHom _ _ snd_sch hAff_snd hAff_B
        obtain ⟨u_d, ⟨e_d⟩⟩ := hEssAff Y P_et
        exact ⟨someY u_d, ⟨e_d⟩⟩
      | none =>
        cases a with
        | none =>
          have hp_id : p'.left = CategoryTheory.CategoryStruct.id Y :=
            (CategoryTheory.Category.comp_id p'.left).symm.trans p'.w
          have : CategoryTheory.IsIso p'.left :=
            hp_id.symm ▸ (inferInstance : CategoryTheory.IsIso (CategoryTheory.CategoryStruct.id Y))
          have hIso_snd : CategoryTheory.IsIso snd_sch := inferInstance
          have hsnd_w : snd_sch ≫ B.hom = P_et.hom := by
            have hbw : q'.left ≫ CategoryTheory.CategoryStruct.id Y = B.hom := q'.w
            have hbw' : q'.left = B.hom := (CategoryTheory.Category.comp_id q'.left).symm.trans hbw
            exact (congrArg (snd_sch ≫ ·) hbw'.symm).trans
              ((CategoryTheory.Limits.pullback.condition (f := p'.left) (g := q'.left)).symm.trans
                (congrArg (fst_sch ≫ ·) hp_id))
          let e_b : P_et ≅ B := CategoryTheory.MorphismProperty.Over.isoMk
            (@CategoryTheory.asIso _ _ _ _ snd_sch hIso_snd) hsnd_w
          exact ⟨b, ⟨e_b.symm⟩⟩
        | some u_a =>
          cases b with
          | none =>
            have hq_id : q'.left = CategoryTheory.CategoryStruct.id Y :=
              (CategoryTheory.Category.comp_id q'.left).symm.trans q'.w
            have : CategoryTheory.IsIso q'.left :=
              hq_id.symm ▸ (inferInstance : CategoryTheory.IsIso (CategoryTheory.CategoryStruct.id Y))
            have hIso_fst : CategoryTheory.IsIso fst_sch := inferInstance
            let e_a : P_et ≅ A := CategoryTheory.MorphismProperty.Over.isoMk
              (@CategoryTheory.asIso _ _ _ _ fst_sch hIso_fst) rfl
            exact ⟨someY u_a, ⟨e_a.symm⟩⟩
          | some u_b =>
            have hAff_A : AlgebraicGeometry.IsAffine A.left := hIsAff_G Y u_a
            have hAff_B : AlgebraicGeometry.IsAffine B.left := hIsAff_G Y u_b
            have hAff_p : AlgebraicGeometry.IsAffineHom p'.left := @hAffHom_to_Y A.left hAff_A p'.left
            have hAff_snd : AlgebraicGeometry.IsAffineHom snd_sch :=
              CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
                (CategoryTheory.IsPullback.of_hasPullback p'.left q'.left) hAff_p
            have : AlgebraicGeometry.IsAffine P_et.left :=
              @AlgebraicGeometry.isAffine_of_isAffineHom _ _ snd_sch hAff_snd hAff_B
