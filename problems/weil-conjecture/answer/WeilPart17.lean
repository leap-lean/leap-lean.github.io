        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁₀.symm.toRingHom)).base p = p
      have hcomp : AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁₀.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁₀.symm.toRingHom) = 𝟙 _ := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← AlgebraicGeometry.Spec.map_id, ← CommRingCat.ofHom_id]
        congr 2; apply RingHom.ext; intro x; exact e₁₀.apply_symm_apply x
      rw [hcomp]; rfl
    have hu₀_range : Set.range u₀_P₁.base = (D₀_P₁ : Set P₁.left) := by
      change Set.range u₀.base = (AlgebraicGeometry.Proj.basicOpen 𝒜 (T 0) : Set (AlgebraicGeometry.Proj 𝒜))
      dsimp only [u₀]
      rw [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
        Set.range_eq_univ.mpr hsurj_e₀₁, Set.image_univ]
      exact congrArg SetLike.coe (AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (T 0) (hT 0) zero_lt_one)
    have hu₁_range : Set.range u₁_P₁.base = (D₁_P₁ : Set P₁.left) := by
      change Set.range u₁.base = (AlgebraicGeometry.Proj.basicOpen 𝒜 (T 1) : Set (AlgebraicGeometry.Proj 𝒜))
      dsimp only [u₁]
      rw [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
        Set.range_eq_univ.mpr hsurj_e₁₀, Set.image_univ]
      exact congrArg SetLike.coe (AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (T 1) (hT 1) zero_lt_one)
    have hu₀_ov : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))),
        u₀_P₁.base q ∈ D₁_P₁ ↔ Polynomial.X ∉ q.asIdeal := by
      intro q
      change q ∈ (TopologicalSpace.Opens.map u₀.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜 (T 1)) ↔ _
      dsimp [u₀]
      rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hT 0) zero_lt_one (hT 1) zero_lt_one,
        AlgebraicGeometry.SpecMap_preimage_basicOpen]
      have hsymm : e₀₁.symm (HomogeneousLocalization.Away.isLocalizationElem (hT 0) (hT 1)) = Polynomial.X := by
        rw [← he₀₁_X, e₀₁.symm_apply_apply]
      let q' : PrimeSpectrum (Polynomial k) := q
      change q' ∈
        PrimeSpectrum.basicOpen (e₀₁.symm (HomogeneousLocalization.Away.isLocalizationElem (hT 0) (hT 1))) ↔
          Polynomial.X ∉ q'.asIdeal
      rw [hsymm]
      exact PrimeSpectrum.mem_basicOpen Polynomial.X q'
    have hu₁_ov : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))),
        u₁_P₁.base q ∈ D₀_P₁ ↔ Polynomial.X ∉ q.asIdeal := by
      intro q
      change q ∈ (TopologicalSpace.Opens.map u₁.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜 (T 0)) ↔ _
      dsimp [u₁]
      rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hT 1) zero_lt_one (hT 0) zero_lt_one,
        AlgebraicGeometry.SpecMap_preimage_basicOpen]
      have hsymm : e₁₀.symm (HomogeneousLocalization.Away.isLocalizationElem (hT 1) (hT 0)) = Polynomial.X := by
        rw [← he₁₀_X, e₁₀.symm_apply_apply]
      let q' : PrimeSpectrum (Polynomial k) := q
      change q' ∈
        PrimeSpectrum.basicOpen (e₁₀.symm (HomogeneousLocalization.Away.isLocalizationElem (hT 1) (hT 0))) ↔
          Polynomial.X ∉ q'.asIdeal
      rw [hsymm]
      exact PrimeSpectrum.mem_basicOpen Polynomial.X q'
    let inl_P : CommRingCat.of A ⟶ CommRingCat.of (Polynomial A) :=
      CommRingCat.ofHom Polynomial.C
    let inr_P : CommRingCat.of (Polynomial k) ⟶ CommRingCat.of (Polynomial A) :=
      CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap k A))
    have hPush_w : CommRingCat.ofHom (algebraMap k A) ≫ inl_P =
        CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k) ≫ inr_P := by
      dsimp [inl_P, inr_P]
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 1; apply RingHom.ext; intro c; simp
    have hPush_Poly : CategoryTheory.IsPushout
        (CommRingCat.ofHom (algebraMap k A))
        (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
        inl_P inr_P :=
      { w := hPush_w
        isColimit' := ⟨CategoryTheory.Limits.PushoutCocone.IsColimit.mk hPush_w
          (fun s => CommRingCat.ofHom (Polynomial.eval₂RingHom s.inl.hom (s.inr.hom Polynomial.X)))
          (fun s => by
            apply CommRingCat.Hom.ext; apply RingHom.ext; intro a
            change (Polynomial.eval₂RingHom s.inl.hom (s.inr.hom Polynomial.X)) (Polynomial.C a) = s.inl.hom a
            simp)
          (fun s => by
            apply CommRingCat.Hom.ext; apply Polynomial.ringHom_ext
            · intro c
              have hc : s.inl.hom (algebraMap k A c) = s.inr.hom (Polynomial.C c) :=
                congrArg (fun f => f.hom c) s.condition
              change (Polynomial.eval₂RingHom s.inl.hom (s.inr.hom Polynomial.X))
                (Polynomial.map (algebraMap k A) (Polynomial.C c)) = s.inr.hom (Polynomial.C c)
              simp [hc]
            · change (Polynomial.eval₂RingHom s.inl.hom (s.inr.hom Polynomial.X))
                (Polynomial.map (algebraMap k A) Polynomial.X) = s.inr.hom Polynomial.X
              simp)
          (fun s m hm₁ hm₂ => by
            apply CommRingCat.Hom.ext; apply Polynomial.ringHom_ext
            · intro a
              have ha : m.hom (Polynomial.C a) = s.inl.hom a := congrArg (fun f => f.hom a) hm₁
              change m.hom (Polynomial.C a) =
                (Polynomial.eval₂RingHom s.inl.hom (s.inr.hom Polynomial.X)) (Polynomial.C a)
              simp [ha]
            · have hX : m.hom ((Polynomial.map (algebraMap k A)) Polynomial.X) = s.inr.hom Polynomial.X :=
                congrArg (fun f => f.hom Polynomial.X) hm₂
              rw [Polynomial.map_X] at hX
              change m.hom Polynomial.X =
                (Polynomial.eval₂RingHom s.inl.hom (s.inr.hom Polynomial.X)) Polynomial.X
              simp [hX])⟩ }
    have hPB_Poly : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map inl_P)
        (AlgebraicGeometry.Spec.map inr_P)
        s_A
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))) :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_Poly
    let w₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A)) ⟶ X_A :=
      CategoryTheory.Limits.pullback.lift
        (AlgebraicGeometry.Spec.map inl_P)
        (AlgebraicGeometry.Spec.map inr_P ≫ u₀_P₁)
        (by rw [CategoryTheory.Category.assoc, hu₀_hom, hPB_Poly.w])
    let w₁ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A)) ⟶ X_A :=
      CategoryTheory.Limits.pullback.lift
        (AlgebraicGeometry.Spec.map inl_P)
        (AlgebraicGeometry.Spec.map inr_P ≫ u₁_P₁)
        (by rw [CategoryTheory.Category.assoc, hu₁_hom, hPB_Poly.w])
    have hw₀_pA : w₀ ≫ p_A = AlgebraicGeometry.Spec.map inl_P :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hw₁_pA : w₁ ≫ p_A = AlgebraicGeometry.Spec.map inl_P :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hw₀_p₂ : w₀ ≫ p₂ = AlgebraicGeometry.Spec.map inr_P ≫ u₀_P₁ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hw₁_p₂ : w₁ ≫ p₂ = AlgebraicGeometry.Spec.map inr_P ≫ u₁_P₁ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPB_w₀ : CategoryTheory.IsPullback w₀ (AlgebraicGeometry.Spec.map inr_P) p₂ u₀_P₁ := by
      refine CategoryTheory.IsPullback.of_right ?_ hw₀_p₂
        (CategoryTheory.IsPullback.of_hasPullback s_A P₁.hom)
      rw [hw₀_pA, hu₀_hom]
      exact hPB_Poly
    have hPB_w₁ : CategoryTheory.IsPullback w₁ (AlgebraicGeometry.Spec.map inr_P) p₂ u₁_P₁ := by
      refine CategoryTheory.IsPullback.of_right ?_ hw₁_p₂
        (CategoryTheory.IsPullback.of_hasPullback s_A P₁.hom)
      rw [hw₁_pA, hu₁_hom]
      exact hPB_Poly
    have : AlgebraicGeometry.IsOpenImmersion w₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPB_w₀.flip inferInstance
    have : AlgebraicGeometry.IsOpenImmersion w₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPB_w₁.flip inferInstance
    have hRange_of_PB : ∀ {P Q R S : AlgebraicGeometry.Scheme.{u}}
        (fst : P ⟶ Q) (snd : P ⟶ R) (f : Q ⟶ S) (g : R ⟶ S),
        [AlgebraicGeometry.IsOpenImmersion g] →
        CategoryTheory.IsPullback fst snd f g →
        Set.range fst.base = f.base ⁻¹' (Set.range g.base) := by
      intro P Q R S fst snd f g _ hpb
      ext z
      constructor
      · rintro ⟨x, rfl⟩
        change (fst ≫ f).base x ∈ Set.range g.base
        rw [hpb.w]
        exact ⟨snd.base x, rfl⟩
      · intro hz
        let sz := Q.fromSpecResidueField z
        have hsub : Set.range (sz ≫ f).base ⊆ Set.range g.base := by
          rw [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
            AlgebraicGeometry.Scheme.range_fromSpecResidueField]
          rintro _ ⟨w, hw, rfl⟩
          rw [Set.mem_singleton_iff.mp hw]
          exact hz
        let lg := AlgebraicGeometry.IsOpenImmersion.lift g (sz ≫ f) hsub
        let lp := hpb.lift sz lg (AlgebraicGeometry.IsOpenImmersion.lift_fac g (sz ≫ f) hsub).symm
        have hlp : lp ≫ fst = sz := hpb.lift_fst _ _ _
        have hz_mem : z ∈ Set.range sz.base := by
          rw [AlgebraicGeometry.Scheme.range_fromSpecResidueField]
          exact rfl
        rw [← hlp] at hz_mem
        rcases hz_mem with ⟨pt, hpt⟩
        exact ⟨lp.base pt, hpt⟩
    have hw₀_range : Set.range w₀.base = p₂.base ⁻¹' (D₀_P₁ : Set P₁.left) := by
      rw [hRange_of_PB w₀ _ p₂ u₀_P₁ hPB_w₀, hu₀_range]
    have hw₁_range : Set.range w₁.base = p₂.base ⁻¹' (D₁_P₁ : Set P₁.left) := by
      rw [hRange_of_PB w₁ _ p₂ u₁_P₁ hPB_w₁, hu₁_range]
    have hw_cov : Set.range w₀.base ∪ Set.range w₁.base = Set.univ := by
      rw [hw₀_range, hw₁_range, ← Set.preimage_union]
      ext z
      simp only [Set.mem_preimage, Set.mem_union, Set.mem_univ, iff_true]
      let pz : ↥(AlgebraicGeometry.Proj 𝒜) := p₂.base z
      have hmem : pz ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜).Opens) := trivial
      rw [← hcov_P₁, TopologicalSpace.Opens.mem_iSup] at hmem
      rcases hmem with ⟨i, hi⟩
      fin_cases i
      · exact Or.inl hi
      · exact Or.inr hi
    have hw₀_ov : ∀ p : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A))),
        w₀.base p ∈ Set.range w₁.base ↔ Polynomial.X ∉ p.asIdeal := by
      intro p
      rw [hw₁_range, Set.mem_preimage]
      change (w₀ ≫ p₂).base p ∈ D₁_P₁ ↔ _
      rw [hw₀_p₂, AlgebraicGeometry.Scheme.Hom.comp_apply, hu₀_ov]
      change Polynomial.X ∉ (PrimeSpectrum.comap (Polynomial.mapRingHom (algebraMap k A)) p).asIdeal ↔ _
      simp [PrimeSpectrum.comap, inr_P]
    have hw₁_ov : ∀ p : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A))),
        w₁.base p ∈ Set.range w₀.base ↔ Polynomial.X ∉ p.asIdeal := by
      intro p
      rw [hw₀_range, Set.mem_preimage]
      change (w₁ ≫ p₂).base p ∈ D₀_P₁ ↔ _
      rw [hw₁_p₂, AlgebraicGeometry.Scheme.Hom.comp_apply, hu₁_ov]
      change Polynomial.X ∉ (PrimeSpectrum.comap (Polynomial.mapRingHom (algebraMap k A)) p).asIdeal ↔ _
      simp [PrimeSpectrum.comap, inr_P]
    have hT₀₁ : T 0 * T 1 ∈ 𝒜 2 := SetLike.mul_mem_graded (hT 0) (hT 1)
    have hw_recip : ∀ (R : Type u) [CommRing R] (φ₀ φ₁ : Polynomial A →+* R),
        (∀ a : A, φ₀ (Polynomial.C a) = φ₁ (Polynomial.C a)) →
        φ₀ Polynomial.X * φ₁ Polynomial.X = 1 →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ w₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ w₁ := by
      intro R _ φ₀ φ₁ hC hX
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hw₀_pA, hw₁_pA,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        congr 2; apply RingHom.ext; intro a; exact hC a
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hw₀_p₂, hw₁_p₂]
        let ev_R : MvPolynomial (Fin 2) k →+* R :=
          MvPolynomial.eval₂Hom ((φ₀.comp Polynomial.C).comp (algebraMap k A))
            (fun m => if m = 0 then 1 else φ₀ Polynomial.X)
        have hu_T₀₁ : IsUnit (ev_R (T 0 * T 1)) := by
          have hval : ev_R (T 0 * T 1) = φ₀ Polynomial.X := by simp [ev_R, T]
          rw [hval]
          exact ⟨Units.mkOfMulEqOne (φ₀ Polynomial.X) (φ₁ Polynomial.X) hX, rfl⟩
        have hev_pow : ∀ y : Submonoid.powers (T 0 * T 1), IsUnit (ev_R y) := by
          rintro ⟨_, n, rfl⟩
          change IsUnit (ev_R ((T 0 * T 1) ^ n))
          rw [map_pow]
          exact hu_T₀₁.pow n
        let ψ₀₁_loc : Localization (Submonoid.powers (T 0 * T 1)) →+* R :=
          IsLocalization.lift (M := Submonoid.powers (T 0 * T 1)) hev_pow
        let ψ₀₁ : HomogeneousLocalization.Away 𝒜 (T 0 * T 1) →+* R :=
          ψ₀₁_loc.comp (valHom (Submonoid.powers (T 0 * T 1)))
        have hψ₀₁_mk : ∀ (n : ℕ) (a : MvPolynomial (Fin 2) k) (ha : a ∈ 𝒜 (n • 2)),
            ψ₀₁ (HomogeneousLocalization.Away.mk 𝒜 hT₀₁ n a ha) =
              ev_R a * (φ₁ Polynomial.X) ^ n := by
          intro n a ha
          change ψ₀₁_loc (HomogeneousLocalization.val (HomogeneousLocalization.Away.mk 𝒜 hT₀₁ n a ha)) = _
          rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply,
            IsLocalization.lift_mk'_spec]
          have hval : ev_R ((T 0 * T 1) ^ n) = (φ₀ Polynomial.X) ^ n := by
            rw [map_pow]; congr 1; simp [ev_R, T]
          change ev_R a = ev_R ((T 0 * T 1) ^ n) * (ev_R a * (φ₁ Polynomial.X) ^ n)
          rw [hval, ← mul_assoc, mul_comm ((φ₀ Polynomial.X) ^ n) (ev_R a), mul_assoc,
            ← mul_pow, hX, one_pow, mul_one]
        let am₀ := HomogeneousLocalization.awayMap 𝒜 (hT 1) (rfl : T 0 * T 1 = T 0 * T 1)
        let am₁ := HomogeneousLocalization.awayMap 𝒜 (hT 0) (mul_comm (T 0) (T 1))
        have hcomp₀ : ψ₀₁.comp am₀ =
            (φ₀.comp (Polynomial.mapRingHom (algebraMap k A))).comp e₀₁.symm.toRingHom := by
          apply RingHom.ext
          intro z
          obtain ⟨p, rfl⟩ := e₀₁.surjective z
          revert p
          suffices hpoly : (ψ₀₁.comp am₀).comp e₀₁.toRingHom =
              φ₀.comp (Polynomial.mapRingHom (algebraMap k A)) from
            fun p => by simpa using RingHom.congr_fun hpoly p
          apply Polynomial.ringHom_ext
          · intro c
            simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
            change ψ₀₁ (am₀ (e₀₁ (Polynomial.C c))) = _
            rw [he₀₁_C c]
            have hzero : am₀ (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (T 0))
                (algebraMap k ↥(𝒜 0) c)) =
                HomogeneousLocalization.Away.mk 𝒜 hT₀₁ 0 (MvPolynomial.C c)
                  ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_C (Fin 2) c)) := by
              rw [HomogeneousLocalization.awayMap_fromZeroRingHom]
              apply HomogeneousLocalization.val_injective
              rw [HomogeneousLocalization.Away.val_mk]; rfl
            rw [hzero, hψ₀₁_mk]
            simp [ev_R]
          · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X]
            change ψ₀₁ (am₀ (e₀₁ Polynomial.X)) = _
            rw [he₀₁_X]
            have ht : HomogeneousLocalization.Away.isLocalizationElem (hT 0) (hT 1) =
                HomogeneousLocalization.Away.mk 𝒜 (hT 0) 1 (T 1) (by simpa using hT 1) := by
              apply HomogeneousLocalization.val_injective
              rw [HomogeneousLocalization.Away.val_mk]
              simp [pow_one]
            rw [ht, HomogeneousLocalization.awayMap_mk, hψ₀₁_mk]
            simp only [ev_R, T, pow_one, map_mul, MvPolynomial.eval₂Hom_X',
              show (1 : Fin 2) ≠ 0 by decide, ↓reduceIte]
            calc
              (φ₀ Polynomial.X * φ₀ Polynomial.X) * φ₁ Polynomial.X =
                  φ₀ Polynomial.X * (φ₀ Polynomial.X * φ₁ Polynomial.X) := by ring
              _ = φ₀ Polynomial.X := by rw [hX, mul_one]
        have hcomp₁ : ψ₀₁.comp am₁ =
            (φ₁.comp (Polynomial.mapRingHom (algebraMap k A))).comp e₁₀.symm.toRingHom := by
          apply RingHom.ext
          intro z
          obtain ⟨p, rfl⟩ := e₁₀.surjective z
          revert p
          suffices hpoly : (ψ₀₁.comp am₁).comp e₁₀.toRingHom =
              φ₁.comp (Polynomial.mapRingHom (algebraMap k A)) from
            fun p => by simpa using RingHom.congr_fun hpoly p
          apply Polynomial.ringHom_ext
          · intro c
            simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
            change ψ₀₁ (am₁ (e₁₀ (Polynomial.C c))) = _
            rw [he₁₀_C c]
            have hzero : am₁ (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (T 1))
                (algebraMap k ↥(𝒜 0) c)) =
                HomogeneousLocalization.Away.mk 𝒜 hT₀₁ 0 (MvPolynomial.C c)
                  ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_C (Fin 2) c)) := by
              rw [HomogeneousLocalization.awayMap_fromZeroRingHom]
              apply HomogeneousLocalization.val_injective
              rw [HomogeneousLocalization.Away.val_mk]; rfl
            rw [hzero, hψ₀₁_mk]
            simp [ev_R, hC]
          · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X]
            change ψ₀₁ (am₁ (e₁₀ Polynomial.X)) = _
            rw [he₁₀_X]
            have ht : HomogeneousLocalization.Away.isLocalizationElem (hT 1) (hT 0) =
                HomogeneousLocalization.Away.mk 𝒜 (hT 1) 1 (T 0) (by simpa using hT 0) := by
              apply HomogeneousLocalization.val_injective
              rw [HomogeneousLocalization.Away.val_mk]
              simp [HomogeneousLocalization.Away.isLocalizationElem, pow_one]
            rw [ht, HomogeneousLocalization.awayMap_mk, hψ₀₁_mk]
            simp [ev_R, T]
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫
            AlgebraicGeometry.Spec.map inr_P ≫ u₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫
            AlgebraicGeometry.Spec.map inr_P ≫ u₁
        dsimp only [u₀, u₁, inr_P]
        rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        have hhom₀ : CommRingCat.ofHom e₀₁.symm.toRingHom ≫
            (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap k A)) ≫ CommRingCat.ofHom φ₀) =
            CommRingCat.ofHom am₀ ≫ CommRingCat.ofHom ψ₀₁ := by
          rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
          exact congrArg CommRingCat.ofHom hcomp₀.symm
        have hhom₁ : CommRingCat.ofHom e₁₀.symm.toRingHom ≫
            (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap k A)) ≫ CommRingCat.ofHom φ₁) =
            CommRingCat.ofHom am₁ ≫ CommRingCat.ofHom ψ₀₁ := by
          rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
          exact congrArg CommRingCat.ofHom hcomp₁.symm
        rw [hhom₀, hhom₁, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hT 0) zero_lt_one (hT 1) rfl,
          AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hT 1) zero_lt_one (hT 0) (mul_comm (T 0) (T 1))]
    have hw_recip_inv : ∀ (R : Type u) [CommRing R] (φ₀ φ₁ : Polynomial A →+* R),
