      let u₁ : Z_obj W ⟶ F_U := Abelian.Ext.addEquiv₀ α₁
      let u₂ : Z_obj W ⟶ F_U := Abelian.Ext.addEquiv₀ α₂
      have hu : Abelian.Ext.addEquiv₀ (α₁ + α₂) = u₁ + u₂ :=
