  have hu_nzd : ∀ y : D.R₁, u * y = 0 → y = 0 := by
    intro y hy
    obtain ⟨f, rfl⟩ := hb₁_bij.2 y
    have hXf : (Finset.univ.sum fun j : Fin D.r =>
        algebraMap (Polynomial A) D.R₁ (Polynomial.X * f j) * D.b₁ j) =
