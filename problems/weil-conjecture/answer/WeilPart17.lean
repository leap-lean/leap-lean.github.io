  have hConjHomEquiv : ∀ {D₁ D₂ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} D₁]
      [CategoryTheory.Category.{u + 1, u + 1} D₂]
      {L₁ L₂ : CategoryTheory.Functor D₁ D₂}
      {R₁ R₂ : CategoryTheory.Functor D₂ D₁}
      (adj₁ : L₁ ⊣ R₁) (adj₂ : L₂ ⊣ R₂)
      (a : R₁ ⟶ R₂) (M : D₁) (N : D₂) (w : L₁.obj M ⟶ N),
      (adj₂.homEquiv M N)
        (((CategoryTheory.conjugateEquiv adj₁ adj₂).symm a).app M ≫ w) =
      (adj₁.homEquiv M N) w ≫ a.app N := by
    intro D₁ D₂ _ _ L₁ L₂ R₁ R₂ adj₁ adj₂ a M N w
    have hnat₁ : adj₂.unit.app M ≫ R₂.map (L₂.map (adj₁.unit.app M)) =
        adj₁.unit.app M ≫ adj₂.unit.app (R₁.obj (L₁.obj M)) :=
      (adj₂.unit.naturality (adj₁.unit.app M)).symm
    have hnat₂ : adj₂.unit.app (R₁.obj (L₁.obj M)) ≫ R₂.map (L₂.map (a.app (L₁.obj M))) =
        a.app (L₁.obj M) ≫ adj₂.unit.app (R₂.obj (L₁.obj M)) :=
      (adj₂.unit.naturality (a.app (L₁.obj M))).symm
    calc
      (adj₂.homEquiv M N) (((CategoryTheory.conjugateEquiv adj₁ adj₂).symm a).app M ≫ w)
        = adj₂.unit.app M ≫ R₂.map (L₂.map (adj₁.unit.app M) ≫
            L₂.map (a.app (L₁.obj M)) ≫ adj₂.counit.app (L₁.obj M)) ≫ R₂.map w := by
          rw [CategoryTheory.conjugateEquiv_symm_apply_app,
            CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_comp]
      _ = (adj₂.unit.app M ≫ R₂.map (L₂.map (adj₁.unit.app M))) ≫
            R₂.map (L₂.map (a.app (L₁.obj M))) ≫
            R₂.map (adj₂.counit.app (L₁.obj M)) ≫ R₂.map w := by
          simp only [CategoryTheory.Functor.map_comp, CategoryTheory.Category.assoc]
      _ = adj₁.unit.app M ≫ (adj₂.unit.app (R₁.obj (L₁.obj M)) ≫
            R₂.map (L₂.map (a.app (L₁.obj M)))) ≫
            R₂.map (adj₂.counit.app (L₁.obj M)) ≫ R₂.map w := by
          rw [hnat₁]
          simp only [CategoryTheory.Category.assoc]
      _ = adj₁.unit.app M ≫ a.app (L₁.obj M) ≫
            (adj₂.unit.app (R₂.obj (L₁.obj M)) ≫ R₂.map (adj₂.counit.app (L₁.obj M))) ≫
            R₂.map w := by
          rw [hnat₂]
          simp only [CategoryTheory.Category.assoc]
      _ = adj₁.unit.app M ≫ (a.app (L₁.obj M) ≫ R₂.map w) := by
          rw [adj₂.right_triangle_components (L₁.obj M), CategoryTheory.Category.id_comp]
      _ = (adj₁.unit.app M ≫ R₁.map w) ≫ a.app N := by
          rw [← a.naturality w, CategoryTheory.Category.assoc]
      _ = (adj₁.homEquiv M N) w ≫ a.app N := by
          rw [← CategoryTheory.Adjunction.homEquiv_unit adj₁ M N w]

  
  have hMateCounit : ∀ {C_S C_X C_S' C_X' : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C_S]
      [CategoryTheory.Category.{u + 1, u + 1} C_X]
      [CategoryTheory.Category.{u + 1, u + 1} C_S']
      [CategoryTheory.Category.{u + 1, u + 1} C_X']
      {pb_f : CategoryTheory.Functor C_S C_X} {pf_f : CategoryTheory.Functor C_X C_S}
      {pb_g : CategoryTheory.Functor C_S C_S'} {pf_g : CategoryTheory.Functor C_S' C_S}
      {pb_f' : CategoryTheory.Functor C_S' C_X'} {pf_f' : CategoryTheory.Functor C_X' C_S'}
      {pb_g' : CategoryTheory.Functor C_X C_X'} {pf_g' : CategoryTheory.Functor C_X' C_X}
      (adj_f : pb_f ⊣ pf_f) (adj_g : pb_g ⊣ pf_g)
      (adj_f' : pb_f' ⊣ pf_f') (adj_g' : pb_g' ⊣ pf_g')
      (a : CategoryTheory.Functor.comp pf_g' pf_f ⟶ CategoryTheory.Functor.comp pf_f' pf_g)
      (E : C_X),
      let θ := (CategoryTheory.conjugateEquiv (adj_f.comp adj_g') (adj_g.comp adj_f')).symm a
      let bc_a := (adj_g.homEquiv (pf_f.obj E) (pf_f'.obj (pb_g'.obj E))).symm
        (pf_f.map (adj_g'.unit.app E) ≫ a.app (pb_g'.obj E))
      pb_f'.map bc_a ≫ adj_f'.counit.app (pb_g'.obj E) =
        θ.app (pf_f.obj E) ≫ pb_g'.map (adj_f.counit.app E) := by
    intro C_S C_X C_S' C_X' _ _ _ _ pb_f pf_f pb_g pf_g pb_f' pf_f' pb_g' pf_g'
      adj_f adj_g adj_f' adj_g' a E θ bc_a
    apply ((adj_g.comp adj_f').homEquiv (pf_f.obj E) (pb_g'.obj E)).injective
    have hL : ((adj_g.comp adj_f').homEquiv (pf_f.obj E) (pb_g'.obj E))
        (pb_f'.map bc_a ≫ adj_f'.counit.app (pb_g'.obj E)) =
        pf_f.map (adj_g'.unit.app E) ≫ a.app (pb_g'.obj E) := by
      rw [CategoryTheory.Adjunction.comp_homEquiv]
      dsimp only [Equiv.trans_apply]
      rw [← CategoryTheory.Adjunction.homEquiv_counit adj_f',
        Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    have hR : ((adj_g.comp adj_f').homEquiv (pf_f.obj E) (pb_g'.obj E))
        (θ.app (pf_f.obj E) ≫ pb_g'.map (adj_f.counit.app E)) =
        pf_f.map (adj_g'.unit.app E) ≫ a.app (pb_g'.obj E) := by
      dsimp only [θ]
      rw [hConjHomEquiv (adj_f.comp adj_g') (adj_g.comp adj_f') a
        (pf_f.obj E) (pb_g'.obj E) (pb_g'.map (adj_f.counit.app E))]
      congr 1
      rw [CategoryTheory.Adjunction.comp_homEquiv]
      dsimp only [Equiv.trans_apply]
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
      have hnat : adj_g'.unit.app (pb_f.obj (pf_f.obj E)) ≫
          pf_g'.map (pb_g'.map (adj_f.counit.app E)) =
          adj_f.counit.app E ≫ adj_g'.unit.app E :=
        (adj_g'.unit.naturality (adj_f.counit.app E)).symm
      rw [hnat, pf_f.map_comp, ← CategoryTheory.Category.assoc,
        adj_f.right_triangle_components E, CategoryTheory.Category.id_comp]
    exact hL.trans hR.symm

  
  have hSquareInv : ∀ {C_S C_X C_S' C_X' : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C_S]
      [CategoryTheory.Category.{u + 1, u + 1} C_X]
      [CategoryTheory.Category.{u + 1, u + 1} C_S']
      [CategoryTheory.Category.{u + 1, u + 1} C_X']
      {pb_f : CategoryTheory.Functor C_S C_X} {pf_f : CategoryTheory.Functor C_X C_S}
      {pb_g : CategoryTheory.Functor C_S C_S'} {pf_g : CategoryTheory.Functor C_S' C_S}
      {pb_f' : CategoryTheory.Functor C_S' C_X'} {pf_f' : CategoryTheory.Functor C_X' C_S'}
      {pb_g' : CategoryTheory.Functor C_X C_X'} {pf_g' : CategoryTheory.Functor C_X' C_X}
      (adj_f : pb_f ⊣ pf_f) (adj_g : pb_g ⊣ pf_g)
      (adj_f' : pb_f' ⊣ pf_f') (adj_g' : pb_g' ⊣ pf_g')
      (e_R : CategoryTheory.Functor.comp pf_g' pf_f ⟶ CategoryTheory.Functor.comp pf_f' pf_g)
      {F_S : C_S} {F_X : C_X} {F_S' : C_S'} {F_X' : C_X'}
      (u_f : F_S ⟶ pf_f.obj F_X) (u_g : F_S ⟶ pf_g.obj F_S')
      (u_f' : F_S' ⟶ pf_f'.obj F_X') (u_g' : F_X ⟶ pf_g'.obj F_X'),
      (u_f ≫ pf_f.map u_g') ≫ e_R.app F_X' = u_g ≫ pf_g.map u_f' →
      let c_f := (adj_f.homEquiv F_S F_X).symm u_f
      let c_g := (adj_g.homEquiv F_S F_S').symm u_g
      let c_f' := (adj_f'.homEquiv F_S' F_X').symm u_f'
      let c_g' := (adj_g'.homEquiv F_X F_X').symm u_g'
      let θ := (CategoryTheory.conjugateEquiv (adj_f.comp adj_g') (adj_g.comp adj_f')).symm e_R
      ∀ (hc_f : CategoryTheory.IsIso c_f) (hc_g : CategoryTheory.IsIso c_g)
        (hc_f' : CategoryTheory.IsIso c_f') (hc_g' : CategoryTheory.IsIso c_g'),
