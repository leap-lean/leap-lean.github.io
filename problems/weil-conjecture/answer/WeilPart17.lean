            (Ideal.mul_mem_right r _ (Ideal.subset_span (by simp)))
        rwa [map_sub, hgr0, sub_zero] at hmap_eq
      · intro hb_mem
        have hcomp : algebraMap A B_near = (Ideal.Quotient.mk I_near).comp c_A := rfl
        rw [hcomp, ← Ideal.map_map] at hb_mem
        have hle : Ideal.map (Ideal.Quotient.mk I_near) (Ideal.map c_A 𝔪_A) ≤
            RingHom.ker π_near' := by
          rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
          intro a ha
          rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.mem_ker, Ideal.quotientMap_mk,
            Ideal.Quotient.eq_zero_iff_mem]
          have ha_ker : c_A a ∈ RingHom.ker π₀ := by
            rw [hπ₀_ker]; exact Ideal.mem_map_of_mem c_A ha
          rw [RingHom.mem_ker.mp ha_ker]
          exact Ideal.zero_mem _
        have := hle hb_mem
        rwa [RingHom.mem_ker, Ideal.quotientMap_mk, Ideal.Quotient.eq_zero_iff_mem] at this
    let e0_Q : Q₀ := Ideal.Quotient.mk (Ideal.span {g₀}) e₀
    have he0_idem : IsIdempotentElem e0_Q := by
      rw [IsIdempotentElem, ← map_mul, Ideal.Quotient.eq]
      have : e₀ * e₀ - e₀ = -(e₀ * (1 - e₀)) := by ring
      rw [this]
      exact Submodule.neg_mem _ he₀_idem
    obtain ⟨ε_near, hε_idem, hε_red⟩ :=
      hIdem B_near Q₀ π_near' hπ_near_surj hπ_near_ker e0_Q he0_idem
    obtain ⟨e₁, rfl⟩ := Ideal.Quotient.mk_surjective ε_near
    have he₁_idem : e₁ * (1 - e₁) ∈ I_near := by
      rw [IsIdempotentElem, ← map_mul, Ideal.Quotient.eq] at hε_idem
      have : e₁ * (1 - e₁) = -(e₁ * e₁ - e₁) := by ring
      rw [this]
      exact Submodule.neg_mem I_near hε_idem
    have he₁_red : π₀ e₁ - e₀ ∈ Ideal.span {g₀} := by
      rw [Ideal.quotientMap_mk] at hε_red
      exact Ideal.Quotient.eq.mp hε_red
    let a_near : D.R₀ := algebraMap (Polynomial A) D.R₀ (u_P * G_near)
    let a_far : D.R₀ := algebraMap (Polynomial A) D.R₀ (v_P * G_far)
    have ha_sum : a_near + a_far = 1 := by
      dsimp [a_near, a_far]
      rw [← map_add, huv_P, map_one]
    have htG_afar : t_G * a_far ∈ Ideal.span {g} := by
      dsimp [t_G, a_far]
      rw [← map_mul, show G_near * (v_P * G_far) = v_P * (G_near * G_far) by ring,
        ← hPg_fac, map_mul]
      exact Ideal.mul_mem_left _ _ hPg_mem
    have hanear_afar : a_near * a_far ∈ Ideal.span {g} := by
      have : a_near * a_far = algebraMap (Polynomial A) D.R₀ u_P * (t_G * a_far) := by
        dsimp [a_near, t_G]; rw [map_mul]; ring
      rw [this]
      exact Ideal.mul_mem_left _ _ htG_afar
    let e' : D.R₀ := a_near + a_far * e₁
    have h1_sub_e' : 1 - e' = a_far * (1 - e₁) := by
      dsimp [e']
      calc
        1 - (a_near + a_far * e₁) = (a_near + a_far) - (a_near + a_far * e₁) := by rw [ha_sum]
        _ = a_far * (1 - e₁) := by ring
    have he'_idem : e' * (1 - e') ∈ Ideal.span {g} := by
      have hI_mem : ∀ z ∈ I_near, a_far * z ∈ Ideal.span {g} := by
        intro z hz
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
        · rintro _ (rfl | rfl)
          · exact Ideal.mul_mem_left _ a_far (Ideal.subset_span rfl)
          · rw [mul_comm]; exact htG_afar
        · simp
        · intro u v _ _ hu hv; rw [mul_add]; exact Ideal.add_mem _ hu hv
        · intro r₀ u _ hu
