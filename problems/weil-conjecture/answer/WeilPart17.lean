      {E E' F F' : WeilTwoChartLineBundle D},
      WeilTwoChartIso D E E' → WeilTwoChartIso D F F' →
      WeilTwoChartIso D (WeilTwoChartMul D E F) (WeilTwoChartMul D E' F') := by
    intro B _ D E E' F F' ⟨e₀, e₁, hE⟩ ⟨f₀, f₁, hF⟩
    refine ⟨TensorProduct.congr e₀ f₀, TensorProduct.congr e₁ f₁, ?_⟩
    apply eq_of_one_tmul₂ (M := E.L₀) (N := F.L₀)
    intro x y
    have hEx : E'.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] e₀ x) =
        LinearEquiv.baseChange D.R₁ D.R₀₁ E.L₁ E'.L₁ e₁ (E.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] x)) := by
      have := LinearEquiv.congr_fun hE ((1 : D.R₀₁) ⊗ₜ[D.R₀] x)
      simpa [LinearEquiv.trans_apply] using this
    have hFy : F'.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] f₀ y) =
        LinearEquiv.baseChange D.R₁ D.R₀₁ F.L₁ F'.L₁ f₁ (F.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] y)) := by
      have := LinearEquiv.congr_fun hF ((1 : D.R₀₁) ⊗ₜ[D.R₀] y)
      simpa [LinearEquiv.trans_apply] using this
    change (TensorProduct.AlgebraTensorModule.distribBaseChange D.R₁ D.R₀₁ E'.L₁ F'.L₁).symm
        (E'.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] e₀ x) ⊗ₜ[D.R₀₁] F'.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] f₀ y)) =
      LinearEquiv.baseChange D.R₁ D.R₀₁ (TensorProduct D.R₁ E.L₁ F.L₁)
        (TensorProduct D.R₁ E'.L₁ F'.L₁) (TensorProduct.congr e₁ f₁)
        ((TensorProduct.AlgebraTensorModule.distribBaseChange D.R₁ D.R₀₁ E.L₁ F.L₁).symm
          (E.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] x) ⊗ₜ[D.R₀₁] F.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] y)))
    rw [hEx, hFy]
    exact distrib_symm_congr e₁ f₁ _ _
