    let ψ_hom : weilEtaleTorsionSheaf X m ⟶ L_sh X :=
      (shAdj.homEquiv P_AM (L_sh X)).symm α₀
    have hη_ψ : shAdj.unit.app P_AM ≫ ψ_hom.hom = α₀ := by
      have h := (shAdj.homEquiv P_AM (L_sh X)).apply_symm_apply α₀
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h
      exact h
    have hΦ_eq_ψ : Φ_hom X = ψ_hom := by
      apply (adj_X.homEquiv AM (L_sh X)).injective
      rw [(adj_X.homEquiv AM (L_sh X)).apply_symm_apply]
      symm
      change (((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_X).comp shAdj).homEquiv
        AM (L_sh X)) ψ_hom = weilAltLocConstConstHom X T_X m
      rw [CategoryTheory.Adjunction.comp_homEquiv]
      dsimp only [Equiv.trans_apply]
      change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_X).homEquiv AM (L_sh X).obj)
        ((shAdj.homEquiv P_AM (L_sh X)) ψ_hom) = weilAltLocConstConstHom X T_X m
      rw [(shAdj.homEquiv P_AM (L_sh X)).apply_symm_apply]
      rw [CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    rw [hΦ_eq_ψ]
    have hψ_inj : ∀ (U : X.Etale), Function.Injective (ψ_hom.hom.app (Opposite.op U)).hom := by
      intro U
      rw [← AddMonoidHom.ker_eq_bot_iff, eq_bot_iff]
      intro s hs
      change (ψ_hom.hom.app (Opposite.op U)).hom s = 0 at hs
      have _hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective J (CategoryTheory.toSheafify J P_AM) :=
        CategoryTheory.GrothendieckTopology.instIsLocallySurjectiveToSheafify P_AM
      have hSieve : CategoryTheory.Presheaf.imageSieve (CategoryTheory.toSheafify J P_AM) s ∈ J U :=
        CategoryTheory.Presheaf.imageSieve_mem J (CategoryTheory.toSheafify J P_AM) s
      have hShF : CategoryTheory.Presieve.IsSheaf J
          ((weilEtaleTorsionSheaf X m).obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
        (CategoryTheory.isSheaf_iff_isSheaf_of_type J _).mp
          (CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf
            (weilEtaleTorsionSheaf X m).obj (weilEtaleTorsionSheaf X m).property)
      refine (hShF _ hSieve).isSeparatedFor.ext (fun V g hg => ?_)
      change ((weilEtaleTorsionSheaf X m).obj.map g.op).hom s =
        ((weilEtaleTorsionSheaf X m).obj.map g.op).hom 0
      rw [map_zero]
      by_cases hne : Nonempty ↥V.left
      · rcases hne with ⟨v₀⟩
        rcases hg with ⟨a, ha⟩
        have hunit_to : ((shAdj.unit.app P_AM).app (Opposite.op V)).hom a =
            ((weilEtaleTorsionSheaf X m).obj.map g.op).hom s := ha
        have heval := congrArg (ψ_hom.hom.app (Opposite.op V)).hom hunit_to
        have hLHS : (ψ_hom.hom.app (Opposite.op V)).hom
            (((shAdj.unit.app P_AM).app (Opposite.op V)).hom a) =
            LocallyConstant.const ↥V.left a :=
          congrArg (fun f : AM ⟶ (weilAltLocConstPresheaf X m).obj (Opposite.op V) => f.hom a)
            (congrArg (fun η => η.app (Opposite.op V)) hη_ψ)
        have hRHS : (ψ_hom.hom.app (Opposite.op V)).hom
            (((weilEtaleTorsionSheaf X m).obj.map g.op).hom s) = 0 := by
          have hnat := congrArg (fun f => f.hom s) (ψ_hom.hom.naturality g.op)
          change ((weilEtaleTorsionSheaf X m).obj.map g.op ≫ ψ_hom.hom.app (Opposite.op V)).hom s =
            (ψ_hom.hom.app (Opposite.op U) ≫ (L_sh X).obj.map g.op).hom s at hnat
          simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at hnat
          rw [hnat, hs, map_zero]
        rw [hLHS, hRHS] at heval
        have ha0 : a = 0 :=
          congrArg (fun k : LocallyConstant ↥V.left (ULift.{u} (ZMod m)) => k v₀) heval
        rw [← hunit_to, ha0]
        exact map_zero _
      · have : IsEmpty ↥V.left := not_nonempty_iff.mp hne
        have : Subsingleton ↥((weilEtaleTorsionSheaf X m).obj.obj (Opposite.op V)) :=
          hSubEmpty X (weilEtaleTorsionSheaf X m) V inferInstance
        exact Subsingleton.elim _ _
    have : CategoryTheory.Mono ψ_hom := by
      refine ⟨fun {𝒢} u₁ u₂ hu => ?_⟩
      ext U z
      exact hψ_inj U.unop (congrArg (fun w : 𝒢 ⟶ L_sh X => (w.hom.app U).hom z) hu)
    have : CategoryTheory.Sheaf.IsLocallySurjective ψ_hom := by
      refine ⟨fun {U} s => ?_⟩
      let s_lc : LocallyConstant ↥U.left (ULift.{u} (ZMod m)) := s
      rw [hMemEtale X]
      intro x
      let O_x : ((AlgebraicGeometry.Scheme.Etale.forget X).obj U).left.Opens :=
        ⟨s_lc ⁻¹' {s_lc x}, s_lc.isLocallyConstant {s_lc x}⟩
      let W_x : X.Etale := weilCupPDTraceOpenSubobj X U O_x
      let j_x : W_x ⟶ U := weilCupPDTraceOpenSubobjToTop X U O_x
      have hx_mem : x ∈ O_x := rfl
      have hx_rng : x ∈ Set.range O_x.ι.base := O_x.range_ι.symm ▸ hx_mem
      rcases hx_rng with ⟨w₀, hw₀⟩
      refine ⟨W_x, j_x, w₀, ?_, inferInstance, hw₀⟩
      refine ⟨((shAdj.unit.app P_AM).app (Opposite.op W_x)).hom (s_lc x), ?_⟩
      have hLHS : (ψ_hom.hom.app (Opposite.op W_x)).hom
          (((shAdj.unit.app P_AM).app (Opposite.op W_x)).hom (s_lc x)) =
          LocallyConstant.const ↥W_x.left (s_lc x) :=
        congrArg (fun f : AM ⟶ (weilAltLocConstPresheaf X m).obj (Opposite.op W_x) => f.hom (s_lc x))
          (congrArg (fun η => η.app (Opposite.op W_x)) hη_ψ)
      change (ψ_hom.hom.app (Opposite.op W_x)).hom
          (((shAdj.unit.app P_AM).app (Opposite.op W_x)).hom (s_lc x)) =
        ((L_sh X).obj.map j_x.op).hom s_lc
      rw [hLHS]
      apply LocallyConstant.ext
      intro q
      change s_lc x = s_lc (O_x.ι q)
      have hq_mem : O_x.ι q ∈ (O_x : Set ↥((AlgebraicGeometry.Scheme.Etale.forget X).obj U).left) := by
        rw [← O_x.range_ι]
        exact ⟨q, rfl⟩
      exact (Set.mem_preimage.mp hq_mem).symm
    have : CategoryTheory.Epi ψ_hom := CategoryTheory.Sheaf.epi_of_isLocallySurjective ψ_hom
    exact CategoryTheory.isIso_of_mono_of_epi ψ_hom

  let Φ : ∀ (X : AlgebraicGeometry.Scheme.{u}), weilEtaleTorsionSheaf X m ≅ L_sh X :=
    fun X => @CategoryTheory.asIso _ _ _ _ (Φ_hom X) (hΦ_isIso X)

  let ρ_Y_loc : L_sh S ⟶ pf_Y.obj (L_sh Y₀) :=
    CategoryTheory.ObjectProperty.homMk (weilAltLocConstPullbackNat i_Y m)
  let ρ_W_loc : L_sh S ⟶ pf_W.obj (L_sh W₀) :=
    CategoryTheory.ObjectProperty.homMk (weilAltLocConstPullbackNat i_W m)
  let ρ_V_loc : L_sh S ⟶ pf_V.obj (L_sh V₀) :=
    CategoryTheory.ObjectProperty.homMk (weilAltLocConstPullbackNat i_V m)

  have hρY_intertwine : ρ_Y = (Φ S).hom ≫ ρ_Y_loc ≫ pf_Y.map (Φ Y₀).inv := by
    let adj_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hTS
    let adj_Y := CategoryTheory.constantSheafAdj Y₀.smallEtaleTopology AddCommGrpCat.{u} hTY
    let τ_Y := hTY.from ((weilEtaleSitePullback i_Y).obj (weilEtaleIdTerminal.{u} S))
    have hcomm : ρ_Y ≫ pf_Y.map (Φ Y₀).hom = (Φ S).hom ≫ ρ_Y_loc := by
      apply (adj_S.homEquiv AM (pf_Y.obj (L_sh Y₀))).injective
      have h1 : (adj_S.homEquiv AM (pf_Y.obj (L_sh Y₀))) (ρ_Y ≫ pf_Y.map (Φ Y₀).hom) =
          (adj_Y.unit.app AM ≫ (weilEtaleTorsionSheaf Y₀ m).obj.map (Opposite.op τ_Y)) ≫
            (Φ Y₀).hom.hom.app (Opposite.op ((weilEtaleSitePullback i_Y).obj (weilEtaleIdTerminal.{u} S))) := by
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        dsimp [ρ_Y, τ_Y]
        rw [(adj_S.homEquiv AM (pf_Y.obj (weilEtaleTorsionSheaf Y₀ m))).apply_symm_apply]
        rfl
      have h2 : (adj_S.homEquiv AM (pf_Y.obj (L_sh Y₀))) ((Φ S).hom ≫ ρ_Y_loc) =
          weilAltLocConstConstHom S (weilEtaleIdTerminal.{u} S) m ≫
            (weilAltLocConstPullbackNat i_Y m).app (Opposite.op (weilEtaleIdTerminal.{u} S)) := by
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        change (adj_S.homEquiv AM (L_sh S) (Φ_hom S)) ≫ _ = _
        rw [(adj_S.homEquiv AM (L_sh S)).apply_symm_apply]
        rfl
      rw [h1, h2]
      have hY_unit : adj_Y.unit.app AM ≫ (Φ Y₀).hom.hom.app (Opposite.op (weilEtaleIdTerminal.{u} Y₀)) =
          weilAltLocConstConstHom Y₀ (weilEtaleIdTerminal.{u} Y₀) m := by
        have := (adj_Y.homEquiv AM (L_sh Y₀)).apply_symm_apply
          (weilAltLocConstConstHom Y₀ (weilEtaleIdTerminal.{u} Y₀) m)
        rw [CategoryTheory.Adjunction.homEquiv_unit] at this
        exact this
      have hnat_τ := (Φ Y₀).hom.hom.naturality (Opposite.op τ_Y)
      ext a
      have ha_nat : ((Φ Y₀).hom.hom.app
          (Opposite.op ((weilEtaleSitePullback i_Y).obj (weilEtaleIdTerminal.{u} S)))).hom
          (((weilEtaleTorsionSheaf Y₀ m).obj.map (Opposite.op τ_Y)).hom ((adj_Y.unit.app AM).hom a)) =
        ((L_sh Y₀).obj.map (Opposite.op τ_Y)).hom
          (((Φ Y₀).hom.hom.app (Opposite.op (weilEtaleIdTerminal.{u} Y₀))).hom
            ((adj_Y.unit.app AM).hom a)) :=
        congrArg (fun f => f.hom ((adj_Y.unit.app AM).hom a)) hnat_τ
      have ha_unit : ((Φ Y₀).hom.hom.app (Opposite.op (weilEtaleIdTerminal.{u} Y₀))).hom
          ((adj_Y.unit.app AM).hom a) =
        (weilAltLocConstConstHom Y₀ (weilEtaleIdTerminal.{u} Y₀) m).hom a :=
        congrArg (fun f => f.hom a) hY_unit
      exact ha_nat.trans
        ((congrArg ((L_sh Y₀).obj.map (Opposite.op τ_Y)).hom ha_unit).trans
          (LocallyConstant.ext (fun _ => rfl)))
    calc ρ_Y
        = (ρ_Y ≫ pf_Y.map (Φ Y₀).hom) ≫ pf_Y.map (Φ Y₀).inv := by
          rw [CategoryTheory.Category.assoc, ← pf_Y.map_comp, (Φ Y₀).hom_inv_id,
            pf_Y.map_id, CategoryTheory.Category.comp_id]
      _ = (Φ S).hom ≫ ρ_Y_loc ≫ pf_Y.map (Φ Y₀).inv := by
          rw [hcomm, CategoryTheory.Category.assoc]

  
  have hPullRange : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (i_Z : Z ⟶ S)
      (U : S.Etale) (x : ↥U.left),
      x ∈ Set.range (CategoryTheory.Limits.pullback.fst U.hom i_Z).base ↔
        U.hom.base x ∈ Set.range i_Z.base := by
    intro Z i_Z U x
    constructor
    · rintro ⟨w, rfl⟩
      refine ⟨(CategoryTheory.Limits.pullback.snd U.hom i_Z).base w, ?_⟩
      have hcond := congrArg (fun k : CategoryTheory.Limits.pullback U.hom i_Z ⟶ S => k.base w)
        (CategoryTheory.Limits.pullback.condition (f := U.hom) (g := i_Z))
      exact hcond.symm
    · rintro ⟨z₀, hz₀⟩
      obtain ⟨w, hw₁, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x z₀ hz₀.symm
      exact ⟨w, hw₁⟩

  have hEpiClosedLoc : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (i_Z : Z ⟶ S)
      [AlgebraicGeometry.IsClosedImmersion i_Z]
      [hContZ : (weilEtaleSitePullback i_Z).IsContinuous S.smallEtaleTopology Z.smallEtaleTopology],
      CategoryTheory.Epi
        (CategoryTheory.ObjectProperty.homMk (weilAltLocConstPullbackNat i_Z m) :
          L_sh S ⟶ ((weilEtaleSitePullback i_Z).sheafPushforwardContinuous AddCommGrpCat.{u}
            S.smallEtaleTopology Z.smallEtaleTopology).obj (L_sh Z)) := by
    intro Z i_Z _ hContZ
    let B_Z := weilEtaleSitePullback i_Z
    let pf_Z := B_Z.sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology Z.smallEtaleTopology
    let ρ_Z_loc : L_sh S ⟶ pf_Z.obj (L_sh Z) :=
      CategoryTheory.ObjectProperty.homMk (weilAltLocConstPullbackNat i_Z m)
    have : CategoryTheory.Sheaf.IsLocallySurjective ρ_Z_loc := by
      refine ⟨fun {U} s₀ => ?_⟩
      let s₀_lc : LocallyConstant ↥(B_Z.obj U).left (ULift.{u} (ZMod m)) := s₀
      rw [hMemEtale S]
      intro x
      let fst_UZ := CategoryTheory.Limits.pullback.fst U.hom i_Z
      have : AlgebraicGeometry.IsClosedImmersion fst_UZ := inferInstance
      have hCl : Topology.IsClosedEmbedding fst_UZ.base :=
        AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding fst_UZ
      by_cases hx : x ∈ Set.range fst_UZ.base
      · rcases hx with ⟨z₀, hz₀⟩
        have hOpenPre : IsOpen (s₀_lc ⁻¹' {s₀_lc z₀}) := s₀_lc.isLocallyConstant {s₀_lc z₀}
        obtain ⟨O_set, hO_open, hO_pre⟩ := hCl.isInducing.isOpen_iff.mp hOpenPre
        have hx_O : x ∈ O_set := by
          rw [← hz₀]
          change z₀ ∈ fst_UZ.base ⁻¹' O_set
          rw [hO_pre]
          rfl
        let O_x : ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left.Opens := ⟨O_set, hO_open⟩
        let W_x : S.Etale := weilCupPDTraceOpenSubobj S U O_x
        let j_x : W_x ⟶ U := weilCupPDTraceOpenSubobjToTop S U O_x
        have hx_mem : x ∈ O_x := hx_O
        have hx_rng : x ∈ Set.range O_x.ι.base := O_x.range_ι.symm ▸ hx_mem
        rcases hx_rng with ⟨w₀, hw₀⟩
        refine ⟨W_x, j_x, w₀, ?_, inferInstance, hw₀⟩
        refine ⟨LocallyConstant.const ↥W_x.left (s₀_lc z₀), ?_⟩
        change (ρ_Z_loc.hom.app (Opposite.op W_x)).hom (LocallyConstant.const ↥W_x.left (s₀_lc z₀)) =
          ((pf_Z.obj (L_sh Z)).obj.map j_x.op).hom s₀_lc
        apply LocallyConstant.ext
        intro p
        change s₀_lc z₀ = s₀_lc ((B_Z.map j_x).left p)
        have hlift_p : fst_UZ.base ((B_Z.map j_x).left p) =
            O_x.ι ((CategoryTheory.Limits.pullback.fst W_x.hom i_Z) p) :=
          congrArg
            (fun k : (B_Z.obj W_x).left ⟶ U.left => k.base p)
            (CategoryTheory.Limits.pullback.lift_fst
              (CategoryTheory.Limits.pullback.fst W_x.hom i_Z ≫ j_x.left)
              (CategoryTheory.Limits.pullback.snd W_x.hom i_Z) _)
        have hp_in_O : fst_UZ.base ((B_Z.map j_x).left p) ∈ O_set := by
          rw [hlift_p]
          have hmem : O_x.ι ((CategoryTheory.Limits.pullback.fst W_x.hom i_Z) p) ∈
              (O_x : Set ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left) := by
            rw [← O_x.range_ι]
            exact ⟨(CategoryTheory.Limits.pullback.fst W_x.hom i_Z) p, rfl⟩
          exact hmem
        have hp_pre : (B_Z.map j_x).left p ∈ s₀_lc ⁻¹' {s₀_lc z₀} := by
          rw [← hO_pre]
          exact hp_in_O
        exact hp_pre.symm
      · let O_x : ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left.Opens :=
          ⟨(Set.range fst_UZ.base)ᶜ, hCl.isClosed_range.isOpen_compl⟩
        let W_x : S.Etale := weilCupPDTraceOpenSubobj S U O_x
        let j_x : W_x ⟶ U := weilCupPDTraceOpenSubobjToTop S U O_x
        have hx_O : x ∈ O_x := hx
        have hx_rng : x ∈ Set.range O_x.ι.base := O_x.range_ι.symm ▸ hx_O
        rcases hx_rng with ⟨w₀, hw₀⟩
        refine ⟨W_x, j_x, w₀, ?_, inferInstance, hw₀⟩
        refine ⟨(0 : LocallyConstant ↥W_x.left (ULift.{u} (ZMod m))), ?_⟩
        change (ρ_Z_loc.hom.app (Opposite.op W_x)).hom 0 =
          ((pf_Z.obj (L_sh Z)).obj.map j_x.op).hom s₀_lc
        apply LocallyConstant.ext
        intro p
        exfalso
        have hlift_p : fst_UZ.base ((B_Z.map j_x).left p) =
            O_x.ι ((CategoryTheory.Limits.pullback.fst W_x.hom i_Z) p) :=
          congrArg (fun k : (B_Z.obj W_x).left ⟶ U.left => k.base p)
            (CategoryTheory.Limits.pullback.lift_fst
              (CategoryTheory.Limits.pullback.fst W_x.hom i_Z ≫ j_x.left)
              (CategoryTheory.Limits.pullback.snd W_x.hom i_Z) _)
        have hp_compl : fst_UZ.base ((B_Z.map j_x).left p) ∈ (Set.range fst_UZ.base)ᶜ := by
          rw [hlift_p]
          have hmem : O_x.ι ((CategoryTheory.Limits.pullback.fst W_x.hom i_Z) p) ∈
              (O_x : Set ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left) := by
            rw [← O_x.range_ι]
            exact ⟨(CategoryTheory.Limits.pullback.fst W_x.hom i_Z) p, rfl⟩
          exact hmem
        exact hp_compl ⟨(B_Z.map j_x).left p, rfl⟩
    exact CategoryTheory.Sheaf.epi_of_isLocallySurjective ρ_Z_loc

  have hEpi_Y : CategoryTheory.Epi ρ_Y_loc := hEpiClosedLoc i_Y
  have hEpi_V : CategoryTheory.Epi ρ_V_loc := hEpiClosedLoc i_V

  let U_compl : S.Opens :=
    ⟨(Set.range i_Y.base)ᶜ,
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding i_Y).isClosed_range.isOpen_compl⟩

  have hSh0_Y : CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology
      (weilAltZeroBdrySubpresheaf S U_compl m) := by
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp S.smallEtaleTopology
      (weilAltZeroBdrySubpresheaf S U_compl m) (CategoryTheory.forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    intro U R hR s hs
    have hShL_S : CategoryTheory.Presieve.IsSheaf S.smallEtaleTopology
        (weilAltLocConstPresheaf S m ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type S.smallEtaleTopology _).mp
        (CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf
          (weilAltLocConstPresheaf S m) (hShL S))
    let s₁ : CategoryTheory.Presieve.FamilyOfElements
        (weilAltLocConstPresheaf S m ⋙ CategoryTheory.forget AddCommGrpCat.{u}) R.arrows :=
      fun Y g hg => (s g hg).1
    have hs₁ : s₁.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hcomm
      exact congrArg Subtype.val (hs g₁ g₂ h₁ h₂ hcomm)
    obtain ⟨t, ht_amal, ht_uniq⟩ := hShL_S R hR s₁ hs₁
    let t_lc : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left
        (ULift.{u} (ZMod m)) := t
    have ht_mem : t_lc ∈ weilAltZeroBdrySubgroup S U_compl m U := by
      intro x hx
      obtain ⟨Y_x, f_x, y_x, hR_fx, _, hyx⟩ := ((hMemEtale S R).mp hR) x
      have hx_eq : t_lc x = (s f_x hR_fx).1 y_x := by
        have heval := congrArg
          (fun k : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y_x).left
            (ULift.{u} (ZMod m)) => k y_x)
          (ht_amal f_x hR_fx)
        change t_lc (f_x.left y_x) = (s f_x hR_fx).1 y_x at heval
        rwa [hyx] at heval
      refine hx_eq.trans ((s f_x hR_fx).2 y_x (fun hmem => hx ?_))
      have hw : Y_x.hom y_x = U.hom x := by
        rw [← hyx, ← AlgebraicGeometry.Scheme.Hom.comp_apply,
          CategoryTheory.MorphismProperty.Over.w f_x]
      exact hw ▸ hmem
    refine ⟨⟨t_lc, ht_mem⟩, ?_, ?_⟩
    · intro Y g hg
      exact Subtype.ext (ht_amal g hg)
    · intro t' ht'
      exact Subtype.ext (ht_uniq t'.1 (fun Y g hg => congrArg Subtype.val (ht' g hg)))

  let K_Y_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    ⟨weilAltZeroBdrySubpresheaf S U_compl m, hSh0_Y⟩
  let ι0_sh : K_Y_sh ⟶ L_sh S :=
    CategoryTheory.ObjectProperty.homMk (weilAltZeroBdrySubpresheafι S U_compl m)

  have h0_top : ι0_sh ≫ ρ_Y_loc = 0 := by
    ext U g
    apply LocallyConstant.ext
    intro y
    change g.1 ((CategoryTheory.Limits.pullback.fst U.unop.hom i_Y) y) = 0
    apply g.2
    have hmem : U.unop.hom.base ((CategoryTheory.Limits.pullback.fst U.unop.hom i_Y) y) ∈
        Set.range i_Y.base :=
      (hPullRange i_Y U.unop _).mp ⟨y, rfl⟩
    exact fun hc => hc hmem

  have hLim_top : CategoryTheory.Limits.IsLimit
      (CategoryTheory.Limits.KernelFork.ofι ι0_sh h0_top) := by
    refine CategoryTheory.Limits.Fork.IsLimit.mk _
      (fun fk => CategoryTheory.ObjectProperty.homMk
        { app := fun U => AddCommGrpCat.ofHom
            { toFun := fun q => ⟨((fk.ι.hom.app U).hom q :
                  LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj U.unop).left
                    (ULift.{u} (ZMod m))), fun x hx => by
                have hx_in : U.unop.hom.base x ∈ Set.range i_Y.base :=
                  Set.notMem_compl_iff.mp hx
                obtain ⟨y, rfl⟩ := (hPullRange i_Y U.unop x).mpr hx_in
                have hzero_lc : (((fk.ι ≫ ρ_Y_loc).hom.app U).hom q :
                    LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget Y₀).obj
                      ((weilEtaleSitePullback i_Y).obj U.unop)).left
                      (ULift.{u} (ZMod m))) = 0 :=
                  congrArg (fun w : fk.pt ⟶ pf_Y.obj (L_sh Y₀) => (w.hom.app U).hom q)
                    fk.condition
                exact congrArg (fun k : LocallyConstant _ _ => k y) hzero_lc⟩
              map_zero' := Subtype.ext ((fk.ι.hom.app U).hom.map_zero)
              map_add' := fun q₁ q₂ => Subtype.ext ((fk.ι.hom.app U).hom.map_add q₁ q₂) }
          naturality := fun U₁ U₂ u => AddCommGrpCat.ext (fun q => Subtype.ext
            (congrArg (fun f => f.hom q) (fk.ι.hom.naturality u))) })
      (fun fk => by ext U q; rfl)
      (fun fk m hm => by
        ext U q
        exact Subtype.ext (congrArg (fun w : fk.pt ⟶ L_sh S => (w.hom.app U).hom q) hm))

  let S_top : CategoryTheory.ShortComplex
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
    CategoryTheory.ShortComplex.mk ι0_sh ρ_Y_loc h0_top
  have : CategoryTheory.Mono S_top.f := CategoryTheory.Limits.mono_of_isLimit_fork hLim_top
  have hS_top : S_top.ShortExact :=
    { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel S_top hLim_top }

  
  let B_Y := weilEtaleSitePullback i_Y
  let B_W := weilEtaleSitePullback i_W
  let B_V := weilEtaleSitePullback i_V

  have hChartCov : ∀ (U : S.Etale) (x : ↥U.left),
      x ∈ Set.range (CategoryTheory.Limits.pullback.fst U.hom i_Y).base ∨
        x ∈ Set.range (CategoryTheory.Limits.pullback.fst U.hom i_W).base := by
    intro U x
    rw [hPullRange i_Y U x, hPullRange i_W U x, ← Set.mem_union, hCov]
    exact Set.mem_univ _

  have hChartInter : ∀ (U : S.Etale) (x : ↥U.left),
      x ∈ Set.range (CategoryTheory.Limits.pullback.fst U.hom i_V).base ↔
        x ∈ Set.range (CategoryTheory.Limits.pullback.fst U.hom i_Y).base ∧
          x ∈ Set.range (CategoryTheory.Limits.pullback.fst U.hom i_W).base := by
    intro U x
    rw [hPullRange i_V U x, hPullRange i_Y U x, hPullRange i_W U x, hInter]
    rfl

  have hEx_αY : ∀ (U : S.Etale) (v : ↥(B_V.obj U).left),
      ∃ y : ↥(B_Y.obj U).left,
        (CategoryTheory.Limits.pullback.fst U.hom i_Y).base y =
          (CategoryTheory.Limits.pullback.fst U.hom i_V).base v :=
    fun U v => ((hChartInter U _).mp ⟨v, rfl⟩).1

  have hEx_αW : ∀ (U : S.Etale) (v : ↥(B_V.obj U).left),
      ∃ w : ↥(B_W.obj U).left,
        (CategoryTheory.Limits.pullback.fst U.hom i_W).base w =
          (CategoryTheory.Limits.pullback.fst U.hom i_V).base v :=
    fun U v => ((hChartInter U _).mp ⟨v, rfl⟩).2

  let α_Y : ∀ (U : S.Etale), ↥(B_V.obj U).left → ↥(B_Y.obj U).left :=
    fun U v => Classical.choose (hEx_αY U v)
  let α_W : ∀ (U : S.Etale), ↥(B_V.obj U).left → ↥(B_W.obj U).left :=
    fun U v => Classical.choose (hEx_αW U v)

  have hα_Y_spec : ∀ (U : S.Etale) (v : ↥(B_V.obj U).left),
      (CategoryTheory.Limits.pullback.fst U.hom i_Y).base (α_Y U v) =
        (CategoryTheory.Limits.pullback.fst U.hom i_V).base v :=
    fun U v => Classical.choose_spec (hEx_αY U v)

  have hα_W_spec : ∀ (U : S.Etale) (v : ↥(B_V.obj U).left),
      (CategoryTheory.Limits.pullback.fst U.hom i_W).base (α_W U v) =
        (CategoryTheory.Limits.pullback.fst U.hom i_V).base v :=
    fun U v => Classical.choose_spec (hEx_αW U v)

  have hα_Y_cont : ∀ (U : S.Etale), Continuous (α_Y U) := by
    intro U
    have : AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.fst U.hom i_Y) :=
      inferInstance
    have hClY := AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding
      (CategoryTheory.Limits.pullback.fst U.hom i_Y)
    refine hClY.isInducing.continuous_iff.mpr ?_
    have hcomp_eq : (CategoryTheory.Limits.pullback.fst U.hom i_Y).base ∘ α_Y U =
        (CategoryTheory.Limits.pullback.fst U.hom i_V).base :=
      funext (hα_Y_spec U)
    rw [hcomp_eq]
    exact (CategoryTheory.Limits.pullback.fst U.hom i_V).continuous

  have hα_W_cont : ∀ (U : S.Etale), Continuous (α_W U) := by
    intro U
    have : AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.fst U.hom i_W) :=
      inferInstance
    have hClW := AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding
      (CategoryTheory.Limits.pullback.fst U.hom i_W)
    refine hClW.isInducing.continuous_iff.mpr ?_
    have hcomp_eq : (CategoryTheory.Limits.pullback.fst U.hom i_W).base ∘ α_W U =
        (CategoryTheory.Limits.pullback.fst U.hom i_V).base :=
      funext (hα_W_spec U)
    rw [hcomp_eq]
    exact (CategoryTheory.Limits.pullback.fst U.hom i_V).continuous

  let res_Y : pf_Y.obj (L_sh Y₀) ⟶ pf_V.obj (L_sh V₀) :=
    CategoryTheory.ObjectProperty.homMk
      { app := fun U => AddCommGrpCat.ofHom
          { toFun := fun g =>
              { toFun := fun v => g (α_Y U.unop v)
                isLocallyConstant := fun t =>
                  (hα_Y_cont U.unop).isOpen_preimage _ (g.isLocallyConstant t) }
            map_zero' := LocallyConstant.ext (fun _ => rfl)
            map_add' := fun _ _ => LocallyConstant.ext (fun _ => rfl) }
        naturality := fun {U₁ U₂} u => AddCommGrpCat.ext
          (fun (g : LocallyConstant ↥(B_Y.obj U₁.unop).left (ULift.{u} (ZMod m))) =>
            LocallyConstant.ext (fun v => by
              change g ((B_Y.map u.unop).left (α_Y U₂.unop v)) =
                g (α_Y U₁.unop ((B_V.map u.unop).left v))
              congr 1
              have : AlgebraicGeometry.IsClosedImmersion
                  (CategoryTheory.Limits.pullback.fst U₁.unop.hom i_Y) := inferInstance
              apply (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding
                (CategoryTheory.Limits.pullback.fst U₁.unop.hom i_Y)).injective
              have hL : (CategoryTheory.Limits.pullback.fst U₁.unop.hom i_Y).base
                  ((B_Y.map u.unop).left (α_Y U₂.unop v)) =
                  u.unop.left.base ((CategoryTheory.Limits.pullback.fst U₂.unop.hom i_Y).base
                    (α_Y U₂.unop v)) :=
                congrArg (fun k : (B_Y.obj U₂.unop).left ⟶ U₁.unop.left => k.base (α_Y U₂.unop v))
                  (CategoryTheory.Limits.pullback.lift_fst
                    (CategoryTheory.Limits.pullback.fst U₂.unop.hom i_Y ≫ u.unop.left)
                    (CategoryTheory.Limits.pullback.snd U₂.unop.hom i_Y) _)
              have hR : (CategoryTheory.Limits.pullback.fst U₁.unop.hom i_V).base
                  ((B_V.map u.unop).left v) =
                  u.unop.left.base ((CategoryTheory.Limits.pullback.fst U₂.unop.hom i_V).base v) :=
                congrArg (fun k : (B_V.obj U₂.unop).left ⟶ U₁.unop.left => k.base v)
                  (CategoryTheory.Limits.pullback.lift_fst
                    (CategoryTheory.Limits.pullback.fst U₂.unop.hom i_V ≫ u.unop.left)
                    (CategoryTheory.Limits.pullback.snd U₂.unop.hom i_V) _)
              rw [hL, hα_Y_spec U₂.unop v, hα_Y_spec U₁.unop _, hR])) }

  let res_W : pf_W.obj (L_sh W₀) ⟶ pf_V.obj (L_sh V₀) :=
    CategoryTheory.ObjectProperty.homMk
      { app := fun U => AddCommGrpCat.ofHom
          { toFun := fun g =>
              { toFun := fun v => g (α_W U.unop v)
                isLocallyConstant := fun t =>
                  (hα_W_cont U.unop).isOpen_preimage _ (g.isLocallyConstant t) }
            map_zero' := LocallyConstant.ext (fun _ => rfl)
            map_add' := fun _ _ => LocallyConstant.ext (fun _ => rfl) }
        naturality := fun {U₁ U₂} u => AddCommGrpCat.ext
          (fun (g : LocallyConstant ↥(B_W.obj U₁.unop).left (ULift.{u} (ZMod m))) =>
            LocallyConstant.ext (fun v => by
              change g ((B_W.map u.unop).left (α_W U₂.unop v)) =
                g (α_W U₁.unop ((B_V.map u.unop).left v))
              congr 1
              have : AlgebraicGeometry.IsClosedImmersion
                  (CategoryTheory.Limits.pullback.fst U₁.unop.hom i_W) := inferInstance
              apply (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding
                (CategoryTheory.Limits.pullback.fst U₁.unop.hom i_W)).injective
              have hL : (CategoryTheory.Limits.pullback.fst U₁.unop.hom i_W).base
                  ((B_W.map u.unop).left (α_W U₂.unop v)) =
                  u.unop.left.base ((CategoryTheory.Limits.pullback.fst U₂.unop.hom i_W).base
                    (α_W U₂.unop v)) :=
                congrArg (fun k : (B_W.obj U₂.unop).left ⟶ U₁.unop.left => k.base (α_W U₂.unop v))
                  (CategoryTheory.Limits.pullback.lift_fst
                    (CategoryTheory.Limits.pullback.fst U₂.unop.hom i_W ≫ u.unop.left)
                    (CategoryTheory.Limits.pullback.snd U₂.unop.hom i_W) _)
              have hR : (CategoryTheory.Limits.pullback.fst U₁.unop.hom i_V).base
                  ((B_V.map u.unop).left v) =
                  u.unop.left.base ((CategoryTheory.Limits.pullback.fst U₂.unop.hom i_V).base v) :=
                congrArg (fun k : (B_V.obj U₂.unop).left ⟶ U₁.unop.left => k.base v)
                  (CategoryTheory.Limits.pullback.lift_fst
                    (CategoryTheory.Limits.pullback.fst U₂.unop.hom i_V ≫ u.unop.left)
                    (CategoryTheory.Limits.pullback.snd U₂.unop.hom i_V) _)
              rw [hL, hα_W_spec U₂.unop v, hα_W_spec U₁.unop _, hR])) }

  have hcomm_Y : ρ_Y_loc ≫ res_Y = ρ_V_loc := by
    ext U (s : LocallyConstant ↥U.unop.left (ULift.{u} (ZMod m)))
    exact LocallyConstant.ext (fun v => congrArg s (hα_Y_spec U.unop v))

  have hcomm_W : ρ_W_loc ≫ res_W = ρ_V_loc := by
    ext U (s : LocallyConstant ↥U.unop.left (ULift.{u} (ZMod m)))
    exact LocallyConstant.ext (fun v => congrArg s (hα_W_spec U.unop v))

  have _hEpi_resW : CategoryTheory.Epi res_W := by
    have hEpiComp : CategoryTheory.Epi (ρ_W_loc ≫ res_W) := hcomm_W.symm ▸ hEpi_V
    exact @CategoryTheory.epi_of_epi _ _ _ _ _ ρ_W_loc res_W hEpiComp

  let ι_W : K_Y_sh ⟶ pf_W.obj (L_sh W₀) := ι0_sh ≫ ρ_W_loc

  have h0_bot : ι_W ≫ res_W = 0 := by
    change (ι0_sh ≫ ρ_W_loc) ≫ res_W = 0
    rw [CategoryTheory.Category.assoc, hcomm_W]
    ext U g
    apply LocallyConstant.ext
    intro v
    change g.1 ((CategoryTheory.Limits.pullback.fst U.unop.hom i_V) v) = 0
    apply g.2
    have hy_mem : (CategoryTheory.Limits.pullback.fst U.unop.hom i_V).base v ∈
        Set.range (CategoryTheory.Limits.pullback.fst U.unop.hom i_Y).base :=
      ((hChartInter U.unop _).mp ⟨v, rfl⟩).1
    have hS_mem : U.unop.hom.base ((CategoryTheory.Limits.pullback.fst U.unop.hom i_V) v) ∈
        Set.range i_Y.base :=
      (hPullRange i_Y U.unop _).mp hy_mem
    exact fun hc => hc hS_mem

  have hιW_inj : ∀ (U : S.Etale), Function.Injective (ι_W.hom.app (Opposite.op U)).hom := by
    intro U
    rw [← AddMonoidHom.ker_eq_bot_iff, eq_bot_iff]
    intro g hg
    change (ι_W.hom.app (Opposite.op U)).hom g = 0 at hg
    apply Subtype.ext
    apply LocallyConstant.ext
    intro x
    rcases hChartCov U x with hxY | ⟨w, rfl⟩
    · apply g.2 x
      have hS_mem : U.hom.base x ∈ Set.range i_Y.base := (hPullRange i_Y U x).mp hxY
      exact fun hc => hc hS_mem
    · exact congrArg (fun k : LocallyConstant ↥(B_W.obj U).left (ULift.{u} (ZMod m)) => k w) hg

  have hPaste : ∀ (U : S.Etale)
      (g_W : LocallyConstant ↥(B_W.obj U).left (ULift.{u} (ZMod m))),
      (res_W.hom.app (Opposite.op U)).hom g_W = 0 →
      ∃ g : ↥(K_Y_sh.obj.obj (Opposite.op U)),
        (ι_W.hom.app (Opposite.op U)).hom g = g_W := by
    intro U g_W hg_W
    let fst_UY := CategoryTheory.Limits.pullback.fst U.hom i_Y
    let fst_UW := CategoryTheory.Limits.pullback.fst U.hom i_W
    have : AlgebraicGeometry.IsClosedImmersion fst_UY := inferInstance
    have : AlgebraicGeometry.IsClosedImmersion fst_UW := inferInstance
    have hClY := AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding fst_UY
    have hClW := AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding fst_UW
    let f_fn : ↥U.left → ULift.{u} (ZMod m) :=
      fun x => if h : x ∈ Set.range fst_UW.base then g_W (Classical.choose h) else 0
    have hf_on_W : ∀ w : ↥(B_W.obj U).left, f_fn (fst_UW.base w) = g_W w := by
      intro w
      have hw : fst_UW.base w ∈ Set.range fst_UW.base := ⟨w, rfl⟩
      simp only [f_fn, hw, ↓reduceDIte]
      exact congrArg g_W (hClW.injective (Classical.choose_spec hw))
    have hf_on_Y : ∀ x : ↥U.left, x ∈ Set.range fst_UY.base → f_fn x = 0 := by
      intro x hxY
      by_cases hxW : x ∈ Set.range fst_UW.base
      · obtain ⟨v, hv⟩ := (hChartInter U x).mpr ⟨hxY, hxW⟩
        have hvW : fst_UW.base (α_W U v) = x := (hα_W_spec U v).trans hv
        rw [← hvW, hf_on_W (α_W U v)]
        exact congrArg (fun k : LocallyConstant ↥(B_V.obj U).left (ULift.{u} (ZMod m)) => k v) hg_W
      · simp only [f_fn, hxW, ↓reduceDIte]
    have hf_lc : IsLocallyConstant f_fn := by
      intro E
      rw [← isClosed_compl_iff]
      let T : Set (ULift.{u} (ZMod m)) := Eᶜ
      have hpre_eq : (f_fn ⁻¹' E)ᶜ = f_fn ⁻¹' T := rfl
      rw [hpre_eq]
      have hCW_cl : IsClosed (fst_UW.base '' (g_W ⁻¹' T)) :=
        hClW.isClosedMap _ (g_W.isLocallyConstant E).isClosed_compl
      have hCY_cl : IsClosed (Set.range fst_UY.base) := hClY.isClosed_range
      by_cases h0 : (0 : ULift.{u} (ZMod m)) ∈ T
      · have hset : f_fn ⁻¹' T = Set.range fst_UY.base ∪ fst_UW.base '' (g_W ⁻¹' T) := by
          ext x
          constructor
          · intro hxT
            rcases hChartCov U x with hxY | ⟨w, rfl⟩
            · exact Or.inl hxY
            · refine Or.inr ⟨w, ?_, rfl⟩
              change g_W w ∈ T
              rw [← hf_on_W w]
              exact hxT
          · rintro (hxY | ⟨w, hwT, rfl⟩)
            · change f_fn x ∈ T
              rw [hf_on_Y x hxY]
              exact h0
            · change f_fn (fst_UW.base w) ∈ T
              rw [hf_on_W w]
              exact hwT
        rw [hset]
        exact hCY_cl.union hCW_cl
      · have hset : f_fn ⁻¹' T = fst_UW.base '' (g_W ⁻¹' T) := by
          ext x
          constructor
          · intro hxT
            by_cases hxW : x ∈ Set.range fst_UW.base
            · rcases hxW with ⟨w, rfl⟩
              refine ⟨w, ?_, rfl⟩
              change g_W w ∈ T
              rw [← hf_on_W w]
              exact hxT
            · exfalso
              apply h0
              have hf0 : f_fn x = 0 := by simp only [f_fn, hxW, ↓reduceDIte]
              exact hf0 ▸ hxT
          · rintro ⟨w, hwT, rfl⟩
            change f_fn (fst_UW.base w) ∈ T
            rw [hf_on_W w]
            exact hwT
        rw [hset]
        exact hCW_cl
    refine ⟨⟨⟨f_fn, hf_lc⟩, fun x hx => hf_on_Y x
      ((hPullRange i_Y U x).mpr (Set.notMem_compl_iff.mp hx))⟩, ?_⟩
    exact LocallyConstant.ext (fun w => hf_on_W w)

  have hLim_bot : CategoryTheory.Limits.IsLimit
      (CategoryTheory.Limits.KernelFork.ofι ι_W h0_bot) := by
    let lift_pt : ∀ (fk : CategoryTheory.Limits.KernelFork res_W) (U : S.Etale)
        (q : ↥(fk.pt.obj.obj (Opposite.op U))), ↥(K_Y_sh.obj.obj (Opposite.op U)) :=
      fun fk U q => Classical.choose (hPaste U ((fk.ι.hom.app (Opposite.op U)).hom q)
        (congrArg (fun w : fk.pt ⟶ pf_V.obj (L_sh V₀) => (w.hom.app (Opposite.op U)).hom q)
          fk.condition))
    have hlift_spec : ∀ (fk : CategoryTheory.Limits.KernelFork res_W) (U : S.Etale)
        (q : ↥(fk.pt.obj.obj (Opposite.op U))),
        (ι_W.hom.app (Opposite.op U)).hom (lift_pt fk U q) =
          (fk.ι.hom.app (Opposite.op U)).hom q :=
      fun fk U q => Classical.choose_spec (hPaste U ((fk.ι.hom.app (Opposite.op U)).hom q)
        (congrArg (fun w : fk.pt ⟶ pf_V.obj (L_sh V₀) => (w.hom.app (Opposite.op U)).hom q)
          fk.condition))
    refine CategoryTheory.Limits.Fork.IsLimit.mk _
      (fun fk => CategoryTheory.ObjectProperty.homMk
        { app := fun U => AddCommGrpCat.ofHom
            { toFun := fun q => lift_pt fk U.unop q
              map_zero' := hιW_inj U.unop
                ((hlift_spec fk U.unop 0).trans
                  (((fk.ι.hom.app (Opposite.op U.unop)).hom.map_zero).trans
                    ((ι_W.hom.app (Opposite.op U.unop)).hom.map_zero).symm))
              map_add' := fun q₁ q₂ => hιW_inj U.unop
                ((hlift_spec fk U.unop (q₁ + q₂)).trans
                  (((fk.ι.hom.app (Opposite.op U.unop)).hom.map_add q₁ q₂).trans
                    ((congrArg₂ (· + ·) (hlift_spec fk U.unop q₁).symm
                      (hlift_spec fk U.unop q₂).symm).trans
                      ((ι_W.hom.app (Opposite.op U.unop)).hom.map_add
                        (lift_pt fk U.unop q₁) (lift_pt fk U.unop q₂)).symm))) }
          naturality := fun {U₁ U₂} u => AddCommGrpCat.ext (fun q => hιW_inj U₂.unop
            ((hlift_spec fk U₂.unop ((fk.pt.obj.map u).hom q)).trans
              ((congrArg (fun f => f.hom q) (fk.ι.hom.naturality u)).trans
                ((congrArg ((pf_W.obj (L_sh W₀)).obj.map u).hom
                  (hlift_spec fk U₁.unop q).symm).trans
                  (congrArg (fun f => f.hom (lift_pt fk U₁.unop q))
                    (ι_W.hom.naturality u).symm))))) })
      (fun fk => by
        ext U q
        exact hlift_spec fk U.unop q)
      (fun fk m hm => by
        ext U q
        exact hιW_inj U.unop
          ((congrArg (fun w : fk.pt ⟶ pf_W.obj (L_sh W₀) => (w.hom.app U).hom q) hm).trans
            (hlift_spec fk U.unop q).symm))

  let S_bot : CategoryTheory.ShortComplex
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
    CategoryTheory.ShortComplex.mk ι_W res_W h0_bot
  have : CategoryTheory.Mono S_bot.f := CategoryTheory.Limits.mono_of_isLimit_fork hLim_bot
  have hS_bot : S_bot.ShortExact :=
    { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel S_bot hLim_bot }

  
  let φ_sc : S_top ⟶ S_bot :=
    CategoryTheory.ShortComplex.homMk (CategoryTheory.CategoryStruct.id K_Y_sh) ρ_W_loc res_Y
      (CategoryTheory.Category.id_comp ι_W)
      (hcomm_W.trans hcomm_Y.symm)

  have hext_nat : hS_top.extClass =
      (CategoryTheory.Abelian.Ext.mk₀ res_Y).comp hS_bot.extClass (Nat.zero_add 1) := by
    have hnat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS_top hS_bot φ_sc
    change hS_top.extClass.comp
        (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id K_Y_sh))
        (Nat.add_zero 1) =
      (CategoryTheory.Abelian.Ext.mk₀ res_Y).comp hS_bot.extClass (Nat.zero_add 1) at hnat
    rwa [CategoryTheory.Abelian.Ext.comp_mk₀_id] at hnat

  intro z
  let y : CategoryTheory.Abelian.Ext Fℤ_S (pf_Y.obj (L_sh Y₀)) 1 :=
    z.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_Y.map (Φ Y₀).hom)) (Nat.add_zero 1)
  let v_ext : CategoryTheory.Abelian.Ext Fℤ_S (pf_V.obj (L_sh V₀)) 1 :=
    y.comp (CategoryTheory.Abelian.Ext.mk₀ res_Y) (Nat.add_zero 1)

  have hv_zero : v_ext = 0 := by
    have hV_tor : v_ext.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_V.map (Φ V₀).inv)) (Nat.add_zero 1) =
        (0 : (pf_V.obj (weilEtaleTorsionSheaf V₀ m)).H 1) :=
      @Subsingleton.elim _ hSubV _ _
    have hback := congrArg
      (fun w : CategoryTheory.Abelian.Ext Fℤ_S (pf_V.obj (weilEtaleTorsionSheaf V₀ m)) 1 =>
        w.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_V.map (Φ V₀).hom)) (Nat.add_zero 1))
      hV_tor
    change (v_ext.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_V.map (Φ V₀).inv)) (Nat.add_zero 1)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (pf_V.map (Φ V₀).hom)) (Nat.add_zero 1) =
      (0 : CategoryTheory.Abelian.Ext Fℤ_S (pf_V.obj (weilEtaleTorsionSheaf V₀ m)) 1).comp
        (CategoryTheory.Abelian.Ext.mk₀ (pf_V.map (Φ V₀).hom)) (Nat.add_zero 1) at hback
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero 1),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← pf_V.map_comp, (Φ V₀).inv_hom_id,
      pf_V.map_id, CategoryTheory.Abelian.Ext.comp_mk₀_id,
      CategoryTheory.Abelian.Ext.zero_comp] at hback
    exact hback

  have hy_obs : y.comp hS_top.extClass (rfl : 1 + 1 = 2) = 0 := by
    rw [hext_nat,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero y
        (CategoryTheory.Abelian.Ext.mk₀ res_Y) hS_bot.extClass (rfl : 1 + 1 = 2)]
    change v_ext.comp hS_bot.extClass (rfl : 1 + 1 = 2) = 0
    rw [hv_zero]
    exact CategoryTheory.Abelian.Ext.zero_comp Fℤ_S 1 hS_bot.extClass 2 rfl

  obtain ⟨x_loc, hx_loc⟩ :=
    CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_S hS_top y (rfl : 1 + 1 = 2) hy_obs

  let x : CategoryTheory.Abelian.Ext Fℤ_S (weilEtaleTorsionSheaf S m) 1 :=
    x_loc.comp (CategoryTheory.Abelian.Ext.mk₀ (Φ S).inv) (Nat.add_zero 1)

  refine ⟨x, ?_⟩
  change x.comp (CategoryTheory.Abelian.Ext.mk₀ ρ_Y) (Nat.add_zero 1) = z
  dsimp only [x]
  rw [hρY_intertwine,
    CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero 1),
    CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
    ← CategoryTheory.Category.assoc (Φ S).inv (Φ S).hom _,
    (Φ S).inv_hom_id, CategoryTheory.Category.id_comp,
    ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ ρ_Y_loc (pf_Y.map (Φ Y₀).inv),
    ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero x_loc _ _ (Nat.add_zero 1)]
  change (x_loc.comp (CategoryTheory.Abelian.Ext.mk₀ S_top.g) (Nat.add_zero 1)).comp
    (CategoryTheory.Abelian.Ext.mk₀ (pf_Y.map (Φ Y₀).inv)) (Nat.add_zero 1) = z
  rw [hx_loc]
  dsimp only [y]
  rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero 1),
    CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← pf_Y.map_comp, (Φ Y₀).hom_inv_id,
    pf_Y.map_id, CategoryTheory.Abelian.Ext.comp_mk₀_id]

theorem weil_pbc_closed_immersion_deg_one_surjective_transfer (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (Y C : AlgebraicGeometry.Scheme.{u})
    (π : Y ⟶ CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
      (weilProjectiveSpaceOver k 1).hom)
    (q_C : C ⟶ CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
      (weilProjectiveSpaceOver k 1).hom)
    [AlgebraicGeometry.IsFinite q_C]
    (i_YC : Y ⟶ C)
    [AlgebraicGeometry.IsClosedImmersion i_YC]
    (hcomm : i_YC ≫ q_C = π)
    (hSurjC : WeilEtaleCohomologyPullbackSurjective
      (CategoryTheory.Limits.pullback.snd
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
        (q_C ≫ CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
          (weilProjectiveSpaceOver k 1).hom))
      (weilEtaleTorsionSheaf C ℓ) 1) :
    WeilEtaleCohomologyPullbackSurjective
      (CategoryTheory.Limits.pullback.snd
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
        (π ≫ CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
          (weilProjectiveSpaceOver k 1).hom))
      (weilEtaleTorsionSheaf Y ℓ) 1 :=
by
  classical
  
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
  let ι_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom)
  let P₁ := weilProjectiveSpaceOver k 1
  let p₁_A := CategoryTheory.Limits.pullback.fst s_A P₁.hom
  let p₂_A := CategoryTheory.Limits.pullback.snd s_A P₁.hom
  let f_C := q_C ≫ p₁_A
  let f_Y := π ≫ p₁_A
  let C₀ := CategoryTheory.Limits.pullback ι_A f_C
  let p_C₀ := CategoryTheory.Limits.pullback.fst ι_A f_C
  let i_C := CategoryTheory.Limits.pullback.snd ι_A f_C
  let Y₀ := CategoryTheory.Limits.pullback ι_A f_Y
  let p_Y₀ := CategoryTheory.Limits.pullback.fst ι_A f_Y
  let i_Y := CategoryTheory.Limits.pullback.snd ι_A f_Y
  let q_C₀ := i_C ≫ q_C ≫ p₂_A
  have hιs : ι_A ≫ s_A = 𝟙 S_k := by
    dsimp [ι_A, s_A, S_k]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hcomp : CommRingCat.ofHom ((τ_A : A →+* k).comp (algebraMap k A)) =
        𝟙 (CommRingCat.of k) :=
      (congrArg CommRingCat.ofHom (RingHom.ext τ_A.commutes)).trans CommRingCat.ofHom_id
    rw [hcomp, AlgebraicGeometry.Spec.map_id]
  have hq_C₀_hom : q_C₀ ≫ P₁.hom = p_C₀ := by
    calc q_C₀ ≫ P₁.hom
        = i_C ≫ q_C ≫ (p₂_A ≫ P₁.hom) := by simp only [q_C₀, CategoryTheory.Category.assoc]
      _ = i_C ≫ q_C ≫ (p₁_A ≫ s_A) := by rw [CategoryTheory.Limits.pullback.condition]
      _ = (i_C ≫ f_C) ≫ s_A := by simp only [f_C, CategoryTheory.Category.assoc]
      _ = (p_C₀ ≫ ι_A) ≫ s_A := by rw [← CategoryTheory.Limits.pullback.condition]
      _ = p_C₀ ≫ (ι_A ≫ s_A) := CategoryTheory.Category.assoc _ _ _
      _ = p_C₀ ≫ 𝟙 S_k := by rw [hιs]
      _ = p_C₀ := CategoryTheory.Category.comp_id _
  have h_ix_cond : (P₁.hom ≫ ι_A) ≫ s_A = 𝟙 P₁.left ≫ P₁.hom := by
    rw [CategoryTheory.Category.assoc, hιs, CategoryTheory.Category.comp_id,
      CategoryTheory.Category.id_comp]
  let i_X₀ := CategoryTheory.Limits.pullback.lift (P₁.hom ≫ ι_A) (𝟙 P₁.left) h_ix_cond
  have hpb_X₀ : CategoryTheory.IsPullback P₁.hom i_X₀ ι_A p₁_A := by
    refine CategoryTheory.IsPullback.of_bot ?_
      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      (CategoryTheory.IsPullback.of_hasPullback s_A P₁.hom)
    rw [CategoryTheory.Limits.pullback.lift_snd, hιs]
    exact CategoryTheory.IsPullback.of_vert_isIso
      ⟨by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]⟩
  have h_top_comm : i_C ≫ q_C = q_C₀ ≫ i_X₀ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (i_C ≫ q_C) ≫ p₁_A = (q_C₀ ≫ i_X₀) ≫ p₁_A
      exact (CategoryTheory.Category.assoc i_C q_C p₁_A).trans
        ((CategoryTheory.Limits.pullback.condition (f := ι_A) (g := f_C)).symm.trans
          ((congrArg (· ≫ ι_A) hq_C₀_hom.symm).trans
            ((CategoryTheory.Category.assoc q_C₀ P₁.hom ι_A).trans
              ((congrArg (q_C₀ ≫ ·)
                (CategoryTheory.Limits.pullback.lift_fst _ _ h_ix_cond).symm).trans
                (CategoryTheory.Category.assoc q_C₀ i_X₀ p₁_A).symm))))
    · change (i_C ≫ q_C) ≫ p₂_A = (q_C₀ ≫ i_X₀) ≫ p₂_A
      exact (CategoryTheory.Category.assoc i_C q_C p₂_A).trans
        ((CategoryTheory.Category.comp_id q_C₀).symm.trans
          ((congrArg (q_C₀ ≫ ·)
            (CategoryTheory.Limits.pullback.lift_snd _ _ h_ix_cond).symm).trans
            (CategoryTheory.Category.assoc q_C₀ i_X₀ p₂_A).symm))
  have hpb_C₀_flip : CategoryTheory.IsPullback i_C q_C₀ q_C i_X₀ := by
    refine CategoryTheory.IsPullback.of_bot ?_ h_top_comm hpb_X₀.flip
    rw [hq_C₀_hom]
    exact (CategoryTheory.IsPullback.of_hasPullback ι_A f_C).flip
  haveI : AlgebraicGeometry.IsFinite q_C₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_C₀_flip inferInstance
  have hLFT_P₁ : AlgebraicGeometry.LocallyOfFiniteType P₁.hom := by
    dsimp [P₁, weilProjectiveSpaceOver]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hSurj₀ : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro p
      have hp1 : p.1 ∈ (1 : Submodule k (MvPolynomial (Fin 2) k)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero]
        exact p.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp1
      exact ⟨c, Subtype.ext hc⟩
    have hFT₀ : (algebraMap k ↥(𝒜 0)).FiniteType :=
      RingHom.FiniteType.of_surjective _ hSurj₀
    have : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT₀
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin 2) k) :=
      @IsScalarTower.of_algebraMap_eq k ↥(𝒜 0) (MvPolynomial (Fin 2) k) _ _ _ _ _ _
        (fun _ => rfl)
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin 2) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin 2) k)
    infer_instance
  have hLFT_pC₀ : AlgebraicGeometry.LocallyOfFiniteType p_C₀ := by
    rw [← hq_C₀_hom]
    infer_instance
  haveI : AlgebraicGeometry.LocallyOfFiniteType p_C₀ := hLFT_pC₀
  have hf_YC : i_YC ≫ f_C = f_Y := by
    dsimp [f_C, f_Y]
    rw [← CategoryTheory.Category.assoc, hcomm]
  have h_iY₀C₀_cond : p_Y₀ ≫ ι_A = (i_Y ≫ i_YC) ≫ f_C := by
    rw [CategoryTheory.Category.assoc, hf_YC]
    exact CategoryTheory.Limits.pullback.condition
  let i_Y₀C₀ : Y₀ ⟶ C₀ := CategoryTheory.Limits.pullback.lift p_Y₀ (i_Y ≫ i_YC) h_iY₀C₀_cond
  have hi_Y₀C₀_fst : i_Y₀C₀ ≫ p_C₀ = p_Y₀ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hi_Y₀C₀_snd : i_Y₀C₀ ≫ i_C = i_Y ≫ i_YC :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hpb_Y₀C₀_flip : CategoryTheory.IsPullback i_Y i_Y₀C₀ i_YC i_C := by
    refine CategoryTheory.IsPullback.of_bot ?_ hi_Y₀C₀_snd.symm
      (CategoryTheory.IsPullback.of_hasPullback ι_A f_C).flip
    rw [hi_Y₀C₀_fst, hf_YC]
    exact (CategoryTheory.IsPullback.of_hasPullback ι_A f_Y).flip
  haveI : AlgebraicGeometry.IsClosedImmersion i_Y₀C₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hpb_Y₀C₀_flip inferInstance

  
  let K_Y : Set ↥C₀ := Set.range i_Y₀C₀.base
  have hKY_cl : IsClosed K_Y :=
    (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding i_Y₀C₀).isClosed_range
  let K_W : Set ↥C₀ := closure (K_Yᶜ)
  have hKW_cl : IsClosed K_W := isClosed_closure
  let K_V : Set ↥C₀ := K_Y ∩ K_W
  have hKV_cl : IsClosed K_V := hKY_cl.inter hKW_cl
  let I_W := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨K_W, hKW_cl⟩
  let W₀ : AlgebraicGeometry.Scheme.{u} := I_W.subscheme
  let i_W : W₀ ⟶ C₀ := I_W.subschemeι
  let I_V := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨K_V, hKV_cl⟩
  let V₀ : AlgebraicGeometry.Scheme.{u} := I_V.subscheme
  let i_V : V₀ ⟶ C₀ := I_V.subschemeι
  have hrange_W : Set.range i_W.base = K_W := by
    dsimp [i_W, I_W]
    rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
      AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hrange_V : Set.range i_V.base = K_V := by
    dsimp [i_V, I_V]
    rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
      AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hCov : Set.range i_Y₀C₀.base ∪ Set.range i_W.base = Set.univ := by
    rw [hrange_W]
    ext x
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    by_cases hx : x ∈ K_Y
    · exact Or.inl hx
    · exact Or.inr (subset_closure hx)
  have hInter : Set.range i_V.base = Set.range i_Y₀C₀.base ∩ Set.range i_W.base := by
    rw [hrange_V, hrange_W]
  obtain ⟨hKV_fin, hKV_pts⟩ :=
    weil_projLine_finite_cover_closed_bdy_finite_closed_pts k C₀ q_C₀ K_Y hKY_cl
  have hiV_inj : Function.Injective i_V.base :=
    (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding i_V).injective
  have hFin_V₀ : Finite ↥V₀ := by
    haveI : Finite ↥K_V := hKV_fin.to_subtype
    exact Finite.of_injective
      (fun v : ↥V₀ => (⟨i_V.base v, hrange_V ▸ ⟨v, rfl⟩⟩ : ↥K_V))
      (fun v₁ v₂ h => hiV_inj (congrArg Subtype.val h))
  have hCl_V₀ : ∀ v : ↥V₀, IsClosed ({v} : Set ↥V₀) := by
    intro v
    have hv_mem : i_V.base v ∈ K_V := hrange_V ▸ ⟨v, rfl⟩
    have hpre : IsClosed (i_V.base ⁻¹' ({i_V.base v} : Set ↥C₀)) :=
      (hKV_pts (i_V.base v) hv_mem).preimage i_V.continuous
    have heq_set : i_V.base ⁻¹' ({i_V.base v} : Set ↥C₀) = ({v} : Set ↥V₀) := by
      ext w
      simp [hiV_inj.eq_iff]
    rwa [heq_set] at hpre
  let p_V₀ : V₀ ⟶ S_k := i_V ≫ p_C₀
  have hSub_V₀ : Subsingleton ((weilEtaleTorsionSheaf V₀ ℓ).H 1) :=
    weil_etale_finite_closed_pts_algClosed_H_one_subsingleton
      k V₀ p_V₀ hFin_V₀ hCl_V₀ (weilEtaleTorsionSheaf V₀ ℓ)

  
  obtain ⟨hPullEx, _, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  have hCompPull : ∀ {W₁ W₂ W₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : W₁ ⟶ W₂) (h₂ : W₂ ⟶ W₃) (m i : ℕ)
      (p₁ : weilEtaleTorsionH W₂ m i →+ weilEtaleTorsionH W₁ m i)
      (p₂ : weilEtaleTorsionH W₃ m i →+ weilEtaleTorsionH W₂ m i),
      WeilIsTorsionEtalePullback h₁ m i p₁ →
      WeilIsTorsionEtalePullback h₂ m i p₂ →
      WeilIsTorsionEtalePullback (h₁ ≫ h₂) m i (p₁.comp p₂) := by
    intro W₁ W₂ W₃ h₁ h₂ m i p₁ p₂ hp₁ hp₂
    obtain ⟨p₁₂, hp₁₂⟩ := hPullEx (h₁ ≫ h₂) m i
    have heq := hPullComp h₁ h₂ m i p₁ p₂ p₁₂ hp₁ hp₂ hp₁₂
    rwa [heq] at hp₁₂
  have hSurjBridgeIff : ∀ {W₀ W : AlgebraicGeometry.Scheme.{u}} (h : W₀ ⟶ W) (m i : ℕ)
      (p : weilEtaleTorsionH W m i →+ weilEtaleTorsionH W₀ m i),
      WeilIsTorsionEtalePullback h m i p →
      (WeilEtaleCohomologyPullbackSurjective h (weilEtaleTorsionSheaf W m) i ↔
        Function.Surjective p) := by
    intro W₀ W h m i p hp
    let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp' hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp' hg)
    let B_h : CategoryTheory.Functor W.Etale W₀.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    let J₀ := W₀.smallEtaleTopology
    let J := W.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let C₀_sh := CategoryTheory.constantSheaf J₀ AddCommGrpCat.{u}
    let C_W := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Fℤ_W := C_W.obj Aℤ
    let Fℤ_W₀ := C₀_sh.obj Aℤ
    let FM_W := C_W.obj AM
    let FM_W₀ := C₀_sh.obj AM
    rcases hp with ⟨hCont, hAdj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπℤ, hπιℤ, hp_eq⟩
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J J₀
    let pb_h := B_h.sheafPullback AddCommGrpCat.{u} J J₀
    let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} J J₀
    let Pℤ_W := (CategoryTheory.Functor.const (Opposite W.Etale)).obj Aℤ
    let Pℤ_W₀ := (CategoryTheory.Functor.const (Opposite W₀.Etale)).obj Aℤ
    let shAdj₀ := CategoryTheory.sheafificationAdjunction J₀ AddCommGrpCat.{u}
    let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let η₀ := CategoryTheory.Functor.whiskerLeft B_h.op (shAdj₀.unit.app Pℤ_W₀)
    let e_sh : (Fℤ_W ⟶ pf_h.obj Fℤ_W₀) ≃
        (Pℤ_W ⟶ (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).obj (pf_h.obj Fℤ_W₀)) :=
      shAdj.homEquiv Pℤ_W (pf_h.obj Fℤ_W₀)
    let uℤ : Fℤ_W ⟶ pf_h.obj Fℤ_W₀ := e_sh.symm η₀
    let cℤ := (adj_h.homEquiv Fℤ_W Fℤ_W₀).symm uℤ
    let adj₁ := CategoryTheory.constantSheafAdj J₀ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₂
    let τ : B_h.obj T₂ ⟶ T₁ := hT₁.from (B_h.obj T₂)
    let g₀ : Aℤ ⟶ ((CategoryTheory.sheafSections J AddCommGrpCat.{u}).obj
        (Opposite.op T₂)).obj (pf_h.obj Fℤ_W₀) :=
      CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ) (Fℤ_W₀.obj.map τ.op)
    let wℤ : Fℤ_W ⟶ pf_h.obj Fℤ_W₀ := (adj₂.homEquiv Aℤ (pf_h.obj Fℤ_W₀)).symm g₀
    let πℤ : pb_h.obj Fℤ_W ⟶ Fℤ_W₀ := (adj_h.homEquiv Fℤ_W Fℤ_W₀).symm wℤ
    let πM : pb_h.obj FM_W ⟶ FM_W₀ :=
      (adj_h.homEquiv FM_W FM_W₀).symm
        ((adj₂.homEquiv AM (pf_h.obj FM_W₀)).symm
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM) (FM_W₀.obj.map τ.op)))
    have hu_eq_w : uℤ = wℤ := by
      refine e_sh.injective ((e_sh.apply_symm_apply η₀).trans ?_)
      have hsh_w : e_sh wℤ =
          shAdj.unit.app Pℤ_W ≫ (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map wℤ :=
        CategoryTheory.Adjunction.homEquiv_unit shAdj Pℤ_W (pf_h.obj Fℤ_W₀) wℤ
      refine hsh_w.symm ▸ ?_
      have hw_eval : (shAdj.unit.app Pℤ_W).app (Opposite.op T₂) ≫ wℤ.hom.app (Opposite.op T₂) =
          (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) ≫ Fℤ_W₀.obj.map τ.op := by
        have hw0 : (adj₂.homEquiv Aℤ (pf_h.obj Fℤ_W₀)) wℤ = g₀ :=
          (adj₂.homEquiv Aℤ (pf_h.obj Fℤ_W₀)).apply_symm_apply g₀
        have hw1 : (adj₂.homEquiv Aℤ (pf_h.obj Fℤ_W₀)) wℤ =
            adj₂.unit.app Aℤ ≫ wℤ.hom.app (Opposite.op T₂) :=
          CategoryTheory.Adjunction.homEquiv_unit adj₂ Aℤ (pf_h.obj Fℤ_W₀) wℤ
        have hadj₂_u : adj₂.unit.app Aℤ = (shAdj.unit.app Pℤ_W).app (Opposite.op T₂) :=
          CategoryTheory.Category.id_comp _
        have hadj₁_u : adj₁.unit.app Aℤ = (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) :=
          CategoryTheory.Category.id_comp _
        have hg0 : g₀ = (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) ≫ Fℤ_W₀.obj.map τ.op := by
          dsimp only [g₀]
          rw [hadj₁_u]
          rfl
        exact (congrArg (· ≫ wℤ.hom.app (Opposite.op T₂)) hadj₂_u.symm).trans
          (hw1.symm.trans (hw0.trans hg0))
      apply CategoryTheory.NatTrans.ext
      funext V
      let v_hom : V.unop ⟶ T₂ := hT₂.from V.unop
      have hA_step : (shAdj.unit.app Pℤ_W).app V =
          (shAdj.unit.app Pℤ_W).app (Opposite.op T₂) ≫ Fℤ_W.obj.map v_hom.op :=
        (CategoryTheory.Category.id_comp _).symm.trans
          ((shAdj.unit.app Pℤ_W).naturality v_hom.op)
      have hB_step : Fℤ_W.obj.map v_hom.op ≫ wℤ.hom.app V =
          wℤ.hom.app (Opposite.op T₂) ≫ Fℤ_W₀.obj.map (B_h.map v_hom).op :=
        wℤ.hom.naturality v_hom.op
      have hE_step : (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op (B_h.obj V.unop)) =
          (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) ≫
            Fℤ_W₀.obj.map (B_h.map v_hom ≫ τ).op :=
        (CategoryTheory.Category.id_comp _).symm.trans
          ((shAdj₀.unit.app Pℤ_W₀).naturality (B_h.map v_hom ≫ τ).op)
      let M_hom := Aℤ ⟶ Fℤ_W₀.obj.obj (Opposite.op (B_h.obj V.unop))
      let m₀ : M_hom := (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op (B_h.obj V.unop))
      let m₁ : M_hom := (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) ≫
        Fℤ_W₀.obj.map (B_h.map v_hom ≫ τ).op
      let m₂ : M_hom := ((shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) ≫ Fℤ_W₀.obj.map τ.op) ≫
        Fℤ_W₀.obj.map (B_h.map v_hom).op
      let m₃ : M_hom := ((shAdj.unit.app Pℤ_W).app (Opposite.op T₂) ≫
        wℤ.hom.app (Opposite.op T₂)) ≫ Fℤ_W₀.obj.map (B_h.map v_hom).op
      let m₄ : M_hom := (shAdj.unit.app Pℤ_W).app (Opposite.op T₂) ≫
        (Fℤ_W.obj.map v_hom.op ≫ wℤ.hom.app V)
      let m₅ : M_hom := (shAdj.unit.app Pℤ_W).app V ≫ wℤ.hom.app V
      have hm₀₁ : m₀ = m₁ := hE_step
      have hm₁₂ : m₁ = m₂ :=
        (congrArg ((shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) ≫ ·)
          ((congrArg Fℤ_W₀.obj.map
              (op_comp : (B_h.map v_hom ≫ τ).op = τ.op ≫ (B_h.map v_hom).op)).trans
            (Fℤ_W₀.obj.map_comp τ.op (B_h.map v_hom).op))).trans
          (CategoryTheory.Category.assoc _ _ _).symm
      have hm₂₃ : m₂ = m₃ :=
        congrArg (fun f : Aℤ ⟶ Fℤ_W₀.obj.obj (Opposite.op (B_h.obj T₂)) =>
          f ≫ Fℤ_W₀.obj.map (B_h.map v_hom).op) hw_eval.symm
      have hm₃₄ : m₃ = m₄ :=
        (CategoryTheory.Category.assoc _ _ _).trans
          (congrArg ((shAdj.unit.app Pℤ_W).app (Opposite.op T₂) ≫ ·) hB_step.symm)
      have hm₄₅ : m₄ = m₅ :=
        (CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ wℤ.hom.app V) hA_step.symm)
      exact hm₀₁.trans (hm₁₂.trans (hm₂₃.trans (hm₃₄.trans hm₄₅)))
    have hcℤ_eq : cℤ = πℤ := congrArg (adj_h.homEquiv Fℤ_W Fℤ_W₀).symm hu_eq_w
    have hcℤ : CategoryTheory.IsIso cℤ := by
      rw [hcℤ_eq]
      exact ⟨⟨ιℤ, hπιℤ, hιπℤ⟩⟩
    have hinv_cℤ : @CategoryTheory.inv _ _ _ _ cℤ hcℤ = ιℤ :=
      (@CategoryTheory.IsIso.eq_inv_of_hom_inv_id _ _ _ _ cℤ hcℤ ιℤ
        (by rw [hcℤ_eq]; exact hπιℤ)).symm
    let Fgt₀ := AlgebraicGeometry.Scheme.Etale.forget W₀
    have : CategoryTheory.Limits.PreservesLimits (CategoryTheory.Over.pullback h) :=
      (CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits
    have : CategoryTheory.Limits.PreservesFiniteLimits (B_h ⋙ Fgt₀) := by
      change CategoryTheory.Limits.PreservesFiniteLimits
        (AlgebraicGeometry.Scheme.Etale.forget W ⋙ CategoryTheory.Over.pullback h)
      infer_instance
    have : CategoryTheory.Limits.PreservesFiniteLimits B_h :=
      CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves B_h Fgt₀
    have hBT₂ : CategoryTheory.Limits.IsTerminal (B_h.obj T₂) :=
      CategoryTheory.Limits.IsTerminal.isTerminalObj B_h T₂ hT₂
    let τ_iso : B_h.obj T₂ ≅ T₁ :=
      { hom := τ
        inv := hBT₂.from T₁
        hom_inv_id := hBT₂.hom_ext _ _
        inv_hom_id := hT₁.hom_ext _ _ }
    let θ_τ : (CategoryTheory.sheafSections J₀ AddCommGrpCat.{u}).obj (Opposite.op T₁) ≅
        pf_h ⋙ (CategoryTheory.sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T₂) :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ =>
          { hom := ℱ.obj.map τ_iso.hom.op
            inv := ℱ.obj.map τ_iso.inv.op
            hom_inv_id := by
              change ℱ.obj.map τ_iso.hom.op ≫ ℱ.obj.map τ_iso.inv.op = 𝟙 _
              rw [← CategoryTheory.Functor.map_comp, ← op_comp, τ_iso.inv_hom_id, op_id,
                CategoryTheory.Functor.map_id]
            inv_hom_id := by
              change ℱ.obj.map τ_iso.inv.op ≫ ℱ.obj.map τ_iso.hom.op = 𝟙 _
              rw [← CategoryTheory.Functor.map_comp, ← op_comp, τ_iso.hom_inv_id, op_id,
                CategoryTheory.Functor.map_id] })
        (fun u => (u.hom.naturality τ_iso.hom.op).symm)
    let adj_comp := adj₂.comp adj_h
    let α_iso : C_W ⋙ pb_h ≅ C₀_sh :=
      adj_comp.leftAdjointUniq (adj₁.ofNatIsoRight θ_τ)
    have hπM_eq : πM = α_iso.hom.app AM := by
      apply (adj_comp.homEquiv AM FM_W₀).injective
      rw [CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app]
      have hpi : πM = (adj_comp.homEquiv AM FM_W₀).symm
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM) (FM_W₀.obj.map τ_iso.hom.op)) := by
        dsimp only [πM, adj_comp, τ_iso]
        rw [CategoryTheory.Adjunction.comp_homEquiv]
        rfl
      rw [hpi, Equiv.apply_symm_apply]
      rfl
    let ιM : FM_W₀ ⟶ pb_h.obj FM_W := α_iso.inv.app AM
    have hπιM : πM ≫ ιM = 𝟙 (pb_h.obj FM_W) := by
      rw [hπM_eq]
      exact α_iso.hom_inv_id_app AM
    have hιπM : ιM ≫ πM = 𝟙 FM_W₀ := by
      rw [hπM_eq]
      exact α_iso.inv_hom_id_app AM
    have hcancel_π : ∀ z : CategoryTheory.Abelian.Ext Fℤ_W₀ (pb_h.obj FM_W) i,
        (CategoryTheory.Abelian.Ext.mk₀ ιM).postcomp Fℤ_W₀ (Nat.add_zero i)
          ((CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ_W₀ (Nat.add_zero i) z) = z := by
      intro z
      change (z.comp (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero i)).comp
        (CategoryTheory.Abelian.Ext.mk₀ ιM) (Nat.add_zero i) = z
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ rfl,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hπιM,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
    have hcancel_ι : ∀ z : weilEtaleTorsionH W₀ m i,
        (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ_W₀ (Nat.add_zero i)
          ((CategoryTheory.Abelian.Ext.mk₀ ιM).postcomp Fℤ_W₀ (Nat.add_zero i) z) = z := by
      intro z
      change (z.comp (CategoryTheory.Abelian.Ext.mk₀ ιM) (Nat.add_zero i)).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero i) = z
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ rfl,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hιπM,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
    constructor
    · intro hSurjRaw z
      rcases hSurjRaw with ⟨hCont', hAdj', hAdd', hLim', hColim', hcℤ', hSurjFn⟩
      have hRaw : Function.Surjective (fun (x : weilEtaleTorsionH W m i) =>
          (CategoryTheory.Abelian.Ext.mk₀ (@CategoryTheory.inv _ _ _ _ cℤ hcℤ)).precomp
            (pb_h.obj FM_W) (Nat.zero_add i)
            ((pb_h.mapExtAddHom Fℤ_W FM_W i) x)) := hSurjFn
      obtain ⟨x, hx⟩ := hRaw ((CategoryTheory.Abelian.Ext.mk₀ ιM).postcomp Fℤ_W₀ (Nat.add_zero i) z)
      refine ⟨x, ?_⟩
      let lhs := (CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp (pb_h.obj FM_W) (Nat.zero_add i)
        ((pb_h.mapExtAddHom Fℤ_W FM_W i) x)
      have hlhs_eq : lhs = (CategoryTheory.Abelian.Ext.mk₀ ιM).postcomp Fℤ_W₀ (Nat.add_zero i) z := by
        refine (congrArg (fun f =>
          (CategoryTheory.Abelian.Ext.mk₀ f).precomp (pb_h.obj FM_W) (Nat.zero_add i)
            ((pb_h.mapExtAddHom Fℤ_W FM_W i) x)) hinv_cℤ.symm).trans hx
      exact (hp_eq x).trans
        ((congrArg ((CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ_W₀ (Nat.add_zero i)) hlhs_eq).trans
          (hcancel_ι z))
    · intro hsurj
      refine ⟨hCont, hAdj, hAdd, hLim, hColim, hcℤ, ?_⟩
      change Function.Surjective (fun (x : weilEtaleTorsionH W m i) =>
        (CategoryTheory.Abelian.Ext.mk₀ (@CategoryTheory.inv _ _ _ _ cℤ hcℤ)).precomp
          (pb_h.obj FM_W) (Nat.zero_add i)
          ((pb_h.mapExtAddHom Fℤ_W FM_W i) x))
      intro y
      obtain ⟨x, hx⟩ := hsurj ((CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ_W₀ (Nat.add_zero i) y)
      refine ⟨x, ?_⟩
      let lhs := (CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp (pb_h.obj FM_W) (Nat.zero_add i)
        ((pb_h.mapExtAddHom Fℤ_W FM_W i) x)
      have hgoal_eq :
          (CategoryTheory.Abelian.Ext.mk₀ (@CategoryTheory.inv _ _ _ _ cℤ hcℤ)).precomp
            (pb_h.obj FM_W) (Nat.zero_add i)
            ((pb_h.mapExtAddHom Fℤ_W FM_W i) x) = lhs :=
        congrArg (fun f =>
          (CategoryTheory.Abelian.Ext.mk₀ f).precomp (pb_h.obj FM_W) (Nat.zero_add i)
            ((pb_h.mapExtAddHom Fℤ_W FM_W i) x)) hinv_cℤ
      have hx' :
          (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ_W₀ (Nat.add_zero i) lhs =
            (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ_W₀ (Nat.add_zero i) y :=
        (hp_eq x).symm.trans hx
      exact hgoal_eq.trans ((hcancel_π lhs).symm.trans
        ((congrArg ((CategoryTheory.Abelian.Ext.mk₀ ιM).postcomp Fℤ_W₀ (Nat.add_zero i)) hx').trans
          (hcancel_π y)))

  
  obtain ⟨_, hCont_V, hAdj_V, hAdd_V, hLim_V, hColim_V, _⟩ := hPullEx i_V ℓ 1
  haveI : (weilEtaleSitePullback i_V).IsContinuous C₀.smallEtaleTopology V₀.smallEtaleTopology :=
    hCont_V
  haveI : ((weilEtaleSitePullback i_V).sheafPushforwardContinuous AddCommGrpCat.{u}
      C₀.smallEtaleTopology V₀.smallEtaleTopology).IsRightAdjoint := hAdj_V
  haveI : ((weilEtaleSitePullback i_V).sheafPullback AddCommGrpCat.{u}
      C₀.smallEtaleTopology V₀.smallEtaleTopology).Additive := hAdd_V
  haveI : CategoryTheory.Limits.PreservesFiniteLimits
      ((weilEtaleSitePullback i_V).sheafPullback AddCommGrpCat.{u}
        C₀.smallEtaleTopology V₀.smallEtaleTopology) := hLim_V
  haveI : CategoryTheory.Limits.PreservesFiniteColimits
      ((weilEtaleSitePullback i_V).sheafPullback AddCommGrpCat.{u}
        C₀.smallEtaleTopology V₀.smallEtaleTopology) := hColim_V
  have hSub_pfV : Subsingleton
      ((((weilEtaleSitePullback i_V).sheafPushforwardContinuous AddCommGrpCat.{u}
        C₀.smallEtaleTopology V₀.smallEtaleTopology).obj (weilEtaleTorsionSheaf V₀ ℓ)).H 1) :=
    (weil_etale_closedImmersion_pushforward_subsingleton_and_pullback_surj i_V).1
      1 (weilEtaleTorsionSheaf V₀ ℓ) hSub_V₀

  obtain ⟨_, hCont_W, _⟩ := hPullEx i_W ℓ 1
  haveI : (weilEtaleSitePullback i_W).IsContinuous C₀.smallEtaleTopology W₀.smallEtaleTopology :=
    hCont_W

  obtain ⟨p_iY₀C₀, hp_iY₀C₀⟩ := hPullEx i_Y₀C₀ ℓ 1
  obtain ⟨hCont_Y₀, hAdj_Y₀, hAdd_Y₀, hLim_Y₀, hColim_Y₀, _⟩ := id hp_iY₀C₀
  haveI : (weilEtaleSitePullback i_Y₀C₀).IsContinuous C₀.smallEtaleTopology Y₀.smallEtaleTopology :=
    hCont_Y₀
  haveI : ((weilEtaleSitePullback i_Y₀C₀).sheafPushforwardContinuous AddCommGrpCat.{u}
      C₀.smallEtaleTopology Y₀.smallEtaleTopology).IsRightAdjoint := hAdj_Y₀
  haveI : ((weilEtaleSitePullback i_Y₀C₀).sheafPullback AddCommGrpCat.{u}
      C₀.smallEtaleTopology Y₀.smallEtaleTopology).Additive := hAdd_Y₀
  haveI : CategoryTheory.Limits.PreservesFiniteLimits
      ((weilEtaleSitePullback i_Y₀C₀).sheafPullback AddCommGrpCat.{u}
        C₀.smallEtaleTopology Y₀.smallEtaleTopology) := hLim_Y₀
  haveI : CategoryTheory.Limits.PreservesFiniteColimits
      ((weilEtaleSitePullback i_Y₀C₀).sheafPullback AddCommGrpCat.{u}
        C₀.smallEtaleTopology Y₀.smallEtaleTopology) := hColim_Y₀

  have hSurj_ρY₀ :=
    weil_etale_closed_cover_torsion_H_one_surjective_of_inter_subsingleton
      C₀ Y₀ W₀ V₀ i_Y₀C₀ i_W i_V ℓ hCov hInter hSub_pfV
  have hSurj_pY₀C₀ : Function.Surjective p_iY₀C₀ :=
    (weil_etale_closedImmersion_pushforward_subsingleton_and_pullback_surj i_Y₀C₀).2
      ℓ 1 p_iY₀C₀ hp_iY₀C₀ hSurj_ρY₀

  obtain ⟨p_iC, hp_iC⟩ := hPullEx i_C ℓ 1
  obtain ⟨p_iY, hp_iY⟩ := hPullEx i_Y ℓ 1
  obtain ⟨p_iYC, hp_iYC⟩ := hPullEx i_YC ℓ 1
  have hSurj_pC : Function.Surjective p_iC :=
    (hSurjBridgeIff i_C ℓ 1 p_iC hp_iC).mp hSurjC
  have hp_left : WeilIsTorsionEtalePullback (i_Y₀C₀ ≫ i_C) ℓ 1 (p_iY₀C₀.comp p_iC) :=
    hCompPull i_Y₀C₀ i_C ℓ 1 p_iY₀C₀ p_iC hp_iY₀C₀ hp_iC
  rw [hi_Y₀C₀_snd] at hp_left
  have hEq_comp : p_iY₀C₀.comp p_iC = p_iY.comp p_iYC :=
    hPullComp i_Y i_YC ℓ 1 p_iY p_iYC (p_iY₀C₀.comp p_iC) hp_iY hp_iYC hp_left
  have hSurj_comp : Function.Surjective (p_iY.comp p_iYC) := by
    rw [← hEq_comp]
    exact hSurj_pY₀C₀.comp hSurj_pC
  have hSurj_pY : Function.Surjective p_iY := by
    intro y
    obtain ⟨c, hc⟩ := hSurj_comp y
    exact ⟨p_iYC c, hc⟩
  exact (hSurjBridgeIff i_Y ℓ 1 p_iY hp_iY).mpr hSurj_pY

theorem weil_etale_kummer_deg_one_pullback_surjective_of_gm (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (Z₀ Z : AlgebraicGeometry.Scheme.{u})
    (f_Z₀ : Z₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
    (f_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
    (h : Z₀ ⟶ Z) (h_k : h ≫ f_Z = f_Z₀)
    (p_Gm : (weilEtaleGmSheaf Z).H 1 →+ (weilEtaleGmSheaf Z₀).H 1)
    (hp_Gm : WeilIsGmEtalePullback h 1 p_Gm)
    (hDiv₀ : ∀ u : (weilEtaleGmSheaf Z₀).H 0, ∃ v : (weilEtaleGmSheaf Z₀).H 0, ℓ • v = u)
    (hSurjTors₁ : ∀ ξ₀ : (weilEtaleGmSheaf Z₀).H 1,
      ℓ • ξ₀ = 0 → ∃ ξ : (weilEtaleGmSheaf Z).H 1, ℓ • ξ = 0 ∧ p_Gm ξ = ξ₀) :
    WeilEtaleCohomologyPullbackSurjective h (weilEtaleTorsionSheaf Z ℓ) 1 :=
by
  classical
  let _ := h_k
  have hPrime : Nat.Prime ℓ := Fact.out
  letI : NeZero ℓ := ⟨hPrime.ne_zero⟩
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_h : CategoryTheory.Functor Z.Etale Z₀.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  rcases hp_Gm with ⟨hc, hr, ha, hl, hcol, hcℤ, θ_Gm, hθ_Gm, hp_Gm_eq⟩
  letI : B_h.IsContinuous Z.smallEtaleTopology Z₀.smallEtaleTopology := hc
  let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
    Z.smallEtaleTopology Z₀.smallEtaleTopology
  letI : pf_h.IsRightAdjoint := hr
  let pb_h := B_h.sheafPullback AddCommGrpCat.{u} Z.smallEtaleTopology Z₀.smallEtaleTopology
  let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
    Z.smallEtaleTopology Z₀.smallEtaleTopology
  letI : pb_h.Additive := ha
  letI : CategoryTheory.Limits.PreservesFiniteLimits pb_h := hl
  letI : CategoryTheory.Limits.PreservesFiniteColimits pb_h := hcol
  refine ⟨hc, hr, ha, hl, hcol, hcℤ, ?_⟩
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Pℤ_Z := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj Aℤ
  let Pℤ_Z₀ := (CategoryTheory.Functor.const (Opposite Z₀.Etale)).obj Aℤ
  let Fℤ_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_Z₀ := (CategoryTheory.constantSheaf Z₀.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
