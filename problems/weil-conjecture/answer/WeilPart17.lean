  have hMemEtale : ∀ (X : AlgebraicGeometry.Scheme.{u}) {U : X.Etale} (R : CategoryTheory.Sieve U),
      R ∈ X.smallEtaleTopology U ↔
        ∀ x : ↥U.left, ∃ (Y : X.Etale) (f : Y ⟶ U) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x := by
    intro X U R
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      fun _ _ f => AlgebraicGeometry.Etale f
    have : P_et.IsStableUnderComposition :=
      CategoryTheory.MorphismProperty.IsStableUnderComposition.mk
        (fun _ _ hf hg => by
          change AlgebraicGeometry.Etale _ at hf hg ⊢
          infer_instance)
    have hEqTop : X.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
