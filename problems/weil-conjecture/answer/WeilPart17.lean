      apply LocallyConstant.ext
      intro x
      have h_eval := congrArg
        (fun k : LocallyConstant ↥(Yx x).left (ULift.{u} (ZMod m)) => k (yx x))
        (ht' (fx x) (hR_fx x))
      change t'_lc ((fx x).left (yx x)) = (s_lc (fx x) (hR_fx x)) (yx x) at h_eval
      rw [hyx x] at h_eval
