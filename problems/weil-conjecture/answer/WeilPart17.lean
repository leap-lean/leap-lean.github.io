            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hβ_snd,
              AlgebraicGeometry.Scheme.Hom.comp_appTop]
            simp only [CategoryTheory.Category.assoc]
            rw [← hMorphRes_appTop p₂ D]
    refine ⟨hAff_W, Γ_β.commRingCatIsoToRingEquiv, ?_, ?_⟩
    · intro a
      exact congrArg (fun φ => CommRingCat.Hom.hom φ a) hΓ_inl
    · have hX := congrArg (fun φ => CommRingCat.Hom.hom φ Polynomial.X) hΓ_inr
      change Γ_β.commRingCatIsoToRingEquiv (Polynomial.X.map (algebraMap k A)) =
        (CommRingCat.Hom.hom (p₂.app D))
