    obtain ⟨q₀, p_gen₀, hp_gen₀⟩ := Module.Finite.exists_fin' D₀.R₀ E₀.L₀
    let v₀ : Fin q₀ → E₀.L₀ := fun a => p_gen₀ (Pi.single a 1)
