          _ = (s ⊗ₜ[R] (1 : T)) * ((1 : T) ⊗ₜ[R] (x : T)) := by rw [← hx]
          _ = s ⊗ₜ[R] (x : T) := by simp [Algebra.TensorProduct.tmul_mul_tmul]
      refine ⟨L_u, LinearEquiv.ofLinear e_fun e_inv h_right_inv_comp h_left_inv_comp,
        hL_mem, ?_⟩
      intro s x
      simp [e_fun, smul_eq_mul]
    have hg_inv :
        p₁₃ (↑g⁻¹ : TensorProduct R T T) =
          p₁₂ (↑g⁻¹ : TensorProduct R T T) * p₂₃ (↑g⁻¹ : TensorProduct R T T) := by
      let u13 : Units (TensorProduct R (TensorProduct R T T) T) :=
        Units.map p₁₃.toMonoidHom g
      apply u13.mul_right_inj.mp
      change p₁₃ (g : TensorProduct R T T) * p₁₃ (↑g⁻¹ : TensorProduct R T T) =
        p₁₃ (g : TensorProduct R T T) *
          (p₁₂ (↑g⁻¹ : TensorProduct R T T) * p₂₃ (↑g⁻¹ : TensorProduct R T T))
      have lhs1 : p₁₃ (g : TensorProduct R T T) * p₁₃ (↑g⁻¹ : TensorProduct R T T) = 1 := by
        rw [← map_mul, Units.mul_inv, map_one]
      have rhs1 :
          p₁₃ (g : TensorProduct R T T) *
            (p₁₂ (↑g⁻¹ : TensorProduct R T T) * p₂₃ (↑g⁻¹ : TensorProduct R T T)) = 1 := by
        calc
          p₁₃ (g : TensorProduct R T T) *
              (p₁₂ (↑g⁻¹ : TensorProduct R T T) * p₂₃ (↑g⁻¹ : TensorProduct R T T))
              = (p₁₂ (g : TensorProduct R T T) * p₂₃ (g : TensorProduct R T T)) *
                  (p₁₂ (↑g⁻¹ : TensorProduct R T T) * p₂₃ (↑g⁻¹ : TensorProduct R T T)) := by
                rw [hg]
          _ = (p₁₂ (g : TensorProduct R T T) * p₁₂ (↑g⁻¹ : TensorProduct R T T)) *
                (p₂₃ (g : TensorProduct R T T) * p₂₃ (↑g⁻¹ : TensorProduct R T T)) := by
                ring
          _ = p₁₂ ((g : TensorProduct R T T) * (↑g⁻¹ : TensorProduct R T T)) *
                p₂₃ ((g : TensorProduct R T T) * (↑g⁻¹ : TensorProduct R T T)) := by
                rw [← map_mul, ← map_mul]
          _ = 1 := by simp [Units.mul_inv]
      exact lhs1.trans rhs1.symm
    obtain ⟨L_pos, e_pos, hL_pos_mem, he_pos_tmul⟩ := h_cocycle_triv g hg
    obtain ⟨L_neg, e_neg, hL_neg_mem, he_neg_tmul⟩ := h_cocycle_triv g⁻¹ hg_inv
    have h_xy_eq : ∀ (x : ↥L_pos) (y : ↥L_neg),
        ((1 : T) ⊗ₜ[R] ((x : T) * (y : T)) : TensorProduct R T T) =
          ((x : T) * (y : T)) ⊗ₜ[R] (1 : T) := by
      intro x y
      have hx : ((1 : T) ⊗ₜ[R] (x : T) : TensorProduct R T T) =
          (g : TensorProduct R T T) * ((x : T) ⊗ₜ[R] (1 : T)) :=
        (hL_pos_mem (x : T)).mp x.2
      have hy : ((1 : T) ⊗ₜ[R] (y : T) : TensorProduct R T T) =
          (↑g⁻¹ : TensorProduct R T T) * ((y : T) ⊗ₜ[R] (1 : T)) :=
        (hL_neg_mem (y : T)).mp y.2
      calc
        ((1 : T) ⊗ₜ[R] ((x : T) * (y : T)) : TensorProduct R T T)
            = ((1 : T) ⊗ₜ[R] (x : T)) * ((1 : T) ⊗ₜ[R] (y : T)) := by
              simp [Algebra.TensorProduct.tmul_mul_tmul]
        _ = ((g : TensorProduct R T T) * ((x : T) ⊗ₜ[R] (1 : T))) *
              ((↑g⁻¹ : TensorProduct R T T) * ((y : T) ⊗ₜ[R] (1 : T))) := by
              rw [hx, hy]
        _ = ((g : TensorProduct R T T) * (↑g⁻¹ : TensorProduct R T T)) *
              (((x : T) ⊗ₜ[R] (1 : T)) * ((y : T) ⊗ₜ[R] (1 : T))) := by
              ring
        _ = ((x : T) * (y : T)) ⊗ₜ[R] (1 : T) := by
              simp [Units.mul_inv, Algebra.TensorProduct.tmul_mul_tmul]
    have hBμ_exists :
        ∃ (B : ↥L_pos →ₗ[R] ↥L_neg →ₗ[R] R)
          (μ_L : TensorProduct R ↥L_pos ↥L_neg →ₗ[R] R),
          (∀ (x : ↥L_pos) (y : ↥L_neg), algebraMap R T (B x y) = (x : T) * (y : T)) ∧
          (∀ (x : ↥L_pos) (y : ↥L_neg), μ_L (x ⊗ₜ[R] y) = B x y) := by
      let b_fun : ↥L_pos → ↥L_neg → R :=
        fun x y => Classical.choose (h_eq ((x : T) * (y : T)) (h_xy_eq x y))
      have hb : ∀ (x : ↥L_pos) (y : ↥L_neg), algebraMap R T (b_fun x y) = (x : T) * (y : T) :=
        fun x y => Classical.choose_spec (h_eq ((x : T) * (y : T)) (h_xy_eq x y))
      let B₀ : ↥L_pos →ₗ[R] ↥L_neg →ₗ[R] R :=
        LinearMap.mk₂ R b_fun
          (fun x₁ x₂ y => h_inj (by simp [hb, add_mul]))
          (fun r x y => h_inj (by simp [hb, Algebra.smul_def, mul_assoc]))
          (fun x y₁ y₂ => h_inj (by simp [hb, mul_add]))
          (fun r x y => h_inj (by simp [hb, Algebra.smul_def, mul_left_comm]))
      exact ⟨B₀, TensorProduct.lift B₀, fun x y => hb x y, fun x y => rfl⟩
    obtain ⟨B, μ_L, hB_alg, hμ_tmul⟩ := hBμ_exists
    have hμ_surj_one : ∃ τ₀ : TensorProduct R ↥L_pos ↥L_neg, μ_L τ₀ = 1 := by
      have h_range_top : LinearMap.range μ_L = (⊤ : Ideal R) := by
        by_contra hI_ne
        obtain ⟨𝔪, h𝔪_max, hI_le⟩ := Ideal.exists_le_maximal (LinearMap.range μ_L) hI_ne
        have h𝔪_top : 𝔪 • (⊤ : Submodule R T) = ⊤ := by
          rw [eq_top_iff]
          intro t _
          obtain ⟨S₁, hS₁⟩ := TensorProduct.exists_finset (e_pos.symm (1 : T))
          obtain ⟨S₂, hS₂⟩ := TensorProduct.exists_finset (e_neg.symm (1 : T))
          have he₁ : (1 : T) = S₁.sum (fun p => p.1 * (p.2 : T)) := by
            calc
              (1 : T) = e_pos (e_pos.symm (1 : T)) := (e_pos.apply_symm_apply (1 : T)).symm
              _ = e_pos (S₁.sum (fun p => p.1 ⊗ₜ[R] p.2)) := congrArg e_pos hS₁
              _ = S₁.sum (fun p => e_pos (p.1 ⊗ₜ[R] p.2)) := map_sum e_pos _ _
              _ = S₁.sum (fun p => p.1 * (p.2 : T)) := by
                    refine Finset.sum_congr rfl ?_
                    intro p _
                    exact he_pos_tmul p.1 p.2
          have he₂ : (1 : T) = S₂.sum (fun q => q.1 * (q.2 : T)) := by
            calc
              (1 : T) = e_neg (e_neg.symm (1 : T)) := (e_neg.apply_symm_apply (1 : T)).symm
              _ = e_neg (S₂.sum (fun q => q.1 ⊗ₜ[R] q.2)) := congrArg e_neg hS₂
              _ = S₂.sum (fun q => e_neg (q.1 ⊗ₜ[R] q.2)) := map_sum e_neg _ _
              _ = S₂.sum (fun q => q.1 * (q.2 : T)) := by
                    refine Finset.sum_congr rfl ?_
                    intro q _
                    exact he_neg_tmul q.1 q.2
          have h1_prod :
              (1 : T) = S₁.sum (fun p => S₂.sum (fun q =>
                (p.1 * (p.2 : T)) * (q.1 * (q.2 : T)))) := by
            calc
              (1 : T) = (1 : T) * (1 : T) := (mul_one 1).symm
              _ = (S₁.sum (fun p => p.1 * (p.2 : T))) *
                    (S₂.sum (fun q => q.1 * (q.2 : T))) :=
                    congrArg₂ (· * ·) he₁ he₂
              _ = S₁.sum (fun p => S₂.sum (fun q =>
                    (p.1 * (p.2 : T)) * (q.1 * (q.2 : T)))) :=
                    Finset.sum_mul_sum S₁ S₂ _ _
          have ht_sum :
              t = S₁.sum (fun p => S₂.sum (fun q =>
                (μ_L (p.2 ⊗ₜ[R] q.2)) • (t * p.1 * q.1))) := by
            calc
              t = t * (1 : T) := (mul_one t).symm
              _ = t * S₁.sum (fun p => S₂.sum (fun q =>
                    (p.1 * (p.2 : T)) * (q.1 * (q.2 : T)))) :=
                    congrArg (t * ·) h1_prod
              _ = S₁.sum (fun p => t * S₂.sum (fun q =>
                    (p.1 * (p.2 : T)) * (q.1 * (q.2 : T)))) :=
                    Finset.mul_sum S₁ _ t
              _ = S₁.sum (fun p => S₂.sum (fun q =>
                    t * ((p.1 * (p.2 : T)) * (q.1 * (q.2 : T))))) := by
                    refine Finset.sum_congr rfl ?_
                    intro p _
                    exact Finset.mul_sum S₂ _ t
              _ = S₁.sum (fun p => S₂.sum (fun q =>
                    (μ_L (p.2 ⊗ₜ[R] q.2)) • (t * p.1 * q.1))) := by
                    refine Finset.sum_congr rfl ?_
                    intro p _
                    refine Finset.sum_congr rfl ?_
                    intro q _
                    have hμ_pq : algebraMap R T (μ_L (p.2 ⊗ₜ[R] q.2)) =
                        (p.2 : T) * (q.2 : T) := by
                      rw [hμ_tmul, hB_alg]
                    rw [Algebra.smul_def, hμ_pq]
                    ring
          rw [ht_sum]
          refine Submodule.sum_mem _ ?_
          intro p _
          refine Submodule.sum_mem _ ?_
          intro q _
          exact Submodule.smul_mem_smul (A := R) (M := T) (I := 𝔪) (N := (⊤ : Submodule R T))
            (hI_le (LinearMap.mem_range_self μ_L (p.2 ⊗ₜ[R] q.2))) Submodule.mem_top
        exact Module.FaithfullyFlat.submodule_ne_top (R := R) (M := T) h𝔪_max h𝔪_top
      have h1_mem : (1 : R) ∈ LinearMap.range μ_L := by
        rw [h_range_top]
        exact Submodule.mem_top
      exact LinearMap.mem_range.mp h1_mem
    obtain ⟨τ₀, hτ₀⟩ := hμ_surj_one
    let ν_L : R →ₗ[R] TensorProduct R ↥L_pos ↥L_neg :=
      LinearMap.toSpanSingleton R (TensorProduct R ↥L_pos ↥L_neg) τ₀
    have h_μν : μ_L.comp ν_L = LinearMap.id := by
      ext r
      simp [ν_L, LinearMap.toSpanSingleton_apply, map_smul, hτ₀]
    have h_swap_pos : ∀ (x₁ x₂ : ↥L_pos) (y : ↥L_neg),
        (B x₁ y) • x₂ = (B x₂ y) • x₁ := by
      intro x₁ x₂ y
      apply Subtype.ext
      simp only [Submodule.coe_smul, Algebra.smul_def, hB_alg]
      ring
    have h_swap_neg : ∀ (x : ↥L_pos) (y₁ y₂ : ↥L_neg),
        (B x y₁) • y₂ = (B x y₂) • y₁ := by
      intro x y₁ y₂
      apply Subtype.ext
      simp only [Submodule.coe_smul, Algebra.smul_def, hB_alg]
      ring
    have h_νμ : ν_L.comp μ_L = LinearMap.id := by
      obtain ⟨S₀, hS₀⟩ := TensorProduct.exists_finset τ₀
      have hS₀_sum : S₀.sum (fun p => B p.1 p.2) = 1 := by
        calc
          S₀.sum (fun p => B p.1 p.2)
              = S₀.sum (fun p => μ_L (p.1 ⊗ₜ[R] p.2)) := by
                refine Finset.sum_congr rfl ?_
                intro p _
                exact (hμ_tmul p.1 p.2).symm
          _ = μ_L (S₀.sum (fun p => p.1 ⊗ₜ[R] p.2)) := (map_sum μ_L _ _).symm
          _ = μ_L τ₀ := congrArg μ_L hS₀.symm
          _ = 1 := hτ₀
      apply TensorProduct.ext'
      intro x y
      simp only [LinearMap.comp_apply, LinearMap.id_apply, ν_L,
        LinearMap.toSpanSingleton_apply, hμ_tmul]
      calc
        (B x y) • τ₀
            = (B x y) • S₀.sum (fun p => p.1 ⊗ₜ[R] p.2) := congrArg ((B x y) • ·) hS₀
        _ = S₀.sum (fun p => (B x y) • (p.1 ⊗ₜ[R] p.2)) := Finset.smul_sum
        _ = S₀.sum (fun p => ((B x y) • p.1) ⊗ₜ[R] p.2) := by
              refine Finset.sum_congr rfl ?_
              intro p _
              exact TensorProduct.smul_tmul' (B x y) p.1 p.2
        _ = S₀.sum (fun p => ((B p.1 y) • x) ⊗ₜ[R] p.2) := by
              refine Finset.sum_congr rfl ?_
              intro p _
              rw [h_swap_pos x p.1 y]
        _ = S₀.sum (fun p => x ⊗ₜ[R] ((B p.1 y) • p.2)) := by
              refine Finset.sum_congr rfl ?_
              intro p _
              exact TensorProduct.smul_tmul (B p.1 y) x p.2
        _ = S₀.sum (fun p => x ⊗ₜ[R] ((B p.1 p.2) • y)) := by
              refine Finset.sum_congr rfl ?_
              intro p _
              rw [h_swap_neg p.1 y p.2]
        _ = x ⊗ₜ[R] (S₀.sum (fun p => (B p.1 p.2) • y)) :=
              (TensorProduct.tmul_sum x S₀ (fun p => (B p.1 p.2) • y)).symm
        _ = x ⊗ₜ[R] ((S₀.sum (fun p => B p.1 p.2)) • y) := by
              rw [Finset.sum_smul]
        _ = x ⊗ₜ[R] ((1 : R) • y) :=
              congrArg (fun r => x ⊗ₜ[R] (r • y)) hS₀_sum
        _ = x ⊗ₜ[R] y := by rw [one_smul]
    have hInv : Module.Invertible R ↥L_pos :=
      Module.Invertible.left (LinearEquiv.ofLinear μ_L ν_L h_μν h_νμ)
    have he_pos_one : ∀ x : ↥L_pos, e_pos ((1 : T) ⊗ₜ[R] x) = (x : T) := by
      intro x
      rw [he_pos_tmul, one_mul]
    refine ⟨↥L_pos, inferInstance, inferInstance, hInv, e_pos, ?_, ?_, ?_⟩
    · intro x
      rw [he_pos_one x]
      exact (hL_pos_mem (x : T)).mp x.2
    · intro x₁ x₂ h12
      exact Subtype.ext ((he_pos_one x₁).symm.trans (h12.trans (he_pos_one x₂)))
    · intro t ht
      refine ⟨⟨t, (hL_pos_mem t).mpr ht⟩, ?_⟩
      exact he_pos_one ⟨t, (hL_pos_mem t).mpr ht⟩
  · intro R L _ _ _ _
    let cL : TensorProduct R (Module.Dual R L) L ≃ₗ[R] R :=
      LinearEquiv.ofBijective (contractLeft R L) Module.Invertible.bijective
    let τ₁ : TensorProduct R (Module.Dual R L) L := cL.symm (1 : R)
    obtain ⟨S, hS⟩ := TensorProduct.exists_finset τ₁
    let m : ℕ := S.card
    let ε : ↥S ≃ Fin m := S.equivFin
    let φ : Fin m → Module.Dual R L := fun a => (ε.symm a).1.1
    let v : Fin m → L := fun a => (ε.symm a).1.2
    let f : Fin m → R := fun a => φ a (v a)
    have hτ₁_sum : τ₁ = Finset.univ.sum (fun a : Fin m => φ a ⊗ₜ[R] v a) := by
      rw [hS, ← Finset.sum_attach S (fun p => p.1 ⊗ₜ[R] p.2), ← Finset.sum_coe_sort_eq_attach]
      exact (Equiv.sum_comp ε.symm (fun q : ↥S => q.1.1 ⊗ₜ[R] q.1.2)).symm
    have hcL_tmul : ∀ (ψ : Module.Dual R L) (w : L), cL (ψ ⊗ₜ[R] w) = ψ w := by
      intro ψ w
      exact contractLeft_apply ψ w
    have hf_sum : Finset.univ.sum f = 1 := by
      calc
        Finset.univ.sum f
            = Finset.univ.sum (fun a : Fin m => cL (φ a ⊗ₜ[R] v a)) := by
              refine Finset.sum_congr rfl ?_
              intro a _
              exact (hcL_tmul (φ a) (v a)).symm
        _ = cL (Finset.univ.sum (fun a : Fin m => φ a ⊗ₜ[R] v a)) := (map_sum cL _ _).symm
        _ = cL τ₁ := by rw [← hτ₁_sum]
        _ = 1 := cL.apply_symm_apply (1 : R)
    let F : L →ₗ[R] L :=
      Finset.univ.sum (fun a : Fin m => (LinearMap.toSpanSingleton R L (v a)).comp (φ a))
    have hF_apply : ∀ x : L, F x = Finset.univ.sum (fun a : Fin m => (φ a x) • v a) := by
      intro x
      simp [F, LinearMap.sum_apply, LinearMap.toSpanSingleton_apply]
    have h_tmul_eq : ∀ (ψ : Module.Dual R L) (w : L), ψ ⊗ₜ[R] w = (ψ w) • τ₁ := by
      intro ψ w
      apply cL.injective
      rw [hcL_tmul, map_smul, cL.apply_symm_apply, smul_eq_mul, mul_one]
    have h_swap : ∀ (ψ : Module.Dual R L) (w x : L), (ψ x) • w = (ψ w) • F x := by
      intro ψ w x
      let E_x : TensorProduct R (Module.Dual R L) L →ₗ[R] L :=
        TensorProduct.lift ((LinearMap.lsmul R L).comp (Module.Dual.eval R L x))
      have hE_tmul : ∀ (ξ : Module.Dual R L) (y : L), E_x (ξ ⊗ₜ[R] y) = (ξ x) • y := by
        intro ξ y
        simp [E_x]
      have hE_τ₁ : E_x τ₁ = F x := by
        rw [hτ₁_sum, map_sum, hF_apply]
        refine Finset.sum_congr rfl ?_
        intro a _
        exact hE_tmul (φ a) (v a)
      calc
        (ψ x) • w = E_x (ψ ⊗ₜ[R] w) := (hE_tmul ψ w).symm
        _ = E_x ((ψ w) • τ₁) := by rw [h_tmul_eq ψ w]
        _ = (ψ w) • E_x τ₁ := map_smul E_x (ψ w) τ₁
        _ = (ψ w) • F x := by rw [hE_τ₁]
    have hFF : ∀ w : L, F (F w) = w := by
      intro w
      calc
        F (F w)
            = F (Finset.univ.sum (fun a : Fin m => (φ a w) • v a)) := congrArg F (hF_apply w)
        _ = Finset.univ.sum (fun a : Fin m => F ((φ a w) • v a)) := map_sum F _ _
        _ = Finset.univ.sum (fun a : Fin m => (φ a w) • F (v a)) := by
              refine Finset.sum_congr rfl ?_
              intro a _
              exact map_smul F (φ a w) (v a)
        _ = Finset.univ.sum (fun a : Fin m => (φ a (v a)) • w) := by
              refine Finset.sum_congr rfl ?_
              intro a _
              exact (h_swap (φ a) w (v a)).symm
        _ = (Finset.univ.sum f) • w := by rw [Finset.sum_smul]
        _ = (1 : R) • w := by rw [hf_sum]
        _ = w := one_smul R w
    have h_conseqB : ∀ (a : Fin m) (x : L), (φ a (F x)) • v a = f a • x := by
      intro a x
      calc
        (φ a (F x)) • v a = (φ a (v a)) • F (F x) := h_swap (φ a) (v a) (F x)
        _ = f a • x := by rw [hFF x]
    have h_conseqC : ∀ a : Fin m, f a * φ a (F (v a)) = f a * f a := by
      intro a
      have h1 := congrArg (φ a) (h_conseqB a (v a))
      simp only [map_smul, smul_eq_mul] at h1
      change φ a (F (v a)) * f a = f a * f a at h1
      rw [mul_comm]
      exact h1
    refine ⟨m, f, ?_, hf_sum⟩
    intro a
    let R_a := Localization.Away (f a)
    let u_a : R_a := IsLocalization.Away.invSelf (S := R_a) (f a)
    have hu_a : algebraMap R R_a (f a) * u_a = 1 :=
      IsLocalization.Away.mul_invSelf (f a)
    let lam_a : L →ₗ[R] R_a :=
      ((LinearMap.mulRight R_a u_a).restrictScalars R).comp
        ((Algebra.linearMap R R_a).comp ((φ a).comp F))
    let β_a : TensorProduct R R_a L →ₗ[R_a] R_a :=
      LinearMap.liftBaseChange R_a lam_a
    let α_a : R_a →ₗ[R_a] TensorProduct R R_a L :=
      LinearMap.toSpanSingleton R_a (TensorProduct R R_a L) ((1 : R_a) ⊗ₜ[R] v a)
    have hβ_tmul : ∀ (r : R_a) (x : L),
        β_a (r ⊗ₜ[R] x) = r * (algebraMap R R_a (φ a (F x)) * u_a) := by
      intro r x
      simp [β_a, lam_a, LinearMap.liftBaseChange_tmul, smul_eq_mul]
    have hα_apply : ∀ r : R_a, α_a r = r ⊗ₜ[R] v a := by
      intro r
      simp [α_a, LinearMap.toSpanSingleton_apply, TensorProduct.smul_tmul', smul_eq_mul]
    have h_unit_a : algebraMap R R_a (φ a (F (v a))) * u_a = 1 := by
      calc
        algebraMap R R_a (φ a (F (v a))) * u_a
            = (algebraMap R R_a (φ a (F (v a))) * u_a) * 1 := (mul_one _).symm
        _ = (algebraMap R R_a (φ a (F (v a))) * u_a) * (algebraMap R R_a (f a) * u_a) :=
              congrArg ((algebraMap R R_a (φ a (F (v a))) * u_a) * ·) hu_a.symm
        _ = (algebraMap R R_a (f a) * algebraMap R R_a (φ a (F (v a)))) * (u_a * u_a) := by
              ring
        _ = algebraMap R R_a (f a * φ a (F (v a))) * (u_a * u_a) :=
              congrArg (· * (u_a * u_a)) (map_mul (algebraMap R R_a) (f a) (φ a (F (v a)))).symm
        _ = algebraMap R R_a (f a * f a) * (u_a * u_a) :=
              congrArg (fun x => algebraMap R R_a x * (u_a * u_a)) (h_conseqC a)
        _ = (algebraMap R R_a (f a) * u_a) * (algebraMap R R_a (f a) * u_a) := by
              rw [map_mul]
              ring
        _ = 1 * 1 := congrArg₂ (· * ·) hu_a hu_a
        _ = 1 := mul_one 1
    have h_right_a : β_a.comp α_a = LinearMap.id := by
      ext r
      simp only [LinearMap.comp_apply, LinearMap.id_apply, hα_apply, hβ_tmul, h_unit_a, mul_one]
    have h_left_a : α_a.comp β_a = LinearMap.id := by
      apply LinearMap.restrictScalars_injective R
      apply TensorProduct.ext'
      intro r x
      simp only [LinearMap.restrictScalars_apply, LinearMap.comp_apply, LinearMap.id_apply,
        hβ_tmul, hα_apply]
      have h_rw1 :
          r * (algebraMap R R_a (φ a (F x)) * u_a) = (φ a (F x)) • (r * u_a) := by
        rw [Algebra.smul_def]
        ring
      have h_rw2 : (f a) • (r * u_a) = r := by
        calc
          (f a) • (r * u_a) = algebraMap R R_a (f a) * (r * u_a) := Algebra.smul_def _ _
          _ = r * (algebraMap R R_a (f a) * u_a) := by ring
          _ = r * 1 := congrArg (r * ·) hu_a
          _ = r := mul_one r
      calc
        (r * (algebraMap R R_a (φ a (F x)) * u_a)) ⊗ₜ[R] v a
            = ((φ a (F x)) • (r * u_a)) ⊗ₜ[R] v a := congrArg (· ⊗ₜ[R] v a) h_rw1
        _ = (r * u_a) ⊗ₜ[R] ((φ a (F x)) • v a) := TensorProduct.smul_tmul _ _ _
        _ = (r * u_a) ⊗ₜ[R] ((f a) • x) := congrArg ((r * u_a) ⊗ₜ[R] ·) (h_conseqB a x)
        _ = ((f a) • (r * u_a)) ⊗ₜ[R] x := (TensorProduct.smul_tmul _ _ _).symm
        _ = r ⊗ₜ[R] x := congrArg (· ⊗ₜ[R] x) h_rw2
    exact LinearEquiv.ofLinear β_a α_a h_right_a h_left_a

theorem weil_etale_cech_gm_H1_functorial_exact_and_twoChart_effacement : ∃ cechCl : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.Etale)
        (w : W ⟶ weilEtaleIdTerminal.{u} Z),
        AlgebraicGeometry.Surjective w.left →
        ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker →+ (weilEtaleGmSheaf Z).H 1,
      (∀ (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.Etale)
          (w : W ⟶ weilEtaleIdTerminal.{u} Z) (hw : AlgebraicGeometry.Surjective w.left)
          (c : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker),
        cechCl Z W w hw c = 0 ↔
          ∃ b : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 0))),
            weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 0 b = c.1) ∧
      (∀ (Z : AlgebraicGeometry.Scheme.{u})
          (W W' : Z.Etale)
          (w : W ⟶ weilEtaleIdTerminal.{u} Z) (hw : AlgebraicGeometry.Surjective w.left)
          (w' : W' ⟶ weilEtaleIdTerminal.{u} Z) (hw' : AlgebraicGeometry.Surjective w'.left)
          (f_W : W'.left ⟶ W.left) (_ : f_W ≫ W.hom = W'.hom)
          (f_W₂ : (weilEtaleCechObj w' 1).left ⟶ (weilEtaleCechObj w 1).left),
        f_W₂ ≫ (weilEtaleCechProj w 1 0).left = (weilEtaleCechProj w' 1 0).left ≫ f_W →
        f_W₂ ≫ (weilEtaleCechProj w 1 1).left = (weilEtaleCechProj w' 1 1).left ≫ f_W →
        ∀ c : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker,
          let c' : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w' 1))) :=
            (MonoidHom.toAdditive (Units.map f_W₂.appTop.hom.toMonoidHom)) c.1
          ∃ hc' : c' ∈ (weilEtaleCechDiff (weilEtaleGmPresheaf Z) w' 1).ker,
            cechCl Z W' w' hw' ⟨c', hc'⟩ = cechCl Z W w hw c) ∧
      (∀ {Z₀ Z : AlgebraicGeometry.Scheme.{u}} (h : Z₀ ⟶ Z)
          (p_Gm : (weilEtaleGmSheaf Z).H 1 →+ (weilEtaleGmSheaf Z₀).H 1)
          (_ : WeilIsGmEtalePullback h 1 p_Gm)
          (W : Z.Etale) (w : W ⟶ weilEtaleIdTerminal.{u} Z) (hw : AlgebraicGeometry.Surjective w.left)
          (W₀ : Z₀.Etale) (w₀ : W₀ ⟶ weilEtaleIdTerminal.{u} Z₀) (hw₀ : AlgebraicGeometry.Surjective w₀.left)
          (f_W : W₀.left ⟶ W.left) (_ : f_W ≫ W.hom = W₀.hom ≫ h)
          (f_W₂ : (weilEtaleCechObj w₀ 1).left ⟶ (weilEtaleCechObj w 1).left),
        f_W₂ ≫ (weilEtaleCechProj w 1 0).left = (weilEtaleCechProj w₀ 1 0).left ≫ f_W →
        f_W₂ ≫ (weilEtaleCechProj w 1 1).left = (weilEtaleCechProj w₀ 1 1).left ≫ f_W →
        ∀ c : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker,
          let c₀ : ↑((weilEtaleGmPresheaf Z₀).obj (Opposite.op (weilEtaleCechObj w₀ 1))) :=
            (MonoidHom.toAdditive (Units.map f_W₂.appTop.hom.toMonoidHom)) c.1
          ∃ hc₀ : c₀ ∈ (weilEtaleCechDiff (weilEtaleGmPresheaf Z₀) w₀ 1).ker,
            p_Gm (cechCl Z W w hw c) = cechCl Z₀ W₀ w₀ hw₀ ⟨c₀, hc₀⟩) ∧
      (∀ (Z : AlgebraicGeometry.Scheme.{u})
          (S₀ S₁ : Type u) [CommRing S₀] [CommRing S₁]
          (j₀ : AlgebraicGeometry.Spec (CommRingCat.of S₀) ⟶ Z) [AlgebraicGeometry.IsOpenImmersion j₀]
          (j₁ : AlgebraicGeometry.Spec (CommRingCat.of S₁) ⟶ Z) [AlgebraicGeometry.IsOpenImmersion j₁],
        Set.range j₀.base ∪ Set.range j₁.base = Set.univ →
        ∀ ξ : (weilEtaleGmSheaf Z).H 1,
          ∃ (T₀ T₁ : Type u) (_ : CommRing T₀) (_ : CommRing T₁)
            (_ : Algebra S₀ T₀) (_ : Algebra S₁ T₁)
            (_ : Algebra.Etale S₀ T₀) (_ : Algebra.Etale S₁ T₁),
            AlgebraicGeometry.Surjective
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₀ T₀))) ∧
            AlgebraicGeometry.Surjective
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₁ T₁))) ∧
            let g_cov : CategoryTheory.Limits.coprod
                (AlgebraicGeometry.Spec (CommRingCat.of T₀))
                (AlgebraicGeometry.Spec (CommRingCat.of T₁)) ⟶ Z :=
              CategoryTheory.Limits.coprod.desc
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₀ T₀)) ≫ j₀)
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₁ T₁)) ≫ j₁)
            ∃ (hEt : AlgebraicGeometry.Etale g_cov),
              let W : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ g_cov hEt
              let w : W ⟶ weilEtaleIdTerminal.{u} Z := (weilEtaleIdTerminalIsTerminal.{u} Z).from W
              ∃ (hw : AlgebraicGeometry.Surjective w.left)
                (c : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker),
                cechCl Z W w hw c = ξ) :=
by
  classical
  have hom_sum_apply : ∀ {A B : AddCommGrpCat.{u}} {ι : Type} (s : Finset ι)
      (f : ι → (A ⟶ B)) (x : A),
      (∑ i ∈ s, f i) x = ∑ i ∈ s, (f i) x := by
    intro A B ι s f x
    induction s using Finset.induction_on with
    | empty => rfl
    | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      exact congrArg ((f a) x + ·) ih

  have hom_zsmul_apply : ∀ {A B : AddCommGrpCat.{u}} (n : ℤ) (f : A ⟶ B) (x : A),
      (n • f) x = n • (f x) := fun _ _ _ => rfl

  have addHom_sum_apply : ∀ {A B : Type u} [AddCommGroup A] [AddCommGroup B]
      {ι : Type} (s : Finset ι) (f : ι → (A →+ B)) (x : A),
      (∑ i ∈ s, f i) x = ∑ i ∈ s, (f i) x := by
    intro A B _ _ ι s f x
    induction s using Finset.induction_on with
    | empty => rfl
    | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, AddMonoidHom.add_apply, ih]

  have addHom_zsmul_apply : ∀ {A B : Type u} [AddCommGroup A] [AddCommGroup B]
      (n : ℤ) (f : A →+ B) (x : A),
      (n • f) x = n • (f x) := fun _ _ _ => rfl

  let gmMapHom : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (f : Y₁ ⟶ Y₂),
      Additive (Units ↑(Y₂.presheaf.obj (Opposite.op ⊤))) →+
        Additive (Units ↑(Y₁.presheaf.obj (Opposite.op ⊤))) :=
    fun f => MonoidHom.toAdditive (Units.map f.appTop.hom.toMonoidHom)

  have gmMapHom_comp : ∀ {Y₁ Y₂ Y₃ : AlgebraicGeometry.Scheme.{u}}
      (f : Y₁ ⟶ Y₂) (g : Y₂ ⟶ Y₃)
      (x : Additive (Units ↑(Y₃.presheaf.obj (Opposite.op ⊤)))),
      gmMapHom (f ≫ g) x = gmMapHom f (gmMapHom g x) := by
    intro Y₁ Y₂ Y₃ f g x
    let u_x : Units ↑(Y₃.presheaf.obj (Opposite.op ⊤)) := @Additive.toMul _ x
    apply (@Additive.toMul (Units ↑(Y₁.presheaf.obj (Opposite.op ⊤)))).injective
    apply Units.ext
    have happ : (f ≫ g).appTop = g.appTop ≫ f.appTop :=
      AlgebraicGeometry.Scheme.Hom.comp_appTop f g
    exact congrArg (fun φ => φ.hom u_x.val) happ

  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale.{u}) :=
    ⟨fun f g hf hg => by
      have : AlgebraicGeometry.Etale f := hf
      have : AlgebraicGeometry.Etale g := hg
      infer_instance⟩
  have : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.Etale.{u}) :=
    AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource

  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
    fun Z => (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let L_sh : ∀ Z : AlgebraicGeometry.Scheme.{u},
      ((Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤
        CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
    fun Z => CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}
  let shAdj : ∀ Z : AlgebraicGeometry.Scheme.{u},
      L_sh Z ⊣ CategoryTheory.sheafToPresheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
    fun Z => CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}

  let Z_psh : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale),
      (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
    fun _ V => (CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free
  let Z_psh_map : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : Z.Etale} (u : V₁ ⟶ V₂),
      Z_psh Z V₁ ⟶ Z_psh Z V₂ :=
    fun u => CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u) AddCommGrpCat.free
  let of_psh : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {T V : Z.Etale} (g : T ⟶ V),
      (Z_psh Z V).obj (Opposite.op T) :=
    fun g => FreeAbelianGroup.of g

  have z_psh_hom_ext : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V : Z.Etale}
      {T : (Z.Etale)ᵒᵖ} {M : AddCommGrpCat.{u}}
      (f₁ f₂ : (Z_psh Z V).obj T ⟶ M),
      (∀ g : Opposite.unop T ⟶ V, f₁ (of_psh g) = f₂ (of_psh g)) → f₁ = f₂ := by
    intro Z V T M f₁ f₂ h
    exact AddCommGrpCat.ext fun x =>
      DFunLike.congr_fun (FreeAbelianGroup.lift_ext f₁.hom f₂.hom h) x

  let Z_sh : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale),
      CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
    fun Z V => (L_sh Z).obj (Z_psh Z V)
  let Z_sh_map : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : Z.Etale} (u : V₁ ⟶ V₂),
      Z_sh Z V₁ ⟶ Z_sh Z V₂ :=
    fun {Z} {_} {_} u => (L_sh Z).map (Z_psh_map u)

  have Z_sh_map_id : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale),
      Z_sh_map (𝟙 V) = 𝟙 (Z_sh Z V) := by
    intro Z V
    have hp : Z_psh_map (𝟙 V) = 𝟙 (Z_psh Z V) := by
      ext T : 2
      refine z_psh_hom_ext _ _ (fun g => ?_)
      change FreeAbelianGroup.map (fun h : Opposite.unop T ⟶ V => h ≫ 𝟙 V) (of_psh g) = of_psh g
      rw [FreeAbelianGroup.map_of_apply, CategoryTheory.Category.comp_id]
    dsimp only [Z_sh_map]
    rw [hp, CategoryTheory.Functor.map_id]

  have Z_sh_map_comp : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ V₃ : Z.Etale}
      (u : V₁ ⟶ V₂) (v : V₂ ⟶ V₃),
      Z_sh_map (u ≫ v) = Z_sh_map u ≫ Z_sh_map v := by
    intro Z V₁ V₂ V₃ u v
    have hp : Z_psh_map (u ≫ v) = Z_psh_map u ≫ Z_psh_map v := by
      ext T : 2
      refine z_psh_hom_ext _ _ (fun g => ?_)
      change FreeAbelianGroup.map (fun h : Opposite.unop T ⟶ V₁ => h ≫ (u ≫ v)) (of_psh g) =
        FreeAbelianGroup.map (fun h : Opposite.unop T ⟶ V₂ => h ≫ v)
          (FreeAbelianGroup.map (fun h : Opposite.unop T ⟶ V₁ => h ≫ u) (of_psh g))
      rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.map_of_apply,
        FreeAbelianGroup.map_of_apply, CategoryTheory.Category.assoc]
    dsimp only [Z_sh_map]
    rw [hp, CategoryTheory.Functor.map_comp]

  let pshHom : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (s : F.obj.obj (Opposite.op V)),
      Z_psh Z V ⟶ F.obj :=
    fun Z V F s =>
      { app := fun T =>
          AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun g : Opposite.unop T ⟶ V => F.obj.map g.op s))
        naturality := fun {T₁ T₂} f => by
          refine z_psh_hom_ext _ _ (fun g => ?_)
          change FreeAbelianGroup.lift (fun h : Opposite.unop T₂ ⟶ V => F.obj.map h.op s)
              (FreeAbelianGroup.map (fun h : Opposite.unop T₁ ⟶ V => f.unop ≫ h) (of_psh g)) =
            F.obj.map f (FreeAbelianGroup.lift (fun h : Opposite.unop T₁ ⟶ V => F.obj.map h.op s) (of_psh g))
          rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
            FreeAbelianGroup.lift_apply_of, CategoryTheory.op_comp, F.obj.map_comp]
          rfl }

  let shHom : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (s : F.obj.obj (Opposite.op V)),
      Z_sh Z V ⟶ F :=
    fun Z V F s => ((shAdj Z).homEquiv (Z_psh Z V) F).symm (pshHom Z V F s)

  let secOf : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (φ : Z_sh Z V ⟶ F),
      F.obj.obj (Opposite.op V) :=
    fun Z V F φ => (((shAdj Z).homEquiv (Z_psh Z V) F φ).app (Opposite.op V)) (of_psh (𝟙 V))

  have secOf_shHom : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (s : F.obj.obj (Opposite.op V)),
      secOf Z V F (shHom Z V F s) = s := by
    intro Z V F s
    dsimp only [secOf, shHom]
    rw [Equiv.apply_symm_apply]
    change FreeAbelianGroup.lift (fun g : V ⟶ V => F.obj.map g.op s) (of_psh (𝟙 V)) = s
    rw [FreeAbelianGroup.lift_apply_of, CategoryTheory.op_id, F.obj.map_id]
    rfl

  have pshHom_eval : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (α : Z_psh Z V ⟶ F.obj),
      pshHom Z V F ((α.app (Opposite.op V)) (of_psh (𝟙 V))) = α := by
    intro Z V F α
    ext T : 2
    refine z_psh_hom_ext _ _ (fun g => ?_)
    change FreeAbelianGroup.lift (fun h : Opposite.unop T ⟶ V =>
        F.obj.map h.op ((α.app (Opposite.op V)) (of_psh (𝟙 V)))) (of_psh g) =
      (α.app T) (of_psh g)
    rw [FreeAbelianGroup.lift_apply_of]
    have hnat := congrArg (fun m : (Z_psh Z V).obj (Opposite.op V) ⟶ F.obj.obj T =>
      m (of_psh (𝟙 V))) (α.naturality g.op)
    change (α.app T) (FreeAbelianGroup.map (fun h : V ⟶ V => g ≫ h) (of_psh (𝟙 V))) =
      F.obj.map g.op ((α.app (Opposite.op V)) (of_psh (𝟙 V))) at hnat
    rw [FreeAbelianGroup.map_of_apply, CategoryTheory.Category.comp_id] at hnat
    exact hnat.symm

  have shHom_secOf : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (φ : Z_sh Z V ⟶ F),
      shHom Z V F (secOf Z V F φ) = φ := by
    intro Z V F φ
    dsimp only [shHom, secOf]
    rw [pshHom_eval]
    exact ((shAdj Z).homEquiv (Z_psh Z V) F).symm_apply_apply φ

  have shHom_inj : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      {s₁ s₂ : F.obj.obj (Opposite.op V)},
      shHom Z V F s₁ = shHom Z V F s₂ → s₁ = s₂ := by
    intro Z V F s₁ s₂ h
    rw [← secOf_shHom Z V F s₁, ← secOf_shHom Z V F s₂, h]

  have secOf_inj : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      {φ₁ φ₂ : Z_sh Z V ⟶ F},
      secOf Z V F φ₁ = secOf Z V F φ₂ → φ₁ = φ₂ := by
    intro Z V F φ₁ φ₂ h
    rw [← shHom_secOf Z V F φ₁, ← shHom_secOf Z V F φ₂, h]

  have shHom_comp : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (s : F.obj.obj (Opposite.op V)) (ψ : F ⟶ G),
      shHom Z V F s ≫ ψ = shHom Z V G (ψ.hom.app (Opposite.op V) s) := by
    intro Z V F G s ψ
    dsimp only [shHom]
    rw [← CategoryTheory.Adjunction.homEquiv_naturality_right_symm (shAdj Z) (pshHom Z V F s) ψ]
    congr 1
    ext T : 2
    refine z_psh_hom_ext _ _ (fun g => ?_)
    change ψ.hom.app T (FreeAbelianGroup.lift (fun h : Opposite.unop T ⟶ V => F.obj.map h.op s) (of_psh g)) =
      FreeAbelianGroup.lift (fun h : Opposite.unop T ⟶ V => G.obj.map h.op (ψ.hom.app (Opposite.op V) s)) (of_psh g)
    rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
    exact congrArg (fun m : F.obj.obj (Opposite.op V) ⟶ G.obj.obj T => m s) (ψ.hom.naturality g.op)

  have secOf_comp : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (φ : Z_sh Z V ⟶ F) (ψ : F ⟶ G),
      secOf Z V G (φ ≫ ψ) = ψ.hom.app (Opposite.op V) (secOf Z V F φ) := by
    intro Z V F G φ ψ
    conv_lhs => rw [← shHom_secOf Z V F φ, shHom_comp, secOf_shHom]

  have map_comp_shHom : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : Z.Etale}
      (u : V₁ ⟶ V₂) (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (s : F.obj.obj (Opposite.op V₂)),
      Z_sh_map u ≫ shHom Z V₂ F s = shHom Z V₁ F (F.obj.map u.op s) := by
    intro Z V₁ V₂ u F s
    dsimp only [shHom, Z_sh_map]
    rw [← CategoryTheory.Adjunction.homEquiv_naturality_left_symm (shAdj Z) (Z_psh_map u) (pshHom Z V₂ F s)]
    congr 1
    ext T : 2
    refine z_psh_hom_ext _ _ (fun g => ?_)
    change FreeAbelianGroup.lift (fun h : Opposite.unop T ⟶ V₂ => F.obj.map h.op s)
        (FreeAbelianGroup.map (fun h : Opposite.unop T ⟶ V₁ => h ≫ u) (of_psh g)) =
      FreeAbelianGroup.lift (fun h : Opposite.unop T ⟶ V₁ => F.obj.map h.op (F.obj.map u.op s)) (of_psh g)
    rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
      FreeAbelianGroup.lift_apply_of, CategoryTheory.op_comp, F.obj.map_comp]
    rfl

  have secOf_map_comp : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : Z.Etale}
      (u : V₁ ⟶ V₂) (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (φ : Z_sh Z V₂ ⟶ F),
      secOf Z V₁ F (Z_sh_map u ≫ φ) = F.obj.map u.op (secOf Z V₂ F φ) := by
    intro Z V₁ V₂ u F φ
    conv_lhs => rw [← shHom_secOf Z V₂ F φ, map_comp_shHom, secOf_shHom]

  have secOf_zero : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      secOf Z V F 0 = 0 := by
    intro Z V F
    dsimp only [secOf]
    rw [CategoryTheory.Adjunction.homEquiv_unit]
    change (((shAdj Z).unit.app (Z_psh Z V) ≫
        (CategoryTheory.sheafToPresheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map (0 : Z_sh Z V ⟶ F)).app
      (Opposite.op V)) (of_psh (𝟙 V)) = 0
    rw [CategoryTheory.Functor.map_zero, CategoryTheory.Limits.comp_zero]
    rfl

  have secOf_add : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (φ₁ φ₂ : Z_sh Z V ⟶ F),
      secOf Z V F (φ₁ + φ₂) = secOf Z V F φ₁ + secOf Z V F φ₂ := by
    intro Z V F φ₁ φ₂
    dsimp only [secOf]
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
      CategoryTheory.Adjunction.homEquiv_unit]
    change (((shAdj Z).unit.app (Z_psh Z V) ≫ (φ₁ + φ₂).hom).app (Opposite.op V)) (of_psh (𝟙 V)) =
      (((shAdj Z).unit.app (Z_psh Z V) ≫ φ₁.hom).app (Opposite.op V)) (of_psh (𝟙 V)) +
      (((shAdj Z).unit.app (Z_psh Z V) ≫ φ₂.hom).app (Opposite.op V)) (of_psh (𝟙 V))
    have h_hom_add : (φ₁ + φ₂).hom = φ₁.hom + φ₂.hom := rfl
    rw [h_hom_add, CategoryTheory.Preadditive.comp_add, CategoryTheory.NatTrans.app_add]
    rfl

  have shHom_zero : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      shHom Z V F 0 = 0 := by
    intro Z V F
    apply secOf_inj
    rw [secOf_shHom, secOf_zero]

  have shHom_add : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (s₁ s₂ : F.obj.obj (Opposite.op V)),
      shHom Z V F (s₁ + s₂) = shHom Z V F s₁ + shHom Z V F s₂ := by
    intro Z V F s₁ s₂
    apply secOf_inj
    rw [secOf_shHom, secOf_add, secOf_shHom, secOf_shHom]

  have shHom_zsmul : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (n : ℤ) (s : F.obj.obj (Opposite.op V)),
      shHom Z V F (n • s) = n • shHom Z V F s := by
    intro Z V F n s
    let homL : F.obj.obj (Opposite.op V) →+ (Z_sh Z V ⟶ F) :=
      { toFun := shHom Z V F
        map_zero' := shHom_zero Z V F
        map_add' := shHom_add Z V F }
    exact map_zsmul homL n s

  have shHom_sum : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      {ι : Type} (s : Finset ι) (f : ι → F.obj.obj (Opposite.op V)),
      shHom Z V F (∑ i ∈ s, f i) = ∑ i ∈ s, shHom Z V F (f i) := by
    intro Z V F ι s f
    let homL : F.obj.obj (Opposite.op V) →+ (Z_sh Z V ⟶ F) :=
      { toFun := shHom Z V F
        map_zero' := shHom_zero Z V F
        map_add' := shHom_add Z V F }
    exact map_sum homL f s

  
