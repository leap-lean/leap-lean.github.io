                (congrArg (fun k => e_BZ ≫ k ≫ U_aff.ι) hSpec_sq).trans
                  ((congrArg (e_BZ ≫ ·) (CategoryTheory.Category.assoc _ _ _)).trans
                    (CategoryTheory.Category.assoc hW_aff.fromSpec w_et.left _))
              exact hc₁.trans (hc₂.trans hc₃)
            have hbase := congrArg (fun k => k.base p_B) hcomp_eq
            have hpB_from : hW_aff.fromSpec.base p_B = p_W := by
              dsimp [p_B]
              rw [← hW_aff.isoSpec_inv_ι]
              change ((hW_aff.isoSpec.hom ≫ hW_aff.isoSpec.inv) ≫ W_aff.ι).base ⟨p_W, hp_W_aff⟩ = p_W
