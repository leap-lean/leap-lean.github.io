        ∃ e : Polynomial k ≃+* HomogeneousLocalization.Away 𝒜 (T i),
          (∀ c : k, e (Polynomial.C c) =
            HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (T i))
              (algebraMap k ↥(𝒜 0) c)) ∧
          e Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem (hT i) (hT j) := by
      intro i j hij
      let σ₀ : k →+* HomogeneousLocalization.Away 𝒜 (T i) :=
