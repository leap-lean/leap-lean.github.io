theorem weil_finite_morphism_mod_prime_pushforward_shortExact (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (_hFinPBC : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (g : X ⟶ S)
      [AlgebraicGeometry.IsFinite g], WeilCanonicalModPrimePBC ℓ g)
    {Z' Z : AlgebraicGeometry.Scheme.{u}} (f : Z' ⟶ Z) [AlgebraicGeometry.IsFinite f] :
    letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
