            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
              α.hom.appTop ≫ D.topIso.hom)) Polynomial.X) at hX
      rw [Polynomial.map_X, hs_X] at hX
