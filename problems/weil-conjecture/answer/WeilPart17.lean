        rw [Adjunction.comp_homEquiv]
        rfl
      rw [he_eq (α₁ + α₂), he_eq α₁, he_eq α₂, hu, hψ, hyon, hyon, hyon, NatTrans.app_add]
      rfl
    let e_add : ∀ W : Opposite Y_U.Etale,
        ↥((F_U.cohomologyPresheaf 0).obj W) ≃+ ↥((U_U.obj F_U).obj W) :=
      fun W => AddEquiv.mk' (e_raw W) (he_add W)
    let θ_F : F_U.cohomologyPresheaf 0 ≅ U_U.obj F_U :=
      NatIso.ofComponents
        (fun W =>
