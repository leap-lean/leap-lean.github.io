theorem weil_monic_twoChart_pic_surjective (k : Type u) [Field k] [IsAlgClosed k]
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (D : WeilTwoChartRingDatum A)
    (D₀ : WeilTwoChartRingDatum k)
    (red : WeilTwoChartCurveReduction D D₀)
    (hA : WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A)
    (hValid : WeilIsValidTwoChartCurveReduction τ_A D D₀ red)
    (E₀ : WeilTwoChartLineBundle D₀) :
    ∃ E₁ : WeilTwoChartLineBundle D,
      WeilTwoChartIso D₀ (WeilTwoChartBaseChange red E₁) E₀ :=
by
  have polyBasis_X_reg : ∀ {B R : Type u} [CommRing B] [CommRing R]
      [Algebra (Polynomial B) R] {r : ℕ} (b : Fin r → R),
      Function.Bijective (fun f : Fin r → Polynomial B =>
        Finset.univ.sum fun j => algebraMap (Polynomial B) R (f j) * b j) →
      ∀ (y : R), algebraMap (Polynomial B) R Polynomial.X * y = 0 → y = 0 := by
    intro B R _ _ _ r b hb y hy
    let Ξ := weilPicSurj_polyBasisEquiv b hb
    apply Ξ.symm.injective
    funext j
    apply Polynomial.ext
    intro m
    have h1 : algebraMap (Polynomial B) R Polynomial.X * y = (Polynomial.X : Polynomial B) • y :=
      (Algebra.smul_def (Polynomial.X : Polynomial B) y).symm
    have h2 : Ξ.symm ((Polynomial.X : Polynomial B) • y) = (Polynomial.X : Polynomial B) • Ξ.symm y :=
      map_smul Ξ.symm _ _
    have h3 : (Polynomial.X * Ξ.symm y j).coeff (m + 1) = 0 := by
      change (((Polynomial.X : Polynomial B) • Ξ.symm y) j).coeff (m + 1) = 0
      rw [← h2, ← h1, hy, map_zero, Pi.zero_apply, Polynomial.coeff_zero]
    simpa [Polynomial.coeff_X_mul] using h3
  have polyBasis_one_add_X_mul_reg : ∀ {B R : Type u} [CommRing B] [CommRing R]
      [Algebra (Polynomial B) R] {r : ℕ} (b : Fin r → R),
      Function.Bijective (fun f : Fin r → Polynomial B =>
        Finset.univ.sum fun j => algebraMap (Polynomial B) R (f j) * b j) →
      ∀ (z y : R), (1 + algebraMap (Polynomial B) R Polynomial.X * z) * y = 0 → y = 0 := by
    intro B R _ _ _ r b hb z y hy
    let Ξ := weilPicSurj_polyBasisEquiv b hb
    let t := algebraMap (Polynomial B) R Polynomial.X
    have hpow_coeff : ∀ (m : ℕ) (g : Polynomial B), (Polynomial.X ^ (m + 1) * g).coeff m = 0 := by
      intro m
      induction m with
      | zero => intro g; simp [Polynomial.coeff_X_mul_zero]
      | succ m ih =>
        intro g
        rw [pow_succ', mul_assoc, Polynomial.coeff_X_mul]
        exact ih g
    have hy_step : y = t * (-z * y) := by
      calc
        y = (1 + t * z) * y - t * z * y := by ring
        _ = 0 - t * z * y := by rw [hy]
        _ = t * (-z * y) := by ring
    have hy_pow : ∀ n : ℕ, y = t ^ n * ((-z) ^ n * y) := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        calc
          y = t ^ n * ((-z) ^ n * y) := ih
          _ = t ^ n * ((-z) ^ n * (t * (-z * y))) := by rw [← hy_step]
          _ = t ^ (n + 1) * ((-z) ^ (n + 1) * y) := by ring
    apply Ξ.symm.injective
    funext j
    apply Polynomial.ext
    intro m
    have hm : y = ((Polynomial.X : Polynomial B) ^ (m + 1)) • ((-z) ^ (m + 1) * y) := by
      rw [Algebra.smul_def, map_pow]
      exact hy_pow (m + 1)
    have hmap : Ξ.symm y j = Polynomial.X ^ (m + 1) * Ξ.symm ((-z) ^ (m + 1) * y) j := by
      conv_lhs => rw [hm]
      rw [map_smul]
      rfl
    rw [hmap, hpow_coeff]
    simp
  have quotient_finite_of_monic_mem : ∀ {B R : Type u} [CommRing B] [CommRing R]
      [Algebra (Polynomial B) R] {r : ℕ} (b : Fin r → R),
      Function.Bijective (fun f : Fin r → Polynomial B =>
        Finset.univ.sum fun j => algebraMap (Polynomial B) R (f j) * b j) →
      ∀ (K : Ideal R) (Q : Polynomial B), Q.Monic →
      algebraMap (Polynomial B) R Q ∈ K →
      letI : Algebra B (R ⧸ K) :=
        ((Ideal.Quotient.mk K).comp ((algebraMap (Polynomial B) R).comp Polynomial.C)).toAlgebra
      Module.Finite B (R ⧸ K) := by
    intro B R _ _ _ r b hb K Q hQ_monic hQ_mem
    letI : Algebra B (R ⧸ K) :=
      ((Ideal.Quotient.mk K).comp ((algebraMap (Polynomial B) R).comp Polynomial.C)).toAlgebra
    classical
    let d := Q.natDegree
    let gen : Fin d × Fin r → R ⧸ K := fun p =>
      Ideal.Quotient.mk K (algebraMap (Polynomial B) R (Polynomial.X ^ (p.1 : ℕ)) * b p.2)
    rw [Module.finite_def]
    refine ⟨Finset.univ.image gen, ?_⟩
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, eq_top_iff]
    intro y _
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨f, rfl⟩ := hb.2 x
    rw [map_sum]
    refine Submodule.sum_mem _ fun j _ => ?_
    by_cases hQ1 : Q = 1
    · subst hQ1
      have h1 : (1 : R) ∈ K := by simpa using hQ_mem
      have hmem : algebraMap (Polynomial B) R (f j) * b j ∈ K := by
        simpa using K.mul_mem_left (algebraMap (Polynomial B) R (f j) * b j) h1
      rw [(Ideal.Quotient.eq_zero_iff_mem).mpr hmem]
      exact Submodule.zero_mem _
    · have hdiv : f j = f j %ₘ Q + Q * (f j /ₘ Q) := by
        calc
          f j = (f j - Q * (f j /ₘ Q)) + Q * (f j /ₘ Q) := by ring
          _ = f j %ₘ Q + Q * (f j /ₘ Q) := by rw [← Polynomial.modByMonic_eq_sub_mul_div]
      have hlt : (f j %ₘ Q).natDegree < d := Polynomial.natDegree_modByMonic_lt (f j) hQ_monic hQ1
      have hsum := Polynomial.as_sum_range' (f j %ₘ Q) d hlt
      have hq_zero : Ideal.Quotient.mk K (algebraMap (Polynomial B) R (Q * (f j /ₘ Q)) * b j) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem, map_mul, mul_assoc]
        exact K.mul_mem_right _ hQ_mem
      rw [hdiv, map_add, add_mul, map_add, hq_zero, add_zero, hsum, ← Fin.sum_univ_eq_sum_range]
      simp only [← Polynomial.C_mul_X_pow_eq_monomial, map_sum, Finset.sum_mul]
      refine Submodule.sum_mem _ fun i _ => ?_
      have hsmul : Ideal.Quotient.mk K
          (algebraMap (Polynomial B) R
            (Polynomial.C ((f j %ₘ Q).coeff i) * Polynomial.X ^ (i : ℕ)) * b j) =
          ((f j %ₘ Q).coeff i) • gen (i, j) := by
        dsimp [gen]
        rw [map_mul (algebraMap (Polynomial B) R), mul_assoc, map_mul, Algebra.smul_def]
        rfl
      rw [hsmul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(i, j), rfl⟩)
  have det_mulLeft_mem_and_ne_zero : ∀ {k₀ R : Type u} [Field k₀] [CommRing R]
      [Algebra (Polynomial k₀) R] {r : ℕ} (b : Fin r → R),
      Function.Bijective (fun f : Fin r → Polynomial k₀ =>
        Finset.univ.sum fun j => algebraMap (Polynomial k₀) R (f j) * b j) →
      ∀ (g : R), (∀ x : R, g * x = 0 → x = 0) →
      ∃ Q : Polynomial k₀, Q.Monic ∧ algebraMap (Polynomial k₀) R Q ∈ Ideal.span {g} := by
    intro k₀ R _ _ _ r b hb g hg_reg
    classical
    let Ξ := weilPicSurj_polyBasisEquiv b hb
    let b_bas : Module.Basis (Fin r) (Polynomial k₀) R := Module.Basis.ofEquivFun Ξ.symm
    have hb_eq : ∀ j : Fin r, b_bas j = b j := by
      intro j
      simp [b_bas, Module.Basis.ofEquivFun, Ξ, weilPicSurj_polyBasisEquiv, Pi.single_apply]
    let μ_g : R →ₗ[Polynomial k₀] R :=
      { toFun := fun x => g * x
        map_add' := fun x y => mul_add g x y
        map_smul' := fun p x => by
          simp only [RingHom.id_apply, Algebra.smul_def]
          ring }
    let M_g : Matrix (Fin r) (Fin r) (Polynomial k₀) := LinearMap.toMatrix b_bas b_bas μ_g
    have hcol : ∀ i : Fin r,
        (∑ m : Fin r, algebraMap (Polynomial k₀) R (M_g m i) * b m) = g * b i := by
      intro i
      have hrepr : Ξ (b_bas.repr (μ_g (b_bas i))) = μ_g (b_bas i) := Ξ.apply_symm_apply _
      simpa [M_g, LinearMap.toMatrix_apply, hb_eq, μ_g, Ξ, weilPicSurj_polyBasisEquiv] using hrepr
    have hdet_b : ∀ j : Fin r,
        algebraMap (Polynomial k₀) R M_g.det * b j ∈ Ideal.span {g} := by
      intro j
      have h1 : (∑ i : Fin r, (∑ m : Fin r, algebraMap (Polynomial k₀) R (M_g m i) * b m) *
          algebraMap (Polynomial k₀) R (M_g.adjugate i j)) ∈ Ideal.span {g} := by
        simp_rw [hcol]
        refine Ideal.sum_mem _ fun i _ => ?_
        rw [mul_assoc]
        exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
      have h2 : (∑ i : Fin r, (∑ m : Fin r, algebraMap (Polynomial k₀) R (M_g m i) * b m) *
          algebraMap (Polynomial k₀) R (M_g.adjugate i j)) =
          algebraMap (Polynomial k₀) R M_g.det * b j := by
        simp_rw [Finset.sum_mul]
        rw [Finset.sum_comm]
        have h3 : ∀ m : Fin r,
            (∑ i : Fin r, algebraMap (Polynomial k₀) R (M_g m i) * b m *
              algebraMap (Polynomial k₀) R (M_g.adjugate i j)) =
            algebraMap (Polynomial k₀) R ((M_g * M_g.adjugate) m j) * b m := by
          intro m
          rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_mul]
          ring
        simp_rw [h3, Matrix.mul_adjugate, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
        rw [Finset.sum_eq_single j (fun m _ hm => by simp [hm])
          (fun h => absurd (Finset.mem_univ j) h)]
        simp
      rwa [← h2]
    have hdet_mem : algebraMap (Polynomial k₀) R M_g.det ∈ Ideal.span {g} := by
      let f1 : Fin r → Polynomial k₀ := Ξ.symm 1
      have h1 : (1 : R) = ∑ j : Fin r, algebraMap (Polynomial k₀) R (f1 j) * b j :=
        (Ξ.apply_symm_apply 1).symm
      have heq : algebraMap (Polynomial k₀) R M_g.det =
          ∑ j : Fin r, algebraMap (Polynomial k₀) R (f1 j) *
            (algebraMap (Polynomial k₀) R M_g.det * b j) := by
        calc
          algebraMap (Polynomial k₀) R M_g.det = algebraMap (Polynomial k₀) R M_g.det * 1 :=
            (mul_one _).symm
          _ = algebraMap (Polynomial k₀) R M_g.det *
                ∑ j : Fin r, algebraMap (Polynomial k₀) R (f1 j) * b j := by rw [h1]
          _ = ∑ j : Fin r, algebraMap (Polynomial k₀) R (f1 j) *
                (algebraMap (Polynomial k₀) R M_g.det * b j) := by
            rw [Finset.mul_sum]
            exact Finset.sum_congr rfl fun j _ => by ring
      rw [heq]
      exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hdet_b j)
    have hdet_ne : M_g.det ≠ 0 := by
      intro h0
      let K := FractionRing (Polynomial k₀)
      let M_K : Matrix (Fin r) (Fin r) K := M_g.map (algebraMap (Polynomial k₀) K)
      have hMK_det : M_K.det = 0 := by
        have hmap : M_K.det = algebraMap (Polynomial k₀) K M_g.det :=
          (RingHom.map_det (algebraMap (Polynomial k₀) K) M_g).symm
        rw [hmap, h0, map_zero]
      have hnot_inj : ¬ Function.Injective M_K.mulVecLin := by
        intro hinj
        have hinj' : Function.Injective M_K.mulVec :=
          fun v₁ v₂ h => hinj (by simpa only [Matrix.mulVecLin_apply] using h)
        have hunit : IsUnit M_K := Matrix.mulVec_injective_iff_isUnit.mp hinj'
        have hdet_u : IsUnit M_K.det := (Matrix.isUnit_iff_isUnit_det M_K).mp hunit
        rw [hMK_det] at hdet_u
        exact not_isUnit_zero hdet_u
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff] at hnot_inj
      push_neg at hnot_inj
      obtain ⟨v, hv_ker, hv_ne⟩ := hnot_inj
      rw [LinearMap.mem_ker] at hv_ker
      obtain ⟨d_nz, hd_int⟩ := IsLocalization.exist_integer_multiples
        (nonZeroDivisors (Polynomial k₀)) Finset.univ v
      choose w hw using fun j : Fin r => hd_int j (Finset.mem_univ j)
      have hw_ne : w ≠ 0 := by
        intro hw0
        apply hv_ne
        funext j
        rw [Pi.zero_apply]
        have hj := hw j
        rw [hw0, Pi.zero_apply, map_zero, Algebra.smul_def] at hj
        have hd_ne : (d_nz : Polynomial k₀) ≠ 0 := nonZeroDivisors.ne_zero d_nz.2
        have hdK_ne : algebraMap (Polynomial k₀) K (d_nz : Polynomial k₀) ≠ 0 := fun h =>
          hd_ne (IsFractionRing.injective (Polynomial k₀) K (h.trans (map_zero _).symm))
        exact (mul_eq_zero.mp hj.symm).resolve_left hdK_ne
      have hMw : M_g.mulVec w = 0 := by
        funext i
        apply IsFractionRing.injective (Polynomial k₀) K
        rw [Pi.zero_apply, map_zero, Matrix.mulVec, dotProduct, map_sum]
        have hvi : (M_K.mulVec v) i = 0 := congrFun hv_ker i
        rw [Matrix.mulVec, dotProduct] at hvi
        calc
          ∑ j : Fin r, algebraMap (Polynomial k₀) K (M_g i j * w j) =
              algebraMap (Polynomial k₀) K (d_nz : Polynomial k₀) *
                ∑ j : Fin r, M_K i j * v j := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_mul, hw j, Algebra.smul_def]
            dsimp [M_K]
            ring
          _ = 0 := by rw [hvi, mul_zero]
      have hΞ_mul : Ξ (M_g.mulVec w) = g * Ξ w := by
        dsimp [Ξ, weilPicSurj_polyBasisEquiv, Matrix.mulVec, dotProduct]
        simp_rw [map_sum, Finset.sum_mul]
        rw [Finset.sum_comm]
        have hterm : ∀ j : Fin r,
            (∑ i : Fin r, algebraMap (Polynomial k₀) R (M_g i j * w j) * b i) =
            algebraMap (Polynomial k₀) R (w j) * (g * b j) := by
          intro j
          rw [← hcol j, Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => by rw [map_mul]; ring
        simp_rw [hterm]
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => by ring
      rw [hMw, map_zero] at hΞ_mul
      exact hw_ne (Ξ.injective ((hg_reg (Ξ w) hΞ_mul.symm).trans (map_zero Ξ).symm))
    refine ⟨Polynomial.C M_g.det.leadingCoeff⁻¹ * M_g.det, ?_, ?_⟩
    · rw [mul_comm]
      exact Polynomial.monic_mul_leadingCoeff_inv hdet_ne
    · rw [map_mul]
      exact Ideal.mul_mem_left _ _ hdet_mem
  have invertible_hom_injective_of_reg : ∀ {R L : Type u} [CommRing R]
      [AddCommGroup L] [Module R L] [Module.Invertible R L]
      (ψ : L →ₗ[R] R) (s : L), (∀ r : R, ψ s * r = 0 → r = 0) →
      Function.Injective ψ := by
    intro R L _ _ _ _ ψ s hreg
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro x hx
    rw [LinearMap.mem_ker] at hx
    have hcl : contractLeft R L (ψ ⊗ₜ[R] x) = 0 := by
      rw [contractLeft_apply, hx]
    have htmul : (ψ ⊗ₜ[R] x : TensorProduct R (Module.Dual R L) L) = 0 :=
      Module.Invertible.bijective.1 (hcl.trans (map_zero _).symm)
    let ev_s : TensorProduct R (Module.Dual R L) L →ₗ[R] L :=
      TensorProduct.lift
        { toFun := fun f => (f s) • LinearMap.id
          map_add' := fun f g => by ext y; simp [add_smul]
          map_smul' := fun r f => by ext y; simp [mul_smul] }
    have hsmul : (ψ s) • x = 0 := by
      simpa [ev_s] using congrArg ev_s htmul
    obtain ⟨n, p, hp⟩ := Module.Finite.exists_fin' R L
    obtain ⟨q, hq⟩ := Module.projective_lifting_property p LinearMap.id hp
    have hqx : q x = 0 := by
      ext i
      apply hreg
      calc
        ψ s * q x i = (q ((ψ s) • x)) i := by simp
        _ = 0 := by rw [hsmul, map_zero, Pi.zero_apply]
    calc
      x = (p.comp q) x := by rw [hq]; rfl
      _ = p (q x) := rfl
      _ = 0 := by rw [hqx, map_zero]
  have away_clear_tmul : ∀ {R S M : Type u} [CommRing R] [CommRing S] [Algebra R S]
      (t : R) [IsLocalization.Away t S] [AddCommGroup M] [Module R M]
      (z : TensorProduct R S M),
      ∃ (m : ℕ) (x : M), (algebraMap R S t ^ m) • z = (1 : S) ⊗ₜ[R] x := by
    intro R S M _ _ _ t _ _ _ z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, 0, by simp⟩
    | tmul s x =>
      let k₀ := (IsLocalization.Away.sec t s).2
      let r := (IsLocalization.Away.sec t s).1
      refine ⟨k₀, r • x, ?_⟩
      have hsec := IsLocalization.Away.sec_spec t s
      rw [TensorProduct.smul_tmul', smul_eq_mul, ← map_pow, mul_comm, hsec,
        ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
    | add z₁ z₂ ih₁ ih₂ =>
      obtain ⟨m₁, x₁, h₁⟩ := ih₁
      obtain ⟨m₂, x₂, h₂⟩ := ih₂
      refine ⟨m₁ + m₂, (t ^ m₂) • x₁ + (t ^ m₁) • x₂, ?_⟩
      have hp1 : (algebraMap R S t ^ (m₁ + m₂)) • z₁ = (1 : S) ⊗ₜ[R] ((t ^ m₂) • x₁) := by
        rw [pow_add, mul_comm (algebraMap R S t ^ m₁), mul_smul, h₁,
          TensorProduct.smul_tmul', smul_eq_mul, mul_one, ← TensorProduct.smul_tmul,
          Algebra.smul_def, map_pow, mul_one]
      have hp2 : (algebraMap R S t ^ (m₁ + m₂)) • z₂ = (1 : S) ⊗ₜ[R] ((t ^ m₁) • x₂) := by
        rw [pow_add, mul_smul, h₂,
          TensorProduct.smul_tmul', smul_eq_mul, mul_one, ← TensorProduct.smul_tmul,
          Algebra.smul_def, map_pow, mul_one]
      rw [smul_add, hp1, hp2, TensorProduct.tmul_add]
  have away_clear_ideal_map : ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
      (t : R) [IsLocalization.Away t S] (K : Ideal R) {z : S},
      z ∈ Ideal.map (algebraMap R S) K →
      ∃ (m : ℕ) (x : R), x ∈ K ∧ algebraMap R S t ^ m * z = algebraMap R S x := by
    intro R S _ _ _ t _ K z hz
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
    · rintro _ ⟨x, hx, rfl⟩
      exact ⟨0, x, hx, by simp⟩
    · exact ⟨0, 0, K.zero_mem, by simp⟩
    · intro z₁ z₂ _ _ ⟨m₁, x₁, hx₁, h₁⟩ ⟨m₂, x₂, hx₂, h₂⟩
      refine ⟨m₁ + m₂, t ^ m₂ * x₁ + t ^ m₁ * x₂,
        K.add_mem (K.mul_mem_left _ hx₁) (K.mul_mem_left _ hx₂), ?_⟩
      calc
        algebraMap R S t ^ (m₁ + m₂) * (z₁ + z₂) =
            algebraMap R S t ^ m₂ * (algebraMap R S t ^ m₁ * z₁) +
            algebraMap R S t ^ m₁ * (algebraMap R S t ^ m₂ * z₂) := by ring
        _ = algebraMap R S (t ^ m₂ * x₁ + t ^ m₁ * x₂) := by
          rw [h₁, h₂, map_add, map_mul, map_mul, map_pow, map_pow]
    · intro s z₀ _ ⟨m, x, hx, h⟩
      let k₀ := (IsLocalization.Away.sec t s).2
      let r := (IsLocalization.Away.sec t s).1
      have hsec := IsLocalization.Away.sec_spec t s
      refine ⟨k₀ + m, r * x, K.mul_mem_left _ hx, ?_⟩
      calc
        algebraMap R S t ^ (k₀ + m) * (s • z₀) =
            (s * algebraMap R S (t ^ k₀)) * (algebraMap R S t ^ m * z₀) := by
          rw [smul_eq_mul, map_pow]; ring
        _ = algebraMap R S (r * x) := by rw [hsec, h, map_mul]
  have away_ideal_baseChange_equiv_tmul : ∀ {R S : Type u} [CommRing R] [CommRing S]
      [Algebra R S] (t : R) [IsLocalization.Away t S]
      (ht_reg : ∀ r : R, t * r = 0 → r = 0) (K : Ideal R) (s : S) (x : ↥K),
      (weilPicSurj_awayIdealBaseChangeEquiv t ht_reg K (s ⊗ₜ[R] x)).1 = s * algebraMap R S x.1 := by
    intro R S _ _ _ t _ ht_reg K s x
    change ((TensorProduct.AlgebraTensorModule.rid R S S).toLinearMap.comp
      (LinearMap.baseChange S K.subtype)) (s ⊗ₜ[R] x) = s * algebraMap R S x.1
    rw [LinearMap.comp_apply, LinearMap.baseChange_tmul, Submodule.coe_subtype, LinearEquiv.coe_coe,
      TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def, mul_comm]
  have ideal_invertible_of_dual_sum : ∀ {R : Type u} [CommRing R] (K : Ideal R)
      {n : ℕ} (γ : Fin n → Module.Dual R ↥K) (w : Fin n → ↥K),
      (∑ i : Fin n, γ i (w i)) = 1 → Module.Invertible R ↥K := by
    intro R _ K n γ w hsum
    have hcomm_vec : ∀ (ψ : Module.Dual R ↥K) (x z : ↥K), ψ x • z = ψ z • x := by
      intro ψ x z
      have hxz : x.1 • z = z.1 • x := Subtype.ext (mul_comm x.1 z.1)
      apply Subtype.ext
      change ψ x * z.1 = ψ z * x.1
      calc
        ψ x * z.1 = z.1 • ψ x := mul_comm _ _
        _ = ψ (z.1 • x) := (ψ.map_smul z.1 x).symm
        _ = ψ (x.1 • z) := by rw [hxz]
        _ = x.1 • ψ z := ψ.map_smul x.1 z
        _ = ψ z * x.1 := mul_comm _ _
    have hcomm_dual : ∀ (φ ψ : Module.Dual R ↥K) (y : ↥K), ψ y • φ = φ y • ψ := by
      intro φ ψ y
      ext x
      change ψ y * φ x = φ y * ψ x
      calc
        ψ y * φ x = φ x • ψ y := mul_comm _ _
        _ = ψ (φ x • y) := (ψ.map_smul (φ x) y).symm
        _ = ψ (φ y • x) := by rw [hcomm_vec φ x y]
        _ = φ y * ψ x := ψ.map_smul (φ y) x
    let W : TensorProduct R (Module.Dual R ↥K) ↥K := ∑ i : Fin n, γ i ⊗ₜ[R] w i
    let g_inv : R →ₗ[R] TensorProduct R (Module.Dual R ↥K) ↥K :=
      LinearMap.toSpanSingleton R _ W
    refine Module.Invertible.mk ⟨?_, ?_⟩
    · have hleft : ∀ z, g_inv (contractLeft R ↥K z) = z := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul φ x =>
          dsimp [g_inv, W]
          rw [LinearMap.toSpanSingleton_apply, Finset.smul_sum]
          calc
            ∑ i : Fin n, φ x • (γ i ⊗ₜ[R] w i) =
                ∑ i : Fin n, γ i ⊗ₜ[R] (φ x • w i) := by
              refine Finset.sum_congr rfl fun i _ => (TensorProduct.tmul_smul _ _ _).symm
            _ = ∑ i : Fin n, γ i ⊗ₜ[R] (φ (w i) • x) := by
              refine Finset.sum_congr rfl fun i _ => by rw [hcomm_vec φ (w i) x]
            _ = ∑ i : Fin n, (φ (w i) • γ i) ⊗ₜ[R] x := by
              refine Finset.sum_congr rfl fun i _ => (TensorProduct.smul_tmul (φ (w i)) (γ i) x).symm
            _ = ∑ i : Fin n, (γ i (w i) • φ) ⊗ₜ[R] x := by
              refine Finset.sum_congr rfl fun i _ => by rw [hcomm_dual (γ i) φ (w i)]
            _ = (∑ i : Fin n, γ i (w i)) • (φ ⊗ₜ[R] x) := by
              rw [← TensorProduct.sum_tmul, ← Finset.sum_smul, TensorProduct.smul_tmul']
            _ = φ ⊗ₜ[R] x := by rw [hsum, one_smul]
        | add z₁ z₂ ih₁ ih₂ => rw [map_add, map_add, ih₁, ih₂]
      exact Function.LeftInverse.injective hleft
    · intro r
      refine ⟨g_inv r, ?_⟩
      dsimp [g_inv, W]
      rw [LinearMap.toSpanSingleton_apply, map_smul, map_sum]
      simp_rw [contractLeft_apply]
      rw [hsum, smul_eq_mul, mul_one]
  have mvPolyDeriv_coeff : ∀ {A₀ σ : Type u} [CommRing A₀] (s : σ)
      (Q : Polynomial (MvPolynomial σ A₀)) (n : ℕ),
      (weilPicSurj_mvPolyDeriv s Q).coeff n = MvPolynomial.pderiv s (Q.coeff n) := by
    intro A₀ σ _ s Q n
    dsimp [weilPicSurj_mvPolyDeriv]
    rw [Polynomial.finset_sum_coeff]
    simp only [Polynomial.coeff_monomial]
    by_cases hn : n ∈ Q.support
    · rw [Finset.sum_eq_single n (fun b _ hb => if_neg hb) (fun h => absurd hn h), if_pos rfl]
    · rw [Finset.sum_eq_zero, Polynomial.notMem_support_iff.mp hn, map_zero]
      intro b hb
