        (fun j hj => Polynomial.coeff_eq_zero_of_natDegree_lt hj)
        hGH₀ hG₀_monic hG₀_deg
        (fun j hj => by dsimp [H₀]; rw [Polynomial.coeff_C_ne_zero (by omega)])
        hCop_GH₀
    let t_G : D.R₀ := algebraMap (Polynomial A) D.R₀ G_near
    have hπ₀_tG_mem : π₀ t_G ∈ Ideal.span {g₀} := by
      dsimp [t_G]
      rw [hpoly₀_red, hGn_red]
      dsimp [G₀]
      rw [map_mul]
      have hP_bar_g_mem : algebraMap (Polynomial k) D₀.R₀ P_bar_g ∈ Ideal.span {g₀} := by
        rw [← hpoly₀_red]
        obtain ⟨r_g, hr_g⟩ := Ideal.mem_span_singleton.mp hPg_mem
        rw [hr_g, map_mul, hg_red]
        exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
      exact Ideal.mul_mem_left _ _ hP_bar_g_mem
    let I_near : Ideal D.R₀ := Ideal.span {g, t_G}
    let B_near : Type u := D.R₀ ⧸ I_near
    letI : Algebra A B_near := ((Ideal.Quotient.mk I_near).comp c_A).toAlgebra
    haveI : Module.Finite A B_near :=
      quotient_finite_of_monic_mem D.b₀ hb₀_A I_near G_near hGn_monic
        (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    let Q₀ : Type u := D₀.R₀ ⧸ Ideal.span {g₀}
    have hI_near_le : I_near ≤ Ideal.comap π₀ (Ideal.span {g₀}) := by
      rw [Ideal.span_le]
      rintro y (rfl | rfl)
      · rw [SetLike.mem_coe, Ideal.mem_comap, show π₀ y = g₀ from hg_red]
        exact Ideal.subset_span rfl
      · exact hπ₀_tG_mem
    let π_near' : B_near →+* Q₀ := Ideal.quotientMap (Ideal.span {g₀}) π₀ hI_near_le
    have hπ_near_surj : Function.Surjective π_near' := by
      intro q₀
      obtain ⟨y₀, rfl⟩ := Ideal.Quotient.mk_surjective q₀
      obtain ⟨x₀, rfl⟩ := hπ₀_surj y₀
      exact ⟨Ideal.Quotient.mk I_near x₀, Ideal.quotientMap_mk⟩
    have hπ_near_ker : RingHom.ker π_near' = Ideal.map (algebraMap A B_near) 𝔪_A := by
      ext b
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective b
      rw [RingHom.mem_ker, Ideal.quotientMap_mk, Ideal.Quotient.eq_zero_iff_mem]
      constructor
      · intro hx
        obtain ⟨r_bar, hr_bar⟩ := Ideal.mem_span_singleton.mp hx
        obtain ⟨r, rfl⟩ := hπ₀_surj r_bar
        have hdiff_ker : x - g * r ∈ RingHom.ker π₀ := by
          rw [RingHom.mem_ker, map_sub, map_mul, hg_red, hr_bar, sub_self]
        rw [hπ₀_ker] at hdiff_ker
        have hmap_eq : Ideal.Quotient.mk I_near (x - g * r) ∈
