    Y.smallEtaleTopology Y₀.smallEtaleTopology
  have hColim_π : CategoryTheory.Limits.PreservesFiniteColimits pb_π := by
    have := adj_π.leftAdjoint_preservesColimits
    exact ⟨fun _ _ _ => inferInstance⟩
  have hColim_i₀ : CategoryTheory.Limits.PreservesFiniteColimits pb_i₀ := by
    have := adj_i₀.leftAdjoint_preservesColimits
    exact ⟨fun _ _ _ => inferInstance⟩
  have hColim_π₀ : CategoryTheory.Limits.PreservesFiniteColimits pb_π₀ := by
    have := adj_π₀.leftAdjoint_preservesColimits
    exact ⟨fun _ _ _ => inferInstance⟩
  have hColim_iY : CategoryTheory.Limits.PreservesFiniteColimits pb_iY := by
    have := adj_iY.leftAdjoint_preservesColimits
    exact ⟨fun _ _ _ => inferInstance⟩
  have hcℤ_π := hConstIso π Aℤ
  have hcℤ_i₀ := hConstIso i₀ Aℤ
  have hcℤ_π₀ := hConstIso π₀ Aℤ
  have hcℤ_iY := hConstIso i_Y Aℤ
  obtain ⟨hc_π3, hc_i₀3, hc_π₀3, hc_iY3, hr_i₀3, hr_iY3, hBC_spec, _⟩ :=
    hFinPBC π X₀ Y₀ i₀ π₀ i_Y hpb₀
  obtain rfl : hc_π = hc_π3 := Subsingleton.elim _ _
  obtain rfl : hc_i₀ = hc_i₀3 := Subsingleton.elim _ _
  obtain rfl : hc_π₀ = hc_π₀3 := Subsingleton.elim _ _
  obtain rfl : hc_iY = hc_iY3 := Subsingleton.elim _ _
  obtain rfl : hr_i₀ = hr_i₀3 := Subsingleton.elim _ _
  obtain rfl : hr_iY = hr_iY3 := Subsingleton.elim _ _
  let e_fun_spec : CategoryTheory.Iso (CategoryTheory.Functor.comp B_π B_iY)
      (CategoryTheory.Functor.comp B_i₀ B_π₀) :=
    CategoryTheory.Iso.trans
      (CategoryTheory.Iso.symm (CategoryTheory.MorphismProperty.Over.pullbackComp i_Y π))
      (CategoryTheory.Iso.trans
        (CategoryTheory.MorphismProperty.Over.pullbackCongr hpb₀.w)
        (CategoryTheory.MorphismProperty.Over.pullbackComp π₀ i₀))
  have : (CategoryTheory.Functor.comp B_π B_iY).IsContinuous
      X_A.smallEtaleTopology Y₀.smallEtaleTopology :=
    CategoryTheory.Functor.isContinuous_comp B_π B_iY
      X_A.smallEtaleTopology Y.smallEtaleTopology Y₀.smallEtaleTopology
  have : (CategoryTheory.Functor.comp B_i₀ B_π₀).IsContinuous
      X_A.smallEtaleTopology Y₀.smallEtaleTopology :=
    CategoryTheory.Functor.isContinuous_comp B_i₀ B_π₀
      X_A.smallEtaleTopology X₀.smallEtaleTopology Y₀.smallEtaleTopology
  let e_pf_spec := CategoryTheory.Functor.sheafPushforwardContinuousIso e_fun_spec
    AddCommGrpCat.{u} X_A.smallEtaleTopology Y₀.smallEtaleTopology
  let bc₀_spec : pb_i₀.obj H ⟶ pf_π₀.obj (pb_iY.obj E_Y) :=
    (adj_i₀.homEquiv H (pf_π₀.obj (pb_iY.obj E_Y))).symm
      (CategoryTheory.CategoryStruct.comp
        (pf_π.map (adj_iY.unit.app E_Y))
        (e_pf_spec.hom.app (pb_iY.obj E_Y)))
  have hIso_bc_spec : CategoryTheory.IsIso bc₀_spec := hBC_spec E_Y (hTorConst Y)
  let Fℤ_XA := (CategoryTheory.constantSheaf X_A.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_X₀ := (CategoryTheory.constantSheaf X₀.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_Y₀ := (CategoryTheory.constantSheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Pℤ_XA := (CategoryTheory.Functor.const (Opposite X_A.Etale)).obj Aℤ
  let Pℤ_Y := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj Aℤ
  let Pℤ_X₀ := (CategoryTheory.Functor.const (Opposite X₀.Etale)).obj Aℤ
  let Pℤ_Y₀ := (CategoryTheory.Functor.const (Opposite Y₀.Etale)).obj Aℤ
  let cℤ_π := (adj_π.homEquiv Fℤ_XA Fℤ_Y).symm
    (((CategoryTheory.sheafificationAdjunction X_A.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
      Pℤ_XA (pf_π.obj Fℤ_Y)).symm
      (CategoryTheory.Functor.whiskerLeft B_π.op
        ((CategoryTheory.sheafificationAdjunction Y.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ_Y)))
  let cℤ_i₀ := (adj_i₀.homEquiv Fℤ_XA Fℤ_X₀).symm
    (((CategoryTheory.sheafificationAdjunction X_A.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
      Pℤ_XA (pf_i₀.obj Fℤ_X₀)).symm
      (CategoryTheory.Functor.whiskerLeft B_i₀.op
        ((CategoryTheory.sheafificationAdjunction X₀.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ_X₀)))
  let cℤ_π₀ := (adj_π₀.homEquiv Fℤ_X₀ Fℤ_Y₀).symm
    (((CategoryTheory.sheafificationAdjunction X₀.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
      Pℤ_X₀ (pf_π₀.obj Fℤ_Y₀)).symm
      (CategoryTheory.Functor.whiskerLeft B_π₀.op
        ((CategoryTheory.sheafificationAdjunction Y₀.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ_Y₀)))
  let cℤ_iY := (adj_iY.homEquiv Fℤ_Y Fℤ_Y₀).symm
    (((CategoryTheory.sheafificationAdjunction Y.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
      Pℤ_Y (pf_iY.obj Fℤ_Y₀)).symm
      (CategoryTheory.Functor.whiskerLeft B_iY.op
        ((CategoryTheory.sheafificationAdjunction Y₀.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ_Y₀)))
  let inv_π := @CategoryTheory.inv _ _ _ _ cℤ_π hcℤ_π
  let inv_i₀ := @CategoryTheory.inv _ _ _ _ cℤ_i₀ hcℤ_i₀
  let inv_π₀ := @CategoryTheory.inv _ _ _ _ cℤ_π₀ hcℤ_π₀
  let inv_iY := @CategoryTheory.inv _ _ _ _ cℤ_iY hcℤ_iY
  let φ_i₀ := fun (q : ℕ) (x : H.H q) =>
    (CategoryTheory.Abelian.Ext.mk₀ inv_i₀).precomp (pb_i₀.obj H) (Nat.zero_add q)
      ((pb_i₀.mapExtAddHom Fℤ_XA H q) x)
  let φ_iY := fun (q : ℕ) (y : E_Y.H q) =>
    (CategoryTheory.Abelian.Ext.mk₀ inv_iY).precomp (pb_iY.obj E_Y) (Nat.zero_add q)
      ((pb_iY.mapExtAddHom Fℤ_Y E_Y q) y)
  let bc_post := fun (q : ℕ) (z : (pb_i₀.obj H).H q) =>
    (CategoryTheory.Abelian.Ext.mk₀ bc₀_spec).postcomp Fℤ_X₀ (Nat.add_zero q) z
  let ψ_π := fun (q : ℕ) (x : H.H q) =>
    (CategoryTheory.Abelian.Ext.mk₀ (adj_π.counit.app E_Y)).postcomp Fℤ_Y (Nat.add_zero q)
      ((CategoryTheory.Abelian.Ext.mk₀ inv_π).precomp (pb_π.obj H) (Nat.zero_add q)
        ((pb_π.mapExtAddHom Fℤ_XA H q) x))
  let ψ_π₀ := fun (q : ℕ) (w : (pf_π₀.obj (pb_iY.obj E_Y)).H q) =>
    (CategoryTheory.Abelian.Ext.mk₀ (adj_π₀.counit.app (pb_iY.obj E_Y))).postcomp Fℤ_Y₀ (Nat.add_zero q)
      ((CategoryTheory.Abelian.Ext.mk₀ inv_π₀).precomp (pb_π₀.obj (pf_π₀.obj (pb_iY.obj E_Y))) (Nat.zero_add q)
        ((pb_π₀.mapExtAddHom Fℤ_X₀ (pf_π₀.obj (pb_iY.obj E_Y)) q) w))
  have hBij_ψπ : ∀ q : ℕ, Function.Bijective (ψ_π q) :=
    fun q => hLeray π (p₁_A ≫ s_A) hcℤ_π q E_Y (hTorConst Y)
  have hBij_ψπ₀ : ∀ q : ℕ, Function.Bijective (ψ_π₀ q) :=
    fun q => hLeray π₀ (CategoryTheory.Limits.pullback.fst ι_A p₁_A) hcℤ_π₀ q
      (pb_iY.obj E_Y) (hTorMap pb_iY E_Y (hTorConst Y))
  have hBij_bc : ∀ q : ℕ, Function.Bijective (bc_post q) :=
    fun q => hIsoPostBij (@CategoryTheory.asIso _ _ _ _ bc₀_spec hIso_bc_spec) q
  have hComm : ∀ (q : ℕ) (x : H.H q),
      ψ_π₀ q (bc_post q (φ_i₀ q x)) = φ_iY q (ψ_π q x) :=
    fun q x => weil_etale_pullback_pushforward_mate_cohomology_comm
      π i₀ π₀ i_Y hpb₀ hcℤ_π hcℤ_i₀ hcℤ_π₀ hcℤ_iY E_Y q x
  obtain ⟨hCov0, hCovPos⟩ := hFinCover Y π
  refine ⟨H, u_A, hu_A, hH_tor, ?_, ?_⟩
  · obtain ⟨hc_iY4, hr_iY4, hAdd_iY4, hLim_iY4, hColim_iY4, hcℤ_iY4, hBij_iY0⟩ := hCov0
    obtain rfl : hc_iY = hc_iY4 := Subsingleton.elim _ _
    obtain rfl : hr_iY = hr_iY4 := Subsingleton.elim _ _
    obtain rfl : hAdd_iY = hAdd_iY4 := Subsingleton.elim _ _
    obtain rfl : hLim_iY = hLim_iY4 := Subsingleton.elim _ _
    obtain rfl : hColim_iY = hColim_iY4 := Subsingleton.elim _ _
    obtain rfl : hcℤ_iY = hcℤ_iY4 := Subsingleton.elim _ _
    refine ⟨hc_i₀, hr_i₀, hAdd_i₀, hLim_i₀, hColim_i₀, hcℤ_i₀, ?_⟩
    have hRHS_bij : Function.Bijective (fun x : H.H 0 => φ_iY 0 (ψ_π 0 x)) :=
      hBij_iY0.comp (hBij_ψπ 0)
    have hLHS_bij : Function.Bijective (fun z : (pb_i₀.obj H).H 0 => ψ_π₀ 0 (bc_post 0 z)) :=
      (hBij_ψπ₀ 0).comp (hBij_bc 0)
    have hComp_bij : Function.Bijective (fun x : H.H 0 => ψ_π₀ 0 (bc_post 0 (φ_i₀ 0 x))) := by
      simpa only [hComm 0] using hRHS_bij
    exact ⟨fun x₁ x₂ h_eq => hComp_bij.1 (congrArg (fun z => ψ_π₀ 0 (bc_post 0 z)) h_eq),
      fun z => by
        obtain ⟨x, hx⟩ := hComp_bij.2 (ψ_π₀ 0 (bc_post 0 z))
        exact ⟨x, hLHS_bij.1 hx⟩⟩
  · intro q hq
    obtain ⟨hc_iY5, hr_iY5, hAdd_iY5, hLim_iY5, hColim_iY5, hcℤ_iY5, hSurj_iYq⟩ := hCovPos q hq
    obtain rfl : hc_iY = hc_iY5 := Subsingleton.elim _ _
    obtain rfl : hr_iY = hr_iY5 := Subsingleton.elim _ _
    obtain rfl : hAdd_iY = hAdd_iY5 := Subsingleton.elim _ _
    obtain rfl : hLim_iY = hLim_iY5 := Subsingleton.elim _ _
    obtain rfl : hColim_iY = hColim_iY5 := Subsingleton.elim _ _
    obtain rfl : hcℤ_iY = hcℤ_iY5 := Subsingleton.elim _ _
    refine ⟨hc_i₀, hr_i₀, hAdd_i₀, hLim_i₀, hColim_i₀, hcℤ_i₀, ?_⟩
    have hRHS_surj : Function.Surjective (fun x : H.H q => φ_iY q (ψ_π q x)) :=
      hSurj_iYq.comp (hBij_ψπ q).2
    have hLHS_bij : Function.Bijective (fun z : (pb_i₀.obj H).H q => ψ_π₀ q (bc_post q z)) :=
      (hBij_ψπ₀ q).comp (hBij_bc q)
    change Function.Surjective (φ_i₀ q)
    intro z
    obtain ⟨x, hx⟩ := hRHS_surj (ψ_π₀ q (bc_post q z))
    exact ⟨x, hLHS_bij.1 ((hComm q x).trans hx)⟩

theorem weil_etale_cohomology_pullback_effaceable_step (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    {X₀ : AlgebraicGeometry.Scheme.{u}}
    (i₀ : X₀ ⟶ X.left)
    (hInjZero : ∀ {Z S : AlgebraicGeometry.Scheme.{u}} (f : Z ⟶ S)
      (I : CategoryTheory.Sheaf Z.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))))
      [CategoryTheory.Injective I] (q : ℕ), 1 ≤ q →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f q
          ((CategoryTheory.Sheaf.composeAndSheafify Z.smallEtaleTopology
            (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
              AddCommGrpCat.{u})).obj I)))
    (m : ℕ)
    (hPrev : ∀ (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      WeilEtaleCohomologyPullbackBijective i₀ F m)
    (F' H : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})
    (u_A : F' ⟶ H) :
    ℓ • CategoryTheory.CategoryStruct.id F' = 0 →
    ℓ • CategoryTheory.CategoryStruct.id H = 0 →
    CategoryTheory.Mono u_A →
    WeilEtaleCohomologyPullbackSurjective i₀ H (m + 1) →
    WeilEtaleCohomologyPullbackBijective i₀ F' (m + 1) :=
by
  intro hF'_tor hH_tor hu_A hH_surj
  let _ := (inferInstance : IsAlgClosed k)
  let _ := @hInjZero
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
  
  let Y : AlgebraicGeometry.Scheme.{u} := X.left
  let Y₀ : AlgebraicGeometry.Scheme.{u} := X₀
  let h : Quiver.Hom Y₀ Y := i₀
  let J_Y := Y.smallEtaleTopology
  let J_Y₀ := Y₀.smallEtaleTopology
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_h : CategoryTheory.Functor Y.Etale Y₀.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  rcases hH_surj with ⟨hCont, hRA, hAdd, hLim, hColim, hcℤ, hSurj_H⟩
  letI : B_h.IsContinuous J_Y J_Y₀ := hCont
  let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_Y₀
  letI : pf_h.IsRightAdjoint := hRA
  let pb_h := B_h.sheafPullback AddCommGrpCat.{u} J_Y J_Y₀
  let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} J_Y J_Y₀
  letI : pb_h.Additive := hAdd
  letI : CategoryTheory.Limits.PreservesFiniteLimits pb_h := hLim
  letI : CategoryTheory.Limits.PreservesFiniteColimits pb_h := hColim
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Pℤ_Y := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj Aℤ
  let Pℤ_Y₀ := (CategoryTheory.Functor.const (Opposite Y₀.Etale)).obj Aℤ
  let Cℤ := CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}
  let Cℤ₀ := CategoryTheory.constantSheaf J_Y₀ AddCommGrpCat.{u}
  let Fℤ_Y := Cℤ.obj Aℤ
  let Fℤ_Y₀ := Cℤ₀.obj Aℤ
  let η₀ := CategoryTheory.Functor.whiskerLeft B_h.op
    ((CategoryTheory.sheafificationAdjunction J_Y₀ AddCommGrpCat.{u}).unit.app Pℤ_Y₀)
  let uℤ := ((CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}).homEquiv
    Pℤ_Y (pf_h.obj Fℤ_Y₀)).symm η₀
  let cℤ := (adj_h.homEquiv Fℤ_Y Fℤ_Y₀).symm uℤ
  let inv_cℤ := @CategoryTheory.inv _ _ _ _ cℤ hcℤ
  let Φ_hom : ∀ (A : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) (q : ℕ),
      CategoryTheory.Abelian.Ext.{u} Fℤ_Y A q →+
        CategoryTheory.Abelian.Ext.{u} Fℤ_Y₀ (pb_h.obj A) q :=
    fun A q =>
      ((CategoryTheory.Abelian.Ext.mk₀ inv_cℤ).precomp (pb_h.obj A) (Nat.zero_add q)).comp
        (pb_h.mapExtAddHom Fℤ_Y A q)
  let Φ : ∀ (A : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) (q : ℕ),
      CategoryTheory.Abelian.Ext.{u} Fℤ_Y A q →
        CategoryTheory.Abelian.Ext.{u} Fℤ_Y₀ (pb_h.obj A) q :=
    fun A q x => Φ_hom A q x
  have hSurj_H' : Function.Surjective (Φ H (m + 1)) := hSurj_H
  have hPrev_bij : ∀ (E : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id E = 0 →
      Function.Bijective (Φ E m) := by
    intro E hE_tor
    rcases hPrev E hE_tor with ⟨hCont', hRA', hAdd', hLim', hColim', hcℤ', hBij⟩
    have e1 : hCont' = hCont := Subsingleton.elim _ _; subst e1
    have e2 : hRA' = hRA := Subsingleton.elim _ _; subst e2
    have e3 : hAdd' = hAdd := Subsingleton.elim _ _; subst e3
    have e4 : hLim' = hLim := Subsingleton.elim _ _; subst e4
    have e5 : hColim' = hColim := Subsingleton.elim _ _; subst e5
    have e6 : hcℤ' = hcℤ := Subsingleton.elim _ _; subst e6
    exact hBij
  
  have hΦ_eq : ∀ (A : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) (q : ℕ)
      (x : CategoryTheory.Abelian.Ext.{u} Fℤ_Y A q),
      Φ A q x = (CategoryTheory.Abelian.Ext.mk₀ inv_cℤ).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_h x) (Nat.zero_add q) :=
    fun _ _ _ => rfl
  have hΦ_map : ∀ {A B : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
      (u : A ⟶ B) (q : ℕ) (x : CategoryTheory.Abelian.Ext.{u} Fℤ_Y A q),
      Φ B q (x.comp (CategoryTheory.Abelian.Ext.mk₀ u) (Nat.add_zero q)) =
        (Φ A q x).comp (CategoryTheory.Abelian.Ext.mk₀ (pb_h.map u)) (Nat.add_zero q) := by
    intro A B u q x
    rw [hΦ_eq, hΦ_eq,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ inv_cℤ)
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_h x)
        (CategoryTheory.Abelian.Ext.mk₀ (pb_h.map u))
        (Nat.zero_add q) (Nat.add_zero q) (by omega)]
  have hΦ_extClass : ∀ {S : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})}
      (hS : S.ShortExact) (y : CategoryTheory.Abelian.Ext.{u} Fℤ_Y S.X₃ m),
      Φ S.X₁ (m + 1) (y.comp hS.extClass rfl) =
        (Φ S.X₃ m y).comp (hS.map_of_exact pb_h).extClass rfl := by
    intro S hS y
    rw [hΦ_eq, hΦ_eq,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
      ← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ inv_cℤ)
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_h y)
        (hS.map_of_exact pb_h).extClass
        (Nat.zero_add m) rfl (by omega)]
  
  let sh := CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}
  let Z_sh : Y.Etale → CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
    fun V => sh.obj ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free)
  have hMono_Zsh : ∀ V : Y.Etale,
      CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id (Z_sh V)) := by
    intro V
    let P_V := (CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free
    have : ∀ T : (Y.Etale)ᵒᵖ,
        CategoryTheory.Mono ((ℓ • CategoryTheory.CategoryStruct.id P_V).app T) := by
      intro T
      change CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id (P_V.obj T))
      rw [AddCommGrpCat.mono_iff_injective]
      intro a b hab
      have h_app : ∀ (n : ℕ) (z : ↑(P_V.obj T)),
          (n • CategoryTheory.CategoryStruct.id (P_V.obj T)).hom z = n • z := by
        intro n z
        induction n with
        | zero =>
          rw [zero_nsmul, zero_nsmul]
          rfl
        | succ k₀ ih =>
          rw [succ_nsmul, succ_nsmul]
          exact congrArg (· + z) ih
      have hab' : ℓ • a = ℓ • b := by
        rw [← h_app ℓ a, ← h_app ℓ b]
        exact hab
      let e_fs := FreeAbelianGroup.equivFinsupp (T.unop ⟶ V)
      let a' : FreeAbelianGroup (T.unop ⟶ V) := a
      let b' : FreeAbelianGroup (T.unop ⟶ V) := b
      have hab_fs : e_fs (ℓ • a') = e_fs (ℓ • b') := congrArg e_fs (hab' : ℓ • a' = ℓ • b')
      rw [map_nsmul, map_nsmul] at hab_fs
      exact e_fs.injective (nsmul_right_injective hℓ_ne hab_fs)
    have _ : CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id P_V) :=
      CategoryTheory.NatTrans.mono_of_mono_app (ℓ • CategoryTheory.CategoryStruct.id P_V)
    have h_map : sh.map (ℓ • CategoryTheory.CategoryStruct.id P_V) =
