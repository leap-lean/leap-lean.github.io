  let inv_cℤ := @CategoryTheory.inv _ _ _ _ cℤ hcℤ
  let θ_Gm : CategoryTheory.NatTrans (weilEtaleGmPresheaf C)
      (CategoryTheory.Functor.comp B_h.op (weilEtaleGmPresheaf C₀)) :=
    { app := fun U =>
        AddCommGrpCat.ofHom (MonoidHom.toAdditive (Units.map
          ((CategoryTheory.Limits.pullback.fst (Opposite.unop U).hom i_C).appTop).hom.toMonoidHom))
      naturality := fun {U₁ U₂} u => by
        apply AddCommGrpCat.ext
