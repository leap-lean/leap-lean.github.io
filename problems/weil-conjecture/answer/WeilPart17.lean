    letI : Algebra D.R₀₁ A₀₁ := inferInstance
    letI : CommRing A₁₀ := inferInstance
    letI : Algebra D.R₀₁ A₁₀ := inferInstance
    let σE₀ : E.L₀ →ₗ[D.R₀] T₀ := e₀.toLinearMap.restrictScalars D.R₀ ∘ₗ TensorProduct.mk D.R₀ T₀ E.L₀ 1
    let σE₁ : E.L₁ →ₗ[D.R₁] T₁ := e₁.toLinearMap.restrictScalars D.R₁ ∘ₗ TensorProduct.mk D.R₁ T₁ E.L₁ 1
    let σF₀ : F.L₀ →ₗ[D.R₀] T₀ := f₀.toLinearMap.restrictScalars D.R₀ ∘ₗ TensorProduct.mk D.R₀ T₀ F.L₀ 1
    let σF₁ : F.L₁ →ₗ[D.R₁] T₁ := f₁.toLinearMap.restrictScalars D.R₁ ∘ₗ TensorProduct.mk D.R₁ T₁ F.L₁ 1
    let u₀ : Units T₀ :=
      unitOfLinearEquiv ((e₀.symm.trans (LinearEquiv.baseChange D.R₀ T₀ E.L₀ F.L₀ α₀)).trans f₀)
    let u₁ : Units T₁ :=
      unitOfLinearEquiv ((e₁.symm.trans (LinearEquiv.baseChange D.R₁ T₁ E.L₁ F.L₁ α₁)).trans f₁)
    have hσ₀_iso : ∀ x : E.L₀, σF₀ (α₀ x) = (u₀ : T₀) * σE₀ x := by
      intro x
      have h := unitOfLinearEquiv_apply
        ((e₀.symm.trans (LinearEquiv.baseChange D.R₀ T₀ E.L₀ F.L₀ α₀)).trans f₀) (σE₀ x)
      simpa [σE₀, σF₀, u₀] using h
    have hσ₁_iso : ∀ y : E.L₁, σF₁ (α₁ y) = (u₁ : T₁) * σE₁ y := by
      intro y
      have h := unitOfLinearEquiv_apply
        ((e₁.symm.trans (LinearEquiv.baseChange D.R₁ T₁ E.L₁ F.L₁ α₁)).trans f₁) (σE₁ y)
      simpa [σE₁, σF₁, u₁] using h
    have diag_cob : ∀ {R T L M : Type u} [CommRing R] [CommRing T] [Algebra R T]
        [AddCommGroup L] [Module R L] [AddCommGroup M] [Module R M]
        (eL : TensorProduct R T L ≃ₗ[T] T)
        (σM : M →ₗ[R] T) (α : L ≃ₗ[R] M) (u : Units T)
        (gL gM : Units (TensorProduct R T T)),
        (∀ x : L, ((1 : T) ⊗ₜ[R] eL ((1 : T) ⊗ₜ[R] x) : TensorProduct R T T) =
          (gL : TensorProduct R T T) * (eL ((1 : T) ⊗ₜ[R] x) ⊗ₜ[R] (1 : T))) →
        (∀ y : M, ((1 : T) ⊗ₜ[R] σM y : TensorProduct R T T) =
          (gM : TensorProduct R T T) * (σM y ⊗ₜ[R] (1 : T))) →
