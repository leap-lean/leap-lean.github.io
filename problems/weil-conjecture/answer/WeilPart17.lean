    refine ⟨g, e, G_near, hg_red, he_red, hg_reg, he_idem, hGn_monic, ?_⟩
    rw [hspan_eq]
    exact htG_mem_e'
  obtain ⟨g, e, P_J, hg_red, he_red, hg_reg, he_idem, hPJ_monic, hPJ_mem⟩ := h_stage3
  classical
  letI : Algebra D.R₀ D₀.R₀ := red.algR₀
