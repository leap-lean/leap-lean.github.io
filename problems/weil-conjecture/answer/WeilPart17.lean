          (weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 0 b)
          (weilTwoChartCoboundary D u₀ u₁) := by
      intro b
      let b_W : Units ↑(W_sch.presheaf.obj (Opposite.op ⊤)) := Additive.toMul b
      have hd₀_mul : (@Additive.toMul (Units ↑(P₂.presheaf.obj (Opposite.op ⊤)))
          (weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 0 b)) =
          Units.map π₁.appTop.hom.toMonoidHom b_W *
            (Units.map π₀.appTop.hom.toMonoidHom b_W)⁻¹ := by
        have hd₀_sum : weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 0 b =
            ((weilEtaleGmPresheaf Z).map (weilEtaleCechProj w 1 1).op).hom b +
              (- (((weilEtaleGmPresheaf Z).map (weilEtaleCechProj w 1 0).op).hom b)) := by
          dsimp only [weilEtaleCechDiff]
          rw [addHom_sum_apply, Fin.sum_univ_two, Fin.val_zero, Fin.val_one,
            pow_zero, pow_one, hface0_0, hface0_1]
          change (1 : ℤ) • (((weilEtaleGmPresheaf Z).map (weilEtaleCechProj w 1 1).op).hom b) +
            (-1 : ℤ) • (((weilEtaleGmPresheaf Z).map (weilEtaleCechProj w 1 0).op).hom b) = _
          rw [one_smul, neg_one_smul]
        rw [hd₀_sum]
        rfl
      refine (hMatchIff _ _).mpr ?_
      dsimp only [weilTwoChartCoboundary]
      rw [hd₀_mul, map_mul, map_mul, map_mul, map_mul, map_inv, map_inv, map_inv, map_inv]
      refine ⟨?_, ?_, ?_, ?_⟩
      · rw [eval_spec_pull κ₀₀ π₁ inl_c ι₀₀_R hκ₀₀_1 b_W,
          eval_spec_pull κ₀₀ π₀ inl_c ι₀₀_L hκ₀₀_0 b_W]
      · rw [eval_spec_pull κ₀₁ π₁ inr_c ι₀₁_R hκ₀₁_1 b_W,
          eval_spec_pull κ₀₁ π₀ inl_c ι₀₁_L hκ₀₁_0 b_W]
      · rw [eval_spec_pull κ₁₀ π₁ inl_c ι₁₀_R hκ₁₀_1 b_W,
          eval_spec_pull κ₁₀ π₀ inr_c ι₁₀_L hκ₁₀_0 b_W]
      · rw [eval_spec_pull κ₁₁ π₁ inr_c ι₁₁_R hκ₁₁_1 b_W,
          eval_spec_pull κ₁₁ π₀ inr_c ι₁₁_L hκ₁₁_0 b_W]

    have h2_6 : ∀ (c : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 1))))
        (q : WeilTwoChartUnitQuad D T₀ T₁),
