      rw [htower₁, ← map_mul]
      dsimp [e_I01]
      rw [away_ideal_baseChange_equiv_tmul]
    | add w₁ w₂ ih₁ ih₂ =>
      rw [TensorProduct.tmul_add, map_add, map_add, map_add, ih₁, ih₂, map_add,
        AddMemClass.coe_add, map_add]
  let θ_bc : TensorProduct D₀.R₀ D₀.R₀₁ (TensorProduct D.R₀ D₀.R₀ ↥J) ≃ₗ[D₀.R₀₁]
      TensorProduct D₀.R₁ D₀.R₀₁ (TensorProduct D.R₁ D₀.R₁ ↥I) :=
    ((TensorProduct.AlgebraTensorModule.cancelBaseChange D.R₀ D₀.R₀ D₀.R₀₁ D₀.R₀₁ ↥J).trans
      (TensorProduct.AlgebraTensorModule.cancelBaseChange D.R₀ D.R₀₁ D₀.R₀₁ D₀.R₀₁ ↥J).symm).trans
      ((LinearEquiv.baseChange D.R₀₁ D₀.R₀₁ _ _ E₁.θ).trans
        ((TensorProduct.AlgebraTensorModule.cancelBaseChange D.R₁ D₀.R₁ D₀.R₀₁ D₀.R₀₁ ↥I).trans
          (TensorProduct.AlgebraTensorModule.cancelBaseChange D.R₁ D.R₀₁ D₀.R₀₁ D₀.R₀₁ ↥I).symm).symm)
  have hcomm_raw :
      (LinearEquiv.baseChange D₀.R₀ D₀.R₀₁ _ _ e_iso0_raw).trans E₀.θ =
        θ_bc.trans (LinearEquiv.baseChange D₀.R₁ D₀.R₀₁ _ _ e_iso1_raw) := by
    ext z
    apply hΛ₀₁_inj
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul r01_bar m =>
      have hm_smul : r01_bar ⊗ₜ[D₀.R₀] m = r01_bar • ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₀] m) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [hm_smul, map_smul, map_smul, map_smul, map_smul]
      clear hm_smul
      congr 1
      induction m using TensorProduct.induction_on with
      | zero => simp
      | tmul r0_bar x =>
        have hx_smul : (1 : D₀.R₀₁) ⊗ₜ[D₀.R₀] (r0_bar ⊗ₜ[D.R₀] x) =
            (algebraMap D₀.R₀ D₀.R₀₁ r0_bar) • ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₀] ((1 : D₀.R₀) ⊗ₜ[D.R₀] x)) := by
          have h1 : r0_bar ⊗ₜ[D.R₀] x = r0_bar • ((1 : D₀.R₀) ⊗ₜ[D.R₀] x) := by
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [h1, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [hx_smul, map_smul, map_smul, map_smul, map_smul]
        congr 1
        have hlhs : Λ₀₁ (((LinearEquiv.baseChange D₀.R₀ D₀.R₀₁ _ _ e_iso0_raw).trans E₀.θ)
            ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₀] ((1 : D₀.R₀) ⊗ₜ[D.R₀] x))) =
            u01_bar ^ m₀ * algebraMap D₀.R₀ D₀.R₀₁ (π₀ x.1) := by
          rw [LinearEquiv.trans_apply, LinearEquiv.baseChange_tmul, hOv₀, hΦ₀_iso]
        have hrhs : Λ₀₁ ((θ_bc.trans
            (LinearEquiv.baseChange D₀.R₁ D₀.R₀₁ _ _ e_iso1_raw))
            ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₀] ((1 : D₀.R₀) ⊗ₜ[D.R₀] x))) =
            u01_bar ^ m₀ * algebraMap D₀.R₀ D₀.R₀₁ (π₀ x.1) := by
          dsimp only [θ_bc]
          simp only [LinearEquiv.trans_apply,
            TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul,
            TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul,
            LinearEquiv.baseChange_tmul, mul_one, one_smul]
          rw [hrhs_chain]
          have heI : (e_I01 (E₁.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] x))).1 =
              u₀₁ ^ m₀ * algebraMap D.R₀ D.R₀₁ x.1 := by
            dsimp [E₁]
            rw [e_I01.apply_symm_apply]
            change u₀₁ ^ m₀ * (e_J01 ((1 : D.R₀₁) ⊗ₜ[D.R₀] x)).1 = _
            dsimp [e_J01]
            rw [away_ideal_baseChange_equiv_tmul, one_mul]
          rw [heI, map_mul, map_pow, hπ₀₁_u₀₁]
          congr 1
          dsimp [π₀₁, π₀]
          rw [← IsScalarTower.algebraMap_apply D.R₀ D.R₀₁ D₀.R₀₁,
            IsScalarTower.algebraMap_apply D.R₀ D₀.R₀ D₀.R₀₁]
        exact hlhs.trans hrhs.symm
      | add m₁ m₂ ihm₁ ihm₂ =>
        rw [TensorProduct.tmul_add, map_add, map_add, map_add, map_add, ihm₁, ihm₂]
    | add z₁ z₂ ih₁ ih₂ =>
      rw [map_add, map_add, map_add, map_add, ih₁, ih₂]
  exact ⟨E₁, e_iso0_raw, e_iso1_raw, hcomm_raw⟩

theorem weil_henselian_mvPoly_and_weierstrass_split (k : Type u) [Field k]
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (hA : WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A) :
    (∀ (N : ℕ) (F : Fin N → MvPolynomial (Fin N) A) (x₀ : Fin N → A),
      (∀ i : Fin N, τ_A (MvPolynomial.eval x₀ (F i)) = 0) →
      (Matrix.of fun i j : Fin N =>
        τ_A (MvPolynomial.eval x₀ (MvPolynomial.pderiv j (F i)))).det ≠ 0 →
      ∃ x : Fin N → A,
        (∀ j : Fin N, τ_A (x j) = τ_A (x₀ j)) ∧
        (∀ i : Fin N, MvPolynomial.eval x (F i) = 0)) ∧
    (∀ (d : ℕ) (P : Polynomial A),
      Polynomial.map τ_A.toRingHom P = Polynomial.X ^ d →
      ∃ G_near G_far : Polynomial A,
        G_near.Monic ∧
        G_near.natDegree = d ∧
        Polynomial.map τ_A.toRingHom G_near = Polynomial.X ^ d ∧
        Polynomial.map τ_A.toRingHom G_far = 1 ∧
        P = G_near * G_far ∧
        IsCoprime G_near G_far) :=
by
  have hHensel : ∀ (N : ℕ) (F : Fin N → MvPolynomial (Fin N) A) (x₀ : Fin N → A),
      (∀ i : Fin N, τ_A (MvPolynomial.eval x₀ (F i)) = 0) →
      (Matrix.of fun i j : Fin N =>
        τ_A (MvPolynomial.eval x₀ (MvPolynomial.pderiv j (F i)))).det ≠ 0 →
      ∃ x : Fin N → A,
        (∀ j : Fin N, τ_A (x j) = τ_A (x₀ j)) ∧
        (∀ i : Fin N, MvPolynomial.eval x (F i) = 0) := by
    intro N F x₀ hZero hDet
    let I_F : Ideal (MvPolynomial (Fin N) A) := Ideal.span (Set.range F)
    let C₀ : Type u := MvPolynomial (Fin N) A ⧸ I_F
    let q₀ : MvPolynomial (Fin N) A →ₐ[A] C₀ := Ideal.Quotient.mkₐ A I_F
    let P₀ : Algebra.PreSubmersivePresentation A C₀ (Fin N) (Fin N) :=
      Algebra.PreSubmersivePresentation.naive (v := F) _root_.id Function.injective_id
    let δ : C₀ := P₀.jacobian
    have h_algMap : ∀ Q : P₀.Ring, algebraMap P₀.Ring C₀ Q = q₀ Q := by
      have h_aeval : MvPolynomial.aeval P₀.val = q₀ := by
        ext j
        simp only [MvPolynomial.aeval_X, P₀,
          Algebra.PreSubmersivePresentation.naive_toPresentation,
          Algebra.Presentation.naive_toGenerators, Algebra.Generators.naive_val]
        rfl
      intro Q
      rw [Algebra.Generators.algebraMap_apply, h_aeval]
    have h_jac_mat : P₀.jacobiMatrix.transpose =
        Matrix.of (fun i j : Fin N => MvPolynomial.pderiv j (F i)) := by
      apply Matrix.ext
      intro i j
      rw [Matrix.transpose_apply, Matrix.of_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      rfl
    have hδ_eq : δ = q₀ (Matrix.of fun i j : Fin N => MvPolynomial.pderiv j (F i)).det := by
      dsimp [δ]
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, h_algMap]
      congr 1
      rw [← Matrix.det_transpose, h_jac_mat]
    let ψ₀ : MvPolynomial (Fin N) A →+* k := τ_A.toRingHom.comp (MvPolynomial.eval x₀)
    have hI_le : ∀ Q ∈ I_F, ψ₀ Q = 0 := by
      intro Q hQ
      have h_ker : I_F ≤ RingHom.ker ψ₀ := by
        rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        exact hZero i
      exact h_ker hQ
    let τ₀ : C₀ →+* k := Ideal.Quotient.lift I_F ψ₀ hI_le
    have hτ₀_mk : ∀ Q : MvPolynomial (Fin N) A, τ₀ (q₀ Q) = ψ₀ Q := fun _ => rfl
    have hτ₀_alg : ∀ a : A, τ₀ (algebraMap A C₀ a) = τ_A a := by
      intro a
      have ha : algebraMap A C₀ a = q₀ (MvPolynomial.C a) := rfl
      rw [ha, hτ₀_mk]
      simp [ψ₀]
    have hτ₀_δ : τ₀ δ ≠ 0 := by
      rw [hδ_eq, hτ₀_mk, RingHom.map_det]
      have h_map_mat : ψ₀.mapMatrix (Matrix.of fun i j : Fin N => MvPolynomial.pderiv j (F i)) =
          Matrix.of (fun i j : Fin N => τ_A (MvPolynomial.eval x₀ (MvPolynomial.pderiv j (F i)))) := by
        apply Matrix.ext
        intro i j
        simp [ψ₀, RingHom.mapMatrix_apply, Matrix.map_apply]
      rw [h_map_mat]
      exact hDet
    have hUnit_δ : IsUnit (τ₀ δ) := isUnit_iff_ne_zero.mpr hτ₀_δ
    let C : Type u := Localization.Away δ
    let Q_loc : Algebra.SubmersivePresentation C₀ C Unit Unit :=
      Algebra.SubmersivePresentation.localizationAway C δ
    let P_comp := Q_loc.toPreSubmersivePresentation.comp P₀
    have hP_comp_unit : IsUnit P_comp.jacobian := by
      dsimp [P_comp]
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.smul_def]
      exact (IsLocalization.Away.algebraMap_isUnit δ).mul Q_loc.jacobian_isUnit
    let P_sub := Algebra.SubmersivePresentation.mk P_comp hP_comp_unit
    have hP_sub_dim : P_sub.dimension = 0 := by
      change P_comp.dimension = 0
      rw [Algebra.PreSubmersivePresentation.dimension_comp_eq_dimension_add_dimension]
      have hQ_dim : Q_loc.dimension = 0 :=
        Algebra.Presentation.localizationAway_dimension_zero δ
      have hP₀_dim : P₀.dimension = 0 := Nat.sub_self _
      omega
    have hSm : Algebra.IsStandardSmoothOfRelativeDimension 0 A C :=
      P_sub.isStandardSmoothOfRelativeDimension hP_sub_dim
    haveI : Algebra.Etale A C :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr hSm
    let τ_C : C →+* k := IsLocalization.Away.lift δ hUnit_δ
    have hτ_C_alg : ∀ a : A, τ_C (algebraMap A C a) = τ_A a := by
      intro a
      rw [IsScalarTower.algebraMap_apply A C₀ C, IsLocalization.Away.lift_eq δ hUnit_δ, hτ₀_alg]
    obtain ⟨σ_C, hσ_C⟩ := hA.2.2.2.2 C τ_C hτ_C_alg
    let φ : MvPolynomial (Fin N) A →ₐ[A] A :=
      σ_C.comp ((IsScalarTower.toAlgHom A C₀ C).comp q₀)
    let x : Fin N → A := fun j => φ (MvPolynomial.X j)
    have hφ_eq : (MvPolynomial.eval x : MvPolynomial (Fin N) A →+* A) = φ.toRingHom := by
      apply MvPolynomial.ringHom_ext'
      · ext a; simp
      · intro j; simp [x]
    refine ⟨x, ?_, ?_⟩
    · intro j
      dsimp [x, φ]
      rw [hσ_C]
      change τ_C (algebraMap C₀ C (q₀ (MvPolynomial.X j))) = τ_A (x₀ j)
      rw [IsLocalization.Away.lift_eq δ hUnit_δ, hτ₀_mk]
      simp [ψ₀]
    · intro i
      have hev : MvPolynomial.eval x (F i) = φ (F i) :=
        RingHom.congr_fun hφ_eq (F i)
      rw [hev]
      dsimp [φ]
      have hFi : q₀ (F i) = 0 := by
        change Ideal.Quotient.mk I_F (F i) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span ⟨i, rfl⟩
      rw [hFi, map_zero, map_zero]
  refine ⟨hHensel, ?_⟩
  intro d P hP
  letI : IsLocalRing A := hA.2.1
  have hτ_unit : ∀ a : A, τ_A a = 0 ↔ ¬ IsUnit a := hA.2.2.1
  letI : Nontrivial A := τ_A.toRingHom.domain_nontrivial
  let N_P : ℕ := max d P.natDegree
  have hd_le : d ≤ N_P := le_max_left d P.natDegree
  have hP_le : P.natDegree ≤ N_P := le_max_right d P.natDegree
  let M : ℕ := N_P + 1
  let cNearZ : ℕ → MvPolynomial (Fin M) A := fun a =>
    if ha : a < d then MvPolynomial.X ⟨a, by omega⟩
    else if a = d then 1 else 0
  let cFarZ : ℕ → MvPolynomial (Fin M) A := fun b =>
    if hb : b ≤ N_P - d then MvPolynomial.X ⟨d + b, by omega⟩
    else 0
  let F_fac : Fin M → MvPolynomial (Fin M) A := fun m =>
    (∑ p ∈ Finset.HasAntidiagonal.antidiagonal m.val, cNearZ p.1 * cFarZ p.2) -
      MvPolynomial.C (P.coeff m.val)
  let x₀ : Fin M → A := fun l => if l.val = d then 1 else 0
  have hcNear_x₀ : ∀ a : ℕ, MvPolynomial.eval x₀ (cNearZ a) = if a = d then 1 else 0 := by
    intro a
    dsimp [cNearZ]
    split_ifs <;> simp [x₀] <;> omega
  have hcFar_x₀ : ∀ b : ℕ, MvPolynomial.eval x₀ (cFarZ b) = if b = 0 then 1 else 0 := by
    intro b
    dsimp [cFarZ]
    split_ifs <;> simp [x₀] <;> omega
  have hpNear_x₀ : ∀ (l : Fin M) (a : ℕ),
      MvPolynomial.eval x₀ (MvPolynomial.pderiv l (cNearZ a)) =
        if l.val < d ∧ a = l.val then 1 else 0 := by
    intro l a
    dsimp [cNearZ]
    by_cases ha : a < d
    · rw [dif_pos ha]
      by_cases hal : (⟨a, by omega⟩ : Fin M) = l
      · have hval : a = l.val := congrArg Fin.val hal
        rw [hal, MvPolynomial.pderiv_X_self, map_one, if_pos ⟨by omega, hval⟩]
      · have hval : a ≠ l.val := fun h => hal (Fin.ext h)
        rw [MvPolynomial.pderiv_X_of_ne hal, map_zero, if_neg (by tauto)]
    · rw [dif_neg ha]
      split_ifs <;> simp <;> omega
  have hpFar_x₀ : ∀ (l : Fin M) (b : ℕ),
      MvPolynomial.eval x₀ (MvPolynomial.pderiv l (cFarZ b)) =
        if d + b = l.val then 1 else 0 := by
    intro l b
    have hl : l.val < N_P + 1 := l.isLt
    dsimp [cFarZ]
    by_cases hb : b ≤ N_P - d
    · rw [dif_pos hb]
      by_cases hbl : (⟨d + b, by omega⟩ : Fin M) = l
      · have hval : d + b = l.val := congrArg Fin.val hbl
        rw [hbl, MvPolynomial.pderiv_X_self, map_one, if_pos hval]
      · have hval : d + b ≠ l.val := fun h => hbl (Fin.ext h)
        rw [MvPolynomial.pderiv_X_of_ne hbl, map_zero, if_neg hval]
    · rw [dif_neg hb, map_zero, map_zero, if_neg (by omega)]
  have hF_zero : ∀ m : Fin M, τ_A (MvPolynomial.eval x₀ (F_fac m)) = 0 := by
    intro m
    have hsum : (∑ p ∈ Finset.HasAntidiagonal.antidiagonal m.val,
        (if p.1 = d then (1 : A) else 0) * (if p.2 = 0 then (1 : A) else 0)) =
        if m.val = d then 1 else 0 := by
      by_cases hmd : m.val = d
      · rw [if_pos hmd, Finset.sum_eq_single (d, 0)]
        · simp
        · intro p hp hne
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
          split_ifs with h1 h2
          · exfalso; exact hne (Prod.ext h1 h2)
          · ring
          · ring
          · ring
        · intro hmem
          exfalso; apply hmem
          rw [Finset.HasAntidiagonal.mem_antidiagonal]; omega
      · rw [if_neg hmd]
        apply Finset.sum_eq_zero
        intro p hp
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        split_ifs with h1 h2
        · omega
        · ring
        · ring
        · ring
    have heval : MvPolynomial.eval x₀ (F_fac m) =
        (if m.val = d then (1 : A) else 0) - P.coeff m.val := by
      dsimp [F_fac]
      rw [map_sub, map_sum, MvPolynomial.eval_C]
      simp only [map_mul, hcNear_x₀, hcFar_x₀]
      rw [hsum]
    rw [heval, map_sub]
    have hP_m : τ_A (P.coeff m.val) = if m.val = d then 1 else 0 := by
      have hc := congrArg (fun Q : Polynomial k => Q.coeff m.val) hP
      rw [Polynomial.coeff_map, Polynomial.coeff_X_pow] at hc
      exact hc
    rw [hP_m]
    split_ifs <;> simp
  have hF_jac : ∀ m l : Fin M,
      MvPolynomial.eval x₀ (MvPolynomial.pderiv l (F_fac m)) =
        if m = l then 1 else 0 := by
    intro m l
    have hl : l.val < N_P + 1 := l.isLt
    dsimp [F_fac]
    rw [map_sub, MvPolynomial.pderiv_C, sub_zero, map_sum, map_sum]
    simp only [MvPolynomial.pderiv_mul, map_add, map_mul,
      hcNear_x₀, hcFar_x₀, hpNear_x₀, hpFar_x₀]
    by_cases hld : l.val < d
    · by_cases hml : m = l
      · rw [if_pos hml, Finset.sum_eq_single (l.val, 0)]
        · dsimp only
          have h1 : ¬(l.val = d) := by omega
          have h2 : ¬(d + 0 = l.val) := by omega
          rw [if_pos ⟨hld, rfl⟩, if_pos rfl, if_neg h1, if_neg h2]
          ring
        · intro p hp hne
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
          have h2 : ¬(d + p.2 = l.val) := by omega
          rw [if_neg h2, mul_zero, add_zero]
          split_ifs with h1 h0
          · exfalso; exact hne (Prod.ext h1.2 h0)
          · ring
          · ring
          · ring
        · intro hmem
          exfalso; apply hmem
          rw [Finset.HasAntidiagonal.mem_antidiagonal, hml]; omega
      · rw [if_neg hml]
        apply Finset.sum_eq_zero
        intro p hp
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        have hval : m.val ≠ l.val := fun h => hml (Fin.ext h)
        have h2 : ¬(d + p.2 = l.val) := by omega
        rw [if_neg h2, mul_zero, add_zero]
        split_ifs with h1 h0
        · exfalso; omega
        · ring
        · ring
        · ring
    · by_cases hml : m = l
      · rw [if_pos hml, Finset.sum_eq_single (d, l.val - d)]
        · have h1 : ¬(l.val < d ∧ d = l.val) := by omega
          have h2 : d + (l.val - d) = l.val := by omega
          simp [h1, h2]
        · intro p hp hne
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
          have h1 : ¬(l.val < d ∧ p.1 = l.val) := by omega
          rw [if_neg h1, zero_mul, zero_add]
          split_ifs with hd1 hd2
          · exfalso; exact hne (Prod.ext hd1 (by omega))
          · ring
          · ring
          · ring
        · intro hmem
          exfalso; apply hmem
          rw [Finset.HasAntidiagonal.mem_antidiagonal, hml]; omega
      · rw [if_neg hml]
        apply Finset.sum_eq_zero
        intro p hp
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        have hval : m.val ≠ l.val := fun h => hml (Fin.ext h)
        have h1 : ¬(l.val < d ∧ p.1 = l.val) := by omega
        rw [if_neg h1, zero_mul, zero_add]
        split_ifs with hd1 hd2
        · exfalso; omega
        · ring
        · ring
        · ring
  have hF_det : (Matrix.of fun m l : Fin M =>
      τ_A (MvPolynomial.eval x₀ (MvPolynomial.pderiv l (F_fac m)))).det ≠ 0 := by
    have hmat : (Matrix.of fun m l : Fin M =>
        τ_A (MvPolynomial.eval x₀ (MvPolynomial.pderiv l (F_fac m)))) = 1 := by
      apply Matrix.ext
      intro m l
      rw [Matrix.of_apply, hF_jac, Matrix.one_apply]
      split_ifs <;> simp
    rw [hmat, Matrix.det_one]
    exact one_ne_zero
  obtain ⟨x, hx_res, hx_zero⟩ := hHensel M F_fac x₀ hF_zero hF_det
  let G_near : Polynomial A :=
    ∑ a ∈ Finset.range (d + 1), Polynomial.monomial a (MvPolynomial.eval x (cNearZ a))
  let G_far : Polynomial A :=
    ∑ b ∈ Finset.range (N_P - d + 1), Polynomial.monomial b (MvPolynomial.eval x (cFarZ b))
  have hG_near_coeff : ∀ n : ℕ, G_near.coeff n = MvPolynomial.eval x (cNearZ n) := by
    intro n
    dsimp [G_near]
    rw [Polynomial.finset_sum_coeff]
    simp only [Polynomial.coeff_monomial, Finset.sum_ite_eq', Finset.mem_range]
    by_cases hn : n < d + 1
    · exact if_pos hn
    · rw [if_neg hn]
      dsimp [cNearZ]
      split_ifs <;> simp <;> omega
  have hG_far_coeff : ∀ n : ℕ, G_far.coeff n = MvPolynomial.eval x (cFarZ n) := by
    intro n
    dsimp [G_far]
    rw [Polynomial.finset_sum_coeff]
    simp only [Polynomial.coeff_monomial, Finset.sum_ite_eq', Finset.mem_range]
    by_cases hn : n < N_P - d + 1
    · exact if_pos hn
    · rw [if_neg hn]
      dsimp [cFarZ]
      split_ifs <;> simp <;> omega
  have hG_near_d : G_near.coeff d = 1 := by
    rw [hG_near_coeff]
    dsimp [cNearZ]
    split_ifs <;> simp <;> omega
  have hG_near_gt : ∀ n : ℕ, d < n → G_near.coeff n = 0 := by
    intro n hn
    rw [hG_near_coeff]
    dsimp [cNearZ]
    split_ifs <;> simp <;> omega
  have hDeg : G_near.natDegree = d :=
    Polynomial.natDegree_eq_of_le_of_coeff_ne_zero
      (Polynomial.natDegree_le_iff_coeff_eq_zero.mpr hG_near_gt)
      (by rw [hG_near_d]; exact one_ne_zero)
  have hMonic : G_near.Monic := by
    rw [Polynomial.Monic, Polynomial.leadingCoeff, hDeg, hG_near_d]
  have hEval_res : (τ_A.toRingHom.comp (MvPolynomial.eval x) : MvPolynomial (Fin M) A →+* k) =
      τ_A.toRingHom.comp (MvPolynomial.eval x₀) := by
    apply MvPolynomial.ringHom_ext'
    · ext a; simp
    · intro l; simp [hx_res l]
  have hMapNear : Polynomial.map τ_A.toRingHom G_near = Polynomial.X ^ d := by
    ext n
    rw [Polynomial.coeff_map, hG_near_coeff]
    have h_eq := RingHom.congr_fun hEval_res (cNearZ n)
    dsimp at h_eq
    change τ_A (MvPolynomial.eval x (cNearZ n)) = (Polynomial.X ^ d).coeff n
    rw [h_eq, hcNear_x₀, Polynomial.coeff_X_pow]
    split_ifs <;> simp
  have hMapFar : Polynomial.map τ_A.toRingHom G_far = 1 := by
    ext n
    rw [Polynomial.coeff_map, hG_far_coeff]
    have h_eq := RingHom.congr_fun hEval_res (cFarZ n)
    dsimp at h_eq
    change τ_A (MvPolynomial.eval x (cFarZ n)) = (1 : Polynomial k).coeff n
    rw [h_eq, hcFar_x₀, Polynomial.coeff_one]
    split_ifs <;> simp <;> omega
  have hProd : P = G_near * G_far := by
    ext n
    by_cases hn : n ≤ N_P
    · let m : Fin M := ⟨n, Nat.lt_succ_of_le hn⟩
      have hz := hx_zero m
      dsimp [F_fac, m] at hz
      rw [map_sub, map_sum, MvPolynomial.eval_C] at hz
      simp only [map_mul, ← hG_near_coeff, ← hG_far_coeff] at hz
      rw [← Polynomial.coeff_mul] at hz
      exact (sub_eq_zero.mp hz).symm
    · have hlt : P.natDegree < n := by omega
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt hlt, Polynomial.coeff_mul]
      symm
      apply Finset.sum_eq_zero
      intro p hp
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
      by_cases hp1 : d < p.1
      · rw [hG_near_gt p.1 hp1, zero_mul]
      · have hp2 : ¬(p.2 ≤ N_P - d) := by omega
        have hfar0 : G_far.coeff p.2 = 0 := by
          rw [hG_far_coeff]
          dsimp [cFarZ]
          rw [dif_neg hp2, map_zero]
        rw [hfar0, mul_zero]
  let 𝔪 : Ideal A := IsLocalRing.maximalIdeal A
  have h𝔪_of_τ : ∀ a : A, τ_A a = 0 → a ∈ 𝔪 := by
    intro a ha
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact (hτ_unit a).mp ha
  let I_near : Ideal (Polynomial A) := Ideal.span {G_near}
  let Q_near : Type u := Polynomial A ⧸ I_near
  let q_near : Polynomial A →ₐ[A] Q_near := Ideal.Quotient.mkₐ A I_near
  haveI : Module.Finite A Q_near := Polynomial.Monic.finite_quotient hMonic
  let Δ : Polynomial A := 1 - G_far
  have hΔ_coeff : ∀ j : ℕ, Δ.coeff j ∈ 𝔪 := by
    intro j
    apply h𝔪_of_τ
    have hmapΔ : Polynomial.map τ_A.toRingHom Δ = 0 := by
      change Polynomial.map τ_A.toRingHom (1 - G_far) = 0
      rw [Polynomial.map_sub, Polynomial.map_one, hMapFar, sub_self]
    have hc := congrArg (fun S : Polynomial k => S.coeff j) hmapΔ
    rw [Polynomial.coeff_map, Polynomial.coeff_zero] at hc
    exact hc
  have hΔ_mul_mem : ∀ R : Polynomial A,
      q_near (Δ * R) ∈ 𝔪 • (⊤ : Submodule A Q_near) := by
    intro R
    let H : Polynomial A := Δ * R
    have hH_coeff : ∀ i : ℕ, H.coeff i ∈ 𝔪 := by
      intro i
      dsimp [H]
      rw [Polynomial.coeff_mul]
      refine Submodule.sum_mem 𝔪 ?_
      intro p _
      exact Ideal.mul_mem_right (R.coeff p.2) 𝔪 (hΔ_coeff p.1)
    change q_near H ∈ 𝔪 • (⊤ : Submodule A Q_near)
    rw [Polynomial.as_sum_support_C_mul_X_pow H, map_sum]
    refine Submodule.sum_mem (𝔪 • (⊤ : Submodule A Q_near)) ?_
    intro i _
    have hsmul : Polynomial.C (H.coeff i) * Polynomial.X ^ i =
        (H.coeff i) • (Polynomial.X ^ i : Polynomial A) := by
      rw [Polynomial.smul_eq_C_mul]
    rw [hsmul, map_smul]
    exact Submodule.smul_mem_smul (hH_coeff i) Submodule.mem_top
  let J_far : Ideal Q_near := Ideal.span {q_near G_far}
  let N_sub : Submodule A Q_near := J_far.restrictScalars A
  have hSup : (𝔪 • (⊤ : Submodule A Q_near)) ⊔ N_sub = ⊤ := by
    rw [eq_top_iff]
    intro z _
    obtain ⟨R, rfl⟩ := Ideal.Quotient.mk_surjective z
    change q_near R ∈ (𝔪 • (⊤ : Submodule A Q_near)) ⊔ N_sub
    have hR_eq : R = Δ * R + R * G_far := by
      dsimp [Δ]
      ring
    rw [hR_eq, map_add, map_mul]
    refine Submodule.add_mem_sup (hΔ_mul_mem R) ?_
    change q_near R * q_near G_far ∈ J_far
    exact Ideal.mul_mem_left J_far (q_near R) (Ideal.subset_span rfl)
  have hN_top : N_sub = ⊤ :=
    IsLocalRing.map_mkQ_eq_top.mp ((Submodule.map_mkQ_eq_top _ N_sub).mpr hSup)
  have h1_mem : (1 : Q_near) ∈ J_far := by
    change (1 : Q_near) ∈ N_sub
    rw [hN_top]
    exact Submodule.mem_top
  rw [Ideal.mem_span_singleton] at h1_mem
  obtain ⟨v_Q, hv_Q⟩ := h1_mem
  obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective v_Q
  have hv_mem : 1 - v * G_far ∈ I_near := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    change q_near (1 - v * G_far) = 0
    have hv_Q' : q_near G_far * q_near v = 1 := hv_Q.symm
    rw [map_sub, map_one, map_mul, mul_comm (q_near v) (q_near G_far), hv_Q', sub_self]
  dsimp [I_near] at hv_mem
  rw [Ideal.mem_span_singleton] at hv_mem
  obtain ⟨u, hu⟩ := hv_mem
  have hCoprime : IsCoprime G_near G_far := by
    refine ⟨u, v, ?_⟩
    linear_combination -hu
  exact ⟨G_near, G_far, hMonic, hDeg, hMapNear, hMapFar, hProd, hCoprime⟩

theorem weil_monic_twoChart_serre_section_lifts (k : Type u) [Field k]
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (D : WeilTwoChartRingDatum A)
    (D₀ : WeilTwoChartRingDatum k)
    (red : WeilTwoChartCurveReduction D D₀)
    (hA : WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A)
    (hValid : WeilIsValidTwoChartCurveReduction τ_A D D₀ red)
    (M : WeilTwoChartLineBundle D)
    (hTriv₀ : WeilTwoChartIso D₀ (WeilTwoChartBaseChange red M) (WeilTwoChartTrivial D₀))
    (q : ℕ) (hq : ∀ j : Fin D.r, D.w j ≤ q) :
    letI : Algebra D.R₀ D₀.R₀ := red.algR₀
    letI : Algebra D.R₁ D₀.R₁ := red.algR₁
    let u₀₁ : D.R₀₁ := algebraMap D.R₁ D.R₀₁ (algebraMap (Polynomial A) D.R₁ Polynomial.X)
    let t_bar : D₀.R₀ := algebraMap (Polynomial k) D₀.R₀ Polynomial.X
    let u_bar : D₀.R₁ := algebraMap (Polynomial k) D₀.R₁ Polynomial.X
    let π₀ : D.R₀ →+* D₀.R₀ := algebraMap D.R₀ D₀.R₀
    let π₁ : D.R₁ →+* D₀.R₁ := algebraMap D.R₁ D₀.R₁
    ∃ (lam₀ : M.L₀ →ₗ[D.R₀] D.R₀) (lam₁ : M.L₁ →ₗ[D.R₁] D.R₁)
      (σ₀ : M.L₀) (w_base₀ : M.L₀) (w_base₁ : M.L₁)
      (w_fam₀ : ∀ (j : Fin D.r) (k₀ : ℕ), k₀ + D.w j ≤ q → M.L₀)
      (w_fam₁ : ∀ (j : Fin D.r) (k₀ : ℕ), k₀ + D.w j ≤ q → M.L₁),
      ((∀ x τ : M.L₀, lam₀ x • τ = lam₀ τ • x) ∧
       (∀ y τ : M.L₁, lam₁ y • τ = lam₁ τ • y)) ∧
      π₀ (lam₀ σ₀) = 1 ∧
      (u₀₁ ^ q • M.θ (TensorProduct.tmul D.R₀ (1 : D.R₀₁) w_base₀) =
        TensorProduct.tmul D.R₁ (1 : D.R₀₁) w_base₁ ∧
       π₀ (lam₀ w_base₀) = t_bar ^ q ∧
       π₁ (lam₁ w_base₁) = 1) ∧
      (∀ (j : Fin D.r) (k₀ : ℕ) (hk : k₀ + D.w j ≤ q),
        u₀₁ ^ q • M.θ (TensorProduct.tmul D.R₀ (1 : D.R₀₁) (w_fam₀ j k₀ hk)) =
          TensorProduct.tmul D.R₁ (1 : D.R₀₁) (w_fam₁ j k₀ hk) ∧
        π₀ (lam₀ (w_fam₀ j k₀ hk)) = t_bar ^ k₀ * π₀ (D.b₀ j) ∧
        π₁ (lam₁ (w_fam₁ j k₀ hk)) = u_bar ^ (q - D.w j - k₀) * π₁ (D.b₁ j)) :=
by
  classical
  dsimp only []

  
  have h_inv_lift : ∀ (R R_bar : Type u) [CommRing R] [CommRing R_bar] [Algebra R R_bar],
      Function.Surjective (algebraMap R R_bar) →
      ∀ (L : Type u) [AddCommGroup L] [Module R L] [Module.Invertible R L]
        (e : TensorProduct R R_bar L ≃ₗ[R_bar] R_bar),
        ∃ (lam : L →ₗ[R] R) (σ : L),
          (∀ x τ : L, lam x • τ = lam τ • x) ∧
          (∀ x : L, algebraMap R R_bar (lam x) = e (TensorProduct.tmul R (1 : R_bar) x)) ∧
          algebraMap R R_bar (lam σ) = 1 ∧
          (∀ y_bar : R_bar, ∃ x : L, e (TensorProduct.tmul R (1 : R_bar) x) = y_bar) := by
    intro R R_bar _ _ _ hπ L _ _ _ e
    have h_decomp_all : ∀ z : TensorProduct R (Module.Dual R L) L,
        ∃ (m : ℕ) (f : Fin m → Module.Dual R L) (v : Fin m → L),
          z = ∑ a : Fin m, f a ⊗ₜ[R] v a := by
      intro z
      induction z using TensorProduct.inductionOn with
      | tmul f₀ v₀ =>
        exact ⟨1, fun _ => f₀, fun _ => v₀, by simp⟩
      | add ω₁ ω₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨m₁, f₁, v₁, rfl⟩
        rcases ih₂ with ⟨m₂, f₂, v₂, rfl⟩
        refine ⟨m₁ + m₂, Fin.addCases f₁ f₂, Fin.addCases v₁ v₂, ?_⟩
        rw [Fin.sum_univ_add]
        simp [Fin.addCases]
    have hSymm : ∀ (lam : L →ₗ[R] R) (x τ : L), lam x • τ = lam τ • x := by
      intro lam x τ
      obtain ⟨h_inj, h_surj⟩ := Module.Invertible.bijective (R := R) (M := L)
      obtain ⟨ω, hω⟩ := h_surj (1 : R)
      rcases h_decomp_all ω with ⟨m, f, v, hω_eq⟩
      have hsum1 : (∑ a : Fin m, f a (v a)) = 1 := by
        rw [← hω, hω_eq, map_sum]
        simp [contractLeft_apply]
      have h_rel : ∀ (b : Fin m) (z : L), f b ⊗ₜ[R] z = f b z • ω := by
        intro b z
        apply h_inj
        rw [contractLeft_apply, map_smul, hω, smul_eq_mul, mul_one]
      let d : L := lam x • τ - lam τ • x
      have hd_sq : ∀ b : Fin m, (f b (v b) ^ 2) • d = 0 := by
        intro b
        let E_b : TensorProduct R (Module.Dual R L) L →ₗ[R] L :=
          TensorProduct.lift
            (LinearMap.mk₂ R (fun (φ : Module.Dual R L) (w : L) => φ (v b) • w)
              (fun φ₁ φ₂ w => by simp [add_smul])
              (fun c φ w => by simp [mul_smul])
              (fun φ w₁ w₂ => smul_add (φ (v b)) w₁ w₂)
              (fun c φ w => smul_comm (φ (v b)) c w))
        let u_b : L := E_b ω
        have hu_b : ∀ z : L, f b (v b) • z = f b z • u_b := by
          intro z
          simpa [E_b, u_b] using congrArg E_b (h_rel b z)
        have h_sym : ∀ p q : L, (f b (v b) ^ 2) • (lam p • q) =
            (f b p * lam u_b * f b q) • u_b := by
          intro p q
          calc
            (f b (v b) ^ 2) • (lam p • q)
                = ((f b (v b) * lam p) * f b (v b)) • q := by
                  rw [smul_smul]
                  exact congrArg (· • q) (by ring)
            _ = (f b (v b) * lam p) • (f b (v b) • q) := by rw [mul_smul]
            _ = lam (f b (v b) • p) • (f b (v b) • q) := by rw [map_smul, smul_eq_mul]
            _ = lam (f b p • u_b) • (f b q • u_b) := by rw [hu_b p, hu_b q]
            _ = (f b p * lam u_b * f b q) • u_b := by rw [map_smul, smul_eq_mul, smul_smul]
        dsimp [d]
        rw [smul_sub, h_sym x τ, h_sym τ x, sub_eq_zero]
        exact congrArg (· • u_b) (by ring)
      have h_ind : ∀ s : Finset (Fin m), ((∑ b ∈ s, f b (v b)) ^ (s.card + 1)) • d = 0 := by
        intro s
        induction s using Finset.induction_on with
        | empty => simp
        | @insert b t hb ih =>
          rw [Finset.sum_insert hb, Finset.card_insert_of_notMem hb]
          set r := f b (v b)
          set S := ∑ c ∈ t, f c (v c)
          change ((r + S) ^ (t.card + 2)) • d = 0
          rw [add_pow, Finset.sum_smul]
          apply Finset.sum_eq_zero
          intro k hk
          rw [Finset.mem_range] at hk
          by_cases hk2 : 2 ≤ k
          · have hpw : r ^ k = r ^ (k - 2) * r ^ 2 := by
              rw [← pow_add, Nat.sub_add_cancel hk2]
            have hfactor : r ^ k * S ^ (t.card + 2 - k) * (Nat.choose (t.card + 2) k : R) =
                (r ^ (k - 2) * S ^ (t.card + 2 - k) * (Nat.choose (t.card + 2) k : R)) * r ^ 2 := by
              rw [hpw]; ring
            rw [hfactor, mul_smul, hd_sq b, smul_zero]
          · have hk_le : t.card + 2 - k = (1 - k) + (t.card + 1) := by omega
            have hfactor : r ^ k * S ^ (t.card + 2 - k) * (Nat.choose (t.card + 2) k : R) =
                (r ^ k * S ^ (1 - k) * (Nat.choose (t.card + 2) k : R)) * S ^ (t.card + 1) := by
              rw [hk_le, pow_add]; ring
            rw [hfactor, mul_smul, ih, smul_zero]
      have huniv := h_ind Finset.univ
      rw [hsum1, one_pow, one_smul] at huniv
      exact sub_eq_zero.mp huniv
    have h_tmul_surj : ∀ z : TensorProduct R R_bar L, ∃ x : L, (1 : R_bar) ⊗ₜ[R] x = z := by
      intro z
      induction z using TensorProduct.inductionOn with
      | tmul r_bar y =>
        obtain ⟨r, rfl⟩ := hπ r_bar
        refine ⟨r • y, ?_⟩
        rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
      | add z₁ z₂ ih₁ ih₂ =>
        obtain ⟨x₁, rfl⟩ := ih₁
        obtain ⟨x₂, rfl⟩ := ih₂
        exact ⟨x₁ + x₂, TensorProduct.tmul_add 1 x₁ x₂⟩
    obtain ⟨σ, hσ⟩ := h_tmul_surj (e.symm 1)
    let g_e : L →ₗ[R] R_bar :=
      { toFun := fun x => e ((1 : R_bar) ⊗ₜ[R] x)
        map_add' := fun x y => by rw [TensorProduct.tmul_add, map_add]
        map_smul' := fun r x => by
          dsimp
          rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
          have hsm : (algebraMap R R_bar r) ⊗ₜ[R] x = algebraMap R R_bar r • ((1 : R_bar) ⊗ₜ[R] x) := by
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [hsm, e.map_smul, ← IsScalarTower.algebraMap_smul R_bar r] }
    obtain ⟨lam, hlam⟩ := Module.projective_lifting_property (Algebra.linearMap R R_bar) g_e hπ
    have hlam_eq : ∀ x : L, algebraMap R R_bar (lam x) = e ((1 : R_bar) ⊗ₜ[R] x) :=
      fun x => LinearMap.congr_fun hlam x
    refine ⟨lam, σ, hSymm lam, hlam_eq, ?_, ?_⟩
    · rw [hlam_eq σ, hσ, e.apply_symm_apply]
    · intro y_bar
      obtain ⟨x, hx⟩ := h_tmul_surj (e.symm y_bar)
      exact ⟨x, by rw [hx, e.apply_symm_apply]⟩

  
  rcases hA with ⟨_, hLocalA, hτ_unit, _, _⟩
  rcases hValid with ⟨hValidD, hValid₀, ⟨hr, hw_eq, hb₀_red, hb₁_red⟩,
    hPoly₀, hPoly₁, hSurj₀, hKer₀, hSurj₁, _⟩
  rcases hValidD with ⟨_, _, hΞ₁, hLoc₀, hLoc₁, htu, hc_ov, hb₁_ov⟩
  rcases hValid₀ with ⟨_, hΞ₀_bar, _, hLoc₀_bar, _, htu_bar, hc_ov_bar, hb₁_ov_bar⟩
  rcases hTriv₀ with ⟨e₀, e₁, hθ₀⟩

  have : IsLocalRing A := hLocalA
  let _ : Algebra D.R₀ D₀.R₀ := red.algR₀
  let _ : Algebra D.R₁ D₀.R₁ := red.algR₁
  let _ : Algebra D.R₀₁ D₀.R₀₁ := red.algR₀₁
  let _ : Algebra D.R₀ D₀.R₀₁ := red.algR₀_₀₁
  let _ : Algebra D.R₁ D₀.R₀₁ := red.algR₁_₀₁
  have : IsScalarTower D.R₀ D₀.R₀ D₀.R₀₁ := red.tower₀_bar
  have : IsScalarTower D.R₀ D.R₀₁ D₀.R₀₁ := red.tower₀_loc
  have : IsScalarTower D.R₁ D₀.R₁ D₀.R₀₁ := red.tower₁_bar
  have : IsScalarTower D.R₁ D.R₀₁ D₀.R₀₁ := red.tower₁_loc

  obtain ⟨lam₀, σ₀, hSymm₀, hlam₀, hσ₀, h_e₀_surj⟩ :=
    h_inv_lift D.R₀ D₀.R₀ hSurj₀ M.L₀ e₀
  obtain ⟨lam₁, _, hSymm₁, hlam₁, _, h_e₁_surj⟩ :=
    h_inv_lift D.R₁ D₀.R₁ hSurj₁ M.L₁ e₁

  
  let t : D.R₀ := algebraMap (Polynomial A) D.R₀ Polynomial.X
  let u : D.R₁ := algebraMap (Polynomial A) D.R₁ Polynomial.X
  let ι₀ : D.R₀ →+* D.R₀₁ := algebraMap D.R₀ D.R₀₁
  let ι₁ : D.R₁ →+* D.R₀₁ := algebraMap D.R₁ D.R₀₁
  let t₀₁ : D.R₀₁ := ι₀ t
  let u₀₁ : D.R₀₁ := ι₁ u
  let c₀ : A →+* D.R₀ := (algebraMap (Polynomial A) D.R₀).comp Polynomial.C
  let c₁ : A →+* D.R₁ := (algebraMap (Polynomial A) D.R₁).comp Polynomial.C
  let c₀₁ : A →+* D.R₀₁ := ι₁.comp c₁

  let t_bar : D₀.R₀ := algebraMap (Polynomial k) D₀.R₀ Polynomial.X
  let u_bar : D₀.R₁ := algebraMap (Polynomial k) D₀.R₁ Polynomial.X
  let ι₀_bar : D₀.R₀ →+* D₀.R₀₁ := algebraMap D₀.R₀ D₀.R₀₁
  let ι₁_bar : D₀.R₁ →+* D₀.R₀₁ := algebraMap D₀.R₁ D₀.R₀₁
  let t₀₁_bar : D₀.R₀₁ := ι₀_bar t_bar
  let u₀₁_bar : D₀.R₀₁ := ι₁_bar u_bar
  let c₀_bar : k →+* D₀.R₀ := (algebraMap (Polynomial k) D₀.R₀).comp Polynomial.C
  let c₁_bar : k →+* D₀.R₁ := (algebraMap (Polynomial k) D₀.R₁).comp Polynomial.C
  let c₀₁_bar : k →+* D₀.R₀₁ := ι₁_bar.comp c₁_bar

  let π₀ : D.R₀ →+* D₀.R₀ := algebraMap D.R₀ D₀.R₀
  let π₁ : D.R₁ →+* D₀.R₁ := algebraMap D.R₁ D₀.R₁
  let π₀₁ : D.R₀₁ →+* D₀.R₀₁ := algebraMap D.R₀₁ D₀.R₀₁
  let N₀₁ := TensorProduct D.R₁ D.R₀₁ M.L₁

  have htu_pow : ∀ n : ℕ, t₀₁ ^ n * u₀₁ ^ n = 1 := by
    intro n; rw [← mul_pow, htu, one_pow]
  have hut_pow : ∀ n : ℕ, u₀₁ ^ n * t₀₁ ^ n = 1 := by
    intro n; rw [mul_comm, htu_pow]
  have htu_bar_pow : ∀ n : ℕ, t₀₁_bar ^ n * u₀₁_bar ^ n = 1 := by
    intro n; rw [← mul_pow, htu_bar, one_pow]
  have hut_bar_pow : ∀ n : ℕ, u₀₁_bar ^ n * t₀₁_bar ^ n = 1 := by
    intro n; rw [mul_comm, htu_bar_pow]
  have hc₀₁_eq : ∀ a : A, ι₀ (c₀ a) = c₀₁ a := hc_ov

  have hπ₀₁_ι₀ : ∀ r₀ : D.R₀, π₀₁ (ι₀ r₀) = ι₀_bar (π₀ r₀) := by
    intro r₀
    dsimp [π₀₁, ι₀, ι₀_bar, π₀]
    rw [← IsScalarTower.algebraMap_apply D.R₀ D.R₀₁ D₀.R₀₁,
      IsScalarTower.algebraMap_apply D.R₀ D₀.R₀ D₀.R₀₁]
  have hπ₀₁_ι₁ : ∀ r₁ : D.R₁, π₀₁ (ι₁ r₁) = ι₁_bar (π₁ r₁) := by
    intro r₁
    dsimp [π₀₁, ι₁, ι₁_bar, π₁]
    rw [← IsScalarTower.algebraMap_apply D.R₁ D.R₀₁ D₀.R₀₁,
      IsScalarTower.algebraMap_apply D.R₁ D₀.R₁ D₀.R₀₁]
  have hπ₀_t : π₀ t = t_bar := by
    dsimp [π₀, t, t_bar]; rw [hPoly₀, Polynomial.map_X]
  have hπ₁_u : π₁ u = u_bar := by
    dsimp [π₁, u, u_bar]; rw [hPoly₁, Polynomial.map_X]
  have hπ₀₁_t : π₀₁ t₀₁ = t₀₁_bar := by
    dsimp [t₀₁, t₀₁_bar]; rw [hπ₀₁_ι₀, hπ₀_t]
  have hπ₀₁_u : π₀₁ u₀₁ = u₀₁_bar := by
    dsimp [u₀₁, u₀₁_bar]; rw [hπ₀₁_ι₁, hπ₁_u]
  have hπ₀_c : ∀ a : A, π₀ (c₀ a) = c₀_bar (τ_A a) := by
    intro a; dsimp [π₀, c₀, c₀_bar]; rw [hPoly₀, Polynomial.map_C]; rfl
  have hπ₁_c : ∀ a : A, π₁ (c₁ a) = c₁_bar (τ_A a) := by
    intro a; dsimp [π₁, c₁, c₁_bar]; rw [hPoly₁, Polynomial.map_C]; rfl

  have h_mem_mA : ∀ a : A, a ∈ IsLocalRing.maximalIdeal A ↔ τ_A a = 0 := by
    intro a
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hτ_unit]
  have h_ker_τ : RingHom.ker τ_A.toRingHom = IsLocalRing.maximalIdeal A := by
    ext a; exact (h_mem_mA a).symm

  
  have hLoc_t : ∀ s : D.R₀₁, ∃ (r₀ : D.R₀) (K : ℕ), s * t₀₁ ^ K = ι₀ r₀ := by
    intro s
    obtain ⟨⟨r₀, ⟨_, K, rfl⟩⟩, hs⟩ := @IsLocalization.surj _ _ (Submonoid.powers t) D.R₀₁ _ _ hLoc₀ s
    exact ⟨r₀, K, by simpa [t₀₁, map_pow] using hs⟩
  have hLoc_u : ∀ s : D.R₀₁, ∃ (r₁ : D.R₁) (N : ℕ), s = t₀₁ ^ N * ι₁ r₁ := by
    intro s
    obtain ⟨⟨r₁, ⟨_, N, rfl⟩⟩, hs⟩ := @IsLocalization.surj _ _ (Submonoid.powers u) D.R₀₁ _ _ hLoc₁ s
    have hs' : s * u₀₁ ^ N = ι₁ r₁ := by simpa [u₀₁, map_pow] using hs
    refine ⟨r₁, N, ?_⟩
    calc
      s = s * (u₀₁ ^ N * t₀₁ ^ N) := by rw [hut_pow, mul_one]
      _ = (s * u₀₁ ^ N) * t₀₁ ^ N := by ring
      _ = t₀₁ ^ N * ι₁ r₁ := by rw [hs', mul_comm]
  have hLoc_t_bar : ∀ z₀ : D₀.R₀₁, ∃ (y₀ : D₀.R₀) (K : ℕ), z₀ = u₀₁_bar ^ K * ι₀_bar y₀ := by
    intro z₀
    obtain ⟨⟨y₀, ⟨_, K, rfl⟩⟩, hz⟩ :=
      @IsLocalization.surj _ _ (Submonoid.powers t_bar) D₀.R₀₁ _ _ hLoc₀_bar z₀
    have hz' : z₀ * t₀₁_bar ^ K = ι₀_bar y₀ := by simpa [t₀₁_bar, map_pow] using hz
    refine ⟨y₀, K, ?_⟩
    calc
      z₀ = z₀ * (t₀₁_bar ^ K * u₀₁_bar ^ K) := by rw [htu_bar_pow, mul_one]
      _ = (z₀ * t₀₁_bar ^ K) * u₀₁_bar ^ K := by ring
      _ = u₀₁_bar ^ K * ι₀_bar y₀ := by rw [hz', mul_comm]

  
  let δ_tilde : D₀.R₀ × D₀.R₁ → D₀.R₀₁ :=
    fun p => u₀₁_bar ^ q * ι₀_bar p.1 - ι₁_bar p.2
  have hδ_tilde_surj : Function.Surjective δ_tilde := by
    have h0_mem : (0 : D₀.R₀₁) ∈ Set.range δ_tilde :=
      ⟨(0, 0), by simp [δ_tilde]⟩
    have hadd_mem : ∀ {z₁ z₂ : D₀.R₀₁}, z₁ ∈ Set.range δ_tilde → z₂ ∈ Set.range δ_tilde →
        z₁ + z₂ ∈ Set.range δ_tilde := by
      rintro z₁ z₂ ⟨p₁, rfl⟩ ⟨p₂, rfl⟩
      refine ⟨(p₁.1 + p₂.1, p₁.2 + p₂.2), ?_⟩
      dsimp [δ_tilde]
      rw [map_add, map_add]
      ring
    have hsum_mem : ∀ {α : Type} (s : Finset α) (g : α → D₀.R₀₁),
        (∀ i ∈ s, g i ∈ Set.range δ_tilde) → (∑ i ∈ s, g i) ∈ Set.range δ_tilde := by
      intro α s g hg
      induction s using Finset.cons_induction with
      | empty => simpa using h0_mem
      | cons a s ha ih =>
        rw [Finset.sum_cons]
        exact hadd_mem (hg a (Finset.mem_cons_self a s))
          (ih fun i hi => hg i (Finset.mem_cons_of_mem hi))
    have hsmul_mem : ∀ (c : k) {z : D₀.R₀₁}, z ∈ Set.range δ_tilde →
        c₀₁_bar c * z ∈ Set.range δ_tilde := by
      rintro c z ⟨p, rfl⟩
      refine ⟨(c₀_bar c * p.1, c₁_bar c * p.2), ?_⟩
      dsimp [δ_tilde, c₀₁_bar]
      have hcov : ι₀_bar (c₀_bar c) = ι₁_bar (c₁_bar c) := hc_ov_bar c
      rw [map_mul, map_mul, hcov]
      ring
    have hmon_mem : ∀ (K d : ℕ) (j' : Fin D₀.r),
        u₀₁_bar ^ K * t₀₁_bar ^ d * ι₀_bar (D₀.b₀ j') ∈ Set.range δ_tilde := by
      intro K d j'
      have hw_j' : D₀.w j' ≤ q := by
        let j : Fin D.r := Fin.cast hr.symm j'
        have hj : Fin.cast hr j = j' := by simp [j]
        rw [← hj, ← hw_eq j]
        exact hq j
      by_cases hKd : K ≤ d + q
      · let m' : ℕ := d + q - K
        have hm' : K + m' = d + q := by omega
        refine ⟨(t_bar ^ m' * D₀.b₀ j', 0), ?_⟩
        dsimp [δ_tilde]
        rw [map_zero, sub_zero, map_mul, map_pow]
        change u₀₁_bar ^ q * (t₀₁_bar ^ m' * ι₀_bar (D₀.b₀ j')) = _
        calc
          u₀₁_bar ^ q * (t₀₁_bar ^ m' * ι₀_bar (D₀.b₀ j'))
              = u₀₁_bar ^ q * (u₀₁_bar ^ K * t₀₁_bar ^ K) * t₀₁_bar ^ m' * ι₀_bar (D₀.b₀ j') := by
                rw [hut_bar_pow K]; ring
          _ = u₀₁_bar ^ K * (u₀₁_bar ^ q * t₀₁_bar ^ (K + m')) * ι₀_bar (D₀.b₀ j') := by
                rw [pow_add]; ring
          _ = u₀₁_bar ^ K * (u₀₁_bar ^ q * t₀₁_bar ^ (d + q)) * ι₀_bar (D₀.b₀ j') := by
                rw [hm']
          _ = u₀₁_bar ^ K * ((u₀₁_bar ^ q * t₀₁_bar ^ q) * t₀₁_bar ^ d) * ι₀_bar (D₀.b₀ j') := by
                rw [pow_add]; ring
          _ = u₀₁_bar ^ K * t₀₁_bar ^ d * ι₀_bar (D₀.b₀ j') := by
                rw [hut_bar_pow q]; ring
      · let m'' : ℕ := K - d - D₀.w j'
        have hm'' : m'' + D₀.w j' + d = K := by omega
        refine ⟨(0, -(u_bar ^ m'' * D₀.b₁ j')), ?_⟩
        dsimp [δ_tilde]
        rw [map_zero, mul_zero, zero_sub, map_neg, neg_neg, map_mul, map_pow]
        change u₀₁_bar ^ m'' * ι₁_bar (D₀.b₁ j') = _
        calc
          u₀₁_bar ^ m'' * ι₁_bar (D₀.b₁ j')
              = u₀₁_bar ^ m'' * (u₀₁_bar ^ (D₀.w j') * ι₀_bar (D₀.b₀ j')) := by
                rw [hb₁_ov_bar j']
          _ = u₀₁_bar ^ m'' * u₀₁_bar ^ (D₀.w j') * (u₀₁_bar ^ d * t₀₁_bar ^ d) *
                ι₀_bar (D₀.b₀ j') := by
                rw [hut_bar_pow d]; ring
          _ = u₀₁_bar ^ (m'' + D₀.w j' + d) * t₀₁_bar ^ d * ι₀_bar (D₀.b₀ j') := by
                rw [pow_add, pow_add]; ring
          _ = u₀₁_bar ^ K * t₀₁_bar ^ d * ι₀_bar (D₀.b₀ j') := by
                rw [hm'']
    intro z₀
    obtain ⟨y₀, K, rfl⟩ := hLoc_t_bar z₀
    obtain ⟨f, rfl⟩ := hΞ₀_bar.surjective y₀
    have hexp : u₀₁_bar ^ K * ι₀_bar (∑ j' : Fin D₀.r, algebraMap (Polynomial k) D₀.R₀ (f j') * D₀.b₀ j') =
        ∑ j' : Fin D₀.r, ∑ d ∈ Finset.range ((f j').natDegree + 1),
          c₀₁_bar ((f j').coeff d) * (u₀₁_bar ^ K * t₀₁_bar ^ d * ι₀_bar (D₀.b₀ j')) := by
      rw [map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j' _ => ?_
      conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow (f j')]
      rw [map_sum, Finset.sum_mul, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun d _ => ?_
      have hc_eq : ι₀_bar (algebraMap (Polynomial k) D₀.R₀ (Polynomial.C ((f j').coeff d))) =
          c₀₁_bar ((f j').coeff d) := hc_ov_bar ((f j').coeff d)
      simp only [map_mul, map_pow, hc_eq]
      change u₀₁_bar ^ K * (c₀₁_bar ((f j').coeff d) * t₀₁_bar ^ d * ι₀_bar (D₀.b₀ j')) = _
      ring
    rw [hexp]
    refine hsum_mem (Finset.univ : Finset (Fin D₀.r)) _ ?_
    intro j' _
    refine hsum_mem (Finset.range ((f j').natDegree + 1)) _ ?_
    intro d _
    exact hsmul_mem ((f j').coeff d) (hmon_mem K d j')

  
  have hSurj₀₁ : Function.Surjective π₀₁ := by
    intro z₀
    obtain ⟨y₀, K, rfl⟩ := hLoc_t_bar z₀
    obtain ⟨x₀, hx₀⟩ := hSurj₀ y₀
    refine ⟨u₀₁ ^ K * ι₀ x₀, ?_⟩
    rw [map_mul, map_pow, hπ₀₁_u, hπ₀₁_ι₀, hx₀]
  have hι₀_bar_inj0 : ∀ x₀_bar : D₀.R₀, ι₀_bar x₀_bar = 0 → x₀_bar = 0 := by
    intro x₀_bar hx₀
    have hmem : ∃ m : Submonoid.powers t_bar, m.1 * x₀_bar = 0 :=
      (@IsLocalization.map_eq_zero_iff D₀.R₀ _ (Submonoid.powers t_bar) D₀.R₀₁ _ _ hLoc₀_bar x₀_bar).mp hx₀
    rcases hmem with ⟨⟨_, N, rfl⟩, hm_zero⟩
    obtain ⟨f, rfl⟩ := hΞ₀_bar.surjective x₀_bar
    have hf_eq : (∑ j' : Fin D₀.r, algebraMap (Polynomial k) D₀.R₀ (Polynomial.X ^ N * f j') * D₀.b₀ j') =
        ∑ j' : Fin D₀.r, algebraMap (Polynomial k) D₀.R₀ 0 * D₀.b₀ j' := by
      calc
        (∑ j' : Fin D₀.r, algebraMap (Polynomial k) D₀.R₀ (Polynomial.X ^ N * f j') * D₀.b₀ j')
            = t_bar ^ N * ∑ j' : Fin D₀.r, algebraMap (Polynomial k) D₀.R₀ (f j') * D₀.b₀ j' := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl fun j' _ => ?_
              simp [t_bar, map_mul, map_pow, mul_assoc]
        _ = 0 := hm_zero
        _ = ∑ j' : Fin D₀.r, algebraMap (Polynomial k) D₀.R₀ 0 * D₀.b₀ j' := by simp
    have hf0 : (fun j' : Fin D₀.r => Polynomial.X ^ N * f j') = fun _ => 0 :=
      hΞ₀_bar.injective hf_eq
    have hf_zero : f = 0 := by
      ext j' d
      have hjd := congrArg (fun g : Fin D₀.r → Polynomial k => (g j').coeff (d + N)) hf0
      simpa [Polynomial.coeff_X_pow_mul] using hjd
    subst hf_zero
    simp
  have hKer₀₁ : RingHom.ker π₀₁ = Ideal.map c₀₁ (IsLocalRing.maximalIdeal A) := by
    apply le_antisymm
    · intro z hz
      rw [RingHom.mem_ker] at hz
      obtain ⟨r₀, K, hs⟩ := hLoc_t z
      have hπr₀_loc : ι₀_bar (π₀ r₀) = 0 := by
        rw [← hπ₀₁_ι₀, ← hs, map_mul, hz, zero_mul]
      have hr₀_ker : r₀ ∈ RingHom.ker π₀ := hι₀_bar_inj0 (π₀ r₀) hπr₀_loc
      rw [hKer₀, h_ker_τ] at hr₀_ker
      have hιr₀_mem : ι₀ r₀ ∈ Ideal.map c₀₁ (IsLocalRing.maximalIdeal A) := by
        have hcomp : ι₀.comp c₀ = c₀₁ := RingHom.ext hc₀₁_eq
        rw [← hcomp, ← Ideal.map_map]
        exact Ideal.mem_map_of_mem ι₀ hr₀_ker
      have hz_eq : z = ι₀ r₀ * u₀₁ ^ K := by
        calc
          z = z * (t₀₁ ^ K * u₀₁ ^ K) := by rw [htu_pow K, mul_one]
          _ = (z * t₀₁ ^ K) * u₀₁ ^ K := by ring
          _ = ι₀ r₀ * u₀₁ ^ K := by rw [hs]
      rw [hz_eq]
      exact Ideal.mul_mem_right (u₀₁ ^ K) _ hιr₀_mem
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker]
      have ha0 : τ_A a = 0 := (h_mem_mA a).mp ha
      dsimp [c₀₁]
      rw [hπ₀₁_ι₁, hπ₁_c, ha0, map_zero, map_zero]

  
  have h_Φ_pkg : ∀ {R₀ R₁ R₀₁ R₀_bar R₁_bar R₀₁_bar : Type u}
      [CommRing R₀] [CommRing R₁] [CommRing R₀₁]
      [CommRing R₀_bar] [CommRing R₁_bar] [CommRing R₀₁_bar]
      [Algebra R₀ R₀₁] [Algebra R₁ R₀₁]
      [Algebra R₀_bar R₀₁_bar] [Algebra R₁_bar R₀₁_bar]
      [Algebra R₀ R₀_bar] [Algebra R₁ R₁_bar] [Algebra R₀₁ R₀₁_bar]
      [Algebra R₀ R₀₁_bar] [Algebra R₁ R₀₁_bar]
      [IsScalarTower R₀ R₀_bar R₀₁_bar] [IsScalarTower R₀ R₀₁ R₀₁_bar]
      [IsScalarTower R₁ R₁_bar R₀₁_bar] [IsScalarTower R₁ R₀₁ R₀₁_bar]
      {L₀ L₁ : Type u} [AddCommGroup L₀] [Module R₀ L₀] [AddCommGroup L₁] [Module R₁ L₁]
      (θ : TensorProduct R₀ R₀₁ L₀ ≃ₗ[R₀₁] TensorProduct R₁ R₀₁ L₁)
      (e₀' : TensorProduct R₀ R₀_bar L₀ ≃ₗ[R₀_bar] R₀_bar)
      (e₁' : TensorProduct R₁ R₁_bar L₁ ≃ₗ[R₁_bar] R₁_bar),
      (LinearEquiv.baseChange R₀_bar R₀₁_bar _ _ e₀').trans
          ((TensorProduct.AlgebraTensorModule.rid R₀_bar R₀₁_bar R₀₁_bar).trans
            (TensorProduct.AlgebraTensorModule.rid R₁_bar R₀₁_bar R₀₁_bar).symm) =
        (((TensorProduct.AlgebraTensorModule.cancelBaseChange R₀ R₀_bar R₀₁_bar R₀₁_bar L₀).trans
            (TensorProduct.AlgebraTensorModule.cancelBaseChange R₀ R₀₁ R₀₁_bar R₀₁_bar L₀).symm).trans
          ((LinearEquiv.baseChange R₀₁ R₀₁_bar _ _ θ).trans
            ((TensorProduct.AlgebraTensorModule.cancelBaseChange R₁ R₁_bar R₀₁_bar R₀₁_bar L₁).trans
              (TensorProduct.AlgebraTensorModule.cancelBaseChange R₁ R₀₁ R₀₁_bar R₀₁_bar L₁).symm).symm)).trans
          (LinearEquiv.baseChange R₁_bar R₀₁_bar _ _ e₁') →
      ∃ Φ : TensorProduct R₁ R₀₁ L₁ → R₀₁_bar,
        (∀ w₁ w₂, Φ (w₁ - w₂) = Φ w₁ - Φ w₂) ∧
        (∀ (r₀₁ : R₀₁) w, Φ (r₀₁ • w) = algebraMap R₀₁ R₀₁_bar r₀₁ * Φ w) ∧
        (∀ x₁ : L₁, Φ ((1 : R₀₁) ⊗ₜ[R₁] x₁) =
          algebraMap R₁_bar R₀₁_bar (e₁' ((1 : R₁_bar) ⊗ₜ[R₁] x₁))) ∧
        (∀ x₀ : L₀, Φ (θ ((1 : R₀₁) ⊗ₜ[R₀] x₀)) =
          algebraMap R₀_bar R₀₁_bar (e₀' ((1 : R₀_bar) ⊗ₜ[R₀] x₀))) ∧
        (∀ w, Φ w = 0 → (1 : R₀₁_bar) ⊗ₜ[R₀₁] w = 0) := by
    intro R₀ R₁ R₀₁ R₀_bar R₁_bar R₀₁_bar _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
      L₀ L₁ _ _ _ _ θ e₀' e₁' hθ'
    let Ψ : TensorProduct R₀₁ R₀₁_bar (TensorProduct R₁ R₀₁ L₁) ≃ₗ[R₀₁_bar] R₀₁_bar :=
      ((TensorProduct.AlgebraTensorModule.cancelBaseChange R₁ R₀₁ R₀₁_bar R₀₁_bar L₁).trans
        (TensorProduct.AlgebraTensorModule.cancelBaseChange R₁ R₁_bar R₀₁_bar R₀₁_bar L₁).symm).trans
        ((LinearEquiv.baseChange R₁_bar R₀₁_bar _ _ e₁').trans
          (TensorProduct.AlgebraTensorModule.rid R₁_bar R₀₁_bar R₀₁_bar))
    refine ⟨fun w => Ψ ((1 : R₀₁_bar) ⊗ₜ[R₀₁] w), ?_, ?_, ?_, ?_, ?_⟩
    · intro w₁ w₂
      dsimp
      rw [TensorProduct.tmul_sub, map_sub]
    · intro r₀₁ w
      dsimp
      rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
      have hsm : algebraMap R₀₁ R₀₁_bar r₀₁ ⊗ₜ[R₀₁] w =
          algebraMap R₀₁ R₀₁_bar r₀₁ • ((1 : R₀₁_bar) ⊗ₜ[R₀₁] w) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [hsm, Ψ.map_smul, smul_eq_mul]
    · intro x₁
      dsimp [Ψ]
      rw [one_smul, Algebra.smul_def, mul_one]
    · intro x₀
      dsimp [Ψ]
      have h_ev := congrArg (TensorProduct.AlgebraTensorModule.rid R₁_bar R₀₁_bar R₀₁_bar)
        (LinearEquiv.congr_fun hθ' ((1 : R₀₁_bar) ⊗ₜ[R₀_bar] ((1 : R₀_bar) ⊗ₜ[R₀] x₀)))
      simp only [LinearEquiv.trans_apply, LinearEquiv.symm_trans_apply, LinearEquiv.symm_symm,
        LinearEquiv.baseChange_tmul,
        TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul,
        TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul,
        TensorProduct.AlgebraTensorModule.rid_tmul,
        LinearEquiv.apply_symm_apply,
        Algebra.smul_def, map_one, mul_one] at h_ev
      exact h_ev.symm
    · intro w hw
      exact Ψ.injective (by simpa using hw)

  obtain ⟨Φ₀₁, hΦ_sub, hΦ_smul, hΦ_tmul₁, hΦ_θ₀, hΦ_inj0⟩ :=
    h_Φ_pkg M.θ e₀ e₁ hθ₀
  have hΦ_ker_I : ∀ w : N₀₁, Φ₀₁ w = 0 →
      w ∈ (Ideal.map c₀₁ (IsLocalRing.maximalIdeal A)) • (⊤ : Submodule D.R₀₁ N₀₁) := by
    let I₀₁ : Ideal D.R₀₁ := RingHom.ker π₀₁
    let K₀₁ : Submodule D.R₀₁ N₀₁ := I₀₁ • (⊤ : Submodule D.R₀₁ N₀₁)
    let q_I : N₀₁ →ₗ[D.R₀₁] (N₀₁ ⧸ K₀₁) := K₀₁.mkQ
    have h_wd : ∀ (r₁ r₂ : D.R₀₁) (n : N₀₁),
        π₀₁ r₁ = π₀₁ r₂ → r₁ • q_I n = r₂ • q_I n := by
      intro r₁ r₂ n h_eq
      have hdiff : r₁ - r₂ ∈ I₀₁ := by
        rw [RingHom.mem_ker, map_sub, h_eq, sub_self]
      have hzero : q_I ((r₁ - r₂) • n) = 0 := by
        rw [← LinearMap.mem_ker, Submodule.ker_mkQ]
        exact Submodule.smul_mem_smul hdiff trivial
      rw [← sub_eq_zero, ← sub_smul, ← map_smul]
      exact hzero
    let B_lift : D₀.R₀₁ →ₗ[D.R₀₁] N₀₁ →ₗ[D.R₀₁] (N₀₁ ⧸ K₀₁) :=
      LinearMap.mk₂ D.R₀₁
        (fun s_bar n => (hSurj₀₁ s_bar).choose • q_I n)
        (fun s₁ s₂ n => by
          have h12 : π₀₁ (hSurj₀₁ (s₁ + s₂)).choose =
              π₀₁ ((hSurj₀₁ s₁).choose + (hSurj₀₁ s₂).choose) := by
            rw [map_add, (hSurj₀₁ (s₁ + s₂)).choose_spec,
              (hSurj₀₁ s₁).choose_spec, (hSurj₀₁ s₂).choose_spec]
          rw [h_wd _ _ n h12, add_smul])
        (fun c s n => by
          have hcs : π₀₁ (hSurj₀₁ (c • s)).choose = π₀₁ (c * (hSurj₀₁ s).choose) := by
            rw [map_mul, (hSurj₀₁ (c • s)).choose_spec,
              (hSurj₀₁ s).choose_spec, Algebra.smul_def]
          rw [h_wd _ _ n hcs, mul_smul])
        (fun s n₁ n₂ => by rw [map_add, smul_add])
        (fun c s n => by rw [map_smul, smul_comm])
    let T_lift : TensorProduct D.R₀₁ D₀.R₀₁ N₀₁ →ₗ[D.R₀₁] (N₀₁ ⧸ K₀₁) :=
      TensorProduct.lift B_lift
    intro w hw
    have h_ten0 : (1 : D₀.R₀₁) ⊗ₜ[D.R₀₁] w = 0 := hΦ_inj0 w hw
    have hq0 : q_I w = 0 := by
      have h1 : T_lift ((1 : D₀.R₀₁) ⊗ₜ[D.R₀₁] w) = q_I w := by
        change (hSurj₀₁ 1).choose • q_I w = q_I w
        have h1_eq : π₀₁ (hSurj₀₁ 1).choose = π₀₁ 1 := by
          rw [(hSurj₀₁ 1).choose_spec, map_one]
        rw [h_wd _ 1 w h1_eq, one_smul]
      rw [← h1, h_ten0, map_zero]
    have hmem_I : w ∈ K₀₁ :=
      (Submodule.ker_mkQ K₀₁) ▸ LinearMap.mem_ker.mpr hq0
    dsimp [K₀₁, I₀₁] at hmem_I
    rwa [hKer₀₁] at hmem_I

  
  have h_clear_all : ∀ z₀ : TensorProduct D.R₀ D.R₀₁ M.L₀,
      ∃ (K : ℕ) (x₀ : M.L₀), t₀₁ ^ K • z₀ = (1 : D.R₀₁) ⊗ₜ[D.R₀] x₀ := by
    intro z₀
    induction z₀ using TensorProduct.inductionOn with
    | tmul s m =>
      obtain ⟨r₀, K, hs⟩ := hLoc_t s
      refine ⟨K, r₀ • m, ?_⟩
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_comm, hs,
        ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
    | add z₁ z₂ ih₁ ih₂ =>
      obtain ⟨K₁, x₁, hx₁⟩ := ih₁
      obtain ⟨K₂, x₂, hx₂⟩ := ih₂
      refine ⟨K₁ + K₂, t ^ K₂ • x₁ + t ^ K₁ • x₂, ?_⟩
      have h₁ : t₀₁ ^ (K₁ + K₂) • z₁ = (1 : D.R₀₁) ⊗ₜ[D.R₀] (t ^ K₂ • x₁) := by
        rw [add_comm K₁ K₂, pow_add, mul_smul, hx₁, ← TensorProduct.smul_tmul,
          Algebra.smul_def, mul_one, TensorProduct.smul_tmul', smul_eq_mul, mul_one, map_pow]
      have h₂ : t₀₁ ^ (K₁ + K₂) • z₂ = (1 : D.R₀₁) ⊗ₜ[D.R₀] (t ^ K₁ • x₂) := by
        rw [pow_add, mul_smul, hx₂, ← TensorProduct.smul_tmul,
          Algebra.smul_def, mul_one, TensorProduct.smul_tmul', smul_eq_mul, mul_one, map_pow]
      rw [smul_add, h₁, h₂, TensorProduct.tmul_add]
  obtain ⟨b, v₁, hv₁_span⟩ := Module.Finite.exists_fin (R := D.R₁) (M := M.L₁)
  let K_fn : Fin b → ℕ := fun β => (h_clear_all (M.θ.symm ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β))).choose
  let x₀_fn : Fin b → M.L₀ := fun β =>
    (h_clear_all (M.θ.symm ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β))).choose_spec.choose
  have hK_fn : ∀ β : Fin b,
      t₀₁ ^ (K_fn β) • M.θ.symm ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β) = (1 : D.R₀₁) ⊗ₜ[D.R₀] x₀_fn β :=
    fun β => (h_clear_all (M.θ.symm ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β))).choose_spec.choose_spec
  let K₀ : ℕ := Finset.univ.sup K_fn
  let v₀_tilde : Fin b → M.L₀ := fun β => t ^ (K₀ - K_fn β) • x₀_fn β
  have hv₁_θ : ∀ β : Fin b,
      (1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β = u₀₁ ^ K₀ • M.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] v₀_tilde β) := by
    intro β
    have hle : K_fn β ≤ K₀ := Finset.le_sup (f := K_fn) (Finset.mem_univ β)
    have hK_eq : K₀ = (K₀ - K_fn β) + K_fn β := (Nat.sub_add_cancel hle).symm
    have ht_clear : t₀₁ ^ K₀ • M.θ.symm ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β) =
        (1 : D.R₀₁) ⊗ₜ[D.R₀] v₀_tilde β := by
      calc
        t₀₁ ^ K₀ • M.θ.symm ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β)
            = t₀₁ ^ (K₀ - K_fn β) • (t₀₁ ^ (K_fn β) • M.θ.symm ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β)) := by
              rw [← mul_smul, ← pow_add, ← hK_eq]
        _ = t₀₁ ^ (K₀ - K_fn β) • ((1 : D.R₀₁) ⊗ₜ[D.R₀] x₀_fn β) := by rw [hK_fn β]
        _ = (1 : D.R₀₁) ⊗ₜ[D.R₀] v₀_tilde β := by
              dsimp [v₀_tilde]
              rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
                TensorProduct.smul_tmul', smul_eq_mul, mul_one, map_pow]
    have hθ_eq := congrArg M.θ ht_clear
    rw [M.θ.map_smul, M.θ.apply_symm_apply] at hθ_eq
    calc
      (1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β
          = (u₀₁ ^ K₀ * t₀₁ ^ K₀) • ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β) := by
            rw [hut_pow K₀, one_smul]
      _ = u₀₁ ^ K₀ • (t₀₁ ^ K₀ • ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β)) := by rw [mul_smul]
      _ = u₀₁ ^ K₀ • M.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] v₀_tilde β) := by rw [hθ_eq]

  
  have h_lift_pair : ∀ (x₀_bar : D₀.R₀) (x₁_bar : D₀.R₁),
      u₀₁_bar ^ q * ι₀_bar x₀_bar = ι₁_bar x₁_bar →
      ∃ (w₀ : M.L₀) (w₁ : M.L₁),
        u₀₁ ^ q • M.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] w₀) = (1 : D.R₀₁) ⊗ₜ[D.R₁] w₁ ∧
        π₀ (lam₀ w₀) = x₀_bar ∧
        π₁ (lam₁ w₁) = x₁_bar := by
    let _ : Module A M.L₀ := Module.compHom M.L₀ c₀
    let _ : Module A M.L₁ := Module.compHom M.L₁ c₁
    let _ : Module A N₀₁ := Module.compHom N₀₁ c₀₁
    let δ_q : M.L₀ × M.L₁ →ₗ[A] N₀₁ :=
      { toFun := fun p => u₀₁ ^ q • M.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] p.1) - (1 : D.R₀₁) ⊗ₜ[D.R₁] p.2
        map_add' := fun p₁ p₂ => by
          simp only [Prod.fst_add, Prod.snd_add, TensorProduct.tmul_add, map_add, smul_add]
          abel
        map_smul' := fun a p => by
          dsimp
          have h0 : (1 : D.R₀₁) ⊗ₜ[D.R₀] (c₀ a • p.1) = c₀₁ a • ((1 : D.R₀₁) ⊗ₜ[D.R₀] p.1) := by
            rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
              TensorProduct.smul_tmul', smul_eq_mul, mul_one]
            exact congrArg (· ⊗ₜ[D.R₀] p.1) (hc₀₁_eq a)
          have h1 : (1 : D.R₀₁) ⊗ₜ[D.R₁] (c₁ a • p.2) = c₀₁ a • ((1 : D.R₀₁) ⊗ₜ[D.R₁] p.2) := by
            rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
              TensorProduct.smul_tmul', smul_eq_mul, mul_one]
            rfl
          change u₀₁ ^ q • M.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] (c₀ a • p.1)) -
              (1 : D.R₀₁) ⊗ₜ[D.R₁] (c₁ a • p.2) =
            c₀₁ a • (u₀₁ ^ q • M.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] p.1) - (1 : D.R₀₁) ⊗ₜ[D.R₁] p.2)
          rw [h0, h1, M.θ.map_smul, smul_comm (u₀₁ ^ q) (c₀₁ a), smul_sub] }
    have hΦ_δ : ∀ (x₀ : M.L₀) (x₁ : M.L₁) (x₀_b : D₀.R₀) (x₁_b : D₀.R₁),
        e₀ ((1 : D₀.R₀) ⊗ₜ[D.R₀] x₀) = x₀_b →
        e₁ ((1 : D₀.R₁) ⊗ₜ[D.R₁] x₁) = x₁_b →
        Φ₀₁ (δ_q (x₀, x₁)) = δ_tilde (x₀_b, x₁_b) := by
      intro x₀ x₁ x₀_b x₁_b hx₀ hx₁
      change Φ₀₁ (u₀₁ ^ q • M.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] x₀) - (1 : D.R₀₁) ⊗ₜ[D.R₁] x₁) =
        u₀₁_bar ^ q * ι₀_bar x₀_b - ι₁_bar x₁_b
      rw [hΦ_sub, hΦ_smul, map_pow, hπ₀₁_u, hΦ_θ₀, hΦ_tmul₁]
      exact congrArg₂ (fun a b => u₀₁_bar ^ q * a - b)
        (congrArg ι₀_bar hx₀) (congrArg ι₁_bar hx₁)
    have hΦ_ker_mA : ∀ w : N₀₁, Φ₀₁ w = 0 →
        w ∈ (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A N₀₁) := by
      intro w hw
      have hmem_I := hΦ_ker_I w hw
      refine Submodule.smul_induction_on hmem_I ?_ ?_
      · intro r hr n _
        change r ∈ Ideal.span (c₀₁ '' (IsLocalRing.maximalIdeal A : Set A)) at hr
        induction hr using Submodule.span_induction generalizing n with
        | mem x hx =>
          rcases hx with ⟨a, ha, rfl⟩
          exact Submodule.smul_mem_smul ha trivial
        | zero =>
          change (0 : D.R₀₁) • n ∈ _
          rw [zero_smul]; exact zero_mem _
        | add x y _ _ ihx ihy =>
          change (x + y) • n ∈ _
          rw [add_smul]; exact add_mem (ihx n trivial) (ihy n trivial)
        | smul s x _ ih =>
          change (s * x) • n ∈ _
          rw [mul_comm, mul_smul]; exact ih (s • n) trivial
      · intro x y hx hy
        exact add_mem hx hy

    
    let Q := N₀₁ ⧸ LinearMap.range δ_q
    let mkQ : N₀₁ →ₗ[A] Q := (LinearMap.range δ_q).mkQ
    have hmkQ_δ : ∀ p : M.L₀ × M.L₁, mkQ (δ_q p) = 0 := by
      intro p
      rw [← LinearMap.mem_ker, Submodule.ker_mkQ]
      exact LinearMap.mem_range_self δ_q p
    have hFinQ : Module.Finite A Q := by
      let W_max : ℕ := Finset.univ.sup D.w
      let S_idx : Finset (ℕ × Fin D.r × Fin b) :=
        Finset.range (K₀ + W_max) ×ˢ (Finset.univ ×ˢ Finset.univ)
      let S_fin : Finset Q :=
        S_idx.image fun p => mkQ ((t₀₁ ^ (p.1 + 1) * ι₁ (D.b₁ p.2.1)) • ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ p.2.2))
      let W_span : Submodule A Q := Submodule.span A (S_fin : Set Q)
      have hmon_Q : ∀ (N d : ℕ) (j : Fin D.r) (β : Fin b),
          mkQ ((t₀₁ ^ N * u₀₁ ^ d * ι₁ (D.b₁ j)) • ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β)) ∈ W_span := by
        intro N d j β
        by_cases hNd : N ≤ d
        · have hd_eq : d = N + (d - N) := by omega
          have hpow_eq : t₀₁ ^ N * u₀₁ ^ d * ι₁ (D.b₁ j) = ι₁ (u ^ (d - N) * D.b₁ j) := by
            calc
              t₀₁ ^ N * u₀₁ ^ d * ι₁ (D.b₁ j)
                  = (t₀₁ ^ N * u₀₁ ^ N) * u₀₁ ^ (d - N) * ι₁ (D.b₁ j) := by
                    conv_lhs => rw [hd_eq, pow_add]
                    ring
              _ = u₀₁ ^ (d - N) * ι₁ (D.b₁ j) := by rw [htu_pow N, one_mul]
              _ = ι₁ (u ^ (d - N) * D.b₁ j) := by simp [u₀₁, map_mul, map_pow]
          have hz_eq : (t₀₁ ^ N * u₀₁ ^ d * ι₁ (D.b₁ j)) • ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β) =
              δ_q (0, -((u ^ (d - N) * D.b₁ j) • v₁ β)) := by
            rw [hpow_eq]
            dsimp [δ_q]
            rw [TensorProduct.tmul_zero, map_zero, smul_zero, zero_sub,
              TensorProduct.tmul_neg, neg_neg, ← TensorProduct.smul_tmul,
              Algebra.smul_def, mul_one, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [hz_eq, hmkQ_δ]
          exact zero_mem W_span
        · by_cases h_deep : d + K₀ + D.w j ≤ N
          · let k_exp : ℕ := N - (d + K₀ + D.w j)
            let m' : ℕ := k_exp + q
            have hN_eq : N = k_exp + (d + K₀ + D.w j) := by omega
            have hz_eq : (t₀₁ ^ N * u₀₁ ^ d * ι₁ (D.b₁ j)) • ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β) =
                δ_q ((t ^ m' * D.b₀ j) • v₀_tilde β, 0) := by
              rw [hv₁_θ β, hb₁_ov j, smul_smul]
              have hscalar : t₀₁ ^ N * u₀₁ ^ d * (u₀₁ ^ (D.w j) * ι₀ (D.b₀ j)) * u₀₁ ^ K₀ =
                  u₀₁ ^ q * ι₀ (t ^ m' * D.b₀ j) := by
                calc
                  t₀₁ ^ N * u₀₁ ^ d * (u₀₁ ^ (D.w j) * ι₀ (D.b₀ j)) * u₀₁ ^ K₀
                      = t₀₁ ^ k_exp * (t₀₁ ^ (d + K₀ + D.w j) * u₀₁ ^ (d + K₀ + D.w j)) *
                          ι₀ (D.b₀ j) := by
                        rw [hN_eq, pow_add, pow_add, pow_add]; ring
                  _ = (u₀₁ ^ q * t₀₁ ^ q) * t₀₁ ^ k_exp * ι₀ (D.b₀ j) := by
                        rw [htu_pow, hut_pow q]; ring
                  _ = u₀₁ ^ q * (t₀₁ ^ m' * ι₀ (D.b₀ j)) := by
                        dsimp [m']; rw [pow_add]; ring
                  _ = u₀₁ ^ q * ι₀ (t ^ m' * D.b₀ j) := by simp [t₀₁, map_mul, map_pow]
              have htm : ι₀ (t ^ m' * D.b₀ j) • ((1 : D.R₀₁) ⊗ₜ[D.R₀] v₀_tilde β) =
                  (1 : D.R₀₁) ⊗ₜ[D.R₀] ((t ^ m' * D.b₀ j) • v₀_tilde β) := by
                rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
                symm
                rw [← TensorProduct.smul_tmul (t ^ m' * D.b₀ j) (1 : D.R₀₁) (v₀_tilde β),
                  Algebra.smul_def, mul_one]
              rw [hscalar, mul_smul, ← M.θ.map_smul, htm]
              change u₀₁ ^ q • M.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] ((t ^ m' * D.b₀ j) • v₀_tilde β)) =
                u₀₁ ^ q • M.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] ((t ^ m' * D.b₀ j) • v₀_tilde β)) -
                  (1 : D.R₀₁) ⊗ₜ[D.R₁] 0
              rw [TensorProduct.tmul_zero, sub_zero]
            rw [hz_eq, hmkQ_δ]
            exact zero_mem W_span
          · let s₀ : ℕ := N - d - 1
            have hN_eq : N = (s₀ + 1) + d := by omega
            have hw_le : D.w j ≤ W_max := Finset.le_sup (f := D.w) (Finset.mem_univ j)
            have hs₀_lt : s₀ < K₀ + W_max := by omega
            have hpow_eq : t₀₁ ^ N * u₀₁ ^ d = t₀₁ ^ (s₀ + 1) := by
              calc
                t₀₁ ^ N * u₀₁ ^ d = t₀₁ ^ (s₀ + 1) * (t₀₁ ^ d * u₀₁ ^ d) := by
                  rw [hN_eq, pow_add]; ring
                _ = t₀₁ ^ (s₀ + 1) := by rw [htu_pow d, mul_one]
            rw [hpow_eq]
            apply Submodule.subset_span
            exact Finset.mem_image.mpr ⟨(s₀, j, β),
              Finset.mem_product.mpr ⟨Finset.mem_range.mpr hs₀_lt,
                Finset.mem_product.mpr ⟨Finset.mem_univ j, Finset.mem_univ β⟩⟩, rfl⟩
      have hv₁_mem : ∀ (β : Fin b) (r₀₁ : D.R₀₁),
          mkQ (r₀₁ ⊗ₜ[D.R₁] v₁ β) ∈ W_span := by
        intro β r₀₁
        obtain ⟨r₁, N, rfl⟩ := hLoc_u r₀₁
        obtain ⟨f, rfl⟩ := hΞ₁.surjective r₁
        have hexp : (t₀₁ ^ N * ι₁ (∑ j : Fin D.r, algebraMap (Polynomial A) D.R₁ (f j) * D.b₁ j)) ⊗ₜ[D.R₁] v₁ β =
            ∑ j : Fin D.r, ∑ d ∈ Finset.range ((f j).natDegree + 1),
              c₀₁ ((f j).coeff d) • ((t₀₁ ^ N * u₀₁ ^ d * ι₁ (D.b₁ j)) • ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β)) := by
          have h_sm : ∀ x : D.R₀₁, x ⊗ₜ[D.R₁] v₁ β = x • ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β) := by
            intro x; rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [h_sm, map_sum, Finset.mul_sum, Finset.sum_smul]
          refine Finset.sum_congr rfl fun j _ => ?_
          conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow (f j)]
          rw [map_sum, Finset.sum_mul, map_sum, Finset.mul_sum, Finset.sum_smul]
          refine Finset.sum_congr rfl fun d _ => ?_
          simp only [map_mul, map_pow, smul_smul]
          congr 1
          change t₀₁ ^ N * (c₀₁ ((f j).coeff d) * u₀₁ ^ d * ι₁ (D.b₁ j)) =
            c₀₁ ((f j).coeff d) * (t₀₁ ^ N * u₀₁ ^ d * ι₁ (D.b₁ j))
          ring
        rw [hexp, map_sum]
        refine sum_mem fun j _ => ?_
        rw [map_sum]
        refine sum_mem fun d _ => ?_
        have h_lin : mkQ (c₀₁ ((f j).coeff d) •
            ((t₀₁ ^ N * u₀₁ ^ d * ι₁ (D.b₁ j)) • ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β))) =
            ((f j).coeff d) • mkQ ((t₀₁ ^ N * u₀₁ ^ d * ι₁ (D.b₁ j)) • ((1 : D.R₀₁) ⊗ₜ[D.R₁] v₁ β)) :=
          mkQ.map_smul ((f j).coeff d) _
        rw [h_lin]
        exact Submodule.smul_mem W_span _ (hmon_Q N d j β)
      have h_all_w : ∀ w : N₀₁, mkQ w ∈ W_span := by
        intro w
        induction w using TensorProduct.inductionOn with
        | tmul r₀₁ y₁ =>
          have hy₁ : y₁ ∈ Submodule.span D.R₁ (Set.range v₁) := by
            rw [hv₁_span]; trivial
          induction hy₁ using Submodule.span_induction generalizing r₀₁ with
          | mem y hy =>
            rcases hy with ⟨β, rfl⟩
            exact hv₁_mem β r₀₁
          | zero =>
            rw [TensorProduct.tmul_zero, map_zero]
            exact zero_mem W_span
          | add y y' _ _ ihy ihy' =>
            rw [TensorProduct.tmul_add, map_add]
            exact add_mem (ihy r₀₁) (ihy' r₀₁)
          | smul s₁ y _ ihy =>
            have hsm : r₀₁ ⊗ₜ[D.R₁] (s₁ • y) = (ι₁ s₁ * r₀₁) ⊗ₜ[D.R₁] y := by
              rw [← TensorProduct.smul_tmul, Algebra.smul_def]
            rw [hsm]
            exact ihy (ι₁ s₁ * r₀₁)
        | add w₁ w₂ ih₁ ih₂ =>
          rw [map_add]
          exact add_mem ih₁ ih₂
      have hW_top : W_span = ⊤ := by
        rw [eq_top_iff]
        intro q_el _
        obtain ⟨w, rfl⟩ := Submodule.Quotient.mk_surjective _ q_el
        exact h_all_w w
      have : Module.Finite A ↥(⊤ : Submodule A Q) := Module.Finite.iff_fg.mpr ⟨S_fin, hW_top⟩
      exact Module.Finite.of_surjective
        (Submodule.topEquiv (R := A) (M := Q)).toLinearMap
        (Submodule.topEquiv (R := A) (M := Q)).surjective

    
    have hδ_surj : Function.Surjective δ_q := by
      let mQ : Submodule A Q := (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A Q)
      have hQ_mem : ∀ q_el : Q, q_el ∈ mQ := by
        intro q_el
        obtain ⟨w, rfl⟩ := Submodule.Quotient.mk_surjective _ q_el
        obtain ⟨⟨x₀_b, x₁_b⟩, h_bar⟩ := hδ_tilde_surj (Φ₀₁ w)
        obtain ⟨x₀, hx₀⟩ := h_e₀_surj x₀_b
        obtain ⟨x₁, hx₁⟩ := h_e₁_surj x₁_b
        have hΦ0 : Φ₀₁ (w - δ_q (x₀, x₁)) = 0 := by
          rw [hΦ_sub, hΦ_δ x₀ x₁ x₀_b x₁_b hx₀ hx₁, h_bar, sub_self]
        have hw_mem := hΦ_ker_mA (w - δ_q (x₀, x₁)) hΦ0
        have hmk_sub : mkQ (w - δ_q (x₀, x₁)) = Submodule.Quotient.mk w := by
          rw [map_sub, hmkQ_δ, sub_zero, Submodule.mkQ_apply]
        rw [← hmk_sub]
        refine Submodule.smul_induction_on hw_mem ?_ ?_
        · intro a ha n _
          rw [map_smul]
          exact Submodule.smul_mem_smul ha trivial
        · intro x y hx hy
          rw [map_add]
          exact add_mem hx hy
      have hmap_bot : Submodule.map mQ.mkQ (⊥ : Submodule A Q) = ⊤ := by
        rw [eq_top_iff]
        intro z _
        obtain ⟨q_el, rfl⟩ := Submodule.Quotient.mk_surjective _ z
        have hz0 : mQ.mkQ q_el = 0 := by
          rw [← LinearMap.mem_ker, Submodule.ker_mkQ]
          exact hQ_mem q_el
        change mQ.mkQ q_el ∈ Submodule.map mQ.mkQ ⊥
        rw [hz0]
        exact zero_mem _
      have hbot_top : (⊥ : Submodule A Q) = ⊤ :=
        (IsLocalRing.map_mkQ_eq_top (M := Q) (N := (⊥ : Submodule A Q))).mp hmap_bot
      intro w
      have hw0 : mkQ w ∈ (⊥ : Submodule A Q) := by
        rw [hbot_top]; trivial
      rw [Submodule.mem_bot, ← LinearMap.mem_ker, Submodule.ker_mkQ] at hw0
      exact hw0

    
    intro x₀_bar x₁_bar h_compat
    obtain ⟨x₀, hx₀⟩ := h_e₀_surj x₀_bar
    obtain ⟨x₁, hx₁⟩ := h_e₁_surj x₁_bar
    have hΦ0 : Φ₀₁ (δ_q (x₀, x₁)) = 0 := by
      rw [hΦ_δ x₀ x₁ x₀_bar x₁_bar hx₀ hx₁]
      exact sub_eq_zero.mpr h_compat
    have hδ_mem : δ_q (x₀, x₁) ∈ (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A N₀₁) :=
      hΦ_ker_mA (δ_q (x₀, x₁)) hΦ0
    have h_pull_mA : ∀ w ∈ (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A N₀₁),
        ∃ p ∈ (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A (M.L₀ × M.L₁)), δ_q p = w := by
      intro w hw
      refine Submodule.smul_induction_on hw ?_ ?_
      · intro a ha n _
        obtain ⟨p, rfl⟩ := hδ_surj n
        exact ⟨a • p, Submodule.smul_mem_smul ha trivial, δ_q.map_smul a p⟩
      · rintro u v ⟨pu, hpu, rfl⟩ ⟨pv, hpv, rfl⟩
        exact ⟨pu + pv, add_mem hpu hpv, δ_q.map_add pu pv⟩
    obtain ⟨p_corr, hp_mem, hp_eq⟩ := h_pull_mA (δ_q (x₀, x₁)) hδ_mem
    have hp_vanish : π₀ (lam₀ p_corr.1) = 0 ∧ π₁ (lam₁ p_corr.2) = 0 := by
      refine Submodule.smul_induction_on hp_mem ?_ ?_
      · intro a ha p _
        have ha0 : τ_A a = 0 := (h_mem_mA a).mp ha
        constructor
        · change π₀ (lam₀ (c₀ a • p.1)) = 0
          rw [lam₀.map_smul, smul_eq_mul, map_mul, hπ₀_c a, ha0, map_zero, zero_mul]
        · change π₁ (lam₁ (c₁ a • p.2)) = 0
          rw [lam₁.map_smul, smul_eq_mul, map_mul, hπ₁_c a, ha0, map_zero, zero_mul]
      · rintro u v ⟨hu0, hu1⟩ ⟨hv0, hv1⟩
        constructor
        · simp only [Prod.fst_add, map_add, hu0, hv0, add_zero]
        · simp only [Prod.snd_add, map_add, hu1, hv1, add_zero]
    refine ⟨x₀ - p_corr.1, x₁ - p_corr.2, ?_, ?_, ?_⟩
    · have h0 : δ_q ((x₀, x₁) - p_corr) = 0 := by
        rw [map_sub, hp_eq, sub_self]
      exact sub_eq_zero.mp h0
    · rw [map_sub, map_sub, hp_vanish.1, sub_zero, hlam₀ x₀, hx₀]
    · rw [map_sub, map_sub, hp_vanish.2, sub_zero, hlam₁ x₁, hx₁]

  
  have h_base_compat : u₀₁_bar ^ q * ι₀_bar (t_bar ^ q) = ι₁_bar 1 := by
    rw [map_pow, map_one]
    exact hut_bar_pow q
  obtain ⟨w_base₀, w_base₁, hw_base_ov, hw_base₀, hw_base₁⟩ :=
    h_lift_pair (t_bar ^ q) 1 h_base_compat
  have h_fam_exists : ∀ (j : Fin D.r) (k₀ : ℕ), k₀ + D.w j ≤ q →
      ∃ (w₀ : M.L₀) (w₁ : M.L₁),
        u₀₁ ^ q • M.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] w₀) = (1 : D.R₀₁) ⊗ₜ[D.R₁] w₁ ∧
        π₀ (lam₀ w₀) = t_bar ^ k₀ * π₀ (D.b₀ j) ∧
        π₁ (lam₁ w₁) = u_bar ^ (q - D.w j - k₀) * π₁ (D.b₁ j) := by
    intro j k₀ hk
    apply h_lift_pair
    let j' : Fin D₀.r := Fin.cast hr j
    have hw_j : D.w j = D₀.w j' := hw_eq j
    have hexp_sum : (q - D.w j - k₀) + D₀.w j' + k₀ = q := by omega
    calc
      u₀₁_bar ^ q * ι₀_bar (t_bar ^ k₀ * π₀ (D.b₀ j))
          = u₀₁_bar ^ ((q - D.w j - k₀) + D₀.w j' + k₀) *
              (t₀₁_bar ^ k₀ * ι₀_bar (D₀.b₀ j')) := by
            rw [hexp_sum, map_mul, map_pow, hb₀_red j]
      _ = u₀₁_bar ^ (q - D.w j - k₀) * u₀₁_bar ^ (D₀.w j') *
            (u₀₁_bar ^ k₀ * t₀₁_bar ^ k₀) * ι₀_bar (D₀.b₀ j') := by
            rw [pow_add, pow_add]; ring
      _ = u₀₁_bar ^ (q - D.w j - k₀) * (u₀₁_bar ^ (D₀.w j') * ι₀_bar (D₀.b₀ j')) := by
            rw [hut_bar_pow k₀]; ring
      _ = u₀₁_bar ^ (q - D.w j - k₀) * ι₁_bar (D₀.b₁ j') := by
            rw [hb₁_ov_bar j']
      _ = ι₁_bar (u_bar ^ (q - D.w j - k₀) * π₁ (D.b₁ j)) := by
            rw [map_mul, map_pow, hb₁_red j]
  let w_fam₀ : ∀ (j : Fin D.r) (k₀ : ℕ), k₀ + D.w j ≤ q → M.L₀ :=
    fun j k₀ hk => (h_fam_exists j k₀ hk).choose
  let w_fam₁ : ∀ (j : Fin D.r) (k₀ : ℕ), k₀ + D.w j ≤ q → M.L₁ :=
    fun j k₀ hk => (h_fam_exists j k₀ hk).choose_spec.choose
  refine ⟨lam₀, lam₁, σ₀, w_base₀, w_base₁, w_fam₀, w_fam₁,
    ⟨hSymm₀, hSymm₁⟩, hσ₀, ⟨hw_base_ov, hw_base₀, hw_base₁⟩, ?_⟩
  intro j k₀ hk
  exact (h_fam_exists j k₀ hk).choose_spec.choose_spec

theorem weil_twoChart_local_quotient_finite_and_u_divisible (k : Type u) [Field k]
    (B : Type u) [CommRing B] [Algebra k B] (τ_B : B →ₐ[k] k)
    (hB_loc : IsLocalRing B) (hB_ker : ∀ b : B, τ_B b = 0 ↔ ¬ IsUnit b)
    (D_B : WeilTwoChartRingDatum B) (D₀ : WeilTwoChartRingDatum k)
    (red_B : WeilTwoChartCurveReduction D_B D₀)
    (hValid_B : WeilIsValidTwoChartCurveReduction τ_B D_B D₀ red_B)
    (M_B : WeilTwoChartLineBundle D_B)
    (lam₁_B : M_B.L₁ →ₗ[D_B.R₁] D_B.R₁)
    (w₀_B : M_B.L₀) (w₁_B : M_B.L₁) (q : ℕ) :
    letI : Algebra D_B.R₁ D₀.R₁ := red_B.algR₁
    let u_B : D_B.R₁ := algebraMap (Polynomial B) D_B.R₁ Polynomial.X
    let u₀₁_B : D_B.R₀₁ := algebraMap D_B.R₁ D_B.R₀₁ u_B
    let π₁_B : D_B.R₁ →+* D₀.R₁ := algebraMap D_B.R₁ D₀.R₁
    (∀ y τ : M_B.L₁, lam₁_B y • τ = lam₁_B τ • y) →
    u₀₁_B ^ q • M_B.θ (TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) w₀_B) =
      TensorProduct.tmul D_B.R₁ (1 : D_B.R₀₁) w₁_B →
    π₁_B (lam₁_B w₁_B) = 1 →
    (∃ (m_gen : ℕ) (g_gen : Fin m_gen → M_B.L₀),
      ∀ x : M_B.L₀, ∃ c_gen : Fin m_gen → B,
        x - Finset.univ.sum (fun i : Fin m_gen =>
          (algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (c_gen i))) • g_gen i) ∈
          Submodule.span D_B.R₀ {w₀_B}) ∧
    (∀ y : M_B.L₁ ⧸ Submodule.span D_B.R₁ {w₁_B},
      ∃ y' : M_B.L₁ ⧸ Submodule.span D_B.R₁ {w₁_B}, u_B • y' = y) :=
by
  classical
  letI : Algebra D_B.R₁ D₀.R₁ := red_B.algR₁
  letI : IsLocalRing B := hB_loc
  intro u_B u₀₁_B π₁_B hSymm₁ hθ hlam₁
  obtain ⟨hDatum_B, -, -, -, -, -, -, -, hKer₁⟩ := hValid_B
  obtain ⟨-, hb₀, hb₁, hLoc₀, -, htu, hScalar₀₁, -⟩ := hDatum_B
  let 𝔪_B : Ideal B := IsLocalRing.maximalIdeal B
  have hKer_τ : RingHom.ker τ_B.toRingHom = 𝔪_B := by
    ext b
    rw [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hB_ker b,
      IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  let α₁_B : B →+* D_B.R₁ := (algebraMap (Polynomial B) D_B.R₁).comp Polynomial.C
  have hKer₁' : RingHom.ker π₁_B = Ideal.map α₁_B 𝔪_B := by
    simpa only [π₁_B, α₁_B, hKer_τ] using hKer₁
  let I_u : Ideal D_B.R₁ := Ideal.span {u_B}
  let Rbar₁ := D_B.R₁ ⧸ I_u
  let q_u : D_B.R₁ →+* Rbar₁ := Ideal.Quotient.mk I_u
  have hqu_u : q_u u_B = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
  letI : Algebra B Rbar₁ := (q_u.comp α₁_B).toAlgebra
  have hsmul_Rbar₁ : ∀ (b : B) (r : Rbar₁), b • r = q_u (α₁_B b) * r :=
    fun b r => Algebra.smul_def b r
  let Φ_bar : (Fin D_B.r → B) →ₗ[B] Rbar₁ :=
    { toFun := fun v => Finset.univ.sum fun j : Fin D_B.r => v j • q_u (D_B.b₁ j)
      map_add' := fun v₁ v₂ => by
        simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
      map_smul' := fun c v => by
        simp only [Pi.smul_apply, smul_eq_mul, mul_smul, Finset.smul_sum, RingHom.id_apply] }
  have hΦ_surj : Function.Surjective Φ_bar := by
    intro ybar
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective ybar
    obtain ⟨f, rfl⟩ := hb₁.2 x
    refine ⟨fun j => (f j).coeff 0, ?_⟩
    change (Finset.univ.sum fun j : Fin D_B.r => ((f j).coeff 0) • q_u (D_B.b₁ j)) =
      q_u (Finset.univ.sum fun j : Fin D_B.r => algebraMap (Polynomial B) D_B.R₁ (f j) * D_B.b₁ j)
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro j _
    have hf : algebraMap (Polynomial B) D_B.R₁ (f j) =
        u_B * algebraMap (Polynomial B) D_B.R₁ (f j).divX + α₁_B ((f j).coeff 0) := by
      conv_lhs => rw [← Polynomial.X_mul_divX_add (f j)]
      rw [map_add, map_mul]
      rfl
    rw [hf, map_mul, map_add, map_mul, hqu_u, zero_mul, zero_add, ← hsmul_Rbar₁]
  haveI : Module.Finite B Rbar₁ := Module.Finite.of_surjective Φ_bar hΦ_surj
  have hFG_Rbar₁ : (⊤ : Submodule B Rbar₁).FG := Module.Finite.fg_top
  let h₁ : D_B.R₁ := lam₁_B w₁_B
  have hh₁_mem : h₁ - 1 ∈ Ideal.map α₁_B 𝔪_B := by
    rw [← hKer₁', RingHom.mem_ker, map_sub, map_one, hlam₁, sub_self]
  have hMap_mem : ∀ {z : D_B.R₁}, z ∈ Ideal.map α₁_B 𝔪_B →
      ∀ rbar : Rbar₁, rbar * q_u z ∈ 𝔪_B • (⊤ : Submodule B Rbar₁) := by
    intro z hz
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
    · rintro _ ⟨m, hm, rfl⟩ rbar
      rw [mul_comm, ← hsmul_Rbar₁]
      exact Submodule.smul_mem_smul hm trivial
    · intro rbar
      rw [map_zero, mul_zero]
      exact Submodule.zero_mem _
    · intro z₁ z₂ _ _ ih₁ ih₂ rbar
      rw [map_add, mul_add]
      exact Submodule.add_mem _ (ih₁ rbar) (ih₂ rbar)
    · intro s z₀ _ ih rbar
      change rbar * q_u (s * z₀) ∈ 𝔪_B • (⊤ : Submodule B Rbar₁)
      rw [map_mul, ← mul_assoc]
      exact ih (rbar * q_u s)
  let N₁ : Submodule B Rbar₁ := (Ideal.span {q_u h₁}).restrictScalars B
  have hLE_N₁ : (⊤ : Submodule B Rbar₁) ≤ N₁ ⊔ 𝔪_B • (⊤ : Submodule B Rbar₁) := by
    intro rbar _
    refine Submodule.mem_sup.mpr ⟨rbar * q_u h₁,
      Ideal.mul_mem_left _ rbar (Ideal.subset_span rfl),
      (-rbar) * q_u (h₁ - 1),
      hMap_mem hh₁_mem (-rbar), ?_⟩
    rw [map_sub, map_one]
    ring
  have hTop_le_N₁ : (⊤ : Submodule B Rbar₁) ≤ N₁ :=
    Submodule.le_of_le_smul_of_le_jacobson_bot hFG_Rbar₁
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) hLE_N₁
  have h1_mem_span : (1 : Rbar₁) ∈ Ideal.span {q_u h₁} := hTop_le_N₁ trivial
  obtain ⟨abar₁, habar₁⟩ := Ideal.mem_span_singleton.mp h1_mem_span
  obtain ⟨a₁, rfl⟩ := Ideal.Quotient.mk_surjective abar₁
  have hu_mem : 1 - a₁ * h₁ ∈ I_u := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q_u (1 - a₁ * h₁) = 0
    rw [map_sub, map_one, map_mul, mul_comm (q_u a₁) (q_u h₁), ← habar₁, sub_self]
  obtain ⟨b₁, hb₁_eq⟩ := Ideal.mem_span_singleton.mp hu_mem
  let W₁ : Submodule D_B.R₁ M_B.L₁ := Submodule.span D_B.R₁ {w₁_B}
  let Q₁ := M_B.L₁ ⧸ W₁
  have hDiv_u : ∀ y : Q₁, ∃ y' : Q₁, u_B • y' = y := by
    intro y
    obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective W₁ y
    refine ⟨Submodule.Quotient.mk (b₁ • z), ?_⟩
    symm
    rw [← sub_eq_zero]
    change Submodule.Quotient.mk z - Submodule.Quotient.mk (u_B • (b₁ • z)) = 0
    rw [← Submodule.Quotient.mk_sub, Submodule.Quotient.mk_eq_zero]
    have hz_eq : z - u_B • (b₁ • z) = (a₁ * lam₁_B z) • w₁_B := by
      have ha : 1 - u_B * b₁ = a₁ * h₁ := by
        rw [← hb₁_eq]
        ring
      calc
        z - u_B • (b₁ • z) = (1 : D_B.R₁) • z - (u_B * b₁) • z := by
          rw [one_smul, mul_smul]
        _ = (1 - u_B * b₁) • z := (sub_smul 1 (u_B * b₁) z).symm
        _ = (a₁ * h₁) • z := by rw [ha]
        _ = a₁ • (lam₁_B w₁_B • z) := mul_smul a₁ h₁ z
        _ = a₁ • (lam₁_B z • w₁_B) := by rw [← hSymm₁ z w₁_B]
        _ = (a₁ * lam₁_B z) • w₁_B := (mul_smul a₁ (lam₁_B z) w₁_B).symm
    rw [hz_eq]
    exact Submodule.smul_mem W₁ _ (Submodule.subset_span rfl)
  letI : Module (Polynomial B) M_B.L₁ :=
    Module.compHom M_B.L₁ (algebraMap (Polynomial B) D_B.R₁)
  letI : IsScalarTower (Polynomial B) D_B.R₁ M_B.L₁ :=
    ⟨fun p r m => by
      rw [Algebra.smul_def]
      exact mul_smul (algebraMap (Polynomial B) D_B.R₁ p) r m⟩
  haveI : Module.Finite (Polynomial B) D_B.R₁ :=
    Module.Finite.equiv (weilPicSurj_polyBasisEquiv D_B.b₁ hb₁)
  haveI : Module.Finite (Polynomial B) M_B.L₁ :=
    Module.Finite.trans D_B.R₁ M_B.L₁
  let mkQ_poly : M_B.L₁ →ₗ[Polynomial B] Q₁ := W₁.mkQ.restrictScalars (Polynomial B)
  haveI : Module.Finite (Polynomial B) Q₁ :=
    Module.Finite.of_surjective mkQ_poly W₁.mkQ_surjective
  have hFG_Q₁ : (⊤ : Submodule (Polynomial B) Q₁).FG := Module.Finite.fg_top
  let IX : Ideal (Polynomial B) := Ideal.span {(Polynomial.X : Polynomial B)}
  have hLE_Q₁ : (⊤ : Submodule (Polynomial B) Q₁) ≤
      IX • (⊤ : Submodule (Polynomial B) Q₁) := by
    intro y _
    obtain ⟨y', hy'⟩ := hDiv_u y
    have hXy' : (Polynomial.X : Polynomial B) • y' = y := by
      have htower : (Polynomial.X : Polynomial B) • y' = u_B • y' := by
        obtain ⟨z', rfl⟩ := Submodule.Quotient.mk_surjective W₁ y'
        rfl
      rw [htower, hy']
    rw [← hXy']
    exact Submodule.smul_mem_smul (Ideal.subset_span rfl) trivial
  obtain ⟨P_u, hPu_mem, hPu_fix⟩ :=
    Submodule.exists_mem_and_smul_eq_self_of_fg_of_le_smul
      IX (⊤ : Submodule (Polynomial B) Q₁) hFG_Q₁ hLE_Q₁
  let H₁ : Polynomial B := 1 - P_u
  let N_u : ℕ := H₁.natDegree + 1
  obtain ⟨R_u, hPu_eq⟩ := Ideal.mem_span_singleton.mp hPu_mem
  have hH₁_coeff0 : H₁.coeff 0 = 1 := by
    change (1 - P_u).coeff 0 = 1
    rw [Polynomial.coeff_sub, hPu_eq, Polynomial.coeff_X_mul_zero]
    simp
  let h₁_pol : D_B.R₁ := algebraMap (Polynomial B) D_B.R₁ H₁
  have hh₁_ann : ∀ y₁ : M_B.L₁, h₁_pol • y₁ ∈ W₁ := by
    intro y₁
    rw [← Submodule.Quotient.mk_eq_zero W₁]
    change (1 - P_u) • (Submodule.Quotient.mk y₁ : Q₁) = 0
    rw [sub_smul, one_smul, hPu_fix _ trivial, sub_self]
  let H₀ : Polynomial B :=
    Finset.sum (Finset.range N_u) (fun s => Polynomial.C (H₁.coeff s) * Polynomial.X ^ (N_u - s))
  have hH₀_monic : H₀.Monic := by
    refine Polynomial.monic_of_natDegree_le_of_coeff_eq_one N_u ?_ ?_
    · rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro m hm
      dsimp only [H₀]
      rw [Polynomial.finset_sum_coeff]
      apply Finset.sum_eq_zero
      intro s _
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      split_ifs with heq
      · omega
      · exact mul_zero _
    · dsimp only [H₀]
      rw [Polynomial.finset_sum_coeff, Finset.sum_eq_single 0]
      · rw [Nat.sub_zero, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_pos rfl,
          mul_one, hH₁_coeff0]
      · intro s hs hs0
        rw [Finset.mem_range] at hs
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
        split_ifs with heq
        · omega
        · exact mul_zero _
      · intro h0
        exact absurd (Finset.mem_range.mpr (Nat.succ_pos H₁.natDegree)) h0
  let t_B : D_B.R₀ := algebraMap (Polynomial B) D_B.R₀ Polynomial.X
  let t₀₁_B : D_B.R₀₁ := algebraMap D_B.R₀ D_B.R₀₁ t_B
  let h₀ : D_B.R₀ := algebraMap (Polynomial B) D_B.R₀ H₀
  let W₀ : Submodule D_B.R₀ M_B.L₀ := Submodule.span D_B.R₀ {w₀_B}
  have hOverlap : algebraMap D_B.R₀ D_B.R₀₁ h₀ =
      t₀₁_B ^ N_u * algebraMap D_B.R₁ D_B.R₀₁ h₁_pol := by
    have hH₁_sum : H₁ =
        Finset.sum (Finset.range N_u) (fun s => Polynomial.C (H₁.coeff s) * Polynomial.X ^ s) :=
      Polynomial.as_sum_range_C_mul_X_pow H₁
    dsimp only [h₀, H₀, h₁_pol]
    conv_rhs => rw [hH₁_sum]
    simp only [map_sum, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro s hs
    rw [Finset.mem_range] at hs
    simp only [map_mul, map_pow]
    change algebraMap D_B.R₀ D_B.R₀₁ (algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (H₁.coeff s))) *
        t₀₁_B ^ (N_u - s) =
      t₀₁_B ^ N_u *
        (algebraMap D_B.R₁ D_B.R₀₁ (algebraMap (Polynomial B) D_B.R₁ (Polynomial.C (H₁.coeff s))) *
          u₀₁_B ^ s)
    rw [← hScalar₀₁ (H₁.coeff s)]
    have hpow : t₀₁_B ^ N_u * u₀₁_B ^ s = t₀₁_B ^ (N_u - s) := by
      have hsub : N_u = (N_u - s) + s := (Nat.sub_add_cancel (Nat.le_of_lt hs)).symm
      calc
        t₀₁_B ^ N_u * u₀₁_B ^ s = t₀₁_B ^ ((N_u - s) + s) * u₀₁_B ^ s := by rw [← hsub]
        _ = t₀₁_B ^ (N_u - s) * (t₀₁_B ^ s * u₀₁_B ^ s) := by rw [pow_add, mul_assoc]
        _ = t₀₁_B ^ (N_u - s) * (t₀₁_B * u₀₁_B) ^ s := by rw [← mul_pow]
        _ = t₀₁_B ^ (N_u - s) := by rw [htu, one_pow, mul_one]
    calc
      algebraMap D_B.R₀ D_B.R₀₁ (algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (H₁.coeff s))) *
          t₀₁_B ^ (N_u - s) =
        algebraMap D_B.R₀ D_B.R₀₁ (algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (H₁.coeff s))) *
          (t₀₁_B ^ N_u * u₀₁_B ^ s) := by rw [hpow]
      _ = t₀₁_B ^ N_u *
          (algebraMap D_B.R₀ D_B.R₀₁ (algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (H₁.coeff s))) *
            u₀₁_B ^ s) := by ring
  have hTensor₁ : ∀ z₁ : TensorProduct D_B.R₁ D_B.R₀₁ M_B.L₁,
      ∃ r₀₁ : D_B.R₀₁,
        (algebraMap D_B.R₁ D_B.R₀₁ h₁_pol) • z₁ =
          r₀₁ • TensorProduct.tmul D_B.R₁ (1 : D_B.R₀₁) w₁_B := by
    intro z₁
    induction z₁ using TensorProduct.induction_on with
    | zero =>
      exact ⟨0, by rw [smul_zero, zero_smul]⟩
    | tmul s y₁ =>
      obtain ⟨c₁, hc₁⟩ := Submodule.mem_span_singleton.mp (hh₁_ann y₁)
      refine ⟨s * algebraMap D_B.R₁ D_B.R₀₁ c₁, ?_⟩
      calc
        (algebraMap D_B.R₁ D_B.R₀₁ h₁_pol) • TensorProduct.tmul D_B.R₁ s y₁ =
            TensorProduct.tmul D_B.R₁ (h₁_pol • s) y₁ := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, Algebra.smul_def]
        _ = TensorProduct.tmul D_B.R₁ s (h₁_pol • y₁) :=
          TensorProduct.smul_tmul h₁_pol s y₁
        _ = TensorProduct.tmul D_B.R₁ s (c₁ • w₁_B) := by rw [← hc₁]
        _ = TensorProduct.tmul D_B.R₁ (c₁ • s) w₁_B :=
          (TensorProduct.smul_tmul c₁ s w₁_B).symm
        _ = (s * algebraMap D_B.R₁ D_B.R₀₁ c₁) • TensorProduct.tmul D_B.R₁ (1 : D_B.R₀₁) w₁_B := by
          rw [TensorProduct.smul_tmul', Algebra.smul_def, smul_eq_mul, mul_one, mul_comm]
    | add z₁' z₁'' ih₁ ih₂ =>
      obtain ⟨r₁, hr₁⟩ := ih₁
      obtain ⟨r₂, hr₂⟩ := ih₂
      exact ⟨r₁ + r₂, by rw [smul_add, hr₁, hr₂, add_smul]⟩
  letI : IsLocalization.Away t_B D_B.R₀₁ := hLoc₀
  haveI : IsLocalizedModule (Submonoid.powers t_B) (TensorProduct.mk D_B.R₀ D_B.R₀₁ M_B.L₀ 1) :=
    IsLocalization.tensorProduct_isLocalizedModule (Submonoid.powers t_B) D_B.R₀₁
  have hClear_pt : ∀ x : M_B.L₀, ∃ k : ℕ, (t_B ^ k * h₀) • x ∈ W₀ := by
    intro x
    obtain ⟨r₀₁, hr₀₁⟩ := hTensor₁ (M_B.θ (TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) x))
    let r'₀₁ : D_B.R₀₁ := t₀₁_B ^ N_u * r₀₁ * u₀₁_B ^ q
    have hθ_eq : TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) (h₀ • x) =
        r'₀₁ • TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) w₀_B := by
      apply M_B.θ.injective
      have htmul₀ : TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) (h₀ • x) =
          (algebraMap D_B.R₀ D_B.R₀₁ h₀) • TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) x := by
        rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
          TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [htmul₀, LinearEquiv.map_smul, LinearEquiv.map_smul, hOverlap,
        mul_smul, hr₀₁, ← hθ]
      dsimp only [r'₀₁]
      rw [mul_smul, mul_smul]
    let k₁ : ℕ := (IsLocalization.Away.sec t_B r'₀₁).2
    let c₀ : D_B.R₀ := (IsLocalization.Away.sec t_B r'₀₁).1
    have hsec : r'₀₁ * algebraMap D_B.R₀ D_B.R₀₁ (t_B ^ k₁) = algebraMap D_B.R₀ D_B.R₀₁ c₀ :=
      IsLocalization.Away.sec_spec t_B r'₀₁
    have hmk_eq : (TensorProduct.mk D_B.R₀ D_B.R₀₁ M_B.L₀ 1) ((t_B ^ k₁ * h₀) • x) =
        (TensorProduct.mk D_B.R₀ D_B.R₀₁ M_B.L₀ 1) (c₀ • w₀_B) := by
      change TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) ((t_B ^ k₁ * h₀) • x) =
        TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) (c₀ • w₀_B)
      calc
        TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) ((t_B ^ k₁ * h₀) • x) =
            (algebraMap D_B.R₀ D_B.R₀₁ (t_B ^ k₁)) •
              TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) (h₀ • x) := by
          rw [mul_smul, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
            TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        _ = (algebraMap D_B.R₀ D_B.R₀₁ (t_B ^ k₁)) •
              (r'₀₁ • TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) w₀_B) := by
          rw [hθ_eq]
        _ = (r'₀₁ * algebraMap D_B.R₀ D_B.R₀₁ (t_B ^ k₁)) •
              TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) w₀_B := by
          rw [← mul_smul, mul_comm]
        _ = (algebraMap D_B.R₀ D_B.R₀₁ c₀) • TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) w₀_B := by
          rw [hsec]
        _ = TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) (c₀ • w₀_B) := by
          rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
            TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    obtain ⟨s', hs'⟩ :=
      (IsLocalizedModule.eq_iff_exists (Submonoid.powers t_B)
        (TensorProduct.mk D_B.R₀ D_B.R₀₁ M_B.L₀ 1)).mp hmk_eq
    obtain ⟨k₂, hk₂_raw⟩ := s'.2
    have hk₂ : t_B ^ k₂ = (s' : D_B.R₀) := hk₂_raw
    refine ⟨k₁ + k₂, ?_⟩
    have hsmul_eq : (t_B ^ (k₁ + k₂) * h₀) • x = (t_B ^ k₂ * c₀) • w₀_B := by
      calc
        (t_B ^ (k₁ + k₂) * h₀) • x = t_B ^ k₂ • ((t_B ^ k₁ * h₀) • x) := by
          rw [← mul_smul]
          congr 1
          rw [pow_add]
          ring
        _ = (s' : D_B.R₀) • ((t_B ^ k₁ * h₀) • x) := by rw [hk₂]
        _ = (s' : D_B.R₀) • (c₀ • w₀_B) := by simpa [Submonoid.smul_def] using hs'
        _ = t_B ^ k₂ • (c₀ • w₀_B) := by rw [← hk₂]
        _ = (t_B ^ k₂ * c₀) • w₀_B := (mul_smul (t_B ^ k₂) c₀ w₀_B).symm
    rw [hsmul_eq]
    exact Submodule.smul_mem W₀ _ (Submodule.subset_span rfl)
  obtain ⟨κ, p_gen, hp_gen⟩ := Module.Finite.exists_fin' D_B.R₀ M_B.L₀
  let v : Fin κ → M_B.L₀ := fun β => p_gen (Pi.single β 1)
  have hp_expand : ∀ r : Fin κ → D_B.R₀, p_gen r = Finset.univ.sum fun β : Fin κ => r β • v β := by
    intro r
    conv_lhs => rw [pi_eq_sum_univ' r]
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro β _
    exact map_smul p_gen (r β) (Pi.single β 1)
  choose k_v hk_v using fun β : Fin κ => hClear_pt (v β)
  let K : ℕ := Finset.univ.sup k_v
  have hClear_v : ∀ β : Fin κ, (t_B ^ K * h₀) • v β ∈ W₀ := by
    intro β
    have hle : k_v β ≤ K := Finset.le_sup (f := k_v) (Finset.mem_univ β)
    have hexp : t_B ^ K * h₀ = t_B ^ (K - k_v β) * (t_B ^ k_v β * h₀) := by
      have hadd : K = (K - k_v β) + k_v β := (Nat.sub_add_cancel hle).symm
      conv_lhs => rw [hadd]
      rw [pow_add, mul_assoc]
    rw [hexp, mul_smul]
    exact Submodule.smul_mem W₀ _ (hk_v β)
  have hClear_all : ∀ x : M_B.L₀, (t_B ^ K * h₀) • x ∈ W₀ := by
    intro x
    obtain ⟨r, rfl⟩ := hp_gen x
    rw [hp_expand r, Finset.smul_sum]
    refine Submodule.sum_mem W₀ fun β _ => ?_
    rw [smul_comm]
    exact Submodule.smul_mem W₀ (r β) (hClear_v β)
  let H_tilde : Polynomial B := Polynomial.X ^ K * H₀
  have hH_tilde_monic : H_tilde.Monic := (Polynomial.monic_X_pow K).mul hH₀_monic
  have hH_tilde_img : algebraMap (Polynomial B) D_B.R₀ H_tilde = t_B ^ K * h₀ := by
    dsimp only [H_tilde, t_B, h₀]
    rw [map_mul, map_pow]
  let d_H : ℕ := H_tilde.natDegree
  let m_gen : ℕ := κ * (D_B.r * d_H)
  let e_gen : Fin m_gen ≃ Fin κ × Fin D_B.r × Fin d_H :=
    finProdFinEquiv.symm.trans (Equiv.prodCongr (Equiv.refl (Fin κ)) finProdFinEquiv.symm)
  let g_gen : Fin m_gen → M_B.L₀ := fun i =>
    (t_B ^ (e_gen i).2.2.val * D_B.b₀ (e_gen i).2.1) • v (e_gen i).1
  refine ⟨⟨m_gen, g_gen, ?_⟩, hDiv_u⟩
  intro x
  by_cases hH1 : H_tilde = 1
  · refine ⟨fun _ => 0, ?_⟩
    have hsum0 : (Finset.univ.sum fun i : Fin m_gen =>
        (algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (0 : B))) • g_gen i) = 0 := by
      simp
    rw [hsum0, sub_zero]
    have h1_eq : t_B ^ K * h₀ = 1 := by
      rw [← hH_tilde_img, hH1, map_one]
    have hx_mem := hClear_all x
    rwa [h1_eq, one_smul] at hx_mem
  · obtain ⟨r, rfl⟩ := hp_gen x
    choose f_β hf_β using fun β : Fin κ => hb₀.2 (r β)
    let c_gen : Fin m_gen → B := fun i =>
      (f_β (e_gen i).1 (e_gen i).2.1 %ₘ H_tilde).coeff (e_gen i).2.2.val
    refine ⟨c_gen, ?_⟩
    have hsum_rem :
        (Finset.univ.sum fun i : Fin m_gen =>
          (algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (c_gen i))) • g_gen i) =
        Finset.univ.sum fun β : Fin κ => Finset.univ.sum fun j : Fin D_B.r =>
          (algebraMap (Polynomial B) D_B.R₀ (f_β β j %ₘ H_tilde) * D_B.b₀ j) • v β := by
      rw [← e_gen.symm.sum_comp]
      simp only [c_gen, g_gen, Equiv.apply_symm_apply]
      rw [Fintype.sum_prod_type]
      apply Finset.sum_congr rfl
      intro β _
      rw [Fintype.sum_prod_type]
      apply Finset.sum_congr rfl
      intro j _
      have hdeg_lt : (f_β β j %ₘ H_tilde).natDegree < d_H :=
        Polynomial.natDegree_modByMonic_lt (f_β β j) hH_tilde_monic hH1
      have hrem_exp : f_β β j %ₘ H_tilde =
          Finset.univ.sum fun s : Fin d_H =>
            Polynomial.C ((f_β β j %ₘ H_tilde).coeff s.val) * Polynomial.X ^ s.val := by
        rw [Fin.sum_univ_eq_sum_range
          (fun n => Polynomial.C ((f_β β j %ₘ H_tilde).coeff n) * Polynomial.X ^ n) d_H]
        exact Polynomial.as_sum_range_C_mul_X_pow' (f_β β j %ₘ H_tilde) hdeg_lt
      conv_rhs => rw [hrem_exp]
      rw [map_sum, Finset.sum_mul, Finset.sum_smul]
      apply Finset.sum_congr rfl
      intro s _
      rw [map_mul, map_pow, ← mul_smul, mul_assoc]
    have hx_exp : p_gen r =
        Finset.univ.sum fun β : Fin κ => Finset.univ.sum fun j : Fin D_B.r =>
          (algebraMap (Polynomial B) D_B.R₀ (f_β β j) * D_B.b₀ j) • v β := by
      rw [hp_expand r]
      apply Finset.sum_congr rfl
      intro β _
      rw [← hf_β β, Finset.sum_smul]
    rw [hx_exp, hsum_rem, ← Finset.sum_sub_distrib]
    refine Submodule.sum_mem W₀ fun β _ => ?_
    rw [← Finset.sum_sub_distrib]
    refine Submodule.sum_mem W₀ fun j _ => ?_
    have hterm :
        (algebraMap (Polynomial B) D_B.R₀ (f_β β j) * D_B.b₀ j) • v β -
          (algebraMap (Polynomial B) D_B.R₀ (f_β β j %ₘ H_tilde) * D_B.b₀ j) • v β =
        (t_B ^ K * h₀) •
          ((algebraMap (Polynomial B) D_B.R₀ (f_β β j /ₘ H_tilde) * D_B.b₀ j) • v β) := by
      rw [← sub_smul, ← sub_mul]
      have hsub : f_β β j - f_β β j %ₘ H_tilde = H_tilde * (f_β β j /ₘ H_tilde) :=
        sub_eq_of_eq_add' (Polynomial.modByMonic_add_div (f_β β j) H_tilde).symm
      rw [← map_sub, hsub, map_mul, hH_tilde_img, mul_assoc, mul_smul]
    rw [hterm]
    exact hClear_all _

theorem weil_twoChart_local_finite_quotient_monomial_basis (k : Type u) [Field k]
    (B : Type u) [CommRing B] [Algebra k B] (τ_B : B →ₐ[k] k)
    (hB_noeth : IsNoetherianRing B) (hB_loc : IsLocalRing B)
    (hB_ker : ∀ b : B, τ_B b = 0 ↔ ¬ IsUnit b)
    (D_B : WeilTwoChartRingDatum B) (D₀ : WeilTwoChartRingDatum k)
    (red_B : WeilTwoChartCurveReduction D_B D₀)
    (hValid_B : WeilIsValidTwoChartCurveReduction τ_B D_B D₀ red_B)
    (M_B : WeilTwoChartLineBundle D_B)
    (lam₀_B : M_B.L₀ →ₗ[D_B.R₀] D_B.R₀)
    (σ₀_B w₀_B : M_B.L₀) (q : ℕ) :
    letI : Algebra D_B.R₀ D₀.R₀ := red_B.algR₀
    let t_B : D_B.R₀ := algebraMap (Polynomial B) D_B.R₀ Polynomial.X
    let t_bar : D₀.R₀ := algebraMap (Polynomial k) D₀.R₀ Polynomial.X
    let π₀_B : D_B.R₀ →+* D₀.R₀ := algebraMap D_B.R₀ D₀.R₀
    (∀ x τ : M_B.L₀, lam₀_B x • τ = lam₀_B τ • x) →
    π₀_B (lam₀_B σ₀_B) = 1 →
    π₀_B (lam₀_B w₀_B) = t_bar ^ q →
    (∃ (m_gen : ℕ) (g_gen : Fin m_gen → M_B.L₀),
      ∀ x : M_B.L₀, ∃ c_gen : Fin m_gen → B,
        x - Finset.univ.sum (fun i : Fin m_gen =>
          (algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (c_gen i))) • g_gen i) ∈
          Submodule.span D_B.R₀ {w₀_B}) →
    Function.Bijective (fun v : Fin D_B.r × Fin q → B =>
      Finset.univ.sum fun p =>
        (Submodule.span D_B.R₀ {w₀_B}).mkQ
          ((algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (v p)) *
            t_B ^ p.2.val * D_B.b₀ p.1) • σ₀_B)) :=
by
  letI : Algebra D_B.R₀ D₀.R₀ := red_B.algR₀
  letI : IsNoetherianRing B := hB_noeth
  letI : IsLocalRing B := hB_loc
  intro t_B t_bar π₀_B hSymm hσ₀ hw₀ hGen
  let α₀ : B →+* D_B.R₀ := (algebraMap (Polynomial B) D_B.R₀).comp Polynomial.C
  have hα₀_apply : ∀ b : B, α₀ b = algebraMap (Polynomial B) D_B.R₀ (Polynomial.C b) :=
    fun _ => rfl
  let 𝔪_B : Ideal B := IsLocalRing.maximalIdeal B
  let W : Submodule D_B.R₀ M_B.L₀ := Submodule.span D_B.R₀ {w₀_B}
  let s₀ : D_B.R₀ := lam₀_B σ₀_B
  let h₀ : D_B.R₀ := lam₀_B w₀_B
  have hb₀_bij : Function.Bijective (fun f : Fin D_B.r → Polynomial B =>
      Finset.univ.sum fun j => algebraMap (Polynomial B) D_B.R₀ (f j) * D_B.b₀ j) :=
    hValid_B.1.2.1
  have hb₀_bar_bij : Function.Bijective (fun f : Fin D₀.r → Polynomial k =>
      Finset.univ.sum fun j => algebraMap (Polynomial k) D₀.R₀ (f j) * D₀.b₀ j) :=
    hValid_B.2.1.2.1
  obtain ⟨hr, -, hb₀_red, -⟩ := hValid_B.2.2.1
  have hMap₀ : ∀ p : Polynomial B,
      π₀_B (algebraMap (Polynomial B) D_B.R₀ p) =
        algebraMap (Polynomial k) D₀.R₀ (Polynomial.map τ_B.toRingHom p) :=
    hValid_B.2.2.2.1
  have hπ₀_surj : Function.Surjective π₀_B := hValid_B.2.2.2.2.2.1
  have hπ₀_ker : RingHom.ker π₀_B = Ideal.map α₀ (RingHom.ker τ_B.toRingHom) :=
    hValid_B.2.2.2.2.2.2.1
  have hker_τ : RingHom.ker τ_B.toRingHom = 𝔪_B := by
    ext b
    change τ_B b = 0 ↔ b ∈ 𝔪_B
    exact (hB_ker b).trans (IsLocalRing.mem_maximalIdeal b).symm
  have hπ₀_ker_m : RingHom.ker π₀_B = Ideal.map α₀ 𝔪_B := by
    rw [hπ₀_ker, hker_τ]
  have hπ₀_t : π₀_B t_B = t_bar := by
    change π₀_B (algebraMap (Polynomial B) D_B.R₀ Polynomial.X) = t_bar
    rw [hMap₀ Polynomial.X, Polynomial.map_X]
  have hσ₀_mem : s₀ - 1 ∈ Ideal.map α₀ 𝔪_B := by
    rw [← hπ₀_ker_m, RingHom.mem_ker, map_sub, map_one, hσ₀, sub_self]
  have hw₀_mem : h₀ - t_B ^ q ∈ Ideal.map α₀ 𝔪_B := by
    rw [← hπ₀_ker_m, RingHom.mem_ker, map_sub, map_pow, hw₀, hπ₀_t, sub_self]
  let Φ_lin : (Fin D_B.r → Polynomial B) →ₗ[Polynomial B] D_B.R₀ :=
    { toFun := fun g => Finset.univ.sum fun j => algebraMap (Polynomial B) D_B.R₀ (g j) * D_B.b₀ j
      map_add' := fun g₁ g₂ => by
        simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
      map_smul' := fun P g => by
        simp only [Pi.smul_apply, smul_eq_mul, map_mul, RingHom.id_apply, Algebra.smul_def,
          Finset.mul_sum, mul_assoc] }
  let e₀ : (Fin D_B.r → Polynomial B) ≃ₗ[Polynomial B] D_B.R₀ :=
    LinearEquiv.ofBijective Φ_lin hb₀_bij
  have he₀_symm_α₀_mul : ∀ (b : B) (y : D_B.R₀) (j : Fin D_B.r) (d : ℕ),
      (e₀.symm (α₀ b * y) j).coeff d = b * (e₀.symm y j).coeff d := by
    intro b y j d
    have hsmul : α₀ b * y = (Polynomial.C b) • y := by
      rw [Algebra.smul_def]
      rfl
    rw [hsmul, e₀.symm.map_smul, Pi.smul_apply, smul_eq_mul, Polynomial.coeff_C_mul]
  have hCoeffI : ∀ (I : Ideal B) (f : Fin D_B.r → Polynomial B),
      e₀ f ∈ Ideal.map α₀ I ↔ ∀ (j : Fin D_B.r) (d : ℕ), (f j).coeff d ∈ I := by
    intro I f
    constructor
    · intro hf_mem
      have h_all : ∀ {x : D_B.R₀}, x ∈ Ideal.map α₀ I →
          ∀ (j : Fin D_B.r) (d : ℕ), (e₀.symm x j).coeff d ∈ I := by
        intro x hx
        change x ∈ Submodule.span D_B.R₀ (α₀ '' (I : Set B)) at hx
        refine Submodule.closure_induction
          (p := fun x _ => ∀ (j : Fin D_B.r) (d : ℕ), (e₀.symm x j).coeff d ∈ I)
          ?_ ?_ ?_ hx
        · intro j d
          simp only [map_zero, Pi.zero_apply, Polynomial.coeff_zero, Ideal.zero_mem]
        · intro x₁ x₂ _ _ hx₁ hx₂ j d
          rw [map_add, Pi.add_apply, Polynomial.coeff_add]
          exact I.add_mem (hx₁ j d) (hx₂ j d)
        · rintro r y ⟨b, hb, rfl⟩ j d
          change (e₀.symm (r * α₀ b) j).coeff d ∈ I
          rw [mul_comm r (α₀ b), he₀_symm_α₀_mul]
          exact I.mul_mem_right _ hb
      intro j d
      have h_eq : e₀.symm (e₀ f) = f := e₀.symm_apply_apply f
      simpa only [h_eq] using h_all hf_mem j d
    · intro hf_coeff
      change (Finset.univ.sum fun j : Fin D_B.r =>
        algebraMap (Polynomial B) D_B.R₀ (f j) * D_B.b₀ j) ∈ Ideal.map α₀ I
      refine Submodule.sum_mem (Ideal.map α₀ I) fun j _ => ?_
      have hfj : f j = Finset.sum (Finset.range ((f j).natDegree + 1))
          (fun d => Polynomial.C ((f j).coeff d) * Polynomial.X ^ d) :=
        Polynomial.as_sum_range_C_mul_X_pow (f j)
      rw [hfj, map_sum, Finset.sum_mul]
      refine Submodule.sum_mem (Ideal.map α₀ I) fun d _ => ?_
      rw [map_mul, map_pow, mul_assoc]
      exact Ideal.mul_mem_right _ (Ideal.map α₀ I) (Ideal.mem_map_of_mem α₀ (hf_coeff j d))
  have hInj : Function.Injective (fun v : Fin D_B.r × Fin q → B =>
      Finset.univ.sum fun p =>
        W.mkQ ((algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (v p)) *
          t_B ^ p.2.val * D_B.b₀ p.1) • σ₀_B)) := by
    intro v₁ v₂ hv₁₂
    let w : Fin D_B.r × Fin q → B := fun p => v₁ p - v₂ p
    let f_w : D_B.R₀ := Finset.univ.sum fun p : Fin D_B.r × Fin q =>
      α₀ (w p) * t_B ^ p.2.val * D_B.b₀ p.1
    have hmkQ_fw : W.mkQ (f_w • σ₀_B) = 0 := by
      dsimp only [f_w, w]
      rw [Finset.sum_smul, map_sum]
      have hterm : (fun p : Fin D_B.r × Fin q =>
          W.mkQ ((α₀ (v₁ p - v₂ p) * t_B ^ p.2.val * D_B.b₀ p.1) • σ₀_B)) =
        (fun p : Fin D_B.r × Fin q =>
          W.mkQ ((α₀ (v₁ p) * t_B ^ p.2.val * D_B.b₀ p.1) • σ₀_B) -
          W.mkQ ((α₀ (v₂ p) * t_B ^ p.2.val * D_B.b₀ p.1) • σ₀_B)) := by
        ext p
        rw [map_sub, sub_mul, sub_mul, sub_smul, map_sub]
      rw [hterm, Finset.sum_sub_distrib, sub_eq_zero]
      exact hv₁₂
    have hfw_mem : f_w • σ₀_B ∈ W := by
      rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hmkQ_fw
    obtain ⟨r₀, hr₀⟩ := Submodule.mem_span_singleton.mp hfw_mem
    have hr_lam : r₀ * h₀ = f_w * s₀ := by
      have hlam := congrArg lam₀_B hr₀
      simpa only [LinearMap.map_smul, smul_eq_mul, h₀, s₀] using hlam
    have hring_id : f_w - r₀ * t_B ^ q = r₀ * (h₀ - t_B ^ q) - f_w * (s₀ - 1) := by
      calc
        f_w - r₀ * t_B ^ q = (f_w - r₀ * t_B ^ q) + (r₀ * h₀ - f_w * s₀) := by
          rw [hr_lam, sub_self, add_zero]
        _ = r₀ * (h₀ - t_B ^ q) - f_w * (s₀ - 1) := by ring
    let g : Fin D_B.r → Polynomial B := e₀.symm r₀
    have hg_eq : e₀ g = r₀ := e₀.apply_symm_apply r₀
    let P_w : Fin D_B.r → Polynomial B := fun j =>
      Finset.univ.sum fun s : Fin q => Polynomial.C (w (j, s)) * Polynomial.X ^ s.val
    have he₀_Pw : e₀ P_w = f_w := by
      change (Finset.univ.sum fun j : Fin D_B.r =>
        algebraMap (Polynomial B) D_B.R₀ (P_w j) * D_B.b₀ j) = f_w
      dsimp only [P_w, f_w]
      rw [Fintype.sum_prod_type]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [map_mul, map_pow]
      rfl
    have he₀_diff : e₀ (fun j => P_w j - g j * Polynomial.X ^ q) = f_w - r₀ * t_B ^ q := by
      have hfun : (fun j : Fin D_B.r => P_w j - g j * Polynomial.X ^ q) =
          P_w - (Polynomial.X ^ q : Polynomial B) • g := by
        ext j
        simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, mul_comm (g j)]
      rw [hfun, map_sub, e₀.map_smul, he₀_Pw, hg_eq, Algebra.smul_def, map_pow]
      change f_w - t_B ^ q * r₀ = f_w - r₀ * t_B ^ q
      rw [mul_comm]
    have hInd : ∀ n : ℕ,
        (∀ p : Fin D_B.r × Fin q, w p ∈ 𝔪_B ^ n) ∧ r₀ ∈ Ideal.map α₀ (𝔪_B ^ n) := by
      intro n
      induction n with
      | zero =>
        rw [pow_zero, Ideal.one_eq_top]
        refine ⟨fun _ => Submodule.mem_top, ?_⟩
        have h1 : α₀ 1 ∈ Ideal.map α₀ ⊤ := Ideal.mem_map_of_mem α₀ Submodule.mem_top
        rw [map_one] at h1
        simpa only [mul_one] using Ideal.mul_mem_left (Ideal.map α₀ ⊤) r₀ h1
      | succ n ih =>
        obtain ⟨hw_n, hr_n⟩ := ih
        have hf_n : f_w ∈ Ideal.map α₀ (𝔪_B ^ n) := by
          dsimp only [f_w]
          refine Submodule.sum_mem (Ideal.map α₀ (𝔪_B ^ n)) fun p _ => ?_
          rw [mul_assoc]
          exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem α₀ (hw_n p))
        have hdiff_mem : e₀ (fun j => P_w j - g j * Polynomial.X ^ q) ∈
            Ideal.map α₀ (𝔪_B ^ (n + 1)) := by
          rw [he₀_diff, hring_id, pow_succ, Ideal.map_mul]
          exact Ideal.sub_mem _ (Ideal.mul_mem_mul hr_n hw₀_mem) (Ideal.mul_mem_mul hf_n hσ₀_mem)
        have hcoeff_all := (hCoeffI (𝔪_B ^ (n + 1)) (fun j => P_w j - g j * Polynomial.X ^ q)).mp
          hdiff_mem
        have hPw_coeff : ∀ (j : Fin D_B.r) (d : ℕ),
            (P_w j).coeff d = Finset.univ.sum fun s' : Fin q =>
              w (j, s') * (if d = s'.val then (1 : B) else 0) := by
          intro j d
          dsimp only [P_w]
          rw [← Polynomial.lcoeff_apply, map_sum]
          refine Finset.sum_congr rfl fun s' _ => ?_
          rw [Polynomial.lcoeff_apply, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
        refine ⟨?_, ?_⟩
        · rintro ⟨j, s⟩
          have hc := hcoeff_all j s.val
          rw [Polynomial.coeff_sub, hPw_coeff j s.val, Polynomial.coeff_mul_X_pow',
            if_neg (not_le_of_gt s.isLt), sub_zero] at hc
          have hsum_s : (Finset.univ.sum fun s' : Fin q =>
              w (j, s') * (if s.val = s'.val then (1 : B) else 0)) = w (j, s) := by
            rw [Finset.sum_eq_single s]
            · simp
            · intro s' _ hs'
              have hne : s.val ≠ s'.val := fun hval => hs' (Fin.ext hval).symm
              rw [if_neg hne, mul_zero]
            · intro hs_mem
              exact absurd (Finset.mem_univ s) hs_mem
          rwa [hsum_s] at hc
        · rw [← hg_eq]
          refine (hCoeffI (𝔪_B ^ (n + 1)) g).mpr fun j d₀ => ?_
          have hc := hcoeff_all j (d₀ + q)
          rw [Polynomial.coeff_sub, hPw_coeff j (d₀ + q), Polynomial.coeff_mul_X_pow] at hc
          have hsum_0 : (Finset.univ.sum fun s' : Fin q =>
              w (j, s') * (if d₀ + q = s'.val then (1 : B) else 0)) = 0 := by
            refine Finset.sum_eq_zero fun s' _ => ?_
            have hne : d₀ + q ≠ s'.val := by
              have := s'.isLt
              omega
            rw [if_neg hne, mul_zero]
          rw [hsum_0, zero_sub] at hc
          exact (𝔪_B ^ (n + 1)).neg_mem_iff.mp hc
    have hKrull : (⨅ n : ℕ, 𝔪_B ^ n) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing 𝔪_B (IsLocalRing.maximalIdeal.isMaximal B).ne_top
    ext p
    have hwp_iInf : w p ∈ ⨅ n : ℕ, 𝔪_B ^ n := Ideal.mem_iInf.mpr fun n => (hInd n).1 p
    rw [hKrull, Submodule.mem_bot] at hwp_iInf
    exact sub_eq_zero.mp hwp_iInf
  have hSurj : Function.Surjective (fun v : Fin D_B.r × Fin q → B =>
      Finset.univ.sum fun p =>
        W.mkQ ((algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (v p)) *
          t_B ^ p.2.val * D_B.b₀ p.1) • σ₀_B)) := by
    let Q₀ := M_B.L₀ ⧸ W
    letI : Module B Q₀ := Module.compHom Q₀ α₀
    haveI : IsScalarTower B B Q₀ := ⟨fun b₁ b₂ y => mul_smul b₁ b₂ y⟩
    have hmkQ_α₀_smul : ∀ (b : B) (z : M_B.L₀), W.mkQ (α₀ b • z) = (b : B) • W.mkQ z :=
      fun b z => W.mkQ.map_smul (α₀ b) z
    let Ψ_lin : (Fin D_B.r × Fin q → B) →ₗ[B] Q₀ :=
      { toFun := fun v => Finset.univ.sum fun p =>
          W.mkQ ((α₀ (v p) * t_B ^ p.2.val * D_B.b₀ p.1) • σ₀_B)
        map_add' := fun v₁ v₂ => by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun p _ => ?_
          rw [Pi.add_apply, map_add, add_mul, add_mul, add_smul, map_add]
        map_smul' := fun b v => by
          simp only [RingHom.id_apply, Finset.smul_sum]
          refine Finset.sum_congr rfl fun p _ => ?_
          rw [Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc, mul_assoc, mul_smul, hmkQ_α₀_smul,
            ← mul_assoc] }
    have hFG : (⊤ : Submodule B Q₀).FG := by
      obtain ⟨m_gen, g_gen, hg_gen⟩ := hGen
      rw [Submodule.fg_def]
      refine ⟨Set.range (fun i : Fin m_gen => W.mkQ (g_gen i)), Set.finite_range _, ?_⟩
      refine le_antisymm le_top fun y _ => ?_
      obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective W y
      obtain ⟨c_gen, hc_gen⟩ := hg_gen x
      have hmkQ_sub : W.mkQ (x - Finset.univ.sum (fun i : Fin m_gen =>
          (α₀ (c_gen i)) • g_gen i)) = 0 := by
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        exact hc_gen
      rw [map_sub, sub_eq_zero, map_sum] at hmkQ_sub
      rw [hmkQ_sub]
      refine Submodule.sum_mem _ fun i _ => ?_
      rw [hmkQ_α₀_smul]
      exact Submodule.smul_mem _ (c_gen i) (Submodule.subset_span ⟨i, rfl⟩)
    have hMemSmul : ∀ {r₀ : D_B.R₀}, r₀ ∈ Ideal.map α₀ 𝔪_B →
        ∀ z : M_B.L₀, W.mkQ (r₀ • z) ∈ 𝔪_B • (⊤ : Submodule B Q₀) := by
      intro r₀ hr₀
      change r₀ ∈ Submodule.span D_B.R₀ (α₀ '' (𝔪_B : Set B)) at hr₀
      refine Submodule.closure_induction
        (p := fun r₀ _ => ∀ z : M_B.L₀, W.mkQ (r₀ • z) ∈ 𝔪_B • (⊤ : Submodule B Q₀))
        ?_ ?_ ?_ hr₀
      · intro z
        simp only [zero_smul, map_zero, Submodule.zero_mem]
      · intro r₁ r₂ _ _ hr₁ hr₂ z
        rw [add_smul, map_add]
        exact Submodule.add_mem _ (hr₁ z) (hr₂ z)
      · rintro s y ⟨m, hm, rfl⟩ z
        change W.mkQ ((s * α₀ m) • z) ∈ 𝔪_B • (⊤ : Submodule B Q₀)
        rw [mul_comm s (α₀ m), mul_smul, hmkQ_α₀_smul]
        exact Submodule.smul_mem_smul hm Submodule.mem_top
    have hTop_le_sup : (⊤ : Submodule B Q₀) ≤
        LinearMap.range Ψ_lin ⊔ 𝔪_B • (⊤ : Submodule B Q₀) := by
      intro y _
      obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective W y
      have hx_decomp : x = lam₀_B x • σ₀_B + (1 - s₀) • x := by
        rw [hSymm x σ₀_B, sub_smul, one_smul]
        change x = s₀ • x + (x - s₀ • x)
        abel
      have h1_sub_s₀ : 1 - s₀ ∈ Ideal.map α₀ 𝔪_B := by
        have : 1 - s₀ = -(s₀ - 1) := by ring
        rw [this]
        exact (Ideal.map α₀ 𝔪_B).neg_mem hσ₀_mem
      obtain ⟨f₀, hf₀⟩ := hb₀_bar_bij.2 (π₀_B (lam₀_B x))
      let f_bar : Fin D_B.r → Polynomial k := fun j => f₀ (Fin.cast hr j)
      have hf_bar_eq : (Finset.univ.sum fun j : Fin D_B.r =>
          algebraMap (Polynomial k) D₀.R₀ (f_bar j) * π₀_B (D_B.b₀ j)) = π₀_B (lam₀_B x) := by
        have hcast : (Finset.univ.sum fun j : Fin D_B.r =>
            algebraMap (Polynomial k) D₀.R₀ (f_bar j) * π₀_B (D_B.b₀ j)) =
          Finset.univ.sum fun j₀ : Fin D₀.r =>
            algebraMap (Polynomial k) D₀.R₀ (f₀ j₀) * D₀.b₀ j₀ := by
          have hcongr : (Finset.univ.sum fun j : Fin D_B.r =>
              algebraMap (Polynomial k) D₀.R₀ (f_bar j) * π₀_B (D_B.b₀ j)) =
            Finset.univ.sum fun j : Fin D_B.r =>
              algebraMap (Polynomial k) D₀.R₀ (f₀ ((Fin.castOrderIso hr).toEquiv j)) *
                D₀.b₀ ((Fin.castOrderIso hr).toEquiv j) := by
            refine Finset.sum_congr rfl fun j _ => ?_
            exact congrArg (algebraMap (Polynomial k) D₀.R₀ (f_bar j) * ·) (hb₀_red j)
          exact hcongr.trans (Equiv.sum_comp (Fin.castOrderIso hr).toEquiv
            (fun j₀ : Fin D₀.r => algebraMap (Polynomial k) D₀.R₀ (f₀ j₀) * D₀.b₀ j₀))
        exact hcast.trans hf₀
      let r_bar : Fin D_B.r → Polynomial k := fun j =>
        Finset.univ.sum fun s : Fin q =>
          Polynomial.C ((f_bar j).coeff s.val) * Polynomial.X ^ s.val
      let q_bar : Fin D_B.r → Polynomial k := fun j =>
        Finset.sum (Finset.range ((f_bar j).natDegree + 1)) fun m =>
          Polynomial.C ((f_bar j).coeff (m + q)) * Polynomial.X ^ m
      have hfq_split : ∀ j : Fin D_B.r, f_bar j = r_bar j + q_bar j * Polynomial.X ^ q := by
        intro j
        ext d
        rw [Polynomial.coeff_add, Polynomial.coeff_mul_X_pow']
        have hr_coeff : (r_bar j).coeff d = Finset.univ.sum fun s : Fin q =>
            (f_bar j).coeff s.val * (if d = s.val then (1 : k) else 0) := by
          dsimp only [r_bar]
          rw [← Polynomial.lcoeff_apply, map_sum]
          refine Finset.sum_congr rfl fun s _ => ?_
          rw [Polynomial.lcoeff_apply, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
        rw [hr_coeff]
        by_cases hd : d < q
        · rw [if_neg (not_le_of_gt hd), add_zero]
          symm
          rw [Finset.sum_eq_single (⟨d, hd⟩ : Fin q)]
          · simp
          · intro s _ hs
            have hne : d ≠ s.val := fun hval => hs (Fin.ext hval.symm)
            rw [if_neg hne, mul_zero]
          · intro hmem
            exact absurd (Finset.mem_univ (⟨d, hd⟩ : Fin q)) hmem
        · have hqd : q ≤ d := le_of_not_gt hd
          rw [if_pos hqd]
          have hr0 : (Finset.univ.sum fun s : Fin q =>
              (f_bar j).coeff s.val * (if d = s.val then (1 : k) else 0)) = 0 := by
            refine Finset.sum_eq_zero fun s _ => ?_
            have hne : d ≠ s.val := by
              have := s.isLt
              omega
            rw [if_neg hne, mul_zero]
          rw [hr0, zero_add]
          have hq_coeff : (q_bar j).coeff (d - q) =
              Finset.sum (Finset.range ((f_bar j).natDegree + 1)) fun m =>
                (f_bar j).coeff (m + q) * (if d - q = m then (1 : k) else 0) := by
            dsimp only [q_bar]
            rw [← Polynomial.lcoeff_apply, map_sum]
            refine Finset.sum_congr rfl fun m _ => ?_
            rw [Polynomial.lcoeff_apply, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
          rw [hq_coeff]
          by_cases hdeg : d - q < (f_bar j).natDegree + 1
          · symm
            rw [Finset.sum_eq_single (d - q)]
            · simp [Nat.sub_add_cancel hqd]
            · intro m _ hm
              rw [if_neg (Ne.symm hm), mul_zero]
            · intro hmem
              exact absurd (Finset.mem_range.mpr hdeg) hmem
          · have hlt : (f_bar j).natDegree < d := by omega
            rw [Polynomial.coeff_eq_zero_of_natDegree_lt hlt]
            symm
            refine Finset.sum_eq_zero fun m hm => ?_
            have hm_lt : m < (f_bar j).natDegree + 1 := Finset.mem_range.mp hm
            have hne : d - q ≠ m := by omega
            rw [if_neg hne, mul_zero]
      let v : Fin D_B.r × Fin q → B := fun p => algebraMap k B ((f_bar p.1).coeff p.2.val)
      have hτ_v : ∀ p : Fin D_B.r × Fin q, τ_B (v p) = (f_bar p.1).coeff p.2.val :=
        fun p => τ_B.commutes _
      let f_v : D_B.R₀ := Finset.univ.sum fun p : Fin D_B.r × Fin q =>
        α₀ (v p) * t_B ^ p.2.val * D_B.b₀ p.1
      obtain ⟨q_lift, hq_lift⟩ := hπ₀_surj (Finset.univ.sum fun j : Fin D_B.r =>
        algebraMap (Polynomial k) D₀.R₀ (q_bar j) * π₀_B (D_B.b₀ j))
      let δ_x : D_B.R₀ := lam₀_B x - f_v - q_lift * h₀
      have hπ₀_fv : π₀_B f_v = Finset.univ.sum fun j : Fin D_B.r =>
          algebraMap (Polynomial k) D₀.R₀ (r_bar j) * π₀_B (D_B.b₀ j) := by
        dsimp only [f_v, r_bar]
        rw [map_sum, Fintype.sum_prod_type]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl fun s _ => ?_
        rw [map_mul, map_mul, map_pow, hπ₀_t, hα₀_apply, hMap₀, Polynomial.map_C,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hτ_v (j, s), map_mul, map_pow]
      have hπ₀_qh : π₀_B (q_lift * h₀) = Finset.univ.sum fun j : Fin D_B.r =>
          algebraMap (Polynomial k) D₀.R₀ (q_bar j * Polynomial.X ^ q) * π₀_B (D_B.b₀ j) := by
        rw [map_mul, hq_lift, hw₀, Finset.sum_mul]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, map_pow, mul_right_comm]
      have hδ_mem : δ_x ∈ Ideal.map α₀ 𝔪_B := by
        rw [← hπ₀_ker_m, RingHom.mem_ker]
        dsimp only [δ_x]
        rw [map_sub, map_sub, hπ₀_fv, hπ₀_qh, ← hf_bar_eq]
        have hcomb : (Finset.univ.sum fun j : Fin D_B.r =>
              algebraMap (Polynomial k) D₀.R₀ (f_bar j) * π₀_B (D_B.b₀ j)) -
            (Finset.univ.sum fun j : Fin D_B.r =>
              algebraMap (Polynomial k) D₀.R₀ (r_bar j) * π₀_B (D_B.b₀ j)) -
            (Finset.univ.sum fun j : Fin D_B.r =>
              algebraMap (Polynomial k) D₀.R₀ (q_bar j * Polynomial.X ^ q) * π₀_B (D_B.b₀ j)) =
            Finset.univ.sum fun j : Fin D_B.r =>
              (algebraMap (Polynomial k) D₀.R₀ (f_bar j) -
               algebraMap (Polynomial k) D₀.R₀ (r_bar j) -
               algebraMap (Polynomial k) D₀.R₀ (q_bar j * Polynomial.X ^ q)) * π₀_B (D_B.b₀ j) := by
          simp only [sub_mul, Finset.sum_sub_distrib]
        rw [hcomb]
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [hfq_split j, map_add]
        ring
      have hqh_mkQ : W.mkQ ((q_lift * h₀) • σ₀_B) = 0 := by
        have hqh_mem : (q_lift * h₀) • σ₀_B ∈ W := by
          rw [mul_smul, hSymm w₀_B σ₀_B, ← mul_smul]
          exact Submodule.mem_span_singleton.mpr ⟨q_lift * s₀, rfl⟩
        rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      have hfv_mkQ : W.mkQ (f_v • σ₀_B) = Ψ_lin v := by
        dsimp only [f_v, Ψ_lin]
        rw [Finset.sum_smul, map_sum]
        rfl
      have hlam_eq : lam₀_B x = f_v + q_lift * h₀ + δ_x := by
        dsimp only [δ_x]
        ring
      rw [hx_decomp, hlam_eq, add_smul, add_smul, map_add, map_add, map_add,
        hqh_mkQ, add_zero, hfv_mkQ, add_assoc]
      exact Submodule.add_mem_sup ⟨v, rfl⟩
        (Submodule.add_mem _ (hMemSmul hδ_mem σ₀_B) (hMemSmul h1_sub_s₀ x))
    have hjac : 𝔪_B ≤ (⊥ : Ideal B).jacobson :=
      le_of_eq (IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal B) bot_ne_top).symm
    have hNak : (⊤ : Submodule B Q₀) ≤ LinearMap.range Ψ_lin :=
      Submodule.le_of_le_smul_of_le_jacobson_bot hFG hjac hTop_le_sup
    intro y
    exact hNak Submodule.mem_top
  exact ⟨hInj, hSurj⟩

theorem weil_twoChart_mvPoly_atPrime_division_identities (k : Type u) [Field k]
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (hA_noeth : IsNoetherianRing A)
    (D : WeilTwoChartRingDatum A) (D₀ : WeilTwoChartRingDatum k)
    (red : WeilTwoChartCurveReduction D D₀)
    (hValid : WeilIsValidTwoChartCurveReduction τ_A D D₀ red)
    (M : WeilTwoChartLineBundle D)
    (lam₀ : M.L₀ →ₗ[D.R₀] D.R₀) (lam₁ : M.L₁ →ₗ[D.R₁] D.R₁)
    (σ₀ w_base₀ : M.L₀) (w_base₁ : M.L₁)
    (q m_U : ℕ)
    (w_U₀ : Fin D.r → Fin m_U → M.L₀)
    (w_U₁ : Fin D.r → Fin m_U → M.L₁) :
    letI : Algebra D.R₀ D₀.R₀ := red.algR₀
    letI : Algebra D.R₁ D₀.R₁ := red.algR₁
    let t : D.R₀ := algebraMap (Polynomial A) D.R₀ Polynomial.X
    let u₀₁ : D.R₀₁ := algebraMap D.R₁ D.R₀₁ (algebraMap (Polynomial A) D.R₁ Polynomial.X)
    let t_bar : D₀.R₀ := algebraMap (Polynomial k) D₀.R₀ Polynomial.X
    let π₀ : D.R₀ →+* D₀.R₀ := algebraMap D.R₀ D₀.R₀
    let π₁ : D.R₁ →+* D₀.R₁ := algebraMap D.R₁ D₀.R₁
    (∀ x τ : M.L₀, lam₀ x • τ = lam₀ τ • x) →
    (∀ y τ : M.L₁, lam₁ y • τ = lam₁ τ • y) →
    π₀ (lam₀ σ₀) = 1 →
    u₀₁ ^ q • M.θ (TensorProduct.tmul D.R₀ (1 : D.R₀₁) w_base₀) =
      TensorProduct.tmul D.R₁ (1 : D.R₀₁) w_base₁ →
    π₀ (lam₀ w_base₀) = t_bar ^ q →
    π₁ (lam₁ w_base₁) = 1 →
    (∀ (j : Fin D.r) (k₀ : Fin m_U),
      u₀₁ ^ q • M.θ (TensorProduct.tmul D.R₀ (1 : D.R₀₁) (w_U₀ j k₀)) =
        TensorProduct.tmul D.R₁ (1 : D.R₀₁) (w_U₁ j k₀) ∧
      π₀ (lam₀ (w_U₀ j k₀)) = t_bar ^ k₀.val * π₀ (D.b₀ j)) →
    (∀ (B : Type u) [CommRing B] [Algebra k B] (τ_B : B →ₐ[k] k),
      IsNoetherianRing B → IsLocalRing B → (∀ b : B, τ_B b = 0 ↔ ¬ IsUnit b) →
      ∀ (D_B : WeilTwoChartRingDatum B) (red_B : WeilTwoChartCurveReduction D_B D₀),
        WeilIsValidTwoChartCurveReduction τ_B D_B D₀ red_B →
        ∀ (M_B : WeilTwoChartLineBundle D_B)
          (lam₀_B : M_B.L₀ →ₗ[D_B.R₀] D_B.R₀) (lam₁_B : M_B.L₁ →ₗ[D_B.R₁] D_B.R₁)
          (σ₀_B w₀_B : M_B.L₀) (w₁_B : M_B.L₁),
          letI : Algebra D_B.R₀ D₀.R₀ := red_B.algR₀
          letI : Algebra D_B.R₁ D₀.R₁ := red_B.algR₁
          (∀ x τ : M_B.L₀, lam₀_B x • τ = lam₀_B τ • x) →
          (∀ y τ : M_B.L₁, lam₁_B y • τ = lam₁_B τ • y) →
          algebraMap D_B.R₀ D₀.R₀ (lam₀_B σ₀_B) = 1 →
          (algebraMap D_B.R₁ D_B.R₀₁ (algebraMap (Polynomial B) D_B.R₁ Polynomial.X)) ^ q •
              M_B.θ (TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) w₀_B) =
            TensorProduct.tmul D_B.R₁ (1 : D_B.R₀₁) w₁_B →
          algebraMap D_B.R₀ D₀.R₀ (lam₀_B w₀_B) = t_bar ^ q →
          algebraMap D_B.R₁ D₀.R₁ (lam₁_B w₁_B) = 1 →
          Function.Bijective (fun v : Fin D_B.r × Fin q → B =>
            Finset.univ.sum fun p =>
              (Submodule.span D_B.R₀ {w₀_B}).mkQ
                ((algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (v p)) *
                  (algebraMap (Polynomial B) D_B.R₀ Polynomial.X) ^ p.2.val * D_B.b₀ p.1) • σ₀_B))) →
    ∀ {ι : Type} [Fintype ι] (y : ι → M.L₀),
      ∃ (Δ : MvPolynomial (Fin D.r × Fin m_U) A)
        (A_coeff : ι → Fin D.r × Fin q → MvPolynomial (Fin D.r × Fin m_U) A)
        (Q_bar : ι → MvPolynomial (Fin D.r × Fin m_U) D₀.R₀),
        τ_A (MvPolynomial.eval 0 Δ) ≠ 0 ∧
        (∀ (u_pt : Fin D.r × Fin m_U → A) (i : ι),
          (algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt Δ))) • y i -
            Finset.univ.sum (fun p : Fin D.r × Fin q =>
              (algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt (A_coeff i p))) *
                t ^ p.2.val * D.b₀ p.1) • σ₀) ∈
            Submodule.span D.R₀
              {w_base₀ + Finset.univ.sum (fun p' : Fin D.r × Fin m_U =>
                (algebraMap (Polynomial A) D.R₀ (Polynomial.C (u_pt p'))) • w_U₀ p'.1 p'.2)}) ∧
        (∀ i : ι,
          (MvPolynomial.map (((algebraMap (Polynomial k) D₀.R₀).comp Polynomial.C).comp τ_A.toRingHom) Δ) *
            MvPolynomial.C (π₀ (lam₀ (y i))) -
          Finset.univ.sum (fun p : Fin D.r × Fin q =>
            (MvPolynomial.map (((algebraMap (Polynomial k) D₀.R₀).comp Polynomial.C).comp τ_A.toRingHom)
              (A_coeff i p)) *
            MvPolynomial.C (t_bar ^ p.2.val * π₀ (D.b₀ p.1))) =
          Q_bar i *
            (MvPolynomial.C (t_bar ^ q) +
              Finset.univ.sum (fun p' : Fin D.r × Fin m_U =>
                MvPolynomial.C (t_bar ^ p'.2.val * π₀ (D.b₀ p'.1)) * MvPolynomial.X p'))) :=
by
  classical
  let _ : Algebra D.R₀ D₀.R₀ := red.algR₀
  let _ : Algebra D.R₁ D₀.R₁ := red.algR₁
  intro t u₀₁ t_bar π₀ π₁ hSymm₀ hSymm₁ hσ₀ hBase_θ hBase_lam₀ hBase_lam₁ hFam hLocalBasis ι _ y
  let algA₀ : Algebra A D.R₀ := ((algebraMap (Polynomial A) D.R₀).comp Polynomial.C).toAlgebra
  have hTowerA₀ : IsScalarTower A (Polynomial A) D.R₀ := IsScalarTower.of_algebraMap_eq' rfl
  let modAL₀ : Module A M.L₀ := RestrictScalars.module A D.R₀ M.L₀

  
  have hChartBC :
      ∀ {B : Type u} [CommRing B] [Algebra k B] [Algebra A B] (τ_B : B →ₐ[k] k),
        (∀ a : A, τ_B (algebraMap A B a) = τ_A a) →
        ∀ {r r₀ : ℕ} (hr : r = r₀)
          {R : Type u} [CommRing R] [Algebra (Polynomial A) R] [Algebra A R]
          [IsScalarTower A (Polynomial A) R]
          {R_bar : Type u} [CommRing R_bar] [Algebra (Polynomial k) R_bar]
          (π : R →+* R_bar) (b : Fin r → R) (b_bar : Fin r₀ → R_bar),
          Function.Bijective (fun f : Fin r → Polynomial A =>
            Finset.univ.sum fun j => algebraMap (Polynomial A) R (f j) * b j) →
          Function.Bijective (fun f : Fin r₀ → Polynomial k =>
            Finset.univ.sum fun j => algebraMap (Polynomial k) R_bar (f j) * b_bar j) →
          (∀ j : Fin r, π (b j) = b_bar (Fin.cast hr j)) →
          (∀ p : Polynomial A, π (algebraMap (Polynomial A) R p) =
            algebraMap (Polynomial k) R_bar (Polynomial.map τ_A.toRingHom p)) →
          Function.Surjective π →
          ∀ {R_B : Type u} [CommRing R_B] (eR : TensorProduct A B R ≃+* R_B),
            let ψ_B : Polynomial B →+* R_B :=
              eR.toRingHom.comp
                ((Algebra.TensorProduct.map (AlgHom.id A B)
                  (IsScalarTower.toAlgHom A (Polynomial A) R)).toRingHom.comp
                  (polyEquivTensor' A B).toRingHom)
            ∃ π_B : R_B →+* R_bar,
              (∀ (β : B) (r_el : R),
                π_B (eR (β ⊗ₜ[A] r_el)) =
                  algebraMap (Polynomial k) R_bar (Polynomial.C (τ_B β)) * π r_el) ∧
              Function.Bijective (fun f : Fin r → Polynomial B =>
                Finset.univ.sum fun j => ψ_B (f j) * eR ((1 : B) ⊗ₜ[A] b j)) ∧
              (∀ j : Fin r, π_B (eR ((1 : B) ⊗ₜ[A] b j)) = b_bar (Fin.cast hr j)) ∧
              (∀ p : Polynomial B, π_B (ψ_B p) =
                algebraMap (Polynomial k) R_bar (Polynomial.map τ_B.toRingHom p)) ∧
              Function.Surjective π_B ∧
              RingHom.ker π_B = Ideal.map (ψ_B.comp Polynomial.C) (RingHom.ker τ_B.toRingHom) := by
    intro B _ _ _ τ_B hτ_AB r r₀ hr R _ _ _ _ R_bar _ _ π b b_bar
      hBij_A hBij_bar hπ_b hπ_poly hπ_surj R_B _ eR ψ_B
    
    let algA_Rbar : Algebra A R_bar :=
      (((algebraMap (Polynomial k) R_bar).comp Polynomial.C).comp τ_A.toRingHom).toAlgebra
    let φ_left : B →ₐ[A] R_bar :=
      { toRingHom := ((algebraMap (Polynomial k) R_bar).comp Polynomial.C).comp τ_B.toRingHom
        commutes' := fun a => by
          change algebraMap (Polynomial k) R_bar (Polynomial.C (τ_B (algebraMap A B a))) =
            algebraMap (Polynomial k) R_bar (Polynomial.C (τ_A a))
          rw [hτ_AB a] }
    let φ_right : R →ₐ[A] R_bar :=
      { toRingHom := π
        commutes' := fun a => by
          have ha : algebraMap A R a = algebraMap (Polynomial A) R (Polynomial.C a) :=
            IsScalarTower.algebraMap_apply A (Polynomial A) R a
          change π (algebraMap A R a) =
            algebraMap (Polynomial k) R_bar (Polynomial.C (τ_A a))
          rw [ha, hπ_poly (Polynomial.C a), Polynomial.map_C]
          rfl }
    let π_tensor : TensorProduct A B R →+* R_bar :=
      (Algebra.TensorProduct.lift φ_left φ_right (fun _ _ => Commute.all _ _)).toRingHom
    let π_B : R_B →+* R_bar := π_tensor.comp eR.symm.toRingHom
    have hπ_B_tmul : ∀ (β : B) (r_el : R),
        π_B (eR (β ⊗ₜ[A] r_el)) =
          algebraMap (Polynomial k) R_bar (Polynomial.C (τ_B β)) * π r_el := by
      intro β r_el
      change π_tensor (eR.symm (eR (β ⊗ₜ[A] r_el))) = _
      rw [RingEquiv.symm_apply_apply]
      rfl
    
    let Φ_A_lin : (Fin r → Polynomial A) →ₗ[A] R :=
      { toFun := fun f => Finset.univ.sum fun j => algebraMap (Polynomial A) R (f j) * b j
        map_add' := fun f₁ f₂ => by
          simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
        map_smul' := fun a f => by
          simp only [Pi.smul_apply, RingHom.id_apply, Finset.smul_sum]
          apply Finset.sum_congr rfl
          intro j _
          rw [Algebra.smul_def, Algebra.smul_def, map_mul, ← mul_assoc,
            IsScalarTower.algebraMap_apply A (Polynomial A) R] }
    let Φ_A_equiv : (Fin r → Polynomial A) ≃ₗ[A] R := LinearEquiv.ofBijective Φ_A_lin hBij_A
    let e₃ : TensorProduct A B (Fin r → Polynomial A) ≃ₗ[B] TensorProduct A B R :=
      LinearEquiv.baseChange A B (Fin r → Polynomial A) R Φ_A_equiv
    let inj_j : Fin r → Polynomial A →ₗ[A] (Fin r → Polynomial A) := fun j =>
      { toFun := fun p j' => if j' = j then p else 0
        map_add' := fun x y => by ext j'; dsimp; split_ifs <;> simp
        map_smul' := fun a x => by ext j'; dsimp; split_ifs <;> simp }
    let proj_j : Fin r → (Fin r → Polynomial A) →ₗ[A] Polynomial A := fun j =>
      { toFun := fun f => f j
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    let G₁ : TensorProduct A B (Fin r → Polynomial A) → (Fin r → TensorProduct A B (Polynomial A)) :=
      fun z j => LinearMap.baseChange B (proj_j j) z
    let G₂ : (Fin r → TensorProduct A B (Polynomial A)) → TensorProduct A B (Fin r → Polynomial A) :=
      fun g => Finset.univ.sum fun j => LinearMap.baseChange B (inj_j j) (g j)
    have hG₂G₁ : ∀ z, G₂ (G₁ z) = z := by
      intro z
      induction z using TensorProduct.inductionOn with
      | tmul β f =>
        simp only [G₁, G₂, LinearMap.baseChange_tmul]
        rw [← TensorProduct.tmul_sum]
        congr 1
        ext j'
        simp [inj_j, proj_j]
      | add z₁ z₂ ih₁ ih₂ =>
        dsimp [G₁, G₂] at ih₁ ih₂ ⊢
        simp only [map_add, Finset.sum_add_distrib]
        rw [ih₁, ih₂]
    have hG₁G₂ : ∀ g, G₁ (G₂ g) = g := by
      intro g
      ext j₀
      simp only [G₁, G₂, map_sum]
      have hterm : ∀ (j : Fin r) (u : TensorProduct A B (Polynomial A)),
          LinearMap.baseChange B (proj_j j₀) (LinearMap.baseChange B (inj_j j) u) =
            if j₀ = j then u else 0 := by
        intro j u
        induction u using TensorProduct.inductionOn with
        | tmul β p =>
          simp only [LinearMap.baseChange_tmul, proj_j, inj_j, LinearMap.coe_mk, AddHom.coe_mk]
          split_ifs with hj <;> simp
        | add u₁ u₂ ih₁ ih₂ =>
          rw [map_add, map_add, ih₁, ih₂]
          split_ifs <;> simp
      simp [hterm]
    let e₂ : (Fin r → TensorProduct A B (Polynomial A)) ≃ TensorProduct A B (Fin r → Polynomial A) :=
      { toFun := G₂, invFun := G₁, left_inv := hG₁G₂, right_inv := hG₂G₁ }
    let e₁ : (Fin r → Polynomial B) ≃ (Fin r → TensorProduct A B (Polynomial A)) :=
      Equiv.piCongrRight (fun _ => (polyEquivTensor' A B).toEquiv)
    let E_tot : (Fin r → Polynomial B) ≃ R_B :=
      e₁.trans (e₂.trans (e₃.toEquiv.trans eR.toEquiv))
    have hE_eq : (fun f : Fin r → Polynomial B =>
        Finset.univ.sum fun j => ψ_B (f j) * eR ((1 : B) ⊗ₜ[A] b j)) = E_tot := by
      ext f
      change Finset.univ.sum (fun j => ψ_B (f j) * eR ((1 : B) ⊗ₜ[A] b j)) =
        eR (e₃ (Finset.univ.sum fun j =>
          LinearMap.baseChange B (inj_j j) (polyEquivTensor' A B (f j))))
      rw [map_sum, map_sum]
      apply Finset.sum_congr rfl
      intro j _
      have h_single : ∀ u : TensorProduct A B (Polynomial A),
          e₃ (LinearMap.baseChange B (inj_j j) u) =
            (Algebra.TensorProduct.map (AlgHom.id A B)
              (IsScalarTower.toAlgHom A (Polynomial A) R) u) * ((1 : B) ⊗ₜ[A] b j) := by
        intro u
        induction u using TensorProduct.inductionOn with
        | tmul β p =>
          dsimp [e₃, Φ_A_equiv, Φ_A_lin, inj_j]
          simp only [mul_one]
          congr 1
          have hite : (fun j_1 : Fin r => algebraMap (Polynomial A) R (if j_1 = j then p else 0) * b j_1) =
              fun j_1 => if j_1 = j then algebraMap (Polynomial A) R p * b j else 0 := by
            ext j_1
            split_ifs with h
            · subst h; rfl
            · rw [map_zero, zero_mul]
          rw [hite]
          simp
        | add u₁ u₂ ih₁ ih₂ =>
          rw [map_add, map_add, ih₁, ih₂, map_add, add_mul]
      rw [h_single, map_mul]
      rfl
    have hBij_B : Function.Bijective (fun f : Fin r → Polynomial B =>
        Finset.univ.sum fun j => ψ_B (f j) * eR ((1 : B) ⊗ₜ[A] b j)) := by
      rw [hE_eq]
      exact E_tot.bijective
    
    have hπ_B_b : ∀ j : Fin r, π_B (eR ((1 : B) ⊗ₜ[A] b j)) = b_bar (Fin.cast hr j) := by
      intro j
      rw [hπ_B_tmul, map_one, map_one, map_one, one_mul, hπ_b j]
    have hψ_C : ∀ β : B, ψ_B (Polynomial.C β) = eR (β ⊗ₜ[A] 1) := by
      intro β
      dsimp [ψ_B]
      simp
    have hψ_X : ψ_B Polynomial.X = eR ((1 : B) ⊗ₜ[A] algebraMap (Polynomial A) R Polynomial.X) := by
      dsimp [ψ_B]
      simp
    have hπ_B_poly : ∀ p : Polynomial B,
        π_B (ψ_B p) = algebraMap (Polynomial k) R_bar (Polynomial.map τ_B.toRingHom p) := by
      have h_hom : π_B.comp ψ_B =
          (algebraMap (Polynomial k) R_bar).comp (Polynomial.mapRingHom τ_B.toRingHom) := by
        apply Polynomial.ringHom_ext'
        · ext β
          simp only [RingHom.comp_apply, hψ_C, hπ_B_tmul, map_one, mul_one,
            Polynomial.coe_mapRingHom, Polynomial.map_C]
          rfl
        · simp only [RingHom.comp_apply, hψ_X, hπ_B_tmul, map_one, one_mul,
            hπ_poly Polynomial.X, Polynomial.coe_mapRingHom, Polynomial.map_X]
      intro p
      exact RingHom.congr_fun h_hom p
    have hπ_B_surj : Function.Surjective π_B := by
      intro y_bar
      obtain ⟨r_el, hr_el⟩ := hπ_surj y_bar
      refine ⟨eR ((1 : B) ⊗ₜ[A] r_el), ?_⟩
      rw [hπ_B_tmul, map_one, map_one, map_one, one_mul, hr_el]
    have hπ_B_ker : RingHom.ker π_B = Ideal.map (ψ_B.comp Polynomial.C) (RingHom.ker τ_B.toRingHom) := by
      apply le_antisymm
      · intro z hz
        rw [RingHom.mem_ker] at hz
        obtain ⟨f, rfl⟩ := hBij_B.2 z
        dsimp only at hz ⊢
        rw [map_sum] at hz
        have hz' : (Finset.univ.sum fun j : Fin r =>
            algebraMap (Polynomial k) R_bar (Polynomial.map τ_B.toRingHom (f j)) *
              b_bar (Fin.cast hr j)) = 0 := by
          rw [← hz]
          apply Finset.sum_congr rfl
          intro j _
          rw [map_mul, hπ_B_poly (f j), hπ_B_b j]
        let f_bar : Fin r₀ → Polynomial k := fun j₀ =>
          Polynomial.map τ_B.toRingHom (f (Fin.cast hr.symm j₀))
        have hf_bar_sum : (Finset.univ.sum fun j₀ : Fin r₀ =>
            algebraMap (Polynomial k) R_bar (f_bar j₀) * b_bar j₀) =
            (Finset.univ.sum fun j₀ : Fin r₀ =>
              algebraMap (Polynomial k) R_bar (0 : Polynomial k) * b_bar j₀) := by
          simp only [map_zero, zero_mul, Finset.sum_const_zero]
          rw [← (Fin.castOrderIso hr).toEquiv.sum_comp]
          rw [← hz']
          apply Finset.sum_congr rfl
          intro j _
          dsimp [f_bar]
          congr 2
        have hf_bar_zero : f_bar = 0 := hBij_bar.1 hf_bar_sum
        have hf_map_zero : ∀ j : Fin r, Polynomial.map τ_B.toRingHom (f j) = 0 := by
          intro j
          have h1 := congrFun hf_bar_zero (Fin.cast hr j)
          simpa [f_bar] using h1
        apply Submodule.sum_mem
        intro j _
        rw [Polynomial.as_sum_support_C_mul_X_pow (f j), map_sum, Finset.sum_mul]
        apply Submodule.sum_mem
        intro s _
        rw [map_mul, mul_assoc]
        apply Ideal.mul_mem_right
        have hcoeff : τ_B.toRingHom ((f j).coeff s) = 0 := by
          have := congrArg (fun P => Polynomial.coeff P s) (hf_map_zero j)
          simpa [Polynomial.coeff_map] using this
        exact Ideal.mem_map_of_mem (ψ_B.comp Polynomial.C) hcoeff
      · rw [Ideal.map_le_iff_le_comap]
        intro β hβ
        rw [RingHom.mem_ker] at hβ
        change π_B (ψ_B (Polynomial.C β)) = 0
        rw [hψ_C, hπ_B_tmul]
        change algebraMap (Polynomial k) R_bar (Polynomial.C (τ_B.toRingHom β)) * π 1 = 0
        rw [hβ, map_zero, map_zero, zero_mul]
    exact ⟨π_B, hπ_B_tmul, hBij_B, hπ_B_b, hπ_B_poly, hπ_B_surj, hπ_B_ker⟩

  
  have hAwayBC :
      ∀ {B : Type u} [CommRing B] [Algebra A B]
        {R : Type u} [CommRing R] [Algebra A R]
        {R₀₁ : Type u} [CommRing R₀₁] [Algebra A R₀₁] [Algebra R R₀₁] [IsScalarTower A R R₀₁]
        (x : R) [IsLocalization.Away x R₀₁]
        {R_B : Type u} [CommRing R_B] (eR : TensorProduct A B R ≃+* R_B)
        {R₀₁_B : Type u} [CommRing R₀₁_B] (eR₀₁ : TensorProduct A B R₀₁ ≃+* R₀₁_B)
        [Algebra R_B R₀₁_B],
        (∀ z : TensorProduct A B R,
          algebraMap R_B R₀₁_B (eR z) =
            eR₀₁ (Algebra.TensorProduct.map (AlgHom.id A B) (IsScalarTower.toAlgHom A R R₀₁) z)) →
        IsLocalization.Away (eR ((1 : B) ⊗ₜ[A] x)) R₀₁_B := by
    intro B _ _ R _ _ R₀₁ _ _ _ _ x hAway R_B _ eR R₀₁_B _ eR₀₁ _ halg_eq
    let _ : Algebra R R_B := (eR.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom).toAlgebra
    have hLocTensor : IsLocalization.Away (eR ((1 : B) ⊗ₜ[A] x)) (TensorProduct R R_B R₀₁) :=
      @IsLocalization.Away.tensor R R_B _ _ _ x R₀₁ _ _ hAway
    let _ : Algebra R R₀₁_B := ((algebraMap R_B R₀₁_B).comp (algebraMap R R_B)).toAlgebra
    have : IsScalarTower R R_B R₀₁_B := IsScalarTower.of_algebraMap_eq' rfl
    let g_right : R₀₁ →ₐ[R] R₀₁_B :=
      { toRingHom := eR₀₁.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom
        commutes' := fun r_el => by
          change eR₀₁ ((1 : B) ⊗ₜ[A] algebraMap R R₀₁ r_el) =
            algebraMap R_B R₀₁_B (eR ((1 : B) ⊗ₜ[A] r_el))
          rw [halg_eq ((1 : B) ⊗ₜ[A] r_el), Algebra.TensorProduct.map_tmul,
            AlgHom.id_apply, IsScalarTower.coe_toAlgHom'] }
    let F : TensorProduct R R_B R₀₁ →ₐ[R_B] R₀₁_B :=
      Algebra.TensorProduct.lift (Algebra.ofId R_B R₀₁_B) g_right (fun _ _ => Commute.all _ _)
    have hF_tmul : ∀ (s_B : R_B) (z : R₀₁),
        F (s_B ⊗ₜ[R] z) = algebraMap R_B R₀₁_B s_B * eR₀₁ ((1 : B) ⊗ₜ[A] z) :=
      fun s_B z => Algebra.TensorProduct.lift_tmul _ _ _ s_B z
    let G_bilin : B →+ R₀₁ →+ TensorProduct R R_B R₀₁ :=
      { toFun := fun β =>
          { toFun := fun z => eR (β ⊗ₜ[A] 1) ⊗ₜ[R] z
            map_zero' := TensorProduct.tmul_zero _ _
            map_add' := fun z₁ z₂ => TensorProduct.tmul_add _ z₁ z₂ }
        map_zero' := by ext z; simp
        map_add' := fun β₁ β₂ => by
          ext z; dsimp
          rw [TensorProduct.add_tmul, map_add, TensorProduct.add_tmul] }
    have hG_smul : ∀ (a : A) (β : B) (z : R₀₁),
        G_bilin (a • β) z = G_bilin β (a • z) := by
      intro a β z
      dsimp [G_bilin]
      have h1 : (a • β) ⊗ₜ[A] (1 : R) = (β ⊗ₜ[A] (1 : R)) * ((1 : B) ⊗ₜ[A] algebraMap A R a) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
          TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
      have h2 : eR ((a • β) ⊗ₜ[A] (1 : R)) = (algebraMap A R a) • eR (β ⊗ₜ[A] (1 : R)) := by
        rw [h1, map_mul, Algebra.smul_def, mul_comm]
        rfl
      rw [h2, TensorProduct.smul_tmul, IsScalarTower.algebraMap_smul]
    let G_pre : TensorProduct A B R₀₁ →+ TensorProduct R R_B R₀₁ :=
      TensorProduct.liftAddHom G_bilin hG_smul
    let G : R₀₁_B →+ TensorProduct R R_B R₀₁ := G_pre.comp eR₀₁.symm.toAddMonoidHom
    have hFG : Function.RightInverse G F := by
      intro v
      obtain ⟨u, rfl⟩ : ∃ u, eR₀₁ u = v := ⟨eR₀₁.symm v, eR₀₁.apply_symm_apply v⟩
      change F (G_pre (eR₀₁.symm (eR₀₁ u))) = eR₀₁ u
      rw [RingEquiv.symm_apply_apply]
      induction u using TensorProduct.inductionOn with
      | tmul β z =>
        change F (eR (β ⊗ₜ[A] 1) ⊗ₜ[R] z) = eR₀₁ (β ⊗ₜ[A] z)
        rw [hF_tmul, halg_eq (β ⊗ₜ[A] 1), Algebra.TensorProduct.map_tmul,
          AlgHom.id_apply, IsScalarTower.coe_toAlgHom', map_one, ← map_mul,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add u₁ u₂ ih₁ ih₂ =>
        rw [map_add, map_add, ih₁, ih₂, map_add]
    have hGF : Function.LeftInverse G F := by
      intro w
      induction w using TensorProduct.inductionOn with
      | tmul s_B z =>
        obtain ⟨u, rfl⟩ : ∃ u, eR u = s_B := ⟨eR.symm s_B, eR.apply_symm_apply s_B⟩
        induction u using TensorProduct.inductionOn with
        | tmul β r_el =>
          rw [hF_tmul, halg_eq (β ⊗ₜ[A] r_el), Algebra.TensorProduct.map_tmul,
            AlgHom.id_apply, IsScalarTower.coe_toAlgHom']
          change G_pre (eR₀₁.symm (eR₀₁ (β ⊗ₜ[A] algebraMap R R₀₁ r_el) * eR₀₁ ((1 : B) ⊗ₜ[A] z))) = _
          rw [← map_mul, RingEquiv.symm_apply_apply, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
          change eR (β ⊗ₜ[A] 1) ⊗ₜ[R] (algebraMap R R₀₁ r_el * z) = eR (β ⊗ₜ[A] r_el) ⊗ₜ[R] z
          rw [← Algebra.smul_def, ← TensorProduct.smul_tmul, Algebra.smul_def]
          have hr : algebraMap R R_B r_el * eR (β ⊗ₜ[A] 1) = eR (β ⊗ₜ[A] r_el) := by
            change eR ((1 : B) ⊗ₜ[A] r_el) * eR (β ⊗ₜ[A] 1) = eR (β ⊗ₜ[A] r_el)
            rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
          rw [hr]
        | add u₁ u₂ ih₁ ih₂ =>
          rw [map_add, TensorProduct.add_tmul, map_add, map_add, ih₁, ih₂]
      | add w₁ w₂ ih₁ ih₂ =>
        rw [map_add, map_add, ih₁, ih₂]
    let e_loc : TensorProduct R R_B R₀₁ ≃ₐ[R_B] R₀₁_B :=
      AlgEquiv.ofBijective F (Function.bijective_iff_has_inverse.mpr ⟨G, hGF, hFG⟩)
    exact @IsLocalization.isLocalization_of_algEquiv R_B _
      (Submonoid.powers (eR ((1 : B) ⊗ₜ[A] x))) (TensorProduct R R_B R₀₁) _ _ R₀₁_B _ _
      hLocTensor e_loc

  
  have hStep2 :
      ∀ (B : Type u) [CommRing B] [Algebra k B] [Algebra A B] (τ_B : B →ₐ[k] k),
        IsNoetherianRing B → IsLocalRing B → (∀ b : B, τ_B b = 0 ↔ ¬ IsUnit b) →
        (∀ a : A, τ_B (algebraMap A B a) = τ_A a) →
        ∀ (u_B : Fin D.r → Fin m_U → B),
          (∀ (j : Fin D.r) (k₀ : Fin m_U), τ_B (u_B j k₀) = 0) →
          ∀ y₀ : M.L₀,
            ∃ (v : Fin D.r × Fin q → B) (m : ℕ) (β : Fin m → B) (r₀ : Fin m → D.R₀),
              ((1 : B) ⊗ₜ[A] y₀ : TensorProduct A B M.L₀) -
                Finset.univ.sum (fun p : Fin D.r × Fin q =>
                  (v p) ⊗ₜ[A] ((t ^ p.2.val * D.b₀ p.1) • σ₀)) =
              Finset.univ.sum (fun ν : Fin m =>
                (β ν) ⊗ₜ[A] (r₀ ν • w_base₀) +
                  Finset.univ.sum (fun p' : Fin D.r × Fin m_U =>
                    (β ν * u_B p'.1 p'.2) ⊗ₜ[A] (r₀ ν • w_U₀ p'.1 p'.2))) := by
    intro B _ _ _ τ_B hB_noeth hB_loc hB_ker hτ_AB u_B hu_B y₀
    let algA₁ : Algebra A D.R₁ := ((algebraMap (Polynomial A) D.R₁).comp Polynomial.C).toAlgebra
    have hTowerA₁ : IsScalarTower A (Polynomial A) D.R₁ := IsScalarTower.of_algebraMap_eq' rfl
    let algA₀₁ : Algebra A D.R₀₁ := ((algebraMap D.R₀ D.R₀₁).comp (algebraMap A D.R₀)).toAlgebra
    have hTowerA₀_₀₁ : IsScalarTower A D.R₀ D.R₀₁ := IsScalarTower.of_algebraMap_eq' rfl
    obtain ⟨hr_pos, hBij₀, hBij₁, hAway₀, hAway₁, htu₀₁, hScalarA, hw_b⟩ := hValid.1
    obtain ⟨_, hBij₀_bar, hBij₁_bar, _, _, _, hScalar_k, _⟩ := hValid.2.1
    obtain ⟨⟨hr_eq, hw_eq, hb₀_eq, hb₁_eq⟩, hPoly₀, hPoly₁, hSurj₀, _, hSurj₁, _⟩ := hValid.2.2
    have hTowerA₁_₀₁ : IsScalarTower A D.R₁ D.R₀₁ :=
      IsScalarTower.of_algebraMap_eq fun a => hScalarA a
    
    obtain ⟨R₀_B, hRing₀_B, ⟨eR₀⟩⟩ :
        ∃ (R₀_B : Type u) (_ : CommRing R₀_B), Nonempty (TensorProduct A B D.R₀ ≃+* R₀_B) :=
      ⟨TensorProduct A B D.R₀, inferInstance, ⟨RingEquiv.refl _⟩⟩
    obtain ⟨R₁_B, hRing₁_B, ⟨eR₁⟩⟩ :
        ∃ (R₁_B : Type u) (_ : CommRing R₁_B), Nonempty (TensorProduct A B D.R₁ ≃+* R₁_B) :=
      ⟨TensorProduct A B D.R₁, inferInstance, ⟨RingEquiv.refl _⟩⟩
    obtain ⟨R₀₁_B, hRing₀₁_B, ⟨eR₀₁⟩⟩ :
        ∃ (R₀₁_B : Type u) (_ : CommRing R₀₁_B), Nonempty (TensorProduct A B D.R₀₁ ≃+* R₀₁_B) :=
      ⟨TensorProduct A B D.R₀₁, inferInstance, ⟨RingEquiv.refl _⟩⟩
    let ψ₀_B : Polynomial B →+* R₀_B :=
      eR₀.toRingHom.comp
        ((Algebra.TensorProduct.map (AlgHom.id A B)
          (IsScalarTower.toAlgHom A (Polynomial A) D.R₀)).toRingHom.comp
          (polyEquivTensor' A B).toRingHom)
    let ψ₁_B : Polynomial B →+* R₁_B :=
      eR₁.toRingHom.comp
        ((Algebra.TensorProduct.map (AlgHom.id A B)
          (IsScalarTower.toAlgHom A (Polynomial A) D.R₁)).toRingHom.comp
          (polyEquivTensor' A B).toRingHom)
    let ι₀_B : R₀_B →+* R₀₁_B :=
      eR₀₁.toRingHom.comp
        ((Algebra.TensorProduct.map (AlgHom.id A B)
          (IsScalarTower.toAlgHom A D.R₀ D.R₀₁)).toRingHom.comp eR₀.symm.toRingHom)
    let ι₁_B : R₁_B →+* R₀₁_B :=
      eR₀₁.toRingHom.comp
        ((Algebra.TensorProduct.map (AlgHom.id A B)
          (IsScalarTower.toAlgHom A D.R₁ D.R₀₁)).toRingHom.comp eR₁.symm.toRingHom)
    let algPoly₀_B : Algebra (Polynomial B) R₀_B := ψ₀_B.toAlgebra
    let algPoly₁_B : Algebra (Polynomial B) R₁_B := ψ₁_B.toAlgebra
    let alg₀_B : Algebra R₀_B R₀₁_B := ι₀_B.toAlgebra
    let alg₁_B : Algebra R₁_B R₀₁_B := ι₁_B.toAlgebra
    let D_B : WeilTwoChartRingDatum B :=
      { r := D.r
        w := D.w
        R₀ := R₀_B
        R₁ := R₁_B
        R₀₁ := R₀₁_B
        ring₀ := hRing₀_B
        ring₁ := hRing₁_B
        ring₀₁ := hRing₀₁_B
        algPoly₀ := algPoly₀_B
        algPoly₁ := algPoly₁_B
        alg₀ := alg₀_B
        alg₁ := alg₁_B
        b₀ := fun j => eR₀ ((1 : B) ⊗ₜ[A] D.b₀ j)
        b₁ := fun j => eR₁ ((1 : B) ⊗ₜ[A] D.b₁ j) }
    obtain ⟨π₀_B, hπ₀_tmul, hBij₀_B, hπ₀_b, hπ₀_poly, hπ₀_surj, hπ₀_ker⟩ :=
      hChartBC τ_B hτ_AB hr_eq π₀ D.b₀ D₀.b₀ hBij₀ hBij₀_bar hb₀_eq hPoly₀ hSurj₀ eR₀
    obtain ⟨π₁_B, hπ₁_tmul, hBij₁_B, hπ₁_b, hπ₁_poly, hπ₁_surj, hπ₁_ker⟩ :=
      hChartBC τ_B hτ_AB hr_eq π₁ D.b₁ D₀.b₁ hBij₁ hBij₁_bar hb₁_eq hPoly₁ hSurj₁ eR₁
    
    let _ : Algebra D.R₀₁ D₀.R₀₁ := red.algR₀₁
    let _ : Algebra D.R₀ D₀.R₀₁ := red.algR₀_₀₁
    let _ : Algebra D.R₁ D₀.R₀₁ := red.algR₁_₀₁
    have : IsScalarTower D.R₀ D₀.R₀ D₀.R₀₁ := red.tower₀_bar
    have : IsScalarTower D.R₀ D.R₀₁ D₀.R₀₁ := red.tower₀_loc
    have : IsScalarTower D.R₁ D₀.R₁ D₀.R₀₁ := red.tower₁_bar
    have : IsScalarTower D.R₁ D.R₀₁ D₀.R₀₁ := red.tower₁_loc
    let algA_R₀₁bar : Algebra A D₀.R₀₁ :=
      ((algebraMap D₀.R₀ D₀.R₀₁).comp
        (((algebraMap (Polynomial k) D₀.R₀).comp Polynomial.C).comp τ_A.toRingHom)).toAlgebra
    let φ₀₁_left : B →ₐ[A] D₀.R₀₁ :=
      { toRingHom := (algebraMap D₀.R₀ D₀.R₀₁).comp
          (((algebraMap (Polynomial k) D₀.R₀).comp Polynomial.C).comp τ_B.toRingHom)
        commutes' := fun a => by
          change algebraMap D₀.R₀ D₀.R₀₁ (algebraMap (Polynomial k) D₀.R₀
            (Polynomial.C (τ_B (algebraMap A B a)))) =
            algebraMap D₀.R₀ D₀.R₀₁ (algebraMap (Polynomial k) D₀.R₀ (Polynomial.C (τ_A a)))
          rw [hτ_AB a] }
    let φ₀₁_right : D.R₀₁ →ₐ[A] D₀.R₀₁ :=
      { toRingHom := algebraMap D.R₀₁ D₀.R₀₁
        commutes' := fun a => by
          change algebraMap D.R₀₁ D₀.R₀₁ (algebraMap D.R₀ D.R₀₁
            (algebraMap (Polynomial A) D.R₀ (Polynomial.C a))) =
            algebraMap D₀.R₀ D₀.R₀₁ (algebraMap (Polynomial k) D₀.R₀ (Polynomial.C (τ_A a)))
          rw [← IsScalarTower.algebraMap_apply D.R₀ D.R₀₁ D₀.R₀₁,
            IsScalarTower.algebraMap_apply D.R₀ D₀.R₀ D₀.R₀₁,
            hPoly₀ (Polynomial.C a), Polynomial.map_C]
          rfl }
    let π₀₁_tensor : TensorProduct A B D.R₀₁ →+* D₀.R₀₁ :=
      (Algebra.TensorProduct.lift φ₀₁_left φ₀₁_right (fun _ _ => Commute.all _ _)).toRingHom
    let π₀₁_B : R₀₁_B →+* D₀.R₀₁ := π₀₁_tensor.comp eR₀₁.symm.toRingHom
    have hπ₀₁_tmul : ∀ (β : B) (z : D.R₀₁),
        π₀₁_B (eR₀₁ (β ⊗ₜ[A] z)) =
          algebraMap D₀.R₀ D₀.R₀₁ (algebraMap (Polynomial k) D₀.R₀ (Polynomial.C (τ_B β))) *
            algebraMap D.R₀₁ D₀.R₀₁ z := by
      intro β z
      change π₀₁_tensor (eR₀₁.symm (eR₀₁ (β ⊗ₜ[A] z))) = _
      rw [RingEquiv.symm_apply_apply]
