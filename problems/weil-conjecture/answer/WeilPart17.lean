            hom_inv_id := by ext x; exact (e_add W).symm_apply_apply x
            inv_hom_id := by ext y; exact (e_add W).apply_symm_apply y })
        (fun {W₁ W₂} ω => by
          have hmap_ω : (F_U.cohomologyPresheaf 0).map ω =
              ((Abelian.extFunctor 0).map (Z_fun.op.map ω)).app F_U := rfl
          rw [hmap_ω, Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) F_U]
          ext α
          let u : Z_obj W₁ ⟶ F_U := Abelian.Ext.addEquiv₀ α
          have hα : α = Abelian.Ext.mk₀ u := (Abelian.Ext.mk₀_addEquiv₀_apply α).symm
          change e_raw W₂ ((Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp α (Nat.zero_add 0)) =
            ((U_U.obj F_U).map ω).hom (e_raw W₁ α)
          rw [hα]
          have hZw : (Z_fun.op.map ω).unop = L_tot.map (yoneda.map ω.unop) := rfl
          rw [hZw, Abelian.Ext.mk₀_comp_mk₀]
          dsimp [e_raw]
          rw [← Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
            Adjunction.homEquiv_naturality_left, ← yonedaEquiv_naturality',
            ← Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
          rfl)
    let Sh_Z := presheafToSheaf J_Z AddCommGrpCat.{u}
    let e_whisk : B_πU.op ⋙ F_U.cohomologyPresheaf 0 ≅
        (sheafToPresheaf J_Z AddCommGrpCat.{u}).obj (pf_πU.obj F_U) :=
      Functor.isoWhiskerLeft B_πU.op θ_F
    let e_counit : Sh_Z.obj ((sheafToPresheaf J_Z AddCommGrpCat.{u}).obj (pf_πU.obj F_U)) ≅
