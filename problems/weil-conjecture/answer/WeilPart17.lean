    have huℤ_T : (shAdj_C.unit.app Pℤ_C).app (Opposite.op T) ≫ uℤ.hom.app (Opposite.op T) =
        (shAdj_C₀.unit.app Pℤ_C₀).app (Opposite.op (B_h.obj T)) :=
