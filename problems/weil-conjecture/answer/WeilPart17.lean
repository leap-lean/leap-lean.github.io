theorem weil_etale_torsion_pullback_functoriality : (∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂) (m i : ℕ),
      ∃ p : weilEtaleTorsionH S₂ m i →+ weilEtaleTorsionH S₁ m i,
        WeilIsTorsionEtalePullback h m i p) ∧
    (∀ {S : AlgebraicGeometry.Scheme.{u}} (m i : ℕ)
      (p : weilEtaleTorsionH S m i →+ weilEtaleTorsionH S m i),
      WeilIsTorsionEtalePullback (CategoryTheory.CategoryStruct.id S) m i p →
      p = AddMonoidHom.id _) ∧
    (∀ {S₁ S₂ S₃ : AlgebraicGeometry.Scheme.{u}} (h₁ : S₁ ⟶ S₂) (h₂ : S₂ ⟶ S₃) (m i : ℕ)
      (p₁ : weilEtaleTorsionH S₂ m i →+ weilEtaleTorsionH S₁ m i)
      (p₂ : weilEtaleTorsionH S₃ m i →+ weilEtaleTorsionH S₂ m i)
      (p₁₂ : weilEtaleTorsionH S₃ m i →+ weilEtaleTorsionH S₁ m i),
      WeilIsTorsionEtalePullback h₁ m i p₁ →
      WeilIsTorsionEtalePullback h₂ m i p₂ →
