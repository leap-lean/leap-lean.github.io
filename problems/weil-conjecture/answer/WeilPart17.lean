            simp only [CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
              ((AlgebraicGeometry.Spec.map inl_P).appTop ≫ β.hom.appTop) ≫ W.topIso.hom := by
            rw [AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality]
            simp only [CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
