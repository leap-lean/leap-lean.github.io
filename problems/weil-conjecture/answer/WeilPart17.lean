        | add v₁ v₂ hv₁ hv₂ =>
          rw [TensorProduct.tmul_add, map_add, map_add, map_add, add_smul, hv₁, hv₂]
      | add u₁ u₂ hu₁ hu₂ =>
        rw [TensorProduct.add_tmul, map_add, map_add, smul_add, hu₁, hu₂]
    have htmul_smul₀ : ∀ (r₀ : D.R₀) (x : M.L₀),
        (1 : D.R₀₁) ⊗ₜ[D.R₀] (r₀ • x) =
          algebraMap D.R₀ D.R₀₁ r₀ • ((1 : D.R₀₁) ⊗ₜ[D.R₀] x) := by
      intro r₀ x
      rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul', TensorProduct.smul_tmul',
        Algebra.smul_def, smul_eq_mul]
    apply hTrivCrit D E α₀ α₁ τE₀ τE₁ hτE₀ hτE₁
    let θ_E := (TensorProduct.AlgebraTensorModule.distribBaseChange D.R₀ D.R₀₁
        M.L₀ (WeilTwoChartPow D N_inv ℓ).L₀).trans
      ((TensorProduct.AlgebraTensorModule.congr M.θ (WeilTwoChartPow D N_inv ℓ).θ).trans
        (TensorProduct.AlgebraTensorModule.distribBaseChange D.R₁ D.R₀₁
          M.L₁ (WeilTwoChartPow D N_inv ℓ).L₁).symm)
    change ∀ t₀ : E₀_tp, α₁_hat (θ_E ((1 : D.R₀₁) ⊗ₜ[D.R₀] t₀)) = algebraMap D.R₀ D.R₀₁ (α₀ t₀)
    intro t₀
    apply hw₁_loc_reg
    rw [← hM₁_α₁]
    induction t₀ using TensorProduct.induction_on with
    | zero => simp
    | tmul m₀ z =>
      simp only [θ_E, LinearEquiv.trans_apply,
        TensorProduct.AlgebraTensorModule.distribBaseChange_tmul,
        TensorProduct.AlgebraTensorModule.congr_tmul]
      rw [hM₁_distrib, hΓ_pow_θ ℓ z, mul_smul, ← map_smul, ← htmul_smul₀]
      have hμ_tmul : γ₀ ℓ z • m₀ = α₀ (m₀ ⊗ₜ[D.R₀] z) • w₀ := (hα₀_spec (m₀ ⊗ₜ[D.R₀] z)).symm
      rw [hμ_tmul, htmul_smul₀, map_smul, ← mul_smul, mul_comm, mul_smul, hw_gl]
    | add t₁ t₂ ih₁ ih₂ =>
      rw [TensorProduct.tmul_add, map_add, map_add, map_add, map_add, add_smul, ih₁, ih₂]

theorem weil_monic_twoChart_divisor_bundle_assembly (k : Type u) [Field k]
    (ℓ : ℕ) (hℓ_pos : 1 ≤ ℓ)
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (D : WeilTwoChartRingDatum A)
    (D₀ : WeilTwoChartRingDatum k)
    (red : WeilTwoChartCurveReduction D D₀)
    (hA : WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A)
    (hValid : WeilIsValidTwoChartCurveReduction τ_A D D₀ red)
    (M : WeilTwoChartLineBundle D)
    (n : ℕ) (hn_pos : 1 ≤ n) (hn_w : ∀ j : Fin D.r, D.w j < n)
    (hWeierstrass : ∀ (d : ℕ) (P : Polynomial A),
      Polynomial.map τ_A.toRingHom P = Polynomial.X ^ d →
      ∃ G_near G_far : Polynomial A,
        G_near.Monic ∧
        G_near.natDegree = d ∧
        Polynomial.map τ_A.toRingHom G_near = Polynomial.X ^ d ∧
        Polynomial.map τ_A.toRingHom G_far = 1 ∧
        P = G_near * G_far ∧
        IsCoprime G_near G_far)
    (lam₀ : M.L₀ →ₗ[D.R₀] D.R₀) (lam₁ : M.L₁ →ₗ[D.R₁] D.R₁)
    (σ₀ : M.L₀) (c : Fin D.r → Fin n → A) (w₀ : M.L₀) (w₁ : M.L₁) :
    letI : Algebra D.R₀ D₀.R₀ := red.algR₀
    letI : Algebra D.R₁ D₀.R₁ := red.algR₁
    let t : D.R₀ := algebraMap (Polynomial A) D.R₀ Polynomial.X
    let u : D.R₁ := algebraMap (Polynomial A) D.R₁ Polynomial.X
    let u₀₁ : D.R₀₁ := algebraMap D.R₁ D.R₀₁ u
    let t_bar : D₀.R₀ := algebraMap (Polynomial k) D₀.R₀ Polynomial.X
    let π₀ : D.R₀ →+* D₀.R₀ := algebraMap D.R₀ D₀.R₀
    let π₁ : D.R₁ →+* D₀.R₁ := algebraMap D.R₁ D₀.R₁
    (∀ x τ : M.L₀, lam₀ x • τ = lam₀ τ • x) →
    (∀ y τ : M.L₁, lam₁ y • τ = lam₁ τ • y) →
    π₀ (lam₀ σ₀) = 1 →
    (∀ (j : Fin D.r) (s : Fin n), τ_A (c j s) = 0) →
    u₀₁ ^ (ℓ * n) • M.θ (TensorProduct.tmul D.R₀ (1 : D.R₀₁) w₀) =
      TensorProduct.tmul D.R₁ (1 : D.R₀₁) w₁ →
    π₀ (lam₀ w₀) = t_bar ^ (ℓ * n) →
    π₁ (lam₁ w₁) = 1 →
    Function.Bijective (fun v : Fin D.r × Fin (ℓ * n) → A =>
      Finset.univ.sum fun p =>
        (Submodule.span D.R₀ {w₀}).mkQ
          ((algebraMap (Polynomial A) D.R₀ (Polynomial.C (v p)) * t ^ p.2.val * D.b₀ p.1) • σ₀)) →
    ((t ^ n + Finset.univ.sum fun j : Fin D.r =>
        Finset.univ.sum fun s : Fin n =>
          algebraMap (Polynomial A) D.R₀ (Polynomial.C (c j s)) * t ^ s.val * D.b₀ j) ^ ℓ) • σ₀ ∈
      Submodule.span D.R₀ {w₀} →
    (∀ y : M.L₁ ⧸ Submodule.span D.R₁ {w₁},
      ∃ y' : M.L₁ ⧸ Submodule.span D.R₁ {w₁}, u • y' = y) →
    ∃ N_inv : WeilTwoChartLineBundle D,
      WeilTwoChartIso D₀ (WeilTwoChartBaseChange red N_inv) (WeilTwoChartTrivial D₀) ∧
      WeilTwoChartIso D (WeilTwoChartMul D M (WeilTwoChartPow D N_inv ℓ))
        (WeilTwoChartTrivial D) :=
by
  let _ : Algebra D.R₀ D₀.R₀ := red.algR₀
  let _ : Algebra D.R₁ D₀.R₁ := red.algR₁
  intro t u u₀₁ t_bar π₀ π₁ hSymm₀ hSymm₁ hσ₀_red hc_ker hw_gl hw₀_red hw₁_red hBij hPow hU
  set u_bar : D₀.R₁ := algebraMap (Polynomial k) D₀.R₁ Polynomial.X
  obtain ⟨hNzd, hInvTwoGen⟩ := weil_monic_polyBasis_krull_nzd_and_invertible_ideal.{u}
  have : IsNoetherianRing A := hA.1
  have : IsLocalRing A := hA.2.1
  have hτ_unit : ∀ a : A, τ_A a = 0 ↔ ¬ IsUnit a := hA.2.2.1
  have hker_τ : RingHom.ker τ_A.toRingHom = IsLocalRing.maximalIdeal A := by
    ext a
    rw [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hτ_unit,
      IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  have hD : WeilIsValidTwoChartRingDatum D := hValid.1
  have hD₀ : WeilIsValidTwoChartRingDatum D₀ := hValid.2.1
  have hπ₀_poly : ∀ p : Polynomial A,
      π₀ (algebraMap (Polynomial A) D.R₀ p) =
        algebraMap (Polynomial k) D₀.R₀ (Polynomial.map τ_A.toRingHom p) :=
    hValid.2.2.2.1
  have hπ₁_poly : ∀ p : Polynomial A,
      π₁ (algebraMap (Polynomial A) D.R₁ p) =
        algebraMap (Polynomial k) D₀.R₁ (Polynomial.map τ_A.toRingHom p) :=
    hValid.2.2.2.2.1
  have hker_π₀ : RingHom.ker π₀ =
      Ideal.map ((algebraMap (Polynomial A) D.R₀).comp Polynomial.C) (IsLocalRing.maximalIdeal A) := by
    rw [← hker_τ]
    exact hValid.2.2.2.2.2.2.1
  have hker_π₁ : RingHom.ker π₁ =
      Ideal.map ((algebraMap (Polynomial A) D.R₁).comp Polynomial.C) (IsLocalRing.maximalIdeal A) := by
    rw [← hker_τ]
    exact hValid.2.2.2.2.2.2.2.2
  have ht_red : π₀ t = t_bar := by
    dsimp [t, t_bar]
    rw [hπ₀_poly Polynomial.X, Polynomial.map_X]
  have hu_red : π₁ u = u_bar := by
    dsimp [u, u_bar]
    rw [hπ₁_poly Polynomial.X, Polynomial.map_X]
  have hu_nzd : ∀ y : D.R₁, u * y = 0 → y = 0 := by
    apply hNzd A D.R₁ D.r D.b₁ hD.2.2.1 1 u
    have h0 : u - (algebraMap (Polynomial A) D.R₁ Polynomial.X) ^ 1 = 0 := by
      dsimp [u]
      rw [pow_one, sub_self]
    rw [h0]
    exact Ideal.zero_mem _
  have htbar_nzd : ∀ z : D₀.R₀, t_bar ^ n * z = 0 → z = 0 := by
    apply hNzd k D₀.R₀ D₀.r D₀.b₀ hD₀.2.1 n (t_bar ^ n)
    have h0 : t_bar ^ n - (algebraMap (Polynomial k) D₀.R₀ Polynomial.X) ^ n = 0 := by
      dsimp [t_bar]
      rw [sub_self]
    rw [h0]
    exact Ideal.zero_mem _
  have hw₀_nzd : ∀ r₀ : D.R₀, lam₀ w₀ * r₀ = 0 → r₀ = 0 := by
    apply hNzd A D.R₀ D.r D.b₀ hD.2.1 (ℓ * n) (lam₀ w₀)
    rw [← hker_π₀, RingHom.mem_ker, map_sub, hw₀_red]
    change t_bar ^ (ℓ * n) - π₀ (t ^ (ℓ * n)) = 0
    rw [map_pow, ht_red, sub_self]
  have hw₁_nzd : ∀ r₁ : D.R₁, lam₁ w₁ * r₁ = 0 → r₁ = 0 := by
    apply hNzd A D.R₁ D.r D.b₁ hD.2.2.1 0 (lam₁ w₁)
    rw [← hker_π₁, RingHom.mem_ker, map_sub, hw₁_red, pow_zero, map_one, sub_self]
  set f_c : D.R₀ := t ^ n + Finset.univ.sum fun j : Fin D.r =>
    Finset.univ.sum fun s : Fin n =>
      algebraMap (Polynomial A) D.R₀ (Polynomial.C (c j s)) * t ^ s.val * D.b₀ j
  have hfc_red : π₀ f_c = t_bar ^ n := by
    dsimp [f_c]
    rw [map_add, map_pow, ht_red]
    have hsum0 : π₀ (Finset.univ.sum fun j : Fin D.r =>
        Finset.univ.sum fun s : Fin n =>
          algebraMap (Polynomial A) D.R₀ (Polynomial.C (c j s)) * t ^ s.val * D.b₀ j) = 0 := by
      rw [map_sum]
      apply Finset.sum_eq_zero
      intro j _
      rw [map_sum]
      apply Finset.sum_eq_zero
      intro s _
      rw [map_mul, map_mul, hπ₀_poly (Polynomial.C (c j s)), Polynomial.map_C]
      have hc0 : τ_A.toRingHom (c j s) = 0 := hc_ker j s
      rw [hc0, Polynomial.C_0, map_zero, zero_mul, zero_mul]
    rw [hsum0, add_zero]
  have hf_c_nzd : ∀ y : D.R₀, f_c * y = 0 → y = 0 := by
    apply hNzd A D.R₀ D.r D.b₀ hD.2.1 n f_c
    rw [← hker_π₀, RingHom.mem_ker, map_sub, hfc_red]
    change t_bar ^ n - π₀ (t ^ n) = 0
    rw [map_pow, ht_red, sub_self]
  obtain ⟨G_near, G_far, h_c, hGn_monic, hGn_deg, hGn_red, hCop, hMul_fc, hJ₀_red, hSpan₀⟩ :=
    weil_monic_chartZero_weierstrass_divisor_span k ℓ hℓ_pos A τ_A D D₀ red hA hValid n hn_pos
      hWeierstrass M.L₀ lam₀ σ₀ c w₀ hSymm₀ hσ₀_red hc_ker hBij hPow
  set g_near : D.R₀ := algebraMap (Polynomial A) D.R₀ G_near
  set g_far : D.R₀ := algebraMap (Polynomial A) D.R₀ G_far
  set J₀ : Ideal D.R₀ := Ideal.span ({f_c, g_near} : Set D.R₀)
  have hRel₀ : g_near * g_far = f_c * h_c := by
    dsimp [g_near, g_far]
    rw [← map_mul]
    exact hMul_fc
  obtain ⟨u₁, u₂, hBez₀⟩ := hCop.map (algebraMap (Polynomial A) D.R₀)
  have hBez₀_triv : (1 : D.R₀) * (1 : D.R₀) + (0 : D.R₀) * g_near = 1 := by ring
  have : Module.Invertible D.R₀ ↥J₀ :=
    hInvTwoGen D.R₀ f_c g_near g_far h_c 1 u₁ u₂ 1 0 hf_c_nzd hRel₀ hBez₀ hBez₀_triv
  obtain ⟨F_c₁, h_near, G_far₁, H_c₁, u_star, v₁, v₂, a₁, b₁,
      hFc₁_red, hh_red, hRel₁, hBez₁, hBez₂, hMapEq, hSpan₁⟩ :=
    weil_monic_chartOne_reciprocal_ideal_and_section_span k ℓ A τ_A D D₀ red hValid M n hn_w
      lam₁ c w₀ w₁ G_near G_far h_c hSymm₁ hw₁_nzd hc_ker hw_gl hU
      hGn_monic hGn_deg hGn_red hCop hMul_fc hSpan₀
  set J₁ : Ideal D.R₁ := Ideal.span ({F_c₁, h_near} : Set D.R₁)
  have hFc₁_nzd : ∀ y : D.R₁, F_c₁ * y = 0 → y = 0 := by
    apply hNzd A D.R₁ D.r D.b₁ hD.2.2.1 n F_c₁
    rw [← hker_π₁, RingHom.mem_ker, map_sub, hFc₁_red]
    change u_bar ^ n - π₁ (u ^ n) = 0
    rw [map_pow, hu_red, sub_self]
  have : Module.Invertible D.R₁ ↥J₁ :=
    hInvTwoGen D.R₁ F_c₁ h_near G_far₁ H_c₁ u_star v₁ v₂ a₁ b₁ hFc₁_nzd hRel₁ hBez₁ hBez₂
  exact weil_twoChart_ideal_lineBundle_gluing_and_iso k ℓ n A D D₀ red M lam₀ lam₁ w₀ w₁ J₀ J₁
    hD.2.2.2.1 hD.2.2.2.2.1 hD.2.2.2.2.2.1 hu_red hD₀.2.2.2.2.2.1
    hu_nzd htbar_nzd hMapEq hJ₀_red
    ⟨f_c, Ideal.subset_span (by simp), hfc_red⟩
    ⟨h_near, Ideal.subset_span (by simp), hh_red⟩
    hSpan₀ hSpan₁ hw₀_nzd hw₁_nzd hw_gl

theorem weil_monic_twoChart_pic_ker_divisible (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (D : WeilTwoChartRingDatum A)
    (D₀ : WeilTwoChartRingDatum k)
    (red : WeilTwoChartCurveReduction D D₀)
    (hA : WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A)
    (hValid : WeilIsValidTwoChartCurveReduction τ_A D D₀ red)
    (M : WeilTwoChartLineBundle D)
    (hTriv₀ : WeilTwoChartIso D₀ (WeilTwoChartBaseChange red M) (WeilTwoChartTrivial D₀)) :
    ∃ N_inv : WeilTwoChartLineBundle D,
      WeilTwoChartIso D₀ (WeilTwoChartBaseChange red N_inv) (WeilTwoChartTrivial D₀) ∧
      WeilTwoChartIso D (WeilTwoChartMul D M (WeilTwoChartPow D N_inv ℓ)) (WeilTwoChartTrivial D) :=
by
  let _ : Algebra D.R₀ D₀.R₀ := red.algR₀
  let _ : Algebra D.R₁ D₀.R₁ := red.algR₁
  let n : ℕ := Finset.univ.sup D.w + 1
  have hn_pos : 1 ≤ n := Nat.le_add_left 1 (Finset.univ.sup D.w)
  have hn_w : ∀ j : Fin D.r, D.w j < n := fun j =>
    Nat.lt_succ_of_le (Finset.le_sup (f := D.w) (Finset.mem_univ j))
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_two : 2 ≤ ℓ := hℓ_prime.two_le
  have hℓ_pos : 1 ≤ ℓ := by omega
  have hq : ∀ j : Fin D.r, D.w j ≤ ℓ * n := by
    intro j
    calc
      D.w j ≤ n := Nat.le_of_lt (hn_w j)
      _ = 1 * n := (one_mul n).symm
      _ ≤ ℓ * n := Nat.mul_le_mul_right n hℓ_pos
  have hk : ∀ (j : Fin D.r) (k₀ : Fin ((ℓ - 1) * n)), k₀.val + D.w j ≤ ℓ * n := by
    intro j k₀
    have hk₀ : k₀.val < (ℓ - 1) * n := k₀.isLt
    have hw_j : D.w j < n := hn_w j
    have hsum : (ℓ - 1) * n + n = ℓ * n := by
      calc
        (ℓ - 1) * n + n = (ℓ - 1) * n + 1 * n := by rw [one_mul]
        _ = (ℓ - 1 + 1) * n := (add_mul (ℓ - 1) 1 n).symm
        _ = ℓ * n := by rw [Nat.sub_add_cancel hℓ_pos]
    omega
  obtain ⟨hHensel, hWeierstrass⟩ :=
    weil_henselian_mvPoly_and_weierstrass_split k A τ_A hA
  obtain ⟨lam₀, lam₁, σ₀, w_base₀, w_base₁, w_fam₀, w_fam₁, hSymm, hσ₀, hBase, hFam⟩ :=
    weil_monic_twoChart_serre_section_lifts k A τ_A D D₀ red hA hValid M hTriv₀ (ℓ * n) hq
  let w_U₀ : Fin D.r → Fin ((ℓ - 1) * n) → M.L₀ := fun j k₀ => w_fam₀ j k₀.val (hk j k₀)
  let w_U₁ : Fin D.r → Fin ((ℓ - 1) * n) → M.L₁ := fun j k₀ => w_fam₁ j k₀.val (hk j k₀)
  obtain ⟨c, w₀, w₁, hc, hw, hBij, hPow, hU⟩ :=
    weil_monic_twoChart_cayley_hamilton_div_root k ℓ hℓ A τ_A D D₀ red hA hValid M n hn_pos hn_w
      hHensel lam₀ lam₁ σ₀ w_base₀ w_base₁ w_U₀ w_U₁ hSymm.1 hSymm.2 hσ₀
      hBase.1 hBase.2.1 hBase.2.2
      (fun j k₀ => ⟨(hFam j k₀.val (hk j k₀)).1, (hFam j k₀.val (hk j k₀)).2.1⟩)
  exact weil_monic_twoChart_divisor_bundle_assembly k ℓ hℓ_pos A τ_A D D₀ red hA hValid M
    n hn_pos hn_w hWeierstrass lam₀ lam₁ σ₀ c w₀ w₁
    hSymm.1 hSymm.2 hσ₀ hc hw.1 hw.2.1 hw.2.2 hBij hPow hU

theorem weil_pbc_projLine_finite_cover_deg_one_surjective (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (hA : WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A)
    (Y : AlgebraicGeometry.Scheme.{u})
    (π : Y ⟶ CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
      (weilProjectiveSpaceOver k 1).hom)
    [AlgebraicGeometry.IsFinite π] :
    WeilEtaleCohomologyPullbackSurjective
      (CategoryTheory.Limits.pullback.snd
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
        (π ≫ CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
          (weilProjectiveSpaceOver k 1).hom))
      (weilEtaleTorsionSheaf Y ℓ) 1 :=
by
  have eq_of_one_tmul : ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
      {M Q : Type u} [AddCommGroup M] [Module R M] [AddCommGroup Q] [Module S Q]
      (f g : TensorProduct R S M ≃ₗ[S] Q),
      (∀ m : M, f ((1 : S) ⊗ₜ[R] m) = g ((1 : S) ⊗ₜ[R] m)) → f = g := by
    intro R S _ _ _ M Q _ _ _ _ f g h
    ext z
    induction z using TensorProduct.inductionOn with
    | tmul s m =>
      have hs : s ⊗ₜ[R] m = s • ((1 : S) ⊗ₜ[R] m) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [hs, map_smul, map_smul, h m]
    | add x y hx hy =>
      rw [map_add, map_add, hx, hy]
  have eq_of_one_tmul₂ : ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
      {M N Q : Type u} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
      [AddCommGroup Q] [Module S Q]
      (f g : TensorProduct R S (TensorProduct R M N) ≃ₗ[S] Q),
      (∀ (m : M) (n : N), f ((1 : S) ⊗ₜ[R] (m ⊗ₜ[R] n)) = g ((1 : S) ⊗ₜ[R] (m ⊗ₜ[R] n))) →
      f = g := by
    intro R S _ _ _ M N Q _ _ _ _ _ _ f g h
    apply eq_of_one_tmul
    intro mn
    induction mn using TensorProduct.inductionOn with
    | tmul m n => exact h m n
    | add x y hx hy => rw [TensorProduct.tmul_add, map_add, map_add, hx, hy]
  have eq_of_one_tmul₃ : ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
      {M N P Q : Type u} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
      [AddCommGroup P] [Module R P] [AddCommGroup Q] [Module S Q]
      (f g : TensorProduct R S (TensorProduct R (TensorProduct R M N) P) ≃ₗ[S] Q),
      (∀ (m : M) (n : N) (p : P),
        f ((1 : S) ⊗ₜ[R] ((m ⊗ₜ[R] n) ⊗ₜ[R] p)) = g ((1 : S) ⊗ₜ[R] ((m ⊗ₜ[R] n) ⊗ₜ[R] p))) →
      f = g := by
