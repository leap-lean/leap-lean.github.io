  obtain ⟨m₂, w₂_tilde, hm₂⟩ :=
    clear_u (t₀₁ ^ (k_far + k_h + 2 * n) * u₀₁ ^ d * ι₀ u₂)
  let u_star : D.R₁ := u ^ (m₁ + m₂)
  let v₁ : D.R₁ := u ^ m₂ * w₁_tilde
  let v₂ : D.R₁ := u ^ m₁ * w₂_tilde
  have hBez₁ : v₁ * h_near + v₂ * G_far₁ = u_star := by
