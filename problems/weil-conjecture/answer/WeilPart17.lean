        have hpow : t01_bar ^ m₀ = t01_bar ^ (m₀ - k_exp a) * algebraMap D₀.R₀ D₀.R₀₁ (t_bar ^ k_exp a) := by
          rw [map_pow, ← pow_add, Nat.sub_add_cancel hle]
        rw [hpow]
        ring
      choose r_fn hr_fn using h_each
      refine ⟨∑ a : Fin q₀, r_fn a, ?_⟩
      rw [map_sum]
      simp_rw [hr_fn]
      rw [← Finset.mul_sum, ← map_sum, ← map_sum, ← TensorProduct.tmul_sum]
      dsimp [v₀]
      simp_rw [map_smul]
    let Φ₀ : E₀.L₀ →ₗ[D₀.R₀] D₀.R₀ :=
      { toFun := fun x => Classical.choose (hΦ₀_ex x)
        map_add' := fun x y => hinj₀ (by
          rw [map_add, Classical.choose_spec (hΦ₀_ex (x + y)),
            Classical.choose_spec (hΦ₀_ex x), Classical.choose_spec (hΦ₀_ex y),
            TensorProduct.tmul_add, map_add, map_add, mul_add])
        map_smul' := fun r x => hinj₀ (by
          simp only [RingHom.id_apply, smul_eq_mul, map_mul,
            Classical.choose_spec (hΦ₀_ex (r • x)), Classical.choose_spec (hΦ₀_ex x)]
          have htm : (1 : D₀.R₀₁) ⊗ₜ[D₀.R₀] (r • x) =
              (algebraMap D₀.R₀ D₀.R₀₁ r) • ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₀] x) := by
            rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
              TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [htm, map_smul, map_smul, smul_eq_mul]
          ring) }
    have hΦ₀_spec : ∀ x : E₀.L₀,
        algebraMap D₀.R₀ D₀.R₀₁ (Φ₀ x) = t01_bar ^ m₀ * Λ₀₁ (E₀.θ ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₀] x)) :=
      fun x => Classical.choose_spec (hΦ₀_ex x)
    have hΦ₀_ov : ∀ x : E₀.L₀,
        Λ₀₁ (E₀.θ ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₀] x)) = u01_bar ^ m₀ * algebraMap D₀.R₀ D₀.R₀₁ (Φ₀ x) := by
      intro x
      rw [hΦ₀_spec x, ← mul_assoc, ← mul_pow, mul_comm u01_bar t01_bar, htu₀₁, one_pow, one_mul]
    obtain ⟨m₁, sig0_bar, hsig0_bar⟩ := away_clear_tmul t_bar (E₀.θ.symm ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₁] s1_bar))
    have hθ_sig0 : E₀.θ ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₀] sig0_bar) =
        (t01_bar ^ m₁) • ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₁] s1_bar) := by
      rw [← hsig0_bar, map_smul, E₀.θ.apply_symm_apply]
    let g_reg_bar := Φ₀ sig0_bar
    have hg_reg_spec : algebraMap D₀.R₀ D₀.R₀₁ g_reg_bar =
        t01_bar ^ (m₀ + m₁) * algebraMap D₀.R₁ D₀.R₀₁ (lam₁ s1_bar) := by
      rw [hΦ₀_spec sig0_bar, hθ_sig0, map_smul, smul_eq_mul]
      have hΛ : Λ₀₁ ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₁] s1_bar) = algebraMap D₀.R₁ D₀.R₀₁ (lam₁ s1_bar) := by
        simp [Λ₀₁, Algebra.smul_def]
      rw [hΛ, pow_add]
      ring
    have hg_reg_bar : ∀ y : D₀.R₀, g_reg_bar * y = 0 → y = 0 := by
      intro y hy
      have h0 : algebraMap D₀.R₀ D₀.R₀₁ (g_reg_bar * y) = 0 := by rw [hy, map_zero]
      rw [map_mul, hg_reg_spec] at h0
      have h1 : algebraMap D₀.R₁ D₀.R₀₁ (lam₁ s1_bar) * algebraMap D₀.R₀ D₀.R₀₁ y = 0 := by
        calc
          algebraMap D₀.R₁ D₀.R₀₁ (lam₁ s1_bar) * algebraMap D₀.R₀ D₀.R₀₁ y =
              (t01_bar * u01_bar) ^ (m₀ + m₁) *
                (algebraMap D₀.R₁ D₀.R₀₁ (lam₁ s1_bar) * algebraMap D₀.R₀ D₀.R₀₁ y) := by
            rw [htu₀₁, one_pow, one_mul]
          _ = u01_bar ^ (m₀ + m₁) * (t01_bar ^ (m₀ + m₁) * algebraMap D₀.R₁ D₀.R₀₁ (lam₁ s1_bar) *
                algebraMap D₀.R₀ D₀.R₀₁ y) := by ring
          _ = 0 := by rw [h0, mul_zero]
      let k_y := (IsLocalization.Away.sec u_bar (algebraMap D₀.R₀ D₀.R₀₁ y)).2
      let r_y := (IsLocalization.Away.sec u_bar (algebraMap D₀.R₀ D₀.R₀₁ y)).1
      have hsec_y : algebraMap D₀.R₀ D₀.R₀₁ y * algebraMap D₀.R₁ D₀.R₀₁ (u_bar ^ k_y) =
          algebraMap D₀.R₁ D₀.R₀₁ r_y :=
        IsLocalization.Away.sec_spec u_bar (algebraMap D₀.R₀ D₀.R₀₁ y)
      have hr_y0 : lam₁ s1_bar * r_y = 0 := by
        apply hinj₁
        rw [map_zero, map_mul, ← hsec_y, ← mul_assoc, h1, zero_mul]
      have hry_zero : r_y = 0 := hh1_reg r_y hr_y0
      rw [hry_zero, map_zero, map_pow] at hsec_y
      have hy0 : algebraMap D₀.R₀ D₀.R₀₁ y = 0 := by
        calc
          algebraMap D₀.R₀ D₀.R₀₁ y = algebraMap D₀.R₀ D₀.R₀₁ y * (t01_bar * u01_bar) ^ k_y := by
            rw [htu₀₁, one_pow, mul_one]
          _ = (algebraMap D₀.R₀ D₀.R₀₁ y * u01_bar ^ k_y) * t01_bar ^ k_y := by ring
          _ = 0 := by rw [hsec_y, zero_mul]
      exact hinj₀ (hy0.trans (map_zero _).symm)
    have hΦ₀_inj : Function.Injective Φ₀ := invertible_hom_injective_of_reg Φ₀ sig0_bar hg_reg_bar
    let J₀ : Ideal D₀.R₀ := LinearMap.range Φ₀
    let I₁ : Ideal D₀.R₁ := LinearMap.range lam₁
    have hI₁_eq : I₁ = Ideal.comap (algebraMap D₀.R₁ D₀.R₀₁)
        (Ideal.map (algebraMap D₀.R₀ D₀.R₀₁) J₀) := by
      ext y₁
      constructor
      · rintro ⟨x₁, rfl⟩
        obtain ⟨k₁, x₀, hx₀⟩ := away_clear_tmul t_bar (E₀.θ.symm ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₁] x₁))
        have hθ_x₀ : E₀.θ ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₀] x₀) = (t01_bar ^ k₁) • ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₁] x₁) := by
          rw [← hx₀, map_smul, E₀.θ.apply_symm_apply]
        have hΛ : Λ₀₁ ((1 : D₀.R₀₁) ⊗ₜ[D₀.R₁] x₁) = algebraMap D₀.R₁ D₀.R₀₁ (lam₁ x₁) := by
          simp [Λ₀₁, Algebra.smul_def]
        have hrel : algebraMap D₀.R₁ D₀.R₀₁ (lam₁ x₁) =
            u01_bar ^ (m₀ + k₁) * algebraMap D₀.R₀ D₀.R₀₁ (Φ₀ x₀) := by
          have h2 := hΦ₀_ov x₀
          rw [hθ_x₀, map_smul, smul_eq_mul, hΛ] at h2
          calc
            algebraMap D₀.R₁ D₀.R₀₁ (lam₁ x₁) =
                (u01_bar * t01_bar) ^ k₁ * algebraMap D₀.R₁ D₀.R₀₁ (lam₁ x₁) := by
              rw [mul_comm u01_bar t01_bar, htu₀₁, one_pow, one_mul]
            _ = u01_bar ^ k₁ * (t01_bar ^ k₁ * algebraMap D₀.R₁ D₀.R₀₁ (lam₁ x₁)) := by ring
            _ = u01_bar ^ (m₀ + k₁) * algebraMap D₀.R₀ D₀.R₀₁ (Φ₀ x₀) := by rw [h2]; ring
        rw [Ideal.mem_comap, hrel]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ ⟨x₀, rfl⟩)
      · intro hy₁
        rw [Ideal.mem_comap] at hy₁
        have hJ₀_le_I₁ : Ideal.map (algebraMap D₀.R₀ D₀.R₀₁) J₀ ≤
            Ideal.map (algebraMap D₀.R₁ D₀.R₀₁) I₁ := by
          rw [Ideal.map_le_iff_le_comap]
          rintro _ ⟨x₀, rfl⟩
          rw [Ideal.mem_comap, hΦ₀_spec x₀]
          refine Ideal.mul_mem_left _ _ ?_
          have hΛ_mem : ∀ z : TensorProduct D₀.R₁ D₀.R₀₁ E₀.L₁,
              Λ₀₁ z ∈ Ideal.map (algebraMap D₀.R₁ D₀.R₀₁) I₁ := by
            intro z
            induction z using TensorProduct.induction_on with
            | zero => simp
            | tmul r₀₁ x₁ =>
              simp only [Λ₀₁, LinearMap.comp_apply, LinearMap.baseChange_tmul,
                LinearEquiv.coe_coe, TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def]
              exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ⟨x₁, rfl⟩)
            | add z₁ z₂ ih₁ ih₂ => rw [map_add]; exact Ideal.add_mem _ ih₁ ih₂
          exact hΛ_mem _
        obtain ⟨N, w₁, hw₁_mem, hNw₁⟩ := away_clear_ideal_map u_bar I₁ (hJ₀_le_I₁ hy₁)
        have huNy : u_bar ^ N * y₁ = w₁ := hinj₁ (by rw [map_mul, map_pow, hNw₁])
        have h1_sub : ∀ n : ℕ, 1 - (-z1_bar * u_bar) ^ n ∈ I₁ := by
          intro n
          induction n with
          | zero => simp
          | succ n ih =>
            have hstep : 1 - (-z1_bar * u_bar) ^ (n + 1) =
                (1 + u_bar * z1_bar) + (1 - (1 + u_bar * z1_bar)) * (1 - (-z1_bar * u_bar) ^ n) := by ring
            rw [hstep, ← hh1_eq]
            exact I₁.add_mem ⟨s1_bar, rfl⟩ (I₁.mul_mem_left _ ih)
        have hy_decomp : y₁ = (1 - (-z1_bar * u_bar) ^ N) * y₁ + (-z1_bar) ^ N * (u_bar ^ N * y₁) := by ring
        rw [hy_decomp, huNy]
        exact I₁.add_mem (I₁.mul_mem_right _ (h1_sub N)) (I₁.mul_mem_left _ hw₁_mem)
    let γ₀ : D₀.R₀ := t_bar * g_reg_bar
    have hγ₀_mem : γ₀ ∈ J₀ := J₀.mul_mem_left t_bar ⟨sig0_bar, rfl⟩
    have hγ₀_reg : ∀ x : D₀.R₀, γ₀ * x = 0 → x = 0 := by
      intro x hx
      exact hg_reg_bar x (ht_bar_reg (g_reg_bar * x) (by simpa [γ₀, mul_assoc] using hx))
    have hγ₀_sq_reg : ∀ x : D₀.R₀, γ₀ ^ 2 * x = 0 → x = 0 := by
      intro x hx
      exact hγ₀_reg x (hγ₀_reg (γ₀ * x) (by simpa [sq, mul_assoc] using hx))
    let K₀ : Ideal D₀.R₀ := Ideal.span {γ₀ ^ 2}
    let B_K := D₀.R₀ ⧸ K₀
    obtain ⟨Q_γ, hQ_γ_monic, hQ_γ_mem⟩ := det_mulLeft_mem_and_ne_zero D₀.b₀ hb₀ (γ₀ ^ 2) hγ₀_sq_reg
    haveI hBK_art : IsArtinianRing B_K := by
      letI : Algebra k B_K :=
        ((Ideal.Quotient.mk K₀).comp ((algebraMap (Polynomial k) D₀.R₀).comp Polynomial.C)).toAlgebra
      haveI : Module.Finite k B_K :=
        quotient_finite_of_monic_mem D₀.b₀ hb₀ K₀ Q_γ hQ_γ_monic hQ_γ_mem
      exact IsArtinianRing.of_finite k B_K
    let eJ₀ : E₀.L₀ ≃ₗ[D₀.R₀] ↥J₀ := LinearEquiv.ofInjective Φ₀ hΦ₀_inj
    haveI : Module.Invertible D₀.R₀ ↥J₀ := Module.Invertible.congr eJ₀
    have hBK_free : Module.Free B_K (TensorProduct D₀.R₀ B_K ↥J₀) := inferInstance
    obtain ⟨e_K⟩ := (Module.Invertible.free_iff_linearEquiv
      (R := B_K) (M := TensorProduct D₀.R₀ B_K ↥J₀)).mp hBK_free
    obtain ⟨g0_sub, hg0_sub⟩ := htmul_surj D₀.R₀ K₀ ↥J₀ (e_K.symm 1)
    have he_g0_sub : e_K ((1 : B_K) ⊗ₜ[D₀.R₀] g0_sub) = 1 := by
      rw [hg0_sub, e_K.apply_symm_apply]
    let g₀ : D₀.R₀ := g0_sub.1
    have h_mod_K₀ : ∀ x : ↥J₀, ∃ r s : D₀.R₀, s ∈ J₀ ∧ x.1 = r * g₀ + γ₀ ^ 2 * s := by
      intro x
      obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (e_K ((1 : B_K) ⊗ₜ[D₀.R₀] x))
      have hzero_tmul : (1 : B_K) ⊗ₜ[D₀.R₀] (x - r • g0_sub) = 0 := by
        apply e_K.injective
        rw [map_zero, TensorProduct.tmul_sub, map_sub]
        have htm : (1 : B_K) ⊗ₜ[D₀.R₀] (r • g0_sub) =
            (Ideal.Quotient.mk K₀ r) • ((1 : B_K) ⊗ₜ[D₀.R₀] g0_sub) := by
          rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
            TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rfl
        rw [htm, map_smul, hr, he_g0_sub, smul_eq_mul, mul_one, sub_self]
      let N_sub : Submodule D₀.R₀ ↥J₀ := K₀ • ⊤
      let f_bil : D₀.R₀ →ₗ[D₀.R₀] (↥J₀ →ₗ[D₀.R₀] (↥J₀ ⧸ N_sub)) :=
        { toFun := fun r₀ => r₀ • Submodule.mkQ N_sub
          map_add' := fun a₁ a₂ => by ext y; simp [add_smul]
          map_smul' := fun c a => by ext y; simp [mul_smul] }
      let bil_N : B_K →ₗ[D₀.R₀] (↥J₀ →ₗ[D₀.R₀] (↥J₀ ⧸ N_sub)) :=
        Submodule.liftQ K₀ f_bil
          (by
            intro r₀ hr₀
            rw [LinearMap.mem_ker]
            ext y
            change (r₀ • N_sub.mkQ) y = 0
            rw [LinearMap.smul_apply, ← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
            exact Submodule.smul_mem_smul hr₀ trivial)
      let lift_N : TensorProduct D₀.R₀ B_K ↥J₀ →ₗ[D₀.R₀] (↥J₀ ⧸ N_sub) :=
        TensorProduct.lift bil_N
      have hmem_N : x - r • g0_sub ∈ N_sub := by
        have h1 := congrArg lift_N hzero_tmul
        rw [map_zero] at h1
        have h2 : lift_N ((1 : B_K) ⊗ₜ[D₀.R₀] (x - r • g0_sub)) =
            Submodule.Quotient.mk (p := N_sub) (x - r • g0_sub) := by
          change ((1 : D₀.R₀) • N_sub.mkQ) (x - r • g0_sub) = _
          rw [one_smul, Submodule.mkQ_apply]
        rw [h2] at h1
        exact (Submodule.Quotient.mk_eq_zero N_sub).mp h1
      have hval_mem : (x - r • g0_sub).1 ∈ K₀ * J₀ := by
        refine Submodule.smul_induction_on' hmem_N ?_ ?_
        · intro k₀ hk₀ y _
          exact Ideal.mul_mem_mul hk₀ y.2
        · intro y₁ _ y₂ _ ih₁ ih₂
          exact Ideal.add_mem _ ih₁ ih₂
      have h_sJ₀ : ∀ z ∈ K₀ * J₀, ∃ s ∈ J₀, z = γ₀ ^ 2 * s := by
        intro z hz
        refine Submodule.smul_induction_on' hz ?_ ?_
        · intro k₀ hk₀ y hy
          obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp hk₀
          exact ⟨c * y, J₀.mul_mem_left c hy, by ring⟩
        · intro z₁ _ z₂ _ ⟨s₁, hs₁, h₁⟩ ⟨s₂, hs₂, h₂⟩
          exact ⟨s₁ + s₂, J₀.add_mem hs₁ hs₂, by rw [h₁, h₂, mul_add]⟩
      obtain ⟨s, hs, hs_eq⟩ := h_sJ₀ _ hval_mem
      refine ⟨r, s, hs, ?_⟩
      change x.1 - r * g₀ = γ₀ ^ 2 * s at hs_eq
      calc
        x.1 = r * g₀ + (x.1 - r * g₀) := by ring
        _ = r * g₀ + γ₀ ^ 2 * s := by rw [hs_eq]
    obtain ⟨r₀, s₀, _, hγ₀_eq⟩ := h_mod_K₀ ⟨γ₀, hγ₀_mem⟩
    have hg₀_reg : ∀ x : D₀.R₀, g₀ * x = 0 → x = 0 := by
      intro x hx
      have hfac : γ₀ * (1 + t_bar * (-g_reg_bar * s₀)) = r₀ * g₀ := by
        dsimp [γ₀] at hγ₀_eq ⊢
        calc
          t_bar * g_reg_bar * (1 + t_bar * (-g_reg_bar * s₀)) =
              t_bar * g_reg_bar - (t_bar * g_reg_bar) ^ 2 * s₀ := by ring
          _ = (r₀ * g₀ + (t_bar * g_reg_bar) ^ 2 * s₀) - (t_bar * g_reg_bar) ^ 2 * s₀ := by
            rw [← hγ₀_eq]
          _ = r₀ * g₀ := by ring
      have h1 : γ₀ * ((1 + t_bar * (-g_reg_bar * s₀)) * x) = 0 := by
        calc
          γ₀ * ((1 + t_bar * (-g_reg_bar * s₀)) * x) = (γ₀ * (1 + t_bar * (-g_reg_bar * s₀))) * x := by ring
          _ = r₀ * (g₀ * x) := by rw [hfac]; ring
          _ = 0 := by rw [hx, mul_zero]
      exact polyBasis_one_add_X_mul_reg D₀.b₀ hb₀ (-g_reg_bar * s₀) x (hγ₀_reg _ h1)
    let S_g : Submodule D₀.R₀ ↥J₀ := Submodule.span D₀.R₀ {g0_sub}
    let M_quo := ↥J₀ ⧸ S_g
    haveI : Module.Finite D₀.R₀ ↥J₀ := Module.Finite.of_surjective eJ₀.toLinearMap eJ₀.surjective
    have hM_fg : (⊤ : Submodule D₀.R₀ M_quo).FG := Module.Finite.fg_top
    have hM_le : (⊤ : Submodule D₀.R₀ M_quo) ≤ J₀ • ⊤ := by
      intro m _
      obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective S_g m
      obtain ⟨r, s, hs, hx_eq⟩ := h_mod_K₀ x
      have hx_diff : x - γ₀ • (⟨γ₀ * s, J₀.mul_mem_left γ₀ hs⟩ : ↥J₀) = r • g0_sub := by
        apply Subtype.ext
        change x.1 - γ₀ * (γ₀ * s) = r * g₀
        rw [hx_eq]
        ring
      have hmk : Submodule.Quotient.mk (p := S_g) x =
          γ₀ • Submodule.Quotient.mk (p := S_g) ⟨γ₀ * s, J₀.mul_mem_left γ₀ hs⟩ := by
        rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.eq, hx_diff]
        exact Submodule.smul_mem _ r (Submodule.subset_span rfl)
      rw [hmk]
      exact Submodule.smul_mem_smul hγ₀_mem trivial
    obtain ⟨r_nak, hr_mem, hr_ann⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul J₀ ⊤ hM_fg hM_le
    let e₀ : D₀.R₀ := 1 - r_nak
    have he₀_mem : e₀ ∈ J₀ := by
      have : e₀ = -(r_nak - 1) := by ring
      rw [this]
      exact Submodule.neg_mem J₀ hr_mem
    have hr_J₀ : ∀ x ∈ J₀, r_nak * x ∈ Ideal.span {g₀} := by
      intro x hx
      have h0 := hr_ann (Submodule.Quotient.mk (p := S_g) ⟨x, hx⟩) trivial
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
        Submodule.mem_span_singleton] at h0
      obtain ⟨c, hc⟩ := h0
      have hc_val : c * g₀ = r_nak * x := congrArg Subtype.val hc
      exact Ideal.mem_span_singleton.mpr ⟨c, hc_val.symm.trans (mul_comm c g₀)⟩
    have he₀_idem : e₀ * (1 - e₀) ∈ Ideal.span {g₀} := by
      have : e₀ * (1 - e₀) = r_nak * e₀ := by dsimp [e₀]; ring
      rw [this]
      exact hr_J₀ e₀ he₀_mem
    have hJ₀_span : J₀ = Ideal.span {e₀, g₀} := by
      apply le_antisymm
      · intro x hx
        have hx_split : x = x * e₀ + r_nak * x := by dsimp [e₀]; ring
        rw [hx_split]
        refine Ideal.add_mem _ ?_ ?_
        · exact Ideal.mul_mem_left _ x (Ideal.subset_span (by simp))
        · exact Ideal.span_mono (by simp) (hr_J₀ x hx)
      · rw [Ideal.span_le]
        rintro y (rfl | rfl)
        · exact he₀_mem
        · exact g0_sub.2
    refine ⟨m₀, g₀, e₀, Φ₀, lam₁, hg₀_reg, he₀_idem, hΦ₀_inj, hJ₀_span, hlam₁_inj, ?_, hΦ₀_ov⟩
    rw [← hJ₀_span]
