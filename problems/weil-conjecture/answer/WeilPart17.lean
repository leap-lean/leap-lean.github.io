          change Φ₀₁' (alg₀'_hom (AdjoinRoot.of f₀ x)) = algebraMap B₀ B₀₁ (Φ₀' (AdjoinRoot.of f₀ x))
          simp only [alg₀'_hom, Φ₀₁', Φ₀', AdjoinRoot.lift_of, RingHom.comp_apply]
          exact RingHom.congr_fun hΦ₀₁_₀ x
        · change Φ₀₁' (alg₀'_hom (AdjoinRoot.root f₀)) = algebraMap B₀ B₀₁ (Φ₀' (AdjoinRoot.root f₀))
          simp [alg₀'_hom, Φ₀₁', Φ₀']
      · apply AdjoinRoot.ringHom_ext
        · apply RingHom.ext; intro x
          change Φ₀₁' (alg₁'_hom (AdjoinRoot.of f₁ x)) = algebraMap B₁ B₀₁ (Φ₁' (AdjoinRoot.of f₁ x))
          simp only [alg₁'_hom, Φ₀₁', Φ₁', AdjoinRoot.lift_of, RingHom.comp_apply]
          exact RingHom.congr_fun hΦ₀₁_₁ x
        · change Φ₀₁' (alg₁'_hom (AdjoinRoot.root f₁)) = algebraMap B₁ B₀₁ (Φ₁' (AdjoinRoot.root f₁))
          simp only [alg₁'_hom, Φ₀₁', Φ₁', AdjoinRoot.lift_root, map_mul, AdjoinRoot.lift_of, map_pow]
          have hu_Φ : Φ₀₁ u₀₁_X = algebraMap B₁ B₀₁ (algebraMap (Polynomial A) B₁ Polynomial.X) := by
            dsimp [u₀₁_X]
            have h1 := RingHom.congr_fun hΦ₀₁_₁ (algebraMap (Polynomial A) D.R₁ Polynomial.X)
            have h2 := RingHom.congr_fun hΦ₁_alg Polynomial.X
