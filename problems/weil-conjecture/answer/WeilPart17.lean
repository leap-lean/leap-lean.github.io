              ((CategoryTheory.Abelian.Ext.mk₀ inv_f).precomp (pb_f.obj (pf_f.obj E)) (Nat.zero_add q)
                ((pb_f.mapExtAddHom Fℤ_S (pf_f.obj E) q) x))
            let rhs := (CategoryTheory.Abelian.Ext.mk₀ inv_g').precomp (pb_g'.obj E) (Nat.zero_add q)
