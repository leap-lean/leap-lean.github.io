have weil_part1_test (k : Type u) [Field k]
    (A : Type u) [CommRing A] [Algebra k A]
    (Y : AlgebraicGeometry.Scheme.{u})
    (π : Y ⟶ CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
      (weilProjectiveSpaceOver k 1).hom)
    [AlgebraicGeometry.IsFinite π] :
    let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
    let P₁ := weilProjectiveSpaceOver k 1
    let X_A := CategoryTheory.Limits.pullback s_A P₁.hom
    let p_A := CategoryTheory.Limits.pullback.fst s_A P₁.hom
    ∃ (w₀ w₁ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A)) ⟶ X_A)
      (B₀ B₁ B₀₁ : Type u)
      (_ : CommRing B₀) (_ : CommRing B₁) (_ : CommRing B₀₁)
      (_ : Algebra (Polynomial A) B₀) (_ : Module.Finite (Polynomial A) B₀)
      (_ : Algebra (Polynomial A) B₁) (_ : Module.Finite (Polynomial A) B₁)
      (_ : Algebra B₀ B₀₁) (_ : Algebra B₁ B₀₁)
      (y₀ : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ Y)
      (y₁ : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶ Y),
      AlgebraicGeometry.IsOpenImmersion w₀ ∧
      AlgebraicGeometry.IsOpenImmersion w₁ ∧
      Set.range w₀.base ∪ Set.range w₁.base = Set.univ ∧
      w₀ ≫ p_A = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      w₁ ≫ p_A = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      (∀ p : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A))),
        w₀.base p ∈ Set.range w₁.base ↔ Polynomial.X ∉ p.asIdeal) ∧
      (∀ p : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A))),
        w₁.base p ∈ Set.range w₀.base ↔ Polynomial.X ∉ p.asIdeal) ∧
      (∀ (R : Type u) [CommRing R] (φ₀ φ₁ : Polynomial A →+* R),
        (∀ a : A, φ₀ (Polynomial.C a) = φ₁ (Polynomial.C a)) →
        φ₀ Polynomial.X * φ₁ Polynomial.X = 1 →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ w₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ w₁) ∧
      IsLocalization.Away (algebraMap (Polynomial A) B₀ Polynomial.X) B₀₁ ∧
      IsLocalization.Away (algebraMap (Polynomial A) B₁ Polynomial.X) B₀₁ ∧
      algebraMap B₀ B₀₁ (algebraMap (Polynomial A) B₀ Polynomial.X) *
        algebraMap B₁ B₀₁ (algebraMap (Polynomial A) B₁ Polynomial.X) = 1 ∧
