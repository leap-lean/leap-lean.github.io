      let t_ij : HomogeneousLocalization.Away 𝒜 (T i) :=
        HomogeneousLocalization.Away.isLocalizationElem (hT i) (hT j)
      let φ : Polynomial k →+* HomogeneousLocalization.Away 𝒜 (T i) :=
        Polynomial.eval₂RingHom σ₀ t_ij
      let ev : MvPolynomial (Fin 2) k →+* Polynomial k :=
        MvPolynomial.eval₂Hom Polynomial.C (fun m => if m = i then 1 else Polynomial.X)
      have hev_unit : ∀ y : Submonoid.powers (T i), IsUnit (ev y) := by
        rintro ⟨_, n, rfl⟩
        change IsUnit (ev ((T i) ^ n))
        rw [map_pow]
        have hTi_ev : ev (T i) = 1 := by simp [ev, T]
        rw [hTi_ev, one_pow]
