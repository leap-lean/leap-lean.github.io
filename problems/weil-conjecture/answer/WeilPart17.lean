  let Y_U : Scheme.{u} := (coprodTower m_dim).1
  let π_U : Y_U ⟶ Z := (coprodTower m_dim).2
  have hFin_πU : IsFinite π_U := hTowerFin m_dim
  obtain ⟨glue_m, hGlueM_inj, hGlueM_nat⟩ := hGlueStep m_dim
  obtain ⟨hL_YU, α_YU, β_YU, _, hβα_YU⟩ := hStep3 Y_U Λ_ℓ
  let L_YU : Sheaf Y_U.smallEtaleTopology AddCommGrpCat.{u} := ⟨locConstPresheaf Y_U Λ_ℓ, hL_YU⟩
  let B_πU : Z.Etale ⥤ Y_U.Etale := MorphismProperty.Over.pullback (@Etale) ⊤ π_U
