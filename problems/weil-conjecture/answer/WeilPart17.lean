    have hR : adj₁.unit.app Aℤ ≫ uℤ.hom.app (Opposite.op T) =
        (shAdj_C₀.unit.app Pℤ_C₀).app (Opposite.op (B_h.obj T)) :=
      (congrArg (· ≫ uℤ.hom.app (Opposite.op T)) hunit_C).trans huℤ_T
    exact hL.trans hR.symm
  have hπ_eq : πℤ = cℤ := congrArg (adj_h.homEquiv Fℤ_C Fℤ_C₀).symm hu_eq
  have hcℤ : CategoryTheory.IsIso cℤ := by
