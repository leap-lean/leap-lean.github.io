    · exact hOne u₁_X g₁ j₁' hc₁ hr₁ hg₁
  
  let U₀_C := AlgebraicGeometry.Spec (CommRingCat.of D.R₀)
  let U₁_C := AlgebraicGeometry.Spec (CommRingCat.of D.R₁)
  let V₀₁_C := AlgebraicGeometry.Spec (CommRingCat.of D.R₀₁)
  let f₀ : V₀₁_C ⟶ U₀_C := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ D.R₀₁))
  let f₁ : V₀₁_C ⟶ U₁_C := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ D.R₀₁))
