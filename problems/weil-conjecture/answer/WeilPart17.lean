    let R : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel f_E
    let g_E : I_E ⟶ R := CategoryTheory.Limits.cokernel.π f_E
    have h0 : f_E ≫ g_E = 0 := CategoryTheory.Limits.cokernel.condition f_E
    have hSE_E : (CategoryTheory.ShortComplex.mk f_E g_E h0).ShortExact :=
