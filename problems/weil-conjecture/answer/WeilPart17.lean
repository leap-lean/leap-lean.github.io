        ((glue_m E.unop.hom).comp (AddMonoidHom.pi fun r => mapLam E.unop r))
      naturality := fun {E₁ E₂} v => by
        apply AddCommGrpCat.ext
        intro f_lc
        let f_lc' : LocallyConstant ↥(B_qZ.obj E₁.unop).left ↥A₀ := f_lc
