      (MvPolynomial.rename Sum.inl (A_coeff m p)) *
        (MvPolynomial.rename Sum.inr (MvPolynomial.monomial m.1 (1 : A)))
  have h_zero_inl : ((0 : (Fin D.r × Fin ((ℓ - 1) * n)) ⊕ (Fin D.r × Fin n) → A) ∘ Sum.inl) = 0 :=
    funext fun _ => rfl
  have h_zero_inr : ((0 : (Fin D.r × Fin ((ℓ - 1) * n)) ⊕ (Fin D.r × Fin n) → A) ∘ Sum.inr) = 0 :=
    funext fun _ => rfl
  have h_mon_zero : ∀ d : (Fin D.r × Fin n) →₀ ℕ,
      MvPolynomial.eval 0 (MvPolynomial.monomial d (1 : A)) = if d = 0 then 1 else 0 := by
    intro d
    rw [MvPolynomial.eval_zero, MvPolynomial.constantCoeff_monomial]
  have h_mon_pderiv : ∀ (q : Fin D.r × Fin n) (d : (Fin D.r × Fin n) →₀ ℕ),
      MvPolynomial.eval 0 (MvPolynomial.pderiv q (MvPolynomial.monomial d (1 : A))) =
        if d = Finsupp.single q 1 then 1 else 0 := by
    intro q d
    rw [MvPolynomial.eval_zero, h_pderiv_const, MvPolynomial.coeff_monomial]
  have hpderiv_inl_inr : ∀ (p' : Fin D.r × Fin ((ℓ - 1) * n))
      (Q : MvPolynomial (Fin D.r × Fin n) A),
      MvPolynomial.pderiv (Sum.inl p') (MvPolynomial.rename Sum.inr Q) = 0 := by
    intro p' Q
    apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
    intro hmem
    have himg := MvPolynomial.vars_rename Sum.inr Q hmem
    rw [Finset.mem_image] at himg
    rcases himg with ⟨q, _, hq⟩
    exact Sum.inr_ne_inl hq
  have hpderiv_inr_inl : ∀ (q : Fin D.r × Fin n)
      (P : MvPolynomial (Fin D.r × Fin ((ℓ - 1) * n)) A),
      MvPolynomial.pderiv (Sum.inr q) (MvPolynomial.rename Sum.inl P) = 0 := by
    intro q P
    apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
    intro hmem
    have himg := MvPolynomial.vars_rename Sum.inl P hmem
    rw [Finset.mem_image] at himg
    rcases himg with ⟨p', _, hp'⟩
    exact Sum.inl_ne_inr hp'
  have hF_sum_zero : ∀ p : Fin D.r × Fin (ℓ * n),
      τ_A (MvPolynomial.eval 0 (F_sum p)) = 0 := by
    intro p
    have hev : MvPolynomial.eval 0 (F_sum p) = MvPolynomial.eval 0 (A_coeff m₀ p) := by
      simp only [F_sum, map_sum, map_mul, MvPolynomial.eval_rename, h_zero_inl, h_zero_inr,
        h_mon_zero, mul_ite, mul_one, mul_zero]
      have h_sub : ∀ m : ↥S_supp,
          (if m.1 = 0 then MvPolynomial.eval 0 (A_coeff m p) else 0) =
            if m = m₀ then MvPolynomial.eval 0 (A_coeff m₀ p) else 0 := by
        intro m
        by_cases hm : m = m₀
        · subst hm; rw [if_pos rfl, if_pos rfl]
        · rw [if_neg (fun h => hm (Subtype.ext h)), if_neg hm]
      simp_rw [h_sub]
      rw [Finset.sum_ite_eq' Finset.univ m₀, if_pos (Finset.mem_univ m₀)]
    rw [hev, hA0_val p]
  have hF_sum_inl : ∀ (p' : Fin D.r × Fin ((ℓ - 1) * n)) (p : Fin D.r × Fin (ℓ * n)),
      τ_A (MvPolynomial.eval 0 (MvPolynomial.pderiv (Sum.inl p') (F_sum p))) =
        if p = ι_U p' then -δ₀ else 0 := by
    intro p' p
    have hev : MvPolynomial.eval 0 (MvPolynomial.pderiv (Sum.inl p') (F_sum p)) =
        MvPolynomial.eval 0 (MvPolynomial.pderiv p' (A_coeff m₀ p)) := by
      simp only [F_sum, map_sum, MvPolynomial.pderiv_mul, hpderiv_inl_inr, mul_zero, zero_mul,
        add_zero, zero_add, MvPolynomial.pderiv_rename Sum.inl_injective, map_mul,
        MvPolynomial.eval_rename, h_zero_inl, h_zero_inr, h_mon_zero, mul_ite, mul_one]
      have h_sub : ∀ m : ↥S_supp,
          (if m.1 = 0 then MvPolynomial.eval 0 (MvPolynomial.pderiv p' (A_coeff m p)) else 0) =
            if m = m₀ then MvPolynomial.eval 0 (MvPolynomial.pderiv p' (A_coeff m₀ p)) else 0 := by
        intro m
        by_cases hm : m = m₀
        · subst hm; rw [if_pos rfl, if_pos rfl]
        · rw [if_neg (fun h => hm (Subtype.ext h)), if_neg hm]
      simp_rw [h_sub]
      rw [Finset.sum_ite_eq' Finset.univ m₀, if_pos (Finset.mem_univ m₀)]
    rw [hev, hA0_deriv p' p]
  have hF_sum_inr : ∀ (q : Fin D.r × Fin n) (p : Fin D.r × Fin (ℓ * n)),
      τ_A (MvPolynomial.eval 0 (MvPolynomial.pderiv (Sum.inr q) (F_sum p))) =
        if p = ι_C q then δ₀ * (ℓ : k) else 0 := by
    intro q p
    have hev : MvPolynomial.eval 0 (MvPolynomial.pderiv (Sum.inr q) (F_sum p)) =
        MvPolynomial.eval 0 (A_coeff (m₁ q) p) := by
      simp only [F_sum, map_sum, MvPolynomial.pderiv_mul, hpderiv_inr_inl, mul_zero, zero_mul,
        add_zero, zero_add, MvPolynomial.pderiv_rename Sum.inr_injective, map_mul,
        MvPolynomial.eval_rename, h_zero_inl, h_zero_inr, h_mon_pderiv, mul_ite, mul_one]
      have h_sub : ∀ m : ↥S_supp,
          (if m.1 = Finsupp.single q 1 then MvPolynomial.eval 0 (A_coeff m p) else 0) =
            if m = m₁ q then MvPolynomial.eval 0 (A_coeff (m₁ q) p) else 0 := by
        intro m
        by_cases hm : m = m₁ q
        · subst hm; rw [if_pos rfl, if_pos rfl]
        · rw [if_neg (fun h => hm (Subtype.ext h)), if_neg hm]
      simp_rw [h_sub]
      rw [Finset.sum_ite_eq' Finset.univ (m₁ q), if_pos (Finset.mem_univ (m₁ q))]
    rw [hev, hA1_val q p]
  let equiv_split : (Fin D.r × Fin ((ℓ - 1) * n)) ⊕ (Fin D.r × Fin n) ≃ Fin D.r × Fin (ℓ * n) :=
    { toFun := Sum.elim ι_U ι_C
      invFun := fun p =>
        if h : p.2.val < (ℓ - 1) * n then
          Sum.inl (p.1, ⟨p.2.val, h⟩)
        else
          Sum.inr (p.1, ⟨p.2.val - (ℓ - 1) * n, by have := p.2.isLt; omega⟩)
      left_inv := by
        rintro (⟨j, k₀⟩ | ⟨j, s⟩)
        · simp [ι_U, k₀.isLt]
        · have hnot : ¬ ((ℓ - 1) * n + s.val < (ℓ - 1) * n) := by omega
          simp [ι_C, hnot]
      right_inv := by
        rintro ⟨j, m⟩
        by_cases h : m.val < (ℓ - 1) * n
        · simp [h, ι_U]
        · simp only [dif_neg h, Sum.elim_inr, ι_C, Prod.mk.injEq, true_and]
          ext
          dsimp
          omega }
  let d_ℓ : ℕ := D.r * (ℓ * n)
  let e_eq : Fin d_ℓ ≃ Fin D.r × Fin (ℓ * n) := finProdFinEquiv.symm
  let e_var : Fin d_ℓ ≃ (Fin D.r × Fin ((ℓ - 1) * n)) ⊕ (Fin D.r × Fin n) :=
    e_eq.trans equiv_split.symm
  let F_fin : Fin d_ℓ → MvPolynomial (Fin d_ℓ) A :=
    fun i => MvPolynomial.rename e_var.symm (F_sum (e_eq i))
  have h_zero_var : ((0 : Fin d_ℓ → A) ∘ e_var.symm) = 0 := funext fun _ => rfl
  have hF_fin_zero : ∀ i : Fin d_ℓ, τ_A (MvPolynomial.eval 0 (F_fin i)) = 0 := by
    intro i
    simp only [F_fin, MvPolynomial.eval_rename, h_zero_var]
    exact hF_sum_zero (e_eq i)
  let d_diag : Fin d_ℓ → k :=
    fun b => match e_var b with
      | Sum.inl _ => -δ₀
      | Sum.inr _ => δ₀ * (ℓ : k)
  have hJac_eq : (Matrix.of fun i b : Fin d_ℓ =>
      τ_A (MvPolynomial.eval 0 (MvPolynomial.pderiv b (F_fin i)))) = Matrix.diagonal d_diag := by
    ext i b
    simp only [Matrix.of_apply, Matrix.diagonal_apply]
    have hb : b = e_var.symm (e_var b) := (e_var.symm_apply_apply b).symm
    conv_lhs => rw [hb]
    simp only [F_fin, MvPolynomial.pderiv_rename e_var.symm.injective, MvPolynomial.eval_rename,
      h_zero_var]
    have heq_b : equiv_split (e_var b) = e_eq b := equiv_split.apply_symm_apply (e_eq b)
    cases hvb : e_var b with
    | inl p' =>
      rw [hF_sum_inl p' (e_eq i)]
      have h_ι : ι_U p' = e_eq b := by
        simpa [equiv_split, hvb] using heq_b
      rw [h_ι]
      by_cases hij : i = b
      · subst hij
        simp [d_diag, hvb]
      · rw [if_neg hij, if_neg (fun h => hij (e_eq.injective h))]
    | inr q =>
      rw [hF_sum_inr q (e_eq i)]
      have h_ι : ι_C q = e_eq b := by
        simpa [equiv_split, hvb] using heq_b
      rw [h_ι]
      by_cases hij : i = b
      · subst hij
        simp [d_diag, hvb]
      · rw [if_neg hij, if_neg (fun h => hij (e_eq.injective h))]
  have hJac_det : (Matrix.of fun i b : Fin d_ℓ =>
      τ_A (MvPolynomial.eval 0 (MvPolynomial.pderiv b (F_fin i)))).det ≠ 0 := by
    rw [hJac_eq, Matrix.det_diagonal, Finset.prod_ne_zero_iff]
    intro b _
    dsimp [d_diag]
    cases e_var b with
    | inl _ => exact neg_ne_zero.mpr hΔ_ne
    | inr _ => exact mul_ne_zero hΔ_ne hℓ
  obtain ⟨x_sol, hx_ker, hx_root⟩ := hHensel d_ℓ F_fin 0 hF_fin_zero hJac_det
  have hx_zero : ∀ b : Fin d_ℓ, τ_A (x_sol b) = 0 := by
    intro b
    rw [hx_ker b]
    exact map_zero τ_A
  let z_sol : (Fin D.r × Fin ((ℓ - 1) * n)) ⊕ (Fin D.r × Fin n) → A := x_sol ∘ e_var.symm
  let u_pt : Fin D.r × Fin ((ℓ - 1) * n) → A := fun p' => z_sol (Sum.inl p')
  let c_flat : Fin D.r × Fin n → A := fun q => z_sol (Sum.inr q)
  let c : Fin D.r → Fin n → A := fun j s => c_flat (j, s)
  have hc_ker : ∀ (j : Fin D.r) (s : Fin n), τ_A (c j s) = 0 :=
    fun j s => hx_zero (e_var.symm (Sum.inr (j, s)))
  have hu_ker : ∀ p' : Fin D.r × Fin ((ℓ - 1) * n), τ_A (u_pt p') = 0 :=
    fun p' => hx_zero (e_var.symm (Sum.inl p'))
  have hSum_zero : ∀ p : Fin D.r × Fin (ℓ * n),
      Finset.univ.sum (fun m : ↥S_supp =>
        MvPolynomial.eval u_pt (A_coeff m p) *
          MvPolynomial.eval c_flat (MvPolynomial.monomial m.1 (1 : A))) = 0 := by
    intro p
    have hr_p := hx_root (e_eq.symm p)
    simp only [F_fin, e_eq.apply_symm_apply p, MvPolynomial.eval_rename] at hr_p
    change MvPolynomial.eval z_sol (F_sum p) = 0 at hr_p
    simp only [F_sum, map_sum, map_mul, MvPolynomial.eval_rename] at hr_p
    exact hr_p
  
  have h_eval_u : ∀ P : MvPolynomial (Fin D.r × Fin ((ℓ - 1) * n)) A,
      τ_A (MvPolynomial.eval u_pt P) = τ_A (MvPolynomial.eval 0 P) := by
    intro P
    induction P using MvPolynomial.induction_on' with
    | monomial v a =>
      simp only [MvPolynomial.eval_monomial, Finsupp.prod, map_mul, map_prod, map_pow, hu_ker,
        Pi.zero_apply, map_zero]
    | add p q hp hq =>
      simp only [map_add, hp, hq]
  have hΔ_u : τ_A (MvPolynomial.eval u_pt Δ) = δ₀ := h_eval_u Δ
  have hu_unit : IsUnit (MvPolynomial.eval u_pt Δ) := by
    by_contra hnu
    have h0 : τ_A (MvPolynomial.eval u_pt Δ) = 0 := (hA_ker (MvPolynomial.eval u_pt Δ)).mpr hnu
    rw [hΔ_u] at h0
    exact hΔ_ne h0
  refine ⟨c, u_pt, hc_ker, hu_ker, ?_⟩
  let w₀_pt : M.L₀ :=
    w_base₀ + Finset.univ.sum (fun p' : Fin D.r × Fin ((ℓ - 1) * n) =>
      (algebraMap (Polynomial A) D.R₀ (Polynomial.C (u_pt p'))) • w_U₀ p'.1 p'.2)
  let W_span : Submodule D.R₀ M.L₀ := Submodule.span D.R₀ {w₀_pt}
  have h_lin_comb : Finset.univ.sum (fun m : ↥S_supp =>
      α₀ (MvPolynomial.eval c_flat (MvPolynomial.monomial m.1 (1 : A))) •
        ((α₀ (MvPolynomial.eval u_pt Δ)) • y m -
          Finset.univ.sum (fun p : Fin D.r × Fin (ℓ * n) =>
            (α₀ (MvPolynomial.eval u_pt (A_coeff m p)) * t ^ p.2.val * D.b₀ p.1) • σ₀))) ∈
      W_span := by
    apply Submodule.sum_mem W_span
    intro m _
    exact Submodule.smul_mem W_span _ (hDiv_span u_pt m)
  let f_c : D.R₀ := t ^ n + Finset.univ.sum fun j : Fin D.r =>
    Finset.univ.sum fun s : Fin n =>
      algebraMap (Polynomial A) D.R₀ (Polynomial.C (c j s)) * t ^ s.val * D.b₀ j
  have h_fc_eq : f_c ^ ℓ =
      (t ^ n + Finset.univ.sum (fun q : Fin D.r × Fin n => α₀ (c_flat q) * e q)) ^ ℓ := by
    dsimp [f_c, α₀, e, c]
    congr 1
    congr 1
    rw [Fintype.sum_prod_type]
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro s _
    ring
  have h_term1 : Finset.univ.sum (fun m : ↥S_supp =>
      α₀ (MvPolynomial.eval c_flat (MvPolynomial.monomial m.1 (1 : A))) •
        ((α₀ (MvPolynomial.eval u_pt Δ)) • y m)) =
      α₀ (MvPolynomial.eval u_pt Δ) • ((f_c ^ ℓ) • σ₀) := by
    have h_smul : ∀ m : ↥S_supp,
        α₀ (MvPolynomial.eval c_flat (MvPolynomial.monomial m.1 (1 : A))) •
          ((α₀ (MvPolynomial.eval u_pt Δ)) • y m) =
        α₀ (MvPolynomial.eval u_pt Δ) •
          ((α₀ (MvPolynomial.eval c_flat (MvPolynomial.monomial m.1 (1 : A))) * G.coeff m.1) • σ₀) := by
      intro m
      simp only [y, smul_smul]
      congr 1
      ring
    simp_rw [h_smul]
    rw [← Finset.smul_sum, ← Finset.sum_smul, hGeval c_flat, ← h_fc_eq]
  have h_term2 : Finset.univ.sum (fun m : ↥S_supp =>
      α₀ (MvPolynomial.eval c_flat (MvPolynomial.monomial m.1 (1 : A))) •
        Finset.univ.sum (fun p : Fin D.r × Fin (ℓ * n) =>
          (α₀ (MvPolynomial.eval u_pt (A_coeff m p)) * t ^ p.2.val * D.b₀ p.1) • σ₀)) = 0 := by
    simp_rw [Finset.smul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_eq_zero
    intro p _
    have h_inner : ∀ m : ↥S_supp,
        α₀ (MvPolynomial.eval c_flat (MvPolynomial.monomial m.1 (1 : A))) •
          ((α₀ (MvPolynomial.eval u_pt (A_coeff m p)) * t ^ p.2.val * D.b₀ p.1) • σ₀) =
        (α₀ (MvPolynomial.eval u_pt (A_coeff m p) *
            MvPolynomial.eval c_flat (MvPolynomial.monomial m.1 (1 : A))) *
          (t ^ p.2.val * D.b₀ p.1)) • σ₀ := by
      intro m
      rw [smul_smul, map_mul]
      congr 1
      ring
    simp_rw [h_inner]
    rw [← Finset.sum_smul, ← Finset.sum_mul, ← map_sum, hSum_zero p, map_zero, zero_mul, zero_smul]
  simp only [smul_sub, Finset.sum_sub_distrib, h_term1, h_term2, sub_zero] at h_lin_comb
  rcases hu_unit with ⟨u_Δ, hu_Δ⟩
  have h_cancel := Submodule.smul_mem W_span (α₀ (↑u_Δ⁻¹)) h_lin_comb
  have h_inv_mul : α₀ (↑u_Δ⁻¹) * α₀ (MvPolynomial.eval u_pt Δ) = 1 := by
    rw [← hu_Δ, ← map_mul, Units.inv_mul, map_one]
  rwa [smul_smul, h_inv_mul, one_smul] at h_cancel

theorem weil_monic_twoChart_cayley_hamilton_div_root (k : Type u) [Field k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (D : WeilTwoChartRingDatum A)
    (D₀ : WeilTwoChartRingDatum k)
    (red : WeilTwoChartCurveReduction D D₀)
    (hA : WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A)
    (hValid : WeilIsValidTwoChartCurveReduction τ_A D D₀ red)
    (M : WeilTwoChartLineBundle D)
    (n : ℕ) (hn_pos : 1 ≤ n) (hn_w : ∀ j : Fin D.r, D.w j < n)
    (hHensel : ∀ (N : ℕ) (F : Fin N → MvPolynomial (Fin N) A) (x₀ : Fin N → A),
      (∀ i : Fin N, τ_A (MvPolynomial.eval x₀ (F i)) = 0) →
      (Matrix.of fun i j : Fin N =>
        τ_A (MvPolynomial.eval x₀ (MvPolynomial.pderiv j (F i)))).det ≠ 0 →
      ∃ x : Fin N → A,
        (∀ j : Fin N, τ_A (x j) = τ_A (x₀ j)) ∧
        (∀ i : Fin N, MvPolynomial.eval x (F i) = 0))
    (lam₀ : M.L₀ →ₗ[D.R₀] D.R₀) (lam₁ : M.L₁ →ₗ[D.R₁] D.R₁)
    (σ₀ : M.L₀) (w_base₀ : M.L₀) (w_base₁ : M.L₁)
    (w_U₀ : Fin D.r → Fin ((ℓ - 1) * n) → M.L₀)
    (w_U₁ : Fin D.r → Fin ((ℓ - 1) * n) → M.L₁) :
    letI : Algebra D.R₀ D₀.R₀ := red.algR₀
    letI : Algebra D.R₁ D₀.R₁ := red.algR₁
    let t : D.R₀ := algebraMap (Polynomial A) D.R₀ Polynomial.X
    let u : D.R₁ := algebraMap (Polynomial A) D.R₁ Polynomial.X
    let u₀₁ : D.R₀₁ := algebraMap D.R₁ D.R₀₁ u
    let t_bar : D₀.R₀ := algebraMap (Polynomial k) D₀.R₀ Polynomial.X
    let π₀ : D.R₀ →+* D₀.R₀ := algebraMap D.R₀ D₀.R₀
    let π₁ : D.R₁ →+* D₀.R₁ := algebraMap D.R₁ D₀.R₁
    (∀ x τ : M.L₀, lam₀ x • τ = lam₀ τ • x) →
    (∀ y τ : M.L₁, lam₁ y • τ = lam₁ τ • y) →
    π₀ (lam₀ σ₀) = 1 →
    u₀₁ ^ (ℓ * n) • M.θ (TensorProduct.tmul D.R₀ (1 : D.R₀₁) w_base₀) =
      TensorProduct.tmul D.R₁ (1 : D.R₀₁) w_base₁ →
    π₀ (lam₀ w_base₀) = t_bar ^ (ℓ * n) →
    π₁ (lam₁ w_base₁) = 1 →
    (∀ (j : Fin D.r) (k₀ : Fin ((ℓ - 1) * n)),
      u₀₁ ^ (ℓ * n) • M.θ (TensorProduct.tmul D.R₀ (1 : D.R₀₁) (w_U₀ j k₀)) =
        TensorProduct.tmul D.R₁ (1 : D.R₀₁) (w_U₁ j k₀) ∧
      π₀ (lam₀ (w_U₀ j k₀)) = t_bar ^ k₀.val * π₀ (D.b₀ j)) →
    ∃ (c : Fin D.r → Fin n → A) (w₀ : M.L₀) (w₁ : M.L₁),
      (∀ (j : Fin D.r) (s : Fin n), τ_A (c j s) = 0) ∧
      (u₀₁ ^ (ℓ * n) • M.θ (TensorProduct.tmul D.R₀ (1 : D.R₀₁) w₀) =
        TensorProduct.tmul D.R₁ (1 : D.R₀₁) w₁ ∧
       π₀ (lam₀ w₀) = t_bar ^ (ℓ * n) ∧
       π₁ (lam₁ w₁) = 1) ∧
      Function.Bijective (fun v : Fin D.r × Fin (ℓ * n) → A =>
        Finset.univ.sum fun p =>
          (Submodule.span D.R₀ {w₀}).mkQ
            ((algebraMap (Polynomial A) D.R₀ (Polynomial.C (v p)) * t ^ p.2.val * D.b₀ p.1) • σ₀)) ∧
      ((t ^ n + Finset.univ.sum fun j : Fin D.r =>
          Finset.univ.sum fun s : Fin n =>
            algebraMap (Polynomial A) D.R₀ (Polynomial.C (c j s)) * t ^ s.val * D.b₀ j) ^ ℓ) • σ₀ ∈
        Submodule.span D.R₀ {w₀} ∧
      (∀ y : M.L₁ ⧸ Submodule.span D.R₁ {w₁},
        ∃ y' : M.L₁ ⧸ Submodule.span D.R₁ {w₁}, u • y' = y) :=
by
  letI : Algebra D.R₀ D₀.R₀ := red.algR₀
  letI : Algebra D.R₁ D₀.R₁ := red.algR₁
  intro t u u₀₁ t_bar π₀ π₁ hSymm₀ hSymm₁ hσ₀ hBase_θ hBase_lam₀ hBase_lam₁ hFam
  have hA_noeth : IsNoetherianRing A := hA.1
  have hA_loc : IsLocalRing A := hA.2.1
  have hA_ker : ∀ a : A, τ_A a = 0 ↔ ¬ IsUnit a := hA.2.2.1
  have hLocalBasis :
      ∀ (B : Type u) [CommRing B] [Algebra k B] (τ_B : B →ₐ[k] k),
        IsNoetherianRing B → IsLocalRing B → (∀ b : B, τ_B b = 0 ↔ ¬ IsUnit b) →
        ∀ (D_B : WeilTwoChartRingDatum B) (red_B : WeilTwoChartCurveReduction D_B D₀),
          WeilIsValidTwoChartCurveReduction τ_B D_B D₀ red_B →
          ∀ (M_B : WeilTwoChartLineBundle D_B)
            (lam₀_B : M_B.L₀ →ₗ[D_B.R₀] D_B.R₀) (lam₁_B : M_B.L₁ →ₗ[D_B.R₁] D_B.R₁)
            (σ₀_B w₀_B : M_B.L₀) (w₁_B : M_B.L₁),
            letI : Algebra D_B.R₀ D₀.R₀ := red_B.algR₀
            letI : Algebra D_B.R₁ D₀.R₁ := red_B.algR₁
            (∀ x τ : M_B.L₀, lam₀_B x • τ = lam₀_B τ • x) →
            (∀ y τ : M_B.L₁, lam₁_B y • τ = lam₁_B τ • y) →
            algebraMap D_B.R₀ D₀.R₀ (lam₀_B σ₀_B) = 1 →
            (algebraMap D_B.R₁ D_B.R₀₁ (algebraMap (Polynomial B) D_B.R₁ Polynomial.X)) ^ (ℓ * n) •
                M_B.θ (TensorProduct.tmul D_B.R₀ (1 : D_B.R₀₁) w₀_B) =
              TensorProduct.tmul D_B.R₁ (1 : D_B.R₀₁) w₁_B →
            algebraMap D_B.R₀ D₀.R₀ (lam₀_B w₀_B) = t_bar ^ (ℓ * n) →
            algebraMap D_B.R₁ D₀.R₁ (lam₁_B w₁_B) = 1 →
            Function.Bijective (fun v : Fin D_B.r × Fin (ℓ * n) → B =>
              Finset.univ.sum fun p =>
                (Submodule.span D_B.R₀ {w₀_B}).mkQ
                  ((algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (v p)) *
                    (algebraMap (Polynomial B) D_B.R₀ Polynomial.X) ^ p.2.val * D_B.b₀ p.1) • σ₀_B)) := by
    intro B _ _ τ_B hB_noeth hB_loc hB_ker D_B red_B hValid_B M_B lam₀_B lam₁_B σ₀_B w₀_B w₁_B
    letI : Algebra D_B.R₀ D₀.R₀ := red_B.algR₀
    letI : Algebra D_B.R₁ D₀.R₁ := red_B.algR₁
    intro hSymm₀_B hSymm₁_B hσ₀_B hθ_B hlam₀_B hlam₁_B
    have hFin_B := (weil_twoChart_local_quotient_finite_and_u_divisible k B τ_B hB_loc hB_ker
      D_B D₀ red_B hValid_B M_B lam₁_B w₀_B w₁_B (ℓ * n) hSymm₁_B hθ_B hlam₁_B).1
    exact weil_twoChart_local_finite_quotient_monomial_basis k B τ_B hB_noeth hB_loc hB_ker
      D_B D₀ red_B hValid_B M_B lam₀_B σ₀_B w₀_B (ℓ * n) hSymm₀_B hσ₀_B hlam₀_B hFin_B
  obtain ⟨c, u_pt, hc_ker, hu_ker, hPow⟩ :=
    weil_twoChart_diagonal_jacobian_hensel_root k ℓ hℓ A τ_A hA_ker D D₀ red hValid M
      n hn_pos hHensel lam₀ σ₀ w_base₀ w_U₀ hσ₀
      (fun {ι : Type} [Fintype ι] (y : ι → M.L₀) =>
        weil_twoChart_mvPoly_atPrime_division_identities k A τ_A hA_noeth D D₀ red hValid M
          lam₀ lam₁ σ₀ w_base₀ w_base₁ (ℓ * n) ((ℓ - 1) * n) w_U₀ w_U₁
          hSymm₀ hSymm₁ hσ₀ hBase_θ hBase_lam₀ hBase_lam₁ hFam hLocalBasis y)
  let w₀ : M.L₀ := w_base₀ + Finset.univ.sum (fun p' : Fin D.r × Fin ((ℓ - 1) * n) =>
    (algebraMap (Polynomial A) D.R₀ (Polynomial.C (u_pt p'))) • w_U₀ p'.1 p'.2)
  let w₁ : M.L₁ := w_base₁ + Finset.univ.sum (fun p' : Fin D.r × Fin ((ℓ - 1) * n) =>
    (algebraMap (Polynomial A) D.R₁ (Polynomial.C (u_pt p'))) • w_U₁ p'.1 p'.2)
  have ⟨_, _, _, _, _, _, hScalar₀₁, _⟩ := hValid.1
  have ⟨_, _, _, hMap₀, hMap₁, _⟩ := hValid
  have one_tmul_smul₀ : ∀ (r₀ : D.R₀) (x : M.L₀),
      TensorProduct.tmul D.R₀ (1 : D.R₀₁) (r₀ • x) =
        (algebraMap D.R₀ D.R₀₁ r₀) • TensorProduct.tmul D.R₀ (1 : D.R₀₁) x := by
    intro r₀ x
    calc
      TensorProduct.tmul D.R₀ (1 : D.R₀₁) (r₀ • x)
        = TensorProduct.tmul D.R₀ (r₀ • (1 : D.R₀₁)) x :=
          (TensorProduct.smul_tmul r₀ (1 : D.R₀₁) x).symm
      _ = TensorProduct.tmul D.R₀ (algebraMap D.R₀ D.R₀₁ r₀ * (1 : D.R₀₁)) x := by
          rw [Algebra.smul_def]
      _ = TensorProduct.tmul D.R₀ ((algebraMap D.R₀ D.R₀₁ r₀) • (1 : D.R₀₁)) x := by
          rw [smul_eq_mul]
      _ = (algebraMap D.R₀ D.R₀₁ r₀) • TensorProduct.tmul D.R₀ (1 : D.R₀₁) x :=
          (TensorProduct.smul_tmul' (algebraMap D.R₀ D.R₀₁ r₀) (1 : D.R₀₁) x).symm
  have one_tmul_smul₁ : ∀ (r₁ : D.R₁) (y : M.L₁),
      TensorProduct.tmul D.R₁ (1 : D.R₀₁) (r₁ • y) =
        (algebraMap D.R₁ D.R₀₁ r₁) • TensorProduct.tmul D.R₁ (1 : D.R₀₁) y := by
    intro r₁ y
    calc
      TensorProduct.tmul D.R₁ (1 : D.R₀₁) (r₁ • y)
        = TensorProduct.tmul D.R₁ (r₁ • (1 : D.R₀₁)) y :=
          (TensorProduct.smul_tmul r₁ (1 : D.R₀₁) y).symm
      _ = TensorProduct.tmul D.R₁ (algebraMap D.R₁ D.R₀₁ r₁ * (1 : D.R₀₁)) y := by
          rw [Algebra.smul_def]
      _ = TensorProduct.tmul D.R₁ ((algebraMap D.R₁ D.R₀₁ r₁) • (1 : D.R₀₁)) y := by
          rw [smul_eq_mul]
      _ = (algebraMap D.R₁ D.R₀₁ r₁) • TensorProduct.tmul D.R₁ (1 : D.R₀₁) y :=
          (TensorProduct.smul_tmul' (algebraMap D.R₁ D.R₀₁ r₁) (1 : D.R₀₁) y).symm
  have hw_θ : u₀₁ ^ (ℓ * n) • M.θ (TensorProduct.tmul D.R₀ (1 : D.R₀₁) w₀) =
      TensorProduct.tmul D.R₁ (1 : D.R₀₁) w₁ := by
    dsimp only [w₀, w₁]
    rw [TensorProduct.tmul_add, TensorProduct.tmul_sum, map_add, map_sum,
      smul_add, Finset.smul_sum, hBase_θ, TensorProduct.tmul_add, TensorProduct.tmul_sum]
    congr 1
    apply Finset.sum_congr rfl
    intro p' _
    rw [one_tmul_smul₀, LinearEquiv.map_smul, ← mul_smul, mul_comm, mul_smul,
      (hFam p'.1 p'.2).1, hScalar₀₁ (u_pt p'), ← one_tmul_smul₁]
  have hw_lam₀ : π₀ (lam₀ w₀) = t_bar ^ (ℓ * n) := by
    dsimp only [w₀]
    rw [map_add, map_sum, map_add, map_sum, hBase_lam₀]
    have hsum₀ : (Finset.univ.sum fun p' : Fin D.r × Fin ((ℓ - 1) * n) =>
        π₀ (lam₀ ((algebraMap (Polynomial A) D.R₀ (Polynomial.C (u_pt p'))) • w_U₀ p'.1 p'.2))) = 0 := by
      apply Finset.sum_eq_zero
      intro p' _
      rw [LinearMap.map_smul, smul_eq_mul, map_mul]
      have h0 : π₀ (algebraMap (Polynomial A) D.R₀ (Polynomial.C (u_pt p'))) = 0 := by
        change algebraMap D.R₀ D₀.R₀ (algebraMap (Polynomial A) D.R₀ (Polynomial.C (u_pt p'))) = 0
        rw [hMap₀, Polynomial.map_C, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          hu_ker p', map_zero, map_zero]
      rw [h0, zero_mul]
    rw [hsum₀, add_zero]
  have hw_lam₁ : π₁ (lam₁ w₁) = 1 := by
    dsimp only [w₁]
    rw [map_add, map_sum, map_add, map_sum, hBase_lam₁]
    have hsum₁ : (Finset.univ.sum fun p' : Fin D.r × Fin ((ℓ - 1) * n) =>
        π₁ (lam₁ ((algebraMap (Polynomial A) D.R₁ (Polynomial.C (u_pt p'))) • w_U₁ p'.1 p'.2))) = 0 := by
      apply Finset.sum_eq_zero
      intro p' _
      rw [LinearMap.map_smul, smul_eq_mul, map_mul]
      have h0 : π₁ (algebraMap (Polynomial A) D.R₁ (Polynomial.C (u_pt p'))) = 0 := by
        change algebraMap D.R₁ D₀.R₁ (algebraMap (Polynomial A) D.R₁ (Polynomial.C (u_pt p'))) = 0
        rw [hMap₁, Polynomial.map_C, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          hu_ker p', map_zero, map_zero]
      rw [h0, zero_mul]
    rw [hsum₁, add_zero]
  obtain ⟨hFin_A, hU_div⟩ :=
    weil_twoChart_local_quotient_finite_and_u_divisible k A τ_A hA_loc hA_ker
      D D₀ red hValid M lam₁ w₀ w₁ (ℓ * n) hSymm₁ hw_θ hw_lam₁
  have hBij_A :=
    weil_twoChart_local_finite_quotient_monomial_basis k A τ_A hA_noeth hA_loc hA_ker
      D D₀ red hValid M lam₀ σ₀ w₀ (ℓ * n) hSymm₀ hσ₀ hw_lam₀ hFin_A
  exact ⟨c, w₀, w₁, hc_ker, ⟨hw_θ, hw_lam₀, hw_lam₁⟩, hBij_A, hPow, hU_div⟩

theorem weil_monic_polyBasis_krull_nzd_and_invertible_ideal : (∀ (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
       (R : Type u) [CommRing R] [Algebra (Polynomial A) R]
       (r : ℕ) (b : Fin r → R),
      Function.Bijective (fun f : Fin r → Polynomial A =>
        Finset.univ.sum fun j => algebraMap (Polynomial A) R (f j) * b j) →
      ∀ (m : ℕ) (g : R),
        g - (algebraMap (Polynomial A) R Polynomial.X) ^ m ∈
          Ideal.map ((algebraMap (Polynomial A) R).comp Polynomial.C) (IsLocalRing.maximalIdeal A) →
        ∀ x : R, g * x = 0 → x = 0) ∧
    (∀ (R : Type u) [CommRing R] (F h_n G_f H u_star v₁ v₂ a b : R),
      (∀ y : R, F * y = 0 → y = 0) →
      h_n * G_f = F * H →
      v₁ * h_n + v₂ * G_f = u_star →
      a * u_star + b * h_n = 1 →
      Module.Invertible R ↥(Ideal.span ({F, h_n} : Set R))) :=
by
  constructor
  · intro A _ _ _ R _ _ r b hBij m g hg x hgx
    let ϕ : (Fin r → Polynomial A) →ₗ[Polynomial A] R :=
      { toFun := fun f => Finset.univ.sum fun j => algebraMap (Polynomial A) R (f j) * b j
        map_add' := fun f₁ f₂ => by
          simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
        map_smul' := fun p f => by
          simp only [Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc, ← Finset.mul_sum,
            RingHom.id_apply, Algebra.smul_def] }
    let Φ : (Fin r → Polynomial A) ≃ₗ[Polynomial A] R := LinearEquiv.ofBijective ϕ hBij
    have hΦ_apply : ∀ f : Fin r → Polynomial A,
        Φ f = Finset.univ.sum fun j => algebraMap (Polynomial A) R (f j) * b j :=
      fun _ => rfl
    let inCoeff : Ideal A → R → Prop := fun I z =>
      ∀ (j : Fin r) (d : ℕ), (Φ.symm z j).coeff d ∈ I
    have hPoly_mul : ∀ {I J : Ideal A} {p q : Polynomial A},
        (∀ k : ℕ, p.coeff k ∈ I) → (∀ k : ℕ, q.coeff k ∈ J) →
        ∀ n : ℕ, (p * q).coeff n ∈ I * J := by
      intro I J p q hp hq n
      rw [Polynomial.coeff_mul]
      exact Submodule.sum_mem (I * J) fun u _ => Ideal.mul_mem_mul (hp u.1) (hq u.2)
    have hPoly_mul_right : ∀ {K : Ideal A} {p₀ h : Polynomial A},
        (∀ k : ℕ, p₀.coeff k ∈ K) → ∀ d : ℕ, (p₀ * h).coeff d ∈ K := by
      intro K p₀ h hp₀ d
      rw [Polynomial.coeff_mul]
      exact Submodule.sum_mem K fun u _ => K.mul_mem_right (h.coeff u.2) (hp₀ u.1)
    have inCoeff_mul : ∀ {I J : Ideal A} {z y : R},
        inCoeff I z → inCoeff J y → inCoeff (I * J) (z * y) := by
      intro I J z y hz hy l d
      have hzy : z * y = Finset.univ.sum fun j₁ : Fin r =>
          Finset.univ.sum fun j₂ : Fin r =>
            (Φ.symm z j₁ * Φ.symm y j₂) • (b j₁ * b j₂) := by
        conv_lhs => rw [← Φ.apply_symm_apply z, ← Φ.apply_symm_apply y]
        rw [hΦ_apply, hΦ_apply, Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro j₁ _
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j₂ _
        rw [Algebra.smul_def, map_mul]
        ring
      rw [hzy]
      simp only [map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
        Polynomial.finsetSum_coeff]
      refine Submodule.sum_mem (I * J) fun j₁ _ => Submodule.sum_mem (I * J) fun j₂ _ => ?_
      exact hPoly_mul_right (h := Φ.symm (b j₁ * b j₂) l) (hPoly_mul (hz j₁) (hy j₂)) d
    let M : Ideal A → Ideal R := fun I =>
      { carrier := { z : R | inCoeff I z }
        zero_mem' := by
          intro j d
          simp only [map_zero, Pi.zero_apply, Polynomial.coeff_zero, Submodule.zero_mem]
        add_mem' := by
          intro z₁ z₂ hz₁ hz₂ j d
          simp only [map_add, Pi.add_apply, Polynomial.coeff_add]
          exact I.add_mem (hz₁ j d) (hz₂ j d)
        smul_mem' := by
          intro r_R z hz
          change inCoeff I (r_R * z)
          rw [mul_comm r_R z]
          have htop : inCoeff ⊤ r_R := fun _ _ => Submodule.mem_top
          intro j d
          exact Ideal.mul_le_left (inCoeff_mul hz htop j d) }
    let ι_A : A →+* R := (algebraMap (Polynomial A) R).comp Polynomial.C
    have hMap_le : ∀ I : Ideal A, Ideal.map ι_A I ≤ M I := by
      intro I
      rw [Ideal.map_le_iff_le_comap]
      intro a ha j d
      have hι : ι_A a = (Polynomial.C a) • (1 : R) := by
        rw [Algebra.smul_def, mul_one]
        rfl
      change (Φ.symm (ι_A a) j).coeff d ∈ I
      rw [hι, map_smul, Pi.smul_apply, smul_eq_mul, Polynomial.coeff_C_mul]
      exact I.mul_mem_right _ ha
    let X_R : R := algebraMap (Polynomial A) R Polynomial.X
    have hShift : ∀ (I : Ideal A) (z : R), X_R ^ m * z ∈ M I → z ∈ M I := by
      intro I z hz j d
      have hXz : X_R ^ m * z = (Polynomial.X ^ m : Polynomial A) • z := by
        rw [Algebra.smul_def, map_pow]
      have hcoeff : (Φ.symm (X_R ^ m * z) j).coeff (d + m) ∈ I := hz j (d + m)
      rw [hXz, map_smul, Pi.smul_apply, smul_eq_mul, Polynomial.coeff_X_pow_mul] at hcoeff
      exact hcoeff
    let 𝔪_A : Ideal A := IsLocalRing.maximalIdeal A
    have hSub_mem : X_R ^ m - g ∈ M 𝔪_A := by
      have hg_mem : g - X_R ^ m ∈ M 𝔪_A := hMap_le 𝔪_A hg
      simpa only [neg_sub] using (M 𝔪_A).neg_mem hg_mem
    have hEq_mul : X_R ^ m * x = (X_R ^ m - g) * x := by
      rw [sub_mul, hgx, sub_zero]
    have hx_pow : ∀ v : ℕ, x ∈ M (𝔪_A ^ v) := by
      intro v
      induction v with
      | zero =>
        intro j d
        change (Φ.symm x j).coeff d ∈ 𝔪_A ^ 0
        rw [pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      | succ v ih =>
        apply hShift (𝔪_A ^ (v + 1)) x
        rw [hEq_mul, pow_succ']
        exact inCoeff_mul hSub_mem ih
    have hKrull : (⨅ v : ℕ, 𝔪_A ^ v) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing 𝔪_A (IsLocalRing.maximalIdeal.isMaximal A).ne_top
    have hSymm0 : Φ.symm x = 0 := by
      funext j
      ext d
      rw [Pi.zero_apply, Polynomial.coeff_zero, ← Submodule.mem_bot (R := A), ← hKrull,
        Ideal.mem_iInf]
      intro v
      exact hx_pow v j d
    exact Φ.symm.injective (hSymm0.trans (map_zero Φ.symm).symm)
  · intro R _ F h_n G_f H u_star v₁ v₂ a b hF hRel hBez₁ hBez₂
    let I : Ideal R := Ideal.span ({F, h_n} : Set R)
    have hF_cancel : ∀ {q₁ q₂ : R}, F * q₁ = F * q₂ → q₁ = q₂ := by
      intro q₁ q₂ hq
      have h0 : F * (q₁ - q₂) = 0 := by
        rw [mul_sub, hq, sub_self]
      exact sub_eq_zero.mp (hF (q₁ - q₂) h0)
    have hex : ∀ x : ↥I, ∃ q : R, F * q = G_f * x.1 := by
      intro x
      obtain ⟨r₁, r₂, hr⟩ := Ideal.mem_span_pair.mp x.2
      refine ⟨r₁ * G_f + r₂ * H, ?_⟩
      calc
        F * (r₁ * G_f + r₂ * H) = r₁ * G_f * F + r₂ * (F * H) := by ring
        _ = r₁ * G_f * F + r₂ * (h_n * G_f) := by rw [← hRel]
        _ = G_f * (r₁ * F + r₂ * h_n) := by ring
        _ = G_f * x.1 := by rw [hr]
    let q_fn : ↥I → R := fun x => Classical.choose (hex x)
    have hq_spec : ∀ x : ↥I, F * q_fn x = G_f * x.1 :=
      fun x => Classical.choose_spec (hex x)
    let ψ₂ : ↥I →ₗ[R] R :=
      { toFun := q_fn
        map_add' := fun x y => hF_cancel <| by
          rw [hq_spec (x + y), Submodule.coe_add, mul_add, ← hq_spec x, ← hq_spec y, mul_add]
        map_smul' := fun c x => hF_cancel <| by
          rw [RingHom.id_apply, smul_eq_mul, hq_spec (c • x), Submodule.coe_smul, smul_eq_mul]
          calc
            G_f * (c * x.1) = c * (G_f * x.1) := by ring
            _ = c * (F * q_fn x) := by rw [← hq_spec x]
            _ = F * (c * q_fn x) := by ring }
    have hψ₂_spec : ∀ x : ↥I, F * ψ₂ x = G_f * x.1 := hq_spec
    let w₁ : ↥I := ⟨h_n, Ideal.subset_span (by simp)⟩
    let w₂ : ↥I := ⟨F, Ideal.subset_span (by simp)⟩
    let φ₁ : Module.Dual R ↥I := (a * v₁ + b) • Submodule.subtype I
    let φ₂ : Module.Dual R ↥I := (a * v₂) • ψ₂
    have hψ₂_w₂ : ψ₂ w₂ = G_f := hF_cancel <| by
      rw [hψ₂_spec w₂]
      change G_f * F = F * G_f
      ring
    have hTrace : φ₁ w₁ + φ₂ w₂ = 1 := by
      change (a * v₁ + b) * h_n + (a * v₂) * ψ₂ w₂ = 1
      rw [hψ₂_w₂]
      calc
        (a * v₁ + b) * h_n + (a * v₂) * G_f = a * (v₁ * h_n + v₂ * G_f) + b * h_n := by ring
        _ = a * u_star + b * h_n := by rw [hBez₁]
        _ = 1 := hBez₂
    have hReconstruct : ∀ x : ↥I, x = φ₁ x • w₁ + φ₂ x • w₂ := by
      intro x
      ext
      change x.1 = φ₁ x * h_n + φ₂ x * F
      change x.1 = ((a * v₁ + b) * x.1) * h_n + ((a * v₂) * ψ₂ x) * F
      calc
        x.1 = x.1 * 1 := (mul_one x.1).symm
        _ = x.1 * (a * u_star + b * h_n) := by rw [← hBez₂]
        _ = x.1 * (a * (v₁ * h_n + v₂ * G_f) + b * h_n) := by rw [← hBez₁]
        _ = ((a * v₁ + b) * x.1) * h_n + a * v₂ * (G_f * x.1) := by ring
        _ = ((a * v₁ + b) * x.1) * h_n + a * v₂ * (F * ψ₂ x) := by rw [← hψ₂_spec x]
        _ = ((a * v₁ + b) * x.1) * h_n + ((a * v₂) * ψ₂ x) * F := by ring
    let ω : TensorProduct R (Module.Dual R ↥I) ↥I := φ₁ ⊗ₜ[R] w₁ + φ₂ ⊗ₜ[R] w₂
    have hContract_ω : contractLeft R ↥I ω = 1 := by
      dsimp [ω]
      rw [map_add, contractLeft_apply, contractLeft_apply, hTrace]
    have hCross : ∀ (χ : Module.Dual R ↥I) (x z : ↥I), z.1 * χ x = x.1 * χ z := by
      intro χ x z
      have hsmul_comm : z.1 • x = x.1 • z := by
        ext
        simp only [Submodule.coe_smul, smul_eq_mul, mul_comm]
      have hχ := congrArg χ hsmul_comm
      simpa only [map_smul, smul_eq_mul] using hχ
    have hExch₁ : ∀ (χ : Module.Dual R ↥I) (x : ↥I), φ₁ x • χ = χ x • φ₁ := by
      intro χ x
      ext z
      change ((a * v₁ + b) * x.1) * χ z = χ x * ((a * v₁ + b) * z.1)
      calc
        ((a * v₁ + b) * x.1) * χ z = (a * v₁ + b) * (x.1 * χ z) := by ring
        _ = (a * v₁ + b) * (z.1 * χ x) := by rw [hCross χ x z]
        _ = χ x * ((a * v₁ + b) * z.1) := by ring
    have hExch₂ : ∀ (χ : Module.Dual R ↥I) (x : ↥I), φ₂ x • χ = χ x • φ₂ := by
      intro χ x
      ext z
      apply hF_cancel
      change F * (((a * v₂) * ψ₂ x) * χ z) = F * (χ x * ((a * v₂) * ψ₂ z))
      calc
        F * (((a * v₂) * ψ₂ x) * χ z) = a * v₂ * (F * ψ₂ x) * χ z := by ring
        _ = a * v₂ * (G_f * x.1) * χ z := by rw [hψ₂_spec x]
        _ = a * v₂ * G_f * (x.1 * χ z) := by ring
        _ = a * v₂ * G_f * (z.1 * χ x) := by rw [hCross χ x z]
        _ = a * v₂ * (G_f * z.1) * χ x := by ring
        _ = a * v₂ * (F * ψ₂ z) * χ x := by rw [← hψ₂_spec z]
        _ = F * (χ x * ((a * v₂) * ψ₂ z)) := by ring
    have hLeftInv : ∀ t : TensorProduct R (Module.Dual R ↥I) ↥I,
        t = (contractLeft R ↥I t) • ω := by
      intro t
      induction t using TensorProduct.inductionOn with
      | tmul χ x =>
        calc
          χ ⊗ₜ[R] x = χ ⊗ₜ[R] (φ₁ x • w₁ + φ₂ x • w₂) :=
            congrArg (fun m => χ ⊗ₜ[R] m) (hReconstruct x)
          _ = χ ⊗ₜ[R] (φ₁ x • w₁) + χ ⊗ₜ[R] (φ₂ x • w₂) := by
            rw [TensorProduct.tmul_add]
          _ = (φ₁ x • χ) ⊗ₜ[R] w₁ + (φ₂ x • χ) ⊗ₜ[R] w₂ := by
            rw [TensorProduct.smul_tmul (R := R) (φ₁ x) χ w₁,
              TensorProduct.smul_tmul (R := R) (φ₂ x) χ w₂]
          _ = (χ x • φ₁) ⊗ₜ[R] w₁ + (χ x • φ₂) ⊗ₜ[R] w₂ := by
            rw [hExch₁ χ x, hExch₂ χ x]
          _ = χ x • (φ₁ ⊗ₜ[R] w₁) + χ x • (φ₂ ⊗ₜ[R] w₂) := by
            rw [TensorProduct.smul_tmul' (R := R) (χ x) φ₁ w₁,
              TensorProduct.smul_tmul' (R := R) (χ x) φ₂ w₂]
          _ = χ x • ω := (smul_add (χ x) (φ₁ ⊗ₜ[R] w₁) (φ₂ ⊗ₜ[R] w₂)).symm
          _ = (contractLeft R ↥I (χ ⊗ₜ[R] x)) • ω := by rw [contractLeft_apply]
      | add t₁ t₂ ht₁ ht₂ =>
        rw [map_add, add_smul, ← ht₁, ← ht₂]
    refine Module.Invertible.mk ⟨?_, ?_⟩
    · intro t₁ t₂ ht
      rw [hLeftInv t₁, hLeftInv t₂, ht]
    · intro r
      refine ⟨r • ω, ?_⟩
      rw [map_smul, hContract_ω, smul_eq_mul, mul_one]

theorem weil_monic_chartZero_weierstrass_divisor_span (k : Type u) [Field k]
    (ℓ : ℕ) (hℓ_pos : 1 ≤ ℓ)
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (D : WeilTwoChartRingDatum A)
    (D₀ : WeilTwoChartRingDatum k)
    (red : WeilTwoChartCurveReduction D D₀)
    (hA : WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A)
    (hValid : WeilIsValidTwoChartCurveReduction τ_A D D₀ red)
    (n : ℕ) (hn_pos : 1 ≤ n)
    (hWeierstrass : ∀ (d : ℕ) (P : Polynomial A),
      Polynomial.map τ_A.toRingHom P = Polynomial.X ^ d →
      ∃ G_near G_far : Polynomial A,
        G_near.Monic ∧
        G_near.natDegree = d ∧
        Polynomial.map τ_A.toRingHom G_near = Polynomial.X ^ d ∧
        Polynomial.map τ_A.toRingHom G_far = 1 ∧
        P = G_near * G_far ∧
        IsCoprime G_near G_far)
    (L₀ : Type u) [AddCommGroup L₀] [Module D.R₀ L₀]
    (lam₀ : L₀ →ₗ[D.R₀] D.R₀)
    (σ₀ : L₀) (c : Fin D.r → Fin n → A) (w₀ : L₀) :
    letI : Algebra D.R₀ D₀.R₀ := red.algR₀
    let t : D.R₀ := algebraMap (Polynomial A) D.R₀ Polynomial.X
    let t_bar : D₀.R₀ := algebraMap (Polynomial k) D₀.R₀ Polynomial.X
    let π₀ : D.R₀ →+* D₀.R₀ := algebraMap D.R₀ D₀.R₀
    let f_c : D.R₀ := t ^ n + Finset.univ.sum fun j : Fin D.r =>
      Finset.univ.sum fun s : Fin n =>
        algebraMap (Polynomial A) D.R₀ (Polynomial.C (c j s)) * t ^ s.val * D.b₀ j
    (∀ x τ : L₀, lam₀ x • τ = lam₀ τ • x) →
    π₀ (lam₀ σ₀) = 1 →
    (∀ (j : Fin D.r) (s : Fin n), τ_A (c j s) = 0) →
    Function.Bijective (fun v : Fin D.r × Fin (ℓ * n) → A =>
      Finset.univ.sum fun p =>
        (Submodule.span D.R₀ {w₀}).mkQ
          ((algebraMap (Polynomial A) D.R₀ (Polynomial.C (v p)) * t ^ p.2.val * D.b₀ p.1) • σ₀)) →
    (f_c ^ ℓ) • σ₀ ∈ Submodule.span D.R₀ {w₀} →
    ∃ (G_near G_far : Polynomial A) (h_c : D.R₀),
      G_near.Monic ∧
      G_near.natDegree = D.r * n ∧
      Polynomial.map τ_A.toRingHom G_near = Polynomial.X ^ (D.r * n) ∧
      IsCoprime G_near G_far ∧
      algebraMap (Polynomial A) D.R₀ (G_near * G_far) = f_c * h_c ∧
      (∀ x ∈ Ideal.span ({f_c, algebraMap (Polynomial A) D.R₀ G_near} : Set D.R₀),
        ∃ q_bar : D₀.R₀, π₀ x = t_bar ^ n * q_bar) ∧
      (Ideal.span ({f_c, algebraMap (Polynomial A) D.R₀ G_near} : Set D.R₀) ^ ℓ) •
        (⊤ : Submodule D.R₀ L₀) = Submodule.span D.R₀ {w₀} :=
by
  let _ : Algebra D.R₀ D₀.R₀ := red.algR₀
  intro t t_bar π₀ f_c hSymm₀ hσ₀_red hc_ker hBij hPow
  have : IsNoetherianRing A := hA.1
  have : IsLocalRing A := hA.2.1
  have hτ_unit : ∀ a : A, τ_A a = 0 ↔ ¬ IsUnit a := hA.2.2.1
  have hker_τ : RingHom.ker τ_A.toRingHom = IsLocalRing.maximalIdeal A := by
    ext a
    rw [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hτ_unit,
      IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  have hr_pos : 1 ≤ D.r := hValid.1.1
  have hb₀_bij : Function.Bijective (fun f : Fin D.r → Polynomial A =>
      Finset.univ.sum fun j => algebraMap (Polynomial A) D.R₀ (f j) * D.b₀ j) :=
    hValid.1.2.1
  have hD₀_bij : Function.Bijective (fun f : Fin D₀.r → Polynomial k =>
      Finset.univ.sum fun j => algebraMap (Polynomial k) D₀.R₀ (f j) * D₀.b₀ j) :=
    hValid.2.1.2.1
  obtain ⟨hr, -, hb₀_red, -⟩ := hValid.2.2.1
  have hπ₀_poly : ∀ p : Polynomial A,
      π₀ (algebraMap (Polynomial A) D.R₀ p) =
        algebraMap (Polynomial k) D₀.R₀ (Polynomial.map τ_A.toRingHom p) :=
    hValid.2.2.2.1
  have hπ₀_surj : Function.Surjective π₀ := hValid.2.2.2.2.2.1
  have hker_π₀ : RingHom.ker π₀ =
      Ideal.map ((algebraMap (Polynomial A) D.R₀).comp Polynomial.C)
        (IsLocalRing.maximalIdeal A) := by
    rw [← hker_τ]
    exact hValid.2.2.2.2.2.2.1
  let e_r : Fin D.r ≃ Fin D₀.r :=
    { toFun := Fin.cast hr
      invFun := Fin.cast hr.symm
      left_inv := fun _ => by simp
      right_inv := fun _ => by simp }
  have hb₀_bar_eq : (fun f_bar : Fin D.r → Polynomial k =>
      Finset.univ.sum fun j => algebraMap (Polynomial k) D₀.R₀ (f_bar j) * π₀ (D.b₀ j)) =
      (fun f : Fin D₀.r → Polynomial k =>
        Finset.univ.sum fun j => algebraMap (Polynomial k) D₀.R₀ (f j) * D₀.b₀ j) ∘
        (Equiv.arrowCongr e_r (Equiv.refl (Polynomial k))) := by
    ext f_bar
    simp only [Function.comp_apply]
    rw [← Equiv.sum_comp e_r]
    apply Finset.sum_congr rfl
    intro j _
    have hcast : Fin.cast hr j = e_r j := rfl
    rw [hb₀_red j, hcast]
    simp [Equiv.arrowCongr_apply]
  have hb₀_bar_bij : Function.Bijective (fun f_bar : Fin D.r → Polynomial k =>
      Finset.univ.sum fun j => algebraMap (Polynomial k) D₀.R₀ (f_bar j) * π₀ (D.b₀ j)) := by
    rw [hb₀_bar_eq]
    exact hD₀_bij.comp (Equiv.arrowCongr e_r (Equiv.refl (Polynomial k))).bijective
  have ht_red : π₀ t = t_bar := by
    dsimp [t, t_bar]
    rw [hπ₀_poly Polynomial.X, Polynomial.map_X]
  have hfc_red : π₀ f_c = t_bar ^ n := by
    dsimp [f_c]
    rw [map_add, map_pow, ht_red]
    have hsum0 : π₀ (Finset.univ.sum fun j : Fin D.r =>
        Finset.univ.sum fun s : Fin n =>
          algebraMap (Polynomial A) D.R₀ (Polynomial.C (c j s)) * t ^ s.val * D.b₀ j) = 0 := by
      rw [map_sum]
      apply Finset.sum_eq_zero
      intro j _
      rw [map_sum]
      apply Finset.sum_eq_zero
      intro s _
      rw [map_mul, map_mul, hπ₀_poly (Polynomial.C (c j s)), Polynomial.map_C]
      have hc0 : τ_A.toRingHom (c j s) = 0 := hc_ker j s
      rw [hc0, Polynomial.C_0, map_zero, zero_mul, zero_mul]
    rw [hsum0, add_zero]
  let M_fc : Matrix (Fin D.r) (Fin D.r) (Polynomial A) :=
    fun i j => (hb₀_bij.2 (f_c * D.b₀ j)).choose i
  have hM_fc : ∀ j : Fin D.r,
      (Finset.univ.sum fun i : Fin D.r =>
        algebraMap (Polynomial A) D.R₀ (M_fc i j) * D.b₀ i) = f_c * D.b₀ j :=
    fun j => (hb₀_bij.2 (f_c * D.b₀ j)).choose_spec
  let e₁ : Fin D.r → Polynomial A := (hb₀_bij.2 1).choose
  have he₁ : (Finset.univ.sum fun k₀ : Fin D.r =>
      algebraMap (Polynomial A) D.R₀ (e₁ k₀) * D.b₀ k₀) = 1 :=
    (hb₀_bij.2 1).choose_spec
  have hM_fc_red : ∀ i j : Fin D.r,
      Polynomial.map τ_A.toRingHom (M_fc i j) =
        if i = j then (Polynomial.X ^ n : Polynomial k) else 0 := by
    intro i₀ j
    have h_col : (fun i : Fin D.r => Polynomial.map τ_A.toRingHom (M_fc i j)) =
        (fun i : Fin D.r => if i = j then (Polynomial.X ^ n : Polynomial k) else 0) := by
      apply hb₀_bar_bij.1
      dsimp only
      have h1 := congrArg π₀ (hM_fc j)
      rw [map_sum] at h1
      simp only [map_mul, hπ₀_poly] at h1
      rw [h1, hfc_red]
      have hX : t_bar ^ n = algebraMap (Polynomial k) D₀.R₀ (Polynomial.X ^ n) := by
        dsimp [t_bar]
        rw [map_pow]
      rw [hX, Finset.sum_eq_single j]
      · simp
      · intro b _ hbj
        simp [hbj]
      · intro hj
        exact False.elim (hj (Finset.mem_univ j))
    exact congrFun h_col i₀
  let P_c : Polynomial A := M_fc.det
  have hPc_red : Polynomial.map τ_A.toRingHom P_c = Polynomial.X ^ (D.r * n) := by
    change (Polynomial.mapRingHom τ_A.toRingHom) M_fc.det = Polynomial.X ^ (D.r * n)
    rw [RingHom.map_det]
    have hmat : (Polynomial.mapRingHom τ_A.toRingHom).mapMatrix M_fc =
        Matrix.diagonal (fun _ : Fin D.r => (Polynomial.X ^ n : Polynomial k)) := by
      ext i j
      rw [RingHom.mapMatrix_apply, Matrix.map_apply, Polynomial.coe_mapRingHom,
        hM_fc_red i j, Matrix.diagonal_apply]
    rw [hmat, Matrix.det_diagonal, Finset.prod_const, Finset.card_fin, ← pow_mul, mul_comm]
  let B_adj : Matrix (Fin D.r) (Fin D.r) (Polynomial A) := M_fc.adjugate
  have hMul_adj : ∀ i k₀ : Fin D.r,
      (Finset.univ.sum fun j : Fin D.r => M_fc i j * B_adj j k₀) =
        if i = k₀ then P_c else 0 := by
    intro i k₀
    have h := congrArg (fun M => M i k₀) (Matrix.mul_adjugate M_fc)
    simpa [Matrix.mul_apply, Matrix.smul_apply, Matrix.one_apply, P_c, B_adj, smul_eq_mul] using h
  have hfc_col : ∀ k₀ : Fin D.r,
      f_c * (Finset.univ.sum fun j : Fin D.r =>
        algebraMap (Polynomial A) D.R₀ (B_adj j k₀) * D.b₀ j) =
      algebraMap (Polynomial A) D.R₀ P_c * D.b₀ k₀ := by
    intro k₀
    rw [Finset.mul_sum]
    have hstep1 : (Finset.univ.sum fun j : Fin D.r =>
        f_c * (algebraMap (Polynomial A) D.R₀ (B_adj j k₀) * D.b₀ j)) =
      Finset.univ.sum fun j : Fin D.r =>
        Finset.univ.sum fun i : Fin D.r =>
          algebraMap (Polynomial A) D.R₀ (M_fc i j * B_adj j k₀) * D.b₀ i := by
      apply Finset.sum_congr rfl
      intro j _
      have hj : f_c * (algebraMap (Polynomial A) D.R₀ (B_adj j k₀) * D.b₀ j) =
          algebraMap (Polynomial A) D.R₀ (B_adj j k₀) * (f_c * D.b₀ j) := by ring
      rw [hj, ← hM_fc j, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [map_mul]
      ring
    rw [hstep1, Finset.sum_comm]
    have hstep2 : (Finset.univ.sum fun i : Fin D.r =>
        Finset.univ.sum fun j : Fin D.r =>
          algebraMap (Polynomial A) D.R₀ (M_fc i j * B_adj j k₀) * D.b₀ i) =
      Finset.univ.sum fun i : Fin D.r =>
        algebraMap (Polynomial A) D.R₀ (if i = k₀ then P_c else 0) * D.b₀ i := by
      apply Finset.sum_congr rfl
      intro i _
      rw [← Finset.sum_mul, ← map_sum, hMul_adj i k₀]
    rw [hstep2, Finset.sum_eq_single k₀]
    · simp
    · intro i _ hik
      simp [hik]
    · intro hk₀
      exact False.elim (hk₀ (Finset.mem_univ k₀))
  let h_c : D.R₀ := Finset.univ.sum fun k₀ : Fin D.r =>
    algebraMap (Polynomial A) D.R₀ (e₁ k₀) *
      (Finset.univ.sum fun j : Fin D.r =>
        algebraMap (Polynomial A) D.R₀ (B_adj j k₀) * D.b₀ j)
  have hPc_mul : algebraMap (Polynomial A) D.R₀ P_c = f_c * h_c := by
    dsimp [h_c]
    rw [Finset.mul_sum]
    have hstep : (Finset.univ.sum fun k₀ : Fin D.r =>
        f_c * (algebraMap (Polynomial A) D.R₀ (e₁ k₀) *
          (Finset.univ.sum fun j : Fin D.r =>
            algebraMap (Polynomial A) D.R₀ (B_adj j k₀) * D.b₀ j))) =
      algebraMap (Polynomial A) D.R₀ P_c *
        (Finset.univ.sum fun k₀ : Fin D.r =>
          algebraMap (Polynomial A) D.R₀ (e₁ k₀) * D.b₀ k₀) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k₀ _
      calc
        f_c * (algebraMap (Polynomial A) D.R₀ (e₁ k₀) *
            (Finset.univ.sum fun j : Fin D.r =>
              algebraMap (Polynomial A) D.R₀ (B_adj j k₀) * D.b₀ j)) =
          algebraMap (Polynomial A) D.R₀ (e₁ k₀) *
            (f_c * (Finset.univ.sum fun j : Fin D.r =>
              algebraMap (Polynomial A) D.R₀ (B_adj j k₀) * D.b₀ j)) := by ring
        _ = algebraMap (Polynomial A) D.R₀ (e₁ k₀) *
            (algebraMap (Polynomial A) D.R₀ P_c * D.b₀ k₀) := by rw [hfc_col k₀]
        _ = algebraMap (Polynomial A) D.R₀ P_c *
            (algebraMap (Polynomial A) D.R₀ (e₁ k₀) * D.b₀ k₀) := by ring
    rw [hstep, he₁, mul_one]
  obtain ⟨G_near, G_far, hGn_monic, hGn_deg, hGn_red, hGf_red, hPc_split, hCop⟩ :=
    hWeierstrass (D.r * n) P_c hPc_red
  let g_near : D.R₀ := algebraMap (Polynomial A) D.R₀ G_near
  let g_far : D.R₀ := algebraMap (Polynomial A) D.R₀ G_far
  let J₀ : Ideal D.R₀ := Ideal.span ({f_c, g_near} : Set D.R₀)
  let K : Ideal D.R₀ := J₀ ^ ℓ
  have hMul_fc : algebraMap (Polynomial A) D.R₀ (G_near * G_far) = f_c * h_c := by
    rw [← hPc_split]
    exact hPc_mul
  have hg_mul : g_near * g_far = f_c * h_c := by
    dsimp [g_near, g_far]
    rw [← map_mul]
    exact hMul_fc
  have hJ₀_red : ∀ x ∈ J₀, ∃ q_bar : D₀.R₀, π₀ x = t_bar ^ n * q_bar := by
    intro x hx
    obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hx
    have hgn_red0 : π₀ g_near = t_bar ^ n * t_bar ^ ((D.r - 1) * n) := by
      dsimp [g_near, t_bar]
      rw [hπ₀_poly G_near, hGn_red, map_pow]
      have hdr : D.r * n = n + (D.r - 1) * n := by
        calc
          D.r * n = (1 + (D.r - 1)) * n := by rw [Nat.add_sub_of_le hr_pos]
          _ = n + (D.r - 1) * n := by rw [add_mul, one_mul]
      rw [hdr, pow_add]
    refine ⟨π₀ a + π₀ b * t_bar ^ ((D.r - 1) * n), ?_⟩
    rw [← hab, map_add, map_mul, map_mul, hfc_red, hgn_red0]
    ring
  let K₂ : Ideal D.R₀ := Ideal.span ({f_c ^ ℓ, g_near ^ ℓ} : Set D.R₀)
  have hK_eq : K = K₂ := by
    apply le_antisymm
    · have h_mul_J₀ : Ideal.span ({g_far} : Set D.R₀) * J₀ ≤ Ideal.span ({f_c} : Set D.R₀) := by
        rw [Ideal.mul_le]
        intro r hr y hy
        obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hr
        obtain ⟨b₁, b₂, rfl⟩ := Ideal.mem_span_pair.mp hy
        rw [Ideal.mem_span_singleton]
        refine ⟨a * b₁ * g_far + a * b₂ * h_c, ?_⟩
        calc
          g_far * a * (b₁ * f_c + b₂ * g_near) =
              a * b₁ * g_far * f_c + a * b₂ * (g_near * g_far) := by ring
          _ = a * b₁ * g_far * f_c + a * b₂ * (f_c * h_c) := by rw [hg_mul]
          _ = f_c * (a * b₁ * g_far + a * b₂ * h_c) := by ring
      have h_pow_mul : Ideal.span ({g_far ^ ℓ} : Set D.R₀) * K ≤ K₂ := by
        have h1 : (Ideal.span ({g_far} : Set D.R₀) * J₀) ^ ℓ ≤
            (Ideal.span ({f_c} : Set D.R₀)) ^ ℓ :=
          Ideal.pow_right_mono h_mul_J₀ ℓ
        rw [mul_pow, Ideal.span_singleton_pow, Ideal.span_singleton_pow] at h1
        exact h1.trans (Ideal.span_mono (by simp))
      obtain ⟨u₁, u₂, hBez⟩ :=
        (hCop.map (algebraMap (Polynomial A) D.R₀)).pow (m := ℓ) (n := ℓ)
      intro x hx
      have hgfar_x : g_far ^ ℓ * x ∈ K₂ :=
        h_pow_mul (Submodule.mul_mem_mul (Ideal.mem_span_singleton_self (g_far ^ ℓ)) hx)
      have hgnear_mem : g_near ^ ℓ ∈ K₂ := Ideal.subset_span (by simp)
      have hx_eq : x = (u₁ * x) * g_near ^ ℓ + u₂ * (g_far ^ ℓ * x) := by
        calc
