  obtain ⟨r, w, D, D₀, red, Φ₀, Φ₁, Φ₀₁, hr_D, hr_D₀,
    hValD, hValD₀, hw_D, hw_D₀, hb₀_red, hb₁_red, hp₀_red, hp₁_red,
    hΦ₀_alg, hΦ₁_alg, hΦ₀₁_₀, hΦ₀₁_₁, hv_mem⟩ := hInd m le_rfl
  letI : Algebra D.R₀ D₀.R₀ := red.algR₀
  letI : Algebra D.R₁ D₀.R₁ := red.algR₁
  have hSurjKer : ∀ {R : Type u} {R_bar : Type u} [CommRing R] [CommRing R_bar]
      [Algebra (Polynomial A) R] [Algebra (Polynomial k) R_bar] [Algebra R R_bar]
      (b : Fin r → R) (b_bar : Fin r → R_bar),
      Function.Bijective (fun f : Fin r → Polynomial A =>
        Finset.univ.sum fun j => algebraMap (Polynomial A) R (f j) * b j) →
      Function.Bijective (fun f : Fin r → Polynomial k =>
        Finset.univ.sum fun j => algebraMap (Polynomial k) R_bar (f j) * b_bar j) →
      (∀ j : Fin r, algebraMap R R_bar (b j) = b_bar j) →
      (∀ p : Polynomial A, algebraMap R R_bar (algebraMap (Polynomial A) R p) =
        algebraMap (Polynomial k) R_bar (Polynomial.map τ_A.toRingHom p)) →
      Function.Surjective (algebraMap R R_bar) ∧
      RingHom.ker (algebraMap R R_bar) =
        Ideal.map ((algebraMap (Polynomial A) R).comp Polynomial.C) (RingHom.ker τ_A.toRingHom) := by
    intro R R_bar _ _ _ _ _ b b_bar hbij hbij_bar hb_eq hp_eq
    constructor
    · intro y
      obtain ⟨f_bar, rfl⟩ := hbij_bar.2 y
      let f : Fin r → Polynomial A := fun j => Polynomial.map (algebraMap k A) (f_bar j)
      refine ⟨Finset.univ.sum fun j => algebraMap (Polynomial A) R (f j) * b j, ?_⟩
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro j _
      rw [map_mul, hp_eq (f j), hb_eq j]
      have hmap_id : Polynomial.map τ_A.toRingHom (f j) = f_bar j := by
        dsimp [f]
        rw [Polynomial.map_map]
        have hid : Polynomial.map (RingHom.id k) (f_bar j) = f_bar j := Polynomial.map_id
        conv_rhs => rw [← hid]
        congr 1
        apply RingHom.ext; intro c
        exact τ_A.commutes c
      rw [hmap_id]
    · apply le_antisymm
      · intro x hx
        rw [RingHom.mem_ker] at hx
        obtain ⟨f, rfl⟩ := hbij.2 x
        have hmap0 : (Finset.univ.sum fun j : Fin r =>
            algebraMap (Polynomial k) R_bar (Polynomial.map τ_A.toRingHom (f j)) * b_bar j) =
            Finset.univ.sum fun j : Fin r =>
              algebraMap (Polynomial k) R_bar (0 : Polynomial k) * b_bar j := by
          simpa only [map_sum, map_mul, hp_eq, hb_eq, map_zero, zero_mul, Finset.sum_const_zero] using hx
        have hf_ker : ∀ j : Fin r, Polynomial.map τ_A.toRingHom (f j) = 0 :=
          fun j => congrFun (hbij_bar.1 hmap0) j
        apply Ideal.sum_mem
        intro j _
        rw [poly_sum_eq (f j).natDegree (f j) le_rfl, map_sum, Finset.sum_mul]
        apply Ideal.sum_mem
        intro d _
        rw [map_mul, mul_assoc]
        apply Ideal.mul_mem_right
        have hd_ker : (f j).coeff d ∈ RingHom.ker τ_A.toRingHom := by
          rw [RingHom.mem_ker]
          have hc := congrArg (fun q => q.coeff d) (hf_ker j)
          simpa [Polynomial.coeff_map] using hc
        exact Ideal.mem_map_of_mem ((algebraMap (Polynomial A) R).comp Polynomial.C) hd_ker
      · rw [Ideal.map_le_iff_le_comap]
        intro a ha
        rw [RingHom.mem_ker] at ha
        change (algebraMap R R_bar) (algebraMap (Polynomial A) R (Polynomial.C a)) = 0
        rw [hp_eq (Polynomial.C a), Polynomial.map_C, ha, Polynomial.C_0, map_zero]
  have hBij₀_D_r : Function.Bijective (fun f : Fin r → Polynomial A =>
      Finset.univ.sum fun j => algebraMap (Polynomial A) D.R₀ (f j) * D.b₀ (Fin.cast hr_D.symm j)) := by
    subst hr_D; exact hValD.2.1
  have hBij₁_D_r : Function.Bijective (fun f : Fin r → Polynomial A =>
      Finset.univ.sum fun j => algebraMap (Polynomial A) D.R₁ (f j) * D.b₁ (Fin.cast hr_D.symm j)) := by
    subst hr_D; exact hValD.2.2.1
  have hBij₀_D₀_r : Function.Bijective (fun f : Fin r → Polynomial k =>
      Finset.univ.sum fun j => algebraMap (Polynomial k) D₀.R₀ (f j) * D₀.b₀ (Fin.cast hr_D₀.symm j)) := by
    subst hr_D₀; exact hValD₀.2.1
  have hBij₁_D₀_r : Function.Bijective (fun f : Fin r → Polynomial k =>
      Finset.univ.sum fun j => algebraMap (Polynomial k) D₀.R₁ (f j) * D₀.b₁ (Fin.cast hr_D₀.symm j)) := by
    subst hr_D₀; exact hValD₀.2.2.1
  obtain ⟨hSurj₀, hKer₀⟩ := hSurjKer
    (fun j => D.b₀ (Fin.cast hr_D.symm j)) (fun j => D₀.b₀ (Fin.cast hr_D₀.symm j))
    hBij₀_D_r hBij₀_D₀_r hb₀_red hp₀_red
  obtain ⟨hSurj₁, hKer₁⟩ := hSurjKer
    (fun j => D.b₁ (Fin.cast hr_D.symm j)) (fun j => D₀.b₁ (Fin.cast hr_D₀.symm j))
    hBij₁_D_r hBij₁_D₀_r hb₁_red hp₁_red
  have hΦ₀_surj : Function.Surjective Φ₀ := by
    let Φ₀_alg : D.R₀ →ₐ[Polynomial A] B₀ :=
      { Φ₀ with commutes' := fun p => RingHom.congr_fun hΦ₀_alg p }
    change Function.Surjective Φ₀_alg
    rw [← AlgHom.range_eq_top (f := Φ₀_alg), eq_top_iff, ← hadj₀, Algebra.adjoin_le_iff]
    rintro _ ⟨α, rfl⟩
    exact (hv_mem α α.isLt).1
  have hΦ₁_surj : Function.Surjective Φ₁ := by
    let Φ₁_alg : D.R₁ →ₐ[Polynomial A] B₁ :=
      { Φ₁ with commutes' := fun p => RingHom.congr_fun hΦ₁_alg p }
    change Function.Surjective Φ₁_alg
    rw [← AlgHom.range_eq_top (f := Φ₁_alg), eq_top_iff, ← hadj₁, Algebra.adjoin_le_iff]
    rintro _ ⟨α, rfl⟩
    exact (hv_mem α α.isLt).2
  refine ⟨D, D₀, red, Φ₀, Φ₁, Φ₀₁, ?_, hΦ₀_alg, hΦ₁_alg, hΦ₀_surj, hΦ₁_surj, hΦ₀₁_₀, hΦ₀₁_₁⟩
  subst hr_D
  exact ⟨hValD, hValD₀, ⟨hr_D₀.symm, fun j => (hw_D j).trans (hw_D₀ j).symm, hb₀_red, hb₁_red⟩,
    hp₀_red, hp₁_red, hSurj₀, hKer₀, hSurj₁, hKer₁⟩);



have weil_part4_test (k : Type u) [Field k]
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
