      · rintro ⟨w, hw, hwu⟩
        exact hU₁_inj hwu ▸ hw
      · intro hu
        exact ⟨u, hu, rfl⟩
    have hV_img : V_bar.ι ''ᵁ W_bar = U_bar := by
      ext y
      constructor
      · rintro ⟨v, hv, rfl⟩
        change (V_bar.ι ≫ q_Z).base v ∈ U
        rw [← morphismRestrict_ι]
        exact ⟨q_U₁.base v, hv, rfl⟩
      · intro hy
        change q_Z.base y ∈ U at hy
        rcases hy with ⟨u, huW, hyu⟩
        have hyV : y ∈ V_bar := by
          change q_Z.base y ∈ U₁
          rw [← hyu]
          exact u.2
        refine ⟨⟨y, hyV⟩, ?_, rfl⟩
        change q_U₁.base ⟨y, hyV⟩ ∈ W.1
        have hq : U₁.ι.base (q_U₁.base ⟨y, hyV⟩) = U₁.ι.base u := by
          change ((q_U₁ ≫ U₁.ι).base ⟨y, hyV⟩) = U₁.ι.base u
          rw [morphismRestrict_ι]
          exact hyu.symm
        exact hU₁_inj hq ▸ huW
    have hV_pre : V_bar.ι ⁻¹ᵁ U_bar = W_bar := by
      rw [← hV_img]
      ext v
      constructor
      · rintro ⟨w, hw, hwv⟩
        exact hVbar_inj hwv ▸ hw
      · intro hv
        exact ⟨v, hv, rfl⟩
    have hIso_Viota : IsIso (V_bar.ι.app U_bar) := by
      rw [← hV_img]
      exact inferInstance
    have h_open_L : η_Z ⁻¹ᵁ U = η₁ ⁻¹ᵁ W.1 := by
      rw [h_ηZ_eq1]
      change η₁ ⁻¹ᵁ (U₁.ι ⁻¹ᵁ U) = η₁ ⁻¹ᵁ W.1
      rw [hU₁_pre]
    have h_pre_toNorm :
        η_Z.toNormalization ⁻¹ᵁ U_bar =
          η₁.toNormalization ⁻¹ᵁ (η₁.fromNormalization ⁻¹ᵁ W.1) := by
      have h1 : η_Z.toNormalization ⁻¹ᵁ U_bar = (η_Z.toNormalization ≫ q_Z) ⁻¹ᵁ U := rfl
      have h2 : η₁.toNormalization ⁻¹ᵁ (η₁.fromNormalization ⁻¹ᵁ W.1) =
          (η₁.toNormalization ≫ η₁.fromNormalization) ⁻¹ᵁ W.1 := rfl
      rw [h1, η_Z.toNormalization_fromNormalization, h2,
        η₁.toNormalization_fromNormalization, h_open_L]
    have h_rhs := η_Z.toNormalization_app_preimage ⟨U, hU⟩
    have h_lhs_norm := η₁.toNormalization_app_preimage W
    let α₁ : Y_Z.presheaf.obj (Opposite.op U_bar) ⟶
        (V_bar : Scheme.{u}).presheaf.obj (Opposite.op W_bar) :=
      V_bar.ι.app U_bar ≫ (V_bar : Scheme.{u}).presheaf.map (eqToHom hV_pre.symm).op
    have : IsIso α₁ :=
      @IsIso.comp_isIso _ _ _ _ _ _ _ hIso_Viota (hIso_map_eq hV_pre.symm)
    let β₁ : η₁.normalization.presheaf.obj (Opposite.op (φ ⁻¹ᵁ W_bar)) ⟶
        η₁.normalization.presheaf.obj (Opposite.op (η₁.fromNormalization ⁻¹ᵁ W.1)) :=
      η₁.normalization.presheaf.map (eqToHom h_phi_pre.symm).op
    have : IsIso β₁ := hIso_map_eq h_phi_pre.symm
    let ρ_end : (Spec L_cat).presheaf.obj
        (Opposite.op (η₁.toNormalization ⁻¹ᵁ (η₁.fromNormalization ⁻¹ᵁ W.1))) ⟶
        (Spec L_cat).presheaf.obj
        (Opposite.op (η_Z.toNormalization ⁻¹ᵁ U_bar)) :=
      (Spec L_cat).presheaf.map (eqToHom h_pre_toNorm).op
    have : IsIso ρ_end := hIso_map_eq h_pre_toNorm
    have h_comm_cat : α₁ ≫ φ.app W_bar ≫ β₁ ≫
        η₁.toNormalization.app (η₁.fromNormalization ⁻¹ᵁ W.1) ≫ ρ_end =
        η_Z.toNormalization.app U_bar := by
      have h_L1 : η_Z.toNormalization ⁻¹ᵁ U_bar = (η₁.toNormalization ≫ φ) ⁻¹ᵁ W_bar := by
        rw [← h_toNorm]
        exact congrArg ((η₁.toNormalization ≫ φ) ⁻¹ᵁ ·) hV_pre
      have h_L2 : (η₁.toNormalization ≫ φ) ⁻¹ᵁ W_bar =
          η₁.toNormalization ⁻¹ᵁ (η₁.fromNormalization ⁻¹ᵁ W.1) :=
        congrArg (η₁.toNormalization ⁻¹ᵁ ·) h_phi_pre
      have h_step1 := h_comp_app_eq (η₁.toNormalization ≫ φ) V_bar.ι η_Z.toNormalization
        (by rw [Category.assoc, h_toNorm]) U_bar W_bar hV_pre h_L1
      have h_step2 := h_comp_app_eq η₁.toNormalization φ (η₁.toNormalization ≫ φ)
        rfl W_bar (η₁.fromNormalization ⁻¹ᵁ W.1) h_phi_pre h_L2
      rw [h_step1, h_step2]
      dsimp only [α₁, β₁, ρ_end]
      simp only [Category.assoc]
      have h_end : (Spec L_cat).presheaf.map (eqToHom h_L2).op ≫
          (Spec L_cat).presheaf.map (eqToHom h_L1).op =
          (Spec L_cat).presheaf.map (eqToHom h_pre_toNorm).op := by
        rw [← CategoryTheory.Functor.map_comp, ← op_comp, eqToHom_trans]
      rw [h_end]
    let γ_L : (Spec L_cat).presheaf.obj (Opposite.op (η₁ ⁻¹ᵁ W.1)) ≅
        (Spec L_cat).presheaf.obj (Opposite.op (η_Z ⁻¹ᵁ U)) :=
      (Spec L_cat).presheaf.mapIso (eqToIso h_open_L).op
    have h_bij_phi : Function.Bijective (φ.app W_bar).hom := by
      let g₁ := α₁.hom
      let f_hom := (φ.app W_bar).hom
      let g₂ := (β₁ ≫ η₁.toNormalization.app (η₁.fromNormalization ⁻¹ᵁ W.1) ≫ ρ_end).hom
      let h_tot := (η_Z.toNormalization.app U_bar).hom
      have h_eq_fn : ∀ a, g₂ (f_hom (g₁ a)) = h_tot a := fun a =>
        congrArg (fun m => m.hom a) h_comm_cat
      have hg₁_bij : Function.Bijective g₁ :=
        (asIso α₁).commRingCatIsoToRingEquiv.bijective
      have hg₂_inj : Function.Injective g₂ := by
        intro x y hxy
        change ρ_end.hom ((η₁.toNormalization.app (η₁.fromNormalization ⁻¹ᵁ W.1)).hom (β₁.hom x)) =
          ρ_end.hom ((η₁.toNormalization.app (η₁.fromNormalization ⁻¹ᵁ W.1)).hom (β₁.hom y)) at hxy
        have hxy0 := (asIso ρ_end).commRingCatIsoToRingEquiv.injective hxy
        have hx := congrArg (fun m => m.hom (β₁.hom x)) h_lhs_norm
        have hy := congrArg (fun m => m.hom (β₁.hom y)) h_lhs_norm
        rw [hx, hy] at hxy0
        simp only [CommRingCat.comp_apply] at hxy0
        have hxy1 := (@asIso _ _ _ _ ((Spec L_cat).presheaf.map (eqToHom _).op)
          (hIso_map_eq _)).commRingCatIsoToRingEquiv.injective hxy0
        have hxy2 : (η₁.normalizationObjIso W.2).hom.hom (β₁.hom x) =
            (η₁.normalizationObjIso W.2).hom.hom (β₁.hom y) := Subtype.ext hxy1
        have hxy3 := (η₁.normalizationObjIso W.2).commRingCatIsoToRingEquiv.injective hxy2
        exact (asIso β₁).commRingCatIsoToRingEquiv.injective hxy3
      have hh_inj : Function.Injective h_tot := by
        intro x y hxy
        have hx := congrArg (fun m => m.hom x) h_rhs
        have hy := congrArg (fun m => m.hom y) h_rhs
        dsimp only [h_tot, U_bar] at hxy
        change (η_Z.toNormalization.app (η_Z.fromNormalization ⁻¹ᵁ ↑(⟨U, hU⟩ : Z.affineOpens))).hom x =
          (η_Z.toNormalization.app (η_Z.fromNormalization ⁻¹ᵁ ↑(⟨U, hU⟩ : Z.affineOpens))).hom y at hxy
        rw [hx, hy] at hxy
        simp only [CommRingCat.comp_apply] at hxy
        have hxy1 := (@asIso _ _ _ _ ((Spec L_cat).presheaf.map (eqToHom _).op)
          (hIso_map_eq _)).commRingCatIsoToRingEquiv.injective hxy
        have hxy2 : (η_Z.normalizationObjIso hU).hom.hom x =
            (η_Z.normalizationObjIso hU).hom.hom y := Subtype.ext hxy1
        exact (η_Z.normalizationObjIso hU).commRingCatIsoToRingEquiv.injective hxy2
      have h_range_sub : Set.range g₂ ⊆ Set.range h_tot := by
        rintro _ ⟨c, rfl⟩
        let c' := β₁.hom c
        let s_W := (η₁.normalizationObjIso W.2).hom.hom c'
        have hsW_int : RingHom.IsIntegralElem (η₁.app W.1).hom s_W.1 := s_W.2
        have hIso_U₁iota : IsIso (U₁.ι.app U) := by
          change IsIso (U₁.ι.app (U₁.ι ''ᵁ W.1))
          exact inferInstance
        let σ_U : Z.presheaf.obj (Opposite.op U) ⟶
            (U₁ : Scheme.{u}).presheaf.obj (Opposite.op W.1) :=
          U₁.ι.app U ≫ (U₁ : Scheme.{u}).presheaf.map (eqToHom hU₁_pre.symm).op
        have : IsIso σ_U :=
          @IsIso.comp_isIso _ _ _ _ _ _ _ hIso_U₁iota (hIso_map_eq hU₁_pre.symm)
        have hσ_surj : Function.Surjective σ_U.hom :=
          (asIso σ_U).commRingCatIsoToRingEquiv.surjective
        have h_ηZ_appU : η_Z.app U = σ_U ≫ η₁.app W.1 ≫ γ_L.hom := by
          have hc := h_comp_app_eq η₁ U₁.ι η_Z h_ηZ_eq1 U W.1 hU₁_pre h_open_L
          rw [hc]
          dsimp only [σ_U, γ_L]
          simp only [Functor.mapIso_hom, Iso.op_hom, eqToIso.hom, Category.assoc]
        let alg_W : Algebra ↑((U₁ : Scheme.{u}).presheaf.obj (Opposite.op W.1))
            ↑((Spec L_cat).presheaf.obj (Opposite.op (η₁ ⁻¹ᵁ W.1))) :=
          (η₁.app W.1).hom.toAlgebra
        let alg_U_W : Algebra ↑(Z.presheaf.obj (Opposite.op U))
            ↑((U₁ : Scheme.{u}).presheaf.obj (Opposite.op W.1)) :=
          σ_U.hom.toAlgebra
        let alg_U_L1 : Algebra ↑(Z.presheaf.obj (Opposite.op U))
            ↑((Spec L_cat).presheaf.obj (Opposite.op (η₁ ⁻¹ᵁ W.1))) :=
          (σ_U ≫ η₁.app W.1).hom.toAlgebra
        have hTower_UW : @IsScalarTower ↑(Z.presheaf.obj (Opposite.op U))
            ↑((U₁ : Scheme.{u}).presheaf.obj (Opposite.op W.1))
            ↑((Spec L_cat).presheaf.obj (Opposite.op (η₁ ⁻¹ᵁ W.1)))
            alg_U_W.toSMul alg_W.toSMul alg_U_L1.toSMul :=
          @IsScalarTower.of_algebraMap_eq' _ _ _ _ _ _ alg_U_W alg_W alg_U_L1 rfl
        have hInt_UW : @Algebra.IsIntegral ↑(Z.presheaf.obj (Opposite.op U))
            ↑((U₁ : Scheme.{u}).presheaf.obj (Opposite.op W.1)) _ _ alg_U_W :=
          @Algebra.isIntegral_of_surjective _ _ _ _ alg_U_W hσ_surj
        have hsW_int_U : @IsIntegral ↑(Z.presheaf.obj (Opposite.op U)) _ _ _ alg_U_L1 s_W.1 :=
          @isIntegral_trans _ _ _ _ _ _ alg_W alg_U_L1 alg_U_W hTower_UW hInt_UW s_W.1 hsW_int
        let alg_U_LZ : Algebra ↑(Z.presheaf.obj (Opposite.op U))
            ↑((Spec L_cat).presheaf.obj (Opposite.op (η_Z ⁻¹ᵁ U))) :=
          (η_Z.app U).hom.toAlgebra
        let e_γ : @AlgEquiv ↑(Z.presheaf.obj (Opposite.op U))
            ↑((Spec L_cat).presheaf.obj (Opposite.op (η₁ ⁻¹ᵁ W.1)))
            ↑((Spec L_cat).presheaf.obj (Opposite.op (η_Z ⁻¹ᵁ U)))
            _ _ _ alg_U_L1 alg_U_LZ :=
          @AlgEquiv.ofRingEquiv _ _ _ _ _ _ alg_U_L1 alg_U_LZ
            γ_L.commRingCatIsoToRingEquiv fun r => by
              change γ_L.hom.hom ((σ_U ≫ η₁.app W.1).hom r) = (η_Z.app U).hom r
              rw [h_ηZ_appU]; rfl
        have hsU_int : @IsIntegral ↑(Z.presheaf.obj (Opposite.op U)) _ _ _ alg_U_LZ (e_γ s_W.1) := by
          let _ := alg_U_L1
          let _ := alg_U_LZ
          exact IsIntegral.map e_γ hsW_int_U
        let s_U : ↥(@integralClosure ↑(Z.presheaf.obj (Opposite.op U))
            ↑((Spec L_cat).presheaf.obj (Opposite.op (η_Z ⁻¹ᵁ U))) _ _ alg_U_LZ) :=
          ⟨e_γ s_W.1, hsU_int⟩
        let a := (η_Z.normalizationObjIso hU).inv.hom s_U
        refine ⟨a, ?_⟩
        dsimp only [h_tot, g₂, U_bar]
        have ha_val := congrArg (fun m => m.hom a) h_rhs
        have hc_val := congrArg (fun m => m.hom c') h_lhs_norm
        change (η_Z.toNormalization.app (η_Z.fromNormalization ⁻¹ᵁ ↑(⟨U, hU⟩ : Z.affineOpens))).hom a =
          ρ_end.hom ((η₁.toNormalization.app (η₁.fromNormalization ⁻¹ᵁ ↑W)).hom c')
        rw [ha_val, hc_val]
        simp only [CommRingCat.comp_apply]
        have h_iso_U : (η_Z.normalizationObjIso hU).hom.hom a = s_U := by
          dsimp only [a]
          change ((η_Z.normalizationObjIso hU).inv ≫ (η_Z.normalizationObjIso hU).hom).hom s_U = s_U
          rw [Iso.inv_hom_id]; rfl
        rw [h_iso_U]
        change ((Spec L_cat).presheaf.map (eqToHom _).op).hom (γ_L.hom.hom s_W.1) =
          ρ_end.hom (((Spec L_cat).presheaf.map (eqToHom _).op).hom s_W.1)
        dsimp only [γ_L, ρ_end]
        simp only [Functor.mapIso_hom, Iso.op_hom, eqToIso.hom]
        rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
          ← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp,
          ← op_comp, ← op_comp, eqToHom_trans, eqToHom_trans]
      refine ⟨?_, ?_⟩
      · intro b₁ b₂ hb
        obtain ⟨a₁, rfl⟩ := hg₁_bij.2 b₁
        obtain ⟨a₂, rfl⟩ := hg₁_bij.2 b₂
        have h12 : h_tot a₁ = h_tot a₂ := by
          rw [← h_eq_fn a₁, ← h_eq_fn a₂, hb]
        rw [hh_inj h12]
      · intro c
        obtain ⟨a, ha⟩ := h_range_sub ⟨c, rfl⟩
        exact ⟨g₁ a, hg₂_inj (by rw [h_eq_fn a, ha])⟩
    have hIso_phi_W : IsIso (φ.app W_bar) :=
      (ConcreteCategory.isIso_iff_bijective (φ.app W_bar)).mpr h_bij_phi
    have h_top_img : W_bar.ι ''ᵁ (⊤ : (W_bar : Scheme.{u}).Opens) = W_bar := by
      ext v
      constructor
      · rintro ⟨w, -, rfl⟩; exact w.2
      · intro hv; exact ⟨⟨v, hv⟩, trivial, rfl⟩
    have hIso_top_app : IsIso (φ.app (W_bar.ι ''ᵁ ⊤)) := by
      have hnat_top := φ.naturality (eqToHom h_top_img.symm).op
      have hIso_lhs : IsIso ((V_bar : Scheme.{u}).presheaf.map (eqToHom h_top_img.symm).op ≫
          φ.app W_bar) :=
        @IsIso.comp_isIso _ _ _ _ _ _ _ (hIso_map_eq h_top_img.symm) hIso_phi_W
      have hIso_rhs_map : IsIso (η₁.normalization.presheaf.map
          ((TopologicalSpace.Opens.map φ.base).map (eqToHom h_top_img.symm).op.unop).op) := by
        have hp : ((TopologicalSpace.Opens.map φ.base).map (eqToHom h_top_img.symm).op.unop) =
            eqToHom (congrArg (φ ⁻¹ᵁ ·) h_top_img.symm) :=
          CategoryTheory.eqToHom_map _ h_top_img.symm
        rw [hp]
        exact hIso_map_eq _
      have : IsIso (φ.app (W_bar.ι ''ᵁ ⊤) ≫
          η₁.normalization.presheaf.map
            ((TopologicalSpace.Opens.map φ.base).map (eqToHom h_top_img.symm).op.unop).op) := by
        rw [← hnat_top]
        exact hIso_lhs
      exact @IsIso.of_isIso_comp_right _ _ _ _ _ (φ.app (W_bar.ι ''ᵁ ⊤)) _ hIso_rhs_map this
    have : IsIso (φ ∣_ W_bar).appTop := by
      rw [morphismRestrict_appTop]
      exact @IsIso.comp_isIso _ _ _ _ _ _ _ hIso_top_app (hIso_map_eq _)
    have h_nat := Scheme.toSpecΓ_naturality (φ ∣_ W_bar)
    have : IsIso ((φ ∣_ W_bar) ≫ (W_bar : Scheme.{u}).toSpecΓ) := by
      rw [h_nat]; infer_instance
    exact IsIso.of_isIso_comp_right (φ ∣_ W_bar) (W_bar : Scheme.{u}).toSpecΓ
  
  let d₁ : η₁.normalization ⟶ V₁ := η₁.normalizationDesc η_V p₁ rfl
  let s₁ : (V_bar : Scheme.{u}) ⟶ V₁ := CategoryTheory.inv φ ≫ d₁
  have hs₁_p₁ : s₁ ≫ p₁ = q_U₁ := by
    dsimp [s₁, d₁]
    rw [Category.assoc, η₁.normalizationDesc_comp η_V p₁ rfl, ← hφ_comp, IsIso.inv_hom_id_assoc]
  have hComm : V_bar.ι ≫ q_Z = s₁ ≫ p₁ ≫ U₁.ι := by
    rw [← Category.assoc s₁ p₁ U₁.ι, hs₁_p₁, morphismRestrict_ι]
  have hFin_s₁ : IsFinite s₁ := by
    have hcomp_fin : IsFinite (s₁ ≫ p₁) := by rwa [hs₁_p₁]
    exact (IsFinite.comp_iff (f := s₁) (g := p₁)).mp hcomp_fin
  have hSurj_s₁ : Surjective s₁ := by
    constructor
    have hj_s₁ : j_L ≫ s₁ = η_V := by
      dsimp [s₁, d₁]
      rw [← hφ_to, Category.assoc, IsIso.hom_inv_id_assoc,
        η₁.toNormalization_normalizationDesc η_V p₁ rfl]
    have hxV_range : x_V ∈ Set.range s₁.base := by
      have hxV_η : x_V ∈ Set.range η_V.base := by
        dsimp [η_V]
        rw [Scheme.range_fromSpecStalk]
        exact specializes_rfl
      rcases hxV_η with ⟨z, hz⟩
      rw [← hj_s₁] at hz
      exact ⟨j_L.base z, hz⟩
    have hcl_range : IsClosed (Set.range s₁.base) :=
      s₁.isClosedMap.isClosed_range
    have h_univ : (Set.univ : Set ↥V₁) ⊆ Set.range s₁.base := by
      rw [← (genericPoint_spec ↥V₁).def]
      exact hcl_range.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hxV_range)
    exact fun v => h_univ trivial
  exact ⟨Y_Z, q_Z, V_bar, s₁, inferInstance, hGlobalNorm, hFin_qZ, hVbar_ne,
    hFin_s₁, hSurj_s₁, hComm⟩

theorem weil_etale_finite_pushforward_patch_and_coprod (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hFinPBC : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S)
      [AlgebraicGeometry.IsFinite f], WeilCanonicalModPrimePBC ℓ f) :
    (∀ (X : AlgebraicGeometry.Scheme.{u})
        (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback (CategoryTheory.CategoryStruct.id X) F F) ∧
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
        (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}),
      ∃ F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u},
        WeilIsEtaleSheafPullback h F₂ F₁ ∧
        (ℓ • CategoryTheory.CategoryStruct.id F₂ = 0 →
          ℓ • CategoryTheory.CategoryStruct.id F₁ = 0)) ∧
    (∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃)
        (F₃ : CategoryTheory.Sheaf X₃.smallEtaleTopology AddCommGrpCat.{u})
        (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback g F₃ F₂ →
      WeilIsEtaleSheafPullback f F₂ F₁ →
      WeilIsEtaleSheafPullback (f ≫ g) F₃ F₁) ∧
    (∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃)
        (F₃ : CategoryTheory.Sheaf X₃.smallEtaleTopology AddCommGrpCat.{u})
        (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback g F₃ F₂ →
      WeilIsEtaleSheafPullback (f ≫ g) F₃ F₁ →
      WeilIsEtaleSheafPullback f F₂ F₁) ∧
    (∀ {V₁ V₀ : AlgebraicGeometry.Scheme.{u}} (ι : V₁ ⟶ V₀) (A₀ : AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback ι
        ((CategoryTheory.constantSheaf V₀.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)
        ((CategoryTheory.constantSheaf V₁.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u})
        (F : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
      IsEmpty W →
      ∃ (u : F ⟶ weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id W) 0
          (weilEtaleTorsionSheaf W ℓ)),
        CategoryTheory.Mono u) ∧
    (∀ {W_red W Y_red : AlgebraicGeometry.Scheme.{u}}
