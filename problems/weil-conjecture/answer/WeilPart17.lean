      ((1 : U₀) ⊗ₜ[R] σ₁ m₁ : TensorProduct R U₀ U₁) =
        (g₀₁ : TensorProduct R U₀ U₁) * (σ₀ m₀ ⊗ₜ[R] (1 : U₁))
    have hR_uniq_right : ∀ m₀ m₁ m₁', R_rel m₀ m₁ → R_rel m₀ m₁' → m₁ = m₁' := by
      intro m₀ m₁ m₁' h1 h2
      exact hTw₁.1 (hInj_U₀_U₁ (h1.trans h2.symm))
    have hR_uniq_left : ∀ m₀ m₀' m₁, R_rel m₀ m₁ → R_rel m₀' m₁ → m₀ = m₀' := by
      intro m₀ m₀' m₁ h1 h2
      have hmul : (g₀₁ : TensorProduct R U₀ U₁) * (σ₀ m₀ ⊗ₜ[R] (1 : U₁)) =
          (g₀₁ : TensorProduct R U₀ U₁) * (σ₀ m₀' ⊗ₜ[R] (1 : U₁)) := h1.symm.trans h2
      have hcancel := congrArg (((g₀₁⁻¹ : Units (TensorProduct R U₀ U₁)) : TensorProduct R U₀ U₁) * ·) hmul
      simp only [← mul_assoc, Units.inv_mul, one_mul] at hcancel
      exact hTw₀.1 (hInj_U₁_U₀ hcancel)
    have hR_fwd : ∀ m₀ : M₀, ∃ m₁ : M₁, R_rel m₀ m₁ := by
      intro m₀
      let w₀ : U₀ := σ₀ m₀
      let z : TensorProduct R U₀ U₁ := (g₀₁ : TensorProduct R U₀ U₁) * (w₀ ⊗ₜ[R] (1 : U₁))
      have hz_eq : q₀₀₁_₂₃ z = q₀₀₁_₁₃ z := by
        have hw₀_23 : q₀₀₁_₂₃ (w₀ ⊗ₜ[R] (1 : U₁)) =
            q₀₀₁_₁₂ g₀₀ * q₀₀₁_₁₃ (w₀ ⊗ₜ[R] (1 : U₁)) := by
          calc
            q₀₀₁_₂₃ (w₀ ⊗ₜ[R] (1 : U₁)) = q₀₀₁_₁₂ ((1 : U₀) ⊗ₜ[R] w₀) := by
              rw [hq001_23_tmul, hq001_12_tmul]
            _ = q₀₀₁_₁₂ (g₀₀ * (w₀ ⊗ₜ[R] (1 : U₀))) := by rw [hCoc₀ m₀]
            _ = q₀₀₁_₁₂ g₀₀ * q₀₀₁_₁₂ (w₀ ⊗ₜ[R] (1 : U₀)) := map_mul q₀₀₁_₁₂ _ _
            _ = q₀₀₁_₁₂ g₀₀ * q₀₀₁_₁₃ (w₀ ⊗ₜ[R] (1 : U₁)) := by
              rw [hq001_12_tmul, hq001_13_tmul]
        calc
          q₀₀₁_₂₃ z = q₀₀₁_₂₃ (g₀₁ : TensorProduct R U₀ U₁) * q₀₀₁_₂₃ (w₀ ⊗ₜ[R] (1 : U₁)) :=
              map_mul q₀₀₁_₂₃ _ _
          _ = q₀₀₁_₂₃ (g₀₁ : TensorProduct R U₀ U₁) *
              (q₀₀₁_₁₂ g₀₀ * q₀₀₁_₁₃ (w₀ ⊗ₜ[R] (1 : U₁))) := by rw [hw₀_23]
          _ = (q₀₀₁_₁₂ g₀₀ * q₀₀₁_₂₃ (g₀₁ : TensorProduct R U₀ U₁)) *
              q₀₀₁_₁₃ (w₀ ⊗ₜ[R] (1 : U₁)) := by ring
          _ = q₀₀₁_₁₃ (g₀₁ : TensorProduct R U₀ U₁) * q₀₀₁_₁₃ (w₀ ⊗ₜ[R] (1 : U₁)) := by
              rw [← hq₀₀₁]
          _ = q₀₀₁_₁₃ z := (map_mul q₀₀₁_₁₃ _ _).symm
      obtain ⟨w₁, hw₁⟩ := hEq_U₀_U₁ z (by rw [hδ_001 z, hz_eq, sub_self])
      have hw₁_coc : ((1 : U₁) ⊗ₜ[R] w₁ : TensorProduct R U₁ U₁) = g₁₁ * (w₁ ⊗ₜ[R] (1 : U₁)) := by
        apply hInj_q011_23
        calc
          q₀₁₁_₂₃ ((1 : U₁) ⊗ₜ[R] w₁) = q₀₁₁_₁₃ ((1 : U₀) ⊗ₜ[R] w₁) := by
            rw [hq011_23_tmul, hq011_13_tmul]
          _ = q₀₁₁_₁₃ z := by rw [hw₁]
          _ = q₀₁₁_₁₃ (g₀₁ : TensorProduct R U₀ U₁) * q₀₁₁_₁₃ (w₀ ⊗ₜ[R] (1 : U₁)) :=
              map_mul q₀₁₁_₁₃ _ _
          _ = (q₀₁₁_₁₂ (g₀₁ : TensorProduct R U₀ U₁) * q₀₁₁_₂₃ g₁₁) *
              q₀₁₁_₁₂ (w₀ ⊗ₜ[R] (1 : U₁)) := by
            rw [hq₀₁₁, hq011_13_tmul, hq011_12_tmul]
          _ = q₀₁₁_₂₃ g₁₁ * (q₀₁₁_₁₂ (g₀₁ : TensorProduct R U₀ U₁) *
              q₀₁₁_₁₂ (w₀ ⊗ₜ[R] (1 : U₁))) := by ring
          _ = q₀₁₁_₂₃ g₁₁ * q₀₁₁_₁₂ z := by rw [← map_mul q₀₁₁_₁₂]
          _ = q₀₁₁_₂₃ g₁₁ * q₀₁₁_₁₂ ((1 : U₀) ⊗ₜ[R] w₁) := by rw [← hw₁]
          _ = q₀₁₁_₂₃ g₁₁ * q₀₁₁_₂₃ (w₁ ⊗ₜ[R] (1 : U₁)) := by
            rw [hq011_12_tmul, hq011_23_tmul]
          _ = q₀₁₁_₂₃ (g₁₁ * (w₁ ⊗ₜ[R] (1 : U₁))) := (map_mul q₀₁₁_₂₃ _ _).symm
      obtain ⟨m₁, hm₁⟩ := hTw₁.2 w₁ hw₁_coc
      refine ⟨m₁, ?_⟩
      dsimp [R_rel]
      rw [hm₁, hw₁]
    have hR_bwd : ∀ m₁ : M₁, ∃ m₀ : M₀, R_rel m₀ m₁ := by
      intro m₁
      let w₁ : U₁ := σ₁ m₁
      let z_inv : TensorProduct R U₀ U₁ :=
        ((g₀₁⁻¹ : Units (TensorProduct R U₀ U₁)) : TensorProduct R U₀ U₁) * ((1 : U₀) ⊗ₜ[R] w₁)
      have hgz : (g₀₁ : TensorProduct R U₀ U₁) * z_inv = ((1 : U₀) ⊗ₜ[R] w₁) := by
        dsimp [z_inv]
        rw [← mul_assoc, Units.mul_inv, one_mul]
      have hz_inv_eq : q₀₁₁_₁₃ z_inv = q₀₁₁_₁₂ z_inv := by
        have hmul : q₀₁₁_₁₃ (g₀₁ : TensorProduct R U₀ U₁) * q₀₁₁_₁₃ z_inv =
            q₀₁₁_₁₃ (g₀₁ : TensorProduct R U₀ U₁) * q₀₁₁_₁₂ z_inv := by
          calc
            q₀₁₁_₁₃ (g₀₁ : TensorProduct R U₀ U₁) * q₀₁₁_₁₃ z_inv
                = q₀₁₁_₁₃ ((g₀₁ : TensorProduct R U₀ U₁) * z_inv) := (map_mul q₀₁₁_₁₃ _ _).symm
            _ = q₀₁₁_₁₃ ((1 : U₀) ⊗ₜ[R] w₁) := by rw [hgz]
            _ = q₀₁₁_₂₃ ((1 : U₁) ⊗ₜ[R] w₁) := by rw [hq011_13_tmul, hq011_23_tmul]
            _ = q₀₁₁_₂₃ (g₁₁ * (w₁ ⊗ₜ[R] (1 : U₁))) := by rw [hCoc₁ m₁]
            _ = q₀₁₁_₂₃ g₁₁ * q₀₁₁_₂₃ (w₁ ⊗ₜ[R] (1 : U₁)) := map_mul q₀₁₁_₂₃ _ _
            _ = q₀₁₁_₂₃ g₁₁ * q₀₁₁_₁₂ ((1 : U₀) ⊗ₜ[R] w₁) := by
              rw [hq011_23_tmul, hq011_12_tmul]
            _ = q₀₁₁_₂₃ g₁₁ * q₀₁₁_₁₂ ((g₀₁ : TensorProduct R U₀ U₁) * z_inv) := by rw [← hgz]
            _ = q₀₁₁_₂₃ g₁₁ * (q₀₁₁_₁₂ (g₀₁ : TensorProduct R U₀ U₁) * q₀₁₁_₁₂ z_inv) := by
              rw [map_mul q₀₁₁_₁₂]
            _ = (q₀₁₁_₁₂ (g₀₁ : TensorProduct R U₀ U₁) * q₀₁₁_₂₃ g₁₁) * q₀₁₁_₁₂ z_inv := by ring
            _ = q₀₁₁_₁₃ (g₀₁ : TensorProduct R U₀ U₁) * q₀₁₁_₁₂ z_inv := by rw [← hq₀₁₁]
        have hcancel :=
          congrArg (q₀₁₁_₁₃ ((g₀₁⁻¹ : Units (TensorProduct R U₀ U₁)) : TensorProduct R U₀ U₁) * ·) hmul
        have hunit :
            q₀₁₁_₁₃ ((g₀₁⁻¹ : Units (TensorProduct R U₀ U₁)) : TensorProduct R U₀ U₁) *
              q₀₁₁_₁₃ (g₀₁ : TensorProduct R U₀ U₁) = 1 := by
          rw [← map_mul, Units.inv_mul, map_one]
        simpa only [← mul_assoc, hunit, one_mul] using hcancel
      obtain ⟨w₀, hw₀_comm⟩ := hEq_U₁_U₀ (TensorProduct.comm R U₀ U₁ z_inv)
        (by rw [hδ_011 z_inv, hz_inv_eq, sub_self, map_zero])
      have hw₀ : (w₀ ⊗ₜ[R] (1 : U₁) : TensorProduct R U₀ U₁) = z_inv := by
        have := congrArg (TensorProduct.comm R U₀ U₁).symm hw₀_comm
        simpa using this
      have hw₀_rel : ((1 : U₀) ⊗ₜ[R] w₁ : TensorProduct R U₀ U₁) =
          (g₀₁ : TensorProduct R U₀ U₁) * (w₀ ⊗ₜ[R] (1 : U₁)) := by
        rw [hw₀, hgz]
      have hw₀_coc : ((1 : U₀) ⊗ₜ[R] w₀ : TensorProduct R U₀ U₀) = g₀₀ * (w₀ ⊗ₜ[R] (1 : U₀)) := by
        apply hInj_q001_12
        have hmul : q₀₀₁_₂₃ (g₀₁ : TensorProduct R U₀ U₁) * q₀₀₁_₁₂ ((1 : U₀) ⊗ₜ[R] w₀) =
            q₀₀₁_₂₃ (g₀₁ : TensorProduct R U₀ U₁) * q₀₀₁_₁₂ (g₀₀ * (w₀ ⊗ₜ[R] (1 : U₀))) := by
          calc
            q₀₀₁_₂₃ (g₀₁ : TensorProduct R U₀ U₁) * q₀₀₁_₁₂ ((1 : U₀) ⊗ₜ[R] w₀)
                = q₀₀₁_₂₃ (g₀₁ : TensorProduct R U₀ U₁) * q₀₀₁_₂₃ (w₀ ⊗ₜ[R] (1 : U₁)) := by
                    rw [hq001_12_tmul, hq001_23_tmul]
            _ = q₀₀₁_₂₃ ((g₀₁ : TensorProduct R U₀ U₁) * (w₀ ⊗ₜ[R] (1 : U₁))) :=
                (map_mul q₀₀₁_₂₃ _ _).symm
            _ = q₀₀₁_₂₃ ((1 : U₀) ⊗ₜ[R] w₁) := by rw [← hw₀_rel]
            _ = q₀₀₁_₁₃ ((1 : U₀) ⊗ₜ[R] w₁) := by rw [hq001_23_tmul, hq001_13_tmul]
            _ = q₀₀₁_₁₃ ((g₀₁ : TensorProduct R U₀ U₁) * (w₀ ⊗ₜ[R] (1 : U₁))) := by rw [hw₀_rel]
            _ = q₀₀₁_₁₃ (g₀₁ : TensorProduct R U₀ U₁) * q₀₀₁_₁₃ (w₀ ⊗ₜ[R] (1 : U₁)) :=
                map_mul q₀₀₁_₁₃ _ _
            _ = (q₀₀₁_₁₂ g₀₀ * q₀₀₁_₂₃ (g₀₁ : TensorProduct R U₀ U₁)) *
                q₀₀₁_₁₂ (w₀ ⊗ₜ[R] (1 : U₀)) := by
                rw [hq₀₀₁, hq001_13_tmul, hq001_12_tmul]
            _ = q₀₀₁_₂₃ (g₀₁ : TensorProduct R U₀ U₁) *
                (q₀₀₁_₁₂ g₀₀ * q₀₀₁_₁₂ (w₀ ⊗ₜ[R] (1 : U₀))) := by ring
            _ = q₀₀₁_₂₃ (g₀₁ : TensorProduct R U₀ U₁) *
                q₀₀₁_₁₂ (g₀₀ * (w₀ ⊗ₜ[R] (1 : U₀))) := by
                rw [← map_mul q₀₀₁_₁₂]
        have hcancel :=
          congrArg (q₀₀₁_₂₃ ((g₀₁⁻¹ : Units (TensorProduct R U₀ U₁)) : TensorProduct R U₀ U₁) * ·) hmul
        have hunit :
            q₀₀₁_₂₃ ((g₀₁⁻¹ : Units (TensorProduct R U₀ U₁)) : TensorProduct R U₀ U₁) *
              q₀₀₁_₂₃ (g₀₁ : TensorProduct R U₀ U₁) = 1 := by
          rw [← map_mul, Units.inv_mul, map_one]
        simpa only [← mul_assoc, hunit, one_mul] using hcancel
      obtain ⟨m₀, hm₀⟩ := hTw₀.2 w₀ hw₀_coc
      refine ⟨m₀, ?_⟩
      dsimp [R_rel]
      rw [hm₀, ← hw₀_rel]
    let θ_fn : M₀ → M₁ := fun m₀ => Classical.choose (hR_fwd m₀)
    have hθ_spec : ∀ m₀ : M₀, R_rel m₀ (θ_fn m₀) := fun m₀ => Classical.choose_spec (hR_fwd m₀)
    let θ_lin : M₀ →ₗ[R] M₁ :=
      { toFun := θ_fn
        map_add' := fun x y => by
          apply hR_uniq_right (x + y)
          · exact hθ_spec (x + y)
          · dsimp [R_rel]
            rw [map_add, TensorProduct.tmul_add, hθ_spec x, hθ_spec y,
              map_add, TensorProduct.add_tmul, mul_add]
        map_smul' := fun r x => by
          apply hR_uniq_right (r • x)
          · exact hθ_spec (r • x)
          · dsimp [R_rel, RingHom.id_apply]
            rw [map_smul, TensorProduct.tmul_smul, hθ_spec x,
              map_smul, ← TensorProduct.smul_tmul', mul_smul_comm] }
    have hθ_inj : Function.Injective θ_lin := by
      intro x y hxy
      change θ_fn x = θ_fn y at hxy
      have hx_spec : R_rel x (θ_fn y) := hxy ▸ hθ_spec x
      exact hR_uniq_left x y (θ_fn y) hx_spec (hθ_spec y)
    have hθ_surj : Function.Surjective θ_lin := by
      intro m₁
      obtain ⟨m₀, hm₀⟩ := hR_bwd m₁
      exact ⟨m₀, hR_uniq_right m₀ (θ_fn m₀) m₁ (hθ_spec m₀) hm₀⟩
    exact ⟨LinearEquiv.ofBijective θ_lin ⟨hθ_inj, hθ_surj⟩, hθ_spec⟩
  have chart_unit_basis : ∀ (R T L : Type u) [CommRing R] [CommRing T] [Algebra R T]
      [Module.FaithfullyFlat R T] [AddCommGroup L] [Module R L]
      (e : TensorProduct R T L ≃ₗ[T] T) (s : L) (u : Units T),
      e ((1 : T) ⊗ₜ[R] s) = (u : T) →
      ∃ φ : L ≃ₗ[R] R, φ s = 1 ∧ ∀ x : L, φ x • s = x := by
    intro R T L _ _ _ _ _ _ e s u hs
    let α : R →ₗ[R] L := (LinearMap.lsmul R L).flip s
    have hBij : Function.Bijective α := by
      rw [← Module.FaithfullyFlat.lTensor_bijective_iff_bijective R T α]
      let rid_inv : T ≃ₗ[T] TensorProduct R T R :=
        (TensorProduct.AlgebraTensorModule.rid R T T).symm
      have hcomp_eq : (e ∘ LinearMap.lTensor T α ∘ rid_inv) = fun t : T => t * (u : T) := by
        funext t
        have ht : (t ⊗ₜ[R] s : TensorProduct R T L) = t • ((1 : T) ⊗ₜ[R] s) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        simp [Function.comp, rid_inv, α, ht, hs]
