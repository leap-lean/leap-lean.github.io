    let cocone_P := CategoryTheory.Limits.PushoutCocone.mk inl_P inr_P hcomm_P
    have hcolim_P : CategoryTheory.Limits.IsColimit cocone_P := by
      refine CategoryTheory.Limits.PushoutCocone.isColimitAux' _ ?_
      intro sc
      let desc_P : Polynomial A →+* sc.pt :=
        Polynomial.eval₂RingHom sc.inl.hom (sc.inr.hom Polynomial.X)
      refine ⟨CommRingCat.ofHom desc_P, ?_, ?_, ?_⟩
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro a
        change Polynomial.eval₂ sc.inl.hom (sc.inr.hom Polynomial.X) (Polynomial.C a) =
          sc.inl.hom a
        exact Polynomial.eval₂_C _ _
      · apply CommRingCat.hom_ext
        apply Polynomial.ringHom_ext
        · intro c
          change Polynomial.eval₂ sc.inl.hom (sc.inr.hom Polynomial.X)
              ((Polynomial.C c).map (algebraMap k A)) = sc.inr.hom (Polynomial.C c)
          rw [Polynomial.map_C, Polynomial.eval₂_C]
          exact congrArg (fun φ => CommRingCat.Hom.hom φ c) sc.condition
        · change Polynomial.eval₂ sc.inl.hom (sc.inr.hom Polynomial.X)
              (Polynomial.X.map (algebraMap k A)) = sc.inr.hom Polynomial.X
          rw [Polynomial.map_X, Polynomial.eval₂_X]
      · intro m hm_inl hm_inr
        apply CommRingCat.hom_ext
        apply Polynomial.ringHom_ext
        · intro a
          have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ a) hm_inl
          change m.hom (Polynomial.C a) = sc.inl.hom a at h1
          change m.hom (Polynomial.C a) =
            Polynomial.eval₂ sc.inl.hom (sc.inr.hom Polynomial.X) (Polynomial.C a)
          rw [h1, Polynomial.eval₂_C]
        · have h2 := congrArg (fun φ => CommRingCat.Hom.hom φ Polynomial.X) hm_inr
          change m.hom (Polynomial.X.map (algebraMap k A)) = sc.inr.hom Polynomial.X at h2
          rw [Polynomial.map_X] at h2
          change m.hom Polynomial.X =
            Polynomial.eval₂ sc.inl.hom (sc.inr.hom Polynomial.X) Polynomial.X
          rw [h2, Polynomial.eval₂_X]
    have hPB_Poly : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map inl_P)
        (AlgebraicGeometry.Spec.map inr_P)
        s_A (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k)))) :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
        (CategoryTheory.IsPushout.of_isColimit hcolim_P)
    have hD_pP : D.ι ≫ p_P =
        α.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k))) := by
      rw [← hα_base, ← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
        CategoryTheory.Category.id_comp]
    have hPB_W0 : CategoryTheory.IsPullback (W.ι ≫ p₁) (p₂ ∣_ D) s_A (D.ι ≫ p_P) :=
      ((AlgebraicGeometry.isPullback_morphismRestrict p₂ D).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback s_A p_P).flip).flip
    have hPB_W : CategoryTheory.IsPullback
        (W.ι ≫ p₁) ((p₂ ∣_ D) ≫ α.hom)
        s_A (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k)))) :=
