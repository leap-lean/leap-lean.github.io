          refine ⟨AlgebraicGeometry.Spec (CommRingCat.of B_A), g_left, hg_et, y_x, hy_x, ?_⟩
          intro hV V_et g_et
          have _ : AlgebraicGeometry.Etale W_et.hom := W_et.prop
          let B_Z_et : Z.Etale :=
