    dsimp only [κ_cat, ρ₀_cat]
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc p₀.appTop,
      ← AlgebraicGeometry.Scheme.Hom.comp_appTop, hj₀_p₀,
      AlgebraicGeometry.Scheme.ΓSpecIso_naturality,
