          have hcomp : algebraMap A B_near = (Ideal.Quotient.mk I_near).comp c_A := rfl
          rw [hcomp, ← Ideal.map_map]
          exact Ideal.mem_map_of_mem _ hdiff_ker
        have hgr0 : Ideal.Quotient.mk I_near (g * r) = 0 :=
