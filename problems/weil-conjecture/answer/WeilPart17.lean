      P₁.left.basicOpen s₀ = D₀ ⊓ D₁ ∧
      P₁.left.basicOpen s₁ = D₀ ⊓ D₁ ∧
      ((CommRingCat.Hom.hom (P₁.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op)) s₀) *
        ((CommRingCat.Hom.hom (P₁.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op)) s₁) = 1 := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let pProj : AlgebraicGeometry.Proj 𝒜 ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))
    let T : Fin 2 → MvPolynomial (Fin 2) k := MvPolynomial.X
    have hT_mem : ∀ i : Fin 2, T i ∈ 𝒜 1 := by
      intro i
      rw [MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_X k i
    let D : Fin 2 → (AlgebraicGeometry.Proj 𝒜).Opens :=
      fun i => AlgebraicGeometry.Proj.basicOpen 𝒜 (T i)
    have hadj : Algebra.adjoin ↥(𝒜 0) (Set.range T) = ⊤ := by
      rw [eq_top_iff]
      rintro F -
      induction F using MvPolynomial.induction_on with
      | C c =>
        have hc0 : MvPolynomial.C c ∈ 𝒜 0 := by
          rw [MvPolynomial.mem_homogeneousSubmodule]
          exact MvPolynomial.isHomogeneous_C (Fin 2) c
        exact Subalgebra.algebraMap_mem (Algebra.adjoin ↥(𝒜 0) (Set.range T))
          (⟨MvPolynomial.C c, hc0⟩ : ↥(𝒜 0))
      | add p q hp hq => exact add_mem hp hq
      | mul_X p i hp => exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)
    have hiSup : (⨆ i : Fin 2, D i) = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 T (fun i => ⟨1, hT_mem i⟩) hadj
    have hD_cov : D 0 ⊔ D 1 = ⊤ := by
      apply le_antisymm le_top
      rw [← hiSup, iSup_le_iff]
      intro i
      fin_cases i
      · exact le_sup_left
      · exact le_sup_right
    
    have hChart : ∀ (i j : Fin 2), i ≠ j →
        ∃ (e_i : Polynomial k ≃+* HomogeneousLocalization.Away 𝒜 (T i))
          (α_i : (D i : AlgebraicGeometry.Scheme.{u}) ≅
            AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
          (s_i : ↑((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (D i)))),
          e_i Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem (hT_mem i) (hT_mem j) ∧
          α_i.inv ≫ (D i).ι =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_i.symm.toRingHom) ≫
              AlgebraicGeometry.Proj.awayι 𝒜 (T i) (hT_mem i) zero_lt_one ∧
          α_i.inv ≫ (D i).ι ≫ pProj =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k))) ∧
          (CommRingCat.Hom.hom
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
              α_i.hom.appTop ≫ (D i).topIso.hom)) Polynomial.X = s_i ∧
          (AlgebraicGeometry.Proj 𝒜).basicOpen s_i = D i ⊓ D j := by
      intro i j hij
      let R_i := HomogeneousLocalization.Away 𝒜 (T i)
      let S_i := Submonoid.powers (T i)
      let σ_i : k →+* R_i :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 S_i).comp (algebraMap k ↥(𝒜 0))
      let t_ij : R_i := HomogeneousLocalization.Away.isLocalizationElem (hT_mem i) (hT_mem j)
      have ht_val : t_ij.val = Localization.mk (T j) ⟨T i, Submonoid.mem_powers (T i)⟩ := by
        dsimp [t_ij, HomogeneousLocalization.Away.isLocalizationElem]
        congr 1
        · exact pow_one _
        · exact Subtype.ext (pow_one _)
      
      have hex_e : ∃ e_i : Polynomial k ≃+* R_i,
          e_i Polynomial.X = t_ij ∧
          e_i.symm t_ij = Polynomial.X ∧
          e_i.symm.toRingHom.comp σ_i = algebraMap k (Polynomial k) := by
        let φ_i : Polynomial k →+* R_i := Polynomial.eval₂RingHom σ_i t_ij
        let ev_ij : MvPolynomial (Fin 2) k →+* Polynomial k :=
          MvPolynomial.eval₂Hom Polynomial.C (fun m : Fin 2 => if m = i then 1 else Polynomial.X)
        have hev_Ti : ev_ij (T i) = 1 := by
          dsimp [ev_ij, T]
          rw [MvPolynomial.eval₂_X]
          simp
        have hev_Tj : ev_ij (T j) = Polynomial.X := by
          dsimp [ev_ij, T]
          rw [MvPolynomial.eval₂_X]
          simp [hij.symm]
        have hev_pow : ∀ y : S_i, ev_ij y.1 = 1 := by
          rintro ⟨_, n, rfl⟩
          rw [map_pow, hev_Ti, one_pow]
        have hg_unit : ∀ y : S_i, IsUnit (ev_ij y.1) := by
          intro y
          rw [hev_pow y]
          exact isUnit_one
        let lift_ij : Localization S_i →+* Polynomial k := IsLocalization.lift hg_unit
        have hlift_mk : ∀ (F : MvPolynomial (Fin 2) k) (y : S_i),
            lift_ij (Localization.mk F y) = ev_ij F := by
          intro F y
          rw [Localization.mk_eq_mk'_apply, IsLocalization.lift_mk'_spec]
          rw [hev_pow y, one_mul]
        let ψ_i : R_i →+* Polynomial k := lift_ij.comp (algebraMap R_i (Localization S_i))
        have hψ_val : ∀ z : R_i, ψ_i z = lift_ij z.val := by
          intro z
          change lift_ij (algebraMap R_i (Localization S_i) z) = lift_ij z.val
          rw [HomogeneousLocalization.algebraMap_apply]
        have hσ_val : ∀ c : k, (σ_i c).val =
            Localization.mk (MvPolynomial.C c) (1 : S_i) := by
          intro c
          have h1 : (σ_i c).val =
              algebraMap (MvPolynomial (Fin 2) k) (Localization S_i)
                (algebraMap k ↥(𝒜 0) c).1 := by
            change algebraMap R_i (Localization S_i)
                (algebraMap ↥(𝒜 0) R_i (algebraMap k ↥(𝒜 0) c)) = _
            rw [← IsScalarTower.algebraMap_apply]
            rfl
          rw [h1]
          rfl
        have hleft_inv : ∀ p : Polynomial k, ψ_i (φ_i p) = p := by
          have hcomp : ψ_i.comp φ_i = RingHom.id (Polynomial k) := by
            apply Polynomial.ringHom_ext
            · intro c
              change ψ_i (Polynomial.eval₂ σ_i t_ij (Polynomial.C c)) = Polynomial.C c
              rw [Polynomial.eval₂_C, hψ_val, hσ_val, hlift_mk]
              exact MvPolynomial.eval₂Hom_C _ _ c
            · change ψ_i (Polynomial.eval₂ σ_i t_ij Polynomial.X) = Polynomial.X
              rw [Polynomial.eval₂_X, hψ_val, ht_val, hlift_mk, hev_Tj]
          intro p
          exact congrArg (fun f => f p) hcomp
        have hright_inv : ∀ z : R_i, φ_i (ψ_i z) = z := by
          intro z
          apply HomogeneousLocalization.val_injective S_i
          refine Quotient.inductionOn' z (fun nd => ?_)
          change (φ_i (ψ_i (HomogeneousLocalization.mk nd))).val =
            (HomogeneousLocalization.mk nd).val
          rcases nd with ⟨d, ⟨F, hF_mem⟩, ⟨den, hden_mem_sub⟩, hden_mem⟩
          have hF : F.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule d F).mp hF_mem
          have hden_hom : den.IsHomogeneous d :=
            (MvPolynomial.mem_homogeneousSubmodule d den).mp hden_mem_sub
          have hden_ex : ∃ m : ℕ, T i ^ m = den := hden_mem
          obtain ⟨m, hm_eq⟩ := hden_ex
          have hm_d : m = d := by
            have hTi_ne : T i ^ m ≠ 0 := pow_ne_zero m (MvPolynomial.X_ne_zero i)
            have hTi_hom : (T i ^ m).IsHomogeneous m := MvPolynomial.isHomogeneous_X_pow i m
            rw [hm_eq] at hTi_ne hTi_hom
            exact MvPolynomial.IsHomogeneous.inj_right hTi_hom hden_hom hTi_ne
          subst hm_d
          have hpow_m : T i ^ m ∈ S_i := pow_mem (Submonoid.mem_powers (T i)) m
          have hmk_val : (HomogeneousLocalization.mk
              ⟨m, ⟨F, hF_mem⟩, ⟨den, hden_mem_sub⟩, hden_mem⟩).val =
              Localization.mk F ⟨T i ^ m, hpow_m⟩ := by
            rw [HomogeneousLocalization.val_mk]
            congr 1
            exact Subtype.ext hm_eq.symm
          rw [hψ_val, hmk_val, hlift_mk]
          have hmon_decomp : ∀ s : Fin 2 →₀ ℕ, ∀ c : k,
              MvPolynomial.monomial s c = MvPolynomial.C c * T i ^ s i * T j ^ s j := by
            intro s c
            rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
              Fin.prod_univ_two]
            dsimp [T]
            fin_cases i <;> fin_cases j
            · exact False.elim (hij rfl)
            · change MvPolynomial.C c * (MvPolynomial.X 0 ^ s 0 * MvPolynomial.X 1 ^ s 1) =
                MvPolynomial.C c * MvPolynomial.X 0 ^ s 0 * MvPolynomial.X 1 ^ s 1
              ring
            · change MvPolynomial.C c * (MvPolynomial.X 0 ^ s 0 * MvPolynomial.X 1 ^ s 1) =
                MvPolynomial.C c * MvPolynomial.X 1 ^ s 1 * MvPolynomial.X 0 ^ s 0
              ring
            · exact False.elim (hij rfl)
          have hval_hom : ∀ y : R_i, y.val = algebraMap R_i (Localization S_i) y :=
            fun y => (HomogeneousLocalization.algebraMap_apply y).symm
          rw [hval_hom, MvPolynomial.as_sum F, map_sum, map_sum, map_sum]
          have hsum_mk : ∀ (S_fin : Finset (Fin 2 →₀ ℕ))
              (g : (Fin 2 →₀ ℕ) → MvPolynomial (Fin 2) k),
              (∑ s ∈ S_fin, Localization.mk (g s) ⟨T i ^ m, hpow_m⟩) =
                Localization.mk (∑ s ∈ S_fin, g s) ⟨T i ^ m, hpow_m⟩ := by
            intro S_fin g
            induction S_fin using Finset.induction_on with
            | empty =>
              simp [Localization.mk_zero]
            | insert a S' ha ih =>
              rw [Finset.sum_insert ha, Finset.sum_insert ha, ih, Localization.add_mk_self]
          rw [← hsum_mk]
          apply Finset.sum_congr rfl
          intro s hs
          have hc_ne : F.coeff s ≠ 0 := MvPolynomial.mem_support_iff.mp hs
          have hdeg_s : s i + s j = m := by
            have hmon_ne : MvPolynomial.monomial s (F.coeff s) ≠ 0 :=
              MvPolynomial.monomial_eq_zero.not.mpr hc_ne
            have hmon_hom1 : (MvPolynomial.monomial s (F.coeff s)).IsHomogeneous m :=
              MvPolynomial.isWeightedHomogeneous_monomial 1 s (F.coeff s) (hF hc_ne)
            have hmon_hom2 : (MvPolynomial.monomial s (F.coeff s)).IsHomogeneous
                (s i + s j) := by
              rw [hmon_decomp]
              have h0i : (MvPolynomial.C (F.coeff s) * T i ^ s i).IsHomogeneous
                  (0 + s i) :=
                (MvPolynomial.isHomogeneous_C (Fin 2) _).mul
                  (MvPolynomial.isHomogeneous_X_pow i (s i))
              rw [zero_add] at h0i
              exact h0i.mul (MvPolynomial.isHomogeneous_X_pow j (s j))
            exact MvPolynomial.IsHomogeneous.inj_right hmon_hom2 hmon_hom1 hmon_ne
          have hev_mon : ev_ij (MvPolynomial.monomial s (F.coeff s)) =
              Polynomial.C (F.coeff s) * Polynomial.X ^ s j := by
            rw [hmon_decomp s (F.coeff s), map_mul, map_mul, map_pow, map_pow,
              hev_Ti, hev_Tj, one_pow, mul_one]
            congr 1
            exact MvPolynomial.eval₂Hom_C _ _ (F.coeff s)
          rw [hev_mon, hmon_decomp s (F.coeff s)]
          have hφ_mon : φ_i (Polynomial.C (F.coeff s) * Polynomial.X ^ s j) =
              σ_i (F.coeff s) * t_ij ^ s j := by
            rw [map_mul, map_pow]
            congr 1
            · exact Polynomial.eval₂_C _ _
            · congr 1
              exact Polynomial.eval₂_X _ _
          rw [hφ_mon, map_mul, map_pow, ← hval_hom, ← hval_hom, hσ_val, ht_val]
          have hpow_mk : ∀ n : ℕ,
              (Localization.mk (T j) (⟨T i, Submonoid.mem_powers (T i)⟩ : S_i)) ^ n =
                Localization.mk (T j ^ n) ⟨T i ^ n, pow_mem (Submonoid.mem_powers (T i)) n⟩ := by
            intro n
            induction n with
            | zero =>
              rw [pow_zero, ← Localization.mk_one]
              congr 1
            | succ n ih =>
              rw [pow_succ, ih, Localization.mk_mul]
              congr 1
          rw [hpow_mk (s j), Localization.mk_mul, one_mul]
          rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
          refine ⟨1, ?_⟩
          simp only [Submonoid.coe_one, one_mul]
          rw [← hdeg_s, pow_add]
          ring
        let e_i : Polynomial k ≃+* R_i :=
          { φ_i with
            invFun := ψ_i
            left_inv := hleft_inv
            right_inv := hright_inv }
        have he_X : e_i Polynomial.X = t_ij := Polynomial.eval₂_X _ _
        have he_symm_t : e_i.symm t_ij = Polynomial.X := by
          rw [← he_X, RingEquiv.symm_apply_apply]
        have he_symm_comm : e_i.symm.toRingHom.comp σ_i = algebraMap k (Polynomial k) := by
          apply RingHom.ext
          intro c
          have hc : e_i (algebraMap k (Polynomial k) c) = σ_i c := Polynomial.eval₂_C _ _
          change e_i.symm (σ_i c) = algebraMap k (Polynomial k) c
          rw [← hc, RingEquiv.symm_apply_apply]
        exact ⟨e_i, he_X, he_symm_t, he_symm_comm⟩

      obtain ⟨e_i, he_X, he_symm_t, he_symm_comm⟩ := hex_e
      let ι_i := AlgebraicGeometry.Proj.awayι 𝒜 (T i) (hT_mem i) zero_lt_one
      
      have hex_α : ∃ α_i : (D i : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)),
          α_i.inv ≫ (D i).ι =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_i.symm.toRingHom) ≫ ι_i := by
        have hrange_i : Set.range (D i).ι.base = Set.range ι_i.base := by
          have h1 : (D i).ι.opensRange = D i := AlgebraicGeometry.Scheme.Opens.opensRange_ι (D i)
          have h2 : ι_i.opensRange = D i :=
            AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (T i) (hT_mem i) zero_lt_one
          exact congrArg SetLike.coe (h1.trans h2.symm)
        let η_i : (D i : AlgebraicGeometry.Scheme.{u}) ≅
            AlgebraicGeometry.Spec (CommRingCat.of R_i) :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (D i).ι ι_i hrange_i
        have hη_inv : η_i.inv ≫ (D i).ι = ι_i :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac (D i).ι ι_i hrange_i
        let spec_e_i : AlgebraicGeometry.Spec (CommRingCat.of R_i) ≅
            AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
          { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_i.toRingHom)
            inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_i.symm.toRingHom)
            hom_inv_id := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
              have hid : e_i.toRingHom.comp e_i.symm.toRingHom = RingHom.id R_i := by
                apply RingHom.ext
                intro x
                exact e_i.apply_symm_apply x
              rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
            inv_hom_id := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
              have hid : e_i.symm.toRingHom.comp e_i.toRingHom = RingHom.id (Polynomial k) := by
                apply RingHom.ext
                intro x
                exact e_i.symm_apply_apply x
              rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
        refine ⟨η_i ≪≫ spec_e_i, ?_⟩
        dsimp [spec_e_i]
        rw [CategoryTheory.Category.assoc, hη_inv]
      obtain ⟨α_i, hα_inv_ι⟩ := hex_α

      have hα_base : α_i.inv ≫ (D i).ι ≫ pProj =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k))) := by
        rw [← CategoryTheory.Category.assoc, hα_inv_ι]
        dsimp [pProj]
        rw [CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.awayι_toSpecZero_assoc 𝒜 (T i) (hT_mem i) zero_lt_one,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        exact congrArg AlgebraicGeometry.Spec.map (congrArg CommRingCat.ofHom he_symm_comm)
      let s_i : ↑((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (D i))) :=
        (CommRingCat.Hom.hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
            α_i.hom.appTop ≫ (D i).topIso.hom)) Polynomial.X

      
      let φ_sch := α_i.inv ≫ (D i).ι
      have hpre_Di : (TopologicalSpace.Opens.map φ_sch.base).obj (D i) = ⊤ := by
        ext p
        exact iff_of_true (show φ_sch.base p ∈ D i from (α_i.inv.base p).2) trivial
      have hle_φ_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))).Opens) ≤
          (TopologicalSpace.Opens.map φ_sch.base).obj (D i) := hpre_Di.ge
      have hle_ι_Di : (⊤ : (D i : AlgebraicGeometry.Scheme.{u}).Opens) ≤
          (TopologicalSpace.Opens.map (D i).ι.base).obj (D i) := by
        intro ⟨x, hx⟩ _
        exact hx
      have hle_α_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))).Opens) ≤
          (TopologicalSpace.Opens.map α_i.inv.base).obj ⊤ := by
        intro _ _; trivial
      have hφ_appLE_s : (CommRingCat.Hom.hom (φ_sch.appLE (D i) ⊤ hle_φ_top)) s_i =
          (CommRingCat.Hom.hom
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv)
            Polynomial.X := by
        have hcomp_appLE : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
            α_i.hom.appTop ≫ (D i).topIso.hom) ≫ φ_sch.appLE (D i) ⊤ hle_φ_top =
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv := by
          dsimp [φ_sch]
          have h_split : (α_i.inv ≫ (D i).ι).appLE (D i) ⊤ hle_φ_top =
              (D i).ι.appLE (D i) ⊤ hle_ι_Di ≫ α_i.inv.appLE ⊤ ⊤ hle_α_top :=
            (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE α_i.inv (D i).ι (D i) ⊤ ⊤
              hle_ι_Di hle_α_top).symm
          have h_hom_inv : α_i.hom.appTop ≫ α_i.inv.appLE ⊤ ⊤ hle_α_top = 𝟙 _ := by
            rw [happLE_top_eq_appTop α_i.inv hle_α_top,
              ← AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Iso.inv_hom_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop]
          rw [h_split, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc (D i).topIso.hom, hTopIso_ι_appLE,
            CategoryTheory.Category.id_comp, h_hom_inv, CategoryTheory.Category.comp_id]
        exact congrArg (fun ψ => CommRingCat.Hom.hom ψ Polynomial.X) hcomp_appLE
      have hpre_s : (TopologicalSpace.Opens.map φ_sch.base).obj
          ((AlgebraicGeometry.Proj 𝒜).basicOpen s_i) =
          PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) := by
        rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen]
        have happ_res : φ_sch.app (D i) =
            φ_sch.appLE (D i) ⊤ hle_φ_top ≫
              (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))).presheaf.map
                (CategoryTheory.homOfLE (le_top :
                  (TopologicalSpace.Opens.map φ_sch.base).obj (D i) ≤ ⊤)).op := by
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
          have hmap_assoc := AlgebraicGeometry.Scheme.Hom.appLE_map_assoc φ_sch hle_φ_top
            (CategoryTheory.homOfLE (le_top :
              (TopologicalSpace.Opens.map φ_sch.base).obj (D i) ≤ ⊤)).op (𝟙 _)
          rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.comp_id] at hmap_assoc
          exact hmap_assoc.symm
        change (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))).basicOpen
            ((CommRingCat.Hom.hom (φ_sch.app (D i))) s_i) = _
        rw [happ_res]
        change (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))).basicOpen
            ((CommRingCat.Hom.hom
              ((AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))).presheaf.map
                (CategoryTheory.homOfLE le_top).op))
              ((CommRingCat.Hom.hom (φ_sch.appLE (D i) ⊤ hle_φ_top)) s_i)) = _
        rw [AlgebraicGeometry.Scheme.basicOpen_res, hpre_Di, top_inf_eq, hφ_appLE_s,
          AlgebraicGeometry.basicOpen_eq_of_affine]
      have hpre_Dj : (TopologicalSpace.Opens.map φ_sch.base).obj (D j) =
          PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) := by
        have h0 : (TopologicalSpace.Opens.map φ_sch.base).obj (D j) =
            (TopologicalSpace.Opens.map
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_i.symm.toRingHom)).base).obj
              ((TopologicalSpace.Opens.map ι_i.base).obj (D j)) := by
          change (TopologicalSpace.Opens.map (α_i.inv ≫ (D i).ι).base).obj (D j) = _
          rw [hα_inv_ι]
          rfl
        have hpre1 : (TopologicalSpace.Opens.map ι_i.base).obj (D j) =
            PrimeSpectrum.basicOpen t_ij :=
          AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hT_mem i) zero_lt_one
            (hT_mem j) zero_lt_one
        have hpre2 : (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_i.symm.toRingHom)).base).obj
              (PrimeSpectrum.basicOpen t_ij) =
            PrimeSpectrum.basicOpen (e_i.symm t_ij) :=
          AlgebraicGeometry.SpecMap_preimage_basicOpen (CommRingCat.ofHom e_i.symm.toRingHom) t_ij
        exact (h0.trans (congrArg _ hpre1)).trans
          (hpre2.trans (congrArg PrimeSpectrum.basicOpen he_symm_t))
      have hrange_φ : Set.range φ_sch.base = (D i : Set (AlgebraicGeometry.Proj 𝒜)) := by
        ext x
        constructor
        · rintro ⟨p, rfl⟩
          exact (α_i.inv.base p).2
        · intro hx
          refine ⟨α_i.hom.base ⟨x, hx⟩, ?_⟩
          have hid : (α_i.hom ≫ α_i.inv).base ⟨x, hx⟩ = ⟨x, hx⟩ := by
            rw [CategoryTheory.Iso.hom_inv_id]
            rfl
          change (D i).ι.base ((α_i.hom ≫ α_i.inv).base ⟨x, hx⟩) = x
          rw [hid]
          rfl
      have hbo_eq : (AlgebraicGeometry.Proj 𝒜).basicOpen s_i = D i ⊓ D j := by
        have hpre_inf : (TopologicalSpace.Opens.map φ_sch.base).obj (D i ⊓ D j) =
            (TopologicalSpace.Opens.map φ_sch.base).obj
              ((AlgebraicGeometry.Proj 𝒜).basicOpen s_i) := by
          change (TopologicalSpace.Opens.map φ_sch.base).obj (D i) ⊓
              (TopologicalSpace.Opens.map φ_sch.base).obj (D j) = _
          rw [hpre_Di, top_inf_eq, hpre_Dj, hpre_s]
        have hsub1 : (((AlgebraicGeometry.Proj 𝒜).basicOpen s_i : (AlgebraicGeometry.Proj 𝒜).Opens) :
            Set (AlgebraicGeometry.Proj 𝒜)) ⊆ Set.range φ_sch.base := by
          rw [hrange_φ]
          exact (AlgebraicGeometry.Proj 𝒜).basicOpen_le s_i
        have hsub2 : ((D i ⊓ D j : (AlgebraicGeometry.Proj 𝒜).Opens) :
            Set (AlgebraicGeometry.Proj 𝒜)) ⊆ Set.range φ_sch.base := by
          rw [hrange_φ]
          exact inf_le_left
        ext x
        have himg : φ_sch.base '' (φ_sch.base ⁻¹'
            (((AlgebraicGeometry.Proj 𝒜).basicOpen s_i : (AlgebraicGeometry.Proj 𝒜).Opens) : Set _)) =
            φ_sch.base '' (φ_sch.base ⁻¹'
              ((D i ⊓ D j : (AlgebraicGeometry.Proj 𝒜).Opens) : Set _)) := by
          congr 1
          exact congrArg SetLike.coe hpre_inf.symm
        rw [Set.image_preimage_eq_of_subset hsub1, Set.image_preimage_eq_of_subset hsub2] at himg
        exact Set.ext_iff.mp himg x
      exact ⟨e_i, α_i, s_i, he_X, hα_inv_ι, hα_base, rfl, hbo_eq⟩

    obtain ⟨e₀, α₀, s₀, he₀_X, hα₀_inv_ι, hα₀_base, hs₀, hbo_s₀⟩ :=
      hChart 0 1 (by decide)
    obtain ⟨e₁, α₁, s₁, he₁_X, hα₁_inv_ι, hα₁_base, hs₁, hbo_s₁'⟩ :=
      hChart 1 0 (by decide)
    have hbo_s₁ : (AlgebraicGeometry.Proj 𝒜).basicOpen s₁ = D 0 ⊓ D 1 := by
      rw [hbo_s₁', inf_comm]

    
    have hT01_mem : T 0 * T 1 ∈ 𝒜 2 := by
      change T 0 * T 1 ∈ 𝒜 (1 + 1)
      exact SetLike.mul_mem_graded (hT_mem 0) (hT_mem 1)
    let R₀₁ := HomogeneousLocalization.Away 𝒜 (T 0 * T 1)
    let ι₀₁ := AlgebraicGeometry.Proj.awayι 𝒜 (T 0 * T 1) hT01_mem zero_lt_two
    have hD01_eq : AlgebraicGeometry.Proj.basicOpen 𝒜 (T 0 * T 1) = D 0 ⊓ D 1 :=
      ProjectiveSpectrum.basicOpen_mul 𝒜 (T 0) (T 1)
    have hrange_01 : Set.range (D 0 ⊓ D 1).ι.base = Set.range ι₀₁.base := by
      have h1 : (D 0 ⊓ D 1).ι.opensRange = D 0 ⊓ D 1 :=
        AlgebraicGeometry.Scheme.Opens.opensRange_ι (D 0 ⊓ D 1)
      have h2 : ι₀₁.opensRange = D 0 ⊓ D 1 :=
        (AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (T 0 * T 1) hT01_mem zero_lt_two).trans hD01_eq
      exact congrArg SetLike.coe (h1.trans h2.symm)
    have hle_01_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of R₀₁)).Opens) ≤
        (TopologicalSpace.Opens.map ι₀₁.base).obj (D 0 ⊓ D 1) := by
      intro p _
      have hmem : ι₀₁.base p ∈ Set.range ι₀₁.base := ⟨p, rfl⟩
      rw [← hrange_01] at hmem
      rcases hmem with ⟨q, hq⟩
      change ι₀₁.base p ∈ D 0 ⊓ D 1
      rw [← hq]
      exact q.2
    let θ₀₁ : (AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (D 0 ⊓ D 1)) ⟶
        CommRingCat.of R₀₁ :=
      ι₀₁.appLE (D 0 ⊓ D 1) ⊤ hle_01_top ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀₁)).hom
    have hθ₀₁_inj : Function.Injective (CommRingCat.Hom.hom θ₀₁) := by
      let η₀₁ : ((D 0 ⊓ D 1 : (AlgebraicGeometry.Proj 𝒜).Opens) : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of R₀₁) :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (D 0 ⊓ D 1).ι ι₀₁ hrange_01
      have hη₀₁_inv : η₀₁.inv ≫ (D 0 ⊓ D 1).ι = ι₀₁ :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac (D 0 ⊓ D 1).ι ι₀₁ hrange_01
      have hle_ι01 : (⊤ : ((D 0 ⊓ D 1 : (AlgebraicGeometry.Proj 𝒜).Opens) :
          AlgebraicGeometry.Scheme.{u}).Opens) ≤
          (TopologicalSpace.Opens.map (D 0 ⊓ D 1).ι.base).obj (D 0 ⊓ D 1) := by
        intro ⟨x, hx⟩ _
        exact hx
      have hle_η01 : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of R₀₁)).Opens) ≤
          (TopologicalSpace.Opens.map η₀₁.inv.base).obj ⊤ := by
        intro _ _; trivial
      have hι₀₁_appLE : ι₀₁.appLE (D 0 ⊓ D 1) ⊤ hle_01_top =
          (D 0 ⊓ D 1).topIso.inv ≫ η₀₁.inv.appTop := by
        have hfac : (D 0 ⊓ D 1).ι.appLE (D 0 ⊓ D 1) ⊤ hle_ι01 ≫ η₀₁.inv.appLE ⊤ ⊤ hle_η01 =
            (η₀₁.inv ≫ (D 0 ⊓ D 1).ι).appLE (D 0 ⊓ D 1) ⊤ (by
              rw [hη₀₁_inv]; exact hle_01_top) :=
          AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE η₀₁.inv (D 0 ⊓ D 1).ι (D 0 ⊓ D 1) ⊤ ⊤
            hle_ι01 hle_η01
        have hcongr : (η₀₁.inv ≫ (D 0 ⊓ D 1).ι).appLE (D 0 ⊓ D 1) ⊤
            (by rw [hη₀₁_inv]; exact hle_01_top) =
            ι₀₁.appLE (D 0 ⊓ D 1) ⊤ hle_01_top := by
          congr 1
        rw [← hcongr, ← hfac, hι_appLE_eq_topIso_inv, happLE_top_eq_appTop η₀₁.inv hle_η01]
      let η_top_iso : ((D 0 ⊓ D 1 : (AlgebraicGeometry.Proj 𝒜).Opens) :
          AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤) ≅
          (AlgebraicGeometry.Spec (CommRingCat.of R₀₁)).presheaf.obj (Opposite.op ⊤) :=
        { hom := η₀₁.inv.appTop
          inv := η₀₁.hom.appTop
          hom_inv_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Iso.hom_inv_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Iso.inv_hom_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop] }
      let full_iso := (D 0 ⊓ D 1).topIso.symm ≪≫ η_top_iso ≪≫
        AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀₁)
      have hθ_eq_iso : θ₀₁ = full_iso.hom := by
        dsimp [θ₀₁, full_iso, η_top_iso]
        rw [hι₀₁_appLE, CategoryTheory.Category.assoc]
      rw [hθ_eq_iso]
      exact full_iso.commRingCatIsoToRingEquiv.injective

    have hθ_chart : ∀ (i j : Fin 2)
        (hle : D 0 ⊓ D 1 ≤ D i)
        (e_i : Polynomial k ≃+* HomogeneousLocalization.Away 𝒜 (T i))
        (α_i : (D i : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
        (s_i : ↑((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (D i))))
        (hx : T 0 * T 1 = T i * T j),
        e_i Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem (hT_mem i) (hT_mem j) →
        α_i.inv ≫ (D i).ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_i.symm.toRingHom) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 (T i) (hT_mem i) zero_lt_one →
        (CommRingCat.Hom.hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
            α_i.hom.appTop ≫ (D i).topIso.hom)) Polynomial.X = s_i →
        (CommRingCat.Hom.hom θ₀₁)
          ((CommRingCat.Hom.hom ((AlgebraicGeometry.Proj 𝒜).presheaf.map
            (CategoryTheory.homOfLE hle).op)) s_i) =
          HomogeneousLocalization.awayMap 𝒜 (hT_mem j) hx
            (HomogeneousLocalization.Away.isLocalizationElem (hT_mem i) (hT_mem j)) := by
      intro i j hle e_i α_i s_i hx he_X hα_inv hs_i
      let g_hom : Polynomial k →+* R₀₁ :=
        (HomogeneousLocalization.awayMap 𝒜 (hT_mem j) hx).comp e_i.toRingHom
      have hι₀₁_fac : ι₀₁ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_hom) ≫ α_i.inv ≫ (D i).ι := by
        have hg_split : AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_hom) =
            AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜 (hT_mem j) hx)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_i.toRingHom) := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have he_cancel : AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_i.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_i.symm.toRingHom) = 𝟙 _ := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid' : e_i.toRingHom.comp e_i.symm.toRingHom =
              RingHom.id (HomogeneousLocalization.Away 𝒜 (T i)) := by
            apply RingHom.ext
            intro z
            exact e_i.apply_symm_apply z
          rw [hid', CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        calc ι₀₁
            = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜 (hT_mem j) hx)) ≫
                AlgebraicGeometry.Proj.awayι 𝒜 (T i) (hT_mem i) zero_lt_one :=
              (AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hT_mem i) zero_lt_one
                (hT_mem j) hx).symm
          _ = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜 (hT_mem j) hx)) ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_i.toRingHom) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_i.symm.toRingHom)) ≫
                AlgebraicGeometry.Proj.awayι 𝒜 (T i) (hT_mem i) zero_lt_one := by
              rw [he_cancel, CategoryTheory.Category.id_comp]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_hom) ≫ α_i.inv ≫ (D i).ι := by
              rw [hα_inv, hg_split]
              simp only [CategoryTheory.Category.assoc]
      have hle_Di_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of R₀₁)).Opens) ≤
          (TopologicalSpace.Opens.map ι₀₁.base).obj (D i) :=
        hle_01_top.trans ((TopologicalSpace.Opens.map ι₀₁.base).monotone hle)
      have hle_ι_Di : (⊤ : (D i : AlgebraicGeometry.Scheme.{u}).Opens) ≤
          (TopologicalSpace.Opens.map (D i).ι.base).obj (D i) := by
        intro ⟨x, hx'⟩ _
        exact hx'
      have hle_α_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))).Opens) ≤
          (TopologicalSpace.Opens.map α_i.inv.base).obj ⊤ := by
        intro _ _; trivial
      have hle_g_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of R₀₁)).Opens) ≤
          (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_hom)).base).obj ⊤ := by
        intro _ _; trivial
      have hle_mid : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))).Opens) ≤
          (TopologicalSpace.Opens.map (α_i.inv ≫ (D i).ι).base).obj (D i) := by
        intro p _
        exact (α_i.inv.base p).2
      have hι₀₁_Di_split : ι₀₁.appLE (D i) ⊤ hle_Di_top =
          (D i).topIso.inv ≫ α_i.inv.appTop ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_hom)).appTop := by
        have hfac1 : (D i).ι.appLE (D i) ⊤ hle_ι_Di ≫ α_i.inv.appLE ⊤ ⊤ hle_α_top =
            (α_i.inv ≫ (D i).ι).appLE (D i) ⊤ hle_mid :=
          AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE α_i.inv (D i).ι (D i) ⊤ ⊤
            hle_ι_Di hle_α_top
        have hfac2 : (α_i.inv ≫ (D i).ι).appLE (D i) ⊤ hle_mid ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_hom)).appLE ⊤ ⊤ hle_g_top =
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_hom) ≫ α_i.inv ≫ (D i).ι).appLE
              (D i) ⊤ (by rw [← hι₀₁_fac]; exact hle_Di_top) :=
          AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_hom)) (α_i.inv ≫ (D i).ι)
            (D i) ⊤ ⊤ hle_mid hle_g_top
        have hcongr : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_hom) ≫
            α_i.inv ≫ (D i).ι).appLE (D i) ⊤ (by rw [← hι₀₁_fac]; exact hle_Di_top) =
            ι₀₁.appLE (D i) ⊤ hle_Di_top := by
          congr 1
          exact hι₀₁_fac.symm
        rw [← hcongr, ← hfac2, ← hfac1, hι_appLE_eq_topIso_inv,
          happLE_top_eq_appTop α_i.inv hle_α_top,
          happLE_top_eq_appTop (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_hom)) hle_g_top,
          CategoryTheory.Category.assoc]
      have hcomp_θ : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
          α_i.hom.appTop ≫ (D i).topIso.hom) ≫
          (AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE hle).op ≫ θ₀₁ =
          CommRingCat.ofHom g_hom := by
        have h_hom_inv : α_i.hom.appTop ≫ α_i.inv.appTop = 𝟙 _ := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Iso.inv_hom_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop]
        calc ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
              α_i.hom.appTop ≫ (D i).topIso.hom) ≫
              (AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE hle).op ≫ θ₀₁
            = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
                α_i.hom.appTop ≫ (D i).topIso.hom ≫
                ((AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE hle).op ≫
                  ι₀₁.appLE (D 0 ⊓ D 1) ⊤ hle_01_top) ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀₁)).hom := by
              dsimp [θ₀₁]
              simp only [CategoryTheory.Category.assoc]
          _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
                (α_i.hom.appTop ≫ α_i.inv.appTop) ≫
                ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_hom)).appTop ≫
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀₁)).hom) := by
              rw [AlgebraicGeometry.Scheme.Hom.map_appLE, hι₀₁_Di_split]
              simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
          _ = CommRingCat.ofHom g_hom := by
              rw [h_hom_inv, CategoryTheory.Category.id_comp,
                AlgebraicGeometry.Scheme.ΓSpecIso_naturality,
                CategoryTheory.Iso.inv_hom_id_assoc]
      have heval := congrArg (fun ψ => CommRingCat.Hom.hom ψ Polynomial.X) hcomp_θ
      change (CommRingCat.Hom.hom θ₀₁)
          ((CommRingCat.Hom.hom ((AlgebraicGeometry.Proj 𝒜).presheaf.map
            (CategoryTheory.homOfLE hle).op))
            ((CommRingCat.Hom.hom
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
                α_i.hom.appTop ≫ (D i).topIso.hom)) Polynomial.X)) =
          g_hom Polynomial.X at heval
      rw [hs_i] at heval
      rw [heval]
      dsimp [g_hom]
      rw [he_X]
    have hθ_s₀ := hθ_chart 0 1 inf_le_left e₀ α₀ s₀ rfl he₀_X hα₀_inv_ι hs₀
    have hθ_s₁ := hθ_chart 1 0 inf_le_right e₁ α₁ s₁ (mul_comm (T 0) (T 1)) he₁_X hα₁_inv_ι hs₁
    have hs_mul :
        ((CommRingCat.Hom.hom ((AlgebraicGeometry.Proj 𝒜).presheaf.map
          (CategoryTheory.homOfLE (inf_le_left : D 0 ⊓ D 1 ≤ D 0)).op)) s₀) *
        ((CommRingCat.Hom.hom ((AlgebraicGeometry.Proj 𝒜).presheaf.map
          (CategoryTheory.homOfLE (inf_le_right : D 0 ⊓ D 1 ≤ D 1)).op)) s₁) = 1 := by
      apply hθ₀₁_inj
      rw [map_mul, map_one, hθ_s₀, hθ_s₁]
      apply HomogeneousLocalization.val_injective (Submonoid.powers (T 0 * T 1))
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one]
      dsimp [HomogeneousLocalization.Away.isLocalizationElem]
      rw [HomogeneousLocalization.awayMap_mk]
      rw [HomogeneousLocalization.awayMap_mk]
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk]
      rw [Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk_iff,
        Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_one, Submonoid.coe_mul, one_mul, pow_one]
      ring
    exact ⟨D 0, D 1, α₀, α₁, s₀, s₁, hD_cov, hα₀_base, hα₁_base, hs₀, hs₁,
      hbo_s₀, hbo_s₁, hs_mul⟩

  
  obtain ⟨D₀, D₁, α₀, α₁, s₀, s₁, hD_cov, hα₀_base, hα₁_base, hs₀, hs₁,
    hbo_s₀, hbo_s₁, hs_mul⟩ := hProjCover
  let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
  let X_A := CategoryTheory.Limits.pullback s_A P₁.hom
  let p₁ := CategoryTheory.Limits.pullback.fst s_A P₁.hom
  let p₂ := CategoryTheory.Limits.pullback.snd s_A P₁.hom
  let W₀ : X_A.Opens := (TopologicalSpace.Opens.map p₂.base).obj D₀
  let W₁ : X_A.Opens := (TopologicalSpace.Opens.map p₂.base).obj D₁
  let W₀₁ : X_A.Opens := W₀ ⊓ W₁
  obtain ⟨hAff_W₀, γ₀, hγ₀_C, hγ₀_X⟩ := hBaseChangePoly P₁.left P₁.hom D₀ α₀ s₀ hα₀_base hs₀
  obtain ⟨hAff_W₁, γ₁, hγ₁_C, hγ₁_X⟩ := hBaseChangePoly P₁.left P₁.hom D₁ α₁ s₁ hα₁_base hs₁
  obtain ⟨hAff_π, hFin_π⟩ := (AlgebraicGeometry.isFinite_iff π).mp inferInstance
  have _ : AlgebraicGeometry.IsAffineHom π := hAff_π
  let U₀ : Y.Opens := (TopologicalSpace.Opens.map π.base).obj W₀
  let U₁ : Y.Opens := (TopologicalSpace.Opens.map π.base).obj W₁
  let U₀₁ : Y.Opens := U₀ ⊓ U₁
  have hU_cov : U₀ ⊔ U₁ = ⊤ := by
    ext y
    have hmem : p₂.base (π.base y) ∈ (⊤ : P₁.left.Opens) := trivial
    rw [← hD_cov] at hmem
    exact iff_of_true hmem trivial
  have hAff_U₀ : AlgebraicGeometry.IsAffineOpen U₀ := hAff_W₀.preimage π
  have hAff_U₁ : AlgebraicGeometry.IsAffineOpen U₁ := hAff_W₁.preimage π

  let B := ↑(Y.presheaf.obj (Opposite.op ⊤))
  let e_Y : B ≃+* B := RingEquiv.refl B
  let f_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of A) := π ≫ p₁
  let σ_B : A →+* B :=
    CommRingCat.Hom.hom
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ f_Y.appTop)
  let _ : Algebra A B := RingHom.toAlgebra σ_B

  let M₀ := ↑(Y.presheaf.obj (Opposite.op U₀))
  let M₁ := ↑(Y.presheaf.obj (Opposite.op U₁))
  let M₀₁ := ↑(Y.presheaf.obj (Opposite.op U₀₁))
  let rY₀ : B →+* M₀ := CommRingCat.Hom.hom (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op)
  let rY₁ : B →+* M₁ := CommRingCat.Hom.hom (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₁ ≤ ⊤)).op)
  let rY₀₁ : B →+* M₀₁ := CommRingCat.Hom.hom (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀₁ ≤ ⊤)).op)
  let resY₀ : M₀ →+* M₀₁ := CommRingCat.Hom.hom (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀₁ ≤ U₀)).op)
  let resY₁ : M₁ →+* M₀₁ := CommRingCat.Hom.hom (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀₁ ≤ U₁)).op)

  let σ₀ : A →+* M₀ := rY₀.comp σ_B
  let σ₁ : A →+* M₁ := rY₁.comp σ_B
  let σ₀₁ : A →+* M₀₁ := rY₀₁.comp σ_B
  let _ : Algebra A M₀ := RingHom.toAlgebra σ₀
  let _ : Algebra A M₁ := RingHom.toAlgebra σ₁
  let _ : Algebra A M₀₁ := RingHom.toAlgebra σ₀₁

  let algP₀ : Polynomial A →+* M₀ := (CommRingCat.Hom.hom (π.app W₀)).comp γ₀.toRingHom
  let algP₁ : Polynomial A →+* M₁ := (CommRingCat.Hom.hom (π.app W₁)).comp γ₁.toRingHom
  let _ : Algebra (Polynomial A) M₀ := RingHom.toAlgebra algP₀
  let _ : Algebra (Polynomial A) M₁ := RingHom.toAlgebra algP₁

  have hST₀ : IsScalarTower A (Polynomial A) M₀ := by
    apply IsScalarTower.of_algebraMap_eq
    intro a
    change rY₀ (σ_B a) = (CommRingCat.Hom.hom (π.app W₀)) (γ₀ (Polynomial.C a))
    rw [hγ₀_C a]
    have hnat := AlgebraicGeometry.Scheme.Hom.naturality π
      (CategoryTheory.homOfLE (le_top : W₀ ≤ ⊤)).op
    exact (congrArg (fun φ => CommRingCat.Hom.hom φ
      ((CommRingCat.Hom.hom p₁.appTop)
        ((CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv) a)))
      hnat).symm
  have hST₁ : IsScalarTower A (Polynomial A) M₁ := by
    apply IsScalarTower.of_algebraMap_eq
    intro a
    change rY₁ (σ_B a) = (CommRingCat.Hom.hom (π.app W₁)) (γ₁ (Polynomial.C a))
    rw [hγ₁_C a]
    have hnat := AlgebraicGeometry.Scheme.Hom.naturality π
      (CategoryTheory.homOfLE (le_top : W₁ ≤ ⊤)).op
    exact (congrArg (fun φ => CommRingCat.Hom.hom φ
      ((CommRingCat.Hom.hom p₁.appTop)
        ((CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv) a)))
      hnat).symm

  have hFin_M₀ : Module.Finite (Polynomial A) M₀ := by
    change RingHom.Finite (algebraMap (Polynomial A) M₀)
    exact RingHom.Finite.comp (hFin_π W₀ hAff_W₀)
      (RingHom.Finite.of_surjective γ₀.toRingHom γ₀.surjective)
  have hFin_M₁ : Module.Finite (Polynomial A) M₁ := by
    change RingHom.Finite (algebraMap (Polynomial A) M₁)
    exact RingHom.Finite.comp (hFin_π W₁ hAff_W₁)
      (RingHom.Finite.of_surjective γ₁.toRingHom γ₁.surjective)

  
  let t₀ : M₀ := algebraMap (Polynomial A) M₀ Polynomial.X
  let u₁ : M₁ := algebraMap (Polynomial A) M₁ Polynomial.X
  have ht₀_eq : t₀ = (CommRingCat.Hom.hom (π.app W₀)) ((CommRingCat.Hom.hom (p₂.app D₀)) s₀) := by
    change (CommRingCat.Hom.hom (π.app W₀)) (γ₀ Polynomial.X) = _
    rw [hγ₀_X]
  have hu₁_eq : u₁ = (CommRingCat.Hom.hom (π.app W₁)) ((CommRingCat.Hom.hom (p₂.app D₁)) s₁) := by
    change (CommRingCat.Hom.hom (π.app W₁)) (γ₁ Polynomial.X) = _
    rw [hγ₁_X]
  have hbo_t₀ : Y.basicOpen t₀ = U₀₁ := by
    rw [ht₀_eq, ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen π,
      ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen p₂, hbo_s₀]
    rfl
  have hbo_u₁ : Y.basicOpen u₁ = U₀₁ := by
    rw [hu₁_eq, ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen π,
      ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen p₂, hbo_s₁]
    rfl

  obtain ⟨hAff_U₀₁, hSurj_t₀, hKer_t₀⟩ :=
    hBasicAway Y U₀ U₀₁ hAff_U₀ inf_le_left t₀ hbo_t₀
  obtain ⟨-, hSurj_u₁, hKer_u₁⟩ :=
    hBasicAway Y U₁ U₀₁ hAff_U₁ inf_le_right u₁ hbo_u₁

  have hMul_one : resY₀ t₀ * resY₁ u₁ = 1 := by
    rw [ht₀_eq, hu₁_eq]
    let φ_01 : ↑(P₁.left.presheaf.obj (Opposite.op (D₀ ⊓ D₁))) →+* M₀₁ :=
      (CommRingCat.Hom.hom (π.app W₀₁)).comp (CommRingCat.Hom.hom (p₂.app (D₀ ⊓ D₁)))
    have hnat_π₀ := AlgebraicGeometry.Scheme.Hom.naturality π
      (CategoryTheory.homOfLE (inf_le_left : W₀₁ ≤ W₀)).op
    have hnat_π₁ := AlgebraicGeometry.Scheme.Hom.naturality π
      (CategoryTheory.homOfLE (inf_le_right : W₀₁ ≤ W₁)).op
    have hnat_p₂₀ := AlgebraicGeometry.Scheme.Hom.naturality p₂
      (CategoryTheory.homOfLE (inf_le_left : D₀ ⊓ D₁ ≤ D₀)).op
    have hnat_p₂₁ := AlgebraicGeometry.Scheme.Hom.naturality p₂
      (CategoryTheory.homOfLE (inf_le_right : D₀ ⊓ D₁ ≤ D₁)).op
    have hres_t₀ : resY₀ ((CommRingCat.Hom.hom (π.app W₀)) ((CommRingCat.Hom.hom (p₂.app D₀)) s₀)) =
        φ_01 ((CommRingCat.Hom.hom (P₁.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_left : D₀ ⊓ D₁ ≤ D₀)).op)) s₀) := by
      have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ ((CommRingCat.Hom.hom (p₂.app D₀)) s₀))
        hnat_π₀.symm
      have h2 := congrArg (fun φ => CommRingCat.Hom.hom φ s₀) hnat_p₂₀.symm
      exact h1.trans (congrArg (CommRingCat.Hom.hom (π.app W₀₁)) h2)
    have hres_u₁ : resY₁ ((CommRingCat.Hom.hom (π.app W₁)) ((CommRingCat.Hom.hom (p₂.app D₁)) s₁)) =
        φ_01 ((CommRingCat.Hom.hom (P₁.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_right : D₀ ⊓ D₁ ≤ D₁)).op)) s₁) := by
      have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ ((CommRingCat.Hom.hom (p₂.app D₁)) s₁))
        hnat_π₁.symm
      have h2 := congrArg (fun φ => CommRingCat.Hom.hom φ s₁) hnat_p₂₁.symm
      exact h1.trans (congrArg (CommRingCat.Hom.hom (π.app W₀₁)) h2)
    rw [hres_t₀, hres_u₁, ← map_mul, hs_mul, map_one]

  
  let ρ₀ : M₀ →ₐ[A] M₀₁ :=
    { resY₀ with
      commutes' := fun a => by
        change resY₀ (rY₀ (σ_B a)) = rY₀₁ (σ_B a)
        have hcomp : Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op ≫
              Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀₁ ≤ U₀)).op =
            Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀₁ ≤ ⊤)).op := by
          rw [← Y.presheaf.map_comp]
          congr 1
        exact congrArg (fun φ => CommRingCat.Hom.hom φ (σ_B a)) hcomp }
  let ρ₁ : M₁ →ₐ[A] M₀₁ :=
    { resY₁ with
      commutes' := fun a => by
        change resY₁ (rY₁ (σ_B a)) = rY₀₁ (σ_B a)
        have hcomp : Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₁ ≤ ⊤)).op ≫
              Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀₁ ≤ U₁)).op =
            Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀₁ ≤ ⊤)).op := by
          rw [← Y.presheaf.map_comp]
          congr 1
        exact congrArg (fun φ => CommRingCat.Hom.hom φ (σ_B a)) hcomp }
  let i₀ : B →ₐ[A] M₀ := { rY₀ with commutes' := fun _ => rfl }
  let i₁ : B →ₐ[A] M₁ := { rY₁ with commutes' := fun _ => rfl }
  obtain ⟨hEqY_res, hEqY_inj, hEqY_glue⟩ := hSheafEq Y U₀ U₁ hU_cov

  
  let ι_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom)
  let Y₀ := CategoryTheory.Limits.pullback ι_A f_Y
  let i_Y := CategoryTheory.Limits.pullback.snd ι_A f_Y
  let B₀ := ↑(Y₀.presheaf.obj (Opposite.op ⊤))
  let U₀_0 : Y₀.Opens := (TopologicalSpace.Opens.map i_Y.base).obj U₀
  let U₀_1 : Y₀.Opens := (TopologicalSpace.Opens.map i_Y.base).obj U₁
  let U₀_01 : Y₀.Opens := U₀_0 ⊓ U₀_1
  have hU₀_cov : U₀_0 ⊔ U₀_1 = ⊤ := by
    ext y
    have hmem : i_Y.base y ∈ (⊤ : Y.Opens) := trivial
    rw [← hU_cov] at hmem
    exact iff_of_true hmem trivial

  obtain ⟨Φ₀, hΦ₀⟩ := hSpecialFiberQuot f_Y U₀ hAff_U₀
  obtain ⟨Φ₁, hΦ₁⟩ := hSpecialFiberQuot f_Y U₁ hAff_U₁
  obtain ⟨Φ₀₁, hΦ₀₁⟩ := hSpecialFiberQuot f_Y U₀₁ hAff_U₀₁

  let rY₀_0 : B₀ →+* ↑(Y₀.presheaf.obj (Opposite.op U₀_0)) :=
    CommRingCat.Hom.hom (Y₀.presheaf.map (CategoryTheory.homOfLE (le_top : U₀_0 ≤ ⊤)).op)
  let rY₀_1 : B₀ →+* ↑(Y₀.presheaf.obj (Opposite.op U₀_1)) :=
    CommRingCat.Hom.hom (Y₀.presheaf.map (CategoryTheory.homOfLE (le_top : U₀_1 ≤ ⊤)).op)
  let resY₀_0 : ↑(Y₀.presheaf.obj (Opposite.op U₀_0)) →+* ↑(Y₀.presheaf.obj (Opposite.op U₀_01)) :=
    CommRingCat.Hom.hom (Y₀.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀_01 ≤ U₀_0)).op)
  let resY₀_1 : ↑(Y₀.presheaf.obj (Opposite.op U₀_1)) →+* ↑(Y₀.presheaf.obj (Opposite.op U₀_01)) :=
    CommRingCat.Hom.hom (Y₀.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀_01 ≤ U₀_1)).op)

  let 𝔪 := RingHom.ker τ_A.toRingHom
  let j₀ : B₀ →+* (M₀ ⧸ Ideal.map (algebraMap A M₀) 𝔪) := Φ₀.toRingHom.comp rY₀_0
  let j₁ : B₀ →+* (M₁ ⧸ Ideal.map (algebraMap A M₁) 𝔪) := Φ₁.toRingHom.comp rY₀_1
  obtain ⟨hEqY₀_res, hEqY₀_inj, hEqY₀_glue⟩ := hSheafEq Y₀ U₀_0 U₀_1 hU₀_cov

  have hΦ₀₁_ρ₀ : ∀ x₀ : M₀,
      Φ₀₁ (resY₀_0 ((CommRingCat.Hom.hom (i_Y.app U₀)) x₀)) =
        Ideal.Quotient.mk (Ideal.map (algebraMap A M₀₁) 𝔪) (ρ₀ x₀) := by
    intro x₀
    have hnat := AlgebraicGeometry.Scheme.Hom.naturality i_Y
      (CategoryTheory.homOfLE (inf_le_left : U₀₁ ≤ U₀)).op
    have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ x₀) hnat.symm
    change resY₀_0 ((CommRingCat.Hom.hom (i_Y.app U₀)) x₀) =
      (CommRingCat.Hom.hom (i_Y.app U₀₁)) (ρ₀ x₀) at h1
    rw [h1]
    exact hΦ₀₁ (ρ₀ x₀)
  have hΦ₀₁_ρ₁ : ∀ x₁ : M₁,
      Φ₀₁ (resY₀_1 ((CommRingCat.Hom.hom (i_Y.app U₁)) x₁)) =
        Ideal.Quotient.mk (Ideal.map (algebraMap A M₀₁) 𝔪) (ρ₁ x₁) := by
    intro x₁
    have hnat := AlgebraicGeometry.Scheme.Hom.naturality i_Y
      (CategoryTheory.homOfLE (inf_le_right : U₀₁ ≤ U₁)).op
    have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ x₁) hnat.symm
    change resY₀_1 ((CommRingCat.Hom.hom (i_Y.app U₁)) x₁) =
      (CommRingCat.Hom.hom (i_Y.app U₀₁)) (ρ₁ x₁) at h1
    rw [h1]
    exact hΦ₀₁ (ρ₁ x₁)

  refine ⟨B, inferInstance, inferInstance, e_Y, M₀, M₁, M₀₁,
    inferInstance, inferInstance, inferInstance, hST₀, hFin_M₀,
    inferInstance, inferInstance, inferInstance, hST₁, hFin_M₁,
    inferInstance, inferInstance,
    ρ₀, ρ₁, i₀, i₁, j₀, j₁,
    hMul_one, hSurj_t₀, hKer_t₀, hSurj_u₁, hKer_u₁,
    hEqY_res, hEqY_inj, hEqY_glue, ?_, ?_, ?_, ?_⟩
  · 
    intro b₀ x₀ x₁ hx₀ hx₁
    have hx₀' : (CommRingCat.Hom.hom (i_Y.app U₀)) x₀ = rY₀_0 b₀ :=
      Φ₀.injective ((hΦ₀ x₀).trans hx₀)
    have hx₁' : (CommRingCat.Hom.hom (i_Y.app U₁)) x₁ = rY₀_1 b₀ :=
      Φ₁.injective ((hΦ₁ x₁).trans hx₁)
    rw [← hΦ₀₁_ρ₀ x₀, ← hΦ₀₁_ρ₁ x₁, hx₀', hx₁', hEqY₀_res b₀]
  · 
    intro b₁ b₂ hj₀ hj₁
    exact hEqY₀_inj b₁ b₂ (Φ₀.injective hj₀) (Φ₁.injective hj₁)
  · 
    intro x₀ x₁ hq
    rw [← hΦ₀₁_ρ₀ x₀, ← hΦ₀₁_ρ₁ x₁] at hq
    obtain ⟨b₀, hb₀_0, hb₀_1⟩ := hEqY₀_glue _ _ (Φ₀₁.injective hq)
    refine ⟨b₀, ?_, ?_⟩
    · change Φ₀ (rY₀_0 b₀) = _
      rw [hb₀_0]
      exact hΦ₀ x₀
    · change Φ₁ (rY₀_1 b₀) = _
      rw [hb₀_1]
      exact hΦ₁ x₁
  · 
    intro b
    constructor
    · change Φ₀ (rY₀_0 ((CommRingCat.Hom.hom i_Y.appTop) b)) = _
      have hnat₀ := AlgebraicGeometry.Scheme.Hom.naturality i_Y
        (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op
      have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ b) hnat₀.symm
      change rY₀_0 ((CommRingCat.Hom.hom i_Y.appTop) b) =
        (CommRingCat.Hom.hom (i_Y.app U₀)) (i₀ b) at h1
      rw [h1]
      exact hΦ₀ (i₀ b)
    · change Φ₁ (rY₀_1 ((CommRingCat.Hom.hom i_Y.appTop) b)) = _
      have hnat₁ := AlgebraicGeometry.Scheme.Hom.naturality i_Y
        (CategoryTheory.homOfLE (le_top : U₁ ≤ ⊤)).op
      have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ b) hnat₁.symm
      change rY₀_1 ((CommRingCat.Hom.hom i_Y.appTop) b) =
        (CommRingCat.Hom.hom (i_Y.app U₁)) (i₁ b) at h1
      rw [h1]
      exact hΦ₁ (i₁ b)

theorem weil_two_chart_projLine_formal_functions_adic_completion_iso (A : Type u) [CommRing A] [IsNoetherianRing A] (𝔪 : Ideal A)
    (B B₀ : Type u) [CommRing B] [Algebra A B] [CommRing B₀] (red₀ : B →+* B₀)
    (M₀ M₁ M₀₁ : Type u)
    [CommRing M₀] [Algebra A M₀] [Algebra (Polynomial A) M₀] [IsScalarTower A (Polynomial A) M₀]
    [Module.Finite (Polynomial A) M₀]
    [CommRing M₁] [Algebra A M₁] [Algebra (Polynomial A) M₁] [IsScalarTower A (Polynomial A) M₁]
    [Module.Finite (Polynomial A) M₁]
    [CommRing M₀₁] [Algebra A M₀₁]
    (hCover : WeilIsTwoChartProjLineCoverRings A 𝔪 B B₀ red₀ M₀ M₁ M₀₁) :
    ∃ (Φ₁ : (B ⧸ Ideal.map (algebraMap A B) 𝔪) →+* B₀),
      Φ₁.comp (Ideal.Quotient.mk (Ideal.map (algebraMap A B) 𝔪)) = red₀ ∧
      Module.Finite A B ∧
      WeilRingHomIdempotentBijective Φ₁ :=
by
  classical
  rcases hCover with ⟨ρ₀, ρ₁, i₀, i₁, j₀, j₁,
    hR1, hR2, hR3, hR4, hR5,
    hEq_comm, hEq_inj, hEq_surj,
    hj_compat, hj_inj, _hj_surj, hred_compat⟩

  
  
  
  have cech_H1_finite : ∀ {R₀ : Type u} [CommRing R₀]
      {V₀ V₁ V₀₁ : Type u}
      [AddCommGroup V₀] [Module R₀ V₀] [Module (Polynomial R₀) V₀]
      [IsScalarTower R₀ (Polynomial R₀) V₀] [Module.Finite (Polynomial R₀) V₀]
      [AddCommGroup V₁] [Module R₀ V₁] [Module (Polynomial R₀) V₁]
      [IsScalarTower R₀ (Polynomial R₀) V₁]
      [AddCommGroup V₀₁] [Module R₀ V₀₁]
      (θ : V₀₁ ≃ₗ[R₀] V₀₁) (σ₀ : V₀ →ₗ[R₀] V₀₁) (σ₁ : V₁ →ₗ[R₀] V₀₁),
      (∀ x₀ : V₀, σ₀ ((Polynomial.X : Polynomial R₀) • x₀) = θ (σ₀ x₀)) →
      (∀ x₁ : V₁, σ₁ ((Polynomial.X : Polynomial R₀) • x₁) = θ.symm (σ₁ x₁)) →
      (∀ z : V₀₁, ∃ n : ℕ, (θ ^ (n : ℤ)) z ∈ LinearMap.range σ₀) →
      (∀ z : V₀₁, ∃ n : ℕ, (θ ^ (-(n : ℤ))) z ∈ LinearMap.range σ₁) →
      Module.Finite R₀
        (V₀₁ ⧸ LinearMap.range
          (σ₀.comp (LinearMap.fst R₀ V₀ V₁) - σ₁.comp (LinearMap.snd R₀ V₀ V₁))) := by
    intro R₀ _ V₀ V₁ V₀₁ _ _ _ _ _ _ _ _ _ _ _ θ σ₀ σ₁ hσ₀ hσ₁ habs₀ habs₁
    let δ_V : (V₀ × V₁) →ₗ[R₀] V₀₁ :=
      σ₀.comp (LinearMap.fst R₀ V₀ V₁) - σ₁.comp (LinearMap.snd R₀ V₀ V₁)
    have hσ₀_pow : ∀ (s : ℕ) (x₀ : V₀),
        σ₀ ((Polynomial.X ^ s : Polynomial R₀) • x₀) = (θ ^ (s : ℤ)) (σ₀ x₀) := by
      intro s
      induction s with
      | zero => intro x₀; simp
      | succ s ih =>
        intro x₀
        rw [pow_succ', mul_smul, hσ₀, ih]
        have hexp : (((s + 1 : ℕ) : ℤ)) = (1 : ℤ) + (s : ℤ) := by omega
        rw [hexp, zpow_add, zpow_one]
        rfl
    have hσ₁_pow : ∀ (s : ℕ) (x₁ : V₁),
        σ₁ ((Polynomial.X ^ s : Polynomial R₀) • x₁) = (θ ^ (-(s : ℤ))) (σ₁ x₁) := by
      intro s
      induction s with
      | zero => intro x₁; simp
      | succ s ih =>
        intro x₁
        rw [pow_succ', mul_smul, hσ₁, ih]
        have hexp : -(((s + 1 : ℕ) : ℤ)) = (-1 : ℤ) + -(s : ℤ) := by omega
        rw [hexp, zpow_add, zpow_neg_one]
        rfl
    obtain ⟨S₀, hS₀_span⟩ := Module.Finite.fg_top (R := Polynomial R₀) (M := V₀)
    let e_fn : ↥S₀ → ℕ := fun i => (habs₁ (σ₀ i.1)).choose
    let y_fn : ↥S₀ → V₁ := fun i => (habs₁ (σ₀ i.1)).choose_spec.choose
    have hy_fn : ∀ i : ↥S₀, σ₁ (y_fn i) = (θ ^ (-(e_fn i : ℤ))) (σ₀ i.1) :=
      fun i => (habs₁ (σ₀ i.1)).choose_spec.choose_spec
    let E : ℕ := Finset.univ.sup e_fn + 1
    have he_le : ∀ i : ↥S₀, e_fn i ≤ E :=
      fun i => Nat.le_succ_of_le (Finset.le_sup (Finset.mem_univ i))
    let y'_fn : ↥S₀ → V₁ := fun i => (Polynomial.X ^ (E - e_fn i) : Polynomial R₀) • y_fn i
    have hy'_fn : ∀ i : ↥S₀, σ₁ (y'_fn i) = (θ ^ (-(E : ℤ))) (σ₀ i.1) := by
      intro i
      dsimp [y'_fn]
      rw [hσ₁_pow, hy_fn i]
      have hle := he_le i
      have hexp : -(((E - e_fn i : ℕ) : ℤ)) + -(e_fn i : ℤ) = -(E : ℤ) := by omega
      rw [← hexp, zpow_add]
      rfl
    let g_gen : ↥S₀ × Fin E → (V₀₁ ⧸ LinearMap.range δ_V) :=
      fun p => Submodule.Quotient.mk ((θ ^ (-(p.2.1 : ℤ))) (σ₀ p.1.1))
    let W : Submodule R₀ (V₀₁ ⧸ LinearMap.range δ_V) := Submodule.span R₀ (Set.range g_gen)
    let U_good : Submodule R₀ V₀₁ := W.comap (Submodule.mkQ (LinearMap.range δ_V))
    have hRange_le : LinearMap.range δ_V ≤ U_good := by
      rintro _ ⟨p, rfl⟩
      rw [Submodule.mem_comap, Submodule.mkQ_apply,
        (Submodule.Quotient.mk_eq_zero (LinearMap.range δ_V)).mpr (LinearMap.mem_range_self δ_V p)]
      exact zero_mem W
    have hP_all : ∀ x₀ : V₀, ∀ d : ℤ, (θ ^ d) (σ₀ x₀) ∈ U_good := by
      intro x₀
      have hx₀_mem : x₀ ∈ Submodule.span (Polynomial R₀) (S₀ : Set V₀) := by
        rw [hS₀_span]; trivial
      refine Submodule.span_induction (p := fun x _ => ∀ d : ℤ, (θ ^ d) (σ₀ x) ∈ U_good)
        ?_ ?_ ?_ ?_ hx₀_mem
      · intro x hx d
        let i : ↥S₀ := ⟨x, hx⟩
        by_cases hd0 : 0 ≤ d
        · let n : ℕ := d.toNat
          have hdn : (n : ℤ) = d := Int.toNat_of_nonneg hd0
          rw [← hdn, ← hσ₀_pow n x]
          apply hRange_le
          exact ⟨((Polynomial.X ^ n : Polynomial R₀) • x, 0), by simp [δ_V]⟩
        · by_cases hdE : -d < (E : ℤ)
          · let r : ℕ := (-d).toNat
            have hdr : d = -(r : ℤ) := by omega
            have hrE : r < E := by omega
            rw [hdr, Submodule.mem_comap]
            exact Submodule.subset_span ⟨(i, ⟨r, hrE⟩), rfl⟩
          · let q : ℕ := (-d - (E : ℤ)).toNat
            have hdq : d = -(q : ℤ) + -(E : ℤ) := by omega
            rw [hdq, zpow_add]
            change (θ ^ (-(q : ℤ))) ((θ ^ (-(E : ℤ))) (σ₀ i.1)) ∈ U_good
            rw [← hy'_fn i, ← hσ₁_pow q (y'_fn i)]
            apply hRange_le
            exact ⟨(0, -((Polynomial.X ^ q : Polynomial R₀) • y'_fn i)), by simp [δ_V]⟩
      · intro d
        simp
      · intro x₁ x₂ _ _ ih₁ ih₂ d
        rw [map_add, map_add]
        exact add_mem (ih₁ d) (ih₂ d)
      · intro p x _ ih
        induction p using Polynomial.induction_on' with
        | add p₁ p₂ hp₁ hp₂ =>
          intro d
          rw [add_smul, map_add, map_add]
          exact add_mem (hp₁ d) (hp₂ d)
        | monomial s c =>
          intro d
          have hmon : (Polynomial.monomial s c) • x =
              c • ((Polynomial.X ^ s : Polynomial R₀) • x) := by
            rw [← Polynomial.C_mul_X_pow_eq_monomial, mul_smul,
              Polynomial.C_eq_algebraMap, algebraMap_smul]
          rw [hmon, map_smul, hσ₀_pow s x, map_smul]
          have hz : (θ ^ d) ((θ ^ (s : ℤ)) (σ₀ x)) = (θ ^ (d + (s : ℤ))) (σ₀ x) := by
            rw [zpow_add]; rfl
          rw [hz]
          exact U_good.smul_mem c (ih (d + (s : ℤ)))
    have hW_top : W = ⊤ := by
      rw [eq_top_iff]
      rintro q -
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ q
      obtain ⟨n, x₀, hx₀⟩ := habs₀ z
      have hz_eq : z = (θ ^ (-(n : ℤ))) (σ₀ x₀) := by
        rw [hx₀]
        change z = ((θ ^ (-(n : ℤ))) * (θ ^ (n : ℤ))) z
        rw [← zpow_add, neg_add_cancel, zpow_zero]
        rfl
      have hz_mem : z ∈ U_good := hz_eq ▸ hP_all x₀ (-(n : ℤ))
      exact hz_mem
    rw [Module.finite_def, ← hW_top]
    exact Submodule.fg_span (Set.finite_range g_gen)

  have cech_both_finite : ∀ (R₀ : Type u) [CommRing R₀] [IsNoetherianRing R₀]
      (N₀ N₁ N₀₁ : Type u)
      [CommRing N₀] [Algebra R₀ N₀] [Algebra (Polynomial R₀) N₀]
      [IsScalarTower R₀ (Polynomial R₀) N₀] [Module.Finite (Polynomial R₀) N₀]
      [CommRing N₁] [Algebra R₀ N₁] [Algebra (Polynomial R₀) N₁]
      [IsScalarTower R₀ (Polynomial R₀) N₁] [Module.Finite (Polynomial R₀) N₁]
      [CommRing N₀₁] [Algebra R₀ N₀₁]
      (σ₀ : N₀ →ₐ[R₀] N₀₁) (σ₁ : N₁ →ₐ[R₀] N₀₁),
      σ₀ (algebraMap (Polynomial R₀) N₀ Polynomial.X) *
        σ₁ (algebraMap (Polynomial R₀) N₁ Polynomial.X) = 1 →
      (∀ z : N₀₁, ∃ (n : ℕ) (x₀ : N₀),
        (σ₀ (algebraMap (Polynomial R₀) N₀ Polynomial.X)) ^ n * z = σ₀ x₀) →
      (∀ x₀ : N₀, σ₀ x₀ = 0 → ∃ n : ℕ,
        (algebraMap (Polynomial R₀) N₀ Polynomial.X) ^ n * x₀ = 0) →
      (∀ z : N₀₁, ∃ (n : ℕ) (x₁ : N₁),
        (σ₁ (algebraMap (Polynomial R₀) N₁ Polynomial.X)) ^ n * z = σ₁ x₁) →
      (∀ x₁ : N₁, σ₁ x₁ = 0 → ∃ n : ℕ,
        (algebraMap (Polynomial R₀) N₁ Polynomial.X) ^ n * x₁ = 0) →
      let δ : (N₀ × N₁) →ₗ[R₀] N₀₁ :=
        σ₀.toLinearMap.comp (LinearMap.fst R₀ N₀ N₁) -
        σ₁.toLinearMap.comp (LinearMap.snd R₀ N₀ N₁)
      Module.Finite R₀ (LinearMap.ker δ) ∧ Module.Finite R₀ (N₀₁ ⧸ LinearMap.range δ) := by
    intro R₀ _ _ N₀ N₁ N₀₁ _ _ _ _ _ _ _ _ _ _ _ _ σ₀ σ₁ hc1 hc2 hc3 hc4 hc5
    let t₀ : N₀ := algebraMap (Polynomial R₀) N₀ Polynomial.X
    let u₁ : N₁ := algebraMap (Polynomial R₀) N₁ Polynomial.X
    let τ : N₀₁ := σ₀ t₀
    let υ : N₀₁ := σ₁ u₁
    have hτυ : τ * υ = 1 := hc1
    have hυτ : υ * τ = 1 := by rw [mul_comm]; exact hτυ
    let θ_t : N₀₁ ≃ₗ[R₀] N₀₁ :=
      { toFun := fun z => τ * z
        map_add' := fun z₁ z₂ => mul_add τ z₁ z₂
        map_smul' := fun c z => mul_smul_comm c τ z
        invFun := fun z => υ * z
        left_inv := fun z => by dsimp; rw [← mul_assoc, hυτ, one_mul]
        right_inv := fun z => by dsimp; rw [← mul_assoc, hτυ, one_mul] }
    have hθt_pos : ∀ (n : ℕ) (z : N₀₁), (θ_t ^ (n : ℤ)) z = τ ^ n * z := by
      intro n
      induction n with
      | zero => intro z; simp
      | succ n ih =>
        intro z
        have hexp : (((n + 1 : ℕ) : ℤ)) = (1 : ℤ) + (n : ℤ) := by omega
        rw [hexp, zpow_add, zpow_one]
        change τ * ((θ_t ^ (n : ℤ)) z) = τ ^ (n + 1) * z
        rw [ih z, ← mul_assoc, ← pow_succ']
    have hθt_neg : ∀ (n : ℕ) (z : N₀₁), (θ_t ^ (-(n : ℤ))) z = υ ^ n * z := by
      intro n
      induction n with
      | zero => intro z; simp
      | succ n ih =>
        intro z
        have hexp : -(((n + 1 : ℕ) : ℤ)) = (-1 : ℤ) + -(n : ℤ) := by omega
        rw [hexp, zpow_add, zpow_neg_one]
        change υ * ((θ_t ^ (-(n : ℤ))) z) = υ ^ (n + 1) * z
        rw [ih z, ← mul_assoc, ← pow_succ']
    have hX_N₀ : ∀ (s : ℕ) (x₀ : N₀),
        ((Polynomial.X ^ s : Polynomial R₀) • x₀) = t₀ ^ s * x₀ := by
      intro s x₀
      rw [Algebra.smul_def, map_pow]
    have hX_N₁ : ∀ (s : ℕ) (x₁ : N₁),
        ((Polynomial.X ^ s : Polynomial R₀) • x₁) = u₁ ^ s * x₁ := by
      intro s x₁
      rw [Algebra.smul_def, map_pow]
    have hσ₀_X : ∀ x₀ : N₀, σ₀ ((Polynomial.X : Polynomial R₀) • x₀) = θ_t (σ₀ x₀) := by
      intro x₀
      rw [Algebra.smul_def, map_mul]
      rfl
    have hσ₁_X : ∀ x₁ : N₁, σ₁ ((Polynomial.X : Polynomial R₀) • x₁) = θ_t.symm (σ₁ x₁) := by
      intro x₁
      rw [Algebra.smul_def, map_mul]
      rfl
    have habs₀_N : ∀ z : N₀₁, ∃ n : ℕ, (θ_t ^ (n : ℤ)) z ∈ LinearMap.range σ₀.toLinearMap := by
      intro z
      obtain ⟨n, x₀, hx₀⟩ := hc2 z
      exact ⟨n, x₀, by rw [hθt_pos]; exact hx₀.symm⟩
    have habs₁_N : ∀ z : N₀₁, ∃ n : ℕ, (θ_t ^ (-(n : ℤ))) z ∈ LinearMap.range σ₁.toLinearMap := by
      intro z
      obtain ⟨n, x₁, hx₁⟩ := hc4 z
      exact ⟨n, x₁, by rw [hθt_neg]; exact hx₁.symm⟩
    let δ : (N₀ × N₁) →ₗ[R₀] N₀₁ :=
      σ₀.toLinearMap.comp (LinearMap.fst R₀ N₀ N₁) -
      σ₁.toLinearMap.comp (LinearMap.snd R₀ N₀ N₁)
    have hFinH1 : Module.Finite R₀ (N₀₁ ⧸ LinearMap.range δ) :=
      cech_H1_finite θ_t σ₀.toLinearMap σ₁.toLinearMap hσ₀_X hσ₁_X habs₀_N habs₁_N

    
    obtain ⟨S₀, hS₀_span⟩ := Module.Finite.fg_top (R := Polynomial R₀) (M := N₀)
    obtain ⟨S₁, hS₁_span⟩ := Module.Finite.fg_top (R := Polynomial R₀) (M := N₁)
    let ι := ↥S₀ ⊕ ↥S₁
    let e₀ : ↥S₀ → ℕ := fun i => (hc4 (σ₀ i.1)).choose
    let y₀ : ↥S₀ → N₁ := fun i => (hc4 (σ₀ i.1)).choose_spec.choose
    have hy₀ : ∀ i : ↥S₀, υ ^ (e₀ i) * σ₀ i.1 = σ₁ (y₀ i) :=
      fun i => (hc4 (σ₀ i.1)).choose_spec.choose_spec
    let d₀ : ↥S₁ → ℕ := fun j => (hc2 (σ₁ j.1)).choose
    let z₀ : ↥S₁ → N₀ := fun j => (hc2 (σ₁ j.1)).choose_spec.choose
    have hz₀ : ∀ j : ↥S₁, τ ^ (d₀ j) * σ₁ j.1 = σ₀ (z₀ j) :=
      fun j => (hc2 (σ₁ j.1)).choose_spec.choose_spec
    let M : ℕ := max (Finset.univ.sup e₀) (Finset.univ.sup d₀) + 1
    have hM_pos : 1 ≤ M := Nat.succ_le_succ (Nat.zero_le _)
    have he₀_le : ∀ i : ↥S₀, e₀ i ≤ M := fun i =>
      Nat.le_succ_of_le (le_trans (Finset.le_sup (Finset.mem_univ i)) (le_max_left _ _))
    have hd₀_le : ∀ j : ↥S₁, d₀ j ≤ M := fun j =>
      Nat.le_succ_of_le (le_trans (Finset.le_sup (Finset.mem_univ j)) (le_max_right _ _))
    let v_tilde : ι → N₀ := Sum.elim (fun i => i.1)
      (fun j => (Polynomial.X ^ (M - d₀ j) : Polynomial R₀) • z₀ j)
    let y_tilde : ι → N₁ := Sum.elim
      (fun i => (Polynomial.X ^ (M - e₀ i) : Polynomial R₀) • y₀ i) (fun j => j.1)
    have hv_y_rel : ∀ κ : ι, (θ_t ^ (-(M : ℤ))) (σ₀ (v_tilde κ)) = σ₁ (y_tilde κ) := by
      rintro (i | j)
      · dsimp [v_tilde, y_tilde]
        rw [hθt_neg M, hX_N₁, map_mul, map_pow, ← hy₀ i, ← mul_assoc, ← pow_add]
        have hsum : M - e₀ i + e₀ i = M := Nat.sub_add_cancel (he₀_le i)
        rw [hsum]
      · dsimp [v_tilde, y_tilde]
        rw [hX_N₀, map_mul, map_pow, ← hz₀ j, ← mul_assoc, ← pow_add]
        have hsum : M - d₀ j + d₀ j = M := Nat.sub_add_cancel (hd₀_le j)
        rw [hsum, ← hθt_pos M (σ₁ j.1)]
        change ((θ_t ^ (-(M : ℤ))) * (θ_t ^ (M : ℤ))) (σ₁ j.1) = σ₁ j.1
        rw [← zpow_add, neg_add_cancel, zpow_zero]
        rfl

    let P₀ : Type u := ι → Polynomial R₀
    let P₁ : Type u := ι → Polynomial R₀
    let P₀₁ : Type u := ι → (ℤ →₀ R₀)
    letI : AddCommGroup P₀ := @Pi.addCommGroup ι (fun _ => Polynomial R₀) (fun _ => inferInstance)
    letI : AddCommGroup P₁ := @Pi.addCommGroup ι (fun _ => Polynomial R₀) (fun _ => inferInstance)
    letI : AddCommGroup P₀₁ :=
      @Pi.addCommGroup ι (fun _ => ℤ →₀ R₀) (fun _ => Finsupp.instAddCommGroup)
    let shift_one (d : ℤ) : (ℤ →₀ R₀) ≃ₗ[R₀] (ℤ →₀ R₀) :=
      Finsupp.domLCongr (Equiv.addRight d)
    have hshift_single : ∀ (d m : ℤ) (c : R₀),
        shift_one d (Finsupp.single m c) = Finsupp.single (m + d) c := by
      intro d m c
      simp [shift_one, Finsupp.domLCongr_apply]
    have hshift_apply : ∀ (d : ℤ) (u : ℤ →₀ R₀) (m : ℤ),
        (shift_one d u) m = u (m - d) := by
      intro d u m
      simp [shift_one, Finsupp.domLCongr_apply, Equiv.addRight, sub_eq_add_neg]
    let θ_P : P₀₁ ≃ₗ[R₀] P₀₁ := LinearEquiv.piCongrRight (fun _ => shift_one 1)
    have hθP_pos : ∀ (n : ℕ) (h : P₀₁) (κ : ι),
        ((θ_P ^ (n : ℤ)) h) κ = shift_one (n : ℤ) (h κ) := by
      intro n
      induction n with
      | zero =>
        intro h κ
        ext m
        simp [hshift_apply]
      | succ n ih =>
        intro h κ
        have hexp : (((n + 1 : ℕ) : ℤ)) = (1 : ℤ) + (n : ℤ) := by omega
        rw [hexp, zpow_add, zpow_one]
        change shift_one 1 (((θ_P ^ (n : ℤ)) h) κ) = shift_one ((1 : ℤ) + (n : ℤ)) (h κ)
        rw [ih h κ]
        ext m
        simp only [hshift_apply]
        congr 1
        omega
    have hθP_neg : ∀ (n : ℕ) (h : P₀₁) (κ : ι),
        ((θ_P ^ (-(n : ℤ))) h) κ = shift_one (-(n : ℤ)) (h κ) := by
      intro n
      induction n with
      | zero =>
        intro h κ
        ext m
        simp [hshift_apply]
      | succ n ih =>
        intro h κ
        have hexp : -(((n + 1 : ℕ) : ℤ)) = (-1 : ℤ) + -(n : ℤ) := by omega
        rw [hexp, zpow_add, zpow_neg_one]
        change (shift_one 1).symm (((θ_P ^ (-(n : ℤ))) h) κ) =
          shift_one ((-1 : ℤ) + -(n : ℤ)) (h κ)
        rw [ih h κ]
        ext m
        have hsymm : ∀ u : ℤ →₀ R₀, (shift_one 1).symm u m = u (m + 1) := by
          intro u
          have heq := hshift_apply 1 ((shift_one 1).symm u) (m + 1)
          rw [LinearEquiv.apply_symm_apply, add_sub_cancel_right] at heq
          exact heq.symm
        rw [hsymm, hshift_apply, hshift_apply]
        congr 1
        omega

    let σ₀_one : Polynomial R₀ →ₗ[R₀] (ℤ →₀ R₀) :=
      { toFun := fun p => p.sum (fun s c => Finsupp.single (s : ℤ) c)
        map_add' := fun p q =>
          Polynomial.sum_add_index p q _ (fun _ => Finsupp.single_zero _)
            (fun _ _ _ => Finsupp.single_add _ _ _)
        map_smul' := fun c p => by
          dsimp
          induction p using Polynomial.induction_on' with
          | add p₁ p₂ hp₁ hp₂ =>
            rw [smul_add,
              Polynomial.sum_add_index _ _ _ (fun _ => Finsupp.single_zero _)
                (fun _ _ _ => Finsupp.single_add _ _ _),
              Polynomial.sum_add_index _ _ _ (fun _ => Finsupp.single_zero _)
                (fun _ _ _ => Finsupp.single_add _ _ _),
              hp₁, hp₂, smul_add]
          | monomial s a =>
            rw [Polynomial.smul_monomial, smul_eq_mul,
              Polynomial.sum_monomial_index (c * a) (fun s c => Finsupp.single (s : ℤ) c)
                (Finsupp.single_zero _),
              Polynomial.sum_monomial_index a (fun s c => Finsupp.single (s : ℤ) c)
                (Finsupp.single_zero _),
              ← smul_eq_mul, Finsupp.smul_single] }
    let σ₁_one : Polynomial R₀ →ₗ[R₀] (ℤ →₀ R₀) :=
      { toFun := fun p => p.sum (fun r c => Finsupp.single (-(M : ℤ) - (r : ℤ)) c)
        map_add' := fun p q =>
          Polynomial.sum_add_index p q _ (fun _ => Finsupp.single_zero _)
            (fun _ _ _ => Finsupp.single_add _ _ _)
        map_smul' := fun c p => by
          dsimp
          induction p using Polynomial.induction_on' with
          | add p₁ p₂ hp₁ hp₂ =>
            rw [smul_add,
              Polynomial.sum_add_index _ _ _ (fun _ => Finsupp.single_zero _)
                (fun _ _ _ => Finsupp.single_add _ _ _),
              Polynomial.sum_add_index _ _ _ (fun _ => Finsupp.single_zero _)
                (fun _ _ _ => Finsupp.single_add _ _ _),
              hp₁, hp₂, smul_add]
          | monomial r a =>
            rw [Polynomial.smul_monomial, smul_eq_mul,
              Polynomial.sum_monomial_index (c * a)
                (fun r c => Finsupp.single (-(M : ℤ) - (r : ℤ)) c) (Finsupp.single_zero _),
              Polynomial.sum_monomial_index a
                (fun r c => Finsupp.single (-(M : ℤ) - (r : ℤ)) c) (Finsupp.single_zero _),
              ← smul_eq_mul, Finsupp.smul_single] }
    have hσ₀_mon : ∀ (s : ℕ) (c : R₀),
        σ₀_one (Polynomial.monomial s c) = Finsupp.single (s : ℤ) c :=
      fun s c => Polynomial.sum_monomial_index c _ (Finsupp.single_zero _)
    have hσ₁_mon : ∀ (r : ℕ) (c : R₀),
        σ₁_one (Polynomial.monomial r c) = Finsupp.single (-(M : ℤ) - (r : ℤ)) c :=
      fun r c => Polynomial.sum_monomial_index c _ (Finsupp.single_zero _)
    have hσ₀_eval : ∀ (p : Polynomial R₀) (s : ℕ), (σ₀_one p) (s : ℤ) = p.coeff s := by
      intro p s
      induction p using Polynomial.induction_on' with
      | add p₁ p₂ hp₁ hp₂ => simp [hp₁, hp₂]
      | monomial k c =>
        rw [hσ₀_mon, Finsupp.single_apply, Polynomial.coeff_monomial]
        by_cases hk : k = s
        · subst hk; simp
        · have hne : (k : ℤ) ≠ (s : ℤ) := by omega
          simp [hk, hne]
    have hσ₁_eval_pos : ∀ (q : Polynomial R₀) (s : ℕ), (σ₁_one q) (s : ℤ) = 0 := by
      intro q s
      induction q using Polynomial.induction_on' with
      | add q₁ q₂ hq₁ hq₂ => simp [hq₁, hq₂]
      | monomial r c =>
        rw [hσ₁_mon, Finsupp.single_apply]
        have hne : -(M : ℤ) - (r : ℤ) ≠ (s : ℤ) := by omega
        simp [hne]
    have hσ₁_eval : ∀ (q : Polynomial R₀) (r : ℕ),
        (σ₁_one q) (-(M : ℤ) - (r : ℤ)) = q.coeff r := by
      intro q r
      induction q using Polynomial.induction_on' with
      | add q₁ q₂ hq₁ hq₂ => simp [hq₁, hq₂]
      | monomial k c =>
        rw [hσ₁_mon, Finsupp.single_apply, Polynomial.coeff_monomial]
        by_cases hk : k = r
        · subst hk; simp
        · have hne : -(M : ℤ) - (k : ℤ) ≠ -(M : ℤ) - (r : ℤ) := by omega
          simp [hk, hne]

    let σ₀P : P₀ →ₗ[R₀] P₀₁ := LinearMap.pi (fun κ => σ₀_one.comp (LinearMap.proj κ))
    let σ₁P : P₁ →ₗ[R₀] P₀₁ := LinearMap.pi (fun κ => σ₁_one.comp (LinearMap.proj κ))
    have hH0_P_vanish : ∀ (f : P₀) (g : P₁), σ₀P f = σ₁P g → f = 0 ∧ g = 0 := by
      intro f g hfg
      have hf0 : f = 0 := by
        ext κ s
        rw [Pi.zero_apply, Polynomial.coeff_zero, ← hσ₀_eval (f κ) s]
        have hκ := congr_fun hfg κ
        change σ₀_one (f κ) = σ₁_one (g κ) at hκ
        rw [hκ, hσ₁_eval_pos]
      refine ⟨hf0, ?_⟩
      subst hf0
      rw [map_zero] at hfg
      ext κ r
      rw [Pi.zero_apply, Polynomial.coeff_zero, ← hσ₁_eval (g κ) r]
      have hκ := (congr_fun hfg κ).symm
      change σ₁_one (g κ) = 0 at hκ
      rw [hκ, Finsupp.zero_apply]

    have hσ₀P_X : ∀ f : P₀, σ₀P ((Polynomial.X : Polynomial R₀) • f) = θ_P (σ₀P f) := by
      intro f
      ext κ m
      change σ₀_one (Polynomial.X * f κ) m = shift_one 1 (σ₀_one (f κ)) m
      have h_one : ∀ p : Polynomial R₀, σ₀_one (Polynomial.X * p) = shift_one 1 (σ₀_one p) := by
        intro p
        induction p using Polynomial.induction_on' with
        | add p₁ p₂ hp₁ hp₂ => rw [mul_add, map_add, map_add, hp₁, hp₂, map_add]
        | monomial s c =>
          have hXm : Polynomial.X * Polynomial.monomial s c = Polynomial.monomial (s + 1) c := by
            rw [← Polynomial.C_mul_X_pow_eq_monomial, ← Polynomial.C_mul_X_pow_eq_monomial,
              mul_left_comm, ← pow_succ']
          rw [hXm, hσ₀_mon, hσ₀_mon, hshift_single]
          exact congrArg (fun z => Finsupp.single z c) (by omega)
      rw [h_one]
    have hσ₁P_X : ∀ g : P₁, σ₁P ((Polynomial.X : Polynomial R₀) • g) = θ_P.symm (σ₁P g) := by
      intro g
      ext κ m
      change σ₁_one (Polynomial.X * g κ) m = (shift_one 1).symm (σ₁_one (g κ)) m
      have h_one : ∀ q : Polynomial R₀,
          σ₁_one (Polynomial.X * q) = (shift_one 1).symm (σ₁_one q) := by
        intro q
        induction q using Polynomial.induction_on' with
        | add q₁ q₂ hq₁ hq₂ => rw [mul_add, map_add, map_add, hq₁, hq₂, map_add]
        | monomial r c =>
          have hXm : Polynomial.X * Polynomial.monomial r c = Polynomial.monomial (r + 1) c := by
            rw [← Polynomial.C_mul_X_pow_eq_monomial, ← Polynomial.C_mul_X_pow_eq_monomial,
              mul_left_comm, ← pow_succ']
          rw [hXm, hσ₁_mon, hσ₁_mon]
          apply (shift_one 1).injective
          rw [LinearEquiv.apply_symm_apply, hshift_single]
          exact congrArg (fun z => Finsupp.single z c) (by omega)
      rw [h_one]

    let pi0 : P₀ →ₗ[Polynomial R₀] N₀ :=
      ∑ κ : ι, (LinearMap.toSpanSingleton (Polynomial R₀) N₀ (v_tilde κ)).comp (LinearMap.proj κ)
    let pi1 : P₁ →ₗ[Polynomial R₀] N₁ :=
      ∑ κ : ι, (LinearMap.toSpanSingleton (Polynomial R₀) N₁ (y_tilde κ)).comp (LinearMap.proj κ)
    have hpi0_surj : Function.Surjective pi0 := by
      rw [← LinearMap.range_eq_top, eq_top_iff, ← hS₀_span, Submodule.span_le]
      intro x hx
      let κ₀ : ι := Sum.inl ⟨x, hx⟩
      refine ⟨fun κ => if κ = κ₀ then 1 else 0, ?_⟩
      dsimp [pi0]
      simp only [LinearMap.sum_apply, LinearMap.comp_apply, LinearMap.toSpanSingleton_apply]
      rw [Finset.sum_eq_single κ₀]
      · change (if κ₀ = κ₀ then (1 : Polynomial R₀) else 0) • v_tilde κ₀ = x
        simp [κ₀, v_tilde]
      · intro κ _ hne
        change (if κ = κ₀ then (1 : Polynomial R₀) else 0) • v_tilde κ = 0
        simp [hne]
      · intro hnot; exact False.elim (hnot (Finset.mem_univ _))
    have hpi1_surj : Function.Surjective pi1 := by
      rw [← LinearMap.range_eq_top, eq_top_iff, ← hS₁_span, Submodule.span_le]
      intro y hy
      let κ₁ : ι := Sum.inr ⟨y, hy⟩
      refine ⟨fun κ => if κ = κ₁ then 1 else 0, ?_⟩
      dsimp [pi1]
      simp only [LinearMap.sum_apply, LinearMap.comp_apply, LinearMap.toSpanSingleton_apply]
      rw [Finset.sum_eq_single κ₁]
      · change (if κ₁ = κ₁ then (1 : Polynomial R₀) else 0) • y_tilde κ₁ = y
        simp [κ₁, y_tilde]
      · intro κ _ hne
        change (if κ = κ₁ then (1 : Polynomial R₀) else 0) • y_tilde κ = 0
        simp [hne]
      · intro hnot; exact False.elim (hnot (Finset.mem_univ _))

    let pi01_k (κ : ι) : (ℤ →₀ R₀) →ₗ[R₀] N₀₁ :=
      Finsupp.lsum R₀ (fun d : ℤ => LinearMap.toSpanSingleton R₀ N₀₁ ((θ_t ^ d) (σ₀ (v_tilde κ))))
    have hpi01_k_single : ∀ (κ : ι) (d : ℤ) (c : R₀),
        pi01_k κ (Finsupp.single d c) = c • ((θ_t ^ d) (σ₀ (v_tilde κ))) := by
      intro κ d c
      change (Finsupp.single d c).sum
        (fun i (r : R₀) => r • ((θ_t ^ i) (σ₀ (v_tilde κ)))) =
        c • ((θ_t ^ d) (σ₀ (v_tilde κ)))
      refine Finsupp.sum_single_index ?_
      exact zero_smul R₀ ((θ_t ^ d) (σ₀ (v_tilde κ)))
    let pi01 : P₀₁ →ₗ[R₀] N₀₁ :=
      ∑ κ : ι, (pi01_k κ).comp (LinearMap.proj κ)
    have hpi01_θ : ∀ h : P₀₁, pi01 (θ_P h) = θ_t (pi01 h) := by
      intro h
      dsimp [pi01, θ_P]
      simp only [LinearMap.sum_apply, LinearMap.comp_apply, map_sum]
      apply Finset.sum_congr rfl
      intro κ _
      change pi01_k κ (shift_one 1 (h κ)) = θ_t (pi01_k κ (h κ))
      refine Finsupp.induction (h κ) ?_ ?_
      · simp
      · intro d c u _ _ ih
        rw [map_add, map_add, map_add, map_add, ih, hshift_single]
        congr 1
        rw [hpi01_k_single, hpi01_k_single, map_smul]
        congr 1
        have hexp : d + 1 = (1 : ℤ) + d := by omega
        rw [hexp, zpow_add, zpow_one]
        rfl
    have hpi01_θ_symm : ∀ h : P₀₁, pi01 (θ_P.symm h) = θ_t.symm (pi01 h) := by
      intro h
      apply θ_t.injective
      rw [LinearEquiv.apply_symm_apply, ← hpi01_θ, LinearEquiv.apply_symm_apply]
    have hpi01_pos : ∀ (n : ℕ) (h : P₀₁), pi01 ((θ_P ^ (n : ℤ)) h) = (θ_t ^ (n : ℤ)) (pi01 h) := by
      intro n
      induction n with
      | zero => intro h; simp
      | succ n ih =>
        intro h
        have hexp : (((n + 1 : ℕ) : ℤ)) = (1 : ℤ) + (n : ℤ) := by omega
        rw [hexp, zpow_add, zpow_one, zpow_add, zpow_one]
        change pi01 (θ_P ((θ_P ^ (n : ℤ)) h)) = θ_t ((θ_t ^ (n : ℤ)) (pi01 h))
        rw [hpi01_θ, ih h]
    have hpi01_neg : ∀ (n : ℕ) (h : P₀₁),
        pi01 ((θ_P ^ (-(n : ℤ))) h) = (θ_t ^ (-(n : ℤ))) (pi01 h) := by
      intro n
      induction n with
      | zero => intro h; simp
      | succ n ih =>
        intro h
        have hexp : -(((n + 1 : ℕ) : ℤ)) = (-1 : ℤ) + -(n : ℤ) := by omega
        rw [hexp, zpow_add, zpow_neg_one, zpow_add, zpow_neg_one]
        change pi01 (θ_P.symm ((θ_P ^ (-(n : ℤ))) h)) = θ_t.symm ((θ_t ^ (-(n : ℤ))) (pi01 h))
        rw [hpi01_θ_symm, ih h]

    have hpi_comm₀ : ∀ f : P₀, pi01 (σ₀P f) = σ₀ (pi0 f) := by
      intro f
      dsimp [pi01, pi0, σ₀P]
      simp only [LinearMap.sum_apply, LinearMap.comp_apply,
        LinearMap.toSpanSingleton_apply, map_sum]
      apply Finset.sum_congr rfl
      intro κ _
      change pi01_k κ (σ₀_one (f κ)) = σ₀ ((f κ) • v_tilde κ)
      induction (f κ) using Polynomial.induction_on' with
      | add p₁ p₂ hp₁ hp₂ => rw [map_add, map_add, hp₁, hp₂, add_smul, map_add]
      | monomial s c =>
        rw [hσ₀_mon, hpi01_k_single, hθt_pos,
          ← Polynomial.C_mul_X_pow_eq_monomial, mul_smul,
          Polynomial.C_eq_algebraMap, algebraMap_smul, map_smul, hX_N₀, map_mul, map_pow]
    have hpi_comm₁ : ∀ g : P₁, pi01 (σ₁P g) = σ₁ (pi1 g) := by
      intro g
      dsimp [pi01, pi1, σ₁P]
      simp only [LinearMap.sum_apply, LinearMap.comp_apply,
        LinearMap.toSpanSingleton_apply, map_sum]
      apply Finset.sum_congr rfl
      intro κ _
      change pi01_k κ (σ₁_one (g κ)) = σ₁ ((g κ) • y_tilde κ)
      induction (g κ) using Polynomial.induction_on' with
      | add q₁ q₂ hq₁ hq₂ => rw [map_add, map_add, hq₁, hq₂, add_smul, map_add]
      | monomial r c =>
        rw [hσ₁_mon, hpi01_k_single,
          ← Polynomial.C_mul_X_pow_eq_monomial, mul_smul,
          Polynomial.C_eq_algebraMap, algebraMap_smul, map_smul, hX_N₁, map_mul, map_pow]
        congr 1
        have hexp : -(M : ℤ) - (r : ℤ) = -(r : ℤ) + -(M : ℤ) := by omega
        rw [hexp, zpow_add]
        change (θ_t ^ (-(r : ℤ))) ((θ_t ^ (-(M : ℤ))) (σ₀ (v_tilde κ))) = υ ^ r * σ₁ (y_tilde κ)
        rw [hv_y_rel κ, hθt_neg r]

    
    let K₀ : Submodule (Polynomial R₀) P₀ := LinearMap.ker pi0
    let K₁ : Submodule (Polynomial R₀) P₁ := LinearMap.ker pi1
    let K₀₁ : Submodule R₀ P₀₁ := LinearMap.ker pi01
    letI : AddCommGroup ↥K₀ := Submodule.addCommGroup K₀
    letI : AddCommGroup ↥K₁ := Submodule.addCommGroup K₁
    letI : AddCommGroup ↥K₀₁ := Submodule.addCommGroup K₀₁
    have : IsNoetherianRing (Polynomial R₀) := Polynomial.isNoetherianRing
    have : IsNoetherian (Polynomial R₀) P₀ := isNoetherian_pi
    have : Module.Finite (Polynomial R₀) ↥K₀ := Module.IsNoetherian.finite (Polynomial R₀) ↥K₀
    let θ_K : ↥K₀₁ ≃ₗ[R₀] ↥K₀₁ :=
      { toFun := fun h => ⟨θ_P h.1, by rw [LinearMap.mem_ker, hpi01_θ, h.2, map_zero]⟩
        map_add' := fun h₁ h₂ => Subtype.ext (map_add θ_P h₁.1 h₂.1)
        map_smul' := fun c h => Subtype.ext (map_smul θ_P c h.1)
        invFun := fun h => ⟨θ_P.symm h.1, by rw [LinearMap.mem_ker, hpi01_θ_symm, h.2, map_zero]⟩
        left_inv := fun h => Subtype.ext (θ_P.symm_apply_apply h.1)
        right_inv := fun h => Subtype.ext (θ_P.apply_symm_apply h.1) }
    have hθK_pos : ∀ (n : ℕ) (h : ↥K₀₁), ((θ_K ^ (n : ℤ)) h).1 = (θ_P ^ (n : ℤ)) h.1 := by
      intro n
      induction n with
      | zero => intro h; rfl
      | succ n ih =>
        intro h
        have hexp : (((n + 1 : ℕ) : ℤ)) = (1 : ℤ) + (n : ℤ) := by omega
        rw [hexp, zpow_add, zpow_one, zpow_add, zpow_one]
        exact congrArg θ_P (ih h)
    have hθK_neg : ∀ (n : ℕ) (h : ↥K₀₁), ((θ_K ^ (-(n : ℤ))) h).1 = (θ_P ^ (-(n : ℤ))) h.1 := by
      intro n
      induction n with
      | zero => intro h; rfl
      | succ n ih =>
        intro h
        have hexp : -(((n + 1 : ℕ) : ℤ)) = (-1 : ℤ) + -(n : ℤ) := by omega
        rw [hexp, zpow_add, zpow_neg_one, zpow_add, zpow_neg_one]
        exact congrArg θ_P.symm (ih h)
    let σ₀K : ↥K₀ →ₗ[R₀] ↥K₀₁ :=
      { toFun := fun f => ⟨σ₀P f.1, by rw [LinearMap.mem_ker, hpi_comm₀, f.2, map_zero]⟩
        map_add' := fun f₁ f₂ => Subtype.ext (map_add σ₀P f₁.1 f₂.1)
        map_smul' := fun c f => Subtype.ext (map_smul σ₀P c f.1) }
    let σ₁K : ↥K₁ →ₗ[R₀] ↥K₀₁ :=
      { toFun := fun g => ⟨σ₁P g.1, by rw [LinearMap.mem_ker, hpi_comm₁, g.2, map_zero]⟩
        map_add' := fun g₁ g₂ => Subtype.ext (map_add σ₁P g₁.1 g₂.1)
        map_smul' := fun c g => Subtype.ext (map_smul σ₁P c g.1) }
    have hσ₀K_X : ∀ f : ↥K₀, σ₀K ((Polynomial.X : Polynomial R₀) • f) = θ_K (σ₀K f) :=
      fun f => Subtype.ext (hσ₀P_X f.1)
    have hσ₁K_X : ∀ g : ↥K₁, σ₁K ((Polynomial.X : Polynomial R₀) • g) = θ_K.symm (σ₁K g) :=
      fun g => Subtype.ext (hσ₁P_X g.1)

    have habs₀_K : ∀ h : ↥K₀₁, ∃ n : ℕ, (θ_K ^ (n : ℤ)) h ∈ LinearMap.range σ₀K := by
      intro h
      let Supp : Finset ℤ := Finset.univ.biUnion (fun κ => (h.1 κ).support)
      let n₁ : ℕ := Supp.sup (fun d => (-d).toNat)
      let f₀ : P₀ := fun κ => (h.1 κ).sum (fun d c => Polynomial.monomial (d + (n₁ : ℤ)).toNat c)
      have hf₀_eq : σ₀P f₀ = (θ_P ^ (n₁ : ℤ)) h.1 := by
        ext κ m
        rw [hθP_pos n₁ h.1 κ]
        change σ₀_one ((h.1 κ).sum (fun d c => Polynomial.monomial (d + (n₁ : ℤ)).toNat c)) m =
          shift_one (n₁ : ℤ) (h.1 κ) m
        have hsupp_nonneg : ∀ d ∈ (h.1 κ).support, 0 ≤ d + (n₁ : ℤ) := by
          intro d hd
          have hmem : d ∈ Supp := Finset.mem_biUnion.mpr ⟨κ, Finset.mem_univ κ, hd⟩
          have hle : (-d).toNat ≤ n₁ := Finset.le_sup (f := fun z : ℤ => (-z).toNat) hmem
          omega
        have hmap : ∀ (u : ℤ →₀ R₀),
            (∀ d ∈ u.support, 0 ≤ d + (n₁ : ℤ)) →
            σ₀_one (u.sum (fun d c => Polynomial.monomial (d + (n₁ : ℤ)).toNat c)) =
              shift_one (n₁ : ℤ) u := by
          intro u
          refine Finsupp.induction u ?_ ?_
          · intro _; simp
          · intro d c v hdv hc0 ih hsupp
            have hd_in : d ∈ (Finsupp.single d c + v).support := by
              rw [Finsupp.mem_support_iff, Finsupp.add_apply, Finsupp.single_eq_same,
                Finsupp.notMem_support_iff.mp hdv, add_zero]
              exact hc0
            have hd_nn : 0 ≤ d + (n₁ : ℤ) := hsupp d hd_in
            have hv_nn : ∀ d' ∈ v.support, 0 ≤ d' + (n₁ : ℤ) := by
              intro d' hd'
              apply hsupp d'
              rw [Finsupp.mem_support_iff, Finsupp.add_apply]
              by_cases hdd : d = d'
              · subst hdd; exact False.elim (hdv hd')
              · rw [Finsupp.single_eq_of_ne (Ne.symm hdd), zero_add]
                exact Finsupp.mem_support_iff.mp hd'
            have hsingle₀ : (Finsupp.single d c).sum
                (fun d₀ c₀ => Polynomial.monomial (d₀ + (n₁ : ℤ)).toNat c₀) =
                Polynomial.monomial (d + (n₁ : ℤ)).toNat c :=
              Finsupp.sum_single_index (map_zero (Polynomial.monomial (d + (n₁ : ℤ)).toNat))
            rw [Finsupp.sum_add_index'
                (fun d₀ => map_zero (Polynomial.monomial (d₀ + (n₁ : ℤ)).toNat))
                (fun d₀ c₁ c₂ => map_add (Polynomial.monomial (d₀ + (n₁ : ℤ)).toNat) c₁ c₂),
              map_add, map_add, ih hv_nn, hsingle₀,
              hσ₀_mon, hshift_single, Int.toNat_of_nonneg hd_nn]
        rw [hmap (h.1 κ) hsupp_nonneg]
      have hσ₀_pi0 : σ₀ (pi0 f₀) = 0 := by
        rw [← hpi_comm₀, hf₀_eq, hpi01_pos, h.2, map_zero]
      obtain ⟨n₂, hn₂⟩ := hc3 (pi0 f₀) hσ₀_pi0
      have hk₀_mem : ((Polynomial.X ^ n₂ : Polynomial R₀) • f₀) ∈ K₀ := by
        rw [LinearMap.mem_ker, map_smul, hX_N₀]
        exact hn₂
      refine ⟨n₁ + n₂, ⟨(Polynomial.X ^ n₂ : Polynomial R₀) • f₀, hk₀_mem⟩, Subtype.ext ?_⟩
      change σ₀P ((Polynomial.X ^ n₂ : Polynomial R₀) • f₀) = ((θ_K ^ (((n₁ + n₂ : ℕ) : ℤ))) h).1
      rw [hθK_pos]
      have hpow : ∀ (s : ℕ) (f : P₀),
          σ₀P ((Polynomial.X ^ s : Polynomial R₀) • f) = (θ_P ^ (s : ℤ)) (σ₀P f) := by
        intro s
        induction s with
        | zero => intro f; simp
        | succ s ih =>
          intro f
          rw [pow_succ', mul_smul, hσ₀P_X, ih]
          have hexp : (((s + 1 : ℕ) : ℤ)) = (1 : ℤ) + (s : ℤ) := by omega
          rw [hexp, zpow_add, zpow_one]; rfl
      rw [hpow n₂ f₀, hf₀_eq]
      have hexp : (((n₁ + n₂ : ℕ) : ℤ)) = (n₂ : ℤ) + (n₁ : ℤ) := by omega
      rw [hexp, zpow_add]
      rfl

    have habs₁_K : ∀ h : ↥K₀₁, ∃ n : ℕ, (θ_K ^ (-(n : ℤ))) h ∈ LinearMap.range σ₁K := by
      intro h
      let Supp : Finset ℤ := Finset.univ.biUnion (fun κ => (h.1 κ).support)
      let n₁ : ℕ := Supp.sup (fun d => (d + (M : ℤ)).toNat)
      let g₁ : P₁ := fun κ =>
        (h.1 κ).sum (fun d c => Polynomial.monomial (-(M : ℤ) - (d - (n₁ : ℤ))).toNat c)
      have hg₁_eq : σ₁P g₁ = (θ_P ^ (-(n₁ : ℤ))) h.1 := by
        ext κ m
        rw [hθP_neg n₁ h.1 κ]
        change σ₁_one ((h.1 κ).sum (fun d c =>
            Polynomial.monomial (-(M : ℤ) - (d - (n₁ : ℤ))).toNat c)) m =
          shift_one (-(n₁ : ℤ)) (h.1 κ) m
        have hsupp_le : ∀ d ∈ (h.1 κ).support, d - (n₁ : ℤ) ≤ -(M : ℤ) := by
          intro d hd
          have hmem : d ∈ Supp := Finset.mem_biUnion.mpr ⟨κ, Finset.mem_univ κ, hd⟩
          have hle : (d + (M : ℤ)).toNat ≤ n₁ :=
            Finset.le_sup (f := fun z : ℤ => (z + (M : ℤ)).toNat) hmem
          omega
        have hmap : ∀ (u : ℤ →₀ R₀),
            (∀ d ∈ u.support, d - (n₁ : ℤ) ≤ -(M : ℤ)) →
            σ₁_one (u.sum (fun d c =>
                Polynomial.monomial (-(M : ℤ) - (d - (n₁ : ℤ))).toNat c)) =
              shift_one (-(n₁ : ℤ)) u := by
          intro u
          refine Finsupp.induction u ?_ ?_
          · intro _; simp
          · intro d c v hdv hc0 ih hsupp
            have hd_in : d ∈ (Finsupp.single d c + v).support := by
              rw [Finsupp.mem_support_iff, Finsupp.add_apply, Finsupp.single_eq_same,
                Finsupp.notMem_support_iff.mp hdv, add_zero]
              exact hc0
            have hd_le : d - (n₁ : ℤ) ≤ -(M : ℤ) := hsupp d hd_in
            have hv_le : ∀ d' ∈ v.support, d' - (n₁ : ℤ) ≤ -(M : ℤ) := by
              intro d' hd'
              apply hsupp d'
              rw [Finsupp.mem_support_iff, Finsupp.add_apply]
              by_cases hdd : d = d'
              · subst hdd; exact False.elim (hdv hd')
              · rw [Finsupp.single_eq_of_ne (Ne.symm hdd), zero_add]
                exact Finsupp.mem_support_iff.mp hd'
            have hsingle₁ : (Finsupp.single d c).sum
                (fun d₀ c₀ => Polynomial.monomial (-(M : ℤ) - (d₀ - (n₁ : ℤ))).toNat c₀) =
                Polynomial.monomial (-(M : ℤ) - (d - (n₁ : ℤ))).toNat c :=
              Finsupp.sum_single_index
                (map_zero (Polynomial.monomial (-(M : ℤ) - (d - (n₁ : ℤ))).toNat))
            rw [Finsupp.sum_add_index'
                (fun d₀ => map_zero (Polynomial.monomial (-(M : ℤ) - (d₀ - (n₁ : ℤ))).toNat))
                (fun d₀ c₁ c₂ =>
                  map_add (Polynomial.monomial (-(M : ℤ) - (d₀ - (n₁ : ℤ))).toNat) c₁ c₂),
              map_add, map_add, ih hv_le, hsingle₁,
              hσ₁_mon, hshift_single]
            congr 1
            exact congrArg (fun z => Finsupp.single z c) (by omega)
        rw [hmap (h.1 κ) hsupp_le]
      have hσ₁_pi1 : σ₁ (pi1 g₁) = 0 := by
        rw [← hpi_comm₁, hg₁_eq, hpi01_neg, h.2, map_zero]
      obtain ⟨n₂, hn₂⟩ := hc5 (pi1 g₁) hσ₁_pi1
      have hk₁_mem : ((Polynomial.X ^ n₂ : Polynomial R₀) • g₁) ∈ K₁ := by
        rw [LinearMap.mem_ker, map_smul, hX_N₁]
        exact hn₂
      refine ⟨n₁ + n₂, ⟨(Polynomial.X ^ n₂ : Polynomial R₀) • g₁, hk₁_mem⟩, Subtype.ext ?_⟩
      change σ₁P ((Polynomial.X ^ n₂ : Polynomial R₀) • g₁) = ((θ_K ^ (-(((n₁ + n₂ : ℕ) : ℤ)))) h).1
      rw [hθK_neg]
      have hpow : ∀ (s : ℕ) (g : P₁),
          σ₁P ((Polynomial.X ^ s : Polynomial R₀) • g) = (θ_P ^ (-(s : ℤ))) (σ₁P g) := by
        intro s
        induction s with
        | zero => intro g; simp
        | succ s ih =>
          intro g
          rw [pow_succ', mul_smul, hσ₁P_X, ih]
          have hexp : -(((s + 1 : ℕ) : ℤ)) = (-1 : ℤ) + -(s : ℤ) := by omega
          rw [hexp, zpow_add, zpow_neg_one]; rfl
      rw [hpow n₂ g₁, hg₁_eq]
      have hexp : -(((n₁ + n₂ : ℕ) : ℤ)) = -(n₂ : ℤ) + -(n₁ : ℤ) := by omega
      rw [hexp, zpow_add]
      rfl

    let δ_K : (↥K₀ × ↥K₁) →ₗ[R₀] ↥K₀₁ :=
      σ₀K.comp (LinearMap.fst R₀ ↥K₀ ↥K₁) - σ₁K.comp (LinearMap.snd R₀ ↥K₀ ↥K₁)
    have hFinH1_K : Module.Finite R₀ (↥K₀₁ ⧸ LinearMap.range δ_K) :=
      cech_H1_finite θ_K σ₀K σ₁K hσ₀K_X hσ₁K_X habs₀_K habs₁_K

    
    let pi_pair : (P₀ × P₁) →ₗ[R₀] (N₀ × N₁) :=
      (pi0.restrictScalars R₀).prodMap (pi1.restrictScalars R₀)
    let E_lift : Submodule R₀ (P₀ × P₁) := LinearMap.ker (δ.comp pi_pair)
    let proj_pair : ↥E_lift →ₗ[R₀] ↥(LinearMap.ker δ) :=
      { toFun := fun p => ⟨pi_pair p.1, p.2⟩
        map_add' := fun p₁ p₂ => Subtype.ext (map_add pi_pair p₁.1 p₂.1)
        map_smul' := fun c p => Subtype.ext (map_smul pi_pair c p.1) }
    have hproj_pair_surj : Function.Surjective proj_pair := by
      rintro ⟨⟨x₀, x₁⟩, hx⟩
      obtain ⟨f, rfl⟩ := hpi0_surj x₀
      obtain ⟨g, rfl⟩ := hpi1_surj x₁
      exact ⟨⟨(f, g), hx⟩, rfl⟩
    let φ_raw : ↥E_lift →ₗ[R₀] ↥K₀₁ :=
      { toFun := fun p =>
          ⟨σ₀P p.1.1 - σ₁P p.1.2, by
            rw [LinearMap.mem_ker, map_sub, hpi_comm₀, hpi_comm₁]
            exact p.2⟩
        map_add' := fun p₁ p₂ => Subtype.ext (by simp [sub_add_sub_comm])
        map_smul' := fun c p => Subtype.ext (by simp [smul_sub]) }
    let φ_diff : ↥E_lift →ₗ[R₀] (↥K₀₁ ⧸ LinearMap.range δ_K) :=
      (Submodule.mkQ (LinearMap.range δ_K)).comp φ_raw
    have hker_eq : LinearMap.ker proj_pair = LinearMap.ker φ_diff := by
      ext ⟨⟨f, g⟩, hfg⟩
      simp only [LinearMap.mem_ker, proj_pair, φ_diff, φ_raw, LinearMap.comp_apply,
        Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      constructor
      · intro h0
        have hf0 : pi0 f = 0 := congrArg Prod.fst ( congrArg Subtype.val h0 )
        have hg0 : pi1 g = 0 := congrArg Prod.snd ( congrArg Subtype.val h0 )
        exact ⟨(⟨f, hf0⟩, ⟨g, hg0⟩), rfl⟩
      · rintro ⟨⟨k₀, k₁⟩, hk⟩
        have hsub : σ₀P k₀.1 - σ₁P k₁.1 = σ₀P f - σ₁P g := congrArg Subtype.val hk
        have heq : σ₀P (f - k₀.1) = σ₁P (g - k₁.1) := by
          rw [map_sub, map_sub]
          exact sub_eq_sub_iff_sub_eq_sub.mp hsub.symm
        obtain ⟨hf_eq, hg_eq⟩ := hH0_P_vanish (f - k₀.1) (g - k₁.1) heq
        have hf : f = k₀.1 := sub_eq_zero.mp hf_eq
        have hg : g = k₁.1 := sub_eq_zero.mp hg_eq
        apply Subtype.ext
        exact Prod.ext (hf ▸ k₀.2) (hg ▸ k₁.2)
    have : IsNoetherian R₀ (↥K₀₁ ⧸ LinearMap.range δ_K) :=
      isNoetherian_of_isNoetherianRing_of_finite (R := R₀) (M := ↥K₀₁ ⧸ LinearMap.range δ_K)
    have : Module.Finite R₀ ↥(LinearMap.range φ_diff) :=
      Module.IsNoetherian.finite R₀ ↥(LinearMap.range φ_diff)
    let e_ker : ↥(LinearMap.ker δ) ≃ₗ[R₀] ↥(LinearMap.range φ_diff) :=
      ((proj_pair.quotKerEquivOfSurjective hproj_pair_surj).symm.trans
        (Submodule.quotEquivOfEq _ _ hker_eq)).trans φ_diff.quotKerEquivRange
    have hFinH0 : Module.Finite R₀ ↥(LinearMap.ker δ) :=
      Module.Finite.equiv e_ker.symm
    exact ⟨hFinH0, hFinH1⟩

  
  let δ_A : (M₀ × M₁) →ₗ[A] M₀₁ :=
    ρ₀.toLinearMap.comp (LinearMap.fst A M₀ M₁) -
    ρ₁.toLinearMap.comp (LinearMap.snd A M₀ M₁)
  have hFinKerA : Module.Finite A ↥(LinearMap.ker δ_A) :=
    (cech_both_finite A M₀ M₁ M₀₁ ρ₀ ρ₁ hR1 hR2 hR3 hR4 hR5).1
  let toKerA : B →ₗ[A] ↥(LinearMap.ker δ_A) :=
    { toFun := fun b => ⟨(i₀ b, i₁ b), sub_eq_zero.mpr (hEq_comm b)⟩
      map_add' := fun b₁ b₂ => Subtype.ext (Prod.ext (map_add i₀ b₁ b₂) (map_add i₁ b₁ b₂))
      map_smul' := fun a b => Subtype.ext (Prod.ext (i₀.toLinearMap.map_smul a b)
        (i₁.toLinearMap.map_smul a b)) }
  have htoKerA_bij : Function.Bijective toKerA := by
    refine ⟨?_, ?_⟩
    · intro b₁ b₂ heq
      have h0 : i₀ b₁ = i₀ b₂ := congrArg (Prod.fst ∘ Subtype.val) heq
      have h1 : i₁ b₁ = i₁ b₂ := congrArg (Prod.snd ∘ Subtype.val) heq
      exact hEq_inj b₁ b₂ h0 h1
    · rintro ⟨⟨x₀, x₁⟩, hx⟩
      obtain ⟨b, hb₀, hb₁⟩ := hEq_surj x₀ x₁ (sub_eq_zero.mp hx)
      exact ⟨b, Subtype.ext (Prod.ext hb₀ hb₁)⟩
  have hFinB : Module.Finite A B :=
    Module.Finite.equiv (LinearEquiv.ofBijective toKerA htoKerA_bij).symm
  
  
  
  have ama_sum_single : ∀ {S : Type u} [CommRing S] (f : AddMonoidAlgebra S ℤ),
      f.coeff.sum (fun d s => AddMonoidAlgebra.single d s) = f := by
    intro S _ f
    have h_u : ∀ (u : ℤ →₀ S) (m : ℤ),
        (u.sum (fun d s => AddMonoidAlgebra.single d s)).coeff m = u m := by
      intro u
      refine Finsupp.induction u ?_ ?_
      · intro m; rfl
      · intro a b v hav hb0 ih m
        rw [Finsupp.sum_add_index' (fun _ => AddMonoidAlgebra.single_zero _)
            (fun _ _ _ => AddMonoidAlgebra.single_add _ _ _)]
        change ((Finsupp.single a b).sum (fun d s => AddMonoidAlgebra.single d s)).coeff m +
          (v.sum (fun d s => AddMonoidAlgebra.single d s)).coeff m = _
        rw [Finsupp.sum_single_index (AddMonoidAlgebra.single_zero _), ih m]
        rfl
    ext m
    exact h_u f.coeff m

  have ama_alg_eq : ∀ {S : Type u} [CommRing S] (s : S),
      algebraMap S (AddMonoidAlgebra S ℤ) s = AddMonoidAlgebra.single 0 s := by
    intro S _ s
    rw [Algebra.algebraMap_eq_smul_one]
    change s • AddMonoidAlgebra.single (0 : ℤ) (1 : S) = AddMonoidAlgebra.single 0 s
    ext m
    change (s • Finsupp.single (0 : ℤ) (1 : S)) m = Finsupp.single (0 : ℤ) s m
    rw [Finsupp.smul_single, smul_eq_mul, mul_one]

  have ama_single_same : ∀ {S : Type u} [CommRing S] (d : ℤ) (s : S),
      (AddMonoidAlgebra.single d s).coeff d = s := by
    intro S _ d s
    change Finsupp.single d s d = s
    exact Finsupp.single_eq_same

  have ama_single_ne : ∀ {S : Type u} [CommRing S] {d m : ℤ} (s : S),
      d ≠ m → (AddMonoidAlgebra.single d s).coeff m = 0 := by
    intro S _ d m s hne
    change Finsupp.single d s m = 0
    exact Finsupp.single_eq_of_ne hne.symm

  let reesSubalgebra (S : Type u) [CommRing S] (J : Ideal S) :
      Subalgebra S (AddMonoidAlgebra S ℤ) :=
    { carrier := { f : AddMonoidAlgebra S ℤ | ∀ n : ℕ, f.coeff (n : ℤ) ∈ J ^ n }
      mul_mem' := fun {f g} hf hg => by
        have h_single_mem : ∀ (u : AddMonoidAlgebra S ℤ),
            (∀ n : ℕ, u.coeff (n : ℤ) ∈ J ^ n) →
            ∀ (a : ℤ) (b : ℤ),
              (∀ n : ℕ, (AddMonoidAlgebra.single b (g.coeff b)).coeff (n : ℤ) ∈ J ^ n) →
              ∀ n : ℕ,
                (AddMonoidAlgebra.single a (u.coeff a) *
                  AddMonoidAlgebra.single b (g.coeff b)).coeff (n : ℤ) ∈ J ^ n := by
          intro u hu a b _ n
          rw [AddMonoidAlgebra.single_mul_single]
          by_cases hab : a + b = (n : ℤ)
          · rw [hab, ama_single_same]
            by_cases ha0 : 0 ≤ a
            · by_cases hb0 : 0 ≤ b
              · let p : ℕ := a.toNat
                let q : ℕ := b.toNat
                have hap : (p : ℤ) = a := Int.toNat_of_nonneg ha0
                have hbq : (q : ℤ) = b := Int.toNat_of_nonneg hb0
                have hpq : p + q = n := by omega
                rw [← hpq, pow_add, ← hap, ← hbq]
                exact Ideal.mul_mem_mul (hu p) (hg q)
              · let p : ℕ := a.toNat
                have hap : (p : ℤ) = a := Int.toNat_of_nonneg ha0
                have hnp : n ≤ p := by omega
                rw [← hap]
                exact Ideal.mul_mem_right _ _ (Ideal.pow_le_pow_right hnp (hu p))
            · let q : ℕ := b.toNat
              have hbq : (q : ℤ) = b := by omega
              have hnq : n ≤ q := by omega
              rw [← hbq]
              exact Ideal.mul_mem_left _ _ (Ideal.pow_le_pow_right hnq (hg q))
          · rw [ama_single_ne _ hab]
            exact zero_mem _
        have h_hom_g : ∀ b : ℤ, ∀ n : ℕ,
            (AddMonoidAlgebra.single b (g.coeff b)).coeff (n : ℤ) ∈ J ^ n := by
          intro b n
          by_cases hbn : b = (n : ℤ)
          · subst hbn; rw [ama_single_same]; exact hg n
          · rw [ama_single_ne _ hbn]; exact zero_mem _
        rw [← ama_sum_single f, ← ama_sum_single g, Finsupp.sum, Finsupp.sum, Finset.sum_mul]
        intro n
        have h_fin_sum : ∀ (s : Finset ℤ) (φ : ℤ → AddMonoidAlgebra S ℤ),
            (∀ x ∈ s, (φ x).coeff (n : ℤ) ∈ J ^ n) →
            (∑ x ∈ s, φ x).coeff (n : ℤ) ∈ J ^ n := by
          intro s φ hφ
          induction s using Finset.cons_induction with
          | empty => exact zero_mem _
          | cons x s hxs ih =>
            rw [Finset.sum_cons]
            exact add_mem (hφ x (Finset.mem_cons_self x s))
              (ih (fun y hy => hφ y (Finset.mem_cons_of_mem hy)))
        apply h_fin_sum f.coeff.support
        intro a _
        rw [Finset.mul_sum]
        apply h_fin_sum g.coeff.support
        intro b _
        exact h_single_mem f hf a b (h_hom_g b) n
      one_mem' := fun n => by
        cases n with
        | zero => rw [pow_zero, Ideal.one_eq_top]; trivial
        | succ m =>
          change (AddMonoidAlgebra.single (0 : ℤ) (1 : S)).coeff (((m + 1 : ℕ) : ℤ)) ∈ J ^ (m + 1)
          have hne : (0 : ℤ) ≠ (((m + 1 : ℕ) : ℤ)) := by omega
          rw [ama_single_ne _ hne]
          exact zero_mem _
      add_mem' := fun {f g} hf hg n => add_mem (hf n) (hg n)
      zero_mem' := fun n => zero_mem _
      algebraMap_mem' := fun s n => by
        rw [ama_alg_eq]
        cases n with
        | zero => rw [pow_zero, Ideal.one_eq_top]; trivial
        | succ m =>
          have hne : (0 : ℤ) ≠ (((m + 1 : ℕ) : ℤ)) := by omega
          rw [ama_single_ne _ hne]
          exact zero_mem _ }

  
  let amaMap {S₁ S₂ : Type u} [CommRing S₁] [CommRing S₂] (φ : S₁ →+* S₂) :
      AddMonoidAlgebra S₁ ℤ →+* AddMonoidAlgebra S₂ ℤ :=
    { toFun := fun f => f.coeff.sum (fun d s => AddMonoidAlgebra.single d (φ s))
      map_zero' := Finsupp.sum_zero_index
      map_add' := fun f g =>
        Finsupp.sum_add_index'
          (fun _ => by rw [map_zero, AddMonoidAlgebra.single_zero])
          (fun _ _ _ => by rw [map_add, AddMonoidAlgebra.single_add])
      map_one' := by
        change (Finsupp.single (0 : ℤ) (1 : S₁)).sum
          (fun d s => AddMonoidAlgebra.single d (φ s)) = AddMonoidAlgebra.single 0 1
        rw [Finsupp.sum_single_index (by rw [map_zero, AddMonoidAlgebra.single_zero]), map_one]
      map_mul' := fun f g => by
        conv_lhs => rw [← ama_sum_single f, ← ama_sum_single g]
        let mapFn : AddMonoidAlgebra S₁ ℤ →+ AddMonoidAlgebra S₂ ℤ :=
          { toFun := fun x => x.coeff.sum (fun d s => AddMonoidAlgebra.single d (φ s))
            map_zero' := Finsupp.sum_zero_index
            map_add' := fun x y =>
              Finsupp.sum_add_index'
                (fun _ => by rw [map_zero, AddMonoidAlgebra.single_zero])
                (fun _ _ _ => by rw [map_add, AddMonoidAlgebra.single_add]) }
        change mapFn (f.coeff.sum AddMonoidAlgebra.single * g.coeff.sum AddMonoidAlgebra.single) =
          mapFn f * mapFn g
        conv_rhs => rw [← ama_sum_single f, ← ama_sum_single g]
        simp only [Finsupp.sum, Finset.sum_mul, Finset.mul_sum, map_sum]
        apply Finset.sum_congr rfl
        intro a _
        apply Finset.sum_congr rfl
        intro b _
        have hs : ∀ (d : ℤ) (s : S₁),
            mapFn (AddMonoidAlgebra.single d s) = AddMonoidAlgebra.single d (φ s) := by
          intro d s
          change (Finsupp.single d s).sum (fun d' s' => AddMonoidAlgebra.single d' (φ s')) =
            AddMonoidAlgebra.single d (φ s)
          exact Finsupp.sum_single_index (by rw [map_zero, AddMonoidAlgebra.single_zero])
        rw [AddMonoidAlgebra.single_mul_single, hs, hs, hs,
          AddMonoidAlgebra.single_mul_single, map_mul] }

  have hamaMap_coeff : ∀ {S₁ S₂ : Type u} [CommRing S₁] [CommRing S₂] (φ : S₁ →+* S₂)
      (f : AddMonoidAlgebra S₁ ℤ) (m : ℤ),
      (amaMap φ f).coeff m = φ (f.coeff m) := by
    intro S₁ S₂ _ _ φ f m
    change (f.coeff.sum (fun d s => AddMonoidAlgebra.single d (φ s))).coeff m = φ (f.coeff m)
    refine Finsupp.induction f.coeff ?_ ?_
    · simp
    · intro a b v _ _ ih
      rw [Finsupp.sum_add_index'
          (fun _ => by rw [map_zero, AddMonoidAlgebra.single_zero])
          (fun _ _ _ => by rw [map_add, AddMonoidAlgebra.single_add])]
      change ((Finsupp.single a b).sum (fun d s => AddMonoidAlgebra.single d (φ s))).coeff m +
        (v.sum (fun d s => AddMonoidAlgebra.single d (φ s))).coeff m =
        φ (Finsupp.single a b m + v m)
      rw [Finsupp.sum_single_index (by rw [map_zero, AddMonoidAlgebra.single_zero]), ih, map_add]
      congr 1
      change Finsupp.single a (φ b) m = φ (Finsupp.single a b m)
      by_cases ham : a = m
      · subst ham; simp
      · simp [ham]

  have hamaMap_single : ∀ {S₁ S₂ : Type u} [CommRing S₁] [CommRing S₂] (φ : S₁ →+* S₂)
      (d : ℤ) (s : S₁),
      amaMap φ (AddMonoidAlgebra.single d s) = AddMonoidAlgebra.single d (φ s) := by
    intro S₁ S₂ _ _ φ d s
    change (Finsupp.single d s).sum (fun d' s' => AddMonoidAlgebra.single d' (φ s')) =
      AddMonoidAlgebra.single d (φ s)
    exact Finsupp.sum_single_index (by rw [map_zero, AddMonoidAlgebra.single_zero])

  let reesMap {S₁ S₂ : Type u} [CommRing S₁] [CommRing S₂] {J₁ : Ideal S₁} {J₂ : Ideal S₂}
      (φ : S₁ →+* S₂) (hJ : Ideal.map φ J₁ ≤ J₂) :
      ↥(reesSubalgebra S₁ J₁) →+* ↥(reesSubalgebra S₂ J₂) :=
    { toFun := fun f =>
        ⟨amaMap φ f.1, fun n => by
          rw [hamaMap_coeff]
          have hmem : φ (f.1.coeff (n : ℤ)) ∈ Ideal.map φ (J₁ ^ n) :=
            Ideal.mem_map_of_mem φ (f.2 n)
          rw [Ideal.map_pow] at hmem
          exact Ideal.pow_right_mono hJ n hmem⟩
      map_one' := Subtype.ext (map_one (amaMap φ))
      map_mul' := fun f g => Subtype.ext (map_mul (amaMap φ) f.1 g.1)
      map_zero' := Subtype.ext (map_zero (amaMap φ))
      map_add' := fun f g => Subtype.ext (map_add (amaMap φ) f.1 g.1) }

  
  let R_Rees : Type u := ↥(reesSubalgebra A 𝔪)
  obtain ⟨S_𝔪, hS_𝔪⟩ := Ideal.fg_of_isNoetherianRing 𝔪
  let G_Rees : Set (AddMonoidAlgebra A ℤ) :=
    insert (AddMonoidAlgebra.single (-1 : ℤ) (1 : A))
      ((fun a : A => AddMonoidAlgebra.single (1 : ℤ) a) '' (S_𝔪 : Set A))
  have hG_Rees_fin : G_Rees.Finite :=
    Set.Finite.insert _ (S_𝔪.finite_toSet.image _)
  have hu_pow : ∀ {S : Type u} [CommRing S] (m : ℕ),
      (AddMonoidAlgebra.single (-1 : ℤ) (1 : S)) ^ m =
        AddMonoidAlgebra.single (-(m : ℤ)) (1 : S) := by
    intro S _ m
    induction m with
    | zero => simp
    | succ m ih =>
      rw [pow_succ', ih, AddMonoidAlgebra.single_mul_single, mul_one]
      exact congrArg (fun z => AddMonoidAlgebra.single z (1 : S)) (by omega)
  have hRees_eq_adjoin : reesSubalgebra A 𝔪 = Algebra.adjoin A G_Rees := by
    apply le_antisymm
    · intro f hf
      let A_adj := Algebra.adjoin A G_Rees
      have h_neg : ∀ (m : ℕ) (c : A), AddMonoidAlgebra.single (-(m : ℤ)) c ∈ A_adj := by
        intro m c
        have hu_mem : AddMonoidAlgebra.single (-1 : ℤ) (1 : A) ∈ A_adj :=
          Algebra.subset_adjoin (Set.mem_insert _ _)
        have hmul : algebraMap A (AddMonoidAlgebra A ℤ) c *
            (AddMonoidAlgebra.single (-1 : ℤ) (1 : A)) ^ m =
            AddMonoidAlgebra.single (-(m : ℤ)) c := by
          rw [ama_alg_eq, hu_pow, AddMonoidAlgebra.single_mul_single, zero_add, mul_one]
        rw [← hmul]
        exact mul_mem (A_adj.algebraMap_mem c) (pow_mem hu_mem m)
      have h_pos1 : ∀ a ∈ 𝔪, AddMonoidAlgebra.single (1 : ℤ) a ∈ A_adj := by
        intro a ha
        rw [← hS_𝔪] at ha
        refine Submodule.span_induction
          (p := fun x _ => AddMonoidAlgebra.single (1 : ℤ) x ∈ A_adj) ?_ ?_ ?_ ?_ ha
        · intro x hx
          exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ ⟨x, hx, rfl⟩)
        · rw [AddMonoidAlgebra.single_zero]; exact zero_mem A_adj
        · intro x y _ _ ihx ihy
          rw [AddMonoidAlgebra.single_add]; exact add_mem ihx ihy
        · intro r x _ ihx
          have hsmul : AddMonoidAlgebra.single (1 : ℤ) (r • x) =
              algebraMap A (AddMonoidAlgebra A ℤ) r * AddMonoidAlgebra.single (1 : ℤ) x := by
            rw [ama_alg_eq, AddMonoidAlgebra.single_mul_single, zero_add, smul_eq_mul]
          rw [hsmul]
          exact mul_mem (A_adj.algebraMap_mem r) ihx
      have h_pos : ∀ (n : ℕ) (c : A), c ∈ 𝔪 ^ n → AddMonoidAlgebra.single (n : ℤ) c ∈ A_adj := by
        intro n
        induction n with
        | zero =>
          intro c _
          rw [Nat.cast_zero, ← ama_alg_eq]
          exact A_adj.algebraMap_mem c
        | succ n ih =>
          intro c hc
          rw [pow_succ'] at hc
          refine Submodule.mul_induction_on hc ?_ ?_
          · intro a ha b hb
            have hmul : AddMonoidAlgebra.single (((n + 1 : ℕ) : ℤ)) (a * b) =
                AddMonoidAlgebra.single (1 : ℤ) a * AddMonoidAlgebra.single (n : ℤ) b := by
              rw [AddMonoidAlgebra.single_mul_single]
              exact congrArg (fun z => AddMonoidAlgebra.single z (a * b)) (by omega)
            rw [hmul]
            exact mul_mem (h_pos1 a ha) (ih b hb)
          · intro x y hx hy
            rw [AddMonoidAlgebra.single_add]
            exact add_mem hx hy
      rw [← ama_sum_single f, Finsupp.sum]
      apply sum_mem
      intro d _
      by_cases hd : 0 ≤ d
      · let n : ℕ := d.toNat
        have hdn : (n : ℤ) = d := Int.toNat_of_nonneg hd
        rw [← hdn]
        exact h_pos n (f.coeff (n : ℤ)) (hf n)
      · let m : ℕ := (-d).toNat
        have hdm : -(m : ℤ) = d := by omega
        rw [← hdm]
        exact h_neg m (f.coeff (-(m : ℤ)))
    · rw [Algebra.adjoin_le_iff]
      rintro g (rfl | ⟨a, ha, rfl⟩)
      · intro n
        have hne : (-1 : ℤ) ≠ (n : ℤ) := by omega
        rw [ama_single_ne _ hne]
        exact zero_mem _
      · intro n
        dsimp only
        by_cases hn1 : (1 : ℤ) = (n : ℤ)
        · have hn_eq : n = 1 := by omega
          rw [← hn1, hn_eq, ama_single_same, pow_one, ← hS_𝔪]
          exact Submodule.subset_span ha
        · rw [ama_single_ne _ hn1]
          exact zero_mem _

  have hFT_Rees : Algebra.FiniteType A R_Rees :=
    Algebra.FiniteType.equiv (Algebra.FiniteType.adjoin_of_finite hG_Rees_fin)
      (Subalgebra.equivOfEq _ _ hRees_eq_adjoin).symm
  have hNoeth_Rees : IsNoetherianRing R_Rees :=
    Algebra.FiniteType.isNoetherianRing A R_Rees

  
  let J_B : Ideal B := Ideal.map (algebraMap A B) 𝔪
  let J₀ : Ideal M₀ := Ideal.map (algebraMap A M₀) 𝔪
  let J₁ : Ideal M₁ := Ideal.map (algebraMap A M₁) 𝔪
  let J₀₁ : Ideal M₀₁ := Ideal.map (algebraMap A M₀₁) 𝔪
  let M0_rees : Type u := ↥(reesSubalgebra M₀ J₀)
  let M1_rees : Type u := ↥(reesSubalgebra M₁ J₁)
  let M01_rees : Type u := ↥(reesSubalgebra M₀₁ J₀₁)

  letI : Algebra R_Rees M0_rees := (reesMap (algebraMap A M₀) le_rfl).toAlgebra
  letI : Algebra R_Rees M1_rees := (reesMap (algebraMap A M₁) le_rfl).toAlgebra
  letI : Algebra R_Rees M01_rees := (reesMap (algebraMap A M₀₁) le_rfl).toAlgebra
  letI : Module R_Rees M0_rees := Algebra.toModule
  letI : Module R_Rees M1_rees := Algebra.toModule
  letI : Module R_Rees M01_rees := Algebra.toModule

  have hJ₀_map : Ideal.map ρ₀.toRingHom J₀ ≤ J₀₁ := by
    rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
    intro a ha
    simp only [Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, ρ₀.commutes]
    exact Ideal.mem_map_of_mem _ ha
  have hJ₁_map : Ideal.map ρ₁.toRingHom J₁ ≤ J₀₁ := by
    rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
    intro a ha
    simp only [Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, ρ₁.commutes]
    exact Ideal.mem_map_of_mem _ ha

  let ρ0_rees : M0_rees →ₐ[R_Rees] M01_rees :=
    { toRingHom := reesMap ρ₀.toRingHom hJ₀_map
      commutes' := fun r => by
        apply Subtype.ext
        ext m
        change (amaMap ρ₀.toRingHom (amaMap (algebraMap A M₀) r.1)).coeff m =
          (amaMap (algebraMap A M₀₁) r.1).coeff m
        rw [hamaMap_coeff, hamaMap_coeff, hamaMap_coeff]
        exact ρ₀.commutes (r.1.coeff m) }
  let ρ1_rees : M1_rees →ₐ[R_Rees] M01_rees :=
    { toRingHom := reesMap ρ₁.toRingHom hJ₁_map
      commutes' := fun r => by
        apply Subtype.ext
        ext m
        change (amaMap ρ₁.toRingHom (amaMap (algebraMap A M₁) r.1)).coeff m =
          (amaMap (algebraMap A M₀₁) r.1).coeff m
        rw [hamaMap_coeff, hamaMap_coeff, hamaMap_coeff]
        exact ρ₁.commutes (r.1.coeff m) }

  let mkConst {S : Type u} [CommRing S] (J : Ideal S) (s : S) : ↥(reesSubalgebra S J) :=
    ⟨AddMonoidAlgebra.single 0 s, fun n => by
      rw [← ama_alg_eq]
      exact (reesSubalgebra S J).algebraMap_mem s n⟩
  let t₀ : M₀ := algebraMap (Polynomial A) M₀ Polynomial.X
  let u₁ : M₁ := algebraMap (Polynomial A) M₁ Polynomial.X
  let t0_rees : M0_rees := mkConst J₀ t₀
  let u1_rees : M1_rees := mkConst J₁ u₁

  letI : Algebra (Polynomial R_Rees) M0_rees :=
    (Polynomial.aeval (R := R_Rees) t0_rees).toRingHom.toAlgebra
  have : IsScalarTower R_Rees (Polynomial R_Rees) M0_rees :=
    IsScalarTower.of_algebraMap_eq (fun r => (Polynomial.aeval_C t0_rees r).symm)
  letI : Algebra (Polynomial R_Rees) M1_rees :=
    (Polynomial.aeval (R := R_Rees) u1_rees).toRingHom.toAlgebra
  have : IsScalarTower R_Rees (Polynomial R_Rees) M1_rees :=
    IsScalarTower.of_algebraMap_eq (fun r => (Polynomial.aeval_C u1_rees r).symm)

  have hX_M0_rees : algebraMap (Polynomial R_Rees) M0_rees Polynomial.X = t0_rees :=
    Polynomial.aeval_X t0_rees
  have hX_M1_rees : algebraMap (Polynomial R_Rees) M1_rees Polynomial.X = u1_rees :=
    Polynomial.aeval_X u1_rees

  
  have hReesChartFinite : ∀ (N : Type u) [CommRing N] [Algebra A N] [Algebra (Polynomial A) N]
      [IsScalarTower A (Polynomial A) N] [Module.Finite (Polynomial A) N],
      let JN : Ideal N := Ideal.map (algebraMap A N) 𝔪
      let N_rees : Type u := ↥(reesSubalgebra N JN)
      letI : Algebra R_Rees N_rees := (reesMap (algebraMap A N) le_rfl).toAlgebra
      let xN : N := algebraMap (Polynomial A) N Polynomial.X
      let xN_rees : N_rees := mkConst JN xN
      letI : Algebra (Polynomial R_Rees) N_rees :=
        (Polynomial.aeval (R := R_Rees) xN_rees).toRingHom.toAlgebra
      Module.Finite (Polynomial R_Rees) N_rees := by
    intro N _ _ _ _ _
    let JN : Ideal N := Ideal.map (algebraMap A N) 𝔪
    let N_rees : Type u := ↥(reesSubalgebra N JN)
    letI : Algebra R_Rees N_rees := (reesMap (algebraMap A N) le_rfl).toAlgebra
    let xN : N := algebraMap (Polynomial A) N Polynomial.X
    let xN_rees : N_rees := mkConst JN xN
    letI : Algebra (Polynomial R_Rees) N_rees :=
      (Polynomial.aeval (R := R_Rees) xN_rees).toRingHom.toAlgebra
    have : IsScalarTower R_Rees (Polynomial R_Rees) N_rees :=
      IsScalarTower.of_algebraMap_eq (fun r => (Polynomial.aeval_C xN_rees r).symm)
    obtain ⟨SN, hSN_span⟩ := Module.Finite.fg_top (R := Polynomial A) (M := N)
    let genN : ↥SN → N_rees := fun v => mkConst JN v.1
    let WN : Submodule (Polynomial R_Rees) N_rees := Submodule.span (Polynomial R_Rees) (Set.range genN)
    have mem_WN_of_val_eq : ∀ {u₁ u₂ : N_rees}, u₁.1 = u₂.1 → u₂ ∈ WN → u₁ ∈ WN :=
      fun h hm => Subtype.ext h ▸ hm
    let mkMulN (d : ℤ) (c : A)
        (hc : ∀ n : ℕ, (AddMonoidAlgebra.single d c).coeff (n : ℤ) ∈ 𝔪 ^ n)
        (x : N) : N_rees :=
      ⟨AddMonoidAlgebra.single d (algebraMap A N c * x), fun n => by
        by_cases hdn : d = (n : ℤ)
        · subst hdn; rw [ama_single_same]
          have hc_mem : c ∈ 𝔪 ^ n := by have h1 := hc n; rwa [ama_single_same] at h1
          have hmap : algebraMap A N c ∈ JN ^ n := by
            rw [← Ideal.map_pow]; exact Ideal.mem_map_of_mem _ hc_mem
          exact Ideal.mul_mem_right _ _ hmap
        · rw [ama_single_ne _ hdn]; exact zero_mem _⟩
    let mkPosN (n : ℕ) (y : N) (hy : y ∈ Ideal.map (algebraMap A N) (𝔪 ^ n)) (mN : N) : N_rees :=
      ⟨AddMonoidAlgebra.single (n : ℤ) (mN * y), fun k => by
        by_cases hnk : (n : ℤ) = (k : ℤ)
        · have h_eq : n = k := by omega
          rw [← hnk, ← h_eq, ama_single_same, ← Ideal.map_pow]
          exact Ideal.mul_mem_left _ _ hy
        · rw [ama_single_ne _ hnk]; exact zero_mem _⟩
    have hxN_pow : ∀ k : ℕ, (xN_rees ^ k).1 = AddMonoidAlgebra.single 0 (xN ^ k) := by
      intro k
      induction k with
      | zero => simp
      | succ k ihk =>
        change (xN_rees ^ k * xN_rees).1 = _
        change (xN_rees ^ k).1 * AddMonoidAlgebra.single 0 xN = _
        rw [ihk, AddMonoidAlgebra.single_mul_single, add_zero, pow_succ]
    have h_mul_span : ∀ (d : ℤ) (c : A)
        (hc : ∀ n : ℕ, (AddMonoidAlgebra.single d c).coeff (n : ℤ) ∈ 𝔪 ^ n)
        (x : N),
        mkMulN d c hc x ∈ WN := by
      intro d c hc x
      have hx_mem : x ∈ Submodule.span (Polynomial A) (SN : Set N) := by
        rw [hSN_span]; trivial
      refine Submodule.span_induction
        (p := fun x _ => ∀ (c' : A)
          (hc' : ∀ n : ℕ, (AddMonoidAlgebra.single d c').coeff (n : ℤ) ∈ 𝔪 ^ n),
          mkMulN d c' hc' x ∈ WN)
        ?_ ?_ ?_ ?_ hx_mem c hc
      · intro v hv c' hc'
        let r_c : R_Rees := ⟨AddMonoidAlgebra.single d c', hc'⟩
        refine mem_WN_of_val_eq (u₂ := r_c • genN ⟨v, hv⟩) ?_ ?_
        · change AddMonoidAlgebra.single d (algebraMap A N c' * v) =
            amaMap (algebraMap A N) (AddMonoidAlgebra.single d c') * AddMonoidAlgebra.single 0 v
          rw [hamaMap_single, AddMonoidAlgebra.single_mul_single, add_zero]
        · rw [← algebraMap_smul (Polynomial R_Rees)]
          exact WN.smul_mem _ (Submodule.subset_span ⟨⟨v, hv⟩, rfl⟩)
      · intro c' _
        refine mem_WN_of_val_eq (u₂ := 0) ?_ (zero_mem WN)
        change AddMonoidAlgebra.single d (algebraMap A N c' * 0) = 0
        simp
      · intro x₁ x₂ _ _ ih₁ ih₂ c' hc'
        refine mem_WN_of_val_eq (u₂ := mkMulN d c' hc' x₁ + mkMulN d c' hc' x₂) ?_
          (add_mem (ih₁ c' hc') (ih₂ c' hc'))
        change AddMonoidAlgebra.single d (algebraMap A N c' * (x₁ + x₂)) =
          AddMonoidAlgebra.single d (algebraMap A N c' * x₁) +
          AddMonoidAlgebra.single d (algebraMap A N c' * x₂)
        rw [mul_add, AddMonoidAlgebra.single_add]
      · intro p x₀ _ ih c' hc'
        induction p using Polynomial.induction_on' with
        | add p₁ p₂ hp₁ hp₂ =>
          refine mem_WN_of_val_eq
            (u₂ := mkMulN d c' hc' (p₁ • x₀) + mkMulN d c' hc' (p₂ • x₀)) ?_
            (add_mem hp₁ hp₂)
          change AddMonoidAlgebra.single d (algebraMap A N c' * ((p₁ + p₂) • x₀)) =
            AddMonoidAlgebra.single d (algebraMap A N c' * (p₁ • x₀)) +
            AddMonoidAlgebra.single d (algebraMap A N c' * (p₂ • x₀))
          rw [add_smul, mul_add, AddMonoidAlgebra.single_add]
        | monomial s a =>
          have hca : ∀ n : ℕ, (AddMonoidAlgebra.single d (c' * a)).coeff (n : ℤ) ∈ 𝔪 ^ n := by
            intro n
            by_cases hdn : d = (n : ℤ)
            · subst hdn; rw [ama_single_same]
              have hc_mem : c' ∈ 𝔪 ^ n := by have h1 := hc' n; rwa [ama_single_same] at h1
              exact Ideal.mul_mem_right _ _ hc_mem
            · rw [ama_single_ne _ hdn]; exact zero_mem _
          refine mem_WN_of_val_eq
            (u₂ := (Polynomial.X ^ s : Polynomial R_Rees) • mkMulN d (c' * a) hca x₀) ?_
            (WN.smul_mem _ (ih (c' * a) hca))
          have h1 : (Polynomial.monomial s a) • x₀ = algebraMap A N a * (xN ^ s * x₀) := by
            rw [← Polynomial.C_mul_X_pow_eq_monomial, mul_smul,
              Polynomial.C_eq_algebraMap, algebraMap_smul, Algebra.smul_def,
              Algebra.smul_def, map_pow]
          have h2 : algebraMap A N c' * (algebraMap A N a * (xN ^ s * x₀)) =
              xN ^ s * (algebraMap A N (c' * a) * x₀) := by
            rw [map_mul]; ring
          have hX_pow : ((Polynomial.X ^ s : Polynomial R_Rees) • mkMulN d (c' * a) hca x₀).1 =
              AddMonoidAlgebra.single 0 (xN ^ s) *
                AddMonoidAlgebra.single d (algebraMap A N (c' * a) * x₀) := by
            rw [Algebra.smul_def, map_pow]
            have halg : algebraMap (Polynomial R_Rees) N_rees Polynomial.X = xN_rees :=
              Polynomial.aeval_X xN_rees
            rw [halg]
            exact congrArg (· * (mkMulN d (c' * a) hca x₀).1) (hxN_pow s)
          rw [hX_pow, AddMonoidAlgebra.single_mul_single, zero_add]
          change AddMonoidAlgebra.single d (algebraMap A N c' * ((Polynomial.monomial s a) • x₀)) = _
          rw [h1, h2]

    have hWN_top : WN = ⊤ := by
      rw [eq_top_iff]
      rintro f -
      have hf_sum : f = ∑ d ∈ f.1.coeff.support,
          (⟨AddMonoidAlgebra.single d (f.1.coeff d), fun n => by
            by_cases hdn : d = (n : ℤ)
            · subst hdn; rw [ama_single_same]; exact f.2 n
            · rw [ama_single_ne _ hdn]; exact zero_mem _⟩ : N_rees) := by
        apply Subtype.ext
        change f.1 = (reesSubalgebra N JN).val _
        rw [map_sum]
        exact (ama_sum_single f.1).symm
      rw [hf_sum]
      apply sum_mem
      intro d _
      by_cases hd : 0 ≤ d
      · let n : ℕ := d.toNat
        have hdn : (n : ℤ) = d := Int.toNat_of_nonneg hd
        have hy : f.1.coeff (n : ℤ) ∈ Ideal.map (algebraMap A N) (𝔪 ^ n) := by
          rw [Ideal.map_pow]; exact f.2 n
        have h_pos_y : ∀ (y : N) (hy_mem : y ∈ Ideal.map (algebraMap A N) (𝔪 ^ n)) (mN : N),
            mkPosN n y hy_mem mN ∈ WN := by
          intro y hy_in
          refine Submodule.span_induction
            (p := fun y hy' => ∀ mN : N, mkPosN n y hy' mN ∈ WN)
            ?_ ?_ ?_ ?_ hy_in
          · rintro _ ⟨c, hc_mem, rfl⟩ mN
            have hc_rees : ∀ k : ℕ, (AddMonoidAlgebra.single (n : ℤ) c).coeff (k : ℤ) ∈ 𝔪 ^ k := by
              intro k
              by_cases hnk : (n : ℤ) = (k : ℤ)
              · have h_eq : n = k := by omega
                rw [← hnk, ← h_eq, ama_single_same]; exact hc_mem
              · rw [ama_single_ne _ hnk]; exact zero_mem _
            refine mem_WN_of_val_eq (u₂ := mkMulN (n : ℤ) c hc_rees mN) ?_
              (h_mul_span (n : ℤ) c hc_rees mN)
            change AddMonoidAlgebra.single (n : ℤ) (mN * algebraMap A N c) =
              AddMonoidAlgebra.single (n : ℤ) (algebraMap A N c * mN)
            rw [mul_comm]
          · intro mN
            refine mem_WN_of_val_eq (u₂ := 0) ?_ (zero_mem WN)
            change AddMonoidAlgebra.single (n : ℤ) (mN * 0) = 0
            simp
          · intro y₁ y₂ hy₁ hy₂ ih₁ ih₂ mN
            refine mem_WN_of_val_eq (u₂ := mkPosN n y₁ hy₁ mN + mkPosN n y₂ hy₂ mN) ?_
              (add_mem (ih₁ mN) (ih₂ mN))
            change AddMonoidAlgebra.single (n : ℤ) (mN * (y₁ + y₂)) =
              AddMonoidAlgebra.single (n : ℤ) (mN * y₁) +
              AddMonoidAlgebra.single (n : ℤ) (mN * y₂)
            rw [mul_add, AddMonoidAlgebra.single_add]
          · intro s y₀ hy₀ ih mN
            refine mem_WN_of_val_eq (u₂ := mkPosN n y₀ hy₀ (mN * s)) ?_ (ih (mN * s))
            change AddMonoidAlgebra.single (n : ℤ) (mN * (s • y₀)) =
              AddMonoidAlgebra.single (n : ℤ) ((mN * s) * y₀)
            rw [smul_eq_mul, mul_assoc]
        refine mem_WN_of_val_eq (u₂ := mkPosN n (f.1.coeff (n : ℤ)) hy 1) ?_
          (h_pos_y (f.1.coeff (n : ℤ)) hy 1)
        change AddMonoidAlgebra.single d (f.1.coeff d) =
          AddMonoidAlgebra.single (n : ℤ) (1 * f.1.coeff (n : ℤ))
        simp [hdn]
      · have hc1 : ∀ k : ℕ, (AddMonoidAlgebra.single d (1 : A)).coeff (k : ℤ) ∈ 𝔪 ^ k := by
          intro k
          have hne : d ≠ (k : ℤ) := by omega
          rw [ama_single_ne _ hne]; exact zero_mem _
        refine mem_WN_of_val_eq (u₂ := mkMulN d 1 hc1 (f.1.coeff d)) ?_
          (h_mul_span d 1 hc1 (f.1.coeff d))
        change AddMonoidAlgebra.single d (f.1.coeff d) =
          AddMonoidAlgebra.single d (algebraMap A N 1 * f.1.coeff d)
        rw [map_one, one_mul]
    rw [Module.finite_def, ← hWN_top]
    exact Submodule.fg_span (Set.finite_range genN)

  have hFin_M0_rees : Module.Finite (Polynomial R_Rees) M0_rees := hReesChartFinite M₀
  have hFin_M1_rees : Module.Finite (Polynomial R_Rees) M1_rees := hReesChartFinite M₁

  
  have hRees_R1 : ρ0_rees (algebraMap (Polynomial R_Rees) M0_rees Polynomial.X) *
      ρ1_rees (algebraMap (Polynomial R_Rees) M1_rees Polynomial.X) = 1 := by
    rw [hX_M0_rees, hX_M1_rees]
    apply Subtype.ext
    change amaMap ρ₀.toRingHom (AddMonoidAlgebra.single 0 t₀) *
      amaMap ρ₁.toRingHom (AddMonoidAlgebra.single 0 u₁) = AddMonoidAlgebra.single 0 1
    rw [hamaMap_single, hamaMap_single, AddMonoidAlgebra.single_mul_single, add_zero]
    exact congrArg (AddMonoidAlgebra.single 0) hR1

  have hRees_denom : ∀ (N : Type u) [CommRing N] [Algebra A N]
      (σ : N →ₐ[A] M₀₁) (xN : N),
      (∀ z : M₀₁, ∃ (n : ℕ) (x : N), (σ xN) ^ n * z = σ x) →
      let JN : Ideal N := Ideal.map (algebraMap A N) 𝔪
      let hJN : Ideal.map σ.toRingHom JN ≤ J₀₁ := by
        rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
        intro a ha
        simp only [Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, σ.commutes]
        exact Ideal.mem_map_of_mem _ ha
      let σ_rees : ↥(reesSubalgebra N JN) →+* M01_rees := reesMap σ.toRingHom hJN
      let xN_rees : ↥(reesSubalgebra N JN) := mkConst JN xN
      ∀ f : M01_rees, ∃ (k : ℕ) (g : ↥(reesSubalgebra N JN)),
        (σ_rees xN_rees) ^ k * f = σ_rees g := by
    intro N _ _ σ xN hClear JN hJN σ_rees xN_rees f
    have hxN_pow : ∀ k : ℕ, (xN_rees ^ k).1 = AddMonoidAlgebra.single 0 (xN ^ k) := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        change (xN_rees ^ k * xN_rees).1 = _
        change (xN_rees ^ k).1 * AddMonoidAlgebra.single 0 xN = _
        rw [ih, AddMonoidAlgebra.single_mul_single, add_zero, pow_succ]
    have hσ_pow : ∀ k : ℕ, ((σ_rees xN_rees) ^ k).1 = AddMonoidAlgebra.single 0 ((σ xN) ^ k) := by
      intro k
      rw [← map_pow]
      change amaMap σ.toRingHom (xN_rees ^ k).1 = _
      rw [hxN_pow k, hamaMap_single, map_pow]
      rfl
    have h_add_clear : ∀ (f₁ f₂ : M01_rees),
        (∃ (k : ℕ) (g : ↥(reesSubalgebra N JN)), (σ_rees xN_rees) ^ k * f₁ = σ_rees g) →
        (∃ (k : ℕ) (g : ↥(reesSubalgebra N JN)), (σ_rees xN_rees) ^ k * f₂ = σ_rees g) →
        ∃ (k : ℕ) (g : ↥(reesSubalgebra N JN)), (σ_rees xN_rees) ^ k * (f₁ + f₂) = σ_rees g := by
      rintro f₁ f₂ ⟨k₁, g₁, hg₁⟩ ⟨k₂, g₂, hg₂⟩
      refine ⟨k₁ + k₂, xN_rees ^ k₂ * g₁ + xN_rees ^ k₁ * g₂, ?_⟩
      rw [mul_add, map_add, map_mul, map_mul, map_pow, map_pow, ← hg₁, ← hg₂]
      ring
    have hf_sum : f = ∑ d ∈ f.1.coeff.support,
        (⟨AddMonoidAlgebra.single d (f.1.coeff d), fun n => by
          by_cases hdn : d = (n : ℤ)
          · subst hdn; rw [ama_single_same]; exact f.2 n
          · rw [ama_single_ne _ hdn]; exact zero_mem _⟩ : M01_rees) := by
      apply Subtype.ext
      change f.1 = (reesSubalgebra M₀₁ J₀₁).val _
      rw [map_sum]
      exact (ama_sum_single f.1).symm
    rw [hf_sum]
    have h_fin : ∀ (s : Finset ℤ) (φ : ℤ → M01_rees),
        (∀ d ∈ s, ∃ (k : ℕ) (g : ↥(reesSubalgebra N JN)), (σ_rees xN_rees) ^ k * φ d = σ_rees g) →
        ∃ (k : ℕ) (g : ↥(reesSubalgebra N JN)),
          (σ_rees xN_rees) ^ k * (∑ d ∈ s, φ d) = σ_rees g := by
      intro s φ hφ
      induction s using Finset.cons_induction with
      | empty => exact ⟨0, 0, by simp⟩
      | cons d s hds ih =>
        rw [Finset.sum_cons]
        exact h_add_clear _ _ (hφ d (Finset.mem_cons_self d s))
          (ih (fun d' hd' => hφ d' (Finset.mem_cons_of_mem hd')))
    apply h_fin
    intro d _
    by_cases hd : 0 ≤ d
    · let n : ℕ := d.toNat
      have hdn : (n : ℤ) = d := Int.toNat_of_nonneg hd
      have hz_in : f.1.coeff (n : ℤ) ∈ Ideal.map (algebraMap A M₀₁) (𝔪 ^ n) := by
        rw [Ideal.map_pow]; exact f.2 n
      have h_pos_clear : ∀ z ∈ Ideal.map (algebraMap A M₀₁) (𝔪 ^ n),
          ∀ w : M₀₁, ∃ (k : ℕ) (x : N), x ∈ JN ^ n ∧ (σ xN) ^ k * (w * z) = σ x := by
        intro z hz
        refine Submodule.span_induction
          (p := fun z _ => ∀ w : M₀₁, ∃ (k : ℕ) (x : N), x ∈ JN ^ n ∧ (σ xN) ^ k * (w * z) = σ x)
          ?_ ?_ ?_ ?_ hz
        · rintro _ ⟨c, hc_mem, rfl⟩ w
          obtain ⟨k, xw, hxw⟩ := hClear w
          refine ⟨k, xw * algebraMap A N c, ?_, ?_⟩
          · rw [← Ideal.map_pow]
            exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hc_mem)
          · rw [map_mul, σ.commutes, ← hxw, mul_assoc]
        · intro w
          exact ⟨0, 0, zero_mem _, by simp⟩
        · intro z₁ z₂ _ _ ih₁ ih₂ w
          obtain ⟨k₁, x₁, hx₁_in, hx₁_eq⟩ := ih₁ w
          obtain ⟨k₂, x₂, hx₂_in, hx₂_eq⟩ := ih₂ w
          refine ⟨k₁ + k₂, xN ^ k₂ * x₁ + xN ^ k₁ * x₂,
            add_mem (Ideal.mul_mem_left _ _ hx₁_in) (Ideal.mul_mem_left _ _ hx₂_in), ?_⟩
          rw [map_add, map_mul, map_mul, map_pow, map_pow, ← hx₁_eq, ← hx₂_eq]
          ring
        · intro s z₀ _ ih w
          have hassoc : w * (s • z₀) = (w * s) * z₀ := by rw [smul_eq_mul, mul_assoc]
          rw [hassoc]
          exact ih (w * s)
      obtain ⟨k, x, hx_in, hx_eq⟩ := h_pos_clear (f.1.coeff (n : ℤ)) hz_in 1
      rw [one_mul] at hx_eq
      refine ⟨k, ⟨AddMonoidAlgebra.single (n : ℤ) x, fun m => by
        by_cases hnm : (n : ℤ) = (m : ℤ)
        · have heq : n = m := by omega
          rw [← hnm, ← heq, ama_single_same]; exact hx_in
        · rw [ama_single_ne _ hnm]; exact zero_mem _⟩, ?_⟩
      apply Subtype.ext
      change ((σ_rees xN_rees) ^ k).1 * AddMonoidAlgebra.single d (f.1.coeff d) =
        amaMap σ.toRingHom (AddMonoidAlgebra.single (n : ℤ) x)
      rw [hσ_pow k, ← hdn, AddMonoidAlgebra.single_mul_single, zero_add, hamaMap_single, hx_eq]
      rfl
    · obtain ⟨k, x, hx_eq⟩ := hClear (f.1.coeff d)
      refine ⟨k, ⟨AddMonoidAlgebra.single d x, fun m => by
        have hne : d ≠ (m : ℤ) := by omega
        rw [ama_single_ne _ hne]; exact zero_mem _⟩, ?_⟩
      apply Subtype.ext
      change ((σ_rees xN_rees) ^ k).1 * AddMonoidAlgebra.single d (f.1.coeff d) =
        amaMap σ.toRingHom (AddMonoidAlgebra.single d x)
      rw [hσ_pow k, AddMonoidAlgebra.single_mul_single, zero_add, hamaMap_single, hx_eq]
      rfl

  have hRees_R2 : ∀ z : M01_rees, ∃ (n : ℕ) (x₀ : M0_rees),
      (ρ0_rees (algebraMap (Polynomial R_Rees) M0_rees Polynomial.X)) ^ n * z = ρ0_rees x₀ := by
    rw [hX_M0_rees]
    exact hRees_denom M₀ ρ₀ t₀ hR2
  have hRees_R4 : ∀ z : M01_rees, ∃ (n : ℕ) (x₁ : M1_rees),
      (ρ1_rees (algebraMap (Polynomial R_Rees) M1_rees Polynomial.X)) ^ n * z = ρ1_rees x₁ := by
    rw [hX_M1_rees]
    exact hRees_denom M₁ ρ₁ u₁ hR4

  have hRees_torsion : ∀ (N : Type u) [CommRing N] [Algebra A N]
      (σ : N →ₐ[A] M₀₁) (xN : N),
      (∀ x : N, σ x = 0 → ∃ n : ℕ, xN ^ n * x = 0) →
      let JN : Ideal N := Ideal.map (algebraMap A N) 𝔪
      let hJN : Ideal.map σ.toRingHom JN ≤ J₀₁ := by
        rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
        intro a ha
        simp only [Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, σ.commutes]
        exact Ideal.mem_map_of_mem _ ha
      let σ_rees : ↥(reesSubalgebra N JN) →+* M01_rees := reesMap σ.toRingHom hJN
      let xN_rees : ↥(reesSubalgebra N JN) := mkConst JN xN
      ∀ g : ↥(reesSubalgebra N JN), σ_rees g = 0 → ∃ n : ℕ, xN_rees ^ n * g = 0 := by
    intro N _ _ σ xN hTor JN hJN σ_rees xN_rees g hg0
    have hcoeff0 : ∀ d : ℤ, σ (g.1.coeff d) = 0 := by
      intro d
      have h1 : (amaMap σ.toRingHom g.1).coeff d = 0 := by
        have hval : amaMap σ.toRingHom g.1 = 0 := congrArg Subtype.val hg0
        rw [hval]; rfl
      rwa [hamaMap_coeff] at h1
    let expFn : ℤ → ℕ := fun d => (hTor (g.1.coeff d) (hcoeff0 d)).choose
    have hexpFn : ∀ d : ℤ, xN ^ (expFn d) * g.1.coeff d = 0 :=
      fun d => (hTor (g.1.coeff d) (hcoeff0 d)).choose_spec
    let K_exp : ℕ := g.1.coeff.support.sup expFn
    have hxN_pow : ∀ k : ℕ, (xN_rees ^ k).1 = AddMonoidAlgebra.single 0 (xN ^ k) := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        change (xN_rees ^ k * xN_rees).1 = _
        change (xN_rees ^ k).1 * AddMonoidAlgebra.single 0 xN = _
        rw [ih, AddMonoidAlgebra.single_mul_single, add_zero, pow_succ]
    refine ⟨K_exp, Subtype.ext ?_⟩
    change (xN_rees ^ K_exp).1 * g.1 = 0
    rw [hxN_pow K_exp, ← ama_sum_single g.1, Finsupp.sum, Finset.mul_sum]
    apply Finset.sum_eq_zero
    intro d hd
    rw [AddMonoidAlgebra.single_mul_single, zero_add]
    have hle : expFn d ≤ K_exp := Finset.le_sup hd
    have hpow : xN ^ K_exp * g.1.coeff d = 0 := by
      have hsub : K_exp = (K_exp - expFn d) + expFn d := (Nat.sub_add_cancel hle).symm
      rw [hsub, pow_add, mul_assoc, hexpFn d, mul_zero]
    rw [hpow, AddMonoidAlgebra.single_zero]

  have hRees_R3 : ∀ x₀ : M0_rees, ρ0_rees x₀ = 0 → ∃ n : ℕ,
      (algebraMap (Polynomial R_Rees) M0_rees Polynomial.X) ^ n * x₀ = 0 := by
    rw [hX_M0_rees]
    exact hRees_torsion M₀ ρ₀ t₀ hR3
  have hRees_R5 : ∀ x₁ : M1_rees, ρ1_rees x₁ = 0 → ∃ n : ℕ,
      (algebraMap (Polynomial R_Rees) M1_rees Polynomial.X) ^ n * x₁ = 0 := by
    rw [hX_M1_rees]
    exact hRees_torsion M₁ ρ₁ u₁ hR5

  
  let δ_rees : (M0_rees × M1_rees) →ₗ[R_Rees] M01_rees :=
    ρ0_rees.toLinearMap.comp (LinearMap.fst R_Rees M0_rees M1_rees) -
    ρ1_rees.toLinearMap.comp (LinearMap.snd R_Rees M0_rees M1_rees)
  let instModKer : Module R_Rees ↥(LinearMap.ker δ_rees) := Submodule.module (LinearMap.ker δ_rees)
  letI : Module R_Rees ↥(LinearMap.ker δ_rees) := instModKer
  letI : DistribMulAction R_Rees ↥(LinearMap.ker δ_rees) := instModKer.toDistribMulAction
  letI : MulAction R_Rees ↥(LinearMap.ker δ_rees) := instModKer.toDistribMulAction.toMulAction
  letI : SMul R_Rees ↥(LinearMap.ker δ_rees) := instModKer.toDistribMulAction.toMulAction.toSMul
  let H1_rees : Type u := M01_rees ⧸ LinearMap.range δ_rees
  let instModH1 : Module R_Rees H1_rees := Submodule.Quotient.module (LinearMap.range δ_rees)
  letI : Module R_Rees H1_rees := instModH1
  letI : DistribMulAction R_Rees H1_rees := instModH1.toDistribMulAction
  letI : MulAction R_Rees H1_rees := instModH1.toDistribMulAction.toMulAction
  letI : SMul R_Rees H1_rees := instModH1.toDistribMulAction.toMulAction.toSMul
  obtain ⟨hFinH0_rees, hFinH1_rees⟩ :=
    cech_both_finite R_Rees M0_rees M1_rees M01_rees ρ0_rees ρ1_rees
      hRees_R1 hRees_R2 hRees_R3 hRees_R4 hRees_R5

  
  have hBound1 : ∃ k₀ : ℕ, ∀ b : B,
      i₀ b ∈ J₀ → i₁ b ∈ J₁ → b ^ (k₀ + 1) ∈ J_B := by
    have hfg_H0 : (⊤ : Submodule R_Rees ↥(LinearMap.ker δ_rees)).FG :=
      Module.finite_def.mp hFinH0_rees
    obtain ⟨S_H0, hSH0_span⟩ := hfg_H0
    let degFn : ↥(LinearMap.ker δ_rees) → ℕ := fun g =>
      (g.1.1.1.coeff.support ∪ g.1.2.1.coeff.support).sup Int.toNat
    let k₀ : ℕ := S_H0.sup degFn
    have hsmul_single_coeff : ∀ {S : Type u} [CommRing S] [Algebra A S]
        {JS : Ideal S} (hJS : Ideal.map (algebraMap A S) 𝔪 ≤ JS)
        (a : ℤ) (c : A) (f : AddMonoidAlgebra S ℤ) (d : ℤ),
        (amaMap (algebraMap A S) (AddMonoidAlgebra.single a c) * f).coeff d =
          algebraMap A S c * f.coeff (d - a) := by
      intro S _ _ JS _ a c f d
      rw [hamaMap_single]
      conv_lhs => rw [← ama_sum_single f, Finsupp.sum, Finset.mul_sum]
      have h_coeff_sum : ∀ (s : Finset ℤ) (φ : ℤ → AddMonoidAlgebra S ℤ),
          (∑ x ∈ s, φ x).coeff d = ∑ x ∈ s, (φ x).coeff d := by
        intro s φ
        induction s using Finset.cons_induction with
        | empty => rfl
        | cons x s hxs ih => rw [Finset.sum_cons, Finset.sum_cons, ← ih]; rfl
      rw [h_coeff_sum]
      by_cases hmem : d - a ∈ f.coeff.support
      · rw [Finset.sum_eq_single (d - a)]
        · rw [AddMonoidAlgebra.single_mul_single]
          have hda : a + (d - a) = d := by omega
          rw [hda, ama_single_same]
        · intro b _ hne
          rw [AddMonoidAlgebra.single_mul_single]
          have hab : a + b ≠ d := by omega
          exact ama_single_ne _ hab
        · intro hnot
          exact False.elim (hnot hmem)
      · rw [Finsupp.notMem_support_iff.mp hmem, mul_zero]
        apply Finset.sum_eq_zero
        intro b hb
        rw [AddMonoidAlgebra.single_mul_single]
        have hab : a + b ≠ d := by
          intro heq
          have hb_eq : b = d - a := by omega
          subst hb_eq
          exact hmem hb
        exact ama_single_ne _ hab

    have hP_deg : ∀ p : ↥(LinearMap.ker δ_rees),
        ∀ d : ℤ, (k₀ : ℤ) < d →
          ∃ y ∈ J_B, i₀ y = p.1.1.1.coeff d ∧ i₁ y = p.1.2.1.coeff d := by
      intro p
      have hp_mem : p ∈ Submodule.span R_Rees (S_H0 : Set ↥(LinearMap.ker δ_rees)) := by
        rw [hSH0_span]; trivial
      refine Submodule.span_induction
        (p := fun p _ => ∀ d : ℤ, (k₀ : ℤ) < d →
          ∃ y ∈ J_B, i₀ y = p.1.1.1.coeff d ∧ i₁ y = p.1.2.1.coeff d)
        ?_ ?_ ?_ ?_ hp_mem
      · intro g hg d hd
        have hg0 : g.1.1.1.coeff d = 0 := by
          by_contra hne
          have hmem1 : d ∈ g.1.1.1.coeff.support ∪ g.1.2.1.coeff.support :=
            Finset.mem_union_left _ (Finsupp.mem_support_iff.mpr hne)
          have hle1 : d.toNat ≤ degFn g := Finset.le_sup hmem1
          have hle2 : degFn g ≤ k₀ := Finset.le_sup (f := degFn) hg
          omega
        have hg1 : g.1.2.1.coeff d = 0 := by
          by_contra hne
          have hmem2 : d ∈ g.1.1.1.coeff.support ∪ g.1.2.1.coeff.support :=
            Finset.mem_union_right _ (Finsupp.mem_support_iff.mpr hne)
          have hle1 : d.toNat ≤ degFn g := Finset.le_sup hmem2
          have hle2 : degFn g ≤ k₀ := Finset.le_sup (f := degFn) hg
          omega
        exact ⟨0, zero_mem _, by rw [map_zero, hg0], by rw [map_zero, hg1]⟩
      · intro d _
        exact ⟨0, zero_mem _, map_zero i₀, map_zero i₁⟩
      · intro p₁ p₂ _ _ ih₁ ih₂ d hd
        obtain ⟨y₁, hy₁_in, hy₁_0, hy₁_1⟩ := ih₁ d hd
        obtain ⟨y₂, hy₂_in, hy₂_0, hy₂_1⟩ := ih₂ d hd
        refine ⟨y₁ + y₂, add_mem hy₁_in hy₂_in, ?_, ?_⟩
        · rw [map_add, hy₁_0, hy₂_0]; rfl
        · rw [map_add, hy₁_1, hy₂_1]; rfl
      · intro r p₀ _ ih d hd
        have hr_sum : r = ∑ a ∈ r.1.coeff.support,
            (⟨AddMonoidAlgebra.single a (r.1.coeff a), fun n => by
              by_cases han : a = (n : ℤ)
              · subst han; rw [ama_single_same]; exact r.2 n
              · rw [ama_single_ne _ han]; exact zero_mem _⟩ : R_Rees) := by
          apply Subtype.ext
          change r.1 = (reesSubalgebra A 𝔪).val _
          rw [map_sum]
          exact (ama_sum_single r.1).symm
        rw [hr_sum, Finset.sum_smul]
        have h_fin_smul : ∀ (s : Finset ℤ) (φ : ℤ → R_Rees),
            (∀ a ∈ s, ∃ y ∈ J_B,
              i₀ y = ((φ a • p₀).1.1.1).coeff d ∧ i₁ y = ((φ a • p₀).1.2.1).coeff d) →
            ∃ y ∈ J_B,
              i₀ y = ((∑ a ∈ s, φ a • p₀).1.1.1).coeff d ∧
              i₁ y = ((∑ a ∈ s, φ a • p₀).1.2.1).coeff d := by
          intro s φ hφ
          induction s using Finset.cons_induction with
          | empty => exact ⟨0, zero_mem _, map_zero i₀, map_zero i₁⟩
          | cons a s has ihs =>
            rw [Finset.sum_cons]
            obtain ⟨y₁, hy₁_in, hy₁_0, hy₁_1⟩ := hφ a (Finset.mem_cons_self a s)
            obtain ⟨y₂, hy₂_in, hy₂_0, hy₂_1⟩ :=
              ihs (fun a' ha' => hφ a' (Finset.mem_cons_of_mem ha'))
            refine ⟨y₁ + y₂, add_mem hy₁_in hy₂_in, ?_, ?_⟩
            · rw [map_add, hy₁_0, hy₂_0]; rfl
            · rw [map_add, hy₁_1, hy₂_1]; rfl
        apply h_fin_smul
        intro a _
        let c : A := r.1.coeff a
        let r_a : R_Rees := ⟨AddMonoidAlgebra.single a c, fun n => by
          by_cases han : a = (n : ℤ)
          · subst han; rw [ama_single_same]; exact r.2 n
          · rw [ama_single_ne _ han]; exact zero_mem _⟩
        have hc0 : ((r_a • p₀).1.1.1).coeff d = algebraMap A M₀ c * p₀.1.1.1.coeff (d - a) :=
          hsmul_single_coeff le_rfl a c p₀.1.1.1 d
        have hc1 : ((r_a • p₀).1.2.1).coeff d = algebraMap A M₁ c * p₀.1.2.1.coeff (d - a) :=
          hsmul_single_coeff le_rfl a c p₀.1.2.1 d
        by_cases ha1 : 1 ≤ a
        · let q : ℕ := a.toNat
          have haq : (q : ℤ) = a := by omega
          have hq_ne : q ≠ 0 := by omega
          have hc_q : c ∈ 𝔪 ^ q := by dsimp [c]; rw [← haq]; exact r.2 q
          have hc_mem : c ∈ 𝔪 := Ideal.pow_le_self hq_ne hc_q
          have hglued : ρ₀ (p₀.1.1.1.coeff (d - a)) = ρ₁ (p₀.1.2.1.coeff (d - a)) := by
            have hker := congrArg (fun u : M01_rees => u.1.coeff (d - a)) p₀.2
            change (amaMap ρ₀.toRingHom p₀.1.1.1).coeff (d - a) -
              (amaMap ρ₁.toRingHom p₀.1.2.1).coeff (d - a) = 0 at hker
            rw [hamaMap_coeff, hamaMap_coeff] at hker
            exact sub_eq_zero.mp hker
          obtain ⟨b₀, hb₀_0, hb₀_1⟩ := hEq_surj _ _ hglued
          refine ⟨algebraMap A B c * b₀,
            Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hc_mem), ?_, ?_⟩
          · rw [map_mul, i₀.commutes, hb₀_0, hc0]
          · rw [map_mul, i₁.commutes, hb₀_1, hc1]
        · have hda_gt : (k₀ : ℤ) < d - a := by omega
          obtain ⟨y₀, hy₀_in, hy₀_0, hy₀_1⟩ := ih (d - a) hda_gt
          refine ⟨algebraMap A B c * y₀, Ideal.mul_mem_left _ _ hy₀_in, ?_, ?_⟩
          · rw [map_mul, i₀.commutes, hy₀_0, hc0]
          · rw [map_mul, i₁.commutes, hy₀_1, hc1]

    refine ⟨k₀, fun b hb₀ hb₁ => ?_⟩
    let K : ℕ := k₀ + 1
    let x : B := b ^ K
    have hx₀ : i₀ x ∈ J₀ ^ K := by rw [map_pow]; exact Ideal.pow_mem_pow hb₀ K
    have hx₁ : i₁ x ∈ J₁ ^ K := by rw [map_pow]; exact Ideal.pow_mem_pow hb₁ K
    let p_x : ↥(LinearMap.ker δ_rees) :=
      ⟨(⟨AddMonoidAlgebra.single (K : ℤ) (i₀ x), fun m => by
          by_cases hKm : (K : ℤ) = (m : ℤ)
          · have heq : K = m := by omega
            rw [← hKm, ← heq, ama_single_same]; exact hx₀
          · rw [ama_single_ne _ hKm]; exact zero_mem _⟩,
        ⟨AddMonoidAlgebra.single (K : ℤ) (i₁ x), fun m => by
          by_cases hKm : (K : ℤ) = (m : ℤ)
          · have heq : K = m := by omega
            rw [← hKm, ← heq, ama_single_same]; exact hx₁
          · rw [ama_single_ne _ hKm]; exact zero_mem _⟩),
        by
          apply Subtype.ext
          change amaMap ρ₀.toRingHom (AddMonoidAlgebra.single (K : ℤ) (i₀ x)) -
            amaMap ρ₁.toRingHom (AddMonoidAlgebra.single (K : ℤ) (i₁ x)) = 0
          rw [hamaMap_single, hamaMap_single]
          change AddMonoidAlgebra.single (K : ℤ) (ρ₀ (i₀ x)) -
            AddMonoidAlgebra.single (K : ℤ) (ρ₁ (i₁ x)) = 0
          rw [hEq_comm x, sub_self]⟩
    have hK_gt : (k₀ : ℤ) < (K : ℤ) := by omega
    obtain ⟨y, hy_in, hy₀, hy₁⟩ := hP_deg p_x (K : ℤ) hK_gt
    have hy₀' : i₀ y = i₀ x := by
      change i₀ y = (AddMonoidAlgebra.single (K : ℤ) (i₀ x)).coeff (K : ℤ) at hy₀
      rwa [ama_single_same] at hy₀
    have hy₁' : i₁ y = i₁ x := by
      change i₁ y = (AddMonoidAlgebra.single (K : ℤ) (i₁ x)).coeff (K : ℤ) at hy₁
      rwa [ama_single_same] at hy₁
    have hyx : y = x := hEq_inj y x hy₀' hy₁'
    change x ∈ J_B
    rwa [← hyx]

  
  have hBound2 : ∃ k₁ : ℕ, ∀ (x₀ : M₀) (x₁ : M₁),
      ρ₀ x₀ - ρ₁ x₁ ∈ J₀₁ ^ (1 + k₁) →
      ∃ (m₀ : M₀) (m₁ : M₁),
        m₀ ∈ J₀ ∧ m₁ ∈ J₁ ∧ ρ₀ x₀ - ρ₁ x₁ = ρ₀ m₀ - ρ₁ m₁ := by
    have hFinH1_rees' : Module.Finite R_Rees H1_rees := hFinH1_rees
    have hNoeth_H1 : IsNoetherian R_Rees H1_rees :=
      @isNoetherian_of_isNoetherianRing_of_finite R_Rees H1_rees _ _ _ hNoeth_Rees hFinH1_rees'
    let u_T : R_Rees :=
      ⟨AddMonoidAlgebra.single (-1 : ℤ) (1 : A), fun n => by
        have hne : (-1 : ℤ) ≠ (n : ℤ) := by omega
        rw [ama_single_ne _ hne]; exact zero_mem _⟩
    have huT_pow : ∀ m : ℕ, (u_T ^ m).1 = AddMonoidAlgebra.single (-(m : ℤ)) (1 : A) := by
      intro m
      have hval : (u_T ^ m).1 = (u_T.1) ^ m := rfl
      rw [hval, hu_pow]
    let smulMap (m : ℕ) : H1_rees →ₗ[R_Rees] H1_rees :=
      { toFun := fun q => (u_T ^ m) • q
        map_add' := fun q₁ q₂ => smul_add (u_T ^ m) q₁ q₂
        map_smul' := fun r q => by
          dsimp
          rw [← mul_smul, mul_comm, mul_smul] }
    let N_chain : ℕ →o Submodule R_Rees H1_rees :=
      { toFun := fun m => LinearMap.ker (smulMap m)
        monotone' := fun m₁ m₂ hle q hq => by
          change (u_T ^ m₁) • q = 0 at hq
          change (u_T ^ m₂) • q = 0
          have hsub : m₂ = (m₂ - m₁) + m₁ := (Nat.sub_add_cancel hle).symm
          rw [hsub, pow_add, mul_smul, hq, smul_zero] }
    obtain ⟨k₁, hk₁_stab⟩ :=
      (monotone_stabilizes_iff_noetherian (R := R_Rees) (M := H1_rees)).mpr hNoeth_H1 N_chain
    have hstab1 : N_chain k₁ = N_chain (1 + k₁) := hk₁_stab (1 + k₁) (by omega)
    refine ⟨k₁, fun x₀ x₁ hw => ?_⟩
    let w : M₀₁ := ρ₀ x₀ - ρ₁ x₁
    let w_tilde : M01_rees :=
      ⟨AddMonoidAlgebra.single (((1 + k₁ : ℕ) : ℤ)) w, fun m => by
        by_cases hm : (((1 + k₁ : ℕ) : ℤ)) = (m : ℤ)
        · have heq : 1 + k₁ = m := by omega
          rw [← hm, ← heq, ama_single_same]; exact hw
        · rw [ama_single_ne _ hm]; exact zero_mem _⟩
    have huT_act : ∀ m : ℕ, ((u_T ^ m) • w_tilde).1 =
        AddMonoidAlgebra.single (-(m : ℤ) + (((1 + k₁ : ℕ) : ℤ))) w := by
      intro m
      change amaMap (algebraMap A M₀₁) (u_T ^ m).1 * w_tilde.1 = _
      rw [huT_pow m, hamaMap_single, map_one, AddMonoidAlgebra.single_mul_single, one_mul]
    have hw_in_succ : Submodule.Quotient.mk w_tilde ∈ N_chain (1 + k₁) := by
      change (u_T ^ (1 + k₁)) • (Submodule.Quotient.mk w_tilde : H1_rees) = 0
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
      refine ⟨(mkConst J₀ x₀, mkConst J₁ x₁), Subtype.ext ?_⟩
      change amaMap ρ₀.toRingHom (AddMonoidAlgebra.single 0 x₀) -
        amaMap ρ₁.toRingHom (AddMonoidAlgebra.single 0 x₁) = ((u_T ^ (1 + k₁)) • w_tilde).1
      rw [hamaMap_single, hamaMap_single, huT_act (1 + k₁)]
      have hexp : -(((1 + k₁ : ℕ) : ℤ)) + (((1 + k₁ : ℕ) : ℤ)) = 0 := by omega
      rw [hexp]
      ext m
      change Finsupp.single (0 : ℤ) (ρ₀ x₀) m - Finsupp.single (0 : ℤ) (ρ₁ x₁) m =
        Finsupp.single (0 : ℤ) (ρ₀ x₀ - ρ₁ x₁) m
      rw [Finsupp.single_sub]
      rfl
    rw [← hstab1] at hw_in_succ
    change (u_T ^ k₁) • (Submodule.Quotient.mk w_tilde : H1_rees) = 0 at hw_in_succ
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hw_in_succ
    obtain ⟨⟨m0_tilde, m1_tilde⟩, hm_eq⟩ := hw_in_succ
    let m₀ : M₀ := m0_tilde.1.coeff (1 : ℤ)
    let m₁ : M₁ := m1_tilde.1.coeff (1 : ℤ)
    have hm₀_in : m₀ ∈ J₀ := by have h1 := m0_tilde.2 1; rwa [pow_one] at h1
    have hm₁_in : m₁ ∈ J₁ := by have h1 := m1_tilde.2 1; rwa [pow_one] at h1
    refine ⟨m₀, m₁, hm₀_in, hm₁_in, ?_⟩
    have hcoeff1 := congrArg (fun u : M01_rees => u.1.coeff (1 : ℤ)) hm_eq
    change (amaMap ρ₀.toRingHom m0_tilde.1).coeff (1 : ℤ) -
      (amaMap ρ₁.toRingHom m1_tilde.1).coeff (1 : ℤ) =
      (((u_T ^ k₁) • w_tilde).1).coeff (1 : ℤ) at hcoeff1
    rw [hamaMap_coeff, hamaMap_coeff, huT_act k₁] at hcoeff1
    have hexp1 : -(k₁ : ℤ) + (((1 + k₁ : ℕ) : ℤ)) = (1 : ℤ) := by omega
    rw [hexp1, ama_single_same] at hcoeff1
    exact hcoeff1.symm

  
  
  
  have hJB_ker : J_B ≤ RingHom.ker red₀ := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker]
    let b : B := algebraMap A B a
    have hj₀_0 : j₀ (red₀ b) = j₀ 0 := by
      rw [(hred_compat b).1, i₀.commutes, map_zero, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem _ ha
    have hj₁_0 : j₁ (red₀ b) = j₁ 0 := by
      rw [(hred_compat b).2, i₁.commutes, map_zero, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem _ ha
    exact hj_inj (red₀ b) 0 hj₀_0 hj₁_0

  let Φ₁ : (B ⧸ J_B) →+* B₀ := Ideal.Quotient.lift J_B red₀ hJB_ker
  have hΦ₁_comp : Φ₁.comp (Ideal.Quotient.mk J_B) = red₀ :=
    RingHom.ext (fun _ => rfl)

  obtain ⟨k₀, hk₀⟩ := hBound1
  have hKerNil_Φ₁ : ∀ z ∈ RingHom.ker Φ₁, IsNilpotent z := by
    intro z hz
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
    have hred_b : red₀ b = 0 := hz
    have hb₀ : i₀ b ∈ J₀ := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← (hred_compat b).1, hred_b, map_zero]
    have hb₁ : i₁ b ∈ J₁ := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← (hred_compat b).2, hred_b, map_zero]
    refine ⟨k₀ + 1, ?_⟩
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact hk₀ b hb₀ hb₁

  obtain ⟨k₁, hk₁⟩ := hBound2
  let n_pow : ℕ := 1 + k₁
  have hn_ne : n_pow ≠ 0 := by omega
  have hJ₀_le : J₀ ^ n_pow ≤ J₀ := Ideal.pow_le_self hn_ne
  have hJ₁_le : J₁ ^ n_pow ≤ J₁ := Ideal.pow_le_self hn_ne
  have hJ₀₁_le : J₀₁ ^ n_pow ≤ J₀₁ := Ideal.pow_le_self hn_ne
  let π₀ : (M₀ ⧸ J₀ ^ n_pow) →+* (M₀ ⧸ J₀) := Ideal.Quotient.factor hJ₀_le
  let π₁ : (M₁ ⧸ J₁ ^ n_pow) →+* (M₁ ⧸ J₁) := Ideal.Quotient.factor hJ₁_le
  let π₀₁ : (M₀₁ ⧸ J₀₁ ^ n_pow) →+* (M₀₁ ⧸ J₀₁) := Ideal.Quotient.factor hJ₀₁_le

  have hfactor_nil : ∀ {S : Type u} [CommRing S] (J : Ideal S) (hJ : J ^ n_pow ≤ J),
      ∀ u ∈ RingHom.ker (Ideal.Quotient.factor hJ), IsNilpotent u := by
    intro S _ J hJ u hu
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective u
    rw [RingHom.mem_ker, Ideal.Quotient.factor_mk, Ideal.Quotient.eq_zero_iff_mem] at hu
    refine ⟨n_pow, ?_⟩
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.pow_mem_pow hu n_pow

  have hρ₀_pow_ker : J₀ ^ n_pow ≤
      RingHom.ker ((Ideal.Quotient.mk (J₀₁ ^ n_pow)).comp ρ₀.toRingHom) := by
    rw [← RingHom.comap_ker, ← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    refine le_trans (Ideal.pow_right_mono hJ₀_map n_pow) ?_
    intro x hx
    rwa [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]
  have hρ₁_pow_ker : J₁ ^ n_pow ≤
      RingHom.ker ((Ideal.Quotient.mk (J₀₁ ^ n_pow)).comp ρ₁.toRingHom) := by
    rw [← RingHom.comap_ker, ← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    refine le_trans (Ideal.pow_right_mono hJ₁_map n_pow) ?_
    intro x hx
    rwa [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]

  let ρbar0_n : (M₀ ⧸ J₀ ^ n_pow) →+* (M₀₁ ⧸ J₀₁ ^ n_pow) :=
    Ideal.Quotient.lift (J₀ ^ n_pow) ((Ideal.Quotient.mk (J₀₁ ^ n_pow)).comp ρ₀.toRingHom)
      hρ₀_pow_ker
  let ρbar1_n : (M₁ ⧸ J₁ ^ n_pow) →+* (M₀₁ ⧸ J₀₁ ^ n_pow) :=
    Ideal.Quotient.lift (J₁ ^ n_pow) ((Ideal.Quotient.mk (J₀₁ ^ n_pow)).comp ρ₁.toRingHom)
      hρ₁_pow_ker

  have hΦ₁_bij : WeilRingHomIdempotentBijective Φ₁ := by
    refine ⟨?_, ?_⟩
    · intro e₁ e₂ he₁ he₂ h_eq
      obtain ⟨e, _, hu⟩ :=
        existsUnique_isIdempotentElem_eq_of_ker_isNilpotent Φ₁ hKerNil_Φ₁
          (Φ₁ e₁) ⟨e₁, rfl⟩ (he₁.map Φ₁)
      have h1 : e₁ = e := hu e₁ ⟨he₁, rfl⟩
      have h2 : e₂ = e := hu e₂ ⟨he₂, h_eq.symm⟩
      exact h1.trans h2.symm
    · intro e₀ he₀
      have he₀_range : e₀ ∈ Φ₁.range := by
        obtain ⟨ehat₀, ⟨hehat₀, hπ₀_e⟩, _⟩ :=
          existsUnique_isIdempotentElem_eq_of_ker_isNilpotent π₀ (hfactor_nil J₀ hJ₀_le)
            (j₀ e₀) (Ideal.Quotient.factor_surjective hJ₀_le (j₀ e₀)) (he₀.map j₀)
        obtain ⟨ehat₁, ⟨hehat₁, hπ₁_e⟩, _⟩ :=
          existsUnique_isIdempotentElem_eq_of_ker_isNilpotent π₁ (hfactor_nil J₁ hJ₁_le)
            (j₁ e₀) (Ideal.Quotient.factor_surjective hJ₁_le (j₁ e₀)) (he₀.map j₁)
        obtain ⟨x₀, hx₀⟩ := Ideal.Quotient.mk_surjective ehat₀
        obtain ⟨x₁, hx₁⟩ := Ideal.Quotient.mk_surjective ehat₁
        have hmk₀ : Ideal.Quotient.mk J₀ x₀ = j₀ e₀ := by
          rw [← Ideal.Quotient.factor_mk hJ₀_le, hx₀]
          exact hπ₀_e
        have hmk₁ : Ideal.Quotient.mk J₁ x₁ = j₁ e₀ := by
          rw [← Ideal.Quotient.factor_mk hJ₁_le, hx₁]
          exact hπ₁_e
        have hcompat₀₁ : Ideal.Quotient.mk J₀₁ (ρ₀ x₀) = Ideal.Quotient.mk J₀₁ (ρ₁ x₁) :=
          hj_compat e₀ x₀ x₁ hmk₀ hmk₁
        let u₀₁ : M₀₁ ⧸ J₀₁ ^ n_pow := ρbar0_n ehat₀
        let v₀₁ : M₀₁ ⧸ J₀₁ ^ n_pow := ρbar1_n ehat₁
        have hu₀₁_idem : IsIdempotentElem u₀₁ := hehat₀.map ρbar0_n
        have hv₀₁_idem : IsIdempotentElem v₀₁ := hehat₁.map ρbar1_n
        have hπ₀₁_u : π₀₁ u₀₁ = Ideal.Quotient.mk J₀₁ (ρ₀ x₀) := by
          dsimp [u₀₁]
          rw [← hx₀]
          exact Ideal.Quotient.factor_mk hJ₀₁_le (ρ₀ x₀)
        have hπ₀₁_v : π₀₁ v₀₁ = Ideal.Quotient.mk J₀₁ (ρ₀ x₀) := by
          dsimp [v₀₁]
          rw [← hx₁, hcompat₀₁]
          exact Ideal.Quotient.factor_mk hJ₀₁_le (ρ₁ x₁)
        obtain ⟨w_uniq, _, hw_uniq⟩ :=
          existsUnique_isIdempotentElem_eq_of_ker_isNilpotent π₀₁ (hfactor_nil J₀₁ hJ₀₁_le)
            (Ideal.Quotient.mk J₀₁ (ρ₀ x₀)) ⟨u₀₁, hπ₀₁_u⟩ (hπ₀₁_u ▸ hu₀₁_idem.map π₀₁)
        have huv_eq : u₀₁ = v₀₁ :=
          (hw_uniq u₀₁ ⟨hu₀₁_idem, hπ₀₁_u⟩).trans (hw_uniq v₀₁ ⟨hv₀₁_idem, hπ₀₁_v⟩).symm
        have hdiff_mem : ρ₀ x₀ - ρ₁ x₁ ∈ J₀₁ ^ (1 + k₁) := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
          change ρbar0_n (Ideal.Quotient.mk (J₀ ^ n_pow) x₀) =
            ρbar1_n (Ideal.Quotient.mk (J₁ ^ n_pow) x₁)
          rw [hx₀, hx₁]
          exact huv_eq
        obtain ⟨m₀, m₁, hm₀_in, hm₁_in, hm_eq⟩ := hk₁ x₀ x₁ hdiff_mem
        have hglued : ρ₀ (x₀ - m₀) = ρ₁ (x₁ - m₁) := by
          rw [map_sub, map_sub]
          exact sub_eq_sub_iff_sub_eq_sub.mp hm_eq
        obtain ⟨b, hb₀, hb₁⟩ := hEq_surj (x₀ - m₀) (x₁ - m₁) hglued
        have hred_eq : red₀ b = e₀ := by
          apply hj_inj
          · rw [(hred_compat b).1, hb₀, map_sub, hmk₀,
              Ideal.Quotient.eq_zero_iff_mem.mpr hm₀_in, sub_zero]
          · rw [(hred_compat b).2, hb₁, map_sub, hmk₁,
              Ideal.Quotient.eq_zero_iff_mem.mpr hm₁_in, sub_zero]
        exact ⟨Ideal.Quotient.mk J_B b, hred_eq⟩
      obtain ⟨e, ⟨he_idem, hΦe⟩, _⟩ :=
        existsUnique_isIdempotentElem_eq_of_ker_isNilpotent Φ₁ hKerNil_Φ₁ e₀ he₀_range he₀
      exact ⟨e, he_idem, hΦe⟩

  exact ⟨Φ₁, hΦ₁_comp, hFinB, hΦ₁_bij⟩

theorem weil_pbc_projLine_finite_cover_deg_zero_bijective (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (hA : WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A)
    (Y : AlgebraicGeometry.Scheme.{u})
    (π : Y ⟶ CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
      (weilProjectiveSpaceOver k 1).hom)
    [AlgebraicGeometry.IsFinite π] :
    WeilEtaleCohomologyPullbackBijective
      (CategoryTheory.Limits.pullback.snd
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
        (π ≫ CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
          (weilProjectiveSpaceOver k 1).hom))
      (weilEtaleTorsionSheaf Y ℓ) 0 :=
by
  classical
  have hIdem_comp : ∀ {R₁ R₂ R₃ : Type u} [CommRing R₁] [CommRing R₂] [CommRing R₃]
      (φ : R₁ →+* R₂) (ψ : R₂ →+* R₃),
      WeilRingHomIdempotentBijective φ →
      WeilRingHomIdempotentBijective ψ →
      WeilRingHomIdempotentBijective (ψ.comp φ) := by
    intro R₁ R₂ R₃ _ _ _ φ ψ hφ hψ
    refine ⟨?_, ?_⟩
    · intro e₁ e₂ he₁ he₂ hcomp
      have hφ₁ : IsIdempotentElem (φ e₁) := by
        rw [IsIdempotentElem, ← map_mul, he₁.eq]
      have hφ₂ : IsIdempotentElem (φ e₂) := by
        rw [IsIdempotentElem, ← map_mul, he₂.eq]
      exact hφ.1 e₁ e₂ he₁ he₂ (hψ.1 (φ e₁) (φ e₂) hφ₁ hφ₂ hcomp)
    · intro e₀ he₀
      obtain ⟨e₂, he₂, rfl⟩ := hψ.2 e₀ he₀
      obtain ⟨e₁, he₁, rfl⟩ := hφ.2 e₂ he₂
      exact ⟨e₁, he₁, rfl⟩
  let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
  let p₁_A := CategoryTheory.Limits.pullback.fst s_A (weilProjectiveSpaceOver k 1).hom
  let ι_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom)
  let f_Y := π ≫ p₁_A
  let i_Y := CategoryTheory.Limits.pullback.snd ι_A f_Y
  have : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k 1).hom := by
    dsimp [weilProjectiveSpaceOver]
    infer_instance
  have : AlgebraicGeometry.IsSeparated p₁_A := by
    dsimp [p₁_A]
    infer_instance
  have : AlgebraicGeometry.IsSeparated f_Y := by
    dsimp [f_Y]
    infer_instance
  have : AlgebraicGeometry.IsAffineHom i_Y :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback ι_A f_Y)
      (AlgebraicGeometry.isAffineHom_of_isAffine ι_A)
  rcases hA with ⟨hNoethA, hLocalA, hKerA, _hHenselA, hEtaleLift⟩
  have : IsNoetherianRing A := hNoethA
  have : IsLocalRing A := hLocalA
  let 𝔪 : Ideal A := RingHom.ker τ_A.toRingHom
  obtain ⟨B, hCR_B, hAlg_B, e_Y, M₀, M₁, M₀₁,
    hCR_M₀, hAlgA_M₀, hAlgP_M₀, hST_M₀, hFin_M₀,
    hCR_M₁, hAlgA_M₁, hAlgP_M₁, hST_M₁, hFin_M₁,
    hCR_M₀₁, hAlgA_M₀₁, hCover⟩ :=
    weil_projLine_finite_cover_two_chart_gluing_presentation k A τ_A Y π
  let _ : CommRing B := hCR_B
  let _ : Algebra A B := hAlg_B
  let _ : CommRing M₀ := hCR_M₀
  let _ : Algebra A M₀ := hAlgA_M₀
  let _ : Algebra (Polynomial A) M₀ := hAlgP_M₀
  have : IsScalarTower A (Polynomial A) M₀ := hST_M₀
  have : Module.Finite (Polynomial A) M₀ := hFin_M₀
  let _ : CommRing M₁ := hCR_M₁
  let _ : Algebra A M₁ := hAlgA_M₁
  let _ : Algebra (Polynomial A) M₁ := hAlgP_M₁
  have : IsScalarTower A (Polynomial A) M₁ := hST_M₁
  have : Module.Finite (Polynomial A) M₁ := hFin_M₁
  let _ : CommRing M₀₁ := hCR_M₀₁
  let _ : Algebra A M₀₁ := hAlgA_M₀₁
  obtain ⟨Φ₁, hΦ₁_comp, hFinB, hΦ₁_bij⟩ :=
    weil_two_chart_projLine_formal_functions_adic_completion_iso A 𝔪 B _ _ M₀ M₁ M₀₁ hCover
  have : Module.Finite A B := hFinB
  
  let J : Ideal B := Ideal.map (algebraMap A B) 𝔪
  let q_B : B →+* (B ⧸ J) := Ideal.Quotient.mk J
  have h𝔪_max : 𝔪 = IsLocalRing.maximalIdeal A := by
    ext a
    change τ_A a = 0 ↔ a ∈ IsLocalRing.maximalIdeal A
    rw [hKerA a, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  have h𝔪_jac : 𝔪 ≤ (⊥ : Ideal A).jacobson := by
    rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top, h𝔪_max]
  have hJ_mul_mem_smul : ∀ (N : Submodule A B),
      (∀ (b : B) (y : B), y ∈ N → b * y ∈ N) →
      ∀ z ∈ J, ∀ y ∈ N, z * y ∈ 𝔪 • N := by
    intro N hN_mul
    let K_N : Ideal B :=
      { carrier := { z : B | ∀ y ∈ N, z * y ∈ 𝔪 • N }
        add_mem' := fun {z₁ z₂} hz₁ hz₂ y hy => by
          rw [add_mul]
          exact add_mem (hz₁ y hy) (hz₂ y hy)
        zero_mem' := fun y _ => by
          rw [zero_mul]
          exact zero_mem _
        smul_mem' := fun b {z} hz y hy => by
          change (b * z) * y ∈ 𝔪 • N
          have hbz : (b * z) * y = z * (b * y) := by ring
          rw [hbz]
          exact hz (b * y) (hN_mul b y hy) }
    have hle : J ≤ K_N := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha y hy
      rw [← Algebra.smul_def]
      exact Submodule.smul_mem_smul ha hy
    intro z hz y hy
    exact hle hz y hy
  
  have hqB_inj : ∀ e₁ e₂ : B, IsIdempotentElem e₁ → IsIdempotentElem e₂ →
      q_B e₁ = q_B e₂ → e₁ = e₂ := by
    have h_van : ∀ u v : B, IsIdempotentElem u → IsIdempotentElem v → q_B u = q_B v →
        u * (1 - v) = 0 := by
      intro u v hu hv huv
      let f : B := u * (1 - v)
      have hf_idem : IsIdempotentElem f := by
        change (u * (1 - v)) * (u * (1 - v)) = u * (1 - v)
        calc (u * (1 - v)) * (u * (1 - v))
            = (u * u) * (1 - 2 * v + v * v) := by ring
          _ = u * (1 - 2 * v + v) := by rw [hu.eq, hv.eq]
          _ = u * (1 - v) := by ring
      have hf_J : f ∈ J := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        change q_B (u * (1 - v)) = 0
        rw [map_mul, map_sub, map_one, huv, ← map_one q_B, ← map_sub, ← map_mul]
