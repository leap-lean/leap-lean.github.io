      obtain ⟨e, he, hφe⟩ := hIdem.2 e₀ he₀
      refine ⟨(Y.basicOpen e : Set ↥Y), (hIdemClopen Y).1 e he, ?_⟩
      have hp : f_top ⁻¹' (Y.basicOpen e : Set ↥Y) = (Y₀.basicOpen (φ e) : Set ↥Y₀) :=
        congrArg SetLike.coe (AlgebraicGeometry.Scheme.preimage_basicOpen_top h e)
      rw [hp, hφe]
    constructor
    · intro s₁ s₂ hs
      ext y
      let a : α := s₁ y
      have hpre : f_top ⁻¹' (s₁ ⁻¹' {a}) = f_top ⁻¹' (s₂ ⁻¹' {a}) := by
        ext y₀
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        have hy₀ : s₁ (f_top y₀) = s₂ (f_top y₀) :=
          congrArg (fun t : LocallyConstant ↥Y₀ α => t y₀) hs
        rw [hy₀]
      have hfib_eq : s₁ ⁻¹' ({a} : Set α) = s₂ ⁻¹' ({a} : Set α) :=
        hθ_inj _ _ (s₁.isLocallyConstant.isClopen_fiber a) (s₂.isLocallyConstant.isClopen_fiber a) hpre
      have hy_mem : y ∈ s₂ ⁻¹' ({a} : Set α) := hfib_eq ▸ rfl
      exact hy_mem.symm
    · cases nonempty_fintype α
      intro s₀
      have hLift : ∀ a : α, ∃ W : Set ↥Y, IsClopen W ∧ f_top ⁻¹' W = s₀ ⁻¹' {a} :=
        fun a => hθ_surj (s₀ ⁻¹' {a}) (s₀.isLocallyConstant.isClopen_fiber a)
      choose W hW_clop hW_pre using hLift
      have hDisj : ∀ a b : α, a ≠ b → W a ∩ W b = ∅ := by
        intro a b hab
        apply hθ_inj (W a ∩ W b) ∅ ((hW_clop a).inter (hW_clop b)) isClopen_empty
        rw [Set.preimage_inter, hW_pre a, hW_pre b, Set.preimage_empty]
        ext y₀
        simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_singleton_iff, Set.mem_empty_iff_false,
          iff_false, not_and]
        intro ha hb
        exact hab (ha.symm.trans hb)
      have hCover : (⋃ a ∈ (Finset.univ : Finset α), W a) = Set.univ := by
        apply hθ_inj _ Set.univ (isClopen_biUnion_finset fun a _ => hW_clop a) isClopen_univ
        rw [Set.preimage_univ]
        ext y₀
        simp only [Set.mem_preimage, Set.mem_iUnion, Finset.mem_univ, Set.mem_univ, iff_true]
        refine ⟨s₀ y₀, trivial, ?_⟩
        change y₀ ∈ f_top ⁻¹' W (s₀ y₀)
        rw [hW_pre (s₀ y₀)]
        rfl
      have hEx : ∀ y : ↥Y, ∃ a : α, y ∈ W a := by
        intro y
        have hy : y ∈ ⋃ a ∈ (Finset.univ : Finset α), W a := by rw [hCover]; trivial
        simpa using hy
      let s_fn : ↥Y → α := fun y => Classical.choose (hEx y)
      have hs_iff : ∀ (y : ↥Y) (a : α), s_fn y = a ↔ y ∈ W a := by
        intro y a
        have hy_ch : y ∈ W (s_fn y) := Classical.choose_spec (hEx y)
        constructor
        · rintro rfl; exact hy_ch
        · intro hya
          by_contra hne
          have hmem_emp : y ∈ W (s_fn y) ∩ W a := ⟨hy_ch, hya⟩
          rw [hDisj (s_fn y) a hne] at hmem_emp
          exact hmem_emp
      have hs_lc : IsLocallyConstant s_fn := by
        intro S
        have hpre_S : s_fn ⁻¹' S = ⋃ a ∈ S, W a := by
          ext y
          simp only [Set.mem_preimage, Set.mem_iUnion, exists_prop]
          constructor
          · intro hyS
            exact ⟨s_fn y, hyS, (hs_iff y (s_fn y)).mp rfl⟩
          · rintro ⟨a, haS, hya⟩
            rwa [(hs_iff y a).mpr hya]
        rw [hpre_S]
        exact isOpen_biUnion fun a _ => (hW_clop a).isOpen
      refine ⟨⟨s_fn, hs_lc⟩, ?_⟩
      ext y₀
      change s_fn (f_top y₀) = s₀ y₀
      rw [hs_iff]
      change y₀ ∈ f_top ⁻¹' W (s₀ y₀)
      rw [hW_pre]
      rfl
  
  obtain ⟨hc, hr, hAdd, hLim, hColim⟩ := hPart1
  let M_ℓ : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  have : NeZero ℓ := ⟨(Fact.out : Nat.Prime ℓ).ne_zero⟩
  have hFin_M : Finite ↑M_ℓ := (inferInstance : Finite (ULift.{u, 0} (ZMod ℓ)))
  have hLC_bij : Function.Bijective
      (fun s : LocallyConstant ↥Y ↑M_ℓ => s.comap (TopCat.Hom.hom h.base)) :=
    @hPart4 (↑M_ℓ) hFin_M
  obtain ⟨e_Y, e_Y₀, h_compat⟩ := hPart3 M_ℓ hc
  let e_comap : LocallyConstant ↥Y ↑M_ℓ ≃ LocallyConstant ↥Y₀ ↑M_ℓ :=
    Equiv.ofBijective _ hLC_bij
  obtain ⟨hcℤ, hExt_imp⟩ := @hPart2 M_ℓ hc hr hAdd hLim hColim
  refine ⟨hc, hr, hAdd, hLim, hColim, hcℤ, hExt_imp ⟨?_, ?_⟩⟩
  · intro x₁ x₂ h12
    apply e_Y.injective
    apply e_comap.injective
    exact (h_compat x₁).symm.trans ((congrArg e_Y₀ h12).trans (h_compat x₂))
  · intro z
    let x := e_Y.symm (e_comap.symm (e_Y₀ z))
    refine ⟨x, e_Y₀.injective ?_⟩
    exact (h_compat x).trans
      ((congrArg e_comap (e_Y.apply_symm_apply _)).trans (e_comap.apply_symm_apply (e_Y₀ z)))

theorem weil_projLine_finite_cover_two_chart_gluing_presentation (k : Type u) [Field k]
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (Y : AlgebraicGeometry.Scheme.{u})
    (π : Y ⟶ CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
      (weilProjectiveSpaceOver k 1).hom)
    [AlgebraicGeometry.IsFinite π] :
    ∃ (B : Type u) (_ : CommRing B) (_ : Algebra A B)
      (e_Y : ↑(Y.presheaf.obj (Opposite.op ⊤)) ≃+* B)
      (M₀ M₁ M₀₁ : Type u)
      (_ : CommRing M₀) (_ : Algebra A M₀) (_ : Algebra (Polynomial A) M₀)
      (_ : IsScalarTower A (Polynomial A) M₀) (_ : Module.Finite (Polynomial A) M₀)
      (_ : CommRing M₁) (_ : Algebra A M₁) (_ : Algebra (Polynomial A) M₁)
      (_ : IsScalarTower A (Polynomial A) M₁) (_ : Module.Finite (Polynomial A) M₁)
      (_ : CommRing M₀₁) (_ : Algebra A M₀₁),
      WeilIsTwoChartProjLineCoverRings A (RingHom.ker τ_A.toRingHom)
        B
        ↑((CategoryTheory.Limits.pullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
            (π ≫ CategoryTheory.Limits.pullback.fst
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
              (weilProjectiveSpaceOver k 1).hom)).presheaf.obj (Opposite.op ⊤))
        ((CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop
          (CategoryTheory.Limits.pullback.snd
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
            (π ≫ CategoryTheory.Limits.pullback.fst
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
              (weilProjectiveSpaceOver k 1).hom)))).comp e_Y.symm.toRingHom)
        M₀ M₁ M₀₁ :=
by
  classical
  
  have hι_appLE_eq_topIso_inv : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Opens)
      (hle : (⊤ : (U : AlgebraicGeometry.Scheme.{u}).Opens) ≤
        (TopologicalSpace.Opens.map U.ι.base).obj U),
      U.ι.appLE U ⊤ hle = U.topIso.inv := by
    intro Z U hle
    rw [AlgebraicGeometry.Scheme.Opens.ι_appLE, AlgebraicGeometry.Scheme.Opens.topIso_inv]
    congr 1
  have hTopIso_ι_appLE : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Opens)
      (hle : (⊤ : (U : AlgebraicGeometry.Scheme.{u}).Opens) ≤
        (TopologicalSpace.Opens.map U.ι.base).obj U),
      U.topIso.hom ≫ U.ι.appLE U ⊤ hle = 𝟙 _ := by
    intro Z U hle
    rw [hι_appLE_eq_topIso_inv, CategoryTheory.Iso.hom_inv_id]
  have happLE_top_eq_appTop : ∀ {X Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Z)
      (hle : (⊤ : X.Opens) ≤ (TopologicalSpace.Opens.map f.base).obj ⊤),
      f.appLE ⊤ ⊤ hle = f.appTop := by
    intro X Z f hle
    have h1 : f.appTop = f.appLE ⊤ (f ⁻¹ᵁ ⊤) le_rfl :=
      AlgebraicGeometry.Scheme.Hom.app_eq_appLE f
    exact h1.symm
  have hι_appTop_topIso : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Opens),
      U.ι.appTop ≫ U.topIso.hom =
        Z.presheaf.map (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op := by
    intro Z U
    rw [← cancel_mono U.topIso.inv, CategoryTheory.Category.assoc,
      CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.comp_id]
    have h1 : U.ι.appTop = U.ι.appLE ⊤ (U.ι ⁻¹ᵁ ⊤) le_rfl :=
      AlgebraicGeometry.Scheme.Hom.app_eq_appLE U.ι
    have h2 : U.ι.appLE ⊤ (U.ι ⁻¹ᵁ ⊤) le_rfl =
        Z.presheaf.map (CategoryTheory.homOfLE
          (le_top : (U.ι.opensFunctor).obj (U.ι ⁻¹ᵁ ⊤) ≤ ⊤)).op :=
      AlgebraicGeometry.Scheme.Opens.ι_appLE U ⊤ (U.ι ⁻¹ᵁ ⊤) le_rfl
    have h3a : Z.presheaf.map (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op ≫ U.topIso.inv =
        Z.presheaf.map (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op ≫
          Z.presheaf.map (CategoryTheory.eqToHom U.ι_image_top).op :=
      congrArg (Z.presheaf.map (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op ≫ ·)
        (AlgebraicGeometry.Scheme.Opens.topIso_inv U)
    have h3b : Z.presheaf.map (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op ≫
          Z.presheaf.map (CategoryTheory.eqToHom U.ι_image_top).op =
        Z.presheaf.map (CategoryTheory.homOfLE
          (le_top : (U.ι.opensFunctor).obj (U.ι ⁻¹ᵁ ⊤) ≤ ⊤)).op :=
      (Z.presheaf.map_comp _ _).symm.trans (congrArg Z.presheaf.map (Subsingleton.elim _ _))
    exact (h1.trans h2).trans (h3a.trans h3b).symm
  have hMorphRes_appTop : ∀ {X Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Z) (U : Z.Opens),
      U.topIso.hom ≫ f.app U =
        (f ∣_ U).appTop ≫
          (AlgebraicGeometry.Scheme.Opens.topIso
            ((TopologicalSpace.Opens.map f.base).obj U)).hom := by
    intro X Z f U
    let W : X.Opens := (TopologicalSpace.Opens.map f.base).obj U
    let e_mr : ((f ⁻¹ᵁ U).ι.opensFunctor).obj ⊤ =
        (TopologicalSpace.Opens.map f.base).obj ((U.ι.opensFunctor).obj ⊤) :=
      ((f ⁻¹ᵁ U).ι_image_top).trans
        (congrArg (TopologicalSpace.Opens.map f.base).obj U.ι_image_top.symm)
    have hL1 : U.topIso.hom ≫ f.app U =
        Z.presheaf.map (CategoryTheory.eqToHom U.ι_image_top.symm).op ≫ f.app U :=
      congrArg (· ≫ f.app U) (AlgebraicGeometry.Scheme.Opens.topIso_hom U)
    have hL2 : Z.presheaf.map (CategoryTheory.eqToHom U.ι_image_top.symm).op ≫ f.app U =
        f.app ((U.ι.opensFunctor).obj ⊤) ≫
          X.presheaf.map ((TopologicalSpace.Opens.map f.base).map
            (CategoryTheory.eqToHom U.ι_image_top.symm)).op :=
      AlgebraicGeometry.Scheme.Hom.naturality f
        (CategoryTheory.eqToHom U.ι_image_top.symm).op
    have hR1a : (f ∣_ U).appTop ≫ W.topIso.hom =
        (f.app ((U.ι.opensFunctor).obj ⊤) ≫
          X.presheaf.map (CategoryTheory.eqToHom e_mr).op) ≫ W.topIso.hom :=
      congrArg (· ≫ W.topIso.hom) (AlgebraicGeometry.morphismRestrict_appTop f U)
    have hR1b : (f.app ((U.ι.opensFunctor).obj ⊤) ≫
          X.presheaf.map (CategoryTheory.eqToHom e_mr).op) ≫ W.topIso.hom =
        (f.app ((U.ι.opensFunctor).obj ⊤) ≫
          X.presheaf.map (CategoryTheory.eqToHom e_mr).op) ≫
          X.presheaf.map (CategoryTheory.eqToHom W.ι_image_top.symm).op :=
      congrArg ((f.app ((U.ι.opensFunctor).obj ⊤) ≫
        X.presheaf.map (CategoryTheory.eqToHom e_mr).op) ≫ ·)
        (AlgebraicGeometry.Scheme.Opens.topIso_hom W)
    have hR2 : (f.app ((U.ι.opensFunctor).obj ⊤) ≫
          X.presheaf.map (CategoryTheory.eqToHom e_mr).op) ≫
          X.presheaf.map (CategoryTheory.eqToHom W.ι_image_top.symm).op =
        f.app ((U.ι.opensFunctor).obj ⊤) ≫
          X.presheaf.map ((TopologicalSpace.Opens.map f.base).map
            (CategoryTheory.eqToHom U.ι_image_top.symm)).op := by
      rw [CategoryTheory.Category.assoc, ← X.presheaf.map_comp]
      congr 2
    exact (hL1.trans hL2).trans ((hR1a.trans hR1b).trans hR2).symm

  
  have hSheafEq : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V₀ V₁ : Z.Opens), V₀ ⊔ V₁ = ⊤ →
      let r₀ := CommRingCat.Hom.hom (Z.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op)
      let r₁ := CommRingCat.Hom.hom (Z.presheaf.map (CategoryTheory.homOfLE (le_top : V₁ ≤ ⊤)).op)
      let res₀ := CommRingCat.Hom.hom (Z.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op)
      let res₁ := CommRingCat.Hom.hom (Z.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op)
      (∀ b : ↑(Z.presheaf.obj (Opposite.op ⊤)), res₀ (r₀ b) = res₁ (r₁ b)) ∧
      (∀ b₁ b₂ : ↑(Z.presheaf.obj (Opposite.op ⊤)), r₀ b₁ = r₀ b₂ → r₁ b₁ = r₁ b₂ → b₁ = b₂) ∧
      (∀ (x₀ : ↑(Z.presheaf.obj (Opposite.op V₀))) (x₁ : ↑(Z.presheaf.obj (Opposite.op V₁))),
        res₀ x₀ = res₁ x₁ →
        ∃ b : ↑(Z.presheaf.obj (Opposite.op ⊤)), r₀ b = x₀ ∧ r₁ b = x₁) := by
    intro Z V₀ V₁ hcov
    dsimp only
    refine ⟨?_, ?_, ?_⟩
    · intro b
      have hcomp : Z.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op ≫
            Z.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op =
          Z.presheaf.map (CategoryTheory.homOfLE (le_top : V₁ ≤ ⊤)).op ≫
            Z.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op := by
        rw [← Z.presheaf.map_comp, ← Z.presheaf.map_comp]
        congr 1
      exact congrArg (fun φ => CommRingCat.Hom.hom φ b) hcomp
    · intro b₁ b₂ hb₀ hb₁
      exact Z.sheaf.eq_of_locally_eq₂
        (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤))
        (CategoryTheory.homOfLE (le_top : V₁ ≤ ⊤))
        hcov.ge b₁ b₂ hb₀ hb₁
    · intro x₀ x₁ hx
      let U_b : Bool → Z.Opens := fun i => match i with | true => V₀ | false => V₁
      let iUV : ∀ i : Bool, U_b i ⟶ ⊤ := fun _ => CategoryTheory.homOfLE le_top
      let sf : ∀ i : Bool, ↑(Z.presheaf.obj (Opposite.op (U_b i))) := fun i =>
        match i with | true => x₀ | false => x₁
      have htop_le : (⊤ : Z.Opens) ≤ iSup U_b := by
        intro z hz
        have hz' : z ∈ V₀ ⊔ V₁ := hcov.symm ▸ hz
        rw [TopologicalSpace.Opens.mem_iSup]
        rcases hz' with hz₀ | hz₁
        · exact ⟨true, hz₀⟩
        · exact ⟨false, hz₁⟩
      have hcompat : TopCat.Presheaf.IsCompatible Z.presheaf U_b sf := by
        intro i j
        cases i <;> cases j
        · dsimp [U_b, sf]
          have heq : TopologicalSpace.Opens.infLELeft V₁ V₁ =
              TopologicalSpace.Opens.infLERight V₁ V₁ := Subsingleton.elim _ _
          rw [heq]
        · dsimp [U_b, sf]
          let c : V₁ ⊓ V₀ ⟶ V₀ ⊓ V₁ := CategoryTheory.homOfLE (le_inf inf_le_right inf_le_left)
          have hc₁ : Z.presheaf.map (TopologicalSpace.Opens.infLELeft V₁ V₀).op =
              Z.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op ≫
                Z.presheaf.map c.op := by
            rw [← Z.presheaf.map_comp]
            congr 1
          have hc₀ : Z.presheaf.map (TopologicalSpace.Opens.infLERight V₁ V₀).op =
              Z.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op ≫
                Z.presheaf.map c.op := by
            rw [← Z.presheaf.map_comp]
            congr 1
          change CommRingCat.Hom.hom (Z.presheaf.map (TopologicalSpace.Opens.infLELeft V₁ V₀).op) x₁ =
            CommRingCat.Hom.hom (Z.presheaf.map (TopologicalSpace.Opens.infLERight V₁ V₀).op) x₀
          rw [hc₁, hc₀]
          exact congrArg (CommRingCat.Hom.hom (Z.presheaf.map c.op)) hx.symm
        · dsimp [U_b, sf]
          exact hx
        · dsimp [U_b, sf]
          have heq : TopologicalSpace.Opens.infLELeft V₀ V₀ =
              TopologicalSpace.Opens.infLERight V₀ V₀ := Subsingleton.elim _ _
          rw [heq]
      obtain ⟨b, hb, -⟩ := Z.sheaf.existsUnique_gluing' U_b ⊤ iUV htop_le sf hcompat
      exact ⟨b, hb true, hb false⟩

  have hBasicAway : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U V : Z.Opens)
      (_ : AlgebraicGeometry.IsAffineOpen U) (hle : V ≤ U)
      (f : ↑(Z.presheaf.obj (Opposite.op U))),
      Z.basicOpen f = V →
      let ρ := CommRingCat.Hom.hom (Z.presheaf.map (CategoryTheory.homOfLE hle).op)
      AlgebraicGeometry.IsAffineOpen V ∧
      (∀ w : ↑(Z.presheaf.obj (Opposite.op V)),
        ∃ (n : ℕ) (x : ↑(Z.presheaf.obj (Opposite.op U))), (ρ f) ^ n * w = ρ x) ∧
      (∀ x : ↑(Z.presheaf.obj (Opposite.op U)), ρ x = 0 → ∃ n : ℕ, f ^ n * x = 0) := by
    intro Z U V hU hle f hV
    subst hV
    dsimp only
    have _ : IsLocalization.Away f ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen f))) :=
      hU.isLocalization_basicOpen f
    have halg : algebraMap ↑(Z.presheaf.obj (Opposite.op U))
        ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen f))) =
        CommRingCat.Hom.hom (Z.presheaf.map (CategoryTheory.homOfLE hle).op) := by
      change CommRingCat.Hom.hom (Z.presheaf.map (CategoryTheory.homOfLE (Z.basicOpen_le f)).op) =
        CommRingCat.Hom.hom (Z.presheaf.map (CategoryTheory.homOfLE hle).op)
      congr 2
    refine ⟨hU.basicOpen f, ?_, ?_⟩
    · intro w
      obtain ⟨n, x, hnx⟩ := IsLocalization.Away.surj f w
      refine ⟨n, x, ?_⟩
      rw [← halg, mul_comm]
      exact hnx
    · intro x hx
      rw [← halg] at hx
      obtain ⟨⟨_, n, rfl⟩, hpow⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers f)
          ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen f))) x).mp hx
      exact ⟨n, hpow⟩

  
  have hSpecialFiberQuot : ∀ (f_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
      (U : Y.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      let ι_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom)
      let Y₀ := CategoryTheory.Limits.pullback ι_A f_Y
      let i_Y := CategoryTheory.Limits.pullback.snd ι_A f_Y
      let U₀ : Y₀.Opens := (TopologicalSpace.Opens.map i_Y.base).obj U
      let σ_U : A →+* ↑(Y.presheaf.obj (Opposite.op U)) :=
        (CommRingCat.Hom.hom (Y.presheaf.map (CategoryTheory.homOfLE le_top).op)).comp
          (CommRingCat.Hom.hom
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ f_Y.appTop))
      ∃ (Φ_U : ↑(Y₀.presheaf.obj (Opposite.op U₀)) ≃+*
          (↑(Y.presheaf.obj (Opposite.op U)) ⧸ Ideal.map σ_U (RingHom.ker τ_A.toRingHom))),
        ∀ x : ↑(Y.presheaf.obj (Opposite.op U)),
          Φ_U ((CommRingCat.Hom.hom (i_Y.app U)) x) =
            Ideal.Quotient.mk (Ideal.map σ_U (RingHom.ker τ_A.toRingHom)) x := by
    intro f_Y U hU
    dsimp only
    let ι_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom)
    let Y₀ := CategoryTheory.Limits.pullback ι_A f_Y
    let i_Y := CategoryTheory.Limits.pullback.snd ι_A f_Y
    let U₀ : Y₀.Opens := (TopologicalSpace.Opens.map i_Y.base).obj U
    let M_U := ↑(Y.presheaf.obj (Opposite.op U))
    let σ_U : A →+* M_U :=
      (CommRingCat.Hom.hom (Y.presheaf.map (CategoryTheory.homOfLE le_top).op)).comp
        (CommRingCat.Hom.hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ f_Y.appTop))
    let 𝔪 := RingHom.ker τ_A.toRingHom
    let J_U : Ideal M_U := Ideal.map σ_U 𝔪
    let q_U : M_U →+* (M_U ⧸ J_U) := Ideal.Quotient.mk J_U
    let ι_k : k →+* (M_U ⧸ J_U) := q_U.comp (σ_U.comp (algebraMap k A))
    have hcomm_push : CommRingCat.ofHom τ_A.toRingHom ≫ CommRingCat.ofHom ι_k =
        CommRingCat.ofHom σ_U ≫ CommRingCat.ofHom q_U := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      change q_U (σ_U (algebraMap k A (τ_A a))) = q_U (σ_U a)
      rw [← sub_eq_zero, ← map_sub, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      apply Ideal.mem_map_of_mem
      change τ_A (algebraMap k A (τ_A a) - a) = 0
      rw [map_sub, τ_A.commutes]
      exact sub_self (τ_A a)
    let cocone_Q := CategoryTheory.Limits.PushoutCocone.mk
      (CommRingCat.ofHom ι_k) (CommRingCat.ofHom q_U) hcomm_push
    have hcolim_Q : CategoryTheory.Limits.IsColimit cocone_Q := by
      refine CategoryTheory.Limits.PushoutCocone.isColimitAux' _ ?_
      intro s
      have hker : J_U ≤ RingHom.ker s.inr.hom := by
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        change s.inr.hom (σ_U a) = 0
        have hw : (CommRingCat.ofHom τ_A.toRingHom ≫ s.inl).hom a =
            (CommRingCat.ofHom σ_U ≫ s.inr).hom a :=
          congrArg (fun φ => CommRingCat.Hom.hom φ a) s.condition
        change s.inl.hom (τ_A a) = s.inr.hom (σ_U a) at hw
        have ha0 : τ_A a = 0 := ha
        rw [← hw, ha0, map_zero]
      let desc_hom : (M_U ⧸ J_U) →+* s.pt := Ideal.Quotient.lift J_U s.inr.hom hker
      refine ⟨CommRingCat.ofHom desc_hom, ?_, ?_, ?_⟩
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        change desc_hom (q_U (σ_U (algebraMap k A c))) = s.inl.hom c
        have h1 : desc_hom (q_U (σ_U (algebraMap k A c))) = s.inr.hom (σ_U (algebraMap k A c)) :=
          rfl
        have hw : s.inl.hom (τ_A (algebraMap k A c)) = s.inr.hom (σ_U (algebraMap k A c)) :=
          congrArg (fun φ => CommRingCat.Hom.hom φ (algebraMap k A c)) s.condition
        rw [h1, ← hw, τ_A.commutes]
        rfl
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        rfl
      · intro m _ h_inr
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro z
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
        exact congrArg (fun φ => CommRingCat.Hom.hom φ x) h_inr
    have hPB_Spec : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_k))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_U))
        ι_A (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_U)) :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
        (CategoryTheory.IsPushout.of_isColimit hcolim_Q)
    have hm_eq : U.ι ≫ f_Y =
        hU.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_U) := by
      rw [← cancel_mono (AlgebraicGeometry.Spec (CommRingCat.of A)).toSpecΓ,
        AlgebraicGeometry.Scheme.toSpecΓ_naturality,
        AlgebraicGeometry.Scheme.toSpecΓ_naturality]
      congr 2
      rw [← cancel_epi (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv,
        ← cancel_mono U.topIso.hom]
      have hL : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
          (U.ι ≫ f_Y).appTop ≫ U.topIso.hom = CommRingCat.ofHom σ_U := by
        rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc,
          hι_appTop_topIso, ← CategoryTheory.Category.assoc]
        rfl
      have hR : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
          (hU.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_U)).appTop ≫
          U.topIso.hom = CommRingCat.ofHom σ_U := by
        calc (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
              (hU.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_U)).appTop ≫
              U.topIso.hom
            = ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_U)).appTop) ≫
                hU.isoSpec.hom.appTop ≫ U.topIso.hom := by
              rw [AlgebraicGeometry.Scheme.Hom.comp_appTop]
              simp only [CategoryTheory.Category.assoc]
          _ = CommRingCat.ofHom σ_U ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of M_U)).inv ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op U))).hom ≫
                U.topIso.inv ≫ U.topIso.hom := by
              rw [← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality,
                AlgebraicGeometry.IsAffineOpen.isoSpec_hom_appTop]
              simp only [CategoryTheory.Category.assoc]
          _ = CommRingCat.ofHom σ_U := by
              change CommRingCat.ofHom σ_U ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op U))).inv ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op U))).hom ≫
                U.topIso.inv ≫ U.topIso.hom = CommRingCat.ofHom σ_U
              rw [CategoryTheory.Iso.inv_hom_id_assoc, CategoryTheory.Iso.inv_hom_id]
              exact CategoryTheory.Category.comp_id _
      exact hL.trans hR.symm
    have hPB_res : CategoryTheory.IsPullback
        (U₀.ι ≫ CategoryTheory.Limits.pullback.fst ι_A f_Y)
        (i_Y ∣_ U) ι_A (U.ι ≫ f_Y) :=
      ((AlgebraicGeometry.isPullback_morphismRestrict i_Y U).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback ι_A f_Y).flip).flip
    have hPB_iso : CategoryTheory.IsPullback
        (U₀.ι ≫ CategoryTheory.Limits.pullback.fst ι_A f_Y)
        ((i_Y ∣_ U) ≫ hU.isoSpec.hom)
        ι_A (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_U)) :=
      hPB_res.of_iso (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) hU.isoSpec
        (CategoryTheory.Iso.refl _) (by simp) (by simp) (by simp) (by simp [hm_eq])
    have hex_θ : ∃ θ_U : (U₀ : AlgebraicGeometry.Scheme.{u}) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (M_U ⧸ J_U)),
        θ_U.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_U) =
          (i_Y ∣_ U) ≫ hU.isoSpec.hom :=
      ⟨CategoryTheory.IsPullback.isoIsPullback _ _ hPB_iso hPB_Spec,
        CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPB_iso hPB_Spec⟩
    obtain ⟨θ_U, hθ_snd⟩ := hex_θ
    let Ψ_U : Y₀.presheaf.obj (Opposite.op U₀) ≅ CommRingCat.of (M_U ⧸ J_U) :=
      U₀.topIso.symm ≪≫
        { hom := θ_U.inv.appTop
          inv := θ_U.hom.appTop
          hom_inv_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Iso.hom_inv_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Iso.inv_hom_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop] } ≪≫
        AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (M_U ⧸ J_U))
    have hq_Ψ : CommRingCat.ofHom q_U ≫ Ψ_U.inv = i_Y.app U := by
      calc CommRingCat.ofHom q_U ≫ Ψ_U.inv
          = (CommRingCat.ofHom q_U ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (M_U ⧸ J_U))).inv) ≫
              θ_U.hom.appTop ≫ U₀.topIso.hom := by
            dsimp [Ψ_U]
            simp only [CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of M_U)).inv ≫
              ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_U)).appTop ≫ θ_U.hom.appTop) ≫
              U₀.topIso.hom := by
            rw [AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality]
            simp only [CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of M_U)).inv ≫
              ((AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op U))).hom ≫
                U.topIso.inv) ≫ (U.topIso.hom ≫ i_Y.app U) := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hθ_snd,
              AlgebraicGeometry.Scheme.Hom.comp_appTop,
              AlgebraicGeometry.IsAffineOpen.isoSpec_hom_appTop]
            simp only [CategoryTheory.Category.assoc]
            rw [← hMorphRes_appTop i_Y U]
        _ = i_Y.app U := by
            change (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op U))).inv ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op U))).hom ≫
              U.topIso.inv ≫ U.topIso.hom ≫ i_Y.app U = i_Y.app U
            rw [CategoryTheory.Iso.inv_hom_id_assoc, CategoryTheory.Iso.inv_hom_id_assoc]
    have hΨ_app : i_Y.app U ≫ Ψ_U.hom = CommRingCat.ofHom q_U := by
      rw [← hq_Ψ, CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.comp_id]
    refine ⟨Ψ_U.commRingCatIsoToRingEquiv, fun x => ?_⟩
    exact congrArg (fun φ => CommRingCat.Hom.hom φ x) hΨ_app

  
  have hBaseChangePoly : ∀ (P : AlgebraicGeometry.Scheme.{u})
      (p_P : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      (D : P.Opens)
      (α : (D : AlgebraicGeometry.Scheme.{u}) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (s : ↑(P.presheaf.obj (Opposite.op D))),
      α.inv ≫ D.ι ≫ p_P =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k))) →
      (CommRingCat.Hom.hom
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
          α.hom.appTop ≫ D.topIso.hom)) Polynomial.X = s →
      let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
      let X_A := CategoryTheory.Limits.pullback s_A p_P
      let p₁ := CategoryTheory.Limits.pullback.fst s_A p_P
      let p₂ := CategoryTheory.Limits.pullback.snd s_A p_P
      let W : X_A.Opens := (TopologicalSpace.Opens.map p₂.base).obj D
