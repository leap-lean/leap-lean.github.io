    have hsec₁ := he₁_sec (θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] x))
    have hsec₀ := he₀_sec ((1 : D.R₀₁) ⊗ₜ[D.R₀] x)
    dsimp at hθ_x
    rw [hsec₁, hsec₀] at hθ_x
    exact hθ_x
  · intro F e₀ e₁ q u₀ u₁ hBdl hCob
    obtain ⟨hCoc₀, hCoc₁, hOv₀₁, -⟩ := hBdl
    let σ₀ : F.L₀ →ₗ[D.R₀] T₀ :=
      e₀.toLinearMap.restrictScalars D.R₀ ∘ₗ TensorProduct.mk D.R₀ T₀ F.L₀ 1
    let σ₁ : F.L₁ →ₗ[D.R₁] T₁ :=
      e₁.toLinearMap.restrictScalars D.R₁ ∘ₗ TensorProduct.mk D.R₁ T₁ F.L₁ 1
    have hu₀_coc : ((1 : T₀) ⊗ₜ[D.R₀] (u₀ : T₀) : TensorProduct D.R₀ T₀ T₀) =
        (q.g₀₀ : TensorProduct D.R₀ T₀ T₀) * ((u₀ : T₀) ⊗ₜ[D.R₀] (1 : T₀)) := by
      rw [hCob]
      let u₀_R : Units (TensorProduct D.R₀ T₀ T₀) :=
        Units.map (Algebra.TensorProduct.includeRight (R := D.R₀) (A := T₀) (B := T₀)).toRingHom.toMonoidHom u₀
      let u₀_L : Units (TensorProduct D.R₀ T₀ T₀) :=
        Units.map (Algebra.TensorProduct.includeLeftRingHom (R := D.R₀) (A := T₀) (B := T₀)).toMonoidHom u₀
      have h_units : u₀_R * u₀_L⁻¹ * u₀_L = u₀_R := inv_mul_cancel_right u₀_R u₀_L
      have h_val : ((u₀_R * u₀_L⁻¹ : Units _) : TensorProduct D.R₀ T₀ T₀) * (u₀_L : TensorProduct D.R₀ T₀ T₀) =
          (u₀_R : TensorProduct D.R₀ T₀ T₀) := by
        exact_mod_cast h_units
      exact h_val.symm
    have hu₁_coc : ((1 : T₁) ⊗ₜ[D.R₁] (u₁ : T₁) : TensorProduct D.R₁ T₁ T₁) =
        (q.g₁₁ : TensorProduct D.R₁ T₁ T₁) * ((u₁ : T₁) ⊗ₜ[D.R₁] (1 : T₁)) := by
      rw [hCob]
      let u₁_R : Units (TensorProduct D.R₁ T₁ T₁) :=
        Units.map (Algebra.TensorProduct.includeRight (R := D.R₁) (A := T₁) (B := T₁)).toRingHom.toMonoidHom u₁
      let u₁_L : Units (TensorProduct D.R₁ T₁ T₁) :=
        Units.map (Algebra.TensorProduct.includeLeftRingHom (R := D.R₁) (A := T₁) (B := T₁)).toMonoidHom u₁
      have h_units : u₁_R * u₁_L⁻¹ * u₁_L = u₁_R := inv_mul_cancel_right u₁_R u₁_L
      have h_val : ((u₁_R * u₁_L⁻¹ : Units _) : TensorProduct D.R₁ T₁ T₁) * (u₁_L : TensorProduct D.R₁ T₁ T₁) =
          (u₁_R : TensorProduct D.R₁ T₁ T₁) := by
        exact_mod_cast h_units
      exact h_val.symm
    obtain ⟨s₀, hs₀⟩ :=
      ((amitsur_and_twisted_eq D.R₀ T₀ F.L₀).2.2 e₀ (q.g₀₀ : TensorProduct D.R₀ T₀ T₀) hCoc₀).2
        (u₀ : T₀) hu₀_coc
    obtain ⟨s₁, hs₁⟩ :=
      ((amitsur_and_twisted_eq D.R₁ T₁ F.L₁).2.2 e₁ (q.g₁₁ : TensorProduct D.R₁ T₁ T₁) hCoc₁).2
        (u₁ : T₁) hu₁_coc
    obtain ⟨φ₀, hφ₀_s, hφ₀_smul⟩ := chart_unit_basis D.R₀ T₀ F.L₀ e₀ s₀ u₀ hs₀
    obtain ⟨φ₁, hφ₁_s, -⟩ := chart_unit_basis D.R₁ T₁ F.L₁ e₁ s₁ u₁ hs₁
    let T₀_ov := weilTwoChartOv₀ D T₀
    let T₁_ov := weilTwoChartOv₁ D T₁
    letI : CommRing T₀_ov := inferInstance
    letI : Algebra D.R₀₁ T₀_ov := inferInstance
    letI : Module.FaithfullyFlat D.R₀₁ T₀_ov := inferInstance
    letI : CommRing T₁_ov := inferInstance
    letI : Algebra D.R₀₁ T₁_ov := inferInstance
    letI : Module.FaithfullyFlat D.R₀₁ T₁_ov := inferInstance
    let A₀₁ := TensorProduct D.R₀₁ T₀_ov T₁_ov
    letI : CommRing A₀₁ := inferInstance
    have hθ_s : F.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] s₀) = (1 : D.R₀₁) ⊗ₜ[D.R₁] s₁ := by
      obtain ⟨e₁_ov, he₁_sec, hCoc₁_ov⟩ :=
        baseChange_triv D.R₁ D.R₀₁ T₁ F.L₁ e₁ (q.g₁₁ : TensorProduct D.R₁ T₁ T₁) hCoc₁
      have hInj_σ₁_ov : Function.Injective (LinearMap.lTensor D.R₀₁ σ₁) := by
        have hInj_e₁ :=
          ((amitsur_and_twisted_eq D.R₀₁ T₁_ov (TensorProduct D.R₁ D.R₀₁ F.L₁)).2.2
            e₁_ov _ hCoc₁_ov).1
        intro m m' hmm'
        apply hInj_e₁
        change e₁_ov ((1 : T₁_ov) ⊗ₜ[D.R₀₁] m) = e₁_ov ((1 : T₁_ov) ⊗ₜ[D.R₀₁] m')
        rw [he₁_sec m, he₁_sec m', hmm']
      have hInj_η₀₁ := (amitsur_and_twisted_eq D.R₀₁ T₀_ov T₁_ov).1.1
      apply hInj_σ₁_ov
      apply hInj_η₀₁
      have hov := hOv₀₁ s₀
      change ((1 : T₀_ov) ⊗ₜ[D.R₀₁] LinearMap.lTensor D.R₀₁ σ₁ (F.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] s₀)) : A₀₁) =
        ((1 : T₀_ov) ⊗ₜ[D.R₀₁] LinearMap.lTensor D.R₀₁ σ₁ ((1 : D.R₀₁) ⊗ₜ[D.R₁] s₁) : A₀₁)
      rw [hov, hs₀, LinearMap.lTensor_tmul, hs₁, hCob]
      let ι₀₁_L : T₀ →+* A₀₁ :=
        (Algebra.TensorProduct.includeLeftRingHom (R := D.R₀₁) (A := T₀_ov) (B := T₁_ov)).comp
          (Algebra.TensorProduct.includeRight (R := D.R₀) (A := D.R₀₁) (B := T₀)).toRingHom
      let ι₀₁_R : T₁ →+* A₀₁ :=
        (Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := T₀_ov) (B := T₁_ov)).toRingHom.comp
          (Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := T₁)).toRingHom
      let v₁_R : Units A₀₁ := Units.map ι₀₁_R.toMonoidHom u₁
      let v₀_L : Units A₀₁ := Units.map ι₀₁_L.toMonoidHom u₀
      have h_units : v₁_R * v₀_L⁻¹ * v₀_L = v₁_R := inv_mul_cancel_right v₁_R v₀_L
      have h_val : ((v₁_R * v₀_L⁻¹ : Units A₀₁) : A₀₁) * (v₀_L : A₀₁) = (v₁_R : A₀₁) := by
        exact_mod_cast h_units
      exact h_val
    dsimp only [WeilTwoChartIso, WeilTwoChartTrivial]
    refine ⟨φ₀, φ₁, ?_⟩
    have h_base :
        ((TensorProduct.AlgebraTensorModule.rid D.R₁ D.R₀₁ D.R₀₁).symm
          ((TensorProduct.AlgebraTensorModule.rid D.R₀ D.R₀₁ D.R₀₁)
            (LinearEquiv.baseChange D.R₀ D.R₀₁ F.L₀ D.R₀ φ₀ ((1 : D.R₀₁) ⊗ₜ[D.R₀] s₀)))) =
        LinearEquiv.baseChange D.R₁ D.R₀₁ F.L₁ D.R₁ φ₁ (F.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] s₀)) := by
      rw [LinearEquiv.baseChange_tmul, hφ₀_s, TensorProduct.AlgebraTensorModule.rid_tmul,
        one_smul, TensorProduct.AlgebraTensorModule.rid_symm_apply, hθ_s,
        LinearEquiv.baseChange_tmul, hφ₁_s]
    ext z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul r₀₁ x =>
      have hx : (r₀₁ ⊗ₜ[D.R₀] x : TensorProduct D.R₀ D.R₀₁ F.L₀) =
          (φ₀ x • r₀₁) • ((1 : D.R₀₁) ⊗ₜ[D.R₀] s₀) := by
        calc
          (r₀₁ ⊗ₜ[D.R₀] x : TensorProduct D.R₀ D.R₀₁ F.L₀)
              = r₀₁ ⊗ₜ[D.R₀] (φ₀ x • s₀) := by rw [hφ₀_smul x]
          _ = (φ₀ x • r₀₁) ⊗ₜ[D.R₀] s₀ := (TensorProduct.smul_tmul (φ₀ x) r₀₁ s₀).symm
          _ = (φ₀ x • r₀₁) • ((1 : D.R₀₁) ⊗ₜ[D.R₀] s₀) := by
              rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [hx, map_smul, map_smul]
      congr 1
    | add z₁ z₂ ih₁ ih₂ =>
      simp only [map_add, ih₁, ih₂]

theorem weil_twoChart_etale_cover_cech_quad_bridge (Z : AlgebraicGeometry.Scheme.{u})
    {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
    (j₀ : AlgebraicGeometry.Spec (CommRingCat.of D.R₀) ⟶ Z) [AlgebraicGeometry.IsOpenImmersion j₀]
    (j₁ : AlgebraicGeometry.Spec (CommRingCat.of D.R₁) ⟶ Z) [AlgebraicGeometry.IsOpenImmersion j₁]
    (hCov : Set.range j₀.base ∪ Set.range j₁.base = Set.univ)
    (hPb : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ D.R₀₁)))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ D.R₀₁)))
      j₀ j₁)
    (T₀ T₁ : Type u) [CommRing T₀] [CommRing T₁]
    [Algebra D.R₀ T₀] [Algebra D.R₁ T₁]
    [Algebra.Etale D.R₀ T₀] [Algebra.Etale D.R₁ T₁]
    (hSurj₀ : AlgebraicGeometry.Surjective
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀))))
    (hSurj₁ : AlgebraicGeometry.Surjective
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁)))) :
    let g_cov : CategoryTheory.Limits.coprod
        (AlgebraicGeometry.Spec (CommRingCat.of T₀))
        (AlgebraicGeometry.Spec (CommRingCat.of T₁)) ⟶ Z :=
      CategoryTheory.Limits.coprod.desc
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀)) ≫ j₀)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁)) ≫ j₁)
    (Module.FaithfullyFlat D.R₀ T₀ ∧
      Module.FaithfullyFlat D.R₁ T₁ ∧
      ∃ hEt : AlgebraicGeometry.Etale g_cov,
        let W : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ g_cov hEt
        let w : W ⟶ weilEtaleIdTerminal.{u} Z := (weilEtaleIdTerminalIsTerminal.{u} Z).from W
        AlgebraicGeometry.Surjective w.left) ∧
    (∀ hEt : AlgebraicGeometry.Etale g_cov,
      let W : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ g_cov hEt
      let w : W ⟶ weilEtaleIdTerminal.{u} Z := (weilEtaleIdTerminalIsTerminal.{u} Z).from W
      letI : CommRing (weilTwoChartOv₀ D T₀) := inferInstance
      letI : Algebra D.R₀₁ (weilTwoChartOv₀ D T₀) := inferInstance
      letI : CommRing (weilTwoChartOv₁ D T₁) := inferInstance
      letI : Algebra D.R₀₁ (weilTwoChartOv₁ D T₁) := inferInstance
      (∀ c : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 1))),
        ∃! q : WeilTwoChartUnitQuad D T₀ T₁,
          WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w c q) ∧
      (∀ q : WeilTwoChartUnitQuad D T₀ T₁,
        ∃! c : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 1))),
          WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w c q) ∧
      WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w 0 (weilTwoChartQuadOne D T₀ T₁) ∧
      (∀ (c₁ c₂ : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 1))))
          (q₁ q₂ : WeilTwoChartUnitQuad D T₀ T₁),
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w c₁ q₁ →
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w c₂ q₂ →
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w (c₁ + c₂) (weilTwoChartQuadMul q₁ q₂) ∧
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w (c₁ - c₂)
          ⟨q₁.g₀₀ * q₂.g₀₀⁻¹, q₁.g₀₁ * q₂.g₀₁⁻¹, q₁.g₁₀ * q₂.g₁₀⁻¹, q₁.g₁₁ * q₂.g₁₁⁻¹⟩) ∧
      (∀ (c : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 1))))
          (q : WeilTwoChartUnitQuad D T₀ T₁) (n : ℕ),
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w c q →
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w (n • c) (weilTwoChartQuadPow q n)) ∧
      (∀ (c : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 1))))
          (q : WeilTwoChartUnitQuad D T₀ T₁),
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w c q →
        ((∃ b : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 0))),
            weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 0 b = c) ↔
          ∃ (u₀ : Units T₀) (u₁ : Units T₁), q = weilTwoChartCoboundary D u₀ u₁)) ∧
      (∀ (c : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 1))))
          (q : WeilTwoChartUnitQuad D T₀ T₁),
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w c q →
        (c ∈ (weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1).ker ↔
          WeilIsTwoChartAlgCocycle D q))) :=
by
  
  have prod_cover_disjoint : ∀ {Q X₁ X₂ : Type u} (p₁ : Q → X₁) (p₂ : Q → X₂)
      {I₁ I₂ : Type} (S₁ : I₁ → Set X₁) (S₂ : I₂ → Set X₂) (R : I₁ × I₂ → Set Q),
      (∀ ij : I₁ × I₂, R ij = p₁ ⁻¹' (S₁ ij.1) ∩ p₂ ⁻¹' (S₂ ij.2)) →
      (⋃ i₁ : I₁, S₁ i₁) = Set.univ →
      Pairwise (fun i₁ j₁ : I₁ => Disjoint (S₁ i₁) (S₁ j₁)) →
      (⋃ i₂ : I₂, S₂ i₂) = Set.univ →
      Pairwise (fun i₂ j₂ : I₂ => Disjoint (S₂ i₂) (S₂ j₂)) →
      (⋃ ij : I₁ × I₂, R ij) = Set.univ ∧
      Pairwise (fun ij kl : I₁ × I₂ => Disjoint (R ij) (R kl)) := by
    intro Q X₁ X₂ p₁ p₂ I₁ I₂ S₁ S₂ R hR hC₁ hD₁ hC₂ hD₂
    constructor
    · ext q
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      have h₁ : p₁ q ∈ ⋃ i₁ : I₁, S₁ i₁ := hC₁.symm ▸ Set.mem_univ (p₁ q)
      have h₂ : p₂ q ∈ ⋃ i₂ : I₂, S₂ i₂ := hC₂.symm ▸ Set.mem_univ (p₂ q)
      obtain ⟨i₁, hi₁⟩ := Set.mem_iUnion.mp h₁
      obtain ⟨i₂, hi₂⟩ := Set.mem_iUnion.mp h₂
      refine ⟨(i₁, i₂), ?_⟩
      rw [hR (i₁, i₂)]
      exact ⟨hi₁, hi₂⟩
    · intro ij kl hne
      rw [Set.disjoint_left]
      intro q hq₁ hq₂
      rw [hR ij] at hq₁
      rw [hR kl] at hq₂
      by_cases h1 : ij.1 = kl.1
      · have h2 : ij.2 ≠ kl.2 := fun h2 => hne (Prod.ext h1 h2)
        exact Set.disjoint_left.mp (hD₂ h2) hq₁.2 hq₂.2
      · exact Set.disjoint_left.mp (hD₁ h1) hq₁.1 hq₂.1

  have disjoint_units_bijective : ∀ (P : AlgebraicGeometry.Scheme.{u})
      {I : Type} (A : I → Type u) [∀ i : I, CommRing (A i)]
      (κ : ∀ i : I, AlgebraicGeometry.Spec (CommRingCat.of (A i)) ⟶ P)
      [∀ i : I, AlgebraicGeometry.IsOpenImmersion (κ i)],
      (⋃ i : I, Set.range (κ i).base) = Set.univ →
      Pairwise (fun i j : I => Disjoint (Set.range (κ i).base) (Set.range (κ j).base)) →
      ∀ g : (∀ i : I, Units (A i)),
        ∃! u : Units ↑(P.presheaf.obj (Opposite.op ⊤)),
          (∀ i : I,
            Units.map ((κ i).appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (A i))).hom).hom.toMonoidHom u = g i) := by
    intro P I A _ κ _ hCovP hDisjP
    let U : I → P.Opens := fun i => (κ i).opensRange
    have hSup : iSup U = ⊤ := by
      apply top_unique
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hx : x ∈ ⋃ i : I, Set.range (κ i).base := hCovP.symm ▸ Set.mem_univ x
      exact Set.mem_iUnion.mp hx
    have hBot : ∀ {i j : I}, i ≠ j → U i ⊓ U j = ⊥ := by
      intro i j hij
      ext x
      simp only [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff, SetLike.mem_coe,
        TopologicalSpace.Opens.mem_bot, iff_false, not_and]
      intro hi hj
      exact Set.disjoint_left.mp (hDisjP hij) hi hj
    let e : ∀ i : I, AlgebraicGeometry.Spec (CommRingCat.of (A i)) ≅ (U i).toScheme :=
      fun i => AlgebraicGeometry.Scheme.Hom.isoOpensRange (κ i)
    let θ_hom : ∀ i : I, P.presheaf.obj (Opposite.op (U i)) ⟶ CommRingCat.of (A i) :=
      fun i => (U i).topIso.inv ≫ (e i).hom.appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (A i))).hom
    let θ_inv : ∀ i : I, CommRingCat.of (A i) ⟶ P.presheaf.obj (Opposite.op (U i)) :=
      fun i => (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (A i))).inv ≫
        (e i).inv.appTop ≫ (U i).topIso.hom
    have hθ_inv_hom : ∀ i : I, θ_inv i ≫ θ_hom i = 𝟙 _ := by
      intro i
      dsimp only [θ_hom, θ_inv]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (U i).topIso.hom, (U i).topIso.hom_inv_id,
        CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc (e i).inv.appTop,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop, (e i).hom_inv_id,
        AlgebraicGeometry.Scheme.Hom.id_appTop, CategoryTheory.Category.id_comp,
        CategoryTheory.Iso.inv_hom_id]
    have hθ_hom_inv : ∀ i : I, θ_hom i ≫ θ_inv i = 𝟙 _ := by
      intro i
      dsimp only [θ_hom, θ_inv]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Scheme.ΓSpecIso _).hom,
        CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc (e i).hom.appTop,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop, (e i).inv_hom_id,
        AlgebraicGeometry.Scheme.Hom.id_appTop, CategoryTheory.Category.id_comp,
        (U i).topIso.inv_hom_id]
    let ρ : ∀ i : I, P.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of (A i) :=
      fun i => (κ i).appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (A i))).hom
    have hρ_fac : ∀ i : I,
        ρ i = P.presheaf.map (CategoryTheory.homOfLE (le_top : U i ≤ ⊤)).op ≫ θ_hom i := by
      intro i
      have hι : (U i).ι.appTop ≫ (U i).topIso.hom =
          P.presheaf.map (CategoryTheory.homOfLE (le_top : U i ≤ ⊤)).op := by
        rw [AlgebraicGeometry.Scheme.Opens.ι_appTop, AlgebraicGeometry.Scheme.Opens.topIso_hom]
        erw [← CategoryTheory.Functor.map_comp]
        congr 1
      have hκ : κ i = (e i).hom ≫ (U i).ι :=
        (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι (κ i)).symm
      dsimp only [ρ, θ_hom]
      rw [← hι, CategoryTheory.Category.assoc, (U i).topIso.hom_inv_id_assoc,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop_assoc, ← hκ]
    have hRing : ∀ f : (∀ i : I, A i),
        ∃! s : ↑(P.presheaf.obj (Opposite.op ⊤)), (∀ i : I, (ρ i).hom s = f i) := by
      intro f
      let sf : ∀ i : I, ↑(P.presheaf.obj (Opposite.op (U i))) := fun i => (θ_inv i).hom (f i)
      have hCompat : TopCat.Presheaf.IsCompatible P.presheaf U sf := by
        intro i j
        by_cases hij : i = j
        · subst hij; rfl
        · have : Subsingleton ↑(P.presheaf.obj (Opposite.op (U i ⊓ U j))) := by
            rw [hBot hij]; infer_instance
          exact Subsingleton.elim _ _
      obtain ⟨s_sup, hs_glue, _⟩ := TopCat.Sheaf.existsUnique_gluing P.sheaf U sf hCompat
      let s : ↑(P.presheaf.obj (Opposite.op ⊤)) :=
        (P.presheaf.map (CategoryTheory.eqToHom hSup.symm).op).hom s_sup
      have hs_res : ∀ i : I,
          (P.presheaf.map (CategoryTheory.homOfLE (le_top : U i ≤ ⊤)).op).hom s = sf i := by
        intro i
        dsimp only [s]
        change (P.presheaf.map (CategoryTheory.eqToHom hSup.symm).op ≫
          P.presheaf.map (CategoryTheory.homOfLE (le_top : U i ≤ ⊤)).op).hom s_sup = sf i
        rw [← P.presheaf.map_comp, ← CategoryTheory.op_comp]
        have hle : CategoryTheory.homOfLE (le_top : U i ≤ ⊤) ≫ CategoryTheory.eqToHom hSup.symm =
            TopologicalSpace.Opens.leSupr U i := Subsingleton.elim _ _
        rw [hle]
        exact hs_glue i
      refine ⟨s, ?_, ?_⟩
      · intro i
        rw [hρ_fac i]
        change (θ_hom i).hom ((P.presheaf.map (CategoryTheory.homOfLE (le_top : U i ≤ ⊤)).op).hom s) = f i
        rw [hs_res i]
        exact congrArg (fun φ : CommRingCat.of (A i) ⟶ CommRingCat.of (A i) => φ.hom (f i))
          (hθ_inv_hom i)
      · intro s' hs'
        apply TopCat.Sheaf.eq_of_locally_eq' P.sheaf U ⊤
          (fun i => CategoryTheory.homOfLE (le_top : U i ≤ ⊤)) (by rw [hSup])
        intro i
        change (P.presheaf.map (CategoryTheory.homOfLE (le_top : U i ≤ ⊤)).op).hom s' =
          (P.presheaf.map (CategoryTheory.homOfLE (le_top : U i ≤ ⊤)).op).hom s
        rw [hs_res i]
        have h1 : (θ_inv i).hom ((ρ i).hom s') = sf i := by
          rw [hs' i]
        rw [hρ_fac i] at h1
        have h2 := congrArg
          (fun φ : P.presheaf.obj (Opposite.op (U i)) ⟶ P.presheaf.obj (Opposite.op (U i)) =>
            φ.hom ((P.presheaf.map (CategoryTheory.homOfLE (le_top : U i ≤ ⊤)).op).hom s'))
          (hθ_hom_inv i)
        exact h2.symm.trans h1
    intro g
    obtain ⟨s, hs, hs_uniq⟩ := hRing (fun i => (g i).val)
    obtain ⟨t, ht, _⟩ := hRing (fun i => (g i).inv)
    obtain ⟨_, _, h1_uniq⟩ := hRing (fun _ => 1)
    have hst : s * t = 1 := by
      have h_st : ∀ i : I, (ρ i).hom (s * t) = 1 := by
        intro i
        rw [map_mul, hs i, ht i, Units.val_inv]
      have h_one : ∀ i : I, (ρ i).hom 1 = 1 := fun i => map_one _
      exact (h1_uniq (s * t) h_st).trans (h1_uniq 1 h_one).symm
    have hts : t * s = 1 := (mul_comm t s).trans hst
    refine ⟨⟨s, t, hst, hts⟩, ?_, ?_⟩
    · intro i
      exact Units.ext (hs i)
    · intro u' hu'
      apply Units.ext
      exact hs_uniq u'.val (fun i => congrArg Units.val (hu' i))

  have open_chart_of_isPullback : ∀ {Q X₁ X₂ Z₀ U₁ U₂ S : AlgebraicGeometry.Scheme.{u}}
      {p₁ : Q ⟶ X₁} {p₂ : Q ⟶ X₂} {h₁ : X₁ ⟶ Z₀} {h₂ : X₂ ⟶ Z₀}
      (hQ : CategoryTheory.IsPullback p₁ p₂ h₁ h₂)
      (α : U₁ ⟶ X₁) [AlgebraicGeometry.IsOpenImmersion α]
      (β : U₂ ⟶ X₂) [AlgebraicGeometry.IsOpenImmersion β]
      {f_L : S ⟶ U₁} {f_R : S ⟶ U₂}
      (hS : CategoryTheory.IsPullback f_L f_R (α ≫ h₁) (β ≫ h₂)),
      let κ : S ⟶ Q := hQ.lift (f_L ≫ α) (f_R ≫ β)
        (by rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hS.w])
      κ ≫ p₁ = f_L ≫ α ∧
      κ ≫ p₂ = f_R ≫ β ∧
      AlgebraicGeometry.IsOpenImmersion κ ∧
      Set.range κ.base = p₁.base ⁻¹' (Set.range α.base) ∩ p₂.base ⁻¹' (Set.range β.base) := by
    intro Q X₁ X₂ Z₀ U₁ U₂ S p₁ p₂ h₁ h₂ hQ α _ β _ f_L f_R hS κ
    refine ⟨hQ.lift_fst _ _ _, hQ.lift_snd _ _ _, ?_⟩
    let O : Q.Opens :=
      (TopologicalSpace.Opens.map p₁.base).obj α.opensRange ⊓
      (TopologicalSpace.Opens.map p₂.base).obj β.opensRange
    have hO₁ : Set.range (O.ι ≫ p₁).base ⊆ Set.range α.base := by
      rintro _ ⟨x, rfl⟩
      exact x.2.1
    have hO₂ : Set.range (O.ι ≫ p₂).base ⊆ Set.range β.base := by
      rintro _ ⟨x, rfl⟩
      exact x.2.2
    let u_α : O.toScheme ⟶ U₁ := AlgebraicGeometry.IsOpenImmersion.lift α (O.ι ≫ p₁) hO₁
    let u_β : O.toScheme ⟶ U₂ := AlgebraicGeometry.IsOpenImmersion.lift β (O.ι ≫ p₂) hO₂
    have hu_α : u_α ≫ α = O.ι ≫ p₁ := AlgebraicGeometry.IsOpenImmersion.lift_fac α (O.ι ≫ p₁) hO₁
    have hu_β : u_β ≫ β = O.ι ≫ p₂ := AlgebraicGeometry.IsOpenImmersion.lift_fac β (O.ι ≫ p₂) hO₂
    have hO_comm : u_α ≫ α ≫ h₁ = u_β ≫ β ≫ h₂ := by
      rw [← CategoryTheory.Category.assoc, hu_α, CategoryTheory.Category.assoc, hQ.w,
        ← CategoryTheory.Category.assoc, ← hu_β, CategoryTheory.Category.assoc]
    have hc_comm : ∀ c : CategoryTheory.Limits.PullbackCone (α ≫ h₁) (β ≫ h₂),
        (c.fst ≫ α) ≫ h₁ = (c.snd ≫ β) ≫ h₂ := fun c => by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, c.condition]
    let l_Q : ∀ c : CategoryTheory.Limits.PullbackCone (α ≫ h₁) (β ≫ h₂), c.pt ⟶ Q :=
      fun c => hQ.lift (c.fst ≫ α) (c.snd ≫ β) (hc_comm c)
    have hl_O : ∀ c : CategoryTheory.Limits.PullbackCone (α ≫ h₁) (β ≫ h₂),
        Set.range (l_Q c).base ⊆ Set.range O.ι.base := by
      intro c
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨y, rfl⟩
      refine ⟨?_, ?_⟩
      · change (l_Q c ≫ p₁).base y ∈ Set.range α.base
        rw [hQ.lift_fst]
        exact ⟨c.fst.base y, rfl⟩
      · change (l_Q c ≫ p₂).base y ∈ Set.range β.base
        rw [hQ.lift_snd]
        exact ⟨c.snd.base y, rfl⟩
    let l_O : ∀ c : CategoryTheory.Limits.PullbackCone (α ≫ h₁) (β ≫ h₂), c.pt ⟶ O.toScheme :=
      fun c => AlgebraicGeometry.IsOpenImmersion.lift O.ι (l_Q c) (hl_O c)
    have hl_O_fac : ∀ c, l_O c ≫ O.ι = l_Q c :=
      fun c => AlgebraicGeometry.IsOpenImmersion.lift_fac O.ι (l_Q c) (hl_O c)
    have hO_pb : CategoryTheory.IsPullback u_α u_β (α ≫ h₁) (β ≫ h₂) := by
      refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hO_comm l_O
          (fun c => ?_) (fun c => ?_) (fun c m hm₁ hm₂ => ?_))
      · apply (CategoryTheory.cancel_mono α).mp
        rw [CategoryTheory.Category.assoc, hu_α, ← CategoryTheory.Category.assoc, hl_O_fac c,
          hQ.lift_fst]
      · apply (CategoryTheory.cancel_mono β).mp
        rw [CategoryTheory.Category.assoc, hu_β, ← CategoryTheory.Category.assoc, hl_O_fac c,
          hQ.lift_snd]
      · apply (CategoryTheory.cancel_mono O.ι).mp
        rw [hl_O_fac c]
        apply hQ.hom_ext
        · rw [CategoryTheory.Category.assoc, ← hu_α, ← CategoryTheory.Category.assoc, hm₁,
            hQ.lift_fst]
        · rw [CategoryTheory.Category.assoc, ← hu_β, ← CategoryTheory.Category.assoc, hm₂,
            hQ.lift_snd]
    let e_iso : S ≅ O.toScheme := CategoryTheory.IsPullback.isoIsPullback U₁ U₂ hS hO_pb
    have hκ_eq : κ = e_iso.hom ≫ O.ι := by
      apply hQ.hom_ext
      · rw [hQ.lift_fst, CategoryTheory.Category.assoc, ← hu_α, ← CategoryTheory.Category.assoc,
          CategoryTheory.IsPullback.isoIsPullback_hom_fst]
      · rw [hQ.lift_snd, CategoryTheory.Category.assoc, ← hu_β, ← CategoryTheory.Category.assoc,
          CategoryTheory.IsPullback.isoIsPullback_hom_snd]
    refine ⟨by rw [hκ_eq]; infer_instance, ?_⟩
    rw [hκ_eq]
    have hsurj : Function.Surjective e_iso.hom.base := by
      intro y
      exact ⟨e_iso.inv.base y, congrArg (fun f : O.toScheme ⟶ O.toScheme => f.base y) e_iso.inv_hom_id⟩
    ext x
    simp only [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Set.mem_range,
      Function.comp_apply]
    constructor
    · rintro ⟨s, rfl⟩
      exact (e_iso.hom.base s).2
    · intro hx
      obtain ⟨s, hs⟩ := hsurj ⟨x, hx⟩
      exact ⟨s, congrArg Subtype.val hs⟩

  have mono_postcomp_pb : ∀ {S U₁ U₂ Y Z₀ : AlgebraicGeometry.Scheme.{u}}
      {f_L : S ⟶ U₁} {f_R : S ⟶ U₂} {g₁ : U₁ ⟶ Y} {g₂ : U₂ ⟶ Y}
      (hP : CategoryTheory.IsPullback f_L f_R g₁ g₂)
      (j : Y ⟶ Z₀) [CategoryTheory.Mono j],
      CategoryTheory.IsPullback f_L f_R (g₁ ≫ j) (g₂ ≫ j) := by
    intro S U₁ U₂ Y Z₀ f_L f_R g₁ g₂ hP j _
    have hw : f_L ≫ g₁ ≫ j = f_R ≫ g₂ ≫ j := by
      rw [← CategoryTheory.Category.assoc, hP.w, CategoryTheory.Category.assoc]
    have hl_comm : ∀ c : CategoryTheory.Limits.PullbackCone (g₁ ≫ j) (g₂ ≫ j),
        c.fst ≫ g₁ = c.snd ≫ g₂ := fun c =>
      (CategoryTheory.cancel_mono j).mp
        (by rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]; exact c.condition)
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hw
        (fun c => hP.lift c.fst c.snd (hl_comm c))
        (fun c => hP.lift_fst _ _ _)
        (fun c => hP.lift_snd _ _ _)
        (fun c m hm₁ hm₂ => hP.hom_ext
          (hm₁.trans (hP.lift_fst _ _ _).symm)
          (hm₂.trans (hP.lift_snd _ _ _).symm)))

  have iso_precomp_pb : ∀ {S' S U₁ U₂ Z₀ : AlgebraicGeometry.Scheme.{u}}
      (e : S' ≅ S) {f_L : S ⟶ U₁} {f_R : S ⟶ U₂} {g₁ : U₁ ⟶ Z₀} {g₂ : U₂ ⟶ Z₀}
      (hP : CategoryTheory.IsPullback f_L f_R g₁ g₂)
      {f'_L : S' ⟶ U₁} {f'_R : S' ⟶ U₂},
      e.hom ≫ f_L = f'_L →
      e.hom ≫ f_R = f'_R →
      CategoryTheory.IsPullback f'_L f'_R g₁ g₂ := by
    intro S' S U₁ U₂ Z₀ e f_L f_R g₁ g₂ hP f'_L f'_R hL hR
    subst hL; subst hR
    have hw : (e.hom ≫ f_L) ≫ g₁ = (e.hom ≫ f_R) ≫ g₂ := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hP.w]
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hw
        (fun c => hP.lift c.fst c.snd c.condition ≫ e.inv)
        (fun c => by rw [CategoryTheory.Category.assoc, e.inv_hom_id_assoc, hP.lift_fst])
        (fun c => by rw [CategoryTheory.Category.assoc, e.inv_hom_id_assoc, hP.lift_snd])
        (fun c m hm₁ hm₂ => ?_))
    apply (CategoryTheory.cancel_mono e.hom).mp
    rw [CategoryTheory.Category.assoc, e.inv_hom_id, CategoryTheory.Category.comp_id]
    exact hP.hom_ext
      ((CategoryTheory.Category.assoc m e.hom f_L).symm.trans (hm₁.trans (hP.lift_fst _ _ _).symm))
      ((CategoryTheory.Category.assoc m e.hom f_R).symm.trans (hm₂.trans (hP.lift_snd _ _ _).symm))

  have cross_chart_pb : ∀ {R_a R_b R_ov : Type u} [CommRing R_a] [CommRing R_b] [CommRing R_ov]
      [Algebra R_a R_ov] [Algebra R_b R_ov]
      {Z₀ : AlgebraicGeometry.Scheme.{u}}
      {j_a : AlgebraicGeometry.Spec (CommRingCat.of R_a) ⟶ Z₀}
      {j_b : AlgebraicGeometry.Spec (CommRingCat.of R_b) ⟶ Z₀}
      (hPb_ab : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_a R_ov)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_b R_ov)))
        j_a j_b)
      (M_a M_b : Type u) [CommRing M_a] [CommRing M_b] [Algebra R_a M_a] [Algebra R_b M_b],
      let U_a := TensorProduct R_a R_ov M_a
      let U_b := TensorProduct R_b R_ov M_b
      letI : CommRing U_a := inferInstance
      letI : Algebra R_ov U_a := inferInstance
      letI : CommRing U_b := inferInstance
      letI : Algebra R_ov U_b := inferInstance
      let A_ab := TensorProduct R_ov U_a U_b
      letI : CommRing A_ab := inferInstance
      CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((Algebra.TensorProduct.includeLeftRingHom (R := R_ov) (A := U_a) (B := U_b)).comp
            (Algebra.TensorProduct.includeRight (R := R_a) (A := R_ov) (B := M_a)).toRingHom)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((Algebra.TensorProduct.includeRight (R := R_ov) (A := U_a) (B := U_b)).toRingHom.comp
            (Algebra.TensorProduct.includeRight (R := R_b) (A := R_ov) (B := M_b)).toRingHom)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_a M_a)) ≫ j_a)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_b M_b)) ≫ j_b) := by
    intro R_a R_b R_ov _ _ _ _ _ Z₀ j_a j_b hPb_ab M_a M_b _ _ _ _
    dsimp only
    let U_a := TensorProduct R_a R_ov M_a
    let U_b := TensorProduct R_b R_ov M_b
    letI : CommRing U_a := inferInstance
    letI : Algebra R_ov U_a := inferInstance
    letI : CommRing U_b := inferInstance
    letI : Algebra R_ov U_b := inferInstance
    let A_ab := TensorProduct R_ov U_a U_b
    letI : CommRing A_ab := inferInstance
    have : AlgebraicGeometry.Scheme.Spec.IsRightAdjoint :=
      AlgebraicGeometry.ΓSpec.adjunction.isRightAdjoint
    have tp_a : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := R_a) (A := R_ov) (B := M_a))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := R_a) (A := R_ov) (B := M_a)).toRingHom))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_a R_ov)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_a M_a))) :=
      CategoryTheory.Functor.map_isPullback AlgebraicGeometry.Scheme.Spec
        (CommRingCat.isPushout_tensorProduct R_a R_ov M_a).op.flip
    have tp_b : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := R_b) (A := R_ov) (B := M_b))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := R_b) (A := R_ov) (B := M_b)).toRingHom))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_b R_ov)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_b M_b))) :=
      CategoryTheory.Functor.map_isPullback AlgebraicGeometry.Scheme.Spec
        (CommRingCat.isPushout_tensorProduct R_b R_ov M_b).op.flip
    have tp_ab : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := R_ov) (A := U_a) (B := U_b))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := R_ov) (A := U_a) (B := U_b)).toRingHom))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ov U_a)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ov U_b))) :=
      CategoryTheory.Functor.map_isPullback AlgebraicGeometry.Scheme.Spec
        (CommRingCat.isPushout_tensorProduct R_ov U_a U_b).op.flip
    have halg_a : algebraMap R_ov U_a =
        Algebra.TensorProduct.includeLeftRingHom (R := R_a) (A := R_ov) (B := M_a) := rfl
    have halg_b : algebraMap R_ov U_b =
        Algebra.TensorProduct.includeLeftRingHom (R := R_b) (A := R_ov) (B := M_b) := rfl
    let ι_L : M_a →+* A_ab :=
      (Algebra.TensorProduct.includeLeftRingHom (R := R_ov) (A := U_a) (B := U_b)).comp
        (Algebra.TensorProduct.includeRight (R := R_a) (A := R_ov) (B := M_a)).toRingHom
    let ι_R : M_b →+* A_ab :=
      (Algebra.TensorProduct.includeRight (R := R_ov) (A := U_a) (B := U_b)).toRingHom.comp
        (Algebra.TensorProduct.includeRight (R := R_b) (A := R_ov) (B := M_b)).toRingHom
    have hSpec_L : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := R_ov) (A := U_a) (B := U_b))) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := R_a) (A := R_ov) (B := M_a)).toRingHom) := by
      dsimp only [ι_L]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hSpec_R : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := R_ov) (A := U_a) (B := U_b)).toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := R_b) (A := R_ov) (B := M_b)).toRingHom) := by
      dsimp only [ι_R]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hw : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_a M_a)) ≫ j_a =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_b M_b)) ≫ j_b := by
      calc
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_a M_a)) ≫ j_a
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Algebra.TensorProduct.includeLeftRingHom (R := R_ov) (A := U_a) (B := U_b))) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Algebra.TensorProduct.includeRight (R := R_a) (A := R_ov) (B := M_a)).toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_a M_a))) ≫ j_a := by
              rw [hSpec_L]; simp only [CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Algebra.TensorProduct.includeLeftRingHom (R := R_ov) (A := U_a) (B := U_b))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ov U_a))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_a R_ov)) ≫ j_a := by
              rw [← tp_a.w, ← halg_a]; simp only [CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Algebra.TensorProduct.includeRight (R := R_ov) (A := U_a) (B := U_b)).toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ov U_b))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_b R_ov)) ≫ j_b := by
              rw [tp_ab.w, hPb_ab.w]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Algebra.TensorProduct.includeRight (R := R_ov) (A := U_a) (B := U_b)).toRingHom) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Algebra.TensorProduct.includeRight (R := R_b) (A := R_ov) (B := M_b)).toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_b M_b))) ≫ j_b := by
              rw [← tp_b.w, ← halg_b]; simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_b M_b)) ≫ j_b := by
              rw [hSpec_R]; simp only [CategoryTheory.Category.assoc]
    let g_a := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_a M_a)) ≫ j_a
    let g_b := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_b M_b)) ≫ j_b
    let l₀ : ∀ c : CategoryTheory.Limits.PullbackCone g_a g_b,
        c.pt ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_ov) :=
      fun c => hPb_ab.lift
        (c.fst ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_a M_a)))
        (c.snd ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_b M_b)))
        (by simpa only [g_a, g_b, CategoryTheory.Category.assoc] using c.condition)
    let l_a : ∀ c : CategoryTheory.Limits.PullbackCone g_a g_b,
        c.pt ⟶ AlgebraicGeometry.Spec (CommRingCat.of U_a) :=
      fun c => tp_a.lift (l₀ c) c.fst (hPb_ab.lift_fst _ _ _)
    let l_b : ∀ c : CategoryTheory.Limits.PullbackCone g_a g_b,
        c.pt ⟶ AlgebraicGeometry.Spec (CommRingCat.of U_b) :=
      fun c => tp_b.lift (l₀ c) c.snd (hPb_ab.lift_snd _ _ _)
    let l_ab : ∀ c : CategoryTheory.Limits.PullbackCone g_a g_b,
        c.pt ⟶ AlgebraicGeometry.Spec (CommRingCat.of A_ab) :=
      fun c => tp_ab.lift (l_a c) (l_b c)
        (by
          rw [halg_a, halg_b]
          exact (tp_a.lift_fst _ _ _).trans (tp_b.lift_fst _ _ _).symm)
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hw l_ab
        (fun c => ?_) (fun c => ?_) (fun c m hm₁ hm₂ => ?_))
    · exact (congrArg (l_ab c ≫ ·) hSpec_L).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ _) (tp_ab.lift_fst _ _ _)).trans (tp_a.lift_snd _ _ _)))
    · exact (congrArg (l_ab c ≫ ·) hSpec_R).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ _) (tp_ab.lift_snd _ _ _)).trans (tp_b.lift_snd _ _ _)))
    · have hm_L : (m ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.includeLeftRingHom (R := R_ov) (A := U_a) (B := U_b)))) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.includeRight (R := R_a) (A := R_ov) (B := M_a)).toRingHom) = c.fst :=
        (CategoryTheory.Category.assoc m _ _).trans
          ((congrArg (m ≫ ·) hSpec_L.symm).trans hm₁)
      have hm_R : (m ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.includeRight (R := R_ov) (A := U_a) (B := U_b)).toRingHom)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.includeRight (R := R_b) (A := R_ov) (B := M_b)).toRingHom) = c.snd :=
        (CategoryTheory.Category.assoc m _ _).trans
          ((congrArg (m ≫ ·) hSpec_R.symm).trans hm₂)
      have hm_ov : (m ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.includeLeftRingHom (R := R_ov) (A := U_a) (B := U_b)))) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ov U_a)) = l₀ c := by
        apply hPb_ab.hom_ext
        · rw [hPb_ab.lift_fst, CategoryTheory.Category.assoc, halg_a, tp_a.w,
            ← CategoryTheory.Category.assoc (m ≫ _), hm_L]
        · rw [hPb_ab.lift_snd, CategoryTheory.Category.assoc m, tp_ab.w,
            ← CategoryTheory.Category.assoc m, CategoryTheory.Category.assoc (m ≫ _),
            halg_b, tp_b.w, ← CategoryTheory.Category.assoc (m ≫ _), hm_R]
      apply tp_ab.hom_ext
      · rw [tp_ab.lift_fst]
        apply tp_a.hom_ext
        · rw [tp_a.lift_fst, ← halg_a]
          exact hm_ov
        · rw [tp_a.lift_snd]
          exact hm_L
      · rw [tp_ab.lift_snd]
        apply tp_b.hom_ext
        · rw [tp_b.lift_fst, ← halg_b, CategoryTheory.Category.assoc m, ← tp_ab.w,
            ← CategoryTheory.Category.assoc m]
          exact hm_ov
        · rw [tp_b.lift_snd]
          exact hm_R

  have ov_same_pb : ∀ {R_c R_ov : Type u} [CommRing R_c] [CommRing R_ov] [Algebra R_c R_ov]
      {Z₀ : AlgebraicGeometry.Scheme.{u}}
      (j_c : AlgebraicGeometry.Spec (CommRingCat.of R_c) ⟶ Z₀) [CategoryTheory.Mono j_c]
      (M T_c : Type u) [CommRing M] [CommRing T_c] [Algebra R_ov M] [Algebra R_c T_c],
      let U_c := TensorProduct R_c R_ov T_c
      letI : CommRing U_c := inferInstance
      letI : Algebra R_ov U_c := inferInstance
      let B_ov := TensorProduct R_ov M U_c
      letI : CommRing B_ov := inferInstance
      CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := R_ov) (A := M) (B := U_c))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((Algebra.TensorProduct.includeRight (R := R_ov) (A := M) (B := U_c)).toRingHom.comp
            (Algebra.TensorProduct.includeRight (R := R_c) (A := R_ov) (B := T_c)).toRingHom)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ov M)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_c R_ov)) ≫ j_c)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_c T_c)) ≫ j_c) := by
    intro R_c R_ov _ _ _ Z₀ j_c _ M T_c _ _ _ _
    dsimp only
    let U_c := TensorProduct R_c R_ov T_c
    letI : CommRing U_c := inferInstance
    letI : Algebra R_ov U_c := inferInstance
    let B_ov := TensorProduct R_ov M U_c
    letI : CommRing B_ov := inferInstance
    have : AlgebraicGeometry.Scheme.Spec.IsRightAdjoint :=
      AlgebraicGeometry.ΓSpec.adjunction.isRightAdjoint
    have tp_c : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := R_c) (A := R_ov) (B := T_c))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := R_c) (A := R_ov) (B := T_c)).toRingHom))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_c R_ov)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_c T_c))) :=
      CategoryTheory.Functor.map_isPullback AlgebraicGeometry.Scheme.Spec
        (CommRingCat.isPushout_tensorProduct R_c R_ov T_c).op.flip
    have tp_M : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := R_ov) (A := M) (B := U_c))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := R_ov) (A := M) (B := U_c)).toRingHom))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ov M)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ov U_c))) :=
      CategoryTheory.Functor.map_isPullback AlgebraicGeometry.Scheme.Spec
        (CommRingCat.isPushout_tensorProduct R_ov M U_c).op.flip
    have halg_c : algebraMap R_ov U_c =
        Algebra.TensorProduct.includeLeftRingHom (R := R_c) (A := R_ov) (B := T_c) := rfl
    let ι_R : T_c →+* B_ov :=
      (Algebra.TensorProduct.includeRight (R := R_ov) (A := M) (B := U_c)).toRingHom.comp
        (Algebra.TensorProduct.includeRight (R := R_c) (A := R_ov) (B := T_c)).toRingHom
    have hSpec_R : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := R_ov) (A := M) (B := U_c)).toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := R_c) (A := R_ov) (B := T_c)).toRingHom) := by
      dsimp only [ι_R]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hw : AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := R_ov) (A := M) (B := U_c))) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ov M)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_c R_ov)) ≫ j_c =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_c T_c)) ≫ j_c := by
      rw [hSpec_R, ← CategoryTheory.Category.assoc _ _ (AlgebraicGeometry.Spec.map _ ≫ j_c),
        tp_M.w, halg_c, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc _ _ j_c, tp_c.w,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
    let g₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ov M)) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_c R_ov)) ≫ j_c
    let g₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_c T_c)) ≫ j_c
    have hc_cancel : ∀ c : CategoryTheory.Limits.PullbackCone g₁ g₂,
        (c.fst ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ov M))) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_c R_ov)) =
        c.snd ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_c T_c)) :=
      fun c => (CategoryTheory.cancel_mono j_c).mp
        (by simpa only [g₁, g₂, CategoryTheory.Category.assoc] using c.condition)
    let l_c : ∀ c : CategoryTheory.Limits.PullbackCone g₁ g₂,
        c.pt ⟶ AlgebraicGeometry.Spec (CommRingCat.of U_c) :=
      fun c => tp_c.lift
        (c.fst ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ov M)))
        c.snd (hc_cancel c)
    let l_B : ∀ c : CategoryTheory.Limits.PullbackCone g₁ g₂,
        c.pt ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_ov) :=
      fun c => tp_M.lift c.fst (l_c c)
        (by rw [halg_c]; exact (tp_c.lift_fst _ _ _).symm)
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hw l_B
        (fun c => tp_M.lift_fst _ _ _)
        (fun c => (congrArg (l_B c ≫ ·) hSpec_R).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ _) (tp_M.lift_snd _ _ _)).trans (tp_c.lift_snd _ _ _))))
        (fun c m hm₁ hm₂ => ?_))
    have hm_R : (m ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := R_ov) (A := M) (B := U_c)).toRingHom)) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := R_c) (A := R_ov) (B := T_c)).toRingHom) = c.snd :=
      (CategoryTheory.Category.assoc m _ _).trans
        ((congrArg (m ≫ ·) hSpec_R.symm).trans hm₂)
    apply tp_M.hom_ext
    · rw [tp_M.lift_fst]; exact hm₁
    · rw [tp_M.lift_snd]
      apply tp_c.hom_ext
      · rw [tp_c.lift_fst, ← halg_c, CategoryTheory.Category.assoc m, ← tp_M.w]
        exact (CategoryTheory.Category.assoc m _ _).symm.trans
          (congrArg (· ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ov M))) hm₁)
      · rw [tp_c.lift_snd]
        exact hm_R

  have eval_spec_pull : ∀ {P Q : AlgebraicGeometry.Scheme.{u}} {A C : Type u}
      [CommRing A] [CommRing C]
      (μ : AlgebraicGeometry.Spec (CommRingCat.of C) ⟶ P)
      (δ : P ⟶ Q)
      (κ : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Q)
      (φ : A →+* C),
      μ ≫ δ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ κ →
      ∀ u : Units ↑(Q.presheaf.obj (Opposite.op ⊤)),
        Units.map (μ.appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of C)).hom).hom.toMonoidHom
          (Units.map δ.appTop.hom.toMonoidHom u) =
        Units.map φ.toMonoidHom
          (Units.map (κ.appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).hom).hom.toMonoidHom u) := by
    intro P Q A C _ _ μ δ κ φ hsq u
    have happ : δ.appTop ≫ (μ.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of C)).hom) =
        (κ.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).hom) ≫
          CommRingCat.ofHom φ := by
      have h₁ : δ.appTop ≫ μ.appTop =
          κ.appTop ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).appTop := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hsq,
          AlgebraicGeometry.Scheme.Hom.comp_appTop]
      rw [← CategoryTheory.Category.assoc, h₁, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom φ),
        ← CategoryTheory.Category.assoc]
    apply Units.ext
    exact congrArg (fun ρ => ρ.hom u.val) happ

  have eval_unit_via_pb : ∀ {P₃ P₂ W_sch Z₀ : AlgebraicGeometry.Scheme.{u}}
      {π₀ π₁ : P₂ ⟶ W_sch} {g : W_sch ⟶ Z₀}
      (hPb₂ : CategoryTheory.IsPullback π₀ π₁ g g)
      {S_L S_R A C : Type u} [CommRing S_L] [CommRing S_R] [CommRing A] [CommRing C]
      {in_L : AlgebraicGeometry.Spec (CommRingCat.of S_L) ⟶ W_sch}
      {in_R : AlgebraicGeometry.Spec (CommRingCat.of S_R) ⟶ W_sch}
      {ι_L : S_L →+* A} {ι_R : S_R →+* A}
      {κ : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ P₂},
      κ ≫ π₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L) ≫ in_L →
      κ ≫ π₁ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫ in_R →
      ∀ (μ : AlgebraicGeometry.Spec (CommRingCat.of C) ⟶ P₃)
        (δ : P₃ ⟶ P₂)
        {α_L : S_L →+* C} {α_R : S_R →+* C} (φ : A →+* C),
        μ ≫ (δ ≫ π₀) = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_L) ≫ in_L →
        μ ≫ (δ ≫ π₁) = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_R) ≫ in_R →
        φ.comp ι_L = α_L →
        φ.comp ι_R = α_R →
        ∀ u : Units ↑(P₂.presheaf.obj (Opposite.op ⊤)),
          Units.map (μ.appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of C)).hom).hom.toMonoidHom
            (Units.map δ.appTop.hom.toMonoidHom u) =
          Units.map φ.toMonoidHom
            (Units.map (κ.appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).hom).hom.toMonoidHom u) := by
    intro P₃ P₂ W_sch Z₀ π₀ π₁ g hPb₂ S_L S_R A C _ _ _ _ in_L in_R ι_L ι_R κ hκ₀ hκ₁
      μ δ α_L α_R φ hm₀ hm₁ hφ_L hφ_R u
    have hsq : μ ≫ δ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ κ := by
      apply hPb₂.hom_ext
      · rw [CategoryTheory.Category.assoc, hm₀, CategoryTheory.Category.assoc, hκ₀,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hφ_L]
      · rw [CategoryTheory.Category.assoc, hm₁, CategoryTheory.Category.assoc, hκ₁,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hφ_R]
    exact eval_spec_pull μ δ κ φ hsq u

  have inl_eqToHom : ∀ (X₀ X₁ : AlgebraicGeometry.Scheme.{u}),
      (CategoryTheory.Limits.coprod.inl : X₀ ⟶ CategoryTheory.Limits.coprod X₀ X₁) ≫
        CategoryTheory.eqToHom rfl = CategoryTheory.Limits.coprod.inl := by
    intro X₀ X₁
    rw [CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id]

  have inr_eqToHom : ∀ (X₀ X₁ : AlgebraicGeometry.Scheme.{u}),
      (CategoryTheory.Limits.coprod.inr : X₁ ⟶ CategoryTheory.Limits.coprod X₀ X₁) ≫
        CategoryTheory.eqToHom rfl = CategoryTheory.Limits.coprod.inr := by
    intro X₀ X₁
    rw [CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id]

  have units_cob_iff : ∀ {S : Type u} [CommRing S] (u₂₃ u₁₃ u₁₂ : Units S),
      u₂₃ * u₁₃⁻¹ * u₁₂ = 1 ↔ (u₁₃ : S) = (u₁₂ : S) * (u₂₃ : S) := by
    intro S _ u₂₃ u₁₃ u₁₂
    constructor
    · intro h
      have hval : (u₂₃ : S) * ((u₁₃⁻¹ : Units S) : S) * (u₁₂ : S) = 1 := congrArg Units.val h
      have hinv : ((u₁₃⁻¹ : Units S) : S) * (u₁₃ : S) = 1 := Units.inv_mul u₁₃
      calc
        (u₁₃ : S) = 1 * (u₁₃ : S) := (one_mul _).symm
        _ = ((u₂₃ : S) * ((u₁₃⁻¹ : Units S) : S) * (u₁₂ : S)) * (u₁₃ : S) := by rw [hval]
        _ = (u₁₂ : S) * (u₂₃ : S) * (((u₁₃⁻¹ : Units S) : S) * (u₁₃ : S)) := by ring
        _ = (u₁₂ : S) * (u₂₃ : S) * 1 := by rw [hinv]
        _ = (u₁₂ : S) * (u₂₃ : S) := mul_one _
    · intro h
      apply Units.ext
      change (u₂₃ : S) * ((u₁₃⁻¹ : Units S) : S) * (u₁₂ : S) = 1
      have hre : (u₂₃ : S) * ((u₁₃⁻¹ : Units S) : S) * (u₁₂ : S) =
          ((u₁₂ : S) * (u₂₃ : S)) * ((u₁₃⁻¹ : Units S) : S) := by ring
      rw [hre, ← h, Units.mul_inv]

  have addHom_sum_apply : ∀ {A_grp B_grp : Type u} [AddCommGroup A_grp] [AddCommGroup B_grp]
      {ι : Type} (s : Finset ι) (f : ι → (A_grp →+ B_grp)) (x : A_grp),
      (∑ i ∈ s, f i) x = ∑ i ∈ s, f i x := by
    intro A_grp B_grp _ _ ι s f x
    classical
    induction s using Finset.induction_on with
    | empty => rfl
    | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, AddMonoidHom.add_apply, ih]

  have eight_iff_five : ∀ (R₀ R₁ R₀₁ S₀ S₁ : Type u)
      [CommRing R₀] [CommRing R₁] [CommRing R₀₁] [CommRing S₀] [CommRing S₁]
      [Algebra R₀ R₀₁] [Algebra R₁ R₀₁] [Algebra R₀ S₀] [Algebra R₁ S₁]
      (g₀₀ : Units (TensorProduct R₀ S₀ S₀))
      (g₀₁ : Units (TensorProduct R₀₁ (TensorProduct R₀ R₀₁ S₀) (TensorProduct R₁ R₀₁ S₁)))
      (g₁₀ : Units (TensorProduct R₀₁ (TensorProduct R₁ R₀₁ S₁) (TensorProduct R₀ R₀₁ S₀)))
      (g₁₁ : Units (TensorProduct R₁ S₁ S₁)),
      let T₀_ov := TensorProduct R₀ R₀₁ S₀
      let T₁_ov := TensorProduct R₁ R₀₁ S₁
      letI : CommRing T₀_ov := inferInstance
      letI : Algebra R₀₁ T₀_ov := inferInstance
      letI : Algebra R₀ T₀_ov := inferInstance
      letI : IsScalarTower R₀ R₀₁ T₀_ov := inferInstance
      letI : CommRing T₁_ov := inferInstance
      letI : Algebra R₀₁ T₁_ov := inferInstance
      letI : Algebra R₁ T₁_ov := inferInstance
      letI : IsScalarTower R₁ R₀₁ T₁_ov := inferInstance
      let A₀₀ := TensorProduct R₀ S₀ S₀
      let A₁₁ := TensorProduct R₁ S₁ S₁
      letI : CommRing A₀₀ := inferInstance
      letI : Algebra R₀ A₀₀ := inferInstance
      letI : CommRing A₁₁ := inferInstance
      letI : Algebra R₁ A₁₁ := inferInstance
      let A₀₀_ov := TensorProduct R₀₁ T₀_ov T₀_ov
      let A₀₁ := TensorProduct R₀₁ T₀_ov T₁_ov
      let A₁₀ := TensorProduct R₀₁ T₁_ov T₀_ov
      let A₁₁_ov := TensorProduct R₀₁ T₁_ov T₁_ov
      letI : CommRing A₀₀_ov := inferInstance
      letI : Algebra R₀₁ A₀₀_ov := inferInstance
      letI : CommRing A₀₁ := inferInstance
      letI : Algebra R₀₁ A₀₁ := inferInstance
      letI : CommRing A₁₀ := inferInstance
      letI : Algebra R₀₁ A₁₀ := inferInstance
      letI : CommRing A₁₁_ov := inferInstance
      letI : Algebra R₀₁ A₁₁_ov := inferInstance
      let B₀₀₀ := TensorProduct R₀ A₀₀ S₀
      let B₁₁₁ := TensorProduct R₁ A₁₁ S₁
      let B₀₀₁ := TensorProduct R₀₁ A₀₀_ov T₁_ov
      let B₀₁₁ := TensorProduct R₀₁ A₀₁ T₁_ov
      let B₀₁₀ := TensorProduct R₀₁ A₀₁ T₀_ov
      let B₁₀₀ := TensorProduct R₀₁ A₁₀ T₀_ov
      let B₁₀₁ := TensorProduct R₀₁ A₁₀ T₁_ov
      let B₁₁₀ := TensorProduct R₀₁ A₁₁_ov T₀_ov
      letI : CommRing B₀₀₀ := inferInstance
      letI : CommRing B₁₁₁ := inferInstance
      letI : CommRing B₀₀₁ := inferInstance
      letI : CommRing B₀₁₁ := inferInstance
      letI : CommRing B₀₁₀ := inferInstance
      letI : CommRing B₁₀₀ := inferInstance
      letI : CommRing B₁₀₁ := inferInstance
      letI : CommRing B₁₁₀ := inferInstance
      let p₀_₁₂ : A₀₀ →ₐ[R₀] B₀₀₀ := Algebra.TensorProduct.includeLeft
      let p₀_₁₃ : A₀₀ →ₐ[R₀] B₀₀₀ :=
