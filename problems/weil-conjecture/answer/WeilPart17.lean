            ((1 : D_B.R₀₁) ⊗ₜ[D_B.R₁] ((1 : D_B.R₁) ⊗ₜ[D.R₁] m₁)) := by
        have hs : (algebraMap (Polynomial B) D_B.R₁ (Polynomial.C β)) ⊗ₜ[D.R₁] m₁ =
            (algebraMap (Polynomial B) D_B.R₁ (Polynomial.C β)) • ((1 : D_B.R₁) ⊗ₜ[D.R₁] m₁) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [hs, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        symm
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [hpull₀, LinearEquiv.map_smul, ← mul_smul, mul_comm, mul_smul, h_one,
        hValid_DB.2.2.2.2.2.2.1 β, ← hpull₁]
    have hw_θ_B : (algebraMap D_B.R₁ D_B.R₀₁ (algebraMap (Polynomial B) D_B.R₁ Polynomial.X)) ^ q •
        M_B.θ ((1 : D_B.R₀₁) ⊗ₜ[D_B.R₀] w₀_B) = (1 : D_B.R₀₁) ⊗ₜ[D_B.R₁] w₁_B := by
      dsimp only [w₀_B, w₁_B]
      rw [TensorProduct.tmul_add, TensorProduct.tmul_sum, map_add, map_sum,
        smul_add, Finset.smul_sum, TensorProduct.tmul_add, TensorProduct.tmul_sum]
      congr 1
      · have h1 := hθ_term 1 w_base₀ w_base₁ hBase_θ
        simpa only [map_one] using h1
      · apply Finset.sum_congr rfl
        intro p' _
        exact hθ_term (u_B p'.1 p'.2) (w_U₀ p'.1 p'.2) (w_U₁ p'.1 p'.2) (hFam p'.1 p'.2).1
    have hw_lam₀_B : π₀_B (lam₀_B w₀_B) = t_bar ^ q := by
      dsimp only [w₀_B]
      rw [map_add, map_sum, map_add, map_sum]
      have h0 : π₀_B (lam₀_B ((1 : D_B.R₀) ⊗ₜ[D.R₀] w_base₀)) = t_bar ^ q := by
        rw [hlam₀_tmul, one_mul]
        change π₀_B (eR₀ ((1 : B) ⊗ₜ[A] lam₀ w_base₀)) = t_bar ^ q
        rw [hπ₀_tmul, map_one, map_one, map_one, one_mul, hBase_lam₀]
      have hsum : (Finset.univ.sum fun p' : Fin D.r × Fin m_U =>
          π₀_B (lam₀_B ((algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (u_B p'.1 p'.2))) ⊗ₜ[D.R₀]
            w_U₀ p'.1 p'.2))) = 0 := by
        apply Finset.sum_eq_zero
        intro p' _
        rw [hlam₀_tmul, map_mul, hψ₀_C, hπ₀_tmul, hu_B p'.1 p'.2, map_zero, map_zero,
          zero_mul, zero_mul]
      rw [h0, hsum, add_zero]
    have hw_lam₁_B : π₁_B (lam₁_B w₁_B) = 1 := by
      dsimp only [w₁_B]
      rw [map_add, map_sum, map_add, map_sum]
      have h0 : π₁_B (lam₁_B ((1 : D_B.R₁) ⊗ₜ[D.R₁] w_base₁)) = 1 := by
        rw [hlam₁_tmul, one_mul]
        change π₁_B (eR₁ ((1 : B) ⊗ₜ[A] lam₁ w_base₁)) = 1
        rw [hπ₁_tmul, map_one, map_one, map_one, one_mul, hBase_lam₁]
      have hsum : (Finset.univ.sum fun p' : Fin D.r × Fin m_U =>
          π₁_B (lam₁_B ((algebraMap (Polynomial B) D_B.R₁ (Polynomial.C (u_B p'.1 p'.2))) ⊗ₜ[D.R₁]
            w_U₁ p'.1 p'.2))) = 0 := by
        apply Finset.sum_eq_zero
        intro p' _
        rw [hlam₁_tmul, map_mul, hψ₁_C, hπ₁_tmul, hu_B p'.1 p'.2, map_zero, map_zero,
          zero_mul, zero_mul]
      rw [h0, hsum, add_zero]
    
    have hBij_q := hLocalBasis B τ_B hB_noeth hB_loc hB_ker D_B red_B hValid_redB
      M_B lam₀_B lam₁_B σ₀_B w₀_B w₁_B hSymm₀_B hSymm₁_B hσ₀_B hw_θ_B hw_lam₀_B hw_lam₁_B
    obtain ⟨v, hv⟩ := hBij_q.2 ((Submodule.span D_B.R₀ {w₀_B}).mkQ ((1 : D_B.R₀) ⊗ₜ[D.R₀] y₀))
    dsimp only at hv
    rw [← map_sum] at hv
    have hsub_mem : ((1 : D_B.R₀) ⊗ₜ[D.R₀] y₀) -
        Finset.univ.sum (fun p : Fin D.r × Fin q =>
          (algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (v p)) *
            (algebraMap (Polynomial B) D_B.R₀ Polynomial.X) ^ p.2.val * D_B.b₀ p.1) • σ₀_B) ∈
        Submodule.span D_B.R₀ {w₀_B} := by
      rw [← Submodule.ker_mkQ (Submodule.span D_B.R₀ {w₀_B}), LinearMap.mem_ker,
        map_sub, hv, sub_self]
    obtain ⟨Q_B, hQ_B⟩ := Submodule.mem_span_singleton.mp hsub_mem
    have hPure : ∀ u : TensorProduct A B D.R₀,
        ∃ (m : ℕ) (β : Fin m → B) (r₀ : Fin m → D.R₀),
          u = Finset.univ.sum fun ν : Fin m => (β ν) ⊗ₜ[A] (r₀ ν) := by
      intro u
      have hPure_or : u = 0 ∨ ∃ (m : ℕ) (β : Fin m → B) (r₀ : Fin m → D.R₀),
          u = Finset.univ.sum fun ν : Fin m => (β ν) ⊗ₜ[A] (r₀ ν) := by
        induction u using TensorProduct.inductionOn with
        | tmul b_el r_el =>
          exact Or.inr ⟨1, fun _ => b_el, fun _ => r_el, by simp⟩
        | add u₁ u₂ ih₁ ih₂ =>
          rcases ih₁ with rfl | ⟨m₁, β₁, r₁, rfl⟩
          · rw [zero_add]; exact ih₂
          · rcases ih₂ with rfl | ⟨m₂, β₂, r₂, rfl⟩
            · rw [add_zero]; exact Or.inr ⟨m₁, β₁, r₁, rfl⟩
            · refine Or.inr ⟨m₁ + m₂, fun ν => Sum.elim β₁ β₂ (finSumFinEquiv.symm ν),
                fun ν => Sum.elim r₁ r₂ (finSumFinEquiv.symm ν), ?_⟩
              symm
              rw [finSumFinEquiv.symm.sum_comp
                (fun x : Fin m₁ ⊕ Fin m₂ => Sum.elim β₁ β₂ x ⊗ₜ[A] Sum.elim r₁ r₂ x),
                Fintype.sum_sum_type]
              simp only [Sum.elim_inl, Sum.elim_inr]
      rcases hPure_or with rfl | h
      · exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
      · exact h
    obtain ⟨m, β, r₀, hQ_decomp⟩ := hPure (eR₀.symm Q_B)
    have hQ_B_eq : Q_B = Finset.univ.sum fun ν : Fin m => eR₀ ((β ν) ⊗ₜ[A] (r₀ ν)) := by
      have := congrArg eR₀ hQ_decomp
      rwa [eR₀.apply_symm_apply, map_sum] at this
    
    let φ₀_bilin : B →+ D.R₀ →+ (M.L₀ →+ TensorProduct A B M.L₀) :=
      { toFun := fun b_el =>
          { toFun := fun r_el =>
              { toFun := fun x => b_el ⊗ₜ[A] (r_el • x)
                map_zero' := by simp
                map_add' := fun x₁ x₂ => by rw [smul_add, TensorProduct.tmul_add] }
            map_zero' := by ext x; simp
            map_add' := fun r₁ r₂ => by ext x; dsimp; rw [add_smul, TensorProduct.tmul_add] }
        map_zero' := by ext r_el x; simp
        map_add' := fun b₁ b₂ => by ext r_el x; dsimp; rw [TensorProduct.add_tmul] }
    have hφ₀_smul : ∀ (a : A) (b_el : B) (r_el : D.R₀),
        φ₀_bilin (a • b_el) r_el = φ₀_bilin b_el (a • r_el) := by
      intro a b_el r_el
      ext x; dsimp [φ₀_bilin]
      have hr : (a • r_el) • x = a • (r_el • x) := by
        change (algebraMap A D.R₀ a * r_el) • x = (algebraMap A D.R₀ a) • (r_el • x)
        rw [mul_smul]
      rw [hr, TensorProduct.smul_tmul]
    let φ₀ : TensorProduct A B D.R₀ →+ (M.L₀ →+ TensorProduct A B M.L₀) :=
      TensorProduct.liftAddHom φ₀_bilin hφ₀_smul
    let φ_B_bilin : D_B.R₀ →+ (M.L₀ →+ TensorProduct A B M.L₀) := φ₀.comp eR₀.symm.toAddMonoidHom
    have hφ_B_smul : ∀ (r_el : D.R₀) (s_B : D_B.R₀) (x : M.L₀),
        φ_B_bilin (r_el • s_B) x = φ_B_bilin s_B (r_el • x) := by
      intro r_el s_B x
      obtain ⟨u, rfl⟩ : ∃ u, eR₀ u = s_B := ⟨eR₀.symm s_B, eR₀.apply_symm_apply s_B⟩
      have hsmul : r_el • eR₀ u = eR₀ (u * ((1 : B) ⊗ₜ[A] r_el)) := by
        change eR₀ ((1 : B) ⊗ₜ[A] r_el) * eR₀ u = eR₀ (u * ((1 : B) ⊗ₜ[A] r_el))
        rw [← map_mul, mul_comm]
      rw [hsmul]
      clear hsmul
      dsimp [φ_B_bilin]
      rw [RingEquiv.symm_apply_apply, RingEquiv.symm_apply_apply]
      induction u using TensorProduct.inductionOn with
      | tmul b_el r' =>
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        change b_el ⊗ₜ[A] ((r' * r_el) • x) = b_el ⊗ₜ[A] (r' • (r_el • x))
        rw [mul_smul]
      | add u₁ u₂ ih₁ ih₂ =>
        rw [add_mul, map_add, map_add, AddMonoidHom.add_apply, AddMonoidHom.add_apply, ih₁, ih₂]
    let φ_L : M_B.L₀ →+ TensorProduct A B M.L₀ := TensorProduct.liftAddHom φ_B_bilin hφ_B_smul
    have hφ_L_tmul : ∀ (b_el : B) (r_el : D.R₀) (x : M.L₀),
        φ_L (eR₀ (b_el ⊗ₜ[A] r_el) ⊗ₜ[D.R₀] x) = b_el ⊗ₜ[A] (r_el • x) := by
      intro b_el r_el x
      change φ₀ (eR₀.symm (eR₀ (b_el ⊗ₜ[A] r_el))) x = _
      rw [RingEquiv.symm_apply_apply]
      rfl
    refine ⟨v, m, β, r₀, ?_⟩
    have h_ap := congrArg φ_L hQ_B.symm
    rw [map_sub, map_sum] at h_ap
    have h_lhs1 : φ_L ((1 : D_B.R₀) ⊗ₜ[D.R₀] y₀) = (1 : B) ⊗ₜ[A] y₀ := by
      have h1 : (1 : D_B.R₀) = eR₀ ((1 : B) ⊗ₜ[A] (1 : D.R₀)) := (map_one eR₀).symm
      rw [h1, hφ_L_tmul, one_smul]
    have h_lhs2 : ∀ p : Fin D.r × Fin q,
        φ_L ((algebraMap (Polynomial B) D_B.R₀ (Polynomial.C (v p)) *
          (algebraMap (Polynomial B) D_B.R₀ Polynomial.X) ^ p.2.val * D_B.b₀ p.1) • σ₀_B) =
          (v p) ⊗ₜ[A] ((t ^ p.2.val * D.b₀ p.1) • σ₀) := by
      intro p
      dsimp [σ₀_B]
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, hψ₀_C, hψ₀_X]
      change φ_L ((eR₀ ((v p) ⊗ₜ[A] 1) * (eR₀ ((1 : B) ⊗ₜ[A] t)) ^ p.2.val *
        eR₀ ((1 : B) ⊗ₜ[A] D.b₀ p.1)) ⊗ₜ[D.R₀] σ₀) = _
      have hpow : (eR₀ ((1 : B) ⊗ₜ[A] t)) ^ p.2.val = eR₀ ((1 : B) ⊗ₜ[A] (t ^ p.2.val)) := by
        rw [← map_pow, ← Algebra.TensorProduct.includeRight_apply (R := A) (A := B),
          ← map_pow, Algebra.TensorProduct.includeRight_apply]
      rw [hpow, ← map_mul, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_one, one_mul, hφ_L_tmul]
    have h_rhs : φ_L (Q_B • w₀_B) = Finset.univ.sum (fun ν : Fin m =>
        (β ν) ⊗ₜ[A] (r₀ ν • w_base₀) +
          Finset.univ.sum (fun p' : Fin D.r × Fin m_U =>
            (β ν * u_B p'.1 p'.2) ⊗ₜ[A] (r₀ ν • w_U₀ p'.1 p'.2))) := by
      rw [hQ_B_eq, Finset.sum_smul, map_sum]
      apply Finset.sum_congr rfl
      intro ν _
      dsimp only [w₀_B]
      rw [smul_add, Finset.smul_sum, map_add, map_sum]
      congr 1
      · rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, hφ_L_tmul]
      · apply Finset.sum_congr rfl
        intro p' _
        rw [TensorProduct.smul_tmul', smul_eq_mul, hψ₀_C, ← map_mul,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, hφ_L_tmul]
    rw [h_lhs1, Finset.sum_congr rfl (fun p _ => h_lhs2 p), h_rhs] at h_ap
    exact h_ap

  
  let Idx_U := Fin D.r × Fin m_U
  let Idx_q := Fin D.r × Fin q
  let S := MvPolynomial Idx_U A
  have hNoeth_S : IsNoetherianRing S := MvPolynomial.isNoetherianRing
  let ev₀_bar : S →+* k := τ_A.toRingHom.comp (MvPolynomial.eval (0 : Idx_U → A))
  have hSurj_ev : Function.Surjective ev₀_bar := by
    intro c
    refine ⟨MvPolynomial.C (algebraMap k A c), ?_⟩
    change τ_A (MvPolynomial.eval 0 (MvPolynomial.C (algebraMap k A c))) = c
    rw [MvPolynomial.eval_C]
    exact τ_A.commutes c
  let P₀ : Ideal S := RingHom.ker ev₀_bar
  have hPrime_P₀ : P₀.IsPrime := (RingHom.ker_isMaximal_of_surjective ev₀_bar hSurj_ev).isPrime
  let W : Submonoid S := P₀.primeCompl
  let B_loc := Localization W
  have hNoeth_Bloc : IsNoetherianRing B_loc := IsLocalization.isNoetherianRing W B_loc hNoeth_S
  have hLoc_Bloc : IsLocalRing B_loc :=
    @IsLocalization.AtPrime.isLocalRing S _ B_loc _ _ P₀ hPrime_P₀ inferInstance
  have hW_ne : ∀ w : W, ev₀_bar w.1 ≠ 0 := fun w hw => w.2 hw
  have hW_unit : ∀ w : W, IsUnit (ev₀_bar w.1) := fun w => (hW_ne w).isUnit
  let τ_B_ring : B_loc →+* k := IsLocalization.lift hW_unit
  have hτ_AB_loc : ∀ a : A, τ_B_ring (algebraMap A B_loc a) = τ_A a := by
    intro a
    rw [IsScalarTower.algebraMap_apply A S B_loc a, MvPolynomial.algebraMap_eq]
    change IsLocalization.lift hW_unit (algebraMap S B_loc (MvPolynomial.C a)) = τ_A a
    rw [IsLocalization.lift_eq hW_unit]
    change τ_A (MvPolynomial.eval 0 (MvPolynomial.C a)) = τ_A a
    rw [MvPolynomial.eval_C]
  let τ_B : B_loc →ₐ[k] k :=
    { toRingHom := τ_B_ring
      commutes' := fun c => by
        rw [IsScalarTower.algebraMap_apply k A B_loc c]
        change τ_B_ring (algebraMap A B_loc (algebraMap k A c)) = _
        rw [hτ_AB_loc]
        exact τ_A.commutes c }
  have hKer_Bloc : ∀ b : B_loc, τ_B b = 0 ↔ ¬ IsUnit b := by
    intro b
    obtain ⟨⟨f, w⟩, rfl⟩ := IsLocalization.mk'_surjective W b
    dsimp only
    have hspec : algebraMap S B_loc w.1 * IsLocalization.mk' B_loc f w = algebraMap S B_loc f :=
      IsLocalization.mk'_spec' B_loc f w
    have h_ap := congrArg τ_B_ring hspec
    rw [map_mul, IsLocalization.lift_eq hW_unit w.1, IsLocalization.lift_eq hW_unit f] at h_ap
    have h_zero : τ_B (IsLocalization.mk' B_loc f w) = 0 ↔ ev₀_bar f = 0 := by
      change τ_B_ring (IsLocalization.mk' B_loc f w) = 0 ↔ ev₀_bar f = 0
      rw [← h_ap, mul_eq_zero]
      exact ⟨fun h => Or.inr h, fun h => h.resolve_left (hW_ne w)⟩
    have h_unit : IsUnit (IsLocalization.mk' B_loc f w) ↔ f ∈ P₀.primeCompl :=
      @IsLocalization.AtPrime.isUnit_mk'_iff S _ B_loc _ _ P₀ hPrime_P₀ inferInstance f w
    rw [h_zero, h_unit]
    exact ⟨fun hf hmem => hmem hf, fun hnot => Classical.not_not.mp hnot⟩
  let u_Bloc : Fin D.r → Fin m_U → B_loc := fun j k₀ =>
    algebraMap S B_loc (MvPolynomial.X (j, k₀))
  have hu_Bloc : ∀ (j : Fin D.r) (k₀ : Fin m_U), τ_B (u_Bloc j k₀) = 0 := by
    intro j k₀
    change IsLocalization.lift hW_unit (algebraMap S B_loc (MvPolynomial.X (j, k₀))) = 0
    rw [IsLocalization.lift_eq hW_unit]
    change τ_A (MvPolynomial.eval 0 (MvPolynomial.X (j, k₀))) = 0
    rw [MvPolynomial.eval_X, Pi.zero_apply, map_zero]

  
  let ρ_bar : A →+* D₀.R₀ := ((algebraMap (Polynomial k) D₀.R₀).comp Polynomial.C).comp τ_A.toRingHom
  have hπ₀_C : ∀ a : A, π₀ (algebraMap (Polynomial A) D.R₀ (Polynomial.C a)) = ρ_bar a := by
    intro a
    have h := hValid.2.2.2.1 (Polynomial.C a)
    simpa [π₀, ρ_bar, Polynomial.map_C] using h
  have hπ₀_t : π₀ t = t_bar := by
    have h := hValid.2.2.2.1 Polynomial.X
    simpa [π₀, t, t_bar, Polynomial.map_X] using h
  let f₀_loc : TensorProduct A (MvPolynomial (Fin D.r × Fin m_U) A) M.L₀ →ₗ[S]
      TensorProduct S B_loc (TensorProduct A (MvPolynomial (Fin D.r × Fin m_U) A) M.L₀) :=
    TensorProduct.mk S B_loc (TensorProduct A (MvPolynomial (Fin D.r × Fin m_U) A) M.L₀) (1 : B_loc)
  have hf₀_loc : IsLocalizedModule W f₀_loc :=
    IsLocalization.tensorProduct_isLocalizedModule W B_loc
  let e_can : TensorProduct S B_loc (TensorProduct A (MvPolynomial (Fin D.r × Fin m_U) A) M.L₀) ≃ₗ[S]
      TensorProduct A B_loc M.L₀ :=
    (TensorProduct.AlgebraTensorModule.cancelBaseChange A S B_loc B_loc M.L₀).restrictScalars S
  let j_loc : TensorProduct A (MvPolynomial (Fin D.r × Fin m_U) A) M.L₀ →ₗ[S]
      TensorProduct A B_loc M.L₀ :=
    e_can.toLinearMap.comp f₀_loc
  have hj_loc : IsLocalizedModule W j_loc :=
    @IsLocalizedModule.of_linearEquiv S _ W _ _ _ _ _ _ _ _ _ f₀_loc e_can hf₀_loc
  have hj_tmul : ∀ (s : S) (x : M.L₀),
      j_loc (s ⊗ₜ[A] x) = (algebraMap S B_loc s) ⊗ₜ[A] x := by
    intro s x
    change (TensorProduct.AlgebraTensorModule.cancelBaseChange A S B_loc B_loc M.L₀)
      ((1 : B_loc) ⊗ₜ[S] (s ⊗ₜ[A] x)) = _
    rw [TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, Algebra.smul_def, mul_one]

  
  let Λ_bilin : MvPolynomial (Fin D.r × Fin m_U) A →+ M.L₀ →+ MvPolynomial (Fin D.r × Fin m_U) D₀.R₀ :=
    { toFun := fun P =>
        { toFun := fun x => (MvPolynomial.map ρ_bar P) * MvPolynomial.C (π₀ (lam₀ x))
          map_zero' := by simp
          map_add' := fun x₁ x₂ => by rw [map_add, map_add, map_add, mul_add] }
      map_zero' := AddMonoidHom.ext fun x => by simp
      map_add' := fun P₁ P₂ => AddMonoidHom.ext fun x => by dsimp; rw [map_add, add_mul] }
  have hΛ_smul : ∀ (a : A) (P : MvPolynomial (Fin D.r × Fin m_U) A) (x : M.L₀),
      Λ_bilin (a • P) x = Λ_bilin P (a • x) := by
    intro a P x
    dsimp [Λ_bilin]
    have hP : a • P = MvPolynomial.C a * P := MvPolynomial.smul_eq_C_mul P a
    have hx : lam₀ (a • x) = algebraMap (Polynomial A) D.R₀ (Polynomial.C a) * lam₀ x := by
      change lam₀ ((algebraMap (Polynomial A) D.R₀ (Polynomial.C a)) • x) = _
      rw [LinearMap.map_smul, smul_eq_mul]
    rw [hP, map_mul, MvPolynomial.map_C, hx, map_mul, hπ₀_C a, map_mul]
    ring
  let Λ_bar : TensorProduct A (MvPolynomial (Fin D.r × Fin m_U) A) M.L₀ →+
      MvPolynomial (Fin D.r × Fin m_U) D₀.R₀ :=
    TensorProduct.liftAddHom Λ_bilin hΛ_smul

  have hSingle : ∀ i : ι,
      ∃ (w_den : W) (A_0 : Idx_q → S) (Q_bar_0 : MvPolynomial Idx_U D₀.R₀),
        (∀ u_pt : Idx_U → A,
          (algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt w_den.1))) • y i -
            Finset.univ.sum (fun p : Idx_q =>
              (algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt (A_0 p))) *
                t ^ p.2.val * D.b₀ p.1) • σ₀) ∈
            Submodule.span D.R₀
              {w_base₀ + Finset.univ.sum (fun p' : Idx_U =>
                (algebraMap (Polynomial A) D.R₀ (Polynomial.C (u_pt p'))) • w_U₀ p'.1 p'.2)}) ∧
        ((MvPolynomial.map ρ_bar w_den.1) * MvPolynomial.C (π₀ (lam₀ (y i))) -
          Finset.univ.sum (fun p : Idx_q =>
            (MvPolynomial.map ρ_bar (A_0 p)) * MvPolynomial.C (t_bar ^ p.2.val * π₀ (D.b₀ p.1))) =
          Q_bar_0 *
            (MvPolynomial.C (t_bar ^ q) +
              Finset.univ.sum (fun p' : Idx_U =>
                MvPolynomial.C (t_bar ^ p'.2.val * π₀ (D.b₀ p'.1)) * MvPolynomial.X p'))) := by
    intro i
    obtain ⟨v, m, β, r₀, hRel_B⟩ :=
      hStep2 B_loc τ_B hNoeth_Bloc hLoc_Bloc hKer_Bloc hτ_AB_loc u_Bloc hu_Bloc (y i)
    choose vw₁ hvw₁ using fun p : Idx_q => IsLocalization.surj W (v p)
    choose βw₂ hβw₂ using fun ν : Fin m => IsLocalization.surj W (β ν)
    let a_num : Idx_q → S := fun p => (vw₁ p).1
    let w₁ : Idx_q → W := fun p => (vw₁ p).2
    let b_num : Fin m → S := fun ν => (βw₂ ν).1
    let w₂ : Fin m → W := fun ν => (βw₂ ν).2
    let P_w₁ : W := Finset.univ.prod w₁
    let P_w₂ : W := Finset.univ.prod w₂
    let d₁ : W := P_w₁ * P_w₂
    let c₁ : Idx_q → S := fun p =>
      ((Finset.univ.erase p).prod (fun p' => (w₁ p').1)) * P_w₂.1
    let c₂ : Fin m → S := fun ν =>
      P_w₁.1 * ((Finset.univ.erase ν).prod (fun μ => (w₂ μ).1))
    let A_tilde : Idx_q → S := fun p => c₁ p * a_num p
    let B_tilde : Fin m → S := fun ν => c₂ ν * b_num ν
    have hc₁_mul : ∀ p : Idx_q, c₁ p * (w₁ p).1 = d₁.1 := by
      intro p
      simp only [c₁, d₁, P_w₁, P_w₂, Submonoid.coe_mul, Submonoid.coe_finsetProd]
      rw [mul_right_comm, Finset.prod_erase_mul Finset.univ (fun p' => (w₁ p').1) (Finset.mem_univ p)]
    have hc₂_mul : ∀ ν : Fin m, c₂ ν * (w₂ ν).1 = d₁.1 := by
      intro ν
      simp only [c₂, d₁, P_w₁, P_w₂, Submonoid.coe_mul, Submonoid.coe_finsetProd]
      rw [mul_assoc, Finset.prod_erase_mul Finset.univ (fun μ => (w₂ μ).1) (Finset.mem_univ ν)]
    have hv_clear : ∀ p : Idx_q,
        algebraMap S B_loc (A_tilde p) = algebraMap S B_loc d₁.1 * v p := by
      intro p
      have hp : v p * algebraMap S B_loc (w₁ p).1 = algebraMap S B_loc (a_num p) := hvw₁ p
      dsimp [A_tilde]
      rw [map_mul, ← hp, ← mul_assoc, mul_right_comm (algebraMap S B_loc (c₁ p)),
        ← map_mul, hc₁_mul p]
    have hβ_clear : ∀ ν : Fin m,
        algebraMap S B_loc (B_tilde ν) = algebraMap S B_loc d₁.1 * β ν := by
      intro ν
      have hν : β ν * algebraMap S B_loc (w₂ ν).1 = algebraMap S B_loc (b_num ν) := hβw₂ ν
      dsimp [B_tilde]
      rw [map_mul, ← hν, ← mul_assoc, mul_right_comm (algebraMap S B_loc (c₂ ν)),
        ← map_mul, hc₂_mul ν]
    let err : TensorProduct A (MvPolynomial (Fin D.r × Fin m_U) A) M.L₀ :=
      (d₁.1 ⊗ₜ[A] y i -
        Finset.univ.sum (fun p : Idx_q =>
          (A_tilde p) ⊗ₜ[A] ((t ^ p.2.val * D.b₀ p.1) • σ₀))) -
      Finset.univ.sum (fun ν : Fin m =>
        (B_tilde ν) ⊗ₜ[A] (r₀ ν • w_base₀) +
          Finset.univ.sum (fun p' : Idx_U =>
            (B_tilde ν * MvPolynomial.X p') ⊗ₜ[A] (r₀ ν • w_U₀ p'.1 p'.2)))
    have hj_err : j_loc err = 0 := by
      let μ_d₁ : TensorProduct A B_loc M.L₀ →ₗ[B_loc] TensorProduct A B_loc M.L₀ :=
        LinearMap.lsmul B_loc (TensorProduct A B_loc M.L₀) (algebraMap S B_loc d₁.1)
      have h0 : μ_d₁ (((1 : B_loc) ⊗ₜ[A] y i -
          Finset.univ.sum (fun p : Idx_q =>
            (v p) ⊗ₜ[A] ((t ^ p.2.val * D.b₀ p.1) • σ₀))) -
          Finset.univ.sum (fun ν : Fin m =>
            (β ν) ⊗ₜ[A] (r₀ ν • w_base₀) +
              Finset.univ.sum (fun p' : Idx_U =>
                (β ν * u_Bloc p'.1 p'.2) ⊗ₜ[A] (r₀ ν • w_U₀ p'.1 p'.2)))) = 0 := by
        rw [sub_eq_zero.mpr hRel_B, map_zero]
      simp only [map_sub, map_sum, map_add] at h0
      dsimp only [err]
      simp only [map_sub, map_sum, map_add, hj_tmul]
      have hpull_B : ∀ (b_el : B_loc) (x : M.L₀),
          (algebraMap S B_loc d₁.1 * b_el) ⊗ₜ[A] x =
            (algebraMap S B_loc d₁.1) • (b_el ⊗ₜ[A] x) := by
        intro b_el x
        rw [TensorProduct.smul_tmul', smul_eq_mul]
      have hd₁_y : (algebraMap S B_loc d₁.1) ⊗ₜ[A] y i =
          (algebraMap S B_loc d₁.1) • ((1 : B_loc) ⊗ₜ[A] y i) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      have hX_clear : ∀ (ν : Fin m) (p' : Idx_U),
          algebraMap S B_loc (B_tilde ν * MvPolynomial.X p') =
            algebraMap S B_loc d₁.1 * (β ν * u_Bloc p'.1 p'.2) := by
        intro ν p'
        rw [map_mul, hβ_clear ν, mul_assoc]
      simp only [hv_clear, hβ_clear, hX_clear, hpull_B, hd₁_y]
      exact h0
    obtain ⟨d₂, hd₂⟩ := (IsLocalizedModule.eq_zero_iff W j_loc).mp hj_err
    let w_den : W := d₂ * d₁
    let A_0 : Idx_q → S := fun p => d₂.1 * A_tilde p
    let B_0 : Fin m → S := fun ν => d₂.1 * B_tilde ν
    have hRel_S :
        (w_den.1 ⊗ₜ[A] y i : TensorProduct A (MvPolynomial (Fin D.r × Fin m_U) A) M.L₀) -
          Finset.univ.sum (fun p : Idx_q =>
            (A_0 p) ⊗ₜ[A] ((t ^ p.2.val * D.b₀ p.1) • σ₀)) =
        Finset.univ.sum (fun ν : Fin m =>
          (B_0 ν) ⊗ₜ[A] (r₀ ν • w_base₀) +
            Finset.univ.sum (fun p' : Idx_U =>
              (B_0 ν * MvPolynomial.X p') ⊗ₜ[A] (r₀ ν • w_U₀ p'.1 p'.2))) := by
      change (d₂.1 : S) • err = 0 at hd₂
      dsimp only [err] at hd₂
      simp only [smul_sub, Finset.smul_sum, smul_add, TensorProduct.smul_tmul', smul_eq_mul] at hd₂
      have hm_assoc : ∀ (ν : Fin m) (p' : Idx_U),
          d₂.1 * (B_tilde ν * MvPolynomial.X p') = B_0 ν * MvPolynomial.X p' :=
        fun ν p' => (mul_assoc d₂.1 (B_tilde ν) _).symm
      simp only [hm_assoc] at hd₂
      exact sub_eq_zero.mp hd₂
    let Q_bar_0 : MvPolynomial Idx_U D₀.R₀ :=
      Finset.univ.sum fun ν : Fin m =>
        (MvPolynomial.map ρ_bar (B_0 ν)) * MvPolynomial.C (π₀ (r₀ ν))
    refine ⟨w_den, A_0, Q_bar_0, ?_, ?_⟩
    · 
      intro u_pt
      let ev_bilin : MvPolynomial (Fin D.r × Fin m_U) A →+ M.L₀ →+ M.L₀ :=
        { toFun := fun P =>
            { toFun := fun x =>
                (algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt P))) • x
              map_zero' := smul_zero _
              map_add' := fun x₁ x₂ => smul_add _ x₁ x₂ }
          map_zero' := by ext x; simp
          map_add' := fun P₁ P₂ => by ext x; dsimp; rw [map_add, map_add, map_add, add_smul] }
      have hev_smul : ∀ (a : A) (P : MvPolynomial (Fin D.r × Fin m_U) A) (x : M.L₀),
          ev_bilin (a • P) x = ev_bilin P (a • x) := by
        intro a P x
        dsimp [ev_bilin]
        rw [MvPolynomial.smul_eq_C_mul, map_mul, MvPolynomial.eval_C, map_mul, map_mul]
        change (_ * _) • x = _ • ((algebraMap (Polynomial A) D.R₀ (Polynomial.C a)) • x)
        rw [mul_comm, mul_smul]
      let ev_L : TensorProduct A (MvPolynomial (Fin D.r × Fin m_U) A) M.L₀ →+ M.L₀ :=
        TensorProduct.liftAddHom ev_bilin hev_smul
      have h_ev := congrArg ev_L hRel_S
      dsimp only [ev_L, ev_bilin] at h_ev
      simp only [map_sub, map_sum, map_add, TensorProduct.liftAddHom_tmul,
        AddMonoidHom.coe_mk, ZeroHom.coe_mk] at h_ev
      have h_lhs_p : ∀ p : Idx_q,
          (algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt (A_0 p)))) •
            ((t ^ p.2.val * D.b₀ p.1) • σ₀) =
          (algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt (A_0 p))) *
            t ^ p.2.val * D.b₀ p.1) • σ₀ := by
        intro p
        rw [← mul_smul, mul_assoc]
      simp only [h_lhs_p] at h_ev
      rw [h_ev, Submodule.mem_span_singleton]
      refine ⟨Finset.univ.sum fun ν : Fin m =>
        algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt (B_0 ν))) * r₀ ν, ?_⟩
      rw [Finset.sum_smul]
      apply Finset.sum_congr rfl
      intro ν _
      rw [smul_add, Finset.smul_sum, mul_smul]
      congr 1
      apply Finset.sum_congr rfl
      intro p' _
      rw [(MvPolynomial.eval u_pt).map_mul (B_0 ν) (MvPolynomial.X p'),
        MvPolynomial.eval_X,
        Polynomial.C.map_mul (MvPolynomial.eval u_pt (B_0 ν)) (u_pt p'),
        (algebraMap (Polynomial A) D.R₀).map_mul
          (Polynomial.C (MvPolynomial.eval u_pt (B_0 ν))) (Polynomial.C (u_pt p')),
        ← mul_smul, ← mul_smul]
      congr 1
      ring
    · 
      have h_lam := congrArg Λ_bar hRel_S
      dsimp only [Λ_bar, Λ_bilin] at h_lam
      simp only [map_sub, map_sum, map_add, TensorProduct.liftAddHom_tmul,
        AddMonoidHom.coe_mk, ZeroHom.coe_mk] at h_lam
      have h_p : ∀ p : Idx_q,
          π₀ (lam₀ ((t ^ p.2.val * D.b₀ p.1) • σ₀)) = t_bar ^ p.2.val * π₀ (D.b₀ p.1) := by
        intro p
        rw [LinearMap.map_smul, smul_eq_mul, map_mul, map_mul, map_pow, hπ₀_t, hσ₀, mul_one]
      have h_base : ∀ ν : Fin m,
          π₀ (lam₀ (r₀ ν • w_base₀)) = π₀ (r₀ ν) * t_bar ^ q := by
        intro ν
        rw [LinearMap.map_smul, smul_eq_mul, map_mul, hBase_lam₀]
      have h_U : ∀ (ν : Fin m) (p' : Idx_U),
          π₀ (lam₀ (r₀ ν • w_U₀ p'.1 p'.2)) =
            π₀ (r₀ ν) * (t_bar ^ p'.2.val * π₀ (D.b₀ p'.1)) := by
        intro ν p'
        rw [LinearMap.map_smul, smul_eq_mul, map_mul, (hFam p'.1 p'.2).2]
      simp only [h_p, h_base, h_U] at h_lam
      rw [h_lam]
      dsimp only [Q_bar_0]
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro ν _
      rw [mul_add, Finset.mul_sum, MvPolynomial.C.map_mul, mul_assoc]
      congr 1
      apply Finset.sum_congr rfl
      intro p' _
      rw [(MvPolynomial.map ρ_bar).map_mul (B_0 ν) (MvPolynomial.X p'),
        MvPolynomial.map_X, MvPolynomial.C.map_mul]
      ring

  
  choose w_den A_0 Q_bar_0 hSpan_0 hPoly_0 using hSingle
  let Δ : S := Finset.univ.prod fun j : ι => (w_den j).1
  let C_i : ι → S := fun i => (Finset.univ.erase i).prod fun j : ι => (w_den j).1
  have hC_mul : ∀ i : ι, C_i i * (w_den i).1 = Δ := fun i =>
    Finset.prod_erase_mul Finset.univ (fun j : ι => (w_den j).1) (Finset.mem_univ i)
  refine ⟨Δ, fun i p => C_i i * A_0 i p, fun i => (MvPolynomial.map ρ_bar (C_i i)) * Q_bar_0 i,
    ?_, ?_, ?_⟩
  · 
    change ev₀_bar Δ ≠ 0
    dsimp only [Δ]
    rw [map_prod, Finset.prod_ne_zero_iff]
    intro j _
    exact hW_ne (w_den j)
  · 
    intro u_pt i
    have hΔ_i : MvPolynomial.eval u_pt Δ =
        MvPolynomial.eval u_pt (C_i i) * MvPolynomial.eval u_pt (w_den i).1 := by
      rw [← hC_mul i, map_mul]
    have h_factor :
        (algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt Δ))) • y i -
          Finset.univ.sum (fun p : Idx_q =>
            (algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt (C_i i * A_0 i p))) *
              t ^ p.2.val * D.b₀ p.1) • σ₀) =
        (algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt (C_i i)))) •
          ((algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt (w_den i).1))) • y i -
            Finset.univ.sum (fun p : Idx_q =>
              (algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt (A_0 i p))) *
                t ^ p.2.val * D.b₀ p.1) • σ₀)) := by
      rw [hΔ_i, smul_sub, Finset.smul_sum, map_mul, map_mul, mul_smul]
      congr 1
      apply Finset.sum_congr rfl
      intro p _
      rw [map_mul, map_mul, map_mul, ← mul_smul]
      congr 1
      ring
    rw [h_factor]
    exact Submodule.smul_mem _ _ (hSpan_0 i u_pt)
  · 
    intro i
    change (MvPolynomial.map ρ_bar Δ) * MvPolynomial.C (π₀ (lam₀ (y i))) -
      Finset.univ.sum (fun p : Idx_q =>
        (MvPolynomial.map ρ_bar (C_i i * A_0 i p)) *
          MvPolynomial.C (t_bar ^ p.2.val * π₀ (D.b₀ p.1))) =
      ((MvPolynomial.map ρ_bar (C_i i)) * Q_bar_0 i) *
        (MvPolynomial.C (t_bar ^ q) +
          Finset.univ.sum (fun p' : Idx_U =>
            MvPolynomial.C (t_bar ^ p'.2.val * π₀ (D.b₀ p'.1)) * MvPolynomial.X p'))
    have hΔ_map : MvPolynomial.map ρ_bar Δ =
        MvPolynomial.map ρ_bar (C_i i) * MvPolynomial.map ρ_bar (w_den i).1 := by
      rw [← hC_mul i, map_mul]
    have h_lhs_fac :
        (MvPolynomial.map ρ_bar Δ) * MvPolynomial.C (π₀ (lam₀ (y i))) -
          Finset.univ.sum (fun p : Idx_q =>
            (MvPolynomial.map ρ_bar (C_i i * A_0 i p)) *
              MvPolynomial.C (t_bar ^ p.2.val * π₀ (D.b₀ p.1))) =
        (MvPolynomial.map ρ_bar (C_i i)) *
          ((MvPolynomial.map ρ_bar (w_den i).1) * MvPolynomial.C (π₀ (lam₀ (y i))) -
            Finset.univ.sum (fun p : Idx_q =>
              (MvPolynomial.map ρ_bar (A_0 i p)) *
                MvPolynomial.C (t_bar ^ p.2.val * π₀ (D.b₀ p.1)))) := by
      rw [hΔ_map, mul_sub, Finset.mul_sum, mul_assoc]
      congr 1
      apply Finset.sum_congr rfl
      intro p _
      rw [map_mul, mul_assoc]
    rw [h_lhs_fac, hPoly_0 i, mul_assoc]

theorem weil_twoChart_diagonal_jacobian_hensel_root (k : Type u) [Field k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (hA_ker : ∀ a : A, τ_A a = 0 ↔ ¬ IsUnit a)
    (D : WeilTwoChartRingDatum A) (D₀ : WeilTwoChartRingDatum k)
    (red : WeilTwoChartCurveReduction D D₀)
    (hValid : WeilIsValidTwoChartCurveReduction τ_A D D₀ red)
    (M : WeilTwoChartLineBundle D)
    (n : ℕ) (hn_pos : 1 ≤ n)
    (hHensel : ∀ (N : ℕ) (F : Fin N → MvPolynomial (Fin N) A) (x₀ : Fin N → A),
      (∀ i : Fin N, τ_A (MvPolynomial.eval x₀ (F i)) = 0) →
      (Matrix.of fun i j : Fin N =>
        τ_A (MvPolynomial.eval x₀ (MvPolynomial.pderiv j (F i)))).det ≠ 0 →
      ∃ x : Fin N → A,
        (∀ j : Fin N, τ_A (x j) = τ_A (x₀ j)) ∧
        (∀ i : Fin N, MvPolynomial.eval x (F i) = 0))
    (lam₀ : M.L₀ →ₗ[D.R₀] D.R₀)
    (σ₀ w_base₀ : M.L₀)
    (w_U₀ : Fin D.r → Fin ((ℓ - 1) * n) → M.L₀) :
    letI : Algebra D.R₀ D₀.R₀ := red.algR₀
    let t : D.R₀ := algebraMap (Polynomial A) D.R₀ Polynomial.X
    let t_bar : D₀.R₀ := algebraMap (Polynomial k) D₀.R₀ Polynomial.X
    let π₀ : D.R₀ →+* D₀.R₀ := algebraMap D.R₀ D₀.R₀
    π₀ (lam₀ σ₀) = 1 →
    (∀ {ι : Type} [Fintype ι] (y : ι → M.L₀),
      ∃ (Δ : MvPolynomial (Fin D.r × Fin ((ℓ - 1) * n)) A)
        (A_coeff : ι → Fin D.r × Fin (ℓ * n) → MvPolynomial (Fin D.r × Fin ((ℓ - 1) * n)) A)
        (Q_bar : ι → MvPolynomial (Fin D.r × Fin ((ℓ - 1) * n)) D₀.R₀),
        τ_A (MvPolynomial.eval 0 Δ) ≠ 0 ∧
        (∀ (u_pt : Fin D.r × Fin ((ℓ - 1) * n) → A) (i : ι),
          (algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt Δ))) • y i -
            Finset.univ.sum (fun p : Fin D.r × Fin (ℓ * n) =>
              (algebraMap (Polynomial A) D.R₀ (Polynomial.C (MvPolynomial.eval u_pt (A_coeff i p))) *
                t ^ p.2.val * D.b₀ p.1) • σ₀) ∈
            Submodule.span D.R₀
              {w_base₀ + Finset.univ.sum (fun p' : Fin D.r × Fin ((ℓ - 1) * n) =>
                (algebraMap (Polynomial A) D.R₀ (Polynomial.C (u_pt p'))) • w_U₀ p'.1 p'.2)}) ∧
        (∀ i : ι,
          (MvPolynomial.map (((algebraMap (Polynomial k) D₀.R₀).comp Polynomial.C).comp τ_A.toRingHom) Δ) *
            MvPolynomial.C (π₀ (lam₀ (y i))) -
          Finset.univ.sum (fun p : Fin D.r × Fin (ℓ * n) =>
            (MvPolynomial.map (((algebraMap (Polynomial k) D₀.R₀).comp Polynomial.C).comp τ_A.toRingHom)
              (A_coeff i p)) *
            MvPolynomial.C (t_bar ^ p.2.val * π₀ (D.b₀ p.1))) =
          Q_bar i *
            (MvPolynomial.C (t_bar ^ (ℓ * n)) +
              Finset.univ.sum (fun p' : Fin D.r × Fin ((ℓ - 1) * n) =>
                MvPolynomial.C (t_bar ^ p'.2.val * π₀ (D.b₀ p'.1)) * MvPolynomial.X p')))) →
    ∃ (c : Fin D.r → Fin n → A) (u_pt : Fin D.r × Fin ((ℓ - 1) * n) → A),
      (∀ (j : Fin D.r) (s : Fin n), τ_A (c j s) = 0) ∧
      (∀ p' : Fin D.r × Fin ((ℓ - 1) * n), τ_A (u_pt p') = 0) ∧
      ((t ^ n + Finset.univ.sum fun j : Fin D.r =>
          Finset.univ.sum fun s : Fin n =>
            algebraMap (Polynomial A) D.R₀ (Polynomial.C (c j s)) * t ^ s.val * D.b₀ j) ^ ℓ) • σ₀ ∈
        Submodule.span D.R₀
          {w_base₀ + Finset.univ.sum (fun p' : Fin D.r × Fin ((ℓ - 1) * n) =>
            (algebraMap (Polynomial A) D.R₀ (Polynomial.C (u_pt p'))) • w_U₀ p'.1 p'.2)} :=
by
  letI : Algebra D.R₀ D₀.R₀ := red.algR₀
  intro t t_bar π₀ hσ₀ hDiv
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_two : 2 ≤ ℓ := hℓ_prime.two_le
  have hℓ_pos : 1 ≤ ℓ := by omega
  have hq_sum : (ℓ - 1) * n + n = ℓ * n := by
    calc
      (ℓ - 1) * n + n = (ℓ - 1) * n + 1 * n := by rw [one_mul]
      _ = (ℓ - 1 + 1) * n := (add_mul (ℓ - 1) 1 n).symm
      _ = ℓ * n := by rw [Nat.sub_add_cancel hℓ_pos]
