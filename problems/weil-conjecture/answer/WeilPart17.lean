          (gM : TensorProduct R T T) * iL (u : T) := by
        apply cancel_of_mul_sigma eL iL
        intro x
        have hF := hgM (α x)
        rw [hσ x] at hF
        have hL_split : ((1 : T) ⊗ₜ[R] ((u : T) * eL ((1 : T) ⊗ₜ[R] x)) : TensorProduct R T T) =
            iR (u : T) * ((1 : T) ⊗ₜ[R] eL ((1 : T) ⊗ₜ[R] x)) := by simp [iR]
        have hR_split : (((u : T) * eL ((1 : T) ⊗ₜ[R] x)) ⊗ₜ[R] (1 : T) : TensorProduct R T T) =
            iL (u : T) * (eL ((1 : T) ⊗ₜ[R] x) ⊗ₜ[R] (1 : T)) := by simp [iL]
        rw [hL_split, hgL x, hR_split, ← mul_assoc, ← mul_assoc] at hF
        exact hF
