      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let _ := hAdd_pb
    refine ⟨pb_h.obj F₂, ⟨hc, hr, ⟨Iso.refl _⟩⟩, fun hTor => ?_⟩
    rw [← pb_h.map_id, ← pb_h.map_nsmul, hTor, pb_h.map_zero]
  · 
    intro X₁ X₂ X₃ f g F₃ F₂ F₁ hg hf
    rcases hg with ⟨hc_g, hr_g, ⟨e₂⟩⟩
    rcases hf with ⟨hc_f, hr_f, ⟨e₁⟩⟩
    obtain ⟨hc_fg, hr_fg, _, _⟩ := hSite (f ≫ g)
    obtain ⟨e_comp⟩ := @hCompPbIso X₁ X₂ X₃ f g hc_f hc_g hc_fg hr_f hr_g hr_fg
    let pb_f := (weilAltCdSitePullback f).sheafPullback AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    exact ⟨hc_fg, hr_fg, ⟨(e_comp.app F₃).trans ((pb_f.mapIso e₂).trans e₁)⟩⟩
  · 
    intro X₁ X₂ X₃ f g F₃ F₂ F₁ hg hfg
    rcases hg with ⟨hc_g, hr_g, ⟨e₂⟩⟩
    rcases hfg with ⟨hc_fg, hr_fg, ⟨e₁₃⟩⟩
    obtain ⟨hc_f, hr_f, _, _⟩ := hSite f
    obtain ⟨e_comp⟩ := @hCompPbIso X₁ X₂ X₃ f g hc_f hc_g hc_fg hr_f hr_g hr_fg
    let pb_f := (weilAltCdSitePullback f).sheafPullback AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    exact ⟨hc_f, hr_f, ⟨(pb_f.mapIso e₂.symm).trans ((e_comp.app F₃).symm.trans e₁₃)⟩⟩
  · 
    intro W F hEmpW
    have hZeroF : Limits.IsZero F := by
      rw [Limits.IsZero.iff_id_eq_zero]
      apply Sheaf.hom_ext
      ext E_op σ
      have hEmpE : IsEmpty ↥E_op.unop.left :=
        @Function.isEmpty _ _ hEmpW (E_op.unop.hom : E_op.unop.left ⟶ W).base
      have _hSub : Subsingleton (F.obj.obj E_op) := hEmptySub F E_op.unop hEmpE
      exact Subsingleton.elim _ _
    exact ⟨0, ⟨fun g₁ g₂ _ => hZeroF.eq_of_tgt g₁ g₂⟩⟩
  · 
    intro W_red W Y_red i_red _ π_red _ F F_red u_red hRange hTor hPb hu_red
    obtain ⟨β, hβ⟩ := hClosedImmLocalKer i_red π_red F F_red u_red hTor hPb hu_red
    refine ⟨β, hMonoOfLocalZero F _ β (fun E σ x hσ => ?_)⟩
    have hx : E.hom.base x ∈ Set.range i_red.base := by
      rw [hRange]
      exact Set.mem_univ _
    exact hβ E σ x hσ hx
  · 
    intro W₁ W₂ W Y₁ Y₂ i₁ _ i₂ _ π₁ _ π₂ _ F F₁ F₂ u₁ u₂ hCov hTor hPb₁ hPb₂ hu₁ hu₂
    obtain ⟨β₁, hβ₁⟩ := hClosedImmLocalKer i₁ π₁ F F₁ u₁ hTor hPb₁ hu₁
    obtain ⟨β₂, hβ₂⟩ := hClosedImmLocalKer i₂ π₂ F F₂ u₂ hTor hPb₂ hu₂
    obtain ⟨e₁₂⟩ := hCoprodIso (π₁ ≫ i₁) (π₂ ≫ i₂)
    let u := Limits.biprod.lift β₁ β₂ ≫ e₁₂.hom
    refine ⟨u, hMonoOfLocalZero F _ u (fun E σ x hσ => ?_)⟩
    have hβ₁_eq : u ≫ (e₁₂.inv ≫ Limits.biprod.fst) = β₁ := by
      dsimp [u]
      rw [Category.assoc, ← Category.assoc e₁₂.hom, e₁₂.hom_inv_id, Category.id_comp,
        Limits.biprod.lift_fst]
    have hβ₂_eq : u ≫ (e₁₂.inv ≫ Limits.biprod.snd) = β₂ := by
      dsimp [u]
      rw [Category.assoc, ← Category.assoc e₁₂.hom, e₁₂.hom_inv_id, Category.id_comp,
        Limits.biprod.lift_snd]
    have hσ₁ : (β₁.hom.app (Opposite.op E)).hom σ = 0 := by
      rw [← hβ₁_eq]
      change ((e₁₂.inv ≫ Limits.biprod.fst).hom.app (Opposite.op E)).hom
        ((u.hom.app (Opposite.op E)).hom σ) = 0
      rw [hσ, map_zero]
    have hσ₂ : (β₂.hom.app (Opposite.op E)).hom σ = 0 := by
      rw [← hβ₂_eq]
      change ((e₁₂.inv ≫ Limits.biprod.snd).hom.app (Opposite.op E)).hom
        ((u.hom.app (Opposite.op E)).hom σ) = 0
      rw [hσ, map_zero]
    have hx_cov : E.hom.base x ∈ Set.range i₁.base ∪ Set.range i₂.base := by
      rw [hCov]
      exact Set.mem_univ _
    rcases hx_cov with hx₁ | hx₂
    · exact hβ₁ E σ x hσ₁ hx₁
    · exact hβ₂ E σ x hσ₂ hx₂
  · 
    intro W W' Y_U Y' U i' _ π_U _ π' _ F F' α_U u' hCov hTor hPb' hMonoU hu'
    obtain ⟨β', hβ'⟩ := hClosedImmLocalKer i' π' F F' u' hTor hPb' hu'
    obtain ⟨e_U'⟩ := hCoprodIso π_U (π' ≫ i')
    let u := Limits.biprod.lift α_U β' ≫ e_U'.hom
    refine ⟨u, hMonoOfLocalZero F _ u (fun E σ x hσ => ?_)⟩
    have hα_eq : u ≫ (e_U'.inv ≫ Limits.biprod.fst) = α_U := by
      dsimp [u]
      rw [Category.assoc, ← Category.assoc e_U'.hom, e_U'.hom_inv_id, Category.id_comp,
        Limits.biprod.lift_fst]
    have hβ'_eq : u ≫ (e_U'.inv ≫ Limits.biprod.snd) = β' := by
      dsimp [u]
      rw [Category.assoc, ← Category.assoc e_U'.hom, e_U'.hom_inv_id, Category.id_comp,
        Limits.biprod.lift_snd]
    have hσα : (α_U.hom.app (Opposite.op E)).hom σ = 0 := by
      rw [← hα_eq]
      change ((e_U'.inv ≫ Limits.biprod.fst).hom.app (Opposite.op E)).hom
        ((u.hom.app (Opposite.op E)).hom σ) = 0
      rw [hσ, map_zero]
    have hσβ : (β'.hom.app (Opposite.op E)).hom σ = 0 := by
      rw [← hβ'_eq]
      change ((e_U'.inv ≫ Limits.biprod.snd).hom.app (Opposite.op E)).hom
        ((u.hom.app (Opposite.op E)).hom σ) = 0
      rw [hσ, map_zero]
    have hx_cov : E.hom.base x ∈ (U : Set W) ∪ Set.range i'.base := by
      rw [hCov]
      exact Set.mem_univ _
    rcases hx_cov with hxU | hxi'
    · let O_U : E.left.Opens := (TopologicalSpace.Opens.map E.hom.base).obj U
      have hxO : x ∈ O_U := hxU
      let E_U : W.Etale := MorphismProperty.Over.mk ⊤ (O_U.ι ≫ (E.hom : E.left ⟶ W))
        (inferInstance : Etale (O_U.ι ≫ (E.hom : E.left ⟶ W)))
      let v_U : E_U ⟶ E := MorphismProperty.Over.homMk O_U.ι rfl trivial
      have hSubU : Set.range ((Scheme.Etale.forget W).obj E_U).hom.base ⊆ (U : Set W) := by
        rintro _ ⟨z, rfl⟩
        exact z.2
      have hMono_EU : Mono (α_U.hom.app (Opposite.op E_U)) := hMonoU E_U hSubU
      have hinj_EU := (AddCommGrpCat.mono_iff_injective (α_U.hom.app (Opposite.op E_U))).mp hMono_EU
      refine ⟨E_U, v_U, ⟨⟨x, hxO⟩, rfl⟩, ?_⟩
      apply hinj_EU
      have hnat := ConcreteCategory.congr_hom (α_U.hom.naturality v_U.op) σ
      change (α_U.hom.app (Opposite.op E_U)).hom ((F.obj.map v_U.op).hom σ) =
        ((weilEtaleHigherDirectImage π_U 0 (weilEtaleTorsionSheaf Y_U ℓ)).obj.map v_U.op).hom
          ((α_U.hom.app (Opposite.op E)).hom σ) at hnat
      rw [hσα, map_zero] at hnat
      rw [hnat, map_zero]
    · exact hβ' E σ x hσβ hxi'

theorem weil_etale_normal_open_extension_and_generic_etale_embed (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hUnibranch : ∀ (B C : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B]
      [IsNoetherianRing B] [CommRing C] [Algebra B C] [Algebra.Etale B C]
      (q : Ideal C) [q.IsPrime],
      ∃ f : C, f ∉ q ∧ IsDomain (Localization.Away f))
    (Z : AlgebraicGeometry.Scheme.{u})
    (F_Z : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
    (U₁ : Z.Opens)
    (V₁ : AlgebraicGeometry.Scheme.{u})
    (p₁ : V₁ ⟶ (U₁ : AlgebraicGeometry.Scheme.{u}))
    [AlgebraicGeometry.Etale p₁]
    [AlgebraicGeometry.Surjective p₁]
    (A₀ : AddCommGrpCat.{u})
    (Y_Z : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral Y_Z]
    (q_Z : Y_Z ⟶ Z)
    [AlgebraicGeometry.IsFinite q_Z]
    (V_bar : Y_Z.Opens)
    (s₁ : (V_bar : AlgebraicGeometry.Scheme.{u}) ⟶ V₁)
    [AlgebraicGeometry.Surjective s₁] :
    Finite A₀ →
    ℓ • CategoryTheory.CategoryStruct.id A₀ = 0 →
    WeilIsEtaleSheafPullback (p₁ ≫ U₁.ι) F_Z
      ((CategoryTheory.constantSheaf V₁.smallEtaleTopology AddCommGrpCat.{u}).obj A₀) →
    (∀ (W : Y_Z.Opens), AlgebraicGeometry.IsAffineOpen W → Nonempty W →
      IsDomain ↑(Y_Z.presheaf.obj (Opposite.op W)) ∧
      IsIntegrallyClosed ↑(Y_Z.presheaf.obj (Opposite.op W)) ∧
      IsNoetherianRing ↑(Y_Z.presheaf.obj (Opposite.op W))) →
    Nonempty V_bar →
    V_bar.ι ≫ q_Z = s₁ ≫ p₁ ≫ U₁.ι →
    ∃ (Y_U : AlgebraicGeometry.Scheme.{u})
      (π_U : Y_U ⟶ Z)
      (_ : AlgebraicGeometry.IsFinite π_U)
      (α_U : F_Z ⟶ weilEtaleHigherDirectImage π_U 0 (weilEtaleTorsionSheaf Y_U ℓ)),
      ∀ (E : Z.Etale),
        Set.range ((AlgebraicGeometry.Scheme.Etale.forget Z).obj E).hom.base ⊆ (U₁ : Set Z) →
        CategoryTheory.Mono (α_U.hom.app (Opposite.op E)) :=
by
  classical
  intro hFinA₀ hTorA₀ hPb_U₁ hNorm_YZ hVbar_ne hComm_YZ
  
  have hEtPostcomp : ∀ {X₁ X₂ X₃ : Scheme.{u}} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃)
      [Etale g] [Etale (f ≫ g)], Etale f ∧ True := by
    intro X₁ X₂ X₃ f g _ _
    let P := Limits.pullback (f ≫ g) g
    let fst : P ⟶ X₁ := Limits.pullback.fst (f ≫ g) g
    let snd : P ⟶ X₂ := Limits.pullback.snd (f ≫ g) g
    let γ : X₁ ⟶ P := Limits.pullback.lift (𝟙 X₁) f (by rw [Category.id_comp])
    have hγ_fst : γ ≫ fst = 𝟙 X₁ := Limits.pullback.lift_fst _ _ _
    have hγ_snd : γ ≫ snd = f := Limits.pullback.lift_snd _ _ _
    let δ : P ⟶ Limits.pullback fst fst := Limits.pullback.diagonal fst
    let σ : P ⟶ Limits.pullback fst fst :=
      Limits.pullback.lift (𝟙 P) (fst ≫ γ)
        (by rw [Category.id_comp, Category.assoc, hγ_fst, Category.comp_id])
    have hcomm : γ ≫ σ = γ ≫ δ := by
      dsimp [σ, δ]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id,
          Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc, hγ_fst, Category.id_comp,
          Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
    have hpb : IsPullback γ γ σ δ :=
      { w := hcomm
        isLimit' := ⟨Limits.PullbackCone.IsLimit.mk hcomm
          (fun s => s.fst ≫ fst)
          (fun s => by
            have h2 := congrArg (· ≫ Limits.pullback.snd fst fst) s.condition
            have h1 := congrArg (· ≫ Limits.pullback.fst fst fst) s.condition
            dsimp [σ, δ] at h1 h2
            simp only [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.diagonal_snd,
              Limits.pullback.lift_fst, Limits.pullback.diagonal_fst, Category.comp_id] at h1 h2
            exact h2.trans h1.symm)
          (fun s => by
            have h2 := congrArg (· ≫ Limits.pullback.snd fst fst) s.condition
            dsimp [σ, δ] at h2
            simp only [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.diagonal_snd,
              Category.comp_id] at h2
            exact h2)
          (fun s m hm _ => by
            rw [← hm, Category.assoc, hγ_fst, Category.comp_id])⟩ }
    have : IsOpenImmersion δ := inferInstance
    have : IsOpenImmersion γ :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip inferInstance
    refine ⟨?_, trivial⟩
    rw [← hγ_snd]
    infer_instance
  let P_et : MorphismProperty Scheme.{u} := @Etale
  let : P_et.IsStableUnderComposition :=
    { comp_mem := fun f' g' hf hg => by
        have : Etale f' := hf
        have : Etale g' := hg
        exact inferInstance }
  let : P_et.HasOfPostcompProperty P_et :=
    { of_postcomp := fun f' g' hg' hfg' => by
        have : Etale g' := hg'
        have : Etale (f' ≫ g') := hfg'
        exact (hEtPostcomp f' g').1 }
  let : ∀ {X₁ X₂ : Scheme.{u}} (h : X₁ ⟶ X₂), MorphismProperty.HasPullbacksAlong (@Etale) h :=
    fun _ => MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let : ∀ {X₁ X₂ : Scheme.{u}} (h : X₁ ⟶ X₂),
      MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) h :=
    fun _ => MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have hMemTop : ∀ (X : Scheme.{u}) {W : X.Etale} (R : Sieve W),
      R ∈ X.smallEtaleTopology W ↔
        ∀ w : ↥W.left, ∃ (Y : X.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ Etale f.left ∧ f.left.base y = w := by
    intro X W R
    have hTopX : X.smallEtaleTopology = (Scheme.smallPretopology P_et P_et).toGrothendieck :=
      Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology X le_rfl
    rw [hTopX]
    exact Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) W R
  
  have hSheafForget : ∀ {C : Type (u + 1)} [Category.{u, u + 1} C]
      (J : GrothendieckTopology C) (F : Sheaf J AddCommGrpCat.{u}),
      Presieve.IsSheaf J (F.obj ⋙ forget AddCommGrpCat.{u}) := by
    intro C _ J F
    let Z1 := AddCommGrpCat.free.obj PUnit.{u + 1}
    have h1 : Presieve.IsSheaf J (F.obj ⋙ coyoneda.obj (Opposite.op Z1)) := F.property Z1
    let equivObj : ∀ X, (Z1 ⟶ F.obj.obj X) ≃ (forget AddCommGrpCat.{u}).obj (F.obj.obj X) :=
      fun X => (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} (F.obj.obj X)).trans
        { toFun := fun φ => φ PUnit.unit
          invFun := fun x => TypeCat.ofHom (fun _ => x)
          left_inv := fun φ => by ext ⟨⟩; rfl
          right_inv := fun _ => rfl }
    let e : (F.obj ⋙ coyoneda.obj (Opposite.op Z1)) ≅ (F.obj ⋙ forget AddCommGrpCat.{u}) :=
      NatIso.ofComponents
        (fun X => (equivObj X).toIso)
        (fun {X Y} f => by
          ext φ
          dsimp [equivObj]
          have hnat := AddCommGrpCat.adj.homEquiv_naturality_right φ (F.obj.map f)
          exact ConcreteCategory.congr_hom hnat PUnit.unit)
    exact Presieve.isSheaf_iso J e h1
  
  have hCont : ∀ {X₁ X₂ : Scheme.{u}} (h : X₁ ⟶ X₂),
      let B_h : X₂.Etale ⥤ X₁.Etale := MorphismProperty.Over.pullback (@Etale) ⊤ h
      B_h.IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology := by
    intro X₁ X₂ h B_h
    let Fgt₁ := Scheme.Etale.forget X₁
    let Fgt₂ := Scheme.Etale.forget X₂
    have hEqFgt : B_h ⋙ Fgt₁ = Fgt₂ ⋙ Over.pullback h := rfl
    have : Limits.PreservesLimitsOfSize.{0, 0} (Over.pullback h) :=
      (Over.mapPullbackAdj h).rightAdjoint_preservesLimits
    have : Limits.PreservesFiniteLimits (Over.pullback h) :=
      Limits.PreservesLimitsOfSize.preservesFiniteLimits _
    have : Limits.PreservesFiniteLimits (Fgt₂ ⋙ Over.pullback h) :=
      Limits.comp_preservesFiniteLimits Fgt₂ (Over.pullback h)
    have : Limits.PreservesFiniteLimits (B_h ⋙ Fgt₁) := by rw [hEqFgt]; infer_instance
    have : Limits.PreservesFiniteLimits B_h :=
      Limits.preservesFiniteLimits_of_reflects_of_preserves B_h Fgt₁
    have : RepresentablyFlat B_h := flat_of_preservesFiniteLimits B_h
    have hCompat : CompatiblePreserving X₁.smallEtaleTopology B_h :=
      compatiblePreservingOfFlat X₁.smallEtaleTopology B_h
    have hCov : CoverPreserving X₂.smallEtaleTopology X₁.smallEtaleTopology B_h := by
      refine ⟨fun {U R} hR => ?_⟩
      have hR_pts := (hMemTop X₂ R).mp hR
      refine (hMemTop X₁ _).mpr (fun z => ?_)
      obtain ⟨V, u, v, huR, huEt, hv⟩ := hR_pts ((Limits.pullback.fst U.hom h).base z)
      have h_map_fst : (B_h.map u).left ≫ Limits.pullback.fst U.hom h =
          Limits.pullback.fst V.hom h ≫ u.left :=
        Limits.pullback.lift_fst _ _ _
      have h_map_snd : (B_h.map u).left ≫ Limits.pullback.snd U.hom h =
          Limits.pullback.snd V.hom h :=
        Limits.pullback.lift_snd _ _ _
      have h_pb_right : IsPullback (Limits.pullback.snd U.hom h)
          (Limits.pullback.fst U.hom h) h U.hom :=
        (IsPullback.of_hasPullback U.hom h).flip
      have h_pb_outer : IsPullback ((B_h.map u).left ≫ Limits.pullback.snd U.hom h)
          (Limits.pullback.fst V.hom h) h (u.left ≫ U.hom) := by
        rw [h_map_snd, MorphismProperty.Over.w u]
        exact (IsPullback.of_hasPullback V.hom h).flip
      have h_pb_left : IsPullback (Limits.pullback.fst V.hom h) (B_h.map u).left
          u.left (Limits.pullback.fst U.hom h) :=
        (IsPullback.of_right h_pb_outer h_map_fst h_pb_right).flip
      have hBu_et : Etale (B_h.map u).left :=
        MorphismProperty.IsStableUnderBaseChange.of_isPullback h_pb_left huEt
      obtain ⟨w₀, _, hw₀_snd⟩ := Scheme.Pullback.exists_preimage_pullback v z hv
      let e_pb := h_pb_left.isoPullback
      have he_snd : e_pb.inv ≫ (B_h.map u).left =
          Limits.pullback.snd u.left (Limits.pullback.fst U.hom h) :=
        h_pb_left.isoPullback_inv_snd
      refine ⟨B_h.obj V, B_h.map u, e_pb.inv.base w₀, ?_, hBu_et, ?_⟩
      · exact ⟨V, u, 𝟙 (B_h.obj V), huR, (Category.id_comp _).symm⟩
      · exact (congrArg (fun φ : _ ⟶ (B_h.obj U).left => φ.base w₀) he_snd).trans hw₀_snd
    exact Functor.isContinuous_of_coverPreserving hCompat hCov
  
  let g : V₁ ⟶ Z := p₁ ≫ U₁.ι
  have : Etale g := inferInstance
  let B_g : Z.Etale ⥤ V₁.Etale := MorphismProperty.Over.pullback (@Etale) ⊤ g
  let : B_g.IsContinuous Z.smallEtaleTopology V₁.smallEtaleTopology := hCont g
  let C_V₁_A₀ := (constantSheaf V₁.smallEtaleTopology AddCommGrpCat.{u}).obj A₀
  have hStep2 : ∃ (γ_g : F_Z ⟶
      (B_g.sheafPushforwardContinuous AddCommGrpCat.{u}
        Z.smallEtaleTopology V₁.smallEtaleTopology).obj C_V₁_A₀),
      ∀ (E : Z.Etale),
        Set.range ((Scheme.Etale.forget Z).obj E).hom.base ⊆ (U₁ : Set Z) →
        Function.Injective (γ_g.hom.app (Opposite.op E)).hom := by
    obtain ⟨hc_g', hr_g, ⟨e_pb⟩⟩ := hPb_U₁
    have h_hc_eq : hc_g' = hCont g := Subsingleton.elim _ _
    subst h_hc_eq
    let pf_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u}
      Z.smallEtaleTopology V₁.smallEtaleTopology
    let pb_g := B_g.sheafPullback AddCommGrpCat.{u} Z.smallEtaleTopology V₁.smallEtaleTopology
    let adj_g := B_g.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Z.smallEtaleTopology V₁.smallEtaleTopology
    let γ_g : F_Z ⟶ pf_g.obj C_V₁_A₀ := adj_g.unit.app F_Z ≫ pf_g.map e_pb.hom
    let L_g : V₁.Etale ⥤ Z.Etale :=
      MorphismProperty.Over.map (P := P_et) ⊤ (f := g) (inferInstance : Etale g)
    have hCompat_L : CompatiblePreserving Z.smallEtaleTopology L_g := by
      refine ⟨fun {ℱ W T x} hx {Y₁ Y₂ X} f₁ f₂ {g₁ g₂} hg₁ hg₂ hEq => ?_⟩
      have hf₁_w : f₁.left ≫ (L_g.obj Y₁).hom = X.hom := MorphismProperty.Over.w f₁
