                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv) a))) ∧
        γ Polynomial.X = (CommRingCat.Hom.hom (p₂.app D)) s := by
    intro P p_P D α s hα_base hs_X
    dsimp only
    let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
    let X_A := CategoryTheory.Limits.pullback s_A p_P
    let p₁ := CategoryTheory.Limits.pullback.fst s_A p_P
    let p₂ := CategoryTheory.Limits.pullback.snd s_A p_P
    let W : X_A.Opens := (TopologicalSpace.Opens.map p₂.base).obj D
    let inl_P : CommRingCat.of A ⟶ CommRingCat.of (Polynomial A) :=
      CommRingCat.ofHom Polynomial.C
    let inr_P : CommRingCat.of (Polynomial k) ⟶ CommRingCat.of (Polynomial A) :=
      CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap k A))
    have hcomm_P : CommRingCat.ofHom (algebraMap k A) ≫ inl_P =
        CommRingCat.ofHom (algebraMap k (Polynomial k)) ≫ inr_P := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      change Polynomial.C (algebraMap k A c) = (Polynomial.C c).map (algebraMap k A)
