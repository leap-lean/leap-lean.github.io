        ⟨fun a b hab => by
          have := congrArg (· * ((u⁻¹ : Units T) : T)) hab
          simpa only [mul_assoc, Units.mul_inv, mul_one] using this,
         fun b => ⟨b * ((u⁻¹ : Units T) : T), by simp [mul_assoc]⟩⟩
      have h1 : Function.Bijective (e ∘ LinearMap.lTensor T α ∘ rid_inv) := by
        rwa [hcomp_eq]
      have h2 : Function.Bijective (LinearMap.lTensor T α ∘ rid_inv) :=
        (Function.Bijective.of_comp_iff' e.bijective _).mp h1
      exact (Function.Bijective.of_comp_iff _ rid_inv.bijective).mp h2
    let e_α : R ≃ₗ[R] L := LinearEquiv.ofBijective α hBij
    refine ⟨e_α.symm, ?_, ?_⟩
    · have h1 : e_α 1 = s := by change (1 : R) • s = s; exact one_smul R s
      simpa [← h1] using e_α.symm_apply_apply (1 : R)
    · intro x
