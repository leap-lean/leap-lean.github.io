        ∃ (b : ULift.{u} Bool) (g : T ⟶ pairEt b), g ≫ pairIn b = f := by
      intro T f ⟨_, g, _, hR, hgf⟩
      rcases hR with ⟨b⟩
      exact ⟨b, g, hgf⟩
    let fam_B : CategoryTheory.Presieve.FamilyOfElements P_B
        (S_W : CategoryTheory.Presieve (weilEtaleCechObj w 0)) :=
      fun T f hf => P_B.map (Classical.choose (Classical.choose_spec (hFactor_B hf))).op
        (b_sec (Classical.choose (hFactor_B hf)))
    have hfam_B_eval : ∀ {T : Z.Etale} (b : ULift.{u} Bool) (g : T ⟶ pairEt b)
        (hf : S_W.arrows (g ≫ pairIn b)),
        fam_B (g ≫ pairIn b) hf = P_B.map g.op (b_sec b) := by
      intro T b g hf
      dsimp only [fam_B]
      exact hOverlap_B _ b _ g (Classical.choose_spec (Classical.choose_spec (hFactor_B hf)))
    have hfam_B_compat : fam_B.Compatible := by
      intro Y₁ Y₂ Z' g₁' g₂' f₁ f₂ hf₁ hf₂ hcomm
      obtain ⟨b₁, u₁, rfl⟩ := hFactor_B hf₁
      obtain ⟨b₂, u₂, rfl⟩ := hFactor_B hf₂
      rw [hfam_B_eval b₁ u₁ hf₁, hfam_B_eval b₂ u₂ hf₂]
      change (P_B.map u₁.op ≫ P_B.map g₁'.op) (b_sec b₁) =
        (P_B.map u₂.op ≫ P_B.map g₂'.op) (b_sec b₂)
      rw [← P_B.map_comp, ← P_B.map_comp, ← CategoryTheory.op_comp, ← CategoryTheory.op_comp]
      refine hOverlap_B b₁ b₂ (g₁' ≫ u₁) (g₂' ≫ u₂) ?_
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      exact hcomm
    have hSh_B := hIsSheafType Z B_sh S_W hSW
    let s_B : B_sh.obj.obj (Opposite.op (weilEtaleCechObj w 0)) :=
      hSh_B.amalgamate fam_B hfam_B_compat
    have hs_B_res : ∀ b : ULift.{u} Bool, B_sh.obj.map (pairIn b).op s_B = b_sec b := by
      intro b
      have hmem_b : S_W.arrows (pairIn b) :=
        ⟨pairEt b, 𝟙 (pairEt b), pairIn b,
          CategoryTheory.Presieve.ofArrows.mk b, CategoryTheory.Category.id_comp _⟩
      have hglue : P_B.map (pairIn b).op s_B = fam_B (pairIn b) hmem_b :=
        hSh_B.valid_glue hfam_B_compat (pairIn b) hmem_b
      have hmem_id : S_W.arrows (𝟙 (pairEt b) ≫ pairIn b) := by
        rwa [CategoryTheory.Category.id_comp]
      have hev := hfam_B_eval b (𝟙 (pairEt b)) hmem_id
      simp only [CategoryTheory.op_id, P_B.map_id] at hev
      exact hglue.trans hev
    let ρ : Z_sh Z (weilEtaleCechObj w 0) ⟶ B_sh :=
      shHom Z (weilEtaleCechObj w 0) B_sh s_B
    have hρ_inl : Z_sh_map inl_W ≫ ρ = CategoryTheory.Limits.biprod.inl := by
      dsimp only [ρ]
      rw [map_comp_shHom, show B_sh.obj.map inl_W.op s_B = b_sec ⟨false⟩ from hs_B_res ⟨false⟩]
      exact shHom_secOf Z (weilEtaleCechObj u₀_cov 0) B_sh CategoryTheory.Limits.biprod.inl
    have hρ_inr : Z_sh_map inr_W ≫ ρ = CategoryTheory.Limits.biprod.inr := by
      dsimp only [ρ]
      rw [map_comp_shHom, show B_sh.obj.map inr_W.op s_B = b_sec ⟨true⟩ from hs_B_res ⟨true⟩]
      exact shHom_secOf Z (weilEtaleCechObj u₁_cov 0) B_sh CategoryTheory.Limits.biprod.inr
    let δ : B_sh ⟶ Z_sh Z (weilEtaleCechObj w 0) :=
      CategoryTheory.Limits.biprod.desc (Z_sh_map inl_W) (Z_sh_map inr_W)
    have hρ_δ : ρ ≫ δ = 𝟙 (Z_sh Z (weilEtaleCechObj w 0)) := by
      apply secOf_inj
      have hSh_ZW := hIsSheafType Z (Z_sh Z (weilEtaleCechObj w 0)) S_W hSW
      refine hSh_ZW.isSeparatedFor.ext (fun T f hf => ?_)
      obtain ⟨b, g, rfl⟩ := hFactor_B hf
      change (Z_sh Z (weilEtaleCechObj w 0)).obj.map (g ≫ pairIn b).op
          (secOf Z (weilEtaleCechObj w 0) (Z_sh Z (weilEtaleCechObj w 0)) (ρ ≫ δ)) =
        (Z_sh Z (weilEtaleCechObj w 0)).obj.map (g ≫ pairIn b).op
          (secOf Z (weilEtaleCechObj w 0) (Z_sh Z (weilEtaleCechObj w 0))
            (𝟙 (Z_sh Z (weilEtaleCechObj w 0))))
      rw [CategoryTheory.op_comp, (Z_sh Z (weilEtaleCechObj w 0)).obj.map_comp]
      change (Z_sh Z (weilEtaleCechObj w 0)).obj.map g.op
          ((Z_sh Z (weilEtaleCechObj w 0)).obj.map (pairIn b).op
            (secOf Z (weilEtaleCechObj w 0) (Z_sh Z (weilEtaleCechObj w 0)) (ρ ≫ δ))) =
        (Z_sh Z (weilEtaleCechObj w 0)).obj.map g.op
          ((Z_sh Z (weilEtaleCechObj w 0)).obj.map (pairIn b).op
            (secOf Z (weilEtaleCechObj w 0) (Z_sh Z (weilEtaleCechObj w 0))
              (𝟙 (Z_sh Z (weilEtaleCechObj w 0)))))
      rw [← secOf_map_comp (pairIn b), ← secOf_map_comp (pairIn b),
        CategoryTheory.Category.comp_id]
      congr 1
      apply congrArg (secOf Z (pairEt b) (Z_sh Z (weilEtaleCechObj w 0)))
      rcases b with ⟨_ | _⟩
      · dsimp only [pairIn]
        rw [← CategoryTheory.Category.assoc, hρ_inl,
          CategoryTheory.Limits.biprod.inl_desc]
      · dsimp only [pairIn]
        rw [← CategoryTheory.Category.assoc, hρ_inr,
          CategoryTheory.Limits.biprod.inr_desc]
    have hε_split : ε_rep Z w =
        (ρ ≫ CategoryTheory.Limits.biprod.fst) ≫ ε_rep Z u₀_cov +
        (ρ ≫ CategoryTheory.Limits.biprod.snd) ≫ ε_rep Z u₁_cov := by
      have hid_B : 𝟙 B_sh =
          CategoryTheory.Limits.biprod.fst ≫ CategoryTheory.Limits.biprod.inl +
          CategoryTheory.Limits.biprod.snd ≫ CategoryTheory.Limits.biprod.inr :=
        CategoryTheory.Limits.biprod.total.symm
      have hinl_w : inl_W ≫ weilEtaleCechHom w 0 = weilEtaleCechHom u₀_cov 0 :=
        (hT_Z Z).hom_ext _ _
      have hinr_w : inr_W ≫ weilEtaleCechHom w 0 = weilEtaleCechHom u₁_cov 0 :=
        (hT_Z Z).hom_ext _ _
      have hδ_inl : CategoryTheory.Limits.biprod.inl ≫ δ ≫ ε_rep Z w = ε_rep Z u₀_cov := by
        dsimp only [δ, ε_rep]
        rw [← CategoryTheory.Category.assoc CategoryTheory.Limits.biprod.inl,
          CategoryTheory.Limits.biprod.inl_desc,
          ← CategoryTheory.Category.assoc, ← Z_sh_map_comp, hinl_w]
      have hδ_inr : CategoryTheory.Limits.biprod.inr ≫ δ ≫ ε_rep Z w = ε_rep Z u₁_cov := by
        dsimp only [δ, ε_rep]
        rw [← CategoryTheory.Category.assoc CategoryTheory.Limits.biprod.inr,
          CategoryTheory.Limits.biprod.inr_desc,
          ← CategoryTheory.Category.assoc, ← Z_sh_map_comp, hinr_w]
      calc
        ε_rep Z w = 𝟙 (Z_sh Z (weilEtaleCechObj w 0)) ≫ ε_rep Z w :=
          (CategoryTheory.Category.id_comp _).symm
        _ = (ρ ≫ 𝟙 B_sh ≫ δ) ≫ ε_rep Z w := by rw [CategoryTheory.Category.id_comp δ, hρ_δ]
        _ = ρ ≫ (CategoryTheory.Limits.biprod.fst ≫ CategoryTheory.Limits.biprod.inl +
              CategoryTheory.Limits.biprod.snd ≫ CategoryTheory.Limits.biprod.inr) ≫
              (δ ≫ ε_rep Z w) := by
            rw [hid_B]
            simp only [CategoryTheory.Category.assoc]
        _ = (ρ ≫ CategoryTheory.Limits.biprod.fst) ≫
              (CategoryTheory.Limits.biprod.inl ≫ δ ≫ ε_rep Z w) +
            (ρ ≫ CategoryTheory.Limits.biprod.snd) ≫
              (CategoryTheory.Limits.biprod.inr ≫ δ ≫ ε_rep Z w) := by
            rw [CategoryTheory.Preadditive.add_comp, CategoryTheory.Preadditive.comp_add]
            simp only [CategoryTheory.Category.assoc]
        _ = (ρ ≫ CategoryTheory.Limits.biprod.fst) ≫ ε_rep Z u₀_cov +
            (ρ ≫ CategoryTheory.Limits.biprod.snd) ≫ ε_rep Z u₁_cov := by
            rw [hδ_inl, hδ_inr]
    have hKill₀' : (CategoryTheory.Abelian.Ext.mk₀ (ε_rep Z u₀_cov)).comp ξ (Nat.zero_add 1) = 0 :=
      hKill₀
    have hKill₁' : (CategoryTheory.Abelian.Ext.mk₀ (ε_rep Z u₁_cov)).comp ξ (Nat.zero_add 1) = 0 :=
      hKill₁
    have hKill_W : (CategoryTheory.Abelian.Ext.mk₀ (ε_rep Z w)).comp ξ (Nat.zero_add 1) = 0 := by
      rw [hε_split, CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.add_comp,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (ρ ≫ CategoryTheory.Limits.biprod.fst))
          (CategoryTheory.Abelian.Ext.mk₀ (ε_rep Z u₀_cov)) ξ
          (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
        hKill₀', CategoryTheory.Abelian.Ext.comp_zero, zero_add,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (ρ ≫ CategoryTheory.Limits.biprod.snd))
          (CategoryTheory.Abelian.Ext.mk₀ (ε_rep Z u₁_cov)) ξ
          (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
        hKill₁', CategoryTheory.Abelian.Ext.comp_zero]
    obtain ⟨c, hc⟩ := hLift_cech Z W w hw ξ hKill_W
    exact ⟨hw, c, hc⟩

theorem weil_twoChart_bundle_zariski_trivialization_and_cocycle_calculus : (∀ {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B),
      (∀ (R L : Type u) [CommRing R] [AddCommGroup L] [Module R L] [Module.Invertible R L],
        ∃ (n : ℕ) (f : Fin n → R)
          (_ : ∀ a : Fin n,
            TensorProduct R (Localization.Away (f a)) L ≃ₗ[Localization.Away (f a)]
              Localization.Away (f a)),
          Finset.univ.sum f = 1) →
      ∀ E : WeilTwoChartLineBundle D,
        ∃ (T₀ T₁ : Type u) (_ : CommRing T₀) (_ : CommRing T₁)
          (_ : Algebra D.R₀ T₀) (_ : Algebra D.R₁ T₁)
          (_ : Algebra.Etale D.R₀ T₀) (_ : Algebra.Etale D.R₁ T₁)
          (_ : TensorProduct D.R₀ T₀ E.L₀ ≃ₗ[T₀] T₀)
          (_ : TensorProduct D.R₁ T₁ E.L₁ ≃ₗ[T₁] T₁),
          AlgebraicGeometry.Surjective
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀))) ∧
          AlgebraicGeometry.Surjective
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁)))) ∧
    (∀ {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
        (T₀ T₁ : Type u) [CommRing T₀] [CommRing T₁] [Algebra D.R₀ T₀] [Algebra D.R₁ T₁],
      (∀ (E : WeilTwoChartLineBundle D)
          (e₀ : TensorProduct D.R₀ T₀ E.L₀ ≃ₗ[T₀] T₀)
          (e₁ : TensorProduct D.R₁ T₁ E.L₁ ≃ₗ[T₁] T₁),
        ∃ q : WeilTwoChartUnitQuad D T₀ T₁,
          WeilIsTwoChartBundleCocycle D E T₀ T₁ e₀ e₁ q ∧
          WeilIsTwoChartAlgCocycle D q) ∧
      (∃ (e₀_triv : TensorProduct D.R₀ T₀ (WeilTwoChartTrivial D).L₀ ≃ₗ[T₀] T₀)
          (e₁_triv : TensorProduct D.R₁ T₁ (WeilTwoChartTrivial D).L₁ ≃ₗ[T₁] T₁),
        WeilIsTwoChartBundleCocycle D (WeilTwoChartTrivial D) T₀ T₁ e₀_triv e₁_triv
          (weilTwoChartQuadOne D T₀ T₁)) ∧
      (∀ (E : WeilTwoChartLineBundle D)
          (e₀ : TensorProduct D.R₀ T₀ E.L₀ ≃ₗ[T₀] T₀)
          (e₁ : TensorProduct D.R₁ T₁ E.L₁ ≃ₗ[T₁] T₁)
          (q : WeilTwoChartUnitQuad D T₀ T₁),
        WeilIsTwoChartBundleCocycle D E T₀ T₁ e₀ e₁ q →
        ∀ n : ℕ,
          ∃ (e₀_pow : TensorProduct D.R₀ T₀ (WeilTwoChartPow D E n).L₀ ≃ₗ[T₀] T₀)
            (e₁_pow : TensorProduct D.R₁ T₁ (WeilTwoChartPow D E n).L₁ ≃ₗ[T₁] T₁),
            WeilIsTwoChartBundleCocycle D (WeilTwoChartPow D E n) T₀ T₁ e₀_pow e₁_pow
              (weilTwoChartQuadPow q n))) ∧
    (∀ {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
        (E F : WeilTwoChartLineBundle D)
        (T₀ T₁ : Type u) [CommRing T₀] [CommRing T₁] [Algebra D.R₀ T₀] [Algebra D.R₁ T₁]
        (e₀ : TensorProduct D.R₀ T₀ E.L₀ ≃ₗ[T₀] T₀)
        (e₁ : TensorProduct D.R₁ T₁ E.L₁ ≃ₗ[T₁] T₁)
        (f₀ : TensorProduct D.R₀ T₀ F.L₀ ≃ₗ[T₀] T₀)
        (f₁ : TensorProduct D.R₁ T₁ F.L₁ ≃ₗ[T₁] T₁)
        (q_E q_F : WeilTwoChartUnitQuad D T₀ T₁),
      WeilIsTwoChartBundleCocycle D E T₀ T₁ e₀ e₁ q_E →
      WeilIsTwoChartBundleCocycle D F T₀ T₁ f₀ f₁ q_F →
      WeilTwoChartIso D E F →
      ∃ (u₀ : Units T₀) (u₁ : Units T₁),
        q_F = weilTwoChartQuadMul q_E (weilTwoChartCoboundary D u₀ u₁)) ∧
    ((∀ {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
          (E : WeilTwoChartLineBundle D)
          (T₀ T₁ T₀' T₁' : Type u) [CommRing T₀] [CommRing T₁] [CommRing T₀'] [CommRing T₁']
          [Algebra D.R₀ T₀] [Algebra D.R₁ T₁] [Algebra D.R₀ T₀'] [Algebra D.R₁ T₁']
          (e₀ : TensorProduct D.R₀ T₀ E.L₀ ≃ₗ[T₀] T₀)
          (e₁ : TensorProduct D.R₁ T₁ E.L₁ ≃ₗ[T₁] T₁)
          (q : WeilTwoChartUnitQuad D T₀ T₁)
          (ψ₀ : T₀ →ₐ[D.R₀] T₀') (ψ₁ : T₁ →ₐ[D.R₁] T₁'),
        WeilIsTwoChartBundleCocycle D E T₀ T₁ e₀ e₁ q →
        ∃ (e₀' : TensorProduct D.R₀ T₀' E.L₀ ≃ₗ[T₀'] T₀')
          (e₁' : TensorProduct D.R₁ T₁' E.L₁ ≃ₗ[T₁'] T₁'),
          WeilIsTwoChartBundleCocycle D E T₀' T₁' e₀' e₁' (weilTwoChartQuadPull D ψ₀ ψ₁ q)) ∧
      (∀ {k A : Type u} [Field k] [CommRing A]
          {D : WeilTwoChartRingDatum A} {D₀ : WeilTwoChartRingDatum k}
          (red : WeilTwoChartCurveReduction D D₀)
          (E : WeilTwoChartLineBundle D)
          (T₀ T₁ : Type u) [CommRing T₀] [CommRing T₁] [Algebra D.R₀ T₀] [Algebra D.R₁ T₁]
          (e₀ : TensorProduct D.R₀ T₀ E.L₀ ≃ₗ[T₀] T₀)
          (e₁ : TensorProduct D.R₁ T₁ E.L₁ ≃ₗ[T₁] T₁)
          (q : WeilTwoChartUnitQuad D T₀ T₁),
        letI : Algebra D.R₀ D₀.R₀ := red.algR₀
        letI : Algebra D.R₁ D₀.R₁ := red.algR₁
        let T₀_bar := TensorProduct D.R₀ D₀.R₀ T₀
        let T₁_bar := TensorProduct D.R₁ D₀.R₁ T₁
        AlgebraicGeometry.Surjective
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀))) →
        AlgebraicGeometry.Surjective
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁))) →
        WeilIsTwoChartBundleCocycle D E T₀ T₁ e₀ e₁ q →
        AlgebraicGeometry.Surjective
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀.R₀ T₀_bar))) ∧
        AlgebraicGeometry.Surjective
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀.R₁ T₁_bar))) ∧
        ∃ (e₀_bar : TensorProduct D₀.R₀ T₀_bar (WeilTwoChartBaseChange red E).L₀ ≃ₗ[T₀_bar] T₀_bar)
          (e₁_bar : TensorProduct D₀.R₁ T₁_bar (WeilTwoChartBaseChange red E).L₁ ≃ₗ[T₁_bar] T₁_bar),
          WeilIsTwoChartBundleCocycle D₀ (WeilTwoChartBaseChange red E) T₀_bar T₁_bar
            e₀_bar e₁_bar (weilTwoChartQuadBaseChange red q))) :=
by
  
  
  
  let unitOfLinearEquiv : ∀ {S : Type u} [CommRing S], (S ≃ₗ[S] S) → Units S :=
    fun {S} _ Φ =>
      { val := Φ 1
        inv := Φ.symm 1
        val_inv := by
          calc Φ 1 * Φ.symm 1 = Φ.symm 1 • Φ 1 := by rw [smul_eq_mul, mul_comm]
            _ = Φ (Φ.symm 1 • (1 : S)) := (Φ.map_smul (Φ.symm 1) 1).symm
            _ = 1 := by rw [smul_eq_mul, mul_one, Φ.apply_symm_apply]
        inv_val := by
          calc Φ.symm 1 * Φ 1 = Φ.symm 1 • Φ 1 := by rw [smul_eq_mul]
            _ = Φ (Φ.symm 1 • (1 : S)) := (Φ.map_smul (Φ.symm 1) 1).symm
            _ = 1 := by rw [smul_eq_mul, mul_one, Φ.apply_symm_apply] }
  have unitOfLinearEquiv_apply : ∀ {S : Type u} [CommRing S] (Φ : S ≃ₗ[S] S) (s : S),
      Φ s = (unitOfLinearEquiv Φ : S) * s := by
    intro S _ Φ s
    calc Φ s = Φ (s • (1 : S)) := by rw [smul_eq_mul, mul_one]
      _ = s * Φ 1 := by rw [Φ.map_smul, smul_eq_mul]
      _ = (unitOfLinearEquiv Φ : S) * s := mul_comm s (Φ 1)
  have unitOfTwoTriv_apply : ∀ {S M : Type u} [CommRing S] [AddCommGroup M] [Module S M]
      (α β : M ≃ₗ[S] S) (m : M),
      β m = (unitOfLinearEquiv (α.symm.trans β) : S) * α m := by
    intro S M _ _ _ α β m
    have hm : β m = (α.symm.trans β) (α m) := by simp
    rw [hm, unitOfLinearEquiv_apply]

  let pullTriv : ∀ {R T S L : Type u} [CommRing R] [CommRing T] [CommRing S]
      [Algebra R T] [Algebra R S] [AddCommGroup L] [Module R L]
      (φ : T →ₐ[R] S), (TensorProduct R T L ≃ₗ[T] T) → (TensorProduct R S L ≃ₗ[S] S) :=
    fun {R T S L} _ _ _ _ _ _ _ φ e =>
      let B_map : S →ₗ[S] (L →ₗ[R] S) :=
        { toFun := fun s =>
            { toFun := fun x => s * φ (e ((1 : T) ⊗ₜ[R] x))
              map_add' := fun x y => by
                rw [TensorProduct.tmul_add, map_add, map_add, mul_add]
              map_smul' := fun r x => by
                have hr : (1 : T) ⊗ₜ[R] (r • x) = (algebraMap R T r) • ((1 : T) ⊗ₜ[R] x) := by
                  rw [TensorProduct.tmul_smul, ← IsScalarTower.algebraMap_smul T r]
                simp only [RingHom.id_apply, Algebra.smul_def]
                rw [hr, e.map_smul, smul_eq_mul, map_mul, φ.commutes, mul_left_comm] }
          map_add' := fun s₁ s₂ => by
            apply LinearMap.ext; intro x; exact add_mul s₁ s₂ _
          map_smul' := fun s₁ s₂ => by
            apply LinearMap.ext; intro x; exact mul_assoc s₁ s₂ _ }
      let F : TensorProduct R S L →ₗ[S] S := TensorProduct.AlgebraTensorModule.lift B_map
      let ω : TensorProduct R S L := LinearMap.rTensor L φ.toLinearMap (e.symm 1)
      let G : S →ₗ[S] TensorProduct R S L := LinearMap.toSpanSingleton S (TensorProduct R S L) ω
      have hF_rTensor : ∀ z : TensorProduct R T L,
          F (LinearMap.rTensor L φ.toLinearMap z) = φ (e z) := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul t x =>
          have ht : t ⊗ₜ[R] x = t • ((1 : T) ⊗ₜ[R] x) := by
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          change φ t * φ (e ((1 : T) ⊗ₜ[R] x)) = φ (e (t ⊗ₜ[R] x))
          rw [ht, e.map_smul, smul_eq_mul, map_mul]
        | add z₁ z₂ ih₁ ih₂ => rw [map_add, map_add, map_add, map_add, ih₁, ih₂]
      have hFG : F.comp G = LinearMap.id := by
        apply LinearMap.ext
        intro s
        change F (s • ω) = s
        rw [F.map_smul, smul_eq_mul, hF_rTensor (e.symm 1), e.apply_symm_apply, map_one, mul_one]
      have hrTensor_smul : ∀ (c : T) (z : TensorProduct R T L),
          LinearMap.rTensor L φ.toLinearMap (c • z) =
            (φ c) • LinearMap.rTensor L φ.toLinearMap z := by
        intro c z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul t x =>
          rw [TensorProduct.smul_tmul', smul_eq_mul, LinearMap.rTensor_tmul,
            LinearMap.rTensor_tmul, TensorProduct.smul_tmul']
          change φ (c * t) ⊗ₜ[R] x = (φ c * φ t) ⊗ₜ[R] x
          rw [map_mul]
        | add z₁ z₂ ih₁ ih₂ => rw [smul_add, map_add, map_add, smul_add, ih₁, ih₂]
      have hGF : G.comp F = LinearMap.id := by
        have hGF_one : ∀ x : L, G (F ((1 : S) ⊗ₜ[R] x)) = (1 : S) ⊗ₜ[R] x := by
          intro x
          have hF1 : F ((1 : S) ⊗ₜ[R] x) = φ (e ((1 : T) ⊗ₜ[R] x)) := one_mul _
          change F ((1 : S) ⊗ₜ[R] x) • ω = (1 : S) ⊗ₜ[R] x
          rw [hF1]
          dsimp [ω]
          rw [← hrTensor_smul, ← e.symm.map_smul, smul_eq_mul, mul_one,
            e.symm_apply_apply, LinearMap.rTensor_tmul]
          change φ 1 ⊗ₜ[R] x = (1 : S) ⊗ₜ[R] x
          rw [map_one]
        apply LinearMap.ext
        intro w
        change G (F w) = w
        induction w using TensorProduct.induction_on with
        | zero => simp
        | tmul s x =>
          have hs : s ⊗ₜ[R] x = s • ((1 : S) ⊗ₜ[R] x) := by
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [hs, F.map_smul, G.map_smul, hGF_one x]
        | add w₁ w₂ ih₁ ih₂ => rw [map_add, map_add, ih₁, ih₂]
      LinearEquiv.ofLinear F G hFG hGF
  have pullTriv_one_tmul : ∀ {R T S L : Type u} [CommRing R] [CommRing T] [CommRing S]
      [Algebra R T] [Algebra R S] [AddCommGroup L] [Module R L]
      (φ : T →ₐ[R] S) (e : TensorProduct R T L ≃ₗ[T] T) (x : L),
      pullTriv φ e ((1 : S) ⊗ₜ[R] x) = φ (e ((1 : T) ⊗ₜ[R] x)) := by
    intro R T S L _ _ _ _ _ _ _ φ e x
    change (1 : S) * φ (e ((1 : T) ⊗ₜ[R] x)) = φ (e ((1 : T) ⊗ₜ[R] x))
    exact one_mul _

  have cancel_of_mul_sigma : ∀ {R T S L : Type u} [CommRing R] [CommRing T] [CommRing S]
      [Algebra R T] [AddCommGroup L] [Module R L]
      (e : TensorProduct R T L ≃ₗ[T] T) (φ : T →+* S) {a b : S},
      (∀ x : L, a * φ (e ((1 : T) ⊗ₜ[R] x)) = b * φ (e ((1 : T) ⊗ₜ[R] x))) → a = b := by
    intro R T S L _ _ _ _ _ _ e φ a b h
    have hz : ∀ z : TensorProduct R T L, a * φ (e z) = b * φ (e z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul t x =>
        have ht : t ⊗ₜ[R] x = t • ((1 : T) ⊗ₜ[R] x) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [ht, e.map_smul, smul_eq_mul, map_mul,
          mul_left_comm a (φ t), h x, mul_left_comm b (φ t)]
      | add z₁ z₂ ih₁ ih₂ =>
        rw [map_add, map_add, mul_add, mul_add, ih₁, ih₂]
    have h1 := hz (e.symm 1)
    rwa [e.apply_symm_apply, map_one, mul_one, mul_one] at h1

  let baseChangeTriv : ∀ {R R' T L : Type u} [CommRing R] [CommRing R'] [CommRing T]
      [Algebra R R'] [Algebra R T] [AddCommGroup L] [Module R L],
      (TensorProduct R T L ≃ₗ[T] T) →
      (TensorProduct R' (TensorProduct R R' T) (TensorProduct R R' L) ≃ₗ[TensorProduct R R' T]
        TensorProduct R R' T) :=
    fun {R R' T L} _ _ _ _ _ _ _ e =>
      let T' := TensorProduct R R' T
      letI : CommRing T' := inferInstance
      letI : Algebra R' T' := inferInstance
      letI : Algebra R T' := inferInstance
      letI : IsScalarTower R R' T' := inferInstance
      (TensorProduct.AlgebraTensorModule.cancelBaseChange R R' T' T' L).trans
        (pullTriv (Algebra.TensorProduct.includeRight (R := R) (A := R') (B := T)) e)
  have baseChangeTriv_one_tmul : ∀ {R R' T L : Type u} [CommRing R] [CommRing R'] [CommRing T]
      [Algebra R R'] [Algebra R T] [AddCommGroup L] [Module R L]
      (e : TensorProduct R T L ≃ₗ[T] T) (m : TensorProduct R R' L),
      baseChangeTriv e ((1 : TensorProduct R R' T) ⊗ₜ[R'] m) =
        LinearMap.lTensor R'
          (e.toLinearMap.restrictScalars R ∘ₗ TensorProduct.mk R T L 1) m := by
    intro R R' T L _ _ _ _ _ _ _ e m
    let T' := TensorProduct R R' T
    letI : CommRing T' := inferInstance
    letI : Algebra R' T' := inferInstance
    letI : Algebra R T' := inferInstance
    letI : IsScalarTower R R' T' := inferInstance
    let σ : L →ₗ[R] T := e.toLinearMap.restrictScalars R ∘ₗ TensorProduct.mk R T L 1
    change baseChangeTriv e ((1 : T') ⊗ₜ[R'] m) = LinearMap.lTensor R' σ m
    induction m using TensorProduct.induction_on with
    | zero => simp
    | tmul r' x =>
      dsimp [baseChangeTriv]
      have h1 : (r' • (1 : T')) ⊗ₜ[R] x = (r' • (1 : T')) • ((1 : T') ⊗ₜ[R] x) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [h1, LinearEquiv.map_smul, pullTriv_one_tmul]
      change (r' • (1 : T')) * ((1 : R') ⊗ₜ[R] σ x) = r' ⊗ₜ[R] σ x
      rw [smul_mul_assoc, one_mul, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    | add m₁ m₂ ih₁ ih₂ =>
      rw [TensorProduct.tmul_add, map_add, map_add, ih₁, ih₂]

  have bcRingHom_tmul : ∀ {R R' U V : Type u} [CommRing R] [CommRing R'] [CommRing U] [CommRing V]
      [Algebra R R'] [Algebra R U] [Algebra R V] (u : U) (v : V),
      let U' := TensorProduct R R' U
      let V' := TensorProduct R R' V
      letI : CommRing U' := inferInstance
      letI : Algebra R' U' := inferInstance
      letI : Algebra R U' := inferInstance
      letI : IsScalarTower R R' U' := inferInstance
      letI : CommRing V' := inferInstance
      letI : Algebra R' V' := inferInstance
      (((Algebra.TensorProduct.cancelBaseChange R R' R' U' V).symm.toAlgHom.toRingHom.comp
          (((Algebra.TensorProduct.assoc R R R R' U V).symm.toAlgHom.toRingHom).comp
            (Algebra.TensorProduct.includeRight (R := R) (A := R')
              (B := TensorProduct R U V)).toRingHom)) (u ⊗ₜ[R] v) :
        TensorProduct R' U' V') =
        ((1 : R') ⊗ₜ[R] u) ⊗ₜ[R'] ((1 : R') ⊗ₜ[R] v) := by
    intro R R' U V _ _ _ _ _ _ _ u v
    simp

  have bc_diag_cocycle : ∀ {R R' T L : Type u} [CommRing R] [CommRing R'] [CommRing T]
      [Algebra R R'] [Algebra R T] [AddCommGroup L] [Module R L]
      (σ : L →ₗ[R] T) (g : TensorProduct R T T) (m : TensorProduct R R' L),
      (∀ x : L, ((1 : T) ⊗ₜ[R] σ x : TensorProduct R T T) = g * (σ x ⊗ₜ[R] (1 : T))) →
      let T' := TensorProduct R R' T
      letI : CommRing T' := inferInstance
      letI : Algebra R' T' := inferInstance
      letI : Algebra R T' := inferInstance
      letI : IsScalarTower R R' T' := inferInstance
      let φ : TensorProduct R T T →+* TensorProduct R' T' T' :=
        (Algebra.TensorProduct.cancelBaseChange R R' R' T' T).symm.toAlgHom.toRingHom.comp
          (((Algebra.TensorProduct.assoc R R R R' T T).symm.toAlgHom.toRingHom).comp
            (Algebra.TensorProduct.includeRight (R := R) (A := R')
              (B := TensorProduct R T T)).toRingHom)
      ((1 : T') ⊗ₜ[R'] (LinearMap.lTensor R' σ m) : TensorProduct R' T' T') =
        φ g * ((LinearMap.lTensor R' σ m) ⊗ₜ[R'] (1 : T')) := by
    intro R R' T L _ _ _ _ _ _ _ σ g m hg
    dsimp only
    let T' := TensorProduct R R' T
    letI : CommRing T' := inferInstance
    letI : Algebra R' T' := inferInstance
    letI : Algebra R T' := inferInstance
    letI : IsScalarTower R R' T' := inferInstance
    let φ : TensorProduct R T T →+* TensorProduct R' T' T' :=
      (Algebra.TensorProduct.cancelBaseChange R R' R' T' T).symm.toAlgHom.toRingHom.comp
        (((Algebra.TensorProduct.assoc R R R R' T T).symm.toAlgHom.toRingHom).comp
          (Algebra.TensorProduct.includeRight (R := R) (A := R')
            (B := TensorProduct R T T)).toRingHom)
    change ((1 : T') ⊗ₜ[R'] (LinearMap.lTensor R' σ m) : TensorProduct R' T' T') =
      φ g * ((LinearMap.lTensor R' σ m) ⊗ₜ[R'] (1 : T'))
    induction m using TensorProduct.induction_on with
    | zero => simp
    | tmul r' x =>
      have hx := congrArg φ (hg x)
      rw [map_mul, bcRingHom_tmul, bcRingHom_tmul] at hx
      change ((1 : T') ⊗ₜ[R'] ((1 : R') ⊗ₜ[R] σ x) : TensorProduct R' T' T') =
        φ g * (((1 : R') ⊗ₜ[R] σ x) ⊗ₜ[R'] (1 : T')) at hx
      have hr : LinearMap.lTensor R' σ (r' ⊗ₜ[R] x) = r' • ((1 : R') ⊗ₜ[R] σ x) := by
        simp [TensorProduct.smul_tmul']
      rw [hr, TensorProduct.tmul_smul, hx, ← mul_smul_comm, TensorProduct.smul_tmul']
    | add m₁ m₂ ih₁ ih₂ =>
      rw [map_add, TensorProduct.tmul_add, TensorProduct.add_tmul, mul_add, ih₁, ih₂]

  have lift₁₃_tmul : ∀ {R₀ X Y Z : Type u} [CommRing R₀] [CommRing X] [CommRing Y] [CommRing Z]
      [Algebra R₀ X] [Algebra R₀ Y] [Algebra R₀ Z] (x : X) (z : Z),
      ((Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := R₀)).comp
            (Algebra.TensorProduct.includeLeft (R := R₀)))
          (Algebra.TensorProduct.includeRight (R := R₀))
          (fun _ _ => Commute.all _ _) :
        TensorProduct R₀ X Z →ₐ[R₀] TensorProduct R₀ (TensorProduct R₀ X Y) Z) (x ⊗ₜ[R₀] z)) =
      (x ⊗ₜ[R₀] (1 : Y)) ⊗ₜ[R₀] z := by
    intro R₀ X Y Z _ _ _ _ _ _ _ x z
    rw [Algebra.TensorProduct.lift_tmul]
    simp

  have lift₂₃_tmul : ∀ {R₀ X Y Z : Type u} [CommRing R₀] [CommRing X] [CommRing Y] [CommRing Z]
      [Algebra R₀ X] [Algebra R₀ Y] [Algebra R₀ Z] (y : Y) (z : Z),
      ((Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := R₀)).comp
            (Algebra.TensorProduct.includeRight (R := R₀)))
          (Algebra.TensorProduct.includeRight (R := R₀))
          (fun _ _ => Commute.all _ _) :
        TensorProduct R₀ Y Z →ₐ[R₀] TensorProduct R₀ (TensorProduct R₀ X Y) Z) (y ⊗ₜ[R₀] z)) =
      ((1 : X) ⊗ₜ[R₀] y) ⊗ₜ[R₀] z := by
    intro R₀ X Y Z _ _ _ _ _ _ _ y z
    rw [Algebra.TensorProduct.lift_tmul]
    simp

  have single_chart_cocycle : ∀ {R T L : Type u} [CommRing R] [CommRing T] [Algebra R T]
      [AddCommGroup L] [Module R L] (e : TensorProduct R T L ≃ₗ[T] T),
      let A := TensorProduct R T T
      letI : CommRing A := inferInstance
      letI : Algebra R A := inferInstance
      let σ : L →ₗ[R] T := e.toLinearMap.restrictScalars R ∘ₗ TensorProduct.mk R T L 1
      let p₁₂ : A →ₐ[R] TensorProduct R A T := Algebra.TensorProduct.includeLeft
      let p₁₃ : A →ₐ[R] TensorProduct R A T :=
        Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := R)).comp
            (Algebra.TensorProduct.includeLeft (R := R)))
          (Algebra.TensorProduct.includeRight (R := R)) (fun _ _ => Commute.all _ _)
      let p₂₃ : A →ₐ[R] TensorProduct R A T :=
        Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := R)).comp
            (Algebra.TensorProduct.includeRight (R := R)))
          (Algebra.TensorProduct.includeRight (R := R)) (fun _ _ => Commute.all _ _)
      ∃ g : Units A,
        (∀ x : L, ((1 : T) ⊗ₜ[R] σ x : A) = (g : A) * (σ x ⊗ₜ[R] (1 : T))) ∧
        p₁₃ (g : A) = p₁₂ (g : A) * p₂₃ (g : A) := by
    intro R T L _ _ _ _ _ e
    dsimp only
    let A := TensorProduct R T T
    letI : CommRing A := inferInstance
    letI : Algebra R A := inferInstance
    let σ : L →ₗ[R] T := e.toLinearMap.restrictScalars R ∘ₗ TensorProduct.mk R T L 1
    let α := pullTriv (Algebra.TensorProduct.includeLeft (R := R) (A := T) (B := T)) e
    let β := pullTriv (Algebra.TensorProduct.includeRight (R := R) (A := T) (B := T)) e
    let g : Units A := unitOfLinearEquiv (α.symm.trans β)
    have hg : ∀ x : L, ((1 : T) ⊗ₜ[R] σ x : A) = (g : A) * (σ x ⊗ₜ[R] (1 : T)) := by
      intro x
      have h := unitOfTwoTriv_apply α β ((1 : A) ⊗ₜ[R] x)
      rw [pullTriv_one_tmul, pullTriv_one_tmul] at h
      exact h
    refine ⟨g, hg, ?_⟩
    let p₁₂ : A →ₐ[R] TensorProduct R A T := Algebra.TensorProduct.includeLeft
    let p₁₃ : A →ₐ[R] TensorProduct R A T :=
      Algebra.TensorProduct.lift
        ((Algebra.TensorProduct.includeLeft (R := R)).comp
          (Algebra.TensorProduct.includeLeft (R := R)))
        (Algebra.TensorProduct.includeRight (R := R)) (fun _ _ => Commute.all _ _)
    let p₂₃ : A →ₐ[R] TensorProduct R A T :=
      Algebra.TensorProduct.lift
        ((Algebra.TensorProduct.includeLeft (R := R)).comp
          (Algebra.TensorProduct.includeRight (R := R)))
        (Algebra.TensorProduct.includeRight (R := R)) (fun _ _ => Commute.all _ _)
    let φ₃ : T →+* TensorProduct R A T :=
      (p₁₂.toRingHom).comp (Algebra.TensorProduct.includeLeftRingHom (R := R) (A := T) (B := T))
    apply cancel_of_mul_sigma e φ₃
    intro x
    change p₁₃ (g : A) * ((σ x ⊗ₜ[R] (1 : T)) ⊗ₜ[R] (1 : T)) =
      (p₁₂ (g : A) * p₂₃ (g : A)) * ((σ x ⊗ₜ[R] (1 : T)) ⊗ₜ[R] (1 : T))
    have h1 : ((σ x ⊗ₜ[R] (1 : T)) ⊗ₜ[R] (1 : T) : TensorProduct R A T) =
        p₁₃ (σ x ⊗ₜ[R] (1 : T)) := (lift₁₃_tmul (σ x) (1 : T)).symm
    have h2 : ((σ x ⊗ₜ[R] (1 : T)) ⊗ₜ[R] (1 : T) : TensorProduct R A T) =
        p₁₂ (σ x ⊗ₜ[R] (1 : T)) := rfl
    have h3 : (((1 : T) ⊗ₜ[R] σ x) ⊗ₜ[R] (1 : T) : TensorProduct R A T) =
        p₂₃ (σ x ⊗ₜ[R] (1 : T)) := (lift₂₃_tmul (σ x) (1 : T)).symm
    have hlhs : p₁₃ (g : A) * ((σ x ⊗ₜ[R] (1 : T)) ⊗ₜ[R] (1 : T)) =
        ((1 : T) ⊗ₜ[R] (1 : T)) ⊗ₜ[R] σ x := by
      rw [h1, ← map_mul, ← hg x]
      exact lift₁₃_tmul (1 : T) (σ x)
    have hrhs : (p₁₂ (g : A) * p₂₃ (g : A)) * ((σ x ⊗ₜ[R] (1 : T)) ⊗ₜ[R] (1 : T)) =
        ((1 : T) ⊗ₜ[R] (1 : T)) ⊗ₜ[R] σ x := by
      rw [mul_comm (p₁₂ (g : A)) (p₂₃ (g : A)), mul_assoc, h2, ← map_mul, ← hg x]
      change p₂₃ (g : A) * (((1 : T) ⊗ₜ[R] σ x) ⊗ₜ[R] (1 : T)) = _
      rw [h3, ← map_mul, ← hg x]
      exact lift₂₃_tmul (1 : T) (σ x)
    exact hlhs.trans hrhs.symm

  refine ⟨?_, ?_, ?_, ?_⟩
  
  
  
  · intro B _ D hSplit E
    have single_zariski : ∀ (R L : Type u) [CommRing R] [AddCommGroup L] [Module R L]
        (n : ℕ) (f : Fin n → R)
        (_ : ∀ a : Fin n,
          TensorProduct R (Localization.Away (f a)) L ≃ₗ[Localization.Away (f a)]
            Localization.Away (f a)),
        Finset.univ.sum f = 1 →
        ∃ (T : Type u) (_ : CommRing T) (_ : Algebra R T) (_ : Algebra.Etale R T)
          (_ : TensorProduct R T L ≃ₗ[T] T),
          AlgebraicGeometry.Surjective
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R T))) := by
      intro R L _ _ _ n f eLoc hSum
      let A : Fin n → Type u := fun a => Localization.Away (f a)
      let T : Type u := ∀ a : Fin n, A a
      haveI : ∀ a : Fin n, Algebra.Etale R (A a) := fun a => {}
      let Φ_bilin : T →ₗ[T] (L →ₗ[R] T) :=
        { toFun := fun t =>
            { toFun := fun x a => t a * eLoc a ((1 : A a) ⊗ₜ[R] x)
              map_add' := fun x y => by
                funext a
                dsimp [T]
                rw [TensorProduct.tmul_add, map_add, mul_add]
              map_smul' := fun r x => by
                funext a
                dsimp [T]
                have hr : (1 : A a) ⊗ₜ[R] (r • x) = (algebraMap R (A a) r) • ((1 : A a) ⊗ₜ[R] x) := by
                  rw [TensorProduct.tmul_smul, ← IsScalarTower.algebraMap_smul (A a) r]
                rw [hr, (eLoc a).map_smul, smul_eq_mul, mul_left_comm, Algebra.smul_def] }
          map_add' := fun t₁ t₂ => by
            apply LinearMap.ext; intro x; funext a; dsimp [T]; exact add_mul (t₁ a) (t₂ a) _
          map_smul' := fun s t => by
            apply LinearMap.ext; intro x; funext a; dsimp [T]; exact mul_assoc (s a) (t a) _ }
      let Φ : TensorProduct R T L →ₗ[T] T := TensorProduct.AlgebraTensorModule.lift Φ_bilin
      let ι : ∀ a : Fin n, A a →ₗ[R] T := fun a => LinearMap.single R A a
      let ω : Fin n → TensorProduct R T L :=
        fun a => LinearMap.rTensor L (ι a) ((eLoc a).symm 1)
      let ω_sum : TensorProduct R T L := Finset.univ.sum ω
      let Ψ : T →ₗ[T] TensorProduct R T L :=
        LinearMap.toSpanSingleton T (TensorProduct R T L) ω_sum
      have hΦ_rTensor : ∀ (a : Fin n) (z : TensorProduct R (A a) L),
          Φ (LinearMap.rTensor L (ι a) z) = Pi.single a (eLoc a z) := by
        intro a z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul u x =>
          funext b
          have hu : eLoc a (u ⊗ₜ[R] x) = u * eLoc a ((1 : A a) ⊗ₜ[R] x) := by
            have h1 : u ⊗ₜ[R] x = u • ((1 : A a) ⊗ₜ[R] x) := by
              rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
            rw [h1, (eLoc a).map_smul, smul_eq_mul]
          change ι a u b * eLoc b ((1 : A b) ⊗ₜ[R] x) = Pi.single a (eLoc a (u ⊗ₜ[R] x)) b
          rw [LinearMap.single_apply, hu]
          by_cases hba : b = a
          · subst hba
            simp
          · simp [Pi.single_eq_of_ne hba]
        | add z₁ z₂ ih₁ ih₂ =>
          rw [map_add, map_add, map_add, Pi.single_add, ih₁, ih₂]
      have hΦ_ω_sum : Φ ω_sum = 1 := by
        dsimp [ω_sum]
        rw [map_sum]
        funext b
        dsimp [T]
        rw [Finset.sum_apply]
        simp [ω, hΦ_rTensor, Pi.single_apply]
      have hrTensor_smul : ∀ (s : T) (a : Fin n) (z : TensorProduct R (A a) L),
          LinearMap.rTensor L (ι a) ((s a) • z) = s • LinearMap.rTensor L (ι a) z := by
        intro s a z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul u y =>
          have hι : ι a (s a * u) = s • ι a u := by
            funext b
            dsimp [T, ι]
            by_cases hba : b = a
            · subst hba; simp
            · simp [Pi.single_eq_of_ne hba]
          rw [TensorProduct.smul_tmul', smul_eq_mul, LinearMap.rTensor_tmul, hι,
            ← TensorProduct.smul_tmul', LinearMap.rTensor_tmul]
        | add z₁ z₂ ih₁ ih₂ =>
          rw [smul_add, map_add, map_add, smul_add, ih₁, ih₂]
      have hΨΦ_one : ∀ x : L, Ψ (Φ ((1 : T) ⊗ₜ[R] x)) = (1 : T) ⊗ₜ[R] x := by
        intro x
        set s : T := Φ ((1 : T) ⊗ₜ[R] x)
        have hsa : ∀ a : Fin n, s a = eLoc a ((1 : A a) ⊗ₜ[R] x) := by
          intro a
          change (1 : T) a * eLoc a ((1 : A a) ⊗ₜ[R] x) = _
          exact one_mul _
        have h_coord : ∀ a : Fin n, s • ω a = (ι a 1) ⊗ₜ[R] x := by
          intro a
          dsimp [ω]
          rw [← hrTensor_smul, ← (eLoc a).symm.map_smul, smul_eq_mul, mul_one, hsa a,
            (eLoc a).symm_apply_apply, LinearMap.rTensor_tmul]
        have h_one_T : Finset.univ.sum (fun a : Fin n => ι a 1) = (1 : T) := by
          funext b
          dsimp [T, ι]
          rw [Finset.sum_apply]
          simp [LinearMap.single_apply, Pi.single_apply]
        change s • ω_sum = (1 : T) ⊗ₜ[R] x
        dsimp [ω_sum]
        rw [Finset.smul_sum, Finset.sum_congr rfl (fun a _ => h_coord a),
          ← TensorProduct.sum_tmul, h_one_T]
      have hΨΦ : ∀ w : TensorProduct R T L, Ψ (Φ w) = w := by
        intro w
        induction w using TensorProduct.induction_on with
        | zero => simp
        | tmul t x =>
          have ht : t ⊗ₜ[R] x = t • ((1 : T) ⊗ₜ[R] x) := by
