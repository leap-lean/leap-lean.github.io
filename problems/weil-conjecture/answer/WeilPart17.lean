            _ = (algebraMap P L (Polynomial.C (q.coeff j))) *
                (algebraMap P L Polynomial.X) ^ (d - j) := by
              rw [hX_alg₁, hmul_inv, one_pow, mul_one]
        rw [← hmul0, hq_zero, mul_zero]
      obtain ⟨⟨_, M, rfl⟩, hM_kill⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (Polynomial.X : P)) L q_rev).mp hq_rev_loc
      dsimp at hM_kill
      have hq_eq_zero : q = 0 := by
        ext l
        rw [Polynomial.coeff_zero]
        by_cases hl : l ≤ d
        · have hc0 : (Polynomial.X ^ M * q_rev).coeff ((d - l) + M) = 0 := by
            rw [Nat.add_comm (d - l) M, hM_kill, Polynomial.coeff_zero]
          rw [Polynomial.coeff_X_pow_mul] at hc0
          dsimp [q_rev] at hc0
          rw [Polynomial.finsetSum_coeff] at hc0
          have hterm : ∀ j : ℕ, (Polynomial.C (q.coeff j) * Polynomial.X ^ (d - j)).coeff (d - l) =
              if d - j = d - l then q.coeff j else 0 := by
            intro j
            rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
            by_cases hjl : d - l = d - j
            · simp [hjl]
            · simp [hjl, Ne.symm hjl]
          simp_rw [hterm] at hc0
          rw [Finset.sum_eq_single l] at hc0
          · simpa using hc0
          · intro j hj hne
            rw [Finset.mem_range] at hj
            simp [show d - j ≠ d - l by omega]
          · intro hnot
            exact absurd (Finset.mem_range.mpr (by omega)) hnot
        · exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
      have hxy_eq : x = y := sub_eq_zero.mp hq_eq_zero
      exact ⟨1, by simp [hxy_eq]⟩
    letI : Algebra P L := RingHom.toAlgebra alg₁_hom
    exact { map_units := h1_units, surj := h2_surj, exists_of_eq := h3_eq }
  have hLocTransfer : ∀ {S₀ S₀₁ S₀' S₀₁' : Type u}
      [CommRing S₀] [CommRing S₀₁] [CommRing S₀'] [CommRing S₀₁']
      [Algebra S₀ S₀₁] [Algebra S₀ S₀'] [Algebra S₀₁ S₀₁'] [Algebra S₀' S₀₁'],
      (∀ x : S₀, algebraMap S₀' S₀₁' (algebraMap S₀ S₀' x) =
        algebraMap S₀₁ S₀₁' (algebraMap S₀ S₀₁ x)) →
      ∀ (s : S₀), IsLocalization.Away s S₀₁ →
      ∀ (n_b : ℕ) (e₀ : Fin n_b → S₀') (e₀₁ : Fin n_b → S₀₁'),
      (∀ i : Fin n_b, algebraMap S₀' S₀₁' (e₀ i) = e₀₁ i) →
      Function.Bijective (fun c : Fin n_b → S₀ =>
        Finset.univ.sum fun i => algebraMap S₀ S₀' (c i) * e₀ i) →
      Function.Bijective (fun c : Fin n_b → S₀₁ =>
        Finset.univ.sum fun i => algebraMap S₀₁ S₀₁' (c i) * e₀₁ i) →
      IsLocalization.Away (algebraMap S₀ S₀' s) S₀₁' := by
    intro S₀ S₀₁ S₀' S₀₁' _ _ _ _ _ _ _ _ hcomp s hLoc n_b e₀ e₀₁ he hbij₀ hbij₀₁
    have : IsLocalization.Away s S₀₁ := hLoc
    refine
      { map_units := ?_
        surj := ?_
        exists_of_eq := ?_ }
    · rintro ⟨_, k, rfl⟩
      change IsUnit (algebraMap S₀' S₀₁' ((algebraMap S₀ S₀' s) ^ k))
      rw [map_pow, hcomp s]
      exact ((IsLocalization.Away.algebraMap_isUnit s).map (algebraMap S₀₁ S₀₁')).pow k
    · intro z
      obtain ⟨c, rfl⟩ := hbij₀₁.2 z
      have hsurj_i : ∀ i : Fin n_b, ∃ m_i : ℕ, ∃ r_i : S₀,
          c i * (algebraMap S₀ S₀₁ s) ^ m_i = algebraMap S₀ S₀₁ r_i :=
        fun i => IsLocalization.Away.surj s (c i)
      choose m_fn r_fn hmr using hsurj_i
      let M : ℕ := Finset.univ.sup m_fn
      let x₁ : S₀' := Finset.univ.sum fun i : Fin n_b =>
        algebraMap S₀ S₀' (s ^ (M - m_fn i) * r_fn i) * e₀ i
      refine ⟨⟨x₁, ⟨(algebraMap S₀ S₀' s) ^ M, M, rfl⟩⟩, ?_⟩
      change (Finset.univ.sum fun i => algebraMap S₀₁ S₀₁' (c i) * e₀₁ i) *
          algebraMap S₀' S₀₁' ((algebraMap S₀ S₀' s) ^ M) =
        algebraMap S₀' S₀₁' x₁
      dsimp [x₁]
      rw [Finset.sum_mul, map_sum]
      apply Finset.sum_congr rfl
      intro i _
      have hle : m_fn i ≤ M := Finset.le_sup (f := m_fn) (Finset.mem_univ i)
      have hM_eq : M = m_fn i + (M - m_fn i) := (Nat.add_sub_of_le hle).symm
      rw [map_pow, hcomp s, map_mul, hcomp, map_mul, map_pow, he i]
      calc
        (algebraMap S₀₁ S₀₁' (c i) * e₀₁ i) * (algebraMap S₀₁ S₀₁' (algebraMap S₀ S₀₁ s)) ^ M =
            algebraMap S₀₁ S₀₁' (c i * (algebraMap S₀ S₀₁ s) ^ (m_fn i)) *
              algebraMap S₀₁ S₀₁' ((algebraMap S₀ S₀₁ s) ^ (M - m_fn i)) * e₀₁ i := by
          conv_lhs => rw [hM_eq, pow_add]
          simp only [map_mul, map_pow]
          ring
        _ = (algebraMap S₀₁ S₀₁' ((algebraMap S₀ S₀₁ s) ^ (M - m_fn i) *
              algebraMap S₀ S₀₁ (r_fn i))) * e₀₁ i := by
          rw [hmr i, map_mul]; ring
    · intro x y hxy
      obtain ⟨c, hc⟩ := hbij₀.2 (x - y)
      dsimp only at hc
      have hzero_S₀₁' : (Finset.univ.sum fun i : Fin n_b =>
          algebraMap S₀₁ S₀₁' (algebraMap S₀ S₀₁ (c i)) * e₀₁ i) = 0 := by
        have hmap : algebraMap S₀' S₀₁' (Finset.univ.sum fun i => algebraMap S₀ S₀' (c i) * e₀ i) = 0 := by
          rw [hc, map_sub, hxy, sub_self]
        simpa only [map_sum, map_mul, hcomp, he] using hmap
      have hzero_S₀₁'₂ : (Finset.univ.sum fun i : Fin n_b =>
          algebraMap S₀₁ S₀₁' (algebraMap S₀ S₀₁ (c i)) * e₀₁ i) =
          Finset.univ.sum fun i : Fin n_b => algebraMap S₀₁ S₀₁' (0 : S₀₁) * e₀₁ i := by
        rw [hzero_S₀₁']
        simp
      have hc_loc := hbij₀₁.1 hzero_S₀₁'₂
      have hkill_i : ∀ i : Fin n_b, ∃ m_i : ℕ, s ^ m_i * c i = 0 := by
        intro i
        have hi : algebraMap S₀ S₀₁ (c i) = 0 := congrFun hc_loc i
        obtain ⟨⟨_, m_i, rfl⟩, hm_i⟩ :=
          (@IsLocalization.map_eq_zero_iff S₀ _ (Submonoid.powers s) S₀₁ _ _ hLoc (c i)).mp hi
        exact ⟨m_i, hm_i⟩
      choose m_fn hm_fn using hkill_i
      let M : ℕ := Finset.univ.sup m_fn
      refine ⟨⟨(algebraMap S₀ S₀' s) ^ M, M, rfl⟩, ?_⟩
      change (algebraMap S₀ S₀' s) ^ M * x = (algebraMap S₀ S₀' s) ^ M * y
      rw [← sub_eq_zero, ← mul_sub, ← hc, ← map_pow, Finset.mul_sum]
      apply Finset.sum_eq_zero
      intro i _
      have hle : m_fn i ≤ M := Finset.le_sup (f := m_fn) (Finset.mem_univ i)
      have hM_eq : M = (M - m_fn i) + m_fn i := (Nat.sub_add_cancel hle).symm
      rw [← mul_assoc, ← map_mul]
      have hci_zero : s ^ M * c i = 0 := by
        rw [hM_eq, pow_add, mul_assoc, hm_fn i, mul_zero]
      rw [hci_zero, map_zero, zero_mul]
  have hAdjoinBasis : ∀ {R : Type u} [CommRing R] (f : Polynomial R) (hf : f.Monic)
      (n_b : ℕ) (hdeg : f.natDegree = n_b) (u : R) (hu : IsUnit u),
      Function.Bijective (fun c : Fin n_b → R =>
        Finset.univ.sum fun e : Fin n_b =>
          AdjoinRoot.of f (c e) * (AdjoinRoot.of f u * AdjoinRoot.root f) ^ (e : ℕ)) := by
    intro R _ f hf n_b hdeg u hu
    subst hdeg
    let pb := AdjoinRoot.isAdjoinRootMonic f hf
    have h1 : Function.Bijective (fun c : Fin f.natDegree → R =>
        Finset.univ.sum fun e : Fin f.natDegree =>
          AdjoinRoot.of f (c e) * (AdjoinRoot.root f) ^ (e : ℕ)) := by
      have heq : (fun c : Fin f.natDegree → R =>
          Finset.univ.sum fun e : Fin f.natDegree =>
            AdjoinRoot.of f (c e) * (AdjoinRoot.root f) ^ (e : ℕ)) =
          ⇑pb.basis.equivFun.symm := by
        ext c
        rw [Module.Basis.equivFun_symm_apply]
        apply Finset.sum_congr rfl
        intro e _
        rw [IsAdjoinRootMonic.basis_apply, Algebra.smul_def]
        rfl
      rw [heq]
      exact pb.basis.equivFun.symm.bijective
    obtain ⟨u_unit, rfl⟩ := hu
    let mulU : (Fin f.natDegree → R) ≃ (Fin f.natDegree → R) :=
      { toFun := fun c e => c e * (↑u_unit : R) ^ (e : ℕ)
        invFun := fun c e => c e * (↑u_unit⁻¹ : R) ^ (e : ℕ)
        left_inv := fun c => by
          ext e; simp [mul_assoc, ← mul_pow]
        right_inv := fun c => by
          ext e; simp [mul_assoc, ← mul_pow] }
    have hcomp_eq : (fun c : Fin f.natDegree → R =>
        Finset.univ.sum fun e : Fin f.natDegree =>
          AdjoinRoot.of f (c e) * (AdjoinRoot.of f (↑u_unit : R) * AdjoinRoot.root f) ^ (e : ℕ)) =
        (fun c : Fin f.natDegree → R =>
          Finset.univ.sum fun e : Fin f.natDegree =>
            AdjoinRoot.of f (c e) * (AdjoinRoot.root f) ^ (e : ℕ)) ∘ mulU := by
      ext c
      dsimp [mulU]
      apply Finset.sum_congr rfl
      intro e _
      rw [mul_pow, map_mul, map_pow, mul_assoc]
    rw [hcomp_eq]
    exact h1.comp mulU.bijective
  have hProdBasis : ∀ {B R : Type u} [CommRing B] [CommRing R] [Algebra (Polynomial B) R]
      (r_b : ℕ) (b : Fin r_b → R)
      (hbij_R : Function.Bijective (fun g : Fin r_b → Polynomial B =>
        Finset.univ.sum fun i => algebraMap (Polynomial B) R (g i) * b i))
      (f : Polynomial R) (hf : f.Monic) (n_b : ℕ) (hdeg : f.natDegree = n_b),
      let eqv := finProdFinEquiv (m := r_b) (n := n_b)
      Function.Bijective (fun F : Fin (r_b * n_b) → Polynomial B =>
        Finset.univ.sum fun p : Fin (r_b * n_b) =>
          AdjoinRoot.of f (algebraMap (Polynomial B) R (F p)) *
            (AdjoinRoot.of f (b (eqv.symm p).1) * (AdjoinRoot.root f) ^ ((eqv.symm p).2 : ℕ))) := by
    intro B R _ _ _ r_b b hbij_R f hf n_b hdeg eqv
    let reidx : (Fin (r_b * n_b) → Polynomial B) ≃ (Fin n_b → Fin r_b → Polynomial B) :=
      { toFun := fun F e i => F (eqv (i, e))
        invFun := fun G p => G (eqv.symm p).2 (eqv.symm p).1
        left_inv := fun F => by funext p; simp
        right_inv := fun G => by funext e i; simp }
    let mapR : (Fin n_b → Fin r_b → Polynomial B) → (Fin n_b → R) :=
      fun G e => Finset.univ.sum fun i : Fin r_b => algebraMap (Polynomial B) R (G e i) * b i
    have hmapR_bij : Function.Bijective mapR := by
      constructor
      · intro G₁ G₂ hG
        funext e i
        have he : mapR G₁ e = mapR G₂ e := congrFun hG e
        exact congrFun (hbij_R.1 he) i
      · intro c
        choose G hG using fun e => hbij_R.2 (c e)
        exact ⟨G, funext hG⟩
    let mapAdj : (Fin n_b → R) → AdjoinRoot f :=
      fun c => Finset.univ.sum fun e : Fin n_b =>
        AdjoinRoot.of f (c e) * (AdjoinRoot.root f) ^ (e : ℕ)
    have hmapAdj_bij : Function.Bijective mapAdj := by
      have h1 := hAdjoinBasis f hf n_b hdeg 1 isUnit_one
      simpa [mapAdj] using h1
    have htot_eq : (fun F : Fin (r_b * n_b) → Polynomial B =>
        Finset.univ.sum fun p : Fin (r_b * n_b) =>
          AdjoinRoot.of f (algebraMap (Polynomial B) R (F p)) *
            (AdjoinRoot.of f (b (eqv.symm p).1) * (AdjoinRoot.root f) ^ ((eqv.symm p).2 : ℕ))) =
        mapAdj ∘ mapR ∘ reidx := by
      funext F
      dsimp [mapAdj, mapR, reidx]
      rw [← eqv.sum_comp, Fintype.sum_prod_type_right]
      apply Finset.sum_congr rfl
      intro e _
      rw [map_sum, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i _
      simp [mul_assoc]
    rw [htot_eq]
    exact hmapAdj_bij.comp (hmapR_bij.comp reidx.bijective)
  
  have hInd : ∀ s : ℕ, s ≤ m →
      ∃ (r : ℕ) (w : Fin r → ℕ)
        (D : WeilTwoChartRingDatum A)
        (D₀ : WeilTwoChartRingDatum k)
        (red : WeilTwoChartCurveReduction D D₀)
        (Φ₀ : D.R₀ →+* B₀)
        (Φ₁ : D.R₁ →+* B₁)
        (Φ₀₁ : D.R₀₁ →+* B₀₁)
        (hr_D : D.r = r) (hr_D₀ : D₀.r = r),
        letI : Algebra D.R₀ D₀.R₀ := red.algR₀
        letI : Algebra D.R₁ D₀.R₁ := red.algR₁
        WeilIsValidTwoChartRingDatum D ∧
        WeilIsValidTwoChartRingDatum D₀ ∧
        (∀ j : Fin r, D.w (Fin.cast hr_D.symm j) = w j) ∧
        (∀ j : Fin r, D₀.w (Fin.cast hr_D₀.symm j) = w j) ∧
        (∀ j : Fin r, algebraMap D.R₀ D₀.R₀ (D.b₀ (Fin.cast hr_D.symm j)) =
          D₀.b₀ (Fin.cast hr_D₀.symm j)) ∧
        (∀ j : Fin r, algebraMap D.R₁ D₀.R₁ (D.b₁ (Fin.cast hr_D.symm j)) =
          D₀.b₁ (Fin.cast hr_D₀.symm j)) ∧
        (∀ p : Polynomial A,
          algebraMap D.R₀ D₀.R₀ (algebraMap (Polynomial A) D.R₀ p) =
            algebraMap (Polynomial k) D₀.R₀ (Polynomial.map τ_A.toRingHom p)) ∧
        (∀ p : Polynomial A,
          algebraMap D.R₁ D₀.R₁ (algebraMap (Polynomial A) D.R₁ p) =
            algebraMap (Polynomial k) D₀.R₁ (Polynomial.map τ_A.toRingHom p)) ∧
        Φ₀.comp (algebraMap (Polynomial A) D.R₀) = algebraMap (Polynomial A) B₀ ∧
        Φ₁.comp (algebraMap (Polynomial A) D.R₁) = algebraMap (Polynomial A) B₁ ∧
        Φ₀₁.comp (algebraMap D.R₀ D.R₀₁) = (algebraMap B₀ B₀₁).comp Φ₀ ∧
        Φ₀₁.comp (algebraMap D.R₁ D.R₀₁) = (algebraMap B₁ B₀₁).comp Φ₁ ∧
        (∀ α : Fin m, (α : ℕ) < s → v₀ α ∈ Set.range Φ₀ ∧ v₁ α ∈ Set.range Φ₁) := by
    intro s
    induction s with
    | zero =>
      intro _
      let R₀_A := Polynomial A
      let R₁_A := Polynomial A
      let R₀₁_A := Localization.Away (Polynomial.X : Polynomial A)
      let alg₁_A : Polynomial A →+* R₀₁_A :=
        Polynomial.eval₂RingHom ((algebraMap R₀_A R₀₁_A).comp Polynomial.C)
          (IsLocalization.Away.invSelf (Polynomial.X : Polynomial A))
      let D_base : WeilTwoChartRingDatum A :=
        { r := 1
          w := fun _ => 0
          R₀ := R₀_A
          R₁ := R₁_A
          R₀₁ := R₀₁_A
          alg₀ := inferInstance
          alg₁ := RingHom.toAlgebra alg₁_A
          b₀ := fun _ => 1
          b₁ := fun _ => 1 }
      let R₀_k := Polynomial k
      let R₁_k := Polynomial k
      let R₀₁_k := Localization.Away (Polynomial.X : Polynomial k)
      let alg₁_k : Polynomial k →+* R₀₁_k :=
        Polynomial.eval₂RingHom ((algebraMap R₀_k R₀₁_k).comp Polynomial.C)
          (IsLocalization.Away.invSelf (Polynomial.X : Polynomial k))
      let D₀_base : WeilTwoChartRingDatum k :=
        { r := 1
          w := fun _ => 0
          R₀ := R₀_k
          R₁ := R₁_k
          R₀₁ := R₀₁_k
          alg₀ := inferInstance
          alg₁ := RingHom.toAlgebra alg₁_k
          b₀ := fun _ => 1
          b₁ := fun _ => 1 }
      let map_τ : Polynomial A →+* Polynomial k := Polynomial.mapRingHom τ_A.toRingHom
      let g_red₀₁ : Polynomial A →+* R₀₁_k := (algebraMap R₀_k R₀₁_k).comp map_τ
      have hu_X_k : ∀ y : Submonoid.powers (Polynomial.X : Polynomial A), IsUnit (g_red₀₁ y) := by
        rintro ⟨_, n_p, rfl⟩
        change IsUnit (g_red₀₁ (Polynomial.X ^ n_p))
        rw [map_pow]
        have hX_map : g_red₀₁ Polynomial.X = algebraMap R₀_k R₀₁_k Polynomial.X := by
          dsimp [g_red₀₁, map_τ]
          rw [Polynomial.coe_mapRingHom, Polynomial.map_X]
        rw [hX_map]
        exact (IsLocalization.Away.algebraMap_isUnit (Polynomial.X : Polynomial k)).pow n_p
      let red₀₁_hom : R₀₁_A →+* R₀₁_k :=
        IsLocalization.lift (M := Submonoid.powers (Polynomial.X : Polynomial A)) hu_X_k
      have hred₀₁_app : ∀ p : Polynomial A,
          red₀₁_hom (algebraMap (Polynomial A) R₀₁_A p) = g_red₀₁ p :=
        fun p => IsLocalization.lift_eq (M := Submonoid.powers (Polynomial.X : Polynomial A)) hu_X_k p
      have hred₀₁_comp₀ : red₀₁_hom.comp (algebraMap R₀_A R₀₁_A) =
          (algebraMap R₀_k R₀₁_k).comp map_τ :=
        RingHom.ext hred₀₁_app
      have hred₀₁_X_inv : red₀₁_hom (IsLocalization.Away.invSelf (Polynomial.X : Polynomial A)) =
          IsLocalization.Away.invSelf (Polynomial.X : Polynomial k) := by
        have h1 : red₀₁_hom (algebraMap (Polynomial A) R₀₁_A Polynomial.X *
            IsLocalization.Away.invSelf (Polynomial.X : Polynomial A)) = 1 := by
          rw [IsLocalization.Away.mul_invSelf, map_one]
        rw [map_mul, hred₀₁_app Polynomial.X] at h1
        have h2 : g_red₀₁ Polynomial.X = algebraMap R₀_k R₀₁_k Polynomial.X := by
          dsimp [g_red₀₁, map_τ]
          rw [Polynomial.coe_mapRingHom, Polynomial.map_X]
        rw [h2, mul_comm] at h1
        have h3 := IsLocalization.Away.mul_invSelf (S := R₀₁_k) (Polynomial.X : Polynomial k)
        let uX : R₀₁_kˣ := Units.mkOfMulEqOne (algebraMap R₀_k R₀₁_k Polynomial.X)
          (IsLocalization.Away.invSelf (Polynomial.X : Polynomial k)) h3
        exact Units.eq_inv_of_mul_eq_one_right (u := uX) h1
      have hred₀₁_comp₁ : red₀₁_hom.comp alg₁_A = alg₁_k.comp map_τ := by
        apply Polynomial.ringHom_ext
        · intro a
          change red₀₁_hom (alg₁_A (Polynomial.C a)) = alg₁_k (map_τ (Polynomial.C a))
          have hCa_A : alg₁_A (Polynomial.C a) = algebraMap (Polynomial A) R₀₁_A (Polynomial.C a) :=
            Polynomial.eval₂_C _ _
          have hCa_k : alg₁_k (map_τ (Polynomial.C a)) = g_red₀₁ (Polynomial.C a) := by
            have hm : map_τ (Polynomial.C a) = Polynomial.C (τ_A a) := Polynomial.map_C _
            change Polynomial.eval₂ ((algebraMap R₀_k R₀₁_k).comp Polynomial.C)
                (IsLocalization.Away.invSelf (Polynomial.X : Polynomial k)) (map_τ (Polynomial.C a)) =
              algebraMap R₀_k R₀₁_k (map_τ (Polynomial.C a))
            rw [hm, Polynomial.eval₂_C]
            rfl
          rw [hCa_A, hCa_k, hred₀₁_app]
        · change red₀₁_hom (alg₁_A Polynomial.X) = alg₁_k (map_τ Polynomial.X)
          have hXA : alg₁_A Polynomial.X = IsLocalization.Away.invSelf (Polynomial.X : Polynomial A) :=
            Polynomial.eval₂_X _ _
          have hXk : alg₁_k (map_τ Polynomial.X) = IsLocalization.Away.invSelf (Polynomial.X : Polynomial k) := by
            simp [alg₁_k, map_τ]
          rw [hXA, hXk, hred₀₁_X_inv]
      let red_base : WeilTwoChartCurveReduction D_base D₀_base :=
        { algR₀ := map_τ.toAlgebra
          algR₁ := map_τ.toAlgebra
          algR₀₁ := red₀₁_hom.toAlgebra
          algR₀_₀₁ := ((algebraMap R₀_k R₀₁_k).comp map_τ).toAlgebra
