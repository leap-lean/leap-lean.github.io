        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac u_X W.ι _
      have hc' : (g ≫ eW.hom) ≫ W.ι = j' ≫ q := by
        rw [CategoryTheory.Category.assoc, heW_fac, hc]
