            let φ_bc := (CategoryTheory.Abelian.Ext.mk₀ bc₀).postcomp Fℤ_S' (Nat.add_zero q) φ_g
            let lhs := (CategoryTheory.Abelian.Ext.mk₀ (adj_f'.counit.app (pb_g'.obj E))).postcomp Fℤ_X' (Nat.add_zero q)
