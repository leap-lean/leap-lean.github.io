      intro c
      let u_c : Units ↑(P₂.presheaf.obj (Opposite.op ⊤)) := Additive.toMul c
      refine ⟨⟨ρ₀₀ u_c, ρ₀₁ u_c, ρ₁₀ u_c, ρ₁₁ u_c⟩,
        (hMatchIff c _).mpr ⟨rfl, rfl, rfl, rfl⟩, ?_⟩
      intro q' hq'
      rcases q' with ⟨g₀₀, g₀₁, g₁₀, g₁₁⟩
      rcases (hMatchIff c _).mp hq' with ⟨rfl, rfl, rfl, rfl⟩
      rfl

    have h2_2 : ∀ q : WeilTwoChartUnitQuad D T₀ T₁,
        ∃! c : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 1))),
          WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w c q := by
      intro q
      let g₂ : ∀ ab : Bool × Bool, Units (A₂ ab)
        | (false, false) => q.g₀₀
        | (false, true) => q.g₀₁
        | (true, false) => q.g₁₀
        | (true, true) => q.g₁₁
      obtain ⟨u_c, hu_c, hu_uniq⟩ := disjoint_units_bijective P₂ A₂ κ₂ hCovDisj₂.1 hCovDisj₂.2 g₂
      let c : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 1))) :=
        @Additive.ofMul (Units ↑(P₂.presheaf.obj (Opposite.op ⊤))) u_c
      refine ⟨c,
        (hMatchIff c q).mpr ⟨hu_c (false, false), hu_c (false, true), hu_c (true, false), hu_c (true, true)⟩,
        ?_⟩
      intro c' hc'
      have hc'' := (hMatchIff c' q).mp hc'
      apply (@Additive.toMul (Units ↑(P₂.presheaf.obj (Opposite.op ⊤)))).injective
      refine hu_uniq (@Additive.toMul (Units ↑(P₂.presheaf.obj (Opposite.op ⊤))) c') ?_
      rintro ⟨_ | _, _ | _⟩
      · exact hc''.1
      · exact hc''.2.1
      · exact hc''.2.2.1
      · exact hc''.2.2.2

    have h2_3 : WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w 0 (weilTwoChartQuadOne D T₀ T₁) :=
      (hMatchIff 0 _).mpr ⟨map_one _, map_one _, map_one _, map_one _⟩

    have h2_4 : ∀ (c₁ c₂ : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 1))))
        (q₁ q₂ : WeilTwoChartUnitQuad D T₀ T₁),
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w c₁ q₁ →
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w c₂ q₂ →
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w (c₁ + c₂) (weilTwoChartQuadMul q₁ q₂) ∧
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w (c₁ - c₂)
          ⟨q₁.g₀₀ * q₂.g₀₀⁻¹, q₁.g₀₁ * q₂.g₀₁⁻¹, q₁.g₁₀ * q₂.g₁₀⁻¹, q₁.g₁₁ * q₂.g₁₁⁻¹⟩ := by
      intro c₁ c₂ q₁ q₂ h₁ h₂
      rcases (hMatchIff c₁ q₁).mp h₁ with ⟨h₁_00, h₁_01, h₁_10, h₁_11⟩
      rcases (hMatchIff c₂ q₂).mp h₂ with ⟨h₂_00, h₂_01, h₂_10, h₂_11⟩
      let u₁ : Units ↑(P₂.presheaf.obj (Opposite.op ⊤)) := Additive.toMul c₁
      let u₂ : Units ↑(P₂.presheaf.obj (Opposite.op ⊤)) := Additive.toMul c₂
      have h_add : (@Additive.toMul (Units ↑(P₂.presheaf.obj (Opposite.op ⊤))) (c₁ + c₂)) = u₁ * u₂ := rfl
      have h_sub : (@Additive.toMul (Units ↑(P₂.presheaf.obj (Opposite.op ⊤))) (c₁ - c₂)) = u₁ * u₂⁻¹ := by
        change @Additive.toMul (Units ↑(P₂.presheaf.obj (Opposite.op ⊤))) (c₁ + (-c₂)) = u₁ * u₂⁻¹
        rfl
      constructor
      · refine (hMatchIff (c₁ + c₂) _).mpr ?_
        dsimp only [weilTwoChartQuadMul]
        rw [h_add, map_mul, map_mul, map_mul, map_mul,
          h₁_00, h₂_00, h₁_01, h₂_01, h₁_10, h₂_10, h₁_11, h₂_11]
        exact ⟨rfl, rfl, rfl, rfl⟩
      · refine (hMatchIff (c₁ - c₂) _).mpr ?_
        dsimp only
        rw [h_sub, map_mul, map_mul, map_mul, map_mul, map_inv, map_inv, map_inv, map_inv,
          h₁_00, h₂_00, h₁_01, h₂_01, h₁_10, h₂_10, h₁_11, h₂_11]
        exact ⟨rfl, rfl, rfl, rfl⟩

    have h2_5 : ∀ (c : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 1))))
        (q : WeilTwoChartUnitQuad D T₀ T₁) (n : ℕ),
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w c q →
        WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w (n • c) (weilTwoChartQuadPow q n) := by
      intro c q n hcq
      induction n with
      | zero =>
        rw [zero_nsmul]
        exact h2_3
      | succ n ih =>
        rw [succ_nsmul, add_comm]
        exact (h2_4 c (n • c) q (weilTwoChartQuadPow q n) hcq ih).1

    
