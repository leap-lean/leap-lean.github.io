    let Sh_U := presheafToSheaf J_U AddCommGrpCat.{u}
    let U_U := sheafToPresheaf J_U AddCommGrpCat.{u}
    let L_tot := Free_PSh ⋙ Sh_U
    let R_tot := U_U ⋙ Fgt_PSh
    let adj_free := Adjunction.whiskerRight (Opposite Y_U.Etale) AddCommGrpCat.adj
    let adj_shU := sheafificationAdjunction J_U AddCommGrpCat.{u}
    let adj_tot : L_tot ⊣ R_tot := adj_free.comp adj_shU
    let Z_fun : Y_U.Etale ⥤ Sheaf J_U AddCommGrpCat.{u} := yoneda ⋙ L_tot
    let Z_obj : Opposite Y_U.Etale → Sheaf J_U AddCommGrpCat.{u} :=
      fun W => Opposite.unop (Z_fun.op.obj W)
    let e_raw : ∀ W : Opposite Y_U.Etale,
        Abelian.Ext (Z_obj W) F_U 0 ≃ ↥((U_U.obj F_U).obj W) :=
      fun W =>
        Abelian.Ext.addEquiv₀.toEquiv.trans
          ((adj_tot.homEquiv (yoneda.obj W.unop) F_U).trans yonedaEquiv)
    have he_add : ∀ (W : Opposite Y_U.Etale) (α₁ α₂ : Abelian.Ext (Z_obj W) F_U 0),
        e_raw W (α₁ + α₂) = e_raw W α₁ + e_raw W α₂ := by
      intro W α₁ α₂
