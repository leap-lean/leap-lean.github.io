    have hCobEval : ∀ b : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 0))),
        let b_W : Units ↑(W_sch.presheaf.obj (Opposite.op ⊤)) := Additive.toMul b
