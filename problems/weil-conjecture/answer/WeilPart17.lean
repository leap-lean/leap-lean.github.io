          algebraMap (Polynomial A) D.R₀ P_g = algebraMap (Polynomial A) D.R₀ P_g * 1 := (mul_one _).symm
          _ = algebraMap (Polynomial A) D.R₀ P_g *
                ∑ j : Fin D.r, algebraMap (Polynomial A) D.R₀ (f1_A j) * D.b₀ j := by rw [h1]
          _ = ∑ j : Fin D.r, algebraMap (Polynomial A) D.R₀ (f1_A j) *
                (algebraMap (Polynomial A) D.R₀ P_g * D.b₀ j) := by
            rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => by ring
      rw [heq]
      exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hdet_b j)
    let b₀_cast : Fin D.r → D₀.R₀ := fun j => D₀.b₀ (Fin.cast hr j)
    have hb₀_cast_bij : Function.Bijective (fun f : Fin D.r → Polynomial k =>
        Finset.univ.sum fun j => algebraMap (Polynomial k) D₀.R₀ (f j) * b₀_cast j) := by
      let e_fin : Fin D.r ≃ Fin D₀.r := (Fin.castOrderIso hr).toEquiv
      have hsum_eq : ∀ f : Fin D.r → Polynomial k,
          (∑ j : Fin D.r, algebraMap (Polynomial k) D₀.R₀ (f j) * b₀_cast j) =
          ∑ j₀ : Fin D₀.r, algebraMap (Polynomial k) D₀.R₀ (f (e_fin.symm j₀)) * D₀.b₀ j₀ := by
        intro f
        refine (Finset.sum_congr rfl fun j _ => ?_).trans
          (e_fin.sum_comp (fun j₀ => algebraMap (Polynomial k) D₀.R₀ (f (e_fin.symm j₀)) * D₀.b₀ j₀))
        rw [Equiv.symm_apply_apply]
        rfl
      refine ⟨fun f₁ f₂ h => ?_, fun y => ?_⟩
      · dsimp only at h
        rw [hsum_eq, hsum_eq] at h
        have h' := hb₀_k.1 h
        funext j
        simpa using congrFun h' (e_fin j)
      · obtain ⟨f₀, hf₀⟩ := hb₀_k.2 y
        refine ⟨fun j => f₀ (e_fin j), ?_⟩
        dsimp only
        rw [hsum_eq]
        simpa using hf₀
    let Ξ_k := weilPicSurj_polyBasisEquiv b₀_cast hb₀_cast_bij
    let b_bask : Module.Basis (Fin D.r) (Polynomial k) D₀.R₀ := Module.Basis.ofEquivFun Ξ_k.symm
    have hbk_eq : ∀ j : Fin D.r, b_bask j = b₀_cast j := by
      intro j
      simp [b_bask, Module.Basis.ofEquivFun, Ξ_k, weilPicSurj_polyBasisEquiv, Pi.single_apply]
    let μ_g₀ : D₀.R₀ →ₗ[Polynomial k] D₀.R₀ :=
      { toFun := fun x => g₀ * x
        map_add' := fun x y => mul_add g₀ x y
        map_smul' := fun p x => by simp only [RingHom.id_apply, Algebra.smul_def]; ring }
    let M_g₀ : Matrix (Fin D.r) (Fin D.r) (Polynomial k) := LinearMap.toMatrix b_bask b_bask μ_g₀
    have hM_red : M_g.map (Polynomial.mapRingHom τ_A.toRingHom) = M_g₀ := by
      apply Matrix.ext
      intro m i
      have h1 := congrArg π₀ (hcol_A i)
      rw [map_sum, map_mul, hg_red, hb₀_red i] at h1
      have hsum1 : (∑ m' : Fin D.r,
          π₀ (algebraMap (Polynomial A) D.R₀ (M_g m' i) * D.b₀ m')) =
          Ξ_k (fun m' => Polynomial.map τ_A.toRingHom (M_g m' i)) := by
        dsimp [Ξ_k, weilPicSurj_polyBasisEquiv, b₀_cast]
        refine Finset.sum_congr rfl fun m' _ => ?_
        rw [map_mul, hpoly₀_red, hb₀_red]
        rfl
      rw [hsum1] at h1
      have h2 : Ξ_k (fun m' => M_g₀ m' i) = g₀ * b₀_cast i := by
        have hrepr : Ξ_k (b_bask.repr (μ_g₀ (b_bask i))) = μ_g₀ (b_bask i) :=
          Ξ_k.apply_symm_apply _
        simpa [M_g₀, LinearMap.toMatrix_apply, hbk_eq, μ_g₀] using hrepr
      have hfn := Ξ_k.injective (h1.trans h2.symm)
      exact congrFun hfn m
    let P_bar_g : Polynomial k := Polynomial.map τ_A.toRingHom P_g
    have hP_bar_g_eq : P_bar_g = M_g₀.det := by
      calc
        P_bar_g = (Polynomial.mapRingHom τ_A.toRingHom) M_g.det := rfl
        _ = ((Polynomial.mapRingHom τ_A.toRingHom).mapMatrix M_g).det := RingHom.map_det _ _
        _ = (M_g.map (Polynomial.mapRingHom τ_A.toRingHom)).det := rfl
        _ = M_g₀.det := by rw [hM_red]
    have hP_bar_g_ne : P_bar_g ≠ 0 := by
      rw [hP_bar_g_eq]
      intro h0
      let K := FractionRing (Polynomial k)
      let M_K : Matrix (Fin D.r) (Fin D.r) K := M_g₀.map (algebraMap (Polynomial k) K)
      have hMK_det : M_K.det = 0 := by
        have hmap : M_K.det = algebraMap (Polynomial k) K M_g₀.det :=
          (RingHom.map_det (algebraMap (Polynomial k) K) M_g₀).symm
        rw [hmap, h0, map_zero]
      have hnot_inj : ¬ Function.Injective M_K.mulVecLin := by
        intro hinj
        have hinj' : Function.Injective M_K.mulVec :=
          fun v₁ v₂ h => hinj (by simpa only [Matrix.mulVecLin_apply] using h)
        have hunit : IsUnit M_K := Matrix.mulVec_injective_iff_isUnit.mp hinj'
        have hdet_u : IsUnit M_K.det := (Matrix.isUnit_iff_isUnit_det M_K).mp hunit
        rw [hMK_det] at hdet_u
        exact not_isUnit_zero hdet_u
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff] at hnot_inj
      push_neg at hnot_inj
      obtain ⟨v, hv_ker, hv_ne⟩ := hnot_inj
      rw [LinearMap.mem_ker] at hv_ker
      obtain ⟨d_nz, hd_int⟩ := IsLocalization.exist_integer_multiples
        (nonZeroDivisors (Polynomial k)) Finset.univ v
      choose w hw using fun j : Fin D.r => hd_int j (Finset.mem_univ j)
      have hw_ne : w ≠ 0 := by
        intro hw0
        apply hv_ne
        funext j
        rw [Pi.zero_apply]
        have hj := hw j
        rw [hw0, Pi.zero_apply, map_zero, Algebra.smul_def] at hj
        have hd_ne : (d_nz : Polynomial k) ≠ 0 := nonZeroDivisors.ne_zero d_nz.2
        have hdK_ne : algebraMap (Polynomial k) K (d_nz : Polynomial k) ≠ 0 := fun h =>
          hd_ne (IsFractionRing.injective (Polynomial k) K (h.trans (map_zero _).symm))
        exact (mul_eq_zero.mp hj.symm).resolve_left hdK_ne
      have hMw : M_g₀.mulVec w = 0 := by
        funext i
        apply IsFractionRing.injective (Polynomial k) K
        rw [Pi.zero_apply, map_zero, Matrix.mulVec, dotProduct, map_sum]
        have hvi : (M_K.mulVec v) i = 0 := congrFun hv_ker i
        rw [Matrix.mulVec, dotProduct] at hvi
        calc
          ∑ j : Fin D.r, algebraMap (Polynomial k) K (M_g₀ i j * w j) =
              algebraMap (Polynomial k) K (d_nz : Polynomial k) * ∑ j : Fin D.r, M_K i j * v j := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun j _ => by
              rw [map_mul, hw j, Algebra.smul_def]; dsimp [M_K]; ring
          _ = 0 := by rw [hvi, mul_zero]
      have hcol_k : ∀ i : Fin D.r,
          (∑ m : Fin D.r, algebraMap (Polynomial k) D₀.R₀ (M_g₀ m i) * b₀_cast m) = g₀ * b₀_cast i := by
        intro i
        have hrepr : Ξ_k (b_bask.repr (μ_g₀ (b_bask i))) = μ_g₀ (b_bask i) := Ξ_k.apply_symm_apply _
        simpa [M_g₀, LinearMap.toMatrix_apply, hbk_eq, μ_g₀, Ξ_k, weilPicSurj_polyBasisEquiv] using hrepr
      have hΞ_mul : Ξ_k (M_g₀.mulVec w) = g₀ * Ξ_k w := by
        dsimp [Ξ_k, weilPicSurj_polyBasisEquiv, Matrix.mulVec, dotProduct]
        simp_rw [map_sum, Finset.sum_mul]
        rw [Finset.sum_comm]
        have hterm : ∀ j : Fin D.r,
            (∑ i : Fin D.r, algebraMap (Polynomial k) D₀.R₀ (M_g₀ i j * w j) * b₀_cast i) =
            algebraMap (Polynomial k) D₀.R₀ (w j) * (g₀ * b₀_cast j) := by
          intro j
          rw [← hcol_k j, Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => by rw [map_mul]; ring
        simp_rw [hterm]
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => by ring
      rw [hMw, map_zero] at hΞ_mul
      exact hw_ne (Ξ_k.injective ((hg₀_reg (Ξ_k w) hΞ_mul.symm).trans (map_zero Ξ_k).symm))
    let N_g : ℕ := P_g.natDegree
    let d_g : ℕ := P_bar_g.natDegree
    have hdN_g : d_g ≤ N_g := Polynomial.natDegree_map_le
    let c₀ : k := P_bar_g.leadingCoeff
    have hc₀_ne : c₀ ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hP_bar_g_ne
    let G₀ : Polynomial k := Polynomial.C c₀⁻¹ * P_bar_g
    let H₀ : Polynomial k := Polynomial.C c₀
    have hG₀_monic : G₀.Monic := by
      dsimp [G₀, c₀]
      rw [mul_comm]
      exact Polynomial.monic_mul_leadingCoeff_inv hP_bar_g_ne
    have hG₀_deg : G₀.natDegree = d_g := Polynomial.natDegree_C_mul (inv_ne_zero hc₀_ne)
    have hGH₀ : P_bar_g = G₀ * H₀ := by
      dsimp [G₀, H₀]
      rw [mul_comm, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hc₀_ne, Polynomial.C_1, one_mul]
    have hCop_GH₀ : IsCoprime G₀ H₀ :=
      ⟨0, Polynomial.C c₀⁻¹, by simp [H₀, ← Polynomial.C_mul, inv_mul_cancel₀ hc₀_ne]⟩
