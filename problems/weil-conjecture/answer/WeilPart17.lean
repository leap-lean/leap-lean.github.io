        have h_alg : TensorProduct.tmul A (b i) (1 : C_ring) =
            TensorProduct.tmul A (1 : B i) (g''.left.appTop.hom a : C_ring) := by
          rw [← ha i]
          change (algebraMap A (B i) a) ⊗ₜ[A] (1 : C_ring) =
