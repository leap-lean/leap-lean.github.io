    intro X
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp X.smallEtaleTopology
      (weilAltLocConstPresheaf X m) (CategoryTheory.forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    intro U R hR s hs
    let s_lc : ∀ {Y : X.Etale} (g : Y ⟶ U), R.arrows g →
        LocallyConstant ↥Y.left (ULift.{u} (ZMod m)) := fun g hg => s g hg
    have hCovU := (hMemEtale X R).mp hR
    choose Yx fx yx hR_fx hEt_fx hyx using hCovU
    let t_fn : ↥U.left → ULift.{u} (ZMod m) := fun x => (s_lc (fx x) (hR_fx x)) (yx x)
    have ht_compat : ∀ {Y : X.Etale} (g : Y ⟶ U) (hg : R.arrows g) (y : ↥Y.left),
        (s_lc g hg) y = t_fn (g.left y) := by
      intro Y g hg y
      let x : ↥U.left := g.left y
      have hg_et : AlgebraicGeometry.Etale g.left := by
        let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
          fun _ _ f => AlgebraicGeometry.Etale f
        have hcomp_et : P_et (g.left ≫ U.hom) := by
          change AlgebraicGeometry.Etale (g.left ≫ U.hom)
          rw [CategoryTheory.MorphismProperty.Over.w g]
          exact Y.prop
        exact CategoryTheory.MorphismProperty.of_postcomp P_et g.left U.hom U.prop hcomp_et
      have : AlgebraicGeometry.Etale g.left := hg_et
      have : AlgebraicGeometry.Etale (fx x).left := hEt_fx x
      have : AlgebraicGeometry.Etale Y.hom := Y.prop
      let P_sch := CategoryTheory.Limits.pullback g.left (fx x).left
      let pr₁ : P_sch ⟶ Y.left := CategoryTheory.Limits.pullback.fst g.left (fx x).left
      let pr₂ : P_sch ⟶ (Yx x).left := CategoryTheory.Limits.pullback.snd g.left (fx x).left
      let P_et : X.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (pr₁ ≫ Y.hom) inferInstance
      let p₁ : P_et ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk pr₁ rfl
      let p₂ : P_et ⟶ Yx x := CategoryTheory.MorphismProperty.Over.homMk pr₂ (by
        change pr₂ ≫ (Yx x).hom = pr₁ ≫ Y.hom
        rw [← CategoryTheory.MorphismProperty.Over.w (fx x), ← CategoryTheory.Category.assoc,
          ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
          CategoryTheory.MorphismProperty.Over.w g])
      have hp12 : p₁ ≫ g = p₂ ≫ fx x :=
        CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
      obtain ⟨z, hz₁, hz₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y (yx x) (hyx x).symm
      have hcomp := hs p₁ p₂ hg (hR_fx x) hp12
      have hcomp_z : (s_lc g hg) (pr₁ z) = (s_lc (fx x) (hR_fx x)) (pr₂ z) :=
        congrArg (fun k : LocallyConstant ↥P_et.left (ULift.{u} (ZMod m)) => k z) hcomp
      rw [hz₁, hz₂] at hcomp_z
      exact hcomp_z
    have ht_lc : IsLocallyConstant t_fn := by
      intro E
      rw [isOpen_iff_forall_mem_open]
      intro x hx
      have : AlgebraicGeometry.Etale (fx x).left := hEt_fx x
      let V_set : Set ↥(Yx x).left := (s_lc (fx x) (hR_fx x)) ⁻¹' E
      have hV_open : IsOpen V_set := (s_lc (fx x) (hR_fx x)).isLocallyConstant E
      refine ⟨⇑(fx x).left '' V_set, ?_, ((fx x).left).isOpenMap V_set hV_open,
        ⟨yx x, hx, hyx x⟩⟩
      rintro x' ⟨y', hy', rfl⟩
      change t_fn ((fx x).left y') ∈ E
      rw [← ht_compat (fx x) (hR_fx x) y']
      exact hy'
    let t : LocallyConstant ↥U.left (ULift.{u} (ZMod m)) := ⟨t_fn, ht_lc⟩
    refine ⟨t, ?_, ?_⟩
    · intro Y g hg
