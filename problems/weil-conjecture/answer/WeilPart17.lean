              rw [← hc1, ← hc2, hIso1, hIso2, haEq]
            have hTopEq := hInj_ν_app Vβ hNonVβ hνEq
            exact Vβ.topIso.commRingCatIsoToRingEquiv.injective hTopEq
          have hIβ_ker : Iβ ≤ RingHom.ker ρβ := by
            rw [Ideal.map_le_iff_le_comap]
            intro Q hQ
            rw [Ideal.mem_comap, RingHom.mem_ker]
            apply hInj_sβ_top
            rw [hPullPoly Q, RingHom.mem_ker.mp hQ, map_zero, map_zero]
          let ρβ_bar_cat : Qβ_cat ⟶ (Vβ : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤) :=
            CommRingCat.ofHom (Ideal.Quotient.lift Iβ ρβ (fun a ha => hIβ_ker ha))
          have hρβ_bar_mk_cat : CommRingCat.ofHom mkβ ≫ ρβ_bar_cat = p₂_β.appTop := by
            ext r_el
            exact congrArg (fun g => g r_el) (Ideal.Quotient.lift_comp_mk Iβ ρβ _)
          let qβ : (Vβ : AlgebraicGeometry.Scheme.{u}) ⟶ Cβ :=
            (Vβ : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫ AlgebraicGeometry.Spec.map ρβ_bar_cat
          have hqβ_ιC : qβ ≫ ι_C = p₂_β := by
            rw [← cancel_mono (D β : AlgebraicGeometry.Scheme.{u}).toSpecΓ]
            have h1 : (qβ ≫ ι_C) ≫ (D β : AlgebraicGeometry.Scheme.{u}).toSpecΓ =
                (Vβ : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
                  AlgebraicGeometry.Spec.map p₂_β.appTop := by
              calc
                (qβ ≫ ι_C) ≫ (D β : AlgebraicGeometry.Scheme.{u}).toSpecΓ
                  = (Vβ : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
                      (AlgebraicGeometry.Spec.map ρβ_bar_cat ≫
                        AlgebraicGeometry.Spec.map (CommRingCat.ofHom mkβ)) ≫
                      (inv (D β : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
                        (D β : AlgebraicGeometry.Scheme.{u}).toSpecΓ) := by
                    dsimp only [qβ, ι_C]
                    simp only [Category.assoc]
                _ = (Vβ : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
                      AlgebraicGeometry.Spec.map (CommRingCat.ofHom mkβ ≫ ρβ_bar_cat) := by
                    rw [IsIso.inv_hom_id, Category.comp_id, ← AlgebraicGeometry.Spec.map_comp]
                _ = (Vβ : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
                      AlgebraicGeometry.Spec.map p₂_β.appTop := by
                    rw [hρβ_bar_mk_cat]
            have h2 : p₂_β ≫ (D β : AlgebraicGeometry.Scheme.{u}).toSpecΓ =
                (Vβ : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
                  AlgebraicGeometry.Spec.map p₂_β.appTop := by
              symm
              have h0 := toSpecΓ_SpecMap_of_hom (p₂_β ≫ (D β : AlgebraicGeometry.Scheme.{u}).toSpecΓ)
              rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
                AlgebraicGeometry.Scheme.toSpecΓ_appTop, ← Category.assoc,
                Iso.inv_hom_id, Category.id_comp] at h0
              exact h0
            exact h1.trans h2.symm
          have hqβ_ψβ : Vβ.ι ≫ π₀.left = qβ ≫ ψβ := by
            apply AlgebraicGeometry.ext_of_isDominant sβ
            have hLHS : sβ ≫ (Vβ.ι ≫ π₀.left) = u_mor ≫ (U j).ι := by
              rw [← Category.assoc, hsβ_fac, Category.assoc, hν_π₀, hu_mor_fac]
            have hRHS : sβ ≫ (qβ ≫ ψβ) = (sβ ≫ qβ ≫ ψβ_U) ≫ (U j).ι := by
              dsimp only [ψβ]
              simp only [Category.assoc]
            rw [hLHS, hRHS]
            congr 1
            rw [← cancel_mono (U j : AlgebraicGeometry.Scheme.{u}).toSpecΓ]
            apply hom_ext_Spec
            have hU1 : (AlgebraicGeometry.Scheme.ΓSpecIso Aj_cat).inv ≫
                (u_mor ≫ (U j : AlgebraicGeometry.Scheme.{u}).toSpecΓ).appTop = u_mor.appTop := by
              rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, AlgebraicGeometry.Scheme.toSpecΓ_appTop,
                ← Category.assoc, Iso.inv_hom_id, Category.id_comp]
            have hU2 : (AlgebraicGeometry.Scheme.ΓSpecIso Aj_cat).inv ≫
                ((sβ ≫ qβ ≫ ψβ_U) ≫ (U j : AlgebraicGeometry.Scheme.{u}).toSpecΓ).appTop =
                CommRingCat.ofHom θβ ≫ ρβ_bar_cat ≫ sβ.appTop := by
              have hCancelU : (sβ ≫ qβ ≫ ψβ_U) ≫ (U j : AlgebraicGeometry.Scheme.{u}).toSpecΓ =
                  sβ ≫ ((Vβ : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom θβ ≫ ρβ_bar_cat)) := by
                calc
                  (sβ ≫ qβ ≫ ψβ_U) ≫ (U j : AlgebraicGeometry.Scheme.{u}).toSpecΓ
                    = sβ ≫ ((Vβ : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
                        (AlgebraicGeometry.Spec.map ρβ_bar_cat ≫
                          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θβ)) ≫
                        (inv (U j : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
                          (U j : AlgebraicGeometry.Scheme.{u}).toSpecΓ)) := by
                      dsimp only [ψβ_U, qβ]
                      simp only [Category.assoc]
                  _ = sβ ≫ ((Vβ : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
                        AlgebraicGeometry.Spec.map (CommRingCat.ofHom θβ ≫ ρβ_bar_cat)) := by
                      rw [IsIso.inv_hom_id, Category.comp_id, ← AlgebraicGeometry.Spec.map_comp]
              have hSpecV := specHom_toSpecΓ_SpecMap (Y := (Vβ : AlgebraicGeometry.Scheme.{u}))
                (CommRingCat.ofHom θβ ≫ ρβ_bar_cat)
              rw [hCancelU, AlgebraicGeometry.Scheme.Hom.comp_appTop, ← Category.assoc]
              erw [hSpecV]
              rw [Category.assoc]
            rw [hU1, hU2]
            ext a
            obtain ⟨Q, rfl⟩ := hSurj_σj a
            change u_mor.appTop.hom (σj Q) = sβ.appTop.hom (ρβ_bar_cat.hom (θβ (σj Q)))
            have hθQ : θβ (σj Q) = mkβ (τβ Q) := congrArg (fun g => g Q) hθβ_σj
            have hρQ : ρβ_bar_cat.hom (mkβ (τβ Q)) = ρβ (τβ Q) :=
              congrArg (fun g => g.hom (τβ Q)) hρβ_bar_mk_cat
            rw [hθQ, hρQ, hPullPoly Q]
          let Z := CategoryTheory.Limits.pullback X.hom P.hom
          let sndZ := CategoryTheory.Limits.pullback.snd X.hom P.hom
          let ι_V₀ : V₀.left ⟶ Z :=
            CategoryTheory.Limits.pullback.lift π₀.left p₂.left (by rw [π₀.w, p₂.w])
          have : AlgebraicGeometry.IsClosedImmersion ι_V₀ := hCl_lift
          let W_Z : Z.Opens := sndZ ⁻¹ᵁ D β
          let Ψ_tilde : Cβ ⟶ Z :=
            CategoryTheory.Limits.pullback.lift ψβ (ι_C ≫ (D β).ι) hψβ_hom
          have hRange_Ψ : Set.range Ψ_tilde.base ⊆ Set.range W_Z.ι.base := by
            rintro _ ⟨x, rfl⟩
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            change (Ψ_tilde ≫ sndZ).base x ∈ D β
            rw [CategoryTheory.Limits.pullback.lift_snd]
            exact (ι_C.base x).2
          let Ψβ : Cβ ⟶ (W_Z : AlgebraicGeometry.Scheme.{u}) :=
            AlgebraicGeometry.IsOpenImmersion.lift W_Z.ι Ψ_tilde hRange_Ψ
          have hΨβ_fac : Ψβ ≫ W_Z.ι = Ψ_tilde :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac W_Z.ι Ψ_tilde hRange_Ψ
          have hΨβ_snd : Ψβ ≫ (sndZ ∣_ D β) = ι_C := by
            rw [← cancel_mono (D β).ι, Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
              ← Category.assoc, hΨβ_fac]
            exact CategoryTheory.Limits.pullback.lift_snd _ _ _
          have : AlgebraicGeometry.IsSeparated (Ψβ ≫ (sndZ ∣_ D β)) := by
            rw [hΨβ_snd]; infer_instance
          have : AlgebraicGeometry.IsSeparated Ψβ :=
            AlgebraicGeometry.IsSeparated.of_comp Ψβ (sndZ ∣_ D β)
          let V'_Z : V₀.left.Opens := ι_V₀ ⁻¹ᵁ W_Z
          have hEq_VZ : Vβ = V'_Z := by
            ext x
            change p₂.left.base x ∈ D β ↔ (ι_V₀ ≫ sndZ).base x ∈ D β
            rw [CategoryTheory.Limits.pullback.lift_snd]
          have hR1 : Set.range Vβ.ι.base ⊆ Set.range V'_Z.ι.base := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι, AlgebraicGeometry.Scheme.Opens.range_ι, hEq_VZ]
          have hR2 : Set.range V'_Z.ι.base ⊆ Set.range Vβ.ι.base := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι, AlgebraicGeometry.Scheme.Opens.range_ι, hEq_VZ]
          let e₁ : (Vβ : AlgebraicGeometry.Scheme.{u}) ⟶ (V'_Z : AlgebraicGeometry.Scheme.{u}) :=
            AlgebraicGeometry.IsOpenImmersion.lift V'_Z.ι Vβ.ι hR1
          let e₂ : (V'_Z : AlgebraicGeometry.Scheme.{u}) ⟶ (Vβ : AlgebraicGeometry.Scheme.{u}) :=
            AlgebraicGeometry.IsOpenImmersion.lift Vβ.ι V'_Z.ι hR2
          have he₁_fac : e₁ ≫ V'_Z.ι = Vβ.ι :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac V'_Z.ι Vβ.ι hR1
          have he₂_fac : e₂ ≫ Vβ.ι = V'_Z.ι :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac Vβ.ι V'_Z.ι hR2
          have he₁_e₂ : e₁ ≫ e₂ = 𝟙 _ := by
            rw [← cancel_mono Vβ.ι, Category.assoc, he₂_fac, he₁_fac, Category.id_comp]
          have he₂_e₁ : e₂ ≫ e₁ = 𝟙 _ := by
            rw [← cancel_mono V'_Z.ι, Category.assoc, he₁_fac, he₂_fac, Category.id_comp]
          have : CategoryTheory.IsIso e₁ := ⟨⟨e₂, he₁_e₂, he₂_e₁⟩⟩
          have hqβ_Ψβ : qβ ≫ Ψβ = e₁ ≫ (ι_V₀ ∣_ W_Z) := by
            have hEqZ : (qβ ≫ Ψβ) ≫ W_Z.ι = (e₁ ≫ (ι_V₀ ∣_ W_Z)) ≫ W_Z.ι := by
              rw [Category.assoc qβ, hΨβ_fac, Category.assoc e₁,
                AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc e₁, he₁_fac]
              apply CategoryTheory.Limits.pullback.hom_ext
              · rw [Category.assoc qβ, CategoryTheory.Limits.pullback.lift_fst,
                  Category.assoc Vβ.ι, CategoryTheory.Limits.pullback.lift_fst, hqβ_ψβ]
              · rw [Category.assoc qβ, CategoryTheory.Limits.pullback.lift_snd,
                  Category.assoc Vβ.ι, CategoryTheory.Limits.pullback.lift_snd,
                  ← Category.assoc qβ, hqβ_ιC, AlgebraicGeometry.morphismRestrict_ι]
            exact (cancel_mono W_Z.ι).mp hEqZ
          have : AlgebraicGeometry.IsClosedImmersion (qβ ≫ Ψβ) := by
            rw [hqβ_Ψβ]; infer_instance
          have : AlgebraicGeometry.IsClosedImmersion qβ :=
            AlgebraicGeometry.IsClosedImmersion.of_comp qβ Ψβ
          
          have hRS1 : Set.range V'_S.ι.base ⊆ Set.range Vβ.ι.base := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι, AlgebraicGeometry.Scheme.Opens.range_ι, hEq_VS]
          have hRS2 : Set.range Vβ.ι.base ⊆ Set.range V'_S.ι.base := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι, AlgebraicGeometry.Scheme.Opens.range_ι, hEq_VS]
          let e_VS : (V'_S : AlgebraicGeometry.Scheme.{u}) ⟶ (Vβ : AlgebraicGeometry.Scheme.{u}) :=
            AlgebraicGeometry.IsOpenImmersion.lift Vβ.ι V'_S.ι hRS1
          let e_SV : (Vβ : AlgebraicGeometry.Scheme.{u}) ⟶ (V'_S : AlgebraicGeometry.Scheme.{u}) :=
            AlgebraicGeometry.IsOpenImmersion.lift V'_S.ι Vβ.ι hRS2
          have he_VS_fac : e_VS ≫ Vβ.ι = V'_S.ι :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac Vβ.ι V'_S.ι hRS1
          have he_SV_fac : e_SV ≫ V'_S.ι = Vβ.ι :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac V'_S.ι Vβ.ι hRS2
          have he_VS_SV : e_VS ≫ e_SV = 𝟙 _ := by
            rw [← cancel_mono V'_S.ι, Category.assoc, he_SV_fac, he_VS_fac, Category.id_comp]
          have he_SV_VS : e_SV ≫ e_VS = 𝟙 _ := by
            rw [← cancel_mono Vβ.ι, Category.assoc, he_VS_fac, he_SV_fac, Category.id_comp]
          have : CategoryTheory.IsIso e_VS := ⟨⟨e_SV, he_VS_SV, he_SV_VS⟩⟩
          have hlam_comm : (ψβ ≫ f.left) ≫ S.hom = (ι_C ≫ (D β).ι) ≫ P.hom := by
            rw [Category.assoc, CategoryTheory.Over.w f, hψβ_hom]
          let lamβ : Cβ ⟶ P_S :=
            CategoryTheory.Limits.pullback.lift (ψβ ≫ f.left) (ι_C ≫ (D β).ι) hlam_comm
          have hRange_lam : Set.range lamβ.base ⊆ Set.range D_S.ι.base := by
            rintro _ ⟨c, rfl⟩
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            change (lamβ ≫ snd_S).base c ∈ D β
            rw [CategoryTheory.Limits.pullback.lift_snd]
            exact (ι_C.base c).2
          let ι_tilde_C : Cβ ⟶ (D_S : AlgebraicGeometry.Scheme.{u}) :=
            AlgebraicGeometry.IsOpenImmersion.lift D_S.ι lamβ hRange_lam
          have hι_tilde_fac : ι_tilde_C ≫ D_S.ι = lamβ :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac D_S.ι lamβ hRange_lam
          have hι_tilde_snd : ι_tilde_C ≫ (snd_S ∣_ D β) = ι_C := by
            rw [← cancel_mono (D β).ι, Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
              ← Category.assoc, hι_tilde_fac]
            exact CategoryTheory.Limits.pullback.lift_snd _ _ _
          have : AlgebraicGeometry.IsClosedImmersion (ι_tilde_C ≫ (snd_S ∣_ D β)) := by
            rw [hι_tilde_snd]; infer_instance
          have : AlgebraicGeometry.IsSeparated snd_S := by dsimp [snd_S]; infer_instance
          have : AlgebraicGeometry.IsSeparated (snd_S ∣_ D β) := inferInstance
          have : AlgebraicGeometry.IsClosedImmersion ι_tilde_C :=
            AlgebraicGeometry.IsClosedImmersion.of_comp ι_tilde_C (snd_S ∣_ D β)
          have hRestrictEq : ι_S ∣_ D_S = e_VS ≫ qβ ≫ ι_tilde_C := by
            rw [← cancel_mono D_S.ι, AlgebraicGeometry.morphismRestrict_ι,
              Category.assoc, Category.assoc, hι_tilde_fac]
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [Category.assoc, hιS_fst, Category.assoc, Category.assoc,
                CategoryTheory.Limits.pullback.lift_fst, ← he_VS_fac,
                Category.assoc e_VS, ← Category.assoc Vβ.ι, hqβ_ψβ, Category.assoc]
            · rw [Category.assoc, hιS_snd, Category.assoc, Category.assoc,
                CategoryTheory.Limits.pullback.lift_snd, ← he_VS_fac,
                Category.assoc e_VS, ← AlgebraicGeometry.morphismRestrict_ι p₂.left (D β),
                ← Category.assoc qβ, hqβ_ιC]
          rw [hRestrictEq]
          infer_instance
    exact ⟨V₀, π₀, U₀, N, ι_S, hIntV₀, hProp_π₀, hSurj_π₀, hU₀, hIso_U₀, step4, hιS_fst⟩

theorem weil_affine_integral_etale_shrinking_and_domain_cover (Z : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine Z]
    (hIntZ : AlgebraicGeometry.IsIntegral Z) :
    (∀ (U : Z.Opens) (_ : Nonempty U)
        (V : AlgebraicGeometry.Scheme.{u})
        (p : V ⟶ (U : AlgebraicGeometry.Scheme.{u})),
      AlgebraicGeometry.IsFinite p →
      AlgebraicGeometry.Etale p →
      AlgebraicGeometry.Surjective p →
      ∃ (U₁ : Z.Opens) (_ : Nonempty U₁)
        (V₁ : AlgebraicGeometry.Scheme.{u})
        (p₁ : V₁ ⟶ (U₁ : AlgebraicGeometry.Scheme.{u}))
        (ι₁ : V₁ ⟶ V),
        AlgebraicGeometry.IsIntegral V₁ ∧
        AlgebraicGeometry.IsFinite p₁ ∧
        AlgebraicGeometry.Etale p₁ ∧
        AlgebraicGeometry.Surjective p₁ ∧
        AlgebraicGeometry.Etale ι₁ ∧
        ι₁ ≫ p ≫ U.ι = p₁ ≫ U₁.ι) ∧
    (∀ (U₀ : Z.Opens) (_ : Nonempty U₀)
        (W : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsAffine W]
        (_ : Nonempty W)
        (w : W ⟶ (U₀ : AlgebraicGeometry.Scheme.{u})),
      AlgebraicGeometry.Etale w →
      ∃ (U₁ : Z.Opens) (_ : Nonempty U₁)
        (W₁ : AlgebraicGeometry.Scheme.{u})
        (jW : W₁ ⟶ W)
        (p₁ : W₁ ⟶ (U₁ : AlgebraicGeometry.Scheme.{u})),
        AlgebraicGeometry.IsOpenImmersion jW ∧
        AlgebraicGeometry.IsFinite p₁ ∧
        AlgebraicGeometry.Etale p₁ ∧
        AlgebraicGeometry.Surjective p₁ ∧
        jW ≫ w ≫ U₀.ι = p₁ ≫ U₁.ι) :=
by
  classical
  
  have h_s1 : ∀ (R₀ S₀ : Type u) [CommRing R₀] [IsDomain R₀] [CommRing S₀] [Nontrivial S₀]
      [Algebra R₀ S₀] [Module.Finite R₀ S₀] [Algebra.Etale R₀ S₀],
      ∃ (b : R₀) (_ : b ≠ 0) (e : Localization.Away (algebraMap R₀ S₀ b)),
        IsDomain (Localization.Away e) ∧
        ∀ (R₁ : Type u) [CommRing R₁] [Algebra R₀ R₁] [IsLocalization.Away b R₁],
          ∃ (φ₁ : R₁ →+* Localization.Away e),
            φ₁.Finite ∧
            φ₁.comp (algebraMap R₀ R₁) =
              (algebraMap (Localization.Away (algebraMap R₀ S₀ b)) (Localization.Away e)).comp
                ((algebraMap S₀ (Localization.Away (algebraMap R₀ S₀ b))).comp (algebraMap R₀ S₀)) := by
    intro R₀ S₀ _ _ _ _ _ _ _
    let K₀ := FractionRing R₀
    let τ₀ : S₀ →ₐ[R₀] TensorProduct R₀ K₀ S₀ := Algebra.TensorProduct.includeRight
    have hτ₀_inj : Function.Injective τ₀ := by
      let f_frac : R₀ →ₗ[R₀] K₀ := Algebra.linearMap R₀ K₀
      have hf_inj : Function.Injective f_frac := IsFractionRing.injective R₀ K₀
      have hr_inj : Function.Injective (LinearMap.rTensor S₀ f_frac) :=
        Module.Flat.rTensor_preserves_injective_linearMap f_frac hf_inj
      intro x y hxy
      apply (TensorProduct.lid R₀ S₀).symm.injective
      apply hr_inj
      have h_eq : ∀ s : S₀,
          LinearMap.rTensor S₀ f_frac ((TensorProduct.lid R₀ S₀).symm s) = τ₀ s := by
        intro s
        simp [f_frac, τ₀]
      rw [h_eq, h_eq]
      exact hxy
    have _ : Nontrivial (TensorProduct R₀ K₀ S₀) :=
      ⟨⟨0, 1, fun h01 => zero_ne_one (hτ₀_inj (by simpa using h01))⟩⟩
    obtain ⟨I, _, L, hFieldL, hAlgL, Φ, _⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K₀ (TensorProduct R₀ K₀ S₀)).mp inferInstance
    letI : ∀ i, Field (L i) := hFieldL
    letI : ∀ i, Algebra K₀ (L i) := hAlgL
    have _ : Nontrivial ((i : I) → L i) := Φ.symm.toRingEquiv.toRingHom.domain_nontrivial
    have hNeI : Nonempty I := by
      by_contra hEmpty
      rw [not_nonempty_iff] at hEmpty
      exact not_subsingleton ((i : I) → L i) inferInstance
    obtain ⟨i₀⟩ := hNeI
    let v₀ : (i : I) → L i := fun i => if i = i₀ then 1 else 0
    let e_K : TensorProduct R₀ K₀ S₀ := Φ.symm v₀
    let ψ_K : TensorProduct R₀ K₀ S₀ →+* L i₀ :=
      (Pi.evalRingHom L i₀).comp Φ.toRingEquiv.toRingHom
    have hv₀_idem : v₀ * v₀ = v₀ := by
      funext i
      change (if i = i₀ then (1 : L i) else 0) * (if i = i₀ then 1 else 0) =
        if i = i₀ then 1 else 0
      split_ifs <;> simp
    have heK_idem : e_K * e_K = e_K := by
      dsimp [e_K]
      rw [← map_mul, hv₀_idem]
    have hψK_eK : ψ_K e_K = 1 := by
      change Φ (Φ.symm v₀) i₀ = 1
      rw [AlgEquiv.apply_symm_apply]
      simp [v₀]
    have hψK_ker : ∀ z : TensorProduct R₀ K₀ S₀, ψ_K z = 0 → e_K * z = 0 := by
      intro z hz
      apply Φ.injective
      rw [map_zero, map_mul]
      have hΦe : Φ e_K = v₀ := Φ.apply_symm_apply v₀
      rw [hΦe]
      funext i
      change (if i = i₀ then (1 : L i) else 0) * Φ z i = 0
      split_ifs with hi
      · subst i
        exact mul_eq_zero_of_right _ hz
      · exact zero_mul _
    have hClear : ∀ z : TensorProduct R₀ K₀ S₀,
        ∃ (b : R₀) (_ : b ≠ 0) (s : S₀), b • z = τ₀ s := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨1, one_ne_zero, 0, by simp⟩
      | tmul k s₀ =>
        obtain ⟨⟨a, b_sub⟩, hk⟩ := IsLocalization.surj (nonZeroDivisors R₀) k
        have hb0 : (b_sub : R₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b_sub.2
        refine ⟨(b_sub : R₀), hb0, a • s₀, ?_⟩
        calc
          (b_sub : R₀) • (k ⊗ₜ[R₀] s₀) = ((b_sub : R₀) • k) ⊗ₜ[R₀] s₀ :=
            TensorProduct.smul_tmul' _ _ _
          _ = (k * algebraMap R₀ K₀ (b_sub : R₀)) ⊗ₜ[R₀] s₀ := by
            rw [Algebra.smul_def, mul_comm]
          _ = (algebraMap R₀ K₀ a) ⊗ₜ[R₀] s₀ := by rw [hk]
          _ = (a • (1 : K₀)) ⊗ₜ[R₀] s₀ := by rw [Algebra.algebraMap_eq_smul_one]
          _ = (1 : K₀) ⊗ₜ[R₀] (a • s₀) := TensorProduct.smul_tmul _ _ _
          _ = τ₀ (a • s₀) := rfl
      | add z₁ z₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨b₁, hb₁, s₁, hz₁⟩
        rcases ih₂ with ⟨b₂, hb₂, s₂, hz₂⟩
        refine ⟨b₁ * b₂, mul_ne_zero hb₁ hb₂, b₂ • s₁ + b₁ • s₂, ?_⟩
        rw [smul_add, mul_comm b₁ b₂, mul_smul b₂ b₁ z₁, hz₁, mul_comm b₂ b₁,
          mul_smul b₁ b₂ z₂, hz₂, map_add, map_smul, map_smul]
    obtain ⟨b, hb, s_e, hs_e⟩ := hClear e_K
    let b_S : S₀ := algebraMap R₀ S₀ b
    let S'₁ := Localization.Away b_S
    have hbK : IsUnit (algebraMap R₀ K₀ b) :=
      IsUnit.mk0 _ (fun h => hb (IsFractionRing.injective R₀ K₀ (h.trans (map_zero _).symm)))
    have hu_b : IsUnit (τ₀.toRingHom b_S) := by
      change IsUnit (τ₀ (algebraMap R₀ S₀ b))
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R₀ K₀ (TensorProduct R₀ K₀ S₀)]
      exact hbK.map (algebraMap K₀ (TensorProduct R₀ K₀ S₀))
    let τ'₁ : S'₁ →+* TensorProduct R₀ K₀ S₀ := IsLocalization.Away.lift b_S hu_b
    have hτ'₁_eq : ∀ s : S₀, τ'₁ (algebraMap S₀ S'₁ s) = τ₀ s :=
      IsLocalization.Away.lift_eq b_S hu_b
    have hτ'₁_inj : Function.Injective τ'₁ := by
      rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_bot_iff_eq_zero]
      intro y hy
      obtain ⟨⟨s, m⟩, hym⟩ := IsLocalization.surj (Submonoid.powers b_S) y
      have hτs : τ₀ s = 0 := by
        rw [← hτ'₁_eq, ← hym, map_mul, hy, zero_mul]
      have hs0 : s = 0 := hτ₀_inj (hτs.trans (map_zero τ₀).symm)
      rw [hs0, map_zero] at hym
      exact (IsLocalization.map_units S'₁ m).mul_left_eq_zero.mp hym
    let e : S'₁ := algebraMap S₀ S'₁ s_e * IsLocalization.Away.invSelf b_S
    have hτb_eK : e_K * τ₀ b_S = τ₀ s_e := by
      rw [mul_comm]
      calc
        τ₀ b_S * e_K = algebraMap R₀ (TensorProduct R₀ K₀ S₀) b * e_K := by
          rw [AlgHom.commutes]
        _ = b • e_K := (Algebra.smul_def b e_K).symm
        _ = τ₀ s_e := hs_e
    have hτ'₁_e : τ'₁ e = e_K := by
      apply hu_b.mul_right_cancel
      change τ'₁ e * τ₀ b_S = e_K * τ₀ b_S
      rw [hτb_eK, ← hτ'₁_eq b_S, ← map_mul]
      dsimp [e]
      rw [mul_assoc, mul_comm (IsLocalization.Away.invSelf b_S), IsLocalization.Away.mul_invSelf,
        mul_one, hτ'₁_eq]
    have he_idem : e * e = e :=
      hτ'₁_inj (by rw [map_mul, hτ'₁_e, heK_idem])
    let S₁ := Localization.Away e
    let α_e : S'₁ →+* S₁ := algebraMap S'₁ S₁
    have hu_e : IsUnit (α_e e) :=
      IsLocalization.map_units S₁ (⟨e, Submonoid.mem_powers e⟩ : Submonoid.powers e)
    have hα_e_one : α_e e = 1 :=
      hu_e.mul_right_cancel (by rw [← map_mul, he_idem, one_mul])
    have hSurj_α : Function.Surjective α_e := by
      intro w
      obtain ⟨⟨x, ⟨_, n, rfl⟩⟩, hw⟩ := IsLocalization.surj (Submonoid.powers e) w
      refine ⟨x, ?_⟩
      have he_pow : α_e (e ^ n) = 1 := by rw [map_pow, hα_e_one, one_pow]
      rw [he_pow, mul_one] at hw
      exact hw.symm
    let ψ'₁ : S'₁ →+* L i₀ := ψ_K.comp τ'₁
    have hu_ψ : IsUnit (ψ'₁ e) := by
      change IsUnit (ψ_K (τ'₁ e))
      rw [hτ'₁_e, hψK_eK]
      exact isUnit_one
    let θ : S₁ →+* L i₀ := IsLocalization.Away.lift e hu_ψ
    have hθ_inj : Function.Injective θ := by
      rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_bot_iff_eq_zero]
      intro w hw
      obtain ⟨x, rfl⟩ := hSurj_α w
      have hex_eq : α_e (e * x) = α_e x := by rw [map_mul, hα_e_one, one_mul]
      rw [← hex_eq] at hw ⊢
      have hψ_ex : ψ_K (τ'₁ (e * x)) = 0 := by
        have hlift : θ (α_e (e * x)) = ψ'₁ (e * x) := IsLocalization.Away.lift_eq e hu_ψ (e * x)
        exact hlift.symm.trans hw
      have heK_ex : e_K * τ'₁ (e * x) = 0 := hψK_ker _ hψ_ex
      have hτ_ex : τ'₁ (e * x) = 0 := by
        rw [← hτ'₁_e, ← map_mul, ← mul_assoc, he_idem] at heK_ex
        exact heK_ex
      have hex0 : e * x = 0 := hτ'₁_inj (hτ_ex.trans (map_zero τ'₁).symm)
      rw [hex0, map_zero]
    have hDomS₁ : IsDomain S₁ := Function.Injective.isDomain θ hθ_inj
    refine ⟨b, hb, e, hDomS₁, ?_⟩
    intro R₁ _ _ _
    let ψ'₀ : R₀ →+* S'₁ := (algebraMap S₀ S'₁).comp (algebraMap R₀ S₀)
    have hu_b' : IsUnit (ψ'₀ b) :=
      IsLocalization.map_units S'₁ (⟨b_S, Submonoid.mem_powers b_S⟩ : Submonoid.powers b_S)
    let φ'₁ : R₁ →+* S'₁ := IsLocalization.Away.lift b (S := R₁) hu_b'
    have hφ'₁_eq : ∀ r : R₀, φ'₁ (algebraMap R₀ R₁ r) = ψ'₀ r :=
      IsLocalization.Away.lift_eq b (S := R₁) hu_b'
    let φ₁ : R₁ →+* S₁ := α_e.comp φ'₁
    refine ⟨φ₁, ?_, ?_⟩
    · letI : Algebra R₁ S₁ := φ₁.toAlgebra
      change (algebraMap R₁ S₁).Finite
      rw [RingHom.finite_algebraMap]
      let ψ₀ : R₀ →+* S₁ := α_e.comp ψ'₀
      let ψ_S : S₀ →+* S₁ := α_e.comp (algebraMap S₀ S'₁)
      have hφ₁_eq : ∀ r : R₀, φ₁ (algebraMap R₀ R₁ r) = ψ₀ r := fun r => by
        change α_e (φ'₁ (algebraMap R₀ R₁ r)) = α_e (ψ'₀ r)
        rw [hφ'₁_eq r]
      obtain ⟨F, hF⟩ := Module.Finite.fg_top (R := R₀) (M := S₀)
      let F₁ : Finset S₁ := F.image ψ_S
      have hSpan₁ : Submodule.span R₁ (F₁ : Set S₁) = ⊤ := by
        rw [eq_top_iff]
        intro w _
        obtain ⟨y, rfl⟩ := hSurj_α w
        let N : Submodule R₀ S₀ :=
          { carrier := { s : S₀ | ψ_S s ∈ Submodule.span R₁ (F₁ : Set S₁) }
            zero_mem' := by simp
            add_mem' := fun ha hb => by simpa [map_add] using add_mem ha hb
            smul_mem' := fun r s hs => by
              change ψ_S (r • s) ∈ Submodule.span R₁ (F₁ : Set S₁)
              rw [Algebra.smul_def, map_mul]
              change ψ₀ r * ψ_S s ∈ Submodule.span R₁ (F₁ : Set S₁)
              rw [← hφ₁_eq r]
              exact Submodule.smul_mem _ (algebraMap R₀ R₁ r) hs }
        have hN : Submodule.span R₀ (F : Set S₀) ≤ N :=
          Submodule.span_le.mpr (fun s hs => Submodule.subset_span (Finset.mem_image_of_mem _ hs))
        obtain ⟨⟨s, ⟨_, n, rfl⟩⟩, hy⟩ := IsLocalization.surj (Submonoid.powers b_S) y
        have hs_mem : ψ_S s ∈ Submodule.span R₁ (F₁ : Set S₁) :=
          hN (hF ▸ Submodule.mem_top)
        let u_inv : R₁ := IsLocalization.Away.invSelf (R := R₀) (S := R₁) b
        have hu_mul : ψ_S b_S * φ₁ u_inv = 1 := by
          change ψ₀ b * φ₁ u_inv = 1
          rw [← hφ₁_eq b, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
        have hy_S₁ : α_e y * ψ_S (b_S ^ n) = ψ_S s := by
          change α_e y * α_e (algebraMap S₀ S'₁ (b_S ^ n)) = α_e (algebraMap S₀ S'₁ s)
          rw [← map_mul, hy]
        have hw_eq : α_e y = (u_inv ^ n) • ψ_S s := by
          change α_e y = φ₁ (u_inv ^ n) * ψ_S s
          rw [mul_comm (φ₁ _), ← hy_S₁, mul_assoc, map_pow, map_pow, ← mul_pow, hu_mul,
            one_pow, mul_one]
        rw [hw_eq]
        exact Submodule.smul_mem _ _ hs_mem
      exact Module.Finite.of_fg_top ⟨F₁, hSpan₁⟩
    · ext r
      change α_e (φ'₁ (algebraMap R₀ R₁ r)) = _
      rw [hφ'₁_eq r]
      rfl

  
  have h_s2 : ∀ (R₀ S₀ : Type u) [CommRing R₀] [IsDomain R₀] [CommRing S₀] [Nontrivial S₀]
      [Algebra R₀ S₀] [Algebra.Etale R₀ S₀],
      ∃ (f : R₀) (_ : f ≠ 0),
        Nontrivial (Localization.Away (algebraMap R₀ S₀ f)) ∧
        ∀ (R₁ : Type u) [CommRing R₁] [Algebra R₀ R₁] [IsLocalization.Away f R₁],
          ∃ (φ₁ : R₁ →+* Localization.Away (algebraMap R₀ S₀ f)),
            φ₁.Finite ∧
            φ₁.comp (algebraMap R₀ R₁) =
              (algebraMap S₀ (Localization.Away (algebraMap R₀ S₀ f))).comp (algebraMap R₀ S₀) := by
    intro R₀ S₀ _ _ _ _ _ _
    let K₀ := FractionRing R₀
    let τ₀ : S₀ →ₐ[R₀] TensorProduct R₀ K₀ S₀ := Algebra.TensorProduct.includeRight
    have hτ₀_inj : Function.Injective τ₀ := by
      let f_frac : R₀ →ₗ[R₀] K₀ := Algebra.linearMap R₀ K₀
      have hf_inj : Function.Injective f_frac := IsFractionRing.injective R₀ K₀
      have hr_inj : Function.Injective (LinearMap.rTensor S₀ f_frac) :=
        Module.Flat.rTensor_preserves_injective_linearMap f_frac hf_inj
      intro x y hxy
      apply (TensorProduct.lid R₀ S₀).symm.injective
      apply hr_inj
      have h_eq : ∀ s : S₀,
          LinearMap.rTensor S₀ f_frac ((TensorProduct.lid R₀ S₀).symm s) = τ₀ s := by
        intro s
        simp [f_frac, τ₀]
      rw [h_eq, h_eq]
      exact hxy
    have _ : Nontrivial (TensorProduct R₀ K₀ S₀) :=
      ⟨⟨0, 1, fun h01 => zero_ne_one (hτ₀_inj (by simpa using h01))⟩⟩
    obtain ⟨I, hFinI, L, hFieldL, hAlgL, Φ, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K₀ (TensorProduct R₀ K₀ S₀)).mp inferInstance
    have _ : Finite I := hFinI
    letI : Fintype I := Fintype.ofFinite I
    letI : ∀ i, Field (L i) := hFieldL
    letI : ∀ i, Algebra K₀ (L i) := hAlgL
    have _ : ∀ i, Module.Finite K₀ (L i) := fun i => (hFinSep i).1
    have _ : Module.Finite K₀ (TensorProduct R₀ K₀ S₀) :=
      Module.Finite.equiv Φ.symm.toLinearEquiv
    have _ : Algebra.IsIntegral K₀ (TensorProduct R₀ K₀ S₀) :=
      Algebra.IsIntegral.of_finite K₀ (TensorProduct R₀ K₀ S₀)
    obtain ⟨G, hG⟩ := Algebra.FiniteType.out (R := R₀) (A := S₀)
    have hMult : ∀ g : S₀, ∃ m : nonZeroDivisors R₀, IsIntegral R₀ ((m : R₀) • g) := by
      intro g
      have hIntK : IsIntegral K₀ (τ₀ g) := Algebra.IsIntegral.isIntegral (τ₀ g)
      obtain ⟨m, hm⟩ :=
        IsIntegral.exists_multiple_integral_of_isLocalization (nonZeroDivisors R₀) (τ₀ g) hIntK
      refine ⟨m, ?_⟩
      have hm' : IsIntegral R₀ (τ₀ ((m : R₀) • g)) := by
        rw [map_smul]
        exact hm
      exact (isIntegral_algHom_iff τ₀ hτ₀_inj).mp hm'
    choose m hm using hMult
    let f : R₀ := ∏ g ∈ G, (m g : R₀)
    have hf : f ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr (fun g _ => mem_nonZeroDivisors_iff_ne_zero.mp (m g).2)
    let f_S : S₀ := algebraMap R₀ S₀ f
    let S₁ := Localization.Away f_S
    have hfK : IsUnit (algebraMap R₀ K₀ f) :=
      IsUnit.mk0 _ (fun h => hf (IsFractionRing.injective R₀ K₀ (h.trans (map_zero _).symm)))
    have hu_f : IsUnit (τ₀.toRingHom f_S) := by
      change IsUnit (τ₀ (algebraMap R₀ S₀ f))
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R₀ K₀ (TensorProduct R₀ K₀ S₀)]
      exact hfK.map (algebraMap K₀ (TensorProduct R₀ K₀ S₀))
    let τ₁ : S₁ →+* TensorProduct R₀ K₀ S₀ := IsLocalization.Away.lift f_S hu_f
    have hNontrivS₁ : Nontrivial S₁ := τ₁.domain_nontrivial
    refine ⟨f, hf, hNontrivS₁, ?_⟩
    intro R₁ _ _ _
    let ψ₀ : R₀ →+* S₁ := (algebraMap S₀ S₁).comp (algebraMap R₀ S₀)
    have hu_f₁ : IsUnit (ψ₀ f) :=
      IsLocalization.map_units S₁ (⟨f_S, Submonoid.mem_powers f_S⟩ : Submonoid.powers f_S)
    let φ₁ : R₁ →+* S₁ := IsLocalization.Away.lift f (S := R₁) hu_f₁
    have hφ₁_eq : ∀ r : R₀, φ₁ (algebraMap R₀ R₁ r) = ψ₀ r :=
      IsLocalization.Away.lift_eq f (S := R₁) hu_f₁
    refine ⟨φ₁, ?_, ?_⟩
    · letI : Algebra R₁ S₁ := φ₁.toAlgebra
      change (algebraMap R₁ S₁).Finite
      rw [RingHom.finite_algebraMap]
      let G₁ : Finset S₁ := G.image (algebraMap S₀ S₁)
      let u_inv : R₁ := IsLocalization.Away.invSelf (R := R₀) (S := R₁) f
      have hu_mul : algebraMap S₀ S₁ f_S * φ₁ u_inv = 1 := by
        change ψ₀ f * φ₁ u_inv = 1
        rw [← hφ₁_eq f, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
      have hAdjoin : Algebra.adjoin R₁ (G₁ : Set S₁) = ⊤ := by
        rw [eq_top_iff]
        intro y _
        let A₀ : Subalgebra R₀ S₀ :=
          { carrier := { s : S₀ | algebraMap S₀ S₁ s ∈ Algebra.adjoin R₁ (G₁ : Set S₁) }
            mul_mem' := fun ha hb => by simpa [map_mul] using mul_mem ha hb
            one_mem' := by simp
            add_mem' := fun ha hb => by simpa [map_add] using add_mem ha hb
            zero_mem' := by simp
            algebraMap_mem' := fun r => by
              change ψ₀ r ∈ Algebra.adjoin R₁ (G₁ : Set S₁)
              rw [← hφ₁_eq r]
              exact (Algebra.adjoin R₁ (G₁ : Set S₁)).algebraMap_mem (algebraMap R₀ R₁ r) }
        have hA₀ : Algebra.adjoin R₀ (G : Set S₀) ≤ A₀ :=
          Algebra.adjoin_le_iff.mpr
            (fun g hg => Algebra.subset_adjoin (Finset.mem_image_of_mem _ hg))
        obtain ⟨⟨s, ⟨_, n, rfl⟩⟩, hy⟩ := IsLocalization.surj (Submonoid.powers f_S) y
        have hs_mem : algebraMap S₀ S₁ s ∈ Algebra.adjoin R₁ (G₁ : Set S₁) :=
          hA₀ (hG ▸ Algebra.mem_top)
        have hy_eq : y = algebraMap R₁ S₁ (u_inv ^ n) * algebraMap S₀ S₁ s := by
          change y = φ₁ (u_inv ^ n) * algebraMap S₀ S₁ s
          rw [mul_comm (φ₁ _), ← hy, mul_assoc, map_pow, map_pow, ← mul_pow, hu_mul,
            one_pow, mul_one]
        rw [hy_eq]
        exact mul_mem ((Algebra.adjoin R₁ (G₁ : Set S₁)).algebraMap_mem (u_inv ^ n)) hs_mem
      have _ : Algebra.FiniteType R₁ S₁ := ⟨⟨G₁, hAdjoin⟩⟩
      have hMapInt : ∀ x : S₀, IsIntegral R₀ x → IsIntegral R₁ (algebraMap S₀ S₁ x) := by
        rintro x ⟨P, hP_monic, hP_eval⟩
        refine ⟨P.map (algebraMap R₀ R₁), hP_monic.map (algebraMap R₀ R₁), ?_⟩
        change Polynomial.eval₂ φ₁ (algebraMap S₀ S₁ x) (P.map (algebraMap R₀ R₁)) = 0
        rw [Polynomial.eval₂_map]
        have hcomp : φ₁.comp (algebraMap R₀ R₁) = ψ₀ := RingHom.ext hφ₁_eq
        rw [hcomp, ← Polynomial.hom_eval₂, hP_eval, map_zero]
      have hG₁_int : (G₁ : Set S₁) ⊆ integralClosure R₁ S₁ := by
        intro z hz
        obtain ⟨g, hgG, rfl⟩ := Finset.mem_image.mp hz
        obtain ⟨c, hf_eq⟩ := Finset.dvd_prod_of_mem (fun x => (m x : R₀)) hgG
        have hfg_int₀ : IsIntegral R₀ (f • g) := by
          have hsmul : f • g = c • ((m g : R₀) • g) := by
            dsimp only [f]
            rw [hf_eq, mul_comm, mul_smul]
          rw [hsmul]
          exact (hm g).smul c
        have hfg_int₁ : IsIntegral R₁ (algebraMap S₀ S₁ (f • g)) := hMapInt (f • g) hfg_int₀
        have hu_int₁ : IsIntegral R₁ (φ₁ u_inv) := isIntegral_algebraMap
        have hprod_int : IsIntegral R₁ (φ₁ u_inv * algebraMap S₀ S₁ (f • g)) :=
          hu_int₁.mul hfg_int₁
        have hprod_eq : φ₁ u_inv * algebraMap S₀ S₁ (f • g) = algebraMap S₀ S₁ g := by
          rw [Algebra.smul_def, map_mul, ← mul_assoc, mul_comm (φ₁ u_inv), hu_mul, one_mul]
        rw [hprod_eq] at hprod_int
        exact hprod_int
      have hTop_le : (⊤ : Subalgebra R₁ S₁) ≤ integralClosure R₁ S₁ := by
        rw [← hAdjoin, Algebra.adjoin_le_iff]
        exact hG₁_int
      have _ : Algebra.IsIntegral R₁ S₁ := ⟨fun y => hTop_le Algebra.mem_top⟩
      exact Algebra.IsIntegral.finite
    · ext r
      exact hφ₁_eq r

  
  have h_s3 : ∀ (U' : Z.Opens) (hAffU' : AlgebraicGeometry.IsAffineOpen U') (_ : Nonempty U')
      (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine Y]
      (q : Y ⟶ (U' : AlgebraicGeometry.Scheme.{u}))
      (_ : AlgebraicGeometry.Etale q)
      (φ₀ : Z.presheaf.obj (Opposite.op U') ⟶ Y.presheaf.obj (Opposite.op ⊤))
      (_ : Y.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ₀ = q ≫ hAffU'.isoSpec.hom)
      (b : ↑(Z.presheaf.obj (Opposite.op U'))) (_ : b ≠ 0)
      (S₁ : Type u) [CommRing S₁] [Nontrivial S₁]
      (ψ_S : ↑(Y.presheaf.obj (Opposite.op ⊤)) →+* S₁)
      (_ : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S)))
      (φ₁ : ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen b))) →+* S₁)
      (_ : φ₁.Finite)
      (_ : φ₁.comp (algebraMap ↑(Z.presheaf.obj (Opposite.op U'))
            ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen b)))) = ψ_S.comp φ₀.hom),
      Nonempty (Z.basicOpen b) ∧
      ∃ (jY : AlgebraicGeometry.Spec (CommRingCat.of S₁) ⟶ Y)
        (p₁ : AlgebraicGeometry.Spec (CommRingCat.of S₁) ⟶
          (Z.basicOpen b : AlgebraicGeometry.Scheme.{u})),
        AlgebraicGeometry.IsOpenImmersion jY ∧
        AlgebraicGeometry.IsFinite p₁ ∧
        AlgebraicGeometry.Etale p₁ ∧
        AlgebraicGeometry.Surjective p₁ ∧
        jY ≫ q ≫ U'.ι = p₁ ≫ (Z.basicOpen b).ι := by
    intro U' hAffU' hNeU' Y _ q hEt_q φ₀ hφ₀ b hb S₁ _ _ ψ_S hOpenΨ φ₁ hFinΦ₁ hCommΦ₁
    have _ : AlgebraicGeometry.IsIntegral Z := hIntZ
    have _ : Nonempty ↥(U' : AlgebraicGeometry.Scheme.{u}) := hNeU'
    have _ : IsDomain ↑(Z.presheaf.obj (Opposite.op U')) :=
      AlgebraicGeometry.IsIntegral.component_integral U'
    let U₁ : Z.Opens := Z.basicOpen b
    have hAffU₁ : AlgebraicGeometry.IsAffineOpen U₁ := hAffU'.basicOpen b
    have _ := hAffU'.isLocalization_basicOpen b
    have hNontrivR₁ : Nontrivial ↑(Z.presheaf.obj (Opposite.op U₁)) := by
      refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
      have h01' :
          algebraMap ↑(Z.presheaf.obj (Opposite.op U')) ↑(Z.presheaf.obj (Opposite.op U₁)) 0 =
            algebraMap ↑(Z.presheaf.obj (Opposite.op U')) ↑(Z.presheaf.obj (Opposite.op U₁)) 1 := by
        rw [map_zero, map_one]
        exact h01
      obtain ⟨⟨_, n, rfl⟩, hbn⟩ :=
        (IsLocalization.eq_iff_exists (Submonoid.powers b)
          ↑(Z.presheaf.obj (Opposite.op U₁))).mp h01'
      simp only [mul_zero, mul_one] at hbn
      exact pow_ne_zero n hb hbn.symm
    have hNeSpec₁ : Nonempty ↥(AlgebraicGeometry.Spec (Z.presheaf.obj (Opposite.op U₁))) :=
      @PrimeSpectrum.instNonemptyOfNontrivial _ _ hNontrivR₁
    obtain ⟨z_spec⟩ := hNeSpec₁
    have hNeU₁ : Nonempty U₁ := ⟨hAffU₁.isoSpec.inv.base z_spec⟩
    have _ : Nonempty ↥(U₁ : AlgebraicGeometry.Scheme.{u}) := hNeU₁
    have hIntU₁ : AlgebraicGeometry.IsIntegral (U₁ : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion U₁.ι
    have _ : IrreducibleSpace ↥(U₁ : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral (U₁ : AlgebraicGeometry.Scheme.{u})
    let X₁ := AlgebraicGeometry.Spec (CommRingCat.of S₁)
    have _ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S)) := hOpenΨ
    let jY : X₁ ⟶ Y := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S) ≫ Y.isoSpec.inv
    have hOpen_jY : AlgebraicGeometry.IsOpenImmersion jY := inferInstance
    have _ : AlgebraicGeometry.IsFinite
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)) :=
      (AlgebraicGeometry.IsFinite.SpecMap_iff (CommRingCat.ofHom φ₁)).mpr hFinΦ₁
    let p₁ : X₁ ⟶ (U₁ : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ hAffU₁.isoSpec.inv
    have hFin_p₁ : AlgebraicGeometry.IsFinite p₁ := inferInstance
    have hSub₁ : U₁ ≤ U' := Z.basicOpen_le b
    let ρ_b := Z.presheaf.map (CategoryTheory.homOfLE hSub₁).op
    have hRingComm : ρ_b ≫ CommRingCat.ofHom φ₁ = φ₀ ≫ CommRingCat.ofHom ψ_S := by
      ext x
      exact RingHom.congr_fun hCommΦ₁ x
    have hSpecComm :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ AlgebraicGeometry.Spec.map ρ_b =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S) ≫ AlgebraicGeometry.Spec.map φ₀ := by
      rw [← AlgebraicGeometry.Spec.map_comp, hRingComm, AlgebraicGeometry.Spec.map_comp]
    have hOpenNat :
        hAffU₁.isoSpec.hom ≫ AlgebraicGeometry.Spec.map ρ_b =
          Z.homOfLE hSub₁ ≫ hAffU'.isoSpec.hom := by
      rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom, AlgebraicGeometry.IsAffineOpen.isoSpec_hom]
      exact AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map U₁ U' hSub₁
    have hSqU' : p₁ ≫ Z.homOfLE hSub₁ = jY ≫ q := by
      apply (cancel_mono hAffU'.isoSpec.hom).mp
      calc
        (p₁ ≫ Z.homOfLE hSub₁) ≫ hAffU'.isoSpec.hom
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ hAffU₁.isoSpec.inv ≫
                (Z.homOfLE hSub₁ ≫ hAffU'.isoSpec.hom) := by
              simp only [p₁, Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ hAffU₁.isoSpec.inv ≫
              hAffU₁.isoSpec.hom ≫ AlgebraicGeometry.Spec.map ρ_b := by
              rw [← hOpenNat]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫
              AlgebraicGeometry.Spec.map ρ_b := by
              rw [Iso.inv_hom_id_assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S) ≫
              AlgebraicGeometry.Spec.map φ₀ := hSpecComm
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S) ≫ Y.isoSpec.inv ≫
              (Y.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ₀) := by
              rw [Iso.inv_hom_id_assoc]
        _ = (jY ≫ q) ≫ hAffU'.isoSpec.hom := by
              rw [hφ₀]
              simp only [jY, Category.assoc]
    have hComm : jY ≫ q ≫ U'.ι = p₁ ≫ U₁.ι := by
      rw [← Category.assoc, ← hSqU', Category.assoc, Z.homOfLE_ι hSub₁]
    have _ : AlgebraicGeometry.Etale q := hEt_q
    have hEt_comp : AlgebraicGeometry.Etale (p₁ ≫ U₁.ι) := by
      rw [← hComm]
      infer_instance
    have hEt_p₁ : AlgebraicGeometry.Etale p₁ :=
      CategoryTheory.MorphismProperty.of_postcomp
        (@AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
        p₁ U₁.ι inferInstance hEt_comp
    have _ : Nonempty ↥X₁ := @PrimeSpectrum.instNonemptyOfNontrivial S₁ _ _
    have hClopen : IsClopen (Set.range p₁.base) :=
      ⟨p₁.isClosedMap.isClosed_range, p₁.isOpenMap.isOpen_range⟩
    have hRangeUniv : Set.range p₁.base = Set.univ :=
      hClopen.eq_univ (Set.range_nonempty p₁.base)
    have hSurj_p₁ : AlgebraicGeometry.Surjective p₁ :=
      AlgebraicGeometry.Surjective.mk (Set.range_eq_univ.mp hRangeUniv)
    exact ⟨hNeU₁, jY, p₁, hOpen_jY, hFin_p₁, hEt_p₁, hSurj_p₁, hComm⟩

  
  refine ⟨?_, ?_⟩
  · 
    intro U hU V p hFin hEt hSurj
    have _ := hFin
    have _ := hEt
    have _ := hSurj
    have _ := hIntZ
    obtain ⟨⟨x₀, hx₀⟩⟩ := hU
    obtain ⟨_, ⟨h₀, rfl⟩, hx₀', hSub⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (AlgebraicGeometry.isBasis_basicOpen Z)) hx₀
    let U' : Z.Opens := Z.basicOpen h₀
    have hAffU' : AlgebraicGeometry.IsAffineOpen U' :=
      (AlgebraicGeometry.isAffineOpen_top Z).basicOpen h₀
    have _ : AlgebraicGeometry.IsAffine (U' : AlgebraicGeometry.Scheme.{u}) := hAffU'
    have hNeU' : Nonempty U' := ⟨⟨x₀, hx₀'⟩⟩
    have _ : Nonempty ↥(U' : AlgebraicGeometry.Scheme.{u}) := hNeU'
    let Y := CategoryTheory.Limits.pullback p (Z.homOfLE hSub)
    let π_V : Y ⟶ V := CategoryTheory.Limits.pullback.fst p (Z.homOfLE hSub)
    let q : Y ⟶ (U' : AlgebraicGeometry.Scheme.{u}) :=
      CategoryTheory.Limits.pullback.snd p (Z.homOfLE hSub)
    have _ : AlgebraicGeometry.IsAffine Y := AlgebraicGeometry.isAffine_of_isAffineHom q
    obtain ⟨y₀, _⟩ := q.surjective ⟨x₀, hx₀'⟩
    let R₀ := ↑(Z.presheaf.obj (Opposite.op U'))
    have _ : IsDomain R₀ := AlgebraicGeometry.IsIntegral.component_integral U'
    let S₀ := ↑(Y.presheaf.obj (Opposite.op ⊤))
    have _ : Nontrivial S₀ := by
      let z₀ := Y.isoSpec.hom.base y₀
      refine ⟨⟨0, 1, fun h01 => z₀.isPrime.ne_top ?_⟩⟩
      exact Ideal.eq_top_of_isUnit_mem _ (h01 ▸ z₀.asIdeal.zero_mem) isUnit_one
    let φ₀ : Z.presheaf.obj (Opposite.op U') ⟶ Y.presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Spec.fullyFaithful.preimage
        (Y.isoSpec.inv ≫ q ≫ hAffU'.isoSpec.hom)).unop
    have hSpec_φ₀ : AlgebraicGeometry.Spec.map φ₀ = Y.isoSpec.inv ≫ q ≫ hAffU'.isoSpec.hom :=
      AlgebraicGeometry.Spec.fullyFaithful.map_preimage _
    have hφ₀ : Y.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ₀ = q ≫ hAffU'.isoSpec.hom := by
      rw [hSpec_φ₀, Iso.hom_inv_id_assoc]
    have hEt_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ₀) := by
      rw [hSpec_φ₀]
      infer_instance
    have hFin_spec : AlgebraicGeometry.IsFinite (AlgebraicGeometry.Spec.map φ₀) := by
      rw [hSpec_φ₀]
      infer_instance
    letI : Algebra R₀ S₀ := φ₀.hom.toAlgebra
    have _ : Algebra.Etale R₀ S₀ :=
      RingHom.etale_algebraMap.mp
        ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          hEt_spec)
    have _ : Module.Finite R₀ S₀ :=
      RingHom.finite_algebraMap.mp ((AlgebraicGeometry.IsFinite.SpecMap_iff φ₀).mp hFin_spec)
    obtain ⟨b, hb, e, hDomS₁, hLift⟩ := h_s1 R₀ S₀
    have _ := hAffU'.isLocalization_basicOpen b
    obtain ⟨φ₁, hFinΦ₁, hCommΦ₁⟩ :=
      hLift ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen b)))
    let S'₁ := Localization.Away (algebraMap R₀ S₀ b)
    let S₁ := Localization.Away e
    have _ : IsDomain S₁ := hDomS₁
    let ψ_S : S₀ →+* S₁ := (algebraMap S'₁ S₁).comp (algebraMap S₀ S'₁)
    have hOpenΨ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S)) := by
      have hcomp_hom : CommRingCat.ofHom ψ_S =
          CommRingCat.ofHom (algebraMap S₀ S'₁) ≫ CommRingCat.ofHom (algebraMap S'₁ S₁) :=
        CommRingCat.ofHom_comp (algebraMap S₀ S'₁) (algebraMap S'₁ S₁)
      rw [hcomp_hom, AlgebraicGeometry.Spec.map_comp]
      have _ : AlgebraicGeometry.IsOpenImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₀ S'₁))) :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization (algebraMap R₀ S₀ b)
      have _ : AlgebraicGeometry.IsOpenImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S'₁ S₁))) :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization e
      infer_instance
    have hCommΦ₁' : φ₁.comp (algebraMap ↑(Z.presheaf.obj (Opposite.op U'))
          ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen b)))) = ψ_S.comp φ₀.hom := by
      ext x
      exact RingHom.congr_fun hCommΦ₁ x
    obtain ⟨hNeU₁, jY, p₁, hOpen_jY, hFin_p₁, hEt_p₁, hSurj_p₁, hSq⟩ :=
      h_s3 U' hAffU' hNeU' Y q inferInstance φ₀ hφ₀ b hb S₁ ψ_S hOpenΨ φ₁ hFinΦ₁ hCommΦ₁'
    have _ : AlgebraicGeometry.IsOpenImmersion jY := hOpen_jY
    let V₁ := AlgebraicGeometry.Spec (CommRingCat.of S₁)
    let ι₁ : V₁ ⟶ V := jY ≫ π_V
    refine ⟨Z.basicOpen b, hNeU₁, V₁, p₁, ι₁, inferInstance, hFin_p₁, hEt_p₁, hSurj_p₁,
      inferInstance, ?_⟩
    calc
      ι₁ ≫ p ≫ U.ι = jY ≫ (π_V ≫ p) ≫ U.ι := by simp only [ι₁, Category.assoc]
      _ = jY ≫ (q ≫ Z.homOfLE hSub) ≫ U.ι := by rw [CategoryTheory.Limits.pullback.condition]
      _ = jY ≫ q ≫ (Z.homOfLE hSub ≫ U.ι) := by simp only [Category.assoc]
      _ = jY ≫ q ≫ U'.ι := by rw [Z.homOfLE_ι hSub]
      _ = p₁ ≫ (Z.basicOpen b).ι := hSq
  · 
    intro U₀ _ W _ hW w hEt_w
    have _ := hEt_w
    have _ := hIntZ
    obtain ⟨y₀⟩ := hW
    let f : W ⟶ Z := w ≫ U₀.ι
    have hx₀ : f.base y₀ ∈ U₀ := (w.base y₀).2
    obtain ⟨_, ⟨h₀, rfl⟩, hx₀', hSub⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (AlgebraicGeometry.isBasis_basicOpen Z)) hx₀
    let U' : Z.Opens := Z.basicOpen h₀
    have hAffU' : AlgebraicGeometry.IsAffineOpen U' :=
      (AlgebraicGeometry.isAffineOpen_top Z).basicOpen h₀
    have hNeU' : Nonempty U' := ⟨⟨f.base y₀, hx₀'⟩⟩
    have _ : Nonempty ↥(U' : AlgebraicGeometry.Scheme.{u}) := hNeU'
    let W' : W.Opens := f ⁻¹ᵁ U'
    have hAffW' : AlgebraicGeometry.IsAffineOpen W' := by
      have hW'_eq : W' = W.basicOpen (f.appTop h₀) := f.preimage_basicOpen h₀
      rw [hW'_eq]
      exact (AlgebraicGeometry.isAffineOpen_top W).basicOpen (f.appTop h₀)
    let Y : AlgebraicGeometry.Scheme.{u} := (W' : AlgebraicGeometry.Scheme.{u})
    have _ : AlgebraicGeometry.IsAffine Y := hAffW'
    let π_W : Y ⟶ W := W'.ι
    let q : Y ⟶ (U' : AlgebraicGeometry.Scheme.{u}) := f ∣_ U'
    let y' : Y := ⟨y₀, hx₀'⟩
    let R₀ := ↑(Z.presheaf.obj (Opposite.op U'))
    have _ : IsDomain R₀ := AlgebraicGeometry.IsIntegral.component_integral U'
    let S₀ := ↑(Y.presheaf.obj (Opposite.op ⊤))
    have _ : Nontrivial S₀ := by
      let z₀ := Y.isoSpec.hom.base y'
      refine ⟨⟨0, 1, fun h01 => z₀.isPrime.ne_top ?_⟩⟩
      exact Ideal.eq_top_of_isUnit_mem _ (h01 ▸ z₀.asIdeal.zero_mem) isUnit_one
    let φ₀ : Z.presheaf.obj (Opposite.op U') ⟶ Y.presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Spec.fullyFaithful.preimage
        (Y.isoSpec.inv ≫ q ≫ hAffU'.isoSpec.hom)).unop
    have hSpec_φ₀ : AlgebraicGeometry.Spec.map φ₀ = Y.isoSpec.inv ≫ q ≫ hAffU'.isoSpec.hom :=
      AlgebraicGeometry.Spec.fullyFaithful.map_preimage _
    have hφ₀ : Y.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ₀ = q ≫ hAffU'.isoSpec.hom := by
      rw [hSpec_φ₀, Iso.hom_inv_id_assoc]
    have hEt_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ₀) := by
      rw [hSpec_φ₀]
      infer_instance
    letI : Algebra R₀ S₀ := φ₀.hom.toAlgebra
    have _ : Algebra.Etale R₀ S₀ :=
      RingHom.etale_algebraMap.mp
        ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          hEt_spec)
    obtain ⟨b, hb, hNontrivS₁, hLift⟩ := h_s2 R₀ S₀
    have _ := hAffU'.isLocalization_basicOpen b
    obtain ⟨φ₁, hFinΦ₁, hCommΦ₁⟩ :=
      hLift ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen b)))
    let S₁ := Localization.Away (algebraMap R₀ S₀ b)
    have _ : Nontrivial S₁ := hNontrivS₁
    let ψ_S : S₀ →+* S₁ := algebraMap S₀ S₁
    have hOpenΨ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S)) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (algebraMap R₀ S₀ b)
    obtain ⟨hNeU₁, jY, p₁, hOpen_jY, hFin_p₁, hEt_p₁, hSurj_p₁, hSq⟩ :=
      h_s3 U' hAffU' hNeU' Y q inferInstance φ₀ hφ₀ b hb S₁ ψ_S hOpenΨ φ₁ hFinΦ₁ hCommΦ₁
    have _ : AlgebraicGeometry.IsOpenImmersion jY := hOpen_jY
    let W₁ := AlgebraicGeometry.Spec (CommRingCat.of S₁)
    let jW : W₁ ⟶ W := jY ≫ π_W
    refine ⟨Z.basicOpen b, hNeU₁, W₁, jW, p₁, inferInstance, hFin_p₁, hEt_p₁, hSurj_p₁, ?_⟩
    calc
      jW ≫ w ≫ U₀.ι = jY ≫ (π_W ≫ f) := by simp only [jW, f, Category.assoc]
      _ = jY ≫ (q ≫ U'.ι) := by rw [(AlgebraicGeometry.morphismRestrict_ι f U').symm]
      _ = p₁ ≫ (Z.basicOpen b).ι := hSq

theorem weil_integrallyClosed_noetherian_etale_away_isDomain (B C : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B] [IsNoetherianRing B]
    [CommRing C] [Algebra B C] [Algebra.Etale B C]
    (q : Ideal C) [q.IsPrime] :
    ∃ f : C, f ∉ q ∧ IsDomain (Localization.Away f) :=
by
  classical
  
  have hFlatTorsionFree : ∀ {A M : Type u} [CommRing A] [IsDomain A]
      [AddCommGroup M] [Module A M] [Module.Flat A M] {a : A}, a ≠ 0 →
      ∀ {m : M}, a • m = 0 → m = 0 := by
    intro A M _ _ _ _ _ a ha m hm
    have hmul_inj : Function.Injective (LinearMap.mulLeft A a) := fun x y hxy =>
      mul_left_cancel₀ ha hxy
    have hlT_inj : Function.Injective (LinearMap.lTensor M (LinearMap.mulLeft A a)) :=
      Module.Flat.lTensor_preserves_injective_linearMap (LinearMap.mulLeft A a) hmul_inj
    have htmul_zero : (m ⊗ₜ[A] (1 : A)) = 0 := by
      apply hlT_inj
      rw [map_zero, LinearMap.lTensor_tmul]
      change m ⊗ₜ[A] (a * 1) = 0
      have ha1 : a * (1 : A) = a • (1 : A) := by rw [smul_eq_mul]
      rw [ha1, ← TensorProduct.smul_tmul, hm, TensorProduct.zero_tmul]
    simpa using congrArg (TensorProduct.rid A M) htmul_zero
  
  have hSpanSmulTop : ∀ {A M : Type u} [CommRing A] [AddCommGroup M] [Module A M]
      (r : A) (x : M), x ∈ Ideal.span ({r} : Set A) • (⊤ : Submodule A M) →
      ∃ y : M, x = r • y := by
    intro A M _ _ _ r x hx
    let f_r : M →ₗ[A] M :=
      { toFun := fun m => r • m
        map_add' := smul_add r
        map_smul' := fun a m => by simp only [RingHom.id_apply, smul_comm r a m] }
    have hle : Ideal.span ({r} : Set A) • (⊤ : Submodule A M) ≤ LinearMap.range f_r := by
      rw [Submodule.smul_le]
      intro a ha m _
      rw [Ideal.mem_span_singleton] at ha
      rcases ha with ⟨t, rfl⟩
      exact ⟨t • m, (mul_smul r t m).symm⟩
    rcases hle hx with ⟨y, hy⟩
    exact ⟨y, hy.symm⟩
  
  have hDvrEtaleDiv : ∀ (R C' : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      [CommRing C'] [Algebra R C'] [Algebra.Etale R C']
      (b : R), b ≠ 0 → ∀ (c : C'), c * c = b • c → ∃ y : C', c = b • y := by
    intro R C' _ _ _ _ _ _ b hb c hc
    have : Module.Flat R C' := inferInstance
    let m : Ideal R := IsLocalRing.maximalIdeal R
    let κ := R ⧸ m
    let : Field κ := Ideal.Quotient.field m
    let A_κ := TensorProduct R κ C'
    have : Algebra.Etale κ A_κ := Algebra.Etale.baseChange R C' κ
    obtain ⟨J, hFinJ, Fj, hFieldFj, hAlgFj, e_κ, _⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod κ A_κ).mp inferInstance
    let : ∀ j : J, Field (Fj j) := hFieldFj
    let : ∀ j : J, Algebra κ (Fj j) := hAlgFj
    have hRed : ∀ z : A_κ, z * z = 0 → z = 0 := by
      intro z hz
      refine e_κ.injective ?_
      rw [map_zero]
      ext j
      have hj : (e_κ z j) * (e_κ z j) = 0 := by
        change (e_κ z * e_κ z) j = 0
        rw [← map_mul, hz, map_zero]
        rfl
      exact mul_self_eq_zero.mp hj
    obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have hπ_ne : π ≠ 0 := hπ.ne_zero
    have hm_eq : m = Ideal.span ({π} : Set R) := hπ.maximalIdeal_eq
    have hPow : ∀ (n : ℕ) (x : C'), x * x = (π ^ n) • x → ∃ y : C', x = (π ^ n) • y := by
      intro n
      induction n with
      | zero =>
        intro x _
        exact ⟨x, by rw [pow_zero, one_smul]⟩
      | succ n ih =>
        intro x hx
        let ι_κ : C' →ₐ[R] A_κ := Algebra.TensorProduct.includeRight
        have hπ_κ : algebraMap R κ π = 0 := by
          change Ideal.Quotient.mk m π = 0
          rw [Ideal.Quotient.eq_zero_iff_mem, hm_eq]
          exact Ideal.mem_span_singleton_self π
        have hπ_Aκ : algebraMap R A_κ (π ^ (n + 1)) = 0 := by
          rw [map_pow]
          have h1 : algebraMap R A_κ π = (algebraMap R κ π) ⊗ₜ[R] (1 : C') := rfl
          rw [h1, hπ_κ, TensorProduct.zero_tmul, zero_pow (Nat.succ_ne_zero n)]
        have hsq_z : (ι_κ x) * (ι_κ x) = 0 := by
          rw [← map_mul, hx, Algebra.smul_def, map_mul, ι_κ.commutes, hπ_Aκ, zero_mul]
        have hι_zero : ι_κ x = 0 := hRed (ι_κ x) hsq_z
        have hq0 := congrArg (TensorProduct.quotTensorEquivQuotSMul C' m) hι_zero
        rw [map_zero] at hq0
        change (TensorProduct.quotTensorEquivQuotSMul C' m)
          ((Ideal.Quotient.mk m 1) ⊗ₜ[R] x) = 0 at hq0
        rw [TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul,
          Submodule.Quotient.mk_eq_zero, hm_eq] at hq0
        obtain ⟨x₁, rfl⟩ := hSpanSmulTop π x hq0
        have hπ2_eq : (π ^ 2) • (x₁ * x₁ - (π ^ n) • x₁) = 0 := by
          rw [smul_sub]
          have lhs : (π ^ 2) • (x₁ * x₁) = (π • x₁) * (π • x₁) := by
            rw [smul_mul_smul_comm, sq]
          have rhs : (π ^ 2) • ((π ^ n) • x₁) = (π ^ (n + 1)) • (π • x₁) := by
            rw [← mul_smul, ← mul_smul]
            congr 1
            ring
          rw [lhs, rhs, hx, sub_self]
        have hx₁_sq : x₁ * x₁ = (π ^ n) • x₁ :=
          sub_eq_zero.mp (hFlatTorsionFree (pow_ne_zero 2 hπ_ne) hπ2_eq)
        obtain ⟨y, rfl⟩ := ih x₁ hx₁_sq
        exact ⟨y, by rw [← mul_smul, ← pow_succ']⟩
    obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.associated_pow_irreducible hb hπ
    have huc_sq : ((u : R) • c) * ((u : R) • c) = (π ^ n) • ((u : R) • c) := by
      rw [smul_mul_smul_comm, hc, ← mul_smul, ← mul_smul]
      congr 1
      calc
        ((u : R) * (u : R)) * b = (b * (u : R)) * (u : R) := by ring
        _ = (π ^ n) * (u : R) := by rw [hu]
    obtain ⟨y, hy⟩ := hPow n ((u : R) • c) huc_sq
    refine ⟨y, ?_⟩
    calc
      c = ((↑u⁻¹ : R) * (u : R)) • c := by rw [Units.inv_mul, one_smul]
      _ = (↑u⁻¹ : R) • ((u : R) • c) := mul_smul _ _ _
      _ = (↑u⁻¹ : R) • ((π ^ n) • y) := by rw [hy]
      _ = ((↑u⁻¹ : R) * (π ^ n)) • y := (mul_smul _ _ _).symm
      _ = b • y := by
        congr 1
        calc
          (↑u⁻¹ : R) * (π ^ n) = (↑u⁻¹ : R) * (b * (u : R)) := by rw [← hu]
          _ = b * ((↑u⁻¹ : R) * (u : R)) := by ring
          _ = b := by rw [Units.inv_mul, mul_one]
  
  have hQuadDivB : ∀ (b₀ : B), b₀ ≠ 0 → ∀ (c₀ : C), c₀ * c₀ = b₀ • c₀ →
      ∃ d : C, c₀ = b₀ • d := by
    intro b₀ hb₀ c₀ hc₀
    have : Module.Flat B C := inferInstance
    let I₀ : Ideal B := Ideal.span ({b₀} : Set B)
    let M := B ⧸ I₀
    have : Module.Finite B M :=
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ B I₀).toLinearMap Ideal.Quotient.mk_surjective
    let S : Set (Ideal B) := associatedPrimes B M
    have hS_fin : S.Finite := associatedPrimes.finite B M
    have : Finite ↥S := hS_fin
    let : Fintype ↥S := Fintype.ofFinite ↥S
    have hPrimeS : ∀ i : ↥S, i.1.IsPrime := fun i => i.2.isPrime
    let R_loc : ↥S → Type u := fun i => Localization.AtPrime i.1
    let J_loc : ∀ i : ↥S, Ideal (R_loc i) :=
      fun i => Ideal.span ({algebraMap B (R_loc i) b₀} : Set (R_loc i))
    let g_loc : ∀ i : ↥S, B →ₗ[B] (R_loc i ⧸ J_loc i) := fun i =>
      (Ideal.Quotient.mkₐ B (J_loc i)).toLinearMap.comp (Algebra.linearMap B (R_loc i))
    let G_loc : B →ₗ[B] ∀ i : ↥S, (R_loc i ⧸ J_loc i) := LinearMap.pi g_loc
    have hI₀_ker : I₀ ≤ LinearMap.ker G_loc := by
      intro x hx
      rw [Ideal.mem_span_singleton] at hx
      rcases hx with ⟨t, rfl⟩
      rw [LinearMap.mem_ker]
      ext i
      change Ideal.Quotient.mk (J_loc i) (algebraMap B (R_loc i) (b₀ * t)) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, map_mul]
      exact Ideal.mul_mem_right _ (J_loc i) (Ideal.mem_span_singleton_self _)
    let α : M →ₗ[B] ∀ i : ↥S, (R_loc i ⧸ J_loc i) := I₀.liftQ G_loc hI₀_ker
    have hInj_α : Function.Injective α := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro xbar hxbar
      rw [LinearMap.mem_ker] at hxbar
      by_contra hx_ne
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective xbar
      obtain ⟨p₀, hp₀_ass, hp₀_le⟩ :=
        exists_le_isAssociatedPrime_of_isNoetherianRing B (Ideal.Quotient.mk I₀ x) hx_ne
      let i₀ : ↥S := ⟨p₀, hp₀_ass⟩
      have hi₀ : α (Ideal.Quotient.mk I₀ x) i₀ = 0 := congrFun hxbar i₀
      change Ideal.Quotient.mk (J_loc i₀) (algebraMap B (R_loc i₀) x) = 0 at hi₀
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hi₀
      rcases hi₀ with ⟨u, hu⟩
      obtain ⟨⟨a, s⟩, hus⟩ := IsLocalization.surj i₀.1.primeCompl u
      dsimp only at hus
      have hsub_nzd : i₀.1.primeCompl ≤ nonZeroDivisors B :=
        Ideal.primeCompl_le_nonZeroDivisors i₀.1
      have hinj_loc : Function.Injective (algebraMap B (R_loc i₀)) :=
        IsLocalization.injective (R_loc i₀) hsub_nzd
      have hsx_eq : (s : B) * x = b₀ * a := by
        apply hinj_loc
        calc
          algebraMap B (R_loc i₀) ((s : B) * x)
              = algebraMap B (R_loc i₀) (s : B) * (algebraMap B (R_loc i₀) b₀ * u) := by
                rw [map_mul, hu]
          _ = algebraMap B (R_loc i₀) b₀ * (u * algebraMap B (R_loc i₀) (s : B)) := by ring
          _ = algebraMap B (R_loc i₀) (b₀ * a) := by rw [hus, map_mul]
      have hs_colon : (s : B) ∈ (⊥ : Submodule B M).colon {Ideal.Quotient.mk I₀ x} := by
        rw [Submodule.mem_colon_singleton, Submodule.mem_bot]
        change Ideal.Quotient.mk I₀ ((s : B) * x) = 0
        rw [hsx_eq, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
        exact ⟨a, rfl⟩
      exact s.2 (hp₀_le hs_colon)
    have hDVR : ∀ i : ↥S, IsDiscreteValuationRing (R_loc i) := by
      intro i
      let p : Ideal B := i.1
      have : p.IsPrime := i.2.isPrime
      let R := R_loc i
      let K := FractionRing B
      have hsub_nzd : p.primeCompl ≤ nonZeroDivisors B :=
        Ideal.primeCompl_le_nonZeroDivisors p
      have hinj_BR : Function.Injective (algebraMap B R) :=
        IsLocalization.injective R hsub_nzd
      have hinj_RK : Function.Injective (algebraMap R K) :=
        IsFractionRing.injective R K
      have hinj_BK : Function.Injective (algebraMap B K) :=
        IsFractionRing.injective B K
      have : IsDomain R := Function.Injective.isDomain (algebraMap R K) hinj_RK
      have : IsNoetherianRing R := IsLocalization.isNoetherianRing p.primeCompl R inferInstance
      have : IsIntegrallyClosed R :=
        isIntegrallyClosed_of_isLocalization R p.primeCompl hsub_nzd
      obtain ⟨_, f_inj, hf_inj⟩ := (isAssociatedPrime_iff_exists_injective_linearMap p M).mp i.2
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (f_inj (Ideal.Quotient.mk p 1))
      have hp_iff : ∀ t : B, t ∈ p ↔ t * y ∈ I₀ := by
        intro t
        have hf_t : f_inj (Ideal.Quotient.mk p t) = Ideal.Quotient.mk I₀ (t * y) := by
          have ht1 : Ideal.Quotient.mk p t = t • Ideal.Quotient.mk p 1 := by
            rw [Algebra.smul_def, map_one, mul_one]
            rfl
          rw [ht1, map_smul, ← hy]
          rfl
        rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.eq_zero_iff_mem, ← hf_t]
        exact ⟨fun h => by rw [h, map_zero], fun h => hf_inj (h.trans (map_zero _).symm)⟩
      have hb₀_p : b₀ ∈ p := (hp_iff b₀).mpr (Ideal.mem_span_singleton.mpr ⟨y, rfl⟩)
      have hb₀_max : algebraMap B R b₀ ∈ IsLocalRing.maximalIdeal R := by
        have h_under := IsLocalization.AtPrime.under_maximalIdeal R p
        rw [← h_under] at hb₀_p
        exact hb₀_p
      have hb₀_R_ne : algebraMap B R b₀ ≠ 0 :=
        fun h => hb₀ (hinj_BR (h.trans (map_zero _).symm))
      have hNotField : ¬ IsField R := by
        intro hF
        have hm_bot := IsLocalRing.isField_iff_maximalIdeal_eq.mp hF
        rw [hm_bot, Ideal.mem_bot] at hb₀_max
        exact hb₀_R_ne hb₀_max
      have hb₀_K_ne : algebraMap B K b₀ ≠ 0 :=
        fun h => hb₀ (hinj_BK (h.trans (map_zero _).symm))
      let z : K := algebraMap B K y * (algebraMap B K b₀)⁻¹
      have hz_mul : z * algebraMap B K b₀ = algebraMap B K y := by
        dsimp [z]
        rw [mul_assoc, inv_mul_cancel₀ hb₀_K_ne, mul_one]
      have hz_not_mem : ∀ u : R, algebraMap R K u ≠ z := by
        intro u hu
        obtain ⟨⟨a, s⟩, hus⟩ := IsLocalization.surj p.primeCompl u
        dsimp only at hus
        have hus_K := congrArg (algebraMap R K) hus
        rw [map_mul, ← IsScalarTower.algebraMap_apply B R K,
          ← IsScalarTower.algebraMap_apply B R K, hu] at hus_K
        have hsy_eq : (s : B) * y = b₀ * a := by
          apply hinj_BK
          calc
            algebraMap B K ((s : B) * y)
                = algebraMap B K (s : B) * (z * algebraMap B K b₀) := by rw [map_mul, hz_mul]
            _ = (z * algebraMap B K (s : B)) * algebraMap B K b₀ := by ring
            _ = algebraMap B K a * algebraMap B K b₀ := by rw [hus_K]
            _ = algebraMap B K (b₀ * a) := by rw [map_mul, mul_comm]
        have hs_p : (s : B) ∈ p := (hp_iff (s : B)).mpr (by
          rw [hsy_eq, Ideal.mem_span_singleton]
          exact ⟨a, rfl⟩)
        exact s.2 hs_p
      have hcond : ∀ w ∈ IsLocalRing.maximalIdeal R,
          ∃ v : R, algebraMap R K v = algebraMap R K w * z := by
        intro w hw
        obtain ⟨⟨a, s⟩, hws⟩ := IsLocalization.surj p.primeCompl w
        dsimp only at hws
        have ha_max : algebraMap B R a ∈ IsLocalRing.maximalIdeal R := by
          rw [← hws]
          exact Ideal.mul_mem_right _ _ hw
        have ha_p : a ∈ p := by
          rw [← IsLocalization.AtPrime.under_maximalIdeal R p]
          exact ha_max
        have hay : a * y ∈ I₀ := (hp_iff a).mp ha_p
        rw [Ideal.mem_span_singleton] at hay
        rcases hay with ⟨q₀, hq₀⟩
        let v : R := IsLocalization.mk' R q₀ s
        refine ⟨v, ?_⟩
        have hs_ne : (s : B) ≠ 0 := fun hs0 => s.2 (hs0 ▸ p.zero_mem)
        have hs_K_ne : algebraMap B K (s : B) ≠ 0 :=
          fun h => hs_ne (hinj_BK (h.trans (map_zero _).symm))
        apply mul_right_cancel₀ (mul_ne_zero hs_K_ne hb₀_K_ne)
        have hv_s : algebraMap R K v * algebraMap B K (s : B) = algebraMap B K q₀ := by
          rw [IsScalarTower.algebraMap_apply B R K (s : B), ← map_mul,
            IsLocalization.mk'_spec R q₀ s, ← IsScalarTower.algebraMap_apply B R K]
        have hw_s : algebraMap R K w * algebraMap B K (s : B) = algebraMap B K a := by
          rw [IsScalarTower.algebraMap_apply B R K (s : B), ← map_mul, hws,
            ← IsScalarTower.algebraMap_apply B R K]
        calc
          algebraMap R K v * (algebraMap B K (s : B) * algebraMap B K b₀)
              = (algebraMap R K v * algebraMap B K (s : B)) * algebraMap B K b₀ := by ring
          _ = algebraMap B K (b₀ * q₀) := by rw [hv_s, map_mul, mul_comm]
          _ = algebraMap B K (a * y) := by rw [← hq₀]
          _ = algebraMap B K a * (z * algebraMap B K b₀) := by rw [map_mul, hz_mul]
          _ = (algebraMap R K w * algebraMap B K (s : B)) * (z * algebraMap B K b₀) := by
            rw [← hw_s]
          _ = (algebraMap R K w * z) * (algebraMap B K (s : B) * algebraMap B K b₀) := by ring
      let lam_map : ↥(IsLocalRing.maximalIdeal R) →ₗ[R] R :=
        { toFun := fun w => (hcond w.1 w.2).choose
          map_add' := fun w₁ w₂ => hinj_RK (by
            rw [map_add, (hcond (w₁ + w₂).1 (w₁ + w₂).2).choose_spec,
              (hcond w₁.1 w₁.2).choose_spec, (hcond w₂.1 w₂.2).choose_spec]
            change algebraMap R K (w₁.1 + w₂.1) * z = _
            rw [map_add, add_mul])
          map_smul' := fun r w => hinj_RK (by
            rw [RingHom.id_apply, smul_eq_mul, map_mul,
              (hcond (r • w).1 (r • w).2).choose_spec, (hcond w.1 w.2).choose_spec]
            change algebraMap R K (r * w.1) * z = _
            rw [map_mul, mul_assoc]) }
      let J_R : Ideal R := LinearMap.range lam_map
      have hJ_not_le : ¬ (J_R ≤ IsLocalRing.maximalIdeal R) := by
        intro hJ_le
        let N : Submodule R K := Submodule.map (Algebra.linearMap R K) (IsLocalRing.maximalIdeal R)
        have hN_ne : N ≠ ⊥ := by
          intro hbot
          have hb_mem : algebraMap B K b₀ ∈ N := by
            rw [IsScalarTower.algebraMap_apply B R K]
            exact ⟨algebraMap B R b₀, hb₀_max, rfl⟩
          rw [hbot, Submodule.mem_bot] at hb_mem
          exact hb₀_K_ne hb_mem
        have hN_fg : N.FG :=
          Submodule.FG.map (Algebra.linearMap R K)
            (IsNoetherian.noetherian (IsLocalRing.maximalIdeal R))
        have hz_mem : ∀ n ∈ N, z • n ∈ N := by
          rintro _ ⟨w, hw, rfl⟩
          change z * algebraMap R K w ∈ N
          rw [mul_comm, ← (hcond w hw).choose_spec]
          exact ⟨lam_map ⟨w, hw⟩, hJ_le ⟨⟨w, hw⟩, rfl⟩, rfl⟩
        have hz_int : IsIntegral R z :=
          isIntegral_of_smul_mem_submodule N hN_ne hN_fg z hz_mem
        obtain ⟨u, hu⟩ := (isIntegrallyClosed_iff K).mp inferInstance hz_int
        exact hz_not_mem u hu
      have hJ_top : J_R = ⊤ := by
        by_contra hne_top
        exact hJ_not_le (IsLocalRing.le_maximalIdeal hne_top)
      have h1_mem : (1 : R) ∈ J_R := hJ_top ▸ Submodule.mem_top
      rcases h1_mem with ⟨w₀, hw₀⟩
      have hw₀_spec : algebraMap R K w₀.1 * z = 1 := by
        rw [← (hcond w₀.1 w₀.2).choose_spec]
        change algebraMap R K (lam_map w₀) = 1
        rw [hw₀, map_one]
      have hPrin : (IsLocalRing.maximalIdeal R).IsPrincipal := by
        refine ⟨⟨w₀.1, le_antisymm ?_ ?_⟩⟩
        · intro w hw
          rw [Ideal.submodule_span_eq, Ideal.mem_span_singleton]
          refine ⟨lam_map ⟨w, hw⟩, hinj_RK ?_⟩
          change algebraMap R K w = algebraMap R K (w₀.1 * (hcond w hw).choose)
          rw [map_mul, (hcond w hw).choose_spec]
          calc
            algebraMap R K w = algebraMap R K w * 1 := (mul_one _).symm
            _ = algebraMap R K w * (algebraMap R K w₀.1 * z) := by rw [← hw₀_spec]
            _ = algebraMap R K w₀.1 * (algebraMap R K w * z) := by ring
        · rw [Ideal.submodule_span_eq, Ideal.span_le, Set.singleton_subset_iff]
          exact w₀.2
      exact ((IsDiscreteValuationRing.TFAE R hNotField).out 5 1).mp hPrin
    
    have hCoordZero : ∀ i : ↥S, c₀ ⊗ₜ[B] (α (Ideal.Quotient.mk I₀ 1) i) = 0 := by
      intro i
      have : i.1.IsPrime := i.2.isPrime
      let R_i := R_loc i
      have : IsDiscreteValuationRing R_i := hDVR i
      have hsub_nzd : i.1.primeCompl ≤ nonZeroDivisors B :=
        Ideal.primeCompl_le_nonZeroDivisors i.1
      have : IsDomain R_i :=
        Function.Injective.isDomain (algebraMap R_i (FractionRing B))
          (IsFractionRing.injective R_i (FractionRing B))
      let C_i := TensorProduct B R_i C
      have : Algebra.Etale R_i C_i := Algebra.Etale.baseChange B C R_i
      let b_i : R_i := algebraMap B R_i b₀
      have hb_i : b_i ≠ 0 :=
        fun h => hb₀ (IsLocalization.injective R_i hsub_nzd (h.trans (map_zero _).symm))
      let ι_i : C →ₐ[B] C_i := Algebra.TensorProduct.includeRight
      have hc_i_sq : (ι_i c₀) * (ι_i c₀) = b_i • (ι_i c₀) := by
        rw [← map_mul, hc₀, map_smul]
        exact (IsScalarTower.algebraMap_smul R_i b₀ (ι_i c₀)).symm
      obtain ⟨y_i, hy_i⟩ := hDvrEtaleDiv R_i C_i b_i hb_i (ι_i c₀) hc_i_sq
      have hy_B : (1 : R_i) ⊗ₜ[B] c₀ = b₀ • y_i := by
        change ι_i c₀ = b₀ • y_i
        rw [hy_i, IsScalarTower.algebraMap_smul R_i b₀ y_i]
      let q_i : R_i →ₗ[B] (R_loc i ⧸ J_loc i) := (Ideal.Quotient.mkₐ B (J_loc i)).toLinearMap
      have hq_ann : b₀ • q_i = 0 := LinearMap.ext fun r => by
        change b₀ • Ideal.Quotient.mk (J_loc i) r = 0
        rw [← IsScalarTower.algebraMap_smul (R_loc i) b₀]
        change Ideal.Quotient.mk (J_loc i) (b_i * r) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mul_mem_right r (J_loc i) (Ideal.mem_span_singleton_self b_i)
      let β_i : C_i →ₗ[B] TensorProduct B C (R_loc i ⧸ J_loc i) :=
        (LinearMap.lTensor C q_i).comp (TensorProduct.comm B R_i C).toLinearMap
      have hβ_eval : β_i ((1 : R_i) ⊗ₜ[B] c₀) = c₀ ⊗ₜ[B] (α (Ideal.Quotient.mk I₀ 1) i) := by
        change (LinearMap.lTensor C q_i) ((TensorProduct.comm B R_i C) ((1 : R_i) ⊗ₜ[B] c₀)) =
          c₀ ⊗ₜ[B] (I₀.liftQ G_loc hI₀_ker (Submodule.Quotient.mk (1 : B)) i)
        rw [TensorProduct.comm_tmul, LinearMap.lTensor_tmul, Submodule.liftQ_apply]
        have hq1 : q_i 1 = (G_loc 1) i := by
          dsimp [G_loc, g_loc, q_i]
          rw [map_one]
          exact (map_one _).symm
        rw [hq1]
      have hβ_zero : β_i (b₀ • y_i) = 0 := by
        rw [map_smul]
        change (b₀ • LinearMap.lTensor C q_i) ((TensorProduct.comm B R_i C) y_i) = 0
        rw [← LinearMap.lTensor_smul, hq_ann, LinearMap.lTensor_zero, LinearMap.zero_apply]
      rw [← hβ_eval, hy_B, hβ_zero]
    
    let Ψ := TensorProduct.piRight B B C (fun i : ↥S => R_loc i ⧸ J_loc i)
    have hΨ_zero : Ψ (LinearMap.lTensor C α (c₀ ⊗ₜ[B] Ideal.Quotient.mk I₀ 1)) = 0 := by
      rw [LinearMap.lTensor_tmul, TensorProduct.piRight_apply, TensorProduct.piRightHom_tmul]
      ext i
      exact hCoordZero i
    have hlT_zero : LinearMap.lTensor C α (c₀ ⊗ₜ[B] Ideal.Quotient.mk I₀ 1) = 0 := by
      calc
        LinearMap.lTensor C α (c₀ ⊗ₜ[B] Ideal.Quotient.mk I₀ 1)
            = Ψ.symm (Ψ (LinearMap.lTensor C α (c₀ ⊗ₜ[B] Ideal.Quotient.mk I₀ 1))) :=
              (Ψ.symm_apply_apply _).symm
        _ = Ψ.symm 0 := by rw [hΨ_zero]
        _ = 0 := Ψ.symm.map_zero
    have htmul_I₀ : (c₀ ⊗ₜ[B] Ideal.Quotient.mk I₀ 1) = 0 :=
      Module.Flat.lTensor_preserves_injective_linearMap α hInj_α
        (hlT_zero.trans (LinearMap.map_zero _).symm)
    have hq_C := congrArg (TensorProduct.tensorQuotEquivQuotSMul C I₀) htmul_I₀
    rw [(TensorProduct.tensorQuotEquivQuotSMul C I₀).map_zero,
      TensorProduct.tensorQuotEquivQuotSMul_tmul_mk, one_smul,
      Submodule.Quotient.mk_eq_zero] at hq_C
    exact hSpanSmulTop b₀ c₀ hq_C
  
  have : Module.Flat B C := inferInstance
  let E := FractionRing B
  let A_E := TensorProduct B E C
  let ι : C →ₐ[B] A_E := Algebra.TensorProduct.includeRight
  have hInj_ι : Function.Injective ι := by
    intro c₁ c₂ hc₁₂
    have hmk : TensorProduct.mk B E C 1 c₁ = TensorProduct.mk B E C 1 c₂ := hc₁₂
    obtain ⟨s, hs⟩ := IsLocalizedModule.exists_of_eq (S := nonZeroDivisors B) hmk
    have hs_ne : (s : B) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
    have hsub : (s : B) • (c₁ - c₂) = 0 := by
      rw [smul_sub]
      exact sub_eq_zero.mpr hs
    exact sub_eq_zero.mp (hFlatTorsionFree hs_ne hsub)
  have : Algebra.Etale E A_E := Algebra.Etale.baseChange B C E
  obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, Φ, _⟩ :=
    (Algebra.Etale.iff_exists_algEquiv_prod E A_E).mp inferInstance
  have : Finite I := hFinI
  let : Fintype I := Fintype.ofFinite I
  let : ∀ i : I, Field (Ai i) := hFieldAi
  let : ∀ i : I, Algebra E (Ai i) := hAlgAi
  let v : I → ∀ j : I, Ai j := fun i => Pi.single i 1
  have hv_idem : ∀ i : I, v i * v i = v i := by
    intro i
    ext j
    change v i j * v i j = v i j
    dsimp [v]
    by_cases hij : j = i
    · subst hij; simp
    · simp [Pi.single_eq_of_ne hij]
  have hLift : ∀ i : I, ∃ e_i : C, Φ (ι e_i) = v i := by
    intro i
    let e_tilde : A_E := Φ.symm (v i)
    have het_idem : e_tilde * e_tilde = e_tilde := by
      dsimp [e_tilde]
      rw [← map_mul, hv_idem]
    obtain ⟨⟨c_i, s_i⟩, hcs⟩ :=
      IsLocalizedModule.surj (nonZeroDivisors B) (TensorProduct.mk B E C 1) e_tilde
    dsimp only at hcs
    let b_i : B := s_i.1
    have hb_i : b_i ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s_i.2
    have hcs' : b_i • e_tilde = ι c_i := hcs
    have hci_sq : c_i * c_i = b_i • c_i := by
      refine hInj_ι ?_
      rw [map_mul, ← hcs', smul_mul_smul_comm, het_idem, map_smul, ← hcs', mul_smul]
    obtain ⟨e_i, hei⟩ := hQuadDivB b_i hb_i c_i hci_sq
    refine ⟨e_i, ?_⟩
    have hbE_ne : algebraMap B E b_i ≠ 0 :=
      fun h => hb_i (IsFractionRing.injective B E (h.trans (map_zero _).symm))
    have h_eq_et : ι e_i = e_tilde := by
      have hsmul_eq : b_i • ι e_i = b_i • e_tilde := by
        rw [← map_smul, ← hei, hcs']
      rw [← IsScalarTower.algebraMap_smul E b_i, ← IsScalarTower.algebraMap_smul E b_i] at hsmul_eq
      calc
        ι e_i = (1 : E) • ι e_i := (one_smul _ _).symm
        _ = ((algebraMap B E b_i)⁻¹ * algebraMap B E b_i) • ι e_i := by
          rw [inv_mul_cancel₀ hbE_ne]
        _ = (algebraMap B E b_i)⁻¹ • (algebraMap B E b_i • ι e_i) := mul_smul _ _ _
        _ = (algebraMap B E b_i)⁻¹ • (algebraMap B E b_i • e_tilde) := by rw [hsmul_eq]
        _ = ((algebraMap B E b_i)⁻¹ * algebraMap B E b_i) • e_tilde := (mul_smul _ _ _).symm
        _ = e_tilde := by rw [inv_mul_cancel₀ hbE_ne, one_smul]
    rw [h_eq_et]
    exact Φ.apply_symm_apply (v i)
  let e : I → C := fun i => (hLift i).choose
  have he_spec : ∀ i : I, Φ (ι (e i)) = v i := fun i => (hLift i).choose_spec
  have hsum_one : ∑ i : I, e i = 1 := by
    refine hInj_ι (Φ.injective ?_)
    rw [map_sum, map_sum, map_one, map_one]
    ext j
    rw [Finset.sum_apply]
    simp only [he_spec, v]
    change ∑ i : I, Pi.single i ((fun k : I => (1 : Ai k)) i) j = 1
    exact Fintype.sum_pi_single j (fun _ => 1)
  have hex_not_q : ∃ i₀ : I, e i₀ ∉ q := by
    by_contra h_all
    have h_all_mem : ∀ i : I, e i ∈ q := fun i =>
      Decidable.not_not.mp (fun hi => h_all ⟨i, hi⟩)
    have h1_mem : (1 : C) ∈ q := by
      rw [← hsum_one]
      exact Ideal.sum_mem q (fun i _ => h_all_mem i)
    exact Ideal.IsPrime.ne_top ‹q.IsPrime› (q.eq_top_iff_one.mpr h1_mem)
  obtain ⟨i₀, hi₀_q⟩ := hex_not_q
  let f : C := e i₀
  refine ⟨f, hi₀_q, ?_⟩
  let ψ : C →+* Ai i₀ := (Pi.evalRingHom Ai i₀).comp (Φ.toRingHom.comp ι.toRingHom)
  have hψ_f : ψ f = 1 := by
    change Φ (ι (e i₀)) i₀ = 1
    rw [he_spec i₀]
    exact Pi.single_eq_same i₀ (1 : Ai i₀)
  have hu_f : IsUnit (ψ f) := hψ_f.symm ▸ isUnit_one
  let ψ_hat : Localization.Away f →+* Ai i₀ := IsLocalization.Away.lift f hu_f
  have hInj_ψhat : Function.Injective ψ_hat := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    obtain ⟨n, c, hwc⟩ := IsLocalization.Away.surj f w
    have hψ_c : ψ c = 0 := by
      have h1 := congrArg ψ_hat hwc
      rw [map_mul, map_pow, IsLocalization.Away.lift_eq f hu_f,
        IsLocalization.Away.lift_eq f hu_f, hw, zero_mul] at h1
      exact h1.symm
    have hfc_zero : f * c = 0 := by
      refine hInj_ι (Φ.injective ?_)
      rw [map_zero, map_zero, map_mul, map_mul, he_spec i₀]
      ext j
      change v i₀ j * Φ (ι c) j = 0
      rcases eq_or_ne j i₀ with rfl | hj
      · change v j j * ψ c = 0
        rw [hψ_c, mul_zero]
      · dsimp [v]
        rw [Pi.single_eq_of_ne hj, zero_mul]
    have hw_pow : w * (algebraMap C (Localization.Away f) f) ^ (n + 1) = 0 := by
      calc
        w * (algebraMap C (Localization.Away f) f) ^ (n + 1)
            = (w * (algebraMap C (Localization.Away f) f) ^ n) *
                algebraMap C (Localization.Away f) f := by rw [pow_succ, mul_assoc]
        _ = algebraMap C (Localization.Away f) c * algebraMap C (Localization.Away f) f := by
          rw [hwc]
        _ = algebraMap C (Localization.Away f) (f * c) := by rw [← map_mul, mul_comm]
        _ = 0 := by rw [hfc_zero, map_zero]
    have hunit_pow : IsUnit ((algebraMap C (Localization.Away f) f) ^ (n + 1)) :=
      (IsLocalization.Away.algebraMap_isUnit f).pow (n + 1)
    exact (hunit_pow.mul_left_eq_zero).mp hw_pow
  exact Function.Injective.isDomain ψ_hat hInj_ψhat

theorem weil_integral_finiteType_generic_etale_normalization_finite (k : Type u) [Field k] [IsAlgClosed k]
    (hIntFin : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
      (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K],
      Module.Finite A ↥(integralClosure A K) ∧ IsIntegrallyClosed ↥(integralClosure A K))
    (Z : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Z]
    (f_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
    [AlgebraicGeometry.LocallyOfFiniteType f_Z]
    (U₁ : Z.Opens)
    (V₁ : AlgebraicGeometry.Scheme.{u})
    (p₁ : V₁ ⟶ (U₁ : AlgebraicGeometry.Scheme.{u}))
    [AlgebraicGeometry.IsIntegral V₁]
    [AlgebraicGeometry.IsFinite p₁]
    [AlgebraicGeometry.Etale p₁]
    [AlgebraicGeometry.Surjective p₁] :
    Nonempty U₁ →
    ∃ (Y_Z : AlgebraicGeometry.Scheme.{u})
      (q_Z : Y_Z ⟶ Z)
      (V_bar : Y_Z.Opens)
      (s₁ : (V_bar : AlgebraicGeometry.Scheme.{u}) ⟶ V₁),
      AlgebraicGeometry.IsIntegral Y_Z ∧
      (∀ (W : Y_Z.Opens), AlgebraicGeometry.IsAffineOpen W → Nonempty W →
        IsDomain ↑(Y_Z.presheaf.obj (Opposite.op W)) ∧
        IsIntegrallyClosed ↑(Y_Z.presheaf.obj (Opposite.op W)) ∧
        IsNoetherianRing ↑(Y_Z.presheaf.obj (Opposite.op W))) ∧
      AlgebraicGeometry.IsFinite q_Z ∧
      Nonempty V_bar ∧
      AlgebraicGeometry.IsFinite s₁ ∧
      AlgebraicGeometry.Surjective s₁ ∧
      V_bar.ι ≫ q_Z = s₁ ≫ p₁ ≫ U₁.ι :=
by
  classical
  intro hU₁
  
  have hIso_map_eq : ∀ {X : Scheme.{u}} {O₁ O₂ : X.Opens} (p : O₁ = O₂),
      IsIso (X.presheaf.map (eqToHom p).op) := by
    intro X O₁ O₂ p
    subst p
    rw [eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
    infer_instance
  have h_map_eq_id : ∀ {X : Scheme.{u}} {O : X.Opens} (p : O = O),
      X.presheaf.map (eqToHom p).op = 𝟙 (Γ(X, O)) := by
    intro X O p
    rw [eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
  have h_comp_app_eq : ∀ {X Y S : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ S) (h : X ⟶ S)
      (h_fg : h = f ≫ g) (U : S.Opens) (V : Y.Opens) (hV : g ⁻¹ᵁ U = V)
      (hL : h ⁻¹ᵁ U = f ⁻¹ᵁ V),
      h.app U = g.app U ≫ Y.presheaf.map (eqToHom hV.symm).op ≫
        f.app V ≫ X.presheaf.map (eqToHom hL).op := by
    intro X Y S f g h h_fg U V hV hL
    subst h_fg hV
    have h_id1 : Y.presheaf.map (eqToHom (rfl : g ⁻¹ᵁ U = g ⁻¹ᵁ U)).op = 𝟙 (Γ(Y, g ⁻¹ᵁ U)) :=
      h_map_eq_id _
    have h_id2 : X.presheaf.map (eqToHom hL).op = 𝟙 (Γ(X, (f ≫ g) ⁻¹ᵁ U)) :=
      h_map_eq_id hL
    rw [h_id1, Category.id_comp]
    erw [h_id2, Category.comp_id]
    exact Scheme.Hom.comp_app f g U
  
  have h_gen_mem : ∀ {X : Scheme.{u}} [IsIntegral X] (U : X.Opens), Nonempty U →
      genericPoint ↥X ∈ U := by
    intro X _ U ⟨u, hu⟩
    by_contra hx
    have hsub : closure ({genericPoint ↥X} : Set ↥X) ⊆ (U : Set ↥X)ᶜ :=
      U.isOpen.isClosed_compl.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hx)
    rw [(genericPoint_spec ↥X).def] at hsub
    exact hsub trivial hu
  
  let ξ : V₁ ⟶ Z := p₁ ≫ U₁.ι
  have : Etale ξ := by dsimp [ξ]; infer_instance
  let x_V : ↥V₁ := genericPoint ↥V₁
  let x_Z : ↥Z := genericPoint ↥Z
  have h_gen : ξ.base x_V = x_Z := by
    have hU₁_dense : closure (U₁ : Set ↥Z) = Set.univ := by
      apply Set.eq_univ_of_forall
      intro z
      by_contra hz
      have hopen : IsOpen ((closure (U₁ : Set ↥Z))ᶜ) := isClosed_closure.isOpen_compl
      let O : Z.Opens := ⟨(closure (U₁ : Set ↥Z))ᶜ, hopen⟩
      have hxO : x_Z ∈ O := h_gen_mem O ⟨z, hz⟩
      have hxU₁ : x_Z ∈ U₁ := h_gen_mem U₁ hU₁
      exact hxO (subset_closure hxU₁)
    have h_img : (U₁ : Set ↥Z) ⊆ closure ({ξ.base x_V} : Set ↥Z) := by
      intro z hz
      obtain ⟨v, hv⟩ := p₁.surjective ⟨z, hz⟩
      have hv_eq : ξ.base v = z := by
        change U₁.ι.base (p₁.base v) = z
        rw [hv]
        rfl
      have hv_cl : v ∈ closure ({x_V} : Set ↥V₁) := by
        rw [(genericPoint_spec ↥V₁).def]; trivial
      have hmem : ξ.base v ∈ ξ.base '' closure ({x_V} : Set ↥V₁) := ⟨v, hv_cl, rfl⟩
      rw [hv_eq] at hmem
      have hcont : Continuous ξ.base := ξ.continuous
      have hcl_sub := image_closure_subset_closure_image hcont (s := ({x_V} : Set ↥V₁))
      rw [Set.image_singleton] at hcl_sub
      exact hcl_sub hmem
    have h_cl_eq : closure ({ξ.base x_V} : Set ↥Z) = Set.univ := by
      apply Set.Subset.antisymm (Set.subset_univ _)
      rw [← hU₁_dense]
      exact isClosed_closure.closure_subset_iff.mpr h_img
    exact (isGenericPoint_def.mpr h_cl_eq).eq (genericPoint_spec ↥Z)
  let K_cat : CommRingCat.{u} := Z.functionField
  let L_cat : CommRingCat.{u} := V₁.functionField
  let ψ_KL : K_cat ⟶ L_cat :=
    eqToHom (congrArg Z.presheaf.stalk h_gen.symm) ≫ ξ.stalkMap x_V
  let _ : Algebra ↑K_cat ↑L_cat := ψ_KL.hom.toAlgebra
  let η_V : Spec L_cat ⟶ V₁ := V₁.fromSpecStalk x_V
  let η₁ : Spec L_cat ⟶ (U₁ : Scheme.{u}) := η_V ≫ p₁
  let η_Z : Spec L_cat ⟶ Z := η_V ≫ ξ
  have h_ηZ_eq1 : η_Z = η₁ ≫ U₁.ι := by dsimp [η_Z, η₁, ξ]; rw [Category.assoc]
  have h_stalk_trans : ∀ (y : ↥Z) (hy : y = x_Z),
      Spec.map (eqToHom (congrArg Z.presheaf.stalk hy.symm)) ≫ Z.fromSpecStalk x_Z =
        Z.fromSpecStalk y := by
    intro y hy; subst hy; simp
  have h_ηZ : η_Z = Spec.map ψ_KL ≫ Z.fromSpecStalk x_Z := by
    dsimp [ψ_KL, η_Z, η_V, K_cat, L_cat, Scheme.functionField]
    rw [Spec.map_comp, Category.assoc, h_stalk_trans (ξ.base x_V) h_gen]
    exact (Scheme.SpecMap_stalkMap_fromSpecStalk ξ (x := x_V)).symm
  have h_germ_trans : ∀ {U : Z.Opens} (y : ↥Z) (hy : y = x_Z) (hxU : x_Z ∈ U) (hyU : y ∈ U),
      Z.presheaf.germ U x_Z hxU ≫ eqToHom (congrArg Z.presheaf.stalk hy.symm) =
        Z.presheaf.germ U y hyU := by
    intro U y hy hxU hyU; subst hy; simp
  have h_sq : ∀ (U : Z.Opens) (V : V₁.Opens) (hxV : x_V ∈ V) (hxZ : x_Z ∈ U)
      (e : V ≤ ξ ⁻¹ᵁ U),
      letI : Nonempty U := ⟨⟨x_Z, hxZ⟩⟩
      letI : Nonempty V := ⟨⟨x_V, hxV⟩⟩
      Z.germToFunctionField U ≫ ψ_KL = ξ.appLE U V e ≫ V₁.germToFunctionField V := by
    intro U V hxV hxZ e
    let _ : Nonempty U := ⟨⟨x_Z, hxZ⟩⟩
    let _ : Nonempty V := ⟨⟨x_V, hxV⟩⟩
    change Z.presheaf.germ U x_Z hxZ ≫
        (eqToHom (congrArg Z.presheaf.stalk h_gen.symm) ≫ ξ.stalkMap x_V) =
      (ξ.app U ≫ V₁.presheaf.map (homOfLE e).op) ≫ V₁.presheaf.germ V x_V hxV
    rw [← Category.assoc, h_germ_trans (ξ.base x_V) h_gen hxZ (e hxV),
      Scheme.Hom.germ_stalkMap ξ U x_V (e hxV), Category.assoc,
      V₁.presheaf.germ_res (homOfLE e) x_V hxV]
  
  have hSepFin : FiniteDimensional ↑K_cat ↑L_cat ∧ Algebra.IsSeparable ↑K_cat ↑L_cat := by
    obtain ⟨U₀, hU₀_aff, hxZ₀, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x_Z) trivial
    have hxV_pre : x_V ∈ ξ ⁻¹ᵁ U₀ := by change ξ.base x_V ∈ U₀; rwa [h_gen]
    obtain ⟨V₀, hV₀_aff, hxV₀, hV₀_sub⟩ :=
      exists_isAffineOpen_mem_and_subset (U := ξ ⁻¹ᵁ U₀) (x := x_V) hxV_pre
    have e₀ : V₀ ≤ ξ ⁻¹ᵁ U₀ := hV₀_sub
    let _ : Nonempty U₀ := ⟨⟨x_Z, hxZ₀⟩⟩
    let _ : Nonempty V₀ := ⟨⟨x_V, hxV₀⟩⟩
    let D₀ : Type u := ↑(Z.presheaf.obj (Opposite.op U₀))
    let S₀ : Type u := ↑(V₁.presheaf.obj (Opposite.op V₀))
    let K : Type u := ↑K_cat
    let L : Type u := ↑L_cat
    let φ₀ : D₀ →+* S₀ := (ξ.appLE U₀ V₀ e₀).hom
    have hφ₀_et : φ₀.Etale := Etale.etale_appLE (f := ξ) hU₀_aff hV₀_aff e₀
    let _ : Algebra D₀ S₀ := φ₀.toAlgebra
    have : Algebra.Etale D₀ S₀ := hφ₀_et
    have : IsFractionRing D₀ K := functionField_isFractionRing_of_isAffineOpen Z U₀ hU₀_aff
    have : IsFractionRing S₀ L := functionField_isFractionRing_of_isAffineOpen V₁ V₀ hV₀_aff
    let _ : Algebra D₀ L := (Z.germToFunctionField U₀ ≫ ψ_KL).hom.toAlgebra
    have : IsScalarTower D₀ K L := IsScalarTower.of_algebraMap_eq' rfl
    have h_sq₀ := congrArg CommRingCat.Hom.hom (h_sq U₀ V₀ hxV₀ hxZ₀ e₀)
    have : IsScalarTower D₀ S₀ L := IsScalarTower.of_algebraMap_eq fun d => by
      change (Z.germToFunctionField U₀ ≫ ψ_KL).hom d =
        (V₁.germToFunctionField V₀).hom ((ξ.appLE U₀ V₀ e₀).hom d)
      rw [h_sq₀]; rfl
    let T : Type u := TensorProduct D₀ K S₀
    have : Algebra.Etale K T := Algebra.Etale.baseChange D₀ S₀ K
    rcases (Algebra.Etale.iff_exists_algEquiv_prod K T).mp inferInstance with
      ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSepAi⟩
    have : Finite I := hFinI
    let _ : Fintype I := Fintype.ofFinite I
    let _ : ∀ i, Field (Ai i) := hFieldAi
    let _ : ∀ i, Algebra K (Ai i) := hAlgAi
    have : ∀ i, Module.Finite K (Ai i) := fun i => (hFinSepAi i).1
    have : ∀ i, Algebra.IsSeparable K (Ai i) := fun i => (hFinSepAi i).2
    have : Module.Finite K T := Module.Finite.equiv e_prod.symm.toLinearEquiv
    let Ψ : T →ₐ[K] L :=
      Algebra.TensorProduct.lift (Algebra.ofId K L) (IsScalarTower.toAlgHom D₀ S₀ L)
        (fun _ _ => Commute.all _ _)
    have hΨ_one_tmul : ∀ s : S₀, Ψ ((1 : K) ⊗ₜ[D₀] s) = algebraMap S₀ L s := by
      intro s
      dsimp only [Ψ]
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    have h_clear : ∀ z : T, ∃ (d : nonZeroDivisors D₀) (s : S₀),
        (algebraMap D₀ K d.1) • z = (1 : K) ⊗ₜ[D₀] s := by
      intro z
      refine TensorProduct.inductionOn
        (motive := fun z => ∃ (d : nonZeroDivisors D₀) (s : S₀),
          (algebraMap D₀ K d.1) • z = (1 : K) ⊗ₜ[D₀] s) z ?_ ?_
      · intro κ s₀
        obtain ⟨⟨a, d⟩, had⟩ := IsLocalization.surj (nonZeroDivisors D₀) κ
        refine ⟨d, a • s₀, ?_⟩
        calc
          (algebraMap D₀ K d.1) • (κ ⊗ₜ[D₀] s₀)
              = (algebraMap D₀ K d.1 * κ) ⊗ₜ[D₀] s₀ := by
                rw [TensorProduct.smul_tmul', smul_eq_mul]
          _ = (algebraMap D₀ K a) ⊗ₜ[D₀] s₀ := by rw [mul_comm, had]
          _ = (a • (1 : K)) ⊗ₜ[D₀] s₀ := by rw [Algebra.smul_def, mul_one]
          _ = (1 : K) ⊗ₜ[D₀] (a • s₀) := TensorProduct.smul_tmul a (1 : K) s₀
      · intro z₁ z₂ ⟨d₁, s₁, h₁⟩ ⟨d₂, s₂, h₂⟩
        refine ⟨d₁ * d₂, d₂.1 • s₁ + d₁.1 • s₂, ?_⟩
        have hd_mul : algebraMap D₀ K (d₁ * d₂).1 = algebraMap D₀ K d₁.1 * algebraMap D₀ K d₂.1 :=
          map_mul (algebraMap D₀ K) d₁.1 d₂.1
        rw [smul_add, hd_mul, mul_comm (algebraMap D₀ K d₁.1), mul_smul, h₁,
          mul_comm (algebraMap D₀ K d₂.1), mul_smul, h₂]
        have hsmul1 : ∀ (c : D₀) (s : S₀),
            (algebraMap D₀ K c) • ((1 : K) ⊗ₜ[D₀] s) = (1 : K) ⊗ₜ[D₀] (c • s) := by
          intro c s
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, ← mul_one (algebraMap D₀ K c),
            ← Algebra.smul_def, TensorProduct.smul_tmul]
        rw [hsmul1, hsmul1, ← TensorProduct.tmul_add]
    have hΨ_inj : Function.Injective Ψ := by
      refine (injective_iff_map_eq_zero Ψ).mpr ?_
      intro z hz
      obtain ⟨d, s, hds⟩ := h_clear z
      have hΨ_s : algebraMap S₀ L s = 0 := by
        have h1 : Ψ ((algebraMap D₀ K d.1) • z) = 0 := by
          rw [map_smul, hz, smul_zero]
        rw [hds, hΨ_one_tmul] at h1
        exact h1
      have hs0 : s = 0 := by
        apply IsFractionRing.injective S₀ L
        rw [map_zero]
        exact hΨ_s
      rw [hs0, TensorProduct.tmul_zero] at hds
      have hd_ne : d.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp d.2
      have hkd_ne : algebraMap D₀ K d.1 ≠ 0 := by
        intro h0
        apply hd_ne
        apply IsFractionRing.injective D₀ K
        rw [map_zero]
        exact h0
      exact (smul_eq_zero.mp hds).resolve_left hkd_ne
    have : IsDomain T := Function.Injective.isDomain Ψ.toRingHom hΨ_inj
    have hΨ_surj : Function.Surjective Ψ := by
      intro ℓ
      obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors S₀) ℓ
      have hb_ne : b.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b.2
      have hLb_ne : algebraMap S₀ L b.1 ≠ 0 := by
        intro h0
        apply hb_ne
        apply IsFractionRing.injective S₀ L
        rw [map_zero]
        exact h0
      let tb : T := (1 : K) ⊗ₜ[D₀] b.1
      have htb_ne : tb ≠ 0 := by
        intro h0
        apply hLb_ne
        rw [← hΨ_one_tmul b.1]
        change Ψ tb = 0
        rw [h0, map_zero]
      have hmul_inj : Function.Injective (LinearMap.mulLeft K tb) := fun x y hxy =>
        mul_left_cancel₀ htb_ne hxy
      obtain ⟨w, hw⟩ := (LinearMap.injective_iff_surjective.mp hmul_inj) 1
      change tb * w = 1 at hw
      refine ⟨((1 : K) ⊗ₜ[D₀] a) * w, ?_⟩
      apply mul_right_cancel₀ hLb_ne
      calc
        Ψ (((1 : K) ⊗ₜ[D₀] a) * w) * algebraMap S₀ L b.1
            = Ψ (((1 : K) ⊗ₜ[D₀] a) * (tb * w)) := by
              rw [← hΨ_one_tmul b.1]
              change Ψ (((1 : K) ⊗ₜ[D₀] a) * w) * Ψ tb = _
              rw [← map_mul, mul_assoc, mul_comm w tb]
        _ = algebraMap S₀ L a := by rw [hw, mul_one, hΨ_one_tmul]
        _ = ℓ * algebraMap S₀ L b.1 := hab.symm
    let e_TL : T ≃ₐ[K] L := AlgEquiv.ofBijective Ψ ⟨hΨ_inj, hΨ_surj⟩
    have : FiniteDimensional K L := Module.Finite.equiv e_TL.toLinearEquiv
    let e_L : L ≃ₐ[K] (∀ i : I, Ai i) := e_TL.symm.trans e_prod
    have hI_ne : Nonempty I := by
      by_contra hI
      rw [not_nonempty_iff] at hI
      have h01 : (0 : L) = 1 := e_L.injective (Subsingleton.elim _ _)
      exact zero_ne_one h01
