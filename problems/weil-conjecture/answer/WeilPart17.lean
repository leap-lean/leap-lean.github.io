                  (U₀_sch.isoSpec.inv ≫ U_aff.ι) =
                  e_BZ ≫ (AlgebraicGeometry.Spec.map ι₀.appTop ≫ U₀_sch.isoSpec.inv) ≫ U_aff.ι :=
