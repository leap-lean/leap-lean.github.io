      let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u}
        Z.smallEtaleTopology Z'.smallEtaleTopology
      ∀ [_hr : pf_f.IsRightAdjoint] [_ha : pf_f.Additive]
        (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf Z'.smallEtaleTopology AddCommGrpCat.{u})),
        SC.ShortExact →
        ℓ • CategoryTheory.CategoryStruct.id SC.X₂ = 0 →
        ℓ • CategoryTheory.CategoryStruct.id SC.X₃ = 0 →
        (SC.map pf_f).ShortExact :=
by
  intro B_f _hc pf_f _hr _ha SC hSE hX₂ hX₃
  classical
  let P_et : MorphismProperty Scheme.{u} := @AlgebraicGeometry.Etale
  have : P_et.IsStableUnderComposition :=
    ⟨fun g₁ g₂ hg₁ hg₂ => by
      have : AlgebraicGeometry.Etale g₁ := hg₁
      have : AlgebraicGeometry.Etale g₂ := hg₂
      exact inferInstance⟩
  have : P_et.HasOfPostcompProperty P_et :=
    ⟨fun g₁ g₂ hg₂ hg₁₂ => MorphismProperty.of_postcomp P_et
      (W' := @AlgebraicGeometry.LocallyOfFiniteType ⊓ @AlgebraicGeometry.FormallyUnramified)
      g₁ g₂ (by have : AlgebraicGeometry.Etale g₂ := hg₂; exact ⟨inferInstance, inferInstance⟩)
      hg₁₂⟩
  have : ∀ {Y₁ Y₂ : Scheme.{u}} (h : Y₁ ⟶ Y₂),
      MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => ⟨fun _ _ => inferInstance⟩
  have : ∀ {Y₁ Y₂ : Scheme.{u}} (h : Y₁ ⟶ Y₂),
      MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => ⟨fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg⟩
  have hMemEtale : ∀ {S : Scheme.{u}} (X : S.Etale) (R : Sieve X),
      R ∈ S.smallEtaleTopology X ↔
        ∀ (x : ↥X.left), ∃ (Y : S.Etale) (g : Y ⟶ X) (y : ↥Y.left),
          R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left y = x := by
    intro S X R
    have hEq := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) S le_rfl
    exact (Eq.to_iff (congrArg (fun (J : GrothendieckTopology S.Etale) => R ∈ J X) hEq)).trans
      (Scheme.mem_toGrothendieck_smallPretopology X R)
  let Eℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let homOfElem : ∀ {A : AddCommGrpCat.{u}} (a : ↥A), Eℤ ⟶ A :=
    fun a => AddCommGrpCat.ofHom
      { toFun := fun n => n.down • a
        map_zero' := zero_zsmul a
        map_add' := fun m n => add_zsmul a m.down n.down }
  have hEmptySheafZero : ∀ {S : Scheme.{u}}
      (F : Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (W : S.Etale),
      IsEmpty ↥W.left → ∀ (s : ↥(F.obj.obj (Opposite.op W))), s = 0 := by
    intro S F W hEmp s
    have hBot : (⊥ : Sieve W) ∈ S.smallEtaleTopology W :=
      (hMemEtale W ⊥).mpr (fun x => IsEmpty.elim hEmp x)
    let fam_bot : (⊥ : Sieve W).arrows.FamilyOfElements (F.obj ⋙ coyoneda.obj (Opposite.op Eℤ)) :=
      fun _ _ hf => False.elim hf
    have hEqHom : homOfElem s = (0 : Eℤ ⟶ F.obj.obj (Opposite.op W)) :=
      (F.property Eℤ ⊥ hBot).isSeparatedFor fam_bot (homOfElem s)
        (0 : Eℤ ⟶ F.obj.obj (Opposite.op W))
        (fun _ _ hf => False.elim hf)
        (fun _ _ hf => False.elim hf)
    have h1 := congrArg (fun φ => φ.hom (ULift.up 1)) hEqHom
    simpa [homOfElem] using h1
  
  have step1_ptHit : ∀ (Ω E : Type u) [Field Ω] [IsAlgClosed Ω] [CommRing E] [Algebra Ω E]
      [Algebra.Etale Ω E] (q : Ideal E) [q.IsPrime],
      ∃ (σ : E →ₐ[Ω] Ω), RingHom.ker σ.toRingHom = q := by
    intro Ω E _ _ _ _ _ q _
    have : Module.Finite Ω E := Algebra.FormallyUnramified.finite_of_free Ω E
    have : Module.Finite Ω (E ⧸ q) :=
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ Ω q).toLinearMap Ideal.Quotient.mk_surjective
    have : Algebra.IsIntegral Ω (E ⧸ q) := Algebra.IsIntegral.of_finite Ω (E ⧸ q)
    have hbij : Function.Bijective (algebraMap Ω (E ⧸ q)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e_q : Ω ≃ₐ[Ω] (E ⧸ q) := AlgEquiv.ofBijective (Algebra.ofId Ω (E ⧸ q)) hbij
    refine ⟨e_q.symm.toAlgHom.comp (Ideal.Quotient.mkₐ Ω q), ?_⟩
    ext x
    simp only [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.comp_apply,
      Ideal.Quotient.mkₐ_eq_mk]
    exact ⟨fun h => Ideal.Quotient.eq_zero_iff_mem.mp
      (e_q.symm.injective (h.trans (map_zero e_q.symm).symm)),
      fun h => by rw [Ideal.Quotient.eq_zero_iff_mem.mpr h, map_zero]⟩
  
  have step2_artSplit : ∀ (Ω C₀ : Type u) [Field Ω] [IsAlgClosed Ω] [CommRing C₀] [Algebra Ω C₀]
      [Module.Finite Ω C₀],
      ∃ (r : ℕ) (Q : Fin r → Type u) (_ : ∀ m, CommRing (Q m)) (_ : ∀ m, Algebra Ω (Q m))
        (_ : C₀ ≃ₐ[Ω] (∀ m : Fin r, Q m)),
        ∀ m : Fin r,
          ∃ (_ : IsLocalRing (Q m)),
            ∀ (E : Type u) [CommRing E] [Algebra (Q m) E] [Algebra.Etale (Q m) E]
              (q : Ideal E) [q.IsPrime],
              Ideal.comap (algebraMap (Q m) E) q = IsLocalRing.maximalIdeal (Q m) →
              Nonempty (E →ₐ[Q m] Q m) := by
    intro Ω C₀ _ _ _ _ _
    have : IsArtinianRing C₀ := IsArtinianRing.of_finite Ω C₀
    have hMaxFin : Finite (MaximalSpectrum C₀) := by
      have : Finite {I : Ideal C₀ // I.IsMaximal} :=
        (IsArtinianRing.setOfPred_isMaximal_finite C₀).to_subtype
      exact Finite.of_injective
        (fun M : MaximalSpectrum C₀ => (⟨M.asIdeal, M.isMaximal⟩ : {I : Ideal C₀ // I.IsMaximal}))
        (fun M₁ M₂ h => MaximalSpectrum.ext (congrArg Subtype.val h))
    let _ : Fintype (MaximalSpectrum C₀) := Fintype.ofFinite (MaximalSpectrum C₀)
    let r : ℕ := Fintype.card (MaximalSpectrum C₀)
    let eqv : Fin r ≃ MaximalSpectrum C₀ := (Fintype.equivFin (MaximalSpectrum C₀)).symm
    let N : Ideal C₀ := nilradical C₀
    let π_N : C₀ →+* (C₀ ⧸ N) := Ideal.Quotient.mk N
    have hNil_ker : ∀ x ∈ RingHom.ker π_N, IsNilpotent x := by
      obtain ⟨k, hk⟩ := @IsArtinianRing.isNilpotent_nilradical C₀ _ _
      intro x hx
      rw [Ideal.mk_ker] at hx
      refine ⟨k, ?_⟩
      have hpow : x ^ k ∈ N ^ k := Ideal.pow_mem_pow hx k
      rwa [hk, Submodule.zero_eq_bot, Ideal.mem_bot] at hpow
    let θ₀ := IsArtinianRing.quotNilradicalEquivPi C₀
    let δ : Fin r → ((M : MaximalSpectrum C₀) → C₀ ⧸ M.asIdeal) :=
      fun m => Pi.single (eqv m) 1
    have hδ : CompleteOrthogonalIdempotents δ := by
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · intro m
        ext M
        change δ m M * δ m M = δ m M
        dsimp only [δ]
        by_cases h : M = eqv m
        · subst h; simp
        · simp [Pi.single_eq_of_ne h]
      · intro m₁ m₂ hne
        ext M
        simp only [δ, Pi.mul_apply, Pi.zero_apply]
        by_cases h : M = eqv m₁
        · subst h
          have h2 : eqv m₁ ≠ eqv m₂ := eqv.injective.ne hne
          simp [h2]
        · simp [h]
      · ext M
        simp only [δ, Finset.sum_apply, Pi.one_apply]
        rw [Finset.sum_eq_single (eqv.symm M)]
        · rw [eqv.apply_symm_apply, Pi.single_eq_same]
        · intro b _ hb
          exact Pi.single_eq_of_ne
            (fun heq => hb ((eqv.symm_apply_apply b).symm.trans (congrArg eqv.symm heq.symm))) 1
        · intro habs
          exact False.elim (habs (Finset.mem_univ _))
    let ē : Fin r → (C₀ ⧸ N) := fun m => θ₀.symm (δ m)
    have hē : CompleteOrthogonalIdempotents ē := by
      refine ⟨⟨fun m => ?_, fun m₁ m₂ hne => ?_⟩, ?_⟩
      · dsimp [IsIdempotentElem, ē]
        rw [← map_mul, hδ.idem m]
      · dsimp [ē]
        rw [← map_mul, hδ.ortho hne, map_zero]
      · dsimp [ē]
        rw [← map_sum, hδ.complete, map_one]
    obtain ⟨e, he_idem, he_lift⟩ :=
      CompleteOrthogonalIdempotents.lift_of_isNilpotent_ker π_N hNil_ker hē
        (fun m => Ideal.Quotient.mk_surjective (ē m))
    let Q : Fin r → Type u := fun m => C₀ ⧸ Ideal.span {1 - e m}
    let φ_alg : C₀ →ₐ[Ω] (∀ m : Fin r, Q m) :=
      AlgHom.pi (fun m => Ideal.Quotient.mkₐ Ω (Ideal.span {1 - e m}))
    have hφ_bij : Function.Bijective φ_alg := by
      have hpi := CompleteOrthogonalIdempotents.bijective_pi he_idem
      convert hpi using 1
      ext c m
      rfl
    let e_alg : C₀ ≃ₐ[Ω] (∀ m : Fin r, Q m) := AlgEquiv.ofBijective φ_alg hφ_bij
    refine ⟨r, Q, inferInstance, inferInstance, e_alg, ?_⟩
    intro m
    let I_m : Ideal C₀ := Ideal.span {1 - e m}
    let mk_m : C₀ →+* Q m := Ideal.Quotient.mk I_m
    have he_mod : ∀ (M : MaximalSpectrum C₀),
        Ideal.Quotient.mk M.asIdeal (e m) = δ m M := by
      intro M
      have h1 : θ₀ (π_N (e m)) = δ m := by
        have hm : π_N (e m) = ē m := congrFun he_lift m
        rw [hm]
        exact θ₀.apply_symm_apply (δ m)
      have h2 : θ₀ (π_N (e m)) = algebraMap C₀ ((M : MaximalSpectrum C₀) → C₀ ⧸ M.asIdeal) (e m) :=
        θ₀.commutes (e m)
      exact congrFun (h2.symm.trans h1) M
    have hIm_le : I_m ≤ (eqv m).asIdeal := by
      rw [Ideal.span_singleton_le_iff_mem, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one,
        he_mod (eqv m)]
      simp [δ]
    let 𝔪_m : Ideal (Q m) := Ideal.map mk_m (eqv m).asIdeal
    have h𝔪_max : 𝔪_m.IsMaximal := by
      have : (eqv m).asIdeal.IsMaximal := (eqv m).isMaximal
      let F_m := Ideal.Quotient.field (eqv m).asIdeal
      have hsup : I_m ⊔ (eqv m).asIdeal = (eqv m).asIdeal := sup_eq_right.mpr hIm_le
      let eq_quot : (Q m ⧸ 𝔪_m) ≃+* (C₀ ⧸ (eqv m).asIdeal) :=
        (DoubleQuot.quotQuotEquivQuotSup I_m (eqv m).asIdeal).trans (Ideal.quotEquivOfEq hsup)
      exact Ideal.Quotient.maximal_of_isField 𝔪_m (eq_quot.toMulEquiv.isField F_m.toIsField)
    have hLoc_Qm : IsLocalRing (Q m) := by
      apply IsLocalRing.of_unique_max_ideal
      refine ⟨𝔪_m, h𝔪_max, ?_⟩
      intro P hP_max
      have : P.IsMaximal := hP_max
      let F_P := Ideal.Quotient.field P
      let ψ_P : C₀ →+* (Q m ⧸ P) := (Ideal.Quotient.mk P).comp mk_m
      have hψ_surj : Function.Surjective ψ_P :=
        Ideal.Quotient.mk_surjective.comp Ideal.Quotient.mk_surjective
      have hker_ψ : RingHom.ker ψ_P = Ideal.comap mk_m P := by
        ext x
        simp [ψ_P, RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]
      let eq_P : (C₀ ⧸ Ideal.comap mk_m P) ≃+* (Q m ⧸ P) :=
        (Ideal.quotEquivOfEq hker_ψ.symm).trans (RingHom.quotientKerEquivOfSurjective hψ_surj)
      have hP'_max : (Ideal.comap mk_m P).IsMaximal :=
        Ideal.Quotient.maximal_of_isField _ (eq_P.toMulEquiv.isField F_P.toIsField)
      let M_P : MaximalSpectrum C₀ := ⟨Ideal.comap mk_m P, hP'_max⟩
      have h1_mem : 1 - e m ∈ M_P.asIdeal := by
        have h_in : 1 - e m ∈ I_m := Ideal.subset_span (Set.mem_singleton _)
        have h_ker : I_m ≤ Ideal.comap mk_m P := by
          intro x hx
          rw [Ideal.mem_comap]
          have hx0 : mk_m x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hx
          rw [hx0]
          exact P.zero_mem
        exact h_ker h_in
      have hMP_eq : M_P = eqv m := by
        by_contra hne
        have h0 : Ideal.Quotient.mk M_P.asIdeal (1 - e m) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr h1_mem
        rw [map_sub, map_one, he_mod M_P] at h0
        have hd0 : δ m M_P = 0 := Pi.single_eq_of_ne hne 1
        rw [hd0, sub_zero] at h0
        have : Nontrivial (C₀ ⧸ M_P.asIdeal) := Ideal.Quotient.nontrivial_iff.mpr hP'_max.ne_top
        exact one_ne_zero h0
      have hcomap_eq : Ideal.comap mk_m P = (eqv m).asIdeal :=
        congrArg MaximalSpectrum.asIdeal hMP_eq
      calc
        P = Ideal.map mk_m (Ideal.comap mk_m P) :=
          (Ideal.map_comap_of_surjective mk_m Ideal.Quotient.mk_surjective P).symm
        _ = 𝔪_m := by rw [hcomap_eq]
    refine ⟨hLoc_Qm, ?_⟩
    intro E _ _ _ q _ hq
    let 𝔪_Q : Ideal (Q m) := IsLocalRing.maximalIdeal (Q m)
    have : Module.Finite Ω (Q m) :=
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ Ω I_m).toLinearMap Ideal.Quotient.mk_surjective
    have : IsArtinianRing (Q m) := IsArtinianRing.of_finite Ω (Q m)
    have hNil_𝔪 : IsNilpotent 𝔪_Q := by
      dsimp only [𝔪_Q]
      rw [← IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal (Q m)) bot_ne_top]
      exact IsArtinianRing.isNilpotent_jacobson_bot
    let κ : Type u := Q m ⧸ 𝔪_Q
    let _ : Field κ := Ideal.Quotient.field 𝔪_Q
    have : Module.Finite Ω κ :=
      Module.Finite.of_surjective
        ((Ideal.Quotient.mkₐ Ω 𝔪_Q) : Q m →ₐ[Ω] κ).toLinearMap Ideal.Quotient.mk_surjective
    have : Algebra.IsIntegral Ω κ := Algebra.IsIntegral.of_finite Ω κ
    let e_κ : Ω ≃ₐ[Ω] κ :=
      AlgEquiv.ofBijective (Algebra.ofId Ω κ) IsAlgClosed.algebraMap_bijective_of_isIntegral
    have : IsAlgClosed κ := by
      apply IsAlgClosed.of_exists_root
      intro p _ hp_irr
      let p_Ω : Polynomial Ω := Polynomial.map e_κ.symm.toRingHom p
      have hpΩ_deg : p_Ω.degree ≠ 0 := by
        rw [Polynomial.degree_map_eq_of_injective e_κ.symm.injective]
        exact hp_irr.degree_pos.ne'
      obtain ⟨ω, hω⟩ := IsAlgClosed.exists_root p_Ω hpΩ_deg
      refine ⟨e_κ ω, ?_⟩
      have hp_eq : Polynomial.map e_κ.toRingHom p_Ω = p := by
        ext n
        simp [p_Ω]
      rw [← hp_eq]
      change Polynomial.eval (e_κ.toRingHom ω) (Polynomial.map e_κ.toRingHom p_Ω) = 0
      rw [Polynomial.eval_map_apply, Polynomial.IsRoot.def.mp hω, map_zero]
    let E_κ : Type u := TensorProduct (Q m) κ E
    have : Algebra.Etale κ E_κ := Algebra.Etale.baseChange (Q m) E κ
    let α_κ : κ →ₐ[Q m] (E ⧸ q) :=
      Ideal.Quotient.liftₐ 𝔪_Q (Algebra.ofId (Q m) (E ⧸ q)) (by
        intro a ha
        dsimp only [𝔪_Q] at ha
        rw [← hq, Ideal.mem_comap] at ha
        change Ideal.Quotient.mk q (algebraMap (Q m) E a) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr ha)
    let ψ_q : E_κ →ₐ[Q m] (E ⧸ q) :=
      Algebra.TensorProduct.lift α_κ (Ideal.Quotient.mkₐ (Q m) q) (fun _ _ => Commute.all _ _)
    let q_κ : Ideal E_κ := Ideal.comap ψ_q.toRingHom ⊥
    have : q_κ.IsPrime := Ideal.comap_isPrime ψ_q.toRingHom ⊥
    obtain ⟨σ_κ, _⟩ := step1_ptHit κ E_κ q_κ
    let f_bar : E →ₐ[Q m] (Q m ⧸ 𝔪_Q) :=
      (σ_κ.restrictScalars (Q m)).comp Algebra.TensorProduct.includeRight
    exact ⟨Algebra.FormallySmooth.lift 𝔪_Q hNil_𝔪 f_bar⟩
  
  have step3_specClopen : ∀ (C₀ : Type u) [CommRing C₀] (r : ℕ)
      (Q : Fin r → Type u) [∀ m, CommRing (Q m)] (e : C₀ ≃+* (∀ m : Fin r, Q m)),
      (∀ m : Fin r, ∃ (_ : IsLocalRing (Q m)),
        ∀ (E : Type u) [CommRing E] [Algebra (Q m) E] [Algebra.Etale (Q m) E]
          (q : Ideal E) [q.IsPrime],
          Ideal.comap (algebraMap (Q m) E) q = IsLocalRing.maximalIdeal (Q m) →
          Nonempty (E →ₐ[Q m] Q m)) →
      let X₀ := Spec (CommRingCat.of C₀)
      let T_X₀ : X₀.Etale := MorphismProperty.Over.mk ⊤ (𝟙 X₀)
        (inferInstance : AlgebraicGeometry.Etale (𝟙 X₀))
      ∀ {F₁ F₂ : Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}} (β : F₁ ⟶ F₂) [Epi β],
        Epi (β.hom.app (Opposite.op T_X₀)) := by
    intro C₀ _ r Q _ e hLocLift X₀ T_X₀ F₁ F₂ β _
    let π_m : ∀ m : Fin r, C₀ →+* Q m := fun m => (Pi.evalRingHom Q m).comp e.toRingHom
    let r_m : Fin r → C₀ := fun m => e.symm (Pi.single m 1)
    have hπ_rm_self : ∀ m : Fin r, π_m m (r_m m) = 1 := by
      intro m; simp [π_m, r_m]
    have hπ_rm_ne : ∀ {m₁ m₂ : Fin r}, m₁ ≠ m₂ → π_m m₂ (r_m m₁) = 0 := by
      intro m₁ m₂ hne; simp [π_m, r_m, Pi.single_eq_of_ne hne.symm]
    have hSurj_π : ∀ m : Fin r, Function.Surjective (π_m m) := by
      intro m s
      exact ⟨e.symm (Pi.single m s), by simp [π_m]⟩
    have hEt_π : ∀ m : Fin r, (π_m m).Etale := by
      intro m
      let _ : Algebra C₀ (Q m) := (π_m m).toAlgebra
      have : IsLocalization.Away (r_m m) (Q m) :=
        IsLocalization.Away.mk (r_m m)
          (by change IsUnit (π_m m (r_m m)); rw [hπ_rm_self]; exact isUnit_one)
          (fun s => ⟨0, e.symm (Pi.single m s), by
            change s * (π_m m (r_m m)) ^ 0 = π_m m (e.symm (Pi.single m s))
            simp [π_m]⟩)
          (fun a b hab => ⟨1, by
            apply e.injective
            ext k
            simp only [pow_one, map_mul, Pi.mul_apply, r_m, RingEquiv.apply_symm_apply]
            by_cases hk : k = m
            · subst hk
              have hab' : e a k = e b k := hab
              rw [hab']
            · simp [Pi.single_eq_of_ne hk]⟩)
      exact Algebra.Etale.of_isLocalizationAway (r_m m)
    let ι_m : ∀ m : Fin r, Spec (CommRingCat.of (Q m)) ⟶ X₀ :=
      fun m => Spec.map (CommRingCat.ofHom (π_m m))
    have hEt_ι : ∀ m : Fin r, AlgebraicGeometry.Etale (ι_m m) :=
      fun m => (HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr (hEt_π m)
    have hCl_ι : ∀ m : Fin r, IsClosedImmersion (ι_m m) :=
      fun m => IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (π_m m)) (hSurj_π m)
    let V_m : Fin r → X₀.Etale := fun m => MorphismProperty.Over.mk ⊤ (ι_m m) (hEt_ι m)
    let v_m : ∀ m : Fin r, V_m m ⟶ T_X₀ :=
      fun m => MorphismProperty.Over.homMk (ι_m m) (Category.comp_id _) trivial
    have hMono_v : ∀ m : Fin r, Mono (v_m m) := by
      intro m
      have : IsClosedImmersion (ι_m m) := hCl_ι m
      refine ⟨fun {W} g₁ g₂ h => MorphismProperty.Over.Hom.ext ?_⟩
      have h' : g₁.left ≫ ι_m m = g₂.left ≫ ι_m m :=
        congrArg (fun (k : W ⟶ T_X₀) => k.left) h
      exact (cancel_mono (ι_m m)).mp h'
    have hSurj_Vm : ∀ m : Fin r, Function.Surjective (β.hom.app (Opposite.op (V_m m))).hom := by
      intro m
      obtain ⟨hLoc_m, hLift_m⟩ := hLocLift m
      have hMem_Vm : ∀ {W : X₀.Etale} (S : Sieve W),
          S ∈ X₀.smallEtaleTopology W → ∀ (τ : V_m m ⟶ W), S.arrows τ := by
        intro W S hS τ
        let S' : Sieve (V_m m) := S.pullback τ
        have hS' : S' ∈ X₀.smallEtaleTopology (V_m m) :=
          X₀.smallEtaleTopology.pullback_stable τ hS
        let z₀ : ↥(V_m m).left := IsLocalRing.closedPoint (Q m)
        obtain ⟨U, u, u₀, hu_S', hu_et, hu₀⟩ := (hMemEtale (V_m m) S').mp hS' z₀
