      diag_cob e₀ σF₀ α₀ u₀ q_E.g₀₀ q_F.g₀₀ hE₀₀ hF₀₀ hσ₀_iso
    have hg₁₁_eq : q_F.g₁₁ = q_E.g₁₁ * (weilTwoChartCoboundary D u₀ u₁).g₁₁ :=
