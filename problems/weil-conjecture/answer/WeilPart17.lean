          (Units.map (Algebra.TensorProduct.includeRight (R := R) (A := T) (B := T)).toRingHom.toMonoidHom u *
            (Units.map (Algebra.TensorProduct.includeLeftRingHom (R := R) (A := T) (B := T)).toMonoidHom u)⁻¹) := by
      intro R T L M _ _ _ _ _ _ _ eL σM α u gL gM hgL hgM hσ
      let iL := Algebra.TensorProduct.includeLeftRingHom (R := R) (A := T) (B := T)
      let iR := (Algebra.TensorProduct.includeRight (R := R) (A := T) (B := T)).toRingHom
