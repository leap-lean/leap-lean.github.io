            exact hq_mem ⟨m_Z₀.base w, hq_eq⟩
          have hSub_emp := empty_sheaf_subsingleton 𝒢₂ (B_i.obj V_et) hEmp
          exact ⟨0, hSub_emp.elim _ _⟩
      choose V_sch g_left hg_et y_pt hy_pt hg_mem using hPt
      exact etale_cover_mem U' (CategoryTheory.Presheaf.imageSieve (pf_i.map φ).hom t)
        ↥U'.left V_sch g_left hg_et (fun x => ⟨x, y_pt x, hy_pt x⟩) hg_mem
    exact @CategoryTheory.Sheaf.epi_of_isLocallySurjective _ _ _ _ _ _ _ _ _ _ _
      (pf_i.map φ) inferInstance hLocSurj_pf

  
  
  
  have hLerayBij : ∀ {𝒜 ℬ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒜] [CategoryTheory.Abelian 𝒜] [CategoryTheory.HasExt.{u} 𝒜]
      [CategoryTheory.Category.{u + 1, u + 1} ℬ] [CategoryTheory.Abelian ℬ] [CategoryTheory.HasExt.{u} ℬ]
      [CategoryTheory.EnoughInjectives ℬ]
      (L : CategoryTheory.Functor 𝒜 ℬ) (R : CategoryTheory.Functor ℬ 𝒜)
      (adj : CategoryTheory.Adjunction L R)
      [L.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits L]
      [CategoryTheory.Limits.PreservesFiniteColimits L]
      (_ : ∀ {Y₁ Y₂ : ℬ} (φ : Y₁ ⟶ Y₂) [CategoryTheory.Epi φ], CategoryTheory.Epi (R.map φ))
      (A₀ : 𝒜) (B₀ : ℬ)
