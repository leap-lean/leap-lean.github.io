          rw [hmap_eq, hop_eq]
        · 
          let O_compl : U₀_sch.Opens :=
            ⟨(Set.range ι₀.base)ᶜ,
              (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι₀).isClosed_range.isOpen_compl⟩
          let g_left : O_compl.toScheme ⟶ U'.left := O_compl.ι ≫ U_aff.ι
