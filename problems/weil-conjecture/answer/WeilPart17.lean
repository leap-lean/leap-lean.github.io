theorem weil_twoChart_hilbert90_descent_and_coboundary_triviality {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
    (T₀ T₁ : Type u) [CommRing T₀] [CommRing T₁]
    [Algebra D.R₀ T₀] [Algebra D.R₁ T₁]
    [Module.FaithfullyFlat D.R₀ T₀] [Module.FaithfullyFlat D.R₁ T₁] :
    ((∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] [Module.FaithfullyFlat R T]
          (g : Units (TensorProduct R T T)),
        let p₁₂ : TensorProduct R T T →ₐ[R] TensorProduct R (TensorProduct R T T) T :=
          Algebra.TensorProduct.includeLeft
        let p₁₃ : TensorProduct R T T →ₐ[R] TensorProduct R (TensorProduct R T T) T :=
          Algebra.TensorProduct.lift
            (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeLeft)
            Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
        let p₂₃ : TensorProduct R T T →ₐ[R] TensorProduct R (TensorProduct R T T) T :=
          Algebra.TensorProduct.lift
            (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeRight)
            Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
        p₁₃ (g : TensorProduct R T T) = p₁₂ (g : TensorProduct R T T) * p₂₃ (g : TensorProduct R T T) →
        ∃ (L : Type u) (_ : AddCommGroup L) (_ : Module R L) (_ : Module.Invertible R L)
          (e : TensorProduct R T L ≃ₗ[T] T),
          (∀ x : L,
            ((1 : T) ⊗ₜ[R] (e ((1 : T) ⊗ₜ[R] x)) : TensorProduct R T T) =
              (g : TensorProduct R T T) * ((e ((1 : T) ⊗ₜ[R] x)) ⊗ₜ[R] (1 : T))) ∧
          Function.Injective (fun x : L => e ((1 : T) ⊗ₜ[R] x)) ∧
          (∀ t : T,
            ((1 : T) ⊗ₜ[R] t : TensorProduct R T T) =
              (g : TensorProduct R T T) * (t ⊗ₜ[R] (1 : T)) →
            ∃ x : L, e ((1 : T) ⊗ₜ[R] x) = t)) →
      ∀ q : WeilTwoChartUnitQuad D T₀ T₁,
        WeilIsTwoChartAlgCocycle D q →
        ∃ (E : WeilTwoChartLineBundle D)
          (e₀ : TensorProduct D.R₀ T₀ E.L₀ ≃ₗ[T₀] T₀)
          (e₁ : TensorProduct D.R₁ T₁ E.L₁ ≃ₗ[T₁] T₁),
          WeilIsTwoChartBundleCocycle D E T₀ T₁ e₀ e₁ q) ∧
    (∀ (F : WeilTwoChartLineBundle D)
        (e₀ : TensorProduct D.R₀ T₀ F.L₀ ≃ₗ[T₀] T₀)
        (e₁ : TensorProduct D.R₁ T₁ F.L₁ ≃ₗ[T₁] T₁)
        (q : WeilTwoChartUnitQuad D T₀ T₁)
        (u₀ : Units T₀) (u₁ : Units T₁),
      WeilIsTwoChartBundleCocycle D F T₀ T₁ e₀ e₁ q →
      q = weilTwoChartCoboundary D u₀ u₁ →
      WeilTwoChartIso D F (WeilTwoChartTrivial D)) :=
