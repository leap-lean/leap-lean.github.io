            (AlgebraicGeometry.Scheme.Hom.comp_appTop f.left V.1.ι)).symm
        exact hc1.trans (ha' (f ≫ j_of V.1) hf)
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J (weilEtaleGmPresheaf C₀)
      (CategoryTheory.forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    intro U R_u hR u_fam hu_compat
    have hR_gen : CategoryTheory.Sieve.generate R_u.arrows ∈ J U := by
      rwa [CategoryTheory.Sieve.generate_sieve]
    let u_at : ∀ {Y : C₀.Etale} (f : Y ⟶ U), R_u.arrows f →
        Units ↑(Y.left.presheaf.obj (Opposite.op ⊤)) :=
      fun {Y} f hf =>
        @Additive.toMul (Units ↑(Y.left.presheaf.obj (Opposite.op ⊤))) (u_fam f hf)
    let a_fam : CategoryTheory.Presieve.FamilyOfElements P_ring R_u.arrows :=
      fun Y f hf => (u_at f hf).val
    let b_fam : CategoryTheory.Presieve.FamilyOfElements P_ring R_u.arrows :=
      fun Y f hf => (u_at f hf).inv
    have ha_compat : a_fam.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      have hu_eq : Units.map g₁.left.appTop.hom.toMonoidHom (u_at f₁ hf₁) =
          Units.map g₂.left.appTop.hom.toMonoidHom (u_at f₂ hf₂) :=
        congrArg (@Additive.toMul (Units ↑(Z.left.presheaf.obj (Opposite.op ⊤))))
          (hu_compat g₁ g₂ hf₁ hf₂ hcomm)
      exact congrArg Units.val hu_eq
    have hb_compat : b_fam.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      have hu_eq : Units.map g₁.left.appTop.hom.toMonoidHom (u_at f₁ hf₁) =
          Units.map g₂.left.appTop.hom.toMonoidHom (u_at f₂ hf₂) :=
        congrArg (@Additive.toMul (Units ↑(Z.left.presheaf.obj (Opposite.op ⊤))))
          (hu_compat g₁ g₂ hf₁ hf₂ hcomm)
      exact congrArg Units.inv hu_eq
    let a : ↑(U.left.presheaf.obj (Opposite.op ⊤)) :=
      (hRingSheaf.isSheafFor R_u.arrows hR_gen).amalgamate a_fam ha_compat
    let b : ↑(U.left.presheaf.obj (Opposite.op ⊤)) :=
      (hRingSheaf.isSheafFor R_u.arrows hR_gen).amalgamate b_fam hb_compat
    have ha_glue : ∀ {Y : C₀.Etale} (f : Y ⟶ U) (hf : R_u.arrows f),
        f.left.appTop.hom a = a_fam f hf :=
      fun f hf => (hRingSheaf.isSheafFor R_u.arrows hR_gen).valid_glue ha_compat f hf
    have hb_glue : ∀ {Y : C₀.Etale} (f : Y ⟶ U) (hf : R_u.arrows f),
        f.left.appTop.hom b = b_fam f hf :=
      fun f hf => (hRingSheaf.isSheafFor R_u.arrows hR_gen).valid_glue hb_compat f hf
    have hab : a * b = 1 := by
      apply (hRingSheaf.isSheafFor R_u.arrows hR_gen).isSeparatedFor.ext
      intro Y f hf
      change f.left.appTop.hom (a * b) = f.left.appTop.hom 1
      rw [map_mul, map_one, ha_glue f hf, hb_glue f hf]
      exact (u_at f hf).val_inv
    have hba : b * a = 1 := (mul_comm b a).trans hab
    let u₀ : Additive (Units ↑(U.left.presheaf.obj (Opposite.op ⊤))) :=
      Additive.ofMul ⟨a, b, hab, hba⟩
    refine ⟨u₀, ?_, ?_⟩
    · intro Y f hf
      apply (@Additive.toMul (Units ↑(Y.left.presheaf.obj (Opposite.op ⊤)))).injective
      apply Units.ext
      exact ha_glue f hf
    · intro u' hu'
      apply (@Additive.toMul (Units ↑(U.left.presheaf.obj (Opposite.op ⊤)))).injective
      apply Units.ext
      apply (hRingSheaf.isSheafFor R_u.arrows hR_gen).isSeparatedFor.ext
      intro Y f hf
      have hu'_f : Units.map f.left.appTop.hom.toMonoidHom
          (@Additive.toMul (Units ↑(U.left.presheaf.obj (Opposite.op ⊤))) u') =
          u_at f hf :=
        congrArg (@Additive.toMul (Units ↑(Y.left.presheaf.obj (Opposite.op ⊤)))) (hu' f hf)
      exact (congrArg Units.val hu'_f).trans (ha_glue f hf).symm

  
