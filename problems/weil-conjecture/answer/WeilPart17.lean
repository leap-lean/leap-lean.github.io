      intro z hz
      obtain ⟨h, rfl⟩ := hBij₀.surjective z
      have hmul : Ψ₀ (fun j => Polynomial.X * h j) = Ψ₀ 0 := by
        have h0 : Ψ₀ 0 = 0 := by simp [Ψ₀]
        rw [h0, ← hz]
        dsimp [Ψ₀, t₀]
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, mul_assoc]
      have h_eq0 : (fun j => Polynomial.X * h j) = 0 := hBij₀.injective hmul
      have hh0 : h = 0 := by
        funext j
        ext n
        have hc := congrArg (fun p : Polynomial k => p.coeff (n + 1)) (congrFun h_eq0 j)
        simpa [Polynomial.coeff_X_mul] using hc
      rw [hh0]
      simp [Ψ₀]
    rw [mem_nonZeroDivisors_iff]
    exact ⟨ht₀_mul, fun z hz => ht₀_mul z (mul_comm t₀ z ▸ hz)⟩
  have hu₁_nzd : u₁ ∈ nonZeroDivisors D₀.R₁ := by
    have hu₁_mul : ∀ z : D₀.R₁, u₁ * z = 0 → z = 0 := by
      intro z hz
      obtain ⟨h, rfl⟩ := hBij₁.surjective z
      have hmul : Ψ₁ (fun j => Polynomial.X * h j) = Ψ₁ 0 := by
        have h0 : Ψ₁ 0 = 0 := by simp [Ψ₁]
        rw [h0, ← hz]
        dsimp [Ψ₁, u₁]
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, mul_assoc]
      have h_eq0 : (fun j => Polynomial.X * h j) = 0 := hBij₁.injective hmul
      have hh0 : h = 0 := by
        funext j
        ext n
        have hc := congrArg (fun p : Polynomial k => p.coeff (n + 1)) (congrFun h_eq0 j)
        simpa [Polynomial.coeff_X_mul] using hc
      rw [hh0]
      simp [Ψ₁]
    rw [mem_nonZeroDivisors_iff]
    exact ⟨hu₁_mul, fun z hz => hu₁_mul z (mul_comm u₁ z ▸ hz)⟩
  haveI : IsLocalization.Away t₀ D₀.R₀₁ := hLoc₀
  haveI : IsLocalization.Away u₁ D₀.R₀₁ := hLoc₁
  have hInj₀ : Function.Injective σ₀ :=
    IsLocalization.injective D₀.R₀₁ (Submonoid.powers_le.mpr ht₀_nzd)
  have hInj₁ : Function.Injective σ₁ :=
    IsLocalization.injective D₀.R₀₁ (Submonoid.powers_le.mpr hu₁_nzd)
  let Ψ₀_hom : (Fin D₀.r → Polynomial k) →+ D₀.R₀ :=
    { toFun := Ψ₀
      map_zero' := by simp [Ψ₀]
      map_add' := fun f₁ f₂ => by
        dsimp [Ψ₀]
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_add, add_mul] }
  let eΨ₀ : (Fin D₀.r → Polynomial k) ≃+ D₀.R₀ :=
    AddEquiv.ofBijective Ψ₀_hom hBij₀
  let L₀ : D₀.R₀ →+ (Fin D₀.r → k) :=
    { toFun := fun r₀ j => (eΨ₀.symm r₀ j).coeff 0
      map_zero' := by
        funext j
        simp
      map_add' := fun x y => by
        funext j
        simp [map_add] }
  have hL₀_smul : ∀ (c : k) (r₀ : D₀.R₀), L₀ (φ₀ c * r₀) = c • L₀ r₀ := by
    intro c r₀
    let f := eΨ₀.symm r₀
    have hf : eΨ₀ f = r₀ := eΨ₀.apply_symm_apply r₀
    have hcf : eΨ₀ (fun j => Polynomial.C c * f j) = φ₀ c * r₀ := by
      rw [← hf]
      change Ψ₀ (fun j => Polynomial.C c * f j) = ι₀ (Polynomial.C c) * Ψ₀ f
      dsimp [Ψ₀]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, mul_assoc]
    have hsymm : eΨ₀.symm (φ₀ c * r₀) = fun j => Polynomial.C c * f j := by
      rw [← hcf, eΨ₀.symm_apply_apply]
    funext j
    change (eΨ₀.symm (φ₀ c * r₀) j).coeff 0 = c * (f j).coeff 0
    rw [hsymm, Polynomial.coeff_C_mul]
  have htu_cancel : ∀ {n M : ℕ}, n ≤ M → t_bar ^ M * u_bar ^ n = t_bar ^ (M - n) := by
    intro n M hn
    have hM : M = (M - n) + n := (Nat.sub_add_cancel hn).symm
    calc
      t_bar ^ M * u_bar ^ n = t_bar ^ ((M - n) + n) * u_bar ^ n := by conv_lhs => rw [hM]
      _ = t_bar ^ (M - n) * (t_bar ^ n * u_bar ^ n) := by rw [pow_add, mul_assoc]
      _ = t_bar ^ (M - n) * (t_bar * u_bar) ^ n := by rw [← mul_pow]
      _ = t_bar ^ (M - n) := by rw [htu, one_pow, mul_one]
  have hL₀_eq0 : ∀ (r₀ : D₀.R₀) (r₁ : D₀.R₁), σ₀ r₀ = σ₁ r₁ → L₀ r₀ = 0 → r₀ = 0 := by
    intro r₀ r₁ h_eq hL₀
    let f : Fin D₀.r → Polynomial k := eΨ₀.symm r₀
    have hf : Ψ₀ f = r₀ := eΨ₀.apply_symm_apply r₀
    obtain ⟨g, hg⟩ := hBij₁.surjective r₁
    have hg' : Ψ₁ g = r₁ := hg
    let M : ℕ := Finset.univ.sup (fun j : Fin D₀.r => (g j).natDegree + D₀.w j)
    let H : Fin D₀.r → Polynomial k := fun j =>
      ∑ d ∈ Finset.range ((g j).natDegree + 1),
        Polynomial.C ((g j).coeff d) * Polynomial.X ^ (M - (d + D₀.w j))
    have hLHS : t_bar ^ M * σ₀ (Ψ₀ f) = σ₀ (Ψ₀ (fun j => Polynomial.X ^ M * f j)) := by
      dsimp [Ψ₀, t_bar, t₀]
      rw [map_sum, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [map_mul, map_pow]
      ring
    have hRHS : t_bar ^ M * σ₁ (Ψ₁ g) = σ₀ (Ψ₀ H) := by
      dsimp [Ψ₁, Ψ₀, H]
      rw [map_sum, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      have hgj := Polynomial.as_sum_range_C_mul_X_pow (g j)
      rw [map_mul, map_mul]
      conv_lhs => rw [hgj]
      rw [map_sum, map_sum, map_sum, map_sum, Finset.sum_mul, Finset.mul_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun d hd => ?_
      have hd_le : d + D₀.w j ≤ M := by
        have hd_lt : d < (g j).natDegree + 1 := Finset.mem_range.mp hd
        have h_sup : (g j).natDegree + D₀.w j ≤ M :=
          Finset.le_sup (f := fun i : Fin D₀.r => (g i).natDegree + D₀.w i) (Finset.mem_univ j)
        omega
      rw [map_mul, map_mul, map_mul, map_mul, map_pow, map_pow, map_pow, map_pow,
        ← hC_eq ((g j).coeff d), hb₁_eq j]
      change t_bar ^ M * ((σ₀ (ι₀ (Polynomial.C ((g j).coeff d))) * u_bar ^ d) *
          (u_bar ^ D₀.w j * σ₀ (D₀.b₀ j))) =
        (σ₀ (ι₀ (Polynomial.C ((g j).coeff d))) * t_bar ^ (M - (d + D₀.w j))) * σ₀ (D₀.b₀ j)
      have hmul : t_bar ^ M * ((σ₀ (ι₀ (Polynomial.C ((g j).coeff d))) * u_bar ^ d) *
          (u_bar ^ D₀.w j * σ₀ (D₀.b₀ j))) =
          σ₀ (ι₀ (Polynomial.C ((g j).coeff d))) *
            (t_bar ^ M * u_bar ^ (d + D₀.w j)) * σ₀ (D₀.b₀ j) := by
        rw [pow_add]
        ring
      rw [hmul, htu_cancel hd_le]
    have hΨ_eq : σ₀ (Ψ₀ (fun j => Polynomial.X ^ M * f j)) = σ₀ (Ψ₀ H) := by
      rw [← hLHS, ← hRHS, hf, hg', h_eq]
    have hPoly_eq : (fun j => Polynomial.X ^ M * f j) = H :=
      hBij₀.injective (hInj₀ hΨ_eq)
    have hf0 : f = 0 := by
      funext j
      ext n
      cases n with
      | zero =>
        change L₀ r₀ j = 0
        rw [hL₀]
        rfl
      | succ m =>
        change (f j).coeff (m + 1) = 0
        have hc := congrArg (fun p : Polynomial k => p.coeff ((m + 1) + M)) (congrFun hPoly_eq j)
        rw [Polynomial.coeff_X_pow_mul] at hc
        dsimp [H] at hc
        rw [Polynomial.finsetSum_coeff] at hc
        rw [hc]
        apply Finset.sum_eq_zero
        intro d _
        rw [Polynomial.coeff_C_mul_X_pow]
        have hne : (m + 1) + M ≠ M - (d + D₀.w j) := by omega
        exact if_neg hne
    rw [← hf, hf0]
    simp [Ψ₀]

  letI : Algebra k S := κ.toAlgebra
  let Λ : S →ₗ[k] (Fin D₀.r → k) :=
    { toFun := fun s => L₀ (ρ₀ s)
      map_add' := fun s₁ s₂ => by rw [map_add, map_add]
      map_smul' := fun c s => by
        change L₀ (ρ₀ (κ c * s)) = c • L₀ (ρ₀ s)
        rw [map_mul, hκ c]
        exact hL₀_smul c (ρ₀ s) }
  have hΛ_inj : Function.Injective Λ := by
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro s hs
    rw [LinearMap.mem_ker] at hs
    have hρ₀s : ρ₀ s = 0 := hL₀_eq0 (ρ₀ s) (ρ₁ s) (hOv s) hs
    have hσ₁ : σ₁ (ρ₁ s) = σ₁ 0 := by
      rw [← hOv s, hρ₀s, map_zero, map_zero]
    have hρ₁s : ρ₁ s = 0 := hInj₁ hσ₁
    exact hJointInj s hρ₀s hρ₁s
  haveI : FiniteDimensional k S := FiniteDimensional.of_injective Λ hΛ_inj

  
  have hℓ_pos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hTaylor : ∀ {R : Type u} [CommRing R] (a b : R) (n : ℕ),
      ∃ r : R, (a + b) ^ n = a ^ n + (n : R) * a ^ (n - 1) * b + b ^ 2 * r := by
    intro R _ a b n
    induction n with
    | zero => exact ⟨0, by simp⟩
    | succ m ih =>
      cases m with
      | zero => exact ⟨0, by simp⟩
      | succ m =>
        obtain ⟨r, hr⟩ := ih
        refine ⟨((m + 1 : ℕ) : R) * a ^ m + r * (a + b), ?_⟩
        change (a + b) ^ (m + 2) = a ^ (m + 2) + ((m + 2 : ℕ) : R) * a ^ (m + 1) * b + b ^ 2 * _
        have hr' : (a + b) ^ (m + 1) = a ^ (m + 1) + ((m + 1 : ℕ) : R) * a ^ m * b + b ^ 2 * r := hr
        rw [pow_succ (a + b) (m + 1), hr', pow_succ a (m + 1)]
        push_cast
        ring
  have hHensel : ∀ (α : k), α ≠ 0 → ∀ (m : ℕ),
      ∃ Q₁ : Polynomial k, (Polynomial.X - Polynomial.C α) ^ m ∣ (Q₁ ^ ℓ - Polynomial.X) := by
    intro α hα m
    cases m with
    | zero => exact ⟨0, by rw [pow_zero]; exact one_dvd _⟩
    | succ s =>
      obtain ⟨β, hβ⟩ := IsAlgClosed.exists_pow_nat_eq α hℓ_pos
      have hβ_ne : β ≠ 0 := by
        intro h0
        apply hα
        rw [← hβ, h0, zero_pow hℓ_pos.ne']
      let T : Polynomial k := Polynomial.X - Polynomial.C α
      suffices h_ind : ∃ q : Polynomial k, q.eval α = β ∧ T ^ (s + 1) ∣ (q ^ ℓ - Polynomial.X) by
        obtain ⟨q, _, hq_dvd⟩ := h_ind
        exact ⟨q, hq_dvd⟩
      induction s with
      | zero =>
        refine ⟨Polynomial.C β, Polynomial.eval_C, ?_⟩
        rw [pow_one]
        apply Polynomial.dvd_iff_isRoot.mpr
        simp [Polynomial.IsRoot, hβ]
      | succ s ih =>
        obtain ⟨q, hq_eval, E, hq_eq⟩ := ih
        let N : ℕ := s + 1
        have hN_ne : N ≠ 0 := Nat.succ_ne_zero s
        let denom : k := (ℓ : k) * β ^ (ℓ - 1)
        have hdenom_ne : denom ≠ 0 := mul_ne_zero hℓ (pow_ne_zero _ hβ_ne)
        let γ : k := -(E.eval α) / denom
        let q' : Polynomial k := q + Polynomial.C γ * T ^ N
        refine ⟨q', ?_, ?_⟩
        · simp [q', T, hq_eval, zero_pow hN_ne]
        · obtain ⟨r, hr⟩ := hTaylor q (Polynomial.C γ * T ^ N) ℓ
          let F₁ : Polynomial k := E + Polynomial.C ((ℓ : k) * γ) * q ^ (ℓ - 1)
          have hF₁_root : F₁.IsRoot α := by
            simp only [F₁, Polynomial.IsRoot, Polynomial.eval_add, Polynomial.eval_mul,
              Polynomial.eval_C, Polynomial.eval_pow, hq_eval]
            have hcancel : ((ℓ : k) * γ) * β ^ (ℓ - 1) = -(E.eval α) := by
              calc
                ((ℓ : k) * γ) * β ^ (ℓ - 1) = γ * denom := by dsimp [denom]; ring
                _ = (-(E.eval α) / denom) * denom := rfl
                _ = -(E.eval α) := div_mul_cancel₀ _ hdenom_ne
            rw [hcancel, add_neg_cancel]
          obtain ⟨F₂, hF₂⟩ := Polynomial.dvd_iff_isRoot.mpr hF₁_root
          have hcast_ℓ : (ℓ : Polynomial k) = Polynomial.C (ℓ : k) :=
            (map_natCast Polynomial.C ℓ).symm
          have hTN_sq : (T ^ N) ^ 2 = T ^ (N + 1) * T ^ s := by
            rw [← pow_mul, ← pow_add]
            congr 1
            dsimp [N]
            omega
          have hq'_eq : q' ^ ℓ - Polynomial.X =
              T ^ (N + 1) * (F₂ + Polynomial.C (γ ^ 2) * T ^ s * r) := by
            have h1 : q' ^ ℓ - Polynomial.X =
                (q ^ ℓ - Polynomial.X) + (ℓ : Polynomial k) * q ^ (ℓ - 1) * (Polynomial.C γ * T ^ N) +
                  (Polynomial.C γ * T ^ N) ^ 2 * r := by
              dsimp [q']
              rw [hr]
              ring
            have h2 : (Polynomial.C γ * T ^ N) ^ 2 = Polynomial.C (γ ^ 2) * (T ^ N) ^ 2 := by
              rw [mul_pow, ← map_pow Polynomial.C γ 2]
            rw [h1, hq_eq, hcast_ℓ, h2, hTN_sq]
            calc
              T ^ N * E + Polynomial.C (ℓ : k) * q ^ (ℓ - 1) * (Polynomial.C γ * T ^ N) +
                  Polynomial.C (γ ^ 2) * (T ^ (N + 1) * T ^ s) * r =
                T ^ N * (E + (Polynomial.C (ℓ : k) * Polynomial.C γ) * q ^ (ℓ - 1)) +
                  T ^ (N + 1) * (Polynomial.C (γ ^ 2) * T ^ s * r) := by ring
              _ = T ^ N * F₁ + T ^ (N + 1) * (Polynomial.C (γ ^ 2) * T ^ s * r) := by
                rw [← map_mul Polynomial.C (ℓ : k) γ]
              _ = T ^ N * (T * F₂) + T ^ (N + 1) * (Polynomial.C (γ ^ 2) * T ^ s * r) := by
                rw [hF₂]
              _ = T ^ (N + 1) * (F₂ + Polynomial.C (γ ^ 2) * T ^ s * r) := by
                rw [← mul_assoc, ← pow_succ]
                ring
          exact ⟨F₂ + Polynomial.C (γ ^ 2) * T ^ s * r, hq'_eq⟩
  have hBezout : ∀ (d : ℕ) (P : Polynomial k),
      P.natDegree = d → P ≠ 0 → P.eval 0 ≠ 0 →
      ∃ Q : Polynomial k, P ∣ (Q ^ ℓ - Polynomial.X) := by
    intro d
    induction d using Nat.strong_induction_on with
    | h d ih =>
      intro P hd hP_ne hP0
      by_cases hd0 : d = 0
      · subst hd0
        have hP_C : P = Polynomial.C (P.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero hd
        have hc_ne : P.coeff 0 ≠ 0 := by
          intro hc0
          apply hP_ne
          rw [hP_C, hc0, map_zero]
        have hUnit : IsUnit P := by
          rw [hP_C]
          exact (IsUnit.mk0 (P.coeff 0) hc_ne).map Polynomial.C
        exact ⟨0, hUnit.dvd⟩
      · have hdeg_ne : P.degree ≠ 0 := by
          have hd_ne : P.natDegree ≠ 0 := by omega
          simpa using Polynomial.degree_ne_of_natDegree_ne hd_ne
        obtain ⟨α, hα_root⟩ := IsAlgClosed.exists_root P hdeg_ne
        have hα_ne : α ≠ 0 := by
          intro hα0
          subst hα0
          exact hP0 hα_root
        let m : ℕ := Polynomial.rootMultiplicity α P
        have hm_pos : 0 < m := (Polynomial.rootMultiplicity_pos hP_ne).mpr hα_root
        let T : Polynomial k := Polynomial.X - Polynomial.C α
        obtain ⟨R, hPR⟩ := Polynomial.pow_rootMultiplicity_dvd P α
        have hR_ne : R ≠ 0 := by
          intro hR0
          apply hP_ne
          rw [hPR, hR0, mul_zero]
        have hR0 : R.eval 0 ≠ 0 := by
          intro hR0_eq
          apply hP0
          rw [hPR, Polynomial.eval_mul, hR0_eq, mul_zero]
        have hRα : R.eval α ≠ 0 := by
          intro hRα_eq
          obtain ⟨R₁, hR₁⟩ := Polynomial.dvd_iff_isRoot.mpr hRα_eq
          have hdvd_succ : T ^ (m + 1) ∣ P := by
            refine ⟨R₁, ?_⟩
            rw [hPR, hR₁, pow_succ, mul_assoc]
          have hle : m + 1 ≤ m := (Polynomial.le_rootMultiplicity_iff hP_ne).mpr hdvd_succ
          omega
        have hCop_T : IsCoprime T R := by
          have hdiff_root : (R - Polynomial.C (R.eval α)).IsRoot α := by
            simp [Polynomial.IsRoot]
          obtain ⟨S₀, hS₀⟩ := Polynomial.dvd_iff_isRoot.mpr hdiff_root
          let cinv : k := (R.eval α)⁻¹
          refine ⟨-Polynomial.C cinv * S₀, Polynomial.C cinv, ?_⟩
          have hR_eq : R = T * S₀ + Polynomial.C (R.eval α) := sub_eq_iff_eq_add.mp hS₀
          calc
            (-Polynomial.C cinv * S₀) * T + Polynomial.C cinv * R =
                (-Polynomial.C cinv * S₀) * T + Polynomial.C cinv * (T * S₀ + Polynomial.C (R.eval α)) := by
              conv_lhs => rw [hR_eq]
            _ = Polynomial.C cinv * Polynomial.C (R.eval α) := by ring
            _ = Polynomial.C (cinv * R.eval α) := (map_mul Polynomial.C cinv (R.eval α)).symm
            _ = Polynomial.C 1 := by rw [inv_mul_cancel₀ hRα]
            _ = 1 := map_one Polynomial.C
        have hCop : IsCoprime (T ^ m) R := hCop_T.pow_left
        have hTm_monic : (T ^ m).Monic := (Polynomial.monic_X_sub_C α).pow m
        have hTm_deg : (T ^ m).natDegree = m := by
          rw [Polynomial.Monic.natDegree_pow (Polynomial.monic_X_sub_C α) m,
            Polynomial.natDegree_X_sub_C α, mul_one]
        have hR_deg_lt : R.natDegree < d := by
          have hdeg_mul : P.natDegree = (T ^ m).natDegree + R.natDegree := by
            rw [hPR, Polynomial.natDegree_mul hTm_monic.ne_zero hR_ne]
          omega
        obtain ⟨Q₁, hQ₁⟩ := hHensel α hα_ne m
        obtain ⟨Q₂, hQ₂⟩ := ih R.natDegree hR_deg_lt R rfl hR_ne hR0
        have ⟨u₁, u₂, hu⟩ := hCop
        let Q : Polynomial k := u₁ * T ^ m * Q₂ + u₂ * R * Q₁
        refine ⟨Q, ?_⟩
        have hQ_sub_Q₁ : T ^ m ∣ (Q - Q₁) := by
          refine ⟨u₁ * (Q₂ - Q₁), ?_⟩
          have hu₂ : u₂ * R = 1 - u₁ * T ^ m := eq_sub_of_add_eq' hu
          calc
            Q - Q₁ = u₁ * T ^ m * Q₂ + (u₂ * R) * Q₁ - Q₁ := rfl
            _ = u₁ * T ^ m * Q₂ + (1 - u₁ * T ^ m) * Q₁ - Q₁ := by rw [hu₂]
            _ = T ^ m * (u₁ * (Q₂ - Q₁)) := by ring
        have hTm_dvd : T ^ m ∣ (Q ^ ℓ - Polynomial.X) := by
          have hd1 : T ^ m ∣ (Q ^ ℓ - Q₁ ^ ℓ) :=
            dvd_trans hQ_sub_Q₁ (sub_dvd_pow_sub_pow Q Q₁ ℓ)
          have hd2 := dvd_add hd1 hQ₁
          simpa only [sub_add_sub_cancel] using hd2
        have hQ_sub_Q₂ : R ∣ (Q - Q₂) := by
          refine ⟨u₂ * (Q₁ - Q₂), ?_⟩
          have hu₁ : u₁ * T ^ m = 1 - u₂ * R := eq_sub_of_add_eq hu
          calc
            Q - Q₂ = (u₁ * T ^ m) * Q₂ + u₂ * R * Q₁ - Q₂ := rfl
            _ = (1 - u₂ * R) * Q₂ + u₂ * R * Q₁ - Q₂ := by rw [hu₁]
            _ = R * (u₂ * (Q₁ - Q₂)) := by ring
        have hR_dvd : R ∣ (Q ^ ℓ - Polynomial.X) := by
          have hd1 : R ∣ (Q ^ ℓ - Q₂ ^ ℓ) :=
            dvd_trans hQ_sub_Q₂ (sub_dvd_pow_sub_pow Q Q₂ ℓ)
          have hd2 := dvd_add hd1 hQ₂
          simpa only [sub_add_sub_cancel] using hd2
        rw [hPR]
        exact hCop.mul_dvd hTm_dvd hR_dvd

  have hUnitPow : ∀ u_unit : Units S, ∃ v_unit : Units S, v_unit ^ ℓ = u_unit := by
    intro u_unit
    by_cases hSub : Subsingleton S
    · exact ⟨1, Units.ext (Subsingleton.elim _ _)⟩
    · haveI : Nontrivial S := not_subsingleton_iff_nontrivial.mp hSub
      have hu_int : IsIntegral k (u_unit : S) := IsIntegral.of_finite k (u_unit : S)
      let P : Polynomial k := minpoly k (u_unit : S)
      have hP_monic : P.Monic := minpoly.monic hu_int
      have hP_ne : P ≠ 0 := hP_monic.ne_zero
      have hP0 : P.eval 0 ≠ 0 := by
        intro h0
        obtain ⟨H, hPH⟩ := Polynomial.dvd_iff_isRoot.mpr h0
        have hPH' : P = Polynomial.X * H := by
          simpa using hPH
        have hH_ne : H ≠ 0 := by
          intro hH0
          apply hP_ne
          rw [hPH', hH0, mul_zero]
        have hdeg : P.natDegree = 1 + H.natDegree := by
          rw [hPH', Polynomial.natDegree_mul Polynomial.X_ne_zero hH_ne, Polynomial.natDegree_X]
        have haeval0 : Polynomial.aeval (u_unit : S) P = 0 := minpoly.aeval k (u_unit : S)
        rw [hPH', map_mul, Polynomial.aeval_X] at haeval0
        have hH_aeval : Polynomial.aeval (u_unit : S) H = 0 := by
          calc
            Polynomial.aeval (u_unit : S) H =
                ((↑u_unit⁻¹ : S) * (u_unit : S)) * Polynomial.aeval (u_unit : S) H := by
              rw [Units.inv_mul, one_mul]
            _ = (↑u_unit⁻¹ : S) * ((u_unit : S) * Polynomial.aeval (u_unit : S) H) :=
              mul_assoc _ _ _
            _ = 0 := by rw [haeval0, mul_zero]
        have hdvd_PH : P ∣ H := minpoly.dvd k (u_unit : S) hH_aeval
        have hdeg_le : P.natDegree ≤ H.natDegree :=
          Polynomial.natDegree_le_of_dvd hdvd_PH hH_ne
        omega
      obtain ⟨Q, K, hQK⟩ := hBezout P.natDegree P rfl hP_ne hP0
      let v₀ : S := Polynomial.aeval (u_unit : S) Q
      have hv₀_pow : v₀ ^ ℓ = (u_unit : S) := by
        have haeval := congrArg (Polynomial.aeval (u_unit : S)) hQK
        rw [map_sub, map_pow, Polynomial.aeval_X, map_mul, minpoly.aeval k (u_unit : S),
          zero_mul] at haeval
        exact sub_eq_zero.mp haeval
      let w₀ : S := v₀ ^ (ℓ - 1) * (↑u_unit⁻¹ : S)
      have hvw : v₀ * w₀ = 1 := by
        dsimp [w₀]
        rw [← mul_assoc, ← pow_succ' v₀ (ℓ - 1), Nat.sub_add_cancel hℓ_pos, hv₀_pow,
          Units.mul_inv]
      refine ⟨⟨v₀, w₀, hvw, mul_comm v₀ w₀ ▸ hvw⟩, ?_⟩
      ext
      exact hv₀_pow

  
  intro u
  obtain ⟨v_unit, hv_pow⟩ := hUnitPow (Additive.toMul (e_H0 u))
  refine ⟨e_H0.symm (Additive.ofMul v_unit), ?_⟩
  rw [← map_nsmul, ← ofMul_pow ℓ v_unit, hv_pow]
  exact e_H0.symm_apply_apply u

theorem weil_faithfullyFlat_hilbert90_and_invertible_zariski_split : (∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] [Module.FaithfullyFlat R T]
        (g : Units (TensorProduct R T T)),
      let p₁₂ : TensorProduct R T T →ₐ[R] TensorProduct R (TensorProduct R T T) T :=
        Algebra.TensorProduct.includeLeft
      let p₁₃ : TensorProduct R T T →ₐ[R] TensorProduct R (TensorProduct R T T) T :=
        Algebra.TensorProduct.lift
          (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeLeft)
          Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
      let p₂₃ : TensorProduct R T T →ₐ[R] TensorProduct R (TensorProduct R T T) T :=
        Algebra.TensorProduct.lift
          (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeRight)
          Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
      p₁₃ (g : TensorProduct R T T) = p₁₂ (g : TensorProduct R T T) * p₂₃ (g : TensorProduct R T T) →
      ∃ (L : Type u) (_ : AddCommGroup L) (_ : Module R L) (_ : Module.Invertible R L)
        (e : TensorProduct R T L ≃ₗ[T] T),
        (∀ x : L,
          ((1 : T) ⊗ₜ[R] (e ((1 : T) ⊗ₜ[R] x)) : TensorProduct R T T) =
            (g : TensorProduct R T T) * ((e ((1 : T) ⊗ₜ[R] x)) ⊗ₜ[R] (1 : T))) ∧
        Function.Injective (fun x : L => e ((1 : T) ⊗ₜ[R] x)) ∧
        (∀ t : T,
          ((1 : T) ⊗ₜ[R] t : TensorProduct R T T) =
            (g : TensorProduct R T T) * (t ⊗ₜ[R] (1 : T)) →
          ∃ x : L, e ((1 : T) ⊗ₜ[R] x) = t)) ∧
    (∀ (R L : Type u) [CommRing R] [AddCommGroup L] [Module R L] [Module.Invertible R L],
      ∃ (m : ℕ) (f : Fin m → R)
        (_ : ∀ a : Fin m,
          TensorProduct R (Localization.Away (f a)) L ≃ₗ[Localization.Away (f a)]
            Localization.Away (f a)),
        Finset.univ.sum f = 1) :=
by
  classical
  constructor
  · intro R T _ _ _ _ g p₁₂ p₁₃ p₂₃ hg
    haveI : Module.Flat R T := Module.FaithfullyFlat.toFlat
    have h_inj : Function.Injective (algebraMap R T) :=
      RingHom.FaithfullyFlat.injective
        (RingHom.faithfullyFlat_algebraMap_iff.mpr (inferInstance : Module.FaithfullyFlat R T))
    have h_eq : ∀ t : T,
        ((1 : T) ⊗ₜ[R] t : TensorProduct R T T) = t ⊗ₜ[R] (1 : T) →
        ∃ r : R, algebraMap R T r = t := by
      let ι_R : R →ₗ[R] T := Algebra.linearMap R T
      let incR : T →ₗ[R] TensorProduct R T T :=
        (Algebra.TensorProduct.includeRight : T →ₐ[R] TensorProduct R T T).toLinearMap
      let incL : T →ₗ[R] TensorProduct R T T :=
        (Algebra.TensorProduct.includeLeft : T →ₐ[R] TensorProduct R T T).toLinearMap
      let δ₁ : T →ₗ[R] TensorProduct R T T := incR - incL
      have h_rTensor_exact :
          Function.Exact (LinearMap.rTensor T ι_R) (LinearMap.rTensor T δ₁) := by
        let σ : TensorProduct R (TensorProduct R T T) T →ₗ[R] TensorProduct R T T :=
          (LinearMap.lTensor T (Algebra.TensorProduct.lmul' R (S := T)).toLinearMap).comp
            (TensorProduct.assoc R T T T).toLinearMap
        have hσ : σ.comp (LinearMap.rTensor T δ₁) =
            incR.comp (Algebra.TensorProduct.lmul' R (S := T)).toLinearMap - LinearMap.id := by
          apply TensorProduct.ext'
          intro u v
          simp [σ, δ₁, incR, incL, TensorProduct.sub_tmul]
        intro w
        constructor
        · intro hw
          have h0 : (σ.comp (LinearMap.rTensor T δ₁)) w = 0 := by
            simp [hw]
          rw [hσ, LinearMap.sub_apply, LinearMap.comp_apply, LinearMap.id_apply, sub_eq_zero] at h0
          refine ⟨(1 : R) ⊗ₜ[R] Algebra.TensorProduct.lmul' R (S := T) w, ?_⟩
          simpa [ι_R, incR] using h0
        · rintro ⟨z, rfl⟩
          have hcomp : (LinearMap.rTensor T δ₁).comp (LinearMap.rTensor T ι_R) = 0 := by
            apply TensorProduct.ext'
            intro r s
            have hδr : δ₁ (ι_R r) = 0 := by
              simp only [δ₁, incR, incL, ι_R, LinearMap.sub_apply, AlgHom.toLinearMap_apply,
                Algebra.linearMap_apply, Algebra.TensorProduct.includeRight_apply,
                Algebra.TensorProduct.includeLeft_apply]
              rw [Algebra.algebraMap_eq_smul_one, TensorProduct.tmul_smul,
                ← TensorProduct.smul_tmul', sub_self]
            simp [hδr]
          exact LinearMap.congr_fun hcomp z
      have h_exact : Function.Exact ι_R δ₁ :=
        Module.FaithfullyFlat.rTensor_reflects_exact R T ι_R δ₁ h_rTensor_exact
      intro t ht
      have hδt : δ₁ t = 0 := sub_eq_zero.mpr ht
      exact (h_exact t).mp hδt
    have h_cocycle_triv :
        ∀ (u : Units (TensorProduct R T T)),
          p₁₃ (u : TensorProduct R T T) =
            p₁₂ (u : TensorProduct R T T) * p₂₃ (u : TensorProduct R T T) →
          ∃ (L : Submodule R T) (e : TensorProduct R T ↥L ≃ₗ[T] T),
            (∀ t : T, t ∈ L ↔
              ((1 : T) ⊗ₜ[R] t : TensorProduct R T T) =
                (u : TensorProduct R T T) * (t ⊗ₜ[R] (1 : T))) ∧
            (∀ (s : T) (x : ↥L), e (s ⊗ₜ[R] x) = s * (x : T)) := by
      intro u hu
      let μT : TensorProduct R T T →ₐ[R] T := Algebra.TensorProduct.lmul' R (S := T)
      let Φ : TensorProduct R (TensorProduct R T T) T →ₐ[R] TensorProduct R T T :=
        Algebra.TensorProduct.map μT (AlgHom.id R T)
      have hΦ13 : Φ.comp p₁₃ = AlgHom.id R (TensorProduct R T T) := by
        apply Algebra.TensorProduct.ext'
        intro a b
        simp [Φ, μT, p₁₃, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.map_tmul,
          Algebra.TensorProduct.tmul_mul_tmul]
      have hΦ23 : Φ.comp p₂₃ = AlgHom.id R (TensorProduct R T T) := by
        apply Algebra.TensorProduct.ext'
        intro a b
        simp [Φ, μT, p₂₃, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.map_tmul,
          Algebra.TensorProduct.tmul_mul_tmul]
      have hΦ12 : Φ.comp p₁₂ =
          (Algebra.TensorProduct.includeLeft : T →ₐ[R] TensorProduct R T T).comp μT := by
        apply Algebra.TensorProduct.ext'
        intro a b
        simp [Φ, μT, p₁₂, Algebra.TensorProduct.map_tmul]
      have hΦu : (u : TensorProduct R T T) =
          (μT (u : TensorProduct R T T) ⊗ₜ[R] (1 : T)) * (u : TensorProduct R T T) := by
        have h1 := congrArg Φ hu
        rw [map_mul] at h1
        have e13 : Φ (p₁₃ (u : TensorProduct R T T)) = (u : TensorProduct R T T) :=
          AlgHom.congr_fun hΦ13 (u : TensorProduct R T T)
        have e23 : Φ (p₂₃ (u : TensorProduct R T T)) = (u : TensorProduct R T T) :=
          AlgHom.congr_fun hΦ23 (u : TensorProduct R T T)
        have e12 : Φ (p₁₂ (u : TensorProduct R T T)) =
            μT (u : TensorProduct R T T) ⊗ₜ[R] (1 : T) :=
          AlgHom.congr_fun hΦ12 (u : TensorProduct R T T)
        rw [e13, e12, e23] at h1
        exact h1
      have hμu_tmul : μT (u : TensorProduct R T T) ⊗ₜ[R] (1 : T) = (1 : TensorProduct R T T) := by
        have h2 := congrArg (· * (↑u⁻¹ : TensorProduct R T T)) hΦu
        rw [Units.mul_inv, mul_assoc, Units.mul_inv, mul_one] at h2
        exact h2.symm
      have hμu : μT (u : TensorProduct R T T) = 1 := by
        have h3 := congrArg μT hμu_tmul
        simpa [μT] using h3
      let incR : T →ₗ[R] TensorProduct R T T :=
        (Algebra.TensorProduct.includeRight : T →ₐ[R] TensorProduct R T T).toLinearMap
      let incL : T →ₗ[R] TensorProduct R T T :=
        (Algebra.TensorProduct.includeLeft : T →ₐ[R] TensorProduct R T T).toLinearMap
      let δ_u : T →ₗ[R] TensorProduct R T T :=
        incR - (LinearMap.mulLeft R (u : TensorProduct R T T)).comp incL
      let L_u : Submodule R T := LinearMap.ker δ_u
      have hL_mem : ∀ t : T, t ∈ L_u ↔
          ((1 : T) ⊗ₜ[R] t : TensorProduct R T T) =
            (u : TensorProduct R T T) * (t ⊗ₜ[R] (1 : T)) := by
        intro t
        simp [L_u, δ_u, incR, incL, LinearMap.mem_ker, sub_eq_zero]
      have h_assoc_mul : ∀ (a b : T) (w : TensorProduct R T T),
          (TensorProduct.assoc R T T T).symm (a ⊗ₜ[R] (w * (b ⊗ₜ[R] (1 : T)))) =
            p₁₂ (a ⊗ₜ[R] b) * p₂₃ w := by
        intro a b w
        induction w using TensorProduct.inductionOn with
        | tmul c d =>
          simp [p₁₂, p₂₃, Algebra.TensorProduct.lift_tmul,
            Algebra.TensorProduct.tmul_mul_tmul, mul_comm b c]
        | add x y hx hy =>
          rw [add_mul, TensorProduct.tmul_add, map_add, hx, hy, map_add, mul_add]
      let Ψ_u : TensorProduct R T T →ₗ[R] TensorProduct R (TensorProduct R T T) T :=
        (TensorProduct.assoc R T T T).symm.toLinearMap.comp (LinearMap.lTensor T δ_u)
      have hΨ_eq : Ψ_u =
          p₁₃.toLinearMap -
            (LinearMap.mulRight R (p₂₃ (u : TensorProduct R T T))).comp p₁₂.toLinearMap := by
        apply TensorProduct.ext'
        intro a b
        simp only [Ψ_u, δ_u, incR, incL, LinearMap.comp_apply, LinearMap.lTensor_tmul,
          LinearMap.sub_apply, AlgHom.toLinearMap_apply, LinearMap.mulLeft_apply,
          LinearMap.mulRight_apply, Algebra.TensorProduct.includeRight_apply,
          Algebra.TensorProduct.includeLeft_apply, TensorProduct.tmul_sub, map_sub,
          LinearEquiv.coe_toLinearMap, TensorProduct.assoc_symm_tmul]
        rw [h_assoc_mul]
        simp [p₁₃, Algebra.TensorProduct.lift_tmul]
      have hΨ_u : Ψ_u (u : TensorProduct R T T) = 0 := by
        rw [hΨ_eq, LinearMap.sub_apply, LinearMap.comp_apply]
        exact sub_eq_zero.mpr hu
      have hlTensor_u : (LinearMap.lTensor T δ_u) (u : TensorProduct R T T) = 0 := by
        apply (TensorProduct.assoc R T T T).symm.injective
        simpa [Ψ_u] using hΨ_u
      have hu_ker :
          (u : TensorProduct R T T) ∈
            LinearMap.ker (TensorProduct.AlgebraTensorModule.lTensor T T δ_u) := by
        rw [LinearMap.mem_ker]
        have h_eq_lt :
            (TensorProduct.AlgebraTensorModule.lTensor T T δ_u).restrictScalars R =
              LinearMap.lTensor T δ_u := by
          apply TensorProduct.ext'
          intro a b
          rfl
        exact (LinearMap.congr_fun h_eq_lt (u : TensorProduct R T T)).trans hlTensor_u
      let κ_u := LinearMap.tensorKerEquiv T T δ_u
      let ω_u : TensorProduct R T ↥L_u := κ_u.symm ⟨(u : TensorProduct R T T), hu_ker⟩
      have h_lTensor_ω : LinearMap.lTensor T L_u.subtype ω_u = (u : TensorProduct R T T) :=
        LinearMap.lTensor_ker_subtype_tensorKerEquiv_symm T T δ_u
          ⟨(u : TensorProduct R T T), hu_ker⟩
      have h_lTensor_inj : Function.Injective (LinearMap.lTensor T L_u.subtype) :=
        Module.Flat.lTensor_preserves_injective_linearMap L_u.subtype Subtype.val_injective
      let e_fun : TensorProduct R T ↥L_u →ₗ[T] T :=
        LinearMap.liftBaseChange T L_u.subtype
      let e_inv : T →ₗ[T] TensorProduct R T ↥L_u :=
        LinearMap.toSpanSingleton T (TensorProduct R T ↥L_u) ω_u
      have he_fun_eq :
          e_fun.restrictScalars R = μT.toLinearMap.comp (LinearMap.lTensor T L_u.subtype) := by
        apply TensorProduct.ext'
        intro s x
        simp [e_fun, μT, smul_eq_mul]
      have he_fun_ω : e_fun ω_u = 1 := by
        have h1 : e_fun ω_u = μT (LinearMap.lTensor T L_u.subtype ω_u) :=
          LinearMap.congr_fun he_fun_eq ω_u
        rw [h1, h_lTensor_ω, hμu]
      have h_right_inv_comp : e_fun.comp e_inv = LinearMap.id := by
        ext s
        simp [e_inv, LinearMap.toSpanSingleton_apply, map_smul, he_fun_ω]
      have h_smul_tt : ∀ (t : T) (w : TensorProduct R T T),
          t • w = (t ⊗ₜ[R] (1 : T)) * w := by
        intro t w
        induction w using TensorProduct.inductionOn with
        | tmul a b =>
          simp [TensorProduct.smul_tmul', smul_eq_mul, Algebra.TensorProduct.tmul_mul_tmul]
        | add w₁ w₂ hw₁ hw₂ =>
          rw [smul_add, hw₁, hw₂, mul_add]
      have h_lTensor_smul : ∀ (t : T) (z : TensorProduct R T ↥L_u),
          LinearMap.lTensor T L_u.subtype (t • z) = t • LinearMap.lTensor T L_u.subtype z := by
        intro t z
        induction z using TensorProduct.inductionOn with
        | tmul s x =>
