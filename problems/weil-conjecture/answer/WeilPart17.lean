  obtain ⟨_, _, _, hLoc₀_D₀, hLoc₁_D₀, _, hConst_D₀, _⟩ := hValD₀
  
  have hOpenPB : ∀ {P Q R S : AlgebraicGeometry.Scheme.{u}}
      (g : P ⟶ Q) (j' : P ⟶ R) (w : Q ⟶ S) (q : R ⟶ S),
