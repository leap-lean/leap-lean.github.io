    intro C D _ _ _ _ _ _ L R adj _ _ _ _ F_C F_D c hc hRes
    let inv_c := @CategoryTheory.inv _ _ _ _ c hc
    
    have hExtClassComm : ∀ {S₁ S₂ : CategoryTheory.ShortComplex D}
        (hS₁ : S₁.ShortExact) (hS₂ : S₂.ShortExact) (φ : S₁ ⟶ S₂),
        hS₁.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ φ.τ₁) (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ φ.τ₃).comp hS₂.extClass (Nat.zero_add 1) := by
      intro S₁ S₂ hS₁ hS₂ φ
      let _ : HasDerivedCategory D := HasDerivedCategory.standard D
      have hcomm₁ : hS₁.singleTriangle.mor₁ ≫ (DerivedCategory.singleFunctor D 0).map φ.τ₂ =
          (DerivedCategory.singleFunctor D 0).map φ.τ₁ ≫ hS₂.singleTriangle.mor₁ := by
        rw [hS₁.singleTriangle_mor₁, hS₂.singleTriangle_mor₁,
          ← (DerivedCategory.singleFunctor D 0).map_comp, ← φ.comm₁₂,
          (DerivedCategory.singleFunctor D 0).map_comp]
      let M := CategoryTheory.Pretriangulated.completeDistinguishedTriangleMorphism
        hS₁.singleTriangle hS₂.singleTriangle
        hS₁.singleTriangle_distinguished hS₂.singleTriangle_distinguished
        ((DerivedCategory.singleFunctor D 0).map φ.τ₁)
        ((DerivedCategory.singleFunctor D 0).map φ.τ₂) hcomm₁
      have hM₂ : (DerivedCategory.singleFunctor D 0).map S₁.g ≫ M.hom₃ =
          (DerivedCategory.singleFunctor D 0).map φ.τ₂ ≫
            (DerivedCategory.singleFunctor D 0).map S₂.g := by
        have hc₂ := M.comm₂
        rw [CategoryTheory.Pretriangulated.completeDistinguishedTriangleMorphism_hom₂,
          hS₁.singleTriangle_mor₂, hS₂.singleTriangle_mor₂] at hc₂
        exact hc₂
      let τ₃' : S₁.X₃ ⟶ S₂.X₃ := (DerivedCategory.singleFunctor D 0).preimage M.hom₃
      have hτ₃'_map : (DerivedCategory.singleFunctor D 0).map τ₃' = M.hom₃ :=
        (DerivedCategory.singleFunctor D 0).map_preimage M.hom₃
      have hg_eq : S₁.g ≫ τ₃' = S₁.g ≫ φ.τ₃ := by
        apply (DerivedCategory.singleFunctor D 0).map_injective
        rw [(DerivedCategory.singleFunctor D 0).map_comp, hτ₃'_map, hM₂,
          ← (DerivedCategory.singleFunctor D 0).map_comp, ← φ.comm₂₃,
          (DerivedCategory.singleFunctor D 0).map_comp]
      have : CategoryTheory.Epi S₁.g := hS₁.epi_g
      have hτ₃' : τ₃' = φ.τ₃ := (CategoryTheory.cancel_epi S₁.g).mp hg_eq
      have hM₃ : M.hom₃ = (DerivedCategory.singleFunctor D 0).map φ.τ₃ := by
        rw [← hτ₃'_map, hτ₃']
      have hc₃ := M.comm₃
      rw [CategoryTheory.Pretriangulated.completeDistinguishedTriangleMorphism_hom₁, hM₃,
        hS₁.singleTriangle_mor₃, hS₂.singleTriangle_mor₃] at hc₃
      rw [CategoryTheory.Abelian.Ext.ext_iff,
        ← CategoryTheory.Abelian.Ext.hom_comp_singleFunctor_map_shift,
        ← CategoryTheory.Abelian.Ext.singleFunctor_map_comp_hom,
        hS₁.extClass_hom, hS₂.extClass_hom]
      exact hc₃
    
    let ψ : ∀ (q : ℕ) (E : D),
        CategoryTheory.Abelian.Ext F_C (R.obj E) q →+ CategoryTheory.Abelian.Ext F_D E q :=
      fun q E =>
        ((CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app E)).postcomp F_D (Nat.add_zero q)).comp
          (((CategoryTheory.Abelian.Ext.mk₀ inv_c).precomp (L.obj (R.obj E)) (Nat.zero_add q)).comp
            (L.mapExtAddHom F_C (R.obj E) q))
    have hψ_eq : ∀ (q : ℕ) (E : D) (x : CategoryTheory.Abelian.Ext F_C (R.obj E) q),
        ψ q E x =
          (((CategoryTheory.Abelian.Ext.mk₀ inv_c).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor L x) (Nat.zero_add q)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app E)) (Nat.add_zero q)) := by
      intro q E x
      change (((CategoryTheory.Abelian.Ext.mk₀ inv_c).comp
        ((L.mapExtAddHom F_C (R.obj E) q) x) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app E)) (Nat.add_zero q)) = _
      rw [L.mapExtAddHom_apply]
    have hψ_mk₀ : ∀ (E : D) (α : F_C ⟶ R.obj E),
        ψ 0 E (CategoryTheory.Abelian.Ext.mk₀ α) =
          CategoryTheory.Abelian.Ext.mk₀ (inv_c ≫ (adj.homEquiv F_C E).symm α) := by
      intro E α
      rw [hψ_eq, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Category.assoc, CategoryTheory.Adjunction.homEquiv_counit]
    have h_homEquiv_mk₀ : ∀ {X Y : D} (g : X ⟶ Y),
        CategoryTheory.Abelian.Ext.homEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ g) = g := by
      intro X Y g
      rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
      exact CategoryTheory.Abelian.Ext.homEquiv₀.apply_symm_apply g
    have hZero : ∀ (E : D), Function.Bijective (ψ 0 E) := by
      intro E
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun z => CategoryTheory.Abelian.Ext.mk₀
          ((adj.homEquiv F_C E) (c ≫ CategoryTheory.Abelian.Ext.homEquiv₀ z)), ?_, ?_⟩
      · intro x
        let α : F_C ⟶ R.obj E := CategoryTheory.Abelian.Ext.homEquiv₀ x
        have hx : CategoryTheory.Abelian.Ext.mk₀ α = x :=
          CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply x
        rw [← hx, hψ_mk₀]
        dsimp only
        rw [h_homEquiv_mk₀, ← CategoryTheory.Category.assoc c inv_c,
          @CategoryTheory.IsIso.hom_inv_id _ _ _ _ c hc, CategoryTheory.Category.id_comp,
          Equiv.apply_symm_apply]
      · intro z
        let γ : F_D ⟶ E := CategoryTheory.Abelian.Ext.homEquiv₀ z
        have hz : CategoryTheory.Abelian.Ext.mk₀ γ = z :=
          CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply z
        dsimp only
        rw [hψ_mk₀, Equiv.symm_apply_apply, ← CategoryTheory.Category.assoc inv_c c,
          @CategoryTheory.IsIso.inv_hom_id _ _ _ _ c hc, CategoryTheory.Category.id_comp]
        exact hz
    have hNat : ∀ {E₁ E₂ : D} (g : E₁ ⟶ E₂) (q : ℕ)
        (x : CategoryTheory.Abelian.Ext F_C (R.obj E₁) q),
        ψ q E₂ (x.comp (CategoryTheory.Abelian.Ext.mk₀ (R.map g)) (Nat.add_zero q)) =
          (ψ q E₁ x).comp (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero q) := by
      intro E₁ E₂ g q x
      rw [hψ_eq, hψ_eq,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ inv_c)
          (CategoryTheory.Abelian.Ext.mapExactFunctor L x)
          (CategoryTheory.Abelian.Ext.mk₀ (L.map (R.map g)))
          (Nat.zero_add q) (Nat.add_zero q) (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.comp_assoc
          ((CategoryTheory.Abelian.Ext.mk₀ inv_c).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor L x) (Nat.zero_add q))
          (CategoryTheory.Abelian.Ext.mk₀ (L.map (R.map g)))
          (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app E₂))
          (Nat.add_zero q) (Nat.zero_add 0) (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      have hnat : L.map (R.map g) ≫ adj.counit.app E₂ = adj.counit.app E₁ ≫ g :=
        adj.counit.naturality g
      rw [hnat, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          ((CategoryTheory.Abelian.Ext.mk₀ inv_c).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor L x) (Nat.zero_add q))
          (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app E₁))
          (CategoryTheory.Abelian.Ext.mk₀ g)
          (Nat.add_zero q) (Nat.zero_add 0) (Nat.add_zero q)]
    have hBoundary : ∀ (SC : CategoryTheory.ShortComplex D)
        (hSE : SC.ShortExact) (hSE_R : (SC.map R).ShortExact)
        (q : ℕ) (y : CategoryTheory.Abelian.Ext F_C (R.obj SC.X₃) q),
        ψ (q + 1) SC.X₁ (y.comp hSE_R.extClass rfl) =
          (ψ q SC.X₃ y).comp hSE.extClass rfl := by
      intro SC hSE hSE_R q y
      let φ_ε : (SC.map R).map L ⟶ SC :=
        CategoryTheory.ShortComplex.homMk
          (adj.counit.app SC.X₁) (adj.counit.app SC.X₂) (adj.counit.app SC.X₃)
          (adj.counit.naturality SC.f).symm (adj.counit.naturality SC.g).symm
      have hComm₁ : (hSE_R.map_of_exact L).extClass.comp
          (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app SC.X₁)) (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app SC.X₃)).comp
            hSE.extClass (Nat.zero_add 1) :=
        hExtClassComm (hSE_R.map_of_exact L) hSE φ_ε
      rw [hψ_eq, hψ_eq,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass L hSE_R,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ inv_c)
          (CategoryTheory.Abelian.Ext.mapExactFunctor L y)
          (hSE_R.map_of_exact L).extClass
          (Nat.zero_add q) rfl (Nat.zero_add (q + 1)),
        CategoryTheory.Abelian.Ext.comp_assoc
          ((CategoryTheory.Abelian.Ext.mk₀ inv_c).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor L y) (Nat.zero_add q))
          (hSE_R.map_of_exact L).extClass
          (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app SC.X₁))
          rfl (Nat.add_zero 1) rfl,
        hComm₁,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          ((CategoryTheory.Abelian.Ext.mk₀ inv_c).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor L y) (Nat.zero_add q))
          (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app SC.X₃))
          hSE.extClass
          (Nat.add_zero q) (Nat.zero_add 1) rfl]
    
    intro q
    induction q with
    | zero =>
      intro E _
      exact hZero E
    | succ q ih =>
      intro E hE_tor
      obtain ⟨SC, hX₁, hSE, hSE_R, hX₂_tor, hX₃_tor, hVan⟩ := hRes E hE_tor
      obtain ⟨hSub_D, hSub_C⟩ := hVan (q + 1) (Nat.le_add_left 1 q)
      have hSurj₂ : Function.Surjective (ψ q SC.X₂) := (ih SC.X₂ hX₂_tor).2
      have hBij₃ : Function.Bijective (ψ q SC.X₃) := ih SC.X₃ hX₃_tor
      have hBij₁ : Function.Bijective (ψ (q + 1) SC.X₁) := by
        refine ⟨?_, ?_⟩
        · rw [_root_.injective_iff_map_eq_zero]
          intro x hx
          have hxf : x.comp (CategoryTheory.Abelian.Ext.mk₀ (SC.map R).f)
              (Nat.add_zero (q + 1)) = 0 :=
            @Subsingleton.elim _ hSub_C _ _
          obtain ⟨y, hy⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ F_C hSE_R x hxf (n₀ := q) rfl
          have hy_δ : (ψ q SC.X₃ y).comp hSE.extClass rfl = 0 := by
            rw [← hBoundary SC hSE hSE_R q y, hy, hx]
          obtain ⟨z', hz'⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ F_D hSE (ψ q SC.X₃ y) rfl hy_δ
          obtain ⟨z, hz⟩ := hSurj₂ z'
          have hzg : ψ q SC.X₃
              (z.comp (CategoryTheory.Abelian.Ext.mk₀ (SC.map R).g) (Nat.add_zero q)) =
              ψ q SC.X₃ y := by
            change ψ q SC.X₃
              (z.comp (CategoryTheory.Abelian.Ext.mk₀ (R.map SC.g)) (Nat.add_zero q)) =
              ψ q SC.X₃ y
            rw [hNat SC.g q z, hz, hz']
          have hy_eq : z.comp (CategoryTheory.Abelian.Ext.mk₀ (SC.map R).g) (Nat.add_zero q) =
              y :=
            hBij₃.1 hzg
          rw [← hy, ← hy_eq,
            CategoryTheory.Abelian.Ext.comp_assoc z
              (CategoryTheory.Abelian.Ext.mk₀ (SC.map R).g) hSE_R.extClass
              (Nat.add_zero q) (Nat.zero_add 1) (by omega),
            hSE_R.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
        · intro x'
          have hx'f : x'.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f)
              (Nat.add_zero (q + 1)) = 0 :=
            @Subsingleton.elim _ hSub_D _ _
          obtain ⟨y', hy'⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ F_D hSE x' hx'f (n₀ := q) rfl
          obtain ⟨y, hy⟩ := hBij₃.2 y'
          refine ⟨y.comp hSE_R.extClass rfl, ?_⟩
          rw [hBoundary SC hSE hSE_R q y, hy, hy']
      exact hX₁ ▸ hBij₁
  intro B_f _hc pf_f _hr pb_f adj_f _hAdd _hLim _hColim _hAdd_pf
    Pℤ_Z Pℤ_Z' Fℤ_Z Fℤ_Z' η₀ uℤ cℤ hcℤ hRes q E hE_tor
  exact hAbstract pb_f pf_f adj_f Fℤ_Z Fℤ_Z' cℤ hcℤ hRes q E hE_tor

theorem weil_etale_pullback_pushforward_mate_cohomology_comm {X S S' X' : AlgebraicGeometry.Scheme.{u}}
    (f : X ⟶ S) (g : S' ⟶ S) (f' : X' ⟶ S') (g' : X' ⟶ X)
    (hpb : CategoryTheory.IsPullback g' f' f g) :
    letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_f : CategoryTheory.Functor S.Etale X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let B_g : CategoryTheory.Functor S.Etale S'.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
    let B_f' : CategoryTheory.Functor S'.Etale X'.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f'
    let B_g' : CategoryTheory.Functor X.Etale X'.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g'
    ∀ [_hc_f : B_f.IsContinuous S.smallEtaleTopology X.smallEtaleTopology]
      [_hc_g : B_g.IsContinuous S.smallEtaleTopology S'.smallEtaleTopology]
      [_hc_f' : B_f'.IsContinuous S'.smallEtaleTopology X'.smallEtaleTopology]
      [_hc_g' : B_g'.IsContinuous X.smallEtaleTopology X'.smallEtaleTopology],
      let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology
      let pf_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
      let pf_f' := B_f'.sheafPushforwardContinuous AddCommGrpCat.{u} S'.smallEtaleTopology X'.smallEtaleTopology
      let pf_g' := B_g'.sheafPushforwardContinuous AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
      ∀ [_hr_f : pf_f.IsRightAdjoint] [_hr_g : pf_g.IsRightAdjoint]
        [_hr_f' : pf_f'.IsRightAdjoint] [_hr_g' : pf_g'.IsRightAdjoint],
        let pb_f := B_f.sheafPullback AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology
        let pb_g := B_g.sheafPullback AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
        let pb_f' := B_f'.sheafPullback AddCommGrpCat.{u} S'.smallEtaleTopology X'.smallEtaleTopology
        let pb_g' := B_g'.sheafPullback AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
        let adj_f := B_f.sheafAdjunctionContinuous AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology
        let adj_g := B_g.sheafAdjunctionContinuous AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
        let adj_f' := B_f'.sheafAdjunctionContinuous AddCommGrpCat.{u} S'.smallEtaleTopology X'.smallEtaleTopology
        let adj_g' := B_g'.sheafAdjunctionContinuous AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
        ∀ [_ha_f : pb_f.Additive] [_hl_f : CategoryTheory.Limits.PreservesFiniteLimits pb_f]
          [_hc_col_f : CategoryTheory.Limits.PreservesFiniteColimits pb_f]
          [_ha_g : pb_g.Additive] [_hl_g : CategoryTheory.Limits.PreservesFiniteLimits pb_g]
          [_hc_col_g : CategoryTheory.Limits.PreservesFiniteColimits pb_g]
          [_ha_f' : pb_f'.Additive] [_hl_f' : CategoryTheory.Limits.PreservesFiniteLimits pb_f']
          [_hc_col_f' : CategoryTheory.Limits.PreservesFiniteColimits pb_f']
          [_ha_g' : pb_g'.Additive] [_hl_g' : CategoryTheory.Limits.PreservesFiniteLimits pb_g']
          [_hc_col_g' : CategoryTheory.Limits.PreservesFiniteColimits pb_g'],
          let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
          let Pℤ_S := (CategoryTheory.Functor.const (Opposite S.Etale)).obj Aℤ
          let Pℤ_X := (CategoryTheory.Functor.const (Opposite X.Etale)).obj Aℤ
          let Pℤ_S' := (CategoryTheory.Functor.const (Opposite S'.Etale)).obj Aℤ
          let Pℤ_X' := (CategoryTheory.Functor.const (Opposite X'.Etale)).obj Aℤ
          let Fℤ_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
          let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
          let Fℤ_S' := (CategoryTheory.constantSheaf S'.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
          let Fℤ_X' := (CategoryTheory.constantSheaf X'.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
          let cℤ_f := (adj_f.homEquiv Fℤ_S Fℤ_X).symm
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
              Pℤ_S (pf_f.obj Fℤ_X)).symm
              (CategoryTheory.Functor.whiskerLeft B_f.op
                ((CategoryTheory.sheafificationAdjunction X.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ_X)))
          let cℤ_g := (adj_g.homEquiv Fℤ_S Fℤ_S').symm
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
              Pℤ_S (pf_g.obj Fℤ_S')).symm
              (CategoryTheory.Functor.whiskerLeft B_g.op
                ((CategoryTheory.sheafificationAdjunction S'.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ_S')))
          let cℤ_f' := (adj_f'.homEquiv Fℤ_S' Fℤ_X').symm
            (((CategoryTheory.sheafificationAdjunction S'.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
              Pℤ_S' (pf_f'.obj Fℤ_X')).symm
              (CategoryTheory.Functor.whiskerLeft B_f'.op
                ((CategoryTheory.sheafificationAdjunction X'.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ_X')))
          let cℤ_g' := (adj_g'.homEquiv Fℤ_X Fℤ_X').symm
            (((CategoryTheory.sheafificationAdjunction X.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
              Pℤ_X (pf_g'.obj Fℤ_X')).symm
              (CategoryTheory.Functor.whiskerLeft B_g'.op
                ((CategoryTheory.sheafificationAdjunction X'.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ_X')))
          let e_fun : CategoryTheory.Iso (CategoryTheory.Functor.comp B_f B_g')
              (CategoryTheory.Functor.comp B_g B_f') :=
            CategoryTheory.Iso.trans
              (CategoryTheory.Iso.symm (CategoryTheory.MorphismProperty.Over.pullbackComp g' f))
              (CategoryTheory.Iso.trans
                (CategoryTheory.MorphismProperty.Over.pullbackCongr hpb.w)
                (CategoryTheory.MorphismProperty.Over.pullbackComp f' g))
          letI : (CategoryTheory.Functor.comp B_f B_g').IsContinuous
              S.smallEtaleTopology X'.smallEtaleTopology :=
            CategoryTheory.Functor.isContinuous_comp B_f B_g'
              S.smallEtaleTopology X.smallEtaleTopology X'.smallEtaleTopology
          letI : (CategoryTheory.Functor.comp B_g B_f').IsContinuous
              S.smallEtaleTopology X'.smallEtaleTopology :=
            CategoryTheory.Functor.isContinuous_comp B_g B_f'
              S.smallEtaleTopology S'.smallEtaleTopology X'.smallEtaleTopology
          let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_fun
            AddCommGrpCat.{u} S.smallEtaleTopology X'.smallEtaleTopology
          ∀ (hcℤ_f : CategoryTheory.IsIso cℤ_f)
            (hcℤ_g : CategoryTheory.IsIso cℤ_g)
            (hcℤ_f' : CategoryTheory.IsIso cℤ_f')
            (hcℤ_g' : CategoryTheory.IsIso cℤ_g')
            (E : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
            (q : ℕ) (x : (pf_f.obj E).H q),
            let bc₀ := (adj_g.homEquiv (pf_f.obj E) (pf_f'.obj (pb_g'.obj E))).symm
              (CategoryTheory.CategoryStruct.comp
                (pf_f.map (adj_g'.unit.app E))
                (e_pf.hom.app (pb_g'.obj E)))
            let inv_f := @CategoryTheory.inv _ _ _ _ cℤ_f hcℤ_f
            let inv_g := @CategoryTheory.inv _ _ _ _ cℤ_g hcℤ_g
            let inv_f' := @CategoryTheory.inv _ _ _ _ cℤ_f' hcℤ_f'
            let inv_g' := @CategoryTheory.inv _ _ _ _ cℤ_g' hcℤ_g'
            let φ_g := (CategoryTheory.Abelian.Ext.mk₀ inv_g).precomp (pb_g.obj (pf_f.obj E)) (Nat.zero_add q)
