      exact hh₁₂
    have hy_lift : y = (CategoryTheory.Abelian.Ext.mk₀ g₁).comp
        (CategoryTheory.Abelian.Ext.mk₀ π_I) (Nat.add_zero 0) := by
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hg₁₂]
      exact (CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply y).symm
    rw [← hy, hy_lift,
      CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 0) (Nat.zero_add 1) rfl]
    have hcomp0 : (CategoryTheory.Abelian.Ext.mk₀ π_I).comp hS_I.extClass (Nat.zero_add 1) = 0 :=
      hS_I.comp_extClass
    rw [hcomp0, CategoryTheory.Abelian.Ext.comp_zero]
  exact ⟨fun a b => (hzero a).trans (hzero b).symm⟩

theorem weil_etale_closedImmersion_pushforward_subsingleton_and_pullback_surj {Z S : AlgebraicGeometry.Scheme.{u}}
    (i : Z ⟶ S) [AlgebraicGeometry.IsClosedImmersion i]
    [(weilEtaleSitePullback i).IsContinuous S.smallEtaleTopology Z.smallEtaleTopology]
    [_hAdj : ((weilEtaleSitePullback i).sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology Z.smallEtaleTopology).IsRightAdjoint]
    [((weilEtaleSitePullback i).sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology Z.smallEtaleTopology).Additive]
    [CategoryTheory.Limits.PreservesFiniteLimits
      ((weilEtaleSitePullback i).sheafPullback AddCommGrpCat.{u}
        S.smallEtaleTopology Z.smallEtaleTopology)]
    [CategoryTheory.Limits.PreservesFiniteColimits
      ((weilEtaleSitePullback i).sheafPullback AddCommGrpCat.{u}
        S.smallEtaleTopology Z.smallEtaleTopology)] :
    let pf_i := (weilEtaleSitePullback i).sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology Z.smallEtaleTopology
    let Fℤ_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let hTS := weilEtaleIdTerminalIsTerminal.{u} S
    let hTZ := weilEtaleIdTerminalIsTerminal.{u} Z
    let AM := fun m : ℕ => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let ρ_i := fun m : ℕ =>
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hTS).homEquiv
        (AM m) (pf_i.obj (weilEtaleTorsionSheaf Z m))).symm
        (CategoryTheory.CategoryStruct.comp
          ((CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hTZ).unit.app (AM m))
          ((weilEtaleTorsionSheaf Z m).obj.map
            (Opposite.op (hTZ.from ((weilEtaleSitePullback i).obj (weilEtaleIdTerminal.{u} S))))))
    (∀ (q : ℕ) (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      Subsingleton (𝒢.H q) → Subsingleton ((pf_i.obj 𝒢).H q)) ∧
    (∀ (m q : ℕ) (p : weilEtaleTorsionH S m q →+ weilEtaleTorsionH Z m q),
      WeilIsTorsionEtalePullback i m q p →
      Function.Surjective ((CategoryTheory.Abelian.Ext.mk₀ (ρ_i m)).postcomp Fℤ_S (Nat.add_zero q)) →
      Function.Surjective p) :=
by
  classical
  intro pf_i Fℤ_S hTS hTZ AM ρ_i
  
  
  
  have hRingLift : ∀ {A₀ A_Z B_Z : Type u} [CommRing A₀] [CommRing A_Z] [CommRing B_Z]
      (π_ring : A₀ →+* A_Z), Function.Surjective π_ring →
      ∀ (f_Z : A_Z →+* B_Z), f_Z.Etale →
      ∃ (B_A : Type u) (_ : CommRing B_A) (f_A : A₀ →+* B_A) (π_B : B_A →+* B_Z),
        f_A.Etale ∧
        Function.Surjective π_B ∧
        CategoryTheory.IsPushout
          (CommRingCat.ofHom π_ring) (CommRingCat.ofHom f_A)
          (CommRingCat.ofHom f_Z) (CommRingCat.ofHom π_B) := by
    intro A₀ A_Z B_Z _ _ _ π_ring hπ f_Z hf_Z
    let _ : Algebra A_Z B_Z := f_Z.toAlgebra
    have hEt_Z : Algebra.Etale A_Z B_Z := hf_Z
    have hSm_Z : Algebra.IsStandardSmoothOfRelativeDimension 0 A_Z B_Z :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hEt_Z
    rcases hSm_Z with ⟨ι, σ, hFin_σ, hFin_ι, P_Z, hdim_Z⟩
    let _ : Finite σ := hFin_σ
    let _ : Finite ι := hFin_ι
    let _ : Fintype σ := Fintype.ofFinite σ
    choose rel_A hrel_A using fun c : σ => MvPolynomial.map_surjective π_ring hπ (P_Z.relation c)
    let I_A : Ideal (MvPolynomial ι A₀) := Ideal.span (Set.range rel_A)
    let Q_A : Type u := MvPolynomial ι A₀ ⧸ I_A
    let q_A : MvPolynomial ι A₀ →+* Q_A := Ideal.Quotient.mk I_A
    let P_Q : Algebra.PreSubmersivePresentation A₀ Q_A ι σ :=
      Algebra.PreSubmersivePresentation.naive (v := rel_A) P_Z.map P_Z.map_inj
    let j_Q : Q_A := P_Q.jacobian
    let B_A : Type u := Localization.Away j_Q
    let l_A : Q_A →+* B_A := algebraMap Q_A B_A
    let f_A : A₀ →+* B_A := algebraMap A₀ B_A
    let P_loc := Algebra.PreSubmersivePresentation.localizationAway B_A j_Q
    let P_comp := P_loc.comp P_Q
    have hdim_loc : P_loc.dimension = 0 :=
      Algebra.Presentation.localizationAway_dimension_zero j_Q
    have hdim_comp : P_comp.dimension = 0 := by
      dsimp [P_comp]
      rw [Algebra.PreSubmersivePresentation.dimension_comp_eq_dimension_add_dimension,
        hdim_loc, zero_add]
      exact hdim_Z
    have hUnit_jQ : IsUnit (algebraMap Q_A B_A j_Q) :=
      IsLocalization.Away.algebraMap_isUnit j_Q
    have hUnit_comp : IsUnit P_comp.jacobian := by
      dsimp [P_comp]
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.smul_def]
      have hloc_jac : P_loc.jacobian = algebraMap Q_A B_A j_Q :=
        Algebra.PreSubmersivePresentation.localizationAway_jacobian j_Q
      rw [hloc_jac]
      exact hUnit_jQ.mul hUnit_jQ
    let P_sub : Algebra.SubmersivePresentation A₀ B_A _ _ :=
      { P_comp with jacobian_isUnit := hUnit_comp }
    have hSm_A : Algebra.IsStandardSmoothOfRelativeDimension 0 A₀ B_A :=
      P_sub.isStandardSmoothOfRelativeDimension hdim_comp
    have hEt_A_inst : Algebra.Etale A₀ B_A :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr hSm_A
    have hf_A_et : f_A.Etale := by
      change @Algebra.Etale A₀ B_A _ _ f_A.toAlgebra
      convert hEt_A_inst
      exact Algebra.algebra_ext _ _ (fun _ => rfl)
    let e_Z : MvPolynomial ι A_Z →+* B_Z := (MvPolynomial.aeval P_Z.val).toRingHom
    let q_tilde : MvPolynomial ι A₀ →+* B_Z := e_Z.comp (MvPolynomial.map π_ring)
    have hker_Z : Ideal.span (Set.range P_Z.relation) = RingHom.ker e_Z :=
      P_Z.span_range_relation_eq_ker.trans P_Z.ker_eq_ker_aeval_val
    have hI_le : I_A ≤ RingHom.ker q_tilde := by
      rw [Ideal.span_le]
      rintro _ ⟨c, rfl⟩
      change e_Z (MvPolynomial.map π_ring (rel_A c)) = 0
      rw [hrel_A c]
      have hmem : P_Z.relation c ∈ RingHom.ker e_Z := by
        rw [← hker_Z]
        exact Ideal.subset_span ⟨c, rfl⟩
      exact hmem
    let q_Z : Q_A →+* B_Z := Ideal.Quotient.lift I_A q_tilde (fun _ hp => hI_le hp)
    have hq_Z_mk : q_Z.comp q_A = q_tilde := Ideal.Quotient.lift_comp_mk I_A q_tilde _
    have hq_Z_alg : q_Z.comp (algebraMap P_Q.Ring Q_A) = q_tilde := by
      apply MvPolynomial.ringHom_ext'
      · ext a₀
        rfl
      · intro k
        rfl
    have hjac_map : (MvPolynomial.map π_ring).mapMatrix P_Q.jacobiMatrix = P_Z.jacobiMatrix := by
      apply Matrix.ext
      intro r c
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      have hmap_r : P_Q.map r = P_Z.map r := rfl
      have hrel_c : P_Q.relation c = rel_A c := rfl
      rw [hmap_r, hrel_c, ← MvPolynomial.pderiv_map, hrel_A c]
    have hqZ_jQ : q_Z j_Q = P_Z.jacobian := by
      dsimp [j_Q]
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
        Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      have h1 : q_Z ((algebraMap P_Q.Ring Q_A) P_Q.jacobiMatrix.det) =
          q_tilde P_Q.jacobiMatrix.det :=
        RingHom.congr_fun hq_Z_alg P_Q.jacobiMatrix.det
      rw [h1]
      dsimp [q_tilde]
      rw [RingHom.map_det, hjac_map]
      exact (P_Z.algebraMap_apply P_Z.jacobiMatrix.det).symm
    have hUnit_qZ : IsUnit (q_Z j_Q) := by
      rw [hqZ_jQ]
      exact P_Z.jacobian_isUnit
    let π_B : B_A →+* B_Z := IsLocalization.Away.lift j_Q hUnit_qZ
    have hπB_lA : π_B.comp l_A = q_Z := by
      apply RingHom.ext
      intro x
      exact IsLocalization.Away.lift_eq j_Q hUnit_qZ x
    have hπB_mk : (π_B.comp l_A).comp q_A = q_tilde := by
      rw [hπB_lA]
      exact hq_Z_mk
    have hcomm_ring : f_Z.comp π_ring = π_B.comp f_A := by
      ext a₀
      simp only [RingHom.comp_apply]
      have hfA : f_A a₀ = l_A (q_A (MvPolynomial.C a₀)) :=
        IsScalarTower.algebraMap_apply A₀ Q_A B_A a₀
      rw [hfA]
      change f_Z (π_ring a₀) = ((π_B.comp l_A).comp q_A) (MvPolynomial.C a₀)
      rw [hπB_mk]
      change f_Z (π_ring a₀) = (MvPolynomial.aeval P_Z.val) (MvPolynomial.map π_ring (MvPolynomial.C a₀))
      rw [MvPolynomial.map_C, MvPolynomial.aeval_C]
      rfl
    have hSurj_qtilde : Function.Surjective q_tilde :=
      P_Z.aeval_val_surjective.comp (MvPolynomial.map_surjective π_ring hπ)
    have hSurj_πB : Function.Surjective π_B := by
      intro b_Z
      obtain ⟨p, hp⟩ := hSurj_qtilde b_Z
      refine ⟨l_A (q_A p), ?_⟩
      change ((π_B.comp l_A).comp q_A) p = b_Z
      rw [hπB_mk, hp]
    have hw_cat : CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom π_ring) (CommRingCat.ofHom f_Z) =
        CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom f_A) (CommRingCat.ofHom π_B) := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hcomm_ring]
    have hDesc : ∀ (s : CategoryTheory.Limits.PushoutCocone
        (CommRingCat.ofHom π_ring) (CommRingCat.ofHom f_A)),
        ∃ d : CommRingCat.of B_Z ⟶ s.pt,
          CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom f_Z) d = s.inl ∧
          CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom π_B) d = s.inr := by
      intro s
      let α : A_Z →+* ↑s.pt := s.inl.hom
      let β : B_A →+* ↑s.pt := s.inr.hom
      have hs_comm : α.comp π_ring = β.comp f_A :=
        congrArg CommRingCat.Hom.hom s.condition
      let β₀ : MvPolynomial ι A₀ →+* ↑s.pt := (β.comp l_A).comp q_A
      let ψ : MvPolynomial ι A_Z →+* ↑s.pt :=
        MvPolynomial.eval₂Hom α (fun k => β₀ (MvPolynomial.X k))
      have hψ_map : ψ.comp (MvPolynomial.map π_ring) = β₀ := by
        apply MvPolynomial.ringHom_ext'
        · ext a₀
          change ψ (MvPolynomial.map π_ring (MvPolynomial.C a₀)) = β (l_A (q_A (MvPolynomial.C a₀)))
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
          have hfA : l_A (q_A (MvPolynomial.C a₀)) = f_A a₀ :=
            (IsScalarTower.algebraMap_apply A₀ Q_A B_A a₀).symm
          rw [hfA]
          exact RingHom.congr_fun hs_comm a₀
        · intro k
          change ψ (MvPolynomial.map π_ring (MvPolynomial.X k)) = β₀ (MvPolynomial.X k)
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
      have hker_le : RingHom.ker e_Z ≤ RingHom.ker ψ := by
        rw [← hker_Z, Ideal.span_le]
        rintro _ ⟨c, rfl⟩
        change ψ (P_Z.relation c) = 0
        rw [← hrel_A c]
        change (ψ.comp (MvPolynomial.map π_ring)) (rel_A c) = 0
        rw [hψ_map]
        change β (l_A (Ideal.Quotient.mk I_A (rel_A c))) = 0
        have hmem0 : Ideal.Quotient.mk I_A (rel_A c) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨c, rfl⟩)
        rw [hmem0, map_zero, map_zero]
      let γ : B_Z →+* ↑s.pt :=
        RingHom.liftOfSurjective e_Z P_Z.aeval_val_surjective ⟨ψ, hker_le⟩
      have hγ_eZ : γ.comp e_Z = ψ :=
        RingHom.liftOfSurjective_comp e_Z P_Z.aeval_val_surjective ⟨ψ, hker_le⟩
      refine ⟨CommRingCat.ofHom γ, ?_, ?_⟩
      · ext a_Z
        change γ (f_Z a_Z) = α a_Z
        have hfZ : f_Z a_Z = e_Z (MvPolynomial.C a_Z) := by
          dsimp [e_Z]
          rw [MvPolynomial.aeval_C]
          rfl
        rw [hfZ]
        exact (RingHom.congr_fun hγ_eZ (MvPolynomial.C a_Z)).trans (MvPolynomial.eval₂Hom_C _ _ a_Z)
      · ext b_A
        suffices h_eq_hom : γ.comp π_B = β from RingHom.congr_fun h_eq_hom b_A
        apply IsLocalization.ringHom_ext (Submonoid.powers j_Q)
        change (γ.comp π_B).comp l_A = β.comp l_A
        apply Ideal.Quotient.ringHom_ext
        apply RingHom.ext
        intro p
        change γ (((π_B.comp l_A).comp q_A) p) = β₀ p
        rw [hπB_mk]
        change (γ.comp e_Z) (MvPolynomial.map π_ring p) = β₀ p
        rw [hγ_eZ]
        exact RingHom.congr_fun hψ_map p
    have hColim : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk (CommRingCat.ofHom f_Z) (CommRingCat.ofHom π_B) hw_cat) :=
      CategoryTheory.Limits.PushoutCocone.IsColimit.mk hw_cat
        (fun s => (hDesc s).choose)
        (fun s => (hDesc s).choose_spec.1)
        (fun s => (hDesc s).choose_spec.2)
        (fun s m _ hm_inr => by
          ext b_Z
          obtain ⟨b_A, rfl⟩ := hSurj_πB b_Z
          have hm1 : m.hom (π_B b_A) = s.inr.hom b_A :=
            RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm_inr) b_A
          have hm2 : ((hDesc s).choose).hom (π_B b_A) = s.inr.hom b_A :=
            RingHom.congr_fun (congrArg CommRingCat.Hom.hom (hDesc s).choose_spec.2) b_A
          exact hm1.trans hm2.symm)
    exact ⟨B_A, inferInstance, f_A, π_B, hf_A_et, hSurj_πB, CategoryTheory.IsPushout.of_isColimit hColim⟩

  
  
  
  have _ : AlgebraicGeometry.Scheme.IsJointlySurjectivePreserving (@AlgebraicGeometry.Etale) :=
    ⟨fun _ x y hxy =>
      let ⟨z, hz, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x y hxy
      ⟨z, hz⟩⟩
  have _ : AlgebraicGeometry.Scheme.JointlySurjective
      (AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Etale)) :=
    @AlgebraicGeometry.Scheme.instJointlySurjectivePrecoverage (@AlgebraicGeometry.Etale)
  have etale_cover_mem : ∀ {X : AlgebraicGeometry.Scheme.{u}} (U : X.Etale)
      (𝒮 : CategoryTheory.Sieve U) (J : Type u)
      (obj : J → AlgebraicGeometry.Scheme.{u})
      (map : ∀ j : J, obj j ⟶ U.left)
      (hmap : ∀ j : J, AlgebraicGeometry.Etale (map j))
      (hcovers : ∀ x : ↥U.left, ∃ (j : J) (y : ↥(obj j)), (map j).base y = x),
      (∀ j : J,
        let hV : AlgebraicGeometry.Etale (map j ≫ U.hom) :=
          letI := hmap j; letI := U.prop; inferInstance
        let V_j : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (map j ≫ U.hom) hV
        let g_j : V_j ⟶ U := CategoryTheory.MorphismProperty.Over.homMk (map j) rfl trivial
        𝒮.arrows g_j) →
      𝒮 ∈ X.smallEtaleTopology U := by
    intro X U 𝒮 J obj map hmap hcovers hmem
    let 𝒰 : AlgebraicGeometry.Scheme.Cover
        (AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Etale)) U.left :=
      AlgebraicGeometry.Scheme.Cover.mkOfCovers J obj map hcovers hmap
    let over_j : ∀ j : 𝒰.I₀, CategoryTheory.OverClass (𝒰.X j) X :=
      fun j => CategoryTheory.OverClass.ofHom (map j ≫ U.hom)
    let hOver : AlgebraicGeometry.Scheme.Cover.Over X 𝒰 :=
      AlgebraicGeometry.Scheme.Cover.Over.mk over_j
        (fun j => by let _ := over_j j; exact ⟨rfl⟩)
    have hProp : ∀ j : 𝒰.I₀, @AlgebraicGeometry.Etale _ _
        ((@AlgebraicGeometry.Scheme.Cover.Over.over X _ _ _ U.left _ 𝒰 hOver j).hom) :=
      fun j => by
        have := hmap j
        have := U.prop
        exact (inferInstance : AlgebraicGeometry.Etale (map j ≫ U.hom))
    refine (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology U 𝒮).mpr ⟨𝒰, hOver, hProp, ?_⟩
    rintro W g ⟨j⟩
    exact hmem j

  have empty_sheaf_subsingleton : ∀ (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (W : Z.Etale), IsEmpty ↥W.left → Subsingleton ↥(𝒢.obj.obj (Opposite.op W)) := by
    intro 𝒢 W hEmp
    have hBot : (⊥ : CategoryTheory.Sieve W) ∈ Z.smallEtaleTopology W :=
      etale_cover_mem W ⊥ PEmpty.{u + 1} PEmpty.elim (fun j => j.elim)
        (fun j => j.elim) (fun x => (hEmp.false x).elim) (fun j => j.elim)
    have hLim := (CategoryTheory.Presheaf.isSheaf_iff_isLimit _ _).mp 𝒢.2 (⊥ : CategoryTheory.Sieve W) hBot
    let M := 𝒢.obj.obj (Opposite.op W)
    have hShFor := (CategoryTheory.Presheaf.isLimit_iff_isSheafFor 𝒢.obj (⊥ : CategoryTheory.Sieve W)).mp
      hLim (Opposite.op M)
    let x_fam : CategoryTheory.Presieve.FamilyOfElements
        (𝒢.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op M)) (⊥ : CategoryTheory.Sieve W).arrows :=
      fun _ _ hg => False.elim hg
    have hx_comp : x_fam.Compatible := fun _ _ _ _ _ _ _ _ hg _ => False.elim hg
    obtain ⟨_, _, hUniq⟩ := hShFor x_fam hx_comp
    have h_id_eq_zero : (CategoryTheory.CategoryStruct.id M : M ⟶ M) = 0 :=
      (hUniq (CategoryTheory.CategoryStruct.id M) (fun _ _ hg => False.elim hg)).trans
        (hUniq (0 : M ⟶ M) (fun _ _ hg => False.elim hg)).symm
    refine ⟨fun a b => ?_⟩
    have ha : a = 0 := by
      change (CategoryTheory.CategoryStruct.id M) a = (0 : M ⟶ M) a
      rw [h_id_eq_zero]
    have hb : b = 0 := by
      change (CategoryTheory.CategoryStruct.id M) b = (0 : M ⟶ M) b
      rw [h_id_eq_zero]
    exact ha.trans hb.symm

  let B_i := weilEtaleSitePullback i
  have hEpi : ∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : 𝒢₁ ⟶ 𝒢₂) [CategoryTheory.Epi φ], CategoryTheory.Epi (pf_i.map φ) := by
    intro 𝒢₁ 𝒢₂ φ _
    have hLocSurj_φ : CategoryTheory.Sheaf.IsLocallySurjective φ :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} φ).mpr inferInstance
    have hLocSurj_pf : CategoryTheory.Sheaf.IsLocallySurjective (pf_i.map φ) := by
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk (fun {U'} t => ?_)
      have hPt : ∀ x : ↥U'.left,
          ∃ (V_sch : AlgebraicGeometry.Scheme.{u}) (g_left : V_sch ⟶ U'.left)
            (hg_et : AlgebraicGeometry.Etale g_left) (y : ↥V_sch),
            g_left.base y = x ∧
            let hV : AlgebraicGeometry.Etale (g_left ≫ U'.hom) :=
              letI := hg_et; letI := U'.prop; inferInstance
            let V_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (g_left ≫ U'.hom) hV
            let g_et : V_et ⟶ U' := CategoryTheory.MorphismProperty.Over.homMk g_left rfl trivial
            (CategoryTheory.Presheaf.imageSieve (pf_i.map φ).hom t).arrows g_et := by
        intro x
        have hx_top : x ∈ (⊤ : U'.left.Opens) := trivial
        obtain ⟨U_aff, hU_aff, hx_aff, -⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx_top
        let U₀_sch : AlgebraicGeometry.Scheme.{u} := U_aff.toScheme
        let _ : AlgebraicGeometry.IsAffine U₀_sch := hU_aff
        let x₀ : ↥U₀_sch := ⟨x, hx_aff⟩
        let U₀_et : S.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (U_aff.ι ≫ U'.hom) inferInstance
        let j_U : U₀_et ⟶ U' :=
          CategoryTheory.MorphismProperty.Over.homMk U_aff.ι rfl trivial
        let Z₀ : AlgebraicGeometry.Scheme.{u} := (B_i.obj U₀_et).left
