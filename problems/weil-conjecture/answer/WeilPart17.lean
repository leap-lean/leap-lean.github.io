        induction z using TensorProduct.inductionOn with
        | tmul u w =>
          have hq : q₀₁₁_₂₃ (u ⊗ₜ[R₀₁] w) = ((1 : T₀_ov) ⊗ₜ[R₀₁] u) ⊗ₜ[R₀₁] w := by
            change (((1 : T₀_ov) ⊗ₜ[R₀₁] u) ⊗ₜ[R₀₁] (1 : T₁_ov)) * ((1 : A₀₁) ⊗ₜ[R₀₁] w) = _
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hq]
          change (u ⊗ₜ[R₀₁] (1 : T₀_ov)) ⊗ₜ[R₀₁] w =
            ((u ⊗ₜ[R₀₁] (1 : T₀_ov)) ⊗ₜ[R₀₁] (1 : T₁_ov)) * ((1 : A₁₀) ⊗ₜ[R₀₁] w)
          simp only [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        | add z₁ z₂ ih₁ ih₂ => rw [map_add, map_add, map_add, ih₁, ih₂]
      have h₁₀₁ : q₁₀₁_₁₃ (map₁₁ (g₁₁ : A₁₁)) = q₁₀₁_₁₂ (g₁₀ : A₁₀) * q₁₀₁_₂₃ (g₀₁ : A₀₁) := by
        have h1 := congrArg τ₁₀₁ h₀₁₁
        rw [map_mul, hτ₁₀₁_13, hτ₁₀₁_12, hτ₁₀₁_23] at h1
        have hc : q₁₀₁_₁₂ (g₁₀ : A₁₀) * q₁₀₁_₁₂ (s₀₁ (g₀₁ : A₀₁)) = 1 := by
          rw [← map_mul, hs_L, map_one]
        calc
          q₁₀₁_₁₃ (map₁₁ (g₁₁ : A₁₁))
            = 1 * q₁₀₁_₁₃ (map₁₁ (g₁₁ : A₁₁)) := (one_mul _).symm
          _ = (q₁₀₁_₁₂ (g₁₀ : A₁₀) * q₁₀₁_₁₂ (s₀₁ (g₀₁ : A₀₁))) * q₁₀₁_₁₃ (map₁₁ (g₁₁ : A₁₁)) := by
              rw [hc]
          _ = q₁₀₁_₁₂ (g₁₀ : A₁₀) *
                (q₁₀₁_₁₂ (s₀₁ (g₀₁ : A₀₁)) * q₁₀₁_₁₃ (map₁₁ (g₁₁ : A₁₁))) := mul_assoc _ _ _
          _ = q₁₀₁_₁₂ (g₁₀ : A₁₀) * q₁₀₁_₂₃ (g₀₁ : A₀₁) := by rw [← h1]
      let τ₁₁₀ : B₀₁₁ →ₐ[R₀₁] B₁₁₀ :=
        Algebra.TensorProduct.lift
          (Algebra.TensorProduct.lift
            (Algebra.TensorProduct.includeRight (R := R₀₁))
            ((Algebra.TensorProduct.includeLeft (R := R₀₁)).comp (Algebra.TensorProduct.includeLeft (R := R₀₁)))
            (fun _ _ => Commute.all _ _))
          ((Algebra.TensorProduct.includeLeft (R := R₀₁)).comp (Algebra.TensorProduct.includeRight (R := R₀₁)))
          (fun _ _ => Commute.all _ _)
      have hτ₁₁₀_13 : ∀ z : A₀₁, τ₁₁₀ (q₀₁₁_₁₃ z) = q₁₁₀_₂₃ (s₀₁ z) := by
        intro z
        induction z using TensorProduct.inductionOn with
        | tmul w v =>
          have hq : q₀₁₁_₁₃ (w ⊗ₜ[R₀₁] v) = (w ⊗ₜ[R₀₁] (1 : T₁_ov)) ⊗ₜ[R₀₁] v := by
            change ((w ⊗ₜ[R₀₁] (1 : T₁_ov)) ⊗ₜ[R₀₁] (1 : T₁_ov)) * ((1 : A₀₁) ⊗ₜ[R₀₁] v) = _
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hq, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul,
            map_one, mul_one]
          change ((1 : A₁₁_ov) ⊗ₜ[R₀₁] w) * (((1 : T₁_ov) ⊗ₜ[R₀₁] v) ⊗ₜ[R₀₁] (1 : T₀_ov)) =
            (((1 : T₁_ov) ⊗ₜ[R₀₁] v) ⊗ₜ[R₀₁] (1 : T₀_ov)) * ((1 : A₁₁_ov) ⊗ₜ[R₀₁] w)
          rw [Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
            one_mul, mul_one, mul_one, one_mul]
        | add z₁ z₂ ih₁ ih₂ => rw [map_add, map_add, map_add, map_add, ih₁, ih₂]
      have hτ₁₁₀_12 : ∀ z : A₀₁, τ₁₁₀ (q₀₁₁_₁₂ z) = q₁₁₀_₁₃ (s₀₁ z) := by
        intro z
        induction z using TensorProduct.inductionOn with
        | tmul w u =>
          rw [Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.lift_tmul,
            map_one, mul_one, Algebra.TensorProduct.lift_tmul]
          change ((1 : A₁₁_ov) ⊗ₜ[R₀₁] w) * ((u ⊗ₜ[R₀₁] (1 : T₁_ov)) ⊗ₜ[R₀₁] (1 : T₀_ov)) =
            ((u ⊗ₜ[R₀₁] (1 : T₁_ov)) ⊗ₜ[R₀₁] (1 : T₀_ov)) * ((1 : A₁₁_ov) ⊗ₜ[R₀₁] w)
          rw [Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
            one_mul, mul_one, mul_one, one_mul]
        | add z₁ z₂ ih₁ ih₂ => rw [map_add, map_add, map_add, map_add, ih₁, ih₂]
      have hτ₁₁₀_23 : ∀ z : A₁₁_ov, τ₁₁₀ (q₀₁₁_₂₃ z) = q₁₁₀_₁₂ z := by
        intro z
        induction z using TensorProduct.inductionOn with
        | tmul u v =>
          have hq : q₀₁₁_₂₃ (u ⊗ₜ[R₀₁] v) = ((1 : T₀_ov) ⊗ₜ[R₀₁] u) ⊗ₜ[R₀₁] v := by
            change (((1 : T₀_ov) ⊗ₜ[R₀₁] u) ⊗ₜ[R₀₁] (1 : T₁_ov)) * ((1 : A₀₁) ⊗ₜ[R₀₁] v) = _
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hq, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul,
            map_one, one_mul]
          dsimp only [A₁₁_ov, B₁₁₀]
          change ((u ⊗ₜ[R₀₁] (1 : T₁_ov)) ⊗ₜ[R₀₁] (1 : T₀_ov)) *
            (((1 : T₁_ov) ⊗ₜ[R₀₁] v) ⊗ₜ[R₀₁] (1 : T₀_ov)) = (u ⊗ₜ[R₀₁] v) ⊗ₜ[R₀₁] (1 : T₀_ov)
          rw [Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
            mul_one, one_mul, mul_one]
        | add z₁ z₂ ih₁ ih₂ => rw [map_add, map_add, map_add, ih₁, ih₂]
      have h₁₁₀ : q₁₁₀_₁₃ (g₁₀ : A₁₀) = q₁₁₀_₁₂ (map₁₁ (g₁₁ : A₁₁)) * q₁₁₀_₂₃ (g₁₀ : A₁₀) := by
        have h1 := congrArg τ₁₁₀ h₀₁₁
        rw [map_mul, hτ₁₁₀_13, hτ₁₁₀_12, hτ₁₁₀_23] at h1
        have hc₁₃ : q₁₁₀_₁₃ (g₁₀ : A₁₀) * q₁₁₀_₁₃ (s₀₁ (g₀₁ : A₀₁)) = 1 := by
          rw [← map_mul, hs_L, map_one]
        have hc₂₃ : q₁₁₀_₂₃ (s₀₁ (g₀₁ : A₀₁)) * q₁₁₀_₂₃ (g₁₀ : A₁₀) = 1 := by
          rw [← map_mul, hs_R, map_one]
        calc
          q₁₁₀_₁₃ (g₁₀ : A₁₀)
            = q₁₁₀_₁₃ (g₁₀ : A₁₀) * 1 := (mul_one _).symm
          _ = q₁₁₀_₁₃ (g₁₀ : A₁₀) * (q₁₁₀_₂₃ (s₀₁ (g₀₁ : A₀₁)) * q₁₁₀_₂₃ (g₁₀ : A₁₀)) := by
              rw [hc₂₃]
          _ = q₁₁₀_₁₃ (g₁₀ : A₁₀) *
                ((q₁₁₀_₁₃ (s₀₁ (g₀₁ : A₀₁)) * q₁₁₀_₁₂ (map₁₁ (g₁₁ : A₁₁))) * q₁₁₀_₂₃ (g₁₀ : A₁₀)) := by
              rw [h1]
          _ = (q₁₁₀_₁₃ (g₁₀ : A₁₀) * q₁₁₀_₁₃ (s₀₁ (g₀₁ : A₀₁))) *
                (q₁₁₀_₁₂ (map₁₁ (g₁₁ : A₁₁)) * q₁₁₀_₂₃ (g₁₀ : A₁₀)) := by ring
          _ = 1 * (q₁₁₀_₁₂ (map₁₁ (g₁₁ : A₁₁)) * q₁₁₀_₂₃ (g₁₀ : A₁₀)) := by rw [hc₁₃]
          _ = q₁₁₀_₁₂ (map₁₁ (g₁₁ : A₁₁)) * q₁₁₀_₂₃ (g₁₀ : A₁₀) := one_mul _
      exact ⟨h₀₀₀, h₁₁₁, h₀₀₁, h₀₁₁, h₀₁₀, h₁₀₀, h₁₀₁, h₁₁₀⟩

  
  have hproj_last : ∀ {W U : Z.Etale} (w : W ⟶ U) (p : ℕ),
      weilEtaleCechProj w (p + 1) (Fin.last (p + 1)) =
        CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w p) w := by
    intro W U w p
    dsimp only [weilEtaleCechProj, weilEtaleCechProjSub]
    rw [Fin.lastCases_last]

  have hproj_cast : ∀ {W U : Z.Etale} (w : W ⟶ U) (p : ℕ) (j : Fin (p + 1)),
      weilEtaleCechProj w (p + 1) j.castSucc =
        CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w p) w ≫ weilEtaleCechProj w p j := by
    intro W U w p j
    dsimp only [weilEtaleCechProj, weilEtaleCechProjSub]
    rw [Fin.lastCases_castSucc]
    rfl

  have cechLift_proj : ∀ {W U Y : Z.Etale}
      (w : W ⟶ U) (h : Y ⟶ U) (p : ℕ) (g : Fin (p + 1) → (Y ⟶ W))
      (hg : ∀ i, g i ≫ w = h) (i : Fin (p + 1)),
      (weilEtaleCechLiftSub w h p g hg).1 ≫ weilEtaleCechProj w p i = g i := by
    intro W U Y w h p
    induction p with
    | zero =>
      intro g hg i
      obtain rfl : i = 0 := Fin.eq_zero i
      exact CategoryTheory.Category.comp_id (g 0)
    | succ p ih =>
      intro g hg i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · rw [hproj_last]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      · rw [hproj_cast]
        exact (CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans
          (ih (fun k => g k.castSucc) (fun k => hg k.castSucc) j)

  have cechObj_hom_ext : ∀ {W U Y : Z.Etale}
      {w : W ⟶ U} {p : ℕ} {l₁ l₂ : Y ⟶ weilEtaleCechObj w p},
      (∀ i : Fin (p + 1), l₁ ≫ weilEtaleCechProj w p i = l₂ ≫ weilEtaleCechProj w p i) →
      l₁ = l₂ := by
    intro W U Y w p
    induction p with
    | zero =>
      intro l₁ l₂ h
      have h0 : l₁ ≫ 𝟙 (weilEtaleCechObj w 0) = l₂ ≫ 𝟙 (weilEtaleCechObj w 0) := h 0
      rwa [CategoryTheory.Category.comp_id, CategoryTheory.Category.comp_id] at h0
    | succ p ih =>
      intro l₁ l₂ h
      apply CategoryTheory.Limits.pullback.hom_ext
      · refine ih (fun j => ?_)
        have hj := h j.castSucc
        rw [hproj_cast] at hj
        exact (CategoryTheory.Category.assoc l₁ _ _).trans
          (hj.trans (CategoryTheory.Category.assoc l₂ _ _).symm)
      · have hlast := h (Fin.last (p + 1))
        rwa [hproj_last] at hlast

  have cechFace_proj : ∀ {W U : Z.Etale}
      (w : W ⟶ U) (p : ℕ) (j : Fin (p + 2)) (i : Fin (p + 1)),
      weilEtaleCechFace w p j ≫ weilEtaleCechProj w p i =
        weilEtaleCechProj w (p + 1) (j.succAbove i) :=
    fun w p j i => cechLift_proj w (weilEtaleCechHom w (p + 1)) p _ _ i

  have cechObj_one_isPullback : ∀ (W : Z.Etale) (w : W ⟶ weilEtaleIdTerminal.{u} Z),
      CategoryTheory.IsPullback
        (weilEtaleCechProj w 1 0).left
        (weilEtaleCechProj w 1 1).left
        W.hom W.hom := by
    intro W w
    have hproj0 : weilEtaleCechProj w 1 0 = CategoryTheory.Limits.pullback.fst w w :=
      (hproj_cast w 0 0).trans (CategoryTheory.Category.comp_id _)
    have hproj1 : weilEtaleCechProj w 1 1 = CategoryTheory.Limits.pullback.snd w w :=
      hproj_last w 0
    have hPb_et : CategoryTheory.IsPullback (weilEtaleCechProj w 1 0) (weilEtaleCechProj w 1 1) w w := by
      rw [hproj0, hproj1]
      exact CategoryTheory.IsPullback.of_hasPullback w w
    have hPb_sch : CategoryTheory.IsPullback
        (weilEtaleCechProj w 1 0).left (weilEtaleCechProj w 1 1).left
        (w.left : W.left ⟶ Z) (w.left : W.left ⟶ Z) :=
      CategoryTheory.Functor.map_isPullback
        ((AlgebraicGeometry.Scheme.Etale.forget Z).comp (CategoryTheory.Over.forget Z)) hPb_et
    have hw_left : (w.left : W.left ⟶ Z) = W.hom :=
      (CategoryTheory.Category.comp_id (w.left : W.left ⟶ Z)).symm.trans
        (CategoryTheory.Over.w ((AlgebraicGeometry.Scheme.Etale.forget Z).map w))
    have h_subst : ∀ (f : W.left ⟶ Z), f = W.hom →
        CategoryTheory.IsPullback (weilEtaleCechProj w 1 0).left (weilEtaleCechProj w 1 1).left f f →
        CategoryTheory.IsPullback (weilEtaleCechProj w 1 0).left (weilEtaleCechProj w 1 1).left W.hom W.hom := by
      rintro _ rfl h; exact h
    exact h_subst (w.left : W.left ⟶ Z) hw_left hPb_sch

  have cechObj_two_isPullback : ∀ (W : Z.Etale) (w : W ⟶ weilEtaleIdTerminal.{u} Z),
      CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w 1) w).left
        (CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w 1) w).left
        ((weilEtaleCechProj w 1 0).left ≫ W.hom) W.hom := by
    intro W w
    have hPb_et := CategoryTheory.IsPullback.of_hasPullback (weilEtaleCechHom w 1) w
    have hPb_sch : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w 1) w).left
        (CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w 1) w).left
        ((weilEtaleCechHom w 1).left : (weilEtaleCechObj w 1).left ⟶ Z)
        (w.left : W.left ⟶ Z) :=
      CategoryTheory.Functor.map_isPullback
        ((AlgebraicGeometry.Scheme.Etale.forget Z).comp (CategoryTheory.Over.forget Z)) hPb_et
    have hw_left : (w.left : W.left ⟶ Z) = W.hom :=
      (CategoryTheory.Category.comp_id (w.left : W.left ⟶ Z)).symm.trans
        (CategoryTheory.Over.w ((AlgebraicGeometry.Scheme.Etale.forget Z).map w))
    have hhom1_left : ((weilEtaleCechHom w 1).left : (weilEtaleCechObj w 1).left ⟶ Z) =
        (weilEtaleCechProj w 1 0).left ≫ W.hom :=
      ((CategoryTheory.Category.comp_id ((weilEtaleCechHom w 1).left : (weilEtaleCechObj w 1).left ⟶ Z)).symm.trans
        (CategoryTheory.Over.w ((AlgebraicGeometry.Scheme.Etale.forget Z).map (weilEtaleCechHom w 1)))).trans
        (CategoryTheory.Over.w ((AlgebraicGeometry.Scheme.Etale.forget Z).map (weilEtaleCechProj w 1 0))).symm
    have h_subst : ∀ (f₁ : (weilEtaleCechObj w 1).left ⟶ Z) (f₂ : W.left ⟶ Z),
        f₁ = (weilEtaleCechProj w 1 0).left ≫ W.hom → f₂ = W.hom →
        CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w 1) w).left
          (CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w 1) w).left f₁ f₂ →
        CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w 1) w).left
          (CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w 1) w).left
          ((weilEtaleCechProj w 1 0).left ≫ W.hom) W.hom := by
      rintro _ _ rfl rfl h; exact h
    exact h_subst _ _ hhom1_left hw_left hPb_sch

  intro g_cov
  let X₀ := AlgebraicGeometry.Spec (CommRingCat.of T₀)
  let X₁ := AlgebraicGeometry.Spec (CommRingCat.of T₁)
  let W_sch := CategoryTheory.Limits.coprod X₀ X₁
  let f₀ : X₀ ⟶ Z := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀)) ≫ j₀
  let f₁ : X₁ ⟶ Z := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁)) ≫ j₁

  constructor
  · 
    have hFF₀ : Module.FaithfullyFlat D.R₀ T₀ := by
      have hcomap : Function.Surjective (PrimeSpectrum.comap (algebraMap D.R₀ T₀)) := by
        intro p
        obtain ⟨q, hq⟩ := hSurj₀.surj p
        exact ⟨q, (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (algebraMap D.R₀ T₀)) q).symm.trans hq⟩
      exact Module.FaithfullyFlat.of_comap_surjective hcomap
    have hFF₁ : Module.FaithfullyFlat D.R₁ T₁ := by
      have hcomap : Function.Surjective (PrimeSpectrum.comap (algebraMap D.R₁ T₁)) := by
        intro p
        obtain ⟨q, hq⟩ := hSurj₁.surj p
        exact ⟨q, (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (algebraMap D.R₁ T₁)) q).symm.trans hq⟩
      exact Module.FaithfullyFlat.of_comap_surjective hcomap
    refine ⟨hFF₀, hFF₁, ?_⟩
    have : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    have : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    have hEt_f₀ : AlgebraicGeometry.Etale f₀ := by dsimp only [f₀]; infer_instance
    have hEt_f₁ : AlgebraicGeometry.Etale f₁ := by dsimp only [f₁]; infer_instance
    have : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.Etale.{u}) :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
    let pairSch : ULift.{u} Bool → AlgebraicGeometry.Scheme.{u} :=
      fun ⟨b⟩ => match b with | false => X₀ | true => X₁
    let toSig : W_sch ⟶ ∐ pairSch :=
      CategoryTheory.Limits.coprod.desc
        (CategoryTheory.Limits.Sigma.ι pairSch ⟨false⟩)
        (CategoryTheory.Limits.Sigma.ι pairSch ⟨true⟩)
    let fromSig : ∐ pairSch ⟶ W_sch :=
      CategoryTheory.Limits.Sigma.desc
        (fun ⟨b⟩ => match b with
          | false => CategoryTheory.Limits.coprod.inl
          | true => CategoryTheory.Limits.coprod.inr)
    have h_cs : toSig ≫ fromSig = 𝟙 _ := by
      apply CategoryTheory.Limits.coprod.hom_ext
      · dsimp only [toSig, fromSig]
        rw [CategoryTheory.Limits.coprod.inl_desc_assoc,
          CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.Category.comp_id]
      · dsimp only [toSig, fromSig]
        rw [CategoryTheory.Limits.coprod.inr_desc_assoc,
          CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.Category.comp_id]
    have h_sc : fromSig ≫ toSig = 𝟙 _ := by
      apply CategoryTheory.Limits.Sigma.hom_ext
      rintro ⟨_ | _⟩
      · dsimp only [toSig, fromSig]
        rw [CategoryTheory.Limits.Sigma.ι_comp_desc_assoc,
          CategoryTheory.Limits.coprod.inl_desc, CategoryTheory.Category.comp_id]
      · dsimp only [toSig, fromSig]
        rw [CategoryTheory.Limits.Sigma.ι_comp_desc_assoc,
          CategoryTheory.Limits.coprod.inr_desc, CategoryTheory.Category.comp_id]
    have : CategoryTheory.IsIso toSig := ⟨⟨fromSig, h_cs, h_sc⟩⟩
    let g_sig : ∐ pairSch ⟶ Z :=
      CategoryTheory.Limits.Sigma.desc
        (fun ⟨b⟩ => match b with | false => f₀ | true => f₁)
    have hEt_sig : AlgebraicGeometry.Etale g_sig :=
      AlgebraicGeometry.IsZariskiLocalAtSource.sigmaDesc (P := @AlgebraicGeometry.Etale.{u})
        (fun ⟨b⟩ => match b with | false => hEt_f₀ | true => hEt_f₁)
    have hg_fac : g_cov = toSig ≫ g_sig := by
      apply CategoryTheory.Limits.coprod.hom_ext
      · dsimp only [g_cov, toSig, g_sig, f₀]
        rw [CategoryTheory.Limits.coprod.inl_desc,
          CategoryTheory.Limits.coprod.inl_desc_assoc,
          CategoryTheory.Limits.Sigma.ι_comp_desc]
      · dsimp only [g_cov, toSig, g_sig, f₁]
