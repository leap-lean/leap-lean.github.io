        CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPB_W hPB_Poly⟩
    obtain ⟨β, hβ_fst, hβ_snd⟩ := hex_β
    have hAff_W : AlgebraicGeometry.IsAffineOpen W :=
      AlgebraicGeometry.IsAffine.of_isIso β.hom
    let Γ_β : CommRingCat.of (Polynomial A) ≅ X_A.presheaf.obj (Opposite.op W) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial A))).symm ≪≫
        { hom := β.hom.appTop
          inv := β.inv.appTop
          hom_inv_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Iso.inv_hom_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Iso.hom_inv_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop] } ≪≫
        W.topIso
    have hΓ_inl : inl_P ≫ Γ_β.hom =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
          p₁.appTop ≫ X_A.presheaf.map (CategoryTheory.homOfLE le_top).op := by
      calc inl_P ≫ Γ_β.hom
          = (inl_P ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial A))).inv) ≫
