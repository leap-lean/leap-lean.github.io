        dsimp [η₀]
        rw [TensorProduct.smul_tmul', TensorProduct.smul_tmul', smul_eq_mul, smul_eq_mul,
          mul_one, hr₀]
      | add z₁ z₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨m₁, x₁, eq₁⟩
        rcases ih₂ with ⟨m₂, x₂, eq₂⟩
        refine ⟨m₁ + m₂, t ^ m₂ • x₁ + t ^ m₁ • x₂, ?_⟩
        rw [smul_add, hη₀_add, hη₀_smul, hη₀_smul, map_pow, map_pow]
        change t₀₁ ^ (m₁ + m₂) • z₁ + t₀₁ ^ (m₁ + m₂) • z₂ =
          t₀₁ ^ m₂ • η₀ x₁ + t₀₁ ^ m₁ • η₀ x₂
        rw [← eq₁, ← eq₂, ← mul_smul, ← mul_smul, ← pow_add, ← pow_add, add_comm m₂ m₁]
    intro v
    obtain ⟨m, v₀, hv₀⟩ := clear_L₀ (M.θ.symm (η₁ v))
    refine ⟨m, v₀, ?_⟩
    have hθ := congrArg M.θ hv₀
    rw [map_smul, M.θ.apply_symm_apply] at hθ
    calc
      η₁ v = (1 : D.R₀₁) • η₁ v := (one_smul _ _).symm
      _ = (u₀₁ ^ m * t₀₁ ^ m) • η₁ v := by rw [hut_pow m]
      _ = u₀₁ ^ m • (t₀₁ ^ m • η₁ v) := mul_smul _ _ _
      _ = u₀₁ ^ m • M.θ (η₀ v₀) := by rw [hθ]
  let S₁ : Submodule D.R₁ M.L₁ := (J₁ ^ ℓ) • (⊤ : Submodule D.R₁ M.L₁)
  let S₂ : Submodule D.R₁ M.L₁ := Submodule.span D.R₁ {w₁}
  have hJ₀_to_S₁ : ∀ x₀ ∈ (J₀ ^ ℓ) • (⊤ : Submodule D.R₀ M.L₀),
      ∃ (m : ℕ) (z₁ : M.L₁), z₁ ∈ S₁ ∧ u₀₁ ^ m • M.θ (η₀ x₀) = η₁ z₁ := by
    intro x₀ hx₀
    refine Submodule.smul_induction_on hx₀ ?_ ?_
    · intro r₀ hr₀ m₀ _
      have hι₀r : ι₀ r₀ ∈ Ideal.map ι₁ (J₁ ^ ℓ) := by
        rw [← hMapPowEq]
        exact Ideal.mem_map_of_mem ι₀ hr₀
      obtain ⟨k_r, r₁, hr₁, hkr_eq⟩ := clear_map_u (ι₀ r₀) hι₀r
      obtain ⟨k_m, y₁, hkm_eq⟩ := clear_tensor_u (M.θ (η₀ m₀))
      refine ⟨k_r + k_m, r₁ • y₁, Submodule.smul_mem_smul hr₁ Submodule.mem_top, ?_⟩
      rw [hη₀_smul, map_smul, hη₁_smul]
      change u₀₁ ^ (k_r + k_m) • (ι₀ r₀ • M.θ (η₀ m₀)) = ι₁ r₁ • η₁ y₁
      rw [← hkr_eq, ← hkm_eq, pow_add, ← mul_smul, ← mul_smul]
      congr 1
      ring
    · intro x₁ x₂ ih₁ ih₂
      rcases ih₁ with ⟨m₁, z₁, hz₁, eq₁⟩
      rcases ih₂ with ⟨m₂, z₂, hz₂, eq₂⟩
      refine ⟨m₁ + m₂, u ^ m₂ • z₁ + u ^ m₁ • z₂,
        S₁.add_mem (S₁.smul_mem _ hz₁) (S₁.smul_mem _ hz₂), ?_⟩
      rw [hη₀_add, map_add, smul_add, hη₁_add, hη₁_smul, hη₁_smul, map_pow, map_pow]
      change u₀₁ ^ (m₁ + m₂) • M.θ (η₀ x₁) + u₀₁ ^ (m₁ + m₂) • M.θ (η₀ x₂) =
        u₀₁ ^ m₂ • η₁ z₁ + u₀₁ ^ m₁ • η₁ z₂
      rw [← eq₁, ← eq₂, ← mul_smul, ← mul_smul, ← pow_add, ← pow_add, add_comm m₂ m₁]
  have hw₀_mem : w₀ ∈ (J₀ ^ ℓ) • (⊤ : Submodule D.R₀ M.L₀) := by
    dsimp only [J₀]
    rw [hSpan₀]
    exact Submodule.subset_span (Set.mem_singleton w₀)
  obtain ⟨K₂, z₁, hz₁, hK₂⟩ := hJ₀_to_S₁ w₀ hw₀_mem
  have hw₁_pow_mem : u ^ K₂ • w₁ ∈ S₁ := by
    have h_eq : η₁ (u ^ K₂ • w₁) = η₁ (u ^ (ℓ * n) • z₁) := by
      rw [hη₁_smul, hη₁_smul, map_pow, map_pow]
      change u₀₁ ^ K₂ • η₁ w₁ = u₀₁ ^ (ℓ * n) • η₁ z₁
      dsimp [η₁, η₀] at hw_gl hK₂ ⊢
      rw [← hw_gl, ← hK₂, ← mul_smul, ← mul_smul, mul_comm]
    rw [hInj_η₁ h_eq]
    exact S₁.smul_mem (u ^ (ℓ * n)) hz₁
  have hS₂_le_S₁ : S₂ ≤ S₁ := by
    rw [Submodule.span_singleton_le_iff_mem]
    have hCop₂ : IsCoprime (u ^ K₂) (h_near ^ ℓ) := hCop_u.pow
    obtain ⟨α₂, β₂, hαβ₂⟩ := hCop₂
    have hh_mem_J₁ : h_near ∈ J₁ := Ideal.subset_span (by simp)
    have hh_pow_mem : h_near ^ ℓ ∈ J₁ ^ ℓ := Ideal.pow_mem_pow hh_mem_J₁ ℓ
    have hhw₁_mem : (h_near ^ ℓ) • w₁ ∈ S₁ :=
      Submodule.smul_mem_smul hh_pow_mem Submodule.mem_top
    have hw₁_eq : w₁ = α₂ • (u ^ K₂ • w₁) + β₂ • ((h_near ^ ℓ) • w₁) := by
      calc
        w₁ = (1 : D.R₁) • w₁ := (one_smul _ _).symm
        _ = (α₂ * u ^ K₂ + β₂ * h_near ^ ℓ) • w₁ := by rw [hαβ₂]
        _ = α₂ • (u ^ K₂ • w₁) + β₂ • ((h_near ^ ℓ) • w₁) := by
              rw [add_smul, mul_smul, mul_smul]
    rw [hw₁_eq]
    exact S₁.add_mem (S₁.smul_mem α₂ hw₁_pow_mem) (S₁.smul_mem β₂ hhw₁_mem)
  have hJ₁_fg : J₁.FG := ⟨{F_c₁, h_near}, by simp [J₁]⟩
  have hJ₁_pow_fg : (J₁ ^ ℓ).FG := Ideal.FG.pow hJ₁_fg
  obtain ⟨s_J, hs_J⟩ := hJ₁_pow_fg
  obtain ⟨s_L, hs_L⟩ := @Module.Finite.fg_top D.R₁ M.L₁ _ _ _ inferInstance
  have hpair_ann : ∀ p : ↥s_J × ↥s_L, ∃ m : ℕ, u ^ m • (p.1.1 • p.2.1) ∈ S₂ := by
    intro ⟨⟨a, ha_mem⟩, ⟨v, _⟩⟩
    have ha_J₁ : a ∈ J₁ ^ ℓ := by
      rw [← hs_J]
      exact Submodule.subset_span ha_mem
    have hι₁a : ι₁ a ∈ Ideal.map ι₀ (J₀ ^ ℓ) := by
      rw [hMapPowEq]
      exact Ideal.mem_map_of_mem ι₁ ha_J₁
    obtain ⟨k_a, a₀, ha₀, hka_eq⟩ := clear_map_t (ι₁ a) hι₁a
    have hι₁a_eq : ι₁ a = u₀₁ ^ k_a * ι₀ a₀ := by
      calc
        ι₁ a = 1 * ι₁ a := (one_mul _).symm
        _ = (u₀₁ ^ k_a * t₀₁ ^ k_a) * ι₁ a := by rw [hut_pow k_a]
        _ = u₀₁ ^ k_a * (t₀₁ ^ k_a * ι₁ a) := by ring
        _ = u₀₁ ^ k_a * ι₀ a₀ := by rw [hka_eq]
    obtain ⟨k_v, v₀, hkv_eq⟩ := clear_tensor_t v
    have ha₀v₀_mem : a₀ • v₀ ∈ Submodule.span D.R₀ {w₀} := by
      rw [← hSpan₀]
      exact Submodule.smul_mem_smul ha₀ Submodule.mem_top
    obtain ⟨q₀, hq₀⟩ := Submodule.mem_span_singleton.mp ha₀v₀_mem
    obtain ⟨k_q, q₁, hkq_eq⟩ := clear_u (ι₀ q₀)
    refine ⟨k_q + ℓ * n, ?_⟩
    have hη_eq : η₁ (u ^ (k_q + ℓ * n) • (a • v)) =
        η₁ ((u ^ (k_a + k_v) * q₁) • w₁) := by
      rw [hη₁_smul, hη₁_smul, hη₁_smul, map_pow, map_mul, map_pow, hι₁a_eq, hkv_eq]
      have hθ_av : M.θ (η₀ (a₀ • v₀)) = ι₀ a₀ • M.θ (η₀ v₀) := by
        rw [hη₀_smul, map_smul]
      have hθ_qw : M.θ (η₀ (q₀ • w₀)) = ι₀ q₀ • M.θ (η₀ w₀) := by
        rw [hη₀_smul, map_smul]
      have hθ_eq : ι₀ a₀ • M.θ (η₀ v₀) = ι₀ q₀ • M.θ (η₀ w₀) := by
        rw [← hθ_av, ← hq₀, hθ_qw]
      change u₀₁ ^ (k_q + ℓ * n) • ((u₀₁ ^ k_a * ι₀ a₀) • (u₀₁ ^ k_v • M.θ (η₀ v₀))) =
        (u₀₁ ^ (k_a + k_v) * ι₁ q₁) • η₁ w₁
      calc
        u₀₁ ^ (k_q + ℓ * n) • ((u₀₁ ^ k_a * ι₀ a₀) • (u₀₁ ^ k_v • M.θ (η₀ v₀)))
          = (u₀₁ ^ (k_q + ℓ * n) * (u₀₁ ^ k_a * u₀₁ ^ k_v)) • (ι₀ a₀ • M.θ (η₀ v₀)) := by
              rw [← mul_smul, ← mul_smul, ← mul_smul]
              congr 1
              ring
        _ = (u₀₁ ^ (k_q + ℓ * n) * (u₀₁ ^ k_a * u₀₁ ^ k_v)) • (ι₀ q₀ • M.θ (η₀ w₀)) := by
              rw [hθ_eq]
        _ = ((u₀₁ ^ k_a * u₀₁ ^ k_v) * (u₀₁ ^ k_q * ι₀ q₀)) •
              (u₀₁ ^ (ℓ * n) • M.θ (η₀ w₀)) := by
              rw [← mul_smul, ← mul_smul, pow_add]
              congr 1
              ring
        _ = (u₀₁ ^ (k_a + k_v) * ι₁ q₁) • η₁ w₁ := by
              rw [← pow_add, hkq_eq]
              dsimp [η₁, η₀] at hw_gl ⊢
              rw [hw_gl]
    rw [hInj_η₁ hη_eq]
    exact Submodule.mem_span_singleton.mpr ⟨u ^ (k_a + k_v) * q₁, rfl⟩
  let k_fn : D.R₁ → M.L₁ → ℕ := fun a v =>
    if h : a ∈ s_J ∧ v ∈ s_L then
      Classical.choose (hpair_ann (⟨a, h.1⟩, ⟨v, h.2⟩))
    else 0
  have hk_fn_spec : ∀ a (ha : a ∈ s_J) v (hv : v ∈ s_L),
      u ^ (k_fn a v) • (a • v) ∈ S₂ := by
    intro a ha v hv
    have h : a ∈ s_J ∧ v ∈ s_L := ⟨ha, hv⟩
    dsimp [k_fn]
    rw [dif_pos h]
    exact Classical.choose_spec (hpair_ann (⟨a, ha⟩, ⟨v, hv⟩))
  let K₁ : ℕ := s_J.sup fun a => s_L.sup fun v => k_fn a v
  have hK₁_gen : ∀ a ∈ s_J, ∀ v ∈ s_L, u ^ K₁ • (a • v) ∈ S₂ := by
    intro a ha v hv
    have hk_le : k_fn a v ≤ K₁ :=
      le_trans (Finset.le_sup (f := fun v' => k_fn a v') hv)
        (Finset.le_sup (f := fun a' => s_L.sup (fun v' => k_fn a' v')) ha)
    have hk_mem : u ^ (k_fn a v) • (a • v) ∈ S₂ := hk_fn_spec a ha v hv
    have hexp : K₁ = (K₁ - k_fn a v) + k_fn a v := by omega
    rw [hexp, pow_add, mul_smul]
    exact S₂.smul_mem _ hk_mem
  have hK₁_all_L : ∀ a ∈ s_J, ∀ v : M.L₁, u ^ K₁ • (a • v) ∈ S₂ := by
    intro a ha v
    let P_v : Submodule D.R₁ M.L₁ :=
      Submodule.comap ((u ^ K₁ * a) • LinearMap.id) S₂
    have hle : (⊤ : Submodule D.R₁ M.L₁) ≤ P_v := by
      rw [← hs_L, Submodule.span_le]
      intro w hw
      change ((u ^ K₁ * a) • LinearMap.id) w ∈ S₂
      simp only [LinearMap.smul_apply, LinearMap.id_apply, mul_smul]
      exact hK₁_gen a ha w hw
    have hv_mem : v ∈ P_v := hle Submodule.mem_top
    simpa [P_v, mul_smul] using hv_mem
  have hK₁_all_J : ∀ r₁ ∈ J₁ ^ ℓ, ∀ v : M.L₁, u ^ K₁ • (r₁ • v) ∈ S₂ := by
    intro r₁ hr₁ v
    let P_r : Submodule D.R₁ D.R₁ :=
      { carrier := { r : D.R₁ | u ^ K₁ • (r • v) ∈ S₂ }
        zero_mem' := by simp
        add_mem' := fun {x y} hx hy => by
          change u ^ K₁ • ((x + y) • v) ∈ S₂
          rw [add_smul, smul_add]
          exact S₂.add_mem hx hy
        smul_mem' := fun c {x} hx => by
          change u ^ K₁ • ((c * x) • v) ∈ S₂
          have h_eq : u ^ K₁ • ((c * x) • v) = c • (u ^ K₁ • (x • v)) := by
            rw [← mul_smul, ← mul_smul, ← mul_smul]
            congr 1
            ring
          rw [h_eq]
          exact S₂.smul_mem c hx }
    have hle : (J₁ ^ ℓ : Submodule D.R₁ D.R₁) ≤ P_r := by
      rw [← hs_J, Submodule.span_le]
      intro a ha
      exact hK₁_all_L a ha v
    exact hle hr₁
  have hK₁_S₁ : ∀ x ∈ S₁, u ^ K₁ • x ∈ S₂ := by
    intro x hx
    refine Submodule.smul_induction_on hx ?_ ?_
    · intro r₁ hr₁ v _
      exact hK₁_all_J r₁ hr₁ v
    · intro x₁ x₂ hx₁ hx₂
      rw [smul_add]
      exact S₂.add_mem hx₁ hx₂
  have hU_pow : ∀ (m : ℕ) (q : M.L₁ ⧸ S₂), ∃ q' : M.L₁ ⧸ S₂, u ^ m • q' = q := by
    intro m
    induction m with
    | zero =>
      intro q
      exact ⟨q, by simp⟩
    | succ m ih =>
      intro q
      obtain ⟨q₁, hq₁⟩ := hU q
      obtain ⟨q₂, hq₂⟩ := ih q₁
      refine ⟨q₂, ?_⟩
      rw [pow_succ', mul_smul, hq₂, hq₁]
  have hS₁_le_S₂ : S₁ ≤ S₂ := by
    intro x hx
    obtain ⟨q', hq'⟩ := hU_pow K₁ (S₂.mkQ x)
    obtain ⟨y_tilde, hy_tilde⟩ := Submodule.mkQ_surjective S₂ q'
    have hdiff_mem : x - u ^ K₁ • y_tilde ∈ S₂ := by
      rw [← Submodule.ker_mkQ S₂, LinearMap.mem_ker, map_sub, map_smul, hy_tilde, hq', sub_self]
    have hh_mem_J₁ : h_near ∈ J₁ := Ideal.subset_span (by simp)
    have hh_pow_mem : h_near ^ ℓ ∈ J₁ ^ ℓ := Ideal.pow_mem_pow hh_mem_J₁ ℓ
    have hhy_S₁ : (h_near ^ ℓ) • y_tilde ∈ S₁ :=
      Submodule.smul_mem_smul hh_pow_mem Submodule.mem_top
    have huhy_S₂ : u ^ K₁ • ((h_near ^ ℓ) • y_tilde) ∈ S₂ :=
      hK₁_S₁ _ hhy_S₁
    have hhx_S₂ : (h_near ^ ℓ) • x ∈ S₂ := by
      have hhx_eq : (h_near ^ ℓ) • x =
          (h_near ^ ℓ) • (x - u ^ K₁ • y_tilde) +
            u ^ K₁ • ((h_near ^ ℓ) • y_tilde) := by
        rw [smul_sub, ← mul_smul, ← mul_smul, mul_comm (h_near ^ ℓ) (u ^ K₁), sub_add_cancel]
      rw [hhx_eq]
      exact S₂.add_mem (S₂.smul_mem (h_near ^ ℓ) hdiff_mem) huhy_S₂
    have hux_S₂ : u ^ K₁ • x ∈ S₂ := hK₁_S₁ x hx
    have hCop₁ : IsCoprime (u ^ K₁) (h_near ^ ℓ) := hCop_u.pow
    obtain ⟨α₁, β₁, hαβ₁⟩ := hCop₁
    have hx_eq : x = α₁ • (u ^ K₁ • x) + β₁ • ((h_near ^ ℓ) • x) := by
      calc
        x = (1 : D.R₁) • x := (one_smul _ _).symm
        _ = (α₁ * u ^ K₁ + β₁ * h_near ^ ℓ) • x := by rw [hαβ₁]
        _ = α₁ • (u ^ K₁ • x) + β₁ • ((h_near ^ ℓ) • x) := by
              rw [add_smul, mul_smul, mul_smul]
    rw [hx_eq]
    exact S₂.add_mem (S₂.smul_mem α₁ hux_S₂) (S₂.smul_mem β₁ hhx_S₂)
  have hSpan₁ : S₁ = S₂ := le_antisymm hS₁_le_S₂ hS₂_le_S₁
  exact ⟨F_c₁, h_near, G_far₁, H_c₁, u_star, v₁, v₂, a₁, b₁,
    hFc₁_red, hh_red, hRel₁, hBez₁, hBez₂, hMapEq, hSpan₁⟩

theorem weil_twoChart_ideal_lineBundle_gluing_and_iso (k : Type u) [Field k]
    (ℓ n : ℕ)
    (A : Type u) [CommRing A]
    (D : WeilTwoChartRingDatum A)
    (D₀ : WeilTwoChartRingDatum k)
    (red : WeilTwoChartCurveReduction D D₀)
    (M : WeilTwoChartLineBundle D)
    (lam₀ : M.L₀ →ₗ[D.R₀] D.R₀) (lam₁ : M.L₁ →ₗ[D.R₁] D.R₁)
    (w₀ : M.L₀) (w₁ : M.L₁)
    (J₀ : Ideal D.R₀) [Module.Invertible D.R₀ ↥J₀]
    (J₁ : Ideal D.R₁) [Module.Invertible D.R₁ ↥J₁] :
    letI : Algebra D.R₀ D₀.R₀ := red.algR₀
    letI : Algebra D.R₁ D₀.R₁ := red.algR₁
    let t : D.R₀ := algebraMap (Polynomial A) D.R₀ Polynomial.X
    let u : D.R₁ := algebraMap (Polynomial A) D.R₁ Polynomial.X
    let t₀₁ : D.R₀₁ := algebraMap D.R₀ D.R₀₁ t
    let u₀₁ : D.R₀₁ := algebraMap D.R₁ D.R₀₁ u
    let t_bar : D₀.R₀ := algebraMap (Polynomial k) D₀.R₀ Polynomial.X
    let u_bar : D₀.R₁ := algebraMap (Polynomial k) D₀.R₁ Polynomial.X
    let t_bar₀₁ : D₀.R₀₁ := algebraMap D₀.R₀ D₀.R₀₁ t_bar
    let u_bar₀₁ : D₀.R₀₁ := algebraMap D₀.R₁ D₀.R₀₁ u_bar
    let π₀ : D.R₀ →+* D₀.R₀ := algebraMap D.R₀ D₀.R₀
    let π₁ : D.R₁ →+* D₀.R₁ := algebraMap D.R₁ D₀.R₁
    IsLocalization.Away t D.R₀₁ →
    IsLocalization.Away u D.R₀₁ →
    t₀₁ * u₀₁ = 1 →
    π₁ u = u_bar →
    t_bar₀₁ * u_bar₀₁ = 1 →
    (∀ y : D.R₁, u * y = 0 → y = 0) →
    (∀ z : D₀.R₀, t_bar ^ n * z = 0 → z = 0) →
    Ideal.map (algebraMap D.R₀ D.R₀₁) J₀ = Ideal.map (algebraMap D.R₁ D.R₀₁) J₁ →
    (∀ x ∈ J₀, ∃ q_bar : D₀.R₀, π₀ x = t_bar ^ n * q_bar) →
    (∃ x₀ ∈ J₀, π₀ x₀ = t_bar ^ n) →
    (∃ y₁ ∈ J₁, π₁ y₁ = 1) →
    (J₀ ^ ℓ) • (⊤ : Submodule D.R₀ M.L₀) = Submodule.span D.R₀ {w₀} →
    (J₁ ^ ℓ) • (⊤ : Submodule D.R₁ M.L₁) = Submodule.span D.R₁ {w₁} →
    (∀ r₀ : D.R₀, lam₀ w₀ * r₀ = 0 → r₀ = 0) →
    (∀ r₁ : D.R₁, lam₁ w₁ * r₁ = 0 → r₁ = 0) →
    u₀₁ ^ (ℓ * n) • M.θ (TensorProduct.tmul D.R₀ (1 : D.R₀₁) w₀) =
      TensorProduct.tmul D.R₁ (1 : D.R₀₁) w₁ →
    ∃ N_inv : WeilTwoChartLineBundle D,
      WeilTwoChartIso D₀ (WeilTwoChartBaseChange red N_inv) (WeilTwoChartTrivial D₀) ∧
      WeilTwoChartIso D (WeilTwoChartMul D M (WeilTwoChartPow D N_inv ℓ))
        (WeilTwoChartTrivial D) :=
by
  let _ : Algebra D.R₀ D₀.R₀ := red.algR₀
  let _ : Algebra D.R₁ D₀.R₁ := red.algR₁
  intro t u t₀₁ u₀₁ t_bar u_bar t_bar₀₁ u_bar₀₁ π₀ π₁
    hLoc₀ hLoc₁ htu hu_red htu_bar _hu_nzd htbar_nzd hMapEq
    hJ₀_div hx₀_ex hy₁_ex hSpan₀ hSpan₁ hw₀_nzd hw₁_nzd hw_gl
  classical
  
  have bij_of_eval_one : ∀ {R P : Type u} [CommRing R] [AddCommGroup P] [Module R P]
