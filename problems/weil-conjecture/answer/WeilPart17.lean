      have htG_sub : t_G * (1 - e') ∈ Ideal.span {g} := by
        rw [h1_sub_e', ← mul_assoc]
        exact Ideal.mul_mem_right _ _ htG_afar
      have htG_split : t_G = t_G * e' + t_G * (1 - e') := by ring
      rw [htG_split]
