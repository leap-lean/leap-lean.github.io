          algebraMap B₁ B₀₁ (algebraMap (Polynomial A) B₁ (Polynomial.C a))) ∧
      AlgebraicGeometry.IsOpenImmersion y₀ ∧
      AlgebraicGeometry.IsOpenImmersion y₁ ∧
      Set.range y₀.base ∪ Set.range y₁.base = Set.univ ∧
      Set.range y₀.base = π.base ⁻¹' (Set.range w₀.base) ∧
      Set.range y₁.base = π.base ⁻¹' (Set.range w₁.base) ∧
      y₀ ≫ π =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial A) B₀)) ≫ w₀ ∧
      y₁ ≫ π =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial A) B₁)) ≫ w₁ ∧
      CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ B₀₁)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₁ B₀₁)))
        y₀ y₁ := (by
  intro s_A P₁ X_A p_A
  have hAtlasX : ∃ (w₀ w₁ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A)) ⟶ X_A),
