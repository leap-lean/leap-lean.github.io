import WeilPart16
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_relative_chow_and_noetherian_closed_split (k : Type u) [Field k] :
    (∀ (W : AlgebraicGeometry.Scheme.{u}),
      IsEmpty W ∨
      ∃ (W_red : AlgebraicGeometry.Scheme.{u}) (i_red : W_red ⟶ W),
        AlgebraicGeometry.IsClosedImmersion i_red ∧
        Set.range i_red.base = Set.univ ∧
        AlgebraicGeometry.IsReduced W_red ∧
        (AlgebraicGeometry.IsIntegral W_red ∨
          ∃ (O₁ : W_red.Opens) (W₁ W₂ : AlgebraicGeometry.Scheme.{u})
            (i₁ : W₁ ⟶ W_red) (i₂ : W₂ ⟶ W_red),
            Nonempty O₁ ∧
            Nonempty ↥((Set.range i₂.base)ᶜ) ∧
            AlgebraicGeometry.IsClosedImmersion i₁ ∧
            AlgebraicGeometry.IsClosedImmersion i₂ ∧
            Set.range i₁.base = (O₁ : Set W_red)ᶜ ∧
            CategoryTheory.IsIso (i₂ ∣_ O₁))) ∧
    (∀ (X S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType S.hom]
      [AlgebraicGeometry.QuasiCompact S.hom]
      [AlgebraicGeometry.IsSeparated S.hom]
      (f : X ⟶ S),
      AlgebraicGeometry.IsProper f.left →
      AlgebraicGeometry.IsIntegral X.left →
      ∃ (V₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (π₀ : V₀ ⟶ X) (U₀ : X.left.Opens) (N : ℕ)
        (ι_S : V₀.left ⟶
          CategoryTheory.Limits.pullback S.hom (weilProjectiveSpaceOver k N).hom),
        AlgebraicGeometry.IsIntegral V₀.left ∧
        AlgebraicGeometry.IsProper π₀.left ∧
        AlgebraicGeometry.Surjective π₀.left ∧
        Nonempty U₀ ∧
        CategoryTheory.IsIso (π₀.left ∣_ U₀) ∧
        AlgebraicGeometry.IsClosedImmersion ι_S ∧
        ι_S ≫ CategoryTheory.Limits.pullback.fst S.hom (weilProjectiveSpaceOver k N).hom =
          π₀.left ≫ f.left) :=
by
  refine ⟨?_, ?_⟩
  · 
    intro W
    have hVanishing : ∀ (X : AlgebraicGeometry.Scheme.{u}) (Z : TopologicalSpace.Closeds ↥X),
        let I := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z
        AlgebraicGeometry.IsClosedImmersion I.subschemeι ∧
        Set.range I.subschemeι.base = (Z : Set X) ∧
        AlgebraicGeometry.IsReduced I.subscheme := by
      intro X Z
      let I := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z
      have hRange : Set.range I.subschemeι.base = (Z : Set X) := by
        rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
          AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
      have hSupp : I.support = Z :=
        SetLike.coe_injective (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal Z)
      have hRad : I.radical = I := by
        rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support (I := I), hSupp]
      have hRedChart : ∀ (U : (I.subschemeCover.openCover).I₀),
          AlgebraicGeometry.IsReduced ((I.subschemeCover.openCover).X U) := by
        intro U
        change AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (CommRingCat.of _))
        have hIdRad : (I.ideal U).radical = I.ideal U := by
          rw [← AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal I U, hRad]
        have hIsRad : (I.ideal U).IsRadical := Ideal.radical_eq_iff.mp hIdRad
        have : _root_.IsReduced (↑(X.presheaf.obj (Opposite.op U.1)) ⧸ I.ideal U) :=
          (Ideal.isRadical_iff_quotient_reduced (I.ideal U)).mp hIsRad
        infer_instance
      exact ⟨inferInstance, hRange,
        AlgebraicGeometry.IsReduced.of_openCover I.subscheme I.subschemeCover.openCover⟩
    by_cases hEmp : IsEmpty W
    · exact Or.inl hEmp
    · right
      have : Nonempty W := not_isEmpty_iff.mp hEmp
      let Z_top : TopologicalSpace.Closeds ↥W := ⊤
      let I_top := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z_top
      obtain ⟨hCl_red, hRange_red, hRed⟩ := hVanishing W Z_top
      have hRange_univ : Set.range I_top.subschemeι.base = Set.univ := hRange_red
      let W_red := I_top.subscheme
      let i_red : W_red ⟶ W := I_top.subschemeι
      have : AlgebraicGeometry.IsReduced W_red := hRed
      obtain ⟨w₀⟩ := (inferInstance : Nonempty W)
      have hw₀ : w₀ ∈ Set.range i_red.base := by rw [hRange_univ]; trivial
      obtain ⟨x₀, _⟩ := hw₀
      have : Nonempty W_red := ⟨x₀⟩
      refine ⟨W_red, i_red, hCl_red, hRange_univ, hRed, ?_⟩
      by_cases hPre : IsPreirreducible (Set.univ : Set W_red)
      · left
        have hPreSp : PreirreducibleSpace W_red := ⟨hPre⟩
        have hIrrSp : IrreducibleSpace W_red :=
          { isPreirreducible_univ := hPreSp.isPreirreducible_univ
            toNonempty := inferInstance }
        exact @AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced W_red hRed hIrrSp
      · right
        have hNotPre : ∃ (u v : Set W_red),
            IsOpen u ∧ IsOpen v ∧
            (Set.univ ∩ u).Nonempty ∧ (Set.univ ∩ v).Nonempty ∧
            ¬ (Set.univ ∩ (u ∩ v)).Nonempty := by
          classical
          simpa only [IsPreirreducible, not_forall, exists_prop] using hPre
        obtain ⟨u, v, hu, hv, ⟨x₁, _, hx₁⟩, ⟨x₂, _, hx₂⟩, huv⟩ := hNotPre
        let O₁ : W_red.Opens := ⟨u, hu⟩
        have hO₁_ne : Nonempty O₁ := ⟨⟨x₁, hx₁⟩⟩
        let Z₁ : TopologicalSpace.Closeds ↥W_red := ⟨(O₁ : Set W_red)ᶜ, O₁.isOpen.isClosed_compl⟩
        let Z₂ : TopologicalSpace.Closeds ↥W_red := ⟨vᶜ, hv.isClosed_compl⟩
        let I₁ := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z₁
        let I₂ := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z₂
        obtain ⟨hCl₁, hRange₁, _⟩ := hVanishing W_red Z₁
        obtain ⟨hCl₂, hRange₂, _⟩ := hVanishing W_red Z₂
        have hx₂_not : x₂ ∉ Set.range I₂.subschemeι.base := by
          rw [hRange₂]
          exact fun h => h hx₂
        have hCompl_ne : Nonempty ↥((Set.range I₂.subschemeι.base)ᶜ) := ⟨⟨x₂, hx₂_not⟩⟩
        have : AlgebraicGeometry.IsClosedImmersion I₂.subschemeι := hCl₂
        have : AlgebraicGeometry.IsClosedImmersion (I₂.subschemeι ∣_ O₁) := inferInstance
        have : AlgebraicGeometry.IsReduced (O₁ : AlgebraicGeometry.Scheme.{u}) :=
          AlgebraicGeometry.isReduced_of_isOpenImmersion O₁.ι
        have hSurj_base : Function.Surjective (I₂.subschemeι ∣_ O₁).base := by
          intro y
          have hy_vc : y.1 ∈ vᶜ := fun hyv => huv ⟨y.1, trivial, y.2, hyv⟩
          have hy_range : y.1 ∈ Set.range I₂.subschemeι.base := by rwa [hRange₂]
          obtain ⟨z₂, hz₂⟩ := hy_range
          have hz₂_mem : z₂ ∈ I₂.subschemeι ⁻¹ᵁ O₁ := by
            change I₂.subschemeι.base z₂ ∈ O₁
            rw [hz₂]
            exact y.2
          refine ⟨⟨z₂, hz₂_mem⟩, ?_⟩
          apply O₁.ι.isOpenEmbedding.injective
          have hComm : ((I₂.subschemeι ∣_ O₁) ≫ O₁.ι).base ⟨z₂, hz₂_mem⟩ =
              ((I₂.subschemeι ⁻¹ᵁ O₁).ι ≫ I₂.subschemeι).base ⟨z₂, hz₂_mem⟩ :=
            congrArg (fun g => g.base ⟨z₂, hz₂_mem⟩)
              (AlgebraicGeometry.morphismRestrict_ι I₂.subschemeι O₁)
          exact hComm.trans hz₂
        have : AlgebraicGeometry.Surjective (I₂.subschemeι ∣_ O₁) := ⟨hSurj_base⟩
        have hIso₂ : CategoryTheory.IsIso (I₂.subschemeι ∣_ O₁) :=
          AlgebraicGeometry.isIso_of_isClosedImmersion_of_surjective (I₂.subschemeι ∣_ O₁)
        exact ⟨O₁, I₁.subscheme, I₂.subscheme, I₁.subschemeι, I₂.subschemeι,
          hO₁_ne, hCompl_ne, hCl₁, hCl₂, hRange₁, hIso₂⟩
  · 
    intro X S _ _ _ f hf hIntX
    
    have step1 :
        X.left.IsSeparated ∧
        ∃ (r : ℕ) (_ : 0 < r)
          (U : Fin r → X.left.Opens),
          (⨆ j : Fin r, U j = ⊤) ∧
          (∀ j : Fin r, AlgebraicGeometry.IsAffineOpen (U j)) ∧
          (∀ j : Fin r, Nonempty (U j)) ∧
          ∃ (n : Fin r → ℕ)
            (f_gen : ∀ j : Fin r, Fin (n j) → ↑(X.left.presheaf.obj (Opposite.op (U j)))),
            (∀ j : Fin r, Function.Surjective (MvPolynomial.eval₂Hom
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                AlgebraicGeometry.Scheme.Hom.appLE X.hom ⊤ (U j) le_top).hom) (f_gen j))) ∧
            ∃ (U₀ : X.left.Opens),
              (∀ j : Fin r, U₀ ≤ U j) ∧
              Nonempty U₀ ∧
              AlgebraicGeometry.IsAffineOpen U₀ := by
      have : AlgebraicGeometry.IsProper f.left := hf
      have : AlgebraicGeometry.LocallyOfFiniteType X.hom := by
        rw [← CategoryTheory.Over.w f]; infer_instance
      have : AlgebraicGeometry.QuasiCompact X.hom := by
        rw [← CategoryTheory.Over.w f]; infer_instance
      have : AlgebraicGeometry.IsSeparated X.hom := by
        rw [← CategoryTheory.Over.w f]; infer_instance
      let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
      have hSepSk : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from S_k) :=
        (AlgebraicGeometry.Scheme.isSeparated_iff S_k).mp inferInstance
      have hTermEq : CategoryTheory.Limits.terminal.from X.left =
          X.hom ≫ CategoryTheory.Limits.terminal.from S_k :=
        CategoryTheory.Limits.terminal.hom_ext _ _
      have hSepTermX : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from X.left) := by
        rw [hTermEq]; infer_instance
      have hSepX : X.left.IsSeparated :=
        (AlgebraicGeometry.Scheme.isSeparated_iff X.left).mpr hSepTermX
      have : AlgebraicGeometry.Scheme.IsSeparated X.left := hSepX
      have : AlgebraicGeometry.IsIntegral X.left := hIntX
      have : IrreducibleSpace ↥X.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral X.left
      have : CompactSpace ↥X.left := AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace X.hom
      have hAffPoint : ∀ y : X.left, ∃ W : X.left.Opens, AlgebraicGeometry.IsAffineOpen W ∧ y ∈ W := by
        intro y
        obtain ⟨W, hAffW, hyW, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : X.left.Opens)) (Set.mem_univ y)
        exact ⟨W, hAffW, hyW⟩
      choose W hAffW hyW using hAffPoint
      obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover
        (fun y : X.left => (W y : Set X.left))
        (fun y => (W y).isOpen)
        (fun y _ => Set.mem_iUnion.mpr ⟨y, hyW y⟩)
      let r : ℕ := s.card
      let e_s : Fin r ≃ ↥s := (Fintype.equivFinOfCardEq (Fintype.card_coe s)).symm
      let U : Fin r → X.left.Opens := fun j => W (e_s j).1
      have hCovU : ⨆ j : Fin r, U j = ⊤ := by
        apply le_antisymm le_top
        intro y _
        have hyUniv : y ∈ (⋃ x ∈ s, (W x : Set X.left)) := hs (Set.mem_univ y)
        rcases Set.mem_iUnion₂.mp hyUniv with ⟨x, hx_s, hyWx⟩
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨e_s.symm ⟨x, hx_s⟩, by simpa [U] using hyWx⟩
      have hAffU : ∀ j : Fin r, AlgebraicGeometry.IsAffineOpen (U j) := fun j => hAffW (e_s j).1
      have hNonU : ∀ j : Fin r, Nonempty (U j) := fun j => ⟨⟨(e_s j).1, hyW (e_s j).1⟩⟩
      obtain ⟨y₀⟩ := (inferInstance : Nonempty ↥X.left)
      have hy₀ : y₀ ∈ (⨆ j : Fin r, U j) := by rw [hCovU]; trivial
      obtain ⟨j₀, _⟩ := TopologicalSpace.Opens.mem_iSup.mp hy₀
      have hr : 0 < r := Fin.pos j₀
      have hGenEx : ∀ j : Fin r, ∃ (nj : ℕ)
          (fj : Fin nj → ↑(X.left.presheaf.obj (Opposite.op (U j)))),
          Function.Surjective (MvPolynomial.eval₂Hom
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              AlgebraicGeometry.Scheme.Hom.appLE X.hom ⊤ (U j) le_top).hom) fj) := by
        intro j
        let A_j := ↑(X.left.presheaf.obj (Opposite.op (U j)))
        let κ_j : k →+* A_j :=
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE X.hom ⊤ (U j) le_top).hom)
        have hFT_app : RingHom.FiniteType (AlgebraicGeometry.Scheme.Hom.appLE X.hom ⊤ (U j) le_top).hom :=
          X.hom.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top S_k) (hAffU j) le_top
        have hSurjIso : Function.Surjective ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom :=
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv.symm).surjective
        have hFT_κ : RingHom.FiniteType κ_j := by
          change RingHom.FiniteType
            ((AlgebraicGeometry.Scheme.Hom.appLE X.hom ⊤ (U j) le_top).hom.comp
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom)
          exact hFT_app.comp (RingHom.FiniteType.of_surjective _ hSurjIso)
        let _ : Algebra k A_j := κ_j.toAlgebra
        have hAlgFT : Algebra.FiniteType k A_j := hFT_κ
        obtain ⟨nj, ψ, hSurjψ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hAlgFT
        refine ⟨nj, fun m => ψ (MvPolynomial.X m), ?_⟩
        have hEqHom : ψ.toRingHom = MvPolynomial.eval₂Hom κ_j (fun m => ψ (MvPolynomial.X m)) := by
          apply MvPolynomial.ringHom_ext'
          · ext c
            simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
              MvPolynomial.eval₂Hom_C]
            exact ψ.commutes c
          · intro m
            simp
        rw [← hEqHom]
        exact hSurjψ
      choose n f_gen hGen using hGenEx
      have hInter : ∀ (m : ℕ) (V : Fin (m + 1) → X.left.Opens),
          (∀ i, Nonempty (V i)) → (∀ i, AlgebraicGeometry.IsAffineOpen (V i)) →
          Nonempty (⨅ i : Fin (m + 1), V i : X.left.Opens) ∧
            AlgebraicGeometry.IsAffineOpen (⨅ i : Fin (m + 1), V i : X.left.Opens) := by
        intro m
        induction m with
        | zero =>
          intro V hNonV hAffV
          have hEq : (⨅ i : Fin 1, V i) = V 0 := ciInf_unique
          rw [hEq]
          exact ⟨hNonV 0, hAffV 0⟩
        | succ m ih =>
          intro V hNonV hAffV
          have hEq : (⨅ i : Fin (m + 2), V i) = V 0 ⊓ (⨅ i : Fin (m + 1), V i.succ) := by
            apply le_antisymm
            · exact le_inf (iInf_le V 0) (le_iInf fun i => iInf_le V i.succ)
            · refine le_iInf fun i => ?_
              refine Fin.cases ?_ ?_ i
              · exact inf_le_left
              · intro j
                exact inf_le_right.trans (iInf_le (fun k : Fin (m + 1) => V k.succ) j)
          rw [hEq]
          let Vrest : X.left.Opens := ⨅ i : Fin (m + 1), V i.succ
          obtain ⟨hNonRest, hAffRest⟩ := ih (fun i => V i.succ) (fun i => hNonV i.succ) (fun i => hAffV i.succ)
          obtain ⟨⟨x₁, hx₁⟩⟩ := hNonV 0
          obtain ⟨⟨x₂, hx₂⟩⟩ := hNonRest
          obtain ⟨z, _, hz₁, hz₂⟩ := PreirreducibleSpace.isPreirreducible_univ
            (V 0 : Set X.left) (Vrest : Set X.left)
            (V 0).isOpen Vrest.isOpen ⟨x₁, trivial, hx₁⟩ ⟨x₂, trivial, hx₂⟩
          exact ⟨⟨⟨z, hz₁, hz₂⟩⟩, (hAffV 0).inf hAffRest⟩
      let U₀ : X.left.Opens := ⨅ j : Fin r, U j
      obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hr)
      have hU₀_eq : U₀ = ⨅ i : Fin (m + 1), U (Fin.cast hm.symm i) := by
        apply le_antisymm
        · exact le_iInf fun i => iInf_le U (Fin.cast hm.symm i)
        · exact le_iInf fun j => (iInf_le (fun i : Fin (m + 1) => U (Fin.cast hm.symm i)) (Fin.cast hm j)).trans (by simp)
      have hU₀_props : Nonempty U₀ ∧ AlgebraicGeometry.IsAffineOpen U₀ := by
        rw [hU₀_eq]
        exact hInter m (fun i => U (Fin.cast hm.symm i))
          (fun i => hNonU (Fin.cast hm.symm i)) (fun i => hAffU (Fin.cast hm.symm i))
      exact ⟨hSepX, r, hr, U, hCovU, hAffU, hNonU, n, f_gen, hGen, U₀, fun j => iInf_le U j,
        hU₀_props.1, hU₀_props.2⟩
    obtain ⟨hSepX, r, hr, U, hCovU, hAffU, _hNonU, n, f_gen, hGen, U₀, hU₀_le, hU₀, hAffU₀⟩ := step1
    
    have step2 :
        ∃ (N : ℕ)
          (Φ : (U₀ : AlgebraicGeometry.Scheme.{u}) ⟶ (weilProjectiveSpaceOver k N).left)
          (D : Fin (N + 1) → (weilProjectiveSpaceOver k N).left.Opens)
          (z : ∀ (_β γ : Fin (N + 1)),
            ↑((weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op (D γ))))
          (IsZeroAt : Fin r → Fin (N + 1) → Prop),
          (Φ ≫ (weilProjectiveSpaceOver k N).hom = U₀.ι ≫ X.hom) ∧
          ((⨆ γ : Fin (N + 1), D γ = ⊤) ∧
            (∀ γ : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D γ)) ∧
            (∀ β γ : Fin (N + 1),
              (weilProjectiveSpaceOver k N).left.basicOpen (z β γ) ≤ D β)) ∧
          (∀ (j₀ : Fin r) (γ : Fin (N + 1)),
            ∃ (β : Fin (N + 1)) (u : ↑(X.left.presheaf.obj (Opposite.op (U j₀)))),
              IsZeroAt j₀ β ∧
              ((AlgebraicGeometry.Scheme.Hom.app Φ (D γ)).hom (z β γ)) *
                ((AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j₀)
                  ((TopologicalSpace.Opens.map Φ.base).obj (D γ))
                  (fun x _ => hU₀_le j₀ x.2)).hom u) = 1) ∧
          (∀ (j : Fin r) (β : Fin (N + 1)), IsZeroAt j β → ∀ m : Fin (n j),
            ∃ β_m : Fin (N + 1),
              (AlgebraicGeometry.Scheme.Hom.app Φ (D β)).hom (z β_m β) =
                (AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j)
                  ((TopologicalSpace.Opens.map Φ.base).obj (D β))
                  (fun x _ => hU₀_le j x.2)).hom (f_gen j m)) := by
      clear hSepX hCovU hAffU _hNonU hGen hU₀ hAffU₀ hIntX hf f
      let f_tilde : ∀ j : Fin r, Fin (n j + 1) → ↑(X.left.presheaf.obj (Opposite.op (U j))) :=
        fun j => Fin.cases 1 (f_gen j)
      let M : ℕ := ∏ j : Fin r, (n j + 1)
      have hM_pos : 1 ≤ M := Finset.one_le_prod (fun j _ => Nat.succ_pos (n j))
      let N : ℕ := M - 1
      have hNM : N + 1 = M := Nat.sub_add_cancel hM_pos
      have hCard : Fintype.card (∀ j : Fin r, Fin (n j + 1)) = N + 1 := by
        simp [Fintype.card_pi, M, hNM]
      let e : Fin (N + 1) ≃ (∀ j : Fin r, Fin (n j + 1)) :=
        (Fintype.equivFinOfCardEq hCard).symm
      let IsZeroAt : Fin r → Fin (N + 1) → Prop := fun j β => (e β) j = 0
      let i₀ : Fin (N + 1) := e.symm (fun _ => 0)
      let ρ : ∀ j : Fin r, ↑(X.left.presheaf.obj (Opposite.op (U j))) →+*
          ↑((U₀ : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) :=
        fun j => (AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j) ⊤ (fun x _ => hU₀_le j x.2)).hom
      let κ₀_cat : CommRingCat.of k ⟶ (U₀ : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (U₀.ι ≫ X.hom).appTop
      let κ₀ : k →+* ↑((U₀ : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) := κ₀_cat.hom
      let g : Fin (N + 1) → ↑((U₀ : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) :=
        fun α => ∏ j : Fin r, ρ j (f_tilde j ((e α) j))
      have hg_i₀ : g i₀ = 1 := by
        simp [g, i₀, f_tilde]
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      let _ : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
        ⟨fun c x q => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) q⟩
      have hX : ∀ α : Fin (N + 1), (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜 1 :=
        fun α => MvPolynomial.isHomogeneous_X k α
      let ψ : MvPolynomial (Fin (N + 1)) k →+*
          ↑((U₀ : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) :=
        MvPolynomial.eval₂Hom κ₀ g
      have hUnit₀ : IsUnit (ψ (MvPolynomial.X i₀)) := by
