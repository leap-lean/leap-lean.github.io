    rw [← sub_eq_zero, ← map_sub, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    have hβv : β v = Ideal.Quotient.mk K (Finset.univ.sum fun p : Fin D.r × Fin (ℓ * n) =>
        algebraMap (Polynomial A) D.R₀ (Polynomial.C (v p)) * t ^ p.2.val * D.b₀ p.1) := by
      change (Finset.univ.sum fun p : Fin D.r × Fin (ℓ * n) =>
        v p • Ideal.Quotient.mk K (t ^ p.2.val * D.b₀ p.1)) = _
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro p _
      rw [← IsScalarTower.algebraMap_smul D.R₀ (v p), hK_smul, halg_A (v p), mul_assoc]
    let d : D.R₀ := x - ((Finset.univ.sum fun p : Fin D.r × Fin (ℓ * n) =>
      algebraMap (Polynomial A) D.R₀ (Polynomial.C (v p)) * t ^ p.2.val * D.b₀ p.1) + k_elem)
    have hd_mem : d ∈ Ideal.map (algebraMap A D.R₀) 𝔪_A := by
      rw [← hker_eq_map]
      exact hx_mod
    have hdiff : β v - Ideal.Quotient.mk K x = (-d) • Ideal.Quotient.mk K (1 : D.R₀) := by
      rw [hβv, hK_smul, mul_one, ← map_sub]
      apply Ideal.Quotient.eq.mpr
      have hring : (Finset.univ.sum fun p : Fin D.r × Fin (ℓ * n) =>
          algebraMap (Polynomial A) D.R₀ (Polynomial.C (v p)) * t ^ p.2.val * D.b₀ p.1) - x -
          (-d) = -k_elem := by
        dsimp [d]
        ring
      rw [hring]
      exact K.neg_mem hk_mem
    rw [hdiff]
    exact hExt_smul (D.R₀ ⧸ K) (-d) ((Ideal.map (algebraMap A D.R₀) 𝔪_A).neg_mem hd_mem)
      (Ideal.Quotient.mk K (1 : D.R₀))
  let φ_σ₀ : D.R₀ →ₗ[D.R₀] (L₀ ⧸ S_w) := S_w.mkQ.comp (LinearMap.toSpanSingleton D.R₀ L₀ σ₀)
  have hK_ker : K ≤ LinearMap.ker φ_σ₀ := by
    intro r₀ hr₀
    rw [LinearMap.mem_ker]
    change S_w.mkQ (r₀ • σ₀) = 0
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact hK_le_Sw (Submodule.smul_mem_smul hr₀ Submodule.mem_top)
  let α : (D.R₀ ⧸ K) →ₗ[D.R₀] (L₀ ⧸ S_w) := Submodule.liftQ K φ_σ₀ hK_ker
  have hα_mk : ∀ r₀ : D.R₀, α (Ideal.Quotient.mk K r₀) = S_w.mkQ (r₀ • σ₀) :=
    fun r₀ => Submodule.liftQ_apply K φ_σ₀ r₀
  have hα_β : ∀ v : Fin D.r × Fin (ℓ * n) → A, α (β v) = Ψ₀ v := by
    intro v
    change α (Finset.univ.sum fun p => v p • Ideal.Quotient.mk K (t ^ p.2.val * D.b₀ p.1)) =
      Finset.univ.sum fun p => v p • S_w.mkQ ((t ^ p.2.val * D.b₀ p.1) • σ₀)
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro p _
    rw [← IsScalarTower.algebraMap_smul D.R₀ (v p), map_smul, hα_mk,
      IsScalarTower.algebraMap_smul]
  have hα_inj : Function.Injective α := by
    intro y₁ y₂ hy
    obtain ⟨v₁, rfl⟩ := hβ_surj y₁
    obtain ⟨v₂, rfl⟩ := hβ_surj y₂
    rw [hα_β v₁, hα_β v₂] at hy
    rw [hΨ₀_bij.1 hy]
  have hlam_w₀_mem : lam₀ w₀ ∈ K := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    apply hα_inj
    rw [map_zero, hα_mk (lam₀ w₀), hSymm₀ w₀ σ₀, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero]
    exact S_w.smul_mem (lam₀ σ₀) (Submodule.subset_span (Set.mem_singleton w₀))
  have hσ₀_RK_bij : Function.Bijective (fun z : D.R₀ ⧸ K => (lam₀ σ₀) • z) :=
    hUnit_bij (D.R₀ ⧸ K) (lam₀ σ₀) hσ₀_unit
  obtain ⟨y_triv, hy_triv⟩ := hσ₀_RK_bij.2 (Ideal.Quotient.mk K 1)
  obtain ⟨q_triv, rfl⟩ := Ideal.Quotient.mk_surjective y_triv
  dsimp only at hy_triv
  let j₀ : D.R₀ := 1 - q_triv * lam₀ σ₀
  have hj₀_mem : j₀ ∈ K := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    dsimp [j₀]
    rw [map_sub]
    have hmul_eq : Ideal.Quotient.mk K (q_triv * lam₀ σ₀) =
        (lam₀ σ₀) • Ideal.Quotient.mk K q_triv := by
      rw [hK_smul, mul_comm]
    rw [hmul_eq, hy_triv, sub_self]
  have hw₀_mem : w₀ ∈ K • (⊤ : Submodule D.R₀ L₀) := by
    have hw₀_eq : w₀ = (q_triv * lam₀ w₀) • σ₀ + j₀ • w₀ := by
      calc
        w₀ = (1 : D.R₀) • w₀ := (one_smul D.R₀ w₀).symm
        _ = (q_triv * lam₀ σ₀ + j₀) • w₀ := by
          have h1 : (1 : D.R₀) = q_triv * lam₀ σ₀ + j₀ := by
            dsimp [j₀]
            ring
          rw [← h1]
        _ = (q_triv * lam₀ σ₀) • w₀ + j₀ • w₀ := by rw [add_smul]
        _ = q_triv • ((lam₀ σ₀) • w₀) + j₀ • w₀ := by rw [mul_smul]
        _ = q_triv • ((lam₀ w₀) • σ₀) + j₀ • w₀ := by rw [hSymm₀ σ₀ w₀]
        _ = (q_triv * lam₀ w₀) • σ₀ + j₀ • w₀ := by rw [← mul_smul]
    rw [hw₀_eq]
    exact (K • (⊤ : Submodule D.R₀ L₀)).add_mem
      (Submodule.smul_mem_smul (K.mul_mem_left q_triv hlam_w₀_mem) Submodule.mem_top)
      (Submodule.smul_mem_smul hj₀_mem Submodule.mem_top)
  have hSw_le_K : S_w ≤ K • (⊤ : Submodule D.R₀ L₀) :=
    Submodule.span_le.mpr (Set.singleton_subset_iff.mpr hw₀_mem)
  have hSpan_eq : K • (⊤ : Submodule D.R₀ L₀) = S_w := le_antisymm hK_le_Sw hSw_le_K
  exact ⟨G_near, G_far, h_c, hGn_monic, hGn_deg, hGn_red, hCop, hMul_fc, hJ₀_red, hSpan_eq⟩

theorem weil_monic_chartOne_reciprocal_ideal_and_section_span (k : Type u) [Field k]
    (ℓ : ℕ)
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (D : WeilTwoChartRingDatum A)
    (D₀ : WeilTwoChartRingDatum k)
    (red : WeilTwoChartCurveReduction D D₀)
    (hValid : WeilIsValidTwoChartCurveReduction τ_A D D₀ red)
    (M : WeilTwoChartLineBundle D)
    (n : ℕ) (hn_w : ∀ j : Fin D.r, D.w j < n)
    (lam₁ : M.L₁ →ₗ[D.R₁] D.R₁)
    (c : Fin D.r → Fin n → A) (w₀ : M.L₀) (w₁ : M.L₁)
    (G_near G_far : Polynomial A) (h_c : D.R₀) :
    letI : Algebra D.R₁ D₀.R₁ := red.algR₁
    let t : D.R₀ := algebraMap (Polynomial A) D.R₀ Polynomial.X
    let u : D.R₁ := algebraMap (Polynomial A) D.R₁ Polynomial.X
    let u₀₁ : D.R₀₁ := algebraMap D.R₁ D.R₀₁ u
    let u_bar : D₀.R₁ := algebraMap (Polynomial k) D₀.R₁ Polynomial.X
    let π₁ : D.R₁ →+* D₀.R₁ := algebraMap D.R₁ D₀.R₁
    let f_c : D.R₀ := t ^ n + Finset.univ.sum fun j : Fin D.r =>
      Finset.univ.sum fun s : Fin n =>
        algebraMap (Polynomial A) D.R₀ (Polynomial.C (c j s)) * t ^ s.val * D.b₀ j
    let g_near : D.R₀ := algebraMap (Polynomial A) D.R₀ G_near
    (∀ y τ : M.L₁, lam₁ y • τ = lam₁ τ • y) →
    (∀ r₁ : D.R₁, lam₁ w₁ * r₁ = 0 → r₁ = 0) →
    (∀ (j : Fin D.r) (s : Fin n), τ_A (c j s) = 0) →
    u₀₁ ^ (ℓ * n) • M.θ (TensorProduct.tmul D.R₀ (1 : D.R₀₁) w₀) =
      TensorProduct.tmul D.R₁ (1 : D.R₀₁) w₁ →
    (∀ y : M.L₁ ⧸ Submodule.span D.R₁ {w₁},
      ∃ y' : M.L₁ ⧸ Submodule.span D.R₁ {w₁}, u • y' = y) →
    G_near.Monic →
    G_near.natDegree = D.r * n →
    Polynomial.map τ_A.toRingHom G_near = Polynomial.X ^ (D.r * n) →
    IsCoprime G_near G_far →
    algebraMap (Polynomial A) D.R₀ (G_near * G_far) = f_c * h_c →
    (Ideal.span ({f_c, g_near} : Set D.R₀) ^ ℓ) • (⊤ : Submodule D.R₀ M.L₀) =
      Submodule.span D.R₀ {w₀} →
    ∃ (F_c₁ h_near G_far₁ H_c₁ u_star v₁ v₂ a₁ b₁ : D.R₁),
      π₁ F_c₁ = u_bar ^ n ∧
      π₁ h_near = 1 ∧
      h_near * G_far₁ = F_c₁ * H_c₁ ∧
      v₁ * h_near + v₂ * G_far₁ = u_star ∧
      a₁ * u_star + b₁ * h_near = 1 ∧
      Ideal.map (algebraMap D.R₀ D.R₀₁) (Ideal.span ({f_c, g_near} : Set D.R₀)) =
        Ideal.map (algebraMap D.R₁ D.R₀₁) (Ideal.span ({F_c₁, h_near} : Set D.R₁)) ∧
      (Ideal.span ({F_c₁, h_near} : Set D.R₁) ^ ℓ) • (⊤ : Submodule D.R₁ M.L₁) =
        Submodule.span D.R₁ {w₁} :=
by
  let _ : Algebra D.R₁ D₀.R₁ := red.algR₁
  intro t u u₀₁ u_bar π₁ f_c g_near
    hSymm₁ hw₁_nzd hc_ker hw_gl hU hGn_monic hGn_deg hGn_red hCop hMul_fc hSpan₀
  classical
  have hD : WeilIsValidTwoChartRingDatum D := hValid.1
  have hr_pos : 1 ≤ D.r := hD.1
  have hb₁_bij : Function.Bijective (fun f : Fin D.r → Polynomial A =>
      Finset.univ.sum fun j => algebraMap (Polynomial A) D.R₁ (f j) * D.b₁ j) := hD.2.2.1
  have hLoc_t : IsLocalization.Away t D.R₀₁ := hD.2.2.2.1
  have hLoc_u : IsLocalization.Away u D.R₀₁ := hD.2.2.2.2.1
  haveI : IsLocalization.Away t D.R₀₁ := hLoc_t
  haveI : IsLocalization.Away u D.R₀₁ := hLoc_u
  let ι₀ : D.R₀ →+* D.R₀₁ := algebraMap D.R₀ D.R₀₁
  let ι₁ : D.R₁ →+* D.R₀₁ := algebraMap D.R₁ D.R₀₁
  let t₀₁ : D.R₀₁ := ι₀ t
  have htu : t₀₁ * u₀₁ = 1 := hD.2.2.2.2.2.1
  have hut : u₀₁ * t₀₁ = 1 := by rw [mul_comm, htu]
  have htu_pow : ∀ m : ℕ, t₀₁ ^ m * u₀₁ ^ m = 1 := fun m => by
    rw [← mul_pow, htu, one_pow]
  have hut_pow : ∀ m : ℕ, u₀₁ ^ m * t₀₁ ^ m = 1 := fun m => by
    rw [← mul_pow, hut, one_pow]
  have hC_ov : ∀ a : A,
      ι₀ (algebraMap (Polynomial A) D.R₀ (Polynomial.C a)) =
        ι₁ (algebraMap (Polynomial A) D.R₁ (Polynomial.C a)) := hD.2.2.2.2.2.2.1
  have hb_ov : ∀ j : Fin D.r,
      ι₁ (D.b₁ j) = u₀₁ ^ (D.w j) * ι₀ (D.b₀ j) := hD.2.2.2.2.2.2.2
  have hπ₁_poly : ∀ p : Polynomial A,
      π₁ (algebraMap (Polynomial A) D.R₁ p) =
        algebraMap (Polynomial k) D₀.R₁ (Polynomial.map τ_A.toRingHom p) :=
    hValid.2.2.2.2.1
  let d : ℕ := D.r * n
  let F_c₁ : D.R₁ := u ^ n + Finset.univ.sum fun j : Fin D.r =>
    Finset.univ.sum fun s : Fin n =>
      algebraMap (Polynomial A) D.R₁ (Polynomial.C (c j s)) *
        u ^ (2 * n - s.val - D.w j) * D.b₁ j
  let H_near : Polynomial A := 1 + Finset.univ.sum fun i : Fin d =>
    Polynomial.C (G_near.coeff i.val) * Polynomial.X ^ (d - i.val)
  let h_near : D.R₁ := algebraMap (Polynomial A) D.R₁ H_near
  have hu_red : π₁ u = u_bar := by
    dsimp [u, u_bar]
    rw [hπ₁_poly Polynomial.X, Polynomial.map_X]
  have hFc₁_red : π₁ F_c₁ = u_bar ^ n := by
    dsimp [F_c₁]
    rw [map_add, map_pow, hu_red]
    have hsum0 : π₁ (Finset.univ.sum fun j : Fin D.r =>
        Finset.univ.sum fun s : Fin n =>
          algebraMap (Polynomial A) D.R₁ (Polynomial.C (c j s)) *
            u ^ (2 * n - s.val - D.w j) * D.b₁ j) = 0 := by
      rw [map_sum]
      apply Finset.sum_eq_zero
      intro j _
      rw [map_sum]
      apply Finset.sum_eq_zero
      intro s _
      rw [map_mul, map_mul, hπ₁_poly (Polynomial.C (c j s)), Polynomial.map_C]
      have hc0 : τ_A.toRingHom (c j s) = 0 := hc_ker j s
      rw [hc0, Polynomial.C_0, map_zero, zero_mul, zero_mul]
    rw [hsum0, add_zero]
  have hh_red : π₁ h_near = 1 := by
    dsimp [h_near, H_near]
    rw [hπ₁_poly, Polynomial.map_add, Polynomial.map_one, Polynomial.map_sum]
    have hsum0 : (Finset.univ.sum fun i : Fin d =>
        Polynomial.map τ_A.toRingHom
          (Polynomial.C (G_near.coeff i.val) * Polynomial.X ^ (d - i.val))) = 0 := by
      apply Finset.sum_eq_zero
      intro i _
      have hi_ne : i.val ≠ D.r * n := Nat.ne_of_lt i.isLt
      have hcoeff0 : τ_A.toRingHom (G_near.coeff i.val) = 0 := by
        rw [← Polynomial.coeff_map, hGn_red, Polynomial.coeff_X_pow]
        exact if_neg hi_ne
      rw [Polynomial.map_mul, Polynomial.map_C, hcoeff0, Polynomial.C_0, zero_mul]
    rw [hsum0, add_zero, map_one]
  have hCop_u : IsCoprime u h_near := by
    let Q_near : Polynomial A := Finset.univ.sum fun i : Fin d =>
      Polynomial.C (G_near.coeff i.val) * Polynomial.X ^ (d - 1 - i.val)
    have hH_eq : H_near = 1 + Polynomial.X * Q_near := by
      dsimp [H_near, Q_near]
      congr 1
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      have hexp : d - i.val = (d - 1 - i.val) + 1 := by
        have := i.isLt
        omega
      rw [hexp, pow_succ]
      ring
    have hh_eq : h_near = 1 + u * algebraMap (Polynomial A) D.R₁ Q_near := by
      dsimp [h_near, u]
      rw [hH_eq, map_add, map_one, map_mul]
    refine ⟨-(algebraMap (Polynomial A) D.R₁ Q_near), 1, ?_⟩
    rw [hh_eq]
    ring
  have hGn_decomp : G_near = Polynomial.X ^ d + Finset.univ.sum (fun i : Fin d =>
      Polynomial.C (G_near.coeff i.val) * Polynomial.X ^ i.val) := by
    ext m
    rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.finsetSum_coeff]
    by_cases hm_lt : m < d
    · have hm_ne : m ≠ d := Nat.ne_of_lt hm_lt
      simp only [hm_ne, hm_ne.symm, ↓reduceIte, zero_add]
      let i_m : Fin d := ⟨m, hm_lt⟩
      have hsum_single : (Finset.univ.sum fun i : Fin d =>
          (Polynomial.C (G_near.coeff i.val) * Polynomial.X ^ i.val).coeff m) =
          (Polynomial.C (G_near.coeff i_m.val) * Polynomial.X ^ i_m.val).coeff m := by
        apply Finset.sum_eq_single i_m
        · intro i _ hi_ne
          rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
          have hval_ne : m ≠ i.val := fun h_eq => hi_ne (Fin.ext h_eq.symm)
          simp [hval_ne, hval_ne.symm]
        · intro h_abs
          exact False.elim (h_abs (Finset.mem_univ i_m))
      rw [hsum_single, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      simp [i_m]
    · by_cases hm_eq : m = d
      · subst hm_eq
        simp only [↓reduceIte]
        have hsum0 : (Finset.univ.sum fun i : Fin d =>
            (Polynomial.C (G_near.coeff i.val) * Polynomial.X ^ i.val).coeff d) = 0 := by
          apply Finset.sum_eq_zero
          intro i _
          rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
          have hval_ne : d ≠ i.val := Nat.ne_of_gt i.isLt
          simp [hval_ne, hval_ne.symm]
        rw [hsum0, add_zero]
        change G_near.coeff (D.r * n) = 1
        rw [← hGn_deg]
        exact hGn_monic.leadingCoeff
      · have hm_gt : d < m := by omega
        simp only [hm_eq, Ne.symm hm_eq, ↓reduceIte, zero_add]
        have hsum0 : (Finset.univ.sum fun i : Fin d =>
            (Polynomial.C (G_near.coeff i.val) * Polynomial.X ^ i.val).coeff m) = 0 := by
          apply Finset.sum_eq_zero
          intro i _
          rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
          have hval_ne : m ≠ i.val := by
            have := i.isLt
            omega
          simp [hval_ne, hval_ne.symm]
        rw [hsum0]
        apply Polynomial.coeff_eq_zero_of_natDegree_lt
        dsimp [d] at hm_gt
        omega
  have hFc₁_ov : ι₁ F_c₁ = u₀₁ ^ (2 * n) * ι₀ f_c := by
    dsimp [F_c₁, f_c]
    rw [map_add, map_add, mul_add]
    congr 1
    · have h1 : ι₁ (u ^ n) = u₀₁ ^ n := map_pow ι₁ u n
      have h2 : ι₀ (t ^ n) = t₀₁ ^ n := map_pow ι₀ t n
      rw [h1, h2]
      have h2n : 2 * n = n + n := by omega
      rw [h2n, pow_add, mul_assoc, hut_pow n, mul_one]
    · rw [map_sum, map_sum, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      rw [map_sum, map_sum, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro s _
      have hu2n : u₀₁ ^ (2 * n) =
          u₀₁ ^ (2 * n - s.val - D.w j) * u₀₁ ^ s.val * u₀₁ ^ D.w j := by
        rw [← pow_add, ← pow_add]
        congr 1
        have hs := s.isLt
        have hw := hn_w j
        omega
      rw [map_mul, map_mul, map_pow, map_mul, map_mul, map_pow]
      change ι₁ (algebraMap (Polynomial A) D.R₁ (Polynomial.C (c j s))) *
          u₀₁ ^ (2 * n - s.val - D.w j) * ι₁ (D.b₁ j) =
        u₀₁ ^ (2 * n) * (ι₀ (algebraMap (Polynomial A) D.R₀ (Polynomial.C (c j s))) *
          t₀₁ ^ s.val * ι₀ (D.b₀ j))
      rw [hC_ov (c j s), hb_ov j, hu2n]
      calc
        ι₁ (algebraMap (Polynomial A) D.R₁ (Polynomial.C (c j s))) *
            u₀₁ ^ (2 * n - s.val - D.w j) * (u₀₁ ^ D.w j * ι₀ (D.b₀ j))
          = ι₁ (algebraMap (Polynomial A) D.R₁ (Polynomial.C (c j s))) *
              u₀₁ ^ (2 * n - s.val - D.w j) * (u₀₁ ^ s.val * t₀₁ ^ s.val) *
              (u₀₁ ^ D.w j * ι₀ (D.b₀ j)) := by rw [hut_pow s.val, mul_one]
        _ = (u₀₁ ^ (2 * n - s.val - D.w j) * u₀₁ ^ s.val * u₀₁ ^ D.w j) *
              (ι₁ (algebraMap (Polynomial A) D.R₁ (Polynomial.C (c j s))) *
                t₀₁ ^ s.val * ι₀ (D.b₀ j)) := by ring
  have hh_ov : ι₁ h_near = u₀₁ ^ d * ι₀ g_near := by
    have hg_eq : g_near = t ^ d + Finset.univ.sum (fun i : Fin d =>
        algebraMap (Polynomial A) D.R₀ (Polynomial.C (G_near.coeff i.val)) * t ^ i.val) := by
      dsimp [g_near, t]
      conv_lhs => rw [hGn_decomp]
      rw [map_add, map_pow, map_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro i _
      rw [map_mul, map_pow]
    have hh_eq : h_near = 1 + Finset.univ.sum (fun i : Fin d =>
        algebraMap (Polynomial A) D.R₁ (Polynomial.C (G_near.coeff i.val)) * u ^ (d - i.val)) := by
      dsimp [h_near, H_near, u]
      rw [map_add, map_one, map_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro i _
      rw [map_mul, map_pow]
    rw [hh_eq, hg_eq, map_add, map_one, map_add, mul_add]
    congr 1
    · change 1 = u₀₁ ^ d * ι₀ (t ^ d)
      rw [map_pow]
      exact (hut_pow d).symm
    · rw [map_sum, map_sum, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      have hud : u₀₁ ^ d = u₀₁ ^ (d - i.val) * u₀₁ ^ i.val := by
        rw [← pow_add]
        congr 1
        have := i.isLt
        omega
      rw [map_mul, map_pow, map_mul, map_pow]
