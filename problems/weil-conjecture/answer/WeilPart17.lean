  have iso_refl : ∀ {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
      (E : WeilTwoChartLineBundle D), WeilTwoChartIso D E E := by
    intro B _ D E
    refine ⟨LinearEquiv.refl D.R₀ E.L₀, LinearEquiv.refl D.R₁ E.L₁, ?_⟩
    ext z
    simp [bc_refl]
  have iso_symm : ∀ {B : Type u} [CommRing B] {D : WeilTwoChartRingDatum B}
      {E F : WeilTwoChartLineBundle D},
      WeilTwoChartIso D E F → WeilTwoChartIso D F E := by
    intro B _ D E F ⟨e₀, e₁, h⟩
    refine ⟨e₀.symm, e₁.symm, ?_⟩
    ext z
    have h₁ := LinearEquiv.congr_fun h (LinearEquiv.baseChange D.R₀ D.R₀₁ F.L₀ E.L₀ e₀.symm z)
    simp only [LinearEquiv.trans_apply] at h₁ ⊢
    have h₀ : LinearEquiv.baseChange D.R₀ D.R₀₁ E.L₀ F.L₀ e₀
        (LinearEquiv.baseChange D.R₀ D.R₀₁ F.L₀ E.L₀ e₀.symm z) = z := by
      rw [← bc_trans, LinearEquiv.symm_trans_self, bc_refl]
    rw [h₀] at h₁
    have h₂ := congrArg (LinearEquiv.baseChange D.R₁ D.R₀₁ F.L₁ E.L₁ e₁.symm) h₁
    rw [← bc_trans, LinearEquiv.self_trans_symm, bc_refl] at h₂
    exact h₂.symm
  have iso_trans : ∀ {B : Type u} [CommRing B] {D : WeilTwoChartRingDatum B}
      {E F G : WeilTwoChartLineBundle D},
      WeilTwoChartIso D E F → WeilTwoChartIso D F G → WeilTwoChartIso D E G := by
    intro B _ D E F G ⟨e₀, e₁, hEF⟩ ⟨f₀, f₁, hFG⟩
    refine ⟨e₀.trans f₀, e₁.trans f₁, ?_⟩
    ext z
    have h₁ := LinearEquiv.congr_fun hFG (LinearEquiv.baseChange D.R₀ D.R₀₁ E.L₀ F.L₀ e₀ z)
    have h₂ := LinearEquiv.congr_fun hEF z
    simp only [LinearEquiv.trans_apply] at h₁ h₂ ⊢
    rw [bc_trans, bc_trans, h₁, h₂]
