    obtain ⟨ψ₂, hψ₂_c, hψ₂_t⟩ :=
      hUniv_P1 0 ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen s_reg)))
        (α_Y (Y.basicOpen s_reg)) ![1, q₂] rfl
    have hψ₂_F : φ_W2.hom.comp ψ₂ = χ_0 := by
      have hSub : Set.range (c_P1 0) ∪ Set.range (t_P1 0) ⊆
          (RingHom.eqLocus (φ_W2.hom.comp ψ₂) χ_0 : Set (Γ_chart 0)) := by
        rintro x (⟨r, rfl⟩ | ⟨b, rfl⟩)
