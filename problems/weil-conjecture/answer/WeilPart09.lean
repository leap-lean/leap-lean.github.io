theorem weil_projLine_twoChart_and_functionField_pkg (Ω : Type u) [Field Ω] :
    ∃ (ι₀ ι₁ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω)) ⟶
          (weilProjectiveSpaceOver Ω 1).left)
      (ρ₁ : Polynomial Ω →+* FractionRing (Polynomial Ω)),
      AlgebraicGeometry.IsOpenImmersion ι₀ ∧
      AlgebraicGeometry.IsOpenImmersion ι₁ ∧
      ι₀ ≫ (weilProjectiveSpaceOver Ω 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      ι₁ ≫ (weilProjectiveSpaceOver Ω 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      Set.range ι₀.base ∪ Set.range ι₁.base = Set.univ ∧
      AlgebraicGeometry.IsReduced (weilProjectiveSpaceOver Ω 1).left ∧
      (weilProjectiveSpaceOver Ω 1).left.IsSeparated ∧
      AlgebraicGeometry.IsDominant
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)))) ≫ ι₀) ∧
      (∀ c : Ω, ρ₁ (Polynomial.C c) =
        algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) (Polynomial.C c)) ∧
      ρ₁ Polynomial.X *
        algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) Polynomial.X = 1 ∧
      AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)))) ≫ ι₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁) ≫ ι₁ :=
by
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let P₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
  have hX_mem : ∀ a : Fin 2, (MvPolynomial.X a : MvPolynomial (Fin 2) Ω) ∈ 𝒜 1 :=
