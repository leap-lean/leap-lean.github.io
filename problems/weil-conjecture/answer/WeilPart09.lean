        exact (mul_eq_zero.mp hψ_mul).resolve_right hg_pow_ne
    let ι_01 : (B_01 ⧸ 𝔯) →ₐ[k₀] K_p :=
      Ideal.Quotient.liftₐ 𝔯 ψ_alg (fun z hz => (hψ_ker z).mpr hz)
    have hInj_01 : Function.Injective ι_01 := by
      intro x₁ x₂ hEq
