  obtain ⟨U, hU, hyU, _⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := Y) (x := y) (U := ⊤) trivial
  let R : Type u := ↑(Y.presheaf.obj (Opposite.op U))
  let j_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y := hU.fromSpec
  let α_R : Ω →+* R := (AlgebraicGeometry.Spec.preimage (j_R ≫ p_Y)).hom
  let _ : Algebra Ω R := α_R.toAlgebra
  have hjR_comm : j_R ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω R)) :=
    (AlgebraicGeometry.Spec.map_preimage (j_R ≫ p_Y)).symm
  have hLFT_jRp : AlgebraicGeometry.LocallyOfFiniteType (j_R ≫ p_Y) := inferInstance
  rw [hjR_comm] at hLFT_jRp
  have hFT_R_hom : (algebraMap Ω R).FiniteType :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp
      hLFT_jRp
  have hFT_R : Algebra.FiniteType Ω R := RingHom.finiteType_algebraMap.mp hFT_R_hom
  have hRed_R : _root_.IsReduced R := AlgebraicGeometry.IsReduced.component_reduced (X := Y) U
  let s₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of D₀) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom)
  have hbot_prime : (⊥ : Ideal Ω).IsPrime :=
    ⟨bot_ne_top, fun {a b} hab => by
      simp only [Ideal.mem_bot] at hab ⊢
      exact mul_eq_zero.mp hab⟩
  let pt_Ω : PrimeSpectrum Ω := ⟨⊥, hbot_prime⟩
  have hpt_unique : ∀ w : PrimeSpectrum Ω, w = pt_Ω := by
    intro w
    apply PrimeSpectrum.ext
    rcases Ideal.eq_bot_or_top w.asIdeal with hbot | htop
    · exact hbot
    · exact False.elim (w.isPrime.ne_top htop)
  have hs₀_pt : s₀.base pt_Ω = q₀ := by
    apply PrimeSpectrum.ext
    change Ideal.comap ev₀.toRingHom ⊥ = q₀.asIdeal
    exact hev₀_ker
  have hSub_s₀ : Set.range (s₀ ≫ j₀ ≫ ι_F).base ⊆ Set.range j_R.base := by
    rintro _ ⟨w, rfl⟩
    rw [hpt_unique w]
    change ι_F.base (j₀.base (s₀.base pt_Ω)) ∈ Set.range ⇑hU.fromSpec
    rw [hs₀_pt, hU.range_fromSpec]
    exact hyU
  let s_R := AlgebraicGeometry.IsOpenImmersion.lift j_R (s₀ ≫ j₀ ≫ ι_F) hSub_s₀
  have hs_R_fac : s_R ≫ j_R = s₀ ≫ j₀ ≫ ι_F :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac j_R (s₀ ≫ j₀ ≫ ι_F) hSub_s₀
  let ev_R : R →+* Ω := (AlgebraicGeometry.Spec.preimage s_R).hom
  have hev_R_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_R) = s_R :=
    AlgebraicGeometry.Spec.map_preimage s_R
  have hev_R_id : ev_R.comp (algebraMap Ω R) = RingHom.id Ω := by
    have hSpec_eq :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_R.comp (algebraMap Ω R))) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id Ω)) := by
      have hid₀ : ev₀.toRingHom.comp (algebraMap Ω D₀) = RingHom.id Ω := by
        ext c
        exact ev₀.commutes c
      calc
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_R.comp (algebraMap Ω R)))
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_R) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω R)) := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = s_R ≫ (j_R ≫ p_Y) := by rw [hev_R_map, hjR_comm]
        _ = (s_R ≫ j_R) ≫ p_Y := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (s₀ ≫ j₀ ≫ ι_F) ≫ p_Y := by rw [hs_R_fac]
        _ = s₀ ≫ (j₀ ≫ (ι_F ≫ p_Y)) := by simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D₀)) := by
              rw [hj₀_comm]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (ev₀.toRingHom.comp (algebraMap Ω D₀))) := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id Ω)) := by rw [hid₀]
    have hpre := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
    rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hpre
    exact congrArg CommRingCat.Hom.hom hpre
  have hev_R_surj : Function.Surjective ev_R :=
    fun c => ⟨algebraMap Ω R c, RingHom.congr_fun hev_R_id c⟩
  let q_R : PrimeSpectrum R := ⟨RingHom.ker ev_R, RingHom.ker_isPrime ev_R⟩
  have hqR_max : q_R.asIdeal.IsMaximal :=
    RingHom.ker_isMaximal_of_surjective ev_R hev_R_surj
  have hs_R_pt : s_R.base pt_Ω = q_R := by
    rw [← hev_R_map]
    apply PrimeSpectrum.ext
    rfl
  have hjR_qR : j_R.base q_R = y := by
    calc
      j_R.base q_R = j_R.base (s_R.base pt_Ω) := by rw [hs_R_pt]
      _ = (s_R ≫ j_R).base pt_Ω := rfl
      _ = (s₀ ≫ j₀ ≫ ι_F).base pt_Ω := by rw [hs_R_fac]
      _ = ι_F.base (j₀.base (s₀.base pt_Ω)) := rfl
      _ = y := by rw [hs₀_pt]
  obtain ⟨P_F, j₁, hPF_min, hj₁_open, hZero_PF, hj₁_fac⟩ := hChart_F U hU ⟨y, hyU, hyF⟩
  have hPF_le : P_F ≤ q_R.asIdeal := by
    have hqR_zero : q_R ∈ PrimeSpectrum.zeroLocus (P_F : Set R) := by
      rw [hZero_PF]
      change j_R.base q_R ∈ F
      rw [hjR_qR]
      exact hyF
    exact hqR_zero
  let ev_quot : (R ⧸ P_F) →+* Ω := Ideal.Quotient.lift P_F ev_R hPF_le
  let q₁ : PrimeSpectrum (R ⧸ P_F) := ⟨RingHom.ker ev_quot, RingHom.ker_isPrime ev_quot⟩
  have hq₁_comap : PrimeSpectrum.comap (Ideal.Quotient.mk P_F) q₁ = q_R := by
    apply PrimeSpectrum.ext
    ext r
    rfl
  have hj₁_comm : j₁ ≫ (ι_F ≫ p_Y) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω (R ⧸ P_F))) := by
    have htower_Q : (Ideal.Quotient.mk P_F).comp (algebraMap Ω R) = algebraMap Ω (R ⧸ P_F) := by
      ext c
      exact (IsScalarTower.algebraMap_apply Ω R (R ⧸ P_F) c).symm
    calc
      j₁ ≫ (ι_F ≫ p_Y) = (j₁ ≫ ι_F) ≫ p_Y := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P_F)) ≫ j_R) ≫ p_Y := by
          rw [hj₁_fac]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P_F)) ≫ (j_R ≫ p_Y) :=
          CategoryTheory.Category.assoc _ _ _
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P_F)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω R)) := by rw [hjR_comm]
      _ = AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk P_F).comp (algebraMap Ω R))) := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω (R ⧸ P_F))) := by
          rw [htower_Q]
  have hj₀_j₁_pt : j₀.base q₀ = j₁.base q₁ := by
    apply ι_F.isClosedEmbedding.injective
    calc
      ι_F.base (j₀.base q₀) = y := rfl
      _ = j_R.base q_R := hjR_qR.symm
      _ = j_R.base (PrimeSpectrum.comap (Ideal.Quotient.mk P_F) q₁) := by rw [hq₁_comap]
      _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P_F)) ≫ j_R).base q₁ :=
          rfl
      _ = (j₁ ≫ ι_F).base q₁ := by rw [← hj₁_fac]
      _ = ι_F.base (j₁.base q₁) := rfl
  obtain ⟨e_stalk⟩ := hZigzag Ω E_F (ι_F ≫ p_Y) D₀ (R ⧸ P_F) j₀ j₁
    hj₀_open hj₁_open hj₀_comm hj₁_comm q₀ q₁ hj₀_j₁_pt
  obtain ⟨e_ql⟩ := hQuotLoc Ω R P_F q_R q₁ hq₁_comap
  exact ⟨R, inferInstance, inferInstance, j_R, q_R, P_F,
    hFT_R, hRed_R, inferInstance, hjR_comm, hqR_max, hPF_min, hPF_le,
    ⟨e_stalk.trans e_ql⟩⟩

theorem weil_algClosed_local_dvr_and_nodal_etale_primes : (∀ (Ω : Type u) [Field Ω]
        (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
        [_root_.IsReduced A] [Algebra Ω A],
      Module.finrank Ω (A ⧸ (IsLocalRing.maximalIdeal A) ^ 2) = 2 →
      IsDomain A) ∧
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (B : Type u) [CommRing B] [Algebra Ω B]
        (q_B : PrimeSpectrum B)
        (φ_node : (MvPolynomial (Fin 2) Ω ⧸
          Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))) →+* B),
      φ_node.Etale →
      (∀ i : Fin 2, φ_node (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q_B.asIdeal) →
      (∀ c : Ω, algebraMap Ω B c = φ_node (Ideal.Quotient.mk _ (MvPolynomial.C c))) →
      ∃ (𝔪_B : PrimeSpectrum B),
        q_B.asIdeal ≤ 𝔪_B.asIdeal ∧
        𝔪_B.asIdeal.IsMaximal ∧
        let L' := Localization.AtPrime 𝔪_B.asIdeal
        let 𝔪' : Ideal L' := IsLocalRing.maximalIdeal L'
        ∃ (x₀ x₁ : L'),
          x₀ ∈ 𝔪' ∧
          x₁ ∈ 𝔪' ∧
          x₀ * x₁ = 0 ∧
          (Ideal.span {x₀} : Ideal L') ⊓ Ideal.span {x₁} = ⊥ ∧
          (Ideal.span {x₀} : Ideal L').IsPrime ∧
          (Ideal.span {x₁} : Ideal L').IsPrime ∧
          Module.finrank Ω (L' ⧸ (Ideal.span {x₀} ⊔ 𝔪' ^ 2)) = 2 ∧
          Module.finrank Ω (L' ⧸ (Ideal.span {x₁} ⊔ 𝔪' ^ 2)) = 2) :=
by
  
  have h_s1 : ∀ (Ω : Type u) [Field Ω]
      (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
      [_root_.IsReduced A] [Algebra Ω A],
      Module.finrank Ω (A ⧸ (IsLocalRing.maximalIdeal A) ^ 2) = 2 →
      True ∧ IsDomain A := by
    intro Ω _ A _ _ _ _ _ hFin2
    refine ⟨trivial, ?_⟩
    let 𝔫 : Ideal A := IsLocalRing.maximalIdeal A
    have hFin2' : Module.finrank Ω (A ⧸ 𝔫 ^ 2) = 2 := hFin2
    have hFinPos : 0 < Module.finrank Ω (A ⧸ 𝔫 ^ 2) := by omega
    have : Module.Finite Ω (A ⧸ 𝔫 ^ 2) := Module.finite_of_finrank_pos hFinPos
    let π₂ : A →ₐ[Ω] (A ⧸ 𝔫 ^ 2) := Ideal.Quotient.mkₐ Ω (𝔫 ^ 2)
    let π₁ : A →ₐ[Ω] (A ⧸ 𝔫) := Ideal.Quotient.mkₐ Ω 𝔫
    let q_alg : (A ⧸ 𝔫 ^ 2) →ₐ[Ω] (A ⧸ 𝔫) :=
      Ideal.Quotient.liftₐ (𝔫 ^ 2) π₁ (by
        intro x hx
        change Ideal.Quotient.mk 𝔫 x = 0
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.pow_le_self (by decide : 2 ≠ 0) hx)
    have hq_surj : Function.Surjective q_alg.toLinearMap := by
      intro y
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨Ideal.Quotient.mk (𝔫 ^ 2) x, rfl⟩
    let N : Submodule Ω (A ⧸ 𝔫 ^ 2) := LinearMap.ker q_alg.toLinearMap
    have h_quot_N : Module.finrank Ω ((A ⧸ 𝔫 ^ 2) ⧸ N) = Module.finrank Ω (A ⧸ 𝔫) :=
      (LinearMap.quotKerEquivOfSurjective q_alg.toLinearMap hq_surj).finrank_eq
    have h_add : Module.finrank Ω (A ⧸ 𝔫) + Module.finrank Ω ↥N = 2 := by
      have h := Submodule.finrank_quotient_add_finrank N
      rw [h_quot_N, hFin2'] at h
      exact h
    have h𝔫_ne_top : 𝔫 ≠ ⊤ := (IsLocalRing.maximalIdeal.isMaximal A).ne_top
    have : Nontrivial (A ⧸ 𝔫) := Ideal.Quotient.nontrivial_iff.mpr h𝔫_ne_top
    have : Module.Finite Ω (A ⧸ 𝔫) := Module.Finite.of_surjective q_alg.toLinearMap hq_surj
    have h_pos_quot : 0 < Module.finrank Ω (A ⧸ 𝔫) := Module.finrank_pos
    have hN_cases : Module.finrank Ω ↥N = 0 ∨ Module.finrank Ω ↥N = 1 := by omega
    have h𝔫_fg : 𝔫.FG := IsNoetherian.noetherian 𝔫
    have h𝔫_jac : 𝔫 ≤ (⊥ : Ideal A).jacobson := by
      rw [IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal A) bot_ne_top]
    rcases hN_cases with hN0 | hN1
    · have hN_bot : N = ⊥ := Submodule.finrank_eq_zero.mp hN0
      have h_le : 𝔫 ≤ (⊥ : Ideal A) ⊔ 𝔫 • 𝔫 := by
        intro x hx
        have hxN : Ideal.Quotient.mk (𝔫 ^ 2) x ∈ N := by
          change Ideal.Quotient.mk 𝔫 x = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr hx
        rw [hN_bot, Submodule.mem_bot, Ideal.Quotient.eq_zero_iff_mem] at hxN
        rw [bot_sup_eq, Ideal.smul_eq_mul, ← pow_two]
        exact hxN
      have h𝔫_bot : 𝔫 = ⊥ :=
        le_bot_iff.mp (Submodule.le_of_le_smul_of_le_jacobson_bot h𝔫_fg h𝔫_jac h_le)
      have hField : IsField A := IsLocalRing.isField_iff_maximalIdeal_eq.mpr h𝔫_bot
      let _ : Field A := hField.toField
      exact inferInstance
    · have hN_ne : N ≠ ⊥ := by
        intro h
        rw [h, finrank_bot] at hN1
        exact one_ne_zero hN1.symm
      obtain ⟨v, hvN, hv_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hN_ne
      obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective v
      have ht_mem : t ∈ 𝔫 := by
        change Ideal.Quotient.mk 𝔫 t = 0 at hvN
        exact Ideal.Quotient.eq_zero_iff_mem.mp hvN
      have ht_ne : t ≠ 0 := by
        intro h
        apply hv_ne
        rw [h, map_zero]
      let v' : ↥N := ⟨Ideal.Quotient.mk (𝔫 ^ 2) t, hvN⟩
      have hv'_ne : v' ≠ 0 := fun h => hv_ne (congrArg Subtype.val h)
      have h_span_top : Submodule.span Ω ({v'} : Set ↥N) = ⊤ :=
        Submodule.eq_top_of_finrank_eq ((finrank_span_singleton hv'_ne).trans hN1.symm)
      have h_le_t : 𝔫 ≤ Ideal.span {t} ⊔ 𝔫 • 𝔫 := by
        intro y hy
        have hyN : Ideal.Quotient.mk (𝔫 ^ 2) y ∈ N := by
          change Ideal.Quotient.mk 𝔫 y = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr hy
        have hy_mem : (⟨Ideal.Quotient.mk (𝔫 ^ 2) y, hyN⟩ : ↥N) ∈
            Submodule.span Ω ({v'} : Set ↥N) := by
          rw [h_span_top]
          trivial
        obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hy_mem
        have hc_val : c • Ideal.Quotient.mk (𝔫 ^ 2) t = Ideal.Quotient.mk (𝔫 ^ 2) y :=
          congrArg Subtype.val hc
        have h_diff : y - algebraMap Ω A c * t ∈ 𝔫 ^ 2 := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub]
          have h_smul :
              Ideal.Quotient.mk (𝔫 ^ 2) (algebraMap Ω A c * t) =
                c • Ideal.Quotient.mk (𝔫 ^ 2) t := by
            rw [← Algebra.smul_def]
            exact map_smul π₂ c t
          rw [h_smul, hc_val, sub_self]
        have h1 : algebraMap Ω A c * t ∈ Ideal.span {t} :=
          Ideal.mem_span_singleton.mpr ⟨algebraMap Ω A c, mul_comm _ _⟩
        have h2 : y - algebraMap Ω A c * t ∈ 𝔫 • 𝔫 := by
          rwa [Ideal.smul_eq_mul, ← pow_two]
        have hy_eq : y = algebraMap Ω A c * t + (y - algebraMap Ω A c * t) := by ring
        rw [hy_eq]
        exact Submodule.add_mem_sup h1 h2
      have h𝔫_eq : 𝔫 = Ideal.span {t} :=
        le_antisymm
          (Submodule.le_of_le_smul_of_le_jacobson_bot h𝔫_fg h𝔫_jac h_le_t)
          (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ht_mem))
      have h𝔫_pow : ∀ k : ℕ, 𝔫 ^ k = Ideal.span {t ^ k} := fun k => by
        rw [h𝔫_eq, Ideal.span_singleton_pow]
      have ht_pow_ne : ∀ k : ℕ, t ^ k ≠ 0 := fun k htk =>
        ht_ne (eq_zero_of_pow_eq_zero htk)
      have h_iInf : (⨅ k : ℕ, 𝔫 ^ k) = ⊥ :=
        Ideal.iInf_pow_eq_bot_of_isLocalRing 𝔫 h𝔫_ne_top
      have h_factor : ∀ x : A, x ≠ 0 → ∃ (r : ℕ) (u : A), IsUnit u ∧ x = t ^ r * u := by
        intro x hx_ne
        have h_ex : ∃ k : ℕ, x ∉ 𝔫 ^ k := by
          by_contra! h_all
          have hx_bot : x ∈ (⊥ : Ideal A) := by
            rw [← h_iInf]
            exact Ideal.mem_iInf.mpr h_all
          exact hx_ne ((Submodule.mem_bot A).mp hx_bot)
        classical
        let k₀ : ℕ := Nat.find h_ex
        have hk₀_spec : x ∉ 𝔫 ^ k₀ := Nat.find_spec h_ex
        have hk₀_ne : k₀ ≠ 0 := by
          intro hk0
          apply hk₀_spec
          rw [hk0, pow_zero, Ideal.one_eq_top]
          trivial
        obtain ⟨r, hr_eq⟩ := Nat.exists_eq_succ_of_ne_zero hk₀_ne
        have hxr : x ∈ 𝔫 ^ r := by
          by_contra hnr
          exact Nat.find_min h_ex (by omega : r < k₀) hnr
        rw [h𝔫_pow r, Ideal.mem_span_singleton] at hxr
        obtain ⟨u, hu_eq⟩ := hxr
        have hu_not_mem : u ∉ 𝔫 := by
          intro hu_mem
          rw [h𝔫_eq, Ideal.mem_span_singleton] at hu_mem
          obtain ⟨u', hu'_eq⟩ := hu_mem
          apply hk₀_spec
          rw [hr_eq, h𝔫_pow (r + 1), Ideal.mem_span_singleton]
          exact ⟨u', by rw [hu_eq, hu'_eq]; ring⟩
        exact ⟨r, u, IsLocalRing.notMem_maximalIdeal.mp hu_not_mem, hu_eq⟩
      have : NoZeroDivisors A := ⟨by
        intro x y hxy
        by_cases hx : x = 0
        · exact Or.inl hx
        · by_cases hy : y = 0
          · exact Or.inr hy
          · exfalso
            obtain ⟨r, u, hu, rfl⟩ := h_factor x hx
            obtain ⟨s, v, hv, rfl⟩ := h_factor y hy
            obtain ⟨w, hw⟩ := hu.mul hv
            have h_mul : (w : A) * t ^ (r + s) = 0 := by
              rw [hw, pow_add]
              linear_combination hxy
            have h_trs : t ^ (r + s) = 0 := by
              calc
                t ^ (r + s) = (↑w⁻¹ * (w : A)) * t ^ (r + s) := by simp
                _ = ↑w⁻¹ * ((w : A) * t ^ (r + s)) := by ring
                _ = 0 := by rw [h_mul, mul_zero]
            exact ht_pow_ne (r + s) h_trs⟩
      exact NoZeroDivisors.to_isDomain A

  refine ⟨fun Ω _ A _ _ _ _ _ h => (h_s1 Ω A h).2, ?_⟩
  intro Ω _ _ B _ _ q_B φ_node hEt hMem_qB hAlg
  let P₂ := MvPolynomial (Fin 2) Ω
  let I_node : Ideal P₂ := Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set P₂)
  let R_node := P₂ ⧸ I_node
  let Xbar : Fin 2 → R_node := fun i => Ideal.Quotient.mk I_node (MvPolynomial.X i)

  obtain ⟨M_B, hM_max, hq_le⟩ := Ideal.exists_le_maximal q_B.asIdeal q_B.isPrime.ne_top
  let 𝔪_B : PrimeSpectrum B := ⟨M_B, hM_max.isPrime⟩
  refine ⟨𝔪_B, hq_le, hM_max, ?_⟩
  let L' := Localization.AtPrime 𝔪_B.asIdeal
  let 𝔪' : Ideal L' := IsLocalRing.maximalIdeal L'
  let y : Fin 2 → B := fun i => φ_node (Xbar i)
  let x : Fin 2 → L' := fun i => algebraMap B L' (y i)
  have hy_mem : ∀ i : Fin 2, y i ∈ 𝔪_B.asIdeal := fun i => hq_le (hMem_qB i)
  have hx_mem : ∀ i : Fin 2, x i ∈ 𝔪' := by
    intro i
    have h_comap : Ideal.comap (algebraMap B L') 𝔪' = 𝔪_B.asIdeal :=
      Localization.AtPrime.under_maximalIdeal
    have hi := hy_mem i
    rw [← h_comap] at hi
    exact hi

  
  have hx_mul : x 0 * x 1 = 0 := by
    change algebraMap B L' (φ_node (Xbar 0)) * algebraMap B L' (φ_node (Xbar 1)) = 0
    rw [← map_mul, ← map_mul]
    have hX01 : Xbar 0 * Xbar 1 = 0 := by
      change Ideal.Quotient.mk I_node (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
    rw [hX01, map_zero, map_zero]

  have hR_node_inf : (Ideal.span {Xbar 0} : Ideal R_node) ⊓ Ideal.span {Xbar 1} = ⊥ := by
    rw [eq_bot_iff]
    intro r hr
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective r
    let π₀ : P₂ →ₐ[Ω] P₂ :=
      MvPolynomial.aeval (fun i : Fin 2 => if i = 0 then (0 : P₂) else MvPolynomial.X i)
    have hπ₀_X0 : π₀ (MvPolynomial.X 0) = 0 := by
      dsimp [π₀]
      rw [MvPolynomial.aeval_X, ite_cond_eq_true _ _ (eq_true rfl)]
    have hπ₀_X1 : π₀ (MvPolynomial.X 1) = MvPolynomial.X 1 := by
      dsimp [π₀]
      rw [MvPolynomial.aeval_X, ite_cond_eq_false _ _ (eq_false (by decide : (1 : Fin 2) ≠ 0))]
    have h_sub_X0 : ∀ g : P₂, g - π₀ g ∈ Ideal.span ({MvPolynomial.X 0} : Set P₂) := by
      let q₀ : P₂ →ₐ[Ω] (P₂ ⧸ Ideal.span ({MvPolynomial.X 0} : Set P₂)) :=
        Ideal.Quotient.mkₐ Ω (Ideal.span ({MvPolynomial.X 0} : Set P₂))
      have hq₀_eq : q₀.comp π₀ = q₀ := by
        apply MvPolynomial.algHom_ext
        intro i
        fin_cases i
        · change q₀ (π₀ (MvPolynomial.X 0)) = q₀ (MvPolynomial.X 0)
          rw [hπ₀_X0, map_zero]
          symm
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
        · change q₀ (π₀ (MvPolynomial.X 1)) = q₀ (MvPolynomial.X 1)
          rw [hπ₀_X1]
      intro g
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change q₀ (g - π₀ g) = 0
      rw [map_sub, ← AlgHom.comp_apply, hq₀_eq, sub_self]
    obtain ⟨s₀, hs₀⟩ := Ideal.mem_span_singleton.mp hr.1
    obtain ⟨a₀, rfl⟩ := Ideal.Quotient.mk_surjective s₀
    have hp₀_mem : p - MvPolynomial.X 0 * a₀ ∈ I_node :=
      Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_sub, map_mul, ← hs₀, sub_self])
    obtain ⟨b₀, hb₀⟩ := Ideal.mem_span_singleton.mp hp₀_mem
    have hp_X0 : p = MvPolynomial.X 0 * (a₀ + MvPolynomial.X 1 * b₀) := by
      linear_combination hb₀
    have hπ₀_p : π₀ p = 0 := by
      rw [hp_X0, map_mul, hπ₀_X0, zero_mul]
    obtain ⟨s₁, hs₁⟩ := Ideal.mem_span_singleton.mp hr.2
    obtain ⟨a₁, rfl⟩ := Ideal.Quotient.mk_surjective s₁
    have hp₁_mem : p - MvPolynomial.X 1 * a₁ ∈ I_node :=
      Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_sub, map_mul, ← hs₁, sub_self])
    obtain ⟨b₁, hb₁⟩ := Ideal.mem_span_singleton.mp hp₁_mem
    let g₁ : P₂ := a₁ + MvPolynomial.X 0 * b₁
    have hp_X1 : p = MvPolynomial.X 1 * g₁ := by
      dsimp [g₁]
      linear_combination hb₁
    have h_mul_zero : MvPolynomial.X (1 : Fin 2) * π₀ g₁ = 0 := by
      rw [← hπ₀_X1, ← map_mul, ← hp_X1, hπ₀_p]
    have hX1_ne : (MvPolynomial.X (1 : Fin 2) : P₂) ≠ 0 := MvPolynomial.X_ne_zero 1
    have hπ₀_g1 : π₀ g₁ = 0 := (mul_eq_zero.mp h_mul_zero).resolve_left hX1_ne
    have hg1_mem : g₁ ∈ Ideal.span ({MvPolynomial.X 0} : Set P₂) := by
      have h := h_sub_X0 g₁
      rwa [hπ₀_g1, sub_zero] at h
    obtain ⟨h, hh⟩ := Ideal.mem_span_singleton.mp hg1_mem
    rw [Submodule.mem_bot, Ideal.Quotient.eq_zero_iff_mem]
    refine Ideal.mem_span_singleton.mpr ⟨h, ?_⟩
    rw [hp_X1, hh]
    ring

  have hx_inf : (Ideal.span {x 0} : Ideal L') ⊓ Ideal.span {x 1} = ⊥ := by
    letI : Algebra R_node B := φ_node.toAlgebra
    have : Algebra.Etale R_node B := hEt.toAlgebra
    have : Module.Flat R_node L' := Module.Flat.trans R_node B L'
    let J₀ : Ideal R_node := Ideal.span {Xbar 0}
    let J₁ : Ideal R_node := Ideal.span {Xbar 1}
    let g_lin : ↥J₀ →ₗ[R_node] (R_node ⧸ J₁) := (Submodule.mkQ J₁).comp J₀.subtype
    have hg_inj : Function.Injective g_lin := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      have ha1 : a.1 ∈ J₁ := Ideal.Quotient.eq_zero_iff_mem.mp ha
      have ha_bot : a.1 ∈ (⊥ : Ideal R_node) := by
        rw [← hR_node_inf]
        exact ⟨a.2, ha1⟩
      exact Subtype.ext ((Submodule.mem_bot R_node).mp ha_bot)
    have hg_tens_inj : Function.Injective (LinearMap.lTensor L' g_lin) :=
      Module.Flat.lTensor_preserves_injective_linearMap g_lin hg_inj
    rw [eq_bot_iff]
    intro w hw
    obtain ⟨u₀, hu₀⟩ := Ideal.mem_span_singleton.mp hw.1
    obtain ⟨u₁, hu₁⟩ := Ideal.mem_span_singleton.mp hw.2
    let j₀ : ↥J₀ := ⟨Xbar 0, Ideal.subset_span (Set.mem_singleton _)⟩
    have hw0 : LinearMap.lTensor L' J₀.subtype (u₀ ⊗ₜ[R_node] j₀) =
        w ⊗ₜ[R_node] (1 : R_node) := by
      rw [LinearMap.lTensor_tmul]
      change u₀ ⊗ₜ[R_node] (Xbar 0) = w ⊗ₜ[R_node] 1
      have h_tmul0 := TensorProduct.smul_tmul (R := R_node) (Xbar 0) u₀ (1 : R_node)
      rw [smul_eq_mul, mul_one] at h_tmul0
      conv at h_tmul0 =>
        lhs
        rw [← one_smul B u₀, ← smul_assoc, Algebra.smul_def, Algebra.smul_def, mul_one]
      change (x 0 * u₀) ⊗ₜ[R_node] 1 = u₀ ⊗ₜ[R_node] (Xbar 0) at h_tmul0
      rw [← hu₀] at h_tmul0
      exact h_tmul0.symm
    have hw1 : w ⊗ₜ[R_node] (1 : R_node) = u₁ ⊗ₜ[R_node] (Xbar 1) := by
      have h_tmul1 := TensorProduct.smul_tmul (R := R_node) (Xbar 1) u₁ (1 : R_node)
      rw [smul_eq_mul, mul_one] at h_tmul1
      conv at h_tmul1 =>
        lhs
        rw [← one_smul B u₁, ← smul_assoc, Algebra.smul_def, Algebra.smul_def, mul_one]
      change (x 1 * u₁) ⊗ₜ[R_node] 1 = u₁ ⊗ₜ[R_node] (Xbar 1) at h_tmul1
      rw [← hu₁] at h_tmul1
      exact h_tmul1
    have hgz : LinearMap.lTensor L' g_lin (u₀ ⊗ₜ[R_node] j₀) = 0 := by
      rw [LinearMap.lTensor_comp, LinearMap.comp_apply, hw0, hw1, LinearMap.lTensor_tmul]
      have hmk1 : Submodule.mkQ J₁ (Xbar 1) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
      rw [hmk1, TensorProduct.tmul_zero]
    have hz0 : u₀ ⊗ₜ[R_node] j₀ = 0 := hg_tens_inj (hgz.trans (map_zero _).symm)
    have hw_t0 : w ⊗ₜ[R_node] (1 : R_node) = 0 := by
      rw [← hw0, hz0, map_zero]
    rw [Submodule.mem_bot]
    have h_rid := congrArg (TensorProduct.rid R_node L') hw_t0
    simpa [TensorProduct.rid_tmul] using h_rid

  
  have hFT_B : Algebra.FiniteType Ω B := by
    letI : Algebra R_node B := φ_node.toAlgebra
    have : Algebra.Etale R_node B := hEt.toAlgebra
    have : IsScalarTower Ω R_node B :=
      ⟨fun c r b => by
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective r
        rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def]
        change φ_node (Ideal.Quotient.mk I_node (c • p)) * b =
          algebraMap Ω B c * (φ_node (Ideal.Quotient.mk I_node p) * b)
        rw [Algebra.smul_def, map_mul, map_mul, mul_assoc]
        change φ_node (Ideal.Quotient.mk I_node (MvPolynomial.C c)) *
            (φ_node (Ideal.Quotient.mk I_node p) * b) =
          algebraMap Ω B c * (φ_node (Ideal.Quotient.mk I_node p) * b)
        rw [← hAlg c]⟩
    have hFT_R : Algebra.FiniteType Ω R_node :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ Ω I_node) Ideal.Quotient.mk_surjective
    exact Algebra.FiniteType.trans hFT_R inferInstance
  have : Algebra.FiniteType Ω B := hFT_B
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing Ω B
  have : IsNoetherianRing L' :=
    IsLocalization.isNoetherianRing 𝔪_B.asIdeal.primeCompl L' inferInstance

  have h_exists_ev : ∃ ev_B : B →ₐ[Ω] Ω, RingHom.ker ev_B.toRingHom = 𝔪_B.asIdeal := by
    obtain ⟨s, hs⟩ := hFT_B.out
    let S : Set B := ↑s
    have : Finite ↥S := s.finite_toSet
    let Φ : MvPolynomial ↥S Ω →ₐ[Ω] B := MvPolynomial.aeval Subtype.val
    have hΦ_surj : Function.Surjective Φ := by
      intro b
      rw [← AlgHom.mem_range, ← Algebra.adjoin_eq_range, hs]
      trivial
    have h_comap_max : (Ideal.comap Φ.toRingHom 𝔪_B.asIdeal).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective Φ.toRingHom hΦ_surj
    obtain ⟨z, hz⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp h_comap_max
    have h_ker_le : RingHom.ker Φ.toRingHom ≤ RingHom.ker (MvPolynomial.aeval z).toRingHom := by
      intro p hp
      have hp_mem : p ∈ Ideal.comap Φ.toRingHom 𝔪_B.asIdeal := by
        change Φ p ∈ 𝔪_B.asIdeal
        rw [show Φ p = 0 from hp]
        exact 𝔪_B.asIdeal.zero_mem
      rw [hz, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hp_mem
      exact hp_mem
    let e_quot : (MvPolynomial ↥S Ω ⧸ RingHom.ker Φ.toRingHom) ≃ₐ[Ω] B :=
      Ideal.quotientKerAlgEquivOfSurjective hΦ_surj
    let ev_quot : (MvPolynomial ↥S Ω ⧸ RingHom.ker Φ.toRingHom) →ₐ[Ω] Ω :=
      Ideal.Quotient.liftₐ (RingHom.ker Φ.toRingHom) (MvPolynomial.aeval z) h_ker_le
    let ev_B : B →ₐ[Ω] Ω := ev_quot.comp e_quot.symm.toAlgHom
    refine ⟨ev_B, ?_⟩
    ext b
    obtain ⟨p, rfl⟩ := hΦ_surj b
    have heq_p : e_quot.symm (Φ p) = Ideal.Quotient.mk (RingHom.ker Φ.toRingHom) p := by
      apply e_quot.injective
      rw [AlgEquiv.apply_symm_apply]
      rfl
    change ev_quot (e_quot.symm (Φ p)) = 0 ↔ Φ p ∈ 𝔪_B.asIdeal
    rw [heq_p]
    change (MvPolynomial.aeval z) p = 0 ↔ p ∈ Ideal.comap Φ.toRingHom 𝔪_B.asIdeal
    rw [hz, MvPolynomial.mem_vanishingIdeal_singleton_iff]
  obtain ⟨ev_B, hev_ker⟩ := h_exists_ev

  
  have hBranch : ∀ i : Fin 2,
      (Ideal.span {x i} : Ideal L').IsPrime ∧
      Module.finrank Ω (L' ⧸ (Ideal.span {x i} ⊔ 𝔪' ^ 2)) = 2 := by
    intro i
    let j : Fin 2 := Equiv.swap (0 : Fin 2) 1 i
    have hji : j ≠ i := by fin_cases i <;> decide
    let J_i : Ideal R_node := Ideal.span {Xbar i}
    let R_i := R_node ⧸ J_i
    let B_i := B ⧸ Ideal.span {y i}
    let P₁ := Polynomial Ω

    
    let f_poly : P₁ →ₐ[Ω] R_i :=
      Polynomial.aeval (Ideal.Quotient.mk J_i (Xbar j))
    let g₀ : P₂ →ₐ[Ω] P₁ :=
      MvPolynomial.aeval (fun k : Fin 2 => if k = i then (0 : P₁) else Polynomial.X)
    have hg₀_node : I_node ≤ RingHom.ker g₀.toRingHom := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      change g₀ (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      rw [map_mul]
      dsimp [g₀]
      rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      fin_cases i
      · have h0 : (0 : Fin 2) = ⟨0, by omega⟩ := rfl
        rw [ite_cond_eq_true _ _ (eq_true h0), zero_mul]
      · have h1 : (1 : Fin 2) = ⟨1, by omega⟩ := rfl
        rw [ite_cond_eq_true _ _ (eq_true h1), mul_zero]
    let g₁ : R_node →ₐ[Ω] P₁ := Ideal.Quotient.liftₐ I_node g₀ hg₀_node
    have hg₁_Ji : J_i ≤ RingHom.ker g₁.toRingHom := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      change g₀ (MvPolynomial.X i) = 0
      dsimp [g₀]
      rw [MvPolynomial.aeval_X, ite_cond_eq_true _ _ (eq_true rfl)]
    let g_poly : R_i →ₐ[Ω] P₁ := Ideal.Quotient.liftₐ J_i g₁ hg₁_Ji
    have h_gf : g_poly.comp f_poly = AlgHom.id Ω P₁ := by
      apply Polynomial.algHom_ext
      simp only [AlgHom.comp_apply, f_poly, Polynomial.aeval_X]
      change g₀ (MvPolynomial.X j) = Polynomial.X
      dsimp [g₀]
      rw [MvPolynomial.aeval_X, ite_cond_eq_false _ _ (eq_false hji)]
    have h_fg : f_poly.comp g_poly = AlgHom.id Ω R_i := by
      have h_fg_0 :
          ((f_poly.comp g_poly).comp (Ideal.Quotient.mkₐ Ω J_i)).comp
            (Ideal.Quotient.mkₐ Ω I_node) =
            (Ideal.Quotient.mkₐ Ω J_i).comp (Ideal.Quotient.mkₐ Ω I_node) := by
        apply MvPolynomial.algHom_ext
        intro k
        by_cases hk : k = i
        · subst hk
          change f_poly (g₀ (MvPolynomial.X k)) = Ideal.Quotient.mk J_i (Xbar k)
          dsimp [g₀]
          rw [MvPolynomial.aeval_X, ite_cond_eq_true _ _ (eq_true rfl), map_zero]
          symm
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
        · have hkj : k = j := by
            fin_cases i <;> fin_cases k <;> first | exact absurd rfl hk | rfl
          change f_poly (g₀ (MvPolynomial.X k)) = Ideal.Quotient.mk J_i (Xbar k)
          dsimp [g₀, f_poly]
          rw [MvPolynomial.aeval_X, ite_cond_eq_false _ _ (eq_false hk), Polynomial.aeval_X, hkj]
      ext z
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective r
      exact AlgHom.congr_fun h_fg_0 p
    let e_poly : P₁ ≃ₐ[Ω] R_i := AlgEquiv.ofAlgHom f_poly g_poly h_fg h_gf

    
    let φ_quot : R_i →+* B_i :=
      Ideal.Quotient.lift J_i ((Ideal.Quotient.mk (Ideal.span {y i})).comp φ_node) (by
        intro r hr
        obtain ⟨s, rfl⟩ := Ideal.mem_span_singleton.mp hr
        simp only [RingHom.comp_apply, map_mul]
        have hy0 : Ideal.Quotient.mk (Ideal.span {y i}) (φ_node (Xbar i)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
        rw [hy0, zero_mul])
    let ψ_i : P₁ →+* B_i := φ_quot.comp f_poly.toRingHom
    have hψ_alg : ∀ c : Ω, algebraMap Ω B_i c = ψ_i (algebraMap Ω P₁ c) := by
      intro c
      have hec : f_poly (algebraMap Ω P₁ c) = algebraMap Ω R_i c := f_poly.commutes c
      dsimp [ψ_i]
      rw [hec]
      change Ideal.Quotient.mk (Ideal.span {y i}) (algebraMap Ω B c) =
        φ_quot (Ideal.Quotient.mk J_i (Ideal.Quotient.mk I_node (MvPolynomial.C c)))
      change Ideal.Quotient.mk (Ideal.span {y i}) (algebraMap Ω B c) =
        Ideal.Quotient.mk (Ideal.span {y i}) (φ_node (Ideal.Quotient.mk I_node (MvPolynomial.C c)))
      rw [hAlg c]

    letI : Algebra P₁ B_i := ψ_i.toAlgebra
    have : IsScalarTower Ω P₁ B_i :=
      ⟨fun c p b => by
        rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def,
          map_mul, mul_assoc, hψ_alg c]
        rfl⟩
    have hEt_P1_Bi : Algebra.Etale P₁ B_i := by
      letI : Algebra R_node B := φ_node.toAlgebra
      have : Algebra.Etale R_node B := hEt.toAlgebra
      letI : Algebra R_node P₁ := g₁.toRingHom.toAlgebra
      let f_left : P₁ →ₐ[R_node] B_i :=
        { toRingHom := ψ_i
          commutes' := fun r => by
            have hfg_r : f_poly (g_poly (Ideal.Quotient.mk J_i r)) = Ideal.Quotient.mk J_i r :=
              AlgHom.congr_fun h_fg (Ideal.Quotient.mk J_i r)
            change φ_quot (f_poly (g_poly (Ideal.Quotient.mk J_i r))) =
              Ideal.Quotient.mk (Ideal.span {y i}) (φ_node r)
            rw [hfg_r]
            rfl }
      let f_right : B →ₐ[R_node] B_i := Ideal.Quotient.mkₐ R_node (Ideal.span {y i})
      let F_alg : TensorProduct R_node P₁ B →ₐ[R_node] B_i :=
        Algebra.TensorProduct.productMap f_left f_right
      let inc_right : B →ₐ[R_node] TensorProduct R_node P₁ B :=
        Algebra.TensorProduct.includeRight
      have h_yi_inc :
          Ideal.span ({y i} : Set B) ≤ RingHom.ker inc_right.toRingHom := by
        rw [Ideal.span_le, Set.singleton_subset_iff]
        change (1 : P₁) ⊗ₜ[R_node] (y i) = 0
        have h_tm := (TensorProduct.smul_tmul (R := R_node) (Xbar i) (1 : P₁) (1 : B)).symm
        change (1 : P₁) ⊗ₜ[R_node] (φ_node (Xbar i) * 1) =
          (g₁ (Xbar i) * 1) ⊗ₜ[R_node] (1 : B) at h_tm
        have h0 : g₁ (Xbar i) = 0 := hg₁_Ji (Ideal.subset_span (Set.mem_singleton _))
        rw [mul_one, h0, zero_mul, TensorProduct.zero_tmul] at h_tm
        exact h_tm
      let G_alg : B_i →ₐ[R_node] TensorProduct R_node P₁ B :=
        Ideal.Quotient.liftₐ (Ideal.span {y i}) inc_right h_yi_inc
      have h_FG : F_alg.comp G_alg = AlgHom.id R_node B_i := by
        ext z
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
        change F_alg ((1 : P₁) ⊗ₜ[R_node] b) = Ideal.Quotient.mk (Ideal.span {y i}) b
        exact Algebra.TensorProduct.productMap_right_apply f_left f_right b
      have h_GF : G_alg.comp F_alg = AlgHom.id R_node (TensorProduct R_node P₁ B) := by
        apply AlgHom.toLinearMap_injective
        apply TensorProduct.ext'
        intro p b
        change G_alg (F_alg (p ⊗ₜ[R_node] b)) = p ⊗ₜ[R_node] b
        obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (f_poly p)
        have hg1_r : g₁ r = p := by
          change g_poly (Ideal.Quotient.mk J_i r) = p
          rw [hr]
          exact AlgHom.congr_fun h_gf p
        have hψ_p : ψ_i p = Ideal.Quotient.mk (Ideal.span {y i}) (φ_node r) := by
          change φ_quot (f_poly p) = _
          rw [← hr]
          rfl
        have hF_pb : F_alg (p ⊗ₜ[R_node] b) = Ideal.Quotient.mk (Ideal.span {y i}) (φ_node r * b) := by
          rw [Algebra.TensorProduct.productMap_apply_tmul]
          change ψ_i p * Ideal.Quotient.mk (Ideal.span {y i}) b = _
          rw [hψ_p, ← map_mul]
        rw [hF_pb]
        change (1 : P₁) ⊗ₜ[R_node] (φ_node r * b) = p ⊗ₜ[R_node] b
        have h_tm := (TensorProduct.smul_tmul (R := R_node) r (1 : P₁) b).symm
        change (1 : P₁) ⊗ₜ[R_node] (φ_node r * b) = (g₁ r * 1) ⊗ₜ[R_node] b at h_tm
        rw [mul_one, hg1_r] at h_tm
        exact h_tm
      let e_Rnode_Bi : TensorProduct R_node P₁ B ≃ₐ[R_node] B_i :=
        AlgEquiv.ofAlgHom F_alg G_alg h_FG h_GF
      let e_P1_Bi : TensorProduct R_node P₁ B ≃ₐ[P₁] B_i :=
        AlgEquiv.ofRingEquiv (f := e_Rnode_Bi.toRingEquiv) (by
          intro p
          change F_alg (p ⊗ₜ[R_node] (1 : B)) = ψ_i p
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
          rfl)
      exact Algebra.Etale.of_equiv e_P1_Bi
    have : Algebra.Etale P₁ B_i := hEt_P1_Bi

    
    have hRed_Bi : _root_.IsReduced B_i := by
      let K₁ := FractionRing P₁
      have hRed_tens : _root_.IsReduced (TensorProduct P₁ K₁ B_i) :=
        Algebra.FormallyUnramified.isReduced_of_field K₁ (TensorProduct P₁ K₁ B_i)
      have h_inj_K1 : Function.Injective (Algebra.linearMap P₁ K₁) :=
        IsFractionRing.injective P₁ K₁
      have h_rtens_inj : Function.Injective (LinearMap.rTensor B_i (Algebra.linearMap P₁ K₁)) :=
        Module.Flat.rTensor_preserves_injective_linearMap (Algebra.linearMap P₁ K₁) h_inj_K1
      let ι_K1 : B_i →+* TensorProduct P₁ K₁ B_i := Algebra.TensorProduct.includeRight.toRingHom
      have hι_inj : Function.Injective ι_K1 := by
        intro b₁ b₂ hb
        have h1 :
            LinearMap.rTensor B_i (Algebra.linearMap P₁ K₁) ((1 : P₁) ⊗ₜ[P₁] b₁) =
              LinearMap.rTensor B_i (Algebra.linearMap P₁ K₁) ((1 : P₁) ⊗ₜ[P₁] b₂) := by
          simpa [LinearMap.rTensor_tmul, ι_K1] using hb
        have h2 := congrArg (TensorProduct.lid P₁ B_i) (h_rtens_inj h1)
        simpa using h2
      refine ⟨fun b ⟨n, hbn⟩ => ?_⟩
      have hι_pow : (ι_K1 b) ^ n = 0 := by rw [← map_pow, hbn, map_zero]
      have hι0 : ι_K1 b = 0 := @eq_zero_of_pow_eq_zero _ _ _ _ hRed_tens n hι_pow
      exact hι_inj (hι0.trans (map_zero ι_K1).symm)

    have hRed_Li : _root_.IsReduced (L' ⧸ Ideal.span {x i}) := by
      refine ⟨fun z ⟨n, hzn⟩ => ?_⟩
      have hzn1 : z ^ (n + 1) = 0 := by rw [pow_succ, hzn, zero_mul]
      obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj 𝔪_B.asIdeal.primeCompl u
      dsimp only at hbs
      have hb_pow_mem : algebraMap B L' (b ^ (n + 1)) ∈ Ideal.span {x i} := by
        rw [map_pow, ← hbs, mul_pow, ← Ideal.Quotient.eq_zero_iff_mem, map_mul, map_pow, hzn1,
          zero_mul]
      obtain ⟨v, hv⟩ := Ideal.mem_span_singleton.mp hb_pow_mem
      obtain ⟨⟨c, t⟩, hct⟩ := IsLocalization.surj 𝔪_B.asIdeal.primeCompl v
      dsimp only at hct
      have h_loc_eq :
          algebraMap B L' (b ^ (n + 1) * t.1) = algebraMap B L' (y i * c) := by
        calc
          algebraMap B L' (b ^ (n + 1) * t.1)
            = algebraMap B L' (b ^ (n + 1)) * algebraMap B L' t.1 := map_mul _ _ _
          _ = (x i * v) * algebraMap B L' t.1 := by rw [hv]
          _ = algebraMap B L' (y i) * (v * algebraMap B L' t.1) := by dsimp [x]; ring
          _ = algebraMap B L' (y i) * algebraMap B L' c := by rw [hct]
          _ = algebraMap B L' (y i * c) := (map_mul _ _ _).symm
      obtain ⟨w, hw⟩ := (IsLocalization.eq_iff_exists 𝔪_B.asIdeal.primeCompl L').mp h_loc_eq
      have h_wtb_pow :
          (w.1 * t.1 * b) ^ (n + 1) ∈ Ideal.span ({y i} : Set B) := by
        refine Ideal.mem_span_singleton.mpr ⟨w.1 ^ (n + 1) * t.1 ^ n * c, ?_⟩
        calc
          (w.1 * t.1 * b) ^ (n + 1)
            = w.1 ^ n * t.1 ^ n * (w.1 * (b ^ (n + 1) * t.1)) := by ring
          _ = w.1 ^ n * t.1 ^ n * (w.1 * (y i * c)) := by rw [hw]
          _ = y i * (w.1 ^ (n + 1) * t.1 ^ n * c) := by ring
      have h_mk_pow :
          (Ideal.Quotient.mk (Ideal.span ({y i} : Set B)) (w.1 * t.1 * b)) ^ (n + 1) = 0 := by
        rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
        exact h_wtb_pow
      have h_mk_zero :
          Ideal.Quotient.mk (Ideal.span ({y i} : Set B)) (w.1 * t.1 * b) = 0 :=
        @eq_zero_of_pow_eq_zero _ _ _ _ hRed_Bi (n + 1) h_mk_pow
      obtain ⟨d, hd⟩ :=
        Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h_mk_zero)
      let swt : 𝔪_B.asIdeal.primeCompl := s * w * t
      have hu_swt : u * algebraMap B L' swt.1 = x i * algebraMap B L' d := by
        calc
          u * algebraMap B L' swt.1
            = (u * algebraMap B L' s.1) * algebraMap B L' (w.1 * t.1) := by
                simp only [swt, Submonoid.coe_mul, map_mul]
                ring
          _ = algebraMap B L' (w.1 * t.1 * b) := by
                rw [hbs, ← map_mul]
                congr 1
                ring
          _ = algebraMap B L' (y i * d) := by rw [hd]
          _ = x i * algebraMap B L' d := by rw [map_mul]
      obtain ⟨u_unit, hu_unit⟩ := IsLocalization.map_units L' swt
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
      refine ⟨algebraMap B L' d * ↑u_unit⁻¹, ?_⟩
      calc
        u = (u * (u_unit : L')) * ↑u_unit⁻¹ := by simp
        _ = (u * algebraMap B L' swt.1) * ↑u_unit⁻¹ := by rw [hu_unit]
        _ = x i * (algebraMap B L' d * ↑u_unit⁻¹) := by rw [hu_swt]; ring

    
    have hyi_ker : Ideal.span ({y i} : Set B) ≤ RingHom.ker ev_B.toRingHom := by
      rw [Ideal.span_le, Set.singleton_subset_iff, hev_ker]
      exact hy_mem i
    let f_i : B_i →ₐ[Ω] Ω := Ideal.Quotient.liftₐ (Ideal.span {y i}) ev_B hyi_ker
    let mbar_B : Ideal B_i := Ideal.map (Ideal.Quotient.mkₐ Ω (Ideal.span {y i})) 𝔪_B.asIdeal
    have hf_i_ker : RingHom.ker f_i.toRingHom = mbar_B := by
      ext z
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
      change ev_B b = 0 ↔ Ideal.Quotient.mk (Ideal.span {y i}) b ∈
        Ideal.map (Ideal.Quotient.mk (Ideal.span {y i})) 𝔪_B.asIdeal
      have h2 : ev_B b = 0 ↔ b ∈ 𝔪_B.asIdeal := by
        rw [← hev_ker]
        rfl
      rw [h2, Ideal.mem_quotient_iff_mem_sup,
        sup_eq_left.mpr (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (hy_mem i)))]
    have hψ_X_mem : ψ_i Polynomial.X ∈ mbar_B := by
      have hψ_X : ψ_i Polynomial.X = Ideal.Quotient.mk (Ideal.span {y i}) (y j) := by
        change φ_quot (f_poly Polynomial.X) = _
        dsimp [f_poly]
        rw [Polynomial.aeval_X]
        rfl
      rw [hψ_X]
      exact Ideal.mem_map_of_mem _ (hy_mem j)
    let ev₀ : P₁ →ₐ[Ω] Ω := Polynomial.aeval (0 : Ω)
    have hf_comp_ψ : ∀ p : P₁, f_i (ψ_i p) = ev₀ p := by
      let ψ_alg : P₁ →ₐ[Ω] B_i :=
        { toRingHom := ψ_i
          commutes' := fun c => (hψ_alg c).symm }
      have h_eq : f_i.comp ψ_alg = ev₀ := by
        apply Polynomial.algHom_ext
        change f_i (ψ_i Polynomial.X) = ev₀ Polynomial.X
        have h0 : f_i (ψ_i Polynomial.X) = 0 := by
          change f_i.toRingHom (ψ_i Polynomial.X) = 0
          rw [← RingHom.mem_ker, hf_i_ker]
          exact hψ_X_mem
        rw [h0]
        dsimp [ev₀]
        rw [Polynomial.aeval_X]
      intro p
      exact AlgHom.congr_fun h_eq p

    let I₁ : Ideal P₁ := Ideal.span ({Polynomial.X} : Set P₁)
    let Q₁ := P₁ ⧸ I₁ ^ 2
    let Q₂ := B_i ⧸ mbar_B ^ 2
    have hI₁_sq : I₁ ^ 2 = Ideal.span ({Polynomial.X ^ 2} : Set P₁) :=
      Ideal.span_singleton_pow Polynomial.X 2

    have hQ₁_equiv_Q₂ : Nonempty (Q₁ ≃ₐ[Ω] Q₂) := by
      letI : Algebra P₁ Ω := ev₀.toRingHom.toAlgebra
      let f_P₁ : B_i →ₐ[P₁] Ω :=
        { toRingHom := f_i.toRingHom
          commutes' := hf_comp_ψ }
      have hI1_ker_Q2 : I₁ ^ 2 ≤ RingHom.ker (algebraMap P₁ Q₂) := by
        rw [hI₁_sq, Ideal.span_le, Set.singleton_subset_iff]
        change Ideal.Quotient.mk (mbar_B ^ 2) (ψ_i (Polynomial.X ^ 2)) = 0
        rw [map_pow, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.pow_mem_pow hψ_X_mem 2
      let α : Q₁ →ₐ[P₁] Q₂ := Ideal.Quotient.liftₐ (I₁ ^ 2) (Algebra.ofId P₁ Q₂) hI1_ker_Q2
      have hI1_ker_Ω : I₁ ^ 2 ≤ RingHom.ker (algebraMap P₁ Ω) := by
        rw [hI₁_sq, Ideal.span_le, Set.singleton_subset_iff]
        change ev₀ (Polynomial.X ^ 2) = 0
        dsimp [ev₀]
        rw [map_pow, Polynomial.aeval_X, sq, zero_mul]
      let g_P₁ : Q₁ →ₐ[P₁] Ω := Ideal.Quotient.liftₐ (I₁ ^ 2) (Algebra.ofId P₁ Ω) hI1_ker_Ω
      have hg_surj : Function.Surjective g_P₁ := by
        intro c
        refine ⟨Ideal.Quotient.mk (I₁ ^ 2) (Polynomial.C c), ?_⟩
        change ev₀ (Polynomial.C c) = c
        dsimp [ev₀]
        rw [Polynomial.aeval_C]
        rfl
      have hg_ker_mul : ∀ a b : Q₁, a ∈ RingHom.ker (g_P₁ : Q₁ →+* Ω) →
          b ∈ RingHom.ker (g_P₁ : Q₁ →+* Ω) → a * b = 0 := by
        intro a b ha hb
        obtain ⟨pa, rfl⟩ := Ideal.Quotient.mk_surjective a
        obtain ⟨pb, rfl⟩ := Ideal.Quotient.mk_surjective b
        have hpa : Polynomial.IsRoot pa 0 := by
          have ha' : (Polynomial.aeval (0 : Ω)) pa = 0 := ha
          rw [Polynomial.aeval_def] at ha'
          exact ha'
        have hpb : Polynomial.IsRoot pb 0 := by
          have hb' : (Polynomial.aeval (0 : Ω)) pb = 0 := hb
          rw [Polynomial.aeval_def] at hb'
          exact hb'
        obtain ⟨qa, hqa⟩ := Polynomial.dvd_iff_isRoot.mpr hpa
        obtain ⟨qb, hqb⟩ := Polynomial.dvd_iff_isRoot.mpr hpb
        rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, hI₁_sq, Ideal.mem_span_singleton]
        refine ⟨qa * qb, ?_⟩
        rw [hqa, hqb, map_zero]
        ring
      have hg_nil : IsNilpotent (RingHom.ker (g_P₁ : Q₁ →+* Ω)) := by
        refine ⟨2, ?_⟩
        rw [Ideal.zero_eq_bot, eq_bot_iff, sq (RingHom.ker (g_P₁ : Q₁ →+* Ω)), Ideal.mul_le]
        intro a ha b hb
        rw [Submodule.mem_bot]
        exact hg_ker_mul a b ha hb
      let β₀ : B_i →ₐ[P₁] Q₁ :=
        Algebra.FormallySmooth.liftOfSurjective f_P₁ g_P₁ hg_surj hg_nil
      have h_g_β₀ : g_P₁.comp β₀ = f_P₁ :=
        Algebra.FormallySmooth.comp_liftOfSurjective f_P₁ g_P₁ hg_surj hg_nil
      have hmbar_ker_β₀ : mbar_B ^ 2 ≤ RingHom.ker β₀.toRingHom := by
        rw [pow_two, Ideal.mul_le]
        intro u hu v hv
        have hu_ker : β₀ u ∈ RingHom.ker (g_P₁ : Q₁ →+* Ω) := by
          change g_P₁ (β₀ u) = 0
          rw [← AlgHom.comp_apply, h_g_β₀]
          change f_i.toRingHom u = 0
          rw [← RingHom.mem_ker, hf_i_ker]
          exact hu
        have hv_ker : β₀ v ∈ RingHom.ker (g_P₁ : Q₁ →+* Ω) := by
          change g_P₁ (β₀ v) = 0
          rw [← AlgHom.comp_apply, h_g_β₀]
          change f_i.toRingHom v = 0
          rw [← RingHom.mem_ker, hf_i_ker]
          exact hv
        change β₀ (u * v) = 0
        rw [map_mul]
        exact hg_ker_mul (β₀ u) (β₀ v) hu_ker hv_ker
      let β : Q₂ →ₐ[P₁] Q₁ := Ideal.Quotient.liftₐ (mbar_B ^ 2) β₀ hmbar_ker_β₀
      have h_βα : β.comp α = AlgHom.id P₁ Q₁ := by
        ext z
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
        exact (β.comp α).commutes p
      have hmbar_ker_fP1 : mbar_B ^ 2 ≤ RingHom.ker f_P₁.toRingHom := by
        refine (Ideal.pow_le_self (by decide : 2 ≠ 0)).trans ?_
        change mbar_B ≤ RingHom.ker f_i.toRingHom
        rw [hf_i_ker]
      let h_Q₂ : Q₂ →ₐ[P₁] Ω := Ideal.Quotient.liftₐ (mbar_B ^ 2) f_P₁ hmbar_ker_fP1
      have hh_Q₂_nil : IsNilpotent (RingHom.ker h_Q₂.toRingHom) := by
        refine ⟨2, ?_⟩
        rw [Ideal.zero_eq_bot, eq_bot_iff, sq (RingHom.ker h_Q₂.toRingHom), Ideal.mul_le]
        intro a ha b hb
        obtain ⟨ua, rfl⟩ := Ideal.Quotient.mk_surjective a
        obtain ⟨ub, rfl⟩ := Ideal.Quotient.mk_surjective b
        have hua : ua ∈ mbar_B := by
          rw [← hf_i_ker]
          exact ha
        have hub : ub ∈ mbar_B := by
          rw [← hf_i_ker]
          exact hb
        rw [Submodule.mem_bot, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, pow_two]
        exact Ideal.mul_mem_mul hua hub
      have h_α_β₀ : α.comp β₀ = Ideal.Quotient.mkₐ P₁ (mbar_B ^ 2) := by
        apply Algebra.FormallyUnramified.ext' h_Q₂.toRingHom hh_Q₂_nil
        intro b
        have h_hQ2_α : h_Q₂.comp α = g_P₁ := by
          ext z
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
          exact (h_Q₂.comp α).commutes p
        change (h_Q₂.comp α) (β₀ b) = f_P₁ b
        rw [h_hQ2_α, ← AlgHom.comp_apply, h_g_β₀]
      have h_αβ : α.comp β = AlgHom.id P₁ Q₂ := by
        ext z
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
        exact AlgHom.congr_fun h_α_β₀ b
      let e_P1_jet : Q₁ ≃ₐ[P₁] Q₂ := AlgEquiv.ofAlgHom α β h_αβ h_βα
      exact ⟨e_P1_jet.restrictScalars Ω⟩
    obtain ⟨e_Q1_Q2⟩ := hQ₁_equiv_Q₂

    
    let J_B : Ideal B := Ideal.span {y i} ⊔ 𝔪_B.asIdeal ^ 2
    let J_L' : Ideal L' := Ideal.span {x i} ⊔ 𝔪' ^ 2
    have hmbar_pow2 :
        mbar_B ^ 2 = Ideal.map (Ideal.Quotient.mkₐ Ω (Ideal.span {y i})) (𝔪_B.asIdeal ^ 2) := by
      change (Ideal.map (Ideal.Quotient.mk (Ideal.span {y i})) 𝔪_B.asIdeal) ^ 2 =
        Ideal.map (Ideal.Quotient.mk (Ideal.span {y i})) (𝔪_B.asIdeal ^ 2)
      rw [Ideal.map_pow]
    let e_Q2_JB : Q₂ ≃ₐ[Ω] (B ⧸ J_B) :=
      (Ideal.quotientEquivAlg (mbar_B ^ 2)
        (Ideal.map (Ideal.Quotient.mkₐ Ω (Ideal.span {y i})) (𝔪_B.asIdeal ^ 2))
        (AlgEquiv.refl : B_i ≃ₐ[Ω] B_i) (by simpa using hmbar_pow2.symm)).trans
        (DoubleQuot.quotQuotEquivQuotSupₐ Ω (Ideal.span {y i}) (𝔪_B.asIdeal ^ 2))

    have hJB_ker_JL' :
        J_B ≤ RingHom.ker ((Ideal.Quotient.mkₐ Ω J_L').comp (IsScalarTower.toAlgHom Ω B L')).toRingHom := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        change Ideal.Quotient.mk J_L' (x i) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact Submodule.mem_sup_left (Ideal.subset_span (Set.mem_singleton _))
      · rw [pow_two, Ideal.mul_le]
        intro m₁ hm₁ m₂ hm₂
        change Ideal.Quotient.mk J_L' (algebraMap B L' (m₁ * m₂)) = 0
        rw [map_mul, Ideal.Quotient.eq_zero_iff_mem]
        have hm₁' : algebraMap B L' m₁ ∈ 𝔪' := by
          have hc : Ideal.comap (algebraMap B L') 𝔪' = 𝔪_B.asIdeal :=
            Localization.AtPrime.under_maximalIdeal
          rw [← hc] at hm₁
          exact hm₁
        have hm₂' : algebraMap B L' m₂ ∈ 𝔪' := by
          have hc : Ideal.comap (algebraMap B L') 𝔪' = 𝔪_B.asIdeal :=
            Localization.AtPrime.under_maximalIdeal
          rw [← hc] at hm₂
          exact hm₂
        exact Submodule.mem_sup_right (by rw [pow_two]; exact Ideal.mul_mem_mul hm₁' hm₂')
    let Φ_loc : (B ⧸ J_B) →ₐ[Ω] (L' ⧸ J_L') :=
      Ideal.Quotient.liftₐ J_B
        ((Ideal.Quotient.mkₐ Ω J_L').comp (IsScalarTower.toAlgHom Ω B L')) hJB_ker_JL'

    have h_units_JB : ∀ s : 𝔪_B.asIdeal.primeCompl, IsUnit (Ideal.Quotient.mk J_B s.1) := by
      intro s
      obtain ⟨a, m, hm, ha⟩ := hM_max.exists_inv s.2
      have hm_eq : m = 1 - a * s.1 := by linear_combination ha
      have hm2_zero : Ideal.Quotient.mk J_B (m ^ 2) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Submodule.mem_sup_right (Ideal.pow_mem_pow hm 2))
      have h_id : s.1 * (a * (2 - a * s.1)) + m ^ 2 = 1 := by
        rw [hm_eq]
        ring
      refine isUnit_iff_exists_inv.mpr ⟨Ideal.Quotient.mk J_B (a * (2 - a * s.1)), ?_⟩
      rw [← map_mul]
      calc
        Ideal.Quotient.mk J_B (s.1 * (a * (2 - a * s.1)))
          = Ideal.Quotient.mk J_B (s.1 * (a * (2 - a * s.1))) + Ideal.Quotient.mk J_B (m ^ 2) := by
              rw [hm2_zero, add_zero]
        _ = Ideal.Quotient.mk J_B (s.1 * (a * (2 - a * s.1)) + m ^ 2) := (map_add _ _ _).symm
        _ = 1 := by rw [h_id, map_one]
    let ψ_L' : L' →+* (B ⧸ J_B) := IsLocalization.lift (M := 𝔪_B.asIdeal.primeCompl) h_units_JB
    have hJL'_ker : J_L' ≤ RingHom.ker ψ_L' := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        change ψ_L' (algebraMap B L' (y i)) = 0
        rw [IsLocalization.lift_eq, Ideal.Quotient.eq_zero_iff_mem]
        exact Submodule.mem_sup_left (Ideal.subset_span (Set.mem_singleton _))
      · rw [pow_two, Ideal.mul_le]
        intro u₁ hu₁ u₂ hu₂
        obtain ⟨⟨b₁, s₁⟩, hbs₁⟩ := IsLocalization.surj 𝔪_B.asIdeal.primeCompl u₁
        obtain ⟨⟨b₂, s₂⟩, hbs₂⟩ := IsLocalization.surj 𝔪_B.asIdeal.primeCompl u₂
        dsimp only at hbs₁ hbs₂
        have hb₁_mem : b₁ ∈ 𝔪_B.asIdeal := by
          have hc : Ideal.comap (algebraMap B L') 𝔪' = 𝔪_B.asIdeal :=
            Localization.AtPrime.under_maximalIdeal
          rw [← hc]
          change algebraMap B L' b₁ ∈ 𝔪'
          rw [← hbs₁]
          exact Ideal.mul_mem_right _ _ hu₁
        have hb₂_mem : b₂ ∈ 𝔪_B.asIdeal := by
          have hc : Ideal.comap (algebraMap B L') 𝔪' = 𝔪_B.asIdeal :=
            Localization.AtPrime.under_maximalIdeal
          rw [← hc]
          change algebraMap B L' b₂ ∈ 𝔪'
          rw [← hbs₂]
          exact Ideal.mul_mem_right _ _ hu₂
        let s₁₂ : 𝔪_B.asIdeal.primeCompl := s₁ * s₂
        obtain ⟨w_u, hw_u⟩ := h_units_JB s₁₂
        have h_mul_w : ψ_L' (u₁ * u₂) * (w_u : B ⧸ J_B) = 0 := by
          rw [hw_u]
          calc
            ψ_L' (u₁ * u₂) * Ideal.Quotient.mk J_B s₁₂.1
              = ψ_L' (u₁ * u₂) * ψ_L' (algebraMap B L' s₁₂.1) := by
                  rw [IsLocalization.lift_eq]
            _ = ψ_L' ((u₁ * algebraMap B L' s₁.1) * (u₂ * algebraMap B L' s₂.1)) := by
                  rw [← map_mul]
                  congr 1
                  simp only [s₁₂, Submonoid.coe_mul, map_mul]
                  ring
            _ = ψ_L' (algebraMap B L' (b₁ * b₂)) := by rw [hbs₁, hbs₂, ← map_mul]
            _ = Ideal.Quotient.mk J_B (b₁ * b₂) := IsLocalization.lift_eq _ _
            _ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
                (Submodule.mem_sup_right (by rw [pow_two]; exact Ideal.mul_mem_mul hb₁_mem hb₂_mem))
        change ψ_L' (u₁ * u₂) = 0
        calc
          ψ_L' (u₁ * u₂) = (ψ_L' (u₁ * u₂) * (w_u : B ⧸ J_B)) * ↑w_u⁻¹ := by simp
          _ = 0 := by rw [h_mul_w, zero_mul]
    let Ψ_loc : (L' ⧸ J_L') →+* (B ⧸ J_B) := Ideal.Quotient.lift J_L' ψ_L' hJL'_ker
    have h_ΨΦ : ∀ z : B ⧸ J_B, Ψ_loc (Φ_loc z) = z := by
      intro z
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
      change ψ_L' (algebraMap B L' b) = Ideal.Quotient.mk J_B b
      exact IsLocalization.lift_eq h_units_JB b
    have h_ΦΨ : ∀ z : L' ⧸ J_L', Φ_loc (Ψ_loc z) = z := by
      intro z
      obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj 𝔪_B.asIdeal.primeCompl u
      dsimp only at hbs
      obtain ⟨v_u, hv_u⟩ := (IsLocalization.map_units L' s).map (Ideal.Quotient.mk J_L')
      have h_mul_eq :
          Φ_loc (Ψ_loc (Ideal.Quotient.mk J_L' u)) * (v_u : L' ⧸ J_L') =
            Ideal.Quotient.mk J_L' u * (v_u : L' ⧸ J_L') := by
        rw [hv_u]
        have hs_Φ : Φ_loc (Ideal.Quotient.mk J_B s.1) =
            Ideal.Quotient.mk J_L' (algebraMap B L' s.1) := rfl
        rw [← hs_Φ, ← map_mul]
        have h_arg :
            Ψ_loc (Ideal.Quotient.mk J_L' u) * Ideal.Quotient.mk J_B s.1 =
              Ideal.Quotient.mk J_B b := by
          calc
            ψ_L' u * Ideal.Quotient.mk J_B s.1
              = ψ_L' u * ψ_L' (algebraMap B L' s.1) := by rw [IsLocalization.lift_eq]
            _ = ψ_L' (u * algebraMap B L' s.1) := (map_mul _ _ _).symm
            _ = ψ_L' (algebraMap B L' b) := by rw [hbs]
            _ = Ideal.Quotient.mk J_B b := IsLocalization.lift_eq _ _
        rw [h_arg]
        change Ideal.Quotient.mk J_L' (algebraMap B L' b) = _
        rw [← hbs, map_mul]
        rfl
      calc
        Φ_loc (Ψ_loc (Ideal.Quotient.mk J_L' u))
          = (Φ_loc (Ψ_loc (Ideal.Quotient.mk J_L' u)) * (v_u : L' ⧸ J_L')) * ↑v_u⁻¹ := by simp
        _ = (Ideal.Quotient.mk J_L' u * (v_u : L' ⧸ J_L')) * ↑v_u⁻¹ := by rw [h_mul_eq]
        _ = Ideal.Quotient.mk J_L' u := by simp
    let e_JB_JL' : (B ⧸ J_B) ≃ₐ[Ω] (L' ⧸ J_L') :=
      AlgEquiv.ofBijective Φ_loc
        ⟨Function.LeftInverse.injective h_ΨΦ, Function.RightInverse.surjective h_ΦΨ⟩

    have hFin_Q1 : Module.finrank Ω Q₁ = 2 := by
      let e_adj : Q₁ ≃ₐ[Ω] AdjoinRoot (Polynomial.X ^ 2 : Polynomial Ω) :=
        Ideal.quotientEquivAlg (I₁ ^ 2) (Ideal.span ({Polynomial.X ^ 2} : Set P₁))
          (AlgEquiv.refl : P₁ ≃ₐ[Ω] P₁) (by simpa using hI₁_sq.symm)
      have hX2_ne : (Polynomial.X ^ 2 : Polynomial Ω) ≠ 0 :=
        pow_ne_zero 2 Polynomial.X_ne_zero
      let b_adj := AdjoinRoot.powerBasisAux hX2_ne
      have h_pb : Module.finrank Ω (AdjoinRoot (Polynomial.X ^ 2 : Polynomial Ω)) = 2 := by
        rw [Module.finrank_eq_card_basis b_adj, Fintype.card_fin, Polynomial.natDegree_X_pow]
      exact e_adj.toLinearEquiv.finrank_eq.trans h_pb
    have hFin_Li : Module.finrank Ω (L' ⧸ (Ideal.span {x i} ⊔ 𝔪' ^ 2)) = 2 := by
      have h_eq := ((e_Q1_Q2.trans e_Q2_JB).trans e_JB_JL').toLinearEquiv.finrank_eq
      exact h_eq.symm.trans hFin_Q1

    
    have hxi_le : Ideal.span {x i} ≤ 𝔪' :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (hx_mem i))
    have hxi_ne_top : (Ideal.span {x i} : Ideal L') ≠ ⊤ := by
      intro htop
      apply (IsLocalRing.maximalIdeal.isMaximal L').ne_top
      exact top_unique (htop ▸ hxi_le)
    let A_i := L' ⧸ Ideal.span {x i}
    have : Nontrivial A_i := Ideal.Quotient.nontrivial_iff.mpr hxi_ne_top
    have : IsLocalRing A_i :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk (Ideal.span {x i})) Ideal.Quotient.mk_surjective
    have : _root_.IsReduced A_i := hRed_Li
    letI : Field (L' ⧸ 𝔪') := Ideal.Quotient.field 𝔪'
    let π_field : A_i →+* (L' ⧸ 𝔪') := Ideal.Quotient.factor hxi_le
    have hπ_surj : Function.Surjective π_field := Ideal.Quotient.factor_surjective hxi_le
    have h_max_Ai :
        IsLocalRing.maximalIdeal A_i =
          Ideal.map (Ideal.Quotient.mkₐ Ω (Ideal.span {x i})) 𝔪' := by
      rw [← IsLocalRing.ker_eq_maximalIdeal π_field hπ_surj]
      ext z
      obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective z
      change Ideal.Quotient.mk 𝔪' u = 0 ↔
        Ideal.Quotient.mk (Ideal.span {x i}) u ∈
          Ideal.map (Ideal.Quotient.mk (Ideal.span {x i})) 𝔪'
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_quotient_iff_mem_sup, sup_eq_left.mpr hxi_le]
    have h_max_Ai_sq :
        (IsLocalRing.maximalIdeal A_i) ^ 2 =
          Ideal.map (Ideal.Quotient.mkₐ Ω (Ideal.span {x i})) (𝔪' ^ 2) := by
      rw [h_max_Ai]
      change (Ideal.map (Ideal.Quotient.mk (Ideal.span {x i})) 𝔪') ^ 2 =
        Ideal.map (Ideal.Quotient.mk (Ideal.span {x i})) (𝔪' ^ 2)
      rw [Ideal.map_pow]
    let e_Ai_JL' : (A_i ⧸ (IsLocalRing.maximalIdeal A_i) ^ 2) ≃ₐ[Ω] (L' ⧸ J_L') :=
      (Ideal.quotientEquivAlg ((IsLocalRing.maximalIdeal A_i) ^ 2)
        (Ideal.map (Ideal.Quotient.mkₐ Ω (Ideal.span {x i})) (𝔪' ^ 2))
        (AlgEquiv.refl : A_i ≃ₐ[Ω] A_i) (by simpa using h_max_Ai_sq.symm)).trans
        (DoubleQuot.quotQuotEquivQuotSupₐ Ω (Ideal.span {x i}) (𝔪' ^ 2))
    have hFin_Ai : Module.finrank Ω (A_i ⧸ (IsLocalRing.maximalIdeal A_i) ^ 2) = 2 :=
      e_Ai_JL'.toLinearEquiv.finrank_eq.trans hFin_Li
    have hDom_Ai : IsDomain A_i := (h_s1 Ω A_i hFin_Ai).2
    exact ⟨(Ideal.Quotient.isDomain_iff_prime (Ideal.span {x i})).mp hDom_Ai, hFin_Li⟩

  exact ⟨x 0, x 1, hx_mem 0, hx_mem 1, hx_mul, hx_inf,
    (hBranch 0).1, (hBranch 1).1, (hBranch 0).2, (hBranch 1).2⟩

theorem weil_algClosed_etale_roof_minimalPrime_branch_artin (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (R : Type u) [CommRing R] [Algebra Ω R] [Algebra.FiniteType Ω R]
    (q : PrimeSpectrum R)
    (P : Ideal R)
    (B : Type u) [CommRing B] [Algebra Ω B]
    (𝔪_B : PrimeSpectrum B)
    (φ_D : R →+* B) :
    q.asIdeal.IsMaximal →
    P ∈ minimalPrimes R →
    P ≤ q.asIdeal →
    φ_D.Etale →
    𝔪_B.asIdeal.IsMaximal →
    PrimeSpectrum.comap φ_D 𝔪_B = q →
    (∀ c : Ω, algebraMap Ω B c = φ_D (algebraMap Ω R c)) →
    (let L' := Localization.AtPrime 𝔪_B.asIdeal
     let 𝔪' : Ideal L' := IsLocalRing.maximalIdeal L'
     ∃ (x₀ x₁ : L'),
       x₀ ∈ 𝔪' ∧
       x₁ ∈ 𝔪' ∧
       x₀ * x₁ = 0 ∧
       (Ideal.span {x₀} : Ideal L') ⊓ Ideal.span {x₁} = ⊥ ∧
       (Ideal.span {x₀} : Ideal L').IsPrime ∧
       (Ideal.span {x₁} : Ideal L').IsPrime ∧
       Module.finrank Ω (L' ⧸ (Ideal.span {x₀} ⊔ 𝔪' ^ 2)) = 2 ∧
       Module.finrank Ω (L' ⧸ (Ideal.span {x₁} ⊔ 𝔪' ^ 2)) = 2) →
    let L := Localization.AtPrime q.asIdeal
    let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
    let 𝔭 : Ideal L := Ideal.map (algebraMap R L) P
    𝔭 = ⊥ ∨ Module.finrank Ω (L ⧸ (𝔭 ⊔ 𝔪 ^ 2)) = 2 :=
by
  intro hq hP_min hP_le hEt h𝔪B hComap hAlg hEx L 𝔪 𝔭
  let L' := Localization.AtPrime 𝔪_B.asIdeal
  let 𝔪' : Ideal L' := IsLocalRing.maximalIdeal L'
  obtain ⟨x₀, x₁, _hx₀_mem, _hx₁_mem, hmul, hinf, hp₀, hp₁, hfin₀, hfin₁⟩ := hEx

  have hPillar1_abs :
      ∀ (R₀ B₀ L₀ L₀' : Type u) [CommRing R₀] [CommRing B₀] [CommRing L₀] [CommRing L₀']
        [IsLocalRing L₀] [IsLocalRing L₀']
        (S₀ : Submonoid R₀) [Algebra R₀ L₀] [IsLocalization S₀ L₀]
        [Algebra B₀ L₀'] [Module.Flat B₀ L₀']
        (φ₀ : R₀ →+* B₀) (i₀ : L₀ →+* L₀'),
        φ₀.Etale →
        IsLocalHom i₀ →
        (∀ r : R₀, i₀ (algebraMap R₀ L₀ r) = algebraMap B₀ L₀' (φ₀ r)) →
        Function.Injective i₀ ∧
        ∀ (y₀ y₁ : L₀'),
          y₀ * y₁ = 0 →
          (Ideal.span {y₀} : Ideal L₀') ⊓ Ideal.span {y₁} = ⊥ →
          (Ideal.span {y₀} : Ideal L₀').IsPrime →
          ¬ (Ideal.comap i₀ (Ideal.span {y₁}) ≤ Ideal.comap i₀ (Ideal.span {y₀})) →
          Ideal.map i₀ (Ideal.comap i₀ (Ideal.span {y₀})) = Ideal.span {y₀} := by
    intro R₀ B₀ L₀ L₀' _ _ _ _ _ _ S₀ _ _ _ _ φ₀ i₀ hEt₀ hLoc₀ hComm₀
    letI : Algebra R₀ B₀ := φ₀.toAlgebra
    haveI : Algebra.Etale R₀ B₀ := hEt₀
    haveI : Module.Flat R₀ B₀ := inferInstance
    letI : Algebra R₀ L₀' := ((algebraMap B₀ L₀').comp φ₀).toAlgebra
    haveI : IsScalarTower R₀ B₀ L₀' := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Module.Flat R₀ L₀' := Module.Flat.trans R₀ B₀ L₀'
    letI : Algebra L₀ L₀' := i₀.toAlgebra
    haveI : IsScalarTower R₀ L₀ L₀' := IsScalarTower.of_algebraMap_eq fun r => (hComm₀ r).symm
    haveI : Module.Flat L₀ L₀' :=
      (Module.flat_iff_of_isLocalization L₀ S₀ L₀').mpr inferInstance
    haveI : IsLocalHom (algebraMap L₀ L₀') := hLoc₀
    haveI : Module.FaithfullyFlat L₀ L₀' := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hFF : i₀.FaithfullyFlat := ‹Module.FaithfullyFlat L₀ L₀'›
    refine ⟨hFF.injective, ?_⟩
    intro y₀ y₁ hmul₀ hinf₀ hp_y₀ hnot
    let J₀ : Ideal L₀ := Ideal.comap i₀ (Ideal.span {y₀})
    let J₁ : Ideal L₀ := Ideal.comap i₀ (Ideal.span {y₁})
    have hJ₀_prime : J₀.IsPrime := hp_y₀.comap i₀
    obtain ⟨z, hz₁, hz₀⟩ := SetLike.not_le_iff_exists.mp hnot
    have hAnn : ∀ w : L₀, w * z = 0 ↔ w ∈ J₀ := by
      intro w
      constructor
      · intro hwz
        have hmem : w * z ∈ J₀ := hwz ▸ J₀.zero_mem
        rcases hJ₀_prime.mem_or_mem hmem with hw | hz
        · exact hw
        · exact False.elim (hz₀ hz)
      · intro hw
        have h1 : i₀ (w * z) ∈ (Ideal.span {y₀} : Ideal L₀') := by
          rw [map_mul]
          exact Ideal.mul_mem_right (i₀ z) _ hw
        have h2 : i₀ (w * z) ∈ (Ideal.span {y₁} : Ideal L₀') := by
          rw [map_mul]
          exact Ideal.mul_mem_left _ (i₀ w) hz₁
        have hbot : i₀ (w * z) ∈ (⊥ : Ideal L₀') := by
          rw [← hinf₀]
          exact ⟨h1, h2⟩
        have h0 : i₀ (w * z) = i₀ 0 := by
          rw [Ideal.mem_bot.mp hbot, map_zero]
        exact hFF.injective h0
    let μ_z : L₀ →ₗ[L₀] L₀ :=
      { toFun := fun w => w * z
        map_add' := fun a b => add_mul a b z
        map_smul' := fun c a => by simp [smul_eq_mul, mul_assoc] }
    have hker_μ : J₀ ≤ μ_z.ker := fun w hw => (hAnn w).mpr hw
    let μ_bar : (L₀ ⧸ J₀) →ₗ[L₀] L₀ := Submodule.liftQ J₀ μ_z hker_μ
    have hμ_inj : Function.Injective μ_bar := by
      rw [← LinearMap.ker_eq_bot, eq_bot_iff]
      intro x hx
      obtain ⟨w, rfl⟩ := Submodule.Quotient.mk_surjective J₀ x
      have hwz : w * z = 0 := hx
      exact (Submodule.Quotient.mk_eq_zero J₀).mpr ((hAnn w).mp hwz)
    have hlT_inj : Function.Injective (LinearMap.lTensor L₀' μ_bar) :=
      Module.Flat.lTensor_preserves_injective_linearMap μ_bar hμ_inj
    have hAnnL' : ∀ w' : L₀', w' * i₀ z = 0 → w' ∈ Ideal.map i₀ J₀ := by
      intro w' hw'
      let e_q : (L₀' ⧸ Ideal.map (algebraMap L₀ L₀') J₀) ≃ₐ[L₀']
          TensorProduct L₀ L₀' (L₀ ⧸ J₀) :=
        Algebra.TensorProduct.quotIdealMapEquivTensorQuot L₀' J₀
      let u : L₀' ⧸ Ideal.map (algebraMap L₀ L₀') J₀ :=
        Ideal.Quotient.mk (Ideal.map (algebraMap L₀ L₀') J₀) w'
      have hu_eq : e_q u = TensorProduct.tmul L₀ w' (1 : L₀ ⧸ J₀) :=
        Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk L₀' J₀ w'
      have hlT_u : (LinearMap.lTensor L₀' μ_bar) (e_q u) = TensorProduct.tmul L₀ w' z := by
        rw [hu_eq, LinearMap.lTensor_tmul]
        have h1 : μ_bar (1 : L₀ ⧸ J₀) = z :=
          (Submodule.liftQ_apply J₀ μ_z (h := hker_μ) (1 : L₀)).trans (one_mul z)
        rw [h1]
      have hrid_u : (TensorProduct.rid L₀ L₀') ((LinearMap.lTensor L₀' μ_bar) (e_q u)) = 0 := by
        rw [hlT_u, TensorProduct.rid_tmul, Algebra.smul_def, mul_comm]
        exact hw'
      have hu0 : u = 0 := by
        apply e_q.injective
        apply hlT_inj
        apply (TensorProduct.rid L₀ L₀').injective
        simpa using hrid_u
      exact Ideal.Quotient.eq_zero_iff_mem.mp hu0
    have hy₀_mem : y₀ ∈ Ideal.map i₀ J₀ := by
      obtain ⟨c', hc'⟩ := Ideal.mem_span_singleton.mp hz₁
      apply hAnnL' y₀
      rw [hc', ← mul_assoc, hmul₀, zero_mul]
    refine le_antisymm Ideal.map_comap_le (Ideal.span_le.mpr ?_)
    rintro _ rfl
    exact hy₀_mem

  let i_et : L →+* L' :=
    Localization.localRingHom q.asIdeal 𝔪_B.asIdeal φ_D
      (congrArg PrimeSpectrum.asIdeal hComap.symm)
  obtain ⟨hInj, hBranchMap⟩ :=
    hPillar1_abs R B L L' q.asIdeal.primeCompl φ_D i_et hEt
      (Localization.isLocalHom_localRingHom q.asIdeal 𝔪_B.asIdeal φ_D
        (congrArg PrimeSpectrum.asIdeal hComap.symm))
      (Localization.localRingHom_to_map q.asIdeal 𝔪_B.asIdeal φ_D
        (congrArg PrimeSpectrum.asIdeal hComap.symm))

  have hPillar2 :
      ∃ Θ₂ : (L ⧸ 𝔪 ^ 2) ≃ₐ[Ω] (L' ⧸ 𝔪' ^ 2),
        ∀ w : L, Θ₂ (Ideal.Quotient.mk (𝔪 ^ 2) w) = Ideal.Quotient.mk (𝔪' ^ 2) (i_et w) := by
    have hEvB : ∃ ev_B : B →ₐ[Ω] Ω, RingHom.ker ev_B.toRingHom = 𝔪_B.asIdeal := by
      letI : Algebra R B := φ_D.toAlgebra
      haveI : IsScalarTower Ω R B := IsScalarTower.of_algebraMap_eq hAlg
      haveI : Algebra.Etale R B := hEt
      haveI : Algebra.FinitePresentation R B := inferInstance
      haveI : Algebra.FiniteType R B := inferInstance
      haveI : Algebra.FiniteType Ω B :=
        Algebra.FiniteType.trans ‹Algebra.FiniteType Ω R› ‹Algebra.FiniteType R B›
      obtain ⟨s, hs⟩ := ‹Algebra.FiniteType Ω B›.out
      haveI : Finite ↥s := Finset.finite_toSet s
      haveI : 𝔪_B.asIdeal.IsMaximal := h𝔪B
      let π_s : MvPolynomial ↥s Ω →ₐ[Ω] B := MvPolynomial.aeval Subtype.val
      have hrange_eq : Set.range (Subtype.val : ↥s → B) = (↑s : Set B) := by
        ext x
        simp
      have hπ_surj : Function.Surjective π_s := by
        intro b
        have hb : b ∈ π_s.range := by
          rw [MvPolynomial.aeval_range, hrange_eq, hs]
          trivial
        exact hb
      let M : Ideal (MvPolynomial ↥s Ω) := Ideal.comap π_s.toRingHom 𝔪_B.asIdeal
      have hM_max : M.IsMaximal :=
        Ideal.comap_isMaximal_of_surjective π_s.toRingHom hπ_surj
      obtain ⟨pt, hM_eq⟩ :=
        MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hM_max
      let aeval_pt : MvPolynomial ↥s Ω →ₐ[Ω] Ω := MvPolynomial.aeval pt
      have hmem_M : ∀ p : MvPolynomial ↥s Ω, p ∈ M ↔ aeval_pt p = 0 := by
        intro p
        rw [hM_eq, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      let σ_inv : B → MvPolynomial ↥s Ω := Function.surjInv hπ_surj
      have hσ : ∀ b : B, π_s (σ_inv b) = b := Function.surjInv_eq hπ_surj
      have h_wd : ∀ (p : MvPolynomial ↥s Ω) (b : B), π_s p = b → aeval_pt (σ_inv b) = aeval_pt p := by
        intro p b hpb
        have h0 : π_s (σ_inv b - p) = 0 := by
          rw [map_sub, hσ b, hpb, sub_self]
        have hmem : σ_inv b - p ∈ M := by
          change π_s (σ_inv b - p) ∈ 𝔪_B.asIdeal
          rw [h0]
          exact 𝔪_B.asIdeal.zero_mem
        have ha0 : aeval_pt (σ_inv b - p) = 0 := (hmem_M _).mp hmem
        exact sub_eq_zero.mp (by rwa [map_sub] at ha0)
      let ev_B : B →ₐ[Ω] Ω :=
        { toFun := fun b => aeval_pt (σ_inv b)
          map_one' := by rw [h_wd 1 1 (map_one π_s), map_one]
          map_mul' := fun x y => by
            rw [h_wd (σ_inv x * σ_inv y) (x * y) (by rw [map_mul, hσ, hσ]), map_mul]
          map_zero' := by rw [h_wd 0 0 (map_zero π_s), map_zero]
          map_add' := fun x y => by
            rw [h_wd (σ_inv x + σ_inv y) (x + y) (by rw [map_add, hσ, hσ]), map_add]
          commutes' := fun c => by
            rw [h_wd (algebraMap Ω _ c) (algebraMap Ω B c) (π_s.commutes c), aeval_pt.commutes] }
      refine ⟨ev_B, ?_⟩
      ext b
      obtain ⟨p, rfl⟩ := hπ_surj b
      change aeval_pt (σ_inv (π_s p)) = 0 ↔ π_s p ∈ 𝔪_B.asIdeal
      rw [h_wd p (π_s p) rfl, ← hmem_M]
      rfl

    obtain ⟨ev_B, hev_B_ker⟩ := hEvB
    have hIR_eq : q.asIdeal = Ideal.comap φ_D 𝔪_B.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hComap.symm
    have hEvR_sub : ∀ r : R, algebraMap Ω R (ev_B (φ_D r)) - r ∈ q.asIdeal := by
      intro r
      rw [hIR_eq, Ideal.mem_comap, ← hev_B_ker, RingHom.mem_ker]
      change ev_B (φ_D (algebraMap Ω R (ev_B (φ_D r)) - r)) = 0
      rw [map_sub, ← hAlg (ev_B (φ_D r)), map_sub, ev_B.commutes]
      simp

    have h_eRB : ∃ e_RB : (R ⧸ q.asIdeal ^ 2) ≃ₐ[Ω] (B ⧸ 𝔪_B.asIdeal ^ 2),
        ∀ r : R, e_RB (Ideal.Quotient.mk (q.asIdeal ^ 2) r) =
          Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) (φ_D r) := by
      letI : Algebra R B := φ_D.toAlgebra
      haveI : IsScalarTower Ω R B := IsScalarTower.of_algebraMap_eq hAlg
      haveI : Algebra.Etale R B := hEt
      haveI : Algebra.FormallyEtale R B := inferInstance
      letI : Algebra R (B ⧸ 𝔪_B.asIdeal ^ 2) := Ideal.Quotient.algebra R
      haveI : IsScalarTower R B (B ⧸ 𝔪_B.asIdeal ^ 2) :=
        Ideal.Quotient.isScalarTower R B (𝔪_B.asIdeal ^ 2)
      haveI : IsScalarTower Ω R (B ⧸ 𝔪_B.asIdeal ^ 2) := IsScalarTower.of_algebraMap_eq fun c => by
        change Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) (algebraMap Ω B c) =
          Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) (φ_D (algebraMap Ω R c))
        rw [hAlg c]
      have hpow_le : ∀ r ∈ q.asIdeal ^ 2, Algebra.ofId R (B ⧸ 𝔪_B.asIdeal ^ 2) r = 0 := by
        have hmap_le : Ideal.map φ_D (q.asIdeal ^ 2) ≤ 𝔪_B.asIdeal ^ 2 := by
          rw [Ideal.map_pow]
          exact Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr hIR_eq.le) 2
        intro r hr
        change Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) (φ_D r) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (hmap_le (Ideal.mem_map_of_mem φ_D hr))
      let f₂ : (R ⧸ q.asIdeal ^ 2) →ₐ[R] (B ⧸ 𝔪_B.asIdeal ^ 2) :=
        Ideal.Quotient.liftₐ (q.asIdeal ^ 2) (Algebra.ofId R (B ⧸ 𝔪_B.asIdeal ^ 2)) hpow_le
      let K_R : Ideal (R ⧸ q.asIdeal ^ 2) := Ideal.map (Ideal.Quotient.mk (q.asIdeal ^ 2)) q.asIdeal
      have hKR_sq : K_R ^ 2 = ⊥ := by
        dsimp [K_R]
        rw [← Ideal.map_pow, Ideal.map_quotient_self]
      let ψ₀_ring : B →+* ((R ⧸ q.asIdeal ^ 2) ⧸ K_R) :=
        (Ideal.Quotient.mk K_R).comp
          ((Ideal.Quotient.mk (q.asIdeal ^ 2)).comp ((algebraMap Ω R).comp ev_B.toRingHom))
      let ψ₀ : B →ₐ[R] ((R ⧸ q.asIdeal ^ 2) ⧸ K_R) :=
        { ψ₀_ring with
          commutes' := fun r => by
            change Ideal.Quotient.mk K_R
                (Ideal.Quotient.mk (q.asIdeal ^ 2) (algebraMap Ω R (ev_B (φ_D r)))) =
              Ideal.Quotient.mk K_R (Ideal.Quotient.mk (q.asIdeal ^ 2) r)
            rw [← sub_eq_zero, ← map_sub, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
            exact Ideal.mem_map_of_mem (Ideal.Quotient.mk (q.asIdeal ^ 2)) (hEvR_sub r) }
      obtain ⟨ψ_tilde, hψ_tilde⟩ :=
        (Algebra.FormallyEtale.comp_bijective R B K_R hKR_sq).surjective ψ₀
      have hψ_IB : Ideal.map ψ_tilde.toRingHom 𝔪_B.asIdeal ≤ K_R := by
        rw [Ideal.map_le_iff_le_comap]
        intro b hb
        rw [Ideal.mem_comap, ← Ideal.Quotient.eq_zero_iff_mem]
        have h1 : Ideal.Quotient.mk K_R (ψ_tilde b) = ψ₀ b :=
          AlgHom.congr_fun hψ_tilde b
        change Ideal.Quotient.mk K_R (ψ_tilde b) = 0
        rw [h1]
        have hb0 : ev_B b = 0 := by
          change b ∈ RingHom.ker ev_B.toRingHom
          rw [hev_B_ker]
          exact hb
        change Ideal.Quotient.mk K_R (Ideal.Quotient.mk (q.asIdeal ^ 2) (algebraMap Ω R (ev_B b))) = 0
        rw [hb0, map_zero, map_zero, map_zero]
      have hψ_IB2 : ∀ b ∈ 𝔪_B.asIdeal ^ 2, ψ_tilde b = 0 := by
        have hmap2 : Ideal.map ψ_tilde.toRingHom (𝔪_B.asIdeal ^ 2) ≤ ⊥ := by
          rw [Ideal.map_pow, ← hKR_sq]
          exact Ideal.pow_right_mono hψ_IB 2
        intro b hb
        exact Ideal.mem_bot.mp (hmap2 (Ideal.mem_map_of_mem ψ_tilde.toRingHom hb))
      let g₂ : (B ⧸ 𝔪_B.asIdeal ^ 2) →ₐ[R] (R ⧸ q.asIdeal ^ 2) :=
        Ideal.Quotient.liftₐ (𝔪_B.asIdeal ^ 2) ψ_tilde hψ_IB2
      have hgf : g₂.comp f₂ = AlgHom.id R (R ⧸ q.asIdeal ^ 2) := by
        ext x
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact (g₂.comp f₂).commutes r
      have hfg : f₂.comp g₂ = AlgHom.id R (B ⧸ 𝔪_B.asIdeal ^ 2) := by
        let K_B : Ideal (B ⧸ 𝔪_B.asIdeal ^ 2) :=
          Ideal.map (Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2)) 𝔪_B.asIdeal
        have hKB_sq : K_B ^ 2 = ⊥ := by
          dsimp [K_B]
          rw [← Ideal.map_pow, Ideal.map_quotient_self]
        have hcomp_eq :
            (f₂.comp g₂).comp (Ideal.Quotient.mkₐ R (𝔪_B.asIdeal ^ 2)) =
              Ideal.Quotient.mkₐ R (𝔪_B.asIdeal ^ 2) := by
          apply (Algebra.FormallyEtale.comp_bijective R B K_B hKB_sq).injective
          ext b
          change Ideal.Quotient.mk K_B (f₂ (ψ_tilde b)) =
            Ideal.Quotient.mk K_B (Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) b)
          have hd_KR : ψ_tilde b - Ideal.Quotient.mk (q.asIdeal ^ 2) (algebraMap Ω R (ev_B b)) ∈ K_R := by
            rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
            exact AlgHom.congr_fun hψ_tilde b
          have hf₂_KR : Ideal.map f₂.toRingHom K_R ≤ K_B := by
            dsimp [K_R, K_B]
            rw [Ideal.map_map, Ideal.map_le_iff_le_comap]
            intro r hr
            rw [Ideal.mem_comap]
            change Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) (φ_D r) ∈
              Ideal.map (Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2)) 𝔪_B.asIdeal
            apply Ideal.mem_map_of_mem
            rw [hIR_eq] at hr
            exact hr
          have h1 : f₂ (ψ_tilde b) -
              Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) (algebraMap Ω B (ev_B b)) ∈ K_B := by
            have hmem := hf₂_KR (Ideal.mem_map_of_mem f₂.toRingHom hd_KR)
            change f₂ (ψ_tilde b -
              Ideal.Quotient.mk (q.asIdeal ^ 2) (algebraMap Ω R (ev_B b))) ∈ K_B at hmem
            have heq : f₂ (ψ_tilde b -
                Ideal.Quotient.mk (q.asIdeal ^ 2) (algebraMap Ω R (ev_B b))) =
                f₂ (ψ_tilde b) -
                  Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) (algebraMap Ω B (ev_B b)) := by
              rw [map_sub]
              congr 1
              change Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) (φ_D (algebraMap Ω R (ev_B b))) = _
              rw [← hAlg (ev_B b)]
            rwa [heq] at hmem
          have h2 : Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) b -
              Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) (algebraMap Ω B (ev_B b)) ∈ K_B := by
            rw [← map_sub]
            apply Ideal.mem_map_of_mem
            rw [← hev_B_ker, RingHom.mem_ker]
            change ev_B (b - algebraMap Ω B (ev_B b)) = 0
            rw [map_sub, ev_B.commutes]
            simp
          rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
          have hsub : f₂ (ψ_tilde b) - Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) b =
              (f₂ (ψ_tilde b) - Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) (algebraMap Ω B (ev_B b))) -
                (Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) b -
                  Ideal.Quotient.mk (𝔪_B.asIdeal ^ 2) (algebraMap Ω B (ev_B b))) := by ring
          rw [hsub]
          exact K_B.sub_mem h1 h2
        ext y
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
        exact AlgHom.congr_fun hcomp_eq b
      let e_R : (R ⧸ q.asIdeal ^ 2) ≃ₐ[R] (B ⧸ 𝔪_B.asIdeal ^ 2) :=
        AlgEquiv.ofAlgHom f₂ g₂ hfg hgf
      exact ⟨e_R.restrictScalars Ω, fun _ => rfl⟩

    have hLocEquiv₂ :
        ∀ (A : Type u) [CommRing A] [Algebra Ω A] (p : PrimeSpectrum A),
          p.asIdeal.IsMaximal →
          ∃ e_loc : (A ⧸ p.asIdeal ^ 2) ≃ₐ[Ω]
              (Localization.AtPrime p.asIdeal ⧸
                (IsLocalRing.maximalIdeal (Localization.AtPrime p.asIdeal)) ^ 2),
            ∀ a : A, e_loc (Ideal.Quotient.mk (p.asIdeal ^ 2) a) =
              Ideal.Quotient.mk
                ((IsLocalRing.maximalIdeal (Localization.AtPrime p.asIdeal)) ^ 2)
                (algebraMap A (Localization.AtPrime p.asIdeal) a) := by
      intro A _ _ p hp
      let L_A := Localization.AtPrime p.asIdeal
      let 𝔪_A : Ideal L_A := IsLocalRing.maximalIdeal L_A
      have hmap_I : Ideal.map (algebraMap A L_A) p.asIdeal = 𝔪_A :=
        Localization.AtPrime.map_eq_maximalIdeal
      have hpow_le : ∀ a ∈ p.asIdeal ^ 2,
          ((Ideal.Quotient.mkₐ Ω (𝔪_A ^ 2)).comp (IsScalarTower.toAlgHom Ω A L_A)) a = 0 := by
        have hmap2 : Ideal.map (algebraMap A L_A) (p.asIdeal ^ 2) ≤ 𝔪_A ^ 2 := by
          rw [Ideal.map_pow, hmap_I]
        intro a ha
        change Ideal.Quotient.mk (𝔪_A ^ 2) (algebraMap A L_A a) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (hmap2 (Ideal.mem_map_of_mem _ ha))
      let α_bar : (A ⧸ p.asIdeal ^ 2) →ₐ[Ω] (L_A ⧸ 𝔪_A ^ 2) :=
        Ideal.Quotient.liftₐ (p.asIdeal ^ 2)
          ((Ideal.Quotient.mkₐ Ω (𝔪_A ^ 2)).comp (IsScalarTower.toAlgHom Ω A L_A)) hpow_le
      let q_A : A →+* (A ⧸ p.asIdeal ^ 2) := Ideal.Quotient.mk (p.asIdeal ^ 2)
      have hUnits : ∀ s : p.asIdeal.primeCompl, IsUnit (q_A s.1) := by
        intro s
        have htop : p.asIdeal ⊔ Ideal.span {s.1} = ⊤ := by
          by_contra hne
          have heq : p.asIdeal = p.asIdeal ⊔ Ideal.span {s.1} := hp.eq_of_le hne le_sup_left
          have hs_mem : s.1 ∈ p.asIdeal :=
            heq.ge (Ideal.mem_sup_right (Ideal.mem_span_singleton_self s.1))
          exact s.2 hs_mem
        have h1 : (1 : A) ∈ p.asIdeal ⊔ Ideal.span {s.1} := by
          rw [htop]; exact Submodule.mem_top
        obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp h1
        obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton.mp hv
        have hst : s.1 * t = 1 - u := eq_sub_of_add_eq' huv
        refine isUnit_iff_exists_inv.mpr ⟨q_A (t * (1 + u)), ?_⟩
        rw [← map_mul]
        have hprod : s.1 * (t * (1 + u)) = 1 - u ^ 2 := by
          calc s.1 * (t * (1 + u))
              = (s.1 * t) * (1 + u) := (mul_assoc _ _ _).symm
            _ = (1 - u) * (1 + u) := by rw [hst]
            _ = 1 - u ^ 2 := by ring
        rw [hprod, map_sub, map_one]
        have hu2 : q_A (u ^ 2) = 0 := by
          apply Ideal.Quotient.eq_zero_iff_mem.mpr
          rw [sq, sq]
          exact Ideal.mul_mem_mul hu hu
        rw [hu2, sub_zero]
      let β_ring : L_A →+* (A ⧸ p.asIdeal ^ 2) := IsLocalization.lift hUnits
      let β_alg : L_A →ₐ[Ω] (A ⧸ p.asIdeal ^ 2) :=
        { β_ring with
          commutes' := fun c => by
            change β_ring (algebraMap A L_A (algebraMap Ω A c)) =
              algebraMap Ω (A ⧸ p.asIdeal ^ 2) c
            rw [IsLocalization.lift_eq]
            rfl }
      let K_A : Ideal (A ⧸ p.asIdeal ^ 2) := Ideal.map q_A p.asIdeal
      have hKA_sq : K_A ^ 2 = ⊥ := by
        dsimp [K_A, q_A]
        rw [← Ideal.map_pow, Ideal.map_quotient_self]
      have hβ_m : Ideal.map β_ring 𝔪_A ≤ K_A := by
        rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap]
        obtain ⟨⟨a, s⟩, hsurj⟩ := IsLocalization.surj p.asIdeal.primeCompl x
        have ha : a ∈ p.asIdeal := by
          by_contra ha_not
          have ha_unit : IsUnit (algebraMap A L_A a) :=
            IsLocalization.map_units L_A (⟨a, ha_not⟩ : p.asIdeal.primeCompl)
          have hx_unit : IsUnit x :=
            isUnit_of_mul_isUnit_left (hsurj.symm ▸ ha_unit)
          have hmax : 𝔪_A.IsMaximal := IsLocalRing.maximalIdeal.isMaximal L_A
          exact hmax.ne_top (Ideal.eq_top_of_isUnit_mem 𝔪_A hx hx_unit)
        obtain ⟨u_s, hu_s⟩ := hUnits s
        have hβs : β_ring (algebraMap A L_A s.1) = u_s :=
          (IsLocalization.lift_eq (S := L_A) hUnits s.1).trans hu_s.symm
        have hmul_eq : β_ring x * u_s = q_A a := by
          rw [← hβs, ← map_mul, hsurj, IsLocalization.lift_eq]
        have hβx : β_ring x = q_A a * ↑u_s⁻¹ := by
          calc β_ring x
              = (β_ring x * u_s) * ↑u_s⁻¹ := by simp
            _ = q_A a * ↑u_s⁻¹ := by rw [hmul_eq]
        rw [hβx]
        exact K_A.mul_mem_right _ (Ideal.mem_map_of_mem q_A ha)
      have hβ_m2 : ∀ x ∈ 𝔪_A ^ 2, β_alg x = 0 := by
        have hmap2 : Ideal.map β_ring (𝔪_A ^ 2) ≤ ⊥ := by
          rw [Ideal.map_pow, ← hKA_sq]
          exact Ideal.pow_right_mono hβ_m 2
        intro x hx
        exact Ideal.mem_bot.mp (hmap2 (Ideal.mem_map_of_mem β_ring hx))
      let β_bar : (L_A ⧸ 𝔪_A ^ 2) →ₐ[Ω] (A ⧸ p.asIdeal ^ 2) :=
        Ideal.Quotient.liftₐ (𝔪_A ^ 2) β_alg hβ_m2
      have hβα : β_bar.comp α_bar = AlgHom.id Ω (A ⧸ p.asIdeal ^ 2) := by
        ext y
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
        change β_ring (algebraMap A L_A a) = q_A a
        exact IsLocalization.lift_eq hUnits a
      have hαβ : α_bar.comp β_bar = AlgHom.id Ω (L_A ⧸ 𝔪_A ^ 2) := by
        have hring_eq :
            (α_bar.comp β_bar).toRingHom.comp (Ideal.Quotient.mk (𝔪_A ^ 2)) =
              Ideal.Quotient.mk (𝔪_A ^ 2) := by
          apply IsLocalization.ringHom_ext p.asIdeal.primeCompl
          ext a
          change α_bar (β_ring (algebraMap A L_A a)) =
            Ideal.Quotient.mk (𝔪_A ^ 2) (algebraMap A L_A a)
          rw [IsLocalization.lift_eq]
          rfl
        ext z
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
        exact RingHom.congr_fun hring_eq x
      exact ⟨AlgEquiv.ofAlgHom α_bar β_bar hαβ hβα, fun _ => rfl⟩

    obtain ⟨e_RB, he_RB⟩ := h_eRB
    obtain ⟨e_locR, he_locR⟩ := hLocEquiv₂ R q hq
    obtain ⟨e_locB, he_locB⟩ := hLocEquiv₂ B 𝔪_B h𝔪B
    let Θ₂ : (L ⧸ 𝔪 ^ 2) ≃ₐ[Ω] (L' ⧸ 𝔪' ^ 2) :=
      e_locR.symm.trans (e_RB.trans e_locB)
    refine ⟨Θ₂, ?_⟩
    have hΘ₂_ring :
        Θ₂.toRingHom.comp (Ideal.Quotient.mk (𝔪 ^ 2)) =
          (Ideal.Quotient.mk (𝔪' ^ 2)).comp i_et := by
      apply IsLocalization.ringHom_ext q.asIdeal.primeCompl
      ext r
      change e_locB (e_RB (e_locR.symm (Ideal.Quotient.mk (𝔪 ^ 2) (algebraMap R L r)))) =
        Ideal.Quotient.mk (𝔪' ^ 2) (i_et (algebraMap R L r))
      rw [← he_locR r, e_locR.symm_apply_apply, he_RB r, he_locB (φ_D r)]
      congr 1
      exact (Localization.localRingHom_to_map q.asIdeal 𝔪_B.asIdeal φ_D
        (congrArg PrimeSpectrum.asIdeal hComap.symm) r).symm
    intro w
    exact RingHom.congr_fun hΘ₂_ring w

  have hPillar3 :
      ∀ (𝔮₀ 𝔮₁ : Ideal L),
        𝔮₀.IsPrime →
        𝔮₁.IsPrime →
        𝔮₀ ⊓ 𝔮₁ = ⊥ →
        𝔭 = ⊥ ∨ (𝔭 = 𝔮₀ ∧ ¬ (𝔮₁ ≤ 𝔮₀)) ∨ (𝔭 = 𝔮₁ ∧ ¬ (𝔮₀ ≤ 𝔮₁)) := by
    have hP_prime : P.IsPrime := hP_min.1.1
    have hDisj : Disjoint (q.asIdeal.primeCompl : Set R) (P : Set R) := by
      rw [Set.disjoint_left]
      intro r hr_compl hr_P
      exact hr_compl (hP_le hr_P)
    have h𝔭_prime : 𝔭.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint q.asIdeal.primeCompl L P hP_prime hDisj
    have hUnder_𝔭 : Ideal.under R 𝔭 = P :=
      IsLocalization.under_map_of_isPrime_disjoint q.asIdeal.primeCompl L hP_prime hDisj
    have h𝔭_min : ∀ Q : Ideal L, Q.IsPrime → Q ≤ 𝔭 → Q = 𝔭 := by
      intro Q hQ hQ_le
      have hQR_prime : (Ideal.under R Q).IsPrime := hQ.comap (algebraMap R L)
      have hQR_le : Ideal.under R Q ≤ P := by
        rw [← hUnder_𝔭]
        exact Ideal.comap_mono hQ_le
      have hP_le_QR : P ≤ Ideal.under R Q := hP_min.2 ⟨hQR_prime, bot_le⟩ hQR_le
      have h𝔭_le_Q : 𝔭 ≤ Q := by
        calc 𝔭 = Ideal.map (algebraMap R L) P := rfl
          _ ≤ Ideal.map (algebraMap R L) (Ideal.under R Q) := Ideal.map_mono hP_le_QR
          _ = Q := IsLocalization.map_under q.asIdeal.primeCompl L Q
      exact le_antisymm hQ_le h𝔭_le_Q
    intro 𝔮₀ 𝔮₁ h𝔮₀ h𝔮₁ h𝔮_inf
    have hmul_le : 𝔮₀ * 𝔮₁ ≤ 𝔭 := by
      calc 𝔮₀ * 𝔮₁ ≤ 𝔮₀ ⊓ 𝔮₁ := Ideal.mul_le_inf
        _ = ⊥ := h𝔮_inf
        _ ≤ 𝔭 := bot_le
    rcases (h𝔭_prime.mul_le.mp hmul_le) with hle₀ | hle₁
    · have heq₀ : 𝔮₀ = 𝔭 := h𝔭_min 𝔮₀ h𝔮₀ hle₀
      by_cases h10 : 𝔮₁ ≤ 𝔮₀
      · left
        have h𝔮₁_bot : 𝔮₁ = ⊥ := by
          rw [← h𝔮_inf, inf_eq_right.mpr h10]
        have hbot_prime : (⊥ : Ideal L).IsPrime := h𝔮₁_bot ▸ h𝔮₁
        exact (h𝔭_min ⊥ hbot_prime bot_le).symm
      · exact Or.inr (Or.inl ⟨heq₀.symm, h10⟩)
    · have heq₁ : 𝔮₁ = 𝔭 := h𝔭_min 𝔮₁ h𝔮₁ hle₁
      by_cases h01 : 𝔮₀ ≤ 𝔮₁
      · left
        have h𝔮₀_bot : 𝔮₀ = ⊥ := by
          rw [← h𝔮_inf, inf_eq_left.mpr h01]
        have hbot_prime : (⊥ : Ideal L).IsPrime := h𝔮₀_bot ▸ h𝔮₀
        exact (h𝔭_min ⊥ hbot_prime bot_le).symm
      · exact Or.inr (Or.inr ⟨heq₁.symm, h01⟩)

  have hJetFinrank :
      ∀ (Θ₂ : (L ⧸ 𝔪 ^ 2) ≃ₐ[Ω] (L' ⧸ 𝔪' ^ 2)),
        (∀ w : L, Θ₂ (Ideal.Quotient.mk (𝔪 ^ 2) w) = Ideal.Quotient.mk (𝔪' ^ 2) (i_et w)) →
        ∀ (K' : Ideal L'),
          Ideal.map i_et 𝔭 = K' →
          Module.finrank Ω (L ⧸ (𝔭 ⊔ 𝔪 ^ 2)) = Module.finrank Ω (L' ⧸ (K' ⊔ 𝔪' ^ 2)) := by
    intro Θ₂ hΘ₂ K' hMapEq
    have hComp :
        Θ₂.toRingHom.comp (Ideal.Quotient.mk (𝔪 ^ 2)) =
          (Ideal.Quotient.mk (𝔪' ^ 2)).comp i_et :=
      RingHom.ext hΘ₂
    have hMap₂ :
        Ideal.map (Ideal.Quotient.mkₐ Ω (𝔪' ^ 2)) K' =
          Ideal.map (↑Θ₂) (Ideal.map (Ideal.Quotient.mkₐ Ω (𝔪 ^ 2)) 𝔭) := by
      change Ideal.map (Ideal.Quotient.mk (𝔪' ^ 2)) K' =
        Ideal.map Θ₂.toRingHom (Ideal.map (Ideal.Quotient.mk (𝔪 ^ 2)) 𝔭)
      rw [Ideal.map_map, hComp, ← Ideal.map_map, hMapEq]
    let e_mid :
        ((L ⧸ 𝔪 ^ 2) ⧸ Ideal.map (Ideal.Quotient.mkₐ Ω (𝔪 ^ 2)) 𝔭) ≃ₐ[Ω]
          ((L' ⧸ 𝔪' ^ 2) ⧸ Ideal.map (Ideal.Quotient.mkₐ Ω (𝔪' ^ 2)) K') :=
      Ideal.quotientEquivAlg _ _ Θ₂ hMap₂
    let e_tot : (L ⧸ (𝔪 ^ 2 ⊔ 𝔭)) ≃ₐ[Ω] (L' ⧸ (𝔪' ^ 2 ⊔ K')) :=
      (DoubleQuot.quotQuotEquivQuotSupₐ Ω (𝔪 ^ 2) 𝔭).symm.trans
        (e_mid.trans (DoubleQuot.quotQuotEquivQuotSupₐ Ω (𝔪' ^ 2) K'))
    rw [sup_comm 𝔭 (𝔪 ^ 2), sup_comm K' (𝔪' ^ 2)]
    exact e_tot.toLinearEquiv.finrank_eq

  let 𝔮₀ : Ideal L := Ideal.comap i_et (Ideal.span {x₀})
  let 𝔮₁ : Ideal L := Ideal.comap i_et (Ideal.span {x₁})
  have h𝔮₀_prime : 𝔮₀.IsPrime := hp₀.comap i_et
  have h𝔮₁_prime : 𝔮₁.IsPrime := hp₁.comap i_et
  have h𝔮_inf : 𝔮₀ ⊓ 𝔮₁ = ⊥ := by
    rw [eq_bot_iff]
    intro w hw
    have hw' : i_et w ∈ (Ideal.span {x₀} : Ideal L') ⊓ Ideal.span {x₁} := hw
    rw [hinf, Ideal.mem_bot] at hw'
    have hw0 : i_et w = i_et 0 := by rw [hw', map_zero]
    rw [hInj hw0]
    exact Submodule.zero_mem ⊥

  rcases hPillar3 𝔮₀ 𝔮₁ h𝔮₀_prime h𝔮₁_prime h𝔮_inf with
      hBot | ⟨h𝔭₀, hnot₁₀⟩ | ⟨h𝔭₁, hnot₀₁⟩
  · exact Or.inl hBot
  · right
    obtain ⟨Θ₂, hΘ₂⟩ := hPillar2
    have hMap₀ : Ideal.map i_et 𝔭 = Ideal.span {x₀} := by
      rw [h𝔭₀]
      exact hBranchMap x₀ x₁ hmul hinf hp₀ hnot₁₀
    exact (hJetFinrank Θ₂ hΘ₂ (Ideal.span {x₀}) hMap₀).trans hfin₀
  · right
    obtain ⟨Θ₂, hΘ₂⟩ := hPillar2
    have hmul' : x₁ * x₀ = 0 := by rw [mul_comm, hmul]
    have hinf' : (Ideal.span {x₁} : Ideal L') ⊓ Ideal.span {x₀} = ⊥ := by
      rw [inf_comm, hinf]
    have hMap₁ : Ideal.map i_et 𝔭 = Ideal.span {x₁} := by
      rw [h𝔭₁]
      exact hBranchMap x₁ x₀ hmul' hinf' hp₁ hnot₀₁
    exact (hJetFinrank Θ₂ hΘ₂ (Ideal.span {x₁}) hMap₁).trans hfin₁

theorem weil_algClosed_smoothOrNodal_components_and_incidence : (∀ {Z E₁ E₂ : AlgebraicGeometry.Scheme.{u}} (ι₁ : E₁ ⟶ Z) (ι₂ : E₂ ⟶ Z),
      AlgebraicGeometry.IsClosedImmersion ι₁ →
      AlgebraicGeometry.IsClosedImmersion ι₂ →
      AlgebraicGeometry.IsReduced E₁ →
      AlgebraicGeometry.IsReduced E₂ →
      Set.range ι₁.base = Set.range ι₂.base →
      ∃ e : E₁ ≅ E₂, e.hom ≫ ι₂ = ι₁) ∧
    (∀ {X : Type u} [TopologicalSpace X] (c m : ℕ) (_hc : 1 ≤ c)
        (F : Fin c → Set X) (inc : Fin m → Fin c × Fin c),
      (∀ i : Fin c, IsClosed (F i) ∧ IsIrreducible (F i)) →
      (⋃ i : Fin c, F i) = Set.univ →
      (∀ i : Fin c, ∃ x ∈ F i, ∀ j : Fin c, j ≠ i → x ∉ F j) →
      (∀ S : Set (Fin c), S.Nonempty →
        (∀ i₁ ∈ S, ∀ i₂ : Fin c, i₂ ∉ S →
          ¬ ∃ a : Fin m, inc a = (i₁, i₂) ∨ inc a = (i₂, i₁)) →
        S = Set.univ) →
      (∀ a : Fin m, (F (inc a).1 ∩ F (inc a).2).Nonempty) →
      ConnectedSpace X ∧
      (_root_.Pairwise fun i₁ i₂ : Fin c => F i₁ ≠ F i₂) ∧
      irreducibleComponents X = Set.range F) ∧
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (Y : AlgebraicGeometry.Scheme.{u})
        (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω)),
      AlgebraicGeometry.IsProper p_Y →
      AlgebraicGeometry.LocallyOfFiniteType p_Y →
      (∀ (Y' : AlgebraicGeometry.Scheme.{u})
          (p_Y' : Y' ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
          [AlgebraicGeometry.LocallyOfFiniteType p_Y'],
        (∀ y : Y', HasSpreadSmoothOrNodalAt p_Y' y) ↔
          (AlgebraicGeometry.IsReduced Y' ∧
           ∀ (D : Type u) [CommRing D] [Algebra Ω D]
             (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y'),
             AlgebraicGeometry.IsOpenImmersion j_D →
             j_D ≫ p_Y' = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
             ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
               let L := Localization.AtPrime q.asIdeal
               let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
               Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
                 (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
                  Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
                  ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3))) →
      ConnectedSpace ↥Y →
      (∀ y : Y, HasSpreadSmoothOrNodalAt p_Y y) →
      ∃ (c : ℕ)
        (E_gen : Fin c → AlgebraicGeometry.Scheme.{u})
        (ι_E : ∀ i : Fin c, E_gen i ⟶ Y)
        (m : ℕ)
        (pt : Fin m → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y))
        (inc : Fin m → Fin c × Fin c),
        1 ≤ c ∧
        (∀ i : Fin c,
          AlgebraicGeometry.IsClosedImmersion (ι_E i) ∧
          AlgebraicGeometry.IsIntegral (E_gen i) ∧
          AlgebraicGeometry.IsProper (ι_E i ≫ p_Y) ∧
          AlgebraicGeometry.LocallyOfFiniteType (ι_E i ≫ p_Y) ∧
          ∀ z : E_gen i, HasSpreadSmoothOrNodalAt (ι_E i ≫ p_Y) z) ∧
        (⋃ i : Fin c, Set.range (ι_E i).base) = Set.univ ∧
        (∀ i : Fin c, ∃ x : E_gen i, ∀ j : Fin c, j ≠ i →
          (ι_E i).base x ∉ Set.range (ι_E j).base) ∧
        (∀ S : Set (Fin c), S.Nonempty →
          (∀ i₁ ∈ S, ∀ i₂ : Fin c, i₂ ∉ S →
            ¬ ∃ a : Fin m, inc a = (i₁, i₂) ∨ inc a = (i₂, i₁)) →
          S = Set.univ) ∧
        (∀ a : Fin m,
          pt a ≫ p_Y = 𝟙 _ ∧
          (∃ s₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E_gen (inc a).1,
            s₁ ≫ ι_E (inc a).1 = pt a) ∧
          (∃ s₂ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E_gen (inc a).2,
            s₂ ≫ ι_E (inc a).2 = pt a))) :=
by
  obtain ⟨hTopoReassemble, hTopoExtract⟩ :=
    weil_topological_component_incidence_reassembly_and_extract.{u}
  obtain ⟨hUniqueRed, hCompSubscheme, hInterSection⟩ :=
    weil_scheme_reduced_closedSubscheme_and_algClosed_sections.{u}
  obtain ⟨hLocalDvrDomain, hNodalEtalePrimes⟩ :=
    weil_algClosed_local_dvr_and_nodal_etale_primes.{u}
  refine ⟨hUniqueRed, hTopoReassemble, ?_⟩
  intro Ω instFieldΩ instAlgClosedΩ Y p_Y hProp hLFT hArtin hConn hSmNod
  let _ : Field Ω := instFieldΩ
  have _ : IsAlgClosed Ω := instAlgClosedΩ
  have _ : IsArtinianRing Ω := DivisionRing.instIsArtinianRing
  have hNoethΩ : IsNoetherianRing Ω := instIsNoetherianRingOfIsArtinianRing Ω
  have _ : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
    AlgebraicGeometry.isLocallyNoetherian_Spec.mpr hNoethΩ
  have _ : AlgebraicGeometry.IsProper p_Y := hProp
  have _ : AlgebraicGeometry.LocallyOfFiniteType p_Y := hLFT
  have _ : CompactSpace ↥Y := AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p_Y
  have _ : AlgebraicGeometry.IsLocallyNoetherian Y :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian p_Y
  have _ : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk
  have hFin : (irreducibleComponents ↥Y).Finite :=
    AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian

  obtain ⟨c, F, m, inc, hc, hF_comp, hCov_F, hExcl_F, hPart, hEdge_F⟩ :=
    hTopoExtract ↥Y hConn hFin
  obtain ⟨hRedY, hArtinY⟩ := (hArtin Y p_Y).mp hSmNod

  choose E_gen ι_E hE_props using
    fun i : Fin c => hCompSubscheme Ω Y p_Y (F i) (hF_comp i).1

  have hCl_i : ∀ i : Fin c, AlgebraicGeometry.IsClosedImmersion (ι_E i) :=
    fun i => (hE_props i).1
  have hInt_i : ∀ i : Fin c, AlgebraicGeometry.IsIntegral (E_gen i) :=
    fun i => (hE_props i).2.1
  have hRange_i : ∀ i : Fin c, Set.range (ι_E i).base = F i :=
    fun i => (hE_props i).2.2.1
  have hProp_i : ∀ i : Fin c, AlgebraicGeometry.IsProper (ι_E i ≫ p_Y) :=
    fun i => (hE_props i).2.2.2.1 hProp
  have hLFT_i : ∀ i : Fin c, AlgebraicGeometry.LocallyOfFiniteType (ι_E i ≫ p_Y) :=
    fun i => (hE_props i).2.2.2.2.1
  have hBridge_i := fun i : Fin c => (hE_props i).2.2.2.2.2

  have hInterNonempty : ∀ a : Fin m,
      (Set.range (ι_E (inc a).1).base ∩ Set.range (ι_E (inc a).2).base).Nonempty := by
    intro a
    rw [hRange_i (inc a).1, hRange_i (inc a).2]
    exact hEdge_F a

  choose pt hpt using fun a : Fin m =>
    hInterSection Ω Y (E_gen (inc a).1) (E_gen (inc a).2) p_Y
      (ι_E (inc a).1) (ι_E (inc a).2) (hCl_i (inc a).1) (hCl_i (inc a).2)
      (hInterNonempty a)

  have hHelperBot : ∀ {L₀ L : Type u} [CommRing L₀] [CommRing L] [IsLocalRing L₀] [IsLocalRing L]
      [Algebra Ω L₀] [Algebra Ω L]
      (𝔭 : Ideal L), 𝔭 = ⊥ →
      (L₀ ≃ₐ[Ω] (L ⧸ 𝔭)) →
      let 𝔪₀ : Ideal L₀ := IsLocalRing.maximalIdeal L₀
      let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
      (∀ k : ℕ, Module.finrank Ω (L₀ ⧸ 𝔪₀ ^ k) = Module.finrank Ω (L ⧸ 𝔪 ^ k)) ∧
      ((∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3) →
        ∃ u₀ v₀ : L₀, Ideal.span {u₀, v₀} = 𝔪₀ ∧ u₀ * v₀ ∈ 𝔪₀ ^ 3) := by
    intro L₀ L _ _ _ _ _ _ 𝔭 h𝔭 e_loc 𝔪₀ 𝔪
    have hle : ∀ x ∈ 𝔭, AlgHom.id Ω L x = 0 := by
      intro x hx; rw [h𝔭] at hx; exact hx
    let f_bot : (L ⧸ 𝔭) →ₐ[Ω] L := Ideal.Quotient.liftₐ 𝔭 (AlgHom.id Ω L) hle
    let g_bot : L →ₐ[Ω] (L ⧸ 𝔭) := Ideal.Quotient.mkₐ Ω 𝔭
    let e_bot : (L ⧸ 𝔭) ≃ₐ[Ω] L := AlgEquiv.ofAlgHom f_bot g_bot
      (AlgHom.ext fun _ => rfl)
      (AlgHom.ext fun y => by obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y; rfl)
    let e : L₀ ≃ₐ[Ω] L := e_loc.trans e_bot
    have hm_comap : Ideal.comap e.toRingHom 𝔪 = 𝔪₀ :=
      IsLocalRing.eq_maximalIdeal
        (Ideal.comap_isMaximal_of_surjective e.toRingHom e.surjective)
    have hm_map : 𝔪 = Ideal.map e.toRingHom 𝔪₀ := by
      rw [← hm_comap, Ideal.map_comap_of_surjective e.toRingHom e.surjective]
    refine ⟨?_, ?_⟩
    · intro k
      have hpow_map : 𝔪 ^ k = Ideal.map (↑e) (𝔪₀ ^ k) := by
        change 𝔪 ^ k = Ideal.map e.toRingHom (𝔪₀ ^ k)
        rw [Ideal.map_pow, ← hm_map]
      exact (Ideal.quotientEquivAlg (𝔪₀ ^ k) (𝔪 ^ k) e hpow_map).toLinearEquiv.finrank_eq
    · rintro ⟨u, v, huv_span, huv_mem3⟩
      refine ⟨e.symm u, e.symm v, ?_, ?_⟩
      · apply le_antisymm
        · rw [Ideal.span_le]
          rintro z (rfl | rfl)
          · change e.symm u ∈ 𝔪₀
            rw [← hm_comap, Ideal.mem_comap]
            change e (e.symm u) ∈ 𝔪
            rw [e.apply_symm_apply, ← huv_span]
            exact Ideal.subset_span (by simp)
          · change e.symm v ∈ 𝔪₀
            rw [← hm_comap, Ideal.mem_comap]
            change e (e.symm v) ∈ 𝔪
            rw [e.apply_symm_apply, ← huv_span]
            exact Ideal.subset_span (by simp)
        · intro x hx
          have hex : e x ∈ Ideal.span {u, v} := by
            rw [huv_span]
            rw [← hm_comap] at hx
            exact hx
          obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hex
          have hx_eq : x = e.symm a * e.symm u + e.symm b * e.symm v := by
            apply e.injective
            simp [map_add, map_mul, hab]
          rw [hx_eq]
          exact Ideal.mem_span_pair.mpr ⟨e.symm a, e.symm b, rfl⟩
      · have h_mem_map : e (e.symm u * e.symm v) ∈ Ideal.map e.toRingHom (𝔪₀ ^ 3) := by
          rw [Ideal.map_pow, ← hm_map, map_mul, e.apply_symm_apply, e.apply_symm_apply]
          exact huv_mem3
        have h_comap_pow : Ideal.comap e.toRingHom (Ideal.map e.toRingHom (𝔪₀ ^ 3)) = 𝔪₀ ^ 3 :=
          Ideal.comap_map_of_bijective e.toRingHom e.bijective
        rw [← h_comap_pow]
        exact h_mem_map

  have hHelperSup : ∀ {R L₀ : Type u} [CommRing R] [CommRing L₀] [IsLocalRing L₀]
      [Algebra Ω R] [Algebra Ω L₀]
      (q_R : PrimeSpectrum R) (P_F : Ideal R),
      P_F ≤ q_R.asIdeal →
      (L₀ ≃ₐ[Ω] (Localization.AtPrime q_R.asIdeal ⧸
        Ideal.map (algebraMap R (Localization.AtPrime q_R.asIdeal)) P_F)) →
      Module.finrank Ω (Localization.AtPrime q_R.asIdeal ⧸
        (Ideal.map (algebraMap R (Localization.AtPrime q_R.asIdeal)) P_F ⊔
          (IsLocalRing.maximalIdeal (Localization.AtPrime q_R.asIdeal)) ^ 2)) = 2 →
      Module.finrank Ω (L₀ ⧸ (IsLocalRing.maximalIdeal L₀) ^ 2) = 2 := by
    intro R L₀ _ _ _ _ _ q_R P_F hPF_le e_loc hFinSup
    let L := Localization.AtPrime q_R.asIdeal
    let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
    let 𝔭 : Ideal L := Ideal.map (algebraMap R L) P_F
    let 𝔪₀ : Ideal L₀ := IsLocalRing.maximalIdeal L₀
    have h𝔭_le_𝔪 : 𝔭 ≤ 𝔪 := by
      rw [Ideal.map_le_iff_le_comap]
      refine hPF_le.trans ?_
      change q_R.asIdeal ≤ Ideal.under R 𝔪
      rw [Localization.AtPrime.under_maximalIdeal]
    let π_field : (L ⧸ 𝔭) →+* (L ⧸ 𝔪) :=
      Ideal.Quotient.lift 𝔭 (Ideal.Quotient.mk 𝔪)
        (fun x hx => Ideal.Quotient.eq_zero_iff_mem.mpr (h𝔭_le_𝔪 hx))
    have hπ_surj : Function.Surjective π_field := by
      intro y
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨Ideal.Quotient.mk 𝔭 x, rfl⟩
    let _ : Field (L ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    have hker_max : (RingHom.ker π_field).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective π_field hπ_surj
    have hker_eq : RingHom.ker π_field = Ideal.map (Ideal.Quotient.mk 𝔭) 𝔪 := by
      ext z
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
      simp only [RingHom.mem_ker]
      change Ideal.Quotient.mk 𝔪 x = 0 ↔ Ideal.Quotient.mk 𝔭 x ∈ Ideal.map (Ideal.Quotient.mk 𝔭) 𝔪
      rw [Ideal.Quotient.eq_zero_iff_mem]
      constructor
      · exact fun hx => Ideal.mem_map_of_mem _ hx
      · intro hx
        have hx_sup : x ∈ 𝔪 ⊔ 𝔭 := Ideal.mem_quotient_iff_mem_sup.mp hx
        rwa [sup_eq_left.mpr h𝔭_le_𝔪] at hx_sup
    have _ : (Ideal.map (Ideal.Quotient.mk 𝔭) 𝔪).IsMaximal := hker_eq ▸ hker_max
    have hm₀_comap : Ideal.comap e_loc.toRingHom (Ideal.map (Ideal.Quotient.mk 𝔭) 𝔪) = 𝔪₀ :=
      IsLocalRing.eq_maximalIdeal
        (Ideal.comap_isMaximal_of_surjective e_loc.toRingHom e_loc.surjective)
    have hm₀_map : Ideal.map (Ideal.Quotient.mk 𝔭) 𝔪 = Ideal.map e_loc.toRingHom 𝔪₀ := by
      rw [← hm₀_comap, Ideal.map_comap_of_surjective e_loc.toRingHom e_loc.surjective]
    have hm₀_pow2 : Ideal.map (Ideal.Quotient.mkₐ Ω 𝔭) (𝔪 ^ 2) = Ideal.map (↑e_loc) (𝔪₀ ^ 2) := by
      change Ideal.map (Ideal.Quotient.mk 𝔭) (𝔪 ^ 2) = Ideal.map e_loc.toRingHom (𝔪₀ ^ 2)
      rw [Ideal.map_pow, Ideal.map_pow, hm₀_map]
    let e_q : (L₀ ⧸ 𝔪₀ ^ 2) ≃ₐ[Ω] ((L ⧸ 𝔭) ⧸ Ideal.map (Ideal.Quotient.mkₐ Ω 𝔭) (𝔪 ^ 2)) :=
      Ideal.quotientEquivAlg (𝔪₀ ^ 2) (Ideal.map (Ideal.Quotient.mkₐ Ω 𝔭) (𝔪 ^ 2)) e_loc hm₀_pow2
    let e_dq : ((L ⧸ 𝔭) ⧸ Ideal.map (Ideal.Quotient.mkₐ Ω 𝔭) (𝔪 ^ 2)) ≃ₐ[Ω] (L ⧸ (𝔭 ⊔ 𝔪 ^ 2)) :=
      DoubleQuot.quotQuotEquivQuotSupₐ Ω 𝔭 (𝔪 ^ 2)
    exact (e_q.trans e_dq).toLinearEquiv.finrank_eq.trans hFinSup

  refine ⟨c, E_gen, ι_E, m, pt, inc, hc, ?_, ?_, ?_, hPart, hpt⟩
  · intro i
    have _ : AlgebraicGeometry.LocallyOfFiniteType (ι_E i ≫ p_Y) := hLFT_i i
    have hRed_Ei : AlgebraicGeometry.IsReduced (E_gen i) :=
      ((AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced (E_gen i)).mp (hInt_i i)).2
    refine ⟨hCl_i i, hInt_i i, hProp_i i, hLFT_i i, ?_⟩
    refine (hArtin (E_gen i) (ι_E i ≫ p_Y)).mpr ⟨hRed_Ei, ?_⟩
    intro D₀ _ _ j₀ hj₀_open hj₀_comm q₀ hq₀_max
    let L₀ := Localization.AtPrime q₀.asIdeal
    let 𝔪₀ : Ideal L₀ := IsLocalRing.maximalIdeal L₀
    show Module.finrank Ω (L₀ ⧸ 𝔪₀ ^ 2) = 2 ∨
      (Module.finrank Ω (L₀ ⧸ 𝔪₀ ^ 2) = 3 ∧
       Module.finrank Ω (L₀ ⧸ 𝔪₀ ^ 3) = 5 ∧
       ∃ u v : L₀, Ideal.span {u, v} = 𝔪₀ ∧ u * v ∈ 𝔪₀ ^ 3)
    obtain ⟨R, instCR_R, instAlg_R, j_R, q_R, P_F,
        hFT_R, hRed_R, hjR_open, hjR_comm, hqR_max, hPF_min, hPF_le, ⟨e_loc⟩⟩ :=
      hBridge_i i hRedY D₀ j₀ hj₀_open hj₀_comm q₀ hq₀_max
    let _ : CommRing R := instCR_R
    let _ : Algebra Ω R := instAlg_R
    have _ : Algebra.FiniteType Ω R := hFT_R
    have _ : _root_.IsReduced R := hRed_R
    let L := Localization.AtPrime q_R.asIdeal
    let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
    let 𝔭 : Ideal L := Ideal.map (algebraMap R L) P_F
    rcases hArtinY R j_R hjR_open hjR_comm q_R hqR_max with hFin2 | hBranch2
    · left
      have _ : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing Ω R
      have _ : IsNoetherianRing L :=
        IsLocalization.isNoetherianRing q_R.asIdeal.primeCompl L inferInstance
      have _ : _root_.IsReduced L := inferInstance
      have hDomL : IsDomain L := hLocalDvrDomain Ω L hFin2
      have hPF_prime : P_F.IsPrime := hPF_min.1.1
      let Q₀ : Ideal R := Ideal.comap (algebraMap R L) (⊥ : Ideal L)
      have hQ₀_prime : Q₀.IsPrime := by
        refine ⟨?_, ?_⟩
        · intro htop
          have h1 : (1 : R) ∈ Q₀ := htop ▸ Submodule.mem_top
          have h10 : algebraMap R L 1 = 0 := h1
          rw [map_one] at h10
          exact one_ne_zero h10
        · intro x y hxy
          have hmul : algebraMap R L x * algebraMap R L y = 0 := by
            rw [← map_mul]; exact hxy
          by_cases hx : algebraMap R L x = 0
          · exact Or.inl hx
          · right
            exact @mul_left_cancel₀ L _ _
              hDomL.toIsCancelMulZero.toIsLeftCancelMulZero _ _ _ hx
              (hmul.trans (mul_zero _).symm)
      have hQ₀_le_PF : Q₀ ≤ P_F := by
        intro r hr
        have hr0 : algebraMap R L r = 0 := hr
        obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff q_R.asIdeal.primeCompl L r).mp hr0
        have hmul_mem : s.1 * r ∈ P_F := by rw [hs]; exact P_F.zero_mem
        rcases hPF_prime.mem_or_mem hmul_mem with hs_PF | hr_PF
        · exact False.elim (s.2 (hPF_le hs_PF))
        · exact hr_PF
      have hPF_le_Q₀ : P_F ≤ Q₀ := hPF_min.2 ⟨hQ₀_prime, bot_le⟩ hQ₀_le_PF
      have h𝔭_bot : 𝔭 = ⊥ := by
        rw [eq_bot_iff, Ideal.map_le_iff_le_comap]
        exact hPF_le_Q₀
      exact ((hHelperBot 𝔭 h𝔭_bot e_loc).1 2).trans hFin2
    · obtain ⟨B, instCR_B, q_B, φ_D, φ_node, hEt_D, hEt_node, hComap_q, hX_in_qB, hAlgComm⟩ :=
        (weil_algClosed_artin_commRing_smooth_or_nodal_roof Ω R q_R hqR_max).2 hBranch2
      let _ : CommRing B := instCR_B
      let _ : Algebra Ω B := (φ_D.comp (algebraMap Ω R)).toAlgebra
      have hAlgNode : ∀ c : Ω,
          algebraMap Ω B c = φ_node (Ideal.Quotient.mk _ (MvPolynomial.C c)) := by
        intro c
        exact RingHom.congr_fun hAlgComm c
      obtain ⟨𝔪_B, hqB_le_𝔪B, h𝔪B_max, hPrimesL'⟩ :=
        hNodalEtalePrimes Ω B q_B φ_node hEt_node hX_in_qB hAlgNode
      have hComap_𝔪B : PrimeSpectrum.comap φ_D 𝔪_B = q_R := by
        apply PrimeSpectrum.ext
        have hq_le : q_R.asIdeal ≤ (PrimeSpectrum.comap φ_D 𝔪_B).asIdeal := by
          have h1 : q_R.asIdeal = Ideal.comap φ_D q_B.asIdeal := by
            rw [← hComap_q]; rfl
          rw [h1]
          exact Ideal.comap_mono hqB_le_𝔪B
        exact (hqR_max.eq_of_le (PrimeSpectrum.comap φ_D 𝔪_B).isPrime.ne_top hq_le).symm
      rcases weil_algClosed_etale_roof_minimalPrime_branch_artin
          Ω R q_R P_F B 𝔪_B φ_D hqR_max hPF_min hPF_le hEt_D h𝔪B_max hComap_𝔪B
          (fun _ => rfl) hPrimesL' with h𝔭_bot | hFinSup2
      · right
        obtain ⟨hFinEq, hUV_trans⟩ := hHelperBot 𝔭 h𝔭_bot e_loc
        exact ⟨(hFinEq 2).trans hBranch2.1, (hFinEq 3).trans hBranch2.2.1,
          hUV_trans hBranch2.2.2⟩
      · left
        exact hHelperSup q_R P_F hPF_le e_loc hFinSup2
  · simpa only [hRange_i] using hCov_F
  · intro i
    obtain ⟨y, hy_Fi, hy_excl⟩ := hExcl_F i
    rw [← hRange_i i] at hy_Fi
    obtain ⟨x, rfl⟩ := hy_Fi
    refine ⟨x, fun j hji => ?_⟩
    rw [hRange_i j]
    exact hy_excl j hji

theorem weil_algClosed_stdSmooth_domain_plane_curve_away_iso (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (D : Type u) [CommRing D] [IsDomain D]
    (α_D : Ω →+* D) :
    RingHom.IsStandardSmoothOfRelativeDimension 1 α_D →
    ∃ (P : Polynomial (Polynomial Ω))
      (g₀ : Polynomial (Polynomial Ω) ⧸
        Ideal.span ({P} : Set (Polynomial (Polynomial Ω))))
      (α_W : Ω →+* Localization.Away g₀)
      (h_D : D)
      (e_loc : Localization.Away g₀ ≃+* Localization.Away h_D)
      (ev_W : Localization.Away g₀ →+* Ω),
      P.Monic ∧
      1 ≤ P.natDegree ∧
      Irreducible P ∧
      (∀ c : Ω, α_W c = Localization.mk
        (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) ∧
      h_D ≠ 0 ∧
      e_loc.toRingHom.comp α_W = (algebraMap D (Localization.Away h_D)).comp α_D ∧
      ev_W.comp α_W = RingHom.id Ω ∧
      (∀ (F : Type u) [Field F] (φ_D : D →+* F),
        @IsFractionRing D _ F _ φ_D.toAlgebra →
        ∃ (ι_u : FractionRing (Polynomial Ω) →+* F),
          ι_u.comp ((algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω))).comp Polynomial.C) =
            φ_D.comp α_D ∧
          (letI : Algebra (FractionRing (Polynomial Ω)) F := ι_u.toAlgebra
           FiniteDimensional (FractionRing (Polynomial Ω)) F)) :=
by
  intro hSm
  let R_u : Type u := Polynomial Ω
  let K_u : Type u := FractionRing R_u
  let L_D : Type u := FractionRing D

  
  obtain ⟨g₁, hg₁_C, hg₁_et⟩ :=
    RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hSm
  let e_poly : R_u ≃ₐ[Ω] MvPolynomial (Fin 1) Ω :=
    (MvPolynomial.uniqueAlgEquiv Ω (Fin 1)).symm
  have he_et : e_poly.toRingHom.Etale :=
    RingHom.Etale.of_bijective e_poly.bijective
  let φ_u : R_u →+* D := g₁.comp e_poly.toRingHom
  have hφ_et : φ_u.Etale :=
    RingHom.Etale.stableUnderComposition _ _ he_et hg₁_et
  have hφ_C : φ_u.comp Polynomial.C = α_D := by
    ext c
    have he_c : e_poly (Polynomial.C c) = MvPolynomial.C c := by
      change e_poly (algebraMap Ω R_u c) = algebraMap Ω (MvPolynomial (Fin 1) Ω) c
      exact e_poly.commutes c
    change g₁ (e_poly (Polynomial.C c)) = α_D c
    rw [he_c]
    exact RingHom.congr_fun hg₁_C c

  let _ : Algebra R_u D := φ_u.toAlgebra
  have _ : Algebra.Etale R_u D := by
    rw [← RingHom.etale_algebraMap]
    exact hφ_et
  have _ : Module.Flat R_u D := inferInstance
  have hFT_D : Algebra.FiniteType R_u D := inferInstance

  have hInj_φ : Function.Injective φ_u := by
    rw [injective_iff_map_eq_zero]
    intro r hr0
    by_contra hr_ne
    let f_r : R_u →ₗ[R_u] R_u := LinearMap.mulLeft R_u r
    have hf_r_inj : Function.Injective f_r := mul_right_injective₀ hr_ne
    have hlT_inj : Function.Injective (LinearMap.lTensor D f_r) :=
      Module.Flat.lTensor_preserves_injective_linearMap f_r hf_r_inj
    have h_lT_zero : (LinearMap.lTensor D f_r) ((1 : D) ⊗ₜ[R_u] (1 : R_u)) = 0 := by
      change (1 : D) ⊗ₜ[R_u] (r * 1) = 0
      have h_smul : (1 : D) ⊗ₜ[R_u] (r * (1 : R_u)) = (r • (1 : D)) ⊗ₜ[R_u] (1 : R_u) := by
        rw [← smul_eq_mul]
        exact (TensorProduct.smul_tmul r (1 : D) (1 : R_u)).symm
      rw [h_smul]
      have hr_smul : r • (1 : D) = 0 := by
        change φ_u r * 1 = 0
        rw [hr0, zero_mul]
      rw [hr_smul, TensorProduct.zero_tmul]
    have h_tmul_zero : (1 : D) ⊗ₜ[R_u] (1 : R_u) = 0 :=
      hlT_inj (by rw [h_lT_zero, map_zero])
    have h_one_zero : (1 : D) = 0 := by
      have hrid := congrArg (TensorProduct.rid R_u D) h_tmul_zero
      simp at hrid
    exact one_ne_zero h_one_zero

  
  let ψ₀ : R_u →+* L_D := (algebraMap D L_D).comp φ_u
  have hψ₀_units : ∀ y : nonZeroDivisors R_u, IsUnit (ψ₀ y.1) := by
    intro y
    have hy_ne : (y.1 : R_u) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
    have hφy_ne : φ_u y.1 ≠ 0 := fun h0 => hy_ne (hInj_φ (h0.trans (map_zero φ_u).symm))
    have hLy_ne : ψ₀ y.1 ≠ 0 :=
      fun h0 => hφy_ne (IsFractionRing.injective D L_D (h0.trans (map_zero _).symm))
    exact Ne.isUnit hLy_ne

  let ι_KL : K_u →+* L_D := IsLocalization.lift hψ₀_units
  have hι_comm : ∀ r : R_u, ι_KL (algebraMap R_u K_u r) = algebraMap D L_D (φ_u r) :=
    fun r => IsLocalization.lift_eq hψ₀_units r

  let _ : Algebra K_u L_D := ι_KL.toAlgebra
  have _ : IsScalarTower R_u K_u L_D :=
    ⟨fun r k x => by
      change ι_KL (r • k) * x = r • (ι_KL k * x)
      rw [Algebra.smul_def r k, map_mul, hι_comm r, mul_assoc, Algebra.smul_def r (ι_KL k * x),
        IsScalarTower.algebraMap_apply R_u D L_D r]
      rfl⟩

  let B_K : Type u := TensorProduct R_u K_u D
  have _ : Algebra.Etale K_u B_K := Algebra.Etale.baseChange R_u D K_u
  let algD_LD : D →ₐ[R_u] L_D := IsScalarTower.toAlgHom R_u D L_D
  let ψ_BK : B_K →ₐ[K_u] L_D :=
    Algebra.TensorProduct.lift (Algebra.ofId K_u L_D) algD_LD (fun _ _ => Commute.all _ _)

  have hClear_BK : ∀ z : B_K, ∃ (s : nonZeroDivisors R_u) (d : D),
      (algebraMap R_u K_u s.1) • z = (1 : K_u) ⊗ₜ[R_u] d := by
    intro z
    refine TensorProduct.inductionOn (motive := fun z : B_K =>
      ∃ (s : nonZeroDivisors R_u) (d : D),
        (algebraMap R_u K_u s.1) • z = (1 : K_u) ⊗ₜ[R_u] d) z ?_ ?_
    · intro k d
      obtain ⟨⟨a, s⟩, hs_eq⟩ := IsLocalization.surj (nonZeroDivisors R_u) k
      refine ⟨s, a • d, ?_⟩
      change (algebraMap R_u K_u s.1 * k) ⊗ₜ[R_u] d = (1 : K_u) ⊗ₜ[R_u] (a • d)
      rw [mul_comm, hs_eq]
      have ha_eq : algebraMap R_u K_u a = a • (1 : K_u) := by
        rw [Algebra.smul_def, mul_one]
      rw [ha_eq, TensorProduct.smul_tmul]
    · rintro z₁ z₂ ⟨s₁, d₁, hz₁⟩ ⟨s₂, d₂, hz₂⟩
      refine ⟨s₁ * s₂, s₂.1 • d₁ + s₁.1 • d₂, ?_⟩
      change algebraMap R_u K_u (s₁.1 * s₂.1) • (z₁ + z₂) =
        (1 : K_u) ⊗ₜ[R_u] (s₂.1 • d₁ + s₁.1 • d₂)
      rw [map_mul, smul_add, mul_comm (algebraMap R_u K_u s₁.1) (algebraMap R_u K_u s₂.1),
        mul_smul, hz₁]
      rw [mul_comm (algebraMap R_u K_u s₂.1) (algebraMap R_u K_u s₁.1), mul_smul, hz₂]
      have h1 : (algebraMap R_u K_u s₂.1) • ((1 : K_u) ⊗ₜ[R_u] d₁) =
          (1 : K_u) ⊗ₜ[R_u] (s₂.1 • d₁) := by
        change (algebraMap R_u K_u s₂.1 * 1) ⊗ₜ[R_u] d₁ = (1 : K_u) ⊗ₜ[R_u] (s₂.1 • d₁)
        have hs2_eq : algebraMap R_u K_u s₂.1 = s₂.1 • (1 : K_u) := by
          rw [Algebra.smul_def, mul_one]
        rw [mul_one, hs2_eq, TensorProduct.smul_tmul]
      have h2 : (algebraMap R_u K_u s₁.1) • ((1 : K_u) ⊗ₜ[R_u] d₂) =
          (1 : K_u) ⊗ₜ[R_u] (s₁.1 • d₂) := by
        change (algebraMap R_u K_u s₁.1 * 1) ⊗ₜ[R_u] d₂ = (1 : K_u) ⊗ₜ[R_u] (s₁.1 • d₂)
        have hs1_eq : algebraMap R_u K_u s₁.1 = s₁.1 • (1 : K_u) := by
          rw [Algebra.smul_def, mul_one]
        rw [mul_one, hs1_eq, TensorProduct.smul_tmul]
      rw [h1, h2, TensorProduct.tmul_add]

  have hψ_BK_one_tmul : ∀ d : D, ψ_BK ((1 : K_u) ⊗ₜ[R_u] d) = algebraMap D L_D d := by
    intro d
    have h_tmul := Algebra.TensorProduct.lift_tmul
      (Algebra.ofId K_u L_D) algD_LD (fun _ _ => Commute.all _ _) (1 : K_u) d
    change (Algebra.TensorProduct.lift (Algebra.ofId K_u L_D) algD_LD
      (fun _ _ => Commute.all _ _)) ((1 : K_u) ⊗ₜ[R_u] d) = algebraMap D L_D d
    rw [h_tmul, map_one, one_mul]
    rfl

  have hInj_BK : Function.Injective ψ_BK := by
    rw [injective_iff_map_eq_zero]
    intro z hz0
    obtain ⟨s, d, hsd⟩ := hClear_BK z
    have h_map : ψ_BK ((algebraMap R_u K_u s.1) • z) = algebraMap D L_D d := by
      rw [hsd, hψ_BK_one_tmul]
    rw [map_smul, hz0, smul_zero] at h_map
    have hd0 : d = 0 := IsFractionRing.injective D L_D (h_map.symm.trans (map_zero _).symm)
    rw [hd0, TensorProduct.tmul_zero] at hsd
    have hs_ne : algebraMap R_u K_u s.1 ≠ 0 := by
      have hs1_ne : (s.1 : R_u) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      exact fun h0 => hs1_ne (IsFractionRing.injective R_u K_u (h0.trans (map_zero _).symm))
    exact (smul_eq_zero.mp hsd).resolve_left hs_ne

  have _ : IsDomain B_K := Function.Injective.isDomain ψ_BK.toRingHom hInj_BK

  obtain ⟨I, _hFinI, A_fam, instFieldA, instAlgA, e_prod, hFinSep⟩ :=
    (Algebra.Etale.iff_exists_algEquiv_prod K_u B_K).mp inferInstance
  let _ : ∀ i : I, Field (A_fam i) := instFieldA
  let _ : ∀ i : I, Algebra K_u (A_fam i) := instAlgA

  have hNonemptyI : Nonempty I := by
    by_contra hEmpty
    rw [not_nonempty_iff] at hEmpty
    have h10 : (1 : ∀ i : I, A_fam i) = 0 := Subsingleton.elim _ _
    have hB10 : (1 : B_K) = 0 := by
      apply e_prod.injective
      rw [map_one, map_zero]
      exact h10
    exact one_ne_zero hB10
  obtain ⟨i₀⟩ := hNonemptyI

  have hUniqI : ∀ i : I, i = i₀ := by
    intro i
    by_contra hi_ne
    let _ : DecidableEq I := Classical.decEq I
    let u₁ : ∀ j : I, A_fam j := fun j => if j = i₀ then 1 else 0
    let u₂ : ∀ j : I, A_fam j := fun j => if j = i then 1 else 0
    have hu₁_ne : u₁ ≠ 0 := by
      intro h0
      have h_at := congrFun h0 i₀
      simp [u₁] at h_at
    have hu₂_ne : u₂ ≠ 0 := by
      intro h0
      have h_at := congrFun h0 i
      simp [u₂] at h_at
    have h_mul : u₁ * u₂ = 0 := by
      ext j
      change u₁ j * u₂ j = 0
      by_cases hj : j = i₀
      · subst hj
        have hji : j ≠ i := Ne.symm hi_ne
        simp [u₁, u₂, hji]
      · simp [u₁, hj]
    have hB_mul : e_prod.symm u₁ * e_prod.symm u₂ = 0 := by
      rw [← map_mul, h_mul, map_zero]
    rcases mul_eq_zero.mp hB_mul with h1 | h2
    · exact hu₁_ne (e_prod.symm.injective (h1.trans (map_zero _).symm))
    · exact hu₂_ne (e_prod.symm.injective (h2.trans (map_zero _).symm))

  have hTrans_apply : ∀ (f : ∀ j : I, A_fam j) (i : I) (h : i₀ = i),
      (Eq.rec (motive := fun x _ => A_fam x) (f i₀) h : A_fam i) = f i := by
    intro f i h
    cases h
    rfl
  let piEval : (∀ i : I, A_fam i) ≃ₐ[K_u] A_fam i₀ :=
    { toFun := fun f => f i₀
      invFun := fun a i => Eq.rec (motive := fun x _ => A_fam x) a (hUniqI i).symm
      left_inv := fun f => funext fun i => hTrans_apply f i (hUniqI i).symm
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl }
  let e_BA : B_K ≃ₐ[K_u] A_fam i₀ := e_prod.trans piEval

  have hSurj_BK : Function.Surjective ψ_BK := by
    intro x
    obtain ⟨⟨a, t⟩, ht_eq⟩ := IsLocalization.surj (nonZeroDivisors D) x
    have ht_ne : (t.1 : D) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp t.2
    have hLt_ne : algebraMap D L_D t.1 ≠ 0 :=
      fun h0 => ht_ne (IsFractionRing.injective D L_D (h0.trans (map_zero _).symm))
    have hBt_ne : ((1 : K_u) ⊗ₜ[R_u] t.1 : B_K) ≠ 0 := by
      intro h0
      apply hLt_ne
      rw [← hψ_BK_one_tmul t.1, h0, map_zero]
    have hAt_ne : e_BA ((1 : K_u) ⊗ₜ[R_u] t.1) ≠ 0 :=
      fun h0 => hBt_ne (e_BA.injective (h0.trans (map_zero _).symm))
    let w : B_K := e_BA.symm ((e_BA ((1 : K_u) ⊗ₜ[R_u] t.1))⁻¹)
    have htw : ((1 : K_u) ⊗ₜ[R_u] t.1 : B_K) * w = 1 := by
      apply e_BA.injective
      rw [map_mul, e_BA.apply_symm_apply, mul_inv_cancel₀ hAt_ne, map_one]
    refine ⟨((1 : K_u) ⊗ₜ[R_u] a) * w, ?_⟩
    apply mul_right_cancel₀ hLt_ne
    rw [ht_eq, ← hψ_BK_one_tmul t.1, ← map_mul]
    have h_assoc : ((1 : K_u) ⊗ₜ[R_u] a) * w * ((1 : K_u) ⊗ₜ[R_u] t.1) =
        (1 : K_u) ⊗ₜ[R_u] a := by
      rw [mul_assoc, mul_comm w _, htw, mul_one]
    rw [h_assoc, hψ_BK_one_tmul]

  let e_BL : B_K ≃ₐ[K_u] L_D := AlgEquiv.ofBijective ψ_BK ⟨hInj_BK, hSurj_BK⟩
  let e_AL : A_fam i₀ ≃ₐ[K_u] L_D := e_BA.symm.trans e_BL

  have _ : Module.Finite K_u (A_fam i₀) := (hFinSep i₀).1
  have _ : Algebra.IsSeparable K_u (A_fam i₀) := (hFinSep i₀).2
  have _ : FiniteDimensional K_u L_D := Module.Finite.equiv e_AL.toLinearEquiv
  have _ : Algebra.IsSeparable K_u L_D := AlgEquiv.Algebra.isSeparable e_AL

  have hClear : ∀ x : L_D, ∃ r : R_u, r ≠ 0 ∧
      ∃ d : D, ι_KL (algebraMap R_u K_u r) * x = algebraMap D L_D d := by
    intro x
    obtain ⟨z, rfl⟩ := hSurj_BK x
    obtain ⟨s, d, hsd⟩ := hClear_BK z
    refine ⟨s.1, mem_nonZeroDivisors_iff_ne_zero.mp s.2, d, ?_⟩
    have h_ap := congrArg ψ_BK hsd
    rw [map_smul, hψ_BK_one_tmul, Algebra.smul_def] at h_ap
    exact h_ap

  have hAnyFrac : ∀ (F : Type u) [Field F] (φ_D : D →+* F),
      @IsFractionRing D _ F _ φ_D.toAlgebra →
      ∃ (ι_u : K_u →+* F),
        ι_u.comp ((algebraMap R_u K_u).comp Polynomial.C) = φ_D.comp α_D ∧
        (letI : Algebra K_u F := ι_u.toAlgebra
         FiniteDimensional K_u F) := by
    intro F _ φ_D hFracF
    let _ : Algebra D F := φ_D.toAlgebra
    have _ : IsFractionRing D F := hFracF
    let e_LF : L_D ≃ₐ[D] F := IsLocalization.algEquiv (nonZeroDivisors D) L_D F
    let ι_u : K_u →+* F := e_LF.toRingHom.comp ι_KL
    refine ⟨ι_u, ?_, ?_⟩
    · ext c
      change e_LF (ι_KL (algebraMap R_u K_u (Polynomial.C c))) = φ_D (α_D c)
      rw [hι_comm, e_LF.commutes]
      change φ_D (φ_u (Polynomial.C c)) = φ_D (α_D c)
      rw [← RingHom.comp_apply φ_u Polynomial.C c, hφ_C]
    · let _ : Algebra K_u F := ι_u.toAlgebra
      let e_lin : L_D ≃ₗ[K_u] F :=
        { e_LF.toRingEquiv with
          map_smul' := fun k x => by
            change e_LF (ι_KL k * x) = e_LF (ι_KL k) * e_LF x
            exact map_mul e_LF _ _ }
      exact Module.Finite.equiv e_lin

  
  let n : ℕ := Module.finrank K_u L_D
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_ge1 : 1 ≤ n := hn_pos

  obtain ⟨θ₀, hθ₀_gen⟩ := Field.exists_primitive_element K_u L_D
  obtain ⟨s₀, hs₀_ne, d₀, hd₀_eq⟩ := hClear θ₀
  let θ₁ : L_D := algebraMap D L_D d₀
  let u₀ : K_u := algebraMap R_u K_u s₀
  have hu₀_ne : u₀ ≠ 0 :=
    fun h0 => hs₀_ne (IsFractionRing.injective R_u K_u (h0.trans (map_zero _).symm))
  have hθ₁_gen : IntermediateField.adjoin K_u ({θ₁} : Set L_D) = ⊤ := by
    apply top_unique
    rw [← hθ₀_gen, IntermediateField.adjoin_simple_le_iff]
    have hθ₀_eq : θ₀ = algebraMap K_u L_D u₀⁻¹ * θ₁ := by
      have h_inv : algebraMap K_u L_D u₀⁻¹ * algebraMap K_u L_D u₀ = 1 := by
        rw [← map_mul, inv_mul_cancel₀ hu₀_ne, map_one]
      calc
        θ₀ = (algebraMap K_u L_D u₀⁻¹ * algebraMap K_u L_D u₀) * θ₀ := by rw [h_inv, one_mul]
        _ = algebraMap K_u L_D u₀⁻¹ * (ι_KL u₀ * θ₀) := by rw [mul_assoc]; rfl
        _ = algebraMap K_u L_D u₀⁻¹ * θ₁ := by rw [hd₀_eq]
    rw [hθ₀_eq]
    exact mul_mem (IntermediateField.algebraMap_mem _ _)
      (IntermediateField.mem_adjoin_simple_self K_u θ₁)

  have hInt₁ : IsIntegral K_u θ₁ := Algebra.IsIntegral.isIntegral θ₁
  let Q₁ : Polynomial K_u := minpoly K_u θ₁
  have hMon₁ : Q₁.Monic := minpoly.monic hInt₁
  have hQ₁_deg : Q₁.natDegree = n := by
    have h_adjoin_rk : Module.finrank K_u ↥(IntermediateField.adjoin K_u ({θ₁} : Set L_D)) =
        Q₁.natDegree := IntermediateField.adjoin.finrank hInt₁
    rw [← h_adjoin_rk, hθ₁_gen]
    exact IntermediateField.topEquiv.toLinearEquiv.finrank_eq

  have hSurjCoeff₁ : ∀ i : ℕ, ∃ (a : R_u) (b : nonZeroDivisors R_u),
      Q₁.coeff i * algebraMap R_u K_u b.1 = algebraMap R_u K_u a := by
    intro i
    obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors R_u) (Q₁.coeff i)
    exact ⟨a, b, hab⟩
  choose a_c b_c hab_c using hSurjCoeff₁

  let s₁ : R_u := ∏ j ∈ Finset.range n, (b_c j).1
  have hs₁_ne : s₁ ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun j _ => mem_nonZeroDivisors_iff_ne_zero.mp (b_c j).2
  let u₁ : K_u := algebraMap R_u K_u s₁
  have hu₁_ne : u₁ ≠ 0 :=
    fun h0 => hs₁_ne (IsFractionRing.injective R_u K_u (h0.trans (map_zero _).symm))

  let d_θ : D := φ_u s₁ * d₀
  let θ : L_D := algebraMap D L_D d_θ
  have hθ_rel : θ = ι_KL u₁ * θ₁ := by
    change algebraMap D L_D (φ_u s₁ * d₀) = ι_KL (algebraMap R_u K_u s₁) * θ₁
    rw [map_mul, hι_comm]
  have hθ_gen : IntermediateField.adjoin K_u ({θ} : Set L_D) = ⊤ := by
    apply top_unique
    rw [← hθ₁_gen, IntermediateField.adjoin_simple_le_iff]
    have hθ₁_eq : θ₁ = algebraMap K_u L_D u₁⁻¹ * θ := by
      rw [hθ_rel]
      change θ₁ = ι_KL u₁⁻¹ * (ι_KL u₁ * θ₁)
      rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hu₁_ne, map_one, one_mul]
    rw [hθ₁_eq]
    exact mul_mem (IntermediateField.algebraMap_mem _ _)
      (IntermediateField.mem_adjoin_simple_self K_u θ)

  let c_P : ℕ → R_u := fun i =>
    a_c i * (∏ j ∈ (Finset.range n).erase i, (b_c j).1) * s₁ ^ (n - 1 - i)
  let P : Polynomial R_u :=
    Polynomial.X ^ n + ∑ i ∈ Finset.range n, Polynomial.C (c_P i) * Polynomial.X ^ i

  have hP_coeff_gt : ∀ m : ℕ, n < m → P.coeff m = 0 := by
    intro m hm
    have hne_n : m ≠ n := ne_of_gt hm
    simp only [P, Polynomial.coeff_add, Polynomial.coeff_X_pow, hne_n, ↓reduceIte,
      Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow, zero_add]
    refine Finset.sum_eq_zero fun i hi => ?_
    have hi_lt : i < n := Finset.mem_range.mp hi
    have hne_i : m ≠ i := ne_of_gt (lt_trans hi_lt hm)
    simp [hne_i]

  have hP_coeff_n : P.coeff n = 1 := by
    simp only [P, Polynomial.coeff_add, Polynomial.coeff_X_pow, ↓reduceIte,
      Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow]
    have h_sum0 : (∑ i ∈ Finset.range n, if n = i then c_P i else 0) = 0 := by
      refine Finset.sum_eq_zero fun i hi => ?_
      have hne_i : n ≠ i := ne_of_gt (Finset.mem_range.mp hi)
      simp [hne_i]
    rw [h_sum0, add_zero]

  have hP_deg : P.natDegree = n := by
    apply le_antisymm
    · exact Polynomial.natDegree_le_iff_coeff_eq_zero.mpr hP_coeff_gt
    · apply Polynomial.le_natDegree_of_ne_zero
      rw [hP_coeff_n]
      exact one_ne_zero

  have hDeg : 1 ≤ P.natDegree := by
    rw [hP_deg]
    exact hn_ge1

  have hMon : P.Monic := by
    rw [Polynomial.Monic, Polynomial.leadingCoeff, hP_deg]
    exact hP_coeff_n

  have hc_P_map : ∀ i ∈ Finset.range n,
      algebraMap R_u K_u (c_P i) = Q₁.coeff i * u₁ ^ (n - i) := by
    intro i hi
    have hi_lt : i < n := Finset.mem_range.mp hi
    have h_erase : (b_c i).1 * (∏ j ∈ (Finset.range n).erase i, (b_c j).1) = s₁ :=
      Finset.mul_prod_erase (Finset.range n) (fun j => (b_c j).1) hi
    have h_u1_erase : algebraMap R_u K_u (b_c i).1 *
        algebraMap R_u K_u (∏ j ∈ (Finset.range n).erase i, (b_c j).1) = u₁ := by
      rw [← map_mul, h_erase]
    calc
      algebraMap R_u K_u (c_P i)
        = algebraMap R_u K_u (a_c i) *
            algebraMap R_u K_u (∏ j ∈ (Finset.range n).erase i, (b_c j).1) *
            u₁ ^ (n - 1 - i) := by
            simp only [c_P, map_mul, map_pow]; rfl
      _ = (Q₁.coeff i * algebraMap R_u K_u (b_c i).1) *
            algebraMap R_u K_u (∏ j ∈ (Finset.range n).erase i, (b_c j).1) *
            u₁ ^ (n - 1 - i) := by
            rw [← hab_c i]
      _ = Q₁.coeff i * (u₁ * u₁ ^ (n - 1 - i)) := by
            rw [mul_assoc (Q₁.coeff i), h_u1_erase, mul_assoc]
      _ = Q₁.coeff i * u₁ ^ (n - i) := by
            congr 1
            have hexp : n - 1 - i + 1 = n - i := by omega
            rw [← pow_succ', hexp]

  let P_K : Polynomial K_u := P.map (algebraMap R_u K_u)
  have hQ₁_expand : Q₁ =
      Polynomial.X ^ n + ∑ i ∈ Finset.range n, Polynomial.C (Q₁.coeff i) * Polynomial.X ^ i := by
    have h1 := Polynomial.as_sum_range_C_mul_X_pow Q₁
    rw [hQ₁_deg, Finset.sum_range_succ] at h1
    have h_lead : Q₁.coeff n = 1 := by
      rw [← hQ₁_deg]
      exact hMon₁
    rw [h_lead, map_one, one_mul, add_comm] at h1
    exact h1

  have hP_K_aeval : Polynomial.aeval θ P_K = 0 := by
    have hP_K_eq : P_K = Polynomial.X ^ n +
        ∑ i ∈ Finset.range n,
          Polynomial.C (algebraMap R_u K_u (c_P i)) * Polynomial.X ^ i := by
      simp [P_K, P, Polynomial.map_add, Polynomial.map_pow, Polynomial.map_sum]
    rw [hP_K_eq, map_add, map_pow, Polynomial.aeval_X, map_sum]
    have h_sum_eq :
        (∑ i ∈ Finset.range n,
          (Polynomial.aeval θ) (Polynomial.C (algebraMap R_u K_u (c_P i)) * Polynomial.X ^ i)) =
        ∑ i ∈ Finset.range n,
          (ι_KL u₁) ^ n * (ι_KL (Q₁.coeff i) * θ₁ ^ i) := by
      refine Finset.sum_congr rfl fun i hi => ?_
      have hi_le : i ≤ n := le_of_lt (Finset.mem_range.mp hi)
      rw [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X, hc_P_map i hi, hθ_rel]
      change ι_KL (Q₁.coeff i * u₁ ^ (n - i)) * (ι_KL u₁ * θ₁) ^ i =
        (ι_KL u₁) ^ n * (ι_KL (Q₁.coeff i) * θ₁ ^ i)
      rw [map_mul, map_pow, mul_pow]
      have hu_pow : (ι_KL u₁) ^ (n - i) * (ι_KL u₁) ^ i = (ι_KL u₁) ^ n := by
        rw [← pow_add, Nat.sub_add_cancel hi_le]
      calc
        ι_KL (Q₁.coeff i) * (ι_KL u₁) ^ (n - i) * ((ι_KL u₁) ^ i * θ₁ ^ i)
          = ((ι_KL u₁) ^ (n - i) * (ι_KL u₁) ^ i) * (ι_KL (Q₁.coeff i) * θ₁ ^ i) := by ring
        _ = (ι_KL u₁) ^ n * (ι_KL (Q₁.coeff i) * θ₁ ^ i) := by rw [hu_pow]
    rw [h_sum_eq, ← Finset.mul_sum, hθ_rel, mul_pow, ← mul_add]
    have hQ₁_zero : θ₁ ^ n + ∑ i ∈ Finset.range n, ι_KL (Q₁.coeff i) * θ₁ ^ i = 0 := by
      have h0 : Polynomial.aeval θ₁ Q₁ = 0 := minpoly.aeval K_u θ₁
      rw [hQ₁_expand, map_add, map_pow, Polynomial.aeval_X, map_sum] at h0
      have h_s : (∑ i ∈ Finset.range n,
          (Polynomial.aeval θ₁) (Polynomial.C (Q₁.coeff i) * Polynomial.X ^ i)) =
          ∑ i ∈ Finset.range n, ι_KL (Q₁.coeff i) * θ₁ ^ i := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X]
        rfl
      rw [h_s] at h0
      exact h0
    rw [hQ₁_zero, mul_zero]

  have hInt_θ : IsIntegral K_u θ := Algebra.IsIntegral.isIntegral θ
  have hMin_θ_deg : (minpoly K_u θ).natDegree = n := by
    rw [← IntermediateField.adjoin.finrank hInt_θ, hθ_gen]
    exact IntermediateField.topEquiv.toLinearEquiv.finrank_eq

  have hP_K_eq_min : P_K = minpoly K_u θ := by
    obtain ⟨R_rem, hR_eq⟩ := minpoly.dvd K_u θ hP_K_aeval
    have hMon_PK : P_K.Monic := hMon.map (algebraMap R_u K_u)
    have hDeg_PK : P_K.natDegree = n := by
      rw [hMon.natDegree_map (algebraMap R_u K_u), hP_deg]
    have hMon_min : (minpoly K_u θ).Monic := minpoly.monic hInt_θ
    have hMon_prod : ((minpoly K_u θ) * R_rem).Monic := by
      rw [← hR_eq]
      exact hMon_PK
    have hMon_rem : R_rem.Monic := Polynomial.Monic.of_mul_monic_left hMon_min hMon_prod
    have hDeg_sum : P_K.natDegree = (minpoly K_u θ).natDegree + R_rem.natDegree := by
      rw [hR_eq, Polynomial.natDegree_mul hMon_min.ne_zero hMon_rem.ne_zero]
    have hDeg_rem : R_rem.natDegree = 0 := by omega
    have hR_one : R_rem = 1 := Polynomial.eq_one_of_monic_natDegree_zero hMon_rem hDeg_rem
    rw [hR_eq, hR_one, mul_one]

  have hIrred : Irreducible P := by
    have hIrred_PK : Irreducible P_K := by
      rw [hP_K_eq_min]
      exact minpoly.irreducible hInt_θ
    exact Polynomial.Monic.irreducible_of_irreducible_map (algebraMap R_u K_u) P hMon hIrred_PK

  have hEval_to_aeval : ∀ f : Polynomial R_u,
      algebraMap D L_D (Polynomial.eval₂RingHom φ_u d_θ f) =
        Polynomial.aeval θ (f.map (algebraMap R_u K_u)) := by
    have hHomEq :
        (algebraMap D L_D).comp (Polynomial.eval₂RingHom φ_u d_θ) =
          (Polynomial.aeval θ).toRingHom.comp (Polynomial.mapRingHom (algebraMap R_u K_u)) := by
      apply Polynomial.ringHom_ext
      · intro r
        change algebraMap D L_D (Polynomial.eval₂ φ_u d_θ (Polynomial.C r)) =
          Polynomial.aeval θ ((Polynomial.C r).map (algebraMap R_u K_u))
        rw [Polynomial.eval₂_C, Polynomial.map_C, Polynomial.aeval_C]
        exact (hι_comm r).symm
      · change algebraMap D L_D (Polynomial.eval₂ φ_u d_θ Polynomial.X) =
          Polynomial.aeval θ (Polynomial.X.map (algebraMap R_u K_u))
        rw [Polynomial.eval₂_X, Polynomial.map_X, Polynomial.aeval_X]
    exact fun f => RingHom.congr_fun hHomEq f

  have hEval_P : Polynomial.eval₂RingHom φ_u d_θ P = 0 := by
    apply IsFractionRing.injective D L_D
    rw [map_zero, hEval_to_aeval P]
    exact hP_K_aeval

  obtain ⟨P₀, hP₀_eq⟩ : ∃ P₀ : Polynomial R_u, P₀ = P := ⟨P, rfl⟩
  have hMon₀ : P₀.Monic := hP₀_eq ▸ hMon
  have hDeg₀ : 1 ≤ P₀.natDegree := hP₀_eq ▸ hDeg
  have hIrred₀ : Irreducible P₀ := hP₀_eq ▸ hIrred
  let P₀_K : Polynomial K_u := P₀.map (algebraMap R_u K_u)
  have hP₀_K_eq_min : P₀_K = minpoly K_u θ := by
    dsimp only [P₀_K]
    rw [hP₀_eq]
    exact hP_K_eq_min
  have hEval_P₀ : Polynomial.eval₂RingHom φ_u d_θ P₀ = 0 := by
    rw [hP₀_eq]
    exact hEval_P
  clear hP₀_eq

  let I_P : Ideal (Polynomial R_u) := Ideal.span ({P₀} : Set (Polynomial R_u))
  let Q : Type u := Polynomial R_u ⧸ I_P
  have hEval_I_P : ∀ a ∈ I_P, Polynomial.eval₂RingHom φ_u d_θ a = 0 := by
    intro a ha
    obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton.mp ha
    rw [map_mul, hEval_P₀, zero_mul]
  let Ψ : Q →+* D := Ideal.Quotient.lift I_P (Polynomial.eval₂RingHom φ_u d_θ) hEval_I_P

  have hInj_Ψ : Function.Injective Ψ := by
    rw [injective_iff_map_eq_zero]
    intro q₀ hq₀
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective q₀
    have hf_eval : Polynomial.eval₂RingHom φ_u d_θ f = 0 := hq₀
    let rem : Polynomial R_u := f %ₘ P₀
    have h_div : rem + P₀ * (f /ₘ P₀) = f := Polynomial.modByMonic_add_div f P₀
    have hrem_eval : Polynomial.eval₂RingHom φ_u d_θ rem = 0 := by
      have h_ap := congrArg (Polynomial.eval₂RingHom φ_u d_θ) h_div
      rw [map_add, map_mul, hEval_P₀, zero_mul, add_zero, hf_eval] at h_ap
      exact h_ap
    have hrem_aeval : Polynomial.aeval θ (rem.map (algebraMap R_u K_u)) = 0 := by
      rw [← hEval_to_aeval rem, hrem_eval, map_zero]
    have hrem_dvd : P₀_K ∣ rem.map (algebraMap R_u K_u) := by
      rw [hP₀_K_eq_min]
      exact minpoly.dvd K_u θ hrem_aeval
    have hrem_deg_lt : (rem.map (algebraMap R_u K_u)).degree < P₀_K.degree := by
      calc
        (rem.map (algebraMap R_u K_u)).degree ≤ rem.degree := Polynomial.degree_map_le
        _ < P₀.degree := Polynomial.degree_modByMonic_lt f hMon₀
        _ = P₀_K.degree := (hMon₀.degree_map (algebraMap R_u K_u)).symm
    have hrem_map_zero : rem.map (algebraMap R_u K_u) = 0 :=
      Polynomial.eq_zero_of_dvd_of_degree_lt hrem_dvd hrem_deg_lt
    have hrem_zero : rem = 0 :=
      Polynomial.map_injective (algebraMap R_u K_u) (IsFractionRing.injective R_u K_u)
        (hrem_map_zero.trans (Polynomial.map_zero _).symm)
    rw [hrem_zero, zero_add] at h_div
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton.mpr ⟨f /ₘ P₀, h_div.symm⟩

  
  let ι_R : R_u →+* Q := (Ideal.Quotient.mk I_P).comp Polynomial.C
  let q_θ : Q := Ideal.Quotient.mk I_P Polynomial.X
  have hΨ_ιR : ∀ r : R_u, Ψ (ι_R r) = φ_u r := fun r => by
    change Ideal.Quotient.lift I_P (Polynomial.eval₂RingHom φ_u d_θ) hEval_I_P
      (Ideal.Quotient.mk I_P (Polynomial.C r)) = φ_u r
    rw [Ideal.Quotient.lift_mk, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
  have hΨ_qθ : Ψ q_θ = d_θ := by
    change Ideal.Quotient.lift I_P (Polynomial.eval₂RingHom φ_u d_θ) hEval_I_P
      (Ideal.Quotient.mk I_P Polynomial.X) = d_θ
    rw [Ideal.Quotient.lift_mk, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]

  have hAlg_θ : IsAlgebraic K_u θ := Algebra.IsAlgebraic.isAlgebraic θ
  have hClearD : ∀ y : D, ∃ (β : R_u) (q : Q), β ≠ 0 ∧ φ_u β * y = Ψ q := by
    intro y
    have hy_mem : algebraMap D L_D y ∈ (Polynomial.aeval (R := K_u) θ).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval K_u θ,
        ← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hAlg_θ, hθ_gen]
      trivial
    obtain ⟨G, hG_eq⟩ := hy_mem
    let m : ℕ := G.natDegree + 1
    have hG_expand : G =
        ∑ j ∈ Finset.range m, Polynomial.C (G.coeff j) * Polynomial.X ^ j :=
      Polynomial.as_sum_range_C_mul_X_pow G
    have hSurjG : ∀ j : ℕ, ∃ (u_j : R_u) (v_j : nonZeroDivisors R_u),
        G.coeff j * algebraMap R_u K_u v_j.1 = algebraMap R_u K_u u_j := by
      intro j
      obtain ⟨⟨u_j, v_j⟩, huv⟩ := IsLocalization.surj (nonZeroDivisors R_u) (G.coeff j)
      exact ⟨u_j, v_j, huv⟩
    choose u_G v_G huv_G using hSurjG
    let β : R_u := ∏ k ∈ Finset.range m, (v_G k).1
    have hβ_ne : β ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr fun k _ => mem_nonZeroDivisors_iff_ne_zero.mp (v_G k).2
    let q : Q := ∑ j ∈ Finset.range m,
      ι_R (u_G j * ∏ k ∈ (Finset.range m).erase j, (v_G k).1) * q_θ ^ j
    refine ⟨β, q, hβ_ne, ?_⟩
    have hG_eq' : (Polynomial.aeval (R := K_u) θ) G = algebraMap D L_D y := hG_eq
    have hG_aeval : (Polynomial.aeval (R := K_u) θ) G =
        ∑ j ∈ Finset.range m, ι_KL (G.coeff j) * θ ^ j := by
      conv_lhs => rw [hG_expand]
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X]
      rfl
    have hΨq : algebraMap D L_D (Ψ q) =
        ∑ j ∈ Finset.range m,
          ι_KL (algebraMap R_u K_u β) * (ι_KL (G.coeff j) * θ ^ j) := by
      simp only [q, map_sum, map_mul, map_pow, hΨ_ιR, hΨ_qθ, ← hι_comm]
      refine Finset.sum_congr rfl fun j hj => ?_
      have h_er : (v_G j).1 * (∏ k ∈ (Finset.range m).erase j, (v_G k).1) = β :=
        Finset.mul_prod_erase (Finset.range m) (fun k => (v_G k).1) hj
      have h_coeff_β : algebraMap R_u K_u (u_G j * ∏ k ∈ (Finset.range m).erase j, (v_G k).1) =
          algebraMap R_u K_u β * G.coeff j := by
        rw [map_mul, ← huv_G j, mul_assoc, ← map_mul, h_er, mul_comm]
      rw [← map_mul ι_KL, ← map_mul (algebraMap R_u K_u), h_coeff_β, map_mul ι_KL]
      change (ι_KL (algebraMap R_u K_u β) * ι_KL (G.coeff j)) * θ ^ j =
        ι_KL (algebraMap R_u K_u β) * (ι_KL (G.coeff j) * θ ^ j)
      rw [mul_assoc]
    apply IsFractionRing.injective D L_D
    rw [map_mul, ← hι_comm β, ← hG_eq', hΨq, ← Finset.mul_sum, hG_aeval]

  choose β_fn q_fn hβ_fn_ne hβ_fn_eq using hClearD
  obtain ⟨S_gen, hS_gen⟩ := hFT_D.out
  let _ : DecidableEq D := Classical.decEq D
  let h_u : R_u := ∏ y ∈ S_gen, β_fn y
  have hh_u_ne : h_u ≠ 0 := Finset.prod_ne_zero_iff.mpr fun y _ => hβ_fn_ne y
  let g₀ : Q := ι_R h_u
  let h_D : D := Ψ g₀
  have hh_D_eq : h_D = φ_u h_u := hΨ_ιR h_u
  have hh_D_ne : h_D ≠ 0 := by
    rw [hh_D_eq]
    exact fun h0 => hh_u_ne (hInj_φ (h0.trans (map_zero φ_u).symm))

  let mapQ_W := @algebraMap Q (Localization.Away g₀) inferInstance CommSemiring.toSemiring inferInstance
  let Ψ_loc : Localization.Away g₀ →+* Localization.Away h_D :=
    IsLocalization.Away.map (Localization.Away g₀) (Localization.Away h_D) Ψ g₀
  have hΨ_loc_eq : ∀ q : Q,
      Ψ_loc (mapQ_W q) =
        algebraMap D (Localization.Away h_D) (Ψ q) :=
    fun q => IsLocalization.map_eq _ q

  have hInj_loc : Function.Injective Ψ_loc := by
    rw [injective_iff_map_eq_zero]
    intro z hz0
    obtain ⟨⟨q, p⟩, hp_eq⟩ := IsLocalization.surj (Submonoid.powers g₀) z
    have h_ap := congrArg Ψ_loc hp_eq
    rw [map_mul, hz0, zero_mul, hΨ_loc_eq] at h_ap
    have hPow_le : Submonoid.powers h_D ≤ nonZeroDivisors D := by
      rintro _ ⟨k, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hh_D_ne)
    have hΨq_zero : Ψ q = 0 :=
      IsLocalization.injective (Localization.Away h_D) hPow_le
        (h_ap.symm.trans (map_zero _).symm)
    have hq_zero : q = 0 := hInj_Ψ (hΨq_zero.trans (map_zero Ψ).symm)
    rw [hq_zero, map_zero] at hp_eq
    exact (IsLocalization.map_units (Localization.Away g₀) p).mul_left_eq_zero.mp hp_eq

  have hInv_map : Ψ_loc (IsLocalization.Away.invSelf g₀) = IsLocalization.Away.invSelf h_D := by
    have h1 : algebraMap D (Localization.Away h_D) h_D *
        Ψ_loc (IsLocalization.Away.invSelf g₀) = 1 := by
      rw [← hΨ_loc_eq g₀, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
    have h2 : IsLocalization.Away.invSelf h_D * algebraMap D (Localization.Away h_D) h_D = 1 := by
      rw [mul_comm, IsLocalization.Away.mul_invSelf]
    calc
      Ψ_loc (IsLocalization.Away.invSelf g₀)
        = (IsLocalization.Away.invSelf h_D * algebraMap D (Localization.Away h_D) h_D) *
            Ψ_loc (IsLocalization.Away.invSelf g₀) := by rw [h2, one_mul]
      _ = IsLocalization.Away.invSelf h_D *
            (algebraMap D (Localization.Away h_D) h_D *
              Ψ_loc (IsLocalization.Away.invSelf g₀)) := by rw [mul_assoc]
      _ = IsLocalization.Away.invSelf h_D := by rw [h1, mul_one]

  have hD_in_range : ∀ x : D, algebraMap D (Localization.Away h_D) x ∈ Set.range Ψ_loc := by
    intro x
    have hx_mem : x ∈ Algebra.adjoin R_u (↑S_gen : Set D) := by
      rw [hS_gen]
      trivial
    refine Algebra.adjoin_induction
      (p := fun x _ => algebraMap D (Localization.Away h_D) x ∈ Set.range Ψ_loc) ?_ ?_ ?_ ?_ hx_mem
    · intro y hy
      have hy_fin : y ∈ S_gen := Finset.mem_coe.mp hy
      let γ_y : R_u := ∏ z ∈ S_gen.erase y, β_fn z
      have h_prod : β_fn y * γ_y = h_u := Finset.mul_prod_erase S_gen β_fn hy_fin
      have hhD_y : h_D * y = Ψ (ι_R γ_y * q_fn y) := by
        calc
          h_D * y = φ_u (β_fn y * γ_y) * y := by rw [hh_D_eq, h_prod]
          _ = φ_u γ_y * (φ_u (β_fn y) * y) := by rw [map_mul]; ring
          _ = Ψ (ι_R γ_y) * Ψ (q_fn y) := by rw [hΨ_ιR, hβ_fn_eq]
          _ = Ψ (ι_R γ_y * q_fn y) := (map_mul Ψ _ _).symm
      let a_y : Localization.Away g₀ := mapQ_W (ι_R γ_y * q_fn y)
      let inv_g₀ : Localization.Away g₀ :=
        IsLocalization.Away.invSelf (S := Localization.Away g₀) g₀
      refine ⟨a_y * inv_g₀, ?_⟩
      change Ψ_loc (mapQ_W (ι_R γ_y * q_fn y) *
        IsLocalization.Away.invSelf g₀) = algebraMap D (Localization.Away h_D) y
      rw [map_mul, hΨ_loc_eq, hInv_map, ← hhD_y, map_mul, mul_assoc,
        mul_comm _ (IsLocalization.Away.invSelf h_D),
        ← mul_assoc, IsLocalization.Away.mul_invSelf, one_mul]
    · intro r
      refine ⟨mapQ_W (ι_R r), ?_⟩
      rw [hΨ_loc_eq, hΨ_ιR]
      rfl
    · rintro x₁ x₂ _ _ ⟨a₁, ha₁⟩ ⟨a₂, ha₂⟩
      exact ⟨a₁ + a₂, by rw [map_add, ha₁, ha₂, map_add]⟩
    · rintro x₁ x₂ _ _ ⟨a₁, ha₁⟩ ⟨a₂, ha₂⟩
      exact ⟨a₁ * a₂, by rw [map_mul, ha₁, ha₂, map_mul]⟩

  have hSurj_loc : Function.Surjective Ψ_loc := by
    intro w
    obtain ⟨⟨x, p⟩, hp_eq⟩ := IsLocalization.surj (Submonoid.powers h_D) w
    obtain ⟨k, hk⟩ := p.2
    obtain ⟨a_x, ha_x⟩ := hD_in_range x
    refine ⟨a_x * (IsLocalization.Away.invSelf (S := Localization.Away g₀) g₀) ^ k, ?_⟩
    rw [map_mul, map_pow, ha_x, hInv_map]
    have h_pow_inv : algebraMap D (Localization.Away h_D) (h_D ^ k) *
        (IsLocalization.Away.invSelf h_D) ^ k = 1 := by
      rw [map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
    calc
      algebraMap D (Localization.Away h_D) x * (IsLocalization.Away.invSelf h_D) ^ k
        = (w * algebraMap D (Localization.Away h_D) p.1) *
            (IsLocalization.Away.invSelf h_D) ^ k := by rw [hp_eq]
      _ = w * (algebraMap D (Localization.Away h_D) (h_D ^ k) *
            (IsLocalization.Away.invSelf h_D) ^ k) := by rw [← hk, mul_assoc]
      _ = w := by rw [h_pow_inv, mul_one]

  let e_loc : Localization.Away g₀ ≃+* Localization.Away h_D :=
    RingEquiv.ofBijective Ψ_loc ⟨hInj_loc, hSurj_loc⟩

  
  let ι_C : Ω →+* Q := ι_R.comp Polynomial.C
  let α_W : Ω →+* Localization.Away g₀ :=
    { toFun := fun c => mapQ_W (ι_C c)
      map_one' := by
        have h1 : ι_C 1 = 1 := ι_C.map_one
        exact (congrArg mapQ_W h1).trans mapQ_W.map_one
      map_mul' := fun x y => by
        have hm : ι_C (x * y) = ι_C x * ι_C y := ι_C.map_mul x y
        exact (congrArg mapQ_W hm).trans (mapQ_W.map_mul (ι_C x) (ι_C y))
      map_zero' := by
        have h0 : ι_C 0 = 0 := ι_C.map_zero
        exact (congrArg mapQ_W h0).trans mapQ_W.map_zero
      map_add' := fun x y => by
        have ha : ι_C (x + y) = ι_C x + ι_C y := ι_C.map_add x y
        exact (congrArg mapQ_W ha).trans (mapQ_W.map_add (ι_C x) (ι_C y)) }

  have hα_W : ∀ c : Ω, α_W c =
      Localization.mk (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1 := by
    intro c
    exact (Localization.mk_one_eq_algebraMap
      (Ideal.Quotient.mk I_P (Polynomial.C (Polynomial.C c)))).symm

  have he_comp : e_loc.toRingHom.comp α_W = (algebraMap D (Localization.Away h_D)).comp α_D := by
    ext c
    change Ψ_loc (mapQ_W (ι_R (Polynomial.C c))) =
      algebraMap D (Localization.Away h_D) (α_D c)
    rw [hΨ_loc_eq, hΨ_ιR]
    change algebraMap D (Localization.Away h_D) ((φ_u.comp Polynomial.C) c) = _
    rw [hφ_C]

  have hex_a₀ : ∃ a₀ : Ω, Polynomial.eval a₀ h_u ≠ 0 := by
    by_contra! hAll
    exact hh_u_ne (Polynomial.zero_of_eval_zero h_u hAll)
  obtain ⟨a₀, ha₀⟩ := hex_a₀

  let P_a₀ : Polynomial Ω := P₀.map (Polynomial.evalRingHom a₀)
  have hPa₀_deg : P_a₀.degree ≠ 0 := by
    have h_ndeg : 0 < P_a₀.natDegree := by
      have h_eq : P_a₀.natDegree = P₀.natDegree := hMon₀.natDegree_map (Polynomial.evalRingHom a₀)
      omega
    exact ne_of_gt (Polynomial.natDegree_pos_iff_degree_pos.mp h_ndeg)

  obtain ⟨b₀, hb₀⟩ := IsAlgClosed.exists_root P_a₀ hPa₀_deg
  let ev_00 : Polynomial R_u →+* Ω :=
    Polynomial.eval₂RingHom (Polynomial.evalRingHom a₀) b₀
  have hev_P : ev_00 P₀ = 0 := by
    have h_em : Polynomial.eval b₀ P_a₀ = ev_00 P₀ :=
      Polynomial.eval_map (Polynomial.evalRingHom a₀) b₀
    rw [← h_em]
    exact hb₀

  have hev_I_P : ∀ a ∈ I_P, ev_00 a = 0 := by
    intro a ha
    obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton.mp ha
    rw [map_mul, hev_P, zero_mul]
  let ev_Q : Q →+* Ω := Ideal.Quotient.lift I_P ev_00 hev_I_P
  have hev_g₀ : ev_Q g₀ ≠ 0 := by
    have hg₀_eq : ev_Q g₀ = Polynomial.eval a₀ h_u := by
      change Ideal.Quotient.lift I_P ev_00 hev_I_P (Ideal.Quotient.mk I_P (Polynomial.C h_u)) =
        Polynomial.eval a₀ h_u
      rw [Ideal.Quotient.lift_mk]
      change Polynomial.eval₂ (Polynomial.evalRingHom a₀) b₀ (Polynomial.C h_u) = _
      rw [Polynomial.eval₂_C]
      rfl
    rw [hg₀_eq]
    exact ha₀
  have hg₀_unit : IsUnit (ev_Q g₀) := Ne.isUnit hev_g₀

  let ev_W : Localization.Away g₀ →+* Ω := IsLocalization.Away.lift g₀ hg₀_unit
  have hev_comp : ev_W.comp α_W = RingHom.id Ω := by
    ext c
    change ev_W (mapQ_W (ι_R (Polynomial.C c))) = c
    rw [IsLocalization.Away.lift_eq]
    change Ideal.Quotient.lift I_P ev_00 hev_I_P
      (Ideal.Quotient.mk I_P (Polynomial.C (Polynomial.C c))) = c
    rw [Ideal.Quotient.lift_mk]
    change Polynomial.eval₂ (Polynomial.evalRingHom a₀) b₀ (Polynomial.C (Polynomial.C c)) = c
    rw [Polynomial.eval₂_C]
    exact Polynomial.eval_C

  exact ⟨P₀, g₀, α_W, h_D, e_loc, ev_W,
    hMon₀, hDeg₀, hIrred₀, hα_W, hh_D_ne, he_comp, hev_comp, hAnyFrac⟩

theorem weil_algClosed_trdeg_one_domain_zeroLocus_finite_eval (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (F : Type u) [Field F]
    (ι_u : FractionRing (Polynomial Ω) →+* F) :
    (letI : Algebra (FractionRing (Polynomial Ω)) F := ι_u.toAlgebra
     FiniteDimensional (FractionRing (Polynomial Ω)) F) →
    ∀ (D : Type u) [CommRing D] [IsDomain D]
      (α_D : Ω →+* D) (φ_D : D →+* F),
      (letI : Algebra Ω D := α_D.toAlgebra; Algebra.FiniteType Ω D) →
      Function.Injective φ_D →
      φ_D.comp α_D =
        ι_u.comp ((algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω))).comp Polynomial.C) →
      ∀ (f : D), f ≠ 0 →
        ∃ (m : ℕ) (ev : Fin m → (D →+* Ω)),
          (∀ i : Fin m, (ev i).comp α_D = RingHom.id Ω) ∧
          (∀ q : PrimeSpectrum D, f ∈ q.asIdeal →
            ∃ i : Fin m, q.asIdeal = RingHom.ker (ev i)) :=
by
  intro hFinDim D _ _ α_D φ_D hFT hInj hComp f hf
  
  let R_u : Type u := Polynomial Ω
  let K_u : Type u := FractionRing R_u
  let _ : Algebra K_u F := ι_u.toAlgebra
  have _ : FiniteDimensional K_u F := hFinDim
  let _ : Algebra Ω F :=
    (ι_u.comp ((algebraMap R_u K_u).comp Polynomial.C)).toAlgebra
  let _ : Algebra Ω D := α_D.toAlgebra
  have _ : Algebra.FiniteType Ω D := hFT
  have _ : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing Ω D
  have halg_ΩKu : algebraMap Ω K_u = (algebraMap R_u K_u).comp Polynomial.C := by
    rw [IsScalarTower.algebraMap_eq Ω R_u K_u, Polynomial.algebraMap_eq]
  have _ : IsScalarTower Ω K_u F := IsScalarTower.of_algebraMap_eq' (by
    change ι_u.comp ((algebraMap R_u K_u).comp Polynomial.C) = ι_u.comp (algebraMap Ω K_u)
    rw [halg_ΩKu])
  have _ : FaithfulSMul Ω R_u :=
    (faithfulSMul_iff_algebraMap_injective Ω R_u).mpr (RingHom.injective _)
  have _ : FaithfulSMul R_u K_u :=
    (faithfulSMul_iff_algebraMap_injective R_u K_u).mpr (IsFractionRing.injective R_u K_u)
  have _ : FaithfulSMul Ω K_u :=
    (faithfulSMul_iff_algebraMap_injective Ω K_u).mpr (RingHom.injective _)
  have _ : FaithfulSMul K_u F :=
    (faithfulSMul_iff_algebraMap_injective K_u F).mpr (RingHom.injective _)
  have _ : Algebra.IsAlgebraic R_u K_u := IsLocalization.isAlgebraic K_u (nonZeroDivisors R_u)
  have _ : Algebra.IsAlgebraic K_u F := Algebra.IsAlgebraic.of_finite K_u F
  have hTr_ΩKu : Algebra.trdeg Ω K_u = 1 := by
    rw [← trdeg_add_eq Ω R_u (A := K_u), Polynomial.trdeg_of_isDomain (R := Ω),
      trdeg_eq_zero (R := R_u) (A := K_u), add_zero]
  have hTrLe : Algebra.trdeg Ω F ≤ 1 := by
    have hTr_ΩF : Algebra.trdeg Ω F = 1 := by
      rw [← trdeg_add_eq Ω K_u (A := F), hTr_ΩKu, trdeg_eq_zero (R := K_u) (A := F), add_zero]
    exact le_of_eq hTr_ΩF
  let φ_alg : D →ₐ[Ω] F :=
    { φ_D with commutes' := fun c => RingHom.congr_fun hComp c }

  
  have hPrimePkg : ∀ (P : Ideal D), P.IsPrime → P ≠ ⊥ →
      P.IsMaximal ∧ ∃ (ev : D →+* Ω), ev.comp α_D = RingHom.id Ω ∧ RingHom.ker ev = P := by
    intro P hPrime hNeBot
    have _ : P.IsPrime := hPrime
    have _ : IsDomain (D ⧸ P) := Ideal.Quotient.isDomain P
    obtain ⟨y, hyP, hy0⟩ := (Submodule.ne_bot_iff P).mp hNeBot
    let π_P : D →ₐ[Ω] D ⧸ P := Ideal.Quotient.mkₐ Ω P
    let π_hom : D →+* D ⧸ P := Ideal.Quotient.mk P
    have hy_quot_hom : π_hom y = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hyP
    have hAllAlg : ∀ z : D ⧸ P, IsAlgebraic Ω z := by
      intro z
      obtain ⟨x, hx_z⟩ := Ideal.Quotient.mk_surjective (I := P) z
      have hx_z' : π_P x = z := hx_z
      by_cases hx : IsAlgebraic Ω (φ_alg x)
      · obtain ⟨p, hp0, hp_eval⟩ := hx
        have h_aeval_D : Polynomial.aeval x p = 0 := by
          apply hInj
          change φ_alg (Polynomial.aeval x p) = φ_alg 0
          rw [map_zero, ← Polynomial.aeval_algHom_apply, hp_eval]
        refine ⟨p, hp0, ?_⟩
        rw [← hx_z', Polynomial.aeval_algHom_apply, h_aeval_D, map_zero]
      · let v : PUnit.{u + 1} → F := fun _ => φ_alg x
        have hv_ind : AlgebraicIndependent Ω v :=
          algebraicIndependent_unique_type_iff.mpr hx
        have hv_basis : IsTranscendenceBasis Ω v :=
          hv_ind.isTranscendenceBasis_of_trdeg_le_of_finite (by
            rw [Cardinal.mk_punit]
            exact hTrLe)
        let S_x : Subalgebra Ω F := Algebra.adjoin Ω (Set.range v)
        have hAlg_Sx : Algebra.IsAlgebraic ↥S_x F := hv_basis.isAlgebraic
        obtain ⟨P_S, hPS_ne, hPS_eval⟩ :=
          (Algebra.isAlgebraic_def (R := ↥S_x) (A := F)).mp hAlg_Sx (φ_alg y)
        let x_S : ↥S_x := ⟨φ_alg x, Algebra.subset_adjoin ⟨PUnit.unit, rfl⟩⟩
        let ψ_x : Polynomial Ω →ₐ[Ω] ↥S_x := Polynomial.aeval x_S
        have hψ_comp : S_x.val.comp ψ_x = Polynomial.aeval (R := Ω) (φ_alg x) := by
          apply Polynomial.algHom_ext
          simp [ψ_x, x_S]
        have hInj_x : Function.Injective ψ_x := by
          have hInj_F : Function.Injective (Polynomial.aeval (R := Ω) (φ_alg x)) :=
            (transcendental_iff_injective (R := Ω) (A := F) (x := φ_alg x)).mp hx
          refine Function.Injective.of_comp (f := S_x.val) ?_
          change Function.Injective (S_x.val.comp ψ_x)
          rw [hψ_comp]
          exact hInj_F
        have hSurj_x : Function.Surjective ψ_x := by
          rintro ⟨a, ha⟩
          refine Algebra.adjoin_induction
            (p := fun a ha => ∃ q : Polynomial Ω, ψ_x q = ⟨a, ha⟩)
            ?_ ?_ ?_ ?_ ha
          · rintro b ⟨⟨⟩, rfl⟩
            exact ⟨Polynomial.X, by ext; simp [ψ_x, x_S, v]⟩
          · intro c
            exact ⟨Polynomial.C c, by ext; simp [ψ_x]⟩
          · rintro a₁ a₂ ha₁ ha₂ ⟨q₁, hq₁⟩ ⟨q₂, hq₂⟩
            refine ⟨q₁ + q₂, ?_⟩
            rw [map_add, hq₁, hq₂]
            rfl
          · rintro a₁ a₂ ha₁ ha₂ ⟨q₁, hq₁⟩ ⟨q₂, hq₂⟩
            refine ⟨q₁ * q₂, ?_⟩
            rw [map_mul, hq₁, hq₂]
            rfl
        let e_x : Polynomial Ω ≃ₐ[Ω] ↥S_x := AlgEquiv.ofBijective ψ_x ⟨hInj_x, hSurj_x⟩
        let Φ : Polynomial (Polynomial Ω) := Polynomial.map e_x.symm.toRingHom P_S
        have hΦ_ne : Φ ≠ 0 := by
          intro hΦ0
          apply hPS_ne
          apply Polynomial.map_injective e_x.symm.toRingHom e_x.symm.injective
          simpa [Φ] using hΦ0
        let ev_x : Polynomial Ω →+* D := (Polynomial.aeval x).toRingHom
        have hφ_ev_symm :
            (φ_D.comp ev_x).comp e_x.symm.toRingHom = S_x.val.toRingHom :=
          RingHom.ext fun w => by
            change φ_D (ev_x (e_x.symm w)) = S_x.val w
            have h1 : φ_D (ev_x (e_x.symm w)) = Polynomial.aeval (φ_alg x) (e_x.symm w) := by
              change φ_alg (Polynomial.aeval x (e_x.symm w)) = _
              exact (Polynomial.aeval_algHom_apply φ_alg x (e_x.symm w)).symm
            have h2 : Polynomial.aeval (φ_alg x) (e_x.symm w) = S_x.val (ψ_x (e_x.symm w)) := by
              rw [← hψ_comp]
              rfl
            have h3 : ψ_x (e_x.symm w) = w := e_x.apply_symm_apply w
            rw [h1, h2, h3]
        have hΦ_eval_D : Polynomial.eval₂ ev_x y Φ = 0 := by
          apply hInj
          rw [map_zero, Polynomial.hom_eval₂, Polynomial.eval₂_map, hφ_ev_symm]
          exact hPS_eval
        let k₀ : ℕ := Φ.natTrailingDegree
        have hXpow_dvd : Polynomial.X ^ k₀ ∣ Φ :=
          Polynomial.X_pow_dvd_iff.mpr (fun d hd =>
            Polynomial.coeff_eq_zero_of_lt_natTrailingDegree hd)
        obtain ⟨Ψ, hΦ_eq⟩ := hXpow_dvd
        have hΨ0_ne : Ψ.coeff 0 ≠ 0 := by
          have hcoeff_eq : Φ.coeff k₀ = Ψ.coeff 0 := by
            calc
              Φ.coeff k₀ = (Polynomial.X ^ k₀ * Ψ).coeff (0 + k₀) := by rw [hΦ_eq, zero_add]
              _ = Ψ.coeff 0 := Polynomial.coeff_X_pow_mul Ψ k₀ 0
          rw [← hcoeff_eq]
          exact Polynomial.coeff_natTrailingDegree_ne_zero.mpr hΦ_ne
        have hΨ_eval_D : Polynomial.eval₂ ev_x y Ψ = 0 := by
          have hmul0 : y ^ k₀ * Polynomial.eval₂ ev_x y Ψ = 0 := by
            calc
              y ^ k₀ * Polynomial.eval₂ ev_x y Ψ
                = Polynomial.eval₂ ev_x y (Polynomial.X ^ k₀ * Ψ) := by
                    rw [Polynomial.eval₂_mul, Polynomial.eval₂_X_pow]
              _ = Polynomial.eval₂ ev_x y Φ := by rw [← hΦ_eq]
              _ = 0 := hΦ_eval_D
          exact (mul_eq_zero.mp hmul0).resolve_left (pow_ne_zero k₀ hy0)
        have hπ_ev_x : π_hom.comp ev_x = (Polynomial.aeval z).toRingHom :=
          RingHom.ext fun q => by
            change π_P (Polynomial.aeval x q) = Polynomial.aeval z q
            rw [← Polynomial.aeval_algHom_apply, hx_z']
        refine ⟨Ψ.coeff 0, hΨ0_ne, ?_⟩
        have hquot0 : Polynomial.eval₂ (π_hom.comp ev_x) (π_hom y) Ψ = 0 := by
          have h := congrArg π_hom hΨ_eval_D
          rwa [Polynomial.hom_eval₂, map_zero] at h
        rw [hy_quot_hom, hπ_ev_x, Polynomial.eval₂_at_zero] at hquot0
        exact hquot0
    have _ : Algebra.IsAlgebraic Ω (D ⧸ P) := Algebra.isAlgebraic_def.mpr hAllAlg
    have _ : Algebra.IsIntegral Ω (D ⧸ P) := Algebra.IsAlgebraic.isIntegral
    have hBij : Function.Bijective (algebraMap Ω (D ⧸ P)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := D ⧸ P)
    let e_quot : Ω ≃+* (D ⧸ P) := RingEquiv.ofBijective (algebraMap Ω (D ⧸ P)) hBij
    have hFieldQ : IsField (D ⧸ P) :=
      MulEquiv.isField (Field.toIsField Ω) e_quot.symm.toMulEquiv
    have hMaxP : P.IsMaximal := Ideal.Quotient.maximal_of_isField P hFieldQ
    let ev_P : D →+* Ω := e_quot.symm.toRingHom.comp (Ideal.Quotient.mk P)
    refine ⟨hMaxP, ev_P, ?_, ?_⟩
    · ext c
      change e_quot.symm (Ideal.Quotient.mk P (algebraMap Ω D c)) = c
      have hmk : Ideal.Quotient.mk P (algebraMap Ω D c) = e_quot c := rfl
      rw [hmk, e_quot.symm_apply_apply]
    · ext d
      rw [RingHom.mem_ker]
      change e_quot.symm (Ideal.Quotient.mk P d) = 0 ↔ d ∈ P
      rw [map_eq_zero_iff e_quot.symm e_quot.symm.injective, Ideal.Quotient.eq_zero_iff_mem]

  
  let I_f : Ideal D := Ideal.span ({f} : Set D)
  have hMinFin : I_f.minimalPrimes.Finite :=
    Ideal.finite_minimalPrimes_of_isNoetherianRing D I_f
  have hFin : {q : PrimeSpectrum D | f ∈ q.asIdeal}.Finite := by
    refine (hMinFin.preimage (fun _ _ _ _ h => PrimeSpectrum.ext h)).subset ?_
    intro q hq
    have _ : q.asIdeal.IsPrime := q.isPrime
    have hIf_le : I_f ≤ q.asIdeal := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hq)
    obtain ⟨p, hp_min, hp_le_q⟩ := Ideal.exists_minimalPrimes_le hIf_le
    have hp_prime : p.IsPrime := hp_min.1.1
    have hf_p : f ∈ p := hp_min.1.2 (Ideal.mem_span_singleton_self f)
    have hp_ne_bot : p ≠ ⊥ := (Submodule.ne_bot_iff p).mpr ⟨f, hf_p, hf⟩
    have hp_max : p.IsMaximal := (hPrimePkg p hp_prime hp_ne_bot).1
    have hp_eq : p = q.asIdeal := hp_max.eq_of_le q.isPrime.ne_top hp_le_q
    change q.asIdeal ∈ I_f.minimalPrimes
    rwa [← hp_eq]

  
  let T : Finset (PrimeSpectrum D) := hFin.toFinset
  let m : ℕ := T.card
  let e : Fin m ≃ ↥T := T.equivFin.symm
  have hNeBot_i : ∀ i : Fin m, (e i).1.asIdeal ≠ ⊥ := by
    intro i
    have hf_i : f ∈ (e i).1.asIdeal := hFin.mem_toFinset.mp (e i).2
    exact (Submodule.ne_bot_iff _).mpr ⟨f, hf_i, hf⟩
  let ev : Fin m → (D →+* Ω) :=
    fun i => Classical.choose (hPrimePkg (e i).1.asIdeal (e i).1.isPrime (hNeBot_i i)).2
  have hev_spec : ∀ i : Fin m,
      (ev i).comp α_D = RingHom.id Ω ∧ RingHom.ker (ev i) = (e i).1.asIdeal :=
    fun i => Classical.choose_spec (hPrimePkg (e i).1.asIdeal (e i).1.isPrime (hNeBot_i i)).2
  refine ⟨m, ev, fun i => (hev_spec i).1, ?_⟩
  intro q hq
  have hq_T : q ∈ T := hFin.mem_toFinset.mpr hq
  let i : Fin m := e.symm ⟨q, hq_T⟩
  refine ⟨i, ?_⟩
  have hei : (e i).1 = q := congrArg Subtype.val (e.apply_symm_apply ⟨q, hq_T⟩)
  rw [(hev_spec i).2, hei]

theorem weil_algClosed_integral_generic_standardSmooth_affineOpen (Ω : Type u) [Field Ω]
    (E : AlgebraicGeometry.Scheme.{u})
    (p_E : E ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (U₀ : E.Opens) :
    AlgebraicGeometry.IsIntegral E →
    Nonempty ↥U₀ →
    (∀ z : E, HasSpreadSmoothOrNodalAt p_E z) →
    ∃ (W₀ : E.Opens)
      (α_D : Ω →+* ↑(E.presheaf.obj (Opposite.op W₀))),
      AlgebraicGeometry.IsAffineOpen W₀ ∧
      Nonempty ↥W₀ ∧
      (W₀ : Set E) ⊆ (U₀ : Set E) ∧
      W₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_D) = W₀.ι ≫ p_E ∧
      RingHom.IsStandardSmoothOfRelativeDimension 1 α_D :=
by
  intro hInt hU₀ hSmNod
  have : AlgebraicGeometry.IsIntegral E := hInt
  have : IrreducibleSpace ↥E := AlgebraicGeometry.irreducibleSpace_of_isIntegral E
  let η_E : ↥E := genericPoint ↥E
  have hGenE : IsGenericPoint η_E Set.univ := genericPoint_spec ↥E
  obtain ⟨⟨u₀_pt, hu₀_pt⟩⟩ := hU₀
  have hη_U₀ : η_E ∈ U₀ :=
    (hGenE.mem_open_set_iff U₀.isOpen).mpr ⟨u₀_pt, trivial, hu₀_pt⟩
  rcases hSmNod η_E with ⟨V_sm, hη_V, hSm⟩ | ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hX, _hComm⟩
  · let V₀ : E.Opens := V_sm ⊓ U₀
    have hη_V₀ : η_E ∈ V₀ := ⟨hη_V, hη_U₀⟩
    let j₀ : V₀.toScheme ⟶ V_sm.toScheme := E.homOfLE inf_le_left
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_E) := hSm
    have hSm_comp : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (j₀ ≫ (V_sm.ι ≫ p_E)) :=
      inferInstance
    have hSm₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V₀.ι ≫ p_E) := by
      rwa [Nat.zero_add, ← CategoryTheory.Category.assoc, E.homOfLE_ι inf_le_left] at hSm_comp
    let x₀ : ↥V₀.toScheme := ⟨η_E, hη_V₀⟩
    obtain ⟨U_Ω, hU_Ω, W₁, hW₁, hx₁, e₁, hStd₁⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 (V₀.ι ≫ p_E)).mp hSm₀ x₀
    let f_app := (V₀.ι ≫ p_E).appLE U_Ω W₁ e₁
    let W₀ : E.Opens := V₀.ι ''ᵁ W₁
    have hAffW₀ : AlgebraicGeometry.IsAffineOpen W₀ :=
      hW₁.image_of_isOpenImmersion V₀.ι
    let g_α : CommRingCat.of Ω ⟶ E.presheaf.obj (Opposite.op W₀) :=
      AlgebraicGeometry.Spec.preimage (hAffW₀.fromSpec ≫ p_E)
    let α_D : Ω →+* ↑(E.presheaf.obj (Opposite.op W₀)) := g_α.hom
    have hg_α_eq : CommRingCat.ofHom α_D = g_α := rfl
    refine ⟨W₀, α_D, hAffW₀, ?_, ?_, ?_, ?_⟩
    · have hη_W₀ : η_E ∈ (W₀ : Set E) := by
        rw [AlgebraicGeometry.Scheme.Hom.coe_image]
        exact ⟨x₀, hx₁, V₀.ι_apply x₀⟩
      exact ⟨⟨η_E, hη_W₀⟩⟩
    · intro z hz
      rw [AlgebraicGeometry.Scheme.Hom.coe_image] at hz
      rcases hz with ⟨w, _, rfl⟩
      have hw_range : V₀.ι w ∈ Set.range ⇑V₀.ι := ⟨w, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hw_range
      exact hw_range.2
    · rw [hg_α_eq, AlgebraicGeometry.Spec.map_preimage, ← CategoryTheory.Category.assoc,
        hAffW₀.toSpecΓ_fromSpec]
    · have hRangeTop : Set.range ⇑(hW₁.fromSpec ≫ V₀.ι) = Set.range ⇑hAffW₀.fromSpec := by
        calc
          Set.range ⇑(hW₁.fromSpec ≫ V₀.ι)
            = ⇑V₀.ι '' Set.range ⇑hW₁.fromSpec := by
                ext z
                simp only [Set.mem_range, Set.mem_image, AlgebraicGeometry.Scheme.Hom.comp_apply]
                constructor
                · rintro ⟨y, rfl⟩
                  exact ⟨_, ⟨y, rfl⟩, rfl⟩
                · rintro ⟨_, ⟨y, rfl⟩, rfl⟩
                  exact ⟨y, rfl⟩
          _ = ⇑V₀.ι '' (W₁ : Set V₀.toScheme) := by
                rw [← AlgebraicGeometry.Scheme.Hom.coe_opensRange, hW₁.opensRange_fromSpec]
          _ = (W₀ : Set E) := (V₀.ι.coe_image (U := W₁)).symm
          _ = Set.range ⇑hAffW₀.fromSpec := by
                rw [← AlgebraicGeometry.Scheme.Hom.coe_opensRange, hAffW₀.opensRange_fromSpec]
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := (V₀.ι ≫ p_E) x₀
      have hpt₀ : pt₀ ∈ U_Ω := e₁ hx₁
      have hRangeBot :
          Set.range ⇑hU_Ω.fromSpec =
            Set.range ⇑(𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) := by
        rw [← AlgebraicGeometry.Scheme.Hom.coe_opensRange, hU_Ω.opensRange_fromSpec]
        ext y
        simp only [SetLike.mem_coe, Set.mem_range]
        refine ⟨fun _ => ⟨y, rfl⟩, fun _ => ?_⟩
        rw [Subsingleton.elim y pt₀]
        exact hpt₀
      let iso_top :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq
          (hW₁.fromSpec ≫ V₀.ι) hAffW₀.fromSpec hRangeTop
      let iso_bot :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq
          hU_Ω.fromSpec (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) hRangeBot
      have hiso_top_fac : iso_top.hom ≫ hAffW₀.fromSpec = hW₁.fromSpec ≫ V₀.ι :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac _ _ hRangeTop
      have hiso_bot_fac : iso_bot.hom = hU_Ω.fromSpec := by
        have h := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac
          hU_Ω.fromSpec (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) hRangeBot
        rwa [CategoryTheory.Category.comp_id] at h
      have hSpec_comm :
          iso_top.hom ≫ AlgebraicGeometry.Spec.map g_α =
            AlgebraicGeometry.Spec.map f_app ≫ iso_bot.hom := by
        calc
          iso_top.hom ≫ AlgebraicGeometry.Spec.map g_α
            = iso_top.hom ≫ (hAffW₀.fromSpec ≫ p_E) := by
                rw [AlgebraicGeometry.Spec.map_preimage]
          _ = (iso_top.hom ≫ hAffW₀.fromSpec) ≫ p_E := by
                rw [CategoryTheory.Category.assoc]
          _ = hW₁.fromSpec ≫ (V₀.ι ≫ p_E) := by
                rw [hiso_top_fac, CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map f_app ≫ hU_Ω.fromSpec :=
                (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
                  (V₀.ι ≫ p_E) hU_Ω hW₁ e₁).symm
          _ = AlgebraicGeometry.Spec.map f_app ≫ iso_bot.hom := by
                rw [hiso_bot_fac]
      let l_iso : CommRingCat.of Ω ≅
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).presheaf.obj (Opposite.op U_Ω) :=
        { hom := AlgebraicGeometry.Spec.preimage iso_bot.hom
          inv := AlgebraicGeometry.Spec.preimage iso_bot.inv
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.preimage_comp, iso_bot.inv_hom_id,
              AlgebraicGeometry.Spec.preimage_id]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.preimage_comp, iso_bot.hom_inv_id,
              AlgebraicGeometry.Spec.preimage_id] }
      let r_iso : E.presheaf.obj (Opposite.op W₀) ≅
          V₀.toScheme.presheaf.obj (Opposite.op W₁) :=
        { hom := AlgebraicGeometry.Spec.preimage iso_top.hom
          inv := AlgebraicGeometry.Spec.preimage iso_top.inv
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.preimage_comp, iso_top.inv_hom_id,
              AlgebraicGeometry.Spec.preimage_id]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.preimage_comp, iso_top.hom_inv_id,
              AlgebraicGeometry.Spec.preimage_id] }
      have h_arrow_comm : l_iso.hom ≫ f_app = g_α ≫ r_iso.hom := by
        have hpre := congrArg AlgebraicGeometry.Spec.preimage hSpec_comm
        rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_comp,
          AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hpre
        exact hpre.symm
      let arrow_iso : CategoryTheory.Arrow.mk g_α ≅ CategoryTheory.Arrow.mk f_app :=
        CategoryTheory.Arrow.isoMk l_iso r_iso h_arrow_comm
      exact ((@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).arrow_mk_iso_iff
        arrow_iso).mpr hStd₁
  · exfalso
    let I_node : Ideal (MvPolynomial (Fin 2) Ω) :=
      Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))
    let R_node : Type u := MvPolynomial (Fin 2) Ω ⧸ I_node
    let q₂ : PrimeSpectrum R_node := e₂ u₀
    have hX_q₂ : ∀ i : Fin 2, Ideal.Quotient.mk I_node (MvPolynomial.X i) ∈ q₂.asIdeal := hX
    let ev_tilde : MvPolynomial (Fin 2) Ω →+* Polynomial Ω :=
      MvPolynomial.eval₂Hom Polynomial.C (fun i : Fin 2 => if i = 0 then 0 else Polynomial.X)
    have hI_ker : ∀ g ∈ I_node, ev_tilde g = 0 := by
      intro g hg
      have hle : I_node ≤ RingHom.ker ev_tilde := by
        rw [Ideal.span_singleton_le_iff_mem]
        change ev_tilde (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
        simp [ev_tilde]
      exact hle hg
    let ev_bar : R_node →+* Polynomial Ω := Ideal.Quotient.lift I_node ev_tilde hI_ker
    let p₀ : PrimeSpectrum R_node := ⟨RingHom.ker ev_bar, RingHom.ker_isPrime ev_bar⟩
    let ι₁ : Polynomial Ω →+* R_node :=
      Polynomial.eval₂RingHom
        ((Ideal.Quotient.mk I_node).comp MvPolynomial.C)
        (Ideal.Quotient.mk I_node (MvPolynomial.X 1))
    let π_q₂ : R_node →+* R_node ⧸ q₂.asIdeal := Ideal.Quotient.mk q₂.asIdeal
    have h1_ne_0 : (1 : Fin 2) ≠ 0 := by decide
    have hcomp_q₂ : π_q₂.comp (ι₁.comp ev_bar) = π_q₂ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext'
      · ext c
        simp [ev_bar, ev_tilde, ι₁]
      · intro i
        fin_cases i
        · have hX0_zero : π_q₂ (Ideal.Quotient.mk I_node (MvPolynomial.X 0)) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (hX_q₂ 0)
          simp [ev_bar, ev_tilde, ι₁, hX0_zero]
        · simp [ev_bar, ev_tilde, ι₁, h1_ne_0]
    have hp₀_le : p₀ ≤ q₂ := by
      intro r hr
      have hr0 : ev_bar r = 0 := hr
      have hπ : π_q₂ r = 0 := by
        have hfun := RingHom.congr_fun hcomp_q₂ r
        simpa [hr0] using hfun.symm
      exact Ideal.Quotient.eq_zero_iff_mem.mp hπ
    have hp₀_spec : p₀ ⤳ e₂ u₀ := (PrimeSpectrum.le_iff_specializes p₀ q₂).mp hp₀_le
    have hp₀_ne : p₀ ≠ q₂ := by
      intro h_eq
      have hmem : Ideal.Quotient.mk I_node (MvPolynomial.X 1) ∈ p₀.asIdeal := by
        rw [h_eq]
        exact hX_q₂ 1
      have hker : ev_bar (Ideal.Quotient.mk I_node (MvPolynomial.X 1)) = 0 := hmem
      have hev1 : ev_bar (Ideal.Quotient.mk I_node (MvPolynomial.X 1)) = Polynomial.X := by
        change ev_tilde (MvPolynomial.X 1) = Polynomial.X
        simp [ev_tilde, h1_ne_0]
      rw [hev1] at hker
      exact Polynomial.X_ne_zero hker
    have : AlgebraicGeometry.Etale e₁ := hEt₁
    have : AlgebraicGeometry.Etale e₂ := hEt₂
    obtain ⟨u₁, hu₁_spec, hu₁_e₂⟩ := AlgebraicGeometry.Flat.generalizingMap e₂ hp₀_spec
    have hu₁_ne : u₁ ≠ u₀ := by
      intro h_eq
      apply hp₀_ne
      rw [← hu₁_e₂, h_eq]
    have he₁_u₀ : e₁ u₀ = η_E := hu₀
    have he₁_spec₁ : e₁ u₁ ⤳ η_E := by
      rw [← he₁_u₀]
      exact hu₁_spec.map e₁.continuous
    have he₁_spec₂ : η_E ⤳ e₁ u₁ := hGenE.specializes trivial
    have he₁_eq : e₁ u₁ = e₁ u₀ := by
      rw [he₁_u₀]
      exact (he₁_spec₁.antisymm he₁_spec₂).eq
    obtain ⟨U_E, hUE, hη_UE, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := η_E) (U := ⊤) trivial
    have hu₀_pre : u₀ ∈ e₁ ⁻¹ᵁ U_E := by
      change e₁ u₀ ∈ U_E
      rwa [he₁_u₀]
    obtain ⟨V', hV', hu₀_V', e_V'_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := u₀) (U := e₁ ⁻¹ᵁ U_E) hu₀_pre
    have e_V' : V' ≤ e₁ ⁻¹ᵁ U_E := e_V'_sub
    have hu₁_V' : u₁ ∈ V' := hu₁_spec.mem_open V'.isOpen hu₀_V'
    let R_E : Type u := ↑(E.presheaf.obj (Opposite.op U_E))
    let R_V' : Type u := ↑(U'.presheaf.obj (Opposite.op V'))
    let φ₁ : R_E →+* R_V' := (e₁.appLE U_E V' e_V').hom
    have hφ₁_et : φ₁.Etale :=
      AlgebraicGeometry.HasRingHomProperty.appLE (P := @AlgebraicGeometry.Etale)
        e₁ hEt₁ ⟨U_E, hUE⟩ ⟨V', hV'⟩ e_V'
    let : Algebra R_E R_V' := φ₁.toAlgebra
    have : Algebra.Etale R_E R_V' := RingHom.Etale.toAlgebra hφ₁_et
    let q₁ : PrimeSpectrum R_V' := hV'.primeIdealOf ⟨u₁, hu₁_V'⟩
    let q₀ : PrimeSpectrum R_V' := hV'.primeIdealOf ⟨u₀, hu₀_V'⟩
    have hq₁_pt : hV'.fromSpec q₁ = u₁ := hV'.fromSpec_primeIdealOf ⟨u₁, hu₁_V'⟩
    have hq₀_pt : hV'.fromSpec q₀ = u₀ := hV'.fromSpec_primeIdealOf ⟨u₀, hu₀_V'⟩
    have hfrom_spec : hV'.fromSpec q₁ ⤳ hV'.fromSpec q₀ := by
      rw [hq₁_pt, hq₀_pt]
      exact hu₁_spec
    have hq₁₀_spec : q₁ ⤳ q₀ :=
      (hV'.fromSpec.isOpenEmbedding.isInducing.specializes_iff (x := q₁) (y := q₀)).mp hfrom_spec
    have hSpec_e₁ := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec e₁ hUE hV' e_V'
    have hcomap_fromSpec : ∀ q : PrimeSpectrum R_V',
        hUE.fromSpec (PrimeSpectrum.comap φ₁ q) = e₁ (hV'.fromSpec q) := by
      intro q
      have h1 : hUE.fromSpec (PrimeSpectrum.comap φ₁ q) =
          hUE.fromSpec ((AlgebraicGeometry.Spec.map (e₁.appLE U_E V' e_V')) q) :=
        congrArg (fun p => hUE.fromSpec p)
          (AlgebraicGeometry.Spec.map_apply (e₁.appLE U_E V' e_V') q).symm
      have h2 : hUE.fromSpec ((AlgebraicGeometry.Spec.map (e₁.appLE U_E V' e_V')) q) =
          (AlgebraicGeometry.Spec.map (e₁.appLE U_E V' e_V') ≫ hUE.fromSpec) q :=
        (AlgebraicGeometry.Scheme.Hom.comp_apply
          (AlgebraicGeometry.Spec.map (e₁.appLE U_E V' e_V')) hUE.fromSpec q).symm
      have h3 : (AlgebraicGeometry.Spec.map (e₁.appLE U_E V' e_V') ≫ hUE.fromSpec) q =
          (hV'.fromSpec ≫ e₁) q :=
        congrArg (fun g : AlgebraicGeometry.Spec (U'.presheaf.obj (Opposite.op V')) ⟶ E => g q)
          hSpec_e₁
      have h4 : (hV'.fromSpec ≫ e₁) q = e₁ (hV'.fromSpec q) :=
        AlgebraicGeometry.Scheme.Hom.comp_apply hV'.fromSpec e₁ q
      exact h1.trans (h2.trans (h3.trans h4))
    have hcomap_eq : PrimeSpectrum.comap φ₁ q₁ = PrimeSpectrum.comap φ₁ q₀ := by
      apply hUE.fromSpec.isOpenEmbedding.injective
      rw [hcomap_fromSpec q₁, hcomap_fromSpec q₀, hq₁_pt, hq₀_pt, he₁_eq]
    have hDisc : _root_.IsDiscrete
        (PrimeSpectrum.comap (algebraMap R_E R_V') ⁻¹' {PrimeSpectrum.comap φ₁ q₀}) :=
      Algebra.QuasiFinite.isDiscrete_comap_preimage_singleton (PrimeSpectrum.comap φ₁ q₀)
    have hq_eq : q₁ = q₀ :=
      hDisc.eq_of_specializes hq₁₀_spec hcomap_eq rfl
    apply hu₁_ne
    rw [← hq₁_pt, ← hq₀_pt, hq_eq]

theorem weil_algClosed_smoothOrNodal_smooth_or_affine_rank_three_jet (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (E : AlgebraicGeometry.Scheme.{u})
    (p_E : E ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω)) :
    AlgebraicGeometry.LocallyOfFiniteType p_E →
    AlgebraicGeometry.IsReduced E →
    (∀ (D : Type u) [CommRing D] [Algebra Ω D]
       (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ E),
       AlgebraicGeometry.IsOpenImmersion j_D →
       j_D ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
       ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
         let L := Localization.AtPrime q.asIdeal
         let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
         Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨ Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3) →
    (∀ (D : Type u) [CommRing D] [Algebra Ω D] [Algebra.FiniteType Ω D] [IsReduced D]
       (q : PrimeSpectrum D),
       q.asIdeal.IsMaximal →
       (let L := Localization.AtPrime q.asIdeal
        let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
        Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2) →
       ∃ f : D, f ∉ q.asIdeal ∧
         RingHom.IsStandardSmoothOfRelativeDimension 1
           (algebraMap Ω (Localization.Away f))) →
    AlgebraicGeometry.SmoothOfRelativeDimension 1 p_E ∨
      ∃ (V : E.Opens)
        (ev : ↑(E.presheaf.obj (Opposite.op V)) →+* Ω)
        (α_V : Ω →+* ↑(E.presheaf.obj (Opposite.op V))),
        AlgebraicGeometry.IsAffineOpen V ∧
        V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_V) = V.ι ≫ p_E ∧
        ev.comp α_V = RingHom.id Ω ∧
        (letI : Algebra Ω ↑(E.presheaf.obj (Opposite.op V)) := α_V.toAlgebra
         Module.finrank Ω (↑(E.presheaf.obj (Opposite.op V)) ⧸ (RingHom.ker ev) ^ 2) = 3) :=
by
  intro hLFT hRed hJet hLocSm
  have _ : AlgebraicGeometry.LocallyOfFiniteType p_E := hLFT
  have _ : AlgebraicGeometry.IsReduced E := hRed

  have h_s1 : ∀ (D : Type u) [CommRing D] [Algebra Ω D] [Algebra.FiniteType Ω D]
      (q : PrimeSpectrum D),
      q.asIdeal.IsMaximal →
      ∃ (ev : D →+* Ω),
        ev.comp (algebraMap Ω D) = RingHom.id Ω ∧
        RingHom.ker ev = q.asIdeal ∧
        Module.finrank Ω (D ⧸ (RingHom.ker ev) ^ 2) =
          Module.finrank Ω
            (Localization.AtPrime q.asIdeal ⧸
              (IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal)) ^ 2) := by
    intro D _ _ _ q hq
    let 𝔪₀ : Ideal D := q.asIdeal
    have _ : 𝔪₀.IsMaximal := hq
    have _ : 𝔪₀.IsPrime := q.isPrime
    let K₀ := D ⧸ 𝔪₀
    let _ : Field K₀ := Ideal.Quotient.field 𝔪₀
    obtain ⟨S_gen, hS_gen⟩ := Algebra.FiniteType.out (R := Ω) (A := D)
    let π_mv : MvPolynomial ↥S_gen Ω →ₐ[Ω] D := MvPolynomial.aeval (Subtype.val : ↥S_gen → D)
    have hSurj_mv : Function.Surjective π_mv := by
      intro d
      have hd : d ∈ (⊤ : Subalgebra Ω D) := Algebra.mem_top
      rw [← hS_gen] at hd
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hd
      · intro x hx
        exact ⟨MvPolynomial.X ⟨x, Finset.mem_coe.mp hx⟩, MvPolynomial.aeval_X _ _⟩
      · intro c
        exact ⟨MvPolynomial.C c, MvPolynomial.aeval_C _ c⟩
      · rintro x y _ _ ⟨Px, rfl⟩ ⟨Py, rfl⟩
        exact ⟨Px + Py, map_add π_mv Px Py⟩
      · rintro x y _ _ ⟨Px, rfl⟩ ⟨Py, rfl⟩
        exact ⟨Px * Py, map_mul π_mv Px Py⟩
    let 𝔐₀ : Ideal (MvPolynomial ↥S_gen Ω) := Ideal.comap π_mv.toRingHom 𝔪₀
    have _ : 𝔐₀.IsMaximal := Ideal.comap_isMaximal_of_surjective π_mv.toRingHom hSurj_mv
    obtain ⟨x₀, hx₀⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := 𝔐₀)).mp inferInstance
    have hSurj_res : Function.Surjective (algebraMap Ω K₀) := by
      intro y
      obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨P, rfl⟩ := hSurj_mv d
      let c : Ω := MvPolynomial.aeval x₀ P
      have hQ_van : P - MvPolynomial.C c ∈ MvPolynomial.vanishingIdeal Ω {x₀} := by
        rw [MvPolynomial.mem_vanishingIdeal_singleton_iff]
        simp [c]
      have hQ_mem : π_mv (P - MvPolynomial.C c) ∈ 𝔪₀ := by
        change P - MvPolynomial.C c ∈ 𝔐₀
        rwa [hx₀]
      refine ⟨c, ?_⟩
      change Ideal.Quotient.mk 𝔪₀ (algebraMap Ω D c) = Ideal.Quotient.mk 𝔪₀ (π_mv P)
      have hsub : Ideal.Quotient.mk 𝔪₀ (π_mv P - algebraMap Ω D c) = 0 := by
        have hmap : π_mv (P - MvPolynomial.C c) = π_mv P - algebraMap Ω D c := by
          rw [map_sub, MvPolynomial.aeval_C]
        rw [← hmap]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hQ_mem
      exact (sub_eq_zero.mp (by rwa [map_sub] at hsub)).symm
    let e_res : Ω ≃+* K₀ :=
      RingEquiv.ofBijective (algebraMap Ω K₀) ⟨RingHom.injective (algebraMap Ω K₀), hSurj_res⟩
    let ev : D →+* Ω := e_res.symm.toRingHom.comp (Ideal.Quotient.mk 𝔪₀)
    have hev_id : ev.comp (algebraMap Ω D) = RingHom.id Ω := by
      ext c
      change e_res.symm (Ideal.Quotient.mk 𝔪₀ (algebraMap Ω D c)) = c
      exact e_res.symm_apply_apply c
    have hker : RingHom.ker ev = q.asIdeal := by
      ext d
      change e_res.symm (Ideal.Quotient.mk 𝔪₀ d) = 0 ↔ d ∈ 𝔪₀
      rw [RingEquiv.map_eq_zero_iff, Ideal.Quotient.eq_zero_iff_mem]
    let L := Localization.AtPrime q.asIdeal
    let 𝔪_L : Ideal L := IsLocalRing.maximalIdeal L
    have hmap_max : Ideal.map (algebraMap D L) 𝔪₀ = 𝔪_L :=
      IsLocalization.AtPrime.map_eq_maximalIdeal 𝔪₀ L
    have hmap_sq : Ideal.map (algebraMap D L) (𝔪₀ ^ 2) = 𝔪_L ^ 2 := by
      rw [Ideal.map_pow, hmap_max]
    let φ_fwd : D →ₐ[Ω] (L ⧸ 𝔪_L ^ 2) :=
      (Ideal.Quotient.mkₐ Ω (𝔪_L ^ 2)).comp (IsScalarTower.toAlgHom Ω D L)
    have hφ_fwd_ker : ∀ a ∈ 𝔪₀ ^ 2, φ_fwd a = 0 := by
      intro a ha
      change Ideal.Quotient.mk (𝔪_L ^ 2) (algebraMap D L a) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, ← hmap_sq]
      exact Ideal.mem_map_of_mem (algebraMap D L) ha
    let Φ : (D ⧸ 𝔪₀ ^ 2) →ₐ[Ω] (L ⧸ 𝔪_L ^ 2) :=
      Ideal.Quotient.liftₐ (𝔪₀ ^ 2) φ_fwd hφ_fwd_ker
    let π₂ : D →+* (D ⧸ 𝔪₀ ^ 2) := Ideal.Quotient.mk (𝔪₀ ^ 2)
    have hUnits : ∀ y : 𝔪₀.primeCompl, IsUnit (π₂ y) := by
      rintro ⟨s, hs⟩
      have hs_ne : (Ideal.Quotient.mk 𝔪₀ s : K₀) ≠ 0 := by
        intro h0
        exact hs (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (Ideal.Quotient.mk 𝔪₀ s : K₀)⁻¹
      have h1_mem : 1 - s * t ∈ 𝔪₀ := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, map_mul, ht]
        exact sub_eq_zero.mpr (mul_inv_cancel₀ hs_ne).symm
      have hsq_mem : (1 - s * t) ^ 2 ∈ 𝔪₀ ^ 2 := by
        rw [pow_two, pow_two]
        exact Ideal.mul_mem_mul h1_mem h1_mem
      refine isUnit_iff_exists_inv.mpr ⟨π₂ (t * (2 - s * t)), ?_⟩
      rw [← map_mul]
      have hid : s * (t * (2 - s * t)) = 1 - (1 - s * t) ^ 2 := by ring
      rw [hid, map_sub, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr hsq_mem, sub_zero]
    let ψ₀ : L →+* (D ⧸ 𝔪₀ ^ 2) := IsLocalization.lift (M := 𝔪₀.primeCompl) (S := L) hUnits
    have hψ₀_ker : ∀ a ∈ 𝔪_L ^ 2, ψ₀ a = 0 := by
      have hle : 𝔪_L ^ 2 ≤ RingHom.ker ψ₀ := by
        rw [← hmap_sq, Ideal.map_le_iff_le_comap]
        intro z hz
        change ψ₀ (algebraMap D L z) = 0
        rw [IsLocalization.lift_eq hUnits z]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hz
      intro a ha
      exact hle ha
    let Ψ : (L ⧸ 𝔪_L ^ 2) →+* (D ⧸ 𝔪₀ ^ 2) :=
      Ideal.Quotient.lift (𝔪_L ^ 2) ψ₀ hψ₀_ker
    have hLeftInv : Function.LeftInverse Ψ Φ := by
      intro u
      obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective u
      change ψ₀ (algebraMap D L d) = π₂ d
      exact IsLocalization.lift_eq hUnits d
    have hRightComp : Φ.toRingHom.comp Ψ = RingHom.id (L ⧸ 𝔪_L ^ 2) := by
      apply Ideal.Quotient.ringHom_ext
      apply IsLocalization.ringHom_ext 𝔪₀.primeCompl
      ext d
      change Φ (ψ₀ (algebraMap D L d)) = Ideal.Quotient.mk (𝔪_L ^ 2) (algebraMap D L d)
      rw [IsLocalization.lift_eq hUnits d]
      rfl
    have hRightInv : Function.RightInverse Ψ Φ := fun v =>
      RingHom.congr_fun hRightComp v
    let e_sq : (D ⧸ 𝔪₀ ^ 2) ≃ₐ[Ω] (L ⧸ 𝔪_L ^ 2) :=
      AlgEquiv.ofBijective Φ ⟨hLeftInv.injective, hRightInv.surjective⟩
    refine ⟨ev, hev_id, hker, ?_⟩
    rw [hker]
    exact e_sq.toLinearEquiv.finrank_eq

  have h_s2 :
      (∀ (W : E.Opens) (hAff : AlgebraicGeometry.IsAffineOpen W)
         (α_W : Ω →+* ↑(E.presheaf.obj (Opposite.op W))),
         hAff.fromSpec ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_W) →
         ∀ (q : PrimeSpectrum ↑(E.presheaf.obj (Opposite.op W))),
           q.asIdeal.IsMaximal →
           ∃ f : ↑(E.presheaf.obj (Opposite.op W)),
             f ∉ q.asIdeal ∧
             RingHom.IsStandardSmoothOfRelativeDimension 1
               ((algebraMap ↑(E.presheaf.obj (Opposite.op W)) (Localization.Away f)).comp α_W)) →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 p_E := by
    intro hAway
    let R_Ω : CommRingCat.{u} := CommRingCat.of Ω
    refine AlgebraicGeometry.SmoothOfRelativeDimension.mk fun x => ?_
    obtain ⟨W, hAffW, hxW, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    let D_obj : CommRingCat.{u} := E.presheaf.obj (Opposite.op W)
    let D : Type u := ↑D_obj
    let φ_W : R_Ω ⟶ D_obj := AlgebraicGeometry.Spec.preimage (hAffW.fromSpec ≫ p_E)
    let α_W : Ω →+* D := φ_W.hom
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_W = hAffW.fromSpec ≫ p_E :=
      AlgebraicGeometry.Spec.map_preimage (hAffW.fromSpec ≫ p_E)
    have hComm_W : hAffW.fromSpec ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_W) :=
      hSpec_φ.symm
    have hRange_W : Set.range hAffW.fromSpec.base = (W : Set E) :=
      congrArg (fun V : E.Opens => (V : Set E)) hAffW.opensRange_fromSpec
    have hx_range : x ∈ Set.range hAffW.fromSpec.base := by
      rw [hRange_W]
      exact hxW
    obtain ⟨p_x, hp_x⟩ := hx_range
    obtain ⟨𝔪_x, hMax_x, hle_x⟩ := Ideal.exists_le_maximal p_x.asIdeal p_x.isPrime.ne_top
    let q_x : PrimeSpectrum D := ⟨𝔪_x, hMax_x.isPrime⟩
    obtain ⟨f, hf_not_max, hStdSm⟩ := hAway W hAffW α_W hComm_W q_x hMax_x
    have hf_not_px : f ∉ p_x.asIdeal := fun hmem => hf_not_max (hle_x hmem)
    have hpx_basic : p_x ∈ PrimeSpectrum.basicOpen f := hf_not_px
    rw [← hAffW.fromSpec_preimage_basicOpen f] at hpx_basic
    have hx_Vf : x ∈ E.basicOpen f := by
      rw [← hp_x]
      exact hpx_basic
    have he_W : W ≤ (TopologicalSpace.Opens.map p_E.base).obj ⊤ := fun _ _ => trivial
    have he_Vf : E.basicOpen f ≤ (TopologicalSpace.Opens.map p_E.base).obj ⊤ := fun _ _ => trivial
    refine ⟨⊤, AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec R_Ω),
      E.basicOpen f, hAffW.basicOpen f, hx_Vf, he_Vf, ?_⟩
    have h_pre : (⊤ : (AlgebraicGeometry.Spec D_obj).Opens) ≤
        (TopologicalSpace.Opens.map hAffW.fromSpec.base).obj W := by
      intro z _
      change hAffW.fromSpec.base z ∈ (W : Set E)
      rw [← hRange_W]
      exact ⟨z, rfl⟩
    have h_eq_top : (TopologicalSpace.Opens.map hAffW.fromSpec.base).obj W = ⊤ :=
      le_antisymm le_top h_pre
    have h_fromSpec_appLE :
        hAffW.fromSpec.appLE W ⊤ h_pre = (AlgebraicGeometry.Scheme.ΓSpecIso D_obj).inv := by
      have h1 :
          hAffW.fromSpec.app W ≫
              (AlgebraicGeometry.Spec D_obj).presheaf.map
                (CategoryTheory.eqToHom h_eq_top.symm).op =
            hAffW.fromSpec.appLE W ⊤ h_pre := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      rw [← h1, hAffW.fromSpec_app_self, CategoryTheory.Category.assoc,
        ← CategoryTheory.Functor.map_comp, ← op_comp, CategoryTheory.eqToHom_trans,
        CategoryTheory.eqToHom_refl, op_id, CategoryTheory.Functor.map_id,
        CategoryTheory.Category.comp_id]
    have h_app_top :
        (hAffW.fromSpec ≫ p_E).app ⊤ =
          (hAffW.fromSpec ≫ p_E).appLE ⊤ ⊤ (fun _ _ => trivial) :=
      AlgebraicGeometry.Scheme.Hom.app_eq_appLE (hAffW.fromSpec ≫ p_E)
    have h_nat :
        φ_W ≫ (AlgebraicGeometry.Scheme.ΓSpecIso D_obj).inv =
          (AlgebraicGeometry.Scheme.ΓSpecIso R_Ω).inv ≫
            (p_E.appLE ⊤ W he_W ≫ (AlgebraicGeometry.Scheme.ΓSpecIso D_obj).inv) := by
      rw [AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality φ_W, hSpec_φ]
      congr 1
      change (hAffW.fromSpec ≫ p_E).app ⊤ =
        p_E.appLE ⊤ W he_W ≫ (AlgebraicGeometry.Scheme.ΓSpecIso D_obj).inv
      rw [← h_fromSpec_appLE, AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
      exact h_app_top
    have h_φ_eq :
        φ_W = (AlgebraicGeometry.Scheme.ΓSpecIso R_Ω).inv ≫ p_E.appLE ⊤ W he_W := by
      rw [← CategoryTheory.Category.assoc] at h_nat
      exact (CategoryTheory.Iso.cancel_iso_inv_right _ _ _).mp h_nat
    have h_appLE_W :
        p_E.appLE ⊤ W he_W = (AlgebraicGeometry.Scheme.ΓSpecIso R_Ω).hom ≫ φ_W := by
      rw [h_φ_eq, ← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
        CategoryTheory.Category.id_comp]
    let i_f : Opposite.op W ⟶ Opposite.op (E.basicOpen f) :=
      (CategoryTheory.homOfLE (E.basicOpen_le f)).op
    have h_appLE_Vf :
        p_E.appLE ⊤ (E.basicOpen f) he_Vf =
          (AlgebraicGeometry.Scheme.ΓSpecIso R_Ω).hom ≫ (φ_W ≫ E.presheaf.map i_f) := by
      rw [← CategoryTheory.Category.assoc, ← h_appLE_W,
        AlgebraicGeometry.Scheme.Hom.appLE_map]
    let D_f_obj : CommRingCat.{u} := E.presheaf.obj (Opposite.op (E.basicOpen f))
    let D_f : Type u := ↑D_f_obj
    let _ : Algebra D D_f := E.algebra_section_section_basicOpen f
    have _ : IsLocalization.Away f D_f := hAffW.isLocalization_basicOpen f
    let e_loc : Localization.Away f ≃ₐ[D] D_f :=
      IsLocalization.algEquiv (Submonoid.powers f) (Localization.Away f) D_f
    let f₂ : R_Ω ⟶ CommRingCat.of (Localization.Away f) :=
      CommRingCat.ofHom ((algebraMap D (Localization.Away f)).comp α_W)
    let f₃ : CommRingCat.of (Localization.Away f) ⟶ D_f_obj :=
      CommRingCat.ofHom e_loc.toRingHom
    have _ : CategoryTheory.IsIso f₃ :=
      ⟨⟨CommRingCat.ofHom e_loc.symm.toRingHom,
        by
          rw [← CommRingCat.ofHom_comp]
          exact congrArg CommRingCat.ofHom (RingHom.ext e_loc.symm_apply_apply),
        by
          rw [← CommRingCat.ofHom_comp]
          exact congrArg CommRingCat.ofHom (RingHom.ext e_loc.apply_symm_apply)⟩⟩
    have h_loc_comp : φ_W ≫ E.presheaf.map i_f = f₂ ≫ f₃ := by
      ext r
      change (E.presheaf.map i_f).hom (α_W r) =
        e_loc (algebraMap D (Localization.Away f) (α_W r))
      exact (e_loc.commutes (α_W r)).symm
    rw [h_appLE_Vf, h_loc_comp, CommRingCat.hom_comp,
      (RingHom.isStandardSmoothOfRelativeDimension_respectsIso (n := 1)).cancel_left_isIso
        (AlgebraicGeometry.Scheme.ΓSpecIso R_Ω).hom (f₂ ≫ f₃),
      CommRingCat.hom_comp,
      (RingHom.isStandardSmoothOfRelativeDimension_respectsIso (n := 1)).cancel_right_isIso f₂ f₃]
    exact hStdSm

  have hAffFT : ∀ (V : E.Opens) (hAff : AlgebraicGeometry.IsAffineOpen V),
      letI : Algebra Ω ↑(E.presheaf.obj (Opposite.op V)) :=
        ((AlgebraicGeometry.Spec.preimage (hAff.fromSpec ≫ p_E)).hom).toAlgebra
      Algebra.FiniteType Ω ↑(E.presheaf.obj (Opposite.op V)) := by
    intro V hAff
    let α_V := (AlgebraicGeometry.Spec.preimage (hAff.fromSpec ≫ p_E)).hom
    let _ : Algebra Ω ↑(E.presheaf.obj (Opposite.op V)) := α_V.toAlgebra
    have hSpec_α : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_V) = hAff.fromSpec ≫ p_E :=
      AlgebraicGeometry.Spec.map_preimage (hAff.fromSpec ≫ p_E)
    have h1 : AlgebraicGeometry.LocallyOfFiniteType (hAff.fromSpec ≫ p_E) := inferInstance
    rw [← hSpec_α,
      AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)] at h1
    exact h1

  by_cases hEx3 :
      ∃ (V : E.Opens) (hAff : AlgebraicGeometry.IsAffineOpen V)
        (q : PrimeSpectrum ↑(E.presheaf.obj (Opposite.op V))),
        q.asIdeal.IsMaximal ∧
        (letI : Algebra Ω ↑(E.presheaf.obj (Opposite.op V)) :=
           ((AlgebraicGeometry.Spec.preimage (hAff.fromSpec ≫ p_E)).hom).toAlgebra
         Module.finrank Ω
           (Localization.AtPrime q.asIdeal ⧸
             (IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal)) ^ 2) = 3)
  · right
    obtain ⟨V, hAff, q, hq, hRank3⟩ := hEx3
    let D_V : Type u := ↑(E.presheaf.obj (Opposite.op V))
    let α_V : Ω →+* D_V := (AlgebraicGeometry.Spec.preimage (hAff.fromSpec ≫ p_E)).hom
    let _ : Algebra Ω D_V := α_V.toAlgebra
    have _ : Algebra.FiniteType Ω D_V := hAffFT V hAff
    obtain ⟨ev, hev_id, _hker, hfinrank_eq⟩ := h_s1 D_V q hq
    have hToSpecΓ :
        V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_V) = V.ι ≫ p_E := by
      have hSpec_α : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_V) = hAff.fromSpec ≫ p_E :=
        AlgebraicGeometry.Spec.map_preimage (hAff.fromSpec ≫ p_E)
      rw [hSpec_α, ← CategoryTheory.Category.assoc, hAff.toSpecΓ_fromSpec]
    exact ⟨V, ev, α_V, hAff, hToSpecΓ, hev_id, hfinrank_eq.trans hRank3⟩
  · left
    refine h_s2 fun W hAffW α_W hCommW q hq => ?_
    let D_W : Type u := ↑(E.presheaf.obj (Opposite.op W))
    have hα_eq : α_W = (AlgebraicGeometry.Spec.preimage (hAffW.fromSpec ≫ p_E)).hom := by
      have hmap_eq :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_W) =
            AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage (hAffW.fromSpec ≫ p_E)) := by
        rw [← hCommW, AlgebraicGeometry.Spec.map_preimage]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hmap_eq)
    subst hα_eq
    let _ : Algebra Ω D_W :=
      ((AlgebraicGeometry.Spec.preimage (hAffW.fromSpec ≫ p_E)).hom).toAlgebra
    have _ : Algebra.FiniteType Ω D_W := hAffFT W hAffW
    have _ : IsReduced D_W := AlgebraicGeometry.IsReduced.component_reduced W
    have hRank2 :
        Module.finrank Ω
          (Localization.AtPrime q.asIdeal ⧸
            (IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal)) ^ 2) = 2 := by
      rcases hJet D_W hAffW.fromSpec inferInstance hCommW q hq with h2 | h3
      · exact h2
      · exfalso
        exact hEx3 ⟨W, hAffW, q, hq, h3⟩
    obtain ⟨f, hf, hStdSm⟩ := hLocSm D_W q hq hRank2
    rw [IsScalarTower.algebraMap_eq Ω D_W (Localization.Away f)] at hStdSm
    exact ⟨f, hf, hStdSm⟩

theorem weil_algClosed_integral_smoothOrNodal_plane_chart_and_compl (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (E : AlgebraicGeometry.Scheme.{u})
    (p_E : E ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (U₀ : E.Opens) :
    AlgebraicGeometry.IsIntegral E →
    AlgebraicGeometry.IsProper p_E →
    AlgebraicGeometry.LocallyOfFiniteType p_E →
    ((∀ z : E, HasSpreadSmoothOrNodalAt p_E z) ↔
      (AlgebraicGeometry.IsReduced E ∧
       ∀ (D : Type u) [CommRing D] [Algebra Ω D]
         (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ E),
         AlgebraicGeometry.IsOpenImmersion j_D →
         j_D ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
         ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
           let L := Localization.AtPrime q.asIdeal
           let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
           Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
             (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
              Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
              ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3))) →
    Nonempty ↥U₀ →
    (∀ z : E, HasSpreadSmoothOrNodalAt p_E z) →
    (∃ (P : Polynomial (Polynomial Ω))
        (g₀ : Polynomial (Polynomial Ω) ⧸
          Ideal.span ({P} : Set (Polynomial (Polynomial Ω))))
        (α_W : Ω →+* Localization.Away g₀)
        (j_W : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g₀)) ⟶ E)
        (pt_W : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g₀)))
        (r : ℕ)
        (ξ : Fin r → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E)),
      P.Monic ∧
      1 ≤ P.natDegree ∧
      Irreducible P ∧
      (∀ c : Ω, α_W c = Localization.mk
        (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) ∧
      AlgebraicGeometry.IsOpenImmersion j_W ∧
      j_W ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_W) ∧
      Set.range j_W.base ⊆ (U₀ : Set E) ∧
      pt_W ≫ j_W ≫ p_E = 𝟙 _ ∧
      (∀ ℓ : Fin r, ξ ℓ ≫ p_E = 𝟙 _) ∧
      (Set.range j_W.base)ᶜ ⊆ ⋃ ℓ : Fin r, Set.range (ξ ℓ).base) ∧
    (AlgebraicGeometry.SmoothOfRelativeDimension 1 p_E ∨
      ∃ (V : E.Opens)
        (ev : ↑(E.presheaf.obj (Opposite.op V)) →+* Ω)
        (α_V : Ω →+* ↑(E.presheaf.obj (Opposite.op V))),
        AlgebraicGeometry.IsAffineOpen V ∧
        V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_V) = V.ι ≫ p_E ∧
        ev.comp α_V = RingHom.id Ω ∧
        (letI : Algebra Ω ↑(E.presheaf.obj (Opposite.op V)) := α_V.toAlgebra
         Module.finrank Ω (↑(E.presheaf.obj (Opposite.op V)) ⧸ (RingHom.ker ev) ^ 2) = 3)) :=
by
  intro hInt hProp hLFT hArtin hU₀ hSmNod
  have _ : AlgebraicGeometry.IsIntegral E := hInt
  have _ : AlgebraicGeometry.IsProper p_E := hProp
  refine ⟨?_, ?_⟩
  · 
    obtain ⟨F, instFieldF, instAlgΩF, η_F, hη_p, hFuncF, _hη_mem⟩ :=
      weil_integral_scheme_functionField_over_field Ω E hInt p_E
    let _ : Field F := instFieldF
    let _ : Algebra Ω F := instAlgΩF
    obtain ⟨W₀, α_D, hAffW₀, hNeW₀, hW₀_sub, hW₀_comm, hSm_D⟩ :=
      weil_algClosed_integral_generic_standardSmooth_affineOpen Ω E p_E U₀ hInt hU₀ hSmNod
    let D : Type u := ↑(E.presheaf.obj (Opposite.op W₀))
    have _ : Nonempty ↥(W₀ : AlgebraicGeometry.Scheme.{u}) := hNeW₀
    have _ : IsDomain D := inferInstance
    obtain ⟨φ_W₀, hFrac_W₀, hη_W₀⟩ := hFuncF W₀ hAffW₀ hNeW₀
    have hfromSpec_W₀ :
        hAffW₀.fromSpec ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_D) := by
      rw [← hAffW₀.isoSpec_inv_ι, CategoryTheory.Category.assoc, ← hW₀_comm,
        ← hAffW₀.isoSpec_hom, ← CategoryTheory.Category.assoc,
        CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]
    have hα_D_comp : φ_W₀.hom.comp α_D = algebraMap Ω F := by
      have hSpec_eq :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_W₀.hom.comp α_D)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω F)) := by
        have hhom : CommRingCat.ofHom (φ_W₀.hom.comp α_D) = CommRingCat.ofHom α_D ≫ φ_W₀ := rfl
        rw [hhom, AlgebraicGeometry.Spec.map_comp, ← hfromSpec_W₀,
          ← CategoryTheory.Category.assoc, hη_W₀, hη_p]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hSpec_eq)
    obtain ⟨P, g₀, α_W, h_D, e_loc, ev_W,
        hMon, hDeg, hIrred, hα_W, _hh_D, he_comp, hev_comp, hFinDim⟩ :=
      weil_algClosed_stdSmooth_domain_plane_curve_away_iso Ω D α_D hSm_D
    obtain ⟨ι_u, hι_u_comp, hFinDimF⟩ := hFinDim F φ_W₀.hom hFrac_W₀
    have hι_u_alg :
        ι_u.comp ((algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω))).comp Polynomial.C) =
          algebraMap Ω F :=
      hι_u_comp.trans hα_D_comp
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom e_loc.symm.toRingHom) :=
      ⟨⟨CommRingCat.ofHom e_loc.toRingHom,
        by
          rw [← CommRingCat.ofHom_comp]
          exact congrArg CommRingCat.ofHom (RingHom.ext e_loc.apply_symm_apply),
        by
          rw [← CommRingCat.ofHom_comp]
          exact congrArg CommRingCat.ofHom (RingHom.ext e_loc.symm_apply_apply)⟩⟩
    have _ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_loc.symm.toRingHom)) :=
      inferInstance
    have _ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap D (Localization.Away h_D)))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization h_D
    let j_W : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g₀)) ⟶ E :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_loc.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D (Localization.Away h_D))) ≫
        hAffW₀.fromSpec
    have hj_W_open : AlgebraicGeometry.IsOpenImmersion j_W := inferInstance
    let pt_W : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g₀)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_W)
    have hj_W_p : j_W ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_W) := by
      dsimp only [j_W]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hfromSpec_W₀,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 2
      change e_loc.symm.toRingHom.comp ((algebraMap D (Localization.Away h_D)).comp α_D) = α_W
      rw [← he_comp]
      ext c
      exact e_loc.symm_apply_apply (α_W c)
    have hj_W_range : Set.range j_W.base ⊆ (U₀ : Set E) := by
      intro y hy
      rcases hy with ⟨w, rfl⟩
      apply hW₀_sub
      have hRangeW₀ : Set.range hAffW₀.fromSpec.base = (W₀ : Set E) :=
        congrArg (fun V : E.Opens => (V : Set E)) hAffW₀.opensRange_fromSpec
      rw [← hRangeW₀]
      exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_loc.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap D (Localization.Away h_D)))).base w, rfl⟩
    have hpt_W_sec : pt_W ≫ j_W ≫ p_E = 𝟙 _ := by
      rw [hj_W_p, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hev_comp]
      exact AlgebraicGeometry.Spec.map_id (CommRingCat.of Ω)
    
    have _ : IrreducibleSpace ↥E := AlgebraicGeometry.irreducibleSpace_of_isIntegral E
    have _ : CompactSpace ↥E := AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p_E
    let pt₀ : PrimeSpectrum Ω := ⟨⊥, inferInstance⟩
    have hOpen_jW : IsOpen (Set.range j_W.base) := j_W.opensRange.isOpen
    have hNe_jW : (Set.range j_W.base).Nonempty := ⟨j_W.base (pt_W.base pt₀), ⟨pt_W.base pt₀, rfl⟩⟩
    have hAffEx : ∀ x : ↥E, ∃ V : E.Opens, AlgebraicGeometry.IsAffineOpen V ∧ x ∈ V := by
      intro x
      obtain ⟨V, hAffV, hxV, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
      exact ⟨V, hAffV, hxV⟩
    choose V_x hAff_x hx_mem using hAffEx
    obtain ⟨t, ht_cov⟩ :=
      isCompact_univ.elim_finite_subcover (fun x : ↥E => (V_x x : Set E))
        (fun x => (V_x x).isOpen)
        (fun x _ => Set.mem_iUnion.mpr ⟨x, hx_mem x⟩)
    have hPerChart :
        ∀ a : ↥t,
          ∃ (m_a : ℕ) (ξ_a : Fin m_a → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E)),
            (∀ i : Fin m_a, ξ_a i ≫ p_E = 𝟙 _) ∧
            (∀ x : ↥E, x ∈ V_x a.1 → x ∉ Set.range j_W.base →
              ∃ i : Fin m_a, x ∈ Set.range (ξ_a i).base) := by
      intro a
      let V_a : E.Opens := V_x a.1
      have hAff_a : AlgebraicGeometry.IsAffineOpen V_a := hAff_x a.1
      have hNe_a : Nonempty ↥V_a := ⟨⟨a.1, hx_mem a.1⟩⟩
      let D_a : Type u := ↑(E.presheaf.obj (Opposite.op V_a))
      have _ : Nonempty ↥(V_a : AlgebraicGeometry.Scheme.{u}) := hNe_a
      have _ : IsDomain D_a := inferInstance
      let α_a : Ω →+* D_a := (AlgebraicGeometry.Spec.preimage (hAff_a.fromSpec ≫ p_E)).hom
      have hSpec_α_a :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_a) = hAff_a.fromSpec ≫ p_E :=
        AlgebraicGeometry.Spec.map_preimage (hAff_a.fromSpec ≫ p_E)
      have hFT_a : (letI : Algebra Ω D_a := α_a.toAlgebra; Algebra.FiniteType Ω D_a) := by
        let _ : Algebra Ω D_a := α_a.toAlgebra
        have h1 : AlgebraicGeometry.LocallyOfFiniteType (hAff_a.fromSpec ≫ p_E) := inferInstance
        rw [← hSpec_α_a,
          AlgebraicGeometry.HasRingHomProperty.Spec_iff
            (P := @AlgebraicGeometry.LocallyOfFiniteType)] at h1
        exact h1
      obtain ⟨φ_a, hFrac_a, hη_a⟩ := hFuncF V_a hAff_a hNe_a
      have hInj_a : Function.Injective φ_a.hom := by
        let _ : Algebra D_a F := φ_a.hom.toAlgebra
        have _ : IsFractionRing D_a F := hFrac_a
        exact IsFractionRing.injective D_a F
      have hComp_a :
          φ_a.hom.comp α_a =
            ι_u.comp
              ((algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω))).comp Polynomial.C) := by
        rw [hι_u_alg]
        have hSpec_eq :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_a.hom.comp α_a)) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω F)) := by
          have hhom : CommRingCat.ofHom (φ_a.hom.comp α_a) = CommRingCat.ofHom α_a ≫ φ_a := rfl
          rw [hhom, AlgebraicGeometry.Spec.map_comp, hSpec_α_a,
            ← CategoryTheory.Category.assoc, hη_a, hη_p]
        exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hSpec_eq)
      have hRange_a : Set.range hAff_a.fromSpec.base = (V_a : Set E) :=
        congrArg (fun V : E.Opens => (V : Set E)) hAff_a.opensRange_fromSpec
      let O_a : Set (PrimeSpectrum D_a) := hAff_a.fromSpec.base ⁻¹' (Set.range j_W.base)
      have hOpen_Oa : IsOpen O_a := hOpen_jW.preimage hAff_a.fromSpec.continuous
      obtain ⟨s_a, hs_a⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus O_aᶜ).mp hOpen_Oa.isClosed_compl
      obtain ⟨z_a, hz_Va, hz_jW⟩ :=
        nonempty_preirreducible_inter V_a.isOpen hOpen_jW ⟨a.1, hx_mem a.1⟩ hNe_jW
      rw [← hRange_a] at hz_Va
      obtain ⟨q₀, rfl⟩ := hz_Va
      have hq₀_not_sub : ¬ (s_a ⊆ (q₀ : PrimeSpectrum D_a).asIdeal) := fun hsub =>
        have hmem : (q₀ : PrimeSpectrum D_a) ∈ PrimeSpectrum.zeroLocus s_a :=
          (PrimeSpectrum.mem_zeroLocus (q₀ : PrimeSpectrum D_a) s_a).mpr hsub
        (hs_a ▸ hmem) hz_jW
      rw [Set.not_subset] at hq₀_not_sub
      obtain ⟨f_a, hf_mem_s, hf_not_q₀⟩ := hq₀_not_sub
      have hf_ne : f_a ≠ 0 := fun h0 => hf_not_q₀ (h0 ▸ q₀.asIdeal.zero_mem)
      obtain ⟨m_a, ev_a, hev_id, hev_ker⟩ :=
        weil_algClosed_trdeg_one_domain_zeroLocus_finite_eval
          Ω F ι_u hFinDimF D_a α_a φ_a.hom hFT_a hInj_a hComp_a f_a hf_ne
      refine ⟨m_a, fun i => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_a i)) ≫
        hAff_a.fromSpec, ?_, ?_⟩
      · intro i
        rw [CategoryTheory.Category.assoc, ← hSpec_α_a, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hev_id]
        exact AlgebraicGeometry.Spec.map_id (CommRingCat.of Ω)
      · intro x hx_Va hx_not_jW
        have hx_range : x ∈ Set.range hAff_a.fromSpec.base := by
          rw [hRange_a]
          exact hx_Va
        obtain ⟨q, rfl⟩ := hx_range
        have hq_zl : q ∈ PrimeSpectrum.zeroLocus s_a := by
          rw [← hs_a]
          exact hx_not_jW
        have hf_in_q : f_a ∈ q.asIdeal := (PrimeSpectrum.mem_zeroLocus q s_a).mp hq_zl hf_mem_s
        obtain ⟨i, hi_ker⟩ := hev_ker q hf_in_q
        refine ⟨i, pt₀, ?_⟩
        have hq_pt₀ :
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_a i))).base pt₀ = q := by
          apply PrimeSpectrum.ext
          ext r
          change r ∈ (PrimeSpectrum.comap (ev_a i) pt₀).asIdeal ↔ r ∈ q.asIdeal
          rw [hi_ker]
          rfl
        change hAff_a.fromSpec.base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_a i))).base pt₀) =
          hAff_a.fromSpec.base q
        rw [hq_pt₀]
    choose m_a ξ_a hξ_sec hξ_cov using hPerChart
    let IdxSigma : Type u := Σ a : ↥t, Fin (m_a a)
    let r : ℕ := Fintype.card IdxSigma
    let e_fin : Fin r ≃ IdxSigma := (Fintype.equivFin IdxSigma).symm
    let ξ : Fin r → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E) :=
      fun ℓ => ξ_a (e_fin ℓ).1 (e_fin ℓ).2
    refine ⟨P, g₀, α_W, j_W, pt_W, r, ξ,
      hMon, hDeg, hIrred, hα_W, hj_W_open, hj_W_p, hj_W_range, hpt_W_sec, ?_, ?_⟩
    · intro ℓ
      exact hξ_sec (e_fin ℓ).1 (e_fin ℓ).2
    · intro x hx_compl
      have hx_univ : x ∈ (Set.univ : Set ↥E) := trivial
      have hx_union := ht_cov hx_univ
      obtain ⟨x₀, hx₀_mem⟩ := Set.mem_iUnion.mp hx_union
      obtain ⟨hx₀_t, hx_Vx₀⟩ := Set.mem_iUnion.mp hx₀_mem
      obtain ⟨i, hi_mem⟩ := hξ_cov ⟨x₀, hx₀_t⟩ x hx_Vx₀ hx_compl
      refine Set.mem_iUnion.mpr ⟨e_fin.symm ⟨⟨x₀, hx₀_t⟩, i⟩, ?_⟩
      dsimp only [ξ]
      rw [Equiv.apply_symm_apply]
      exact hi_mem
  · 
    obtain ⟨hRedE, hArtinLocal⟩ := hArtin.mp hSmNod
    exact weil_algClosed_smoothOrNodal_smooth_or_affine_rank_three_jet Ω E p_E hLFT hRedE
      (fun D _ _ j_D hj_D hj_comm q hq => (hArtinLocal D j_D hj_D hj_comm q hq).imp_right And.left)
      (fun D _ _ _ _ q hq h2 => (weil_algClosed_artin_commRing_smooth_or_nodal_roof Ω D q hq).1 h2)

theorem weil_domain_spreadOut_closed_components_and_incidence_sections (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A]
    (K_bar : Type u) [Field K_bar] [IsAlgClosed K_bar]
    (α_A : A →+* K_bar) (_hInj : Function.Injective α_A)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
    (_hProp : AlgebraicGeometry.IsProper g)
    (_hLFP : AlgebraicGeometry.LocallyOfFinitePresentation g)
    (c m : ℕ) (_hc : 1 ≤ c)
    (E_gen : Fin c → AlgebraicGeometry.Scheme.{u})
    (ι_E : ∀ i : Fin c, E_gen i ⟶
      CategoryTheory.Limits.pullback g (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_A)))
    (pt : Fin m → (AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶
      CategoryTheory.Limits.pullback g (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_A))))
    (inc : Fin m → Fin c × Fin c) :
    (∀ i : Fin c, AlgebraicGeometry.IsClosedImmersion (ι_E i)) →
    (⋃ i : Fin c, Set.range (ι_E i).base) = Set.univ →
    (∀ a : Fin m,
      pt a ≫ CategoryTheory.Limits.pullback.snd g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_A)) = 𝟙 _ ∧
      (∃ s₁ : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶ E_gen (inc a).1,
        s₁ ≫ ι_E (inc a).1 = pt a) ∧
      (∃ s₂ : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶ E_gen (inc a).2,
        s₂ ≫ ι_E (inc a).2 = pt a)) →
    ∃ (B₁ : Type u) (_ : CommRing B₁) (_ : IsDomain B₁)
      (ψ₁ : A →+* B₁) (ι₁ : B₁ →+* K_bar)
      (ℰ₁ : Fin c → AlgebraicGeometry.Scheme.{u})
      (p_ℰ₁ : ∀ i : Fin c, ℰ₁ i ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₁))
      (ι_ℰ₁ : ∀ i : Fin c, ℰ₁ i ⟶ CategoryTheory.Limits.pullback g
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)))
      (σ₁ : Fin m → (AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶
        CategoryTheory.Limits.pullback g (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)))),
      RingHom.FiniteType ψ₁ ∧
      ι₁.comp ψ₁ = α_A ∧
      Function.Injective ι₁ ∧
      (∀ i : Fin c,
        AlgebraicGeometry.IsProper (p_ℰ₁ i) ∧
        AlgebraicGeometry.LocallyOfFinitePresentation (p_ℰ₁ i) ∧
        AlgebraicGeometry.IsClosedImmersion (ι_ℰ₁ i) ∧
        ι_ℰ₁ i ≫ CategoryTheory.Limits.pullback.snd g
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)) = p_ℰ₁ i) ∧
      (⋃ i : Fin c, Set.range (ι_ℰ₁ i).base) = Set.univ ∧
      (∀ a : Fin m,
        σ₁ a ≫ CategoryTheory.Limits.pullback.snd g
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)) = 𝟙 _ ∧
        (∃ s₁ : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶ ℰ₁ (inc a).1,
          s₁ ≫ ι_ℰ₁ (inc a).1 = σ₁ a) ∧
        (∃ s₂ : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶ ℰ₁ (inc a).2,
          s₂ ≫ ι_ℰ₁ (inc a).2 = σ₁ a)) ∧
      (∃ e_Y : CategoryTheory.Limits.pullback
            (CategoryTheory.Limits.pullback.snd g
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁)) ≅
          CategoryTheory.Limits.pullback g
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_A)),
        e_Y.hom ≫ CategoryTheory.Limits.pullback.fst g
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_A)) =
          CategoryTheory.Limits.pullback.fst
              (CategoryTheory.Limits.pullback.snd g
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)))
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁)) ≫
            CategoryTheory.Limits.pullback.fst g
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)) ∧
        e_Y.hom ≫ CategoryTheory.Limits.pullback.snd g
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_A)) =
          CategoryTheory.Limits.pullback.snd
            (CategoryTheory.Limits.pullback.snd g
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)))
