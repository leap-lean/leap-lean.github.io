    · exact hNe1
    · exact hNe_basic0 s₁ hs₁_ne
    · exact hNe_basic0 s_reg hs_reg_ne
  have hSupW : (⨆ i : Fin 3, W i) = ⊤ := by
    rw [eq_top_iff]
    intro y _
    by_cases hy1 : y ∈ U₁
    · exact TopologicalSpace.Opens.mem_iSup.mpr ⟨0, hy1⟩
    · have hy_sup : y ∈ U₀ ⊔ U₁ := by
        rw [hCov]
        trivial
      have hy0 : y ∈ U₀ := by
        rcases hy_sup with hy0 | hy1'
        · exact hy0
        · exact False.elim (hy1 hy1')
      have hy0_range : y ∈ Set.range hU0.fromSpec.base := by
        rw [hU0.range_fromSpec]
        exact hy0
      obtain ⟨q, hq_eq⟩ := hy0_range
      have hy_inf_q : y_inf ∈ q.asIdeal := by
        by_contra hy_not_q
        have hq_bo : q ∈ hU0.fromSpec ⁻¹ᵁ Y.basicOpen y_inf := by
          rw [hU0.fromSpec_preimage_basicOpen y_inf]
          exact hy_not_q
        have hy_bo : y ∈ Y.basicOpen y_inf := by
          rw [← hq_eq]
          exact hq_bo
        rw [hy_inf] at hy_bo
        exact hy1 hy_bo.2
      rcases hAvoid q.asIdeal q.isPrime hy_inf_q with hs₁_out | hs_reg_out
      · have hq_bo : q ∈ hU0.fromSpec ⁻¹ᵁ Y.basicOpen s₁ := by
          rw [hU0.fromSpec_preimage_basicOpen s₁]
          exact hs₁_out
        have hy_bo : y ∈ Y.basicOpen s₁ := by
          rw [← hq_eq]
          exact hq_bo
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨1, hy_bo⟩
      · have hq_bo : q ∈ hU0.fromSpec ⁻¹ᵁ Y.basicOpen s_reg := by
          rw [hU0.fromSpec_preimage_basicOpen s_reg]
          exact hs_reg_out
        have hy_bo : y ∈ Y.basicOpen s_reg := by
          rw [← hq_eq]
          exact hq_bo
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨2, hy_bo⟩
  have hCoverW : TopologicalSpace.IsOpenCover W := TopologicalSpace.IsOpenCover.mk hSupW

  
  have hg0_ex : ∃ (g₀ : U₁.toScheme ⟶ P₁)
      (η_W0 : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ U₁.toScheme),
      g₀ ≫ p_P1 = U₁.ι ≫ p_Y ∧ η_W0 ≫ U₁.ι = η_Y ∧ η_W0 ≫ g₀ = η_X := by
    let η_W0 : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ U₁.toScheme :=
      AlgebraicGeometry.Spec.map φ₁ ≫ hU1.isoSpec.inv
    have hηW0_ι : η_W0 ≫ U₁.ι = η_Y := by
      dsimp [η_W0]
      rw [CategoryTheory.Category.assoc, ← hU1.toSpecΓ_fromSpec,
        ← hU1.isoSpec_hom, CategoryTheory.Iso.inv_hom_id_assoc, hφ₁]
    obtain ⟨ψ₀, hψ₀_c, hψ₀_t⟩ := hUniv_P1 0 R₁ (α_Y U₁) ![1, c_u] rfl
    have hψ₀_F : φ₁.hom.comp ψ₀ = χ_0 := by
      have hSub : Set.range (c_P1 0) ∪ Set.range (t_P1 0) ⊆
          (RingHom.eqLocus (φ₁.hom.comp ψ₀) χ_0 : Set (Γ_chart 0)) := by
        rintro x (⟨r, rfl⟩ | ⟨b, rfl⟩)
        · change φ₁.hom (ψ₀ (c_P1 0 r)) = χ_0 (c_P1 0 r)
          rw [show ψ₀ (c_P1 0 r) = α_Y U₁ r from RingHom.congr_fun hψ₀_c r,
            hφ_α U₁ hU1 φ₁ hφ₁ r, hχ0_c r]
        · change φ₁.hom (ψ₀ (t_P1 0 b)) = χ_0 (t_P1 0 b)
          rcases hFin2 b with rfl | rfl
          · simp only [htDiag_P1 0, map_one]
          · rw [hψ₀_t 1, show (![1, c_u] : Fin (1 + 1) → R₁) 1 = c_u from rfl, hχ0_t]
      have hTop : (⊤ : Subring (Γ_chart 0)) ≤ RingHom.eqLocus (φ₁.hom.comp ψ₀) χ_0 := by
        rw [← hGen_P1 0]
        exact Subring.closure_le.mpr hSub
      ext x
      exact hTop (Subring.mem_top x)
    let ψ₀_hom : P₁.presheaf.obj (Opposite.op (V_chart 0)) ⟶
        Y.presheaf.obj (Opposite.op U₁) := CommRingCat.ofHom ψ₀
    let g₀ : U₁.toScheme ⟶ P₁ :=
      U₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ₀_hom ≫ (hAff_P1 0).fromSpec
    refine ⟨g₀, η_W0, ?_, hηW0_ι, ?_⟩
    · dsimp [g₀]
      have hc_comp : CommRingCat.ofHom (c_P1 0) ≫ ψ₀_hom = CommRingCat.ofHom (α_Y U₁) := by
        ext r
        exact RingHom.congr_fun hψ₀_c r
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← hcSpec_P1 0, ← AlgebraicGeometry.Spec.map_comp, hc_comp,
        hSpec_α U₁ hU1, ← CategoryTheory.Category.assoc, hU1.toSpecΓ_fromSpec]
    · dsimp [g₀, η_W0]
      have hhom : ψ₀_hom ≫ φ₁ = CommRingCat.ofHom χ_0 := by
        ext x
        exact RingHom.congr_fun hψ₀_F x
      rw [← hU1.isoSpec_hom, CategoryTheory.Category.assoc,
        CategoryTheory.Iso.inv_hom_id_assoc, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, hhom]
  have hg1_ex : ∃ (g₁ : (Y.basicOpen s₁).toScheme ⟶ P₁)
      (η_W1 : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (Y.basicOpen s₁).toScheme),
