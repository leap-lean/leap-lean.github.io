        CategoryTheory.Limits.pullback.fst (𝒰_star.f a) (𝒰_star.f b)
      let snd_ab : CategoryTheory.Limits.pullback (ι_D (W₀ a) u_star) (ι_D (W₀ b) u_star) ⟶
