              have huD_val : (↑u_δD : D'_4) = ι_QZD4 δ_Z := hu_δD
              have hζ_val : (↑ζ_D4 : D'_4) = ι_QZD4 ζ := by
                change ι_QZD4 ↑ζ_u = ι_QZD4 ζ
                rw [hζ_u]
              have hx_eq' : w * ι_QZD4 δ_Z ^ m = ι_QZD4 x := hx_eq
              rw [map_mul, Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val,
