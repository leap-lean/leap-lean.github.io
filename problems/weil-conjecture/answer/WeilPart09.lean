    let F_s := P_all.filter (fun p => p.2 = s)
    have hInj_fst : Set.InjOn Sigma.fst (↑F_s : Set (Sigma fun _ : Set ↥Z₀ => ↥Z₀)) := by
      rintro ⟨Z₁, z₁⟩ h₁ ⟨Z₂, z₂⟩ h₂ hEq
      dsimp at hEq
      have hz₁ : z₁ = s := (Finset.mem_filter.mp h₁).2
      have hz₂ : z₂ = s := (Finset.mem_filter.mp h₂).2
      subst hEq hz₁ hz₂
      rfl
    rw [← Finset.card_image_of_injOn hInj_fst]
    by_contra hNotLe
    have h3 : 3 ≤ (F_s.image Sigma.fst).card := by omega
    obtain ⟨U₃, hU₃_sub, hU₃_card⟩ := Finset.le_card_iff_exists_subset_card.mp h3
    obtain ⟨Z₁, Z₂, Z₃, hZ12, hZ13, hZ23, rfl⟩ := Finset.card_eq_three.mp hU₃_card
    have hMemImg : ∀ Z ∈ ({Z₁, Z₂, Z₃} : Finset (Set ↥Z₀)),
        Z ∈ irreducibleComponents ↥Z₀ ∧ s ∈ Z := by
      intro Z hZ_mem
      have hZ_in : Z ∈ F_s.image Sigma.fst := hU₃_sub hZ_mem
      rcases Finset.mem_image.mp hZ_in with ⟨⟨Z', z'⟩, hp_mem, rfl⟩
      rcases Finset.mem_filter.mp hp_mem with ⟨hp_all, rfl⟩
      rcases Finset.mem_sigma.mp hp_all with ⟨hZ'_C, hs_T⟩
      exact ⟨hFinC.mem_toFinset.mp hZ'_C, (hT_mem Z' hZ'_C z' hs_T).1⟩
    obtain ⟨hZ₁_c, hs₁⟩ := hMemImg Z₁ (by simp)
    obtain ⟨hZ₂_c, hs₂⟩ := hMemImg Z₂ (by simp)
    obtain ⟨hZ₃_c, hs₃⟩ := hMemImg Z₃ (by simp)
    rcases hAtMost2 s hs_inter Z₁ hZ₁_c Z₂ hZ₂_c Z₃ hZ₃_c hs₁ hs₂ hs₃ with h | h | h
    · exact hZ12 h
    · exact hZ13 h
    · exact hZ23 h
  have hP_in_le : P_in.card ≤ 2 * S_fin.card := by
    calc
      P_in.card ≤ (S_fin.biUnion (fun s => P_all.filter (fun p => p.2 = s))).card :=
        Finset.card_le_card hP_in_sub
      _ ≤ ∑ s ∈ S_fin, (P_all.filter (fun p => p.2 = s)).card :=
        Finset.card_biUnion_le
      _ ≤ ∑ _s ∈ S_fin, 2 := Finset.sum_le_sum hFiber_le
      _ = 2 * S_fin.card := by rw [Finset.sum_const, smul_eq_mul, mul_comm]
  have hP_out_ge : 3 ≤ P_out.card := by omega
  have hOut_prop : ∀ p ∈ P_out,
      p.1 ∈ irreducibleComponents ↥Z₀ ∧ p.2 ∈ p.1 ∧ p.2 ∈ B_ext := by
    intro p hp
    rcases Finset.mem_filter.mp hp with ⟨hp_all, hp_not_S⟩
    rcases Finset.mem_sigma.mp hp_all with ⟨hp1_C, hp2_T⟩
    obtain ⟨hp2_in_p1, hp2_or⟩ := hT_mem p.1 hp1_C p.2 hp2_T
    have hp2_B : p.2 ∈ B_ext := by
      rcases hp2_or with hInS | hInB
      · exact False.elim (hp_not_S (hFinS.mem_toFinset.mpr hInS))
      · exact hInB
    exact ⟨hFinC.mem_toFinset.mp hp1_C, hp2_in_p1, hp2_B⟩
  have hInj_snd : Set.InjOn Sigma.snd (↑P_out : Set (Sigma fun _ : Set ↥Z₀ => ↥Z₀)) := by
    rintro ⟨Z₁, z₁⟩ h₁ ⟨Z₂, z₂⟩ h₂ hEq
    dsimp at hEq
    obtain ⟨hZ₁_c, hz₁_Z₁, hz₁_B⟩ := hOut_prop ⟨Z₁, z₁⟩ h₁
    obtain ⟨hZ₂_c, hz₂_Z₂, _⟩ := hOut_prop ⟨Z₂, z₂⟩ h₂
    subst hEq
    have hZ_eq : Z₁ = Z₂ := hE4 z₁ hz₁_B Z₁ hZ₁_c Z₂ hZ₂_c hz₁_Z₁ hz₂_Z₂
    subst hZ_eq
    rfl
  have hImg_ge : 3 ≤ (P_out.image Sigma.snd).card := by
    rwa [Finset.card_image_of_injOn hInj_snd]
  obtain ⟨W₃, hW₃_sub, hW₃_card⟩ := Finset.le_card_iff_exists_subset_card.mp hImg_ge
  obtain ⟨z₁, z₂, z₃, hz12, hz13, hz23, rfl⟩ := Finset.card_eq_three.mp hW₃_card
  apply hNo3Z0
  refine ⟨z₁, z₂, z₃, hz12, hz13, hz23, ?_⟩
  intro z hz_set
  have hz_fin : z ∈ ({z₁, z₂, z₃} : Finset ↥Z₀) := by
    simpa using hz_set
  rcases Finset.mem_image.mp (hW₃_sub hz_fin) with ⟨p, hp_out, rfl⟩
  exact (hOut_prop p hp_out).2.2

theorem weil_closed_fiber_stable_to_all_geom_fibers_stable (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C_V : AlgebraicGeometry.Scheme.{u})
    (g_V : C_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ_V : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_V))
    (ι_gen : C_K ⟶ C_V)
    (hSemiV : IsSemistableValuationPointedModel V p_K n σ_K C_V g_V τ_V ι_gen)
    (hStabClosed : HasStablePointedGeomFiber g_V n τ_V
      (IsLocalRing.maximalIdeal ↥V).ResidueField
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))) :
    IsGeometricStablePointedCurve g_V n τ_V :=
by
  obtain ⟨hMod, hDisj, hSmSec, hGeom⟩ := hSemiV
  obtain ⟨_hIntCV, hFlat, hProp, hLFP, hSurj, ⟨M, ιP, hClP, hCommP⟩, hSec, hPb, hSec_ι⟩ := hMod
  refine ⟨hStabCK.1, hFlat, hProp, hLFP, hSurj, hSec, hDisj, hSmSec, ?_⟩
  intro K' _ _ s
  refine ⟨(hGeom K' s).1, (hGeom K' s).2, ?_⟩
  change HasStablePointedGeomFiber g_V n τ_V K' s
  let φ_s : ↥V →+* K' := (AlgebraicGeometry.Spec.preimage s).hom
  have hs_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_s) = s := by
    simpa [φ_s] using AlgebraicGeometry.Spec.map_preimage s
  let P : Ideal ↥V := RingHom.ker φ_s
  haveI hPPrime : P.IsPrime := RingHom.ker_isPrime φ_s
  by_cases hP : P = ⊥
  · 
    have hInj : Function.Injective φ_s := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      have haP : a ∈ P := ha
      rwa [hP, Ideal.mem_bot] at haP
    have hUnits : ∀ y : nonZeroDivisors ↥V, IsUnit (φ_s y) := by
      intro y
      have hy0 : (y : ↥V) ≠ 0 := nonZeroDivisors.ne_zero y.2
      exact IsUnit.mk0 (φ_s y) (fun h0 => hy0 (hInj (h0.trans φ_s.map_zero.symm)))
    let ψ_K : K →+* K' := IsLocalization.lift (M := nonZeroDivisors ↥V) (S := K) hUnits
    have hψ_comp : ψ_K.comp V.subtype = φ_s := by
      ext x
      exact IsLocalization.lift_eq (M := nonZeroDivisors ↥V) (S := K) hUnits x
    let η_V : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
    let s_K : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
        AlgebraicGeometry.Spec (CommRingCat.of K) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_K)
    have hs_K : s_K ≫ η_V = s := by
      dsimp [s_K, η_V]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ_comp, hs_eq]
    have hPb_paste : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst p_K s_K ≫ ι_gen)
        (CategoryTheory.Limits.pullback.snd p_K s_K) g_V s := by
      have h := (CategoryTheory.IsPullback.of_hasPullback p_K s_K).paste_horiz hPb
      dsimp [η_V] at hs_K
      rwa [hs_K] at h
    let Φ : CategoryTheory.Limits.pullback p_K s_K ≅
        CategoryTheory.Limits.pullback g_V s :=
      hPb_paste.isoPullback
    have hΦ_hom_fst : Φ.hom ≫ CategoryTheory.Limits.pullback.fst g_V s =
        CategoryTheory.Limits.pullback.fst p_K s_K ≫ ι_gen :=
      hPb_paste.isoPullback_hom_fst
    have hΦ_inv_snd : Φ.inv ≫ CategoryTheory.Limits.pullback.snd p_K s_K =
        CategoryTheory.Limits.pullback.snd g_V s :=
      hPb_paste.isoPullback_inv_snd
    have hΦ_left : ∀ x : ↥(CategoryTheory.Limits.pullback p_K s_K),
        Φ.inv.base (Φ.hom.base x) = x := by
      intro x
      simp
    have hΦ_right : ∀ y : ↥(CategoryTheory.Limits.pullback g_V s),
        Φ.hom.base (Φ.inv.base y) = y := by
      intro y
      simp
    have hIrredBwd : ∀ S : Set ↥(CategoryTheory.Limits.pullback g_V s),
        S ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_V s) →
        Φ.inv.base '' S ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback p_K s_K) := by
      intro S ⟨hSIrred, hSMax⟩
      refine ⟨hSIrred.image Φ.inv.base Φ.inv.continuous.continuousOn, ?_⟩
      intro T hTIrred hST
      have hSub : S ⊆ Φ.hom.base '' T := by
        intro y hy
        exact ⟨Φ.inv.base y, hST ⟨y, hy, rfl⟩, hΦ_right y⟩
      have hEq : Φ.hom.base '' T ⊆ S :=
        hSMax (hTIrred.image Φ.hom.base Φ.hom.continuous.continuousOn) hSub
      intro x hx
      exact ⟨Φ.hom.base x, hEq ⟨x, hx, rfl⟩, hΦ_left x⟩
    have hIrredFwd : ∀ T : Set ↥(CategoryTheory.Limits.pullback p_K s_K),
        T ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback p_K s_K) →
        Φ.hom.base '' T ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_V s) := by
      intro T ⟨hTIrred, hTMax⟩
      refine ⟨hTIrred.image Φ.hom.base Φ.hom.continuous.continuousOn, ?_⟩
      intro S hSIrred hTS
      have hSub : T ⊆ Φ.inv.base '' S := by
        intro x hx
        exact ⟨Φ.hom.base x, hTS ⟨x, hx, rfl⟩, hΦ_left x⟩
      have hEq : Φ.inv.base '' S ⊆ T :=
        hTMax (hSIrred.image Φ.inv.base Φ.inv.continuous.continuousOn) hSub
      intro y hy
      exact ⟨Φ.inv.base y, hEq ⟨y, hy, rfl⟩, hΦ_right y⟩
    intro E E_sch ιE hE_comp hCl_ιE hInt_E hRange_ιE ⟨isoP1, hisoP1⟩
    let E_K : Set ↥(CategoryTheory.Limits.pullback p_K s_K) := Φ.inv.base '' E
    let ιE_K : E_sch ⟶ CategoryTheory.Limits.pullback p_K s_K := ιE ≫ Φ.inv
    have hEK_comp : E_K ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback p_K s_K) :=
      hIrredBwd E hE_comp
    have hCl_ιEK : AlgebraicGeometry.IsClosedImmersion ιE_K := inferInstance
    have hRange_ιEK : Set.range ιE_K.base = E_K := by
      ext x
      have h_app : ∀ z : ↥E_sch, ιE_K.base z = Φ.inv.base (ιE.base z) := fun _ => rfl
      simp only [E_K, Set.mem_range, Set.mem_image, h_app]
      constructor
      · rintro ⟨z, rfl⟩
        exact ⟨ιE.base z, by rw [← hRange_ιE]; exact ⟨z, rfl⟩, rfl⟩
      · rintro ⟨y, hy, rfl⟩
        rw [← hRange_ιE] at hy
        rcases hy with ⟨z, rfl⟩
        exact ⟨z, rfl⟩
    have hisoP1_K : ιE_K ≫ CategoryTheory.Limits.pullback.snd p_K s_K =
        isoP1.hom ≫ (weilProjectiveSpaceOver K' 1).hom := by
      dsimp [ιE_K]
      rw [CategoryTheory.Category.assoc, hΦ_inv_snd, hisoP1]
    obtain ⟨q'₁, q'₂, q'₃, hne12', hne13', hne23', hq'₁E, hq'₂E, hq'₃E, hSpec'⟩ :=
      (hStabCK.2.2.2.2.2.2.2.2 K' s_K).2.2 E_K E_sch ιE_K
        hEK_comp hCl_ιEK hInt_E hRange_ιEK ⟨isoP1, hisoP1_K⟩
    refine ⟨Φ.hom.base q'₁, Φ.hom.base q'₂, Φ.hom.base q'₃,
      fun h => hne12' (by rw [← hΦ_left q'₁, ← hΦ_left q'₂, h]),
      fun h => hne13' (by rw [← hΦ_left q'₁, ← hΦ_left q'₃, h]),
      fun h => hne23' (by rw [← hΦ_left q'₂, ← hΦ_left q'₃, h]),
      ?_, ?_, ?_, ?_⟩
    · rcases hq'₁E with ⟨y, hy, hyeq⟩
      rw [← hyeq, hΦ_right y]
      exact hy
    · rcases hq'₂E with ⟨y, hy, hyeq⟩
      rw [← hyeq, hΦ_right y]
      exact hy
    · rcases hq'₃E with ⟨y, hy, hyeq⟩
      rw [← hyeq, hΦ_right y]
      exact hy
    · intro q hq
      have hq' : Φ.inv.base q ∈
          ({q'₁, q'₂, q'₃} : Set ↥(CategoryTheory.Limits.pullback p_K s_K)) := by
        rcases hq with rfl | rfl | rfl
        · simp [hΦ_left]
        · simp [hΦ_left]
        · simp [hΦ_left]
      rcases hSpec' (Φ.inv.base q) hq' with ⟨E'_K, hE'K_comp, hE'K_ne, hq'E'K⟩ | ⟨j, x_K, hx_K⟩
      · left
        refine ⟨Φ.hom.base '' E'_K, hIrredFwd E'_K hE'K_comp, ?_,
          ⟨Φ.inv.base q, hq'E'K, hΦ_right q⟩⟩
        intro hEq
        apply hE'K_ne
        ext x
        constructor
        · intro hx
          have h1 : Φ.hom.base x ∈ E := by
            rw [← hEq]
            exact ⟨x, hx, rfl⟩
          exact ⟨Φ.hom.base x, h1, hΦ_left x⟩
        · rintro ⟨y, hy, rfl⟩
          have hy' : y ∈ Φ.hom.base '' E'_K := by
            rw [hEq]
            exact hy
          rcases hy' with ⟨x', hx', hxy'⟩
          rw [← hxy', hΦ_left x']
          exact hx'
      · right
        refine ⟨j, η_V.base x_K, ?_⟩
        have h1 : (CategoryTheory.Limits.pullback.fst g_V s).base q =
            ι_gen.base ((CategoryTheory.Limits.pullback.fst p_K s_K).base (Φ.inv.base q)) := by
          have h_eval := congrArg (fun f => f.base (Φ.inv.base q)) hΦ_hom_fst
          have h_lhs : (Φ.hom ≫ CategoryTheory.Limits.pullback.fst g_V s).base (Φ.inv.base q) =
              (CategoryTheory.Limits.pullback.fst g_V s).base (Φ.hom.base (Φ.inv.base q)) := by
            simp
          have h_rhs : (CategoryTheory.Limits.pullback.fst p_K s_K ≫ ι_gen).base (Φ.inv.base q) =
              ι_gen.base ((CategoryTheory.Limits.pullback.fst p_K s_K).base (Φ.inv.base q)) := by
            simp
          rw [h_lhs, hΦ_right q, h_rhs] at h_eval
          exact h_eval
        rw [h1, ← hx_K]
        have h2 := congrArg (fun f => f.base x_K) (hSec_ι j)
        have h2_lhs : (σ_K j ≫ ι_gen).base x_K = ι_gen.base ((σ_K j).base x_K) := by
          simp
        have h2_rhs : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) ≫ τ_V j).base x_K =
            (τ_V j).base (η_V.base x_K) := rfl
        rw [h2_lhs, h2_rhs] at h2
        exact h2.symm
  · 
    haveI hAlgP : IsAlgClosed P.ResidueField := hPkg.2.2.2.2.1 P hP
    haveI hAlgMax : IsAlgClosed (IsLocalRing.maximalIdeal ↥V).ResidueField :=
      hPkg.2.2.2.2.1 (IsLocalRing.maximalIdeal ↥V) hMaxNeBot
    haveI hDomQuot : IsDomain (↥V ⧸ P) := Ideal.Quotient.isDomain P
    let φ_quot : ↥V ⧸ P →+* K' := RingHom.kerLift φ_s
    have hInj_quot : Function.Injective φ_quot := RingHom.kerLift_injective φ_s
    have hUnits_quot : ∀ y : nonZeroDivisors (↥V ⧸ P), IsUnit (φ_quot y) := by
      intro y
      have hy0 : (y : ↥V ⧸ P) ≠ 0 := nonZeroDivisors.ne_zero y.2
      exact IsUnit.mk0 (φ_quot y) (fun h0 => hy0 (hInj_quot (h0.trans φ_quot.map_zero.symm)))
    let ι_PK' : P.ResidueField →+* K' :=
      IsLocalization.lift (M := nonZeroDivisors (↥V ⧸ P)) (S := P.ResidueField) hUnits_quot
    have hι_comp : ι_PK'.comp (algebraMap ↥V P.ResidueField) = φ_s := by
      ext x
      change ι_PK' (algebraMap ↥V P.ResidueField x) = φ_s x
      rw [IsScalarTower.algebraMap_apply ↥V (↥V ⧸ P) P.ResidueField x]
      exact (IsLocalization.lift_eq (M := nonZeroDivisors (↥V ⧸ P))
        (S := P.ResidueField) hUnits_quot (Ideal.Quotient.mk P x)).trans
        (RingHom.kerLift_mk φ_s x)
    let s_P : AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))
    have hs_P : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_PK') ≫ s_P = s := by
      dsimp [s_P]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hι_comp, hs_eq]
    suffices hStabP : HasStablePointedGeomFiber g_V n τ_V P.ResidueField s_P from
      weil_hasStablePointedGeomFiber_algClosed_ext C_V
        (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) g_V n τ_V hSec
        P.ResidueField K' ι_PK' s_P s hs_P hStabP
    by_cases hPMax : P = IsLocalRing.maximalIdeal ↥V
    · 
      haveI hPIsMax : P.IsMaximal := hPMax ▸ IsLocalRing.maximalIdeal.isMaximal ↥V
      let q₁ : ↥V →+* (IsLocalRing.maximalIdeal ↥V).ResidueField :=
        algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField
      let q₂ : ↥V →+* P.ResidueField := algebraMap ↥V P.ResidueField
      have hq₁_surj : Function.Surjective q₁ :=
        Ideal.algebraMap_residueField_surjective (IsLocalRing.maximalIdeal ↥V)
      have hq₂_surj : Function.Surjective q₂ :=
        Ideal.algebraMap_residueField_surjective P
      have hq_ker : RingHom.ker q₁ = RingHom.ker q₂ := by
        dsimp [q₁, q₂]
        rw [Ideal.ker_algebraMap_residueField, Ideal.ker_algebraMap_residueField, hPMax]
      let e_max : (IsLocalRing.maximalIdeal ↥V).ResidueField ≃+* P.ResidueField :=
        (RingHom.quotientKerEquivOfSurjective hq₁_surj).symm.trans
          ((Ideal.quotEquivOfEq hq_ker).trans (RingHom.quotientKerEquivOfSurjective hq₂_surj))
      have he_comp : e_max.toRingHom.comp q₁ = q₂ := by
        ext x
        dsimp [e_max]
        have hx₁ : (RingHom.quotientKerEquivOfSurjective hq₁_surj)
            (Ideal.Quotient.mk (RingHom.ker q₁) x) = q₁ x := rfl
        rw [← hx₁, RingEquiv.symm_apply_apply]
        rfl
      have hs_max : AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_max.toRingHom) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)) =
          s_P := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        exact congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) he_comp
      exact weil_hasStablePointedGeomFiber_algClosed_ext C_V
        (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) g_V n τ_V hSec
        (IsLocalRing.maximalIdeal ↥V).ResidueField P.ResidueField e_max.toRingHom
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))
        s_P hs_max hStabClosed
    · 
      let π_R : ↥V →+* ↥V ⧸ P := Ideal.Quotient.mk P
      have hSurjπ : Function.Surjective π_R := Ideal.Quotient.mk_surjective
      haveI hValR : ValuationRing (↥V ⧸ P) := by
        rw [ValuationRing.iff_dvd_total]
        refine ⟨fun a b => ?_⟩
        obtain ⟨x, rfl⟩ := hSurjπ a
        obtain ⟨y, rfl⟩ := hSurjπ b
        rcases ((ValuationRing.iff_dvd_total (R := ↥V)).mp inferInstance).total x y with
          ⟨z, rfl⟩ | ⟨z, rfl⟩
        · exact Or.inl ⟨π_R z, map_mul π_R x z⟩
        · exact Or.inr ⟨π_R z, map_mul π_R y z⟩
      haveI hFinSpecV : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hPkg.1
      haveI hFinSpecR : Finite (PrimeSpectrum (↥V ⧸ P)) :=
        Finite.of_injective _ (PrimeSpectrum.comap_injective_of_surjective π_R hSurjπ)
      have hP_le_max : P ≤ IsLocalRing.maximalIdeal ↥V :=
        IsLocalRing.le_maximalIdeal hPPrime.ne_top
      have hComapMax : Ideal.comap π_R (IsLocalRing.maximalIdeal (↥V ⧸ P)) =
          IsLocalRing.maximalIdeal ↥V := by
        apply le_antisymm
        · have hPr : (Ideal.comap π_R (IsLocalRing.maximalIdeal (↥V ⧸ P))).IsPrime :=
            Ideal.comap_isPrime π_R (IsLocalRing.maximalIdeal (↥V ⧸ P))
          exact IsLocalRing.le_maximalIdeal hPr.ne_top
        · intro x hx
          rw [Ideal.mem_comap]
          by_contra hxNotMem
          have hxUnit : IsUnit (π_R x) := IsLocalRing.notMem_maximalIdeal.mp hxNotMem
          obtain ⟨u, hu⟩ := hxUnit
          obtain ⟨y, hy⟩ := hSurjπ (↑u⁻¹ : ↥V ⧸ P)
          have hmul : π_R (x * y) = 1 := by
            rw [map_mul, ← hu, hy, Units.mul_inv]
          have hsub : 1 - x * y ∈ P := by
            rw [← Ideal.Quotient.eq_zero_iff_mem]
            change π_R (1 - x * y) = 0
            rw [map_sub, map_one, hmul, sub_self]
          have h1 : (1 : ↥V) ∈ IsLocalRing.maximalIdeal ↥V := by
            have hxy : x * y ∈ IsLocalRing.maximalIdeal ↥V :=
              Ideal.mul_mem_right y _ hx
            have h1_eq : (1 : ↥V) = (1 - x * y) + x * y := (sub_add_cancel 1 (x * y)).symm
            rw [h1_eq]
            exact Ideal.add_mem _ (hP_le_max hsub) hxy
          exact (IsLocalRing.maximalIdeal.isMaximal ↥V).ne_top
            (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
      have hMaxR : IsLocalRing.maximalIdeal (↥V ⧸ P) ≠ ⊥ := by
        have hNotLe : ¬ IsLocalRing.maximalIdeal ↥V ≤ P := fun hle =>
          hPMax (le_antisymm hP_le_max hle)
        obtain ⟨x, hxMax, hxNotP⟩ := Set.not_subset.mp hNotLe
        intro hBot
        have hxMemR : π_R x ∈ IsLocalRing.maximalIdeal (↥V ⧸ P) := by
          rw [← Ideal.mem_comap, hComapMax]
          exact hxMax
        rw [hBot, Ideal.mem_bot] at hxMemR
        exact hxNotP (Ideal.Quotient.eq_zero_iff_mem.mp hxMemR)
      haveI hHensV : HenselianLocalRing ↥V := hPkg.2.2.1
      haveI hHensR : HenselianLocalRing (↥V ⧸ P) := by
        refine HenselianLocalRing.mk ?_
        intro f hf a₀ ha₀ hderiv
        have hf_lifts : f ∈ Polynomial.lifts π_R := by
          rw [Polynomial.lifts_iff_coeff_lifts]
          intro k
          exact hSurjπ (f.coeff k)
        obtain ⟨F, hF_map, _hF_deg, hF_monic⟩ :=
          Polynomial.lifts_and_natDegree_eq_and_monic hf_lifts hf
        obtain ⟨A₀, rfl⟩ := hSurjπ a₀
        have hFEval : Polynomial.eval A₀ F ∈ IsLocalRing.maximalIdeal ↥V := by
          rw [← hComapMax, Ideal.mem_comap, ← Polynomial.eval_map_apply, hF_map]
          exact ha₀
        have hFDeriv : IsUnit (Polynomial.eval A₀ (Polynomial.derivative F)) := by
          rw [← IsLocalRing.notMem_maximalIdeal, ← hComapMax, Ideal.mem_comap,
            ← Polynomial.eval_map_apply, ← Polynomial.derivative_map, hF_map]
          exact IsLocalRing.notMem_maximalIdeal.mpr hderiv
        obtain ⟨A, hARoot, hADiff⟩ :=
          HenselianLocalRing.is_henselian F hF_monic A₀ hFEval hFDeriv
        refine ⟨π_R A, ?_, ?_⟩
        · rw [Polynomial.IsRoot.def, ← hF_map, Polynomial.eval_map_apply]
          rw [Polynomial.IsRoot.def] at hARoot
          rw [hARoot, map_zero]
        · rw [← map_sub]
          have hMem : A - A₀ ∈ Ideal.comap π_R (IsLocalRing.maximalIdeal (↥V ⧸ P)) := by
            rw [hComapMax]
            exact hADiff
          exact hMem
      let q₁ : ↥V →+* (IsLocalRing.maximalIdeal ↥V).ResidueField :=
        algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField
      let q₂ : ↥V →+* IsLocalRing.ResidueField (↥V ⧸ P) :=
        (IsLocalRing.residue (↥V ⧸ P)).comp π_R
      have hq₁_surj : Function.Surjective q₁ :=
        Ideal.algebraMap_residueField_surjective (IsLocalRing.maximalIdeal ↥V)
      have hq₂_surj : Function.Surjective q₂ :=
        (IsLocalRing.residue_surjective (R := ↥V ⧸ P)).comp hSurjπ
      have hq_ker : RingHom.ker q₁ = RingHom.ker q₂ := by
        have hk₁ : RingHom.ker q₁ = IsLocalRing.maximalIdeal ↥V :=
          Ideal.ker_algebraMap_residueField (IsLocalRing.maximalIdeal ↥V)
        have hk₂ : RingHom.ker q₂ = IsLocalRing.maximalIdeal ↥V := by
          ext x
          change IsLocalRing.residue (↥V ⧸ P) (π_R x) = 0 ↔ x ∈ IsLocalRing.maximalIdeal ↥V
          rw [← RingHom.mem_ker, IsLocalRing.ker_residue, ← Ideal.mem_comap, hComapMax]
        exact hk₁.trans hk₂.symm
      let θ₀ : (IsLocalRing.maximalIdeal ↥V).ResidueField ≃+*
          IsLocalRing.ResidueField (↥V ⧸ P) :=
        (RingHom.quotientKerEquivOfSurjective hq₁_surj).symm.trans
          ((Ideal.quotEquivOfEq hq_ker).trans (RingHom.quotientKerEquivOfSurjective hq₂_surj))
      have hθ₀_comp : θ₀.toRingHom.comp q₁ = q₂ := by
        ext x
        dsimp [θ₀]
        have hx₁ : (RingHom.quotientKerEquivOfSurjective hq₁_surj)
            (Ideal.Quotient.mk (RingHom.ker q₁) x) = q₁ x := rfl
        rw [← hx₁, RingEquiv.symm_apply_apply]
        rfl
      have hAlgRes : IsAlgClosed (IsLocalRing.ResidueField (↥V ⧸ P)) :=
        IsAlgClosed.of_ringEquiv _ _ θ₀
      have hs_res : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀.toRingHom) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((IsLocalRing.residue (↥V ⧸ P)).comp π_R)) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        exact congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) hθ₀_comp
      have hStabClosedR : HasStablePointedGeomFiber g_V n τ_V
          (IsLocalRing.ResidueField (↥V ⧸ P))
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((IsLocalRing.residue (↥V ⧸ P)).comp π_R))) := by
        letI : IsAlgClosed (IsLocalRing.ResidueField (↥V ⧸ P)) := hAlgRes
        exact weil_hasStablePointedGeomFiber_algClosed_ext C_V
          (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) g_V n τ_V hSec
          (IsLocalRing.maximalIdeal ↥V).ResidueField (IsLocalRing.ResidueField (↥V ⧸ P))
          θ₀.toRingHom
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((IsLocalRing.residue (↥V ⧸ P)).comp π_R)))
          hs_res hStabClosed
      have hSpecRes : HasStablePointedGeomFiber g_V n τ_V P.ResidueField
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((algebraMap (↥V ⧸ P) P.ResidueField).comp π_R))) :=
        weil_henselian_valuationRing_semistable_p1_specialization
          ↥V (↥V ⧸ P) π_R hSurjπ hMaxR P.ResidueField hAlgRes M
          C_V g_V n hStabCK.1 τ_V ιP hClP hCommP
          hFlat hProp hLFP hSurj hSec hDisj hSmSec hGeom
          (weil_algClosed_valuationRing_proj_p1_closure_connected (↥V ⧸ P) hMaxR P.ResidueField M)
          (weil_henselian_valuationRing_etale_nodal_lift (↥V ⧸ P) hMaxR hAlgRes)
          hStabClosedR
      have hTowerEq : (algebraMap (↥V ⧸ P) P.ResidueField).comp π_R =
          algebraMap ↥V P.ResidueField := by
        ext x
        exact (IsScalarTower.algebraMap_apply ↥V (↥V ⧸ P) P.ResidueField x).symm
      simpa only [s_P, hTowerEq] using hSpecRes

theorem weil_global_semistable_curve_stabilization_contraction (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ_semi : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
    (ι_semi : C_K ⟶ C_semi)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C_semi g_semi τ_semi ι_semi) :
    ∃ (C_V : AlgebraicGeometry.Scheme.{u})
      (g_V : C_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (τ_V : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_V))
      (ι_gen : C_K ⟶ C_V),
      IsGeometricStablePointedCurve g_V n τ_V ∧
      CategoryTheory.IsPullback ι_gen p_K g_V (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
      (∀ j : Fin n, σ_K j ≫ ι_gen =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) ≫ τ_V j) :=
by
  by_cases hMax : IsLocalRing.maximalIdeal ↥V = ⊥
  · 
    have hAllMem : ∀ a : K, a ∈ V := by
      intro a
      by_contra ha
      have ha0 : a ≠ 0 := by
        intro h0
        exact ha (h0 ▸ V.zero_mem)
      have hainv : a⁻¹ ∈ V := (ValuationSubring.mem_or_inv_mem V a).resolve_left ha
      let y : ↥V := ⟨a⁻¹, hainv⟩
      have hy0 : y ≠ 0 := by
        intro hy
        have : a⁻¹ = 0 := congrArg Subtype.val hy
        exact inv_ne_zero ha0 this
      have hyNotMem : y ∉ IsLocalRing.maximalIdeal ↥V := by
        rw [hMax, Ideal.mem_bot]
        exact hy0
      have hyUnit : IsUnit y := IsLocalRing.notMem_maximalIdeal.mp hyNotMem
      obtain ⟨u, hu⟩ := hyUnit
      have hmul : (u : ↥V) * ↑(u⁻¹) = 1 := Units.mul_inv u
      rw [hu] at hmul
      have hmulK : a⁻¹ * ((↑(u⁻¹) : ↥V) : K) = 1 := by
        simpa using congrArg (V.subtype : ↥V →+* K) hmul
      have ha_eq : ((↑(u⁻¹) : ↥V) : K) = a := by
        calc
          ((↑(u⁻¹) : ↥V) : K) = a * (a⁻¹ * ((↑(u⁻¹) : ↥V) : K)) := by
            rw [← mul_assoc, mul_inv_cancel₀ ha0, one_mul]
          _ = a := by rw [hmulK, mul_one]
      exact ha (ha_eq ▸ (↑(u⁻¹) : ↥V).2)
    have hBij : Function.Bijective V.subtype := by
      refine ⟨fun x₁ x₂ h => Subtype.ext h, ?_⟩
      intro a
      exact ⟨⟨a, hAllMem a⟩, rfl⟩
    let e_ring : ↥V ≃+* K := RingEquiv.ofBijective V.subtype hBij
    let φ_ring : CommRingCat.of ↥V ⟶ CommRingCat.of K := CommRingCat.ofHom V.subtype
    let ψ_ring : CommRingCat.of K ⟶ CommRingCat.of ↥V := CommRingCat.ofHom e_ring.symm.toRingHom
    have hφψ : φ_ring ≫ ψ_ring = 𝟙 (CommRingCat.of ↥V) := by
      ext x
      exact congrArg Subtype.val (e_ring.symm_apply_apply x)
    have hψφ : ψ_ring ≫ φ_ring = 𝟙 (CommRingCat.of K) := by
      ext a
      exact e_ring.apply_symm_apply a
    have hIsoφ : CategoryTheory.IsIso φ_ring := ⟨⟨ψ_ring, hφψ, hψφ⟩⟩
    let η_V : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map φ_ring
    have hIsoη : CategoryTheory.IsIso η_V := inferInstance
    obtain ⟨hMod, hDisj, hSmSec, hGeom⟩ := hSemi
    obtain ⟨_hInt, hFlat, hProp, hLFP, hSurj, _hProj, hSec, hPb, hSec_ι⟩ := hMod
    have hIsoι : CategoryTheory.IsIso ι_semi :=
      CategoryTheory.IsPullback.isIso_fst_of_isIso hPb
    refine ⟨C_semi, g_semi, τ_semi, ι_semi, ?_, hPb, hSec_ι⟩
    refine ⟨hStabCK.1, hFlat, hProp, hLFP, hSurj, hSec, hDisj, hSmSec, ?_⟩
    intro K' _ _ s
    refine ⟨(hGeom K' s).1, (hGeom K' s).2, ?_⟩
    let s_K : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
        AlgebraicGeometry.Spec (CommRingCat.of K) :=
      s ≫ CategoryTheory.inv η_V
    have hs_K : s_K ≫ η_V = s := by
      dsimp [s_K]
      simp
    have h_inv_ι_pK : CategoryTheory.inv ι_semi ≫ p_K = g_semi ≫ CategoryTheory.inv η_V := by
      rw [CategoryTheory.IsIso.inv_comp_eq]
      rw [← CategoryTheory.Category.assoc, hPb.w, CategoryTheory.Category.assoc,
        CategoryTheory.IsIso.hom_inv_id, CategoryTheory.Category.comp_id]
    let Φ_hom : CategoryTheory.Limits.pullback g_semi s ⟶
        CategoryTheory.Limits.pullback p_K s_K :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g_semi s ≫ CategoryTheory.inv ι_semi)
        (CategoryTheory.Limits.pullback.snd g_semi s)
        (by
          rw [CategoryTheory.Category.assoc, h_inv_ι_pK,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
            CategoryTheory.Category.assoc])
    let Φ_inv : CategoryTheory.Limits.pullback p_K s_K ⟶
        CategoryTheory.Limits.pullback g_semi s :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst p_K s_K ≫ ι_semi)
        (CategoryTheory.Limits.pullback.snd p_K s_K)
        (by
          rw [CategoryTheory.Category.assoc, hPb.w,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
            CategoryTheory.Category.assoc, hs_K])
    let Φ : CategoryTheory.Limits.pullback g_semi s ≅
        CategoryTheory.Limits.pullback p_K s_K :=
      { hom := Φ_hom
        inv := Φ_inv
        hom_inv_id := by
          dsimp [Φ_hom, Φ_inv]
          ext
          · simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.id_comp]
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
              CategoryTheory.Category.comp_id]
          · simp [CategoryTheory.Limits.pullback.lift_snd]
        inv_hom_id := by
          dsimp [Φ_hom, Φ_inv]
          ext
          · simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.id_comp]
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
              CategoryTheory.Category.comp_id]
          · simp [CategoryTheory.Limits.pullback.lift_snd] }
    have : CategoryTheory.IsIso Φ.hom := Φ.isIso_hom
    have hΦ_left : ∀ x : ↥(CategoryTheory.Limits.pullback g_semi s),
        Φ.inv.base (Φ.hom.base x) = x := by
      intro x
      simp
    have hΦ_right : ∀ y : ↥(CategoryTheory.Limits.pullback p_K s_K),
        Φ.hom.base (Φ.inv.base y) = y := by
      intro y
      simp
    have hIrredFwd : ∀ S : Set ↥(CategoryTheory.Limits.pullback g_semi s),
        S ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_semi s) →
        Φ.hom.base '' S ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback p_K s_K) := by
      intro S ⟨hSIrred, hSMax⟩
      refine ⟨hSIrred.image Φ.hom.base Φ.hom.continuous.continuousOn, ?_⟩
      intro T hTIrred hST
      have hSub : S ⊆ Φ.inv.base '' T := by
        intro x hx
        have hxT : Φ.hom.base x ∈ T := hST ⟨x, hx, rfl⟩
        exact ⟨Φ.hom.base x, hxT, hΦ_left x⟩
      have hEq : Φ.inv.base '' T ⊆ S :=
        hSMax (hTIrred.image Φ.inv.base Φ.inv.continuous.continuousOn) hSub
      intro y hy
      exact ⟨Φ.inv.base y, hEq ⟨y, hy, rfl⟩, hΦ_right y⟩
    have hIrredBwd : ∀ T : Set ↥(CategoryTheory.Limits.pullback p_K s_K),
        T ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback p_K s_K) →
        Φ.inv.base '' T ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_semi s) := by
      intro T ⟨hTIrred, hTMax⟩
      refine ⟨hTIrred.image Φ.inv.base Φ.inv.continuous.continuousOn, ?_⟩
      intro S hSIrred hTS
      have hSub : T ⊆ Φ.hom.base '' S := by
        intro y hy
        have hyS : Φ.inv.base y ∈ S := hTS ⟨y, hy, rfl⟩
        exact ⟨Φ.inv.base y, hyS, hΦ_right y⟩
      have hEq : Φ.hom.base '' S ⊆ T :=
        hTMax (hSIrred.image Φ.hom.base Φ.hom.continuous.continuousOn) hSub
      intro x hx
      exact ⟨Φ.hom.base x, hEq ⟨x, hx, rfl⟩, hΦ_left x⟩
    intro E E_sch ιE hE_comp hCl_ιE hInt_E hRange_ιE ⟨isoP1, hisoP1⟩
    let E_K : Set ↥(CategoryTheory.Limits.pullback p_K s_K) := Φ.hom.base '' E
    let ιE_K : E_sch ⟶ CategoryTheory.Limits.pullback p_K s_K := ιE ≫ Φ.hom
    have hEK_comp : E_K ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback p_K s_K) :=
      hIrredFwd E hE_comp
    have hCl_ιEK : AlgebraicGeometry.IsClosedImmersion ιE_K := inferInstance
    have hRange_ιEK : Set.range ιE_K.base = E_K := by
      ext y
      have h_app : ∀ z : ↥E_sch, ιE_K.base z = Φ.hom.base (ιE.base z) := by
        intro z
        rfl
      simp only [E_K, Set.mem_range, Set.mem_image, h_app]
      constructor
      · rintro ⟨z, rfl⟩
        exact ⟨ιE.base z, by rw [← hRange_ιE]; exact ⟨z, rfl⟩, rfl⟩
      · rintro ⟨x, hx, rfl⟩
        rw [← hRange_ιE] at hx
        rcases hx with ⟨z, rfl⟩
        exact ⟨z, rfl⟩
    have hisoP1_K : ιE_K ≫ CategoryTheory.Limits.pullback.snd p_K s_K =
        isoP1.hom ≫ (weilProjectiveSpaceOver K' 1).hom := by
      have hsnd : Φ.hom ≫ CategoryTheory.Limits.pullback.snd p_K s_K =
          CategoryTheory.Limits.pullback.snd g_semi s := by
        dsimp [Φ, Φ_hom]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      rw [CategoryTheory.Category.assoc, hsnd, hisoP1]
    obtain ⟨q'₁, q'₂, q'₃, hne12', hne13', hne23', hq'₁E, hq'₂E, hq'₃E, hSpec'⟩ :=
      (hStabCK.2.2.2.2.2.2.2.2 K' s_K).2.2 E_K E_sch ιE_K
        hEK_comp hCl_ιEK hInt_E hRange_ιEK ⟨isoP1, hisoP1_K⟩
    refine ⟨Φ.inv.base q'₁, Φ.inv.base q'₂, Φ.inv.base q'₃,
      fun h => hne12' (by rw [← hΦ_right q'₁, ← hΦ_right q'₂, h]),
      fun h => hne13' (by rw [← hΦ_right q'₁, ← hΦ_right q'₃, h]),
      fun h => hne23' (by rw [← hΦ_right q'₂, ← hΦ_right q'₃, h]),
      ?_, ?_, ?_, ?_⟩
    · rcases hq'₁E with ⟨x, hx, hxeq⟩
      rw [← hxeq, hΦ_left x]
      exact hx
    · rcases hq'₂E with ⟨x, hx, hxeq⟩
      rw [← hxeq, hΦ_left x]
      exact hx
    · rcases hq'₃E with ⟨x, hx, hxeq⟩
      rw [← hxeq, hΦ_left x]
      exact hx
    · intro q hq
      have hq' : Φ.hom.base q ∈ ({q'₁, q'₂, q'₃} : Set ↥(CategoryTheory.Limits.pullback p_K s_K)) := by
        rcases hq with rfl | rfl | rfl
        · simp [hΦ_right]
        · simp [hΦ_right]
        · simp [hΦ_right]
      rcases hSpec' (Φ.hom.base q) hq' with ⟨E'_K, hE'K_comp, hE'K_ne, hq'E'K⟩ | ⟨j, x_K, hx_K⟩
      · left
        refine ⟨Φ.inv.base '' E'_K, hIrredBwd E'_K hE'K_comp, ?_, ⟨Φ.hom.base q, hq'E'K, hΦ_left q⟩⟩
        intro hEq
        apply hE'K_ne
        ext y
        constructor
        · intro hy
          have h1 : Φ.inv.base y ∈ E := by
            rw [← hEq]
            exact ⟨y, hy, rfl⟩
          exact ⟨Φ.inv.base y, h1, hΦ_right y⟩
        · intro hy
          rcases hy with ⟨x, hx, rfl⟩
          have hx' : x ∈ Φ.inv.base '' E'_K := by
            rw [hEq]
            exact hx
          rcases hx' with ⟨y', hy', hxy'⟩
          rw [← hxy', hΦ_right y']
          exact hy'
      · right
        refine ⟨j, η_V.base x_K, ?_⟩
        have hfst : Φ.inv ≫ CategoryTheory.Limits.pullback.fst g_semi s =
            CategoryTheory.Limits.pullback.fst p_K s_K ≫ ι_semi := by
          dsimp [Φ, Φ_inv]
          exact CategoryTheory.Limits.pullback.lift_fst _ _ _
        have h1 : (CategoryTheory.Limits.pullback.fst g_semi s).base q =
            ι_semi.base ((CategoryTheory.Limits.pullback.fst p_K s_K).base (Φ.hom.base q)) := by
          have h_eval := congrArg (fun f => f.base (Φ.hom.base q)) hfst
          have h_lhs : (Φ.inv ≫ CategoryTheory.Limits.pullback.fst g_semi s).base (Φ.hom.base q) =
              (CategoryTheory.Limits.pullback.fst g_semi s).base (Φ.inv.base (Φ.hom.base q)) := by
            simp
          have h_rhs : (CategoryTheory.Limits.pullback.fst p_K s_K ≫ ι_semi).base (Φ.hom.base q) =
              ι_semi.base ((CategoryTheory.Limits.pullback.fst p_K s_K).base (Φ.hom.base q)) := by
            simp
          rw [h_lhs, hΦ_left q, h_rhs] at h_eval
          exact h_eval
        rw [h1, ← hx_K]
        have h2 := congrArg (fun f => f.base x_K) (hSec_ι j)
        have h2_lhs : (σ_K j ≫ ι_semi).base x_K = ι_semi.base ((σ_K j).base x_K) := by
          simp
        have h2_rhs : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) ≫ τ_semi j).base x_K =
            (τ_semi j).base (η_V.base x_K) := rfl
        rw [h2_lhs, h2_rhs] at h2
        exact h2.symm
  · 
    let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
    have hInd : ∀ (c : ℕ)
        (C : AlgebraicGeometry.Scheme.{u})
        (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
        (ι : C_K ⟶ C),
        IsSemistableValuationPointedModel V p_K n σ_K C g τ ι →
        Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀)) = c →
        ∃ (C_V : AlgebraicGeometry.Scheme.{u})
          (g_V : C_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
          (τ_V : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_V))
          (ι_gen : C_K ⟶ C_V),
          IsSemistableValuationPointedModel V p_K n σ_K C_V g_V τ_V ι_gen ∧
          HasStablePointedGeomFiber g_V n τ_V k₀ s₀ := by
      intro c
      induction c using Nat.strong_induction_on with
      | h c ih =>
        intro C g τ ι hSemiC hCard
        obtain ⟨_hFin, hStab | ⟨Z, Z_sch, ιZ, hUnstab⟩⟩ :=
          weil_closed_fiber_unstable_p1_boundary_dichotomy K m V hMax hPkg
            C_K p_K n σ_K hStabCK.1 C g τ ι hSemiC
        · exact ⟨C, g, τ, ι, hSemiC, hStab⟩
        · obtain ⟨C_next, g_next, τ_next, ι_next, hMod_next, hDisj_next, hSm_next, hGeom3_next, hLt⟩ :=
            weil_single_unstable_p1_valuation_contraction_step K m V hMax hPkg
              C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK C g τ ι hSemiC Z Z_sch ιZ hUnstab
          have hSemi_next : IsSemistableValuationPointedModel V p_K n σ_K C_next g_next τ_next ι_next := by
            refine ⟨hMod_next, hDisj_next, hSm_next, ?_⟩
            intro K' _ _ s
            refine ⟨(hGeom3_next K' s).1, ?_⟩
            intro y
            rcases (hGeom3_next K' s).2 y with hSm_y | hNodal_y | hPinch_y
            · exact Or.inl hSm_y
            · exact Or.inr hNodal_y
            · exact Or.inr (weil_two_point_pinch_etale_nodal_roof K'
                (CategoryTheory.Limits.pullback g_next s)
                (CategoryTheory.Limits.pullback.snd g_next s) y hPinch_y)
          rw [hCard] at hLt
          exact ih _ hLt C_next g_next τ_next ι_next hSemi_next rfl
    obtain ⟨C_V, g_V, τ_V, ι_gen, hSemiV, hStabClosed⟩ :=
      hInd _ C_semi g_semi τ_semi ι_semi hSemi rfl
    have hStabV : IsGeometricStablePointedCurve g_V n τ_V :=
      weil_closed_fiber_stable_to_all_geom_fibers_stable K m V hMax hPkg
        C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK C_V g_V τ_V ι_gen hSemiV hStabClosed
    exact ⟨C_V, g_V, τ_V, ι_gen, hStabV,
      hSemiV.1.2.2.2.2.2.2.2.1, hSemiV.1.2.2.2.2.2.2.2.2⟩

theorem weil_valuationSubring_pointed_stable_curve_extension (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (K : Type u) [Field K] [IsSepClosed K] [Algebra k K]
    (hTrK : Algebra.trdeg k K ≤ (m : Cardinal.{u}))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (M_K : ℕ)
    (ι_proj : C_K ⟶ (weilProjectiveSpaceOver K M_K).left)
    (hClProj : AlgebraicGeometry.IsClosedImmersion ι_proj)
    (hProjComm : ι_proj ≫ (weilProjectiveSpaceOver K M_K).hom = p_K)
    (F : Type u) [Field F] [Algebra k F] [Algebra K F] [IsScalarTower k K F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K)
    (hηF_comm : η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)))
    (hFuncF : IsSchemeFunctionField C_K F η_F)
    (hUnif : ∀ (W : ValuationSubring F),
      (∀ c : k, algebraMap k F c ∈ W) →
      Set.Finite (Set.univ : Set (PrimeSpectrum ↥(W.comap (algebraMap K F)))) ∧
      Nat.card (PrimeSpectrum ↥(W.comap (algebraMap K F))) ≤ m + 1 ∧
      ∃ (x : F),
        x ∈ W ∧
        Transcendental K x ∧
        let Lx := IntermediateField.adjoin K ({x} : Set F)
        let Vx := W.comap Lx.val.toRingHom
        RingHom.Etale ((Lx.val.toRingHom.comp Vx.subtype).codRestrict W.toSubring (fun y => y.2)))
    (V : ValuationSubring K)
    (hkV : ∀ c : k, algebraMap k K c ∈ V) :
    ∃ (C_V : AlgebraicGeometry.Scheme.{u})
      (g_V : C_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (τ_V : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_V))
      (ι_gen : C_K ⟶ C_V),
      IsGeometricStablePointedCurve g_V n τ_V ∧
      CategoryTheory.IsPullback ι_gen p_K g_V (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
      (∀ j : Fin n, σ_K j ≫ ι_gen =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) ≫ τ_V j) :=
by
  obtain ⟨hPkg, C₀, g₀, τ₀, ι₀, hMod₀⟩ :=
    weil_valuationSubring_initial_projective_pointed_model k m K hTrK C_K p_K n σ_K
      hIntCK hPropCK hSmCK hStabCK M_K ι_proj hClProj hProjComm F η_F hηF_comm hFuncF hUnif V hkV
  obtain ⟨C', g', τ', ι', _π', r, U_cov, U_ss, g_ss, h_mod, ι_Ucov,
      hMod', _hπ'_g₀, _hι'_π', _hτ'_π', hCov, hNonempty, hLocal⟩ :=
    weil_valuationSubring_local_strictlySemistable_cover k m K V hkV hPkg C_K p_K n σ_K
      hIntCK hPropCK hSmCK hStabCK F η_F hηF_comm hFuncF hUnif C₀ g₀ τ₀ ι₀ hMod₀
  have hDom : ∀ a : Fin r,
      ∃ (C'' : AlgebraicGeometry.Scheme.{u})
        (g'' : C'' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (f_dom : C'' ⟶ (U_cov a).toScheme)
        (τ'' : ∀ j : Fin n,
          AlgebraicGeometry.Scheme.Opens.toScheme
            ((TopologicalSpace.Opens.map (τ' j).base).obj (U_cov a)) ⟶ C'')
        (ι_C'' : AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ⟶ C''),
        IsResolvedLocalStrictlySemistableMod V p_K g' n τ' ι' (U_cov a) (h_mod a) (ι_Ucov a)
          C'' g'' f_dom τ'' ι_C'' := by
    intro a
    obtain ⟨hAff_a, hSS_a, hProp_a, hComm_a, hι_a, hPbU_a, hPbSS_a⟩ := hLocal a
    exact weil_strictlySemistable_blowup_pointed_domination K m V hPkg C_K p_K n σ_K
      hIntCK hSmCK hStabCK C' g' τ' ι' hMod' (U_cov a) (hNonempty a)
      (U_ss a) (g_ss a) hAff_a hSS_a (h_mod a) hProp_a hComm_a (ι_Ucov a) hι_a hPbU_a hPbSS_a
  choose C'' g'' f_dom τ'' ι_C'' hRes using hDom
  obtain ⟨C_semi, g_semi, τ_semi, ι_semi, hSemi⟩ :=
    weil_local_semistable_contraction_to_global_semistable_model K m V hPkg C_K p_K n σ_K
      hIntCK hPropCK hSmCK hStabCK C' g' τ' ι' hMod' r U_cov hCov hNonempty
      U_ss g_ss (fun a => (hLocal a).1) (fun a => (hLocal a).2.1)
      h_mod (fun a => (hLocal a).2.2.1) (fun a => (hLocal a).2.2.2.1)
      ι_Ucov (fun a => (hLocal a).2.2.2.2.1) (fun a => (hLocal a).2.2.2.2.2.1)
      (fun a => (hLocal a).2.2.2.2.2.2) C'' g'' f_dom τ'' ι_C'' hRes
  exact weil_global_semistable_curve_stabilization_contraction K m V hPkg C_K p_K n σ_K
    hIntCK hPropCK hSmCK hStabCK C_semi g_semi τ_semi ι_semi hSemi

theorem weil_valuation_center_and_generic_curve_integral (k : Type u) [Field k] [IsAlgClosed k]
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (hIntB₂ : AlgebraicGeometry.IsIntegral B₂.left)
    (hProjB₂ : IsProjectiveOverField k B₂)
    (hU₂ : Nonempty U₂)
    (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (hFib₂ : IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ)
    (K₀ : Type u) [Field K₀] [Algebra k K₀]
    (η₀ : AlgebraicGeometry.Spec (CommRingCat.of K₀) ⟶ B₂.left)
    (hη₀_hom : η₀ ≫ B₂.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K₀)))
    (hFuncK₀ : IsSchemeFunctionField B₂.left K₀ η₀)
    (K : Type u) [Field K] [Algebra k K] [Algebra K₀ K] [IsScalarTower k K₀ K]
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (ι_K : C_K ⟶ X₂.left)
    (hPbK : CategoryTheory.IsPullback ι_K p_K f₂.left
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀)) :
    AlgebraicGeometry.IsIntegral C_K ∧
    ∀ (V : ValuationSubring K),
      (∀ c : k, algebraMap k K c ∈ V) →
      ∃ (U₀ : B₂.left.Opens)
        (F_init : Finset K)
        (μ₀ : AlgebraicGeometry.Spec
          (CommRingCat.of ↥(Algebra.adjoin k (↑F_init : Set K))) ⟶ U₀.toScheme),
        AlgebraicGeometry.IsAffineOpen U₀ ∧
        Nonempty ↥U₀ ∧
        (∀ x ∈ F_init, x ∈ V) ∧
        μ₀ ≫ U₀.ι ≫ B₂.hom =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap k ↥(Algebra.adjoin k (↑F_init : Set K)))) ∧
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.adjoin k (↑F_init : Set K)).val.toRingHom) ≫
            μ₀ ≫ U₀.ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀ :=
by
  let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
  let η_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀
  refine ⟨?_, ?_⟩
  · obtain ⟨⟨u₂, hu₂⟩⟩ := hU₂
    obtain ⟨W₀, hAffW₀, hu₂W₀, hW₀_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hu₂
    obtain ⟨φ_W₀, _, hφ_W₀⟩ := hFuncK₀ W₀ hAffW₀ ⟨⟨u₂, hu₂W₀⟩⟩
    have hRange_U₂ : Set.range η_K.base ⊆ Set.range U₂.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨pt, rfl⟩
      have hmemW₀ : η_K.base pt ∈ Set.range W₀.ι.base := by
        have heq : η_K =
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫
              AlgebraicGeometry.Spec.map φ_W₀ ≫ hAffW₀.isoSpec.inv) ≫ W₀.ι := by
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            hAffW₀.isoSpec_inv_ι, hφ_W₀]
        rw [heq]
        exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫
          AlgebraicGeometry.Spec.map φ_W₀ ≫ hAffW₀.isoSpec.inv).base pt, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hmemW₀
      exact hW₀_sub hmemW₀
    let η_U : S_K ⟶ U₂.toScheme := AlgebraicGeometry.IsOpenImmersion.lift U₂.ι η_K hRange_U₂
    have hη_U : η_U ≫ U₂.ι = η_K :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U₂.ι η_K hRange_U₂
    have hEqFib : IsEquidimGenSmoothCurveFibOver k f₂ U₂ := hFib₂.2.1
    have hSm_U₂ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (f₂.left ∣_ U₂) := hEqFib.2.2.1
    have hPbK_U : CategoryTheory.IsPullback ι_K p_K f₂.left (η_U ≫ U₂.ι) := by
      rwa [hη_U]
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        ((CategoryTheory.IsPullback.of_bot' hPbK_U.flip
          (AlgebraicGeometry.isPullback_morphismRestrict f₂.left U₂)).flip)
        hSm_U₂
    let Kbar : Type u := AlgebraicClosure K
    let s_Kbar : AlgebraicGeometry.Spec (CommRingCat.of Kbar) ⟶ S_K :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K Kbar))
    let isoPb : CategoryTheory.Limits.pullback p_K s_Kbar ≅
        CategoryTheory.Limits.pullback f₂.left (s_Kbar ≫ η_K) :=
      ((CategoryTheory.IsPullback.of_hasPullback p_K s_Kbar).paste_horiz hPbK).isoPullback
    have : ConnectedSpace ↥(CategoryTheory.Limits.pullback f₂.left (s_Kbar ≫ η_K)) :=
      (hEqFib.2.2.2 Kbar (s_Kbar ≫ η_K)).1
    have : ConnectedSpace ↥(CategoryTheory.Limits.pullback p_K s_Kbar) :=
      (AlgebraicGeometry.Scheme.homeoOfIso isoPb.symm).surjective.connectedSpace
        (AlgebraicGeometry.Scheme.homeoOfIso isoPb.symm).continuous
    have hSurj_fst : AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.fst p_K s_Kbar) :=
      inferInstance
    have hConn : ConnectedSpace ↥C_K :=
      hSurj_fst.surj.connectedSpace (CategoryTheory.Limits.pullback.fst p_K s_Kbar).continuous

    have hEtaleLocal :
        ∀ (L B R_loc : Type u) [Field L] [CommRing B] [Algebra L B] [Algebra.Etale L B]
          [CommRing R_loc] [IsLocalRing R_loc] (Φ : B →+* R_loc) (z : B),
          Φ z ∈ IsLocalRing.maximalIdeal R_loc → Φ z = 0 := by
      intro L B R_loc _ _ _ _ _ _ Φ z hz
      obtain ⟨I, _, Ai, instFieldAi, instAlgAi, e, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod L B).mp inferInstance
      let : ∀ i : I, Field (Ai i) := instFieldAi
      let : ∀ i : I, Algebra L (Ai i) := instAlgAi
      let : ∀ i : I, DecidableEq (Ai i) := fun i => Classical.decEq (Ai i)
      let u : ∀ i : I, Ai i := fun i => if e z i = 0 then 1 else 0
      let c : B := e.symm u
      have hzc : z * c = 0 := by
        apply e.injective
        rw [map_mul, map_zero, AlgEquiv.apply_symm_apply]
        funext i
        change e z i * (if e z i = 0 then 1 else 0) = 0
        split_ifs with hi
        · rw [hi, zero_mul]
        · rw [mul_zero]
      have hu_sum : IsUnit (z + c) := by
        have hu_e : IsUnit (e (z + c)) := by
          rw [Pi.isUnit_iff]
          intro i
          rw [map_add, AlgEquiv.apply_symm_apply]
          change IsUnit (e z i + (if e z i = 0 then 1 else 0))
          split_ifs with hi
          · rw [hi, zero_add]
            exact isUnit_one
          · rw [add_zero]
            exact Ne.isUnit hi
        exact (MulEquiv.isUnit_map e.toMulEquiv).mp hu_e
      have hu_Φsum : IsUnit (Φ (z + c)) := hu_sum.map Φ
      have hc_notMem : Φ c ∉ IsLocalRing.maximalIdeal R_loc := by
        intro hc_mem
        have hsum_mem : Φ (z + c) ∈ IsLocalRing.maximalIdeal R_loc := by
          rw [map_add]
          exact Ideal.add_mem _ hz hc_mem
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu_Φsum) hsum_mem
      obtain ⟨uc, huc⟩ := IsLocalRing.notMem_maximalIdeal.mp hc_notMem
      have hmul_zero : Φ z * Φ c = 0 := by
        rw [← map_mul, hzc, map_zero]
      calc
        Φ z = Φ z * (↑uc * ↑uc⁻¹) := by rw [Units.mul_inv, mul_one]
        _ = (Φ z * Φ c) * ↑uc⁻¹ := by rw [huc, mul_assoc]
        _ = 0 := by rw [hmul_zero, zero_mul]

    have hPidEtaleLoc :
        ∀ (S : Type u) [CommRing S] (φ_PS : Polynomial K →+* S),
          φ_PS.Etale →
          ∀ (q : Ideal S) [q.IsPrime] (a b : Localization.AtPrime q),
            a ≠ 0 → b ≠ 0 → a * b ≠ 0 := by
      intro S _ φ_PS hEt q _ a b ha hb
      let P := Polynomial K
      let : Algebra P S := φ_PS.toAlgebra
      have : Algebra.Etale P S := hEt
      have : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing P S
      let S_q := Localization.AtPrime q
      have : IsNoetherianRing S_q := IsLocalization.isNoetherianRing q.primeCompl S_q inferInstance
      have : Module.Flat P S_q := Module.Flat.trans P S S_q
      have : Module.IsTorsionFree P S_q := Module.Flat.isTorsionFree
      let p : Ideal P := q.comap (algebraMap P S)
      have : p.IsPrime := Ideal.IsPrime.comap (algebraMap P S)
      let π₀ : P := Submodule.IsPrincipal.generator p
      have hp_span : Ideal.span {π₀} = p := Submodule.IsPrincipal.span_singleton_generator p
      by_cases hπ₀ : π₀ = 0
      · have hp_bot : p = ⊥ := by
          rw [← hp_span, hπ₀, Ideal.span_singleton_eq_bot]
        let L₀ : Type u := FractionRing P
        have hu_y : ∀ y : nonZeroDivisors P, IsUnit (algebraMap P S_q (y : P)) := by
          intro y
          have hy_ne : (y : P) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
          have hy_not_q : algebraMap P S (y : P) ∈ q.primeCompl := by
            intro hy_q
            have hy_p : (y : P) ∈ p := hy_q
            rw [hp_bot, Submodule.mem_bot] at hy_p
            exact hy_ne hy_p
          rw [IsScalarTower.algebraMap_apply P S S_q]
          exact IsLocalization.map_units S_q ⟨algebraMap P S (y : P), hy_not_q⟩
        let ψ₀_alg : L₀ →ₐ[P] S_q :=
          { IsLocalization.lift hu_y with
            commutes' := fun x => IsLocalization.lift_eq hu_y x }
        let Φ₀_alg : TensorProduct P L₀ S →ₐ[P] S_q :=
          Algebra.TensorProduct.lift ψ₀_alg (IsScalarTower.toAlgHom P S S_q)
            (fun _ _ => Commute.all _ _)
        have hm_bot : IsLocalRing.maximalIdeal S_q = ⊥ := by
          ext w
          simp only [Submodule.mem_bot]
          constructor
          · intro hw
            obtain ⟨⟨s, t⟩, hst⟩ := IsLocalization.surj q.primeCompl w
            have hΦs : Φ₀_alg.toRingHom (Algebra.TensorProduct.includeRight s) =
                algebraMap S S_q s := by
              change Φ₀_alg ((1 : L₀) ⊗ₜ[P] s) = algebraMap S S_q s
              rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
              rfl
            have hs_mem : Φ₀_alg.toRingHom (Algebra.TensorProduct.includeRight s) ∈
                IsLocalRing.maximalIdeal S_q := by
              rw [hΦs, ← hst]
              exact Ideal.mul_mem_right _ _ hw
            have hs_zero : algebraMap S S_q s = 0 := by
              rw [← hΦs]
              exact hEtaleLocal L₀ (TensorProduct P L₀ S) S_q Φ₀_alg.toRingHom
                (Algebra.TensorProduct.includeRight s) hs_mem
            obtain ⟨ut, hut⟩ := IsLocalization.map_units S_q t
            have hw_zero : w * ↑ut = 0 := by
              rw [hut, hst, hs_zero]
            calc
              w = w * (↑ut * ↑ut⁻¹) := by rw [Units.mul_inv, mul_one]
              _ = (w * ↑ut) * ↑ut⁻¹ := by rw [mul_assoc]
              _ = 0 := by rw [hw_zero, zero_mul]
          · rintro rfl
            exact Ideal.zero_mem _
        have hField : IsField S_q := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hm_bot
        let : Field S_q := hField.toField
        exact mul_ne_zero ha hb
      · have hp_ne_bot : p ≠ ⊥ := by
          intro hbot
          have hmem : π₀ ∈ p := Submodule.IsPrincipal.generator_mem p
          rw [hbot, Submodule.mem_bot] at hmem
          exact hπ₀ hmem
        have : p.IsMaximal := IsPrime.to_maximal_ideal hp_ne_bot
        let Q₀ : Type u := P ⧸ p
        let : Field Q₀ := Ideal.Quotient.field p
        let πbar : S_q := algebraMap P S_q π₀
        have hπbar_mem : πbar ∈ IsLocalRing.maximalIdeal S_q := by
          by_contra hnot
          have hu : IsUnit πbar := IsLocalRing.notMem_maximalIdeal.mp hnot
          rw [show πbar = algebraMap S S_q (algebraMap P S π₀) from
            IsScalarTower.algebraMap_apply P S S_q π₀] at hu
          have hnot_q : algebraMap P S π₀ ∈ q.primeCompl :=
            (IsLocalization.AtPrime.isUnit_to_map_iff S_q q (algebraMap P S π₀)).mp hu
          exact hnot_q (Submodule.IsPrincipal.generator_mem p)
        let J₀ : Ideal S_q := Ideal.span {πbar}
        have hJ₀_le : J₀ ≤ IsLocalRing.maximalIdeal S_q :=
          Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπbar_mem)
        have hJ₀_ne_top : J₀ ≠ ⊤ := by
          intro htop
          exact (IsLocalRing.maximalIdeal.isMaximal S_q).ne_top
            (top_unique (htop ▸ hJ₀_le))
        let R_loc : Type u := S_q ⧸ J₀
        have : Nontrivial R_loc :=
          ⟨⟨0, 1, fun h01 => hJ₀_ne_top
            (Ideal.eq_top_of_isUnit_mem J₀
              (Ideal.Quotient.eq_zero_iff_mem.mp h01.symm) isUnit_one)⟩⟩
        have : IsLocalRing R_loc :=
          IsLocalRing.of_surjective' (Ideal.Quotient.mk J₀) Ideal.Quotient.mk_surjective
        have hker_p : ∀ x ∈ p, ((Ideal.Quotient.mk J₀).comp (algebraMap P S_q)) x = 0 := by
          intro x hx
          rw [← hp_span, Ideal.mem_span_singleton] at hx
          obtain ⟨c, rfl⟩ := hx
          rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, map_mul]
          exact Ideal.mul_mem_right _ J₀ (Ideal.mem_span_singleton_self πbar)
        let ψ₁_alg : Q₀ →ₐ[P] R_loc :=
          { Ideal.Quotient.lift p ((Ideal.Quotient.mk J₀).comp (algebraMap P S_q)) hker_p with
            commutes' := fun x => by
              change (Ideal.Quotient.lift p ((Ideal.Quotient.mk J₀).comp (algebraMap P S_q)) hker_p)
                (Ideal.Quotient.mk p x) = Ideal.Quotient.mk J₀ (algebraMap P S_q x)
              rfl }
        let σ₁_alg : S →ₐ[P] R_loc :=
          { (Ideal.Quotient.mk J₀).comp (algebraMap S S_q) with
            commutes' := fun x => by
              simp only [RingHom.toMonoidHom_eq_coe, OneHom.toFun_eq_coe, MonoidHom.toOneHom_coe,
                MonoidHom.coe_coe, RingHom.comp_apply]
              rfl }
        let Φ₁_alg : TensorProduct P Q₀ S →ₐ[P] R_loc :=
          Algebra.TensorProduct.lift ψ₁_alg σ₁_alg (fun _ _ => Commute.all _ _)
        have hm_eq : IsLocalRing.maximalIdeal S_q = J₀ := by
          apply le_antisymm _ hJ₀_le
          intro w hw
          obtain ⟨⟨s, t⟩, hst⟩ := IsLocalization.surj q.primeCompl w
          let zs : S_q := algebraMap S S_q s
          have hzs_mem : zs ∈ IsLocalRing.maximalIdeal S_q := by
            change algebraMap S S_q s ∈ IsLocalRing.maximalIdeal S_q
            rw [← hst]
            exact Ideal.mul_mem_right _ _ hw
          have hmk_mem : Ideal.Quotient.mk J₀ zs ∈ IsLocalRing.maximalIdeal R_loc := by
            by_contra hnot
            obtain ⟨uy, huy⟩ := IsLocalRing.notMem_maximalIdeal.mp hnot
            obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (↑uy⁻¹ : R_loc)
            have h1 : Ideal.Quotient.mk J₀ (1 - zs * y) = 0 := by
              rw [map_sub, map_one, map_mul, hy, ← huy, Units.mul_inv, sub_self]
            have hsub_m : 1 - zs * y ∈ IsLocalRing.maximalIdeal S_q :=
              hJ₀_le (Ideal.Quotient.eq_zero_iff_mem.mp h1)
            have h1_m : (1 : S_q) ∈ IsLocalRing.maximalIdeal S_q := by
              have hadd := Ideal.add_mem _ hsub_m (Ideal.mul_mem_right y _ hzs_mem)
              simpa only [sub_add_cancel] using hadd
            exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) h1_m
          have hΦs : Φ₁_alg.toRingHom (Algebra.TensorProduct.includeRight s) =
              Ideal.Quotient.mk J₀ zs := by
            change Φ₁_alg ((1 : Q₀) ⊗ₜ[P] s) = Ideal.Quotient.mk J₀ zs
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            rfl
          have hΦs_mem : Φ₁_alg.toRingHom (Algebra.TensorProduct.includeRight s) ∈
              IsLocalRing.maximalIdeal R_loc := by
            rw [hΦs]
            exact hmk_mem
          have hzs_J₀ : zs ∈ J₀ := by
            have h0 := hEtaleLocal Q₀ (TensorProduct P Q₀ S) R_loc Φ₁_alg.toRingHom
              (Algebra.TensorProduct.includeRight s) hΦs_mem
            rw [hΦs] at h0
            exact Ideal.Quotient.eq_zero_iff_mem.mp h0
          obtain ⟨ut, hut⟩ := IsLocalization.map_units S_q t
          have hw_eq : w = zs * ↑ut⁻¹ := by
            calc
              w = w * (↑ut * ↑ut⁻¹) := by rw [Units.mul_inv, mul_one]
              _ = (w * ↑ut) * ↑ut⁻¹ := by rw [mul_assoc]
              _ = zs * ↑ut⁻¹ := by rw [hut, hst]
          rw [hw_eq]
          exact Ideal.mul_mem_right _ J₀ hzs_J₀
        have hπbar_inj : ∀ x : S_q, πbar * x = 0 → x = 0 := by
          intro x hx
          have hsmul : π₀ • x = 0 := by
            rw [Algebra.smul_def]
            exact hx
          exact (smul_eq_zero.mp hsmul).resolve_left hπ₀
        have hπbar_pow_inj : ∀ (m : ℕ) (x : S_q), πbar ^ m * x = 0 → x = 0 := by
          intro m
          induction m with
          | zero =>
            intro x hx
            simpa only [pow_zero, one_mul] using hx
          | succ m ih =>
            intro x hx
            rw [pow_succ', mul_assoc] at hx
            exact ih x (hπbar_inj (πbar ^ m * x) hx)
        have hInf : (⨅ i : ℕ, (IsLocalRing.maximalIdeal S_q) ^ i) = ⊥ :=
          Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal S_q)
            (IsLocalRing.maximalIdeal.isMaximal S_q).ne_top
        have hDecomp : ∀ x : S_q, x ≠ 0 → ∃ (k : ℕ) (u : S_q), IsUnit u ∧ x = πbar ^ k * u := by
          intro x hx
          have hex : ∃ i : ℕ, x ∉ (IsLocalRing.maximalIdeal S_q) ^ i := by
            by_contra hall
            push Not at hall
            have hbot : x ∈ (⊥ : Ideal S_q) := hInf ▸ Ideal.mem_iInf.mpr hall
            exact hx ((Submodule.mem_bot (R := S_q)).mp hbot)
          let : DecidablePred (fun i : ℕ => x ∉ (IsLocalRing.maximalIdeal S_q) ^ i) :=
            Classical.decPred _
          let k₀ : ℕ := Nat.find hex
          have hk₀_spec : x ∉ (IsLocalRing.maximalIdeal S_q) ^ k₀ := Nat.find_spec hex
          have hk₀_ne : k₀ ≠ 0 := by
            intro hk0
            rw [hk0, pow_zero, Ideal.one_eq_top] at hk₀_spec
            exact hk₀_spec Submodule.mem_top
          obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hk₀_ne
          have hk_lt : k < Nat.find hex := by
            change k < k₀
            omega
          have hx_in : x ∈ (IsLocalRing.maximalIdeal S_q) ^ k :=
            of_not_not (Nat.find_min hex hk_lt)
          rw [hm_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hx_in
          obtain ⟨u, hu_eq⟩ := hx_in
          have hu_not_m : u ∉ IsLocalRing.maximalIdeal S_q := by
            intro hu_m
            rw [hm_eq, Ideal.mem_span_singleton] at hu_m
            obtain ⟨v, rfl⟩ := hu_m
            apply hk₀_spec
            rw [hk, Nat.succ_eq_add_one, hm_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
            exact ⟨v, by rw [hu_eq, pow_add, pow_one, mul_assoc]⟩
          exact ⟨k, u, IsLocalRing.notMem_maximalIdeal.mp hu_not_m, hu_eq⟩
        obtain ⟨ka, ua, hua, rfl⟩ := hDecomp a ha
        obtain ⟨kb, ub, hub, rfl⟩ := hDecomp b hb
        intro hab
        have hprod : πbar ^ (ka + kb) * (ua * ub) = 0 := by
          calc
            πbar ^ (ka + kb) * (ua * ub) = (πbar ^ ka * ua) * (πbar ^ kb * ub) := by ring
            _ = 0 := hab
        exact (hua.mul hub).ne_zero (hπbar_pow_inj (ka + kb) (ua * ub) hprod)

    have hChart :
        ∀ x : C_K,
          ∃ (Vx : C_K.Opens) (hAffVx : AlgebraicGeometry.IsAffineOpen Vx),
            x ∈ Vx ∧
            ∃ φ_PS : Polynomial K →+* ↑(C_K.presheaf.obj (Opposite.op Vx)), φ_PS.Etale := by
      intro x
      obtain ⟨UB, _, Vx, hAffVx, hx, eVx, hStd⟩ :=
        AlgebraicGeometry.SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension
          (n := 1) (f := p_K) x
      have hUB_top : UB = ⊤ := by
        ext y
        simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        have hpx : p_K.base x ∈ UB := eVx hx
        rwa [Subsingleton.elim y (p_K.base x)]
      let isoRB : CommRingCat.of K ≅ S_K.presheaf.obj (Opposite.op UB) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).symm ≪≫
          S_K.presheaf.mapIso (eqToIso (congrArg Opposite.op hUB_top.symm))
      let eK : K ≃+* ↑(S_K.presheaf.obj (Opposite.op UB)) := isoRB.commRingCatIsoToRingEquiv
      obtain ⟨g, _, hg⟩ := hStd.exists_etale_mvPolynomial
      let e1 : Polynomial K ≃+* MvPolynomial (Fin 1) K :=
        (MvPolynomial.uniqueAlgEquiv K (Fin 1)).symm.toRingEquiv
      let e2 : MvPolynomial (Fin 1) K ≃+* MvPolynomial (Fin 1) ↑(S_K.presheaf.obj (Opposite.op UB)) :=
        MvPolynomial.mapEquiv (Fin 1) eK
      let e : Polynomial K ≃+* MvPolynomial (Fin 1) ↑(S_K.presheaf.obj (Opposite.op UB)) :=
        e1.trans e2
      let M_poly := MvPolynomial (Fin 1) ↑(S_K.presheaf.obj (Opposite.op UB))
      let S_x := ↑(C_K.presheaf.obj (Opposite.op Vx))
      let : Algebra (Polynomial K) M_poly := e.toRingHom.toAlgebra
      let : Algebra M_poly S_x := g.toAlgebra
      let : Algebra (Polynomial K) S_x := (g.comp e.toRingHom).toAlgebra
      have : IsScalarTower (Polynomial K) M_poly S_x := IsScalarTower.of_algebraMap_eq' rfl
      have : Algebra.Etale (Polynomial K) M_poly :=
        RingHom.Etale.of_bijective (f := e.toRingHom) e.bijective
      have : Algebra.Etale M_poly S_x := hg
      exact ⟨Vx, hAffVx, hx, g.comp e.toRingHom, Algebra.Etale.comp (Polynomial K) M_poly S_x⟩

    have : AlgebraicGeometry.IsReduced C_K := by
      have : ∀ x : C_K, IsReduced ↑(C_K.presheaf.stalk x) := by
        intro x
        obtain ⟨Vx, hAffVx, hx, φ_PS, hEt⟩ := hChart x
        let qx := (hAffVx.primeIdealOf ⟨x, hx⟩).asIdeal
        let : Algebra ↑(C_K.presheaf.obj (Opposite.op Vx)) ↑(C_K.presheaf.stalk x) :=
          (C_K.presheaf.germ Vx x hx).hom.toAlgebra
        have := hAffVx.isLocalization_stalk ⟨x, hx⟩
        let eStalk :=
          IsLocalization.algEquiv qx.primeCompl
            (↑(C_K.presheaf.stalk x)) (Localization.AtPrime qx)
        refine ⟨fun z ⟨m, hzm⟩ => ?_⟩
        by_contra hz
        have hw : eStalk z ≠ 0 := fun h0 => hz (eStalk.injective (h0.trans (map_zero eStalk).symm))
        have hpow_ne : ∀ k : ℕ, (eStalk z) ^ k ≠ 0 := by
          intro k
          induction k with
          | zero =>
            rw [pow_zero]
            exact one_ne_zero
          | succ k ih =>
            rw [pow_succ]
            exact hPidEtaleLoc _ φ_PS hEt qx ((eStalk z) ^ k) (eStalk z) ih hw
        apply hpow_ne m
        rw [← map_pow, hzm, map_zero]
      exact AlgebraicGeometry.isReduced_of_isReduced_stalk C_K

    have : IrreducibleSpace ↥C_K := by
      have hPre : PreirreducibleSpace ↥C_K := by
        refine ⟨fun U₁ U₂ hU₁ hU₂ hne₁ hne₂ => ?_⟩
        have hOpenCl : IsOpen (closure U₁) := by
          rw [isOpen_iff_mem_nhds]
          intro x hx_cl
          obtain ⟨Vx, hAffVx, hx, φ_PS, hEt⟩ := hChart x
          let S_ring : CommRingCat.{u} := C_K.presheaf.obj (Opposite.op Vx)
          let : Algebra (Polynomial K) ↑S_ring := φ_PS.toAlgebra
          have : Algebra.Etale (Polynomial K) ↑S_ring := hEt
          have : IsNoetherianRing ↑S_ring :=
            Algebra.FiniteType.isNoetherianRing (Polynomial K) ↑S_ring
          have hMinUnique :
              ∀ r : PrimeSpectrum ↑S_ring,
                ∃ p_r ∈ minimalPrimes ↑S_ring,
                  p_r ≤ r.asIdeal ∧
                  ∀ Q : Ideal ↑S_ring, Q.IsPrime → Q ≤ r.asIdeal → p_r ≤ Q := by
            intro r
            let loc_r := algebraMap ↑S_ring (Localization.AtPrime r.asIdeal)
            let p_r : Ideal ↑S_ring := Ideal.comap loc_r ⊥
            have hp_r_prime : p_r.IsPrime := by
              refine ⟨?_, fun {a b} hab => ?_⟩
              · intro htop
                have h1 : (1 : ↑S_ring) ∈ p_r := htop ▸ Submodule.mem_top
                change loc_r 1 = 0 at h1
                rw [map_one] at h1
                exact one_ne_zero h1
              · change loc_r (a * b) = 0 at hab
                rw [map_mul] at hab
                by_contra hnot
                push Not at hnot
                exact hPidEtaleLoc _ φ_PS hEt r.asIdeal (loc_r a) (loc_r b) hnot.1 hnot.2 hab
            have hp_r_le : ∀ Q : Ideal ↑S_ring, Q.IsPrime → Q ≤ r.asIdeal → p_r ≤ Q := by
              intro Q hQ hQr s hs
              change loc_r s = 0 at hs
              rw [IsLocalization.map_eq_zero_iff r.asIdeal.primeCompl] at hs
              obtain ⟨⟨t, ht⟩, hts⟩ := hs
              have hmulQ : t * s ∈ Q := by
                rw [hts]
                exact Q.zero_mem
              exact (hQ.mem_or_mem hmulQ).resolve_left (fun htQ => ht (hQr htQ))
            have hp_r_min : p_r ∈ minimalPrimes ↑S_ring :=
              ⟨⟨hp_r_prime, bot_le⟩, fun Q hQ hQp =>
                hp_r_le Q hQ.1 (hQp.trans (hp_r_le r.asIdeal r.isPrime (le_refl _)))⟩
            exact ⟨p_r, hp_r_min, hp_r_le r.asIdeal r.isPrime (le_refl _), hp_r_le⟩
          let qx : PrimeSpectrum ↑S_ring := hAffVx.isoSpec.hom.base ⟨x, hx⟩
          have hqx_img : hAffVx.fromSpec.base qx = x := by
            rw [← hAffVx.isoSpec_inv_ι]
            change Vx.ι.base ((hAffVx.isoSpec.hom ≫ hAffVx.isoSpec.inv).base ⟨x, hx⟩) = x
            rw [Iso.hom_inv_id]
            rfl
          obtain ⟨p₀, hp₀_min, hp₀_qx, _⟩ := hMinUnique qx
          let Z₀ : Set (PrimeSpectrum ↑S_ring) := PrimeSpectrum.zeroLocus (p₀ : Set ↑S_ring)
          let Z_other : Set (PrimeSpectrum ↑S_ring) :=
            ⋃ Q ∈ minimalPrimes ↑S_ring \ {p₀}, PrimeSpectrum.zeroLocus (Q : Set ↑S_ring)
          have hFinOther : (minimalPrimes ↑S_ring \ {p₀}).Finite :=
            (minimalPrimes.finite_of_isNoetherianRing ↑S_ring).sdiff
          have hClOther : IsClosed Z_other :=
            hFinOther.isClosed_biUnion
              (fun Q _ => PrimeSpectrum.isClosed_zeroLocus (Q : Set ↑S_ring))
          have hZ₀_eq : Z₀ = Z_otherᶜ := by
            ext r
            simp only [Z₀, Z_other, Set.mem_compl_iff, Set.mem_iUnion, Set.mem_sdiff,
              Set.mem_singleton_iff, PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
            constructor
            · intro hp₀_r ⟨Q, ⟨⟨hQ_min, hQ_ne⟩, hQ_r⟩⟩
              obtain ⟨p_r, hp_r_min, _, hp_r_le⟩ := hMinUnique r
              have hp0_eq : p_r = p₀ :=
                le_antisymm (hp_r_le p₀ hp₀_min.1.1 hp₀_r)
                  (hp₀_min.2 ⟨hp_r_min.1.1, bot_le⟩ (hp_r_le p₀ hp₀_min.1.1 hp₀_r))
              have hQ_eq : p_r = Q :=
                le_antisymm (hp_r_le Q hQ_min.1.1 hQ_r)
                  (hQ_min.2 ⟨hp_r_min.1.1, bot_le⟩ (hp_r_le Q hQ_min.1.1 hQ_r))
              exact hQ_ne (hQ_eq.symm.trans hp0_eq)
            · intro hr_not
              obtain ⟨Q, hQ_min, hQ_r⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ r.asIdeal)
              by_contra hp₀_not
              have hQ_ne : Q ≠ p₀ := fun hEq => hp₀_not (hEq ▸ hQ_r)
              exact hr_not ⟨Q, ⟨hQ_min, hQ_ne⟩, hQ_r⟩
          have hOpenZ₀ : IsOpen Z₀ := by
            rw [hZ₀_eq]
            exact hClOther.isOpen_compl
          have hIrredZ₀ : IsIrreducible Z₀ := by
            rw [PrimeSpectrum.isIrreducible_zeroLocus_iff, hp₀_min.1.1.radical]
            exact hp₀_min.1.1
          let Wx : Set C_K := hAffVx.fromSpec.base '' Z₀
          have hOpenWx : IsOpen Wx :=
            hAffVx.fromSpec.isOpenEmbedding.isOpenMap Z₀ hOpenZ₀
          have hx_Wx : x ∈ Wx := ⟨qx, hp₀_qx, hqx_img⟩
          have hPreWx : IsPreirreducible Wx :=
            hIrredZ₀.isPreirreducible.image hAffVx.fromSpec.base
              hAffVx.fromSpec.continuous.continuousOn
          have hWx_sub : Wx ⊆ closure U₁ := by
            intro y hy_Wx
            rw [mem_closure_iff]
            intro O hO hy_O
            have hWU₁ : (Wx ∩ U₁).Nonempty := mem_closure_iff.mp hx_cl Wx hOpenWx hx_Wx
            have hWO : (Wx ∩ O).Nonempty := ⟨y, hy_Wx, hy_O⟩
            obtain ⟨z, _, hzO, hzU₁⟩ := hPreWx O U₁ hO hU₁ hWO hWU₁
            exact ⟨z, hzO, hzU₁⟩
          exact mem_nhds_iff.mpr ⟨Wx, hWx_sub, hOpenWx, hx_Wx⟩
        have hClopen : IsClopen (closure U₁) := ⟨isClosed_closure, hOpenCl⟩
        obtain ⟨y₁, _, hy₁⟩ := hne₁
        have hClEq : closure U₁ = Set.univ :=
          hClopen.eq_univ ⟨y₁, subset_closure hy₁⟩
        obtain ⟨y₂, _, hy₂⟩ := hne₂
        have hy₂_cl : y₂ ∈ closure U₁ := by
          rw [hClEq]
          trivial
        obtain ⟨z, hz₂, hz₁⟩ := mem_closure_iff.mp hy₂_cl U₂ hU₂ hy₂
        exact ⟨z, trivial, hz₁, hz₂⟩
      exact { toPreirreducibleSpace := hPre, toNonempty := hConn.toNonempty }

    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced C_K

  · have hPropB₂ : AlgebraicGeometry.IsProper B₂.hom := by
      obtain ⟨NB, ιB, hClB⟩ := hProjB₂
      have : AlgebraicGeometry.IsClosedImmersion ιB.left := hClB
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (NB + 1)) k
      let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (NB + 1)) k) :=
        ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (NB + 1)) k) p⟩
      have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (NB + 1)) k) :=
        Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (NB + 1)) k)
      have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
        intro z
        have hz : z.1 ∈ (1 : Submodule k (MvPolynomial (Fin (NB + 1)) k)) := by
          simpa only [𝒜, MvPolynomial.homogeneousSubmodule_zero] using z.2
        obtain ⟨c, hc⟩ := Submodule.mem_one.mp hz
        exact ⟨c, Subtype.ext hc⟩
      have : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _ hSurj0
      have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k NB).hom := by
        change AlgebraicGeometry.IsProper
          (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))))
        infer_instance
      rw [← CategoryTheory.Over.w ιB]
      infer_instance
    have hValEx : AlgebraicGeometry.ValuativeCriterion.Existence B₂.hom :=
      AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap B₂.hom
        (CategoryTheory.MorphismProperty.universally_mono
          (fun _ _ _ hg => IsClosedMap.specializingMap hg) B₂.hom
          ((AlgebraicGeometry.universallyClosed_iff B₂.hom).mp inferInstance))
    intro V hkV
    have : IsFractionRing ↥V K :=
      (ValuationRing.isFractionRing_iff (𝒪 := ↥V) (K := K)).mpr
        ⟨fun x => (V.mem_or_inv_mem x).elim
          (fun h => ⟨⟨x, h⟩, Or.inl rfl⟩)
          (fun h => ⟨⟨x⁻¹, h⟩, Or.inr rfl⟩),
         Subtype.val_injective⟩
    let φ_kV : k →+* ↥V :=
      { toFun := fun c => ⟨algebraMap k K c, hkV c⟩
        map_one' := Subtype.ext (map_one (algebraMap k K))
        map_mul' := fun a b => Subtype.ext (map_mul (algebraMap k K) a b)
        map_zero' := Subtype.ext (map_zero (algebraMap k K))
        map_add' := fun a b => Subtype.ext (map_add (algebraMap k K) a b) }
    have hηK_hom : η_K ≫ B₂.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K)) := by
      rw [CategoryTheory.Category.assoc, hη₀_hom, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      congr 2
      exact (IsScalarTower.algebraMap_eq k K₀ K).symm
    have hCommSq : CategoryTheory.CommSq η_K
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V K)))
        B₂.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_kV)) := by
      refine ⟨?_⟩
      rw [hηK_hom, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl
    let sq_V := AlgebraicGeometry.ValuativeCommSq.mk ↥V K η_K
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_kV)) hCommSq
    obtain ⟨⟨η_V, hηV_top, _⟩⟩ := (hValEx sq_V).exists_lift
    let m_V : PrimeSpectrum ↥V := IsLocalRing.closedPoint ↥V
    let x_V : B₂.left := η_V.base m_V
    have hxV_top : x_V ∈ (⊤ : B₂.left.Opens) := trivial
    obtain ⟨U₀, hAffU₀, hx_V, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hxV_top
    have hNonemptyU₀ : Nonempty ↥U₀ := ⟨⟨x_V, hx_V⟩⟩
    let O_V : TopologicalSpace.Opens (PrimeSpectrum ↥V) :=
      (TopologicalSpace.Opens.map η_V.base).obj U₀
    have hOV_top : O_V = ⊤ := (IsLocalRing.closedPoint_mem_iff O_V).mp hx_V
    have hRange_V : Set.range η_V.base ⊆ Set.range U₀.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨q, rfl⟩
      have hq : q ∈ O_V := by
        rw [hOV_top]
        trivial
      exact hq
    let ηV_lift : AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ U₀.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U₀.ι η_V hRange_V
    have hηV_lift : ηV_lift ≫ U₀.ι = η_V :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U₀.ι η_V hRange_V
    let R₀ : CommRingCat.{u} := B₂.left.presheaf.obj (Opposite.op U₀)
    obtain ⟨φ₀, _, hφ₀_η₀⟩ := hFuncK₀ U₀ hAffU₀ hNonemptyU₀
    let φ_K : R₀ ⟶ CommRingCat.of K :=
      φ₀ ≫ CommRingCat.ofHom (algebraMap K₀ K)
    have hφK_ηK : AlgebraicGeometry.Spec.map φ_K ≫ hAffU₀.fromSpec = η_K := by
      rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hφ₀_η₀]
    let θ_V : R₀ ⟶ CommRingCat.of ↥V :=
      AlgebraicGeometry.Spec.preimage (ηV_lift ≫ hAffU₀.isoSpec.hom)
    have hθ_φK : θ_V ≫ CommRingCat.ofHom V.subtype = φ_K := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [← CategoryTheory.cancel_mono hAffU₀.fromSpec, hφK_ηK,
        AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← hAffU₀.isoSpec_inv_ι, ← CategoryTheory.Category.assoc hAffU₀.isoSpec.hom,
        Iso.hom_inv_id, CategoryTheory.Category.id_comp, hηV_lift]
      exact hηV_top
    let κ₀ : CommRingCat.of k ⟶ R₀ :=
      AlgebraicGeometry.Spec.preimage (hAffU₀.fromSpec ≫ B₂.hom)
    have hκ₀_φK : κ₀ ≫ φ_K = CommRingCat.ofHom (algebraMap k K) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        ← CategoryTheory.Category.assoc, hφK_ηK, hηK_hom]
    let : Algebra k ↑R₀ := κ₀.hom.toAlgebra
    let Ψ_K : ↑R₀ →ₐ[k] K :=
      { φ_K.hom with
        commutes' := fun c =>
          congrArg (fun (f : CommRingCat.of k ⟶ CommRingCat.of K) => f.hom c) hκ₀_φK }
    have hΨ_V : ∀ r : ↑R₀, Ψ_K r ∈ V := by
      intro r
      have hr : φ_K.hom r = V.subtype (θ_V.hom r) :=
        (congrArg (fun (f : R₀ ⟶ CommRingCat.of K) => f.hom r) hθ_φK).symm
      change φ_K.hom r ∈ V
      rw [hr]
      exact (θ_V.hom r).2
    have hLFT_κ₀ : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map κ₀) := by
      rw [AlgebraicGeometry.Spec.map_preimage]
      infer_instance
    have hFT_R₀ : Algebra.FiniteType k ↑R₀ :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_κ₀
    obtain ⟨t₀, ht₀_fin, ht₀_adj⟩ := Subalgebra.fg_def.mp hFT_R₀.out
    let G₀ : Finset ↑R₀ := ht₀_fin.toFinset
    have hG₀_adj : Algebra.adjoin k (↑G₀ : Set ↑R₀) = ⊤ := by
      rw [ht₀_fin.coe_toFinset]
      exact ht₀_adj
    let : DecidableEq K := Classical.decEq K
    let F_init : Finset K := G₀.image Ψ_K
    have hF_init_V : ∀ x ∈ F_init, x ∈ V := by
      intro x hx
      obtain ⟨g, _, rfl⟩ := Finset.mem_image.mp hx
      exact hΨ_V g
    let A_init : Subalgebra k K := Algebra.adjoin k (↑F_init : Set K)
    have hΨ_mem : ∀ r : ↑R₀, Ψ_K r ∈ A_init := by
      intro r
      change Ψ_K r ∈ Algebra.adjoin k (↑(G₀.image Ψ_K) : Set K)
      rw [Finset.coe_image, Algebra.adjoin_image k Ψ_K (↑G₀ : Set ↑R₀), hG₀_adj]
      exact ⟨r, Algebra.mem_top, rfl⟩
    let ρ₀ : R₀ ⟶ CommRingCat.of ↥A_init :=
      CommRingCat.ofHom
        { toFun := fun r => ⟨Ψ_K r, hΨ_mem r⟩
          map_one' := Subtype.ext (map_one Ψ_K)
          map_mul' := fun a b => Subtype.ext (map_mul Ψ_K a b)
          map_zero' := Subtype.ext (map_zero Ψ_K)
          map_add' := fun a b => Subtype.ext (map_add Ψ_K a b) }
    let μ₀ : AlgebraicGeometry.Spec (CommRingCat.of ↥A_init) ⟶ U₀.toScheme :=
      AlgebraicGeometry.Spec.map ρ₀ ≫ hAffU₀.isoSpec.inv
    refine ⟨U₀, F_init, μ₀, hAffU₀, hNonemptyU₀, hF_init_V, ?_, ?_⟩
    · have hcomp1 : μ₀ ≫ U₀.ι ≫ B₂.hom = AlgebraicGeometry.Spec.map (κ₀ ≫ ρ₀) := by
        simp only [μ₀, CategoryTheory.Category.assoc]
        rw [← CategoryTheory.Category.assoc hAffU₀.isoSpec.inv, hAffU₀.isoSpec_inv_ι,
          ← AlgebraicGeometry.Spec.map_preimage (hAffU₀.fromSpec ≫ B₂.hom),
          ← AlgebraicGeometry.Spec.map_comp]
      rw [hcomp1]
      congr 1
      apply CommRingCat.hom_ext
      ext c
      exact Ψ_K.commutes c
    · have hρ_val : ρ₀ ≫ CommRingCat.ofHom A_init.val.toRingHom = φ_K := by
        apply CommRingCat.hom_ext
        ext r
        rfl
      calc
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom A_init.val.toRingHom) ≫ μ₀ ≫ U₀.ι
          = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom A_init.val.toRingHom) ≫
              AlgebraicGeometry.Spec.map ρ₀) ≫ (hAffU₀.isoSpec.inv ≫ U₀.ι) := by
              simp only [μ₀, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (ρ₀ ≫ CommRingCat.ofHom A_init.val.toRingHom) ≫
              hAffU₀.fromSpec := by
              rw [← AlgebraicGeometry.Spec.map_comp, hAffU₀.isoSpec_inv_ι]
        _ = η_K := by
              rw [hρ_val, hφK_ηK]

theorem weil_fp_affine_charts_and_pairwise_overlaps_descent (J : Type u) [CategoryTheory.SmallCategory J] [CategoryTheory.IsFiltered J]
    (R_diag : CategoryTheory.Functor J CommRingCat.{u})
    (R_V : CommRingCat.{u})
    (ι_colim : R_diag ⟶ (CategoryTheory.Functor.const J).obj R_V)
    (hColim : Nonempty (CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.Cocone.mk R_V ι_colim)))
    (C_V : AlgebraicGeometry.Scheme.{u})
    (g_V : C_V ⟶ AlgebraicGeometry.Spec R_V)
    (hQCV : AlgebraicGeometry.QuasiCompact g_V)
    (hSepV : AlgebraicGeometry.IsSeparated g_V)
    (hLFPV : AlgebraicGeometry.LocallyOfFinitePresentation g_V) :
    ∃ (i₁ : J)
      (J₀ : Type u) (_ : Finite J₀)
      (V_cov : J₀ → C_V.Opens)
      (U₁ : J₀ → AlgebraicGeometry.Scheme.{u})
      (_ : ∀ a : J₀, AlgebraicGeometry.IsAffine (U₁ a))
      (p₁ : ∀ a : J₀, U₁ a ⟶ AlgebraicGeometry.Spec (R_diag.obj i₁))
      (π₁ : ∀ a : J₀, (V_cov a).toScheme ⟶ U₁ a)
      (O₁ : ∀ a b : J₀, (U₁ a).Opens)
      (t₁ : ∀ a b : J₀, (O₁ a b).toScheme ⟶ (O₁ b a).toScheme)
      (θ₁ : ∀ a b : J₀, CategoryTheory.Limits.pullback (V_cov a).ι (V_cov b).ι ⟶ (O₁ a b).toScheme),
      TopologicalSpace.IsOpenCover V_cov ∧
      (∀ a : J₀, AlgebraicGeometry.LocallyOfFinitePresentation (p₁ a)) ∧
      (∀ a : J₀, CategoryTheory.IsPullback (π₁ a) ((V_cov a).ι ≫ g_V) (p₁ a)
        (AlgebraicGeometry.Spec.map (ι_colim.app i₁))) ∧
      (∀ a b : J₀, AlgebraicGeometry.IsAffineOpen (O₁ a b)) ∧
      (∀ a : J₀, O₁ a a = ⊤) ∧
      (∀ a b : J₀,
        (TopologicalSpace.Opens.map (π₁ a).base).obj (O₁ a b) =
          (TopologicalSpace.Opens.map (V_cov a).ι.base).obj (V_cov b)) ∧
      (∀ a : J₀, t₁ a a = 𝟙 _) ∧
      (∀ a b : J₀, t₁ a b ≫ (O₁ b a).ι ≫ p₁ b = (O₁ a b).ι ≫ p₁ a) ∧
      (∀ a b : J₀, θ₁ a b ≫ (O₁ a b).ι =
        CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π₁ a) ∧
      (∀ a b : J₀, θ₁ a b ≫ t₁ a b ≫ (O₁ b a).ι =
        CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π₁ b) :=
by
  classical
  have hStep2 : ∀ (J : Type u) [CategoryTheory.SmallCategory J] [CategoryTheory.IsFiltered J]
      (R_diag : CategoryTheory.Functor J CommRingCat.{u})
      (R_V : CommRingCat.{u})
      (ι_colim : R_diag ⟶ (CategoryTheory.Functor.const J).obj R_V)
      (_ : Nonempty (CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.Cocone.mk R_V ι_colim)))
      (J₀ : Type u) [Finite J₀]
      (B_V : J₀ → CommRingCat.{u})
      (φ_V : ∀ a : J₀, R_V ⟶ B_V a)
      (_ : ∀ a : J₀, (CommRingCat.Hom.hom (φ_V a)).FinitePresentation),
      ∃ (i₀ : J)
        (B₀ : J₀ → CommRingCat.{u})
        (φ₀ : ∀ a : J₀, R_diag.obj i₀ ⟶ B₀ a)
        (ψ₀ : ∀ a : J₀, B₀ a ⟶ B_V a),
        (∀ a : J₀, (CommRingCat.Hom.hom (φ₀ a)).FinitePresentation) ∧
        (∀ a : J₀, CategoryTheory.IsPushout (ι_colim.app i₀) (φ₀ a) (φ_V a) (ψ₀ a)) := by
    intro J _ _ R_diag R_V ι_colim hColim J₀ _ B_V φ_V hFP_V
    obtain ⟨hc⟩ := hColim
    have hPres : ∀ a : J₀,
        ∃ (m t : ℕ) (Φ : MvPolynomial (Fin m) R_V →+* B_V a)
          (g : Fin t → MvPolynomial (Fin m) R_V),
          Function.Surjective Φ ∧
          Φ.comp MvPolynomial.C = (φ_V a).hom ∧
          Ideal.span (Set.range g) = RingHom.ker Φ := by
      intro a
      let _ : Algebra R_V (B_V a) := (φ_V a).hom.toAlgebra
      have hAlgFP : Algebra.FinitePresentation R_V (B_V a) := hFP_V a
      obtain ⟨m, Φ_alg, hSurj, hFG⟩ := hAlgFP.out
      obtain ⟨t, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hFG
      refine ⟨m, t, Φ_alg.toRingHom, g, hSurj, ?_, hg⟩
      ext r
      exact Φ_alg.commutes r
    choose m_a t_a Φ_a g_V hSurj_a hΦ_C hKer_a using hPres

    let c_V : CategoryTheory.Limits.Cocone R_diag :=
      CategoryTheory.Limits.Cocone.mk R_V ι_colim
    have hc_type : CategoryTheory.Limits.IsColimit
        ((CategoryTheory.forget CommRingCat.{u}).mapCocone c_V) :=
      CategoryTheory.Limits.isColimitOfPreserves (CategoryTheory.forget CommRingCat.{u}) hc

    let Idx : Type u := Σ (a : J₀) (ν : Fin (t_a a)), ↥(g_V a ν).support
    have _ : Finite Idx := inferInstance
    have hLiftCoeff : ∀ ξ : Idx,
        ∃ (j : J) (c : R_diag.obj j),
          (ι_colim.app j).hom c = (g_V ξ.1 ξ.2.1).coeff ξ.2.2.1 := by
      intro ξ
      obtain ⟨j, c, hc_eq⟩ :=
        CategoryTheory.Limits.Types.jointly_surjective_of_isColimit hc_type
          ((g_V ξ.1 ξ.2.1).coeff ξ.2.2.1)
      exact ⟨j, c, hc_eq⟩
    choose j_ξ c_ξ hc_ξ using hLiftCoeff

    obtain ⟨i_root⟩ := CategoryTheory.IsFiltered.nonempty (C := J)
    let j'_ξ : Idx → J := fun ξ => CategoryTheory.IsFiltered.max i_root (j_ξ ξ)
    let f_ξ : ∀ ξ : Idx, i_root ⟶ j'_ξ ξ :=
      fun ξ => CategoryTheory.IsFiltered.leftToMax i_root (j_ξ ξ)
    obtain ⟨i₀, _, w_ξ, _⟩ := CategoryTheory.IsFiltered.wideSpan f_ξ

    let R₀ : CommRingCat.{u} := R_diag.obj i₀
    let c₀ : Idx → R₀ := fun ξ =>
      (R_diag.map (CategoryTheory.IsFiltered.rightToMax i_root (j_ξ ξ) ≫ w_ξ ξ)).hom (c_ξ ξ)
    have hc₀ : ∀ ξ : Idx, (ι_colim.app i₀).hom (c₀ ξ) = (g_V ξ.1 ξ.2.1).coeff ξ.2.2.1 := by
      intro ξ
      have hnat := (ι_colim.naturality
        (CategoryTheory.IsFiltered.rightToMax i_root (j_ξ ξ) ≫ w_ξ ξ)).trans
        (CategoryTheory.Category.comp_id _)
      have happ := congrArg (fun f => f.hom (c_ξ ξ)) hnat
      exact happ.trans (hc_ξ ξ)

    let g₀ : ∀ (a : J₀), Fin (t_a a) → MvPolynomial (Fin (m_a a)) R₀ :=
      fun a ν => ∑ d ∈ (g_V a ν).support.attach, MvPolynomial.monomial d.1 (c₀ ⟨a, ν, d⟩)
    have hg₀_map : ∀ (a : J₀) (ν : Fin (t_a a)),
        MvPolynomial.map (ι_colim.app i₀).hom (g₀ a ν) = g_V a ν := by
      intro a ν
      dsimp [g₀]
      rw [map_sum]
      simp only [MvPolynomial.map_monomial, hc₀]
      rw [Finset.sum_attach (g_V a ν).support
        (fun d => MvPolynomial.monomial d ((g_V a ν).coeff d))]
      exact (MvPolynomial.as_sum (g_V a ν)).symm

    let I₀ : ∀ a : J₀, Ideal (MvPolynomial (Fin (m_a a)) R₀) :=
      fun a => Ideal.span (Set.range (g₀ a))
    let B₀ : J₀ → CommRingCat.{u} :=
      fun a => CommRingCat.of (MvPolynomial (Fin (m_a a)) R₀ ⧸ I₀ a)
    let φ₀ : ∀ a : J₀, R₀ ⟶ B₀ a :=
      fun a => CommRingCat.ofHom ((Ideal.Quotient.mk (I₀ a)).comp MvPolynomial.C)

    let μ : ∀ a : J₀, MvPolynomial (Fin (m_a a)) R₀ →+* MvPolynomial (Fin (m_a a)) R_V :=
      fun a => MvPolynomial.map (ι_colim.app i₀).hom

    have hI₀_ker : ∀ (a : J₀) (P : MvPolynomial (Fin (m_a a)) R₀),
        P ∈ I₀ a → Φ_a a (μ a P) = 0 := by
      intro a P hP
      have hmap : μ a P ∈ Ideal.map (μ a) (I₀ a) := Ideal.mem_map_of_mem (μ a) hP
      have hspan : Ideal.map (μ a) (I₀ a) = Ideal.span (Set.range (g_V a)) := by
        dsimp [I₀]
        rw [Ideal.map_span, ← Set.range_comp]
        exact congrArg Ideal.span (congrArg Set.range (funext fun ν => hg₀_map a ν))
      rw [hspan, hKer_a a] at hmap
      exact hmap

    let ψ₀ : ∀ a : J₀, B₀ a ⟶ B_V a :=
      fun a => CommRingCat.ofHom
        (Ideal.Quotient.lift (I₀ a) ((Φ_a a).comp (μ a)) (hI₀_ker a))

    refine ⟨i₀, B₀, φ₀, ψ₀, ?_, ?_⟩
    · intro a
      change @Algebra.FinitePresentation R₀ (B₀ a) _ _ (φ₀ a).hom.toAlgebra
      let _ : Algebra R₀ (B₀ a) := (φ₀ a).hom.toAlgebra
      have hmk_alg : ∀ r : R₀,
          (Ideal.Quotient.mk (I₀ a)) (MvPolynomial.C r) = algebraMap R₀ (B₀ a) r := fun _ => rfl
      let q_alg : MvPolynomial (Fin (m_a a)) R₀ →ₐ[R₀] B₀ a :=
        { (Ideal.Quotient.mk (I₀ a)) with commutes' := hmk_alg }
      refine Algebra.FinitePresentation.mk ⟨m_a a, q_alg, Ideal.Quotient.mk_surjective, ?_⟩
      have hker_q : RingHom.ker q_alg.toRingHom = I₀ a := Ideal.mk_ker
      rw [hker_q]
      exact Submodule.fg_span (Set.finite_range (g₀ a))
    · intro a
      have hw : ι_colim.app i₀ ≫ φ_V a = φ₀ a ≫ ψ₀ a := by
        refine CommRingCat.hom_ext (RingHom.ext fun r => ?_)
        change (φ_V a).hom ((ι_colim.app i₀).hom r) =
          Φ_a a (MvPolynomial.map (ι_colim.app i₀).hom (MvPolynomial.C r))
        rw [MvPolynomial.map_C]
        exact (RingHom.congr_fun (hΦ_C a) ((ι_colim.app i₀).hom r)).symm
      refine CategoryTheory.IsPushout.of_isColimit
        (c := CategoryTheory.Limits.PushoutCocone.mk (φ_V a) (ψ₀ a) hw) ?_
      refine CategoryTheory.Limits.PushoutCocone.isColimitAux' _ fun s => ?_
      let s₁ : R_V →+* s.pt := s.inl.hom
      let s₂ : B₀ a →+* s.pt := s.inr.hom
      have hs_comm : ∀ r : R₀, s₁ ((ι_colim.app i₀).hom r) = s₂ ((φ₀ a).hom r) :=
        fun r => congrArg (fun f => f.hom r) s.condition
      let x_img : Fin (m_a a) → s.pt := fun k => s₂ (Ideal.Quotient.mk (I₀ a) (MvPolynomial.X k))
      let L_poly : MvPolynomial (Fin (m_a a)) R_V →+* s.pt := MvPolynomial.eval₂Hom s₁ x_img
      have hL_μ : L_poly.comp (μ a) = s₂.comp (Ideal.Quotient.mk (I₀ a)) := by
        apply MvPolynomial.ringHom_ext'
        · ext r
          change L_poly (MvPolynomial.map (ι_colim.app i₀).hom (MvPolynomial.C r)) = s₂ ((φ₀ a).hom r)
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
          exact hs_comm r
        · intro k
          change L_poly (MvPolynomial.map (ι_colim.app i₀).hom (MvPolynomial.X k)) = x_img k
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
      have hKer_le : RingHom.ker (Φ_a a) ≤ RingHom.ker L_poly := by
        rw [← hKer_a a, Ideal.span_le]
        rintro _ ⟨ν, rfl⟩
        change L_poly (g_V a ν) = 0
        rw [← hg₀_map a ν]
        change (L_poly.comp (μ a)) (g₀ a ν) = 0
        rw [hL_μ]
        change s₂ (Ideal.Quotient.mk (I₀ a) (g₀ a ν)) = 0
        have hmem : g₀ a ν ∈ I₀ a := Ideal.subset_span ⟨ν, rfl⟩
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
      let e_quot : MvPolynomial (Fin (m_a a)) R_V ⧸ RingHom.ker (Φ_a a) ≃+* B_V a :=
        RingHom.quotientKerEquivOfSurjective (hSurj_a a)
      let l_hom : B_V a →+* s.pt :=
        (Ideal.Quotient.lift (RingHom.ker (Φ_a a)) L_poly (fun _ h => hKer_le h)).comp
          e_quot.symm.toRingHom
      have hl_Φ : ∀ P : MvPolynomial (Fin (m_a a)) R_V, l_hom (Φ_a a P) = L_poly P := by
        intro P
        have he : e_quot (Ideal.Quotient.mk (RingHom.ker (Φ_a a)) P) = Φ_a a P := rfl
        rw [← he]
        change Ideal.Quotient.lift (RingHom.ker (Φ_a a)) L_poly (fun _ h => hKer_le h)
          (e_quot.symm (e_quot (Ideal.Quotient.mk (RingHom.ker (Φ_a a)) P))) = L_poly P
        rw [RingEquiv.symm_apply_apply]
        rfl
      refine ⟨CommRingCat.ofHom l_hom, ?_, ?_, ?_⟩
      · refine CommRingCat.hom_ext (RingHom.ext fun r => ?_)
        change l_hom ((φ_V a).hom r) = s₁ r
        rw [← RingHom.congr_fun (hΦ_C a) r]
        change l_hom (Φ_a a (MvPolynomial.C r)) = s₁ r
        rw [hl_Φ, MvPolynomial.eval₂Hom_C]
      · refine CommRingCat.hom_ext (RingHom.ext fun q => ?_)
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q
        change l_hom (Φ_a a (μ a P)) = (s₂.comp (Ideal.Quotient.mk (I₀ a))) P
        rw [hl_Φ, ← hL_μ]
        rfl
      · intro m hm₁ hm₂
        let m' : B_V a ⟶ s.pt := m
        refine CommRingCat.hom_ext (RingHom.ext fun b => ?_)
        obtain ⟨P, rfl⟩ := hSurj_a a b
        change m'.hom (Φ_a a P) = l_hom (Φ_a a P)
        rw [hl_Φ]
        have hm_poly : m'.hom.comp (Φ_a a) = L_poly := by
          apply MvPolynomial.ringHom_ext'
          · ext r
            change m'.hom (Φ_a a (MvPolynomial.C r)) = L_poly (MvPolynomial.C r)
            have hC_r : Φ_a a (MvPolynomial.C r) = (φ_V a).hom r :=
              RingHom.congr_fun (hΦ_C a) r
            rw [hC_r, MvPolynomial.eval₂Hom_C]
            exact congrArg (fun f => f.hom r) hm₁
          · intro k
            have hX : Φ_a a (MvPolynomial.X k) = (ψ₀ a).hom (Ideal.Quotient.mk (I₀ a) (MvPolynomial.X k)) := by
              change Φ_a a (MvPolynomial.X k) = Φ_a a (MvPolynomial.map (ι_colim.app i₀).hom (MvPolynomial.X k))
              rw [MvPolynomial.map_X]
            change m'.hom (Φ_a a (MvPolynomial.X k)) = L_poly (MvPolynomial.X k)
            rw [hX, MvPolynomial.eval₂Hom_X']
            exact congrArg (fun f => f.hom (Ideal.Quotient.mk (I₀ a) (MvPolynomial.X k))) hm₂
        exact RingHom.congr_fun hm_poly P

  have hStep4 : ∀ (R₀ R_V : CommRingCat.{u})
      (β₀ : R₀ ⟶ R_V)
      (J : Type u) [CategoryTheory.SmallCategory J] [CategoryTheory.IsFiltered J]
      (R_diag : CategoryTheory.Functor J CommRingCat.{u})
      (α_diag : (CategoryTheory.Functor.const J).obj R₀ ⟶ R_diag)
      (ι_colim : R_diag ⟶ (CategoryTheory.Functor.const J).obj R_V)
      (_ : Nonempty (CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.Cocone.mk R_V ι_colim)))
      (_ : ∀ i : J, α_diag.app i ≫ ι_colim.app i = β₀)
      (C_V : AlgebraicGeometry.Scheme.{u})
      (g_V : C_V ⟶ AlgebraicGeometry.Spec R_V)
      (_ : AlgebraicGeometry.IsSeparated g_V)
      (J₀ : Type u) [Finite J₀]
      (V_cov : J₀ → C_V.Opens)
      (_ : ∀ a : J₀, AlgebraicGeometry.IsAffineOpen (V_cov a))
      (U₀ : J₀ → AlgebraicGeometry.Scheme.{u}) [∀ a : J₀, AlgebraicGeometry.IsAffine (U₀ a)]
      (p₀ : ∀ a : J₀, U₀ a ⟶ AlgebraicGeometry.Spec R₀)
      (_ : ∀ a : J₀, AlgebraicGeometry.LocallyOfFinitePresentation (p₀ a))
      (π₀ : ∀ a : J₀, (V_cov a).toScheme ⟶ U₀ a)
      (_ : ∀ a : J₀, CategoryTheory.IsPullback (π₀ a) ((V_cov a).ι ≫ g_V) (p₀ a)
        (AlgebraicGeometry.Spec.map β₀)),
      ∃ (i_O : J)
        (U_O : J₀ → AlgebraicGeometry.Scheme.{u})
        (_ : ∀ a : J₀, AlgebraicGeometry.IsAffine (U_O a))
        (p_O : ∀ a : J₀, U_O a ⟶ AlgebraicGeometry.Spec (R_diag.obj i_O))
        (π_O : ∀ a : J₀, (V_cov a).toScheme ⟶ U_O a)
        (O_O : ∀ a : J₀, J₀ → (U_O a).Opens)
        (θ_O : ∀ a b : J₀, CategoryTheory.Limits.pullback (V_cov a).ι (V_cov b).ι ⟶ (O_O a b).toScheme),
        (∀ a : J₀, AlgebraicGeometry.LocallyOfFinitePresentation (p_O a)) ∧
        (∀ a : J₀, CategoryTheory.IsPullback (π_O a) ((V_cov a).ι ≫ g_V) (p_O a)
          (AlgebraicGeometry.Spec.map (ι_colim.app i_O))) ∧
        (∀ a b : J₀, AlgebraicGeometry.IsAffineOpen (O_O a b)) ∧
        (∀ a : J₀, O_O a a = ⊤) ∧
        (∀ a b : J₀,
          (TopologicalSpace.Opens.map (π_O a).base).obj (O_O a b) =
            (TopologicalSpace.Opens.map (V_cov a).ι.base).obj (V_cov b)) ∧
        (∀ a b : J₀, θ_O a b ≫ (O_O a b).ι =
          CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_O a) := by
    intro R₀ R_V β₀ J _ _ R_diag α_diag ι_colim hColim hα_comp C_V g_V hSepV J₀ _ V_cov hAffV U₀ _ p₀ hLFP₀ π₀ hPb₀
    obtain ⟨hc⟩ := hColim
    let _ := AlgebraicGeometry.ΓSpec.adjunction.isRightAdjoint
    let c_V : CategoryTheory.Limits.Cocone R_diag :=
      CategoryTheory.Limits.Cocone.mk R_V ι_colim
    let D_S : Jᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u} :=
      R_diag.op ⋙ AlgebraicGeometry.Scheme.Spec
    let c_S : CategoryTheory.Limits.Cone D_S :=
      AlgebraicGeometry.Scheme.Spec.mapCone c_V.op
    have hc_S : CategoryTheory.Limits.IsLimit c_S :=
      CategoryTheory.Limits.isLimitOfPreserves AlgebraicGeometry.Scheme.Spec hc.op

    let f_i : ∀ i : J, AlgebraicGeometry.Spec (R_diag.obj i) ⟶ AlgebraicGeometry.Spec R₀ :=
      fun i => AlgebraicGeometry.Spec.map (α_diag.app i)
    let ρ_i : ∀ i : J, AlgebraicGeometry.Spec R_V ⟶ AlgebraicGeometry.Spec (R_diag.obj i) :=
      fun i => AlgebraicGeometry.Spec.map (ι_colim.app i)
    have hρf : ∀ i : J, ρ_i i ≫ f_i i = AlgebraicGeometry.Spec.map β₀ := by
      intro i
      dsimp [ρ_i, f_i]
      rw [← AlgebraicGeometry.Spec.map_comp, hα_comp i]
    have hα_nat : ∀ {i j : J} (u : i ⟶ j),
        AlgebraicGeometry.Spec.map (R_diag.map u) ≫ f_i i = f_i j := by
      intro i j u
      dsimp [f_i]
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1
      have hnat := α_diag.naturality u
      dsimp at hnat
      rw [CategoryTheory.Category.id_comp] at hnat
      exact hnat.symm
    have hι_nat : ∀ {i j : J} (u : i ⟶ j),
        ρ_i j ≫ AlgebraicGeometry.Spec.map (R_diag.map u) = ρ_i i := by
      intro i j u
      dsimp [ρ_i]
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1
      exact (ι_colim.naturality u).trans (CategoryTheory.Category.comp_id _)

    let U_i : ∀ (a : J₀) (i : J), AlgebraicGeometry.Scheme.{u} :=
      fun a i => CategoryTheory.Limits.pullback (p₀ a) (f_i i)
    let fst_i : ∀ (a : J₀) (i : J), U_i a i ⟶ U₀ a :=
      fun a i => CategoryTheory.Limits.pullback.fst (p₀ a) (f_i i)
    let p_i : ∀ (a : J₀) (i : J), U_i a i ⟶ AlgebraicGeometry.Spec (R_diag.obj i) :=
      fun a i => CategoryTheory.Limits.pullback.snd (p₀ a) (f_i i)
    have hAff_Ui : ∀ (a : J₀) (i : J), AlgebraicGeometry.IsAffine (U_i a i) :=
      fun _ _ => inferInstance
    have hLFP_pi : ∀ (a : J₀) (i : J), AlgebraicGeometry.LocallyOfFinitePresentation (p_i a i) := by
      intro a i
      have _ := hLFP₀ a
      infer_instance

    let π_i : ∀ (a : J₀) (i : J), (V_cov a).toScheme ⟶ U_i a i :=
      fun a i => CategoryTheory.Limits.pullback.lift (π₀ a) ((V_cov a).ι ≫ g_V ≫ ρ_i i)
        (by rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hρf i,
              ← CategoryTheory.Category.assoc, (hPb₀ a).w])
    have hPb_i : ∀ (a : J₀) (i : J),
        CategoryTheory.IsPullback (π_i a i) ((V_cov a).ι ≫ g_V) (p_i a i) (ρ_i i) := by
      intro a i
      refine CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback (p₀ a) (f_i i))
      have h1 : π_i a i ≫ fst_i a i = π₀ a :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [h1, hρf i]
      exact hPb₀ a

    let map_U : ∀ (a : J₀) {i j : J}, (i ⟶ j) → (U_i a j ⟶ U_i a i) :=
      fun a {i j} u => CategoryTheory.Limits.pullback.lift (fst_i a j)
        (p_i a j ≫ AlgebraicGeometry.Spec.map (R_diag.map u))
        (by rw [CategoryTheory.Category.assoc, hα_nat u, CategoryTheory.Limits.pullback.condition])

    let D_U : J₀ → (Jᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u}) := fun a =>
      { obj := fun x => U_i a x.unop
        map := fun f => map_U a f.unop
        map_id := fun x => by
          dsimp [map_U, fst_i, p_i]
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Limits.pullback.lift_snd, R_diag.map_id,
              AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
        map_comp := fun f g => by
          dsimp [map_U, fst_i, p_i]
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
          · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
              R_diag.map_comp, AlgebraicGeometry.Spec.map_comp] }

    let nat_p : ∀ a : J₀, D_U a ⟶ D_S := fun a =>
      { app := fun x => p_i a x.unop
        naturality := fun x y f => by
          dsimp [D_U, D_S, map_U]
          exact CategoryTheory.Limits.pullback.lift_snd _ _ _ }

    have hπ_fst : ∀ (a : J₀) (i : J), π_i a i ≫ fst_i a i = π₀ a :=
      fun _ _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hmap_fst : ∀ (a : J₀) {i j : J} (u : i ⟶ j), map_U a u ≫ fst_i a i = fst_i a j :=
      fun _ {_ _} _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hmap_p : ∀ (a : J₀) {i j : J} (u : i ⟶ j),
        map_U a u ≫ p_i a i = p_i a j ≫ AlgebraicGeometry.Spec.map (R_diag.map u) :=
      fun _ {_ _} _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hπ_map : ∀ (a : J₀) {i j : J} (u : i ⟶ j),
        π_i a j ≫ map_U a u = π_i a i := by
      intro a i j u
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc (π_i a j ≫ map_U a u) ≫ fst_i a i
          _ = π_i a j ≫ (map_U a u ≫ fst_i a i) := by simp only [CategoryTheory.Category.assoc]
          _ = π_i a j ≫ fst_i a j := by rw [hmap_fst a u]
          _ = π₀ a := hπ_fst a j
          _ = π_i a i ≫ fst_i a i := (hπ_fst a i).symm
      · calc (π_i a j ≫ map_U a u) ≫ p_i a i
          _ = π_i a j ≫ (map_U a u ≫ p_i a i) := by simp only [CategoryTheory.Category.assoc]
          _ = (π_i a j ≫ p_i a j) ≫ AlgebraicGeometry.Spec.map (R_diag.map u) := by
                rw [hmap_p a u, CategoryTheory.Category.assoc]
          _ = ((V_cov a).ι ≫ g_V ≫ ρ_i j) ≫ AlgebraicGeometry.Spec.map (R_diag.map u) := by
                rw [CategoryTheory.Limits.pullback.lift_snd]
          _ = (V_cov a).ι ≫ g_V ≫ (ρ_i j ≫ AlgebraicGeometry.Spec.map (R_diag.map u)) := by
                simp only [CategoryTheory.Category.assoc]
          _ = (V_cov a).ι ≫ g_V ≫ ρ_i i := by rw [hι_nat u]
          _ = π_i a i ≫ p_i a i := (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm

    let c_U : ∀ a : J₀, CategoryTheory.Limits.Cone (D_U a) := fun a =>
      { pt := (V_cov a).toScheme
        π :=
          { app := fun x => π_i a x.unop
            naturality := fun x y f => by
              dsimp [D_U]
              rw [CategoryTheory.Category.id_comp]
              exact (hπ_map a f.unop).symm } }

    let cone_hom : ∀ a : J₀,
        (CategoryTheory.Limits.Cone.postcompose (nat_p a)).obj (c_U a) ⟶ c_S := fun a =>
      { hom := (V_cov a).ι ≫ g_V
        w := fun x => (hPb_i a x.unop).w.symm }

    have _ : CategoryTheory.IsConnected Jᵒᵖ := CategoryTheory.IsCofiltered.isConnected Jᵒᵖ
    have hc_U : ∀ a : J₀, CategoryTheory.Limits.IsLimit (c_U a) := fun a =>
      CategoryTheory.Limits.isLimitOfIsPullbackOfIsConnected
        (nat_p a) (c_U a) c_S (cone_hom a) (fun x => hPb_i a x.unop) hc_S

    have hterm : CategoryTheory.Limits.terminal.from C_V =
        g_V ≫ CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec R_V) :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    have _ : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from C_V) := by
      rw [hterm]
      infer_instance

    let O_V : ∀ a : J₀, J₀ → (V_cov a).toScheme.Opens :=
      fun a b => (TopologicalSpace.Opens.map (V_cov a).ι.base).obj (V_cov b)
    have hAff_OV : ∀ a b : J₀, AlgebraicGeometry.IsAffineOpen (O_V a b) := by
      intro a b
      have heq : O_V a b = (TopologicalSpace.Opens.map (V_cov a).ι.base).obj (V_cov a ⊓ V_cov b) := by
        ext x
        simp only [O_V, TopologicalSpace.Opens.map_coe, Set.mem_preimage,
          TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff, iff_and_self]
        intro _
        exact x.2
      rw [heq]
      exact ((hAffV a).inf (hAffV b)).preimage_of_isOpenImmersion (V_cov a).ι
        (by rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]; exact inf_le_left)

    have hAff_DU : ∀ (a : J₀) (x : Jᵒᵖ), AlgebraicGeometry.IsAffine ((D_U a).obj x) :=
      fun a x => hAff_Ui a x.unop
    have hQS_DU : ∀ (a : J₀) (x : Jᵒᵖ), QuasiSeparatedSpace ↥((D_U a).obj x) :=
      fun _ _ => inferInstance
    have hAffHom_DU : ∀ (a : J₀) {x y : Jᵒᵖ} (f : x ⟶ y),
        AlgebraicGeometry.IsAffineHom ((D_U a).map f) :=
      fun _ _ _ _ => inferInstance

    let OffDiag : Type u := {p : J₀ × J₀ // p.1 ≠ p.2}
    have _ : Finite OffDiag := inferInstance
    have hDescOff : ∀ q : OffDiag,
        ∃ (j : J) (O' : (U_i q.1.1 j).Opens),
          AlgebraicGeometry.IsAffineOpen O' ∧
          (TopologicalSpace.Opens.map (π_i q.1.1 j).base).obj O' = O_V q.1.1 q.1.2 := by
      intro q
      let a := q.1.1
      let b := q.1.2
      have _ : ∀ x : Jᵒᵖ, QuasiSeparatedSpace ↥((D_U a).obj x) := hQS_DU a
      have _ : ∀ {x y : Jᵒᵖ} (f : x ⟶ y), AlgebraicGeometry.IsAffineHom ((D_U a).map f) :=
        fun f => hAffHom_DU a f
      obtain ⟨x_q, O', hO'_aff, hO'_pre⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_preimage_eq (D_U a) (c_U a) (hc_U a)
          (O_V a b) (hAff_OV a b)
      exact ⟨x_q.unop, O', hO'_aff, hO'_pre⟩
    choose j_q O'_q hAff_O' hPre_O' using hDescOff

    obtain ⟨i_root⟩ := CategoryTheory.IsFiltered.nonempty (C := J)
    let j'_q : OffDiag → J := fun q => CategoryTheory.IsFiltered.max i_root (j_q q)
    let f_q : ∀ q : OffDiag, i_root ⟶ j'_q q :=
      fun q => CategoryTheory.IsFiltered.leftToMax i_root (j_q q)
    obtain ⟨i_O, _, w_q, _⟩ := CategoryTheory.IsFiltered.wideSpan f_q
    let u_q : ∀ q : OffDiag, j_q q ⟶ i_O :=
      fun q => CategoryTheory.IsFiltered.rightToMax i_root (j_q q) ≫ w_q q

    let O_O : ∀ a : J₀, J₀ → (U_i a i_O).Opens :=
      fun a b =>
        if h : a = b then ⊤
        else (TopologicalSpace.Opens.map (map_U a (u_q ⟨(a, b), h⟩)).base).obj (O'_q ⟨(a, b), h⟩)

    have hO_diag : ∀ a : J₀, O_O a a = ⊤ := fun a => by simp [O_O]
    have hO_aff : ∀ a b : J₀, AlgebraicGeometry.IsAffineOpen (O_O a b) := by
      intro a b
      by_cases h : a = b
      · simp only [O_O, h, ↓reduceDIte]
        exact AlgebraicGeometry.isAffineOpen_top (U_i a i_O)
      · simp only [O_O, h, ↓reduceDIte]
        have _ : AlgebraicGeometry.IsAffineHom (map_U a (u_q ⟨(a, b), h⟩)) := inferInstance
        exact (hAff_O' ⟨(a, b), h⟩).preimage (map_U a (u_q ⟨(a, b), h⟩))

    have hO_pre : ∀ a b : J₀,
        (TopologicalSpace.Opens.map (π_i a i_O).base).obj (O_O a b) = O_V a b := by
      intro a b
      by_cases h : a = b
      · subst h
        rw [hO_diag a]
        ext x
        simp only [TopologicalSpace.Opens.map_top, TopologicalSpace.Opens.coe_top,
          Set.mem_univ, true_iff, O_V, TopologicalSpace.Opens.map_coe, Set.mem_preimage]
        exact x.2
      · simp only [O_O, h, ↓reduceDIte]
        have hcomp : π_i a i_O ≫ map_U a (u_q ⟨(a, b), h⟩) = π_i a (j_q ⟨(a, b), h⟩) :=
          (c_U a).w (u_q ⟨(a, b), h⟩).op
        ext x
        change (map_U a (u_q ⟨(a, b), h⟩)).base ((π_i a i_O).base x) ∈ O'_q ⟨(a, b), h⟩ ↔
          x ∈ O_V a b
        have hpt : (map_U a (u_q ⟨(a, b), h⟩)).base ((π_i a i_O).base x) =
            (π_i a (j_q ⟨(a, b), h⟩)).base x :=
          congrArg (fun φ => φ.base x) hcomp
        rw [hpt, ← hPre_O' ⟨(a, b), h⟩]
        rfl

    have hRange_θ : ∀ a b : J₀,
        Set.range (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_i a i_O).base ⊆
          Set.range (O_O a b).ι.base := by
      intro a b
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      change (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι).base z ∈
        (TopologicalSpace.Opens.map (π_i a i_O).base).obj (O_O a b)
      rw [hO_pre a b]
      change (V_cov a).ι.base ((CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι).base z) ∈
        V_cov b
      have hcond :
          (V_cov a).ι.base ((CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι).base z) =
            (V_cov b).ι.base ((CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι).base z) :=
        congrArg (fun φ => φ.base z)
          (CategoryTheory.Limits.pullback.condition (f := (V_cov a).ι) (g := (V_cov b).ι))
      rw [hcond]
      exact ((CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι).base z).2

    let θ_O : ∀ a b : J₀,
        CategoryTheory.Limits.pullback (V_cov a).ι (V_cov b).ι ⟶ (O_O a b).toScheme :=
      fun a b => AlgebraicGeometry.IsOpenImmersion.lift (O_O a b).ι
        (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_i a i_O)
        (hRange_θ a b)

    refine ⟨i_O, fun a => U_i a i_O, fun a => hAff_Ui a i_O, fun a => p_i a i_O,
      fun a => π_i a i_O, O_O, θ_O, fun a => hLFP_pi a i_O, fun a => hPb_i a i_O,
      hO_aff, hO_diag, hO_pre, ?_⟩
    intro a b
    exact AlgebraicGeometry.IsOpenImmersion.lift_fac (O_O a b).ι
      (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_i a i_O) (hRange_θ a b)

  have hStep5 : ∀ (R_O R_V : CommRingCat.{u})
      (β_O : R_O ⟶ R_V)
      (J : Type u) [CategoryTheory.SmallCategory J] [CategoryTheory.IsFiltered J]
      (R_diag : CategoryTheory.Functor J CommRingCat.{u})
      (α_diag : (CategoryTheory.Functor.const J).obj R_O ⟶ R_diag)
      (ι_colim : R_diag ⟶ (CategoryTheory.Functor.const J).obj R_V)
      (_ : Nonempty (CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.Cocone.mk R_V ι_colim)))
      (_ : ∀ i : J, α_diag.app i ≫ ι_colim.app i = β_O)
      (C_V : AlgebraicGeometry.Scheme.{u})
      (g_V : C_V ⟶ AlgebraicGeometry.Spec R_V)
      (J₀ : Type u) [Finite J₀]
      (V_cov : J₀ → C_V.Opens)
      (U_O : J₀ → AlgebraicGeometry.Scheme.{u}) [∀ a : J₀, AlgebraicGeometry.IsAffine (U_O a)]
      (p_O : ∀ a : J₀, U_O a ⟶ AlgebraicGeometry.Spec R_O)
      (_ : ∀ a : J₀, AlgebraicGeometry.LocallyOfFinitePresentation (p_O a))
      (π_O : ∀ a : J₀, (V_cov a).toScheme ⟶ U_O a)
      (_ : ∀ a : J₀, CategoryTheory.IsPullback (π_O a) ((V_cov a).ι ≫ g_V) (p_O a)
        (AlgebraicGeometry.Spec.map β_O))
      (O_O : ∀ a : J₀, J₀ → (U_O a).Opens)
      (_ : ∀ a b : J₀, AlgebraicGeometry.IsAffineOpen (O_O a b))
      (_ : ∀ a : J₀, O_O a a = ⊤)
      (_ : ∀ a b : J₀,
        (TopologicalSpace.Opens.map (π_O a).base).obj (O_O a b) =
          (TopologicalSpace.Opens.map (V_cov a).ι.base).obj (V_cov b))
      (θ_O : ∀ a b : J₀, CategoryTheory.Limits.pullback (V_cov a).ι (V_cov b).ι ⟶ (O_O a b).toScheme)
      (_ : ∀ a b : J₀, θ_O a b ≫ (O_O a b).ι =
        CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_O a),
      ∃ (i₁ : J)
        (U₁ : J₀ → AlgebraicGeometry.Scheme.{u})
        (_ : ∀ a : J₀, AlgebraicGeometry.IsAffine (U₁ a))
        (p₁ : ∀ a : J₀, U₁ a ⟶ AlgebraicGeometry.Spec (R_diag.obj i₁))
        (π₁ : ∀ a : J₀, (V_cov a).toScheme ⟶ U₁ a)
        (O₁ : ∀ a : J₀, J₀ → (U₁ a).Opens)
        (t₁ : ∀ a b : J₀, (O₁ a b).toScheme ⟶ (O₁ b a).toScheme)
        (θ₁ : ∀ a b : J₀, CategoryTheory.Limits.pullback (V_cov a).ι (V_cov b).ι ⟶ (O₁ a b).toScheme),
        (∀ a : J₀, AlgebraicGeometry.LocallyOfFinitePresentation (p₁ a)) ∧
        (∀ a : J₀, CategoryTheory.IsPullback (π₁ a) ((V_cov a).ι ≫ g_V) (p₁ a)
          (AlgebraicGeometry.Spec.map (ι_colim.app i₁))) ∧
        (∀ a b : J₀, AlgebraicGeometry.IsAffineOpen (O₁ a b)) ∧
        (∀ a : J₀, O₁ a a = ⊤) ∧
        (∀ a b : J₀,
          (TopologicalSpace.Opens.map (π₁ a).base).obj (O₁ a b) =
            (TopologicalSpace.Opens.map (V_cov a).ι.base).obj (V_cov b)) ∧
        (∀ a : J₀, t₁ a a = 𝟙 _) ∧
        (∀ a b : J₀, t₁ a b ≫ (O₁ b a).ι ≫ p₁ b = (O₁ a b).ι ≫ p₁ a) ∧
        (∀ a b : J₀, θ₁ a b ≫ (O₁ a b).ι =
          CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π₁ a) ∧
        (∀ a b : J₀, θ₁ a b ≫ t₁ a b ≫ (O₁ b a).ι =
          CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π₁ b) := by
    intro R_O R_V β_O J _ _ R_diag α_diag ι_colim hColim hα_comp C_V g_V J₀ _ V_cov U_O _ p_O hLFP_O π_O hPb_O O_O hO_aff hO_diag hO_pre θ_O hθ_fst
    obtain ⟨hc⟩ := hColim
    let _ := AlgebraicGeometry.ΓSpec.adjunction.isRightAdjoint
    let c_V : CategoryTheory.Limits.Cocone R_diag :=
      CategoryTheory.Limits.Cocone.mk R_V ι_colim
    let D_S : Jᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u} :=
      R_diag.op ⋙ AlgebraicGeometry.Scheme.Spec
    let c_S : CategoryTheory.Limits.Cone D_S :=
      AlgebraicGeometry.Scheme.Spec.mapCone c_V.op
    have hc_S : CategoryTheory.Limits.IsLimit c_S :=
      CategoryTheory.Limits.isLimitOfPreserves AlgebraicGeometry.Scheme.Spec hc.op
    have _ : CategoryTheory.IsConnected Jᵒᵖ := CategoryTheory.IsCofiltered.isConnected Jᵒᵖ

    let f_i : ∀ i : J, AlgebraicGeometry.Spec (R_diag.obj i) ⟶ AlgebraicGeometry.Spec R_O :=
      fun i => AlgebraicGeometry.Spec.map (α_diag.app i)
    let ρ_i : ∀ i : J, AlgebraicGeometry.Spec R_V ⟶ AlgebraicGeometry.Spec (R_diag.obj i) :=
      fun i => AlgebraicGeometry.Spec.map (ι_colim.app i)
    have hρf : ∀ i : J, ρ_i i ≫ f_i i = AlgebraicGeometry.Spec.map β_O := by
      intro i
      dsimp [ρ_i, f_i]
      rw [← AlgebraicGeometry.Spec.map_comp, hα_comp i]
    have hα_nat : ∀ {i j : J} (u : i ⟶ j),
        AlgebraicGeometry.Spec.map (R_diag.map u) ≫ f_i i = f_i j := by
      intro i j u
      dsimp [f_i]
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1
      have hnat := α_diag.naturality u
      dsimp at hnat
      rw [CategoryTheory.Category.id_comp] at hnat
      exact hnat.symm
    have hι_nat : ∀ {i j : J} (u : i ⟶ j),
        ρ_i j ≫ AlgebraicGeometry.Spec.map (R_diag.map u) = ρ_i i := by
      intro i j u
      dsimp [ρ_i]
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1
      exact (ι_colim.naturality u).trans (CategoryTheory.Category.comp_id _)

    let U_i : ∀ (a : J₀) (i : J), AlgebraicGeometry.Scheme.{u} :=
      fun a i => CategoryTheory.Limits.pullback (p_O a) (f_i i)
    let fst_i : ∀ (a : J₀) (i : J), U_i a i ⟶ U_O a :=
      fun a i => CategoryTheory.Limits.pullback.fst (p_O a) (f_i i)
    let p_i : ∀ (a : J₀) (i : J), U_i a i ⟶ AlgebraicGeometry.Spec (R_diag.obj i) :=
      fun a i => CategoryTheory.Limits.pullback.snd (p_O a) (f_i i)
    have hAff_Ui : ∀ (a : J₀) (i : J), AlgebraicGeometry.IsAffine (U_i a i) :=
      fun _ _ => inferInstance
    have hLFP_pi : ∀ (a : J₀) (i : J), AlgebraicGeometry.LocallyOfFinitePresentation (p_i a i) := by
      intro a i
      have _ := hLFP_O a
      infer_instance

    let π_i : ∀ (a : J₀) (i : J), (V_cov a).toScheme ⟶ U_i a i :=
      fun a i => CategoryTheory.Limits.pullback.lift (π_O a) ((V_cov a).ι ≫ g_V ≫ ρ_i i)
        (by rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hρf i,
              ← CategoryTheory.Category.assoc, (hPb_O a).w])
    have hπ_fst : ∀ (a : J₀) (i : J), π_i a i ≫ fst_i a i = π_O a :=
      fun _ _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hPb_i : ∀ (a : J₀) (i : J),
        CategoryTheory.IsPullback (π_i a i) ((V_cov a).ι ≫ g_V) (p_i a i) (ρ_i i) := by
      intro a i
      refine CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback (p_O a) (f_i i))
      rw [hπ_fst a i, hρf i]
      exact hPb_O a

    let map_U : ∀ (a : J₀) {i j : J}, (i ⟶ j) → (U_i a j ⟶ U_i a i) :=
      fun a {i j} u => CategoryTheory.Limits.pullback.lift (fst_i a j)
        (p_i a j ≫ AlgebraicGeometry.Spec.map (R_diag.map u))
        (by rw [CategoryTheory.Category.assoc, hα_nat u, CategoryTheory.Limits.pullback.condition])
    have hmap_fst : ∀ (a : J₀) {i j : J} (u : i ⟶ j), map_U a u ≫ fst_i a i = fst_i a j :=
      fun _ {_ _} _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hmap_p : ∀ (a : J₀) {i j : J} (u : i ⟶ j),
        map_U a u ≫ p_i a i = p_i a j ≫ AlgebraicGeometry.Spec.map (R_diag.map u) :=
      fun _ {_ _} _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hmap_id : ∀ (a : J₀) (i : J), map_U a (𝟙 i) = 𝟙 (U_i a i) := by
      intro a i
      dsimp [map_U, fst_i, p_i]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Limits.pullback.lift_snd, R_diag.map_id,
          AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]
    have hmap_comp : ∀ (a : J₀) {i j k : J} (u : i ⟶ j) (v : j ⟶ k),
        map_U a (u ≫ v) = map_U a v ≫ map_U a u := by
      intro a i j k u v
      dsimp [map_U, fst_i, p_i]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
      · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
          R_diag.map_comp, AlgebraicGeometry.Spec.map_comp]
    have hπ_map : ∀ (a : J₀) {i j : J} (u : i ⟶ j),
        π_i a j ≫ map_U a u = π_i a i := by
      intro a i j u
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc (π_i a j ≫ map_U a u) ≫ fst_i a i
          _ = π_i a j ≫ (map_U a u ≫ fst_i a i) := by simp only [CategoryTheory.Category.assoc]
          _ = π_i a j ≫ fst_i a j := by rw [hmap_fst a u]
          _ = π_O a := hπ_fst a j
          _ = π_i a i ≫ fst_i a i := (hπ_fst a i).symm
      · calc (π_i a j ≫ map_U a u) ≫ p_i a i
          _ = π_i a j ≫ (map_U a u ≫ p_i a i) := by simp only [CategoryTheory.Category.assoc]
          _ = (π_i a j ≫ p_i a j) ≫ AlgebraicGeometry.Spec.map (R_diag.map u) := by
                rw [hmap_p a u, CategoryTheory.Category.assoc]
          _ = ((V_cov a).ι ≫ g_V ≫ ρ_i j) ≫ AlgebraicGeometry.Spec.map (R_diag.map u) := by
                rw [CategoryTheory.Limits.pullback.lift_snd]
          _ = (V_cov a).ι ≫ g_V ≫ (ρ_i j ≫ AlgebraicGeometry.Spec.map (R_diag.map u)) := by
                simp only [CategoryTheory.Category.assoc]
          _ = (V_cov a).ι ≫ g_V ≫ ρ_i i := by rw [hι_nat u]
          _ = π_i a i ≫ p_i a i := (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm

    let O_i : ∀ (a : J₀), J₀ → ∀ i : J, (U_i a i).Opens :=
      fun a b i => (TopologicalSpace.Opens.map (fst_i a i).base).obj (O_O a b)
    have hOi_diag : ∀ (a : J₀) (i : J), O_i a a i = ⊤ := by
      intro a i
      dsimp [O_i]
      rw [hO_diag a]
      rfl
    have hOi_aff : ∀ (a b : J₀) (i : J), AlgebraicGeometry.IsAffineOpen (O_i a b i) := by
      intro a b i
      have _ : AlgebraicGeometry.IsAffineHom (fst_i a i) := inferInstance
      exact (hO_aff a b).preimage (fst_i a i)
    have hOi_pre : ∀ (a b : J₀) (i : J),
        (TopologicalSpace.Opens.map (π_i a i).base).obj (O_i a b i) =
          (TopologicalSpace.Opens.map (V_cov a).ι.base).obj (V_cov b) := by
      intro a b i
      rw [← hO_pre a b]
      ext x
      change (fst_i a i).base ((π_i a i).base x) ∈ O_O a b ↔ (π_O a).base x ∈ O_O a b
      have hpt : (fst_i a i).base ((π_i a i).base x) = (π_O a).base x :=
        congrArg (fun φ => φ.base x) (hπ_fst a i)
      rw [hpt]

    have hRange_q : ∀ (a b : J₀) {i j : J} (u : i ⟶ j),
        Set.range ((O_i a b j).ι ≫ map_U a u).base ⊆ Set.range (O_i a b i).ι.base := by
      intro a b i j u
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      change (fst_i a i).base ((map_U a u).base ((O_i a b j).ι.base z)) ∈ O_O a b
      have hpt : (fst_i a i).base ((map_U a u).base ((O_i a b j).ι.base z)) =
          (fst_i a j).base ((O_i a b j).ι.base z) :=
        congrArg (fun φ => φ.base ((O_i a b j).ι.base z)) (hmap_fst a u)
      rw [hpt]
      exact z.2
    let q_O : ∀ (a b : J₀) {i j : J}, (i ⟶ j) → ((O_i a b j).toScheme ⟶ (O_i a b i).toScheme) :=
      fun a b {i j} u => AlgebraicGeometry.IsOpenImmersion.lift (O_i a b i).ι
        ((O_i a b j).ι ≫ map_U a u) (hRange_q a b u)
    have hq_fac : ∀ (a b : J₀) {i j : J} (u : i ⟶ j),
        q_O a b u ≫ (O_i a b i).ι = (O_i a b j).ι ≫ map_U a u :=
      fun a b {_ _} u => AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ (hRange_q a b u)
    have hq_id : ∀ (a b : J₀) (i : J), q_O a b (𝟙 i) = 𝟙 (O_i a b i).toScheme := by
      intro a b i
      apply (cancel_mono (O_i a b i).ι).mp
      rw [hq_fac a b (𝟙 i), hmap_id a i, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]
    have hq_comp : ∀ (a b : J₀) {i j k : J} (u : i ⟶ j) (v : j ⟶ k),
        q_O a b (u ≫ v) = q_O a b v ≫ q_O a b u := by
      intro a b i j k u v
      apply (cancel_mono (O_i a b i).ι).mp
      calc q_O a b (u ≫ v) ≫ (O_i a b i).ι
        _ = (O_i a b k).ι ≫ map_U a (u ≫ v) := hq_fac a b (u ≫ v)
        _ = (O_i a b k).ι ≫ map_U a v ≫ map_U a u := by rw [hmap_comp a u v]
        _ = ((O_i a b k).ι ≫ map_U a v) ≫ map_U a u := by simp only [CategoryTheory.Category.assoc]
        _ = (q_O a b v ≫ (O_i a b j).ι) ≫ map_U a u := by rw [← hq_fac a b v]
        _ = q_O a b v ≫ ((O_i a b j).ι ≫ map_U a u) := by simp only [CategoryTheory.Category.assoc]
        _ = (q_O a b v ≫ q_O a b u) ≫ (O_i a b i).ι := by
              rw [← hq_fac a b u, CategoryTheory.Category.assoc]

    let P_ab : ∀ a b : J₀, AlgebraicGeometry.Scheme.{u} :=
      fun a b => CategoryTheory.Limits.pullback (V_cov a).ι (V_cov b).ι
    have hRange_θi : ∀ (a b : J₀) (i : J),
        Set.range (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_i a i).base ⊆
          Set.range (O_i a b i).ι.base := by
      intro a b i
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      change (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι).base z ∈
        (TopologicalSpace.Opens.map (π_i a i).base).obj (O_i a b i)
      rw [hOi_pre a b i]
      change (V_cov a).ι.base ((CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι).base z) ∈
        V_cov b
      have hcond :
          (V_cov a).ι.base ((CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι).base z) =
            (V_cov b).ι.base ((CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι).base z) :=
        congrArg (fun φ => φ.base z)
          (CategoryTheory.Limits.pullback.condition (f := (V_cov a).ι) (g := (V_cov b).ι))
      rw [hcond]
      exact ((CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι).base z).2
    let θ_i : ∀ (a b : J₀) (i : J), P_ab a b ⟶ (O_i a b i).toScheme :=
      fun a b i => AlgebraicGeometry.IsOpenImmersion.lift (O_i a b i).ι
        (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_i a i)
        (hRange_θi a b i)
    have hθi_fst : ∀ (a b : J₀) (i : J),
        θ_i a b i ≫ (O_i a b i).ι =
          CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_i a i :=
      fun a b i => AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ (hRange_θi a b i)
    have hθi_q : ∀ (a b : J₀) {i j : J} (u : i ⟶ j),
        θ_i a b j ≫ q_O a b u = θ_i a b i := by
      intro a b i j u
      apply (cancel_mono (O_i a b i).ι).mp
      calc (θ_i a b j ≫ q_O a b u) ≫ (O_i a b i).ι
        _ = θ_i a b j ≫ (q_O a b u ≫ (O_i a b i).ι) := by simp only [CategoryTheory.Category.assoc]
        _ = (θ_i a b j ≫ (O_i a b j).ι) ≫ map_U a u := by
              rw [hq_fac a b u, CategoryTheory.Category.assoc]
        _ = CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ (π_i a j ≫ map_U a u) := by
              rw [hθi_fst a b j, CategoryTheory.Category.assoc]
        _ = CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_i a i := by
              rw [hπ_map a u]
        _ = θ_i a b i ≫ (O_i a b i).ι := (hθi_fst a b i).symm

    have hPb_θi : ∀ (a b : J₀) (i : J),
        CategoryTheory.IsPullback (θ_i a b i)
          (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ (V_cov a).ι ≫ g_V)
          ((O_i a b i).ι ≫ p_i a i) (ρ_i i) := by
      intro a b i
      have hTop : CategoryTheory.IsPullback (θ_i a b i)
          (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι)
          (O_i a b i).ι (π_i a i) :=
        AlgebraicGeometry.IsOpenImmersion.isPullback (θ_i a b i)
          (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι)
          (O_i a b i).ι (π_i a i)
          (hθi_fst a b i).symm
          (by
            rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι, hOi_pre a b i,
              AlgebraicGeometry.Scheme.Hom.opensRange_pullbackFst,
              AlgebraicGeometry.Scheme.Opens.opensRange_ι])
      exact hTop.paste_vert (hPb_i a i)

    let D_O : ∀ a b : J₀, Jᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u} := fun a b =>
      { obj := fun x => (O_i a b x.unop).toScheme
        map := fun f => q_O a b f.unop
        map_id := fun x => hq_id a b x.unop
        map_comp := fun f g => hq_comp a b g.unop f.unop }
    let nat_pO : ∀ a b : J₀, D_O a b ⟶ D_S := fun a b =>
      { app := fun x => (O_i a b x.unop).ι ≫ p_i a x.unop
        naturality := fun x y f => by
          dsimp [D_O, D_S]
          calc q_O a b f.unop ≫ (O_i a b y.unop).ι ≫ p_i a y.unop
            _ = (q_O a b f.unop ≫ (O_i a b y.unop).ι) ≫ p_i a y.unop := by
                  simp only [CategoryTheory.Category.assoc]
            _ = (O_i a b x.unop).ι ≫ (map_U a f.unop ≫ p_i a y.unop) := by
                  rw [hq_fac a b f.unop, CategoryTheory.Category.assoc]
            _ = ((O_i a b x.unop).ι ≫ p_i a x.unop) ≫ AlgebraicGeometry.Spec.map (R_diag.map f.unop) := by
                  rw [hmap_p a f.unop, CategoryTheory.Category.assoc] }
    let c_O : ∀ a b : J₀, CategoryTheory.Limits.Cone (D_O a b) := fun a b =>
      { pt := P_ab a b
        π :=
          { app := fun x => θ_i a b x.unop
            naturality := fun x y f => by
              dsimp [D_O]
              rw [CategoryTheory.Category.id_comp]
              exact (hθi_q a b f.unop).symm } }
    let cone_hom_O : ∀ a b : J₀,
        (CategoryTheory.Limits.Cone.postcompose (nat_pO a b)).obj (c_O a b) ⟶ c_S := fun a b =>
      { hom := CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ (V_cov a).ι ≫ g_V
        w := fun x => (hPb_θi a b x.unop).w.symm }
    have hc_O : ∀ a b : J₀, CategoryTheory.Limits.IsLimit (c_O a b) := fun a b =>
      CategoryTheory.Limits.isLimitOfIsPullbackOfIsConnected
        (nat_pO a b) (c_O a b) c_S (cone_hom_O a b) (fun x => hPb_θi a b x.unop) hc_S

    let F_Γ : ∀ a b : J₀, J ⥤ CommRingCat.{u} := fun a b =>
      { obj := fun i => (O_i a b i).toScheme.presheaf.obj (Opposite.op ⊤)
        map := fun u => (q_O a b u).appTop
        map_id := fun i => by rw [hq_id a b i, AlgebraicGeometry.Scheme.Hom.id_appTop]
        map_comp := fun u v => by rw [hq_comp a b u v, AlgebraicGeometry.Scheme.Hom.comp_appTop] }
    let c_Γ : ∀ a b : J₀, CategoryTheory.Limits.Cocone (F_Γ a b) := fun a b =>
      { pt := (P_ab a b).presheaf.obj (Opposite.op ⊤)
        ι :=
          { app := fun i => (θ_i a b i).appTop
            naturality := fun i j u => by
              dsimp [F_Γ]
              rw [CategoryTheory.Category.comp_id, ← AlgebraicGeometry.Scheme.Hom.comp_appTop,
                hθi_q a b u] } }
    have hc_Γ : ∀ a b : J₀, CategoryTheory.Limits.IsColimit (c_Γ a b) := by
      intro a b
      have _ : ∀ x : Jᵒᵖ, AlgebraicGeometry.IsAffine ((D_O a b).obj x) :=
        fun x => hOi_aff a b x.unop
      have _ : ∀ {x y : Jᵒᵖ} (f : x ⟶ y), AlgebraicGeometry.IsAffineHom ((D_O a b).map f) :=
        fun _ => inferInstance
      have hc_type : CategoryTheory.Limits.IsColimit
          ((CategoryTheory.forget CommRingCat.{u}).mapCocone (c_Γ a b)) := by
        refine CategoryTheory.Limits.Types.FilteredColimit.isColimitOf' _ _ ?_ ?_
        · intro s
          obtain ⟨x_i, t, ht⟩ :=
            AlgebraicGeometry.exists_appTop_π_eq_of_isAffine_of_isLimit
              (D_O a b) (c_O a b) (hc_O a b) s
          exact ⟨x_i.unop, t, ht.symm⟩
        · intro i s₁ s₂ hs
          have hCompTop : IsCompact
              ((⊤ : ((D_O a b).obj (Opposite.op i)).Opens) : Set ↥((D_O a b).obj (Opposite.op i))) :=
            isCompact_univ
          obtain ⟨x_k, f_ki, hf_eq⟩ :=
            AlgebraicGeometry.exists_app_map_eq_map_of_isLimit
              (D_O a b) (c_O a b) (hc_O a b) hCompTop s₁ s₂ hs
          exact ⟨x_k.unop, f_ki.unop, hf_eq⟩
      let c_std := CommRingCat.FilteredColimits.colimitCocone (F_Γ a b)
      have hc_std : CategoryTheory.Limits.IsColimit c_std :=
        CommRingCat.FilteredColimits.colimitCoconeIsColimit (F_Γ a b)
      have hc_std_type : CategoryTheory.Limits.IsColimit
          ((CategoryTheory.forget CommRingCat.{u}).mapCocone c_std) :=
        CategoryTheory.Limits.isColimitOfPreserves (CategoryTheory.forget CommRingCat.{u}) hc_std
      let φ_colim : c_std.pt ⟶ (c_Γ a b).pt := hc_std.desc (c_Γ a b)
      have hφ_type : (CategoryTheory.forget CommRingCat.{u}).map φ_colim =
          hc_std_type.desc ((CategoryTheory.forget CommRingCat.{u}).mapCocone (c_Γ a b)) := by
        apply hc_std_type.uniq ((CategoryTheory.forget CommRingCat.{u}).mapCocone (c_Γ a b))
        intro i
        change (CategoryTheory.forget CommRingCat.{u}).map (c_std.ι.app i ≫ φ_colim) = _
        rw [hc_std.fac (c_Γ a b) i]
        rfl
      have hIso_type : CategoryTheory.IsIso ((CategoryTheory.forget CommRingCat.{u}).map φ_colim) := by
        rw [hφ_type]
        change CategoryTheory.IsIso
          (CategoryTheory.Limits.IsColimit.coconePointUniqueUpToIso hc_std_type hc_type).hom
        infer_instance
      have _ : CategoryTheory.IsIso φ_colim :=
        CategoryTheory.isIso_of_reflects_iso φ_colim (CategoryTheory.forget CommRingCat.{u})
      exact CategoryTheory.Limits.IsColimit.ofIsoColimit hc_std
        (CategoryTheory.Limits.Cocone.ext (CategoryTheory.asIso φ_colim)
          (fun i => hc_std.fac (c_Γ a b) i))

    have hΓSpec_inv : ∀ {R S : CommRingCat.{u}} (φ : R ⟶ S),
        φ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso S).inv =
          (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫ (AlgebraicGeometry.Spec.map φ).appTop := by
      intro R S φ
      apply (cancel_mono (AlgebraicGeometry.Scheme.ΓSpecIso S).hom).mp
      calc (φ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso S).inv) ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso S).hom
        _ = φ ≫ ((AlgebraicGeometry.Scheme.ΓSpecIso S).inv ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso S).hom) := by
              simp only [CategoryTheory.Category.assoc]
        _ = φ := by rw [CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.comp_id]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫
              ((AlgebraicGeometry.Scheme.ΓSpecIso R).hom ≫ φ) := by
              rw [← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
                CategoryTheory.Category.id_comp]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫
              ((AlgebraicGeometry.Spec.map φ).appTop ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso S).hom) := by
              rw [AlgebraicGeometry.Scheme.ΓSpecIso_naturality φ]
        _ = ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫
              (AlgebraicGeometry.Spec.map φ).appTop) ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso S).hom := by
              simp only [CategoryTheory.Category.assoc]

    let γ_hom : ∀ {W : AlgebraicGeometry.Scheme.{u}} {R : CommRingCat.{u}},
        (W ⟶ AlgebraicGeometry.Spec R) → (R ⟶ W.presheaf.obj (Opposite.op ⊤)) :=
      fun {_ R} k => (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫ k.appTop

    have hγ_comm : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} {R₁ R₂ : CommRingCat.{u}}
        (h : W₁ ⟶ W₂) (k₂ : W₂ ⟶ AlgebraicGeometry.Spec R₂)
        (k₁ : W₁ ⟶ AlgebraicGeometry.Spec R₁) (φ : R₂ ⟶ R₁),
        h ≫ k₂ = k₁ ≫ AlgebraicGeometry.Spec.map φ →
        γ_hom k₂ ≫ h.appTop = φ ≫ γ_hom k₁ := by
      intro W₁ W₂ R₁ R₂ h k₂ k₁ φ hcomm
      dsimp [γ_hom]
      calc ((AlgebraicGeometry.Scheme.ΓSpecIso R₂).inv ≫ k₂.appTop) ≫ h.appTop
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso R₂).inv ≫ (k₂.appTop ≫ h.appTop) := by
              simp only [CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso R₂).inv ≫ (h ≫ k₂).appTop := by
              rw [AlgebraicGeometry.Scheme.Hom.comp_appTop]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso R₂).inv ≫
              (k₁ ≫ AlgebraicGeometry.Spec.map φ).appTop := by
              rw [hcomm]
        _ = ((AlgebraicGeometry.Scheme.ΓSpecIso R₂).inv ≫
              (AlgebraicGeometry.Spec.map φ).appTop) ≫ k₁.appTop := by
              rw [AlgebraicGeometry.Scheme.Hom.comp_appTop]
              simp only [CategoryTheory.Category.assoc]
        _ = (φ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R₁).inv) ≫ k₁.appTop := by
              rw [hΓSpec_inv φ]
        _ = φ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R₁).inv ≫ k₁.appTop := by
              simp only [CategoryTheory.Category.assoc]

    have htoSpecΓ_eq : ∀ {W : AlgebraicGeometry.Scheme.{u}} {R : CommRingCat.{u}}
        (k : W ⟶ AlgebraicGeometry.Spec R),
        W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (γ_hom k) = k := by
      intro W R k
      dsimp [γ_hom]
      rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Scheme.toSpecΓ_naturality k, CategoryTheory.Category.assoc,
        AlgebraicGeometry.toSpecΓ_SpecMap_ΓSpecIso_inv, CategoryTheory.Category.comp_id]

    have _ : ∀ a b : J₀, AlgebraicGeometry.IsAffine (O_O a b).toScheme := hO_aff
    let f_ba : ∀ a b : J₀, R_O ⟶ (O_O b a).toScheme.presheaf.obj (Opposite.op ⊤) :=
      fun a b => γ_hom ((O_O b a).ι ≫ p_O b)
    have hFP_fba : ∀ a b : J₀, (CommRingCat.Hom.hom (f_ba a b)).FinitePresentation := by
      intro a b
      have _ := hLFP_O b
      have hSpec_fba : AlgebraicGeometry.Spec.map (f_ba a b) =
          (O_O b a).toScheme.isoSpec.inv ≫ (O_O b a).ι ≫ p_O b := by
        calc AlgebraicGeometry.Spec.map (f_ba a b)
          _ = ((O_O b a).toScheme.isoSpec.inv ≫ (O_O b a).toScheme.toSpecΓ) ≫
                AlgebraicGeometry.Spec.map (f_ba a b) := by
                rw [← AlgebraicGeometry.Scheme.isoSpec_hom, CategoryTheory.Iso.inv_hom_id,
                  CategoryTheory.Category.id_comp]
          _ = (O_O b a).toScheme.isoSpec.inv ≫
                ((O_O b a).toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map (f_ba a b)) := by
                simp only [CategoryTheory.Category.assoc]
          _ = (O_O b a).toScheme.isoSpec.inv ≫ (O_O b a).ι ≫ p_O b := by
                rw [htoSpecΓ_eq ((O_O b a).ι ≫ p_O b)]
      have hLFP_map : AlgebraicGeometry.LocallyOfFinitePresentation
          (AlgebraicGeometry.Spec.map (f_ba a b)) := by
        rw [hSpec_fba]
        infer_instance
      exact AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hLFP_map

    let α_Γ : ∀ a b : J₀, (CategoryTheory.Functor.const J).obj R_O ⟶ F_Γ a b := fun a b =>
      { app := fun i => α_diag.app i ≫ γ_hom ((O_i a b i).ι ≫ p_i a i)
        naturality := fun i j u => by
          change α_diag.app j ≫ γ_hom ((O_i a b j).ι ≫ p_i a j) =
            (α_diag.app i ≫ γ_hom ((O_i a b i).ι ≫ p_i a i)) ≫ (q_O a b u).appTop
          have hq_over : q_O a b u ≫ ((O_i a b i).ι ≫ p_i a i) =
              ((O_i a b j).ι ≫ p_i a j) ≫ AlgebraicGeometry.Spec.map (R_diag.map u) := by
            calc q_O a b u ≫ (O_i a b i).ι ≫ p_i a i
              _ = (q_O a b u ≫ (O_i a b i).ι) ≫ p_i a i := by
                    simp only [CategoryTheory.Category.assoc]
              _ = (O_i a b j).ι ≫ (map_U a u ≫ p_i a i) := by
                    rw [hq_fac a b u, CategoryTheory.Category.assoc]
              _ = ((O_i a b j).ι ≫ p_i a j) ≫ AlgebraicGeometry.Spec.map (R_diag.map u) := by
                    rw [hmap_p a u, CategoryTheory.Category.assoc]
          have hnat : α_diag.app j = α_diag.app i ≫ R_diag.map u := by
            have h := α_diag.naturality u
            dsimp at h
            rw [CategoryTheory.Category.id_comp] at h
            exact h
          calc α_diag.app j ≫ γ_hom ((O_i a b j).ι ≫ p_i a j)
            _ = (α_diag.app i ≫ R_diag.map u) ≫ γ_hom ((O_i a b j).ι ≫ p_i a j) := by rw [hnat]
            _ = α_diag.app i ≫ (R_diag.map u ≫ γ_hom ((O_i a b j).ι ≫ p_i a j)) := by
                  simp only [CategoryTheory.Category.assoc]
            _ = α_diag.app i ≫ (γ_hom ((O_i a b i).ι ≫ p_i a i) ≫ (q_O a b u).appTop) := by
                  rw [← hγ_comm (q_O a b u) ((O_i a b i).ι ≫ p_i a i)
                    ((O_i a b j).ι ≫ p_i a j) (R_diag.map u) hq_over]
            _ = (α_diag.app i ≫ γ_hom ((O_i a b i).ι ≫ p_i a i)) ≫ (q_O a b u).appTop := by
                  simp only [CategoryTheory.Category.assoc] }

    let swap_ab : ∀ a b : J₀, P_ab a b ⟶ P_ab b a :=
      fun a b => CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι)
        (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι)
        CategoryTheory.Limits.pullback.condition.symm
    let ψ_ab : ∀ a b : J₀, P_ab a b ⟶ (O_O b a).toScheme :=
      fun a b => swap_ab a b ≫ θ_O b a
    have hψ_fst : ∀ a b : J₀, ψ_ab a b ≫ (O_O b a).ι =
        CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π_O b := by
      intro a b
      dsimp [ψ_ab, swap_ab]
      rw [CategoryTheory.Category.assoc, hθ_fst b a, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst]
    have hψ_over : ∀ (a b : J₀) (i : J),
        ψ_ab a b ≫ ((O_O b a).ι ≫ p_O b) =
          (θ_i a b i ≫ (O_i a b i).ι ≫ p_i a i) ≫ f_i i := by
      intro a b i
      calc ψ_ab a b ≫ ((O_O b a).ι ≫ p_O b)
        _ = (ψ_ab a b ≫ (O_O b a).ι) ≫ p_O b := by simp only [CategoryTheory.Category.assoc]
        _ = CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ (π_O b ≫ p_O b) := by
              rw [hψ_fst a b, CategoryTheory.Category.assoc]
        _ = (CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ (V_cov b).ι) ≫
              g_V ≫ AlgebraicGeometry.Spec.map β_O := by
              rw [(hPb_O b).w]; simp only [CategoryTheory.Category.assoc]
        _ = (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ (V_cov a).ι) ≫
              g_V ≫ (ρ_i i ≫ f_i i) := by
              rw [CategoryTheory.Limits.pullback.condition, hρf i]
        _ = CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫
              (((V_cov a).ι ≫ g_V) ≫ ρ_i i) ≫ f_i i := by
              simp only [CategoryTheory.Category.assoc]
        _ = CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫
              (π_i a i ≫ p_i a i) ≫ f_i i := by
              rw [← (hPb_i a i).w]
        _ = (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_i a i) ≫
              p_i a i ≫ f_i i := by
              simp only [CategoryTheory.Category.assoc]
        _ = (θ_i a b i ≫ (O_i a b i).ι ≫ p_i a i) ≫ f_i i := by
              rw [← hθi_fst a b i]; simp only [CategoryTheory.Category.assoc]

    have hψ_Γ_comm : ∀ (a b : J₀) (i : J),
        f_ba a b ≫ (ψ_ab a b).appTop = (α_Γ a b).app i ≫ (c_Γ a b).ι.app i := by
      intro a b i
      change γ_hom ((O_O b a).ι ≫ p_O b) ≫ (ψ_ab a b).appTop =
        (α_diag.app i ≫ γ_hom ((O_i a b i).ι ≫ p_i a i)) ≫ (θ_i a b i).appTop
      rw [hγ_comm (ψ_ab a b) ((O_O b a).ι ≫ p_O b)
        (θ_i a b i ≫ (O_i a b i).ι ≫ p_i a i) (α_diag.app i) (hψ_over a b i)]
      have hγ_comp : γ_hom (θ_i a b i ≫ (O_i a b i).ι ≫ p_i a i) =
          γ_hom ((O_i a b i).ι ≫ p_i a i) ≫ (θ_i a b i).appTop := by
        change (AlgebraicGeometry.Scheme.ΓSpecIso (R_diag.obj i)).inv ≫
            (θ_i a b i ≫ ((O_i a b i).ι ≫ p_i a i)).appTop =
          ((AlgebraicGeometry.Scheme.ΓSpecIso (R_diag.obj i)).inv ≫
            ((O_i a b i).ι ≫ p_i a i).appTop) ≫ (θ_i a b i).appTop
        rw [AlgebraicGeometry.Scheme.Hom.comp_appTop]
        exact (CategoryTheory.Category.assoc _ _ _).symm
      rw [hγ_comp]
      exact (CategoryTheory.Category.assoc _ _ _).symm

    let OffDiag : Type u := {p : J₀ × J₀ // p.1 ≠ p.2}
    have _ : Finite OffDiag := inferInstance
    have hLiftHom : ∀ q : OffDiag,
        ∃ (j : J) (g' : (O_O q.1.2 q.1.1).toScheme.presheaf.obj (Opposite.op ⊤) ⟶
            (F_Γ q.1.1 q.1.2).obj j),
          f_ba q.1.1 q.1.2 ≫ g' = (α_Γ q.1.1 q.1.2).app j ∧
          (ψ_ab q.1.1 q.1.2).appTop = g' ≫ (c_Γ q.1.1 q.1.2).ι.app j := by
      intro q
      exact RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
        R_O (F_Γ q.1.1 q.1.2) (α_Γ q.1.1 q.1.2) (f_ba q.1.1 q.1.2)
        (c_Γ q.1.1 q.1.2) (hc_Γ q.1.1 q.1.2) (hFP_fba q.1.1 q.1.2)
        (ψ_ab q.1.1 q.1.2).appTop (hψ_Γ_comm q.1.1 q.1.2)
    choose j_q g'_q hg'_over hg'_fac using hLiftHom

    obtain ⟨i_root⟩ := CategoryTheory.IsFiltered.nonempty (C := J)
    let j'_q : OffDiag → J := fun q => CategoryTheory.IsFiltered.max i_root (j_q q)
    let f_q : ∀ q : OffDiag, i_root ⟶ j'_q q :=
      fun q => CategoryTheory.IsFiltered.leftToMax i_root (j_q q)
    obtain ⟨i₁, _, w_q, _⟩ := CategoryTheory.IsFiltered.wideSpan f_q
    let u_q : ∀ q : OffDiag, j_q q ⟶ i₁ :=
      fun q => CategoryTheory.IsFiltered.rightToMax i_root (j_q q) ≫ w_q q

    let g₁_q : ∀ q : OffDiag,
        (O_O q.1.2 q.1.1).toScheme.presheaf.obj (Opposite.op ⊤) ⟶ (F_Γ q.1.1 q.1.2).obj i₁ :=
      fun q => g'_q q ≫ (F_Γ q.1.1 q.1.2).map (u_q q)
    have hg₁_over : ∀ q : OffDiag, f_ba q.1.1 q.1.2 ≫ g₁_q q = (α_Γ q.1.1 q.1.2).app i₁ := by
      intro q
      dsimp [g₁_q]
      rw [← CategoryTheory.Category.assoc, hg'_over q]
      have hnat := (α_Γ q.1.1 q.1.2).naturality (u_q q)
      dsimp at hnat
      rw [CategoryTheory.Category.id_comp] at hnat
      exact hnat.symm
    have hg₁_fac : ∀ q : OffDiag,
        (ψ_ab q.1.1 q.1.2).appTop = g₁_q q ≫ (θ_i q.1.1 q.1.2 i₁).appTop := by
      intro q
      dsimp [g₁_q]
      rw [CategoryTheory.Category.assoc]
      have hnat : (F_Γ q.1.1 q.1.2).map (u_q q) ≫ (θ_i q.1.1 q.1.2 i₁).appTop =
          (c_Γ q.1.1 q.1.2).ι.app (j_q q) :=
        (c_Γ q.1.1 q.1.2).w (u_q q)
      rw [hnat, ← hg'_fac q]

    let t_tilde : ∀ q : OffDiag,
        (O_i q.1.1 q.1.2 i₁).toScheme ⟶ (O_O q.1.2 q.1.1).toScheme :=
      fun q =>
        (O_i q.1.1 q.1.2 i₁).toScheme.toSpecΓ ≫
          AlgebraicGeometry.Spec.map (g₁_q q) ≫
          (O_O q.1.2 q.1.1).toScheme.isoSpec.inv

    have ht_tilde_over : ∀ q : OffDiag,
        (t_tilde q ≫ (O_O q.1.2 q.1.1).ι) ≫ p_O q.1.2 =
          ((O_i q.1.1 q.1.2 i₁).ι ≫ p_i q.1.1 i₁) ≫ f_i i₁ := by
      intro q
      let a := q.1.1
      let b := q.1.2
      let Y := (O_O b a).toScheme
      let Z := (O_i a b i₁).toScheme
      have hY_iso : Y.isoSpec.inv ≫ Y.toSpecΓ = 𝟙 _ := by
        rw [← AlgebraicGeometry.Scheme.isoSpec_hom, CategoryTheory.Iso.inv_hom_id]
      calc (t_tilde q ≫ (O_O b a).ι) ≫ p_O b
        _ = (Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map (g₁_q q) ≫ Y.isoSpec.inv) ≫
              ((O_O b a).ι ≫ p_O b) := by
              dsimp [t_tilde, Y, Z, a, b]
              simp only [CategoryTheory.Category.assoc]
        _ = (Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map (g₁_q q) ≫ Y.isoSpec.inv) ≫
              (Y.toSpecΓ ≫ AlgebraicGeometry.Spec.map (f_ba a b)) := by
              conv_lhs => rw [← htoSpecΓ_eq ((O_O b a).ι ≫ p_O b)]
        _ = Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map (g₁_q q) ≫
              (Y.isoSpec.inv ≫ Y.toSpecΓ) ≫ AlgebraicGeometry.Spec.map (f_ba a b) := by
              simp only [CategoryTheory.Category.assoc]
        _ = Z.toSpecΓ ≫ (AlgebraicGeometry.Spec.map (g₁_q q) ≫
              AlgebraicGeometry.Spec.map (f_ba a b)) := by
              rw [hY_iso, CategoryTheory.Category.id_comp]
        _ = Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map (f_ba a b ≫ g₁_q q) := by
              rw [← AlgebraicGeometry.Spec.map_comp]
        _ = Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map ((α_Γ a b).app i₁) := by
              rw [hg₁_over q]
        _ = (Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map (γ_hom ((O_i a b i₁).ι ≫ p_i a i₁))) ≫
              f_i i₁ := by
              dsimp [α_Γ, f_i]
              rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = ((O_i a b i₁).ι ≫ p_i a i₁) ≫ f_i i₁ := by
              rw [htoSpecΓ_eq ((O_i a b i₁).ι ≫ p_i a i₁)]

    have ht_tilde_θ : ∀ q : OffDiag,
        θ_i q.1.1 q.1.2 i₁ ≫ t_tilde q = ψ_ab q.1.1 q.1.2 := by
      intro q
      let a := q.1.1
      let b := q.1.2
      let Y := (O_O b a).toScheme
      let Z := (O_i a b i₁).toScheme
      have hY_iso' : Y.toSpecΓ ≫ Y.isoSpec.inv = 𝟙 _ := by
        rw [← AlgebraicGeometry.Scheme.isoSpec_hom, CategoryTheory.Iso.hom_inv_id]
      calc θ_i a b i₁ ≫ (Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map (g₁_q q) ≫ Y.isoSpec.inv)
        _ = (θ_i a b i₁ ≫ Z.toSpecΓ) ≫ AlgebraicGeometry.Spec.map (g₁_q q) ≫ Y.isoSpec.inv := by
              simp only [CategoryTheory.Category.assoc]
        _ = (P_ab a b).toSpecΓ ≫
              (AlgebraicGeometry.Spec.map (θ_i a b i₁).appTop ≫
                AlgebraicGeometry.Spec.map (g₁_q q)) ≫ Y.isoSpec.inv := by
              rw [AlgebraicGeometry.Scheme.toSpecΓ_naturality (θ_i a b i₁)]
              simp only [CategoryTheory.Category.assoc]
        _ = (P_ab a b).toSpecΓ ≫ AlgebraicGeometry.Spec.map (ψ_ab a b).appTop ≫ Y.isoSpec.inv := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← hg₁_fac q]
        _ = ((P_ab a b).toSpecΓ ≫ AlgebraicGeometry.Spec.map (ψ_ab a b).appTop) ≫ Y.isoSpec.inv := by
              simp only [CategoryTheory.Category.assoc]
        _ = ψ_ab a b ≫ (Y.toSpecΓ ≫ Y.isoSpec.inv) := by
              rw [← AlgebraicGeometry.Scheme.toSpecΓ_naturality (ψ_ab a b),
                CategoryTheory.Category.assoc]
        _ = ψ_ab a b := by
              rw [hY_iso', CategoryTheory.Category.comp_id]

    let m_q : ∀ q : OffDiag, (O_i q.1.1 q.1.2 i₁).toScheme ⟶ U_i q.1.2 i₁ :=
      fun q => CategoryTheory.Limits.pullback.lift
        (t_tilde q ≫ (O_O q.1.2 q.1.1).ι)
        ((O_i q.1.1 q.1.2 i₁).ι ≫ p_i q.1.1 i₁)
        (ht_tilde_over q)
    have hRange_m : ∀ q : OffDiag,
        Set.range (m_q q).base ⊆ Set.range (O_i q.1.2 q.1.1 i₁).ι.base := by
      intro q
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      change (fst_i q.1.2 i₁).base ((m_q q).base z) ∈ O_O q.1.2 q.1.1
      have hpt : (fst_i q.1.2 i₁).base ((m_q q).base z) =
          (O_O q.1.2 q.1.1).ι.base ((t_tilde q).base z) :=
        congrArg (fun φ => φ.base z)
          (CategoryTheory.Limits.pullback.lift_fst (t_tilde q ≫ (O_O q.1.2 q.1.1).ι)
            ((O_i q.1.1 q.1.2 i₁).ι ≫ p_i q.1.1 i₁) (ht_tilde_over q))
      rw [hpt]
      exact ((t_tilde q).base z).2

    let t₁ : ∀ a b : J₀, (O_i a b i₁).toScheme ⟶ (O_i b a i₁).toScheme :=
      fun a b =>
        if h : a = b then eqToHom (by rw [h])
        else AlgebraicGeometry.IsOpenImmersion.lift (O_i b a i₁).ι
          (m_q ⟨(a, b), h⟩) (hRange_m ⟨(a, b), h⟩)

    have ht₁_id : ∀ a : J₀, t₁ a a = 𝟙 _ := fun a => by simp [t₁]
    have ht₁_over : ∀ a b : J₀,
        t₁ a b ≫ (O_i b a i₁).ι ≫ p_i b i₁ = (O_i a b i₁).ι ≫ p_i a i₁ := by
      intro a b
      by_cases h : a = b
      · subst h
        rw [ht₁_id a, CategoryTheory.Category.id_comp]
      · simp only [t₁, h, ↓reduceDIte]
        rw [← CategoryTheory.Category.assoc,
          AlgebraicGeometry.IsOpenImmersion.lift_fac (O_i b a i₁).ι
            (m_q ⟨(a, b), h⟩) (hRange_m ⟨(a, b), h⟩)]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _

    have ht₁_snd : ∀ a b : J₀,
        θ_i a b i₁ ≫ t₁ a b ≫ (O_i b a i₁).ι =
          CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π_i b i₁ := by
      intro a b
      by_cases h : a = b
      · subst h
        rw [ht₁_id a, CategoryTheory.Category.id_comp, hθi_fst a a i₁]
        have hfst_snd :
            CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov a).ι =
              CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov a).ι :=
          (cancel_mono (V_cov a).ι).mp CategoryTheory.Limits.pullback.condition
        rw [hfst_snd]
      · simp only [t₁, h, ↓reduceDIte]
        have hfac_m : AlgebraicGeometry.IsOpenImmersion.lift (O_i b a i₁).ι
            (m_q ⟨(a, b), h⟩) (hRange_m ⟨(a, b), h⟩) ≫ (O_i b a i₁).ι = m_q ⟨(a, b), h⟩ :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac (O_i b a i₁).ι
            (m_q ⟨(a, b), h⟩) (hRange_m ⟨(a, b), h⟩)
        rw [hfac_m]
        have hm_fst : m_q ⟨(a, b), h⟩ ≫ fst_i b i₁ = t_tilde ⟨(a, b), h⟩ ≫ (O_O b a).ι :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hm_snd : m_q ⟨(a, b), h⟩ ≫ p_i b i₁ = (O_i a b i₁).ι ≫ p_i a i₁ :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        apply CategoryTheory.Limits.pullback.hom_ext
        · calc (θ_i a b i₁ ≫ m_q ⟨(a, b), h⟩) ≫ fst_i b i₁
            _ = θ_i a b i₁ ≫ (m_q ⟨(a, b), h⟩ ≫ fst_i b i₁) :=
                  CategoryTheory.Category.assoc _ _ _
            _ = θ_i a b i₁ ≫ (t_tilde ⟨(a, b), h⟩ ≫ (O_O b a).ι) := by
                  rw [hm_fst]
            _ = (θ_i a b i₁ ≫ t_tilde ⟨(a, b), h⟩) ≫ (O_O b a).ι :=
                  (CategoryTheory.Category.assoc _ _ _).symm
            _ = ψ_ab a b ≫ (O_O b a).ι := by
                  rw [ht_tilde_θ ⟨(a, b), h⟩]
            _ = CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π_O b := hψ_fst a b
            _ = CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫
                  (π_i b i₁ ≫ fst_i b i₁) := by
                  rw [hπ_fst b i₁]
            _ = (CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π_i b i₁) ≫
                  fst_i b i₁ :=
                  (CategoryTheory.Category.assoc _ _ _).symm
        · calc (θ_i a b i₁ ≫ m_q ⟨(a, b), h⟩) ≫ p_i b i₁
            _ = θ_i a b i₁ ≫ (m_q ⟨(a, b), h⟩ ≫ p_i b i₁) :=
                  CategoryTheory.Category.assoc _ _ _
            _ = θ_i a b i₁ ≫ ((O_i a b i₁).ι ≫ p_i a i₁) := by
                  rw [hm_snd]
            _ = (θ_i a b i₁ ≫ (O_i a b i₁).ι) ≫ p_i a i₁ :=
                  (CategoryTheory.Category.assoc _ _ _).symm
            _ = CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫
                  (π_i a i₁ ≫ p_i a i₁) := by
                  rw [hθi_fst a b i₁, CategoryTheory.Category.assoc]
            _ = (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ (V_cov a).ι) ≫
                  g_V ≫ ρ_i i₁ := by
                  rw [(hPb_i a i₁).w]; simp only [CategoryTheory.Category.assoc]
            _ = (CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ (V_cov b).ι) ≫
                  g_V ≫ ρ_i i₁ := by
                  rw [CategoryTheory.Limits.pullback.condition]
            _ = CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫
                  (((V_cov b).ι ≫ g_V) ≫ ρ_i i₁) := by
                  simp only [CategoryTheory.Category.assoc]
            _ = CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫
                  (π_i b i₁ ≫ p_i b i₁) := by
                  rw [← (hPb_i b i₁).w]
            _ = (CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π_i b i₁) ≫
                  p_i b i₁ := by
                  simp only [CategoryTheory.Category.assoc]

    refine ⟨i₁, fun a => U_i a i₁, fun a => hAff_Ui a i₁, fun a => p_i a i₁,
      fun a => π_i a i₁, fun a b => O_i a b i₁, t₁, fun a b => θ_i a b i₁,
      fun a => hLFP_pi a i₁, fun a => hPb_i a i₁, fun a b => hOi_aff a b i₁,
      fun a => hOi_diag a i₁, fun a b => hOi_pre a b i₁, ht₁_id, ht₁_over,
      fun a b => hθi_fst a b i₁, ht₁_snd⟩

  obtain ⟨hc_V⟩ := hColim
  let c_V : CategoryTheory.Limits.Cocone R_diag :=
    CategoryTheory.Limits.Cocone.mk R_V ι_colim
  have _ : CompactSpace ↥(AlgebraicGeometry.Spec R_V) :=
    AlgebraicGeometry.Scheme.compactSpace_of_isAffine _
  have _ : CompactSpace ↥C_V :=
    @AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace _ _ g_V hQCV _
  let 𝒰 := C_V.affineCover.finiteSubcover
  let J₀ : Type u := 𝒰.I₀
  have instFinJ₀ : Finite J₀ := inferInstance
  let V_cov : J₀ → C_V.Opens := fun a => (𝒰.f a).opensRange
  have hCov : TopologicalSpace.IsOpenCover V_cov :=
    TopologicalSpace.IsOpenCover.mk 𝒰.iSup_opensRange
  have hAffV : ∀ a : J₀, AlgebraicGeometry.IsAffineOpen (V_cov a) :=
    fun a => AlgebraicGeometry.isAffineOpen_opensRange (𝒰.f a)
  let B_V : J₀ → CommRingCat.{u} :=
    fun a => C_V.presheaf.obj (Opposite.op (V_cov a))
  let e_V : ∀ a : J₀, (V_cov a).toScheme ≅ AlgebraicGeometry.Spec (B_V a) :=
    fun a => (hAffV a).isoSpec
  let φ_V : ∀ a : J₀, R_V ⟶ B_V a :=
    fun a => AlgebraicGeometry.Spec.preimage ((e_V a).inv ≫ (V_cov a).ι ≫ g_V)
  have hSpec_φV : ∀ a : J₀,
      AlgebraicGeometry.Spec.map (φ_V a) = (e_V a).inv ≫ (V_cov a).ι ≫ g_V :=
    fun a => AlgebraicGeometry.Spec.map_preimage _
  have he_φV : ∀ a : J₀,
      (e_V a).hom ≫ AlgebraicGeometry.Spec.map (φ_V a) = (V_cov a).ι ≫ g_V := by
    intro a
    rw [hSpec_φV a, ← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
      CategoryTheory.Category.id_comp]
  have hFP_V : ∀ a : J₀, (CommRingCat.Hom.hom (φ_V a)).FinitePresentation := by
    intro a
    have hLFP_map : AlgebraicGeometry.LocallyOfFinitePresentation
        (AlgebraicGeometry.Spec.map (φ_V a)) := by
      rw [hSpec_φV a]
      infer_instance
    exact AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hLFP_map

  obtain ⟨i₀, B₀, φ₀, ψ₀, hFP₀, hPush₀⟩ :=
    hStep2 J R_diag R_V ι_colim ⟨hc_V⟩ J₀ B_V φ_V hFP_V

  let U₀ : J₀ → AlgebraicGeometry.Scheme.{u} := fun a => AlgebraicGeometry.Spec (B₀ a)
  have _ : ∀ a : J₀, AlgebraicGeometry.IsAffine (U₀ a) := fun _ => inferInstance
  let p₀ : ∀ a : J₀, U₀ a ⟶ AlgebraicGeometry.Spec (R_diag.obj i₀) :=
    fun a => AlgebraicGeometry.Spec.map (φ₀ a)
  have hLFP₀ : ∀ a : J₀, AlgebraicGeometry.LocallyOfFinitePresentation (p₀ a) :=
    fun a => AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr (hFP₀ a)
  let π₀ : ∀ a : J₀, (V_cov a).toScheme ⟶ U₀ a :=
    fun a => (e_V a).hom ≫ AlgebraicGeometry.Spec.map (ψ₀ a)
  have hPb₀ : ∀ a : J₀, CategoryTheory.IsPullback (π₀ a) ((V_cov a).ι ≫ g_V) (p₀ a)
      (AlgebraicGeometry.Spec.map (ι_colim.app i₀)) := by
    intro a
    let _ := AlgebraicGeometry.ΓSpec.adjunction.isRightAdjoint
    have hPb_spec : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (ψ₀ a))
        (AlgebraicGeometry.Spec.map (φ_V a))
        (p₀ a)
        (AlgebraicGeometry.Spec.map (ι_colim.app i₀)) :=
      AlgebraicGeometry.Scheme.Spec.map_isPullback (hPush₀ a).op
    have hPb_iso : CategoryTheory.IsPullback
        (e_V a).hom ((V_cov a).ι ≫ g_V)
        (AlgebraicGeometry.Spec.map (φ_V a))
        (𝟙 (AlgebraicGeometry.Spec R_V)) :=
      CategoryTheory.IsPullback.of_horiz_isIso
        ⟨by rw [CategoryTheory.Category.comp_id, he_φV a]⟩
    simpa only [π₀, CategoryTheory.Category.id_comp] using hPb_iso.paste_horiz hPb_spec

  let J_A := CategoryTheory.Under i₀
  let R_diag_A : J_A ⥤ CommRingCat.{u} := CategoryTheory.Under.forget i₀ ⋙ R_diag
  let α_diag_A : (CategoryTheory.Functor.const J_A).obj (R_diag.obj i₀) ⟶ R_diag_A :=
    { app := fun u => R_diag.map u.hom
      naturality := fun u₁ u₂ f => by
        dsimp [R_diag_A]
        rw [CategoryTheory.Category.id_comp, ← R_diag.map_comp, CategoryTheory.Under.w f] }
  let c_A : CategoryTheory.Limits.Cocone R_diag_A := c_V.whisker (CategoryTheory.Under.forget i₀)
  have hc_A : CategoryTheory.Limits.IsColimit c_A :=
    (CategoryTheory.Functor.Final.isColimitWhiskerEquiv (CategoryTheory.Under.forget i₀) c_V).symm hc_V
  have hα_comp_A : ∀ u : J_A, α_diag_A.app u ≫ c_A.ι.app u = ι_colim.app i₀ := by
    intro u
    dsimp [α_diag_A, c_A, c_V]
    exact (ι_colim.naturality u.hom).trans (CategoryTheory.Category.comp_id _)

  obtain ⟨u_O, U_O, instAff_O, p_O, π_O, O_O, θ_O,
      hLFP_O, hPb_O, hO_aff, hO_diag, hO_pre, hθ_fst⟩ :=
    hStep4 (R_diag.obj i₀) R_V (ι_colim.app i₀) J_A R_diag_A α_diag_A c_A.ι ⟨hc_A⟩ hα_comp_A
      C_V g_V hSepV J₀ V_cov hAffV U₀ p₀ hLFP₀ π₀ hPb₀
  have _ : ∀ a : J₀, AlgebraicGeometry.IsAffine (U_O a) := instAff_O
  let i_O : J := u_O.right

  let J_B := CategoryTheory.Under i_O
  let R_diag_B : J_B ⥤ CommRingCat.{u} := CategoryTheory.Under.forget i_O ⋙ R_diag
  let α_diag_B : (CategoryTheory.Functor.const J_B).obj (R_diag.obj i_O) ⟶ R_diag_B :=
    { app := fun u => R_diag.map u.hom
      naturality := fun u₁ u₂ f => by
        dsimp [R_diag_B]
        rw [CategoryTheory.Category.id_comp, ← R_diag.map_comp, CategoryTheory.Under.w f] }
  let c_B : CategoryTheory.Limits.Cocone R_diag_B := c_V.whisker (CategoryTheory.Under.forget i_O)
  have hc_B : CategoryTheory.Limits.IsColimit c_B :=
    (CategoryTheory.Functor.Final.isColimitWhiskerEquiv (CategoryTheory.Under.forget i_O) c_V).symm hc_V
  have hα_comp_B : ∀ u : J_B, α_diag_B.app u ≫ c_B.ι.app u = ι_colim.app i_O := by
    intro u
    dsimp [α_diag_B, c_B, c_V]
    exact (ι_colim.naturality u.hom).trans (CategoryTheory.Category.comp_id _)

  obtain ⟨u₁, U₁, instAff₁, p₁, π₁, O₁, t₁, θ₁,
      hLFP₁, hPb₁, hO₁_aff, hO₁_diag, hO₁_pre, ht₁_id, ht₁_over, hθ₁_fst, hθ₁_snd⟩ :=
    hStep5 (R_diag.obj i_O) R_V (ι_colim.app i_O) J_B R_diag_B α_diag_B c_B.ι ⟨hc_B⟩ hα_comp_B
      C_V g_V J₀ V_cov U_O p_O hLFP_O π_O hPb_O O_O hO_aff hO_diag hO_pre θ_O hθ_fst

  exact ⟨u₁.right, J₀, instFinJ₀, V_cov, U₁, instAff₁, p₁, π₁, O₁, t₁, θ₁,
    hCov, hLFP₁, hPb₁, hO₁_aff, hO₁_diag, hO₁_pre, ht₁_id, ht₁_over, hθ₁_fst, hθ₁_snd⟩

theorem weil_separated_cocycle_and_closed_graph_descent (R₁ R_V : CommRingCat.{u})
    (β₁ : R₁ ⟶ R_V)
    (J : Type u) [CategoryTheory.SmallCategory J] [CategoryTheory.IsFiltered J]
    (R_diag : CategoryTheory.Functor J CommRingCat.{u})
    (α_diag : (CategoryTheory.Functor.const J).obj R₁ ⟶ R_diag)
    (ι_colim : R_diag ⟶ (CategoryTheory.Functor.const J).obj R_V)
    (hColim : Nonempty (CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.Cocone.mk R_V ι_colim)))
    (hα_comp : ∀ i : J, α_diag.app i ≫ ι_colim.app i = β₁)
    (C_V : AlgebraicGeometry.Scheme.{u})
    (g_V : C_V ⟶ AlgebraicGeometry.Spec R_V)
    (hSepV : AlgebraicGeometry.IsSeparated g_V)
    (J₀ : Type u) [Finite J₀]
    (V_cov : J₀ → C_V.Opens)
    (U₁ : J₀ → AlgebraicGeometry.Scheme.{u})
    [∀ a : J₀, AlgebraicGeometry.IsAffine (U₁ a)]
    (p₁ : ∀ a : J₀, U₁ a ⟶ AlgebraicGeometry.Spec R₁)
    (hLFP₁ : ∀ a : J₀, AlgebraicGeometry.LocallyOfFinitePresentation (p₁ a))
    (π₁ : ∀ a : J₀, (V_cov a).toScheme ⟶ U₁ a)
    (hPb₁ : ∀ a : J₀, CategoryTheory.IsPullback (π₁ a) ((V_cov a).ι ≫ g_V) (p₁ a)
      (AlgebraicGeometry.Spec.map β₁))
    (O₁ : ∀ a b : J₀, (U₁ a).Opens)
    (hO₁_aff : ∀ a b : J₀, AlgebraicGeometry.IsAffineOpen (O₁ a b))
    (hO₁_diag : ∀ a : J₀, O₁ a a = ⊤)
    (hO₁_pre : ∀ a b : J₀,
      (TopologicalSpace.Opens.map (π₁ a).base).obj (O₁ a b) =
        (TopologicalSpace.Opens.map (V_cov a).ι.base).obj (V_cov b))
    (t₁ : ∀ a b : J₀, (O₁ a b).toScheme ⟶ (O₁ b a).toScheme)
    (ht₁_id : ∀ a : J₀, t₁ a a = 𝟙 _)
    (ht₁_over : ∀ a b : J₀, t₁ a b ≫ (O₁ b a).ι ≫ p₁ b = (O₁ a b).ι ≫ p₁ a)
    (θ₁ : ∀ a b : J₀, CategoryTheory.Limits.pullback (V_cov a).ι (V_cov b).ι ⟶ (O₁ a b).toScheme)
    (hθ₁_fst : ∀ a b : J₀, θ₁ a b ≫ (O₁ a b).ι =
      CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π₁ a)
    (hθ₁_snd : ∀ a b : J₀, θ₁ a b ≫ t₁ a b ≫ (O₁ b a).ι =
      CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π₁ b) :
    ∃ (i₀ : J)
      (U₀ : J₀ → AlgebraicGeometry.Scheme.{u})
      (_ : ∀ a : J₀, AlgebraicGeometry.IsAffine (U₀ a))
      (p₀ : ∀ a : J₀, U₀ a ⟶ AlgebraicGeometry.Spec (R_diag.obj i₀))
      (π_V : ∀ a : J₀, (V_cov a).toScheme ⟶ U₀ a)
      (O₀ : ∀ a b : J₀, (U₀ a).Opens)
      (t₀ : ∀ a b : J₀, (O₀ a b).toScheme ⟶ (O₀ b a).toScheme)
      (t'₀ : ∀ a b c : J₀,
        CategoryTheory.Limits.pullback (O₀ a b).ι (O₀ a c).ι ⟶
          CategoryTheory.Limits.pullback (O₀ b c).ι (O₀ b a).ι)
      (δ₀ : ∀ a b : J₀, (O₀ a b).toScheme ⟶ CategoryTheory.Limits.pullback (p₀ a) (p₀ b))
      (θ_V : ∀ a b : J₀, CategoryTheory.Limits.pullback (V_cov a).ι (V_cov b).ι ⟶ (O₀ a b).toScheme),
      (∀ a : J₀, AlgebraicGeometry.LocallyOfFinitePresentation (p₀ a)) ∧
      (∀ a : J₀, CategoryTheory.IsPullback (π_V a) ((V_cov a).ι ≫ g_V) (p₀ a)
        (AlgebraicGeometry.Spec.map (ι_colim.app i₀))) ∧
      (∀ a : J₀, O₀ a a = ⊤) ∧
      (∀ a b : J₀,
        (TopologicalSpace.Opens.map (π_V a).base).obj (O₀ a b) =
          (TopologicalSpace.Opens.map (V_cov a).ι.base).obj (V_cov b)) ∧
      (∀ a : J₀, t₀ a a = 𝟙 _) ∧
      (∀ a b : J₀, t₀ a b ≫ (O₀ b a).ι ≫ p₀ b = (O₀ a b).ι ≫ p₀ a) ∧
      (∀ a b c : J₀,
        t'₀ a b c ≫ CategoryTheory.Limits.pullback.snd (O₀ b c).ι (O₀ b a).ι =
          CategoryTheory.Limits.pullback.fst (O₀ a b).ι (O₀ a c).ι ≫ t₀ a b) ∧
      (∀ a b c : J₀, t'₀ a b c ≫ (t'₀ b c a ≫ t'₀ c a b) = 𝟙 _) ∧
      (∀ a b : J₀, δ₀ a b ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b) = (O₀ a b).ι) ∧
      (∀ a b : J₀, δ₀ a b ≫ CategoryTheory.Limits.pullback.snd (p₀ a) (p₀ b) = t₀ a b ≫ (O₀ b a).ι) ∧
      (∀ a b : J₀, AlgebraicGeometry.IsClosedImmersion (δ₀ a b)) ∧
      (∀ a b : J₀, θ_V a b ≫ (O₀ a b).ι =
        CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_V a) ∧
      (∀ a b : J₀, θ_V a b ≫ t₀ a b ≫ (O₀ b a).ι =
        CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π_V b) :=
by
  classical
  let _ : Fintype J₀ := Fintype.ofFinite J₀

  
  have hFiberPb : ∀ {A B S A' B' S' : AlgebraicGeometry.Scheme.{u}}
      (pA : A ⟶ S) (pB : B ⟶ S) (f : S' ⟶ S)
      (pA' : A' ⟶ S') (pB' : B' ⟶ S') (prA : A' ⟶ A) (prB : B' ⟶ B)
      (m : CategoryTheory.Limits.pullback pA' pB' ⟶ CategoryTheory.Limits.pullback pA pB),
      CategoryTheory.IsPullback prA pA' pA f →
      CategoryTheory.IsPullback prB pB' pB f →
      (m ≫ CategoryTheory.Limits.pullback.fst pA pB =
        CategoryTheory.Limits.pullback.fst pA' pB' ≫ prA) →
      (m ≫ CategoryTheory.Limits.pullback.snd pA pB =
        CategoryTheory.Limits.pullback.snd pA' pB' ≫ prB) →
      CategoryTheory.IsPullback m
        (CategoryTheory.Limits.pullback.fst pA' pB' ≫ pA')
        (CategoryTheory.Limits.pullback.fst pA pB ≫ pA) f := by
    intro A B S A' B' S' pA pB f pA' pB' prA prB m hPbA hPbB hm_fst hm_snd
    have hcomm : m ≫ (CategoryTheory.Limits.pullback.fst pA pB ≫ pA) =
        (CategoryTheory.Limits.pullback.fst pA' pB' ≫ pA') ≫ f := by
      rw [← Category.assoc, hm_fst, Category.assoc, hPbA.w, Category.assoc]
    refine CategoryTheory.IsPullback.of_isLimit (c := CategoryTheory.Limits.PullbackCone.mk m
      (CategoryTheory.Limits.pullback.fst pA' pB' ≫ pA') hcomm) ?_
    refine CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
      (fun s =>
        let hA_eq : (s.fst ≫ CategoryTheory.Limits.pullback.fst pA pB) ≫ pA = s.snd ≫ f := by
          rw [Category.assoc]; exact s.condition
        let hB_eq : (s.fst ≫ CategoryTheory.Limits.pullback.snd pA pB) ≫ pB = s.snd ≫ f := by
          rw [Category.assoc, ← CategoryTheory.Limits.pullback.condition, ← Category.assoc]
          exact hA_eq
        CategoryTheory.Limits.pullback.lift
          (hPbA.lift (s.fst ≫ CategoryTheory.Limits.pullback.fst pA pB) s.snd hA_eq)
          (hPbB.lift (s.fst ≫ CategoryTheory.Limits.pullback.snd pA pB) s.snd hB_eq)
          (by rw [hPbA.lift_snd, hPbB.lift_snd]))
      (fun s => by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [Category.assoc, hm_fst, ← Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst, hPbA.lift_fst]
        · rw [Category.assoc, hm_snd, ← Category.assoc,
            CategoryTheory.Limits.pullback.lift_snd, hPbB.lift_fst])
      (fun s => by
        rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hPbA.lift_snd])
      (fun s g hg1 hg2 => by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Limits.pullback.lift_fst]
          apply hPbA.hom_ext
          · rw [Category.assoc, ← hm_fst, ← Category.assoc, hg1, hPbA.lift_fst]
          · rw [Category.assoc, hg2, hPbA.lift_snd]
        · rw [CategoryTheory.Limits.pullback.lift_snd]
          apply hPbB.hom_ext
          · rw [Category.assoc, ← hm_snd, ← Category.assoc, hg1, hPbB.lift_fst]
          · rw [Category.assoc, ← CategoryTheory.Limits.pullback.condition,
              ← Category.assoc, Category.assoc g, hg2, hPbB.lift_snd])

  
  have hOpensDiag : ∀ (V₁ V₂ : C_V.Opens)
      (δ_V : CategoryTheory.Limits.pullback V₁.ι V₂.ι ⟶
        CategoryTheory.Limits.pullback (V₁.ι ≫ g_V) (V₂.ι ≫ g_V)),
      (δ_V ≫ CategoryTheory.Limits.pullback.fst (V₁.ι ≫ g_V) (V₂.ι ≫ g_V) =
        CategoryTheory.Limits.pullback.fst V₁.ι V₂.ι) →
      (δ_V ≫ CategoryTheory.Limits.pullback.snd (V₁.ι ≫ g_V) (V₂.ι ≫ g_V) =
        CategoryTheory.Limits.pullback.snd V₁.ι V₂.ι) →
      AlgebraicGeometry.IsClosedImmersion δ_V := by
    intro V₁ V₂ δ_V hδ_fst hδ_snd
    let Δ_V := CategoryTheory.Limits.pullback.diagonal g_V
    let Φ : CategoryTheory.Limits.pullback (V₁.ι ≫ g_V) (V₂.ι ≫ g_V) ⟶
        CategoryTheory.Limits.pullback g_V g_V :=
      CategoryTheory.Limits.pullback.map (V₁.ι ≫ g_V) (V₂.ι ≫ g_V) g_V g_V
        V₁.ι V₂.ι (𝟙 (AlgebraicGeometry.Spec R_V)) (Category.comp_id _) (Category.comp_id _)
    have hΦ_fst : Φ ≫ CategoryTheory.Limits.pullback.fst g_V g_V =
        CategoryTheory.Limits.pullback.fst (V₁.ι ≫ g_V) (V₂.ι ≫ g_V) ≫ V₁.ι :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hΦ_snd : Φ ≫ CategoryTheory.Limits.pullback.snd g_V g_V =
        CategoryTheory.Limits.pullback.snd (V₁.ι ≫ g_V) (V₂.ι ≫ g_V) ≫ V₂.ι :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hcomm : δ_V ≫ Φ = (CategoryTheory.Limits.pullback.fst V₁.ι V₂.ι ≫ V₁.ι) ≫ Δ_V := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, hΦ_fst, ← Category.assoc, hδ_fst,
          Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hΦ_snd, ← Category.assoc, hδ_snd,
          CategoryTheory.Limits.pullback.condition, Category.assoc,
          CategoryTheory.Limits.pullback.diagonal_snd, Category.comp_id]
    have hs_fst : ∀ s : CategoryTheory.Limits.PullbackCone Φ Δ_V,
        (s.fst ≫ CategoryTheory.Limits.pullback.fst (V₁.ι ≫ g_V) (V₂.ι ≫ g_V)) ≫ V₁.ι = s.snd := by
      intro s
      have h1 := s.condition =≫ CategoryTheory.Limits.pullback.fst g_V g_V
      rw [Category.assoc, hΦ_fst, Category.assoc,
        CategoryTheory.Limits.pullback.diagonal_fst, Category.comp_id, ← Category.assoc] at h1
      exact h1
    have hs_eq : ∀ s : CategoryTheory.Limits.PullbackCone Φ Δ_V,
        (s.fst ≫ CategoryTheory.Limits.pullback.fst (V₁.ι ≫ g_V) (V₂.ι ≫ g_V)) ≫ V₁.ι =
        (s.fst ≫ CategoryTheory.Limits.pullback.snd (V₁.ι ≫ g_V) (V₂.ι ≫ g_V)) ≫ V₂.ι := by
      intro s
      have h2 := s.condition =≫ CategoryTheory.Limits.pullback.snd g_V g_V
      rw [Category.assoc, hΦ_snd, Category.assoc,
        CategoryTheory.Limits.pullback.diagonal_snd, Category.comp_id, ← Category.assoc] at h2
      exact (hs_fst s).trans h2.symm
    have hPb : CategoryTheory.IsPullback δ_V
        (CategoryTheory.Limits.pullback.fst V₁.ι V₂.ι ≫ V₁.ι) Φ Δ_V := by
      refine CategoryTheory.IsPullback.of_isLimit
        (c := CategoryTheory.Limits.PullbackCone.mk δ_V
          (CategoryTheory.Limits.pullback.fst V₁.ι V₂.ι ≫ V₁.ι) hcomm) ?_
      refine CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
        (fun s => CategoryTheory.Limits.pullback.lift
          (s.fst ≫ CategoryTheory.Limits.pullback.fst (V₁.ι ≫ g_V) (V₂.ι ≫ g_V))
          (s.fst ≫ CategoryTheory.Limits.pullback.snd (V₁.ι ≫ g_V) (V₂.ι ≫ g_V))
          (hs_eq s))
        (fun s => by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [Category.assoc, hδ_fst, CategoryTheory.Limits.pullback.lift_fst]
          · rw [Category.assoc, hδ_snd, CategoryTheory.Limits.pullback.lift_snd])
        (fun s => by
          rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
          exact hs_fst s)
        (fun s g hg1 _ => by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Limits.pullback.lift_fst, ← hg1, Category.assoc, hδ_fst]
          · rw [CategoryTheory.Limits.pullback.lift_snd, ← hg1, Category.assoc, hδ_snd])
    have hClΔ : AlgebraicGeometry.IsClosedImmersion Δ_V := inferInstance
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb.flip hClΔ

  
  let mkDiagram :=
    fun {R_b : CommRingCat.{u}} {J' : Type u} [CategoryTheory.SmallCategory J']
      (R_d : CategoryTheory.Functor J' CommRingCat.{u})
      (α_d : (CategoryTheory.Functor.const J').obj R_b ⟶ R_d)
      {X_b : AlgebraicGeometry.Scheme.{u}}
      (pX_b : X_b ⟶ AlgebraicGeometry.Spec R_b) =>
      ({ obj := fun j =>
          CategoryTheory.Limits.pullback pX_b (AlgebraicGeometry.Spec.map (α_d.app j.unop))
         map := fun {j₁ j₂} u =>
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst pX_b (AlgebraicGeometry.Spec.map (α_d.app j₁.unop)))
            (CategoryTheory.Limits.pullback.snd pX_b (AlgebraicGeometry.Spec.map (α_d.app j₁.unop)) ≫
              AlgebraicGeometry.Spec.map (R_d.map u.unop))
            (by
              rw [CategoryTheory.Limits.pullback.condition, Category.assoc,
                ← AlgebraicGeometry.Spec.map_comp]
              have hnat := α_d.naturality u.unop
              dsimp at hnat
              rw [Category.id_comp] at hnat
              rw [← hnat])
         map_id := fun j => by
          apply CategoryTheory.Limits.pullback.hom_ext <;> simp
         map_comp := fun {j₁ j₂ j₃} u v => by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Limits.pullback.lift_fst, Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
          · rw [CategoryTheory.Limits.pullback.lift_snd, Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, Category.assoc,
              ← AlgebraicGeometry.Spec.map_comp, ← R_d.map_comp]
            rfl } : J'ᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u})

  let mkCone :=
    fun {R_b R_lim : CommRingCat.{u}} (β_b : R_b ⟶ R_lim)
      {J' : Type u} [CategoryTheory.SmallCategory J']
      (R_d : CategoryTheory.Functor J' CommRingCat.{u})
      (α_d : (CategoryTheory.Functor.const J').obj R_b ⟶ R_d)
      (ι_d : R_d ⟶ (CategoryTheory.Functor.const J').obj R_lim)
      (hα_d : ∀ i : J', α_d.app i ≫ ι_d.app i = β_b)
      {X_b X_lim : AlgebraicGeometry.Scheme.{u}}
      (pX_b : X_b ⟶ AlgebraicGeometry.Spec R_b)
      (pX_lim : X_lim ⟶ AlgebraicGeometry.Spec R_lim)
      (πX_lim : X_lim ⟶ X_b)
      (hPb_lim : CategoryTheory.IsPullback πX_lim pX_lim pX_b (AlgebraicGeometry.Spec.map β_b)) =>
      ({ pt := X_lim
         π :=
          { app := fun j =>
              CategoryTheory.Limits.pullback.lift πX_lim
                (pX_lim ≫ AlgebraicGeometry.Spec.map (ι_d.app j.unop))
                (by
                  rw [hPb_lim.w, Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hα_d j.unop])
            naturality := fun {j₁ j₂} u => by
              have hnat : R_d.map u.unop ≫ ι_d.app j₁.unop = ι_d.app j₂.unop := by
                have h := ι_d.naturality u.unop
                dsimp at h
                rwa [Category.comp_id] at h
              apply CategoryTheory.Limits.pullback.hom_ext
              · dsimp [mkDiagram]
                rw [Category.id_comp, CategoryTheory.Limits.pullback.lift_fst, Category.assoc,
                  CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
              · dsimp [mkDiagram]
                rw [Category.id_comp, CategoryTheory.Limits.pullback.lift_snd, Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd, Category.assoc,
                  ← AlgebraicGeometry.Spec.map_comp, hnat] } } :
        CategoryTheory.Limits.Cone (mkDiagram R_d α_d pX_b))

  have mkConeIsLimit : ∀ {R_b R_lim : CommRingCat.{u}} (β_b : R_b ⟶ R_lim)
      {J' : Type u} [CategoryTheory.SmallCategory J'] [CategoryTheory.IsFiltered J']
      (R_d : CategoryTheory.Functor J' CommRingCat.{u})
      (α_d : (CategoryTheory.Functor.const J').obj R_b ⟶ R_d)
      (ι_d : R_d ⟶ (CategoryTheory.Functor.const J').obj R_lim)
      (hc_d : CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.Cocone.mk R_lim ι_d))
      (hα_d : ∀ i : J', α_d.app i ≫ ι_d.app i = β_b)
      {X_b X_lim : AlgebraicGeometry.Scheme.{u}}
      (pX_b : X_b ⟶ AlgebraicGeometry.Spec R_b)
      (pX_lim : X_lim ⟶ AlgebraicGeometry.Spec R_lim)
      (πX_lim : X_lim ⟶ X_b)
      (hPb_lim : CategoryTheory.IsPullback πX_lim pX_lim pX_b (AlgebraicGeometry.Spec.map β_b)),
      Nonempty (CategoryTheory.Limits.IsLimit
        (mkCone β_b R_d α_d ι_d hα_d pX_b pX_lim πX_lim hPb_lim)) := by
    intro R_b R_lim β_b J' _ _ R_d α_d ι_d hc_d hα_d X_b X_lim pX_b pX_lim πX_lim hPb_lim
    let c_ring_d : CategoryTheory.Limits.Cocone R_d := CategoryTheory.Limits.Cocone.mk R_lim ι_d
    let c_base_d : CategoryTheory.Limits.Cone (R_d.op ⋙ AlgebraicGeometry.Scheme.Spec) :=
      AlgebraicGeometry.Scheme.Spec.mapCone c_ring_d.op
    have hc_base_d : CategoryTheory.Limits.IsLimit c_base_d :=
      CategoryTheory.Limits.isLimitOfPreserves AlgebraicGeometry.Scheme.Spec hc_d.op
    let D_X := mkDiagram R_d α_d pX_b
    let c_X := mkCone β_b R_d α_d ι_d hα_d pX_b pX_lim πX_lim hPb_lim
    let ϖ : D_X ⟶ R_d.op ⋙ AlgebraicGeometry.Scheme.Spec :=
      { app := fun j =>
          CategoryTheory.Limits.pullback.snd pX_b (AlgebraicGeometry.Spec.map (α_d.app j.unop))
        naturality := fun {j₁ j₂} u => by
          dsimp [D_X, mkDiagram]
          exact CategoryTheory.Limits.pullback.lift_snd
            (f := pX_b) (g := AlgebraicGeometry.Spec.map (α_d.app j₂.unop)) _ _ _ }
    let f_cone : (CategoryTheory.Limits.Cone.postcompose ϖ).obj c_X ⟶ c_base_d :=
      { hom := pX_lim
        w := fun j => by
          dsimp [c_X, mkCone, ϖ, c_base_d, c_ring_d]
          exact (CategoryTheory.Limits.pullback.lift_snd
            (f := pX_b) (g := AlgebraicGeometry.Spec.map (α_d.app j.unop)) _ _ _).symm }
    have : CategoryTheory.IsConnected J'ᵒᵖ := CategoryTheory.IsCofiltered.isConnected J'ᵒᵖ
    refine ⟨CategoryTheory.Limits.isLimitOfIsPullbackOfIsConnected ϖ c_X c_base_d f_cone ?_ hc_base_d⟩
    intro j
    refine CategoryTheory.IsPullback.of_right ?_ ?_
      (CategoryTheory.IsPullback.of_hasPullback pX_b (AlgebraicGeometry.Spec.map (α_d.app j.unop)))
    · dsimp [c_X, mkCone, f_cone, c_base_d, c_ring_d]
      rw [CategoryTheory.Limits.pullback.lift_fst, ← AlgebraicGeometry.Spec.map_comp, hα_d j.unop]
      exact hPb_lim
    · dsimp [c_X, mkCone, ϖ, f_cone, c_base_d, c_ring_d]
      exact CategoryTheory.Limits.pullback.lift_snd
        (f := pX_b) (g := AlgebraicGeometry.Spec.map (α_d.app j.unop)) _ _ _

  
  have hClosedDescent : ∀ (X₁ Y₁ : AlgebraicGeometry.Scheme.{u})
      [AlgebraicGeometry.IsAffine X₁] [AlgebraicGeometry.IsAffine Y₁]
      (pX₁ : X₁ ⟶ AlgebraicGeometry.Spec R₁)
      [AlgebraicGeometry.LocallyOfFiniteType pX₁]
      (pY₁ : Y₁ ⟶ AlgebraicGeometry.Spec R₁)
      (δ₁ : X₁ ⟶ Y₁) (_ : δ₁ ≫ pY₁ = pX₁)
      (X_V Y_V : AlgebraicGeometry.Scheme.{u})
      (pX_V : X_V ⟶ AlgebraicGeometry.Spec R_V)
      (pY_V : Y_V ⟶ AlgebraicGeometry.Spec R_V)
      (πX : X_V ⟶ X₁) (πY : Y_V ⟶ Y₁)
      (_ : CategoryTheory.IsPullback πX pX_V pX₁ (AlgebraicGeometry.Spec.map β₁))
      (_ : CategoryTheory.IsPullback πY pY_V pY₁ (AlgebraicGeometry.Spec.map β₁))
      (δ_V : X_V ⟶ Y_V)
      (_ : δ_V ≫ πY = πX ≫ δ₁)
      (_ : δ_V ≫ pY_V = pX_V)
      (_ : AlgebraicGeometry.IsClosedImmersion δ_V),
      ∃ (i_c : J),
        ∀ (i : J), Nonempty (i_c ⟶ i) →
          ∀ (X_i Y_i : AlgebraicGeometry.Scheme.{u})
            (pX_i : X_i ⟶ AlgebraicGeometry.Spec (R_diag.obj i))
            (pY_i : Y_i ⟶ AlgebraicGeometry.Spec (R_diag.obj i))
            (prX_i : X_i ⟶ X₁) (prY_i : Y_i ⟶ Y₁) (δ_i : X_i ⟶ Y_i),
            CategoryTheory.IsPullback prX_i pX_i pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i)) →
            CategoryTheory.IsPullback prY_i pY_i pY₁ (AlgebraicGeometry.Spec.map (α_diag.app i)) →
            (δ_i ≫ prY_i = prX_i ≫ δ₁) →
            (δ_i ≫ pY_i = pX_i) →
            AlgebraicGeometry.IsClosedImmersion δ_i := by
    intro X₁ Y₁ _ _ pX₁ _ pY₁ δ₁ hδ₁ X_V Y_V pX_V pY_V πX πY hPbX_V hPbY_V δ_V hδ_V_π hδ_V_p hCl_V
    obtain ⟨hc_ring⟩ := hColim
    let D_X := mkDiagram R_diag α_diag pX₁
    let c_X := mkCone β₁ R_diag α_diag ι_colim hα_comp pX₁ pX_V πX hPbX_V
    obtain ⟨hc_X⟩ := mkConeIsLimit β₁ R_diag α_diag ι_colim hc_ring hα_comp pX₁ pX_V πX hPbX_V
    let D_Y := mkDiagram R_diag α_diag pY₁
    let c_Y := mkCone β₁ R_diag α_diag ι_colim hα_comp pY₁ pY_V πY hPbY_V
    obtain ⟨hc_Y⟩ := mkConeIsLimit β₁ R_diag α_diag ι_colim hc_ring hα_comp pY₁ pY_V πY hPbY_V
    have : AlgebraicGeometry.IsAffine Y_V :=
      AlgebraicGeometry.IsAffine.of_isIso hPbY_V.isoPullback.hom
    have hSurj_V : Function.Surjective δ_V.appTop.hom :=
      (AlgebraicGeometry.IsClosedImmersion.isAffine_surjective_of_isAffine δ_V).2
    let δ_tilde : ∀ i : J, D_X.obj (Opposite.op i) ⟶ D_Y.obj (Opposite.op i) := fun i =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i)) ≫ δ₁)
        (CategoryTheory.Limits.pullback.snd pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i)))
        (by rw [Category.assoc, hδ₁, CategoryTheory.Limits.pullback.condition])
    have hδ_cone : ∀ i : J, δ_V ≫ c_Y.π.app (Opposite.op i) =
        c_X.π.app (Opposite.op i) ≫ δ_tilde i := by
      intro i
      dsimp [c_X, c_Y, mkCone, δ_tilde]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hδ_V_π,
          Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc, hδ_V_p,
          Category.assoc, CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
    have hδ_nat : ∀ {i₁ i₂ : J} (u : i₁ ⟶ i₂),
        D_X.map u.op ≫ δ_tilde i₁ = δ_tilde i₂ ≫ D_Y.map u.op := by
      intro i₁ i₂ u
      dsimp [D_X, D_Y, mkDiagram, δ_tilde]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, ← Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd, Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd]
    have hFT : RingHom.FiniteType pX₁.appTop.hom :=
      AlgebraicGeometry.HasRingHomProperty.appTop (@AlgebraicGeometry.LocallyOfFiniteType) pX₁ inferInstance
    let R₁_top : CommRingCat.{u} := Γ(AlgebraicGeometry.Spec R₁, ⊤)
    let A_top : CommRingCat.{u} := Γ(X₁, ⊤)
    let _ : Algebra ↑R₁_top ↑A_top := pX₁.appTop.hom.toAlgebra
    have hAlgFT : Algebra.FiniteType ↑R₁_top ↑A_top := hFT
    obtain ⟨G, hG⟩ := hAlgFT.out
    have hGenLift : ∀ g ∈ G, ∃ (i₂ : J) (y₂ : ↑Γ(D_Y.obj (Opposite.op i₂), ⊤)),
        (δ_tilde i₂).appTop.hom y₂ =
          (CategoryTheory.Limits.pullback.fst pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i₂))).appTop.hom g := by
      intro g _
      obtain ⟨y_V, hy_V⟩ := hSurj_V (πX.appTop.hom g)
      obtain ⟨j₁, y₁, hy₁⟩ :=
        AlgebraicGeometry.exists_appTop_π_eq_of_isAffine_of_isLimit D_Y c_Y hc_Y y_V
      let i₁ : J := j₁.unop
      let s₁ : ↑Γ(D_X.obj (Opposite.op i₁), ⊤) := (δ_tilde i₁).appTop.hom y₁
      let t₁_sec : ↑Γ(D_X.obj (Opposite.op i₁), ⊤) :=
        (CategoryTheory.Limits.pullback.fst pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i₁))).appTop.hom g
      have hEq_V : (c_X.π.app (Opposite.op i₁)).app ⊤ s₁ = (c_X.π.app (Opposite.op i₁)).app ⊤ t₁_sec := by
        change (c_X.π.app (Opposite.op i₁)).appTop.hom ((δ_tilde i₁).appTop.hom y₁) =
          (c_X.π.app (Opposite.op i₁)).appTop.hom
            ((CategoryTheory.Limits.pullback.fst pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i₁))).appTop.hom g)
        have hL_eq : (c_X.π.app (Opposite.op i₁)).appTop.hom ((δ_tilde i₁).appTop.hom y₁) =
            δ_V.appTop.hom ((c_Y.π.app j₁).appTop.hom y₁) := by
          simpa only [AlgebraicGeometry.Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
            RingHom.coe_comp, Function.comp_apply] using
            congrArg (fun φ => φ.appTop.hom y₁) (hδ_cone i₁).symm
        have hR_eq : (c_X.π.app (Opposite.op i₁)).appTop.hom
            ((CategoryTheory.Limits.pullback.fst pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i₁))).appTop.hom g) =
            πX.appTop.hom g := by
          have hc2 : c_X.π.app (Opposite.op i₁) ≫
              CategoryTheory.Limits.pullback.fst pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i₁)) = πX :=
            CategoryTheory.Limits.pullback.lift_fst πX _ _
          simpa only [AlgebraicGeometry.Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
            RingHom.coe_comp, Function.comp_apply] using congrArg (fun φ => φ.appTop.hom g) hc2
        rw [hL_eq, hR_eq]
        change δ_V.appTop.hom ((c_Y.π.app j₁).appTop y₁) = πX.appTop.hom g
        rw [hy₁, hy_V]
      have hCompTop : IsCompact ((⊤ : (D_X.obj (Opposite.op i₁)).Opens) : Set ↥(D_X.obj (Opposite.op i₁))) :=
        isCompact_univ
      obtain ⟨j₂, u_op, hu_eq⟩ :=
        AlgebraicGeometry.exists_app_map_eq_map_of_isLimit D_X c_X hc_X hCompTop s₁ t₁_sec hEq_V
      let i₂ : J := j₂.unop
      let u : i₁ ⟶ i₂ := u_op.unop
      refine ⟨i₂, (D_Y.map u.op).appTop.hom y₁, ?_⟩
      have hL : (δ_tilde i₂).appTop.hom ((D_Y.map u.op).appTop.hom y₁) =
          (D_X.map u.op).appTop.hom s₁ := by
        simpa only [s₁, AlgebraicGeometry.Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
          RingHom.coe_comp, Function.comp_apply] using
          congrArg (fun φ => φ.appTop.hom y₁) (hδ_nat u).symm
      have hR : (CategoryTheory.Limits.pullback.fst pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i₂))).appTop.hom g =
          (D_X.map u.op).appTop.hom t₁_sec := by
        have hc2 : D_X.map u.op ≫
            CategoryTheory.Limits.pullback.fst pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i₁)) =
            CategoryTheory.Limits.pullback.fst pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i₂)) :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        simpa only [t₁_sec, AlgebraicGeometry.Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
          RingHom.coe_comp, Function.comp_apply] using congrArg (fun φ => φ.appTop.hom g) hc2.symm
      rw [hL, hR]
      exact hu_eq
    choose idx_g y_g hy_g using hGenLift
    let S_G : Finset J := G.attach.image (fun x => idx_g x.1 x.2)
    obtain ⟨i_c, hi_c⟩ := CategoryTheory.IsFiltered.sup_objs_exists S_G
    have hCl_tilde : AlgebraicGeometry.IsClosedImmersion (δ_tilde i_c) := by
      apply AlgebraicGeometry.IsClosedImmersion.of_surjective_of_isAffine (δ_tilde i_c)
      let f_ic := AlgebraicGeometry.Spec.map (α_diag.app i_c)
      let fst_c := CategoryTheory.Limits.pullback.fst pX₁ f_ic
      let snd_c := CategoryTheory.Limits.pullback.snd pX₁ f_ic
      let B_top : CommRingCat.{u} := Γ(AlgebraicGeometry.Spec (R_diag.obj i_c), ⊤)
      let P_top : CommRingCat.{u} := Γ(CategoryTheory.Limits.pullback pX₁ f_ic, ⊤)
      let S_rng : Subring ↑P_top := (δ_tilde i_c).appTop.hom.range
      have hB_mem : ∀ b : ↑B_top, snd_c.appTop.hom b ∈ S_rng := by
        intro b
        refine ⟨(CategoryTheory.Limits.pullback.snd pY₁ f_ic).appTop.hom b, ?_⟩
        have h_snd : δ_tilde i_c ≫ CategoryTheory.Limits.pullback.snd pY₁ f_ic = snd_c :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        simpa only [AlgebraicGeometry.Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
          RingHom.coe_comp, Function.comp_apply] using congrArg (fun φ => φ.appTop.hom b) h_snd
      have hG_mem : ∀ g ∈ G, fst_c.appTop.hom g ∈ S_rng := by
        intro g hg
        have hmem : idx_g g hg ∈ S_G :=
          Finset.mem_image.mpr ⟨⟨g, hg⟩, Finset.mem_attach _ _, rfl⟩
        obtain ⟨v⟩ := hi_c hmem
        refine ⟨(D_Y.map v.op).appTop.hom (y_g g hg), ?_⟩
        have hc1 : δ_tilde i_c ≫ D_Y.map v.op = D_X.map v.op ≫ δ_tilde (idx_g g hg) :=
          (hδ_nat v).symm
        have h1 : (δ_tilde i_c).appTop.hom ((D_Y.map v.op).appTop.hom (y_g g hg)) =
            (D_X.map v.op).appTop.hom ((δ_tilde (idx_g g hg)).appTop.hom (y_g g hg)) := by
          simpa only [AlgebraicGeometry.Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
            RingHom.coe_comp, Function.comp_apply] using
            congrArg (fun φ => φ.appTop.hom (y_g g hg)) hc1
        rw [h1, hy_g g hg]
        have hc2 : D_X.map v.op ≫
            CategoryTheory.Limits.pullback.fst pX₁ (AlgebraicGeometry.Spec.map (α_diag.app (idx_g g hg))) =
            fst_c := CategoryTheory.Limits.pullback.lift_fst _ _ _
        simpa only [AlgebraicGeometry.Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
          RingHom.coe_comp, Function.comp_apply] using congrArg (fun φ => φ.appTop.hom g) hc2
      have hA_mem : ∀ a : ↑A_top, fst_c.appTop.hom a ∈ S_rng := by
        intro a
        have ha_top : a ∈ (⊤ : Subalgebra ↑R₁_top ↑A_top) := trivial
        rw [← hG] at ha_top
        refine Algebra.adjoin_induction
          (fun x hx => hG_mem x (Finset.mem_coe.mp hx))
          (fun r => ?_)
          (fun x y _ _ hx hy => by rw [map_add]; exact S_rng.add_mem hx hy)
          (fun x y _ _ hx hy => by rw [map_mul]; exact S_rng.mul_mem hx hy)
          ha_top
        change fst_c.appTop.hom (pX₁.appTop.hom r) ∈ S_rng
        have h_cond : fst_c.appTop.hom (pX₁.appTop.hom r) = snd_c.appTop.hom (f_ic.appTop.hom r) := by
          simpa only [fst_c, snd_c, AlgebraicGeometry.Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
            RingHom.coe_comp, Function.comp_apply] using
            congrArg (fun φ => φ.appTop.hom r)
              (CategoryTheory.Limits.pullback.condition (f := pX₁) (g := f_ic))
        rw [h_cond]
        exact hB_mem (f_ic.appTop.hom r)
      have : ∀ k : CategoryTheory.Limits.WalkingCospan,
          AlgebraicGeometry.IsAffine ((CategoryTheory.Limits.cospan pX₁ f_ic).obj k) := by
        rintro (_ | _ | _) <;> (dsimp; infer_instance)
      have hPush : CategoryTheory.IsPushout pX₁.appTop f_ic.appTop fst_c.appTop snd_c.appTop :=
        ((CategoryTheory.IsPullback.of_hasPullback pX₁ f_ic).map
          AlgebraicGeometry.Scheme.Γ.rightOp).unop.flip
      let γ_hom : ↑A_top →+* ↥S_rng :=
        RingHom.codRestrict (R := ↑A_top) (S := ↑P_top) fst_c.appTop.hom S_rng hA_mem
      let δ_hom : ↑B_top →+* ↥S_rng :=
        RingHom.codRestrict (R := ↑B_top) (S := ↑P_top) snd_c.appTop.hom S_rng hB_mem
      let γ' : A_top ⟶ CommRingCat.of ↥S_rng :=
        @CommRingCat.ofHom ↑A_top ↥S_rng (inferInstance : CommRing ↑A_top) inferInstance γ_hom
      let δ' : B_top ⟶ CommRingCat.of ↥S_rng :=
        @CommRingCat.ofHom ↑B_top ↥S_rng (inferInstance : CommRing ↑B_top) inferInstance δ_hom
      have hcomm' : pX₁.appTop ≫ γ' = f_ic.appTop ≫ δ' := by
        ext r
        exact congrArg (fun φ => φ.hom r) hPush.w
      let σ : P_top ⟶ CommRingCat.of ↥S_rng := hPush.desc γ' δ' hcomm'
      let ιS : CommRingCat.of ↥S_rng ⟶ P_top := CommRingCat.ofHom S_rng.subtype
      have hγ_fac : γ' ≫ ιS = fst_c.appTop := by ext; rfl
      have hδ_fac : δ' ≫ ιS = snd_c.appTop := by ext; rfl
      have hσ_id : σ ≫ ιS = 𝟙 P_top := by
        apply hPush.hom_ext
        · rw [← Category.assoc, hPush.inl_desc, hγ_fac, Category.comp_id]
        · rw [← Category.assoc, hPush.inr_desc, hδ_fac, Category.comp_id]
      intro p
      have hp : p ∈ S_rng := by
        have hp_eq : (σ.hom p).1 = p := congrArg (fun φ => φ.hom p) hσ_id
        rw [← hp_eq]
        exact (σ.hom p).2
      exact hp
    refine ⟨i_c, fun i ⟨u⟩ X_i Y_i pX_i pY_i prX_i prY_i δ_i hPbX_i hPbY_i hδ_pr hδ_p => ?_⟩
    let τ_u := AlgebraicGeometry.Spec.map (R_diag.map u)
    have hf_eq : τ_u ≫ AlgebraicGeometry.Spec.map (α_diag.app i_c) =
        AlgebraicGeometry.Spec.map (α_diag.app i) := by
      rw [← AlgebraicGeometry.Spec.map_comp]
      have hnat := α_diag.naturality u
      dsimp at hnat
      rw [Category.id_comp] at hnat
      rw [hnat]
    let topX : X_i ⟶ D_X.obj (Opposite.op i_c) :=
      CategoryTheory.Limits.pullback.lift prX_i (pX_i ≫ τ_u)
        (by rw [hPbX_i.w, Category.assoc, hf_eq])
    let topY : Y_i ⟶ D_Y.obj (Opposite.op i_c) :=
      CategoryTheory.Limits.pullback.lift prY_i (pY_i ≫ τ_u)
        (by rw [hPbY_i.w, Category.assoc, hf_eq])
    have hPb_topX : CategoryTheory.IsPullback topX pX_i
        (CategoryTheory.Limits.pullback.snd pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i_c))) τ_u := by
      refine CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i_c)))
      dsimp [topX]
      rw [CategoryTheory.Limits.pullback.lift_fst, hf_eq]
      exact hPbX_i
    have hPb_topY : CategoryTheory.IsPullback topY pY_i
        (CategoryTheory.Limits.pullback.snd pY₁ (AlgebraicGeometry.Spec.map (α_diag.app i_c))) τ_u := by
      refine CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback pY₁ (AlgebraicGeometry.Spec.map (α_diag.app i_c)))
      dsimp [topY]
      rw [CategoryTheory.Limits.pullback.lift_fst, hf_eq]
      exact hPbY_i
    have htop_comm : topX ≫ δ_tilde i_c = δ_i ≫ topY := by
      dsimp [topX, topY, δ_tilde]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hδ_pr]
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd,
          Category.assoc, CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc, hδ_p]
    have hPb_δ : CategoryTheory.IsPullback topX δ_i (δ_tilde i_c) topY := by
      refine CategoryTheory.IsPullback.of_bot ?_ htop_comm hPb_topY
      have h_snd : δ_tilde i_c ≫
          CategoryTheory.Limits.pullback.snd pY₁ (AlgebraicGeometry.Spec.map (α_diag.app i_c)) =
          CategoryTheory.Limits.pullback.snd pX₁ (AlgebraicGeometry.Spec.map (α_diag.app i_c)) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      rw [hδ_p, h_snd]
      exact hPb_topX
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_δ hCl_tilde

  
  have hOpenLiftDescent : ∀ (P₁ Q₁ Z₁ : AlgebraicGeometry.Scheme.{u})
      [AlgebraicGeometry.IsAffine P₁]
      (pP₁ : P₁ ⟶ AlgebraicGeometry.Spec R₁)
      (φ₁ : P₁ ⟶ Z₁)
      (ι₁ : Q₁ ⟶ Z₁) [AlgebraicGeometry.IsOpenImmersion ι₁]
      (P_V Q_V : AlgebraicGeometry.Scheme.{u})
      (pP_V : P_V ⟶ AlgebraicGeometry.Spec R_V)
      (πP : P_V ⟶ P₁)
      (_ : CategoryTheory.IsPullback πP pP_V pP₁ (AlgebraicGeometry.Spec.map β₁))
      (πQ : Q_V ⟶ Q₁)
      (ψ_V : P_V ⟶ Q_V)
      (_ : ψ_V ≫ πQ ≫ ι₁ = πP ≫ φ₁),
      ∃ (i_d : J),
        ∀ (i : J), Nonempty (i_d ⟶ i) →
          ∀ (P_i Q_i Z_i : AlgebraicGeometry.Scheme.{u})
            (pP_i : P_i ⟶ AlgebraicGeometry.Spec (R_diag.obj i))
            (prP_i : P_i ⟶ P₁) (prQ_i : Q_i ⟶ Q₁) (prZ_i : Z_i ⟶ Z₁)
            (φ_i : P_i ⟶ Z_i) (ι_i : Q_i ⟶ Z_i)
            [AlgebraicGeometry.IsOpenImmersion ι_i],
            CategoryTheory.IsPullback prP_i pP_i pP₁ (AlgebraicGeometry.Spec.map (α_diag.app i)) →
            CategoryTheory.IsPullback prQ_i ι_i ι₁ prZ_i →
            (φ_i ≫ prZ_i = prP_i ≫ φ₁) →
            ∃ (t'_i : P_i ⟶ Q_i), t'_i ≫ ι_i = φ_i := by
    intro P₁ Q₁ Z₁ _ pP₁ φ₁ ι₁ _ P_V Q_V pP_V πP hPbP_V πQ ψ_V hψ_V
    obtain ⟨hc_ring⟩ := hColim
    let D_P := mkDiagram R_diag α_diag pP₁
    let c_P := mkCone β₁ R_diag α_diag ι_colim hα_comp pP₁ pP_V πP hPbP_V
    obtain ⟨hc_P⟩ := mkConeIsLimit β₁ R_diag α_diag ι_colim hc_ring hα_comp pP₁ pP_V πP hPbP_V
    let W₁ : P₁.Opens := (TopologicalSpace.Opens.map φ₁.base).obj ι₁.opensRange
    obtain ⟨i_init⟩ := CategoryTheory.IsFiltered.nonempty (C := J)
    let fst_init := CategoryTheory.Limits.pullback.fst pP₁ (AlgebraicGeometry.Spec.map (α_diag.app i_init))
    let W_init : (D_P.obj (Opposite.op i_init)).Opens := (TopologicalSpace.Opens.map fst_init.base).obj W₁
    have hW_top : (TopologicalSpace.Opens.map (c_P.π.app (Opposite.op i_init)).base).obj W_init = ⊤ := by
      rw [eq_top_iff]
      intro z _
      change φ₁.base ((c_P.π.app (Opposite.op i_init) ≫ fst_init).base z) ∈ Set.range ι₁.base
      have h_πP : c_P.π.app (Opposite.op i_init) ≫ fst_init = πP :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [h_πP]
      refine ⟨πQ.base (ψ_V.base z), ?_⟩
      exact congrArg (fun f => f.base z) hψ_V
    obtain ⟨j_d, u_op, hu_top⟩ := AlgebraicGeometry.exists_map_eq_top D_P c_P hc_P W_init hW_top
    let i_d : J := j_d.unop
    have hW_id : ∀ x : ↥(D_P.obj (Opposite.op i_d)),
        (CategoryTheory.Limits.pullback.fst pP₁ (AlgebraicGeometry.Spec.map (α_diag.app i_d))).base x ∈ W₁ := by
      intro x
      have hx_top : x ∈ (TopologicalSpace.Opens.map (D_P.map u_op).base).obj W_init := by
        rw [hu_top]; trivial
      have h_fst : D_P.map u_op ≫ fst_init =
          CategoryTheory.Limits.pullback.fst pP₁ (AlgebraicGeometry.Spec.map (α_diag.app i_d)) :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      change (D_P.map u_op ≫ fst_init).base x ∈ W₁ at hx_top
      rwa [h_fst] at hx_top
    refine ⟨i_d, fun i ⟨u⟩ P_i Q_i Z_i pP_i prP_i prQ_i prZ_i φ_i ι_i _ hPbP_i hPbQ_i hφ_i => ?_⟩
    let τ_u := AlgebraicGeometry.Spec.map (R_diag.map u)
    have hf_eq : τ_u ≫ AlgebraicGeometry.Spec.map (α_diag.app i_d) =
        AlgebraicGeometry.Spec.map (α_diag.app i) := by
      rw [← AlgebraicGeometry.Spec.map_comp]
      have hnat := α_diag.naturality u
      dsimp at hnat
      rw [Category.id_comp] at hnat
      rw [hnat]
    let topP : P_i ⟶ D_P.obj (Opposite.op i_d) :=
      CategoryTheory.Limits.pullback.lift prP_i (pP_i ≫ τ_u)
        (by rw [hPbP_i.w, Category.assoc, hf_eq])
    have h_range : Set.range φ_i.base ⊆ Set.range ι_i.base := by
      rintro _ ⟨y, rfl⟩
      have hy_W₁ : prP_i.base y ∈ W₁ := by
        have h_fst : topP ≫
            CategoryTheory.Limits.pullback.fst pP₁ (AlgebraicGeometry.Spec.map (α_diag.app i_d)) =
            prP_i := CategoryTheory.Limits.pullback.lift_fst _ _ _
        rw [← h_fst]
        exact hW_id (topP.base y)
      obtain ⟨q₁, hq₁⟩ := hy_W₁
      have h_eq : prZ_i.base (φ_i.base y) = ι₁.base q₁ := by
        calc
          prZ_i.base (φ_i.base y) = (φ_i ≫ prZ_i).base y := rfl
          _ = (prP_i ≫ φ₁).base y := by rw [hφ_i]
          _ = φ₁.base (prP_i.base y) := rfl
          _ = ι₁.base q₁ := hq₁.symm
      obtain ⟨q_i, hq_i, _⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPbQ_i.flip (φ_i.base y) q₁ h_eq
      exact ⟨q_i, hq_i⟩
    exact ⟨AlgebraicGeometry.IsOpenImmersion.lift ι_i φ_i h_range,
      AlgebraicGeometry.IsOpenImmersion.lift_fac ι_i φ_i h_range⟩

  
  have hHomEqDescent : ∀ {R_b : CommRingCat.{u}} (β_b : R_b ⟶ R_V)
      {J' : Type u} [CategoryTheory.SmallCategory J'] [CategoryTheory.IsFiltered J']
      (R_d : CategoryTheory.Functor J' CommRingCat.{u})
      (α_d : (CategoryTheory.Functor.const J').obj R_b ⟶ R_d)
      (ι_d : R_d ⟶ (CategoryTheory.Functor.const J').obj R_V)
      (_ : CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.Cocone.mk R_V ι_d))
      (hα_d : ∀ i : J', α_d.app i ≫ ι_d.app i = β_b)
      (X_b Y_b : AlgebraicGeometry.Scheme.{u})
      [AlgebraicGeometry.IsAffine X_b]
      (pX_b : X_b ⟶ AlgebraicGeometry.Spec R_b)
      (pY_b : Y_b ⟶ AlgebraicGeometry.Spec R_b)
      [AlgebraicGeometry.LocallyOfFiniteType pY_b]
      (g_b h_b : X_b ⟶ Y_b)
      (_ : g_b ≫ pY_b = pX_b)
      (_ : h_b ≫ pY_b = pX_b)
      (X_lim : AlgebraicGeometry.Scheme.{u})
      (pX_lim : X_lim ⟶ AlgebraicGeometry.Spec R_V)
      (πX_lim : X_lim ⟶ X_b)
      (_ : CategoryTheory.IsPullback πX_lim pX_lim pX_b (AlgebraicGeometry.Spec.map β_b))
      (_ : πX_lim ≫ g_b = πX_lim ≫ h_b),
      ∃ (w₀ : J'),
        ∀ (w : J'), Nonempty (w₀ ⟶ w) →
          ∀ (X_w Y_w : AlgebraicGeometry.Scheme.{u})
            (pX_w : X_w ⟶ AlgebraicGeometry.Spec (R_d.obj w))
            (pY_w : Y_w ⟶ AlgebraicGeometry.Spec (R_d.obj w))
            (prX_w : X_w ⟶ X_b) (prY_w : Y_w ⟶ Y_b) (g_w h_w : X_w ⟶ Y_w),
            CategoryTheory.IsPullback prX_w pX_w pX_b (AlgebraicGeometry.Spec.map (α_d.app w)) →
            CategoryTheory.IsPullback prY_w pY_w pY_b (AlgebraicGeometry.Spec.map (α_d.app w)) →
            (g_w ≫ prY_w = prX_w ≫ g_b) →
            (g_w ≫ pY_w = pX_w) →
            (h_w ≫ prY_w = prX_w ≫ h_b) →
            (h_w ≫ pY_w = pX_w) →
            g_w = h_w := by
    intro R_b β_b J' _ _ R_d α_d ι_d hc_d hα_d X_b Y_b _ pX_b pY_b _ g_b h_b hg_b hh_b
      X_lim pX_lim πX_lim hPb_lim hEq_lim
    let D_X := mkDiagram R_d α_d pX_b
    let c_X := mkCone β_b R_d α_d ι_d hα_d pX_b pX_lim πX_lim hPb_lim
    obtain ⟨hc_X⟩ := mkConeIsLimit β_b R_d α_d ι_d hc_d hα_d pX_b pX_lim πX_lim hPb_lim
    let t : D_X ⟶ (CategoryTheory.Functor.const J'ᵒᵖ).obj (AlgebraicGeometry.Spec R_b) :=
      { app := fun j =>
          CategoryTheory.Limits.pullback.fst pX_b (AlgebraicGeometry.Spec.map (α_d.app j.unop)) ≫ pX_b
        naturality := fun {j₁ j₂} u => by
          dsimp [D_X, mkDiagram]
          rw [Category.comp_id, ← Category.assoc, CategoryTheory.Limits.pullback.lift_fst] }
    obtain ⟨w_init⟩ := CategoryTheory.IsFiltered.nonempty (C := J')
    let fst_init := CategoryTheory.Limits.pullback.fst pX_b (AlgebraicGeometry.Spec.map (α_d.app w_init))
    let a_init : D_X.obj (Opposite.op w_init) ⟶ Y_b := fst_init ≫ g_b
    let b_init : D_X.obj (Opposite.op w_init) ⟶ Y_b := fst_init ≫ h_b
    have ha_t : t.app (Opposite.op w_init) = a_init ≫ pY_b := by
      dsimp [t, a_init, fst_init]; rw [Category.assoc, hg_b]
    have hb_t : t.app (Opposite.op w_init) = b_init ≫ pY_b := by
      dsimp [t, b_init, fst_init]; rw [Category.assoc, hh_b]
    have hab_V : c_X.π.app (Opposite.op w_init) ≫ a_init =
        c_X.π.app (Opposite.op w_init) ≫ b_init := by
      have h_π : c_X.π.app (Opposite.op w_init) ≫ fst_init = πX_lim :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      dsimp [a_init, b_init]
      rw [← Category.assoc, ← Category.assoc, h_π, hEq_lim]
    obtain ⟨j₀, u_op, hu_eq⟩ :=
      AlgebraicGeometry.Scheme.exists_hom_comp_eq_comp_of_locallyOfFiniteType
        D_X t pY_b c_X hc_X a_init b_init ha_t hb_t hab_V
    let w₀ : J' := j₀.unop
    have hEq_w₀ :
        CategoryTheory.Limits.pullback.fst pX_b (AlgebraicGeometry.Spec.map (α_d.app w₀)) ≫ g_b =
        CategoryTheory.Limits.pullback.fst pX_b (AlgebraicGeometry.Spec.map (α_d.app w₀)) ≫ h_b := by
      have h_fst : D_X.map u_op ≫ fst_init =
          CategoryTheory.Limits.pullback.fst pX_b (AlgebraicGeometry.Spec.map (α_d.app w₀)) :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      dsimp [a_init, b_init] at hu_eq
      rw [← Category.assoc, ← Category.assoc, h_fst] at hu_eq
      exact hu_eq
    refine ⟨w₀, fun w ⟨u⟩ X_w Y_w pX_w pY_w prX_w prY_w g_w h_w hPbX_w hPbY_w hg_pr hg_p hh_pr hh_p => ?_⟩
    let τ_u := AlgebraicGeometry.Spec.map (R_d.map u)
    have hf_eq : τ_u ≫ AlgebraicGeometry.Spec.map (α_d.app w₀) =
        AlgebraicGeometry.Spec.map (α_d.app w) := by
      rw [← AlgebraicGeometry.Spec.map_comp]
      have hnat := α_d.naturality u
      dsimp at hnat
      rw [Category.id_comp] at hnat
      rw [hnat]
    let topX : X_w ⟶ D_X.obj (Opposite.op w₀) :=
      CategoryTheory.Limits.pullback.lift prX_w (pX_w ≫ τ_u)
        (by rw [hPbX_w.w, Category.assoc, hf_eq])
    have h_fst : topX ≫
        CategoryTheory.Limits.pullback.fst pX_b (AlgebraicGeometry.Spec.map (α_d.app w₀)) =
        prX_w := CategoryTheory.Limits.pullback.lift_fst _ _ _
    apply hPbY_w.hom_ext
    · rw [hg_pr, hh_pr, ← h_fst, Category.assoc, Category.assoc, hEq_w₀]
    · rw [hg_p, hh_p]

  
  let S₁ := AlgebraicGeometry.Spec R₁
  let S_i : J → AlgebraicGeometry.Scheme.{u} := fun i => AlgebraicGeometry.Spec (R_diag.obj i)
  let f_i : ∀ i : J, S_i i ⟶ S₁ := fun i => AlgebraicGeometry.Spec.map (α_diag.app i)
  let ρ_i : ∀ i : J, AlgebraicGeometry.Spec R_V ⟶ S_i i := fun i =>
    AlgebraicGeometry.Spec.map (ι_colim.app i)
  have hρf : ∀ i : J, ρ_i i ≫ f_i i = AlgebraicGeometry.Spec.map β₁ := by
    intro i; dsimp [ρ_i, f_i]; rw [← AlgebraicGeometry.Spec.map_comp, hα_comp i]

  let U_i : J → J₀ → AlgebraicGeometry.Scheme.{u} :=
    fun i a => CategoryTheory.Limits.pullback (p₁ a) (f_i i)
  let pr_U : ∀ (i : J) (a : J₀), U_i i a ⟶ U₁ a :=
    fun i a => CategoryTheory.Limits.pullback.fst (p₁ a) (f_i i)
  let p_i : ∀ (i : J) (a : J₀), U_i i a ⟶ S_i i :=
    fun i a => CategoryTheory.Limits.pullback.snd (p₁ a) (f_i i)
  have hAffU_i : ∀ (i : J) (a : J₀), AlgebraicGeometry.IsAffine (U_i i a) :=
    fun _ _ => inferInstance
  have hLFP_i : ∀ (i : J) (a : J₀), AlgebraicGeometry.LocallyOfFinitePresentation (p_i i a) :=
    fun i a => by have := hLFP₁ a; infer_instance
  have hPbU_i : ∀ (i : J) (a : J₀),
      CategoryTheory.IsPullback (pr_U i a) (p_i i a) (p₁ a) (f_i i) :=
    fun i a => CategoryTheory.IsPullback.of_hasPullback (p₁ a) (f_i i)

  let π_i : ∀ (i : J) (a : J₀), (V_cov a).toScheme ⟶ U_i i a := fun i a =>
    CategoryTheory.Limits.pullback.lift (π₁ a) (((V_cov a).ι ≫ g_V) ≫ ρ_i i)
      (by rw [(hPb₁ a).w, ← hρf i]; simp only [Category.assoc])
  have hπ_pr : ∀ (i : J) (a : J₀), π_i i a ≫ pr_U i a = π₁ a :=
    fun i a => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hπ_p : ∀ (i : J) (a : J₀), π_i i a ≫ p_i i a = ((V_cov a).ι ≫ g_V) ≫ ρ_i i :=
    fun i a => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPbπ_i : ∀ (i : J) (a : J₀),
      CategoryTheory.IsPullback (π_i i a) ((V_cov a).ι ≫ g_V) (p_i i a) (ρ_i i) := by
    intro i a
    refine CategoryTheory.IsPullback.of_right ?_ (hπ_p i a) (hPbU_i i a)
    rw [hπ_pr i a, hρf i]
    exact hPb₁ a

  let O_i : ∀ (i : J) (a b : J₀), (U_i i a).Opens :=
    fun i a b => (TopologicalSpace.Opens.map (pr_U i a).base).obj (O₁ a b)
  have hO_diag_i : ∀ (i : J) (a : J₀), O_i i a a = ⊤ := by
    intro i a; dsimp [O_i]; rw [hO₁_diag a]; rfl
  have hO_aff_i : ∀ (i : J) (a b : J₀), AlgebraicGeometry.IsAffineOpen (O_i i a b) := by
    intro i a b
    have := hAffU_i i a
    exact (hO₁_aff a b).preimage (pr_U i a)
  have hAffO₁ : ∀ a b : J₀, AlgebraicGeometry.IsAffine (O₁ a b).toScheme :=
    fun a b => hO₁_aff a b
  have hAffO_i : ∀ (i : J) (a b : J₀), AlgebraicGeometry.IsAffine (O_i i a b).toScheme :=
    fun i a b => hO_aff_i i a b
  have hO_pre_i : ∀ (i : J) (a b : J₀),
      (TopologicalSpace.Opens.map (π_i i a).base).obj (O_i i a b) =
        (TopologicalSpace.Opens.map (V_cov a).ι.base).obj (V_cov b) := by
    intro i a b
    rw [← hO₁_pre a b]
    ext x
    change (π_i i a ≫ pr_U i a).base x ∈ O₁ a b ↔ (π₁ a).base x ∈ O₁ a b
    rw [hπ_pr i a]

  let q_i : ∀ (i : J) (a b : J₀), (O_i i a b).toScheme ⟶ (O₁ a b).toScheme := fun i a b =>
    AlgebraicGeometry.IsOpenImmersion.lift (O₁ a b).ι ((O_i i a b).ι ≫ pr_U i a) (by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      exact x.2)
  have hq_fac : ∀ (i : J) (a b : J₀), q_i i a b ≫ (O₁ a b).ι = (O_i i a b).ι ≫ pr_U i a :=
    fun i a b => AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
  have hPbO_U : ∀ (i : J) (a b : J₀),
      CategoryTheory.IsPullback (q_i i a b) (O_i i a b).ι (O₁ a b).ι (pr_U i a) :=
    fun i a b => AlgebraicGeometry.IsOpenImmersion.isPullback
      (q_i i a b) (O_i i a b).ι (O₁ a b).ι (pr_U i a) (hq_fac i a b).symm
      (by ext x; simp [O_i, AlgebraicGeometry.Scheme.Opens.opensRange_ι])
  have hPbO_S : ∀ (i : J) (a b : J₀),
      CategoryTheory.IsPullback (q_i i a b) ((O_i i a b).ι ≫ p_i i a)
        ((O₁ a b).ι ≫ p₁ a) (f_i i) :=
    fun i a b => (hPbO_U i a b).paste_vert (hPbU_i i a)

  let t_i : ∀ (i : J) (a b : J₀), (O_i i a b).toScheme ⟶ (O_i i b a).toScheme := fun i a b =>
    (hPbO_S i b a).lift (q_i i a b ≫ t₁ a b) ((O_i i a b).ι ≫ p_i i a)
      (by rw [Category.assoc, ht₁_over a b, ← (hPbO_S i a b).w])
  have ht_q : ∀ (i : J) (a b : J₀), t_i i a b ≫ q_i i b a = q_i i a b ≫ t₁ a b :=
    fun i a b => (hPbO_S i b a).lift_fst _ _ _
  have ht_over_i : ∀ (i : J) (a b : J₀),
      t_i i a b ≫ (O_i i b a).ι ≫ p_i i b = (O_i i a b).ι ≫ p_i i a :=
    fun i a b => (hPbO_S i b a).lift_snd _ _ _
  have ht_id_i : ∀ (i : J) (a : J₀), t_i i a a = 𝟙 _ := by
    intro i a
    apply (hPbO_S i a a).hom_ext
    · rw [ht_q i a a, ht₁_id a, Category.comp_id, Category.id_comp]
    · rw [ht_over_i i a a, Category.id_comp]

  let δ_i : ∀ (i : J) (a b : J₀),
      (O_i i a b).toScheme ⟶ CategoryTheory.Limits.pullback (p_i i a) (p_i i b) := fun i a b =>
    CategoryTheory.Limits.pullback.lift (O_i i a b).ι (t_i i a b ≫ (O_i i b a).ι)
      (by rw [Category.assoc, ht_over_i i a b])
  have hδ_fst_i : ∀ (i : J) (a b : J₀),
      δ_i i a b ≫ CategoryTheory.Limits.pullback.fst (p_i i a) (p_i i b) = (O_i i a b).ι :=
    fun i a b => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hδ_snd_i : ∀ (i : J) (a b : J₀),
      δ_i i a b ≫ CategoryTheory.Limits.pullback.snd (p_i i a) (p_i i b) =
        t_i i a b ≫ (O_i i b a).ι :=
    fun i a b => CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hθ_range_i : ∀ (i : J) (a b : J₀),
      Set.range (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_i i a).base ⊆
        Set.range (O_i i a b).ι.base := by
    rintro i a b _ ⟨z, hz⟩
    rw [← hz, AlgebraicGeometry.Scheme.Opens.range_ι]
    change (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι).base z ∈
      (TopologicalSpace.Opens.map (π_i i a).base).obj (O_i i a b)
    rw [hO_pre_i i a b]
    change (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ (V_cov a).ι).base z ∈
      (V_cov b : Set C_V)
    rw [CategoryTheory.Limits.pullback.condition, ← AlgebraicGeometry.Scheme.Opens.range_ι]
    exact ⟨(CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι).base z, rfl⟩

  let θ_i : ∀ (i : J) (a b : J₀),
      CategoryTheory.Limits.pullback (V_cov a).ι (V_cov b).ι ⟶ (O_i i a b).toScheme :=
    fun i a b => AlgebraicGeometry.IsOpenImmersion.lift (O_i i a b).ι
      (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_i i a)
      (hθ_range_i i a b)
  have hθ_fst_i : ∀ (i : J) (a b : J₀),
      θ_i i a b ≫ (O_i i a b).ι =
        CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_i i a :=
    fun i a b => AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
  have hθ_q : ∀ (i : J) (a b : J₀), θ_i i a b ≫ q_i i a b = θ₁ a b := by
    intro i a b
    rw [← cancel_mono (O₁ a b).ι, Category.assoc, hq_fac i a b, ← Category.assoc,
      hθ_fst_i i a b, Category.assoc, hπ_pr i a, hθ₁_fst a b]
  have hθ_snd_i : ∀ (i : J) (a b : J₀),
      θ_i i a b ≫ t_i i a b ≫ (O_i i b a).ι =
        CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π_i i b := by
    intro i a b
    apply CategoryTheory.Limits.pullback.hom_ext
    · calc
        (θ_i i a b ≫ t_i i a b ≫ (O_i i b a).ι) ≫ pr_U i b
          = θ_i i a b ≫ t_i i a b ≫ ((O_i i b a).ι ≫ pr_U i b) := by
              simp only [Category.assoc]
        _ = θ_i i a b ≫ (t_i i a b ≫ q_i i b a) ≫ (O₁ b a).ι := by
              rw [← hq_fac i b a, Category.assoc]
        _ = (θ_i i a b ≫ q_i i a b) ≫ t₁ a b ≫ (O₁ b a).ι := by
              rw [ht_q i a b]; simp only [Category.assoc]
        _ = CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π₁ b := by
              rw [hθ_q i a b, hθ₁_snd a b]
        _ = (CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π_i i b) ≫ pr_U i b := by
              rw [Category.assoc, hπ_pr i b]
    · calc
        (θ_i i a b ≫ t_i i a b ≫ (O_i i b a).ι) ≫ p_i i b
          = θ_i i a b ≫ (t_i i a b ≫ (O_i i b a).ι ≫ p_i i b) := by
              simp only [Category.assoc]
        _ = (θ_i i a b ≫ (O_i i a b).ι) ≫ p_i i a := by
              rw [ht_over_i i a b, Category.assoc]
        _ = CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ (π_i i a ≫ p_i i a) := by
              rw [hθ_fst_i i a b, Category.assoc]
        _ = (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ (V_cov a).ι) ≫
              g_V ≫ ρ_i i := by
              rw [hπ_p i a]; simp only [Category.assoc]
        _ = CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫
              (((V_cov b).ι ≫ g_V) ≫ ρ_i i) := by
              rw [CategoryTheory.Limits.pullback.condition]; simp only [Category.assoc]
        _ = (CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π_i i b) ≫ p_i i b := by
              rw [← hπ_p i b, Category.assoc]

  have hPbθ₁ : ∀ a b : J₀,
      CategoryTheory.IsPullback (θ₁ a b)
        (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι)
        (O₁ a b).ι (π₁ a) := by
    intro a b
    refine AlgebraicGeometry.IsOpenImmersion.isPullback (θ₁ a b)
      (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι)
      (O₁ a b).ι (π₁ a) (hθ₁_fst a b).symm ?_
    rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι, hO₁_pre a b]
    ext x
    constructor
    · intro hx
      have hx_rng : (V_cov a).ι.base x ∈ Set.range (V_cov b).ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]; exact hx
      obtain ⟨y, hy⟩ := hx_rng
      obtain ⟨z, hz1, _⟩ := AlgebraicGeometry.Scheme.exists_preimage_of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback (V_cov a).ι (V_cov b).ι) x y hy.symm
      exact ⟨z, hz1⟩
    · rintro ⟨z, rfl⟩
      change (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ (V_cov a).ι).base z ∈
        (V_cov b : Set C_V)
      rw [CategoryTheory.Limits.pullback.condition, ← AlgebraicGeometry.Scheme.Opens.range_ι]
      exact ⟨(CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι).base z, rfl⟩

  have hPbθ₁_S : ∀ a b : J₀,
      CategoryTheory.IsPullback (θ₁ a b)
        (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ (V_cov a).ι ≫ g_V)
        ((O₁ a b).ι ≫ p₁ a) (AlgebraicGeometry.Spec.map β₁) :=
    fun a b => (hPbθ₁ a b).paste_vert (hPb₁ a)

  
  let V_ov : J₀ → J₀ → AlgebraicGeometry.Scheme.{u} :=
    fun a b => CategoryTheory.Limits.pullback (V_cov a).ι (V_cov b).ι
  let v_fst : ∀ a b : J₀, V_ov a b ⟶ (V_cov a).toScheme :=
    fun a b => CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι
  let v_snd : ∀ a b : J₀, V_ov a b ⟶ (V_cov b).toScheme :=
    fun a b => CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι
  let v_swap : ∀ a b : J₀, V_ov a b ⟶ V_ov b a := fun a b =>
    CategoryTheory.Limits.pullback.lift (v_snd a b) (v_fst a b)
      (CategoryTheory.Limits.pullback.condition (f := (V_cov a).ι) (g := (V_cov b).ι)).symm
  have hv_swap_fst : ∀ a b : J₀, v_swap a b ≫ v_fst b a = v_snd a b :=
    fun a b => CategoryTheory.Limits.pullback.lift_fst _ _ _

  have hθ₁_symm : ∀ a b : J₀, θ₁ a b ≫ t₁ a b = v_swap a b ≫ θ₁ b a := by
    intro a b
    rw [← cancel_mono (O₁ b a).ι, Category.assoc, Category.assoc, hθ₁_snd a b,
      hθ₁_fst b a, ← Category.assoc, hv_swap_fst a b]

  have hθ_symm_i : ∀ (i : J) (a b : J₀), θ_i i a b ≫ t_i i a b = v_swap a b ≫ θ_i i b a := by
    intro i a b
    rw [← cancel_mono (O_i i b a).ι, Category.assoc, Category.assoc, hθ_snd_i i a b,
      hθ_fst_i i b a, ← Category.assoc, hv_swap_fst a b]

  let T_V : J₀ → J₀ → J₀ → AlgebraicGeometry.Scheme.{u} :=
    fun a b c => CategoryTheory.Limits.pullback (v_fst a b) (v_fst a c)
  let tv_fst : ∀ a b c : J₀, T_V a b c ⟶ V_ov a b :=
    fun a b c => CategoryTheory.Limits.pullback.fst (v_fst a b) (v_fst a c)
  let tv_snd : ∀ a b c : J₀, T_V a b c ⟶ V_ov a c :=
    fun a b c => CategoryTheory.Limits.pullback.snd (v_fst a b) (v_fst a c)
  let ψ_V : ∀ a b c : J₀, T_V a b c ⟶ T_V b c a := fun a b c =>
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.lift
        (tv_fst a b c ≫ v_snd a b)
        (tv_snd a b c ≫ v_snd a c)
        (by
          dsimp [v_snd, tv_fst, tv_snd]
          rw [Category.assoc,
            ← CategoryTheory.Limits.pullback.condition (f := (V_cov a).ι) (g := (V_cov b).ι),
            ← Category.assoc,
            CategoryTheory.Limits.pullback.condition (f := v_fst a b) (g := v_fst a c),
            Category.assoc,
            CategoryTheory.Limits.pullback.condition (f := (V_cov a).ι) (g := (V_cov c).ι),
            Category.assoc]))
      (tv_fst a b c ≫ v_swap a b)
      (by
        rw [CategoryTheory.Limits.pullback.lift_fst, Category.assoc, hv_swap_fst a b])
  let μ_TV : ∀ a b c : J₀, T_V a b c ⟶ C_V :=
    fun a b c => tv_fst a b c ≫ v_fst a b ≫ (V_cov a).ι
  have hψ_μ : ∀ a b c : J₀, ψ_V a b c ≫ μ_TV b c a = μ_TV a b c := by
    intro a b c
    dsimp [ψ_V, μ_TV]
    rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
      ← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
    dsimp [v_fst, v_snd]
    rw [Category.assoc,
      ← CategoryTheory.Limits.pullback.condition (f := (V_cov a).ι) (g := (V_cov b).ι)]
  have hψ_cocyc : ∀ a b c : J₀, ψ_V a b c ≫ (ψ_V b c a ≫ ψ_V c a b) = 𝟙 _ := by
    intro a b c
    have : AlgebraicGeometry.IsOpenImmersion (v_fst a b) := inferInstance
    have : AlgebraicGeometry.IsOpenImmersion (v_fst a c) := inferInstance
    have : AlgebraicGeometry.IsOpenImmersion (tv_fst a b c) := inferInstance
    have : AlgebraicGeometry.IsOpenImmersion (μ_TV a b c) := inferInstance
    rw [← cancel_mono (μ_TV a b c), Category.id_comp, Category.assoc, Category.assoc,
      hψ_μ c a b, hψ_μ b c a, hψ_μ a b c]

  
  have hPairClosed : ∀ a b : J₀,
      ∃ i_c : J, ∀ i : J, Nonempty (i_c ⟶ i) → AlgebraicGeometry.IsClosedImmersion (δ_i i a b) := by
    intro a b
    have : AlgebraicGeometry.IsAffine (O₁ a b).toScheme := hAffO₁ a b
    have : AlgebraicGeometry.LocallyOfFinitePresentation (p₁ a) := hLFP₁ a
    have : AlgebraicGeometry.LocallyOfFiniteType ((O₁ a b).ι ≫ p₁ a) := inferInstance
    let Y₁ := CategoryTheory.Limits.pullback (p₁ a) (p₁ b)
    let pY₁ := CategoryTheory.Limits.pullback.fst (p₁ a) (p₁ b) ≫ p₁ a
    let δ₁_ab : (O₁ a b).toScheme ⟶ Y₁ :=
      CategoryTheory.Limits.pullback.lift (O₁ a b).ι (t₁ a b ≫ (O₁ b a).ι)
        (by rw [Category.assoc, ht₁_over a b])
    have hδ₁_p : δ₁_ab ≫ pY₁ = (O₁ a b).ι ≫ p₁ a := by
      dsimp [δ₁_ab, pY₁]; rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
    let Y_V := CategoryTheory.Limits.pullback ((V_cov a).ι ≫ g_V) ((V_cov b).ι ≫ g_V)
    let pY_V := CategoryTheory.Limits.pullback.fst ((V_cov a).ι ≫ g_V) ((V_cov b).ι ≫ g_V) ≫
      ((V_cov a).ι ≫ g_V)
    let πY : Y_V ⟶ Y₁ :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst ((V_cov a).ι ≫ g_V) ((V_cov b).ι ≫ g_V) ≫ π₁ a)
        (CategoryTheory.Limits.pullback.snd ((V_cov a).ι ≫ g_V) ((V_cov b).ι ≫ g_V) ≫ π₁ b)
        (by
          calc
            (CategoryTheory.Limits.pullback.fst ((V_cov a).ι ≫ g_V) ((V_cov b).ι ≫ g_V) ≫ π₁ a) ≫ p₁ a
              = CategoryTheory.Limits.pullback.fst ((V_cov a).ι ≫ g_V) ((V_cov b).ι ≫ g_V) ≫
                  ((V_cov a).ι ≫ g_V) ≫ AlgebraicGeometry.Spec.map β₁ := by
                    rw [Category.assoc, (hPb₁ a).w]
            _ = CategoryTheory.Limits.pullback.snd ((V_cov a).ι ≫ g_V) ((V_cov b).ι ≫ g_V) ≫
                  ((V_cov b).ι ≫ g_V) ≫ AlgebraicGeometry.Spec.map β₁ := by
                    rw [← Category.assoc, CategoryTheory.Limits.pullback.condition, Category.assoc]
            _ = (CategoryTheory.Limits.pullback.snd ((V_cov a).ι ≫ g_V) ((V_cov b).ι ≫ g_V) ≫ π₁ b) ≫ p₁ b := by
                    rw [← (hPb₁ b).w, Category.assoc])
    have hPbY_V : CategoryTheory.IsPullback πY pY_V pY₁ (AlgebraicGeometry.Spec.map β₁) :=
      hFiberPb (p₁ a) (p₁ b) (AlgebraicGeometry.Spec.map β₁)
        ((V_cov a).ι ≫ g_V) ((V_cov b).ι ≫ g_V) (π₁ a) (π₁ b) πY
        (hPb₁ a) (hPb₁ b)
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    let δ_V : V_ov a b ⟶ Y_V :=
      CategoryTheory.Limits.pullback.lift (v_fst a b) (v_snd a b)
        (by
          dsimp [v_fst, v_snd]
          rw [← Category.assoc, ← Category.assoc, CategoryTheory.Limits.pullback.condition])
    have hCl_V : AlgebraicGeometry.IsClosedImmersion δ_V :=
      hOpensDiag (V_cov a) (V_cov b) δ_V
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    have hδ_V_π : δ_V ≫ πY = θ₁ a b ≫ δ₁_ab := by
      dsimp [δ_V, πY, δ₁_ab, v_fst, v_snd]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, ← Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, hθ₁_fst a b]
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, hθ₁_snd a b]
    have hδ_V_p : δ_V ≫ pY_V = v_fst a b ≫ (V_cov a).ι ≫ g_V := by
      dsimp [δ_V, pY_V]; rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
    obtain ⟨i_c, hi_c⟩ := hClosedDescent
      (O₁ a b).toScheme Y₁ ((O₁ a b).ι ≫ p₁ a) pY₁ δ₁_ab hδ₁_p
      (V_ov a b) Y_V (v_fst a b ≫ (V_cov a).ι ≫ g_V) pY_V (θ₁ a b) πY
      (hPbθ₁_S a b) hPbY_V δ_V hδ_V_π hδ_V_p hCl_V
    refine ⟨i_c, fun i hu => ?_⟩
    let prY_i : CategoryTheory.Limits.pullback (p_i i a) (p_i i b) ⟶ Y₁ :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (p_i i a) (p_i i b) ≫ pr_U i a)
        (CategoryTheory.Limits.pullback.snd (p_i i a) (p_i i b) ≫ pr_U i b)
        (by
          calc
            (CategoryTheory.Limits.pullback.fst (p_i i a) (p_i i b) ≫ pr_U i a) ≫ p₁ a
              = CategoryTheory.Limits.pullback.fst (p_i i a) (p_i i b) ≫ p_i i a ≫ f_i i := by
                  rw [Category.assoc, (hPbU_i i a).w]
            _ = CategoryTheory.Limits.pullback.snd (p_i i a) (p_i i b) ≫ p_i i b ≫ f_i i := by
                  rw [← Category.assoc, CategoryTheory.Limits.pullback.condition, Category.assoc]
            _ = (CategoryTheory.Limits.pullback.snd (p_i i a) (p_i i b) ≫ pr_U i b) ≫ p₁ b := by
                  rw [← (hPbU_i i b).w, Category.assoc])
    have hPbY_i : CategoryTheory.IsPullback prY_i
        (CategoryTheory.Limits.pullback.fst (p_i i a) (p_i i b) ≫ p_i i a) pY₁ (f_i i) :=
      hFiberPb (p₁ a) (p₁ b) (f_i i) (p_i i a) (p_i i b) (pr_U i a) (pr_U i b) prY_i
        (hPbU_i i a) (hPbU_i i b)
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    have hδ_i_pr : δ_i i a b ≫ prY_i = q_i i a b ≫ δ₁_ab := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc
          (δ_i i a b ≫ prY_i) ≫ CategoryTheory.Limits.pullback.fst (p₁ a) (p₁ b)
            = (δ_i i a b ≫ CategoryTheory.Limits.pullback.fst (p_i i a) (p_i i b)) ≫ pr_U i a := by
                dsimp [prY_i]
                rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, ← Category.assoc]
          _ = q_i i a b ≫ (O₁ a b).ι := by
                rw [hδ_fst_i i a b, hq_fac i a b]
          _ = (q_i i a b ≫ δ₁_ab) ≫ CategoryTheory.Limits.pullback.fst (p₁ a) (p₁ b) := by
                dsimp [δ₁_ab]
                rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      · calc
          (δ_i i a b ≫ prY_i) ≫ CategoryTheory.Limits.pullback.snd (p₁ a) (p₁ b)
            = (δ_i i a b ≫ CategoryTheory.Limits.pullback.snd (p_i i a) (p_i i b)) ≫ pr_U i b := by
                dsimp [prY_i]
                rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc]
          _ = t_i i a b ≫ ((O_i i b a).ι ≫ pr_U i b) := by
                rw [hδ_snd_i i a b, Category.assoc]
          _ = (t_i i a b ≫ q_i i b a) ≫ (O₁ b a).ι := by
                rw [← hq_fac i b a, Category.assoc]
          _ = q_i i a b ≫ (t₁ a b ≫ (O₁ b a).ι) := by
                rw [ht_q i a b, Category.assoc]
          _ = (q_i i a b ≫ δ₁_ab) ≫ CategoryTheory.Limits.pullback.snd (p₁ a) (p₁ b) := by
                dsimp [δ₁_ab]
                rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
    have hδ_i_p : δ_i i a b ≫ (CategoryTheory.Limits.pullback.fst (p_i i a) (p_i i b) ≫ p_i i a) =
        (O_i i a b).ι ≫ p_i i a := by
      rw [← Category.assoc, hδ_fst_i i a b]
    exact hi_c i hu (O_i i a b).toScheme (CategoryTheory.Limits.pullback (p_i i a) (p_i i b))
      ((O_i i a b).ι ≫ p_i i a)
      (CategoryTheory.Limits.pullback.fst (p_i i a) (p_i i b) ≫ p_i i a)
      (q_i i a b) prY_i (δ_i i a b)
      (hPbO_S i a b) hPbY_i hδ_i_pr hδ_i_p

  
  let P₁ : J₀ → J₀ → J₀ → AlgebraicGeometry.Scheme.{u} :=
    fun a b c => CategoryTheory.Limits.pullback (O₁ a b).ι (O₁ a c).ι
  let pP₁ : ∀ a b c : J₀, P₁ a b c ⟶ S₁ :=
    fun a b c => CategoryTheory.Limits.pullback.fst (O₁ a b).ι (O₁ a c).ι ≫ (O₁ a b).ι ≫ p₁ a
  have hAffP₁ : ∀ a b c : J₀, AlgebraicGeometry.IsAffine (P₁ a b c) := by
    intro a b c
    have := hAffO₁ a b
    have := hAffO₁ a c
    infer_instance

  let P_i : J → J₀ → J₀ → J₀ → AlgebraicGeometry.Scheme.{u} :=
    fun i a b c => CategoryTheory.Limits.pullback (O_i i a b).ι (O_i i a c).ι
  let pP_i : ∀ (i : J) (a b c : J₀), P_i i a b c ⟶ S_i i :=
    fun i a b c =>
      CategoryTheory.Limits.pullback.fst (O_i i a b).ι (O_i i a c).ι ≫ (O_i i a b).ι ≫ p_i i a
  have hAffP_i : ∀ (i : J) (a b c : J₀), AlgebraicGeometry.IsAffine (P_i i a b c) := by
    intro i a b c
    have := hAffO_i i a b
    have := hAffO_i i a c
    have := hAffU_i i a
    infer_instance
  let r_i : ∀ (i : J) (a b c : J₀), P_i i a b c ⟶ P₁ a b c := fun i a b c =>
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst (O_i i a b).ι (O_i i a c).ι ≫ q_i i a b)
      (CategoryTheory.Limits.pullback.snd (O_i i a b).ι (O_i i a c).ι ≫ q_i i a c)
      (by
        rw [Category.assoc, hq_fac i a b, Category.assoc, hq_fac i a c,
          ← Category.assoc, ← Category.assoc, CategoryTheory.Limits.pullback.condition])
  have hPbP_U : ∀ (i : J) (a b c : J₀),
      CategoryTheory.IsPullback (r_i i a b c)
        (CategoryTheory.Limits.pullback.fst (O_i i a b).ι (O_i i a c).ι ≫ (O_i i a b).ι)
        (CategoryTheory.Limits.pullback.fst (O₁ a b).ι (O₁ a c).ι ≫ (O₁ a b).ι)
        (pr_U i a) :=
    fun i a b c => hFiberPb (O₁ a b).ι (O₁ a c).ι (pr_U i a)
      (O_i i a b).ι (O_i i a c).ι (q_i i a b) (q_i i a c) (r_i i a b c)
      (hPbO_U i a b) (hPbO_U i a c)
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
  have hPbP_S : ∀ (i : J) (a b c : J₀),
      CategoryTheory.IsPullback (r_i i a b c) (pP_i i a b c) (pP₁ a b c) (f_i i) := by
    intro i a b c
    simpa only [pP_i, pP₁, Category.assoc] using (hPbP_U i a b c).paste_vert (hPbU_i i a)
  have hPbQ_O : ∀ (i : J) (b c a : J₀),
      CategoryTheory.IsPullback (r_i i b c a)
        (CategoryTheory.Limits.pullback.snd (O_i i b c).ι (O_i i b a).ι)
        (CategoryTheory.Limits.pullback.snd (O₁ b c).ι (O₁ b a).ι)
        (q_i i b a) := by
    intro i b c a
    refine CategoryTheory.IsPullback.of_bot ?_
      (CategoryTheory.Limits.pullback.lift_snd _ _ _) (hPbO_U i b a)
    have h_base := hPbP_U i b c a
    rw [CategoryTheory.Limits.pullback.condition (f := (O_i i b c).ι) (g := (O_i i b a).ι),
      CategoryTheory.Limits.pullback.condition (f := (O₁ b c).ι) (g := (O₁ b a).ι)] at h_base
    exact h_base

  let η₁ : ∀ a b c : J₀, T_V a b c ⟶ P₁ a b c := fun a b c =>
    CategoryTheory.Limits.pullback.lift
      (tv_fst a b c ≫ θ₁ a b)
      (tv_snd a b c ≫ θ₁ a c)
      (by
        dsimp [tv_fst, tv_snd]
        rw [Category.assoc, hθ₁_fst a b, Category.assoc, hθ₁_fst a c,
          ← Category.assoc, ← Category.assoc,
          CategoryTheory.Limits.pullback.condition (f := v_fst a b) (g := v_fst a c)])
  have hPbT_U : ∀ a b c : J₀,
      CategoryTheory.IsPullback (η₁ a b c)
        (tv_fst a b c ≫ v_fst a b)
        (CategoryTheory.Limits.pullback.fst (O₁ a b).ι (O₁ a c).ι ≫ (O₁ a b).ι)
        (π₁ a) :=
    fun a b c => hFiberPb (O₁ a b).ι (O₁ a c).ι (π₁ a)
      (v_fst a b) (v_fst a c) (θ₁ a b) (θ₁ a c) (η₁ a b c)
      (hPbθ₁ a b) (hPbθ₁ a c)
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
  have hPbT_S : ∀ a b c : J₀,
      CategoryTheory.IsPullback (η₁ a b c)
        (tv_fst a b c ≫ v_fst a b ≫ (V_cov a).ι ≫ g_V)
        (pP₁ a b c) (AlgebraicGeometry.Spec.map β₁) := by
    intro a b c
    simpa only [pP₁, Category.assoc] using (hPbT_U a b c).paste_vert (hPb₁ a)

  have hTripleLift : ∀ a b c : J₀,
      ∃ i_d : J, ∀ i : J, Nonempty (i_d ⟶ i) →
        ∃ t'_i : P_i i a b c ⟶ P_i i b c a,
          t'_i ≫ CategoryTheory.Limits.pullback.snd (O_i i b c).ι (O_i i b a).ι =
            CategoryTheory.Limits.pullback.fst (O_i i a b).ι (O_i i a c).ι ≫ t_i i a b := by
    intro a b c
    have : AlgebraicGeometry.IsAffine (P₁ a b c) := hAffP₁ a b c
    let φ₁ := CategoryTheory.Limits.pullback.fst (O₁ a b).ι (O₁ a c).ι ≫ t₁ a b
    let ι₁ := CategoryTheory.Limits.pullback.snd (O₁ b c).ι (O₁ b a).ι
    have hψ_comm : ψ_V a b c ≫ η₁ b c a ≫ ι₁ = η₁ a b c ≫ φ₁ := by
      calc
        ψ_V a b c ≫ η₁ b c a ≫ ι₁
          = ψ_V a b c ≫ (tv_snd b c a ≫ θ₁ b a) := by
              dsimp [η₁, ι₁]
              rw [CategoryTheory.Limits.pullback.lift_snd]
        _ = (ψ_V a b c ≫ tv_snd b c a) ≫ θ₁ b a := by rw [Category.assoc]
        _ = tv_fst a b c ≫ (v_swap a b ≫ θ₁ b a) := by
              dsimp [ψ_V, tv_snd]
              rw [CategoryTheory.Limits.pullback.lift_snd, Category.assoc]
        _ = (tv_fst a b c ≫ θ₁ a b) ≫ t₁ a b := by
              rw [← hθ₁_symm a b, Category.assoc]
        _ = η₁ a b c ≫ φ₁ := by
              dsimp [η₁, φ₁]
              rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
    obtain ⟨i_d, hi_d⟩ := hOpenLiftDescent
      (P₁ a b c) (P₁ b c a) (O₁ b a).toScheme (pP₁ a b c) φ₁ ι₁
      (T_V a b c) (T_V b c a) (tv_fst a b c ≫ v_fst a b ≫ (V_cov a).ι ≫ g_V)
      (η₁ a b c) (hPbT_S a b c) (η₁ b c a) (ψ_V a b c) hψ_comm
    refine ⟨i_d, fun i hu => ?_⟩
    have hφ_i_comm :
        (CategoryTheory.Limits.pullback.fst (O_i i a b).ι (O_i i a c).ι ≫ t_i i a b) ≫ q_i i b a =
        r_i i a b c ≫ φ₁ := by
      calc
        (CategoryTheory.Limits.pullback.fst (O_i i a b).ι (O_i i a c).ι ≫ t_i i a b) ≫ q_i i b a
          = CategoryTheory.Limits.pullback.fst (O_i i a b).ι (O_i i a c).ι ≫
              (t_i i a b ≫ q_i i b a) := by rw [Category.assoc]
        _ = (CategoryTheory.Limits.pullback.fst (O_i i a b).ι (O_i i a c).ι ≫ q_i i a b) ≫
              t₁ a b := by rw [ht_q i a b, Category.assoc]
        _ = r_i i a b c ≫ φ₁ := by
              dsimp [r_i, φ₁]
              rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
    exact hi_d i hu (P_i i a b c) (P_i i b c a) (O_i i b a).toScheme
      (pP_i i a b c) (r_i i a b c) (r_i i b c a) (q_i i b a)
      (CategoryTheory.Limits.pullback.fst (O_i i a b).ι (O_i i a c).ι ≫ t_i i a b)
      (CategoryTheory.Limits.pullback.snd (O_i i b c).ι (O_i i b a).ι)
      (hPbP_S i a b c) (hPbQ_O i b c a) hφ_i_comm

  
  choose idx_c h_idx_c using hPairClosed
  choose idx_d h_idx_d using hTripleLift
  let S_mid : Finset J :=
    (Finset.univ.image (fun p : J₀ × J₀ => idx_c p.1 p.2)) ∪
    (Finset.univ.image (fun q : J₀ × J₀ × J₀ => idx_d q.1 q.2.1 q.2.2))
  obtain ⟨i_mid, hi_mid⟩ := CategoryTheory.IsFiltered.sup_objs_exists S_mid

  let J_mid := CategoryTheory.Under i_mid
  let R_diag_mid : J_mid ⥤ CommRingCat.{u} := CategoryTheory.Under.forget i_mid ⋙ R_diag
  let α_diag_mid : (CategoryTheory.Functor.const J_mid).obj (R_diag.obj i_mid) ⟶ R_diag_mid :=
    { app := fun w => R_diag.map w.hom
      naturality := fun w₁ w₂ f => by
        dsimp [R_diag_mid]
        rw [Category.id_comp, ← R_diag.map_comp, CategoryTheory.Under.w f] }
  let c_ring : CategoryTheory.Limits.Cocone R_diag := CategoryTheory.Limits.Cocone.mk R_V ι_colim
  obtain ⟨hc_ring⟩ := hColim
  let c_mid : CategoryTheory.Limits.Cocone R_diag_mid := c_ring.whisker (CategoryTheory.Under.forget i_mid)
  have hc_mid : CategoryTheory.Limits.IsColimit c_mid :=
    (CategoryTheory.Functor.Final.isColimitWhiskerEquiv (CategoryTheory.Under.forget i_mid) c_ring).symm hc_ring
  have hα_comp_mid : ∀ w : J_mid, α_diag_mid.app w ≫ c_mid.ι.app w = ι_colim.app i_mid := by
    intro w
    dsimp [α_diag_mid, c_mid, c_ring]
    exact (ι_colim.naturality w.hom).trans (Category.comp_id _)

  have hClosed_w : ∀ (w : J_mid) (a b : J₀), AlgebraicGeometry.IsClosedImmersion (δ_i w.right a b) := by
    intro w a b
    have hmem : idx_c a b ∈ S_mid :=
      Finset.mem_union_left _ (Finset.mem_image.mpr ⟨(a, b), Finset.mem_univ _, rfl⟩)
    obtain ⟨u₀⟩ := hi_mid hmem
    exact h_idx_c a b w.right ⟨u₀ ≫ w.hom⟩

  have hEx_t'_w : ∀ (w : J_mid) (a b c : J₀),
      ∃ t'_w : P_i w.right a b c ⟶ P_i w.right b c a,
        t'_w ≫ CategoryTheory.Limits.pullback.snd (O_i w.right b c).ι (O_i w.right b a).ι =
          CategoryTheory.Limits.pullback.fst (O_i w.right a b).ι (O_i w.right a c).ι ≫
            t_i w.right a b := by
    intro w a b c
    have hmem : idx_d a b c ∈ S_mid :=
      Finset.mem_union_right _ (Finset.mem_image.mpr ⟨(a, b, c), Finset.mem_univ _, rfl⟩)
    obtain ⟨u₀⟩ := hi_mid hmem
    exact h_idx_d a b c w.right ⟨u₀ ≫ w.hom⟩

  choose t'_w ht'_w using hEx_t'_w
  let w_id : J_mid := CategoryTheory.Under.mk (𝟙 i_mid)
  let t'_mid : ∀ a b c : J₀, P_i i_mid a b c ⟶ P_i i_mid b c a :=
    fun a b c => t'_w w_id a b c
  have ht'_mid : ∀ a b c : J₀,
      t'_mid a b c ≫ CategoryTheory.Limits.pullback.snd (O_i i_mid b c).ι (O_i i_mid b a).ι =
        CategoryTheory.Limits.pullback.fst (O_i i_mid a b).ι (O_i i_mid a c).ι ≫ t_i i_mid a b :=
    fun a b c => ht'_w w_id a b c

  
  let τ_w : ∀ w : J_mid, S_i w.right ⟶ S_i i_mid :=
    fun w => AlgebraicGeometry.Spec.map (R_diag.map w.hom)
  have hf_w : ∀ w : J_mid, τ_w w ≫ f_i i_mid = f_i w.right := by
    intro w
    dsimp [τ_w, f_i]
    rw [← AlgebraicGeometry.Spec.map_comp]
    have hnat := α_diag.naturality w.hom
    dsimp at hnat
    rw [Category.id_comp] at hnat
    rw [hnat]

  let prU_w : ∀ (w : J_mid) (a : J₀), U_i w.right a ⟶ U_i i_mid a := fun w a =>
    CategoryTheory.Limits.pullback.lift (pr_U w.right a)
      (p_i w.right a ≫ τ_w w)
      (by rw [(hPbU_i w.right a).w, Category.assoc, hf_w w])
  have hprU_w_pr : ∀ (w : J_mid) (a : J₀), prU_w w a ≫ pr_U i_mid a = pr_U w.right a :=
    fun w a => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hprU_w_p : ∀ (w : J_mid) (a : J₀),
      prU_w w a ≫ p_i i_mid a = p_i w.right a ≫ τ_w w :=
    fun w a => CategoryTheory.Limits.pullback.lift_snd _ _ _

  let q_w : ∀ (w : J_mid) (a b : J₀),
      (O_i w.right a b).toScheme ⟶ (O_i i_mid a b).toScheme := fun w a b =>
    AlgebraicGeometry.IsOpenImmersion.lift (O_i i_mid a b).ι
      ((O_i w.right a b).ι ≫ prU_w w a) (by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨x, rfl⟩
        change (prU_w w a ≫ pr_U i_mid a).base ((O_i w.right a b).ι.base x) ∈ O₁ a b
        rw [hprU_w_pr w a]
        exact x.2)
  have hq_w_fac : ∀ (w : J_mid) (a b : J₀),
      q_w w a b ≫ (O_i i_mid a b).ι = (O_i w.right a b).ι ≫ prU_w w a :=
    fun w a b => AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
  have hq_w_q : ∀ (w : J_mid) (a b : J₀), q_w w a b ≫ q_i i_mid a b = q_i w.right a b := by
    intro w a b
    rw [← cancel_mono (O₁ a b).ι, Category.assoc, hq_fac i_mid a b, ← Category.assoc,
      hq_w_fac w a b, Category.assoc, hprU_w_pr w a, hq_fac w.right a b]
  have ht_q_w : ∀ (w : J_mid) (a b : J₀),
      t_i w.right a b ≫ q_w w b a = q_w w a b ≫ t_i i_mid a b := by
    intro w a b
    apply (hPbO_S i_mid b a).hom_ext
    · rw [Category.assoc, hq_w_q w b a, ht_q w.right a b, Category.assoc, ht_q i_mid a b,
        ← Category.assoc, hq_w_q w a b]
    · calc
        (t_i w.right a b ≫ q_w w b a) ≫ (O_i i_mid b a).ι ≫ p_i i_mid b
          = t_i w.right a b ≫ (q_w w b a ≫ (O_i i_mid b a).ι) ≫ p_i i_mid b := by
              simp only [Category.assoc]
        _ = t_i w.right a b ≫ (O_i w.right b a).ι ≫ (prU_w w b ≫ p_i i_mid b) := by
              rw [hq_w_fac w b a]; simp only [Category.assoc]
        _ = (t_i w.right a b ≫ (O_i w.right b a).ι ≫ p_i w.right b) ≫ τ_w w := by
              rw [hprU_w_p w b]; simp only [Category.assoc]
        _ = (O_i w.right a b).ι ≫ (p_i w.right a ≫ τ_w w) := by
              rw [ht_over_i w.right a b, Category.assoc]
        _ = ((O_i w.right a b).ι ≫ prU_w w a) ≫ p_i i_mid a := by
              rw [← hprU_w_p w a, Category.assoc]
        _ = q_w w a b ≫ ((O_i i_mid a b).ι ≫ p_i i_mid a) := by
              rw [← hq_w_fac w a b, Category.assoc]
        _ = (q_w w a b ≫ t_i i_mid a b) ≫ (O_i i_mid b a).ι ≫ p_i i_mid b := by
              rw [← ht_over_i i_mid a b, Category.assoc]

  let r_w : ∀ (w : J_mid) (a b c : J₀), P_i w.right a b c ⟶ P_i i_mid a b c := fun w a b c =>
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst (O_i w.right a b).ι (O_i w.right a c).ι ≫ q_w w a b)
      (CategoryTheory.Limits.pullback.snd (O_i w.right a b).ι (O_i w.right a c).ι ≫ q_w w a c)
      (by
        rw [Category.assoc, hq_w_fac w a b, Category.assoc, hq_w_fac w a c,
          ← Category.assoc, ← Category.assoc, CategoryTheory.Limits.pullback.condition])
  have hr_w_r : ∀ (w : J_mid) (a b c : J₀),
      r_w w a b c ≫ r_i i_mid a b c = r_i w.right a b c := by
    intro w a b c
    dsimp [r_w, r_i]
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, ← Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst, Category.assoc, hq_w_q w a b,
        CategoryTheory.Limits.pullback.lift_fst]
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc,
        CategoryTheory.Limits.pullback.lift_snd, Category.assoc, hq_w_q w a c,
        CategoryTheory.Limits.pullback.lift_snd]
  have hr_w_p : ∀ (w : J_mid) (a b c : J₀),
      r_w w a b c ≫ pP_i i_mid a b c = pP_i w.right a b c ≫ τ_w w := by
    intro w a b c
    calc
      r_w w a b c ≫ pP_i i_mid a b c
        = (r_w w a b c ≫ CategoryTheory.Limits.pullback.fst (O_i i_mid a b).ι (O_i i_mid a c).ι) ≫
            (O_i i_mid a b).ι ≫ p_i i_mid a := by
              dsimp [pP_i]; simp only [Category.assoc]
      _ = CategoryTheory.Limits.pullback.fst (O_i w.right a b).ι (O_i w.right a c).ι ≫
            (q_w w a b ≫ (O_i i_mid a b).ι) ≫ p_i i_mid a := by
              dsimp [r_w]
              rw [CategoryTheory.Limits.pullback.lift_fst]
              simp only [Category.assoc]
      _ = CategoryTheory.Limits.pullback.fst (O_i w.right a b).ι (O_i w.right a c).ι ≫
            (O_i w.right a b).ι ≫ (prU_w w a ≫ p_i i_mid a) := by
              rw [hq_w_fac w a b]; simp only [Category.assoc]
      _ = pP_i w.right a b c ≫ τ_w w := by
              rw [hprU_w_p w a]; dsimp [pP_i]; simp only [Category.assoc]
  have hPbP_mid : ∀ (w : J_mid) (a b c : J₀),
      CategoryTheory.IsPullback (r_w w a b c) (pP_i w.right a b c)
        (pP_i i_mid a b c) (τ_w w) := by
    intro w a b c
    refine CategoryTheory.IsPullback.of_right ?_ (hr_w_p w a b c) (hPbP_S i_mid a b c)
    rw [hr_w_r w a b c, hf_w w]
    exact hPbP_S w.right a b c

  have ht'_w_over : ∀ (w : J_mid) (a b c : J₀),
      t'_w w a b c ≫ pP_i w.right b c a = pP_i w.right a b c := by
    intro w a b c
    dsimp [pP_i]
    rw [← Category.assoc (CategoryTheory.Limits.pullback.fst _ _),
      CategoryTheory.Limits.pullback.condition (f := (O_i w.right b c).ι) (g := (O_i w.right b a).ι),
      Category.assoc, ← Category.assoc (t'_w w a b c), ht'_w w a b c,
      Category.assoc, ht_over_i w.right a b]

  have ht'_w_nat : ∀ (w : J_mid) (a b c : J₀),
      t'_w w a b c ≫ r_w w b c a = r_w w a b c ≫ t'_mid a b c := by
    intro w a b c
    have : AlgebraicGeometry.IsOpenImmersion
        (CategoryTheory.Limits.pullback.snd (O_i i_mid b c).ι (O_i i_mid b a).ι) := inferInstance
    rw [← cancel_mono (CategoryTheory.Limits.pullback.snd (O_i i_mid b c).ι (O_i i_mid b a).ι)]
    calc
      (t'_w w a b c ≫ r_w w b c a) ≫
          CategoryTheory.Limits.pullback.snd (O_i i_mid b c).ι (O_i i_mid b a).ι
        = t'_w w a b c ≫
            (r_w w b c a ≫ CategoryTheory.Limits.pullback.snd (O_i i_mid b c).ι (O_i i_mid b a).ι) := by
              rw [Category.assoc]
      _ = (t'_w w a b c ≫ CategoryTheory.Limits.pullback.snd (O_i w.right b c).ι (O_i w.right b a).ι) ≫
            q_w w b a := by
              dsimp [r_w]
              rw [CategoryTheory.Limits.pullback.lift_snd, Category.assoc]
      _ = CategoryTheory.Limits.pullback.fst (O_i w.right a b).ι (O_i w.right a c).ι ≫
            (t_i w.right a b ≫ q_w w b a) := by
              rw [ht'_w w a b c, Category.assoc]
      _ = (CategoryTheory.Limits.pullback.fst (O_i w.right a b).ι (O_i w.right a c).ι ≫ q_w w a b) ≫
            t_i i_mid a b := by
              rw [ht_q_w w a b, Category.assoc]
      _ = (r_w w a b c ≫ CategoryTheory.Limits.pullback.fst (O_i i_mid a b).ι (O_i i_mid a c).ι) ≫
            t_i i_mid a b := by
              dsimp [r_w]
              rw [CategoryTheory.Limits.pullback.lift_fst]
      _ = (r_w w a b c ≫ t'_mid a b c) ≫
            CategoryTheory.Limits.pullback.snd (O_i i_mid b c).ι (O_i i_mid b a).ι := by
              rw [Category.assoc, ← ht'_mid a b c, Category.assoc]

  let η_mid : ∀ a b c : J₀, T_V a b c ⟶ P_i i_mid a b c := fun a b c =>
    CategoryTheory.Limits.pullback.lift
      (tv_fst a b c ≫ θ_i i_mid a b)
      (tv_snd a b c ≫ θ_i i_mid a c)
      (by
        dsimp [tv_fst, tv_snd]
        rw [Category.assoc, hθ_fst_i i_mid a b, Category.assoc, hθ_fst_i i_mid a c,
          ← Category.assoc, ← Category.assoc,
          CategoryTheory.Limits.pullback.condition (f := v_fst a b) (g := v_fst a c)])
  have hη_mid_r : ∀ a b c : J₀, η_mid a b c ≫ r_i i_mid a b c = η₁ a b c := by
    intro a b c
    dsimp [η_mid, r_i, η₁]
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, ← Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst, Category.assoc, hθ_q i_mid a b,
        CategoryTheory.Limits.pullback.lift_fst]
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc,
        CategoryTheory.Limits.pullback.lift_snd, Category.assoc, hθ_q i_mid a c,
        CategoryTheory.Limits.pullback.lift_snd]
  have hη_mid_p : ∀ a b c : J₀,
      η_mid a b c ≫ pP_i i_mid a b c =
        (tv_fst a b c ≫ v_fst a b ≫ (V_cov a).ι ≫ g_V) ≫ ρ_i i_mid := by
    intro a b c
    calc
      η_mid a b c ≫ pP_i i_mid a b c
        = (η_mid a b c ≫ CategoryTheory.Limits.pullback.fst (O_i i_mid a b).ι (O_i i_mid a c).ι) ≫
            (O_i i_mid a b).ι ≫ p_i i_mid a := by
              dsimp [pP_i]; simp only [Category.assoc]
      _ = tv_fst a b c ≫ (θ_i i_mid a b ≫ (O_i i_mid a b).ι) ≫ p_i i_mid a := by
              dsimp [η_mid]
              rw [CategoryTheory.Limits.pullback.lift_fst]
              simp only [Category.assoc]
      _ = tv_fst a b c ≫ v_fst a b ≫ (π_i i_mid a ≫ p_i i_mid a) := by
              rw [hθ_fst_i i_mid a b]
              dsimp [v_fst]
              simp only [Category.assoc]
      _ = (tv_fst a b c ≫ v_fst a b ≫ (V_cov a).ι ≫ g_V) ≫ ρ_i i_mid := by
              rw [hπ_p i_mid a]; simp only [Category.assoc]
  have hPbT_mid : ∀ a b c : J₀,
      CategoryTheory.IsPullback (η_mid a b c)
        (tv_fst a b c ≫ v_fst a b ≫ (V_cov a).ι ≫ g_V)
        (pP_i i_mid a b c) (ρ_i i_mid) := by
    intro a b c
    refine CategoryTheory.IsPullback.of_right ?_ (hη_mid_p a b c) (hPbP_S i_mid a b c)
    rw [hη_mid_r a b c, hρf i_mid]
    exact hPbT_S a b c

  have hη_t'_mid : ∀ a b c : J₀,
      η_mid a b c ≫ t'_mid a b c = ψ_V a b c ≫ η_mid b c a := by
    intro a b c
    have : AlgebraicGeometry.IsOpenImmersion
        (CategoryTheory.Limits.pullback.snd (O_i i_mid b c).ι (O_i i_mid b a).ι) := inferInstance
    rw [← cancel_mono (CategoryTheory.Limits.pullback.snd (O_i i_mid b c).ι (O_i i_mid b a).ι)]
    calc
      (η_mid a b c ≫ t'_mid a b c) ≫
          CategoryTheory.Limits.pullback.snd (O_i i_mid b c).ι (O_i i_mid b a).ι
        = (η_mid a b c ≫ CategoryTheory.Limits.pullback.fst (O_i i_mid a b).ι (O_i i_mid a c).ι) ≫
            t_i i_mid a b := by
              rw [Category.assoc, ht'_mid a b c, Category.assoc]
      _ = tv_fst a b c ≫ (θ_i i_mid a b ≫ t_i i_mid a b) := by
              dsimp [η_mid]
              rw [CategoryTheory.Limits.pullback.lift_fst, Category.assoc]
      _ = (tv_fst a b c ≫ v_swap a b) ≫ θ_i i_mid b a := by
              rw [hθ_symm_i i_mid a b, Category.assoc]
      _ = (ψ_V a b c ≫ tv_snd b c a) ≫ θ_i i_mid b a := by
              dsimp [ψ_V, tv_snd]
              rw [CategoryTheory.Limits.pullback.lift_snd]
      _ = (ψ_V a b c ≫ η_mid b c a) ≫
            CategoryTheory.Limits.pullback.snd (O_i i_mid b c).ι (O_i i_mid b a).ι := by
              dsimp [η_mid]
              rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.lift_snd]

  
  let Φ_w : ∀ (w : J_mid) (a b c : J₀), P_i w.right a b c ⟶ P_i w.right a b c :=
    fun w a b c => t'_w w a b c ≫ (t'_w w b c a ≫ t'_w w c a b)
  let Φ_mid : ∀ a b c : J₀, P_i i_mid a b c ⟶ P_i i_mid a b c :=
    fun a b c => Φ_w w_id a b c

  have hΦ_w_p : ∀ (w : J_mid) (a b c : J₀),
      Φ_w w a b c ≫ pP_i w.right a b c = pP_i w.right a b c := by
    intro w a b c
    calc
      (t'_w w a b c ≫ (t'_w w b c a ≫ t'_w w c a b)) ≫ pP_i w.right a b c
        = t'_w w a b c ≫ t'_w w b c a ≫ (t'_w w c a b ≫ pP_i w.right a b c) := by
            simp only [Category.assoc]
      _ = t'_w w a b c ≫ (t'_w w b c a ≫ pP_i w.right c a b) := by
            rw [ht'_w_over w c a b]
      _ = t'_w w a b c ≫ pP_i w.right b c a := by
            rw [ht'_w_over w b c a]
      _ = pP_i w.right a b c := ht'_w_over w a b c

  have hCocycPerTriple : ∀ a b c : J₀,
      ∃ w_c : J_mid, ∀ w : J_mid, Nonempty (w_c ⟶ w) → Φ_w w a b c = 𝟙 _ := by
    intro a b c
    have : AlgebraicGeometry.IsAffine (P_i i_mid a b c) := hAffP_i i_mid a b c
    have : AlgebraicGeometry.LocallyOfFinitePresentation (p_i i_mid a) := hLFP_i i_mid a
    have : AlgebraicGeometry.IsOpenImmersion
        (CategoryTheory.Limits.pullback.fst (O_i i_mid a b).ι (O_i i_mid a c).ι) := inferInstance
    have : AlgebraicGeometry.LocallyOfFiniteType (pP_i i_mid a b c) := by
      dsimp [pP_i]; infer_instance
    have hΦ_mid_p : Φ_mid a b c ≫ pP_i i_mid a b c = pP_i i_mid a b c :=
      hΦ_w_p w_id a b c
    have hη_Φ : η_mid a b c ≫ Φ_mid a b c = η_mid a b c ≫ 𝟙 _ := by
      calc
        η_mid a b c ≫ (t'_mid a b c ≫ (t'_mid b c a ≫ t'_mid c a b))
          = (η_mid a b c ≫ t'_mid a b c) ≫ (t'_mid b c a ≫ t'_mid c a b) := by
              rw [← Category.assoc]
        _ = ψ_V a b c ≫ (η_mid b c a ≫ t'_mid b c a) ≫ t'_mid c a b := by
              rw [hη_t'_mid a b c]; simp only [Category.assoc]
        _ = ψ_V a b c ≫ ψ_V b c a ≫ (η_mid c a b ≫ t'_mid c a b) := by
              rw [hη_t'_mid b c a]; simp only [Category.assoc]
        _ = (ψ_V a b c ≫ (ψ_V b c a ≫ ψ_V c a b)) ≫ η_mid a b c := by
              rw [hη_t'_mid c a b]; simp only [Category.assoc]
        _ = η_mid a b c ≫ 𝟙 _ := by
              rw [hψ_cocyc a b c, Category.id_comp, Category.comp_id]
    obtain ⟨w_c, hw_c⟩ := hHomEqDescent
      (ι_colim.app i_mid) R_diag_mid α_diag_mid c_mid.ι hc_mid hα_comp_mid
      (P_i i_mid a b c) (P_i i_mid a b c) (pP_i i_mid a b c) (pP_i i_mid a b c)
      (Φ_mid a b c) (𝟙 _) hΦ_mid_p (Category.id_comp _)
      (T_V a b c) (tv_fst a b c ≫ v_fst a b ≫ (V_cov a).ι ≫ g_V) (η_mid a b c)
      (hPbT_mid a b c) hη_Φ
    dsimp [R_diag_mid, α_diag_mid] at hw_c
    refine ⟨w_c, fun w hw => ?_⟩
    have hΦ_w_r : Φ_w w a b c ≫ r_w w a b c = r_w w a b c ≫ Φ_mid a b c := by
      calc
        (t'_w w a b c ≫ (t'_w w b c a ≫ t'_w w c a b)) ≫ r_w w a b c
          = t'_w w a b c ≫ t'_w w b c a ≫ (t'_w w c a b ≫ r_w w a b c) := by
              simp only [Category.assoc]
        _ = t'_w w a b c ≫ (t'_w w b c a ≫ r_w w c a b) ≫ t'_mid c a b := by
              rw [ht'_w_nat w c a b]; simp only [Category.assoc]
        _ = (t'_w w a b c ≫ r_w w b c a) ≫ t'_mid b c a ≫ t'_mid c a b := by
              rw [ht'_w_nat w b c a]; simp only [Category.assoc]
        _ = r_w w a b c ≫ (t'_mid a b c ≫ (t'_mid b c a ≫ t'_mid c a b)) := by
              rw [ht'_w_nat w a b c]; simp only [Category.assoc]
    exact hw_c w hw (P_i w.right a b c) (P_i w.right a b c)
      (pP_i w.right a b c) (pP_i w.right a b c)
      (r_w w a b c) (r_w w a b c) (Φ_w w a b c) (𝟙 _)
      (hPbP_mid w a b c) (hPbP_mid w a b c)
      hΦ_w_r (hΦ_w_p w a b c)
      (by rw [Category.id_comp, Category.comp_id]) (Category.id_comp _)

  choose idx_cocyc h_idx_cocyc using hCocycPerTriple
  let S_cocyc : Finset J_mid :=
    Finset.univ.image (fun q : J₀ × J₀ × J₀ => idx_cocyc q.1 q.2.1 q.2.2)
  obtain ⟨w₀, hw₀⟩ := CategoryTheory.IsFiltered.sup_objs_exists S_cocyc

  let i₀ : J := w₀.right
  refine ⟨i₀, U_i i₀, hAffU_i i₀, p_i i₀, π_i i₀, O_i i₀, t_i i₀, t'_w w₀, δ_i i₀, θ_i i₀,
    hLFP_i i₀, hPbπ_i i₀, hO_diag_i i₀, hO_pre_i i₀, ht_id_i i₀, ht_over_i i₀,
    ht'_w w₀, ?_, hδ_fst_i i₀, hδ_snd_i i₀, hClosed_w w₀, hθ_fst_i i₀, hθ_snd_i i₀⟩
  intro a b c
  have hmem : idx_cocyc a b c ∈ S_cocyc :=
    Finset.mem_image.mpr ⟨(a, b, c), Finset.mem_univ _, rfl⟩
  exact h_idx_cocyc a b c w₀ (hw₀ hmem)

theorem weil_glued_separated_scheme_from_blueprint (S_V S₀ : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine S₀]
    (ρ₀ : S_V ⟶ S₀)
    (C_V : AlgebraicGeometry.Scheme.{u})
    (g_V : C_V ⟶ S_V)
    (J₀ : Type u) [Finite J₀]
    (V_cov : J₀ → C_V.Opens)
    (hCov : TopologicalSpace.IsOpenCover V_cov)
    (U₀ : J₀ → AlgebraicGeometry.Scheme.{u})
    [∀ a : J₀, AlgebraicGeometry.IsAffine (U₀ a)]
    (p₀ : ∀ a : J₀, U₀ a ⟶ S₀)
    (hLFP₀ : ∀ a : J₀, AlgebraicGeometry.LocallyOfFinitePresentation (p₀ a))
    (π_V : ∀ a : J₀, (V_cov a).toScheme ⟶ U₀ a)
    (hPb_chart : ∀ a : J₀, CategoryTheory.IsPullback (π_V a) ((V_cov a).ι ≫ g_V) (p₀ a) ρ₀)
    (O₀ : ∀ a b : J₀, (U₀ a).Opens)
    (hO_diag : ∀ a : J₀, O₀ a a = ⊤)
    (hO_pre : ∀ a b : J₀,
      (TopologicalSpace.Opens.map (π_V a).base).obj (O₀ a b) =
        (TopologicalSpace.Opens.map (V_cov a).ι.base).obj (V_cov b))
    (t₀ : ∀ a b : J₀, (O₀ a b).toScheme ⟶ (O₀ b a).toScheme)
    (ht_id : ∀ a : J₀, t₀ a a = 𝟙 _)
    (ht_over : ∀ a b : J₀, t₀ a b ≫ (O₀ b a).ι ≫ p₀ b = (O₀ a b).ι ≫ p₀ a)
    (t'₀ : ∀ a b c : J₀,
      CategoryTheory.Limits.pullback (O₀ a b).ι (O₀ a c).ι ⟶
        CategoryTheory.Limits.pullback (O₀ b c).ι (O₀ b a).ι)
    (ht'_fac : ∀ a b c : J₀,
      t'₀ a b c ≫ CategoryTheory.Limits.pullback.snd (O₀ b c).ι (O₀ b a).ι =
        CategoryTheory.Limits.pullback.fst (O₀ a b).ι (O₀ a c).ι ≫ t₀ a b)
    (hcocycle : ∀ a b c : J₀, t'₀ a b c ≫ (t'₀ b c a ≫ t'₀ c a b) = 𝟙 _)
    (δ₀ : ∀ a b : J₀, (O₀ a b).toScheme ⟶ CategoryTheory.Limits.pullback (p₀ a) (p₀ b))
    (hδ_fst : ∀ a b : J₀, δ₀ a b ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b) = (O₀ a b).ι)
    (hδ_snd : ∀ a b : J₀, δ₀ a b ≫ CategoryTheory.Limits.pullback.snd (p₀ a) (p₀ b) = t₀ a b ≫ (O₀ b a).ι)
    (hδ_cl : ∀ a b : J₀, AlgebraicGeometry.IsClosedImmersion (δ₀ a b))
    (θ_V : ∀ a b : J₀, CategoryTheory.Limits.pullback (V_cov a).ι (V_cov b).ι ⟶ (O₀ a b).toScheme)
    (hθ_fst : ∀ a b : J₀, θ_V a b ≫ (O₀ a b).ι =
      CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_V a)
    (hθ_snd : ∀ a b : J₀, θ_V a b ≫ t₀ a b ≫ (O₀ b a).ι =
      CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π_V b) :
    ∃ (C₀ : AlgebraicGeometry.Scheme.{u})
      (g₀ : C₀ ⟶ S₀)
      (ι₀ : C_V ⟶ C₀),
      AlgebraicGeometry.QuasiCompact g₀ ∧
      AlgebraicGeometry.IsSeparated g₀ ∧
      AlgebraicGeometry.LocallyOfFinitePresentation g₀ ∧
      CategoryTheory.IsPullback ι₀ g_V g₀ ρ₀ :=
by
  have f_id : ∀ a : J₀, CategoryTheory.IsIso (O₀ a a).ι := by
    intro a
    have hRange : Set.range ⇑(O₀ a a).ι = Set.range ⇑(𝟙 (U₀ a) : U₀ a ⟶ U₀ a) := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι, hO_diag a]
      ext x
      simp
    have hfac :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac (O₀ a a).ι (𝟙 (U₀ a)) hRange
    rw [CategoryTheory.Category.comp_id] at hfac
    rw [← hfac]
    infer_instance

  let G : AlgebraicGeometry.Scheme.GlueData.{u} :=
    AlgebraicGeometry.Scheme.GlueData.mk
      { J := J₀
        U := U₀
        V := fun p => (O₀ p.1 p.2).toScheme
        f := fun a b => (O₀ a b).ι
        f_mono := fun a b => inferInstance
        f_hasPullback := fun a b c => inferInstance
        f_id := f_id
        t := t₀
        t_id := ht_id
        t' := t'₀
        t_fac := ht'_fac
        cocycle := hcocycle }
      (fun a b => inferInstance)
  let C₀ : AlgebraicGeometry.Scheme.{u} := G.glued
  let ι_G : ∀ a : J₀, U₀ a ⟶ C₀ := fun a => G.ι a
  have hι_open : ∀ a : J₀, AlgebraicGeometry.IsOpenImmersion (ι_G a) :=
    fun a =>
      (fun (D : AlgebraicGeometry.Scheme.GlueData.{u}) (i : D.J) =>
        (inferInstance : AlgebraicGeometry.IsOpenImmersion (D.ι i))) G a
  have hglue : ∀ a b : J₀, t₀ a b ≫ (O₀ b a).ι ≫ ι_G b = (O₀ a b).ι ≫ ι_G a :=
    fun a b => G.glue_condition a b

  have hHasMulticoeq : CategoryTheory.Limits.HasMulticoequalizer G.toGlueData.diagram :=
    (fun (D : AlgebraicGeometry.Scheme.GlueData.{u}) =>
      (inferInstance : CategoryTheory.Limits.HasMulticoequalizer D.toGlueData.diagram)) G
  have hg₀_cond : ∀ p : G.J × G.J,
      G.toGlueData.diagram.fst p ≫ p₀ p.1 = G.toGlueData.diagram.snd p ≫ p₀ p.2 := by
    rintro (⟨a, b⟩ : J₀ × J₀)
    change (O₀ a b).ι ≫ p₀ a = (t₀ a b ≫ (O₀ b a).ι) ≫ p₀ b
    rw [CategoryTheory.Category.assoc, ht_over a b]
  let g₀ : C₀ ⟶ S₀ :=
    @CategoryTheory.Limits.Multicoequalizer.desc _ _ _ G.toGlueData.diagram hHasMulticoeq S₀
      (fun (a : G.J) => p₀ a) hg₀_cond
  have hg₀ : ∀ a : J₀, ι_G a ≫ g₀ = p₀ a := fun a =>
    @CategoryTheory.Limits.Multicoequalizer.π_desc _ _ _ G.toGlueData.diagram hHasMulticoeq S₀
      (fun (b : G.J) => p₀ b) hg₀_cond a

  have hQC₀ : AlgebraicGeometry.QuasiCompact g₀ := by
    have : Finite G.openCover.I₀ := ‹Finite J₀›
    have : ∀ a : G.openCover.I₀, CompactSpace ↥(G.openCover.X a) :=
      fun (a : J₀) => (inferInstance : CompactSpace ↥(U₀ a))
    have : CompactSpace ↥C₀ := AlgebraicGeometry.Scheme.OpenCover.compactSpace G.openCover
    infer_instance

  have hLFP₀' : AlgebraicGeometry.LocallyOfFinitePresentation g₀ := by
    have : AlgebraicGeometry.IsZariskiLocalAtSource
        @AlgebraicGeometry.LocallyOfFinitePresentation.{u} :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        (Q := fun {R S} [CommRing R] [CommRing S] => RingHom.FinitePresentation)
    refine AlgebraicGeometry.IsZariskiLocalAtSource.of_openCover G.openCover (fun (a : J₀) => ?_)
    change AlgebraicGeometry.LocallyOfFinitePresentation (ι_G a ≫ g₀)
    rw [hg₀ a]
    exact hLFP₀ a

  have hSep₀ : AlgebraicGeometry.IsSeparated g₀ := by
    refine ⟨?_⟩
    let Δ := CategoryTheory.Limits.pullback.diagonal g₀
    let 𝒰₂ := AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight
      G.openCover G.openCover g₀ g₀
    refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_openCover 𝒰₂ ?_
    rintro (⟨a, b⟩ : J₀ × J₀)
    let P_ab : AlgebraicGeometry.Scheme.{u} :=
      CategoryTheory.Limits.pullback (ι_G a ≫ g₀) (ι_G b ≫ g₀)
    let f_ab : P_ab ⟶ CategoryTheory.Limits.pullback g₀ g₀ := 𝒰₂.f (a, b)
    change AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.snd Δ f_ab)
    have hf_ab_fst : f_ab ≫ CategoryTheory.Limits.pullback.fst g₀ g₀ =
        CategoryTheory.Limits.pullback.fst (ι_G a ≫ g₀) (ι_G b ≫ g₀) ≫ ι_G a := by
      dsimp [f_ab, 𝒰₂]
      rw [AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f]
      exact CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hf_ab_snd : f_ab ≫ CategoryTheory.Limits.pullback.snd g₀ g₀ =
        CategoryTheory.Limits.pullback.snd (ι_G a ≫ g₀) (ι_G b ≫ g₀) ≫ ι_G b := by
      dsimp [f_ab, 𝒰₂]
      rw [AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f]
      exact CategoryTheory.Limits.pullback.lift_snd _ _ _
    let e_ab : CategoryTheory.Limits.pullback (p₀ a) (p₀ b) ≅ P_ab :=
      CategoryTheory.Limits.pullback.congrHom (hg₀ a).symm (hg₀ b).symm
    have he_hom_fst : e_ab.hom ≫ CategoryTheory.Limits.pullback.fst (ι_G a ≫ g₀) (ι_G b ≫ g₀) =
        CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b) := by
      dsimp [e_ab]
      rw [CategoryTheory.Limits.pullback.congrHom_hom,
        CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
    have he_hom_snd : e_ab.hom ≫ CategoryTheory.Limits.pullback.snd (ι_G a ≫ g₀) (ι_G b ≫ g₀) =
        CategoryTheory.Limits.pullback.snd (p₀ a) (p₀ b) := by
      dsimp [e_ab]
      rw [CategoryTheory.Limits.pullback.congrHom_hom,
        CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
    have he_inv_fst : e_ab.inv ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b) =
        CategoryTheory.Limits.pullback.fst (ι_G a ≫ g₀) (ι_G b ≫ g₀) := by
      dsimp [e_ab]
      rw [CategoryTheory.Limits.pullback.congrHom_inv,
        CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
    have he_inv_snd : e_ab.inv ≫ CategoryTheory.Limits.pullback.snd (p₀ a) (p₀ b) =
        CategoryTheory.Limits.pullback.snd (ι_G a ≫ g₀) (ι_G b ≫ g₀) := by
      dsimp [e_ab]
      rw [CategoryTheory.Limits.pullback.congrHom_inv,
        CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
    have hsq_comm : ((O₀ a b).ι ≫ ι_G a) ≫ Δ = (δ₀ a b ≫ e_ab.hom) ≫ f_ab := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc
          (((O₀ a b).ι ≫ ι_G a) ≫ Δ) ≫ CategoryTheory.Limits.pullback.fst g₀ g₀
            = ((O₀ a b).ι ≫ ι_G a) ≫ (Δ ≫ CategoryTheory.Limits.pullback.fst g₀ g₀) := by
                rw [CategoryTheory.Category.assoc]
          _ = (O₀ a b).ι ≫ ι_G a := by
                rw [CategoryTheory.Limits.pullback.diagonal_fst, CategoryTheory.Category.comp_id]
          _ = (δ₀ a b ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b)) ≫ ι_G a := by
                rw [hδ_fst a b]
          _ = (δ₀ a b ≫ (e_ab.hom ≫
                CategoryTheory.Limits.pullback.fst (ι_G a ≫ g₀) (ι_G b ≫ g₀))) ≫ ι_G a := by
                rw [he_hom_fst]
          _ = δ₀ a b ≫ e_ab.hom ≫ (f_ab ≫ CategoryTheory.Limits.pullback.fst g₀ g₀) := by
                rw [hf_ab_fst]
                simp only [CategoryTheory.Category.assoc]
          _ = ((δ₀ a b ≫ e_ab.hom) ≫ f_ab) ≫ CategoryTheory.Limits.pullback.fst g₀ g₀ := by
                simp only [CategoryTheory.Category.assoc]
      · calc
          (((O₀ a b).ι ≫ ι_G a) ≫ Δ) ≫ CategoryTheory.Limits.pullback.snd g₀ g₀
            = ((O₀ a b).ι ≫ ι_G a) ≫ (Δ ≫ CategoryTheory.Limits.pullback.snd g₀ g₀) := by
                rw [CategoryTheory.Category.assoc]
          _ = (O₀ a b).ι ≫ ι_G a := by
                rw [CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id]
          _ = t₀ a b ≫ (O₀ b a).ι ≫ ι_G b := (hglue a b).symm
          _ = (t₀ a b ≫ (O₀ b a).ι) ≫ ι_G b := by rw [CategoryTheory.Category.assoc]
          _ = (δ₀ a b ≫ CategoryTheory.Limits.pullback.snd (p₀ a) (p₀ b)) ≫ ι_G b := by
                rw [hδ_snd a b]
          _ = (δ₀ a b ≫ (e_ab.hom ≫
                CategoryTheory.Limits.pullback.snd (ι_G a ≫ g₀) (ι_G b ≫ g₀))) ≫ ι_G b := by
                rw [he_hom_snd]
          _ = δ₀ a b ≫ e_ab.hom ≫ (f_ab ≫ CategoryTheory.Limits.pullback.snd g₀ g₀) := by
                rw [hf_ab_snd]
                simp only [CategoryTheory.Category.assoc]
          _ = ((δ₀ a b ≫ e_ab.hom) ≫ f_ab) ≫ CategoryTheory.Limits.pullback.snd g₀ g₀ := by
                simp only [CategoryTheory.Category.assoc]
    have hcone_eq : ∀ s : CategoryTheory.Limits.PullbackCone Δ f_ab,
        ((s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b)) ≫ ι_G a =
          ((s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.snd (p₀ a) (p₀ b)) ≫ ι_G b ∧
        s.fst = ((s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b)) ≫ ι_G a := by
      intro s
      have h1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst g₀ g₀) s.condition
      simp only [CategoryTheory.Category.assoc, Δ,
        CategoryTheory.Limits.pullback.diagonal_fst, CategoryTheory.Category.comp_id,
        hf_ab_fst] at h1
      have h1' : s.fst =
          ((s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b)) ≫ ι_G a := by
        calc
          s.fst = s.snd ≫ CategoryTheory.Limits.pullback.fst (ι_G a ≫ g₀) (ι_G b ≫ g₀) ≫ ι_G a := h1
          _ = s.snd ≫ (e_ab.inv ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b)) ≫ ι_G a := by
                rw [he_inv_fst]
          _ = ((s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b)) ≫ ι_G a := by
                simp only [CategoryTheory.Category.assoc]
      have h2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd g₀ g₀) s.condition
      simp only [CategoryTheory.Category.assoc, Δ,
        CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id,
        hf_ab_snd] at h2
      have h2' : s.fst =
          ((s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.snd (p₀ a) (p₀ b)) ≫ ι_G b := by
        calc
          s.fst = s.snd ≫ CategoryTheory.Limits.pullback.snd (ι_G a ≫ g₀) (ι_G b ≫ g₀) ≫ ι_G b := h2
          _ = s.snd ≫ (e_ab.inv ≫ CategoryTheory.Limits.pullback.snd (p₀ a) (p₀ b)) ≫ ι_G b := by
                rw [he_inv_snd]
          _ = ((s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.snd (p₀ a) (p₀ b)) ≫ ι_G b := by
                simp only [CategoryTheory.Category.assoc]
      exact ⟨h1'.symm.trans h2', h1'⟩
    let liftPair := fun s : CategoryTheory.Limits.PullbackCone Δ f_ab =>
      CategoryTheory.Limits.PullbackCone.IsLimit.lift' (G.vPullbackConeIsLimit a b)
        ((s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b))
        ((s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.snd (p₀ a) (p₀ b))
        (hcone_eq s).1
    let liftHom : ∀ s : CategoryTheory.Limits.PullbackCone Δ f_ab, s.pt ⟶ (O₀ a b).toScheme :=
      fun s => (liftPair s).1
    have hLim : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.PullbackCone.mk
          ((O₀ a b).ι ≫ ι_G a) (δ₀ a b ≫ e_ab.hom) hsq_comm) := by
      refine CategoryTheory.Limits.PullbackCone.IsLimit.mk hsq_comm liftHom ?_ ?_ ?_
      · intro s
        have hfst : liftHom s ≫ (O₀ a b).ι =
            (s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b) :=
          (liftPair s).2.1
        rw [← CategoryTheory.Category.assoc, hfst, ← (hcone_eq s).2]
      · intro s
        have hfst : liftHom s ≫ (O₀ a b).ι =
            (s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b) :=
          (liftPair s).2.1
        have hsnd : liftHom s ≫ (t₀ a b ≫ (O₀ b a).ι) =
            (s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.snd (p₀ a) (p₀ b) :=
          (liftPair s).2.2
        have hδ_eq : liftHom s ≫ δ₀ a b = s.snd ≫ e_ab.inv := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, hδ_fst a b, hfst]
          · rw [CategoryTheory.Category.assoc, hδ_snd a b, hsnd]
        rw [← CategoryTheory.Category.assoc, hδ_eq, CategoryTheory.Category.assoc,
          e_ab.inv_hom_id, CategoryTheory.Category.comp_id]
      · intro s m _hm1 hm2
        apply (CategoryTheory.cancel_mono (O₀ a b).ι).mp
        have hfst : liftHom s ≫ (O₀ a b).ι =
            (s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b) :=
          (liftPair s).2.1
        have hm_inv : m ≫ δ₀ a b = s.snd ≫ e_ab.inv := by
          calc
            m ≫ δ₀ a b = m ≫ δ₀ a b ≫ (e_ab.hom ≫ e_ab.inv) := by
              rw [e_ab.hom_inv_id, CategoryTheory.Category.comp_id]
            _ = (m ≫ (δ₀ a b ≫ e_ab.hom)) ≫ e_ab.inv := by
              simp only [CategoryTheory.Category.assoc]
            _ = s.snd ≫ e_ab.inv := by rw [hm2]
        calc
          m ≫ (O₀ a b).ι = m ≫ (δ₀ a b ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b)) := by
            rw [hδ_fst a b]
          _ = (m ≫ δ₀ a b) ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b) := by
            rw [CategoryTheory.Category.assoc]
          _ = (s.snd ≫ e_ab.inv) ≫ CategoryTheory.Limits.pullback.fst (p₀ a) (p₀ b) := by
            rw [hm_inv]
          _ = liftHom s ≫ (O₀ a b).ι := hfst.symm
    have hPb_ab : CategoryTheory.IsPullback
        ((O₀ a b).ι ≫ ι_G a) (δ₀ a b ≫ e_ab.hom) Δ f_ab :=
      CategoryTheory.IsPullback.of_isLimit hLim
    rw [← hPb_ab.isoPullback_inv_snd]
    have : AlgebraicGeometry.IsClosedImmersion (δ₀ a b) := hδ_cl a b
    infer_instance

  let 𝒰_V : C_V.OpenCover := C_V.openCoverOfIsOpenCover V_cov hCov
  have hCompat : ∀ a b : 𝒰_V.I₀,
      CategoryTheory.Limits.pullback.fst (𝒰_V.f a) (𝒰_V.f b) ≫ (π_V a ≫ ι_G a) =
        CategoryTheory.Limits.pullback.snd (𝒰_V.f a) (𝒰_V.f b) ≫ (π_V b ≫ ι_G b) := by
    intro (a : J₀) (b : J₀)
    change CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_V a ≫ ι_G a =
      CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π_V b ≫ ι_G b
    calc
      CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_V a ≫ ι_G a
        = (CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov b).ι ≫ π_V a) ≫ ι_G a := by
            rw [CategoryTheory.Category.assoc]
      _ = (θ_V a b ≫ (O₀ a b).ι) ≫ ι_G a := by rw [← hθ_fst a b]
      _ = θ_V a b ≫ ((O₀ a b).ι ≫ ι_G a) := by rw [CategoryTheory.Category.assoc]
      _ = θ_V a b ≫ (t₀ a b ≫ (O₀ b a).ι ≫ ι_G b) := by rw [← hglue a b]
      _ = (θ_V a b ≫ t₀ a b ≫ (O₀ b a).ι) ≫ ι_G b := by
            simp only [CategoryTheory.Category.assoc]
      _ = (CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π_V b) ≫ ι_G b := by
            rw [hθ_snd a b]
      _ = CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov b).ι ≫ π_V b ≫ ι_G b := by
            rw [CategoryTheory.Category.assoc]
  let ι₀ : C_V ⟶ C₀ := 𝒰_V.glueMorphisms (fun (a : J₀) => π_V a ≫ ι_G a) hCompat
  have hι₀ : ∀ a : J₀, (V_cov a).ι ≫ ι₀ = π_V a ≫ ι_G a :=
    fun a => 𝒰_V.ι_glueMorphisms (fun (b : J₀) => π_V b ≫ ι_G b) hCompat a

  have hPb_top : ∀ a : J₀, CategoryTheory.IsPullback (π_V a) (V_cov a).ι (ι_G a) ι₀ := by
    intro a
    have : AlgebraicGeometry.IsOpenImmersion (ι_G a) := hι_open a
    refine AlgebraicGeometry.IsOpenImmersion.isPullback (π_V a) (V_cov a).ι (ι_G a) ι₀
      (hι₀ a) ?_
    rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
    ext x
    change ι₀ x ∈ Set.range ⇑(ι_G a) ↔ x ∈ V_cov a
    constructor
    · rintro ⟨u, hu⟩
      obtain ⟨b, hxb⟩ := hCov.exists_mem x
      have hx_range : x ∈ Set.range ⇑(V_cov b).ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        exact hxb
      obtain ⟨y, rfl⟩ := hx_range
      have h_eq_pt : (G.ι b) (π_V b y) = (G.ι a) u := by
        calc
          (G.ι b) (π_V b y) = (π_V b ≫ ι_G b) y := rfl
          _ = ((V_cov b).ι ≫ ι₀) y := by rw [← hι₀ b]
          _ = ι₀ ((V_cov b).ι y) := rfl
          _ = (G.ι a) u := hu.symm
      obtain ⟨z, hz1, _hz2⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback
          (CategoryTheory.IsPullback.of_isLimit (G.vPullbackConeIsLimit b a))
          (π_V b y) u h_eq_pt
      have hy_O : y ∈ (TopologicalSpace.Opens.map (π_V b).base).obj (O₀ b a) := by
        change (π_V b).base y ∈ O₀ b a
        have hz_mem : (O₀ b a).ι z ∈ O₀ b a := by
          rw [← SetLike.mem_coe, ← AlgebraicGeometry.Scheme.Opens.range_ι]
          exact ⟨z, rfl⟩
        change (O₀ b a).ι z = π_V b y at hz1
        simpa [hz1] using hz_mem
      rw [hO_pre b a] at hy_O
      exact hy_O
    · intro hxa
      have hx_range : x ∈ Set.range ⇑(V_cov a).ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        exact hxa
      obtain ⟨y, rfl⟩ := hx_range
      refine ⟨π_V a y, ?_⟩
      calc
        (ι_G a) (π_V a y) = (π_V a ≫ ι_G a) y := rfl
        _ = ((V_cov a).ι ≫ ι₀) y := by rw [← hι₀ a]
        _ = ι₀ ((V_cov a).ι y) := rfl

  have hPb₀ : CategoryTheory.IsPullback ι₀ g_V g₀ ρ₀ := by
    refine AlgebraicGeometry.Scheme.isPullback_of_openCover ι₀ g_V g₀ ρ₀ G.openCover
      (fun (a : J₀) => ?_)
    change CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.snd ι₀ (ι_G a))
      (CategoryTheory.Limits.pullback.fst ι₀ (ι_G a) ≫ g_V)
      (ι_G a ≫ g₀) ρ₀
    have hPb_a : CategoryTheory.IsPullback (π_V a) ((V_cov a).ι ≫ g_V) (ι_G a ≫ g₀) ρ₀ := by
      rw [hg₀ a]
      exact hPb_chart a
    let hFlip := (hPb_top a).flip
    exact hPb_a.of_iso hFlip.isoPullback (CategoryTheory.Iso.refl _)
      (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
      (by
        dsimp only [CategoryTheory.Iso.refl_hom]
        rw [CategoryTheory.Category.comp_id, hFlip.isoPullback_hom_snd])
      (by
        dsimp only [CategoryTheory.Iso.refl_hom]
        rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc,
          hFlip.isoPullback_hom_fst])
      (by
        dsimp only [CategoryTheory.Iso.refl_hom]
        rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      (by
        dsimp only [CategoryTheory.Iso.refl_hom]
        rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])

  exact ⟨C₀, g₀, ι₀, hQC₀, hSep₀, hLFP₀', hPb₀⟩

theorem weil_localRing_pointed_disjoint_sections_descent (R₀ : CommRingCat.{u})
    (R_V : Type u) [CommRing R_V] [IsLocalRing R_V]
    (β₀ : R₀ ⟶ CommRingCat.of R_V)
    (J : Type u) [CategoryTheory.SmallCategory J] [CategoryTheory.IsFiltered J]
    (R_diag : CategoryTheory.Functor J CommRingCat.{u})
    (α_diag : (CategoryTheory.Functor.const J).obj R₀ ⟶ R_diag)
    (ι_colim : R_diag ⟶ (CategoryTheory.Functor.const J).obj (CommRingCat.of R_V))
    (hColim : Nonempty (CategoryTheory.Limits.IsColimit
      (CategoryTheory.Limits.Cocone.mk (CommRingCat.of R_V) ι_colim)))
    (hα_comp : ∀ i : J, α_diag.app i ≫ ι_colim.app i = β₀)
    (n : ℕ) (hn : 3 ≤ n)
    (C₀ : AlgebraicGeometry.Scheme.{u})
    (g₀ : C₀ ⟶ AlgebraicGeometry.Spec R₀)
    (hSep₀ : AlgebraicGeometry.IsSeparated g₀)
    (hLFP₀ : AlgebraicGeometry.LocallyOfFinitePresentation g₀)
    (C_V : AlgebraicGeometry.Scheme.{u})
    (g_V : C_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_V))
    (τ_V : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R_V) ⟶ C_V))
    (hSecV : ∀ j : Fin n, τ_V j ≫ g_V = 𝟙 _)
    (hDisjV : _root_.Pairwise fun j₁ j₂ : Fin n =>
      Disjoint (Set.range (τ_V j₁).base) (Set.range (τ_V j₂).base))
    (ι₀ : C_V ⟶ C₀)
    (hPb₀ : CategoryTheory.IsPullback ι₀ g_V g₀ (AlgebraicGeometry.Spec.map β₀)) :
    ∃ (i₁ : J)
      (τ₁ : Fin n → (AlgebraicGeometry.Spec (R_diag.obj i₁) ⟶
        CategoryTheory.Limits.pullback g₀ (AlgebraicGeometry.Spec.map (α_diag.app i₁))))
      (ι₁ : C_V ⟶ CategoryTheory.Limits.pullback g₀ (AlgebraicGeometry.Spec.map (α_diag.app i₁))),
      AlgebraicGeometry.Surjective
        (CategoryTheory.Limits.pullback.snd g₀ (AlgebraicGeometry.Spec.map (α_diag.app i₁))) ∧
      (∀ j : Fin n, τ₁ j ≫
        CategoryTheory.Limits.pullback.snd g₀ (AlgebraicGeometry.Spec.map (α_diag.app i₁)) = 𝟙 _) ∧
      (_root_.Pairwise fun j₁ j₂ : Fin n =>
        Disjoint (Set.range (τ₁ j₁).base) (Set.range (τ₁ j₂).base)) ∧
      CategoryTheory.IsPullback ι₁ g_V
        (CategoryTheory.Limits.pullback.snd g₀ (AlgebraicGeometry.Spec.map (α_diag.app i₁)))
        (AlgebraicGeometry.Spec.map (ι_colim.app i₁)) ∧
      (∀ j : Fin n, τ_V j ≫ ι₁ = AlgebraicGeometry.Spec.map (ι_colim.app i₁) ≫ τ₁ j) :=
by
  obtain ⟨hc_R⟩ := hColim
  let c_R : CategoryTheory.Limits.Cocone R_diag :=
    CategoryTheory.Limits.Cocone.mk (CommRingCat.of R_V) ι_colim

  
  have hSingleLift :
      ∀ (ψ : AlgebraicGeometry.Spec (CommRingCat.of R_V) ⟶ C₀),
        ψ ≫ g₀ = AlgebraicGeometry.Spec.map β₀ →
        ∃ (i₀ : J) (φ₀ : AlgebraicGeometry.Spec (R_diag.obj i₀) ⟶ C₀),
          φ₀ ≫ g₀ = AlgebraicGeometry.Spec.map (α_diag.app i₀) ∧
          AlgebraicGeometry.Spec.map (ι_colim.app i₀) ≫ φ₀ = ψ := by
    intro ψ hψ
    have : AlgebraicGeometry.LocallyOfFinitePresentation g₀ := hLFP₀
    let b_max : ↥(AlgebraicGeometry.Spec (CommRingCat.of R_V)) :=
      IsLocalRing.closedPoint R_V
    obtain ⟨U, hU_mem, hb_mem, _⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp C₀.isBasis_affineOpens)
        (TopologicalSpace.Opens.mem_top (ψ.base b_max))
    have hU : AlgebraicGeometry.IsAffineOpen U := hU_mem
    let V_pre : (AlgebraicGeometry.Spec (CommRingCat.of R_V)).Opens :=
      (TopologicalSpace.Opens.map ψ.base).obj U
    have hb_pre : IsLocalRing.closedPoint R_V ∈ V_pre := hb_mem
    have hV_top : V_pre = ⊤ := (IsLocalRing.closedPoint_mem_iff V_pre).mp hb_pre
    have hRange : Set.range ⇑ψ ⊆ Set.range ⇑hU.fromSpec := by
      rw [hU.range_fromSpec]
      rintro _ ⟨p, rfl⟩
      have hp : p ∈ V_pre := by
        rw [hV_top]
        trivial
      exact hp
    let B : CommRingCat.{u} := C₀.presheaf.obj (Opposite.op U)
    let σ_V : AlgebraicGeometry.Spec (CommRingCat.of R_V) ⟶ AlgebraicGeometry.Spec B :=
      AlgebraicGeometry.IsOpenImmersion.lift hU.fromSpec ψ hRange
    have hσ_fac : σ_V ≫ hU.fromSpec = ψ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec ψ hRange
    have hLFP_chart : AlgebraicGeometry.LocallyOfFinitePresentation (hU.fromSpec ≫ g₀) :=
      inferInstance
    let f_B : R₀ ⟶ B := AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g₀)
    have hf_map : AlgebraicGeometry.Spec.map f_B = hU.fromSpec ≫ g₀ :=
      AlgebraicGeometry.Spec.map_preimage (hU.fromSpec ≫ g₀)
    let g_B : B ⟶ CommRingCat.of R_V := AlgebraicGeometry.Spec.preimage σ_V
    have hg_map : AlgebraicGeometry.Spec.map g_B = σ_V :=
      AlgebraicGeometry.Spec.map_preimage σ_V
    have hf_lfp : AlgebraicGeometry.LocallyOfFinitePresentation (AlgebraicGeometry.Spec.map f_B) := by
      rw [hf_map]
      exact hLFP_chart
    have hf_fp : (CommRingCat.Hom.hom f_B).FinitePresentation :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mp hf_lfp
    have hfg_eq : f_B ≫ g_B = β₀ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, hg_map, hf_map, ← CategoryTheory.Category.assoc,
        hσ_fac, hψ]
    obtain ⟨i₀, g'_B, hfg', hg'_colim⟩ :=
      RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
        R₀ R_diag α_diag f_B c_R hc_R hf_fp g_B
        (fun i => by dsimp [c_R]; rw [hfg_eq, ← hα_comp i])
    refine ⟨i₀, AlgebraicGeometry.Spec.map g'_B ≫ hU.fromSpec, ?_, ?_⟩
    · rw [CategoryTheory.Category.assoc, ← hf_map, ← AlgebraicGeometry.Spec.map_comp, hfg']
    · have hg'_eq : g'_B ≫ ι_colim.app i₀ = g_B := hg'_colim.symm
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hg'_eq,
        hg_map, hσ_fac]

  
  have hPairCoinc :
      ∀ {B₀ C_X S_a : AlgebraicGeometry.Scheme.{u}}
        (g : C_X ⟶ B₀) (_ : AlgebraicGeometry.IsSeparated g)
        (f_a : S_a ⟶ B₀) (φ₁ φ₂ : S_a ⟶ C_X)
        (_ : φ₁ ≫ g = f_a) (_ : φ₂ ≫ g = f_a),
        ∃ (U : S_a.Opens),
          ∀ {T C_T : AlgebraicGeometry.Scheme.{u}}
            (h : T ⟶ S_a) (g_T : C_T ⟶ T) (ι_T : C_T ⟶ C_X),
            CategoryTheory.IsPullback ι_T g_T g (h ≫ f_a) →
            ∀ (σ₁ σ₂ : T ⟶ C_T),
              σ₁ ≫ g_T = 𝟙 T →
              σ₂ ≫ g_T = 𝟙 T →
              σ₁ ≫ ι_T = h ≫ φ₁ →
              σ₂ ≫ ι_T = h ≫ φ₂ →
              (Disjoint (Set.range σ₁.base) (Set.range σ₂.base) ↔
                (TopologicalSpace.Opens.map h.base).obj U = ⊤) := by
    intro B₀ C_X S_a g hSep f_a φ₁ φ₂ hφ₁ hφ₂
    have : AlgebraicGeometry.IsSeparated g := hSep
    let Δ : C_X ⟶ CategoryTheory.Limits.pullback g g :=
      CategoryTheory.Limits.pullback.diagonal g
    let Φ : S_a ⟶ CategoryTheory.Limits.pullback g g :=
      CategoryTheory.Limits.pullback.lift φ₁ φ₂ (hφ₁.trans hφ₂.symm)
    let Z : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback Δ Φ
    let q : Z ⟶ S_a := CategoryTheory.Limits.pullback.snd Δ Φ
    have hCl_q : AlgebraicGeometry.IsClosedImmersion q := inferInstance
    let U : S_a.Opens :=
      ⟨(Set.range ⇑q)ᶜ, q.isClosedEmbedding.isClosed_range.isOpen_compl⟩
    refine ⟨U, ?_⟩
    intro T C_T h g_T ι_T hPb_T σ₁ σ₂ hSec₁ hSec₂ hσ₁ hσ₂
    let P_T : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback σ₁ σ₂
    have hfst_eq_snd :
        CategoryTheory.Limits.pullback.fst σ₁ σ₂ = CategoryTheory.Limits.pullback.snd σ₁ σ₂ := by
      calc
        CategoryTheory.Limits.pullback.fst σ₁ σ₂
          = CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ 𝟙 T :=
              (CategoryTheory.Category.comp_id _).symm
        _ = CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ (σ₁ ≫ g_T) := by rw [hSec₁]
        _ = (CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ σ₁) ≫ g_T :=
              (CategoryTheory.Category.assoc _ _ _).symm
        _ = (CategoryTheory.Limits.pullback.snd σ₁ σ₂ ≫ σ₂) ≫ g_T := by
              rw [CategoryTheory.Limits.pullback.condition]
        _ = CategoryTheory.Limits.pullback.snd σ₁ σ₂ ≫ (σ₂ ≫ g_T) :=
              CategoryTheory.Category.assoc _ _ _
        _ = CategoryTheory.Limits.pullback.snd σ₁ σ₂ ≫ 𝟙 T := by rw [hSec₂]
        _ = CategoryTheory.Limits.pullback.snd σ₁ σ₂ := CategoryTheory.Category.comp_id _
    have hσ_eq_P :
        CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ σ₁ =
          CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ σ₂ := by
      calc
        CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ σ₁
          = CategoryTheory.Limits.pullback.snd σ₁ σ₂ ≫ σ₂ :=
              CategoryTheory.Limits.pullback.condition
        _ = CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ σ₂ := by rw [← hfst_eq_snd]
    have htop_cond :
        (CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ σ₁ ≫ ι_T) ≫ Δ =
          (CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ h) ≫ Φ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · simp only [Δ, Φ, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.diagonal_fst, CategoryTheory.Category.comp_id,
          CategoryTheory.Limits.pullback.lift_fst]
        rw [hσ₁]
      · simp only [Δ, Φ, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id,
          CategoryTheory.Limits.pullback.lift_snd]
        rw [← CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.fst σ₁ σ₂) σ₁ ι_T,
          hσ_eq_P, CategoryTheory.Category.assoc, hσ₂]
    let top_T : P_T ⟶ Z :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ σ₁ ≫ ι_T)
        (CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ h)
        htop_cond
    have htop_p :
        top_T ≫ CategoryTheory.Limits.pullback.fst Δ Φ =
          CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ σ₁ ≫ ι_T :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have htop_q :
        top_T ≫ q = CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ h :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    constructor
    · intro hDisj
      have hs_helper : ∀ (s : CategoryTheory.Limits.PullbackCone q h),
          s.fst ≫ CategoryTheory.Limits.pullback.fst Δ Φ = s.snd ≫ σ₁ ≫ ι_T ∧
          s.fst ≫ CategoryTheory.Limits.pullback.fst Δ Φ = s.snd ≫ σ₂ ≫ ι_T ∧
          s.snd ≫ σ₁ = s.snd ≫ σ₂ := by
        intro s
        have hZ_cond : (s.fst ≫ CategoryTheory.Limits.pullback.fst Δ Φ) ≫ Δ =
            s.snd ≫ h ≫ Φ := by
          calc
            (s.fst ≫ CategoryTheory.Limits.pullback.fst Δ Φ) ≫ Δ
              = s.fst ≫ (CategoryTheory.Limits.pullback.fst Δ Φ ≫ Δ) :=
                  CategoryTheory.Category.assoc _ _ _
            _ = s.fst ≫ (q ≫ Φ) := by rw [CategoryTheory.Limits.pullback.condition]
            _ = (s.fst ≫ q) ≫ Φ := (CategoryTheory.Category.assoc _ _ _).symm
            _ = (s.snd ≫ h) ≫ Φ := by rw [s.condition]
            _ = s.snd ≫ h ≫ Φ := CategoryTheory.Category.assoc _ _ _
        have hw₁ : s.fst ≫ CategoryTheory.Limits.pullback.fst Δ Φ = s.snd ≫ σ₁ ≫ ι_T := by
          have h1 := congrArg (fun ψ => ψ ≫ CategoryTheory.Limits.pullback.fst g g) hZ_cond
          simp only [Δ, Φ, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.diagonal_fst, CategoryTheory.Category.comp_id,
            CategoryTheory.Limits.pullback.lift_fst] at h1
          rw [h1, ← hσ₁]
        have hw₂ : s.fst ≫ CategoryTheory.Limits.pullback.fst Δ Φ = s.snd ≫ σ₂ ≫ ι_T := by
          have h2 := congrArg (fun ψ => ψ ≫ CategoryTheory.Limits.pullback.snd g g) hZ_cond
          simp only [Δ, Φ, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id,
            CategoryTheory.Limits.pullback.lift_snd] at h2
          rw [h2, ← hσ₂]
        have hs_eq : s.snd ≫ σ₁ = s.snd ≫ σ₂ := by
          apply hPb_T.hom_ext
          · rw [CategoryTheory.Category.assoc, ← hw₁, hw₂, CategoryTheory.Category.assoc]
          · rw [CategoryTheory.Category.assoc, hSec₁, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.assoc, hSec₂, CategoryTheory.Category.comp_id]
        exact ⟨hw₁, hw₂, hs_eq⟩
      let isLim_Z : CategoryTheory.Limits.IsLimit
          (CategoryTheory.Limits.PullbackCone.mk top_T
            (CategoryTheory.Limits.pullback.fst σ₁ σ₂) htop_q) :=
        CategoryTheory.Limits.PullbackCone.IsLimit.mk htop_q
          (fun s => CategoryTheory.Limits.pullback.lift s.snd s.snd (hs_helper s).2.2)
          (fun s => by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, htop_p,
                ← CategoryTheory.Category.assoc _ (CategoryTheory.Limits.pullback.fst σ₁ σ₂),
                CategoryTheory.Limits.pullback.lift_fst, (hs_helper s).1]
            · change (CategoryTheory.Limits.pullback.lift s.snd s.snd (hs_helper s).2.2 ≫ top_T) ≫ q =
                s.fst ≫ q
              rw [CategoryTheory.Category.assoc, htop_q,
                ← CategoryTheory.Category.assoc _ (CategoryTheory.Limits.pullback.fst σ₁ σ₂),
                CategoryTheory.Limits.pullback.lift_fst, s.condition])
          (fun s => CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (fun s m _ hm₂ => by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Limits.pullback.lift_fst]
              exact hm₂
            · rw [CategoryTheory.Limits.pullback.lift_snd, ← hfst_eq_snd]
              exact hm₂)
      have hPb_Z : CategoryTheory.IsPullback top_T
          (CategoryTheory.Limits.pullback.fst σ₁ σ₂) q h :=
        CategoryTheory.IsPullback.of_isLimit isLim_Z
      refine eq_top_iff.mpr fun t _ => ?_
      change h.base t ∈ (Set.range ⇑q)ᶜ
      rintro ⟨z, hz⟩
      obtain ⟨p, _, hp_fst⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_Z z t hz
      have h_eq : σ₁.base t =
          σ₂.base ((CategoryTheory.Limits.pullback.snd σ₁ σ₂).base p) := by
        calc
          σ₁.base t
            = σ₁.base ((CategoryTheory.Limits.pullback.fst σ₁ σ₂).base p) := by rw [← hp_fst]
          _ = (CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ σ₁).base p := rfl
          _ = (CategoryTheory.Limits.pullback.snd σ₁ σ₂ ≫ σ₂).base p := by
                rw [CategoryTheory.Limits.pullback.condition]
          _ = σ₂.base ((CategoryTheory.Limits.pullback.snd σ₁ σ₂).base p) := rfl
      exact Set.disjoint_iff.mp hDisj
        ⟨⟨t, rfl⟩, ⟨(CategoryTheory.Limits.pullback.snd σ₁ σ₂).base p, h_eq.symm⟩⟩
    · intro hTop
      rw [Set.disjoint_iff]
      rintro x ⟨⟨t₁, rfl⟩, ⟨t₂, ht₂⟩⟩
      obtain ⟨p, hp₁, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := σ₁) (g := σ₂) t₁ t₂ ht₂.symm
      have hq_eq : q (top_T p) = h t₁ := by
        calc
          q (top_T p) = (top_T ≫ q).base p := rfl
          _ = (CategoryTheory.Limits.pullback.fst σ₁ σ₂ ≫ h).base p := by rw [htop_q]
          _ = h ((CategoryTheory.Limits.pullback.fst σ₁ σ₂) p) := rfl
          _ = h t₁ := by rw [hp₁]
      have ht₁_mem : t₁ ∈ (TopologicalSpace.Opens.map h.base).obj U := by
        rw [hTop]
        trivial
      exact ht₁_mem ⟨top_T p, hq_eq⟩

  
  have hEachLift :
      ∀ j : Fin n,
        ∃ (i₀ : J) (φ₀ : AlgebraicGeometry.Spec (R_diag.obj i₀) ⟶ C₀),
          φ₀ ≫ g₀ = AlgebraicGeometry.Spec.map (α_diag.app i₀) ∧
          AlgebraicGeometry.Spec.map (ι_colim.app i₀) ≫ φ₀ = τ_V j ≫ ι₀ := by
    intro j
    refine hSingleLift (τ_V j ≫ ι₀) ?_
    rw [CategoryTheory.Category.assoc, hPb₀.w, ← CategoryTheory.Category.assoc,
      hSecV j, CategoryTheory.Category.id_comp]
  choose idx₀ φ₀ hφ₀_over hφ₀_V using hEachLift

  have hSync :
      ∀ (k : ℕ), k ≤ n →
        ∃ (i_k : J)
          (φ_k : ∀ (j : Fin n), j.1 < k → (AlgebraicGeometry.Spec (R_diag.obj i_k) ⟶ C₀)),
          (∀ (j : Fin n) (hj : j.1 < k),
            φ_k j hj ≫ g₀ = AlgebraicGeometry.Spec.map (α_diag.app i_k)) ∧
          (∀ (j : Fin n) (hj : j.1 < k),
            AlgebraicGeometry.Spec.map (ι_colim.app i_k) ≫ φ_k j hj = τ_V j ≫ ι₀) := by
    intro k
    induction k with
    | zero =>
      intro _
      obtain ⟨i_empty⟩ := CategoryTheory.IsFiltered.nonempty (C := J)
      refine ⟨i_empty, fun _ hj => False.elim (Nat.not_lt_zero _ hj),
        fun _ hj => False.elim (Nat.not_lt_zero _ hj),
        fun _ hj => False.elim (Nat.not_lt_zero _ hj)⟩
    | succ k ih =>
      intro hk
      obtain ⟨i_k, φ_k, hφ_k_over, hφ_k_V⟩ := ih (Nat.le_of_succ_le hk)
      let j_last : Fin n := ⟨k, hk⟩
      let i' : J := CategoryTheory.IsFiltered.max i_k (idx₀ j_last)
      let u_L : i_k ⟶ i' := CategoryTheory.IsFiltered.leftToMax i_k (idx₀ j_last)
      let u_R : idx₀ j_last ⟶ i' := CategoryTheory.IsFiltered.rightToMax i_k (idx₀ j_last)
      let φ' : ∀ (j : Fin n), j.1 < k + 1 → (AlgebraicGeometry.Spec (R_diag.obj i') ⟶ C₀) :=
        fun j _ =>
          if hlt : j.1 < k then
            AlgebraicGeometry.Spec.map (R_diag.map u_L) ≫ φ_k j hlt
          else
            AlgebraicGeometry.Spec.map (R_diag.map u_R) ≫ φ₀ j_last
      have hα_L : α_diag.app i_k ≫ R_diag.map u_L = α_diag.app i' :=
        (α_diag.naturality u_L).symm.trans (CategoryTheory.Category.id_comp _)
      have hα_R : α_diag.app (idx₀ j_last) ≫ R_diag.map u_R = α_diag.app i' :=
        (α_diag.naturality u_R).symm.trans (CategoryTheory.Category.id_comp _)
      have hι_L : R_diag.map u_L ≫ ι_colim.app i' = ι_colim.app i_k :=
        (ι_colim.naturality u_L).trans (CategoryTheory.Category.comp_id _)
      have hι_R : R_diag.map u_R ≫ ι_colim.app i' = ι_colim.app (idx₀ j_last) :=
        (ι_colim.naturality u_R).trans (CategoryTheory.Category.comp_id _)
      refine ⟨i', φ', ?_, ?_⟩
      · intro j hj
        dsimp only [φ']
        split_ifs with hlt
        · rw [CategoryTheory.Category.assoc, hφ_k_over j hlt,
            ← AlgebraicGeometry.Spec.map_comp, hα_L]
        · rw [CategoryTheory.Category.assoc, hφ₀_over j_last,
            ← AlgebraicGeometry.Spec.map_comp, hα_R]
      · intro j hj
        dsimp only [φ']
        split_ifs with hlt
        · rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
            hι_L, hφ_k_V j hlt]
        · have hj_val : j.1 = k := by omega
          have hj_eq : j = j_last := Fin.ext hj_val
          rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
            hι_R, hφ₀_V j_last, hj_eq]
  obtain ⟨i_a, φ_a_dep, hφ_a_dep_over, hφ_a_dep_V⟩ := hSync n le_rfl
  let φ_a : Fin n → (AlgebraicGeometry.Spec (R_diag.obj i_a) ⟶ C₀) :=
    fun j => φ_a_dep j j.2
  have hφ_a_over : ∀ j : Fin n,
      φ_a j ≫ g₀ = AlgebraicGeometry.Spec.map (α_diag.app i_a) :=
    fun j => hφ_a_dep_over j j.2
  have hφ_a_V : ∀ j : Fin n,
      AlgebraicGeometry.Spec.map (ι_colim.app i_a) ≫ φ_a j = τ_V j ≫ ι₀ :=
    fun j => hφ_a_dep_V j j.2

  
  let S_a : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (R_diag.obj i_a)
  let f_a : S_a ⟶ AlgebraicGeometry.Spec R₀ := AlgebraicGeometry.Spec.map (α_diag.app i_a)
  let π_a : AlgebraicGeometry.Spec (CommRingCat.of R_V) ⟶ S_a :=
    AlgebraicGeometry.Spec.map (ι_colim.app i_a)
  have hπ_f : π_a ≫ f_a = AlgebraicGeometry.Spec.map β₀ := by
    dsimp [π_a, f_a]
    rw [← AlgebraicGeometry.Spec.map_comp, hα_comp i_a]

  have hPair_a :
      ∀ j₁ j₂ : Fin n,
        ∃ (U : S_a.Opens),
          ∀ {T C_T : AlgebraicGeometry.Scheme.{u}}
            (h : T ⟶ S_a) (g_T : C_T ⟶ T) (ι_T : C_T ⟶ C₀),
            CategoryTheory.IsPullback ι_T g_T g₀ (h ≫ f_a) →
            ∀ (σ₁ σ₂ : T ⟶ C_T),
              σ₁ ≫ g_T = 𝟙 T →
              σ₂ ≫ g_T = 𝟙 T →
              σ₁ ≫ ι_T = h ≫ φ_a j₁ →
              σ₂ ≫ ι_T = h ≫ φ_a j₂ →
              (Disjoint (Set.range σ₁.base) (Set.range σ₂.base) ↔
                (TopologicalSpace.Opens.map h.base).obj U = ⊤) :=
    fun j₁ j₂ => hPairCoinc g₀ hSep₀ f_a (φ_a j₁) (φ_a j₂) (hφ_a_over j₁) (hφ_a_over j₂)
  choose U_pair hU_pair_iff using hPair_a

  let offDiag : Finset (Fin n × Fin n) :=
    Finset.univ.filter (fun p : Fin n × Fin n => p.1 ≠ p.2)
  let U_sep : S_a.Opens := offDiag.inf (fun p => U_pair p.1 p.2)

  have hU_pair_V :
      ∀ p ∈ offDiag, (TopologicalSpace.Opens.map π_a.base).obj (U_pair p.1 p.2) = ⊤ := by
    intro p hp
    have hp_ne : p.1 ≠ p.2 := (Finset.mem_filter.mp hp).2
    have hPb_a : CategoryTheory.IsPullback ι₀ g_V g₀ (π_a ≫ f_a) := by
      rw [hπ_f]
      exact hPb₀
    exact (hU_pair_iff p.1 p.2 π_a g_V ι₀ hPb_a (τ_V p.1) (τ_V p.2)
      (hSecV p.1) (hSecV p.2) (hφ_a_V p.1).symm (hφ_a_V p.2).symm).mp (hDisjV hp_ne)

  have hU_sep_V : (TopologicalSpace.Opens.map π_a.base).obj U_sep = ⊤ := by
    have hInf : ∀ (s : Finset (Fin n × Fin n)),
        (∀ p ∈ s, (TopologicalSpace.Opens.map π_a.base).obj (U_pair p.1 p.2) = ⊤) →
        (TopologicalSpace.Opens.map π_a.base).obj (s.inf (fun p => U_pair p.1 p.2)) = ⊤ := by
      intro s
      refine Finset.induction_on s ?_ ?_
      · intro _
        rw [Finset.inf_empty]
        rfl
      · intro p s' _ ih hs
        rw [Finset.inf_insert]
        have hp_top : (TopologicalSpace.Opens.map π_a.base).obj (U_pair p.1 p.2) = ⊤ :=
          hs p (Finset.mem_insert_self p s')
        have hs'_top : (TopologicalSpace.Opens.map π_a.base).obj
            (s'.inf (fun q => U_pair q.1 q.2)) = ⊤ :=
          ih (fun q hq => hs q (Finset.mem_insert_of_mem hq))
        refine eq_top_iff.mpr fun x _ => ?_
        have hx1 : x ∈ (TopologicalSpace.Opens.map π_a.base).obj (U_pair p.1 p.2) := by
          rw [hp_top]; trivial
        have hx2 : x ∈ (TopologicalSpace.Opens.map π_a.base).obj
            (s'.inf (fun q => U_pair q.1 q.2)) := by
          rw [hs'_top]; trivial
        exact ⟨hx1, hx2⟩
    exact hInf offDiag hU_pair_V

  let D_S : Jᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u} := R_diag.op ⋙ AlgebraicGeometry.Scheme.Spec
  let c_S : CategoryTheory.Limits.Cone D_S := AlgebraicGeometry.Scheme.Spec.mapCone c_R.op
  have hc_S : CategoryTheory.Limits.IsLimit c_S :=
    CategoryTheory.Limits.isLimitOfPreserves AlgebraicGeometry.Scheme.Spec hc_R.op
  have : ∀ x : Jᵒᵖ, AlgebraicGeometry.IsAffine (D_S.obj x) :=
    fun x => (inferInstance : AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec (R_diag.obj x.unop)))
  have : ∀ x : Jᵒᵖ, CompactSpace ↥(D_S.obj x) :=
    fun x => (inferInstance : CompactSpace ↥(AlgebraicGeometry.Spec (R_diag.obj x.unop)))
  have : ∀ {x y : Jᵒᵖ} (f : x ⟶ y), AlgebraicGeometry.IsAffineHom (D_S.map f) :=
    fun f => AlgebraicGeometry.isAffineHom_of_isAffine (D_S.map f)
  obtain ⟨j_op, fji, h_top⟩ :=
    AlgebraicGeometry.exists_map_eq_top D_S c_S hc_S (i := Opposite.op i_a) U_sep hU_sep_V
  let i₁ : J := j_op.unop
  let u : i_a ⟶ i₁ := fji.unop

  
  let S₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (R_diag.obj i₁)
  let f₁ : S₁ ⟶ AlgebraicGeometry.Spec R₀ := AlgebraicGeometry.Spec.map (α_diag.app i₁)
  let ρ : S₁ ⟶ S_a := AlgebraicGeometry.Spec.map (R_diag.map u)
  let C₁ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g₀ f₁
  let g₁ : C₁ ⟶ S₁ := CategoryTheory.Limits.pullback.snd g₀ f₁
  let pr₁ : C₁ ⟶ C₀ := CategoryTheory.Limits.pullback.fst g₀ f₁

  have hρ_f : ρ ≫ f_a = f₁ := by
    dsimp [ρ, f_a, f₁]
    rw [← AlgebraicGeometry.Spec.map_comp]
    have hα_u : α_diag.app i_a ≫ R_diag.map u = α_diag.app i₁ :=
      (α_diag.naturality u).symm.trans (CategoryTheory.Category.id_comp _)
    rw [hα_u]

  have hπ₁_ρ : AlgebraicGeometry.Spec.map (ι_colim.app i₁) ≫ ρ = π_a := by
    dsimp [ρ, π_a]
    rw [← AlgebraicGeometry.Spec.map_comp]
    have hι_u : R_diag.map u ≫ ι_colim.app i₁ = ι_colim.app i_a :=
      (ι_colim.naturality u).trans (CategoryTheory.Category.comp_id _)
    rw [hι_u]

  let τ₁ : Fin n → (S₁ ⟶ C₁) :=
    fun j => CategoryTheory.Limits.pullback.lift (ρ ≫ φ_a j) (𝟙 S₁)
      (by rw [CategoryTheory.Category.assoc, hφ_a_over j, hρ_f, CategoryTheory.Category.id_comp])

  have hι₁_cond : ι₀ ≫ g₀ = (g_V ≫ AlgebraicGeometry.Spec.map (ι_colim.app i₁)) ≫ f₁ := by
    rw [hPb₀.w, CategoryTheory.Category.assoc]
    dsimp [f₁]
    rw [← AlgebraicGeometry.Spec.map_comp, hα_comp i₁]

  let ι₁ : C_V ⟶ C₁ :=
    CategoryTheory.Limits.pullback.lift ι₀ (g_V ≫ AlgebraicGeometry.Spec.map (ι_colim.app i₁))
      hι₁_cond

  have hSec₁ : ∀ j : Fin n, τ₁ j ≫ g₁ = 𝟙 S₁ :=
    fun j => CategoryTheory.Limits.pullback.lift_snd _ _ _

  refine ⟨i₁, τ₁, ι₁, ?_, hSec₁, ?_, ?_, ?_⟩
  · let j₀ : Fin n := ⟨0, by omega⟩
    refine ⟨fun s => ⟨(τ₁ j₀).base s, ?_⟩⟩
    change (τ₁ j₀ ≫ g₁).base s = s
    rw [hSec₁ j₀]
    rfl
  · intro j₁ j₂ hj
    have hmem : (j₁, j₂) ∈ offDiag := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj⟩
    have hle : U_sep ≤ U_pair j₁ j₂ := Finset.inf_le hmem
    have hρ_top : (TopologicalSpace.Opens.map ρ.base).obj U_sep = ⊤ := h_top
    have hρ_pair : (TopologicalSpace.Opens.map ρ.base).obj (U_pair j₁ j₂) = ⊤ := by
      refine eq_top_iff.mpr fun s _ => ?_
      have hs_sep : s ∈ (TopologicalSpace.Opens.map ρ.base).obj U_sep := by
        rw [hρ_top]; trivial
      exact SetLike.le_def.mp hle hs_sep
    have hPb₁ : CategoryTheory.IsPullback pr₁ g₁ g₀ (ρ ≫ f_a) := by
      rw [hρ_f]
      exact CategoryTheory.IsPullback.of_hasPullback g₀ f₁
    exact (hU_pair_iff j₁ j₂ ρ g₁ pr₁ hPb₁ (τ₁ j₁) (τ₁ j₂)
      (hSec₁ j₁) (hSec₁ j₂)
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)).mpr hρ_pair
  · refine CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback g₀ f₁)
    have h_fst : ι₁ ≫ pr₁ = ι₀ := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have h_bot : AlgebraicGeometry.Spec.map (ι_colim.app i₁) ≫ f₁ =
        AlgebraicGeometry.Spec.map β₀ := by
      dsimp [f₁]
      rw [← AlgebraicGeometry.Spec.map_comp, hα_comp i₁]
    rw [h_fst, h_bot]
    exact hPb₀
  · intro j
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (τ_V j ≫ ι₁) ≫ pr₁ = (AlgebraicGeometry.Spec.map (ι_colim.app i₁) ≫ τ₁ j) ≫ pr₁
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        ← CategoryTheory.Category.assoc, hπ₁_ρ, hφ_a_V j]
    · change (τ_V j ≫ ι₁) ≫ g₁ = (AlgebraicGeometry.Spec.map (ι_colim.app i₁) ≫ τ₁ j) ≫ g₁
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc, hSecV j, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.assoc, hSec₁ j, CategoryTheory.Category.comp_id]

theorem weil_localRing_smooth_relDimOne_section_opens_descent (R₁ : CommRingCat.{u})
    (R_V : Type u) [CommRing R_V] [IsLocalRing R_V]
    (β₁ : R₁ ⟶ CommRingCat.of R_V)
    (J : Type u) [CategoryTheory.SmallCategory J] [CategoryTheory.IsFiltered J]
    (R_diag : CategoryTheory.Functor J CommRingCat.{u})
    (α_diag : (CategoryTheory.Functor.const J).obj R₁ ⟶ R_diag)
    (ι_colim : R_diag ⟶ (CategoryTheory.Functor.const J).obj (CommRingCat.of R_V))
    (hColim : Nonempty (CategoryTheory.Limits.IsColimit
      (CategoryTheory.Limits.Cocone.mk (CommRingCat.of R_V) ι_colim)))
    (hα_comp : ∀ i : J, α_diag.app i ≫ ι_colim.app i = β₁)
    (n : ℕ)
    (C₁ : AlgebraicGeometry.Scheme.{u})
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec R₁)
    (τ₁ : Fin n → (AlgebraicGeometry.Spec R₁ ⟶ C₁))
    (hQC₁ : AlgebraicGeometry.QuasiCompact g₁)
    (hSep₁ : AlgebraicGeometry.IsSeparated g₁)
    (hLFP₁ : AlgebraicGeometry.LocallyOfFinitePresentation g₁)
    (hSec₁ : ∀ j : Fin n, τ₁ j ≫ g₁ = 𝟙 _)
    (C_V : AlgebraicGeometry.Scheme.{u})
    (g_V : C_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_V))
    (τ_V : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R_V) ⟶ C_V))
    (hSecV : ∀ j : Fin n, τ_V j ≫ g_V = 𝟙 _)
    (hSmSecV : ∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of R_V)),
      ∃ W : C_V.Opens, (τ_V j).base b ∈ W ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ g_V))
    (ι₁ : C_V ⟶ C₁)
    (hPb₁ : CategoryTheory.IsPullback ι₁ g_V g₁ (AlgebraicGeometry.Spec.map β₁))
    (hτ₁ : ∀ j : Fin n, τ_V j ≫ ι₁ = AlgebraicGeometry.Spec.map β₁ ≫ τ₁ j) :
    ∃ (i₂ : J)
      (τ₂ : Fin n → (AlgebraicGeometry.Spec (R_diag.obj i₂) ⟶
        CategoryTheory.Limits.pullback g₁ (AlgebraicGeometry.Spec.map (α_diag.app i₂))))
      (ι₂ : C_V ⟶ CategoryTheory.Limits.pullback g₁ (AlgebraicGeometry.Spec.map (α_diag.app i₂))),
      (∀ j : Fin n, τ₂ j ≫
        CategoryTheory.Limits.pullback.fst g₁ (AlgebraicGeometry.Spec.map (α_diag.app i₂)) =
          AlgebraicGeometry.Spec.map (α_diag.app i₂) ≫ τ₁ j) ∧
      (∀ j : Fin n, τ₂ j ≫
        CategoryTheory.Limits.pullback.snd g₁ (AlgebraicGeometry.Spec.map (α_diag.app i₂)) = 𝟙 _) ∧
      (∀ (j : Fin n) (b : AlgebraicGeometry.Spec (R_diag.obj i₂)),
        ∃ W : (CategoryTheory.Limits.pullback g₁ (AlgebraicGeometry.Spec.map (α_diag.app i₂))).Opens,
          (τ₂ j).base b ∈ W ∧
            AlgebraicGeometry.SmoothOfRelativeDimension 1
              (W.ι ≫ CategoryTheory.Limits.pullback.snd g₁ (AlgebraicGeometry.Spec.map (α_diag.app i₂)))) ∧
      CategoryTheory.IsPullback ι₂ g_V
        (CategoryTheory.Limits.pullback.snd g₁ (AlgebraicGeometry.Spec.map (α_diag.app i₂)))
        (AlgebraicGeometry.Spec.map (ι_colim.app i₂)) ∧
      (∀ j : Fin n, τ_V j ≫ ι₂ = AlgebraicGeometry.Spec.map (ι_colim.app i₂) ≫ τ₂ j) :=
by
  classical
  
  
  have h_s1 : ∀ (σ_V : AlgebraicGeometry.Spec (CommRingCat.of R_V) ⟶ C_V),
      σ_V ≫ g_V = 𝟙 _ →
      (∀ b : AlgebraicGeometry.Spec (CommRingCat.of R_V),
        ∃ W : C_V.Opens, σ_V.base b ∈ W ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ g_V)) →
      ∃ (V_V : C_V.Opens)
        (B_V : CommRingCat.{u})
        (φ_V : CommRingCat.of R_V ⟶ B_V)
        (e_V : V_V.toScheme ≅ AlgebraicGeometry.Spec B_V),
        AlgebraicGeometry.IsAffineOpen V_V ∧
        (TopologicalSpace.Opens.map σ_V.base).obj V_V = ⊤ ∧
        V_V.ι ≫ g_V = e_V.hom ≫ AlgebraicGeometry.Spec.map φ_V ∧
        RingHom.IsStandardSmoothOfRelativeDimension 1 φ_V.hom := by
    intro σ_V hSec hSm
    let b_max : AlgebraicGeometry.Spec (CommRingCat.of R_V) := IsLocalRing.closedPoint R_V
    have hOpenTop : ∀ U : (AlgebraicGeometry.Spec (CommRingCat.of R_V)).Opens, b_max ∈ U → U = ⊤ := by
      intro U hb
      rw [eq_top_iff]
      intro p _
      exact (IsLocalRing.specializes_closedPoint p).mem_open U.isOpen hb
    obtain ⟨W, hmem, hSmW⟩ := hSm b_max
    let f : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_V) := W.ι ≫ g_V
    let y : ↥W.toScheme := ⟨σ_V.base b_max, hmem⟩
    obtain ⟨U, hU, V₀, hV₀, hy, e, hSm_app⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 f).mp hSmW y
    have hb_U : b_max ∈ U := by
      have hfy : f.base y ∈ U := e hy
      have hfy_eq : f.base y = b_max := by
        have hy_ι : W.ι.base y = σ_V.base b_max := rfl
        calc
          f.base y = g_V.base (W.ι.base y) := rfl
          _ = g_V.base (σ_V.base b_max) := by rw [hy_ι]
          _ = (σ_V ≫ g_V).base b_max := rfl
          _ = b_max := by rw [hSec]; rfl
      rwa [← hfy_eq]
    have hU_top : U = ⊤ := hOpenTop U hb_U
    let V_V : C_V.Opens := (AlgebraicGeometry.Scheme.Hom.opensFunctor W.ι).obj V₀
    have hAffV : AlgebraicGeometry.IsAffineOpen V_V := hV₀.image_of_isOpenImmersion W.ι
    have hTopV : (TopologicalSpace.Opens.map σ_V.base).obj V_V = ⊤ := by
      apply hOpenTop
      change σ_V.base b_max ∈ V_V
      exact ⟨y, hy, rfl⟩
    let e_open : V₀.toScheme ≅ V_V.toScheme := AlgebraicGeometry.Scheme.Hom.isoImage W.ι V₀
    let B_V : CommRingCat.{u} := W.toScheme.presheaf.obj (Opposite.op V₀)
    let e_V : V_V.toScheme ≅ AlgebraicGeometry.Spec B_V := e_open.symm ≪≫ hV₀.isoSpec
    have hRangeU : AlgebraicGeometry.Scheme.Hom.opensRange U.ι = ⊤ := by
      rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι, hU_top]
    haveI : CategoryTheory.IsIso U.ι :=
      AlgebraicGeometry.isIso_of_isOpenImmersion_of_opensRange_eq_top U.ι hRangeU
    have hFromSpec_eq : hU.fromSpec = hU.isoSpec.inv ≫ U.ι := (hU.isoSpec_inv_ι).symm
    haveI : CategoryTheory.IsIso hU.fromSpec := by
      rw [hFromSpec_eq]
      infer_instance
    let iso_base := CategoryTheory.asIso hU.fromSpec
    let α_hom : CommRingCat.of R_V ⟶
        (AlgebraicGeometry.Spec (CommRingCat.of R_V)).presheaf.obj (Opposite.op U) :=
      AlgebraicGeometry.Spec.preimage iso_base.hom
    let α_inv : (AlgebraicGeometry.Spec (CommRingCat.of R_V)).presheaf.obj (Opposite.op U) ⟶
        CommRingCat.of R_V :=
      AlgebraicGeometry.Spec.preimage iso_base.inv
    have hα_hom_inv : α_hom ≫ α_inv = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, iso_base.inv_hom_id, AlgebraicGeometry.Spec.map_id]
    have hα_inv_hom : α_inv ≫ α_hom = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, iso_base.hom_inv_id, AlgebraicGeometry.Spec.map_id]
    haveI : CategoryTheory.IsIso α_hom := ⟨⟨α_inv, hα_hom_inv, hα_inv_hom⟩⟩
    let φ_V : CommRingCat.of R_V ⟶ B_V := α_hom ≫ f.appLE U V₀ e
    have hSm_φV : RingHom.IsStandardSmoothOfRelativeDimension 1 φ_V.hom := by
      change RingHom.IsStandardSmoothOfRelativeDimension 1
        ((f.appLE U V₀ e).hom.comp α_hom.hom)
      exact (RingHom.RespectsIso.cancel_left_isIso
        RingHom.isStandardSmoothOfRelativeDimension_respectsIso
        α_hom (f.appLE U V₀ e)).mpr hSm_app
    have hFacV : V_V.ι ≫ g_V = e_V.hom ≫ AlgebraicGeometry.Spec.map φ_V := by
      have hSpec_φ : AlgebraicGeometry.Spec.map φ_V =
          AlgebraicGeometry.Spec.map (f.appLE U V₀ e) ≫ hU.fromSpec := by
        dsimp [φ_V, α_hom, iso_base]
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage]
      calc
        V_V.ι ≫ g_V = (e_open.inv ≫ (V₀.ι ≫ W.ι)) ≫ g_V := by
          rw [AlgebraicGeometry.Scheme.Hom.isoImage_inv_ι]
        _ = e_open.inv ≫ V₀.ι ≫ f := by
          simp only [f, CategoryTheory.Category.assoc]
        _ = e_open.inv ≫ hV₀.isoSpec.hom ≫ (hV₀.isoSpec.inv ≫ V₀.ι) ≫ f := by
          simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
        _ = e_open.inv ≫ hV₀.isoSpec.hom ≫ hV₀.fromSpec ≫ f := by
          rw [hV₀.isoSpec_inv_ι]
        _ = e_open.inv ≫ hV₀.isoSpec.hom ≫
              (AlgebraicGeometry.Spec.map (f.appLE U V₀ e) ≫ hU.fromSpec) := by
          rw [hU.SpecMap_appLE_fromSpec f hV₀ e]
        _ = e_V.hom ≫ AlgebraicGeometry.Spec.map φ_V := by
          rw [← hSpec_φ]
          simp only [e_V, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom,
            CategoryTheory.Category.assoc]
    exact ⟨V_V, B_V, φ_V, e_V, hAffV, hTopV, hFacV, hSm_φV⟩

  
  have h_s2_top : ∀ {R₀ R_lim : CommRingCat.{u}} (β₀ : R₀ ⟶ R_lim)
      {K : Type u} [CategoryTheory.SmallCategory K] [CategoryTheory.IsFiltered K]
      (D_ring : CategoryTheory.Functor K CommRingCat.{u})
      (α_K : (CategoryTheory.Functor.const K).obj R₀ ⟶ D_ring)
      (ι_K : D_ring ⟶ (CategoryTheory.Functor.const K).obj R_lim),
      CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.Cocone.mk R_lim ι_K) →
      (∀ k : K, α_K.app k ≫ ι_K.app k = β₀) →
      ∀ U₀ : (AlgebraicGeometry.Spec R₀).Opens,
        (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map β₀).base).obj U₀ = ⊤ →
        ∃ k : K,
          (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map (α_K.app k)).base).obj U₀ = ⊤ := by
    intro R₀ R_lim β₀ K _ _ D_ring α_K ι_K hc_K hα_K U₀ hU₀_top
    haveI : CategoryTheory.IsCofiltered Kᵒᵖ := CategoryTheory.isCofiltered_op_of_isFiltered K
    let c_ring : CategoryTheory.Limits.Cocone D_ring :=
      CategoryTheory.Limits.Cocone.mk R_lim ι_K
    haveI : CategoryTheory.Limits.PreservesLimitsOfSize.{u, u} AlgebraicGeometry.Scheme.Spec :=
      CategoryTheory.Adjunction.rightAdjoint_preservesLimits AlgebraicGeometry.ΓSpec.adjunction
    let D_base : Kᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u} :=
      D_ring.op ⋙ AlgebraicGeometry.Scheme.Spec
    let c_base : CategoryTheory.Limits.Cone D_base :=
      AlgebraicGeometry.Scheme.Spec.mapCone c_ring.op
    have hc_base : CategoryTheory.Limits.IsLimit c_base :=
      CategoryTheory.Limits.isLimitOfPreserves AlgebraicGeometry.Scheme.Spec hc_K.op
    haveI : ∀ k : Kᵒᵖ, CompactSpace ↥(D_base.obj k) := by
      intro k
      change CompactSpace ↥(AlgebraicGeometry.Spec (D_ring.obj k.unop))
      infer_instance
    haveI : ∀ {k₁ k₂ : Kᵒᵖ} (f : k₁ ⟶ k₂), AlgebraicGeometry.IsAffineHom (D_base.map f) := by
      intro k₁ k₂ f
      change AlgebraicGeometry.IsAffineHom (AlgebraicGeometry.Spec.map (D_ring.map f.unop))
      infer_instance
    obtain ⟨k₀⟩ := CategoryTheory.IsFiltered.nonempty (C := K)
    let α₀ : R₀ ⟶ D_ring.obj k₀ := α_K.app k₀
    let U_init : (D_base.obj (Opposite.op k₀)).Opens :=
      (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map α₀).base).obj U₀
    have hU_init_top :
        (TopologicalSpace.Opens.map (c_base.π.app (Opposite.op k₀)).base).obj U_init = ⊤ := by
      have hcomp : c_base.π.app (Opposite.op k₀) ≫ AlgebraicGeometry.Spec.map α₀ =
          AlgebraicGeometry.Spec.map β₀ := by
        change AlgebraicGeometry.Spec.map (ι_K.app k₀) ≫ AlgebraicGeometry.Spec.map α₀ =
          AlgebraicGeometry.Spec.map β₀
        rw [← AlgebraicGeometry.Spec.map_comp]
        exact congrArg AlgebraicGeometry.Spec.map (hα_K k₀)
      have hpre :
          (TopologicalSpace.Opens.map (c_base.π.app (Opposite.op k₀)).base).obj U_init =
            (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map β₀).base).obj U₀ := by
        ext x
        change (c_base.π.app (Opposite.op k₀) ≫ AlgebraicGeometry.Spec.map α₀).base x ∈ U₀ ↔
          (AlgebraicGeometry.Spec.map β₀).base x ∈ U₀
        rw [hcomp]
      rw [hpre, hU₀_top]
    obtain ⟨k_op, fji, hfji_top⟩ :=
      AlgebraicGeometry.exists_map_eq_top D_base c_base hc_base U_init hU_init_top
    refine ⟨k_op.unop, ?_⟩
    let α_dest : R₀ ⟶ D_ring.obj k_op.unop := α_K.app k_op.unop
    have hα_nat : α₀ ≫ D_ring.map fji.unop = α_dest := by
      simpa [α₀, α_dest] using (α_K.naturality fji.unop).symm
    have hSpec_nat : D_base.map fji ≫ AlgebraicGeometry.Spec.map α₀ =
        AlgebraicGeometry.Spec.map α_dest := by
      change AlgebraicGeometry.Spec.map (D_ring.map fji.unop) ≫
          AlgebraicGeometry.Spec.map α₀ =
        AlgebraicGeometry.Spec.map α_dest
      rw [← AlgebraicGeometry.Spec.map_comp, hα_nat]
    have hpre2 :
        (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map (α_K.app k_op.unop)).base).obj U₀ =
          (TopologicalSpace.Opens.map (D_base.map fji).base).obj U_init := by
      ext x
      change (AlgebraicGeometry.Spec.map α_dest).base x ∈ U₀ ↔
        (D_base.map fji ≫ AlgebraicGeometry.Spec.map α₀).base x ∈ U₀
      rw [hSpec_nat]
    rw [hpre2, hfji_top]

  
  let f_base : ∀ i : J, AlgebraicGeometry.Spec (R_diag.obj i) ⟶ AlgebraicGeometry.Spec R₁ :=
    fun i => AlgebraicGeometry.Spec.map (α_diag.app i)
  let C_i : J → AlgebraicGeometry.Scheme.{u} :=
    fun i => CategoryTheory.Limits.pullback g₁ (f_base i)
  let fst_i : ∀ i : J, C_i i ⟶ C₁ :=
    fun i => CategoryTheory.Limits.pullback.fst g₁ (f_base i)
  let g_i : ∀ i : J, C_i i ⟶ AlgebraicGeometry.Spec (R_diag.obj i) :=
    fun i => CategoryTheory.Limits.pullback.snd g₁ (f_base i)
  let τ_i : ∀ (i : J), Fin n → (AlgebraicGeometry.Spec (R_diag.obj i) ⟶ C_i i) :=
    fun i j => CategoryTheory.Limits.pullback.lift (f_base i ≫ τ₁ j) (𝟙 _)
      (by rw [CategoryTheory.Category.assoc, hSec₁ j,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  let ι_i : ∀ i : J, C_V ⟶ C_i i :=
    fun i => CategoryTheory.Limits.pullback.lift ι₁
      (g_V ≫ AlgebraicGeometry.Spec.map (ι_colim.app i))
      (by rw [hPb₁.w, CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hα_comp i])

  have hτ_fst : ∀ (i : J) (j : Fin n), τ_i i j ≫ fst_i i = f_base i ≫ τ₁ j :=
    fun i j => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hSec_i : ∀ (i : J) (j : Fin n), τ_i i j ≫ g_i i = 𝟙 _ :=
    fun i j => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_i : ∀ i : J, CategoryTheory.IsPullback (ι_i i) g_V (g_i i)
      (AlgebraicGeometry.Spec.map (ι_colim.app i)) := by
    intro i
    refine CategoryTheory.IsPullback.of_right ?_
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback g₁ (f_base i))
    have hcomp_β : AlgebraicGeometry.Spec.map (ι_colim.app i) ≫ f_base i =
        AlgebraicGeometry.Spec.map β₁ := by
      dsimp [f_base]
      rw [← AlgebraicGeometry.Spec.map_comp, hα_comp i]
    rw [CategoryTheory.Limits.pullback.lift_fst, hcomp_β]
    exact hPb₁
  have hτ_V_i : ∀ (i : J) (j : Fin n),
      τ_V j ≫ ι_i i = AlgebraicGeometry.Spec.map (ι_colim.app i) ≫ τ_i i j := by
    intro i j
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (τ_V j ≫ ι_i i) ≫ fst_i i = (AlgebraicGeometry.Spec.map (ι_colim.app i) ≫ τ_i i j) ≫ fst_i i
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hτ₁ j,
        CategoryTheory.Category.assoc, hτ_fst i j, ← CategoryTheory.Category.assoc]
      dsimp [f_base]
      rw [← AlgebraicGeometry.Spec.map_comp, hα_comp i]
    · change (τ_V j ≫ ι_i i) ≫ g_i i = (AlgebraicGeometry.Spec.map (ι_colim.app i) ≫ τ_i i j) ≫ g_i i
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc, hSecV j, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.assoc, hSec_i i j, CategoryTheory.Category.comp_id]

  have hα_nat : ∀ {i i' : J} (u : i ⟶ i'), α_diag.app i ≫ R_diag.map u = α_diag.app i' := by
    intro i i' u
    simpa using (α_diag.naturality u).symm
  have hι_nat : ∀ {i i' : J} (u : i ⟶ i'), R_diag.map u ≫ ι_colim.app i' = ι_colim.app i := by
    intro i i' u
    exact (ι_colim.naturality u).trans (CategoryTheory.Category.comp_id _)

  let Φ : ∀ {i i' : J} (_ : i ⟶ i'), C_i i' ⟶ C_i i :=
    fun {i i'} u => CategoryTheory.Limits.pullback.lift (fst_i i')
      (g_i i' ≫ AlgebraicGeometry.Spec.map (R_diag.map u))
      (by
        rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
        dsimp [f_base]
        rw [← AlgebraicGeometry.Spec.map_comp, hα_nat u])

  have hΦ_fst : ∀ {i i' : J} (u : i ⟶ i'), Φ u ≫ fst_i i = fst_i i' :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hΦ_snd : ∀ {i i' : J} (u : i ⟶ i'),
      Φ u ≫ g_i i = g_i i' ≫ AlgebraicGeometry.Spec.map (R_diag.map u) :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hPb_Φ : ∀ {i i' : J} (u : i ⟶ i'),
      CategoryTheory.IsPullback (Φ u) (g_i i') (g_i i)
        (AlgebraicGeometry.Spec.map (R_diag.map u)) := by
    intro i i' u
    refine CategoryTheory.IsPullback.of_right ?_ (hΦ_snd u)
      (CategoryTheory.IsPullback.of_hasPullback g₁ (f_base i))
    have hcomp_f : AlgebraicGeometry.Spec.map (R_diag.map u) ≫ f_base i = f_base i' := by
      dsimp [f_base]
      rw [← AlgebraicGeometry.Spec.map_comp, hα_nat u]
    rw [hΦ_fst u, hcomp_f]
    exact CategoryTheory.IsPullback.of_hasPullback g₁ (f_base i')

  have hι_Φ : ∀ {i i' : J} (u : i ⟶ i'), ι_i i' ≫ Φ u = ι_i i := by
    intro i i' u
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (ι_i i' ≫ Φ u) ≫ fst_i i = ι_i i ≫ fst_i i
      rw [CategoryTheory.Category.assoc, hΦ_fst u,
        CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
    · change (ι_i i' ≫ Φ u) ≫ g_i i = ι_i i ≫ g_i i
      rw [CategoryTheory.Category.assoc, hΦ_snd u,
        ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, hι_nat u]

  have hτ_Φ : ∀ {i i' : J} (u : i ⟶ i') (j : Fin n),
      τ_i i' j ≫ Φ u = AlgebraicGeometry.Spec.map (R_diag.map u) ≫ τ_i i j := by
    intro i i' u j
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (τ_i i' j ≫ Φ u) ≫ fst_i i = (AlgebraicGeometry.Spec.map (R_diag.map u) ≫ τ_i i j) ≫ fst_i i
      rw [CategoryTheory.Category.assoc, hΦ_fst u, hτ_fst i' j,
        CategoryTheory.Category.assoc, hτ_fst i j, ← CategoryTheory.Category.assoc]
      dsimp [f_base]
      rw [← AlgebraicGeometry.Spec.map_comp, hα_nat u]
    · change (τ_i i' j ≫ Φ u) ≫ g_i i = (AlgebraicGeometry.Spec.map (R_diag.map u) ≫ τ_i i j) ≫ g_i i
      rw [CategoryTheory.Category.assoc, hΦ_snd u,
        ← CategoryTheory.Category.assoc, hSec_i i' j, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.assoc, hSec_i i j, CategoryTheory.Category.comp_id]

  obtain ⟨hc⟩ := hColim

  
  have h_s2_aff : ∀ (V_V : C_V.Opens), AlgebraicGeometry.IsAffineOpen V_V →
      ∃ (i₀ : J) (W₀ : (C_i i₀).Opens),
        AlgebraicGeometry.IsAffineOpen W₀ ∧
        (TopologicalSpace.Opens.map (ι_i i₀).base).obj W₀ = V_V := by
    intro V_V hAffV
    haveI : CategoryTheory.IsCofiltered Jᵒᵖ := CategoryTheory.isCofiltered_op_of_isFiltered J
    let c_ring : CategoryTheory.Limits.Cocone R_diag :=
      CategoryTheory.Limits.Cocone.mk (CommRingCat.of R_V) ι_colim
    haveI : CategoryTheory.Limits.PreservesLimitsOfSize.{u, u} AlgebraicGeometry.Scheme.Spec :=
      CategoryTheory.Adjunction.rightAdjoint_preservesLimits AlgebraicGeometry.ΓSpec.adjunction
    let D_base : Jᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u} :=
      R_diag.op ⋙ AlgebraicGeometry.Scheme.Spec
    let c_base : CategoryTheory.Limits.Cone D_base :=
      AlgebraicGeometry.Scheme.Spec.mapCone c_ring.op
    have hc_base : CategoryTheory.Limits.IsLimit c_base :=
      CategoryTheory.Limits.isLimitOfPreserves AlgebraicGeometry.Scheme.Spec hc.op
    let D_C : Jᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u} :=
      { obj := fun k => C_i k.unop
        map := fun f => Φ f.unop
        map_id := by
          intro k
          apply CategoryTheory.Limits.pullback.hom_ext
          · change Φ (𝟙 k.unop) ≫ fst_i k.unop = 𝟙 (C_i k.unop) ≫ fst_i k.unop
            rw [hΦ_fst, CategoryTheory.Category.id_comp]
          · change Φ (𝟙 k.unop) ≫ g_i k.unop = 𝟙 (C_i k.unop) ≫ g_i k.unop
            rw [hΦ_snd, R_diag.map_id, AlgebraicGeometry.Spec.map_id,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        map_comp := by
          intro k₁ k₂ k₃ f₁ f₂
          apply CategoryTheory.Limits.pullback.hom_ext
          · change Φ (f₂.unop ≫ f₁.unop) ≫ fst_i k₃.unop = (Φ f₁.unop ≫ Φ f₂.unop) ≫ fst_i k₃.unop
            rw [hΦ_fst, CategoryTheory.Category.assoc, hΦ_fst, hΦ_fst]
          · change Φ (f₂.unop ≫ f₁.unop) ≫ g_i k₃.unop = (Φ f₁.unop ≫ Φ f₂.unop) ≫ g_i k₃.unop
            rw [hΦ_snd, R_diag.map_comp, AlgebraicGeometry.Spec.map_comp,
              CategoryTheory.Category.assoc, hΦ_snd, ← CategoryTheory.Category.assoc (Φ f₁.unop),
              hΦ_snd, CategoryTheory.Category.assoc] }
    let c_C : CategoryTheory.Limits.Cone D_C :=
      { pt := C_V
        π :=
          { app := fun k => ι_i k.unop
            naturality := by
              intro k₁ k₂ f
              dsimp [D_C]
              rw [CategoryTheory.Category.id_comp, hι_Φ f.unop] } }
    obtain ⟨i_init⟩ := CategoryTheory.IsFiltered.nonempty (C := J)
    let k_init : Jᵒᵖ := Opposite.op i_init
    let mk_s_base : CategoryTheory.Limits.Cone D_C → CategoryTheory.Limits.Cone D_base :=
      fun s =>
        { pt := s.pt
          π :=
            { app := fun k => s.π.app k ≫ g_i k.unop
              naturality := by
                intro k₁ k₂ f
                dsimp [D_base]
                rw [CategoryTheory.Category.id_comp, ← s.w f]
                dsimp [D_C]
                rw [CategoryTheory.Category.assoc, hΦ_snd, CategoryTheory.Category.assoc] } }
    have hc_C : CategoryTheory.Limits.IsLimit c_C :=
      { lift := fun s =>
          hPb₁.lift (s.π.app k_init ≫ fst_i i_init) (hc_base.lift (mk_s_base s))
            (by
              have h1 : (s.π.app k_init ≫ fst_i i_init) ≫ g₁ =
                  (s.π.app k_init ≫ g_i i_init) ≫ f_base i_init := by
                rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
                  CategoryTheory.Category.assoc]
              have h2 : s.π.app k_init ≫ g_i i_init =
                  hc_base.lift (mk_s_base s) ≫ c_base.π.app k_init :=
                (hc_base.fac (mk_s_base s) k_init).symm
              rw [h1, h2, CategoryTheory.Category.assoc]
              change hc_base.lift (mk_s_base s) ≫
                  (AlgebraicGeometry.Spec.map (ι_colim.app i_init) ≫
                    AlgebraicGeometry.Spec.map (α_diag.app i_init)) =
                hc_base.lift (mk_s_base s) ≫ AlgebraicGeometry.Spec.map β₁
              rw [← AlgebraicGeometry.Spec.map_comp, hα_comp i_init])
        fac := by
          intro s k
          have hfst_const : s.π.app k_init ≫ fst_i i_init = s.π.app k ≫ fst_i k.unop := by
            let k_min : Jᵒᵖ := CategoryTheory.IsCofiltered.min k_init k
            let f₁ : k_min ⟶ k_init := CategoryTheory.IsCofiltered.minToLeft k_init k
            let f₂ : k_min ⟶ k := CategoryTheory.IsCofiltered.minToRight k_init k
            calc
              s.π.app k_init ≫ fst_i i_init
                = (s.π.app k_min ≫ D_C.map f₁) ≫ fst_i i_init := by rw [s.w f₁]
              _ = s.π.app k_min ≫ fst_i k_min.unop := by
                dsimp [D_C]
                rw [CategoryTheory.Category.assoc, hΦ_fst]
              _ = (s.π.app k_min ≫ D_C.map f₂) ≫ fst_i k.unop := by
                dsimp [D_C]
                rw [CategoryTheory.Category.assoc, hΦ_fst]
              _ = s.π.app k ≫ fst_i k.unop := by rw [s.w f₂]
          apply CategoryTheory.Limits.pullback.hom_ext
          · change (_ ≫ ι_i k.unop) ≫ fst_i k.unop = s.π.app k ≫ fst_i k.unop
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              hPb₁.lift_fst, hfst_const]
          · change (_ ≫ ι_i k.unop) ≫ g_i k.unop = s.π.app k ≫ g_i k.unop
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc, hPb₁.lift_snd]
            exact hc_base.fac (mk_s_base s) k
        uniq := by
          intro s m hm
          apply hPb₁.hom_ext
          · rw [hPb₁.lift_fst, ← hm k_init]
            change m ≫ ι₁ = (m ≫ ι_i i_init) ≫ fst_i i_init
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
          · rw [hPb₁.lift_snd]
            apply hc_base.hom_ext
            intro k
            rw [hc_base.fac (mk_s_base s) k]
            change (m ≫ g_V) ≫ AlgebraicGeometry.Spec.map (ι_colim.app k.unop) =
              s.π.app k ≫ g_i k.unop
            rw [← hm k]
            change m ≫ (g_V ≫ AlgebraicGeometry.Spec.map (ι_colim.app k.unop)) =
              (m ≫ ι_i k.unop) ≫ g_i k.unop
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd] }
    haveI : ∀ {k₁ k₂ : Jᵒᵖ} (f : k₁ ⟶ k₂), AlgebraicGeometry.IsAffineHom (D_C.map f) := by
      intro k₁ k₂ f
      have hAffBase : AlgebraicGeometry.IsAffineHom (AlgebraicGeometry.Spec.map (R_diag.map f.unop)) :=
        inferInstance
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hPb_Φ f.unop).flip hAffBase
    haveI : ∀ k : Jᵒᵖ, QuasiSeparatedSpace ↥(D_C.obj k) := by
      intro k
      haveI : AlgebraicGeometry.IsSeparated (g_i k.unop) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback g₁ (f_base k.unop)) hSep₁
      have hTermEq : g_i k.unop ≫
          CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec (R_diag.obj k.unop)) =
          CategoryTheory.Limits.terminal.from (D_C.obj k) :=
        CategoryTheory.Limits.terminal.hom_ext _ _
      have hSepTerm : AlgebraicGeometry.IsSeparated
          (CategoryTheory.Limits.terminal.from (D_C.obj k)) := by
        rw [← hTermEq]
        infer_instance
      haveI : (D_C.obj k).IsSeparated := AlgebraicGeometry.Scheme.IsSeparated.mk hSepTerm
      infer_instance
    obtain ⟨k₀, W₀, hAff₀, hPre₀⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_preimage_eq D_C c_C hc_C V_V hAffV
    exact ⟨k₀.unop, W₀, hAff₀, hPre₀⟩

  
  have h_s4 : ∀ (R₀ : CommRingCat.{u}) (C₀ : AlgebraicGeometry.Scheme.{u})
      (g₀ : C₀ ⟶ AlgebraicGeometry.Spec R₀),
      AlgebraicGeometry.LocallyOfFinitePresentation g₀ →
      ∀ (W₀ : C₀.Opens), AlgebraicGeometry.IsAffineOpen W₀ →
      ∃ (B₀ : CommRingCat.{u}) (φ₀ : R₀ ⟶ B₀),
        φ₀.hom.FinitePresentation ∧
        (∀ (B_V : CommRingCat.{u}) (β₀ : R₀ ⟶ CommRingCat.of R_V)
           (φ_V : CommRingCat.of R_V ⟶ B_V) (ι_V : C_V ⟶ C₀)
           (V_V : C_V.Opens) (e_V : V_V.toScheme ≅ AlgebraicGeometry.Spec B_V),
           CategoryTheory.IsPullback ι_V g_V g₀ (AlgebraicGeometry.Spec.map β₀) →
           (TopologicalSpace.Opens.map ι_V.base).obj W₀ = V_V →
           V_V.ι ≫ g_V = e_V.hom ≫ AlgebraicGeometry.Spec.map φ_V →
           ∃ π_V : B₀ ⟶ B_V, CategoryTheory.IsPushout β₀ φ₀ φ_V π_V) ∧
        (∀ (R' B' : CommRingCat.{u}) (f : R₀ ⟶ R') (φ' : R' ⟶ B') (π' : B₀ ⟶ B')
           (C' : AlgebraicGeometry.Scheme.{u}) (g' : C' ⟶ AlgebraicGeometry.Spec R')
           (ι' : C' ⟶ C₀) (W' : C'.Opens),
           CategoryTheory.IsPullback ι' g' g₀ (AlgebraicGeometry.Spec.map f) →
           (TopologicalSpace.Opens.map ι'.base).obj W₀ = W' →
           CategoryTheory.IsPushout f φ₀ φ' π' →
           RingHom.IsStandardSmoothOfRelativeDimension 1 φ'.hom →
           AlgebraicGeometry.SmoothOfRelativeDimension 1 (W'.ι ≫ g')) := by
    intro R₀ C₀ g₀ hLFP₀ W₀ hAff₀
    let B₀ : CommRingCat.{u} := C₀.presheaf.obj (Opposite.op W₀)
    let φ₀ : R₀ ⟶ B₀ := AlgebraicGeometry.Spec.preimage (hAff₀.isoSpec.inv ≫ W₀.ι ≫ g₀)
    have hSpec_φ₀ : AlgebraicGeometry.Spec.map φ₀ = hAff₀.isoSpec.inv ≫ W₀.ι ≫ g₀ :=
      AlgebraicGeometry.Spec.map_preimage _
    have hFac₀ : W₀.ι ≫ g₀ = hAff₀.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ₀ := by
      rw [hSpec_φ₀, CategoryTheory.Iso.hom_inv_id_assoc]
    have hLFP_φ₀ : AlgebraicGeometry.LocallyOfFinitePresentation (AlgebraicGeometry.Spec.map φ₀) := by
      rw [hSpec_φ₀]
      infer_instance
    have hFP₀ : φ₀.hom.FinitePresentation :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mp hLFP_φ₀
    refine ⟨B₀, φ₀, hFP₀, ?_, ?_⟩
    · intro B_V β₀ φ_V ι_V V_V e_V hPb_V hPre_V hFac_V
      have hSub_V : (V_V : Set C_V) ⊆ ((TopologicalSpace.Opens.map ι_V.base).obj W₀ : Set C_V) := by
        rw [hPre_V]
      let π_W : V_V.toScheme ⟶ W₀.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift W₀.ι (V_V.ι ≫ ι_V) (by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨x, rfl⟩
          exact hSub_V x.2)
      have hPb_open : CategoryTheory.IsPullback π_W V_V.ι W₀.ι ι_V :=
        AlgebraicGeometry.IsOpenImmersion.isPullback π_W V_V.ι W₀.ι ι_V
          (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _).symm
          (by
            rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι,
              AlgebraicGeometry.Scheme.Opens.opensRange_ι, hPre_V])
      have hPb_vert : CategoryTheory.IsPullback π_W (V_V.ι ≫ g_V) (W₀.ι ≫ g₀)
          (AlgebraicGeometry.Spec.map β₀) :=
        hPb_open.paste_vert hPb_V
      have hPb_left : CategoryTheory.IsPullback e_V.inv (AlgebraicGeometry.Spec.map φ_V)
          (V_V.ι ≫ g_V) (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R_V))) :=
        CategoryTheory.IsPullback.of_horiz_isIso
          ⟨by rw [hFac_V, CategoryTheory.Iso.inv_hom_id_assoc, CategoryTheory.Category.comp_id]⟩
      have hPb_right : CategoryTheory.IsPullback hAff₀.isoSpec.hom (W₀.ι ≫ g₀)
          (AlgebraicGeometry.Spec.map φ₀) (𝟙 (AlgebraicGeometry.Spec R₀)) :=
        CategoryTheory.IsPullback.of_horiz_isIso
          ⟨by rw [hFac₀, CategoryTheory.Category.comp_id]⟩
      let π_V : B₀ ⟶ B_V :=
        AlgebraicGeometry.Spec.preimage (e_V.inv ≫ π_W ≫ hAff₀.isoSpec.hom)
      have hSpec_πV : AlgebraicGeometry.Spec.map π_V = e_V.inv ≫ π_W ≫ hAff₀.isoSpec.hom :=
        AlgebraicGeometry.Spec.map_preimage _
      have hPb_Spec : CategoryTheory.IsPullback (AlgebraicGeometry.Spec.map π_V)
          (AlgebraicGeometry.Spec.map φ_V) (AlgebraicGeometry.Spec.map φ₀)
          (AlgebraicGeometry.Spec.map β₀) := by
        have hp := (hPb_left.paste_horiz hPb_vert).paste_horiz hPb_right
        simpa only [CategoryTheory.Category.assoc, CategoryTheory.Category.id_comp,
          CategoryTheory.Category.comp_id, ← hSpec_πV] using hp
      letI : Algebra ↑R₀ R_V := β₀.hom.toAlgebra
      letI : Algebra ↑R₀ ↑B₀ := φ₀.hom.toAlgebra
      let P : CommRingCat.{u} := CommRingCat.of (TensorProduct ↑R₀ R_V ↑B₀)
      let inl_P : CommRingCat.of R_V ⟶ P :=
        CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
      let inr_P : B₀ ⟶ P :=
        CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom
      have hPush_tp : CategoryTheory.IsPushout β₀ φ₀ inl_P inr_P :=
        CommRingCat.isPushout_tensorProduct ↑R₀ R_V ↑B₀
      have hPb_tp : CategoryTheory.IsPullback (AlgebraicGeometry.Spec.map inr_P)
          (AlgebraicGeometry.Spec.map inl_P) (AlgebraicGeometry.Spec.map φ₀)
          (AlgebraicGeometry.Spec.map β₀) :=
        AlgebraicGeometry.isPullback_SpecMap_of_isPushout φ₀ β₀ inr_P inl_P hPush_tp.flip
      let e_Spec : AlgebraicGeometry.Spec B_V ≅ AlgebraicGeometry.Spec P :=
        CategoryTheory.IsPullback.isoIsPullback _ _ hPb_Spec hPb_tp
      have he_fst : e_Spec.hom ≫ AlgebraicGeometry.Spec.map inr_P =
          AlgebraicGeometry.Spec.map π_V :=
        CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPb_Spec hPb_tp
      have he_snd : e_Spec.hom ≫ AlgebraicGeometry.Spec.map inl_P =
          AlgebraicGeometry.Spec.map φ_V :=
        CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPb_Spec hPb_tp
      let e_ring : P ≅ B_V :=
        { hom := AlgebraicGeometry.Spec.preimage e_Spec.hom
          inv := AlgebraicGeometry.Spec.preimage e_Spec.inv
          hom_inv_id := by
            apply AlgebraicGeometry.Spec.map_injective
            rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
              AlgebraicGeometry.Spec.map_preimage, e_Spec.inv_hom_id,
              AlgebraicGeometry.Spec.map_id]
          inv_hom_id := by
            apply AlgebraicGeometry.Spec.map_injective
            rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
              AlgebraicGeometry.Spec.map_preimage, e_Spec.hom_inv_id,
              AlgebraicGeometry.Spec.map_id] }
      have hinl : inl_P ≫ e_ring.hom = φ_V := by
        apply AlgebraicGeometry.Spec.map_injective
        dsimp [e_ring]
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage, he_snd]
      have hinr : inr_P ≫ e_ring.hom = π_V := by
        apply AlgebraicGeometry.Spec.map_injective
        dsimp [e_ring]
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage, he_fst]
      refine ⟨π_V, ?_⟩
      exact hPush_tp.of_iso (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (CategoryTheory.Iso.refl _) e_ring
        (by simp) (by simp)
        (by simpa using hinl)
        (by simpa using hinr)
    · intro R' B' f φ' π' C' g' ι' W' hPb' hPre' hPush' hSm'
      have hSub_W' : (W' : Set C') ⊆ ((TopologicalSpace.Opens.map ι'.base).obj W₀ : Set C') := by
        rw [hPre']
      let π_W' : W'.toScheme ⟶ W₀.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift W₀.ι (W'.ι ≫ ι') (by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨x, rfl⟩
          exact hSub_W' x.2)
      have hPb_open' : CategoryTheory.IsPullback π_W' W'.ι W₀.ι ι' :=
        AlgebraicGeometry.IsOpenImmersion.isPullback π_W' W'.ι W₀.ι ι'
          (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _).symm
          (by
            rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι,
              AlgebraicGeometry.Scheme.Opens.opensRange_ι, hPre'])
      have hPb_vert' : CategoryTheory.IsPullback π_W' (W'.ι ≫ g') (W₀.ι ≫ g₀)
          (AlgebraicGeometry.Spec.map f) :=
        hPb_open'.paste_vert hPb'
      have hPb_right : CategoryTheory.IsPullback hAff₀.isoSpec.hom (W₀.ι ≫ g₀)
          (AlgebraicGeometry.Spec.map φ₀) (𝟙 (AlgebraicGeometry.Spec R₀)) :=
        CategoryTheory.IsPullback.of_horiz_isIso
          ⟨by rw [hFac₀, CategoryTheory.Category.comp_id]⟩
      have hPb_W' : CategoryTheory.IsPullback (π_W' ≫ hAff₀.isoSpec.hom) (W'.ι ≫ g')
          (AlgebraicGeometry.Spec.map φ₀) (AlgebraicGeometry.Spec.map f) := by
        simpa only [CategoryTheory.Category.comp_id] using hPb_vert'.paste_horiz hPb_right
      have hPb_B' : CategoryTheory.IsPullback (AlgebraicGeometry.Spec.map π')
          (AlgebraicGeometry.Spec.map φ') (AlgebraicGeometry.Spec.map φ₀)
          (AlgebraicGeometry.Spec.map f) :=
        AlgebraicGeometry.isPullback_SpecMap_of_isPushout φ₀ f π' φ' hPush'.flip
      let e' : W'.toScheme ≅ AlgebraicGeometry.Spec B' :=
        CategoryTheory.IsPullback.isoIsPullback _ _ hPb_W' hPb_B'
      have he'_snd : e'.hom ≫ AlgebraicGeometry.Spec.map φ' = W'.ι ≫ g' :=
        CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPb_W' hPb_B'
      have hLoc' : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension 1) φ'.hom :=
        RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso φ'.hom hSm'
      have hSm_Spec : AlgebraicGeometry.SmoothOfRelativeDimension 1
          (AlgebraicGeometry.Spec.map φ') :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)).mpr hLoc'
      have hPb_e' : CategoryTheory.IsPullback e'.hom (W'.ι ≫ g')
          (AlgebraicGeometry.Spec.map φ') (𝟙 (AlgebraicGeometry.Spec R')) :=
        CategoryTheory.IsPullback.of_horiz_isIso
          ⟨by rw [he'_snd, CategoryTheory.Category.comp_id]⟩
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_e' hSm_Spec

  
  have hTensorPushout : ∀ {R S T : CommRingCat.{u}} (f : R ⟶ S) (g : R ⟶ T),
      ∃ (P : CommRingCat.{u}) (inl : S ⟶ P) (inr : T ⟶ P),
        CategoryTheory.IsPushout f g inl inr ∧
        (g.hom.FinitePresentation → inl.hom.FinitePresentation) ∧
        (RingHom.IsStandardSmoothOfRelativeDimension 1 g.hom →
          RingHom.IsStandardSmoothOfRelativeDimension 1 inl.hom) := by
    intro R S T f g
    letI : Algebra ↑R ↑S := f.hom.toAlgebra
    letI : Algebra ↑R ↑T := g.hom.toAlgebra
    refine ⟨CommRingCat.of (TensorProduct ↑R ↑S ↑T),
      CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom,
      CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom,
      CommRingCat.isPushout_tensorProduct ↑R ↑S ↑T, ?_, ?_⟩
    · intro hFP
      haveI : Algebra.FinitePresentation ↑R ↑T := RingHom.finitePresentation_algebraMap.mp hFP
      haveI : Algebra.FinitePresentation ↑S (TensorProduct ↑R ↑S ↑T) :=
        Algebra.FinitePresentation.baseChange ↑S
      exact RingHom.finitePresentation_algebraMap.mpr inferInstance
    · intro hSm
      haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 ↑R ↑T :=
        (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mp hSm
      haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 ↑S (TensorProduct ↑R ↑S ↑T) :=
        Algebra.IsStandardSmoothOfRelativeDimension.baseChange 1 ↑S
      exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr inferInstance

  
  
  have h_s3 : ∀ {R₀ B₀ B_V : CommRingCat.{u}}
      (β₀ : R₀ ⟶ CommRingCat.of R_V)
      (φ₀ : R₀ ⟶ B₀),
      φ₀.hom.FinitePresentation →
      ∀ (φ_V : CommRingCat.of R_V ⟶ B_V) (π_B : B₀ ⟶ B_V),
      CategoryTheory.IsPushout β₀ φ₀ φ_V π_B →
      RingHom.IsStandardSmoothOfRelativeDimension 1 φ_V.hom →
      ∀ {K : Type u} [CategoryTheory.SmallCategory K] [CategoryTheory.IsFiltered K]
        (D_ring : CategoryTheory.Functor K CommRingCat.{u})
        (α_K : (CategoryTheory.Functor.const K).obj R₀ ⟶ D_ring)
        (ι_K : D_ring ⟶ (CategoryTheory.Functor.const K).obj (CommRingCat.of R_V)),
        CategoryTheory.Limits.IsColimit
          (CategoryTheory.Limits.Cocone.mk (CommRingCat.of R_V) ι_K) →
        (∀ k : K, α_K.app k ≫ ι_K.app k = β₀) →
        ∃ (k : K) (B_k : CommRingCat.{u}) (φ_k : D_ring.obj k ⟶ B_k) (π_k : B₀ ⟶ B_k),
          CategoryTheory.IsPushout (α_K.app k) φ₀ φ_k π_k ∧
          RingHom.IsStandardSmoothOfRelativeDimension 1 φ_k.hom := by
    intro R₀ B₀ B_V β₀ φ₀ hFP₀ φ_V π_B hPushV hSmV K _ _ D_ring α_K ι_K hc_K hα_K
    
    let Z : Type u := ULift.{u} ℤ
    haveI : IsNoetherianRing Z := isNoetherianRing_of_ringEquiv ℤ ULift.ringEquiv.symm
    let zHom : ∀ (A : Type u) [CommRing A], Z →+* A :=
      fun A _ => (Int.castRingHom A).comp ULift.ringEquiv.toRingHom
    let Z_cat : CommRingCat.{u} := CommRingCat.of Z
    have hZ_uniq : ∀ {X : CommRingCat.{u}} (f₁ f₂ : Z_cat ⟶ X), f₁ = f₂ := by
      intro X f₁ f₂
      ext ⟨m⟩
      exact RingHom.congr_fun
        (RingHom.ext_int (f₁.hom.comp ULift.ringEquiv.symm.toRingHom)
          (f₂.hom.comp ULift.ringEquiv.symm.toRingHom)) m
    letI : Algebra Z R_V := (zHom R_V).toAlgebra
    letI : Algebra R_V ↑B_V := φ_V.hom.toAlgebra
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 R_V ↑B_V :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mp hSmV
    obtain ⟨A_sub, D₀, instCommRingD₀, instAlgAD₀, hFG, hSmD₀, ⟨e_alg⟩⟩ :=
      Algebra.IsStandardSmoothOfRelativeDimension.exists_subalgebra_fg Z R_V ↑B_V 1
    letI : CommRing D₀ := instCommRingD₀
    letI : Algebra ↥A_sub D₀ := instAlgAD₀
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 ↥A_sub D₀ := hSmD₀
    
    haveI : Algebra.FiniteType Z ↥A_sub := (Subalgebra.fg_iff_finiteType A_sub).mp hFG
    haveI : Algebra.FinitePresentation Z ↥A_sub :=
      (Algebra.FinitePresentation.of_finiteType (R := Z) (A := ↥A_sub)).mp inferInstance
    let A_cat : CommRingCat.{u} := CommRingCat.of ↥A_sub
    let f_ZA : Z_cat ⟶ A_cat := CommRingCat.ofHom (algebraMap Z ↥A_sub)
    have hf_ZA_fp : f_ZA.hom.FinitePresentation :=
      RingHom.finitePresentation_algebraMap.mpr inferInstance
    let α_Z : (CategoryTheory.Functor.const K).obj Z_cat ⟶ D_ring :=
      { app := fun k => CommRingCat.ofHom (zHom ↑(D_ring.obj k))
        naturality := fun _ _ _ => hZ_uniq _ _ }
    let c_K : CategoryTheory.Limits.Cocone D_ring :=
      CategoryTheory.Limits.Cocone.mk (CommRingCat.of R_V) ι_K
    let β_A : A_cat ⟶ CommRingCat.of R_V := CommRingCat.ofHom A_sub.val.toRingHom
    obtain ⟨k_A, lift_A, _, hlift_A_eq⟩ :=
      RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit Z_cat D_ring α_Z f_ZA c_K hc_K
        hf_ZA_fp β_A (fun _ => hZ_uniq _ _)
    have hlift_A : lift_A ≫ ι_K.app k_A = β_A := hlift_A_eq.symm
    
    let R₁' : CommRingCat.{u} := D_ring.obj k_A
    let α₁' : R₀ ⟶ R₁' := α_K.app k_A
    let ι₁' : R₁' ⟶ CommRingCat.of R_V := ι_K.app k_A

    obtain ⟨B₁_M, φ_M, π_M, hPush_M, hFP_M_imp, _⟩ := hTensorPushout α₁' φ₀
    have hFP_φM : φ_M.hom.FinitePresentation := hFP_M_imp hFP₀
    have hEss_φM : φ_M.hom.EssFiniteType := by
      letI : Algebra ↑R₁' ↑B₁_M := φ_M.hom.toAlgebra
      haveI : Algebra.FinitePresentation ↑R₁' ↑B₁_M := RingHom.finitePresentation_algebraMap.mp hFP_φM
      haveI : Algebra.FiniteType ↑R₁' ↑B₁_M := Algebra.FiniteType.of_finitePresentation
      exact (RingHom.finiteType_algebraMap.mpr inferInstance).essFiniteType

    let D_cat : CommRingCat.{u} := CommRingCat.of D₀
    let φ_D : A_cat ⟶ D_cat := CommRingCat.ofHom (algebraMap ↥A_sub D₀)
    have hSm_φD : RingHom.IsStandardSmoothOfRelativeDimension 1 φ_D.hom :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hSmD₀
    obtain ⟨B₁_N, φ_N, π_N, hPush_N, _, hSm_N_imp⟩ := hTensorPushout lift_A φ_D
    have hSm_φN : RingHom.IsStandardSmoothOfRelativeDimension 1 φ_N.hom := hSm_N_imp hSm_φD
    have hFP_φN : φ_N.hom.FinitePresentation := by
      letI : Algebra ↑R₁' ↑B₁_N := φ_N.hom.toAlgebra
      haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 ↑R₁' ↑B₁_N :=
        (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mp hSm_φN
      haveI : Algebra.IsStandardSmooth ↑R₁' ↑B₁_N :=
        Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
      haveI : Algebra.FinitePresentation ↑R₁' ↑B₁_N := Algebra.IsStandardSmooth.finitePresentation
      exact RingHom.finitePresentation_algebraMap.mpr inferInstance
    have hEss_φN : φ_N.hom.EssFiniteType := by
      letI : Algebra ↑R₁' ↑B₁_N := φ_N.hom.toAlgebra
      haveI : Algebra.FinitePresentation ↑R₁' ↑B₁_N := RingHom.finitePresentation_algebraMap.mp hFP_φN
      haveI : Algebra.FiniteType ↑R₁' ↑B₁_N := Algebra.FiniteType.of_finitePresentation
      exact (RingHom.finiteType_algebraMap.mpr inferInstance).essFiniteType

    
    let K' := CategoryTheory.Under k_A
    let D_ring' : K' ⥤ CommRingCat.{u} := CategoryTheory.Under.forget k_A ⋙ D_ring
    let c_R' : CategoryTheory.Limits.Cocone D_ring' :=
      c_K.whisker (CategoryTheory.Under.forget k_A)
    have hc_R' : CategoryTheory.Limits.IsColimit c_R' :=
      (CategoryTheory.Functor.Final.isColimitWhiskerEquiv
        (CategoryTheory.Under.forget k_A) c_K).symm hc_K
    have hι_K_nat : ∀ u : K', D_ring.map u.hom ≫ ι_K.app u.right = ι₁' :=
      fun u => (ι_K.naturality u.hom).trans (CategoryTheory.Category.comp_id _)

    
    have hPushColim : ∀ {Q : CommRingCat.{u}} (φ_Q : R₁' ⟶ Q),
        ∃ (F_Q : K' ⥤ CommRingCat.{u})
          (inl_Q : ∀ u : K', D_ring.obj u.right ⟶ F_Q.obj u)
          (inr_Q : ∀ u : K', Q ⟶ F_Q.obj u)
          (c_Q : CategoryTheory.Limits.Cocone F_Q)
          (inl_V : CommRingCat.of R_V ⟶ c_Q.pt)
          (inr_V : Q ⟶ c_Q.pt),
          Nonempty (CategoryTheory.Limits.IsColimit c_Q) ∧
          (∀ u : K', CategoryTheory.IsPushout (D_ring.map u.hom) φ_Q (inl_Q u) (inr_Q u)) ∧
          (∀ u : K', RingHom.IsStandardSmoothOfRelativeDimension 1 φ_Q.hom →
            RingHom.IsStandardSmoothOfRelativeDimension 1 (inl_Q u).hom) ∧
          CategoryTheory.IsPushout ι₁' φ_Q inl_V inr_V ∧
          (∀ {u₁ u₂ : K'} (m : u₁ ⟶ u₂),
            inl_Q u₁ ≫ F_Q.map m = D_ring.map m.right ≫ inl_Q u₂ ∧
            inr_Q u₁ ≫ F_Q.map m = inr_Q u₂) ∧
          (∀ u : K',
            inl_Q u ≫ c_Q.ι.app u = ι_K.app u.right ≫ inl_V ∧
            inr_Q u ≫ c_Q.ι.app u = inr_V) := by
      intro Q φ_Q
      have hStepQ : ∀ u : K',
          ∃ (P_u : CommRingCat.{u}) (inl_u : D_ring.obj u.right ⟶ P_u) (inr_u : Q ⟶ P_u),
            CategoryTheory.IsPushout (D_ring.map u.hom) φ_Q inl_u inr_u ∧
            (RingHom.IsStandardSmoothOfRelativeDimension 1 φ_Q.hom →
              RingHom.IsStandardSmoothOfRelativeDimension 1 inl_u.hom) := by
        intro u
        obtain ⟨P_u, inl_u, inr_u, hP_u, _, hSm_u⟩ := hTensorPushout (D_ring.map u.hom) φ_Q
        exact ⟨P_u, inl_u, inr_u, hP_u, hSm_u⟩
      choose obj_Q inl_Q inr_Q hP_u hSm_Q using hStepQ
      obtain ⟨P_V, inl_V, inr_V, hP_V, _, _⟩ := hTensorPushout ι₁' φ_Q
      let map_Q : ∀ {u₁ u₂ : K'} (_ : u₁ ⟶ u₂), obj_Q u₁ ⟶ obj_Q u₂ :=
        fun {u₁ u₂} m => (hP_u u₁).desc (D_ring.map m.right ≫ inl_Q u₂) (inr_Q u₂)
          (by
            rw [← CategoryTheory.Category.assoc, ← D_ring.map_comp,
              CategoryTheory.Under.w m, (hP_u u₂).w])
      have hmap_inl : ∀ {u₁ u₂ : K'} (m : u₁ ⟶ u₂),
          inl_Q u₁ ≫ map_Q m = D_ring.map m.right ≫ inl_Q u₂ :=
        fun _ => CategoryTheory.IsPushout.inl_desc _ _ _ _
      have hmap_inr : ∀ {u₁ u₂ : K'} (m : u₁ ⟶ u₂),
          inr_Q u₁ ≫ map_Q m = inr_Q u₂ :=
        fun _ => CategoryTheory.IsPushout.inr_desc _ _ _ _
      let F_Q : K' ⥤ CommRingCat.{u} :=
        { obj := obj_Q
          map := map_Q
          map_id := by
            intro u
            apply (hP_u u).hom_ext
            · rw [hmap_inl]
              change D_ring.map (𝟙 u.right) ≫ inl_Q u = inl_Q u ≫ 𝟙 (obj_Q u)
              rw [D_ring.map_id, CategoryTheory.Category.id_comp,
                CategoryTheory.Category.comp_id]
            · rw [hmap_inr, CategoryTheory.Category.comp_id]
          map_comp := by
            intro u₁ u₂ u₃ m₁ m₂
            apply (hP_u u₁).hom_ext
            · rw [hmap_inl]
              change D_ring.map (m₁.right ≫ m₂.right) ≫ inl_Q u₃ =
                inl_Q u₁ ≫ (map_Q m₁ ≫ map_Q m₂)
              rw [D_ring.map_comp, CategoryTheory.Category.assoc,
                ← CategoryTheory.Category.assoc (inl_Q u₁), hmap_inl,
                CategoryTheory.Category.assoc, hmap_inl]
            · rw [hmap_inr, ← CategoryTheory.Category.assoc, hmap_inr, hmap_inr] }
      let ι_Q_app : ∀ u : K', obj_Q u ⟶ P_V :=
        fun u => (hP_u u).desc (ι_K.app u.right ≫ inl_V) inr_V
          (by rw [← CategoryTheory.Category.assoc, hι_K_nat u, hP_V.w])
      have hι_inl : ∀ u : K', inl_Q u ≫ ι_Q_app u = ι_K.app u.right ≫ inl_V :=
        fun _ => CategoryTheory.IsPushout.inl_desc _ _ _ _
      have hι_inr : ∀ u : K', inr_Q u ≫ ι_Q_app u = inr_V :=
        fun _ => CategoryTheory.IsPushout.inr_desc _ _ _ _
      let c_Q : CategoryTheory.Limits.Cocone F_Q :=
        { pt := P_V
          ι :=
            { app := ι_Q_app
              naturality := by
                intro u₁ u₂ m
                dsimp [F_Q]
                rw [CategoryTheory.Category.comp_id]
                apply (hP_u u₁).hom_ext
                · change inl_Q u₁ ≫ (map_Q m ≫ ι_Q_app u₂) = inl_Q u₁ ≫ ι_Q_app u₁
                  rw [← CategoryTheory.Category.assoc, hmap_inl,
                    CategoryTheory.Category.assoc, hι_inl, hι_inl,
                    ← CategoryTheory.Category.assoc]
                  have hm_nat : D_ring.map m.right ≫ ι_K.app u₂.right = ι_K.app u₁.right :=
                    (ι_K.naturality m.right).trans (CategoryTheory.Category.comp_id _)
                  rw [hm_nat]
                · change inr_Q u₁ ≫ (map_Q m ≫ ι_Q_app u₂) = inr_Q u₁ ≫ ι_Q_app u₁
                  rw [← CategoryTheory.Category.assoc, hmap_inr, hι_inr, hι_inr] } }
      let u₀ : K' := CategoryTheory.Under.mk (𝟙 k_A)
      let m₀ : ∀ u : K', u₀ ⟶ u :=
        fun u => CategoryTheory.Under.homMk u.hom (CategoryTheory.Category.id_comp u.hom)
      let mk_s_R : CategoryTheory.Limits.Cocone F_Q → CategoryTheory.Limits.Cocone D_ring' :=
        fun s =>
          { pt := s.pt
            ι :=
              { app := fun u => (inl_Q u ≫ s.ι.app u : D_ring'.obj u ⟶ s.pt)
                naturality := by
                  intro u₁ u₂ m
                  dsimp [F_Q]
                  rw [CategoryTheory.Category.comp_id, ← s.w m]
                  change D_ring.map m.right ≫ (inl_Q u₂ ≫ s.ι.app u₂) =
                    inl_Q u₁ ≫ (map_Q m ≫ s.ι.app u₂)
                  rw [← CategoryTheory.Category.assoc (inl_Q u₁), hmap_inl,
                    CategoryTheory.Category.assoc] } }
      have hc_Q : CategoryTheory.Limits.IsColimit c_Q :=
        { desc := fun s =>
            hP_V.desc (hc_R'.desc (mk_s_R s)) (inr_Q u₀ ≫ s.ι.app u₀)
              (by
                have h1 : ι₁' ≫ hc_R'.desc (mk_s_R s) = inl_Q u₀ ≫ s.ι.app u₀ :=
                  hc_R'.fac (mk_s_R s) u₀
                have h2 : φ_Q ≫ inr_Q u₀ = inl_Q u₀ := by
                  rw [← (hP_u u₀).w]
                  change D_ring.map (𝟙 k_A) ≫ inl_Q u₀ = inl_Q u₀
                  rw [D_ring.map_id, CategoryTheory.Category.id_comp]
                rw [h1, ← CategoryTheory.Category.assoc, h2])
          fac := by
            intro s u
            have hinr_const : inr_Q u₀ ≫ s.ι.app u₀ = inr_Q u ≫ s.ι.app u := by
              rw [← s.w (m₀ u), ← CategoryTheory.Category.assoc]
              dsimp [F_Q]
              rw [hmap_inr]
            apply (hP_u u).hom_ext
            · change inl_Q u ≫ (ι_Q_app u ≫ _) = inl_Q u ≫ s.ι.app u
              rw [← CategoryTheory.Category.assoc, hι_inl, CategoryTheory.Category.assoc,
                CategoryTheory.IsPushout.inl_desc]
              exact hc_R'.fac (mk_s_R s) u
            · change inr_Q u ≫ (ι_Q_app u ≫ _) = inr_Q u ≫ s.ι.app u
              rw [← CategoryTheory.Category.assoc, hι_inr,
                CategoryTheory.IsPushout.inr_desc, hinr_const]
          uniq := by
            intro s m hm
            apply hP_V.hom_ext
            · rw [CategoryTheory.IsPushout.inl_desc]
              apply hc_R'.hom_ext
              intro u
              rw [hc_R'.fac (mk_s_R s) u]
              have hu := congrArg (inl_Q u ≫ ·) (hm u)
              change inl_Q u ≫ (ι_Q_app u ≫ m) = inl_Q u ≫ s.ι.app u at hu
              rw [← CategoryTheory.Category.assoc, hι_inl, CategoryTheory.Category.assoc] at hu
              exact hu
            · rw [CategoryTheory.IsPushout.inr_desc]
              have hu := congrArg (inr_Q u₀ ≫ ·) (hm u₀)
              change inr_Q u₀ ≫ (ι_Q_app u₀ ≫ m) = inr_Q u₀ ≫ s.ι.app u₀ at hu
              rw [← CategoryTheory.Category.assoc, hι_inr] at hu
              exact hu }
      exact ⟨F_Q, inl_Q, inr_Q, c_Q, inl_V, inr_V, ⟨hc_Q⟩, hP_u, hSm_Q, hP_V,
        fun m => ⟨hmap_inl m, hmap_inr m⟩, fun u => ⟨hι_inl u, hι_inr u⟩⟩

    obtain ⟨F_M, inl_M, inr_M, c_M, inl_MV, inr_MV, ⟨hc_M⟩, hP_Mu, _, hP_MV, hMap_M, hApp_M⟩ :=
      hPushColim φ_M
    obtain ⟨F_N, inl_N, inr_N, c_N, inl_NV, inr_NV, ⟨hc_N⟩, hP_Nu, hSm_Nu, hP_NV, hMap_N, hApp_N⟩ :=
      hPushColim φ_N

    
    have hP_M_β : CategoryTheory.IsPushout β₀ φ₀ inl_MV (π_M ≫ inr_MV) := by
      rw [← hα_K k_A]
      exact hPush_M.paste_horiz hP_MV
    let e_MB : c_M.pt ≅ B_V := CategoryTheory.IsPushout.isoIsPushout _ _ hP_M_β hPushV
    have he_MB : inl_MV ≫ e_MB.hom = φ_V :=
      CategoryTheory.IsPushout.inl_isoIsPushout_hom _ _ hP_M_β hPushV

    let P_AV : CommRingCat.{u} := CommRingCat.of (TensorProduct ↥A_sub R_V D₀)
    let inl_AV : CommRingCat.of R_V ⟶ P_AV :=
      CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
    let inr_AV : D_cat ⟶ P_AV :=
      CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom
    have hβ_A_eq : CommRingCat.ofHom (algebraMap ↥A_sub R_V) = β_A := by
      ext x
      rfl
    have hP_AV : CategoryTheory.IsPushout β_A φ_D inl_AV inr_AV := by
      rw [← hβ_A_eq]
      exact CommRingCat.isPushout_tensorProduct ↥A_sub R_V D₀
    have hP_N_β : CategoryTheory.IsPushout β_A φ_D inl_NV (π_N ≫ inr_NV) := by
      rw [← hlift_A]
      exact hPush_N.paste_horiz hP_NV
    let e_AN : P_AV ≅ c_N.pt := CategoryTheory.IsPushout.isoIsPushout _ _ hP_AV hP_N_β
    have he_AN : inl_AV ≫ e_AN.hom = inl_NV :=
      CategoryTheory.IsPushout.inl_isoIsPushout_hom _ _ hP_AV hP_N_β
    let e_BA : B_V ≅ P_AV :=
      { hom := CommRingCat.ofHom e_alg.toRingHom
        inv := CommRingCat.ofHom e_alg.symm.toRingHom
        hom_inv_id := by
          rw [← CommRingCat.ofHom_comp]
          exact congrArg CommRingCat.ofHom (RingHom.ext e_alg.symm_apply_apply)
        inv_hom_id := by
          rw [← CommRingCat.ofHom_comp]
          exact congrArg CommRingCat.ofHom (RingHom.ext e_alg.apply_symm_apply) }
    have he_BA : φ_V ≫ e_BA.hom = inl_AV := by
      ext r
      exact e_alg.commutes r
    let e_MN : c_M.pt ≅ c_N.pt := e_MB ≪≫ e_BA ≪≫ e_AN
    have he_MN_hom : inl_MV ≫ e_MN.hom = inl_NV := by
      simp only [e_MN, CategoryTheory.Iso.trans_hom, ← CategoryTheory.Category.assoc,
        he_MB, he_BA, he_AN]
    have he_MN_inv : inl_NV ≫ e_MN.inv = inl_MV := by
      rw [← he_MN_hom, CategoryTheory.Category.assoc, e_MN.hom_inv_id,
        CategoryTheory.Category.comp_id]

    
    let α_R1_M : (CategoryTheory.Functor.const K').obj R₁' ⟶ F_M :=
      { app := fun u => D_ring.map u.hom ≫ inl_M u
        naturality := by
          intro u₁ u₂ m
          dsimp
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, (hMap_M m).1,
            ← CategoryTheory.Category.assoc, ← D_ring.map_comp, CategoryTheory.Under.w m] }
    let α_R1_N : (CategoryTheory.Functor.const K').obj R₁' ⟶ F_N :=
      { app := fun u => D_ring.map u.hom ≫ inl_N u
        naturality := by
          intro u₁ u₂ m
          dsimp
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, (hMap_N m).1,
            ← CategoryTheory.Category.assoc, ← D_ring.map_comp, CategoryTheory.Under.w m] }

    obtain ⟨u₁, g_M, hg_M_lin, hg_M_eq⟩ :=
      RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit R₁' F_N α_R1_N φ_M c_N hc_N
        hFP_φM (inr_MV ≫ e_MN.hom)
        (by
          intro u
          dsimp [α_R1_N]
          rw [← CategoryTheory.Category.assoc, ← hP_MV.w, CategoryTheory.Category.assoc,
            he_MN_hom, CategoryTheory.Category.assoc, (hApp_N u).1,
            ← CategoryTheory.Category.assoc]
          change ι₁' ≫ inl_NV = (D_ring.map u.hom ≫ ι_K.app u.right) ≫ inl_NV
          rw [hι_K_nat u])

    obtain ⟨u₁', g_N', hg_N'_lin, hg_N'_eq⟩ :=
      RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit R₁' F_M α_R1_M φ_N c_M hc_M
        hFP_φN (inr_NV ≫ e_MN.inv)
        (by
          intro u
          dsimp [α_R1_M]
          rw [← CategoryTheory.Category.assoc, ← hP_NV.w, CategoryTheory.Category.assoc,
            he_MN_inv, CategoryTheory.Category.assoc, (hApp_M u).1,
            ← CategoryTheory.Category.assoc]
          change ι₁' ≫ inl_MV = (D_ring.map u.hom ≫ ι_K.app u.right) ≫ inl_MV
          rw [hι_K_nat u])

    let u₂ : K' := CategoryTheory.IsFiltered.max u₁ u₁'
    let m₁ : u₁ ⟶ u₂ := CategoryTheory.IsFiltered.leftToMax u₁ u₁'
    let m₁' : u₁' ⟶ u₂ := CategoryTheory.IsFiltered.rightToMax u₁ u₁'
    let g_M₂ : B₁_M ⟶ F_N.obj u₂ := g_M ≫ F_N.map m₁
    let g_N₂ : B₁_N ⟶ F_M.obj u₂ := g_N' ≫ F_M.map m₁'

    have hg_M₂_lin : φ_M ≫ g_M₂ = D_ring.map u₂.hom ≫ inl_N u₂ := by
      dsimp [g_M₂]
      rw [← CategoryTheory.Category.assoc, hg_M_lin]
      dsimp [α_R1_N]
      rw [CategoryTheory.Category.assoc, (hMap_N m₁).1, ← CategoryTheory.Category.assoc]
      change (D_ring.map u₁.hom ≫ D_ring.map m₁.right) ≫ inl_N u₂ = D_ring.map u₂.hom ≫ inl_N u₂
      rw [← D_ring.map_comp, CategoryTheory.Under.w m₁]

    have hg_N₂_lin : φ_N ≫ g_N₂ = D_ring.map u₂.hom ≫ inl_M u₂ := by
      dsimp [g_N₂]
      rw [← CategoryTheory.Category.assoc, hg_N'_lin]
      dsimp [α_R1_M]
      rw [CategoryTheory.Category.assoc, (hMap_M m₁').1, ← CategoryTheory.Category.assoc]
      change (D_ring.map u₁'.hom ≫ D_ring.map m₁'.right) ≫ inl_M u₂ = D_ring.map u₂.hom ≫ inl_M u₂
      rw [← D_ring.map_comp, CategoryTheory.Under.w m₁']

    let ψ₂ : F_M.obj u₂ ⟶ F_N.obj u₂ :=
      (hP_Mu u₂).desc (inl_N u₂) g_M₂ hg_M₂_lin.symm
    have hψ₂_inl : inl_M u₂ ≫ ψ₂ = inl_N u₂ := CategoryTheory.IsPushout.inl_desc _ _ _ _
    have hψ₂_inr : inr_M u₂ ≫ ψ₂ = g_M₂ := CategoryTheory.IsPushout.inr_desc _ _ _ _

    let φ₂ : F_N.obj u₂ ⟶ F_M.obj u₂ :=
      (hP_Nu u₂).desc (inl_M u₂) g_N₂ hg_N₂_lin.symm
    have hφ₂_inl : inl_N u₂ ≫ φ₂ = inl_M u₂ := CategoryTheory.IsPushout.inl_desc _ _ _ _
    have hφ₂_inr : inr_N u₂ ≫ φ₂ = g_N₂ := CategoryTheory.IsPushout.inr_desc _ _ _ _

    have hψ₂_colim : ψ₂ ≫ c_N.ι.app u₂ = c_M.ι.app u₂ ≫ e_MN.hom := by
      apply (hP_Mu u₂).hom_ext
      · rw [← CategoryTheory.Category.assoc, hψ₂_inl, (hApp_N u₂).1,
          ← CategoryTheory.Category.assoc, (hApp_M u₂).1, CategoryTheory.Category.assoc, he_MN_hom]
      · rw [← CategoryTheory.Category.assoc, hψ₂_inr]
        dsimp [g_M₂]
        rw [CategoryTheory.Category.assoc, c_N.w m₁, ← hg_M_eq, ← CategoryTheory.Category.assoc,
          (hApp_M u₂).2]

    have hφ₂_colim : φ₂ ≫ c_M.ι.app u₂ = c_N.ι.app u₂ ≫ e_MN.inv := by
      apply (hP_Nu u₂).hom_ext
      · rw [← CategoryTheory.Category.assoc, hφ₂_inl, (hApp_M u₂).1,
          ← CategoryTheory.Category.assoc, (hApp_N u₂).1, CategoryTheory.Category.assoc, he_MN_inv]
      · rw [← CategoryTheory.Category.assoc, hφ₂_inr]
        dsimp [g_N₂]
        rw [CategoryTheory.Category.assoc, c_M.w m₁', ← hg_N'_eq, ← CategoryTheory.Category.assoc,
          (hApp_N u₂).2]

    
    obtain ⟨u₃₀, h_ikM, h_jkM, heq_M₀⟩ :=
      RingHom.EssFiniteType.exists_comp_map_eq_of_isColimit R₁' F_M α_R1_M φ_M c_M hc_M hEss_φM
        (inr_M u₂ ≫ ψ₂ ≫ φ₂)
        (by
          calc
            φ_M ≫ (inr_M u₂ ≫ ψ₂ ≫ φ₂)
              = (φ_M ≫ inr_M u₂) ≫ ψ₂ ≫ φ₂ := by simp only [CategoryTheory.Category.assoc]
            _ = (D_ring.map u₂.hom ≫ inl_M u₂) ≫ ψ₂ ≫ φ₂ := by rw [← (hP_Mu u₂).w]
            _ = D_ring.map u₂.hom ≫ (inl_M u₂ ≫ ψ₂) ≫ φ₂ := by
              simp only [CategoryTheory.Category.assoc]
            _ = D_ring.map u₂.hom ≫ inl_N u₂ ≫ φ₂ := by rw [hψ₂_inl]
            _ = D_ring.map u₂.hom ≫ inl_M u₂ := by rw [hφ₂_inl]
            _ = α_R1_M.app u₂ := rfl)
        (inr_M u₂)
        (by rw [← (hP_Mu u₂).w])
        (by
          calc
            (inr_M u₂ ≫ ψ₂ ≫ φ₂) ≫ c_M.ι.app u₂
              = inr_M u₂ ≫ ψ₂ ≫ (φ₂ ≫ c_M.ι.app u₂) := by
                simp only [CategoryTheory.Category.assoc]
            _ = inr_M u₂ ≫ ψ₂ ≫ (c_N.ι.app u₂ ≫ e_MN.inv) := by rw [hφ₂_colim]
            _ = inr_M u₂ ≫ (ψ₂ ≫ c_N.ι.app u₂) ≫ e_MN.inv := by
              simp only [CategoryTheory.Category.assoc]
            _ = inr_M u₂ ≫ (c_M.ι.app u₂ ≫ e_MN.hom) ≫ e_MN.inv := by rw [hψ₂_colim]
            _ = inr_M u₂ ≫ c_M.ι.app u₂ ≫ (e_MN.hom ≫ e_MN.inv) := by
              simp only [CategoryTheory.Category.assoc]
            _ = inr_M u₂ ≫ c_M.ι.app u₂ := by
              rw [e_MN.hom_inv_id]
              exact congrArg (inr_M u₂ ≫ ·)
                (CategoryTheory.Category.comp_id (c_M.ι.app u₂ : F_M.obj u₂ ⟶ c_M.pt)))
    let u₃ : K' := CategoryTheory.IsFiltered.coeq h_ikM h_jkM
    let m₂₃ : u₂ ⟶ u₃ := h_ikM ≫ CategoryTheory.IsFiltered.coeqHom h_ikM h_jkM
    have heq_M : (inr_M u₂ ≫ ψ₂ ≫ φ₂) ≫ F_M.map m₂₃ = inr_M u₂ ≫ F_M.map m₂₃ := by
      dsimp [m₂₃]
      rw [F_M.map_comp, ← CategoryTheory.Category.assoc, heq_M₀, CategoryTheory.Category.assoc,
        ← F_M.map_comp, ← CategoryTheory.IsFiltered.coeq_condition h_ikM h_jkM, F_M.map_comp]

    obtain ⟨u₃₀', h_ikN, h_jkN, heq_N₀⟩ :=
      RingHom.EssFiniteType.exists_comp_map_eq_of_isColimit R₁' F_N α_R1_N φ_N c_N hc_N hEss_φN
        (inr_N u₂ ≫ φ₂ ≫ ψ₂)
        (by
          calc
            φ_N ≫ (inr_N u₂ ≫ φ₂ ≫ ψ₂)
              = (φ_N ≫ inr_N u₂) ≫ φ₂ ≫ ψ₂ := by simp only [CategoryTheory.Category.assoc]
            _ = (D_ring.map u₂.hom ≫ inl_N u₂) ≫ φ₂ ≫ ψ₂ := by rw [← (hP_Nu u₂).w]
            _ = D_ring.map u₂.hom ≫ (inl_N u₂ ≫ φ₂) ≫ ψ₂ := by
              simp only [CategoryTheory.Category.assoc]
            _ = D_ring.map u₂.hom ≫ inl_M u₂ ≫ ψ₂ := by rw [hφ₂_inl]
            _ = D_ring.map u₂.hom ≫ inl_N u₂ := by rw [hψ₂_inl]
            _ = α_R1_N.app u₂ := rfl)
        (inr_N u₂)
        (by rw [← (hP_Nu u₂).w])
        (by
          calc
            (inr_N u₂ ≫ φ₂ ≫ ψ₂) ≫ c_N.ι.app u₂
              = inr_N u₂ ≫ φ₂ ≫ (ψ₂ ≫ c_N.ι.app u₂) := by
                simp only [CategoryTheory.Category.assoc]
            _ = inr_N u₂ ≫ φ₂ ≫ (c_M.ι.app u₂ ≫ e_MN.hom) := by rw [hψ₂_colim]
            _ = inr_N u₂ ≫ (φ₂ ≫ c_M.ι.app u₂) ≫ e_MN.hom := by
              simp only [CategoryTheory.Category.assoc]
            _ = inr_N u₂ ≫ (c_N.ι.app u₂ ≫ e_MN.inv) ≫ e_MN.hom := by rw [hφ₂_colim]
            _ = inr_N u₂ ≫ c_N.ι.app u₂ ≫ (e_MN.inv ≫ e_MN.hom) := by
              simp only [CategoryTheory.Category.assoc]
            _ = inr_N u₂ ≫ c_N.ι.app u₂ := by
              rw [e_MN.inv_hom_id]
              exact congrArg (inr_N u₂ ≫ ·)
                (CategoryTheory.Category.comp_id (c_N.ι.app u₂ : F_N.obj u₂ ⟶ c_N.pt)))
    let u₃' : K' := CategoryTheory.IsFiltered.coeq h_ikN h_jkN
    let m₂₃' : u₂ ⟶ u₃' := h_ikN ≫ CategoryTheory.IsFiltered.coeqHom h_ikN h_jkN
    have heq_N : (inr_N u₂ ≫ φ₂ ≫ ψ₂) ≫ F_N.map m₂₃' = inr_N u₂ ≫ F_N.map m₂₃' := by
      dsimp [m₂₃']
      rw [F_N.map_comp, ← CategoryTheory.Category.assoc, heq_N₀, CategoryTheory.Category.assoc,
        ← F_N.map_comp, ← CategoryTheory.IsFiltered.coeq_condition h_ikN h_jkN, F_N.map_comp]

    let u₄₀ : K' := CategoryTheory.IsFiltered.max u₃ u₃'
    let p_left : u₂ ⟶ u₄₀ := m₂₃ ≫ CategoryTheory.IsFiltered.leftToMax u₃ u₃'
    let p_right : u₂ ⟶ u₄₀ := m₂₃' ≫ CategoryTheory.IsFiltered.rightToMax u₃ u₃'
    let u₄ : K' := CategoryTheory.IsFiltered.coeq p_left p_right
    let m₂₄ : u₂ ⟶ u₄ := p_left ≫ CategoryTheory.IsFiltered.coeqHom p_left p_right
    have hm₂₄_N : m₂₄ = p_right ≫ CategoryTheory.IsFiltered.coeqHom p_left p_right :=
      CategoryTheory.IsFiltered.coeq_condition p_left p_right

    let ψ₄ : F_M.obj u₄ ⟶ F_N.obj u₄ :=
      (hP_Mu u₄).desc (inl_N u₄) (g_M₂ ≫ F_N.map m₂₄)
        (by
          rw [← CategoryTheory.Category.assoc, hg_M₂_lin, CategoryTheory.Category.assoc,
            (hMap_N m₂₄).1, ← CategoryTheory.Category.assoc]
          change D_ring.map u₄.hom ≫ inl_N u₄ =
            (D_ring.map u₂.hom ≫ D_ring.map m₂₄.right) ≫ inl_N u₄
          rw [← D_ring.map_comp, CategoryTheory.Under.w m₂₄])
    have hψ₄_inl : inl_M u₄ ≫ ψ₄ = inl_N u₄ := CategoryTheory.IsPushout.inl_desc _ _ _ _
    have hψ₄_inr : inr_M u₄ ≫ ψ₄ = g_M₂ ≫ F_N.map m₂₄ :=
      CategoryTheory.IsPushout.inr_desc _ _ _ _

    let φ₄ : F_N.obj u₄ ⟶ F_M.obj u₄ :=
      (hP_Nu u₄).desc (inl_M u₄) (g_N₂ ≫ F_M.map m₂₄)
        (by
          rw [← CategoryTheory.Category.assoc, hg_N₂_lin, CategoryTheory.Category.assoc,
            (hMap_M m₂₄).1, ← CategoryTheory.Category.assoc]
          change D_ring.map u₄.hom ≫ inl_M u₄ =
            (D_ring.map u₂.hom ≫ D_ring.map m₂₄.right) ≫ inl_M u₄
          rw [← D_ring.map_comp, CategoryTheory.Under.w m₂₄])
    have hφ₄_inl : inl_N u₄ ≫ φ₄ = inl_M u₄ := CategoryTheory.IsPushout.inl_desc _ _ _ _
    have hφ₄_inr : inr_N u₄ ≫ φ₄ = g_N₂ ≫ F_M.map m₂₄ :=
      CategoryTheory.IsPushout.inr_desc _ _ _ _

    have hψ_nat : F_M.map m₂₄ ≫ ψ₄ = ψ₂ ≫ F_N.map m₂₄ := by
      apply (hP_Mu u₂).hom_ext
      · rw [← CategoryTheory.Category.assoc, (hMap_M m₂₄).1, CategoryTheory.Category.assoc,
          hψ₄_inl, ← CategoryTheory.Category.assoc, hψ₂_inl, (hMap_N m₂₄).1]
      · rw [← CategoryTheory.Category.assoc, (hMap_M m₂₄).2, hψ₄_inr,
          ← CategoryTheory.Category.assoc, hψ₂_inr]

    have hφ_nat : F_N.map m₂₄ ≫ φ₄ = φ₂ ≫ F_M.map m₂₄ := by
      apply (hP_Nu u₂).hom_ext
      · rw [← CategoryTheory.Category.assoc, (hMap_N m₂₄).1, CategoryTheory.Category.assoc,
          hφ₄_inl, ← CategoryTheory.Category.assoc, hφ₂_inl, (hMap_M m₂₄).1]
      · rw [← CategoryTheory.Category.assoc, (hMap_N m₂₄).2, hφ₄_inr,
          ← CategoryTheory.Category.assoc, hφ₂_inr]

    have hm₂₄_fac_M : F_M.map m₂₄ =
        F_M.map m₂₃ ≫ F_M.map (CategoryTheory.IsFiltered.leftToMax u₃ u₃' ≫
          CategoryTheory.IsFiltered.coeqHom p_left p_right) := by
      change F_M.map ((m₂₃ ≫ CategoryTheory.IsFiltered.leftToMax u₃ u₃') ≫
        CategoryTheory.IsFiltered.coeqHom p_left p_right) = _
      rw [CategoryTheory.Category.assoc, F_M.map_comp]

    have hm₂₄_fac_N : F_N.map m₂₄ =
        F_N.map m₂₃' ≫ F_N.map (CategoryTheory.IsFiltered.rightToMax u₃ u₃' ≫
          CategoryTheory.IsFiltered.coeqHom p_left p_right) := by
      rw [hm₂₄_N]
      change F_N.map ((m₂₃' ≫ CategoryTheory.IsFiltered.rightToMax u₃ u₃') ≫
        CategoryTheory.IsFiltered.coeqHom p_left p_right) = _
      rw [CategoryTheory.Category.assoc, F_N.map_comp]

    have hψφ_id : ψ₄ ≫ φ₄ = 𝟙 (F_M.obj u₄) := by
      apply (hP_Mu u₄).hom_ext
      · rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc, hψ₄_inl, hφ₄_inl]
      · calc
          inr_M u₄ ≫ (ψ₄ ≫ φ₄)
            = (inr_M u₂ ≫ F_M.map m₂₄) ≫ (ψ₄ ≫ φ₄) := by rw [(hMap_M m₂₄).2]
          _ = inr_M u₂ ≫ (F_M.map m₂₄ ≫ ψ₄) ≫ φ₄ := by simp only [CategoryTheory.Category.assoc]
          _ = inr_M u₂ ≫ (ψ₂ ≫ F_N.map m₂₄) ≫ φ₄ := by rw [hψ_nat]
          _ = inr_M u₂ ≫ ψ₂ ≫ (F_N.map m₂₄ ≫ φ₄) := by simp only [CategoryTheory.Category.assoc]
          _ = inr_M u₂ ≫ ψ₂ ≫ (φ₂ ≫ F_M.map m₂₄) := by rw [hφ_nat]
          _ = (inr_M u₂ ≫ ψ₂ ≫ φ₂) ≫ F_M.map m₂₄ := by simp only [CategoryTheory.Category.assoc]
          _ = ((inr_M u₂ ≫ ψ₂ ≫ φ₂) ≫ F_M.map m₂₃) ≫
                F_M.map (CategoryTheory.IsFiltered.leftToMax u₃ u₃' ≫
                  CategoryTheory.IsFiltered.coeqHom p_left p_right) := by
            rw [hm₂₄_fac_M]
            simp only [CategoryTheory.Category.assoc]
          _ = (inr_M u₂ ≫ F_M.map m₂₃) ≫
                F_M.map (CategoryTheory.IsFiltered.leftToMax u₃ u₃' ≫
                  CategoryTheory.IsFiltered.coeqHom p_left p_right) := by rw [heq_M]
          _ = inr_M u₂ ≫ F_M.map m₂₄ := by
            rw [hm₂₄_fac_M]
            simp only [CategoryTheory.Category.assoc]
          _ = inr_M u₄ := (hMap_M m₂₄).2
          _ = inr_M u₄ ≫ 𝟙 (F_M.obj u₄) := (CategoryTheory.Category.comp_id _).symm

    have hφψ_id : φ₄ ≫ ψ₄ = 𝟙 (F_N.obj u₄) := by
      apply (hP_Nu u₄).hom_ext
      · rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc, hφ₄_inl, hψ₄_inl]
      · calc
          inr_N u₄ ≫ (φ₄ ≫ ψ₄)
            = (inr_N u₂ ≫ F_N.map m₂₄) ≫ (φ₄ ≫ ψ₄) := by rw [(hMap_N m₂₄).2]
          _ = inr_N u₂ ≫ (F_N.map m₂₄ ≫ φ₄) ≫ ψ₄ := by simp only [CategoryTheory.Category.assoc]
          _ = inr_N u₂ ≫ (φ₂ ≫ F_M.map m₂₄) ≫ ψ₄ := by rw [hφ_nat]
          _ = inr_N u₂ ≫ φ₂ ≫ (F_M.map m₂₄ ≫ ψ₄) := by simp only [CategoryTheory.Category.assoc]
          _ = inr_N u₂ ≫ φ₂ ≫ (ψ₂ ≫ F_N.map m₂₄) := by rw [hψ_nat]
          _ = (inr_N u₂ ≫ φ₂ ≫ ψ₂) ≫ F_N.map m₂₄ := by simp only [CategoryTheory.Category.assoc]
          _ = ((inr_N u₂ ≫ φ₂ ≫ ψ₂) ≫ F_N.map m₂₃') ≫
                F_N.map (CategoryTheory.IsFiltered.rightToMax u₃ u₃' ≫
                  CategoryTheory.IsFiltered.coeqHom p_left p_right) := by
            rw [hm₂₄_fac_N]
            simp only [CategoryTheory.Category.assoc]
          _ = (inr_N u₂ ≫ F_N.map m₂₃') ≫
                F_N.map (CategoryTheory.IsFiltered.rightToMax u₃ u₃' ≫
                  CategoryTheory.IsFiltered.coeqHom p_left p_right) := by rw [heq_N]
          _ = inr_N u₂ ≫ F_N.map m₂₄ := by
            rw [hm₂₄_fac_N]
            simp only [CategoryTheory.Category.assoc]
          _ = inr_N u₄ := (hMap_N m₂₄).2
          _ = inr_N u₄ ≫ 𝟙 (F_N.obj u₄) := (CategoryTheory.Category.comp_id _).symm

    haveI : CategoryTheory.IsIso φ₄ := ⟨⟨ψ₄, hφψ_id, hψφ_id⟩⟩
    have hα_u₄ : α₁' ≫ D_ring.map u₄.hom = α_K.app u₄.right := by
      simpa [α₁'] using (α_K.naturality u₄.hom).symm
    have hPush_fin : CategoryTheory.IsPushout (α_K.app u₄.right) φ₀
        (inl_M u₄) (π_M ≫ inr_M u₄) := by
      rw [← hα_u₄]
      exact hPush_M.paste_horiz (hP_Mu u₄)
    have hSm_N_u₄ : RingHom.IsStandardSmoothOfRelativeDimension 1 (inl_N u₄).hom :=
      hSm_Nu u₄ hSm_φN
    have hSm_M_u₄ : RingHom.IsStandardSmoothOfRelativeDimension 1 (inl_M u₄).hom := by
      rw [← hφ₄_inl]
      change RingHom.IsStandardSmoothOfRelativeDimension 1 (φ₄.hom.comp (inl_N u₄).hom)
      exact (RingHom.RespectsIso.cancel_right_isIso
        RingHom.isStandardSmoothOfRelativeDimension_respectsIso
        (inl_N u₄) φ₄).mpr hSm_N_u₄
    exact ⟨u₄.right, F_M.obj u₄, inl_M u₄, π_M ≫ inr_M u₄, hPush_fin, hSm_M_u₄⟩

  
  let c_V_main : CategoryTheory.Limits.Cocone R_diag :=
    CategoryTheory.Limits.Cocone.mk (CommRingCat.of R_V) ι_colim

  have hPerSec : ∀ j : Fin n,
      ∃ (i_j : J) (W_j : (C_i i_j).Opens),
        (∀ b : AlgebraicGeometry.Spec (R_diag.obj i_j), (τ_i i_j j).base b ∈ W_j) ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_j.ι ≫ g_i i_j) := by
    intro j
    obtain ⟨V_V, B_V, φ_V, e_V, hAffV, hTopV, hFacV, hSm_φV⟩ :=
      h_s1 (τ_V j) (hSecV j) (hSmSecV j)
    obtain ⟨i₀, W₀, hAff₀, hPre₀⟩ := h_s2_aff V_V hAffV
    have hLFP_i₀ : AlgebraicGeometry.LocallyOfFinitePresentation (g_i i₀) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback g₁ (f_base i₀)) hLFP₁
    obtain ⟨B₀, φ₀, hFP₀, hToPush, hToSmooth⟩ :=
      h_s4 (R_diag.obj i₀) (C_i i₀) (g_i i₀) hLFP_i₀ W₀ hAff₀
    obtain ⟨π_V, hPushV⟩ :=
      hToPush B_V (ι_colim.app i₀) φ_V (ι_i i₀) V_V e_V (hPb_i i₀) hPre₀ hFacV
    let J₀ := CategoryTheory.Under i₀
    let R_diag₀ : J₀ ⥤ CommRingCat.{u} := CategoryTheory.Under.forget i₀ ⋙ R_diag
    let α_diag₀ : (CategoryTheory.Functor.const J₀).obj (R_diag.obj i₀) ⟶ R_diag₀ :=
      { app := fun u => R_diag.map u.hom
        naturality := by
          intro u₁ u₂ f
          dsimp [R_diag₀]
          rw [CategoryTheory.Category.id_comp, ← R_diag.map_comp, CategoryTheory.Under.w f] }
    let c_V₀ : CategoryTheory.Limits.Cocone R_diag₀ :=
      c_V_main.whisker (CategoryTheory.Under.forget i₀)
    have hc_V₀ : CategoryTheory.Limits.IsColimit c_V₀ :=
      (CategoryTheory.Functor.Final.isColimitWhiskerEquiv
        (CategoryTheory.Under.forget i₀) c_V_main).symm hc
    have hα_comp₀ : ∀ u : J₀, α_diag₀.app u ≫ c_V₀.ι.app u = ι_colim.app i₀ := by
      intro u
      dsimp [α_diag₀, c_V₀, c_V_main]
      exact (ι_colim.naturality u.hom).trans (CategoryTheory.Category.comp_id _)
    obtain ⟨u₁, B₁, φ₁, π₁, hPush₁, hSm_φ₁⟩ :=
      h_s3 (ι_colim.app i₀) φ₀ hFP₀ φ_V π_V hPushV hSm_φV R_diag₀ α_diag₀ c_V₀.ι hc_V₀ hα_comp₀
    let i₁ : J := u₁.right
    let W₁ : (C_i i₁).Opens := (TopologicalSpace.Opens.map (Φ u₁.hom).base).obj W₀
    have hSm_W₁ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₁.ι ≫ g_i i₁) :=
      hToSmooth (R_diag.obj i₁) B₁ (R_diag.map u₁.hom) φ₁ π₁
        (C_i i₁) (g_i i₁) (Φ u₁.hom) W₁ (hPb_Φ u₁.hom) rfl hPush₁ hSm_φ₁
    have hPre₁ : (TopologicalSpace.Opens.map (ι_i i₁).base).obj W₁ = V_V := by
      have h1 : (TopologicalSpace.Opens.map (ι_i i₁).base).obj W₁ =
          (TopologicalSpace.Opens.map (ι_i i₀).base).obj W₀ := by
        ext x
        change (ι_i i₁ ≫ Φ u₁.hom).base x ∈ W₀ ↔ (ι_i i₀).base x ∈ W₀
        rw [hι_Φ u₁.hom]
      rw [h1, hPre₀]
    let U₁ : (AlgebraicGeometry.Spec (R_diag.obj i₁)).Opens :=
      (TopologicalSpace.Opens.map (τ_i i₁ j).base).obj W₁
    have hU₁_top :
        (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map (ι_colim.app i₁)).base).obj U₁ = ⊤ := by
      have hpre_U₁ :
          (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map (ι_colim.app i₁)).base).obj U₁ =
            (TopologicalSpace.Opens.map (τ_V j).base).obj V_V := by
        rw [← hPre₁]
        ext x
        change (AlgebraicGeometry.Spec.map (ι_colim.app i₁) ≫ τ_i i₁ j).base x ∈ W₁ ↔
          (τ_V j ≫ ι_i i₁).base x ∈ W₁
        rw [hτ_V_i i₁ j]
      rw [hpre_U₁, hTopV]
    let J₁ := CategoryTheory.Under i₁
    let R_diag₁ : J₁ ⥤ CommRingCat.{u} := CategoryTheory.Under.forget i₁ ⋙ R_diag
    let α_diag₁ : (CategoryTheory.Functor.const J₁).obj (R_diag.obj i₁) ⟶ R_diag₁ :=
      { app := fun u => R_diag.map u.hom
        naturality := by
          intro u₁ u₂ f
          dsimp [R_diag₁]
          rw [CategoryTheory.Category.id_comp, ← R_diag.map_comp, CategoryTheory.Under.w f] }
    let c_V₁ : CategoryTheory.Limits.Cocone R_diag₁ :=
      c_V_main.whisker (CategoryTheory.Under.forget i₁)
    have hc_V₁ : CategoryTheory.Limits.IsColimit c_V₁ :=
      (CategoryTheory.Functor.Final.isColimitWhiskerEquiv
        (CategoryTheory.Under.forget i₁) c_V_main).symm hc
    have hα_comp₁ : ∀ u : J₁, α_diag₁.app u ≫ c_V₁.ι.app u = ι_colim.app i₁ := by
      intro u
      dsimp [α_diag₁, c_V₁, c_V_main]
      exact (ι_colim.naturality u.hom).trans (CategoryTheory.Category.comp_id _)
    obtain ⟨u₂, hu₂_top⟩ :=
      h_s2_top (ι_colim.app i₁) R_diag₁ α_diag₁ c_V₁.ι hc_V₁ hα_comp₁ U₁ hU₁_top
    let i_j : J := u₂.right
    let W_j : (C_i i_j).Opens := (TopologicalSpace.Opens.map (Φ u₂.hom).base).obj W₁
    have hMem_j : ∀ b : AlgebraicGeometry.Spec (R_diag.obj i_j), (τ_i i_j j).base b ∈ W_j := by
      intro b
      change (Φ u₂.hom).base ((τ_i i_j j).base b) ∈ W₁
      have h_pt : (Φ u₂.hom).base ((τ_i i_j j).base b) =
          (τ_i i₁ j).base ((AlgebraicGeometry.Spec.map (R_diag.map u₂.hom)).base b) := by
        change (τ_i i_j j ≫ Φ u₂.hom).base b =
          (AlgebraicGeometry.Spec.map (R_diag.map u₂.hom) ≫ τ_i i₁ j).base b
        rw [hτ_Φ u₂.hom j]
      rw [h_pt]
      change b ∈ (TopologicalSpace.Opens.map
        (AlgebraicGeometry.Spec.map (α_diag₁.app u₂)).base).obj U₁
      rw [hu₂_top]
      trivial
    have hSm_j : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_j.ι ≫ g_i i_j) := by
      let π_Wj : W_j.toScheme ⟶ W₁.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift W₁.ι (W_j.ι ≫ Φ u₂.hom) (by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨x, rfl⟩
          exact x.2)
      have hPb_Wj : CategoryTheory.IsPullback π_Wj W_j.ι W₁.ι (Φ u₂.hom) :=
        AlgebraicGeometry.IsOpenImmersion.isPullback π_Wj W_j.ι W₁.ι (Φ u₂.hom)
          (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _).symm
          (by
            rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι,
              AlgebraicGeometry.Scheme.Opens.opensRange_ι])
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hPb_Wj.paste_vert (hPb_Φ u₂.hom)) hSm_W₁
    exact ⟨i_j, W_j, hMem_j, hSm_j⟩

  choose i_sec W_sec hMem_sec hSm_sec using hPerSec

  
  have hFinSup : ∀ (m : ℕ) (idx : Fin m → J),
      ∃ i_top : J, ∀ a : Fin m, Nonempty (idx a ⟶ i_top) := by
    intro m
    induction m with
    | zero =>
      intro _
      obtain ⟨i₀⟩ := CategoryTheory.IsFiltered.nonempty (C := J)
      exact ⟨i₀, fun a => a.elim0⟩
    | succ m ih =>
      intro idx
      obtain ⟨i_prev, h_prev⟩ := ih (fun a => idx a.castSucc)
      let i_top : J := CategoryTheory.IsFiltered.max i_prev (idx (Fin.last m))
      refine ⟨i_top, ?_⟩
      intro a
      refine Fin.lastCases ?_ ?_ a
      · exact ⟨CategoryTheory.IsFiltered.rightToMax i_prev (idx (Fin.last m))⟩
      · intro a₀
        obtain ⟨u₀⟩ := h_prev a₀
        exact ⟨u₀ ≫ CategoryTheory.IsFiltered.leftToMax i_prev (idx (Fin.last m))⟩

  obtain ⟨i₂, hToTop⟩ := hFinSup n i_sec
  let v_sec : ∀ j : Fin n, i_sec j ⟶ i₂ := fun j => (hToTop j).some

  refine ⟨i₂, τ_i i₂, ι_i i₂, hτ_fst i₂, hSec_i i₂, ?_, hPb_i i₂, hτ_V_i i₂⟩
  intro j b
  let W_fin : (C_i i₂).Opens := (TopologicalSpace.Opens.map (Φ (v_sec j)).base).obj (W_sec j)
  refine ⟨W_fin, ?_, ?_⟩
  · change (Φ (v_sec j)).base ((τ_i i₂ j).base b) ∈ W_sec j
    have h_pt : (Φ (v_sec j)).base ((τ_i i₂ j).base b) =
        (τ_i (i_sec j) j).base ((AlgebraicGeometry.Spec.map (R_diag.map (v_sec j))).base b) := by
      change (τ_i i₂ j ≫ Φ (v_sec j)).base b =
        (AlgebraicGeometry.Spec.map (R_diag.map (v_sec j)) ≫ τ_i (i_sec j) j).base b
      rw [hτ_Φ (v_sec j) j]
    rw [h_pt]
    exact hMem_sec j _
  · let π_Wfin : W_fin.toScheme ⟶ (W_sec j).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift (W_sec j).ι (W_fin.ι ≫ Φ (v_sec j)) (by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨x, rfl⟩
        exact x.2)
    have hPb_Wfin : CategoryTheory.IsPullback π_Wfin W_fin.ι (W_sec j).ι (Φ (v_sec j)) :=
      AlgebraicGeometry.IsOpenImmersion.isPullback π_Wfin W_fin.ι (W_sec j).ι (Φ (v_sec j))
        (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _).symm
        (by
          rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι,
            AlgebraicGeometry.Scheme.Opens.opensRange_ι])
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hPb_Wfin.paste_vert (hPb_Φ (v_sec j))) (hSm_sec j)

theorem weil_valuationSubring_spreadOut_pointed_separated_model (k : Type u) [Field k]
    (K : Type u) [Field K] [Algebra k K]
    (V : ValuationSubring K)
    (hkV : ∀ c : k, algebraMap k K c ∈ V)
    (n : ℕ) (hn : 3 ≤ n)
    (C_V : AlgebraicGeometry.Scheme.{u})
    (g_V : C_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ_V : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_V))
    (hQCV : AlgebraicGeometry.QuasiCompact g_V)
    (hSepV : AlgebraicGeometry.IsSeparated g_V)
    (hLFPV : AlgebraicGeometry.LocallyOfFinitePresentation g_V)
    (hSecV : ∀ j : Fin n, τ_V j ≫ g_V = 𝟙 _)
    (hDisjV : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ_V i).base) (Set.range (τ_V j).base))
    (hSmSecV : ∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      ∃ W : C_V.Opens, (τ_V j).base b ∈ W ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ g_V))
    (F_init : Finset K)
    (hF_init : ∀ x ∈ F_init, x ∈ V) :
    ∃ (F₁ : Finset K)
      (ι₁_FV : ↥(Algebra.adjoin k (↑F₁ : Set K)) →+* ↥V)
      (C₁ : AlgebraicGeometry.Scheme.{u})
      (g₁ : C₁ ⟶ AlgebraicGeometry.Spec
        (CommRingCat.of ↥(Algebra.adjoin k (↑F₁ : Set K))))
      (τ₁ : Fin n → (AlgebraicGeometry.Spec
        (CommRingCat.of ↥(Algebra.adjoin k (↑F₁ : Set K))) ⟶ C₁))
      (ι₁_V : C_V ⟶ C₁),
      F_init ⊆ F₁ ∧
      (∀ x ∈ F₁, x ∈ V) ∧
      V.subtype.comp ι₁_FV = (Algebra.adjoin k (↑F₁ : Set K)).val.toRingHom ∧
      AlgebraicGeometry.QuasiCompact g₁ ∧
      AlgebraicGeometry.IsSeparated g₁ ∧
      AlgebraicGeometry.LocallyOfFinitePresentation g₁ ∧
      AlgebraicGeometry.Surjective g₁ ∧
      (∀ j : Fin n, τ₁ j ≫ g₁ = 𝟙 _) ∧
      (_root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ₁ i).base) (Set.range (τ₁ j).base)) ∧
      (∀ (j : Fin n)
         (b : AlgebraicGeometry.Spec
           (CommRingCat.of ↥(Algebra.adjoin k (↑F₁ : Set K)))),
        ∃ W : C₁.Opens, (τ₁ j).base b ∈ W ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ g₁)) ∧
      CategoryTheory.IsPullback ι₁_V g_V g₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁_FV)) ∧
      (∀ j : Fin n, τ_V j ≫ ι₁_V =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁_FV) ≫ τ₁ j) :=
by
  classical
  let J : Type u := {F : Finset K // F_init ⊆ F ∧ ∀ x ∈ F, x ∈ V}
  letI : Preorder J := Preorder.lift Subtype.val
  letI : CategoryTheory.SmallCategory J := Preorder.smallCategory J
  have hNonemptyJ : Nonempty J := ⟨⟨F_init, Finset.Subset.refl _, hF_init⟩⟩
  have hDirJ : IsDirected J (· ≤ ·) := by
    refine ⟨fun i₁ i₂ => ?_⟩
    refine ⟨⟨i₁.1 ∪ i₂.1, i₁.2.1.trans Finset.subset_union_left, fun x hx => ?_⟩,
      Finset.subset_union_left, Finset.subset_union_right⟩
    rcases Finset.mem_union.mp hx with h | h
    · exact i₁.2.2 x h
    · exact i₂.2.2 x h
  haveI : CategoryTheory.IsFiltered J := CategoryTheory.isFiltered_of_directed_le_nonempty J

  have hMemAdjoin : ∀ (F : Finset K), (∀ x ∈ F, x ∈ V) →
      ∀ z ∈ Algebra.adjoin k (↑F : Set K), z ∈ V := by
    intro F hFV z hz
    exact Algebra.adjoin_induction
      (fun y hy => hFV y (Finset.mem_coe.mp hy))
      (fun c => hkV c)
      (fun _ _ _ _ hx hy => add_mem hx hy)
      (fun _ _ _ _ hx hy => mul_mem hx hy) hz

  let mk_ι_FV : ∀ (F : Finset K), (∀ x ∈ F, x ∈ V) →
      (↥(Algebra.adjoin k (↑F : Set K)) →+* ↥V) :=
    fun F hFV =>
      (Algebra.adjoin k (↑F : Set K)).val.toRingHom.codRestrict V.toSubring
        (fun z => hMemAdjoin F hFV z.1 z.2)

  let R_diag : J ⥤ CommRingCat.{u} :=
    { obj := fun i => CommRingCat.of ↥(Algebra.adjoin k (↑i.1 : Set K))
      map := fun u => CommRingCat.ofHom
        (Subalgebra.inclusion (Algebra.adjoin_mono (R := k) (Finset.coe_subset.mpr (leOfHom u)))).toRingHom
      map_id := fun _ => by ext; rfl
      map_comp := fun _ _ => by ext; rfl }

  let ι_colim : R_diag ⟶ (CategoryTheory.Functor.const J).obj (CommRingCat.of ↥V) :=
    { app := fun i => CommRingCat.ofHom (mk_ι_FV i.1 i.2.2)
      naturality := fun _ _ _ => by ext; rfl }

  let c_V : CategoryTheory.Limits.Cocone R_diag :=
    CategoryTheory.Limits.Cocone.mk (CommRingCat.of ↥V) ι_colim

  have hc_type : CategoryTheory.Limits.IsColimit ((forget CommRingCat.{u}).mapCocone c_V) := by
    refine CategoryTheory.Limits.Types.FilteredColimit.isColimitOf' _ _ ?_ ?_
    · intro v
      let F_v : Finset K := insert v.1 F_init
      have hSub_v : F_init ⊆ F_v := Finset.subset_insert _ _
      have hMem_v : ∀ x ∈ F_v, x ∈ V := by
        intro x hx
        rcases Finset.mem_insert.mp hx with rfl | hx'
        · exact v.2
        · exact hF_init x hx'
      let i_v : J := ⟨F_v, hSub_v, hMem_v⟩
      refine ⟨i_v, ⟨v.1, Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_insert_self v.1 F_init))⟩, ?_⟩
      rfl
    · intro i x y hxy
      refine ⟨i, 𝟙 i, ?_⟩
      have hval : x.1 = y.1 := congrArg (Subtype.val : ↥V → K) hxy
      have hxy_eq : x = y := Subtype.ext hval
      simp [hxy_eq]

  let c_std := CommRingCat.FilteredColimits.colimitCocone R_diag
  have hc_std : CategoryTheory.Limits.IsColimit c_std :=
    CommRingCat.FilteredColimits.colimitCoconeIsColimit R_diag
  have hc_std_type : CategoryTheory.Limits.IsColimit ((forget CommRingCat.{u}).mapCocone c_std) :=
    CategoryTheory.Limits.isColimitOfPreserves (forget CommRingCat.{u}) hc_std
  let φ_colim : c_std.pt ⟶ c_V.pt := hc_std.desc c_V
  have hφ_type : (forget CommRingCat.{u}).map φ_colim =
      hc_std_type.desc ((forget CommRingCat.{u}).mapCocone c_V) := by
    apply hc_std_type.uniq ((forget CommRingCat.{u}).mapCocone c_V)
    intro i
    change (forget CommRingCat.{u}).map (c_std.ι.app i ≫ φ_colim) = _
    rw [hc_std.fac c_V i]
    rfl
  have hIso_type : CategoryTheory.IsIso ((forget CommRingCat.{u}).map φ_colim) := by
    rw [hφ_type]
    change CategoryTheory.IsIso
      (CategoryTheory.Limits.IsColimit.coconePointUniqueUpToIso hc_std_type hc_type).hom
    infer_instance
  have hIso_φ : CategoryTheory.IsIso φ_colim :=
    CategoryTheory.isIso_of_reflects_iso φ_colim (forget CommRingCat.{u})
  let e_cocone : c_std ≅ c_V :=
    CategoryTheory.Limits.Cocone.ext (CategoryTheory.asIso φ_colim) (fun i => hc_std.fac c_V i)
  have hc_V : CategoryTheory.Limits.IsColimit c_V :=
    CategoryTheory.Limits.IsColimit.ofIsoColimit hc_std e_cocone

  
  obtain ⟨i₁, J₀, instFinJ₀, V_cov, U₁, instAffU₁, p₁, π₁, O₁, t₁, θ₁,
      hCov, hLFP_p₁, hPb_π₁, hO₁_aff, hO₁_diag, hO₁_pre, ht₁_id, ht₁_over, hθ₁_fst, hθ₁_snd⟩ :=
    weil_fp_affine_charts_and_pairwise_overlaps_descent
      J R_diag (CommRingCat.of ↥V) ι_colim ⟨hc_V⟩ C_V g_V hQCV hSepV hLFPV
  haveI : Finite J₀ := instFinJ₀
  haveI : ∀ a : J₀, AlgebraicGeometry.IsAffine (U₁ a) := instAffU₁

  
  let J₁ := CategoryTheory.Under i₁
  let R_diag₁ : J₁ ⥤ CommRingCat.{u} := CategoryTheory.Under.forget i₁ ⋙ R_diag
  let α_diag₁ : (CategoryTheory.Functor.const J₁).obj (R_diag.obj i₁) ⟶ R_diag₁ :=
    { app := fun u => R_diag.map u.hom
      naturality := fun u₁ u₂ f => by
        dsimp [R_diag₁]
        rw [CategoryTheory.Category.id_comp, ← R_diag.map_comp, CategoryTheory.Under.w f] }
  let c_V₁ : CategoryTheory.Limits.Cocone R_diag₁ := c_V.whisker (CategoryTheory.Under.forget i₁)
  have hc_V₁ : CategoryTheory.Limits.IsColimit c_V₁ :=
    (CategoryTheory.Functor.Final.isColimitWhiskerEquiv (CategoryTheory.Under.forget i₁) c_V).symm hc_V
  have hα_comp₁ : ∀ u : J₁, α_diag₁.app u ≫ c_V₁.ι.app u = ι_colim.app i₁ := by
    intro u
    dsimp [α_diag₁, c_V₁, c_V]
    exact (ι_colim.naturality u.hom).trans (CategoryTheory.Category.comp_id _)

  obtain ⟨u₀, U₀, instAffU₀, p₀, π_V, O₀, t₀, t'₀, δ₀, θ_V,
      hLFP₀, hPb_chart, hO_diag, hO_pre, ht_id, ht_over, ht'_fac, hcocycle,
      hδ_fst, hδ_snd, hδ_cl, hθ_fst, hθ_snd⟩ :=
    weil_separated_cocycle_and_closed_graph_descent
      (R_diag.obj i₁) (CommRingCat.of ↥V) (ι_colim.app i₁)
      J₁ R_diag₁ α_diag₁ c_V₁.ι ⟨hc_V₁⟩ hα_comp₁
      C_V g_V hSepV J₀ V_cov U₁ p₁ hLFP_p₁ π₁ hPb_π₁
      O₁ hO₁_aff hO₁_diag hO₁_pre t₁ ht₁_id ht₁_over θ₁ hθ₁_fst hθ₁_snd
  haveI : ∀ a : J₀, AlgebraicGeometry.IsAffine (U₀ a) := instAffU₀
  let i₀ : J := u₀.right

  
  obtain ⟨C₀, g₀, ι₀, hQC₀, hSep₀, hLFP₀_g, hPb₀⟩ :=
    weil_glued_separated_scheme_from_blueprint
      (AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (AlgebraicGeometry.Spec (R_diag.obj i₀))
      (AlgebraicGeometry.Spec.map (ι_colim.app i₀))
      C_V g_V J₀ V_cov hCov U₀ p₀ hLFP₀ π_V hPb_chart
      O₀ hO_diag hO_pre t₀ ht_id ht_over t'₀ ht'_fac hcocycle
      δ₀ hδ_fst hδ_snd hδ_cl θ_V hθ_fst hθ_snd

  
  let J₂ := CategoryTheory.Under i₀
  let R_diag₂ : J₂ ⥤ CommRingCat.{u} := CategoryTheory.Under.forget i₀ ⋙ R_diag
  let α_diag₂ : (CategoryTheory.Functor.const J₂).obj (R_diag.obj i₀) ⟶ R_diag₂ :=
    { app := fun u => R_diag.map u.hom
      naturality := fun u₁ u₂ f => by
        dsimp [R_diag₂]
        rw [CategoryTheory.Category.id_comp, ← R_diag.map_comp, CategoryTheory.Under.w f] }
  let c_V₂ : CategoryTheory.Limits.Cocone R_diag₂ := c_V.whisker (CategoryTheory.Under.forget i₀)
  have hc_V₂ : CategoryTheory.Limits.IsColimit c_V₂ :=
    (CategoryTheory.Functor.Final.isColimitWhiskerEquiv (CategoryTheory.Under.forget i₀) c_V).symm hc_V
  have hα_comp₂ : ∀ u : J₂, α_diag₂.app u ≫ c_V₂.ι.app u = ι_colim.app i₀ := by
    intro u
    dsimp [α_diag₂, c_V₂, c_V]
    exact (ι_colim.naturality u.hom).trans (CategoryTheory.Category.comp_id _)

  obtain ⟨u_mid, τ_mid, ι_mid, _hSurj_mid, hSec_mid, hDisj_mid, hPb_mid, hτ_mid⟩ :=
    weil_localRing_pointed_disjoint_sections_descent
      (R_diag.obj i₀) ↥V (ι_colim.app i₀)
      J₂ R_diag₂ α_diag₂ c_V₂.ι ⟨hc_V₂⟩ hα_comp₂
      n hn C₀ g₀ hSep₀ hLFP₀_g C_V g_V τ_V hSecV hDisjV ι₀ hPb₀

  let i_mid : J := u_mid.right
  let C_mid : AlgebraicGeometry.Scheme.{u} :=
    CategoryTheory.Limits.pullback g₀ (AlgebraicGeometry.Spec.map (α_diag₂.app u_mid))
  let g_mid : C_mid ⟶ AlgebraicGeometry.Spec (R_diag.obj i_mid) :=
    CategoryTheory.Limits.pullback.snd g₀ (AlgebraicGeometry.Spec.map (α_diag₂.app u_mid))
  have hQC_mid : AlgebraicGeometry.QuasiCompact g_mid :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback g₀ (AlgebraicGeometry.Spec.map (α_diag₂.app u_mid)))
      hQC₀
  have hSep_mid : AlgebraicGeometry.IsSeparated g_mid :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback g₀ (AlgebraicGeometry.Spec.map (α_diag₂.app u_mid)))
      hSep₀
  have hLFP_mid : AlgebraicGeometry.LocallyOfFinitePresentation g_mid :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback g₀ (AlgebraicGeometry.Spec.map (α_diag₂.app u_mid)))
      hLFP₀_g

  
  let J₃ := CategoryTheory.Under i_mid
  let R_diag₃ : J₃ ⥤ CommRingCat.{u} := CategoryTheory.Under.forget i_mid ⋙ R_diag
  let α_diag₃ : (CategoryTheory.Functor.const J₃).obj (R_diag.obj i_mid) ⟶ R_diag₃ :=
    { app := fun u => R_diag.map u.hom
      naturality := fun u₁ u₂ f => by
        dsimp [R_diag₃]
        rw [CategoryTheory.Category.id_comp, ← R_diag.map_comp, CategoryTheory.Under.w f] }
  let c_V₃ : CategoryTheory.Limits.Cocone R_diag₃ := c_V.whisker (CategoryTheory.Under.forget i_mid)
  have hc_V₃ : CategoryTheory.Limits.IsColimit c_V₃ :=
    (CategoryTheory.Functor.Final.isColimitWhiskerEquiv (CategoryTheory.Under.forget i_mid) c_V).symm hc_V
  have hα_comp₃ : ∀ u : J₃, α_diag₃.app u ≫ c_V₃.ι.app u = ι_colim.app i_mid := by
    intro u
    dsimp [α_diag₃, c_V₃, c_V]
    exact (ι_colim.naturality u.hom).trans (CategoryTheory.Category.comp_id _)

  obtain ⟨u_fin, τ_fin, ι_fin, hτ_fin_fst, hSec_fin, hSmSec_fin, hPb_fin, hτ_fin_V⟩ :=
    weil_localRing_smooth_relDimOne_section_opens_descent
      (R_diag.obj i_mid) ↥V (ι_colim.app i_mid)
      J₃ R_diag₃ α_diag₃ c_V₃.ι ⟨hc_V₃⟩ hα_comp₃
      n C_mid g_mid τ_mid hQC_mid hSep_mid hLFP_mid hSec_mid
      C_V g_V τ_V hSecV hSmSecV ι_mid hPb_mid hτ_mid

  
  let i_fin : J := u_fin.right
  let F₁ : Finset K := i_fin.1
  let ι₁_FV : ↥(Algebra.adjoin k (↑F₁ : Set K)) →+* ↥V := mk_ι_FV i_fin.1 i_fin.2.2
  let C₁ : AlgebraicGeometry.Scheme.{u} :=
    CategoryTheory.Limits.pullback g_mid (AlgebraicGeometry.Spec.map (α_diag₃.app u_fin))
  let g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(Algebra.adjoin k (↑F₁ : Set K))) :=
    CategoryTheory.Limits.pullback.snd g_mid (AlgebraicGeometry.Spec.map (α_diag₃.app u_fin))

  have hQC₁ : AlgebraicGeometry.QuasiCompact g₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback g_mid (AlgebraicGeometry.Spec.map (α_diag₃.app u_fin)))
      hQC_mid
  have hSep₁ : AlgebraicGeometry.IsSeparated g₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback g_mid (AlgebraicGeometry.Spec.map (α_diag₃.app u_fin)))
      hSep_mid
  have hLFP₁ : AlgebraicGeometry.LocallyOfFinitePresentation g₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback g_mid (AlgebraicGeometry.Spec.map (α_diag₃.app u_fin)))
      hLFP_mid
  have hSurj₁ : AlgebraicGeometry.Surjective g₁ := by
    let j₀ : Fin n := ⟨0, by omega⟩
    refine ⟨fun b => ⟨(τ_fin j₀).base b, ?_⟩⟩
    exact congrArg (fun φ => φ.base b) (hSec_fin j₀)
  have hDisj₁ : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ_fin i).base) (Set.range (τ_fin j).base) := by
    intro j₁ j₂ hj
    rw [Set.disjoint_iff]
    rintro x ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
    let f_fin := AlgebraicGeometry.Spec.map (α_diag₃.app u_fin)
    let π_fin := CategoryTheory.Limits.pullback.fst g_mid f_fin
    have h_eq1 := congrArg (fun φ => φ.base a) (hτ_fin_fst j₁)
    have h_eq2 := congrArg (fun φ => φ.base b) (hτ_fin_fst j₂)
    have h_eq : (τ_mid j₁).base (f_fin.base a) = (τ_mid j₂).base (f_fin.base b) := by
      calc
        (τ_mid j₁).base (f_fin.base a)
          = (AlgebraicGeometry.Spec.map (α_diag₃.app u_fin) ≫ τ_mid j₁).base a := rfl
        _ = (τ_fin j₁ ≫ CategoryTheory.Limits.pullback.fst g_mid
              (AlgebraicGeometry.Spec.map (α_diag₃.app u_fin))).base a := h_eq1.symm
        _ = π_fin.base ((τ_fin j₁).base a) := rfl
        _ = π_fin.base x := congrArg π_fin.base ha
        _ = π_fin.base ((τ_fin j₂).base b) := congrArg π_fin.base hb.symm
        _ = (τ_fin j₂ ≫ CategoryTheory.Limits.pullback.fst g_mid
              (AlgebraicGeometry.Spec.map (α_diag₃.app u_fin))).base b := rfl
        _ = (AlgebraicGeometry.Spec.map (α_diag₃.app u_fin) ≫ τ_mid j₂).base b := h_eq2
        _ = (τ_mid j₂).base (f_fin.base b) := rfl
    exact Set.disjoint_iff.mp (hDisj_mid hj) ⟨⟨f_fin.base a, rfl⟩, ⟨f_fin.base b, h_eq.symm⟩⟩

  exact ⟨F₁, ι₁_FV, C₁, g₁, τ_fin, ι_fin, i_fin.2.1, i_fin.2.2, rfl,
    hQC₁, hSep₁, hLFP₁, hSurj₁, hSec_fin, hDisj₁, hSmSec_fin, hPb_fin, hτ_fin_V⟩

theorem weil_finitePresentation_chart_cover_and_baseChange (R₁ : Type u) [CommRing R₁]
    (C₁ : AlgebraicGeometry.Scheme.{u})
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₁))
    (hQC₁ : AlgebraicGeometry.QuasiCompact g₁)
    (hLFP₁ : AlgebraicGeometry.LocallyOfFinitePresentation g₁) :
    ∃ (r : ℕ) (m t : Fin r → ℕ)
      (f : ∀ i : Fin r, Fin (t i) → MvPolynomial (Fin (m i)) R₁),
      ∀ (A : Type u) [CommRing A] (φ : R₁ →+* A)
        (C_A : AlgebraicGeometry.Scheme.{u})
        (g_A : C_A ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
        (ι_A : C_A ⟶ C₁),
        CategoryTheory.IsPullback ι_A g_A g₁
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) →
        (AlgebraicGeometry.Flat g_A ↔
          ∀ i : Fin r,
            Module.Flat A
              (MvPolynomial (Fin (m i)) A ⧸
                Ideal.span (Set.range (fun ν : Fin (t i) => MvPolynomial.map φ (f i ν))))) :=
by
  have hCompSpec : CompactSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of R₁)) :=
    AlgebraicGeometry.Scheme.compactSpace_of_isAffine (AlgebraicGeometry.Spec (CommRingCat.of R₁))
  have hCompC₁ : CompactSpace ↥C₁ :=
    @AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace
      C₁ (AlgebraicGeometry.Spec (CommRingCat.of R₁)) g₁ hQC₁ hCompSpec
  let 𝒰 : C₁.OpenCover := C₁.affineCover.finiteSubcover
  let e_fin : 𝒰.I₀ ≃ Fin (Fintype.card 𝒰.I₀) := Fintype.equivFin 𝒰.I₀
  let r : ℕ := Fintype.card 𝒰.I₀
  let e_idx : Fin r ≃ 𝒰.I₀ := e_fin.symm
  let B_cat : Fin r → CommRingCat.{u} :=
    fun i => C₁.affineOpenCover.X (C₁.affineCover.idx (e_idx i).1)
  let B : Fin r → Type u := fun i => ↥(B_cat i)
  let j : ∀ i : Fin r, AlgebraicGeometry.Spec (CommRingCat.of (B i)) ⟶ C₁ :=
    fun i => 𝒰.f (e_idx i)
  have hj_open : ∀ i : Fin r, AlgebraicGeometry.IsOpenImmersion (j i) :=
    fun i => 𝒰.map_prop (e_idx i)
  let ψ : ∀ i : Fin r, R₁ →+* B i :=
    fun i => (AlgebraicGeometry.Spec.preimage (j i ≫ g₁)).hom
  have hψ_spec : ∀ i : Fin r,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ i)) = j i ≫ g₁ :=
    fun i => AlgebraicGeometry.Spec.map_preimage (j i ≫ g₁)

  have instZarLFP : AlgebraicGeometry.IsZariskiLocalAtSource
      (@AlgebraicGeometry.LocallyOfFinitePresentation :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    @AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
      (@AlgebraicGeometry.LocallyOfFinitePresentation)
      (fun {R S : Type u} [CommRing R] [CommRing S] => RingHom.FinitePresentation)
      inferInstance

  have hPres : ∀ i : Fin r,
      ∃ (m_i t_i : ℕ) (f_i : Fin t_i → MvPolynomial (Fin m_i) R₁),
        Nonempty
          (@AlgEquiv R₁ (MvPolynomial (Fin m_i) R₁ ⧸ Ideal.span (Set.range f_i)) (B i)
            _ _ _ _ (ψ i).toAlgebra) := by
    intro i
    have hLFP_chart : AlgebraicGeometry.LocallyOfFinitePresentation (j i ≫ g₁) :=
      @AlgebraicGeometry.IsZariskiLocalAtSource.comp
        (@AlgebraicGeometry.LocallyOfFinitePresentation) instZarLFP
        _ _ _ _ hLFP₁ (j i) (hj_open i)
    rw [← hψ_spec i] at hLFP_chart
    have hFP_hom : RingHom.FinitePresentation (ψ i) :=
      (@AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (@AlgebraicGeometry.LocallyOfFinitePresentation)
        (fun {R S : Type u} [CommRing R] [CommRing S] => RingHom.FinitePresentation)
        AlgebraicGeometry.instHasRingHomPropertyLocallyOfFinitePresentationFinitePresentation
        _ _ (CommRingCat.ofHom (ψ i))).mp hLFP_chart
    letI : Algebra R₁ (B i) := (ψ i).toAlgebra
    have hFP_alg : Algebra.FinitePresentation R₁ (B i) := hFP_hom
    obtain ⟨m_i, I₀, e_quot, hFG⟩ := Algebra.FinitePresentation.iff.mp hFP_alg
    obtain ⟨t_i, f_i, hf_span⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hFG
    have hI_eq : Ideal.span (Set.range f_i) = I₀ := hf_span
    rw [← hI_eq] at e_quot
    exact ⟨m_i, t_i, f_i, ⟨e_quot⟩⟩

  choose m t f h_eB using hPres

  refine ⟨r, m, t, f, ?_⟩
  intro A _ φ C_A g_A ι_A hPb
  let s_φ : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R₁) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
  let P_flat : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Flat
  have instZarFlat : AlgebraicGeometry.IsZariskiLocalAtSource P_flat :=
    @AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
      P_flat
      (fun {R S : Type u} [CommRing R] [CommRing S] => RingHom.Flat)
      inferInstance
  have instRespFlat : CategoryTheory.MorphismProperty.RespectsIso P_flat := inferInstance

  have hFlat_pb : AlgebraicGeometry.Flat g_A ↔
      AlgebraicGeometry.Flat (CategoryTheory.Limits.pullback.snd g₁ s_φ) := by
    change P_flat g_A ↔ P_flat (CategoryTheory.Limits.pullback.snd g₁ s_φ)
    rw [← hPb.isoPullback_hom_snd]
    exact CategoryTheory.MorphismProperty.cancel_left_of_respectsIso
      P_flat hPb.isoPullback.hom (CategoryTheory.Limits.pullback.snd g₁ s_φ)

  have hFlat_cov : AlgebraicGeometry.Flat (CategoryTheory.Limits.pullback.snd g₁ s_φ) ↔
      ∀ i : Fin r, AlgebraicGeometry.Flat
        (CategoryTheory.Limits.pullback.snd (j i ≫ g₁) s_φ) := by
    have h_cov := @AlgebraicGeometry.IsZariskiLocalAtSource.iff_of_openCover
      P_flat instZarFlat _ _ (CategoryTheory.Limits.pullback.snd g₁ s_φ)
      (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeft 𝒰 g₁ s_φ)
    change AlgebraicGeometry.Flat (CategoryTheory.Limits.pullback.snd g₁ s_φ) ↔
        ∀ k : (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeft 𝒰 g₁ s_φ).I₀,
          AlgebraicGeometry.Flat
            ((AlgebraicGeometry.Scheme.Pullback.openCoverOfLeft 𝒰 g₁ s_φ).f k ≫
              CategoryTheory.Limits.pullback.snd g₁ s_φ) at h_cov
    rw [h_cov]
    have h_each : ∀ k : 𝒰.I₀,
        (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeft 𝒰 g₁ s_φ).f k ≫
          CategoryTheory.Limits.pullback.snd g₁ s_φ =
        CategoryTheory.Limits.pullback.snd (𝒰.f k ≫ g₁) s_φ := by
      intro k
      refine (congrArg (fun m => m ≫ CategoryTheory.Limits.pullback.snd g₁ s_φ)
        (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeft_f 𝒰 g₁ s_φ k)).trans ?_
      change CategoryTheory.Limits.pullback.map (𝒰.f k ≫ g₁) s_φ g₁ s_φ (𝒰.f k)
          (𝟙 _) (𝟙 _) _ _ ≫ CategoryTheory.Limits.pullback.snd g₁ s_φ = _
      rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
    change (∀ k : 𝒰.I₀, AlgebraicGeometry.Flat
        ((AlgebraicGeometry.Scheme.Pullback.openCoverOfLeft 𝒰 g₁ s_φ).f k ≫
          CategoryTheory.Limits.pullback.snd g₁ s_φ)) ↔ _
    rw [e_fin.forall_congr_left]
    refine forall_congr' fun i => ?_
    rw [h_each (e_idx i)]
    rfl

  rw [hFlat_pb, hFlat_cov]
  refine forall_congr' fun i => ?_

  letI : Algebra R₁ (B i) := (ψ i).toAlgebra
  letI : Algebra R₁ A := φ.toAlgebra
  let e_B_i : (MvPolynomial (Fin (m i)) R₁ ⧸ Ideal.span (Set.range (f i))) ≃ₐ[R₁] B i :=
    Classical.choice (h_eB i)

  have hFlat_spec : AlgebraicGeometry.Flat
      (CategoryTheory.Limits.pullback.snd (j i ≫ g₁) s_φ) ↔
      Module.Flat A (TensorProduct R₁ A (B i)) := by
    let e_congr := CategoryTheory.Limits.pullback.congrHom (hψ_spec i) (rfl : s_φ = s_φ)
    have h_congr_snd : e_congr.hom ≫ CategoryTheory.Limits.pullback.snd (j i ≫ g₁) s_φ =
        CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ (B i))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ A))) := by
      change (CategoryTheory.Limits.pullback.congrHom (hψ_spec i) (rfl : s_φ = s_φ)).hom ≫
          CategoryTheory.Limits.pullback.snd (j i ≫ g₁) s_φ = _
      rw [CategoryTheory.Limits.pullback.congrHom_hom,
        CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
    have h1 : AlgebraicGeometry.Flat (CategoryTheory.Limits.pullback.snd (j i ≫ g₁) s_φ) ↔
        AlgebraicGeometry.Flat
          (CategoryTheory.Limits.pullback.snd
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ (B i))))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ A)))) := by
      change P_flat _ ↔ P_flat _
      rw [← h_congr_snd]
      exact (CategoryTheory.MorphismProperty.cancel_left_of_respectsIso
        P_flat e_congr.hom _).symm
    let incR_hom : A →+* TensorProduct R₁ (B i) A :=
      ↑(Algebra.TensorProduct.includeRight : A →ₐ[R₁] TensorProduct R₁ (B i) A)
    have h2 : AlgebraicGeometry.Flat
        (CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ (B i))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ A)))) ↔
        AlgebraicGeometry.Flat
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR_hom)) := by
      change P_flat _ ↔ P_flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR_hom))
      rw [← AlgebraicGeometry.pullbackSpecIso_inv_snd R₁ (B i) A]
      exact (CategoryTheory.MorphismProperty.cancel_left_of_respectsIso
        P_flat (AlgebraicGeometry.pullbackSpecIso R₁ (B i) A).inv _).symm
    let e_comm : TensorProduct R₁ (B i) A ≃+* TensorProduct R₁ A (B i) :=
      (Algebra.TensorProduct.comm R₁ (B i) A).toRingEquiv
    have h_iso_spec_comm : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_comm.toRingHom)) := by
      refine ⟨⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_comm.symm.toRingHom), ?_, ?_⟩⟩
      · rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h_id : e_comm.toRingHom.comp e_comm.symm.toRingHom = RingHom.id _ :=
          RingHom.ext e_comm.apply_symm_apply
        rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      · rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h_id : e_comm.symm.toRingHom.comp e_comm.toRingHom = RingHom.id _ :=
          RingHom.ext e_comm.symm_apply_apply
        rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    have h_comp_alg : e_comm.toRingHom.comp incR_hom =
        algebraMap A (TensorProduct R₁ A (B i)) := by
      apply RingHom.ext
      intro a
      change (Algebra.TensorProduct.comm R₁ (B i) A) ((1 : B i) ⊗ₜ[R₁] a) = a ⊗ₜ[R₁] (1 : B i)
      exact Algebra.TensorProduct.comm_tmul R₁ (1 : B i) a
    have h3 : AlgebraicGeometry.Flat
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR_hom)) ↔
        AlgebraicGeometry.Flat
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap A (TensorProduct R₁ A (B i))))) := by
      change P_flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR_hom)) ↔
        P_flat (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap A (TensorProduct R₁ A (B i)))))
      rw [← CategoryTheory.MorphismProperty.cancel_left_of_respectsIso
        P_flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_comm.toRingHom))]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, h_comp_alg]
    have h4 : AlgebraicGeometry.Flat
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap A (TensorProduct R₁ A (B i))))) ↔
        Module.Flat A (TensorProduct R₁ A (B i)) := by
      rw [@AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (@AlgebraicGeometry.Flat)
        (fun {R S : Type u} [CommRing R] [CommRing S] => RingHom.Flat)
        AlgebraicGeometry.Flat.instHasRingHomPropertyFlat
        _ _ (CommRingCat.ofHom (algebraMap A (TensorProduct R₁ A (B i))))]
      exact RingHom.flat_algebraMap_iff
    exact h1.trans (h2.trans (h3.trans h4))

  rw [hFlat_spec]

  let I₁ : Ideal (MvPolynomial (Fin (m i)) R₁) := Ideal.span (Set.range (f i))
  let I_A : Ideal (MvPolynomial (Fin (m i)) A) :=
    Ideal.span (Set.range (fun ν : Fin (t i) => MvPolynomial.map φ (f i ν)))
  let e_step1 : TensorProduct R₁ A (B i) ≃ₐ[A]
      TensorProduct R₁ A (MvPolynomial (Fin (m i)) R₁ ⧸ I₁) :=
    Algebra.TensorProduct.congr AlgEquiv.refl e_B_i.symm

  have hMapI : ∀ P ∈ I₁, Ideal.Quotient.mk I_A (MvPolynomial.map φ P) = 0 := by
    intro P hP
    rw [Ideal.Quotient.eq_zero_iff_mem]
    obtain ⟨c, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hP
    simp only [map_sum, map_mul]
    exact Ideal.sum_mem I_A fun ν _ => Ideal.mul_mem_left I_A _ (Ideal.subset_span ⟨ν, rfl⟩)

  let β_ring : (MvPolynomial (Fin (m i)) R₁ ⧸ I₁) →+* (MvPolynomial (Fin (m i)) A ⧸ I_A) :=
    Ideal.Quotient.lift I₁ ((Ideal.Quotient.mk I_A).comp (MvPolynomial.map φ)) hMapI
  let β : (MvPolynomial (Fin (m i)) R₁ ⧸ I₁) →ₐ[R₁] (MvPolynomial (Fin (m i)) A ⧸ I_A) :=
    { β_ring with
      commutes' := fun r₁ => by
        change Ideal.Quotient.mk I_A (MvPolynomial.map φ (MvPolynomial.C r₁)) =
          Ideal.Quotient.mk I_A (MvPolynomial.C (φ r₁))
        rw [MvPolynomial.map_C] }

  let Φ : TensorProduct R₁ A (MvPolynomial (Fin (m i)) R₁ ⧸ I₁) →ₐ[A]
      (MvPolynomial (Fin (m i)) A ⧸ I_A) :=
    Algebra.TensorProduct.lift (Algebra.ofId A _) β (fun _ _ => Commute.all _ _)
  have hΦ_tmul : ∀ (a : A) (q : MvPolynomial (Fin (m i)) R₁ ⧸ I₁),
      Φ (a ⊗ₜ[R₁] q) = algebraMap A _ a * β q :=
    fun a q => Algebra.TensorProduct.lift_tmul (Algebra.ofId A _) β
      (fun _ _ => Commute.all _ _) a q

  let incR : (MvPolynomial (Fin (m i)) R₁ ⧸ I₁) →ₐ[R₁]
      TensorProduct R₁ A (MvPolynomial (Fin (m i)) R₁ ⧸ I₁) :=
    Algebra.TensorProduct.includeRight
  let η₀ : MvPolynomial (Fin (m i)) A →ₐ[A]
      TensorProduct R₁ A (MvPolynomial (Fin (m i)) R₁ ⧸ I₁) :=
    MvPolynomial.aeval (fun ℓ => incR (Ideal.Quotient.mk I₁ (MvPolynomial.X ℓ)))

  have hη₀_map : ∀ P : MvPolynomial (Fin (m i)) R₁,
      η₀ (MvPolynomial.map φ P) = incR (Ideal.Quotient.mk I₁ P) := by
    intro P
    induction P using MvPolynomial.induction_on with
    | C r₁ =>
      rw [MvPolynomial.map_C, MvPolynomial.aeval_C]
      change φ r₁ ⊗ₜ[R₁] (1 : MvPolynomial (Fin (m i)) R₁ ⧸ I₁) =
        1 ⊗ₜ[R₁] Ideal.Quotient.mk I₁ (MvPolynomial.C r₁)
      have hr₁ : φ r₁ = r₁ • (1 : A) :=
        ((Algebra.smul_def r₁ (1 : A)).trans (mul_one _)).symm
      rw [hr₁, TensorProduct.smul_tmul]
      congr 1
      rw [← Algebra.algebraMap_eq_smul_one]
      rfl
    | add p q ihp ihq => simp only [map_add, ihp, ihq]
    | mul_X p ℓ ihp =>
      rw [map_mul, MvPolynomial.map_X, map_mul, ihp, MvPolynomial.aeval_X, ← map_mul, ← map_mul]

  have hη₀_IA : ∀ P ∈ I_A, η₀ P = 0 := by
    intro P hP
    obtain ⟨c, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hP
    simp only [map_sum, map_mul]
    refine Finset.sum_eq_zero fun ν _ => ?_
    rw [hη₀_map]
    have hzero : Ideal.Quotient.mk I₁ (f i ν) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨ν, rfl⟩)
    rw [hzero, map_zero]
    exact mul_zero (η₀ (c ν))

  let Ψ : (MvPolynomial (Fin (m i)) A ⧸ I_A) →ₐ[A]
      TensorProduct R₁ A (MvPolynomial (Fin (m i)) R₁ ⧸ I₁) :=
    Ideal.Quotient.liftₐ I_A η₀ hη₀_IA

  have hΦΨ : Φ.comp Ψ = AlgHom.id A _ := by
    apply AlgHom.coe_ringHom_injective
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      change Φ (Ψ (Ideal.Quotient.mk I_A (MvPolynomial.C a))) =
        Ideal.Quotient.mk I_A (MvPolynomial.C a)
      change Φ (η₀ (MvPolynomial.C a)) = _
      rw [MvPolynomial.aeval_C, Φ.commutes]
      rfl
    · intro ℓ
      change Φ (Ψ (Ideal.Quotient.mk I_A (MvPolynomial.X ℓ))) =
        Ideal.Quotient.mk I_A (MvPolynomial.X ℓ)
      change Φ (η₀ (MvPolynomial.X ℓ)) = _
      rw [MvPolynomial.aeval_X]
      change Φ (1 ⊗ₜ[R₁] Ideal.Quotient.mk I₁ (MvPolynomial.X ℓ)) = _
      rw [hΦ_tmul, map_one, one_mul]
      change Ideal.Quotient.mk I_A (MvPolynomial.map φ (MvPolynomial.X ℓ)) = _
      rw [MvPolynomial.map_X]

  have hΨΦ : Ψ.comp Φ = AlgHom.id A _ := by
    apply AlgHom.ext
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul a q =>
      change Ψ (Φ (a ⊗ₜ[R₁] q)) = a ⊗ₜ[R₁] q
      have htmul : (a ⊗ₜ[R₁] q : TensorProduct R₁ A (MvPolynomial (Fin (m i)) R₁ ⧸ I₁)) =
          a • (1 ⊗ₜ[R₁] q) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [htmul, map_smul, map_smul]
      congr 1
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q
      rw [hΦ_tmul, map_one, one_mul]
      change Ψ (Ideal.Quotient.mk I_A (MvPolynomial.map φ P)) =
        1 ⊗ₜ[R₁] Ideal.Quotient.mk I₁ P
      change η₀ (MvPolynomial.map φ P) = _
      exact hη₀_map P
    | add u v ihu ihv => simp only [map_add, ihu, ihv]

  let e_tot : TensorProduct R₁ A (B i) ≃ₐ[A] (MvPolynomial (Fin (m i)) A ⧸ I_A) :=
    e_step1.trans (AlgEquiv.ofAlgHom Φ Ψ hΦΨ hΨΦ)

  constructor
  · intro hFlatT
    exact @Module.Flat.of_linearEquiv A _ _ _ _ _ _ _ hFlatT e_tot.symm.toLinearEquiv
  · intro hFlatQ
    exact @Module.Flat.of_linearEquiv A _ _ _ _ _ _ _ hFlatQ e_tot.toLinearEquiv

theorem weil_mvPolynomial_quotient_pointwise_syzygy_descent (R₁ V₀ : Type u) [CommRing R₁] [CommRing V₀]
    (ι₁ : R₁ →+* V₀) (hInj₁ : Function.Injective ι₁)
    (m t : ℕ) (f : Fin t → MvPolynomial (Fin m) R₁)
    (hFlatV : Module.Flat V₀
      (MvPolynomial (Fin m) V₀ ⧸
        Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map ι₁ (f ν)))))
    (q_V : PrimeSpectrum
      (MvPolynomial (Fin m) V₀ ⧸
        Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map ι₁ (f ν))))) :
    ∃ (S : Finset V₀),
      ∀ (R : Type u) [CommRing R] (inc : R₁ →+* R) (ι : R →+* V₀),
        ι.comp inc = ι₁ →
        Function.Injective ι →
        (↑S : Set V₀) ⊆ Set.range ι →
        let I_R : Ideal (MvPolynomial (Fin m) R) :=
          Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map inc (f ν)))
        ∃ (q_R : PrimeSpectrum (MvPolynomial (Fin m) R ⧸ I_R)),
          (∀ P : MvPolynomial (Fin m) R,
            Ideal.Quotient.mk I_R P ∈ q_R.asIdeal ↔
              Ideal.Quotient.mk
                (Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map ι₁ (f ν))))
                (MvPolynomial.map ι P) ∈ q_V.asIdeal) ∧
          Function.Injective
            (LinearMap.rTensor (Localization.AtPrime q_R.asIdeal)
              (Ideal.comap
                (algebraMap R (MvPolynomial (Fin m) R ⧸ I_R))
                q_R.asIdeal).subtype) :=
by
  have _ := hInj₁
  
  
  
  
  let coeffSubmodule : ∀ {A : Type u} [CommRing A], Ideal A → Submodule A (MvPolynomial (Fin m) A) :=
    fun {A} _ p =>
      { carrier := {P | ∀ α : Fin m →₀ ℕ, P.coeff α ∈ p}
        zero_mem' := fun α => by simp
        add_mem' := fun {P Q} hP hQ α => by
          rw [show (P + Q).coeff α = P.coeff α + Q.coeff α from
            (MvPolynomial.lcoeff A α).map_add P Q]
          exact p.add_mem (hP α) (hQ α)
        smul_mem' := fun c {P} hP α => by
          rw [MvPolynomial.coeff_smul, smul_eq_mul]
          exact Ideal.mul_mem_left p c (hP α) }

  have hMulMemCoeff : ∀ {A : Type u} [CommRing A] (p : Ideal A)
      (H P : MvPolynomial (Fin m) A),
      P ∈ coeffSubmodule p → H * P ∈ coeffSubmodule p := by
    intro A _ p H P hP γ
    rw [MvPolynomial.coeff_mul]
    exact Ideal.sum_mem p fun x _ => Ideal.mul_mem_left p (H.coeff x.1) (hP x.2)

  let coeffTensorToSub : ∀ {A : Type u} [CommRing A] (p : Ideal A),
      TensorProduct A ↥p (MvPolynomial (Fin m) A) →ₗ[A] ↥(coeffSubmodule p) :=
    fun {A} _ p =>
      TensorProduct.lift
        { toFun := fun x =>
            { toFun := fun Q =>
                ⟨(x : A) • Q, fun α => by
                  rw [MvPolynomial.coeff_smul, smul_eq_mul]
                  exact Ideal.mul_mem_right (Q.coeff α) p x.2⟩
              map_add' := fun Q₁ Q₂ => Subtype.ext (smul_add (x : A) Q₁ Q₂)
              map_smul' := fun r Q => Subtype.ext (smul_comm (x : A) r Q) }
          map_add' := fun x₁ x₂ => by
            apply LinearMap.ext
            intro Q
            exact Subtype.ext (add_smul (x₁ : A) (x₂ : A) Q)
          map_smul' := fun r x => by
            apply LinearMap.ext
            intro Q
            exact Subtype.ext (mul_smul r (x : A) Q) }

  let coeffSubToTensor : ∀ {A : Type u} [CommRing A] (p : Ideal A),
      ↥(coeffSubmodule p) → TensorProduct A ↥p (MvPolynomial (Fin m) A) :=
    fun {A} _ p y =>
      ∑ α ∈ y.1.support,
        (⟨y.1.coeff α, y.2 α⟩ : ↥p) ⊗ₜ[A] MvPolynomial.monomial α (1 : A)

  have hSubToTensor_superset : ∀ {A : Type u} [CommRing A] (p : Ideal A)
      (y : ↥(coeffSubmodule p)) (F : Finset (Fin m →₀ ℕ)),
      y.1.support ⊆ F →
      coeffSubToTensor p y =
        ∑ α ∈ F, (⟨y.1.coeff α, y.2 α⟩ : ↥p) ⊗ₜ[A] MvPolynomial.monomial α (1 : A) := by
    intro A _ p y F hSubF
    refine Finset.sum_subset hSubF fun α _ hNotMem => ?_
    have hCoeffZero : y.1.coeff α = 0 := by
      by_contra hNe
      exact hNotMem (MvPolynomial.mem_support_iff.mpr hNe)
    have hZeroP : (⟨y.1.coeff α, y.2 α⟩ : ↥p) = 0 := Subtype.ext hCoeffZero
    rw [hZeroP, TensorProduct.zero_tmul]

  have hSubToTensor_add : ∀ {A : Type u} [CommRing A] (p : Ideal A)
      (y₁ y₂ : ↥(coeffSubmodule p)),
      coeffSubToTensor p (y₁ + y₂) = coeffSubToTensor p y₁ + coeffSubToTensor p y₂ := by
    intro A _ p y₁ y₂
    let F : Finset (Fin m →₀ ℕ) := y₁.1.support ∪ y₂.1.support
    have hSub12 : (y₁ + y₂).1.support ⊆ F := by
      intro α hα
      have hNe : (y₁.1 + y₂.1).coeff α ≠ 0 := MvPolynomial.mem_support_iff.mp hα
      rw [show (y₁.1 + y₂.1).coeff α = y₁.1.coeff α + y₂.1.coeff α from
        (MvPolynomial.lcoeff A α).map_add y₁.1 y₂.1] at hNe
      by_contra hNotU
      rw [Finset.mem_union, not_or, MvPolynomial.mem_support_iff, not_not,
        MvPolynomial.mem_support_iff, not_not] at hNotU
      exact hNe (by rw [hNotU.1, hNotU.2, add_zero])
    rw [hSubToTensor_superset p (y₁ + y₂) F hSub12,
      hSubToTensor_superset p y₁ F Finset.subset_union_left,
      hSubToTensor_superset p y₂ F Finset.subset_union_right,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun α _ => ?_
    have hEqP : (⟨(y₁ + y₂).1.coeff α, (y₁ + y₂).2 α⟩ : ↥p) =
        (⟨y₁.1.coeff α, y₁.2 α⟩ : ↥p) + (⟨y₂.1.coeff α, y₂.2 α⟩ : ↥p) :=
      Subtype.ext ((MvPolynomial.lcoeff A α).map_add y₁.1 y₂.1)
    rw [hEqP, TensorProduct.add_tmul]

  have hRightInv : ∀ {A : Type u} [CommRing A] (p : Ideal A) (y : ↥(coeffSubmodule p)),
      coeffTensorToSub p (coeffSubToTensor p y) = y := by
    intro A _ p y
    apply Subtype.ext
    change ((coeffTensorToSub p) (∑ α ∈ y.1.support,
      (⟨y.1.coeff α, y.2 α⟩ : ↥p) ⊗ₜ[A] MvPolynomial.monomial α (1 : A))).1 = y.1
    rw [map_sum, Submodule.coe_sum]
    have hSum :
        (∑ α ∈ y.1.support,
          ((coeffTensorToSub p) ((⟨y.1.coeff α, y.2 α⟩ : ↥p) ⊗ₜ[A]
            MvPolynomial.monomial α (1 : A))).1) =
        ∑ α ∈ y.1.support, MvPolynomial.monomial α (y.1.coeff α) := by
      refine Finset.sum_congr rfl fun α _ => ?_
      change (y.1.coeff α) • MvPolynomial.monomial α (1 : A) = _
      rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
    rw [hSum]
    exact (MvPolynomial.as_sum y.1).symm

  have hLeftInv : ∀ {A : Type u} [CommRing A] (p : Ideal A)
      (z : TensorProduct A ↥p (MvPolynomial (Fin m) A)),
      coeffSubToTensor p (coeffTensorToSub p z) = z := by
    intro A _ p z
    induction z using TensorProduct.induction_on with
    | zero =>
      rw [map_zero]
      exact hSubToTensor_superset p 0 ∅ (by simp)
    | tmul x Q =>
      have hSubQ : (coeffTensorToSub p (x ⊗ₜ[A] Q)).1.support ⊆ Q.support := by
        intro α hα
        have hNe : ((x : A) • Q).coeff α ≠ 0 := MvPolynomial.mem_support_iff.mp hα
        rw [MvPolynomial.coeff_smul, smul_eq_mul] at hNe
        exact MvPolynomial.mem_support_iff.mpr (right_ne_zero_of_mul hNe)
      rw [hSubToTensor_superset p (coeffTensorToSub p (x ⊗ₜ[A] Q)) Q.support hSubQ]
      have hSum :
          (∑ α ∈ Q.support,
            (⟨(coeffTensorToSub p (x ⊗ₜ[A] Q)).1.coeff α,
              (coeffTensorToSub p (x ⊗ₜ[A] Q)).2 α⟩ : ↥p) ⊗ₜ[A]
              MvPolynomial.monomial α (1 : A)) =
          ∑ α ∈ Q.support, x ⊗ₜ[A] MvPolynomial.monomial α (Q.coeff α) := by
        refine Finset.sum_congr rfl fun α _ => ?_
        have hEqP :
            (⟨(coeffTensorToSub p (x ⊗ₜ[A] Q)).1.coeff α,
              (coeffTensorToSub p (x ⊗ₜ[A] Q)).2 α⟩ : ↥p) =
            (Q.coeff α) • x := by
          apply Subtype.ext
          change ((x : A) • Q).coeff α = Q.coeff α * (x : A)
          rw [MvPolynomial.coeff_smul, smul_eq_mul, mul_comm]
        rw [hEqP, TensorProduct.smul_tmul, MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
      rw [hSum, ← TensorProduct.tmul_sum, ← MvPolynomial.as_sum Q]
    | add u v ihu ihv =>
      rw [map_add, hSubToTensor_add, ihu, ihv]

  have hExistsMonomialEquiv : ∀ {A : Type u} [CommRing A] (p : Ideal A),
      ∃ e_p : TensorProduct A ↥p (MvPolynomial (Fin m) A) ≃ₗ[A] ↥(coeffSubmodule p),
        (∀ (x : ↥p) (Q : MvPolynomial (Fin m) A), (e_p (x ⊗ₜ[A] Q)).1 = (x : A) • Q) ∧
        (∀ {N_mod : Type u} [AddCommMonoid N_mod] [Module A N_mod]
            (π_lin : MvPolynomial (Fin m) A →ₗ[A] N_mod)
            (z : TensorProduct A ↥p (MvPolynomial (Fin m) A)),
          (TensorProduct.lid A N_mod)
            (LinearMap.rTensor N_mod p.subtype (LinearMap.lTensor ↥p π_lin z)) =
          π_lin (e_p z).1) ∧
        (∀ (H : MvPolynomial (Fin m) A) (y : ↥(coeffSubmodule p)),
          LinearMap.lTensor ↥p (LinearMap.mulLeft A H) (e_p.symm y) =
          e_p.symm ⟨H * y.1, hMulMemCoeff p H y.1 y.2⟩) := by
    intro A _ p
    let e_p : TensorProduct A ↥p (MvPolynomial (Fin m) A) ≃ₗ[A] ↥(coeffSubmodule p) :=
      { coeffTensorToSub p with
        invFun := coeffSubToTensor p
        left_inv := hLeftInv p
        right_inv := hRightInv p }
    refine ⟨e_p, fun _ _ => rfl, ?_, ?_⟩
    · intro N_mod _ _ π_lin z
      let lhsMap : TensorProduct A ↥p (MvPolynomial (Fin m) A) →ₗ[A] N_mod :=
        (TensorProduct.lid A N_mod).toLinearMap.comp
          ((LinearMap.rTensor N_mod p.subtype).comp (LinearMap.lTensor ↥p π_lin))
      let rhsMap : TensorProduct A ↥p (MvPolynomial (Fin m) A) →ₗ[A] N_mod :=
        π_lin.comp ((coeffSubmodule p).subtype.comp e_p.toLinearMap)
      have hEqMaps : lhsMap = rhsMap := by
        apply TensorProduct.ext'
        intro x Q
        change (TensorProduct.lid A N_mod) ((x : A) ⊗ₜ[A] π_lin Q) = π_lin ((x : A) • Q)
        rw [TensorProduct.lid_tmul, map_smul]
      exact LinearMap.congr_fun hEqMaps z
    · intro H y
      apply e_p.injective
      apply Subtype.ext
      let lhsMap : TensorProduct A ↥p (MvPolynomial (Fin m) A) →ₗ[A] MvPolynomial (Fin m) A :=
        (coeffSubmodule p).subtype.comp
          (e_p.toLinearMap.comp (LinearMap.lTensor ↥p (LinearMap.mulLeft A H)))
      let rhsMap : TensorProduct A ↥p (MvPolynomial (Fin m) A) →ₗ[A] MvPolynomial (Fin m) A :=
        (LinearMap.mulLeft A H).comp ((coeffSubmodule p).subtype.comp e_p.toLinearMap)
      have hEqMaps : lhsMap = rhsMap := by
        apply TensorProduct.ext'
        intro x Q
        change (x : A) • (H * Q) = H * ((x : A) • Q)
        exact (mul_smul_comm (x : A) H Q).symm
      have hMulZ := LinearMap.congr_fun hEqMaps (e_p.symm y)
      change (e_p (LinearMap.lTensor ↥p (LinearMap.mulLeft A H) (e_p.symm y))).1 =
        H * (e_p (e_p.symm y)).1 at hMulZ
      rw [hMulZ, LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]

  
  
  
  have hFlatCoeffDecomp : ∀ (A : Type u) [CommRing A] (p : Ideal A)
      (g : Fin t → MvPolynomial (Fin m) A),
      Module.Flat A (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range g)) →
      ∀ G : MvPolynomial (Fin m) A,
        G ∈ Ideal.span (Set.range g) →
        (∀ α : Fin m →₀ ℕ, G.coeff α ∈ p) →
        ∃ q : Fin t → MvPolynomial (Fin m) A,
          (∀ (ν : Fin t) (α : Fin m →₀ ℕ), (q ν).coeff α ∈ p) ∧
          G = ∑ ν : Fin t, q ν * g ν := by
    intro A _ p g hFlat G hG_mem hG_coeff
    obtain ⟨e_p, he_tmul, he_lid, _⟩ := hExistsMonomialEquiv p
    let P_A := MvPolynomial (Fin m) A
    let I : Ideal P_A := Ideal.span (Set.range g)
    let B := P_A ⧸ I
    let I_sub : Submodule A P_A := I.restrictScalars A
    let ι_I : ↥I_sub →ₗ[A] P_A := I_sub.subtype
    let π_A : P_A →ₗ[A] B := (Ideal.Quotient.mkₐ A I).toLinearMap
    have hSurj : Function.Surjective ⇑π_A := Ideal.Quotient.mk_surjective
    have hExact : Function.Exact ⇑ι_I ⇑π_A := by
      intro Q
      change Ideal.Quotient.mk I Q = 0 ↔ Q ∈ Set.range ⇑ι_I
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact ⟨fun hQ => ⟨⟨Q, hQ⟩, rfl⟩, fun ⟨x, hx⟩ => hx ▸ x.2⟩
    let z_G : TensorProduct A ↥p P_A := e_p.symm ⟨G, hG_coeff⟩
    have hz_G_val : (e_p z_G).1 = G := by
      change (e_p (e_p.symm ⟨G, hG_coeff⟩)).1 = G
      rw [LinearEquiv.apply_symm_apply]
    have hKill : LinearMap.lTensor ↥p π_A z_G = 0 := by
      have hInj_r : Function.Injective ⇑(LinearMap.rTensor B p.subtype) :=
        (Module.Flat.iff_rTensor_injective'.mp hFlat) p
      apply hInj_r
      apply (TensorProduct.lid A B).injective
      rw [map_zero, map_zero, he_lid, hz_G_val]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hG_mem
    obtain ⟨u, hu⟩ := (_root_.lTensor_exact ↥p hExact hSurj z_G).mp hKill
    obtain ⟨J, rfl⟩ := TensorProduct.exists_finset u
    have hG_sum : ∑ x ∈ J, (x.1 : A) • (x.2 : P_A) = G := by
      rw [← hz_G_val, ← hu, map_sum, map_sum, Submodule.coe_sum]
      refine Finset.sum_congr rfl fun x _ => ?_
      exact (he_tmul x.1 (x.2 : P_A)).symm
    have hSpanMem : ∀ x : ↥p × ↥I_sub, ∃ c : Fin t → P_A, ∑ ν : Fin t, c ν * g ν = (x.2 : P_A) :=
      fun x => Ideal.mem_span_range_iff_exists_fun.mp x.2.2
    choose c_I hc_I using hSpanMem
    let q : Fin t → P_A := fun ν => ∑ x ∈ J, (x.1 : A) • c_I x ν
    refine ⟨q, ?_, ?_⟩
    · intro ν
      refine Submodule.sum_mem (coeffSubmodule p) fun x _ α => ?_
      rw [MvPolynomial.coeff_smul, smul_eq_mul]
      exact Ideal.mul_mem_right _ p x.1.2
    · rw [← hG_sum]
      calc
        ∑ x ∈ J, (x.1 : A) • (x.2 : P_A)
          = ∑ x ∈ J, (x.1 : A) • (∑ ν : Fin t, c_I x ν * g ν) := by
              refine Finset.sum_congr rfl fun x _ => by rw [hc_I x]
        _ = ∑ x ∈ J, ∑ ν : Fin t, ((x.1 : A) • c_I x ν) * g ν := by
              refine Finset.sum_congr rfl fun x _ => ?_
              rw [Finset.smul_sum]
              refine Finset.sum_congr rfl fun ν _ => (smul_mul_assoc (x.1 : A) _ _).symm
        _ = ∑ ν : Fin t, q ν * g ν := by
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl fun ν _ => (Finset.sum_mul J _ (g ν)).symm

  
  
  
  have hClearDenoms : ∀ (D : Type u) [CommRing D] [IsDomain D]
      (ι_idx : Type) [Fintype ι_idx]
      (H : ι_idx → MvPolynomial (Fin m) (FractionRing D)),
      ∃ (c : D) (H_D : ι_idx → MvPolynomial (Fin m) D),
        c ≠ 0 ∧
        ∀ i : ι_idx,
          MvPolynomial.map (algebraMap D (FractionRing D)) (H_D i) =
            (algebraMap D (FractionRing D) c) • H i := by
    intro D _ _ ι_idx _ H
    let κ := FractionRing D
    let _ : DecidableEq κ := Classical.decEq κ
    let S_coeff : Finset κ :=
      Finset.univ.biUnion (fun i : ι_idx => (H i).support.image (H i).coeff)
    obtain ⟨b, hb⟩ :=
      IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors D) S_coeff
    have hb_ne : (b : D) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b.2
    have hIntCoeff : ∀ (i : ι_idx) (α : ↥(H i).support),
        ∃ r : D, algebraMap D κ r = algebraMap D κ (b : D) * (H i).coeff α.1 := by
      intro i α
      have hMem : (H i).coeff α.1 ∈ S_coeff :=
        Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, Finset.mem_image_of_mem _ α.2⟩
      obtain ⟨r, hr⟩ := hb _ hMem
      refine ⟨r, ?_⟩
      rw [hr, Algebra.smul_def]
    choose r_lift hr_lift using hIntCoeff
    let H_D : ι_idx → MvPolynomial (Fin m) D :=
      fun i => ∑ α ∈ (H i).support.attach, MvPolynomial.monomial α.1 (r_lift i α)
    refine ⟨(b : D), H_D, hb_ne, ?_⟩
    intro i
    simp only [H_D, map_sum, MvPolynomial.map_monomial]
    have hEqLift :
        (∑ α ∈ (H i).support.attach,
          MvPolynomial.monomial α.1 (algebraMap D (FractionRing D) (r_lift i α))) =
        ∑ α ∈ (H i).support.attach,
          MvPolynomial.monomial α.1 (algebraMap D κ (b : D) * (H i).coeff α.1) :=
      Finset.sum_congr rfl fun α _ => by rw [hr_lift i α]
    rw [hEqLift]
    calc
      (∑ α ∈ (H i).support.attach,
          MvPolynomial.monomial α.1 (algebraMap D κ (b : D) * (H i).coeff α.1))
        = ∑ α ∈ (H i).support.attach,
            (algebraMap D κ (b : D)) • MvPolynomial.monomial α.1 ((H i).coeff α.1) := by
              refine Finset.sum_congr rfl fun α _ => ?_
              rw [MvPolynomial.smul_monomial, smul_eq_mul]
      _ = (algebraMap D κ (b : D)) •
            ∑ α ∈ (H i).support.attach, MvPolynomial.monomial α.1 ((H i).coeff α.1) := by
              rw [← Finset.smul_sum]
      _ = (algebraMap D κ (b : D)) • H i := by
            rw [Finset.sum_attach (H i).support (fun α => MvPolynomial.monomial α ((H i).coeff α)),
              ← MvPolynomial.as_sum (H i)]

  have hDomainSyzygyDescent : ∀ (D₀ : Type u) [CommRing D₀] [IsDomain D₀]
      (f₀ : Fin t → MvPolynomial (Fin m) D₀),
      ∃ (N : ℕ) (s₀ : Fin N → Fin t → MvPolynomial (Fin m) D₀),
        (∀ μ : Fin N, ∑ ν : Fin t, s₀ μ ν * f₀ ν = 0) ∧
        ∀ (D : Type u) [CommRing D] [IsDomain D] (j : D →+* D₀),
          Function.Injective j →
          ∀ (f_D : Fin t → MvPolynomial (Fin m) D)
            (s_D : Fin N → Fin t → MvPolynomial (Fin m) D),
            (∀ ν : Fin t, MvPolynomial.map j (f_D ν) = f₀ ν) →
            (∀ (μ : Fin N) (ν : Fin t), MvPolynomial.map j (s_D μ ν) = s₀ μ ν) →
            ∀ (g_D : Fin t → MvPolynomial (Fin m) D),
              (∑ ν : Fin t, g_D ν * f_D ν = 0) →
              ∃ (c : D) (q_D : Fin N → MvPolynomial (Fin m) D),
                c ≠ 0 ∧ ∀ ν : Fin t, c • g_D ν = ∑ μ : Fin N, q_D μ * s_D μ ν := by
    intro D₀ _ _ f₀
    let κ₀ := FractionRing D₀
    let P_κ₀ := MvPolynomial (Fin m) κ₀
    have : IsNoetherianRing P_κ₀ := MvPolynomial.isNoetherianRing
    have : IsNoetherian P_κ₀ (Fin t → P_κ₀) := isNoetherian_pi
    let f_κ₀ : Fin t → P_κ₀ := fun ν => MvPolynomial.map (algebraMap D₀ κ₀) (f₀ ν)
    let Φ₀ : (Fin t → P_κ₀) →ₗ[P_κ₀] P_κ₀ :=
      { toFun := fun g => ∑ ν : Fin t, g ν * f_κ₀ ν
        map_add' := fun g₁ g₂ => by simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
        map_smul' := fun P g => by
          simp only [Pi.smul_apply, smul_eq_mul, mul_assoc, ← Finset.mul_sum, RingHom.id_apply] }
    obtain ⟨T₀, hT₀_span⟩ := IsNoetherian.noetherian (LinearMap.ker Φ₀)
    let N := T₀.card
    let e_T : Fin N ≃ ↥T₀ := T₀.equivFin.symm
    let s_bar : Fin N → Fin t → P_κ₀ := fun μ => (e_T μ).1
    obtain ⟨d₀, s₀_pair, hd₀_ne, hs₀_pair⟩ :=
      hClearDenoms D₀ (Fin N × Fin t) (fun p => s_bar p.1 p.2)
    let s₀ : Fin N → Fin t → MvPolynomial (Fin m) D₀ := fun μ ν => s₀_pair (μ, ν)
    let u₀ : κ₀ := algebraMap D₀ κ₀ d₀
    have hu₀_ne : u₀ ≠ 0 := by
      intro hZero
      exact hd₀_ne ((IsFractionRing.injective D₀ κ₀) (hZero.trans (map_zero _).symm))
    have hs₀_map : ∀ (μ : Fin N) (ν : Fin t),
        MvPolynomial.map (algebraMap D₀ κ₀) (s₀ μ ν) = u₀ • s_bar μ ν :=
      fun μ ν => hs₀_pair (μ, ν)
    have hs₀_syz : ∀ μ : Fin N, ∑ ν : Fin t, s₀ μ ν * f₀ ν = 0 := by
      intro μ
      apply MvPolynomial.map_injective (algebraMap D₀ κ₀) (IsFractionRing.injective D₀ κ₀)
      simp only [map_sum, map_mul, map_zero, hs₀_map]
      have hKer : Φ₀ (s_bar μ) = 0 := by
        have hMem : s_bar μ ∈ LinearMap.ker Φ₀ := by
          rw [← hT₀_span]
          exact Submodule.subset_span (Finset.mem_coe.mpr (e_T μ).2)
        exact hMem
      calc
        ∑ ν : Fin t, (u₀ • s_bar μ ν) * f_κ₀ ν
          = u₀ • ∑ ν : Fin t, s_bar μ ν * f_κ₀ ν := by
              rw [Finset.smul_sum]
              refine Finset.sum_congr rfl fun ν _ => smul_mul_assoc u₀ _ _
        _ = u₀ • Φ₀ (s_bar μ) := rfl
        _ = 0 := by rw [hKer, smul_zero]
    have hSpanRescaled : ∀ g_κ₀ : Fin t → P_κ₀,
        Φ₀ g_κ₀ = 0 →
        ∃ q' : Fin N → P_κ₀,
          ∀ ν : Fin t,
            g_κ₀ ν = ∑ μ : Fin N, q' μ * MvPolynomial.map (algebraMap D₀ κ₀) (s₀ μ ν) := by
      intro g_κ₀ hg_ker
      have hMemSpan : g_κ₀ ∈ Submodule.span P_κ₀ (↑T₀ : Set (Fin t → P_κ₀)) := by
        rw [hT₀_span]
        exact hg_ker
      obtain ⟨q_raw, _, hq_sum⟩ := Submodule.mem_span_finset.mp hMemSpan
      let q' : Fin N → P_κ₀ := fun μ => u₀⁻¹ • q_raw (e_T μ).1
      refine ⟨q', ?_⟩
      intro ν
      have hEval := congrFun hq_sum ν
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at hEval
      rw [← hEval]
      calc
        ∑ z ∈ T₀, q_raw z * z ν
          = ∑ x : ↥T₀, q_raw x.1 * x.1 ν := (Finset.sum_coe_sort T₀ _).symm
        _ = ∑ μ : Fin N, q_raw (e_T μ).1 * s_bar μ ν := (e_T.sum_comp _).symm
        _ = ∑ μ : Fin N, q' μ * MvPolynomial.map (algebraMap D₀ κ₀) (s₀ μ ν) := by
              refine Finset.sum_congr rfl fun μ _ => ?_
              rw [hs₀_map]
              change q_raw (e_T μ).1 * s_bar μ ν =
                (u₀⁻¹ • q_raw (e_T μ).1) * (u₀ • s_bar μ ν)
              rw [MvPolynomial.smul_eq_C_mul, MvPolynomial.smul_eq_C_mul,
                mul_mul_mul_comm, ← MvPolynomial.C.map_mul, inv_mul_cancel₀ hu₀_ne,
                map_one, one_mul]
    refine ⟨N, s₀, hs₀_syz, ?_⟩
    intro D _ _ j hj f_D s_D hf_D hs_D g_D hg_D
    let κ_D := FractionRing D
    let P_κD := MvPolynomial (Fin m) κ_D
    let θ : κ_D →+* κ₀ := IsFractionRing.map (K := κ_D) (L := κ₀) hj
    have hθ_eq : ∀ r : D, θ (algebraMap D κ_D r) = algebraMap D₀ κ₀ (j r) :=
      fun r => IsLocalization.map_eq _ r
    have hθ_comp : θ.comp (algebraMap D κ_D) = (algebraMap D₀ κ₀).comp j :=
      RingHom.ext hθ_eq
    let _ : Algebra κ_D κ₀ := θ.toAlgebra
    have hKerBot : (Algebra.linearMap κ_D κ₀).ker = ⊥ :=
      LinearMap.ker_eq_bot.mpr θ.injective
    obtain ⟨lam, hlam⟩ :=
      LinearMap.exists_leftInverse_of_injective (Algebra.linearMap κ_D κ₀) hKerBot
    have hlam_id : ∀ a : κ_D, lam (θ a) = a :=
      fun a => LinearMap.congr_fun hlam a
    have hlam_mul : ∀ (v : κ₀) (a : κ_D), lam (v * θ a) = lam v * a := by
      intro v a
      have hv : v * θ a = a • v := by
        change v * algebraMap κ_D κ₀ a = a • v
        rw [Algebra.smul_def, mul_comm]
      rw [hv, lam.map_smul, smul_eq_mul, mul_comm]
    let lamPoly : P_κ₀ → P_κD :=
      fun Q => ∑ α ∈ Q.support, MvPolynomial.monomial α (lam (Q.coeff α))
    have hlamPoly_coeff : ∀ (Q : P_κ₀) (β : Fin m →₀ ℕ),
        (lamPoly Q).coeff β = lam (Q.coeff β) := by
      intro Q β
      dsimp only [lamPoly]
      rw [← MvPolynomial.lcoeff_apply, map_sum]
      simp only [MvPolynomial.lcoeff_apply, MvPolynomial.coeff_monomial]
      by_cases hβ : β ∈ Q.support
      · rw [Finset.sum_eq_single β]
        · simp
        · intro α _ hαβ
          exact if_neg hαβ
        · intro hNot
          exact absurd hβ hNot
      · have hZeroSum :
            (∑ α ∈ Q.support, if α = β then lam (Q.coeff α) else 0) = 0 := by
          refine Finset.sum_eq_zero fun α hα => if_neg ?_
          rintro rfl
          exact hβ hα
        have hCoeffZero : Q.coeff β = 0 := by
          by_contra hNe
          exact hβ (MvPolynomial.mem_support_iff.mpr hNe)
        rw [hZeroSum, hCoeffZero, map_zero]
    let g_κD : Fin t → P_κD := fun ν => MvPolynomial.map (algebraMap D κ_D) (g_D ν)
    let s_κD : Fin N → Fin t → P_κD :=
      fun μ ν => MvPolynomial.map (algebraMap D κ_D) (s_D μ ν)
    have hf_θ : ∀ ν : Fin t,
        MvPolynomial.map θ (MvPolynomial.map (algebraMap D κ_D) (f_D ν)) = f_κ₀ ν := by
      intro ν
      rw [MvPolynomial.map_map, hθ_comp, ← MvPolynomial.map_map, hf_D ν]
    have hs_θ : ∀ (μ : Fin N) (ν : Fin t),
        MvPolynomial.map θ (s_κD μ ν) = MvPolynomial.map (algebraMap D₀ κ₀) (s₀ μ ν) := by
      intro μ ν
      rw [MvPolynomial.map_map, hθ_comp, ← MvPolynomial.map_map, hs_D μ ν]
    have hg_ker₀ : Φ₀ (fun ν => MvPolynomial.map θ (g_κD ν)) = 0 := by
      change (∑ ν : Fin t, MvPolynomial.map θ (g_κD ν) * f_κ₀ ν) = 0
      have hRewrite :
          (∑ ν : Fin t, MvPolynomial.map θ (g_κD ν) * f_κ₀ ν) =
          MvPolynomial.map (θ.comp (algebraMap D κ_D)) (∑ ν : Fin t, g_D ν * f_D ν) := by
        simp only [map_sum, map_mul, ← MvPolynomial.map_map, hf_θ, g_κD]
      rw [hRewrite, hg_D, map_zero]
    obtain ⟨q', hq'⟩ := hSpanRescaled (fun ν => MvPolynomial.map θ (g_κD ν)) hg_ker₀
    let q_κD : Fin N → P_κD := fun μ => lamPoly (q' μ)
    have hq_κD_eq : ∀ ν : Fin t, g_κD ν = ∑ μ : Fin N, q_κD μ * s_κD μ ν := by
      intro ν
      have hEqθ : MvPolynomial.map θ (g_κD ν) =
          ∑ μ : Fin N, q' μ * MvPolynomial.map θ (s_κD μ ν) := by
        simpa only [hs_θ] using hq' ν
      have hApplyLam := congrArg lamPoly hEqθ
      ext β
      have hLHS : (lamPoly (MvPolynomial.map θ (g_κD ν))).coeff β = (g_κD ν).coeff β := by
        rw [hlamPoly_coeff, MvPolynomial.coeff_map, hlam_id]
      rw [← hLHS, hApplyLam, hlamPoly_coeff, ← MvPolynomial.lcoeff_apply, map_sum,
        ← MvPolynomial.lcoeff_apply, map_sum, map_sum]
      refine Finset.sum_congr rfl fun μ _ => ?_
      simp only [MvPolynomial.lcoeff_apply, q_κD]
      rw [MvPolynomial.coeff_mul, MvPolynomial.coeff_mul, map_sum]
      refine Finset.sum_congr rfl fun x _ => ?_
      rw [MvPolynomial.coeff_map, hlam_mul, hlamPoly_coeff]
    obtain ⟨c, q_D, hc_ne, hq_D_map⟩ := hClearDenoms D (Fin N) q_κD
    refine ⟨c, q_D, hc_ne, ?_⟩
    intro ν
    apply MvPolynomial.map_injective (algebraMap D κ_D) (IsFractionRing.injective D κ_D)
    rw [MvPolynomial.smul_eq_C_mul, map_mul, MvPolynomial.map_C, ← MvPolynomial.smul_eq_C_mul]
    change (algebraMap D κ_D c) • g_κD ν = _
    rw [hq_κD_eq ν, Finset.smul_sum, map_sum]
    refine Finset.sum_congr rfl fun μ _ => ?_
    rw [map_mul, hq_D_map μ, smul_mul_assoc]

  
  
  
  have hAtPrimeRTensorInj : ∀ (R : Type u) [CommRing R]
      (f_R : Fin t → MvPolynomial (Fin m) R)
      (q_R : PrimeSpectrum (MvPolynomial (Fin m) R ⧸ Ideal.span (Set.range f_R))),
      (∀ G : MvPolynomial (Fin m) R,
        G ∈ Ideal.span (Set.range f_R) →
        (∀ α : Fin m →₀ ℕ,
          G.coeff α ∈
            Ideal.comap (algebraMap R (MvPolynomial (Fin m) R ⧸ Ideal.span (Set.range f_R)))
              q_R.asIdeal) →
        ∃ (c : R) (w : Fin t → MvPolynomial (Fin m) R),
          c ∉ Ideal.comap (algebraMap R (MvPolynomial (Fin m) R ⧸ Ideal.span (Set.range f_R)))
            q_R.asIdeal ∧
          (∀ (ν : Fin t) (α : Fin m →₀ ℕ),
            (w ν).coeff α ∈
              Ideal.comap (algebraMap R (MvPolynomial (Fin m) R ⧸ Ideal.span (Set.range f_R)))
                q_R.asIdeal) ∧
          c • G = ∑ ν : Fin t, w ν * f_R ν) →
      Function.Injective
        (LinearMap.rTensor (Localization.AtPrime q_R.asIdeal)
          (Ideal.comap
            (algebraMap R (MvPolynomial (Fin m) R ⧸ Ideal.span (Set.range f_R)))
            q_R.asIdeal).subtype) := by
    intro R _ f_R q_R hSyz
    let P_R := MvPolynomial (Fin m) R
    let I_R : Ideal P_R := Ideal.span (Set.range f_R)
    let B_R := P_R ⧸ I_R
    let p_R : Ideal R := Ideal.comap (algebraMap R B_R) q_R.asIdeal
    obtain ⟨e_pR, _, he_lid_pR, he_symm_mulLeft_pR⟩ := hExistsMonomialEquiv p_R
    have : q_R.asIdeal.IsPrime := q_R.isPrime
    let M : Submonoid B_R := q_R.asIdeal.primeCompl
    let L_R := Localization.AtPrime q_R.asIdeal
    let μ_R := LinearMap.rTensor L_R p_R.subtype
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro z hz_ker
    change μ_R z = 0 at hz_ker
    let ρ : L_R → (L_R →ₗ[R] L_R) := fun ℓ =>
      { toFun := fun y => y * ℓ
        map_add' := fun y₁ y₂ => add_mul y₁ y₂ ℓ
        map_smul' := fun r y => by
          simp only [RingHom.id_apply, Algebra.smul_def, mul_assoc] }
    have hρ_comp : ∀ (ℓ₁ ℓ₂ : L_R) (v : TensorProduct R ↥p_R L_R),
        LinearMap.lTensor ↥p_R (ρ ℓ₂) (LinearMap.lTensor ↥p_R (ρ ℓ₁) v) =
          LinearMap.lTensor ↥p_R (ρ (ℓ₁ * ℓ₂)) v := by
      intro ℓ₁ ℓ₂ v
      rw [← LinearMap.comp_apply, ← LinearMap.lTensor_comp]
      have hEq : (ρ ℓ₂).comp (ρ ℓ₁) = ρ (ℓ₁ * ℓ₂) := by
        ext y
        exact mul_assoc y ℓ₁ ℓ₂
      rw [hEq]
    obtain ⟨J, hz_sum⟩ := TensorProduct.exists_finset z
    obtain ⟨s, hs⟩ := IsLocalization.exist_integer_multiples M J Prod.snd
    have hLiftNum : ∀ x : ↥J,
        ∃ Q : P_R,
          algebraMap B_R L_R (Ideal.Quotient.mk I_R Q) =
            x.1.2 * algebraMap B_R L_R (s : B_R) := by
      intro x
      obtain ⟨b, hb⟩ := hs x.1 x.2
      obtain ⟨Q, rfl⟩ := Ideal.Quotient.mk_surjective b
      refine ⟨Q, ?_⟩
      rw [hb, Algebra.smul_def, mul_comm]
    choose Q_num hQ_num using hLiftNum
    let φ_loc : P_R →ₗ[R] L_R :=
      ((IsScalarTower.toAlgHom R B_R L_R).comp (Ideal.Quotient.mkₐ R I_R)).toLinearMap
    have hφ_loc_apply : ∀ P : P_R, φ_loc P = algebraMap B_R L_R (Ideal.Quotient.mk I_R P) :=
      fun _ => rfl
    let z_tilde : TensorProduct R ↥p_R P_R := ∑ x ∈ J.attach, x.1.1 ⊗ₜ[R] Q_num x
    let s_L : L_R := algebraMap B_R L_R (s : B_R)
    have hz_tilde_map : LinearMap.lTensor ↥p_R φ_loc z_tilde =
        LinearMap.lTensor ↥p_R (ρ s_L) z := by
      simp only [z_tilde, map_sum, LinearMap.lTensor_tmul, hφ_loc_apply, hQ_num]
      rw [hz_sum, map_sum, ← Finset.sum_attach J (fun x => (LinearMap.lTensor ↥p_R (ρ s_L)) (x.1 ⊗ₜ[R] x.2))]
      rfl
    let y₀ : ↥(coeffSubmodule p_R) := e_pR z_tilde
    let P₀ : P_R := y₀.1
    have hP₀_coeff : ∀ α : Fin m →₀ ℕ, P₀.coeff α ∈ p_R := y₀.2
    have hz_tilde_symm : z_tilde = e_pR.symm ⟨P₀, hP₀_coeff⟩ :=
      (e_pR.symm_apply_apply z_tilde).symm
    have hφ_P₀_zero : φ_loc P₀ = 0 := by
      rw [← he_lid_pR φ_loc z_tilde, hz_tilde_map]
      have hComm : μ_R (LinearMap.lTensor ↥p_R (ρ s_L) z) =
          LinearMap.lTensor R (ρ s_L) (μ_R z) := by
        change (LinearMap.rTensor L_R p_R.subtype ∘ₗ LinearMap.lTensor ↥p_R (ρ s_L)) z =
          (LinearMap.lTensor R (ρ s_L) ∘ₗ LinearMap.rTensor L_R p_R.subtype) z
        rw [LinearMap.rTensor_comp_lTensor, LinearMap.lTensor_comp_rTensor]
      rw [hComm, hz_ker, map_zero, map_zero]
    obtain ⟨t₀, ht₀⟩ :=
      (IsLocalization.map_eq_zero_iff M L_R (Ideal.Quotient.mk I_R P₀)).mp hφ_P₀_zero
    obtain ⟨T₀, hT₀⟩ := Ideal.Quotient.mk_surjective (t₀ : B_R)
    have hTP₀_mem : T₀ * P₀ ∈ I_R := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, hT₀]
      exact ht₀
    have hTP₀_coeff : ∀ α : Fin m →₀ ℕ, (T₀ * P₀).coeff α ∈ p_R :=
      hMulMemCoeff p_R T₀ P₀ hP₀_coeff
    obtain ⟨c, w, hc_not_mem, hw_coeff, hc_eq⟩ := hSyz (T₀ * P₀) hTP₀_mem hTP₀_coeff
    have hc_eq_comm : c • (T₀ * P₀) = ∑ ν : Fin t, f_R ν * w ν := by
      rw [hc_eq]
      exact Finset.sum_congr rfl fun ν _ => mul_comm (w ν) (f_R ν)
    have hSubEq :
        (⟨c • (T₀ * P₀), (coeffSubmodule p_R).smul_mem c hTP₀_coeff⟩ : ↥(coeffSubmodule p_R)) =
        ∑ ν : Fin t, ⟨f_R ν * w ν, hMulMemCoeff p_R (f_R ν) (w ν) (hw_coeff ν)⟩ := by
      apply Subtype.ext
      rw [Submodule.coe_sum]
      exact hc_eq_comm
    have hTensorP_R :
        c • LinearMap.lTensor ↥p_R (LinearMap.mulLeft R T₀) z_tilde =
        ∑ ν : Fin t,
          LinearMap.lTensor ↥p_R (LinearMap.mulLeft R (f_R ν))
            (e_pR.symm ⟨w ν, hw_coeff ν⟩) := by
      have hApplySymm := congrArg e_pR.symm hSubEq
      have hLHS :
          e_pR.symm ⟨c • (T₀ * P₀), (coeffSubmodule p_R).smul_mem c hTP₀_coeff⟩ =
          c • LinearMap.lTensor ↥p_R (LinearMap.mulLeft R T₀) z_tilde := by
        have hSmul :
            (⟨c • (T₀ * P₀), (coeffSubmodule p_R).smul_mem c hTP₀_coeff⟩ : ↥(coeffSubmodule p_R)) =
            c • ⟨T₀ * P₀, hTP₀_coeff⟩ := rfl
        rw [hSmul, map_smul, hz_tilde_symm, he_symm_mulLeft_pR]
      rw [← hLHS, hApplySymm, map_sum]
      refine Finset.sum_congr rfl fun ν _ => (he_symm_mulLeft_pR (f_R ν) ⟨w ν, hw_coeff ν⟩).symm
    have hKillRHS :
        LinearMap.lTensor ↥p_R φ_loc
          (∑ ν : Fin t,
            LinearMap.lTensor ↥p_R (LinearMap.mulLeft R (f_R ν))
              (e_pR.symm ⟨w ν, hw_coeff ν⟩)) = 0 := by
      rw [map_sum]
      refine Finset.sum_eq_zero fun ν _ => ?_
      rw [← LinearMap.comp_apply, ← LinearMap.lTensor_comp]
      have hZeroComp : φ_loc.comp (LinearMap.mulLeft R (f_R ν)) = 0 := by
        apply LinearMap.ext
        intro P
        simp only [LinearMap.comp_apply, LinearMap.mulLeft_apply, LinearMap.zero_apply,
          hφ_loc_apply, map_mul]
        have hf_zero : Ideal.Quotient.mk I_R (f_R ν) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨ν, rfl⟩)
        rw [hf_zero, map_zero, zero_mul]
      rw [hZeroComp, LinearMap.lTensor_zero, LinearMap.zero_apply]
    let t₀_L : L_R := algebraMap B_R L_R (t₀ : B_R)
    have hT₀_map :
        LinearMap.lTensor ↥p_R φ_loc
          (LinearMap.lTensor ↥p_R (LinearMap.mulLeft R T₀) z_tilde) =
        LinearMap.lTensor ↥p_R (ρ (s_L * t₀_L)) z := by
      rw [← LinearMap.comp_apply, ← LinearMap.lTensor_comp]
      have hCompT₀ : φ_loc.comp (LinearMap.mulLeft R T₀) = (ρ t₀_L).comp φ_loc := by
        ext P
        simp only [LinearMap.comp_apply, LinearMap.mulLeft_apply, hφ_loc_apply, map_mul, hT₀]
        exact mul_comm _ _
      rw [hCompT₀, LinearMap.lTensor_comp, LinearMap.comp_apply, hz_tilde_map, hρ_comp]
    let s_c : ↥M := ⟨algebraMap R B_R c, hc_not_mem⟩
    let c_L : L_R := algebraMap B_R L_R (s_c : B_R)
    have hc_smul : ∀ v : TensorProduct R ↥p_R L_R,
        c • v = LinearMap.lTensor ↥p_R (ρ c_L) v := by
      intro v
      have hEqSmul : LinearMap.lsmul R (TensorProduct R ↥p_R L_R) c =
          LinearMap.lTensor ↥p_R (ρ c_L) := by
        apply TensorProduct.ext'
        intro x y
        change c • (x ⊗ₜ[R] y) = x ⊗ₜ[R] (y * c_L)
        have hSmulTensor : c • (x ⊗ₜ[R] y) = (c • x) ⊗ₜ[R] y := rfl
        rw [hSmulTensor, TensorProduct.smul_tmul, Algebra.smul_def, mul_comm,
          IsScalarTower.algebraMap_apply R B_R L_R c]
      exact LinearMap.congr_fun hEqSmul v
    have hUnitKill :
        LinearMap.lTensor ↥p_R (ρ (algebraMap B_R L_R ((s * t₀ * s_c : ↥M) : B_R))) z = 0 := by
      have hApply := congrArg (LinearMap.lTensor ↥p_R φ_loc) hTensorP_R
      rw [hKillRHS, LinearMap.map_smul, hT₀_map, hc_smul, hρ_comp] at hApply
      have hProd : s_L * t₀_L * c_L = algebraMap B_R L_R ((s * t₀ * s_c : ↥M) : B_R) := by
        simp only [s_L, t₀_L, c_L, Submonoid.coe_mul, map_mul]
      rwa [← hProd]
    have hu_tot : IsUnit (algebraMap B_R L_R ((s * t₀ * s_c : ↥M) : B_R)) :=
      IsLocalization.map_units L_R (s * t₀ * s_c)
    have hz_recover := congrArg (LinearMap.lTensor ↥p_R (ρ ↑hu_tot.unit⁻¹)) hUnitKill
    rw [map_zero, hρ_comp, IsUnit.mul_val_inv] at hz_recover
    have hρ_one : ρ 1 = LinearMap.id := by
      ext y
      exact mul_one y
    rw [hρ_one, LinearMap.lTensor_id, LinearMap.id_apply] at hz_recover
    exact hz_recover

  
  
  
  let P_V := MvPolynomial (Fin m) V₀
  let f_V : Fin t → P_V := fun ν => MvPolynomial.map ι₁ (f ν)
  let I_V : Ideal P_V := Ideal.span (Set.range f_V)
  let B_V := P_V ⧸ I_V
  have : q_V.asIdeal.IsPrime := q_V.isPrime
  let p_V : Ideal V₀ := Ideal.comap (algebraMap V₀ B_V) q_V.asIdeal
  have : p_V.IsPrime := q_V.isPrime.comap (algebraMap V₀ B_V)
  let D₀ := V₀ ⧸ p_V
  have : IsDomain D₀ := Ideal.Quotient.isDomain p_V
  let π_V₀ : V₀ →+* D₀ := Ideal.Quotient.mk p_V
  let f₀ : Fin t → MvPolynomial (Fin m) D₀ :=
    fun ν => MvPolynomial.map (π_V₀.comp ι₁) (f ν)

  obtain ⟨N, s₀, hs₀_syz, hDescent⟩ := hDomainSyzygyDescent D₀ f₀

  have hLift_s₀ : ∀ (μ : Fin N) (ν : Fin t),
      ∃ P : P_V, MvPolynomial.map π_V₀ P = s₀ μ ν :=
    fun μ ν => MvPolynomial.map_surjective π_V₀ Ideal.Quotient.mk_surjective (s₀ μ ν)
  choose s_tilde hs_tilde using hLift_s₀

  have hDecomp_μ : ∀ μ : Fin N,
      ∃ p_wit : Fin t → P_V,
        (∀ (ν : Fin t) (α : Fin m →₀ ℕ), (p_wit ν).coeff α ∈ p_V) ∧
        (∑ ν : Fin t, s_tilde μ ν * f_V ν) = ∑ ν : Fin t, p_wit ν * f_V ν := by
    intro μ
    let G_μ : P_V := ∑ ν : Fin t, s_tilde μ ν * f_V ν
    have hG_mem : G_μ ∈ I_V :=
      Ideal.sum_mem I_V fun ν _ => Ideal.mul_mem_left I_V _ (Ideal.subset_span ⟨ν, rfl⟩)
    have hG_map_zero : MvPolynomial.map π_V₀ G_μ = 0 := by
      calc
        MvPolynomial.map π_V₀ G_μ
          = ∑ ν : Fin t, MvPolynomial.map π_V₀ (s_tilde μ ν) * MvPolynomial.map π_V₀ (f_V ν) := by
              simp only [G_μ, map_sum, map_mul]
        _ = ∑ ν : Fin t, s₀ μ ν * f₀ ν := by
              refine Finset.sum_congr rfl fun ν _ => ?_
              rw [hs_tilde μ ν, MvPolynomial.map_map]
        _ = 0 := hs₀_syz μ
    have hG_coeff : ∀ α : Fin m →₀ ℕ, G_μ.coeff α ∈ p_V := by
      intro α
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change π_V₀ (G_μ.coeff α) = 0
      rw [← MvPolynomial.coeff_map, hG_map_zero]
      rfl
    exact hFlatCoeffDecomp V₀ p_V f_V hFlatV G_μ hG_mem hG_coeff
  choose p_V_wit hp_V_coeff hp_V_eq using hDecomp_μ

  let _ : DecidableEq V₀ := Classical.decEq V₀
  let polyCoeffs : P_V → Finset V₀ := fun P => P.support.image P.coeff
  let S : Finset V₀ :=
    Finset.univ.biUnion (fun μ : Fin N =>
      Finset.univ.biUnion (fun ν : Fin t =>
        polyCoeffs (s_tilde μ ν) ∪ polyCoeffs (p_V_wit μ ν)))

  refine ⟨S, ?_⟩
  intro R _ inc ι hComp hInj hSub I_R
  let P_R := MvPolynomial (Fin m) R
  let f_R : Fin t → P_R := fun ν => MvPolynomial.map inc (f ν)
  let B_R := P_R ⧸ I_R

  have hMapIR : ∀ P ∈ I_R, ((Ideal.Quotient.mk I_V).comp (MvPolynomial.map ι)) P = 0 := by
    intro P hP
    change Ideal.Quotient.mk I_V (MvPolynomial.map ι P) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    obtain ⟨c_rel, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hP
    simp only [map_sum, map_mul, MvPolynomial.map_map, hComp]
    exact Ideal.sum_mem I_V fun ν _ => Ideal.mul_mem_left I_V _ (Ideal.subset_span ⟨ν, rfl⟩)

  let ψ_RV : B_R →+* B_V :=
    Ideal.Quotient.lift I_R ((Ideal.Quotient.mk I_V).comp (MvPolynomial.map ι)) hMapIR
  let q_R : PrimeSpectrum B_R := PrimeSpectrum.comap ψ_RV q_V

  refine ⟨q_R, fun P => Iff.rfl, ?_⟩

  let p_R : Ideal R := Ideal.comap (algebraMap R B_R) q_R.asIdeal
  have hp_R_eq_comap : p_R = Ideal.comap ι p_V := by
    ext r
    change Ideal.Quotient.mk I_R (MvPolynomial.C r) ∈ q_R.asIdeal ↔
      Ideal.Quotient.mk I_V (MvPolynomial.C (ι r)) ∈ q_V.asIdeal
    change Ideal.Quotient.mk I_V (MvPolynomial.map ι (MvPolynomial.C r)) ∈ q_V.asIdeal ↔ _
    rw [MvPolynomial.map_C]

  have : q_R.asIdeal.IsPrime := q_R.isPrime
  have : p_R.IsPrime := q_R.isPrime.comap (algebraMap R B_R)
  let D := R ⧸ p_R
  have : IsDomain D := Ideal.Quotient.isDomain p_R
  let π_R : R →+* D := Ideal.Quotient.mk p_R
  let j : D →+* D₀ := Ideal.quotientMap p_V ι (le_of_eq hp_R_eq_comap)
  have hj : Function.Injective j :=
    Ideal.quotientMap_injective' (le_of_eq hp_R_eq_comap.symm)
  have hj_comp : j.comp π_R = π_V₀.comp ι := RingHom.ext fun _ => rfl

  have hLiftPolyRange : ∀ P : P_V,
      polyCoeffs P ⊆ S →
      ∃ P_lift : P_R, MvPolynomial.map ι P_lift = P := by
    intro P hSubP
    have hCoeffInRange : ∀ α : ↥P.support, ∃ r : R, ι r = P.coeff α.1 := by
      intro α
      exact hSub (Finset.mem_coe.mpr (hSubP (Finset.mem_image_of_mem P.coeff α.2)))
    choose c_lift hc_lift using hCoeffInRange
    let P_lift : P_R := ∑ α ∈ P.support.attach, MvPolynomial.monomial α.1 (c_lift α)
    refine ⟨P_lift, ?_⟩
    simp only [P_lift, map_sum, MvPolynomial.map_monomial, hc_lift]
    rw [Finset.sum_attach P.support (fun α => MvPolynomial.monomial α (P.coeff α))]
    exact (MvPolynomial.as_sum P).symm

  have hs_sub : ∀ (μ : Fin N) (ν : Fin t), polyCoeffs (s_tilde μ ν) ⊆ S := by
    intro μ ν v hv
    exact Finset.mem_biUnion.mpr ⟨μ, Finset.mem_univ μ,
      Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν, Finset.mem_union_left _ hv⟩⟩
  have hp_sub : ∀ (μ : Fin N) (ν : Fin t), polyCoeffs (p_V_wit μ ν) ⊆ S := by
    intro μ ν v hv
    exact Finset.mem_biUnion.mpr ⟨μ, Finset.mem_univ μ,
      Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν, Finset.mem_union_right _ hv⟩⟩

  choose s_tilde_R hs_tilde_R using fun (μ : Fin N) (ν : Fin t) =>
    hLiftPolyRange (s_tilde μ ν) (hs_sub μ ν)
  choose p_R_wit hp_R_wit using fun (μ : Fin N) (ν : Fin t) =>
    hLiftPolyRange (p_V_wit μ ν) (hp_sub μ ν)

  have hp_R_coeff : ∀ (μ : Fin N) (ν : Fin t) (α : Fin m →₀ ℕ),
      (p_R_wit μ ν).coeff α ∈ p_R := by
    intro μ ν α
    rw [hp_R_eq_comap, Ideal.mem_comap, ← MvPolynomial.coeff_map, hp_R_wit μ ν]
    exact hp_V_coeff μ ν α

  have hp_R_eq : ∀ μ : Fin N,
      (∑ ν : Fin t, s_tilde_R μ ν * f_R ν) = ∑ ν : Fin t, p_R_wit μ ν * f_R ν := by
    intro μ
    apply MvPolynomial.map_injective ι hInj
    simp only [map_sum, map_mul, hs_tilde_R, hp_R_wit, f_R, MvPolynomial.map_map, hComp]
    exact hp_V_eq μ

  refine hAtPrimeRTensorInj R f_R q_R ?_
  intro G hG_mem hG_coeff
  obtain ⟨g, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hG_mem
  let f_D : Fin t → MvPolynomial (Fin m) D := fun ν => MvPolynomial.map π_R (f_R ν)
  let s_D : Fin N → Fin t → MvPolynomial (Fin m) D :=
    fun μ ν => MvPolynomial.map π_R (s_tilde_R μ ν)
  let g_D : Fin t → MvPolynomial (Fin m) D := fun ν => MvPolynomial.map π_R (g ν)

  have hf_D : ∀ ν : Fin t, MvPolynomial.map j (f_D ν) = f₀ ν := by
    intro ν
    simp only [f_D, f_R, f₀, MvPolynomial.map_map]
    rw [← RingHom.comp_assoc, hj_comp, RingHom.comp_assoc, hComp]

  have hs_D : ∀ (μ : Fin N) (ν : Fin t), MvPolynomial.map j (s_D μ ν) = s₀ μ ν := by
    intro μ ν
    rw [MvPolynomial.map_map, hj_comp, ← MvPolynomial.map_map, hs_tilde_R μ ν, hs_tilde μ ν]

  have hg_D : ∑ ν : Fin t, g_D ν * f_D ν = 0 := by
    have hMapEq :
        (∑ ν : Fin t, g_D ν * f_D ν) =
        MvPolynomial.map π_R (∑ ν : Fin t, g ν * f_R ν) := by
      simp only [g_D, f_D, map_sum, map_mul]
    rw [hMapEq]
    ext α
    rw [MvPolynomial.coeff_map]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hG_coeff α)

  obtain ⟨c_D, q_D, hc_D_ne, hq_D_eq⟩ := hDescent D j hj f_D s_D hf_D hs_D g_D hg_D
  obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective c_D
  have hc_not_mem : c ∉ p_R := fun hc => hc_D_ne (Ideal.Quotient.eq_zero_iff_mem.mpr hc)

  have hLift_qD : ∀ μ : Fin N, ∃ Q : P_R, MvPolynomial.map π_R Q = q_D μ :=
    fun μ => MvPolynomial.map_surjective π_R Ideal.Quotient.mk_surjective (q_D μ)
  choose q_lift hq_lift using hLift_qD

  let u : Fin t → P_R := fun ν => c • g ν - ∑ μ : Fin N, q_lift μ * s_tilde_R μ ν
  have hu_coeff : ∀ (ν : Fin t) (α : Fin m →₀ ℕ), (u ν).coeff α ∈ p_R := by
    intro ν α
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    change π_R ((u ν).coeff α) = 0
    rw [← MvPolynomial.coeff_map]
    have hMapU : MvPolynomial.map π_R (u ν) = 0 := by
      have hc_map : MvPolynomial.map π_R (c • g ν) = π_R c • g_D ν := by
        rw [MvPolynomial.smul_eq_C_mul, map_mul, MvPolynomial.map_C,
          ← MvPolynomial.smul_eq_C_mul]
      simp only [u, map_sub, hc_map, map_sum, map_mul, hq_lift]
      exact sub_eq_zero.mpr (hq_D_eq ν)
    rw [hMapU]
    rfl

  let w : Fin t → P_R := fun ν => u ν + ∑ μ : Fin N, q_lift μ * p_R_wit μ ν
  refine ⟨c, w, hc_not_mem, ?_, ?_⟩
  · intro ν α
    have hSumMem : (∑ μ : Fin N, q_lift μ * p_R_wit μ ν) ∈ coeffSubmodule p_R :=
      Submodule.sum_mem (coeffSubmodule p_R) fun μ _ =>
        hMulMemCoeff p_R (q_lift μ) (p_R_wit μ ν) (hp_R_coeff μ ν)
    exact (coeffSubmodule p_R).add_mem (hu_coeff ν) hSumMem α
  · have hCancel :
        ∑ ν : Fin t, w ν * f_R ν = ∑ ν : Fin t, (c • g ν) * f_R ν := by
      have hExpand :
          ∑ ν : Fin t, w ν * f_R ν =
            (∑ ν : Fin t, (c • g ν) * f_R ν) -
              (∑ ν : Fin t, (∑ μ : Fin N, q_lift μ * s_tilde_R μ ν) * f_R ν) +
              (∑ ν : Fin t, (∑ μ : Fin N, q_lift μ * p_R_wit μ ν) * f_R ν) := by
        simp only [w, u, add_mul, sub_mul, Finset.sum_add_distrib, Finset.sum_sub_distrib]
      have hSwap1 :
          (∑ ν : Fin t, (∑ μ : Fin N, q_lift μ * s_tilde_R μ ν) * f_R ν) =
            ∑ μ : Fin N, q_lift μ * (∑ ν : Fin t, s_tilde_R μ ν * f_R ν) := by
        calc
          (∑ ν : Fin t, (∑ μ : Fin N, q_lift μ * s_tilde_R μ ν) * f_R ν)
            = ∑ ν : Fin t, ∑ μ : Fin N, q_lift μ * (s_tilde_R μ ν * f_R ν) := by
                refine Finset.sum_congr rfl fun ν _ => ?_
                rw [Finset.sum_mul]
                refine Finset.sum_congr rfl fun μ _ => mul_assoc _ _ _
          _ = ∑ μ : Fin N, q_lift μ * (∑ ν : Fin t, s_tilde_R μ ν * f_R ν) := by
                rw [Finset.sum_comm]
                refine Finset.sum_congr rfl fun μ _ => (Finset.mul_sum _ _ _).symm
      have hSwap2 :
          (∑ ν : Fin t, (∑ μ : Fin N, q_lift μ * p_R_wit μ ν) * f_R ν) =
            ∑ μ : Fin N, q_lift μ * (∑ ν : Fin t, p_R_wit μ ν * f_R ν) := by
        calc
          (∑ ν : Fin t, (∑ μ : Fin N, q_lift μ * p_R_wit μ ν) * f_R ν)
            = ∑ ν : Fin t, ∑ μ : Fin N, q_lift μ * (p_R_wit μ ν * f_R ν) := by
                refine Finset.sum_congr rfl fun ν _ => ?_
                rw [Finset.sum_mul]
                refine Finset.sum_congr rfl fun μ _ => mul_assoc _ _ _
          _ = ∑ μ : Fin N, q_lift μ * (∑ ν : Fin t, p_R_wit μ ν * f_R ν) := by
                rw [Finset.sum_comm]
                refine Finset.sum_congr rfl fun μ _ => (Finset.mul_sum _ _ _).symm
      have hEqSums :
          (∑ μ : Fin N, q_lift μ * (∑ ν : Fin t, s_tilde_R μ ν * f_R ν)) =
            ∑ μ : Fin N, q_lift μ * (∑ ν : Fin t, p_R_wit μ ν * f_R ν) :=
        Finset.sum_congr rfl fun μ _ => by rw [hp_R_eq μ]
      rw [hExpand, hSwap1, hSwap2, hEqSums, sub_add_cancel]
    rw [hCancel, Finset.smul_sum]
    refine Finset.sum_congr rfl fun ν _ => (smul_mul_assoc c (g ν) (f_R ν)).symm

theorem weil_noetherian_local_flat_and_open_locus (R B : Type u) [CommRing R] [IsNoetherianRing R]
    [CommRing B] [Algebra R B] [Algebra.FiniteType R B] :
    (∀ (q : PrimeSpectrum B),
      Module.Flat R (Localization.AtPrime q.asIdeal) ↔
        Function.Injective
          (LinearMap.rTensor (Localization.AtPrime q.asIdeal)
            (Ideal.comap (algebraMap R B) q.asIdeal).subtype)) ∧
    ((∀ (p : Ideal R) [p.IsPrime],
        ∃ a : R, a ∉ p ∧
          Module.Flat (Localization.Away (Ideal.Quotient.mk p a))
            (LocalizedModule (Submonoid.powers (Ideal.Quotient.mk p a))
              (B ⧸ Ideal.map (algebraMap R B) p))) →
      ∀ (q : PrimeSpectrum B),
        Module.Flat R (Localization.AtPrime q.asIdeal) →
        ∃ b : B, b ∉ q.asIdeal ∧ Module.Flat R (Localization.Away b)) :=
by
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing R B

  
  have hLocalCrit :
      ∀ (A C : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
        [CommRing C] [IsLocalRing C] [IsNoetherianRing C]
        [Algebra A C] [IsLocalHom (algebraMap A C)],
        Function.Injective (LinearMap.rTensor C (IsLocalRing.maximalIdeal A).subtype) →
        Module.Flat A C := by
    intro A C _ _ _ _ _ _ _ _ hInjMax
    let 𝔪 := IsLocalRing.maximalIdeal A
    let 𝔫 := IsLocalRing.maximalIdeal C
    have hPrimary : ∀ (J : Ideal A), (∃ k : ℕ, 𝔪 ^ k ≤ J) →
        Function.Injective (LinearMap.rTensor C J.subtype) := by
      intro J
      refine @WellFounded.induction (Ideal A) _ (wellFounded_gt (α := Ideal A))
        (fun J => (∃ k : ℕ, 𝔪 ^ k ≤ J) → Function.Injective (LinearMap.rTensor C J.subtype)) J ?_
      intro J ih ⟨k, hk⟩
      by_cases hJtop : J = ⊤
      · subst hJtop
        let g_top : A →ₗ[A] ↥(⊤ : Ideal A) :=
          { toFun := fun a => ⟨a, trivial⟩
            map_add' := fun _ _ => rfl
            map_smul' := fun _ _ => rfl }
        have hcomp_top : g_top ∘ₗ (⊤ : Ideal A).subtype = LinearMap.id := by
          ext x; rfl
        rw [injective_iff_map_eq_zero]
        intro w hw
        calc w
          _ = LinearMap.rTensor C (LinearMap.id : ↥(⊤ : Ideal A) →ₗ[A] ↥(⊤ : Ideal A)) w := by
            rw [LinearMap.rTensor_id]; rfl
          _ = LinearMap.rTensor C g_top (LinearMap.rTensor C (⊤ : Ideal A).subtype w) := by
            rw [← hcomp_top, LinearMap.rTensor_comp]; rfl
          _ = 0 := by rw [hw, map_zero]
      · have hSocle : ∀ (m : ℕ), 𝔪 ^ m ≤ J → ∃ x : A, x ∉ J ∧ ∀ y ∈ 𝔪, y * x ∈ J := by
          intro m
          induction m with
          | zero =>
            intro hm0
            exfalso
            apply hJtop
            rw [pow_zero, Ideal.one_eq_top] at hm0
            exact top_unique hm0
          | succ m ihm =>
            intro hm_succ
            by_cases hm_le : 𝔪 ^ m ≤ J
            · exact ihm hm_le
            · obtain ⟨x, hx_pow, hx_notJ⟩ := SetLike.not_le_iff_exists.mp hm_le
              refine ⟨x, hx_notJ, fun y hy => hm_succ ?_⟩
              rw [pow_succ']
              exact Ideal.mul_mem_mul hy hx_pow
        obtain ⟨x, hx_notJ, hmx⟩ := hSocle k hk
        have hColon : ∀ a : A, a * x ∈ J ↔ a ∈ 𝔪 := by
          intro a
          constructor
          · intro hax
            by_contra ha_not
            obtain ⟨u, rfl⟩ := IsLocalRing.notMem_maximalIdeal.mp ha_not
            apply hx_notJ
            have hux : (↑u⁻¹ : A) * ((↑u : A) * x) = x := Units.inv_mul_cancel_left u x
            rw [← hux]
            exact Ideal.mul_mem_left J (↑u⁻¹ : A) hax
          · exact fun ha => hmx a ha
        let J' : Ideal A := J ⊔ Ideal.span {x}
        have hJlt : J < J' := by
          refine lt_of_le_of_ne le_sup_left ?_
          intro hEq
          apply hx_notJ
          rw [hEq]
          exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self x)
        have hInjJ' : Function.Injective (LinearMap.rTensor C J'.subtype) :=
          ih J' hJlt ⟨k, hk.trans le_sup_left⟩
        let α : ↥𝔪 →ₗ[A] ↥J × A :=
          { toFun := fun m => (⟨-(m.1 * x), J.neg_mem (hmx m.1 m.2)⟩, m.1)
            map_add' := fun m₁ m₂ => by
              refine Prod.ext ?_ rfl
              ext; dsimp; ring
            map_smul' := fun r m => by
              refine Prod.ext ?_ rfl
              ext; dsimp; ring }
        let β : ↥J × A →ₗ[A] ↥J' :=
          { toFun := fun p => ⟨p.1.1 + p.2 * x,
              Submodule.add_mem_sup p.1.2 (Ideal.mem_span_singleton.mpr ⟨p.2, mul_comm p.2 x⟩)⟩
            map_add' := fun p₁ p₂ => by ext; dsimp; ring
            map_smul' := fun r p => by ext; dsimp; ring }
        have hSurjβ : Function.Surjective β := by
          intro y
          obtain ⟨j₀, hj₀, z₀, hz₀, hy_eq⟩ := Submodule.mem_sup.mp y.2
          obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hz₀
          refine ⟨(⟨j₀, hj₀⟩, a), ?_⟩
          ext
          dsimp [β]
          rw [mul_comm a x, hy_eq]
        have hExαβ : Function.Exact α β := by
          intro p
          constructor
          · intro hp0
            have hsum : p.1.1 + p.2 * x = 0 := congrArg Subtype.val hp0
            have hax : p.2 * x = -p.1.1 := eq_neg_of_add_eq_zero_right hsum
            have ha_mem : p.2 ∈ 𝔪 := (hColon p.2).mp (hax ▸ J.neg_mem p.1.2)
            refine ⟨⟨p.2, ha_mem⟩, ?_⟩
            ext
            · dsimp [α]; rw [hax, neg_neg]
            · rfl
          · rintro ⟨m, rfl⟩
            ext; dsimp [α, β]; ring
        let ι₁ := LinearMap.inl A ↥J A
        let π₁ := LinearMap.fst A ↥J A
        let π₂ := LinearMap.snd A ↥J A
        have hc1 : π₁ ∘ₗ ι₁ = LinearMap.id := by ext; rfl
        have hc2 : π₂ ∘ₗ ι₁ = 0 := by ext; rfl
        have hc3 : π₂ ∘ₗ α = 𝔪.subtype := by ext; rfl
        have hc4 : (J'.subtype ∘ₗ β) ∘ₗ ι₁ = J.subtype := by
          ext j; dsimp [β, ι₁]; ring
        have hr0 : LinearMap.rTensor C (0 : ↥J →ₗ[A] A) = 0 := by
          ext j c; simp
        rw [injective_iff_map_eq_zero]
        intro w hw
        have hβ0 : LinearMap.rTensor C β (LinearMap.rTensor C ι₁ w) = 0 := by
          apply hInjJ'
          rw [map_zero]
          have h1 : LinearMap.rTensor C J'.subtype (LinearMap.rTensor C β (LinearMap.rTensor C ι₁ w)) =
              LinearMap.rTensor C ((J'.subtype ∘ₗ β) ∘ₗ ι₁) w := by
            simp only [LinearMap.rTensor_comp, LinearMap.comp_apply]
          rw [h1, hc4, hw]
        obtain ⟨u, hu⟩ := (rTensor_exact C hExαβ hSurjβ (LinearMap.rTensor C ι₁ w)).mp hβ0
        have hu0 : u = 0 := by
          apply hInjMax
          rw [map_zero]
          calc LinearMap.rTensor C 𝔪.subtype u
            _ = LinearMap.rTensor C (π₂ ∘ₗ α) u := by rw [hc3]
            _ = LinearMap.rTensor C π₂ (LinearMap.rTensor C α u) := by
              rw [LinearMap.rTensor_comp, LinearMap.comp_apply]
            _ = LinearMap.rTensor C π₂ (LinearMap.rTensor C ι₁ w) := by rw [hu]
            _ = LinearMap.rTensor C (π₂ ∘ₗ ι₁) w := by
              rw [LinearMap.rTensor_comp, LinearMap.comp_apply]
            _ = 0 := by rw [hc2, hr0, LinearMap.zero_apply]
        have hιw0 : LinearMap.rTensor C ι₁ w = 0 := by
          rw [← hu, hu0, map_zero]
        calc w
          _ = LinearMap.rTensor C (LinearMap.id : ↥J →ₗ[A] ↥J) w := by rw [LinearMap.rTensor_id]; rfl
          _ = LinearMap.rTensor C (π₁ ∘ₗ ι₁) w := by rw [hc1]
          _ = LinearMap.rTensor C π₁ (LinearMap.rTensor C ι₁ w) := by
            rw [LinearMap.rTensor_comp, LinearMap.comp_apply]
          _ = 0 := by rw [hιw0, map_zero]
    rw [Module.Flat.iff_rTensor_injective']
    intro I
    rw [← LinearMap.lTensor_inj_iff_rTensor_inj C I.subtype, injective_iff_map_eq_zero]
    intro z hz
    have hFactor : ∀ k : ℕ, ∃ v : TensorProduct A C ↥(I ⊓ 𝔪 ^ k),
        LinearMap.lTensor C (Submodule.inclusion (inf_le_left : I ⊓ 𝔪 ^ k ≤ I)) v = z := by
      intro k
      let γ : ↥(I ⊓ 𝔪 ^ k) →ₗ[A] ↥I × ↥(𝔪 ^ k) :=
        { toFun := fun y => (⟨y.1, y.2.1⟩, ⟨-y.1, (𝔪 ^ k).neg_mem y.2.2⟩)
          map_add' := fun y₁ y₂ => by
            refine Prod.ext rfl ?_
            ext; dsimp; ring
          map_smul' := fun r y => by
            refine Prod.ext rfl ?_
            ext; dsimp; ring }
      let δ : ↥I × ↥(𝔪 ^ k) →ₗ[A] ↥(I ⊔ 𝔪 ^ k) :=
        { toFun := fun p => ⟨p.1.1 + p.2.1, Submodule.add_mem_sup p.1.2 p.2.2⟩
          map_add' := fun p₁ p₂ => by ext; dsimp; ring
          map_smul' := fun r p => by ext; dsimp; ring }
      have hSurjδ : Function.Surjective δ := by
        intro y
        obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp y.2
        refine ⟨(⟨a, ha⟩, ⟨b, hb⟩), ?_⟩
        ext; exact hab
      have hExγδ : Function.Exact γ δ := by
        intro p
        constructor
        · intro hp0
          have hsum : p.2.1 + p.1.1 = 0 := by
            rw [add_comm]
            exact congrArg Subtype.val hp0
          have hb_eq : p.2.1 = -p.1.1 := eq_neg_of_add_eq_zero_left hsum
          have ha_mk : p.1.1 ∈ 𝔪 ^ k := by
            have hneg := (𝔪 ^ k).neg_mem p.2.2
            rwa [hb_eq, neg_neg] at hneg
          refine ⟨⟨p.1.1, p.1.2, ha_mk⟩, ?_⟩
          ext
          · rfl
          · dsimp [γ]; exact hb_eq.symm
        · rintro ⟨y, rfl⟩
          ext; dsimp [γ, δ]; ring
      let ι_I := LinearMap.inl A ↥I ↥(𝔪 ^ k)
      let π_I := LinearMap.fst A ↥I ↥(𝔪 ^ k)
      have hc_sub : ((I ⊔ 𝔪 ^ k).subtype ∘ₗ δ) ∘ₗ ι_I = I.subtype := by
        ext a; dsimp [δ, ι_I]; ring
      have hc_inc : π_I ∘ₗ γ = Submodule.inclusion (inf_le_left : I ⊓ 𝔪 ^ k ≤ I) := by
        ext y; rfl
      have hInjSup : Function.Injective (LinearMap.lTensor C (I ⊔ 𝔪 ^ k).subtype) :=
        (LinearMap.lTensor_inj_iff_rTensor_inj C (I ⊔ 𝔪 ^ k).subtype).mpr
          (hPrimary (I ⊔ 𝔪 ^ k) ⟨k, le_sup_right⟩)
      have hδ0 : LinearMap.lTensor C δ (LinearMap.lTensor C ι_I z) = 0 := by
        apply hInjSup
        rw [map_zero]
        have h1 : LinearMap.lTensor C (I ⊔ 𝔪 ^ k).subtype
            (LinearMap.lTensor C δ (LinearMap.lTensor C ι_I z)) =
            LinearMap.lTensor C (((I ⊔ 𝔪 ^ k).subtype ∘ₗ δ) ∘ₗ ι_I) z := by
          simp only [LinearMap.lTensor_comp, LinearMap.comp_apply]
        rw [h1, hc_sub, hz]
      obtain ⟨v, hv⟩ := (lTensor_exact C hExγδ hSurjδ (LinearMap.lTensor C ι_I z)).mp hδ0
      refine ⟨v, ?_⟩
      calc LinearMap.lTensor C (Submodule.inclusion (inf_le_left : I ⊓ 𝔪 ^ k ≤ I)) v
        _ = LinearMap.lTensor C (π_I ∘ₗ γ) v := by rw [hc_inc]
        _ = LinearMap.lTensor C π_I (LinearMap.lTensor C γ v) := by
          rw [LinearMap.lTensor_comp, LinearMap.comp_apply]
        _ = LinearMap.lTensor C π_I (LinearMap.lTensor C ι_I z) := by rw [hv]
        _ = LinearMap.lTensor C (π_I ∘ₗ ι_I) z := by
          rw [LinearMap.lTensor_comp, LinearMap.comp_apply]
        _ = z := by
          have hid : π_I ∘ₗ ι_I = LinearMap.id := by ext; rfl
          rw [hid, LinearMap.lTensor_id]; rfl
    obtain ⟨k₀, hk₀⟩ := Ideal.exists_pow_inf_eq_pow_smul (M := A) 𝔪 I
    have hMapMax : Ideal.map (algebraMap A C) 𝔪 ≤ 𝔫 := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      by_contra ha_not
      have huC : IsUnit (algebraMap A C a) := IsLocalRing.notMem_maximalIdeal.mp ha_not
      have huA : IsUnit a := IsLocalHom.map_nonunit a huC
      exact (IsLocalRing.notMem_maximalIdeal.mpr huA) ha
    have hMemPow : z ∈ ⨅ n : ℕ, (𝔫 ^ n) • (⊤ : Submodule C (TensorProduct A C ↥I)) := by
      rw [Submodule.mem_iInf]
      intro n
      let S_n : Submodule C (TensorProduct A C ↥I) := (𝔫 ^ n) • ⊤
      let L_n : Ideal A :=
        { carrier := { x : A | ∃ hx : x ∈ I, ∀ c : C, (c ⊗ₜ[A] (⟨x, hx⟩ : ↥I)) ∈ S_n }
          zero_mem' := ⟨I.zero_mem, fun c => by
            have h0 : (⟨0, I.zero_mem⟩ : ↥I) = 0 := rfl
            rw [h0, TensorProduct.tmul_zero]
            exact S_n.zero_mem⟩
          add_mem' := by
            rintro x y ⟨hx, hcx⟩ ⟨hy, hcy⟩
            refine ⟨I.add_mem hx hy, fun c => ?_⟩
            have hadd : (⟨x + y, I.add_mem hx hy⟩ : ↥I) = ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
            rw [hadd, TensorProduct.tmul_add]
            exact S_n.add_mem (hcx c) (hcy c)
          smul_mem' := by
            rintro r x ⟨hx, hcx⟩
            refine ⟨I.mul_mem_left r hx, fun c => ?_⟩
            have hsmul : (⟨r • x, I.mul_mem_left r hx⟩ : ↥I) = r • ⟨x, hx⟩ := rfl
            rw [hsmul, ← TensorProduct.smul_tmul]
            exact hcx (r • c) }
      have hSmulLe : (𝔪 ^ n) • I ≤ L_n := by
        rw [Submodule.smul_le]
        intro a ha b hb
        refine ⟨I.mul_mem_left a hb, fun c => ?_⟩
        have hab : (⟨a • b, I.mul_mem_left a hb⟩ : ↥I) = a • (⟨b, hb⟩ : ↥I) := rfl
        have haC : algebraMap A C a ∈ 𝔫 ^ n := by
          have h1 : algebraMap A C a ∈ Ideal.map (algebraMap A C) (𝔪 ^ n) :=
            Ideal.mem_map_of_mem (algebraMap A C) ha
          rw [Ideal.map_pow] at h1
          exact Ideal.pow_right_mono hMapMax n h1
        rw [hab, ← TensorProduct.smul_tmul, Algebra.smul_def]
        change ((algebraMap A C a) • c) ⊗ₜ[A] (⟨b, hb⟩ : ↥I) ∈ S_n
        rw [← TensorProduct.smul_tmul']
        exact Submodule.smul_mem_smul haC trivial
      have hInfLe : I ⊓ 𝔪 ^ (n + k₀) ≤ L_n := by
        intro x ⟨hxI, hxPow⟩
        have hxTop : x ∈ 𝔪 ^ (n + k₀) • (⊤ : Submodule A A) := by
          have h1 : x = x • (1 : A) := (mul_one x).symm
          rw [h1]
          exact Submodule.smul_mem_smul hxPow trivial
        have hxAR : x ∈ 𝔪 ^ (n + k₀ - k₀) • (𝔪 ^ k₀ • (⊤ : Submodule A A) ⊓ I) := by
          rw [← hk₀ (n + k₀) (Nat.le_add_left k₀ n)]
          exact ⟨hxTop, hxI⟩
        rw [Nat.add_sub_cancel] at hxAR
        exact hSmulLe (Submodule.smul_mono le_rfl inf_le_right hxAR)
      have hImgMem : ∀ v : TensorProduct A C ↥(I ⊓ 𝔪 ^ (n + k₀)),
          LinearMap.lTensor C (Submodule.inclusion (inf_le_left : I ⊓ 𝔪 ^ (n + k₀) ≤ I)) v ∈ S_n := by
        intro v
        induction v using TensorProduct.induction_on with
        | zero => simp
        | tmul c y =>
          obtain ⟨_, hyC⟩ := hInfLe y.2
          exact hyC c
        | add u w ihu ihw =>
          rw [map_add]
          exact S_n.add_mem ihu ihw
      obtain ⟨v, hv⟩ := hFactor (n + k₀)
      rw [← hv]
      exact hImgMem v
    obtain ⟨r, hr⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff 𝔫 z).mp hMemPow
    have hsub0 : (1 - (r : C)) • z = 0 := by
      have hadd : (1 - (r : C)) • z + z = 0 + z := by
        calc (1 - (r : C)) • z + z
          _ = (1 - (r : C)) • z + (r : C) • z := by rw [hr]
          _ = ((1 - (r : C)) + (r : C)) • z := (add_smul _ _ z).symm
          _ = (1 : C) • z := by ring_nf
          _ = 0 + z := by rw [one_smul, zero_add]
      exact add_right_cancel hadd
    have h1r_not : 1 - (r : C) ∉ 𝔫 := by
      intro hmem
      have h1 : (1 : C) ∈ 𝔫 := by
        have heq : (1 : C) = (1 - (r : C)) + (r : C) := by ring
        rw [heq]
        exact 𝔫.add_mem hmem r.2
      exact IsLocalRing.notMem_maximalIdeal.mpr isUnit_one h1
    have hu1r : IsUnit (1 - (r : C)) := IsLocalRing.notMem_maximalIdeal.mp h1r_not
    exact hu1r.smul_eq_zero.mp hsub0

  
  have hStalkSub :
      ∀ (p : Ideal R) (S : Submonoid B) (C₀ : Type u)
        [CommRing C₀] [Algebra R C₀] [Algebra B C₀] [IsScalarTower R B C₀] [IsLocalization S C₀],
        (Function.Injective (LinearMap.rTensor C₀ p.subtype) →
          ∀ g ∈ LinearMap.ker (TensorProduct.AlgebraTensorModule.lTensor B B p.subtype),
            ∃ s : S, s • g = 0) ∧
        (∀ b₁ : B, b₁ ∈ S →
          (∀ z ∈ LinearMap.ker (TensorProduct.AlgebraTensorModule.lTensor B B p.subtype), b₁ • z = 0) →
          Function.Injective (LinearMap.rTensor C₀ p.subtype)) := by
    intro p S C₀ _ _ _ _ _
    let F_B : TensorProduct R B ↥p →ₗ[B] TensorProduct R B R :=
      TensorProduct.AlgebraTensorModule.lTensor B B p.subtype
    let locMap : ∀ (N : Type u) [AddCommGroup N] [Module R N],
        TensorProduct R B N →ₗ[B] TensorProduct R C₀ N :=
      fun N _ _ =>
        ((TensorProduct.AlgebraTensorModule.cancelBaseChange R B C₀ C₀ N).restrictScalars B).toLinearMap ∘ₗ
          TensorProduct.mk B C₀ (TensorProduct R B N) 1
    have hLocComm : ∀ (z : TensorProduct R B ↥p),
        LinearMap.lTensor C₀ p.subtype (locMap ↥p z) = locMap R (F_B z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul b x => rfl
      | add u v ihu ihv => simp only [map_add, ihu, ihv]
    constructor
    · intro hInj g hgK
      have hInjL : Function.Injective (LinearMap.lTensor C₀ p.subtype) :=
        (LinearMap.lTensor_inj_iff_rTensor_inj C₀ p.subtype).mpr hInj
      have hFg0 : F_B g = 0 := hgK
      have hLocg0 : locMap ↥p g = 0 := by
        apply hInjL
        rw [hLocComm g, hFg0, map_zero, map_zero]
      exact (IsLocalizedModule.eq_zero_iff S (locMap ↥p)).mp hLocg0
    · intro b₁ hb₁_S hb₁_kill
      rw [← LinearMap.lTensor_inj_iff_rTensor_inj C₀ p.subtype, injective_iff_map_eq_zero]
      intro w hw
      obtain ⟨⟨z, s⟩, hzs⟩ := IsLocalizedModule.surj S (locMap ↥p) w
      have hL_smul : LinearMap.lTensor C₀ p.subtype ((s : B) • w) =
          (s : B) • LinearMap.lTensor C₀ p.subtype w :=
        (TensorProduct.AlgebraTensorModule.lTensor B C₀ p.subtype).map_smul (s : B) w
      have hFz_loc : locMap R (F_B z) = 0 := by
        rw [← hLocComm z, ← hzs]
        change LinearMap.lTensor C₀ p.subtype ((s : B) • w) = 0
        rw [hL_smul, hw, smul_zero]
      obtain ⟨t, ht⟩ := (IsLocalizedModule.eq_zero_iff S (locMap R)).mp hFz_loc
      have htz_K : (t : B) • z ∈ LinearMap.ker F_B := by
        change F_B ((t : B) • z) = 0
        rw [F_B.map_smul]
        exact ht
      have hb₁_tz : b₁ • ((t : B) • z) = 0 := hb₁_kill ((t : B) • z) htz_K
      have hProd0 : (b₁ * (t : B) * (s : B)) • w = 0 := by
        have h1 := congrArg (locMap ↥p) hb₁_tz
        rw [map_zero, LinearMap.map_smul, LinearMap.map_smul] at h1
        have hzs' : locMap ↥p z = (s : B) • w := hzs.symm
        rw [hzs', smul_smul, smul_smul] at h1
        exact h1
      have hu_mem : b₁ * (t : B) * (s : B) ∈ S :=
        mul_mem (mul_mem hb₁_S t.2) s.2
      have hu_unit : IsUnit (algebraMap B C₀ (b₁ * (t : B) * (s : B))) :=
        IsLocalization.map_units C₀ ⟨_, hu_mem⟩
      rw [← IsScalarTower.algebraMap_smul C₀] at hProd0
      exact hu_unit.smul_eq_zero.mp hProd0

  have hOpenSub :
      ∀ (p : Ideal R) (q : PrimeSpectrum B),
        Function.Injective (LinearMap.rTensor (Localization.AtPrime q.asIdeal) p.subtype) →
        ∃ b₁ : B, b₁ ∉ q.asIdeal ∧
          ∀ (q' : PrimeSpectrum B), b₁ ∉ q'.asIdeal →
            Function.Injective (LinearMap.rTensor (Localization.AtPrime q'.asIdeal) p.subtype) := by
    intro p q hInjq
    let F_B : TensorProduct R B ↥p →ₗ[B] TensorProduct R B R :=
      TensorProduct.AlgebraTensorModule.lTensor B B p.subtype
    have : IsNoetherian B (TensorProduct R B ↥p) :=
      isNoetherian_of_isNoetherianRing_of_finite B (TensorProduct R B ↥p)
    let K : Submodule B (TensorProduct R B ↥p) := LinearMap.ker F_B
    obtain ⟨S_gen, hS_gen⟩ := IsNoetherian.noetherian K
    have hKillGen := (hStalkSub p q.asIdeal.primeCompl (Localization.AtPrime q.asIdeal)).1 hInjq
    have hKillAtQ : ∀ g ∈ S_gen, ∃ s : q.asIdeal.primeCompl, s • g = 0 := by
      intro g hg
      have hgK : g ∈ K := by
        rw [← hS_gen]
        exact Submodule.subset_span (Finset.mem_coe.mpr hg)
      exact hKillGen g hgK
    choose s_w hs_w using fun x : ↥S_gen => hKillAtQ x.1 x.2
    let _ : DecidableEq (TensorProduct R B ↥p) := Classical.decEq _
    let b₁ : B := ∏ x ∈ S_gen.attach, (s_w x : B)
    have hb₁_mem : b₁ ∈ q.asIdeal.primeCompl :=
      q.asIdeal.primeCompl.prod_mem fun x _ => (s_w x).2
    have hb₁_kill : ∀ z ∈ K, b₁ • z = 0 := by
      let annSub : Submodule B (TensorProduct R B ↥p) :=
        { carrier := { z | b₁ • z = 0 }
          zero_mem' := smul_zero b₁
          add_mem' := fun hx hy => by dsimp at *; rw [smul_add, hx, hy, add_zero]
          smul_mem' := fun c z hz => by dsimp at *; rw [smul_comm, hz, smul_zero] }
      have hSubKer : (↑S_gen : Set (TensorProduct R B ↥p)) ⊆ (annSub : Set (TensorProduct R B ↥p)) := by
        intro g hg
        change b₁ • g = 0
        have hdvd : (s_w ⟨g, hg⟩ : B) ∣ b₁ :=
          Finset.dvd_prod_of_mem (fun x => (s_w x : B)) (Finset.mem_attach S_gen ⟨g, hg⟩)
        obtain ⟨d, hd⟩ := hdvd
        rw [hd, mul_comm, mul_smul]
        exact (congrArg (d • ·) (hs_w ⟨g, hg⟩)).trans (smul_zero d)
      have hLe := Submodule.span_le.mpr hSubKer
      rw [hS_gen] at hLe
      exact fun z hz => hLe hz
    exact ⟨b₁, hb₁_mem, fun q' hb₁_q' =>
      (hStalkSub p q'.asIdeal.primeCompl (Localization.AtPrime q'.asIdeal)).2 b₁ hb₁_q' hb₁_kill⟩

  
  have hAwayFlatOfLocMod :
      ∀ (R₀ B₀ L_a M_a L_b : Type u) [CommRing R₀] [CommRing B₀] [Algebra R₀ B₀]
        [CommRing L_a] [Algebra R₀ L_a] (a₀ : R₀) [IsLocalization.Away a₀ L_a]
        [AddCommGroup M_a] [Module R₀ M_a] [Module L_a M_a] [IsScalarTower R₀ L_a M_a]
        (f_a : B₀ →ₗ[R₀] M_a) [IsLocalizedModule (Submonoid.powers a₀) f_a]
        [CommRing L_b] [Algebra R₀ L_b] [Algebra B₀ L_b] [IsScalarTower R₀ B₀ L_b]
        [IsLocalization.Away (algebraMap R₀ B₀ a₀) L_b],
        Module.Flat L_a M_a → Module.Flat R₀ L_b := by
    intro R₀ B₀ L_a M_a L_b _ _ _ _ _ a₀ _ _ _ _ _ f_a _ _ _ _ _ _ hFlatMa
    have : Module.Flat L_a M_a := hFlatMa
    have : Module.Flat R₀ L_a := IsLocalization.flat L_a (Submonoid.powers a₀)
    have : Module.Flat R₀ M_a := Module.Flat.trans R₀ L_a M_a
    let b₀ : B₀ := algebraMap R₀ B₀ a₀
    let g_loc : B₀ →ₗ[R₀] L_b := (Algebra.linearMap B₀ L_b).restrictScalars R₀
    have : IsLocalizedModule (Submonoid.powers a₀) g_loc := by
      refine IsLocalizedModule.mk ?_ ?_ ?_
      · intro s
        obtain ⟨n, hn⟩ := s.2
        change IsUnit (algebraMap R₀ (Module.End R₀ L_b) (s : R₀))
        rw [← hn, map_pow]
        refine IsUnit.pow n ?_
        obtain ⟨u_b, hu_b⟩ := IsLocalization.Away.algebraMap_isUnit (S := L_b) b₀
        let u_inv : L_b := ((u_b⁻¹ : L_bˣ) : L_b)
        refine ⟨{
          val := algebraMap R₀ (Module.End R₀ L_b) a₀
          inv := (Algebra.lmul B₀ L_b u_inv).restrictScalars R₀
          val_inv := by
            ext z
            change a₀ • (u_inv * z) = z
            rw [← IsScalarTower.algebraMap_smul B₀ a₀, Algebra.smul_def, ← hu_b]
            exact Units.mul_inv_cancel_left u_b z
          inv_val := by
            ext z
            change u_inv * (a₀ • z) = z
            rw [← IsScalarTower.algebraMap_smul B₀ a₀, Algebra.smul_def, ← hu_b]
            exact Units.inv_mul_cancel_left u_b z
        }, rfl⟩
      · intro y
        obtain ⟨⟨x₀, s₀⟩, hxy⟩ := IsLocalization.surj (Submonoid.powers b₀) y
        obtain ⟨n, hn⟩ := s₀.2
        refine ⟨(x₀, ⟨a₀ ^ n, ⟨n, rfl⟩⟩), ?_⟩
        change (a₀ ^ n) • y = algebraMap B₀ L_b x₀
        have hb_pow : algebraMap R₀ B₀ (a₀ ^ n) = (s₀ : B₀) := by
          rw [map_pow]; exact hn
        rw [← IsScalarTower.algebraMap_smul B₀ (a₀ ^ n) y, hb_pow, Algebra.smul_def, mul_comm]
        exact hxy
      · intro x₁ x₂ hx12
        obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers b₀) hx12
        obtain ⟨n, hn⟩ := c.2
        refine ⟨⟨a₀ ^ n, ⟨n, rfl⟩⟩, ?_⟩
        change (a₀ ^ n) • x₁ = (a₀ ^ n) • x₂
        have hb_pow : algebraMap R₀ B₀ (a₀ ^ n) = (c : B₀) := by
          rw [map_pow]; exact hn
        rw [← IsScalarTower.algebraMap_smul B₀ (a₀ ^ n) x₁,
          ← IsScalarTower.algebraMap_smul B₀ (a₀ ^ n) x₂, hb_pow,
          smul_eq_mul, smul_eq_mul]
        exact hc
    exact Module.Flat.of_linearEquiv (IsLocalizedModule.linearEquiv (Submonoid.powers a₀) f_a g_loc).symm

  have hSpecLiftOpaque :
      ∀ (p : Ideal R) [p.IsPrime] (a : R) (q' : PrimeSpectrum B)
        (C' L_b2 : Type u)
        [CommRing C'] [Algebra R C'] [Algebra B C'] [IsScalarTower R B C']
        [IsLocalization q'.asIdeal.primeCompl C']
        [CommRing L_b2] [Algebra (R ⧸ p) L_b2]
        [Algebra (B ⧸ Ideal.map (algebraMap R B) p) L_b2]
        [IsScalarTower (R ⧸ p) (B ⧸ Ideal.map (algebraMap R B) p) L_b2]
        [IsLocalization.Away
          (algebraMap (R ⧸ p) (B ⧸ Ideal.map (algebraMap R B) p) (Ideal.Quotient.mk p a)) L_b2],
        Module.Flat (R ⧸ p) L_b2 →
        Ideal.map (algebraMap R B) p ≤ q'.asIdeal →
        algebraMap R B a ∉ q'.asIdeal →
        Function.Injective (LinearMap.rTensor C' p.subtype) →
        Function.Injective (LinearMap.rTensor C' (Ideal.comap (algebraMap R B) q'.asIdeal).subtype) := by
    intro p _ a q' C' L_b2 _ _ _ _ _ _ _ _ _ _ hFlatLb2 hpq' haq' hInjp
    have : Module.Flat (R ⧸ p) L_b2 := hFlatLb2
    let R_bar := R ⧸ p
    let π_R : R →+* R_bar := Ideal.Quotient.mk p
    let a_bar : R_bar := π_R a
    let I_B : Ideal B := Ideal.map (algebraMap R B) p
    let B_bar := B ⧸ I_B
    let π_B : B →+* B_bar := Ideal.Quotient.mk I_B
    let J_C' : Ideal C' := Ideal.map (algebraMap R C') p
    let C_bar' := C' ⧸ J_C'
    let π_C' : C' →+* C_bar' := Ideal.Quotient.mk J_C'
    have hFlatCbar : Module.Flat R_bar C_bar' := by
      let b2_bar : B_bar := algebraMap R_bar B_bar a_bar
      have hb2_bar_eq : b2_bar = π_B (algebraMap R B a) := by
        change algebraMap R_bar B_bar (algebraMap R R_bar a) = algebraMap B B_bar (algebraMap R B a)
        rw [← IsScalarTower.algebraMap_apply R R_bar B_bar a, IsScalarTower.algebraMap_apply R B B_bar a]
      have hJC_eq : J_C' = Ideal.map (algebraMap B C') I_B := by
        dsimp [J_C', I_B]
        rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq R B C']
      have hKerIB : ∀ x ∈ I_B, (π_C'.comp (algebraMap B C')) x = 0 := by
        intro x hx
        change π_C' (algebraMap B C' x) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem, hJC_eq]
        exact Ideal.mem_map_of_mem (algebraMap B C') hx
      let ψ₀ : B_bar →+* C_bar' := Ideal.Quotient.lift I_B (π_C'.comp (algebraMap B C')) hKerIB
      letI : Algebra B_bar C_bar' := ψ₀.toAlgebra
      let M_Bbar : Submonoid B_bar := Submonoid.map π_B q'.asIdeal.primeCompl
      have : IsLocalization M_Bbar C_bar' := by
        rw [isLocalization_iff_isLocalizationMap]
        refine ⟨?_, ?_, ?_⟩
        · rintro ⟨_, s, hs, rfl⟩
          change IsUnit (π_C' (algebraMap B C' s))
          exact (IsLocalization.map_units C' ⟨s, hs⟩).map π_C'
        · intro z_bar
          obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z_bar
          obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj q'.asIdeal.primeCompl z
          refine ⟨(π_B b, ⟨π_B s, s.1, s.2, rfl⟩), ?_⟩
          change π_C' z * π_C' (algebraMap B C' s) = π_C' (algebraMap B C' b)
          rw [← map_mul, hbs]
        · intro y₁ y₂ hy
          obtain ⟨b₁, rfl⟩ := Ideal.Quotient.mk_surjective y₁
          obtain ⟨b₂, rfl⟩ := Ideal.Quotient.mk_surjective y₂
          have hdiff : algebraMap B C' (b₁ - b₂) ∈ Ideal.map (algebraMap B C') I_B := by
            rw [← hJC_eq, ← Ideal.Quotient.eq_zero_iff_mem, map_sub]
            exact sub_eq_zero.mpr hy
          obtain ⟨⟨i₀, s₀⟩, his₀⟩ :=
            (IsLocalization.mem_map_algebraMap_iff q'.asIdeal.primeCompl C').mp hdiff
          rw [← map_mul] at his₀
          obtain ⟨u₀, hu₀⟩ := IsLocalization.exists_of_eq (M := q'.asIdeal.primeCompl) his₀
          refine ⟨⟨π_B ((u₀ : B) * (s₀ : B)), (u₀ : B) * (s₀ : B), mul_mem u₀.2 s₀.2, rfl⟩, ?_⟩
          apply sub_eq_zero.mp
          change π_B ((u₀ : B) * (s₀ : B)) * π_B b₁ - π_B ((u₀ : B) * (s₀ : B)) * π_B b₂ = 0
          rw [← mul_sub, ← map_sub, ← map_mul]
          have heq_mul : (u₀ : B) * (s₀ : B) * (b₁ - b₂) = (u₀ : B) * ((b₁ - b₂) * (s₀ : B)) := by ring
          rw [heq_mul, hu₀, Ideal.Quotient.eq_zero_iff_mem]
          exact I_B.mul_mem_left (u₀ : B) i₀.2
      have hb2_bar_mem : b2_bar ∈ M_Bbar := ⟨algebraMap R B a, haq', hb2_bar_eq.symm⟩
      have hUnit_b2_bar : IsUnit (ψ₀ b2_bar) := IsLocalization.map_units C_bar' ⟨b2_bar, hb2_bar_mem⟩
      let ψ : L_b2 →+* C_bar' := IsLocalization.Away.lift b2_bar hUnit_b2_bar
      letI : Algebra L_b2 C_bar' := ψ.toAlgebra
      have : IsScalarTower B_bar L_b2 C_bar' :=
        IsScalarTower.of_algebraMap_eq fun y => (IsLocalization.Away.lift_eq b2_bar hUnit_b2_bar y).symm
      have : IsScalarTower R_bar L_b2 C_bar' := by
        apply IsScalarTower.of_algebraMap_eq'
        apply Ideal.Quotient.ringHom_ext
        ext r
        symm
        change ψ (algebraMap R_bar L_b2 (algebraMap R R_bar r)) =
          algebraMap R_bar C_bar' (π_R r)
        rw [IsScalarTower.algebraMap_apply R_bar B_bar L_b2,
          ← IsScalarTower.algebraMap_apply R R_bar B_bar r,
          IsScalarTower.algebraMap_apply R B B_bar r]
        change ψ (algebraMap B_bar L_b2 (π_B (algebraMap R B r))) = _
        rw [IsLocalization.Away.lift_eq]
        change π_C' (algebraMap B C' (algebraMap R B r)) = _
        rw [← IsScalarTower.algebraMap_apply R B C' r]
        rfl
      have hPowLe : Submonoid.powers b2_bar ≤ M_Bbar := Submonoid.powers_le.mpr hb2_bar_mem
      have : IsLocalization (Submonoid.map (algebraMap B_bar L_b2) M_Bbar) C_bar' :=
        IsLocalization.isLocalization_of_submonoid_le L_b2 C_bar' (Submonoid.powers b2_bar) M_Bbar hPowLe
      have : Module.Flat L_b2 C_bar' :=
        IsLocalization.flat C_bar' (Submonoid.map (algebraMap B_bar L_b2) M_Bbar)
      exact Module.Flat.trans R_bar L_b2 C_bar'
    let p' : Ideal R := Ideal.comap (algebraMap R B) q'.asIdeal
    have hp_le_p' : p ≤ p' := Ideal.map_le_iff_le_comap.mp hpq'
    let p_bar' : Ideal R_bar := Ideal.map π_R p'
    let mkAlpha : ∀ (M : Type u) [AddCommGroup M] [Module R_bar M] [Module R M] [IsScalarTower R R_bar M],
        TensorProduct R M C' →ₗ[R] TensorProduct R_bar M C_bar' :=
      fun M _ _ _ _ =>
        TensorProduct.lift
          { toFun := fun m =>
              { toFun := fun c' => m ⊗ₜ[R_bar] π_C' c'
                map_add' := fun c₁ c₂ => by rw [map_add, TensorProduct.tmul_add]
                map_smul' := fun r c' => by
                  dsimp
                  have hrc : π_C' (r • c') = (π_R r) • π_C' c' := rfl
                  have htmul : (π_R r • m) ⊗ₜ[R_bar] π_C' c' = m ⊗ₜ[R_bar] (π_R r • π_C' c') :=
                    TensorProduct.smul_tmul (π_R r) m (π_C' c')
                  have hrm : π_R r • m = r • m := IsScalarTower.algebraMap_smul R_bar r m
                  rw [hrc, ← htmul, hrm]
                  rfl }
            map_add' := fun m₁ m₂ => by ext c'; dsimp; rw [TensorProduct.add_tmul]
            map_smul' := fun r m => by ext c'; rfl }
    have hKillJC : ∀ (m : ↥p_bar') (x : C'), x ∈ J_C' → (m ⊗ₜ[R] x : TensorProduct R ↥p_bar' C') = 0 := by
      intro m
      let K_m : Ideal C' :=
        { carrier := { x : C' | ∀ c'' : C', (m ⊗ₜ[R] (c'' * x) : TensorProduct R ↥p_bar' C') = 0 }
          zero_mem' := fun c'' => by rw [mul_zero, TensorProduct.tmul_zero]
          add_mem' := fun hx hy c'' => by rw [mul_add, TensorProduct.tmul_add, hx c'', hy c'']; simp
          smul_mem' := fun c₁ _ hx c'' => by
            change m ⊗ₜ[R] (c'' * (c₁ * _)) = 0
            rw [← mul_assoc]
            exact hx (c'' * c₁) }
      have hLeKm : J_C' ≤ K_m := by
        rw [Ideal.map_le_iff_le_comap]
        intro r hr c''
        have hcomm : c'' * algebraMap R C' r = r • c'' := by
          rw [mul_comm, Algebra.smul_def]
        have hr0 : π_R r = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hr
        change m ⊗ₜ[R] (c'' * algebraMap R C' r) = 0
        rw [hcomm, ← TensorProduct.smul_tmul, ← IsScalarTower.algebraMap_smul R_bar r m]
        change ((π_R r) • m) ⊗ₜ[R] c'' = 0
        rw [hr0, zero_smul, TensorProduct.zero_tmul]
      intro x hx
      simpa only [one_mul] using hLeKm hx 1
    let β_p' : TensorProduct R_bar ↥p_bar' C_bar' →ₗ[R_bar] TensorProduct R ↥p_bar' C' :=
      TensorProduct.lift
        { toFun := fun m =>
            { toFun := Quotient.lift (fun c' : C' => (m ⊗ₜ[R] c' : TensorProduct R ↥p_bar' C'))
                (fun c₁ c₂ hrel => by
                  have hquot : π_C' c₁ = π_C' c₂ := Quotient.sound hrel
                  have hsub : c₁ - c₂ ∈ J_C' := by
                    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub]
                    exact sub_eq_zero.mpr hquot
                  have h0 := hKillJC m (c₁ - c₂) hsub
                  rw [TensorProduct.tmul_sub] at h0
                  exact sub_eq_zero.mp h0)
              map_add' := fun z₁ z₂ => by
                obtain ⟨c₁, rfl⟩ := Ideal.Quotient.mk_surjective z₁
                obtain ⟨c₂, rfl⟩ := Ideal.Quotient.mk_surjective z₂
                exact TensorProduct.tmul_add m c₁ c₂
              map_smul' := fun r_bar z => by
                obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r_bar
                obtain ⟨c', rfl⟩ := Ideal.Quotient.mk_surjective z
                change m ⊗ₜ[R] (r • c') = (π_R r) • (m ⊗ₜ[R] c')
                rw [← TensorProduct.smul_tmul, ← IsScalarTower.algebraMap_smul R_bar r m]
                rfl }
          map_add' := fun m₁ m₂ => by
            ext z
            obtain ⟨c', rfl⟩ := Ideal.Quotient.mk_surjective z
            exact TensorProduct.add_tmul m₁ m₂ c'
          map_smul' := fun r_bar m => by
            ext z
            obtain ⟨c', rfl⟩ := Ideal.Quotient.mk_surjective z
            rfl }
    have hBetaAlpha : ∀ w : TensorProduct R ↥p_bar' C', β_p' (mkAlpha ↥p_bar' w) = w := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul m c' => rfl
      | add u v ihu ihv => simp only [map_add, ihu, ihv]
    have hInjPbar : Function.Injective (LinearMap.rTensor C' (p_bar'.subtype.restrictScalars R)) := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      have hCommAlpha : ∀ u : TensorProduct R ↥p_bar' C',
          mkAlpha R_bar (LinearMap.rTensor C' (p_bar'.subtype.restrictScalars R) u) =
            LinearMap.rTensor C_bar' p_bar'.subtype (mkAlpha ↥p_bar' u) := by
        intro u
        induction u using TensorProduct.induction_on with
        | zero => simp
        | tmul m c' => rfl
        | add u₁ u₂ ih1 ih2 => simp only [map_add, ih1, ih2]
      have hAlpha0 : mkAlpha ↥p_bar' w = 0 := by
        apply Module.Flat.iff_rTensor_injective'.mp hFlatCbar p_bar'
        rw [map_zero, ← hCommAlpha w, hw, map_zero]
      rw [← hBetaAlpha w, hAlpha0, map_zero]
    let inc_p : ↥p →ₗ[R] ↥p' := Submodule.inclusion hp_le_p'
    let quot_p : ↥p' →ₗ[R] ↥p_bar' :=
      { toFun := fun x => ⟨π_R x.1, Ideal.mem_map_of_mem π_R x.2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    have hSurjQuot : Function.Surjective quot_p := by
      let imgIdeal : Ideal R_bar :=
        { carrier := π_R '' (p' : Set R)
          zero_mem' := ⟨0, p'.zero_mem, map_zero π_R⟩
          add_mem' := by
            rintro _ _ ⟨a₁, ha₁, rfl⟩ ⟨a₂, ha₂, rfl⟩
            exact ⟨a₁ + a₂, p'.add_mem ha₁ ha₂, map_add π_R a₁ a₂⟩
          smul_mem' := by
            rintro r_bar _ ⟨a₁, ha₁, rfl⟩
            obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r_bar
            exact ⟨r * a₁, p'.mul_mem_left r ha₁, map_mul π_R r a₁⟩ }
      have hLeImg : p_bar' ≤ imgIdeal :=
        Ideal.map_le_iff_le_comap.mpr fun r hr => ⟨r, hr, rfl⟩
      intro y_bar
      obtain ⟨r, hr, hry⟩ := hLeImg y_bar.2
      exact ⟨⟨r, hr⟩, Subtype.ext hry⟩
    have hExIncQuot : Function.Exact inc_p quot_p := by
      intro x
      constructor
      · intro hx0
        have hmem : x.1 ∈ p := Ideal.Quotient.eq_zero_iff_mem.mp (congrArg Subtype.val hx0)
        exact ⟨⟨x.1, hmem⟩, rfl⟩
      · rintro ⟨y, rfl⟩
        ext
        exact Ideal.Quotient.eq_zero_iff_mem.mpr y.2
    have hCompSub : (p_bar'.subtype.restrictScalars R) ∘ₗ quot_p =
        (Algebra.linearMap R R_bar) ∘ₗ p'.subtype := by
      ext x; rfl
    have hCompInc : p'.subtype ∘ₗ inc_p = p.subtype := by
      ext x; rfl
    rw [injective_iff_map_eq_zero]
    intro z hz
    have hq0 : LinearMap.rTensor C' quot_p z = 0 := by
      apply hInjPbar
      rw [map_zero]
      calc LinearMap.rTensor C' (p_bar'.subtype.restrictScalars R) (LinearMap.rTensor C' quot_p z)
        _ = LinearMap.rTensor C' ((p_bar'.subtype.restrictScalars R) ∘ₗ quot_p) z := by
          rw [LinearMap.rTensor_comp, LinearMap.comp_apply]
        _ = LinearMap.rTensor C' ((Algebra.linearMap R R_bar) ∘ₗ p'.subtype) z := by rw [hCompSub]
        _ = LinearMap.rTensor C' (Algebra.linearMap R R_bar) (LinearMap.rTensor C' p'.subtype z) := by
          rw [LinearMap.rTensor_comp, LinearMap.comp_apply]
        _ = 0 := by rw [hz, map_zero]
    obtain ⟨u, hu⟩ := (rTensor_exact C' hExIncQuot hSurjQuot z).mp hq0
    have hu0 : u = 0 := by
      apply hInjp
      rw [map_zero, ← hCompInc]
      calc LinearMap.rTensor C' (p'.subtype ∘ₗ inc_p) u
        _ = LinearMap.rTensor C' p'.subtype (LinearMap.rTensor C' inc_p u) := by
          rw [LinearMap.rTensor_comp, LinearMap.comp_apply]
        _ = LinearMap.rTensor C' p'.subtype z := by rw [hu]
        _ = 0 := hz
    rw [← hu, hu0, map_zero]

  
  have hLocFlatTrans :
      ∀ (S₁ S₂ : Submonoid B) (B₁ B₂ : Type u)
        [CommRing B₁] [Algebra R B₁] [Algebra B B₁] [IsScalarTower R B B₁] [IsLocalization S₁ B₁]
        [CommRing B₂] [Algebra R B₂] [Algebra B B₂] [IsScalarTower R B B₂] [IsLocalization S₂ B₂],
        S₂ ≤ S₁ → Module.Flat R B₂ → Module.Flat R B₁ := by
    intro S₁ S₂ B₁ B₂ _ _ _ _ _ _ _ _ _ _ hSubLe hFlat2
    have : Module.Flat R B₂ := hFlat2
    have hUnits : ∀ y : S₂, IsUnit (algebraMap B B₁ y) :=
      fun y => IsLocalization.map_units B₁ ⟨y.1, hSubLe y.2⟩
    let ψ_loc : B₂ →+* B₁ := IsLocalization.lift hUnits
    letI : Algebra B₂ B₁ := ψ_loc.toAlgebra
    have : IsScalarTower B B₂ B₁ :=
      IsScalarTower.of_algebraMap_eq fun b => (IsLocalization.lift_eq hUnits b).symm
    have : IsScalarTower R B₂ B₁ := by
      apply IsScalarTower.of_algebraMap_eq
      intro r
      symm
      rw [IsScalarTower.algebraMap_apply R B B₂ r]
      change ψ_loc (algebraMap B B₂ (algebraMap R B r)) = _
      rw [IsLocalization.lift_eq hUnits, ← IsScalarTower.algebraMap_apply R B B₁ r]
    have : IsLocalization (Submonoid.map (algebraMap B B₂) S₁) B₁ :=
      IsLocalization.isLocalization_of_submonoid_le B₂ B₁ S₂ S₁ hSubLe
    have : Module.Flat B₂ B₁ :=
      IsLocalization.flat B₁ (Submonoid.map (algebraMap B B₂) S₁)
    exact Module.Flat.trans R B₂ B₁

  have hFlatOfMaximal :
      ∀ (S : Type u) [CommRing S] [Algebra R S],
        (∀ (P : Ideal S) [P.IsMaximal], Module.Flat R (Localization.AtPrime P)) →
        Module.Flat R S := by
    intro S _ _ hMax
    exact Module.flat_of_isLocalized_maximal S S
      (fun P _ => Localization.AtPrime P)
      (fun P _ => Algebra.linearMap S (Localization.AtPrime P)) hMax

  have hAwayOfSpecOpen :
      (∀ (q : PrimeSpectrum B),
        Module.Flat R (Localization.AtPrime q.asIdeal) →
        ∃ b₀ : B, b₀ ∉ q.asIdeal ∧
          ∀ (q' : PrimeSpectrum B),
            q.asIdeal ≤ q'.asIdeal → b₀ ∉ q'.asIdeal →
            Module.Flat R (Localization.AtPrime q'.asIdeal)) →
      ∀ (q : PrimeSpectrum B),
        Module.Flat R (Localization.AtPrime q.asIdeal) →
        ∃ b : B, b ∉ q.asIdeal ∧ Module.Flat R (Localization.Away b) := by
    intro hSpecOpen
    let U_flat : Set (PrimeSpectrum B) :=
      { q : PrimeSpectrum B | Module.Flat R (Localization.AtPrime q.asIdeal) }
    have hGenStab : ∀ {q₁ q₂ : PrimeSpectrum B},
        q₁.asIdeal ≤ q₂.asIdeal → q₂ ∈ U_flat → q₁ ∈ U_flat :=
      fun {q₁ q₂} hq12 hFlat2 =>
        hLocFlatTrans q₁.asIdeal.primeCompl q₂.asIdeal.primeCompl
          (Localization.AtPrime q₁.asIdeal) (Localization.AtPrime q₂.asIdeal)
          (fun _ hs hmem1 => hs (hq12 hmem1)) hFlat2
    let Z : Set (PrimeSpectrum B) := U_flatᶜ
    let I_Z : Ideal B := PrimeSpectrum.vanishingIdeal Z
    have hClosureZ : closure Z ⊆ Z := by
      intro q₀ hq₀_cl
      by_contra hq₀_notZ
      have hq₀_flat : q₀ ∈ U_flat := Set.notMem_compl_iff.mp hq₀_notZ
      have hIZ_le_q₀ : I_Z ≤ q₀.asIdeal := by
        rw [← PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure] at hq₀_cl
        exact hq₀_cl
      obtain ⟨P₀, hP₀_min, hP₀_le_q₀⟩ := Ideal.exists_minimalPrimes_le hIZ_le_q₀
      have : P₀.IsPrime := hP₀_min.1.1
      let q_min : PrimeSpectrum B := ⟨P₀, hP₀_min.1.1⟩
      have hq_min_cl : q_min ∈ closure Z := by
        rw [← PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure]
        exact hP₀_min.1.2
      have hq_min_flat : q_min ∈ U_flat := hGenStab hP₀_le_q₀ hq₀_flat
      obtain ⟨b₀, hb₀_not, hOpen₀⟩ := hSpecOpen q_min hq_min_flat
      have hFinMin : I_Z.minimalPrimes.Finite :=
        Ideal.finite_minimalPrimes_of_isNoetherianRing B I_Z
      let S_other : Set (Ideal B) := I_Z.minimalPrimes \ {P₀}
      have hFinOther : S_other.Finite := hFinMin.sdiff
      let W : Set (PrimeSpectrum B) :=
        PrimeSpectrum.zeroLocus ((P₀ : Set B) ∪ {b₀}) ∪
          ⋃ P ∈ S_other, PrimeSpectrum.zeroLocus (P : Set B)
      have hClosedW : IsClosed W :=
        (PrimeSpectrum.isClosed_zeroLocus _).union
          (hFinOther.isClosed_biUnion fun P _ => PrimeSpectrum.isClosed_zeroLocus _)
      have hZ_sub_W : Z ⊆ W := by
        intro q' hq'Z
        have hIZ_le_q' : I_Z ≤ q'.asIdeal := by
          have hcl := subset_closure hq'Z
          rwa [← PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure] at hcl
        obtain ⟨P, hP_min, hP_le_q'⟩ := Ideal.exists_minimalPrimes_le hIZ_le_q'
        by_cases hPP₀ : P = P₀
        · subst hPP₀
          left
          rw [PrimeSpectrum.mem_zeroLocus, Set.union_subset_iff]
          refine ⟨hP_le_q', Set.singleton_subset_iff.mpr ?_⟩
          by_contra hb₀_q'
          exact hq'Z (hOpen₀ q' hP_le_q' hb₀_q')
        · right
          exact Set.mem_iUnion₂.mpr ⟨P, ⟨hP_min, hPP₀⟩, hP_le_q'⟩
      have hq_min_W : q_min ∈ W := (closure_minimal hZ_sub_W hClosedW) hq_min_cl
      rcases hq_min_W with hLeft | hRight
      · rw [PrimeSpectrum.mem_zeroLocus, Set.union_subset_iff, Set.singleton_subset_iff] at hLeft
        exact hb₀_not hLeft.2
      · obtain ⟨P, ⟨hP_min, hP_ne⟩, hP_le_P₀⟩ := Set.mem_iUnion₂.mp hRight
        have hP₀_le_P : P₀ ≤ P := hP₀_min.2 hP_min.1 hP_le_P₀
        exact hP_ne (le_antisymm hP_le_P₀ hP₀_le_P)
    have hClosedZ : IsClosed Z := subset_antisymm hClosureZ subset_closure ▸ isClosed_closure
    have hOpenU : IsOpen U_flat := by
      have heq : U_flat = Zᶜ := (compl_compl U_flat).symm
      rw [heq]
      exact hClosedZ.isOpen_compl
    intro q hFlatQ
    obtain ⟨_, ⟨b, rfl⟩, hq_in_b, hb_sub_U⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.isOpen_iff.mp hOpenU q hFlatQ
    have hb_not_q : b ∉ q.asIdeal := hq_in_b
    refine ⟨b, hb_not_q, hFlatOfMaximal (Localization.Away b) fun P hPMax => ?_⟩
    have hPPrime : P.IsPrime := hPMax.isPrime
    let q_P : Ideal B := Ideal.comap (algebraMap B (Localization.Away b)) P
    have hqPPrime : q_P.IsPrime := Ideal.comap_isPrime (algebraMap B (Localization.Away b)) P
    have hb_not_qP : b ∉ q_P := by
      intro hb_in
      have hu : IsUnit (algebraMap B (Localization.Away b) b) :=
        IsLocalization.Away.algebraMap_isUnit (S := Localization.Away b) b
      exact hPPrime.ne_top (P.eq_top_of_isUnit_mem hb_in hu)
    have hFlat_qP : Module.Flat R (Localization.AtPrime q_P) :=
      hb_sub_U (show (⟨q_P, hqPPrime⟩ : PrimeSpectrum B) ∈ PrimeSpectrum.basicOpen b from hb_not_qP)
    let e_iso := IsLocalization.localizationLocalizationAtPrimeIsoLocalization (Submonoid.powers b) P
    exact @Module.Flat.of_linearEquiv R (Localization.AtPrime q_P) (Localization.AtPrime P)
      _ _ _ _ _ hFlat_qP (e_iso.symm.toLinearEquiv.restrictScalars R)

  
  have hLocalBridge :
      ∀ (p : Ideal R) [p.IsPrime] (A C : Type u)
        [CommRing A] [IsLocalRing A] [Algebra R A] [IsLocalization.AtPrime A p]
        [CommRing C] [IsLocalRing C] [IsNoetherianRing C] [Algebra R C]
        (φ_loc : A →+* C),
        (∀ r : R, φ_loc (algebraMap R A r) = algebraMap R C r) →
        IsLocalHom φ_loc →
        Function.Injective (LinearMap.rTensor C p.subtype) →
        Module.Flat R C := by
    intro p _ A C _ _ _ _ _ _ _ _ φ_loc hφ_comm hφ_loc hInj
    let 𝔪 := IsLocalRing.maximalIdeal A
    letI : Algebra A C := φ_loc.toAlgebra
    have : IsScalarTower R A C := IsScalarTower.of_algebraMap_eq fun r => (hφ_comm r).symm
    have : IsLocalHom (algebraMap A C) := hφ_loc
    have : IsNoetherianRing A := IsLocalization.isNoetherianRing p.primeCompl A ‹IsNoetherianRing R›
    let f_p : ↥p → ↥𝔪 := fun x =>
      ⟨algebraMap R A x.1, (IsLocalization.AtPrime.to_map_mem_maximal_iff A p x.1).mpr x.2⟩
    let Ψ : TensorProduct R ↥p C →ₗ[R] TensorProduct A ↥𝔪 C :=
      TensorProduct.lift
        { toFun := fun x =>
            { toFun := fun c => f_p x ⊗ₜ[A] c
              map_add' := fun c₁ c₂ => TensorProduct.tmul_add (f_p x) c₁ c₂
              map_smul' := fun r c => by
                change f_p x ⊗ₜ[A] (r • c) = r • (f_p x ⊗ₜ[A] c)
                rw [← IsScalarTower.algebraMap_smul A r c, ← TensorProduct.smul_tmul,
                  IsScalarTower.algebraMap_smul A r (f_p x)]
                rfl }
          map_add' := fun x₁ x₂ => by
            ext c
            have hfp : f_p (x₁ + x₂) = f_p x₁ + f_p x₂ := by ext; exact map_add (algebraMap R A) x₁.1 x₂.1
            change f_p (x₁ + x₂) ⊗ₜ[A] c = f_p x₁ ⊗ₜ[A] c + f_p x₂ ⊗ₜ[A] c
            rw [hfp, TensorProduct.add_tmul]
          map_smul' := fun r x => by
            ext c
            have hfp : f_p (r • x) = (algebraMap R A r) • f_p x := by
              ext
              exact map_mul (algebraMap R A) r x.1
            change f_p (r • x) ⊗ₜ[A] c = r • (f_p x ⊗ₜ[A] c)
            rw [hfp, IsScalarTower.algebraMap_smul A r (f_p x)]
            rfl }
    have hSurjΨ : Function.Surjective Ψ := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨0, map_zero Ψ⟩
      | tmul m c =>
        obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj p.primeCompl m.1
        have hr_mem_m : algebraMap R A r ∈ 𝔪 := by
          rw [← hrs]
          exact 𝔪.mul_mem_right _ m.2
        have hr_p : r ∈ p := (IsLocalization.AtPrime.to_map_mem_maximal_iff A p r).mp hr_mem_m
        obtain ⟨u_s, hu_s⟩ := IsLocalization.map_units A s
        let u_sinv : A := ((u_s⁻¹ : Aˣ) : A)
        have hsmul_m : u_sinv • f_p ⟨r, hr_p⟩ = m := by
          ext
          change u_sinv * algebraMap R A r = m.1
          rw [← hrs, ← hu_s, mul_comm m.1 (u_s : A)]
          exact Units.inv_mul_cancel_left u_s m.1
        refine ⟨⟨r, hr_p⟩ ⊗ₜ[R] (u_sinv • c), ?_⟩
        change f_p ⟨r, hr_p⟩ ⊗ₜ[A] (u_sinv • c) = m ⊗ₜ[A] c
        rw [← TensorProduct.smul_tmul, hsmul_m]
      | add u v ihu ihv =>
        obtain ⟨w₁, rfl⟩ := ihu
        obtain ⟨w₂, rfl⟩ := ihv
        exact ⟨w₁ + w₂, map_add Ψ w₁ w₂⟩
    have hLidComm : ∀ w : TensorProduct R ↥p C,
        TensorProduct.lid A C (LinearMap.rTensor C 𝔪.subtype (Ψ w)) =
          TensorProduct.lid R C (LinearMap.rTensor C p.subtype w) := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul x c =>
        change (TensorProduct.lid A C) (LinearMap.rTensor C 𝔪.subtype (f_p x ⊗ₜ[A] c)) =
          (TensorProduct.lid R C) (LinearMap.rTensor C p.subtype (x ⊗ₜ[R] c))
        simp only [LinearMap.rTensor_tmul, TensorProduct.lid_tmul]
        exact IsScalarTower.algebraMap_smul A x.1 c
      | add u v ihu ihv =>
        simp only [map_add, ihu, ihv]
    have hInjMax : Function.Injective (LinearMap.rTensor C 𝔪.subtype) := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨w, rfl⟩ := hSurjΨ z
      have hw0 : w = 0 := by
        apply hInj
        rw [map_zero]
        apply (TensorProduct.lid R C).injective
        rw [map_zero, ← hLidComm w, hz, map_zero]
      rw [hw0, map_zero]
    have : Module.Flat A C := hLocalCrit A C hInjMax
    have : Module.Flat R A := IsLocalization.flat A p.primeCompl
    exact Module.Flat.trans R A C

  have hConj1 :
      ∀ (q : PrimeSpectrum B),
        Module.Flat R (Localization.AtPrime q.asIdeal) ↔
          Function.Injective
            (LinearMap.rTensor (Localization.AtPrime q.asIdeal)
              (Ideal.comap (algebraMap R B) q.asIdeal).subtype) := by
    intro q
    let p : Ideal R := Ideal.comap (algebraMap R B) q.asIdeal
    have : p.IsPrime := q.isPrime.comap (algebraMap R B)
    let C := Localization.AtPrime q.asIdeal
    constructor
    · exact fun hFlat => Module.Flat.iff_rTensor_injective'.mp hFlat p
    · intro hInj
      have : IsNoetherianRing C := IsLocalization.isNoetherianRing q.asIdeal.primeCompl C ‹IsNoetherianRing B›
      exact hLocalBridge p (Localization.AtPrime p) C
        (Localization.localRingHom p q.asIdeal (algebraMap R B) rfl)
        (fun r => (Localization.localRingHom_to_map p q.asIdeal (algebraMap R B) rfl r).trans
          (IsScalarTower.algebraMap_apply R B C r).symm)
        (Localization.isLocalHom_localRingHom p q.asIdeal (algebraMap R B) rfl)
        hInj

  refine ⟨hConj1, ?_⟩
  intro hGenFlat
  refine hAwayOfSpecOpen fun q hFlatQ => ?_
  let p : Ideal R := Ideal.comap (algebraMap R B) q.asIdeal
  have : p.IsPrime := q.isPrime.comap (algebraMap R B)
  have hInjq := (hConj1 q).mp hFlatQ
  obtain ⟨b₁, hb₁_not_q, hb₁_open⟩ := hOpenSub p q hInjq
  obtain ⟨a, ha_not_p, hFlatQuot⟩ := hGenFlat p
  let b₂ : B := algebraMap R B a
  have hb₂_not_q : b₂ ∉ q.asIdeal := ha_not_p
  have hFlatLb2 :
      Module.Flat (R ⧸ p)
        (Localization.Away
          (algebraMap (R ⧸ p) (B ⧸ Ideal.map (algebraMap R B) p) (Ideal.Quotient.mk p a))) :=
    hAwayFlatOfLocMod (R ⧸ p) (B ⧸ Ideal.map (algebraMap R B) p)
      (Localization.Away (Ideal.Quotient.mk p a))
      (LocalizedModule (Submonoid.powers (Ideal.Quotient.mk p a)) (B ⧸ Ideal.map (algebraMap R B) p))
      (Localization.Away (algebraMap (R ⧸ p) (B ⧸ Ideal.map (algebraMap R B) p) (Ideal.Quotient.mk p a)))
      (Ideal.Quotient.mk p a)
      (LocalizedModule.mkLinearMap (Submonoid.powers (Ideal.Quotient.mk p a)) (B ⧸ Ideal.map (algebraMap R B) p))
      hFlatQuot
  refine ⟨b₁ * b₂, q.isPrime.mul_notMem hb₁_not_q hb₂_not_q, ?_⟩
  intro q' hqle hb₀_not_q'
  have hb₁_not_q' : b₁ ∉ q'.asIdeal := fun h => hb₀_not_q' (q'.asIdeal.mul_mem_right b₂ h)
  have hb₂_not_q' : b₂ ∉ q'.asIdeal := fun h => hb₀_not_q' (q'.asIdeal.mul_mem_left b₁ h)
  have hpq' : Ideal.map (algebraMap R B) p ≤ q'.asIdeal :=
    Ideal.map_le_iff_le_comap.mpr (Ideal.comap_mono hqle)
  exact (hConj1 q').mpr
    (hSpecLiftOpaque p a q' (Localization.AtPrime q'.asIdeal)
      (Localization.Away (algebraMap (R ⧸ p) (B ⧸ Ideal.map (algebraMap R B) p) (Ideal.Quotient.mk p a)))
      hFlatLb2 hpq' hb₂_not_q' (hb₁_open q' hb₁_not_q'))

theorem weil_nagata_generic_freeness_finiteType (A C : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A]
    [CommRing C] [Algebra A C] [Algebra.FiniteType A C] :
    ∃ a : A, a ≠ 0 ∧
      Module.Free (Localization.Away a) (LocalizedModule (Submonoid.powers a) C) :=
by
  
  have hFreeOfEquiv :
      ∀ {R M₁ M₂ : Type u} [CommRing R] [AddCommGroup M₁] [Module R M₁]
        [AddCommGroup M₂] [Module R M₂] (e : M₁ ≃ₗ[R] M₂) (a : R),
        Module.Free (Localization.Away a) (TensorProduct R (Localization.Away a) M₁) →
        Module.Free (Localization.Away a) (TensorProduct R (Localization.Away a) M₂) := by
    intro R M₁ M₂ _ _ _ _ _ e a _
    exact Module.Free.of_equiv (LinearEquiv.baseChange R (Localization.Away a) M₁ M₂ e)

  have hFreeMulRight :
      ∀ {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M] (a b : R),
        Module.Free (Localization.Away a) (TensorProduct R (Localization.Away a) M) →
        Module.Free (Localization.Away (a * b)) (TensorProduct R (Localization.Away (a * b)) M) := by
    intro R M _ _ _ a b _
    let R₁ := Localization.Away a
    let R₂ := Localization.Away (a * b)
    have hu_ab : IsUnit (algebraMap R R₂ a * algebraMap R R₂ b) := by
      rw [← map_mul]
      exact IsLocalization.Away.algebraMap_isUnit (a * b)
    have hu_a : IsUnit (algebraMap R R₂ a) := isUnit_of_mul_isUnit_left hu_ab
    let φ : R₁ →+* R₂ := IsLocalization.Away.lift a hu_a
    let _ : Algebra R₁ R₂ := φ.toAlgebra
    have : IsScalarTower R R₁ R₂ :=
      IsScalarTower.of_algebraMap_eq fun r => (IsLocalization.Away.lift_eq a hu_a r).symm
    have : Module.Free R₂ (TensorProduct R₁ R₂ (TensorProduct R R₁ M)) :=
      Module.Free.tensor
    exact Module.Free.of_equiv
      (TensorProduct.AlgebraTensorModule.cancelBaseChange R R₁ R₂ R₂ M)

  have hFreeShortExact :
      ∀ {R N₁ N₂ Q : Type u} [CommRing R]
        [AddCommGroup N₁] [Module R N₁]
        [AddCommGroup N₂] [Module R N₂]
        [AddCommGroup Q] [Module R Q]
        (f : N₁ →ₗ[R] N₂) (g : N₂ →ₗ[R] Q)
        (hf : Function.Injective f) (hg : Function.Surjective g) (hfg : Function.Exact f g)
        (a : R),
        Module.Free (Localization.Away a) (TensorProduct R (Localization.Away a) N₁) →
        Module.Free (Localization.Away a) (TensorProduct R (Localization.Away a) Q) →
        Module.Free (Localization.Away a) (TensorProduct R (Localization.Away a) N₂) := by
    intro R N₁ N₂ Q _ _ _ _ _ _ _ f g hf hg hfg a _ _
    let R_a := Localization.Away a
    have : Module.Flat R R_a := IsLocalization.flat R_a (Submonoid.powers a)
    let F₁ := TensorProduct R R_a N₁
    let F₂ := TensorProduct R R_a N₂
    let F_Q := TensorProduct R R_a Q
    let f_a : F₁ →ₗ[R_a] F₂ := LinearMap.baseChange R_a f
    let g_a : F₂ →ₗ[R_a] F_Q := LinearMap.baseChange R_a g
    have hf_eq : (f_a : F₁ → F₂) = LinearMap.lTensor R_a f := by
      have hlin : f_a.restrictScalars R = LinearMap.lTensor R_a f :=
        TensorProduct.ext' fun _ _ => rfl
      exact congrArg DFunLike.coe hlin
    have hg_eq : (g_a : F₂ → F_Q) = LinearMap.lTensor R_a g := by
      have hlin : g_a.restrictScalars R = LinearMap.lTensor R_a g :=
        TensorProduct.ext' fun _ _ => rfl
      exact congrArg DFunLike.coe hlin
    have hf_a : Function.Injective f_a := by
      rw [hf_eq]
      exact Module.Flat.lTensor_preserves_injective_linearMap f hf
    have hg_a : Function.Surjective g_a := by
      rw [hg_eq]
      exact LinearMap.lTensor_surjective R_a hg
    have hfg_a : Function.Exact f_a g_a := by
      intro z
      have hex := Module.Flat.lTensor_exact R_a hfg z
      simpa [hf_eq, hg_eq] using hex
    let B_Q := Module.Free.chooseBasis R_a F_Q
    choose s hs using fun i => hg_a (B_Q i)
    let σ : F_Q →ₗ[R_a] F₂ := B_Q.constr R_a s
    have hgσ : ∀ y : F_Q, g_a (σ y) = y := by
      have hcomp : g_a.comp σ = LinearMap.id := by
        apply B_Q.ext
        intro i
        simp [σ, hs]
      intro y
      exact LinearMap.congr_fun hcomp y
    let Θ : (F₁ × F_Q) →ₗ[R_a] F₂ := f_a.coprod σ
    have hΘ_inj : Function.Injective Θ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      rintro ⟨x, y⟩ hxy
      change f_a x + σ y = 0 at hxy
      have hgy : g_a (f_a x + σ y) = 0 := by rw [hxy, map_zero]
      rw [map_add, hfg_a.apply_apply_eq_zero x, zero_add, hgσ y] at hgy
      subst hgy
      rw [map_zero, add_zero] at hxy
      have hx : x = 0 := hf_a (by rw [hxy, map_zero])
      subst hx
      rfl
    have hΘ_surj : Function.Surjective Θ := by
      intro z
      let y := g_a z
      have hker : g_a (z - σ y) = 0 := by
        rw [map_sub, hgσ y, sub_self]
      obtain ⟨x, hx⟩ := (hfg_a (z - σ y)).mp hker
      refine ⟨(x, y), ?_⟩
      change f_a x + σ y = z
      rw [hx, sub_add_cancel]
    have : Module.Free R_a (F₁ × F_Q) := Module.Free.prod R_a F₁ F_Q
    exact Module.Free.of_equiv (LinearEquiv.ofBijective Θ ⟨hΘ_inj, hΘ_surj⟩)

  have hTowerCancel :
      ∀ (R R' L' R_a M M' : Type u)
        [CommRing R] [CommRing R'] [CommRing L'] [CommRing R_a]
        [Algebra R R'] [Algebra R R_a] [Algebra R' L']
        [AddCommGroup M] [Module R M] [AddCommGroup M'] [Module R' M']
        (ψ₁ : R' →+* R_a) (hψ₁ : ∀ r : R, ψ₁ (algebraMap R R' r) = algebraMap R R_a r)
        (ψ₂ : L' →+* R_a) (hψ₂ : ∀ r' : R', ψ₂ (algebraMap R' L' r') = ψ₁ r')
        (e : TensorProduct R R' M ≃ₗ[R'] M')
        [Module.Free L' (TensorProduct R' L' M')],
        Module.Free R_a (TensorProduct R R_a M) := by
    intro R R' L' R_a M M' _ _ _ _ _ _ _ _ _ _ _ ψ₁ hψ₁ ψ₂ hψ₂ e _
    let _ : Algebra R' R_a := ψ₁.toAlgebra
    let _ : Algebra L' R_a := ψ₂.toAlgebra
    have : IsScalarTower R R' R_a := IsScalarTower.of_algebraMap_eq fun r => (hψ₁ r).symm
    have : IsScalarTower R' L' R_a := IsScalarTower.of_algebraMap_eq fun r' => (hψ₂ r').symm
    have : Module.Free R_a (TensorProduct L' R_a (TensorProduct R' L' M')) := Module.Free.tensor
    let e₁ : TensorProduct L' R_a (TensorProduct R' L' M') ≃ₗ[R_a] TensorProduct R' R_a M' :=
      TensorProduct.AlgebraTensorModule.cancelBaseChange R' L' R_a R_a M'
    let e₂ : TensorProduct R' R_a M' ≃ₗ[R_a] TensorProduct R' R_a (TensorProduct R R' M) :=
      LinearEquiv.baseChange R' R_a M' (TensorProduct R R' M) e.symm
    let e₃ : TensorProduct R' R_a (TensorProduct R R' M) ≃ₗ[R_a] TensorProduct R R_a M :=
      TensorProduct.AlgebraTensorModule.cancelBaseChange R R' R_a R_a M
    exact Module.Free.of_equiv ((e₁.trans e₂).trans e₃)

  have hFreeAwayTrans :
      ∀ {R M : Type u} [CommRing R] [IsDomain R] [AddCommGroup M] [Module R M]
        (a₀ : R) (ha₀ : a₀ ≠ 0)
        (M' : Type u) [AddCommGroup M'] [Module (Localization.Away a₀) M']
        (e : TensorProduct R (Localization.Away a₀) M ≃ₗ[Localization.Away a₀] M')
        (a' : Localization.Away a₀) (ha' : a' ≠ 0),
        Module.Free (Localization.Away a')
          (TensorProduct (Localization.Away a₀) (Localization.Away a') M') →
        ∃ a : R, a ≠ 0 ∧
          Module.Free (Localization.Away a) (TensorProduct R (Localization.Away a) M) := by
    intro R M _ _ _ _ a₀ ha₀ M' _ _ e a' ha' _
    obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.surj (Submonoid.powers a₀) a'
    dsimp only at hcs
    obtain ⟨k, hk⟩ := s.2
    have hs_unit : IsUnit (algebraMap R (Localization.Away a₀) (s : R)) := by
      rw [← hk, map_pow]
      exact (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away a₀) a₀).pow k
    have hc_ne : c ≠ 0 := by
      intro hc0
      rw [hc0, map_zero] at hcs
      exact ha' (hs_unit.mul_left_eq_zero.mp hcs)
    let a : R := a₀ * c
    have ha_ne : a ≠ 0 := mul_ne_zero ha₀ hc_ne
    have hu_ac : IsUnit (algebraMap R (Localization.Away a) a₀ * algebraMap R (Localization.Away a) c) := by
      rw [← map_mul]
      exact IsLocalization.Away.algebraMap_isUnit (S := Localization.Away a) a
    have hu₀ : IsUnit (algebraMap R (Localization.Away a) a₀) := isUnit_of_mul_isUnit_left hu_ac
    have huc : IsUnit (algebraMap R (Localization.Away a) c) := isUnit_of_mul_isUnit_right hu_ac
    let ψ₁ : Localization.Away a₀ →+* Localization.Away a := IsLocalization.Away.lift a₀ hu₀
    have hψ₁_eq : ∀ r : R, ψ₁ (algebraMap R (Localization.Away a₀) r) = algebraMap R (Localization.Away a) r :=
      fun r => IsLocalization.Away.lift_eq a₀ hu₀ r
    have hu_prod : IsUnit (ψ₁ a' * ψ₁ (algebraMap R (Localization.Away a₀) (s : R))) := by
      rw [← map_mul, hcs, hψ₁_eq]
      exact huc
    have hu' : IsUnit (ψ₁ a') := isUnit_of_mul_isUnit_left hu_prod
    let ψ₂ : Localization.Away a' →+* Localization.Away a := IsLocalization.Away.lift a' hu'
    exact ⟨a, ha_ne, hTowerCancel R (Localization.Away a₀) (Localization.Away a')
      (Localization.Away a) M M' ψ₁ hψ₁_eq ψ₂ (fun r' => IsLocalization.Away.lift_eq a' hu' r') e⟩

  
  have hCyclicFiltration :
      ∀ (R P M : Type u) [CommRing R] [IsDomain R] [CommRing P] [Algebra R P]
        [AddCommGroup M] [Module R M] [Module P M] [IsScalarTower R P M] [Module.Finite P M],
        (∀ I : Ideal P, ∃ a : R, a ≠ 0 ∧
          Module.Free (Localization.Away a) (TensorProduct R (Localization.Away a) (P ⧸ I))) →
        ∃ a : R, a ≠ 0 ∧
          Module.Free (Localization.Away a) (TensorProduct R (Localization.Away a) M) := by
    intro R P M _ _ _ _ _ _ _ _ hFin hCyclic
    classical
    obtain ⟨S, hS⟩ := @Module.Finite.fg_top P M _ _ _ hFin
    have hSpan : ∀ s : Finset M,
        ∃ a : R, a ≠ 0 ∧
          Module.Free (Localization.Away a)
            (TensorProduct R (Localization.Away a) ↥(Submodule.span P (↑s : Set M))) := by
      intro s
      refine Finset.induction_on s ?_ ?_
      · refine ⟨1, one_ne_zero, ?_⟩
        let N₀ := Submodule.span P ((∅ : Finset M) : Set M)
        have hBot : N₀ = ⊥ := by simp [N₀]
        have : Subsingleton ↥N₀ := by
          rw [hBot]
          infer_instance
        have : Subsingleton (TensorProduct R (Localization.Away (1 : R)) ↥N₀) := by
          rw [subsingleton_iff_forall_eq 0]
          have hzero :
              (LinearMap.id : TensorProduct R (Localization.Away (1 : R)) ↥N₀ →ₗ[R] _) = 0 := by
            refine TensorProduct.ext' fun r x => ?_
            change r ⊗ₜ[R] x = 0
            rw [Subsingleton.elim x 0, TensorProduct.tmul_zero]
          exact fun z => LinearMap.congr_fun hzero z
        exact Module.Free.of_subsingleton _ _
      · intro x s _ ih
        obtain ⟨a₁, ha₁, hFree₁⟩ := ih
        let N₁ : Submodule P M := Submodule.span P (↑s : Set M)
        let N₂ : Submodule P M := Submodule.span P (↑(insert x s) : Set M)
        have h₁₂ : N₁ ≤ N₂ := Submodule.span_mono (Finset.coe_subset.mpr (Finset.subset_insert x s))
        let K : Submodule P ↥N₂ := N₁.comap N₂.subtype
        let Q := ↥N₂ ⧸ K
        let f : ↥N₁ →ₗ[R] ↥N₂ := (Submodule.inclusion h₁₂).restrictScalars R
        let g : ↥N₂ →ₗ[R] Q := K.mkQ.restrictScalars R
        have hf_inj : Function.Injective f := Submodule.inclusion_injective h₁₂
        have hg_surj : Function.Surjective g := Submodule.mkQ_surjective K
        have hfg_exact : Function.Exact f g := by
          intro u
          change K.mkQ u = 0 ↔ ∃ y : ↥N₁, Submodule.inclusion h₁₂ y = u
          rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
          constructor
          · intro hu
            exact ⟨⟨u.1, hu⟩, rfl⟩
          · rintro ⟨y, rfl⟩
            exact y.2
        let x_tilde : ↥N₂ :=
          ⟨x, Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_insert_self x s))⟩
        let x_bar : Q := K.mkQ x_tilde
        let π_x : P →ₗ[P] Q := LinearMap.toSpanSingleton P Q x_bar
        have hπ_surj : Function.Surjective π_x := by
          intro q
          obtain ⟨u, rfl⟩ := Submodule.mkQ_surjective K q
          have hu_mem : u.1 ∈ (P ∙ x) ⊔ N₁ := by
            have hEqSpan : N₂ = (P ∙ x) ⊔ N₁ := by
              dsimp [N₂, N₁]
              rw [Finset.coe_insert, Submodule.span_insert]
            rw [← hEqSpan]
            exact u.2
          obtain ⟨w, hw, y, hy, hwy⟩ := Submodule.mem_sup.mp hu_mem
          obtain ⟨p, rfl⟩ := Submodule.mem_span_singleton.mp hw
          refine ⟨p, ?_⟩
          have hu_eq : u = p • x_tilde + ⟨y, h₁₂ hy⟩ := by
            apply Subtype.ext
            exact hwy.symm
          rw [hu_eq, map_add, map_smul]
          have hyK : (⟨y, h₁₂ hy⟩ : ↥N₂) ∈ K := hy
          have hmk_y : K.mkQ ⟨y, h₁₂ hy⟩ = 0 :=
            (Submodule.Quotient.mk_eq_zero K).mpr hyK
          rw [hmk_y, add_zero]
          rfl
        let I : Ideal P := LinearMap.ker π_x
        let e_Q : (P ⧸ I) ≃ₗ[R] Q :=
          (LinearMap.quotKerEquivOfSurjective π_x hπ_surj).restrictScalars R
        obtain ⟨a₂, ha₂, hFreeI⟩ := hCyclic I
        have hFreeQ₂ : Module.Free (Localization.Away a₂)
            (TensorProduct R (Localization.Away a₂) Q) :=
          hFreeOfEquiv e_Q a₂ hFreeI
        let a : R := a₁ * a₂
        have ha_ne : a ≠ 0 := mul_ne_zero ha₁ ha₂
        have hFreeN₁_a : Module.Free (Localization.Away a)
            (TensorProduct R (Localization.Away a) ↥N₁) :=
          hFreeMulRight a₁ a₂ hFree₁
        have hFreeQ_a : Module.Free (Localization.Away a)
            (TensorProduct R (Localization.Away a) Q) := by
          have htmp := hFreeMulRight a₂ a₁ hFreeQ₂
          rwa [mul_comm a₂ a₁] at htmp
        exact ⟨a, ha_ne, hFreeShortExact f g hf_inj hg_surj hfg_exact a hFreeN₁_a hFreeQ_a⟩
    obtain ⟨a, ha, hFreeS⟩ := hSpan S
    rw [hS] at hFreeS
    exact ⟨a, ha, hFreeOfEquiv ((Submodule.topEquiv : ↥(⊤ : Submodule P M) ≃ₗ[P] M).restrictScalars R) a hFreeS⟩

  
  let E_fn : ℕ → ∀ n : ℕ, (Fin (n + 1) → ℕ) → ℕ :=
    fun D n f => f 0 + ∑ j : Fin n, f (Fin.succ j) * D ^ ((j : ℕ) + 1)

  have hBaseDInj :
      ∀ (D : ℕ), 0 < D → ∀ (n : ℕ) (f₁ f₂ : Fin (n + 1) → ℕ),
        (∀ i, f₁ i < D) → (∀ i, f₂ i < D) → E_fn D n f₁ = E_fn D n f₂ → f₁ = f₂ := by
    intro D hD n
    induction n with
    | zero =>
      intro f₁ f₂ _ _ hEq
      have h0 : f₁ 0 = f₂ 0 := by simpa [E_fn] using hEq
      funext i
      have hi0 : i = 0 := Fin.ext (Nat.lt_one_iff.mp i.2)
      rw [hi0]
      exact h0
    | succ n' ih =>
      intro f₁ f₂ hf₁ hf₂ hEq
      let f₁' : Fin (n' + 1) → ℕ := fun t => f₁ (Fin.succ t)
      let f₂' : Fin (n' + 1) → ℕ := fun t => f₂ (Fin.succ t)
      have hStep : ∀ f : Fin (n' + 2) → ℕ,
          E_fn D (n' + 1) f = f 0 + D * E_fn D n' (fun t => f (Fin.succ t)) := by
        intro f
        dsimp only [E_fn]
        rw [Fin.sum_univ_succ]
        have hSum :
            (∑ k : Fin n', f (Fin.succ (Fin.succ k)) * D ^ (((Fin.succ k : Fin (n' + 1)) : ℕ) + 1)) =
            D * ∑ k : Fin n', f (Fin.succ (Fin.succ k)) * D ^ ((k : ℕ) + 1) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [Fin.val_succ]
          ring
        rw [hSum]
        simp only [Fin.val_zero, zero_add, pow_one]
        ring
      rw [hStep f₁, hStep f₂] at hEq
      have hMod := congrArg (· % D) hEq
      rw [Nat.add_mul_mod_self_left, Nat.add_mul_mod_self_left,
        Nat.mod_eq_of_lt (hf₁ 0), Nat.mod_eq_of_lt (hf₂ 0)] at hMod
      have hMul : D * E_fn D n' f₁' = D * E_fn D n' f₂' := by
        change f₁ 0 + D * E_fn D n' f₁' = f₂ 0 + D * E_fn D n' f₂' at hEq
        rw [hMod] at hEq
        exact Nat.add_left_cancel hEq
      have hTail : f₁' = f₂' :=
        ih f₁' f₂' (fun t => hf₁ (Fin.succ t)) (fun t => hf₂ (Fin.succ t))
          (Nat.eq_of_mul_eq_mul_left hD hMul)
      funext i
      refine Fin.cases hMod (fun t => ?_) i
      exact congrFun hTail t

  let IsMonicOfDeg : ∀ {B : Type u} [CommRing B], Polynomial B → ℕ → Prop :=
    fun P N => P.coeff N = 1 ∧ ∀ k : ℕ, N < k → P.coeff k = 0

  have hNagataEquivMonic :
      ∀ (S : Type u) [CommRing S] (m D : ℕ), 0 < D →
        ∃ (e_D : MvPolynomial (Fin (m + 1)) S ≃ₐ[S] Polynomial (MvPolynomial (Fin m) S)),
          ∀ ν : Fin (m + 1) →₀ ℕ,
            IsMonicOfDeg (e_D (MvPolynomial.monomial ν 1)) (E_fn D m ν) := by
    intro S _ m D hD
    let P_S := MvPolynomial (Fin (m + 1)) S
    let B := MvPolynomial (Fin m) S
    let σ_pos : P_S →ₐ[S] P_S :=
      MvPolynomial.aeval (Fin.cases (MvPolynomial.X 0)
        (fun j : Fin m => MvPolynomial.X (Fin.succ j) + (MvPolynomial.X 0) ^ (D ^ ((j : ℕ) + 1))))
    let σ_neg : P_S →ₐ[S] P_S :=
      MvPolynomial.aeval (Fin.cases (MvPolynomial.X 0)
        (fun j : Fin m => MvPolynomial.X (Fin.succ j) - (MvPolynomial.X 0) ^ (D ^ ((j : ℕ) + 1))))
    have h_pos_neg : σ_pos.comp σ_neg = AlgHom.id S P_S := by
      apply MvPolynomial.algHom_ext
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · change σ_pos (σ_neg (MvPolynomial.X 0)) = MvPolynomial.X 0
        dsimp only [σ_pos, σ_neg]
        rw [MvPolynomial.aeval_X, Fin.cases_zero, MvPolynomial.aeval_X, Fin.cases_zero]
      · change σ_pos (σ_neg (MvPolynomial.X (Fin.succ j))) = MvPolynomial.X (Fin.succ j)
        dsimp only [σ_pos, σ_neg]
        rw [MvPolynomial.aeval_X, Fin.cases_succ, map_sub, map_pow,
          MvPolynomial.aeval_X, Fin.cases_succ, MvPolynomial.aeval_X, Fin.cases_zero,
          add_sub_cancel_right]
    have h_neg_pos : σ_neg.comp σ_pos = AlgHom.id S P_S := by
      apply MvPolynomial.algHom_ext
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · change σ_neg (σ_pos (MvPolynomial.X 0)) = MvPolynomial.X 0
        dsimp only [σ_pos, σ_neg]
        rw [MvPolynomial.aeval_X, Fin.cases_zero, MvPolynomial.aeval_X, Fin.cases_zero]
      · change σ_neg (σ_pos (MvPolynomial.X (Fin.succ j))) = MvPolynomial.X (Fin.succ j)
        dsimp only [σ_pos, σ_neg]
        rw [MvPolynomial.aeval_X, Fin.cases_succ, map_add, map_pow,
          MvPolynomial.aeval_X, Fin.cases_succ, MvPolynomial.aeval_X, Fin.cases_zero,
          sub_add_cancel]
    let σ : P_S ≃ₐ[S] P_S := AlgEquiv.ofAlgHom σ_pos σ_neg h_pos_neg h_neg_pos
    let e_D : P_S ≃ₐ[S] Polynomial B := σ.trans (MvPolynomial.finSuccEquiv S m)
    have he_zero : e_D (MvPolynomial.X 0) = Polynomial.X := by
      change (MvPolynomial.finSuccEquiv S m) (σ_pos (MvPolynomial.X 0)) = Polynomial.X
      dsimp only [σ_pos]
      rw [MvPolynomial.aeval_X, Fin.cases_zero, MvPolynomial.finSuccEquiv_X_zero]
    have he_succ : ∀ j : Fin m,
        e_D (MvPolynomial.X (Fin.succ j)) =
          Polynomial.C (MvPolynomial.X j) + Polynomial.X ^ (D ^ ((j : ℕ) + 1)) := by
      intro j
      change (MvPolynomial.finSuccEquiv S m) (σ_pos (MvPolynomial.X (Fin.succ j))) = _
      dsimp only [σ_pos]
      rw [MvPolynomial.aeval_X, Fin.cases_succ, map_add, map_pow,
        MvPolynomial.finSuccEquiv_X_succ, MvPolynomial.finSuccEquiv_X_zero]
    have hMonic_one : IsMonicOfDeg (1 : Polynomial B) 0 := by
      refine ⟨Polynomial.coeff_one_zero, fun k hk => ?_⟩
      rw [← Polynomial.C_1, Polynomial.coeff_C_of_ne_zero (Nat.ne_of_gt hk)]
    have hMonic_X : IsMonicOfDeg (Polynomial.X : Polynomial B) 1 := by
      refine ⟨Polynomial.coeff_X_one, fun k hk => ?_⟩
      simp [Polynomial.coeff_X, Nat.ne_of_lt hk]
    have hMonic_mul : ∀ {P Q : Polynomial B} {N M : ℕ},
        IsMonicOfDeg P N → IsMonicOfDeg Q M → IsMonicOfDeg (P * Q) (N + M) := by
      intro P Q N M ⟨hPN, hPdeg⟩ ⟨hQM, hQdeg⟩
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coeff_mul, Finset.sum_eq_single (N, M)]
        · rw [hPN, hQM, mul_one]
        · intro p hp hne
          have hp_sum : p.1 + p.2 = N + M := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
          have hgt : N < p.1 ∨ M < p.2 := by
            by_cases h1 : N < p.1
            · exact Or.inl h1
            · refine Or.inr ?_
              by_cases h2 : M < p.2
              · exact h2
              · exfalso
                apply hne
                ext <;> omega
          rcases hgt with h1 | h2
          · rw [hPdeg p.1 h1, zero_mul]
          · rw [hQdeg p.2 h2, mul_zero]
        · intro hnot
          exact False.elim (hnot (Finset.HasAntidiagonal.mem_antidiagonal.mpr rfl))
      · intro k hk
        rw [Polynomial.coeff_mul]
        refine Finset.sum_eq_zero fun p hp => ?_
        have hp_sum : p.1 + p.2 = k := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
        have hgt : N < p.1 ∨ M < p.2 := by omega
        rcases hgt with h1 | h2
        · rw [hPdeg p.1 h1, zero_mul]
        · rw [hQdeg p.2 h2, mul_zero]
    have hMonic_pow : ∀ (P : Polynomial B) (N a : ℕ),
        IsMonicOfDeg P N → IsMonicOfDeg (P ^ a) (a * N) := by
      intro P N a hP
      induction a with
      | zero => simpa using hMonic_one
      | succ a' ih =>
        rw [pow_succ, Nat.succ_mul]
        exact hMonic_mul ih hP
    have hMonic_C_add_X_pow : ∀ (b : B) (w : ℕ), 1 ≤ w →
        IsMonicOfDeg (Polynomial.C b + Polynomial.X ^ w) w := by
      intro b w hw
      have hXw : IsMonicOfDeg (Polynomial.X ^ w : Polynomial B) w := by
        simpa using hMonic_pow Polynomial.X 1 w hMonic_X
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coeff_add, Polynomial.coeff_C_of_ne_zero (by omega), zero_add, hXw.1]
      · intro k hk
        rw [Polynomial.coeff_add, Polynomial.coeff_C_of_ne_zero (by omega), zero_add, hXw.2 k hk]
    have hMonic_prod : ∀ {ι : Type} (s : Finset ι) (F : ι → Polynomial B) (w : ι → ℕ),
        (∀ j ∈ s, IsMonicOfDeg (F j) (w j)) →
        IsMonicOfDeg (∏ j ∈ s, F j) (∑ j ∈ s, w j) := by
      intro ι s F w
      classical
      refine Finset.induction_on s (fun _ => by simpa using hMonic_one) ?_
      intro j s' hj ih hF
      rw [Finset.prod_insert hj, Finset.sum_insert hj]
      exact hMonic_mul (hF j (Finset.mem_insert_self j s'))
        (ih (fun j' hj' => hF j' (Finset.mem_insert_of_mem hj')))
    refine ⟨e_D, fun ν => ?_⟩
    have hMonEq : (MvPolynomial.monomial ν (1 : S)) =
        ∏ i : Fin (m + 1), (MvPolynomial.X i : P_S) ^ (ν i) := by
      rw [MvPolynomial.monic_monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
    rw [hMonEq, map_prod, Fin.prod_univ_succ]
    simp only [map_pow, he_zero, he_succ]
    have h0 : IsMonicOfDeg ((Polynomial.X : Polynomial B) ^ (ν 0)) (ν 0) := by
      simpa using hMonic_pow Polynomial.X 1 (ν 0) hMonic_X
    have hRest : IsMonicOfDeg
        (∏ j : Fin m,
          (Polynomial.C (MvPolynomial.X j : B) + Polynomial.X ^ (D ^ ((j : ℕ) + 1))) ^ (ν (Fin.succ j)))
        (∑ j : Fin m, ν (Fin.succ j) * D ^ ((j : ℕ) + 1)) := by
      refine hMonic_prod Finset.univ _ _ fun j _ => ?_
      exact hMonic_pow _ (D ^ ((j : ℕ) + 1)) (ν (Fin.succ j))
        (hMonic_C_add_X_pow _ _ (Nat.one_le_pow _ D hD))
    exact hMonic_mul h0 hRest

  have hMvQuotTensorEquiv :
      ∀ (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (n : ℕ)
        (I : Ideal (MvPolynomial (Fin n) R)),
        Nonempty (TensorProduct R R' (MvPolynomial (Fin n) R ⧸ I) ≃ₐ[R']
          (MvPolynomial (Fin n) R' ⧸ Ideal.map (MvPolynomial.map (algebraMap R R')) I)) := by
    intro R R' _ _ _ n I
    let φ := algebraMap R R'
    let I' : Ideal (MvPolynomial (Fin n) R') := Ideal.map (MvPolynomial.map φ) I
    have hMapI : I ≤ Ideal.comap ((Ideal.Quotient.mk I').comp (MvPolynomial.map φ)) ⊥ := by
      intro P hP
      rw [Ideal.mem_comap, RingHom.comp_apply, Ideal.mem_bot]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem (MvPolynomial.map φ) hP)
    let β_ring : (MvPolynomial (Fin n) R ⧸ I) →+* (MvPolynomial (Fin n) R' ⧸ I') :=
      Ideal.Quotient.lift I ((Ideal.Quotient.mk I').comp (MvPolynomial.map φ)) (fun P hP => by
        simpa [Ideal.mem_comap, Ideal.mem_bot] using hMapI hP)
    let β : (MvPolynomial (Fin n) R ⧸ I) →ₐ[R] (MvPolynomial (Fin n) R' ⧸ I') :=
      { β_ring with
        commutes' := fun r => by
          change Ideal.Quotient.mk I' (MvPolynomial.map φ (MvPolynomial.C r)) =
            Ideal.Quotient.mk I' (MvPolynomial.C (φ r))
          rw [MvPolynomial.map_C] }
    let Φ : TensorProduct R R' (MvPolynomial (Fin n) R ⧸ I) →ₐ[R'] (MvPolynomial (Fin n) R' ⧸ I') :=
      Algebra.TensorProduct.lift (Algebra.ofId R' _) β (fun _ _ => Commute.all _ _)
    have hΦ_tmul : ∀ (r' : R') (q : MvPolynomial (Fin n) R ⧸ I),
        Φ (r' ⊗ₜ[R] q) = algebraMap R' _ r' * β q :=
      fun r' q => Algebra.TensorProduct.lift_tmul (Algebra.ofId R' _) β (fun _ _ => Commute.all _ _) r' q
    let incR : (MvPolynomial (Fin n) R ⧸ I) →ₐ[R] TensorProduct R R' (MvPolynomial (Fin n) R ⧸ I) :=
      Algebra.TensorProduct.includeRight
    let η₀ : MvPolynomial (Fin n) R' →ₐ[R'] TensorProduct R R' (MvPolynomial (Fin n) R ⧸ I) :=
      MvPolynomial.aeval (fun j => incR (Ideal.Quotient.mk I (MvPolynomial.X j)))
    have hη₀_map : ∀ P : MvPolynomial (Fin n) R,
        η₀ (MvPolynomial.map φ P) = incR (Ideal.Quotient.mk I P) := by
      intro P
      induction P using MvPolynomial.induction_on with
      | C r =>
        rw [MvPolynomial.map_C, MvPolynomial.aeval_C]
        change φ r ⊗ₜ[R] (1 : MvPolynomial (Fin n) R ⧸ I) =
          1 ⊗ₜ[R] Ideal.Quotient.mk I (MvPolynomial.C r)
        have hr : φ r = r • (1 : R') :=
          (Algebra.smul_def r (1 : R')).trans (mul_one _) |>.symm
        rw [hr, TensorProduct.smul_tmul]
        congr 1
        rw [← Algebra.algebraMap_eq_smul_one]
        rfl
      | add p q ihp ihq => simp only [map_add, ihp, ihq]
      | mul_X p j ihp =>
        rw [map_mul, MvPolynomial.map_X, map_mul, ihp, MvPolynomial.aeval_X, ← map_mul, ← map_mul]
    have hker : I' ≤ RingHom.ker η₀.toRingHom := by
      refine Ideal.map_le_iff_le_comap.mpr fun Q hQ => ?_
      rw [Ideal.mem_comap, RingHom.mem_ker]
      change η₀ (MvPolynomial.map φ Q) = 0
      rw [hη₀_map Q, Ideal.Quotient.eq_zero_iff_mem.mpr hQ, map_zero]
    let Ψ : (MvPolynomial (Fin n) R' ⧸ I') →ₐ[R'] TensorProduct R R' (MvPolynomial (Fin n) R ⧸ I) :=
      Ideal.Quotient.liftₐ I' η₀ (fun P hP => hker hP)
    have hΦΨ : Φ.comp Ψ = AlgHom.id R' _ := by
      apply AlgHom.coe_ringHom_injective
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r'
        change Φ (η₀ (MvPolynomial.C r')) = Ideal.Quotient.mk I' (MvPolynomial.C r')
        rw [MvPolynomial.aeval_C, Φ.commutes]
        rfl
      · intro j
        change Φ (η₀ (MvPolynomial.X j)) = Ideal.Quotient.mk I' (MvPolynomial.X j)
        rw [MvPolynomial.aeval_X]
        change Φ (1 ⊗ₜ[R] Ideal.Quotient.mk I (MvPolynomial.X j)) = _
        rw [hΦ_tmul, map_one, one_mul]
        change Ideal.Quotient.mk I' (MvPolynomial.map φ (MvPolynomial.X j)) = _
        rw [MvPolynomial.map_X]
    have hΨΦ : Ψ.comp Φ = AlgHom.id R' _ := by
      have hlin :
          (Ψ.comp Φ).toLinearMap.restrictScalars R = LinearMap.id := by
        refine TensorProduct.ext' fun r' q => ?_
        change Ψ (Φ (r' ⊗ₜ[R] q)) = r' ⊗ₜ[R] q
        have htmul : (r' ⊗ₜ[R] q : TensorProduct R R' (MvPolynomial (Fin n) R ⧸ I)) =
            r' • (1 ⊗ₜ[R] q) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [htmul, map_smul, map_smul]
        congr 1
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q
        rw [hΦ_tmul, map_one, one_mul]
        change η₀ (MvPolynomial.map φ P) = 1 ⊗ₜ[R] Ideal.Quotient.mk I P
        exact hη₀_map P
      apply AlgHom.ext
      intro z
      exact LinearMap.congr_fun hlin z
    exact ⟨AlgEquiv.ofAlgHom Φ Ψ hΦΨ hΨΦ⟩

  have hMonicQuotStep :
      ∀ (R' : Type u) [CommRing R'] (m' : ℕ)
        (I' : Ideal (MvPolynomial (Fin (m' + 1)) R'))
        (g₁ : MvPolynomial (Fin (m' + 1)) R') (hg₁ : g₁ ∈ I')
        (e_D : MvPolynomial (Fin (m' + 1)) R' ≃ₐ[R'] Polynomial (MvPolynomial (Fin m') R'))
        (hMonic : (e_D g₁).Monic)
        (ih_R' : ∀ (M' : Type u) [AddCommGroup M'] [Module R' M']
          [Module (MvPolynomial (Fin m') R') M']
          [IsScalarTower R' (MvPolynomial (Fin m') R') M']
          [Module.Finite (MvPolynomial (Fin m') R') M'],
          ∃ a' : R', a' ≠ 0 ∧
            Module.Free (Localization.Away a') (TensorProduct R' (Localization.Away a') M')),
        ∃ a' : R', a' ≠ 0 ∧
          Module.Free (Localization.Away a')
            (TensorProduct R' (Localization.Away a') (MvPolynomial (Fin (m' + 1)) R' ⧸ I')) := by
    intro R' _ m' I' g₁ hg₁ e_D hMonic ih_R'
    let J' : Ideal (Polynomial (MvPolynomial (Fin m') R')) := Ideal.map e_D.toRingHom I'
    let e_quot :
        (MvPolynomial (Fin (m' + 1)) R' ⧸ I') ≃ₐ[R']
          (Polynomial (MvPolynomial (Fin m') R') ⧸ J') :=
      Ideal.quotientEquivAlg I' J' e_D rfl
    let H : Polynomial (MvPolynomial (Fin m') R') := e_D g₁
    have hH_mem : H ∈ J' := Ideal.mem_map_of_mem e_D.toRingHom hg₁
    have : Module.Finite (MvPolynomial (Fin m') R')
        (Polynomial (MvPolynomial (Fin m') R') ⧸ Ideal.span {H}) :=
      hMonic.finite_quotient
    have hSpanLe : Ideal.span ({H} : Set (Polynomial (MvPolynomial (Fin m') R'))) ≤ J' :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hH_mem)
    have : Module.Finite (MvPolynomial (Fin m') R')
        (Polynomial (MvPolynomial (Fin m') R') ⧸ J') :=
      Module.Finite.of_surjective
        (Ideal.Quotient.factorₐ (MvPolynomial (Fin m') R') hSpanLe).toLinearMap
        (Ideal.Quotient.factor_surjective hSpanLe)
    obtain ⟨a', ha', hFree'⟩ := ih_R' (Polynomial (MvPolynomial (Fin m') R') ⧸ J')
    exact ⟨a', ha', hFreeOfEquiv e_quot.toLinearEquiv.symm a' hFree'⟩

  
  have hMainInd :
      ∀ (m : ℕ) (R : Type u) [CommRing R] [IsDomain R]
        (M : Type u) [AddCommGroup M] [Module R M]
        [Module (MvPolynomial (Fin m) R) M]
        [IsScalarTower R (MvPolynomial (Fin m) R) M]
        [Module.Finite (MvPolynomial (Fin m) R) M],
        ∃ a : R, a ≠ 0 ∧
          Module.Free (Localization.Away a) (TensorProduct R (Localization.Away a) M) := by
    intro m
    induction m with
    | zero =>
      intro R _ _ M _ _ _ _ _
      refine hCyclicFiltration R (MvPolynomial (Fin 0) R) M fun I => ?_
      let P := MvPolynomial (Fin 0) R
      by_cases hI : I = ⊥
      · refine ⟨1, one_ne_zero, ?_⟩
        let e_bot : (P ⧸ I) ≃ₗ[R] P := (Submodule.quotEquivOfEqBot I hI).restrictScalars R
        have : Module.Free R (P ⧸ I) := Module.Free.of_equiv e_bot.symm
        exact Module.Free.tensor
      · have hex : ∃ g ∈ I, g ≠ 0 := by
          by_contra! h
          exact hI ((Submodule.eq_bot_iff I).mpr h)
        obtain ⟨g, hgI, hg0⟩ := hex
        let e₀ : P ≃ₐ[R] R := MvPolynomial.isEmptyAlgEquiv R (Fin 0)
        let a : R := e₀ g
        have ha : a ≠ 0 := (map_ne_zero_iff e₀ e₀.injective).mpr hg0
        have hCa_eq : MvPolynomial.C a = g := by
          apply e₀.injective
          change e₀ (algebraMap R P a) = a
          exact e₀.commutes a
        have hCa_mem : MvPolynomial.C a ∈ I := by
          rw [hCa_eq]
          exact hgI
        have hAnn : ∀ z : P ⧸ I, a • z = 0 := by
          intro z
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
          have hsmul : a • Ideal.Quotient.mk I p =
              Ideal.Quotient.mk I (MvPolynomial.C a) * Ideal.Quotient.mk I p := by
            rw [← map_mul]
            change Ideal.Quotient.mk I (a • p) = Ideal.Quotient.mk I (MvPolynomial.C a * p)
            rw [Algebra.smul_def]
            rfl
          rw [hsmul, Ideal.Quotient.eq_zero_iff_mem.mpr hCa_mem, zero_mul]
        refine ⟨a, ha, ?_⟩
        let u := (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away a) a).unit
        have : Subsingleton (TensorProduct R (Localization.Away a) (P ⧸ I)) := by
          rw [subsingleton_iff_forall_eq 0]
          have hzero :
              (LinearMap.id : TensorProduct R (Localization.Away a) (P ⧸ I) →ₗ[R] _) = 0 := by
            refine TensorProduct.ext' fun r z => ?_
            change r ⊗ₜ[R] z = 0
            have hr : r = a • (r * ↑u⁻¹) := by
              rw [Algebra.smul_def, mul_comm (algebraMap R _ a), mul_assoc]
              change r = r * ((u⁻¹ : (Localization.Away a)ˣ) * (u : Localization.Away a))
              rw [Units.inv_mul, mul_one]
            rw [hr, TensorProduct.smul_tmul, hAnn z, TensorProduct.tmul_zero]
          exact fun t => LinearMap.congr_fun hzero t
        exact Module.Free.of_subsingleton _ _
    | succ m' ih =>
      intro R _ _ M _ _ _ _ _
      refine hCyclicFiltration R (MvPolynomial (Fin (m' + 1)) R) M fun I => ?_
      let P := MvPolynomial (Fin (m' + 1)) R
      by_cases hI : I = ⊥
      · refine ⟨1, one_ne_zero, ?_⟩
        let e_bot : (P ⧸ I) ≃ₗ[R] P := (Submodule.quotEquivOfEqBot I hI).restrictScalars R
        have : Module.Free R (P ⧸ I) := Module.Free.of_equiv e_bot.symm
        exact Module.Free.tensor
      · have hex : ∃ g ∈ I, g ≠ 0 := by
          by_contra! h
          exact hI ((Submodule.eq_bot_iff I).mpr h)
        obtain ⟨g, hgI, hg0⟩ := hex
        let D : ℕ := g.totalDegree + 1
        have hD : 0 < D := Nat.succ_pos _
        obtain ⟨ν_max, hν_mem, hν_max⟩ :=
          Finset.exists_max_image g.support (fun ν => E_fn D m' ν)
            (MvPolynomial.support_nonempty.mpr hg0)
        have hν_lt_D : ∀ ν ∈ g.support, ∀ i : Fin (m' + 1), ν i < D := by
          intro ν hν i
          have hsum : ∑ j : Fin (m' + 1), ν j ≤ g.totalDegree := by
            have h1 := MvPolynomial.le_totalDegree hν
            rwa [Finsupp.sum_fintype _ _ (fun _ => rfl)] at h1
          exact Nat.lt_succ_of_le
            (le_trans (Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)) hsum)
        have hν_strict : ∀ ν ∈ g.support, ν ≠ ν_max → E_fn D m' ν < E_fn D m' ν_max := by
          intro ν hν hne
          refine lt_of_le_of_ne (hν_max ν hν) fun hEq => hne ?_
          have hfn := hBaseDInj D hD m' ν ν_max (hν_lt_D ν hν) (hν_lt_D ν_max hν_mem) hEq
          ext i
          exact congrFun hfn i
        let d : ℕ := E_fn D m' ν_max
        let a₀ : R := g.coeff ν_max
        have ha₀ : a₀ ≠ 0 := MvPolynomial.mem_support_iff.mp hν_mem
        have : IsDomain (Localization.Away a₀) :=
          IsLocalization.isDomain_localization
            (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero ha₀))
        let φ := algebraMap R (Localization.Away a₀)
        let I' : Ideal (MvPolynomial (Fin (m' + 1)) (Localization.Away a₀)) :=
          Ideal.map (MvPolynomial.map φ) I
        obtain ⟨e_tens⟩ := hMvQuotTensorEquiv R (Localization.Away a₀) (m' + 1) I
        obtain ⟨e_D, he_D⟩ := hNagataEquivMonic (Localization.Away a₀) m' D hD
        let u := (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away a₀) a₀).unit
        let g₁ : MvPolynomial (Fin (m' + 1)) (Localization.Away a₀) :=
          MvPolynomial.C (↑u⁻¹ : Localization.Away a₀) * MvPolynomial.map φ g
        have hg₁_mem : g₁ ∈ I' :=
          Ideal.mul_mem_left I' _ (Ideal.mem_map_of_mem (MvPolynomial.map φ) hgI)
        let H : Polynomial (MvPolynomial (Fin m') (Localization.Away a₀)) := e_D g₁
        have hH_sum : H = ∑ ν ∈ g.support,
            Polynomial.C (MvPolynomial.C ((↑u⁻¹ : Localization.Away a₀) * φ (g.coeff ν))) *
              e_D (MvPolynomial.monomial ν 1) := by
          have hg_sum : g = ∑ ν ∈ g.support, MvPolynomial.C (g.coeff ν) * MvPolynomial.monomial ν 1 := by
            conv_lhs => rw [MvPolynomial.as_sum g]
            refine Finset.sum_congr rfl fun ν _ => ?_
            rw [MvPolynomial.C_mul_monomial, mul_one]
          have hg₁_sum : g₁ = ∑ ν ∈ g.support,
              MvPolynomial.C ((↑u⁻¹ : Localization.Away a₀) * φ (g.coeff ν)) * MvPolynomial.monomial ν 1 := by
            dsimp only [g₁]
            conv_lhs => rw [hg_sum]
            rw [map_sum, Finset.mul_sum]
            refine Finset.sum_congr rfl fun ν _ => ?_
            rw [map_mul, MvPolynomial.map_C, MvPolynomial.map_monomial, map_one,
              ← mul_assoc, ← MvPolynomial.C_mul]
          dsimp only [H]
          rw [hg₁_sum, map_sum]
          refine Finset.sum_congr rfl fun ν _ => ?_
          rw [map_mul]
          congr 1
          exact e_D.commutes ((↑u⁻¹ : Localization.Away a₀) * φ (g.coeff ν))
        have hH_deg : ∀ k : ℕ, d < k → H.coeff k = 0 := by
          intro k hk
          rw [hH_sum, Polynomial.finsetSum_coeff]
          refine Finset.sum_eq_zero fun ν hν => ?_
          rw [Polynomial.coeff_C_mul, (he_D ν).2 k (lt_of_le_of_lt (hν_max ν hν) hk), mul_zero]
        have hH_lead : H.coeff d = 1 := by
          rw [hH_sum, Polynomial.finsetSum_coeff, Finset.sum_eq_single ν_max]
          · rw [Polynomial.coeff_C_mul, (he_D ν_max).1, mul_one]
            have hu_inv : (↑u⁻¹ : Localization.Away a₀) * φ a₀ = 1 := Units.inv_mul u
            rw [hu_inv, map_one]
          · intro ν hν hne
            rw [Polynomial.coeff_C_mul, (he_D ν).2 d (hν_strict ν hν hne), mul_zero]
          · intro hnot
            exact False.elim (hnot hν_mem)
        have hH_monic : H.Monic := by
          refine Polynomial.monic_of_natDegree_le_of_coeff_eq_one d ?_ hH_lead
          exact Polynomial.natDegree_le_iff_coeff_eq_zero.mpr hH_deg
        obtain ⟨a', ha', hFreeI'⟩ :=
          hMonicQuotStep (Localization.Away a₀) m' I' g₁ hg₁_mem e_D hH_monic
            (fun M' _ _ _ _ _ => ih (Localization.Away a₀) M')
        exact hFreeAwayTrans a₀ ha₀
          (MvPolynomial (Fin (m' + 1)) (Localization.Away a₀) ⧸ I')
          e_tens.toLinearEquiv a' ha' hFreeI'

  
  obtain ⟨m, Φ, hΦ_surj⟩ := (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := A) (S := C)).mp inferInstance
  let P := MvPolynomial (Fin m) A
  let I_C : Ideal P := RingHom.ker Φ.toRingHom
  let Q_C := P ⧸ I_C
  have : Module.Finite P Q_C :=
    Module.Finite.of_surjective
      (Ideal.Quotient.mkₐ P I_C).toLinearMap
      Ideal.Quotient.mk_surjective
  obtain ⟨a, ha, hFreeQ⟩ := hMainInd m A Q_C
  let e_C : Q_C ≃ₗ[A] C := (Ideal.quotientKerAlgEquivOfSurjective hΦ_surj).toLinearEquiv
  have : Module.Free (Localization.Away a) (TensorProduct A (Localization.Away a) C) :=
    hFreeOfEquiv e_C a hFreeQ
  exact ⟨a, ha, Module.Free.of_equiv (LocalizedModule.equivTensorProduct (Submonoid.powers a) C).symm⟩

theorem weil_scheme_isIntegral_of_flat_over_domain_to_field (R K : Type u) [CommRing R] [Field K]
    (φ : R →+* K) (hInj : Function.Injective φ)
    (X X_K : AlgebraicGeometry.Scheme.{u})
    (g : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hFlat : AlgebraicGeometry.Flat g)
    (p_K : X_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (ι_K : X_K ⟶ X)
    (hPb : CategoryTheory.IsPullback ι_K p_K g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)))
    (hIntK : AlgebraicGeometry.IsIntegral X_K) :
    AlgebraicGeometry.IsIntegral X :=
by
  have : AlgebraicGeometry.Flat g := hFlat
  have : AlgebraicGeometry.IsIntegral X_K := hIntK
  let : Algebra R K := φ.toAlgebra
  have hAff : ∀ (U : X.Opens), AlgebraicGeometry.IsAffineOpen U →
      (Nontrivial ↑(X.presheaf.obj (Opposite.op U)) →
        Nonempty ↥((TopologicalSpace.Opens.map ι_K.base).obj U)) ∧
      IsReduced ↑(X.presheaf.obj (Opposite.op U)) := by
    intro U hU
    let B : CommRingCat.{u} := X.presheaf.obj (Opposite.op U)
    let B₀ : Type u := ↑B
    let α : CommRingCat.of R ⟶ B := AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g)
    have hSpecα : AlgebraicGeometry.Spec.map α = hU.fromSpec ≫ g :=
      AlgebraicGeometry.Spec.map_preimage (hU.fromSpec ≫ g)
    have : AlgebraicGeometry.IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
    have hFlatComp : AlgebraicGeometry.Flat (hU.fromSpec ≫ g) := inferInstance
    have hFlatSpec : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map α) := by
      rw [hSpecα]
      exact hFlatComp
    let : Algebra R B₀ := α.hom.toAlgebra
    have hFlatHom : (algebraMap R B₀).Flat :=
      (@AlgebraicGeometry.HasRingHomProperty.Spec_iff (@AlgebraicGeometry.Flat) _ _ _ _ α).mp
        hFlatSpec
    have : Module.Flat R B₀ := (RingHom.flat_algebraMap_iff (R := R) (S := B₀)).mp hFlatHom
    let inc : B₀ →+* TensorProduct R B₀ K := Algebra.TensorProduct.includeLeftRingHom
    have hInj_U : Function.Injective inc :=
      @Algebra.TensorProduct.includeLeft_injective R R B₀ K _ _ _ _ _ _ _ _ _ hInj
    let U_K : X_K.Opens := (TopologicalSpace.Opens.map ι_K.base).obj U
    have hPb_U : CategoryTheory.IsPullback (ι_K ∣_ U) (U_K.ι ≫ p_K) (U.ι ≫ g)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) :=
      (AlgebraicGeometry.isPullback_morphismRestrict ι_K U).paste_vert hPb
    have hSq3 : (U.ι ≫ g) ≫ (CategoryTheory.Iso.refl _).hom =
        hU.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B₀)) := by
      change (U.ι ≫ g) ≫ 𝟙 _ = hU.isoSpec.hom ≫ AlgebraicGeometry.Spec.map α
      rw [CategoryTheory.Category.comp_id, hSpecα, ← hU.isoSpec_inv_ι,
        CategoryTheory.Category.assoc, hU.isoSpec.hom_inv_id_assoc]
    have hPbSpec_U : CategoryTheory.IsPullback ((ι_K ∣_ U) ≫ hU.isoSpec.hom) (U_K.ι ≫ p_K)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B₀)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) :=
      hPb_U.of_iso (CategoryTheory.Iso.refl U_K.toScheme) hU.isoSpec
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (CategoryTheory.Category.id_comp _).symm
        ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
        hSq3
        ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
    let e_U : U_K.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R B₀ K)) :=
      hPbSpec_U.isoPullback ≪≫ AlgebraicGeometry.pullbackSpecIso R B₀ K
    let ρ_U : TensorProduct R B₀ K ≃+* ↑(X_K.presheaf.obj (Opposite.op U_K)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (TensorProduct R B₀ K))).symm ≪≫
        AlgebraicGeometry.Scheme.Γ.mapIso e_U.op ≪≫ U_K.topIso).commRingCatIsoToRingEquiv
    have hNonempty_U : Nontrivial B₀ → Nonempty ↥(U_K : Set ↥X_K) := by
      intro hNontriv
      have : Nontrivial B₀ := hNontriv
      have : Nontrivial (TensorProduct R B₀ K) :=
        ⟨⟨inc 0, inc 1, fun h => zero_ne_one (hInj_U h)⟩⟩
      obtain ⟨q_spec⟩ :=
        (inferInstance : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R B₀ K))))
      exact ⟨e_U.inv.base q_spec⟩
    refine ⟨hNonempty_U, ?_⟩
    rcases subsingleton_or_nontrivial B₀ with hSub | hNontriv
    · have : Subsingleton B₀ := hSub
      exact inferInstance
    · have hNeUK : Nonempty ↥(U_K : Set ↥X_K) := hNonempty_U hNontriv
      have : IsDomain ↑(X_K.presheaf.obj (Opposite.op U_K)) :=
        @AlgebraicGeometry.IsIntegral.component_integral X_K hIntK U_K hNeUK
      have : IsDomain (TensorProduct R B₀ K) :=
        Function.Injective.isDomain ρ_U.toRingHom ρ_U.injective
      have : IsDomain B₀ := Function.Injective.isDomain inc hInj_U
      exact inferInstance
  let 𝒰 := X.affineCover
  have : ∀ i : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X i) := by
    intro i
    let U_i : X.Opens := AlgebraicGeometry.Scheme.Hom.opensRange (𝒰.f i)
    have hU_i : AlgebraicGeometry.IsAffineOpen U_i :=
      AlgebraicGeometry.isAffineOpen_opensRange (𝒰.f i)
    have : IsReduced ↑(X.presheaf.obj (Opposite.op U_i)) := (hAff U_i hU_i).2
    let σ_i : ↑((𝒰.X i).presheaf.obj (Opposite.op ⊤)) ≃+* ↑(X.presheaf.obj (Opposite.op U_i)) :=
      (AlgebraicGeometry.Scheme.Γ.mapIso
          (AlgebraicGeometry.Scheme.Hom.isoOpensRange (𝒰.f i)).symm.op ≪≫
        U_i.topIso).commRingCatIsoToRingEquiv
    have : IsReduced ↑((𝒰.X i).presheaf.obj (Opposite.op ⊤)) :=
      isReduced_of_injective σ_i σ_i.injective
    exact AlgebraicGeometry.isReduced_of_isAffine_isReduced (𝒰.X i)
  have : AlgebraicGeometry.IsReduced X := AlgebraicGeometry.IsReduced.of_openCover X 𝒰
  have : IrreducibleSpace ↥X_K := AlgebraicGeometry.irreducibleSpace_of_isIntegral X_K
  obtain ⟨x_K⟩ := IrreducibleSpace.toNonempty (X := ↥X_K)
  have hNeX : Nonempty ↥X := ⟨ι_K.base x_K⟩
  have : PreirreducibleSpace ↥X :=
    { isPreirreducible_univ := by
        intro W₁ W₂ hOpen₁ hOpen₂ h₁ h₂
        obtain ⟨x₁, _, hx₁⟩ := h₁
        obtain ⟨x₂, _, hx₂⟩ := h₂
        let O₁ : X.Opens := ⟨W₁, hOpen₁⟩
        let O₂ : X.Opens := ⟨W₂, hOpen₂⟩
        obtain ⟨U₁, hU₁, hxU₁, hSub₁⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := O₁) hx₁
        obtain ⟨U₂, hU₂, hxU₂, hSub₂⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := O₂) hx₂
        have hNontriv₁ : Nontrivial ↑(X.presheaf.obj (Opposite.op U₁)) :=
          @AlgebraicGeometry.Scheme.component_nontrivial X U₁ ⟨⟨x₁, hxU₁⟩⟩
        have hNontriv₂ : Nontrivial ↑(X.presheaf.obj (Opposite.op U₂)) :=
          @AlgebraicGeometry.Scheme.component_nontrivial X U₂ ⟨⟨x₂, hxU₂⟩⟩
        obtain ⟨⟨y₁, hy₁⟩⟩ := (hAff U₁ hU₁).1 hNontriv₁
        obtain ⟨⟨y₂, hy₂⟩⟩ := (hAff U₂ hU₂).1 hNontriv₂
        have hOpenV₁ : IsOpen (ι_K.base ⁻¹' W₁) := hOpen₁.preimage ι_K.base.hom.continuous_toFun
        have hOpenV₂ : IsOpen (ι_K.base ⁻¹' W₂) := hOpen₂.preimage ι_K.base.hom.continuous_toFun
        have hNeV₁ : (ι_K.base ⁻¹' W₁).Nonempty := ⟨y₁, hSub₁ hy₁⟩
        have hNeV₂ : (ι_K.base ⁻¹' W₂).Nonempty := ⟨y₂, hSub₂ hy₂⟩
        obtain ⟨z, hz₁, hz₂⟩ := nonempty_preirreducible_inter hOpenV₁ hOpenV₂ hNeV₁ hNeV₂
        exact ⟨ι_K.base z, trivial, hz₁, hz₂⟩ }
  have : IrreducibleSpace ↥X := { toNonempty := hNeX }
  exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced X

theorem weil_valuationSubring_spreadOut_flat_and_integral (k : Type u) [Field k]
    (K : Type u) [Field K] [Algebra k K]
    (V : ValuationSubring K)
    (hkV : ∀ c : k, algebraMap k K c ∈ V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (C_V : AlgebraicGeometry.Scheme.{u})
    (g_V : C_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hFlatV : AlgebraicGeometry.Flat g_V)
    (ι_gen : C_K ⟶ C_V)
    (hPbV : CategoryTheory.IsPullback ι_gen p_K g_V
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (F₁ : Finset K)
    (hF₁ : ∀ x ∈ F₁, x ∈ V)
    (ι₁_FV : ↥(Algebra.adjoin k (↑F₁ : Set K)) →+* ↥V)
    (hι₁ : V.subtype.comp ι₁_FV = (Algebra.adjoin k (↑F₁ : Set K)).val.toRingHom)
    (C₁ : AlgebraicGeometry.Scheme.{u})
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec
      (CommRingCat.of ↥(Algebra.adjoin k (↑F₁ : Set K))))
    (hQC₁ : AlgebraicGeometry.QuasiCompact g₁)
    (hLFP₁ : AlgebraicGeometry.LocallyOfFinitePresentation g₁)
    (ι₁_V : C_V ⟶ C₁)
    (hPb₁ : CategoryTheory.IsPullback ι₁_V g_V g₁
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁_FV))) :
    ∃ (F₂ : Finset K) (hSub₁₂ : F₁ ⊆ F₂),
      (∀ x ∈ F₂, x ∈ V) ∧
      AlgebraicGeometry.Flat
        (CategoryTheory.Limits.pullback.snd g₁
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Subalgebra.inclusion
              (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub₁₂))).toRingHom))) ∧
      AlgebraicGeometry.IsIntegral
        (CategoryTheory.Limits.pullback g₁
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Subalgebra.inclusion
              (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub₁₂))).toRingHom))) :=
by
  letI : DecidableEq K := Classical.decEq K
  let R₁ := ↥(Algebra.adjoin k (↑F₁ : Set K))

  have hMemAdjoin : ∀ (F : Finset K), (∀ x ∈ F, x ∈ V) →
      ∀ z ∈ Algebra.adjoin k (↑F : Set K), z ∈ V := by
    intro F hFV z hz
    exact Algebra.adjoin_induction
      (fun y hy => hFV y (Finset.mem_coe.mp hy))
      (fun c => hkV c)
      (fun _ _ _ _ hx hy => add_mem hx hy)
      (fun _ _ _ _ hx hy => mul_mem hx hy) hz

  let mk_ι_FV : ∀ (F : Finset K), (∀ x ∈ F, x ∈ V) →
      (↥(Algebra.adjoin k (↑F : Set K)) →+* ↥V) :=
    fun F hFV =>
      (Algebra.adjoin k (↑F : Set K)).val.toRingHom.codRestrict V.toSubring
        (fun z => hMemAdjoin F hFV z.1 z.2)

  let incSub : ∀ {F F' : Finset K}, F ⊆ F' →
      (↥(Algebra.adjoin k (↑F : Set K)) →+* ↥(Algebra.adjoin k (↑F' : Set K))) :=
    fun hSub =>
      (Subalgebra.inclusion
        (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub))).toRingHom

  have hInj₁ : Function.Injective ι₁_FV := by
    intro x y hxy
    apply Subtype.ext
    have hx := RingHom.congr_fun hι₁ x
    have hy := RingHom.congr_fun hι₁ y
    change (ι₁_FV x).1 = x.1 at hx
    change (ι₁_FV y).1 = y.1 at hy
    rw [← hx, ← hy, hxy]

  have hInj_mk : ∀ (F : Finset K) (hFV : ∀ x ∈ F, x ∈ V),
      Function.Injective (mk_ι_FV F hFV) := by
    intro F hFV x y hxy
    apply Subtype.ext
    exact congrArg (Subtype.val : ↥V → K) hxy

  have hComp_ι₁ : ∀ {F : Finset K} (hSub : F₁ ⊆ F) (hFV : ∀ x ∈ F, x ∈ V),
      (mk_ι_FV F hFV).comp (incSub hSub) = ι₁_FV := by
    intro F hSub hFV
    ext x
    exact (RingHom.congr_fun hι₁ x).symm

  have hComp_mk : ∀ {F F' : Finset K} (hSub : F ⊆ F')
      (hFV : ∀ x ∈ F, x ∈ V) (hF'V : ∀ x ∈ F', x ∈ V),
      (mk_ι_FV F' hF'V).comp (incSub hSub) = mk_ι_FV F hFV := by
    intro F F' hSub hFV hF'V
    ext x
    rfl

  have hComp_inc : ∀ {F F' F'' : Finset K} (h1 : F ⊆ F') (h2 : F' ⊆ F''),
      (incSub h2).comp (incSub h1) = incSub (h1.trans h2) := by
    intro F F' F'' h1 h2
    ext x
    rfl

  
  have hFlatLocBaseChange :
      ∀ (Rα R₂ Bα B₂ : Type u) [CommRing Rα] [CommRing R₂] [Algebra Rα R₂]
        [CommRing Bα] [Algebra Rα Bα] [CommRing B₂] [Algebra R₂ B₂]
        (e_B : TensorProduct Rα R₂ Bα ≃ₐ[R₂] B₂)
        (bα : Bα) (b₂ : B₂),
        e_B (1 ⊗ₜ[Rα] bα) = b₂ →
        Module.Flat Rα (Localization.Away bα) →
        Module.Flat R₂ (Localization.Away b₂) := by
    intro Rα R₂ Bα B₂ _ _ _ _ _ _ _ e_B bα b₂ hb hFlatα
    let Lα := Localization.Away bα
    let L₂ := Localization.Away b₂
    letI : Algebra Rα L₂ := ((algebraMap R₂ L₂).comp (algebraMap Rα R₂)).toAlgebra
    have : IsScalarTower Rα R₂ L₂ := IsScalarTower.of_algebraMap_eq' rfl
    have hFlatTensor : Module.Flat R₂ (TensorProduct Rα R₂ Lα) :=
      Module.Flat.baseChange Rα R₂ Lα
    let β_ring : Bα →+* B₂ :=
      e_B.toAlgHom.toRingHom.comp
        (Algebra.TensorProduct.includeRight : Bα →ₐ[Rα] TensorProduct Rα R₂ Bα).toRingHom
    have hβ_b : IsUnit (((algebraMap B₂ L₂).comp β_ring) bα) := by
      change IsUnit (algebraMap B₂ L₂ (e_B (1 ⊗ₜ[Rα] bα)))
      rw [hb]
      exact IsLocalization.Away.algebraMap_isUnit b₂
    let θ_ring : Lα →+* L₂ := IsLocalization.Away.lift bα hβ_b
    let θ : Lα →ₐ[Rα] L₂ :=
      { θ_ring with
        commutes' := fun r => by
          change θ_ring (algebraMap Bα Lα (algebraMap Rα Bα r)) =
            algebraMap R₂ L₂ (algebraMap Rα R₂ r)
          rw [IsLocalization.Away.lift_eq]
          change algebraMap B₂ L₂ (e_B (1 ⊗ₜ[Rα] algebraMap Rα Bα r)) = _
          have htmul : (1 : R₂) ⊗ₜ[Rα] algebraMap Rα Bα r =
              algebraMap R₂ (TensorProduct Rα R₂ Bα) (algebraMap Rα R₂ r) := by
            rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul,
              ← Algebra.algebraMap_eq_smul_one]
            rfl
          rw [htmul, e_B.commutes]
          exact (IsScalarTower.algebraMap_apply R₂ B₂ L₂ (algebraMap Rα R₂ r)).symm }
    let Φ : TensorProduct Rα R₂ Lα →ₐ[R₂] L₂ :=
      Algebra.TensorProduct.lift (Algebra.ofId R₂ L₂) θ (fun _ _ => Commute.all _ _)
    have hΦ_tmul : ∀ (r₂ : R₂) (z : Lα), Φ (r₂ ⊗ₜ[Rα] z) = algebraMap R₂ L₂ r₂ * θ z :=
      fun r₂ z => Algebra.TensorProduct.lift_tmul (Algebra.ofId R₂ L₂) θ
        (fun _ _ => Commute.all _ _) r₂ z
    let η : B₂ →ₐ[R₂] TensorProduct Rα R₂ Lα :=
      (Algebra.TensorProduct.map (AlgHom.id R₂ R₂)
        (IsScalarTower.toAlgHom Rα Bα Lα)).comp e_B.symm.toAlgHom
    have hη_b : IsUnit (η.toRingHom b₂) := by
      change IsUnit ((Algebra.TensorProduct.map (AlgHom.id R₂ R₂)
        (IsScalarTower.toAlgHom Rα Bα Lα)) (e_B.symm b₂))
      have hsymm : e_B.symm b₂ = 1 ⊗ₜ[Rα] bα := by
        rw [← hb, AlgEquiv.symm_apply_apply]
      rw [hsymm, Algebra.TensorProduct.map_tmul]
      exact (IsLocalization.Away.algebraMap_isUnit bα).map
        (Algebra.TensorProduct.includeRight : Lα →ₐ[Rα] TensorProduct Rα R₂ Lα).toRingHom
    let Ψ_ring : L₂ →+* TensorProduct Rα R₂ Lα := IsLocalization.Away.lift b₂ hη_b
    let Ψ : L₂ →ₐ[R₂] TensorProduct Rα R₂ Lα :=
      { Ψ_ring with
        commutes' := fun r₂ => by
          change Ψ_ring (algebraMap B₂ L₂ (algebraMap R₂ B₂ r₂)) =
            algebraMap R₂ (TensorProduct Rα R₂ Lα) r₂
          rw [IsLocalization.Away.lift_eq]
          exact η.commutes r₂ }
    have hΦ_η : ∀ y : B₂, Φ (η y) = algebraMap B₂ L₂ y := by
      have h1 : ∀ t_el : TensorProduct Rα R₂ Bα,
          Φ ((Algebra.TensorProduct.map (AlgHom.id R₂ R₂)
            (IsScalarTower.toAlgHom Rα Bα Lα)) t_el) =
          algebraMap B₂ L₂ (e_B t_el) := by
        intro t_el
        induction t_el using TensorProduct.induction_on with
        | zero => simp
        | tmul r₂ b =>
          rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, IsScalarTower.toAlgHom_apply,
            hΦ_tmul]
          change algebraMap R₂ L₂ r₂ * θ_ring (algebraMap Bα Lα b) =
            algebraMap B₂ L₂ (e_B (r₂ ⊗ₜ[Rα] b))
          rw [IsLocalization.Away.lift_eq]
          have htmul : (r₂ ⊗ₜ[Rα] b : TensorProduct Rα R₂ Bα) = r₂ • (1 ⊗ₜ[Rα] b) := by
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [htmul, map_smul, Algebra.smul_def, map_mul, IsScalarTower.algebraMap_apply R₂ B₂ L₂]
          rfl
        | add u v ihu ihv => simp only [map_add, ihu, ihv]
      intro y
      simpa [η] using h1 (e_B.symm y)
    have hΦΨ : Φ.comp Ψ = AlgHom.id R₂ L₂ := by
      apply AlgHom.coe_ringHom_injective
      apply IsLocalization.ringHom_ext (Submonoid.powers b₂)
      ext y
      change Φ (Ψ_ring (algebraMap B₂ L₂ y)) = algebraMap B₂ L₂ y
      rw [IsLocalization.Away.lift_eq]
      exact hΦ_η y
    have hΨ_θ : ∀ z : Lα, Ψ_ring (θ_ring z) = 1 ⊗ₜ[Rα] z := by
      have hext : (Ψ_ring.comp θ_ring) =
          (Algebra.TensorProduct.includeRight : Lα →ₐ[Rα] TensorProduct Rα R₂ Lα).toRingHom := by
        apply IsLocalization.ringHom_ext (Submonoid.powers bα)
        ext b
        change Ψ_ring (θ_ring (algebraMap Bα Lα b)) = 1 ⊗ₜ[Rα] algebraMap Bα Lα b
        rw [IsLocalization.Away.lift_eq]
        change Ψ_ring (algebraMap B₂ L₂ (β_ring b)) = _
        rw [IsLocalization.Away.lift_eq]
        change η (e_B (1 ⊗ₜ[Rα] b)) = _
        simp [η]
      intro z
      exact RingHom.congr_fun hext z
    have hΨΦ : Ψ.comp Φ = AlgHom.id R₂ (TensorProduct Rα R₂ Lα) := by
      apply AlgHom.ext
      intro t_el
      induction t_el using TensorProduct.induction_on with
      | zero => simp
      | tmul r₂ z =>
        change Ψ (Φ (r₂ ⊗ₜ[Rα] z)) = r₂ ⊗ₜ[Rα] z
        have htmul : (r₂ ⊗ₜ[Rα] z : TensorProduct Rα R₂ Lα) = r₂ • (1 ⊗ₜ[Rα] z) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [htmul, map_smul, map_smul]
        congr 1
        rw [hΦ_tmul, map_one, one_mul]
        exact hΨ_θ z
      | add u v ihu ihv => simp only [map_add, ihu, ihv]
    let e : TensorProduct Rα R₂ Lα ≃ₐ[R₂] L₂ := AlgEquiv.ofAlgHom Φ Ψ hΦΨ hΨΦ
    have : Module.Flat R₂ (TensorProduct Rα R₂ Lα) := hFlatTensor
    exact Module.Flat.of_linearEquiv e.symm.toLinearEquiv

  
  have hMvPolyQuotTensorEquiv :
      ∀ (R₀ Rα R₂ : Type u) [CommRing R₀] [CommRing Rα] [CommRing R₂]
        (m₀ t₀ : ℕ) (f₀ : Fin t₀ → MvPolynomial (Fin m₀) R₀)
        (inc₁α : R₀ →+* Rα) (incα₂ : Rα →+* R₂) (inc₁₂ : R₀ →+* R₂),
        incα₂.comp inc₁α = inc₁₂ →
        ∀ (P_b : MvPolynomial (Fin m₀) Rα),
          letI : Algebra Rα R₂ := incα₂.toAlgebra
          let Iα : Ideal (MvPolynomial (Fin m₀) Rα) :=
            Ideal.span (Set.range (fun ν : Fin t₀ => MvPolynomial.map inc₁α (f₀ ν)))
          let I₂ : Ideal (MvPolynomial (Fin m₀) R₂) :=
            Ideal.span (Set.range (fun ν : Fin t₀ => MvPolynomial.map inc₁₂ (f₀ ν)))
          ∃ (e_B : TensorProduct Rα R₂ (MvPolynomial (Fin m₀) Rα ⧸ Iα) ≃ₐ[R₂]
              (MvPolynomial (Fin m₀) R₂ ⧸ I₂)),
            e_B (1 ⊗ₜ[Rα] Ideal.Quotient.mk Iα P_b) =
              Ideal.Quotient.mk I₂ (MvPolynomial.map incα₂ P_b) := by
    intro R₀ Rα R₂ _ _ _ m₀ t₀ f₀ inc₁α incα₂ inc₁₂ hcomp P_b
    letI : Algebra Rα R₂ := incα₂.toAlgebra
    let Iα : Ideal (MvPolynomial (Fin m₀) Rα) :=
      Ideal.span (Set.range (fun ν : Fin t₀ => MvPolynomial.map inc₁α (f₀ ν)))
    let I₂ : Ideal (MvPolynomial (Fin m₀) R₂) :=
      Ideal.span (Set.range (fun ν : Fin t₀ => MvPolynomial.map inc₁₂ (f₀ ν)))
    have hMapI : ∀ P ∈ Iα, Ideal.Quotient.mk I₂ (MvPolynomial.map incα₂ P) = 0 := by
      intro P hP
      rw [Ideal.Quotient.eq_zero_iff_mem]
      obtain ⟨c, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hP
      simp only [map_sum, map_mul, MvPolynomial.map_map, hcomp]
      exact Ideal.sum_mem I₂ fun ν _ => Ideal.mul_mem_left I₂ _ (Ideal.subset_span ⟨ν, rfl⟩)
    let β_ring : (MvPolynomial (Fin m₀) Rα ⧸ Iα) →+* (MvPolynomial (Fin m₀) R₂ ⧸ I₂) :=
      Ideal.Quotient.lift Iα ((Ideal.Quotient.mk I₂).comp (MvPolynomial.map incα₂)) hMapI
    let β : (MvPolynomial (Fin m₀) Rα ⧸ Iα) →ₐ[Rα] (MvPolynomial (Fin m₀) R₂ ⧸ I₂) :=
      { β_ring with
        commutes' := fun r => by
          change Ideal.Quotient.mk I₂ (MvPolynomial.map incα₂ (MvPolynomial.C r)) =
            Ideal.Quotient.mk I₂ (MvPolynomial.C (incα₂ r))
          rw [MvPolynomial.map_C] }
    let Φ : TensorProduct Rα R₂ (MvPolynomial (Fin m₀) Rα ⧸ Iα) →ₐ[R₂]
        (MvPolynomial (Fin m₀) R₂ ⧸ I₂) :=
      Algebra.TensorProduct.lift (Algebra.ofId R₂ _) β (fun _ _ => Commute.all _ _)
    have hΦ_tmul : ∀ (r₂ : R₂) (q : MvPolynomial (Fin m₀) Rα ⧸ Iα),
        Φ (r₂ ⊗ₜ[Rα] q) = algebraMap R₂ _ r₂ * β q :=
      fun r₂ q => Algebra.TensorProduct.lift_tmul (Algebra.ofId R₂ _) β
        (fun _ _ => Commute.all _ _) r₂ q
    let incR : (MvPolynomial (Fin m₀) Rα ⧸ Iα) →ₐ[Rα]
        TensorProduct Rα R₂ (MvPolynomial (Fin m₀) Rα ⧸ Iα) :=
      Algebra.TensorProduct.includeRight
    let η₀ : MvPolynomial (Fin m₀) R₂ →ₐ[R₂]
        TensorProduct Rα R₂ (MvPolynomial (Fin m₀) Rα ⧸ Iα) :=
      MvPolynomial.aeval (fun j => incR (Ideal.Quotient.mk Iα (MvPolynomial.X j)))
    have hη₀_map : ∀ P : MvPolynomial (Fin m₀) Rα,
        η₀ (MvPolynomial.map incα₂ P) = incR (Ideal.Quotient.mk Iα P) := by
      intro P
      induction P using MvPolynomial.induction_on with
      | C r =>
        rw [MvPolynomial.map_C, MvPolynomial.aeval_C]
        change incα₂ r ⊗ₜ[Rα] (1 : MvPolynomial (Fin m₀) Rα ⧸ Iα) =
          1 ⊗ₜ[Rα] Ideal.Quotient.mk Iα (MvPolynomial.C r)
        have hr : incα₂ r = r • (1 : R₂) :=
          (Algebra.smul_def r (1 : R₂)).trans (mul_one _) |>.symm
        rw [hr, TensorProduct.smul_tmul]
        congr 1
        rw [← Algebra.algebraMap_eq_smul_one]
        rfl
      | add p q ihp ihq => simp only [map_add, ihp, ihq]
      | mul_X p j ihp =>
        rw [map_mul, MvPolynomial.map_X, map_mul, ihp, MvPolynomial.aeval_X, ← map_mul, ← map_mul]
    have hη₀_I₂ : ∀ P ∈ I₂, η₀ P = 0 := by
      intro P hP
      obtain ⟨c, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hP
      simp only [map_sum, map_mul]
      refine Finset.sum_eq_zero fun ν _ => ?_
      rw [← hcomp, ← MvPolynomial.map_map, hη₀_map]
      have hzero : Ideal.Quotient.mk Iα (MvPolynomial.map inc₁α (f₀ ν)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨ν, rfl⟩)
      rw [hzero, map_zero]
      exact mul_zero (η₀ (c ν))
    let Ψ : (MvPolynomial (Fin m₀) R₂ ⧸ I₂) →ₐ[R₂]
        TensorProduct Rα R₂ (MvPolynomial (Fin m₀) Rα ⧸ Iα) :=
      Ideal.Quotient.liftₐ I₂ η₀ hη₀_I₂
    have hΦΨ : Φ.comp Ψ = AlgHom.id R₂ _ := by
      apply AlgHom.coe_ringHom_injective
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r₂
        change Φ (Ψ (Ideal.Quotient.mk I₂ (MvPolynomial.C r₂))) =
          Ideal.Quotient.mk I₂ (MvPolynomial.C r₂)
        change Φ (η₀ (MvPolynomial.C r₂)) = _
        rw [MvPolynomial.aeval_C, Φ.commutes]
        rfl
      · intro j
        change Φ (Ψ (Ideal.Quotient.mk I₂ (MvPolynomial.X j))) =
          Ideal.Quotient.mk I₂ (MvPolynomial.X j)
        change Φ (η₀ (MvPolynomial.X j)) = _
        rw [MvPolynomial.aeval_X]
        change Φ (1 ⊗ₜ[Rα] Ideal.Quotient.mk Iα (MvPolynomial.X j)) = _
        rw [hΦ_tmul, map_one, one_mul]
        change Ideal.Quotient.mk I₂ (MvPolynomial.map incα₂ (MvPolynomial.X j)) = _
        rw [MvPolynomial.map_X]
    have hΨΦ : Ψ.comp Φ = AlgHom.id R₂ _ := by
      apply AlgHom.ext
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul r₂ q =>
        change Ψ (Φ (r₂ ⊗ₜ[Rα] q)) = r₂ ⊗ₜ[Rα] q
        have htmul : (r₂ ⊗ₜ[Rα] q : TensorProduct Rα R₂ (MvPolynomial (Fin m₀) Rα ⧸ Iα)) =
            r₂ • (1 ⊗ₜ[Rα] q) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [htmul, map_smul, map_smul]
        congr 1
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q
        rw [hΦ_tmul, map_one, one_mul]
        change Ψ (Ideal.Quotient.mk I₂ (MvPolynomial.map incα₂ P)) =
          1 ⊗ₜ[Rα] Ideal.Quotient.mk Iα P
        change η₀ (MvPolynomial.map incα₂ P) = _
        exact hη₀_map P
      | add u v ihu ihv => simp only [map_add, ihu, ihv]
    refine ⟨AlgEquiv.ofAlgHom Φ Ψ hΦΨ hΨΦ, ?_⟩
    change Φ (1 ⊗ₜ[Rα] Ideal.Quotient.mk Iα P_b) = _
    rw [hΦ_tmul, map_one, one_mul]
    rfl

  
  obtain ⟨r, m, t, f, hFlatIff⟩ :=
    weil_finitePresentation_chart_cover_and_baseChange R₁ C₁ g₁ hQC₁ hLFP₁

  have hFlatBiV : ∀ i : Fin r,
      Module.Flat ↥V
        (MvPolynomial (Fin (m i)) ↥V ⧸
          Ideal.span (Set.range (fun ν : Fin (t i) => MvPolynomial.map ι₁_FV (f i ν)))) :=
    (hFlatIff ↥V ι₁_FV C_V g_V ι₁_V hPb₁).mp hFlatV

  
  have hSpreadCharts :
      ∀ (V₀ : Type u) [CommRing V₀]
        (valV : V₀ → K) (hValV : ∀ v : V₀, valV v ∈ V)
        (A : Finset K → Type u) [∀ F, CommRing (A F)] [∀ F, IsNoetherianRing (A F)]
        (inc : ∀ {F F' : Finset K}, F ⊆ F' → (A F →+* A F'))
        (hIncComp : ∀ {F F' F'' : Finset K} (h1 : F ⊆ F') (h2 : F' ⊆ F''),
          (inc h2).comp (inc h1) = inc (h1.trans h2))
        (ι₁ : A F₁ →+* V₀) (hInj₁' : Function.Injective ι₁)
        (ιA : ∀ (F : Finset K), (∀ x ∈ F, x ∈ V) → (A F →+* V₀))
        (hInjA : ∀ (F : Finset K) (hFV : ∀ x ∈ F, x ∈ V), Function.Injective (ιA F hFV))
        (hComp₁ : ∀ {F : Finset K} (hSub : F₁ ⊆ F) (hFV : ∀ x ∈ F, x ∈ V),
          (ιA F hFV).comp (inc hSub) = ι₁)
        (hCompA : ∀ {F F' : Finset K} (hSub : F ⊆ F')
          (hFV : ∀ x ∈ F, x ∈ V) (hF'V : ∀ x ∈ F', x ∈ V),
          (ιA F' hF'V).comp (inc hSub) = ιA F hFV)
        (hMemRange : ∀ (F : Finset K) (hFV : ∀ x ∈ F, x ∈ V) (v : V₀),
          valV v ∈ F → v ∈ Set.range (ιA F hFV))
        (fA : ∀ i : Fin r, Fin (t i) → MvPolynomial (Fin (m i)) (A F₁))
        (hFlatV₀ : ∀ i : Fin r,
          Module.Flat V₀
            (MvPolynomial (Fin (m i)) V₀ ⧸
              Ideal.span (Set.range (fun ν : Fin (t i) => MvPolynomial.map ι₁ (fA i ν))))),
        ∃ (F₂ : Finset K) (hSub₁₂ : F₁ ⊆ F₂),
          (∀ x ∈ F₂, x ∈ V) ∧
          (∀ i : Fin r,
            Module.Flat (A F₂)
              (MvPolynomial (Fin (m i)) (A F₂) ⧸
                Ideal.span (Set.range (fun ν : Fin (t i) =>
                  MvPolynomial.map (inc hSub₁₂) (fA i ν))))) := by
    intro V₀ _ valV hValV A _ _ inc hIncComp ι₁ hInj₁' ιA hInjA hComp₁ hCompA hMemRange fA hFlatV₀
    let I_V_chart : ∀ i : Fin r, Ideal (MvPolynomial (Fin (m i)) V₀) :=
      fun i => Ideal.span (Set.range (fun ν : Fin (t i) => MvPolynomial.map ι₁ (fA i ν)))
    let S_good : ∀ i : Fin r, Set (MvPolynomial (Fin (m i)) V₀ ⧸ I_V_chart i) :=
      fun i =>
        { z | ∃ (F : Finset K) (hSub : F₁ ⊆ F) (hFV : ∀ x ∈ F, x ∈ V)
            (P_b : MvPolynomial (Fin (m i)) (A F)),
            z = Ideal.Quotient.mk (I_V_chart i) (MvPolynomial.map (ιA F hFV) P_b) ∧
            Module.Flat (A F)
              (Localization.Away
                (Ideal.Quotient.mk
                  (Ideal.span (Set.range (fun ν : Fin (t i) =>
                    MvPolynomial.map (inc hSub) (fA i ν))))
                  P_b)) }

    
    have hSpanTopV : ∀ i : Fin r, Ideal.span (S_good i) = ⊤ := by
      intro i
      by_contra hNeTop
      obtain ⟨M_V, hMax, hLe⟩ := Ideal.exists_le_maximal (Ideal.span (S_good i)) hNeTop
      let q_V : PrimeSpectrum (MvPolynomial (Fin (m i)) V₀ ⧸ I_V_chart i) :=
        ⟨M_V, hMax.isPrime⟩
      obtain ⟨S_wit, hS_wit⟩ :=
        weil_mvPolynomial_quotient_pointwise_syzygy_descent (A F₁) V₀ ι₁ hInj₁'
          (m i) (t i) (fA i) (hFlatV₀ i) q_V
      let F : Finset K := F₁ ∪ S_wit.image valV
      have hSub : F₁ ⊆ F := Finset.subset_union_left
      have hFV : ∀ x ∈ F, x ∈ V := by
        intro x hx
        rcases Finset.mem_union.mp hx with hx₁ | hx_wit
        · exact hF₁ x hx₁
        · rcases Finset.mem_image.mp hx_wit with ⟨v, _, rfl⟩
          exact hValV v
      have hRange_wit : (↑S_wit : Set V₀) ⊆ Set.range (ιA F hFV) := by
        intro v hv
        apply hMemRange F hFV v
        exact Finset.mem_union_right _ (Finset.mem_image_of_mem valV (Finset.mem_coe.mp hv))
      obtain ⟨q_F, hq_F_iff, hInjTensor⟩ :=
        hS_wit (A F) (inc hSub) (ιA F hFV) (hComp₁ hSub hFV) (hInjA F hFV) hRange_wit
      let I_F : Ideal (MvPolynomial (Fin (m i)) (A F)) :=
        Ideal.span (Set.range (fun ν : Fin (t i) => MvPolynomial.map (inc hSub) (fA i ν)))
      let B_F := MvPolynomial (Fin (m i)) (A F) ⧸ I_F
      obtain ⟨hLocCrit, hOpenLocus⟩ := weil_noetherian_local_flat_and_open_locus (A F) B_F
      have hFlatAtQ : Module.Flat (A F) (Localization.AtPrime q_F.asIdeal) :=
        (hLocCrit q_F).mpr hInjTensor
      have hGenFlatOfNagata :
          ∀ (R₀ B₀ : Type u) [CommRing R₀] [IsNoetherianRing R₀]
            [CommRing B₀] [Algebra R₀ B₀] [Algebra.FiniteType R₀ B₀]
            (p : Ideal R₀) [p.IsPrime],
            ∃ a : R₀, a ∉ p ∧
              Module.Flat (Localization.Away (Ideal.Quotient.mk p a))
                (LocalizedModule (Submonoid.powers (Ideal.Quotient.mk p a))
                  (B₀ ⧸ Ideal.map (algebraMap R₀ B₀) p)) := by
        intro R₀ B₀ _ _ _ _ _ p _
        have : Algebra.FiniteType R₀ (B₀ ⧸ Ideal.map (algebraMap R₀ B₀) p) := inferInstance
        have : Algebra.FiniteType (R₀ ⧸ p) (B₀ ⧸ Ideal.map (algebraMap R₀ B₀) p) :=
          Algebra.FiniteType.of_restrictScalars_finiteType R₀ (R₀ ⧸ p)
            (B₀ ⧸ Ideal.map (algebraMap R₀ B₀) p)
        obtain ⟨a_bar, ha_bar_ne, hFree⟩ :=
          weil_nagata_generic_freeness_finiteType (R₀ ⧸ p) (B₀ ⧸ Ideal.map (algebraMap R₀ B₀) p)
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a_bar
        have ha_not_mem : a ∉ p := fun ha => ha_bar_ne (Ideal.Quotient.eq_zero_iff_mem.mpr ha)
        have : Module.Free (Localization.Away (Ideal.Quotient.mk p a))
            (LocalizedModule (Submonoid.powers (Ideal.Quotient.mk p a))
              (B₀ ⧸ Ideal.map (algebraMap R₀ B₀) p)) := hFree
        exact ⟨a, ha_not_mem, inferInstance⟩
      obtain ⟨b, hb_not_mem, hFlatAway⟩ :=
        hOpenLocus (fun p _ => hGenFlatOfNagata (A F) B_F p) q_F hFlatAtQ
      obtain ⟨P_b, rfl⟩ := Ideal.Quotient.mk_surjective b
      let z : MvPolynomial (Fin (m i)) V₀ ⧸ I_V_chart i :=
        Ideal.Quotient.mk (I_V_chart i) (MvPolynomial.map (ιA F hFV) P_b)
      have hz_good : z ∈ S_good i := ⟨F, hSub, hFV, P_b, rfl, hFlatAway⟩
      have hz_mem_qV : z ∈ q_V.asIdeal := hLe (Ideal.subset_span hz_good)
      exact hb_not_mem ((hq_F_iff P_b).mpr hz_mem_qV)

    
    have hChartData : ∀ i : Fin r,
        ∃ (N : ℕ)
          (F_w : Fin N → Finset K)
          (hSub_w : ∀ α : Fin N, F₁ ⊆ F_w α)
          (hFV_w : ∀ α : Fin N, ∀ x ∈ F_w α, x ∈ V)
          (P_b : ∀ α : Fin N, MvPolynomial (Fin (m i)) (A (F_w α)))
          (P_c : Fin N → MvPolynomial (Fin (m i)) V₀)
          (Q_rel : Fin (t i) → MvPolynomial (Fin (m i)) V₀),
          (∀ α : Fin N,
            Module.Flat (A (F_w α))
              (Localization.Away
                (Ideal.Quotient.mk
                  (Ideal.span (Set.range (fun ν : Fin (t i) =>
                    MvPolynomial.map (inc (hSub_w α)) (fA i ν))))
                  (P_b α)))) ∧
          (1 - ∑ α : Fin N, P_c α * MvPolynomial.map (ιA (F_w α) (hFV_w α)) (P_b α) =
            ∑ ν : Fin (t i), Q_rel ν * MvPolynomial.map ι₁ (fA i ν)) := by
      intro i
      have hOneMem : (1 : MvPolynomial (Fin (m i)) V₀ ⧸ I_V_chart i) ∈ Ideal.span (S_good i) := by
        rw [hSpanTopV i]
        trivial
      obtain ⟨c_supp, hc_sub, hc_sum⟩ := Submodule.mem_span_set.mp hOneMem
      let N := c_supp.support.card
      let e_supp : Fin N ≃ ↥c_supp.support := c_supp.support.equivFin.symm
      have hα_good : ∀ α : Fin N, (e_supp α).1 ∈ S_good i :=
        fun α => hc_sub (Finset.mem_coe.mpr (e_supp α).2)
      choose F_w hSub_w hFV_w P_b hz_eq hFlat_w using hα_good
      have hLift_c : ∀ α : Fin N, ∃ P : MvPolynomial (Fin (m i)) V₀,
          Ideal.Quotient.mk (I_V_chart i) P = c_supp (e_supp α).1 :=
        fun α => Ideal.Quotient.mk_surjective (c_supp (e_supp α).1)
      choose P_c hP_c using hLift_c
      have hSumQuot :
          Ideal.Quotient.mk (I_V_chart i)
            (1 - ∑ α : Fin N, P_c α * MvPolynomial.map (ιA (F_w α) (hFV_w α)) (P_b α)) = 0 := by
        rw [map_sub, map_one, map_sum]
        have h_eq_one :
            (∑ α : Fin N,
              Ideal.Quotient.mk (I_V_chart i)
                (P_c α * MvPolynomial.map (ιA (F_w α) (hFV_w α)) (P_b α))) = 1 := by
          calc
            (∑ α : Fin N,
                Ideal.Quotient.mk (I_V_chart i)
                  (P_c α * MvPolynomial.map (ιA (F_w α) (hFV_w α)) (P_b α)))
              = ∑ α : Fin N, c_supp (e_supp α).1 * (e_supp α).1 := by
                  refine Finset.sum_congr rfl fun α _ => ?_
                  rw [map_mul, hP_c α, ← hz_eq α]
            _ = ∑ x : ↥c_supp.support, c_supp x.1 * x.1 :=
                  e_supp.sum_comp (fun x => c_supp x.1 * x.1)
            _ = ∑ z ∈ c_supp.support, c_supp z * z :=
                  Finset.sum_coe_sort c_supp.support (fun z => c_supp z * z)
            _ = 1 := hc_sum
        rw [h_eq_one, sub_self]
      have hMemIdeal :
          1 - ∑ α : Fin N, P_c α * MvPolynomial.map (ιA (F_w α) (hFV_w α)) (P_b α) ∈
            I_V_chart i :=
        Ideal.Quotient.eq_zero_iff_mem.mp hSumQuot
      obtain ⟨Q_rel, hQ_rel⟩ := Ideal.mem_span_range_iff_exists_fun.mp hMemIdeal
      exact ⟨N, F_w, hSub_w, hFV_w, P_b, P_c, Q_rel, hFlat_w, hQ_rel.symm⟩

    choose N_i F_w hSub_w hFV_w P_b P_c Q_rel hFlat_w hRel_V using hChartData

    
    let polyCoeffs : ∀ {σ : Type} (P : MvPolynomial σ V₀), Finset K :=
      fun P => P.support.image (fun d => valV (P.coeff d))

    have hPolyCoeffsV : ∀ {σ : Type} (P : MvPolynomial σ V₀) (x : K),
        x ∈ polyCoeffs P → x ∈ V := by
      intro σ P x hx
      rcases Finset.mem_image.mp hx with ⟨d, _, rfl⟩
      exact hValV (P.coeff d)

    let F_chart : Fin r → Finset K :=
      fun i =>
        Finset.univ.biUnion (fun α : Fin (N_i i) => F_w i α) ∪
        Finset.univ.biUnion (fun α : Fin (N_i i) => polyCoeffs (P_c i α)) ∪
        Finset.univ.biUnion (fun ν : Fin (t i) => polyCoeffs (Q_rel i ν))

    let F₂ : Finset K := F₁ ∪ Finset.univ.biUnion F_chart
    have hSub₁₂ : F₁ ⊆ F₂ := Finset.subset_union_left

    have hF₂ : ∀ x ∈ F₂, x ∈ V := by
      intro x hx
      rcases Finset.mem_union.mp hx with hx₁ | hx_ch
      · exact hF₁ x hx₁
      · rcases Finset.mem_biUnion.mp hx_ch with ⟨i, _, hx_i⟩
        rcases Finset.mem_union.mp hx_i with hx_12 | hx_Q
        · rcases Finset.mem_union.mp hx_12 with hx_Fw | hx_Pc
          · rcases Finset.mem_biUnion.mp hx_Fw with ⟨α, _, hx_α⟩
            exact hFV_w i α x hx_α
          · rcases Finset.mem_biUnion.mp hx_Pc with ⟨α, _, hx_α⟩
            exact hPolyCoeffsV (P_c i α) x hx_α
        · rcases Finset.mem_biUnion.mp hx_Q with ⟨ν, _, hx_ν⟩
          exact hPolyCoeffsV (Q_rel i ν) x hx_ν

    let ι₂ := ιA F₂ hF₂
    let inc₁₂ := inc hSub₁₂

    have hLiftPoly : ∀ {σ : Type} (P : MvPolynomial σ V₀),
        polyCoeffs P ⊆ F₂ →
        ∃ P_lift : MvPolynomial σ (A F₂), MvPolynomial.map ι₂ P_lift = P := by
      intro σ P hSubP
      have hCoeffRange : ∀ d : ↥P.support, ∃ c : A F₂, ι₂ c = P.coeff d.1 := by
        intro d
        exact hMemRange F₂ hF₂ (P.coeff d.1) (hSubP (Finset.mem_image_of_mem _ d.2))
      choose c_lift hc_lift using hCoeffRange
      let P_lift : MvPolynomial σ (A F₂) :=
        ∑ d ∈ P.support.attach, MvPolynomial.monomial d.1 (c_lift d)
      refine ⟨P_lift, ?_⟩
      simp only [P_lift, map_sum, MvPolynomial.map_monomial, hc_lift]
      rw [Finset.sum_attach P.support (fun d => MvPolynomial.monomial d (P.coeff d))]
      exact (MvPolynomial.as_sum P).symm

    
    refine ⟨F₂, hSub₁₂, hF₂, ?_⟩
    intro i
    let I₂ : Ideal (MvPolynomial (Fin (m i)) (A F₂)) :=
      Ideal.span (Set.range (fun ν : Fin (t i) => MvPolynomial.map inc₁₂ (fA i ν)))
    let B₂ := MvPolynomial (Fin (m i)) (A F₂) ⧸ I₂
    have hSub_w₂ : ∀ α : Fin (N_i i), F_w i α ⊆ F₂ := by
      intro α x hx
      refine Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, ?_⟩)
      exact Finset.mem_union_left _ (Finset.mem_union_left _
        (Finset.mem_biUnion.mpr ⟨α, Finset.mem_univ α, hx⟩))
    have hPc_sub₂ : ∀ α : Fin (N_i i), polyCoeffs (P_c i α) ⊆ F₂ := by
      intro α x hx
      refine Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, ?_⟩)
      exact Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨α, Finset.mem_univ α, hx⟩))
    have hQ_sub₂ : ∀ ν : Fin (t i), polyCoeffs (Q_rel i ν) ⊆ F₂ := by
      intro ν x hx
      refine Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, ?_⟩)
      exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν, hx⟩)
    choose P_c₂ hP_c₂ using fun α : Fin (N_i i) => hLiftPoly (P_c i α) (hPc_sub₂ α)
    choose Q_rel₂ hQ_rel₂ using fun ν : Fin (t i) => hLiftPoly (Q_rel i ν) (hQ_sub₂ ν)
    let b₂ : Fin (N_i i) → B₂ :=
      fun α => Ideal.Quotient.mk I₂ (MvPolynomial.map (inc (hSub_w₂ α)) (P_b i α))
    have hRel₂ :
        1 - ∑ α : Fin (N_i i), P_c₂ α * MvPolynomial.map (inc (hSub_w₂ α)) (P_b i α) =
          ∑ ν : Fin (t i), Q_rel₂ ν * MvPolynomial.map inc₁₂ (fA i ν) := by
      apply MvPolynomial.map_injective ι₂ (hInjA F₂ hF₂)
      simp only [map_sub, map_one, map_sum, map_mul, hP_c₂, hQ_rel₂, MvPolynomial.map_map]
      have h1 : ∀ α : Fin (N_i i),
          ι₂.comp (inc (hSub_w₂ α)) = ιA (F_w i α) (hFV_w i α) :=
        fun α => hCompA (hSub_w₂ α) (hFV_w i α) hF₂
      have h2 : ι₂.comp inc₁₂ = ι₁ := hComp₁ hSub₁₂ hF₂
      simp only [h1, h2]
      exact hRel_V i
    have hSpanTop₂ : Ideal.span (Set.range b₂) = ⊤ := by
      rw [Ideal.eq_top_iff_one]
      have hQuotZero :
          Ideal.Quotient.mk I₂
            (1 - ∑ α : Fin (N_i i), P_c₂ α * MvPolynomial.map (inc (hSub_w₂ α)) (P_b i α)) = 0 := by
        rw [hRel₂]
        refine Ideal.Quotient.eq_zero_iff_mem.mpr ?_
        exact Ideal.sum_mem I₂ fun ν _ => Ideal.mul_mem_left I₂ _ (Ideal.subset_span ⟨ν, rfl⟩)
      have hOneEq : (1 : B₂) = ∑ α : Fin (N_i i), Ideal.Quotient.mk I₂ (P_c₂ α) * b₂ α := by
        rw [map_sub, map_one, map_sum] at hQuotZero
        have hEqSum :
            (∑ α : Fin (N_i i),
              Ideal.Quotient.mk I₂ (P_c₂ α * MvPolynomial.map (inc (hSub_w₂ α)) (P_b i α))) =
            ∑ α : Fin (N_i i), Ideal.Quotient.mk I₂ (P_c₂ α) * b₂ α := by
          refine Finset.sum_congr rfl fun α _ => map_mul _ _ _
        rw [hEqSum] at hQuotZero
        exact sub_eq_zero.mp hQuotZero
      rw [hOneEq]
      exact Ideal.sum_mem _ fun α _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨α, rfl⟩)
    have hFlatAway₂ : ∀ α : Fin (N_i i), Module.Flat (A F₂) (Localization.Away (b₂ α)) := by
      intro α
      let Rα := A (F_w i α)
      let inc₁α := inc (hSub_w i α)
      let incα₂ := inc (hSub_w₂ α)
      have hcomp_α : incα₂.comp inc₁α = inc₁₂ := hIncComp (hSub_w i α) (hSub_w₂ α)
      letI : Algebra Rα (A F₂) := incα₂.toAlgebra
      obtain ⟨e_B, he_B⟩ :=
        hMvPolyQuotTensorEquiv (A F₁) Rα (A F₂) (m i) (t i) (fA i) inc₁α incα₂ inc₁₂ hcomp_α
          (P_b i α)
      exact hFlatLocBaseChange Rα (A F₂) _ B₂ e_B _ (b₂ α) he_B (hFlat_w i α)
    letI : DecidableEq B₂ := Classical.decEq B₂
    rw [← RingHom.flat_algebraMap_iff]
    have hSpanFin : Ideal.span (Finset.univ.image b₂ : Set B₂) = ⊤ := by
      simpa [Finset.coe_image] using hSpanTop₂
    refine RingHom.Flat.ofLocalizationSpanTarget (algebraMap (A F₂) B₂) (Finset.univ.image b₂)
      hSpanFin ?_
    intro s
    rcases Finset.mem_image.mp s.2 with ⟨α, _, hα⟩
    rw [← hα]
    have hEqAlg : (algebraMap B₂ (Localization.Away (b₂ α))).comp (algebraMap (A F₂) B₂) =
        algebraMap (A F₂) (Localization.Away (b₂ α)) :=
      (IsScalarTower.algebraMap_eq (A F₂) B₂ (Localization.Away (b₂ α))).symm
    rw [hEqAlg, RingHom.flat_algebraMap_iff]
    exact hFlatAway₂ α

  have : ∀ F : Finset K, IsNoetherianRing ↥(Algebra.adjoin k (↑F : Set K)) :=
    fun F => isNoetherianRing_of_fg (Subalgebra.fg_adjoin_finset F)

  have hMemRangeSub : ∀ (F : Finset K) (hFV : ∀ x ∈ F, x ∈ V) (v : ↥V),
      v.1 ∈ F → v ∈ Set.range (mk_ι_FV F hFV) := by
    intro F hFV v hv
    exact ⟨⟨v.1, Algebra.subset_adjoin (Finset.mem_coe.mpr hv)⟩, Subtype.ext rfl⟩

  obtain ⟨F₂, hSub₁₂, hF₂, hFlatCharts₂⟩ :=
    hSpreadCharts ↥V Subtype.val (fun v => v.2)
      (fun F => ↥(Algebra.adjoin k (↑F : Set K)))
      incSub hComp_inc ι₁_FV hInj₁ mk_ι_FV hInj_mk hComp_ι₁ hComp_mk hMemRangeSub
      f hFlatBiV

  
  let R₂ := ↥(Algebra.adjoin k (↑F₂ : Set K))
  let ι₂_FV := mk_ι_FV F₂ hF₂
  let inc₁₂ : R₁ →+* R₂ := incSub hSub₁₂
  let ρ₁₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc₁₂)
  let C₂ := CategoryTheory.Limits.pullback g₁ ρ₁₂
  let g₂ := CategoryTheory.Limits.pullback.snd g₁ ρ₁₂

  have hFlat₂ : AlgebraicGeometry.Flat g₂ :=
    (hFlatIff R₂ inc₁₂ C₂ g₂ (CategoryTheory.Limits.pullback.fst g₁ ρ₁₂)
      (CategoryTheory.IsPullback.of_hasPullback g₁ ρ₁₂)).mpr hFlatCharts₂

  have hρ₁₂_V :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₂_FV) ≫ ρ₁₂ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁_FV) := by
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hComp_ι₁ hSub₁₂ hF₂]

  let ι₂_V : C_V ⟶ C₂ :=
    CategoryTheory.Limits.pullback.lift ι₁_V
      (g_V ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₂_FV))
      (by rw [CategoryTheory.Category.assoc, hρ₁₂_V, hPb₁.w])

  have hPb₂_V : CategoryTheory.IsPullback ι₂_V g_V g₂
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₂_FV)) := by
    refine CategoryTheory.IsPullback.of_right ?_
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback g₁ ρ₁₂)
    rw [CategoryTheory.Limits.pullback.lift_fst, hρ₁₂_V]
    exact hPb₁

  have hSpecVal₂ :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₂_FV) =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.adjoin k (↑F₂ : Set K)).val.toRingHom) := by
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl

  have hPb_K₂ : CategoryTheory.IsPullback (ι_gen ≫ ι₂_V) p_K g₂
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.adjoin k (↑F₂ : Set K)).val.toRingHom)) := by
    rw [← hSpecVal₂]
    exact hPbV.paste_horiz hPb₂_V

  have hInt₂ : AlgebraicGeometry.IsIntegral C₂ :=
    weil_scheme_isIntegral_of_flat_over_domain_to_field R₂ K
      (Algebra.adjoin k (↑F₂ : Set K)).val.toRingHom Subtype.val_injective
      C₂ C_K g₂ hFlat₂ p_K (ι_gen ≫ ι₂_V) hPb_K₂ hIntCK

  exact ⟨F₂, hSub₁₂, hF₂, hFlat₂, hInt₂⟩

theorem weil_valuationSubring_spreadOut_proper_of_integral (k : Type u) [Field k]
    (K : Type u) [Field K] [Algebra k K]
    (V : ValuationSubring K)
    (hkV : ∀ c : k, algebraMap k K c ∈ V)
    (C_V : AlgebraicGeometry.Scheme.{u})
    (g_V : C_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hPropV : AlgebraicGeometry.IsProper g_V)
    (F₂ : Finset K)
    (hF₂ : ∀ x ∈ F₂, x ∈ V)
    (ι₂_FV : ↥(Algebra.adjoin k (↑F₂ : Set K)) →+* ↥V)
    (hι₂ : V.subtype.comp ι₂_FV = (Algebra.adjoin k (↑F₂ : Set K)).val.toRingHom)
    (C₂ : AlgebraicGeometry.Scheme.{u})
    (hIntC₂ : AlgebraicGeometry.IsIntegral C₂)
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec
      (CommRingCat.of ↥(Algebra.adjoin k (↑F₂ : Set K))))
    (hQC₂ : AlgebraicGeometry.QuasiCompact g₂)
    (hSep₂ : AlgebraicGeometry.IsSeparated g₂)
    (hLFP₂ : AlgebraicGeometry.LocallyOfFinitePresentation g₂)
    (ι₂_V : C_V ⟶ C₂)
    (hPb₂ : CategoryTheory.IsPullback ι₂_V g_V g₂
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₂_FV))) :
    ∃ (F₃ : Finset K) (hSub₂₃ : F₂ ⊆ F₃),
      (∀ x ∈ F₃, x ∈ V) ∧
      AlgebraicGeometry.IsProper
        (CategoryTheory.Limits.pullback.snd g₂
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Subalgebra.inclusion
              (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub₂₃))).toRingHom))) :=
by
  have hStep1 : ∀ (R : Type u) [CommRing R]
      (C : AlgebraicGeometry.Scheme.{u})
      (_ : AlgebraicGeometry.IsIntegral C)
      (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (_ : AlgebraicGeometry.QuasiCompact g)
      (_ : AlgebraicGeometry.IsSeparated g)
      (_ : AlgebraicGeometry.LocallyOfFiniteType g),
      C.IsSeparated ∧
      ∃ (r : ℕ) (_ : 0 < r)
        (U : Fin r → C.Opens),
        (⨆ j : Fin r, U j = ⊤) ∧
        (∀ j : Fin r, AlgebraicGeometry.IsAffineOpen (U j)) ∧
        (∀ j : Fin r, Nonempty ↥(U j)) ∧
        ∃ (n : Fin r → ℕ)
          (f : ∀ j : Fin r, Fin (n j) → ↑(C.presheaf.obj (Opposite.op (U j)))),
          (∀ j : Fin r, Function.Surjective (MvPolynomial.eval₂Hom
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
              AlgebraicGeometry.Scheme.Hom.appLE g ⊤ (U j) le_top).hom) (f j))) ∧
          ∃ (U₀ : C.Opens),
            (∀ j : Fin r, U₀ ≤ U j) ∧
            Nonempty ↥U₀ ∧
            AlgebraicGeometry.IsAffineOpen U₀ := by
    clear V hkV C_V g_V hPropV F₂ hF₂ ι₂_FV hι₂ C₂ hIntC₂ g₂ hQC₂ hSep₂ hLFP₂ ι₂_V hPb₂
    intro R _ C hIntC g hQC hSep hLFT
    let S := AlgebraicGeometry.Spec (CommRingCat.of R)
    have hSepS : S.IsSeparated := inferInstance
    have hSepTermS : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from S) := by
      rwa [AlgebraicGeometry.Scheme.isSeparated_iff] at hSepS
    have hTermEq : CategoryTheory.Limits.terminal.from C =
        g ≫ CategoryTheory.Limits.terminal.from S :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    have hSepTermC : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from C) := by
      rw [hTermEq]
      infer_instance
    have hSepC : C.IsSeparated := by
      rwa [AlgebraicGeometry.Scheme.isSeparated_iff]
    refine ⟨hSepC, ?_⟩
    have hIrredC : IrreducibleSpace ↥C := @AlgebraicGeometry.irreducibleSpace_of_isIntegral C hIntC
    have hNonC : Nonempty ↥C := hIrredC.toNonempty
    have hCompC : CompactSpace ↥C :=
      @AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace _ _ g hQC inferInstance
    have hAffAt : ∀ y : ↥C, ∃ W : C.Opens, AlgebraicGeometry.IsAffineOpen W ∧ y ∈ W := by
      intro y
      obtain ⟨W, hAffW, hyW, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
      exact ⟨W, hAffW, hyW⟩
    choose W hAffW hyW using hAffAt
    obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover (fun y : ↥C => (W y : Set ↥C))
      (fun y => (W y).isOpen) (fun y _ => Set.mem_iUnion.mpr ⟨y, hyW y⟩)
    let r : ℕ := s.card
    let e_s : ↥s ≃ Fin r := s.equivFin
    let U : Fin r → C.Opens := fun j => W (e_s.symm j).1
    have hAffU : ∀ j : Fin r, AlgebraicGeometry.IsAffineOpen (U j) :=
      fun j => hAffW (e_s.symm j).1
    have hNonU : ∀ j : Fin r, Nonempty ↥(U j) :=
      fun j => ⟨⟨(e_s.symm j).1, hyW (e_s.symm j).1⟩⟩
    have hCovU : (⨆ j : Fin r, U j) = ⊤ := by
      apply TopologicalSpace.Opens.ext
      ext x
      simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion, TopologicalSpace.Opens.coe_top,
        Set.mem_univ, iff_true]
      have hx_mem := hs (Set.mem_univ x)
      obtain ⟨y, hy_iUnion⟩ := Set.mem_iUnion.mp hx_mem
      obtain ⟨hy_s, hx_Wy⟩ := Set.mem_iUnion.mp hy_iUnion
      refine ⟨e_s ⟨y, hy_s⟩, ?_⟩
      dsimp [U]
      simpa using hx_Wy
    have hr : 0 < r := by
      obtain ⟨y₀⟩ := hNonC
      have hy₀ : y₀ ∈ (⨆ j : Fin r, U j) := by rw [hCovU]; trivial
      obtain ⟨j₀, _⟩ := TopologicalSpace.Opens.mem_iSup.mp hy₀
      exact j₀.pos
    have hGenEx : ∀ j : Fin r, ∃ (n_j : ℕ)
        (f_j : Fin n_j → ↑(C.presheaf.obj (Opposite.op (U j)))),
        Function.Surjective (MvPolynomial.eval₂Hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE g ⊤ (U j) le_top).hom) f_j) := by
      intro j
      let κ : R →+* ↑(C.presheaf.obj (Opposite.op (U j))) :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
          AlgebraicGeometry.Scheme.Hom.appLE g ⊤ (U j) le_top).hom)
      have hFT_app : RingHom.FiniteType (AlgebraicGeometry.Scheme.Hom.appLE g ⊤ (U j) le_top).hom :=
        g.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top S) (hAffU j) le_top
      have hSurj_inv : Function.Surjective
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).commRingCatIsoToRingEquiv.symm).surjective
      have hFT_inv : RingHom.FiniteType
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom :=
        RingHom.FiniteType.of_surjective _ hSurj_inv
      have hFT_κ : RingHom.FiniteType κ := by
        change RingHom.FiniteType
          ((AlgebraicGeometry.Scheme.Hom.appLE g ⊤ (U j) le_top).hom.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom)
        exact hFT_app.comp hFT_inv
      let _ : Algebra R ↑(C.presheaf.obj (Opposite.op (U j))) := κ.toAlgebra
      have hAlgFT : Algebra.FiniteType R ↑(C.presheaf.obj (Opposite.op (U j))) := hFT_κ
      obtain ⟨n_j, ψ_j, hSurj_j⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hAlgFT
      let f_j : Fin n_j → ↑(C.presheaf.obj (Opposite.op (U j))) := fun m => ψ_j (MvPolynomial.X m)
      have h_eq : MvPolynomial.eval₂Hom κ f_j = ψ_j.toRingHom := by
        apply MvPolynomial.ringHom_ext'
        · ext a
          simp only [RingHom.coe_comp, Function.comp_apply, MvPolynomial.eval₂Hom_C,
            AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
          change κ a = ψ_j (algebraMap R (MvPolynomial (Fin n_j) R) a)
          rw [ψ_j.commutes]
          rfl
        · intro m
          simp [f_j]
      refine ⟨n_j, f_j, ?_⟩
      rw [h_eq]
      exact hSurj_j
    choose n f hGen using hGenEx
    let U₀ : C.Opens := Finset.univ.inf U
    have hU₀_le : ∀ j : Fin r, U₀ ≤ U j := fun j => Finset.inf_le (Finset.mem_univ j)
    have hInfProp : ∀ (t : Finset (Fin r)), t.Nonempty →
        Nonempty ↥(t.inf U) ∧ AlgebraicGeometry.IsAffineOpen (t.inf U) := by
      intro t ht
      refine ht.cons_induction ?_ ?_
      · intro a
        rw [Finset.inf_singleton]
        exact ⟨hNonU a, hAffU a⟩
      · intro a s _ _ ih
        rw [Finset.inf_cons]
        refine ⟨?_, ?_⟩
        · obtain ⟨⟨x₁, hx₁⟩⟩ := hNonU a
          obtain ⟨⟨x₂, hx₂⟩⟩ := ih.1
          obtain ⟨z, hz⟩ := nonempty_preirreducible_inter (U a).isOpen (s.inf U).isOpen
            ⟨x₁, hx₁⟩ ⟨x₂, hx₂⟩
          exact ⟨⟨z, hz⟩⟩
        · exact (hAffU a).inf ih.2
    have hUnivNon : (Finset.univ : Finset (Fin r)).Nonempty := ⟨⟨0, hr⟩, Finset.mem_univ _⟩
    obtain ⟨hU₀, hAffU₀⟩ := hInfProp Finset.univ hUnivNon
    exact ⟨r, hr, U, hCovU, hAffU, hNonU, n, f, hGen, U₀, hU₀_le, hU₀, hAffU₀⟩

  have hStep2 : ∀ (R : Type u) [CommRing R]
      (C : AlgebraicGeometry.Scheme.{u})
      (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (r : ℕ) (_ : 0 < r)
      (U : Fin r → C.Opens)
      (n : Fin r → ℕ)
      (_ : ∀ j : Fin r, Fin (n j) → ↑(C.presheaf.obj (Opposite.op (U j))))
      (U₀ : C.Opens) (hU₀_le : ∀ j : Fin r, U₀ ≤ U j),
      ∀ (f : ∀ j : Fin r, Fin (n j) → ↑(C.presheaf.obj (Opposite.op (U j)))),
      ∃ (P : AlgebraicGeometry.Scheme.{u})
        (p_P : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (N : ℕ)
        (Φ : U₀.toScheme ⟶ P)
        (D : Fin (N + 1) → P.Opens)
        (z : ∀ (_ γ : Fin (N + 1)), ↑(P.presheaf.obj (Opposite.op (D γ))))
        (IsZeroAt : Fin r → Fin (N + 1) → Prop),
        AlgebraicGeometry.IsProper p_P ∧
        Φ ≫ p_P = U₀.ι ≫ g ∧
        (⨆ γ : Fin (N + 1), D γ = ⊤) ∧
        (∀ γ : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D γ)) ∧
        (∀ β γ : Fin (N + 1), P.basicOpen (z β γ) ≤ D β) ∧
        (∀ (j₀ : Fin r) (γ : Fin (N + 1)),
          ∃ (β : Fin (N + 1)) (u : ↑(C.presheaf.obj (Opposite.op (U j₀)))),
            IsZeroAt j₀ β ∧
            ((AlgebraicGeometry.Scheme.Hom.app Φ (D γ)).hom (z β γ)) *
              ((AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j₀)
                ((TopologicalSpace.Opens.map Φ.base).obj (D γ))
                (fun x _ => hU₀_le j₀ x.2)).hom u) = 1) ∧
        (∀ (j : Fin r) (β : Fin (N + 1)), IsZeroAt j β →
          ∀ m : Fin (n j), ∃ β_m : Fin (N + 1),
            (AlgebraicGeometry.Scheme.Hom.app Φ (D β)).hom (z β_m β) =
              (AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j)
                ((TopologicalSpace.Opens.map Φ.base).obj (D β))
                (fun x _ => hU₀_le j x.2)).hom (f j m)) := by
    clear hStep1 V hkV C_V g_V hPropV F₂ hF₂ ι₂_FV hι₂ C₂ hIntC₂ g₂ hQC₂ hSep₂ hLFP₂ ι₂_V hPb₂
    intro R _ C g r _hr U n _ U₀ hU₀_le f
    let f_tilde : ∀ j : Fin r, Fin (n j + 1) → ↑(C.presheaf.obj (Opposite.op (U j))) :=
      fun j => Fin.cases 1 (f j)
    let M : ℕ := ∏ j : Fin r, (n j + 1)
    have hM_pos : 1 ≤ M := Finset.one_le_prod fun j _ => Nat.succ_pos (n j)
    let N : ℕ := M - 1
    have hN_card : N + 1 = Fintype.card (∀ j : Fin r, Fin (n j + 1)) := by
      rw [Fintype.card_pi]
      simp only [Fintype.card_fin]
      change (∏ j : Fin r, (n j + 1)) - 1 + 1 = ∏ j : Fin r, (n j + 1)
      omega
    let e : Fin (N + 1) ≃ (∀ j : Fin r, Fin (n j + 1)) :=
      (finCongr hN_card).trans (Fintype.equivFin (∀ j : Fin r, Fin (n j + 1))).symm
    let IsZeroAt : Fin r → Fin (N + 1) → Prop := fun j β => (e β) j = 0
    let i₀ : Fin (N + 1) := e.symm (fun _ => 0)

    let A₀ := ↑(U₀.toScheme.presheaf.obj (Opposite.op ⊤))
    let ρ : ∀ j : Fin r, ↑(C.presheaf.obj (Opposite.op (U j))) →+* A₀ :=
      fun j => (AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j) ⊤ (fun x _ => hU₀_le j x.2)).hom
    let g_seg : Fin (N + 1) → A₀ := fun α => ∏ j : Fin r, ρ j (f_tilde j (e α j))
    have hg_i₀ : g_seg i₀ = 1 := by
      simp [g_seg, i₀, f_tilde]

    have hg_shift : ∀ (j₀ : Fin r) (γ : Fin (N + 1)),
        let β := e.symm (Function.update (e γ) j₀ 0)
        let u := f_tilde j₀ (e γ j₀)
        IsZeroAt j₀ β ∧ g_seg β * ρ j₀ u = g_seg γ := by
      intro j₀ γ
      refine ⟨by simp [IsZeroAt], ?_⟩
      dsimp only [g_seg]
      rw [e.apply_symm_apply]
      rw [← Finset.mul_prod_erase Finset.univ (fun j => ρ j (f_tilde j (Function.update (e γ) j₀ 0 j)))
        (Finset.mem_univ j₀)]
      rw [← Finset.mul_prod_erase Finset.univ (fun j => ρ j (f_tilde j (e γ j)))
        (Finset.mem_univ j₀)]
      have h_eq_erase :
          (∏ j ∈ Finset.univ.erase j₀, ρ j (f_tilde j (Function.update (e γ) j₀ 0 j))) =
          (∏ j ∈ Finset.univ.erase j₀, ρ j (f_tilde j (e γ j))) := by
        refine Finset.prod_congr rfl fun j hj => ?_
        rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)]
      rw [Function.update_self, h_eq_erase]
      have hf0 : ρ j₀ (f_tilde j₀ 0) = 1 := by simp [f_tilde]
      rw [hf0, one_mul, mul_comm]

    have hg_recov : ∀ (j₀ : Fin r) (β : Fin (N + 1)), IsZeroAt j₀ β →
        ∀ m : Fin (n j₀),
          let β_m := e.symm (Function.update (e β) j₀ m.succ)
          g_seg β_m = g_seg β * ρ j₀ (f j₀ m) := by
      intro j₀ β hZ m
      dsimp only [g_seg]
      rw [e.apply_symm_apply]
      rw [← Finset.mul_prod_erase Finset.univ
        (fun j => ρ j (f_tilde j (Function.update (e β) j₀ m.succ j))) (Finset.mem_univ j₀)]
      rw [← Finset.mul_prod_erase Finset.univ (fun j => ρ j (f_tilde j (e β j)))
        (Finset.mem_univ j₀)]
      have h_eq_erase :
          (∏ j ∈ Finset.univ.erase j₀, ρ j (f_tilde j (Function.update (e β) j₀ m.succ j))) =
          (∏ j ∈ Finset.univ.erase j₀, ρ j (f_tilde j (e β j))) := by
        refine Finset.prod_congr rfl fun j hj => ?_
        rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)]
      rw [Function.update_self, h_eq_erase]
      have hZ' : e β j₀ = 0 := hZ
      rw [hZ']
      change ρ j₀ (f j₀ m) * (∏ j ∈ Finset.univ.erase j₀, ρ j (f_tilde j (e β j))) =
        (ρ j₀ 1 * ∏ j ∈ Finset.univ.erase j₀, ρ j (f_tilde j (e β j))) * ρ j₀ (f j₀ m)
      rw [map_one, one_mul, mul_comm]

    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let P : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
    let c₀ : R →+* ↥(𝒜 0) := algebraMap R ↥(𝒜 0)
    have hBij_c₀ : Function.Bijective c₀ := by
      refine ⟨?_, ?_⟩
      · intro a b hab
        have hval : (c₀ a).1 = (c₀ b).1 := congrArg Subtype.val hab
        change MvPolynomial.C a = MvPolynomial.C b at hval
        have hc := congrArg (fun p : MvPolynomial (Fin (N + 1)) R => p.coeff 0) hval
        simpa [MvPolynomial.coeff_C] using hc
      · intro p
        refine ⟨p.1.coeff 0, Subtype.ext ?_⟩
        change MvPolynomial.C (p.1.coeff 0) = p.1
        rw [← MvPolynomial.homogeneousComponent_zero]
        have hp := MvPolynomial.homogeneousComponent_of_mem (m := 0) p.2
        simpa using hp
    let e₀ : AlgebraicGeometry.Spec (CommRingCat.of ↥(𝒜 0)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom c₀)
    have _ : CategoryTheory.IsIso e₀ := AlgebraicGeometry.isIso_SpecMap_iff.mpr hBij_c₀
    let _ : IsScalarTower R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      @IsScalarTower.of_algebraMap_eq R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) _ _ _ _ _ _
        (fun _ => rfl)
    have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R)
    let p_P : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫ e₀
    have hPropP : AlgebraicGeometry.IsProper p_P := inferInstance

    let X_var : Fin (N + 1) → MvPolynomial (Fin (N + 1)) R := MvPolynomial.X
    have hX_mem : ∀ α : Fin (N + 1), X_var α ∈ 𝒜 1 :=
      fun α => MvPolynomial.isHomogeneous_X R α

    let valHom : ∀ (f₀ : MvPolynomial (Fin (N + 1)) R),
        HomogeneousLocalization.Away 𝒜 f₀ →+* Localization.Away f₀ := fun _ =>
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }

    let κ₀ : R →+* A₀ :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ (U₀.ι ≫ g).appTop).hom)
    let ψ : MvPolynomial (Fin (N + 1)) R →+* A₀ := MvPolynomial.eval₂Hom κ₀ g_seg
    have hψ_Xi₀ : ψ (X_var i₀) = 1 := by simp [ψ, X_var, hg_i₀]
    let ψ_loc : Localization.Away (X_var i₀) →+* A₀ :=
      IsLocalization.Away.lift (X_var i₀) (by rw [hψ_Xi₀]; exact isUnit_one)
    let φ₀ : HomogeneousLocalization.Away 𝒜 (X_var i₀) →+* A₀ := ψ_loc.comp (valHom (X_var i₀))

    have hφ₀_mk : ∀ (d : ℕ) (a : MvPolynomial (Fin (N + 1)) R) (ha : a ∈ 𝒜 (d • 1)),
        φ₀ (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i₀) d a ha) = ψ a := by
      intro d a ha
      change ψ_loc (HomogeneousLocalization.val
        (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i₀) d a ha)) = ψ a
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
      let s : Submonoid.powers (X_var i₀) := ⟨(X_var i₀) ^ d, d, rfl⟩
      have hs_one : ψ_loc (algebraMap _ (Localization.Away (X_var i₀)) s.1) = 1 := by
        rw [IsLocalization.Away.lift_eq]
        simp [s, map_pow, hψ_Xi₀]
      calc
        ψ_loc (IsLocalization.mk' (Localization.Away (X_var i₀)) a s)
          = ψ_loc (IsLocalization.mk' (Localization.Away (X_var i₀)) a s) *
              ψ_loc (algebraMap _ (Localization.Away (X_var i₀)) s.1) := by rw [hs_one, mul_one]
        _ = ψ_loc (IsLocalization.mk' (Localization.Away (X_var i₀)) a s *
              algebraMap _ (Localization.Away (X_var i₀)) s.1) := by rw [← map_mul]
        _ = ψ_loc (algebraMap _ (Localization.Away (X_var i₀)) a) := by
              rw [IsLocalization.mk'_spec]
        _ = ψ a := IsLocalization.Away.lift_eq _ _ a

    let ι_γ : ∀ γ : Fin (N + 1),
        AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var γ))) ⟶ P :=
      fun γ => AlgebraicGeometry.Proj.awayι 𝒜 (X_var γ) (hX_mem γ) zero_lt_one
    let Φ : U₀.toScheme ⟶ P :=
      U₀.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ ι_γ i₀

    have h_appLE_congrU : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f_hom : X ⟶ Y)
        {U₁ U₂ : Y.Opens} (hU : U₁ = U₂) (V : X.Opens)
        (h₁ : V ≤ (TopologicalSpace.Opens.map f_hom.base).obj U₁)
        (h₂ : V ≤ (TopologicalSpace.Opens.map f_hom.base).obj U₂),
        f_hom.appLE U₁ V h₁ = Y.presheaf.map (CategoryTheory.eqToHom hU.symm).op ≫ f_hom.appLE U₂ V h₂ := by
      intro X Y f_hom U₁ U₂ hU V h₁ h₂
      subst hU
      simp

    have hΦ : Φ ≫ p_P = U₀.ι ≫ g := by
      dsimp only [Φ, p_P, ι_γ, e₀]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc
          (AlgebraicGeometry.Proj.awayι 𝒜 (X_var i₀) (hX_mem i₀) zero_lt_one),
        AlgebraicGeometry.Proj.awayι_toSpecZero,
        ← AlgebraicGeometry.Spec.map_comp]
      erw [← AlgebraicGeometry.Spec.map_comp]
      have h_ring : (CommRingCat.ofHom c₀ ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (X_var i₀)))) ≫
          CommRingCat.ofHom φ₀ =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ (U₀.ι ≫ g).appTop := by
        ext r₀
        change ψ_loc (Localization.mk (MvPolynomial.C r₀) 1) = κ₀ r₀
        rw [Localization.mk_one_eq_algebraMap, IsLocalization.Away.lift_eq]
        simp [ψ]
      erw [h_ring, AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Scheme.toSpecΓ_naturality (U₀.ι ≫ g),
        CategoryTheory.Category.assoc,
        AlgebraicGeometry.toSpecΓ_SpecMap_ΓSpecIso_inv,
        CategoryTheory.Category.comp_id]

    let D : Fin (N + 1) → P.Opens := fun γ => AlgebraicGeometry.Proj.basicOpen 𝒜 (X_var γ)
    have hAffD : ∀ γ : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D γ) :=
      fun γ => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (X_var γ) (hX_mem γ) zero_lt_one
    have hCovD : (⨆ γ : Fin (N + 1), D γ) = ⊤ := by
      refine AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 X_var (fun γ => ⟨1, hX_mem γ⟩) ?_
      rw [eq_top_iff]
      intro p _
      refine MvPolynomial.induction_on p ?_ ?_ ?_
      · intro a
        have ha : MvPolynomial.C a = algebraMap ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) (c₀ a) := rfl
        rw [ha]
        exact Subalgebra.algebraMap_mem _ (c₀ a)
      · intro p₁ p₂ hp₁ hp₂
        exact add_mem hp₁ hp₂
      · intro q γ hq
        exact mul_mem hq (Algebra.subset_adjoin ⟨γ, rfl⟩)

    let e_γ : ∀ γ : Fin (N + 1),
        (D γ).toScheme ≅
          AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var γ))) :=
      fun γ => AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (X_var γ) (hX_mem γ) zero_lt_one
    have h_inv_ι : ∀ γ : Fin (N + 1), (e_γ γ).inv ≫ (D γ).ι = ι_γ γ :=
      fun γ => AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (X_var γ) (hX_mem γ) zero_lt_one

    let w_elem : ∀ (β γ : Fin (N + 1)), HomogeneousLocalization.Away 𝒜 (X_var γ) :=
      fun β γ => HomogeneousLocalization.Away.isLocalizationElem (hX_mem γ) (hX_mem β)
    let z : ∀ (β γ : Fin (N + 1)), ↑(P.presheaf.obj (Opposite.op (D γ))) :=
      fun β γ =>
        ((AlgebraicGeometry.Scheme.ΓSpecIso
            (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var γ)))).inv ≫
          (e_γ γ).hom.appTop ≫ (D γ).topIso.hom).hom (w_elem β γ)

    have h_ιγ_appLE : ∀ (β γ : Fin (N + 1))
        (h_le : (⊤ : (AlgebraicGeometry.Spec
          (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var γ)))).Opens) ≤
            (TopologicalSpace.Opens.map (ι_γ γ).base).obj (D γ)),
        ((ι_γ γ).appLE (D γ) ⊤ h_le).hom (z β γ) =
          ((AlgebraicGeometry.Scheme.ΓSpecIso
            (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var γ)))).inv).hom (w_elem β γ) := by
      intro β γ h_le
      have h_comp : (ι_γ γ).appLE (D γ) ⊤ h_le =
          (D γ).topIso.inv ≫ (e_γ γ).inv.appTop := by
        have h_eq : ι_γ γ = (e_γ γ).inv ≫ (D γ).ι := (h_inv_ι γ).symm
        have h_le' : (⊤ : (AlgebraicGeometry.Spec _).Opens) ≤
            (TopologicalSpace.Opens.map ((e_γ γ).inv ≫ (D γ).ι).base).obj (D γ) := by
          rwa [← h_eq]
        have h1 : (ι_γ γ).appLE (D γ) ⊤ h_le = ((e_γ γ).inv ≫ (D γ).ι).appLE (D γ) ⊤ h_le' := by
          congr! 1
        rw [h1, AlgebraicGeometry.Scheme.Hom.comp_appLE (e_γ γ).inv (D γ).ι (D γ) ⊤ h_le']
        have hD_pre : (TopologicalSpace.Opens.map (D γ).ι.base).obj (D γ) = ⊤ := by
          apply TopologicalSpace.Opens.ext
          ext x
          exact ⟨fun _ => trivial, fun _ => x.2⟩
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE (D γ).ι,
          AlgebraicGeometry.Scheme.Opens.ι_appLE]
        have h_inv_top : (e_γ γ).inv.appLE ((TopologicalSpace.Opens.map (D γ).ι.base).obj (D γ))
            ⊤ h_le' =
            (D γ).toScheme.presheaf.map (CategoryTheory.eqToHom hD_pre.symm).op ≫
              (e_γ γ).inv.appTop := by
          have h_app_top : (e_γ γ).inv.appTop = (e_γ γ).inv.appLE ⊤ ⊤ le_rfl := by
            unfold AlgebraicGeometry.Scheme.Hom.appTop
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
            rfl
          rw [h_app_top]
          exact h_appLE_congrU (e_γ γ).inv hD_pre ⊤ h_le' le_rfl
        rw [h_inv_top]
        apply (CategoryTheory.Category.assoc _ _ _).symm.trans
        congr 1
      dsimp only [z]
      change (((AlgebraicGeometry.Scheme.ΓSpecIso _).inv ≫ (e_γ γ).hom.appTop ≫ (D γ).topIso.hom) ≫
        (ι_γ γ).appLE (D γ) ⊤ h_le).hom (w_elem β γ) = _
      rw [h_comp]
      have h_iso_app : (e_γ γ).hom.appTop ≫ (e_γ γ).inv.appTop = 𝟙 _ := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, (e_γ γ).inv_hom_id]
        rfl
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc,
        h_iso_app, CategoryTheory.Category.comp_id]

    have hz_basic : ∀ β γ : Fin (N + 1), P.basicOpen (z β γ) ≤ D β := by
      intro β γ y hy
      have hy_γ : y ∈ D γ := P.basicOpen_le (z β γ) hy
      let q : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var γ))) :=
        (e_γ γ).hom.base ⟨y, hy_γ⟩
      have hq_eq : (ι_γ γ).base q = y := by
        rw [← h_inv_ι γ]
        change ((e_γ γ).hom ≫ (e_γ γ).inv ≫ (D γ).ι).base ⟨y, hy_γ⟩ = y
        rw [← CategoryTheory.Category.assoc, (e_γ γ).hom_inv_id, CategoryTheory.Category.id_comp]
        rfl
      have h_le_top : (⊤ : (AlgebraicGeometry.Spec _).Opens) ≤
          (TopologicalSpace.Opens.map (ι_γ γ).base).obj (D γ) := by
        intro p _
        rw [← h_inv_ι γ]
        exact ((e_γ γ).inv.base p).2
      have h_bo_eq : (AlgebraicGeometry.Spec
          (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var γ)))).basicOpen
            (((ι_γ γ).appLE (D γ) ⊤ h_le_top).hom (z β γ)) =
          (TopologicalSpace.Opens.map (ι_γ γ).base).obj (P.basicOpen (z β γ)) := by
        have h_res : ((ι_γ γ).appLE (D γ) ⊤ h_le_top).hom (z β γ) =
            (((AlgebraicGeometry.Spec _).presheaf.map (CategoryTheory.homOfLE h_le_top).op).hom
              (((ι_γ γ).app (D γ)).hom (z β γ))) := rfl
        rw [h_res, AlgebraicGeometry.Scheme.basicOpen_res,
          ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, top_inf_eq]
      have h_bo_Dβ : (AlgebraicGeometry.Spec
          (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var γ)))).basicOpen
            (((ι_γ γ).appLE (D γ) ⊤ h_le_top).hom (z β γ)) =
          (TopologicalSpace.Opens.map (ι_γ γ).base).obj (D β) := by
        rw [h_ιγ_appLE β γ h_le_top, AlgebraicGeometry.basicOpen_eq_of_affine,
          ← AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX_mem γ) zero_lt_one (hX_mem β)
            zero_lt_one]
      have hq_mem : q ∈ (TopologicalSpace.Opens.map (ι_γ γ).base).obj (P.basicOpen (z β γ)) := by
        change (ι_γ γ).base q ∈ P.basicOpen (z β γ)
        rwa [hq_eq]
      rw [← h_bo_eq, h_bo_Dβ] at hq_mem
      change (ι_γ γ).base q ∈ D β at hq_mem
      rwa [hq_eq] at hq_mem

    have hRatio : ∀ (β γ : Fin (N + 1)),
        ((AlgebraicGeometry.Scheme.Hom.app Φ (D γ)).hom (z β γ)) *
          ((U₀.toScheme.presheaf.map
            (CategoryTheory.homOfLE
              (le_top : (TopologicalSpace.Opens.map Φ.base).obj (D γ) ≤ ⊤)).op).hom (g_seg γ)) =
        (U₀.toScheme.presheaf.map
          (CategoryTheory.homOfLE
            (le_top : (TopologicalSpace.Opens.map Φ.base).obj (D γ) ≤ ⊤)).op).hom (g_seg β) := by
      intro β γ
      let W_γ : U₀.toScheme.Opens := (TopologicalSpace.Opens.map Φ.base).obj (D γ)
      let B_γ := ↑(U₀.toScheme.presheaf.obj (Opposite.op W_γ))
      let res_γ : A₀ →+* B_γ :=
        (U₀.toScheme.presheaf.map (CategoryTheory.homOfLE (le_top : W_γ ≤ ⊤)).op).hom
      have hW_γ_eq : W_γ = U₀.toScheme.basicOpen (g_seg γ) := by
        change (TopologicalSpace.Opens.map
          ((U₀.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) ≫
            ι_γ i₀).base).obj (D γ) = U₀.toScheme.basicOpen (g_seg γ)
        have h1 : (TopologicalSpace.Opens.map
            ((U₀.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) ≫
              ι_γ i₀).base).obj (D γ) =
            (TopologicalSpace.Opens.map
              (U₀.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)).base).obj
                ((TopologicalSpace.Opens.map (ι_γ i₀).base).obj (D γ)) := rfl
        rw [h1, AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX_mem i₀) zero_lt_one
          (hX_mem γ) zero_lt_one,
          ← AlgebraicGeometry.basicOpen_eq_of_affine
            (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var i₀))),
          AlgebraicGeometry.Scheme.Hom.preimage_basicOpen]
        congr 1
        have h_app : ((AlgebraicGeometry.Scheme.ΓSpecIso _).inv ≫
            (U₀.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)).appTop) =
            CommRingCat.ofHom φ₀ := by
          rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
            AlgebraicGeometry.Scheme.toSpecΓ_appTop (X := U₀.toScheme)]
          have h_nat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom φ₀)
          ext x
          exact congrArg (fun m => m.hom x) ((CategoryTheory.Iso.inv_comp_eq _).mpr h_nat)
        change (((AlgebraicGeometry.Scheme.ΓSpecIso _).inv ≫
          (U₀.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)).appTop).hom
            (w_elem γ i₀)) = g_seg γ
        rw [h_app]
        change φ₀ (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i₀) 1 ((X_var γ) ^ 1) _) = g_seg γ
        rw [hφ₀_mk]
        simp [ψ, X_var]

      have hUnit_γ : IsUnit (res_γ (g_seg γ)) := by
        have h_u := AlgebraicGeometry.RingedSpace.isUnit_res_basicOpen U₀.toScheme.toRingedSpace (g_seg γ)
        have h_eq_hom : U₀.toScheme.presheaf.map (CategoryTheory.homOfLE (le_top : W_γ ≤ ⊤)).op =
            U₀.toScheme.presheaf.map (CategoryTheory.homOfLE (U₀.toScheme.basicOpen_le (g_seg γ))).op ≫
            U₀.toScheme.presheaf.map (CategoryTheory.eqToHom hW_γ_eq).op := by
          rw [← U₀.toScheme.presheaf.map_comp]
          congr 1
        change IsUnit ((U₀.toScheme.presheaf.map (CategoryTheory.homOfLE (le_top : W_γ ≤ ⊤)).op).hom
          (g_seg γ))
        rw [h_eq_hom]
        exact ((U₀.toScheme.presheaf.map (CategoryTheory.eqToHom hW_γ_eq).op).hom).isUnit_map h_u

      let X_i₀γ : MvPolynomial (Fin (N + 1)) R := X_var i₀ * X_var γ
      have hX_i₀γ : X_i₀γ ∈ 𝒜 (1 + 1) := SetLike.GradedMul.mul_mem (hX_mem i₀) (hX_mem γ)
      let ψ_γ : MvPolynomial (Fin (N + 1)) R →+* B_γ := res_γ.comp ψ
      have hψ_γ_unit : IsUnit (ψ_γ X_i₀γ) := by
        dsimp only [ψ_γ, X_i₀γ, RingHom.comp_apply]
        have hψ_Xγ : ψ (X_var γ) = g_seg γ := by simp [ψ, X_var]
        rw [map_mul, map_mul, hψ_Xi₀, hψ_Xγ, map_one, one_mul]
        exact hUnit_γ
      let ψ_γ_loc : Localization.Away X_i₀γ →+* B_γ :=
        IsLocalization.Away.lift X_i₀γ hψ_γ_unit
      let φ_γ : HomogeneousLocalization.Away 𝒜 X_i₀γ →+* B_γ :=
        ψ_γ_loc.comp (valHom X_i₀γ)

      have hφ_γ_mk : ∀ (d : ℕ) (a : MvPolynomial (Fin (N + 1)) R) (ha : a ∈ 𝒜 (d • (1 + 1))),
          φ_γ (HomogeneousLocalization.Away.mk 𝒜 hX_i₀γ d a ha) * (res_γ (g_seg γ)) ^ d = ψ_γ a := by
        intro d a ha
        change ψ_γ_loc (HomogeneousLocalization.val
          (HomogeneousLocalization.Away.mk 𝒜 hX_i₀γ d a ha)) * (res_γ (g_seg γ)) ^ d = ψ_γ a
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
        let s : Submonoid.powers X_i₀γ := ⟨X_i₀γ ^ d, d, rfl⟩
        have hs_eq : ψ_γ_loc (algebraMap _ (Localization.Away X_i₀γ) s.1) = (res_γ (g_seg γ)) ^ d := by
          rw [IsLocalization.Away.lift_eq]
          dsimp only [s, ψ_γ, X_i₀γ, RingHom.comp_apply]
          rw [map_pow, map_pow, map_mul, map_mul, hψ_Xi₀, map_one, one_mul]
          simp [ψ, X_var]
        rw [← hs_eq, ← map_mul, IsLocalization.mk'_spec, IsLocalization.Away.lift_eq]

      have hφ_γ_comp_i₀ :
          φ_γ.comp (HomogeneousLocalization.awayMap 𝒜 (hX_mem γ) (rfl : X_i₀γ = X_var i₀ * X_var γ)) =
          res_γ.comp φ₀ := by
        ext x
        obtain ⟨d, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX_mem i₀) x
        refine (hUnit_γ.pow d).mul_right_cancel ?_
        dsimp only [RingHom.comp_apply]
        rw [HomogeneousLocalization.awayMap_mk, hφ_γ_mk, hφ₀_mk]
        change res_γ (ψ (a * (X_var γ) ^ d)) = res_γ (ψ a) * (res_γ (g_seg γ)) ^ d
        simp [ψ, X_var, map_mul, map_pow]

      let α_hom : CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var γ)) ⟶
          W_γ.toScheme.presheaf.obj (Opposite.op ⊤) :=
        CommRingCat.ofHom
          (φ_γ.comp (HomogeneousLocalization.awayMap 𝒜 (hX_mem i₀) (mul_comm (X_var i₀) (X_var γ)))) ≫
          W_γ.topIso.inv
      have hW_Φ : W_γ.ι ≫ Φ =
          (W_γ.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map α_hom) ≫ ι_γ γ := by
        dsimp only [Φ]
        rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.toSpecΓ_naturality W_γ.ι]
        have h_ι_top : W_γ.ι.appTop =
            U₀.toScheme.presheaf.map (CategoryTheory.homOfLE (le_top : W_γ ≤ ⊤)).op ≫
              W_γ.topIso.inv := by
          change W_γ.ι.app ⊤ = _
          erw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE W_γ.ι,
            AlgebraicGeometry.Scheme.Opens.ι_appLE, AlgebraicGeometry.Scheme.Opens.topIso_inv]
          erw [← U₀.toScheme.presheaf.map_comp]
          congr 1
        rw [h_ι_top]
        have h_ring_i₀ : CommRingCat.ofHom φ₀ ≫
            (U₀.toScheme.presheaf.map (CategoryTheory.homOfLE (le_top : W_γ ≤ ⊤)).op ≫
              W_γ.topIso.inv) =
            CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜 (hX_mem γ) rfl) ≫
              CommRingCat.ofHom φ_γ ≫ W_γ.topIso.inv := by
          ext x
          change (W_γ.topIso.inv).hom (res_γ (φ₀ x)) =
            (W_γ.topIso.inv).hom (φ_γ (HomogeneousLocalization.awayMap 𝒜 (hX_mem γ) rfl x))
          have hx := RingHom.congr_fun hφ_γ_comp_i₀.symm x
          exact congrArg (W_γ.topIso.inv).hom hx
        have h_spec_pair :
            AlgebraicGeometry.Spec.map
              (U₀.toScheme.presheaf.map (CategoryTheory.homOfLE (le_top : W_γ ≤ ⊤)).op ≫
                W_γ.topIso.inv) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜 (hX_mem γ) rfl) ≫
                CommRingCat.ofHom φ_γ ≫ W_γ.topIso.inv) :=
          (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
            (congrArg AlgebraicGeometry.Spec.map h_ring_i₀)
        have h_lhs_step :
            ((W_γ.toScheme.toSpecΓ ≫
                AlgebraicGeometry.Spec.map
                  (U₀.toScheme.presheaf.map (CategoryTheory.homOfLE (le_top : W_γ ≤ ⊤)).op ≫
                    W_γ.topIso.inv)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) ≫
              ι_γ i₀ =
            (W_γ.toScheme.toSpecΓ ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜 (hX_mem γ) rfl) ≫
                  CommRingCat.ofHom φ_γ ≫ W_γ.topIso.inv)) ≫
              ι_γ i₀ :=
          congrArg (· ≫ ι_γ i₀)
            ((CategoryTheory.Category.assoc _ _ _).trans
              (congrArg (W_γ.toScheme.toSpecΓ ≫ ·) h_spec_pair))
        erw [h_lhs_step]
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX_mem i₀) zero_lt_one (hX_mem γ)
            (rfl : X_i₀γ = X_var i₀ * X_var γ)]
        have h_symm := AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX_mem γ) zero_lt_one
          (hX_mem i₀) (mul_comm (X_var i₀) (X_var γ) : X_i₀γ = X_var γ * X_var i₀)
        have h_awayι_eq : AlgebraicGeometry.Proj.awayι 𝒜 X_i₀γ hX_i₀γ (Nat.succ_pos 1) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.awayMap 𝒜 (hX_mem i₀) (mul_comm (X_var i₀) (X_var γ)))) ≫
              ι_γ γ := by
          convert h_symm.symm using 1
        rw [h_awayι_eq]
        dsimp only [α_hom]
        rw [CommRingCat.ofHom_comp _ φ_γ, AlgebraicGeometry.Spec.map_comp,
          AlgebraicGeometry.Spec.map_comp]
        simp only [CategoryTheory.Category.assoc]

      have h_le_W : (⊤ : W_γ.toScheme.Opens) ≤
          (TopologicalSpace.Opens.map (W_γ.ι ≫ Φ).base).obj (D γ) := fun x _ => x.2
      have h_app_eq : Φ.app (D γ) = (W_γ.ι ≫ Φ).appLE (D γ) ⊤ h_le_W ≫ W_γ.topIso.hom := by
        rw [AlgebraicGeometry.Scheme.Hom.comp_appLE W_γ.ι Φ (D γ) ⊤ h_le_W]
        have h_wtop : W_γ.ι.appLE W_γ ⊤ (fun x _ => x.2) = W_γ.topIso.inv := by
          erw [AlgebraicGeometry.Scheme.Opens.ι_appLE, AlgebraicGeometry.Scheme.Opens.topIso_inv]
          congr 1
        change Φ.app (D γ) = (Φ.app (D γ) ≫ W_γ.ι.appLE W_γ ⊤ (fun x _ => x.2)) ≫ W_γ.topIso.hom
        rw [h_wtop, CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.comp_id]

      have h_val_z : (Φ.app (D γ)).hom (z β γ) =
          φ_γ (HomogeneousLocalization.awayMap 𝒜 (hX_mem i₀) (mul_comm (X_var i₀) (X_var γ))
            (w_elem β γ)) := by
        rw [h_app_eq]
        let g_aff : W_γ.toScheme ⟶
            AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var γ))) :=
          W_γ.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map α_hom
        have h_le_spec : (⊤ : (AlgebraicGeometry.Spec _).Opens) ≤
            (TopologicalSpace.Opens.map (ι_γ γ).base).obj (D γ) := by
          intro p _; rw [← h_inv_ι γ]; exact ((e_γ γ).inv.base p).2
        have h_le_W' : (⊤ : W_γ.toScheme.Opens) ≤
            (TopologicalSpace.Opens.map (g_aff ≫ ι_γ γ).base).obj (D γ) := by
          change (⊤ : W_γ.toScheme.Opens) ≤
            (TopologicalSpace.Opens.map ((W_γ.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map α_hom) ≫
              ι_γ γ).base).obj (D γ)
          rwa [← hW_Φ]
        have h_congr : (W_γ.ι ≫ Φ).appLE (D γ) ⊤ h_le_W = (g_aff ≫ ι_γ γ).appLE (D γ) ⊤ h_le_W' := by
          congr! 1
        have h_comp_g : (g_aff ≫ ι_γ γ).appLE (D γ) ⊤ h_le_W' =
            (ι_γ γ).appLE (D γ) ⊤ h_le_spec ≫ g_aff.appTop := by
          rw [AlgebraicGeometry.Scheme.Hom.comp_appLE g_aff (ι_γ γ) (D γ) ⊤ h_le_W',
            AlgebraicGeometry.Scheme.Hom.app_eq_appLE (ι_γ γ)]
          have h_spec_top : (TopologicalSpace.Opens.map (ι_γ γ).base).obj (D γ) = ⊤ :=
            top_le_iff.mp h_le_spec
          have h_g_app : g_aff.appLE ((TopologicalSpace.Opens.map (ι_γ γ).base).obj (D γ)) ⊤ h_le_W' =
              (AlgebraicGeometry.Spec _).presheaf.map (CategoryTheory.eqToHom h_spec_top.symm).op ≫
                g_aff.appTop := by
            have hg_top : g_aff.appTop = g_aff.appLE ⊤ ⊤ le_rfl := by
              unfold AlgebraicGeometry.Scheme.Hom.appTop
              rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
              rfl
            rw [hg_top]
            exact h_appLE_congrU g_aff h_spec_top ⊤ h_le_W' le_rfl
          rw [h_g_app, ← CategoryTheory.Category.assoc]
          congr 1
        rw [h_congr, h_comp_g]
        change (g_aff.appTop ≫ W_γ.topIso.hom).hom (((ι_γ γ).appLE (D γ) ⊤ h_le_spec).hom (z β γ)) = _
        rw [h_ιγ_appLE β γ h_le_spec]
        change ((AlgebraicGeometry.Scheme.ΓSpecIso _).inv ≫ g_aff.appTop ≫ W_γ.topIso.hom).hom
          (w_elem β γ) = _
        dsimp only [g_aff]
        rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
          AlgebraicGeometry.Scheme.toSpecΓ_appTop (X := W_γ.toScheme)]
        have h_nat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality α_hom
        have h_simp : (AlgebraicGeometry.Scheme.ΓSpecIso _).inv ≫
            ((AlgebraicGeometry.Spec.map α_hom).appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (W_γ.toScheme.presheaf.obj (Opposite.op ⊤))).hom) ≫
            W_γ.topIso.hom =
            CommRingCat.ofHom
              (φ_γ.comp (HomogeneousLocalization.awayMap 𝒜 (hX_mem i₀)
                (mul_comm (X_var i₀) (X_var γ)))) := by
          rw [h_nat, CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
          dsimp only [α_hom]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
            CategoryTheory.Category.comp_id]
        rw [h_simp]
        rfl

      rw [h_val_z]
      change φ_γ (HomogeneousLocalization.awayMap 𝒜 (hX_mem i₀) (mul_comm (X_var i₀) (X_var γ))
        (HomogeneousLocalization.Away.mk 𝒜 (hX_mem γ) 1 ((X_var β) ^ 1) _)) * res_γ (g_seg γ) =
        res_γ (g_seg β)
      rw [HomogeneousLocalization.awayMap_mk]
      have h1 := hφ_γ_mk 1 ((X_var β) ^ 1 * (X_var i₀) ^ 1) (by
        rw [one_smul, pow_one, pow_one]
        exact SetLike.GradedMul.mul_mem (hX_mem β) (hX_mem i₀))
      simpa [ψ_γ, ψ, X_var, hψ_Xi₀, hg_i₀] using h1

    have hResU₀ : ∀ (j : Fin r) (γ : Fin (N + 1)) (u : ↑(C.presheaf.obj (Opposite.op (U j)))),
        (AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j)
          ((TopologicalSpace.Opens.map Φ.base).obj (D γ))
          (fun x _ => hU₀_le j x.2)).hom u =
        (U₀.toScheme.presheaf.map
          (CategoryTheory.homOfLE (le_top : (TopologicalSpace.Opens.map Φ.base).obj (D γ) ≤ ⊤)).op).hom
            (ρ j u) := by
      intro j γ u
      dsimp only [ρ]
      erw [AlgebraicGeometry.Scheme.Opens.ι_appLE, AlgebraicGeometry.Scheme.Opens.ι_appLE]
      have h_comp_map : C.presheaf.map
            (CategoryTheory.homOfLE (Set.image_subset_iff.mpr
              (fun (x : ↥U₀.toScheme) (_ : x ∈ (⊤ : U₀.toScheme.Opens)) => hU₀_le j x.2))).op ≫
          U₀.toScheme.presheaf.map
            (CategoryTheory.homOfLE (le_top : (TopologicalSpace.Opens.map Φ.base).obj (D γ) ≤ ⊤)).op =
          C.presheaf.map
            (CategoryTheory.homOfLE (Set.image_subset_iff.mpr
              (fun (x : ↥U₀.toScheme) (_ : x ∈ (TopologicalSpace.Opens.map Φ.base).obj (D γ)) =>
                hU₀_le j x.2))).op := by
        erw [← C.presheaf.map_comp]
        rfl
      exact (congrArg (fun m => m.hom u) h_comp_map).symm

    refine ⟨P, p_P, N, Φ, D, z, IsZeroAt, hPropP, hΦ, hCovD, hAffD, hz_basic, ?_, ?_⟩
    · intro j₀ γ
      let β := e.symm (Function.update (e γ) j₀ 0)
      let u := f_tilde j₀ (e γ j₀)
      obtain ⟨hZβ, hProdEq⟩ := hg_shift j₀ γ
      refine ⟨β, u, hZβ, ?_⟩
      rw [hResU₀ j₀ γ u]
      let res_γ := (U₀.toScheme.presheaf.map
        (CategoryTheory.homOfLE (le_top : (TopologicalSpace.Opens.map Φ.base).obj (D γ) ≤ ⊤)).op).hom
      have hR_βγ : (Φ.app (D γ)).hom (z β γ) * res_γ (g_seg γ) = res_γ (g_seg β) := hRatio β γ
      have hR_i₀γ : (Φ.app (D γ)).hom (z i₀ γ) * res_γ (g_seg γ) = 1 := by
        have h := hRatio i₀ γ
        rw [hg_i₀, map_one] at h
        exact h
      calc
        (Φ.app (D γ)).hom (z β γ) * res_γ (ρ j₀ u)
          = (Φ.app (D γ)).hom (z β γ) * res_γ (ρ j₀ u) *
              ((Φ.app (D γ)).hom (z i₀ γ) * res_γ (g_seg γ)) := by
              rw [hR_i₀γ, mul_one]
        _ = ((Φ.app (D γ)).hom (z β γ) * res_γ (g_seg γ)) * res_γ (ρ j₀ u) *
              (Φ.app (D γ)).hom (z i₀ γ) := by ring
        _ = res_γ (g_seg β * ρ j₀ u) * (Φ.app (D γ)).hom (z i₀ γ) := by
              rw [hR_βγ, ← map_mul]
        _ = res_γ (g_seg γ) * (Φ.app (D γ)).hom (z i₀ γ) := by rw [hProdEq]
        _ = 1 := by rw [mul_comm, hR_i₀γ]
    · intro j β hZβ m
      let β_m := e.symm (Function.update (e β) j m.succ)
      have hProdEq : g_seg β_m = g_seg β * ρ j (f j m) := hg_recov j β hZβ m
      refine ⟨β_m, ?_⟩
      rw [hResU₀ j β (f j m)]
      let res_β := (U₀.toScheme.presheaf.map
        (CategoryTheory.homOfLE (le_top : (TopologicalSpace.Opens.map Φ.base).obj (D β) ≤ ⊤)).op).hom
      have hR_mβ : (Φ.app (D β)).hom (z β_m β) * res_β (g_seg β) = res_β (g_seg β_m) := hRatio β_m β
      have hR_i₀β : (Φ.app (D β)).hom (z i₀ β) * res_β (g_seg β) = 1 := by
        have h := hRatio i₀ β
        rw [hg_i₀, map_one] at h
        exact h
      calc
        (Φ.app (D β)).hom (z β_m β)
          = (Φ.app (D β)).hom (z β_m β) * ((Φ.app (D β)).hom (z i₀ β) * res_β (g_seg β)) := by
              rw [hR_i₀β, mul_one]
        _ = ((Φ.app (D β)).hom (z β_m β) * res_β (g_seg β)) * (Φ.app (D β)).hom (z i₀ β) := by ring
        _ = res_β (g_seg β_m) * (Φ.app (D β)).hom (z i₀ β) := by rw [hR_mβ]
        _ = res_β (g_seg β * ρ j (f j m)) * (Φ.app (D β)).hom (z i₀ β) := by rw [hProdEq]
        _ = res_β (ρ j (f j m)) * ((Φ.app (D β)).hom (z i₀ β) * res_β (g_seg β)) := by
              rw [map_mul]; ring
        _ = res_β (ρ j (f j m)) := by rw [hR_i₀β, mul_one]

  have hStep3 : ∀ (R : Type u) [CommRing R]
      (C : AlgebraicGeometry.Scheme.{u})
      (_ : AlgebraicGeometry.IsIntegral C)
      (_ : C.IsSeparated)
      (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (_ : AlgebraicGeometry.QuasiCompact g)
      (_ : AlgebraicGeometry.IsSeparated g)
      (r : ℕ)
      (U : Fin r → C.Opens)
      (_ : ⨆ j : Fin r, U j = ⊤)
      (_ : ∀ j : Fin r, AlgebraicGeometry.IsAffineOpen (U j))
      (n : Fin r → ℕ)
      (f : ∀ j : Fin r, Fin (n j) → ↑(C.presheaf.obj (Opposite.op (U j))))
      (_ : ∀ j : Fin r, Function.Surjective (MvPolynomial.eval₂Hom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
          AlgebraicGeometry.Scheme.Hom.appLE g ⊤ (U j) le_top).hom) (f j)))
      (U₀ : C.Opens)
      (hU₀_le : ∀ j : Fin r, U₀ ≤ U j)
      (_ : Nonempty ↥U₀)
      (_ : AlgebraicGeometry.IsAffineOpen U₀)
      (P : AlgebraicGeometry.Scheme.{u})
      (p_P : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (_ : AlgebraicGeometry.IsProper p_P)
      (N : ℕ)
      (Φ : U₀.toScheme ⟶ P)
      (D : Fin (N + 1) → P.Opens)
      (z : ∀ (_ γ : Fin (N + 1)), ↑(P.presheaf.obj (Opposite.op (D γ))))
      (IsZeroAt : Fin r → Fin (N + 1) → Prop)
      (_ : Φ ≫ p_P = U₀.ι ≫ g)
      (_ : ⨆ γ : Fin (N + 1), D γ = ⊤)
      (_ : ∀ γ : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D γ))
      (_ : ∀ β γ : Fin (N + 1), P.basicOpen (z β γ) ≤ D β)
      (_ : ∀ (j₀ : Fin r) (γ : Fin (N + 1)),
        ∃ (β : Fin (N + 1)) (u : ↑(C.presheaf.obj (Opposite.op (U j₀)))),
          IsZeroAt j₀ β ∧
          ((AlgebraicGeometry.Scheme.Hom.app Φ (D γ)).hom (z β γ)) *
            ((AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j₀)
              ((TopologicalSpace.Opens.map Φ.base).obj (D γ))
              (fun x _ => hU₀_le j₀ x.2)).hom u) = 1)
      (_ : ∀ (j : Fin r) (β : Fin (N + 1)), IsZeroAt j β →
        ∀ m : Fin (n j), ∃ β_m : Fin (N + 1),
          (AlgebraicGeometry.Scheme.Hom.app Φ (D β)).hom (z β_m β) =
            (AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j)
              ((TopologicalSpace.Opens.map Φ.base).obj (D β))
              (fun x _ => hU₀_le j x.2)).hom (f j m)),
      ∃ (X' Xbar : AlgebraicGeometry.Scheme.{u})
        (π : X' ⟶ C)
        (j : X' ⟶ Xbar)
        (gbar : Xbar ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)),
        AlgebraicGeometry.IsProper π ∧
        AlgebraicGeometry.Surjective π ∧
        AlgebraicGeometry.IsOpenImmersion j ∧
        AlgebraicGeometry.IsProper gbar ∧
        π ≫ g = j ≫ gbar := by
    clear hStep1 hStep2 V hkV C_V g_V hPropV F₂ hF₂ ι₂_FV hι₂ C₂ hIntC₂ g₂ hQC₂ hSep₂ hLFP₂ ι₂_V hPb₂
    intro R _ C hIntC hSepC g hQC hSep r U hCovU hAffU n f hGen U₀ hU₀_le hU₀ hAffU₀
      P p_P hPropP N Φ D z IsZeroAt hΦ hCovD hAffD hz_basic hShift hRecov
    have h_appLE_congrHom : ∀ {X₁ Y₁ : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : X₁ ⟶ Y₁}
        (hf : f₁ = f₂) (U₁ : Y₁.Opens) (V₁ : X₁.Opens)
        (h₁ : V₁ ≤ (TopologicalSpace.Opens.map f₁.base).obj U₁)
        (h₂ : V₁ ≤ (TopologicalSpace.Opens.map f₂.base).obj U₁),
        f₁.appLE U₁ V₁ h₁ = f₂.appLE U₁ V₁ h₂ := by
      intro _ _ _ _ hf _ _ _ _
      subst hf
      rfl

    have h_appLE_congrU : ∀ {X₁ Y₁ : AlgebraicGeometry.Scheme.{u}} (f_hom : X₁ ⟶ Y₁)
        {U₁ U₂ : Y₁.Opens} (hU : U₁ = U₂) (V₁ : X₁.Opens)
        (h₁ : V₁ ≤ (TopologicalSpace.Opens.map f_hom.base).obj U₁)
        (h₂ : V₁ ≤ (TopologicalSpace.Opens.map f_hom.base).obj U₂),
        f_hom.appLE U₁ V₁ h₁ =
          Y₁.presheaf.map (CategoryTheory.eqToHom hU.symm).op ≫ f_hom.appLE U₂ V₁ h₂ := by
      intro _ _ _ _ _ hU _ _ _
      subst hU
      simp

    have hSepOfHom : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (φ : Y₁ ⟶ Y₂),
        Y₂.IsSeparated → AlgebraicGeometry.IsSeparated φ → Y₁.IsSeparated := by
      intro Y₁ Y₂ φ hSepY₂ hSepφ
      have hSepTermY₂ : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from Y₂) := by
        rwa [AlgebraicGeometry.Scheme.isSeparated_iff] at hSepY₂
      have hEq : CategoryTheory.Limits.terminal.from Y₁ =
          φ ≫ CategoryTheory.Limits.terminal.from Y₂ :=
        CategoryTheory.Limits.terminal.hom_ext _ _
      have hSepTermY₁ : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from Y₁) := by
        rw [hEq]
        infer_instance
      rwa [AlgebraicGeometry.Scheme.isSeparated_iff]

    have hToSpecEq : ∀ {Y : AlgebraicGeometry.Scheme.{u}} {B : CommRingCat.{u}}
        (φ : Y ⟶ AlgebraicGeometry.Spec B),
        φ = Y.toSpecΓ ≫
          AlgebraicGeometry.Spec.map ((AlgebraicGeometry.Scheme.ΓSpecIso B).inv ≫ φ.appTop) := by
      intro Y B φ
      rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Scheme.toSpecΓ_naturality φ, CategoryTheory.Category.assoc,
        AlgebraicGeometry.toSpecΓ_SpecMap_ΓSpecIso_inv, CategoryTheory.Category.comp_id]

    have hInjApp : ∀ {W_sch Y_sch : AlgebraicGeometry.Scheme.{u}} (ι_open : W_sch ⟶ Y_sch)
        [AlgebraicGeometry.IsOpenImmersion ι_open] [AlgebraicGeometry.IsIntegral Y_sch]
        [AlgebraicGeometry.IsDominant ι_open]
        (Ω : Y_sch.Opens) [Nonempty ↥Ω],
        Function.Injective (ι_open.app Ω).hom := by
      intro W_sch Y_sch ι_open _ _ hDom_ι Ω hNonΩ a₁ a₂ ha
      obtain ⟨⟨y₀, hy₀⟩⟩ := hNonΩ
      obtain ⟨z₀, hz₀_Ω, ⟨u₀, rfl⟩⟩ :=
        dense_iff_inter_open.mp hDom_ι.denseRange (Ω : Set ↥Y_sch) Ω.isOpen ⟨y₀, hy₀⟩
      have hu₀ : u₀ ∈ (TopologicalSpace.Opens.map ι_open.base).obj Ω := hz₀_Ω
      have h_germ_eq :
          (W_sch.presheaf.germ ((TopologicalSpace.Opens.map ι_open.base).obj Ω) u₀ hu₀).hom
            ((ι_open.app Ω).hom a₁) =
          (W_sch.presheaf.germ ((TopologicalSpace.Opens.map ι_open.base).obj Ω) u₀ hu₀).hom
            ((ι_open.app Ω).hom a₂) :=
        congrArg _ ha
      have h_stalk := AlgebraicGeometry.Scheme.Hom.germ_stalkMap ι_open Ω u₀ hu₀
      have h_s₁ := congrArg (fun m => m.hom a₁) h_stalk
      have h_s₂ := congrArg (fun m => m.hom a₂) h_stalk
      change (ι_open.stalkMap u₀).hom ((Y_sch.presheaf.germ Ω (ι_open.base u₀) hz₀_Ω).hom a₁) =
        (W_sch.presheaf.germ _ u₀ hu₀).hom ((ι_open.app Ω).hom a₁) at h_s₁
      change (ι_open.stalkMap u₀).hom ((Y_sch.presheaf.germ Ω (ι_open.base u₀) hz₀_Ω).hom a₂) =
        (W_sch.presheaf.germ _ u₀ hu₀).hom ((ι_open.app Ω).hom a₂) at h_s₂
      rw [← h_s₁, ← h_s₂] at h_germ_eq
      have _ : CategoryTheory.IsIso (ι_open.stalkMap u₀) := inferInstance
      have h_cancel : (Y_sch.presheaf.germ Ω (ι_open.base u₀) hz₀_Ω).hom a₁ =
          (Y_sch.presheaf.germ Ω (ι_open.base u₀) hz₀_Ω).hom a₂ := by
        have h_inv := congrArg (CategoryTheory.inv (ι_open.stalkMap u₀)).hom h_germ_eq
        change (ι_open.stalkMap u₀ ≫ CategoryTheory.inv (ι_open.stalkMap u₀)).hom _ =
          (ι_open.stalkMap u₀ ≫ CategoryTheory.inv (ι_open.stalkMap u₀)).hom _ at h_inv
        rw [CategoryTheory.IsIso.hom_inv_id] at h_inv
        exact h_inv
      exact AlgebraicGeometry.germ_injective_of_isIntegral Y_sch (ι_open.base u₀) hz₀_Ω h_cancel

    let S := AlgebraicGeometry.Spec (CommRingCat.of R)
    let Z := CategoryTheory.Limits.pullback g p_P
    let fst : Z ⟶ C := CategoryTheory.Limits.pullback.fst g p_P
    let snd : Z ⟶ P := CategoryTheory.Limits.pullback.snd g p_P
    let δ : U₀.toScheme ⟶ Z := CategoryTheory.Limits.pullback.lift U₀.ι Φ hΦ.symm

    have _ : AlgebraicGeometry.IsAffine U₀.toScheme := hAffU₀
    have hQC_U₀S : AlgebraicGeometry.QuasiCompact (U₀.ι ≫ g) := inferInstance
    have hδ_comp : δ ≫ (fst ≫ g) = U₀.ι ≫ g := by
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
    have hQC_δ_comp : AlgebraicGeometry.QuasiCompact (δ ≫ (fst ≫ g)) := by
      rwa [hδ_comp]
    have hProp_fst : AlgebraicGeometry.IsProper fst := inferInstance
    have hSep_fst_g : AlgebraicGeometry.IsSeparated (fst ≫ g) := inferInstance
    have hQC_δ : AlgebraicGeometry.QuasiCompact δ :=
      @AlgebraicGeometry.QuasiCompact.of_comp _ _ _ δ (fst ≫ g) hQC_δ_comp inferInstance

    let X' := AlgebraicGeometry.Scheme.Hom.image δ
    let ι_img : X' ⟶ Z := AlgebraicGeometry.Scheme.Hom.imageι δ
    let ν : U₀.toScheme ⟶ X' := AlgebraicGeometry.Scheme.Hom.toImage δ
    let π : X' ⟶ C := ι_img ≫ fst
    let p₂ : X' ⟶ P := ι_img ≫ snd

    have hν_π : ν ≫ π = U₀.ι := by
      dsimp only [ν, π, ι_img]
      rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι,
        CategoryTheory.Limits.pullback.lift_fst]
    have hν_p₂ : ν ≫ p₂ = Φ := by
      dsimp only [ν, p₂, ι_img]
      rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι,
        CategoryTheory.Limits.pullback.lift_snd]
    have hDom_ν : AlgebraicGeometry.IsDominant ν := inferInstance

    have hInt_U₀ : AlgebraicGeometry.IsIntegral U₀.toScheme :=
      @AlgebraicGeometry.isIntegral_of_isOpenImmersion _ _ U₀.ι inferInstance hIntC hU₀
    have hIrred_U₀ : IrreducibleSpace ↥U₀.toScheme :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral _ hInt_U₀

    have hIrred_X' : IrreducibleSpace ↥X' := by
      refine { isPreirreducible_univ := ?_, toNonempty := ?_ }
      · have h_dense : closure (Set.range ν.base) = Set.univ :=
          hDom_ν.denseRange.closure_eq
        rw [← h_dense]
        have h_img : Set.range ν.base = ν.base '' (Set.univ : Set ↥U₀.toScheme) :=
          Set.image_univ.symm
        rw [h_img]
        exact (IrreducibleSpace.isIrreducible_univ (X := ↥U₀.toScheme)).isPreirreducible.image
          ν.base ν.base.hom.continuous.continuousOn |>.closure
      · obtain ⟨u₀⟩ := hU₀
        exact ⟨ν.base u₀⟩

    have hRed_X' : AlgebraicGeometry.IsReduced X' := by
      refine AlgebraicGeometry.IsReduced.mk fun V_open => ⟨fun s hs => ?_⟩
      obtain ⟨k, hk⟩ := hs
      refine TopCat.Presheaf.section_ext X'.sheaf V_open s 0 fun x hx => ?_
      have hInd : Topology.IsInducing ι_img.base :=
        (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι_img).isInducing
      obtain ⟨O_Z_set, hO_Z_open, hO_Z_pre⟩ := hInd.isOpen_iff.mp V_open.isOpen
      let O_Z : Z.Opens := ⟨O_Z_set, hO_Z_open⟩
      have hx_OZ : ι_img.base x ∈ O_Z := by
        change x ∈ ι_img.base ⁻¹' O_Z_set
        rw [hO_Z_pre]
        exact hx
      obtain ⟨W, hAffW, hxW, hW_le⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := ι_img.base x) (U := O_Z) hx_OZ
      let W_aff : Z.affineOpens := ⟨W, hAffW⟩
      let V_W : X'.Opens := (TopologicalSpace.Opens.map ι_img.base).obj W
      have hx_VW : x ∈ V_W := hxW
      have hVW_le : V_W ≤ V_open := by
        intro y hy
        have hy_OZ : ι_img.base y ∈ O_Z := hW_le hy
        change y ∈ (V_open : Set ↥X')
        rw [← hO_Z_pre]
        exact hy_OZ
      let t := (X'.presheaf.map (CategoryTheory.homOfLE hVW_le).op).hom s
      have ht_pow : t ^ k = 0 := by
        dsimp only [t]
        rw [← map_pow, hk, map_zero]
      let e_sub := δ.ker.subschemeObjIso W_aff
      let q_bar : ↑(Z.presheaf.obj (Opposite.op W)) ⧸ δ.ker.ideal W_aff := e_sub.hom.hom t
      have hq_bar_pow : q_bar ^ k = 0 := by
        dsimp only [q_bar]
        rw [← map_pow, ht_pow, map_zero]
      obtain ⟨q, hq_mk⟩ := Ideal.Quotient.mk_surjective q_bar
      have hq_mem_ker : q ^ k ∈ RingHom.ker (δ.app W).hom := by
        rw [← AlgebraicGeometry.Scheme.Hom.ker_apply δ W_aff, ← Ideal.Quotient.eq_zero_iff_mem,
          map_pow, hq_mk, hq_bar_pow]
      have hδq_pow : ((δ.app W).hom q) ^ k = 0 := by
        rw [← map_pow]
        exact hq_mem_ker
      have hδq_zero : (δ.app W).hom q = 0 :=
        IsReduced.eq_zero _ ⟨k, hδq_pow⟩
      have hq_in_ideal : q ∈ δ.ker.ideal W_aff := by
        rw [AlgebraicGeometry.Scheme.Hom.ker_apply δ W_aff]
        exact hδq_zero
      have hq_bar_zero : q_bar = 0 := by
        rw [← hq_mk, Ideal.Quotient.eq_zero_iff_mem]
        exact hq_in_ideal
      have ht_zero : t = 0 := by
        have h_inv := congrArg e_sub.inv.hom hq_bar_zero
        change (e_sub.hom ≫ e_sub.inv).hom t = e_sub.inv.hom 0 at h_inv
        rw [CategoryTheory.Iso.hom_inv_id, map_zero] at h_inv
        exact h_inv
      have h_germ := TopCat.Presheaf.germ_res X'.presheaf (CategoryTheory.homOfLE hVW_le) x hx_VW
      have h_g1 := congrArg (fun m => m.hom s) h_germ.symm
      change (X'.presheaf.germ V_open x hx).hom s =
        (X'.presheaf.germ V_W x hx_VW).hom t at h_g1
      change (X'.presheaf.germ V_open x hx).hom s = (X'.presheaf.germ V_open x hx).hom 0
      rw [h_g1, ht_zero, map_zero, map_zero]

    have hInt_X' : AlgebraicGeometry.IsIntegral X' :=
      @AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced X' hRed_X' hIrred_X'

    have hProp_π : AlgebraicGeometry.IsProper π := inferInstance
    have hIrred_C : IrreducibleSpace ↥C :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral C hIntC
    have hDom_π : AlgebraicGeometry.IsDominant π := by
      refine ⟨Dense.mono ?_ (U₀.isOpen.dense (by obtain ⟨⟨u, hu⟩⟩ := hU₀; exact ⟨u, hu⟩))⟩
      intro y hy
      refine ⟨ν.base ⟨y, hy⟩, ?_⟩
      change (ν ≫ π).base ⟨y, hy⟩ = y
      rw [hν_π]
      rfl
    have hSurj_π : AlgebraicGeometry.Surjective π :=
      @AlgebraicGeometry.Surjective.of_universallyClosed_of_isDominant _ _ π inferInstance hDom_π

    have hp₂_comp : p₂ ≫ p_P = π ≫ g := by
      dsimp only [p₂, π]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc]
    have hQC_p₂P : AlgebraicGeometry.QuasiCompact (p₂ ≫ p_P) := by
      rw [hp₂_comp]
      infer_instance
    have hQC_p₂ : AlgebraicGeometry.QuasiCompact p₂ :=
      @AlgebraicGeometry.QuasiCompact.of_comp _ _ _ p₂ p_P hQC_p₂P inferInstance

    have hSep_X' : X'.IsSeparated := hSepOfHom π hSepC inferInstance

    have hOpen_ν : AlgebraicGeometry.IsOpenImmersion ν := by
      let V_U₀ : X'.Opens := (TopologicalSpace.Opens.map π.base).obj U₀
      have h_range_ν : Set.range ν.base ⊆ Set.range V_U₀.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨u, rfl⟩
        change (ν ≫ π).base u ∈ U₀
        rw [hν_π]
        exact u.2
      let s₀ : U₀.toScheme ⟶ V_U₀.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift V_U₀.ι ν h_range_ν
      have hs₀_fac : s₀ ≫ V_U₀.ι = ν :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac V_U₀.ι ν h_range_ν
      have hDom_s₀ : AlgebraicGeometry.IsDominant s₀ := by
        refine ⟨dense_iff_inter_open.mpr fun W hW ⟨v₀, hv₀⟩ => ?_⟩
        have hW_open' : IsOpen (V_U₀.ι.base '' W) :=
          V_U₀.ι.isOpenEmbedding.isOpenMap W hW
        obtain ⟨_, ⟨v₁, hv₁W, rfl⟩, ⟨u₁, hu₁⟩⟩ :=
          dense_iff_inter_open.mp hDom_ν.denseRange (V_U₀.ι.base '' W) hW_open'
            ⟨V_U₀.ι.base v₀, v₀, hv₀, rfl⟩
        have hv₁_eq : s₀.base u₁ = v₁ := by
          apply V_U₀.ι.isOpenEmbedding.injective
          change (s₀ ≫ V_U₀.ι).base u₁ = V_U₀.ι.base v₁
          rw [hs₀_fac, hu₁]
        exact ⟨s₀.base u₁, hv₁_eq ▸ hv₁W, u₁, rfl⟩
      let π_U₀ : V_U₀.toScheme ⟶ U₀.toScheme := π ∣_ U₀
      have hπ_U₀_ι : π_U₀ ≫ U₀.ι = V_U₀.ι ≫ π := AlgebraicGeometry.morphismRestrict_ι π U₀
      have hs₀_π : s₀ ≫ π_U₀ = 𝟙 U₀.toScheme := by
        apply (cancel_mono U₀.ι).mp
        rw [CategoryTheory.Category.assoc, hπ_U₀_ι, ← CategoryTheory.Category.assoc, hs₀_fac,
          hν_π, CategoryTheory.Category.id_comp]
      have hNon_VU₀ : Nonempty ↥V_U₀ := by
        obtain ⟨u₀⟩ := hU₀
        exact ⟨⟨ν.base u₀, by change (ν ≫ π).base u₀ ∈ U₀; rw [hν_π]; exact u₀.2⟩⟩
      have _ : AlgebraicGeometry.IsIntegral V_U₀.toScheme :=
        @AlgebraicGeometry.isIntegral_of_isOpenImmersion _ _ V_U₀.ι inferInstance hInt_X' hNon_VU₀
      have _ : V_U₀.toScheme.IsSeparated := hSepOfHom V_U₀.ι hSep_X' inferInstance
      have hπ_s₀ : π_U₀ ≫ s₀ = 𝟙 V_U₀.toScheme := by
        apply @AlgebraicGeometry.ext_of_isDominant _ _ _ _ _ _ _ s₀ hDom_s₀
        rw [← CategoryTheory.Category.assoc, hs₀_π, CategoryTheory.Category.id_comp,
          CategoryTheory.Category.comp_id]
      have _ : CategoryTheory.IsIso s₀ := ⟨⟨π_U₀, hs₀_π, hπ_s₀⟩⟩
      rw [← hs₀_fac]
      infer_instance

    suffices hFinish : ∀ (X_cl : AlgebraicGeometry.Scheme.{u})
        (ι_cl : X_cl ⟶ Z)
        (ν_cl : U₀.toScheme ⟶ X_cl)
        (π_cl : X_cl ⟶ C)
        (p₂_cl : X_cl ⟶ P),
        AlgebraicGeometry.IsClosedImmersion ι_cl →
        AlgebraicGeometry.IsIntegral X_cl →
        X_cl.IsSeparated →
        AlgebraicGeometry.IsProper π_cl →
        AlgebraicGeometry.Surjective π_cl →
        AlgebraicGeometry.QuasiCompact p₂_cl →
        AlgebraicGeometry.IsOpenImmersion ν_cl →
        AlgebraicGeometry.IsDominant ν_cl →
        π_cl = ι_cl ≫ fst →
        p₂_cl = ι_cl ≫ snd →
        p₂_cl ≫ p_P = π_cl ≫ g →
        ν_cl ≫ π_cl = U₀.ι →
        ν_cl ≫ p₂_cl = Φ →
        ∃ (X_out Xbar : AlgebraicGeometry.Scheme.{u})
          (π_out : X_out ⟶ C)
          (j_out : X_out ⟶ Xbar)
          (gbar : Xbar ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)),
          AlgebraicGeometry.IsProper π_out ∧
          AlgebraicGeometry.Surjective π_out ∧
          AlgebraicGeometry.IsOpenImmersion j_out ∧
          AlgebraicGeometry.IsProper gbar ∧
          π_out ≫ g = j_out ≫ gbar by
      exact hFinish X' ι_img ν π p₂ inferInstance hInt_X' hSep_X' hProp_π hSurj_π hQC_p₂
        hOpen_ν hDom_ν rfl rfl hp₂_comp hν_π hν_p₂

    clear X' ι_img ν π p₂ hν_π hν_p₂ hDom_ν hIrred_X' hRed_X' hInt_X' hProp_π hDom_π hSurj_π
      hp₂_comp hQC_p₂P hQC_p₂ hSep_X' hOpen_ν
    intro X' ι_img ν π p₂ _ hInt_X' hSep_X' hProp_π hSurj_π hQC_p₂ hOpen_ν hDom_ν
      hπ_def hp₂_def hp₂_comp hν_π hν_p₂
    let Idx_good := {β : Fin (N + 1) // ∃ j₀ : Fin r, IsZeroAt j₀ β}
    let W_good : P.Opens := ⨆ α : Idx_good, D α.1

    have hRange_p₂ : Set.range p₂.base ⊆ Set.range W_good.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      have hx_U : π.base x ∈ (⨆ j : Fin r, U j) := by rw [hCovU]; trivial
      obtain ⟨j₀, hxj₀⟩ := TopologicalSpace.Opens.mem_iSup.mp hx_U
      have hx_D : p₂.base x ∈ (⨆ γ : Fin (N + 1), D γ) := by rw [hCovD]; trivial
      obtain ⟨γ, hxγ⟩ := TopologicalSpace.Opens.mem_iSup.mp hx_D
      obtain ⟨β, u, hZβ, hUnitEq⟩ := hShift j₀ γ
      let Ω_X : X'.Opens :=
        (TopologicalSpace.Opens.map π.base).obj (U j₀) ⊓
          (TopologicalSpace.Opens.map p₂.base).obj (D γ)
      have hx_Ω : x ∈ Ω_X := ⟨hxj₀, hxγ⟩
      have _ : Nonempty ↥Ω_X := ⟨⟨x, hx_Ω⟩⟩
      let a := (p₂.appLE (D γ) Ω_X inf_le_right).hom (z β γ)
      let b := (π.appLE (U j₀) Ω_X inf_le_left).hom u
      have h_ab_one : a * b = 1 := by
        apply hInjApp ν Ω_X
        rw [map_mul, map_one]
        let Ω_U : U₀.toScheme.Opens := (TopologicalSpace.Opens.map ν.base).obj Ω_X
        let W_γ : U₀.toScheme.Opens := (TopologicalSpace.Opens.map Φ.base).obj (D γ)
        have hΩ_le_W : Ω_U ≤ W_γ := by
          intro y hy
          have hy2 : p₂.base (ν.base y) ∈ D γ := hy.2
          change (ν ≫ p₂).base y ∈ D γ at hy2
          rwa [hν_p₂] at hy2
        have h_ν_a : (ν.app Ω_X).hom a =
            (U₀.toScheme.presheaf.map (CategoryTheory.homOfLE hΩ_le_W).op).hom
              ((Φ.app (D γ)).hom (z β γ)) := by
          dsimp only [a]
          have h1 : p₂.appLE (D γ) Ω_X inf_le_right ≫ ν.app Ω_X =
              (ν ≫ p₂).appLE (D γ) Ω_U (fun _ hy => hy.2) := by
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE ν]
            erw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
          have h2 : (ν ≫ p₂).appLE (D γ) Ω_U (fun _ hy => hy.2) =
              Φ.appLE (D γ) Ω_U hΩ_le_W :=
            h_appLE_congrHom hν_p₂ (D γ) Ω_U _ _
          change (p₂.appLE (D γ) Ω_X inf_le_right ≫ ν.app Ω_X).hom (z β γ) = _
          rw [h1, h2]
          rfl
        have h_ν_b : (ν.app Ω_X).hom b =
            (U₀.toScheme.presheaf.map (CategoryTheory.homOfLE hΩ_le_W).op).hom
              ((U₀.ι.appLE (U j₀) W_γ (fun y _ => hU₀_le j₀ y.2)).hom u) := by
          dsimp only [b]
          have h1 : π.appLE (U j₀) Ω_X inf_le_left ≫ ν.app Ω_X =
              (ν ≫ π).appLE (U j₀) Ω_U (fun _ hy => hy.1) := by
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE ν]
            erw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
          have h2 : (ν ≫ π).appLE (U j₀) Ω_U (fun _ hy => hy.1) =
              U₀.ι.appLE (U j₀) Ω_U (fun y _ => hU₀_le j₀ y.2) :=
            h_appLE_congrHom hν_π (U j₀) Ω_U _ _
          change (π.appLE (U j₀) Ω_X inf_le_left ≫ ν.app Ω_X).hom u = _
          rw [h1, h2]
          erw [AlgebraicGeometry.Scheme.Opens.ι_appLE, AlgebraicGeometry.Scheme.Opens.ι_appLE]
          have h_map : C.presheaf.map
                (CategoryTheory.homOfLE (Set.image_subset_iff.mpr
                  (fun (y : ↥U₀.toScheme) (_ : y ∈ W_γ) => hU₀_le j₀ y.2))).op ≫
              U₀.toScheme.presheaf.map (CategoryTheory.homOfLE hΩ_le_W).op =
              C.presheaf.map
                (CategoryTheory.homOfLE (Set.image_subset_iff.mpr
                  (fun (y : ↥U₀.toScheme) (_ : y ∈ Ω_U) => hU₀_le j₀ y.2))).op := by
            erw [← C.presheaf.map_comp]
            rfl
          exact (congrArg (fun m => m.hom u) h_map).symm
        rw [h_ν_a, h_ν_b, ← map_mul, hUnitEq, map_one]
      have ha_unit : IsUnit a := IsUnit.of_mul_eq_one b h_ab_one
      have h_bo_eq : X'.basicOpen a = Ω_X := X'.basicOpen_of_isUnit ha_unit
      have h_bo_res : X'.basicOpen a =
          Ω_X ⊓ (TopologicalSpace.Opens.map p₂.base).obj (P.basicOpen (z β γ)) := by
        have ha_def : a = (X'.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
            ((p₂.app (D γ)).hom (z β γ)) := rfl
        rw [ha_def, AlgebraicGeometry.Scheme.basicOpen_res,
          ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen]
      have hx_bo : x ∈ (TopologicalSpace.Opens.map p₂.base).obj (P.basicOpen (z β γ)) := by
        have hx' : x ∈ X'.basicOpen a := by rwa [h_bo_eq]
        rw [h_bo_res] at hx'
        exact hx'.2
      have hx_Dβ : p₂.base x ∈ D β := hz_basic β γ hx_bo
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨β, j₀, hZβ⟩, hx_Dβ⟩

    let p₂_W : X' ⟶ W_good.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift W_good.ι p₂ hRange_p₂
    have hp₂_W_fac : p₂_W ≫ W_good.ι = p₂ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W_good.ι p₂ hRange_p₂

    let D'_good : Idx_good → W_good.toScheme.Opens :=
      fun α => (TopologicalSpace.Opens.map W_good.ι.base).obj (D α.1)
    have hCov_D' : (⨆ α : Idx_good, D'_good α) = ⊤ := by
      apply TopologicalSpace.Opens.ext
      ext w
      simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion, TopologicalSpace.Opens.coe_top,
        Set.mem_univ, iff_true]
      obtain ⟨α, hα⟩ := TopologicalSpace.Opens.mem_iSup.mp w.2
      exact ⟨α, hα⟩

    have hCl_p₂_W : AlgebraicGeometry.IsClosedImmersion p₂_W := by
      rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := @AlgebraicGeometry.IsClosedImmersion) D'_good hCov_D']
      intro ⟨β, j, hZβ⟩
      let α : Idx_good := ⟨β, j, hZβ⟩
      let V_β : X'.Opens := (TopologicalSpace.Opens.map p₂.base).obj (D β)
      let f_β : V_β.toScheme ⟶ (D β).toScheme := p₂ ∣_ D β
      have hf_β_ι : f_β ≫ (D β).ι = V_β.ι ≫ p₂ := AlgebraicGeometry.morphismRestrict_ι p₂ (D β)

      suffices hCl_fβ : AlgebraicGeometry.IsClosedImmersion f_β by
        let V_α : X'.Opens := (TopologicalSpace.Opens.map p₂_W.base).obj (D'_good α)
        have hV_eq : V_α = V_β := by
          apply TopologicalSpace.Opens.ext
          ext y
          change (p₂_W ≫ W_good.ι).base y ∈ D β ↔ p₂.base y ∈ D β
          rw [hp₂_W_fac]
        let e_Vα : V_α.toScheme ≅ V_β.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq V_α.ι V_β.ι (by simp [hV_eq])
        have he_Vα : e_Vα.hom ≫ V_β.ι = V_α.ι :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac V_α.ι V_β.ι _
        have hD_le_W : D β ≤ W_good := le_iSup (fun γ : Idx_good => D γ.1) α
        have hRange_Dα : Set.range ((D'_good α).ι ≫ W_good.ι).base = Set.range (D β).ι.base := by
          ext y
          simp only [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.hom_comp, Set.mem_range,
            AlgebraicGeometry.Scheme.Opens.range_ι]
          constructor
          · rintro ⟨⟨⟨z, hzW⟩, hzD⟩, rfl⟩
            exact hzD
          · intro hyD
            exact ⟨⟨⟨y, hD_le_W hyD⟩, hyD⟩, rfl⟩
        let e_Dα : (D'_good α).toScheme ≅ (D β).toScheme :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq ((D'_good α).ι ≫ W_good.ι) (D β).ι hRange_Dα
        have he_Dα : e_Dα.hom ≫ (D β).ι = (D'_good α).ι ≫ W_good.ι :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _
        have h_res_eq : (p₂_W ∣_ D'_good α) = e_Vα.hom ≫ f_β ≫ e_Dα.inv := by
          apply (cancel_mono ((D'_good α).ι ≫ W_good.ι)).mp
          rw [← CategoryTheory.Category.assoc (p₂_W ∣_ D'_good α),
            AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc, hp₂_W_fac]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← he_Dα,
            CategoryTheory.Iso.inv_hom_id_assoc, hf_β_ι, ← he_Vα, CategoryTheory.Category.assoc]
        rw [h_res_eq]
        infer_instance

      by_cases hNonVβ : Nonempty ↥V_β
      · let U_β' : U₀.toScheme.Opens := (TopologicalSpace.Opens.map ν.base).obj V_β
        let s_β : U_β'.toScheme ⟶ V_β.toScheme := ν ∣_ V_β
        have hs_β_ι : s_β ≫ V_β.ι = U_β'.ι ≫ ν := AlgebraicGeometry.morphismRestrict_ι ν V_β
        have _ : AlgebraicGeometry.IsOpenImmersion s_β := inferInstance
        have _ : AlgebraicGeometry.IsIntegral V_β.toScheme :=
          @AlgebraicGeometry.isIntegral_of_isOpenImmersion _ _ V_β.ι inferInstance hInt_X' hNonVβ
        have hDom_sβ : AlgebraicGeometry.IsDominant s_β := by
          refine ⟨dense_iff_inter_open.mpr fun W hW ⟨v₀, hv₀⟩ => ?_⟩
          have hW_open' : IsOpen (V_β.ι.base '' W) :=
            V_β.ι.isOpenEmbedding.isOpenMap W hW
          obtain ⟨_, ⟨v₁, hv₁W, rfl⟩, ⟨u₁, hu₁⟩⟩ :=
            dense_iff_inter_open.mp hDom_ν.denseRange (V_β.ι.base '' W) hW_open'
              ⟨V_β.ι.base v₀, v₀, hv₀, rfl⟩
          have hu₁_mem : u₁ ∈ U_β' := by
            change ν.base u₁ ∈ V_β
            rw [hu₁]
            exact v₁.2
          have hv₁_eq : s_β.base ⟨u₁, hu₁_mem⟩ = v₁ := by
            apply V_β.ι.isOpenEmbedding.injective
            change (s_β ≫ V_β.ι).base ⟨u₁, hu₁_mem⟩ = V_β.ι.base v₁
            rw [hs_β_ι]
            exact hu₁
          exact ⟨s_β.base ⟨u₁, hu₁_mem⟩, hv₁_eq ▸ hv₁W, ⟨u₁, hu₁_mem⟩, rfl⟩
        have _ : Nonempty ↥(⊤ : V_β.toScheme.Opens) := by
          obtain ⟨v₀⟩ := hNonVβ
          exact ⟨⟨v₀, trivial⟩⟩
        have hInj_sβ : Function.Injective s_β.appTop.hom := hInjApp s_β ⊤

        let A_j_obj := C.presheaf.obj (Opposite.op (U j))
        let A_j := ↑A_j_obj
        let κ_j : R →+* A_j :=
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            g.appLE ⊤ (U j) le_top).hom)
        let σ_j : MvPolynomial (Fin (n j)) R →+* A_j := MvPolynomial.eval₂Hom κ_j (f j)

        let R_β_obj := P.presheaf.obj (Opposite.op (D β))
        let R_β := ↑R_β_obj
        let κ_Pβ : R →+* R_β :=
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            p_P.appLE ⊤ (D β) le_top).hom)

        choose β_m hβ_m using hRecov j β hZβ
        let z_vec : Fin (n j) → R_β := fun m => z (β_m m) β
        let τ_β : MvPolynomial (Fin (n j)) R →+* R_β := MvPolynomial.eval₂Hom κ_Pβ z_vec
        let I_β : Ideal R_β := Ideal.map τ_β (RingHom.ker σ_j)
        let Q_β := R_β ⧸ I_β
        let mk_β : R_β →+* Q_β := Ideal.Quotient.mk I_β

        have h_ker_le : RingHom.ker σ_j ≤ RingHom.ker (mk_β.comp τ_β) := by
          intro p hp
          change mk_β (τ_β p) = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem τ_β hp)
        let θ_β : A_j →+* Q_β :=
          (Ideal.Quotient.lift (RingHom.ker σ_j) (mk_β.comp τ_β) h_ker_le).comp
            (RingHom.quotientKerEquivOfSurjective (hGen j)).symm.toRingHom
        have hθ_σ : θ_β.comp σ_j = mk_β.comp τ_β := by
          apply RingHom.ext
          intro p
          dsimp only [θ_β, RingHom.comp_apply]
          have h_symm : (RingHom.quotientKerEquivOfSurjective (hGen j)).symm (σ_j p) =
              Ideal.Quotient.mk (RingHom.ker σ_j) p := by
            apply (RingHom.quotientKerEquivOfSurjective (hGen j)).injective
            rw [RingEquiv.apply_symm_apply]
            rfl
          erw [h_symm]
          exact Ideal.Quotient.lift_mk (RingHom.ker σ_j) (mk_β.comp τ_β) h_ker_le

        let α_β_hom : R_β_obj ⟶ V_β.toScheme.presheaf.obj (Opposite.op ⊤) :=
          (AlgebraicGeometry.Scheme.ΓSpecIso R_β_obj).inv ≫
            (f_β ≫ (hAffD β).isoSpec.hom).appTop
        let α_β : R_β →+* ↑(V_β.toScheme.presheaf.obj (Opposite.op ⊤)) := α_β_hom.hom
        have hα_β_eq : α_β_hom = (D β).topIso.inv ≫ f_β.appTop := by
          dsimp only [α_β_hom]
          rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom,
            AlgebraicGeometry.Scheme.Hom.comp_appTop,
            AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop,
            ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]

        have h_range_uj : Set.range (U_β'.ι ≫ U₀.ι).base ⊆ Set.range (U j).ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨w, rfl⟩
          exact hU₀_le j w.1.2
        let u_j : U_β'.toScheme ⟶ (U j).toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift (U j).ι (U_β'.ι ≫ U₀.ι) h_range_uj
        have huj_fac : u_j ≫ (U j).ι = U_β'.ι ≫ U₀.ι :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac (U j).ι (U_β'.ι ≫ U₀.ι) h_range_uj
        let res_Uj_hom : A_j_obj ⟶ U_β'.toScheme.presheaf.obj (Opposite.op ⊤) :=
          (AlgebraicGeometry.Scheme.ΓSpecIso A_j_obj).inv ≫
            (u_j ≫ (hAffU j).isoSpec.hom).appTop
        have hres_Uj_eq : res_Uj_hom = (U j).topIso.inv ≫ u_j.appTop := by
          dsimp only [res_Uj_hom]
          rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom,
            AlgebraicGeometry.Scheme.Hom.comp_appTop,
            AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop,
            ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]

        have h_poly_Uβ : (s_β.appTop.hom.comp α_β).comp τ_β = res_Uj_hom.hom.comp σ_j := by
          have h_le2 : (⊤ : U_β'.toScheme.Opens) ≤
              (TopologicalSpace.Opens.map (U_β'.ι ≫ Φ).base).obj (D β) := by
            intro w _
            have hw : p₂.base (ν.base w.1) ∈ D β := w.2
            change (ν ≫ p₂).base w.1 ∈ D β at hw
            rwa [hν_p₂] at hw
          have h_lhs_map : α_β_hom ≫ s_β.appTop =
              (U_β'.ι ≫ Φ).appLE (D β) ⊤ h_le2 := by
            rw [hα_β_eq, CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Hom.comp_appTop]
            have h_sf : (s_β ≫ f_β) ≫ (D β).ι = U_β'.ι ≫ Φ := by
              rw [CategoryTheory.Category.assoc, hf_β_ι, ← CategoryTheory.Category.assoc, hs_β_ι,
                CategoryTheory.Category.assoc, hν_p₂]
            have h_le1 : (⊤ : U_β'.toScheme.Opens) ≤
                (TopologicalSpace.Opens.map ((s_β ≫ f_β) ≫ (D β).ι).base).obj (D β) := by
              rwa [h_sf]
            have h_c1 : ((s_β ≫ f_β) ≫ (D β).ι).appLE (D β) ⊤ h_le1 =
                (U_β'.ι ≫ Φ).appLE (D β) ⊤ h_le2 :=
              h_appLE_congrHom h_sf (D β) ⊤ h_le1 h_le2
            rw [← h_c1, AlgebraicGeometry.Scheme.Hom.comp_appLE (s_β ≫ f_β) (D β).ι (D β) ⊤ h_le1]
            have hD_pre : (TopologicalSpace.Opens.map (D β).ι.base).obj (D β) = ⊤ := by
              apply TopologicalSpace.Opens.ext; ext w; exact ⟨fun _ => trivial, fun _ => w.2⟩
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE (D β).ι,
              AlgebraicGeometry.Scheme.Opens.ι_appLE]
            have h_sf_app : (s_β ≫ f_β).appLE ((TopologicalSpace.Opens.map (D β).ι.base).obj (D β))
                ⊤ h_le1 =
                (D β).toScheme.presheaf.map (CategoryTheory.eqToHom hD_pre.symm).op ≫
                  (s_β ≫ f_β).appTop := by
              have h_top : (s_β ≫ f_β).appTop = (s_β ≫ f_β).appLE ⊤ ⊤ le_rfl := by
                unfold AlgebraicGeometry.Scheme.Hom.appTop
                rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
                rfl
              rw [h_top]
              exact h_appLE_congrU (s_β ≫ f_β) hD_pre ⊤ h_le1 le_rfl
            rw [h_sf_app]
            symm
            apply (CategoryTheory.Category.assoc _ _ _).symm.trans
            congr 1
            rw [AlgebraicGeometry.Scheme.Opens.topIso_inv]
            erw [← P.presheaf.map_comp]
            congr 1
          have h_rhs_map : res_Uj_hom =
              (U_β'.ι ≫ U₀.ι).appLE (U j) ⊤ (fun w _ => hU₀_le j w.1.2) := by
            rw [hres_Uj_eq]
            have h_le1 : (⊤ : U_β'.toScheme.Opens) ≤
                (TopologicalSpace.Opens.map (u_j ≫ (U j).ι).base).obj (U j) := by
              intro w _; rw [huj_fac]; exact hU₀_le j w.1.2
            have h_c1 : (u_j ≫ (U j).ι).appLE (U j) ⊤ h_le1 =
                (U_β'.ι ≫ U₀.ι).appLE (U j) ⊤ (fun w _ => hU₀_le j w.1.2) :=
              h_appLE_congrHom huj_fac (U j) ⊤ h_le1 _
            rw [← h_c1, AlgebraicGeometry.Scheme.Hom.comp_appLE u_j (U j).ι (U j) ⊤ h_le1]
            have hU_pre : (TopologicalSpace.Opens.map (U j).ι.base).obj (U j) = ⊤ := by
              apply TopologicalSpace.Opens.ext; ext w; exact ⟨fun _ => trivial, fun _ => w.2⟩
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE (U j).ι,
              AlgebraicGeometry.Scheme.Opens.ι_appLE]
            have h_uj_app : u_j.appLE ((TopologicalSpace.Opens.map (U j).ι.base).obj (U j))
                ⊤ h_le1 =
                (U j).toScheme.presheaf.map (CategoryTheory.eqToHom hU_pre.symm).op ≫
                  u_j.appTop := by
              have h_top : u_j.appTop = u_j.appLE ⊤ ⊤ le_rfl := by
                unfold AlgebraicGeometry.Scheme.Hom.appTop
                rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
                rfl
              rw [h_top]
              exact h_appLE_congrU u_j hU_pre ⊤ h_le1 le_rfl
            rw [h_uj_app]
            symm
            apply (CategoryTheory.Category.assoc _ _ _).symm.trans
            congr 1
            rw [AlgebraicGeometry.Scheme.Opens.topIso_inv]
            erw [← C.presheaf.map_comp]
            congr 1

          apply MvPolynomial.ringHom_ext'
          · ext r₀
            simp only [RingHom.coe_comp, Function.comp_apply, τ_β, σ_j, MvPolynomial.eval₂Hom_C]
            change (α_β_hom ≫ s_β.appTop).hom (κ_Pβ r₀) = res_Uj_hom.hom (κ_j r₀)
            rw [h_lhs_map, h_rhs_map]
            dsimp only [κ_Pβ, κ_j]
            change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
                (p_P.appLE ⊤ (D β) le_top ≫ (U_β'.ι ≫ Φ).appLE (D β) ⊤ _)).hom r₀ =
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
                (g.appLE ⊤ (U j) le_top ≫ (U_β'.ι ≫ U₀.ι).appLE (U j) ⊤ _)).hom r₀
            erw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE,
              AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
            have h_base_eq : (U_β'.ι ≫ Φ) ≫ p_P = (U_β'.ι ≫ U₀.ι) ≫ g := by
              rw [CategoryTheory.Category.assoc, hΦ, CategoryTheory.Category.assoc]
            have h_app_base := h_appLE_congrHom h_base_eq ⊤ ⊤
              (fun _ _ => trivial) (fun _ _ => trivial)
            erw [h_app_base]
          · intro m
            simp only [RingHom.coe_comp, Function.comp_apply, τ_β, σ_j, MvPolynomial.eval₂Hom_X',
              z_vec]
            change (α_β_hom ≫ s_β.appTop).hom (z (β_m m) β) = res_Uj_hom.hom (f j m)
            rw [h_lhs_map, h_rhs_map]
            rw [AlgebraicGeometry.Scheme.Hom.comp_appLE U_β'.ι Φ (D β) ⊤ _]
            erw [AlgebraicGeometry.Scheme.Hom.comp_appLE U_β'.ι U₀.ι (U j) ⊤ _,
              AlgebraicGeometry.Scheme.Hom.app_eq_appLE U₀.ι]
            change (U_β'.ι.appLE ((TopologicalSpace.Opens.map Φ.base).obj (D β)) ⊤ _).hom
                ((Φ.app (D β)).hom (z (β_m m) β)) =
              (U_β'.ι.appLE ((TopologicalSpace.Opens.map U₀.ι.base).obj (U j)) ⊤ _).hom
                ((U₀.ι.appLE (U j) ((TopologicalSpace.Opens.map U₀.ι.base).obj (U j)) le_rfl).hom (f j m))
            rw [hβ_m m]
            change (U₀.ι.appLE (U j) ((TopologicalSpace.Opens.map Φ.base).obj (D β)) _ ≫
                U_β'.ι.appLE ((TopologicalSpace.Opens.map Φ.base).obj (D β)) ⊤ _).hom (f j m) =
              (U₀.ι.appLE (U j) ((TopologicalSpace.Opens.map U₀.ι.base).obj (U j)) le_rfl ≫
                U_β'.ι.appLE ((TopologicalSpace.Opens.map U₀.ι.base).obj (U j)) ⊤ _).hom (f j m)
            erw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE,
              AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]

        have hI_le_ker : I_β ≤ RingHom.ker α_β := by
          rw [Ideal.map_le_iff_le_comap]
          intro p hp
          change α_β (τ_β p) = 0
          apply hInj_sβ
          rw [map_zero]
          have hp' := RingHom.congr_fun h_poly_Uβ p
          simp only [RingHom.comp_apply] at hp'
          rw [hp']
          have hp0 : σ_j p = 0 := hp
          rw [hp0, map_zero]

        let αbar_β : Q_β →+* ↑(V_β.toScheme.presheaf.obj (Opposite.op ⊤)) :=
          Ideal.Quotient.lift I_β α_β hI_le_ker
        have hαbar_mk : αbar_β.comp mk_β = α_β := rfl

        let C_β := AlgebraicGeometry.Spec (CommRingCat.of Q_β)
        let ι_C : C_β ⟶ (D β).toScheme :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_β) ≫ (hAffD β).isoSpec.inv
        have hCl_ιC : AlgebraicGeometry.IsClosedImmersion ι_C := by
          have _ : AlgebraicGeometry.IsClosedImmersion
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_β)) :=
            AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom mk_β)
              Ideal.Quotient.mk_surjective
          infer_instance

        let ψ_β : C_β ⟶ C :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_β) ≫ (hAffU j).fromSpec
        let q_β : V_β.toScheme ⟶ C_β :=
          V_β.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom αbar_β)

        have hq_ιC : q_β ≫ ι_C = f_β := by
          have h_mk_hom : CommRingCat.ofHom mk_β ≫ CommRingCat.ofHom αbar_β = α_β_hom := by
            ext x
            rfl
          have h_spec_mk :
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom αbar_β) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_β) =
              AlgebraicGeometry.Spec.map α_β_hom :=
            (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
              (congrArg AlgebraicGeometry.Spec.map h_mk_hom)
          calc
            q_β ≫ ι_C
              = (V_β.toScheme.toSpecΓ ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom αbar_β) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_β))) ≫
                (hAffD β).isoSpec.inv := by
                  dsimp only [q_β, ι_C]
                  exact ((CategoryTheory.Category.assoc _ _ _).symm.trans
                    (congrArg (· ≫ (hAffD β).isoSpec.inv)
                      (CategoryTheory.Category.assoc _ _ _)))
            _ = (V_β.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map α_β_hom) ≫
                  (hAffD β).isoSpec.inv :=
                  congrArg (· ≫ (hAffD β).isoSpec.inv)
                    (congrArg (V_β.toScheme.toSpecΓ ≫ ·) h_spec_mk)
            _ = (f_β ≫ (hAffD β).isoSpec.hom) ≫ (hAffD β).isoSpec.inv := by
                  rw [← hToSpecEq (f_β ≫ (hAffD β).isoSpec.hom)]
            _ = f_β := by
                  rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
                    CategoryTheory.Category.comp_id]

        have hq_ψβ : q_β ≫ ψ_β = V_β.ι ≫ π := by
          have _ := hSepC
          have _ := hDom_sβ
          apply AlgebraicGeometry.ext_of_isDominant s_β
          have h_rhs : s_β ≫ V_β.ι ≫ π =
              (U_β'.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map res_Uj_hom) ≫
                (hAffU j).fromSpec := by
            rw [← CategoryTheory.Category.assoc, hs_β_ι, CategoryTheory.Category.assoc, hν_π,
              ← huj_fac, ← hToSpecEq (u_j ≫ (hAffU j).isoSpec.hom)]
            dsimp only [AlgebraicGeometry.IsAffineOpen.fromSpec]
            rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (hAffU j).isoSpec.hom,
              CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp]
          have h_lhs : s_β ≫ q_β ≫ ψ_β =
              (U_β'.toScheme.toSpecΓ ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom θ_β ≫ CommRingCat.ofHom αbar_β ≫ s_β.appTop)) ≫
                (hAffU j).fromSpec := by
            dsimp only [q_β, ψ_β]
            rw [← CategoryTheory.Category.assoc s_β, ← CategoryTheory.Category.assoc s_β,
              AlgebraicGeometry.Scheme.toSpecΓ_naturality s_β]
            rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
            simp only [CategoryTheory.Category.assoc]
            rfl
          rw [h_lhs, h_rhs]
          congr 2
          have h_ring_eq : CommRingCat.ofHom θ_β ≫ CommRingCat.ofHom αbar_β ≫ s_β.appTop =
              res_Uj_hom := by
            ext a
            obtain ⟨p, rfl⟩ := hGen j a
            have h_θp := RingHom.congr_fun hθ_σ p
            simp only [RingHom.comp_apply] at h_θp
            change s_β.appTop.hom (αbar_β (θ_β (σ_j p))) = (res_Uj_hom.hom.comp σ_j) p
            rw [h_θp]
            exact RingHom.congr_fun h_poly_Uβ p
          rw [h_ring_eq]

        have hψ_ιC_comm : ψ_β ≫ g = (ι_C ≫ (D β).ι) ≫ p_P := by
          dsimp only [ψ_β, ι_C]
          have h1 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec g
            (AlgebraicGeometry.isAffineOpen_top S) (hAffU j) le_top
          have h2 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p_P
            (AlgebraicGeometry.isAffineOpen_top S) (hAffD β) le_top
          have h_fD : (hAffD β).isoSpec.inv ≫ (D β).ι = (hAffD β).fromSpec := rfl
          rw [CategoryTheory.Category.assoc, ← h1,
            CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_β)),
            h_fD, CategoryTheory.Category.assoc, ← h2,
            ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
          congr 2
          apply (cancel_epi (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv).mp
          ext r₀
          change θ_β (κ_j r₀) = mk_β (κ_Pβ r₀)
          have h_c := RingHom.congr_fun hθ_σ (MvPolynomial.C r₀)
          simpa [σ_j, τ_β] using h_c

        let Ψ_tilde : C_β ⟶ Z :=
          CategoryTheory.Limits.pullback.lift ψ_β (ι_C ≫ (D β).ι) hψ_ιC_comm
        let W_Z : Z.Opens := (TopologicalSpace.Opens.map snd.base).obj (D β)
        have hRange_Ψ : Set.range Ψ_tilde.base ⊆ Set.range W_Z.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨c, rfl⟩
          change (Ψ_tilde ≫ snd).base c ∈ D β
          rw [CategoryTheory.Limits.pullback.lift_snd]
          exact ((ι_C.base c)).2
        let Ψ_β : C_β ⟶ W_Z.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift W_Z.ι Ψ_tilde hRange_Ψ
        have hΨ_fac : Ψ_β ≫ W_Z.ι = Ψ_tilde :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac W_Z.ι Ψ_tilde hRange_Ψ

        let snd_β : W_Z.toScheme ⟶ (D β).toScheme := snd ∣_ D β
        have hsnd_β_ι : snd_β ≫ (D β).ι = W_Z.ι ≫ snd :=
          AlgebraicGeometry.morphismRestrict_ι snd (D β)
        have hΨ_snd : Ψ_β ≫ snd_β = ι_C := by
          apply (cancel_mono (D β).ι).mp
          rw [CategoryTheory.Category.assoc, hsnd_β_ι, ← CategoryTheory.Category.assoc, hΨ_fac,
            CategoryTheory.Limits.pullback.lift_snd]
        have _ : AlgebraicGeometry.IsSeparated snd := inferInstance
        have _ : AlgebraicGeometry.IsSeparated snd_β := inferInstance
        have hSep_Ψsnd : AlgebraicGeometry.IsSeparated (Ψ_β ≫ snd_β) := by
          rw [hΨ_snd]; infer_instance
        have hSep_Ψ : AlgebraicGeometry.IsSeparated Ψ_β :=
          @AlgebraicGeometry.IsSeparated.of_comp _ _ _ Ψ_β snd_β hSep_Ψsnd

        let V_β_Z : X'.Opens := (TopologicalSpace.Opens.map ι_img.base).obj W_Z
        have hV_Z_eq : V_β = V_β_Z := by
          apply TopologicalSpace.Opens.ext
          ext y
          change p₂.base y ∈ D β ↔ (ι_img ≫ snd).base y ∈ D β
          rw [hp₂_def]
        let e_VZ : V_β.toScheme ≅ V_β_Z.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq V_β.ι V_β_Z.ι
            (by simp [hV_Z_eq])
        have he_VZ : e_VZ.hom ≫ V_β_Z.ι = V_β.ι :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac V_β.ι V_β_Z.ι _
        have hPb_img_WZ : CategoryTheory.IsPullback (ι_img ∣_ W_Z) V_β_Z.ι W_Z.ι ι_img :=
          AlgebraicGeometry.IsOpenImmersion.isPullback (ι_img ∣_ W_Z) V_β_Z.ι W_Z.ι ι_img
            (AlgebraicGeometry.morphismRestrict_ι ι_img W_Z).symm
            (by ext y; simp [V_β_Z, AlgebraicGeometry.Scheme.Opens.opensRange_ι])
        have hCl_res_WZ : AlgebraicGeometry.IsClosedImmersion (ι_img ∣_ W_Z) :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            hPb_img_WZ.flip inferInstance
        have hqΨ_eq : q_β ≫ Ψ_β = e_VZ.hom ≫ (ι_img ∣_ W_Z) := by
          apply (cancel_mono W_Z.ι).mp
          rw [CategoryTheory.Category.assoc q_β Ψ_β W_Z.ι, hΨ_fac,
            CategoryTheory.Category.assoc e_VZ.hom (ι_img ∣_ W_Z) W_Z.ι,
            AlgebraicGeometry.morphismRestrict_ι,
            ← CategoryTheory.Category.assoc e_VZ.hom, he_VZ]
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hq_ψβ,
              hπ_def, CategoryTheory.Category.assoc]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc, hq_ιC, hf_β_ι, hp₂_def,
              CategoryTheory.Category.assoc]
        have hCl_qΨ : AlgebraicGeometry.IsClosedImmersion (q_β ≫ Ψ_β) := by
          rw [hqΨ_eq]
          infer_instance
        have hCl_qβ : AlgebraicGeometry.IsClosedImmersion q_β :=
          @AlgebraicGeometry.IsClosedImmersion.of_comp _ _ _ q_β Ψ_β hCl_qΨ hSep_Ψ
        rw [← hq_ιC]
        infer_instance
      · have _ : IsEmpty ↥V_β.toScheme := not_nonempty_iff.mp hNonVβ
        infer_instance

    have hImm_p₂ : AlgebraicGeometry.IsImmersion p₂ :=
      AlgebraicGeometry.IsImmersion.isImmersion_iff_exists.mpr
        ⟨W_good.toScheme, p₂_W, W_good.ι, hCl_p₂_W, inferInstance, hp₂_W_fac⟩

    let Xbar := AlgebraicGeometry.Scheme.Hom.image p₂
    let j_imm : X' ⟶ Xbar := AlgebraicGeometry.Scheme.Hom.toImage p₂
    let gbar : Xbar ⟶ S := AlgebraicGeometry.Scheme.Hom.imageι p₂ ≫ p_P

    have hOpen_j : AlgebraicGeometry.IsOpenImmersion j_imm := inferInstance
    have hProp_gbar : AlgebraicGeometry.IsProper gbar := inferInstance
    have hRoof_comm : π ≫ g = j_imm ≫ gbar := by
      dsimp only [j_imm, gbar]
      rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι, hp₂_comp]

    exact ⟨X', Xbar, π, j_imm, gbar, hProp_π, hSurj_π, hOpen_j, hProp_gbar, hRoof_comm⟩

  have hStep4 :
      ∃ (J : Type u) (_ : CategoryTheory.SmallCategory J) (_ : CategoryTheory.IsFiltered J)
        (R_diag : CategoryTheory.Functor J CommRingCat.{u})
        (α_diag : (CategoryTheory.Functor.const J).obj
          (CommRingCat.of ↥(Algebra.adjoin k (↑F₂ : Set K))) ⟶ R_diag)
        (ι_colim : R_diag ⟶ (CategoryTheory.Functor.const J).obj (CommRingCat.of ↥V)),
        Nonempty (CategoryTheory.Limits.IsColimit
          (CategoryTheory.Limits.Cocone.mk (CommRingCat.of ↥V) ι_colim)) ∧
        (∀ i : J, α_diag.app i ≫ ι_colim.app i = CommRingCat.ofHom ι₂_FV) ∧
        (∀ i : J, ∃ (F₃ : Finset K) (hSub₂₃ : F₂ ⊆ F₃)
          (e_ring : CommRingCat.of ↥(Algebra.adjoin k (↑F₃ : Set K)) ≅ R_diag.obj i),
          (∀ x ∈ F₃, x ∈ V) ∧
          CommRingCat.ofHom
            (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub₂₃))).toRingHom ≫
            e_ring.hom = α_diag.app i) := by
    clear hStep1 hStep2 hStep3 C_V g_V hPropV C₂ hIntC₂ g₂ hQC₂ hSep₂ hLFP₂ ι₂_V hPb₂
    let _ : DecidableEq K := Classical.decEq K
    let J : Type u := {F : Finset K // F₂ ⊆ F ∧ ∀ x ∈ F, x ∈ V}
    let _ : Preorder J := Preorder.lift (fun i : J => i.1)
    let _ : CategoryTheory.SmallCategory J := inferInstance
    let i₀ : J := ⟨F₂, Finset.Subset.refl _, hF₂⟩
    let _ : Nonempty J := ⟨i₀⟩
    let supJ : J → J → J := fun i₁ i₂ =>
      ⟨i₁.1 ∪ i₂.1,
        i₁.2.1.trans Finset.subset_union_left,
        fun x hx => (Finset.mem_union.mp hx).elim (i₁.2.2 x) (i₂.2.2 x)⟩
    have hle_left : ∀ i₁ i₂ : J, i₁ ≤ supJ i₁ i₂ := fun _ _ => Finset.subset_union_left
    have hle_right : ∀ i₁ i₂ : J, i₂ ≤ supJ i₁ i₂ := fun _ _ => Finset.subset_union_right
    let _ : IsDirectedOrder J := ⟨fun i₁ i₂ => ⟨supJ i₁ i₂, hle_left i₁ i₂, hle_right i₁ i₂⟩⟩
    let _ : CategoryTheory.IsFiltered J := CategoryTheory.isFiltered_of_directed_le_nonempty J
    have hMemAdjoin : ∀ (F : Finset K), (∀ x ∈ F, x ∈ V) →
        ∀ z ∈ Algebra.adjoin k (↑F : Set K), z ∈ V := by
      intro F hFV z hz
      exact Algebra.adjoin_induction
        (fun y hy => hFV y (Finset.mem_coe.mp hy))
        (fun c => hkV c)
        (fun _ _ _ _ hx hy => add_mem hx hy)
        (fun _ _ _ _ hx hy => mul_mem hx hy) hz
    let ι_FV : ∀ i : J, ↥(Algebra.adjoin k (↑i.1 : Set K)) →+* ↥V := fun i =>
      (Algebra.adjoin k (↑i.1 : Set K)).val.toRingHom.codRestrict V.toSubring
        (fun z => hMemAdjoin i.1 i.2.2 z.1 z.2)
    let R_diag : CategoryTheory.Functor J CommRingCat.{u} :=
      { obj := fun i => CommRingCat.of ↥(Algebra.adjoin k (↑i.1 : Set K))
        map := fun {i₁ i₂} u => CommRingCat.ofHom
          (Subalgebra.inclusion
            (Algebra.adjoin_mono (R := k) (Finset.coe_subset.mpr (leOfHom u)))).toRingHom
        map_id := fun _ => by ext x; rfl
        map_comp := fun _ _ => by ext x; rfl }
    let α_diag : (CategoryTheory.Functor.const J).obj
        (CommRingCat.of ↥(Algebra.adjoin k (↑F₂ : Set K))) ⟶ R_diag :=
      { app := fun i => CommRingCat.ofHom
          (Subalgebra.inclusion
            (Algebra.adjoin_mono (R := k) (Finset.coe_subset.mpr i.2.1))).toRingHom
        naturality := fun _ _ _ => by ext x; rfl }
    let ι_colim : R_diag ⟶ (CategoryTheory.Functor.const J).obj (CommRingCat.of ↥V) :=
      { app := fun i => CommRingCat.ofHom (ι_FV i)
        naturality := fun _ _ _ => by ext x; rfl }
    have hα_comp : ∀ i : J, α_diag.app i ≫ ι_colim.app i = CommRingCat.ofHom ι₂_FV := by
      intro i
      ext x
      apply V.subtype_injective
      have h1 := RingHom.congr_fun hι₂ x
      exact h1.symm
    have hColim : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.Cocone.mk (CommRingCat.of ↥V) ι_colim) := by
      let idxV : ↥V → J := fun v =>
        ⟨insert v.1 F₂, Finset.subset_insert _ _,
          fun x hx => (Finset.mem_insert.mp hx).elim (fun h => h ▸ v.2) (hF₂ x)⟩
      have hMemV : ∀ v : ↥V, v.1 ∈ Algebra.adjoin k (↑(idxV v).1 : Set K) := fun v =>
        Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_insert_self v.1 F₂))
      let evalV : ∀ (s : CategoryTheory.Limits.Cocone R_diag), ↥V → ↑s.pt :=
        fun s v => (s.ι.app (idxV v)).hom ⟨v.1, hMemV v⟩
      have h_eval : ∀ (s : CategoryTheory.Limits.Cocone R_diag) (i : J) (x : R_diag.obj i),
          evalV s (ι_FV i x) = ((s.ι.app i).hom x : ↑s.pt) := by
        intro s i x
        let u := supJ (idxV (ι_FV i x)) i
        have h1 := s.ι.naturality (homOfLE (hle_left (idxV (ι_FV i x)) i))
        have h2 := s.ι.naturality (homOfLE (hle_right (idxV (ι_FV i x)) i))
        dsimp [Functor.const] at h1 h2
        rw [CategoryTheory.Category.comp_id] at h1 h2
        dsimp [evalV]
        rw [← h1, ← h2]
        change (s.ι.app u).hom ((R_diag.map (homOfLE _)).hom _) =
          (s.ι.app u).hom ((R_diag.map (homOfLE _)).hom _)
        congr 1
      refine
        { desc := fun s =>
            CommRingCat.ofHom
              { toFun := evalV s
                map_one' := by
                  have h1 : ι_FV i₀ 1 = 1 := map_one _
                  rw [← h1, h_eval s i₀ 1, map_one]
                map_mul' := fun v₁ v₂ => by
                  let u := supJ (idxV v₁) (idxV v₂)
                  let x₁ : R_diag.obj u :=
                    (R_diag.map (homOfLE (hle_left (idxV v₁) (idxV v₂)))).hom ⟨v₁.1, hMemV v₁⟩
                  let x₂ : R_diag.obj u :=
                    (R_diag.map (homOfLE (hle_right (idxV v₁) (idxV v₂)))).hom ⟨v₂.1, hMemV v₂⟩
                  have hx₁ : ι_FV u x₁ = v₁ := by ext; rfl
                  have hx₂ : ι_FV u x₂ = v₂ := by ext; rfl
                  have h12 : ι_FV u (x₁ * x₂) = v₁ * v₂ := by rw [map_mul, hx₁, hx₂]
                  rw [← h12, h_eval s u (x₁ * x₂), ← hx₁, ← hx₂, h_eval s u x₁, h_eval s u x₂]
                  exact map_mul (s.ι.app u).hom x₁ x₂
                map_zero' := by
                  have h0 : ι_FV i₀ 0 = 0 := map_zero _
                  rw [← h0, h_eval s i₀ 0, map_zero]
                map_add' := fun v₁ v₂ => by
                  let u := supJ (idxV v₁) (idxV v₂)
                  let x₁ : R_diag.obj u :=
                    (R_diag.map (homOfLE (hle_left (idxV v₁) (idxV v₂)))).hom ⟨v₁.1, hMemV v₁⟩
                  let x₂ : R_diag.obj u :=
                    (R_diag.map (homOfLE (hle_right (idxV v₁) (idxV v₂)))).hom ⟨v₂.1, hMemV v₂⟩
                  have hx₁ : ι_FV u x₁ = v₁ := by ext; rfl
                  have hx₂ : ι_FV u x₂ = v₂ := by ext; rfl
                  have h12 : ι_FV u (x₁ + x₂) = v₁ + v₂ := by rw [map_add, hx₁, hx₂]
                  rw [← h12, h_eval s u (x₁ + x₂), ← hx₁, ← hx₂, h_eval s u x₁, h_eval s u x₂]
                  exact map_add (s.ι.app u).hom x₁ x₂ }
          fac := fun s i => by
            ext x
            exact h_eval s i x
          uniq := fun s m hm => by
            ext v
            exact congrArg (fun (f : R_diag.obj (idxV v) ⟶ s.pt) => f.hom ⟨v.1, hMemV v⟩) (hm (idxV v)) }
    refine ⟨J, inferInstance, inferInstance, R_diag, α_diag, ι_colim, ⟨hColim⟩, hα_comp, ?_⟩
    intro i
    exact ⟨i.1, i.2.1, CategoryTheory.Iso.refl _, i.2.2, CategoryTheory.Category.comp_id _⟩

  have hStep5 : ∀ (R₀ R_V : CommRingCat.{u})
      (β₀ : R₀ ⟶ R_V)
      (J : Type u) [CategoryTheory.SmallCategory J] [CategoryTheory.IsFiltered J]
      (R_diag : CategoryTheory.Functor J CommRingCat.{u})
      (α_diag : (CategoryTheory.Functor.const J).obj R₀ ⟶ R_diag)
      (ι_colim : R_diag ⟶ (CategoryTheory.Functor.const J).obj R_V)
      (_ : Nonempty (CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.Cocone.mk R_V ι_colim)))
      (_ : ∀ i : J, α_diag.app i ≫ ι_colim.app i = β₀)
      (C₀ : AlgebraicGeometry.Scheme.{u})
      (g₀ : C₀ ⟶ AlgebraicGeometry.Spec R₀)
      (_ : AlgebraicGeometry.QuasiCompact g₀)
      (_ : AlgebraicGeometry.IsSeparated g₀)
      (_ : AlgebraicGeometry.LocallyOfFiniteType g₀)
      (X'₀ Xbar₀ : AlgebraicGeometry.Scheme.{u})
      (π₀ : X'₀ ⟶ C₀)
      (j₀ : X'₀ ⟶ Xbar₀)
      (gbar₀ : Xbar₀ ⟶ AlgebraicGeometry.Spec R₀)
      (_ : AlgebraicGeometry.IsProper π₀)
      (_ : AlgebraicGeometry.Surjective π₀)
      (_ : AlgebraicGeometry.IsOpenImmersion j₀)
      (_ : AlgebraicGeometry.IsProper gbar₀)
      (_ : π₀ ≫ g₀ = j₀ ≫ gbar₀)
      (C_V₀ : AlgebraicGeometry.Scheme.{u})
      (g_V₀ : C_V₀ ⟶ AlgebraicGeometry.Spec R_V)
      (_ : AlgebraicGeometry.IsProper g_V₀)
      (ι_V₀ : C_V₀ ⟶ C₀)
      (_ : CategoryTheory.IsPullback ι_V₀ g_V₀ g₀ (AlgebraicGeometry.Spec.map β₀)),
      ∃ i : J,
        AlgebraicGeometry.IsProper
          (CategoryTheory.Limits.pullback.snd g₀
            (AlgebraicGeometry.Spec.map (α_diag.app i))) := by
    clear hStep1 hStep2 hStep3 hStep4 V hkV C_V g_V hPropV F₂ hF₂ ι₂_FV hι₂
      C₂ hIntC₂ g₂ hQC₂ hSep₂ hLFP₂ ι₂_V hPb₂
    intro R₀ R_V β₀ J _ _ R_diag α_diag ι_colim hColim hα_comp
      C₀ g₀ hQC₀ hSep₀ hLFT₀ X'₀ Xbar₀ π₀ j₀ gbar₀
      hProp_π₀ hSurj_π₀ hOpen_j₀ hProp_gbar₀ hRoof_comm
      C_V g_V hPropV ι_V hPb₀
    have hOpensRangePb : ∀ {P X Y Z : AlgebraicGeometry.Scheme.{u}}
        {fst : P ⟶ X} {snd : P ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z}
        [AlgebraicGeometry.IsOpenImmersion snd] [AlgebraicGeometry.IsOpenImmersion f],
        CategoryTheory.IsPullback fst snd f g →
        snd.opensRange = (TopologicalSpace.Opens.map g.base).obj f.opensRange := by
      intro P X Y Z fst snd f g _ _ hPb
      apply TopologicalSpace.Opens.ext
      ext y
      simp only [AlgebraicGeometry.Scheme.Hom.coe_opensRange,
        TopologicalSpace.Opens.map_coe, Set.mem_preimage, Set.mem_range]
      constructor
      · rintro ⟨p, rfl⟩
        refine ⟨fst.base p, ?_⟩
        change (fst ≫ f).base p = (snd ≫ g).base p
        rw [hPb.w]
      · rintro ⟨x, hx⟩
        obtain ⟨p, _, hp₂⟩ := AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb x y hx
        exact ⟨p, hp₂⟩

    obtain ⟨hc_R⟩ := hColim
    let I : Type u := Jᵒᵖ
    have hConnI : CategoryTheory.IsConnected I := CategoryTheory.IsCofiltered.isConnected I
    let S₀ := AlgebraicGeometry.Spec R₀
    let S_V := AlgebraicGeometry.Spec R_V
    let ρ_V : S_V ⟶ S₀ := AlgebraicGeometry.Spec.map β₀

    let c_R_op : CategoryTheory.Limits.Cone R_diag.op :=
      (CategoryTheory.Limits.Cocone.mk R_V ι_colim).op
    have hc_R_op : CategoryTheory.Limits.IsLimit c_R_op := hc_R.op
    have _ : CategoryTheory.Limits.PreservesLimitsOfSize.{u, u} AlgebraicGeometry.Scheme.Spec.{u} :=
      AlgebraicGeometry.ΓSpec.adjunction.rightAdjoint_preservesLimits
    let D_S : I ⥤ AlgebraicGeometry.Scheme.{u} := R_diag.op ⋙ AlgebraicGeometry.Scheme.Spec
    let c_S : CategoryTheory.Limits.Cone D_S := AlgebraicGeometry.Scheme.Spec.mapCone c_R_op
    have hc_S : CategoryTheory.Limits.IsLimit c_S :=
      CategoryTheory.Limits.isLimitOfPreserves AlgebraicGeometry.Scheme.Spec hc_R_op

    let ρ : ∀ i : J, D_S.obj (Opposite.op i) ⟶ S₀ :=
      fun i => AlgebraicGeometry.Spec.map (α_diag.app i)
    have h_DS_ρ : ∀ {u₁ u₂ : I} (f : u₁ ⟶ u₂), D_S.map f ≫ ρ u₂.unop = ρ u₁.unop := by
      intro u₁ u₂ f
      dsimp [D_S, ρ]
      have h_nat := α_diag.naturality f.unop
      dsimp [CategoryTheory.Functor.const] at h_nat
      rw [CategoryTheory.Category.id_comp] at h_nat
      rw [← AlgebraicGeometry.Spec.map_comp, h_nat]
    have h_cS_ρ : ∀ u : I, c_S.π.app u ≫ ρ u.unop = ρ_V := by
      intro u
      dsimp [c_S, c_R_op, ρ, ρ_V]
      rw [← AlgebraicGeometry.Spec.map_comp, hα_comp u.unop]

    let D_Over : I ⥤ CategoryTheory.Over S₀ :=
      { obj := fun u => CategoryTheory.Over.mk (ρ u.unop)
        map := fun f => CategoryTheory.Over.homMk (D_S.map f) (h_DS_ρ f)
        map_id := fun u => by ext; exact D_S.map_id u
        map_comp := fun f g => by ext; exact D_S.map_comp f g }
    let c_Over : CategoryTheory.Limits.Cone D_Over :=
      { pt := CategoryTheory.Over.mk ρ_V
        π :=
          { app := fun u => CategoryTheory.Over.homMk (c_S.π.app u) (h_cS_ρ u)
            naturality := fun u₁ u₂ f => by ext; exact c_S.π.naturality f } }
    have hc_Over : CategoryTheory.Limits.IsLimit c_Over := by
      let u₀ : I := Classical.arbitrary I
      refine
        { lift := fun s =>
            CategoryTheory.Over.homMk (hc_S.lift ((CategoryTheory.Over.forget S₀).mapCone s)) (by
              dsimp [c_Over]
              rw [← h_cS_ρ u₀, ← CategoryTheory.Category.assoc,
                hc_S.fac ((CategoryTheory.Over.forget S₀).mapCone s) u₀]
              exact (s.π.app u₀).w)
          fac := fun s u => by
            ext
            exact hc_S.fac ((CategoryTheory.Over.forget S₀).mapCone s) u
          uniq := fun s m hm => by
            ext
            exact hc_S.uniq ((CategoryTheory.Over.forget S₀).mapCone s) m.left
              (fun u => congrArg CommaMorphism.left (hm u)) }

    have _ : (CategoryTheory.Over.pullback gbar₀).IsRightAdjoint :=
      CategoryTheory.Over.pullbackIsRightAdjoint gbar₀
    have _ : CategoryTheory.Limits.PreservesLimitsOfShape I (CategoryTheory.Over.forget Xbar₀) :=
      @CategoryTheory.Over.preservesLimitsOfShape_forget_of_isConnected I _ _ _ hConnI Xbar₀
    let D_Xbar : I ⥤ AlgebraicGeometry.Scheme.{u} :=
      D_Over ⋙ CategoryTheory.Over.pullback gbar₀ ⋙ CategoryTheory.Over.forget Xbar₀
    let c_Xbar : CategoryTheory.Limits.Cone D_Xbar :=
      (CategoryTheory.Over.forget Xbar₀).mapCone ((CategoryTheory.Over.pullback gbar₀).mapCone c_Over)
    have hc_Xbar : CategoryTheory.Limits.IsLimit c_Xbar :=
      CategoryTheory.Limits.isLimitOfPreserves (CategoryTheory.Over.forget Xbar₀)
        (CategoryTheory.Limits.isLimitOfPreserves (CategoryTheory.Over.pullback gbar₀) hc_Over)

    let gbar_u : ∀ u : I, D_Xbar.obj u ⟶ D_S.obj u :=
      fun u => CategoryTheory.Limits.pullback.fst (ρ u.unop) gbar₀
    have hProp_gbar_u : ∀ u : I, AlgebraicGeometry.IsProper (gbar_u u) := fun u => inferInstance
    have hComp_Xbar : ∀ u : I, CompactSpace ↥(D_Xbar.obj u) := fun u =>
      have _ := hProp_gbar_u u
      have _ : CompactSpace ↥(AlgebraicGeometry.Spec (R_diag.obj u.unop)) := inferInstance
      @AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace _ _ (gbar_u u)
        inferInstance ‹CompactSpace ↥(AlgebraicGeometry.Spec (R_diag.obj u.unop))›
    have hSep_Xbar : ∀ u : I, (D_Xbar.obj u).IsSeparated := by
      intro u
      have _ := hProp_gbar_u u
      have hSepSu : (AlgebraicGeometry.Spec (R_diag.obj u.unop)).IsSeparated := inferInstance
      have hSepTermSu : AlgebraicGeometry.IsSeparated
          (CategoryTheory.Limits.terminal.from (D_S.obj u)) := by
        change AlgebraicGeometry.IsSeparated
          (CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec (R_diag.obj u.unop)))
        rwa [AlgebraicGeometry.Scheme.isSeparated_iff] at hSepSu
      have hTermEq : CategoryTheory.Limits.terminal.from (D_Xbar.obj u) =
          gbar_u u ≫ CategoryTheory.Limits.terminal.from (D_S.obj u) :=
        CategoryTheory.Limits.terminal.hom_ext _ _
      have hSepTermX : AlgebraicGeometry.IsSeparated
          (CategoryTheory.Limits.terminal.from (D_Xbar.obj u)) := by
        rw [hTermEq]
        infer_instance
      rwa [AlgebraicGeometry.Scheme.isSeparated_iff]
    have hQS_Xbar : ∀ u : I, QuasiSeparatedSpace ↥(D_Xbar.obj u) := fun u =>
      have _ := hSep_Xbar u
      inferInstance
    have hAff_map : ∀ {u₁ u₂ : I} (f : u₁ ⟶ u₂), AlgebraicGeometry.IsAffineHom (D_Xbar.map f) := by
      intro u₁ u₂ f
      have hPb_f : CategoryTheory.IsPullback (D_Xbar.map f) (gbar_u u₁) (gbar_u u₂) (D_S.map f) := by
        refine CategoryTheory.IsPullback.of_right ?_ ?_
          (CategoryTheory.IsPullback.of_hasPullback (ρ u₂.unop) gbar₀).flip
        · have h_snd_map : D_Xbar.map f ≫ CategoryTheory.Limits.pullback.snd (ρ u₂.unop) gbar₀ =
              CategoryTheory.Limits.pullback.snd (ρ u₁.unop) gbar₀ := by
            dsimp [D_Xbar, CategoryTheory.Over.pullback, D_Over]
            exact CategoryTheory.Limits.pullback.lift_snd _ _ _
          change CategoryTheory.IsPullback
            (D_Xbar.map f ≫ CategoryTheory.Limits.pullback.snd (ρ u₂.unop) gbar₀)
            (CategoryTheory.Limits.pullback.fst (ρ u₁.unop) gbar₀) gbar₀
            (D_S.map f ≫ ρ u₂.unop)
          rw [h_snd_map, h_DS_ρ f]
          exact (CategoryTheory.IsPullback.of_hasPullback (ρ u₁.unop) gbar₀).flip
        · dsimp [D_Xbar, CategoryTheory.Over.pullback, D_Over, gbar_u]
          exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hAff_DS : AlgebraicGeometry.IsAffineHom (D_S.map f) := by
        change AlgebraicGeometry.IsAffineHom (AlgebraicGeometry.Spec.map (R_diag.map f.unop))
        infer_instance
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_f.flip hAff_DS

    let C_i : ∀ i : J, AlgebraicGeometry.Scheme.{u} :=
      fun i => CategoryTheory.Limits.pullback g₀ (ρ i)
    let g_i : ∀ i : J, C_i i ⟶ D_S.obj (Opposite.op i) :=
      fun i => CategoryTheory.Limits.pullback.snd g₀ (ρ i)
    let X'_i : ∀ i : J, AlgebraicGeometry.Scheme.{u} :=
      fun i => CategoryTheory.Limits.pullback (π₀ ≫ g₀) (ρ i)
    let π_i : ∀ i : J, X'_i i ⟶ C_i i := fun i =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (π₀ ≫ g₀) (ρ i) ≫ π₀)
        (CategoryTheory.Limits.pullback.snd (π₀ ≫ g₀) (ρ i))
        (by rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition])
    have hPb_πi : ∀ i : J, CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (π₀ ≫ g₀) (ρ i)) (π_i i) π₀
        (CategoryTheory.Limits.pullback.fst g₀ (ρ i)) := by
      intro i
      refine CategoryTheory.IsPullback.of_bot ?_ ?_
        (CategoryTheory.IsPullback.of_hasPullback g₀ (ρ i))
      · rw [CategoryTheory.Limits.pullback.lift_snd]
        exact CategoryTheory.IsPullback.of_hasPullback (π₀ ≫ g₀) (ρ i)
      · exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
    have hProp_πi : ∀ i : J, AlgebraicGeometry.IsProper (π_i i) := fun i =>
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback (hPb_πi i) hProp_π₀
    have hSurj_πi : ∀ i : J, AlgebraicGeometry.Surjective (π_i i) := fun i =>
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback (hPb_πi i) hSurj_π₀
    have hComp_X'i : ∀ i : J, CompactSpace ↥(X'_i i) := by
      intro i
      have _ : AlgebraicGeometry.QuasiCompact (π₀ ≫ g₀) := inferInstance
      have hQC_snd : AlgebraicGeometry.QuasiCompact
          (CategoryTheory.Limits.pullback.snd (π₀ ≫ g₀) (ρ i)) := inferInstance
      have _ : CompactSpace ↥(AlgebraicGeometry.Spec (R_diag.obj i)) := inferInstance
      exact @AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace _ _
        (CategoryTheory.Limits.pullback.snd (π₀ ≫ g₀) (ρ i)) hQC_snd
        ‹CompactSpace ↥(AlgebraicGeometry.Spec (R_diag.obj i))›

    let j_i : ∀ i : J, X'_i i ⟶ D_Xbar.obj (Opposite.op i) := fun i =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.snd (π₀ ≫ g₀) (ρ i))
        (CategoryTheory.Limits.pullback.fst (π₀ ≫ g₀) (ρ i) ≫ j₀)
        (by
          change CategoryTheory.Limits.pullback.snd (π₀ ≫ g₀) (ρ i) ≫ ρ i =
            (CategoryTheory.Limits.pullback.fst (π₀ ≫ g₀) (ρ i) ≫ j₀) ≫ gbar₀
          rw [CategoryTheory.Category.assoc, ← hRoof_comm,
            CategoryTheory.Limits.pullback.condition.symm])
    have hPb_ji : ∀ i : J, CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (π₀ ≫ g₀) (ρ i)) (j_i i) j₀
        (CategoryTheory.Limits.pullback.snd (ρ i) gbar₀) := by
      intro i
      refine CategoryTheory.IsPullback.of_bot ?_ ?_
        (CategoryTheory.IsPullback.of_hasPullback (ρ i) gbar₀).flip
      · have h_jfst : j_i i ≫ CategoryTheory.Limits.pullback.fst (ρ i) gbar₀ =
            CategoryTheory.Limits.pullback.snd (π₀ ≫ g₀) (ρ i) := by
          dsimp [j_i, D_Xbar, CategoryTheory.Over.pullback, D_Over]
          exact CategoryTheory.Limits.pullback.lift_fst _ _ _
        change CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst (π₀ ≫ g₀) (ρ i))
          (j_i i ≫ CategoryTheory.Limits.pullback.fst (ρ i) gbar₀)
          (j₀ ≫ gbar₀) (ρ i)
        rw [h_jfst, ← hRoof_comm]
        exact CategoryTheory.IsPullback.of_hasPullback (π₀ ≫ g₀) (ρ i)
      · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
    have hOpen_ji : ∀ i : J, AlgebraicGeometry.IsOpenImmersion (j_i i) := fun i =>
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback (hPb_ji i) hOpen_j₀
    have hRoof_i : ∀ i : J, π_i i ≫ g_i i = j_i i ≫ gbar_u (Opposite.op i) := by
      intro i
      have h1 : π_i i ≫ g_i i = CategoryTheory.Limits.pullback.snd (π₀ ≫ g₀) (ρ i) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have h2 : j_i i ≫ gbar_u (Opposite.op i) =
          CategoryTheory.Limits.pullback.snd (π₀ ≫ g₀) (ρ i) := by
        dsimp [j_i, gbar_u, D_Xbar, CategoryTheory.Over.pullback, D_Over]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [h1, h2]

    let X'_V := CategoryTheory.Limits.pullback π₀ ι_V
    let π_V : X'_V ⟶ C_V := CategoryTheory.Limits.pullback.snd π₀ ι_V
    have hProp_πV : AlgebraicGeometry.IsProper π_V := inferInstance
    have hPb_X'V : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst π₀ ι_V) (π_V ≫ g_V) (π₀ ≫ g₀) ρ_V :=
      (CategoryTheory.IsPullback.of_hasPullback π₀ ι_V).paste_vert hPb₀
    let gbar_V : c_Xbar.pt ⟶ S_V := CategoryTheory.Limits.pullback.fst ρ_V gbar₀
    have hProp_gbarV : AlgebraicGeometry.IsProper gbar_V := inferInstance
    let j_V : X'_V ⟶ c_Xbar.pt :=
      CategoryTheory.Limits.pullback.lift
        (π_V ≫ g_V)
        (CategoryTheory.Limits.pullback.fst π₀ ι_V ≫ j₀)
        (by
          change (π_V ≫ g_V) ≫ ρ_V = (CategoryTheory.Limits.pullback.fst π₀ ι_V ≫ j₀) ≫ gbar₀
          rw [CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.fst π₀ ι_V) j₀ gbar₀,
            ← hRoof_comm]
          exact hPb_X'V.w.symm)
    have hPb_jV : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst π₀ ι_V) j_V j₀
        (CategoryTheory.Limits.pullback.snd ρ_V gbar₀) := by
      refine CategoryTheory.IsPullback.of_bot ?_ ?_
        (CategoryTheory.IsPullback.of_hasPullback ρ_V gbar₀).flip
      · have h_jfst : j_V ≫ CategoryTheory.Limits.pullback.fst ρ_V gbar₀ = π_V ≫ g_V := by
          dsimp [j_V, c_Xbar, CategoryTheory.Over.pullback, c_Over]
          exact CategoryTheory.Limits.pullback.lift_fst _ _ _
        change CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst π₀ ι_V)
          (j_V ≫ CategoryTheory.Limits.pullback.fst ρ_V gbar₀)
          (j₀ ≫ gbar₀) ρ_V
        rw [h_jfst, ← hRoof_comm]
        exact hPb_X'V
      · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
    have hOpen_jV : AlgebraicGeometry.IsOpenImmersion j_V :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_jV hOpen_j₀

    have hRange_ji : ∀ i : J, (j_i i).opensRange =
        (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.snd (ρ i) gbar₀).base).obj
          j₀.opensRange := by
      intro i
      have _ := hOpen_ji i
      exact hOpensRangePb (hPb_ji i)
    have hRange_jV : j_V.opensRange =
        (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.snd ρ_V gbar₀).base).obj
          j₀.opensRange :=
      hOpensRangePb hPb_jV

    have hPre_π_j : ∀ u : I,
        (TopologicalSpace.Opens.map (c_Xbar.π.app u).base).obj (j_i u.unop).opensRange =
          j_V.opensRange := by
      intro u
      rw [hRange_ji u.unop, hRange_jV]
      have h_snd : c_Xbar.π.app u ≫ CategoryTheory.Limits.pullback.snd (ρ u.unop) gbar₀ =
          CategoryTheory.Limits.pullback.snd ρ_V gbar₀ := by
        dsimp [c_Xbar, CategoryTheory.Over.pullback, c_Over]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      ext x
      change (c_Xbar.π.app u ≫ CategoryTheory.Limits.pullback.snd (ρ u.unop) gbar₀).base x ∈
        j₀.opensRange ↔ _
      rw [h_snd]
      rfl

    have hPre_map_j : ∀ {u₁ u₂ : I} (f : u₁ ⟶ u₂),
        (TopologicalSpace.Opens.map (D_Xbar.map f).base).obj (j_i u₂.unop).opensRange =
          (j_i u₁.unop).opensRange := by
      intro u₁ u₂ f
      rw [hRange_ji u₂.unop, hRange_ji u₁.unop]
      have h_snd : D_Xbar.map f ≫ CategoryTheory.Limits.pullback.snd (ρ u₂.unop) gbar₀ =
          CategoryTheory.Limits.pullback.snd (ρ u₁.unop) gbar₀ := by
        dsimp [D_Xbar, CategoryTheory.Over.pullback, D_Over]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      ext x
      change (D_Xbar.map f ≫ CategoryTheory.Limits.pullback.snd (ρ u₂.unop) gbar₀).base x ∈
        j₀.opensRange ↔ _
      rw [h_snd]
      rfl

    have hRoof_V : j_V ≫ gbar_V = π_V ≫ g_V :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hProp_compV : AlgebraicGeometry.IsProper (j_V ≫ gbar_V) := by
      rw [hRoof_V]
      infer_instance
    have hProp_jV : AlgebraicGeometry.IsProper j_V :=
      @AlgebraicGeometry.IsProper.of_comp _ _ _ j_V gbar_V hProp_compV inferInstance

    have hComp_XbarV : CompactSpace ↥c_Xbar.pt :=
      @AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace _ _ gbar_V inferInstance inferInstance
    have hClosed_range_jV : IsClosed (Set.range j_V.base) :=
      j_V.isClosedMap.isClosed_range
    let U_compV : c_Xbar.pt.Opens := ⟨(Set.range j_V.base)ᶜ, hClosed_range_jV.isOpen_compl⟩
    have hClosed_UcompV : IsClosed (U_compV : Set ↥c_Xbar.pt) := by
      change IsClosed ((j_V.opensRange : Set ↥c_Xbar.pt)ᶜ)
      exact j_V.opensRange.isOpen.isClosed_compl
    have hComp_UcompV : IsCompact (U_compV : Set ↥c_Xbar.pt) := hClosed_UcompV.isCompact

    obtain ⟨u₁, V₁, hComp_V₁, hPre_V₁⟩ :=
      @AlgebraicGeometry.exists_preimage_eq I _ D_Xbar c_Xbar hc_Xbar _ @hAff_map U_compV hComp_UcompV

    have hSup_u₁ :
        (TopologicalSpace.Opens.map (c_Xbar.π.app u₁).base).obj ((j_i u₁.unop).opensRange ⊔ V₁) = ⊤ := by
      change ((TopologicalSpace.Opens.map (c_Xbar.π.app u₁).base).obj (j_i u₁.unop).opensRange ⊔
        (TopologicalSpace.Opens.map (c_Xbar.π.app u₁).base).obj V₁ : c_Xbar.pt.Opens) = ⊤
      rw [hPre_π_j u₁, hPre_V₁]
      apply TopologicalSpace.Opens.ext
      ext x
      exact ⟨fun _ => trivial, fun _ => Classical.em (x ∈ Set.range j_V.base)⟩

    obtain ⟨u₂, f₂₁, hTop_u₂⟩ :=
      @AlgebraicGeometry.exists_map_eq_top I _ D_Xbar c_Xbar hc_Xbar _ @hAff_map hComp_Xbar u₁
        ((j_i u₁.unop).opensRange ⊔ V₁) hSup_u₁

    let V₂ : (D_Xbar.obj u₂).Opens := (TopologicalSpace.Opens.map (D_Xbar.map f₂₁).base).obj V₁
    have hSup_u₂ : (j_i u₂.unop).opensRange ⊔ V₂ = ⊤ := by
      rw [← hPre_map_j f₂₁]
      exact hTop_u₂
    have hPre_V₂ : (TopologicalSpace.Opens.map (c_Xbar.π.app u₂).base).obj V₂ = U_compV := by
      rw [← hPre_V₁]
      apply TopologicalSpace.Opens.ext
      ext x
      change (D_Xbar.map f₂₁).base ((c_Xbar.π.app u₂).base x) ∈ V₁ ↔
        (c_Xbar.π.app u₁).base x ∈ V₁
      have h_nat := c_Xbar.π.naturality f₂₁
      dsimp at h_nat
      rw [CategoryTheory.Category.id_comp] at h_nat
      change (c_Xbar.π.app u₂ ≫ D_Xbar.map f₂₁).base x ∈ V₁ ↔ _
      rw [h_nat]
    have hQC_f₂₁ : AlgebraicGeometry.QuasiCompact (D_Xbar.map f₂₁) := by
      have _ := hAff_map f₂₁
      infer_instance
    have hComp_V₂ : IsCompact (V₂ : Set ↥(D_Xbar.obj u₂)) :=
      @AlgebraicGeometry.QuasiCompact.isCompact_preimage _ _ (D_Xbar.map f₂₁) hQC_f₂₁
        (V₁ : Set ↥(D_Xbar.obj u₁)) V₁.isOpen hComp_V₁

    have hComp_j_u₂ : IsCompact ((j_i u₂.unop).opensRange : Set ↥(D_Xbar.obj u₂)) := by
      have _ := hComp_X'i u₂.unop
      exact isCompact_range (j_i u₂.unop).base.hom.continuous
    have hComp_inter_u₂ : IsCompact (((j_i u₂.unop).opensRange ⊓ V₂ : (D_Xbar.obj u₂).Opens) :
        Set ↥(D_Xbar.obj u₂)) := by
      have _ := hQS_Xbar u₂
      exact @IsCompact.inter_of_isOpen _ _ _
        ((j_i u₂.unop).opensRange : Set ↥(D_Xbar.obj u₂)) (V₂ : Set ↥(D_Xbar.obj u₂))
        hComp_j_u₂ hComp_V₂ (j_i u₂.unop).opensRange.isOpen V₂.isOpen
    have hComp_bot_u₂ : IsCompact ((⊥ : (D_Xbar.obj u₂).Opens) : Set ↥(D_Xbar.obj u₂)) :=
      isCompact_empty
    have hPre_inter_u₂ :
        (TopologicalSpace.Opens.map (c_Xbar.π.app u₂).base).obj ((j_i u₂.unop).opensRange ⊓ V₂) =
        (TopologicalSpace.Opens.map (c_Xbar.π.app u₂).base).obj ⊥ := by
      change ((TopologicalSpace.Opens.map (c_Xbar.π.app u₂).base).obj (j_i u₂.unop).opensRange ⊓
        (TopologicalSpace.Opens.map (c_Xbar.π.app u₂).base).obj V₂ : c_Xbar.pt.Opens) = ⊥
      rw [hPre_π_j u₂, hPre_V₂]
      apply TopologicalSpace.Opens.ext
      ext x
      exact ⟨fun ⟨h1, h2⟩ => h2 h1, False.elim⟩

    obtain ⟨u₃, f₃₂, hBot_u₃⟩ :=
      @AlgebraicGeometry.exists_map_preimage_eq_map_preimage I _ D_Xbar c_Xbar hc_Xbar _ @hAff_map u₂
        ((j_i u₂.unop).opensRange ⊓ V₂) ⊥ hComp_inter_u₂ hComp_bot_u₂ hPre_inter_u₂

    let i₃ : J := u₃.unop
    let V₃ : (D_Xbar.obj u₃).Opens := (TopologicalSpace.Opens.map (D_Xbar.map f₃₂).base).obj V₂
    have hSup_u₃ : (j_i i₃).opensRange ⊔ V₃ = ⊤ := by
      have h1 : (TopologicalSpace.Opens.map (D_Xbar.map f₃₂).base).obj
          ((j_i u₂.unop).opensRange ⊔ V₂) = ⊤ := by
        rw [hSup_u₂]
        rfl
      rw [← hPre_map_j f₃₂]
      exact h1
    have hInf_u₃ : (j_i i₃).opensRange ⊓ V₃ = ⊥ := by
      rw [← hPre_map_j f₃₂]
      exact hBot_u₃

    have hRange_eq_compl : Set.range (j_i i₃).base = (V₃ : Set ↥(D_Xbar.obj u₃))ᶜ := by
      ext x
      have h_univ : x ∈ ((j_i i₃).opensRange ⊔ V₃ : (D_Xbar.obj u₃).Opens) := by
        rw [hSup_u₃]; trivial
      have h_emp : x ∉ ((j_i i₃).opensRange ⊓ V₃ : (D_Xbar.obj u₃).Opens) := by
        rw [hInf_u₃]; exact False.elim
      change x ∈ Set.range (j_i i₃).base ∪ (V₃ : Set ↥(D_Xbar.obj u₃)) at h_univ
      change ¬ (x ∈ Set.range (j_i i₃).base ∧ x ∈ (V₃ : Set ↥(D_Xbar.obj u₃))) at h_emp
      rw [Set.mem_union] at h_univ
      rw [Set.mem_compl_iff]
      exact ⟨fun hx hV => h_emp ⟨hx, hV⟩, fun hnV => h_univ.resolve_right hnV⟩

    have hClosed_ji₃ : IsClosed (Set.range (j_i i₃).base) := by
      rw [hRange_eq_compl]
      exact V₃.isOpen.isClosed_compl
    have _ := hOpen_ji i₃
    have hClImm_ji₃ : AlgebraicGeometry.IsClosedImmersion (j_i i₃) :=
      AlgebraicGeometry.IsClosedImmersion.of_isPreimmersion (j_i i₃) hClosed_ji₃
    have _ := hProp_gbar_u u₃
    have hProp_comp_i₃ : AlgebraicGeometry.IsProper (π_i i₃ ≫ g_i i₃) := by
      rw [hRoof_i i₃]
      infer_instance
    have _ := hSurj_πi i₃
    have hUC_gi₃ : AlgebraicGeometry.UniversallyClosed (g_i i₃) :=
      @AlgebraicGeometry.UniversallyClosed.of_comp_surjective _ _ _ (π_i i₃) (g_i i₃)
        inferInstance ‹AlgebraicGeometry.Surjective (π_i i₃)›
    have hSep_gi₃ : AlgebraicGeometry.IsSeparated (g_i i₃) := inferInstance
    have hLFT_gi₃ : AlgebraicGeometry.LocallyOfFiniteType (g_i i₃) := inferInstance
    exact ⟨i₃, @AlgebraicGeometry.IsProper.mk _ _ (g_i i₃) hSep_gi₃ hUC_gi₃ hLFT_gi₃⟩

  let R₂ := ↥(Algebra.adjoin k (↑F₂ : Set K))
  have hLFT₂ : AlgebraicGeometry.LocallyOfFiniteType g₂ := inferInstance
  obtain ⟨hSepC₂, r, hr, U, hCovU, hAffU, _hNonU, n, f, hGen, U₀, hU₀_le, hU₀, hAffU₀⟩ :=
    hStep1 R₂ C₂ hIntC₂ g₂ hQC₂ hSep₂ hLFT₂
  obtain ⟨P, p_P, N, Φ, D, z, IsZeroAt, hPropP, hΦ, hCovD, hAffD, hz_basic, hShift, hRecov⟩ :=
    hStep2 R₂ C₂ g₂ r hr U n f U₀ hU₀_le f
  obtain ⟨X'₂, Xbar₂, π₂, j₂, gbar₂, hProp_π₂, hSurj_π₂, hOpen_j₂, hProp_gbar₂, hRoof_comm₂⟩ :=
    hStep3 R₂ C₂ hIntC₂ hSepC₂ g₂ hQC₂ hSep₂ r U hCovU hAffU n f hGen U₀ hU₀_le hU₀ hAffU₀
      P p_P hPropP N Φ D z IsZeroAt hΦ hCovD hAffD hz_basic hShift hRecov
  obtain ⟨J, instCatJ, instFiltJ, R_diag, α_diag, ι_colim, hColim, hα_comp, hExtract⟩ := hStep4
  let _ : CategoryTheory.SmallCategory J := instCatJ
  let _ : CategoryTheory.IsFiltered J := instFiltJ
  obtain ⟨i₃, hProp_i₃⟩ :=
    @hStep5 (CommRingCat.of R₂) (CommRingCat.of ↥V) (CommRingCat.ofHom ι₂_FV)
      J instCatJ instFiltJ R_diag α_diag ι_colim hColim hα_comp
      C₂ g₂ hQC₂ hSep₂ hLFT₂ X'₂ Xbar₂ π₂ j₂ gbar₂
      hProp_π₂ hSurj_π₂ hOpen_j₂ hProp_gbar₂ hRoof_comm₂
      C_V g_V hPropV ι₂_V hPb₂
  obtain ⟨F₃, hSub₂₃, e_ring, hF₃, he_ring⟩ := hExtract i₃

  let ρ₂₃ : AlgebraicGeometry.Spec (CommRingCat.of ↥(Algebra.adjoin k (↑F₃ : Set K))) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥(Algebra.adjoin k (↑F₂ : Set K))) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub₂₃))).toRingHom)
  let ρ_α := AlgebraicGeometry.Spec.map (α_diag.app i₃)
  let φ_hom := AlgebraicGeometry.Spec.map e_ring.hom
  let φ_inv := AlgebraicGeometry.Spec.map e_ring.inv
  have hφ_hom_inv : φ_hom ≫ φ_inv = 𝟙 _ := by
    rw [← AlgebraicGeometry.Spec.map_comp, e_ring.inv_hom_id, AlgebraicGeometry.Spec.map_id]
  have hφ_inv_hom : φ_inv ≫ φ_hom = 𝟙 _ := by
    rw [← AlgebraicGeometry.Spec.map_comp, e_ring.hom_inv_id, AlgebraicGeometry.Spec.map_id]
  have _ : CategoryTheory.IsIso φ_hom := ⟨⟨φ_inv, hφ_hom_inv, hφ_inv_hom⟩⟩
  have hρ_α_eq : ρ_α = φ_hom ≫ ρ₂₃ := by
    dsimp only [ρ_α, φ_hom, ρ₂₃]
    rw [← he_ring, AlgebraicGeometry.Spec.map_comp]

  let ψ_top : CategoryTheory.Limits.pullback g₂ ρ₂₃ ⟶
      CategoryTheory.Limits.pullback g₂ ρ_α :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst g₂ ρ₂₃)
      (CategoryTheory.Limits.pullback.snd g₂ ρ₂₃ ≫ φ_inv)
      (by
        rw [CategoryTheory.Category.assoc, hρ_α_eq, ← CategoryTheory.Category.assoc φ_inv,
          hφ_inv_hom, CategoryTheory.Category.id_comp, CategoryTheory.Limits.pullback.condition])
  let ψ_inv : CategoryTheory.Limits.pullback g₂ ρ_α ⟶
      CategoryTheory.Limits.pullback g₂ ρ₂₃ :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst g₂ ρ_α)
      (CategoryTheory.Limits.pullback.snd g₂ ρ_α ≫ φ_hom)
      (by
        rw [CategoryTheory.Category.assoc, ← hρ_α_eq, CategoryTheory.Limits.pullback.condition])
  have hψ_top_inv : ψ_top ≫ ψ_inv = 𝟙 _ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Category.assoc, hφ_inv_hom, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]
  have hψ_inv_top : ψ_inv ≫ ψ_top = 𝟙 _ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Category.assoc, hφ_hom_inv, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]
  have _ : CategoryTheory.IsIso ψ_top := ⟨⟨ψ_inv, hψ_top_inv, hψ_inv_top⟩⟩
  have hsnd_eq : CategoryTheory.Limits.pullback.snd g₂ ρ₂₃ =
      ψ_top ≫ CategoryTheory.Limits.pullback.snd g₂ ρ_α ≫ φ_hom := by
    rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
      CategoryTheory.Category.assoc, hφ_inv_hom, CategoryTheory.Category.comp_id]
  have hProp_target : AlgebraicGeometry.IsProper (CategoryTheory.Limits.pullback.snd g₂ ρ₂₃) := by
    rw [hsnd_eq]
    infer_instance
  exact ⟨F₃, hSub₂₃, hF₃, hProp_target⟩

theorem weil_algClosed_smoothOrNodal_imp_isReduced_and_artin (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (Y : AlgebraicGeometry.Scheme.{u})
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    [AlgebraicGeometry.LocallyOfFiniteType p_Y] :
    (∀ y : Y, HasSpreadSmoothOrNodalAt p_Y y) →
    AlgebraicGeometry.IsReduced Y ∧
    ∀ (D : Type u) [CommRing D] [Algebra Ω D]
      (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y),
      AlgebraicGeometry.IsOpenImmersion j_D →
      j_D ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
      ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
        let L := Localization.AtPrime q.asIdeal
        let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
        Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
          (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
           Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
           ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3) :=
by
  
  have hS1 :
      (∀ (S : Type u) [CommRing S] (g : MvPolynomial (Fin 1) Ω →+* S), g.Etale → _root_.IsReduced S) ∧
      (∀ (S : Type u) [CommRing S]
        (g : (MvPolynomial (Fin 2) Ω ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))) →+* S),
        g.Etale → _root_.IsReduced S) := by
    have hNilZero : ∀ {R S K : Type u} [CommRing R] [CommRing S] [Algebra R S] [Algebra.Etale R S]
        [Field K] [Algebra R K] (s : S), IsNilpotent s →
        (s ⊗ₜ[R] (1 : K) : TensorProduct R S K) = 0 := by
      intro R S K _ _ _ _ _ _ s hs
      have hRed : _root_.IsReduced (TensorProduct R K S) :=
        Algebra.FormallyUnramified.isReduced_of_field K (TensorProduct R K S)
      have hNil : IsNilpotent ((Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R K S) s) :=
        hs.map (Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R K S).toRingHom
      have hZero : ((1 : K) ⊗ₜ[R] s : TensorProduct R K S) = 0 := hRed.eq_zero _ hNil
      have hComm := congrArg (TensorProduct.comm R K S) hZero
      simpa using hComm
    constructor
    · intro S _ g hg
      letI : Algebra (MvPolynomial (Fin 1) Ω) S := g.toAlgebra
      haveI : Algebra.Etale (MvPolynomial (Fin 1) Ω) S := hg
      let K₁ := FractionRing (MvPolynomial (Fin 1) Ω)
      let lam₁ : MvPolynomial (Fin 1) Ω →ₗ[MvPolynomial (Fin 1) Ω] K₁ :=
        Algebra.linearMap (MvPolynomial (Fin 1) Ω) K₁
      have hInj₁ : Function.Injective lam₁ :=
        IsFractionRing.injective (MvPolynomial (Fin 1) Ω) K₁
      have hInjT : Function.Injective (LinearMap.lTensor S lam₁) :=
        Module.Flat.lTensor_preserves_injective_linearMap lam₁ hInj₁
      refine ⟨fun s hs => ?_⟩
      apply (TensorProduct.rid (MvPolynomial (Fin 1) Ω) S).symm.injective
      apply hInjT
      simpa [lam₁] using hNilZero (R := MvPolynomial (Fin 1) Ω) (S := S) (K := K₁) s hs
    · intro S _ g hg
      let J_node : Ideal (MvPolynomial (Fin 2) Ω) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))
      letI : Algebra (MvPolynomial (Fin 2) Ω ⧸ J_node) S := g.toAlgebra
      haveI : Algebra.Etale (MvPolynomial (Fin 2) Ω ⧸ J_node) S := hg
      have hMonEq : ∀ (d : Fin 2 →₀ ℕ) (c : Ω),
          (MvPolynomial.monomial d c : MvPolynomial (Fin 2) Ω) =
            MvPolynomial.C c * MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1 := by
        intro d c
        rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.X_pow_eq_monomial,
          mul_assoc, MvPolynomial.monomial_mul_monomial, MvPolynomial.C_mul_monomial]
        have hd : Finsupp.single (0 : Fin 2) (d 0) + Finsupp.single (1 : Fin 2) (d 1) = d := by
          ext i; fin_cases i <;> simp
        rw [hd, mul_one, mul_one]
      let f₀ : Fin 2 → Polynomial Ω := Fin.cases Polynomial.X (fun _ => 0)
      let f₁ : Fin 2 → MvPolynomial (Fin 1) Ω := Fin.cases 0 (fun _ => MvPolynomial.X 0)
      let π₀_raw : MvPolynomial (Fin 2) Ω →ₐ[Ω] Polynomial Ω := MvPolynomial.aeval f₀
      let π₁_raw : MvPolynomial (Fin 2) Ω →ₐ[Ω] MvPolynomial (Fin 1) Ω := MvPolynomial.aeval f₁
      have hπ₀_C : ∀ c : Ω, π₀_raw (MvPolynomial.C c) = Polynomial.C c := MvPolynomial.aeval_C f₀
      have hπ₀_X0 : π₀_raw (MvPolynomial.X 0) = Polynomial.X := MvPolynomial.aeval_X f₀ 0
      have hπ₀_X1 : π₀_raw (MvPolynomial.X 1) = 0 := MvPolynomial.aeval_X f₀ 1
      have hπ₁_C : ∀ c : Ω, π₁_raw (MvPolynomial.C c) = MvPolynomial.C c := fun c => MvPolynomial.aeval_C f₁ c
      have hπ₁_X0 : π₁_raw (MvPolynomial.X 0) = 0 := MvPolynomial.aeval_X f₁ 0
      have hπ₁_X1 : π₁_raw (MvPolynomial.X 1) = MvPolynomial.X 0 := MvPolynomial.aeval_X f₁ 1
      have hJ₀ : J_node ≤ RingHom.ker π₀_raw.toRingHom := by
        rw [Ideal.span_le]
        rintro _ ⟨rfl⟩
        change π₀_raw (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
        rw [map_mul, hπ₀_X0, hπ₀_X1, mul_zero]
      have hJ₁ : J_node ≤ RingHom.ker π₁_raw.toRingHom := by
        rw [Ideal.span_le]
        rintro _ ⟨rfl⟩
        change π₁_raw (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
        rw [map_mul, hπ₁_X0, hπ₁_X1, zero_mul]
      let K₀ := FractionRing (Polynomial Ω)
      let K₁ := FractionRing (MvPolynomial (Fin 1) Ω)
      let κ₀ : (MvPolynomial (Fin 2) Ω ⧸ J_node) →+* K₀ :=
        (algebraMap (Polynomial Ω) K₀).comp (Ideal.Quotient.lift J_node π₀_raw.toRingHom hJ₀)
      let κ₁ : (MvPolynomial (Fin 2) Ω ⧸ J_node) →+* K₁ :=
        (algebraMap (MvPolynomial (Fin 1) Ω) K₁).comp (Ideal.Quotient.lift J_node π₁_raw.toRingHom hJ₁)
      have hKerInter : ∀ r : MvPolynomial (Fin 2) Ω ⧸ J_node, κ₀ r = 0 → κ₁ r = 0 → r = 0 := by
        intro r hr₀ hr₁
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective r
        have hF₀ : π₀_raw F = 0 :=
          (IsFractionRing.injective (Polynomial Ω) K₀)
            (hr₀.trans (map_zero (algebraMap (Polynomial Ω) K₀)).symm)
        have hF₁ : π₁_raw F = 0 :=
          (IsFractionRing.injective (MvPolynomial (Fin 1) Ω) K₁)
            (hr₁.trans (map_zero (algebraMap (MvPolynomial (Fin 1) Ω) K₁)).symm)
        have hCoeff₀ : ∀ a : ℕ, F.coeff (Finsupp.single 0 a) = 0 := by
          intro a
          have hsum := congrArg (fun p : Polynomial Ω => p.coeff a)
            (congrArg π₀_raw (MvPolynomial.as_sum F))
          rw [hF₀, Polynomial.coeff_zero, map_sum, Polynomial.finsetSum_coeff] at hsum
          have hterm : ∀ d ∈ F.support,
              (π₀_raw (MvPolynomial.monomial d (F.coeff d))).coeff a =
                if d = Finsupp.single 0 a then F.coeff d else 0 := by
            intro d _
            rw [hMonEq d (F.coeff d), map_mul, map_mul, map_pow, map_pow, hπ₀_C, hπ₀_X0, hπ₀_X1]
            by_cases hd1 : d 1 = 0
            · rw [hd1, pow_zero, mul_one, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
              by_cases hd0 : a = d 0
              · have hdeq : d = Finsupp.single 0 a := by
                  ext i; fin_cases i <;> simp [hd0, hd1]
                simp [hdeq]
              · have hdne : d ≠ Finsupp.single 0 a := by
                  intro h; apply hd0; rw [h]; simp
                simp [hd0, hdne]
            · have hdne : d ≠ Finsupp.single 0 a := by
                intro h; apply hd1; rw [h]; simp
              rw [zero_pow hd1, mul_zero, Polynomial.coeff_zero]
              simp [hdne]
          rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq'] at hsum
          by_cases hmem : Finsupp.single 0 a ∈ F.support
          · simpa [hmem] using hsum.symm
          · exact MvPolynomial.notMem_support_iff.mp hmem
        have hCoeff₁ : ∀ b : ℕ, F.coeff (Finsupp.single 1 b) = 0 := by
          intro b
          have hsum := congrArg (fun p : MvPolynomial (Fin 1) Ω => p.coeff (Finsupp.single 0 b))
            (congrArg π₁_raw (MvPolynomial.as_sum F))
          rw [hF₁, map_sum, MvPolynomial.coeff_sum] at hsum
          change 0 = ∑ x ∈ F.support, (π₁_raw (MvPolynomial.monomial x (F.coeff x))).coeff (Finsupp.single 0 b) at hsum
          have hterm : ∀ d ∈ F.support,
              (π₁_raw (MvPolynomial.monomial d (F.coeff d))).coeff (Finsupp.single 0 b) =
                if d = Finsupp.single 1 b then F.coeff d else 0 := by
            intro d _
            rw [hMonEq d (F.coeff d), map_mul, map_mul, map_pow, map_pow, hπ₁_C, hπ₁_X0, hπ₁_X1]
            by_cases hd0 : d 0 = 0
            · rw [hd0, pow_zero, mul_one, MvPolynomial.X_pow_eq_monomial, MvPolynomial.C_mul_monomial,
                MvPolynomial.coeff_monomial]
              by_cases hd1 : d 1 = b
              · have hdeq : d = Finsupp.single 1 b := by
                  ext i; fin_cases i <;> simp [hd0, hd1]
                simp [hdeq]
              · have hdne : d ≠ Finsupp.single 1 b := by
                  intro h; apply hd1; rw [h]; simp
                have hsne : Finsupp.single (0 : Fin 1) (d 1) ≠ Finsupp.single 0 b := by
                  intro h; apply hd1; exact (Finsupp.single_injective 0) h
                simp [hsne, hdne]
            · have hdne : d ≠ Finsupp.single 1 b := by
                intro h; apply hd0; rw [h]; simp
              rw [zero_pow hd0, mul_zero, zero_mul]
              simp [hdne]
          rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq'] at hsum
          by_cases hmem : Finsupp.single 1 b ∈ F.support
          · simpa [hmem] using hsum.symm
          · exact MvPolynomial.notMem_support_iff.mp hmem
        rw [Ideal.Quotient.eq_zero_iff_mem, MvPolynomial.as_sum F]
        refine Ideal.sum_mem J_node fun d hd => ?_
        have hd_ne : F.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
        have hd0 : 1 ≤ d 0 := by
          by_contra h0
          have h0' : d 0 = 0 := by omega
          have hdeq : d = Finsupp.single 1 (d 1) := by
            ext i; fin_cases i <;> simp [h0']
          exact hd_ne (hdeq ▸ hCoeff₁ (d 1))
        have hd1 : 1 ≤ d 1 := by
          by_contra h1
          have h1' : d 1 = 0 := by omega
          have hdeq : d = Finsupp.single 0 (d 0) := by
            ext i; fin_cases i <;> simp [h1']
          exact hd_ne (hdeq ▸ hCoeff₀ (d 0))
        rw [hMonEq d (F.coeff d)]
        have heq0 : d 0 = (d 0 - 1) + 1 := by omega
        have heq1 : d 1 = (d 1 - 1) + 1 := by omega
        rw [heq0, heq1, pow_succ, pow_succ]
        have hfac : MvPolynomial.C (F.coeff d) *
              ((MvPolynomial.X 0 : MvPolynomial (Fin 2) Ω) ^ (d 0 - 1) * MvPolynomial.X 0) *
              ((MvPolynomial.X 1 : MvPolynomial (Fin 2) Ω) ^ (d 1 - 1) * MvPolynomial.X 1) =
            (MvPolynomial.C (F.coeff d) * MvPolynomial.X 0 ^ (d 0 - 1) * MvPolynomial.X 1 ^ (d 1 - 1)) *
              (MvPolynomial.X 0 * MvPolynomial.X 1) := by ring
        rw [hfac]
        exact Ideal.mul_mem_left J_node _ (Ideal.subset_span rfl)
      let R_node := MvPolynomial (Fin 2) Ω ⧸ J_node
      letI : Algebra R_node K₀ := κ₀.toAlgebra
      letI : Algebra R_node K₁ := κ₁.toAlgebra
      let lam_node : R_node →ₗ[R_node] K₀ × K₁ :=
        LinearMap.prod (Algebra.linearMap R_node K₀) (Algebra.linearMap R_node K₁)
      have hInjNode : Function.Injective lam_node := by
        intro r₁ r₂ hEq
        have h0 : κ₀ (r₁ - r₂) = 0 := by
          rw [map_sub]
          exact sub_eq_zero.mpr (congrArg Prod.fst hEq)
        have h1 : κ₁ (r₁ - r₂) = 0 := by
          rw [map_sub]
          exact sub_eq_zero.mpr (congrArg Prod.snd hEq)
        exact sub_eq_zero.mp (hKerInter (r₁ - r₂) h0 h1)
      have hInjLT : Function.Injective (LinearMap.lTensor S lam_node) :=
        Module.Flat.lTensor_preserves_injective_linearMap lam_node hInjNode
      refine ⟨fun s hs => ?_⟩
      apply (TensorProduct.rid R_node S).symm.injective
      apply hInjLT
      apply (TensorProduct.prodRight R_node R_node S K₀ K₁).injective
      apply Prod.ext
      · simpa [lam_node] using hNilZero (R := R_node) (S := S) (K := K₀) s hs
      · simpa [lam_node] using hNilZero (R := R_node) (S := S) (K := K₁) s hs

  
  have hS2 : ∀ (D : Type u) [CommRing D] [Algebra Ω D] [Algebra.FiniteType Ω D]
      (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
      ∀ (S : Type u) [CommRing S] (q_S : PrimeSpectrum S) (φ_D : D →+* S)
        (M : Type u) [CommRing M] [Algebra Ω M] (φ_M : M →+* S),
        φ_D.Etale → φ_M.Etale →
        PrimeSpectrum.comap φ_D q_S = q →
        φ_D.comp (algebraMap Ω D) = φ_M.comp (algebraMap Ω M) →
        let L := Localization.AtPrime q.asIdeal
        let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
        let p_M : PrimeSpectrum M := PrimeSpectrum.comap φ_M q_S
        (p_M.asIdeal.IsMaximal ∧ Function.Bijective (algebraMap Ω (M ⧸ p_M.asIdeal))) ∧
        (∀ k : ℕ, 1 ≤ k →
          ∃ Θ : (M ⧸ p_M.asIdeal ^ k) ≃ₐ[Ω] (L ⧸ 𝔪 ^ k),
            Ideal.map Θ.toRingHom (Ideal.map (Ideal.Quotient.mk (p_M.asIdeal ^ k)) p_M.asIdeal) =
              Ideal.map (Ideal.Quotient.mk (𝔪 ^ k)) 𝔪) := by
    intro D _ _ _ q hq S _ q_S φ_D M _ _ φ_M hEtD hEtM hComapD hComm L 𝔪 p_M
    letI : Field (D ⧸ q.asIdeal) := Ideal.Quotient.field q.asIdeal
    have hBij_Dq : Function.Bijective (algebraMap Ω (D ⧸ q.asIdeal)) := by
      obtain ⟨F_D, hF_D⟩ := ‹Algebra.FiniteType Ω D›.out
      let π_D : MvPolynomial ↥F_D Ω →ₐ[Ω] D := MvPolynomial.aeval (fun x : ↥F_D => (x : D))
      have hSurj_π : Function.Surjective π_D := by
        rw [← AlgHom.range_eq_top, MvPolynomial.aeval_range]
        have hRange : Set.range (fun x : ↥F_D => (x : D)) = (↑F_D : Set D) := Subtype.range_coe
        rw [hRange, hF_D]
      let M_id : Ideal (MvPolynomial ↥F_D Ω) := Ideal.comap π_D.toRingHom q.asIdeal
      let qMap : MvPolynomial ↥F_D Ω ⧸ M_id →+* D ⧸ q.asIdeal :=
        Ideal.Quotient.lift M_id ((Ideal.Quotient.mk q.asIdeal).comp π_D.toRingHom)
          (fun _ hx => Ideal.Quotient.eq_zero_iff_mem.mpr hx)
      have hBij_qMap : Function.Bijective qMap := by
        refine ⟨?_, ?_⟩
        · intro a b hab
          obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective a
          obtain ⟨Q, rfl⟩ := Ideal.Quotient.mk_surjective b
          rw [Ideal.Quotient.eq]
          change π_D (P - Q) ∈ q.asIdeal
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_sub, sub_eq_zero]
          exact hab
        · intro y
          obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective y
          obtain ⟨P, rfl⟩ := hSurj_π d
          exact ⟨Ideal.Quotient.mk M_id P, rfl⟩
      have hMax_M : M_id.IsMaximal := by
        rw [Ideal.Quotient.maximal_ideal_iff_isField_quotient]
        exact (RingEquiv.ofBijective qMap hBij_qMap).toMulEquiv.isField (Field.toIsField (D ⧸ q.asIdeal))
      obtain ⟨x₀, hx₀⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := M_id)).mp hMax_M
      refine ⟨(algebraMap Ω (D ⧸ q.asIdeal)).injective, fun y => ?_⟩
      obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨P, rfl⟩ := hSurj_π d
      refine ⟨MvPolynomial.eval x₀ P, ?_⟩
      have hMemV : P - MvPolynomial.C (MvPolynomial.eval x₀ P) ∈ M_id := by
        rw [hx₀]
        intro pt hpt
        rw [Set.mem_singleton_iff.mp hpt]
        simp
      have hMemQ : π_D (P - MvPolynomial.C (MvPolynomial.eval x₀ P)) ∈ q.asIdeal := hMemV
      rw [map_sub, MvPolynomial.aeval_C] at hMemQ
      exact (Ideal.Quotient.eq.mpr hMemQ).symm
    have hBij_Lm : Function.Bijective (algebraMap Ω (L ⧸ 𝔪)) := by
      letI : Field (L ⧸ 𝔪) := Ideal.Quotient.field 𝔪
      refine ⟨(algebraMap Ω (L ⧸ 𝔪)).injective, fun z => ?_⟩
      obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨⟨d, ⟨s, hs⟩⟩, rfl⟩ := IsLocalization.mk'_surjective q.asIdeal.primeCompl w
      have hs_ne : Ideal.Quotient.mk q.asIdeal s ≠ 0 := by
        intro h0
        exact hs (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (Ideal.Quotient.mk q.asIdeal s)⁻¹
      have hst : 1 - s * t ∈ q.asIdeal := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, map_mul, ht,
          mul_inv_cancel₀ hs_ne, sub_self]
      obtain ⟨c, hc⟩ := hBij_Dq.2 (Ideal.Quotient.mk q.asIdeal (d * t))
      have hdt : d * t - algebraMap Ω D c ∈ q.asIdeal := Ideal.Quotient.eq.mp hc.symm
      refine ⟨c, ?_⟩
      change Ideal.Quotient.mk 𝔪 (algebraMap D L (algebraMap Ω D c)) =
        Ideal.Quotient.mk 𝔪 (IsLocalization.mk' L d ⟨s, hs⟩)
      rw [Ideal.Quotient.eq]
      have hDiff : algebraMap D L (algebraMap Ω D c) - IsLocalization.mk' L d ⟨s, hs⟩ =
          algebraMap D L (algebraMap Ω D c - d * t) -
            IsLocalization.mk' L d ⟨s, hs⟩ * algebraMap D L (1 - s * t) := by
        apply (IsLocalization.map_units L ⟨s, hs⟩).mul_left_inj.mp
        have hspec : IsLocalization.mk' L d ⟨s, hs⟩ * algebraMap D L s = algebraMap D L d :=
          IsLocalization.mk'_spec L d ⟨s, hs⟩
        calc
          (algebraMap D L (algebraMap Ω D c) - IsLocalization.mk' L d ⟨s, hs⟩) * algebraMap D L s
            = algebraMap D L (algebraMap Ω D c) * algebraMap D L s -
                IsLocalization.mk' L d ⟨s, hs⟩ * algebraMap D L s := by ring
          _ = algebraMap D L (algebraMap Ω D c) * algebraMap D L s - algebraMap D L d := by
                rw [hspec]
          _ = (algebraMap D L (algebraMap Ω D c) - algebraMap D L d * algebraMap D L t) *
                algebraMap D L s -
              algebraMap D L d * (1 - algebraMap D L s * algebraMap D L t) := by ring
          _ = algebraMap D L (algebraMap Ω D c - d * t) * algebraMap D L s -
              (IsLocalization.mk' L d ⟨s, hs⟩ * algebraMap D L s) *
                algebraMap D L (1 - s * t) := by
                rw [hspec]; simp only [map_sub, map_one, map_mul]
          _ = (algebraMap D L (algebraMap Ω D c - d * t) -
                IsLocalization.mk' L d ⟨s, hs⟩ * algebraMap D L (1 - s * t)) *
                algebraMap D L s := by ring
      rw [hDiff]
      refine Ideal.sub_mem 𝔪 ?_ ?_
      · have hmap : Ideal.map (algebraMap D L) q.asIdeal = 𝔪 :=
          Localization.AtPrime.map_eq_maximalIdeal
        rw [← hmap]
        refine Ideal.mem_map_of_mem _ ?_
        have hneg := q.asIdeal.neg_mem hdt
        simpa [neg_sub] using hneg
      · refine Ideal.mul_mem_left 𝔪 _ ?_
        have hmap : Ideal.map (algebraMap D L) q.asIdeal = 𝔪 :=
          Localization.AtPrime.map_eq_maximalIdeal
        rw [← hmap]
        exact Ideal.mem_map_of_mem _ hst
    letI : Algebra D S := φ_D.toAlgebra
    haveI : Algebra.Etale D S := hEtD
    letI : Algebra Ω S := (φ_D.comp (algebraMap Ω D)).toAlgebra
    haveI : IsScalarTower Ω D S := IsScalarTower.of_algebraMap_eq' rfl
    letI : Algebra M S := φ_M.toAlgebra
    haveI : Algebra.Etale M S := hEtM
    haveI : IsScalarTower Ω M S := IsScalarTower.of_algebraMap_eq' hComm
    have hq_eq : Ideal.comap φ_D q_S.asIdeal = q.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hComapD
    have hBij_Sq : Function.Bijective (algebraMap Ω (S ⧸ q_S.asIdeal)) := by
      let K_q := D ⧸ q.asIdeal
      haveI : IsAlgClosed K_q :=
        IsAlgClosed.of_ringEquiv Ω K_q (RingEquiv.ofBijective (algebraMap Ω K_q) hBij_Dq)
      let T_q := TensorProduct D K_q S
      haveI : Algebra.Etale K_q T_q := inferInstance
      let α_D : K_q →ₐ[D] S ⧸ q_S.asIdeal :=
        Ideal.Quotient.liftₐ q.asIdeal (Algebra.ofId D (S ⧸ q_S.asIdeal))
          (fun d hd => by
            rw [← hq_eq] at hd
            exact Ideal.Quotient.eq_zero_iff_mem.mpr hd)
      let α_S : S →ₐ[D] S ⧸ q_S.asIdeal := Ideal.Quotient.mkₐ D q_S.asIdeal
      let π_T : T_q →ₐ[D] S ⧸ q_S.asIdeal :=
        Algebra.TensorProduct.productMap α_D α_S
      let q_tilde : Ideal T_q := RingHom.ker π_T.toRingHom
      haveI : q_tilde.IsPrime := RingHom.ker_isPrime π_T.toRingHom
      let B_loc := Localization.AtPrime q_tilde
      haveI : Algebra.FormallyEtale T_q B_loc :=
        Algebra.FormallyEtale.of_isLocalization q_tilde.primeCompl
      haveI : Algebra.FormallyEtale K_q B_loc := Algebra.FormallyEtale.comp K_q T_q B_loc
      haveI : Algebra.EssFiniteType T_q B_loc :=
        Algebra.EssFiniteType.of_isLocalization B_loc q_tilde.primeCompl
      haveI : Algebra.EssFiniteType K_q B_loc := Algebra.EssFiniteType.comp K_q T_q B_loc
      have hBij_Bloc : Function.Bijective (algebraMap K_q B_loc) :=
        Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing K_q B_loc
      have hSurj_αD : Function.Surjective α_D := by
        intro y
        obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
        let t : T_q := (1 : K_q) ⊗ₜ[D] s
        obtain ⟨c, hc⟩ := hBij_Bloc.2 (algebraMap T_q B_loc t)
        have hZeroLoc : algebraMap T_q B_loc (t - (c ⊗ₜ[D] (1 : S))) = 0 := by
          rw [map_sub, sub_eq_zero]
          exact hc.symm
        obtain ⟨⟨u, hu⟩, hu_eq⟩ :=
          (IsLocalization.map_eq_zero_iff q_tilde.primeCompl B_loc (t - (c ⊗ₜ[D] (1 : S)))).mp hZeroLoc
        have hProdMem : u * (t - (c ⊗ₜ[D] (1 : S))) ∈ q_tilde := by
          rw [hu_eq]
          exact q_tilde.zero_mem
        have hMemQt : t - (c ⊗ₜ[D] (1 : S)) ∈ q_tilde :=
          (‹q_tilde.IsPrime›.mem_or_mem hProdMem).resolve_left hu
        have hMemQt' : π_T (t - (c ⊗ₜ[D] (1 : S))) = 0 := hMemQt
        rw [map_sub] at hMemQt'
        have hEqπ : π_T t = π_T (c ⊗ₜ[D] (1 : S)) := sub_eq_zero.mp hMemQt'
        refine ⟨c, ?_⟩
        have hLHS : π_T (c ⊗ₜ[D] (1 : S)) = α_D c := by
          change (Algebra.TensorProduct.productMap α_D α_S) (c ⊗ₜ[D] (1 : S)) = α_D c
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
        have hRHS : π_T t = Ideal.Quotient.mk q_S.asIdeal s := by
          change (Algebra.TensorProduct.productMap α_D α_S) ((1 : K_q) ⊗ₜ[D] s) = _
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
          rfl
        rw [← hLHS, ← hRHS, hEqπ]
      haveI : q_S.asIdeal.IsPrime := q_S.isPrime
      have hBij_αD : Function.Bijective α_D.toRingHom :=
        ⟨α_D.toRingHom.injective, hSurj_αD⟩
      have hCompS : α_D.toRingHom.comp (algebraMap Ω K_q) = algebraMap Ω (S ⧸ q_S.asIdeal) := by
        ext c
        exact (IsScalarTower.algebraMap_apply Ω D (S ⧸ q_S.asIdeal) c).symm
      rw [← hCompS]
      exact hBij_αD.comp hBij_Dq
    have hBij_Mp : Function.Bijective (algebraMap Ω (M ⧸ p_M.asIdeal)) := by
      let φbar_M : M ⧸ p_M.asIdeal →+* S ⧸ q_S.asIdeal :=
        Ideal.Quotient.lift p_M.asIdeal ((Ideal.Quotient.mk q_S.asIdeal).comp φ_M)
          (fun _ hm => Ideal.Quotient.eq_zero_iff_mem.mpr hm)
      have hInj_φbar : Function.Injective φbar_M := by
        intro x y hxy
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
        rw [Ideal.Quotient.eq]
        change φ_M (a - b) ∈ q_S.asIdeal
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_sub, sub_eq_zero]
        exact hxy
      have hCompM : φbar_M.comp (algebraMap Ω (M ⧸ p_M.asIdeal)) = algebraMap Ω (S ⧸ q_S.asIdeal) := by
        ext c
        exact congrArg (Ideal.Quotient.mk q_S.asIdeal) (RingHom.congr_fun hComm.symm c)
