                  exact Ideal.mul_mem_mul (Ideal.subset_span (by simp)) (Ideal.subset_span (by simp))
            · by_cases hd1 : d 1 = 0
              · by_cases hd0_1 : d 0 = 1
                · have hdeq : d = d10 := by ext i; fin_cases i <;> simp [hd0_1, hd1, d10]
                  have hne0 : d10 ≠ d00 := by intro h; have := congrArg (· 0) h; simp [d10, d00] at this
                  have hne2 : d10 ≠ d01 := by intro h; have := congrArg (· 0) h; simp [d10, d01] at this
                  subst hdeq
                  simp [Φ₃_P, MvPolynomial.lcoeff_apply, MvPolynomial.coeff_monomial, hne0, hne2]
                · have hd0_ge2 : 2 ≤ d 0 := by omega
                  have hne0 : d ≠ d00 := by intro h; apply hd0; rw [h]; simp [d00]
                  have hne1 : d ≠ d10 := by intro h; apply hd0_1; rw [h]; simp [d10]
                  have hne2 : d ≠ d01 := by intro h; apply hd0; rw [h]; simp [d01]
                  have hΦ0 : Φ₃_P (MvPolynomial.monomial d a) = 0 := by
                    ext j; fin_cases j <;> simp [Φ₃_P, MvPolynomial.lcoeff_apply,
                      MvPolynomial.coeff_monomial, hne0, hne1, hne2]
                  rw [← hΨ₃_apply, hΦ0, map_zero]
                  symm
                  rw [Ideal.Quotient.eq_zero_iff_mem, ← Ideal.map_pow]
                  refine Ideal.mem_map_of_mem π ?_
                  rw [hMonEq₂ d a, hd1, pow_zero, mul_one]
                  have hexp : d 0 = (d 0 - 2) + 2 := by omega
                  rw [hexp, pow_add, ← mul_assoc]
