    let z_Q : D_Q := π_DQ (MvPolynomial.X ())
    let D_QZ : Type u := Localization.Away z_Q
    let ι_DQ_DQZ := @algebraMap D_Q D_QZ inferInstance inferInstance inferInstance
    let ζ : D_QZ := ι_DQ_DQZ z_Q
    obtain ⟨ζ_u, hζ_u⟩ := IsLocalization.Away.algebraMap_isUnit (S := D_QZ) z_Q
    let ι_DZ := @algebraMap D D_QZ inferInstance inferInstance inferInstance
    let u₀_Z : D_QZ := ↑ζ_u⁻¹ * (ζ * ι_DZ d_u + (1 - ζ) * ι_DZ d_v)
    let u₁_Z : D_QZ :=
      ↑ζ_u⁻¹ * (ζ * ι_DZ a₂₀ * ι_DZ d_u + (ζ * ι_DZ a₁₁ - ι_DZ a₂₀ * (1 - ζ)) * ι_DZ d_v)
    let α₂ : P₂ →+* D_QZ :=
      MvPolynomial.eval₂Hom (ι_DZ.comp (algebraMap Ω D)) (fun i : Fin 2 => if i = 0 then u₀_Z else u₁_Z)
    let var_val : ι_var → D_QZ := fun v =>
      match v with
      | Sum.inl (Sum.inl i) => if i = 0 then ι_DZ d_u else ι_DZ d_v
      | Sum.inl (Sum.inr j) => ι_DZ (y j)
      | Sum.inr () => ζ
    let α_big : P_big →+* D_QZ := MvPolynomial.eval₂Hom α₂ var_val
    have hα_C : ∀ p : P₂, α_big (MvPolynomial.C p) = α₂ p := MvPolynomial.eval₂Hom_C α₂ var_val
    have hα_X : ∀ v : ι_var, α_big (MvPolynomial.X v) = var_val v := MvPolynomial.eval₂Hom_X' α₂ var_val
    have hα₂_C : ∀ c : Ω, α₂ (MvPolynomial.C c) = ι_DZ (algebraMap Ω D c) :=
      MvPolynomial.eval₂Hom_C _ _
    have hα₂_X : ∀ i : Fin 2, α₂ (MvPolynomial.X i) = if i = 0 then u₀_Z else u₁_Z :=
      MvPolynomial.eval₂Hom_X' _ _
    have hα_U0 : α_big U₀_b = u₀_Z := by rw [hα_C, hα₂_X]; simp
    have hα_U1 : α_big U₁_b = u₁_Z := by rw [hα_C, hα₂_X]; simp
    have hα_X0 : α_big X_b = ι_DZ d_u := by rw [hα_X]; simp [var_val]
    have hα_Y1 : α_big Y_b = ι_DZ d_v := by rw [hα_X]; simp [var_val]
    have hα_Wj : ∀ j : Fin r, α_big (W_b j) = ι_DZ (y j) := fun j => hα_X (Sum.inl (Sum.inr j))
    have hα_Z : α_big Z_b = ζ := hα_X (Sum.inr ())
    have hα_aux : ∀ F : P_aux, α_big (ι_aux F) = ι_DZ (MvPolynomial.aeval y F) := by
