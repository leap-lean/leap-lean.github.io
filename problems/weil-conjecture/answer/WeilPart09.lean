        dsimp [a₂₀, a₁₁, a₀₂]
        linear_combination inv_c * hD_cubic
      have h_rel_each : ∀ j : Fin r, ∃ (t_j a_j b_j : D),
          t_j ∉ q.asIdeal ∧ t_j * y j - a_j * d_u - b_j * d_v = 0 := by
        intro j
        have hyL : algebraMap D L (y j) ∈ Ideal.span {u_bar, v_bar} := by
          rw [huv_bar_span, ← hker_res_L]
          have h1 := RingHom.congr_fun hres_L_comp (y j)
          have h2 : res_Ω (y j) = 0 := RingHom.mem_ker.mp (hres_ker.symm ▸ hy_mem j)
          exact h1.trans h2
        obtain ⟨z₁, z₂, hz_eq⟩ := Ideal.mem_span_pair.mp hyL
        obtain ⟨⟨r'_1, s'_1⟩, hr'1_eq⟩ := IsLocalization.surj q.asIdeal.primeCompl z₁
        obtain ⟨⟨r'_2, s'_2⟩, hr'2_eq⟩ := IsLocalization.surj q.asIdeal.primeCompl z₂
        dsimp only at hr'1_eq hr'2_eq
        have hL_eq :
            algebraMap D L ((s'_1.1 * s'_2.1) * y j) =
              algebraMap D L ((r'_1 * s'_2.1) * d_u + (s'_1.1 * r'_2) * d_v) := by
          simp only [map_add, map_mul]
          change (algebraMap D L s'_1.1 * algebraMap D L s'_2.1) * algebraMap D L (y j) =
            (algebraMap D L r'_1 * algebraMap D L s'_2.1) * u_bar +
              (algebraMap D L s'_1.1 * algebraMap D L r'_2) * v_bar
          rw [← hz_eq, ← hr'1_eq, ← hr'2_eq]
          ring
        obtain ⟨s'', hs''_eq⟩ := (IsLocalization.eq_iff_exists q.asIdeal.primeCompl L).mp hL_eq
        refine ⟨(s'' * (s'_1 * s'_2)).1, s''.1 * (r'_1 * s'_2.1), s''.1 * (s'_1.1 * r'_2),
          (s'' * (s'_1 * s'_2)).2, ?_⟩
        have h1 : s''.1 * ((s'_1.1 * s'_2.1) * y j) -
            s''.1 * ((r'_1 * s'_2.1) * d_u + (s'_1.1 * r'_2) * d_v) = 0 :=
