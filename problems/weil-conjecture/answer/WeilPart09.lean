              Z_01.isOpen isClosed_closure.isOpen_compl ⟨f_spec q, hqz, hq_in⟩ ⟨y₂, hy₂Z, hy₂Not⟩
          rcases hZ_cov hyZ with hyBad1 | hyBad2
          · exact hyBad1 hyOpen1
          · exact hyOpen2 hyBad2
        exact Set.Subset.antisymm (hZ.2 hImgIrred hZ_le) hZ_le
      have hF_irred : IsIrreducible F := ⟨hF_ne, hF_pre⟩
      refine ⟨⟨hF_irred, ?_⟩, hClEq F hF_irred Set.Subset.rfl⟩
      intro T hT hFT
      have hEqZ : closure (f_spec '' T) = Z := hClEq T hT hFT
      intro x hxT
      show f_spec x ∈ Z
      rw [← hEqZ]
      exact subset_closure ⟨x, hxT, rfl⟩
    obtain ⟨hF₁_comp, hCl₁⟩ := hPreComp Z₁ hZ₁ hz₁
    obtain ⟨hF₂_comp, hCl₂⟩ := hPreComp Z₂ hZ₂ hz₂
    rw [← PrimeSpectrum.zeroLocus_minimalPrimes C_aff] at hF₁_comp hF₂_comp
    rcases hF₁_comp with ⟨𝔭₁, h𝔭₁_min, h𝔭₁_eq⟩
    rcases hF₂_comp with ⟨𝔭₂, h𝔭₂_min, h𝔭₂_eq⟩
    dsimp at h𝔭₁_eq h𝔭₂_eq
    have h𝔭12 : 𝔭₁ ≠ 𝔭₂ := by
      intro hEq
      apply hZ12
      rw [← hCl₁, ← hCl₂, ← h𝔭₁_eq, ← h𝔭₂_eq, hEq]
    have hq₁ : 𝔭₁ ≤ q.asIdeal := by
      have : q ∈ PrimeSpectrum.zeroLocus (𝔭₁ : Set C_aff) := by
        rw [h𝔭₁_eq]
        exact hz₁
      exact this
    have hq₂ : 𝔭₂ ≤ q.asIdeal := by
      have : q ∈ PrimeSpectrum.zeroLocus (𝔭₂ : Set C_aff) := by
        rw [h𝔭₂_eq]
        exact hz₂
      exact this
    exact ⟨𝔭₁, h𝔭₁_min, 𝔭₂, h𝔭₂_min, h𝔭12, hq₁, hq₂⟩
  
  let ξ₀ : Fin (M + 1) → C_aff :=
    fun μ => (ι'_0.app (weilProjBasicOpen k₀ M (Fin.last M))).hom
      (t_proj k₀ M (Fin.last M) μ)
  let Q_k0 : ℕ → Submodule k₀ C_aff :=
    fun D => Submodule.span k₀ (Set.range fun e : weilDegMonomialIdx M D =>
      ∏ μ : Fin (M + 1), (ξ₀ μ) ^ (e.1 μ : ℕ))
  obtain ⟨hSing_le_C, hCompIso⟩ :=
    weil_twoChart_p1_tree_pole_squeeze_and_component_iso k₀
      (hAff_proj k₀ 1) (c_proj k₀ 1) (t_proj k₀ 1) (hCoord_proj k₀ 1)
      (fun Y _ p _ σ hSec => weil_integral_proper_section_appTop_bijective k₀ Y p σ hSec)
      (fun C_bar F_ss _ f' η_C η_X hIntC hIntX hNormX hProp hDomC hη hFuncC hFuncX hLocQF =>
        weil_birational_proper_iso_of_locallyQuasiFinite_normal
          C_bar (weilProjectiveSpaceOver k₀ 1).left F_ss f' η_C η_X
          hIntC hIntX hNormX hProp hDomC hη hFuncC hFuncX hLocQF)
      (weil_integral_scheme_functionField_over_field k₀)
      Z₀ p_Z₀ hFinC hNeC Sing_Z₀ S_inter hFinSing hSubSing hTreeLB
      Z_00 Z_01 hAff0 hAff1 hCov01 hSing01 hMeetSm
      y₁ x₀ hy₁_open hx₀_open hyx_one hSmB₀
      ⟨hCond_fin, hCond_rank⟩ hNormBranches
      Q_k0 d_E D₁ hd_E hD₁ hHilb0 hCocycle ⟨hCoker_fin, hCoker_rank⟩
  have hS_le_Sing : S_inter.ncard ≤ Sing_Z₀.ncard := Set.ncard_le_ncard hSubSing hFinSing
  have hCardGoal : S_inter.ncard + 1 ≤ (irreducibleComponents ↥Z₀).ncard :=
    (Nat.add_le_add_right hS_le_Sing 1).trans hSing_le_C
  refine ⟨⟨hFinC, hNeC⟩, hCompIso, ⟨hFinS, hCardGoal, ?_⟩⟩
  intro z _hz Z₁ hZ₁ Z₂ hZ₂ Z₃ hZ₃ hz₁ hz₂ hz₃
  exact hAtMost2 z Z₁ hZ₁ Z₂ hZ₂ Z₃ hZ₃ hz₁ hz₂ hz₃

theorem weil_henselian_valuationRing_semistable_p1_specialization (V₀ : Type u) [CommRing V₀]
    (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [HenselianLocalRing R]
    [Finite (PrimeSpectrum R)]
    (π_R : V₀ →+* R) (hSurjπ : Function.Surjective π_R)
    (hMaxR : IsLocalRing.maximalIdeal R ≠ ⊥)
    (K_R : Type u) [Field K_R] [IsAlgClosed K_R] [Algebra R K_R] [IsFractionRing R K_R]
    (hAlgRes : IsAlgClosed (IsLocalRing.ResidueField R))
    (M : ℕ)
    (C₀ : AlgebraicGeometry.Scheme.{u})
    (g₀ : C₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of V₀))
    (n : ℕ) (h3n : 3 ≤ n)
    (τ₀ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of V₀) ⟶ C₀))
    (ιP : C₀ ⟶ (weilProjectiveSpaceOver V₀ M).left)
    (hClP : AlgebraicGeometry.IsClosedImmersion ιP)
    (hCommP : ιP ≫ (weilProjectiveSpaceOver V₀ M).hom = g₀)
    (hFlat₀ : AlgebraicGeometry.Flat g₀)
    (hProp₀ : AlgebraicGeometry.IsProper g₀)
    (hLFP₀ : AlgebraicGeometry.LocallyOfFinitePresentation g₀)
    (hSurj₀ : AlgebraicGeometry.Surjective g₀)
    (hSec₀ : ∀ j : Fin n, τ₀ j ≫ g₀ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of V₀)))
    (hDisj₀ : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ₀ i).base) (Set.range (τ₀ j).base))
    (hSmSec₀ : ∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of V₀)),
      ∃ V_sm : C₀.Opens,
        (τ₀ j).base b ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g₀))
    (hGeom₀ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of V₀)),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback g₀ s) ∧
      ∀ y : ↥(CategoryTheory.Limits.pullback g₀ s),
        (∃ V_sm : (CategoryTheory.Limits.pullback g₀ s).Opens,
          y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
            (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g₀ s)) ∨
        (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
            (e₁ : U' ⟶ CategoryTheory.Limits.pullback g₀ s)
            (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) Ω ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
          AlgebraicGeometry.Etale e₁ ∧
          AlgebraicGeometry.Etale e₂ ∧
          e₁.base u₀ = y ∧
          (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
          e₁ ≫ CategoryTheory.Limits.pullback.snd g₀ s =
            e₂ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))))
    (hP1Conn : ∀ (E_bar : AlgebraicGeometry.Scheme.{u})
        (ι_bar : E_bar ⟶ (weilProjectiveSpaceOver R M).left),
      AlgebraicGeometry.IsClosedImmersion ι_bar →
      AlgebraicGeometry.IsIntegral E_bar →
      (∃ isoP1 :
          CategoryTheory.Limits.pullback
            (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))) ≅
          (weilProjectiveSpaceOver K_R 1).left,
        CategoryTheory.Limits.pullback.snd
            (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))) =
          isoP1.hom ≫ (weilProjectiveSpaceOver K_R 1).hom) →
      ConnectedSpace ↥(CategoryTheory.Limits.pullback
        (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))))
    (hNodalLift : ∀ (C_R : AlgebraicGeometry.Scheme.{u})
        (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)),
      AlgebraicGeometry.Flat g_R →
      AlgebraicGeometry.LocallyOfFinitePresentation g_R →
      ∀ (y₀ : ↥(CategoryTheory.Limits.pullback g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))),
        (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
            (e₁ : U' ⟶ CategoryTheory.Limits.pullback g_R
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
            (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸
                Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
          AlgebraicGeometry.Etale e₁ ∧
          AlgebraicGeometry.Etale e₂ ∧
          e₁.base u₀ = y₀ ∧
          (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
          e₁ ≫ CategoryTheory.Limits.pullback.snd g_R
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) =
            e₂ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) →
        ∃ (W' : AlgebraicGeometry.Scheme.{u}) (w₀ : W')
          (δ : R)
          (e_C : W' ⟶ C_R)
          (e_nod : W' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) R ⧸
              Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C δ}))),
          δ ∈ IsLocalRing.maximalIdeal R ∧
          AlgebraicGeometry.Etale e_C ∧
          AlgebraicGeometry.Etale e_nod ∧
          e_C.base w₀ = (CategoryTheory.Limits.pullback.fst g_R
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).base y₀ ∧
          (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e_nod.base w₀).asIdeal) ∧
          (∀ m ∈ IsLocalRing.maximalIdeal R,
            Ideal.Quotient.mk _ (MvPolynomial.C m) ∈ (e_nod.base w₀).asIdeal) ∧
          e_C ≫ g_R =
            e_nod ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))
    (hStabClosedR : HasStablePointedGeomFiber g₀ n τ₀
      (IsLocalRing.ResidueField R)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((IsLocalRing.residue R).comp π_R)))) :
    HasStablePointedGeomFiber g₀ n τ₀ K_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap R K_R).comp π_R))) :=
by
  classical
  
  let q_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of V₀) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_R)
  have hCl_qR : AlgebraicGeometry.IsClosedImmersion q_R :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom π_R) hSurjπ
  let C_R : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g₀ q_R
  let p_C0 : C_R ⟶ C₀ := CategoryTheory.Limits.pullback.fst g₀ q_R
  let g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) :=
    CategoryTheory.Limits.pullback.snd g₀ q_R
  have hPb_CR : CategoryTheory.IsPullback p_C0 g_R g₀ q_R :=
    CategoryTheory.IsPullback.of_hasPullback g₀ q_R
  have hCl_pC0 : AlgebraicGeometry.IsClosedImmersion p_C0 := inferInstance
  have hInj_pC0 : Function.Injective p_C0.base :=
    p_C0.isClosedEmbedding.toIsEmbedding.injective
  have hFlatR : AlgebraicGeometry.Flat g_R := inferInstance
  have hPropR : AlgebraicGeometry.IsProper g_R := inferInstance
  have hLFPR : AlgebraicGeometry.LocallyOfFinitePresentation g_R := inferInstance
  have hSurjR : AlgebraicGeometry.Surjective g_R := inferInstance
  obtain ⟨_hAff_proj, _c_proj, _t_proj, _hCoord_proj, hBase_proj⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg.{u}
  obtain ⟨Φ_VR, _hΦ_comm, hPbProj, _hΦ_charts⟩ := hBase_proj V₀ R π_R M
  have hw_PR : (p_C0 ≫ ιP) ≫ (weilProjectiveSpaceOver V₀ M).hom = g_R ≫ q_R := by
    rw [CategoryTheory.Category.assoc, hCommP]
    exact CategoryTheory.Limits.pullback.condition
  let ι_PR : C_R ⟶ (weilProjectiveSpaceOver R M).left :=
    hPbProj.lift (p_C0 ≫ ιP) g_R hw_PR
  have hιPR_fst : ι_PR ≫ Φ_VR = p_C0 ≫ ιP := hPbProj.lift_fst _ _ _
  have hCommPR : ι_PR ≫ (weilProjectiveSpaceOver R M).hom = g_R := hPbProj.lift_snd _ _ _
  have hPb_ιPR : CategoryTheory.IsPullback p_C0 ι_PR ιP Φ_VR := by
    have hOuter : CategoryTheory.IsPullback
        (ι_PR ≫ (weilProjectiveSpaceOver R M).hom) p_C0 q_R
        (ιP ≫ (weilProjectiveSpaceOver V₀ M).hom) := by
      rw [hCommPR, hCommP]
      exact hPb_CR.flip
    exact (CategoryTheory.IsPullback.of_right hOuter hιPR_fst hPbProj.flip).flip
  have hClPR : AlgebraicGeometry.IsClosedImmersion ι_PR :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.IsClosedImmersion) hPb_ιPR hClP
  let τ_R : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C_R) :=
    fun j => CategoryTheory.Limits.pullback.lift (q_R ≫ τ₀ j)
      (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)))
      (by rw [CategoryTheory.Category.assoc, hSec₀ j, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.id_comp])
  have hSecR : ∀ j : Fin n, τ_R j ≫ g_R = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)) :=
    fun j => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hτR_fst : ∀ j : Fin n, τ_R j ≫ p_C0 = q_R ≫ τ₀ j :=
    fun j => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hDisjR : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ_R i).base) (Set.range (τ_R j).base) := by
    intro i j hij
    rw [Set.disjoint_left]
    rintro x ⟨b₁, rfl⟩ ⟨b₂, hEq⟩
    have h1 : p_C0.base ((τ_R i).base b₁) ∈ Set.range (τ₀ i).base := by
      have h_ev := congrArg (fun f => f.base b₁) (hτR_fst i)
      exact ⟨q_R.base b₁, by simpa using h_ev.symm⟩
    have h2 : p_C0.base ((τ_R i).base b₁) ∈ Set.range (τ₀ j).base := by
      rw [← hEq]
      have h_ev := congrArg (fun f => f.base b₂) (hτR_fst j)
      exact ⟨q_R.base b₂, by simpa using h_ev.symm⟩
    exact Set.disjoint_left.mp (hDisj₀ hij) h1 h2
  have hSmSecR : ∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of R)),
      ∃ V_sm : C_R.Opens,
        (τ_R j).base b ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_R) := by
    intro j b
    obtain ⟨V₀_sm, hb_mem, hSm₀⟩ := hSmSec₀ j (q_R.base b)
    refine ⟨p_C0 ⁻¹ᵁ V₀_sm, ?_, ?_⟩
    · show p_C0.base ((τ_R j).base b) ∈ V₀_sm
      have h_ev := congrArg (fun f => f.base b) (hτR_fst j)
      have h_eq : p_C0.base ((τ_R j).base b) = (τ₀ j).base (q_R.base b) := by
        simpa using h_ev
      rw [h_eq]
      exact hb_mem
    · have hPb_V := (AlgebraicGeometry.isPullback_morphismRestrict p_C0 V₀_sm).paste_vert hPb_CR
      exact CategoryTheory.MorphismProperty.of_isPullback
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1) hPb_V hSm₀
  have hGeomR : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R)),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback g_R s) ∧
      ∀ y : ↥(CategoryTheory.Limits.pullback g_R s),
        HasSpreadSmoothOrNodalAt (CategoryTheory.Limits.pullback.snd g_R s) y := by
    intro Ω _ _ s
    have hPb_s : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst g_R s ≫ p_C0)
        (CategoryTheory.Limits.pullback.snd g_R s) g₀ (s ≫ q_R) :=
      (CategoryTheory.IsPullback.of_hasPullback g_R s).paste_horiz hPb_CR
    let Ψ : CategoryTheory.Limits.pullback g_R s ≅
        CategoryTheory.Limits.pullback g₀ (s ≫ q_R) :=
      hPb_s.isoPullback
    have : ConnectedSpace ↥(CategoryTheory.Limits.pullback g₀ (s ≫ q_R)) :=
      (hGeom₀ Ω (s ≫ q_R)).1
    have hSurjΨ : Function.Surjective Ψ.inv.base :=
      fun y => ⟨Ψ.hom.base y, by simp⟩
    refine ⟨hSurjΨ.connectedSpace Ψ.inv.continuous, ?_⟩
    intro y
    rcases (hGeom₀ Ω (s ≫ q_R)).2 (Ψ.hom.base y) with
      ⟨V₀_sm, hy_V₀, hSm_V₀⟩ | ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hX_mem, hComm_e⟩
    · left
      refine ⟨Ψ.hom ⁻¹ᵁ V₀_sm, hy_V₀, ?_⟩
      have hPb_Ψ : CategoryTheory.IsPullback Ψ.hom
          (CategoryTheory.Limits.pullback.snd g_R s)
          (CategoryTheory.Limits.pullback.snd g₀ (s ≫ q_R))
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) :=
        CategoryTheory.IsPullback.of_horiz_isIso
          ⟨by rw [hPb_s.isoPullback_hom_snd, CategoryTheory.Category.comp_id]⟩
      have hPb_V := (AlgebraicGeometry.isPullback_morphismRestrict Ψ.hom V₀_sm).paste_vert hPb_Ψ
      exact CategoryTheory.MorphismProperty.of_isPullback
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1) hPb_V hSm_V₀
    · right
      refine ⟨U', u₀, e₁ ≫ Ψ.inv, e₂, inferInstance, hEt₂, ?_, hX_mem, ?_⟩
      · have h_app : (e₁ ≫ Ψ.inv).base u₀ = Ψ.inv.base (e₁.base u₀) := by simp
        rw [h_app, hu₀]
        simp
      · rw [CategoryTheory.Category.assoc, hPb_s.isoPullback_inv_snd, hComm_e]
  have hStabIff : ∀ (Ω : Type u) [Field Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R)),
      HasStablePointedGeomFiber g_R n τ_R Ω s ↔
        HasStablePointedGeomFiber g₀ n τ₀ Ω (s ≫ q_R) := by
    intro Ω _ s
    have hPb_s : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst g_R s ≫ p_C0)
        (CategoryTheory.Limits.pullback.snd g_R s) g₀ (s ≫ q_R) :=
      (CategoryTheory.IsPullback.of_hasPullback g_R s).paste_horiz hPb_CR
    let Ψ : CategoryTheory.Limits.pullback g_R s ≅
        CategoryTheory.Limits.pullback g₀ (s ≫ q_R) :=
      hPb_s.isoPullback
    have hΨ_hom_fst : Ψ.hom ≫ CategoryTheory.Limits.pullback.fst g₀ (s ≫ q_R) =
        CategoryTheory.Limits.pullback.fst g_R s ≫ p_C0 :=
      hPb_s.isoPullback_hom_fst
    have hΨ_hom_snd : Ψ.hom ≫ CategoryTheory.Limits.pullback.snd g₀ (s ≫ q_R) =
        CategoryTheory.Limits.pullback.snd g_R s :=
      hPb_s.isoPullback_hom_snd
    have hΨ_inv_fst : Ψ.inv ≫ (CategoryTheory.Limits.pullback.fst g_R s ≫ p_C0) =
        CategoryTheory.Limits.pullback.fst g₀ (s ≫ q_R) :=
      hPb_s.isoPullback_inv_fst
    have hΨ_inv_snd : Ψ.inv ≫ CategoryTheory.Limits.pullback.snd g_R s =
        CategoryTheory.Limits.pullback.snd g₀ (s ≫ q_R) :=
      hPb_s.isoPullback_inv_snd
    have hΨ_left : ∀ x : ↥(CategoryTheory.Limits.pullback g_R s),
        Ψ.inv.base (Ψ.hom.base x) = x := fun x => by simp
    have hΨ_right : ∀ y : ↥(CategoryTheory.Limits.pullback g₀ (s ≫ q_R)),
        Ψ.hom.base (Ψ.inv.base y) = y := fun y => by simp
    have hIrredFwd : ∀ S : Set ↥(CategoryTheory.Limits.pullback g_R s),
        S ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_R s) →
        Ψ.hom.base '' S ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₀ (s ≫ q_R)) := by
      intro S ⟨hSIrred, hSMax⟩
      refine ⟨hSIrred.image Ψ.hom.base Ψ.hom.continuous.continuousOn, ?_⟩
      intro T hTIrred hST
      have hSub : S ⊆ Ψ.inv.base '' T := fun x hx =>
        ⟨Ψ.hom.base x, hST ⟨x, hx, rfl⟩, hΨ_left x⟩
      have hEq : Ψ.inv.base '' T ⊆ S :=
        hSMax (hTIrred.image Ψ.inv.base Ψ.inv.continuous.continuousOn) hSub
