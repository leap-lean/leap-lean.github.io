              simp only [Algebra.smul_def, map_mul, map_add]
              ring
            change (d₁ • u₂ + d₂ • v₂ + z₁) * (d'₁ • u₂ + d'₂ • v₂ + z₂) -
              ((d₁ * d'₁) • u₂ ^ 2 + (d₂ * d'₂) • v₂ ^ 2) ∈ 𝔪₂ ^ 3
            rw [h_alg]
            have h_m1_u : d₁ • u₂ + d₂ • v₂ ∈ 𝔪₂ := by
              rw [Algebra.smul_def, Algebra.smul_def]
              exact 𝔪₂.add_mem (Ideal.mul_mem_left _ _ hu₂_mem) (Ideal.mul_mem_left _ _ hv₂_mem)
            have h_m1_v : d'₁ • u₂ + d'₂ • v₂ ∈ 𝔪₂ := by
              rw [Algebra.smul_def, Algebra.smul_def]
              exact 𝔪₂.add_mem (Ideal.mul_mem_left _ _ hu₂_mem) (Ideal.mul_mem_left _ _ hv₂_mem)
            have h_z12 : z₁ * z₂ ∈ 𝔪₂ ^ 3 := by
              have hz2_m : z₂ ∈ 𝔪₂ := Ideal.pow_le_self (by norm_num) hz₂
              rw [pow_succ 𝔪₂ 2]
              exact Ideal.mul_mem_mul hz₁ hz2_m
            refine Submodule.add_mem _ (Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) ?_) h_z12
            · rw [Algebra.smul_def]
              exact Ideal.mul_mem_left (𝔪₂ ^ 3) _ huv₂
            · exact h_12_m2 (Ideal.mul_mem_mul h_m1_u hz₂)
            · exact h_12_m2 (Ideal.mul_mem_mul h_m1_v hz₁)
          · rintro x y ⟨cx, hcx⟩ ⟨cy, hcy⟩
            refine ⟨cx + cy, ?_⟩
            have h_sum : (x + y) - ((cx + cy) 0 • u₂ ^ 2 + (cx + cy) 1 • v₂ ^ 2) =
                (x - (cx 0 • u₂ ^ 2 + cx 1 • v₂ ^ 2)) + (y - (cy 0 • u₂ ^ 2 + cy 1 • v₂ ^ 2)) := by
              simp only [Pi.add_apply, add_smul]
              abel
            rw [h_sum]
            exact (𝔪₂ ^ 3).add_mem hcx hcy
        have hS_inj : Function.Injective S_map := by
          have hrk := LinearMap.finrank_range_add_finrank_ker S_map
          rw [LinearMap.range_eq_top.mpr hS_surj, finrank_top, h_ker_π2_dim,
            Module.finrank_fin_fun] at hrk
          have h_ker0 : Module.finrank Ω₂ (LinearMap.ker S_map) = 0 := by omega
          have h_bot : LinearMap.ker S_map = ⊥ := Submodule.finrank_eq_zero.mp h_ker0
          exact LinearMap.ker_eq_bot.mp h_bot
        obtain ⟨c₁, c₂, z, hz_sq, hw₂_eq⟩ := h_decomp_m2 w₂ hw₂_mem
        have hw₂_diff : w₂ ^ 2 - (c₁ ^ 2 • u₂ ^ 2 + c₂ ^ 2 • v₂ ^ 2) ∈ 𝔪₂ ^ 3 := by
          have h_alg : (c₁ • u₂ + c₂ • v₂ + z) ^ 2 - (c₁ ^ 2 • u₂ ^ 2 + c₂ ^ 2 • v₂ ^ 2) =
              (2 * c₁ * c₂) • (u₂ * v₂) + 2 * (c₁ • u₂ + c₂ • v₂) * z + z ^ 2 := by
            simp only [Algebra.smul_def, map_pow, map_mul, map_ofNat]
            ring
          rw [hw₂_eq, h_alg]
          have h_lin : 2 * (c₁ • u₂ + c₂ • v₂) ∈ 𝔪₂ := by
            rw [Algebra.smul_def, Algebra.smul_def]
            exact Ideal.mul_mem_left _ 2
              (𝔪₂.add_mem (Ideal.mul_mem_left _ _ hu₂_mem) (Ideal.mul_mem_left _ _ hv₂_mem))
          have h_z_sq : z ^ 2 ∈ 𝔪₂ ^ 3 := by
            rw [sq, pow_succ 𝔪₂ 2]
            exact Ideal.mul_mem_mul hz_sq (Ideal.pow_le_self (by norm_num) hz_sq)
          refine Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) h_z_sq
          · rw [Algebra.smul_def]
            exact Ideal.mul_mem_left (𝔪₂ ^ 3) _ huv₂
          · exact h_12_m2 (Ideal.mul_mem_mul h_lin hz_sq)
        have h_lin_comb_mem : c₁ ^ 2 • u₂ ^ 2 + c₂ ^ 2 • v₂ ^ 2 ∈ 𝔪₂ ^ 3 := by
          have h := (𝔪₂ ^ 3).sub_mem hw₂_sq_mem hw₂_diff
          simpa using h
        have hS_zero : S_map ![c₁ ^ 2, c₂ ^ 2] = 0 := by
          apply Subtype.ext
          change c₁ ^ 2 • mk2_3 (u₂ ^ 2) + c₂ ^ 2 • mk2_3 (v₂ ^ 2) = 0
          rw [← map_smul, ← map_smul, ← map_add]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr h_lin_comb_mem
        have hc_vec0 : (![c₁ ^ 2, c₂ ^ 2] : Fin 2 → Ω₂) = 0 :=
          hS_inj (hS_zero.trans (map_zero S_map).symm)
        have hc₁_0 : c₁ = 0 := sq_eq_zero_iff.mp (congrArg (fun f => f 0) hc_vec0)
        have hc₂_0 : c₂ = 0 := sq_eq_zero_iff.mp (congrArg (fun f => f 1) hc_vec0)
        rw [hc₁_0, hc₂_0, zero_smul, zero_smul, add_zero, zero_add] at hw₂_eq
        exact hw₂_not_sq (hw₂_eq ▸ hz_sq)
      refine ⟨u₁, v₁, ?_, huv₁_mem⟩
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro x (rfl | rfl)
        · exact hu₁_mem
        · exact hv₁_mem
      · change 𝔪₁ ≤ Ideal.span {u₁, v₁}
        rw [← h_span_e, Ideal.span_le]
        let Δ := α₁ * β₂ - α₂ * β₁
        have he₁_cramer : e₁ = (Δ⁻¹ * β₂) • u₁ + (-Δ⁻¹ * β₁) • v₁ := by
          have h1 : Δ • e₁ = β₂ • u₁ - β₁ • v₁ := by
            dsimp only [Δ, u₁, v₁]
            simp only [Algebra.smul_def, map_sub, map_mul]
            ring
          calc
            e₁ = Δ⁻¹ • (Δ • e₁) := (inv_smul_smul₀ h_det_ne e₁).symm
            _ = Δ⁻¹ • (β₂ • u₁ - β₁ • v₁) := by rw [h1]
            _ = (Δ⁻¹ * β₂) • u₁ + (-Δ⁻¹ * β₁) • v₁ := by
                simp only [Algebra.smul_def, map_mul, map_neg]
                ring
        have he₂_cramer : e₂ = (-Δ⁻¹ * α₂) • u₁ + (Δ⁻¹ * α₁) • v₁ := by
          have h1 : Δ • e₂ = -α₂ • u₁ + α₁ • v₁ := by
            dsimp only [Δ, u₁, v₁]
            simp only [Algebra.smul_def, map_sub, map_mul, map_neg]
            ring
          calc
            e₂ = Δ⁻¹ • (Δ • e₂) := (inv_smul_smul₀ h_det_ne e₂).symm
            _ = Δ⁻¹ • (-α₂ • u₁ + α₁ • v₁) := by rw [h1]
            _ = (-Δ⁻¹ * α₂) • u₁ + (Δ⁻¹ * α₁) • v₁ := by
                simp only [Algebra.smul_def, map_mul, map_neg]
                ring
        rintro x (rfl | rfl)
        · rw [he₁_cramer, Algebra.smul_def, Algebra.smul_def]
          exact Submodule.add_mem _
            (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
            (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
        · rw [he₂_cramer, Algebra.smul_def, Algebra.smul_def]
          exact Submodule.add_mem _
            (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
            (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))

  
  have h_isPullback_spec_tensor :
      ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T],
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S (TensorProduct R S T))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R T))) := by
    intro R S T _ _ _ _ _
    let f_S := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S))
    let f_T := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R T))
    let e := AlgebraicGeometry.pullbackSpecIso R S T
    have h_alg : CommRingCat.ofHom (algebraMap S (TensorProduct R S T)) =
        CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom := by
      apply congrArg CommRingCat.ofHom
      ext s
      rfl
    have h1 : e.inv ≫ CategoryTheory.Limits.pullback.fst f_S f_T =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S (TensorProduct R S T))) := by
      rw [h_alg]
      exact AlgebraicGeometry.pullbackSpecIso_inv_fst R S T
    have h2 : e.inv ≫ CategoryTheory.Limits.pullback.snd f_S f_T =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) :=
      AlgebraicGeometry.pullbackSpecIso_inv_snd R S T
    refine CategoryTheory.IsPullback.of_iso_pullback ⟨?_⟩ e.symm h1 h2
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    apply congrArg AlgebraicGeometry.Spec.map
    apply congrArg CommRingCat.ofHom
    ext r
    change (algebraMap R S r) ⊗ₜ[R] (1 : T) = (1 : S) ⊗ₜ[R] (algebraMap R T r)
    rw [Algebra.algebraMap_eq_smul_one (A := S) r, TensorProduct.smul_tmul,
      ← Algebra.algebraMap_eq_smul_one (A := T) r]

  
  have h_isPullback_node_ring :
      ∀ (Ω₁ Ω₂ : Type u) [Field Ω₁] [Field Ω₂] (φ : Ω₁ →+* Ω₂),
        ∃ ψ_node :
            (MvPolynomial (Fin 2) Ω₁ ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω₁))) →+*
            (MvPolynomial (Fin 2) Ω₂ ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω₂))),
          (∀ i : Fin 2, ψ_node (Ideal.Quotient.mk _ (MvPolynomial.X i)) = Ideal.Quotient.mk _ (MvPolynomial.X i)) ∧
          CategoryTheory.IsPullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_node))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) := by
    intro Ω₁ Ω₂ _ _ φ
    letI : Algebra Ω₁ Ω₂ := φ.toAlgebra
    let I₁ : Ideal (MvPolynomial (Fin 2) Ω₁) := Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
    let I₂ : Ideal (MvPolynomial (Fin 2) Ω₂) := Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
    let R₁ := MvPolynomial (Fin 2) Ω₁ ⧸ I₁
    let R₂ := MvPolynomial (Fin 2) Ω₂ ⧸ I₂
    have h_map_I₁ : I₁ ≤ Ideal.comap (MvPolynomial.map φ) I₂ := by
      rw [Ideal.span_le]
      rintro _ ⟨rfl⟩
      change MvPolynomial.map φ (MvPolynomial.X 0 * MvPolynomial.X 1) ∈ I₂
      rw [map_mul, MvPolynomial.map_X, MvPolynomial.map_X]
      exact Ideal.subset_span rfl
    let ψ_node : R₁ →+* R₂ :=
      Ideal.Quotient.lift I₁ ((Ideal.Quotient.mk I₂).comp (MvPolynomial.map φ))
        (fun P hP => Ideal.Quotient.eq_zero_iff_mem.mpr (h_map_I₁ hP))
    let ψ_node_alg : R₁ →ₐ[Ω₁] R₂ :=
      { ψ_node with
        commutes' := fun c => by
          change Ideal.Quotient.mk I₂ (MvPolynomial.map φ (MvPolynomial.C c)) =
            Ideal.Quotient.mk I₂ (MvPolynomial.C (φ c))
          rw [MvPolynomial.map_C] }
    let T_node := TensorProduct Ω₁ Ω₂ R₁
    let α_alg : T_node →ₐ[Ω₂] R₂ :=
      Algebra.TensorProduct.lift (Algebra.ofId Ω₂ R₂) ψ_node_alg (fun _ _ => mul_comm _ _)
    let β_poly : MvPolynomial (Fin 2) Ω₂ →ₐ[Ω₂] T_node :=
      MvPolynomial.aeval (fun i : Fin 2 => (1 : Ω₂) ⊗ₜ[Ω₁] (Ideal.Quotient.mk I₁ (MvPolynomial.X i)))
    have h_β_ker : I₂ ≤ RingHom.ker β_poly.toRingHom := by
      rw [Ideal.span_le]
      rintro _ ⟨rfl⟩
      change β_poly (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      have hzero : Ideal.Quotient.mk I₁ (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
      rw [map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← map_mul, hzero,
        TensorProduct.tmul_zero]
    let β_alg : R₂ →ₐ[Ω₂] T_node :=
      Ideal.Quotient.liftₐ I₂ β_poly (fun P hP => h_β_ker hP)
    have h_αβ_ring : α_alg.toRingHom.comp β_alg.toRingHom = RingHom.id R₂ := by
      apply Ideal.Quotient.ringHom_ext
      have h_alg_eq : (α_alg.comp β_alg).comp (Ideal.Quotient.mkₐ Ω₂ I₂) = Ideal.Quotient.mkₐ Ω₂ I₂ := by
        apply MvPolynomial.algHom_ext
        intro i
        change α_alg (β_poly (MvPolynomial.X i)) = Ideal.Quotient.mk I₂ (MvPolynomial.X i)
        rw [MvPolynomial.aeval_X]
        change (Algebra.ofId Ω₂ R₂ 1) * ψ_node (Ideal.Quotient.mk I₁ (MvPolynomial.X i)) = _
        rw [map_one, one_mul]
        change Ideal.Quotient.mk I₂ (MvPolynomial.map φ (MvPolynomial.X i)) = _
        rw [MvPolynomial.map_X]
      exact RingHom.ext fun P =>
        congrArg (fun f : MvPolynomial (Fin 2) Ω₂ →ₐ[Ω₂] R₂ => f P) h_alg_eq
    have h_βα : β_alg.comp α_alg = AlgHom.id Ω₂ T_node := by
      apply Algebra.TensorProduct.ext
      · apply AlgHom.ext
        intro c
        exact (β_alg.comp α_alg).commutes c
      · apply AlgHom.coe_ringHom_injective
        apply Ideal.Quotient.ringHom_ext
        have h_alg_eq : (((β_alg.comp α_alg).restrictScalars Ω₁).comp
            (Algebra.TensorProduct.includeRight : R₁ →ₐ[Ω₁] T_node)).comp
            (Ideal.Quotient.mkₐ Ω₁ I₁) =
            (Algebra.TensorProduct.includeRight : R₁ →ₐ[Ω₁] T_node).comp
            (Ideal.Quotient.mkₐ Ω₁ I₁) := by
          apply MvPolynomial.algHom_ext
          intro i
          change β_alg (α_alg ((1 : Ω₂) ⊗ₜ[Ω₁] Ideal.Quotient.mk I₁ (MvPolynomial.X i))) =
            (1 : Ω₂) ⊗ₜ[Ω₁] Ideal.Quotient.mk I₁ (MvPolynomial.X i)
          have h1 : α_alg ((1 : Ω₂) ⊗ₜ[Ω₁] Ideal.Quotient.mk I₁ (MvPolynomial.X i)) =
              Ideal.Quotient.mk I₂ (MvPolynomial.X i) := by
            change (Algebra.ofId Ω₂ R₂ 1) * ψ_node (Ideal.Quotient.mk I₁ (MvPolynomial.X i)) = _
            rw [map_one, one_mul]
            change Ideal.Quotient.mk I₂ (MvPolynomial.map φ (MvPolynomial.X i)) = _
            rw [MvPolynomial.map_X]
          rw [h1]
          exact MvPolynomial.aeval_X _ i
        exact RingHom.ext fun P =>
          congrArg (fun f : MvPolynomial (Fin 2) Ω₁ →ₐ[Ω₁] T_node => f P) h_alg_eq
    have h_βα_ring : β_alg.toRingHom.comp α_alg.toRingHom = RingHom.id T_node :=
      RingHom.ext fun x => congrArg (fun f : T_node →ₐ[Ω₂] T_node => f x) h_βα
    have hiso_fst : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_alg.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω₂ T_node)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I₂).comp MvPolynomial.C)) := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      apply congrArg AlgebraicGeometry.Spec.map
      apply congrArg CommRingCat.ofHom
      exact RingHom.ext fun c => α_alg.commutes c
    let inc_R₁ : R₁ →+* T_node :=
      (Algebra.TensorProduct.includeRight : R₁ →ₐ[Ω₁] T_node).toRingHom
    have hiso_snd : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_alg.toRingHom) ≫
        AlgebraicGeometry.Spec.map (@CommRingCat.ofHom R₁ T_node inferInstance inferInstance inc_R₁) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_node) := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      apply congrArg AlgebraicGeometry.Spec.map
      apply congrArg CommRingCat.ofHom
      refine RingHom.ext fun x => ?_
      change (Algebra.ofId Ω₂ R₂ 1) * ψ_node x = ψ_node x
      rw [map_one, one_mul]
    let iso_spec : AlgebraicGeometry.Spec (CommRingCat.of R₂) ≅
        AlgebraicGeometry.Spec (CommRingCat.of T_node) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_alg.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_alg.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, h_αβ_ring,
            CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, h_βα_ring,
            CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    have hPbT : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω₂ T_node)))
        (AlgebraicGeometry.Spec.map (@CommRingCat.ofHom R₁ T_node inferInstance inferInstance inc_R₁))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I₁).comp MvPolynomial.C))) :=
      h_isPullback_spec_tensor Ω₁ Ω₂ R₁
    have hPbNode_flip : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I₂).comp MvPolynomial.C)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_node))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I₁).comp MvPolynomial.C))) :=
      CategoryTheory.IsPullback.of_iso hPbT iso_spec.symm (Iso.refl _) (Iso.refl _) (Iso.refl _)
        (by simpa only [Iso.symm_hom, Iso.refl_hom, Category.comp_id] using (Iso.eq_inv_comp iso_spec).mpr hiso_fst)
        (by simpa only [Iso.symm_hom, Iso.refl_hom, Category.comp_id] using (Iso.eq_inv_comp iso_spec).mpr hiso_snd)
        (by simp) (by simp)
    refine ⟨ψ_node, ?_, hPbNode_flip.flip⟩
    intro i
    change Ideal.Quotient.mk I₂ (MvPolynomial.map φ (MvPolynomial.X i)) = _
    rw [MvPolynomial.map_X]

  
  have h_s3 :
      ∀ (Ω₁ Ω₂ : Type u) [Field Ω₁] [Field Ω₂]
        (φ : Ω₁ →+* Ω₂)
        (Y₁ : AlgebraicGeometry.Scheme.{u})
        (p₁ : Y₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω₁)),
        (∀ y₁ : Y₁, HasSpreadSmoothOrNodalAt p₁ y₁) →
        ∀ y₂ : ↥(CategoryTheory.Limits.pullback p₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))),
          HasSpreadSmoothOrNodalAt
            (CategoryTheory.Limits.pullback.snd p₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))) y₂ := by
    intro Ω₁ Ω₂ _ _ φ Y₁ p₁ hY₁ y₂
    let f_φ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
    let Y₂ := CategoryTheory.Limits.pullback p₁ f_φ
    let π₁₂ := CategoryTheory.Limits.pullback.fst p₁ f_φ
    let p₂ := CategoryTheory.Limits.pullback.snd p₁ f_φ
    rcases hY₁ (π₁₂.base y₂) with ⟨V₁, hy₁, hSm₁⟩ |
        ⟨U'₁, u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hIdeal, hComm⟩
    · left
      let V₂ : Y₂.Opens := π₁₂ ⁻¹ᵁ V₁
      refine ⟨V₂, hy₁, ?_⟩
      let π_V : V₂.toScheme ⟶ V₁.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift V₁.ι (V₂.ι ≫ π₁₂) (by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨x, rfl⟩
          exact x.2)
      have hPbV : CategoryTheory.IsPullback π_V V₂.ι V₁.ι π₁₂ :=
        AlgebraicGeometry.IsOpenImmersion.isPullback π_V V₂.ι V₁.ι π₁₂
          (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _).symm
          (by ext x; simp [V₂, π₁₂, AlgebraicGeometry.Scheme.Opens.opensRange_ι])
      have hPbComp : CategoryTheory.IsPullback π_V (V₂.ι ≫ p₂) (V₁.ι ≫ p₁) f_φ :=
        hPbV.paste_vert (CategoryTheory.IsPullback.of_hasPullback p₁ f_φ)
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPbComp hSm₁
    · right
      obtain ⟨ψ_node, hψ_X, hPbNode⟩ := h_isPullback_node_ring Ω₁ Ω₂ φ
      let p_node1 := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω₁)))).comp MvPolynomial.C))
      let p_node2 := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω₂)))).comp MvPolynomial.C))
      let U'₂ := CategoryTheory.Limits.pullback (e₁ ≫ p₁) f_φ
      let π_U := CategoryTheory.Limits.pullback.fst (e₁ ≫ p₁) f_φ
      let p_U₂ := CategoryTheory.Limits.pullback.snd (e₁ ≫ p₁) f_φ
      let e'₁ : U'₂ ⟶ Y₂ :=
        CategoryTheory.Limits.pullback.lift (π_U ≫ e₁) p_U₂
          (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
      have he'₁_fst : e'₁ ≫ π₁₂ = π_U ≫ e₁ := CategoryTheory.Limits.pullback.lift_fst _ _ _
      have he'₁_snd : e'₁ ≫ p₂ = p_U₂ := CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hPb₁_flip : CategoryTheory.IsPullback e'₁ π_U π₁₂ e₁ := by
        refine CategoryTheory.IsPullback.of_right ?_ he'₁_fst
          (CategoryTheory.IsPullback.of_hasPullback p₁ f_φ).flip
        rw [he'₁_snd]
        exact (CategoryTheory.IsPullback.of_hasPullback (e₁ ≫ p₁) f_φ).flip
      have hPb₁ : CategoryTheory.IsPullback π_U e'₁ e₁ π₁₂ := hPb₁_flip.flip
      have hEt'₁ : AlgebraicGeometry.Etale e'₁ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb₁ hEt₁
      have hComm_U : (π_U ≫ e₂) ≫ p_node1 = p_U₂ ≫ f_φ := by
        rw [CategoryTheory.Category.assoc, ← hComm, ← CategoryTheory.Category.assoc]
        exact CategoryTheory.Limits.pullback.condition (f := e₁ ≫ p₁) (g := f_φ)
      let e'₂ := hPbNode.lift (π_U ≫ e₂) p_U₂ hComm_U
      have he'₂_fst : e'₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_node) = π_U ≫ e₂ :=
        hPbNode.lift_fst _ _ _
      have he'₂_snd : e'₂ ≫ p_node2 = p_U₂ := hPbNode.lift_snd _ _ _
      have hPb₂_flip : CategoryTheory.IsPullback
          e'₂ π_U (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_node)) e₂ := by
        refine CategoryTheory.IsPullback.of_right ?_ he'₂_fst hPbNode.flip
        rw [he'₂_snd]
        refine CategoryTheory.IsPullback.of_iso
          (CategoryTheory.IsPullback.of_hasPullback (e₁ ≫ p₁) f_φ).flip
          (Iso.refl _) (Iso.refl _) (Iso.refl _) (Iso.refl _)
          (by simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]; rfl)
          (by simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]; rfl)
          (by simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]; rfl)
          ?_
        simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]
        exact hComm
      have hPb₂ : CategoryTheory.IsPullback
          π_U e'₂ e₂ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_node)) := hPb₂_flip.flip
      have hEt'₂ : AlgebraicGeometry.Etale e'₂ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb₂ hEt₂
      obtain ⟨u'₂, hu'₂_1, hu'₂_2⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb₁ u₀ y₂ hu₀
      refine ⟨U'₂, u'₂, e'₁, e'₂, hEt'₁, hEt'₂, hu'₂_2, ?_, ?_⟩
      · intro i
        have h_pt : (e'₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_node)).base u'₂ =
            e₂.base u₀ := by
          rw [he'₂_fst]
          change e₂.base (π_U.base u'₂) = e₂.base u₀
          rw [hu'₂_1]
        have h_mem := hIdeal i
        rw [← h_pt] at h_mem
        change ψ_node (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ (e'₂.base u'₂).asIdeal at h_mem
        rwa [hψ_X i] at h_mem
      · rw [he'₁_snd, he'₂_snd]

  
  constructor
  · 
    intro Ω _ _ hLocal Y p_Y _ hRedY hArtinY y
    haveI : AlgebraicGeometry.IsReduced Y := hRedY
    obtain ⟨W, hW, hyW, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : Y.Opens)) (x := y) trivial
    let R_W : CommRingCat.{u} := Y.presheaf.obj (Opposite.op W)
    let D : Type u := ↑R_W
    let j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y := hW.fromSpec
    have hj_open : AlgebraicGeometry.IsOpenImmersion j_D := inferInstance
    let φ_ΩD : Ω →+* D := (AlgebraicGeometry.Spec.preimage (j_D ≫ p_Y)).hom
    letI : Algebra Ω D := φ_ΩD.toAlgebra
    have hj_comm : j_D ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) :=
      (AlgebraicGeometry.Spec.map_preimage (j_D ≫ p_Y)).symm
    have hLFT_comp : AlgebraicGeometry.LocallyOfFiniteType (j_D ≫ p_Y) := inferInstance
    rw [hj_comm] at hLFT_comp
    have hFT_hom : (algebraMap Ω D).FiniteType :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_comp
    haveI hFT_D : Algebra.FiniteType Ω D := RingHom.finiteType_algebraMap.mp hFT_hom
    have hRedSpec : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (CommRingCat.of D)) :=
      AlgebraicGeometry.isReduced_of_isOpenImmersion j_D
    haveI hRedD : _root_.IsReduced D :=
      (AlgebraicGeometry.affine_isReduced_iff (CommRingCat.of D)).mp hRedSpec
    have hy_range : y ∈ Set.range j_D.base := by
      change y ∈ Set.range hW.fromSpec.base
      rw [hW.range_fromSpec]
      exact hyW
    obtain ⟨p, hp⟩ := hy_range
    rcases h_s1 Ω D (hArtinY D j_D hj_open hj_comm) (hLocal D) p with
        ⟨f, hfp, hSmf⟩ | ⟨B, instB, p_B, φ_D, φ_node, hEtD, hEtNode, hComap, hIdeal, hCommB⟩
    · left
      let ι_f : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f)) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of D) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D (Localization.Away f)))
      have hOpen_ι : AlgebraicGeometry.IsOpenImmersion ι_f :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization f
      let g_f := ι_f ≫ j_D
      have hOpen_gf : AlgebraicGeometry.IsOpenImmersion g_f := inferInstance
      let V : Y.Opens := g_f.opensRange
      have hp_basic : p ∈ (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum D)) := hfp
      rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away f) f] at hp_basic
      obtain ⟨p_f, hp_f⟩ := hp_basic
      have hyV : y ∈ V := by
        change y ∈ Set.range g_f.base
        refine ⟨p_f, ?_⟩
        change j_D.base (ι_f.base p_f) = y
        rw [← hp]
        exact congrArg j_D.base hp_f
      have hgf_p : g_f ≫ p_Y =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω (Localization.Away f))) := by
        rw [CategoryTheory.Category.assoc, hj_comm, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq Ω D (Localization.Away f)]
      have hSmSpec : AlgebraicGeometry.SmoothOfRelativeDimension 1 (g_f ≫ p_Y) := by
        rw [hgf_p]
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)).mpr
          (RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _ hSmf)
      refine ⟨V, hyV, ?_⟩
      have hIsoV : g_f.isoOpensRange.inv ≫ (g_f ≫ p_Y) = V.ι ≫ p_Y := by
        rw [← CategoryTheory.Category.assoc]
        congr 1
        rw [CategoryTheory.Iso.inv_comp_eq]
        exact (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι g_f).symm
      rw [← hIsoV]
      have hPbIso : CategoryTheory.IsPullback g_f.isoOpensRange.inv
          (g_f.isoOpensRange.inv ≫ (g_f ≫ p_Y)) (g_f ≫ p_Y) (𝟙 _) :=
        CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [CategoryTheory.Category.comp_id]⟩
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPbIso hSmSpec
    · right
      letI : CommRing B := instB
      let e_D : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of D) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_D)
      have hEt_eD : AlgebraicGeometry.Etale e_D :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEtD
      let e₁ := e_D ≫ j_D
      have hEt₁ : AlgebraicGeometry.Etale e₁ := inferInstance
      let e₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_node)
      have hEt₂ : AlgebraicGeometry.Etale e₂ :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEtNode
      refine ⟨AlgebraicGeometry.Spec (CommRingCat.of B), p_B, e₁, e₂, hEt₁, hEt₂, ?_, hIdeal, ?_⟩
      · change j_D.base (PrimeSpectrum.comap φ_D p_B) = y
        rw [hComap, hp]
      · rw [CategoryTheory.Category.assoc, hj_comm, ← AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
          hCommB]
  · 
    intro hArtinIff Ω₁ Ω₂ _ _ _ _ φ Y₁ p₁ _
    constructor
    · intro hY₁ y₂
      exact h_s3 Ω₁ Ω₂ φ Y₁ p₁ hY₁ y₂
    · intro hY₂
      letI : Algebra Ω₁ Ω₂ := φ.toAlgebra
      let f_φ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
      let Y₂ := CategoryTheory.Limits.pullback p₁ f_φ
      let p₂ := CategoryTheory.Limits.pullback.snd p₁ f_φ
      obtain ⟨hRedY₂, hArtinY₂⟩ := (hArtinIff Ω₂ Y₂ p₂).mp hY₂
      haveI : AlgebraicGeometry.IsReduced Y₂ := hRedY₂
      have hAllCharts :
          ∀ (D : Type u) [CommRing D] [Algebra Ω₁ D]
            (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y₁),
            AlgebraicGeometry.IsOpenImmersion j_D →
            j_D ≫ p₁ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω₁ D)) →
            _root_.IsReduced D ∧
              ∀ (q₁ : PrimeSpectrum D), q₁.asIdeal.IsMaximal →
                let L₁ := Localization.AtPrime q₁.asIdeal
                let 𝔪₁ : Ideal L₁ := IsLocalRing.maximalIdeal L₁
                Module.finrank Ω₁ (L₁ ⧸ 𝔪₁ ^ 2) = 2 ∨
                  (Module.finrank Ω₁ (L₁ ⧸ 𝔪₁ ^ 2) = 3 ∧
                   Module.finrank Ω₁ (L₁ ⧸ 𝔪₁ ^ 3) = 5 ∧
                   ∃ u₁ v₁ : L₁, Ideal.span {u₁, v₁} = 𝔪₁ ∧ u₁ * v₁ ∈ 𝔪₁ ^ 3) := by
        intro D _ _ j_D hj_open hj_comm
        have hLFT_comp : AlgebraicGeometry.LocallyOfFiniteType (j_D ≫ p₁) := inferInstance
        rw [hj_comm] at hLFT_comp
        have hFT_hom : (algebraMap Ω₁ D).FiniteType :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_comp
        haveI hFT_D : Algebra.FiniteType Ω₁ D := RingHom.finiteType_algebraMap.mp hFT_hom
        let D₂ := TensorProduct Ω₁ Ω₂ D
        let ι_R := (Algebra.TensorProduct.includeRight : D →ₐ[Ω₁] D₂).toRingHom
        have hPbSpec : CategoryTheory.IsPullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω₂ D₂)))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R))
            f_φ
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω₁ D))) :=
          h_isPullback_spec_tensor Ω₁ Ω₂ D
        have hComm_j₂ :
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫ j_D) ≫ p₁ =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω₂ D₂)) ≫ f_φ := by
          rw [CategoryTheory.Category.assoc, hj_comm]
          exact hPbSpec.w.symm
        let j₂ : AlgebraicGeometry.Spec (CommRingCat.of D₂) ⟶ Y₂ :=
          CategoryTheory.Limits.pullback.lift
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫ j_D)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω₂ D₂)))
            hComm_j₂
        have hj₂_fst : j₂ ≫ CategoryTheory.Limits.pullback.fst p₁ f_φ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫ j_D :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hj₂_snd : j₂ ≫ p₂ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω₂ D₂)) :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hPb_j₂_flip : CategoryTheory.IsPullback j₂
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R))
            (CategoryTheory.Limits.pullback.fst p₁ f_φ) j_D := by
          refine CategoryTheory.IsPullback.of_right ?_ hj₂_fst
            (CategoryTheory.IsPullback.of_hasPullback p₁ f_φ).flip
          rw [hj₂_snd]
          refine CategoryTheory.IsPullback.of_iso hPbSpec
            (Iso.refl _) (Iso.refl _) (Iso.refl _) (Iso.refl _)
            (by simp) (by simp) (by simp) ?_
          simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]
          exact hj_comm.symm
        haveI hj₂_open : AlgebraicGeometry.IsOpenImmersion j₂ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_j₂_flip.flip hj_open
        have hRedSpec₂ : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (CommRingCat.of D₂)) :=
          AlgebraicGeometry.isReduced_of_isOpenImmersion j₂
        have hRedD₂ : _root_.IsReduced D₂ :=
          (AlgebraicGeometry.affine_isReduced_iff (CommRingCat.of D₂)).mp hRedSpec₂
        exact h_s2 Ω₁ Ω₂ D hRedD₂ (hArtinY₂ D₂ j₂ hj₂_open hj₂_snd)
      have hRedY₁ : AlgebraicGeometry.IsReduced Y₁ := by
        haveI hStalk : ∀ x : Y₁, _root_.IsReduced ↑(Y₁.presheaf.stalk x) := by
          intro x
          obtain ⟨W, hW, hxW, _⟩ :=
            AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : Y₁.Opens)) (x := x) trivial
          let R_W : CommRingCat.{u} := Y₁.presheaf.obj (Opposite.op W)
          let D : Type u := ↑R_W
          let j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y₁ := hW.fromSpec
          letI : Algebra Ω₁ D := (AlgebraicGeometry.Spec.preimage (j_D ≫ p₁)).hom.toAlgebra
          have hj_comm : j_D ≫ p₁ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω₁ D)) :=
            (AlgebraicGeometry.Spec.map_preimage (j_D ≫ p₁)).symm
          have hRedD : _root_.IsReduced D := (hAllCharts D j_D inferInstance hj_comm).1
          haveI hRedSpec : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec R_W) :=
            (AlgebraicGeometry.affine_isReduced_iff R_W).mpr hRedD
          have hRedW : AlgebraicGeometry.IsReduced W.toScheme :=
            AlgebraicGeometry.isReduced_of_isOpenImmersion hW.isoSpec.hom
          have hRedStalkW : _root_.IsReduced ↑(W.toScheme.presheaf.stalk ⟨x, hxW⟩) :=
            @AlgebraicGeometry.isReduced_stalk_of_isReduced W.toScheme hRedW ⟨x, hxW⟩
          let eStalk := (W.stalkIso ⟨x, hxW⟩).commRingCatIsoToRingEquiv
          exact ⟨fun z hz => by
            have hz' : IsNilpotent (eStalk.symm z) := hz.map eStalk.symm
            have h0 : eStalk.symm z = 0 := hRedStalkW.eq_zero _ hz'
            exact eStalk.symm.injective (h0.trans (map_zero _).symm)⟩
        exact AlgebraicGeometry.isReduced_of_isReduced_stalk Y₁
      exact (hArtinIff Ω₁ Y₁ p₁).mpr ⟨hRedY₁, fun D _ _ j_D hj_open hj_comm =>
        (hAllCharts D j_D hj_open hj_comm).2⟩

theorem weil_algClosed_baseChange_connected_and_irreducibleComponents (Ω₁ Ω₂ : Type u) [Field Ω₁] [IsAlgClosed Ω₁] [Field Ω₂] [IsAlgClosed Ω₂]
    (φ : Ω₁ →+* Ω₂)
    (Y₁ : AlgebraicGeometry.Scheme.{u})
    (p₁ : Y₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω₁))
    [AlgebraicGeometry.QuasiCompact p₁]
    [AlgebraicGeometry.LocallyOfFiniteType p₁] :
    let f_φ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
    let Y₂ := CategoryTheory.Limits.pullback p₁ f_φ
    let p₂ := CategoryTheory.Limits.pullback.snd p₁ f_φ
    let π₁₂ := CategoryTheory.Limits.pullback.fst p₁ f_φ
    (ConnectedSpace ↥Y₁ ↔ ConnectedSpace ↥Y₂) ∧
    (∀ E₁ ∈ irreducibleComponents ↥Y₁,
      π₁₂.base ⁻¹' E₁ ∈ irreducibleComponents ↥Y₂ ∧
      π₁₂.base '' (π₁₂.base ⁻¹' E₁) = E₁ ∧
      ∃ (E₁_sch : AlgebraicGeometry.Scheme.{u}) (ιE₁ : E₁_sch ⟶ Y₁),
        AlgebraicGeometry.IsClosedImmersion ιE₁ ∧
        AlgebraicGeometry.IsIntegral E₁_sch ∧
        Set.range ιE₁.base = E₁ ∧
        AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback (ιE₁ ≫ p₁) f_φ) ∧
        (∀ (E'_sch : AlgebraicGeometry.Scheme.{u}) (ιE' : E'_sch ⟶ Y₁),
          AlgebraicGeometry.IsClosedImmersion ιE' →
          AlgebraicGeometry.IsIntegral E'_sch →
          Set.range ιE'.base = E₁ →
          ∃ e₁ : E'_sch ≅ E₁_sch, e₁.hom ≫ ιE₁ = ιE') ∧
        (∀ (E₂_sch : AlgebraicGeometry.Scheme.{u}) (ιE₂ : E₂_sch ⟶ Y₂),
          AlgebraicGeometry.IsClosedImmersion ιE₂ →
          AlgebraicGeometry.IsIntegral E₂_sch →
          Set.range ιE₂.base = π₁₂.base ⁻¹' E₁ →
          ∃ e₂ : E₂_sch ≅ CategoryTheory.Limits.pullback (ιE₁ ≫ p₁) f_φ,
            e₂.hom ≫ CategoryTheory.Limits.pullback.snd (ιE₁ ≫ p₁) f_φ = ιE₂ ≫ p₂)) ∧
    (∀ E₂ ∈ irreducibleComponents ↥Y₂,
      ∃ E₁ ∈ irreducibleComponents ↥Y₁, E₂ = π₁₂.base ⁻¹' E₁) ∧
    (∀ y₁ : ↥Y₁, IsClosed ({y₁} : Set ↥Y₁) →
      ∃! y₂ : ↥Y₂, π₁₂.base y₂ = y₁) :=
by
  intro f_φ Y₂ p₂ π₁₂
  let _ : Algebra Ω₁ Ω₂ := φ.toAlgebra

  
  have h_s1 :
      (∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra Ω₁ A],
        IsDomain (TensorProduct Ω₁ A Ω₂)) ∧
      (∀ (D : Type u) [CommRing D] [Algebra Ω₁ D] [Algebra.FiniteType Ω₁ D]
          (q₁ : PrimeSpectrum D),
        q₁.asIdeal.IsMaximal →
        ∃! q₂ : PrimeSpectrum (TensorProduct Ω₁ D Ω₂),
          PrimeSpectrum.comap Algebra.TensorProduct.includeLeftRingHom q₂ = q₁) := by
    have hNull : ∀ (R : Type u) [CommRing R] [Algebra Ω₁ R] [Algebra.FiniteType Ω₁ R]
        (𝔪 : Ideal R), 𝔪.IsMaximal →
        ∃ ε : R →ₐ[Ω₁] Ω₁, RingHom.ker ε.toRingHom = 𝔪 := by
      intro R _ _ hFT 𝔪 hMax
      have : 𝔪.IsMaximal := hMax
      let _ : Field (R ⧸ 𝔪) := Ideal.Quotient.field 𝔪
      obtain ⟨s, hs⟩ := hFT.out
      let π : MvPolynomial ↥s Ω₁ →ₐ[Ω₁] R := MvPolynomial.aeval Subtype.val
      have hπ_surj : Function.Surjective π := by
        intro r
        have hr : r ∈ π.range := by
          rw [MvPolynomial.aeval_range, Subtype.range_coe_subtype, Finset.setOfPred_mem, hs]
          trivial
        exact hr
      let 𝔪₀ : Ideal (MvPolynomial ↥s Ω₁) := Ideal.comap π.toRingHom 𝔪
      have : 𝔪₀.IsMaximal := Ideal.comap_isMaximal_of_surjective π.toRingHom hπ_surj
      obtain ⟨c, hc⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := 𝔪₀)).mp inferInstance
      have hBij : Function.Bijective (Algebra.ofId Ω₁ (R ⧸ 𝔪)) := by
        refine ⟨(algebraMap Ω₁ (R ⧸ 𝔪)).injective, fun y => ?_⟩
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
        obtain ⟨P, rfl⟩ := hπ_surj r
        refine ⟨MvPolynomial.aeval c P, ?_⟩
        have hQ_mem : P - MvPolynomial.C (MvPolynomial.aeval c P) ∈ 𝔪₀ := by
          rw [hc, MvPolynomial.mem_vanishingIdeal_iff]
          intro z hz
          rw [Set.mem_singleton_iff.mp hz, map_sub, MvPolynomial.aeval_C,
            Algebra.algebraMap_self, RingHom.id_apply, sub_self]
        have hπQ_mem : π P - algebraMap Ω₁ R (MvPolynomial.aeval c P) ∈ 𝔪 := by
          have h1 : π (P - MvPolynomial.C (MvPolynomial.aeval c P)) ∈ 𝔪 := hQ_mem
          rwa [map_sub, MvPolynomial.aeval_C] at h1
        have hQuot : Ideal.Quotient.mk 𝔪 (π P) =
            Ideal.Quotient.mk 𝔪 (algebraMap Ω₁ R (MvPolynomial.aeval c P)) :=
          Ideal.Quotient.eq.mpr hπQ_mem
        rw [Algebra.ofId_apply, IsScalarTower.algebraMap_apply Ω₁ R (R ⧸ 𝔪),
          Ideal.Quotient.algebraMap_eq, hQuot]
      let e : Ω₁ ≃ₐ[Ω₁] (R ⧸ 𝔪) := AlgEquiv.ofBijective (Algebra.ofId Ω₁ (R ⧸ 𝔪)) hBij
      let ε : R →ₐ[Ω₁] Ω₁ := e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ Ω₁ 𝔪)
      refine ⟨ε, ?_⟩
      ext r
      change e.symm (Ideal.Quotient.mk 𝔪 r) = 0 ↔ r ∈ 𝔪
      rw [← map_zero e.symm, e.symm.injective.eq_iff, Ideal.Quotient.eq_zero_iff_mem]
    refine ⟨?_, ?_⟩
    · intro A _ _ _
      have hDom_swap : IsDomain (TensorProduct Ω₁ Ω₂ A) := by
        let b := Module.Basis.ofVectorSpace Ω₁ A
        let b₂ := b.baseChange Ω₂
        have hIdx_ne : Nonempty (Module.Basis.ofVectorSpaceIndex Ω₁ A) := by
          by_contra hEmpty
          rw [not_nonempty_iff] at hEmpty
          have h0 : b.repr (1 : A) = 0 := Subsingleton.elim _ _
          have h1 : (1 : A) = 0 := by
            calc (1 : A) = (Finsupp.linearCombination Ω₁ ⇑b) (b.repr 1) :=
                  (b.linearCombination_repr 1).symm
              _ = 0 := by rw [h0, map_zero]
          exact one_ne_zero h1
        obtain ⟨i₁⟩ := hIdx_ne
        have : Nontrivial (TensorProduct Ω₁ Ω₂ A) := ⟨⟨b₂ i₁, 0, b₂.ne_zero i₁⟩⟩
        have : NoZeroDivisors (TensorProduct Ω₁ Ω₂ A) := by
          refine ⟨fun {ξ η} hprod => ?_⟩
          by_contra hne
          rw [not_or] at hne
          obtain ⟨hξ, hη⟩ := hne
          have hξ_repr : b₂.repr ξ ≠ 0 :=
            fun h => hξ (b₂.repr.injective (h.trans (map_zero _).symm))
          have hη_repr : b₂.repr η ≠ 0 :=
            fun h => hη (b₂.repr.injective (h.trans (map_zero _).symm))
          obtain ⟨i₀, hr₀⟩ := Finsupp.ne_iff.mp hξ_repr
          obtain ⟨j₀, hs₀⟩ := Finsupp.ne_iff.mp hη_repr
          let r₀ : Ω₂ := b₂.repr ξ i₀
          let s₀ : Ω₂ := b₂.repr η j₀
          let u₀ : Ω₂ := (r₀ * s₀)⁻¹
          have hr₀s₀ : r₀ * s₀ * u₀ = 1 := mul_inv_cancel₀ (mul_ne_zero hr₀ hs₀)
          classical
          let F : Finset Ω₂ :=
            (b₂.repr ξ).support.image (b₂.repr ξ) ∪
            (b₂.repr η).support.image (b₂.repr η) ∪ {u₀}
          let R₀ : Subalgebra Ω₁ Ω₂ := Algebra.adjoin Ω₁ (↑F : Set Ω₂)
          have : Algebra.FiniteType Ω₁ ↥R₀ :=
            ⟨(Subalgebra.fg_top R₀).mpr (Subalgebra.fg_adjoin_finset F)⟩
          obtain ⟨𝔪, h𝔪⟩ := Ideal.exists_maximal ↥R₀
          obtain ⟨ψ, _⟩ := hNull ↥R₀ 𝔪 h𝔪
          have hξ_mem : ∀ i ∈ (b₂.repr ξ).support, b₂.repr ξ i ∈ R₀ := fun i hi =>
            Algebra.subset_adjoin (Finset.mem_coe.mpr
              (Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hi))))
          have hη_mem : ∀ j ∈ (b₂.repr η).support, b₂.repr η j ∈ R₀ := fun j hj =>
            Algebra.subset_adjoin (Finset.mem_coe.mpr
              (Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hj))))
          have hu₀_mem : u₀ ∈ R₀ :=
            Algebra.subset_adjoin (Finset.mem_coe.mpr
              (Finset.mem_union_right _ (Finset.mem_singleton_self u₀)))
          have hi₀_supp : i₀ ∈ (b₂.repr ξ).support := Finsupp.mem_support_iff.mpr hr₀
          have hj₀_supp : j₀ ∈ (b₂.repr η).support := Finsupp.mem_support_iff.mpr hs₀
          have hunit_R₀ :
              (⟨r₀, hξ_mem i₀ hi₀_supp⟩ : ↥R₀) * ⟨s₀, hη_mem j₀ hj₀_supp⟩ * ⟨u₀, hu₀_mem⟩ = 1 :=
            Subtype.ext hr₀s₀
          have hψ_unit :
              ψ ⟨r₀, hξ_mem i₀ hi₀_supp⟩ * ψ ⟨s₀, hη_mem j₀ hj₀_supp⟩ * ψ ⟨u₀, hu₀_mem⟩ = 1 := by
            simpa only [map_mul, map_one] using congrArg ψ hunit_R₀
          have hψr₀ : ψ ⟨r₀, hξ_mem i₀ hi₀_supp⟩ ≠ 0 := by
            intro h0
            rw [h0, zero_mul, zero_mul] at hψ_unit
            exact zero_ne_one hψ_unit
          have hψs₀ : ψ ⟨s₀, hη_mem j₀ hj₀_supp⟩ ≠ 0 := by
            intro h0
            rw [h0, mul_zero, zero_mul] at hψ_unit
            exact zero_ne_one hψ_unit
          let ξ_lift : TensorProduct Ω₁ ↥R₀ A :=
            ∑ x ∈ (b₂.repr ξ).support.attach,
              (⟨b₂.repr ξ x.1, hξ_mem x.1 x.2⟩ : ↥R₀) ⊗ₜ[Ω₁] b x.1
          let η_lift : TensorProduct Ω₁ ↥R₀ A :=
            ∑ y ∈ (b₂.repr η).support.attach,
              (⟨b₂.repr η y.1, hη_mem y.1 y.2⟩ : ↥R₀) ⊗ₜ[Ω₁] b y.1
          let ι_R₀ : TensorProduct Ω₁ ↥R₀ A →ₐ[Ω₁] TensorProduct Ω₁ Ω₂ A :=
            Algebra.TensorProduct.map R₀.val (AlgHom.id Ω₁ A)
          have hι_ξ : ι_R₀ ξ_lift = ξ := by
            calc ι_R₀ ξ_lift
                = ∑ x ∈ (b₂.repr ξ).support.attach, (b₂.repr ξ x.1) ⊗ₜ[Ω₁] b x.1 := by
                    simp [ξ_lift, ι_R₀, map_sum]
              _ = ∑ i ∈ (b₂.repr ξ).support, (b₂.repr ξ i) ⊗ₜ[Ω₁] b i :=
                    Finset.sum_attach (b₂.repr ξ).support (fun i => (b₂.repr ξ i) ⊗ₜ[Ω₁] b i)
              _ = ∑ i ∈ (b₂.repr ξ).support, (b₂.repr ξ i) • b₂ i := by
                    refine Finset.sum_congr rfl fun i _ => ?_
                    dsimp only [b₂]
                    rw [Module.Basis.baseChange_apply, TensorProduct.smul_tmul',
                      smul_eq_mul, mul_one]
              _ = (Finsupp.linearCombination Ω₂ ⇑b₂) (b₂.repr ξ) := by
                    rw [Finsupp.linearCombination_apply, Finsupp.sum]
              _ = ξ := b₂.linearCombination_repr ξ
          have hι_η : ι_R₀ η_lift = η := by
            calc ι_R₀ η_lift
                = ∑ y ∈ (b₂.repr η).support.attach, (b₂.repr η y.1) ⊗ₜ[Ω₁] b y.1 := by
                    simp [η_lift, ι_R₀, map_sum]
              _ = ∑ j ∈ (b₂.repr η).support, (b₂.repr η j) ⊗ₜ[Ω₁] b j :=
                    Finset.sum_attach (b₂.repr η).support (fun j => (b₂.repr η j) ⊗ₜ[Ω₁] b j)
              _ = ∑ j ∈ (b₂.repr η).support, (b₂.repr η j) • b₂ j := by
                    refine Finset.sum_congr rfl fun j _ => ?_
                    dsimp only [b₂]
                    rw [Module.Basis.baseChange_apply, TensorProduct.smul_tmul',
                      smul_eq_mul, mul_one]
              _ = (Finsupp.linearCombination Ω₂ ⇑b₂) (b₂.repr η) := by
                    rw [Finsupp.linearCombination_apply, Finsupp.sum]
              _ = η := b₂.linearCombination_repr η
          have hι_eq_rTensor : (ι_R₀ : TensorProduct Ω₁ ↥R₀ A →ₗ[Ω₁] TensorProduct Ω₁ Ω₂ A) =
              LinearMap.rTensor A R₀.val.toLinearMap := by
            ext r a
            rfl
          have hι_inj : Function.Injective ι_R₀ := by
            change Function.Injective ⇑(ι_R₀ : TensorProduct Ω₁ ↥R₀ A →ₗ[Ω₁] TensorProduct Ω₁ Ω₂ A)
            rw [hι_eq_rTensor]
            exact Module.Flat.rTensor_preserves_injective_linearMap
              R₀.val.toLinearMap Subtype.val_injective
          have h_lift_prod : ξ_lift * η_lift = 0 := by
            apply hι_inj
            rw [map_mul, hι_ξ, hι_η, hprod, map_zero]
          let Ψ : TensorProduct Ω₁ ↥R₀ A →ₐ[Ω₁] A :=
            (Algebra.TensorProduct.lid Ω₁ A).toAlgHom.comp
              (Algebra.TensorProduct.map ψ (AlgHom.id Ω₁ A))
          have hΨ_tmul : ∀ (r : ↥R₀) (a : A), Ψ (r ⊗ₜ[Ω₁] a) = ψ r • a := fun _ _ => rfl
          have hΨ_prod : Ψ ξ_lift * Ψ η_lift = 0 := by
            rw [← map_mul, h_lift_prod, map_zero]
          let coord : (Module.Basis.ofVectorSpaceIndex Ω₁ A) → (A →ₗ[Ω₁] Ω₁) :=
            fun k => (Finsupp.lapply k).comp b.repr.toLinearMap
          have hcoord_ξ : coord i₀ (Ψ ξ_lift) = ψ ⟨r₀, hξ_mem i₀ hi₀_supp⟩ := by
            simp only [ξ_lift, map_sum, hΨ_tmul, map_smul, coord, LinearMap.comp_apply,
              LinearEquiv.coe_toLinearMap, Module.Basis.repr_self, Finsupp.lapply_apply,
              smul_eq_mul, Finsupp.single_apply, mul_ite, mul_one, mul_zero]
            rw [Finset.sum_eq_single ⟨i₀, hi₀_supp⟩]
            · simp [r₀]
            · intro x _ hx
              have hne_i : x.1 ≠ i₀ := fun h => hx (Subtype.ext h)
              simp [hne_i]
            · intro hnot
              exact False.elim (hnot (Finset.mem_attach _ ⟨i₀, hi₀_supp⟩))
          have hcoord_η : coord j₀ (Ψ η_lift) = ψ ⟨s₀, hη_mem j₀ hj₀_supp⟩ := by
            simp only [η_lift, map_sum, hΨ_tmul, map_smul, coord, LinearMap.comp_apply,
              LinearEquiv.coe_toLinearMap, Module.Basis.repr_self, Finsupp.lapply_apply,
              smul_eq_mul, Finsupp.single_apply, mul_ite, mul_one, mul_zero]
            rw [Finset.sum_eq_single ⟨j₀, hj₀_supp⟩]
            · simp [s₀]
            · intro y _ hy
              have hne_j : y.1 ≠ j₀ := fun h => hy (Subtype.ext h)
              simp [hne_j]
            · intro hnot
              exact False.elim (hnot (Finset.mem_attach _ ⟨j₀, hj₀_supp⟩))
          have hΨξ_ne : Ψ ξ_lift ≠ 0 := fun h0 => by
            rw [h0, map_zero] at hcoord_ξ
            exact hψr₀ hcoord_ξ.symm
          have hΨη_ne : Ψ η_lift ≠ 0 := fun h0 => by
            rw [h0, map_zero] at hcoord_η
            exact hψs₀ hcoord_η.symm
          rcases mul_eq_zero.mp hΨ_prod with h0 | h0
          · exact hΨξ_ne h0
          · exact hΨη_ne h0
        exact IsDomain.mk
      let e_comm : TensorProduct Ω₁ A Ω₂ ≃+* TensorProduct Ω₁ Ω₂ A :=
        (Algebra.TensorProduct.comm Ω₁ A Ω₂).toRingEquiv
      have : Nontrivial (TensorProduct Ω₁ A Ω₂) := e_comm.toEquiv.nontrivial
      have : NoZeroDivisors (TensorProduct Ω₁ A Ω₂) :=
        ⟨fun {x y} hxy => by
          have h0 : e_comm x * e_comm y = 0 := by rw [← map_mul, hxy, map_zero]
          rcases mul_eq_zero.mp h0 with hx | hy
          · exact Or.inl (e_comm.injective (hx.trans (map_zero _).symm))
          · exact Or.inr (e_comm.injective (hy.trans (map_zero _).symm))⟩
      exact IsDomain.mk
    · intro D _ _ _ q₁ hq₁
      obtain ⟨ε, hker_ε⟩ := hNull D q₁.asIdeal hq₁
      let ε₂ : TensorProduct Ω₁ D Ω₂ →ₐ[Ω₁] Ω₂ :=
        (Algebra.TensorProduct.lid Ω₁ Ω₂).toAlgHom.comp
          (Algebra.TensorProduct.map ε (AlgHom.id Ω₁ Ω₂))
      have hε₂_tmul : ∀ (d : D) (c : Ω₂),
          ε₂ (d ⊗ₜ[Ω₁] c) = algebraMap Ω₁ Ω₂ (ε d) * c := fun d c => by
        change (ε d) • c = algebraMap Ω₁ Ω₂ (ε d) * c
        rw [Algebra.smul_def]
      let 𝔐₂ : Ideal (TensorProduct Ω₁ D Ω₂) := RingHom.ker ε₂.toRingHom
      have h𝔐₂_max : 𝔐₂.IsMaximal := by
        rw [Ideal.isMaximal_iff]
        refine ⟨?_, fun J x hle hx_not hxJ => ?_⟩
        · change ε₂ 1 ≠ 0
          rw [map_one]
          exact one_ne_zero
        · have hx_ne : ε₂ x ≠ 0 := hx_not
          let y : TensorProduct Ω₁ D Ω₂ := 1 - x * (1 ⊗ₜ[Ω₁] (ε₂ x)⁻¹)
          have hy_mem : y ∈ 𝔐₂ := by
            change ε₂ y = 0
            simp only [y, map_sub, map_one, map_mul, hε₂_tmul, one_mul, mul_inv_cancel₀ hx_ne,
              sub_self]
          have h1 : y + x * (1 ⊗ₜ[Ω₁] (ε₂ x)⁻¹) ∈ J :=
            add_mem (hle hy_mem) (Ideal.mul_mem_right _ J hxJ)
          simpa [y] using h1
      let q₂ : PrimeSpectrum (TensorProduct Ω₁ D Ω₂) := ⟨𝔐₂, h𝔐₂_max.isPrime⟩
      have hq₂_comap : PrimeSpectrum.comap Algebra.TensorProduct.includeLeftRingHom q₂ = q₁ := by
        ext d
        change ε₂ (d ⊗ₜ[Ω₁] 1) = 0 ↔ d ∈ q₁.asIdeal
        rw [hε₂_tmul, mul_one, map_eq_zero_iff _ (algebraMap Ω₁ Ω₂).injective]
        exact SetLike.ext_iff.mp hker_ε d
      refine ⟨q₂, hq₂_comap, fun P hP => ?_⟩
      have hP_iff : ∀ d : D, d ⊗ₜ[Ω₁] (1 : Ω₂) ∈ P.asIdeal ↔ d ∈ q₁.asIdeal := fun d => by
        have := PrimeSpectrum.ext_iff.mp hP
        exact SetLike.ext_iff.mp this d
      have h_diff_mem : ∀ ξ : TensorProduct Ω₁ D Ω₂, ξ - 1 ⊗ₜ[Ω₁] (ε₂ ξ) ∈ P.asIdeal := by
        intro ξ
        induction ξ using TensorProduct.induction_on with
        | zero =>
          simp only [map_zero, TensorProduct.tmul_zero, sub_zero, zero_mem]
        | tmul d c =>
          let d' : D := d - algebraMap Ω₁ D (ε d)
          have hd'_ker : d' ∈ q₁.asIdeal := by
            have hmem : ε d' = 0 := by
              simp only [d', map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply,
                sub_self]
            exact (SetLike.ext_iff.mp hker_ε d').mp hmem
          have hd'_P : d' ⊗ₜ[Ω₁] (1 : Ω₂) ∈ P.asIdeal := (hP_iff d').mpr hd'_ker
          have hprod_P : (d' ⊗ₜ[Ω₁] (1 : Ω₂)) * (1 ⊗ₜ[Ω₁] c) ∈ P.asIdeal :=
            Ideal.mul_mem_right _ P.asIdeal hd'_P
          have h_eq : (d' ⊗ₜ[Ω₁] (1 : Ω₂)) * (1 ⊗ₜ[Ω₁] c) =
              d ⊗ₜ[Ω₁] c - 1 ⊗ₜ[Ω₁] ε₂ (d ⊗ₜ[Ω₁] c) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, hε₂_tmul]
            simp only [d', TensorProduct.sub_tmul]
            congr 1
            rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, Algebra.smul_def]
          rwa [← h_eq]
        | add x y hx hy =>
          have h_add : (x + y) - 1 ⊗ₜ[Ω₁] ε₂ (x + y) =
              (x - 1 ⊗ₜ[Ω₁] ε₂ x) + (y - 1 ⊗ₜ[Ω₁] ε₂ y) := by
            rw [map_add, TensorProduct.tmul_add]
            abel
          rw [h_add]
          exact add_mem hx hy
      have h_le : 𝔐₂ ≤ P.asIdeal := by
        intro ξ hξ
        have hξ0 : ε₂ ξ = 0 := hξ
        have hmem := h_diff_mem ξ
        rwa [hξ0, TensorProduct.tmul_zero, sub_zero] at hmem
      exact PrimeSpectrum.ext (h𝔐₂_max.eq_of_le P.isPrime.ne_top h_le).symm

  
  have h_s2 : ∀ (X : Scheme.{u}) (Z : Set ↥X), IsClosed Z →
      (∃ (Z_sch : Scheme.{u}) (ιZ : Z_sch ⟶ X),
        IsClosedImmersion ιZ ∧
        IsReduced Z_sch ∧
        Set.range ιZ.base = Z ∧
        ∀ (Z'_sch : Scheme.{u}) (ιZ' : Z'_sch ⟶ X),
          IsClosedImmersion ιZ' →
          IsReduced Z'_sch →
          Set.range ιZ'.base = Z →
          ∃ e : Z'_sch ≅ Z_sch, e.hom ≫ ιZ = ιZ') ∧
      (IsIrreducible Z →
        ∀ (Z_sch : Scheme.{u}) (ιZ : Z_sch ⟶ X),
          IsClosedImmersion ιZ →
          IsReduced Z_sch →
          Set.range ιZ.base = Z →
          IsIntegral Z_sch) := by
    intro X Z hZ
    refine ⟨?_, ?_⟩
    · let Z_cl : TopologicalSpace.Closeds ↥X := ⟨Z, hZ⟩
      let I_Z : X.IdealSheafData := Scheme.IdealSheafData.vanishingIdeal Z_cl
      let Z_sch : Scheme.{u} := I_Z.subscheme
      let ιZ : Z_sch ⟶ X := I_Z.subschemeι
      have hRange : Set.range ιZ.base = Z := by
        rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
        rfl
      have hRed : IsReduced Z_sch := by
        let V : ↑X.affineOpens → Z_sch.Opens := fun U => ιZ ⁻¹ᵁ U.1
        have hCov : TopologicalSpace.IsOpenCover V := by
          apply TopologicalSpace.IsOpenCover.mk
          rw [eq_top_iff]
          intro z _
          rw [TopologicalSpace.Opens.mem_iSup]
          obtain ⟨U, hU, hzU, _⟩ :=
            exists_isAffineOpen_mem_and_subset (show ιZ.base z ∈ (⊤ : X.Opens) from trivial)
          exact ⟨⟨U, hU⟩, hzU⟩
        have hRedV : ∀ (U : ↑X.affineOpens), IsReduced (V U).toScheme := by
          intro U
          have : IsAffine (V U).toScheme := U.2.preimage ιZ
          have hRad : (I_Z.ideal U).IsRadical := by
            rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
            exact PrimeSpectrum.isRadical_vanishingIdeal _
          have : _root_.IsReduced (↑Γ(X, U.1) ⧸ I_Z.ideal U) :=
            (Ideal.isRadical_iff_quotient_reduced (I_Z.ideal U)).mp hRad
          let e_sec := ((V U).topIso ≪≫ I_Z.subschemeObjIso U).commRingCatIsoToRingEquiv
          have : _root_.IsReduced ↑Γ((V U).toScheme, ⊤) := by
            refine ⟨fun f hf => ?_⟩
            rcases hf with ⟨n, hfn⟩
            apply e_sec.injective
            rw [map_zero]
            exact IsNilpotent.eq_zero ⟨n, by rw [← map_pow, hfn, map_zero]⟩
          exact isReduced_of_isAffine_isReduced (V U).toScheme
        let 𝒰 := Z_sch.openCoverOfIsOpenCover V hCov
        have : ∀ (i : 𝒰.I₀), IsReduced (𝒰.X i) := fun i => hRedV i
        exact IsReduced.of_openCover Z_sch 𝒰
      refine ⟨Z_sch, ιZ, inferInstance, hRed, hRange, ?_⟩
      intro Z'_sch ιZ' hCl' hRed' hRange'
      have : IsClosedImmersion ιZ' := hCl'
      have : IsReduced Z'_sch := hRed'
      have hSupp : (Scheme.Hom.ker ιZ').support = Z_cl := by
        apply SetLike.ext'
        rw [Scheme.Hom.support_ker, hRange', hZ.closure_eq]
        rfl
      have hVanEq : I_Z = (Scheme.Hom.ker ιZ').radical := by
        change Scheme.IdealSheafData.vanishingIdeal Z_cl = (Scheme.Hom.ker ιZ').radical
        rw [← hSupp, Scheme.IdealSheafData.vanishingIdeal_support]
      have hRadEq : (Scheme.Hom.ker ιZ').radical = Scheme.Hom.ker ιZ' := by
        apply Scheme.IdealSheafData.ext
        ext U f
        rw [Scheme.IdealSheafData.radical_ideal]
        refine ⟨fun ⟨n, hfn⟩ => ?_, fun hf => Ideal.le_radical hf⟩
        rw [Scheme.Hom.ker_apply, RingHom.mem_ker] at hfn ⊢
        have : _root_.IsReduced ↑Γ(Z'_sch, ιZ' ⁻¹ᵁ ↑U) := IsReduced.component_reduced _
        exact IsNilpotent.eq_zero ⟨n, by rw [← map_pow, hfn]⟩
      have hKerEq : Scheme.Hom.ker ιZ = Scheme.Hom.ker ιZ' := by
        rw [Scheme.IdealSheafData.ker_subschemeι, hVanEq, hRadEq]
      let f_lift : Z'_sch ⟶ Z_sch := IsClosedImmersion.lift ιZ ιZ' (le_of_eq hKerEq)
      have : IsIso f_lift := IsClosedImmersion.isIso_lift ιZ ιZ' hKerEq
      exact ⟨asIso f_lift, IsClosedImmersion.lift_fac ιZ ιZ' (le_of_eq hKerEq)⟩
    · intro hIrred Z_sch ιZ hCl hRed hRange
      have : IsClosedImmersion ιZ := hCl
      have : IsReduced Z_sch := hRed
      have hEmb := IsClosedImmersion.isClosedEmbedding ιZ
      obtain ⟨x₀, hx₀⟩ := hIrred.nonempty
      rw [← hRange] at hx₀
      obtain ⟨z₀, _⟩ := hx₀
      have hPre : IsPreirreducible (Set.univ : Set ↥Z_sch) := by
        intro U V hU hV ⟨u, _, hu⟩ ⟨v, _, hv⟩
        obtain ⟨U', hU', rfl⟩ := hEmb.isInducing.isOpen_iff.mp hU
        obtain ⟨V', hV', rfl⟩ := hEmb.isInducing.isOpen_iff.mp hV
        have huZ : ιZ.base u ∈ Z ∩ U' := ⟨hRange ▸ Set.mem_range_self u, hu⟩
        have hvZ : ιZ.base v ∈ Z ∩ V' := ⟨hRange ▸ Set.mem_range_self v, hv⟩
        obtain ⟨w, hwZ, hwU', hwV'⟩ :=
          hIrred.isPreirreducible U' V' hU' hV' ⟨_, huZ⟩ ⟨_, hvZ⟩
        rw [← hRange] at hwZ
        obtain ⟨z, rfl⟩ := hwZ
        exact ⟨z, trivial, hwU', hwV'⟩
      have : IrreducibleSpace ↥Z_sch :=
        { isPreirreducible_univ := hPre, toNonempty := ⟨z₀⟩ }
      exact isIntegral_of_irreducibleSpace_of_isReduced Z_sch

  
  obtain ⟨hDom, hMaxUniq⟩ := h_s1
  have hSpecΩ₁_sub : ∀ (a b : ↥(Spec (CommRingCat.of Ω₁))), a = b := by
    intro a b
    have hbot : ∀ p : PrimeSpectrum Ω₁, p.asIdeal = ⊥ := by
      intro p
      refine le_antisymm (fun x hx => ?_) bot_le
      by_contra hx0
      exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem p.asIdeal hx (IsUnit.mk0 x hx0))
    exact PrimeSpectrum.ext ((hbot a).trans (hbot b).symm)
  have hSurj_all : ∀ (Z₁ : Scheme.{u}) (q₁ : Z₁ ⟶ Spec (CommRingCat.of Ω₁)),
      Function.Surjective (Limits.pullback.fst q₁ f_φ).base := by
    intro Z₁ q₁ z₁
    obtain ⟨pt₂⟩ :=
      (irreducibleSpace_of_isIntegral (Spec (CommRingCat.of Ω₂))).toNonempty
    obtain ⟨z₂, hz₂, _⟩ :=
      Scheme.Pullback.exists_preimage_pullback z₁ pt₂ (hSpecΩ₁_sub _ _)
    exact ⟨z₂, hz₂⟩
  have hChart : ∀ (W₁ : Scheme.{u}) (r₁ : W₁ ⟶ Spec (CommRingCat.of Ω₁))
      (U : W₁.Opens) (hU : IsAffineOpen U),
      let W₂ := Limits.pullback r₁ f_φ
      let π_W := Limits.pullback.fst r₁ f_φ
      let U₂ : W₂.Opens := π_W ⁻¹ᵁ U
      let α_U := Spec.preimage (hU.fromSpec ≫ r₁)
      letI : Algebra Ω₁ ↑Γ(W₁, U) := α_U.hom.toAlgebra
      ∃ (π_U : U₂.toScheme ⟶ Spec Γ(W₁, U))
        (θ_U : U₂.toScheme ≅ Spec (CommRingCat.of (TensorProduct Ω₁ (↑Γ(W₁, U)) Ω₂))),
        π_U ≫ hU.fromSpec = U₂.ι ≫ π_W ∧
        θ_U.hom ≫ Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := Ω₁))) = π_U := by
    intro W₁ r₁ U hU W₂ π_W U₂ α_U
    let _ : Algebra Ω₁ ↑Γ(W₁, U) := α_U.hom.toAlgebra
    let r₂ := Limits.pullback.snd r₁ f_φ
    have hRange_sub : Set.range (U₂.ι ≫ π_W).base ⊆ Set.range hU.fromSpec.base := by
      rw [hU.range_fromSpec]
      rintro _ ⟨x, rfl⟩
      exact x.2
    let π_U : U₂.toScheme ⟶ Spec Γ(W₁, U) :=
      IsOpenImmersion.lift hU.fromSpec (U₂.ι ≫ π_W) hRange_sub
    have hπ_U_fac : π_U ≫ hU.fromSpec = U₂.ι ≫ π_W :=
      IsOpenImmersion.lift_fac hU.fromSpec (U₂.ι ≫ π_W) hRange_sub
    have hOpens_eq : π_W ⁻¹ᵁ Scheme.Hom.opensRange hU.fromSpec = Scheme.Hom.opensRange U₂.ι := by
      rw [hU.opensRange_fromSpec, U₂.opensRange_ι]
    have hPb_top : IsPullback π_U U₂.ι hU.fromSpec π_W :=
      IsOpenImmersion.isPullback π_U U₂.ι hU.fromSpec π_W hπ_U_fac.symm hOpens_eq
    have hPb_paste : IsPullback π_U (U₂.ι ≫ r₂) (hU.fromSpec ≫ r₁) f_φ :=
      (hPb_top.flip.paste_horiz (IsPullback.of_hasPullback r₁ f_φ).flip).flip
    have hSpec_α : Spec.map (CommRingCat.ofHom (algebraMap Ω₁ ↑Γ(W₁, U))) = hU.fromSpec ≫ r₁ :=
      Spec.map_preimage (hU.fromSpec ≫ r₁)
    have hPb_spec : IsPullback π_U (U₂.ι ≫ r₂)
        (Spec.map (CommRingCat.ofHom (algebraMap Ω₁ ↑Γ(W₁, U)))) f_φ := by
      rwa [hSpec_α]
    let θ_U : U₂.toScheme ≅ Spec (CommRingCat.of (TensorProduct Ω₁ (↑Γ(W₁, U)) Ω₂)) :=
      hPb_spec.isoPullback ≪≫ pullbackSpecIso Ω₁ (↑Γ(W₁, U)) Ω₂
    refine ⟨π_U, θ_U, hπ_U_fac, ?_⟩
    change (hPb_spec.isoPullback.hom ≫ (pullbackSpecIso Ω₁ (↑Γ(W₁, U)) Ω₂).hom) ≫ _ = π_U
    rw [Category.assoc, pullbackSpecIso_hom_fst]
    exact hPb_spec.isoPullback_hom_fst
  have hIntPb : ∀ (Z₁ : Scheme.{u}) (q₁ : Z₁ ⟶ Spec (CommRingCat.of Ω₁)),
      IsIntegral Z₁ → IsIntegral (Limits.pullback q₁ f_φ) := by
    intro Z₁ q₁ hIntZ₁
    let Z₂ := Limits.pullback q₁ f_φ
    let π_Z := Limits.pullback.fst q₁ f_φ
    have hIrredZ₁ : IrreducibleSpace ↥Z₁ := irreducibleSpace_of_isIntegral Z₁
    have hChartPkg : ∀ (U : Z₁.Opens) (hU : IsAffineOpen U), (U : Set ↥Z₁).Nonempty →
        IsReduced (π_Z ⁻¹ᵁ U).toScheme ∧
        IsIrreducible ((π_Z ⁻¹ᵁ U : Z₂.Opens) : Set ↥Z₂) := by
      intro U hU ⟨x₀, hx₀⟩
      have : IsDomain ↑Γ(Z₁, U) := @IsIntegral.component_integral Z₁ hIntZ₁ U ⟨⟨x₀, hx₀⟩⟩
      obtain ⟨π_U, θ_U, _, _⟩ := hChart Z₁ q₁ U hU
      let α_U := Spec.preimage (hU.fromSpec ≫ q₁)
      let _ : Algebra Ω₁ ↑Γ(Z₁, U) := α_U.hom.toAlgebra
      have : IsDomain (TensorProduct Ω₁ (↑Γ(Z₁, U)) Ω₂) := hDom (↑Γ(Z₁, U))
      let S_spec := Spec (CommRingCat.of (TensorProduct Ω₁ (↑Γ(Z₁, U)) Ω₂))
      have : IsIntegral S_spec := inferInstance
      have : IsReduced S_spec := isReduced_of_isIntegral S_spec
      have : IrreducibleSpace ↥S_spec := irreducibleSpace_of_isIntegral S_spec
      have hRedU₂ : IsReduced (π_Z ⁻¹ᵁ U).toScheme := isReduced_of_isOpenImmersion θ_U.hom
      have hImg : (θ_U.inv ≫ (π_Z ⁻¹ᵁ U).ι).base '' (Set.univ : Set ↥S_spec) =
          ((π_Z ⁻¹ᵁ U : Z₂.Opens) : Set ↥Z₂) := by
        ext z
        simp only [Set.mem_image, Set.mem_univ, true_and]
        constructor
        · rintro ⟨s, rfl⟩
          have hz_range : ((θ_U.inv ≫ (π_Z ⁻¹ᵁ U).ι).base s) ∈ Set.range (π_Z ⁻¹ᵁ U).ι.base :=
            ⟨θ_U.inv.base s, rfl⟩
          rwa [Scheme.Opens.range_ι] at hz_range
        · intro hz
          refine ⟨θ_U.hom.base ⟨z, hz⟩, ?_⟩
          change (π_Z ⁻¹ᵁ U).ι.base ((θ_U.hom ≫ θ_U.inv).base ⟨z, hz⟩) = z
          rw [θ_U.hom_inv_id]
          rfl
      have hIrredU₂ : IsIrreducible ((π_Z ⁻¹ᵁ U : Z₂.Opens) : Set ↥Z₂) := by
        rw [← hImg]
        exact (IrreducibleSpace.isIrreducible_univ ↥S_spec).image _
          (θ_U.inv ≫ (π_Z ⁻¹ᵁ U).ι).continuous.continuousOn
      exact ⟨hRedU₂, hIrredU₂⟩
    have hRedZ₂ : IsReduced Z₂ := by
      have hPerPt : ∀ z₂ : ↥Z₂, ∃ U : Z₁.Opens, IsAffineOpen U ∧ π_Z.base z₂ ∈ U := fun z₂ => by
        obtain ⟨U, hU, hzU, _⟩ :=
          exists_isAffineOpen_mem_and_subset (show π_Z.base z₂ ∈ (⊤ : Z₁.Opens) from trivial)
        exact ⟨U, hU, hzU⟩
      choose U_pt hU_pt hz_pt using hPerPt
      let V₂ : ↥Z₂ → Z₂.Opens := fun z₂ => π_Z ⁻¹ᵁ (U_pt z₂)
      have hCov₂ : TopologicalSpace.IsOpenCover V₂ := by
        apply TopologicalSpace.IsOpenCover.mk
        rw [eq_top_iff]
        intro z₂ _
        rw [TopologicalSpace.Opens.mem_iSup]
        exact ⟨z₂, hz_pt z₂⟩
      let 𝒰₂ := Z₂.openCoverOfIsOpenCover V₂ hCov₂
      have : ∀ (z₂ : 𝒰₂.I₀), IsReduced (𝒰₂.X z₂) := fun z₂ =>
        (hChartPkg (U_pt z₂) (hU_pt z₂) ⟨π_Z.base z₂, hz_pt z₂⟩).1
      exact IsReduced.of_openCover Z₂ 𝒰₂
    obtain ⟨z₁₀⟩ := hIrredZ₁.toNonempty
    obtain ⟨z₂₀, _⟩ := hSurj_all Z₁ q₁ z₁₀
    have hPreZ₂ : IsPreirreducible (Set.univ : Set ↥Z₂) := by
      intro W_a W_b hWa hWb ⟨wa, _, hwa⟩ ⟨wb, _, hwb⟩
      obtain ⟨U_a, hUa, hwa_Ua, _⟩ :=
        exists_isAffineOpen_mem_and_subset (show π_Z.base wa ∈ (⊤ : Z₁.Opens) from trivial)
      obtain ⟨U_b, hUb, hwb_Ub, _⟩ :=
        exists_isAffineOpen_mem_and_subset (show π_Z.base wb ∈ (⊤ : Z₁.Opens) from trivial)
      obtain ⟨_, hIrredUa₂⟩ := hChartPkg U_a hUa ⟨π_Z.base wa, hwa_Ua⟩
      obtain ⟨_, hIrredUb₂⟩ := hChartPkg U_b hUb ⟨π_Z.base wb, hwb_Ub⟩
      obtain ⟨x_ab, _, hx_Ua, hx_Ub⟩ :=
        hIrredZ₁.isPreirreducible_univ U_a U_b U_a.isOpen U_b.isOpen
          ⟨π_Z.base wa, trivial, hwa_Ua⟩ ⟨π_Z.base wb, trivial, hwb_Ub⟩
      obtain ⟨z_ab, hz_ab⟩ := hSurj_all Z₁ q₁ x_ab
      have hz_Ua₂ : z_ab ∈ (π_Z ⁻¹ᵁ U_a : Set ↥Z₂) := by change π_Z.base z_ab ∈ U_a; rwa [hz_ab]
      have hz_Ub₂ : z_ab ∈ (π_Z ⁻¹ᵁ U_b : Set ↥Z₂) := by change π_Z.base z_ab ∈ U_b; rwa [hz_ab]
      obtain ⟨u₁, hu₁_Ua₂, hu₁_Wa, hu₁_Ub₂⟩ :=
        hIrredUa₂.isPreirreducible W_a (π_Z ⁻¹ᵁ U_b) hWa (π_Z ⁻¹ᵁ U_b).isOpen
          ⟨wa, hwa_Ua, hwa⟩ ⟨z_ab, hz_Ua₂, hz_Ub₂⟩
      obtain ⟨u₂, _, ⟨hu₂_Wa, _⟩, hu₂_Wb⟩ :=
        hIrredUb₂.isPreirreducible (W_a ∩ (π_Z ⁻¹ᵁ U_a)) W_b
          (hWa.inter (π_Z ⁻¹ᵁ U_a).isOpen) hWb
          ⟨u₁, hu₁_Ub₂, hu₁_Wa, hu₁_Ua₂⟩ ⟨wb, hwb_Ub, hwb⟩
      exact ⟨u₂, trivial, hu₂_Wa, hu₂_Wb⟩
    have : IrreducibleSpace ↥Z₂ := { isPreirreducible_univ := hPreZ₂, toNonempty := ⟨z₂₀⟩ }
    exact isIntegral_of_irreducibleSpace_of_isReduced Z₂

  have hClosedPt : ∀ y₁ : ↥Y₁, IsClosed ({y₁} : Set ↥Y₁) →
      ∃! y₂ : ↥Y₂, π₁₂.base y₂ = y₁ := by
    intro y₁ hy₁_cl
    obtain ⟨U, hU, hy₁U, _⟩ :=
      exists_isAffineOpen_mem_and_subset (show y₁ ∈ (⊤ : Y₁.Opens) from trivial)
    obtain ⟨π_U, θ_U, hπ_U_fac, hθ_U_fst⟩ := hChart Y₁ p₁ U hU
    let α_U := Spec.preimage (hU.fromSpec ≫ p₁)
    let _ : Algebra Ω₁ ↑Γ(Y₁, U) := α_U.hom.toAlgebra
    have hSpec_α : Spec.map (CommRingCat.ofHom (algebraMap Ω₁ ↑Γ(Y₁, U))) = hU.fromSpec ≫ p₁ :=
      Spec.map_preimage (hU.fromSpec ≫ p₁)
    have hLFT_α : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap Ω₁ ↑Γ(Y₁, U)))) := by
      rw [hSpec_α]
      infer_instance
    have : Algebra.FiniteType Ω₁ ↑Γ(Y₁, U) :=
      HasRingHomProperty.Spec_iff.mp hLFT_α
    have hy₁_range : y₁ ∈ Set.range hU.fromSpec.base := by
      rw [hU.range_fromSpec]
      exact hy₁U
    obtain ⟨q₁_pt, hq₁_eq⟩ := hy₁_range
    let q₁ : PrimeSpectrum ↑Γ(Y₁, U) := q₁_pt
    let incLeft : ↑Γ(Y₁, U) →+* TensorProduct Ω₁ (↑Γ(Y₁, U)) Ω₂ :=
      Algebra.TensorProduct.includeLeftRingHom (R := Ω₁)
    have hq₁_cl : IsClosed ({q₁} : Set (PrimeSpectrum ↑Γ(Y₁, U))) := by
      have hCl_pre : IsClosed (hU.fromSpec.base ⁻¹' ({y₁} : Set ↥Y₁)) :=
        hy₁_cl.preimage hU.fromSpec.continuous
      have hpre :
          (hU.fromSpec.base ⁻¹' ({y₁} : Set ↥Y₁) : Set (PrimeSpectrum ↑Γ(Y₁, U))) = {q₁} := by
        ext q
        simp only [Set.mem_singleton_iff, ← hq₁_eq]
        exact hU.fromSpec.isOpenEmbedding.injective.eq_iff
      exact hpre ▸ hCl_pre
    have hq₁_max : q₁.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q₁).mp hq₁_cl
    obtain ⟨q₂, hq₂_comap, hq₂_uniq⟩ := hMaxUniq (↑Γ(Y₁, U)) q₁ hq₁_max
    let U₂ : Y₂.Opens := π₁₂ ⁻¹ᵁ U
    let y₂ : ↥Y₂ := U₂.ι.base (θ_U.inv.base q₂)
    have hθ_inv_π : θ_U.inv ≫ π_U = Spec.map (CommRingCat.ofHom incLeft) := by
      rw [Iso.inv_comp_eq, hθ_U_fst]
    have hy₂_proj : π₁₂.base y₂ = y₁ := by
      calc π₁₂.base y₂
          = (U₂.ι ≫ π₁₂).base (θ_U.inv.base q₂) := rfl
        _ = (π_U ≫ hU.fromSpec).base (θ_U.inv.base q₂) := by rw [← hπ_U_fac]
        _ = hU.fromSpec.base ((θ_U.inv ≫ π_U).base q₂) := rfl
        _ = hU.fromSpec.base ((Spec.map (CommRingCat.ofHom incLeft)).base q₂) := by
            rw [hθ_inv_π]
        _ = hU.fromSpec.base (PrimeSpectrum.comap incLeft q₂) := by
            rw [Spec.map_base]
            rfl
        _ = hU.fromSpec.base q₁_pt := by rw [hq₂_comap]
        _ = y₁ := hq₁_eq
    refine ⟨y₂, hy₂_proj, fun y₂' hy₂' => ?_⟩
    have hy₂'_U₂ : y₂' ∈ Set.range U₂.ι.base := by
      rw [Scheme.Opens.range_ι]
      change π₁₂.base y₂' ∈ U
      rw [hy₂']
      exact hy₁U
    obtain ⟨z₂', rfl⟩ := hy₂'_U₂
    let q₂' : PrimeSpectrum (TensorProduct Ω₁ (↑Γ(Y₁, U)) Ω₂) := θ_U.hom.base z₂'
    have hq₂'_comap : PrimeSpectrum.comap incLeft q₂' = q₁ := by
      apply hU.fromSpec.isOpenEmbedding.injective
      calc hU.fromSpec.base (PrimeSpectrum.comap incLeft q₂')
          = hU.fromSpec.base ((Spec.map (CommRingCat.ofHom incLeft)).base (θ_U.hom.base z₂')) := by
              rw [Spec.map_base]
              rfl
        _ = ((θ_U.hom ≫ Spec.map (CommRingCat.ofHom incLeft)) ≫ hU.fromSpec).base z₂' := rfl
        _ = (π_U ≫ hU.fromSpec).base z₂' := by rw [hθ_U_fst]
        _ = (U₂.ι ≫ π₁₂).base z₂' := by rw [hπ_U_fac]
        _ = y₁ := hy₂'
        _ = hU.fromSpec.base q₁_pt := hq₁_eq.symm
    have hq₂'_eq : q₂' = q₂ := hq₂_uniq q₂' hq₂'_comap
    have hz₂'_eq : z₂' = θ_U.inv.base q₂ := by
      calc z₂' = (θ_U.hom ≫ θ_U.inv).base z₂' := by rw [θ_U.hom_inv_id]; rfl
        _ = θ_U.inv.base q₂' := rfl
        _ = θ_U.inv.base q₂ := by rw [hq₂'_eq]
    rw [hz₂'_eq]

  
  have : IsLocallyNoetherian Y₁ := LocallyOfFiniteType.isLocallyNoetherian p₁
  have : CompactSpace ↥Y₁ := QuasiCompact.compactSpace_of_compactSpace p₁
  have : IsNoetherian Y₁ := ⟨⟩
  have hFin : (irreducibleComponents ↥Y₁).Finite := finite_irreducibleComponents_of_isNoetherian
  have hSurj : Function.Surjective π₁₂.base := hSurj_all Y₁ p₁

  have hPerComp : ∀ E₁ ∈ irreducibleComponents ↥Y₁,
      IsIrreducible (π₁₂.base ⁻¹' E₁) ∧
      ∃ (E₁_sch : Scheme.{u}) (ιE₁ : E₁_sch ⟶ Y₁),
        IsClosedImmersion ιE₁ ∧
        IsIntegral E₁_sch ∧
        Set.range ιE₁.base = E₁ ∧
        IsIntegral (Limits.pullback (ιE₁ ≫ p₁) f_φ) ∧
        (∀ (E'_sch : Scheme.{u}) (ιE' : E'_sch ⟶ Y₁),
          IsClosedImmersion ιE' →
          IsIntegral E'_sch →
          Set.range ιE'.base = E₁ →
          ∃ e₁ : E'_sch ≅ E₁_sch, e₁.hom ≫ ιE₁ = ιE') ∧
        (∀ (E₂_sch : Scheme.{u}) (ιE₂ : E₂_sch ⟶ Y₂),
          IsClosedImmersion ιE₂ →
          IsIntegral E₂_sch →
          Set.range ιE₂.base = π₁₂.base ⁻¹' E₁ →
          ∃ e₂ : E₂_sch ≅ Limits.pullback (ιE₁ ≫ p₁) f_φ,
            e₂.hom ≫ Limits.pullback.snd (ιE₁ ≫ p₁) f_φ = ιE₂ ≫ p₂) := by
    intro E₁ hE₁
    have hE₁_cl : IsClosed E₁ := isClosed_of_mem_irreducibleComponents E₁ hE₁
    obtain ⟨⟨E₁_sch, ιE₁, hCl₁, hRed₁, hRange₁, hUniq₁⟩, hUpgrade₁⟩ := h_s2 Y₁ E₁ hE₁_cl
    have hInt₁ : IsIntegral E₁_sch := hUpgrade₁ hE₁.1 E₁_sch ιE₁ hCl₁ hRed₁ hRange₁
    let E₂_pb := Limits.pullback (ιE₁ ≫ p₁) f_φ
    have hInt_pb : IsIntegral E₂_pb := hIntPb E₁_sch (ιE₁ ≫ p₁) hInt₁
    let ιE₂_pb : E₂_pb ⟶ Y₂ :=
      Limits.pullback.map (ιE₁ ≫ p₁) f_φ p₁ f_φ ιE₁ (𝟙 _) (𝟙 _)
        (Category.comp_id _) (by rw [Category.comp_id, Category.id_comp])
    have hιE₂_fst : ιE₂_pb ≫ π₁₂ = Limits.pullback.fst (ιE₁ ≫ p₁) f_φ ≫ ιE₁ :=
      Limits.pullback.lift_fst _ _ _
    have hιE₂_snd : ιE₂_pb ≫ p₂ = Limits.pullback.snd (ιE₁ ≫ p₁) f_φ := by
      change ιE₂_pb ≫ Limits.pullback.snd p₁ f_φ = _
      rw [Limits.pullback.lift_snd, Category.comp_id]
    have hPb_outer : IsPullback (ιE₂_pb ≫ p₂) (Limits.pullback.fst (ιE₁ ≫ p₁) f_φ)
        f_φ (ιE₁ ≫ p₁) := by
      rw [hιE₂_snd]
      exact (IsPullback.of_hasPullback (ιE₁ ≫ p₁) f_φ).flip
    have hPb_left : IsPullback (Limits.pullback.fst (ιE₁ ≫ p₁) f_φ) ιE₂_pb ιE₁ π₁₂ :=
      (IsPullback.of_right hPb_outer hιE₂_fst (IsPullback.of_hasPullback p₁ f_φ).flip).flip
    have hCl_pb : IsClosedImmersion ιE₂_pb :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_left hCl₁
    have hRange_pb : Set.range ιE₂_pb.base = π₁₂.base ⁻¹' E₁ := by
      ext y₂
      simp only [Set.mem_range, Set.mem_preimage]
      constructor
      · rintro ⟨z, rfl⟩
        have hz_eq : π₁₂.base (ιE₂_pb.base z) =
            ιE₁.base ((Limits.pullback.fst (ιE₁ ≫ p₁) f_φ).base z) := by
          change (ιE₂_pb ≫ π₁₂).base z = (Limits.pullback.fst (ιE₁ ≫ p₁) f_φ ≫ ιE₁).base z
          rw [hιE₂_fst]
        rw [hz_eq, ← hRange₁]
        exact ⟨_, rfl⟩
      · intro hy₂
        rw [← hRange₁] at hy₂
        obtain ⟨x₁, hx₁⟩ := hy₂
        obtain ⟨z, _, hz₂⟩ := Scheme.exists_preimage_of_isPullback hPb_left x₁ y₂ hx₁
        exact ⟨z, hz₂⟩
    have hIrred_pre : IsIrreducible (π₁₂.base ⁻¹' E₁) := by
      have : IrreducibleSpace ↥E₂_pb := irreducibleSpace_of_isIntegral E₂_pb
      have hImg_pb : ιE₂_pb.base '' (Set.univ : Set ↥E₂_pb) = π₁₂.base ⁻¹' E₁ := by
        rw [Set.image_univ, hRange_pb]
      rw [← hImg_pb]
      exact (IrreducibleSpace.isIrreducible_univ ↥E₂_pb).image _ ιE₂_pb.continuous.continuousOn
    refine ⟨hIrred_pre, E₁_sch, ιE₁, hCl₁, hInt₁, hRange₁, hInt_pb, ?_, ?_⟩
    · intro E'_sch ιE' hCl' hInt' hRange'
      have : IsIntegral E'_sch := hInt'
      exact hUniq₁ E'_sch ιE' hCl' (isReduced_of_isIntegral E'_sch) hRange'
    · intro E₂_sch ιE₂ hCl₂ hInt₂ hRange₂
      have : IsIntegral E₂_sch := hInt₂
      obtain ⟨⟨Z₂_sch, ιZ₂, _, _, _, hUniq₂⟩, _⟩ :=
        h_s2 Y₂ (π₁₂.base ⁻¹' E₁) (hE₁_cl.preimage π₁₂.continuous)
      obtain ⟨e_a, he_a⟩ :=
        hUniq₂ E₂_sch ιE₂ hCl₂ (isReduced_of_isIntegral E₂_sch) hRange₂
      obtain ⟨e_b, he_b⟩ :=
        hUniq₂ E₂_pb ιE₂_pb hCl_pb (isReduced_of_isIntegral E₂_pb) hRange_pb
      refine ⟨e_a ≪≫ e_b.symm, ?_⟩
      have h_over_Y₂ : (e_a ≪≫ e_b.symm).hom ≫ ιE₂_pb = ιE₂ := by
        simp only [Iso.trans_hom, Iso.symm_hom, Category.assoc]
        rw [← he_b, ← Category.assoc e_b.inv, e_b.inv_hom_id, Category.id_comp, he_a]
      rw [← hιE₂_snd, ← Category.assoc, h_over_Y₂]

  have hPreIrred : ∀ E₁ ∈ irreducibleComponents ↥Y₁, IsIrreducible (π₁₂.base ⁻¹' E₁) :=
    fun E₁ hE₁ => (hPerComp E₁ hE₁).1
  let f : ↥Y₂ → ↥Y₁ := π₁₂.base
  have hf_cont : Continuous f := π₁₂.continuous
  have hf_surj : Function.Surjective f := hSurj
  have hSubComp : ∀ (T : Set ↥Y₂), IsIrreducible T →
      ∃ E₁ ∈ irreducibleComponents ↥Y₁, T ⊆ f ⁻¹' E₁ := by
    intro T hT
    classical
    let t : Finset (Set ↥Y₂) := hFin.toFinset.image (fun E₁ => f ⁻¹' E₁)
    have ht_cl : ∀ z ∈ t, IsClosed z := by
      intro z hz
      rcases Finset.mem_image.mp hz with ⟨E₁, hE₁_mem, rfl⟩
      exact (isClosed_of_mem_irreducibleComponents E₁ (hFin.mem_toFinset.mp hE₁_mem)).preimage hf_cont
    have ht_cov : T ⊆ ⋃₀ (↑t : Set (Set ↥Y₂)) := by
      intro x₂ _
      rw [Set.mem_sUnion]
      refine ⟨f ⁻¹' irreducibleComponent (f x₂), ?_, mem_irreducibleComponent⟩
      rw [Finset.mem_coe, Finset.mem_image]
      exact ⟨irreducibleComponent (f x₂),
        hFin.mem_toFinset.mpr (irreducibleComponent_mem_irreducibleComponents (f x₂)), rfl⟩
    obtain ⟨z, hz_mem, hTz⟩ := isIrreducible_iff_sUnion_isClosed.mp hT t ht_cl ht_cov
    rcases Finset.mem_image.mp hz_mem with ⟨E₁, hE₁_mem, rfl⟩
    exact ⟨E₁, hFin.mem_toFinset.mp hE₁_mem, hTz⟩
  have hBack : ∀ E₂ ∈ irreducibleComponents ↥Y₂,
      ∃ E₁ ∈ irreducibleComponents ↥Y₁, E₂ = f ⁻¹' E₁ := by
    intro E₂ hE₂
    obtain ⟨E₁, hE₁, hSub⟩ := hSubComp E₂ hE₂.1
    exact ⟨E₁, hE₁, Set.Subset.antisymm hSub (hE₂.2 (hPreIrred E₁ hE₁) hSub)⟩
  have hFwd : ∀ E₁ ∈ irreducibleComponents ↥Y₁,
      f ⁻¹' E₁ ∈ irreducibleComponents ↥Y₂ ∧ f '' (f ⁻¹' E₁) = E₁ := by
    intro E₁ hE₁
    refine ⟨⟨hPreIrred E₁ hE₁, ?_⟩, Set.image_preimage_eq E₁ hf_surj⟩
    intro T hT hSub
    obtain ⟨E₁', hE₁', hTSub⟩ := hSubComp T hT
    have hSubPre : f ⁻¹' E₁ ⊆ f ⁻¹' E₁' := Set.Subset.trans hSub hTSub
    have hSubImg : E₁ ⊆ E₁' := by
      rw [← Set.image_preimage_eq E₁ hf_surj, ← Set.image_preimage_eq E₁' hf_surj]
      exact Set.image_mono hSubPre
    have hEq : E₁' = E₁ := Set.Subset.antisymm (hE₁.2 hE₁'.1 hSubImg) hSubImg
    rwa [hEq] at hTSub
  have hConn_iff : ConnectedSpace ↥Y₁ ↔ ConnectedSpace ↥Y₂ := by
    refine ⟨fun hConn₁ => ?_, fun _ => hf_surj.connectedSpace hf_cont⟩
    rw [connectedSpace_iff_clopen]
    obtain ⟨x₁⟩ := hConn₁.toNonempty
    obtain ⟨x₂, _⟩ := hf_surj x₁
    refine ⟨⟨x₂⟩, fun U hClopU => ?_⟩
    rw [or_iff_not_imp_left]
    intro hUne_empty
    obtain ⟨u₂, hu₂⟩ := Set.nonempty_iff_ne_empty.mpr hUne_empty
    have hDich : ∀ E₁ ∈ irreducibleComponents ↥Y₁, f ⁻¹' E₁ ⊆ U ∨ f ⁻¹' E₁ ⊆ Uᶜ := by
      intro E₁ hE₁
      by_contra hNot
      rw [not_or] at hNot
      obtain ⟨hNotU, hNotUc⟩ := hNot
      obtain ⟨a, haE, haNotU⟩ := Set.not_subset.mp hNotU
      obtain ⟨b, hbE, hbNotUc⟩ := Set.not_subset.mp hNotUc
      have hbU : b ∈ U := by
        by_contra hb
        exact hbNotUc hb
      obtain ⟨w, _, hwU, hwUc⟩ :=
        (hPreIrred E₁ hE₁).isConnected.isPreconnected U Uᶜ hClopU.2 hClopU.1.isOpen_compl
          (fun z _ => Classical.em (z ∈ U)) ⟨b, hbE, hbU⟩ ⟨a, haE, haNotU⟩
      exact hwUc hwU
    let C_pos : Set (Set ↥Y₁) := {E₁ ∈ irreducibleComponents ↥Y₁ | f ⁻¹' E₁ ⊆ U}
    let C_neg : Set (Set ↥Y₁) := {E₁ ∈ irreducibleComponents ↥Y₁ | f ⁻¹' E₁ ⊆ Uᶜ}
    let F_pos : Set ↥Y₁ := ⋃ E₁ ∈ C_pos, E₁
    let F_neg : Set ↥Y₁ := ⋃ E₁ ∈ C_neg, E₁
    have hCl_pos : IsClosed F_pos :=
      (hFin.subset (fun E₁ h => h.1)).isClosed_biUnion
        (fun E₁ h => isClosed_of_mem_irreducibleComponents E₁ h.1)
    have hCl_neg : IsClosed F_neg :=
      (hFin.subset (fun E₁ h => h.1)).isClosed_biUnion
        (fun E₁ h => isClosed_of_mem_irreducibleComponents E₁ h.1)
    have hEq_compl : F_pos = F_negᶜ := by
      ext y₁
      simp only [Set.mem_compl_iff, F_pos, F_neg, Set.mem_iUnion, exists_prop]
      constructor
      · rintro ⟨E₁, ⟨_, hE₁U⟩, hy₁E₁⟩ ⟨E₁', ⟨_, hE₁'Uc⟩, hy₁E₁'⟩
        obtain ⟨y₂, rfl⟩ := hf_surj y₁
        exact hE₁'Uc hy₁E₁' (hE₁U hy₁E₁)
      · intro hy₁_not_neg
        let E₁ := irreducibleComponent y₁
        have hE₁ : E₁ ∈ irreducibleComponents ↥Y₁ :=
          irreducibleComponent_mem_irreducibleComponents y₁
        rcases hDich E₁ hE₁ with hU | hUc
        · exact ⟨E₁, ⟨hE₁, hU⟩, mem_irreducibleComponent⟩
        · exfalso
          exact hy₁_not_neg ⟨E₁, ⟨hE₁, hUc⟩, mem_irreducibleComponent⟩
    have hClop_Fpos : IsClopen F_pos := ⟨hCl_pos, hEq_compl ▸ hCl_neg.isOpen_compl⟩
    have hFpos_ne : F_pos.Nonempty := by
      let E₀ := irreducibleComponent (f u₂)
      have hE₀ : E₀ ∈ irreducibleComponents ↥Y₁ :=
        irreducibleComponent_mem_irreducibleComponents (f u₂)
      rcases hDich E₀ hE₀ with hU | hUc
      · exact ⟨f u₂, Set.mem_biUnion ⟨hE₀, hU⟩ mem_irreducibleComponent⟩
      · exact False.elim (hUc mem_irreducibleComponent hu₂)
    have hFpos_univ : F_pos = Set.univ := IsClopen.eq_univ hClop_Fpos hFpos_ne
    ext z₂
    simp only [Set.mem_univ, iff_true]
    let E₁ := irreducibleComponent (f z₂)
    have hE₁ : E₁ ∈ irreducibleComponents ↥Y₁ :=
      irreducibleComponent_mem_irreducibleComponents (f z₂)
    rcases hDich E₁ hE₁ with hU | hUc
    · exact hU mem_irreducibleComponent
    · exfalso
      have hz_pos : f z₂ ∈ F_pos := hFpos_univ ▸ Set.mem_univ (f z₂)
      rw [hEq_compl] at hz_pos
      exact hz_pos (Set.mem_biUnion ⟨hE₁, hUc⟩ mem_irreducibleComponent)

  refine ⟨hConn_iff, ?_, hBack, hClosedPt⟩
  intro E₁ hE₁
  exact ⟨(hFwd E₁ hE₁).1, (hFwd E₁ hE₁).2, (hPerComp E₁ hE₁).2⟩

theorem weil_algClosed_proper_iso_weilProjectiveSpaceOne_iff_and_closedPts : (∀ (Ω₁ Ω₂ : Type u) [Field Ω₁] [IsAlgClosed Ω₁] [Field Ω₂] [IsAlgClosed Ω₂]
      (φ : Ω₁ →+* Ω₂)
      (E₁ : AlgebraicGeometry.Scheme.{u})
      (p_E₁ : E₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω₁))
      [AlgebraicGeometry.IsProper p_E₁],
      let f_φ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
      (∃ iso₁ : E₁ ≅ (weilProjectiveSpaceOver Ω₁ 1).left,
        p_E₁ = iso₁.hom ≫ (weilProjectiveSpaceOver Ω₁ 1).hom) ↔
        (∃ iso₂ : CategoryTheory.Limits.pullback p_E₁ f_φ ≅ (weilProjectiveSpaceOver Ω₂ 1).left,
          CategoryTheory.Limits.pullback.snd p_E₁ f_φ =
            iso₂.hom ≫ (weilProjectiveSpaceOver Ω₂ 1).hom)) ∧
    (∀ (Ω : Type u) [Field Ω]
      (E_sch : AlgebraicGeometry.Scheme.{u})
      (_ : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left)
      (x : ↥E_sch),
      closure ({x} : Set ↥E_sch) = Set.univ ∨ IsClosed ({x} : Set ↥E_sch)) :=
by
  have hDehom :
      ∀ (K : Type u) [Field K],
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) K) :=
          MvPolynomial.gradedAlgebra
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) K)).toIdeal ≤
          Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ∧
        ∀ (a : Fin 2) (x : MvPolynomial (Fin 2) K)
          (hx_mem : x ∈ MvPolynomial.homogeneousSubmodule (Fin 2) K 1),
          x = MvPolynomial.X a →
          ∃ (e : Polynomial K ≃+*
              HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) K) x),
            (∀ c : K, e (Polynomial.C c) =
              (HomogeneousLocalization.fromZeroRingHom
                (MvPolynomial.homogeneousSubmodule (Fin 2) K) (Submonoid.powers x))
                (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0) c)) ∧
            e Polynomial.X =
              HomogeneousLocalization.Away.isLocalizationElem hx_mem
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                  (MvPolynomial.isHomogeneous_X K (1 - a))) := by
    intro K _
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) K
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    refine ⟨?_, ?_⟩
    · intro p hp
      change p ∈ HomogeneousIdeal.irrelevant 𝒜 at hp
      have hproj0 : GradedRing.proj 𝒜 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      have hcoeff0 : p.coeff 0 = 0 := by
        classical
        have hsum := (DirectSum.sum_support_decompose 𝒜 p).symm
        have h1 := congrArg (fun q : MvPolynomial (Fin 2) K => q.coeff 0) hsum
        rw [MvPolynomial.coeff_sum] at h1
        rw [h1]
        refine Finset.sum_eq_zero fun i _ => ?_
        by_cases hi0 : i = 0
        · subst hi0
          rw [GradedRing.proj_apply] at hproj0
          rw [hproj0]
          rfl
        · by_contra hne
          have hhom : MvPolynomial.IsHomogeneous
              (↑(DirectSum.decompose 𝒜 p i) : MvPolynomial (Fin 2) K) i :=
            (MvPolynomial.mem_homogeneousSubmodule i _).mp (DirectSum.decompose 𝒜 p i).2
          have hdeg := hhom hne
          simp at hdeg
          exact hi0 hdeg.symm
      rw [p.as_sum]
      refine Ideal.sum_mem _ fun m hm => ?_
      have hm_ne : m ≠ 0 := by
        intro h0
        subst h0
        exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
      have hex : ∃ i : Fin 2, 1 ≤ m i := by
        by_contra hAll
        apply hm_ne
        ext i
        by_contra hne0
        exact hAll ⟨i, Nat.one_le_iff_ne_zero.mpr hne0⟩
      obtain ⟨i, hi⟩ := hex
      let m' : Fin 2 →₀ ℕ := m - Finsupp.single i 1
      have hm_eq : m' + Finsupp.single i 1 = m := tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr hi)
      have hmon : MvPolynomial.monomial m (p.coeff m) =
          MvPolynomial.monomial m' (p.coeff m) * MvPolynomial.X i := by
        rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, mul_one, hm_eq]
      rw [hmon]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
    · intro a x hx_mem hx_eq
      subst hx_eq
      let b : Fin 2 := 1 - a
      have hba : b ≠ a := by fin_cases a <;> decide
      have hfin2 : ∀ j : Fin 2, j ≠ a ↔ j = b := by
        intro j
        fin_cases a <;> fin_cases j <;> decide
      let hXb : (MvPolynomial.X b : MvPolynomial (Fin 2) K) ∈ 𝒜 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K b)
      let ι_K : K →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap K ↥(𝒜 0))
      let u_K : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) :=
        HomogeneousLocalization.Away.isLocalizationElem hx_mem hXb
      let α : Polynomial K →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) :=
        Polynomial.eval₂RingHom ι_K u_K
      let dehom : MvPolynomial (Fin 2) K →+* Polynomial K :=
        MvPolynomial.eval₂Hom Polynomial.C (fun j => if j = a then 1 else Polynomial.X)
      have hdehom_unit : ∀ y : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin 2) K),
          IsUnit (dehom y) := by
        rintro ⟨_, n, rfl⟩
        simp [dehom]
      let β_loc : Localization (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin 2) K)) →+*
          Polynomial K :=
        IsLocalization.lift hdehom_unit
      have hβ_mk : ∀ (p : MvPolynomial (Fin 2) K)
          (y : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin 2) K)),
          β_loc (Localization.mk p y) = dehom p := by
        intro p y
        obtain ⟨_, n, rfl⟩ := y
        have h_eq := IsLocalization.lift_mk'_spec
          (S := Localization (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin 2) K)))
          hdehom_unit p (dehom p)
          ⟨(MvPolynomial.X a : MvPolynomial (Fin 2) K) ^ n,
            pow_mem (Submonoid.mem_powers (MvPolynomial.X a : MvPolynomial (Fin 2) K)) n⟩
        rw [← Localization.mk_eq_mk'] at h_eq
        refine h_eq.mpr ?_
        simp [dehom]
      let valHom : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) →+*
          Localization (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin 2) K)) :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := HomogeneousLocalization.val_mul
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := HomogeneousLocalization.val_add }
      let β : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) →+* Polynomial K :=
        β_loc.comp valHom
      have hι_val : ∀ c : K, (ι_K c).val = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        rfl
      have hu_val : u_K.val =
          Localization.mk (MvPolynomial.X b ^ 1)
            ⟨MvPolynomial.X a ^ 1, pow_mem (Submonoid.mem_powers _) 1⟩ := by
        rfl
      have hLeft : Function.LeftInverse β α := by
        have h_id : β.comp α = RingHom.id (Polynomial K) := by
          apply Polynomial.ringHom_ext'
          · refine RingHom.ext fun c => ?_
            change β_loc (HomogeneousLocalization.val (Polynomial.eval₂ ι_K u_K (Polynomial.C c))) =
              Polynomial.C c
            rw [Polynomial.eval₂_C, hι_val, hβ_mk]
            simp [dehom]
          · change β_loc (HomogeneousLocalization.val (Polynomial.eval₂ ι_K u_K Polynomial.X)) =
              Polynomial.X
            rw [Polynomial.eval₂_X, hu_val, hβ_mk, pow_one]
            simp [dehom, hba]
        intro P
        exact RingHom.congr_fun h_id P
      have hRight : Function.RightInverse β α := by
        intro z
        apply HomogeneousLocalization.val_injective _
        refine Quotient.inductionOn' z fun nd => ?_
        let den_sub : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin 2) K) :=
          ⟨nd.den.1, nd.den_mem⟩
        change (α (β (Quotient.mk'' nd))).val = Localization.mk nd.num.1 den_sub
        have hβ_nd : β (Quotient.mk'' nd) = dehom nd.num.1 := by
          change β_loc (Localization.mk nd.num.1 den_sub) = dehom nd.num.1
          exact hβ_mk nd.num.1 den_sub
        rw [hβ_nd]
        obtain ⟨n, hn_eq⟩ := nd.den_mem
        have hden_eq : (nd.den : MvPolynomial (Fin 2) K) = MvPolynomial.X a ^ n := hn_eq.symm
        have hdeg_eq : nd.deg = n := by
          have hp_ne : (MvPolynomial.X a : MvPolynomial (Fin 2) K) ^ n ≠ 0 := by
            intro h0
            have hev := congrArg (MvPolynomial.eval (fun _ : Fin 2 => (1 : K))) h0
            simp at hev
          have hex_d : ∃ d, ((MvPolynomial.X a : MvPolynomial (Fin 2) K) ^ n).coeff d ≠ 0 := by
            by_contra hAll
            refine hp_ne (MvPolynomial.ext _ _ fun d => ?_)
            change ((MvPolynomial.X a : MvPolynomial (Fin 2) K) ^ n).coeff d = 0
            by_contra hd0
            exact hAll ⟨d, hd0⟩
          obtain ⟨d, hd⟩ := hex_d
          have h1 : MvPolynomial.IsHomogeneous ((MvPolynomial.X a : MvPolynomial (Fin 2) K) ^ n) nd.deg :=
            (MvPolynomial.mem_homogeneousSubmodule nd.deg _).mp (hden_eq ▸ nd.den.2)
          have h2 : MvPolynomial.IsHomogeneous ((MvPolynomial.X a : MvPolynomial (Fin 2) K) ^ n) n := by
            simpa only [one_mul] using (MvPolynomial.isHomogeneous_X K a).pow n
          exact (h1 hd).symm.trans (h2 hd)
        have hnum_mem : nd.num.1 ∈ 𝒜 n := hdeg_eq ▸ nd.num.2
        have hnum_comp : MvPolynomial.homogeneousComponent n nd.num.1 = nd.num.1 := by
          rw [MvPolynomial.homogeneousComponent_of_mem hnum_mem, ite_eq_left_iff.mpr (fun h => absurd rfl h)]
        let ψ : MvPolynomial (Fin 2) K →+*
            Localization (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin 2) K)) :=
          valHom.comp (α.comp dehom)
        change ψ nd.num.1 = Localization.mk nd.num.1 den_sub
        let s1 : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin 2) K) :=
          ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩
        have hψ_C : ∀ c : K, ψ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
          intro c
          simp [ψ, dehom, α, valHom, hι_val]
        have hψ_X : ∀ j : Fin 2, ψ (MvPolynomial.X j) = Localization.mk (MvPolynomial.X j) s1 := by
          intro j
          by_cases hja : j = a
          · subst hja
            have h1 : ψ (MvPolynomial.X j) = 1 := by
              simp [ψ, dehom]
            rw [h1]
            exact (Localization.mk_self s1).symm
          · have hjb : j = b := (hfin2 j).mp hja
            subst hjb
            have h1 : ψ (MvPolynomial.X b) = u_K.val := by
              simp [ψ, dehom, hba, α, valHom]
            rw [h1, hu_val]
            congr 1 <;> [exact pow_one _; exact Subtype.ext (pow_one _)]
        have hψ_mon : ∀ (m : Fin 2 →₀ ℕ) (c : K),
            Finsupp.degree m = n →
            ψ (MvPolynomial.monomial m c) = Localization.mk (MvPolynomial.monomial m c) den_sub := by
          intro m c hm_deg
          have hsum2 : m 0 + m 1 = n := by
            have h_univ : ∑ i : Fin 2, m i = Finsupp.degree m := by
              refine (Finset.sum_subset (Finset.subset_univ _) ?_).symm
              intro i _ hi
              exact Finsupp.notMem_support_iff.mp hi
            rw [Fin.sum_univ_two] at h_univ
            exact h_univ.trans hm_deg
          have hmon_prod : MvPolynomial.monomial m c =
              MvPolynomial.C c * MvPolynomial.X 0 ^ m 0 * MvPolynomial.X 1 ^ m 1 := by
            rw [MvPolynomial.monomial_eq, Finsupp.prod]
            have h_prod : ∏ i ∈ m.support, (MvPolynomial.X i : MvPolynomial (Fin 2) K) ^ m i =
                ∏ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) K) ^ m i := by
              refine Finset.prod_subset (Finset.subset_univ _) ?_
              intro i _ hi
              rw [Finsupp.notMem_support_iff.mp hi, pow_zero]
            rw [h_prod, Fin.prod_univ_two, mul_assoc]
          rw [hmon_prod, map_mul, map_mul, map_pow, map_pow, hψ_C, hψ_X 0, hψ_X 1]
          rw [Localization.mk_pow, Localization.mk_pow, Localization.mk_mul, Localization.mk_mul]
          congr 1
          apply Subtype.ext
          simp only [SubmonoidClass.coe_pow, s1, den_sub, one_mul, ← pow_add, hsum2, hden_eq]
        have h_sum_mk : ∀ (S : Finset (Fin 2 →₀ ℕ)) (f_m : (Fin 2 →₀ ℕ) → MvPolynomial (Fin 2) K),
            ∑ m ∈ S, Localization.mk (f_m m) den_sub = Localization.mk (∑ m ∈ S, f_m m) den_sub := by
          intro S f_m
          classical
          refine Finset.induction_on S ?_ ?_
          · simp [Localization.mk_zero]
          · intro m S' hm_not ih
            rw [Finset.sum_insert hm_not, Finset.sum_insert hm_not, ih, Localization.add_mk_self]
        conv_lhs => rw [nd.num.1.as_sum]
        rw [map_sum]
        have h_terms : ∑ x ∈ nd.num.1.support, ψ ((MvPolynomial.monomial x) (nd.num.1.coeff x)) =
            ∑ x ∈ nd.num.1.support,
              Localization.mk ((MvPolynomial.monomial x) (nd.num.1.coeff x)) den_sub := by
          refine Finset.sum_congr rfl fun m hm => ?_
          have hm_ne : nd.num.1.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
          have hm_deg : Finsupp.degree m = n := by
            by_contra hne
            have hc_eq := congrArg (fun q : MvPolynomial (Fin 2) K => q.coeff m) hnum_comp
            rw [MvPolynomial.coeff_homogeneousComponent, ite_eq_right_iff.mpr (fun h => absurd h hne)] at hc_eq
            exact hm_ne hc_eq.symm
          exact hψ_mon m (nd.num.1.coeff m) hm_deg
        rw [h_terms, h_sum_mk, ← nd.num.1.as_sum]
      refine ⟨{ toFun := α, invFun := β, left_inv := hLeft, right_inv := hRight,
                map_mul' := α.map_mul', map_add' := α.map_add' }, ?_, ?_⟩
      · intro c
        change Polynomial.eval₂ ι_K u_K (Polynomial.C c) = ι_K c
        exact Polynomial.eval₂_C ι_K u_K
      · change Polynomial.eval₂ ι_K u_K Polynomial.X = u_K
        exact Polynomial.eval₂_X ι_K u_K

  have hClosedPts :
      ∀ (Ω : Type u) [Field Ω]
        (E_sch : AlgebraicGeometry.Scheme.{u})
        (_ : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left)
        (x : ↥E_sch),
        closure ({x} : Set ↥E_sch) = Set.univ ∨ IsClosed ({x} : Set ↥E_sch) := by
    intro Ω _ E_sch e_sch x
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) Ω
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let P : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
    let hTop : ↥E_sch ≃ₜ ↥P := TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso e_sch)
    let y : ↥P := hTop x
    have hX_mem : ∀ a : Fin 2, (MvPolynomial.X a : MvPolynomial (Fin 2) Ω) ∈ 𝒜 1 :=
      fun a => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a)
    let U : Fin 2 → P.Opens := fun a => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)
    have hU_top : ⨆ a : Fin 2, U a = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X (hDehom Ω).1
    have hU_union : (U 0 : Set ↥P) ∪ (U 1 : Set ↥P) = Set.univ := by
      ext w
      simp only [Set.mem_union, SetLike.mem_coe, Set.mem_univ, iff_true]
      have hw : w ∈ (⊤ : P.Opens) := trivial
      rw [← hU_top, TopologicalSpace.Opens.mem_iSup] at hw
      obtain ⟨a, ha⟩ := hw
      fin_cases a
      · exact Or.inl ha
      · exact Or.inr ha
    have hChartData : ∀ a : Fin 2,
        ∃ (e_a : Polynomial Ω ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a))
          (iso_a : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω)) ≅ (U a).toScheme),
          e_a Polynomial.X =
            HomogeneousLocalization.Away.isLocalizationElem (hX_mem a) (hX_mem (1 - a)) ∧
          iso_a.hom ≫ (U a).ι =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_a.symm.toRingHom) ≫
              AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hX_mem a) zero_lt_one := by
      intro a
      obtain ⟨e_a, _, he_X⟩ := (hDehom Ω).2 a (MvPolynomial.X a) (hX_mem a) rfl
      let iso_spec : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω)) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a))) :=
        { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_a.symm.toRingHom)
          inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_a.toRingHom)
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.map_comp]
            have hcomp : CommRingCat.ofHom e_a.toRingHom ≫ CommRingCat.ofHom e_a.symm.toRingHom =
                𝟙 (CommRingCat.of (Polynomial Ω)) := by
              ext1
              exact RingHom.ext fun p => e_a.symm_apply_apply p
            rw [hcomp, AlgebraicGeometry.Spec.map_id]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.map_comp]
            have hcomp : CommRingCat.ofHom e_a.symm.toRingHom ≫ CommRingCat.ofHom e_a.toRingHom =
                𝟙 (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a))) := by
              ext1
              exact RingHom.ext fun p => e_a.apply_symm_apply p
            rw [hcomp, AlgebraicGeometry.Spec.map_id] }
      let iso_open := (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) (hX_mem a) zero_lt_one).symm
      refine ⟨e_a, iso_spec ≪≫ iso_open, he_X, ?_⟩
      dsimp only [CategoryTheory.Iso.trans_hom, iso_spec, iso_open, CategoryTheory.Iso.symm_hom]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
    choose e_ch iso_ch he_ch_X hiso_ch_ι using hChartData
    let h_ch : ∀ a : Fin 2, PrimeSpectrum (Polynomial Ω) ≃ₜ ↥(U a) :=
      fun a => TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso (iso_ch a))
    have hPreU : ∀ a : Fin 2, IsPreirreducible (U a : Set ↥P) := by
      intro a u v hu hv ⟨x₁, hx₁U, hx₁u⟩ ⟨x₂, hx₂U, hx₂v⟩
      have _ : IrreducibleSpace ↥(U a) :=
        (h_ch a).surjective.irreducibleSpace (h_ch a).continuous
      obtain ⟨z, _, hzu, hzv⟩ := PreirreducibleSpace.isPreirreducible_univ
        (Subtype.val ⁻¹' u) (Subtype.val ⁻¹' v)
        (hu.preimage continuous_subtype_val) (hv.preimage continuous_subtype_val)
        ⟨⟨x₁, hx₁U⟩, trivial, hx₁u⟩ ⟨⟨x₂, hx₂U⟩, trivial, hx₂v⟩
      exact ⟨z.1, z.2, hzu, hzv⟩
    have hOverlap : ∃ z₀ : ↥P, ∀ c : Fin 2, z₀ ∈ U c := by
      have hbot_prime : (⊥ : Ideal (Polynomial Ω)).IsPrime := by
        rw [Ideal.isPrime_iff]
        refine ⟨fun h => one_ne_zero (Ideal.mem_bot.mp (h ▸ Submodule.mem_top)), fun {a b} hab => ?_⟩
        rcases mul_eq_zero.mp (Ideal.mem_bot.mp hab) with ha | hb
        · exact Or.inl (Ideal.mem_bot.mpr ha)
        · exact Or.inr (Ideal.mem_bot.mpr hb)
      let η₀_ps : PrimeSpectrum (Polynomial Ω) := ⟨⊥, hbot_prime⟩
      let η₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω))) := η₀_ps
      let z₀ : ↥P := ((iso_ch 0).hom ≫ (U 0).ι).base η₀
      refine ⟨z₀, fun c => ?_⟩
      fin_cases c
      · change (U 0).ι.base ((iso_ch 0).hom.base η₀) ∈ U 0
        exact ((iso_ch 0).hom.base η₀).2
      · have hz_eq : z₀ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e_ch 0).symm.toRingHom) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hX_mem 0) zero_lt_one).base η₀ := by
          dsimp only [z₀]
          rw [hiso_ch_ι 0]
        change z₀ ∈ U 1
        rw [hz_eq]
        let q₀ := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e_ch 0).symm.toRingHom)).base η₀
        let q₀_ps : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0)) := q₀
        change q₀ ∈ (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hX_mem 0) zero_lt_one) ⁻¹ᵁ
          AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1)
        rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜
          (hX_mem 0) zero_lt_one (hX_mem 1) zero_lt_one]
        change HomogeneousLocalization.Away.isLocalizationElem (hX_mem 0) (hX_mem 1) ∉ q₀_ps.asIdeal
        have h10 : (1 - (0 : Fin 2)) = 1 := rfl
        rw [← h10, ← he_ch_X 0]
        intro hmem
        have hX_bot : Polynomial.X ∈ (⊥ : Ideal (Polynomial Ω)) := by
          have hcomap : (e_ch 0).symm ((e_ch 0) Polynomial.X) ∈ η₀_ps.asIdeal := hmem
          rw [(e_ch 0).symm_apply_apply] at hcomap
          exact hcomap
        exact Polynomial.X_ne_zero (Ideal.mem_bot.mp hX_bot)
    have _ : PreirreducibleSpace ↥P := by
      refine ⟨fun u v hu hv ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩ => ?_⟩
      obtain ⟨z₀, hz₀⟩ := hOverlap
      have hx₁_mem : ∃ a : Fin 2, x₁ ∈ U a := by
        rcases (hU_union ▸ Set.mem_univ x₁) with h0 | h1
        · exact ⟨0, h0⟩
        · exact ⟨1, h1⟩
      have hx₂_mem : ∃ b : Fin 2, x₂ ∈ U b := by
        rcases (hU_union ▸ Set.mem_univ x₂) with h0 | h1
        · exact ⟨0, h0⟩
        · exact ⟨1, h1⟩
      obtain ⟨a, hxa⟩ := hx₁_mem
      obtain ⟨b, hxb⟩ := hx₂_mem
      obtain ⟨w, _, hwu, hwUb⟩ :=
        hPreU a u (U b : Set ↥P) hu (U b).isOpen ⟨x₁, hxa, hx₁⟩ ⟨z₀, hz₀ a, hz₀ b⟩
      obtain ⟨q, _, hqu, hqv⟩ :=
        hPreU b u v hu hv ⟨w, hwUb, hwu⟩ ⟨x₂, hxb, hx₂⟩
      exact ⟨q, trivial, hqu, hqv⟩
    have hy_dich : closure ({y} : Set ↥P) = Set.univ ∨ IsClosed ({y} : Set ↥P) := by
      by_cases hDense : closure ({y} : Set ↥P) = Set.univ
      · exact Or.inl hDense
      · right
        rw [← isOpen_compl_iff]
        have hcompl_eq : (({y} : Set ↥P)ᶜ) =
            ((U 0 : Set ↥P) \ {y}) ∪ ((U 1 : Set ↥P) \ {y}) := by
          ext w
          constructor
          · intro hwy
            rcases (hU_union ▸ Set.mem_univ w) with hw0 | hw1
            · exact Or.inl ⟨hw0, hwy⟩
            · exact Or.inr ⟨hw1, hwy⟩
          · rintro (⟨_, hwy⟩ | ⟨_, hwy⟩) <;> exact hwy
        rw [hcompl_eq]
        have hOpenDiff : ∀ a : Fin 2, IsOpen ((U a : Set ↥P) \ {y}) := by
          intro a
          by_cases hya : y ∈ U a
          · let y_a : ↥(U a) := ⟨y, hya⟩
            let p_a : PrimeSpectrum (Polynomial Ω) := (h_ch a).symm y_a
            have hp_ne_bot : p_a.asIdeal ≠ ⊥ := by
              intro hp_bot
              apply hDense
              have hcl_pa : closure ({p_a} : Set (PrimeSpectrum (Polynomial Ω))) = Set.univ := by
                rw [PrimeSpectrum.closure_singleton, hp_bot, PrimeSpectrum.zeroLocus_bot]
              have hya_eq : ({y_a} : Set ↥(U a)) = (h_ch a) '' ({p_a} : Set _) := by
                simp [p_a]
              have hcl_ya : closure ({y_a} : Set ↥(U a)) = Set.univ := by
                rw [hya_eq, ← (h_ch a).image_closure, hcl_pa]
                ext u
                exact ⟨fun _ => trivial, fun _ => ⟨(h_ch a).symm u, trivial, (h_ch a).apply_symm_apply u⟩⟩
              have hUa_sub : (U a : Set ↥P) ⊆ closure ({y} : Set ↥P) := by
                intro w hw
                have hw_ya : (⟨w, hw⟩ : ↥(U a)) ∈ closure ({y_a} : Set ↥(U a)) := by
                  rw [hcl_ya]
                  trivial
                have hmem : w ∈ closure ((Subtype.val : ↥(U a) → ↥P) '' ({y_a} : Set ↥(U a))) :=
                  image_closure_subset_closure_image continuous_subtype_val ⟨⟨w, hw⟩, hw_ya, rfl⟩
                simpa [y_a] using hmem
              have hDenseUa : Dense (U a : Set ↥P) := (U a).isOpen.dense ⟨y, hya⟩
              exact Set.Subset.antisymm (Set.subset_univ _)
                (hDenseUa.closure_eq ▸ closure_minimal hUa_sub isClosed_closure)
            have hp_max : p_a.asIdeal.IsMaximal := by
              have : p_a.asIdeal.IsPrime := p_a.isPrime
              exact IsPrime.to_maximal_ideal hp_ne_bot
            have hCl_pa : IsClosed ({p_a} : Set (PrimeSpectrum (Polynomial Ω))) :=
              (PrimeSpectrum.isClosed_singleton_iff_isMaximal p_a).mpr hp_max
            have hya_pre : ({y_a} : Set ↥(U a)) = (h_ch a).symm ⁻¹' ({p_a} : Set _) := by
              ext u
              simp [p_a, (h_ch a).symm.injective.eq_iff]
            have hCl_ya : IsClosed ({y_a} : Set ↥(U a)) := by
              rw [hya_pre]
              exact hCl_pa.preimage (h_ch a).symm.continuous
            have hDiff_img : (U a : Set ↥P) \ {y} =
                (U a).ι.base '' (({y_a} : Set ↥(U a))ᶜ) := by
              ext w
              constructor
              · rintro ⟨hw, hwy⟩
                refine ⟨⟨w, hw⟩, ?_, rfl⟩
                intro hEq
                exact hwy (congrArg Subtype.val hEq)
              · rintro ⟨⟨w', hw'⟩, hne, rfl⟩
                refine ⟨hw', ?_⟩
                intro hEq
                exact hne (Subtype.ext (Set.mem_singleton_iff.mp hEq))
            rw [hDiff_img]
            exact (U a).ι.isOpenEmbedding.isOpenMap _ hCl_ya.isOpen_compl
          · have hDiff_eq : (U a : Set ↥P) \ {y} = (U a : Set ↥P) := by
              ext w
              exact ⟨fun h => h.1, fun hw => ⟨hw, fun hEq => hya (Set.mem_singleton_iff.mp hEq ▸ hw)⟩⟩
            rw [hDiff_eq]
            exact (U a).isOpen
        exact (hOpenDiff 0).union (hOpenDiff 1)
    rcases hy_dich with hDenseY | hClY
    · left
      have hx_eq : ({x} : Set ↥E_sch) = hTop.symm '' ({y} : Set ↥P) := by
        simp [y]
      rw [hx_eq, ← hTop.symm.image_closure, hDenseY]
      ext w
      exact ⟨fun _ => trivial, fun _ => ⟨hTop w, trivial, hTop.symm_apply_apply w⟩⟩
    · right
      have hx_pre : ({x} : Set ↥E_sch) = hTop ⁻¹' ({y} : Set ↥P) := by
        ext w
        simp [y, hTop.injective.eq_iff]
      rw [hx_pre]
      exact hClY.preimage hTop.continuous

  have hPart2 :
      ∀ (Ω₁ Ω₂ : Type u) [Field Ω₁] [Field Ω₂] (φ : Ω₁ →+* Ω₂),
        let f_φ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
        AlgebraicGeometry.IsProper (weilProjectiveSpaceOver Ω₁ 1).hom ∧
        (∀ {X : AlgebraicGeometry.Scheme.{u}}
          (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω₁))
          [AlgebraicGeometry.LocallyOfFiniteType f],
          AlgebraicGeometry.LocallyOfFinitePresentation f) ∧
        (∃ e_pb : CategoryTheory.Limits.pullback (weilProjectiveSpaceOver Ω₁ 1).hom f_φ ≅
            (weilProjectiveSpaceOver Ω₂ 1).left,
          CategoryTheory.Limits.pullback.snd (weilProjectiveSpaceOver Ω₁ 1).hom f_φ =
            e_pb.hom ≫ (weilProjectiveSpaceOver Ω₂ 1).hom) := by
    intro Ω₁ Ω₂ _ _ φ f_φ
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) Ω₁
    let ℬ := MvPolynomial.homogeneousSubmodule (Fin 2) Ω₂
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra ℬ := MvPolynomial.gradedAlgebra
    have hPropP₁ : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver Ω₁ 1).hom := by
      change AlgebraicGeometry.IsProper
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω₁ ↥(𝒜 0))))
      have _ : IsScalarTower Ω₁ ↥(𝒜 0) (MvPolynomial (Fin 2) Ω₁) :=
        { smul_assoc := fun c x p => by
            change (c • x.1) * p = c • (x.1 * p)
            exact smul_mul_assoc c x.1 p }
      have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin 2) Ω₁) :=
        Algebra.FiniteType.of_restrictScalars_finiteType Ω₁ _ _
      have hBij : Function.Bijective (algebraMap Ω₁ ↥(𝒜 0)) := by
        refine ⟨?_, ?_⟩
        · intro c₁ c₂ hc
          have h1 := congrArg (fun z : ↥(𝒜 0) => z.1.coeff 0) hc
          simpa using h1
        · intro z
          refine ⟨z.1.coeff 0, Subtype.ext (MvPolynomial.ext _ _ fun d => ?_)⟩
          by_cases hd : d = 0
          · subst hd
            change (MvPolynomial.C (z.1.coeff 0)).coeff 0 = z.1.coeff 0
            simp
          · change (MvPolynomial.C (z.1.coeff 0)).coeff d = z.1.coeff d
            rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr fun h0 => absurd h0.symm hd]
            have hz_comp : MvPolynomial.homogeneousComponent 0 z.1 = z.1 := by
              rw [MvPolynomial.homogeneousComponent_of_mem z.2, ite_eq_left_iff.mpr (fun h => absurd rfl h)]
            have hc_eq := congrArg (fun q : MvPolynomial (Fin 2) Ω₁ => q.coeff d) hz_comp
            have hd_deg : Finsupp.degree d ≠ 0 := by
              intro hdeg0
              apply hd
              ext i
              rw [Finsupp.coe_zero, Pi.zero_apply]
              by_contra hi0
              have hi_supp : i ∈ d.support := Finsupp.mem_support_iff.mpr hi0
              have hle : d i ≤ Finsupp.degree d :=
                Finset.single_le_sum (fun _ _ => Nat.zero_le _) hi_supp
              omega
            rw [MvPolynomial.coeff_homogeneousComponent,
              ite_eq_right_iff.mpr (fun h => absurd h hd_deg)] at hc_eq
            exact hc_eq
      have _ : CategoryTheory.IsIso
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω₁ ↥(𝒜 0)))) :=
        AlgebraicGeometry.isIso_SpecMap_iff.mpr hBij
      infer_instance
    have hLFP : ∀ {X : AlgebraicGeometry.Scheme.{u}}
        (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω₁))
        [AlgebraicGeometry.LocallyOfFiniteType f],
        AlgebraicGeometry.LocallyOfFinitePresentation f := by
      intro X f _
      rw [AlgebraicGeometry.HasRingHomProperty.iff_appLE (P := @AlgebraicGeometry.LocallyOfFinitePresentation)]
      intro U V e
      have hFT : (f.appLE U V e).hom.FiniteType :=
        (AlgebraicGeometry.HasRingHomProperty.iff_appLE (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp
          inferInstance U V e
      have _ : IsNoetherianRing ↑((AlgebraicGeometry.Spec (CommRingCat.of Ω₁)).presheaf.obj (Opposite.op U.1)) :=
        AlgebraicGeometry.IsLocallyNoetherian.component_noetherian U
      exact RingHom.FinitePresentation.of_finiteType.mp hFT
    refine ⟨hPropP₁, hLFP, ?_⟩
    let p₁ : AlgebraicGeometry.Proj 𝒜 ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω₁) :=
      (weilProjectiveSpaceOver Ω₁ 1).hom
    let p₂ : AlgebraicGeometry.Proj ℬ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω₂) :=
      (weilProjectiveSpaceOver Ω₂ 1).hom
    let f_gr : 𝒜 →+*ᵍ ℬ :=
      { toRingHom := MvPolynomial.map φ
        map_mem := fun {i x} hx => by
          rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
          intro d hd
          rw [MvPolynomial.coeff_map] at hd
          exact hx (fun h0 => hd (by rw [h0, map_zero])) }
    have hf_X : ∀ a : Fin 2, f_gr (MvPolynomial.X a) = MvPolynomial.X a :=
      fun a => MvPolynomial.map_X φ a
    have hX₁_mem : ∀ a : Fin 2, (MvPolynomial.X a : MvPolynomial (Fin 2) Ω₁) ∈ 𝒜 1 :=
      fun a => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω₁ a)
    have hf_irrel : HomogeneousIdeal.irrelevant ℬ ≤
        HomogeneousIdeal.map f_gr (HomogeneousIdeal.irrelevant 𝒜) := by
      change (HomogeneousIdeal.irrelevant ℬ).toIdeal ≤
        Ideal.map f_gr.toRingHom (HomogeneousIdeal.irrelevant 𝒜).toIdeal
      refine (hDehom Ω₂).1.trans (Ideal.span_le.mpr ?_)
      rintro _ ⟨a, rfl⟩
      rw [← hf_X a]
      refine Ideal.mem_map_of_mem f_gr.toRingHom ?_
      change MvPolynomial.X a ∈ HomogeneousIdeal.irrelevant 𝒜
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
      rw [DirectSum.decompose_of_mem_ne 𝒜 (hX₁_mem a) (by decide)]
    let π : AlgebraicGeometry.Proj ℬ ⟶ AlgebraicGeometry.Proj 𝒜 :=
      AlgebraicGeometry.Proj.map f_gr hf_irrel
    have hX₂_mem : ∀ a : Fin 2, f_gr (MvPolynomial.X a) ∈ ℬ 1 :=
      fun a => f_gr.map_mem (hX₁_mem a)
    let U₁ : Fin 2 → (AlgebraicGeometry.Proj 𝒜).Opens :=
      fun a => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)
    let U₂ : Fin 2 → (AlgebraicGeometry.Proj ℬ).Opens :=
      fun a => AlgebraicGeometry.Proj.basicOpen ℬ (f_gr (MvPolynomial.X a))
    have hU₁_top : ⨆ a : Fin 2, U₁ a = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X (hDehom Ω₁).1
    have hU₂_top : ⨆ a : Fin 2, U₂ a = ⊤ := by
      have h_eq : U₂ = fun a => AlgebraicGeometry.Proj.basicOpen ℬ (MvPolynomial.X a) := by
        ext a : 1
        dsimp only [U₂]
        rw [hf_X a]
      rw [h_eq]
      exact AlgebraicGeometry.Proj.iSup_basicOpen_eq_top ℬ MvPolynomial.X (hDehom Ω₂).1
    let r₁ : ∀ a : Fin 2, CommRingCat.of Ω₁ ⟶
        CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a)) :=
      fun a => CommRingCat.ofHom
        ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap Ω₁ ↥(𝒜 0)))
    let r₂ : ∀ a : Fin 2, CommRingCat.of Ω₂ ⟶
        CommRingCat.of (HomogeneousLocalization.Away ℬ (f_gr (MvPolynomial.X a))) :=
      fun a => CommRingCat.ofHom
        ((HomogeneousLocalization.fromZeroRingHom ℬ
          (Submonoid.powers (f_gr (MvPolynomial.X a)))).comp
          (algebraMap Ω₂ ↥(ℬ 0)))
    let j₁ : ∀ a : Fin 2,
        AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a))) ⟶
          AlgebraicGeometry.Proj 𝒜 :=
      fun a => AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hX₁_mem a) zero_lt_one
    let j₂ : ∀ a : Fin 2,
        AlgebraicGeometry.Spec
          (CommRingCat.of (HomogeneousLocalization.Away ℬ (f_gr (MvPolynomial.X a)))) ⟶
          AlgebraicGeometry.Proj ℬ :=
      fun a => AlgebraicGeometry.Proj.awayι ℬ (f_gr (MvPolynomial.X a)) (hX₂_mem a) zero_lt_one
    have hj₁_p₁ : ∀ a : Fin 2, j₁ a ≫ p₁ = AlgebraicGeometry.Spec.map (r₁ a) := by
      intro a
      change j₁ a ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω₁ ↥(𝒜 0))) =
        AlgebraicGeometry.Spec.map (r₁ a)
      rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have hj₂_p₂ : ∀ a : Fin 2, j₂ a ≫ p₂ = AlgebraicGeometry.Spec.map (r₂ a) := by
      intro a
      change j₂ a ≫ AlgebraicGeometry.Proj.toSpecZero ℬ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω₂ ↥(ℬ 0))) =
        AlgebraicGeometry.Spec.map (r₂ a)
      rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have hr_sq : ∀ a : Fin 2,
        r₁ a ≫ CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a)) =
          CommRingCat.ofHom φ ≫ r₂ a := by
      intro a
      apply CommRingCat.Hom.ext
      refine RingHom.ext fun c => HomogeneousLocalization.val_injective _ ?_
      change Localization.mk (f_gr (MvPolynomial.C c)) ⟨f_gr 1, _⟩ =
        Localization.mk (MvPolynomial.C (φ c)) 1
      congr 1
      · exact MvPolynomial.map_C φ c
      · exact Subtype.ext (map_one f_gr.toRingHom)
    have h_comm : π ≫ p₁ = p₂ ≫ f_φ := by
      let 𝒰₂ := (AlgebraicGeometry.Proj ℬ).openCoverOfIsOpenCover U₂
        (TopologicalSpace.IsOpenCover.mk hU₂_top)
      apply 𝒰₂.hom_ext
      intro a
      change (U₂ a).ι ≫ π ≫ p₁ = (U₂ a).ι ≫ p₂ ≫ f_φ
      let iso₂ := AlgebraicGeometry.Proj.basicOpenIsoSpec ℬ (f_gr (MvPolynomial.X a)) (hX₂_mem a) zero_lt_one
      rw [← CategoryTheory.cancel_epi iso₂.inv]
      have hinv_ι : iso₂.inv ≫ (U₂ a).ι = j₂ a :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι ℬ (f_gr (MvPolynomial.X a)) (hX₂_mem a) zero_lt_one
      calc
        iso₂.inv ≫ (U₂ a).ι ≫ π ≫ p₁
          = (j₂ a ≫ π) ≫ p₁ := by rw [← CategoryTheory.Category.assoc, hinv_ι, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫
              (j₁ a ≫ p₁) := by
            rw [AlgebraicGeometry.Proj.awayι_comp_map, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (r₁ a ≫ CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) := by
            rw [hj₁_p₁ a, ← AlgebraicGeometry.Spec.map_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ ≫ r₂ a) := by rw [hr_sq a]
        _ = (j₂ a ≫ p₂) ≫ f_φ := by rw [AlgebraicGeometry.Spec.map_comp, ← hj₂_p₂ a]
        _ = iso₂.inv ≫ (U₂ a).ι ≫ p₂ ≫ f_φ := by
            rw [← hinv_ι, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
    let Φ_inv : AlgebraicGeometry.Proj ℬ ⟶ CategoryTheory.Limits.pullback p₁ f_φ :=
      CategoryTheory.Limits.pullback.lift π p₂ h_comm
    have hPushPoly : CategoryTheory.IsPushout
        (CommRingCat.ofHom (Polynomial.C : Ω₁ →+* Polynomial Ω₁))
        (CommRingCat.ofHom φ)
        (CommRingCat.ofHom (Polynomial.mapRingHom φ))
        (CommRingCat.ofHom (Polynomial.C : Ω₂ →+* Polynomial Ω₂)) := by
      have hcomm_poly : CommRingCat.ofHom (Polynomial.C : Ω₁ →+* Polynomial Ω₁) ≫
          CommRingCat.ofHom (Polynomial.mapRingHom φ) =
          CommRingCat.ofHom φ ≫ CommRingCat.ofHom (Polynomial.C : Ω₂ →+* Polynomial Ω₂) := by
        ext c
        simp
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_poly
          (fun s => CommRingCat.ofHom (Polynomial.eval₂RingHom s.inr.hom (s.inl.hom Polynomial.X)))
          (fun s => ?_) (fun s => ?_) (fun s m hm_inl hm_inr => ?_))
      · apply CommRingCat.Hom.ext
        apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun c => ?_
          have hw : s.inl.hom (Polynomial.C c) = s.inr.hom (φ c) :=
            congrArg (fun g : CommRingCat.of Ω₁ ⟶ s.pt => g.hom c) s.condition
          change Polynomial.eval₂ s.inr.hom (s.inl.hom Polynomial.X)
              (Polynomial.mapRingHom φ (Polynomial.C c)) = s.inl.hom (Polynomial.C c)
          rw [Polynomial.coe_mapRingHom, Polynomial.map_C, Polynomial.eval₂_C]
          exact hw.symm
        · change Polynomial.eval₂ s.inr.hom (s.inl.hom Polynomial.X)
              (Polynomial.mapRingHom φ Polynomial.X) = s.inl.hom Polynomial.X
          rw [Polynomial.coe_mapRingHom, Polynomial.map_X, Polynomial.eval₂_X]
      · ext c
        change Polynomial.eval₂ s.inr.hom (s.inl.hom Polynomial.X) (Polynomial.C c) = s.inr.hom c
        rw [Polynomial.eval₂_C]
      · apply CommRingCat.Hom.ext
        apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun c => ?_
          have hinr : m.hom (Polynomial.C c) = s.inr.hom c :=
            congrArg (fun g : CommRingCat.of Ω₂ ⟶ s.pt => g.hom c) hm_inr
          change m.hom (Polynomial.C c) =
            Polynomial.eval₂ s.inr.hom (s.inl.hom Polynomial.X) (Polynomial.C c)
          rw [Polynomial.eval₂_C]
          exact hinr
        · have hinl : m.hom (Polynomial.mapRingHom φ Polynomial.X) = s.inl.hom Polynomial.X :=
            congrArg (fun g : CommRingCat.of (Polynomial Ω₁) ⟶ s.pt => g.hom Polynomial.X) hm_inl
          rw [Polynomial.coe_mapRingHom, Polynomial.map_X] at hinl
          change m.hom Polynomial.X =
            Polynomial.eval₂ s.inr.hom (s.inl.hom Polynomial.X) Polynomial.X
          rw [Polynomial.eval₂_X]
          exact hinl
    have hPb_away : ∀ a : Fin 2,
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))))
          (j₂ a ≫ p₂) (j₁ a ≫ p₁) f_φ := by
      intro a
      obtain ⟨e₁, he₁_C, he₁_X⟩ := (hDehom Ω₁).2 a (MvPolynomial.X a) (hX₁_mem a) rfl
      obtain ⟨e₂, he₂_C, he₂_X⟩ := (hDehom Ω₂).2 a (f_gr (MvPolynomial.X a)) (hX₂_mem a) (hf_X a)
      have hPushAway : CategoryTheory.IsPushout
          (r₁ a) (CommRingCat.ofHom φ)
          (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a)))
          (r₂ a) := by
        refine hPushPoly.of_iso (CategoryTheory.Iso.refl _) e₁.toCommRingCatIso
          (CategoryTheory.Iso.refl _) e₂.toCommRingCatIso ?_ ?_ ?_ ?_
        · apply CommRingCat.Hom.ext
          refine RingHom.ext fun c => ?_
          exact he₁_C c
        · rfl
        · apply CommRingCat.Hom.ext
          apply Polynomial.ringHom_ext'
          · refine RingHom.ext fun c => HomogeneousLocalization.val_injective _ ?_
            change HomogeneousLocalization.val (e₂ (Polynomial.mapRingHom φ (Polynomial.C c))) =
              HomogeneousLocalization.val (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a) (e₁ (Polynomial.C c)))
            rw [Polynomial.coe_mapRingHom, Polynomial.map_C, he₂_C (φ c), he₁_C c]
            change Localization.mk (MvPolynomial.C (φ c)) 1 =
              Localization.mk (f_gr (MvPolynomial.C c)) ⟨f_gr 1, _⟩
            congr 1
            · exact (MvPolynomial.map_C φ c).symm
            · exact Subtype.ext (map_one f_gr.toRingHom).symm
          · apply HomogeneousLocalization.val_injective _
            change HomogeneousLocalization.val (e₂ (Polynomial.mapRingHom φ Polynomial.X)) =
              HomogeneousLocalization.val (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a) (e₁ Polynomial.X))
            rw [Polynomial.coe_mapRingHom, Polynomial.map_X, he₂_X, he₁_X]
            change Localization.mk (MvPolynomial.X (1 - a) ^ 1) ⟨f_gr (MvPolynomial.X a) ^ 1, _⟩ =
              Localization.mk (f_gr (MvPolynomial.X (1 - a) ^ 1)) ⟨f_gr (MvPolynomial.X a ^ 1), _⟩
            congr 1
            · exact ((map_pow f_gr.toRingHom _ 1).trans (by rw [MvPolynomial.map_X])).symm
            · apply Subtype.ext
              exact (map_pow f_gr.toRingHom _ 1).symm
        · apply CommRingCat.Hom.ext
          refine RingHom.ext fun c => ?_
          exact he₂_C c
      have hSpecPb := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPushAway
      rwa [← hj₁_p₁ a, ← hj₂_p₂ a] at hSpecPb
    let W : Fin 2 → (CategoryTheory.Limits.pullback p₁ f_φ).Opens :=
      fun a => (CategoryTheory.Limits.pullback.fst p₁ f_φ) ⁻¹ᵁ U₁ a
    have hW_top : ⨆ a : Fin 2, W a = ⊤ := by
      rw [eq_top_iff]
      intro x _
      have hx : (CategoryTheory.Limits.pullback.fst p₁ f_φ).base x ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜).Opens) := trivial
      rw [← hU₁_top, TopologicalSpace.Opens.mem_iSup] at hx
      obtain ⟨a, ha⟩ := hx
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ha⟩
    have hIsoΦ : CategoryTheory.IsIso Φ_inv := by
      refine (AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme) W hW_top).mpr
        fun a => ?_
      change CategoryTheory.IsIso (Φ_inv ∣_ W a)
      have hPre_eq : Φ_inv ⁻¹ᵁ W a = U₂ a := by
        calc
          Φ_inv ⁻¹ᵁ W a = (Φ_inv ≫ CategoryTheory.Limits.pullback.fst p₁ f_φ) ⁻¹ᵁ U₁ a := rfl
          _ = π ⁻¹ᵁ U₁ a := by rw [CategoryTheory.Limits.pullback.lift_fst]
          _ = U₂ a := AlgebraicGeometry.Proj.map_preimage_basicOpen f_gr hf_irrel (MvPolynomial.X a)
      let iso_pre : (U₂ a).toScheme ≅ (Φ_inv ⁻¹ᵁ W a).toScheme :=
        { hom := AlgebraicGeometry.Scheme.Hom.resLE (𝟙 (AlgebraicGeometry.Proj ℬ)) (Φ_inv ⁻¹ᵁ W a) (U₂ a)
            (show U₂ a ≤ (𝟙 (AlgebraicGeometry.Proj ℬ)) ⁻¹ᵁ (Φ_inv ⁻¹ᵁ W a) from hPre_eq.ge)
          inv := AlgebraicGeometry.Scheme.Hom.resLE (𝟙 (AlgebraicGeometry.Proj ℬ)) (U₂ a) (Φ_inv ⁻¹ᵁ W a)
            (show Φ_inv ⁻¹ᵁ W a ≤ (𝟙 (AlgebraicGeometry.Proj ℬ)) ⁻¹ᵁ (U₂ a) from hPre_eq.le)
          hom_inv_id := by
            rw [← CategoryTheory.cancel_mono (U₂ a).ι, CategoryTheory.Category.assoc,
              AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, CategoryTheory.Category.comp_id,
              AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          inv_hom_id := by
            rw [← CategoryTheory.cancel_mono (Φ_inv ⁻¹ᵁ W a).ι, CategoryTheory.Category.assoc,
              AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, CategoryTheory.Category.comp_id,
              AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp] }
      let iso_src : AlgebraicGeometry.Spec
          (CommRingCat.of (HomogeneousLocalization.Away ℬ (f_gr (MvPolynomial.X a)))) ≅
          (Φ_inv ⁻¹ᵁ W a).toScheme :=
        (AlgebraicGeometry.Proj.basicOpenIsoSpec ℬ (f_gr (MvPolynomial.X a)) (hX₂_mem a) zero_lt_one).symm ≪≫ iso_pre
      have hiso_src_ι : iso_src.hom ≫ (Φ_inv ⁻¹ᵁ W a).ι = j₂ a := by
        dsimp only [iso_src, iso_pre, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom]
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
          CategoryTheory.Category.comp_id]
        exact AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι ℬ (f_gr (MvPolynomial.X a)) (hX₂_mem a) zero_lt_one
      let fst_W : (W a).toScheme ⟶ (U₁ a).toScheme :=
        AlgebraicGeometry.Scheme.Hom.resLE (CategoryTheory.Limits.pullback.fst p₁ f_φ) (U₁ a) (W a) le_rfl
      have hPb_W_open : CategoryTheory.IsPullback fst_W (W a).ι (U₁ a).ι
          (CategoryTheory.Limits.pullback.fst p₁ f_φ) :=
        AlgebraicGeometry.IsOpenImmersion.isPullback fst_W (W a).ι (U₁ a).ι
          (CategoryTheory.Limits.pullback.fst p₁ f_φ)
          (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι _ _).symm
          (by ext x; simp [W, AlgebraicGeometry.Scheme.Opens.opensRange_ι])
      let iso_base := (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) (hX₁_mem a) zero_lt_one).symm
      have hiso_base_ι : iso_base.hom ≫ (U₁ a).ι = j₁ a :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (MvPolynomial.X a) (hX₁_mem a) zero_lt_one
      have hPb_base_iso : CategoryTheory.IsPullback (𝟙 (W a).toScheme) (fst_W ≫ iso_base.inv) fst_W iso_base.hom := by
        refine CategoryTheory.IsPullback.of_horiz_isIso ⟨?_⟩
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
          iso_base.inv_hom_id, CategoryTheory.Category.comp_id]
      have hPb_W_mid : CategoryTheory.IsPullback fst_W
          ((W a).ι ≫ CategoryTheory.Limits.pullback.snd p₁ f_φ)
          ((U₁ a).ι ≫ p₁) f_φ :=
        hPb_W_open.paste_vert (CategoryTheory.IsPullback.of_hasPullback p₁ f_φ)
      have hPb_Wa : CategoryTheory.IsPullback (fst_W ≫ iso_base.inv)
          ((W a).ι ≫ CategoryTheory.Limits.pullback.snd p₁ f_φ)
          (j₁ a ≫ p₁) f_φ := by
        have hp := hPb_base_iso.flip.paste_vert hPb_W_mid
        rw [CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc iso_base.hom, hiso_base_ι] at hp
        exact hp
      let g_cmp : AlgebraicGeometry.Spec
          (CommRingCat.of (HomogeneousLocalization.Away ℬ (f_gr (MvPolynomial.X a)))) ⟶ (W a).toScheme :=
        iso_src.hom ≫ (Φ_inv ∣_ W a)
      have hg_snd : g_cmp ≫ ((W a).ι ≫ CategoryTheory.Limits.pullback.snd p₁ f_φ) = j₂ a ≫ p₂ := by
        simp only [g_cmp, CategoryTheory.Category.assoc]
        rw [← CategoryTheory.Category.assoc (Φ_inv ∣_ W a), AlgebraicGeometry.morphismRestrict_ι,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, hiso_src_ι]
      have hg_fst : g_cmp ≫ (fst_W ≫ iso_base.inv) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) := by
        have _ : CategoryTheory.Mono (j₁ a) := inferInstance
        rw [← CategoryTheory.cancel_mono (j₁ a)]
        calc
          (g_cmp ≫ fst_W ≫ iso_base.inv) ≫ j₁ a
            = g_cmp ≫ fst_W ≫ (iso_base.inv ≫ iso_base.hom) ≫ (U₁ a).ι := by
                rw [← hiso_base_ι]
                simp only [CategoryTheory.Category.assoc]
          _ = g_cmp ≫ (fst_W ≫ (U₁ a).ι) := by
                rw [iso_base.inv_hom_id, CategoryTheory.Category.id_comp]
          _ = iso_src.hom ≫ ((Φ_inv ∣_ W a) ≫ (W a).ι) ≫ CategoryTheory.Limits.pullback.fst p₁ f_φ := by
                dsimp only [g_cmp]
                rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
                simp only [CategoryTheory.Category.assoc]
          _ = iso_src.hom ≫ (Φ_inv ⁻¹ᵁ W a).ι ≫ Φ_inv ≫ CategoryTheory.Limits.pullback.fst p₁ f_φ := by
                rw [AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
          _ = j₂ a ≫ π := by
                rw [CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc, hiso_src_ι]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫
                j₁ a := AlgebraicGeometry.Proj.awayι_comp_map f_gr hf_irrel zero_lt_one (MvPolynomial.X a) (hX₁_mem a)
      let iso_cones := hPb_away a |>.isLimit.conePointUniqueUpToIso hPb_Wa.isLimit
      have hg_eq : g_cmp = iso_cones.hom := by
        apply hPb_Wa.hom_ext
        · rw [hg_fst]
          exact ((hPb_away a).isLimit.conePointUniqueUpToIso_hom_comp hPb_Wa.isLimit
            CategoryTheory.Limits.WalkingCospan.left).symm
        · rw [hg_snd]
          exact ((hPb_away a).isLimit.conePointUniqueUpToIso_hom_comp hPb_Wa.isLimit
            CategoryTheory.Limits.WalkingCospan.right).symm
      have _ : CategoryTheory.IsIso g_cmp := hg_eq ▸ CategoryTheory.Iso.isIso_hom iso_cones
      exact CategoryTheory.IsIso.of_isIso_fac_left (f := iso_src.hom) (g := Φ_inv ∣_ W a) rfl
    let e_pb := (CategoryTheory.asIso Φ_inv).symm
    refine ⟨e_pb, ?_⟩
    change CategoryTheory.Limits.pullback.snd p₁ f_φ = e_pb.hom ≫ p₂
    have h1 : Φ_inv ≫ CategoryTheory.Limits.pullback.snd p₁ f_φ = p₂ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    rw [← h1]
    change _ = (CategoryTheory.asIso Φ_inv).inv ≫ (CategoryTheory.asIso Φ_inv).hom ≫ _
    rw [(CategoryTheory.asIso Φ_inv).inv_hom_id_assoc]

  have hPart3 :
      ∀ (Ω₁ Ω₂ : Type u) [Field Ω₁] [IsAlgClosed Ω₁] [Field Ω₂] (φ : Ω₁ →+* Ω₂),
        ∃ (J : Type u) (_ : CategoryTheory.SmallCategory J) (_ : CategoryTheory.IsFiltered J)
          (B_diag : J ⥤ CommRingCat.{u})
          (α_diag : (CategoryTheory.Functor.const J).obj (CommRingCat.of Ω₁) ⟶ B_diag)
          (ι_colim : B_diag ⟶ (CategoryTheory.Functor.const J).obj (CommRingCat.of Ω₂)),
          Nonempty (CategoryTheory.Limits.IsColimit
            (CategoryTheory.Limits.Cocone.mk (CommRingCat.of Ω₂) ι_colim)) ∧
          (∀ i : J, α_diag.app i ≫ ι_colim.app i = CommRingCat.ofHom φ) ∧
          (∀ i : J, ∃ ret_i : B_diag.obj i ⟶ CommRingCat.of Ω₁,
            α_diag.app i ≫ ret_i = 𝟙 (CommRingCat.of Ω₁)) := by
    intro Ω₁ Ω₂ _ _ _ φ
    let _ : Algebra Ω₁ Ω₂ := φ.toAlgebra
    let J : Type u := {S : Subalgebra Ω₁ Ω₂ // S.FG}
    let _ : Preorder J := Preorder.lift Subtype.val
    let _ : CategoryTheory.SmallCategory J := inferInstance
    have hNonemptyJ : Nonempty J := ⟨⟨⊥, Subalgebra.fg_bot⟩⟩
    have : CategoryTheory.IsFilteredOrEmpty J :=
      { cocone_objs := fun i j =>
          ⟨⟨i.1 ⊔ j.1, i.2.sup j.2⟩,
           CategoryTheory.homOfLE (le_sup_left : i.1 ≤ i.1 ⊔ j.1),
           CategoryTheory.homOfLE (le_sup_right : j.1 ≤ i.1 ⊔ j.1), trivial⟩
        cocone_maps := fun {i j} u v => ⟨j, 𝟙 j, Subsingleton.elim _ _⟩ }
    have : CategoryTheory.IsFiltered J :=
      { toIsFilteredOrEmpty := inferInstance
        nonempty := hNonemptyJ }
    let B_diag : J ⥤ CommRingCat.{u} :=
      { obj := fun i => CommRingCat.of ↥i.1
        map := fun {i j} u => CommRingCat.ofHom (Subalgebra.inclusion (CategoryTheory.leOfHom u)).toRingHom
        map_id := fun i => by ext x; rfl
        map_comp := fun u v => by ext x; rfl }
    let α_diag : (CategoryTheory.Functor.const J).obj (CommRingCat.of Ω₁) ⟶ B_diag :=
      { app := fun i => CommRingCat.ofHom (algebraMap Ω₁ ↥i.1)
        naturality := fun i j u => by ext c; rfl }
    let ι_colim : B_diag ⟶ (CategoryTheory.Functor.const J).obj (CommRingCat.of Ω₂) :=
      { app := fun i => CommRingCat.ofHom i.1.val.toRingHom
        naturality := fun i j u => by ext x; rfl }
    let idx : Ω₂ → J := fun z =>
      ⟨Algebra.adjoin Ω₁ (↑({z} : Finset Ω₂) : Set Ω₂), Subalgebra.fg_adjoin_finset {z}⟩
    have hmem_idx : ∀ z : Ω₂, z ∈ (idx z).1 := fun z =>
      Algebra.subset_adjoin (by simp)
    have hindep : ∀ (s : CategoryTheory.Limits.Cocone B_diag) (i : J) (z : Ω₂) (hz : z ∈ i.1),
        (s.ι.app i).hom ⟨z, hz⟩ = (s.ι.app (idx z)).hom ⟨z, hmem_idx z⟩ := by
      intro s i z hz
      have hle : (idx z).1 ≤ i.1 := by
        refine Algebra.adjoin_le fun w hw => ?_
        have hw_eq : w = z := by simpa using hw
        rwa [hw_eq]
      have hw := s.w (CategoryTheory.homOfLE hle : idx z ⟶ i)
      exact congrArg (fun g : B_diag.obj (idx z) ⟶ s.pt => g.hom ⟨z, hmem_idx z⟩) hw
    have hColim : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.Cocone.mk (CommRingCat.of Ω₂) ι_colim) :=
      { desc := fun s => CommRingCat.ofHom
          { toFun := fun z => (s.ι.app (idx z)).hom ⟨z, hmem_idx z⟩
            map_one' := by
              rw [← hindep s ⟨⊥, Subalgebra.fg_bot⟩ 1 (one_mem _)]
              exact map_one (s.ι.app ⟨⊥, Subalgebra.fg_bot⟩).hom
            map_mul' := fun x y => by
              let k : J := ⟨(idx x).1 ⊔ (idx y).1, (idx x).2.sup (idx y).2⟩
              have hx : x ∈ k.1 := SetLike.le_def.mp (le_sup_left : (idx x).1 ≤ k.1) (hmem_idx x)
              have hy : y ∈ k.1 := SetLike.le_def.mp (le_sup_right : (idx y).1 ≤ k.1) (hmem_idx y)
              rw [← hindep s k x hx, ← hindep s k y hy, ← hindep s k (x * y) (mul_mem hx hy)]
              exact map_mul (s.ι.app k).hom ⟨x, hx⟩ ⟨y, hy⟩
            map_zero' := by
              rw [← hindep s ⟨⊥, Subalgebra.fg_bot⟩ 0 (zero_mem _)]
              exact map_zero (s.ι.app ⟨⊥, Subalgebra.fg_bot⟩).hom
            map_add' := fun x y => by
              let k : J := ⟨(idx x).1 ⊔ (idx y).1, (idx x).2.sup (idx y).2⟩
              have hx : x ∈ k.1 := SetLike.le_def.mp (le_sup_left : (idx x).1 ≤ k.1) (hmem_idx x)
              have hy : y ∈ k.1 := SetLike.le_def.mp (le_sup_right : (idx y).1 ≤ k.1) (hmem_idx y)
              rw [← hindep s k x hx, ← hindep s k y hy, ← hindep s k (x + y) (add_mem hx hy)]
              exact map_add (s.ι.app k).hom ⟨x, hx⟩ ⟨y, hy⟩ }
        fac := fun s i => by
          ext ⟨z, hz⟩
          exact (hindep s i z hz).symm
        uniq := fun s m hm => by
          ext z
          exact congrArg (fun g : B_diag.obj (idx z) ⟶ s.pt => g.hom ⟨z, hmem_idx z⟩) (hm (idx z)) }
    refine ⟨J, inferInstance, inferInstance, B_diag, α_diag, ι_colim, ⟨hColim⟩, ?_, ?_⟩
    · intro i
      ext c
      rfl
    · intro i
      obtain ⟨F, hF⟩ := i.2
      let ψ : MvPolynomial ↥F Ω₁ →ₐ[Ω₁] ↥i.1 :=
        MvPolynomial.aeval (fun x : ↥F => (⟨x.1, hF ▸ Algebra.subset_adjoin x.2⟩ : ↥i.1))
      have hSurj : Function.Surjective ψ.toRingHom := by
        intro y
        have hSub : Algebra.adjoin Ω₁ (↑F : Set Ω₂) ≤ Subalgebra.map i.1.val ψ.range := by
          refine Algebra.adjoin_le fun z hz => ?_
          refine Subalgebra.mem_map.mpr ⟨⟨z, hF ▸ Algebra.subset_adjoin hz⟩, ?_, rfl⟩
          exact ⟨MvPolynomial.X ⟨z, hz⟩, by simp [ψ]⟩
        have hy_adjoin : (y : Ω₂) ∈ Algebra.adjoin Ω₁ (↑F : Set Ω₂) := by
          rw [hF]
          exact y.2
        obtain ⟨w, hw_range, hw_val⟩ := Subalgebra.mem_map.mp (SetLike.le_def.mp hSub hy_adjoin)
        obtain ⟨P, hP⟩ := hw_range
        exact ⟨P, hP.trans (Subtype.ext hw_val)⟩
      obtain ⟨𝔪, _⟩ := Ideal.exists_maximal ↥i.1
      have : (Ideal.comap ψ.toRingHom 𝔪).IsMaximal :=
        Ideal.comap_isMaximal_of_surjective ψ.toRingHom hSurj
      obtain ⟨x₀, hx₀⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton
          (I := Ideal.comap ψ.toRingHom 𝔪)).mp inferInstance
      let ev₀ : MvPolynomial ↥F Ω₁ →+* Ω₁ := MvPolynomial.eval x₀
      have hker : RingHom.ker ψ.toRingHom ≤ RingHom.ker ev₀ := by
        intro P hP
        have hmem_m : P ∈ Ideal.comap ψ.toRingHom 𝔪 := by
          change ψ.toRingHom P ∈ 𝔪
          rw [RingHom.mem_ker.mp hP]
          exact 𝔪.zero_mem
        rw [hx₀, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem_m
        exact hmem_m
      let qLift : MvPolynomial ↥F Ω₁ ⧸ RingHom.ker ψ.toRingHom →+* Ω₁ :=
        Ideal.Quotient.lift (RingHom.ker ψ.toRingHom) ev₀ (fun P hP => RingHom.mem_ker.mp (hker hP))
      let ret : ↥i.1 →+* Ω₁ :=
        qLift.comp (RingHom.quotientKerEquivOfSurjective hSurj).symm.toRingHom
      refine ⟨CommRingCat.ofHom ret, ?_⟩
      ext c
      have halg : algebraMap Ω₁ ↥i.1 c = ψ.toRingHom (MvPolynomial.C c) := by
        exact (ψ.commutes c).symm
      change ret (algebraMap Ω₁ ↥i.1 c) = c
      rw [halg]
      have hq : (RingHom.quotientKerEquivOfSurjective hSurj).symm (ψ.toRingHom (MvPolynomial.C c)) =
          Ideal.Quotient.mk (RingHom.ker ψ.toRingHom) (MvPolynomial.C c) := by
        apply (RingHom.quotientKerEquivOfSurjective hSurj).injective
        rw [RingEquiv.apply_symm_apply]
        rfl
      change qLift ((RingHom.quotientKerEquivOfSurjective hSurj).symm (ψ.toRingHom (MvPolynomial.C c))) = c
      rw [hq, Ideal.Quotient.lift_mk]
      exact MvPolynomial.eval_C c

  have hPart4 :
      ∀ {I : Type u} [CategoryTheory.SmallCategory I] [CategoryTheory.IsCofiltered I]
        (D : I ⥤ AlgebraicGeometry.Scheme.{u})
        {R : CommRingCat.{u}}
        (t : D ⟶ (CategoryTheory.Functor.const I).obj (AlgebraicGeometry.Spec R))
        {X : AlgebraicGeometry.Scheme.{u}}
        (f : X ⟶ AlgebraicGeometry.Spec R)
        (c : CategoryTheory.Limits.Cone D)
        (_ : CategoryTheory.Limits.IsLimit c)
        [∀ i : I, CompactSpace ↥(D.obj i)]
        [∀ i : I, QuasiSeparatedSpace ↥(D.obj i)]
        [∀ {i j : I} (u : i ⟶ j), AlgebraicGeometry.IsAffineHom (D.map u)]
        [AlgebraicGeometry.LocallyOfFinitePresentation f]
        (φ : c.pt ⟶ X),
        (∀ i : I, φ ≫ f = c.π.app i ≫ t.app i) →
        ∃ (i : I) (φ_i : D.obj i ⟶ X),
          φ_i ≫ f = t.app i ∧ c.π.app i ≫ φ_i = φ := by
    intro I _ _ D R t X f c hc _ _ _ _ φ hφ_over
    have hChartPt : ∀ x : ↥c.pt,
        ∃ (V : X.Opens) (U : c.pt.Opens),
          AlgebraicGeometry.IsAffineOpen V ∧
          AlgebraicGeometry.IsAffineOpen U ∧
          x ∈ U ∧ U ≤ φ ⁻¹ᵁ V := by
      intro x
      obtain ⟨V, hAffV, hxV, _⟩ :=
        TopologicalSpace.Opens.isBasis_iff_nbhd.mp
          (AlgebraicGeometry.Scheme.isBasis_affineOpens X)
          (show φ.base x ∈ (⊤ : X.Opens) from trivial)
      obtain ⟨U, hAffU, hxU, hle⟩ :=
        TopologicalSpace.Opens.isBasis_iff_nbhd.mp
          (AlgebraicGeometry.Scheme.isBasis_affineOpens c.pt)
          (show x ∈ φ ⁻¹ᵁ V from hxV)
      exact ⟨V, U, hAffV, hAffU, hxU, hle⟩
    choose V_pt U_pt hAffV_pt hAffU_pt hxU_pt hle_pt using hChartPt
    have hCovU : TopologicalSpace.IsOpenCover U_pt :=
      TopologicalSpace.IsOpenCover.mk
        (eq_top_iff.mpr fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxU_pt x⟩)
    obtain ⟨i₀, s, W₀, hCovW₀, hW₀⟩ :=
      AlgebraicGeometry.Scheme.exists_isOpenCover_and_isAffine D c hc U_pt hCovU hAffU_pt
    let ι_D : ∀ (W : (D.obj i₀).Opens) (u : CategoryTheory.Over i₀),
        (AlgebraicGeometry.opensDiagram D i₀ W).obj u ⟶ D.obj u.left :=
      fun W u => ((D.map u.hom) ⁻¹ᵁ W).ι
    let ι_c : ∀ (W : (D.obj i₀).Opens),
        (AlgebraicGeometry.opensCone D c i₀ W).pt ⟶ c.pt :=
      fun W => ((c.π.app i₀) ⁻¹ᵁ W).ι
    have hι_D_nat : ∀ (W : (D.obj i₀).Opens) {u v : CategoryTheory.Over i₀} (g : u ⟶ v),
        (AlgebraicGeometry.opensDiagram D i₀ W).map g ≫ ι_D W v = ι_D W u ≫ D.map g.left := by
      intro W u v g
      exact AlgebraicGeometry.Scheme.Hom.resLE_comp_ι (D.map g.left) _
    have hι_c_π : ∀ (W : (D.obj i₀).Opens) (u : CategoryTheory.Over i₀),
        (AlgebraicGeometry.opensCone D c i₀ W).π.app u ≫ ι_D W u = ι_c W ≫ c.π.app u.left := by
      intro W u
      exact AlgebraicGeometry.Scheme.Hom.resLE_comp_ι (c.π.app u.left) _
    have hLiftChart : ∀ a : ↥s,
        ∃ (u_a : CategoryTheory.Over i₀)
          (ψ_a : (AlgebraicGeometry.opensDiagram D i₀ (W₀ a)).obj u_a ⟶ X),
          ψ_a ≫ f = ι_D (W₀ a) u_a ≫ t.app u_a.left ∧
          (AlgebraicGeometry.opensCone D c i₀ (W₀ a)).π.app u_a ≫ ψ_a =
            ι_c (W₀ a) ≫ φ := by
      intro a
      let W_a := W₀ a
      have hAffW_a : AlgebraicGeometry.IsAffineOpen W_a := (hW₀ a).1
      have hU_eq : U_pt ↑a = (c.π.app i₀) ⁻¹ᵁ W_a := (hW₀ a).2
      let D_a : CategoryTheory.Over i₀ ⥤ AlgebraicGeometry.Scheme.{u} :=
        AlgebraicGeometry.opensDiagram D i₀ W_a
      let c_a := AlgebraicGeometry.opensCone D c i₀ W_a
      let hc_a := AlgebraicGeometry.isLimitOpensCone D c hc i₀ W_a
      have _ : ∀ u : CategoryTheory.Over i₀, AlgebraicGeometry.IsAffine (D_a.obj u) :=
        fun u => hAffW_a.preimage (D.map u.hom)
      let c'_a := AlgebraicGeometry.Scheme.Γ.rightOp.mapCone c_a
      let hc'_a := CategoryTheory.Limits.isLimitOfPreserves AlgebraicGeometry.Scheme.Γ.rightOp hc_a
      let J_a := (CategoryTheory.Over i₀)ᵒᵖ
      let F_a : J_a ⥤ CommRingCat.{u} := (D_a ⋙ AlgebraicGeometry.Scheme.Γ.rightOp).leftOp
      let κ_a : CategoryTheory.Limits.Cocone F_a := CategoryTheory.Limits.coconeLeftOpOfCone c'_a
      let hκ_a : CategoryTheory.Limits.IsColimit κ_a :=
        CategoryTheory.Limits.isColimitCoconeLeftOpOfCone (D_a ⋙ AlgebraicGeometry.Scheme.Γ.rightOp) hc'_a
      let V_a := V_pt ↑a
      have hAffV_a : AlgebraicGeometry.IsAffineOpen V_a := hAffV_pt ↑a
      let S_a : CommRingCat.{u} := X.presheaf.obj (Opposite.op V_a)
      let j_V : AlgebraicGeometry.Spec S_a ⟶ X := hAffV_a.fromSpec
      have _ : AlgebraicGeometry.LocallyOfFinitePresentation (j_V ≫ f) := inferInstance
      let r_a : R ⟶ S_a := AlgebraicGeometry.Spec.preimage (j_V ≫ f)
      have hr_Spec : AlgebraicGeometry.Spec.map r_a = j_V ≫ f :=
        AlgebraicGeometry.Spec.map_preimage (j_V ≫ f)
      have hr_fp : r_a.hom.FinitePresentation := by
        have hSpecLFP : AlgebraicGeometry.LocallyOfFinitePresentation (AlgebraicGeometry.Spec.map r_a) := by
          rw [hr_Spec]
          infer_instance
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mp hSpecLFP
      have hRange_a : Set.range (ι_c W_a ≫ φ).base ⊆ Set.range j_V.base := by
        rw [AlgebraicGeometry.IsAffineOpen.range_fromSpec]
        rintro _ ⟨x, rfl⟩
        have hx_U : ((c.π.app i₀) ⁻¹ᵁ W_a).ι.base x ∈ U_pt ↑a := by
          rw [hU_eq]
          exact x.2
        exact SetLike.le_def.mp (hle_pt ↑a) hx_U
      let φ_a : c_a.pt ⟶ AlgebraicGeometry.Spec S_a :=
        AlgebraicGeometry.IsOpenImmersion.lift j_V (ι_c W_a ≫ φ) hRange_a
      have hφ_a_fac : φ_a ≫ j_V = ι_c W_a ≫ φ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac j_V (ι_c W_a ≫ φ) hRange_a
      let α_a : (CategoryTheory.Functor.const J_a).obj R ⟶ F_a :=
        { app := fun u =>
            ((AlgebraicGeometry.ΓSpec.adjunction.homEquiv (D_a.obj u.unop) (Opposite.op R)).symm
              (ι_D W_a u.unop ≫ t.app u.unop.left)).unop
          naturality := fun {u v} g => by
            apply Quiver.Hom.op_inj
            dsimp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
              CategoryTheory.Category.id_comp, F_a, CategoryTheory.Functor.leftOp_obj,
              CategoryTheory.Functor.leftOp_map, CategoryTheory.op_comp, Quiver.Hom.op_unop]
            symm
            change AlgebraicGeometry.Scheme.Γ.rightOp.map (D_a.map g.unop) ≫
                (AlgebraicGeometry.ΓSpec.adjunction.homEquiv (D_a.obj u.unop) (Opposite.op R)).symm
                  (ι_D W_a u.unop ≫ t.app u.unop.left) =
              (AlgebraicGeometry.ΓSpec.adjunction.homEquiv (D_a.obj v.unop) (Opposite.op R)).symm
                (ι_D W_a v.unop ≫ t.app v.unop.left)
            rw [← AlgebraicGeometry.ΓSpec.adjunction.homEquiv_naturality_left_symm]
            congr 1
            rw [← CategoryTheory.Category.assoc, hι_D_nat W_a g.unop, CategoryTheory.Category.assoc]
            have ht_nat := t.naturality g.unop.left
            dsimp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map] at ht_nat
            rw [CategoryTheory.Category.comp_id] at ht_nat
            rw [ht_nat] }
      let g_a : S_a ⟶ κ_a.pt :=
        ((AlgebraicGeometry.ΓSpec.adjunction.homEquiv c_a.pt (Opposite.op S_a)).symm φ_a).unop
      have hg_compat : ∀ u : J_a, r_a ≫ g_a = α_a.app u ≫ κ_a.ι.app u := by
        intro u
        apply Quiver.Hom.op_inj
        change g_a.op ≫ r_a.op =
          AlgebraicGeometry.Scheme.Γ.rightOp.map (c_a.π.app u.unop) ≫ (α_a.app u).op
        dsimp only [g_a, α_a, Quiver.Hom.op_unop]
        rw [← AlgebraicGeometry.ΓSpec.adjunction.homEquiv_naturality_right_symm]
        refine Eq.trans ?_
          (AlgebraicGeometry.ΓSpec.adjunction.homEquiv_naturality_left_symm
            (c_a.π.app u.unop) (ι_D W_a u.unop ≫ t.app u.unop.left))
        congr 1
        calc
          φ_a ≫ AlgebraicGeometry.Scheme.Spec.map r_a.op
            = (φ_a ≫ j_V) ≫ f := by
                change φ_a ≫ AlgebraicGeometry.Spec.map r_a = (φ_a ≫ j_V) ≫ f
                rw [hr_Spec, CategoryTheory.Category.assoc]
          _ = ι_c W_a ≫ φ ≫ f := by rw [hφ_a_fac, CategoryTheory.Category.assoc]
          _ = (ι_c W_a ≫ c.π.app u.unop.left) ≫ t.app u.unop.left := by
                rw [hφ_over u.unop.left, CategoryTheory.Category.assoc]
          _ = c_a.π.app u.unop ≫ ι_D W_a u.unop ≫ t.app u.unop.left := by
                rw [← hι_c_π W_a u.unop, CategoryTheory.Category.assoc]
      obtain ⟨u_op, q_a, hq_over, hq_colim⟩ :=
        RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit R F_a α_a r_a κ_a hκ_a hr_fp g_a hg_compat
      let u_a := u_op.unop
      let ψ_loc : D_a.obj u_a ⟶ AlgebraicGeometry.Spec S_a :=
        AlgebraicGeometry.ΓSpec.adjunction.homEquiv (D_a.obj u_a) (Opposite.op S_a) q_a.op
      let ψ_a : D_a.obj u_a ⟶ X := ψ_loc ≫ j_V
      refine ⟨u_a, ψ_a, ?_, ?_⟩
      · have h1 : ψ_a ≫ f = ψ_loc ≫ AlgebraicGeometry.Scheme.Spec.map r_a.op := by
          change (ψ_loc ≫ j_V) ≫ f = ψ_loc ≫ AlgebraicGeometry.Spec.map r_a
          rw [CategoryTheory.Category.assoc, hr_Spec]
        have h2 : ψ_loc ≫ AlgebraicGeometry.Scheme.Spec.map r_a.op =
            AlgebraicGeometry.ΓSpec.adjunction.homEquiv (D_a.obj u_a) (Opposite.op R)
              (q_a.op ≫ r_a.op) :=
          (@CategoryTheory.Adjunction.homEquiv_naturality_right _ _ _ _ _ _
            AlgebraicGeometry.ΓSpec.adjunction (D_a.obj u_a) (Opposite.op S_a) (Opposite.op R)
            q_a.op r_a.op).symm
        have h3 : q_a.op ≫ r_a.op = (α_a.app u_op).op := by
          rw [← CategoryTheory.op_comp, hq_over]
        rw [h1, h2, h3]
        dsimp only [α_a, Quiver.Hom.op_unop, u_a]
        exact Equiv.apply_symm_apply _ _
      · have h1 : c_a.π.app u_a ≫ ψ_loc =
            AlgebraicGeometry.ΓSpec.adjunction.homEquiv c_a.pt (Opposite.op S_a)
              (AlgebraicGeometry.Scheme.Γ.rightOp.map (c_a.π.app u_a) ≫ q_a.op) :=
          (AlgebraicGeometry.ΓSpec.adjunction.homEquiv_naturality_left
            (c_a.π.app u_a) q_a.op).symm
        have h2 : AlgebraicGeometry.Scheme.Γ.rightOp.map (c_a.π.app u_a) ≫ q_a.op = g_a.op := by
          exact (congrArg Quiver.Hom.op hq_colim).symm
        have h3 : AlgebraicGeometry.ΓSpec.adjunction.homEquiv c_a.pt (Opposite.op S_a) g_a.op = φ_a := by
          dsimp only [g_a, Quiver.Hom.op_unop]
          exact Equiv.apply_symm_apply _ _
        calc
          c_a.π.app u_a ≫ ψ_a = (c_a.π.app u_a ≫ ψ_loc) ≫ j_V :=
            (CategoryTheory.Category.assoc _ _ _).symm
          _ = φ_a ≫ j_V := by rw [h1, h2, h3]
          _ = ι_c W_a ≫ φ := hφ_a_fac
    choose u_ch ψ_ch hψ_over hψ_cone using hLiftChart
    have hCommon1 : ∃ u₁ : CategoryTheory.Over i₀, ∀ a : ↥s, Nonempty (u₁ ⟶ u_ch a) := by
      classical
      suffices ∀ S : Finset ↥s, ∃ u₁ : CategoryTheory.Over i₀, ∀ a ∈ S, Nonempty (u₁ ⟶ u_ch a) by
        obtain ⟨u₁, hu₁⟩ := this Finset.univ
        exact ⟨u₁, fun a => hu₁ a (Finset.mem_univ a)⟩
      intro S
      refine Finset.induction_on S ?_ ?_
      · exact ⟨CategoryTheory.Over.mk (𝟙 i₀), fun _ h => absurd h (Finset.notMem_empty _)⟩
      · intro a S' _ ⟨u_S, hu_S⟩
        refine ⟨CategoryTheory.IsCofiltered.min u_S (u_ch a), fun b hb => ?_⟩
        rcases Finset.mem_insert.mp hb with rfl | hb'
        · exact ⟨CategoryTheory.IsCofiltered.minToRight u_S (u_ch b)⟩
        · obtain ⟨m_b⟩ := hu_S b hb'
          exact ⟨CategoryTheory.IsCofiltered.minToLeft u_S (u_ch a) ≫ m_b⟩
    obtain ⟨u₁, hm₁⟩ := hCommon1
    let m₁ : ∀ a : ↥s, u₁ ⟶ u_ch a := fun a => Classical.choice (hm₁ a)
    let ψ₁ : ∀ a : ↥s, (AlgebraicGeometry.opensDiagram D i₀ (W₀ a)).obj u₁ ⟶ X :=
