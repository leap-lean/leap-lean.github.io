        change Set.range (fst_ab ≫ (W_star a).ι).base ⊆
          Set.range ((D.map u_star.hom) ⁻¹ᵁ (W₀ a ⊓ W₀ b)).ι.base
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨z, rfl⟩
        have hz_a : (fst_ab ≫ (W_star a).ι).base z ∈ W_star a := (fst_ab.base z).2
        have hz_b : (fst_ab ≫ (W_star a).ι).base z ∈ W_star b := by
          change (fst_ab ≫ ι_D (W₀ a) u_star).base z ∈ W_star b
          rw [hPb_cond]
          exact (snd_ab.base z).2
        exact ⟨hz_a, hz_b⟩
      let ℓ : CategoryTheory.Limits.pullback (ι_D (W₀ a) u_star) (ι_D (W₀ b) u_star) ⟶
          (AlgebraicGeometry.opensDiagram D i₀ (W₀ a ⊓ W₀ b)).obj u_star :=
        AlgebraicGeometry.IsOpenImmersion.lift (ι_D (W₀ a ⊓ W₀ b) u_star)
          (fst_ab ≫ ι_D (W₀ a) u_star) hRange_ab
      have hℓ_fac : ℓ ≫ ι_D (W₀ a ⊓ W₀ b) u_star = fst_ab ≫ ι_D (W₀ a) u_star :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
      have hℓ_L : ℓ ≫ inc_diag_L a b u_star = fst_ab := by
        have _ : CategoryTheory.Mono (ι_D (W₀ a) u_star) :=
          show CategoryTheory.Mono (W_star a).ι from inferInstance
        rw [← CategoryTheory.cancel_mono (ι_D (W₀ a) u_star), CategoryTheory.Category.assoc,
          hinc_L_ι a b u_star, hℓ_fac]
      have hℓ_R : ℓ ≫ inc_diag_R a b u_star = snd_ab := by
        have _ : CategoryTheory.Mono (ι_D (W₀ b) u_star) :=
          show CategoryTheory.Mono (W_star b).ι from inferInstance
        rw [← CategoryTheory.cancel_mono (ι_D (W₀ b) u_star), CategoryTheory.Category.assoc,
          hinc_R_ι a b u_star, hℓ_fac, hPb_cond]
      obtain ⟨k_ab, hk_ab⟩ := hfac_star (a, b)
      have hinc_L_nat : inc_diag_L a b u_star ≫ (AlgebraicGeometry.opensDiagram D i₀ (W₀ a)).map m_star =
          (AlgebraicGeometry.opensDiagram D i₀ (W₀ a ⊓ W₀ b)).map m_star ≫ inc_diag_L a b u₁ := by
        have _ : CategoryTheory.Mono (ι_D (W₀ a) u₁) :=
          show CategoryTheory.Mono ((D.map u₁.hom) ⁻¹ᵁ (W₀ a)).ι from inferInstance
        rw [← CategoryTheory.cancel_mono (ι_D (W₀ a) u₁), CategoryTheory.Category.assoc,
          hι_D_nat (W₀ a) m_star, ← CategoryTheory.Category.assoc, hinc_L_ι a b u_star,
          CategoryTheory.Category.assoc, hinc_L_ι a b u₁, hι_D_nat (W₀ a ⊓ W₀ b) m_star]
      have hinc_R_nat : inc_diag_R a b u_star ≫ (AlgebraicGeometry.opensDiagram D i₀ (W₀ b)).map m_star =
          (AlgebraicGeometry.opensDiagram D i₀ (W₀ a ⊓ W₀ b)).map m_star ≫ inc_diag_R a b u₁ := by
        have _ : CategoryTheory.Mono (ι_D (W₀ b) u₁) :=
          show CategoryTheory.Mono ((D.map u₁.hom) ⁻¹ᵁ (W₀ b)).ι from inferInstance
        rw [← CategoryTheory.cancel_mono (ι_D (W₀ b) u₁), CategoryTheory.Category.assoc,
          hι_D_nat (W₀ b) m_star, ← CategoryTheory.Category.assoc, hinc_R_ι a b u_star,
          CategoryTheory.Category.assoc, hinc_R_ι a b u₁, hι_D_nat (W₀ a ⊓ W₀ b) m_star]
      calc
        fst_ab ≫ ψ_star a
          = ℓ ≫ (inc_diag_L a b u_star ≫ (AlgebraicGeometry.opensDiagram D i₀ (W₀ a)).map m_star) ≫ ψ₁ a := by
              rw [← hℓ_L]; dsimp only [ψ_star]; simp only [CategoryTheory.Category.assoc]
        _ = ℓ ≫ (AlgebraicGeometry.opensDiagram D i₀ (W₀ a ⊓ W₀ b)).map k_ab ≫
              ((AlgebraicGeometry.opensDiagram D i₀ (W₀ a ⊓ W₀ b)).map (μ_ov (a, b)) ≫
                inc_diag_L a b u₁ ≫ ψ₁ a) := by
              rw [hinc_L_nat, ← hk_ab, Functor.map_comp]
              simp only [CategoryTheory.Category.assoc]
        _ = ℓ ≫ (AlgebraicGeometry.opensDiagram D i₀ (W₀ a ⊓ W₀ b)).map k_ab ≫
              ((AlgebraicGeometry.opensDiagram D i₀ (W₀ a ⊓ W₀ b)).map (μ_ov (a, b)) ≫
                inc_diag_R a b u₁ ≫ ψ₁ b) := by
              rw [hμ_ov (a, b)]
        _ = ℓ ≫ (inc_diag_R a b u_star ≫ (AlgebraicGeometry.opensDiagram D i₀ (W₀ b)).map m_star) ≫ ψ₁ b := by
              rw [hinc_R_nat, ← hk_ab, Functor.map_comp]
              simp only [CategoryTheory.Category.assoc]
        _ = snd_ab ≫ ψ_star b := by
              dsimp only [ψ_star]
              rw [← CategoryTheory.Category.assoc ℓ, ← CategoryTheory.Category.assoc ℓ, hℓ_R,
                CategoryTheory.Category.assoc]
    let φ_star : D.obj i_star ⟶ X := 𝒰_star.glueMorphisms ψ_star hGlueCompat
    have hφ_star_ι : ∀ a : ↥s, ι_D (W₀ a) u_star ≫ φ_star = ψ_star a :=
      fun a => 𝒰_star.ι_glueMorphisms ψ_star hGlueCompat a
    refine ⟨i_star, φ_star, ?_, ?_⟩
    · apply 𝒰_star.hom_ext
      intro (a : ↥s)
      change (ι_D (W₀ a) u_star ≫ φ_star) ≫ f = ι_D (W₀ a) u_star ≫ t.app i_star
      rw [hφ_star_ι a]
