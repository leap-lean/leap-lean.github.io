            (hι_D_nat W_ab g).symm ?_
          change (D.map g.left) ⁻¹ᵁ ((D.map w.hom) ⁻¹ᵁ W_ab).ι.opensRange =
            ((D.map v.hom) ⁻¹ᵁ W_ab).ι.opensRange
          rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι,
            AlgebraicGeometry.Scheme.Opens.opensRange_ι]
          ext x
          change (D.map g.left ≫ D.map w.hom).base x ∈ W_ab ↔ (D.map v.hom).base x ∈ W_ab
          rw [hw_hom]
        exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ab.flip
          (inferInstance : AlgebraicGeometry.IsAffineHom (D.map g.left))
      let t_ab : D_ab ⟶ (CategoryTheory.Functor.const (CategoryTheory.Over i₀)).obj (AlgebraicGeometry.Spec R) :=
        { app := fun v => ι_D W_ab v ≫ t.app v.left
          naturality := fun {v w} g => by
            dsimp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map]
            rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc,
              hι_D_nat W_ab g, CategoryTheory.Category.assoc]
            have ht_nat := t.naturality g.left
            dsimp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map] at ht_nat
            rw [CategoryTheory.Category.comp_id] at ht_nat
            rw [ht_nat] }
      have hL_over : t_ab.app u₁ = (inc_diag_L a b u₁ ≫ ψ₁ a) ≫ f := by
        rw [CategoryTheory.Category.assoc, hψ₁_over a, ← CategoryTheory.Category.assoc,
          hinc_L_ι a b u₁]
      have hR_over : t_ab.app u₁ = (inc_diag_R a b u₁ ≫ ψ₁ b) ≫ f := by
        rw [CategoryTheory.Category.assoc, hψ₁_over b, ← CategoryTheory.Category.assoc,
          hinc_R_ι a b u₁]
      have hLR_cone : c_ab.π.app u₁ ≫ (inc_diag_L a b u₁ ≫ ψ₁ a) =
          c_ab.π.app u₁ ≫ (inc_diag_R a b u₁ ≫ ψ₁ b) := by
        let res_c_L : c_ab.pt ⟶ (AlgebraicGeometry.opensCone D c i₀ (W₀ a)).pt :=
          AlgebraicGeometry.Scheme.Hom.resLE (𝟙 c.pt)
            ((c.π.app i₀) ⁻¹ᵁ (W₀ a)) ((c.π.app i₀) ⁻¹ᵁ W_ab) (by intro x hx; exact hx.1)
        let res_c_R : c_ab.pt ⟶ (AlgebraicGeometry.opensCone D c i₀ (W₀ b)).pt :=
          AlgebraicGeometry.Scheme.Hom.resLE (𝟙 c.pt)
            ((c.π.app i₀) ⁻¹ᵁ (W₀ b)) ((c.π.app i₀) ⁻¹ᵁ W_ab) (by intro x hx; exact hx.2)
        have hres_c_L_ι : res_c_L ≫ ι_c (W₀ a) = ι_c W_ab :=
          (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι _ _).trans (CategoryTheory.Category.comp_id _)
        have hres_c_R_ι : res_c_R ≫ ι_c (W₀ b) = ι_c W_ab :=
          (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι _ _).trans (CategoryTheory.Category.comp_id _)
        have hπ_L : c_ab.π.app u₁ ≫ inc_diag_L a b u₁ =
            res_c_L ≫ (AlgebraicGeometry.opensCone D c i₀ (W₀ a)).π.app u₁ := by
          have _ : CategoryTheory.Mono (ι_D (W₀ a) u₁) :=
            show CategoryTheory.Mono ((D.map u₁.hom) ⁻¹ᵁ (W₀ a)).ι from inferInstance
          rw [← CategoryTheory.cancel_mono (ι_D (W₀ a) u₁)]
          rw [CategoryTheory.Category.assoc, hinc_L_ι a b u₁, hι_c_π W_ab u₁,
            CategoryTheory.Category.assoc, hι_c_π (W₀ a) u₁, ← CategoryTheory.Category.assoc,
            hres_c_L_ι]
        have hπ_R : c_ab.π.app u₁ ≫ inc_diag_R a b u₁ =
            res_c_R ≫ (AlgebraicGeometry.opensCone D c i₀ (W₀ b)).π.app u₁ := by
          have _ : CategoryTheory.Mono (ι_D (W₀ b) u₁) :=
            show CategoryTheory.Mono ((D.map u₁.hom) ⁻¹ᵁ (W₀ b)).ι from inferInstance
          rw [← CategoryTheory.cancel_mono (ι_D (W₀ b) u₁)]
          rw [CategoryTheory.Category.assoc, hinc_R_ι a b u₁, hι_c_π W_ab u₁,
            CategoryTheory.Category.assoc, hι_c_π (W₀ b) u₁, ← CategoryTheory.Category.assoc,
            hres_c_R_ι]
        calc
          c_ab.π.app u₁ ≫ (inc_diag_L a b u₁ ≫ ψ₁ a)
