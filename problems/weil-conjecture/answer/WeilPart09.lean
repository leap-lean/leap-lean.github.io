        (CategoryTheory.Limits.pullback.snd g (f_base i))

    obtain ⟨j₂, 𝒰₁, 𝒰₂, hSup_𝒰, hInf_𝒰, hPre_𝒰₁, hPre_𝒰₂⟩ :=
