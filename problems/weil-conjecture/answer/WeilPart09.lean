        ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3) := by
    intro L _ _ _ _ 𝔪
    have liftQuotLinear : ∀ {R V : Type u} [CommRing R] [Algebra Ω R] [AddCommGroup V] [Module Ω V]
        (J : Ideal R) (f : R →ₗ[Ω] V), (∀ x ∈ J, f x = 0) →
        ∃ g : (R ⧸ J) →ₗ[Ω] V, ∀ a : R, g (Ideal.Quotient.mk J a) = f a := by
      intro R V _ _ _ _ J f hf
      refine ⟨{
        toFun := Quotient.lift f (fun a b hab => by
          have hsub : a - b ∈ J := by
            simpa [Submodule.quotientRel_def] using hab
          have hba : b - a ∈ J := by
            have hneg := J.neg_mem hsub
            simpa [neg_sub] using hneg
