      let inv_c : D := algebraMap Ω D c_t⁻¹
      let a₂₀ : D := -inv_c * c₃₀ * d_u
      let a₁₁ : D := inv_c * t₁₁
      let a₀₂ : D := -inv_c * c₀₃ * d_v
      have ha₂₀_mem : a₂₀ ∈ q.asIdeal := Ideal.mul_mem_left q.asIdeal _ hdu_mem
      have ha₀₂_mem : a₀₂ ∈ q.asIdeal := Ideal.mul_mem_left q.asIdeal _ hdv_mem
      have ha₁₁_mem : a₁₁ - 1 ∈ q.asIdeal := by
        rw [← hres_ker]
        change res_Ω (algebraMap Ω D c_t⁻¹ * t₁₁ - 1) = 0
        rw [map_sub, map_mul, map_one, hres_c]
        change c_t⁻¹ * c_t - 1 = 0
        rw [inv_mul_cancel₀ hc_t_ne, sub_self]
