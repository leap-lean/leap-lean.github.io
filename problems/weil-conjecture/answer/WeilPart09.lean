          (Algebra.SubmersivePresentation.localizationAway D'_4 δ_Z).jacobian_isUnit
      let Sub_tot : Algebra.SubmersivePresentation D D'_4 (Unit ⊕ (Unit ⊕ Unit)) (Unit ⊕ (Unit ⊕ Unit)) :=
        { P_tot with jacobian_isUnit := h_jac_tot }
      have h_dim_tot : Sub_tot.dimension = 0 := by
        change (loc2.comp (loc1.comp P_DQ)).dimension = 0
        rw [loc2.dimension_comp_eq_dimension_add_dimension P_12,
          loc1.dimension_comp_eq_dimension_add_dimension P_DQ]
        have h1 : loc2.dimension = 0 := by simp [Algebra.Presentation.dimension]
        have h2 : loc1.dimension = 0 := by simp [Algebra.Presentation.dimension]
        have h3 : P_DQ.dimension = 0 := by simp [Algebra.Presentation.dimension]
        omega
      have : Algebra.IsStandardSmoothOfRelativeDimension 0 D D'_4 :=
        Sub_tot.isStandardSmoothOfRelativeDimension h_dim_tot
      infer_instance
    have hα_bar_DQ : ∀ v : D_Q, ∃ q₀ : Q_big, α_bar q₀ = ι_DQ_DQZ v := by
      intro v
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective v
      induction P using MvPolynomial.induction_on with
      | C d =>
        obtain ⟨F, rfl⟩ := h_aeval_y_surj d
        refine ⟨π_big (ι_aux F), ?_⟩
        change α_big (ι_aux F) = ι_DQ_DQZ (π_DQ (MvPolynomial.C (MvPolynomial.aeval y F)))
        rw [hα_aux]
        exact IsScalarTower.algebraMap_apply D D_Q D_QZ (MvPolynomial.aeval y F)
      | add P₁ P₂ ih₁ ih₂ =>
        obtain ⟨q₁, hq₁⟩ := ih₁
        obtain ⟨q₂, hq₂⟩ := ih₂
        exact ⟨q₁ + q₂, by rw [map_add, map_add, map_add, hq₁, hq₂]⟩
      | mul_X P' u ih' =>
        obtain ⟨q', hq'⟩ := ih'
        have hu : u = () := Subsingleton.elim u ()
        subst hu
        refine ⟨q' * π_big Z_b, ?_⟩
        have hZ : α_bar (π_big Z_b) = ζ := hα_Z
        rw [map_mul, map_mul, map_mul, hq', hZ]
    have hΨ₄_surj : Function.Surjective Ψ₄ := by
      intro w
      obtain ⟨m, x, hx_eq⟩ := IsLocalization.Away.surj δ_Z w
      obtain ⟨n, v, hv_eq⟩ := IsLocalization.Away.surj z_Q x
      obtain ⟨q₀, hq₀⟩ := hα_bar_DQ v
      obtain ⟨u_δB, hu_δB⟩ := IsLocalization.Away.algebraMap_isUnit (S := B₄) δ_big
      obtain ⟨u_δD, hu_δD⟩ := IsLocalization.Away.algebraMap_isUnit (S := D'_4) δ_Z
      let ζ_D4 : D'_4ˣ := Units.map (ι_QZD4).toMonoidHom ζ_u
      refine ⟨ι_QB q₀ * (↑u_ZB₄⁻¹) ^ n * (↑u_δB⁻¹) ^ m, ?_⟩
      have hΨ_Z : Ψ₄ (↑u_ZB₄) = ↑ζ_D4 := by
        have huZ_val : (↑u_ZB₄ : B₄) = ι_QB (π_big Z_b) := hu_ZB₄
        have hζ_val : (↑ζ_D4 : D'_4) = ι_QZD4 ζ := by
          change ι_QZD4 ↑ζ_u = ι_QZD4 ζ
          rw [hζ_u]
