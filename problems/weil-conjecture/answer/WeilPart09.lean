        change π_unr z = π_unr (ι_Ω_LN (res_LN z)) at h1
        rw [hz0, map_zero, map_zero] at h1
        have hz_mem : z ∈ K_N ⊔ 𝔪_N ^ 2 := Ideal.Quotient.eq_zero_iff_mem.mp h1
        simpa [sq, smul_eq_mul] using hz_mem
      have h_nak := Submodule.sup_smul_eq_sup_smul_of_le_smul_of_le_jacobson
        (IsNoetherian.noetherian 𝔪_N) (IsLocalRing.maximalIdeal_le_jacobson (⊥ : Ideal L_N)) hm_le_sup
      have h_bot_smul : (⊥ : Ideal L_N) • 𝔪_N = ⊥ :=
