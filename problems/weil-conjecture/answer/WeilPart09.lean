      let I_i : Ideal R_i := Ideal.map π_i (RingHom.ker ψ_loc)
      have hIi_ne_bot : I_i ≠ ⊥ := by
        intro hbot
        apply hh_not_ui
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        have h_mem : π_i h ∈ I_i := Ideal.mem_map_of_mem π_i hh_ker
        rwa [hbot] at h_mem
      have hIi_ne_top : I_i ≠ ⊤ := by
        intro htop
        have h1_mem : (1 : R_i) ∈ I_i := htop ▸ Submodule.mem_top
        have hIi_le_max : I_i ≤ IsLocalRing.maximalIdeal R_i := by
          rw [Ideal.map_le_iff_le_comap]
          intro z hz
          change π_i z ∈ IsLocalRing.maximalIdeal R_i
          rw [← h_max_Ri]
          have hz_mN : z ∈ 𝔪_N := by
            by_contra hz_not
            have hz_u : IsUnit z := IsLocalRing.notMem_maximalIdeal.mp hz_not
            have hψz_u : IsUnit (ψ_loc z) := hz_u.map ψ_loc
            have hψz0 : ψ_loc z = 0 := hz
            rw [hψz0] at hψz_u
            exact not_isUnit_zero hψz_u
          rw [← h_span_ij] at hz_mN
          obtain ⟨a_z, b_z, rfl⟩ := Ideal.mem_span_pair.mp hz_mN
          have hui_zero : π_i u_i = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [map_add, map_mul, map_mul, hui_zero, mul_zero, zero_add]
          exact Ideal.mem_span_singleton.mpr ⟨π_i b_z, mul_comm (π_i b_z) (π_i u_j)⟩
        exact (IsLocalRing.maximalIdeal.isMaximal R_i).ne_top
          (Ideal.eq_top_of_isUnit_mem _ (hIi_le_max h1_mem) isUnit_one)
      obtain ⟨k, _hk_pos, hk_span⟩ := hKrull R_i π_j_bar h_max_Ri I_i hIi_ne_bot hIi_ne_top
      have h_ujk_mem : π_i (u_j ^ k) ∈ I_i := by
        rw [map_pow, hk_span]
        exact Ideal.subset_span rfl
