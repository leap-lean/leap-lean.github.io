    have hψ₁_over : ∀ a : ↥s,
        ψ₁ a ≫ f = ι_D (W₀ a) u₁ ≫ t.app u₁.left := by
      intro a
      dsimp only [ψ₁]
      rw [CategoryTheory.Category.assoc, hψ_over a, ← CategoryTheory.Category.assoc,
        hι_D_nat (W₀ a) (m₁ a), CategoryTheory.Category.assoc]
      have ht_nat := t.naturality (m₁ a).left
      dsimp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map] at ht_nat
      rw [CategoryTheory.Category.comp_id] at ht_nat
      rw [ht_nat]
    have hψ₁_cone : ∀ a : ↥s,
        (AlgebraicGeometry.opensCone D c i₀ (W₀ a)).π.app u₁ ≫ ψ₁ a =
