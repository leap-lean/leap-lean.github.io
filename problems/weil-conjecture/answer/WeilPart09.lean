      rw [P_DQ.jacobian_eq_jacobiMatrix_det, Matrix.det_unique]
      change π_DQ (P_DQ.jacobiMatrix () ()) = _
      rw [P_DQ.jacobiMatrix_apply]
      change π_DQ (MvPolynomial.pderiv () Q_D) = _
      apply congrArg π_DQ
      dsimp [Q_D]
      have hX : MvPolynomial.pderiv () (MvPolynomial.X () : MvPolynomial Unit D) = 1 := by
        simp [MvPolynomial.pderiv_X]
      rw [map_add, map_sub, MvPolynomial.pderiv_C, add_zero,
        Derivation.leibniz, Derivation.leibniz, sq, Derivation.leibniz]
      simp only [smul_eq_mul, MvPolynomial.pderiv_C, hX, mul_one]
