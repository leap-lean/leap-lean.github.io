    · intro B₁ _ ι₁ hInj_ι₁ C₁ π₁ E ι_E_c _ ℰ ι_ℰ_c _ pt_sec σ₁ hComapKer hCommSec ⟨s, hs⟩
      let f_ι := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁)
      have hf_ι_ker : f_ι.ker = ⊥ := by
        let U_top : PUnit.{u + 1} → (AlgebraicGeometry.Spec (CommRingCat.of B₁)).affineOpens :=
          fun _ => ⟨⊤, AlgebraicGeometry.isAffineOpen_top _⟩
        have hSup_top : (⨆ _ : PUnit.{u + 1}, (U_top PUnit.unit).1) = ⊤ := iSup_const
        refine AlgebraicGeometry.Scheme.IdealSheafData.ext_of_iSup_eq_top U_top hSup_top (fun _ => ?_)
        rw [AlgebraicGeometry.Scheme.Hom.ker_apply f_ι (U_top PUnit.unit),
          AlgebraicGeometry.Scheme.IdealSheafData.ideal_bot, Pi.bot_apply, RingHom.ker_eq_bot_iff_eq_zero]
        intro x hx
        have h_appTop_eq : f_ι.appTop = f_ι.app (U_top PUnit.unit).1 ≫
            (AlgebraicGeometry.Spec (CommRingCat.of K_bar)).presheaf.map
              (CategoryTheory.homOfLE (fun _ _ => trivial)).op := rfl
        have hx_top : f_ι.appTop.hom x = 0 := by
          rw [h_appTop_eq]
          change ((AlgebraicGeometry.Spec (CommRingCat.of K_bar)).presheaf.map
            (CategoryTheory.homOfLE (fun _ _ => trivial)).op).hom
            ((f_ι.app (U_top PUnit.unit).1).hom x) = 0
          rw [hx, map_zero]
        have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom ι₁)
        have h_app : ((f_ι.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K_bar)).hom).hom) x = 0 := by
          change (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K_bar)).hom.hom (f_ι.appTop.hom x) = 0
          rw [hx_top, map_zero]
        rw [hnat] at h_app
        have h_ι : ι₁ ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B₁)).hom.hom x) = 0 := h_app
        have h_zero := hInj_ι₁ (h_ι.trans (map_zero ι₁).symm)
        exact (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B₁)).commRingCatIsoToRingEquiv.injective
          (h_zero.trans (map_zero _).symm)
      have hσ₁_ker : (f_ι ≫ σ₁).ker = σ₁.ker := by
        rw [← AlgebraicGeometry.Scheme.IdealSheafData.map_ker f_ι σ₁, hf_ι_ker,
          AlgebraicGeometry.Scheme.IdealSheafData.map_bot]
      have hE_le_pt : ι_E_c.ker ≤ pt_sec.ker := by
        rw [← hs, ← AlgebraicGeometry.Scheme.IdealSheafData.map_ker s ι_E_c,
          ← AlgebraicGeometry.Scheme.IdealSheafData.map_bot ι_E_c]
        exact (AlgebraicGeometry.Scheme.IdealSheafData.map_gc ι_E_c).monotone_u bot_le
      have hℰ_le_σ₁ : ι_ℰ_c.ker ≤ σ₁.ker := by
        calc
          ι_ℰ_c.ker ≤ (ι_ℰ_c.ker.comap π₁).map π₁ := ι_ℰ_c.ker.le_map_comap π₁
          _ = (ι_E_c.ker).map π₁ := by rw [hComapKer]
          _ ≤ (pt_sec.ker).map π₁ := (AlgebraicGeometry.Scheme.IdealSheafData.map_gc π₁).monotone_u hE_le_pt
          _ = (pt_sec ≫ π₁).ker := AlgebraicGeometry.Scheme.IdealSheafData.map_ker pt_sec π₁
          _ = (f_ι ≫ σ₁).ker := by rw [hCommSec]
          _ = σ₁.ker := hσ₁_ker
      exact ⟨AlgebraicGeometry.IsClosedImmersion.lift ι_ℰ_c σ₁ hℰ_le_σ₁,
        AlgebraicGeometry.IsClosedImmersion.lift_fac ι_ℰ_c σ₁ hℰ_le_σ₁⟩

  
  
  
  have hAdjoinFT : ∀ S : Finset K_bar,
      Algebra.FiniteType A ↥(Algebra.adjoin A (↑S : Set K_bar)) := by
    intro S
    let B_S := Algebra.adjoin A (↑S : Set K_bar)
    let _ : DecidableEq ↥B_S := Classical.decEq _
    let G_S : Finset ↥B_S :=
      S.attach.image (fun x => ⟨x.1, Algebra.subset_adjoin (Finset.mem_coe.mpr x.2)⟩)
    refine ⟨⟨G_S, ?_⟩⟩
    rw [eq_top_iff]
    rintro ⟨val, hval⟩ _
    exact Algebra.adjoin_induction
      (fun x hx => by
        have hx_S : x ∈ S := Finset.mem_coe.mp hx
        have hx_G : (⟨x, Algebra.subset_adjoin hx⟩ : ↥B_S) ∈ G_S :=
          Finset.mem_image.mpr ⟨⟨x, hx_S⟩, Finset.mem_attach _ _, rfl⟩
        exact Algebra.subset_adjoin (Finset.mem_coe.mpr hx_G))
      (fun a => Subalgebra.algebraMap_mem _ a)
      (fun _ _ _ _ hx hy => (Algebra.adjoin A (↑G_S : Set ↥B_S)).add_mem hx hy)
      (fun _ _ _ _ hx hy => (Algebra.adjoin A (↑G_S : Set ↥B_S)).mul_mem hx hy)
      hval

  have hTPNoeth : ∀ (T : Type u) [CommRing T] [Algebra A T] [IsNoetherianRing T] (ν : Fin N),
      letI : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν).1)) := instAlg ν
      IsNoetherianRing (TensorProduct A ↑(C.presheaf.obj (Opposite.op (V ν).1)) T) := by
    intro T _ _ _ ν
    let _ : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν).1)) := instAlg ν
    let R_ν := ↑(C.presheaf.obj (Opposite.op (V ν).1))
    let TP := TensorProduct A R_ν T
    let _ : Algebra T TP := Algebra.TensorProduct.includeRight.toRingHom.toAlgebra
    let _ : DecidableEq TP := Classical.decEq _
    obtain ⟨G_R, hG_R⟩ := (hV_alg ν).2.out
    let G_TP : Finset TP := G_R.image (fun r => TensorProduct.tmul A r (1 : T))
    have hFT_T : Algebra.FiniteType T TP := by
      refine ⟨⟨G_TP, ?_⟩⟩
      rw [eq_top_iff]
      intro z _
      refine TensorProduct.induction_on
        (motive := fun z => z ∈ Algebra.adjoin T (↑G_TP : Set TP))
        z (zero_mem _) ?_ (fun _ _ hx hy => add_mem hx hy)
      intro r t
      have ht_mem : TensorProduct.tmul A (1 : R_ν) t ∈ Algebra.adjoin T (↑G_TP : Set TP) :=
        Subalgebra.algebraMap_mem _ t
      have hr_top : r ∈ Algebra.adjoin A (↑G_R : Set R_ν) := by rw [hG_R]; trivial
      have hr_mem : TensorProduct.tmul A r (1 : T) ∈ Algebra.adjoin T (↑G_TP : Set TP) :=
        Algebra.adjoin_induction
          (fun x hx => Algebra.subset_adjoin
            (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_coe.mp hx))))
          (fun a => by
            rw [Algebra.TensorProduct.tmul_one_eq_one_tmul]
            exact Subalgebra.algebraMap_mem _ (algebraMap A T a))
          (fun x y _ _ hx hy => by rw [TensorProduct.add_tmul]; exact add_mem hx hy)
          (fun x y _ _ hx hy => by
            have hmul : TensorProduct.tmul A (x * y) (1 : T) =
                TensorProduct.tmul A x (1 : T) * TensorProduct.tmul A y (1 : T) := by simp
            rw [hmul]
            exact mul_mem hx hy)
          hr_top
      have hrt : TensorProduct.tmul A r t =
          TensorProduct.tmul A (1 : R_ν) t * TensorProduct.tmul A r (1 : T) := by simp
      rw [hrt]
      exact mul_mem ht_mem hr_mem
    exact Algebra.FiniteType.isNoetherianRing T TP

  
  have hSecData : ∀ a : Fin m,
      ∃ (ν₀ : Fin N),
        letI : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν₀).1)) := instAlg ν₀
        ∃ (ψ_R : ↑(C.presheaf.obj (Opposite.op (V ν₀).1)) →ₐ[A] K_bar)
          (S_a : Finset K_bar),
          (∀ (S' : Finset K_bar), S_a ⊆ S' →
            ∃ ψ_S : ↑(C.presheaf.obj (Opposite.op (V ν₀).1)) →ₐ[A]
                ↥(Algebra.adjoin A (↑S' : Set K_bar)),
              (Algebra.adjoin A (↑S' : Set K_bar)).val.comp ψ_S = ψ_R) ∧
          (∀ (B₁ : Type u) [CommRing B₁] [Algebra A B₁]
            (ι₁ : B₁ →ₐ[A] K_bar)
            (π₁ : Y_gen ⟶ CategoryTheory.Limits.pullback g
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B₁))))
            (ψ_B : ↑(C.presheaf.obj (Opposite.op (V ν₀).1)) →ₐ[A] B₁),
            π₁ ≫ CategoryTheory.Limits.pullback.fst g
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B₁))) = π_gen →
            π₁ ≫ CategoryTheory.Limits.pullback.snd g
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B₁))) =
              g_gen ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁.toRingHom) →
            ι₁.comp ψ_B = ψ_R →
            ∃ (σ₁ : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶
                CategoryTheory.Limits.pullback g
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B₁)))),
              σ₁ ≫ CategoryTheory.Limits.pullback.snd g
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B₁))) = 𝟙 _ ∧
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁.toRingHom) ≫ σ₁ = pt a ≫ π₁) := by
    intro a
    obtain ⟨ν₀, ψ_R, hLift_a⟩ := hS4.1 (pt a) (hPt a).1
    let _ : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν₀).1)) := instAlg ν₀
    obtain ⟨S_a, hS_a⟩ := (hS1 _).2.2 (hV_alg ν₀).2 ψ_R
    exact ⟨ν₀, ψ_R, S_a, hS_a, hLift_a⟩

  choose ν_sec ψ_sec S_sec hS_sec hLift_sec using hSecData

  let W_gen_aff : Fin N → Y_gen.affineOpens :=
    fun ν => ⟨(TopologicalSpace.Opens.map π_gen.base).obj (V ν).1, hAff_pb K_bar ν⟩

  have hGenFG : ∀ (i : Fin c) (ν : Fin N),
      letI : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν).1)) := instAlg ν
      ∃ F : Finset (TensorProduct A ↑(C.presheaf.obj (Opposite.op (V ν).1)) K_bar),
        Ideal.span (↑F : Set _) =
          Ideal.comap (Φ_pb K_bar ν).toRingHom (((ι_E i).ker).ideal (W_gen_aff ν)) := by
    intro i ν
    let _ : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν).1)) := instAlg ν
    have _ : IsNoetherianRing (TensorProduct A ↑(C.presheaf.obj (Opposite.op (V ν).1)) K_bar) :=
      hTPNoeth K_bar ν
    exact IsNoetherian.noetherian _

  choose F_gen hF_gen using hGenFG

  have hLiftTP : ∀ (ν : Fin N),
      letI : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν).1)) := instAlg ν
      ∀ z : TensorProduct A ↑(C.presheaf.obj (Opposite.op (V ν).1)) K_bar,
        ∃ S : Finset K_bar, ∀ (S' : Finset K_bar), S ⊆ S' →
          z ∈ Set.range
            (Algebra.TensorProduct.map (AlgHom.id A _)
              (Algebra.adjoin A (↑S' : Set K_bar)).val) := by
    intro ν
    let _ : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν).1)) := instAlg ν
    exact (hS1 _).1

  choose S_lift hS_lift using hLiftTP

  let _ : ∀ ν : Fin N, DecidableEq
      (TensorProduct A ↑(C.presheaf.obj (Opposite.op (V ν).1)) K_bar) :=
    fun _ => Classical.decEq _

  let S₀ : Finset K_bar :=
    (Finset.univ : Finset (Fin m)).biUnion S_sec ∪
    (Finset.univ : Finset (Fin c)).biUnion (fun i =>
      (Finset.univ : Finset (Fin N)).biUnion (fun ν =>
        (F_gen i ν).biUnion (S_lift ν)))

  let B₀_sub := Algebra.adjoin A (↑S₀ : Set K_bar)
  let B₀ : Type u := ↥B₀_sub
  have _ : Algebra.FiniteType A B₀ := hAdjoinFT S₀
  have _ : IsNoetherianRing B₀ := Algebra.FiniteType.isNoetherianRing A B₀
  let f₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B₀))
  let C₀ := CategoryTheory.Limits.pullback g f₀
  let π_C₀ := CategoryTheory.Limits.pullback.fst g f₀
  let g₀ := CategoryTheory.Limits.pullback.snd g f₀
  let s₀_gen := AlgebraicGeometry.Spec.map (CommRingCat.ofHom B₀_sub.val.toRingHom)
  have hs₀_gen_f₀ : s₀_gen ≫ f₀ = f_gen := by
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl
  let π₀ : Y_gen ⟶ C₀ :=
    CategoryTheory.Limits.pullback.lift π_gen (g_gen ≫ s₀_gen)
      (by rw [CategoryTheory.Category.assoc, hs₀_gen_f₀, CategoryTheory.Limits.pullback.condition])
  have hπ₀_fst : π₀ ≫ π_C₀ = π_gen := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hπ₀_snd : π₀ ≫ g₀ = g_gen ≫ s₀_gen := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_π₀ : CategoryTheory.IsPullback π₀ g_gen g₀ s₀_gen := by
    refine CategoryTheory.IsPullback.of_right ?_ hπ₀_snd
      (CategoryTheory.IsPullback.of_hasPullback g f₀)
    rw [hπ₀_fst, hs₀_gen_f₀]
    exact CategoryTheory.IsPullback.of_hasPullback g f_gen
  have _ : AlgebraicGeometry.IsAffineHom π₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_π₀.flip
      (AlgebraicGeometry.isAffineHom_of_isAffine s₀_gen)

  let U₀ : Fin N → C₀.affineOpens :=
    fun ν => ⟨(TopologicalSpace.Opens.map π_C₀.base).obj (V ν).1, hAff_pb B₀ ν⟩
  have hSupU₀ : (⨆ ν : Fin N, (U₀ ν).1) = ⊤ := (hPb_pkg B₀).2.1
  let W₀ : Fin N → Y_gen.affineOpens :=
    fun ν => ⟨(TopologicalSpace.Opens.map π₀.base).obj (U₀ ν).1,
      AlgebraicGeometry.IsAffineOpen.preimage (U₀ ν).2 π₀⟩

  have hLE_W₀_gen : ∀ ν : Fin N, W₀ ν ≤ W_gen_aff ν := by
    intro ν y hy
    change π_gen.base y ∈ (V ν).1
    rw [← hπ₀_fst]
    exact hy
  have hLE_gen_W₀ : ∀ ν : Fin N, (W_gen_aff ν).1 ≤ (W₀ ν).1 := by
    intro ν y hy
    change (π₀ ≫ π_C₀).base y ∈ (V ν).1
    rw [hπ₀_fst]
    exact hy

  have hGenLift₀ : ∀ (i : Fin c) (ν : Fin N),
      (((ι_E i).ker).ideal (W₀ ν)) ≤
        Ideal.map ((π₀.app (U₀ ν).1).hom)
          (Ideal.comap ((π₀.app (U₀ ν).1).hom) (((ι_E i).ker).ideal (W₀ ν))) := by
    intro i ν
    let _ : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν).1)) := instAlg ν
    let θ₀ := (π₀.app (U₀ ν).1).hom
    let res₁ := (Y_gen.presheaf.map (CategoryTheory.homOfLE (hLE_W₀_gen ν)).op).hom
    have hmap_W : Ideal.map res₁ (((ι_E i).ker).ideal (W_gen_aff ν)) = (((ι_E i).ker).ideal (W₀ ν)) :=
      AlgebraicGeometry.Scheme.IdealSheafData.map_ideal ((ι_E i).ker) (hLE_W₀_gen ν)
    have h_span_W : (((ι_E i).ker).ideal (W_gen_aff ν)) =
        Ideal.map (Φ_pb K_bar ν).toRingHom (Ideal.span (↑(F_gen i ν) : Set _)) := by
      rw [hF_gen i ν]
      ext x
      constructor
      · intro hx
        have h_symm : (Φ_pb K_bar ν).symm x ∈
            Ideal.comap (Φ_pb K_bar ν).toRingHom (((ι_E i).ker).ideal (W_gen_aff ν)) := by
          rw [Ideal.mem_comap]
          change (Φ_pb K_bar ν) ((Φ_pb K_bar ν).symm x) ∈ _
          rwa [(Φ_pb K_bar ν).apply_symm_apply]
        have h_mem := Ideal.mem_map_of_mem (Φ_pb K_bar ν).toRingHom h_symm
        change (Φ_pb K_bar ν) ((Φ_pb K_bar ν).symm x) ∈ _ at h_mem
        rwa [(Φ_pb K_bar ν).apply_symm_apply] at h_mem
      · intro hx
        exact Ideal.map_le_iff_le_comap.mpr le_rfl hx
    have h_lhs_W₀ : (((ι_E i).ker).ideal (W₀ ν)) =
        Ideal.span (⇑(res₁.comp (Φ_pb K_bar ν).toRingHom) '' (↑(F_gen i ν) : Set _)) := by
      rw [← hmap_W, h_span_W, Ideal.map_map, Ideal.map_span]
    refine h_lhs_W₀.le.trans (Ideal.span_le.mpr ?_)
    rintro _ ⟨z, hz_mem, rfl⟩
    have hz_in_F : z ∈ F_gen i ν := Finset.mem_coe.mp hz_mem
    have hSub_lift : S_lift ν z ⊆ S₀ := by
      intro x hx
      refine Finset.mem_union_right _ ?_
      refine Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, ?_⟩
      refine Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν, ?_⟩
      exact Finset.mem_biUnion.mpr ⟨z, hz_in_F, hx⟩
    obtain ⟨u₀, hu₀⟩ := hS_lift ν z S₀ hSub_lift
    have hnat_u₀ := hNat_Φ B₀ K_bar B₀_sub.val π₀ hπ₀_fst hπ₀_snd ν (hLE_gen_W₀ ν) u₀
    rw [hu₀] at hnat_u₀
    have hres_app : res₁ ((π₀.appLE (U₀ ν).1 (W_gen_aff ν).1 (hLE_gen_W₀ ν)).hom ((Φ_pb B₀ ν) u₀)) =
        θ₀ ((Φ_pb B₀ ν) u₀) := by
      change ((π₀.app (U₀ ν).1 ≫ Y_gen.presheaf.map (CategoryTheory.homOfLE (hLE_gen_W₀ ν)).op) ≫
        Y_gen.presheaf.map (CategoryTheory.homOfLE (hLE_W₀_gen ν)).op).hom ((Φ_pb B₀ ν) u₀) = _
      rw [CategoryTheory.Category.assoc, ← Y_gen.presheaf.map_comp]
      have hid : (CategoryTheory.homOfLE (hLE_gen_W₀ ν)).op ≫
          (CategoryTheory.homOfLE (hLE_W₀_gen ν)).op = 𝟙 (Opposite.op (W₀ ν).1) :=
        congrArg Opposite.op (Subsingleton.elim
          (CategoryTheory.homOfLE (hLE_W₀_gen ν) ≫ CategoryTheory.homOfLE (hLE_gen_W₀ ν))
          (𝟙 (W₀ ν).1))
      rw [hid, Y_gen.presheaf.map_id, CategoryTheory.Category.comp_id]
    have h_eq_θ : (res₁.comp (Φ_pb K_bar ν).toRingHom) z = θ₀ ((Φ_pb B₀ ν) u₀) := by
      change res₁ ((Φ_pb K_bar ν) z) = _
      rw [← hnat_u₀, hres_app]
    have hz_ideal : (Φ_pb K_bar ν) z ∈ (((ι_E i).ker).ideal (W_gen_aff ν)) := by
      have hz_span : z ∈ Ideal.span (↑(F_gen i ν) : Set _) := Ideal.subset_span hz_mem
      rw [hF_gen i ν] at hz_span
      exact hz_span
    have hθ_in_W₀ : (Φ_pb B₀ ν) u₀ ∈ Ideal.comap θ₀ (((ι_E i).ker).ideal (W₀ ν)) := by
      change θ₀ ((Φ_pb B₀ ν) u₀) ∈ (((ι_E i).ker).ideal (W₀ ν))
      rw [← h_eq_θ, ← hmap_W]
      exact Ideal.mem_map_of_mem res₁ hz_ideal
    rw [h_eq_θ]
    exact Ideal.mem_map_of_mem θ₀ hθ_in_W₀

  obtain ⟨_hComap₀, hNil₀, hTransferS3⟩ := hS3 π₀ U₀ hSupU₀ hGenLift₀

  
  let ℐ₀ : Fin c → C₀.IdealSheafData := fun i => ((ι_E i).ker).map π₀

  have hProdFG : ∀ ν : Fin N,
      letI : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν).1)) := instAlg ν
      ∃ G_ν : Finset (TensorProduct A ↑(C.presheaf.obj (Opposite.op (V ν).1)) B₀),
        Ideal.span (↑G_ν : Set _) =
          Ideal.comap (Φ_pb B₀ ν).toRingHom
            (∏ i ∈ (Finset.univ : Finset (Fin c)), (ℐ₀ i).ideal (U₀ ν)) := by
    intro ν
    let _ : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν).1)) := instAlg ν
    have _ : IsNoetherianRing (TensorProduct A ↑(C.presheaf.obj (Opposite.op (V ν).1)) B₀) :=
      hTPNoeth B₀ ν
    exact IsNoetherian.noetherian _

  choose G_prod hG_prod using hProdFG

  have hKillGen : ∀ (ν : Fin N),
      letI : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν).1)) := instAlg ν
      ∀ w ∈ G_prod ν,
        ∃ (M : ℕ) (S_w : Finset K_bar), S₀ ⊆ S_w ∧
          ∀ (S' : Finset K_bar) (h₀' : S₀ ⊆ S'), S_w ⊆ S' →
            Algebra.TensorProduct.map (AlgHom.id A _)
              (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr h₀'))) (w ^ M) = 0 := by
    intro ν
    let _ : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν).1)) := instAlg ν
    intro w hw
    have hw_in_prod : (Φ_pb B₀ ν) w ∈ (∏ i ∈ (Finset.univ : Finset (Fin c)), (ℐ₀ i).ideal (U₀ ν)) := by
      have hw_span : w ∈ Ideal.span (↑(G_prod ν) : Set _) := Ideal.subset_span (Finset.mem_coe.mpr hw)
      rw [hG_prod ν] at hw_span
      exact hw_span
    obtain ⟨M, hM⟩ := hNil₀ ν ((Φ_pb B₀ ν) w) hw_in_prod
    have hM_pow : (π₀.app (U₀ ν).1).hom ((Φ_pb B₀ ν) (w ^ M)) = 0 := by
      rw [map_pow, hM]
    have h_appLE_zero : (π₀.appLE (U₀ ν).1 (W_gen_aff ν).1 (hLE_gen_W₀ ν)).hom ((Φ_pb B₀ ν) (w ^ M)) = 0 := by
      change (Y_gen.presheaf.map (CategoryTheory.homOfLE (hLE_gen_W₀ ν)).op).hom
        ((π₀.app (U₀ ν).1).hom ((Φ_pb B₀ ν) (w ^ M))) = 0
      rw [hM_pow, map_zero]
    have hnat_w := hNat_Φ B₀ K_bar B₀_sub.val π₀ hπ₀_fst hπ₀_snd ν (hLE_gen_W₀ ν) (w ^ M)
    rw [h_appLE_zero] at hnat_w
    have hw_zero_K : Algebra.TensorProduct.map (AlgHom.id A _) B₀_sub.val (w ^ M) = 0 :=
      (Φ_pb K_bar ν).injective (hnat_w.symm.trans (map_zero _).symm)
    obtain ⟨S_w, hS₀_w, hKill_w⟩ := (hS1 _).2.1 S₀ (w ^ M) hw_zero_K
    exact ⟨M, S_w, hS₀_w, hKill_w⟩

  choose M_kill S_kill _hS₀_kill hKill_spec using hKillGen

  let S₁ : Finset K_bar :=
    S₀ ∪ (Finset.univ : Finset (Fin N)).biUnion (fun ν =>
      (G_prod ν).attach.biUnion (fun w => S_kill ν w.1 w.2))
  have h₀₁ : S₀ ⊆ S₁ := Finset.subset_union_left

  let B₁_sub := Algebra.adjoin A (↑S₁ : Set K_bar)
  let B₁ : Type u := ↥B₁_sub
  have hFT_B₁ : Algebra.FiniteType A B₁ := hAdjoinFT S₁
  have _ : IsNoetherianRing B₁ := Algebra.FiniteType.isNoetherianRing A B₁
  let ψ₁ : A →+* B₁ := algebraMap A B₁
  let ι₁ : B₁ →+* K_bar := B₁_sub.val.toRingHom
  have hComp₁ : ι₁.comp ψ₁ = α_A := by
    ext a
    rfl
  have hInj₁ : Function.Injective ι₁ := Subtype.val_injective
  let inc₀₁ : B₀ →ₐ[A] B₁ :=
    Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr h₀₁))

  let f₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)
  let C₁ := CategoryTheory.Limits.pullback g f₁
  let π_C₁ := CategoryTheory.Limits.pullback.fst g f₁
  let g₁ := CategoryTheory.Limits.pullback.snd g f₁
  let s₁_gen := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁)

  have hs₁_f₁ : s₁_gen ≫ f₁ = f_gen := by
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hComp₁]
  have hinc_f₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc₀₁.toRingHom) ≫ f₀ = f₁ := by
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl

  let hPaste_Y : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst g₁ s₁_gen ≫ π_C₁)
      (CategoryTheory.Limits.pullback.snd g₁ s₁_gen)
      g f_gen := by
    have hp := (CategoryTheory.IsPullback.of_hasPullback g₁ s₁_gen).paste_horiz
      (CategoryTheory.IsPullback.of_hasPullback g f₁)
    rwa [hs₁_f₁] at hp
  let e_Y : CategoryTheory.Limits.pullback g₁ s₁_gen ≅ Y_gen := hPaste_Y.isoPullback
  have he_Y_fst : e_Y.hom ≫ π_gen = CategoryTheory.Limits.pullback.fst g₁ s₁_gen ≫ π_C₁ :=
    hPaste_Y.isoPullback_hom_fst
  have he_Y_snd : e_Y.hom ≫ g_gen = CategoryTheory.Limits.pullback.snd g₁ s₁_gen :=
    hPaste_Y.isoPullback_hom_snd

  let π₁ : Y_gen ⟶ C₁ :=
    CategoryTheory.Limits.pullback.lift π_gen (g_gen ≫ s₁_gen)
      (by rw [CategoryTheory.Category.assoc, hs₁_f₁, CategoryTheory.Limits.pullback.condition])
  have hπ₁_fst : π₁ ≫ π_C₁ = π_gen := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hπ₁_snd : π₁ ≫ g₁ = g_gen ≫ s₁_gen := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_π₁ : CategoryTheory.IsPullback π₁ g_gen g₁ s₁_gen := by
    refine CategoryTheory.IsPullback.of_right ?_ hπ₁_snd
      (CategoryTheory.IsPullback.of_hasPullback g f₁)
    rw [hπ₁_fst, hs₁_f₁]
    exact CategoryTheory.IsPullback.of_hasPullback g f_gen
  have _ : AlgebraicGeometry.IsAffineHom π₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_π₁.flip
      (AlgebraicGeometry.isAffineHom_of_isAffine s₁_gen)

  let ρ₀₁ : C₁ ⟶ C₀ :=
    CategoryTheory.Limits.pullback.lift π_C₁
      (g₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc₀₁.toRingHom))
      (by rw [CategoryTheory.Category.assoc, hinc_f₀, CategoryTheory.Limits.pullback.condition])
  have hρ₀₁_fst : ρ₀₁ ≫ π_C₀ = π_C₁ := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hρ₀₁_snd : ρ₀₁ ≫ g₀ = g₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc₀₁.toRingHom) :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_ρ₀₁ : CategoryTheory.IsPullback ρ₀₁ g₁ g₀
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc₀₁.toRingHom)) := by
    refine CategoryTheory.IsPullback.of_right ?_ hρ₀₁_snd
      (CategoryTheory.IsPullback.of_hasPullback g f₀)
    rw [hρ₀₁_fst, hinc_f₀]
    exact CategoryTheory.IsPullback.of_hasPullback g f₁
  have _ : AlgebraicGeometry.IsAffineHom ρ₀₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ρ₀₁.flip
      (AlgebraicGeometry.isAffineHom_of_isAffine _)

  have hfac₀ : π₁ ≫ ρ₀₁ = π₀ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, hρ₀₁_fst, hπ₁_fst, hπ₀_fst]
    · rw [CategoryTheory.Category.assoc, hρ₀₁_snd, ← CategoryTheory.Category.assoc, hπ₁_snd,
        hπ₀_snd, CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      rfl

  have he_Y_π₁ : CategoryTheory.Limits.pullback.fst g₁ s₁_gen = e_Y.hom ≫ π₁ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, hπ₁_fst, he_Y_fst]
    · rw [CategoryTheory.Category.assoc, hπ₁_snd, ← CategoryTheory.Category.assoc, he_Y_snd,
        CategoryTheory.Limits.pullback.condition]

  have hNil₁ : ∀ (ν : Fin N) (z : ↑(C₀.presheaf.obj (Opposite.op (U₀ ν).1))),
      z ∈ (∏ i ∈ (Finset.univ : Finset (Fin c)), (ℐ₀ i).ideal (U₀ ν)) →
      ∃ M : ℕ, (ρ₀₁.app (U₀ ν).1).hom (z ^ M) = 0 := by
    intro ν
    let _ : Algebra A ↑(C.presheaf.obj (Opposite.op (V ν).1)) := instAlg ν
    let U₁_open : C₁.Opens := (TopologicalSpace.Opens.map π_C₁.base).obj (V ν).1
    let U₁_pre : C₁.Opens := (TopologicalSpace.Opens.map ρ₀₁.base).obj (U₀ ν).1
    have hLE_U1 : U₁_open ≤ U₁_pre := by
      intro x hx
      change (ρ₀₁ ≫ π_C₀).base x ∈ (V ν).1
      rw [hρ₀₁_fst]
      exact hx
    have hLE_U2 : U₁_pre ≤ U₁_open := by
      intro x hx
      change π_C₁.base x ∈ (V ν).1
      rw [← hρ₀₁_fst]
      exact hx
    let θ₀₁ := (ρ₀₁.app (U₀ ν).1).hom
    have hSubNil : (∏ i ∈ (Finset.univ : Finset (Fin c)), (ℐ₀ i).ideal (U₀ ν)) ≤
        Ideal.comap θ₀₁ (nilradical ↑(C₁.presheaf.obj (Opposite.op U₁_pre))) := by
      have h_span_prod : (∏ i ∈ (Finset.univ : Finset (Fin c)), (ℐ₀ i).ideal (U₀ ν)) =
          Ideal.map (Φ_pb B₀ ν).toRingHom (Ideal.span (↑(G_prod ν) : Set _)) := by
        rw [hG_prod ν]
        ext x
        constructor
        · intro hx
          have h_symm : (Φ_pb B₀ ν).symm x ∈
              Ideal.comap (Φ_pb B₀ ν).toRingHom
                (∏ i ∈ (Finset.univ : Finset (Fin c)), (ℐ₀ i).ideal (U₀ ν)) := by
            rw [Ideal.mem_comap]
            change (Φ_pb B₀ ν) ((Φ_pb B₀ ν).symm x) ∈ _
            rwa [(Φ_pb B₀ ν).apply_symm_apply]
          have h_mem := Ideal.mem_map_of_mem (Φ_pb B₀ ν).toRingHom h_symm
          change (Φ_pb B₀ ν) ((Φ_pb B₀ ν).symm x) ∈ _ at h_mem
          rwa [(Φ_pb B₀ ν).apply_symm_apply] at h_mem
        · intro hx
          exact Ideal.map_le_iff_le_comap.mpr le_rfl hx
      rw [h_span_prod, Ideal.map_span, Ideal.span_le]
      rintro _ ⟨w, hw_mem, rfl⟩
      have hw_G : w ∈ G_prod ν := Finset.mem_coe.mp hw_mem
      let M := M_kill ν w hw_G
      have hSub_kill : S_kill ν w hw_G ⊆ S₁ := by
        intro x hx
        refine Finset.mem_union_right _ ?_
        refine Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν, ?_⟩
        exact Finset.mem_biUnion.mpr ⟨⟨w, hw_G⟩, Finset.mem_attach _ _, hx⟩
      have hTP_zero : Algebra.TensorProduct.map (AlgHom.id A _) inc₀₁ (w ^ M) = 0 :=
        hKill_spec ν w hw_G S₁ h₀₁ hSub_kill
      have hnat_ρ := hNat_Φ B₀ B₁ inc₀₁ ρ₀₁ hρ₀₁_fst hρ₀₁_snd ν hLE_U1 (w ^ M)
      rw [hTP_zero, map_zero] at hnat_ρ
      have h_app_zero : θ₀₁ ((Φ_pb B₀ ν) (w ^ M)) = 0 := by
        have hcomp : (C₁.presheaf.map (CategoryTheory.homOfLE hLE_U2).op).hom
            ((ρ₀₁.appLE (U₀ ν).1 U₁_open hLE_U1).hom ((Φ_pb B₀ ν) (w ^ M))) =
            θ₀₁ ((Φ_pb B₀ ν) (w ^ M)) := by
          change ((ρ₀₁.app (U₀ ν).1 ≫ C₁.presheaf.map (CategoryTheory.homOfLE hLE_U1).op) ≫
            C₁.presheaf.map (CategoryTheory.homOfLE hLE_U2).op).hom ((Φ_pb B₀ ν) (w ^ M)) = _
          rw [CategoryTheory.Category.assoc, ← C₁.presheaf.map_comp]
          have hid : (CategoryTheory.homOfLE hLE_U1).op ≫ (CategoryTheory.homOfLE hLE_U2).op =
              𝟙 (Opposite.op U₁_pre) :=
            congrArg Opposite.op (Subsingleton.elim
              (CategoryTheory.homOfLE hLE_U2 ≫ CategoryTheory.homOfLE hLE_U1)
              (𝟙 U₁_pre))
          rw [hid, C₁.presheaf.map_id, CategoryTheory.Category.comp_id]
        rw [← hcomp, hnat_ρ, map_zero]
      exact mem_nilradical.mpr ⟨M, by rw [← map_pow, ← map_pow]; exact h_app_zero⟩
    intro z hz
    obtain ⟨M, hM⟩ := mem_nilradical.mp (hSubNil hz)
    exact ⟨M, by rw [map_pow, hM]⟩

  obtain ⟨hClosed_ℰ₁, hComap_ℰ₁, hCov_ℰ₁, hIso_ℰ₁⟩ := hTransferS3 π₁ ρ₀₁ hfac₀ hNil₁

  let ℐ₁ : Fin c → C₁.IdealSheafData := fun i => (ℐ₀ i).comap ρ₀₁
  let ℰ₁ : Fin c → AlgebraicGeometry.Scheme.{u} := fun i => (ℐ₁ i).subscheme
  let ι_ℰ₁ : ∀ i : Fin c, ℰ₁ i ⟶ C₁ := fun i => (ℐ₁ i).subschemeι
  let p_ℰ₁ : ∀ i : Fin c, ℰ₁ i ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₁) :=
    fun i => ι_ℰ₁ i ≫ g₁

  
  have hSec_ℰ₁ : ∀ a : Fin m,
      ∃ (σ_a : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶ C₁),
        σ_a ≫ g₁ = 𝟙 _ ∧
        (∃ s₁ : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶ ℰ₁ (inc a).1,
          s₁ ≫ ι_ℰ₁ (inc a).1 = σ_a) ∧
        (∃ s₂ : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶ ℰ₁ (inc a).2,
          s₂ ≫ ι_ℰ₁ (inc a).2 = σ_a) := by
    intro a
    let _ : Algebra A ↑(C.presheaf.obj (Opposite.op (V (ν_sec a)).1)) := instAlg (ν_sec a)
    have hSub_a : S_sec a ⊆ S₁ :=
      (Finset.subset_biUnion_of_mem S_sec (Finset.mem_univ a)).trans
        (Finset.subset_union_left.trans h₀₁)
    obtain ⟨ψ_B_a, hψ_B_a⟩ := hS_sec a S₁ hSub_a
    obtain ⟨σ_a, hσ_sec, hσ_comm⟩ :=
      hLift_sec a B₁ B₁_sub.val π₁ ψ_B_a hπ₁_fst hπ₁_snd hψ_B_a
    have hKer₁ : (ι_ℰ₁ (inc a).1).ker.comap π₁ = (ι_E (inc a).1).ker := by
      change (ℐ₁ (inc a).1).subschemeι.ker.comap π₁ = _
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι]
      exact hComap_ℰ₁ (inc a).1
    have hKer₂ : (ι_ℰ₁ (inc a).2).ker.comap π₁ = (ι_E (inc a).2).ker := by
      change (ℐ₁ (inc a).2).subschemeι.ker.comap π₁ = _
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι]
      exact hComap_ℰ₁ (inc a).2
    have _ : AlgebraicGeometry.IsClosedImmersion (ι_E (inc a).1) := hClosed_E (inc a).1
    have _ : AlgebraicGeometry.IsClosedImmersion (ι_E (inc a).2) := hClosed_E (inc a).2
    have _ : AlgebraicGeometry.IsClosedImmersion (ι_ℰ₁ (inc a).1) := hClosed_ℰ₁ (inc a).1
    have _ : AlgebraicGeometry.IsClosedImmersion (ι_ℰ₁ (inc a).2) := hClosed_ℰ₁ (inc a).2
    obtain ⟨s₁, hs₁⟩ := hS4.2 ι₁ hInj₁ π₁ (ι_E (inc a).1) (ι_ℰ₁ (inc a).1)
      (pt a) σ_a hKer₁ hσ_comm (hPt a).2.1
    obtain ⟨s₂, hs₂⟩ := hS4.2 ι₁ hInj₁ π₁ (ι_E (inc a).2) (ι_ℰ₁ (inc a).2)
      (pt a) σ_a hKer₂ hσ_comm (hPt a).2.2
    exact ⟨σ_a, hσ_sec, ⟨s₁, hs₁⟩, ⟨s₂, hs₂⟩⟩

  choose σ₁ hσ₁_props using hSec_ℰ₁

  
  have hℰ₁_props : ∀ i : Fin c,
      AlgebraicGeometry.IsProper (p_ℰ₁ i) ∧
      AlgebraicGeometry.LocallyOfFinitePresentation (p_ℰ₁ i) ∧
      AlgebraicGeometry.IsClosedImmersion (ι_ℰ₁ i) ∧
      ι_ℰ₁ i ≫ g₁ = p_ℰ₁ i := by
    intro i
    have _ : AlgebraicGeometry.IsClosedImmersion (ι_ℰ₁ i) := hClosed_ℰ₁ i
    have _ : AlgebraicGeometry.IsProper g₁ := inferInstance
    have _ : AlgebraicGeometry.LocallyOfFinitePresentation g₁ := inferInstance
    have hProp_i : AlgebraicGeometry.IsProper (p_ℰ₁ i) := inferInstance
    have hLFT_i : AlgebraicGeometry.LocallyOfFiniteType (p_ℰ₁ i) := inferInstance
    have hLFP_i : AlgebraicGeometry.LocallyOfFinitePresentation (p_ℰ₁ i) := by
      rw [AlgebraicGeometry.locallyOfFinitePresentation_iff]
      intro U hU V_open hV_open e_le
      have _ : AlgebraicGeometry.IsOpenImmersion hU.fromSpec :=
        AlgebraicGeometry.IsAffineOpen.isOpenImmersion_fromSpec hU
      have hLFT_U : AlgebraicGeometry.LocallyOfFiniteType hU.fromSpec := inferInstance
      rw [← AlgebraicGeometry.Spec.map_preimage hU.fromSpec] at hLFT_U
      let _ : Algebra B₁ ↑((AlgebraicGeometry.Spec (CommRingCat.of B₁)).presheaf.obj (Opposite.op U)) :=
        (AlgebraicGeometry.Spec.preimage hU.fromSpec).hom.toAlgebra
      have _ : Algebra.FiniteType B₁ ↑((AlgebraicGeometry.Spec (CommRingCat.of B₁)).presheaf.obj (Opposite.op U)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_U
      have _ : IsNoetherianRing ↑((AlgebraicGeometry.Spec (CommRingCat.of B₁)).presheaf.obj (Opposite.op U)) :=
        Algebra.FiniteType.isNoetherianRing B₁ _
      exact RingHom.FinitePresentation.of_finiteType.mp
        ((AlgebraicGeometry.locallyOfFiniteType_iff (p_ℰ₁ i)).mp hLFT_i hU hV_open e_le)
    exact ⟨hProp_i, hLFP_i, hClosed_ℰ₁ i, rfl⟩

  refine ⟨B₁, inferInstance, inferInstance, ψ₁, ι₁, ℰ₁, p_ℰ₁, ι_ℰ₁, σ₁,
    hFT_B₁, hComp₁, hInj₁, hℰ₁_props, hCov_ℰ₁, hσ₁_props,
    ⟨e_Y, he_Y_fst, he_Y_snd, fun i => hIso_ℰ₁ e_Y _ he_Y_π₁ i⟩⟩

theorem weil_fp_affine_chart_cover_and_generic_smoothOrNodal_extract (B₀ : Type u) [CommRing B₀]
    (X₀ : AlgebraicGeometry.Scheme.{u})
    (p₀ : X₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀)) :
    AlgebraicGeometry.QuasiCompact p₀ →
    AlgebraicGeometry.LocallyOfFinitePresentation p₀ →
    ∃ (N : ℕ) (R₀ : Fin N → Type u)
      (_ : ∀ α : Fin N, CommRing (R₀ α))
      (_ : ∀ α : Fin N, Algebra B₀ (R₀ α)),
      (∀ α : Fin N, Algebra.FinitePresentation B₀ (R₀ α)) ∧
      (∀ (Ω : Type u) [CommRing Ω] [Algebra B₀ Ω],
        let s_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of B₀) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ Ω))
        ∃ (j_Ω : ∀ α : Fin N,
            AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B₀ Ω (R₀ α))) ⟶
              CategoryTheory.Limits.pullback p₀ s_Ω),
          (∀ α : Fin N, AlgebraicGeometry.IsOpenImmersion (j_Ω α)) ∧
          (∀ α : Fin N,
            j_Ω α ≫ CategoryTheory.Limits.pullback.snd p₀ s_Ω =
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap Ω (TensorProduct B₀ Ω (R₀ α))))) ∧
          (⋃ α : Fin N, Set.range (j_Ω α).base) = Set.univ) ∧
      (∀ (K_bar : Type u) [Field K_bar] [Algebra B₀ K_bar],
        let s_gen : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of B₀) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ K_bar))
        let p_gen := CategoryTheory.Limits.pullback.snd p₀ s_gen
        ((∀ y : ↥(CategoryTheory.Limits.pullback p₀ s_gen),
            HasSpreadSmoothOrNodalAt p_gen y) →
          ∀ α : Fin N,
            ∃ (m : ℕ) (f : Fin m → TensorProduct B₀ K_bar (R₀ α))
              (s : ℕ) (D' : Fin s → Type u) (_ : ∀ ν : Fin s, CommRing (D' ν))
              (φ_D : ∀ ν : Fin s, TensorProduct B₀ K_bar (R₀ α) →+* D' ν)
              (φ_node : ∀ ν : Fin s,
                (MvPolynomial (Fin 2) K_bar ⧸
                  Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
                    Set (MvPolynomial (Fin 2) K_bar))) →+* D' ν),
              (∀ μ : Fin m,
                RingHom.IsStandardSmoothOfRelativeDimension 1
                  (algebraMap K_bar (Localization.Away (f μ)))) ∧
              (∀ ν : Fin s, (φ_D ν).Etale) ∧
              (∀ ν : Fin s, (φ_node ν).Etale) ∧
              (∀ ν : Fin s,
                (φ_D ν).comp (algebraMap K_bar (TensorProduct B₀ K_bar (R₀ α))) =
                  (φ_node ν).comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
              (⋃ μ : Fin m,
                  (PrimeSpectrum.basicOpen (f μ) :
                    Set (PrimeSpectrum (TensorProduct B₀ K_bar (R₀ α))))) ∪
                (⋃ ν : Fin s, Set.range (PrimeSpectrum.comap (φ_D ν))) = Set.univ) ∧
        (AlgebraicGeometry.SmoothOfRelativeDimension 1 p_gen →
          ∀ α : Fin N,
            ∃ (m' : ℕ) (f' : Fin m' → TensorProduct B₀ K_bar (R₀ α)),
              (∀ μ : Fin m',
                RingHom.IsStandardSmoothOfRelativeDimension 1
                  (algebraMap K_bar (Localization.Away (f' μ)))) ∧
              (⋃ μ : Fin m',
                  (PrimeSpectrum.basicOpen (f' μ) :
                    Set (PrimeSpectrum (TensorProduct B₀ K_bar (R₀ α))))) = Set.univ)) :=
by
  intro hQC hLFP
  let _ : AlgebraicGeometry.QuasiCompact p₀ := hQC
  let _ : AlgebraicGeometry.LocallyOfFinitePresentation p₀ := hLFP
  
  have _ : CompactSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of B₀)) :=
    (inferInstance : CompactSpace (PrimeSpectrum B₀))
  have _ : CompactSpace ↥X₀ :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p₀
  have hAffPt : ∀ x : ↥X₀, ∃ (R : CommRingCat.{u}) (f : AlgebraicGeometry.Spec R ⟶ X₀),
      AlgebraicGeometry.IsOpenImmersion f ∧ x ∈ Set.range f.base := by
    intro x
    obtain ⟨R, f, hf_open, hx_mem, _⟩ :=
      @AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset X₀ x ⊤ trivial
    exact ⟨R, f, hf_open, hx_mem⟩
  choose R_x i_x hi_x_open hx_mem_x using hAffPt
  have hOpenRange_x : ∀ x : ↥X₀, IsOpen (Set.range (i_x x).base) := by
    intro x
    let _ : AlgebraicGeometry.IsOpenImmersion (i_x x) := hi_x_open x
    exact (i_x x).isOpenEmbedding.isOpen_range
  have hUnivSub_x : (Set.univ : Set ↥X₀) ⊆ ⋃ x : ↥X₀, Set.range (i_x x).base :=
    fun x _ => Set.mem_iUnion.mpr ⟨x, hx_mem_x x⟩
  obtain ⟨t₀, ht₀⟩ := isCompact_univ.elim_finite_subcover (fun x => Set.range (i_x x).base)
    hOpenRange_x hUnivSub_x
  let N : ℕ := t₀.card
  let e_t₀ : ↥t₀ ≃ Fin N := t₀.equivFin
  let x_α : Fin N → ↥X₀ := fun α => (e_t₀.symm α).1
  let R₀ : Fin N → Type u := fun α => ↑(R_x (x_α α))
  let instCR_R₀ : ∀ α : Fin N, CommRing (R₀ α) := fun α => inferInstance
  let i₀ : ∀ α : Fin N, AlgebraicGeometry.Spec (CommRingCat.of (R₀ α)) ⟶ X₀ :=
    fun α => i_x (x_α α)
  have hi₀_open : ∀ α : Fin N, AlgebraicGeometry.IsOpenImmersion (i₀ α) :=
    fun α => hi_x_open (x_α α)
  let φ₀ : ∀ α : Fin N, B₀ →+* R₀ α :=
    fun α => (AlgebraicGeometry.Spec.preimage (i₀ α ≫ p₀)).hom
  let instAlg_R₀ : ∀ α : Fin N, Algebra B₀ (R₀ α) := fun α => (φ₀ α).toAlgebra
  let _ : ∀ α : Fin N, Algebra B₀ (R₀ α) := instAlg_R₀
  have hSpec_φ₀ : ∀ α : Fin N,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ (R₀ α))) = i₀ α ≫ p₀ :=
    fun α => AlgebraicGeometry.Spec.map_preimage (i₀ α ≫ p₀)
  have hi₀_cov : (⋃ α : Fin N, Set.range (i₀ α).base) = Set.univ := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    obtain ⟨x', hx'_mem⟩ := Set.mem_iUnion.mp (ht₀ (Set.mem_univ x))
    obtain ⟨hx'_t₀, hx_range⟩ := Set.mem_iUnion.mp hx'_mem
    refine ⟨e_t₀ ⟨x', hx'_t₀⟩, ?_⟩
    have hx_eq : x_α (e_t₀ ⟨x', hx'_t₀⟩) = x' :=
      congrArg Subtype.val (e_t₀.symm_apply_apply ⟨x', hx'_t₀⟩)
    change x ∈ Set.range (i_x (x_α (e_t₀ ⟨x', hx'_t₀⟩))).base
    rwa [hx_eq]

  have hFP_R₀ : ∀ α : Fin N, Algebra.FinitePresentation B₀ (R₀ α) := by
    intro α
    let _ : AlgebraicGeometry.IsOpenImmersion (i₀ α) := hi₀_open α
    have hLFP_comp : AlgebraicGeometry.LocallyOfFinitePresentation (i₀ α ≫ p₀) := inferInstance
    rw [← hSpec_φ₀ α] at hLFP_comp
    have hFP_hom : (algebraMap B₀ (R₀ α)).FinitePresentation :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mp hLFP_comp
    exact RingHom.finitePresentation_algebraMap.mp hFP_hom

  have hPullbackCov : ∀ (Ω : Type u) [CommRing Ω] [Algebra B₀ Ω],
      let s_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of B₀) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ Ω))
      ∃ (j_Ω : ∀ α : Fin N,
          AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B₀ Ω (R₀ α))) ⟶
            CategoryTheory.Limits.pullback p₀ s_Ω),
        (∀ α : Fin N, AlgebraicGeometry.IsOpenImmersion (j_Ω α)) ∧
        (∀ α : Fin N,
          j_Ω α ≫ CategoryTheory.Limits.pullback.snd p₀ s_Ω =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap Ω (TensorProduct B₀ Ω (R₀ α))))) ∧
        (⋃ α : Fin N, Set.range (j_Ω α).base) = Set.univ := by
    intro Ω _ _ s_Ω
    let Y_Ω := CategoryTheory.Limits.pullback p₀ s_Ω
    let π_Ω := CategoryTheory.Limits.pullback.fst p₀ s_Ω
    let p_Ω := CategoryTheory.Limits.pullback.snd p₀ s_Ω
    let r_α : ∀ α : Fin N,
        AlgebraicGeometry.Spec (CommRingCat.of (R₀ α)) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of B₀) :=
      fun α => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ (R₀ α)))
    let u_α : ∀ α : Fin N, CategoryTheory.Limits.pullback (r_α α) s_Ω ⟶ Y_Ω :=
      fun α => CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (r_α α) s_Ω ≫ i₀ α)
        (CategoryTheory.Limits.pullback.snd (r_α α) s_Ω)
        (by
          rw [CategoryTheory.Category.assoc, ← hSpec_φ₀ α]
          exact CategoryTheory.Limits.pullback.condition)
    have hPb_top : ∀ α : Fin N,
        CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst (r_α α) s_Ω)
          (u_α α) (i₀ α) π_Ω := by
      intro α
      refine CategoryTheory.IsPullback.of_bot ?_
        (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
        (CategoryTheory.IsPullback.of_hasPullback p₀ s_Ω)
      rw [CategoryTheory.Limits.pullback.lift_snd, ← hSpec_φ₀ α]
      exact CategoryTheory.IsPullback.of_hasPullback (r_α α) s_Ω
    have hu_open : ∀ α : Fin N, AlgebraicGeometry.IsOpenImmersion (u_α α) :=
      fun α => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hPb_top α) (hi₀_open α)
    let iso_α : ∀ α : Fin N,
        CategoryTheory.Limits.pullback (r_α α) s_Ω ≅
          AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B₀ Ω (R₀ α))) :=
      fun α => CategoryTheory.Limits.pullbackSymmetry (r_α α) s_Ω ≪≫
        AlgebraicGeometry.pullbackSpecIso B₀ Ω (R₀ α)
    let j_Ω : ∀ α : Fin N,
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B₀ Ω (R₀ α))) ⟶ Y_Ω :=
      fun α => (iso_α α).inv ≫ u_α α
    refine ⟨j_Ω, ?_, ?_, ?_⟩
    · intro α
      let _ : AlgebraicGeometry.IsOpenImmersion (u_α α) := hu_open α
      exact inferInstance
    · intro α
      change ((AlgebraicGeometry.pullbackSpecIso B₀ Ω (R₀ α)).inv ≫
        (CategoryTheory.Limits.pullbackSymmetry (r_α α) s_Ω).inv) ≫ u_α α ≫ p_Ω = _
      rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullbackSymmetry_inv_comp_snd,
        AlgebraicGeometry.pullbackSpecIso_inv_fst']
    · ext y
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      have hy_cov : π_Ω.base y ∈ ⋃ α : Fin N, Set.range (i₀ α).base := by
        rw [hi₀_cov]; trivial
      obtain ⟨α, z, hz⟩ := Set.mem_iUnion.mp hy_cov
      obtain ⟨w, _, hw⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback (hPb_top α) z y hz
      refine ⟨α, (iso_α α).hom.base w, ?_⟩
      change ((iso_α α).hom ≫ (iso_α α).inv ≫ u_α α).base w = y
      rw [← CategoryTheory.Category.assoc, (iso_α α).hom_inv_id,
        CategoryTheory.Category.id_comp]
      exact hw

  
  have hPointwiseSm : ∀ {K : Type u} [CommRing K]
      (Y : AlgebraicGeometry.Scheme.{u})
      (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
      (D : Type u) [CommRing D] [Algebra K D]
      (j : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y),
      AlgebraicGeometry.IsOpenImmersion j →
      j ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K D)) →
      ∀ (V_sm : Y.Opens),
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Y) →
        ∀ (q : PrimeSpectrum D),
          j.base q ∈ V_sm →
          ∃ f : D,
            q ∈ PrimeSpectrum.basicOpen f ∧
            RingHom.IsStandardSmoothOfRelativeDimension 1
              (algebraMap K (Localization.Away f)) := by
    intro K _ Y p_Y D _ _ j hj_open hj_comm V_sm hV_sm q hq_in_V
    let _ : AlgebraicGeometry.IsOpenImmersion j := hj_open
    let _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Y) := hV_sm
    let O_q : Set (PrimeSpectrum D) := (j ⁻¹ᵁ V_sm).1
    have hO_open : IsOpen O_q := (j ⁻¹ᵁ V_sm).2
    have hq_mem_O : q ∈ O_q := hq_in_V
    obtain ⟨B_set, ⟨g₁, rfl⟩, hg₁_q, hg₁_sub⟩ :=
      TopologicalSpace.IsTopologicalBasis.exists_subset_of_mem_open
        PrimeSpectrum.isTopologicalBasis_basic_opens hq_mem_O hO_open
    suffices hGenD₁ : ∀ (D₁ : Type u) [CommRing D₁] [Algebra D D₁] [Algebra K D₁]
        [IsScalarTower K D D₁] [IsLocalization.Away g₁ D₁],
        ∃ f : D,
          q ∈ PrimeSpectrum.basicOpen f ∧
          RingHom.IsStandardSmoothOfRelativeDimension 1
            (algebraMap K (Localization.Away f)) from
      hGenD₁ (Localization.Away g₁)
    intro D₁ _ _ _ _ _
    let loc₁ : AlgebraicGeometry.Spec (CommRingCat.of D₁) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of D) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D D₁))
    have _ : AlgebraicGeometry.IsOpenImmersion loc₁ :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization g₁
    have hRange₁ : Set.range (loc₁ ≫ j).base ⊆ Set.range V_sm.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      have hz_basic : loc₁.base z ∈ PrimeSpectrum.basicOpen g₁ := by
        change g₁ ∉ (PrimeSpectrum.comap (algebraMap D D₁) z).asIdeal
        intro hg_mem
        have h_unit : IsUnit (algebraMap D D₁ g₁) :=
          IsLocalization.Away.algebraMap_isUnit g₁
        exact z.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem z.asIdeal hg_mem h_unit)
      exact hg₁_sub hz_basic
    let w₁ : AlgebraicGeometry.Spec (CommRingCat.of D₁) ⟶ V_sm.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift V_sm.ι (loc₁ ≫ j) hRange₁
    have hw₁_fac : w₁ ≫ V_sm.ι = loc₁ ≫ j :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac V_sm.ι (loc₁ ≫ j) hRange₁
    have _ : AlgebraicGeometry.IsOpenImmersion (w₁ ≫ V_sm.ι) := by
      rw [hw₁_fac]; exact inferInstance
    have _ : AlgebraicGeometry.IsOpenImmersion w₁ :=
      AlgebraicGeometry.IsOpenImmersion.of_comp w₁ V_sm.ι
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 w₁ := inferInstance
    have hSm_comp : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
        (w₁ ≫ (V_sm.ι ≫ p_Y)) := inferInstance
    have hMap_D₁ : w₁ ≫ (V_sm.ι ≫ p_Y) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K D₁)) := by
      rw [← CategoryTheory.Category.assoc, hw₁_fac, CategoryTheory.Category.assoc, hj_comm,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq K D D₁]
    have hSm_Spec₁ : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K D₁))) := by
      simpa [hMap_D₁] using hSm_comp
    have hLocSm : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension 1)
        (algebraMap K D₁) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)).mp hSm_Spec₁
    obtain ⟨s, hs_top, h_loc⟩ :=
      (RingHom.locally_iff_isLocalization
        RingHom.isStandardSmoothOfRelativeDimension_respectsIso
        (algebraMap K D₁)).mp hLocSm
    have hDisj : Disjoint (Submonoid.powers g₁ : Set D) (q.asIdeal : Set D) := by
      rw [Set.disjoint_iff]
      rintro _ ⟨⟨k, rfl⟩, hk_mem⟩
      exact hg₁_q (q.isPrime.mem_of_pow_mem k hk_mem)
    let Q₁ : Ideal D₁ := Ideal.map (algebraMap D D₁) q.asIdeal
    have hQ₁_prime : Q₁.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers g₁) D₁
        q.asIdeal q.isPrime hDisj
    have hEx_t : ∃ t ∈ s, t ∉ Q₁ := by
      by_contra hAllMem
      have hSub : (↑s : Set D₁) ⊆ (Q₁ : Set D₁) := fun t ht =>
        Classical.not_not.mp fun ht_not => hAllMem ⟨t, ht, ht_not⟩
      have hTopLe : (⊤ : Ideal D₁) ≤ Q₁ := by
        rw [← hs_top]
        exact Ideal.span_le.mpr hSub
      exact hQ₁_prime.ne_top (top_unique hTopLe)
    obtain ⟨t, ht_in_s, ht_not_Q₁⟩ := hEx_t
    obtain ⟨⟨a, m_pow⟩, ht_surj⟩ := IsLocalization.surj (Submonoid.powers g₁) (S := D₁) t
    dsimp only at ht_surj
    have hu_unit : IsUnit (algebraMap D D₁ m_pow.1) := by
      rcases m_pow.2 with ⟨k, hk⟩
      rw [← hk, map_pow]
      exact IsUnit.pow k (IsLocalization.Away.algebraMap_isUnit g₁)
    obtain ⟨u_unit, hu_eq⟩ := hu_unit
    have hq_basic_f : q ∈ PrimeSpectrum.basicOpen (g₁ * a) := by
      change g₁ * a ∉ q.asIdeal
      intro hmul_mem
      rcases q.isPrime.mem_or_mem hmul_mem with hg₁_in | ha_in
      · exact hg₁_q hg₁_in
      · have ht'_in : algebraMap D D₁ a ∈ Q₁ := Ideal.mem_map_of_mem (algebraMap D D₁) ha_in
        have ht_eq' : t = algebraMap D D₁ a * ↑(u_unit⁻¹) := by
          calc
            t = t * (↑u_unit * ↑(u_unit⁻¹)) := by simp
            _ = (t * algebraMap D D₁ m_pow.1) * ↑(u_unit⁻¹) := by
                rw [← mul_assoc, hu_eq]
            _ = algebraMap D D₁ a * ↑(u_unit⁻¹) := by rw [ht_surj]
        rw [ht_eq'] at ht_not_Q₁
        exact ht_not_Q₁ (Q₁.mul_mem_right _ ht'_in)
    suffices hGenT : ∀ (T : Type u) [CommRing T] [Algebra D₁ T]
        [IsLocalization.Away (algebraMap D D₁ a) T]
        (S_f : Type u) [CommRing S_f] [Algebra D S_f] [Algebra K S_f]
        [IsScalarTower K D S_f] [IsLocalization.Away (g₁ * a) S_f],
        RingHom.IsStandardSmoothOfRelativeDimension 1 (algebraMap K S_f) from
      ⟨g₁ * a, hq_basic_f,
        hGenT (Localization.Away (algebraMap D D₁ a)) (Localization.Away (g₁ * a))⟩
    intro T _ _ _ S_f _ _ _ _ _
    have ht_mul_inv : ↑(u_unit⁻¹) * algebraMap D D₁ a = t := by
      calc
        ↑(u_unit⁻¹) * algebraMap D D₁ a = ↑(u_unit⁻¹) * (t * ↑u_unit) := by
            rw [← ht_surj, ← hu_eq]
        _ = t * (↑u_unit * ↑(u_unit⁻¹)) := by ring
        _ = t := by simp
    have hLoc_t : IsLocalization.Away t T := by
      rw [← ht_mul_inv]
      exact @IsLocalization.Away.mul_of_isUnit' D₁ _ T _ _
        (↑(u_unit⁻¹)) (algebraMap D D₁ a) inferInstance
        ((algebraMap D₁ T).isUnit_map u_unit⁻¹.isUnit)
    have h_T : RingHom.IsStandardSmoothOfRelativeDimension 1
        ((algebraMap D₁ T).comp (algebraMap K D₁)) :=
      @h_loc t ht_in_s T _ _ hLoc_t
    let _ : Algebra D T := ((algebraMap D₁ T).comp (algebraMap D D₁)).toAlgebra
    let _ : Algebra K T := ((algebraMap D₁ T).comp (algebraMap K D₁)).toAlgebra
    have _ : IsScalarTower D D₁ T := IsScalarTower.of_algebraMap_eq' rfl
    have _ : IsScalarTower K D T :=
      IsScalarTower.of_algebraMap_eq (fun c => by
        change ((algebraMap D₁ T).comp (algebraMap K D₁)) c =
          (algebraMap D₁ T) ((algebraMap D D₁) ((algebraMap K D) c))
        rw [IsScalarTower.algebraMap_eq K D D₁]
        rfl)
    have _ : IsLocalization.Away (g₁ * a) T :=
      IsLocalization.Away.mul' D₁ T g₁ a
    let e_D : T ≃ₐ[D] S_f :=
      IsLocalization.algEquiv (Submonoid.powers (g₁ * a)) T S_f
    let e_K : T ≃ₐ[K] S_f := e_D.restrictScalars K
    have _ : Algebra.IsStandardSmoothOfRelativeDimension 1 K T :=
      RingHom.IsStandardSmoothOfRelativeDimension.toAlgebra 1 h_T
    have _ : Algebra.IsStandardSmoothOfRelativeDimension 1 K S_f :=
      Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1 e_K
    exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr inferInstance

  
  have hPointwiseRoof : ∀ {K : Type u} [CommRing K]
      (Y : AlgebraicGeometry.Scheme.{u})
      (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
      (D : Type u) [CommRing D] [Algebra K D]
      (j : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y),
      AlgebraicGeometry.IsOpenImmersion j →
      j ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K D)) →
      ∀ (q : PrimeSpectrum D)
        (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
        (e₁ : U' ⟶ Y)
        (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
        AlgebraicGeometry.Etale e₁ →
        AlgebraicGeometry.Etale e₂ →
        e₁.base u₀ = j.base q →
        e₁ ≫ p_Y =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) →
        ∃ (D' : Type u) (_ : CommRing D')
          (φ_D : D →+* D')
          (φ_node : (MvPolynomial (Fin 2) K ⧸
            Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
              Set (MvPolynomial (Fin 2) K))) →+* D'),
          φ_D.Etale ∧
          φ_node.Etale ∧
          φ_D.comp (algebraMap K D) =
            φ_node.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) ∧
          q ∈ Set.range (PrimeSpectrum.comap φ_D) ∧
          IsOpen (Set.range (PrimeSpectrum.comap φ_D)) := by
    intro K _ Y p_Y D _ _ j hj_open hj_comm q U' u₀ e₁ e₂ he₁_et he₂_et he₁_q he_comm
    let _ : AlgebraicGeometry.IsOpenImmersion j := hj_open
    let _ : AlgebraicGeometry.Etale e₁ := he₁_et
    let _ : AlgebraicGeometry.Etale e₂ := he₂_et
    let PB := CategoryTheory.Limits.pullback e₁ j
    obtain ⟨w₀, _, hw_snd⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback e₁ j) u₀ q he₁_q
    obtain ⟨R', k', hk'_open, ⟨q', hq'⟩, _⟩ :=
      @AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset PB w₀ ⊤ trivial
    let D' : Type u := ↑R'
    let _ : AlgebraicGeometry.IsOpenImmersion k' := hk'_open
    let m_D : AlgebraicGeometry.Spec (CommRingCat.of D') ⟶
        AlgebraicGeometry.Spec (CommRingCat.of D) :=
      k' ≫ CategoryTheory.Limits.pullback.snd e₁ j
    let m_node : AlgebraicGeometry.Spec (CommRingCat.of D') ⟶
        AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) K ⧸
            Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
              Set (MvPolynomial (Fin 2) K)))) :=
      k' ≫ CategoryTheory.Limits.pullback.fst e₁ j ≫ e₂
    have hm_D_et : AlgebraicGeometry.Etale m_D := inferInstance
    have hm_node_et : AlgebraicGeometry.Etale m_node := inferInstance
    let φ_D : D →+* D' := (AlgebraicGeometry.Spec.preimage m_D).hom
    let φ_node : (MvPolynomial (Fin 2) K ⧸
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
          Set (MvPolynomial (Fin 2) K))) →+* D' :=
      (AlgebraicGeometry.Spec.preimage m_node).hom
    have hSpec_D : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_D) = m_D :=
      AlgebraicGeometry.Spec.map_preimage m_D
    have hSpec_node : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_node) = m_node :=
      AlgebraicGeometry.Spec.map_preimage m_node
    rw [← hSpec_D] at hm_D_et
    rw [← hSpec_node] at hm_node_et
    have hφ_D_et : φ_D.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale)).mp hm_D_et
    have hφ_node_et : φ_node.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale)).mp hm_node_et
    have hComm_φ : φ_D.comp (algebraMap K D) =
        φ_node.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) := by
      have hSpecEq :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_D.comp (algebraMap K D))) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (φ_node.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))) := by
        rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_comp,
          AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
          hSpec_D, hSpec_node]
        dsimp only [m_D, m_node]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← hj_comm,
          ← CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.snd e₁ j),
          ← CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.fst e₁ j),
          he_comm, CategoryTheory.Category.assoc]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_inj.mp hSpecEq)
    have hq_mem_range : q ∈ Set.range (PrimeSpectrum.comap φ_D) := by
      refine ⟨q', ?_⟩
      have hbase := congrArg (fun f : AlgebraicGeometry.Spec (CommRingCat.of D') ⟶
          AlgebraicGeometry.Spec (CommRingCat.of D) => f.base q') hSpec_D
      rw [AlgebraicGeometry.Spec.map_base] at hbase
      exact hbase.trans ((congrArg (CategoryTheory.Limits.pullback.snd e₁ j).base hq').trans hw_snd)
    have hOpen_range : IsOpen (Set.range (PrimeSpectrum.comap φ_D)) := by
      let _ : Algebra D D' := φ_D.toAlgebra
      have _ : Algebra.Etale D D' := RingHom.etale_algebraMap.mp hφ_D_et
      exact (PrimeSpectrum.isOpenMap_comap_of_hasGoingDown_of_finitePresentation
        (R := D) (S := D')).isOpen_range
    exact ⟨D', inferInstance, φ_D, φ_node, hφ_D_et, hφ_node_et, hComm_φ, hq_mem_range, hOpen_range⟩

  
  refine ⟨N, R₀, instCR_R₀, instAlg_R₀, hFP_R₀, hPullbackCov, ?_⟩
  intro K_bar _ _ s_gen p_gen
  let Y := CategoryTheory.Limits.pullback p₀ s_gen
  obtain ⟨j_K, hj_K_open, hj_K_comm, _⟩ := hPullbackCov K_bar
  constructor
  · 
    intro hSmNod α
    let D_bar := TensorProduct B₀ K_bar (R₀ α)
    let isSm : PrimeSpectrum D_bar → Prop := fun q =>
      ∃ V : Y.Opens, (j_K α).base q ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ p_gen)
    let _ : DecidablePred isSm := Classical.decPred isSm
    have hWitSm : ∀ (q : PrimeSpectrum D_bar), isSm q →
        ∃ f : D_bar,
          q ∈ PrimeSpectrum.basicOpen f ∧
          RingHom.IsStandardSmoothOfRelativeDimension 1
            (algebraMap K_bar (Localization.Away f)) := by
      intro q ⟨V_q, hq_V, hSm_V⟩
      exact hPointwiseSm Y p_gen D_bar (j_K α) (hj_K_open α) (hj_K_comm α) V_q hSm_V q hq_V
    choose f_wit hf_wit_mem hf_wit_sm using hWitSm
    have hWitRf : ∀ (q : PrimeSpectrum D_bar), ¬ isSm q →
        ∃ (D' : Type u) (_ : CommRing D')
          (φ_D : D_bar →+* D')
          (φ_node : (MvPolynomial (Fin 2) K_bar ⧸
            Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
              Set (MvPolynomial (Fin 2) K_bar))) →+* D'),
          φ_D.Etale ∧
          φ_node.Etale ∧
          φ_D.comp (algebraMap K_bar D_bar) =
            φ_node.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) ∧
          q ∈ Set.range (PrimeSpectrum.comap φ_D) ∧
          IsOpen (Set.range (PrimeSpectrum.comap φ_D)) := by
      intro q hnq
      rcases hSmNod ((j_K α).base q) with hSmAt | ⟨U', u₀, e₁, e₂, he₁, he₂, hu₀, _, he_comm⟩
      · exact False.elim (hnq hSmAt)
      · exact hPointwiseRoof Y p_gen D_bar (j_K α) (hj_K_open α) (hj_K_comm α)
          q U' u₀ e₁ e₂ he₁ he₂ hu₀ he_comm
    choose D'_wit instCR_wit φ_D_wit φ_node_wit hEtD_wit hEtnode_wit hComm_wit hMem_wit hOpen_wit
      using hWitRf
    let U_cov : PrimeSpectrum D_bar → Set (PrimeSpectrum D_bar) := fun q =>
      if hq : isSm q then
        (PrimeSpectrum.basicOpen (f_wit q hq) : Set (PrimeSpectrum D_bar))
      else
        Set.range (PrimeSpectrum.comap (φ_D_wit q hq))
    have hU_open : ∀ q : PrimeSpectrum D_bar, IsOpen (U_cov q) := by
      intro q
      dsimp only [U_cov]
      split_ifs with hq
      · exact (PrimeSpectrum.basicOpen (f_wit q hq)).2
      · exact hOpen_wit q hq
    have hU_univ : (Set.univ : Set (PrimeSpectrum D_bar)) ⊆ ⋃ q, U_cov q := by
      intro q _
      refine Set.mem_iUnion.mpr ⟨q, ?_⟩
      dsimp only [U_cov]
      split_ifs with hq
      · exact hf_wit_mem q hq
      · exact hMem_wit q hq
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover U_cov hU_open hU_univ
    let t_sm : Finset (PrimeSpectrum D_bar) := t.filter isSm
    let t_rf : Finset (PrimeSpectrum D_bar) := t.filter (fun q => ¬ isSm q)
    let m : ℕ := t_sm.card
    let s : ℕ := t_rf.card
    let e_sm : ↥t_sm ≃ Fin m := t_sm.equivFin
    let e_rf : ↥t_rf ≃ Fin s := t_rf.equivFin
    let F_wit : ↥t_sm → D_bar := fun z =>
      f_wit z.1 (Finset.mem_filter.mp z.2).2
    let R_wit : ↥t_rf → Set (PrimeSpectrum D_bar) := fun z =>
      letI : CommRing (D'_wit z.1 (Finset.mem_filter.mp z.2).2) :=
        instCR_wit z.1 (Finset.mem_filter.mp z.2).2
      Set.range (PrimeSpectrum.comap (φ_D_wit z.1 (Finset.mem_filter.mp z.2).2))
    let f : Fin m → D_bar := fun μ => F_wit (e_sm.symm μ)
    let D' : Fin s → Type u := fun ν =>
      D'_wit (e_rf.symm ν).1 (Finset.mem_filter.mp (e_rf.symm ν).2).2
    let instCR_D' : ∀ ν : Fin s, CommRing (D' ν) := fun ν =>
      instCR_wit (e_rf.symm ν).1 (Finset.mem_filter.mp (e_rf.symm ν).2).2
    let φ_D : ∀ ν : Fin s, D_bar →+* D' ν := fun ν =>
      φ_D_wit (e_rf.symm ν).1 (Finset.mem_filter.mp (e_rf.symm ν).2).2
    let φ_node : ∀ ν : Fin s,
        (MvPolynomial (Fin 2) K_bar ⧸
          Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
            Set (MvPolynomial (Fin 2) K_bar))) →+* D' ν := fun ν =>
      φ_node_wit (e_rf.symm ν).1 (Finset.mem_filter.mp (e_rf.symm ν).2).2
    refine ⟨m, f, s, D', instCR_D', φ_D, φ_node, ?_, ?_, ?_, ?_, ?_⟩
    · intro μ
      exact hf_wit_sm (e_sm.symm μ).1 (Finset.mem_filter.mp (e_sm.symm μ).2).2
    · intro ν
      exact hEtD_wit (e_rf.symm ν).1 (Finset.mem_filter.mp (e_rf.symm ν).2).2
    · intro ν
      exact hEtnode_wit (e_rf.symm ν).1 (Finset.mem_filter.mp (e_rf.symm ν).2).2
    · intro ν
      exact hComm_wit (e_rf.symm ν).1 (Finset.mem_filter.mp (e_rf.symm ν).2).2
    · ext q₀
      simp only [Set.mem_union, Set.mem_iUnion, Set.mem_univ, iff_true]
      obtain ⟨q, hq_mem⟩ := Set.mem_iUnion.mp (ht (Set.mem_univ q₀))
      obtain ⟨hq_t, hq₀_U⟩ := Set.mem_iUnion.mp hq_mem
      by_cases hq : isSm q
      · left
        have hq_tsm : q ∈ t_sm := Finset.mem_filter.mpr ⟨hq_t, hq⟩
        refine ⟨e_sm ⟨q, hq_tsm⟩, ?_⟩
        simp only [U_cov, hq, ↓reduceDIte] at hq₀_U
        have hf_eq : f (e_sm ⟨q, hq_tsm⟩) = f_wit q hq :=
          congrArg F_wit (e_sm.symm_apply_apply ⟨q, hq_tsm⟩)
        rwa [hf_eq]
      · right
        have hq_trf : q ∈ t_rf := Finset.mem_filter.mpr ⟨hq_t, hq⟩
        refine ⟨e_rf ⟨q, hq_trf⟩, ?_⟩
        simp only [U_cov, hq, ↓reduceDIte] at hq₀_U
        have hR_eq : R_wit (e_rf.symm (e_rf ⟨q, hq_trf⟩)) = R_wit ⟨q, hq_trf⟩ :=
          congrArg R_wit (e_rf.symm_apply_apply ⟨q, hq_trf⟩)
        change q₀ ∈ R_wit (e_rf.symm (e_rf ⟨q, hq_trf⟩))
        rw [hR_eq]
        exact hq₀_U
  · 
    intro hSm α
    let _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_gen := hSm
    let D_bar := TensorProduct B₀ K_bar (R₀ α)
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 (⊤ : Y.Opens).ι := inferInstance
    have hSmTop : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
        ((⊤ : Y.Opens).ι ≫ p_gen) := inferInstance
    have hWit' : ∀ q : PrimeSpectrum D_bar,
        ∃ f : D_bar,
          q ∈ PrimeSpectrum.basicOpen f ∧
          RingHom.IsStandardSmoothOfRelativeDimension 1
            (algebraMap K_bar (Localization.Away f)) := by
      intro q
      exact hPointwiseSm Y p_gen D_bar (j_K α) (hj_K_open α) (hj_K_comm α)
        ⊤ hSmTop q trivial
    choose f'_wit hf'_mem hf'_sm using hWit'
    obtain ⟨t', ht'⟩ := isCompact_univ.elim_finite_subcover
      (fun q => (PrimeSpectrum.basicOpen (f'_wit q) : Set (PrimeSpectrum D_bar)))
      (fun q => (PrimeSpectrum.basicOpen (f'_wit q)).2)
      (fun q _ => Set.mem_iUnion.mpr ⟨q, hf'_mem q⟩)
    let m' : ℕ := t'.card
    let e' : ↥t' ≃ Fin m' := t'.equivFin
    let f' : Fin m' → D_bar := fun μ => f'_wit (e'.symm μ).1
    refine ⟨m', f', fun μ => hf'_sm (e'.symm μ).1, ?_⟩
    ext q₀
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    obtain ⟨q, hq_mem⟩ := Set.mem_iUnion.mp (ht' (Set.mem_univ q₀))
    obtain ⟨hq_t', hq₀_basic⟩ := Set.mem_iUnion.mp hq_mem
    refine ⟨e' ⟨q, hq_t'⟩, ?_⟩
    have h_symm : (e'.symm (e' ⟨q, hq_t'⟩)).1 = q := by simp
    dsimp only [f']
    rwa [h_symm]

