      σ ≫ p = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀)) →
      Function.Bijective (p.appTop).hom)
    (hBirIso : ∀ (C_bar : AlgebraicGeometry.Scheme.{u})
        (F_ss : Type u) [Field F_ss]
        (f' : C_bar ⟶ (weilProjectiveSpaceOver k₀ 1).left)
        (η_C : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ C_bar)
        (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ (weilProjectiveSpaceOver k₀ 1).left),
      AlgebraicGeometry.IsIntegral C_bar →
      AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k₀ 1).left →
      IsAffineNormalScheme (weilProjectiveSpaceOver k₀ 1).left →
      AlgebraicGeometry.IsProper f' →
      AlgebraicGeometry.IsDominant η_C →
      η_C ≫ f' = η_X →
      IsSchemeFunctionField C_bar F_ss η_C →
      IsSchemeFunctionField (weilProjectiveSpaceOver k₀ 1).left F_ss η_X →
      (∀ z : C_bar,
        ∃ (U_X : (weilProjectiveSpaceOver k₀ 1).left.Opens)
          (_ : AlgebraicGeometry.IsAffineOpen U_X)
          (V_C : C_bar.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
          (e_X : V_C ≤ (TopologicalSpace.Opens.map f'.base).obj U_X),
          z ∈ V_C ∧
          (f'.appLE U_X V_C e_X).hom.FiniteType ∧
          (f'.appLE U_X V_C e_X).hom.QuasiFinite) →
      CategoryTheory.IsIso f')
    (hFuncField : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      AlgebraicGeometry.IsIntegral Y →
      ∀ (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀)),
        ∃ (F : Type u) (_ : Field F) (_ : Algebra k₀ F)
          (η : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y),
          η ≫ p = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₀ F)) ∧
          IsSchemeFunctionField Y F η ∧
          ∀ (U : Y.Opens), Nonempty U →
            ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)), η.base pt ∈ U)
    (Z₀ : AlgebraicGeometry.Scheme.{u})
    (p_Z₀ : Z₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    [AlgebraicGeometry.IsProper p_Z₀]
    [AlgebraicGeometry.IsReduced Z₀]
    (hFinComp : (irreducibleComponents ↥Z₀).Finite)
    (hNeComp : (irreducibleComponents ↥Z₀).Nonempty)
    (Sing_Z₀ S_inter : Set ↥Z₀)
    (hFinSing : Sing_Z₀.Finite)
    (hSubSing : S_inter ⊆ Sing_Z₀)
    (hTreeLB : (irreducibleComponents ↥Z₀).ncard ≤ S_inter.ncard + 1)
    (Z_00 Z_01 : Z₀.Opens)
    (hAff0 : AlgebraicGeometry.IsAffineOpen Z_00)
    (hAff1 : AlgebraicGeometry.IsAffineOpen Z_01)
    (hCov01 : Z_00 ⊔ Z_01 = ⊤)
    (hSing01 : Sing_Z₀ ⊆ (Z_00 ⊓ Z_01 : Set ↥Z₀))
    (hMeetSm : ∀ Z_comp ∈ irreducibleComponents ↥Z₀,
      (Z_comp ∩ ((Z_00 ⊓ Z_01 : Set ↥Z₀) \ Sing_Z₀)).Nonempty)
    (y₁ : ↑(Z₀.presheaf.obj (Opposite.op Z_00)))
    (x₀ : ↑(Z₀.presheaf.obj (Opposite.op Z_01)))
    (hy₁_open : Z₀.basicOpen y₁ = Z_00 ⊓ Z_01)
    (hx₀_open : Z₀.basicOpen x₀ = Z_00 ⊓ Z_01)
    (hyx_one :
      (Z₀.presheaf.map (CategoryTheory.homOfLE (inf_le_left : Z_00 ⊓ Z_01 ≤ Z_00)).op).hom y₁ *
      (Z₀.presheaf.map (CategoryTheory.homOfLE (inf_le_right : Z_00 ⊓ Z_01 ≤ Z_01)).op).hom x₀ = 1)
    (hSmB₀ : ∀ q : PrimeSpectrum ↑(Z₀.presheaf.obj (Opposite.op Z_00)),
      hAff0.fromSpec.base q ∉ Sing_Z₀ →
      ∃ (g : ↑(Z₀.presheaf.obj (Opposite.op Z_00)))
        (_ : IsDomain (Localization.Away g)),
        g ∉ q.asIdeal ∧
