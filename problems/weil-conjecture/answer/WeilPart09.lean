          (s''.1 * (r'_1 * s'_2.1)) * d_u - (s''.1 * (s'_1.1 * r'_2)) * d_v = 0
        linear_combination h1
      choose t a b htab using h_rel_each
      exact ⟨d_u, d_v, a₂₀, a₁₁, a₀₂, r, y, t, a, b,
        hdu_mem, hdv_mem, ha₂₀_mem, ha₀₂_mem, ha₁₁_mem, h_quad, hy_adjoin,
        fun j => ⟨hy_mem j, (htab j).1, (htab j).2⟩⟩
