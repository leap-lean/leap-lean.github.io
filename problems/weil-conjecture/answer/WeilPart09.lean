        have hu0_val : (↑u_s₀' : L_N) = algebraMap N L_N s₀' := hu_s₀'
        rw [hu0_val, hu_s, ← hs₀']
        exact Localization.localRingHom_to_map q_N q₄ Psi4_bar rfl s₀'
