  let U_Z1 : (Z_sch 𝔭).Opens := (TopologicalSpace.Opens.map (ι_Z 𝔭).base).obj Z_01
  letI : Algebra k₀ ↑((Z_sch 𝔭).presheaf.obj (Opposite.op U_Z0)) :=
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      (ι_Z 𝔭 ≫ p_Z₀).appLE ⊤ U_Z0 le_top).hom).toAlgebra
  letI : Algebra k₀ ↑((Z_sch 𝔭).presheaf.obj (Opposite.op U_Z1)) :=
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      (ι_Z 𝔭 ≫ p_Z₀).appLE ⊤ U_Z1 le_top).hom).toAlgebra
  have hs₁'_ne : isoB s₁ ≠ 0 := by
    intro h0
    exact hs₁_ne (isoB.injective (h0.trans (map_zero isoB).symm))
  have hs_reg'_ne : isoB s_reg ≠ 0 := by
    intro h0
    exact hs_reg_ne (isoB.injective (h0.trans (map_zero isoB).symm))
  have hPoleEq_Z := hOverlap_Z a₁ s₁ c_u hPole_u
  have hRegEq_Z := hOverlap_Z s_reg b_reg c_u hReg_u
  have hAvoid_Z : ∀ (𝔭' : Ideal ↑((Z_sch 𝔭).presheaf.obj (Opposite.op U_Z0))),
      𝔭'.IsPrime → ((ι_Z 𝔭).app Z_00).hom y₁ ∈ 𝔭' →
      (isoB s₁ ∉ 𝔭' ∨ isoB s_reg ∉ 𝔭') := by
    intro 𝔭' h𝔭' hy_mem
    let 𝔭₀ : Ideal (B₀ ⧸ 𝔮.1) := Ideal.comap isoB.toRingHom 𝔭'
    have h𝔭₀ : 𝔭₀.IsPrime := Ideal.comap_isPrime isoB.toRingHom 𝔭'
    have hy_q_mem : Ideal.Quotient.mk 𝔮.1 y₁ ∈ 𝔭₀ := by
      change isoB (Ideal.Quotient.mk 𝔮.1 y₁) ∈ 𝔭'
      rwa [hisoB_y₁]
    rcases hAvoid_q 𝔭₀ h𝔭₀ hy_q_mem with hs₁_out | hs_reg_out
    · exact Or.inl hs₁_out
    · exact Or.inr hs_reg_out
  have hRat_Z :
      (∀ P : Polynomial k₀, Polynomial.aeval (isoC c_u) P = 0 → P = 0) ∧
      (∀ z' : ↑((Z_sch 𝔭).presheaf.obj (Opposite.op U_Z1)),
        ∃ P Q : Polynomial k₀, Q ≠ 0 ∧
          z' * Polynomial.aeval (isoC c_u) Q = Polynomial.aeval (isoC c_u) P) := by
    have hAeval : ∀ (x : C_aff ⧸ 𝔭.1) (P : Polynomial k₀),
        Polynomial.aeval (isoC x) P = isoC (Polynomial.aeval x P) :=
      fun x P => Polynomial.aeval_algHom_apply isoC x P
    refine ⟨?_, ?_⟩
    · intro P hP0
      have hP0' : isoC (Polynomial.aeval c_u P) = 0 := (hAeval c_u P).symm.trans hP0
      exact hTrans_cu P (isoC.injective (hP0'.trans (map_zero isoC).symm))
    · intro z'
      obtain ⟨P, Q, hQ_ne, hPQ⟩ := hRat_cu (isoC.symm z')
      refine ⟨P, Q, hQ_ne, ?_⟩
      have h1 : z' * Polynomial.aeval (isoC c_u) Q =
          isoC (isoC.symm z') * isoC (Polynomial.aeval c_u Q) :=
        congrArg₂ (· * ·) (isoC.apply_symm_apply z').symm (hAeval c_u Q)
      exact h1.trans (((map_mul isoC _ _).symm.trans (congrArg isoC hPQ)).trans (hAeval c_u P).symm)
  obtain ⟨isoP1_0, hisoP1_0⟩ :=
    weil_twoChart_integral_polar_projLine_iso k₀ hAff_P1 c_P1 t_P1 hCoordP1 hBirIso hFuncField
      (Z_sch 𝔭) (ι_Z 𝔭 ≫ p_Z₀) U_Z0 U_Z1 hAff_UZ0 hAff_UZ1 hCov_Z hNe0_Z hNe1_Z
      (((ι_Z 𝔭).app Z_00).hom y₁) hBasic_Z (isoC c_u)
      (isoB s₁) (isoB a₁) (isoB s_reg) (isoB b_reg)
      hs₁'_ne hs_reg'_ne hPoleEq_Z hRegEq_Z hAvoid_Z hRat_Z
  exact ⟨Z_sch 𝔭, ι_Z 𝔭, hCl_Z 𝔭, hInt_Z 𝔭, hRange_eq, isoP1_0, hisoP1_0⟩

theorem weil_proj_p1_reduced_nodal_specialization_is_p1_tree (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Finite (PrimeSpectrum R)]
    (hMaxR : IsLocalRing.maximalIdeal R ≠ ⊥)
    (K_R : Type u) [Field K_R] [IsAlgClosed K_R] [Algebra R K_R] [IsFractionRing R K_R]
    (hAlgRes : IsAlgClosed (IsLocalRing.ResidueField R))
    (hEtDom : ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
        [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B]
        (q : PrimeSpectrum B),
      ∃ g : B, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g))
    (M : ℕ)
    (E_bar : AlgebraicGeometry.Scheme.{u})
    (ι_bar : E_bar ⟶ (weilProjectiveSpaceOver R M).left)
    (hCl : AlgebraicGeometry.IsClosedImmersion ι_bar)
    (hInt : AlgebraicGeometry.IsIntegral E_bar)
    (hGenIso : ∃ isoP1 :
        CategoryTheory.Limits.pullback
          (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))) ≅
        (weilProjectiveSpaceOver K_R 1).left,
      CategoryTheory.Limits.pullback.snd
          (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))) =
        isoP1.hom ≫ (weilProjectiveSpaceOver K_R 1).hom)
    (hConnZ₀ : ConnectedSpace ↥(CategoryTheory.Limits.pullback
      (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))))
    (hRedZ₀ : AlgebraicGeometry.IsReduced (CategoryTheory.Limits.pullback
      (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))))
    (hNodZ₀ : ∀ z : ↥(CategoryTheory.Limits.pullback
        (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))),
      HasSpreadSmoothOrNodalAt
        (CategoryTheory.Limits.pullback.snd
          (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
        z) :
    let k₀ := IsLocalRing.ResidueField R
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))
    let Z₀ := CategoryTheory.Limits.pullback (ι_bar ≫ (weilProjectiveSpaceOver R M).hom) s₀
    let S_inter : Set ↥Z₀ :=
      {z : ↥Z₀ | ∃ Z₁ ∈ irreducibleComponents ↥Z₀, ∃ Z₂ ∈ irreducibleComponents ↥Z₀,
        Z₁ ≠ Z₂ ∧ z ∈ Z₁ ∧ z ∈ Z₂}
    ((irreducibleComponents ↥Z₀).Finite ∧ (irreducibleComponents ↥Z₀).Nonempty) ∧
    (∀ Z_comp ∈ irreducibleComponents ↥Z₀,
      ∃ (Z_sch : AlgebraicGeometry.Scheme.{u}) (ι_Z : Z_sch ⟶ Z₀),
        AlgebraicGeometry.IsClosedImmersion ι_Z ∧
        AlgebraicGeometry.IsIntegral Z_sch ∧
        Set.range ι_Z.base = Z_comp ∧
        ∃ isoP1_0 : Z_sch ≅ (weilProjectiveSpaceOver k₀ 1).left,
          ι_Z ≫ CategoryTheory.Limits.pullback.snd
              (ι_bar ≫ (weilProjectiveSpaceOver R M).hom) s₀ =
            isoP1_0.hom ≫ (weilProjectiveSpaceOver k₀ 1).hom) ∧
    (S_inter.Finite ∧
      S_inter.ncard + 1 ≤ (irreducibleComponents ↥Z₀).ncard ∧
      ∀ z ∈ S_inter,
        ∀ Z₁ ∈ irreducibleComponents ↥Z₀,
        ∀ Z₂ ∈ irreducibleComponents ↥Z₀,
        ∀ Z₃ ∈ irreducibleComponents ↥Z₀,
          z ∈ Z₁ → z ∈ Z₂ → z ∈ Z₃ → Z₁ = Z₂ ∨ Z₁ = Z₃ ∨ Z₂ = Z₃) :=
by
  classical
  let k₀ : Type u := IsLocalRing.ResidueField R
  have : IsAlgClosed k₀ := hAlgRes
  let p_E := ι_bar ≫ (weilProjectiveSpaceOver R M).hom
  let η_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))
  let E_K := CategoryTheory.Limits.pullback p_E η_R
  let Z₀ := CategoryTheory.Limits.pullback p_E s₀
  let p_Z₀ := CategoryTheory.Limits.pullback.snd p_E s₀
  let Sing_Z₀ : Set ↥Z₀ :=
    {z : ↥Z₀ | ¬ ∃ V_sm : Z₀.Opens,
      z ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Z₀)}
  let S_inter : Set ↥Z₀ :=
    {z : ↥Z₀ | ∃ Z₁ ∈ irreducibleComponents ↥Z₀, ∃ Z₂ ∈ irreducibleComponents ↥Z₀,
      Z₁ ≠ Z₂ ∧ z ∈ Z₁ ∧ z ∈ Z₂}
  
  obtain ⟨hAff_proj, c_proj, t_proj, hCoord_proj, hBase_proj⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg.{u}
  obtain ⟨⟨h1M, hFinC, hNeC, hFinSing, hSubSing, hFinS, hSingCl, hAtMost2⟩,
      ι'_bar, ι'_0, Φ_Rk₀, hCl', hComm_bar, hBC_Rk₀, hCl_0, hComm_0, hPb_0,
      hCov01, hSing01, hMeetSm, hSmCharts, hNodCharts⟩ :=
    weil_proj_nodal_fiber_finiteness_and_gl_twoChart_placement
      R K_R hAlgRes hEtDom M hAff_proj c_proj t_proj hCoord_proj hBase_proj
      E_bar p_E ι_bar hCl hInt rfl hGenIso hRedZ₀ hNodZ₀
  have : ConnectedSpace ↥Z₀ := hConnZ₀
  have : AlgebraicGeometry.IsReduced Z₀ := hRedZ₀
  have : AlgebraicGeometry.IsClosedImmersion ι'_bar := hCl'
  have : AlgebraicGeometry.IsClosedImmersion ι'_0 := hCl_0
  have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R M).hom := (hCoord_proj R M).1
  have hProp_pE : AlgebraicGeometry.IsProper p_E := by
    have : AlgebraicGeometry.IsProper (ι'_bar ≫ (weilProjectiveSpaceOver R M).hom) :=
      inferInstance
    rwa [hComm_bar] at this
  have : AlgebraicGeometry.IsProper p_Z₀ := inferInstance
  
  have hTreeLB : (irreducibleComponents ↥Z₀).ncard ≤ S_inter.ncard + 1 := by
    let C_fin : Finset (Set ↥Z₀) := hFinC.toFinset
    let S_fin : Finset ↥Z₀ := hFinS.toFinset
    have hC_card : (irreducibleComponents ↥Z₀).ncard = C_fin.card :=
      Set.ncard_eq_toFinset_card _ hFinC
    have hS_card : S_inter.ncard = S_fin.card :=
      Set.ncard_eq_toFinset_card _ hFinS
    rw [hC_card, hS_card]
    have hStep : ∀ k : ℕ, 1 ≤ k → k ≤ C_fin.card →
        ∃ (A : Finset (Set ↥Z₀)) (E : Finset ↥Z₀),
          A ⊆ C_fin ∧
          E ⊆ S_fin ∧
          A.card = k ∧
          E.card + 1 = k ∧
          ∀ s ∈ E, ∃ Z₁ ∈ A, ∃ Z₂ ∈ A, Z₁ ≠ Z₂ ∧ s ∈ Z₁ ∧ s ∈ Z₂ := by
      intro k hk1
      induction k with
      | zero => omega
      | succ m ih =>
        intro hm_le
        rcases Nat.eq_zero_or_pos m with rfl | hm_pos
        · rcases hNeC with ⟨Z₀_w, hZ₀_w⟩
          refine ⟨{Z₀_w}, ∅, ?_, Finset.empty_subset _, Finset.card_singleton Z₀_w, rfl, ?_⟩
          · intro Z hZ
            rw [Finset.mem_singleton] at hZ
            subst hZ
            exact hFinC.mem_toFinset.mpr hZ₀_w
          · intro s hs
            exact False.elim (Finset.notMem_empty s hs)
        · obtain ⟨A, E, hA_sub, hE_sub, hA_card, hE_card, hE_prop⟩ :=
            ih hm_pos (Nat.le_of_succ_le hm_le)
          have hDiff_ne : (C_fin \ A).Nonempty := by
            by_contra hEmpty
            rw [Finset.not_nonempty_iff_eq_empty, Finset.sdiff_eq_empty_iff_subset] at hEmpty
            have hle := Finset.card_le_card hEmpty
            omega
          have hA_ne : A.Nonempty := Finset.card_pos.mp (by omega)
          let U_in : Set ↥Z₀ := ⋃ Z ∈ A, Z
          let U_out : Set ↥Z₀ := ⋃ Z ∈ C_fin \ A, Z
          have hCl_in : IsClosed U_in :=
            A.finite_toSet.isClosed_biUnion fun Z hZ =>
              isClosed_of_mem_irreducibleComponents Z (hFinC.mem_toFinset.mp (hA_sub hZ))
          have hCl_out : IsClosed U_out :=
            (C_fin \ A).finite_toSet.isClosed_biUnion fun Z hZ =>
              isClosed_of_mem_irreducibleComponents Z
                (hFinC.mem_toFinset.mp (Finset.sdiff_subset hZ))
          have hCov : (Set.univ : Set ↥Z₀) ⊆ U_in ∪ U_out := by
            intro x _
            have hx_comp : irreducibleComponent x ∈ C_fin :=
              hFinC.mem_toFinset.mpr (irreducibleComponent_mem_irreducibleComponents x)
            have hx_mem : x ∈ irreducibleComponent x := mem_irreducibleComponent
            by_cases hxA : irreducibleComponent x ∈ A
            · exact Or.inl (Set.mem_biUnion hxA hx_mem)
            · exact Or.inr (Set.mem_biUnion (Finset.mem_sdiff.mpr ⟨hx_comp, hxA⟩) hx_mem)
          have hNe_in : (Set.univ ∩ U_in).Nonempty := by
            rcases hA_ne with ⟨Z₁, hZ₁⟩
            rcases (hFinC.mem_toFinset.mp (hA_sub hZ₁)).1.1 with ⟨z₁, hz₁⟩
            exact ⟨z₁, trivial, Set.mem_biUnion hZ₁ hz₁⟩
          have hNe_out : (Set.univ ∩ U_out).Nonempty := by
            rcases hDiff_ne with ⟨Z₂, hZ₂⟩
            rcases (hFinC.mem_toFinset.mp (Finset.sdiff_subset hZ₂)).1.1 with ⟨z₂, hz₂⟩
            exact ⟨z₂, trivial, Set.mem_biUnion hZ₂ hz₂⟩
          obtain ⟨s_new, _, hs_in, hs_out⟩ :=
            (isPreconnected_closed_iff.mp isPreconnected_univ) U_in U_out hCl_in hCl_out
              hCov hNe_in hNe_out
          rcases Set.mem_iUnion₂.mp hs_in with ⟨Z_in, hZ_in, hs_Zin⟩
          rcases Set.mem_iUnion₂.mp hs_out with ⟨Z_out, hZ_out_sdiff, hs_Zout⟩
          obtain ⟨hZ_out_C, hZ_out_notA⟩ := Finset.mem_sdiff.mp hZ_out_sdiff
          have hZ_ne : Z_in ≠ Z_out := fun hEq => hZ_out_notA (hEq ▸ hZ_in)
          have hs_S : s_new ∈ S_fin := by
            rw [hFinS.mem_toFinset]
            exact ⟨Z_in, hFinC.mem_toFinset.mp (hA_sub hZ_in),
              Z_out, hFinC.mem_toFinset.mp hZ_out_C, hZ_ne, hs_Zin, hs_Zout⟩
          have hs_notE : s_new ∉ E := by
            intro hsE
            obtain ⟨Z₁, hZ₁_A, Z₂, hZ₂_A, hZ12, hs₁, hs₂⟩ := hE_prop s_new hsE
            have h1o : Z₁ ≠ Z_out := fun hEq => hZ_out_notA (hEq ▸ hZ₁_A)
            have h2o : Z₂ ≠ Z_out := fun hEq => hZ_out_notA (hEq ▸ hZ₂_A)
            rcases hAtMost2 s_new
              Z₁ (hFinC.mem_toFinset.mp (hA_sub hZ₁_A))
              Z₂ (hFinC.mem_toFinset.mp (hA_sub hZ₂_A))
              Z_out (hFinC.mem_toFinset.mp hZ_out_C)
              hs₁ hs₂ hs_Zout with h | h | h
            · exact hZ12 h
            · exact h1o h
            · exact h2o h
          refine ⟨insert Z_out A, insert s_new E, ?_, ?_, ?_, ?_, ?_⟩
          · intro Z hZ
            rcases Finset.mem_insert.mp hZ with rfl | hZ_A
            · exact hZ_out_C
            · exact hA_sub hZ_A
          · intro s hs
            rcases Finset.mem_insert.mp hs with rfl | hs_E
            · exact hs_S
            · exact hE_sub hs_E
          · rw [Finset.card_insert_of_notMem hZ_out_notA, hA_card]
          · rw [Finset.card_insert_of_notMem hs_notE, hE_card]
          · intro s hs
            rcases Finset.mem_insert.mp hs with rfl | hs_E
            · exact ⟨Z_in, Finset.mem_insert_of_mem hZ_in,
                Z_out, Finset.mem_insert_self Z_out A, hZ_ne, hs_Zin, hs_Zout⟩
            · obtain ⟨Z₁, hZ₁_A, Z₂, hZ₂_A, hZ12, hs₁, hs₂⟩ := hE_prop s hs_E
              exact ⟨Z₁, Finset.mem_insert_of_mem hZ₁_A,
                Z₂, Finset.mem_insert_of_mem hZ₂_A, hZ12, hs₁, hs₂⟩
    have hC_pos : 1 ≤ C_fin.card := by
      rcases hNeC with ⟨Z₀_w, hZ₀_w⟩
      exact Finset.card_pos.mpr ⟨Z₀_w, hFinC.mem_toFinset.mpr hZ₀_w⟩
    obtain ⟨A, E, _, hE_sub, _, hE_card, _⟩ := hStep C_fin.card hC_pos le_rfl
    have hE_le : E.card ≤ S_fin.card := Finset.card_le_card hE_sub
    omega
  
  let Z_00 : Z₀.Opens :=
    (TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M 0)
  let Z_01 : Z₀.Opens :=
    (TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M (Fin.last M))
  have hAff0 : AlgebraicGeometry.IsAffineOpen Z_00 := (hAff_proj k₀ M 0).preimage ι'_0
  have hAff1 : AlgebraicGeometry.IsAffineOpen Z_01 := (hAff_proj k₀ M (Fin.last M)).preimage ι'_0
  let B₀ : Type u := ↑(Z₀.presheaf.obj (Opposite.op Z_00))
  let C_aff : Type u := ↑(Z₀.presheaf.obj (Opposite.op Z_01))
  let α_1 : k₀ →+* C_aff :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_Z₀.appLE ⊤ Z_01 le_top).hom
  letI : Algebra k₀ B₀ :=
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_Z₀.appLE ⊤ Z_00 le_top).hom).toAlgebra
  letI : Algebra k₀ C_aff := α_1.toAlgebra
  let y₁ : B₀ := (ι'_0.app (weilProjBasicOpen k₀ M 0)).hom (t_proj k₀ M 0 (Fin.last M))
  let x₀ : C_aff := (ι'_0.app (weilProjBasicOpen k₀ M (Fin.last M))).hom
    (t_proj k₀ M (Fin.last M) 0)
  have hy₁_open : Z₀.basicOpen y₁ = Z_00 ⊓ Z_01 := by
    dsimp [y₁]
    rw [← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ι'_0
      (t_proj k₀ M 0 (Fin.last M)), (hCoord_proj k₀ M).2.2.2.2.2.2.2.1 0 (Fin.last M)]
    rfl
  have hx₀_open : Z₀.basicOpen x₀ = Z_00 ⊓ Z_01 := by
    dsimp [x₀]
    rw [← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ι'_0
      (t_proj k₀ M (Fin.last M) 0), (hCoord_proj k₀ M).2.2.2.2.2.2.2.1 (Fin.last M) 0]
    exact inf_comm Z_01 Z_00
  have hyx_one :
      (Z₀.presheaf.map (CategoryTheory.homOfLE (inf_le_left : Z_00 ⊓ Z_01 ≤ Z_00)).op).hom y₁ *
      (Z₀.presheaf.map (CategoryTheory.homOfLE (inf_le_right : Z_00 ⊓ Z_01 ≤ Z_01)).op).hom x₀ =
        1 := by
    have hC10 := (hCoord_proj k₀ M).2.2.2.2.2.2.2.2.2 0 (Fin.last M) 0
    rw [(hCoord_proj k₀ M).2.2.2.2.1 0, map_one] at hC10
    let U0 := weilProjBasicOpen k₀ M 0
    let U1 := weilProjBasicOpen k₀ M (Fin.last M)
    have hNatL := ι'_0.naturality (CategoryTheory.homOfLE (inf_le_left : U0 ⊓ U1 ≤ U0)).op
    have hNatR := ι'_0.naturality (CategoryTheory.homOfLE (inf_le_right : U0 ⊓ U1 ≤ U1)).op
    have hL : (Z₀.presheaf.map (CategoryTheory.homOfLE (inf_le_left : Z_00 ⊓ Z_01 ≤ Z_00)).op).hom
        y₁ = (ι'_0.app (U0 ⊓ U1)).hom
          (((weilProjectiveSpaceOver k₀ M).left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : U0 ⊓ U1 ≤ U0)).op).hom
            (t_proj k₀ M 0 (Fin.last M))) :=
      ConcreteCategory.congr_hom hNatL.symm (t_proj k₀ M 0 (Fin.last M))
    have hR : (Z₀.presheaf.map (CategoryTheory.homOfLE (inf_le_right : Z_00 ⊓ Z_01 ≤ Z_01)).op).hom
        x₀ = (ι'_0.app (U0 ⊓ U1)).hom
          (((weilProjectiveSpaceOver k₀ M).left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_right : U0 ⊓ U1 ≤ U1)).op).hom
            (t_proj k₀ M (Fin.last M) 0)) :=
      ConcreteCategory.congr_hom hNatR.symm (t_proj k₀ M (Fin.last M) 0)
    have hMul :
        (ι'_0.app (U0 ⊓ U1)).hom
          (((weilProjectiveSpaceOver k₀ M).left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : U0 ⊓ U1 ≤ U0)).op).hom
            (t_proj k₀ M 0 (Fin.last M))) *
        (ι'_0.app (U0 ⊓ U1)).hom
