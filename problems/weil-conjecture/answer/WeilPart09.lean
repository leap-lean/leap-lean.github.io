      have : IsNoetherianRing R_i := Ideal.Quotient.isNoetherianRing _
      let π_j_bar : R_i := π_i u_j
      have h_max_Ri : Ideal.span {π_j_bar} = IsLocalRing.maximalIdeal R_i := by
