        rw [hd, mul_one]
      obtain ⟨c, hc⟩ := hp_bij.2 (Ideal.Quotient.mk p (MvPolynomial.X 0))
      have hXc_mem : (MvPolynomial.X 0 - MvPolynomial.C c : MvPolynomial (Fin 1) Ω) ∈ p :=
