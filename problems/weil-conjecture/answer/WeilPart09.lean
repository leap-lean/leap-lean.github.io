    rw [Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]
  
  have hChartEquiv : ∀ (a b : Fin 2), a ≠ b →
      ∃ (Φ : Polynomial Ω ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a)),
        (∀ c : Ω, Φ (Polynomial.C c) =
          HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X a)) (algebraMap Ω ↥(𝒜 0) c)) ∧
        Φ Polynomial.X =
          HomogeneousLocalization.Away.mk 𝒜 (hX_mem a) 1 (MvPolynomial.X b) (hX_mem b) := by
    intro a b hab
    let X_a : MvPolynomial (Fin 2) Ω := MvPolynomial.X a
    let X_b : MvPolynomial (Fin 2) Ω := MvPolynomial.X b
    let S_a : Submonoid (MvPolynomial (Fin 2) Ω) := Submonoid.powers X_a
    let ι_a : Ω →+* HomogeneousLocalization.Away 𝒜 X_a :=
