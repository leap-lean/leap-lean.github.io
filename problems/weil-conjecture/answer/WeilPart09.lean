          exact (IsScalarTower.algebraMap_apply D D_Q D_QZ d).symm
        dsimp [Q_D] at h_map_QD
        simp only [map_add, map_sub, map_mul, map_pow, map_ofNat, h_c_eq] at h_map_QD
        dsimp [c₂] at h_map_QD
        simp only [map_add] at h_map_QD
