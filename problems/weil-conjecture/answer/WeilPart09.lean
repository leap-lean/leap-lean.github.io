        rw [hι_aux_C, hα_C, hα₂_C, MvPolynomial.aeval_C]
      | add p q hp hq => simp only [map_add, hp, hq]
      | mul_X p j hp =>
        rw [map_mul, map_mul, map_mul, map_mul, hp, hι_aux_X, hα_Wj, MvPolynomial.aeval_X]
    have hζ_inv_mul : ζ * ↑ζ_u⁻¹ = 1 := by
      have hζ_val : ζ = ↑ζ_u := hζ_u.symm
      rw [hζ_val, Units.mul_inv]
    have hα_rel_ker : I_big ≤ RingHom.ker α_big := by
      rw [Ideal.span_le]
      rintro _ ⟨v, rfl⟩
      cases v with
      | inl w =>
        cases w with
        | inl i =>
          fin_cases i
          · change α_big H₀_rel = 0
            simp only [H₀_rel, map_sub, map_mul, map_one, hα_U0, hα_X0, hα_Y1, hα_Z]
            calc
