      have hFinrank2 : Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 := by
        let Φ₃_P : MvPolynomial (Fin 2) Ω →ₗ[Ω] (Fin 3 → Ω) :=
          LinearMap.pi ![MvPolynomial.lcoeff Ω d00, MvPolynomial.lcoeff Ω d10, MvPolynomial.lcoeff Ω d01]
        have hΦ₃_J : ∀ H ∈ J_node, Φ₃_P H = 0 := by
          intro H hH; ext j; fin_cases j
          · exact hJ_node_pure H hH d00 (Or.inl rfl)
          · exact hJ_node_pure H hH d10 (Or.inr (by simp [d10]))
          · exact hJ_node_pure H hH d01 (Or.inl (by simp [d01]))
        obtain ⟨Φ₃_R, hΦ₃_R_mk⟩ := liftQuotLinear J_node Φ₃_P hΦ₃_J
        have hΦ₃_m2 : ∀ r ∈ m_node ^ 2, Φ₃_R r = 0 := by
          rw [← Ideal.map_pow]
          intro r hr
