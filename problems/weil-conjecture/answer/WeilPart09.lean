    obtain ⟨A₀₂_0, hA₀₂_0⟩ := h_aeval_y_surj a₀₂
    have h_lift_tab : ∀ j : Fin r, ∃ S₀ A₀ B₀ : P_aux,
        MvPolynomial.aeval y S₀ = t j ∧
        MvPolynomial.aeval y A₀ = a j ∧
        MvPolynomial.aeval y B₀ = b j := by
      intro j
      obtain ⟨S₀, hS₀⟩ := h_aeval_y_surj (t j)
      obtain ⟨A₀, hA₀⟩ := h_aeval_y_surj (a j)
      obtain ⟨B₀, hB₀⟩ := h_aeval_y_surj (b j)
      exact ⟨S₀, A₀, B₀, hS₀, hA₀, hB₀⟩
    choose S₀ A₀ B₀ hSAB₀ using h_lift_tab
    let A_20 : P_big := ι_aux A₂₀_0
    let A_11 : P_big := ι_aux A₁₁_0
    let A_02 : P_big := ι_aux A₀₂_0
    let C_2 : P_big := A_20 + A_11 + A_02
    let S_tilde : Fin r → P_big := fun j => ι_aux (S₀ j)
    let A_tilde : Fin r → P_big := fun j => ι_aux (A₀ j)
    let B_tilde : Fin r → P_big := fun j => ι_aux (B₀ j)
    let X_b : P_big := MvPolynomial.X (Sum.inl (Sum.inl 0))
    let Y_b : P_big := MvPolynomial.X (Sum.inl (Sum.inl 1))
    let W_b : Fin r → P_big := fun j => MvPolynomial.X (Sum.inl (Sum.inr j))
    let Z_b : P_big := MvPolynomial.X (Sum.inr ())
    let U₀_b : P_big := MvPolynomial.C U₀
    let U₁_b : P_big := MvPolynomial.C U₁
    let H₀_rel : P_big := Z_b * U₀_b - Z_b * X_b - (1 - Z_b) * Y_b
    let H₁_rel : P_big := Z_b * U₁_b - Z_b * A_20 * X_b - (Z_b * A_11 - A_20 * (1 - Z_b)) * Y_b
    let G_rel : Fin r → P_big := fun j => S_tilde j * W_b j - A_tilde j * X_b - B_tilde j * Y_b
    let Q_rel : P_big := C_2 * Z_b ^ 2 - (2 * A_20 + A_11) * Z_b + A_20
    let rel : ι_var → P_big := fun v =>
      match v with
      | Sum.inl (Sum.inl i) => if i = 0 then H₀_rel else H₁_rel
      | Sum.inl (Sum.inr j) => G_rel j
      | Sum.inr () => Q_rel
    let I_big : Ideal P_big := Ideal.span (Set.range rel)
    let Q_big : Type u := P_big ⧸ I_big
    let π_big : P_big →+* Q_big := Ideal.Quotient.mk I_big
    let J_tot : Matrix ι_var ι_var P_big :=
      Matrix.of fun u v => MvPolynomial.pderiv u (rel v)
    let dQ_dZ : P_big := MvPolynomial.pderiv (Sum.inr ()) Q_rel
    have hdQ_dZ_eq : dQ_dZ = C_2 * (2 * Z_b) - (2 * A_20 + A_11) := by
      change MvPolynomial.pderiv (Sum.inr ())
        ((ι_aux A₂₀_0 + ι_aux A₁₁_0 + ι_aux A₀₂_0) * Z_b ^ 2 -
          (2 * ι_aux A₂₀_0 + ι_aux A₁₁_0) * Z_b + ι_aux A₂₀_0) = _
      have hZ : MvPolynomial.pderiv (Sum.inr ()) Z_b = 1 := by
        simp [Z_b, MvPolynomial.pderiv_X]
      have hZ2 : MvPolynomial.pderiv (Sum.inr ()) (Z_b ^ 2) = 2 * Z_b := by
        rw [sq, Derivation.leibniz, hZ]
        simp [smul_eq_mul]
        ring
      have hC2 : MvPolynomial.pderiv (Sum.inr ()) (ι_aux A₂₀_0 + ι_aux A₁₁_0 + ι_aux A₀₂_0) = 0 := by
        simp [hpderiv_Z_aux]
      have hLin : MvPolynomial.pderiv (Sum.inr ()) (2 * ι_aux A₂₀_0 + ι_aux A₁₁_0) = 0 := by
        have h2 : (2 : P_big) * ι_aux A₂₀_0 = ι_aux A₂₀_0 + ι_aux A₂₀_0 := two_mul _
        rw [h2]
        simp [hpderiv_Z_aux]
      rw [map_add, map_sub, hpderiv_Z_aux A₂₀_0, add_zero,
        Derivation.leibniz, Derivation.leibniz]
      simp only [smul_eq_mul, hC2, hZ2, hLin, hZ, mul_one]
      dsimp [C_2, A_20, A_11]
      ring
    let δ_big : Q_big := π_big (Z_b * dQ_dZ * J_tot.det)
    let B₄ : Type u := Localization.Away δ_big
    let ι_QB := @algebraMap Q_big B₄ inferInstance inferInstance inferInstance
    let ι_P2B4 := @algebraMap P₂ B₄ inferInstance inferInstance inferInstance
    have hEt_B₄ : Algebra.Etale P₂ B₄ := by
      let P_pre : Algebra.PreSubmersivePresentation P₂ Q_big ι_var ι_var :=
        Algebra.PreSubmersivePresentation.naive (R := P₂) (v := rel) _root_.id Function.injective_id
      let Q_loc := (Algebra.SubmersivePresentation.localizationAway B₄ δ_big).toPreSubmersivePresentation
      let P_comp := Q_loc.comp P_pre
      have hδ_unit : IsUnit (ι_QB δ_big) :=
        IsLocalization.Away.algebraMap_isUnit (S := B₄) δ_big
      have h_jac_eq : P_pre.jacobian = π_big J_tot.det := by
        rw [P_pre.jacobian_eq_jacobiMatrix_det]
        have h_mat : P_pre.jacobiMatrix = J_tot :=
          Matrix.ext fun u v => P_pre.jacobiMatrix_apply u v
        rw [h_mat]
        rfl
      have h_det_unit : IsUnit (ι_QB P_pre.jacobian) := by
        have h_mul : ι_QB (π_big (Z_b * dQ_dZ)) * ι_QB (π_big J_tot.det) = ι_QB δ_big := by
          rw [← map_mul, ← map_mul]
        rw [h_jac_eq]
        exact isUnit_of_mul_isUnit_right (h_mul.symm ▸ hδ_unit)
      have h_comp_unit : IsUnit P_comp.jacobian := by
        rw [Q_loc.comp_jacobian_eq_jacobian_smul_jacobian P_pre, Algebra.smul_def]
        exact IsUnit.mul h_det_unit
          (Algebra.SubmersivePresentation.localizationAway B₄ δ_big).jacobian_isUnit
      let Sub_comp : Algebra.SubmersivePresentation P₂ B₄ (Unit ⊕ ι_var) (Unit ⊕ ι_var) :=
        { P_comp with jacobian_isUnit := h_comp_unit }
      have h_dim : Sub_comp.dimension = 0 := by
        change (Q_loc.comp P_pre).dimension = 0
        rw [Q_loc.dimension_comp_eq_dimension_add_dimension P_pre]
        have h1 : Q_loc.dimension = 0 := by simp [Algebra.Presentation.dimension]
        have h2 : P_pre.dimension = 0 := by simp [Algebra.Presentation.dimension]
        omega
      have : Algebra.IsStandardSmoothOfRelativeDimension 0 P₂ B₄ :=
        Sub_comp.isStandardSmoothOfRelativeDimension h_dim
      infer_instance
    let g₁_poly : P_big := A_20 * X_b ^ 2 + A_11 * X_b * Y_b + A_02 * Y_b ^ 2
    have h_univ_id :
        (Z_b * U₀_b - H₀_rel) * (Z_b * U₁_b - H₁_rel) =
          Z_b ^ 2 * g₁_poly - Q_rel * Y_b ^ 2 := by
      dsimp only [H₀_rel, H₁_rel, Q_rel, C_2, g₁_poly]
      ring
    have h_rel_zero : ∀ v : ι_var, π_big (rel v) = 0 := fun v =>
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨v, rfl⟩)
    have hH₀_zero : π_big H₀_rel = 0 := h_rel_zero (Sum.inl (Sum.inl 0))
    have hH₁_zero : π_big H₁_rel = 0 := h_rel_zero (Sum.inl (Sum.inl 1))
    have hQ_zero : π_big Q_rel = 0 := h_rel_zero (Sum.inr ())
    have h_Qbig_prod :
        (π_big Z_b) ^ 2 * algebraMap P₂ Q_big (U₀ * U₁) = (π_big Z_b) ^ 2 * π_big g₁_poly := by
      have h_app := congrArg π_big h_univ_id
      simp only [map_mul, map_sub, map_pow, hH₀_zero, hH₁_zero, hQ_zero, sub_zero, zero_mul] at h_app
      have h_alg : algebraMap P₂ Q_big (U₀ * U₁) = π_big U₀_b * π_big U₁_b := by
        change π_big (MvPolynomial.C (U₀ * U₁)) = π_big U₀_b * π_big U₁_b
        rw [map_mul, map_mul]
      rw [h_alg]
      linear_combination h_app
    have hZ_unit_B₄ : IsUnit (ι_QB (π_big Z_b)) := by
      have hδ_unit : IsUnit (ι_QB δ_big) :=
        IsLocalization.Away.algebraMap_isUnit (S := B₄) δ_big
      have h_mul : ι_QB (π_big Z_b) * ι_QB (π_big (dQ_dZ * J_tot.det)) = ι_QB δ_big := by
        rw [← map_mul, ← map_mul]
        apply congrArg (ι_QB ∘ π_big)
        ring
      exact isUnit_of_mul_isUnit_left (h_mul.symm ▸ hδ_unit)
    obtain ⟨u_ZB₄, hu_ZB₄⟩ := hZ_unit_B₄
    have h_U0U1_B₄ : ι_P2B4 (U₀ * U₁) = ι_QB (π_big g₁_poly) := by
      apply (Units.mul_right_inj (u_ZB₄ ^ 2)).mp
      have h_alg_eq : ι_P2B4 (U₀ * U₁) = ι_QB (algebraMap P₂ Q_big (U₀ * U₁)) :=
