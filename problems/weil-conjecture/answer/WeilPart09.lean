    (hBC_Rk₀ : IsCommRingProjBaseChange R (IsLocalRing.ResidueField R)
      (IsLocalRing.residue R) M (c_proj R M) (t_proj R M)
      (c_proj (IsLocalRing.ResidueField R) M) (t_proj (IsLocalRing.ResidueField R) M) Φ_Rk₀)
    (hCl_0 : AlgebraicGeometry.IsClosedImmersion ι'_0)
    (hComm_0 : ι'_0 ≫ (weilProjectiveSpaceOver (IsLocalRing.ResidueField R) M).hom =
      CategoryTheory.Limits.pullback.snd p_E
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
    (hPb_0 : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst p_E
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
      ι'_0 ι'_bar Φ_Rk₀)
    (hRedZ₀ : AlgebraicGeometry.IsReduced (CategoryTheory.Limits.pullback p_E
