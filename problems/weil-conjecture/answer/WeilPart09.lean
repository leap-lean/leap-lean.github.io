    have hEt_D4 : Algebra.Etale D D'_4 := by
      let loc1 := (Algebra.SubmersivePresentation.localizationAway D_QZ z_Q).toPreSubmersivePresentation
      let loc2 := (Algebra.SubmersivePresentation.localizationAway D'_4 δ_Z).toPreSubmersivePresentation
      let P_12 := loc1.comp P_DQ
      let P_tot := loc2.comp P_12
      have h_dQdZ_map : α_bar (π_big dQ_dZ) = ι_DQ_DQZ P_DQ.jacobian := by
        change α_big dQ_dZ = _
        rw [hdQ_dZ_eq, hPDQ_jac]
        have h_c_eq : ∀ d : D, ι_DQ_DQZ (π_DQ (MvPolynomial.C d)) = ι_DZ d :=
          fun d => (IsScalarTower.algebraMap_apply D D_Q D_QZ d).symm
        simp only [C_2, A_20, A_11, A_02, map_sub, map_add, map_mul, map_ofNat,
          hα_aux, hA₂₀_0, hA₁₁_0, hA₀₂_0, hα_Z, h_c_eq]
        dsimp [c₂, ζ, z_Q]
        simp only [map_add]
      have h_jac_PDQ_unit : IsUnit (ι_QD4 P_DQ.jacobian) := by
        change IsUnit (algebraMap D_Q D'_4 P_DQ.jacobian)
        rw [IsScalarTower.algebraMap_apply D_Q D_QZ D'_4 P_DQ.jacobian, ← h_dQdZ_map]
        have h_mul : ι_QZD4 (α_bar (π_big dQ_dZ)) *
            ι_QZD4 (α_bar (π_big (Z_b * J_tot.det))) =
            ι_QZD4 δ_Z := by
