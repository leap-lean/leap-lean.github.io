    have : q_N.IsMaximal := RingHom.ker_isMaximal_of_surjective ev_N hev_N_surj
    have : q₄.IsMaximal := RingHom.ker_isMaximal_of_surjective ev₄ hev₄_surj
    let L_N : Type u := Localization.AtPrime q_N
