  have pillar2 : ∀ (K : Type u) [Field K] [Algebra k₀ K]
      (S : Subalgebra k₀ K) (r : ℕ)
      (O_m_K : Fin (r + 1) → Subalgebra k₀ K)
      (t_m_K : ∀ j : Fin (r + 1), ↥(O_m_K j))
      (m_K : Fin (r + 1) → ℕ)
      (y_K : K),
      let W : (Fin (r + 1) → ℕ) → Submodule k₀ K :=
        fun e => S.toSubmodule ⊓
          ⨅ j : Fin (r + 1), (O_m_K j).toSubmodule.comap (LinearMap.mulLeft k₀ ((t_m_K j : K) ^ (e j)))
      (∀ j : Fin (r + 1),
        (t_m_K j : K) ≠ 0 ∧
        Function.Bijective (algebraMap k₀ (↥(O_m_K j) ⧸ Ideal.span {t_m_K j})) ∧
        (∃ u_j : ↥(O_m_K j), IsUnit u_j ∧ y_K = (u_j : K) * (t_m_K j : K) ^ (m_K j)) ∧
        (∀ z : K, ∃ k : ℕ, y_K ^ k * z ∈ O_m_K j)) →
      Module.Finite k₀ ↥(W 0) →
      (W 0 = LinearMap.range (Algebra.linearMap k₀ K) ∧ Module.finrank k₀ ↥(W 0) = 1) ∧
      (∀ e₁ e₂ : Fin (r + 1) → ℕ, e₁ ≤ e₂ →
        W e₁ ≤ W e₂ ∧
        Module.Finite k₀ ↥(W e₂) ∧
        Module.finrank k₀ ↥(W e₂) + ∑ j : Fin (r + 1), e₁ j ≤
          Module.finrank k₀ ↥(W e₁) + ∑ j : Fin (r + 1), e₂ j) ∧
      (∀ (D : ℕ) (z : K),
        (∀ j : Fin (r + 1), y_K ^ D * z ∈ O_m_K j) ↔
          (∀ j : Fin (r + 1), (t_m_K j : K) ^ (D * m_K j) * z ∈ O_m_K j)) ∧
      (∀ z ∈ S, ∃ D : ℕ, 1 ≤ D ∧ z ∈ W (fun j => D * m_K j)) := by
    intro K _ _ S r O_m_K t_m_K m_K y_K W hDVR_K hFin0
    have mem_W : ∀ (e : Fin (r + 1) → ℕ) (z : K),
        z ∈ W e ↔ z ∈ S ∧ ∀ j : Fin (r + 1), (t_m_K j : K) ^ (e j) * z ∈ O_m_K j := by
      intro e z
      simp only [W, Submodule.mem_inf, Submodule.mem_iInf, Submodule.mem_comap,
        LinearMap.mulLeft_apply, Subalgebra.mem_toSubmodule]
    let S₀ : Subalgebra k₀ K :=
      { carrier := (W 0 : Set K)
        mul_mem' := fun {x y} hx hy => by
          rw [SetLike.mem_coe, mem_W] at hx hy
          change x * y ∈ W 0
          rw [mem_W]
          refine ⟨S.mul_mem hx.1 hy.1, fun j => ?_⟩
          have hjx := hx.2 j
          have hjy := hy.2 j
          simp only [Pi.zero_apply, pow_zero, one_mul] at hjx hjy ⊢
          exact (O_m_K j).mul_mem hjx hjy
        one_mem' := by
          change (1 : K) ∈ W 0
          rw [mem_W]
          simp only [Pi.zero_apply, pow_zero, one_mul]
          exact ⟨S.one_mem, fun j => (O_m_K j).one_mem⟩
        add_mem' := fun {x y} hx hy => (W 0).add_mem hx hy
        zero_mem' := (W 0).zero_mem
        algebraMap_mem' := fun a => by
          change algebraMap k₀ K a ∈ W 0
          rw [mem_W]
          simp only [Pi.zero_apply, pow_zero, one_mul]
          exact ⟨S.algebraMap_mem a, fun j => (O_m_K j).algebraMap_mem a⟩ }
    have hS₀_eq : S₀.toSubmodule = W 0 := rfl
    have hFin_S₀ : Module.Finite k₀ ↥S₀ :=
      Module.Finite.equiv (LinearEquiv.ofEq (W 0) S₀.toSubmodule hS₀_eq.symm)
    have hInt_S₀ : Algebra.IsIntegral k₀ ↥S₀ := @Algebra.IsIntegral.of_finite k₀ ↥S₀ _ _ _ hFin_S₀
    have hBij_S₀ : Function.Bijective (algebraMap k₀ ↥S₀) :=
      @IsAlgClosed.algebraMap_bijective_of_isIntegral k₀ ↥S₀ _ _ _ _ _ hInt_S₀
    have hW0_eq : W 0 = LinearMap.range (Algebra.linearMap k₀ K) := by
      rw [← hS₀_eq]
      ext z
      simp only [Subalgebra.mem_toSubmodule, LinearMap.mem_range, Algebra.linearMap_apply]
      constructor
      · intro hz
        obtain ⟨a, ha⟩ := hBij_S₀.2 ⟨z, hz⟩
        exact ⟨a, congrArg Subtype.val ha⟩
      · rintro ⟨a, rfl⟩
        exact S₀.algebraMap_mem a
    have hW0_rank : Module.finrank k₀ ↥(W 0) = 1 := by
      let e₀ : k₀ ≃ₗ[k₀] ↥(W 0) :=
        (LinearEquiv.ofInjective (Algebra.linearMap k₀ K) (algebraMap k₀ K).injective).trans
          (LinearEquiv.ofEq _ _ hW0_eq.symm)
      rw [← e₀.finrank_eq, Module.finrank_self]
    have hW_mono : ∀ e₁ e₂ : Fin (r + 1) → ℕ, e₁ ≤ e₂ → W e₁ ≤ W e₂ := by
      intro e₁ e₂ he z hz
      rw [mem_W] at hz ⊢
      refine ⟨hz.1, fun j => ?_⟩
      have hej : e₂ j = (e₂ j - e₁ j) + e₁ j := (Nat.sub_add_cancel (he j)).symm
      rw [hej, pow_add, mul_assoc]
      exact (O_m_K j).mul_mem ((O_m_K j).pow_mem (t_m_K j).2 _) (hz.2 j)
    have hStepOne : ∀ (e : Fin (r + 1) → ℕ), Module.Finite k₀ ↥(W e) →
        ∀ j₀ : Fin (r + 1),
          let e' := Function.update e j₀ (e j₀ + 1)
          Module.Finite k₀ ↥(W e') ∧ Module.finrank k₀ ↥(W e') ≤ Module.finrank k₀ ↥(W e) + 1 := by
      intro e hFin_e j₀
      letI : Module.Finite k₀ ↥(W e) := hFin_e
      let e' := Function.update e j₀ (e j₀ + 1)
      have he_le : e ≤ e' := by
        intro j
        by_cases hj : j = j₀
        · subst hj; simp [e']
        · simp [e', hj]
      have hz_mem_j₀ : ∀ z : ↥(W e'), (t_m_K j₀ : K) ^ (e j₀ + 1) * z.1 ∈ O_m_K j₀ := by
        intro z
        have h := ((mem_W e' z.1).mp z.2).2 j₀
        simpa [e'] using h
      let g_lin : ↥(W e') →ₗ[k₀] ↥(O_m_K j₀) :=
        { toFun := fun z => ⟨(t_m_K j₀ : K) ^ (e j₀ + 1) * z.1, hz_mem_j₀ z⟩
          map_add' := fun z₁ z₂ => Subtype.ext (mul_add _ z₁.1 z₂.1)
          map_smul' := fun c z => Subtype.ext (mul_smul_comm c ((t_m_K j₀ : K) ^ (e j₀ + 1)) z.1) }
      let Q_res := ↥(O_m_K j₀) ⧸ Ideal.span {t_m_K j₀}
      let lam_lin : ↥(W e') →ₗ[k₀] Q_res :=
        (Ideal.Quotient.mkₐ k₀ (Ideal.span {t_m_K j₀})).toLinearMap.comp g_lin
      let e_res : k₀ ≃ₗ[k₀] Q_res :=
        LinearEquiv.ofBijective (Algebra.linearMap k₀ Q_res) (hDVR_K j₀).2.1
      haveI : Module.Finite k₀ Q_res := Module.Finite.equiv e_res
      have hRank_res : Module.finrank k₀ Q_res = 1 := by
        rw [← e_res.finrank_eq, Module.finrank_self]
      have hRange_le : Module.finrank k₀ ↥(LinearMap.range lam_lin) ≤ 1 := by
        calc Module.finrank k₀ ↥(LinearMap.range lam_lin)
            ≤ Module.finrank k₀ Q_res := Submodule.finrank_le (LinearMap.range lam_lin)
          _ = 1 := hRank_res
      have hKer_eq : LinearMap.ker lam_lin = (W e).comap (W e').subtype := by
        ext z
        have hlam0 : z ∈ LinearMap.ker lam_lin ↔ g_lin z ∈ Ideal.span {t_m_K j₀} := by
          rw [LinearMap.mem_ker]
          change Ideal.Quotient.mk (Ideal.span {t_m_K j₀}) (g_lin z) = 0 ↔ _
          exact Ideal.Quotient.eq_zero_iff_mem
        rw [hlam0, Ideal.mem_span_singleton, Submodule.mem_comap, Submodule.coe_subtype]
        constructor
        · rintro ⟨w, hw⟩
          rw [mem_W]
          refine ⟨((mem_W e' z.1).mp z.2).1, fun j => ?_⟩
          by_cases hj : j = j₀
          · subst hj
            have hwK : (t_m_K j : K) ^ (e j + 1) * z.1 = (t_m_K j : K) * (w : K) :=
              congrArg Subtype.val hw
            rw [pow_succ', mul_assoc] at hwK
            have h_eq : (t_m_K j : K) ^ (e j) * z.1 = (w : K) :=
              mul_left_cancel₀ (hDVR_K j).1 hwK
            rw [h_eq]
            exact w.2
          · have h := ((mem_W e' z.1).mp z.2).2 j
            simpa [e', hj] using h
        · intro hz_e
          have hz_j₀_e := ((mem_W e z.1).mp hz_e).2 j₀
          refine ⟨⟨(t_m_K j₀ : K) ^ (e j₀) * z.1, hz_j₀_e⟩, Subtype.ext ?_⟩
          change (t_m_K j₀ : K) ^ (e j₀ + 1) * z.1 =
            (t_m_K j₀ : K) * ((t_m_K j₀ : K) ^ (e j₀) * z.1)
          rw [pow_succ', mul_assoc]
      let e_ker : ↥(LinearMap.ker lam_lin) ≃ₗ[k₀] ↥(W e) :=
        (LinearEquiv.ofEq _ _ hKer_eq).trans (Submodule.comapSubtypeEquivOfLe (hW_mono e e' he_le))
      haveI : Module.Finite k₀ ↥(LinearMap.ker lam_lin) := Module.Finite.equiv e_ker.symm
      haveI hFin_Qres : Module.Finite k₀ Q_res := Module.Finite.equiv e_res
      haveI : Module.Finite k₀ ↥(LinearMap.range lam_lin) :=
        @FiniteDimensional.finiteDimensional_submodule k₀ Q_res _ _ _ hFin_Qres (LinearMap.range lam_lin)
      haveI : Module.Finite k₀ (↥(W e') ⧸ LinearMap.ker lam_lin) :=
        Module.Finite.equiv (LinearMap.quotKerEquivRange lam_lin).symm
      haveI : Module.Finite k₀ ↥(W e') :=
        Module.Finite.of_submodule_quotient (LinearMap.ker lam_lin)
      have hRN := LinearMap.finrank_range_add_finrank_ker lam_lin
      rw [e_ker.finrank_eq] at hRN
      change Module.Finite k₀ ↥(W e') ∧ Module.finrank k₀ ↥(W e') ≤ Module.finrank k₀ ↥(W e) + 1
      exact ⟨inferInstance, by omega⟩
    have hUpward : ∀ (n : ℕ) (e₁ e₂ : Fin (r + 1) → ℕ),
        e₁ ≤ e₂ → ∑ j : Fin (r + 1), (e₂ j - e₁ j) = n → Module.Finite k₀ ↥(W e₁) →
        Module.Finite k₀ ↥(W e₂) ∧
        Module.finrank k₀ ↥(W e₂) + ∑ j : Fin (r + 1), e₁ j ≤
          Module.finrank k₀ ↥(W e₁) + ∑ j : Fin (r + 1), e₂ j := by
      intro n
      induction n with
      | zero =>
        intro e₁ e₂ he hsum hFin₁
        have heq : e₁ = e₂ := by
          ext j
          have hj0 : e₂ j - e₁ j = 0 :=
            Finset.sum_eq_zero_iff.mp hsum j (Finset.mem_univ j)
          exact le_antisymm (he j) (Nat.sub_eq_zero_iff_le.mp hj0)
        subst heq
        exact ⟨hFin₁, le_rfl⟩
      | succ n ih =>
        intro e₁ e₂ he hsum hFin₁
        obtain ⟨j₀, _, hj₀_ne⟩ :=
          Finset.exists_ne_zero_of_sum_ne_zero (hsum.trans_ne (Nat.succ_ne_zero n))
        have hj₀_lt : e₁ j₀ + 1 ≤ e₂ j₀ := by omega
        let e_mid := Function.update e₁ j₀ (e₁ j₀ + 1)
        have hmid_le : e_mid ≤ e₂ := by
          intro j
          by_cases hj : j = j₀
          · subst hj; simpa [e_mid] using hj₀_lt
          · simpa [e_mid, hj] using he j
        have hsum_mid_e₁ : ∑ j : Fin (r + 1), e_mid j = (∑ j : Fin (r + 1), e₁ j) + 1 := by
          have h1 := (Finset.add_sum_erase Finset.univ e_mid (Finset.mem_univ j₀)).symm
          have h2 := (Finset.add_sum_erase Finset.univ e₁ (Finset.mem_univ j₀)).symm
          have h3 : ∑ j ∈ Finset.univ.erase j₀, e_mid j = ∑ j ∈ Finset.univ.erase j₀, e₁ j := by
            apply Finset.sum_congr rfl
            intro j hj
            simp [e_mid, Finset.ne_of_mem_erase hj]
          have h4 : e_mid j₀ = e₁ j₀ + 1 := Function.update_self j₀ (e₁ j₀ + 1) e₁
          omega
        have hsum_diff : ∑ j : Fin (r + 1), (e₂ j - e_mid j) = n := by
          have h1 := (Finset.add_sum_erase Finset.univ (fun j => e₂ j - e_mid j) (Finset.mem_univ j₀)).symm
          have h2 := (Finset.add_sum_erase Finset.univ (fun j => e₂ j - e₁ j) (Finset.mem_univ j₀)).symm
          have h3 : ∑ j ∈ Finset.univ.erase j₀, (e₂ j - e_mid j) =
              ∑ j ∈ Finset.univ.erase j₀, (e₂ j - e₁ j) := by
            apply Finset.sum_congr rfl
            intro j hj
            simp [e_mid, Finset.ne_of_mem_erase hj]
          have h4 : e_mid j₀ = e₁ j₀ + 1 := Function.update_self j₀ (e₁ j₀ + 1) e₁
          omega
        obtain ⟨hFin_mid, hRank_mid⟩ := hStepOne e₁ hFin₁ j₀
        have hRank_mid' : Module.finrank k₀ ↥(W e_mid) ≤ Module.finrank k₀ ↥(W e₁) + 1 := hRank_mid
        obtain ⟨hFin₂, hRank₂⟩ := ih e_mid e₂ hmid_le hsum_diff hFin_mid
        exact ⟨hFin₂, by omega⟩
    have hUnitEqv : ∀ (D : ℕ) (z : K) (j : Fin (r + 1)),
        y_K ^ D * z ∈ O_m_K j ↔ (t_m_K j : K) ^ (D * m_K j) * z ∈ O_m_K j := by
      intro D z j
      obtain ⟨u_j, ⟨v_j, rfl⟩, hy_eq⟩ := (hDVR_K j).2.2.1
      have hyD : y_K ^ D = (((v_j ^ D : (↥(O_m_K j))ˣ) : ↥(O_m_K j)) : K) *
          (t_m_K j : K) ^ (D * m_K j) := by
        rw [hy_eq, mul_pow, ← pow_mul, mul_comm (m_K j) D]
        rfl
      let w : ↥(O_m_K j) := ↑(v_j ^ D)
      let w_inv : ↥(O_m_K j) := ↑((v_j ^ D)⁻¹)
      have hw_inv : (w_inv : K) * (w : K) = 1 := by
        have h1 : w_inv * w = 1 := Units.inv_mul (v_j ^ D)
        simpa using congrArg (Subtype.val : ↥(O_m_K j) → K) h1
      constructor
      · intro hy_mem
        have hmul := (O_m_K j).mul_mem w_inv.2 hy_mem
        have h_eq : (w_inv : K) * (y_K ^ D * z) = (t_m_K j : K) ^ (D * m_K j) * z := by
          rw [hyD, ← mul_assoc, ← mul_assoc, hw_inv, one_mul]
        rwa [h_eq] at hmul
      · intro ht_mem
        have hmul := (O_m_K j).mul_mem w.2 ht_mem
        have h_eq : (w : K) * ((t_m_K j : K) ^ (D * m_K j) * z) = y_K ^ D * z := by
          rw [hyD, mul_assoc]
        rwa [h_eq] at hmul
    refine ⟨⟨hW0_eq, hW0_rank⟩, ?_, fun D z => forall_congr' (hUnitEqv D z), ?_⟩
    · intro e₁ e₂ he
      obtain ⟨hFin₁, _⟩ := hUpward (∑ j, (e₁ j - 0)) 0 e₁ (fun _ => Nat.zero_le _) rfl hFin0
      obtain ⟨hFin₂, hIneq⟩ := hUpward (∑ j, (e₂ j - e₁ j)) e₁ e₂ he rfl hFin₁
      exact ⟨hW_mono e₁ e₂ he, hFin₂, hIneq⟩
    · intro z hzS
      choose k_j hk_j using fun j => (hDVR_K j).2.2.2 z
      let D := max 1 (Finset.univ.sup k_j)
      refine ⟨D, le_max_left _ _, ?_⟩
      rw [mem_W]
      refine ⟨hzS, fun j => (hUnitEqv D z j).mp ?_⟩
      obtain ⟨u_j, _, hy_eq⟩ := (hDVR_K j).2.2.1
      have hy_mem : y_K ∈ O_m_K j := by
        rw [hy_eq]
        exact (O_m_K j).mul_mem u_j.2 ((O_m_K j).pow_mem (t_m_K j).2 _)
      have hkj_le : k_j j ≤ D := (Finset.le_sup (Finset.mem_univ j)).trans (le_max_right _ _)
      have hD_split : D = (D - k_j j) + k_j j := (Nat.sub_add_cancel hkj_le).symm
      rw [hD_split, pow_add, mul_assoc]
      exact (O_m_K j).mul_mem ((O_m_K j).pow_mem hy_mem _) (hk_j j)

  
  have pillar3 : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k₀ A]
      (r : ℕ)
      (O_m_A : Fin (r + 1) → Subalgebra k₀ (FractionRing A))
      (t_m_A : ∀ j : Fin (r + 1), ↥(O_m_A j))
      (m_A : Fin (r + 1) → ℕ),
      let K := FractionRing A
      let W_A : (Fin (r + 1) → ℕ) → Submodule k₀ A :=
        fun e => ⨅ j : Fin (r + 1),
          (O_m_A j).toSubmodule.comap
            ((LinearMap.mulLeft k₀ ((t_m_A j : K) ^ (e j))).comp
              (IsScalarTower.toAlgHom k₀ A K).toLinearMap)
      (∀ c : A, (∀ j : Fin (r + 1), algebraMap A K c ∈ O_m_A j) → ∃ a : k₀, c = algebraMap k₀ A a) →
      (∀ e : Fin (r + 1) → ℕ,
        Module.Finite k₀ ↥(W_A e) ∧ Module.finrank k₀ ↥(W_A e) ≤ (∑ j : Fin (r + 1), e j) + 1) →
      2 ≤ Module.finrank k₀ ↥(W_A (Pi.single 0 1)) →
      (∀ z : A, ∃ N : ℕ, 1 ≤ N ∧ z ∈ W_A (fun j => N * m_A j)) →
      ∃ c_u : A,
        let u := algebraMap A K c_u
        u ∉ O_m_A 0 ∧
        (t_m_A 0 : K) * u ∈ O_m_A 0 ∧
        (∀ j : Fin (r + 1), j ≠ 0 → u ∈ O_m_A j) ∧
        (∀ P : Polynomial k₀, Polynomial.aeval c_u P = 0 → P = 0) ∧
        (∀ z : A, ∃ P Q : Polynomial k₀, Q ≠ 0 ∧ z * Polynomial.aeval c_u Q = Polynomial.aeval c_u P) := by
    intro A _ _ _ r O_m_A t_m_A m_A K W_A hConstA hFinUpper hPoleLower hExhaust
    have mem_WA : ∀ (e : Fin (r + 1) → ℕ) (x : A),
        x ∈ W_A e ↔ ∀ j : Fin (r + 1), (t_m_A j : K) ^ (e j) * algebraMap A K x ∈ O_m_A j := by
      intro e x
      simp only [W_A, Submodule.mem_iInf, Submodule.mem_comap, LinearMap.coe_comp,
        Function.comp_apply, LinearMap.mulLeft_apply, Subalgebra.mem_toSubmodule,
        AlgHom.toLinearMap_apply, IsScalarTower.toAlgHom_apply]
    have hWA0_eq : W_A 0 = LinearMap.range (Algebra.linearMap k₀ A) := by
      ext c
      rw [mem_WA]
      simp only [Pi.zero_apply, pow_zero, one_mul, LinearMap.mem_range, Algebra.linearMap_apply]
      constructor
      · intro hc
        obtain ⟨a, rfl⟩ := hConstA c hc
        exact ⟨a, rfl⟩
      · rintro ⟨a, rfl⟩ j
        rw [← IsScalarTower.algebraMap_apply k₀ A K a]
        exact (O_m_A j).algebraMap_mem a
    have hWA0_rank : Module.finrank k₀ ↥(W_A 0) = 1 := by
      let e₀ : k₀ ≃ₗ[k₀] ↥(W_A 0) :=
        (LinearEquiv.ofInjective (Algebra.linearMap k₀ A) (algebraMap k₀ A).injective).trans
          (LinearEquiv.ofEq _ _ hWA0_eq.symm)
      rw [← e₀.finrank_eq, Module.finrank_self]
    have hNotLe : ¬ W_A (Pi.single 0 1) ≤ W_A 0 := by
      intro hle
      letI : Module.Finite k₀ ↥(W_A 0) := (hFinUpper 0).1
      have hmono := Submodule.finrank_mono hle
      omega
    obtain ⟨c_u, hcu_in, hcu_not0⟩ := SetLike.not_le_iff_exists.mp hNotLe
    let u : K := algebraMap A K c_u
    have hu_pole0 : (t_m_A 0 : K) * u ∈ O_m_A 0 := by
      have h := ((mem_WA (Pi.single 0 1) c_u).mp hcu_in) 0
      simpa [u] using h
    have hu_reg : ∀ j : Fin (r + 1), j ≠ 0 → u ∈ O_m_A j := by
      intro j hj
      have h := ((mem_WA (Pi.single 0 1) c_u).mp hcu_in) j
      simpa [u, Pi.single_eq_of_ne hj] using h
    have hu_not0 : u ∉ O_m_A 0 := by
      intro hu0
      apply hcu_not0
      rw [mem_WA]
      intro j
      simp only [Pi.zero_apply, pow_zero, one_mul]
      by_cases hj : j = 0
      · subst hj; exact hu0
      · exact hu_reg j hj
    have hTrans_deg : ∀ (n : ℕ) (P : Polynomial k₀),
        P.natDegree = n → Polynomial.aeval c_u P = 0 → P = 0 := by
      intro n
      induction n with
      | zero =>
        intro P hdeg hEv
        rw [Polynomial.eq_C_of_natDegree_eq_zero hdeg] at hEv ⊢
        rw [Polynomial.aeval_C] at hEv
        have hc0 : P.coeff 0 = 0 := (algebraMap k₀ A).injective (hEv.trans (map_zero _).symm)
        rw [hc0, map_zero]
      | succ n ih =>
        intro P hdeg hEv
        have hP_ne : P ≠ 0 := by
          intro h0
          rw [h0, Polynomial.natDegree_zero] at hdeg
          exact Nat.succ_ne_zero n hdeg.symm
        have hDeg_ne0 : P.degree ≠ 0 := by
          rw [Polynomial.degree_eq_natDegree hP_ne, hdeg]
          exact Nat.cast_ne_zero.mpr (Nat.succ_ne_zero n)
        obtain ⟨a, ha_root⟩ := IsAlgClosed.exists_root P hDeg_ne0
        obtain ⟨R₁, hP_fac⟩ := Polynomial.dvd_iff_isRoot.mpr ha_root
        have hR₁_ne : R₁ ≠ 0 := by
          intro h0
          rw [h0, mul_zero] at hP_fac
          exact hP_ne hP_fac
        have hR₁_deg : R₁.natDegree = n := by
          have h1 := congrArg Polynomial.natDegree hP_fac
          rw [hdeg, Polynomial.natDegree_mul (Polynomial.X_sub_C_ne_zero a) hR₁_ne,
            Polynomial.natDegree_X_sub_C] at h1
          omega
        rw [hP_fac, map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C] at hEv
        rcases mul_eq_zero.mp hEv with hcu_eq | hR₁_ev
        · exfalso
          apply hcu_not0
          rw [sub_eq_zero.mp hcu_eq, hWA0_eq]
          exact ⟨a, rfl⟩
        · exact False.elim (hR₁_ne (ih R₁ hR₁_deg hR₁_ev))
    have hTrans : ∀ P : Polynomial k₀, Polynomial.aeval c_u P = 0 → P = 0 :=
      fun P hEv => hTrans_deg P.natDegree P rfl hEv
    have hWA_mul : ∀ (e₁ e₂ : Fin (r + 1) → ℕ) {x₁ x₂ : A},
        x₁ ∈ W_A e₁ → x₂ ∈ W_A e₂ → x₁ * x₂ ∈ W_A (e₁ + e₂) := by
      intro e₁ e₂ x₁ x₂ hx₁ hx₂
      rw [mem_WA] at hx₁ hx₂ ⊢
      intro j
