        rw [← hΨ_Z, ← map_mul, Units.inv_mul, map_one]
      have hΨ_δ : Ψ₄ (↑u_δB) = ↑u_δD := by
        have huB_val : (↑u_δB : B₄) = ι_QB δ_big := hu_δB
        have huD_val : (↑u_δD : D'_4) = ι_QZD4 δ_Z := hu_δD
        rw [huB_val, huD_val, hΨ₄_eq]
      have hΨ_δ_inv : Ψ₄ (↑u_δB⁻¹) * ↑u_δD = 1 := by
        rw [← hΨ_δ, ← map_mul, Units.inv_mul, map_one]
      apply (Units.mul_left_inj (u_δD ^ m)).mp
      apply (Units.mul_left_inj (ζ_D4 ^ n)).mp
      calc
        Ψ₄ (ι_QB q₀ * (↑u_ZB₄⁻¹) ^ n * (↑u_δB⁻¹) ^ m) * ↑(u_δD ^ m) * ↑(ζ_D4 ^ n)
          = Ψ₄ (ι_QB q₀) *
              (Ψ₄ (↑u_ZB₄⁻¹) * ↑ζ_D4) ^ n * (Ψ₄ (↑u_δB⁻¹) * ↑u_δD) ^ m := by
                simp only [map_mul, map_pow, Units.val_pow_eq_pow_val]
                ring
