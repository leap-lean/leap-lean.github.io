      have hMap2 : Ideal.map τ₂.toRingHom (I₀ ^ 2) ≤ p ^ 2 := by
        rw [Ideal.map_pow]
        exact pow_le_pow_left' (Ideal.map_le_iff_le_comap.mpr (le_of_eq hI₀_eq)) 2
      have hMap1 : Ideal.map τ₁.toRingHom (p ^ 2) ≤ I₀ ^ 2 := by
        rw [Ideal.map_pow]
        refine pow_le_pow_left' (Ideal.map_le_iff_le_comap.mpr ?_) 2
        intro F hF
