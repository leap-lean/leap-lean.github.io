        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [h0, map_zero]
    have hLN_inter : Ideal.span {x₀_loc} ⊓ Ideal.span {x₁_loc} = (⊥ : Ideal L_N) := by
      rw [eq_bot_iff]
      intro z ⟨hz0, hz1⟩
      obtain ⟨w₀, hw₀⟩ := Ideal.mem_span_singleton.mp hz0
      obtain ⟨w₁, hw₁⟩ := Ideal.mem_span_singleton.mp hz1
      obtain ⟨⟨a₀, s₀⟩, ha₀_eq⟩ := IsLocalization.surj q_N.primeCompl w₀
      obtain ⟨⟨a₁, s₁⟩, ha₁_eq⟩ := IsLocalization.surj q_N.primeCompl w₁
      dsimp only at ha₀_eq ha₁_eq
      have h_eq_L : algebraMap N L_N (s₁.1 * a₀ * x0_bar) = algebraMap N L_N (s₀.1 * a₁ * x1_bar) := by
