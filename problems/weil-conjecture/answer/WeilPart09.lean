    have hJetEquiv : ∀ {A B : Type u} [CommRing A] [Algebra Ω A] [CommRing B] [Algebra Ω B]
        [Algebra A B] [IsScalarTower Ω A B] [Algebra.FormallyEtale A B]
        (p_A : Ideal A) (p_B : Ideal B)
        (_ : Function.Bijective (algebraMap Ω (A ⧸ p_A)))
        (_ : Function.Bijective (algebraMap Ω (B ⧸ p_B))),
        Ideal.map (algebraMap A B) p_A ≤ p_B →
        ∀ k : ℕ, 1 ≤ k →
          ∃ E : (A ⧸ p_A ^ k) ≃ₐ[Ω] (B ⧸ p_B ^ k),
            Ideal.map E.toRingHom (Ideal.map (Ideal.Quotient.mk (p_A ^ k)) p_A) =
              Ideal.map (Ideal.Quotient.mk (p_B ^ k)) p_B := by
      intro A B _ _ _ _ _ _ _ p_A p_B hBijA hBijB hMapAB k _
      let ψ : A →ₐ[Ω] B := IsScalarTower.toAlgHom Ω A B
      let Q_A := A ⧸ p_A ^ k
      let Q_B := B ⧸ p_B ^ k
      let mk_Ak : A →+* Q_A := Ideal.Quotient.mk (p_A ^ k)
      let mk_Bk : B →+* Q_B := Ideal.Quotient.mk (p_B ^ k)
      let I_A : Ideal Q_A := Ideal.map mk_Ak p_A
      let I_B : Ideal Q_B := Ideal.map mk_Bk p_B
      have hMapPow : p_A ^ k ≤ Ideal.comap ψ.toRingHom (p_B ^ k) := by
        rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
        exact pow_le_pow_left' hMapAB k
      let ψ_k : Q_A →ₐ[Ω] Q_B :=
        Ideal.Quotient.liftₐ (p_A ^ k) ((Ideal.Quotient.mkₐ Ω (p_B ^ k)).comp ψ)
          (fun a ha => Ideal.Quotient.eq_zero_iff_mem.mpr (hMapPow ha))
      have hIA_pow : I_A ^ k = ⊥ := by
        rw [← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker]
        intro x hx
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hx
      have hIB_pow : I_B ^ k = ⊥ := by
        rw [← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker]
        intro x hx
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hx
      have hNil_IA : IsNilpotent I_A := ⟨k, by rw [Submodule.zero_eq_bot]; exact hIA_pow⟩
      have hNil_IB : IsNilpotent I_B := ⟨k, by rw [Submodule.zero_eq_bot]; exact hIB_pow⟩
      let eB : Ω ≃+* (B ⧸ p_B) := RingEquiv.ofBijective (algebraMap Ω (B ⧸ p_B)) hBijB
      let eΩ_B : (B ⧸ p_B) ≃+* Ω := eB.symm
      have heΩ_B_alg : ∀ c : Ω, eΩ_B (algebraMap Ω (B ⧸ p_B) c) = c := eB.left_inv
      let g₀_ring : B →+* (Q_A ⧸ I_A) :=
        (algebraMap Ω (Q_A ⧸ I_A)).comp (eΩ_B.toRingHom.comp (Ideal.Quotient.mk p_B))
      have hg₀_comm : ∀ a : A, g₀_ring (algebraMap A B a) = algebraMap A (Q_A ⧸ I_A) a := by
        intro a
        obtain ⟨c, hc⟩ := hBijA.2 (Ideal.Quotient.mk p_A a)
        have ha_sub : a - algebraMap Ω A c ∈ p_A :=
          Ideal.Quotient.eq.mp hc.symm
        have hb_sub : ψ a - algebraMap Ω B c ∈ p_B := by
          have h1 : algebraMap A B (a - algebraMap Ω A c) ∈ Ideal.map (algebraMap A B) p_A :=
            Ideal.mem_map_of_mem (algebraMap A B) ha_sub
          have h2 := hMapAB h1
          rwa [map_sub, ← IsScalarTower.algebraMap_apply Ω A B c] at h2
        have hmkB : Ideal.Quotient.mk p_B (ψ a) = algebraMap Ω (B ⧸ p_B) c :=
          Ideal.Quotient.eq.mpr hb_sub
        have hLHS : g₀_ring (algebraMap A B a) = algebraMap Ω (Q_A ⧸ I_A) c := by
          change algebraMap Ω (Q_A ⧸ I_A) (eΩ_B (Ideal.Quotient.mk p_B (ψ a))) = _
          rw [hmkB, heΩ_B_alg]
        have hRHS : algebraMap A (Q_A ⧸ I_A) a = algebraMap Ω (Q_A ⧸ I_A) c := by
          change Ideal.Quotient.mk I_A (mk_Ak a) = Ideal.Quotient.mk I_A (mk_Ak (algebraMap Ω A c))
          rw [Ideal.Quotient.eq, ← map_sub]
          exact Ideal.mem_map_of_mem mk_Ak ha_sub
        exact hLHS.trans hRHS.symm
      let g₀ : B →ₐ[A] (Q_A ⧸ I_A) :=
        { toRingHom := g₀_ring
          commutes' := hg₀_comm }
      let g_tilde : B →ₐ[A] Q_A := Algebra.FormallySmooth.lift I_A hNil_IA g₀
      have hg_tilde_pB : ∀ b ∈ p_B, g_tilde b ∈ I_A := by
        intro b hb
        rw [← Ideal.Quotient.eq_zero_iff_mem, Algebra.FormallySmooth.mk_lift]
        change algebraMap Ω (Q_A ⧸ I_A) (eΩ_B (Ideal.Quotient.mk p_B b)) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hb, map_zero, map_zero]
      have hg_tilde_pow : p_B ^ k ≤ RingHom.ker g_tilde.toRingHom := by
        rw [← Ideal.map_eq_bot_iff_le_ker, Ideal.map_pow]
        have hSub : Ideal.map g_tilde.toRingHom p_B ≤ I_A :=
          Ideal.map_le_iff_le_comap.mpr hg_tilde_pB
        have hPowSub : Ideal.map g_tilde.toRingHom p_B ^ k ≤ I_A ^ k :=
          pow_le_pow_left' hSub k
        exact le_bot_iff.mp (hPowSub.trans (le_of_eq hIA_pow))
      let g_k : Q_B →ₐ[Ω] Q_A :=
        Ideal.Quotient.liftₐ (p_B ^ k) (g_tilde.restrictScalars Ω) hg_tilde_pow
      have hLeftInv : ∀ x : Q_A, g_k (ψ_k x) = x := by
        intro x
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact g_tilde.commutes a
      have hRightInv : ∀ y : Q_B, ψ_k (g_k y) = y := by
        let η₁ : B →ₐ[A] Q_B := Ideal.Quotient.mkₐ A (p_B ^ k)
        let η₂ : B →ₐ[A] Q_B :=
          { toRingHom := ψ_k.toRingHom.comp g_tilde.toRingHom
            commutes' := fun a => by
              change ψ_k (g_tilde (algebraMap A B a)) = Ideal.Quotient.mk (p_B ^ k) (ψ a)
              rw [g_tilde.commutes a]
              rfl }
        let f_quot : Q_B →+* (Q_B ⧸ I_B) := Ideal.Quotient.mk I_B
        have hKerNil : IsNilpotent (RingHom.ker f_quot) := by
          have hkeq : RingHom.ker f_quot = I_B := Ideal.mk_ker
          rwa [hkeq]
        have hEqMod : ∀ b : B, f_quot (η₁ b) = f_quot (η₂ b) := by
          intro b
          obtain ⟨c, hc⟩ := hBijB.2 (Ideal.Quotient.mk p_B b)
          have hb_mem : b - algebraMap Ω B c ∈ p_B := Ideal.Quotient.eq.mp hc.symm
          have h1 : f_quot (η₁ (b - algebraMap Ω B c)) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem mk_Bk hb_mem)
          have h2 : f_quot (η₂ (b - algebraMap Ω B c)) = 0 := by
            apply Ideal.Quotient.eq_zero_iff_mem.mpr
            have hgt : g_tilde (b - algebraMap Ω B c) ∈ I_A := hg_tilde_pB _ hb_mem
            have hψ_IA : Ideal.map ψ_k.toRingHom I_A ≤ I_B := by
              rw [Ideal.map_map]
              have hcomp : ψ_k.toRingHom.comp mk_Ak = mk_Bk.comp (algebraMap A B) := by ext; rfl
              rw [hcomp, ← Ideal.map_map]
              exact Ideal.map_mono hMapAB
            exact hψ_IA (Ideal.mem_map_of_mem ψ_k.toRingHom hgt)
          have hc_eq : η₁ (algebraMap Ω B c) = η₂ (algebraMap Ω B c) := by
            have hAlg : algebraMap Ω B c = algebraMap A B (algebraMap Ω A c) :=
              IsScalarTower.algebraMap_apply Ω A B c
            rw [hAlg, η₁.commutes, η₂.commutes]
          have hb_decomp : b = (b - algebraMap Ω B c) + algebraMap Ω B c := by ring
          rw [hb_decomp, map_add, map_add, map_add, map_add, h1, h2, hc_eq]
        have hη_eq : η₁ = η₂ := Algebra.FormallyUnramified.ext' f_quot hKerNil η₁ η₂ hEqMod
        intro y
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
        exact (AlgHom.congr_fun hη_eq b).symm
      let E : Q_A ≃ₐ[Ω] Q_B := AlgEquiv.ofAlgHom ψ_k g_k
        (AlgHom.ext hRightInv) (AlgHom.ext hLeftInv)
      refine ⟨E, le_antisymm ?_ ?_⟩
      · rw [Ideal.map_map]
        have hcomp : E.toRingHom.comp mk_Ak = mk_Bk.comp (algebraMap A B) := by ext; rfl
        rw [hcomp, ← Ideal.map_map]
        exact Ideal.map_mono hMapAB
      · intro y hy
        have hgk_IB : Ideal.map g_k.toRingHom I_B ≤ I_A := by
          rw [Ideal.map_map]
          have hcomp : g_k.toRingHom.comp mk_Bk = g_tilde.toRingHom := by ext; rfl
          rw [hcomp]
          exact Ideal.map_le_iff_le_comap.mpr hg_tilde_pB
        have hmem : g_k y ∈ I_A := hgk_IB (Ideal.mem_map_of_mem g_k.toRingHom hy)
        have hEy : E (g_k y) = y := hRightInv y
        rw [← hEy]
        exact Ideal.mem_map_of_mem E.toRingHom hmem
    refine ⟨⟨hMax_Mp, hBij_Mp⟩, fun k hk => ?_⟩
    haveI : Algebra.FormallyEtale D L :=
      Algebra.FormallyEtale.of_isLocalization q.asIdeal.primeCompl
    have hMap_DL : Ideal.map (algebraMap D L) q.asIdeal ≤ 𝔪 :=
      le_of_eq Localization.AtPrime.map_eq_maximalIdeal
    obtain ⟨E_DL, hE_DL⟩ := hJetEquiv (A := D) (B := L) q.asIdeal 𝔪 hBij_Dq hBij_Lm hMap_DL k hk
    have hMap_DS : Ideal.map (algebraMap D S) q.asIdeal ≤ q_S.asIdeal := by
      rw [Ideal.map_le_iff_le_comap]
      exact le_of_eq hq_eq.symm
    obtain ⟨E_DS, hE_DS⟩ := hJetEquiv (A := D) (B := S) q.asIdeal q_S.asIdeal hBij_Dq hBij_Sq hMap_DS k hk
    have hMap_MS : Ideal.map (algebraMap M S) p_M.asIdeal ≤ q_S.asIdeal := by
      rw [Ideal.map_le_iff_le_comap]
      exact le_rfl
    obtain ⟨E_MS, hE_MS⟩ := hJetEquiv (A := M) (B := S) p_M.asIdeal q_S.asIdeal hBij_Mp hBij_Sq hMap_MS k hk
    let Θ : (M ⧸ p_M.asIdeal ^ k) ≃ₐ[Ω] (L ⧸ 𝔪 ^ k) :=
      E_MS.trans (E_DS.symm.trans E_DL)
    refine ⟨Θ, ?_⟩
    have hSymm_DS : Ideal.map E_DS.symm.toRingHom
        (Ideal.map (Ideal.Quotient.mk (q_S.asIdeal ^ k)) q_S.asIdeal) =
        Ideal.map (Ideal.Quotient.mk (q.asIdeal ^ k)) q.asIdeal := by
      rw [← hE_DS, Ideal.map_map]
      have hId : E_DS.symm.toRingHom.comp E_DS.toRingHom = RingHom.id _ := by
        ext x; exact E_DS.symm_apply_apply x
      rw [hId, Ideal.map_id]
    change Ideal.map (E_DL.toRingHom.comp (E_DS.symm.toRingHom.comp E_MS.toRingHom)) _ = _
    rw [← Ideal.map_map, ← Ideal.map_map, hE_MS, hSymm_DS, hE_DL]

  
  have hS3 : ∀ (L : Type u) [CommRing L] [IsLocalRing L] [IsNoetherianRing L] [Algebra Ω L],
      let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
      (∀ (p : Ideal (MvPolynomial (Fin 1) Ω)),
        p.IsMaximal →
        Function.Bijective (algebraMap Ω (MvPolynomial (Fin 1) Ω ⧸ p)) →
