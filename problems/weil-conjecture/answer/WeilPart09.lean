          rw [hres_LN_ι]
        | add P₁ P₂ ih₁ ih₂ =>
          simp only [map_add] at ih₁ ih₂ ⊢
          rw [ih₁, ih₂]
        | mul_X P' i _ =>
          have hXi_RN : algebraMap R_node L_N (Ideal.Quotient.mk I_node (MvPolynomial.X i)) =
              if i = 0 then x₀_loc else x₁_loc := by
            fin_cases i <;> rfl
          have hXi_KN : algebraMap R_node L_N (Ideal.Quotient.mk I_node (MvPolynomial.X i)) ∈ K_N := by
            rw [hXi_RN]
            fin_cases i
            · exact Ideal.subset_span (by simp)
            · exact Ideal.subset_span (by simp)
          have hXi_mN : res_LN (algebraMap R_node L_N (Ideal.Quotient.mk I_node (MvPolynomial.X i))) = 0 :=
