      have hμ_mem : μ ∈ 𝔪 := by
        rw [← huv_bar_span]
        exact Ideal.mem_span_pair.mpr ⟨lam₂₁, lam₁₂, rfl⟩
      obtain ⟨⟨m₁, s₁⟩, hm₁_eq⟩ := IsLocalization.surj q.asIdeal.primeCompl μ
      obtain ⟨⟨r₃₀, s₂⟩, hr₃₀_eq⟩ := IsLocalization.surj q.asIdeal.primeCompl lam₃₀
      obtain ⟨⟨r₀₃, s₃⟩, hr₀₃_eq⟩ := IsLocalization.surj q.asIdeal.primeCompl lam₀₃
