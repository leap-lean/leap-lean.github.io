      (TopologicalSpace.Opens.map ι'_0.base).obj
        (weilProjBasicOpen (IsLocalRing.ResidueField R) M (Fin.last M)) = ⊤)
    (hNeComp : (irreducibleComponents ↥(CategoryTheory.Limits.pullback p_E
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))).Nonempty)
    (hMeet01 : ∀ Z_comp ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback p_E
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))),
      (Z_comp ∩ (((TopologicalSpace.Opens.map ι'_0.base).obj
          (weilProjBasicOpen (IsLocalRing.ResidueField R) M 0) ⊓
        (TopologicalSpace.Opens.map ι'_0.base).obj
          (weilProjBasicOpen (IsLocalRing.ResidueField R) M (Fin.last M)) :
            (CategoryTheory.Limits.pullback p_E
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).Opens) :
            Set ↥(CategoryTheory.Limits.pullback p_E
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))))).Nonempty)
    (d_E D₀ : ℕ) (hd_E : 1 ≤ d_E) (hD₀ : 1 ≤ D₀)
    (hGenHilb : ∀ D : ℕ, D₀ ≤ D →
      let E_K := CategoryTheory.Limits.pullback p_E
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R)))
      let E_K1 := (TopologicalSpace.Opens.map ι_K.base).obj
        (weilProjBasicOpen K_R M (Fin.last M))
      let B_K1 : Type u := ↑(E_K.presheaf.obj (Opposite.op E_K1))
      letI : Algebra K_R B_K1 :=
        ((ι_K.app (weilProjBasicOpen K_R M (Fin.last M))).hom.comp
          (c_proj K_R M (Fin.last M))).toAlgebra
      let ξ_EK : Fin (M + 1) → B_K1 :=
        fun μ => (ι_K.app (weilProjBasicOpen K_R M (Fin.last M))).hom
