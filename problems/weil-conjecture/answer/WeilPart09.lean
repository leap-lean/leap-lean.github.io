        ext x
        have hTop : x ∈ (𝒰₁ ⊔ 𝒰₂ : (D.obj j₂).Opens) := by rw [hSup_𝒰]; trivial
        have hBot : x ∉ (𝒰₁ ⊓ 𝒰₂ : (D.obj j₂).Opens) := by rw [hInf_𝒰]; exact False.elim
        change x ∈ 𝒰₁ ∨ x ∈ 𝒰₂ at hTop
        change ¬ (x ∈ 𝒰₁ ∧ x ∈ 𝒰₂) at hBot
        change x ∈ 𝒰₁ ↔ x ∉ 𝒰₂
        tauto
      rw [hCompl]
      exact 𝒰₂.isOpen.isClosed_compl
    have hClosed_𝒰₂ : IsClosed (𝒰₂ : Set ↥C_B) := by
      have hCompl : (𝒰₂ : Set ↥C_B) = (𝒰₁ : Set ↥C_B)ᶜ := by
        ext x
        have hTop : x ∈ (𝒰₁ ⊔ 𝒰₂ : (D.obj j₂).Opens) := by rw [hSup_𝒰]; trivial
        have hBot : x ∉ (𝒰₁ ⊓ 𝒰₂ : (D.obj j₂).Opens) := by rw [hInf_𝒰]; exact False.elim
        change x ∈ 𝒰₁ ∨ x ∈ 𝒰₂ at hTop
        change ¬ (x ∈ 𝒰₁ ∧ x ∈ 𝒰₂) at hBot
        change x ∈ 𝒰₂ ↔ x ∉ 𝒰₁
        tauto
      rw [hCompl]
      exact 𝒰₁.isOpen.isClosed_compl
    let pt_B : _root_.PrimeSpectrum B := ⟨⊥, inferInstance⟩
    have hSpec_ι_pt :
        ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_bar)),
          (baseπ j₂).base q = pt_B := by
      intro q
      apply _root_.PrimeSpectrum.ext
      have hq_bot : q.asIdeal = ⊥ :=
        ((Ideal.bot_isMaximal (K := K_bar)).eq_of_le q.isPrime.ne_top bot_le).symm
      change Ideal.comap ι_B q.asIdeal = ⊥
      rw [hq_bot]
      ext b
      change ι_B b = 0 ↔ b = 0
      exact ⟨fun h => Subtype.val_injective h, fun h => by rw [h, map_zero]⟩
    have hImg_univ : ∀ (𝒰 : (D.obj j₂).Opens),
        IsClosed (𝒰 : Set ↥C_B) →
        (∃ z : ↥Y_gen, (π_gen j₂).base z ∈ 𝒰) →
        g_B.base '' (𝒰 : Set ↥C_B) = Set.univ := by
      intro 𝒰 hCl ⟨z, hz⟩
      have hCl_img : IsClosed (g_B.base '' (𝒰 : Set ↥C_B)) :=
        g_B.isClosedMap (𝒰 : Set ↥C_B) hCl
      obtain ⟨T, hT⟩ := (_root_.PrimeSpectrum.isClosed_iff_zeroLocus _).mp hCl_img
      have hpt_mem : pt_B ∈ g_B.base '' (𝒰 : Set ↥C_B) := by
        refine ⟨(π_gen j₂).base z, hz, ?_⟩
        have hcomp : g_B.base ((π_gen j₂).base z) =
            (baseπ j₂).base (p_gen.base z) := by
          change (π_gen j₂ ≫ g_B).base z = (p_gen ≫ baseπ j₂).base z
          exact congrArg (fun m : Y_gen ⟶ AlgebraicGeometry.Spec (CommRingCat.of B) => m.base z)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        rw [hcomp]
        exact hSpec_ι_pt (p_gen.base z)
      rw [hT] at hpt_mem ⊢
      have hSub_bot : T ⊆ (pt_B.asIdeal : Set B) := hpt_mem
      ext q
      exact ⟨fun _ => trivial, fun _ b hb => SetLike.le_def.mp (bot_le : (⊥ : Ideal B) ≤ q.asIdeal) (hSub_bot hb)⟩
    have hImg_𝒰₁ : g_B.base '' (𝒰₁ : Set ↥C_B) = Set.univ := by
      refine hImg_univ 𝒰₁ hClosed_𝒰₁ ⟨z₁, ?_⟩
      change z₁ ∈ (TopologicalSpace.Opens.map (π_gen j₂).base).obj 𝒰₁
      rw [hPre_𝒰₁]
      exact hz₁
    have hImg_𝒰₂ : g_B.base '' (𝒰₂ : Set ↥C_B) = Set.univ := by
      refine hImg_univ 𝒰₂ hClosed_𝒰₂ ⟨z₂, ?_⟩
      change z₂ ∈ (TopologicalSpace.Opens.map (π_gen j₂).base).obj 𝒰₂
      rw [hPre_𝒰₂]
      exact hz₂
    have hFT_B : RingHom.FiniteType ψ :=
      hSubalgFT B_sub (Subalgebra.fg_adjoin_finset S_star)
    refine ⟨B, inferInstance, inferInstance, ψ, ι_B, hFT_B, rfl, Subtype.val_injective, ?_⟩
    intro Ω _ s_B
    let s_A := s_B ≫ f_base j₂
    let Y_Ω := CategoryTheory.Limits.pullback g s_A
    let π_Ω : Y_Ω ⟶ C_B := CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst g s_A)
      (CategoryTheory.Limits.pullback.snd g s_A ≫ s_B)
      (by rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition])
    have hOuter_Ω : CategoryTheory.IsPullback
        (π_Ω ≫ CategoryTheory.Limits.pullback.fst g (f_base j₂))
        (CategoryTheory.Limits.pullback.snd g s_A) g (s_B ≫ f_base j₂) := by
      have hEq1 : π_Ω ≫ CategoryTheory.Limits.pullback.fst g (f_base j₂) =
          CategoryTheory.Limits.pullback.fst g s_A :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [hEq1]
      exact CategoryTheory.IsPullback.of_hasPullback g s_A
    have hPb_Ω : CategoryTheory.IsPullback π_Ω
        (CategoryTheory.Limits.pullback.snd g s_A) g_B s_B :=
      CategoryTheory.IsPullback.of_right hOuter_Ω
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback g (f_base j₂))
    let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := ⟨⊥, inferInstance⟩
    have hb₁ : s_B.base pt_Ω ∈ g_B.base '' (𝒰₁ : Set ↥C_B) := by rw [hImg_𝒰₁]; trivial
    obtain ⟨w₁, hw₁_mem, hw₁_eq⟩ := hb₁
    obtain ⟨y₁, hy₁_π, _⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_Ω w₁ pt_Ω hw₁_eq
    have hb₂ : s_B.base pt_Ω ∈ g_B.base '' (𝒰₂ : Set ↥C_B) := by rw [hImg_𝒰₂]; trivial
    obtain ⟨w₂, hw₂_mem, hw₂_eq⟩ := hb₂
    obtain ⟨y₂, hy₂_π, _⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_Ω w₂ pt_Ω hw₂_eq
    rw [connectedSpace_iff_clopen]
    rintro ⟨_, hConn_Ω⟩
    have hClop_Ω : IsClopen (π_Ω.base ⁻¹' (𝒰₁ : Set ↥C_B)) :=
      ⟨hClosed_𝒰₁.preimage π_Ω.continuous, 𝒰₁.isOpen.preimage π_Ω.continuous⟩
    rcases hConn_Ω (π_Ω.base ⁻¹' (𝒰₁ : Set ↥C_B)) hClop_Ω with hEmpty_Ω | hUniv_Ω
    · have hy₁_in : y₁ ∈ π_Ω.base ⁻¹' (𝒰₁ : Set ↥C_B) := by
        change π_Ω.base y₁ ∈ 𝒰₁
        rw [hy₁_π]
        exact hw₁_mem
      rw [hEmpty_Ω] at hy₁_in
      exact hy₁_in
    · have hy₂_in : y₂ ∈ π_Ω.base ⁻¹' (𝒰₁ : Set ↥C_B) := by
        rw [hUniv_Ω]
        trivial
      change π_Ω.base y₂ ∈ 𝒰₁ at hy₂_in
      rw [hy₂_π] at hy₂_in
      have hBoth : w₂ ∈ (𝒰₁ ⊓ 𝒰₂ : (D.obj j₂).Opens) := ⟨hy₂_in, hw₂_mem⟩
      rw [hInf_𝒰] at hBoth
      exact hBoth

  
  
  
  have hS2 : ∀ (A : Type u) [CommRing A]
      (C : AlgebraicGeometry.Scheme.{u})
      (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
      [AlgebraicGeometry.QuasiCompact g]
      [AlgebraicGeometry.LocallyOfFinitePresentation g],
      ∃ (r : ℕ) (m t : Fin r → ℕ)
        (f : ∀ i : Fin r, Fin (t i) → MvPolynomial (Fin (m i)) A),
        ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (φ : A →+* Ω),
          let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
          let Y_Ω := CategoryTheory.Limits.pullback g s_A
          let p_Ω := CategoryTheory.Limits.pullback.snd g s_A
          (AlgebraicGeometry.IsReduced Y_Ω ↔
            ∀ i : Fin r,
              _root_.IsReduced
                (MvPolynomial (Fin (m i)) Ω ⧸
                  Ideal.span (Set.range (fun ν : Fin (t i) => MvPolynomial.map φ (f i ν))))) ∧
          ((∀ (D : Type u) [CommRing D] [Algebra Ω D]
              (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y_Ω),
              AlgebraicGeometry.IsOpenImmersion j_D →
              j_D ≫ p_Ω = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
              ∀ (q : _root_.PrimeSpectrum D), q.asIdeal.IsMaximal →
                let L := Localization.AtPrime q.asIdeal
                let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
                Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
                  (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
                   Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
                   ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3)) ↔
            (∀ (i : Fin r) (x₀ : Fin (m i) → Ω),
              (∀ ν : Fin (t i),
                MvPolynomial.aeval x₀ (MvPolynomial.map φ (f i ν)) = 0) →
                let I_Ω : Ideal (MvPolynomial (Fin (m i)) Ω) :=
                  Ideal.span (Set.range (fun ν : Fin (t i) => MvPolynomial.map φ (f i ν)))
                let M₀ : Ideal (MvPolynomial (Fin (m i)) Ω) :=
                  RingHom.ker (MvPolynomial.aeval x₀).toRingHom
                Module.finrank Ω (MvPolynomial (Fin (m i)) Ω ⧸ (I_Ω ⊔ M₀ ^ 2)) = 2 ∨
                  (Module.finrank Ω (MvPolynomial (Fin (m i)) Ω ⧸ (I_Ω ⊔ M₀ ^ 2)) = 3 ∧
                   Module.finrank Ω (MvPolynomial (Fin (m i)) Ω ⧸ (I_Ω ⊔ M₀ ^ 3)) = 5 ∧
                   ∃ u v : MvPolynomial (Fin (m i)) Ω,
                     u ∈ M₀ ∧ v ∈ M₀ ∧
                     M₀ ≤ I_Ω ⊔ M₀ ^ 2 ⊔ Ideal.span {u, v} ∧
                     u * v ∈ I_Ω ⊔ M₀ ^ 3))) := by
    clear hSubalgFT hS1 hArtinNodal hSec hn τ n hLFP hProp g C
    clear ‹IsNoetherianRing A› ‹IsDomain A› ‹CommRing A› A
    intro A _ C g hQC hLFP
    classical
    have hCompSpec : CompactSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of A)) :=
      AlgebraicGeometry.Scheme.compactSpace_of_isAffine (AlgebraicGeometry.Spec (CommRingCat.of A))
    have _ : CompactSpace ↥C :=
      @AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace
        C (AlgebraicGeometry.Spec (CommRingCat.of A)) g hQC hCompSpec
    let 𝒰 : C.OpenCover := C.affineCover.finiteSubcover
    let e_fin : 𝒰.I₀ ≃ Fin (Fintype.card 𝒰.I₀) := Fintype.equivFin 𝒰.I₀
    let r : ℕ := Fintype.card 𝒰.I₀
    let e_idx : Fin r ≃ 𝒰.I₀ := e_fin.symm
    let B_cat : Fin r → CommRingCat.{u} :=
      fun i => C.affineOpenCover.X (C.affineCover.idx (e_idx i).1)
    let B_ch : Fin r → Type u := fun i => ↥(B_cat i)
    let j_ch : ∀ i : Fin r, AlgebraicGeometry.Spec (CommRingCat.of (B_ch i)) ⟶ C :=
      fun i => 𝒰.f (e_idx i)
    have hj_ch_open : ∀ i : Fin r, AlgebraicGeometry.IsOpenImmersion (j_ch i) :=
      fun i => 𝒰.map_prop (e_idx i)
    let ψ_ch : ∀ i : Fin r, A →+* B_ch i :=
      fun i => (AlgebraicGeometry.Spec.preimage (j_ch i ≫ g)).hom
    have hψ_spec : ∀ i : Fin r,
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_ch i)) = j_ch i ≫ g :=
      fun i => AlgebraicGeometry.Spec.map_preimage (j_ch i ≫ g)

    have instZarLFP : AlgebraicGeometry.IsZariskiLocalAtSource
        (@AlgebraicGeometry.LocallyOfFinitePresentation :
          CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
      @AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        (@AlgebraicGeometry.LocallyOfFinitePresentation)
        (fun {R S : Type u} [CommRing R] [CommRing S] => RingHom.FinitePresentation)
        inferInstance

    have hPres : ∀ i : Fin r,
        ∃ (m_i t_i : ℕ) (f_i : Fin t_i → MvPolynomial (Fin m_i) A),
          Nonempty
            (@AlgEquiv A (MvPolynomial (Fin m_i) A ⧸ Ideal.span (Set.range f_i)) (B_ch i)
              _ _ _ _ (ψ_ch i).toAlgebra) := by
      intro i
      have hLFP_chart : AlgebraicGeometry.LocallyOfFinitePresentation (j_ch i ≫ g) :=
        @AlgebraicGeometry.IsZariskiLocalAtSource.comp
          (@AlgebraicGeometry.LocallyOfFinitePresentation) instZarLFP
          _ _ _ _ hLFP (j_ch i) (hj_ch_open i)
      rw [← hψ_spec i] at hLFP_chart
      have hFP_hom : RingHom.FinitePresentation (ψ_ch i) :=
        (@AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (@AlgebraicGeometry.LocallyOfFinitePresentation)
          (fun {R S : Type u} [CommRing R] [CommRing S] => RingHom.FinitePresentation)
          AlgebraicGeometry.instHasRingHomPropertyLocallyOfFinitePresentationFinitePresentation
          _ _ (CommRingCat.ofHom (ψ_ch i))).mp hLFP_chart
      letI : Algebra A (B_ch i) := (ψ_ch i).toAlgebra
      have hFP_alg : Algebra.FinitePresentation A (B_ch i) := hFP_hom
      obtain ⟨m_i, I₀, e_quot, hFG⟩ := Algebra.FinitePresentation.iff.mp hFP_alg
      obtain ⟨t_i, f_i, hf_span⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hFG
      have hI_eq : Ideal.span (Set.range f_i) = I₀ := hf_span
      rw [← hI_eq] at e_quot
      exact ⟨m_i, t_i, f_i, ⟨e_quot⟩⟩

    choose m t f h_eB using hPres
    refine ⟨r, m, t, f, ?_⟩

    intro Ω _ _ φ
    let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
    let Y_Ω := CategoryTheory.Limits.pullback g s_A
    let p_Ω := CategoryTheory.Limits.pullback.snd g s_A
    letI : Algebra A Ω := φ.toAlgebra

    let 𝒰_Ω := AlgebraicGeometry.Scheme.Pullback.openCoverOfLeft 𝒰 g s_A
    have hChartData : ∀ i : Fin r,
        letI : Algebra A (B_ch i) := (ψ_ch i).toAlgebra
        let D_i : Type u := TensorProduct A Ω (B_ch i)
        let I_Ω_i : Ideal (MvPolynomial (Fin (m i)) Ω) :=
          Ideal.span (Set.range (fun ν : Fin (t i) => MvPolynomial.map φ (f i ν)))
        ∃ (j_i : AlgebraicGeometry.Spec (CommRingCat.of D_i) ⟶ Y_Ω)
          (e_i : D_i ≃ₐ[Ω] (MvPolynomial (Fin (m i)) Ω ⧸ I_Ω_i)),
          AlgebraicGeometry.IsOpenImmersion j_i ∧
          j_i ≫ p_Ω = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D_i)) ∧
          Set.range j_i.base = Set.range (𝒰_Ω.f (e_idx i)).base := by
      intro i
      letI : Algebra A (B_ch i) := (ψ_ch i).toAlgebra
      let D_i : Type u := TensorProduct A Ω (B_ch i)
      let I_A_i : Ideal (MvPolynomial (Fin (m i)) A) := Ideal.span (Set.range (f i))
      let I_Ω_i : Ideal (MvPolynomial (Fin (m i)) Ω) :=
        Ideal.span (Set.range (fun ν : Fin (t i) => MvPolynomial.map φ (f i ν)))
      let e_B_i : (MvPolynomial (Fin (m i)) A ⧸ I_A_i) ≃ₐ[A] B_ch i := Classical.choice (h_eB i)

      let e_step1 : D_i ≃ₐ[Ω] TensorProduct A Ω (MvPolynomial (Fin (m i)) A ⧸ I_A_i) :=
        Algebra.TensorProduct.congr AlgEquiv.refl e_B_i.symm
      have hMapI : ∀ P ∈ I_A_i, Ideal.Quotient.mk I_Ω_i (MvPolynomial.map φ P) = 0 := by
        intro P hP
        rw [Ideal.Quotient.eq_zero_iff_mem]
        obtain ⟨c, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hP
        simp only [map_sum, map_mul]
        exact Ideal.sum_mem I_Ω_i fun ν _ =>
          Ideal.mul_mem_left I_Ω_i _ (Ideal.subset_span (Set.mem_range_self ν))
      let β_ring : (MvPolynomial (Fin (m i)) A ⧸ I_A_i) →+* (MvPolynomial (Fin (m i)) Ω ⧸ I_Ω_i) :=
        Ideal.Quotient.lift I_A_i ((Ideal.Quotient.mk I_Ω_i).comp (MvPolynomial.map φ)) hMapI
      let β_alg : (MvPolynomial (Fin (m i)) A ⧸ I_A_i) →ₐ[A] (MvPolynomial (Fin (m i)) Ω ⧸ I_Ω_i) :=
        { β_ring with
          commutes' := fun a => by
            change Ideal.Quotient.mk I_Ω_i (MvPolynomial.map φ (MvPolynomial.C a)) =
              Ideal.Quotient.mk I_Ω_i (MvPolynomial.C (φ a))
            rw [MvPolynomial.map_C] }
      let Φ_alg : TensorProduct A Ω (MvPolynomial (Fin (m i)) A ⧸ I_A_i) →ₐ[Ω]
          (MvPolynomial (Fin (m i)) Ω ⧸ I_Ω_i) :=
        Algebra.TensorProduct.lift (Algebra.ofId Ω _) β_alg (fun _ _ => Commute.all _ _)
      let incR : (MvPolynomial (Fin (m i)) A ⧸ I_A_i) →ₐ[A]
          TensorProduct A Ω (MvPolynomial (Fin (m i)) A ⧸ I_A_i) :=
        Algebra.TensorProduct.includeRight
      let η₀ : MvPolynomial (Fin (m i)) Ω →ₐ[Ω]
          TensorProduct A Ω (MvPolynomial (Fin (m i)) A ⧸ I_A_i) :=
        MvPolynomial.aeval (fun ℓ => incR (Ideal.Quotient.mk I_A_i (MvPolynomial.X ℓ)))
      have hη₀_map : ∀ P : MvPolynomial (Fin (m i)) A,
          η₀ (MvPolynomial.map φ P) = incR (Ideal.Quotient.mk I_A_i P) := by
        intro P
        induction P using MvPolynomial.induction_on with
        | C a =>
          rw [MvPolynomial.map_C, MvPolynomial.aeval_C]
          change φ a ⊗ₜ[A] (1 : MvPolynomial (Fin (m i)) A ⧸ I_A_i) =
            1 ⊗ₜ[A] Ideal.Quotient.mk I_A_i (MvPolynomial.C a)
          have ha : φ a = a • (1 : Ω) := ((Algebra.smul_def a (1 : Ω)).trans (mul_one _)).symm
          rw [ha, TensorProduct.smul_tmul]
          congr 1
          rw [← Algebra.algebraMap_eq_smul_one]
          rfl
        | add p q ihp ihq => simp only [map_add, ihp, ihq]
        | mul_X p ℓ ihp =>
          rw [map_mul, MvPolynomial.map_X, map_mul, ihp, MvPolynomial.aeval_X, ← map_mul, ← map_mul]
      have hη₀_IΩ : ∀ P ∈ I_Ω_i, η₀ P = 0 := by
        intro P hP
        obtain ⟨c, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hP
        simp only [map_sum, map_mul]
        refine Finset.sum_eq_zero fun ν _ => ?_
        rw [hη₀_map]
        have hzero : Ideal.Quotient.mk I_A_i (f i ν) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self ν))
        rw [hzero, map_zero]
        exact mul_zero (η₀ (c ν))
      let Ψ_alg : (MvPolynomial (Fin (m i)) Ω ⧸ I_Ω_i) →ₐ[Ω]
          TensorProduct A Ω (MvPolynomial (Fin (m i)) A ⧸ I_A_i) :=
        Ideal.Quotient.liftₐ I_Ω_i η₀ hη₀_IΩ
      have hΦΨ : Φ_alg.comp Ψ_alg = AlgHom.id Ω _ := by
        apply AlgHom.coe_ringHom_injective
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro ω
          change Φ_alg (η₀ (MvPolynomial.C ω)) = Ideal.Quotient.mk I_Ω_i (MvPolynomial.C ω)
          rw [MvPolynomial.aeval_C, Φ_alg.commutes]
          rfl
        · intro ℓ
          change Φ_alg (η₀ (MvPolynomial.X ℓ)) = Ideal.Quotient.mk I_Ω_i (MvPolynomial.X ℓ)
          rw [MvPolynomial.aeval_X]
          change Φ_alg (1 ⊗ₜ[A] Ideal.Quotient.mk I_A_i (MvPolynomial.X ℓ)) = _
          rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          change Ideal.Quotient.mk I_Ω_i (MvPolynomial.map φ (MvPolynomial.X ℓ)) = _
          rw [MvPolynomial.map_X]
      have hΨΦ : Ψ_alg.comp Φ_alg = AlgHom.id Ω _ := by
        apply AlgHom.ext
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul ω q =>
          have htmul : (ω ⊗ₜ[A] q : TensorProduct A Ω (MvPolynomial (Fin (m i)) A ⧸ I_A_i)) =
              ω • (1 ⊗ₜ[A] q) := by
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [AlgHom.comp_apply, AlgHom.id_apply, htmul, map_smul, map_smul]
          congr 1
          obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q
          rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          exact hη₀_map P
        | add u v ihu ihv => simp only [map_add, ihu, ihv]
      let e_i : D_i ≃ₐ[Ω] (MvPolynomial (Fin (m i)) Ω ⧸ I_Ω_i) :=
        e_step1.trans (AlgEquiv.ofAlgHom Φ_alg Ψ_alg hΦΨ hΨΦ)

      let e_comm : TensorProduct A (B_ch i) Ω ≃+* D_i :=
        (Algebra.TensorProduct.comm A (B_ch i) Ω).toRingEquiv
      let iso_comm : AlgebraicGeometry.Spec (CommRingCat.of D_i) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct A (B_ch i) Ω)) :=
        { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_comm.toRingHom)
          inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_comm.symm.toRingHom)
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have hid : e_comm.toRingHom.comp e_comm.symm.toRingHom = RingHom.id _ :=
              RingHom.ext e_comm.apply_symm_apply
            rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have hid : e_comm.symm.toRingHom.comp e_comm.toRingHom = RingHom.id _ :=
              RingHom.ext e_comm.symm_apply_apply
            rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
      let iso_pbSpec : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct A (B_ch i) Ω)) ≅
          CategoryTheory.Limits.pullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (B_ch i))))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A Ω))) :=
        (AlgebraicGeometry.pullbackSpecIso A (B_ch i) Ω).symm
      let iso_congr : CategoryTheory.Limits.pullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (B_ch i))))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A Ω))) ≅
          CategoryTheory.Limits.pullback (j_ch i ≫ g) s_A :=
        CategoryTheory.Limits.pullback.congrHom (hψ_spec i) rfl
      let j_pb : CategoryTheory.Limits.pullback (j_ch i ≫ g) s_A ⟶ Y_Ω := 𝒰_Ω.f (e_idx i)
      have hj_pb_open : AlgebraicGeometry.IsOpenImmersion j_pb := 𝒰_Ω.map_prop (e_idx i)
      let iso_src_pb : AlgebraicGeometry.Spec (CommRingCat.of D_i) ≅
          CategoryTheory.Limits.pullback (j_ch i ≫ g) s_A :=
        iso_comm ≪≫ iso_pbSpec ≪≫ iso_congr
      let j_i : AlgebraicGeometry.Spec (CommRingCat.of D_i) ⟶ Y_Ω :=
        iso_src_pb.hom ≫ j_pb
      have hj_i_open : AlgebraicGeometry.IsOpenImmersion j_i := by
        have _ : AlgebraicGeometry.IsOpenImmersion iso_src_pb.hom := inferInstance
        exact CategoryTheory.MorphismProperty.comp_mem _ iso_src_pb.hom j_pb
          inferInstance hj_pb_open
      have hj_i_comm : j_i ≫ p_Ω = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D_i)) := by
        have h_open_f : j_pb ≫ p_Ω =
            CategoryTheory.Limits.pullback.snd (j_ch i ≫ g) s_A := by
          refine (congrArg (fun m => m ≫ p_Ω)
            (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeft_f 𝒰 g s_A (e_idx i))).trans ?_
          change CategoryTheory.Limits.pullback.map (j_ch i ≫ g) s_A g s_A (j_ch i)
              (𝟙 _) (𝟙 _) _ _ ≫ p_Ω = _
          rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
        have h_congr_snd : iso_congr.hom ≫ CategoryTheory.Limits.pullback.snd (j_ch i ≫ g) s_A =
            CategoryTheory.Limits.pullback.snd
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (B_ch i))))
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A Ω))) := by
          change (CategoryTheory.Limits.pullback.congrHom (hψ_spec i) rfl).hom ≫ _ = _
          rw [CategoryTheory.Limits.pullback.congrHom_hom,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
        have h_comp_alg : e_comm.toRingHom.comp
            (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A (B_ch i) Ω).toRingHom =
            algebraMap Ω D_i := by
          apply RingHom.ext
          intro ω
          exact Algebra.TensorProduct.comm_tmul A (1 : B_ch i) ω
        have h1 : j_i ≫ p_Ω =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_comm.toRingHom) ≫
              (AlgebraicGeometry.pullbackSpecIso A (B_ch i) Ω).inv ≫
                iso_congr.hom ≫ j_pb ≫ p_Ω := by
          dsimp only [j_i, iso_src_pb, Iso.trans_hom, iso_pbSpec, Iso.symm_hom, iso_comm]
          simp only [CategoryTheory.Category.assoc]
        rw [h1, h_open_f, h_congr_snd,
          AlgebraicGeometry.pullbackSpecIso_inv_snd A (B_ch i) Ω,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        exact congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) h_comp_alg
      have hj_i_range : Set.range j_i.base = Set.range (𝒰_Ω.f (e_idx i)).base := by
        change Set.range (iso_src_pb.hom ≫ j_pb).base = Set.range j_pb.base
        ext y
        constructor
        · rintro ⟨x, rfl⟩
          exact ⟨iso_src_pb.hom.base x, rfl⟩
        · rintro ⟨w, rfl⟩
          refine ⟨iso_src_pb.inv.base w, ?_⟩
          change ((iso_src_pb.inv ≫ iso_src_pb.hom) ≫ j_pb).base w = _
          rw [iso_src_pb.inv_hom_id, CategoryTheory.Category.id_comp]
      exact ⟨j_i, e_i, hj_i_open, hj_i_comm, hj_i_range⟩

    let _ : ∀ i : Fin r, Algebra A (B_ch i) := fun i => (ψ_ch i).toAlgebra
    let D_ch : Fin r → Type u := fun i => TensorProduct A Ω (B_ch i)
    choose j_Ω e_Ω hj_Ω_open hj_Ω_comm hj_Ω_range using hChartData

    have hCover_YΩ : ∀ y : ↥Y_Ω, ∃ (i : Fin r) (q₀ : _root_.PrimeSpectrum (D_ch i)),
        (j_Ω i).base q₀ = y := by
      intro y
      let k₀ : 𝒰_Ω.I₀ := 𝒰_Ω.idx y
      have hk₀ : y ∈ Set.range (𝒰_Ω.f k₀).base := 𝒰_Ω.covers y
      let i : Fin r := e_fin k₀
      have he_idx : e_idx i = k₀ := e_fin.symm_apply_apply k₀
      rw [← he_idx, ← hj_Ω_range i] at hk₀
      obtain ⟨q₀, hq₀⟩ := hk₀
      exact ⟨i, q₀, hq₀⟩

    constructor
    · constructor
      · intro hRedY i
        have _ : AlgebraicGeometry.IsReduced Y_Ω := hRedY
        have _ : AlgebraicGeometry.IsOpenImmersion (j_Ω i) := hj_Ω_open i
        have hRedSpec : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (CommRingCat.of (D_ch i))) :=
          AlgebraicGeometry.isReduced_of_isOpenImmersion (j_Ω i)
        have hRedTop : _root_.IsReduced ↑((AlgebraicGeometry.Spec (CommRingCat.of (D_ch i))).presheaf.obj
            (Opposite.op ⊤)) := hRedSpec.component_reduced ⊤
        rw [isReduced_iff]
        intro z ⟨n, hzn⟩
        let d_z : D_ch i := (e_Ω i).symm z
        let s_z := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (D_ch i))).inv.hom d_z
        have hs_nil : IsNilpotent s_z := by
          refine ⟨n, ?_⟩
          rw [← map_pow]
          have hd0 : d_z ^ n = 0 := by
            dsimp only [d_z]
            rw [← map_pow, hzn, map_zero]
          rw [hd0, map_zero]
        have hs0 : s_z = 0 := (isReduced_iff _).mp hRedTop s_z hs_nil
        have hd_eq : d_z = 0 := by
          have h := congrArg (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (D_ch i))).hom.hom hs0
          rw [map_zero] at h
          have hid : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (D_ch i))).inv ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (D_ch i))).hom).hom d_z = d_z := by
            rw [Iso.inv_hom_id]
            rfl
          exact hid.symm.trans h
        exact (e_Ω i).symm.injective (hd_eq.trans (map_zero _).symm)
      · intro hRedAll
        have hRedStalk : ∀ y : ↥Y_Ω, _root_.IsReduced ↑(Y_Ω.presheaf.stalk y) := by
          intro y
          obtain ⟨i, q₀, hq₀⟩ := hCover_YΩ y
          subst hq₀
          have hRedDi : _root_.IsReduced (D_ch i) := by
            rw [isReduced_iff]
            intro d ⟨n, hdn⟩
            have hz : IsNilpotent (e_Ω i d) := ⟨n, by rw [← map_pow, hdn, map_zero]⟩
            have hz0 : e_Ω i d = 0 := (isReduced_iff _).mp (hRedAll i) _ hz
            exact (e_Ω i).injective (hz0.trans (map_zero _).symm)
          have hRedLoc : _root_.IsReduced (Localization.AtPrime q₀.asIdeal) := by
            rw [isReduced_iff]
            intro z ⟨n, hzn⟩
            obtain ⟨⟨d, s⟩, hds⟩ := IsLocalization.surj q₀.asIdeal.primeCompl z
            have hpow : algebraMap (D_ch i) (Localization.AtPrime q₀.asIdeal) (d ^ n) =
                algebraMap (D_ch i) (Localization.AtPrime q₀.asIdeal) 0 := by
              rw [map_pow, map_zero, ← hds, mul_pow, hzn, zero_mul]
            obtain ⟨t, ht⟩ := (IsLocalization.eq_iff_exists q₀.asIdeal.primeCompl _).mp hpow
            simp only [mul_zero] at ht
            have htd_nil : IsNilpotent (t.1 * d) := by
              refine ⟨n, ?_⟩
              by_cases hn : n = 0
              · subst hn
                rw [pow_zero, mul_one] at ht
                exact False.elim (t.2 (ht ▸ q₀.asIdeal.zero_mem))
              · obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
                calc
                  (t.1 * d) ^ (k + 1) = t.1 ^ k * (t.1 * d ^ (k + 1)) := by ring
                  _ = 0 := by rw [ht, mul_zero]
            have htd0 : t.1 * d = 0 := (isReduced_iff _).mp hRedDi _ htd_nil
            have hz_eq0 : algebraMap (D_ch i) (Localization.AtPrime q₀.asIdeal) d = 0 := by
              rw [← map_zero (algebraMap (D_ch i) (Localization.AtPrime q₀.asIdeal))]
              exact (IsLocalization.eq_iff_exists q₀.asIdeal.primeCompl _).mpr ⟨t, by simpa using htd0⟩
            rw [hz_eq0] at hds
            have hUnit_s : IsUnit (algebraMap (D_ch i) (Localization.AtPrime q₀.asIdeal) s.1) :=
              IsLocalization.map_units (Localization.AtPrime q₀.asIdeal) s
            exact hUnit_s.mul_left_eq_zero.mp hds
          haveI : AlgebraicGeometry.IsOpenImmersion (j_Ω i) := hj_Ω_open i
          haveI : CategoryTheory.IsIso ((j_Ω i).stalkMap q₀) :=
            @AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap _ _ (j_Ω i) (hj_Ω_open i) q₀
          let iso_st := asIso ((j_Ω i).stalkMap q₀)
          let toLoc : ↑(Y_Ω.presheaf.stalk ((j_Ω i).base q₀)) →+* Localization.AtPrime q₀.asIdeal :=
            (AlgebraicGeometry.StructureSheaf.stalkIso (D_ch i) q₀).symm.toRingEquiv.toRingHom.comp
              iso_st.hom.hom
          rw [isReduced_iff]
          intro s ⟨n, hsn⟩
          have hnil_loc : IsNilpotent (toLoc s) := ⟨n, by rw [← map_pow, hsn, map_zero]⟩
          have hloc0 : toLoc s = 0 := (isReduced_iff _).mp hRedLoc _ hnil_loc
          have himg0 : iso_st.hom.hom s = 0 :=
            (AlgebraicGeometry.StructureSheaf.stalkIso (D_ch i) q₀).symm.injective
              (hloc0.trans (map_zero _).symm)
          have hinv := congrArg iso_st.inv.hom himg0
          rw [map_zero] at hinv
          have hid : (iso_st.hom ≫ iso_st.inv).hom s = s := by rw [iso_st.hom_inv_id]; rfl
          exact hid.symm.trans hinv
        exact @AlgebraicGeometry.isReduced_of_isReduced_stalk Y_Ω hRedStalk

    · have hGeomSum : ∀ {R : Type u} [CommRing R] (z : R) (k : ℕ),
          (1 + z) * (∑ j ∈ Finset.range k, (-z) ^ j) = 1 - (-z) ^ k := by
        intro R _ z k
        induction k with
        | zero => simp
        | succ k ih =>
          rw [Finset.sum_range_succ, mul_add, ih, pow_succ]
          ring

      have hLocalArtin : ∀ {m_v t_v : ℕ} (g_v : Fin t_v → MvPolynomial (Fin m_v) Ω)
          (Q : Type u) [CommRing Q] [Algebra Ω Q]
          (π_Q : MvPolynomial (Fin m_v) Ω →ₐ[Ω] Q),
          Function.Surjective π_Q →
          RingHom.ker π_Q.toRingHom = Ideal.span (Set.range g_v) →
          ((∀ (q₀ : _root_.PrimeSpectrum Q), q₀.asIdeal.IsMaximal →
              let L₀ := Localization.AtPrime q₀.asIdeal
              let 𝔪₀ : Ideal L₀ := IsLocalRing.maximalIdeal L₀
              Module.finrank Ω (L₀ ⧸ 𝔪₀ ^ 2) = 2 ∨
                (Module.finrank Ω (L₀ ⧸ 𝔪₀ ^ 2) = 3 ∧
                 Module.finrank Ω (L₀ ⧸ 𝔪₀ ^ 3) = 5 ∧
                 ∃ u v : L₀, Ideal.span {u, v} = 𝔪₀ ∧ u * v ∈ 𝔪₀ ^ 3)) ↔
           (∀ (x₀ : Fin m_v → Ω),
              (∀ ν : Fin t_v, MvPolynomial.aeval x₀ (g_v ν) = 0) →
              let I_v : Ideal (MvPolynomial (Fin m_v) Ω) := Ideal.span (Set.range g_v)
              let M₀ : Ideal (MvPolynomial (Fin m_v) Ω) := RingHom.ker (MvPolynomial.aeval x₀).toRingHom
              Module.finrank Ω (MvPolynomial (Fin m_v) Ω ⧸ (I_v ⊔ M₀ ^ 2)) = 2 ∨
                (Module.finrank Ω (MvPolynomial (Fin m_v) Ω ⧸ (I_v ⊔ M₀ ^ 2)) = 3 ∧
                 Module.finrank Ω (MvPolynomial (Fin m_v) Ω ⧸ (I_v ⊔ M₀ ^ 3)) = 5 ∧
                 ∃ u v : MvPolynomial (Fin m_v) Ω,
                   u ∈ M₀ ∧ v ∈ M₀ ∧
                   M₀ ≤ I_v ⊔ M₀ ^ 2 ⊔ Ideal.span {u, v} ∧
                   u * v ∈ I_v ⊔ M₀ ^ 3))) := by
        intro m_v t_v g_v Q _ _ π_Q hSurj_Q hKer_Q
        let P_v := MvPolynomial (Fin m_v) Ω
        let I_v : Ideal P_v := Ideal.span (Set.range g_v)
        have _ : IsNoetherianRing Q := isNoetherianRing_of_surjective P_v Q π_Q.toRingHom hSurj_Q

        have hPairIff : ∀ (q₀ : _root_.PrimeSpectrum Q) (x₀ : Fin m_v → Ω),
            q₀.asIdeal.IsMaximal →
            Ideal.comap π_Q.toRingHom q₀.asIdeal = RingHom.ker (MvPolynomial.aeval x₀).toRingHom →
            ((let L₀ := Localization.AtPrime q₀.asIdeal
              let 𝔪₀ : Ideal L₀ := IsLocalRing.maximalIdeal L₀
              Module.finrank Ω (L₀ ⧸ 𝔪₀ ^ 2) = 2 ∨
                (Module.finrank Ω (L₀ ⧸ 𝔪₀ ^ 2) = 3 ∧
                 Module.finrank Ω (L₀ ⧸ 𝔪₀ ^ 3) = 5 ∧
                 ∃ u v : L₀, Ideal.span {u, v} = 𝔪₀ ∧ u * v ∈ 𝔪₀ ^ 3)) ↔
             (let M₀ : Ideal P_v := RingHom.ker (MvPolynomial.aeval x₀).toRingHom
              Module.finrank Ω (P_v ⧸ (I_v ⊔ M₀ ^ 2)) = 2 ∨
                (Module.finrank Ω (P_v ⧸ (I_v ⊔ M₀ ^ 2)) = 3 ∧
                 Module.finrank Ω (P_v ⧸ (I_v ⊔ M₀ ^ 3)) = 5 ∧
                 ∃ u v : P_v,
                   u ∈ M₀ ∧ v ∈ M₀ ∧
                   M₀ ≤ I_v ⊔ M₀ ^ 2 ⊔ Ideal.span {u, v} ∧
                   u * v ∈ I_v ⊔ M₀ ^ 3))) := by
          intro q₀ x₀ _ hComap_M₀
          let M₀ : Ideal P_v := RingHom.ker (MvPolynomial.aeval x₀).toRingHom
          have hI_le_M₀ : I_v ≤ M₀ := by
            change Ideal.span (Set.range g_v) ≤ RingHom.ker (MvPolynomial.aeval x₀).toRingHom
            rw [← hKer_Q, ← hComap_M₀]
            intro p hp
            rw [Ideal.mem_comap]
            have hp0 : π_Q.toRingHom p = 0 := hp
            rw [hp0]
            exact zero_mem _
          let L₀ := Localization.AtPrime q₀.asIdeal
          let 𝔪₀ : Ideal L₀ := IsLocalRing.maximalIdeal L₀
          have _ : IsNoetherianRing L₀ :=
            IsLocalization.isNoetherianRing q₀.asIdeal.primeCompl L₀ inferInstance
          let toL₀ : P_v →ₐ[Ω] L₀ := (IsScalarTower.toAlgHom Ω Q L₀).comp π_Q
          have htoL₀_apply : ∀ p : P_v, toL₀ p = algebraMap Q L₀ (π_Q p) := fun _ => rfl
          have hMap_M₀_le : ∀ p ∈ M₀, toL₀ p ∈ 𝔪₀ := by
            intro p hp
            have hq : π_Q.toRingHom p ∈ q₀.asIdeal := by
              rw [← Ideal.mem_comap, hComap_M₀]
              exact hp
            change algebraMap Q L₀ (π_Q.toRingHom p) ∈ IsLocalRing.maximalIdeal L₀
            rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q₀.asIdeal L₀]
            exact Ideal.mem_map_of_mem (algebraMap Q L₀) hq

          have hJetEquiv : ∀ (k : ℕ) (_ : 1 ≤ k),
              ∃ Θ_k : (P_v ⧸ (I_v ⊔ M₀ ^ k)) ≃ₐ[Ω] (L₀ ⧸ 𝔪₀ ^ k),
                ∀ p : P_v, Θ_k (Ideal.Quotient.mk (I_v ⊔ M₀ ^ k) p) =
                  Ideal.Quotient.mk (𝔪₀ ^ k) (toL₀ p) := by
            intro k hk
            let J_k : Ideal P_v := I_v ⊔ M₀ ^ k
            let R_k := P_v ⧸ J_k
            let mk_k : P_v →ₐ[Ω] R_k := Ideal.Quotient.mkₐ Ω J_k
            let Φ_k : P_v →ₐ[Ω] (L₀ ⧸ 𝔪₀ ^ k) :=
              (Ideal.Quotient.mkₐ Ω (𝔪₀ ^ k)).comp toL₀
            have hΦ_van : ∀ p ∈ J_k, Φ_k p = 0 := by
              intro p hp
              change Ideal.Quotient.mk (𝔪₀ ^ k) (toL₀ p) = 0
              rw [Ideal.Quotient.eq_zero_iff_mem]
              rcases Submodule.mem_sup.mp hp with ⟨p₁, hp₁, p₂, hp₂, rfl⟩
              rw [map_add]
              have hp₁_0 : toL₀ p₁ = 0 := by
                rw [htoL₀_apply]
                have hmem : p₁ ∈ RingHom.ker π_Q.toRingHom := by rw [hKer_Q]; exact hp₁
                have h0 : π_Q p₁ = 0 := hmem
                rw [h0, map_zero]
              rw [hp₁_0, zero_add]
              have hpow : Ideal.map toL₀.toRingHom (M₀ ^ k) ≤ 𝔪₀ ^ k := by
                rw [Ideal.map_pow]
                refine pow_le_pow_left' ?_ k
                exact Ideal.map_le_iff_le_comap.mpr hMap_M₀_le
              exact hpow (Ideal.mem_map_of_mem toL₀.toRingHom hp₂)
            let φ_k : R_k →ₐ[Ω] (L₀ ⧸ 𝔪₀ ^ k) := Ideal.Quotient.liftₐ J_k Φ_k hΦ_van

            let sec_Q : Q → P_v := Function.surjInv hSurj_Q
            have hsec_Q : ∀ x : Q, π_Q (sec_Q x) = x := Function.surjInv_eq hSurj_Q
            have hmk_well : ∀ p₁ p₂ : P_v, π_Q p₁ = π_Q p₂ → mk_k p₁ = mk_k p₂ := by
              intro p₁ p₂ hEq
              have hdiff : p₁ - p₂ ∈ I_v := by
                change p₁ - p₂ ∈ Ideal.span (Set.range g_v)
                rw [← hKer_Q, RingHom.mem_ker]
                change π_Q (p₁ - p₂) = 0
                rw [map_sub, hEq, sub_self]
              have h0 : mk_k (p₁ - p₂) = 0 :=
                Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_left hdiff)
              rwa [map_sub, sub_eq_zero] at h0
            let α_k : Q →ₐ[Ω] R_k :=
              { toFun := fun x => mk_k (sec_Q x)
                map_one' := by
                  rw [hmk_well (sec_Q 1) 1 (by rw [hsec_Q, map_one]), map_one]
                map_mul' := fun x y => by
                  rw [hmk_well (sec_Q (x * y)) (sec_Q x * sec_Q y)
                    (by rw [hsec_Q, map_mul, hsec_Q, hsec_Q]), map_mul]
                map_zero' := by
                  rw [hmk_well (sec_Q 0) 0 (by rw [hsec_Q, map_zero]), map_zero]
                map_add' := fun x y => by
                  rw [hmk_well (sec_Q (x + y)) (sec_Q x + sec_Q y)
                    (by rw [hsec_Q, map_add, hsec_Q, hsec_Q]), map_add]
                commutes' := fun c => by
                  rw [hmk_well (sec_Q (algebraMap Ω Q c)) (MvPolynomial.C c)
                    (by rw [hsec_Q]; exact (π_Q.commutes c).symm)]
                  rfl }
            have hα_π : ∀ p : P_v, α_k (π_Q p) = mk_k p :=
              fun p => hmk_well (sec_Q (π_Q p)) p (hsec_Q (π_Q p))

            have hUnit_s : ∀ s : q₀.asIdeal.primeCompl, IsUnit (α_k s.1) := by
              intro s
              let p_s : P_v := sec_Q s.1
              have hp_s : π_Q p_s = s.1 := hsec_Q s.1
              have hp_not_M₀ : p_s ∉ M₀ := by
                intro hp_in
                apply s.2
                have hcom : p_s ∈ Ideal.comap π_Q.toRingHom q₀.asIdeal := by
                  rw [hComap_M₀]
                  exact hp_in
                have hcom' : π_Q p_s ∈ q₀.asIdeal := hcom
                rwa [hp_s] at hcom'
              let c_s : Ω := MvPolynomial.aeval x₀ p_s
              have hc_s_ne : c_s ≠ 0 := hp_not_M₀
              let m_s : P_v := MvPolynomial.C c_s⁻¹ * p_s - 1
              have hm_s_M₀ : m_s ∈ M₀ := by
                change MvPolynomial.aeval x₀ (MvPolynomial.C c_s⁻¹ * p_s - 1) = 0
                rw [map_sub, map_mul, MvPolynomial.aeval_C, map_one]
                change c_s⁻¹ * c_s - 1 = 0
                rw [inv_mul_cancel₀ hc_s_ne, sub_self]
              have hbar_pow0 : (-mk_k m_s) ^ k = 0 := by
                have hmk_pow0 : (mk_k m_s) ^ k = 0 := by
                  rw [← map_pow]
                  exact Ideal.Quotient.eq_zero_iff_mem.mpr
                    (Ideal.mem_sup_right (Ideal.pow_mem_pow hm_s_M₀ k))
                rw [neg_pow, hmk_pow0, mul_zero]
              have hUnit_1m : IsUnit (1 + mk_k m_s) := by
                refine IsUnit.of_mul_eq_one (∑ j ∈ Finset.range k, (-mk_k m_s) ^ j) ?_
                rw [hGeomSum (mk_k m_s) k, hbar_pow0, sub_zero]
              have hUnit_c : IsUnit (mk_k (MvPolynomial.C c_s)) := by
                refine IsUnit.of_mul_eq_one (mk_k (MvPolynomial.C c_s⁻¹)) ?_
                rw [← map_mul, ← MvPolynomial.C_mul, mul_inv_cancel₀ hc_s_ne, MvPolynomial.C_1, map_one]
              have hα_eq : α_k s.1 = mk_k (MvPolynomial.C c_s) * (1 + mk_k m_s) := by
                rw [← hp_s, hα_π]
                have hp_eq : p_s = MvPolynomial.C c_s * (1 + m_s) := by
                  dsimp only [m_s]
                  have h1 : MvPolynomial.C c_s * MvPolynomial.C c_s⁻¹ = (1 : P_v) := by
                    rw [← MvPolynomial.C_mul, mul_inv_cancel₀ hc_s_ne, MvPolynomial.C_1]
                  linear_combination -p_s * h1
                conv_lhs => rw [hp_eq]
                rw [map_mul, map_add, map_one]
              rw [hα_eq]
              exact hUnit_c.mul hUnit_1m

            let ψ_L_ring : L₀ →+* R_k := IsLocalization.lift hUnit_s
            have hψ_L_eq : ∀ x : Q, ψ_L_ring (algebraMap Q L₀ x) = α_k x :=
              IsLocalization.lift_eq hUnit_s
            let ψ_L : L₀ →ₐ[Ω] R_k :=
              { ψ_L_ring with
                commutes' := fun c => by
                  change ψ_L_ring (algebraMap Ω L₀ c) = algebraMap Ω R_k c
                  rw [IsScalarTower.algebraMap_apply Ω Q L₀ c, hψ_L_eq, α_k.commutes] }
            have hψ_van_m0 : ∀ z ∈ 𝔪₀ ^ k, ψ_L z = 0 := by
              have hMap_m : Ideal.map ψ_L.toRingHom 𝔪₀ ≤ Ideal.map mk_k.toRingHom M₀ := by
                change Ideal.map ψ_L.toRingHom (IsLocalRing.maximalIdeal L₀) ≤ _
                rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q₀.asIdeal L₀, Ideal.map_map]
                refine Ideal.map_le_iff_le_comap.mpr fun x hx => ?_
                rw [Ideal.mem_comap]
                change ψ_L_ring (algebraMap Q L₀ x) ∈ _
                rw [hψ_L_eq, ← hsec_Q x, hα_π]
                have hsec_in : sec_Q x ∈ M₀ := by
                  change sec_Q x ∈ RingHom.ker (MvPolynomial.aeval x₀).toRingHom
                  rw [← hComap_M₀, Ideal.mem_comap]
                  change π_Q (sec_Q x) ∈ q₀.asIdeal
                  rw [hsec_Q]
                  exact hx
                exact Ideal.mem_map_of_mem mk_k.toRingHom hsec_in
              have hMap_pow : Ideal.map ψ_L.toRingHom (𝔪₀ ^ k) ≤ ⊥ := by
                rw [Ideal.map_pow]
                refine (pow_le_pow_left' hMap_m k).trans ?_
                rw [← Ideal.map_pow, Ideal.map_le_iff_le_comap]
                intro p hp
                rw [Ideal.mem_comap, Ideal.mem_bot]
                exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_right hp)
              intro z hz
              exact Ideal.mem_bot.mp (hMap_pow (Ideal.mem_map_of_mem ψ_L.toRingHom hz))
            let ψ_k : (L₀ ⧸ 𝔪₀ ^ k) →ₐ[Ω] R_k := Ideal.Quotient.liftₐ (𝔪₀ ^ k) ψ_L hψ_van_m0

            have hψφ : ψ_k.comp φ_k = AlgHom.id Ω R_k := by
              apply AlgHom.ext
              intro z
              obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
              change ψ_L (toL₀ p) = mk_k p
              rw [htoL₀_apply]
              change ψ_L_ring (algebraMap Q L₀ (π_Q p)) = mk_k p
              rw [hψ_L_eq, hα_π]
            have hφψ : φ_k.comp ψ_k = AlgHom.id Ω (L₀ ⧸ 𝔪₀ ^ k) := by
              apply AlgHom.coe_ringHom_injective
              apply Ideal.Quotient.ringHom_ext
              refine IsLocalization.ringHom_ext q₀.asIdeal.primeCompl ?_
              ext x
              change φ_k (ψ_L_ring (algebraMap Q L₀ x)) = Ideal.Quotient.mk (𝔪₀ ^ k) (algebraMap Q L₀ x)
              rw [hψ_L_eq, ← hsec_Q x, hα_π]
              change Ideal.Quotient.mk (𝔪₀ ^ k) (toL₀ (sec_Q x)) = _
              rw [htoL₀_apply]
            exact ⟨AlgEquiv.ofAlgHom φ_k ψ_k hφψ hψφ, fun _ => rfl⟩

          obtain ⟨Θ₁, hΘ₁⟩ := hJetEquiv 1 (by omega)
          obtain ⟨Θ₂, hΘ₂⟩ := hJetEquiv 2 (by omega)
          obtain ⟨Θ₃, hΘ₃⟩ := hJetEquiv 3 (by omega)
          have hfin2_eq : Module.finrank Ω (L₀ ⧸ 𝔪₀ ^ 2) = Module.finrank Ω (P_v ⧸ (I_v ⊔ M₀ ^ 2)) :=
            Θ₂.symm.toLinearEquiv.finrank_eq
          have hfin3_eq : Module.finrank Ω (L₀ ⧸ 𝔪₀ ^ 3) = Module.finrank Ω (P_v ⧸ (I_v ⊔ M₀ ^ 3)) :=
            Θ₃.symm.toLinearEquiv.finrank_eq
          have hKer_toL₀_pow : ∀ (k : ℕ) (hk : 1 ≤ k) (p : P_v),
              toL₀ p ∈ 𝔪₀ ^ k ↔ p ∈ I_v ⊔ M₀ ^ k := by
            intro k hk p
            obtain ⟨Θ_k, hΘ_k⟩ := hJetEquiv k hk
            rw [← Ideal.Quotient.eq_zero_iff_mem, ← hΘ_k p]
            exact ⟨fun h => Ideal.Quotient.eq_zero_iff_mem.mp (Θ_k.injective (h.trans (map_zero _).symm)),
                   fun h => by rw [Ideal.Quotient.eq_zero_iff_mem.mpr h, map_zero]⟩
          have hSup1_eq : I_v ⊔ M₀ ^ 1 = M₀ := by
            rw [pow_one, sup_eq_right]
            exact hI_le_M₀
          have htoL₀_mem_m0 : ∀ p : P_v, toL₀ p ∈ 𝔪₀ ↔ p ∈ M₀ := by
            intro p
            have h := hKer_toL₀_pow 1 (by omega) p
            rwa [pow_one, hSup1_eq] at h

          have hSplitIff :
              (∃ u_L v_L : L₀, Ideal.span {u_L, v_L} = 𝔪₀ ∧ u_L * v_L ∈ 𝔪₀ ^ 3) ↔
              (∃ u v : P_v, u ∈ M₀ ∧ v ∈ M₀ ∧ M₀ ≤ I_v ⊔ M₀ ^ 2 ⊔ Ideal.span {u, v} ∧
                u * v ∈ I_v ⊔ M₀ ^ 3) := by
            constructor
            · rintro ⟨u_L, v_L, hSpan_uv, huv_L3⟩
              have hu_L_m : u_L ∈ 𝔪₀ := hSpan_uv ▸ Ideal.subset_span (by simp)
              have hv_L_m : v_L ∈ 𝔪₀ := hSpan_uv ▸ Ideal.subset_span (by simp)
              obtain ⟨u_q, hu_q⟩ := Θ₃.surjective (Ideal.Quotient.mk (𝔪₀ ^ 3) u_L)
              obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective u_q
              obtain ⟨v_q, hv_q⟩ := Θ₃.surjective (Ideal.Quotient.mk (𝔪₀ ^ 3) v_L)
              obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective v_q
              rw [hΘ₃ u] at hu_q
              rw [hΘ₃ v] at hv_q
              have hu_diff : toL₀ u - u_L ∈ 𝔪₀ ^ 3 :=
                Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_sub, hu_q, sub_self])
              have hv_diff : toL₀ v - v_L ∈ 𝔪₀ ^ 3 :=
                Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_sub, hv_q, sub_self])
              have hm3_le_m1 : 𝔪₀ ^ 3 ≤ 𝔪₀ := Ideal.pow_le_self (by norm_num)
              have hm3_le_m2 : 𝔪₀ ^ 3 ≤ 𝔪₀ ^ 2 := Ideal.pow_le_pow_right (by norm_num)
              have hu_M₀ : u ∈ M₀ := (htoL₀_mem_m0 u).mp (by
                have : toL₀ u = (toL₀ u - u_L) + u_L := (sub_add_cancel _ _).symm
                rw [this]; exact add_mem (hm3_le_m1 hu_diff) hu_L_m)
              have hv_M₀ : v ∈ M₀ := (htoL₀_mem_m0 v).mp (by
                have : toL₀ v = (toL₀ v - v_L) + v_L := (sub_add_cancel _ _).symm
                rw [this]; exact add_mem (hm3_le_m1 hv_diff) hv_L_m)
              have huv_P3 : u * v ∈ I_v ⊔ M₀ ^ 3 := by
                rw [← hKer_toL₀_pow 3 (by omega), map_mul, ← Ideal.Quotient.eq_zero_iff_mem,
                  map_mul, hu_q, hv_q, ← map_mul]
                exact Ideal.Quotient.eq_zero_iff_mem.mpr huv_L3
              refine ⟨u, v, hu_M₀, hv_M₀, ?_, huv_P3⟩
              intro w hw
              have hw_L : toL₀ w ∈ Ideal.span {u_L, v_L} := by
                rw [hSpan_uv]
                exact (htoL₀_mem_m0 w).mpr hw
              obtain ⟨a_L, b_L, hab_eq⟩ := Ideal.mem_span_pair.mp hw_L
              obtain ⟨a_q, ha_q⟩ := Θ₁.surjective (Ideal.Quotient.mk (𝔪₀ ^ 1) a_L)
              obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a_q
              obtain ⟨b_q, hb_q⟩ := Θ₁.surjective (Ideal.Quotient.mk (𝔪₀ ^ 1) b_L)
              obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b_q
              rw [hΘ₁ a] at ha_q
              rw [hΘ₁ b] at hb_q
              have ha_diff : toL₀ a - a_L ∈ 𝔪₀ := by
                have hsub0 : Ideal.Quotient.mk (𝔪₀ ^ 1) (toL₀ a - a_L) = 0 := by
                  rw [RingHom.map_sub, ha_q, sub_self]
                have h := Ideal.Quotient.eq_zero_iff_mem.mp hsub0
                rwa [pow_one] at h
              have hb_diff : toL₀ b - b_L ∈ 𝔪₀ := by
                have hsub0 : Ideal.Quotient.mk (𝔪₀ ^ 1) (toL₀ b - b_L) = 0 := by
                  rw [RingHom.map_sub, hb_q, sub_self]
                have h := Ideal.Quotient.eq_zero_iff_mem.mp hsub0
                rwa [pow_one] at h
              have hrem_m2 : toL₀ (w - (a * u + b * v)) ∈ 𝔪₀ ^ 2 := by
                have hEq : toL₀ (w - (a * u + b * v)) =
                    -((toL₀ a - a_L) * u_L + toL₀ a * (toL₀ u - u_L) +
                      (toL₀ b - b_L) * v_L + toL₀ b * (toL₀ v - v_L)) := by
                  simp only [map_sub, map_add, map_mul, ← hab_eq]
                  ring
                rw [hEq]
                refine neg_mem (add_mem (add_mem (add_mem ?_ ?_) ?_) ?_)
                · rw [sq]; exact Ideal.mul_mem_mul ha_diff hu_L_m
                · exact Ideal.mul_mem_left _ _ (hm3_le_m2 hu_diff)
                · rw [sq]; exact Ideal.mul_mem_mul hb_diff hv_L_m
                · exact Ideal.mul_mem_left _ _ (hm3_le_m2 hv_diff)
              have hw_sub : w - (a * u + b * v) ∈ I_v ⊔ M₀ ^ 2 :=
                (hKer_toL₀_pow 2 (by omega) _).mp hrem_m2
              have hw_eq : w = (w - (a * u + b * v)) + (a * u + b * v) := (sub_add_cancel _ _).symm
              rw [hw_eq]
              refine Submodule.add_mem_sup hw_sub ?_
              exact Ideal.mem_span_pair.mpr ⟨a, b, rfl⟩
            · rintro ⟨u, v, hu_M₀, hv_M₀, hM₀_le, huv_P3⟩
              let u_L : L₀ := toL₀ u
              let v_L : L₀ := toL₀ v
              have hu_L_m : u_L ∈ 𝔪₀ := (htoL₀_mem_m0 u).mpr hu_M₀
              have hv_L_m : v_L ∈ 𝔪₀ := (htoL₀_mem_m0 v).mpr hv_M₀
              have huv_L3 : u_L * v_L ∈ 𝔪₀ ^ 3 := by
                change toL₀ u * toL₀ v ∈ 𝔪₀ ^ 3
                rw [← map_mul]
                exact (hKer_toL₀_pow 3 (by omega) (u * v)).mpr huv_P3
              refine ⟨u_L, v_L, ?_, huv_L3⟩
              apply le_antisymm
              · rw [Ideal.span_le]
                rintro z (rfl | rfl)
                · exact hu_L_m
                · exact hv_L_m
              · have hm0_fg : 𝔪₀.FG := IsNoetherian.noetherian 𝔪₀
                have hm0_jac : 𝔪₀ ≤ (⊥ : Ideal L₀).jacobson := by
                  intro x hx
                  rw [Ideal.mem_jacobson_bot]
                  intro y
                  apply IsLocalRing.notMem_maximalIdeal.mp
                  intro hmem
                  have hxy : x * y ∈ 𝔪₀ := Ideal.mul_mem_right y 𝔪₀ hx
                  have h1 : (1 : L₀) ∈ 𝔪₀ := by
                    have hsub := sub_mem hmem hxy
                    simpa using hsub
                  exact (IsLocalRing.maximalIdeal.isMaximal L₀).ne_top
                    (Ideal.eq_top_of_isUnit_mem 𝔪₀ h1 isUnit_one)
                refine Submodule.le_of_le_smul_of_le_jacobson_bot hm0_fg hm0_jac ?_
                change IsLocalRing.maximalIdeal L₀ ≤ Ideal.span {u_L, v_L} ⊔ 𝔪₀ • 𝔪₀
                rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q₀.asIdeal L₀]
                refine Ideal.map_le_iff_le_comap.mpr fun x hx => ?_
                rw [Ideal.mem_comap]
                let w : P_v := Function.surjInv hSurj_Q x
                have hw_x : π_Q w = x := Function.surjInv_eq hSurj_Q x
                have hw_M₀ : w ∈ M₀ := by
                  change w ∈ RingHom.ker (MvPolynomial.aeval x₀).toRingHom
                  rw [← hComap_M₀, Ideal.mem_comap]
                  change π_Q w ∈ q₀.asIdeal
                  rw [hw_x]
                  exact hx
                have hw_sup := hM₀_le hw_M₀
                rcases Submodule.mem_sup.mp hw_sup with ⟨p₁, hp₁, p₂, hp₂, hw_eq⟩
                rcases Submodule.mem_sup.mp hp₁ with ⟨q_I, hq_I, q_2, hq_2, rfl⟩
                have h_toL_w : algebraMap Q L₀ x = toL₀ q_I + toL₀ q_2 + toL₀ p₂ := by
                  rw [← hw_x, ← htoL₀_apply, ← hw_eq, map_add, map_add]
                have hq_I_0 : toL₀ q_I = 0 := by
                  rw [htoL₀_apply]
                  have hmem : q_I ∈ RingHom.ker π_Q.toRingHom := by rw [hKer_Q]; exact hq_I
                  have h0 : π_Q q_I = 0 := hmem
                  rw [h0, map_zero]
                rw [h_toL_w, hq_I_0, zero_add, add_comm]
                refine Submodule.add_mem_sup ?_ ?_
                · obtain ⟨a, b, rfl⟩ := Ideal.mem_span_pair.mp hp₂
                  rw [map_add, map_mul, map_mul]
                  exact Ideal.mem_span_pair.mpr ⟨toL₀ a, toL₀ b, rfl⟩
                · rw [smul_eq_mul, ← sq]
                  have hMap2 : Ideal.map toL₀.toRingHom (M₀ ^ 2) ≤ 𝔪₀ ^ 2 := by
                    rw [Ideal.map_pow]
                    exact pow_le_pow_left' (Ideal.map_le_iff_le_comap.mpr hMap_M₀_le) 2
                  exact hMap2 (Ideal.mem_map_of_mem toL₀.toRingHom hq_2)

          dsimp only
          rw [hfin2_eq, hfin3_eq, hSplitIff]

        constructor
        · intro hAll_q x₀ hx₀
          let M₀ : Ideal P_v := RingHom.ker (MvPolynomial.aeval x₀).toRingHom
          have hI_le : I_v ≤ M₀ := by
            rw [Ideal.span_le]
            rintro _ ⟨ν, rfl⟩
            exact hx₀ ν
          let sec_Q : Q → P_v := Function.surjInv hSurj_Q
          have hsec_Q : ∀ x : Q, π_Q (sec_Q x) = x := Function.surjInv_eq hSurj_Q
          have hev_well : ∀ p₁ p₂ : P_v, π_Q p₁ = π_Q p₂ →
              MvPolynomial.aeval x₀ p₁ = MvPolynomial.aeval x₀ p₂ := by
            intro p₁ p₂ hEq
            have hdiff : p₁ - p₂ ∈ M₀ := by
              apply hI_le
              change p₁ - p₂ ∈ Ideal.span (Set.range g_v)
              rw [← hKer_Q, RingHom.mem_ker]
              change π_Q (p₁ - p₂) = 0
              rw [map_sub, hEq, sub_self]
            change MvPolynomial.aeval x₀ (p₁ - p₂) = 0 at hdiff
            rwa [map_sub, sub_eq_zero] at hdiff
          let ev_Q : Q →+* Ω :=
            { toFun := fun x => MvPolynomial.aeval x₀ (sec_Q x)
              map_one' := by
                rw [hev_well (sec_Q 1) 1 (by rw [hsec_Q, map_one]), map_one]
              map_mul' := fun x y => by
                rw [hev_well (sec_Q (x * y)) (sec_Q x * sec_Q y)
                  (by rw [hsec_Q, map_mul, hsec_Q, hsec_Q]), map_mul]
              map_zero' := by
                rw [hev_well (sec_Q 0) 0 (by rw [hsec_Q, map_zero]), map_zero]
              map_add' := fun x y => by
                rw [hev_well (sec_Q (x + y)) (sec_Q x + sec_Q y)
                  (by rw [hsec_Q, map_add, hsec_Q, hsec_Q]), map_add] }
          have hev_π : ∀ p : P_v, ev_Q (π_Q p) = MvPolynomial.aeval x₀ p :=
            fun p => hev_well (sec_Q (π_Q p)) p (hsec_Q (π_Q p))
          have hev_surj : Function.Surjective ev_Q := by
            intro c
            refine ⟨π_Q (MvPolynomial.C c), ?_⟩
            rw [hev_π, MvPolynomial.aeval_C]
            rfl
          have hker_max : (RingHom.ker ev_Q).IsMaximal :=
            RingHom.ker_isMaximal_of_surjective ev_Q hev_surj
          have _ : (RingHom.ker ev_Q).IsPrime := hker_max.isPrime
          let q₀ : _root_.PrimeSpectrum Q := ⟨RingHom.ker ev_Q, inferInstance⟩
          have hcomap_q₀ : Ideal.comap π_Q.toRingHom q₀.asIdeal = M₀ := by
            ext p
            change ev_Q (π_Q p) = 0 ↔ MvPolynomial.aeval x₀ p = 0
            rw [hev_π]
          exact (hPairIff q₀ x₀ hker_max hcomap_q₀).mp (hAll_q q₀ hker_max)
        · intro hAll_x q₀ hq₀_max
          haveI : q₀.asIdeal.IsMaximal := hq₀_max
          let M_comap : Ideal P_v := Ideal.comap π_Q.toRingHom q₀.asIdeal
          have hM_max : M_comap.IsMaximal :=
            Ideal.comap_isMaximal_of_surjective π_Q.toRingHom hSurj_Q
          obtain ⟨x₀, hx₀_van⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hM_max
          have hM_eq : M_comap = RingHom.ker (MvPolynomial.aeval x₀).toRingHom := by
            rw [hx₀_van]
            ext p
            exact MvPolynomial.mem_vanishingIdeal_singleton_iff x₀ p
          have hx₀_roots : ∀ ν : Fin t_v, MvPolynomial.aeval x₀ (g_v ν) = 0 := by
            intro ν
            change g_v ν ∈ RingHom.ker (MvPolynomial.aeval x₀).toRingHom
            rw [← hM_eq, Ideal.mem_comap]
            have hmem : g_v ν ∈ RingHom.ker π_Q.toRingHom := by
              rw [hKer_Q]
              exact Ideal.subset_span (Set.mem_range_self ν)
            have h0 : π_Q.toRingHom (g_v ν) = 0 := hmem
            rw [h0]
            exact zero_mem _
          exact (hPairIff q₀ x₀ hq₀_max hM_eq).mpr (hAll_x x₀ hx₀_roots)

      have hπ_Di : ∀ i : Fin r,
          let I_Ω_i := Ideal.span (Set.range (fun ν : Fin (t i) => MvPolynomial.map φ (f i ν)))
          let π_i := (e_Ω i).symm.toAlgHom.comp (Ideal.Quotient.mkₐ Ω I_Ω_i)
          Function.Surjective π_i ∧ RingHom.ker π_i.toRingHom = I_Ω_i := by
        intro i
        let I_Ω_i := Ideal.span (Set.range (fun ν : Fin (t i) => MvPolynomial.map φ (f i ν)))
        let π_i := (e_Ω i).symm.toAlgHom.comp (Ideal.Quotient.mkₐ Ω I_Ω_i)
        refine ⟨(e_Ω i).symm.surjective.comp Ideal.Quotient.mk_surjective, ?_⟩
        ext p
        change (e_Ω i).symm (Ideal.Quotient.mk I_Ω_i p) = 0 ↔ p ∈ I_Ω_i
        rw [← map_zero (e_Ω i).symm, (e_Ω i).symm.injective.eq_iff, Ideal.Quotient.eq_zero_iff_mem]

      let stalkAlgElem : ∀ (y : ↥Y_Ω), Ω → ↑(Y_Ω.presheaf.stalk y) :=
        fun y c => (Y_Ω.presheaf.germ ⊤ y trivial).hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ p_Ω.appTop).hom c)
      have hStalkCongrElem : ∀ {y₁ y₂ : ↥Y_Ω} (hy : y₁ = y₂) (c : Ω),
          (Y_Ω.presheaf.stalkCongr (Inseparable.of_eq hy)).hom.hom (stalkAlgElem y₁ c) =
            stalkAlgElem y₂ c := by
        intro y₁ y₂ hy c
        subst hy
        simp
      have hStalkChartIso : ∀ (D : Type u) [CommRing D] [Algebra Ω D]
          (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y_Ω),
          AlgebraicGeometry.IsOpenImmersion j_D →
          j_D ≫ p_Ω = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
          ∀ (q : _root_.PrimeSpectrum D),
            ∃ e_st : ↑(Y_Ω.presheaf.stalk (j_D.base q)) ≃+* Localization.AtPrime q.asIdeal,
              ∀ c : Ω, e_st (stalkAlgElem (j_D.base q) c) =
                algebraMap Ω (Localization.AtPrime q.asIdeal) c := by
        intro D _ _ j_D hj_open hj_comm q
        haveI : AlgebraicGeometry.IsOpenImmersion j_D := hj_open
        haveI : CategoryTheory.IsIso (j_D.stalkMap q) :=
          @AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap _ _ j_D hj_open q
        let iso_j : Y_Ω.presheaf.stalk (j_D.base q) ≅
            (AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.stalk q :=
          asIso (j_D.stalkMap q)
        let e_j : ↑(Y_Ω.presheaf.stalk (j_D.base q)) ≃+*
            ↑((AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.stalk q) :=
          { toFun := iso_j.hom.hom
            invFun := iso_j.inv.hom
            left_inv := fun x => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom iso_j.hom_inv_id) x
            right_inv := fun x => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom iso_j.inv_hom_id) x
            map_mul' := map_mul iso_j.hom.hom
            map_add' := map_add iso_j.hom.hom }
        let e_st : ↑(Y_Ω.presheaf.stalk (j_D.base q)) ≃+* Localization.AtPrime q.asIdeal :=
          e_j.trans (AlgebraicGeometry.StructureSheaf.stalkIso D q).symm.toRingEquiv
        refine ⟨e_st, ?_⟩
        intro c
        have he_st_eq : e_st (stalkAlgElem (j_D.base q) c) =
            (AlgebraicGeometry.StructureSheaf.stalkIso D q).symm
              ((Y_Ω.presheaf.germ ⊤ (j_D.base q) trivial ≫ j_D.stalkMap q).hom
                (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ p_Ω.appTop).hom c)) := rfl
        have hgerm_st : Y_Ω.presheaf.germ ⊤ (j_D.base q) trivial ≫ j_D.stalkMap q =
            j_D.appTop ≫ (AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.germ ⊤ q trivial :=
          AlgebraicGeometry.Scheme.Hom.germ_stalkMap j_D ⊤ q trivial
        rw [he_st_eq, hgerm_st]
        have happTop : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            p_Ω.appTop ≫ j_D.appTop =
            CommRingCat.ofHom (algebraMap Ω D) ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of D)).inv := by
          have hcomp_app : p_Ω.appTop ≫ j_D.appTop = (j_D ≫ p_Ω).appTop :=
            (AlgebraicGeometry.Scheme.Hom.comp_app j_D p_Ω ⊤).symm
          rw [hcomp_app, hj_comm, AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality]
        have h1 : (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ p_Ω.appTop) ≫
            j_D.appTop ≫ (AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.germ ⊤ q trivial).hom c =
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of D)).inv ≫
              (AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.germ ⊤ q trivial).hom
                (algebraMap Ω D c) := by
          have hassoc : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ p_Ω.appTop) ≫
              j_D.appTop ≫ (AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.germ ⊤ q trivial =
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ p_Ω.appTop ≫ j_D.appTop) ≫
                (AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.germ ⊤ q trivial := by
            simp only [CategoryTheory.Category.assoc]
          rw [hassoc, happTop, CategoryTheory.Category.assoc]
          rfl
        change (AlgebraicGeometry.StructureSheaf.stalkIso D q).symm
          ((((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ p_Ω.appTop) ≫
            j_D.appTop ≫ (AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.germ ⊤ q trivial).hom c) = _
        rw [h1]
        have htoStalk : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of D)).inv ≫
            (AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.germ ⊤ q trivial).hom
              (algebraMap Ω D c) =
            (AlgebraicGeometry.StructureSheaf.toStalk D q).hom (algebraMap Ω D c) := by
          rw [AlgebraicGeometry.Scheme.ΓSpecIso_inv]
          rfl
        rw [htoStalk]
        exact ((AlgebraicGeometry.StructureSheaf.stalkIso D q).symm.commutes (algebraMap Ω D c)).trans
          (IsScalarTower.algebraMap_apply Ω D (Localization.AtPrime q.asIdeal) c).symm

      constructor
      · intro hUniv i x₀ hx₀
        have hChart_i := hUniv (D_ch i) (j_Ω i) (hj_Ω_open i) (hj_Ω_comm i)
        exact (hLocalArtin (fun ν => MvPolynomial.map φ (f i ν)) (D_ch i)
          ((e_Ω i).symm.toAlgHom.comp (Ideal.Quotient.mkₐ Ω _))
          (hπ_Di i).1 (hπ_Di i).2).mp hChart_i x₀ hx₀

      · intro hPoly D _ _ j_D hj_D_open hj_D_comm q hq_max
        obtain ⟨i, q₀, hq₀_eq⟩ := hCover_YΩ (j_D.base q)
        obtain ⟨e_st0, he_st0⟩ := hStalkChartIso (D_ch i) (j_Ω i) (hj_Ω_open i) (hj_Ω_comm i) q₀
        obtain ⟨e_stD, he_stD⟩ := hStalkChartIso D j_D hj_D_open hj_D_comm q
        let iso_congr_st := Y_Ω.presheaf.stalkCongr (Inseparable.of_eq hq₀_eq)
        let e_congr_ring : ↑(Y_Ω.presheaf.stalk ((j_Ω i).base q₀)) ≃+*
            ↑(Y_Ω.presheaf.stalk (j_D.base q)) :=
          { toFun := iso_congr_st.hom.hom
            invFun := iso_congr_st.inv.hom
            left_inv := fun x => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom iso_congr_st.hom_inv_id) x
            right_inv := fun x => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom iso_congr_st.inv_hom_id) x
            map_mul' := map_mul iso_congr_st.hom.hom
            map_add' := map_add iso_congr_st.hom.hom }
        let L₀ := Localization.AtPrime q₀.asIdeal
        let L := Localization.AtPrime q.asIdeal
        let e_L_ring : L₀ ≃+* L := e_st0.symm.trans (e_congr_ring.trans e_stD)
        let e_L : L₀ ≃ₐ[Ω] L :=
          { e_L_ring with
            commutes' := fun c => by
              change e_stD (e_congr_ring (e_st0.symm (algebraMap Ω L₀ c))) = algebraMap Ω L c
              rw [← he_st0 c, e_st0.symm_apply_apply]
              change e_stD (iso_congr_st.hom.hom (stalkAlgElem ((j_Ω i).base q₀) c)) = _
              rw [hStalkCongrElem hq₀_eq c, he_stD c] }

        have _ : AlgebraicGeometry.LocallyOfFiniteType g := inferInstance
        have _ : AlgebraicGeometry.LocallyOfFiniteType p_Ω := inferInstance
        have _ : AlgebraicGeometry.IsOpenImmersion j_D := hj_D_open
        have _ : AlgebraicGeometry.LocallyOfFiniteType j_D := inferInstance
        have hLFT_comp : AlgebraicGeometry.LocallyOfFiniteType (j_D ≫ p_Ω) := inferInstance
        rw [hj_D_comm] at hLFT_comp
        have hFT_D_hom : RingHom.FiniteType (algebraMap Ω D) :=
          (@AlgebraicGeometry.HasRingHomProperty.Spec_iff
            (@AlgebraicGeometry.LocallyOfFiniteType)
            (fun {R S : Type u} [CommRing R] [CommRing S] => RingHom.FiniteType)
            inferInstance
            _ _ (CommRingCat.ofHom (algebraMap Ω D))).mp hLFT_comp
        have hFT_D : Algebra.FiniteType Ω D := (RingHom.finiteType_algebraMap).mp hFT_D_hom
        rcases hFT_D with ⟨⟨t_D, ht_D⟩⟩
        let π_D : MvPolynomial ↥t_D Ω →ₐ[Ω] D := MvPolynomial.aeval Subtype.val
        have hπ_D_surj : Function.Surjective π_D := by
          intro d
          have hd_adjoin : d ∈ Algebra.adjoin Ω (↑t_D : Set D) := by rw [ht_D]; trivial
          refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hd_adjoin
          · intro y hy
            exact ⟨MvPolynomial.X ⟨y, hy⟩, by simp [π_D]⟩
          · intro c
            exact ⟨MvPolynomial.C c, by simp [π_D]⟩
          · rintro a b _ _ ⟨pa, rfl⟩ ⟨pb, rfl⟩
            exact ⟨pa + pb, map_add π_D pa pb⟩
          · rintro a b _ _ ⟨pa, rfl⟩ ⟨pb, rfl⟩
            exact ⟨pa * pb, map_mul π_D pa pb⟩
        haveI : q.asIdeal.IsMaximal := hq_max
        have hM_D_max : (Ideal.comap π_D.toRingHom q.asIdeal).IsMaximal :=
          Ideal.comap_isMaximal_of_surjective π_D.toRingHom hπ_D_surj
        obtain ⟨x_D, hx_D_van⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hM_D_max
        have hM_D_ker : Ideal.comap π_D.toRingHom q.asIdeal =
            RingHom.ker (MvPolynomial.aeval x_D).toRingHom := by
          rw [hx_D_van]
          ext p
          exact MvPolynomial.mem_vanishingIdeal_singleton_iff x_D p
        let sec_D : D → MvPolynomial ↥t_D Ω := Function.surjInv hπ_D_surj
        have hsec_D : ∀ d : D, π_D (sec_D d) = d := Function.surjInv_eq hπ_D_surj
        have hevD_well : ∀ p₁ p₂ : MvPolynomial ↥t_D Ω, π_D p₁ = π_D p₂ →
            MvPolynomial.aeval x_D p₁ = MvPolynomial.aeval x_D p₂ := by
          intro p₁ p₂ hEq
          have hdiff : p₁ - p₂ ∈ RingHom.ker (MvPolynomial.aeval x_D).toRingHom := by
            rw [← hM_D_ker, Ideal.mem_comap]
            change π_D (p₁ - p₂) ∈ q.asIdeal
            rw [map_sub, hEq, sub_self]
            exact zero_mem _
          change MvPolynomial.aeval x_D (p₁ - p₂) = 0 at hdiff
          rwa [map_sub, sub_eq_zero] at hdiff
        let ev_D : D →+* Ω :=
          { toFun := fun d => MvPolynomial.aeval x_D (sec_D d)
            map_one' := by rw [hevD_well (sec_D 1) 1 (by rw [hsec_D, map_one]), map_one]
            map_mul' := fun x y => by
              rw [hevD_well (sec_D (x * y)) (sec_D x * sec_D y)
                (by rw [hsec_D, map_mul, hsec_D, hsec_D]), map_mul]
            map_zero' := by rw [hevD_well (sec_D 0) 0 (by rw [hsec_D, map_zero]), map_zero]
            map_add' := fun x y => by
              rw [hevD_well (sec_D (x + y)) (sec_D x + sec_D y)
                (by rw [hsec_D, map_add, hsec_D, hsec_D]), map_add] }
        have hevD_π : ∀ p : MvPolynomial ↥t_D Ω, ev_D (π_D p) = MvPolynomial.aeval x_D p :=
          fun p => hevD_well (sec_D (π_D p)) p (hsec_D (π_D p))
        have hevD_alg : ∀ c : Ω, ev_D (algebraMap Ω D c) = c := by
          intro c
          rw [← π_D.commutes c, hevD_π]
          exact (MvPolynomial.aeval x_D).commutes c
        have hevD_ker : RingHom.ker ev_D = q.asIdeal := by
          ext d
          rw [← hsec_D d, RingHom.mem_ker, hevD_π]
          change sec_D d ∈ RingHom.ker (MvPolynomial.aeval x_D).toRingHom ↔ _
          rw [← hM_D_ker, Ideal.mem_comap]
          rfl
        have hevD_units : ∀ s : q.asIdeal.primeCompl, IsUnit (ev_D s.1) := by
          intro s
          apply Ne.isUnit
          intro h0
          have hmem : s.1 ∈ RingHom.ker ev_D := h0
          rw [hevD_ker] at hmem
          exact s.2 hmem
        let ev_L : L →+* Ω := IsLocalization.lift hevD_units
        have hevL_alg : ∀ c : Ω, ev_L (algebraMap Ω L c) = c := by
          intro c
          rw [IsScalarTower.algebraMap_apply Ω D L c, IsLocalization.lift_eq hevD_units, hevD_alg]
        have hevL_ker : RingHom.ker ev_L = IsLocalRing.maximalIdeal L := by
          apply ((IsLocalRing.maximalIdeal.isMaximal L).eq_of_le
            (RingHom.ker_isMaximal_of_surjective ev_L
              (fun c => ⟨algebraMap Ω L c, hevL_alg c⟩)).ne_top ?_).symm
          rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q.asIdeal L, Ideal.map_le_iff_le_comap]
          intro d hd
          rw [Ideal.mem_comap, RingHom.mem_ker, IsLocalization.lift_eq hevD_units, ← RingHom.mem_ker,
            hevD_ker]
          exact hd
        let ev_0 : D_ch i →+* Ω := (ev_L.comp e_L.toRingHom).comp (algebraMap (D_ch i) L₀)
        have hev0_surj : Function.Surjective ev_0 := by
          intro c
          refine ⟨algebraMap Ω (D_ch i) c, ?_⟩
          change ev_L (e_L (algebraMap (D_ch i) L₀ (algebraMap Ω (D_ch i) c))) = c
          rw [← IsScalarTower.algebraMap_apply Ω (D_ch i) L₀ c, e_L.commutes, hevL_alg]
        have hev0_ker : RingHom.ker ev_0 = q₀.asIdeal := by
          have hmax_map : ∀ z : L₀, e_L z ∈ IsLocalRing.maximalIdeal L ↔
              z ∈ IsLocalRing.maximalIdeal L₀ := by
            intro z
            simp only [IsLocalRing.mem_maximalIdeal]
            exact ⟨fun h hu => h (hu.map e_L.toRingHom),
                   fun h hu => h (by simpa using hu.map e_L.symm.toRingHom)⟩
          ext x
          change ev_L (e_L (algebraMap (D_ch i) L₀ x)) = 0 ↔ x ∈ q₀.asIdeal
          rw [← RingHom.mem_ker, hevL_ker, hmax_map, ← Ideal.mem_comap]
          have hcom := IsLocalization.AtPrime.comap_maximalIdeal L₀ q₀.asIdeal
          exact Iff.of_eq (congrArg (fun J : Ideal (D_ch i) => x ∈ J) hcom)
        have hq₀_max : q₀.asIdeal.IsMaximal := by
          rw [← hev0_ker]
          exact RingHom.ker_isMaximal_of_surjective ev_0 hev0_surj

        have hArtin_L₀ := (hLocalArtin (fun ν => MvPolynomial.map φ (f i ν)) (D_ch i)
          ((e_Ω i).symm.toAlgHom.comp (Ideal.Quotient.mkₐ Ω _))
          (hπ_Di i).1 (hπ_Di i).2).mpr (hPoly i) q₀ hq₀_max
        let 𝔪₀ : Ideal L₀ := IsLocalRing.maximalIdeal L₀
        let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
        have he_m : ∀ z : L₀, e_L z ∈ 𝔪 ↔ z ∈ 𝔪₀ := by
          intro z
          simp only [𝔪, 𝔪₀, IsLocalRing.mem_maximalIdeal]
          exact ⟨fun h hu => h (hu.map e_L.toRingHom),
                 fun h hu => h (by simpa using hu.map e_L.symm.toRingHom)⟩
        have he_pow : ∀ (k : ℕ) (z : L₀), e_L z ∈ 𝔪 ^ k ↔ z ∈ 𝔪₀ ^ k := by
          intro k
          have hFwd : ∀ (j : ℕ) (z : L₀), z ∈ 𝔪₀ ^ j → e_L z ∈ 𝔪 ^ j := by
            intro j
            induction j with
            | zero => intro _ _; rw [pow_zero, Ideal.one_eq_top]; trivial
            | succ j ih =>
              intro z hz
              rw [pow_succ] at hz ⊢
              refine Submodule.mul_induction_on hz ?_ ?_
              · intro a ha b hb
                rw [map_mul]
                exact Ideal.mul_mem_mul (ih a ha) ((he_m b).mpr hb)
              · intro a b ha hb
                rw [map_add]
                exact add_mem ha hb
          have hBwd : ∀ (j : ℕ) (w : L), w ∈ 𝔪 ^ j → e_L.symm w ∈ 𝔪₀ ^ j := by
            intro j
            induction j with
            | zero => intro _ _; rw [pow_zero, Ideal.one_eq_top]; trivial
            | succ j ih =>
              intro w hw
              rw [pow_succ] at hw ⊢
              refine Submodule.mul_induction_on hw ?_ ?_
              · intro a ha b hb
                rw [map_mul]
                refine Ideal.mul_mem_mul (ih a ha) ?_
                apply (he_m (e_L.symm b)).mp
                rw [e_L.apply_symm_apply]
                exact hb
              · intro a b ha hb
                rw [map_add]
                exact add_mem ha hb
          intro z
          refine ⟨fun hz => ?_, hFwd k z⟩
          simpa using hBwd k (e_L z) hz

        have hQuotIso : ∀ k : ℕ, Nonempty ((L₀ ⧸ 𝔪₀ ^ k) ≃ₐ[Ω] (L ⧸ 𝔪 ^ k)) := by
          intro k
          let f_fwd : (L₀ ⧸ 𝔪₀ ^ k) →ₐ[Ω] (L ⧸ 𝔪 ^ k) :=
            Ideal.Quotient.liftₐ (𝔪₀ ^ k) ((Ideal.Quotient.mkₐ Ω (𝔪 ^ k)).comp e_L.toAlgHom)
              (fun z hz => Ideal.Quotient.eq_zero_iff_mem.mpr ((he_pow k z).mpr hz))
          let f_bwd : (L ⧸ 𝔪 ^ k) →ₐ[Ω] (L₀ ⧸ 𝔪₀ ^ k) :=
            Ideal.Quotient.liftₐ (𝔪 ^ k) ((Ideal.Quotient.mkₐ Ω (𝔪₀ ^ k)).comp e_L.symm.toAlgHom)
              (fun w hw => Ideal.Quotient.eq_zero_iff_mem.mpr
                ((he_pow k (e_L.symm w)).mp (by rw [e_L.apply_symm_apply]; exact hw)))
          refine ⟨AlgEquiv.ofAlgHom f_fwd f_bwd ?_ ?_⟩
          · apply AlgHom.ext; intro q_w; obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective q_w
            change Ideal.Quotient.mk (𝔪 ^ k) (e_L (e_L.symm w)) = Ideal.Quotient.mk (𝔪 ^ k) w
            rw [e_L.apply_symm_apply]
          · apply AlgHom.ext; intro q_z; obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective q_z
            change Ideal.Quotient.mk (𝔪₀ ^ k) (e_L.symm (e_L z)) = Ideal.Quotient.mk (𝔪₀ ^ k) z
            rw [e_L.symm_apply_apply]
        obtain ⟨e_q2⟩ := hQuotIso 2
        obtain ⟨e_q3⟩ := hQuotIso 3
        dsimp only at hArtin_L₀ ⊢
        rcases hArtin_L₀ with h2 | ⟨h3, h5, u₀, v₀, hspan₀, huv₀⟩
        · left
          exact e_q2.symm.toLinearEquiv.finrank_eq.trans h2
        · right
          refine ⟨e_q2.symm.toLinearEquiv.finrank_eq.trans h3,
            e_q3.symm.toLinearEquiv.finrank_eq.trans h5,
            e_L u₀, e_L v₀, ?_, ?_⟩
          · apply le_antisymm
            · rw [Ideal.span_le]
              rintro _ (rfl | rfl)
              · have hu₀_in : u₀ ∈ 𝔪₀ := by
                  change u₀ ∈ IsLocalRing.maximalIdeal L₀
                  rw [← hspan₀]
                  exact Ideal.subset_span (by simp)
                exact (he_m u₀).mpr hu₀_in
              · have hv₀_in : v₀ ∈ 𝔪₀ := by
                  change v₀ ∈ IsLocalRing.maximalIdeal L₀
                  rw [← hspan₀]
                  exact Ideal.subset_span (by simp)
                exact (he_m v₀).mpr hv₀_in
            · intro w hw
              have hz : e_L.symm w ∈ Ideal.span {u₀, v₀} := by
                rw [hspan₀]
                exact (he_m (e_L.symm w)).mp (by rw [e_L.apply_symm_apply]; exact hw)
              obtain ⟨a₀, b₀, hab₀⟩ := Ideal.mem_span_pair.mp hz
              have hw_eq : w = e_L a₀ * e_L u₀ + e_L b₀ * e_L v₀ := by
                have := congrArg e_L hab₀
                simpa [map_add, map_mul] using this.symm
              rw [hw_eq]
              exact Ideal.mem_span_pair.mpr ⟨e_L a₀, e_L b₀, rfl⟩
          · rw [← map_mul]
            exact (he_pow 3 (u₀ * v₀)).mpr huv₀

  
  
  
  have hS3_S4 : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A]
      (K_bar : Type u) [Field K_bar] [IsAlgClosed K_bar]
      (α_A : A →+* K_bar) (_ : Function.Injective α_A),
      (∀ (m t : ℕ) (f : Fin t → MvPolynomial (Fin m) A),
        ¬ _root_.IsReduced
            (MvPolynomial (Fin m) K_bar ⧸
              Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map α_A (f ν)))) →
        ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B)
          (ψ : A →+* B) (ι_B : B →+* K_bar),
          RingHom.FiniteType ψ ∧
          ι_B.comp ψ = α_A ∧
          Function.Injective ι_B ∧
          ∀ (Ω : Type u) [Field Ω] (φ : B →+* Ω),
            ¬ _root_.IsReduced
                (MvPolynomial (Fin m) Ω ⧸
                  Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map (φ.comp ψ) (f ν))))) ∧
      (∀ (m t : ℕ) (f : Fin t → MvPolynomial (Fin m) A)
        (x₀ : Fin m → K_bar),
        (∀ ν : Fin t, MvPolynomial.aeval x₀ (MvPolynomial.map α_A (f ν)) = 0) →
        ¬ (let I_bar : Ideal (MvPolynomial (Fin m) K_bar) :=
             Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map α_A (f ν)))
           let M₀ : Ideal (MvPolynomial (Fin m) K_bar) :=
             RingHom.ker (MvPolynomial.aeval x₀).toRingHom
           Module.finrank K_bar (MvPolynomial (Fin m) K_bar ⧸ (I_bar ⊔ M₀ ^ 2)) = 2 ∨
             (Module.finrank K_bar (MvPolynomial (Fin m) K_bar ⧸ (I_bar ⊔ M₀ ^ 2)) = 3 ∧
              Module.finrank K_bar (MvPolynomial (Fin m) K_bar ⧸ (I_bar ⊔ M₀ ^ 3)) = 5 ∧
              ∃ u v : MvPolynomial (Fin m) K_bar,
                u ∈ M₀ ∧ v ∈ M₀ ∧
                M₀ ≤ I_bar ⊔ M₀ ^ 2 ⊔ Ideal.span {u, v} ∧
                u * v ∈ I_bar ⊔ M₀ ^ 3)) →
        ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B)
          (ψ : A →+* B) (ι_B : B →+* K_bar),
          RingHom.FiniteType ψ ∧
          ι_B.comp ψ = α_A ∧
          Function.Injective ι_B ∧
          ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (φ : B →+* Ω),
            ∃ (x_Ω : Fin m → Ω),
              (∀ ν : Fin t,
                MvPolynomial.aeval x_Ω (MvPolynomial.map (φ.comp ψ) (f ν)) = 0) ∧
              ¬ (let I_Ω : Ideal (MvPolynomial (Fin m) Ω) :=
                   Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map (φ.comp ψ) (f ν)))
                 let M_Ω : Ideal (MvPolynomial (Fin m) Ω) :=
                   RingHom.ker (MvPolynomial.aeval x_Ω).toRingHom
                 Module.finrank Ω (MvPolynomial (Fin m) Ω ⧸ (I_Ω ⊔ M_Ω ^ 2)) = 2 ∨
                   (Module.finrank Ω (MvPolynomial (Fin m) Ω ⧸ (I_Ω ⊔ M_Ω ^ 2)) = 3 ∧
                    Module.finrank Ω (MvPolynomial (Fin m) Ω ⧸ (I_Ω ⊔ M_Ω ^ 3)) = 5 ∧
                    ∃ u v : MvPolynomial (Fin m) Ω,
                      u ∈ M_Ω ∧ v ∈ M_Ω ∧
                      M_Ω ≤ I_Ω ⊔ M_Ω ^ 2 ⊔ Ideal.span {u, v} ∧
                      u * v ∈ I_Ω ⊔ M_Ω ^ 3))) := by
    clear hS2 hS1 hArtinNodal hSec hn τ n hLFP hProp g C
    clear ‹IsNoetherianRing A› ‹IsDomain A› ‹CommRing A› A
    intro A _ _ _ K_bar _ _ α_A hInj
    classical
    let _ : Algebra A K_bar := α_A.toAlgebra
    have _ : IsDomain ↥(⊤ : Subalgebra A K_bar) := inferInstance
    let _ := hInj

    let degMon : ∀ {m : ℕ}, (Fin m →₀ ℕ) → ℕ := fun d => d.sum fun _ n => n
    have hDeg_zero : ∀ {m : ℕ}, degMon (0 : Fin m →₀ ℕ) = 0 := fun {_} => Finsupp.sum_zero_index
    have hDeg_add : ∀ {m : ℕ} (d₁ d₂ : Fin m →₀ ℕ), degMon (d₁ + d₂) = degMon d₁ + degMon d₂ :=
      fun d₁ d₂ => Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl)
    have hDeg_single : ∀ {m : ℕ} (a : Fin m) (n : ℕ), degMon (Finsupp.single a n) = n :=
      fun _ _ => Finsupp.sum_single_index rfl
    have hLe_deg : ∀ {m : ℕ} (d : Fin m →₀ ℕ) (a : Fin m), d a ≤ degMon d := by
      intro m d a
      by_cases ha : a ∈ d.support
      · exact Finset.single_le_sum (fun _ _ => Nat.zero_le _) ha
      · rw [Finsupp.notMem_support_iff.mp ha]
        exact Nat.zero_le _
    have hDeg_pos : ∀ {m : ℕ} {d : Fin m →₀ ℕ}, d ≠ 0 → 1 ≤ degMon d := by
      intro m d hd
      obtain ⟨a, ha⟩ := Finsupp.ne_iff.mp hd
      exact Nat.le_trans (Nat.one_le_iff_ne_zero.mpr ha) (hLe_deg d a)

    let origMax : ∀ (R : Type u) [CommRing R] (m : ℕ), Ideal (MvPolynomial (Fin m) R) :=
      fun R _ m => RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin m) R →+* R)
    have hMem_origMax : ∀ {R : Type u} [CommRing R] {m : ℕ} (P : MvPolynomial (Fin m) R),
        P ∈ origMax R m ↔ P.coeff 0 = 0 := by
      intro R _ m P
      rw [RingHom.mem_ker, MvPolynomial.constantCoeff_eq]
    have hX_mem_origMax : ∀ {R : Type u} [CommRing R] {m : ℕ} (a : Fin m),
        (MvPolynomial.X a : MvPolynomial (Fin m) R) ∈ origMax R m := by
      intro R _ m a
      simp [origMax]
    have hMon_mem_pow : ∀ {R : Type u} [CommRing R] {m : ℕ} (d : Fin m →₀ ℕ) (r : R),
        MvPolynomial.monomial d r ∈ (origMax R m) ^ (degMon d) := by
      intro R _ m d
      refine Finsupp.induction d ?_ ?_
      · intro r
        rw [hDeg_zero, pow_zero, Ideal.one_eq_top]
        trivial
      · intro a n d' _ _ ih r
        rw [hDeg_add, hDeg_single, pow_add]
        have hsplit : MvPolynomial.monomial (Finsupp.single a n + d') r =
            (MvPolynomial.C r * (MvPolynomial.X a) ^ n) * MvPolynomial.monomial d' 1 := by
          rw [MvPolynomial.C_mul_X_pow_eq_monomial, MvPolynomial.monomial_mul, mul_one]
        rw [hsplit]
        exact Ideal.mul_mem_mul
          (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow (hX_mem_origMax a) n))
          (ih 1)
    have hMem_origMax_pow : ∀ {R : Type u} [CommRing R] {m : ℕ} (k : ℕ) (P : MvPolynomial (Fin m) R),
        P ∈ (origMax R m) ^ k ↔ ∀ d : Fin m →₀ ℕ, degMon d < k → P.coeff d = 0 := by
      intro R _ m k
      induction k with
      | zero =>
        intro P
        rw [pow_zero, Ideal.one_eq_top]
        exact ⟨fun _ _ hd => (Nat.not_lt_zero _ hd).elim, fun _ => trivial⟩
      | succ k ih =>
        intro P
        constructor
        · intro hP
          rw [pow_succ] at hP
          refine Submodule.mul_induction_on hP ?_ ?_
          · intro p hp q hq d hd
            rw [MvPolynomial.coeff_mul]
            refine Finset.sum_eq_zero fun x hx => ?_
            have hsum_d : x.1 + x.2 = d := by simpa using hx
            by_cases hx2 : x.2 = 0
            · rw [hx2, (hMem_origMax q).mp hq, mul_zero]
            · have hpos2 : 1 ≤ degMon x.2 := hDeg_pos hx2
              have hdeg1 : degMon x.1 < k := by
                have htot : degMon x.1 + degMon x.2 < k + 1 := by
                  rw [← hDeg_add, hsum_d]
                  exact hd
                omega
              rw [(ih p).mp hp x.1 hdeg1, zero_mul]
          · intro p₁ p₂ hp₁ hp₂ d hd
            rw [MvPolynomial.coeff_add, hp₁ d hd, hp₂ d hd, add_zero]
        · intro hCoeff
          rw [MvPolynomial.as_sum P]
          refine Submodule.sum_mem _ fun d hd => ?_
          have hge : k + 1 ≤ degMon d := by
            by_contra hlt
            exact (MvPolynomial.mem_support_iff.mp hd) (hCoeff d (Nat.lt_of_not_ge hlt))
          exact Ideal.pow_le_pow_right hge (hMon_mem_pow d (P.coeff d))

    let shiftHom : ∀ {R : Type u} [CommRing R] {m : ℕ} (c : Fin m → R),
        MvPolynomial (Fin m) R →ₐ[R] MvPolynomial (Fin m) R :=
      fun c => MvPolynomial.aeval (fun a => MvPolynomial.X a + MvPolynomial.C (c a))
    have hShift_comp : ∀ {R : Type u} [CommRing R] {m : ℕ} (c₁ c₂ : Fin m → R),
        (shiftHom c₁).comp (shiftHom c₂) = shiftHom (c₁ + c₂) := by
      intro R _ m c₁ c₂
      apply MvPolynomial.algHom_ext
      intro a
      simp only [shiftHom, AlgHom.comp_apply, MvPolynomial.aeval_X, map_add, MvPolynomial.aeval_C,
        Algebra.algebraMap_eq_smul_one, Pi.add_apply, MvPolynomial.C_add]
      have hC : ∀ r : R, r • (1 : MvPolynomial (Fin m) R) = MvPolynomial.C r := by
        intro r
        rw [Algebra.smul_def, mul_one]
        rfl
      rw [hC, add_assoc]
    let shiftEquiv : ∀ {R : Type u} [CommRing R] {m : ℕ} (c : Fin m → R),
        MvPolynomial (Fin m) R ≃ₐ[R] MvPolynomial (Fin m) R :=
      fun c => AlgEquiv.ofAlgHom (shiftHom c) (shiftHom (-c))
        (by rw [hShift_comp, add_neg_cancel]; apply MvPolynomial.algHom_ext; intro a; simp [shiftHom])
        (by rw [hShift_comp, neg_add_cancel]; apply MvPolynomial.algHom_ext; intro a; simp [shiftHom])
    have hShift_map : ∀ {R S : Type u} [CommRing R] [CommRing S] {m : ℕ}
        (φ : R →+* S) (c : Fin m → R) (P : MvPolynomial (Fin m) R),
        MvPolynomial.map φ (shiftEquiv c P) = shiftEquiv (φ ∘ c) (MvPolynomial.map φ P) := by
      intro R S _ _ m φ c P
      induction P using MvPolynomial.induction_on with
      | C r =>
        change MvPolynomial.map φ (shiftHom c (MvPolynomial.C r)) =
          shiftHom (φ ∘ c) (MvPolynomial.map φ (MvPolynomial.C r))
        simp [shiftHom]
      | add p q ihp ihq => simp only [map_add, ihp, ihq]
      | mul_X p a ihp =>
        simp only [map_mul, ihp, MvPolynomial.map_X]
        congr 1
        change MvPolynomial.map φ (shiftHom c (MvPolynomial.X a)) =
          shiftHom (φ ∘ c) (MvPolynomial.X a)
        simp [shiftHom]
    have hShift_const : ∀ {R : Type u} [CommRing R] {m : ℕ} (c : Fin m → R) (P : MvPolynomial (Fin m) R),
        MvPolynomial.constantCoeff (shiftEquiv c P) = MvPolynomial.aeval c P := by
      intro R _ m c P
      have hHom : MvPolynomial.constantCoeff.comp (shiftHom c).toRingHom =
          (MvPolynomial.aeval c).toRingHom := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp [shiftHom]
        · intro a; simp [shiftHom]
      exact DFunLike.congr_fun hHom P
    have hShift_mem_ker : ∀ {R : Type u} [CommRing R] {m : ℕ} (c : Fin m → R) (P : MvPolynomial (Fin m) R),
        P ∈ RingHom.ker (MvPolynomial.aeval c).toRingHom ↔ shiftEquiv c P ∈ origMax R m := by
      intro R _ m c P
      change MvPolynomial.aeval c P = 0 ↔ MvPolynomial.constantCoeff (shiftEquiv c P) = 0
      rw [hShift_const]
    have hShift_pow_mem : ∀ {R : Type u} [CommRing R] {m : ℕ} (c : Fin m → R) (k : ℕ)
        (P : MvPolynomial (Fin m) R),
        P ∈ (RingHom.ker (MvPolynomial.aeval c).toRingHom) ^ k ↔
          shiftEquiv c P ∈ (origMax R m) ^ k := by
      intro R _ m c k
      have hFwd : ∀ {R' : Type u} [CommRing R'] (c' : Fin m → R') (j : ℕ)
          (Q : MvPolynomial (Fin m) R'),
          Q ∈ (RingHom.ker (MvPolynomial.aeval c').toRingHom) ^ j →
            shiftEquiv c' Q ∈ (origMax R' m) ^ j := by
        intro R' _ c' j
        induction j with
        | zero => intro _ _; rw [pow_zero, Ideal.one_eq_top]; trivial
        | succ j ih =>
          intro Q hQ
          rw [pow_succ] at hQ ⊢
          refine Submodule.mul_induction_on hQ ?_ ?_
          · intro p hp q hq
            rw [map_mul]
            exact Ideal.mul_mem_mul (ih p hp) ((hShift_mem_ker c' q).mp hq)
          · intro p₁ p₂ hp₁ hp₂
            rw [map_add]
            exact add_mem hp₁ hp₂
      have hBwd : ∀ (j : ℕ) (Q : MvPolynomial (Fin m) R),
          Q ∈ (origMax R m) ^ j →
            (shiftEquiv c).symm Q ∈ (RingHom.ker (MvPolynomial.aeval c).toRingHom) ^ j := by
        intro j
        induction j with
        | zero => intro _ _; rw [pow_zero, Ideal.one_eq_top]; trivial
        | succ j ih =>
          intro Q hQ
          rw [pow_succ] at hQ ⊢
          refine Submodule.mul_induction_on hQ ?_ ?_
          · intro p hp q hq
            rw [map_mul]
            refine Ideal.mul_mem_mul (ih p hp) ?_
            rw [hShift_mem_ker c, (shiftEquiv c).apply_symm_apply]
            exact hq
          · intro p₁ p₂ hp₁ hp₂
            rw [map_add]
            exact add_mem hp₁ hp₂
      intro P
      refine ⟨hFwd c k P, fun h => ?_⟩
      simpa using hBwd k (shiftEquiv c P) h
    have hShift_sup_mem : ∀ {R : Type u} [CommRing R] {m t : ℕ}
        (g_fam : Fin t → MvPolynomial (Fin m) R) (c : Fin m → R) (k : ℕ)
        (P : MvPolynomial (Fin m) R),
        P ∈ Ideal.span (Set.range g_fam) ⊔ (RingHom.ker (MvPolynomial.aeval c).toRingHom) ^ k ↔
          shiftEquiv c P ∈ Ideal.span (Set.range (fun ν => shiftEquiv c (g_fam ν))) ⊔
            (origMax R m) ^ k := by
      intro R _ m t g_fam c k P
      constructor
      · intro hP
        rcases Submodule.mem_sup.mp hP with ⟨p₁, hp₁, p₂, hp₂, rfl⟩
        rw [map_add]
        refine Submodule.add_mem_sup ?_ ((hShift_pow_mem c k p₂).mp hp₂)
        obtain ⟨H, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hp₁
        simp only [map_sum, map_mul]
        exact Submodule.sum_mem _ fun ν _ =>
          Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_range_self ν))
      · intro hP
        rcases Submodule.mem_sup.mp hP with ⟨q₁, hq₁, q₂, hq₂, hEq⟩
        have hP_eq : P = (shiftEquiv c).symm q₁ + (shiftEquiv c).symm q₂ := by
          apply (shiftEquiv c).injective
          rw [← hEq, map_add, (shiftEquiv c).apply_symm_apply, (shiftEquiv c).apply_symm_apply]
        rw [hP_eq]
        refine Submodule.add_mem_sup ?_ ?_
        · obtain ⟨H, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hq₁
          simp only [map_sum, map_mul, (shiftEquiv c).symm_apply_apply]
          exact Submodule.sum_mem _ fun ν _ =>
            Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_range_self ν))
        · rw [hShift_pow_mem c k]
          simpa using hq₂
    have hShift_quotEquiv : ∀ {F : Type u} [Field F] {m t : ℕ}
        (g_fam : Fin t → MvPolynomial (Fin m) F) (c : Fin m → F) (k : ℕ),
        Nonempty
          ((MvPolynomial (Fin m) F ⧸
              (Ideal.span (Set.range g_fam) ⊔ (RingHom.ker (MvPolynomial.aeval c).toRingHom) ^ k)) ≃ₐ[F]
            (MvPolynomial (Fin m) F ⧸
              (Ideal.span (Set.range (fun ν => shiftEquiv c (g_fam ν))) ⊔ (origMax F m) ^ k))) := by
      intro F _ m t g_fam c k
      let J₁ := Ideal.span (Set.range g_fam) ⊔ (RingHom.ker (MvPolynomial.aeval c).toRingHom) ^ k
      let J₂ := Ideal.span (Set.range (fun ν => shiftEquiv c (g_fam ν))) ⊔ (origMax F m) ^ k
      let φ_fwd : (MvPolynomial (Fin m) F ⧸ J₁) →ₐ[F] (MvPolynomial (Fin m) F ⧸ J₂) :=
        Ideal.Quotient.liftₐ J₁ ((Ideal.Quotient.mkₐ F J₂).comp (shiftEquiv c).toAlgHom)
          (fun P hP => Ideal.Quotient.eq_zero_iff_mem.mpr ((hShift_sup_mem g_fam c k P).mp hP))
      let φ_bwd : (MvPolynomial (Fin m) F ⧸ J₂) →ₐ[F] (MvPolynomial (Fin m) F ⧸ J₁) :=
        Ideal.Quotient.liftₐ J₂ ((Ideal.Quotient.mkₐ F J₁).comp (shiftEquiv c).symm.toAlgHom)
          (fun Q hQ => Ideal.Quotient.eq_zero_iff_mem.mpr (by
            rw [hShift_sup_mem g_fam c k]
            simpa using hQ))
      refine ⟨AlgEquiv.ofAlgHom φ_fwd φ_bwd ?_ ?_⟩
      · apply AlgHom.ext
        intro z
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective z
        change Ideal.Quotient.mk J₂ (shiftEquiv c ((shiftEquiv c).symm P)) = Ideal.Quotient.mk J₂ P
        rw [(shiftEquiv c).apply_symm_apply]
      · apply AlgHom.ext
        intro z
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective z
        change Ideal.Quotient.mk J₁ ((shiftEquiv c).symm (shiftEquiv c P)) = Ideal.Quotient.mk J₁ P
        rw [(shiftEquiv c).symm_apply_apply]

    let MonLt : ℕ → ℕ → Type := fun m k => {d : Fin m →₀ ℕ // degMon d < k}
    have hFin_MonLt : ∀ (m k : ℕ), Finite (MonLt m k) := by
      intro m k
      refine Finite.of_injective
        (fun d : MonLt m k => fun a : Fin m =>
          (⟨d.1 a, Nat.lt_succ_of_le (Nat.le_trans (hLe_deg d.1 a) (Nat.le_of_lt d.2))⟩ : Fin (k + 1))) ?_
      intro d₁ d₂ hEq
      apply Subtype.ext
      ext a
      exact Fin.mk.inj_iff.mp (congrFun hEq a)
    let instFintypeMonLt : ∀ (m k : ℕ), Fintype (MonLt m k) :=
      fun m k => @Fintype.ofFinite _ (hFin_MonLt m k)

    let truncLin : ∀ (R : Type u) [CommRing R] (m k : ℕ),
        MvPolynomial (Fin m) R →ₗ[R] (MonLt m k → R) :=
      fun R _ m k =>
        { toFun := fun P d => P.coeff d.1
          map_add' := fun P Q => by ext d; exact MvPolynomial.coeff_add d.1 P Q
          map_smul' := fun r P => by ext d; simp [MvPolynomial.coeff_smul] }
    have hTrunc_surj : ∀ {R : Type u} [CommRing R] {m k : ℕ},
        Function.Surjective (truncLin R m k) := by
      intro R _ m k v
      letI := instFintypeMonLt m k
      refine ⟨∑ d : MonLt m k, MvPolynomial.monomial d.1 (v d), ?_⟩
      ext d₀
      change (∑ d : MonLt m k, MvPolynomial.monomial d.1 (v d)).coeff d₀.1 = v d₀
      rw [MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      rw [Finset.sum_eq_single d₀]
      · simp
      · intro d _ hne
        have hd_ne : d.1 ≠ d₀.1 := fun h => hne (Subtype.ext h)
        simp [hd_ne]
      · intro hd₀
        exact (hd₀ (Finset.mem_univ d₀)).elim
    have hTrunc_sup_iff : ∀ {F : Type u} [Field F] {m k t : ℕ} (hk : 1 ≤ k)
        (g_tilde : Fin t → MvPolynomial (Fin m) F) (P : MvPolynomial (Fin m) F),
        P ∈ Ideal.span (Set.range g_tilde) ⊔ (origMax F m) ^ k ↔
          truncLin F m k P ∈ Submodule.span F
            (Set.range (fun p : MonLt m k × Fin t =>
              truncLin F m k (MvPolynomial.monomial p.1.1 1 * g_tilde p.2))) := by
      intro F _ m k t hk g_tilde P
      let W_k := Submodule.span F
        (Set.range (fun p : MonLt m k × Fin t =>
          truncLin F m k (MvPolynomial.monomial p.1.1 1 * g_tilde p.2)))
      constructor
      · intro hP
        rcases Submodule.mem_sup.mp hP with ⟨p₁, hp₁, p₂, hp₂, rfl⟩
        rw [map_add]
        have hp₂_zero : truncLin F m k p₂ = 0 := by
          ext d
          exact (hMem_origMax_pow k p₂).mp hp₂ d.1 d.2
        rw [hp₂_zero, add_zero]
        obtain ⟨H, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hp₁
        rw [map_sum]
        refine Submodule.sum_mem W_k fun ν _ => ?_
        rw [MvPolynomial.as_sum (H ν), Finset.sum_mul, map_sum]
        refine Submodule.sum_mem W_k fun d _ => ?_
        by_cases hd : degMon d < k
        · have hsmul : MvPolynomial.monomial d ((H ν).coeff d) * g_tilde ν =
              ((H ν).coeff d) • (MvPolynomial.monomial d 1 * g_tilde ν) := by
            rw [ ← smul_mul_assoc, MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
          rw [hsmul, map_smul]
          exact Submodule.smul_mem W_k _ (Submodule.subset_span ⟨(⟨d, hd⟩, ν), rfl⟩)
        · have hmem_pow : MvPolynomial.monomial d ((H ν).coeff d) * g_tilde ν ∈ (origMax F m) ^ k :=
            Ideal.mul_mem_right _ _
              (Ideal.pow_le_pow_right (Nat.le_of_not_lt hd) (hMon_mem_pow d ((H ν).coeff d)))
          have hzero : truncLin F m k (MvPolynomial.monomial d ((H ν).coeff d) * g_tilde ν) = 0 := by
            ext d'
            exact (hMem_origMax_pow k _).mp hmem_pow d'.1 d'.2
          rw [hzero]
          exact zero_mem W_k
      · intro hMemW
        have hSub_img : W_k ≤ Submodule.map (truncLin F m k)
            ((Ideal.span (Set.range g_tilde) ⊔ (origMax F m) ^ k).restrictScalars F) := by
          refine Submodule.span_le.mpr ?_
          rintro _ ⟨p, rfl⟩
          exact ⟨MvPolynomial.monomial p.1.1 1 * g_tilde p.2,
            Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨p.2, rfl⟩)), rfl⟩
        obtain ⟨Q, hQ_mem, hQ_eq⟩ := hSub_img hMemW
        have hDiff_pow : P - Q ∈ (origMax F m) ^ k := by
          rw [hMem_origMax_pow]
          intro d hd
          have hsub : truncLin F m k (P - Q) ⟨d, hd⟩ = 0 := by
            rw [map_sub, hQ_eq, sub_self]
            rfl
          simpa [truncLin, MvPolynomial.coeff_sub, sub_eq_zero] using hsub
        have hP_eq : P = Q + (P - Q) := (add_sub_cancel Q P).symm
        rw [hP_eq]
        exact add_mem hQ_mem (Ideal.mem_sup_right hDiff_pow)
    have hQuot_truncEquiv : ∀ {F : Type u} [Field F] {m k t : ℕ} (hk : 1 ≤ k)
        (g_tilde : Fin t → MvPolynomial (Fin m) F),
        Nonempty
          ((MvPolynomial (Fin m) F ⧸
              (Ideal.span (Set.range g_tilde) ⊔ (origMax F m) ^ k)) ≃ₗ[F]
            ((MonLt m k → F) ⧸ Submodule.span F
              (Set.range (fun p : MonLt m k × Fin t =>
                truncLin F m k (MvPolynomial.monomial p.1.1 1 * g_tilde p.2))))) := by
      intro F _ m k t hk g_tilde
      let J_k : Submodule F (MvPolynomial (Fin m) F) :=
        (Ideal.span (Set.range g_tilde) ⊔ (origMax F m) ^ k).restrictScalars F
      let W_k := Submodule.span F
        (Set.range (fun p : MonLt m k × Fin t =>
          truncLin F m k (MvPolynomial.monomial p.1.1 1 * g_tilde p.2)))
      let φ_map : (MvPolynomial (Fin m) F ⧸ J_k) →ₗ[F] ((MonLt m k → F) ⧸ W_k) :=
        Submodule.liftQ J_k (W_k.mkQ.comp (truncLin F m k)) (by
          intro P hP
          simp only [LinearMap.mem_ker, LinearMap.comp_apply, Submodule.mkQ_apply,
            Submodule.Quotient.mk_eq_zero]
          exact (hTrunc_sup_iff hk g_tilde P).mp hP)
      refine ⟨LinearEquiv.ofBijective φ_map ⟨?_, ?_⟩⟩
      · rw [← LinearMap.ker_eq_bot, eq_bot_iff]
        intro z hz
        obtain ⟨P, rfl⟩ := Submodule.Quotient.mk_surjective J_k z
        change W_k.mkQ (truncLin F m k P) = 0 at hz
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hz
        exact (Submodule.Quotient.mk_eq_zero J_k).mpr ((hTrunc_sup_iff hk g_tilde P).mpr hz)
      · intro y
        obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective W_k y
        obtain ⟨P, hP⟩ := hTrunc_surj v
        refine ⟨Submodule.Quotient.mk P, ?_⟩
        change W_k.mkQ (truncLin F m k P) = Submodule.Quotient.mk v
        rw [hP]
        rfl

    let liftPolySub : ∀ {m : ℕ} (S : Subalgebra A K_bar) (P : MvPolynomial (Fin m) K_bar),
        (∀ d ∈ P.support, P.coeff d ∈ S) → MvPolynomial (Fin m) ↥S :=
      fun S P hMem => ∑ d ∈ P.support.attach, MvPolynomial.monomial d.1 ⟨P.coeff d.1, hMem d.1 d.2⟩
    have hMap_liftPolySub : ∀ {m : ℕ} (S : Subalgebra A K_bar) (P : MvPolynomial (Fin m) K_bar)
        (hMem : ∀ d ∈ P.support, P.coeff d ∈ S),
        MvPolynomial.map S.val.toRingHom (liftPolySub S P hMem) = P := by
      intro m S P hMem
      simp only [liftPolySub, map_sum, MvPolynomial.map_monomial]
      have hval : ∀ d : {x // x ∈ P.support},
          S.val.toRingHom ⟨P.coeff d.1, hMem d.1 d.2⟩ = P.coeff d.1 := fun _ => rfl
      simp only [hval]
      rw [Finset.sum_attach P.support (fun d => MvPolynomial.monomial d (P.coeff d))]
      exact (MvPolynomial.as_sum P).symm

    constructor
    · intro m t f hNotRed
      let I_bar : Ideal (MvPolynomial (Fin m) K_bar) :=
        Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map α_A (f ν)))
      let D_bar := MvPolynomial (Fin m) K_bar ⧸ I_bar
      rw [isReduced_iff] at hNotRed
      have hExNil : ∃ ε_bar : D_bar, IsNilpotent ε_bar ∧ ε_bar ≠ 0 := by
        by_contra hAll
        apply hNotRed
        intro x hx
        by_contra hx0
        exact hAll ⟨x, hx, hx0⟩
      obtain ⟨ε_bar, ⟨N, hεN⟩, hε_ne⟩ := hExNil
      obtain ⟨P_bar, rfl⟩ := Ideal.Quotient.mk_surjective ε_bar
      have hPN_mem : P_bar ^ N ∈ I_bar := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_pow]
        exact hεN
      obtain ⟨G_bar, hG_bar⟩ := Ideal.mem_span_range_iff_exists_fun.mp hPN_mem

      let J_ann : Ideal D_bar :=
        { carrier := {q : D_bar | q * Ideal.Quotient.mk I_bar P_bar = 0}
          add_mem' := fun {a b} ha hb => by change (a + b) * _ = 0; rw [add_mul, ha, hb, add_zero]
          zero_mem' := by change 0 * _ = 0; exact zero_mul _
          smul_mem' := fun c {x} hx => by
            change (c * x) * _ = 0
            rw [mul_assoc, hx, mul_zero] }
      have hJ_ne_top : J_ann ≠ ⊤ := by
        intro hTop
        have h1 : (1 : D_bar) ∈ J_ann := hTop ▸ trivial
        change 1 * Ideal.Quotient.mk I_bar P_bar = 0 at h1
        rw [one_mul] at h1
        exact hε_ne h1
      obtain ⟨𝔪_bar, h𝔪_max, hJ_le⟩ := Ideal.exists_le_maximal J_ann hJ_ne_top
      have _ : 𝔪_bar.IsPrime := h𝔪_max.isPrime
      have _ : IsNoetherianRing D_bar := Ideal.Quotient.isNoetherianRing I_bar
      let L_bar := Localization.AtPrime 𝔪_bar
      have _ : IsNoetherianRing L_bar := IsLocalization.isNoetherianRing 𝔪_bar.primeCompl L_bar inferInstance
      let ε_loc : L_bar := algebraMap D_bar L_bar (Ideal.Quotient.mk I_bar P_bar)
      have hε_loc_ne : ε_loc ≠ 0 := by
        intro h0
        rw [← map_zero (algebraMap D_bar L_bar)] at h0
        obtain ⟨s, hs⟩ := (IsLocalization.eq_iff_exists 𝔪_bar.primeCompl L_bar).mp h0
        simp only [mul_zero] at hs
        exact s.2 (hJ_le hs)
      have hKrull := @Ideal.iInf_pow_eq_bot_of_isLocalRing L_bar _
        (IsLocalRing.maximalIdeal L_bar) _ _ (IsLocalRing.maximalIdeal.isMaximal L_bar).ne_top
      have hEx_k : ∃ k : ℕ, ε_loc ∉ (IsLocalRing.maximalIdeal L_bar) ^ k := by
        by_contra hAll_k
        push_neg at hAll_k
        have hInBot : ε_loc ∈ (⊥ : Ideal L_bar) := by
          rw [← hKrull]
          exact Ideal.mem_iInf.mpr hAll_k
        exact hε_loc_ne (Ideal.mem_bot.mp hInBot)
      obtain ⟨k, hk_not_mem⟩ := hEx_k
      have hk_pos : 1 ≤ k := by
        by_contra hk0
        have hk_eq : k = 0 := Nat.eq_zero_of_not_pos hk0
        subst hk_eq
        exact hk_not_mem (by rw [pow_zero, Ideal.one_eq_top]; trivial)

      let M₀_comap : Ideal (MvPolynomial (Fin m) K_bar) :=
        Ideal.comap (Ideal.Quotient.mk I_bar) 𝔪_bar
      have hM₀_max : M₀_comap.IsMaximal :=
        Ideal.comap_isMaximal_of_surjective (Ideal.Quotient.mk I_bar) Ideal.Quotient.mk_surjective
      obtain ⟨x₀, hx₀_van⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hM₀_max
      let M₀ : Ideal (MvPolynomial (Fin m) K_bar) := RingHom.ker (MvPolynomial.aeval x₀).toRingHom
      have hM₀_eq : M₀_comap = M₀ := by
        rw [hx₀_van]
        ext p
        exact MvPolynomial.mem_vanishingIdeal_singleton_iff x₀ p
      have hP_not_sup : P_bar ∉ I_bar ⊔ M₀ ^ k := by
        intro hInSup
        apply hk_not_mem
        let ρ_L : MvPolynomial (Fin m) K_bar →+* L_bar :=
          (algebraMap D_bar L_bar).comp (Ideal.Quotient.mk I_bar)
        have hMap_sub : Ideal.map ρ_L (I_bar ⊔ M₀ ^ k) ≤ (IsLocalRing.maximalIdeal L_bar) ^ k := by
          rw [Ideal.map_sup, sup_le_iff]
          constructor
          · refine Ideal.map_le_iff_le_comap.mpr fun p hp => ?_
            rw [Ideal.mem_comap]
            change algebraMap D_bar L_bar (Ideal.Quotient.mk I_bar p) ∈ _
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hp, map_zero]
            exact zero_mem _
          · rw [Ideal.map_pow]
            refine pow_le_pow_left' ?_ k
            rw [← hM₀_eq]
            refine Ideal.map_le_iff_le_comap.mpr fun p hp => ?_
            rw [Ideal.mem_comap]
            have hmk_in : Ideal.Quotient.mk I_bar p ∈ 𝔪_bar := hp
            rw [← IsLocalization.AtPrime.map_eq_maximalIdeal 𝔪_bar L_bar]
            exact Ideal.mem_map_of_mem (algebraMap D_bar L_bar) hmk_in
        exact hMap_sub (Ideal.mem_map_of_mem ρ_L hInSup)

      let P_tilde_bar := shiftEquiv x₀ P_bar
      let f_tilde_bar : Fin t → MvPolynomial (Fin m) K_bar :=
        fun ν => shiftEquiv x₀ (MvPolynomial.map α_A (f ν))
      have hP_tilde_not : P_tilde_bar ∉ Ideal.span (Set.range f_tilde_bar) ⊔ (origMax K_bar m) ^ k :=
        fun h => hP_not_sup ((hShift_sup_mem _ x₀ k P_bar).mpr h)
      letI : Fintype (MonLt m k) := instFintypeMonLt m k
      let W_k := Submodule.span K_bar
        (Set.range (fun p : MonLt m k × Fin t =>
          truncLin K_bar m k (MvPolynomial.monomial p.1.1 1 * f_tilde_bar p.2)))
      let v₀ : MonLt m k → K_bar := truncLin K_bar m k P_tilde_bar
      have hv₀_not_W : v₀ ∉ W_k :=
        fun h => hP_tilde_not ((hTrunc_sup_iff hk_pos f_tilde_bar P_tilde_bar).mpr h)
      let Q_W := (MonLt m k → K_bar) ⧸ W_k
      have hmk_v₀_ne : W_k.mkQ v₀ ≠ 0 :=
        fun h0 => hv₀_not_W ((Submodule.Quotient.mk_eq_zero W_k).mp h0)
      let b_QW := Module.Basis.ofVectorSpace K_bar Q_W
      have hRepr_ne : b_QW.repr (W_k.mkQ v₀) ≠ 0 :=
        fun h => hmk_v₀_ne (b_QW.repr.injective (by simpa using h))
      obtain ⟨b_star, hb_star⟩ := Finsupp.ne_iff.mp hRepr_ne
      let c_star : K_bar := b_QW.repr (W_k.mkQ v₀) b_star
      have hc_star_ne : c_star ≠ 0 := hb_star
      let ℓ_bar : (MonLt m k → K_bar) →ₗ[K_bar] K_bar :=
        c_star⁻¹ • (((Finsupp.lapply b_star).comp b_QW.repr.toLinearMap).comp W_k.mkQ)
      have hℓ_v₀ : ℓ_bar v₀ = 1 := by
        change c_star⁻¹ * c_star = 1
        exact inv_mul_cancel₀ hc_star_ne
      have hℓ_W : ∀ w ∈ W_k, ℓ_bar w = 0 := by
        intro w hw
        have hmk0 : W_k.mkQ w = 0 := (Submodule.Quotient.mk_eq_zero W_k).mpr hw
        simp [ℓ_bar, hmk0]
      let lam_bar : MonLt m k → K_bar := fun d => ℓ_bar (Pi.single d 1)
      have hℓ_expand : ∀ v : MonLt m k → K_bar, ∑ d : MonLt m k, v d * lam_bar d = ℓ_bar v := by
        intro v
        have hv_eq : v = ∑ d : MonLt m k, v d • Pi.single d (1 : K_bar) := by
          ext d₀
          rw [Finset.sum_apply, Finset.sum_eq_single d₀]
          · simp
          · intro d _ hd; simp [Pi.single_eq_of_ne (Ne.symm hd)]
          · intro hd₀; exact (hd₀ (Finset.mem_univ d₀)).elim
        conv_rhs => rw [hv_eq]
        rw [map_sum]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [map_smul, smul_eq_mul]

      let S_s3 : Finset K_bar :=
        (Finset.univ.image x₀) ∪
        (P_bar.support.image P_bar.coeff) ∪
        (Finset.univ.biUnion fun ν : Fin t => (G_bar ν).support.image (G_bar ν).coeff) ∪
        (Finset.univ.image lam_bar)
      let B_sub : Subalgebra A K_bar := Algebra.adjoin A (↑S_s3 : Set K_bar)
      let B : Type u := ↥B_sub
      let ψ : A →+* B := algebraMap A B
      let ι_B : B →+* K_bar := B_sub.val.toRingHom
      have hx₀_in : ∀ a : Fin m, x₀ a ∈ B_sub := fun a =>
        Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_left _
          (Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_image_of_mem _ (Finset.mem_univ a))))))
      have hP_in : ∀ d ∈ P_bar.support, P_bar.coeff d ∈ B_sub := fun d hd =>
        Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_left _
          (Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hd)))))
      have hG_in : ∀ (ν : Fin t) (d : Fin m →₀ ℕ), d ∈ (G_bar ν).support → (G_bar ν).coeff d ∈ B_sub :=
        fun ν d hd => Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_left _
          (Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν,
            Finset.mem_image_of_mem _ hd⟩))))
      have hlam_in : ∀ d : MonLt m k, lam_bar d ∈ B_sub := fun d =>
        Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_right _
          (Finset.mem_image_of_mem _ (Finset.mem_univ d))))

      let x_B : Fin m → B := fun a => ⟨x₀ a, hx₀_in a⟩
      let lam_B : MonLt m k → B := fun d => ⟨lam_bar d, hlam_in d⟩
      let P_B : MvPolynomial (Fin m) B := liftPolySub B_sub P_bar hP_in
      let G_B : Fin t → MvPolynomial (Fin m) B := fun ν => liftPolySub B_sub (G_bar ν) (hG_in ν)
      have hMap_PB : MvPolynomial.map ι_B P_B = P_bar := hMap_liftPolySub B_sub P_bar hP_in
      have hMap_GB : ∀ ν : Fin t, MvPolynomial.map ι_B (G_B ν) = G_bar ν :=
        fun ν => hMap_liftPolySub B_sub (G_bar ν) (hG_in ν)
      have hPN_B : P_B ^ N = ∑ ν : Fin t, G_B ν * MvPolynomial.map ψ (f ν) := by
        apply MvPolynomial.map_injective ι_B Subtype.val_injective
        rw [map_pow, hMap_PB, map_sum]
        simp only [map_mul, hMap_GB, MvPolynomial.map_map]
        exact hG_bar.symm
      let P_tilde_B : MvPolynomial (Fin m) B := shiftEquiv x_B P_B
      let f_tilde_B : Fin t → MvPolynomial (Fin m) B := fun ν => shiftEquiv x_B (MvPolynomial.map ψ (f ν))
      have hMap_Ptilde : MvPolynomial.map ι_B P_tilde_B = P_tilde_bar := by
        change MvPolynomial.map ι_B (shiftEquiv x_B P_B) = shiftEquiv x₀ P_bar
        rw [hShift_map, hMap_PB]
        rfl
      have hMap_ftilde : ∀ ν : Fin t, MvPolynomial.map ι_B (f_tilde_B ν) = f_tilde_bar ν := by
        intro ν
        change MvPolynomial.map ι_B (shiftEquiv x_B (MvPolynomial.map ψ (f ν))) = _
        rw [hShift_map, MvPolynomial.map_map]
        rfl
      have hId_P : ∑ d : MonLt m k, P_tilde_B.coeff d.1 * lam_B d = 1 := by
        apply Subtype.val_injective
        change ι_B (∑ d : MonLt m k, P_tilde_B.coeff d.1 * lam_B d) = 1
        rw [map_sum]
        have h1 : (∑ d : MonLt m k, ι_B (P_tilde_B.coeff d.1 * lam_B d)) =
            ∑ d : MonLt m k, v₀ d * lam_bar d := by
          refine Finset.sum_congr rfl fun d _ => ?_
          rw [map_mul, ← MvPolynomial.coeff_map, hMap_Ptilde]
          rfl
        rw [h1, hℓ_expand, hℓ_v₀]
      have hId_gen : ∀ (d₀ : MonLt m k) (ν : Fin t),
          ∑ d : MonLt m k, (MvPolynomial.monomial d₀.1 1 * f_tilde_B ν).coeff d.1 * lam_B d = 0 := by
        intro d₀ ν
        apply Subtype.val_injective
        change ι_B (∑ d : MonLt m k, (MvPolynomial.monomial d₀.1 1 * f_tilde_B ν).coeff d.1 * lam_B d) = 0
        rw [map_sum]
        have h1 : (∑ d : MonLt m k, ι_B ((MvPolynomial.monomial d₀.1 1 * f_tilde_B ν).coeff d.1 * lam_B d)) =
            ∑ d : MonLt m k, truncLin K_bar m k (MvPolynomial.monomial d₀.1 1 * f_tilde_bar ν) d * lam_bar d := by
          refine Finset.sum_congr rfl fun d _ => ?_
          rw [map_mul, ← MvPolynomial.coeff_map, map_mul, MvPolynomial.map_monomial, map_one, hMap_ftilde]
          rfl
        rw [h1, hℓ_expand]
        exact hℓ_W _ (Submodule.subset_span ⟨(d₀, ν), rfl⟩)

      refine ⟨B, inferInstance, inferInstance, ψ, ι_B,
        hSubalgFT B_sub (Subalgebra.fg_adjoin_finset S_s3),
        rfl, Subtype.val_injective, ?_⟩
      intro Ω _ φ
      let x_Ω : Fin m → Ω := φ ∘ x_B
      let I_Ω : Ideal (MvPolynomial (Fin m) Ω) :=
        Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map (φ.comp ψ) (f ν)))
      let P_Ω : MvPolynomial (Fin m) Ω := MvPolynomial.map φ P_B
      let Λ_tilde : MvPolynomial (Fin m) Ω →ₗ[Ω] Ω :=
        { toFun := fun Q => ∑ d : MonLt m k, Q.coeff d.1 * φ (lam_B d)
          map_add' := fun Q₁ Q₂ => by
            simp only [MvPolynomial.coeff_add, add_mul, Finset.sum_add_distrib]
          map_smul' := fun c Q => by
            simp only [MvPolynomial.coeff_smul, smul_eq_mul, RingHom.id_apply, mul_assoc, Finset.mul_sum] }
      have hΛ_P : Λ_tilde (shiftEquiv x_Ω P_Ω) = 1 := by
        have hEq : shiftEquiv x_Ω P_Ω = MvPolynomial.map φ P_tilde_B := (hShift_map φ x_B P_B).symm
        rw [hEq]
        change ∑ d : MonLt m k, (MvPolynomial.map φ P_tilde_B).coeff d.1 * φ (lam_B d) = 1
        simp only [MvPolynomial.coeff_map, ← map_mul, ← map_sum, hId_P, map_one]
      have hΛ_I : ∀ Q ∈ I_Ω, Λ_tilde (shiftEquiv x_Ω Q) = 0 := by
        intro Q hQ
        obtain ⟨H, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hQ
        simp only [map_sum, map_mul]
        refine Finset.sum_eq_zero fun ν _ => ?_
        have hf_eq : shiftEquiv x_Ω (MvPolynomial.map (φ.comp ψ) (f ν)) =
            MvPolynomial.map φ (f_tilde_B ν) := by
          rw [← MvPolynomial.map_map, ← hShift_map]
        rw [hf_eq]
        let H_sh := shiftEquiv x_Ω (H ν)
        change Λ_tilde (H_sh * MvPolynomial.map φ (f_tilde_B ν)) = 0
        rw [MvPolynomial.as_sum H_sh, Finset.sum_mul, map_sum]
        refine Finset.sum_eq_zero fun d₀ _ => ?_
        by_cases hd₀ : degMon d₀ < k
        · have hsmul : MvPolynomial.monomial d₀ (H_sh.coeff d₀) * MvPolynomial.map φ (f_tilde_B ν) =
              (H_sh.coeff d₀) • MvPolynomial.map φ (MvPolynomial.monomial d₀ 1 * f_tilde_B ν) := by
            rw [map_mul, MvPolynomial.map_monomial, map_one, ← smul_mul_assoc,
              MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
          rw [hsmul, map_smul]
          have hgen0 : Λ_tilde (MvPolynomial.map φ (MvPolynomial.monomial d₀ 1 * f_tilde_B ν)) = 0 := by
            change ∑ d : MonLt m k,
              (MvPolynomial.map φ (MvPolynomial.monomial d₀ 1 * f_tilde_B ν)).coeff d.1 * φ (lam_B d) = 0
            simp only [MvPolynomial.coeff_map, ← map_mul, ← map_sum, hId_gen ⟨d₀, hd₀⟩ ν, map_zero]
          rw [hgen0, smul_zero]
        · have hmem_pow : MvPolynomial.monomial d₀ (H_sh.coeff d₀) *
              MvPolynomial.map φ (f_tilde_B ν) ∈ (origMax Ω m) ^ k :=
            Ideal.mul_mem_right _ _
              (Ideal.pow_le_pow_right (Nat.le_of_not_lt hd₀) (hMon_mem_pow d₀ (H_sh.coeff d₀)))
          change ∑ d : MonLt m k, _ = 0
          refine Finset.sum_eq_zero fun d _ => ?_
          rw [(hMem_origMax_pow k _).mp hmem_pow d.1 d.2, zero_mul]

      let ε_Ω : MvPolynomial (Fin m) Ω ⧸ I_Ω := Ideal.Quotient.mk I_Ω P_Ω
      have hε_Ω_ne : ε_Ω ≠ 0 := by
        intro h0
        have hzero := hΛ_I P_Ω (Ideal.Quotient.eq_zero_iff_mem.mp h0)
        rw [hΛ_P] at hzero
        exact one_ne_zero hzero
      have hε_Ω_nil : ε_Ω ^ N = 0 := by
        change Ideal.Quotient.mk I_Ω (P_Ω ^ N) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem, ← map_pow, hPN_B, map_sum]
        refine Submodule.sum_mem I_Ω fun ν _ => ?_
        rw [map_mul, MvPolynomial.map_map]
        exact Ideal.mul_mem_left I_Ω _ (Ideal.subset_span ⟨ν, rfl⟩)
      rw [isReduced_iff]
      intro hRed
      exact hε_Ω_ne (hRed ε_Ω ⟨N, hε_Ω_nil⟩)

    · intro m t f x₀ hx₀ hNegArtin
      let I_bar : Ideal (MvPolynomial (Fin m) K_bar) :=
        Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map α_A (f ν)))
      let M₀ : Ideal (MvPolynomial (Fin m) K_bar) := RingHom.ker (MvPolynomial.aeval x₀).toRingHom

      let S₀ : Finset K_bar := Finset.univ.image x₀
      let B₀_sub : Subalgebra A K_bar := Algebra.adjoin A (↑S₀ : Set K_bar)
      have hx₀_B₀ : ∀ a : Fin m, x₀ a ∈ B₀_sub := fun a =>
        Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ a)))
      let x_B₀ : Fin m → ↥B₀_sub := fun a => ⟨x₀ a, hx₀_B₀ a⟩
      let f_tilde_B₀ : Fin t → MvPolynomial (Fin m) ↥B₀_sub :=
        fun ν => shiftEquiv x_B₀ (MvPolynomial.map (algebraMap A ↥B₀_sub) (f ν))
      let f_tilde_bar : Fin t → MvPolynomial (Fin m) K_bar :=
        fun ν => shiftEquiv x₀ (MvPolynomial.map α_A (f ν))
      have hMap_ftilde₀ : ∀ ν : Fin t, MvPolynomial.map B₀_sub.val.toRingHom (f_tilde_B₀ ν) = f_tilde_bar ν := by
        intro ν
        change MvPolynomial.map B₀_sub.val.toRingHom
          (shiftEquiv x_B₀ (MvPolynomial.map (algebraMap A ↥B₀_sub) (f ν))) = _
        rw [hShift_map, MvPolynomial.map_map]
        rfl
      have hConst_ftilde₀ : ∀ ν : Fin t, MvPolynomial.constantCoeff (f_tilde_B₀ ν) = 0 := by
        intro ν
        apply Subtype.val_injective
        change B₀_sub.val.toRingHom (MvPolynomial.constantCoeff (f_tilde_B₀ ν)) = 0
        rw [← MvPolynomial.constantCoeff_map, hMap_ftilde₀, hShift_const]
        exact hx₀ ν
      have hftilde_origMax : ∀ ν : Fin t, f_tilde_bar ν ∈ origMax K_bar m := by
        intro ν
        change MvPolynomial.constantCoeff (f_tilde_bar ν) = 0
        rw [hShift_const]
        exact hx₀ ν

      have hFreezeFinrank : ∀ (k : ℕ) (hk : 1 ≤ k),
          ∃ (S_k : Finset K_bar),
            ∀ (S_ext : Finset K_bar) (hSub : S₀ ∪ S_k ⊆ S_ext),
              let B_ext := Algebra.adjoin A (↑S_ext : Set K_bar)
              ∀ (Ω : Type u) [Field Ω] (φ : ↥B_ext →+* Ω),
                let x_Ω : Fin m → Ω := fun a =>
                  φ ⟨x₀ a, Algebra.adjoin_mono
                    (Finset.coe_subset.mpr (Finset.subset_union_left.trans hSub))
                    (hx₀_B₀ a)⟩
                let I_Ω := Ideal.span (Set.range (fun ν : Fin t =>
                  MvPolynomial.map (φ.comp (algebraMap A ↥B_ext)) (f ν)))
                let M_Ω := RingHom.ker (MvPolynomial.aeval x_Ω).toRingHom
                Module.finrank Ω (MvPolynomial (Fin m) Ω ⧸ (I_Ω ⊔ M_Ω ^ k)) =
                  Module.finrank K_bar (MvPolynomial (Fin m) K_bar ⧸ (I_bar ⊔ M₀ ^ k)) := by
        intro k hk
        letI : Fintype (MonLt m k) := instFintypeMonLt m k
        let P_idx := MonLt m k × Fin t
        let gen_bar : P_idx → (MonLt m k → K_bar) := fun p =>
          truncLin K_bar m k (MvPolynomial.monomial p.1.1 1 * f_tilde_bar p.2)
        let W_bar := Submodule.span K_bar (Set.range gen_bar)
        let Q_bar := (MonLt m k → K_bar) ⧸ W_bar
        obtain ⟨e_sh_bar⟩ := hShift_quotEquiv (fun ν => MvPolynomial.map α_A (f ν)) x₀ k
        obtain ⟨e_tr_bar⟩ := hQuot_truncEquiv hk f_tilde_bar
        have hr_eq : Module.finrank K_bar (MvPolynomial (Fin m) K_bar ⧸ (I_bar ⊔ M₀ ^ k)) =
            Module.finrank K_bar Q_bar :=
          (e_sh_bar.toLinearEquiv.trans e_tr_bar).finrank_eq
        let d_k := Module.finrank K_bar W_bar
        let r_k := Module.finrank K_bar Q_bar
        let bW₀ := Module.Basis.ofVectorSpace K_bar W_bar
        letI : Fintype (Module.Basis.ofVectorSpaceIndex K_bar W_bar) := Fintype.ofFinite _
        have hcard_W : Fintype.card (Module.Basis.ofVectorSpaceIndex K_bar W_bar) = d_k :=
          (Module.finrank_eq_card_basis bW₀).symm
        let bW : Module.Basis (Fin d_k) K_bar W_bar :=
          bW₀.reindex (Fintype.equivFinOfCardEq hcard_W)
        let bQ₀ := Module.Basis.ofVectorSpace K_bar Q_bar
        letI : Fintype (Module.Basis.ofVectorSpaceIndex K_bar Q_bar) := Fintype.ofFinite _
        have hcard_Q : Fintype.card (Module.Basis.ofVectorSpaceIndex K_bar Q_bar) = r_k :=
          (Module.finrank_eq_card_basis bQ₀).symm
        let bQ : Module.Basis (Fin r_k) K_bar Q_bar :=
          bQ₀.reindex (Fintype.equivFinOfCardEq hcard_Q)
        let u_out : Fin r_k → (MonLt m k → K_bar) :=
          fun l => Classical.choose (Submodule.Quotient.mk_surjective W_bar (bQ l))
        have hu_out : ∀ l : Fin r_k, W_bar.mkQ (u_out l) = bQ l :=
          fun l => Classical.choose_spec (Submodule.Quotient.mk_surjective W_bar (bQ l))
        let w_bar : (Fin d_k ⊕ Fin r_k) → (MonLt m k → K_bar) :=
          Sum.elim (fun j => (bW j).1) u_out
        let Φ_bar : ((Fin d_k ⊕ Fin r_k) → K_bar) →ₗ[K_bar] (MonLt m k → K_bar) :=
          { toFun := fun g d => ∑ s : Fin d_k ⊕ Fin r_k, g s * w_bar s d
            map_add' := fun g₁ g₂ => by ext d; simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
            map_smul' := fun c g => by
              ext d
              simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, mul_assoc, Finset.mul_sum] }
        have hΦ_sum : ∀ g : (Fin d_k ⊕ Fin r_k) → K_bar,
            Φ_bar g = (∑ j : Fin d_k, g (Sum.inl j) • (bW j).1) +
              (∑ l : Fin r_k, g (Sum.inr l) • u_out l) := by
          intro g
          ext d
          change ∑ s : Fin d_k ⊕ Fin r_k, g s * w_bar s d = _
          rw [Fintype.sum_sum_type]
          simp [w_bar]
        have hBij_Φ : Function.Bijective Φ_bar := by
          refine ⟨?_, ?_⟩
          · rw [← LinearMap.ker_eq_bot, eq_bot_iff]
            intro g hg
            change Φ_bar g = 0 at hg
            rw [hΦ_sum] at hg
            have hmkQ : W_bar.mkQ ((∑ j : Fin d_k, g (Sum.inl j) • (bW j).1) +
                (∑ l : Fin r_k, g (Sum.inr l) • u_out l)) = 0 := by rw [hg, map_zero]
            rw [map_add, Submodule.mkQ_apply,
              (Submodule.Quotient.mk_eq_zero W_bar).mpr
                (Submodule.sum_mem W_bar fun j _ => Submodule.smul_mem W_bar _ (bW j).2),
              zero_add, map_sum] at hmkQ
            have hmkQ' : ∑ l : Fin r_k, g (Sum.inr l) • bQ l = 0 := by
              simpa only [map_smul, hu_out] using hmkQ
            have hg_inr : ∀ l : Fin r_k, g (Sum.inr l) = 0 :=
              Fintype.linearIndependent_iff.mp bQ.linearIndependent (fun l => g (Sum.inr l)) hmkQ'
            have hsum_out : ∑ l : Fin r_k, g (Sum.inr l) • u_out l = 0 := by
              simp [hg_inr]
            rw [hsum_out, add_zero] at hg
            have hg_W : ∑ j : Fin d_k, g (Sum.inl j) • bW j = 0 := by
              apply Subtype.ext
              simpa only [AddSubmonoidClass.coe_finset_sum, SetLike.val_smul, ZeroMemClass.coe_zero] using hg
            have hg_inl : ∀ j : Fin d_k, g (Sum.inl j) = 0 :=
              Fintype.linearIndependent_iff.mp bW.linearIndependent (fun j => g (Sum.inl j)) hg_W
            ext s
            cases s with
            | inl j => exact hg_inl j
            | inr l => exact hg_inr l
          · intro x
            let c_out := bQ.repr (W_bar.mkQ x)
            have hdiff_W : x - ∑ l : Fin r_k, c_out l • u_out l ∈ W_bar := by
              rw [← Submodule.Quotient.mk_eq_zero, ← Submodule.mkQ_apply, map_sub, map_sum]
              simp only [map_smul, hu_out]
              rw [bQ.sum_repr (W_bar.mkQ x), sub_self]
            let c_in := bW.repr ⟨x - ∑ l : Fin r_k, c_out l • u_out l, hdiff_W⟩
            have hsum_bW : ∑ j : Fin d_k, c_in j • (bW j).1 = x - ∑ l : Fin r_k, c_out l • u_out l := by
              have h1 := bW.sum_repr ⟨x - ∑ l : Fin r_k, c_out l • u_out l, hdiff_W⟩
              have hval := congrArg Subtype.val h1
              simpa only [c_in, AddSubmonoidClass.coe_finset_sum, SetLike.val_smul] using hval
            refine ⟨Sum.elim (fun j => c_in j) (fun l => c_out l), ?_⟩
            rw [hΦ_sum]
            simp only [Sum.elim_inl, Sum.elim_inr, hsum_bW, sub_add_cancel]
        let e_bar := LinearEquiv.ofBijective Φ_bar hBij_Φ
        let ψ_entry : (Fin d_k ⊕ Fin r_k) → MonLt m k → K_bar :=
          fun s d => e_bar.symm (Pi.single d 1) s
        have hInv_right : ∀ (d₁ d₂ : MonLt m k),
            ∑ s : Fin d_k ⊕ Fin r_k, ψ_entry s d₁ * w_bar s d₂ = if d₁ = d₂ then 1 else 0 := by
          intro d₁ d₂
          have h := congrFun (e_bar.apply_symm_apply (Pi.single d₁ 1)) d₂
          change (∑ s : Fin d_k ⊕ Fin r_k, ψ_entry s d₁ * w_bar s d₂) =
            (Pi.single d₁ (1 : K_bar) : MonLt m k → K_bar) d₂ at h
          rw [h]
          simp [Pi.single_apply, eq_comm]
        have hInv_left : ∀ (s₁ s₂ : Fin d_k ⊕ Fin r_k),
            ∑ d : MonLt m k, w_bar s₁ d * ψ_entry s₂ d = if s₁ = s₂ then 1 else 0 := by
          intro s₁ s₂
          let δ_s₁ : (Fin d_k ⊕ Fin r_k) → K_bar := Pi.single s₁ 1
          have hw_eq : Φ_bar δ_s₁ = fun d => w_bar s₁ d := by
            ext d
            change ∑ s : Fin d_k ⊕ Fin r_k, δ_s₁ s * w_bar s d = w_bar s₁ d
            rw [Finset.sum_eq_single s₁]
            · simp [δ_s₁]
            · intro s _ hs; simp [δ_s₁, Pi.single_eq_of_ne hs]
            · intro hs₁; exact (hs₁ (Finset.mem_univ s₁)).elim
          have h := congrFun (e_bar.symm_apply_apply δ_s₁) s₂
          have hlin : e_bar.symm (fun d => w_bar s₁ d) s₂ =
              ∑ d : MonLt m k, w_bar s₁ d * ψ_entry s₂ d := by
            have hv : (fun d => w_bar s₁ d) = ∑ d : MonLt m k, w_bar s₁ d • Pi.single d (1 : K_bar) := by
              ext d₀
              rw [Finset.sum_apply, Finset.sum_eq_single d₀]
              · simp
              · intro d _ hd; simp [Pi.single_eq_of_ne (Ne.symm hd)]
              · intro hd₀; exact (hd₀ (Finset.mem_univ d₀)).elim
            conv_lhs => rw [hv]
            rw [map_sum]
            simp [ψ_entry]
          change e_bar.symm (Φ_bar δ_s₁) s₂ = δ_s₁ s₂ at h
          rw [hw_eq, hlin] at h
          rw [h]
          simp [δ_s₁, Pi.single_apply, eq_comm]

        have hEx_α : ∀ j : Fin d_k, ∃ c : P_idx → K_bar,
            (bW j).1 = ∑ p : P_idx, c p • gen_bar p := by
          intro j
          obtain ⟨c_fs, hc_fs⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp (bW j).2
          refine ⟨fun p => c_fs p, ?_⟩
          rw [← hc_fs]
          exact Finsupp.sum_fintype c_fs (fun i a => a • gen_bar i) (fun i => zero_smul K_bar (gen_bar i))
        choose α_in hα_in using hEx_α
        let β_in : P_idx → Fin d_k → K_bar :=
          fun p j => bW.repr ⟨gen_bar p, Submodule.subset_span ⟨p, rfl⟩⟩ j
        have hβ_in : ∀ p : P_idx, gen_bar p = ∑ j : Fin d_k, β_in p j • (bW j).1 := by
          intro p
          have h1 := bW.sum_repr ⟨gen_bar p, Submodule.subset_span ⟨p, rfl⟩⟩
          have hval := (congrArg Subtype.val h1).symm
          simpa only [β_in, AddSubmonoidClass.coe_finset_sum, SetLike.val_smul] using hval

        let S_k : Finset K_bar :=
          (Finset.univ.biUnion fun s : Fin d_k ⊕ Fin r_k => Finset.univ.image (w_bar s)) ∪
          (Finset.univ.biUnion fun s : Fin d_k ⊕ Fin r_k => Finset.univ.image (ψ_entry s)) ∪
          (Finset.univ.biUnion fun j : Fin d_k => Finset.univ.image (α_in j)) ∪
          (Finset.univ.biUnion fun p : P_idx => Finset.univ.image (β_in p))
        refine ⟨S_k, ?_⟩
        intro S_ext hSub B_ext Ω _ φ
        have hSub₀ : S₀ ⊆ S_ext := Finset.subset_union_left.trans hSub
        have hSub_k : S_k ⊆ S_ext := Finset.subset_union_right.trans hSub
        have hInB : ∀ {z : K_bar}, z ∈ S_k → z ∈ B_ext :=
          fun hz => Algebra.subset_adjoin (Finset.mem_coe.mpr (hSub_k hz))
        let w_B : (Fin d_k ⊕ Fin r_k) → MonLt m k → ↥B_ext := fun s d =>
          ⟨w_bar s d, hInB (Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
            (Finset.mem_biUnion.mpr ⟨s, Finset.mem_univ s, Finset.mem_image_of_mem _ (Finset.mem_univ d)⟩))))⟩
        let ψ_B : (Fin d_k ⊕ Fin r_k) → MonLt m k → ↥B_ext := fun s d =>
          ⟨ψ_entry s d, hInB (Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _
            (Finset.mem_biUnion.mpr ⟨s, Finset.mem_univ s, Finset.mem_image_of_mem _ (Finset.mem_univ d)⟩))))⟩
        let α_B : Fin d_k → P_idx → ↥B_ext := fun j p =>
          ⟨α_in j p, hInB (Finset.mem_union_left _ (Finset.mem_union_right _
            (Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j, Finset.mem_image_of_mem _ (Finset.mem_univ p)⟩)))⟩
        let β_B : P_idx → Fin d_k → ↥B_ext := fun p j =>
          ⟨β_in p j, hInB (Finset.mem_union_right _
            (Finset.mem_biUnion.mpr ⟨p, Finset.mem_univ p, Finset.mem_image_of_mem _ (Finset.mem_univ j)⟩))⟩
        let inc₀_ext : ↥B₀_sub →+* ↥B_ext :=
          (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub₀))).toRingHom
        let x_Ω : Fin m → Ω := fun a => φ (inc₀_ext (x_B₀ a))
        let f_tilde_Ω : Fin t → MvPolynomial (Fin m) Ω :=
          fun ν => shiftEquiv x_Ω (MvPolynomial.map (φ.comp (algebraMap A ↥B_ext)) (f ν))
        have hftilde_Ω_eq : ∀ ν : Fin t, f_tilde_Ω ν = MvPolynomial.map (φ.comp inc₀_ext) (f_tilde_B₀ ν) := by
          intro ν
          change shiftEquiv x_Ω (MvPolynomial.map (φ.comp (algebraMap A ↥B_ext)) (f ν)) =
            MvPolynomial.map (φ.comp inc₀_ext) (shiftEquiv x_B₀ (MvPolynomial.map (algebraMap A ↥B₀_sub) (f ν)))
          rw [hShift_map, MvPolynomial.map_map]
          rfl
        let gen_B : P_idx → MonLt m k → ↥B_ext := fun p d =>
          (MvPolynomial.monomial p.1.1 1 * MvPolynomial.map inc₀_ext (f_tilde_B₀ p.2)).coeff d.1
        have hgen_B_val : ∀ (p : P_idx) (d : MonLt m k), (gen_B p d).1 = gen_bar p d := by
          intro p d
          change B_ext.val.toRingHom ((MvPolynomial.monomial p.1.1 1 *
            MvPolynomial.map inc₀_ext (f_tilde_B₀ p.2)).coeff d.1) = _
          rw [← MvPolynomial.coeff_map, map_mul, MvPolynomial.map_monomial, map_one,
            MvPolynomial.map_map]
          have hcomp_val : B_ext.val.toRingHom.comp inc₀_ext = B₀_sub.val.toRingHom := rfl
          rw [hcomp_val, hMap_ftilde₀]
          rfl
        let gen_Ω : P_idx → (MonLt m k → Ω) := fun p =>
          truncLin Ω m k (MvPolynomial.monomial p.1.1 1 * f_tilde_Ω p.2)
        have hgen_Ω_eq : ∀ (p : P_idx) (d : MonLt m k), gen_Ω p d = φ (gen_B p d) := by
          intro p d
          change (MvPolynomial.monomial p.1.1 (1 : Ω) * f_tilde_Ω p.2).coeff d.1 = _
          rw [hftilde_Ω_eq, ← MvPolynomial.map_map]
          have hmon : (MvPolynomial.monomial p.1.1 (1 : Ω)) =
              MvPolynomial.map φ (MvPolynomial.monomial p.1.1 (1 : ↥B_ext)) := by simp
          rw [hmon, ← map_mul, MvPolynomial.coeff_map]

        let W_Ω := Submodule.span Ω (Set.range gen_Ω)
        let Φ_Ω : ((Fin d_k ⊕ Fin r_k) → Ω) →ₗ[Ω] (MonLt m k → Ω) :=
          { toFun := fun g d => ∑ s : Fin d_k ⊕ Fin r_k, g s * φ (w_B s d)
            map_add' := fun g₁ g₂ => by ext d; simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
            map_smul' := fun c g => by
              ext d
              simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, mul_assoc, Finset.mul_sum] }
        let Ψ_Ω : (MonLt m k → Ω) →ₗ[Ω] ((Fin d_k ⊕ Fin r_k) → Ω) :=
          { toFun := fun x s => ∑ d : MonLt m k, x d * φ (ψ_B s d)
            map_add' := fun x₁ x₂ => by ext s; simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
            map_smul' := fun c x => by
              ext s
              simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, mul_assoc, Finset.mul_sum] }
        have hΦΨ_Ω : ∀ x : MonLt m k → Ω, Φ_Ω (Ψ_Ω x) = x := by
          intro x
          ext d₂
          change ∑ s : Fin d_k ⊕ Fin r_k, (∑ d₁ : MonLt m k, x d₁ * φ (ψ_B s d₁)) * φ (w_B s d₂) = x d₂
          simp only [Finset.sum_mul, mul_assoc]
          rw [Finset.sum_comm]
          have hinner : ∀ d₁ : MonLt m k,
              ∑ s : Fin d_k ⊕ Fin r_k, x d₁ * (φ (ψ_B s d₁) * φ (w_B s d₂)) =
                x d₁ * (if d₁ = d₂ then 1 else 0) := by
            intro d₁
            rw [← Finset.mul_sum]
            congr 1
            have hB : ∑ s : Fin d_k ⊕ Fin r_k, ψ_B s d₁ * w_B s d₂ = if d₁ = d₂ then 1 else 0 := by
              apply Subtype.val_injective
              change B_ext.val.toRingHom (∑ s, ψ_B s d₁ * w_B s d₂) = B_ext.val.toRingHom (if d₁ = d₂ then 1 else 0)
              rw [map_sum]
              have hval : ∀ s : Fin d_k ⊕ Fin r_k,
                  B_ext.val.toRingHom (ψ_B s d₁ * w_B s d₂) = ψ_entry s d₁ * w_bar s d₂ := fun _ => rfl
              simp only [hval]
              rw [hInv_right d₁ d₂]
              split_ifs <;> simp
            simp only [← map_mul, ← map_sum, hB]
            split_ifs <;> simp
          simp only [hinner, mul_ite, mul_one, mul_zero]
          rw [Finset.sum_eq_single d₂]
          · simp
          · intro d₁ _ hne; exact if_neg hne
          · intro hd₂; exact (hd₂ (Finset.mem_univ d₂)).elim
        have hΨΦ_Ω : ∀ g : (Fin d_k ⊕ Fin r_k) → Ω, Ψ_Ω (Φ_Ω g) = g := by
          intro g
          ext s₂
          change ∑ d : MonLt m k, (∑ s₁ : Fin d_k ⊕ Fin r_k, g s₁ * φ (w_B s₁ d)) * φ (ψ_B s₂ d) = g s₂
          simp only [Finset.sum_mul, mul_assoc]
          rw [Finset.sum_comm]
          have hinner : ∀ s₁ : Fin d_k ⊕ Fin r_k,
              ∑ d : MonLt m k, g s₁ * (φ (w_B s₁ d) * φ (ψ_B s₂ d)) =
                g s₁ * (if s₁ = s₂ then 1 else 0) := by
            intro s₁
            rw [← Finset.mul_sum]
            congr 1
            have hB : ∑ d : MonLt m k, w_B s₁ d * ψ_B s₂ d = if s₁ = s₂ then 1 else 0 := by
              apply Subtype.val_injective
              change B_ext.val.toRingHom (∑ d, w_B s₁ d * ψ_B s₂ d) = B_ext.val.toRingHom (if s₁ = s₂ then 1 else 0)
              rw [map_sum]
              have hval : ∀ d : MonLt m k,
                  B_ext.val.toRingHom (w_B s₁ d * ψ_B s₂ d) = w_bar s₁ d * ψ_entry s₂ d := fun _ => rfl
              simp only [hval]
              rw [hInv_left s₁ s₂]
              split_ifs <;> simp
            simp only [← map_mul, ← map_sum, hB]
            split_ifs <;> simp
          simp only [hinner, mul_ite, mul_one, mul_zero]
          rw [Finset.sum_eq_single s₂]
          · simp
          · intro s₁ _ hne; exact if_neg hne
          · intro hs₂; exact (hs₂ (Finset.mem_univ s₂)).elim

        have hw_in_WΩ : ∀ j : Fin d_k, (fun d => φ (w_B (Sum.inl j) d)) ∈ W_Ω := by
          intro j
          have hEq : (fun d => φ (w_B (Sum.inl j) d)) = ∑ p : P_idx, φ (α_B j p) • gen_Ω p := by
            ext d
            simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, hgen_Ω_eq, ← map_mul, ← map_sum]
            congr 1
            apply Subtype.val_injective
            have h := congrFun (hα_in j) d
            simpa [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, w_B, w_bar, α_B, hgen_B_val] using h
          rw [hEq]
          exact Submodule.sum_mem W_Ω fun p _ => Submodule.smul_mem W_Ω _ (Submodule.subset_span ⟨p, rfl⟩)
        have hgen_eq_Φ : ∀ p : P_idx, gen_Ω p = Φ_Ω (Sum.elim (fun j => φ (β_B p j)) 0) := by
          intro p
          ext d
          change gen_Ω p d = ∑ s : Fin d_k ⊕ Fin r_k, Sum.elim (fun j => φ (β_B p j)) 0 s * φ (w_B s d)
          rw [Fintype.sum_sum_type]
          simp only [Sum.elim_inl, Sum.elim_inr, Pi.zero_apply, zero_mul, Finset.sum_const_zero,
            add_zero, hgen_Ω_eq, ← map_mul, ← map_sum]
          congr 1
          apply Subtype.val_injective
          have h := congrFun (hβ_in p) d
          simpa [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, w_B, w_bar, β_B, hgen_B_val] using h

        let projOut_Ω : (MonLt m k → Ω) →ₗ[Ω] (Fin r_k → Ω) :=
          { toFun := fun x l => Ψ_Ω x (Sum.inr l)
            map_add' := fun x₁ x₂ => by ext l; simp
            map_smul' := fun c x => by ext l; simp }
        have hKer_proj : LinearMap.ker projOut_Ω = W_Ω := by
          ext x
          constructor
          · intro hx
            have hx_out : ∀ l : Fin r_k, Ψ_Ω x (Sum.inr l) = 0 := congrFun hx
            have hx_eq : x = ∑ j : Fin d_k, Ψ_Ω x (Sum.inl j) • (fun d => φ (w_B (Sum.inl j) d)) := by
              conv_lhs => rw [← hΦΨ_Ω x]
              ext d
              change ∑ s : Fin d_k ⊕ Fin r_k, Ψ_Ω x s * φ (w_B s d) = _
              rw [Fintype.sum_sum_type]
              simp [hx_out]
            rw [hx_eq]
            exact Submodule.sum_mem W_Ω fun j _ => Submodule.smul_mem W_Ω _ (hw_in_WΩ j)
          · intro hx
            refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
            · rintro _ ⟨p, rfl⟩
              ext l
              change Ψ_Ω (gen_Ω p) (Sum.inr l) = 0
              rw [hgen_eq_Φ p, hΨΦ_Ω]
              rfl
            · exact zero_mem _
            · intro u v _ _ hu hv; exact add_mem hu hv
            · intro c u _ hu; exact Submodule.smul_mem _ c hu
        have hSurj_proj : Function.Surjective projOut_Ω := by
          intro h
          refine ⟨Φ_Ω (Sum.elim 0 h), ?_⟩
          ext l
          change Ψ_Ω (Φ_Ω (Sum.elim 0 h)) (Sum.inr l) = h l
          rw [hΨΦ_Ω]
          rfl
        let e_WΩ : ((MonLt m k → Ω) ⧸ W_Ω) ≃ₗ[Ω] (Fin r_k → Ω) :=
          LinearEquiv.ofBijective
            (W_Ω.liftQ projOut_Ω (le_of_eq hKer_proj.symm))
            ⟨by
              rw [← LinearMap.ker_eq_bot, Submodule.ker_liftQ, hKer_proj, Submodule.mkQ_map_self],
             fun h => by
              obtain ⟨x, rfl⟩ := hSurj_proj h
              exact ⟨Submodule.Quotient.mk x, rfl⟩⟩
        obtain ⟨e_sh_Ω⟩ := hShift_quotEquiv
          (fun ν => MvPolynomial.map (φ.comp (algebraMap A ↥B_ext)) (f ν)) x_Ω k
        obtain ⟨e_tr_Ω⟩ := hQuot_truncEquiv hk f_tilde_Ω
        have hfin_Ω : Module.finrank Ω
            (MvPolynomial (Fin m) Ω ⧸
              (Ideal.span (Set.range (fun ν : Fin t =>
                  MvPolynomial.map (φ.comp (algebraMap A ↥B_ext)) (f ν))) ⊔
                (RingHom.ker (MvPolynomial.aeval x_Ω).toRingHom) ^ k)) = r_k := by
          rw [(e_sh_Ω.toLinearEquiv.trans (e_tr_Ω.trans e_WΩ)).finrank_eq, Module.finrank_fin_fun]
        rw [hr_eq]
        exact hfin_Ω

      obtain ⟨S_freeze2, hFreeze2⟩ := hFreezeFinrank 2 (by omega)
      obtain ⟨S_freeze3, hFreeze3⟩ := hFreezeFinrank 3 (by omega)
      let r₂ := Module.finrank K_bar (MvPolynomial (Fin m) K_bar ⧸ (I_bar ⊔ M₀ ^ 2))
      let r₃ := Module.finrank K_bar (MvPolynomial (Fin m) K_bar ⧸ (I_bar ⊔ M₀ ^ 3))

      have haeval_zero_ext : ∀ (S_ext : Finset K_bar) (hSub₀ : S₀ ⊆ S_ext)
          (Ω : Type u) [Field Ω] (φ : ↥(Algebra.adjoin A (↑S_ext : Set K_bar)) →+* Ω) (ν : Fin t),
          let inc₀ := (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub₀))).toRingHom
          MvPolynomial.aeval (fun a => φ (inc₀ (x_B₀ a)))
            (MvPolynomial.map (φ.comp (algebraMap A ↥(Algebra.adjoin A (↑S_ext : Set K_bar)))) (f ν)) = 0 := by
        intro S_ext hSub₀ Ω _ φ ν inc₀
        have hAlg : φ.comp (algebraMap A ↥(Algebra.adjoin A (↑S_ext : Set K_bar))) =
            (φ.comp inc₀).comp (algebraMap A ↥B₀_sub) := by ext a; rfl
        rw [hAlg, ← MvPolynomial.map_map, ← hShift_const]
        change MvPolynomial.constantCoeff
          (shiftEquiv (⇑(φ.comp inc₀) ∘ x_B₀)
            (MvPolynomial.map (φ.comp inc₀) (MvPolynomial.map (algebraMap A ↥B₀_sub) (f ν)))) = 0
        rw [← hShift_map, MvPolynomial.constantCoeff_map, hConst_ftilde₀ ν, map_zero]

      by_cases hCaseC : r₂ = 3 ∧ r₃ = 5
      · rcases hCaseC with ⟨hr₂_eq, hr₃_eq⟩
        have hNoSplit_bar : ¬ ∃ u v : MvPolynomial (Fin m) K_bar,
            u ∈ M₀ ∧ v ∈ M₀ ∧ M₀ ≤ I_bar ⊔ M₀ ^ 2 ⊔ Ideal.span {u, v} ∧ u * v ∈ I_bar ⊔ M₀ ^ 3 :=
          fun hSp => hNegArtin (Or.inr ⟨hr₂_eq, hr₃_eq, hSp⟩)

        let Ĩ_bar := Ideal.span (Set.range f_tilde_bar)
        let J₂_bar := Ĩ_bar ⊔ (origMax K_bar m) ^ 2
        let J₃_bar := Ĩ_bar ⊔ (origMax K_bar m) ^ 3
        let R₂_bar := MvPolynomial (Fin m) K_bar ⧸ J₂_bar
        let R₃_bar := MvPolynomial (Fin m) K_bar ⧸ J₃_bar
        obtain ⟨e_sh2⟩ := hShift_quotEquiv (fun ν => MvPolynomial.map α_A (f ν)) x₀ 2
        obtain ⟨e_sh3⟩ := hShift_quotEquiv (fun ν => MvPolynomial.map α_A (f ν)) x₀ 3
        obtain ⟨e_tr2⟩ := hQuot_truncEquiv (by omega : 1 ≤ 2) f_tilde_bar
        obtain ⟨e_tr3⟩ := hQuot_truncEquiv (by omega : 1 ≤ 3) f_tilde_bar
        letI : Fintype (MonLt m 2) := instFintypeMonLt m 2
        letI : Fintype (MonLt m 3) := instFintypeMonLt m 3
        have _ : Module.Finite K_bar R₂_bar := Module.Finite.equiv e_tr2.symm
        have _ : Module.Finite K_bar R₃_bar := Module.Finite.equiv e_tr3.symm
        have hfin_R₂ : Module.finrank K_bar R₂_bar = 3 := e_sh2.toLinearEquiv.symm.finrank_eq.trans hr₂_eq
        have hfin_R₃ : Module.finrank K_bar R₃_bar = 5 := e_sh3.toLinearEquiv.symm.finrank_eq.trans hr₃_eq

        have hJ₂_le_orig : J₂_bar ≤ origMax K_bar m := by
          refine sup_le (Ideal.span_le.mpr ?_) (Ideal.pow_le_self (by norm_num))
          rintro _ ⟨ν, rfl⟩
          exact hftilde_origMax ν
        let c₀_alg : R₂_bar →ₐ[K_bar] K_bar :=
          Ideal.Quotient.liftₐ J₂_bar (MvPolynomial.aeval (0 : Fin m → K_bar)) (by
            intro P hP
            have h0 : P.coeff 0 = 0 := (hMem_origMax P).mp (hJ₂_le_orig hP)
            rw [MvPolynomial.aeval_zero, MvPolynomial.constantCoeff_eq]
            exact h0)
        let c₀_bar : R₂_bar →ₗ[K_bar] K_bar := c₀_alg.toLinearMap
        have hc₀_range : LinearMap.range c₀_bar = ⊤ := by
          rw [eq_top_iff]
          intro c _
          refine ⟨c • 1, ?_⟩
          rw [map_smul]
          change c • c₀_alg 1 = c
          rw [map_one, smul_eq_mul, mul_one]
        have hfin_ker_c₀ : Module.finrank K_bar (LinearMap.ker c₀_bar) = 2 := by
          have hrk := LinearMap.finrank_range_add_finrank_ker c₀_bar
          rw [hc₀_range, finrank_top, Module.finrank_self, hfin_R₂] at hrk
          omega

        have hDeg1_decomp : ∀ {F : Type u} [Field F] (P : MvPolynomial (Fin m) F),
            P - MvPolynomial.C (P.coeff 0) -
              ∑ a : Fin m, MvPolynomial.C (P.coeff (Finsupp.single a 1)) * MvPolynomial.X a ∈
                (origMax F m) ^ 2 := by
          intro F _ P
          rw [hMem_origMax_pow 2]
          intro d hd
          simp only [MvPolynomial.coeff_sub, MvPolynomial.coeff_C, MvPolynomial.coeff_sum,
            MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X']
          by_cases hd0 : d = 0
          · subst hd0
            have hne : ∀ a : Fin m, Finsupp.single a 1 ≠ (0 : Fin m →₀ ℕ) := by
              intro a h
              have h1 : (Finsupp.single a 1 : Fin m →₀ ℕ) a = (0 : Fin m →₀ ℕ) a :=
                Finsupp.ext_iff.mp h a
              simp only [Finsupp.single_eq_same, Finsupp.coe_zero, Pi.zero_apply] at h1
              exact Nat.one_ne_zero h1
            simp [hne]
          · have hpos : 1 ≤ degMon d := hDeg_pos hd0
            have hdeg1 : degMon d = 1 := by omega
            obtain ⟨a₀, ha₀_ne⟩ := Finsupp.ne_iff.mp hd0
            have ha₀_pos : 1 ≤ d a₀ := Nat.one_le_iff_ne_zero.mpr (by simpa using ha₀_ne)
            have ha₀_eq1 : d a₀ = 1 := by
              have hle := hLe_deg d a₀
              omega
            have hd_single : d = Finsupp.single a₀ 1 := by
              ext b
              by_cases hb : b = a₀
              · subst hb; simpa using ha₀_eq1
              · rw [Finsupp.single_eq_of_ne hb]
                by_contra hb_ne
                have ha₀_mem : a₀ ∈ d.support := Finsupp.mem_support_iff.mpr (by simpa using ha₀_ne)
                have hb_mem : b ∈ d.support := Finsupp.mem_support_iff.mpr hb_ne
                have hsub_pair : ({a₀, b} : Finset (Fin m)) ⊆ d.support := by
                  intro z hz
                  rcases Finset.mem_insert.mp hz with rfl | hzb
                  · exact ha₀_mem
                  · rw [Finset.mem_singleton.mp hzb]; exact hb_mem
                have hsum_ge : ∑ z ∈ ({a₀, b} : Finset (Fin m)), d z ≤ degMon d :=
                  Finset.sum_le_sum_of_subset_of_nonneg hsub_pair (fun _ _ _ => Nat.zero_le _)
                have hb_pos : 1 ≤ d b := Nat.one_le_iff_ne_zero.mpr hb_ne
                rw [Finset.sum_pair (Ne.symm hb), ha₀_eq1] at hsum_ge
                omega
            rw [hd_single]
            have h0_ne : (0 : Fin m →₀ ℕ) ≠ Finsupp.single a₀ 1 := by
              rw [← hd_single]; exact Ne.symm hd0
            rw [if_neg h0_ne, sub_zero, Finset.sum_eq_single a₀]
            · simp
            · intro b _ hb
              have hs_ne : Finsupp.single b 1 ≠ Finsupp.single a₀ 1 := by
                intro hEq
                apply hb
                by_contra hba
                have h1 := Finsupp.ext_iff.mp hEq b
                rw [Finsupp.single_eq_same, Finsupp.single_eq_of_ne hba] at h1
                exact one_ne_zero h1
              simp [hs_ne]
            · intro ha₀_univ; exact (ha₀_univ (Finset.mem_univ a₀)).elim

        let vX : Fin m → LinearMap.ker c₀_bar := fun a =>
          ⟨Ideal.Quotient.mk J₂_bar (MvPolynomial.X a), by
            change MvPolynomial.aeval (0 : Fin m → K_bar) (MvPolynomial.X a) = 0
            simp⟩
        have hSpan_vX : Submodule.span K_bar (Set.range vX) = ⊤ := by
          rw [eq_top_iff]
          rintro ⟨z, hz⟩ _
          obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective z
          have hP0 : P.coeff 0 = 0 := by
            change c₀_alg (Ideal.Quotient.mk J₂_bar P) = 0 at hz
            change MvPolynomial.aeval (0 : Fin m → K_bar) P = 0 at hz
            rwa [MvPolynomial.aeval_zero, MvPolynomial.constantCoeff_eq] at hz
          have hRem := hDeg1_decomp P
          rw [hP0, map_zero, sub_zero] at hRem
          have hmk_eq : Ideal.Quotient.mk J₂_bar P =
              ∑ a : Fin m, P.coeff (Finsupp.single a 1) • Ideal.Quotient.mk J₂_bar (MvPolynomial.X a) := by
            have hq0 : Ideal.Quotient.mk J₂_bar
                (P - ∑ a : Fin m, MvPolynomial.C (P.coeff (Finsupp.single a 1)) * MvPolynomial.X a) = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_right hRem)
            rw [map_sub, sub_eq_zero, map_sum] at hq0
            rw [hq0]
            refine Finset.sum_congr rfl fun a _ => ?_
            rw [Algebra.smul_def]
            rfl
          have hsub_eq : (⟨Ideal.Quotient.mk J₂_bar P, hz⟩ : LinearMap.ker c₀_bar) =
              ∑ a : Fin m, P.coeff (Finsupp.single a 1) • vX a := by
            apply Subtype.ext
            simpa using hmk_eq
          rw [hsub_eq]
          exact Submodule.sum_mem _ fun a _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, rfl⟩)

        obtain ⟨κ, a_idx, ha_inj, hSpan_κ, hLI_κ⟩ := exists_linearIndependent' K_bar vX
        rw [hSpan_vX] at hSpan_κ
        have _ : Finite κ := Finite.of_injective a_idx ha_inj
        letI : Fintype κ := Fintype.ofFinite κ
        let b_ker : Module.Basis κ K_bar (LinearMap.ker c₀_bar) :=
          Module.Basis.mk hLI_κ (le_of_eq hSpan_κ.symm)
        have hcard_κ : Fintype.card κ = 2 :=
          (Module.finrank_eq_card_basis b_ker).symm.trans hfin_ker_c₀
        let e_κ : Fin 2 ≃ κ := (Fintype.equivFinOfCardEq hcard_κ).symm
        let i₁ : Fin m := a_idx (e_κ 0)
        let i₂ : Fin m := a_idx (e_κ 1)
        have hBasis_i12 : LinearIndependent K_bar ![vX i₁, vX i₂] ∧
            Submodule.span K_bar (Set.range ![vX i₁, vX i₂]) = ⊤ := by
          have hcomp : ![vX i₁, vX i₂] = (vX ∘ a_idx) ∘ e_κ := by
            ext j; fin_cases j <;> rfl
          rw [hcomp]
          refine ⟨hLI_κ.comp e_κ e_κ.injective, ?_⟩
          rw [Set.range_comp, Equiv.range_eq_univ, Set.image_univ, hSpan_κ]
        have hOrig_le_span12 : origMax K_bar m ≤
            J₂_bar ⊔ Ideal.span {MvPolynomial.X i₁, MvPolynomial.X i₂} := by
          intro P hP
          have hmem_ker : Ideal.Quotient.mk J₂_bar P ∈ LinearMap.ker c₀_bar := by
            change MvPolynomial.aeval (0 : Fin m → K_bar) P = 0
            rw [MvPolynomial.aeval_zero]
            exact hP
          have htop : (⟨Ideal.Quotient.mk J₂_bar P, hmem_ker⟩ : LinearMap.ker c₀_bar) ∈
              Submodule.span K_bar (Set.range ![vX i₁, vX i₂]) := by
            rw [hBasis_i12.2]; trivial
          obtain ⟨c_fs, hc_fs⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp htop
          rw [Finsupp.sum_fintype c_fs (fun i a => a • (![vX i₁, vX i₂] i))
            (fun i => zero_smul K_bar (![vX i₁, vX i₂] i)), Fin.sum_univ_two] at hc_fs
          have hval := congrArg Subtype.val hc_fs
          simp only [Submodule.coe_add, SetLike.val_smul, Matrix.cons_val_zero,
            Matrix.cons_val_one, Matrix.head_cons] at hval
          dsimp [vX] at hval
          have hAlgR₂ : ∀ c : K_bar,
              algebraMap K_bar R₂_bar c = Ideal.Quotient.mk J₂_bar (MvPolynomial.C c) :=
            fun _ => rfl
          have hdiff : P - (MvPolynomial.C (c_fs 0) * MvPolynomial.X i₁ +
              MvPolynomial.C (c_fs 1) * MvPolynomial.X i₂) ∈ J₂_bar := by
            rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero, map_add]
            simpa [Algebra.smul_def, hAlgR₂] using hval.symm
          have hP_eq : P = (P - (MvPolynomial.C (c_fs 0) * MvPolynomial.X i₁ +
              MvPolynomial.C (c_fs 1) * MvPolynomial.X i₂)) +
              (MvPolynomial.C (c_fs 0) * MvPolynomial.X i₁ +
                MvPolynomial.C (c_fs 1) * MvPolynomial.X i₂) := (sub_add_cancel _ _).symm
          rw [hP_eq]
          refine Submodule.add_mem_sup hdiff ?_
          exact add_mem
            (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
            (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
        have hLI_i12 : ∀ c₁ c₂ : K_bar,
            MvPolynomial.C c₁ * MvPolynomial.X i₁ + MvPolynomial.C c₂ * MvPolynomial.X i₂ ∈ J₂_bar →
              c₁ = 0 ∧ c₂ = 0 := by
          intro c₁ c₂ hMem
          have hAlgR₂ : ∀ c : K_bar,
              algebraMap K_bar R₂_bar c = Ideal.Quotient.mk J₂_bar (MvPolynomial.C c) :=
            fun _ => rfl
          have hq0 : Ideal.Quotient.mk J₂_bar
              (MvPolynomial.C c₁ * MvPolynomial.X i₁ + MvPolynomial.C c₂ * MvPolynomial.X i₂) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr hMem
          have hlin0 : ∑ j : Fin 2, (![c₁, c₂] j) • (![vX i₁, vX i₂] j) = 0 := by
            apply Subtype.ext
            rw [Fin.sum_univ_two]
            simpa [vX, Algebra.smul_def, hAlgR₂] using hq0
          have hAll := Fintype.linearIndependent_iff.mp hBasis_i12.1 ![c₁, c₂] hlin0
          exact ⟨hAll 0, hAll 1⟩

        have hJ₃_le_J₂ : J₃_bar ≤ J₂_bar :=
          sup_le_sup_left (Ideal.pow_le_pow_right (by norm_num : 2 ≤ 3)) _
        let q₃₂_alg : R₃_bar →ₐ[K_bar] R₂_bar :=
          Ideal.Quotient.liftₐ J₃_bar (Ideal.Quotient.mkₐ K_bar J₂_bar)
            (fun P hP => Ideal.Quotient.eq_zero_iff_mem.mpr (hJ₃_le_J₂ hP))
        let q₃₂ : R₃_bar →ₗ[K_bar] R₂_bar := q₃₂_alg.toLinearMap
        have hq₃₂_range : LinearMap.range q₃₂ = ⊤ := by
          rw [eq_top_iff]
          intro z _
          obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective z
          exact ⟨Ideal.Quotient.mk J₃_bar P, rfl⟩
        have hfin_ker_q₃₂ : Module.finrank K_bar (LinearMap.ker q₃₂) = 2 := by
          have hrk := LinearMap.finrank_range_add_finrank_ker q₃₂
          rw [hq₃₂_range, finrank_top, hfin_R₂, hfin_R₃] at hrk
          omega
        have hSq_in_ker : ∀ P ∈ (origMax K_bar m) ^ 2,
            Ideal.Quotient.mk J₃_bar P ∈ LinearMap.ker q₃₂ := by
          intro P hP
          change Ideal.Quotient.mk J₂_bar P = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_right hP)
        let q_vec : Fin 3 → LinearMap.ker q₃₂ :=
          ![⟨Ideal.Quotient.mk J₃_bar (MvPolynomial.X i₁ ^ 2),
              hSq_in_ker _ (Ideal.pow_mem_pow (hX_mem_origMax i₁) 2)⟩,
            ⟨Ideal.Quotient.mk J₃_bar (MvPolynomial.X i₁ * MvPolynomial.X i₂),
              hSq_in_ker _ (by rw [sq]; exact Ideal.mul_mem_mul (hX_mem_origMax i₁) (hX_mem_origMax i₂))⟩,
            ⟨Ideal.Quotient.mk J₃_bar (MvPolynomial.X i₂ ^ 2),
              hSq_in_ker _ (Ideal.pow_mem_pow (hX_mem_origMax i₂) 2)⟩]
        let μ₂ : (Fin 3 → K_bar) →ₗ[K_bar] LinearMap.ker q₃₂ :=
          Fintype.linearCombination K_bar q_vec
        have hKer_μ₂ : LinearMap.ker μ₂ ≠ ⊥ := by
          apply LinearMap.ker_ne_bot_of_finrank_lt
          rw [hfin_ker_q₃₂, Module.finrank_fin_fun]
          omega
        obtain ⟨a_quad, ha_ker, ha_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hKer_μ₂
        have hQuad_J₃ :
            MvPolynomial.C (a_quad 0) * MvPolynomial.X i₁ ^ 2 +
              MvPolynomial.C (a_quad 1) * MvPolynomial.X i₁ * MvPolynomial.X i₂ +
              MvPolynomial.C (a_quad 2) * MvPolynomial.X i₂ ^ 2 ∈ J₃_bar := by
          have hAlgR₃ : ∀ c : K_bar,
              algebraMap K_bar R₃_bar c = Ideal.Quotient.mk J₃_bar (MvPolynomial.C c) :=
            fun _ => rfl
          rw [← Ideal.Quotient.eq_zero_iff_mem]
          have hval := congrArg Subtype.val ha_ker
          change (∑ j : Fin 3, a_quad j • q_vec j).1 = 0 at hval
          rw [Fin.sum_univ_three] at hval
          simpa [q_vec, Algebra.smul_def, hAlgR₃, mul_assoc] using hval

        have hFactor_quad : ∃ α₁ β₁ α₂ β₂ : K_bar,
            (α₁ ≠ 0 ∨ β₁ ≠ 0) ∧ (α₂ ≠ 0 ∨ β₂ ≠ 0) ∧
            (MvPolynomial.C α₁ * MvPolynomial.X i₁ + MvPolynomial.C β₁ * MvPolynomial.X i₂) *
              (MvPolynomial.C α₂ * MvPolynomial.X i₁ + MvPolynomial.C β₂ * MvPolynomial.X i₂) =
              MvPolynomial.C (a_quad 0) * MvPolynomial.X i₁ ^ 2 +
                MvPolynomial.C (a_quad 1) * MvPolynomial.X i₁ * MvPolynomial.X i₂ +
                MvPolynomial.C (a_quad 2) * MvPolynomial.X i₂ ^ 2 := by
          by_cases ha0 : a_quad 0 ≠ 0
          · let polyQ : Polynomial K_bar :=
              Polynomial.C (a_quad 0) * Polynomial.X ^ 2 +
                Polynomial.C (a_quad 1) * Polynomial.X + Polynomial.C (a_quad 2)
            have hdeg_ne : polyQ.degree ≠ 0 := by
              intro hdeg0
              have hEqC := Polynomial.eq_C_of_degree_le_zero (le_of_eq hdeg0)
              have hc2 := congrArg (fun p : Polynomial K_bar => p.coeff 2) hEqC
              simp [polyQ, Polynomial.coeff_X_pow] at hc2
              exact ha0 hc2
            obtain ⟨r₁, hr₁⟩ := IsAlgClosed.exists_root polyQ hdeg_ne
            have hr₁_eq : a_quad 0 * r₁ ^ 2 + a_quad 1 * r₁ + a_quad 2 = 0 := by
              simpa [polyQ, Polynomial.IsRoot.def] using hr₁
            let r₂ : K_bar := -(a_quad 0)⁻¹ * a_quad 1 - r₁
            have hsum_r : -(a_quad 0 * r₂) - r₁ * a_quad 0 = a_quad 1 := by
              dsimp only [r₂]
              calc
                -(a_quad 0 * (-(a_quad 0)⁻¹ * a_quad 1 - r₁)) - r₁ * a_quad 0
                  = (a_quad 0 * (a_quad 0)⁻¹) * a_quad 1 := by ring
                _ = a_quad 1 := by rw [mul_inv_cancel₀ ha0, one_mul]
            have hprod_r : (-r₁) * (-(a_quad 0 * r₂)) = a_quad 2 := by
              dsimp only [r₂]
              have h1 : (a_quad 0 * (a_quad 0)⁻¹) * (a_quad 1 * r₁) = a_quad 1 * r₁ := by
                rw [mul_inv_cancel₀ ha0, one_mul]
              linear_combination -h1 - hr₁_eq
            refine ⟨1, -r₁, a_quad 0, -(a_quad 0 * r₂), Or.inl one_ne_zero, Or.inl ha0, ?_⟩
            rw [← hsum_r, ← hprod_r]
            simp only [map_sub, map_neg, map_mul, map_one]
            ring
          · push_neg at ha0
            by_cases ha1 : a_quad 1 ≠ 0
            · refine ⟨0, 1, a_quad 1, a_quad 2, Or.inr one_ne_zero, Or.inl ha1, ?_⟩
              rw [ha0]
              simp only [map_zero, map_one]
              ring
            · push_neg at ha1
              have ha2 : a_quad 2 ≠ 0 := by
                intro ha2
                apply ha_ne
                ext j
                fin_cases j
                · exact ha0
                · exact ha1
                · exact ha2
              refine ⟨0, 1, 0, a_quad 2, Or.inr one_ne_zero, Or.inr ha2, ?_⟩
              rw [ha0, ha1]
              simp only [map_zero, map_one]
              ring

        obtain ⟨α₁, β₁, α₂, β₂, hαβ₁_ne, hαβ₂_ne, hFactor_eq⟩ := hFactor_quad
        let u_tilde := MvPolynomial.C α₁ * MvPolynomial.X i₁ + MvPolynomial.C β₁ * MvPolynomial.X i₂
        let v_tilde := MvPolynomial.C α₂ * MvPolynomial.X i₁ + MvPolynomial.C β₂ * MvPolynomial.X i₂
        have huv_J₃ : u_tilde * v_tilde ∈ J₃_bar := by
          rw [hFactor_eq]
          exact hQuad_J₃

        have hDet_zero : α₁ * β₂ - β₁ * α₂ = 0 := by
          by_contra hDet_ne
          let δ_inv := (α₁ * β₂ - β₁ * α₂)⁻¹
          have hX₁_span : MvPolynomial.X i₁ ∈ Ideal.span ({u_tilde, v_tilde} : Set (MvPolynomial (Fin m) K_bar)) := by
            have hEq : (MvPolynomial.X i₁ : MvPolynomial (Fin m) K_bar) =
                MvPolynomial.C (δ_inv * β₂) * u_tilde - MvPolynomial.C (δ_inv * β₁) * v_tilde := by
              have h1 : MvPolynomial.C (δ_inv * (α₁ * β₂ - β₁ * α₂)) =
                  (1 : MvPolynomial (Fin m) K_bar) := by
                rw [inv_mul_cancel₀ hDet_ne, map_one]
              simp only [u_tilde, v_tilde, map_mul, map_sub] at h1 ⊢
              linear_combination -MvPolynomial.X i₁ * h1
            rw [hEq]
            exact sub_mem
              (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
              (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
          have hX₂_span : MvPolynomial.X i₂ ∈ Ideal.span ({u_tilde, v_tilde} : Set (MvPolynomial (Fin m) K_bar)) := by
            have hEq : (MvPolynomial.X i₂ : MvPolynomial (Fin m) K_bar) =
                MvPolynomial.C (δ_inv * α₁) * v_tilde - MvPolynomial.C (δ_inv * α₂) * u_tilde := by
              have h1 : MvPolynomial.C (δ_inv * (α₁ * β₂ - β₁ * α₂)) =
                  (1 : MvPolynomial (Fin m) K_bar) := by
                rw [inv_mul_cancel₀ hDet_ne, map_one]
              simp only [u_tilde, v_tilde, map_mul, map_sub] at h1 ⊢
              linear_combination -MvPolynomial.X i₂ * h1
            rw [hEq]
            exact sub_mem
              (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
              (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
          have hSpan_sub : Ideal.span ({MvPolynomial.X i₁, MvPolynomial.X i₂} : Set _) ≤
              Ideal.span ({u_tilde, v_tilde} : Set _) := by
            rw [Ideal.span_le]
            rintro z (rfl | rfl)
            · exact hX₁_span
            · exact hX₂_span
          have hOrig_uv : origMax K_bar m ≤ J₂_bar ⊔ Ideal.span {u_tilde, v_tilde} :=
            hOrig_le_span12.trans (sup_le_sup_left hSpan_sub _)
          let u₀_bar := (shiftEquiv x₀).symm u_tilde
          let v₀_bar := (shiftEquiv x₀).symm v_tilde
          apply hNoSplit_bar
          refine ⟨u₀_bar, v₀_bar, ?_, ?_, ?_, ?_⟩
          · rw [hShift_mem_ker x₀, (shiftEquiv x₀).apply_symm_apply]
            exact add_mem
              (Ideal.mul_mem_left _ _ (hX_mem_origMax i₁))
              (Ideal.mul_mem_left _ _ (hX_mem_origMax i₂))
          · rw [hShift_mem_ker x₀, (shiftEquiv x₀).apply_symm_apply]
            exact add_mem
              (Ideal.mul_mem_left _ _ (hX_mem_origMax i₁))
              (Ideal.mul_mem_left _ _ (hX_mem_origMax i₂))
          · intro P hP
            have hsh : shiftEquiv x₀ P ∈ J₂_bar ⊔ Ideal.span {u_tilde, v_tilde} :=
              hOrig_uv ((hShift_mem_ker x₀ P).mp hP)
            rcases Submodule.mem_sup.mp hsh with ⟨q₁, hq₁, q₂, hq₂, hEq⟩
            have hP_eq : P = (shiftEquiv x₀).symm q₁ + (shiftEquiv x₀).symm q₂ := by
              apply (shiftEquiv x₀).injective
              rw [← hEq, map_add, (shiftEquiv x₀).apply_symm_apply, (shiftEquiv x₀).apply_symm_apply]
            rw [hP_eq]
            refine Submodule.add_mem_sup ?_ ?_
            · rw [hShift_sup_mem _ x₀ 2]
              simpa using hq₁
            · rw [Ideal.mem_span_pair] at hq₂ ⊢
              rcases hq₂ with ⟨A₁, A₂, rfl⟩
              exact ⟨(shiftEquiv x₀).symm A₁, (shiftEquiv x₀).symm A₂, by simp [u₀_bar, v₀_bar]⟩
          · rw [hShift_sup_mem _ x₀ 3, map_mul, (shiftEquiv x₀).apply_symm_apply,
              (shiftEquiv x₀).apply_symm_apply]
            exact huv_J₃

        have hw_not_J₂ : u_tilde ∉ J₂_bar := by
          intro hMem
          rcases hLI_i12 α₁ β₁ hMem with ⟨h1, h2⟩
          rcases hαβ₁_ne with h | h <;> exact h (by assumption)
        have hw_sq_J₃ : u_tilde ^ 2 ∈ J₃_bar := by
          have hProp : ∃ κ_c : K_bar, κ_c ≠ 0 ∧ α₂ = κ_c * α₁ ∧ β₂ = κ_c * β₁ := by
            by_cases hα₁ : α₁ ≠ 0
            · refine ⟨α₂ * α₁⁻¹, ?_, (inv_mul_cancel_right₀ hα₁ α₂).symm, ?_⟩
              · intro h0
                have hα₂_0 : α₂ = 0 := by
                  have := congrArg (· * α₁) h0
                  simpa [inv_mul_cancel_right₀ hα₁] using this
                have hβ₂_0 : β₂ = 0 := by
                  have : α₁ * β₂ = 0 := by linear_combination hDet_zero + β₁ * hα₂_0
                  exact (mul_eq_zero.mp this).resolve_left hα₁
                rcases hαβ₂_ne with h | h <;> exact h (by assumption)
              · apply mul_left_cancel₀ hα₁
                calc
                  α₁ * β₂ = β₁ * α₂ := sub_eq_zero.mp hDet_zero
                  _ = α₁ * (α₂ * α₁⁻¹ * β₁) := by
                    have : α₁ * α₁⁻¹ = 1 := mul_inv_cancel₀ hα₁
                    linear_combination -β₁ * α₂ * this
            · push_neg at hα₁
              have hβ₁ : β₁ ≠ 0 := hαβ₁_ne.resolve_left (not_not.mpr hα₁)
              have hα₂ : α₂ = 0 := by
                have : β₁ * α₂ = 0 := by linear_combination -hDet_zero + β₂ * hα₁
                exact (mul_eq_zero.mp this).resolve_left hβ₁
              have hβ₂ : β₂ ≠ 0 := hαβ₂_ne.resolve_left (not_not.mpr hα₂)
              refine ⟨β₂ * β₁⁻¹, mul_ne_zero hβ₂ (inv_ne_zero hβ₁), ?_,
                (inv_mul_cancel_right₀ hβ₁ β₂).symm⟩
              rw [hα₁, hα₂, mul_zero]
          obtain ⟨κ_c, hκ_ne, hα₂_eq, hβ₂_eq⟩ := hProp
          have hv_eq : v_tilde = MvPolynomial.C κ_c * u_tilde := by
            dsimp only [u_tilde, v_tilde]
            rw [hα₂_eq, hβ₂_eq]
            simp only [map_mul]
            ring
          have hsq : u_tilde ^ 2 = MvPolynomial.C κ_c⁻¹ * (u_tilde * v_tilde) := by
            rw [hv_eq]
            have h1 : MvPolynomial.C κ_c⁻¹ * MvPolynomial.C κ_c = (1 : MvPolynomial (Fin m) K_bar) := by
              rw [← MvPolynomial.C_mul, inv_mul_cancel₀ hκ_ne, map_one]
            linear_combination -u_tilde ^ 2 * h1
          rw [hsq]
          exact Ideal.mul_mem_left J₃_bar _ huv_J₃

        let W₂_bar := Submodule.span K_bar
          (Set.range (fun p : MonLt m 2 × Fin t =>
            truncLin K_bar m 2 (MvPolynomial.monomial p.1.1 1 * f_tilde_bar p.2)))
        let vw_bar := truncLin K_bar m 2 u_tilde
        have hvw_not_W₂ : vw_bar ∉ W₂_bar :=
          fun h => hw_not_J₂ ((hTrunc_sup_iff (by omega : 1 ≤ 2) f_tilde_bar u_tilde).mpr h)
        have hmk_vw_ne : W₂_bar.mkQ vw_bar ≠ 0 :=
          fun h0 => hvw_not_W₂ ((Submodule.Quotient.mk_eq_zero W₂_bar).mp h0)
        let b_QW2 := Module.Basis.ofVectorSpace K_bar ((MonLt m 2 → K_bar) ⧸ W₂_bar)
        have hRepr_vw : b_QW2.repr (W₂_bar.mkQ vw_bar) ≠ 0 :=
          fun h => hmk_vw_ne (b_QW2.repr.injective (by simpa using h))
        obtain ⟨bw_star, hbw_star⟩ := Finsupp.ne_iff.mp hRepr_vw
        let cw_star : K_bar := b_QW2.repr (W₂_bar.mkQ vw_bar) bw_star
        let ℓ_w : (MonLt m 2 → K_bar) →ₗ[K_bar] K_bar :=
          cw_star⁻¹ • (((Finsupp.lapply bw_star).comp b_QW2.repr.toLinearMap).comp W₂_bar.mkQ)
        have hℓ_w_one : ℓ_w vw_bar = 1 := inv_mul_cancel₀ hbw_star
        have hℓ_w_W₂ : ∀ w ∈ W₂_bar, ℓ_w w = 0 := by
          intro w hw
          have hmk0 : W₂_bar.mkQ w = 0 := (Submodule.Quotient.mk_eq_zero W₂_bar).mpr hw
          simp [ℓ_w, hmk0]
        let lam_w : MonLt m 2 → K_bar := fun d => ℓ_w (Pi.single d 1)
        have hℓ_w_exp : ∀ v : MonLt m 2 → K_bar, ∑ d : MonLt m 2, v d * lam_w d = ℓ_w v := by
          intro v
          have hv : v = ∑ d : MonLt m 2, v d • Pi.single d (1 : K_bar) := by
            ext d₀
            rw [Finset.sum_apply, Finset.sum_eq_single d₀]
            · simp
            · intro d _ hd; simp [Pi.single_eq_of_ne (Ne.symm hd)]
            · intro hd₀; exact (hd₀ (Finset.mem_univ d₀)).elim
          conv_rhs => rw [hv]
          rw [map_sum]
          simp [lam_w]

        rcases Submodule.mem_sup.mp hw_sq_J₃ with ⟨q_I, hq_I, q_3, hq_3, hw_sq_eq⟩
        obtain ⟨H_bar, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hq_I

        let S_all : Finset K_bar :=
          S₀ ∪ S_freeze2 ∪ S_freeze3 ∪ {α₁, β₁} ∪
          (Finset.univ.image lam_w) ∪
          (Finset.univ.biUnion fun ν : Fin t => (H_bar ν).support.image (H_bar ν).coeff) ∪
          (q_3.support.image q_3.coeff)
        have hSub_02 : S₀ ∪ S_freeze2 ⊆ S_all := by
          intro z hz
          rcases Finset.mem_union.mp hz with hz₀ | hz₂
          · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
              (Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _ hz₀)))))
          · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
              (Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _ hz₂)))))
        have hSub_03 : S₀ ∪ S_freeze3 ⊆ S_all := by
          intro z hz
          rcases Finset.mem_union.mp hz with hz₀ | hz₃
          · exact hSub_02 (Finset.mem_union_left _ hz₀)
          · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
              (Finset.mem_union_left _ (Finset.mem_union_right _ hz₃))))
        have hSub₀_all : S₀ ⊆ S_all := fun z hz => hSub_02 (Finset.mem_union_left _ hz)

        let B_sub : Subalgebra A K_bar := Algebra.adjoin A (↑S_all : Set K_bar)
        let B : Type u := ↥B_sub
        let ψ : A →+* B := algebraMap A B
        let ι_B : B →+* K_bar := B_sub.val.toRingHom
        let inc₀_B : ↥B₀_sub →+* B :=
          (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub₀_all))).toRingHom
        let α₁_B : B := ⟨α₁, Algebra.subset_adjoin (Finset.mem_coe.mpr
          (Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
            (Finset.mem_union_right _ (by simp))))))⟩
        let β₁_B : B := ⟨β₁, Algebra.subset_adjoin (Finset.mem_coe.mpr
          (Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
            (Finset.mem_union_right _ (by simp))))))⟩
        let lam_wB : MonLt m 2 → B := fun d => ⟨lam_w d, Algebra.subset_adjoin (Finset.mem_coe.mpr
          (Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _
            (Finset.mem_image_of_mem _ (Finset.mem_univ d))))))⟩
        have hH_in : ∀ (ν : Fin t) (d : Fin m →₀ ℕ), d ∈ (H_bar ν).support → (H_bar ν).coeff d ∈ B_sub :=
          fun ν d hd => Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_left _
            (Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν,
              Finset.mem_image_of_mem _ hd⟩))))
        have hq3_in : ∀ d ∈ q_3.support, q_3.coeff d ∈ B_sub := fun d hd =>
          Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_right _
            (Finset.mem_image_of_mem _ hd)))
        let H_B : Fin t → MvPolynomial (Fin m) B := fun ν => liftPolySub B_sub (H_bar ν) (hH_in ν)
        let q₃_B : MvPolynomial (Fin m) B := liftPolySub B_sub q_3 hq3_in
        let w_B_poly : MvPolynomial (Fin m) B :=
          MvPolynomial.C α₁_B * MvPolynomial.X i₁ + MvPolynomial.C β₁_B * MvPolynomial.X i₂
        have hMap_wB : MvPolynomial.map ι_B w_B_poly = u_tilde := by
          simp only [w_B_poly, u_tilde, map_add, map_mul, MvPolynomial.map_C, MvPolynomial.map_X]
          rfl
        have hw_sq_B : w_B_poly ^ 2 =
            (∑ ν : Fin t, H_B ν * MvPolynomial.map inc₀_B (f_tilde_B₀ ν)) + q₃_B := by
          apply MvPolynomial.map_injective ι_B Subtype.val_injective
          rw [map_pow, hMap_wB, map_add, map_sum, hMap_liftPolySub B_sub q_3 hq3_in]
          have hcomp0 : ι_B.comp inc₀_B = B₀_sub.val.toRingHom := rfl
          have hH_map : ∀ ν : Fin t, MvPolynomial.map ι_B (H_B ν) = H_bar ν :=
            fun ν => hMap_liftPolySub B_sub (H_bar ν) (hH_in ν)
          simp only [map_mul, hH_map, MvPolynomial.map_map, hcomp0, hMap_ftilde₀]
          exact hw_sq_eq.symm
        have hq₃_B_pow : ∀ d : Fin m →₀ ℕ, degMon d < 3 → q₃_B.coeff d = 0 := by
          intro d hd
          apply Subtype.val_injective
          change ι_B (q₃_B.coeff d) = 0
          rw [← MvPolynomial.coeff_map, hMap_liftPolySub B_sub q_3 hq3_in]
          exact (hMem_origMax_pow 3 q_3).mp hq_3 d hd
        have hId_w : ∑ d : MonLt m 2, w_B_poly.coeff d.1 * lam_wB d = 1 := by
          apply Subtype.val_injective
          change ι_B (∑ d : MonLt m 2, w_B_poly.coeff d.1 * lam_wB d) = 1
          rw [map_sum]
          have h1 : (∑ d : MonLt m 2, ι_B (w_B_poly.coeff d.1 * lam_wB d)) =
              ∑ d : MonLt m 2, vw_bar d * lam_w d := by
            refine Finset.sum_congr rfl fun d _ => ?_
            rw [map_mul, ← MvPolynomial.coeff_map, hMap_wB]
            rfl
          rw [h1, hℓ_w_exp, hℓ_w_one]
        have hId_w_gen : ∀ (d₀ : MonLt m 2) (ν : Fin t),
            ∑ d : MonLt m 2,
              (MvPolynomial.monomial d₀.1 1 * MvPolynomial.map inc₀_B (f_tilde_B₀ ν)).coeff d.1 *
                lam_wB d = 0 := by
          intro d₀ ν
          apply Subtype.val_injective
          change ι_B (∑ d : MonLt m 2, _ * lam_wB d) = 0
          rw [map_sum]
          have hcomp0 : ι_B.comp inc₀_B = B₀_sub.val.toRingHom := rfl
          have h1 : (∑ d : MonLt m 2,
              ι_B ((MvPolynomial.monomial d₀.1 1 * MvPolynomial.map inc₀_B (f_tilde_B₀ ν)).coeff d.1 * lam_wB d)) =
              ∑ d : MonLt m 2, truncLin K_bar m 2 (MvPolynomial.monomial d₀.1 1 * f_tilde_bar ν) d * lam_w d := by
            refine Finset.sum_congr rfl fun d _ => ?_
            rw [map_mul, ← MvPolynomial.coeff_map, map_mul, MvPolynomial.map_monomial, map_one,
              MvPolynomial.map_map, hcomp0, hMap_ftilde₀]
            rfl
          rw [h1, hℓ_w_exp]
          exact hℓ_w_W₂ _ (Submodule.subset_span ⟨(d₀, ν), rfl⟩)

        refine ⟨B, inferInstance, inferInstance, ψ, ι_B,
          hSubalgFT B_sub (Subalgebra.fg_adjoin_finset S_all),
          rfl, Subtype.val_injective, ?_⟩
        intro Ω _ _ φ
        let x_Ω : Fin m → Ω := fun a => φ (inc₀_B (x_B₀ a))
        refine ⟨x_Ω, haeval_zero_ext S_all hSub₀_all Ω φ, ?_⟩
        have hfin2_Ω : Module.finrank Ω
            (MvPolynomial (Fin m) Ω ⧸
              (Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map (φ.comp ψ) (f ν))) ⊔
                (RingHom.ker (MvPolynomial.aeval x_Ω).toRingHom) ^ 2)) = 3 :=
          (hFreeze2 S_all hSub_02 Ω φ).trans hr₂_eq
        have hfin3_Ω : Module.finrank Ω
            (MvPolynomial (Fin m) Ω ⧸
              (Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map (φ.comp ψ) (f ν))) ⊔
                (RingHom.ker (MvPolynomial.aeval x_Ω).toRingHom) ^ 3)) = 5 :=
          (hFreeze3 S_all hSub_03 Ω φ).trans hr₃_eq

        rintro (hEq2 | ⟨_, _, u_Ω, v_Ω, hu_M, hv_M, hM_le, huv_3⟩)
        · rw [hfin2_Ω] at hEq2; omega
        · let f_tilde_Ω : Fin t → MvPolynomial (Fin m) Ω :=
            fun ν => shiftEquiv x_Ω (MvPolynomial.map (φ.comp ψ) (f ν))
          have hftilde_Ω_map : ∀ ν : Fin t, f_tilde_Ω ν = MvPolynomial.map (φ.comp inc₀_B) (f_tilde_B₀ ν) := by
            intro ν
            change shiftEquiv x_Ω (MvPolynomial.map (φ.comp ψ) (f ν)) =
              MvPolynomial.map (φ.comp inc₀_B) (shiftEquiv x_B₀ (MvPolynomial.map (algebraMap A ↥B₀_sub) (f ν)))
            rw [hShift_map, MvPolynomial.map_map]
            rfl
          let Ĩ_Ω := Ideal.span (Set.range f_tilde_Ω)
          let J₂_Ω := Ĩ_Ω ⊔ (origMax Ω m) ^ 2
          let J₃_Ω := Ĩ_Ω ⊔ (origMax Ω m) ^ 3
          let R₂_Ω := MvPolynomial (Fin m) Ω ⧸ J₂_Ω
          let R₃_Ω := MvPolynomial (Fin m) Ω ⧸ J₃_Ω
          obtain ⟨e_sh2_Ω⟩ := hShift_quotEquiv (fun ν => MvPolynomial.map (φ.comp ψ) (f ν)) x_Ω 2
          obtain ⟨e_sh3_Ω⟩ := hShift_quotEquiv (fun ν => MvPolynomial.map (φ.comp ψ) (f ν)) x_Ω 3
          obtain ⟨e_tr2_Ω⟩ := hQuot_truncEquiv (by omega : 1 ≤ 2) f_tilde_Ω
          obtain ⟨e_tr3_Ω⟩ := hQuot_truncEquiv (by omega : 1 ≤ 3) f_tilde_Ω
          have _ : Module.Finite Ω R₂_Ω := Module.Finite.equiv e_tr2_Ω.symm
          have _ : Module.Finite Ω R₃_Ω := Module.Finite.equiv e_tr3_Ω.symm
          have hfin_R₂_Ω : Module.finrank Ω R₂_Ω = 3 := e_sh2_Ω.toLinearEquiv.symm.finrank_eq.trans hfin2_Ω
          have hfin_R₃_Ω : Module.finrank Ω R₃_Ω = 5 := e_sh3_Ω.toLinearEquiv.symm.finrank_eq.trans hfin3_Ω

          let w_Ω : MvPolynomial (Fin m) Ω := MvPolynomial.map φ w_B_poly
          have hw_Ω_not_J₂ : w_Ω ∉ J₂_Ω := by
            intro hw_in
            let Λ_w : MvPolynomial (Fin m) Ω →ₗ[Ω] Ω :=
              { toFun := fun Q => ∑ d : MonLt m 2, Q.coeff d.1 * φ (lam_wB d)
                map_add' := fun Q₁ Q₂ => by simp [MvPolynomial.coeff_add, add_mul, Finset.sum_add_distrib]
                map_smul' := fun c Q => by simp [MvPolynomial.coeff_smul, mul_assoc, Finset.mul_sum] }
            have hΛ_one : Λ_w w_Ω = 1 := by
              change ∑ d : MonLt m 2, (MvPolynomial.map φ w_B_poly).coeff d.1 * φ (lam_wB d) = 1
              simp only [MvPolynomial.coeff_map, ← map_mul, ← map_sum, hId_w, map_one]
            have hΛ_zero : Λ_w w_Ω = 0 := by
              rcases Submodule.mem_sup.mp hw_in with ⟨p₁, hp₁, p₂, hp₂, hEq⟩
              rw [← hEq, map_add]
              have hp₂_0 : Λ_w p₂ = 0 := by
                change ∑ d : MonLt m 2, _ = 0
                refine Finset.sum_eq_zero fun d _ => ?_
                rw [(hMem_origMax_pow 2 p₂).mp hp₂ d.1 d.2, zero_mul]
              rw [hp₂_0, add_zero]
              obtain ⟨G_p, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hp₁
              rw [map_sum]
              refine Finset.sum_eq_zero fun ν _ => ?_
              rw [MvPolynomial.as_sum (G_p ν), Finset.sum_mul, map_sum]
              refine Finset.sum_eq_zero fun d₀ _ => ?_
              by_cases hd₀ : degMon d₀ < 2
              · have hsmul : MvPolynomial.monomial d₀ ((G_p ν).coeff d₀) * f_tilde_Ω ν =
                    ((G_p ν).coeff d₀) • MvPolynomial.map φ
                      (MvPolynomial.monomial d₀ 1 * MvPolynomial.map inc₀_B (f_tilde_B₀ ν)) := by
                  rw [hftilde_Ω_map ν, ← MvPolynomial.map_map, map_mul, MvPolynomial.map_monomial,
                    map_one, ← smul_mul_assoc, MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
                rw [hsmul, map_smul]
                have hg0 : Λ_w (MvPolynomial.map φ
                    (MvPolynomial.monomial d₀ 1 * MvPolynomial.map inc₀_B (f_tilde_B₀ ν))) = 0 := by
                  change ∑ d : MonLt m 2, _ = 0
                  simp only [MvPolynomial.coeff_map, ← map_mul, ← map_sum, hId_w_gen ⟨d₀, hd₀⟩ ν, map_zero]
                rw [hg0, smul_zero]
              · have hpow : MvPolynomial.monomial d₀ ((G_p ν).coeff d₀) * f_tilde_Ω ν ∈ (origMax Ω m) ^ 2 :=
                  Ideal.mul_mem_right _ _
                    (Ideal.pow_le_pow_right (Nat.le_of_not_lt hd₀) (hMon_mem_pow d₀ ((G_p ν).coeff d₀)))
                change ∑ d : MonLt m 2, _ = 0
                refine Finset.sum_eq_zero fun d _ => ?_
                rw [(hMem_origMax_pow 2 _).mp hpow d.1 d.2, zero_mul]
            rw [hΛ_one] at hΛ_zero
            exact one_ne_zero hΛ_zero

          have hw_Ω_sq_J₃ : w_Ω ^ 2 ∈ J₃_Ω := by
            change (MvPolynomial.map φ w_B_poly) ^ 2 ∈ J₃_Ω
            rw [← map_pow, hw_sq_B, map_add, map_sum]
            refine Submodule.add_mem_sup ?_ ?_
            · refine Submodule.sum_mem Ĩ_Ω fun ν _ => ?_
              rw [map_mul, MvPolynomial.map_map, ← hftilde_Ω_map ν]
              exact Ideal.mul_mem_left Ĩ_Ω _ (Ideal.subset_span ⟨ν, rfl⟩)
            · rw [hMem_origMax_pow 3]
              intro d hd
              rw [MvPolynomial.coeff_map, hq₃_B_pow d hd, map_zero]

          let u_sh := shiftEquiv x_Ω u_Ω
          let v_sh := shiftEquiv x_Ω v_Ω
          have hu_orig : u_sh ∈ origMax Ω m := (hShift_mem_ker x_Ω u_Ω).mp hu_M
          have hv_orig : v_sh ∈ origMax Ω m := (hShift_mem_ker x_Ω v_Ω).mp hv_M
          have huv_sh_J₃ : u_sh * v_sh ∈ J₃_Ω := by
            rw [← map_mul]
            exact (hShift_sup_mem _ x_Ω 3 (u_Ω * v_Ω)).mp huv_3
          have hDecomp_orig : ∀ P ∈ origMax Ω m,
              ∃ lam₁ lam₂ : Ω, P - (MvPolynomial.C lam₁ * u_sh + MvPolynomial.C lam₂ * v_sh) ∈ J₂_Ω := by
            intro P hP
            have hpre : (shiftEquiv x_Ω).symm P ∈
                Ideal.span (Set.range (fun ν : Fin t => MvPolynomial.map (φ.comp ψ) (f ν))) ⊔
                  (RingHom.ker (MvPolynomial.aeval x_Ω).toRingHom) ^ 2 ⊔ Ideal.span {u_Ω, v_Ω} := by
              apply hM_le
              rw [hShift_mem_ker x_Ω, (shiftEquiv x_Ω).apply_symm_apply]
              exact hP
            rcases Submodule.mem_sup.mp hpre with ⟨q₁, hq₁, q₂, hq₂, hEq⟩
            obtain ⟨A₁, A₂, rfl⟩ := Ideal.mem_span_pair.mp hq₂
            have hP_eq : P = shiftEquiv x_Ω q₁ +
                (shiftEquiv x_Ω A₁ * u_sh + shiftEquiv x_Ω A₂ * v_sh) := by
              have h := congrArg (shiftEquiv x_Ω) hEq
              simpa [map_add, map_mul, u_sh, v_sh] using h.symm
            let B₁_p := shiftEquiv x_Ω A₁
            let B₂_p := shiftEquiv x_Ω A₂
            let lam₁ := MvPolynomial.constantCoeff B₁_p
            let lam₂ := MvPolynomial.constantCoeff B₂_p
            refine ⟨lam₁, lam₂, ?_⟩
            have hB₁_orig : B₁_p - MvPolynomial.C lam₁ ∈ origMax Ω m := by simp [origMax, lam₁]
            have hB₂_orig : B₂_p - MvPolynomial.C lam₂ ∈ origMax Ω m := by simp [origMax, lam₂]
            have hdiff_eq : P - (MvPolynomial.C lam₁ * u_sh + MvPolynomial.C lam₂ * v_sh) =
                shiftEquiv x_Ω q₁ + ((B₁_p - MvPolynomial.C lam₁) * u_sh +
                  (B₂_p - MvPolynomial.C lam₂) * v_sh) := by
              rw [hP_eq]; ring
            rw [hdiff_eq]
            refine add_mem ((hShift_sup_mem _ x_Ω 2 q₁).mp hq₁) (Ideal.mem_sup_right ?_)
            rw [sq]
            exact add_mem (Ideal.mul_mem_mul hB₁_orig hu_orig) (Ideal.mul_mem_mul hB₂_orig hv_orig)

          have hJ₃_le_J₂_Ω : J₃_Ω ≤ J₂_Ω :=
            sup_le_sup_left (Ideal.pow_le_pow_right (by norm_num : 2 ≤ 3)) _
          let q₃₂_Ω_alg : R₃_Ω →ₐ[Ω] R₂_Ω :=
            Ideal.Quotient.liftₐ J₃_Ω (Ideal.Quotient.mkₐ Ω J₂_Ω)
              (fun P hP => Ideal.Quotient.eq_zero_iff_mem.mpr (hJ₃_le_J₂_Ω hP))
          let q₃₂_Ω : R₃_Ω →ₗ[Ω] R₂_Ω := q₃₂_Ω_alg.toLinearMap
          have hq₃₂_Ω_range : LinearMap.range q₃₂_Ω = ⊤ := by
            rw [eq_top_iff]
            intro z _
            obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective z
            exact ⟨Ideal.Quotient.mk J₃_Ω P, rfl⟩
          have hfin_ker_Ω : Module.finrank Ω (LinearMap.ker q₃₂_Ω) = 2 := by
            have hrk := LinearMap.finrank_range_add_finrank_ker q₃₂_Ω
            rw [hq₃₂_Ω_range, finrank_top, hfin_R₂_Ω, hfin_R₃_Ω] at hrk
            omega

          have hMul_orig_J₂ : ∀ (r δ : MvPolynomial (Fin m) Ω),
              r ∈ origMax Ω m → δ ∈ J₂_Ω → r * δ ∈ J₃_Ω := by
            intro r δ hr hδ
            rcases Submodule.mem_sup.mp hδ with ⟨d₁, hd₁, d₂, hd₂, rfl⟩
            rw [mul_add]
            refine Submodule.add_mem_sup (Ideal.mul_mem_left Ĩ_Ω r hd₁) ?_
            have h3 : (origMax Ω m) ^ 3 = origMax Ω m * (origMax Ω m) ^ 2 := by rw [pow_succ']
            rw [h3]
            exact Ideal.mul_mem_mul hr hd₂
          have hProd_mod_J₃ : ∀ (p q : MvPolynomial (Fin m) Ω) (a₁ a₂ b₁ b₂ : Ω),
              p ∈ origMax Ω m → q ∈ origMax Ω m →
              p - (MvPolynomial.C a₁ * u_sh + MvPolynomial.C a₂ * v_sh) ∈ J₂_Ω →
              q - (MvPolynomial.C b₁ * u_sh + MvPolynomial.C b₂ * v_sh) ∈ J₂_Ω →
              Ideal.Quotient.mk J₃_Ω (p * q) =
                (a₁ * b₁) • Ideal.Quotient.mk J₃_Ω (u_sh ^ 2) +
                (a₂ * b₂) • Ideal.Quotient.mk J₃_Ω (v_sh ^ 2) := by
            intro p q a₁ a₂ b₁ b₂ hp hq hdp hdq
            let δ_p := p - (MvPolynomial.C a₁ * u_sh + MvPolynomial.C a₂ * v_sh)
            let δ_q := q - (MvPolynomial.C b₁ * u_sh + MvPolynomial.C b₂ * v_sh)
            have hp_eq : p = MvPolynomial.C a₁ * u_sh + MvPolynomial.C a₂ * v_sh + δ_p := by
              dsimp [δ_p]; ring
            have hq_eq : q = MvPolynomial.C b₁ * u_sh + MvPolynomial.C b₂ * v_sh + δ_q := by
              dsimp [δ_q]; ring
            have hδq_orig : δ_q ∈ origMax Ω m := by
              refine sub_mem hq (add_mem (Ideal.mul_mem_left _ _ hu_orig) (Ideal.mul_mem_left _ _ hv_orig))
            have hrem_J₃ :
                (MvPolynomial.C (a₁ * b₂ + a₂ * b₁) * (u_sh * v_sh)) +
                ((MvPolynomial.C a₁ * u_sh + MvPolynomial.C a₂ * v_sh) * δ_q) +
                ((MvPolynomial.C b₁ * u_sh + MvPolynomial.C b₂ * v_sh) * δ_p) +
                (δ_p * δ_q) ∈ J₃_Ω := by
              refine add_mem (add_mem (add_mem ?_ ?_) ?_) ?_
              · exact Ideal.mul_mem_left J₃_Ω _ huv_sh_J₃
              · exact hMul_orig_J₂ _ δ_q
                  (add_mem (Ideal.mul_mem_left _ _ hu_orig) (Ideal.mul_mem_left _ _ hv_orig)) hdq
              · exact hMul_orig_J₂ _ δ_p
                  (add_mem (Ideal.mul_mem_left _ _ hu_orig) (Ideal.mul_mem_left _ _ hv_orig)) hdp
              · rw [mul_comm]
                exact hMul_orig_J₂ δ_q δ_p hδq_orig hdp
            have hexpand : p * q -
                (MvPolynomial.C (a₁ * b₁) * u_sh ^ 2 + MvPolynomial.C (a₂ * b₂) * v_sh ^ 2) =
                (MvPolynomial.C (a₁ * b₂ + a₂ * b₁) * (u_sh * v_sh)) +
                ((MvPolynomial.C a₁ * u_sh + MvPolynomial.C a₂ * v_sh) * δ_q) +
                ((MvPolynomial.C b₁ * u_sh + MvPolynomial.C b₂ * v_sh) * δ_p) +
                (δ_p * δ_q) := by
              rw [hp_eq, hq_eq]
              simp only [map_add, map_mul]
              ring
            have hq0 : Ideal.Quotient.mk J₃_Ω
                (p * q - (MvPolynomial.C (a₁ * b₁) * u_sh ^ 2 + MvPolynomial.C (a₂ * b₂) * v_sh ^ 2)) = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr (hexpand ▸ hrem_J₃)
            have hAlgR₃_Ω : ∀ c : Ω,
                algebraMap Ω (MvPolynomial (Fin m) Ω ⧸ J₃_Ω) c =
                  Ideal.Quotient.mk J₃_Ω (MvPolynomial.C c) := fun _ => rfl
            rw [map_sub, sub_eq_zero, map_add] at hq0
            rw [hq0]
            simp [Algebra.smul_def, hAlgR₃_Ω, map_mul]

          let u2_ker : LinearMap.ker q₃₂_Ω :=
            ⟨Ideal.Quotient.mk J₃_Ω (u_sh ^ 2),
              Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_right (Ideal.pow_mem_pow hu_orig 2))⟩
          let v2_ker : LinearMap.ker q₃₂_Ω :=
            ⟨Ideal.Quotient.mk J₃_Ω (v_sh ^ 2),
              Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_right (Ideal.pow_mem_pow hv_orig 2))⟩
          have hTop_span_uv : (⊤ : Submodule Ω (LinearMap.ker q₃₂_Ω)) ≤
              Submodule.span Ω (Set.range ![u2_ker, v2_ker]) := by
            rintro ⟨z, hz⟩ _
            obtain ⟨Q, rfl⟩ := Ideal.Quotient.mk_surjective z
            have hQ_J₂ : Q ∈ J₂_Ω := Ideal.Quotient.eq_zero_iff_mem.mp hz
            rcases Submodule.mem_sup.mp hQ_J₂ with ⟨q₁, hq₁, q₂, hq₂, rfl⟩
            have hq₁_zero : Ideal.Quotient.mk J₃_Ω q₁ = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_left hq₁)
            suffices hpow_span : ∀ R ∈ (origMax Ω m) ^ 2,
                ∃ c₁ c₂ : Ω, Ideal.Quotient.mk J₃_Ω R = c₁ • u2_ker.1 + c₂ • v2_ker.1 by
              obtain ⟨c₁, c₂, hc⟩ := hpow_span q₂ hq₂
              have hsub_eq : (⟨Ideal.Quotient.mk J₃_Ω (q₁ + q₂), hz⟩ : LinearMap.ker q₃₂_Ω) =
                  c₁ • u2_ker + c₂ • v2_ker := by
                apply Subtype.ext
                change Ideal.Quotient.mk J₃_Ω (q₁ + q₂) = c₁ • u2_ker.1 + c₂ • v2_ker.1
                rw [map_add, hq₁_zero, zero_add, hc]
              rw [hsub_eq]
              exact add_mem
                (Submodule.smul_mem _ _ (Submodule.subset_span ⟨0, rfl⟩))
                (Submodule.smul_mem _ _ (Submodule.subset_span ⟨1, rfl⟩))
            intro R hR
            rw [sq] at hR
            refine Submodule.mul_induction_on hR ?_ ?_
            · intro p hp q hq
              obtain ⟨a₁, a₂, hdp⟩ := hDecomp_orig p hp
              obtain ⟨b₁, b₂, hdq⟩ := hDecomp_orig q hq
