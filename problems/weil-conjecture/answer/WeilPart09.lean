    haveI : ∀ 𝔭 : ↥(minimalPrimes C_aff), Module.Finite k₀ ↥(V_p 𝔭 D) :=
      fun 𝔭 => (hVp_fin_le 𝔭).1.some
    haveI hFin_PiD : Module.Finite k₀ (∀ 𝔭 : ↥(minimalPrimes C_aff), ↥(V_p 𝔭 D)) :=
      Module.Finite.pi
    haveI : Module.Finite k₀ ↥(LinearMap.ker (π_D D)) :=
      @FiniteDimensional.finiteDimensional_submodule k₀ _ _ _ _ hFin_PiD (LinearMap.ker (π_D D))
    haveI : Module.Finite k₀ Quo := hCondFin.1
    haveI : Module.Finite k₀ ↥(Q_k0 D) := (hHilb0 D hD₁_le).1
    have hf_mem_Vp : ∀ (f : ↥(Q_k0 D)) (𝔭 : ↥(minimalPrimes C_aff)),
        algebraMap (C_aff ⧸ 𝔭.1) (K_p 𝔭) (Ideal.Quotient.mk 𝔭.1 f.1) ∈ V_p 𝔭 D := by
      intro f 𝔭
      refine ⟨(integralClosure _ _).algebraMap_mem _, ?_⟩
      simp only [SetLike.mem_coe, Submodule.mem_iInf, Submodule.mem_comap, LinearMap.mulLeft_apply,
        Subalgebra.mem_toSubmodule]
      exact ((hP2 𝔭).2.2.1 D _).mp (fun j => hPoleQ D f.1 f.2 𝔭 j)
    let ψ_D : ↥(Q_k0 D) →ₗ[k₀] (∀ 𝔭 : ↥(minimalPrimes C_aff), ↥(V_p 𝔭 D)) :=
      { toFun := fun f 𝔭 => ⟨algebraMap (C_aff ⧸ 𝔭.1) (K_p 𝔭) (Ideal.Quotient.mk 𝔭.1 f.1),
          hf_mem_Vp f 𝔭⟩
        map_add' := fun f₁ f₂ => funext fun 𝔭 => Subtype.ext (by simp)
        map_smul' := fun c f => funext fun 𝔭 => Subtype.ext (by
          change algebraMap (C_aff ⧸ 𝔭.1) (K_p 𝔭) (Ideal.Quotient.mk 𝔭.1 (c • f.1)) =
            c • algebraMap (C_aff ⧸ 𝔭.1) (K_p 𝔭) (Ideal.Quotient.mk 𝔭.1 f.1)
          have hsmul : Ideal.Quotient.mk 𝔭.1 (c • f.1) = c • Ideal.Quotient.mk 𝔭.1 f.1 := by
            simp [Algebra.smul_def]
          rw [hsmul, Algebra.smul_def, map_mul,
            ← IsScalarTower.algebraMap_apply k₀ (C_aff ⧸ 𝔭.1) (K_p 𝔭) c, Algebra.smul_def]) }
    have hι_ψ : ∀ f : ↥(Q_k0 D), (ι_tot D (ψ_D f)).1 = algebraMap C_aff Q f.1 := by
      intro f
      have h1 : (fun 𝔭 : ↥(minimalPrimes C_aff) => (ψ_D f 𝔭).1) = Φ_Q (algebraMap C_aff Q f.1) := by
        ext 𝔭
        exact (hΦ_alg f.1 𝔭).symm
      change Φ_Q.symm (fun 𝔭 => (ψ_D f 𝔭).1) = _
      rw [h1, Φ_Q.symm_apply_apply]
    have hψ_ker : ∀ f : ↥(Q_k0 D), ψ_D f ∈ LinearMap.ker (π_D D) := by
      intro f
      change ι_tot D (ψ_D f) ∈ LinearMap.ker π_cond
      rw [Submodule.ker_mkQ, Submodule.mem_comap, Submodule.coe_subtype, hι_ψ f]
      exact ⟨f.1, rfl⟩
    let ψ_ker : ↥(Q_k0 D) →ₗ[k₀] ↥(LinearMap.ker (π_D D)) :=
      LinearMap.codRestrict (LinearMap.ker (π_D D)) ψ_D hψ_ker
    have hInj_ψ : Function.Injective ψ_ker := by
      intro f₁ f₂ hEq
      have hEq_D : ψ_D f₁ = ψ_D f₂ := congrArg Subtype.val hEq
      have hAlg : algebraMap C_aff Q f₁.1 = algebraMap C_aff Q f₂.1 := by
        rw [← hι_ψ f₁, ← hι_ψ f₂, hEq_D]
      exact Subtype.ext (hInjQ hAlg)
    have hKer_lb : D * d_E + 1 ≤ Module.finrank k₀ ↥(LinearMap.ker (π_D D)) := by
      have h := LinearMap.finrank_le_finrank_of_injective hInj_ψ
      rwa [(hHilb0 D hD₁_le).2] at h
    have hRange_rk : Module.finrank k₀ ↥(LinearMap.range (π_D D)) = s_sing := by
      rw [hRange_πD, finrank_top, hCondFin.2]
    have hRN := LinearMap.finrank_range_add_finrank_ker (π_D D)
    rw [hRange_rk, Module.finrank_pi_fintype k₀] at hRN
    have hSum1 : ∑ 𝔭 : ↥(minimalPrimes C_aff), Module.finrank k₀ ↥(V_p 𝔭 D) ≤
        ∑ 𝔭 : ↥(minimalPrimes C_aff), (D * d_p 𝔭 + 1) :=
      Finset.sum_le_sum (fun 𝔭 _ => (hVp_fin_le 𝔭).2)
    have hSum2 : ∑ 𝔭 : ↥(minimalPrimes C_aff), (D * d_p 𝔭 + 1) ≤ D * d_E + c_num := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const, Finset.card_univ,
        smul_eq_mul, mul_one, hCardMin]
      exact Nat.add_le_add_right (Nat.mul_le_mul_left D hDegSum) c_num
    exact ⟨by omega, hSum1, hSum2⟩
  refine ⟨by omega, ?_⟩
  intro hc_le hIC 𝔭
  have hSumEq : ∑ 𝔮 : ↥(minimalPrimes C_aff), Module.finrank k₀ ↥(V_p 𝔮 D) =
      ∑ 𝔮 : ↥(minimalPrimes C_aff), (D * d_p 𝔮 + 1) := by omega
  have hVp_eq : Module.finrank k₀ ↥(V_p 𝔭 D) = D * d_p 𝔭 + 1 :=
    (Finset.sum_eq_sum_iff_of_le (fun 𝔮 _ => (hVp_fin_le 𝔮).2)).mp hSumEq 𝔭 (Finset.mem_univ 𝔭)
  have hPole2_Wp : 2 ≤ Module.finrank k₀ ↥(W_p 𝔭 (Pi.single 0 1)) := by
    have h1_le_Dm : 1 ≤ D * m_mult 𝔭 0 := by
      have h1D : 1 ≤ D := hD₁.trans hD₁_le
      have h1m : 1 ≤ m_mult 𝔭 0 := (hMult 𝔭).2 0
      exact Nat.mul_le_mul h1D h1m
    have he_le : (Pi.single 0 1 : Fin (r_p 𝔭 + 1) → ℕ) ≤ (fun j => D * m_mult 𝔭 j) := by
      intro j
      by_cases hj : j = 0
      · subst hj; simpa using h1_le_Dm
      · simp [hj]
    have hIneq := ((hP2 𝔭).2.1 (Pi.single 0 1) (fun j => D * m_mult 𝔭 j) he_le).2.2
    have hSum1 : ∑ j : Fin (r_p 𝔭 + 1), (Pi.single 0 1 : Fin (r_p 𝔭 + 1) → ℕ) j = 1 :=
      Fintype.sum_pi_single' 0 1
    have hSum2 : ∑ j : Fin (r_p 𝔭 + 1), D * m_mult 𝔭 j = D * d_p 𝔭 := by
      rw [← Finset.mul_sum, (hMult 𝔭).1]
    change Module.finrank k₀ ↥(V_p 𝔭 D) + _ ≤ _ at hIneq
    rw [hVp_eq, hSum1, hSum2] at hIneq
    omega
  letI : 𝔭.1.IsPrime := 𝔭.2.1.1
  letI : IsIntegrallyClosed (C_aff ⧸ 𝔭.1) := hIC 𝔭.1 𝔭.2
  let A := C_aff ⧸ 𝔭.1
  let W_A : (Fin (r_p 𝔭 + 1) → ℕ) → Submodule k₀ A :=
    fun e => ⨅ j : Fin (r_p 𝔭 + 1),
      (O_m 𝔭 j).toSubmodule.comap
        ((LinearMap.mulLeft k₀ ((t_m 𝔭 j : K_p 𝔭) ^ (e j))).comp
          (IsScalarTower.toAlgHom k₀ A (K_p 𝔭)).toLinearMap)
  have hEquiv_WA : ∀ e : Fin (r_p 𝔭 + 1) → ℕ, Nonempty (↥(W_A e) ≃ₗ[k₀] ↥(W_p 𝔭 e)) := by
    intro e
    have hMap_mem : ∀ x : ↥(W_A e), algebraMap A (K_p 𝔭) x.1 ∈ W_p 𝔭 e := by
      intro x
      refine ⟨(integralClosure _ _).algebraMap_mem x.1, ?_⟩
      have hx := x.2
      simp only [W_A, Submodule.mem_iInf, Submodule.mem_comap, LinearMap.coe_comp,
        Function.comp_apply, LinearMap.mulLeft_apply, Subalgebra.mem_toSubmodule,
        AlgHom.toLinearMap_apply, IsScalarTower.toAlgHom_apply] at hx
      simp only [SetLike.mem_coe, Submodule.mem_iInf, Submodule.mem_comap, LinearMap.mulLeft_apply,
        Subalgebra.mem_toSubmodule]
      exact hx
    let φ_e : ↥(W_A e) →ₗ[k₀] ↥(W_p 𝔭 e) :=
      { toFun := fun x => ⟨algebraMap A (K_p 𝔭) x.1, hMap_mem x⟩
        map_add' := fun x₁ x₂ => Subtype.ext (map_add _ x₁.1 x₂.1)
        map_smul' := fun c x => Subtype.ext (by
          change algebraMap A (K_p 𝔭) (c • x.1) = c • algebraMap A (K_p 𝔭) x.1
          rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply k₀ A (K_p 𝔭) c,
            Algebra.smul_def]) }
    have hInj_e : Function.Injective φ_e := by
      intro x₁ x₂ hEq
      exact Subtype.ext (IsFractionRing.injective A (K_p 𝔭) (congrArg Subtype.val hEq))
    have hSurj_e : Function.Surjective φ_e := by
      intro y
      have hy_int : IsIntegral A y.1 := y.2.1
      obtain ⟨x, hx⟩ := IsIntegrallyClosed.isIntegral_iff.mp hy_int
      have hx_mem : x ∈ W_A e := by
        simp only [W_A, Submodule.mem_iInf, Submodule.mem_comap, LinearMap.coe_comp,
          Function.comp_apply, LinearMap.mulLeft_apply, Subalgebra.mem_toSubmodule,
          AlgHom.toLinearMap_apply, IsScalarTower.toAlgHom_apply]
        have hy2 := y.2.2
        simp only [SetLike.mem_coe, Submodule.mem_iInf, Submodule.mem_comap, LinearMap.mulLeft_apply,
          Subalgebra.mem_toSubmodule] at hy2
        intro j
        rw [hx]
        exact hy2 j
      exact ⟨⟨x, hx_mem⟩, Subtype.ext hx⟩
    exact ⟨LinearEquiv.ofBijective φ_e ⟨hInj_e, hSurj_e⟩⟩
  have hFinUpper_A : ∀ e : Fin (r_p 𝔭 + 1) → ℕ,
      Module.Finite k₀ ↥(W_A e) ∧ Module.finrank k₀ ↥(W_A e) ≤ (∑ j : Fin (r_p 𝔭 + 1), e j) + 1 := by
    intro e
    obtain ⟨eqv⟩ := hEquiv_WA e
    obtain ⟨_, ⟨hFin_We⟩, hIneq_We⟩ := (hP2 𝔭).2.1 0 e (fun _ => Nat.zero_le _)
    haveI : Module.Finite k₀ ↥(W_p 𝔭 e) := hFin_We
    have hFinA : Module.Finite k₀ ↥(W_A e) := Module.Finite.equiv eqv.symm
    have hRank0 := (hP2 𝔭).1.2
    simp only [Pi.zero_apply, Finset.sum_const_zero, add_zero] at hIneq_We
    rw [eqv.finrank_eq]
    exact ⟨hFinA, by omega⟩
  have hPole2_A : 2 ≤ Module.finrank k₀ ↥(W_A (Pi.single 0 1)) := by
    obtain ⟨eqv⟩ := hEquiv_WA (Pi.single 0 1)
    rwa [eqv.finrank_eq]
  have hExh_A : ∀ z : A, ∃ N : ℕ, 1 ≤ N ∧ z ∈ W_A (fun j => N * m_mult 𝔭 j) := by
    intro z
    obtain ⟨N, hN1, hz_mem⟩ :=
      (hP2 𝔭).2.2.2 (algebraMap A (K_p 𝔭) z) ((integralClosure _ _).algebraMap_mem z)
    refine ⟨N, hN1, ?_⟩
    have hz2 := hz_mem.2
    simp only [SetLike.mem_coe, Submodule.mem_iInf, Submodule.mem_comap, LinearMap.mulLeft_apply,
      Subalgebra.mem_toSubmodule] at hz2
    simp only [W_A, Submodule.mem_iInf, Submodule.mem_comap, LinearMap.coe_comp,
      Function.comp_apply, LinearMap.mulLeft_apply, Subalgebra.mem_toSubmodule,
      AlgHom.toLinearMap_apply, IsScalarTower.toAlgHom_apply]
    exact hz2
  exact pillar3 A (r_p 𝔭) (O_m 𝔭) (t_m 𝔭) (m_mult 𝔭) (hConst 𝔭) hFinUpper_A hPole2_A hExh_A

theorem weil_twoChart_integral_polar_projLine_iso (k₀ : Type u) [Field k₀]
    (hAff_P1 : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen k₀ 1 a))
    (c_P1 : ∀ a : Fin (1 + 1),
      k₀ →+* ↑((weilProjectiveSpaceOver k₀ 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen k₀ 1 a))))
    (t_P1 : ∀ a : Fin (1 + 1), Fin (1 + 1) →
      ↑((weilProjectiveSpaceOver k₀ 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen k₀ 1 a))))
    (hCoordP1 : IsCommRingProjCoordSystem k₀ 1 hAff_P1 c_P1 t_P1)
    (hBirIso : ∀ (C_bar : AlgebraicGeometry.Scheme.{u})
        (F_ss : Type u) [Field F_ss]
        (f' : C_bar ⟶ (weilProjectiveSpaceOver k₀ 1).left)
        (η_C : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ C_bar)
        (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ (weilProjectiveSpaceOver k₀ 1).left),
      AlgebraicGeometry.IsIntegral C_bar →
      AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k₀ 1).left →
      IsAffineNormalScheme (weilProjectiveSpaceOver k₀ 1).left →
      AlgebraicGeometry.IsProper f' →
      AlgebraicGeometry.IsDominant η_C →
      η_C ≫ f' = η_X →
      IsSchemeFunctionField C_bar F_ss η_C →
      IsSchemeFunctionField (weilProjectiveSpaceOver k₀ 1).left F_ss η_X →
      (∀ z : C_bar,
        ∃ (U_X : (weilProjectiveSpaceOver k₀ 1).left.Opens)
          (_ : AlgebraicGeometry.IsAffineOpen U_X)
          (V_C : C_bar.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
          (e_X : V_C ≤ (TopologicalSpace.Opens.map f'.base).obj U_X),
          z ∈ V_C ∧
          (f'.appLE U_X V_C e_X).hom.FiniteType ∧
          (f'.appLE U_X V_C e_X).hom.QuasiFinite) →
      CategoryTheory.IsIso f')
    (hFuncField : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      AlgebraicGeometry.IsIntegral Y →
      ∀ (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀)),
        ∃ (F : Type u) (_ : Field F) (_ : Algebra k₀ F)
          (η : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y),
          η ≫ p = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₀ F)) ∧
          IsSchemeFunctionField Y F η ∧
          ∀ (U : Y.Opens), Nonempty U →
            ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)), η.base pt ∈ U)
    (Y : AlgebraicGeometry.Scheme.{u})
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    [AlgebraicGeometry.IsIntegral Y]
    [AlgebraicGeometry.IsProper p_Y]
    (U₀ U₁ : Y.Opens)
    (hU0 : AlgebraicGeometry.IsAffineOpen U₀)
    (hU1 : AlgebraicGeometry.IsAffineOpen U₁)
    (hCov : U₀ ⊔ U₁ = ⊤)
    (hNe0 : Nonempty ↥U₀)
    (hNe1 : Nonempty ↥U₁)
    (y_inf : ↑(Y.presheaf.obj (Opposite.op U₀)))
    (hy_inf : Y.basicOpen y_inf = U₀ ⊓ U₁)
    (c_u : ↑(Y.presheaf.obj (Opposite.op U₁)))
    (s₁ a₁ s_reg b_reg : ↑(Y.presheaf.obj (Opposite.op U₀)))
    (hs₁_ne : s₁ ≠ 0)
    (hs_reg_ne : s_reg ≠ 0)
    (hPoleEq :
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op).hom a₁ *
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op).hom c_u =
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op).hom s₁)
    (hRegEq :
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op).hom s_reg *
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op).hom c_u =
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op).hom b_reg)
    (hAvoid : ∀ (𝔭 : Ideal ↑(Y.presheaf.obj (Opposite.op U₀))),
      𝔭.IsPrime → y_inf ∈ 𝔭 → (s₁ ∉ 𝔭 ∨ s_reg ∉ 𝔭))
    (hRat :
      letI : Algebra k₀ ↑(Y.presheaf.obj (Opposite.op U₁)) :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ U₁ le_top).hom).toAlgebra
      (∀ P : Polynomial k₀, Polynomial.aeval c_u P = 0 → P = 0) ∧
      (∀ z : ↑(Y.presheaf.obj (Opposite.op U₁)),
        ∃ P Q : Polynomial k₀, Q ≠ 0 ∧
          z * Polynomial.aeval c_u Q = Polynomial.aeval c_u P)) :
    ∃ isoP1 : Y ≅ (weilProjectiveSpaceOver k₀ 1).left,
      p_Y = isoP1.hom ≫ (weilProjectiveSpaceOver k₀ 1).hom :=
by
  classical
  obtain ⟨hProp_P1, hCov_P1, hcSpec_P1, _hMv_P1, htDiag_P1, hGen_P1,
      hUniv_P1, hBasic_P1, hScalar_P1, hCocycle_P1⟩ := hCoordP1
  suffices hGen : ∀ (P₁ : AlgebraicGeometry.Scheme.{u})
      (p_P1 : P₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
      (V_chart : Fin (1 + 1) → P₁.Opens)
      (hAff_P1 : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (V_chart a))
      (c_P1 : ∀ a : Fin (1 + 1), k₀ →+* ↑(P₁.presheaf.obj (Opposite.op (V_chart a))))
      (t_P1 : ∀ a : Fin (1 + 1), Fin (1 + 1) → ↑(P₁.presheaf.obj (Opposite.op (V_chart a)))),
      AlgebraicGeometry.IsProper p_P1 →
      (⨆ a : Fin (1 + 1), V_chart a) = ⊤ →
      (∀ a : Fin (1 + 1),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_P1 a)) =
          (hAff_P1 a).fromSpec ≫ p_P1) →
      (∀ a : Fin (1 + 1), t_P1 a a = 1) →
      (∀ a : Fin (1 + 1),
        Subring.closure (Set.range (c_P1 a) ∪ Set.range (t_P1 a)) = ⊤) →
      (∀ (a : Fin (1 + 1)) (A : Type u) [CommRing A] (ρ : k₀ →+* A) (v : Fin (1 + 1) → A),
        v a = 1 →
        ∃ ψ : ↑(P₁.presheaf.obj (Opposite.op (V_chart a))) →+* A,
          ψ.comp (c_P1 a) = ρ ∧ ∀ b : Fin (1 + 1), ψ (t_P1 a b) = v b) →
      (∀ a a' : Fin (1 + 1), P₁.basicOpen (t_P1 a a') = V_chart a ⊓ V_chart a') →
      (∀ (a a' : Fin (1 + 1)) (r : k₀),
        (P₁.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (c_P1 a' r) =
          (P₁.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (c_P1 a r)) →
      (∀ (a a' b : Fin (1 + 1)),
        (P₁.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (t_P1 a' b) *
          (P₁.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (t_P1 a a') =
          (P₁.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (t_P1 a b)) →
      (∀ (C_bar : AlgebraicGeometry.Scheme.{u})
          (F_ss : Type u) [Field F_ss]
          (f' : C_bar ⟶ P₁)
          (η_C : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ C_bar)
          (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ P₁),
        AlgebraicGeometry.IsIntegral C_bar →
        AlgebraicGeometry.IsIntegral P₁ →
        IsAffineNormalScheme P₁ →
        AlgebraicGeometry.IsProper f' →
        AlgebraicGeometry.IsDominant η_C →
        η_C ≫ f' = η_X →
        IsSchemeFunctionField C_bar F_ss η_C →
        IsSchemeFunctionField P₁ F_ss η_X →
        (∀ z : C_bar,
          ∃ (U_X : P₁.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
            (V_C : C_bar.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
            (e_X : V_C ≤ (TopologicalSpace.Opens.map f'.base).obj U_X),
            z ∈ V_C ∧
            (f'.appLE U_X V_C e_X).hom.FiniteType ∧
            (f'.appLE U_X V_C e_X).hom.QuasiFinite) →
        CategoryTheory.IsIso f') →
      ∃ isoP1 : Y ≅ P₁, p_Y = isoP1.hom ≫ p_P1 from
    hGen (weilProjectiveSpaceOver k₀ 1).left (weilProjectiveSpaceOver k₀ 1).hom
      (weilProjBasicOpen k₀ 1) hAff_P1 c_P1 t_P1
      hProp_P1 hCov_P1 hcSpec_P1 htDiag_P1 hGen_P1 hUniv_P1
      hBasic_P1 hScalar_P1 hCocycle_P1 hBirIso
  intro P₁ p_P1 V_chart hAff_P1 c_P1 t_P1 hProp_P1 hCov_P1 hcSpec_P1
    htDiag_P1 hGen_P1 hUniv_P1 hBasic_P1 hScalar_P1 hCocycle_P1 hBirIso

  have hFin2 : ∀ b : Fin (1 + 1), b = 0 ∨ b = 1 := by
    intro b
    fin_cases b
    · exact Or.inl rfl
    · exact Or.inr rfl
  have hFin3 : ∀ i : Fin 3, i = 0 ∨ i = 1 ∨ i = 2 := by
    intro i
    fin_cases i
    · exact Or.inl rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr rfl)

  
  let Γ_chart : Fin (1 + 1) → Type u :=
    fun a => ↑(P₁.presheaf.obj (Opposite.op (V_chart a)))
  have he_P1_ex : ∀ a : Fin (1 + 1),
      ∃ e : Polynomial k₀ ≃+* Γ_chart a,
        e.toRingHom.comp Polynomial.C = c_P1 a ∧
        e Polynomial.X = t_P1 a (1 - a) := by
    intro a
    let a' : Fin (1 + 1) := 1 - a
    have ha'_ne : a' ≠ a := by
      rcases hFin2 a with rfl | rfl <;> decide
    let f_to : Polynomial k₀ →+* Γ_chart a :=
      Polynomial.eval₂RingHom (c_P1 a) (t_P1 a a')
    let v_poly : Fin (1 + 1) → Polynomial k₀ :=
      fun b => if b = a then 1 else Polynomial.X
    have hv_a : v_poly a = 1 := by simp [v_poly]
    obtain ⟨ψ_back, hψ_c, hψ_t⟩ := hUniv_P1 a (Polynomial k₀) Polynomial.C v_poly hv_a
    have h_gf : ψ_back.comp f_to = RingHom.id (Polynomial k₀) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro r
        change ψ_back (f_to (Polynomial.C r)) = Polynomial.C r
        dsimp [f_to]
        rw [Polynomial.eval₂_C]
        exact RingHom.congr_fun hψ_c r
      · change ψ_back (f_to Polynomial.X) = Polynomial.X
        dsimp [f_to]
        rw [Polynomial.eval₂_X, hψ_t a']
        simp [v_poly, ha'_ne]
    have h_fg : f_to.comp ψ_back = RingHom.id (Γ_chart a) := by
      have hSub : Set.range (c_P1 a) ∪ Set.range (t_P1 a) ⊆
          (RingHom.eqLocus (f_to.comp ψ_back) (RingHom.id (Γ_chart a)) : Set (Γ_chart a)) := by
        rintro x (⟨r, rfl⟩ | ⟨b, rfl⟩)
        · change f_to (ψ_back (c_P1 a r)) = c_P1 a r
          have hc_r : ψ_back (c_P1 a r) = Polynomial.C r := RingHom.congr_fun hψ_c r
          rw [hc_r]
          exact Polynomial.eval₂_C _ _
        · change f_to (ψ_back (t_P1 a b)) = t_P1 a b
          by_cases hba : b = a
          · subst hba
            rw [htDiag_P1 b, map_one, map_one]
          · have hba' : b = a' := by
              rcases hFin2 a with rfl | rfl <;> rcases hFin2 b with rfl | rfl <;>
                first | contradiction | rfl
            have hv_a' : v_poly a' = Polynomial.X := by simp [v_poly, ha'_ne]
            rw [hba', hψ_t a', hv_a']
            exact Polynomial.eval₂_X _ _
      have hTop : (⊤ : Subring (Γ_chart a)) ≤
          RingHom.eqLocus (f_to.comp ψ_back) (RingHom.id (Γ_chart a)) := by
        rw [← hGen_P1 a]
        exact Subring.closure_le.mpr hSub
      ext x
      exact hTop (Subring.mem_top x)
    let e : Polynomial k₀ ≃+* Γ_chart a := RingEquiv.ofRingHom f_to ψ_back h_fg h_gf
    refine ⟨e, ?_, ?_⟩
    · ext r
      exact Polynomial.eval₂_C _ _
    · exact Polynomial.eval₂_X _ _
  choose e_P1 he_P1_C he_P1_X using he_P1_ex
  have he_symm_c : ∀ (a : Fin (1 + 1)) (r : k₀),
      (e_P1 a).symm (c_P1 a r) = Polynomial.C r := by
    intro a r
    have hc : e_P1 a (Polynomial.C r) = c_P1 a r := RingHom.congr_fun (he_P1_C a) r
    rw [← hc, (e_P1 a).symm_apply_apply]
  have he_X0 : e_P1 0 Polynomial.X = t_P1 0 1 := by
    have h01 : (1 - (0 : Fin (1 + 1))) = 1 := by decide
    exact h01 ▸ he_P1_X 0
  have he_X1 : e_P1 1 Polynomial.X = t_P1 1 0 := by
    have h10 : (1 - (1 : Fin (1 + 1))) = 0 := by decide
    exact h10 ▸ he_P1_X 1
  have he_symm_t01 : (e_P1 0).symm (t_P1 0 1) = Polynomial.X := by
    rw [← he_X0, (e_P1 0).symm_apply_apply]
  have he_symm_t10 : (e_P1 1).symm (t_P1 1 0) = Polynomial.X := by
    rw [← he_X1, (e_P1 1).symm_apply_apply]

  
  have hDom_chart : ∀ a : Fin (1 + 1), IsDomain (Γ_chart a) :=
    fun a => @MulEquiv.isDomain (Γ_chart a) (Polynomial k₀) _ _ _ (e_P1 a).symm.toMulEquiv
  have ht01_ne : t_P1 0 1 ≠ 0 := by
    intro h0
    have : (Polynomial.X : Polynomial k₀) = 0 := by
      rw [← he_symm_t01, h0, map_zero]
    exact Polynomial.X_ne_zero this
  have hx_01_ex : ∃ x_01 : ↥P₁, x_01 ∈ V_chart 0 ∧ x_01 ∈ V_chart 1 := by
    have : IsDomain (Γ_chart 0) := hDom_chart 0
    let p_bot0 : PrimeSpectrum (Γ_chart 0) := ⊥
    have hp_mem : p_bot0 ∈ (hAff_P1 0).fromSpec ⁻¹ᵁ P₁.basicOpen (t_P1 0 1) := by
      rw [(hAff_P1 0).fromSpec_preimage_basicOpen (t_P1 0 1)]
      change t_P1 0 1 ∉ (⊥ : Ideal (Γ_chart 0))
      rwa [Ideal.mem_bot]
    have hx_bo : (hAff_P1 0).fromSpec.base p_bot0 ∈ P₁.basicOpen (t_P1 0 1) := hp_mem
    rw [hBasic_P1 0 1] at hx_bo
    exact ⟨(hAff_P1 0).fromSpec.base p_bot0, hx_bo.1, hx_bo.2⟩
  obtain ⟨x_01, hx_01⟩ := hx_01_ex
  let 𝒰_P1 := P₁.openCoverOfIsOpenCover V_chart (TopologicalSpace.IsOpenCover.mk hCov_P1)
  have hRed_V : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsReduced (V_chart a).toScheme := by
    intro a
    have : IsDomain ↑(P₁.presheaf.obj (Opposite.op (V_chart a))) := hDom_chart a
    have : CategoryTheory.IsIso (hAff_P1 a).isoSpec.hom := inferInstance
    exact AlgebraicGeometry.isReduced_of_isOpenImmersion (hAff_P1 a).isoSpec.hom
  have : ∀ i : 𝒰_P1.I₀, AlgebraicGeometry.IsReduced (𝒰_P1.X i) := hRed_V
  have : AlgebraicGeometry.IsReduced P₁ := AlgebraicGeometry.IsReduced.of_openCover P₁ 𝒰_P1
  have hMemChart : ∀ x : ↥P₁, x ∈ V_chart 0 ∨ x ∈ V_chart 1 := by
    intro x
    have hx_top : x ∈ (⨆ a, V_chart a) := by
      rw [hCov_P1]
      trivial
    obtain ⟨a, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp hx_top
    rcases hFin2 a with rfl | rfl
    · exact Or.inl hxa
    · exact Or.inr hxa
  have hPre_chart : ∀ a : Fin (1 + 1), IsPreirreducible (V_chart a : Set ↥P₁) := by
    intro a
    have : IsDomain ↑(P₁.presheaf.obj (Opposite.op (V_chart a))) := hDom_chart a
    have : IrreducibleSpace (PrimeSpectrum ↑(P₁.presheaf.obj (Opposite.op (V_chart a)))) :=
      PrimeSpectrum.irreducibleSpace
    have hEq : (V_chart a : Set ↥P₁) = (hAff_P1 a).fromSpec.base '' Set.univ := by
      rw [Set.image_univ, (hAff_P1 a).range_fromSpec]
    rw [hEq]
    exact PreirreducibleSpace.isPreirreducible_univ.image _
      (hAff_P1 a).fromSpec.continuous.continuousOn
  have : IrreducibleSpace ↥P₁ :=
    { toNonempty := ⟨x_01⟩
      isPreirreducible_univ := by
        intro A B hA hB ⟨yA, _, hyA⟩ ⟨yB, _, hyB⟩
        have hV0A : ((V_chart 0 : Set ↥P₁) ∩ A).Nonempty := by
          rcases hMemChart yA with hy0 | hy1
          · exact ⟨yA, hy0, hyA⟩
          · obtain ⟨w, _, hw0, hwA⟩ :=
              hPre_chart 1 (V_chart 0 : Set ↥P₁) A (V_chart 0).isOpen hA
                ⟨x_01, hx_01.2, hx_01.1⟩ ⟨yA, hy1, hyA⟩
            exact ⟨w, hw0, hwA⟩
        have hV0B : ((V_chart 0 : Set ↥P₁) ∩ B).Nonempty := by
          rcases hMemChart yB with hy0 | hy1
          · exact ⟨yB, hy0, hyB⟩
          · obtain ⟨w, _, hw0, hwB⟩ :=
              hPre_chart 1 (V_chart 0 : Set ↥P₁) B (V_chart 0).isOpen hB
                ⟨x_01, hx_01.2, hx_01.1⟩ ⟨yB, hy1, hyB⟩
            exact ⟨w, hw0, hwB⟩
        obtain ⟨z, _, hzA, hzB⟩ := hPre_chart 0 A B hA hB hV0A hV0B
        exact ⟨z, trivial, hzA, hzB⟩ }
  have hInt_P1 : AlgebraicGeometry.IsIntegral P₁ :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced P₁

  
  obtain ⟨F, instFieldF, instAlgF, η_Y, hη_p, hFuncY, hη_mem⟩ :=
    hFuncField Y inferInstance p_Y
  letI : Field F := instFieldF
  letI : Algebra k₀ F := instAlgF
  let pt_F : PrimeSpectrum F := ⊥
  have hDom_ηY : AlgebraicGeometry.IsDominant η_Y := by
    rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
    ext y
    simp only [Set.mem_univ, iff_true, mem_closure_iff]
    intro O hO hyO
    exact ⟨η_Y.base pt_F, hη_mem ⟨O, hO⟩ ⟨⟨y, hyO⟩⟩ pt_F, ⟨pt_F, rfl⟩⟩
  have : AlgebraicGeometry.IsDominant η_Y := hDom_ηY
  let α_Y : ∀ W : Y.Opens, k₀ →+* ↑(Y.presheaf.obj (Opposite.op W)) :=
    fun W => ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_Y.appLE ⊤ W le_top).hom
  have hSpec_α : ∀ (W : Y.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α_Y W)) = hW.fromSpec ≫ p_Y := by
    intro W hW
    have h1 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p_Y
      (AlgebraicGeometry.isAffineOpen_top _) hW le_top
    have h2 : (AlgebraicGeometry.isAffineOpen_top
        (AlgebraicGeometry.Spec (CommRingCat.of k₀))).fromSpec =
        AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv := by
      rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top,
        AlgebraicGeometry.Scheme.isoSpec_Spec_inv]
    rw [h2, ← AlgebraicGeometry.Spec.map_comp] at h1
    have h3 : CommRingCat.ofHom (α_Y W) =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ W le_top :=
      CommRingCat.ofHom_hom _
    rw [h3]
    exact h1
  have hφ_α_comp : ∀ (W : Y.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
      (φ_W : Y.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
      AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_Y →
      φ_W.hom.comp (α_Y W) = algebraMap k₀ F := by
    intro W hW φ_W hφW
    have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α_Y W) ≫ φ_W) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₀ F)) := by
      rw [AlgebraicGeometry.Spec.map_comp, hSpec_α W hW,
        ← CategoryTheory.Category.assoc, hφW, hη_p]
    have h2 : CommRingCat.ofHom (α_Y W) ≫ φ_W = CommRingCat.ofHom (algebraMap k₀ F) :=
      AlgebraicGeometry.Spec.map_injective h1
    exact congrArg CommRingCat.Hom.hom h2
  have hφ_α : ∀ (W : Y.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
      (φ_W : Y.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
      AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_Y →
      ∀ r : k₀, φ_W.hom (α_Y W r) = algebraMap k₀ F r :=
    fun W hW φ_W hφW r => RingHom.congr_fun (hφ_α_comp W hW φ_W hφW) r
  have hφ_res : ∀ {V W : Y.Opens}
      (hV : AlgebraicGeometry.IsAffineOpen V) (hW : AlgebraicGeometry.IsAffineOpen W)
      (hle : V ≤ W)
      (φ_V : Y.presheaf.obj (Opposite.op V) ⟶ CommRingCat.of F)
      (φ_W : Y.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
      AlgebraicGeometry.Spec.map φ_V ≫ hV.fromSpec = η_Y →
      AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_Y →
      ∀ x : ↑(Y.presheaf.obj (Opposite.op W)),
        φ_V.hom ((Y.presheaf.map (CategoryTheory.homOfLE hle).op).hom x) = φ_W.hom x := by
    intro V W hV hW hle φ_V φ_W h1 h2 x
    have hm := hW.map_fromSpec hV (CategoryTheory.homOfLE hle).op
    have heq : AlgebraicGeometry.Spec.map
        (Y.presheaf.map (CategoryTheory.homOfLE hle).op ≫ φ_V) ≫ hW.fromSpec =
        AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec := by
      rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hm, h1, h2]
    have heq2 := (CategoryTheory.cancel_mono hW.fromSpec).mp heq
    have heq3 := AlgebraicGeometry.Spec.map_injective heq2
    exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom heq3) x

  
  let R₀ : Type u := ↑(Y.presheaf.obj (Opposite.op U₀))
  let R₁ : Type u := ↑(Y.presheaf.obj (Opposite.op U₁))
  have hDom_R₀ : IsDomain R₀ := by
    have : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}) := hNe0
    exact @AlgebraicGeometry.IsIntegral.component_integral Y _ U₀ _
  have hDom_R₁ : IsDomain R₁ := by
    have : Nonempty ↥(U₁ : AlgebraicGeometry.Scheme.{u}) := hNe1
    exact @AlgebraicGeometry.IsIntegral.component_integral Y _ U₁ _
  have hU01 : AlgebraicGeometry.IsAffineOpen (U₀ ⊓ U₁) :=
    hy_inf ▸ hU0.basicOpen y_inf
  have hNe01 : Nonempty ↥(U₀ ⊓ U₁) := by
    rcases hNe0 with ⟨⟨x₀, hx₀⟩⟩
    rcases hNe1 with ⟨⟨x₁, hx₁⟩⟩
    obtain ⟨w, hw0, hw1⟩ :=
      nonempty_preirreducible_inter U₀.isOpen U₁.isOpen ⟨x₀, hx₀⟩ ⟨x₁, hx₁⟩
    exact ⟨⟨w, hw0, hw1⟩⟩
  obtain ⟨φ₀, hFrac₀, hφ₀⟩ := hFuncY U₀ hU0 hNe0
  obtain ⟨φ₁, hFrac₁, hφ₁⟩ := hFuncY U₁ hU1 hNe1
  obtain ⟨φ₀₁, _hFrac₀₁, hφ₀₁⟩ := hFuncY (U₀ ⊓ U₁) hU01 hNe01
  have hφ₀_inj : Function.Injective φ₀.hom :=
    @IsFractionRing.injective R₀ _ F _ φ₀.hom.toAlgebra hFrac₀
  have hφ₁_inj : Function.Injective φ₁.hom :=
    @IsFractionRing.injective R₁ _ F _ φ₁.hom.toAlgebra hFrac₁
  let u_F : F := φ₁.hom c_u
  have hres_01_0 := hφ_res hU01 hU0 (inf_le_left : U₀ ⊓ U₁ ≤ U₀) φ₀₁ φ₀ hφ₀₁ hφ₀
  have hres_01_1 := hφ_res hU01 hU1 (inf_le_right : U₀ ⊓ U₁ ≤ U₁) φ₀₁ φ₁ hφ₀₁ hφ₁
  have hPole_F : φ₀.hom a₁ * u_F = φ₀.hom s₁ := by
    have h := congrArg φ₀₁.hom hPoleEq
    rw [map_mul, hres_01_0 a₁, hres_01_1 c_u, hres_01_0 s₁] at h
    exact h
  have hReg_F : φ₀.hom s_reg * u_F = φ₀.hom b_reg := by
    have h := congrArg φ₀₁.hom hRegEq
    rw [map_mul, hres_01_0 s_reg, hres_01_1 c_u, hres_01_0 b_reg] at h
    exact h
  have hφs₁_ne : φ₀.hom s₁ ≠ 0 :=
    fun h0 => hs₁_ne (hφ₀_inj (h0.trans (map_zero φ₀.hom).symm))
  have hφs_reg_ne : φ₀.hom s_reg ≠ 0 :=
    fun h0 => hs_reg_ne (hφ₀_inj (h0.trans (map_zero φ₀.hom).symm))
  have hu_F_ne : u_F ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hPole_F
    exact hφs₁_ne hPole_F.symm
  have hRatio_pole : φ₀.hom a₁ * (φ₀.hom s₁)⁻¹ = u_F⁻¹ := by
    apply mul_right_cancel₀ hu_F_ne
    rw [inv_mul_cancel₀ hu_F_ne]
    calc
      (φ₀.hom a₁ * (φ₀.hom s₁)⁻¹) * u_F = (φ₀.hom a₁ * u_F) * (φ₀.hom s₁)⁻¹ := by ring
      _ = φ₀.hom s₁ * (φ₀.hom s₁)⁻¹ := by rw [hPole_F]
      _ = 1 := mul_inv_cancel₀ hφs₁_ne
  have hRatio_reg : φ₀.hom b_reg * (φ₀.hom s_reg)⁻¹ = u_F := by
    rw [← hReg_F, mul_comm (φ₀.hom s_reg) u_F, mul_assoc,
      mul_inv_cancel₀ hφs_reg_ne, mul_one]
  letI : Algebra k₀ R₁ := (α_Y U₁).toAlgebra
  obtain ⟨hTrans_cu, hRat_cu⟩ := hRat
  let ψ_poly0 : Polynomial k₀ →+* F := Polynomial.eval₂RingHom (algebraMap k₀ F) u_F
  have hψ_aeval : ∀ P : Polynomial k₀, φ₁.hom (Polynomial.aeval c_u P) = ψ_poly0 P := by
    intro P
    rw [Polynomial.aeval_def, Polynomial.hom_eval₂]
    change Polynomial.eval₂ (φ₁.hom.comp (α_Y U₁)) (φ₁.hom c_u) P =
      Polynomial.eval₂ (algebraMap k₀ F) u_F P
    rw [hφ_α_comp U₁ hU1 φ₁ hφ₁]
  have hψ0_inj : Function.Injective ψ_poly0 := by
    rw [injective_iff_map_eq_zero]
    intro P hP0
    rw [← hψ_aeval P] at hP0
    exact hTrans_cu P (hφ₁_inj (hP0.trans (map_zero φ₁.hom).symm))
  have hFrac_poly0 : @IsFractionRing (Polynomial k₀) _ F _ ψ_poly0.toAlgebra := by
    letI : Algebra (Polynomial k₀) F := ψ_poly0.toAlgebra
    exact
      { map_units := fun y => by
          have hy_ne : (y : Polynomial k₀) ≠ 0 := nonZeroDivisors.ne_zero y.2
          exact IsUnit.mk0 (ψ_poly0 y)
            (fun h0 => hy_ne (hψ0_inj (h0.trans (map_zero ψ_poly0).symm)))
        surj := fun w => by
          obtain ⟨⟨r, s⟩, hws⟩ :=
            @IsLocalization.surj R₁ _ (nonZeroDivisors R₁) F _ φ₁.hom.toAlgebra hFrac₁ w
          have hws' : w * φ₁.hom (s : R₁) = φ₁.hom r := hws
          have hs_ne : (s : R₁) ≠ 0 := nonZeroDivisors.ne_zero s.2
          obtain ⟨P_r, Q_r, hQr_ne, hEq_r⟩ := hRat_cu r
          obtain ⟨P_s, Q_s, hQs_ne, hEq_s⟩ := hRat_cu (s : R₁)
          have hPs_ne : P_s ≠ 0 := by
            intro hPs0
            rw [hPs0, map_zero] at hEq_s
            rcases mul_eq_zero.mp hEq_s with hs0 | hQs0
            · exact hs_ne hs0
            · exact hQs_ne (hTrans_cu Q_s hQs0)
          have hD_ne : P_s * Q_r ≠ 0 := mul_ne_zero hPs_ne hQr_ne
          let D_den : nonZeroDivisors (Polynomial k₀) :=
            ⟨P_s * Q_r, mem_nonZeroDivisors_of_ne_zero hD_ne⟩
          have hr_F : φ₁.hom r * ψ_poly0 Q_r = ψ_poly0 P_r := by
            have h := congrArg φ₁.hom hEq_r
            rwa [map_mul, hψ_aeval Q_r, hψ_aeval P_r] at h
          have hs_F : φ₁.hom (s : R₁) * ψ_poly0 Q_s = ψ_poly0 P_s := by
            have h := congrArg φ₁.hom hEq_s
            rwa [map_mul, hψ_aeval Q_s, hψ_aeval P_s] at h
          refine ⟨⟨P_r * Q_s, D_den⟩, ?_⟩
          change w * ψ_poly0 (P_s * Q_r) = ψ_poly0 (P_r * Q_s)
          rw [map_mul, map_mul, ← hs_F]
          calc
            w * ((φ₁.hom (s : R₁) * ψ_poly0 Q_s) * ψ_poly0 Q_r) =
              ((w * φ₁.hom (s : R₁)) * ψ_poly0 Q_r) * ψ_poly0 Q_s := by ring
            _ = (φ₁.hom r * ψ_poly0 Q_r) * ψ_poly0 Q_s := by rw [hws']
            _ = ψ_poly0 P_r * ψ_poly0 Q_s := by rw [hr_F]
        exists_of_eq := fun hxy => ⟨1, by simp [hψ0_inj hxy]⟩ }

  
  let χ_0 : Γ_chart 0 →+* F := ψ_poly0.comp (e_P1 0).symm.toRingHom
  let ψ_poly1 : Polynomial k₀ →+* F := Polynomial.eval₂RingHom (algebraMap k₀ F) u_F⁻¹
  let χ_1 : Γ_chart 1 →+* F := ψ_poly1.comp (e_P1 1).symm.toRingHom
  have hχ0_inj : Function.Injective χ_0 := hψ0_inj.comp (e_P1 0).symm.injective
  have hχ0_c : ∀ r : k₀, χ_0 (c_P1 0 r) = algebraMap k₀ F r := by
    intro r
    dsimp [χ_0, ψ_poly0]
    rw [he_symm_c 0 r, Polynomial.eval₂_C]
  have hχ0_t : χ_0 (t_P1 0 1) = u_F := by
    dsimp [χ_0, ψ_poly0]
    rw [he_symm_t01, Polynomial.eval₂_X]
  have hχ1_c : ∀ r : k₀, χ_1 (c_P1 1 r) = algebraMap k₀ F r := by
