        rw [← huv_span]
        apply le_antisymm
        · rw [Ideal.span_le]
          rintro z (rfl | rfl)
          · rw [hu_bar_eq]
            exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
          · rw [hv_bar_eq]
            exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
        · rw [Ideal.span_le]
          rintro z (rfl | rfl)
          · rw [hu_eq_inv]
            exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
          · rw [hv_eq_inv]
            exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
