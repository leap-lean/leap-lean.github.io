          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.assoc, iso₁.hom_inv_id, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.assoc, iso₁.inv_hom_id, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp] }
    refine ⟨map_pb ≪≫ e_pb, ?_⟩
    dsimp only [CategoryTheory.Iso.trans_hom, map_pb]
    rw [CategoryTheory.Category.assoc, ← he_pb, CategoryTheory.Limits.pullback.lift_snd]
  · rintro ⟨iso₂, hiso₂⟩
    have _ : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver Ω₁ 1).hom := hPropP₁
    have _ : AlgebraicGeometry.LocallyOfFinitePresentation p_E₁ := hLFP_of_LFT p_E₁
    have _ : AlgebraicGeometry.LocallyOfFinitePresentation (weilProjectiveSpaceOver Ω₁ 1).hom :=
      hLFP_of_LFT (weilProjectiveSpaceOver Ω₁ 1).hom
    obtain ⟨J, instCatJ, instFiltJ, B_diag, α_diag, ι_colim, hColim, hα, hRet⟩ :=
      hPart3 Ω₁ Ω₂ φ
    let _ : CategoryTheory.SmallCategory J := instCatJ
    let _ : CategoryTheory.IsFiltered J := instFiltJ
    let iso_E : CategoryTheory.Limits.pullback p_E₁ f_φ ≅
        CategoryTheory.Limits.pullback (weilProjectiveSpaceOver Ω₁ 1).hom f_φ :=
      iso₂ ≪≫ e_pb.symm
    have hiso_E : iso_E.hom ≫
        CategoryTheory.Limits.pullback.snd (weilProjectiveSpaceOver Ω₁ 1).hom f_φ =
        CategoryTheory.Limits.pullback.snd p_E₁ f_φ := by
      dsimp only [iso_E, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom]
      rw [CategoryTheory.Category.assoc, he_pb, ← CategoryTheory.Category.assoc e_pb.inv,
        e_pb.inv_hom_id, CategoryTheory.Category.id_comp, ← hiso₂]
    obtain ⟨iso₀, hiso₀⟩ :=
      hPart5 (CommRingCat.of Ω₁) (CommRingCat.of Ω₂) (CommRingCat.ofHom φ)
        J B_diag α_diag ι_colim hColim hα hRet
        E₁ (weilProjectiveSpaceOver Ω₁ 1).left
        p_E₁ (weilProjectiveSpaceOver Ω₁ 1).hom
        iso_E hiso_E
    exact ⟨iso₀, hiso₀.symm⟩

theorem weil_algClosed_artinNodal_and_geomStableFiber_iff : (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (Y : AlgebraicGeometry.Scheme.{u})
        (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.LocallyOfFiniteType p_Y],
      (∀ y : Y, HasSpreadSmoothOrNodalAt p_Y y) ↔
        (AlgebraicGeometry.IsReduced Y ∧
         ∀ (D : Type u) [CommRing D] [Algebra Ω D]
           (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y),
           AlgebraicGeometry.IsOpenImmersion j_D →
           j_D ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
           ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
             let L := Localization.AtPrime q.asIdeal
             let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
             Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
               (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
                Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
                ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3))) ∧
    (∀ {C S : AlgebraicGeometry.Scheme.{u}}
        (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C)),
      3 ≤ n →
      AlgebraicGeometry.IsProper g →
      AlgebraicGeometry.LocallyOfFinitePresentation g →
      (∀ j : Fin n, τ j ≫ g = 𝟙 S) →
      (_root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ i).base) (Set.range (τ j).base)) →
      ∀ (Ω₁ Ω₂ : Type u) [Field Ω₁] [IsAlgClosed Ω₁] [Field Ω₂] [IsAlgClosed Ω₂]
        (φ : Ω₁ →+* Ω₂) (s₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω₁) ⟶ S),
        HasSpreadGeomStableFiber g n τ Ω₁ s₁ ↔
          HasSpreadGeomStableFiber g n τ Ω₂
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ s₁)) :=
by
  have hArtinNodal : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (Y : AlgebraicGeometry.Scheme.{u})
      (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      [AlgebraicGeometry.LocallyOfFiniteType p_Y],
      (∀ y : Y, HasSpreadSmoothOrNodalAt p_Y y) ↔
        (AlgebraicGeometry.IsReduced Y ∧
         ∀ (D : Type u) [CommRing D] [Algebra Ω D]
           (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y),
           AlgebraicGeometry.IsOpenImmersion j_D →
           j_D ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
           ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
             let L := Localization.AtPrime q.asIdeal
             let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
             Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
               (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
                Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
                ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3)) := by
    intro Ω _ _ Y p_Y _
    constructor
    · exact weil_algClosed_smoothOrNodal_imp_isReduced_and_artin Ω Y p_Y
    · rintro ⟨hRed, hArtin⟩
      exact weil_algClosed_hasSpreadSmoothOrNodal_from_local_and_baseChange.1 Ω
        (weil_algClosed_artin_commRing_smooth_or_nodal_roof Ω) Y p_Y hRed hArtin

  refine ⟨hArtinNodal, ?_⟩
  intro C S g n τ _hn hProp hLFP hSec _hDisj Ω₁ Ω₂ _ _ _ _ φ s₁
  have : AlgebraicGeometry.IsProper g := hProp
  have : AlgebraicGeometry.LocallyOfFinitePresentation g := hLFP

  have hTransportIso : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} {Ω : Type u} [Field Ω]
      (p₁ : Z₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (p₂ : Z₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (M₁ : Fin n → Set ↥Z₁) (M₂ : Fin n → Set ↥Z₂)
      (e : Z₁ ≅ Z₂) (hep : e.hom ≫ p₂ = p₁)
      (hM : ∀ (j : Fin n) (q₁ : ↥Z₁), q₁ ∈ M₁ j ↔ e.hom.base q₁ ∈ M₂ j),
      (ConnectedSpace ↥Z₁ ∧
       (∀ y₁ : ↥Z₁, HasSpreadSmoothOrNodalAt p₁ y₁) ∧
       (∀ (E : Set ↥Z₁) (E_sch : AlgebraicGeometry.Scheme.{u}) (ιE : E_sch ⟶ Z₁),
         E ∈ irreducibleComponents ↥Z₁ →
         AlgebraicGeometry.IsClosedImmersion ιE →
         AlgebraicGeometry.IsIntegral E_sch →
         Set.range ιE.base = E →
         (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left,
           ιE ≫ p₁ = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) →
         ∃ q₁ q₂ q₃ : ↥Z₁,
           q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
           q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
           (∀ q ∈ ({q₁, q₂, q₃} : Set ↥Z₁),
             (∃ E' ∈ irreducibleComponents ↥Z₁, E' ≠ E ∧ q ∈ E') ∨
             (∃ j : Fin n, q ∈ M₁ j)))) →
      (ConnectedSpace ↥Z₂ ∧
       (∀ y₂ : ↥Z₂, HasSpreadSmoothOrNodalAt p₂ y₂) ∧
       (∀ (E : Set ↥Z₂) (E_sch : AlgebraicGeometry.Scheme.{u}) (ιE : E_sch ⟶ Z₂),
         E ∈ irreducibleComponents ↥Z₂ →
         AlgebraicGeometry.IsClosedImmersion ιE →
         AlgebraicGeometry.IsIntegral E_sch →
         Set.range ιE.base = E →
         (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left,
           ιE ≫ p₂ = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) →
         ∃ q₁ q₂ q₃ : ↥Z₂,
           q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
           q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
           (∀ q ∈ ({q₁, q₂, q₃} : Set ↥Z₂),
             (∃ E' ∈ irreducibleComponents ↥Z₂, E' ≠ E ∧ q ∈ E') ∨
             (∃ j : Fin n, q ∈ M₂ j)))) := by
    intro Z₁ Z₂ Ω _ p₁ p₂ M₁ M₂ e hep hM ⟨hConn₁, hSmNod₁, hComp₁⟩
    let hTop : ↥Z₁ ≃ₜ ↥Z₂ := TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso e)
    have hhTop : ∀ x : ↥Z₁, hTop x = e.hom.base x := fun _ => rfl
    have hhTopSymm : ∀ y : ↥Z₂, hTop.symm y = e.inv.base y := fun _ => rfl
    have heinv_p : e.inv ≫ p₁ = p₂ := by
      rw [← hep, ← CategoryTheory.Category.assoc, e.inv_hom_id, CategoryTheory.Category.id_comp]
    refine ⟨hTop.surjective.connectedSpace hTop.continuous, ?_, ?_⟩
    · intro y₂
      rcases hSmNod₁ (e.inv.base y₂) with ⟨V₁, hy₁, hSm₁⟩ |
          ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hIdeal, hComm⟩
      · left
        let V₂ : Z₂.Opens := e.inv ⁻¹ᵁ V₁
        refine ⟨V₂, hy₁, ?_⟩
        let e_V : V₂.toScheme ⟶ V₁.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift V₁.ι (V₂.ι ≫ e.inv) (by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨x, rfl⟩
            exact x.2)
        have hPbV_iso : CategoryTheory.IsPullback e_V V₂.ι V₁.ι e.inv :=
          AlgebraicGeometry.IsOpenImmersion.isPullback e_V V₂.ι V₁.ι e.inv
            (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _).symm
            (by ext x; simp [V₂, AlgebraicGeometry.Scheme.Opens.opensRange_ι])
        have hPbBot : CategoryTheory.IsPullback e.inv p₂ p₁
            (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) :=
          CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [heinv_p, CategoryTheory.Category.comp_id]⟩
        exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (hPbV_iso.paste_vert hPbBot) hSm₁
      · right
        refine ⟨U', u₀, e₁ ≫ e.hom, e₂, inferInstance, hEt₂, ?_, hIdeal, ?_⟩
        · change e.hom.base (e₁.base u₀) = y₂
          rw [hu₀, ← hhTop, ← hhTopSymm, hTop.apply_symm_apply]
        · rw [CategoryTheory.Category.assoc, hep, hComm]
    · intro E₂ E_sch ιE₂ hE₂ hCl₂ hIntE hRange₂ ⟨isoP1, hisoP1⟩
      let E₁ : Set ↥Z₁ := hTop.symm '' E₂
      let ιE₁ : E_sch ⟶ Z₁ := ιE₂ ≫ e.inv
      have hE₁ : E₁ ∈ irreducibleComponents ↥Z₁ :=
        image_mem_irreducibleComponents_of_isPreirreducible_fiber hTop.symm
          hTop.symm.continuous hTop.symm.isOpenMap
          (fun _ => (Set.subsingleton_singleton.preimage hTop.symm.injective).isPreirreducible)
          hTop.symm.surjective hE₂
      have hCl₁ : AlgebraicGeometry.IsClosedImmersion ιE₁ := inferInstance
      have hRange₁ : Set.range ιE₁.base = E₁ := by
        change Set.range (hTop.symm ∘ ιE₂.base) = hTop.symm '' E₂
        rw [Set.range_comp, hRange₂]
      have hisoP1_1 : ιE₁ ≫ p₁ = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom := by
        rw [CategoryTheory.Category.assoc, heinv_p, hisoP1]
      obtain ⟨q₁, q₂, q₃, hq12, hq13, hq23, hq1E, hq2E, hq3E, hSpec⟩ :=
        hComp₁ E₁ E_sch ιE₁ hE₁ hCl₁ hIntE hRange₁ ⟨isoP1, hisoP1_1⟩
      refine ⟨hTop q₁, hTop q₂, hTop q₃,
        hTop.injective.ne hq12, hTop.injective.ne hq13, hTop.injective.ne hq23,
        ?_, ?_, ?_, ?_⟩
      · rcases hq1E with ⟨z, hz, rfl⟩; simpa using hz
      · rcases hq2E with ⟨z, hz, rfl⟩; simpa using hz
      · rcases hq3E with ⟨z, hz, rfl⟩; simpa using hz
      · intro q' hq'
        have hq'_ex : ∃ q ∈ ({q₁, q₂, q₃} : Set ↥Z₁), hTop q = q' := by
          rcases hq' with rfl | rfl | rfl
          · exact ⟨q₁, by simp, rfl⟩
          · exact ⟨q₂, by simp, rfl⟩
          · exact ⟨q₃, by simp, rfl⟩
        obtain ⟨q, hq_set, rfl⟩ := hq'_ex
        rcases hSpec q hq_set with ⟨E'₁, hE'₁_mem, hE'₁_ne, hq_E'₁⟩ | ⟨j, hq_M₁⟩
        · left
          refine ⟨hTop '' E'₁,
            image_mem_irreducibleComponents_of_isPreirreducible_fiber hTop
              hTop.continuous hTop.isOpenMap
              (fun _ => (Set.subsingleton_singleton.preimage hTop.injective).isPreirreducible)
              hTop.surjective hE'₁_mem,
            ?_, ⟨q, hq_E'₁, rfl⟩⟩
          intro hEq
          apply hE'₁_ne
          calc
            E'₁ = hTop.symm '' (hTop '' E'₁) := by ext z; simp
            _ = E₁ := by rw [hEq]
        · right
          exact ⟨j, (hM j q).mp hq_M₁⟩

  let f_φ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
  let s₂ := f_φ ≫ s₁
  let Y₁ := CategoryTheory.Limits.pullback g s₁
  let π₁ := CategoryTheory.Limits.pullback.fst g s₁
  let p₁ := CategoryTheory.Limits.pullback.snd g s₁
  let Y₂' := CategoryTheory.Limits.pullback p₁ f_φ
  let π₁₂ := CategoryTheory.Limits.pullback.fst p₁ f_φ
  let p₂' := CategoryTheory.Limits.pullback.snd p₁ f_φ

  have : AlgebraicGeometry.IsProper p₁ := inferInstance
  have : AlgebraicGeometry.IsSeparated p₁ := inferInstance
  have : AlgebraicGeometry.QuasiCompact p₁ := inferInstance
  have : AlgebraicGeometry.LocallyOfFiniteType p₁ := inferInstance

  let σ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω₁) ⟶ Y₁) :=
    fun j => CategoryTheory.Limits.pullback.lift (s₁ ≫ τ j) (𝟙 _)
      (by rw [CategoryTheory.Category.assoc, hSec j,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  have hσ₁_fst : ∀ j : Fin n, σ₁ j ≫ π₁ = s₁ ≫ τ j :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hσ₁_snd : ∀ j : Fin n, σ₁ j ≫ p₁ = 𝟙 _ :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hSecHit₁ : ∀ (j : Fin n) (q₁ : ↥Y₁),
      π₁.base q₁ ∈ Set.range (τ j).base ↔ q₁ ∈ Set.range (σ₁ j).base := by
    intro j q₁
    have hPbSec₁ : CategoryTheory.IsPullback s₁ (σ₁ j) (τ j) π₁ := by
      refine CategoryTheory.IsPullback.of_bot ?_ (hσ₁_fst j).symm
        (CategoryTheory.IsPullback.of_hasPullback g s₁)
      rw [hσ₁_snd j, hSec j]
      exact CategoryTheory.IsPullback.of_vert_isIso
        ⟨by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]⟩
    constructor
    · rintro ⟨b, hb⟩
      obtain ⟨pt₁, _, hpt₁⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPbSec₁ b q₁ hb
      exact ⟨pt₁, hpt₁⟩
    · rintro ⟨pt₁, rfl⟩
      refine ⟨s₁.base pt₁, ?_⟩
      change (s₁ ≫ τ j).base pt₁ = (σ₁ j ≫ π₁).base pt₁
      rw [hσ₁_fst j]

  have hClosedSec₁ : ∀ (j : Fin n) (q₁ : ↥Y₁),
      q₁ ∈ Set.range (σ₁ j).base → IsClosed ({q₁} : Set ↥Y₁) := by
    intro j q₁ ⟨pt₁, hpt₁⟩
    have : AlgebraicGeometry.IsClosedImmersion (σ₁ j ≫ p₁) := by
      rw [hσ₁_snd j]; infer_instance
    have hCl_σ : AlgebraicGeometry.IsClosedImmersion (σ₁ j) :=
      AlgebraicGeometry.IsClosedImmersion.of_comp (σ₁ j) p₁
    have hRangeEq : Set.range (σ₁ j).base = ({q₁} : Set ↥Y₁) := by
      ext y
      simp only [Set.mem_range, Set.mem_singleton_iff]
      constructor
      · rintro ⟨pt, rfl⟩
        rw [Subsingleton.elim pt pt₁, hpt₁]
      · rintro rfl
        exact ⟨pt₁, hpt₁⟩
    rw [← hRangeEq]
    exact (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding (σ₁ j)).isClosed_range

  have hClosedInter₁ : ∀ {E₁ E'₁ : Set ↥Y₁} {E₁_sch : AlgebraicGeometry.Scheme.{u}}
      {ιE₁ : E₁_sch ⟶ Y₁}
      (_ : E₁_sch ≅ (weilProjectiveSpaceOver Ω₁ 1).left)
      (_ : E₁ ∈ irreducibleComponents ↥Y₁)
      (_ : E'₁ ∈ irreducibleComponents ↥Y₁)
      (_ : E'₁ ≠ E₁)
      (_ : AlgebraicGeometry.IsClosedImmersion ιE₁)
      (_ : Set.range ιE₁.base = E₁)
      {q₁ : ↥Y₁},
      q₁ ∈ E₁ → q₁ ∈ E'₁ → IsClosed ({q₁} : Set ↥Y₁) := by
    intro E₁ E'₁ E₁_sch ιE₁ isoP1 hE₁ hE'₁ hne hCl₁ hRange₁ q₁ hqE₁ hqE'₁
    rw [← hRange₁] at hqE₁
    obtain ⟨x, hx⟩ := hqE₁
    rcases weil_algClosed_proper_iso_weilProjectiveSpaceOne_iff_and_closedPts.2
        Ω₁ E₁_sch isoP1 x with hDense | hCl_x
    · exfalso
      have hCl_pre : IsClosed (ιE₁.base ⁻¹' E'₁) :=
        (isClosed_of_mem_irreducibleComponents E'₁ hE'₁).preimage
          (AlgebraicGeometry.Scheme.Hom.continuous ιE₁)
      have hx_pre : ({x} : Set ↥E₁_sch) ⊆ ιE₁.base ⁻¹' E'₁ := by
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        change ιE₁.base x ∈ E'₁
        rwa [hx]
      have hUniv_sub : (Set.univ : Set ↥E₁_sch) ⊆ ιE₁.base ⁻¹' E'₁ := by
        rw [← hDense]
        exact closure_minimal hx_pre hCl_pre
      have hSub : E₁ ⊆ E'₁ := by
        rw [← hRange₁]
        rintro _ ⟨w, rfl⟩
        exact hUniv_sub (Set.mem_univ w)
      exact hne (Set.Subset.antisymm (hE₁.2 hE'₁.1 hSub) hSub)
    · have hImg : ιE₁.base '' ({x} : Set ↥E₁_sch) = ({q₁} : Set ↥Y₁) := by
        rw [Set.image_singleton, hx]
      rw [← hImg]
      exact (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ιE₁).isClosedMap _ hCl_x

  let hPbFib : CategoryTheory.IsPullback (π₁₂ ≫ π₁) p₂' g s₂ :=
    (CategoryTheory.IsPullback.of_hasPullback p₁ f_φ).paste_horiz
      (CategoryTheory.IsPullback.of_hasPullback g s₁)
  let e_pb : Y₂' ≅ CategoryTheory.Limits.pullback g s₂ := hPbFib.isoPullback
  have he_pb_fst : e_pb.hom ≫ CategoryTheory.Limits.pullback.fst g s₂ = π₁₂ ≫ π₁ :=
    hPbFib.isoPullback_hom_fst
  have he_pb_snd : e_pb.hom ≫ CategoryTheory.Limits.pullback.snd g s₂ = p₂' :=
    hPbFib.isoPullback_hom_snd
  have he_pb_inv_snd : e_pb.inv ≫ p₂' = CategoryTheory.Limits.pullback.snd g s₂ := by
    rw [← he_pb_snd, ← CategoryTheory.Category.assoc, e_pb.inv_hom_id,
      CategoryTheory.Category.id_comp]

  have hM_pb : ∀ (j : Fin n) (q' : ↥Y₂'),
      π₁₂.base q' ∈ Set.range (σ₁ j).base ↔
        (CategoryTheory.Limits.pullback.fst g s₂).base (e_pb.hom.base q') ∈
          Set.range (τ j).base := by
    intro j q'
    have h_eq : (CategoryTheory.Limits.pullback.fst g s₂).base (e_pb.hom.base q') =
        π₁.base (π₁₂.base q') := by
      change (e_pb.hom ≫ CategoryTheory.Limits.pullback.fst g s₂).base q' =
        (π₁₂ ≫ π₁).base q'
      rw [he_pb_fst]
    rw [h_eq, hSecHit₁ j (π₁₂.base q')]

  have hIsoY₂ :
      (ConnectedSpace ↥Y₂' ∧
       (∀ y₂ : ↥Y₂', HasSpreadSmoothOrNodalAt p₂' y₂) ∧
       (∀ (E : Set ↥Y₂') (E_sch : AlgebraicGeometry.Scheme.{u}) (ιE : E_sch ⟶ Y₂'),
         E ∈ irreducibleComponents ↥Y₂' →
         AlgebraicGeometry.IsClosedImmersion ιE →
         AlgebraicGeometry.IsIntegral E_sch →
         Set.range ιE.base = E →
         (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω₂ 1).left,
           ιE ≫ p₂' = isoP1.hom ≫ (weilProjectiveSpaceOver Ω₂ 1).hom) →
         ∃ q₁ q₂ q₃ : ↥Y₂',
           q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
           q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
           (∀ q ∈ ({q₁, q₂, q₃} : Set ↥Y₂'),
             (∃ E' ∈ irreducibleComponents ↥Y₂', E' ≠ E ∧ q ∈ E') ∨
             (∃ j : Fin n, π₁₂.base q ∈ Set.range (σ₁ j).base)))) ↔
      HasSpreadGeomStableFiber g n τ Ω₂ s₂ := by
    constructor
    · exact hTransportIso p₂' (CategoryTheory.Limits.pullback.snd g s₂)
        (fun j => {q' | π₁₂.base q' ∈ Set.range (σ₁ j).base})
        (fun j => {q | (CategoryTheory.Limits.pullback.fst g s₂).base q ∈ Set.range (τ j).base})
        e_pb he_pb_snd hM_pb
    · refine hTransportIso (CategoryTheory.Limits.pullback.snd g s₂) p₂'
        (fun j => {q | (CategoryTheory.Limits.pullback.fst g s₂).base q ∈ Set.range (τ j).base})
        (fun j => {q' | π₁₂.base q' ∈ Set.range (σ₁ j).base})
        e_pb.symm he_pb_inv_snd ?_
      intro j q
      have hq := hM_pb j (e_pb.inv.base q)
      have he_app : e_pb.hom.base (e_pb.inv.base q) = q := by
        change (e_pb.inv ≫ e_pb.hom).base q = q
        rw [e_pb.inv_hom_id]
        rfl
      rw [he_app] at hq
      exact hq.symm

  rw [← hIsoY₂]
  obtain ⟨hConnIff, hComp₁₂, hComp₂₁, hUniqFib⟩ :=
    weil_algClosed_baseChange_connected_and_irreducibleComponents Ω₁ Ω₂ φ Y₁ p₁
  have hSmNodIff :
      (∀ y₁ : ↥Y₁, HasSpreadSmoothOrNodalAt p₁ y₁) ↔
        (∀ y₂ : ↥Y₂', HasSpreadSmoothOrNodalAt p₂' y₂) :=
    weil_algClosed_hasSpreadSmoothOrNodal_from_local_and_baseChange.2 hArtinNodal Ω₁ Ω₂ φ Y₁ p₁

  constructor
  · rintro ⟨hConn₁, hSmNod₁, hStab₁⟩
    refine ⟨hConnIff.mp hConn₁, hSmNodIff.mp hSmNod₁, ?_⟩
    intro E₂ E₂_sch ιE₂ hE₂ hCl₂ hInt₂ hRange₂ ⟨isoP1_2, hisoP1_2⟩
    obtain ⟨E₁, hE₁, hE₂_eq⟩ := hComp₂₁ E₂ hE₂
    obtain ⟨_, hPre_surj, E₁_sch, ιE₁, hCl₁, hInt₁, hRange₁, _, _, hUniq₂⟩ :=
      hComp₁₂ E₁ hE₁
    have hRange₂' : Set.range ιE₂.base = π₁₂.base ⁻¹' E₁ := hE₂_eq ▸ hRange₂
    obtain ⟨e₂, he₂⟩ := hUniq₂ E₂_sch ιE₂ hCl₂ hInt₂ hRange₂'
    have : AlgebraicGeometry.IsClosedImmersion ιE₁ := hCl₁
    have : AlgebraicGeometry.IsProper (ιE₁ ≫ p₁) := inferInstance
    have hiso₂_pb :
        ∃ iso₂ : CategoryTheory.Limits.pullback (ιE₁ ≫ p₁) f_φ ≅
            (weilProjectiveSpaceOver Ω₂ 1).left,
          CategoryTheory.Limits.pullback.snd (ιE₁ ≫ p₁) f_φ =
            iso₂.hom ≫ (weilProjectiveSpaceOver Ω₂ 1).hom := by
      refine ⟨e₂.symm ≪≫ isoP1_2, ?_⟩
      calc
        CategoryTheory.Limits.pullback.snd (ιE₁ ≫ p₁) f_φ
          = e₂.inv ≫ (e₂.hom ≫ CategoryTheory.Limits.pullback.snd (ιE₁ ≫ p₁) f_φ) := by
              rw [← CategoryTheory.Category.assoc, e₂.inv_hom_id,
                CategoryTheory.Category.id_comp]
        _ = e₂.inv ≫ (ιE₂ ≫ p₂') := by rw [he₂]
        _ = (e₂.symm ≪≫ isoP1_2).hom ≫ (weilProjectiveSpaceOver Ω₂ 1).hom := by
              rw [hisoP1_2]; simp [CategoryTheory.Category.assoc]
    obtain ⟨isoP1_1, hisoP1_1⟩ :=
      (weil_algClosed_proper_iso_weilProjectiveSpaceOne_iff_and_closedPts.1
        Ω₁ Ω₂ φ E₁_sch (ιE₁ ≫ p₁)).mpr hiso₂_pb
    obtain ⟨q₁, q₂, q₃, hq12, hq13, hq23, hq1E, hq2E, hq3E, hSpec₁⟩ :=
      hStab₁ E₁ E₁_sch ιE₁ hE₁ hCl₁ hInt₁ hRange₁ ⟨isoP1_1, hisoP1_1⟩
    have hClosedQ : ∀ q ∈ ({q₁, q₂, q₃} : Set ↥Y₁), IsClosed ({q} : Set ↥Y₁) := by
      intro q hq
      have hqE : q ∈ E₁ := by
        rcases hq with rfl | rfl | rfl <;> assumption
      rcases hSpec₁ q hq with ⟨E'₁, hE'₁, hne, hqE'₁⟩ | ⟨j, hqτ⟩
      · exact hClosedInter₁ isoP1_1 hE₁ hE'₁ hne hCl₁ hRange₁ hqE hqE'₁
      · exact hClosedSec₁ j q ((hSecHit₁ j q).mp hqτ)
    obtain ⟨q'₁, hq'₁, _⟩ := hUniqFib q₁ (hClosedQ q₁ (by simp))
    obtain ⟨q'₂, hq'₂, _⟩ := hUniqFib q₂ (hClosedQ q₂ (by simp))
    obtain ⟨q'₃, hq'₃, _⟩ := hUniqFib q₃ (hClosedQ q₃ (by simp))
    refine ⟨q'₁, q'₂, q'₃,
      fun h => hq12 (by rw [← hq'₁, ← hq'₂, h]),
      fun h => hq13 (by rw [← hq'₁, ← hq'₃, h]),
      fun h => hq23 (by rw [← hq'₂, ← hq'₃, h]),
      by rw [hE₂_eq]; change π₁₂.base q'₁ ∈ E₁; rwa [hq'₁],
      by rw [hE₂_eq]; change π₁₂.base q'₂ ∈ E₁; rwa [hq'₂],
      by rw [hE₂_eq]; change π₁₂.base q'₃ ∈ E₁; rwa [hq'₃],
      ?_⟩
    intro q' hq'
    have hq'_map : ∃ q ∈ ({q₁, q₂, q₃} : Set ↥Y₁), π₁₂.base q' = q := by
      rcases hq' with rfl | rfl | rfl
      · exact ⟨q₁, by simp, hq'₁⟩
      · exact ⟨q₂, by simp, hq'₂⟩
      · exact ⟨q₃, by simp, hq'₃⟩
    obtain ⟨q, hq_set, hπq'⟩ := hq'_map
    rcases hSpec₁ q hq_set with ⟨E'₁, hE'₁, hne, hqE'₁⟩ | ⟨j, hqτ⟩
    · left
      obtain ⟨hPreE'₁_mem, hPreE'₁_surj, _⟩ := hComp₁₂ E'₁ hE'₁
      refine ⟨π₁₂.base ⁻¹' E'₁, hPreE'₁_mem, ?_, ?_⟩
      · intro hEqPre
        apply hne
        calc
          E'₁ = π₁₂.base '' (π₁₂.base ⁻¹' E'₁) := hPreE'₁_surj.symm
          _ = π₁₂.base '' (π₁₂.base ⁻¹' E₁) := by rw [hEqPre, hE₂_eq]
          _ = E₁ := hPre_surj
      · change π₁₂.base q' ∈ E'₁
        rwa [hπq']
    · right
      refine ⟨j, ?_⟩
      rw [hπq']
      exact (hSecHit₁ j q).mp hqτ

  · rintro ⟨hConn₂, hSmNod₂, hStab₂⟩
    refine ⟨hConnIff.mpr hConn₂, hSmNodIff.mpr hSmNod₂, ?_⟩
    intro E₁ E₁_in_sch ιE₁_in hE₁ hCl₁_in hInt₁_in hRange₁_in ⟨isoP1_in, hisoP1_in⟩
    obtain ⟨hPre_mem, _, E₁_sch, ιE₁, hCl₁, _, hRange₁, hInt_pb, hUniq₁, _⟩ :=
      hComp₁₂ E₁ hE₁
    obtain ⟨e₁, he₁⟩ := hUniq₁ E₁_in_sch ιE₁_in hCl₁_in hInt₁_in hRange₁_in
    have : AlgebraicGeometry.IsClosedImmersion ιE₁ := hCl₁
    have : AlgebraicGeometry.IsProper (ιE₁ ≫ p₁) := inferInstance
    have hiso₁_canon :
        ∃ iso₁ : E₁_sch ≅ (weilProjectiveSpaceOver Ω₁ 1).left,
          ιE₁ ≫ p₁ = iso₁.hom ≫ (weilProjectiveSpaceOver Ω₁ 1).hom := by
      refine ⟨e₁.symm ≪≫ isoP1_in, ?_⟩
      calc
        ιE₁ ≫ p₁
          = e₁.inv ≫ ((e₁.hom ≫ ιE₁) ≫ p₁) := by
              rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
                e₁.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = e₁.inv ≫ (ιE₁_in ≫ p₁) := by rw [he₁]
        _ = (e₁.symm ≪≫ isoP1_in).hom ≫ (weilProjectiveSpaceOver Ω₁ 1).hom := by
              rw [hisoP1_in]; simp [CategoryTheory.Category.assoc]
    obtain ⟨isoP1_2, hisoP1_2⟩ :=
      (weil_algClosed_proper_iso_weilProjectiveSpaceOne_iff_and_closedPts.1
        Ω₁ Ω₂ φ E₁_sch (ιE₁ ≫ p₁)).mp hiso₁_canon
    let E₂_pb := CategoryTheory.Limits.pullback (ιE₁ ≫ p₁) f_φ
    let fst_E := CategoryTheory.Limits.pullback.fst (ιE₁ ≫ p₁) f_φ
    let snd_E := CategoryTheory.Limits.pullback.snd (ιE₁ ≫ p₁) f_φ
    let ιE₂_pb : E₂_pb ⟶ Y₂' :=
      CategoryTheory.Limits.pullback.map (ιE₁ ≫ p₁) f_φ p₁ f_φ
        ιE₁ (𝟙 _) (𝟙 _)
        (by rw [CategoryTheory.Category.comp_id])
        (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
    have hιE₂_fst : ιE₂_pb ≫ π₁₂ = fst_E ≫ ιE₁ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hιE₂_snd : ιE₂_pb ≫ p₂' = snd_E := by
      change CategoryTheory.Limits.pullback.map _ _ _ _ _ _ _ _ _ ≫ p₂' = snd_E
      rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
    have hPb_E_flip : CategoryTheory.IsPullback ιE₂_pb fst_E π₁₂ ιE₁ := by
      refine CategoryTheory.IsPullback.of_right ?_ hιE₂_fst
        (CategoryTheory.IsPullback.of_hasPullback p₁ f_φ).flip
      rw [hιE₂_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback (ιE₁ ≫ p₁) f_φ).flip
    have hPb_E : CategoryTheory.IsPullback fst_E ιE₂_pb ιE₁ π₁₂ := hPb_E_flip.flip
    have hCl_pb : AlgebraicGeometry.IsClosedImmersion ιE₂_pb :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_E hCl₁
    have hRange_pb : Set.range ιE₂_pb.base = π₁₂.base ⁻¹' E₁ := by
      ext y
      simp only [Set.mem_range, Set.mem_preimage]
      constructor
      · rintro ⟨z, rfl⟩
        rw [← hRange₁]
        refine ⟨fst_E.base z, ?_⟩
        change (fst_E ≫ ιE₁).base z = (ιE₂_pb ≫ π₁₂).base z
        rw [hιE₂_fst]
      · intro hy
        rw [← hRange₁] at hy
        obtain ⟨x, hx⟩ := hy
        obtain ⟨z, _, hz⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_E x y hx
        exact ⟨z, hz⟩
    obtain ⟨q'₁, q'₂, q'₃, hq'12, hq'13, hq'23, hq'1E, hq'2E, hq'3E, hSpec₂⟩ :=
      hStab₂ (π₁₂.base ⁻¹' E₁) E₂_pb ιE₂_pb hPre_mem hCl_pb hInt_pb hRange_pb
        ⟨isoP1_2, by rw [hιE₂_snd]; exact hisoP1_2⟩
    have hDescendPt : ∀ q' ∈ ({q'₁, q'₂, q'₃} : Set ↥Y₂'),
        ((∃ E'₁ ∈ irreducibleComponents ↥Y₁, E'₁ ≠ E₁ ∧ π₁₂.base q' ∈ E'₁) ∨
         (∃ j : Fin n, π₁.base (π₁₂.base q') ∈ Set.range (τ j).base)) ∧
        IsClosed ({π₁₂.base q'} : Set ↥Y₁) := by
      intro q' hq'
      have hq'E₁ : π₁₂.base q' ∈ E₁ := by
        rcases hq' with rfl | rfl | rfl
        · exact hq'1E
        · exact hq'2E
        · exact hq'3E
      rcases hSpec₂ q' hq' with ⟨E'₂, hE'₂, hne₂, hq'E'₂⟩ | ⟨j, hq'σ⟩
      · obtain ⟨E'₁, hE'₁, rfl⟩ := hComp₂₁ E'₂ hE'₂
        have hne₁ : E'₁ ≠ E₁ := fun hEq => hne₂ (by rw [hEq])
        exact ⟨Or.inl ⟨E'₁, hE'₁, hne₁, hq'E'₂⟩,
          hClosedInter₁ isoP1_in hE₁ hE'₁ hne₁ hCl₁_in hRange₁_in hq'E₁ hq'E'₂⟩
      · exact ⟨Or.inr ⟨j, (hSecHit₁ j (π₁₂.base q')).mpr hq'σ⟩,
          hClosedSec₁ j (π₁₂.base q') hq'σ⟩
    have hInjOn : ∀ {a b : ↥Y₂'},
        a ∈ ({q'₁, q'₂, q'₃} : Set ↥Y₂') →
        b ∈ ({q'₁, q'₂, q'₃} : Set ↥Y₂') →
        π₁₂.base a = π₁₂.base b → a = b := by
      intro a b ha _ hab
      obtain ⟨y₀, _, hy₀_uniq⟩ := hUniqFib (π₁₂.base a) (hDescendPt a ha).2
      exact (hy₀_uniq a rfl).trans (hy₀_uniq b hab.symm).symm
    refine ⟨π₁₂.base q'₁, π₁₂.base q'₂, π₁₂.base q'₃,
      fun h => hq'12 (hInjOn (by simp) (by simp) h),
      fun h => hq'13 (hInjOn (by simp) (by simp) h),
      fun h => hq'23 (hInjOn (by simp) (by simp) h),
      hq'1E, hq'2E, hq'3E, ?_⟩
    intro q hq
    rcases hq with rfl | rfl | rfl
    · exact (hDescendPt q'₁ (by simp)).1
    · exact (hDescendPt q'₂ (by simp)).1
    · exact (hDescendPt q'₃ (by simp)).1

theorem weil_domain_spreadOut_neg_conn_or_nodal_locus (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
    (n : ℕ) (hn : 3 ≤ n)
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ C))
    (hProp : AlgebraicGeometry.IsProper g)
    (hLFP : AlgebraicGeometry.LocallyOfFinitePresentation g)
    (hSec : ∀ j : Fin n, τ j ≫ g = 𝟙 _)
    (hArtinNodal : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (Y : AlgebraicGeometry.Scheme.{u})
        (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.LocallyOfFiniteType p_Y],
      (∀ y : Y, HasSpreadSmoothOrNodalAt p_Y y) ↔
        (AlgebraicGeometry.IsReduced Y ∧
         ∀ (D : Type u) [CommRing D] [Algebra Ω D]
           (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y),
           AlgebraicGeometry.IsOpenImmersion j_D →
           j_D ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
           ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
             let L := Localization.AtPrime q.asIdeal
             let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
             Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
               (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
                Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
                ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3))) :
    let s_gen : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure (FractionRing A))) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A))).comp
          (algebraMap A (FractionRing A))))
    ¬ (ConnectedSpace ↥(CategoryTheory.Limits.pullback g s_gen) ∧
       ∀ y : ↥(CategoryTheory.Limits.pullback g s_gen),
         HasSpreadSmoothOrNodalAt (CategoryTheory.Limits.pullback.snd g s_gen) y) →
    ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B)
      (ψ : A →+* B) (ι_B : B →+* AlgebraicClosure (FractionRing A)),
      RingHom.FiniteType ψ ∧
      ι_B.comp ψ = (algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A))).comp
        (algebraMap A (FractionRing A)) ∧
      Function.Injective ι_B ∧
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s_B : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of B)),
        let s_A := s_B ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)
        ¬ (ConnectedSpace ↥(CategoryTheory.Limits.pullback g s_A) ∧
           ∀ y : ↥(CategoryTheory.Limits.pullback g s_A),
             HasSpreadSmoothOrNodalAt (CategoryTheory.Limits.pullback.snd g s_A) y) :=
by
  have hSubalgFT : ∀ {A K : Type u} [CommRing A] [CommRing K] [Algebra A K]
      (S : Subalgebra A K), S.FG → RingHom.FiniteType (algebraMap A ↥S) := by
    clear hArtinNodal hSec hn τ n hLFP hProp g C
    clear ‹IsNoetherianRing A› ‹IsDomain A› ‹CommRing A› A
    intro A K _ _ _ S hS
    classical
    rw [RingHom.finiteType_algebraMap]
    rcases hS with ⟨t, ht⟩
    refine ⟨⟨t.attach.image (fun x => (⟨x.1, ht ▸ Algebra.subset_adjoin x.2⟩ : ↥S)), ?_⟩⟩
    rw [eq_top_iff]
    intro x _
    have hx : x.1 ∈ Algebra.adjoin A (↑t : Set K) := ht ▸ x.2
    have hMem : ∀ (z : K) (hz : z ∈ Algebra.adjoin A (↑t : Set K)),
        (⟨z, ht ▸ hz⟩ : ↥S) ∈
          Algebra.adjoin A
            (↑(t.attach.image (fun y => (⟨y.1, ht ▸ Algebra.subset_adjoin y.2⟩ : ↥S))) : Set ↥S) := by
      intro z hz
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
      · intro y hy
        refine Algebra.subset_adjoin ?_
        simp only [Finset.mem_coe, Finset.mem_image, Finset.mem_attach, true_and]
        exact ⟨⟨y, hy⟩, rfl⟩
      · intro r
        exact Subalgebra.algebraMap_mem _ r
      · intro a b _ _ iha ihb
        exact add_mem iha ihb
      · intro a b _ _ iha ihb
        exact mul_mem iha ihb
    simpa using hMem x.1 hx

  
  
  
  have hS1 : ∀ (A : Type u) [CommRing A] [IsDomain A]
      (K_bar : Type u) [Field K_bar]
      (α_A : A →+* K_bar) (_ : Function.Injective α_A)
      (C : AlgebraicGeometry.Scheme.{u})
      (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
      [AlgebraicGeometry.IsProper g]
      [AlgebraicGeometry.LocallyOfFinitePresentation g]
      (τ₀ : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ C),
      τ₀ ≫ g = 𝟙 _ →
      ¬ ConnectedSpace ↥(CategoryTheory.Limits.pullback g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_A))) →
      ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B)
        (ψ : A →+* B) (ι_B : B →+* K_bar),
        RingHom.FiniteType ψ ∧
        ι_B.comp ψ = α_A ∧
        Function.Injective ι_B ∧
        ∀ (Ω : Type u) [Field Ω]
          (s_B : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of B)),
          ¬ ConnectedSpace ↥(CategoryTheory.Limits.pullback g
              (s_B ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ))) := by
    clear hArtinNodal hSec hn τ n hLFP hProp g C
    clear ‹IsNoetherianRing A› ‹IsDomain A› ‹CommRing A› A
    intro A _ _ K_bar _ α_A _hInj C g hProp _hLFP τ₀ hSec₀ hDisconn
    classical
    let _ : Algebra A K_bar := α_A.toAlgebra
    let s_gen : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_A)
    let Y_gen := CategoryTheory.Limits.pullback g s_gen
    let p_gen := CategoryTheory.Limits.pullback.snd g s_gen
    let σ_gen : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶ Y_gen :=
      CategoryTheory.Limits.pullback.lift (s_gen ≫ τ₀) (𝟙 _) (by
        rw [CategoryTheory.Category.assoc, hSec₀, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp])
    let pt_K : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_bar)) := ⟨⊥, inferInstance⟩
    have hNonempty_gen : Nonempty ↥Y_gen := ⟨σ_gen.base pt_K⟩
    have hExClopen : ∃ K₀ : Set ↥Y_gen, IsClopen K₀ ∧ K₀.Nonempty ∧ K₀ᶜ.Nonempty := by
      rw [connectedSpace_iff_clopen] at hDisconn
      by_contra hNo
      apply hDisconn
      refine ⟨hNonempty_gen, fun K₀ hK₀ => ?_⟩
      by_cases hEmpty : K₀ = ∅
      · exact Or.inl hEmpty
      · refine Or.inr (Set.eq_univ_iff_forall.mpr fun x => ?_)
        by_contra hx
        exact hNo ⟨K₀, hK₀, Set.nonempty_iff_ne_empty.mpr hEmpty, ⟨x, hx⟩⟩
    obtain ⟨K₀, hK₀, ⟨z₁, hz₁⟩, ⟨z₂, hz₂⟩⟩ := hExClopen
    let U₁ : Y_gen.Opens := ⟨K₀, hK₀.isOpen⟩
    let U₂ : Y_gen.Opens := ⟨K₀ᶜ, hK₀.compl.isOpen⟩
    have hSup_U : U₁ ⊔ U₂ = ⊤ := by
      ext x
      change x ∈ K₀ ∨ x ∈ K₀ᶜ ↔ True
      simp [em]
    have hInf_U : U₁ ⊓ U₂ = ⊥ := by
      ext x
      change x ∈ K₀ ∧ x ∈ K₀ᶜ ↔ False
      simp
    have _ : CompactSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of K_bar)) :=
      AlgebraicGeometry.Scheme.compactSpace_of_isAffine _
    have _ : CompactSpace ↥Y_gen :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p_gen
    have hComp_U₁ : IsCompact (U₁ : Set ↥Y_gen) := hK₀.isClosed.isCompact
    have hComp_U₂ : IsCompact (U₂ : Set ↥Y_gen) := hK₀.compl.isClosed.isCompact

    let J := ULiftHom.{u} (Finset K_bar)
    let I := Jᵒᵖ

    have hDescendClopen :
        ∀ (D : I ⥤ AlgebraicGeometry.Scheme.{u})
          (π_nat : (CategoryTheory.Functor.const I).obj Y_gen ⟶ D),
          Limits.IsLimit (Limits.Cone.mk Y_gen π_nat) →
          (∀ {i j : I} (u : i ⟶ j), AlgebraicGeometry.IsAffineHom (D.map u)) →
          (∀ i : I, CompactSpace ↥(D.obj i)) →
          (∀ i : I, QuasiSeparatedSpace ↥(D.obj i)) →
          ∃ (j₂ : I) (𝒰₁ 𝒰₂ : (D.obj j₂).Opens),
            𝒰₁ ⊔ 𝒰₂ = ⊤ ∧
            𝒰₁ ⊓ 𝒰₂ = ⊥ ∧
            (TopologicalSpace.Opens.map (π_nat.app j₂).base).obj 𝒰₁ = U₁ ∧
            (TopologicalSpace.Opens.map (π_nat.app j₂).base).obj 𝒰₂ = U₂ := by
      intro D π_nat hc hAffD hCompD hQSD
      let c : Limits.Cone D := Limits.Cone.mk Y_gen π_nat
      obtain ⟨i₁, V₁, hComp_V₁, hPre_V₁⟩ :=
        AlgebraicGeometry.exists_preimage_eq D c hc U₁ hComp_U₁
      obtain ⟨i₂, V₂, hComp_V₂, hPre_V₂⟩ :=
        AlgebraicGeometry.exists_preimage_eq D c hc U₂ hComp_U₂
      let i₀ : I := Opposite.op (ULiftHom.objUp
        (ULiftHom.objDown (Opposite.unop i₁) ∪ ULiftHom.objDown (Opposite.unop i₂)))
      let u₀₁ : i₀ ⟶ i₁ := Quiver.Hom.op (ULift.up (homOfLE Finset.subset_union_left))
      let u₀₂ : i₀ ⟶ i₂ := Quiver.Hom.op (ULift.up (homOfLE Finset.subset_union_right))
      let W₁ : (D.obj i₀).Opens := (TopologicalSpace.Opens.map (D.map u₀₁).base).obj V₁
      let W₂ : (D.obj i₀).Opens := (TopologicalSpace.Opens.map (D.map u₀₂).base).obj V₂
      have hComp_W₁ : IsCompact (W₁ : Set ↥(D.obj i₀)) :=
        AlgebraicGeometry.QuasiCompact.isCompact_preimage (f := D.map u₀₁) _ V₁.isOpen hComp_V₁
      have hComp_W₂ : IsCompact (W₂ : Set ↥(D.obj i₀)) :=
        AlgebraicGeometry.QuasiCompact.isCompact_preimage (f := D.map u₀₂) _ V₂.isOpen hComp_V₂
      have hPre_W₁ : (TopologicalSpace.Opens.map (c.π.app i₀).base).obj W₁ = U₁ := by
        have hw := c.w u₀₁
        ext x
        change (D.map u₀₁).base ((c.π.app i₀).base x) ∈ V₁ ↔ x ∈ U₁
        rw [← Scheme.Hom.comp_apply, hw]
        change x ∈ (TopologicalSpace.Opens.map (c.π.app i₁).base).obj V₁ ↔ x ∈ U₁
        rw [hPre_V₁]
      have hPre_W₂ : (TopologicalSpace.Opens.map (c.π.app i₀).base).obj W₂ = U₂ := by
        have hw := c.w u₀₂
        ext x
        change (D.map u₀₂).base ((c.π.app i₀).base x) ∈ V₂ ↔ x ∈ U₂
        rw [← Scheme.Hom.comp_apply, hw]
        change x ∈ (TopologicalSpace.Opens.map (c.π.app i₂).base).obj V₂ ↔ x ∈ U₂
        rw [hPre_V₂]
      have hSup_pre_i₀ : (TopologicalSpace.Opens.map (c.π.app i₀).base).obj (W₁ ⊔ W₂) = ⊤ := by
        change (TopologicalSpace.Opens.map (c.π.app i₀).base).obj W₁ ⊔
          (TopologicalSpace.Opens.map (c.π.app i₀).base).obj W₂ = ⊤
        rw [hPre_W₁, hPre_W₂, hSup_U]
      obtain ⟨j₁, f₁, hTop_j₁⟩ :=
        AlgebraicGeometry.exists_map_eq_top D c hc (W₁ ⊔ W₂) hSup_pre_i₀
      let W'₁ : (D.obj j₁).Opens := (TopologicalSpace.Opens.map (D.map f₁).base).obj W₁
      let W'₂ : (D.obj j₁).Opens := (TopologicalSpace.Opens.map (D.map f₁).base).obj W₂
      have hComp_W'₁ : IsCompact (W'₁ : Set ↥(D.obj j₁)) :=
        AlgebraicGeometry.QuasiCompact.isCompact_preimage (f := D.map f₁) _ W₁.isOpen hComp_W₁
      have hComp_W'₂ : IsCompact (W'₂ : Set ↥(D.obj j₁)) :=
        AlgebraicGeometry.QuasiCompact.isCompact_preimage (f := D.map f₁) _ W₂.isOpen hComp_W₂
      have _ : QuasiSeparatedSpace ↥(D.obj j₁) := hQSD j₁
      have hComp_inter : IsCompact ((W'₁ ⊓ W'₂ : (D.obj j₁).Opens) : Set ↥(D.obj j₁)) :=
        hComp_W'₁.inter_of_isOpen hComp_W'₂ W'₁.isOpen W'₂.isOpen
      have hPre_W'₁ : (TopologicalSpace.Opens.map (c.π.app j₁).base).obj W'₁ = U₁ := by
        have hw := c.w f₁
        ext x
        change (D.map f₁).base ((c.π.app j₁).base x) ∈ W₁ ↔ x ∈ U₁
        rw [← Scheme.Hom.comp_apply, hw]
        change x ∈ (TopologicalSpace.Opens.map (c.π.app i₀).base).obj W₁ ↔ x ∈ U₁
        rw [hPre_W₁]
      have hPre_W'₂ : (TopologicalSpace.Opens.map (c.π.app j₁).base).obj W'₂ = U₂ := by
        have hw := c.w f₁
        ext x
        change (D.map f₁).base ((c.π.app j₁).base x) ∈ W₂ ↔ x ∈ U₂
        rw [← Scheme.Hom.comp_apply, hw]
        change x ∈ (TopologicalSpace.Opens.map (c.π.app i₀).base).obj W₂ ↔ x ∈ U₂
        rw [hPre_W₂]
      have hPre_bot : c.π.app j₁ ⁻¹ᵁ (W'₁ ⊓ W'₂) = c.π.app j₁ ⁻¹ᵁ (⊥ : (D.obj j₁).Opens) := by
        change (TopologicalSpace.Opens.map (c.π.app j₁).base).obj W'₁ ⊓
            (TopologicalSpace.Opens.map (c.π.app j₁).base).obj W'₂ =
          (TopologicalSpace.Opens.map (c.π.app j₁).base).obj ⊥
        rw [hPre_W'₁, hPre_W'₂, hInf_U]
        rfl
      obtain ⟨j₂, f₂, hBot_j₂⟩ :=
        AlgebraicGeometry.exists_map_preimage_eq_map_preimage D c hc
          hComp_inter isCompact_empty hPre_bot
      have hSup_W' : W'₁ ⊔ W'₂ = ⊤ := hTop_j₁
      let 𝒰₁ : (D.obj j₂).Opens := (TopologicalSpace.Opens.map (D.map f₂).base).obj W'₁
      let 𝒰₂ : (D.obj j₂).Opens := (TopologicalSpace.Opens.map (D.map f₂).base).obj W'₂
      refine ⟨j₂, 𝒰₁, 𝒰₂, ?_, hBot_j₂, ?_, ?_⟩
      · change (TopologicalSpace.Opens.map (D.map f₂).base).obj (W'₁ ⊔ W'₂) = ⊤
        rw [hSup_W']
        rfl
      · have hw := c.w f₂
        ext x
        change (D.map f₂).base ((c.π.app j₂).base x) ∈ W'₁ ↔ x ∈ U₁
        rw [← Scheme.Hom.comp_apply, hw]
        change x ∈ (TopologicalSpace.Opens.map (c.π.app j₁).base).obj W'₁ ↔ x ∈ U₁
        rw [hPre_W'₁]
      · have hw := c.w f₂
        ext x
        change (D.map f₂).base ((c.π.app j₂).base x) ∈ W'₂ ↔ x ∈ U₂
        rw [← Scheme.Hom.comp_apply, hw]
        change x ∈ (TopologicalSpace.Opens.map (c.π.app j₁).base).obj W'₂ ↔ x ∈ U₂
        rw [hPre_W'₂]

    let B_S : Finset K_bar → Subalgebra A K_bar := fun S => Algebra.adjoin A (↑S : Set K_bar)
    let S_of : I → Finset K_bar := fun i => ULiftHom.objDown (Opposite.unop i)
    let inc_S : ∀ {S₁ S₂ : Finset K_bar}, S₁ ≤ S₂ → (↥(B_S S₁) →+* ↥(B_S S₂)) :=
      fun h => (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr h))).toRingHom
    let baseObj : I → AlgebraicGeometry.Scheme.{u} :=
      fun i => AlgebraicGeometry.Spec (CommRingCat.of ↥(B_S (S_of i)))
    let baseMap : ∀ {i j : I}, (i ⟶ j) → (baseObj i ⟶ baseObj j) :=
      fun u => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (inc_S (leOfHom u.unop.down)))
    let baseπ : ∀ i : I, AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶ baseObj i :=
      fun i => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (B_S (S_of i)).val.toRingHom)
    let f_base : ∀ i : I, baseObj i ⟶ AlgebraicGeometry.Spec (CommRingCat.of A) :=
      fun i => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A ↥(B_S (S_of i))))
    have hf_base_map : ∀ {i j : I} (u : i ⟶ j), baseMap u ≫ f_base j = f_base i := by
      intro i j u
      dsimp only [baseMap, f_base]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl
    have hc_base_gen : ∀ i : I, baseπ i ≫ f_base i = s_gen := by
      intro i
      dsimp only [baseπ, f_base, s_gen]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl
    have hbaseπ_w : ∀ {i j : I} (u : i ⟶ j), baseπ i ≫ baseMap u = baseπ j := by
      intro i j u
      dsimp only [baseπ, baseMap]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl

    have hBaseUniv : ∀ (X : AlgebraicGeometry.Scheme.{u})
        (m_i : ∀ i : I, X ⟶ baseObj i),
        (∀ {i j : I} (u : i ⟶ j), m_i i ≫ baseMap u = m_i j) →
        ∃! m_K : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K_bar),
          ∀ i : I, m_K ≫ baseπ i = m_i i := by
      intro X m_i hm_w
      let adj := AlgebraicGeometry.ΓSpec.adjunction
      let R_X : CommRingCat.{u} := AlgebraicGeometry.Scheme.Γ.obj (Opposite.op X)
      let toRing : ∀ {R : CommRingCat.{u}}, (X ⟶ AlgebraicGeometry.Spec R) ≃ (R ⟶ R_X) :=
        fun {R} =>
          { toFun := fun f => ((adj.homEquiv X (Opposite.op R)).symm f).unop
            invFun := fun g => (adj.homEquiv X (Opposite.op R)) g.op
            left_inv := fun f => (adj.homEquiv X (Opposite.op R)).apply_symm_apply f
            right_inv := fun g =>
              congrArg Quiver.Hom.unop ((adj.homEquiv X (Opposite.op R)).symm_apply_apply g.op) }
      have hNat : ∀ {R S : CommRingCat.{u}} (φ : R ⟶ S) (f : X ⟶ AlgebraicGeometry.Spec S),
          toRing (f ≫ AlgebraicGeometry.Spec.map φ) = φ ≫ toRing f := by
        intro R S φ f
        have h := adj.homEquiv_naturality_right_symm f φ.op
        exact Quiver.Hom.op_inj h
      let φ_i : ∀ S : Finset K_bar, CommRingCat.of ↥(B_S S) ⟶ R_X :=
        fun S => toRing (m_i (Opposite.op (ULiftHom.objUp S)))
      have hCompat : ∀ (S₁ S₂ : Finset K_bar) (h : S₁ ≤ S₂) (x : ↥(B_S S₁)),
          (φ_i S₂).hom (inc_S h x) = (φ_i S₁).hom x := by
        intro S₁ S₂ h x
        let u : Opposite.op (ULiftHom.objUp S₂) ⟶ Opposite.op (ULiftHom.objUp S₁) :=
          Quiver.Hom.op (ULift.up (homOfLE h))
        have hw := congrArg toRing (hm_w u)
        rw [hNat] at hw
        exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hw) x
      have hEqSing : ∀ (S : Finset K_bar) (x : K_bar) (hx : x ∈ B_S S),
          (φ_i S).hom ⟨x, hx⟩ = (φ_i {x}).hom ⟨x, Algebra.subset_adjoin (by simp)⟩ := by
        intro S x hx
        have h1 := hCompat S (S ∪ {x}) Finset.subset_union_left ⟨x, hx⟩
        have h2 := hCompat {x} (S ∪ {x}) Finset.subset_union_right
          ⟨x, Algebra.subset_adjoin (by simp)⟩
        exact h1.symm.trans h2
      let φ_K : CommRingCat.of K_bar ⟶ R_X := CommRingCat.ofHom
        { toFun := fun x => (φ_i {x}).hom ⟨x, Algebra.subset_adjoin (by simp)⟩
          map_one' := by
            rw [← hEqSing ∅ 1 (B_S ∅).one_mem]
            exact map_one (φ_i ∅).hom
          map_mul' := fun x y => by
            have hx : x ∈ B_S ({x, y} : Finset K_bar) := Algebra.subset_adjoin (by simp)
            have hy : y ∈ B_S ({x, y} : Finset K_bar) := Algebra.subset_adjoin (by simp)
            rw [← hEqSing ({x, y}) (x * y) (mul_mem hx hy),
              ← hEqSing ({x, y}) x hx, ← hEqSing ({x, y}) y hy]
            exact map_mul (φ_i {x, y}).hom ⟨x, hx⟩ ⟨y, hy⟩
          map_zero' := by
            rw [← hEqSing ∅ 0 (B_S ∅).zero_mem]
            exact map_zero (φ_i ∅).hom
          map_add' := fun x y => by
            have hx : x ∈ B_S ({x, y} : Finset K_bar) := Algebra.subset_adjoin (by simp)
            have hy : y ∈ B_S ({x, y} : Finset K_bar) := Algebra.subset_adjoin (by simp)
            rw [← hEqSing ({x, y}) (x + y) (add_mem hx hy),
              ← hEqSing ({x, y}) x hx, ← hEqSing ({x, y}) y hy]
            exact map_add (φ_i {x, y}).hom ⟨x, hx⟩ ⟨y, hy⟩ }
      refine ⟨toRing.symm φ_K, ?_, ?_⟩
      · intro i
        apply toRing.injective
        rw [hNat, toRing.apply_symm_apply]
        ext ⟨x, hx⟩
        exact (hEqSing (S_of i) x hx).symm
      · intro m' hm'
        apply toRing.injective
        rw [toRing.apply_symm_apply]
        ext x
        have hx_eq := congrArg toRing (hm' (Opposite.op (ULiftHom.objUp ({x} : Finset K_bar))))
        rw [hNat] at hx_eq
        have hx_mem : x ∈ B_S (S_of (Opposite.op (ULiftHom.objUp ({x} : Finset K_bar)))) :=
          Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_singleton_self x))
        exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hx_eq) ⟨x, hx_mem⟩

    let D : I ⥤ AlgebraicGeometry.Scheme.{u} :=
      { obj := fun i => CategoryTheory.Limits.pullback g (f_base i)
        map := fun {i j} u => CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst g (f_base i))
          (CategoryTheory.Limits.pullback.snd g (f_base i) ≫ baseMap u)
          (by rw [CategoryTheory.Category.assoc, hf_base_map u,
            CategoryTheory.Limits.pullback.condition])
        map_id := fun i => by
          apply CategoryTheory.Limits.pullback.hom_ext
          · simp only [CategoryTheory.Category.id_comp, CategoryTheory.Limits.pullback.lift_fst]
          · simp only [CategoryTheory.Category.id_comp, CategoryTheory.Limits.pullback.lift_snd]
            have hid : baseMap (𝟙 i) = 𝟙 (baseObj i) := by
              dsimp only [baseMap]
              have h1 : inc_S (leOfHom (𝟙 i : i ⟶ i).unop.down) = RingHom.id _ := by ext; rfl
              rw [h1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
            rw [hid, CategoryTheory.Category.comp_id]
        map_comp := fun {i j k} u v => by
          apply CategoryTheory.Limits.pullback.hom_ext
          · simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
          · simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Limits.pullback.lift_snd_assoc]
            have hcomp : baseMap (u ≫ v) = baseMap u ≫ baseMap v := by
              dsimp only [baseMap]
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
              rfl
            rw [hcomp] }
    let π_gen : ∀ i : I, Y_gen ⟶ D.obj i :=
      fun i => CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g s_gen)
        (CategoryTheory.Limits.pullback.snd g s_gen ≫ baseπ i)
        (by rw [CategoryTheory.Category.assoc, hc_base_gen i,
          CategoryTheory.Limits.pullback.condition])
    let π_nat : (CategoryTheory.Functor.const I).obj Y_gen ⟶ D :=
      { app := π_gen
        naturality := fun i j u => by
          apply CategoryTheory.Limits.pullback.hom_ext
          · simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
              CategoryTheory.Category.id_comp, D, π_gen, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst]
          · simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
              CategoryTheory.Category.id_comp, D, π_gen, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd_assoc]
            rw [hbaseπ_w u] }
    let c : Limits.Cone D := Limits.Cone.mk Y_gen π_nat
    let i_bot : I := Opposite.op (ULiftHom.objUp (∅ : Finset K_bar))
    have hEx_hc : Nonempty (Limits.IsLimit c) := by
      refine ⟨{ lift := ?_, fac := ?_, uniq := ?_ }⟩
      · intro s
        have hm_base_w : ∀ {i j : I} (u : i ⟶ j),
            (s.π.app i ≫ CategoryTheory.Limits.pullback.snd g (f_base i)) ≫ baseMap u =
              s.π.app j ≫ CategoryTheory.Limits.pullback.snd g (f_base j) := by
          intro i j u
          rw [← s.w u]
          simp only [D, CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
        let m_K := Classical.choose (hBaseUniv s.pt
          (fun i => s.π.app i ≫ CategoryTheory.Limits.pullback.snd g (f_base i)) hm_base_w)
        have hm_K_fac : ∀ i : I, m_K ≫ baseπ i =
            s.π.app i ≫ CategoryTheory.Limits.pullback.snd g (f_base i) :=
          (Classical.choose_spec (hBaseUniv s.pt
            (fun i => s.π.app i ≫ CategoryTheory.Limits.pullback.snd g (f_base i)) hm_base_w)).1
        exact CategoryTheory.Limits.pullback.lift
          (s.π.app i_bot ≫ CategoryTheory.Limits.pullback.fst g (f_base i_bot))
          m_K
          (by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
              ← hc_base_gen i_bot, ← CategoryTheory.Category.assoc m_K, hm_K_fac i_bot,
              CategoryTheory.Category.assoc])
      · intro s i
        have hm_base_w : ∀ {i' j' : I} (u : i' ⟶ j'),
            (s.π.app i' ≫ CategoryTheory.Limits.pullback.snd g (f_base i')) ≫ baseMap u =
              s.π.app j' ≫ CategoryTheory.Limits.pullback.snd g (f_base j') := by
          intro i' j' u
          rw [← s.w u]
          simp only [D, CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
        have hm_K_fac : ∀ k : I,
            Classical.choose (hBaseUniv s.pt
              (fun i' => s.π.app i' ≫ CategoryTheory.Limits.pullback.snd g (f_base i')) hm_base_w) ≫
              baseπ k =
            s.π.app k ≫ CategoryTheory.Limits.pullback.snd g (f_base k) :=
          (Classical.choose_spec (hBaseUniv s.pt
            (fun i' => s.π.app i' ≫ CategoryTheory.Limits.pullback.snd g (f_base i')) hm_base_w)).1
        apply CategoryTheory.Limits.pullback.hom_ext
        · simp only [c, π_nat, π_gen, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst]
          have hu : i ⟶ i_bot := Quiver.Hom.op (ULift.up (homOfLE (Finset.empty_subset _)))
          rw [← s.w hu]
          simp only [D, CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
        · simp only [c, π_nat, π_gen, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd_assoc]
          exact hm_K_fac i
      · intro s m hm
        dsimp only [c, π_nat] at m hm
        have hm_base_w : ∀ {i' j' : I} (u : i' ⟶ j'),
            (s.π.app i' ≫ CategoryTheory.Limits.pullback.snd g (f_base i')) ≫ baseMap u =
              s.π.app j' ≫ CategoryTheory.Limits.pullback.snd g (f_base j') := by
          intro i' j' u
          rw [← s.w u]
          simp only [D, CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
        have hm_K_uniq := (Classical.choose_spec (hBaseUniv s.pt
          (fun i' => s.π.app i' ≫ CategoryTheory.Limits.pullback.snd g (f_base i')) hm_base_w)).2
        apply CategoryTheory.Limits.pullback.hom_ext
        · simp only [CategoryTheory.Limits.pullback.lift_fst]
          have hm_bot := congrArg (fun k => k ≫ CategoryTheory.Limits.pullback.fst g (f_base i_bot))
            (hm i_bot)
          simpa only [π_gen, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst] using hm_bot
        · simp only [CategoryTheory.Limits.pullback.lift_snd]
          refine hm_K_uniq (m ≫ CategoryTheory.Limits.pullback.snd g s_gen) (fun i => ?_)
          have hm_i := congrArg (fun k => k ≫ CategoryTheory.Limits.pullback.snd g (f_base i))
            (hm i)
          simpa only [π_gen, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_snd] using hm_i
    obtain ⟨hc⟩ := hEx_hc

    have hAffD : ∀ {i j : I} (u : i ⟶ j), AlgebraicGeometry.IsAffineHom (D.map u) := by
      intro i j u
      have hBaseAff : AlgebraicGeometry.IsAffineHom (baseMap u) := by
        dsimp only [baseMap]
        infer_instance
      have hOuter : CategoryTheory.IsPullback
          (D.map u ≫ CategoryTheory.Limits.pullback.fst g (f_base j))
          (CategoryTheory.Limits.pullback.snd g (f_base i)) g (baseMap u ≫ f_base j) := by
        have hEq1 : D.map u ≫ CategoryTheory.Limits.pullback.fst g (f_base j) =
