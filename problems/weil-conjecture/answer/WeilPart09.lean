theorem weil_algClosed_artin_commRing_smooth_or_nodal_roof (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (D : Type u) [CommRing D] [Algebra Ω D] [Algebra.FiniteType Ω D] [IsReduced D]
    (q : PrimeSpectrum D) :
    q.asIdeal.IsMaximal →
    ((let L := Localization.AtPrime q.asIdeal
      let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
      Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2) →
      ∃ f : D, f ∉ q.asIdeal ∧
        RingHom.IsStandardSmoothOfRelativeDimension 1
          (algebraMap Ω (Localization.Away f))) ∧
    ((let L := Localization.AtPrime q.asIdeal
      let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
      Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
      Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
      ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3) →
      ∃ (B : Type u) (_ : CommRing B) (q_B : PrimeSpectrum B)
        (φ_D : D →+* B)
        (φ_node : (MvPolynomial (Fin 2) Ω ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B),
        φ_D.Etale ∧
        φ_node.Etale ∧
        PrimeSpectrum.comap φ_D q_B = q ∧
        (∀ i : Fin 2, φ_node (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q_B.asIdeal) ∧
        φ_D.comp (algebraMap Ω D) =
          φ_node.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) :=
by
  rename_i instFieldΩ_outer instAlgClosedΩ_outer instCommRingD_outer instAlgΩD_outer
    instFTD_outer instRedD_outer
  have h_s2 :
      (∀ (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R] (π : R),
        Ideal.span {π} = IsLocalRing.maximalIdeal R →
        ∀ J : Ideal R, J ≠ ⊥ → J ≠ ⊤ → ∃ k : ℕ, 1 ≤ k ∧ J = Ideal.span {π ^ k}) ∧
      (∀ (D A : Type u) [CommRing D] [IsNoetherianRing D] [IsReduced D]
        [CommRing A] [Algebra D A] [Algebra.Etale D A],
        IsReduced A) := by
    clear q instRedD_outer instFTD_outer instAlgΩD_outer instCommRingD_outer D
      instAlgClosedΩ_outer instFieldΩ_outer Ω
    constructor
    · intro R _ _ _ π hπ J hJ_bot hJ_top
      let 𝔪 := IsLocalRing.maximalIdeal R
      have hJ_le : J ≤ 𝔪 := IsLocalRing.le_maximalIdeal hJ_top
