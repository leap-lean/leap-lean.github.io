      fun a b u =>
        AlgebraicGeometry.Scheme.Hom.resLE (𝟙 (D.obj u.left))
          ((D.map u.hom) ⁻¹ᵁ (W₀ a)) ((D.map u.hom) ⁻¹ᵁ (W₀ a ⊓ W₀ b))
