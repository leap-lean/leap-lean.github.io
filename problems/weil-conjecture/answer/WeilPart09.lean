      rw [MvPolynomial.eval₂Hom_C]
      exact MvPolynomial.eval₂Hom_X' (algebraMap Ω D) (fun _ : Unit => d₀) ()
    have hΦ_aux : ∀ F : P_aux, Φ_sm (ι_aux F) = MvPolynomial.aeval y F := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C c =>
        rw [MvPolynomial.aeval_C]
        change MvPolynomial.eval₂Hom Φ₁ y ((MvPolynomial.map MvPolynomial.C) (MvPolynomial.C c)) =
          algebraMap Ω D c
        rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
        exact MvPolynomial.eval₂Hom_C (algebraMap Ω D) (fun _ : Unit => d₀) c
      | add p q hp hq =>
        simp only [map_add, hp, hq]
      | mul_X p j hp =>
        simp only [map_mul, hp, MvPolynomial.aeval_X]
        have hX : Φ_sm (ι_aux (MvPolynomial.X j)) = y j := by
          change MvPolynomial.eval₂Hom Φ₁ y ((MvPolynomial.map MvPolynomial.C) (MvPolynomial.X j)) = y j
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
        rw [hX]
    have hΦ_sm_surj : Function.Surjective Φ_sm := by
      intro d
      obtain ⟨F, rfl⟩ := h_aeval_y_surj d
      exact ⟨ι_aux F, hΦ_aux F⟩
    have hG_ker : Ideal.span (Set.range G) ≤ RingHom.ker Φ_sm := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      change Φ_sm (S_tilde j * W j - A_tilde j * MvPolynomial.C X₀) = 0
      simp only [map_sub, map_mul, S_tilde, A_tilde, W, hΦ_aux, (hSA₀ j).1, (hSA₀ j).2]
      have hW : Φ_sm (MvPolynomial.X j) = y j := MvPolynomial.eval₂Hom_X' Φ₁ y j
      rw [hW, hΦ_X₀]
      exact (hyta j).2.2
    let Φ_bar : Q_sm →+* D := Ideal.Quotient.lift (Ideal.span (Set.range G)) Φ_sm hG_ker
    have hΦ_bar_surj : Function.Surjective Φ_bar := by
      intro d
      obtain ⟨P, rfl⟩ := hΦ_sm_surj d
      exact ⟨Ideal.Quotient.mk _ P, rfl⟩
    let δ₀ : D := Φ_bar Δ_bar
    let ev₀ : P_sm →+* Ω := res_Ω.comp Φ_sm
    have hev₀_W : ∀ j : Fin r, ev₀ (W j) = 0 := by
      intro j
      change res_Ω (Φ_sm (MvPolynomial.X j)) = 0
      rw [MvPolynomial.eval₂Hom_X']
      exact (hyta j).1
    have hev₀_X₀ : ev₀ (MvPolynomial.C X₀) = 0 := by
      change res_Ω (Φ_sm (MvPolynomial.C X₀)) = 0
      rw [hΦ_X₀]
      exact hd₀
    have hev₀_S : ∀ j : Fin r, ev₀ (S_tilde j) = res_Ω (t j) := by
      intro j
      change res_Ω (Φ_sm (ι_aux (S₀ j))) = res_Ω (t j)
      rw [hΦ_aux, (hSA₀ j).1]
    have h_jac_mat_ev : ev₀.mapMatrix J_mat =
        Matrix.diagonal (fun j : Fin r => res_Ω (t j)) := by
      ext i j
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, J_mat, Matrix.of_apply]
      change ev₀ ((MvPolynomial.pderiv i) (S_tilde j * W j - A_tilde j * MvPolynomial.C X₀)) =
        Matrix.diagonal (fun j : Fin r => res_Ω (t j)) i j
      rw [map_sub, Derivation.leibniz, Derivation.leibniz]
      have hpX₀ : MvPolynomial.pderiv i (MvPolynomial.C X₀ : P_sm) = 0 := MvPolynomial.pderiv_C
      have hpW : MvPolynomial.pderiv i (W j) = if j = i then 1 else 0 := by
        change MvPolynomial.pderiv i (MvPolynomial.X j) = _
        rw [MvPolynomial.pderiv_X, Pi.single_apply]
      have hevW0 : ev₀ (W j) = 0 := hev₀_W j
      simp only [smul_eq_mul, hpX₀, hpW, map_sub, map_add, map_mul, hevW0, hev₀_X₀, hev₀_S,
        mul_zero, zero_mul, add_zero, zero_add, sub_zero]
      by_cases hij : j = i
      · subst hij
        simp [Matrix.diagonal]
      · have hij' : i ≠ j := fun h => hij h.symm
        simp [Matrix.diagonal, hij, hij']
    have hδ₀_res : res_Ω δ₀ = ∏ j : Fin r, res_Ω (t j) := by
      change ev₀ J_mat.det = _
      rw [RingHom.map_det, h_jac_mat_ev, Matrix.det_diagonal]
    have hδ₀_ne : res_Ω δ₀ ≠ 0 := by
      rw [hδ₀_res]
      exact Finset.prod_ne_zero_iff.mpr fun j _ => (hyta j).2.1
    let D_δ : Type u := Localization.Away δ₀
    let ι_QsmBsm := @algebraMap Q_sm B_sm inferInstance inferInstance inferInstance
    let ι_DDδ := @algebraMap D D_δ inferInstance inferInstance inferInstance
    have hδ₀_unit_Dδ : IsUnit ((ι_DDδ.comp Φ_bar) Δ_bar) :=
      IsLocalization.Away.algebraMap_isUnit (S := D_δ) δ₀
    let Ψ_sm : B_sm →+* D_δ :=
      IsLocalization.Away.lift (S := B_sm) (g := ι_DDδ.comp Φ_bar) Δ_bar hδ₀_unit_Dδ
    have hΨ_sm_eq : ∀ q : Q_sm, Ψ_sm (algebraMap Q_sm B_sm q) = algebraMap D D_δ (Φ_bar q) :=
      IsLocalization.Away.lift_eq Δ_bar hδ₀_unit_Dδ
    have hΨ_sm_alg : ∀ c : Ω, Ψ_sm (algebraMap Ω B_sm c) = algebraMap Ω D_δ c := by
      intro c
      rw [IsScalarTower.algebraMap_apply Ω Q_sm B_sm c,
        IsScalarTower.algebraMap_apply Ω D D_δ c, hΨ_sm_eq]
      apply congrArg (algebraMap D D_δ)
      rw [IsScalarTower.algebraMap_apply Ω P₁ Q_sm c,
        IsScalarTower.algebraMap_apply P₁ P_sm Q_sm (algebraMap Ω P₁ c),
        MvPolynomial.algebraMap_eq, MvPolynomial.algebraMap_eq]
      change Φ_sm (MvPolynomial.C (MvPolynomial.C c)) = algebraMap Ω D c
      rw [MvPolynomial.eval₂Hom_C]
      exact MvPolynomial.eval₂Hom_C (algebraMap Ω D) (fun _ : Unit => d₀) c
    have hΨ_sm_surj : Function.Surjective Ψ_sm := by
      intro z
      obtain ⟨n, d, hd_eq⟩ := IsLocalization.Away.surj δ₀ z
      obtain ⟨q₀, rfl⟩ := hΦ_bar_surj d
      obtain ⟨u_Δ, hu_Δ⟩ := IsLocalization.Away.algebraMap_isUnit (S := B_sm) Δ_bar
      refine ⟨ι_QsmBsm q₀ * (↑u_Δ⁻¹) ^ n, ?_⟩
      have h_map_Δ : Ψ_sm (algebraMap Q_sm B_sm Δ_bar) = algebraMap D D_δ δ₀ :=
        hΨ_sm_eq Δ_bar
      have h_inv : Ψ_sm (↑u_Δ⁻¹) * algebraMap D D_δ δ₀ = 1 := by
        rw [← h_map_Δ, ← hu_Δ, ← map_mul, Units.inv_mul, map_one]
      obtain ⟨u_δ, hu_δ⟩ := IsLocalization.Away.algebraMap_isUnit (S := D_δ) δ₀
      apply (Units.mul_left_inj (u_δ ^ n)).mp
      calc
        Ψ_sm (algebraMap Q_sm B_sm q₀ * (↑u_Δ⁻¹) ^ n) * ↑(u_δ ^ n)
          = Ψ_sm (algebraMap Q_sm B_sm q₀) * (Ψ_sm (↑u_Δ⁻¹) * algebraMap D D_δ δ₀) ^ n := by
              rw [Units.val_pow_eq_pow_val, hu_δ, map_mul, map_pow, mul_assoc, ← mul_pow]
        _ = algebraMap D D_δ (Φ_bar q₀) := by
              rw [h_inv, one_pow, mul_one, hΨ_sm_eq]
        _ = z * ↑(u_δ ^ n) := by
              rw [Units.val_pow_eq_pow_val, hu_δ, hd_eq]
    let res_δ : D_δ →+* Ω := IsLocalization.Away.lift δ₀ (Ne.isUnit hδ₀_ne)
    have hres_δ_comp : ∀ d : D, res_δ (algebraMap D D_δ d) = res_Ω d :=
      IsLocalization.Away.lift_eq δ₀ (Ne.isUnit hδ₀_ne)
    have hres_δ_id : res_δ.comp (algebraMap Ω D_δ) = RingHom.id Ω := by
      ext c
      change res_δ (algebraMap Ω D_δ c) = c
      rw [IsScalarTower.algebraMap_apply Ω D D_δ c, hres_δ_comp, hres_c]
    let ev_sm : B_sm →+* Ω := res_δ.comp Ψ_sm
    have hev_sm_c : ∀ c : Ω, ev_sm (algebraMap Ω B_sm c) = c := by
      intro c
      change res_δ (Ψ_sm (algebraMap Ω B_sm c)) = c
      have hc : res_δ (algebraMap Ω D_δ c) = c := RingHom.congr_fun hres_δ_id c
      rw [hΨ_sm_alg, hc]
    have hev_sm_surj : Function.Surjective ev_sm := fun c => ⟨algebraMap Ω B_sm c, hev_sm_c c⟩
    let 𝔓₀ : Ideal B_sm := RingHom.ker ev_sm
    have : 𝔓₀.IsMaximal := RingHom.ker_isMaximal_of_surjective ev_sm hev_sm_surj
    let 𝔪_δ : Ideal D_δ := RingHom.ker res_δ
    have hres_δ_surj : Function.Surjective res_δ :=
      fun c => ⟨algebraMap Ω D_δ c, RingHom.congr_fun hres_δ_id c⟩
    have : 𝔪_δ.IsMaximal := RingHom.ker_isMaximal_of_surjective res_δ hres_δ_surj
    let R_sm : Type u := Localization.AtPrime 𝔓₀
    have : IsNoetherianRing P₁ := MvPolynomial.isNoetherianRing
    have : IsNoetherianRing P_sm := MvPolynomial.isNoetherianRing
    have : IsNoetherianRing Q_sm := Ideal.Quotient.isNoetherianRing _
    have : IsNoetherianRing B_sm := IsLocalization.isNoetherianRing (Submonoid.powers Δ_bar) B_sm inferInstance
    have : IsNoetherianRing R_sm := IsLocalization.isNoetherianRing 𝔓₀.primeCompl R_sm inferInstance
    let φ_PB := @algebraMap P_sm B_sm inferInstance inferInstance inferInstance
    have hev_sm_PB : ∀ F : P_sm, ev_sm (φ_PB F) = ev₀ F := by
      intro F
      change res_δ (Ψ_sm (algebraMap P_sm B_sm F)) = res_Ω (Φ_sm F)
      rw [IsScalarTower.algebraMap_apply P_sm Q_sm B_sm F, hΨ_sm_eq, hres_δ_comp]
      rfl
    let ι_BsmRsm := @algebraMap B_sm R_sm inferInstance inferInstance inferInstance
    let φ_PR := ι_BsmRsm.comp φ_PB
    let π₀ : R_sm := φ_PR (MvPolynomial.C X₀)
    have hπ₀_mem_max : π₀ ∈ IsLocalRing.maximalIdeal R_sm := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal 𝔓₀ R_sm]
      apply Ideal.mem_map_of_mem (algebraMap B_sm R_sm)
      change ev_sm (φ_PB (MvPolynomial.C X₀)) = 0
      rw [hev_sm_PB, hev₀_X₀]
    have hW_in_π₀ : ∀ j : Fin r, φ_PR (W j) ∈ Ideal.span {π₀} := by
      intro j
      have hS_not : φ_PB (S_tilde j) ∉ 𝔓₀ := by
        change ev_sm (φ_PB (S_tilde j)) ≠ 0
        rw [hev_sm_PB, hev₀_S]
        exact (hyta j).2.1
      obtain ⟨u_S, hu_S⟩ := IsLocalization.map_units R_sm (⟨φ_PB (S_tilde j), hS_not⟩ : 𝔓₀.primeCompl)
      have hG_zero : φ_PR (G j) = 0 := by
        change ι_BsmRsm (algebraMap P_sm B_sm (G j)) = 0
        rw [IsScalarTower.algebraMap_apply P_sm Q_sm B_sm (G j)]
        have hmk0 : algebraMap P_sm Q_sm (G j) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
        rw [hmk0, map_zero, map_zero]
      have h_rel : (↑u_S : R_sm) * φ_PR (W j) = φ_PR (A_tilde j) * π₀ := by
        have h1 : φ_PR (S_tilde j) * φ_PR (W j) - φ_PR (A_tilde j) * π₀ = 0 := by
          simpa [G, map_sub, map_mul, π₀] using hG_zero
        have h2 : (↑u_S : R_sm) = φ_PR (S_tilde j) := hu_S
        rw [h2]
        exact sub_eq_zero.mp h1
      rw [Ideal.mem_span_singleton]
      refine ⟨↑u_S⁻¹ * φ_PR (A_tilde j), ?_⟩
      apply (Units.mul_left_inj u_S).mp
      calc
        φ_PR (W j) * ↑u_S = ↑u_S * φ_PR (W j) := mul_comm _ _
        _ = φ_PR (A_tilde j) * π₀ := h_rel
        _ = (φ_PR (A_tilde j) * π₀) * (↑u_S * ↑u_S⁻¹) := by rw [Units.mul_inv, mul_one]
        _ = π₀ * (↑u_S⁻¹ * φ_PR (A_tilde j)) * ↑u_S := by ring
    have hP₁_mod_π₀ : ∀ p : P₁,
        φ_PR (MvPolynomial.C p) - algebraMap Ω R_sm (ev₀ (MvPolynomial.C p)) ∈ Ideal.span {π₀} := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C c =>
        have hc : ev₀ (MvPolynomial.C (MvPolynomial.C c)) = c := by
          change res_Ω (Φ_sm (MvPolynomial.C (MvPolynomial.C c))) = c
          rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C, hres_c]
        have hcR : φ_PR (MvPolynomial.C (MvPolynomial.C c)) = algebraMap Ω R_sm c := by
          rw [IsScalarTower.algebraMap_apply Ω B_sm R_sm c,
            IsScalarTower.algebraMap_apply Ω Q_sm B_sm c,
            IsScalarTower.algebraMap_apply Ω P₁ Q_sm c,
            IsScalarTower.algebraMap_apply P₁ P_sm Q_sm (algebraMap Ω P₁ c),
            MvPolynomial.algebraMap_eq, MvPolynomial.algebraMap_eq]
          rfl
        rw [hc, hcR, sub_self]
        exact Ideal.zero_mem _
      | add p₁ p₂ hp₁ hp₂ =>
        simp only [map_add]
        have h_eq : φ_PR (MvPolynomial.C p₁) + φ_PR (MvPolynomial.C p₂) -
            (algebraMap Ω R_sm (ev₀ (MvPolynomial.C p₁)) + algebraMap Ω R_sm (ev₀ (MvPolynomial.C p₂))) =
            (φ_PR (MvPolynomial.C p₁) - algebraMap Ω R_sm (ev₀ (MvPolynomial.C p₁))) +
              (φ_PR (MvPolynomial.C p₂) - algebraMap Ω R_sm (ev₀ (MvPolynomial.C p₂))) := by ring
        rw [h_eq]
        exact Ideal.add_mem _ hp₁ hp₂
      | mul_X p' u _ =>
        have hu : u = () := Subsingleton.elim u ()
        subst hu
        rw [map_mul, map_mul, map_mul, hev₀_X₀, mul_zero, map_zero, sub_zero]
        exact Ideal.mem_span_singleton.mpr ⟨φ_PR (MvPolynomial.C p'), mul_comm (φ_PR (MvPolynomial.C p')) π₀⟩
    have hPsm_mod_π₀ : ∀ F : P_sm,
        φ_PR F - algebraMap Ω R_sm (ev₀ F) ∈ Ideal.span {π₀} := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C p => exact hP₁_mod_π₀ p
      | add F₁ F₂ hF₁ hF₂ =>
        simp only [map_add]
        have h_eq : φ_PR F₁ + φ_PR F₂ - (algebraMap Ω R_sm (ev₀ F₁) + algebraMap Ω R_sm (ev₀ F₂)) =
            (φ_PR F₁ - algebraMap Ω R_sm (ev₀ F₁)) + (φ_PR F₂ - algebraMap Ω R_sm (ev₀ F₂)) := by ring
        rw [h_eq]
        exact Ideal.add_mem _ hF₁ hF₂
      | mul_X F' j _ =>
        change φ_PR (F' * W j) - algebraMap Ω R_sm (ev₀ (F' * W j)) ∈ Ideal.span {π₀}
        rw [map_mul, map_mul, hev₀_W, mul_zero, map_zero, sub_zero]
        exact Ideal.mul_mem_left _ _ (hW_in_π₀ j)
    have hπ₀_span_max : Ideal.span {π₀} = IsLocalRing.maximalIdeal R_sm := by
      apply le_antisymm
      · rw [Ideal.span_singleton_le_iff_mem]
        exact hπ₀_mem_max
      · rw [← IsLocalization.AtPrime.map_eq_maximalIdeal 𝔓₀ R_sm, Ideal.map_le_iff_le_comap]
        intro b hb
        change ι_BsmRsm b ∈ Ideal.span {π₀}
        obtain ⟨n, q₀, hq₀_eq⟩ := IsLocalization.Away.surj Δ_bar b
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective q₀
        have hΔ_not : ι_QsmBsm Δ_bar ∉ 𝔓₀ := by
          have h_eq : ι_QsmBsm Δ_bar = φ_PB J_mat.det :=
            (IsScalarTower.algebraMap_apply P_sm Q_sm B_sm J_mat.det).symm
          change ev_sm (ι_QsmBsm Δ_bar) ≠ 0
          rw [h_eq, hev_sm_PB]
          exact hδ₀_ne
        have hΔn_not : (ι_QsmBsm Δ_bar) ^ n ∉ 𝔓₀ :=
          Submonoid.pow_mem 𝔓₀.primeCompl hΔ_not n
        obtain ⟨u_ΔR, hu_ΔR⟩ := IsLocalization.map_units R_sm (⟨(ι_QsmBsm Δ_bar) ^ n, hΔn_not⟩ : 𝔓₀.primeCompl)
        have hevF0 : ev₀ F = 0 := by
          rw [← hev_sm_PB]
          have h_eq : φ_PB F = algebraMap Q_sm B_sm (Ideal.Quotient.mk _ F) :=
            IsScalarTower.algebraMap_apply P_sm Q_sm B_sm F
          rw [h_eq, ← hq₀_eq, map_mul]
          have hb0 : ev_sm b = 0 := hb
          rw [hb0, zero_mul]
        have hFR_mem : φ_PR F ∈ Ideal.span {π₀} := by
          have h1 := hPsm_mod_π₀ F
          rwa [hevF0, map_zero, sub_zero] at h1
        have h_mul : ι_BsmRsm b * ↑u_ΔR = φ_PR F := by
          have hu_val : (↑u_ΔR : R_sm) = ι_BsmRsm ((ι_QsmBsm Δ_bar) ^ n) := hu_ΔR
          rw [hu_val, ← map_mul]
          change ι_BsmRsm (b * (algebraMap Q_sm B_sm Δ_bar) ^ n) = ι_BsmRsm (φ_PB F)
          rw [hq₀_eq, IsScalarTower.algebraMap_apply P_sm Q_sm B_sm F]
          rfl
        have hb_eq : ι_BsmRsm b = φ_PR F * ↑u_ΔR⁻¹ := by
          rw [← h_mul]
          simp
        rw [hb_eq]
        exact Ideal.mul_mem_right _ _ hFR_mem
    let L_δ : Type u := Localization.AtPrime 𝔪_δ
    let ψ_loc : R_sm →+* L_δ := Localization.localRingHom 𝔓₀ 𝔪_δ Ψ_sm rfl
    have hψ_loc_surj : Function.Surjective ψ_loc := by
      intro w
      obtain ⟨⟨x, s⟩, hx_eq⟩ := IsLocalization.surj 𝔪_δ.primeCompl w
      dsimp only at hx_eq
      obtain ⟨x₀, rfl⟩ := hΨ_sm_surj x
      obtain ⟨s₀, hs₀⟩ := hΨ_sm_surj s.1
      have hs₀_not : s₀ ∉ 𝔓₀ := by
        intro h_in
        apply s.2
        change res_δ s.1 = 0
        rw [← hs₀]
        exact h_in
      obtain ⟨u_s₀, hu_s₀⟩ := IsLocalization.map_units R_sm (⟨s₀, hs₀_not⟩ : 𝔓₀.primeCompl)
      obtain ⟨u_s, hu_s⟩ := IsLocalization.map_units L_δ s
      refine ⟨ι_BsmRsm x₀ * ↑u_s₀⁻¹, ?_⟩
      apply (Units.mul_left_inj u_s).mp
      have hψ_x : ψ_loc (ι_BsmRsm x₀) = algebraMap D_δ L_δ (Ψ_sm x₀) :=
        Localization.localRingHom_to_map 𝔓₀ 𝔪_δ Ψ_sm rfl x₀
      have hψ_s : ψ_loc (↑u_s₀) = ↑u_s := by
        have hu0_val : (↑u_s₀ : R_sm) = ι_BsmRsm s₀ := hu_s₀
        rw [hu0_val, hu_s, ← hs₀]
        exact Localization.localRingHom_to_map 𝔓₀ 𝔪_δ Ψ_sm rfl s₀
      have h_inv : ψ_loc (↑u_s₀⁻¹) * ↑u_s = 1 := by
        rw [← hψ_s, ← map_mul, Units.inv_mul, map_one]
      rw [map_mul, mul_assoc, h_inv, mul_one, hψ_x, hu_s, hx_eq]
    have h_unit_mδ : ∀ s : 𝔪_δ.primeCompl, IsUnit (res_δ s.1) :=
      fun s => Ne.isUnit s.2
    let res_loc : L_δ →+* Ω := IsLocalization.lift (M := 𝔪_δ.primeCompl) h_unit_mδ
    have hres_loc_comp : res_loc.comp (algebraMap D_δ L_δ) = res_δ :=
      IsLocalization.lift_comp h_unit_mδ
    have hres_loc_id : res_loc.comp (algebraMap Ω L_δ) = RingHom.id Ω := by
      ext c
      change res_loc (algebraMap Ω L_δ c) = c
      rw [IsScalarTower.algebraMap_apply Ω D_δ L_δ c]
      exact (RingHom.congr_fun hres_loc_comp _).trans (RingHom.congr_fun hres_δ_id c)
    have hres_loc_surj : Function.Surjective res_loc :=
      fun c => ⟨algebraMap Ω L_δ c, RingHom.congr_fun hres_loc_id c⟩
    have hker_res_loc : RingHom.ker res_loc = IsLocalRing.maximalIdeal L_δ :=
      IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective res_loc hres_loc_surj)
    have hJ_loc_bot : RingHom.ker ψ_loc = ⊥ := by
      by_contra h_ne_bot
      have h_ne_top : RingHom.ker ψ_loc ≠ ⊤ := RingHom.ker_ne_top ψ_loc
      obtain ⟨k, _hk_pos, hk_span⟩ := hKrull R_sm π₀ hπ₀_span_max (RingHom.ker ψ_loc) h_ne_bot h_ne_top
      have hπk_ker : π₀ ^ k ∈ RingHom.ker ψ_loc := by
        rw [hk_span]
        exact Ideal.subset_span rfl
      have hψπ_pow : (ψ_loc π₀) ^ k = 0 := by
        rw [← map_pow]
        exact hπk_ker
      have hψπ_zero : ψ_loc π₀ = 0 := IsNilpotent.eq_zero ⟨k, hψπ_pow⟩
      have hmax_le_ker : IsLocalRing.maximalIdeal R_sm ≤ RingHom.ker ψ_loc := by
