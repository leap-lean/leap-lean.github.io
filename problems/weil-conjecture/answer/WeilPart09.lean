      have h_jac_tot : IsUnit P_tot.jacobian := by
        rw [loc2.comp_jacobian_eq_jacobian_smul_jacobian P_12,
          loc1.comp_jacobian_eq_jacobian_smul_jacobian P_DQ,
          Algebra.smul_def, Algebra.smul_def, map_mul,
          ← IsScalarTower.algebraMap_apply D_Q D_QZ D'_4 P_DQ.jacobian]
        exact IsUnit.mul
          (IsUnit.mul h_jac_PDQ_unit
            ((Algebra.SubmersivePresentation.localizationAway D_QZ z_Q).jacobian_isUnit.map
