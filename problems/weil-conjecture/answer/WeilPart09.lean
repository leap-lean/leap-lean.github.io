    have h_unit_qN : ∀ s : q_N.primeCompl, IsUnit (ev_N s.1) := fun s => Ne.isUnit s.2
    let res_LN : L_N →+* Ω := IsLocalization.lift (M := q_N.primeCompl) h_unit_qN
