      refine ⟨(algebraMap Ω (M ⧸ p_M.asIdeal)).injective, fun z => ?_⟩
      obtain ⟨c, hc⟩ := hBij_Sq.2 (φbar_M z)
      refine ⟨c, hInj_φbar ?_⟩
