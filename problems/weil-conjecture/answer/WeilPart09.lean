      rw [hn_eq] at hn_spec
      have h_span_pow : ∀ m : ℕ, 𝔪 ^ m = Ideal.span {π ^ m} := by
        intro m
        change (IsLocalRing.maximalIdeal R) ^ m = Ideal.span {π ^ m}
        rw [← hπ, Ideal.span_singleton_pow]
      obtain ⟨x, hxJ_coe, hx_not_coe⟩ := Set.not_subset.mp hn_spec
      have hxJ : x ∈ J := hxJ_coe
      have hx_not : x ∉ 𝔪 ^ (k + 1) := hx_not_coe
      have hx_k : x ∈ Ideal.span {π ^ k} := by
