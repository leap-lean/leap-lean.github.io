        Nonempty (((MvPolynomial (Fin 2) Ω ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))) ⧸ p_node ^ 2) ≃ₐ[Ω] (L ⧸ 𝔪 ^ 2)) →
        (∃ Θ₃ : ((MvPolynomial (Fin 2) Ω ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))) ⧸ p_node ^ 3) ≃ₐ[Ω] (L ⧸ 𝔪 ^ 3),
