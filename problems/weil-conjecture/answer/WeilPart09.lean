      rw [hComap0] at hmem
      exact Ideal.Quotient.eq.mpr hmem
    let ι_B : (B₀ ⧸ 𝔮) →ₐ[k₀] K_p := ι_01.comp φ₀
    have hInj_IB : Function.Injective ι_B := hInj_01.comp hInj_φ0
    have hI01_res0 : ∀ b : B₀, ι_01 (Ideal.Quotient.mk 𝔯 (res₀ b)) = ι_B (Ideal.Quotient.mk 𝔮 b) :=
      fun _ => rfl
    have hI01_res1 : ∀ c : C_aff,
