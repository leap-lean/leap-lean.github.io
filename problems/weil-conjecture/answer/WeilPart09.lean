            have := DFunLike.congr_fun h_repr0 0
            simpa using this
          have hβ0 : β₁ = 0 := by
            have := DFunLike.congr_fun h_repr0 1
            simpa using this
          exact hαβ_ne.elim (fun h => h hα0) (fun h => h hβ0)
        let w₂ : L₂ := ι_L u₁
        have hw₂_mem : w₂ ∈ 𝔪₂ := hι_L_max (Ideal.mem_map_of_mem _ hu₁_mem)
        have hw₂_sq_mem : w₂ ^ 2 ∈ 𝔪₂ ^ 3 := by
          have h_pow2 : (Ideal.map ι_L 𝔪₁) ^ 2 ≤ 𝔪₂ ^ 2 := by
            rw [sq, sq]
            exact Ideal.mul_mono hι_L_max hι_L_max
          have h_pow3 : Ideal.map ι_L (𝔪₁ ^ 3) ≤ 𝔪₂ ^ 3 := by
            rw [Ideal.map_pow, pow_succ _ 2, pow_succ 𝔪₂ 2]
            exact Ideal.mul_mono h_pow2 hι_L_max
          exact h_pow3 (by rw [← map_pow]; exact Ideal.mem_map_of_mem _ hu₁_sq_mem)
        obtain ⟨Φ₂, hΦ₂⟩ := hΨ_all 2
        have hw₂_not_sq : w₂ ∉ 𝔪₂ ^ 2 := by
          intro hw_in
          have h_mk_w0 : Ideal.Quotient.mk (𝔪₂ ^ 2) w₂ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hw_in
          rw [← hΦ₂ u₁] at h_mk_w0
          have h_tmul0 : (1 : Ω₂) ⊗ₜ[Ω₁] Ideal.Quotient.mk (𝔪₁ ^ 2) u₁ = 0 :=
