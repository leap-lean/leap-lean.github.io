          (AlgebraicGeometry.opensDiagram D i₀ (W₀ b)).obj u :=
      fun a b u =>
        AlgebraicGeometry.Scheme.Hom.resLE (𝟙 (D.obj u.left))
          ((D.map u.hom) ⁻¹ᵁ (W₀ b)) ((D.map u.hom) ⁻¹ᵁ (W₀ a ⊓ W₀ b))
          (by intro x hx; exact hx.2)
    have hinc_L_ι : ∀ (a b : ↥s) (u : CategoryTheory.Over i₀),
        inc_diag_L a b u ≫ ι_D (W₀ a) u = ι_D (W₀ a ⊓ W₀ b) u := by
      intro a b u
      exact (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι _ _).trans (CategoryTheory.Category.comp_id _)
    have hinc_R_ι : ∀ (a b : ↥s) (u : CategoryTheory.Over i₀),
        inc_diag_R a b u ≫ ι_D (W₀ b) u = ι_D (W₀ a ⊓ W₀ b) u := by
      intro a b u
      exact (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι _ _).trans (CategoryTheory.Category.comp_id _)
    have hOverlap : ∀ p : ↥s × ↥s,
        ∃ (v_p : CategoryTheory.Over i₀) (μ_p : v_p ⟶ u₁),
          (AlgebraicGeometry.opensDiagram D i₀ (W₀ p.1 ⊓ W₀ p.2)).map μ_p ≫
            inc_diag_L p.1 p.2 u₁ ≫ ψ₁ p.1 =
          (AlgebraicGeometry.opensDiagram D i₀ (W₀ p.1 ⊓ W₀ p.2)).map μ_p ≫
            inc_diag_R p.1 p.2 u₁ ≫ ψ₁ p.2 := by
      intro ⟨a, b⟩
      let W_ab := W₀ a ⊓ W₀ b
      let D_ab := AlgebraicGeometry.opensDiagram D i₀ W_ab
      let c_ab := AlgebraicGeometry.opensCone D c i₀ W_ab
      let hc_ab := AlgebraicGeometry.isLimitOpensCone D c hc i₀ W_ab
      have _ : ∀ v : CategoryTheory.Over i₀, CompactSpace ↥(D_ab.obj v) := by
        intro v
        have hA : IsCompact (((D.map v.hom) ⁻¹ᵁ (W₀ a) : (D.obj v.left).Opens) : Set ↥(D.obj v.left)) :=
          ((hW₀ a).1.preimage (D.map v.hom)).isCompact
        have hB : IsCompact (((D.map v.hom) ⁻¹ᵁ (W₀ b) : (D.obj v.left).Opens) : Set ↥(D.obj v.left)) :=
          ((hW₀ b).1.preimage (D.map v.hom)).isCompact
        exact isCompact_iff_compactSpace.mp
          (QuasiSeparatedSpace.inter_isCompact _ _
            ((D.map v.hom) ⁻¹ᵁ (W₀ a)).isOpen hA
            ((D.map v.hom) ⁻¹ᵁ (W₀ b)).isOpen hB)
      have _ : ∀ {v w : CategoryTheory.Over i₀} (g : v ⟶ w), AlgebraicGeometry.IsAffineHom (D_ab.map g) := by
        intro v w g
        have _ : AlgebraicGeometry.IsOpenImmersion (ι_D W_ab v) :=
          show AlgebraicGeometry.IsOpenImmersion ((D.map v.hom) ⁻¹ᵁ W_ab).ι from inferInstance
        have _ : AlgebraicGeometry.IsOpenImmersion (ι_D W_ab w) :=
          show AlgebraicGeometry.IsOpenImmersion ((D.map w.hom) ⁻¹ᵁ W_ab).ι from inferInstance
        have hw_hom : D.map v.hom = D.map g.left ≫ D.map w.hom := by
