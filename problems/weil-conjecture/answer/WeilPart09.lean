      hdu, hdv, ha₂₀, ha₀₂, ha₁₁, h_quad, hadj, hytab⟩ := hPrepNod huv
    have hdu' : d_u ∈ RingHom.ker res_Ω := (SetLike.ext_iff.mp hres_ker d_u).mpr hdu
    have hdv' : d_v ∈ RingHom.ker res_Ω := (SetLike.ext_iff.mp hres_ker d_v).mpr hdv
    have ha₂₀' : a₂₀ ∈ RingHom.ker res_Ω := (SetLike.ext_iff.mp hres_ker a₂₀).mpr ha₂₀
    have ha₀₂' : a₀₂ ∈ RingHom.ker res_Ω := (SetLike.ext_iff.mp hres_ker a₀₂).mpr ha₀₂
    have ha₁₁' : a₁₁ - 1 ∈ RingHom.ker res_Ω := (SetLike.ext_iff.mp hres_ker (a₁₁ - 1)).mpr ha₁₁
    have hytab' : ∀ j : Fin r, y j ∈ RingHom.ker res_Ω ∧ t j ∉ RingHom.ker res_Ω ∧
        t j * y j - a j * d_u - b j * d_v = 0 := by
      intro j
      refine ⟨(SetLike.ext_iff.mp hres_ker (y j)).mpr (hytab j).1, ?_, (hytab j).2.2⟩
      intro ht_in
      exact (hytab j).2.1 ((SetLike.ext_iff.mp hres_ker (t j)).mp ht_in)
    obtain ⟨B₄, D'_4, instCommB₄, instAlgB₄, instCommD4, instAlgD4,
      Ψ₄, ev₄, hEtB₄, hEtD4, hΨ₄_surj, hΨ₄_U0U1, hΨ₄_C, hev₄_comp, hev₄_Xi⟩ :=
      h_s4 Ω D res_Ω hres_id d_u d_v a₂₀ a₁₁ a₀₂ r y t a b
        hdu' hdv' ha₂₀' ha₀₂' ha₁₁' h_quad hadj hytab'
    letI : CommRing B₄ := instCommB₄
    letI : Algebra (MvPolynomial (Fin 2) Ω) B₄ := instAlgB₄
    letI : CommRing D'_4 := instCommD4
    letI : Algebra D D'_4 := instAlgD4
    obtain ⟨B, instB, q_B, φ_D, φ_node, hEtD, hEtNode, hComap, hMem, hComp⟩ :=
      h_s5 Ω D res_Ω hres_id (hFinEq.trans hFin3) (h_s1_jet Ω) h_s2.1 h_s2.2
        B₄ D'_4 Ψ₄ ev₄ hEtB₄ hEtD4 hΨ₄_surj hΨ₄_U0U1 hΨ₄_C hev₄_comp hev₄_Xi
    exact ⟨B, instB, q_B, φ_D, φ_node, hEtD, hEtNode,
      PrimeSpectrum.ext (hComap.trans hres_ker), hMem, hComp⟩

theorem weil_algClosed_hasSpreadSmoothOrNodal_from_local_and_baseChange : (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      (∀ (D : Type u) [CommRing D] [Algebra Ω D] [Algebra.FiniteType Ω D] [IsReduced D]
        (q : PrimeSpectrum D),
        q.asIdeal.IsMaximal →
        ((let L := Localization.AtPrime q.asIdeal
          let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
          Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2) →
          ∃ f : D, f ∉ q.asIdeal ∧
            RingHom.IsStandardSmoothOfRelativeDimension 1
              (algebraMap Ω (Localization.Away f))) ∧
        ((let L := Localization.AtPrime q.asIdeal
          let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
          Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
          Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
          ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3) →
          ∃ (B : Type u) (_ : CommRing B) (q_B : PrimeSpectrum B)
            (φ_D : D →+* B)
            (φ_node : (MvPolynomial (Fin 2) Ω ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B),
            φ_D.Etale ∧
            φ_node.Etale ∧
            PrimeSpectrum.comap φ_D q_B = q ∧
            (∀ i : Fin 2, φ_node (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q_B.asIdeal) ∧
            φ_D.comp (algebraMap Ω D) =
              φ_node.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))) →
      ∀ (Y : AlgebraicGeometry.Scheme.{u})
        (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.LocallyOfFiniteType p_Y],
        AlgebraicGeometry.IsReduced Y →
        (∀ (D : Type u) [CommRing D] [Algebra Ω D]
          (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y),
          AlgebraicGeometry.IsOpenImmersion j_D →
          j_D ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
          ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
            let L := Localization.AtPrime q.asIdeal
            let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
            Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
              (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
               Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
               ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3)) →
        ∀ y : Y, HasSpreadSmoothOrNodalAt p_Y y) ∧
    (∀ (_ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (Y : AlgebraicGeometry.Scheme.{u})
        (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.LocallyOfFiniteType p_Y],
        (∀ y : Y, HasSpreadSmoothOrNodalAt p_Y y) ↔
          (AlgebraicGeometry.IsReduced Y ∧
           ∀ (D : Type u) [CommRing D] [Algebra Ω D]
             (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y),
             AlgebraicGeometry.IsOpenImmersion j_D →
             j_D ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
             ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
               let L := Localization.AtPrime q.asIdeal
               let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
               Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
                 (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
                  Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
                  ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3)))
      (Ω₁ Ω₂ : Type u) [Field Ω₁] [IsAlgClosed Ω₁] [Field Ω₂] [IsAlgClosed Ω₂]
      (φ : Ω₁ →+* Ω₂)
      (Y₁ : AlgebraicGeometry.Scheme.{u})
      (p₁ : Y₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω₁))
      [AlgebraicGeometry.LocallyOfFiniteType p₁],
      (∀ y₁ : Y₁, HasSpreadSmoothOrNodalAt p₁ y₁) ↔
        (∀ y₂ : ↥(CategoryTheory.Limits.pullback p₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))),
          HasSpreadSmoothOrNodalAt
            (CategoryTheory.Limits.pullback.snd p₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))) y₂)) :=
by
  
  have h_exists_ev :
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (A : Type u) [CommRing A] [Algebra Ω A] [Algebra.FiniteType Ω A]
        (𝔪 : Ideal A) [𝔪.IsMaximal],
        ∃ ev : A →ₐ[Ω] Ω, RingHom.ker ev.toRingHom = 𝔪 := by
    intro Ω _ _ A _ _ _ 𝔪 h𝔪
    obtain ⟨n, f, hf_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹Algebra.FiniteType Ω A›
    let M : Ideal (MvPolynomial (Fin n) Ω) := Ideal.comap f.toRingHom 𝔪
    have hM_max : M.IsMaximal := Ideal.comap_isMaximal_of_surjective f.toRingHom hf_surj
    obtain ⟨x, hx⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hM_max
    have hker_eval : RingHom.ker (MvPolynomial.aeval x).toRingHom = M := by
      ext P
      rw [hx, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      rfl
    have hker_f_le : RingHom.ker f.toRingHom ≤ M := by
      intro P hP
      have hP0 : f P = 0 := hP
      change f P ∈ 𝔪
      rw [hP0]
      exact 𝔪.zero_mem
    let q_f : (MvPolynomial (Fin n) Ω ⧸ RingHom.ker f.toRingHom) ≃ₐ[Ω] A :=
      Ideal.quotientKerAlgEquivOfSurjective hf_surj
    let g_quot : (MvPolynomial (Fin n) Ω ⧸ RingHom.ker f.toRingHom) →ₐ[Ω] Ω :=
      Ideal.Quotient.liftₐ (RingHom.ker f.toRingHom) (MvPolynomial.aeval x)
        (fun P hP => show P ∈ RingHom.ker (MvPolynomial.aeval x).toRingHom by
          rw [hker_eval]; exact hker_f_le hP)
    let ev : A →ₐ[Ω] Ω := g_quot.comp q_f.symm.toAlgHom
    refine ⟨ev, ?_⟩
    ext a
    obtain ⟨P, rfl⟩ := hf_surj a
    have hq : q_f.symm (f P) = Ideal.Quotient.mk (RingHom.ker f.toRingHom) P := by
      apply q_f.injective
      exact q_f.apply_symm_apply (f P)
    change g_quot (q_f.symm (f P)) = 0 ↔ f P ∈ 𝔪
    rw [hq]
    change (MvPolynomial.aeval x) P = 0 ↔ P ∈ M
    rw [← hker_eval]
    rfl

  
  have h_ker_isMaximal :
      ∀ {Ω : Type u} [Field Ω] {R : Type u} [CommRing R] [Algebra Ω R]
        (ev : R →ₐ[Ω] Ω), (RingHom.ker ev.toRingHom).IsMaximal := by
    intro Ω _ R _ _ ev
    refine RingHom.ker_isMaximal_of_surjective ev.toRingHom ?_
    intro c
    exact ⟨algebraMap Ω R c, ev.commutes c⟩

  
  have h_quotPowEquiv :
      ∀ (Ω : Type u) [Field Ω]
        (A : Type u) [CommRing A] [Algebra Ω A]
        (I : Ideal A) [I.IsMaximal] (k : ℕ),
        ∃ e : (A ⧸ I ^ k) ≃ₐ[Ω]
            (Localization.AtPrime I ⧸ (IsLocalRing.maximalIdeal (Localization.AtPrime I)) ^ k),
          ∀ a : A, e (Ideal.Quotient.mk (I ^ k) a) =
            Ideal.Quotient.mk ((IsLocalRing.maximalIdeal (Localization.AtPrime I)) ^ k)
              (algebraMap A (Localization.AtPrime I) a) := by
    intro Ω _ A _ _ I hI k
    let L := Localization.AtPrime I
    let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
    have h𝔪_eq : Ideal.map (algebraMap A L) I = 𝔪 := Localization.AtPrime.map_eq_maximalIdeal
    have h_map_pow : Ideal.map (algebraMap A L) (I ^ k) = 𝔪 ^ k := by
      rw [← h𝔪_eq, Ideal.map_pow]
    have h_le : I ^ k ≤ Ideal.comap (algebraMap A L) (𝔪 ^ k) := by
      rw [← Ideal.map_le_iff_le_comap, h_map_pow]
    let fwd : (A ⧸ I ^ k) →ₐ[Ω] (L ⧸ 𝔪 ^ k) :=
      Ideal.Quotient.liftₐ (I ^ k)
        ((Ideal.Quotient.mkₐ Ω (𝔪 ^ k)).comp (IsScalarTower.toAlgHom Ω A L))
        (fun a ha => Ideal.Quotient.eq_zero_iff_mem.mpr (h_le ha))
    have h_unit : ∀ s : I.primeCompl, IsUnit (Ideal.Quotient.mk (I ^ k) (s : A)) := by
      intro ⟨s, hs⟩
      have h_sup : I ⊔ Ideal.span {s} = ⊤ := by
        by_contra h_ne_top
        have h_eq := Ideal.IsMaximal.eq_of_le hI h_ne_top le_sup_left
        exact hs (h_eq ▸ Ideal.mem_sup_right (Ideal.mem_span_singleton_self s))
      obtain ⟨m, hm, z, hz, hmz⟩ := Submodule.mem_sup.mp (h_sup.symm ▸ Submodule.mem_top : (1 : A) ∈ _)
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      have hm_eq : 1 - r * s = m := by linear_combination -hmz
      have hpow_mem : (1 - r * s) ^ k ∈ I ^ k := by
        rw [hm_eq]
        exact Ideal.pow_mem_pow hm k
      have h_geom : (r * s) * (∑ i ∈ Finset.range k, (1 - r * s) ^ i) = 1 - (1 - r * s) ^ k := by
        have h1 := mul_geom_sum (1 - r * s) k
        linear_combination -h1
      let q_mk := Ideal.Quotient.mk (I ^ k)
      have h_one : q_mk s * (q_mk r * q_mk (∑ i ∈ Finset.range k, (1 - r * s) ^ i)) = 1 := by
        calc
          q_mk s * (q_mk r * q_mk (∑ i ∈ Finset.range k, (1 - r * s) ^ i))
            = q_mk ((r * s) * ∑ i ∈ Finset.range k, (1 - r * s) ^ i) := by
                simp only [map_mul]; ring
          _ = q_mk (1 - (1 - r * s) ^ k) := by rw [h_geom]
          _ = 1 - q_mk ((1 - r * s) ^ k) := by rw [map_sub, map_one]
          _ = 1 := by rw [Ideal.Quotient.eq_zero_iff_mem.mpr hpow_mem, sub_zero]
      exact IsUnit.of_mul_eq_one _ h_one
    let lift0_ring : L →+* (A ⧸ I ^ k) := IsLocalization.lift h_unit
    have hlift0_eq : ∀ a : A, lift0_ring (algebraMap A L a) = Ideal.Quotient.mk (I ^ k) a :=
      fun a => IsLocalization.lift_eq h_unit a
    let lift0 : L →ₐ[Ω] (A ⧸ I ^ k) :=
      { lift0_ring with
        commutes' := fun c => by
          change lift0_ring (algebraMap Ω L c) = algebraMap Ω (A ⧸ I ^ k) c
          rw [IsScalarTower.algebraMap_apply Ω A L c, hlift0_eq]
          rfl }
    have hker_lift0 : 𝔪 ^ k ≤ RingHom.ker lift0.toRingHom := by
      rw [← h_map_pow, Ideal.map_le_iff_le_comap]
      intro a ha
      change lift0_ring (algebraMap A L a) = 0
      rw [hlift0_eq]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr ha
    let inv : (L ⧸ 𝔪 ^ k) →ₐ[Ω] (A ⧸ I ^ k) :=
      Ideal.Quotient.liftₐ (𝔪 ^ k) lift0 (fun x hx => hker_lift0 hx)
    have h_left : inv.toRingHom.comp fwd.toRingHom = RingHom.id (A ⧸ I ^ k) := by
      apply Ideal.Quotient.ringHom_ext
      ext a
      exact hlift0_eq a
    have h_right : fwd.toRingHom.comp inv.toRingHom = RingHom.id (L ⧸ 𝔪 ^ k) := by
      apply Ideal.Quotient.ringHom_ext
      apply IsLocalization.ringHom_ext I.primeCompl
      ext a
      change fwd (lift0_ring (algebraMap A L a)) = Ideal.Quotient.mk (𝔪 ^ k) (algebraMap A L a)
      rw [hlift0_eq]
      rfl
    exact ⟨AlgEquiv.ofAlgHom fwd inv
      (AlgHom.ext fun x => RingHom.congr_fun h_right x)
      (AlgHom.ext fun x => RingHom.congr_fun h_left x), fun _ => rfl⟩

  
  have h_etaleQuotSqEquiv :
      ∀ (Ω : Type u) [Field Ω]
        {R S : Type u} [CommRing R] [CommRing S] [Algebra Ω R] [Algebra Ω S]
        (ψ : R →ₐ[Ω] S), ψ.toRingHom.Etale →
        ∀ (ev_S : S →ₐ[Ω] Ω),
          Nonempty ((R ⧸ (RingHom.ker (ev_S.comp ψ).toRingHom) ^ 2) ≃ₐ[Ω]
            (S ⧸ (RingHom.ker ev_S.toRingHom) ^ 2)) := by
    intro Ω _ R S _ _ _ _ ψ hEt ev_S
    let ev_R : R →ₐ[Ω] Ω := ev_S.comp ψ
    let 𝔪_R : Ideal R := RingHom.ker ev_R.toRingHom
    let 𝔪_S : Ideal S := RingHom.ker ev_S.toRingHom
    have h_map_sq : 𝔪_R ^ 2 ≤ Ideal.comap ψ.toRingHom (𝔪_S ^ 2) := by
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow, sq, sq]
      exact Ideal.mul_mono (Ideal.map_le_iff_le_comap.mpr le_rfl) (Ideal.map_le_iff_le_comap.mpr le_rfl)
    let fwd : (R ⧸ 𝔪_R ^ 2) →ₐ[Ω] (S ⧸ 𝔪_S ^ 2) :=
      Ideal.Quotient.liftₐ (𝔪_R ^ 2) ((Ideal.Quotient.mkₐ Ω (𝔪_S ^ 2)).comp ψ)
        (fun r hr => Ideal.Quotient.eq_zero_iff_mem.mpr (h_map_sq hr))
    letI : Algebra R S := ψ.toRingHom.toAlgebra
    haveI hEtAlg : Algebra.Etale R S := RingHom.etale_algebraMap.mp hEt
    let Q_R := R ⧸ 𝔪_R ^ 2
    let I_R : Ideal Q_R := Ideal.map (Ideal.Quotient.mk (𝔪_R ^ 2)) 𝔪_R
    have hI_R_sq : I_R ^ 2 = ⊥ := by
      rw [← Ideal.map_pow, Ideal.map_quotient_self]
    have hI_R_nil : IsNilpotent I_R := ⟨2, hI_R_sq⟩
    letI : Algebra R Ω := ev_R.toRingHom.toAlgebra
    let bar_ev_R_ring : Q_R →+* Ω :=
      Ideal.Quotient.lift (𝔪_R ^ 2) ev_R.toRingHom
        (fun r hr => Ideal.pow_le_self (by norm_num) hr)
    let bar_ev_R : Q_R →ₐ[R] Ω :=
      { bar_ev_R_ring with commutes' := fun _ => rfl }
    have hker_bar_R : RingHom.ker bar_ev_R.toRingHom = I_R := by
      ext x
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
      constructor
      · intro hr
        exact Ideal.mem_map_of_mem _ hr
      · intro hx
        rcases Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective |>.mp hx with ⟨m, hm, hmr⟩
        have hdiff : m - r ∈ 𝔪_R ^ 2 := Ideal.Quotient.eq.mp hmr
        have hdiff1 : m - r ∈ 𝔪_R := Ideal.pow_le_self (by norm_num) hdiff
        have hr_mem : r ∈ 𝔪_R := by
          have := 𝔪_R.sub_mem hm hdiff1
          simpa using this
        exact hr_mem
    have hsurj_bar_R : Function.Surjective bar_ev_R := by
      intro c
      exact ⟨Ideal.Quotient.mk (𝔪_R ^ 2) (algebraMap Ω R c), ev_R.commutes c⟩
    let eq_QR_Ω : (Q_R ⧸ I_R) ≃ₐ[R] Ω :=
      (Ideal.quotientEquivAlgOfEq R hker_bar_R.symm).trans
        (Ideal.quotientKerAlgEquivOfSurjective hsurj_bar_R)
    let ev_S_R : S →ₐ[R] Ω :=
      { ev_S.toRingHom with commutes' := fun _ => rfl }
    let g₀ : S →ₐ[R] (Q_R ⧸ I_R) := eq_QR_Ω.symm.toAlgHom.comp ev_S_R
    let g_tilde : S →ₐ[R] Q_R := Algebra.FormallySmooth.lift I_R hI_R_nil g₀
    have hg_comp : (Ideal.Quotient.mkₐ R I_R).comp g_tilde = g₀ :=
      Algebra.FormallySmooth.comp_lift I_R hI_R_nil g₀
    have h_bar_gtilde : ∀ s : S, bar_ev_R (g_tilde s) = ev_S s := by
      intro s
      have h1 : eq_QR_Ω (Ideal.Quotient.mk I_R (g_tilde s)) = eq_QR_Ω (g₀ s) :=
        congrArg eq_QR_Ω (AlgHom.congr_fun hg_comp s)
      have h2 : eq_QR_Ω (g₀ s) = ev_S s := eq_QR_Ω.apply_symm_apply (ev_S s)
      exact h1.trans h2
    have h_gtilde_mem : ∀ s ∈ 𝔪_S, g_tilde s ∈ I_R := by
      intro s hs
      rw [← hker_bar_R]
      exact (h_bar_gtilde s).trans hs
    have h_gtilde_sq : 𝔪_S ^ 2 ≤ RingHom.ker g_tilde.toRingHom := by
      have h1 : Ideal.map g_tilde.toRingHom (𝔪_S ^ 2) ≤ ⊥ := by
        have h_sub : Ideal.map g_tilde.toRingHom 𝔪_S ≤ I_R :=
          Ideal.map_le_iff_le_comap.mpr h_gtilde_mem
        calc
          Ideal.map g_tilde.toRingHom (𝔪_S ^ 2)
            = (Ideal.map g_tilde.toRingHom 𝔪_S) ^ 2 := Ideal.map_pow _ _ 2
          _ ≤ I_R ^ 2 := by
            rw [sq (Ideal.map _ 𝔪_S), sq I_R]
            exact Ideal.mul_mono h_sub h_sub
          _ = ⊥ := hI_R_sq
      exact Ideal.map_le_iff_le_comap.mp h1
    let g_tilde_Ω : S →ₐ[Ω] Q_R :=
      { g_tilde.toRingHom with
        commutes' := fun c => by
          change g_tilde (algebraMap Ω S c) = algebraMap Ω Q_R c
          have hc : algebraMap Ω S c = algebraMap R S (algebraMap Ω R c) := (ψ.commutes c).symm
          rw [hc, g_tilde.commutes]
          rfl }
    let inv : (S ⧸ 𝔪_S ^ 2) →ₐ[Ω] Q_R :=
      Ideal.Quotient.liftₐ (𝔪_S ^ 2) g_tilde_Ω (fun s hs => h_gtilde_sq hs)
    have h_left : inv.toRingHom.comp fwd.toRingHom = RingHom.id Q_R := by
      apply Ideal.Quotient.ringHom_ext
      ext r
      exact g_tilde.commutes r
    let Q_S := S ⧸ 𝔪_S ^ 2
    let bar_ev_S : Q_S →+* Ω :=
      Ideal.Quotient.lift (𝔪_S ^ 2) ev_S.toRingHom
        (fun s hs => Ideal.pow_le_self (by norm_num) hs)
    have hker_bar_S_nil : IsNilpotent (RingHom.ker bar_ev_S) := by
      refine ⟨2, ?_⟩
      change (RingHom.ker bar_ev_S) ^ 2 = ⊥
      rw [eq_bot_iff]
      have hle : RingHom.ker bar_ev_S ≤ Ideal.map (Ideal.Quotient.mk (𝔪_S ^ 2)) 𝔪_S := by
        intro x hx
        obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact Ideal.mem_map_of_mem _ hx
      calc
        (RingHom.ker bar_ev_S) ^ 2
          ≤ (Ideal.map (Ideal.Quotient.mk (𝔪_S ^ 2)) 𝔪_S) ^ 2 := by
            rw [sq (RingHom.ker bar_ev_S), sq (Ideal.map _ 𝔪_S)]
            exact Ideal.mul_mono hle hle
        _ = Ideal.map (Ideal.Quotient.mk (𝔪_S ^ 2)) (𝔪_S ^ 2) := (Ideal.map_pow _ _ 2).symm
        _ = ⊥ := Ideal.map_quotient_self _
    letI : Algebra R Q_S := ((Ideal.Quotient.mk (𝔪_S ^ 2)).comp ψ.toRingHom).toAlgebra
    let fwd_R : Q_R →ₐ[R] Q_S := { fwd.toRingHom with commutes' := fun _ => rfl }
    let mk_S_R : S →ₐ[R] Q_S := { Ideal.Quotient.mk (𝔪_S ^ 2) with commutes' := fun _ => rfl }
    have h_bar_fwd : ∀ x : Q_R, bar_ev_S (fwd x) = bar_ev_R x := by
      intro x
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
      rfl
    have h_unram_eq : fwd_R.comp g_tilde = mk_S_R := by
      refine Algebra.FormallyUnramified.ext' bar_ev_S hker_bar_S_nil _ _ ?_
      intro s
      change bar_ev_S (fwd (g_tilde s)) = ev_S s
      rw [h_bar_fwd, h_bar_gtilde]
    have h_right : fwd.toRingHom.comp inv.toRingHom = RingHom.id Q_S := by
      apply Ideal.Quotient.ringHom_ext
      ext s
      exact AlgHom.congr_fun h_unram_eq s
    exact ⟨AlgEquiv.ofAlgHom fwd inv
      (AlgHom.ext fun x => RingHom.congr_fun h_right x)
      (AlgHom.ext fun x => RingHom.congr_fun h_left x)⟩

  
  have h_node_finrank_le_two :
      ∀ (Ω : Type u) [Field Ω]
        (ev_node : (MvPolynomial (Fin 2) Ω ⧸
          Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))) →ₐ[Ω] Ω)
        (i₀ : Fin 2),
        Ideal.Quotient.mk _ (MvPolynomial.X i₀) ∉ RingHom.ker ev_node.toRingHom →
        Module.finrank Ω ((MvPolynomial (Fin 2) Ω ⧸
          Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))) ⧸
          (RingHom.ker ev_node.toRingHom) ^ 2) ≤ 2 := by
    intro Ω _ ev_node i₀ hi₀
    let I_rel : Ideal (MvPolynomial (Fin 2) Ω) := Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
    let R_node := MvPolynomial (Fin 2) Ω ⧸ I_rel
    let I_node : Ideal R_node := RingHom.ker ev_node.toRingHom
    haveI hI_max : I_node.IsMaximal := h_ker_isMaximal ev_node
    let Q := R_node ⧸ I_node ^ 2
    let xbar : Fin 2 → R_node := fun i => Ideal.Quotient.mk I_rel (MvPolynomial.X i)
    have h_prod : xbar 0 * xbar 1 = 0 := by
      change Ideal.Quotient.mk I_rel (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
    obtain ⟨e_loc, he_loc⟩ := h_quotPowEquiv Ω R_node I_node 2
    have hu_loc : IsUnit (algebraMap R_node (Localization.AtPrime I_node) (xbar i₀)) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime I_node) I_node (xbar i₀)).mpr hi₀
    have hu_img : IsUnit (e_loc (Ideal.Quotient.mk (I_node ^ 2) (xbar i₀))) := by
      rw [he_loc]
      exact hu_loc.map (Ideal.Quotient.mk _)
    have hu_x : IsUnit (Ideal.Quotient.mk (I_node ^ 2) (xbar i₀)) := by
      simpa using hu_img.map e_loc.symm.toRingHom
    have h_other_zero : ∀ j : Fin 2, j ≠ i₀ → Ideal.Quotient.mk (I_node ^ 2) (xbar j) = 0 := by
      intro j hj
      have h_mul0 : xbar i₀ * xbar j = 0 := by
        fin_cases i₀ <;> fin_cases j
        · exact absurd rfl hj
        · exact h_prod
        · rw [mul_comm]; exact h_prod
        · exact absurd rfl hj
      exact hu_x.mul_right_eq_zero.mp (by rw [← map_mul, h_mul0, map_zero])
    let c : Ω := ev_node (xbar i₀)
    have h_sub_mem : xbar i₀ - algebraMap Ω R_node c ∈ I_node := by
      change ev_node (xbar i₀ - algebraMap Ω R_node c) = 0
      rw [map_sub, ev_node.commutes]
      exact sub_self c
    let t : Q := Ideal.Quotient.mk (I_node ^ 2) (xbar i₀ - algebraMap Ω R_node c)
    have ht_sq : t ^ 2 = 0 := by
      change Ideal.Quotient.mk (I_node ^ 2) ((xbar i₀ - algebraMap Ω R_node c) ^ 2) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_mem_pow h_sub_mem 2)
    have hx_eq : Ideal.Quotient.mk (I_node ^ 2) (xbar i₀) = c • (1 : Q) + t := by
      change Ideal.Quotient.mk (I_node ^ 2) (xbar i₀) =
        c • (1 : Q) + Ideal.Quotient.mk (I_node ^ 2) (xbar i₀ - algebraMap Ω R_node c)
      rw [map_sub, Algebra.smul_def, mul_one]
      change _ = algebraMap Ω Q c + (_ - Ideal.Quotient.mk (I_node ^ 2) (algebraMap Ω R_node c))
      have hc_eq : Ideal.Quotient.mk (I_node ^ 2) (algebraMap Ω R_node c) = algebraMap Ω Q c := rfl
      rw [hc_eq]
      abel
    let F : (Fin 2 → Ω) →ₗ[Ω] Q :=
      { toFun := fun v => v 0 • (1 : Q) + v 1 • t
        map_add' := fun u v => by simp [add_smul]; abel
        map_smul' := fun a v => by simp [smul_add, mul_smul] }
    have hF_surj : Function.Surjective F := by
      let q_all : MvPolynomial (Fin 2) Ω →+* Q :=
        (Ideal.Quotient.mk (I_node ^ 2)).comp (Ideal.Quotient.mk I_rel)
      intro q
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective r
      change q_all P ∈ LinearMap.range F
      exact @MvPolynomial.induction_on Ω (Fin 2) _
        (fun P => q_all P ∈ LinearMap.range F)
        P
        (fun a => ⟨![a, 0], by
          change a • (1 : Q) + (0 : Ω) • t = q_all (MvPolynomial.C a)
          rw [zero_smul, add_zero, Algebra.smul_def, mul_one]
          rfl⟩)
        (fun p₁ p₂ hp₁ hp₂ => by
          rw [map_add]
          exact (LinearMap.range F).add_mem hp₁ hp₂)
        (fun p₁ j ⟨v, hv⟩ => by
          rw [map_mul, ← hv]
          have hxj : q_all (MvPolynomial.X j) = Ideal.Quotient.mk (I_node ^ 2) (xbar j) := rfl
          rw [hxj]
          by_cases hj : j = i₀
          · subst hj
            rw [hx_eq]
            refine ⟨![v 0 * c, v 0 + v 1 * c], ?_⟩
            change (v 0 * c) • (1 : Q) + (v 0 + v 1 * c) • t =
              (v 0 • (1 : Q) + v 1 • t) * (c • (1 : Q) + t)
            have h_alg : (v 0 • (1 : Q) + v 1 • t) * (c • (1 : Q) + t) =
                (v 0 * c) • (1 : Q) + (v 0 + v 1 * c) • t + v 1 • (t ^ 2) := by
              simp only [Algebra.smul_def, map_mul, map_add]
              ring
            rw [h_alg, ht_sq, smul_zero, add_zero]
          · rw [h_other_zero j hj, mul_zero]
            exact ⟨0, map_zero F⟩)
    have hF_range : LinearMap.range F = ⊤ := LinearMap.range_eq_top.mpr hF_surj
    have h_rk := LinearMap.finrank_range_add_finrank_ker F
    rw [hF_range, finrank_top, Module.finrank_fin_fun] at h_rk
    change Module.finrank Ω Q ≤ 2
    omega

  
  have h_s1 :
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (D : Type u) [CommRing D] [Algebra Ω D] [Algebra.FiniteType Ω D],
        (∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
          let L := Localization.AtPrime q.asIdeal
          let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
          Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
            (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
             Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
             ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3)) →
        (∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
          ((let L := Localization.AtPrime q.asIdeal
            let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
            Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2) →
            ∃ f : D, f ∉ q.asIdeal ∧
              RingHom.IsStandardSmoothOfRelativeDimension 1
                (algebraMap Ω (Localization.Away f))) ∧
          ((let L := Localization.AtPrime q.asIdeal
            let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
            Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
            Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
            ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3) →
            ∃ (B : Type u) (_ : CommRing B) (q_B : PrimeSpectrum B)
              (φ_D : D →+* B)
              (φ_node : (MvPolynomial (Fin 2) Ω ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B),
              φ_D.Etale ∧
              φ_node.Etale ∧
              PrimeSpectrum.comap φ_D q_B = q ∧
              (∀ i : Fin 2, φ_node (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q_B.asIdeal) ∧
              φ_D.comp (algebraMap Ω D) =
                φ_node.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))) →
        ∀ (p : PrimeSpectrum D),
          (∃ f : D, f ∉ p.asIdeal ∧
            RingHom.IsStandardSmoothOfRelativeDimension 1
              (algebraMap Ω (Localization.Away f))) ∨
          (∃ (B : Type u) (_ : CommRing B) (p_B : PrimeSpectrum B)
            (φ_D : D →+* B)
            (φ_node : (MvPolynomial (Fin 2) Ω ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B),
            φ_D.Etale ∧
            φ_node.Etale ∧
            PrimeSpectrum.comap φ_D p_B = p ∧
            (∀ i : Fin 2, φ_node (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ p_B.asIdeal) ∧
            φ_D.comp (algebraMap Ω D) =
              φ_node.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) := by
    intro Ω _ _ D _ _ _ hArtinD hLocalD p
    obtain ⟨𝔪₀, h𝔪₀_max, hp_le⟩ := Ideal.exists_le_maximal p.asIdeal p.isPrime.ne_top
    let q : PrimeSpectrum D := ⟨𝔪₀, h𝔪₀_max.isPrime⟩
    rcases hArtinD q h𝔪₀_max with h2 | h35
    · obtain ⟨f, hfq, hSm⟩ := (hLocalD q h𝔪₀_max).1 h2
      exact Or.inl ⟨f, fun hfp => hfq (hp_le hfp), hSm⟩
    · obtain ⟨B, instB, q_B, φ_D, φ_node, hEtD, hEtNode, hComap, _, hCommB⟩ :=
        (hLocalD q h𝔪₀_max).2 h35
      letI : CommRing B := instB
      letI : Algebra D B := φ_D.toAlgebra
      haveI hEtAlgDB : Algebra.Etale D B := RingHom.etale_algebraMap.mp hEtD
      have hGen : GeneralizingMap (PrimeSpectrum.comap (algebraMap D B)) :=
        Algebra.HasGoingDown.iff_generalizingMap_primeSpectrumComap.mp inferInstance
      have hp_spec : p ⤳ PrimeSpectrum.comap (algebraMap D B) q_B := by
        rw [← PrimeSpectrum.le_iff_specializes]
        change p.asIdeal ≤ (PrimeSpectrum.comap φ_D q_B).asIdeal
        rw [hComap]
        exact hp_le
      obtain ⟨p_B, _, hp_B_comap⟩ := hGen hp_spec
      by_cases hAll : ∀ i : Fin 2, φ_node (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ p_B.asIdeal
      · exact Or.inr ⟨B, instB, p_B, φ_D, φ_node, hEtD, hEtNode, hp_B_comap, hAll, hCommB⟩
      · have hEx : ∃ i₀ : Fin 2, φ_node (Ideal.Quotient.mk _ (MvPolynomial.X i₀)) ∉ p_B.asIdeal := by
          by_contra hNo
          exact hAll (fun i => by by_contra hi; exact hNo ⟨i, hi⟩)
        obtain ⟨i₀, hi₀⟩ := hEx
        let x₀ : B := φ_node (Ideal.Quotient.mk _ (MvPolynomial.X i₀))
        letI : Algebra Ω B := (φ_D.comp (algebraMap Ω D)).toAlgebra
        haveI : IsScalarTower Ω D B := IsScalarTower.of_algebraMap_eq' rfl
        haveI : Algebra.FiniteType Ω B := Algebra.FiniteType.trans ‹Algebra.FiniteType Ω D› inferInstance
        let B' := Localization.Away x₀
        haveI : Algebra.FinitePresentation B B' := IsLocalization.Away.finitePresentation x₀
        haveI : Algebra.FiniteType Ω B' := Algebra.FiniteType.trans ‹Algebra.FiniteType Ω B› inferInstance
        let P' : Ideal B' := Ideal.map (algebraMap B B') p_B.asIdeal
        have hP'_ne_top : P' ≠ ⊤ := by
          intro hTop
          have hx₀_unit : IsUnit (algebraMap B (Localization.AtPrime p_B.asIdeal) x₀) :=
            (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime p_B.asIdeal) p_B.asIdeal x₀).mpr hi₀
          let loc_pB : B' →+* Localization.AtPrime p_B.asIdeal :=
            IsLocalization.Away.lift x₀ hx₀_unit
          have h_comp : loc_pB.comp (algebraMap B B') = algebraMap B (Localization.AtPrime p_B.asIdeal) :=
            IsLocalization.Away.lift_comp x₀ hx₀_unit
          have h_map_pB : Ideal.map loc_pB P' =
              IsLocalRing.maximalIdeal (Localization.AtPrime p_B.asIdeal) := by
            dsimp only [P']
            rw [Ideal.map_map, h_comp]
            exact Localization.AtPrime.map_eq_maximalIdeal
          rw [hTop, Ideal.map_top] at h_map_pB
          exact Ideal.IsMaximal.ne_top inferInstance h_map_pB.symm
        obtain ⟨𝔪', h𝔪'_max, hP'_le⟩ := Ideal.exists_le_maximal P' hP'_ne_top
        obtain ⟨ev_B', hker_B'⟩ := h_exists_ev Ω B' 𝔪'
        let ev_B : B →ₐ[Ω] Ω := ev_B'.comp (IsScalarTower.toAlgHom Ω B B')
        let φ_D_alg : D →ₐ[Ω] B := { φ_D with commutes' := fun _ => rfl }
        let ev_D : D →ₐ[Ω] Ω := ev_B.comp φ_D_alg
        let R_node := MvPolynomial (Fin 2) Ω ⧸
          Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))
        let φ_node_alg : R_node →ₐ[Ω] B :=
          { φ_node with commutes' := fun c => (RingHom.congr_fun hCommB c).symm }
        let ev_node : R_node →ₐ[Ω] Ω := ev_B.comp φ_node_alg
        haveI hq₁_max : (RingHom.ker ev_D.toRingHom).IsMaximal := h_ker_isMaximal ev_D
        let q₁ : PrimeSpectrum D := ⟨RingHom.ker ev_D.toRingHom, hq₁_max.isPrime⟩
        have hp_le_q₁ : p.asIdeal ≤ q₁.asIdeal := by
          intro d hd
          have hd_B : φ_D d ∈ p_B.asIdeal := by
            have : d ∈ (PrimeSpectrum.comap φ_D p_B).asIdeal := by
              rw [show PrimeSpectrum.comap φ_D p_B = p from hp_B_comap]
              exact hd
            exact this
          have hd_B' : algebraMap B B' (φ_D d) ∈ 𝔪' := hP'_le (Ideal.mem_map_of_mem _ hd_B)
          rw [← hker_B'] at hd_B'
          exact hd_B'
        have hx₀_not_ker : Ideal.Quotient.mk _ (MvPolynomial.X i₀) ∉ RingHom.ker ev_node.toRingHom := by
          intro h_in
          have hx_unit_B' : IsUnit (algebraMap B B' x₀) := IsLocalization.Away.algebraMap_isUnit x₀
          have hx_unit_Ω : IsUnit (ev_B' (algebraMap B B' x₀)) := hx_unit_B'.map ev_B'.toRingHom
          exact hx_unit_Ω.ne_zero h_in
        obtain ⟨e_loc_D, _⟩ := h_quotPowEquiv Ω D q₁.asIdeal 2
        obtain ⟨e_et_D⟩ := h_etaleQuotSqEquiv Ω φ_D_alg hEtD ev_B
        obtain ⟨e_et_node⟩ := h_etaleQuotSqEquiv Ω φ_node_alg hEtNode ev_B
        have h_finrank_eq :
            Module.finrank Ω (Localization.AtPrime q₁.asIdeal ⧸
              (IsLocalRing.maximalIdeal (Localization.AtPrime q₁.asIdeal)) ^ 2) =
            Module.finrank Ω (R_node ⧸ (RingHom.ker ev_node.toRingHom) ^ 2) :=
          LinearEquiv.finrank_eq (e_loc_D.symm.trans (e_et_D.trans e_et_node.symm)).toLinearEquiv
        have h_le2 : Module.finrank Ω (R_node ⧸ (RingHom.ker ev_node.toRingHom) ^ 2) ≤ 2 :=
          h_node_finrank_le_two Ω ev_node i₀ hx₀_not_ker
        have h2_q₁ : Module.finrank Ω (Localization.AtPrime q₁.asIdeal ⧸
            (IsLocalRing.maximalIdeal (Localization.AtPrime q₁.asIdeal)) ^ 2) = 2 := by
          rcases hArtinD q₁ hq₁_max with h2 | ⟨h3, _, _⟩
          · exact h2
          · exfalso; omega
        obtain ⟨f, hfq₁, hSm⟩ := (hLocalD q₁ hq₁_max).1 h2_q₁
        exact Or.inl ⟨f, fun hfp => hfq₁ (hp_le_q₁ hfp), hSm⟩

  
  have h_tmul_one_injective :
      ∀ (Ω₁ Ω₂ V : Type u) [Field Ω₁] [Field Ω₂] [Algebra Ω₁ Ω₂]
        [AddCommGroup V] [Module Ω₁ V],
        Function.Injective (fun v : V => (1 : Ω₂) ⊗ₜ[Ω₁] v) := by
    intro Ω₁ Ω₂ V _ _ _ _ _
    let e1 := LinearEquiv.ofInjective (Algebra.linearMap Ω₁ Ω₂)
      (RingHom.injective (algebraMap Ω₁ Ω₂))
    obtain ⟨g, hg⟩ := LinearMap.exists_extend e1.symm.toLinearMap
    have hg1 : g 1 = 1 := by
      have hmap1 : Algebra.linearMap Ω₁ Ω₂ 1 = 1 := map_one (algebraMap Ω₁ Ω₂)
      have hmem : (1 : Ω₂) ∈ LinearMap.range (Algebra.linearMap Ω₁ Ω₂) := ⟨1, hmap1⟩
      have h1 : g 1 = e1.symm ⟨1, hmem⟩ := LinearMap.congr_fun hg ⟨1, hmem⟩
      have h2 : e1 1 = ⟨1, hmem⟩ := Subtype.ext hmap1
      rw [← h2, e1.symm_apply_apply] at h1
      exact h1
    let ret : TensorProduct Ω₁ Ω₂ V →ₗ[Ω₁] V :=
      (TensorProduct.lid Ω₁ V).toLinearMap.comp (LinearMap.rTensor V g)
    intro v₁ v₂ h_eq
    dsimp only at h_eq
    have h_ret : ∀ v : V, ret ((1 : Ω₂) ⊗ₜ[Ω₁] v) = v := by
      intro v
      change (TensorProduct.lid Ω₁ V) ((g 1) ⊗ₜ[Ω₁] v) = v
      rw [hg1, TensorProduct.lid_tmul, one_smul]
    rw [← h_ret v₁, ← h_ret v₂, h_eq]

  
  have h_quad_factor :
      ∀ (Ω₁ : Type u) [Field Ω₁] [IsAlgClosed Ω₁]
        (a : Fin 3 → Ω₁), a ≠ 0 →
        ∃ (α₁ β₁ α₂ β₂ : Ω₁),
          (α₁ ≠ 0 ∨ β₁ ≠ 0) ∧
          (α₁ * β₂ - α₂ * β₁ = 0 → α₁ = α₂ ∧ β₁ = β₂) ∧
          ∃ c : Ω₁, c ≠ 0 ∧
            ∀ (R : Type u) [CommRing R] [Algebra Ω₁ R] (e₁ e₂ : R),
              c • ((α₁ • e₁ + β₁ • e₂) * (α₂ • e₁ + β₂ • e₂)) =
                a 0 • e₁ ^ 2 + a 1 • (e₁ * e₂) + a 2 • e₂ ^ 2 := by
    intro Ω₁ _ _ a ha
    by_cases ha0 : a 0 ≠ 0
    · let P : Polynomial Ω₁ :=
        Polynomial.C (a 0) * Polynomial.X ^ 2 + Polynomial.C (a 1) * Polynomial.X + Polynomial.C (a 2)
      have hcoeff2 : P.coeff 2 = a 0 := by
        simp [P, Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      have hdeg : P.degree ≠ 0 := by
        intro h0
        have hlt : P.degree < (2 : WithBot ℕ) := by rw [h0]; decide
        exact ha0 (hcoeff2 ▸ Polynomial.coeff_eq_zero_of_degree_lt hlt)
      obtain ⟨r₁, hr₁⟩ := IsAlgClosed.exists_root P hdeg
      have hr₁_eq : a 0 * r₁ ^ 2 + a 1 * r₁ + a 2 = 0 := by
        simpa [P, Polynomial.IsRoot.def] using hr₁
      let r₂ : Ω₁ := -(a 0)⁻¹ * (a 1 + a 0 * r₁)
      have h_sum : a 0 * (-r₁ + -r₂) = a 1 := by
        dsimp only [r₂]
        calc
          a 0 * (-r₁ + -(-(a 0)⁻¹ * (a 1 + a 0 * r₁)))
            = - (a 0 * r₁) + (a 0 * (a 0)⁻¹) * (a 1 + a 0 * r₁) := by ring
          _ = - (a 0 * r₁) + 1 * (a 1 + a 0 * r₁) := by rw [mul_inv_cancel₀ ha0]
          _ = a 1 := by ring
      have h_prod : a 0 * ((-r₁) * (-r₂)) = a 2 := by
        dsimp only [r₂]
        calc
          a 0 * ((-r₁) * (-(-(a 0)⁻¹ * (a 1 + a 0 * r₁))))
            = - r₁ * ((a 0 * (a 0)⁻¹) * (a 1 + a 0 * r₁)) := by ring
          _ = - r₁ * (1 * (a 1 + a 0 * r₁)) := by rw [mul_inv_cancel₀ ha0]
          _ = (a 0 * r₁ ^ 2 + a 1 * r₁ + a 2) - (a 0 * r₁ ^ 2 + a 1 * r₁) := by
              rw [hr₁_eq]; ring
          _ = a 2 := by ring
      have h_det1 : ∀ x y : Ω₁, 1 * (-y) - 1 * (-x) = 0 → -x = -y := by
        intro x y hxy
        linear_combination -hxy
      refine ⟨1, -r₁, 1, -r₂, Or.inl one_ne_zero, fun hdet => ⟨rfl, h_det1 r₁ r₂ hdet⟩, a 0, ha0, ?_⟩
      intro R _ _ e₁ e₂
      simp only [Algebra.smul_def]
      rw [← h_sum, ← h_prod]
      simp only [map_mul, map_add, map_neg, map_one]
      ring
    · have ha0' : a 0 = 0 := not_ne_iff.mp ha0
      by_cases ha1 : a 1 ≠ 0
      · refine ⟨0, 1, 1, (a 1)⁻¹ * a 2, Or.inr one_ne_zero, ?_, a 1, ha1, ?_⟩
        · intro hdet
          exfalso
          have h1 : (-1 : Ω₁) = 0 := by linear_combination hdet
          exact neg_ne_zero.mpr one_ne_zero h1
        · intro R _ _ e₁ e₂
          have h_mul : a 1 * ((a 1)⁻¹ * a 2) = a 2 := by
            rw [← mul_assoc, mul_inv_cancel₀ ha1, one_mul]
          calc
            a 1 • (((0 : Ω₁) • e₁ + (1 : Ω₁) • e₂) * ((1 : Ω₁) • e₁ + ((a 1)⁻¹ * a 2) • e₂))
              = algebraMap Ω₁ R (a 1) * (e₁ * e₂) +
                  algebraMap Ω₁ R (a 1 * ((a 1)⁻¹ * a 2)) * e₂ ^ 2 := by
                simp only [Algebra.smul_def, map_mul, map_zero, map_one]
                ring
            _ = a 0 • e₁ ^ 2 + a 1 • (e₁ * e₂) + a 2 • e₂ ^ 2 := by
                rw [ha0', zero_smul, zero_add, h_mul, Algebra.smul_def, Algebra.smul_def]
      · have ha1' : a 1 = 0 := not_ne_iff.mp ha1
        have ha2 : a 2 ≠ 0 := by
          intro ha2
          apply ha
          ext i
          fin_cases i
          · exact ha0'
          · exact ha1'
          · exact ha2
        refine ⟨0, 1, 0, 1, Or.inr one_ne_zero, fun _ => ⟨rfl, rfl⟩, a 2, ha2, ?_⟩
        intro R _ _ e₁ e₂
        rw [ha0', ha1', zero_smul, zero_smul, zero_add, zero_add]
        simp only [Algebra.smul_def, map_zero, map_one]
        ring

  
  have h_s2 :
      ∀ (Ω₁ Ω₂ : Type u) [Field Ω₁] [IsAlgClosed Ω₁] [Field Ω₂] [IsAlgClosed Ω₂]
        [Algebra Ω₁ Ω₂]
        (D : Type u) [CommRing D] [Algebra Ω₁ D] [Algebra.FiniteType Ω₁ D],
        _root_.IsReduced (TensorProduct Ω₁ Ω₂ D) →
        (∀ (q₂ : PrimeSpectrum (TensorProduct Ω₁ Ω₂ D)), q₂.asIdeal.IsMaximal →
          let L₂ := Localization.AtPrime q₂.asIdeal
          let 𝔪₂ : Ideal L₂ := IsLocalRing.maximalIdeal L₂
          Module.finrank Ω₂ (L₂ ⧸ 𝔪₂ ^ 2) = 2 ∨
            (Module.finrank Ω₂ (L₂ ⧸ 𝔪₂ ^ 2) = 3 ∧
             Module.finrank Ω₂ (L₂ ⧸ 𝔪₂ ^ 3) = 5 ∧
             ∃ u₂ v₂ : L₂, Ideal.span {u₂, v₂} = 𝔪₂ ∧ u₂ * v₂ ∈ 𝔪₂ ^ 3)) →
        _root_.IsReduced D ∧
        (∀ (q₁ : PrimeSpectrum D), q₁.asIdeal.IsMaximal →
          let L₁ := Localization.AtPrime q₁.asIdeal
          let 𝔪₁ : Ideal L₁ := IsLocalRing.maximalIdeal L₁
          Module.finrank Ω₁ (L₁ ⧸ 𝔪₁ ^ 2) = 2 ∨
            (Module.finrank Ω₁ (L₁ ⧸ 𝔪₁ ^ 2) = 3 ∧
             Module.finrank Ω₁ (L₁ ⧸ 𝔪₁ ^ 3) = 5 ∧
             ∃ u₁ v₁ : L₁, Ideal.span {u₁, v₁} = 𝔪₁ ∧ u₁ * v₁ ∈ 𝔪₁ ^ 3)) := by
    intro Ω₁ Ω₂ _ _ _ _ _ D _ _ _ hRed₂ hArtin₂
    let D₂ : Type u := TensorProduct Ω₁ Ω₂ D
    let ι_R : D →ₐ[Ω₁] D₂ := Algebra.TensorProduct.includeRight
    have hInj_ι : Function.Injective ι_R := h_tmul_one_injective Ω₁ Ω₂ D
    have hRed₁ : _root_.IsReduced D :=
      ⟨fun d hd => hInj_ι ((hRed₂.eq_zero (ι_R d) (hd.map ι_R.toRingHom)).trans (map_zero ι_R).symm)⟩
    refine ⟨hRed₁, ?_⟩
    intro q₁ hq₁_max
    haveI : q₁.asIdeal.IsMaximal := hq₁_max
    let I₁ : Ideal D := q₁.asIdeal
    obtain ⟨ev₁, hker₁⟩ := h_exists_ev Ω₁ D I₁
    let I₂ : Ideal D₂ := Ideal.map ι_R.toRingHom I₁
    let ev₂ : D₂ →ₐ[Ω₂] Ω₂ :=
      Algebra.TensorProduct.lift (AlgHom.id Ω₂ Ω₂) ((Algebra.ofId Ω₁ Ω₂).comp ev₁)
        (fun _ _ => mul_comm _ _)
    have hI₂_le_ker : I₂ ≤ RingHom.ker ev₂.toRingHom := by
      rw [Ideal.map_le_iff_le_comap]
      intro d hd
      change ev₂ ((1 : Ω₂) ⊗ₜ[Ω₁] d) = 0
      change (1 : Ω₂) * algebraMap Ω₁ Ω₂ (ev₁ d) = 0
      have hd0 : ev₁ d = 0 := by rwa [← hker₁] at hd
      rw [hd0, map_zero, mul_zero]
    have h_sub_I₂ : ∀ z : D₂, z - algebraMap Ω₂ D₂ (ev₂ z) ∈ I₂ := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul c d =>
        have hd_mem : d - algebraMap Ω₁ D (ev₁ d) ∈ I₁ := by
          rw [← hker₁]
          change ev₁ (d - algebraMap Ω₁ D (ev₁ d)) = 0
          rw [map_sub, ev₁.commutes]
          exact sub_self _
        have h_img : algebraMap Ω₂ D₂ c * ι_R (d - algebraMap Ω₁ D (ev₁ d)) ∈ I₂ :=
          I₂.mul_mem_left _ (Ideal.mem_map_of_mem _ hd_mem)
        have h_eq : algebraMap Ω₂ D₂ c * ι_R (d - algebraMap Ω₁ D (ev₁ d)) =
            c ⊗ₜ[Ω₁] d - algebraMap Ω₂ D₂ (ev₂ (c ⊗ₜ[Ω₁] d)) := by
          rw [map_sub, mul_sub]
          have h1 : algebraMap Ω₂ D₂ c * ι_R d = c ⊗ₜ[Ω₁] d := by
            change (c ⊗ₜ[Ω₁] (1 : D)) * ((1 : Ω₂) ⊗ₜ[Ω₁] d) = c ⊗ₜ[Ω₁] d
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          have h2 : algebraMap Ω₂ D₂ c * ι_R (algebraMap Ω₁ D (ev₁ d)) =
              algebraMap Ω₂ D₂ (ev₂ (c ⊗ₜ[Ω₁] d)) := by
            change (c ⊗ₜ[Ω₁] (1 : D)) * ((1 : Ω₂) ⊗ₜ[Ω₁] algebraMap Ω₁ D (ev₁ d)) =
              (c * algebraMap Ω₁ Ω₂ (ev₁ d)) ⊗ₜ[Ω₁] (1 : D)
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
              Algebra.algebraMap_eq_smul_one (A := D), ← TensorProduct.smul_tmul,
              Algebra.smul_def, mul_comm]
          rw [h1, h2]
        rwa [← h_eq]
      | add x y hx hy =>
        have h_add : (x + y) - algebraMap Ω₂ D₂ (ev₂ (x + y)) =
            (x - algebraMap Ω₂ D₂ (ev₂ x)) + (y - algebraMap Ω₂ D₂ (ev₂ y)) := by
          rw [map_add, map_add]; abel
        rw [h_add]
        exact I₂.add_mem hx hy
    have hker₂ : RingHom.ker ev₂.toRingHom = I₂ := by
      apply le_antisymm _ hI₂_le_ker
      intro z hz
      have hz0 : ev₂ z = 0 := hz
      have h := h_sub_I₂ z
      rwa [hz0, map_zero, sub_zero] at h
    haveI hI₂_max : I₂.IsMaximal := hker₂ ▸ h_ker_isMaximal ev₂
    let q₂ : PrimeSpectrum D₂ := ⟨I₂, hI₂_max.isPrime⟩
    have h_compl : I₁.primeCompl ≤ Submonoid.comap ι_R.toRingHom q₂.asIdeal.primeCompl := by
      intro s hs h_in
      change ι_R s ∈ I₂ at h_in
      rw [← hker₂] at h_in
      change (1 : Ω₂) * algebraMap Ω₁ Ω₂ (ev₁ s) = 0 at h_in
      rw [one_mul] at h_in
      have hs0 : ev₁ s = 0 :=
        (map_eq_zero_iff (algebraMap Ω₁ Ω₂) (RingHom.injective (algebraMap Ω₁ Ω₂))).mp h_in
      exact hs (hker₁ ▸ hs0)
    let L₁ := Localization.AtPrime q₁.asIdeal
    let 𝔪₁ : Ideal L₁ := IsLocalRing.maximalIdeal L₁
    let L₂ := Localization.AtPrime q₂.asIdeal
    let 𝔪₂ : Ideal L₂ := IsLocalRing.maximalIdeal L₂
    let ι_L : L₁ →+* L₂ := IsLocalization.map L₂ ι_R.toRingHom h_compl
    have hι_L_comp : ι_L.comp (algebraMap D L₁) = (algebraMap D₂ L₂).comp ι_R.toRingHom :=
      IsLocalization.map_comp h_compl
    have hι_L_max : Ideal.map ι_L 𝔪₁ ≤ 𝔪₂ := by
      have h1 : 𝔪₁ = Ideal.map (algebraMap D L₁) I₁ := Localization.AtPrime.map_eq_maximalIdeal.symm
      have h2 : 𝔪₂ = Ideal.map (algebraMap D₂ L₂) q₂.asIdeal := Localization.AtPrime.map_eq_maximalIdeal.symm
      rw [h1, Ideal.map_map, hι_L_comp, h2]
      change Ideal.map ((algebraMap D₂ L₂).comp ι_R.toRingHom) I₁ ≤
        Ideal.map (algebraMap D₂ L₂) (Ideal.map ι_R.toRingHom I₁)
      rw [Ideal.map_map]
    haveI hq₂_max : q₂.asIdeal.IsMaximal := hI₂_max
    have hΨ_all : ∀ k : ℕ,
        ∃ Φ_k : TensorProduct Ω₁ Ω₂ (L₁ ⧸ 𝔪₁ ^ k) ≃ₐ[Ω₂] (L₂ ⧸ 𝔪₂ ^ k),
          ∀ z : L₁, Φ_k ((1 : Ω₂) ⊗ₜ[Ω₁] Ideal.Quotient.mk (𝔪₁ ^ k) z) =
            Ideal.Quotient.mk (𝔪₂ ^ k) (ι_L z) := by
      intro k
      have h_pow_le : q₁.asIdeal ^ k ≤ Ideal.comap ι_R.toRingHom (q₂.asIdeal ^ k) := by
        rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
      let ψ_quot : (D ⧸ q₁.asIdeal ^ k) →ₐ[Ω₁] (D₂ ⧸ q₂.asIdeal ^ k) :=
        Ideal.Quotient.liftₐ (q₁.asIdeal ^ k) ((Ideal.Quotient.mkₐ Ω₁ (q₂.asIdeal ^ k)).comp ι_R)
          (fun d hd => Ideal.Quotient.eq_zero_iff_mem.mpr (h_pow_le hd))
      let fwd_D : TensorProduct Ω₁ Ω₂ (D ⧸ q₁.asIdeal ^ k) →ₐ[Ω₂] (D₂ ⧸ q₂.asIdeal ^ k) :=
        Algebra.TensorProduct.lift (Algebra.ofId Ω₂ _) ψ_quot (fun _ _ => mul_comm _ _)
      let inv_raw : D₂ →ₐ[Ω₂] TensorProduct Ω₁ Ω₂ (D ⧸ q₁.asIdeal ^ k) :=
        Algebra.TensorProduct.map (AlgHom.id Ω₂ Ω₂) (Ideal.Quotient.mkₐ Ω₁ (q₁.asIdeal ^ k))
      have hker_inv : q₂.asIdeal ^ k ≤ RingHom.ker inv_raw.toRingHom := by
        have h_eq_pow : q₂.asIdeal ^ k = Ideal.map ι_R.toRingHom (q₁.asIdeal ^ k) :=
          (Ideal.map_pow _ _ k).symm
        rw [h_eq_pow, Ideal.map_le_iff_le_comap]
        intro d hd
        change inv_raw ((1 : Ω₂) ⊗ₜ[Ω₁] d) = 0
        change (1 : Ω₂) ⊗ₜ[Ω₁] (Ideal.Quotient.mk (q₁.asIdeal ^ k) d) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hd, TensorProduct.tmul_zero]
      let inv_D : (D₂ ⧸ q₂.asIdeal ^ k) →ₐ[Ω₂] TensorProduct Ω₁ Ω₂ (D ⧸ q₁.asIdeal ^ k) :=
        Ideal.Quotient.liftₐ (q₂.asIdeal ^ k) inv_raw (fun z hz => hker_inv hz)
      have h_fg : fwd_D.comp inv_D = AlgHom.id Ω₂ (D₂ ⧸ q₂.asIdeal ^ k) := by
        apply AlgHom.coe_ringHom_injective
        apply Ideal.Quotient.ringHom_ext
        have h_alg : (fwd_D.comp inv_D).comp (Ideal.Quotient.mkₐ Ω₂ (q₂.asIdeal ^ k)) =
            Ideal.Quotient.mkₐ Ω₂ (q₂.asIdeal ^ k) := by
          apply Algebra.TensorProduct.ext
          · apply AlgHom.ext
            intro c
            exact ((fwd_D.comp inv_D).comp (Ideal.Quotient.mkₐ Ω₂ (q₂.asIdeal ^ k))).commutes c
          · apply AlgHom.ext
            intro d
            change fwd_D ((1 : Ω₂) ⊗ₜ[Ω₁] Ideal.Quotient.mk (q₁.asIdeal ^ k) d) =
              Ideal.Quotient.mk (q₂.asIdeal ^ k) ((1 : Ω₂) ⊗ₜ[Ω₁] d)
            change (Algebra.ofId Ω₂ _ 1) * Ideal.Quotient.mk (q₂.asIdeal ^ k) ((1 : Ω₂) ⊗ₜ[Ω₁] d) = _
            rw [map_one, one_mul]
        exact RingHom.ext fun z =>
          congrArg (fun f : D₂ →ₐ[Ω₂] (D₂ ⧸ q₂.asIdeal ^ k) => f z) h_alg
      have h_gf : inv_D.comp fwd_D = AlgHom.id Ω₂ (TensorProduct Ω₁ Ω₂ (D ⧸ q₁.asIdeal ^ k)) := by
        apply Algebra.TensorProduct.ext
        · apply AlgHom.ext
          intro c
          exact (inv_D.comp fwd_D).commutes c
        · apply AlgHom.coe_ringHom_injective
          apply Ideal.Quotient.ringHom_ext
          refine RingHom.ext fun d => ?_
          change inv_D (fwd_D ((1 : Ω₂) ⊗ₜ[Ω₁] Ideal.Quotient.mk (q₁.asIdeal ^ k) d)) =
            (1 : Ω₂) ⊗ₜ[Ω₁] Ideal.Quotient.mk (q₁.asIdeal ^ k) d
          have h1 : fwd_D ((1 : Ω₂) ⊗ₜ[Ω₁] Ideal.Quotient.mk (q₁.asIdeal ^ k) d) =
              Ideal.Quotient.mk (q₂.asIdeal ^ k) ((1 : Ω₂) ⊗ₜ[Ω₁] d) := by
            change (Algebra.ofId Ω₂ (D₂ ⧸ q₂.asIdeal ^ k) 1) *
                Ideal.Quotient.mk (q₂.asIdeal ^ k) ((1 : Ω₂) ⊗ₜ[Ω₁] d) =
              Ideal.Quotient.mk (q₂.asIdeal ^ k) ((1 : Ω₂) ⊗ₜ[Ω₁] d)
            rw [map_one, one_mul]
          rw [h1]
          rfl
      let Ψ_k : TensorProduct Ω₁ Ω₂ (D ⧸ q₁.asIdeal ^ k) ≃ₐ[Ω₂] (D₂ ⧸ q₂.asIdeal ^ k) :=
        AlgEquiv.ofAlgHom fwd_D inv_D h_fg h_gf
      obtain ⟨e₁_k, he₁_k⟩ := h_quotPowEquiv Ω₁ D q₁.asIdeal k
      obtain ⟨e₂_k, he₂_k⟩ := h_quotPowEquiv Ω₂ D₂ q₂.asIdeal k
      let e_tensor : TensorProduct Ω₁ Ω₂ (L₁ ⧸ 𝔪₁ ^ k) ≃ₐ[Ω₂]
          TensorProduct Ω₁ Ω₂ (D ⧸ q₁.asIdeal ^ k) :=
        Algebra.TensorProduct.congr AlgEquiv.refl e₁_k.symm
      let Φ_k := (e_tensor.trans Ψ_k).trans e₂_k
      refine ⟨Φ_k, ?_⟩
      let lhs_hom : L₁ →+* (L₂ ⧸ 𝔪₂ ^ k) :=
        (Φ_k.toAlgHom.restrictScalars Ω₁).toRingHom.comp
          ((Algebra.TensorProduct.includeRight : (L₁ ⧸ 𝔪₁ ^ k) →ₐ[Ω₁] _).toRingHom.comp
            (Ideal.Quotient.mk (𝔪₁ ^ k)))
      let rhs_hom : L₁ →+* (L₂ ⧸ 𝔪₂ ^ k) :=
        (Ideal.Quotient.mk (𝔪₂ ^ k)).comp ι_L
      have h_hom_eq : lhs_hom = rhs_hom := by
        apply IsLocalization.ringHom_ext q₁.asIdeal.primeCompl
        refine RingHom.ext fun d => ?_
        change Φ_k ((1 : Ω₂) ⊗ₜ[Ω₁] (Ideal.Quotient.mk (𝔪₁ ^ k) (algebraMap D L₁ d))) =
          Ideal.Quotient.mk (𝔪₂ ^ k) (ι_L (algebraMap D L₁ d))
        rw [← he₁_k d]
        have he1 : e_tensor ((1 : Ω₂) ⊗ₜ[Ω₁] (e₁_k (Ideal.Quotient.mk (q₁.asIdeal ^ k) d))) =
            (1 : Ω₂) ⊗ₜ[Ω₁] Ideal.Quotient.mk (q₁.asIdeal ^ k) d := by
          change (1 : Ω₂) ⊗ₜ[Ω₁] (e₁_k.symm (e₁_k (Ideal.Quotient.mk (q₁.asIdeal ^ k) d))) = _
          rw [e₁_k.symm_apply_apply]
        have hΨ : Ψ_k ((1 : Ω₂) ⊗ₜ[Ω₁] Ideal.Quotient.mk (q₁.asIdeal ^ k) d) =
            Ideal.Quotient.mk (q₂.asIdeal ^ k) (ι_R d) := by
          change (Algebra.ofId Ω₂ _ 1) * Ideal.Quotient.mk (q₂.asIdeal ^ k) (ι_R d) = _
          rw [map_one, one_mul]
        have hmap : ι_L (algebraMap D L₁ d) = algebraMap D₂ L₂ (ι_R d) :=
          IsLocalization.map_eq h_compl d
        simp only [Φ_k, AlgEquiv.trans_apply, he1, hΨ, he₂_k (ι_R d), hmap]
        rfl
      intro z
      exact RingHom.congr_fun h_hom_eq z
    have h_finrank : ∀ k : ℕ, Module.finrank Ω₁ (L₁ ⧸ 𝔪₁ ^ k) = Module.finrank Ω₂ (L₂ ⧸ 𝔪₂ ^ k) := by
      intro k
      obtain ⟨Φ_k, _⟩ := hΨ_all k
      rw [← Module.finrank_baseChange (R := Ω₂) (S := Ω₁) (M' := (L₁ ⧸ 𝔪₁ ^ k))]
      exact LinearEquiv.finrank_eq Φ_k.toLinearEquiv
    have hArtin_q₂ :
        Module.finrank Ω₂ (L₂ ⧸ 𝔪₂ ^ 2) = 2 ∨
          (Module.finrank Ω₂ (L₂ ⧸ 𝔪₂ ^ 2) = 3 ∧
           Module.finrank Ω₂ (L₂ ⧸ 𝔪₂ ^ 3) = 5 ∧
           ∃ u₂ v₂ : L₂, Ideal.span {u₂, v₂} = 𝔪₂ ∧ u₂ * v₂ ∈ 𝔪₂ ^ 3) :=
      hArtin₂ q₂ hq₂_max
    rcases hArtin_q₂ with h2_2 | ⟨h2_3, h3_5, u₂, v₂, hspan₂, huv₂⟩
    · exact Or.inl ((h_finrank 2).trans h2_2)
    · right
      have h1_2 : Module.finrank Ω₁ (L₁ ⧸ 𝔪₁ ^ 2) = 3 := (h_finrank 2).trans h2_3
      have h1_3 : Module.finrank Ω₁ (L₁ ⧸ 𝔪₁ ^ 3) = 5 := (h_finrank 3).trans h3_5
      refine ⟨h1_2, h1_3, ?_⟩
      haveI : Module.Free Ω₂ (L₂ ⧸ 𝔪₂ ^ 2) := Module.Free.of_divisionRing Ω₂ (L₂ ⧸ 𝔪₂ ^ 2)
      haveI : Module.Free Ω₂ (L₂ ⧸ 𝔪₂ ^ 3) := Module.Free.of_divisionRing Ω₂ (L₂ ⧸ 𝔪₂ ^ 3)
      haveI : FiniteDimensional Ω₁ (L₁ ⧸ 𝔪₁ ^ 2) :=
        Module.finite_of_finrank_pos (by rw [h1_2]; positivity)
      haveI : FiniteDimensional Ω₁ (L₁ ⧸ 𝔪₁ ^ 3) :=
        Module.finite_of_finrank_pos (by rw [h1_3]; positivity)
      haveI : FiniteDimensional Ω₂ (L₂ ⧸ 𝔪₂ ^ 2) :=
        Module.finite_of_finrank_pos (by rw [h2_3]; positivity)
      haveI : FiniteDimensional Ω₂ (L₂ ⧸ 𝔪₂ ^ 3) :=
        Module.finite_of_finrank_pos (by rw [h3_5]; positivity)
      haveI : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing Ω₁ D
      haveI : IsNoetherianRing L₁ := IsLocalization.isNoetherianRing q₁.asIdeal.primeCompl L₁ inferInstance
      obtain ⟨e₁_1, he₁_1⟩ := h_quotPowEquiv Ω₁ D q₁.asIdeal 1
      have hker₁' : RingHom.ker ev₁.toRingHom = q₁.asIdeal := hker₁
      let ev_D_pow1 : (D ⧸ q₁.asIdeal ^ 1) →ₐ[Ω₁] Ω₁ :=
        Ideal.Quotient.liftₐ (q₁.asIdeal ^ 1) ev₁ (fun d hd => by rw [pow_one, ← hker₁'] at hd; exact hd)
      let ev_L₁ : L₁ →ₐ[Ω₁] Ω₁ :=
        (ev_D_pow1.comp e₁_1.symm.toAlgHom).comp (Ideal.Quotient.mkₐ Ω₁ (𝔪₁ ^ 1))
      have hker_ev_L₁ : RingHom.ker ev_L₁.toRingHom = 𝔪₁ := by
        ext z
        obtain ⟨q_d, hq_d⟩ := e₁_1.surjective (Ideal.Quotient.mk (𝔪₁ ^ 1) z)
        obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective q_d
        have hz_eq : Ideal.Quotient.mk (𝔪₁ ^ 1) z = Ideal.Quotient.mk (𝔪₁ ^ 1) (algebraMap D L₁ d) :=
          hq_d.symm.trans (he₁_1 d)
        have h_eval : ev_L₁ z = ev₁ d := by
          change ev_D_pow1 (e₁_1.symm (Ideal.Quotient.mk (𝔪₁ ^ 1) z)) = ev₁ d
          rw [← hq_d, e₁_1.symm_apply_apply]
          rfl
        have h_mem_iff : z ∈ 𝔪₁ ↔ d ∈ q₁.asIdeal := by
          have h1 : z ∈ 𝔪₁ ↔ Ideal.Quotient.mk (𝔪₁ ^ 1) z = 0 := by
            rw [pow_one, Ideal.Quotient.eq_zero_iff_mem]
          rw [h1, hz_eq, ← he₁_1 d, map_eq_zero_iff e₁_1 e₁_1.injective,
            Ideal.Quotient.eq_zero_iff_mem, pow_one]
        change ev_L₁ z = 0 ↔ z ∈ 𝔪₁
        rw [h_eval, h_mem_iff, ← hker₁']
        rfl
      obtain ⟨e₂_1, he₂_1⟩ := h_quotPowEquiv Ω₂ D₂ q₂.asIdeal 1
      have hker₂' : RingHom.ker ev₂.toRingHom = q₂.asIdeal := hker₂
      let ev_D₂_pow1 : (D₂ ⧸ q₂.asIdeal ^ 1) →ₐ[Ω₂] Ω₂ :=
        Ideal.Quotient.liftₐ (q₂.asIdeal ^ 1) ev₂ (fun z hz => by rw [pow_one, ← hker₂'] at hz; exact hz)
      let ev_L₂ : L₂ →ₐ[Ω₂] Ω₂ :=
        (ev_D₂_pow1.comp e₂_1.symm.toAlgHom).comp (Ideal.Quotient.mkₐ Ω₂ (𝔪₂ ^ 1))
      have hker_ev_L₂ : RingHom.ker ev_L₂.toRingHom = 𝔪₂ := by
        ext z
        obtain ⟨q_d, hq_d⟩ := e₂_1.surjective (Ideal.Quotient.mk (𝔪₂ ^ 1) z)
        obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective q_d
        have hz_eq : Ideal.Quotient.mk (𝔪₂ ^ 1) z = Ideal.Quotient.mk (𝔪₂ ^ 1) (algebraMap D₂ L₂ d) :=
          hq_d.symm.trans (he₂_1 d)
        have h_eval : ev_L₂ z = ev₂ d := by
          change ev_D₂_pow1 (e₂_1.symm (Ideal.Quotient.mk (𝔪₂ ^ 1) z)) = ev₂ d
          rw [← hq_d, e₂_1.symm_apply_apply]
          rfl
        have h_mem_iff : z ∈ 𝔪₂ ↔ d ∈ q₂.asIdeal := by
          have h1 : z ∈ 𝔪₂ ↔ Ideal.Quotient.mk (𝔪₂ ^ 1) z = 0 := by
            rw [pow_one, Ideal.Quotient.eq_zero_iff_mem]
          rw [h1, hz_eq, ← he₂_1 d, map_eq_zero_iff e₂_1 e₂_1.injective,
            Ideal.Quotient.eq_zero_iff_mem, pow_one]
        change ev_L₂ z = 0 ↔ z ∈ 𝔪₂
        rw [h_eval, h_mem_iff, ← hker₂']
        rfl
      let mk1_2 := Ideal.Quotient.mkₐ Ω₁ (𝔪₁ ^ 2)
      let mk1_3 := Ideal.Quotient.mkₐ Ω₁ (𝔪₁ ^ 3)
      let mk2_3 := Ideal.Quotient.mkₐ Ω₂ (𝔪₂ ^ 3)
      let bar_ev₁ : (L₁ ⧸ 𝔪₁ ^ 2) →ₗ[Ω₁] Ω₁ :=
        (Ideal.Quotient.liftₐ (𝔪₁ ^ 2) ev_L₁ (fun z hz => by
          have hz1 : z ∈ 𝔪₁ := Ideal.pow_le_self (by norm_num) hz
          rwa [← hker_ev_L₁] at hz1)).toLinearMap
      have h_surj_bar1 : Function.Surjective bar_ev₁ := fun c =>
        ⟨algebraMap Ω₁ (L₁ ⧸ 𝔪₁ ^ 2) c, by
          change ev_L₁ (algebraMap Ω₁ L₁ c) = c
          exact ev_L₁.commutes c⟩
      have h_ker_bar1_dim : Module.finrank Ω₁ (LinearMap.ker bar_ev₁) = 2 := by
        have hrk := LinearMap.finrank_range_add_finrank_ker bar_ev₁
        rw [LinearMap.range_eq_top.mpr h_surj_bar1, finrank_top, Module.finrank_self, h1_2] at hrk
        omega
      let b_cot : Module.Basis (Fin 2) Ω₁ (LinearMap.ker bar_ev₁) :=
        Module.finBasisOfFinrankEq Ω₁ (LinearMap.ker bar_ev₁) h_ker_bar1_dim
      obtain ⟨e₁, he₁_mk⟩ := Ideal.Quotient.mk_surjective (b_cot 0).1
      obtain ⟨e₂, he₂_mk⟩ := Ideal.Quotient.mk_surjective (b_cot 1).1
      have he₁_mem : e₁ ∈ 𝔪₁ := by
        rw [← hker_ev_L₁]
        have h0 : bar_ev₁ (Ideal.Quotient.mk (𝔪₁ ^ 2) e₁) = 0 := by
          rw [he₁_mk]; exact (b_cot 0).2
        exact h0
      have he₂_mem : e₂ ∈ 𝔪₁ := by
        rw [← hker_ev_L₁]
        have h0 : bar_ev₁ (Ideal.Quotient.mk (𝔪₁ ^ 2) e₂) = 0 := by
          rw [he₂_mk]; exact (b_cot 1).2
        exact h0
      have h_span_e : Ideal.span ({e₁, e₂} : Set L₁) = 𝔪₁ := by
        apply le_antisymm
        · rw [Ideal.span_le]
          rintro x (rfl | rfl)
          · exact he₁_mem
          · exact he₂_mem
        · refine Submodule.le_of_le_smul_of_le_jacobson_bot
            (IsNoetherian.noetherian 𝔪₁)
            (IsLocalRing.maximalIdeal_le_jacobson ⊥) ?_
          intro m hm
          have hm_ker : Ideal.Quotient.mk (𝔪₁ ^ 2) m ∈ LinearMap.ker bar_ev₁ := by
            change ev_L₁ m = 0
            rwa [← hker_ev_L₁] at hm
          let v_m : LinearMap.ker bar_ev₁ := ⟨Ideal.Quotient.mk (𝔪₁ ^ 2) m, hm_ker⟩
          have hv_eq := b_cot.sum_repr v_m
          rw [Fin.sum_univ_two] at hv_eq
          let c₀ := b_cot.repr v_m 0
          let c₁ := b_cot.repr v_m 1
          have h_val_eq : c₀ • mk1_2 e₁ + c₁ • mk1_2 e₂ = mk1_2 m := by
            change c₀ • Ideal.Quotient.mk (𝔪₁ ^ 2) e₁ + c₁ • Ideal.Quotient.mk (𝔪₁ ^ 2) e₂ =
              Ideal.Quotient.mk (𝔪₁ ^ 2) m
            rw [he₁_mk, he₂_mk]
            exact congrArg Subtype.val hv_eq
          have h_diff_mem : m - (c₀ • e₁ + c₁ • e₂) ∈ 𝔪₁ ^ 2 := by
            rw [← Ideal.Quotient.eq_zero_iff_mem]
            change mk1_2 (m - (c₀ • e₁ + c₁ • e₂)) = 0
            rw [map_sub, map_add, map_smul, map_smul, h_val_eq, sub_self]
          have h_lin_mem : c₀ • e₁ + c₁ • e₂ ∈ Ideal.span ({e₁, e₂} : Set L₁) := by
            rw [Algebra.smul_def, Algebra.smul_def]
            exact Submodule.add_mem _
              (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
              (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
          have h_sq_smul : 𝔪₁ ^ 2 = 𝔪₁ • 𝔪₁ := by rw [sq, Ideal.smul_eq_mul]
          rw [← h_sq_smul]
          have hm_decomp : m = (c₀ • e₁ + c₁ • e₂) + (m - (c₀ • e₁ + c₁ • e₂)) := by abel
          rw [hm_decomp]
          exact Submodule.add_mem_sup h_lin_mem h_diff_mem
      let π₃₂_1 : (L₁ ⧸ 𝔪₁ ^ 3) →ₗ[Ω₁] (L₁ ⧸ 𝔪₁ ^ 2) :=
        (Ideal.Quotient.liftₐ (𝔪₁ ^ 3) mk1_2
          (fun z hz => Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_le_pow_right (by norm_num) hz))).toLinearMap
      have h_surj_π1 : Function.Surjective π₃₂_1 := fun x => by
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact ⟨Ideal.Quotient.mk (𝔪₁ ^ 3) z, rfl⟩
      have h_ker_π1_dim : Module.finrank Ω₁ (LinearMap.ker π₃₂_1) = 2 := by
        have hrk := LinearMap.finrank_range_add_finrank_ker π₃₂_1
        rw [LinearMap.range_eq_top.mpr h_surj_π1, finrank_top, h1_2, h1_3] at hrk
        omega
      have h_mem_ker_π1 : ∀ z ∈ 𝔪₁ ^ 2, mk1_3 z ∈ LinearMap.ker π₃₂_1 :=
        fun z hz => Ideal.Quotient.eq_zero_iff_mem.mpr hz
      let q_11 : LinearMap.ker π₃₂_1 :=
        ⟨mk1_3 (e₁ ^ 2), h_mem_ker_π1 _ (Ideal.pow_mem_pow he₁_mem 2)⟩
      let q_12 : LinearMap.ker π₃₂_1 :=
        ⟨mk1_3 (e₁ * e₂), h_mem_ker_π1 _ (by rw [sq]; exact Ideal.mul_mem_mul he₁_mem he₂_mem)⟩
      let q_22 : LinearMap.ker π₃₂_1 :=
        ⟨mk1_3 (e₂ ^ 2), h_mem_ker_π1 _ (Ideal.pow_mem_pow he₂_mem 2)⟩
      let T_quad : (Fin 3 → Ω₁) →ₗ[Ω₁] LinearMap.ker π₃₂_1 :=
        { toFun := fun a => a 0 • q_11 + a 1 • q_12 + a 2 • q_22
          map_add' := fun a b => by simp [add_smul]; abel
          map_smul' := fun c a => by simp [smul_add, mul_smul] }
      have h_ker_T_pos : 0 < Module.finrank Ω₁ (LinearMap.ker T_quad) := by
        have hrk := LinearMap.finrank_range_add_finrank_ker T_quad
        have h_le : Module.finrank Ω₁ (LinearMap.range T_quad) ≤ 2 :=
          (Submodule.finrank_le (LinearMap.range T_quad)).trans (le_of_eq h_ker_π1_dim)
        rw [Module.finrank_fin_fun] at hrk
        omega
      haveI : Nontrivial (LinearMap.ker T_quad) := Module.nontrivial_of_finrank_pos h_ker_T_pos
      obtain ⟨⟨a, ha_ker⟩, ha_ne0⟩ := exists_ne (0 : LinearMap.ker T_quad)
      have ha_vec_ne : a ≠ 0 := fun h => ha_ne0 (Subtype.ext h)
      have ha_syz : a 0 • e₁ ^ 2 + a 1 • (e₁ * e₂) + a 2 • e₂ ^ 2 ∈ 𝔪₁ ^ 3 := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        change mk1_3 (a 0 • e₁ ^ 2 + a 1 • (e₁ * e₂) + a 2 • e₂ ^ 2) = 0
        rw [map_add, map_add, map_smul, map_smul, map_smul]
        exact congrArg Subtype.val ha_ker
      obtain ⟨α₁, β₁, α₂, β₂, hαβ_ne, h_det_zero, c_fac, hc_ne, h_fac_id⟩ :=
        h_quad_factor Ω₁ a ha_vec_ne
      let u₁ : L₁ := α₁ • e₁ + β₁ • e₂
      let v₁ : L₁ := α₂ • e₁ + β₂ • e₂
      have hu₁_mem : u₁ ∈ 𝔪₁ := by
        dsimp only [u₁]
        rw [Algebra.smul_def, Algebra.smul_def]
        exact 𝔪₁.add_mem (Ideal.mul_mem_left _ _ he₁_mem) (Ideal.mul_mem_left _ _ he₂_mem)
      have hv₁_mem : v₁ ∈ 𝔪₁ := by
        dsimp only [v₁]
        rw [Algebra.smul_def, Algebra.smul_def]
        exact 𝔪₁.add_mem (Ideal.mul_mem_left _ _ he₁_mem) (Ideal.mul_mem_left _ _ he₂_mem)
      have huv₁_mem : u₁ * v₁ ∈ 𝔪₁ ^ 3 := by
        have h1 : c_fac • (u₁ * v₁) ∈ 𝔪₁ ^ 3 := by
          rw [h_fac_id L₁ e₁ e₂]
          exact ha_syz
        have h2 : c_fac⁻¹ • (c_fac • (u₁ * v₁)) ∈ 𝔪₁ ^ 3 := by
          rw [Algebra.smul_def]
          exact Ideal.mul_mem_left (𝔪₁ ^ 3) _ h1
        rwa [inv_smul_smul₀ hc_ne] at h2
      have h_det_ne : α₁ * β₂ - α₂ * β₁ ≠ 0 := by
        intro h_det0
        obtain ⟨rfl, rfl⟩ := h_det_zero h_det0
        have hu₁_sq_mem : u₁ ^ 2 ∈ 𝔪₁ ^ 3 := by simpa [sq] using huv₁_mem
        have hu₁_not_sq : u₁ ∉ 𝔪₁ ^ 2 := by
          intro hu_in
          have h_mk0 : mk1_2 u₁ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hu_in
          have h_cot0 : α₁ • b_cot 0 + β₁ • b_cot 1 = 0 := by
            apply Subtype.ext
            change α₁ • (b_cot 0).1 + β₁ • (b_cot 1).1 = 0
            rw [← he₁_mk, ← he₂_mk]
            change α₁ • mk1_2 e₁ + β₁ • mk1_2 e₂ = 0
            rw [← map_smul, ← map_smul, ← map_add]
            exact h_mk0
          have h_repr0 : b_cot.repr (α₁ • b_cot 0 + β₁ • b_cot 1) = 0 := by rw [h_cot0, map_zero]
