      ∃ (e : ℕ) (P_err : MvPolynomial (Fin (M + 1)) R),
        P_err.IsHomogeneous (d + e) ∧
        MvPolynomial.map (IsLocalRing.residue R) P_err = 0 ∧
        MvPolynomial.eval₂ (c_ER a₁) (ξ_ER a₁) (MvPolynomial.X a ^ e * G - P_err) = 0 := by
    intro d G_bar G a hGbar_hom hG_hom hG_map hGbar_ev0
    have hGbar_ev_a1 : MvPolynomial.eval₂ (c_Z0 a₁) (ξ_Z0 a₁) G_bar = 0 := by
      rw [← hAlgCaff_eq]
      exact hGbar_ev0
    have hGbar_ev_a : MvPolynomial.eval₂ (c_Z0 a) (ξ_Z0 a) G_bar = 0 := by
      apply hInj_Z_a1 a
      rw [map_zero, (hOv_0 a a₁).1 d G_bar hGbar_hom, hGbar_ev_a1, map_zero, mul_zero]
    have hπa_ev : π_a a (MvPolynomial.eval₂ (c_ER a) (ξ_ER a) G) = 0 := by
      change π_a a ((MvPolynomial.eval₂Hom (c_ER a) (ξ_ER a)) G) = 0
      rw [MvPolynomial.map_eval₂Hom]
      have hc_comp : (π_a a).comp (c_ER a) = (c_Z0 a).comp (IsLocalRing.residue R) := by
        ext r; exact hc_0_all a r
      have hξ_comp : (fun μ => π_a a (ξ_ER a μ)) = ξ_Z0 a := by
        ext μ; exact hξ_0_all a μ
      rw [hc_comp, hξ_comp]
      change MvPolynomial.eval₂ ((c_Z0 a).comp (IsLocalRing.residue R)) (ξ_Z0 a) G = 0
      rw [← MvPolynomial.eval₂_map, hG_map, hGbar_ev_a]
    have hMemKer : MvPolynomial.eval₂ (c_ER a) (ξ_ER a) G ∈
        Ideal.map (c_ER a) (IsLocalRing.maximalIdeal R) := by
      have hKerEq := (hFib0 (E_chart a) (hAff_E a) (Z_chart a) (hEq_0 a)).2
      rw [hSc_R a] at hKerEq
      change MvPolynomial.eval₂ (c_ER a) (ξ_ER a) G ∈
        Ideal.map (c_ER a) (IsLocalRing.maximalIdeal R)
      rw [← hKerEq]
      exact hπa_ev
    by_cases hNe_Ea : Nonempty ↥(E_chart a)
    · rcases Submodule.mem_span_iff_exists_finset_subset.mp hMemKer with
        ⟨u_fn, S_sub, hS_sub, _, hS_sum⟩
      have hS_lift : ∀ s : ↥S_sub,
          ∃ m : R, m ∈ IsLocalRing.maximalIdeal R ∧ c_ER a m = s.1 :=
        fun s => hS_sub s.2
      choose m_s hm_max hm_eq using hS_lift
      choose F_s hFs_ev using fun s : ↥S_sub => (hHomog_R a).2.1 (u_fn s.1)
      let e : ℕ := Finset.univ.sup (fun s : ↥S_sub => (F_s s).totalDegree)
      have hFs_deg : ∀ s : ↥S_sub, (F_s s).totalDegree ≤ d + e := by
        intro s
        have hle : (F_s s).totalDegree ≤ e :=
          Finset.le_sup (f := fun t : ↥S_sub => (F_s t).totalDegree) (Finset.mem_univ s)
        omega
      choose H_s hHs_hom hHs_ev using fun s : ↥S_sub =>
        (hHomog_R a).2.2 (d + e) (F_s s) (hFs_deg s)
      let P_err : MvPolynomial (Fin (M + 1)) R :=
        ∑ s : ↥S_sub, MvPolynomial.C (m_s s) * H_s s
      have hPerr_hom : P_err.IsHomogeneous (d + e) := by
        rw [← MvPolynomial.mem_homogeneousSubmodule]
        refine Submodule.sum_mem _ fun s _ =>
          (MvPolynomial.mem_homogeneousSubmodule (d + e) _).mpr ?_
        exact (hHs_hom s).C_mul (m_s s)
      have hPerr_map : MvPolynomial.map (IsLocalRing.residue R) P_err = 0 := by
        dsimp only [P_err]
        rw [map_sum]
        refine Finset.sum_eq_zero fun s _ => ?_
        have hm0 : IsLocalRing.residue R (m_s s) = 0 := by
          rw [← RingHom.mem_ker, IsLocalRing.ker_residue]
          exact hm_max s
        rw [map_mul, MvPolynomial.map_C, hm0, map_zero, zero_mul]
      have hDiff_hom : (MvPolynomial.X a ^ e * G - P_err).IsHomogeneous (d + e) := by
        have hX_hom : (MvPolynomial.X a ^ e : MvPolynomial (Fin (M + 1)) R).IsHomogeneous e := by
          simpa using (MvPolynomial.isHomogeneous_X R a).pow e
        have hXG_hom : (MvPolynomial.X a ^ e * G).IsHomogeneous (d + e) :=
          Nat.add_comm e d ▸ (hX_hom.mul hG_hom)
        exact hXG_hom.sub hPerr_hom
      have hEv_a : MvPolynomial.eval₂ (c_ER a) (ξ_ER a)
          (MvPolynomial.X a ^ e * G - P_err) = 0 := by
        have hξER_aa : ξ_ER a a = 1 := (hHomog_R a).1
        change (MvPolynomial.eval₂Hom (c_ER a) (ξ_ER a))
          (MvPolynomial.X a ^ e * G - P_err) = 0
        rw [map_sub, map_mul, map_pow, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X,
          hξER_aa, one_pow, one_mul]
        have hPerr_ev : MvPolynomial.eval₂ (c_ER a) (ξ_ER a) P_err =
            MvPolynomial.eval₂ (c_ER a) (ξ_ER a) G := by
          change (MvPolynomial.eval₂Hom (c_ER a) (ξ_ER a)) P_err =
            MvPolynomial.eval₂ (c_ER a) (ξ_ER a) G
          dsimp only [P_err]
          rw [map_sum, ← hS_sum, ← Finset.sum_attach S_sub]
          refine Finset.sum_congr rfl fun s _ => ?_
          have hHs_u : MvPolynomial.eval₂ (c_ER a) (ξ_ER a) (H_s s) = u_fn s.1 :=
            (hHs_ev s).trans (hFs_ev s)
          rw [map_mul, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C, hm_eq s,
            hHs_u, smul_eq_mul, mul_comm]
        exact sub_eq_zero.mpr hPerr_ev.symm
      refine ⟨e, P_err, hPerr_hom, hPerr_map, ?_⟩
      have hInj_Ea1 := (@hIntRes (E_chart a₁) (E_chart a) (hAff_E a₁) hNe_E1).2 hNe_Ea
      apply hInj_Ea1
      rw [map_zero, (hOv_R a₁ a).1 (d + e) _ hDiff_hom, hEv_a, map_zero, mul_zero]
    · have hEa_bot : E_chart a = ⊥ :=
        eq_bot_iff.mpr fun x hx => (hNe_Ea ⟨x, hx⟩).elim
      have hBo_ξ : E_bar.basicOpen (ξ_ER a₁ a) = E_chart a₁ ⊓ E_chart a := by
        dsimp only [ξ_ER]
        rw [← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ι'_bar (t_proj R M a₁ a),
          (hCoord_proj R M).2.2.2.2.2.2.2.1 a₁ a]
        rfl
      have hξ_zero : ξ_ER a₁ a = 0 :=
        (@hIntRes (E_chart a₁) (E_chart a) (hAff_E a₁) hNe_E1).1 hEa_bot (ξ_ER a₁ a) hBo_ξ
      refine ⟨1, 0, MvPolynomial.isHomogeneous_zero _ _ _,
        map_zero (MvPolynomial.map (IsLocalRing.residue R)), ?_⟩
      change (MvPolynomial.eval₂Hom (c_ER a₁) (ξ_ER a₁)) (MvPolynomial.X a ^ 1 * G - 0) = 0
      rw [sub_zero, pow_one, map_mul, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X,
        hξ_zero, zero_mul]
  obtain ⟨D₁, hD₀_D₁, h1_D₁, hHilb0⟩ :=
    part3_crux R K_R M B_R1 B_K1 C_aff (c_ER a₁) f_K π_0
      hInj_fK hc_K1 hc_0_a1 (ξ_ER a₁) ξ_EK ξ₀ hξ_K1 (hξ_0_all a₁)
      d_E D₀ hd_E hD₀ hGenHilb hAbsorb
  let R₀₁ : Type u := ↑(Z₀.presheaf.obj (Opposite.op (Z_00 ⊓ Z_01)))
  let res₀_ring : B₀ →+* R₀₁ :=
    (Z₀.presheaf.map (CategoryTheory.homOfLE (inf_le_left : Z_00 ⊓ Z_01 ≤ Z_00)).op).hom
  let res₁_ring : C_aff →+* R₀₁ :=
    (Z₀.presheaf.map (CategoryTheory.homOfLE (inf_le_right : Z_00 ⊓ Z_01 ≤ Z_01)).op).hom
  have hInj_res₀ : Function.Injective res₀_ring := by
    let hle : Z_chart 0 ⊓ V_01 ≤ Z_00 ⊓ Z_01 := inf_le_right
    have hcomp : CategoryTheory.homOfLE (inf_le_left : Z_chart 0 ⊓ V_01 ≤ Z_chart 0) =
        CategoryTheory.homOfLE hle ≫
          CategoryTheory.homOfLE (inf_le_left : Z_00 ⊓ Z_01 ≤ Z_00) :=
      Subsingleton.elim _ _
    have hmap : (Z₀.presheaf.map (CategoryTheory.homOfLE
          (inf_le_left : Z_chart 0 ⊓ V_01 ≤ Z_chart 0)).op).hom =
        ((Z₀.presheaf.map (CategoryTheory.homOfLE hle).op).hom).comp res₀_ring := by
      rw [hcomp, op_comp, Z₀.presheaf.map_comp]
      rfl
    have hinj := hInj_Vd 0
    rw [hmap] at hinj
    exact Function.Injective.of_comp hinj
  have hInj_res₁ : Function.Injective res₁_ring := by
    let hle : Z_chart a₁ ⊓ V_01 ≤ Z_00 ⊓ Z_01 := inf_le_right
    have hcomp : CategoryTheory.homOfLE (inf_le_left : Z_chart a₁ ⊓ V_01 ≤ Z_chart a₁) =
        CategoryTheory.homOfLE hle ≫
          CategoryTheory.homOfLE (inf_le_right : Z_00 ⊓ Z_01 ≤ Z_01) :=
      Subsingleton.elim _ _
    have hmap : (Z₀.presheaf.map (CategoryTheory.homOfLE
          (inf_le_left : Z_chart a₁ ⊓ V_01 ≤ Z_chart a₁)).op).hom =
        ((Z₀.presheaf.map (CategoryTheory.homOfLE hle).op).hom).comp res₁_ring := by
      rw [hcomp, op_comp, Z₀.presheaf.map_comp]
      rfl
    have hinj := hInj_Vd a₁
    rw [hmap] at hinj
    exact Function.Injective.of_comp hinj
  let _ : Algebra k₀ R₀₁ := (res₀_ring.comp (algebraMap k₀ B₀)).toAlgebra
  let res₀ : B₀ →ₐ[k₀] R₀₁ :=
    { toRingHom := res₀_ring
      commutes' := fun _ => rfl }
  have hRes_comm : ∀ x : k₀, res₁_ring (algebraMap k₀ C_aff x) = res₀_ring (algebraMap k₀ B₀ x) := by
    intro x
    rw [hAlgCaff_eq, hAlgB₀_eq]
    have hNatL := ι'_0.naturality
      (CategoryTheory.homOfLE (inf_le_left : weilProjBasicOpen k₀ M 0 ⊓ weilProjBasicOpen k₀ M a₁ ≤
        weilProjBasicOpen k₀ M 0)).op
    have hNatR := ι'_0.naturality
      (CategoryTheory.homOfLE (inf_le_right : weilProjBasicOpen k₀ M 0 ⊓ weilProjBasicOpen k₀ M a₁ ≤
        weilProjBasicOpen k₀ M a₁)).op
    have hL : res₀_ring (c_Z0 0 x) =
        (ι'_0.app (weilProjBasicOpen k₀ M 0 ⊓ weilProjBasicOpen k₀ M a₁)).hom
          (((weilProjectiveSpaceOver k₀ M).left.presheaf.map
            (CategoryTheory.homOfLE inf_le_left).op).hom (c_proj k₀ M 0 x)) :=
      ConcreteCategory.congr_hom hNatL.symm (c_proj k₀ M 0 x)
    have hR : res₁_ring (c_Z0 a₁ x) =
        (ι'_0.app (weilProjBasicOpen k₀ M 0 ⊓ weilProjBasicOpen k₀ M a₁)).hom
          (((weilProjectiveSpaceOver k₀ M).left.presheaf.map
            (CategoryTheory.homOfLE inf_le_right).op).hom (c_proj k₀ M a₁ x)) :=
      ConcreteCategory.congr_hom hNatR.symm (c_proj k₀ M a₁ x)
    rw [hR, hL, (hCoord_proj k₀ M).2.2.2.2.2.2.2.2.1 0 a₁ x]
  let res₁ : C_aff →ₐ[k₀] R₀₁ :=
    { toRingHom := res₁_ring
      commutes' := hRes_comm }
  have hGenB₀ : ∀ b : B₀, ∃ F : MvPolynomial (Fin (M + 1)) k₀,
      MvPolynomial.aeval (ξ_Z0 0) F = b := by
    intro b
    obtain ⟨F, hF⟩ := (hHomog_0 0).2.1 b
    refine ⟨F, ?_⟩
    change MvPolynomial.eval₂ (algebraMap k₀ B₀) (ξ_Z0 0) F = b
    rwa [hAlgB₀_eq]
  obtain ⟨hCocycle, hFinQuot, hRankQuot⟩ :=
    part4_cokernel k₀ M B₀ C_aff R₀₁ res₀ res₁ hInj_res₀ hInj_res₁
      (ξ_Z0 0) ξ₀ (hHomog_0 0).1 ((hOv_0 0 a₁).2) hGenB₀ d_E D₁ hHilb0
  exact ⟨D₁, hD₀_D₁, h1_D₁, hHilb0, hCocycle, hFinQuot, hRankQuot⟩

theorem weil_reduced_etale_nodal_ring_conductor_and_dvr_stalks (k₀ : Type u) [Field k₀] [IsAlgClosed k₀] :
    (∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra (Polynomial k₀) D]
        [Algebra.Etale (Polynomial k₀) D],
      IsIntegrallyClosed D ∧
      ∀ (𝔪 : Ideal D) [𝔪.IsMaximal],
        𝔪 ≠ ⊥ ∧ IsDiscreteValuationRing (Localization.AtPrime 𝔪)) ∧
    (∀ (C : Type u) [CommRing C] [_root_.IsReduced C] [Algebra k₀ C] [Algebra.FiniteType k₀ C]
        (S_sing : Finset (PrimeSpectrum C)),
      (∀ q ∈ S_sing, q.asIdeal.IsMaximal) →
      (∀ q : PrimeSpectrum C, q.asIdeal.IsMaximal → q ∉ S_sing →
        ∃ (g : C) (ψ : Polynomial k₀ →+* Localization.Away g),
          g ∉ q.asIdeal ∧
          IsDomain (Localization.Away g) ∧
          ψ.Etale ∧
          ψ.comp Polynomial.C = (algebraMap C (Localization.Away g)).comp (algebraMap k₀ C)) →
      (∀ q ∈ S_sing,
        ∃ (B' : Type u) (_ : CommRing B') (u₀ : PrimeSpectrum B')
          (φ₁ : C →+* B')
          (φ₂ : (MvPolynomial (Fin 2) k₀ ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B'),
          φ₁.Etale ∧
          φ₂.Etale ∧
          PrimeSpectrum.comap φ₁ u₀ = q ∧
          φ₁.comp (algebraMap k₀ C) = φ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) ∧
          (∀ i : Fin 2, φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ u₀.asIdeal) ∧
          (∀ i : Fin 2, IsDomain (B' ⧸ Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))}))) →
      let Q := Localization (nonZeroDivisors C)
      let C_tilde := integralClosure C Q
      let W_C : Submodule k₀ Q := LinearMap.range (IsScalarTower.toAlgHom k₀ C Q).toLinearMap
      let W_tilde : Submodule k₀ Q := C_tilde.toSubmodule.restrictScalars k₀
      Module.Finite k₀ (↥W_tilde ⧸ W_C.comap W_tilde.subtype) ∧
      Module.finrank k₀ (↥W_tilde ⧸ W_C.comap W_tilde.subtype) = S_sing.card ∧
      ((∀ q ∈ S_sing,
          ∃ 𝔭₁ ∈ minimalPrimes C, ∃ 𝔭₂ ∈ minimalPrimes C,
            𝔭₁ ≠ 𝔭₂ ∧ 𝔭₁ ≤ q.asIdeal ∧ 𝔭₂ ≤ q.asIdeal) →
        ∀ 𝔭 ∈ minimalPrimes C, IsIntegrallyClosed (C ⧸ 𝔭))) :=
by
  
  have hEtDVR :
      ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra (Polynomial k₀) D]
        [Algebra.Etale (Polynomial k₀) D],
      IsIntegrallyClosed D ∧
      ∀ (𝔪 : Ideal D) [𝔪.IsMaximal],
        𝔪 ≠ ⊥ ∧ IsDiscreteValuationRing (Localization.AtPrime 𝔪) := by
    intro D _ _ _ _
    let φ_D : Polynomial k₀ →+* D := algebraMap (Polynomial k₀) D
    have _hTorsFree : Module.IsTorsionFree (Polynomial k₀) D := Module.Flat.isTorsionFree
    have hInj_φ : Function.Injective φ_D := by
      rw [injective_iff_map_eq_zero]
      intro P hP
      have hsmul : P • (1 : D) = 0 := by
        rw [Algebra.smul_def, hP, zero_mul]
      exact (smul_eq_zero.mp hsmul).resolve_right one_ne_zero
    have hNoethD : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing (Polynomial k₀) D
    have hMain : ∀ (𝔪 : Ideal D) [𝔪.IsMaximal],
        𝔪 ≠ ⊥ ∧ IsDiscreteValuationRing (Localization.AtPrime 𝔪) := by
      intro 𝔪 hMax
      have hNeBot : 𝔪 ≠ ⊥ := by
        let _instAlgkD : Algebra k₀ D := (φ_D.comp Polynomial.C).toAlgebra
        have _instTowerkPD : IsScalarTower k₀ (Polynomial k₀) D :=
          IsScalarTower.of_algebraMap_eq' rfl
        have hFT_D : Algebra.FiniteType k₀ D :=
          Algebra.FiniteType.trans (R := k₀) (S := Polynomial k₀) (A := D) inferInstance inferInstance
        obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_D
        let _instFieldQuot : Field (D ⧸ 𝔪) := Ideal.Quotient.field 𝔪
        let π : MvPolynomial (Fin n) k₀ →ₐ[k₀] (D ⧸ 𝔪) := (Ideal.Quotient.mkₐ k₀ 𝔪).comp f
        have hSurj_π : Function.Surjective π := Ideal.Quotient.mk_surjective.comp hf
        let M : Ideal (MvPolynomial (Fin n) k₀) := RingHom.ker π.toRingHom
        have hMaxM : M.IsMaximal := RingHom.ker_isMaximal_of_surjective π.toRingHom hSurj_π
        obtain ⟨x, hx⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hMaxM
        obtain ⟨P, hP⟩ := hf (φ_D Polynomial.X)
        let c : k₀ := MvPolynomial.eval x P
        have hSubMem : P - MvPolynomial.C c ∈ M := by
          rw [hx]
          simp [MvPolynomial.vanishingIdeal, c]
        have hπEq : π P = π (MvPolynomial.C c) := by
          rw [← sub_eq_zero, ← map_sub]
          exact hSubMem
        have hQuotEq : Ideal.Quotient.mk 𝔪 (φ_D Polynomial.X) =
            Ideal.Quotient.mk 𝔪 (φ_D (Polynomial.C c)) := by
          have h1 : π P = Ideal.Quotient.mk 𝔪 (φ_D Polynomial.X) := by
            change Ideal.Quotient.mk 𝔪 (f P) = Ideal.Quotient.mk 𝔪 (φ_D Polynomial.X)
            rw [hP]
          have h2 : π (MvPolynomial.C c) = Ideal.Quotient.mk 𝔪 (φ_D (Polynomial.C c)) := by
            rw [MvPolynomial.C_eq_algebraMap, AlgHom.commutes]
            rfl
          exact h1.symm.trans (hπEq.trans h2)
        have hMem : φ_D (Polynomial.X - Polynomial.C c) ∈ 𝔪 := by
          rw [map_sub, ← Ideal.Quotient.eq]
          exact hQuotEq
        have hPolyNe : (Polynomial.X - Polynomial.C c : Polynomial k₀) ≠ 0 :=
          Polynomial.X_sub_C_ne_zero c
        have hImgNe : φ_D (Polynomial.X - Polynomial.C c) ≠ 0 :=
          fun h0 => hPolyNe (hInj_φ (h0.trans φ_D.map_zero.symm))
        intro hBot
        rw [hBot, Ideal.mem_bot] at hMem
        exact hImgNe hMem
      refine ⟨hNeBot, ?_⟩
      let R_𝔪 := Localization.AtPrime 𝔪
      have _instNoethR : IsNoetherianRing R_𝔪 :=
        IsLocalization.isNoetherianRing 𝔪.primeCompl R_𝔪 hNoethD
      have _instDomR : IsDomain R_𝔪 :=
        IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors 𝔪)
      have hNotField : ¬ IsField R_𝔪 := by
        obtain ⟨x, hx𝔪, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hNeBot
        have hInjLoc : Function.Injective (algebraMap D R_𝔪) :=
          IsLocalization.injective R_𝔪 (Ideal.primeCompl_le_nonZeroDivisors 𝔪)
        have hxLoc0 : algebraMap D R_𝔪 x ≠ 0 :=
          fun h0 => hx0 (hInjLoc (h0.trans (map_zero _).symm))
        have hxMaxLoc : algebraMap D R_𝔪 x ∈ IsLocalRing.maximalIdeal R_𝔪 :=
          (IsLocalization.AtPrime.to_map_mem_maximal_iff R_𝔪 𝔪 x).mpr hx𝔪
        have hxNotUnit : ¬ IsUnit (algebraMap D R_𝔪 x) :=
          IsLocalRing.notMem_maximalIdeal.not.mp (not_not.mpr hxMaxLoc)
        intro hField
        obtain ⟨b, hb⟩ := hField.mul_inv_cancel hxLoc0
        exact hxNotUnit (IsUnit.of_mul_eq_one b hb)
      let 𝔭₀ : Ideal (Polynomial k₀) := Ideal.comap φ_D 𝔪
      have _instPrime𝔭₀ : 𝔭₀.IsPrime := Ideal.comap_isPrime φ_D 𝔪
      let A₀ := Localization.AtPrime 𝔭₀
      let f_loc : A₀ →+* R_𝔪 := Localization.localRingHom 𝔭₀ 𝔪 φ_D rfl
      let _instAlgAR : Algebra A₀ R_𝔪 := f_loc.toAlgebra
      have _instTowerPAR : IsScalarTower (Polynomial k₀) A₀ R_𝔪 := by
        refine IsScalarTower.of_algebraMap_eq fun P => ?_
        rw [IsScalarTower.algebraMap_apply (Polynomial k₀) D R_𝔪 P]
        change (algebraMap D R_𝔪) (φ_D P) = f_loc (algebraMap (Polynomial k₀) A₀ P)
        exact (Localization.localRingHom_to_map 𝔭₀ 𝔪 φ_D rfl P).symm
      have _instLocHom : IsLocalHom (algebraMap A₀ R_𝔪) :=
        Localization.isLocalHom_localRingHom 𝔭₀ 𝔪 φ_D rfl
      have _instEssPR : Algebra.EssFiniteType (Polynomial k₀) R_𝔪 :=
        Algebra.EssFiniteType.comp (Polynomial k₀) D R_𝔪
      have _instEssAR : Algebra.EssFiniteType A₀ R_𝔪 :=
        Algebra.EssFiniteType.of_comp (Polynomial k₀) A₀ R_𝔪
      have hUnramPR : Algebra.FormallyUnramified (Polynomial k₀) R_𝔪 :=
        Algebra.FormallyUnramified.comp (Polynomial k₀) D R_𝔪
      have _instUnramAR : Algebra.FormallyUnramified A₀ R_𝔪 := by
        rw [Algebra.FormallyUnramified.iff_comp_injective (R := A₀) (A := R_𝔪)]
        intro B _ _ I hI g₁ g₂ hEq
        let _instAlgPB : Algebra (Polynomial k₀) B :=
          ((algebraMap A₀ B).comp (algebraMap (Polynomial k₀) A₀)).toAlgebra
        have _instTowerPAB : IsScalarTower (Polynomial k₀) A₀ B :=
          IsScalarTower.of_algebraMap_eq' rfl
        have hEq' : (Ideal.Quotient.mkₐ (Polynomial k₀) I).comp (g₁.restrictScalars (Polynomial k₀)) =
            (Ideal.Quotient.mkₐ (Polynomial k₀) I).comp (g₂.restrictScalars (Polynomial k₀)) := by
          apply AlgHom.ext
          intro r
          exact AlgHom.congr_fun hEq r
        have hg := (Algebra.FormallyUnramified.iff_comp_injective
          (R := Polynomial k₀) (A := R_𝔪)).mp hUnramPR I hI hEq'
        apply AlgHom.ext
        intro r
        exact AlgHom.congr_fun hg r
      have hMapMax : Ideal.map (algebraMap A₀ R_𝔪) (IsLocalRing.maximalIdeal A₀) =
          IsLocalRing.maximalIdeal R_𝔪 :=
        Algebra.FormallyUnramified.map_maximalIdeal
      have hMaxA₀ : Ideal.map (algebraMap (Polynomial k₀) A₀) 𝔭₀ = IsLocalRing.maximalIdeal A₀ :=
        IsLocalization.AtPrime.map_eq_maximalIdeal 𝔭₀ A₀
      let π₀ : Polynomial k₀ := Submodule.IsPrincipal.generator 𝔭₀
      have hSpan𝔭₀ : 𝔭₀ = Ideal.span {π₀} :=
        (Submodule.IsPrincipal.span_singleton_generator 𝔭₀).symm
      have hMapEq : Ideal.map (algebraMap (Polynomial k₀) A₀) 𝔭₀ =
          Ideal.span {algebraMap (Polynomial k₀) A₀ π₀} :=
        (congrArg (Ideal.map (algebraMap (Polynomial k₀) A₀)) hSpan𝔭₀).trans
          (by rw [Ideal.map_span, Set.image_singleton])
      have hPrinc : Submodule.IsPrincipal (IsLocalRing.maximalIdeal R_𝔪) := by
        refine ⟨⟨algebraMap A₀ R_𝔪 (algebraMap (Polynomial k₀) A₀ π₀), ?_⟩⟩
        rw [← hMapMax, ← hMaxA₀, hMapEq, Ideal.map_span, Set.image_singleton]
      exact ((IsDiscreteValuationRing.TFAE R_𝔪 hNotField).out 5 1).mp hPrinc
    refine ⟨?_, hMain⟩
    refine IsIntegrallyClosed.of_isLocalization_maximal (fun P _ => Localization.AtPrime P) ?_
    intro P hPMax
    obtain ⟨_hNe, hDVR⟩ := hMain P
    infer_instance

  
  have hS2 :
      ∀ (B' : Type u) [CommRing B'] (u₀ : PrimeSpectrum B')
        (c_B' : k₀ →+* B')
        (φ₂ : (MvPolynomial (Fin 2) k₀ ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B'),
        φ₂.Etale →
        φ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = c_B' →
        (∀ i : Fin 2, φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ u₀.asIdeal) →
        (∀ i : Fin 2, IsDomain (B' ⧸ Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))})) →
        let B := Localization.AtPrime u₀.asIdeal
        let c_B : k₀ →+* B := (algebraMap B' B).comp c_B'
        let b : Fin 2 → B := fun i => algebraMap B' B (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)))
        u₀.asIdeal.IsMaximal ∧
        (b 0 * b 1 = 0 ∧ b 0 ≠ 0 ∧ b 1 ≠ 0) ∧
        (Ideal.span {b 0} : Ideal B) ⊓ Ideal.span {b 1} = ⊥ ∧
        IsLocalRing.maximalIdeal B = Ideal.span ({b 0, b 1} : Set B) ∧
        ¬ Submodule.IsPrincipal (IsLocalRing.maximalIdeal B) ∧
        (∀ i : Fin 2, ∃ (_ : IsDomain (B ⧸ Ideal.span {b i})),
          IsDiscreteValuationRing (B ⧸ Ideal.span {b i})) ∧
        (∃ ρ_B : B →+* k₀,
          ρ_B.comp c_B = RingHom.id k₀ ∧
          RingHom.ker ρ_B = IsLocalRing.maximalIdeal B ∧
          ∀ y₀ y₁ : B, ρ_B y₀ = ρ_B y₁ →
            ∃ y : B,
              Ideal.Quotient.mk (Ideal.span {b 0}) y = Ideal.Quotient.mk (Ideal.span {b 0}) y₀ ∧
              Ideal.Quotient.mk (Ideal.span {b 1}) y = Ideal.Quotient.mk (Ideal.span {b 1}) y₁) := by
    intro B' _ u₀ c_B' φ₂ hEt₂ hComp₂ hOrig hDom
    classical
    have hAbstract : ∀ (A₀ : Type u) [CommRing A₀] (u : Fin 2 → A₀) (c_A : k₀ →+* A₀)
        (φ : A₀ →+* B'),
        u 0 * u 1 = 0 →
        (Ideal.span {u 0} : Ideal A₀) ⊓ Ideal.span {u 1} = ⊥ →
        Function.Bijective ((Ideal.Quotient.mk (Ideal.span ({u 0, u 1} : Set A₀))).comp c_A) →
        (∀ i : Fin 2, ∃ e_i : Polynomial k₀ →+* (A₀ ⧸ Ideal.span ({u i} : Set A₀)),
          Function.Bijective e_i) →
        φ.Etale →
        φ.comp c_A = c_B' →
        (∀ i : Fin 2, φ (u i) ∈ u₀.asIdeal) →
        (∀ i : Fin 2, IsDomain (B' ⧸ Ideal.span {φ (u i)})) →
        let B := Localization.AtPrime u₀.asIdeal
        let c_B : k₀ →+* B := (algebraMap B' B).comp c_B'
        let b : Fin 2 → B := fun i => algebraMap B' B (φ (u i))
        u₀.asIdeal.IsMaximal ∧
        (b 0 * b 1 = 0 ∧ b 0 ≠ 0 ∧ b 1 ≠ 0) ∧
        (Ideal.span {b 0} : Ideal B) ⊓ Ideal.span {b 1} = ⊥ ∧
        IsLocalRing.maximalIdeal B = Ideal.span ({b 0, b 1} : Set B) ∧
        ¬ Submodule.IsPrincipal (IsLocalRing.maximalIdeal B) ∧
        (∀ i : Fin 2, ∃ (_ : IsDomain (B ⧸ Ideal.span {b i})),
          IsDiscreteValuationRing (B ⧸ Ideal.span {b i})) ∧
        (∃ ρ_B : B →+* k₀,
          ρ_B.comp c_B = RingHom.id k₀ ∧
          RingHom.ker ρ_B = IsLocalRing.maximalIdeal B ∧
          ∀ y₀ y₁ : B, ρ_B y₀ = ρ_B y₁ →
            ∃ y : B,
              Ideal.Quotient.mk (Ideal.span {b 0}) y = Ideal.Quotient.mk (Ideal.span {b 0}) y₀ ∧
              Ideal.Quotient.mk (Ideal.span {b 1}) y = Ideal.Quotient.mk (Ideal.span {b 1}) y₁) := by
      intro A₀ _ u c_A φ hu_mul hInfA hBij_e₀₁ hBij_ei_ex hEtφ hCompφ hOrigφ hDomφ
      letI : Algebra A₀ B' := φ.toAlgebra
      haveI : Algebra.Etale A₀ B' := hEtφ
      haveI : u₀.asIdeal.IsPrime := u₀.isPrime
      let x : Fin 2 → B' := fun i => φ (u i)
      let B := Localization.AtPrime u₀.asIdeal
      let c_B : k₀ →+* B := (algebraMap B' B).comp c_B'
      let b : Fin 2 → B := fun i => algebraMap B' B (x i)

      have hb_mul : b 0 * b 1 = 0 := by
        dsimp [b, x]
        rw [← map_mul, ← map_mul, hu_mul, map_zero, map_zero]

      have hInfB : (Ideal.span {b 0} : Ideal B) ⊓ Ideal.span {b 1} = ⊥ := by
        haveI : Module.Flat A₀ B := Module.Flat.trans A₀ B' B
        let Q₀ := A₀ ⧸ (Ideal.span {u 0} : Ideal A₀)
        let Q₁ := A₀ ⧸ (Ideal.span {u 1} : Ideal A₀)
        let f_lin : A₀ →ₗ[A₀] Q₀ × Q₁ :=
          (Ideal.Quotient.mkₐ A₀ (Ideal.span {u 0})).toLinearMap.prod
            (Ideal.Quotient.mkₐ A₀ (Ideal.span {u 1})).toLinearMap
        have hInj_f : Function.Injective f_lin := by
          rw [injective_iff_map_eq_zero]
          intro a ha
          have ha₀ : Ideal.Quotient.mk (Ideal.span {u 0}) a = 0 := congrArg Prod.fst ha
          have ha₁ : Ideal.Quotient.mk (Ideal.span {u 1}) a = 0 := congrArg Prod.snd ha
          have hMem : a ∈ (Ideal.span {u 0} : Ideal A₀) ⊓ Ideal.span {u 1} :=
            ⟨Ideal.Quotient.eq_zero_iff_mem.mp ha₀, Ideal.Quotient.eq_zero_iff_mem.mp ha₁⟩
          rwa [hInfA, Ideal.mem_bot] at hMem
        have hInj_lT : Function.Injective (LinearMap.lTensor B f_lin) :=
          Module.Flat.lTensor_preserves_injective_linearMap f_lin hInj_f
        rw [eq_bot_iff]
        intro y hy
        obtain ⟨hy₀, hy₁⟩ := Ideal.mem_inf.mp hy
        rw [Ideal.mem_bot]
        rw [Ideal.mem_span_singleton] at hy₀ hy₁
        rcases hy₀ with ⟨d₀, hd₀⟩
        rcases hy₁ with ⟨d₁, hd₁⟩
        let PR := TensorProduct.prodRight A₀ A₀ B Q₀ Q₁
        have hZeroPR : PR (LinearMap.lTensor B f_lin (y ⊗ₜ[A₀] (1 : A₀))) = 0 := by
          apply Prod.ext
          · change y ⊗ₜ[A₀] (Ideal.Quotient.mk (Ideal.span {u 0}) 1) = 0
            have hy₀' : y = u 0 • d₀ := by
              rw [Algebra.smul_def, IsScalarTower.algebraMap_apply A₀ B' B (u 0)]
              exact hd₀
            rw [hy₀', TensorProduct.smul_tmul, Algebra.smul_def, map_one, mul_one]
            have hmk0 : (algebraMap A₀ (A₀ ⧸ Ideal.span {u 0})) (u 0) = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
            rw [hmk0, TensorProduct.tmul_zero]
          · change y ⊗ₜ[A₀] (Ideal.Quotient.mk (Ideal.span {u 1}) 1) = 0
            have hy₁' : y = u 1 • d₁ := by
              rw [Algebra.smul_def, IsScalarTower.algebraMap_apply A₀ B' B (u 1)]
              exact hd₁
            rw [hy₁', TensorProduct.smul_tmul, Algebra.smul_def, map_one, mul_one]
            have hmk1 : (algebraMap A₀ (A₀ ⧸ Ideal.span {u 1})) (u 1) = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
            rw [hmk1, TensorProduct.tmul_zero]
        have hTmulZero : y ⊗ₜ[A₀] (1 : A₀) = 0 :=
          hInj_lT (PR.injective (hZeroPR.trans (map_zero PR).symm))
        have hRid := congrArg (TensorProduct.rid A₀ B) hTmulZero
        simpa using hRid

      have hQuotEtale : ∀ (R₀ : Type u) [CommRing R₀] (I : Ideal A₀)
          (e₀ : R₀ →+* (A₀ ⧸ I)),
          Function.Bijective e₀ →
          ((Ideal.quotientMap (Ideal.map φ I) φ Ideal.le_comap_map).comp e₀).Etale := by
        intro R₀ _ I e₀ he₀
        let J : Ideal B' := Ideal.map (algebraMap A₀ B') I
        let g_I : (A₀ ⧸ I) →+* (B' ⧸ J) := Ideal.quotientMap J φ Ideal.le_comap_map
        letI : Algebra (A₀ ⧸ I) (B' ⧸ J) := g_I.toAlgebra
        haveI : Algebra.Etale (A₀ ⧸ I) (TensorProduct A₀ (A₀ ⧸ I) B') :=
          Algebra.Etale.baseChange A₀ B' (A₀ ⧸ I)
        let E_ring : TensorProduct A₀ (A₀ ⧸ I) B' ≃+* (B' ⧸ J) :=
          ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B' I).toRingEquiv.trans
            (Algebra.TensorProduct.comm A₀ B' (A₀ ⧸ I)).toRingEquiv).symm
        let E_alg : TensorProduct A₀ (A₀ ⧸ I) B' ≃ₐ[A₀ ⧸ I] (B' ⧸ J) :=
          { E_ring with
            commutes' := fun w => by
              obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective w
              change E_ring (Ideal.Quotient.mk I a ⊗ₜ[A₀] (1 : B')) = Ideal.Quotient.mk J (φ a)
              have hSymm : E_ring.symm (Ideal.Quotient.mk J (φ a)) =
                  Ideal.Quotient.mk I a ⊗ₜ[A₀] (1 : B') := by
                dsimp [E_ring]
                change (Algebra.TensorProduct.comm A₀ B' (A₀ ⧸ I))
                  ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B' I)
                    (Ideal.Quotient.mk (Ideal.map (algebraMap A₀ B') I) (φ a))) = _
                rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
                change (1 : A₀ ⧸ I) ⊗ₜ[A₀] φ a = Ideal.Quotient.mk I a ⊗ₜ[A₀] (1 : B')
                have hφ : φ a = a • (1 : B') := by
                  rw [Algebra.smul_def, mul_one]
                  rfl
                rw [hφ, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
                rfl
              rw [← hSymm, E_ring.apply_symm_apply] }
        haveI : Algebra.Etale (A₀ ⧸ I) (B' ⧸ J) := Algebra.Etale.of_equiv E_alg
        letI : Algebra R₀ (A₀ ⧸ I) := e₀.toAlgebra
        letI : Algebra R₀ (B' ⧸ J) := (g_I.comp e₀).toAlgebra
        haveI : IsScalarTower R₀ (A₀ ⧸ I) (B' ⧸ J) := IsScalarTower.of_algebraMap_eq' rfl
        haveI : Algebra.Etale R₀ (A₀ ⧸ I) := RingHom.Etale.of_bijective he₀
        exact Algebra.Etale.comp R₀ (A₀ ⧸ I) (B' ⧸ J)

      let I₀₁ : Ideal A₀ := Ideal.span ({u 0, u 1} : Set A₀)
      let e₀₁ : k₀ →+* (A₀ ⧸ I₀₁) := (Ideal.Quotient.mk I₀₁).comp c_A
      let J₀₁ : Ideal B' := Ideal.map φ I₀₁
      let c_quot₀₁ : k₀ →+* (B' ⧸ J₀₁) :=
        (Ideal.quotientMap J₀₁ φ Ideal.le_comap_map).comp e₀₁
      have hEt_k₀ : c_quot₀₁.Etale := hQuotEtale k₀ I₀₁ e₀₁ hBij_e₀₁
      letI : Algebra k₀ (B' ⧸ J₀₁) := c_quot₀₁.toAlgebra
      haveI : Algebra.Etale k₀ (B' ⧸ J₀₁) := hEt_k₀
      haveI : Module.Finite k₀ (B' ⧸ J₀₁) := Module.Finite.of_quasiFinite
      haveI : IsArtinianRing (B' ⧸ J₀₁) := isArtinian_of_tower k₀ inferInstance
      have hJ₀₁_le : J₀₁ ≤ u₀.asIdeal := by
        dsimp [J₀₁, I₀₁]
        rw [Ideal.map_span, Ideal.span_le]
        rintro _ ⟨w, rfl | rfl, rfl⟩
        · exact hOrigφ 0
        · exact hOrigφ 1
      let π₀₁ : B' →+* (B' ⧸ J₀₁) := Ideal.Quotient.mk J₀₁
      let q₀₁ : Ideal (B' ⧸ J₀₁) := Ideal.map π₀₁ u₀.asIdeal
      have hComap_q₀₁ : Ideal.comap π₀₁ q₀₁ = u₀.asIdeal := by
        rw [Ideal.comap_map_of_surjective' π₀₁ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
        exact sup_eq_left.mpr hJ₀₁_le
      haveI : q₀₁.IsPrime := by
        refine Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective ?_
        rw [Ideal.mk_ker]
        exact hJ₀₁_le
      haveI : q₀₁.IsMaximal := IsArtinianRing.isMaximal_of_isPrime q₀₁
      have hMaxU₀ : u₀.asIdeal.IsMaximal := by
        rw [← hComap_q₀₁]
        exact Ideal.comap_isMaximal_of_surjective π₀₁ Ideal.Quotient.mk_surjective

      have hBij_resB' : Function.Bijective ((Ideal.Quotient.mk u₀.asIdeal).comp c_B') := by
        let f_res : (B' ⧸ J₀₁) →+* (B' ⧸ u₀.asIdeal) := Ideal.Quotient.factor hJ₀₁_le
        have hSurj_fres : Function.Surjective f_res := Ideal.Quotient.factor_surjective hJ₀₁_le
        have hc_eq : (Ideal.Quotient.mk u₀.asIdeal).comp c_B' = f_res.comp c_quot₀₁ := by
          ext c
          dsimp [c_quot₀₁, e₀₁, f_res]
          rw [← hCompφ]
          rfl
        rw [hc_eq]
        letI : Algebra k₀ (B' ⧸ u₀.asIdeal) := (f_res.comp c_quot₀₁).toAlgebra
        let f_alg : (B' ⧸ J₀₁) →ₐ[k₀] (B' ⧸ u₀.asIdeal) :=
          { toRingHom := f_res, commutes' := fun _ => rfl }
        haveI : Module.Finite k₀ (B' ⧸ u₀.asIdeal) :=
          Module.Finite.of_surjective f_alg.toLinearMap hSurj_fres
        haveI : Algebra.IsIntegral k₀ (B' ⧸ u₀.asIdeal) :=
          Algebra.IsIntegral.of_finite k₀ (B' ⧸ u₀.asIdeal)
        haveI : IsDomain (B' ⧸ u₀.asIdeal) := Ideal.Quotient.isDomain u₀.asIdeal
        exact IsAlgClosed.algebraMap_bijective_of_isIntegral
      let θ_res : k₀ ≃+* (B' ⧸ u₀.asIdeal) :=
        RingEquiv.ofBijective ((Ideal.Quotient.mk u₀.asIdeal).comp c_B') hBij_resB'
      let ev_u₀ : B' →+* k₀ := θ_res.symm.toRingHom.comp (Ideal.Quotient.mk u₀.asIdeal)
      have hev_c : ev_u₀.comp c_B' = RingHom.id k₀ := by
        ext c
        exact θ_res.symm_apply_apply c
      have hKer_evu₀ : RingHom.ker ev_u₀ = u₀.asIdeal := by
        ext r
        change θ_res.symm (Ideal.Quotient.mk u₀.asIdeal r) = 0 ↔ r ∈ u₀.asIdeal
        rw [← map_zero θ_res.symm, θ_res.symm.injective.eq_iff, Ideal.Quotient.eq_zero_iff_mem]
      have hUnits_ev : ∀ s : u₀.asIdeal.primeCompl, IsUnit (ev_u₀ s) := by
        intro s
        refine IsUnit.mk0 (ev_u₀ s) ?_
        intro h0
        have hsMem : (s : B') ∈ RingHom.ker ev_u₀ := h0
        rw [hKer_evu₀] at hsMem
        exact s.2 hsMem
      let ρ_B : B →+* k₀ := IsLocalization.lift (M := u₀.asIdeal.primeCompl) (S := B) hUnits_ev
      have hρ_c : ρ_B.comp c_B = RingHom.id k₀ := by
        ext c
        dsimp [ρ_B, c_B]
        rw [IsLocalization.lift_eq]
        exact RingHom.congr_fun hev_c c
      have hKer_ρ : RingHom.ker ρ_B = IsLocalRing.maximalIdeal B := by
        apply le_antisymm
        · have _hPr : (RingHom.ker ρ_B).IsPrime := RingHom.ker_isPrime ρ_B
          exact IsLocalRing.le_maximalIdeal _hPr.ne_top
        · intro z hz
          obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj u₀.asIdeal.primeCompl z
          dsimp only at hrs
          have hrMem : r ∈ u₀.asIdeal := by
            have hzs : z * algebraMap B' B s ∈ IsLocalRing.maximalIdeal B :=
              Ideal.mul_mem_right _ _ hz
            rw [hrs] at hzs
            exact (IsLocalization.AtPrime.to_map_mem_maximal_iff B u₀.asIdeal r).mp hzs
          have hrKer : ev_u₀ r = 0 := by
            rw [← RingHom.mem_ker, hKer_evu₀]
            exact hrMem
          have hρ_rs : ρ_B (z * algebraMap B' B s) = 0 := by
            rw [hrs, IsLocalization.lift_eq]
            exact hrKer
          rw [map_mul, IsLocalization.lift_eq] at hρ_rs
          exact (mul_eq_zero.mp hρ_rs).resolve_right (hUnits_ev s).ne_zero

      have hBranchDVR : ∀ i : Fin 2, ∃ (_ : IsDomain (B ⧸ Ideal.span {b i})),
          IsDiscreteValuationRing (B ⧸ Ideal.span {b i}) := by
        intro i
        obtain ⟨e_i, hBij_ei⟩ := hBij_ei_ex i
        let I_i : Ideal A₀ := Ideal.span ({u i} : Set A₀)
        let J_i : Ideal B' := Ideal.map φ I_i
        have hJi_eq : J_i = Ideal.span {x i} := by
          dsimp [J_i, I_i, x]
          rw [Ideal.map_span, Set.image_singleton]
        let B'_i := B' ⧸ J_i
        haveI : IsDomain B'_i := by
          have hD := hDomφ i
          exact Function.Injective.isDomain
            (Ideal.quotEquivOfEq hJi_eq).toRingHom (Ideal.quotEquivOfEq hJi_eq).injective
        let θ_i : Polynomial k₀ →+* B'_i :=
          (Ideal.quotientMap J_i φ Ideal.le_comap_map).comp e_i
        have hEt_θi : θ_i.Etale := hQuotEtale (Polynomial k₀) I_i e_i hBij_ei
        letI : Algebra (Polynomial k₀) B'_i := θ_i.toAlgebra
        haveI : Algebra.Etale (Polynomial k₀) B'_i := hEt_θi
        have hJi_le : J_i ≤ u₀.asIdeal := by
          rw [hJi_eq, Ideal.span_le, Set.singleton_subset_iff]
          exact hOrigφ i
        let mk_Bi : B' →+* B'_i := Ideal.Quotient.mk J_i
        let 𝔫_i : Ideal B'_i := Ideal.map mk_Bi u₀.asIdeal
        have hComap_𝔫i : Ideal.comap mk_Bi 𝔫_i = u₀.asIdeal := by
          rw [Ideal.comap_map_of_surjective' mk_Bi Ideal.Quotient.mk_surjective, Ideal.mk_ker]
          exact sup_eq_left.mpr hJi_le
        haveI : 𝔫_i.IsMaximal := by
          rw [Ideal.isMaximal_iff]
          refine ⟨?_, ?_⟩
          · intro h1
            have h1' : (1 : B') ∈ Ideal.comap mk_Bi 𝔫_i := h1
            rw [hComap_𝔫i] at h1'
            exact hMaxU₀.ne_top (Ideal.eq_top_of_isUnit_mem _ h1' isUnit_one)
          · intro K x_K h𝔫K hx𝔫 hxK
            obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x_K
            have hrNot : r ∉ u₀.asIdeal := by
              rw [← hComap_𝔫i]
              exact hx𝔫
            have hu_le : u₀.asIdeal ≤ Ideal.comap mk_Bi K := by
              rw [← hComap_𝔫i]
              exact Ideal.comap_mono h𝔫K
            exact (Ideal.isMaximal_iff.mp hMaxU₀).2 (Ideal.comap mk_Bi K) r hu_le hrNot hxK
        haveI : IsDiscreteValuationRing (Localization.AtPrime 𝔫_i) :=
          (hEtDVR B'_i).2 𝔫_i |>.2
        let L_i := Localization.AtPrime 𝔫_i
        let toL_B' : B' →+* L_i := (algebraMap B'_i L_i).comp mk_Bi
        have hUnits_toL : ∀ s : u₀.asIdeal.primeCompl, IsUnit (toL_B' s) := by
          intro s
          have hs_𝔫 : mk_Bi s ∉ 𝔫_i := by
            rw [← Ideal.mem_comap, hComap_𝔫i]
            exact s.2
          exact IsLocalization.map_units L_i (⟨mk_Bi s, hs_𝔫⟩ : 𝔫_i.primeCompl)
        let toL_B : B →+* L_i := IsLocalization.lift (M := u₀.asIdeal.primeCompl) (S := B) hUnits_toL
        have hKer_toLB : Ideal.span ({b i} : Set B) ≤ RingHom.ker toL_B := by
          rw [Ideal.span_le, Set.singleton_subset_iff]
          change toL_B (algebraMap B' B (x i)) = 0
          rw [IsLocalization.lift_eq]
          change algebraMap B'_i L_i (Ideal.Quotient.mk J_i (x i)) = 0
          have hxMem : x i ∈ J_i := by
            rw [hJi_eq]
            exact Ideal.subset_span rfl
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr hxMem, map_zero]
        let fwd_i : (B ⧸ Ideal.span {b i}) →+* L_i :=
          Ideal.Quotient.lift (Ideal.span {b i}) toL_B hKer_toLB
        let mk_b : B →+* (B ⧸ Ideal.span {b i}) := Ideal.Quotient.mk (Ideal.span {b i})
        have hKer_bwd0 : J_i ≤ RingHom.ker (mk_b.comp (algebraMap B' B)) := by
          rw [hJi_eq, Ideal.span_le, Set.singleton_subset_iff]
          change mk_b (b i) = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        let bwd_Bi : B'_i →+* (B ⧸ Ideal.span {b i}) :=
          Ideal.Quotient.lift J_i (mk_b.comp (algebraMap B' B)) hKer_bwd0
        have hUnits_bwd : ∀ t : 𝔫_i.primeCompl, IsUnit (bwd_Bi t.1) := by
          intro ⟨t, ht⟩
          obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective t
          have hs : s ∉ u₀.asIdeal := by
            rw [← hComap_𝔫i]
            exact ht
          have hUnitB : IsUnit (algebraMap B' B s) :=
            IsLocalization.map_units B (⟨s, hs⟩ : u₀.asIdeal.primeCompl)
          exact hUnitB.map mk_b
        let bwd_i : L_i →+* (B ⧸ Ideal.span {b i}) :=
          IsLocalization.lift (M := 𝔫_i.primeCompl) (S := L_i) hUnits_bwd
        have hLeft_i : ∀ z : B ⧸ Ideal.span {b i}, bwd_i (fwd_i z) = z := by
          intro z
          obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
          obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj u₀.asIdeal.primeCompl y
          dsimp only at hrs
          have hUnitQ : IsUnit (mk_b (algebraMap B' B s)) :=
            (IsLocalization.map_units B s).map mk_b
          apply hUnitQ.mul_right_cancel
          have hEqS : mk_b (algebraMap B' B s) =
              bwd_i (fwd_i (mk_b (algebraMap B' B s))) := by
            have hFwdS : fwd_i (mk_b (algebraMap B' B s)) = algebraMap B'_i L_i (mk_Bi s) := by
              change toL_B (algebraMap B' B s) = _
              rw [IsLocalization.lift_eq]
              rfl
            rw [hFwdS, IsLocalization.lift_eq]
            rfl
          have hLHS : bwd_i (fwd_i (mk_b y)) * mk_b (algebraMap B' B s) =
              bwd_i (fwd_i (mk_b (y * algebraMap B' B s))) := by
            conv_lhs => rhs; rw [hEqS]
            rw [← map_mul, ← map_mul, ← map_mul]
          change bwd_i (fwd_i (mk_b y)) * mk_b (algebraMap B' B s) =
            mk_b y * mk_b (algebraMap B' B s)
          rw [hLHS, ← map_mul mk_b, hrs]
          change bwd_i (toL_B (algebraMap B' B r)) = mk_b (algebraMap B' B r)
          rw [IsLocalization.lift_eq]
          change bwd_i (algebraMap B'_i L_i (mk_Bi r)) = mk_b (algebraMap B' B r)
          rw [IsLocalization.lift_eq]
          rfl
        have hRight_i : ∀ w : L_i, fwd_i (bwd_i w) = w := by
          intro w
          obtain ⟨⟨t, s⟩, hts⟩ := IsLocalization.surj 𝔫_i.primeCompl w
          dsimp only at hts
          obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective t
          obtain ⟨s₀, hs₀_eq⟩ := Ideal.Quotient.mk_surjective s.1
          have hUnitL : IsUnit (algebraMap B'_i L_i s.1) := IsLocalization.map_units L_i s
          apply hUnitL.mul_right_cancel
          have hEqS : fwd_i (bwd_i (algebraMap B'_i L_i s.1)) = algebraMap B'_i L_i s.1 := by
            rw [IsLocalization.lift_eq, ← hs₀_eq]
            change fwd_i (mk_b (algebraMap B' B s₀)) = _
            change toL_B (algebraMap B' B s₀) = _
            rw [IsLocalization.lift_eq]
            change algebraMap B'_i L_i (mk_Bi s₀) = _
            rw [hs₀_eq]
          have hLHS : fwd_i (bwd_i w) * algebraMap B'_i L_i s.1 =
              fwd_i (bwd_i (w * algebraMap B'_i L_i s.1)) := by
            rw [map_mul bwd_i, map_mul fwd_i, hEqS]
          rw [hLHS, hts, IsLocalization.lift_eq]
          change toL_B (algebraMap B' B r) = algebraMap B'_i L_i (mk_Bi r)
          rw [IsLocalization.lift_eq]
          rfl
        let Φ_i : (B ⧸ Ideal.span {b i}) ≃+* L_i :=
          { toFun := fwd_i
            invFun := bwd_i
            left_inv := hLeft_i
            right_inv := hRight_i
            map_mul' := fwd_i.map_mul
            map_add' := fwd_i.map_add }
        have hDomQi : IsDomain (B ⧸ Ideal.span {b i}) :=
          Function.Injective.isDomain Φ_i.toRingHom Φ_i.injective
        letI : IsDomain (B ⧸ Ideal.span {b i}) := hDomQi
        haveI : IsPrincipalIdealRing (B ⧸ Ideal.span {b i}) :=
          IsPrincipalIdealRing.of_surjective Φ_i.symm.toRingHom Φ_i.symm.surjective
        haveI : IsLocalRing (B ⧸ Ideal.span {b i}) := Φ_i.symm.isLocalRing
        have hMaxNeBot_Qi : IsLocalRing.maximalIdeal (B ⧸ Ideal.span {b i}) ≠ ⊥ := by
          have hMaxLi : IsLocalRing.maximalIdeal L_i ≠ ⊥ :=
            IsDiscreteValuationRing.not_a_field'
          obtain ⟨m, hmMax, hm0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hMaxLi
          have hmNotUnit : ¬ IsUnit m := fun hu =>
            (IsLocalRing.notMem_maximalIdeal.mpr hu) hmMax
          have hSymmNotUnit : ¬ IsUnit (Φ_i.symm m) :=
            fun hu => hmNotUnit (by simpa using hu.map Φ_i.toRingHom)
          have hSymmMax : Φ_i.symm m ∈ IsLocalRing.maximalIdeal (B ⧸ Ideal.span {b i}) := by
            by_contra hNotMem
            exact hSymmNotUnit (IsLocalRing.notMem_maximalIdeal.mp hNotMem)
          have hSymmNe0 : Φ_i.symm m ≠ 0 :=
            fun h0 => hm0 (by simpa using congrArg Φ_i h0)
          intro hBot
          rw [hBot, Ideal.mem_bot] at hSymmMax
          exact hSymmNe0 hSymmMax
        exact ⟨hDomQi, IsDiscreteValuationRing.mk hMaxNeBot_Qi⟩

      have hMaxB_eq : IsLocalRing.maximalIdeal B = Ideal.span ({b 0, b 1} : Set B) := by
        let p_nod : Ideal A₀ := Ideal.comap φ u₀.asIdeal
        haveI : p_nod.IsPrime := Ideal.comap_isPrime φ u₀.asIdeal
        have hp_nod_eq : p_nod = I₀₁ := by
          have hMaxI₀₁ : I₀₁.IsMaximal := by
            let _instFieldQ : Field (A₀ ⧸ I₀₁) :=
              (RingEquiv.ofBijective e₀₁ hBij_e₀₁).symm.toMulEquiv.isField
                (Field.toIsField k₀) |>.toField
            exact Ideal.Quotient.maximal_of_isField I₀₁ (Field.toIsField (A₀ ⧸ I₀₁))
          have hLe : I₀₁ ≤ p_nod := by
            dsimp [I₀₁, p_nod]
            rw [Ideal.span_le]
            rintro _ (rfl | rfl)
            · exact hOrigφ 0
            · exact hOrigφ 1
          exact (hMaxI₀₁.eq_of_le ‹p_nod.IsPrime›.ne_top hLe).symm
        let A_loc := Localization.AtPrime p_nod
        let f_nod : A_loc →+* B := Localization.localRingHom p_nod u₀.asIdeal φ rfl
        letI : Algebra A_loc B := f_nod.toAlgebra
        haveI : IsScalarTower A₀ A_loc B := by
          refine IsScalarTower.of_algebraMap_eq fun a => ?_
          rw [IsScalarTower.algebraMap_apply A₀ B' B a]
          change algebraMap B' B (φ a) = f_nod (algebraMap A₀ A_loc a)
          exact (Localization.localRingHom_to_map p_nod u₀.asIdeal φ rfl a).symm
        haveI : IsLocalHom (algebraMap A_loc B) :=
          Localization.isLocalHom_localRingHom p_nod u₀.asIdeal φ rfl
        haveI : Algebra.EssFiniteType A₀ B :=
          Algebra.EssFiniteType.comp A₀ B' B
        haveI : Algebra.EssFiniteType A_loc B :=
          Algebra.EssFiniteType.of_comp A₀ A_loc B
        have hUnramAB : Algebra.FormallyUnramified A₀ B :=
          Algebra.FormallyUnramified.comp A₀ B' B
        haveI : Algebra.FormallyUnramified A_loc B := by
          rw [Algebra.FormallyUnramified.iff_comp_injective (R := A_loc) (A := B)]
          intro R_t _ _ I_t hI_t g₁ g₂ hEq
          letI : Algebra A₀ R_t :=
            ((algebraMap A_loc R_t).comp (algebraMap A₀ A_loc)).toAlgebra
          haveI : IsScalarTower A₀ A_loc R_t :=
            IsScalarTower.of_algebraMap_eq' rfl
          have hEq' : (Ideal.Quotient.mkₐ A₀ I_t).comp (g₁.restrictScalars A₀) =
              (Ideal.Quotient.mkₐ A₀ I_t).comp (g₂.restrictScalars A₀) := by
            apply AlgHom.ext
            intro r
            exact AlgHom.congr_fun hEq r
          have hg := (Algebra.FormallyUnramified.iff_comp_injective
            (R := A₀) (A := B)).mp hUnramAB I_t hI_t hEq'
          apply AlgHom.ext
          intro r
          exact AlgHom.congr_fun hg r
        have hMapMax : Ideal.map (algebraMap A_loc B) (IsLocalRing.maximalIdeal A_loc) =
            IsLocalRing.maximalIdeal B :=
          Algebra.FormallyUnramified.map_maximalIdeal
        have hMaxAloc : Ideal.map (algebraMap A₀ A_loc) p_nod = IsLocalRing.maximalIdeal A_loc :=
          IsLocalization.AtPrime.map_eq_maximalIdeal p_nod A_loc
        have hMapPnod : Ideal.map (algebraMap A₀ A_loc) p_nod =
            Ideal.span {algebraMap A₀ A_loc (u 0), algebraMap A₀ A_loc (u 1)} :=
          (congrArg (Ideal.map (algebraMap A₀ A_loc)) hp_nod_eq).trans
            (by dsimp [I₀₁]; rw [Ideal.map_span, Set.image_pair])
        rw [← hMapMax, ← hMaxAloc, hMapPnod, Ideal.map_span, Set.image_pair]
        have h0 : algebraMap A_loc B (algebraMap A₀ A_loc (u 0)) = b 0 :=
          Localization.localRingHom_to_map p_nod u₀.asIdeal φ rfl (u 0)
        have h1 : algebraMap A_loc B (algebraMap A₀ A_loc (u 1)) = b 1 :=
          Localization.localRingHom_to_map p_nod u₀.asIdeal φ rfl (u 1)
        rw [h0, h1]

      have hb_ne : ∀ i : Fin 2, b i ≠ 0 := by
        intro i hbi0
        let j : Fin 2 := if i = 0 then 1 else 0
        obtain ⟨hDomQj, hDVRQj⟩ := hBranchDVR j
        letI : IsDomain (B ⧸ Ideal.span {b j}) := hDomQj
        letI : IsDiscreteValuationRing (B ⧸ Ideal.span {b j}) := hDVRQj
        have hNotFieldQj : ¬ IsField (B ⧸ Ideal.span {b j}) :=
          IsDiscreteValuationRing.not_isField (B ⧸ Ideal.span {b j})
        have hFieldQj : IsField (B ⧸ Ideal.span {b j}) := by
          have hMaxSpan : IsLocalRing.maximalIdeal B = Ideal.span ({b j} : Set B) := by
            fin_cases i
            · dsimp [j] at *; rw [hMaxB_eq, hbi0]; simp
            · dsimp [j] at *; rw [hMaxB_eq, hbi0]; simp
          haveI : (Ideal.span ({b j} : Set B)).IsMaximal :=
            hMaxSpan ▸ IsLocalRing.maximalIdeal.isMaximal B
          let _f := Ideal.Quotient.field (Ideal.span ({b j} : Set B))
          exact Field.toIsField (B ⧸ Ideal.span {b j})
        exact hNotFieldQj hFieldQj

      have hNotPrinc : ¬ Submodule.IsPrincipal (IsLocalRing.maximalIdeal B) := by
        rintro ⟨⟨t, ht⟩⟩
        have hSpanT : IsLocalRing.maximalIdeal B = Ideal.span {t} := ht
        have hb0_mem : b 0 ∈ Ideal.span {t} := by
          rw [← hSpanT, hMaxB_eq]
          exact Ideal.subset_span (by simp)
        have hb1_mem : b 1 ∈ Ideal.span {t} := by
          rw [← hSpanT, hMaxB_eq]
          exact Ideal.subset_span (by simp)
        have ht_mem : t ∈ Ideal.span ({b 0, b 1} : Set B) := by
          rw [← hMaxB_eq, hSpanT]
          exact Ideal.subset_span rfl
        rw [Ideal.mem_span_singleton] at hb0_mem hb1_mem
        rcases hb0_mem with ⟨w₀, hw₀⟩
        rcases hb1_mem with ⟨w₁, hw₁⟩
        rcases Ideal.mem_span_pair.mp ht_mem with ⟨d₀, d₁, hd⟩
        have ht_ne : t ≠ 0 := by
          intro ht0
          rw [ht0, zero_mul] at hw₀
          exact hb_ne 0 hw₀
        have hAnn : (1 - (d₀ * w₀ + d₁ * w₁)) * t = 0 := by
          calc
            (1 - (d₀ * w₀ + d₁ * w₁)) * t = t - (d₀ * (t * w₀) + d₁ * (t * w₁)) := by ring
            _ = t - (d₀ * b 0 + d₁ * b 1) := by rw [← hw₀, ← hw₁]
            _ = 0 := by rw [hd, sub_self]
        have hNotUnit1 : ¬ IsUnit (1 - (d₀ * w₀ + d₁ * w₁)) := by
          rintro ⟨u_inv, hu_inv⟩
          apply ht_ne
          calc
            t = (↑u_inv⁻¹ * ↑u_inv) * t := by rw [Units.inv_mul, one_mul]
            _ = ↑u_inv⁻¹ * ((1 - (d₀ * w₀ + d₁ * w₁)) * t) := by rw [hu_inv, mul_assoc]
            _ = 0 := by rw [hAnn, mul_zero]
        have hMemMax : 1 - (d₀ * w₀ + d₁ * w₁) ∈ IsLocalRing.maximalIdeal B := by
          by_contra hNotMem
          exact hNotUnit1 (IsLocalRing.notMem_maximalIdeal.mp hNotMem)
        have hUnitSum : ¬ (w₀ ∈ IsLocalRing.maximalIdeal B ∧ w₁ ∈ IsLocalRing.maximalIdeal B) := by
          rintro ⟨hw₀M, hw₁M⟩
          have hSumM : d₀ * w₀ + d₁ * w₁ ∈ IsLocalRing.maximalIdeal B :=
            Ideal.add_mem _ (Ideal.mul_mem_left _ _ hw₀M) (Ideal.mul_mem_left _ _ hw₁M)
          have h1M : (1 : B) ∈ IsLocalRing.maximalIdeal B := by
            have hEq1 : (1 : B) = (1 - (d₀ * w₀ + d₁ * w₁)) + (d₀ * w₀ + d₁ * w₁) := by ring
            rw [hEq1]
            exact Ideal.add_mem _ hMemMax hSumM
          exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top
            (Ideal.eq_top_of_isUnit_mem _ h1M isUnit_one)
        by_cases hw₀M : w₀ ∈ IsLocalRing.maximalIdeal B
        · have hw₁Not : w₁ ∉ IsLocalRing.maximalIdeal B := fun hw₁M => hUnitSum ⟨hw₀M, hw₁M⟩
          obtain ⟨v₁, hv₁⟩ := IsLocalRing.notMem_maximalIdeal.mp hw₁Not
          have ht_b1 : t = b 1 * ↑v₁⁻¹ := by
            calc
              t = t * (w₁ * ↑v₁⁻¹) := by rw [← hv₁, Units.mul_inv, mul_one]
              _ = (t * w₁) * ↑v₁⁻¹ := by ring
              _ = b 1 * ↑v₁⁻¹ := by rw [← hw₁]
          have hb0_in_b1 : b 0 ∈ Ideal.span ({b 1} : Set B) := by
            rw [Ideal.mem_span_singleton]
            exact ⟨↑v₁⁻¹ * w₀, by rw [hw₀, ht_b1]; ring⟩
          have hb0_inf : b 0 ∈ (Ideal.span {b 0} : Ideal B) ⊓ Ideal.span {b 1} :=
            ⟨Ideal.subset_span rfl, hb0_in_b1⟩
          rw [hInfB, Ideal.mem_bot] at hb0_inf
          exact hb_ne 0 hb0_inf
        · obtain ⟨v₀, hv₀⟩ := IsLocalRing.notMem_maximalIdeal.mp hw₀M
          have ht_b0 : t = b 0 * ↑v₀⁻¹ := by
            calc
              t = t * (w₀ * ↑v₀⁻¹) := by rw [← hv₀, Units.mul_inv, mul_one]
              _ = (t * w₀) * ↑v₀⁻¹ := by ring
              _ = b 0 * ↑v₀⁻¹ := by rw [← hw₀]
          have hb1_in_b0 : b 1 ∈ Ideal.span ({b 0} : Set B) := by
            rw [Ideal.mem_span_singleton]
            exact ⟨↑v₀⁻¹ * w₁, by rw [hw₁, ht_b0]; ring⟩
          have hb1_inf : b 1 ∈ (Ideal.span {b 0} : Ideal B) ⊓ Ideal.span {b 1} :=
            ⟨hb1_in_b0, Ideal.subset_span rfl⟩
          rw [hInfB, Ideal.mem_bot] at hb1_inf
          exact hb_ne 1 hb1_inf

      have hGlue : ∀ y₀ y₁ : B, ρ_B y₀ = ρ_B y₁ →
          ∃ y : B,
            Ideal.Quotient.mk (Ideal.span {b 0}) y = Ideal.Quotient.mk (Ideal.span {b 0}) y₀ ∧
            Ideal.Quotient.mk (Ideal.span {b 1}) y = Ideal.Quotient.mk (Ideal.span {b 1}) y₁ := by
        intro y₀ y₁ hρEq
        have hDiffKer : y₀ - y₁ ∈ RingHom.ker ρ_B := by
          change ρ_B (y₀ - y₁) = 0
          rw [map_sub, hρEq, sub_self]
        rw [hKer_ρ, hMaxB_eq] at hDiffKer
        rcases Ideal.mem_span_pair.mp hDiffKer with ⟨d₀, d₁, hd⟩
        refine ⟨y₀ - d₀ * b 0, ?_, ?_⟩
        · apply Ideal.Quotient.eq.mpr
          rw [Ideal.mem_span_singleton]
          exact ⟨-d₀, by ring⟩
        · apply Ideal.Quotient.eq.mpr
          rw [Ideal.mem_span_singleton]
          refine ⟨d₁, ?_⟩
          calc
            y₀ - d₀ * b 0 - y₁ = (y₀ - y₁) - d₀ * b 0 := by ring
            _ = (d₀ * b 0 + d₁ * b 1) - d₀ * b 0 := by rw [← hd]
            _ = b 1 * d₁ := by ring

      exact ⟨hMaxU₀, ⟨hb_mul, hb_ne 0, hb_ne 1⟩, hInfB, hMaxB_eq, hNotPrinc, hBranchDVR,
        ⟨ρ_B, hρ_c, hKer_ρ, hGlue⟩⟩

    let I_nod : Ideal (MvPolynomial (Fin 2) k₀) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
    let u : Fin 2 → (MvPolynomial (Fin 2) k₀ ⧸ I_nod) :=
      fun i => Ideal.Quotient.mk I_nod (MvPolynomial.X i)
    let c_A : k₀ →+* (MvPolynomial (Fin 2) k₀ ⧸ I_nod) :=
      (Ideal.Quotient.mk I_nod).comp MvPolynomial.C

    have hu_mul : u 0 * u 1 = 0 := by
      change Ideal.Quotient.mk I_nod (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)

    have hInfA : (Ideal.span {u 0} : Ideal (MvPolynomial (Fin 2) k₀ ⧸ I_nod)) ⊓
        Ideal.span {u 1} = ⊥ := by
      rw [eq_bot_iff]
      intro z hz
      obtain ⟨hz₀, hz₁⟩ := Ideal.mem_inf.mp hz
      rw [Ideal.mem_bot]
      rw [Ideal.mem_span_singleton] at hz₀ hz₁
      rcases hz₀ with ⟨a₀, rfl⟩
      rcases hz₁ with ⟨a₁, hz_eq⟩
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective a₀
      let ev₀ : MvPolynomial (Fin 2) k₀ →+* MvPolynomial (Fin 2) k₀ :=
        MvPolynomial.eval₂Hom MvPolynomial.C ![MvPolynomial.X 0, 0]
      have hDiffMem : ∀ Q : MvPolynomial (Fin 2) k₀,
          MvPolynomial.X 0 * (Q - ev₀ Q) ∈ I_nod := by
        intro Q
        refine MvPolynomial.induction_on
          (motive := fun Q => MvPolynomial.X 0 * (Q - ev₀ Q) ∈ I_nod) Q ?_ ?_ ?_
        · intro c
          simp [ev₀]
        · intro p q hp hq
          have hEq : MvPolynomial.X 0 * (p + q - ev₀ (p + q)) =
              MvPolynomial.X 0 * (p - ev₀ p) + MvPolynomial.X 0 * (q - ev₀ q) := by
            rw [map_add]
            ring
          rw [hEq]
          exact Ideal.add_mem _ hp hq
        · intro p i hp
          fin_cases i
          · change MvPolynomial.X 0 * (p * MvPolynomial.X 0 - ev₀ (p * MvPolynomial.X 0)) ∈ I_nod
            have hX0 : ev₀ (MvPolynomial.X 0) = MvPolynomial.X 0 := by simp [ev₀]
            have hEq : MvPolynomial.X 0 * (p * MvPolynomial.X 0 - ev₀ (p * MvPolynomial.X 0)) =
                (MvPolynomial.X 0 * (p - ev₀ p)) * MvPolynomial.X 0 := by
              rw [map_mul, hX0]
              ring
            rw [hEq]
            exact Ideal.mul_mem_right _ _ hp
          · change MvPolynomial.X 0 * (p * MvPolynomial.X 1 - ev₀ (p * MvPolynomial.X 1)) ∈ I_nod
            have hX1 : ev₀ (MvPolynomial.X 1) = 0 := by simp [ev₀]
            have hEq : MvPolynomial.X 0 * (p * MvPolynomial.X 1 - ev₀ (p * MvPolynomial.X 1)) =
                p * (MvPolynomial.X 0 * MvPolynomial.X 1) := by
              rw [map_mul, hX1, mul_zero, sub_zero]
              ring
            rw [hEq]
            exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
      have hKerEv : I_nod ≤ RingHom.ker ev₀ := by
        rw [Ideal.span_le]
        intro f hf
        rw [Set.mem_singleton_iff] at hf
        subst hf
        change ev₀ (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
        simp [ev₀]
      let ev_bar : (MvPolynomial (Fin 2) k₀ ⧸ I_nod) →+* MvPolynomial (Fin 2) k₀ :=
        Ideal.Quotient.lift I_nod ev₀ hKerEv
      have hev_u0 : ev_bar (u 0) = MvPolynomial.X 0 := by
        change ev₀ (MvPolynomial.X 0) = MvPolynomial.X 0
        simp [ev₀]
      have hev_u1 : ev_bar (u 1) = 0 := by
        change ev₀ (MvPolynomial.X 1) = 0
        simp [ev₀]
      have hEvZero : MvPolynomial.X 0 * ev₀ P = 0 := by
        have h1 : ev_bar (u 0 * Ideal.Quotient.mk I_nod P) = MvPolynomial.X 0 * ev₀ P := by
          rw [map_mul, hev_u0]
          rfl
        have h2 : ev_bar (u 1 * a₁) = 0 := by
          rw [map_mul, hev_u1, zero_mul]
        rw [← h1, hz_eq, h2]
      have hMemNod : MvPolynomial.X 0 * P ∈ I_nod := by
        have hEq : MvPolynomial.X 0 * P =
            MvPolynomial.X 0 * (P - ev₀ P) + MvPolynomial.X 0 * ev₀ P := by ring
        rw [hEq, hEvZero, add_zero]
        exact hDiffMem P
      change Ideal.Quotient.mk I_nod (MvPolynomial.X 0 * P) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hMemNod

    have hBij_e₀₁ : Function.Bijective
        ((Ideal.Quotient.mk (Ideal.span ({u 0, u 1} : Set (MvPolynomial (Fin 2) k₀ ⧸ I_nod)))).comp c_A) := by
      let I₀₁ : Ideal (MvPolynomial (Fin 2) k₀ ⧸ I_nod) := Ideal.span {u 0, u 1}
      let e₀₁ : k₀ →+* _ := (Ideal.Quotient.mk I₀₁).comp c_A
      let ev₀₀ : MvPolynomial (Fin 2) k₀ →+* k₀ := MvPolynomial.eval 0
      have hKer₁ : I_nod ≤ RingHom.ker ev₀₀ := by
        rw [Ideal.span_le]
        intro f hf
        rw [Set.mem_singleton_iff] at hf
        subst hf
        change ev₀₀ (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
        simp [ev₀₀]
      let ev_nod := Ideal.Quotient.lift I_nod ev₀₀ hKer₁
      have hKer₂ : I₀₁ ≤ RingHom.ker ev_nod := by
        rw [Ideal.span_le]
        intro y hy
        rcases hy with rfl | rfl
        · change ev₀₀ (MvPolynomial.X 0) = 0; simp [ev₀₀]
        · change ev₀₀ (MvPolynomial.X 1) = 0; simp [ev₀₀]
      let inv₀₁ := Ideal.Quotient.lift I₀₁ ev_nod hKer₂
      have hLeft : ∀ c : k₀, inv₀₁ (e₀₁ c) = c := by
        intro c
        change ev₀₀ (MvPolynomial.C c) = c
        simp [ev₀₀]
      refine ⟨fun c₁ c₂ h => by rw [← hLeft c₁, ← hLeft c₂, h], ?_⟩
      intro w
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective w
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective a
      refine ⟨ev₀₀ P, ?_⟩
      refine MvPolynomial.induction_on
        (motive := fun Q => e₀₁ (ev₀₀ Q) = Ideal.Quotient.mk I₀₁ (Ideal.Quotient.mk I_nod Q))
        P ?_ ?_ ?_
      · intro c
        change e₀₁ (ev₀₀ (MvPolynomial.C c)) = e₀₁ c
        simp [ev₀₀]
      · intro p q hp hq
        simp only [map_add, hp, hq]
      · intro p i hp
        have hXi : Ideal.Quotient.mk I₀₁ (Ideal.Quotient.mk I_nod (MvPolynomial.X i)) = 0 := by
          apply Ideal.Quotient.eq_zero_iff_mem.mpr
          apply Ideal.subset_span
          fin_cases i <;> simp [u]
        have hEvXi : ev₀₀ (MvPolynomial.X i) = 0 := by simp [ev₀₀]
        rw [map_mul, hEvXi, mul_zero, map_zero, map_mul, map_mul, hXi]
        ring

    have hBij_ei_ex : ∀ i : Fin 2,
        ∃ e_i : Polynomial k₀ →+*
          ((MvPolynomial (Fin 2) k₀ ⧸ I_nod) ⧸ Ideal.span ({u i} : Set _)),
          Function.Bijective e_i := by
      intro i
      let j : Fin 2 := if i = 0 then 1 else 0
      have hij : j ≠ i := by fin_cases i <;> decide
      have hCases : ∀ k : Fin 2, k = i ∨ k = j := by
        intro k; fin_cases i <;> fin_cases k <;> decide
      let I_i : Ideal (MvPolynomial (Fin 2) k₀ ⧸ I_nod) := Ideal.span {u i}
      let e_i : Polynomial k₀ →+* _ :=
        Polynomial.eval₂RingHom ((Ideal.Quotient.mk I_i).comp c_A) (Ideal.Quotient.mk I_i (u j))
      refine ⟨e_i, ?_⟩
      let ev_poly : MvPolynomial (Fin 2) k₀ →+* Polynomial k₀ :=
        MvPolynomial.eval₂Hom Polynomial.C (fun k => if k = i then 0 else Polynomial.X)
      have hKerN : I_nod ≤ RingHom.ker ev_poly := by
        rw [Ideal.span_le]
        intro f hf
        rw [Set.mem_singleton_iff] at hf
        subst hf
        change ev_poly (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
        fin_cases i <;> simp [ev_poly]
      let ev_A := Ideal.Quotient.lift I_nod ev_poly hKerN
      have hKerI : I_i ≤ RingHom.ker ev_A := by
        rw [Ideal.span_le]
        intro y hy
        rw [Set.mem_singleton_iff] at hy
        subst hy
        change ev_poly (MvPolynomial.X i) = 0
        simp [ev_poly]
      let inv_i := Ideal.Quotient.lift I_i ev_A hKerI
      have hLeft : ∀ P : Polynomial k₀, inv_i (e_i P) = P := by
        intro P
        refine Polynomial.induction_on' P ?_ ?_
        · intro p q hp hq
          rw [map_add, map_add, hp, hq]
        · intro n c
          change inv_i (Polynomial.eval₂ ((Ideal.Quotient.mk I_i).comp c_A)
            (Ideal.Quotient.mk I_i (u j)) (Polynomial.monomial n c)) = Polynomial.monomial n c
          rw [Polynomial.eval₂_monomial, map_mul, map_pow]
          have hC : inv_i (((Ideal.Quotient.mk I_i).comp c_A) c) = Polynomial.C c := by
            change ev_poly (MvPolynomial.C c) = Polynomial.C c
            simp [ev_poly]
          have hX : inv_i (Ideal.Quotient.mk I_i (u j)) = Polynomial.X := by
            change ev_poly (MvPolynomial.X j) = Polynomial.X
            simp [ev_poly, hij]
          rw [hC, hX, Polynomial.C_mul_X_pow_eq_monomial]
      refine ⟨fun P₁ P₂ h => by rw [← hLeft P₁, ← hLeft P₂, h], ?_⟩
      intro w
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective w
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective a
      refine ⟨ev_poly P, ?_⟩
      refine MvPolynomial.induction_on
        (motive := fun Q => e_i (ev_poly Q) = Ideal.Quotient.mk I_i (Ideal.Quotient.mk I_nod Q))
        P ?_ ?_ ?_
      · intro c
        change Polynomial.eval₂ ((Ideal.Quotient.mk I_i).comp c_A) (Ideal.Quotient.mk I_i (u j))
          (ev_poly (MvPolynomial.C c)) = ((Ideal.Quotient.mk I_i).comp c_A) c
        simp [ev_poly]
      · intro p q hp hq
        simp only [map_add, hp, hq]
      · intro p k hp
        rcases hCases k with hk | hk
        · subst hk
          have hUi : Ideal.Quotient.mk I_i (Ideal.Quotient.mk I_nod (MvPolynomial.X k)) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          have hEvk : ev_poly (MvPolynomial.X k) = 0 := by simp [ev_poly]
          rw [map_mul, hEvk, mul_zero, map_zero, map_mul, map_mul, hUi]
          ring
        · subst hk
          have hEvj : ev_poly (MvPolynomial.X j) = Polynomial.X := by simp [ev_poly, hij]
          have heX : e_i Polynomial.X = Ideal.Quotient.mk I_i (u j) := by
            change Polynomial.eval₂ ((Ideal.Quotient.mk I_i).comp c_A)
              (Ideal.Quotient.mk I_i (u j)) Polynomial.X = _
            simp
          rw [map_mul, hEvj, map_mul, hp, heX]
          rfl

    exact hAbstract (MvPolynomial (Fin 2) k₀ ⧸ I_nod) u c_A φ₂
      hu_mul hInfA hBij_e₀₁ hBij_ei_ex hEt₂ hComp₂ hOrig hDom

  
  have hS4 :
      ∀ (C : Type u) [CommRing C] [_root_.IsReduced C] [Algebra k₀ C] [Algebra.FiniteType k₀ C]
        (q : PrimeSpectrum C) [q.asIdeal.IsMaximal]
        (B' : Type u) [CommRing B'] (u₀ : PrimeSpectrum B') (φ₁ : C →+* B'),
        φ₁.Etale →
        PrimeSpectrum.comap φ₁ u₀ = q →
        let B := Localization.AtPrime u₀.asIdeal
        let c_B : k₀ →+* B := (algebraMap B' B).comp (φ₁.comp (algebraMap k₀ C))
        ∀ (b : Fin 2 → B),
          (b 0 * b 1 = 0 ∧ b 0 ≠ 0 ∧ b 1 ≠ 0) →
          (Ideal.span {b 0} : Ideal B) ⊓ Ideal.span {b 1} = ⊥ →
          IsLocalRing.maximalIdeal B = Ideal.span ({b 0, b 1} : Set B) →
          ¬ Submodule.IsPrincipal (IsLocalRing.maximalIdeal B) →
          (∀ i : Fin 2, ∃ (_ : IsDomain (B ⧸ Ideal.span {b i})),
            IsDiscreteValuationRing (B ⧸ Ideal.span {b i})) →
          (∃ ρ_B : B →+* k₀,
            ρ_B.comp c_B = RingHom.id k₀ ∧
            RingHom.ker ρ_B = IsLocalRing.maximalIdeal B ∧
            ∀ y₀ y₁ : B, ρ_B y₀ = ρ_B y₁ →
              ∃ y : B,
                Ideal.Quotient.mk (Ideal.span {b 0}) y = Ideal.Quotient.mk (Ideal.span {b 0}) y₀ ∧
                Ideal.Quotient.mk (Ideal.span {b 1}) y = Ideal.Quotient.mk (Ideal.span {b 1}) y₁) →
          let A := Localization.AtPrime q.asIdeal
          let Q_A := Localization (nonZeroDivisors A)
          let A_tilde := integralClosure A Q_A
          (∀ (y : ↥A_tilde) (m : A), m ∈ IsLocalRing.maximalIdeal A →
            algebraMap A Q_A m * y.1 ∈ Set.range (algebraMap A Q_A)) ∧
          (∃ y₀ : ↥A_tilde, y₀.1 ∉ Set.range (algebraMap A Q_A) ∧
            ∀ y : ↥A_tilde, ∃ (c : k₀) (a : A),
              y.1 = algebraMap A Q_A (algebraMap C A (algebraMap k₀ C c)) * y₀.1 +
                algebraMap A Q_A a) := by
    clear hEtDVR hS2
    intro C _ _ _ _ q _ B' _ u₀ φ₁ hEt₁ hComap
    classical
    have hAbstract4 :
        ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [_root_.IsReduced A]
          [CommRing B] [IsLocalRing B]
          (f_AB : A →+* B) (c_A : k₀ →+* A) (b : Fin 2 → B) (ρ_B : B →+* k₀),
          f_AB.Flat →
          IsLocalHom f_AB →
          Ideal.map f_AB (IsLocalRing.maximalIdeal A) = IsLocalRing.maximalIdeal B →
          (b 0 * b 1 = 0 ∧ b 0 ≠ 0 ∧ b 1 ≠ 0) →
          (Ideal.span {b 0} : Ideal B) ⊓ Ideal.span {b 1} = ⊥ →
          ¬ Submodule.IsPrincipal (IsLocalRing.maximalIdeal B) →
          (∀ i : Fin 2, ∃ (_ : IsDomain (B ⧸ Ideal.span {b i})),
            IsDiscreteValuationRing (B ⧸ Ideal.span {b i})) →
          ρ_B.comp (f_AB.comp c_A) = RingHom.id k₀ →
          RingHom.ker ρ_B = IsLocalRing.maximalIdeal B →
          (∀ y₀ y₁ : B, ρ_B y₀ = ρ_B y₁ →
            ∃ y : B,
              Ideal.Quotient.mk (Ideal.span {b 0}) y = Ideal.Quotient.mk (Ideal.span {b 0}) y₀ ∧
              Ideal.Quotient.mk (Ideal.span {b 1}) y = Ideal.Quotient.mk (Ideal.span {b 1}) y₁) →
          let Q_A := Localization (nonZeroDivisors A)
          let A_tilde := integralClosure A Q_A
          (∀ (y : ↥A_tilde) (m : A), m ∈ IsLocalRing.maximalIdeal A →
            algebraMap A Q_A m * y.1 ∈ Set.range (algebraMap A Q_A)) ∧
          (∃ y₀ : ↥A_tilde, y₀.1 ∉ Set.range (algebraMap A Q_A) ∧
            ∀ y : ↥A_tilde, ∃ (c : k₀) (a : A),
              y.1 = algebraMap A Q_A (c_A c) * y₀.1 + algebraMap A Q_A a) := by
      intro A B _ _ _ _ _ _ f_AB c_A b ρ_B hFlatAB hLocAB hMapMax
        ⟨hb_mul, hb0_ne, hb1_ne⟩ hInfB hNotPrincB hDVR hρ_c hKer_ρ hGlue
      letI : Algebra A B := f_AB.toAlgebra
      haveI : Module.Flat A B := hFlatAB
      haveI : IsLocalHom (algebraMap A B) := hLocAB
      haveI : Module.FaithfullyFlat A B := Module.FaithfullyFlat.of_flat_of_isLocalHom

      let Q_A := Localization (nonZeroDivisors A)
      let A_tilde := integralClosure A Q_A
      let R₀ := B ⧸ Ideal.span ({b 0} : Set B)
      let R₁ := B ⧸ Ideal.span ({b 1} : Set B)
      let mk₀ : B →+* R₀ := Ideal.Quotient.mk (Ideal.span ({b 0} : Set B))
      let mk₁ : B →+* R₁ := Ideal.Quotient.mk (Ideal.span ({b 1} : Set B))
      obtain ⟨hDomR₀, hDVRR₀⟩ := hDVR 0
      obtain ⟨hDomR₁, hDVRR₁⟩ := hDVR 1
      letI : IsDomain R₀ := hDomR₀
      letI : IsDiscreteValuationRing R₀ := hDVRR₀
      letI : IsDomain R₁ := hDomR₁
      letI : IsDiscreteValuationRing R₁ := hDVRR₁
      let L₀ := FractionRing R₀
      let L₁ := FractionRing R₁

      have hf_nzd : ∀ s : nonZeroDivisors A,
          ∀ z : B, z * algebraMap A B s.1 = 0 → z = 0 := by
        intro s z hz
        let mul_s : A →ₗ[A] A := LinearMap.mulRight A s.1
        have hInj_ms : Function.Injective mul_s := by
          rw [injective_iff_map_eq_zero]
          intro a ha
          exact (mem_nonZeroDivisors_iff.mp s.2).2 a ha
        have hInj_lT : Function.Injective (LinearMap.lTensor B mul_s) :=
          Module.Flat.lTensor_preserves_injective_linearMap mul_s hInj_ms
        have hTmul0 : LinearMap.lTensor B mul_s (z ⊗ₜ[A] (1 : A)) = 0 := by
          change z ⊗ₜ[A] ((1 : A) * s.1) = 0
          have h1 : (1 : A) * s.1 = s.1 • (1 : A) := by
            rw [smul_eq_mul, one_mul, mul_one]
          rw [h1, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_comm, hz, TensorProduct.zero_tmul]
        have hzTmul : z ⊗ₜ[A] (1 : A) = 0 :=
          hInj_lT (hTmul0.trans (map_zero _).symm)
        simpa using congrArg (TensorProduct.rid A B) hzTmul

      have hmk_nzd : ∀ s : nonZeroDivisors A,
          mk₀ (algebraMap A B s.1) ≠ 0 ∧ mk₁ (algebraMap A B s.1) ≠ 0 := by
        intro s
        refine ⟨?_, ?_⟩
        · intro h0
          have hMem : algebraMap A B s.1 ∈ Ideal.span ({b 0} : Set B) :=
            Ideal.Quotient.eq_zero_iff_mem.mp h0
          rcases Ideal.mem_span_singleton.mp hMem with ⟨d, hd⟩
          apply hb1_ne
          apply hf_nzd s (b 1)
          calc
            b 1 * algebraMap A B s.1 = b 1 * (b 0 * d) := by rw [hd]
            _ = (b 0 * b 1) * d := by ring
            _ = 0 := by rw [hb_mul, zero_mul]
        · intro h1
          have hMem : algebraMap A B s.1 ∈ Ideal.span ({b 1} : Set B) :=
            Ideal.Quotient.eq_zero_iff_mem.mp h1
          rcases Ideal.mem_span_singleton.mp hMem with ⟨d, hd⟩
          apply hb0_ne
          apply hf_nzd s (b 0)
          calc
            b 0 * algebraMap A B s.1 = b 0 * (b 1 * d) := by rw [hd]
            _ = (b 0 * b 1) * d := by ring
            _ = 0 := by rw [hb_mul, zero_mul]

      let δ_B : B →+* (L₀ × L₁) :=
        ((algebraMap R₀ L₀).comp mk₀).prod ((algebraMap R₁ L₁).comp mk₁)
      let δ_A : A →+* (L₀ × L₁) := δ_B.comp (algebraMap A B)
      have hUnits_δA : ∀ s : nonZeroDivisors A, IsUnit (δ_A s) := by
        intro s
        obtain ⟨hne0, hne1⟩ := hmk_nzd s
        have hneL0 : algebraMap R₀ L₀ (mk₀ (algebraMap A B s.1)) ≠ 0 :=
          fun h => hne0 (IsFractionRing.injective R₀ L₀ (h.trans (map_zero _).symm))
        have hneL1 : algebraMap R₁ L₁ (mk₁ (algebraMap A B s.1)) ≠ 0 :=
          fun h => hne1 (IsFractionRing.injective R₁ L₁ (h.trans (map_zero _).symm))
        exact Prod.isUnit_iff.mpr ⟨IsUnit.mk0 _ hneL0, IsUnit.mk0 _ hneL1⟩

      let δ_Q : Q_A →+* (L₀ × L₁) :=
        IsLocalization.lift (M := nonZeroDivisors A) (S := Q_A) hUnits_δA
      letI : Algebra A (L₀ × L₁) := δ_A.toAlgebra
      let δ_B_alg : B →ₐ[A] (L₀ × L₁) := { toRingHom := δ_B, commutes' := fun _ => rfl }
      let δ_Q_alg : Q_A →ₐ[A] (L₀ × L₁) :=
        { toRingHom := δ_Q, commutes' := fun a => IsLocalization.lift_eq hUnits_δA a }
      let Θ_alg : TensorProduct A B Q_A →ₐ[A] (L₀ × L₁) :=
        Algebra.TensorProduct.productMap δ_B_alg δ_Q_alg

      have hCommonDenom : ∀ w : TensorProduct A B Q_A,
          ∃ (b' : B) (s : nonZeroDivisors A), w = b' ⊗ₜ[A] IsLocalization.mk' Q_A 1 s := by
        intro w
        refine TensorProduct.induction_on
          (motive := fun w =>
            ∃ (b' : B) (s : nonZeroDivisors A), w = b' ⊗ₜ[A] IsLocalization.mk' Q_A 1 s)
          w ?_ ?_ ?_
        · exact ⟨0, 1, (TensorProduct.zero_tmul _ _).symm⟩
        · intro b' q
          obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors A) q
          refine ⟨a • b', s, ?_⟩
          dsimp only
          have hmk : IsLocalization.mk' Q_A a s = a • IsLocalization.mk' Q_A 1 s := by
            rw [Algebra.smul_def, IsLocalization.mk'_eq_mul_mk'_one, mul_comm]
          rw [hmk, TensorProduct.tmul_smul]
          rfl
        · rintro x₁ x₂ ⟨b₁, s₁, rfl⟩ ⟨b₂, s₂, rfl⟩
          refine ⟨s₂.1 • b₁ + s₁.1 • b₂, s₁ * s₂, ?_⟩
          have hs₁ : IsLocalization.mk' Q_A 1 s₁ =
              s₂.1 • IsLocalization.mk' Q_A 1 (s₁ * s₂) := by
            rw [Algebra.smul_def, ← IsLocalization.mk'_eq_mul_mk'_one]
            symm
            rw [IsLocalization.mk'_eq_iff_eq]
            simp [mul_comm, mul_left_comm]
          have hs₂ : IsLocalization.mk' Q_A 1 s₂ =
              s₁.1 • IsLocalization.mk' Q_A 1 (s₁ * s₂) := by
            rw [Algebra.smul_def, ← IsLocalization.mk'_eq_mul_mk'_one]
            symm
            rw [IsLocalization.mk'_eq_iff_eq]
            simp [mul_comm]
          rw [TensorProduct.add_tmul, TensorProduct.smul_tmul, TensorProduct.smul_tmul,
            ← hs₁, ← hs₂]

      have hInj_Θ : Function.Injective Θ_alg := by
        rw [injective_iff_map_eq_zero]
        intro w hw
        obtain ⟨b', s, rfl⟩ := hCommonDenom w
        have hCancel : δ_Q (IsLocalization.mk' Q_A 1 s) * δ_B (algebraMap A B s.1) = 1 := by
          have h1 : δ_B (algebraMap A B s.1) = δ_Q (algebraMap A Q_A s.1) :=
            (IsLocalization.lift_eq hUnits_δA s.1).symm
          rw [h1, ← map_mul, IsLocalization.mk'_spec, map_one, map_one]
        have hδB0 : δ_B b' = 0 := by
          have hmul : Θ_alg (b' ⊗ₜ[A] IsLocalization.mk' Q_A 1 s) *
              δ_B (algebraMap A B s.1) = 0 := by
            rw [hw, zero_mul]
          have hEval : Θ_alg (b' ⊗ₜ[A] IsLocalization.mk' Q_A 1 s) =
              δ_B b' * δ_Q (IsLocalization.mk' Q_A 1 s) :=
            Algebra.TensorProduct.productMap_apply_tmul δ_B_alg δ_Q_alg b' _
          rw [hEval, mul_assoc, hCancel, mul_one] at hmul
          exact hmul
        have hmk0 : mk₀ b' = 0 :=
          IsFractionRing.injective R₀ L₀ ((congrArg Prod.fst hδB0).trans (map_zero _).symm)
        have hmk1 : mk₁ b' = 0 :=
          IsFractionRing.injective R₁ L₁ ((congrArg Prod.snd hδB0).trans (map_zero _).symm)
        have hbInf : b' ∈ (Ideal.span {b 0} : Ideal B) ⊓ Ideal.span {b 1} :=
          ⟨Ideal.Quotient.eq_zero_iff_mem.mp hmk0, Ideal.Quotient.eq_zero_iff_mem.mp hmk1⟩
        rw [hInfB, Ideal.mem_bot] at hbInf
        rw [hbInf, TensorProduct.zero_tmul]

      let ι_tilde : ↥A_tilde →ₐ[A] Q_A := A_tilde.val
      let map_tilde : TensorProduct A B ↥A_tilde →ₐ[A] TensorProduct A B Q_A :=
        Algebra.TensorProduct.map (AlgHom.id A B) ι_tilde
      have hInj_map : Function.Injective map_tilde := by
        have hEqFn : (map_tilde : TensorProduct A B ↥A_tilde → TensorProduct A B Q_A) =
            LinearMap.lTensor B ι_tilde.toLinearMap := by
          ext u
          refine TensorProduct.induction_on
            (motive := fun u => map_tilde u = LinearMap.lTensor B ι_tilde.toLinearMap u)
            u (by rw [map_zero, map_zero]) (fun _ _ => rfl)
            (fun _ _ h₁ h₂ => by rw [map_add, map_add, h₁, h₂])
        rw [hEqFn]
        exact Module.Flat.lTensor_preserves_injective_linearMap
          ι_tilde.toLinearMap Subtype.val_injective
      let Θ_tilde : TensorProduct A B ↥A_tilde →+* (L₀ × L₁) :=
        Θ_alg.toRingHom.comp map_tilde.toRingHom
      have hInj_Θtilde : Function.Injective Θ_tilde := hInj_Θ.comp hInj_map

      haveI : Algebra.IsIntegral B (TensorProduct A B ↥A_tilde) :=
        Algebra.IsIntegral.tensorProduct A B ↥A_tilde
      have hIntBranches : ∀ u : TensorProduct A B ↥A_tilde,
          (∃ r₀ : R₀, algebraMap R₀ L₀ r₀ = (Θ_tilde u).1) ∧
          (∃ r₁ : R₁, algebraMap R₁ L₁ r₁ = (Θ_tilde u).2) := by
        intro u
        have huInt : IsIntegral B u := Algebra.IsIntegral.isIntegral u
        refine ⟨?_, ?_⟩
        · let π₀_alg : TensorProduct A B ↥A_tilde →ₐ[B] L₀ :=
            { toRingHom := (RingHom.fst L₀ L₁).comp Θ_tilde
              commutes' := fun b' => by
                change (Θ_alg (b' ⊗ₜ[A] (1 : Q_A))).1 = algebraMap B L₀ b'
                have hEval := Algebra.TensorProduct.productMap_apply_tmul δ_B_alg δ_Q_alg b' 1
                rw [map_one, mul_one] at hEval
                rw [IsScalarTower.algebraMap_apply B R₀ L₀ b']
                exact congrArg Prod.fst hEval }
          have hIntB₀ : IsIntegral B ((Θ_tilde u).1) := IsIntegral.map π₀_alg huInt
          have hIntR₀ : IsIntegral R₀ ((Θ_tilde u).1) :=
            IsIntegral.tower_top (R := B) (A := R₀) (B := L₀) hIntB₀
          exact (isIntegrallyClosed_iff L₀).mp inferInstance hIntR₀
        · let π₁_alg : TensorProduct A B ↥A_tilde →ₐ[B] L₁ :=
            { toRingHom := (RingHom.snd L₀ L₁).comp Θ_tilde
              commutes' := fun b' => by
                change (Θ_alg (b' ⊗ₜ[A] (1 : Q_A))).2 = algebraMap B L₁ b'
                have hEval := Algebra.TensorProduct.productMap_apply_tmul δ_B_alg δ_Q_alg b' 1
                rw [map_one, mul_one] at hEval
                rw [IsScalarTower.algebraMap_apply B R₁ L₁ b']
                exact congrArg Prod.snd hEval }
          have hIntB₁ : IsIntegral B ((Θ_tilde u).2) := IsIntegral.map π₁_alg huInt
          have hIntR₁ : IsIntegral R₁ ((Θ_tilde u).2) :=
            IsIntegral.tower_top (R := B) (A := R₁) (B := L₁) hIntB₁
          exact (isIntegrallyClosed_iff L₁).mp inferInstance hIntR₁

      have hb_max : ∀ i : Fin 2, b i ∈ IsLocalRing.maximalIdeal B := by
        intro i
        by_contra hNotM
        obtain ⟨v, hv⟩ := IsLocalRing.notMem_maximalIdeal.mp hNotM
        fin_cases i
        · change ↑v = b 0 at hv
          apply hb1_ne
          calc
            b 1 = (↑v⁻¹ * ↑v) * b 1 := by rw [Units.inv_mul, one_mul]
            _ = ↑v⁻¹ * (b 0 * b 1) := by rw [hv, mul_assoc]
            _ = 0 := by rw [hb_mul, mul_zero]
        · change ↑v = b 1 at hv
          apply hb0_ne
          calc
            b 0 = b 0 * (↑v * ↑v⁻¹) := by rw [Units.mul_inv, mul_one]
            _ = (b 0 * b 1) * ↑v⁻¹ := by rw [hv, mul_assoc]
            _ = 0 := by rw [hb_mul, zero_mul]

      have hKer_ρ0 : Ideal.span ({b 0} : Set B) ≤ RingHom.ker ρ_B := by
        rw [Ideal.span_le, Set.singleton_subset_iff, hKer_ρ]
        exact hb_max 0
      have hKer_ρ1 : Ideal.span ({b 1} : Set B) ≤ RingHom.ker ρ_B := by
        rw [Ideal.span_le, Set.singleton_subset_iff, hKer_ρ]
        exact hb_max 1
      let ρ_bar₀ : R₀ →+* k₀ := Ideal.Quotient.lift (Ideal.span {b 0}) ρ_B hKer_ρ0
      let ρ_bar₁ : R₁ →+* k₀ := Ideal.Quotient.lift (Ideal.span {b 1}) ρ_B hKer_ρ1

      let proj₀ : TensorProduct A B ↥A_tilde → R₀ := fun u => (hIntBranches u).1.choose
      let proj₁ : TensorProduct A B ↥A_tilde → R₁ := fun u => (hIntBranches u).2.choose
      have hproj₀_spec : ∀ u, algebraMap R₀ L₀ (proj₀ u) = (Θ_tilde u).1 :=
        fun u => (hIntBranches u).1.choose_spec
      have hproj₁_spec : ∀ u, algebraMap R₁ L₁ (proj₁ u) = (Θ_tilde u).2 :=
        fun u => (hIntBranches u).2.choose_spec

      have hproj₀_add : ∀ u v, proj₀ (u + v) = proj₀ u + proj₀ v := fun u v =>
        IsFractionRing.injective R₀ L₀ (by rw [hproj₀_spec, map_add, map_add, Prod.fst_add,
          hproj₀_spec, hproj₀_spec])
      have hproj₁_add : ∀ u v, proj₁ (u + v) = proj₁ u + proj₁ v := fun u v =>
        IsFractionRing.injective R₁ L₁ (by rw [hproj₁_spec, map_add, map_add, Prod.snd_add,
          hproj₁_spec, hproj₁_spec])
      have hproj₀_smulB : ∀ (b' : B) u, proj₀ (b' • u) = mk₀ b' * proj₀ u := fun b' u =>
        IsFractionRing.injective R₀ L₀ (by
          have hbu : b' • u = (b' ⊗ₜ[A] (1 : ↥A_tilde)) * u := Algebra.smul_def b' u
          have hΘb : (Θ_tilde (b' ⊗ₜ[A] (1 : ↥A_tilde))).1 = algebraMap R₀ L₀ (mk₀ b') := by
            change (Θ_alg (b' ⊗ₜ[A] (1 : Q_A))).1 = _
            rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
            rfl
          rw [hproj₀_spec, hbu, map_mul, Prod.fst_mul, hΘb, map_mul, hproj₀_spec])
      have hproj₁_smulB : ∀ (b' : B) u, proj₁ (b' • u) = mk₁ b' * proj₁ u := fun b' u =>
        IsFractionRing.injective R₁ L₁ (by
          have hbu : b' • u = (b' ⊗ₜ[A] (1 : ↥A_tilde)) * u := Algebra.smul_def b' u
          have hΘb : (Θ_tilde (b' ⊗ₜ[A] (1 : ↥A_tilde))).2 = algebraMap R₁ L₁ (mk₁ b') := by
            change (Θ_alg (b' ⊗ₜ[A] (1 : Q_A))).2 = _
            rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
            rfl
          rw [hproj₁_spec, hbu, map_mul, Prod.snd_mul, hΘb, map_mul, hproj₁_spec])
      have hproj₀_one : ∀ b' : B, proj₀ (b' ⊗ₜ[A] (1 : ↥A_tilde)) = mk₀ b' := fun b' =>
        IsFractionRing.injective R₀ L₀ (by
          rw [hproj₀_spec]
          change (Θ_alg (b' ⊗ₜ[A] (1 : Q_A))).1 = _
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
          rfl)
      have hproj₁_one : ∀ b' : B, proj₁ (b' ⊗ₜ[A] (1 : ↥A_tilde)) = mk₁ b' := fun b' =>
        IsFractionRing.injective R₁ L₁ (by
          rw [hproj₁_spec]
          change (Θ_alg (b' ⊗ₜ[A] (1 : Q_A))).2 = _
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
          rfl)

      let Λ_fn : TensorProduct A B ↥A_tilde → k₀ :=
        fun u => ρ_bar₀ (proj₀ u) - ρ_bar₁ (proj₁ u)
      have hΛ_add : ∀ u v, Λ_fn (u + v) = Λ_fn u + Λ_fn v := by
        intro u v
        dsimp [Λ_fn]
        rw [hproj₀_add, hproj₁_add, map_add, map_add]
        ring
      have hΛ_smulB : ∀ (b' : B) u, Λ_fn (b' • u) = ρ_B b' * Λ_fn u := by
        intro b' u
        dsimp [Λ_fn]
        rw [hproj₀_smulB, hproj₁_smulB, map_mul, map_mul]
        have h0 : ρ_bar₀ (mk₀ b') = ρ_B b' := rfl
        have h1 : ρ_bar₁ (mk₁ b') = ρ_B b' := rfl
        rw [h0, h1]
        ring
      have hΛ_one : ∀ b' : B, Λ_fn (b' ⊗ₜ[A] (1 : ↥A_tilde)) = 0 := by
        intro b'
        dsimp [Λ_fn]
        rw [hproj₀_one, hproj₁_one]
        exact sub_self (ρ_B b')
      have hΛ_eq_zero_iff : ∀ u : TensorProduct A B ↥A_tilde,
          Λ_fn u = 0 ↔ ∃ b' : B, u = b' ⊗ₜ[A] (1 : ↥A_tilde) := by
        intro u
        constructor
        · intro h0
          have hEqρ : ρ_bar₀ (proj₀ u) = ρ_bar₁ (proj₁ u) := sub_eq_zero.mp h0
          obtain ⟨y₀, hy₀⟩ := Ideal.Quotient.mk_surjective (proj₀ u)
          obtain ⟨y₁, hy₁⟩ := Ideal.Quotient.mk_surjective (proj₁ u)
          rw [← hy₀, ← hy₁] at hEqρ
          obtain ⟨y, hmk0_y, hmk1_y⟩ := hGlue y₀ y₁ hEqρ
          refine ⟨y, hInj_Θtilde ?_⟩
          apply Prod.ext
          · rw [← hproj₀_spec u, ← hy₀, ← hmk0_y, ← hproj₀_one y, hproj₀_spec]
          · rw [← hproj₁_spec u, ← hy₁, ← hmk1_y, ← hproj₁_one y, hproj₁_spec]
        · rintro ⟨b', rfl⟩
          exact hΛ_one b'

      let ρ_A : A →+* k₀ := ρ_B.comp (algebraMap A B)
      letI : Algebra A k₀ := ρ_A.toAlgebra
      let Λ_lin : TensorProduct A B ↥A_tilde →ₗ[A] k₀ :=
        { toFun := Λ_fn
          map_add' := hΛ_add
          map_smul' := fun a u => by
            have ha : a • u = (algebraMap A B a) • u := by
              rw [← smul_one_smul B a u, Algebra.smul_def, mul_one]
            rw [ha, hΛ_smulB]
            rfl }

      let I_A : Submodule A ↥A_tilde := LinearMap.range (Algebra.linearMap A ↥A_tilde)
      let N := ↥A_tilde ⧸ I_A
      let Λ_bilin : B →ₗ[A] N →ₗ[A] k₀ :=
        { toFun := fun b' =>
            I_A.liftQ (Λ_lin.comp (TensorProduct.mk A B ↥A_tilde b')) (by
              rintro _ ⟨a, rfl⟩
              rw [LinearMap.mem_ker]
              change Λ_fn (b' ⊗ₜ[A] ((Algebra.linearMap A ↥A_tilde) a)) = 0
              have halg : (Algebra.linearMap A ↥A_tilde) a = a • (1 : ↥A_tilde) := by
                rw [Algebra.linearMap_apply, Algebra.smul_def, mul_one]
              rw [halg, TensorProduct.tmul_smul]
              exact hΛ_one (a • b'))
          map_add' := fun b₁ b₂ => by
            apply Submodule.linearMap_qext
            ext y
            change Λ_fn ((b₁ + b₂) ⊗ₜ[A] y) = Λ_fn (b₁ ⊗ₜ[A] y) + Λ_fn (b₂ ⊗ₜ[A] y)
            rw [TensorProduct.add_tmul, hΛ_add]
          map_smul' := fun a b' => by
            apply Submodule.linearMap_qext
            ext y
            change Λ_fn ((a • b') ⊗ₜ[A] y) = a • Λ_fn (b' ⊗ₜ[A] y)
            have hsmul : (a • b') ⊗ₜ[A] y = a • (b' ⊗ₜ[A] y) := rfl
            rw [hsmul]
            exact Λ_lin.map_smul a (b' ⊗ₜ[A] y) }
      let Λ_bar : TensorProduct A B N →ₗ[A] k₀ := TensorProduct.lift Λ_bilin
      have hΛ_bar_comp : Λ_bar.comp (LinearMap.lTensor B I_A.mkQ) = Λ_lin := by
        apply TensorProduct.ext'
        intro b' y
        rfl
      have hInj_Λbar : Function.Injective Λ_bar := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        obtain ⟨u, rfl⟩ := LinearMap.lTensor_surjective B (Submodule.mkQ_surjective I_A) z
        have hΛu : Λ_fn u = 0 := by
          have := LinearMap.congr_fun hΛ_bar_comp u
          exact this.symm.trans hz
        obtain ⟨b', rfl⟩ := (hΛ_eq_zero_iff u).mp hΛu
        change b' ⊗ₜ[A] I_A.mkQ 1 = 0
        have h1Mem : (1 : ↥A_tilde) ∈ I_A := ⟨1, map_one (algebraMap A ↥A_tilde)⟩
        have hmk10 : I_A.mkQ 1 = 0 := (Submodule.Quotient.mk_eq_zero I_A).mpr h1Mem
        rw [hmk10, TensorProduct.tmul_zero]

      have hNotSubN : ¬ Subsingleton N := by
        intro hSubN
        have hAllInRange : ∀ y : ↥A_tilde, y.1 ∈ Set.range (algebraMap A Q_A) := by
          intro y
          have hEq0 : I_A.mkQ y = 0 := Subsingleton.elim _ _
          obtain ⟨a, ha⟩ := (Submodule.Quotient.mk_eq_zero I_A).mp hEq0
          exact ⟨a, congrArg Subtype.val ha⟩
        have hFinMin : (minimalPrimes A).Finite := minimalPrimes.finite_of_isNoetherianRing A
        obtain ⟨𝔓₁, h𝔓₁, _⟩ :=
          Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal A) ≤ IsLocalRing.maximalIdeal A)
        have hZeroIffMin : ∀ x : A, (∀ 𝔓 ∈ minimalPrimes A, x ∈ 𝔓) → x = 0 := by
          intro x hx
          have hxNil : x ∈ nilradical A := by
            rw [nilradical_eq_sInf, Ideal.mem_sInf]
            intro P hP
            haveI : P.IsPrime := hP
            obtain ⟨𝔓, h𝔓, hle⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal A) ≤ P)
            exact hle (hx 𝔓 h𝔓)
          rwa [nilradical_eq_zero] at hxNil
        have hNzdOfNotMem : ∀ s : A, (∀ 𝔓 ∈ minimalPrimes A, s ∉ 𝔓) → s ∈ nonZeroDivisors A := by
          intro s hs
          rw [mem_nonZeroDivisors_iff_right]
          intro z hzs
          apply hZeroIffMin z
          intro 𝔓 h𝔓
          have hPr : 𝔓.IsPrime := h𝔓.1.1
          have hMem : z * s ∈ 𝔓 := hzs ▸ 𝔓.zero_mem
          exact (hPr.mem_or_mem hMem).resolve_right (hs 𝔓 h𝔓)
        by_cases hTwo : ∃ 𝔓₂ ∈ minimalPrimes A, 𝔓₂ ≠ 𝔓₁
        · obtain ⟨𝔓₂, h𝔓₂, hNe₁₂⟩ := hTwo
          let S' : Finset (Ideal A) := hFinMin.toFinset.erase 𝔓₁
          have h𝔓₂_S' : 𝔓₂ ∈ S' :=
            Finset.mem_erase.mpr ⟨hNe₁₂, hFinMin.mem_toFinset.mpr h𝔓₂⟩
          have hS'_mem : ∀ 𝔔 ∈ S', 𝔔 ∈ minimalPrimes A ∧ 𝔔 ≠ 𝔓₁ := by
            intro 𝔔 h𝔔
            exact ⟨hFinMin.mem_toFinset.mp (Finset.mem_of_mem_erase h𝔔),
              (Finset.mem_erase.mp h𝔔).1⟩
          have hExU : ∀ 𝔔 ∈ S', ∃ u_q : A, u_q ∈ 𝔔 ∧ u_q ∉ 𝔓₁ := by
            intro 𝔔 h𝔔
            obtain ⟨h𝔔_min, h𝔔_ne⟩ := hS'_mem 𝔔 h𝔔
            have hNotLe : ¬ (𝔔 ≤ 𝔓₁) := fun hle =>
              h𝔔_ne (le_antisymm hle (h𝔓₁.2 h𝔔_min.1 hle))
            exact Set.not_subset.mp hNotLe
          let u_fn : Ideal A → A := fun 𝔔 =>
            if h : 𝔔 ∈ S' then (hExU 𝔔 h).choose else 1
          let u_val : A := ∏ 𝔔 ∈ S', u_fn 𝔔
          have hu_not_𝔓₁ : u_val ∉ 𝔓₁ := by
            haveI : 𝔓₁.IsPrime := h𝔓₁.1.1
            intro huMem
            obtain ⟨𝔔, h𝔔, huqMem⟩ := Ideal.IsPrime.prod_mem_iff.mp huMem
            simp only [u_fn, h𝔔, ↓reduceDIte] at huqMem
            exact (hExU 𝔔 h𝔔).choose_spec.2 huqMem
          have hu_in_S' : ∀ 𝔔 ∈ S', u_val ∈ 𝔔 := by
            intro 𝔔 h𝔔
            have hfac : u_fn 𝔔 ∈ 𝔔 := by
              simp only [u_fn, h𝔔, ↓reduceDIte]
              exact (hExU 𝔔 h𝔔).choose_spec.1
            dsimp only [u_val]
            rw [← Finset.mul_prod_erase S' u_fn h𝔔]
            exact Ideal.mul_mem_right _ _ hfac
          have hNotSubUnion : ¬ ((𝔓₁ : Set A) ⊆ ⋃ 𝔔 ∈ (S' : Set (Ideal A)), (𝔔 : Set A)) := by
            intro hSubU
            have hPrS' : ∀ 𝔔 ∈ S', 𝔔 ≠ 𝔓₂ → 𝔔 ≠ 𝔓₂ → 𝔔.IsPrime :=
              fun 𝔔 h𝔔 _ _ => (hS'_mem 𝔔 h𝔔).1.1.1
            obtain ⟨𝔔, h𝔔, hle⟩ :=
              (Ideal.subset_union_prime (f := _root_.id) 𝔓₂ 𝔓₂ hPrS').mp hSubU
            obtain ⟨h𝔔_min, h𝔔_ne⟩ := hS'_mem 𝔔 h𝔔
            exact h𝔔_ne (le_antisymm (h𝔔_min.2 h𝔓₁.1 hle) hle)
          obtain ⟨v_val, hv_𝔓₁, hv_not_U⟩ := Set.not_subset.mp hNotSubUnion
          have hv_not_S' : ∀ 𝔔 ∈ S', v_val ∉ 𝔔 := by
            intro 𝔔 h𝔔 hvMem
            exact hv_not_U (Set.mem_biUnion h𝔔 hvMem)
          have huv_zero : u_val * v_val = 0 := by
            apply hZeroIffMin
            intro 𝔓 h𝔓
            by_cases hEq₁ : 𝔓 = 𝔓₁
            · subst hEq₁; exact Ideal.mul_mem_left _ _ hv_𝔓₁
            · have h𝔓_S' : 𝔓 ∈ S' :=
                Finset.mem_erase.mpr ⟨hEq₁, hFinMin.mem_toFinset.mpr h𝔓⟩
              exact Ideal.mul_mem_right _ _ (hu_in_S' 𝔓 h𝔓_S')
          have huv_nzd : u_val + v_val ∈ nonZeroDivisors A := by
            apply hNzdOfNotMem
            intro 𝔓 h𝔓 hSumMem
            by_cases hEq₁ : 𝔓 = 𝔓₁
            · subst hEq₁
              exact hu_not_𝔓₁ ((Ideal.add_mem_iff_left 𝔓 hv_𝔓₁).mp hSumMem)
            · have h𝔓_S' : 𝔓 ∈ S' :=
                Finset.mem_erase.mpr ⟨hEq₁, hFinMin.mem_toFinset.mpr h𝔓⟩
              exact hv_not_S' 𝔓 h𝔓_S'
                ((Ideal.add_mem_iff_right 𝔓 (hu_in_S' 𝔓 h𝔓_S')).mp hSumMem)
          let s_uv : nonZeroDivisors A := ⟨u_val + v_val, huv_nzd⟩
          let e_idem : Q_A := IsLocalization.mk' Q_A u_val s_uv
          have he_sq : e_idem * e_idem = e_idem := by
            dsimp [e_idem]
            rw [← IsLocalization.mk'_mul, IsLocalization.mk'_eq_iff_eq]
            apply congrArg (algebraMap A Q_A)
            change (u_val + v_val) * (u_val * u_val) = ((u_val + v_val) * (u_val + v_val)) * u_val
            calc
              (u_val + v_val) * (u_val * u_val) =
                  ((u_val + v_val) * (u_val + v_val)) * u_val -
                    (u_val + v_val) * (u_val * v_val) := by ring
              _ = ((u_val + v_val) * (u_val + v_val)) * u_val := by
                rw [huv_zero, mul_zero, sub_zero]
          have he_int : e_idem ∈ A_tilde := by
            refine ⟨Polynomial.X * (Polynomial.X - Polynomial.C 1), ?_, ?_⟩
            · exact Polynomial.monic_X.mul (Polynomial.monic_X_sub_C 1)
            · simp [mul_sub, mul_one, he_sq]
          obtain ⟨a_idem, ha_idem⟩ := hAllInRange ⟨e_idem, he_int⟩
          have hEq_a : a_idem * (u_val + v_val) = u_val := by
            have hInjQ : Function.Injective (algebraMap A Q_A) :=
              IsLocalization.injective Q_A (le_refl (nonZeroDivisors A))
            apply hInjQ
            rw [map_mul, ha_idem]
            exact IsLocalization.mk'_spec Q_A u_val s_uv
          have hav_zero : a_idem * v_val = 0 := by
            have hnil : (a_idem * v_val) ^ 2 = 0 := by
              calc
                (a_idem * v_val) ^ 2 = a_idem * ((a_idem * (u_val + v_val)) * v_val -
                    a_idem * (u_val * v_val)) := by ring
                _ = 0 := by rw [hEq_a, huv_zero]; ring
            exact IsNilpotent.eq_zero ⟨2, hnil⟩
          have h1au_zero : (1 - a_idem) * u_val = 0 := by
            calc
              (1 - a_idem) * u_val = u_val - (a_idem * (u_val + v_val) - a_idem * v_val) := by ring
              _ = 0 := by rw [hEq_a, hav_zero, sub_zero, sub_self]
          by_cases haMax : a_idem ∈ IsLocalRing.maximalIdeal A
          · have hUnit1a : IsUnit (1 - a_idem) := by
              apply IsLocalRing.notMem_maximalIdeal.mp
              intro h1aM
              have h1M : (1 : A) ∈ IsLocalRing.maximalIdeal A := by
                have h1eq : (1 : A) = (1 - a_idem) + a_idem := by ring
                rw [h1eq]
                exact Ideal.add_mem _ h1aM haMax
              exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top
                (Ideal.eq_top_of_isUnit_mem _ h1M isUnit_one)
            obtain ⟨w, hw⟩ := hUnit1a
            have hu0 : u_val = 0 := by
              calc
                u_val = (↑w⁻¹ * ↑w) * u_val := by rw [Units.inv_mul, one_mul]
                _ = ↑w⁻¹ * ((1 - a_idem) * u_val) := by rw [hw, mul_assoc]
                _ = 0 := by rw [h1au_zero, mul_zero]
            exact hu_not_𝔓₁ (hu0 ▸ 𝔓₁.zero_mem)
          · obtain ⟨w, hw⟩ := IsLocalRing.notMem_maximalIdeal.mp haMax
            have hv0 : v_val = 0 := by
              calc
                v_val = (↑w⁻¹ * ↑w) * v_val := by rw [Units.inv_mul, one_mul]
                _ = ↑w⁻¹ * (a_idem * v_val) := by rw [hw, mul_assoc]
                _ = 0 := by rw [hav_zero, mul_zero]
            exact hv_not_S' 𝔓₂ h𝔓₂_S' (hv0 ▸ 𝔓₂.zero_mem)
        · have h𝔓₁_bot : 𝔓₁ = ⊥ := by
            rw [eq_bot_iff]
            intro x hx
            rw [Ideal.mem_bot]
            apply hZeroIffMin x
            intro 𝔓 h𝔓
            have hEq : 𝔓 = 𝔓₁ := by
              by_contra hNe
              exact hTwo ⟨𝔓, h𝔓, hNe⟩
            rwa [hEq]
          haveI : (⊥ : Ideal A).IsPrime := h𝔓₁_bot ▸ h𝔓₁.1.1
          letI : IsDomain A := IsDomain.of_bot_isPrime A
          have hIC_A : IsIntegrallyClosed A := by
            rw [isIntegrallyClosed_iff Q_A]
            intro x hx
            exact hAllInRange ⟨x, hx⟩
          have hMaxANeBot : IsLocalRing.maximalIdeal A ≠ ⊥ := by
            intro hBot
            have hMaxBBot : IsLocalRing.maximalIdeal B = ⊥ := by
              rw [← hMapMax, hBot, Ideal.map_bot]
            have hb0_bot : b 0 ∈ (⊥ : Ideal B) := hMaxBBot ▸ hb_max 0
            rw [Ideal.mem_bot] at hb0_bot
            exact hb0_ne hb0_bot
          have hNotFieldA : ¬ IsField A := by
            obtain ⟨m, hmMax, hm0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hMaxANeBot
            intro hField
            obtain ⟨inv_m, hinv⟩ := hField.mul_inv_cancel hm0
            exact (IsLocalRing.notMem_maximalIdeal.mpr (IsUnit.of_mul_eq_one inv_m hinv)) hmMax
          have hFF_hom : f_AB.FaithfullyFlat := ‹Module.FaithfullyFlat A B›
          have hSurjSpec : Function.Surjective (PrimeSpectrum.comap f_AB) :=
            (RingHom.FaithfullyFlat.iff_flat_and_comap_surjective.mp hFF_hom).2
          have hUniquePrime : ∃! P : Ideal A, P ≠ ⊥ ∧ P.IsPrime := by
            refine ⟨IsLocalRing.maximalIdeal A, ⟨hMaxANeBot, inferInstance⟩, ?_⟩
            rintro P ⟨hPNeBot, hPPrime⟩
            obtain ⟨Q_sp, hQ_sp⟩ := hSurjSpec ⟨P, hPPrime⟩
            have hComapQ : Ideal.comap f_AB Q_sp.asIdeal = P :=
              congrArg PrimeSpectrum.asIdeal hQ_sp
            obtain ⟨a, haP, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hPNeBot
            have ha_nzd : a ∈ nonZeroDivisors A := mem_nonZeroDivisors_of_ne_zero ha0
            have hProdQ : b 0 * b 1 ∈ Q_sp.asIdeal := hb_mul ▸ Q_sp.asIdeal.zero_mem
            have hQMax : Q_sp.asIdeal = IsLocalRing.maximalIdeal B := by
              rcases Q_sp.isPrime.mem_or_mem hProdQ with hb0Q | hb1Q
              · have hLe0 : Ideal.span ({b 0} : Set B) ≤ Q_sp.asIdeal :=
                  Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hb0Q)
                let Q_bar : Ideal R₀ := Ideal.map mk₀ Q_sp.asIdeal
                have hComapQbar : Ideal.comap mk₀ Q_bar = Q_sp.asIdeal := by
                  rw [Ideal.comap_map_of_surjective' mk₀ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
                  exact sup_eq_left.mpr hLe0
                haveI : Q_bar.IsPrime := by
                  refine Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective ?_
                  rw [Ideal.mk_ker]
                  exact hLe0
                have hQbarNeBot : Q_bar ≠ ⊥ := by
                  intro hBot
                  have haQ : f_AB a ∈ Q_sp.asIdeal := by
                    rw [← Ideal.mem_comap, hComapQ]
                    exact haP
                  have hmkMem : mk₀ (f_AB a) ∈ Q_bar := Ideal.mem_map_of_mem mk₀ haQ
                  rw [hBot, Ideal.mem_bot] at hmkMem
                  exact (hmk_nzd ⟨a, ha_nzd⟩).1 hmkMem
                obtain ⟨_, ⟨_, _, hUniqR₀⟩⟩ :=
                  (IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime R₀).mp inferInstance
                have hMaxR₀Ne : IsLocalRing.maximalIdeal R₀ ≠ ⊥ :=
                  IsDiscreteValuationRing.not_a_field'
                have hQbarEqMax : Q_bar = IsLocalRing.maximalIdeal R₀ :=
                  (hUniqR₀ Q_bar ⟨hQbarNeBot, inferInstance⟩).trans
                    (hUniqR₀ (IsLocalRing.maximalIdeal R₀) ⟨hMaxR₀Ne, inferInstance⟩).symm
                haveI : Q_bar.IsMaximal := hQbarEqMax ▸ IsLocalRing.maximalIdeal.isMaximal R₀
                have hQIsMax : Q_sp.asIdeal.IsMaximal := by
                  rw [← hComapQbar]
                  exact Ideal.comap_isMaximal_of_surjective mk₀ Ideal.Quotient.mk_surjective
                exact IsLocalRing.eq_maximalIdeal hQIsMax
              · have hLe1 : Ideal.span ({b 1} : Set B) ≤ Q_sp.asIdeal :=
                  Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hb1Q)
                let Q_bar : Ideal R₁ := Ideal.map mk₁ Q_sp.asIdeal
                have hComapQbar : Ideal.comap mk₁ Q_bar = Q_sp.asIdeal := by
                  rw [Ideal.comap_map_of_surjective' mk₁ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
                  exact sup_eq_left.mpr hLe1
                haveI : Q_bar.IsPrime := by
                  refine Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective ?_
                  rw [Ideal.mk_ker]
                  exact hLe1
                have hQbarNeBot : Q_bar ≠ ⊥ := by
                  intro hBot
                  have haQ : f_AB a ∈ Q_sp.asIdeal := by
                    rw [← Ideal.mem_comap, hComapQ]
                    exact haP
                  have hmkMem : mk₁ (f_AB a) ∈ Q_bar := Ideal.mem_map_of_mem mk₁ haQ
                  rw [hBot, Ideal.mem_bot] at hmkMem
                  exact (hmk_nzd ⟨a, ha_nzd⟩).2 hmkMem
                obtain ⟨_, ⟨_, _, hUniqR₁⟩⟩ :=
                  (IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime R₁).mp inferInstance
                have hMaxR₁Ne : IsLocalRing.maximalIdeal R₁ ≠ ⊥ :=
                  IsDiscreteValuationRing.not_a_field'
                have hQbarEqMax : Q_bar = IsLocalRing.maximalIdeal R₁ :=
                  (hUniqR₁ Q_bar ⟨hQbarNeBot, inferInstance⟩).trans
                    (hUniqR₁ (IsLocalRing.maximalIdeal R₁) ⟨hMaxR₁Ne, inferInstance⟩).symm
                haveI : Q_bar.IsMaximal := hQbarEqMax ▸ IsLocalRing.maximalIdeal.isMaximal R₁
                have hQIsMax : Q_sp.asIdeal.IsMaximal := by
                  rw [← hComapQbar]
                  exact Ideal.comap_isMaximal_of_surjective mk₁ Ideal.Quotient.mk_surjective
                exact IsLocalRing.eq_maximalIdeal hQIsMax
            rw [← hComapQ, hQMax]
            exact ((IsLocalRing.local_hom_TFAE f_AB).out 1 5).mp ‹IsLocalHom f_AB›
          have hCond4 : IsIntegrallyClosed A ∧ ∃! P : Ideal A, P ≠ ⊥ ∧ P.IsPrime :=
            ⟨hIC_A, hUniquePrime⟩
          have hPrincA : Submodule.IsPrincipal (IsLocalRing.maximalIdeal A) :=
            ((IsDiscreteValuationRing.TFAE A hNotFieldA).out 4 5).mp hCond4
          rcases hPrincA with ⟨⟨t_A, ht_A⟩⟩
          apply hNotPrincB
          refine ⟨⟨f_AB t_A, ?_⟩⟩
          have hSpanA : IsLocalRing.maximalIdeal A = Ideal.span {t_A} := ht_A
          rw [← hMapMax, hSpanA, Ideal.map_span, Set.image_singleton]

      have hZeroOfTmul : ∀ v : N, (1 : B) ⊗ₜ[A] v = 0 → v = 0 := by
        intro v hv0
        have hbTmul0 : ∀ b' : B, b' ⊗ₜ[A] v = 0 := by
          intro b'
          have hmul := congrArg (LinearMap.rTensor N (LinearMap.mulLeft A b')) hv0
          simpa using hmul
        let S_v : Submodule A N := Submodule.span A ({v} : Set N)
        have hInj_Sv : Function.Injective (LinearMap.lTensor B S_v.subtype) :=
          Module.Flat.lTensor_preserves_injective_linearMap S_v.subtype Subtype.val_injective
        have hSubT : Subsingleton (TensorProduct A B ↥S_v) := by
          refine Subsingleton.intro fun ξ₁ ξ₂ => hInj_Sv ?_
          have hZeroAll : ∀ ξ : TensorProduct A B ↥S_v, LinearMap.lTensor B S_v.subtype ξ = 0 := by
            intro ξ
            refine TensorProduct.induction_on
              (motive := fun ξ => LinearMap.lTensor B S_v.subtype ξ = 0)
              ξ (map_zero _) ?_ (fun _ _ h₁ h₂ => by rw [map_add, h₁, h₂, add_zero])
            rintro b' ⟨w, hw⟩
            obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hw
            change b' ⊗ₜ[A] (a • v) = 0
            rw [TensorProduct.tmul_smul]
            exact hbTmul0 (a • b')
          rw [hZeroAll ξ₁, hZeroAll ξ₂]
        have hSubSv : Subsingleton ↥S_v :=
          (Module.FaithfullyFlat.subsingleton_tensorProduct_iff_right A B).mp hSubT
        have hv_eq : (⟨v, Submodule.subset_span rfl⟩ : ↥S_v) = 0 := Subsingleton.elim _ _
        exact congrArg Subtype.val hv_eq

      have hAnnMax : ∀ (m : A), m ∈ IsLocalRing.maximalIdeal A → ∀ v : N, m • v = 0 := by
        intro m hm v
        apply hZeroOfTmul (m • v)
        apply hInj_Λbar
        rw [map_zero]
        have h1 : (1 : B) ⊗ₜ[A] (m • v) = m • ((1 : B) ⊗ₜ[A] v) := by
          rw [TensorProduct.tmul_smul]
        rw [h1, Λ_bar.map_smul]
        change ρ_B (f_AB m) * Λ_bar (1 ⊗ₜ[A] v) = 0
        have hfm : f_AB m ∈ RingHom.ker ρ_B := by
          rw [hKer_ρ, ← hMapMax]
          exact Ideal.mem_map_of_mem f_AB hm
        change ρ_B (f_AB m) = 0 at hfm
        rw [hfm, zero_mul]

      have hClause1 : ∀ (y : ↥A_tilde) (m : A), m ∈ IsLocalRing.maximalIdeal A →
          algebraMap A Q_A m * y.1 ∈ Set.range (algebraMap A Q_A) := by
        intro y m hm
        have h0 : I_A.mkQ (m • y) = 0 := by
          rw [map_smul]
          exact hAnnMax m hm (I_A.mkQ y)
        obtain ⟨a, ha⟩ := (Submodule.Quotient.mk_eq_zero I_A).mp h0
        refine ⟨a, ?_⟩
        have hval := congrArg Subtype.val ha
        simpa [Algebra.smul_def] using hval

      have hMaxBTmul : ∀ d ∈ IsLocalRing.maximalIdeal B, ∀ v : N, d ⊗ₜ[A] v = 0 := by
        intro d hd v
        rw [← hMapMax] at hd
        refine Submodule.span_induction (p := fun d _ => d ⊗ₜ[A] v = 0) ?_ ?_ ?_ ?_ hd
        · rintro _ ⟨m, hm, rfl⟩
          have hm1 : f_AB m = m • (1 : B) := by
            rw [Algebra.smul_def, mul_one]
            rfl
          rw [hm1, TensorProduct.smul_tmul, hAnnMax m hm v, TensorProduct.tmul_zero]
        · exact TensorProduct.zero_tmul B v
        · intro x₁ x₂ _ _ hx₁ hx₂
          rw [TensorProduct.add_tmul, hx₁, hx₂, add_zero]
        · intro r x _ hx
          have hmul := congrArg (LinearMap.rTensor N (LinearMap.mulLeft A r)) hx
          simpa [smul_eq_mul] using hmul

      have hbTmulRed : ∀ (b' : B) (v : N), b' ⊗ₜ[A] v = (1 : B) ⊗ₜ[A] (c_A (ρ_B b') • v) := by
        intro b' v
        have hDiffMax : b' - f_AB (c_A (ρ_B b')) ∈ IsLocalRing.maximalIdeal B := by
          rw [← hKer_ρ, RingHom.mem_ker, map_sub]
          have hc : ρ_B (f_AB (c_A (ρ_B b'))) = ρ_B b' :=
            RingHom.congr_fun hρ_c (ρ_B b')
          rw [hc, sub_self]
        have h0 := hMaxBTmul _ hDiffMax v
        rw [TensorProduct.sub_tmul, sub_eq_zero] at h0
        rw [h0]
        have hc1 : f_AB (c_A (ρ_B b')) = c_A (ρ_B b') • (1 : B) := by
          rw [Algebra.smul_def, mul_one]
          rfl
        rw [hc1, TensorProduct.smul_tmul]

      have hSurjPure : ∀ z : TensorProduct A B N, ∃ w : N, z = (1 : B) ⊗ₜ[A] w := by
        intro z
        refine TensorProduct.induction_on
          (motive := fun z => ∃ w : N, z = (1 : B) ⊗ₜ[A] w)
          z ⟨0, (TensorProduct.tmul_zero N (1 : B)).symm⟩ ?_ ?_
        · intro b' v
          exact ⟨c_A (ρ_B b') • v, hbTmulRed b' v⟩
        · rintro z₁ z₂ ⟨w₁, rfl⟩ ⟨w₂, rfl⟩
          exact ⟨w₁ + w₂, (TensorProduct.tmul_add 1 w₁ w₂).symm⟩

      have hNotSubTN : ¬ Subsingleton (TensorProduct A B N) :=
        fun h => hNotSubN ((Module.FaithfullyFlat.subsingleton_tensorProduct_iff_right A B).mp h)
      haveI : Nontrivial (TensorProduct A B N) := not_subsingleton_iff_nontrivial.mp hNotSubTN
      obtain ⟨z₀, hz₀_ne⟩ := exists_ne (0 : TensorProduct A B N)
      obtain ⟨w₀, rfl⟩ := hSurjPure z₀
      obtain ⟨y'₀, rfl⟩ := Submodule.mkQ_surjective I_A w₀
      let μ₀ : k₀ := Λ_bar ((1 : B) ⊗ₜ[A] I_A.mkQ y'₀)
      have hμ₀_ne : μ₀ ≠ 0 :=
        fun h0 => hz₀_ne (hInj_Λbar (h0.trans (map_zero Λ_bar).symm))
      let y₀ : ↥A_tilde := c_A μ₀⁻¹ • y'₀
      have hΛ_y₀ : Λ_bar ((1 : B) ⊗ₜ[A] I_A.mkQ y₀) = 1 := by
        change Λ_bar ((1 : B) ⊗ₜ[A] I_A.mkQ (c_A μ₀⁻¹ • y'₀)) = 1
        have h1 : (1 : B) ⊗ₜ[A] I_A.mkQ (c_A μ₀⁻¹ • y'₀) =
            c_A μ₀⁻¹ • ((1 : B) ⊗ₜ[A] I_A.mkQ y'₀) := by
          rw [map_smul, TensorProduct.tmul_smul]
        rw [h1, Λ_bar.map_smul]
        change ρ_B (f_AB (c_A μ₀⁻¹)) * μ₀ = 1
        have hc : ρ_B (f_AB (c_A μ₀⁻¹)) = μ₀⁻¹ := RingHom.congr_fun hρ_c μ₀⁻¹
        rw [hc, inv_mul_cancel₀ hμ₀_ne]
      have hy₀_not_range : y₀.1 ∉ Set.range (algebraMap A Q_A) := by
        rintro ⟨a, ha⟩
        have hMem : y₀ ∈ I_A := ⟨a, Subtype.ext ha⟩
        have hmk0 : I_A.mkQ y₀ = 0 := (Submodule.Quotient.mk_eq_zero I_A).mpr hMem
        have h0 : Λ_bar ((1 : B) ⊗ₜ[A] I_A.mkQ y₀) = 0 := by
          rw [hmk0, TensorProduct.tmul_zero, map_zero]
        rw [hΛ_y₀] at h0
        exact one_ne_zero h0
      refine ⟨hClause1, y₀, hy₀_not_range, ?_⟩
      intro y
      let c : k₀ := Λ_bar ((1 : B) ⊗ₜ[A] I_A.mkQ y)
      have hVanish : Λ_bar ((1 : B) ⊗ₜ[A] (I_A.mkQ y - c_A c • I_A.mkQ y₀)) = 0 := by
        have hsm : (1 : B) ⊗ₜ[A] (c_A c • I_A.mkQ y₀) =
            c_A c • ((1 : B) ⊗ₜ[A] I_A.mkQ y₀) := by
          rw [TensorProduct.tmul_smul]
        rw [TensorProduct.tmul_sub, map_sub, hsm, Λ_bar.map_smul, hΛ_y₀]
        change c - ρ_B (f_AB (c_A c)) * 1 = 0
        have hc : ρ_B (f_AB (c_A c)) = c := RingHom.congr_fun hρ_c c
        rw [hc, mul_one, sub_self]
      have hEqQ : I_A.mkQ (y - c_A c • y₀) = 0 := by
        rw [map_sub, map_smul]
        exact hZeroOfTmul _ (hInj_Λbar (hVanish.trans (map_zero Λ_bar).symm))
      obtain ⟨a, ha⟩ := (Submodule.Quotient.mk_eq_zero I_A).mp hEqQ
      refine ⟨c, a, ?_⟩
      have hval : algebraMap A Q_A a = y.1 - algebraMap A Q_A (c_A c) * y₀.1 := by
        simpa [Algebra.smul_def] using congrArg Subtype.val ha
      calc
        y.1 = algebraMap A Q_A (c_A c) * y₀.1 + (y.1 - algebraMap A Q_A (c_A c) * y₀.1) := by ring
        _ = algebraMap A Q_A (c_A c) * y₀.1 + algebraMap A Q_A a := by rw [← hval]

    dsimp only
    intro b hb hInfB _hMaxB_eq hNotPrincB hDVR ⟨ρ_B, hρ_c, hKer_ρ, hGlue⟩
    haveI : q.asIdeal.IsPrime := inferInstance
    haveI : u₀.asIdeal.IsPrime := u₀.isPrime
    let A := Localization.AtPrime q.asIdeal
    let B := Localization.AtPrime u₀.asIdeal
    have hNoethC : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing k₀ C
    haveI : IsNoetherianRing A := IsLocalization.isNoetherianRing q.asIdeal.primeCompl A hNoethC
    have hq_eq : q.asIdeal = Ideal.comap φ₁ u₀.asIdeal :=
      (congrArg PrimeSpectrum.asIdeal hComap).symm
    let f_AB : A →+* B := Localization.localRingHom q.asIdeal u₀.asIdeal φ₁ hq_eq
    letI : Algebra C B' := φ₁.toAlgebra
    haveI : Algebra.Etale C B' := hEt₁
    have hFlatφ₁ : φ₁.Flat := (inferInstance : Module.Flat C B')
    have hFlatAB : f_AB.Flat :=
      RingHom.Flat.localRingHom hFlatφ₁ u₀.asIdeal q.asIdeal hq_eq
    have hLocAB : IsLocalHom f_AB :=
      Localization.isLocalHom_localRingHom q.asIdeal u₀.asIdeal φ₁ hq_eq
    have hMapMax : Ideal.map f_AB (IsLocalRing.maximalIdeal A) = IsLocalRing.maximalIdeal B := by
      letI : Algebra A B := f_AB.toAlgebra
      haveI : IsScalarTower C A B := by
        refine IsScalarTower.of_algebraMap_eq fun c => ?_
        rw [IsScalarTower.algebraMap_apply C B' B c]
        change algebraMap B' B (φ₁ c) = f_AB (algebraMap C A c)
        exact (Localization.localRingHom_to_map q.asIdeal u₀.asIdeal φ₁ hq_eq c).symm
      haveI : IsLocalHom (algebraMap A B) := hLocAB
      haveI : Algebra.EssFiniteType C B := Algebra.EssFiniteType.comp C B' B
      haveI : Algebra.EssFiniteType A B := Algebra.EssFiniteType.of_comp C A B
      have hUnramCB : Algebra.FormallyUnramified C B := Algebra.FormallyUnramified.comp C B' B
      haveI : Algebra.FormallyUnramified A B := by
        rw [Algebra.FormallyUnramified.iff_comp_injective (R := A) (A := B)]
        intro R_t _ _ I_t hI_t g₁ g₂ hEq
        letI : Algebra C R_t := ((algebraMap A R_t).comp (algebraMap C A)).toAlgebra
        haveI : IsScalarTower C A R_t := IsScalarTower.of_algebraMap_eq' rfl
        have hEq' : (Ideal.Quotient.mkₐ C I_t).comp (g₁.restrictScalars C) =
            (Ideal.Quotient.mkₐ C I_t).comp (g₂.restrictScalars C) := by
          apply AlgHom.ext
          intro r
          exact AlgHom.congr_fun hEq r
        have hg := (Algebra.FormallyUnramified.iff_comp_injective
          (R := C) (A := B)).mp hUnramCB I_t hI_t hEq'
        apply AlgHom.ext
        intro r
        exact AlgHom.congr_fun hg r
      exact Algebra.FormallyUnramified.map_maximalIdeal
    let c_A : k₀ →+* A := (algebraMap C A).comp (algebraMap k₀ C)
    have hComp_cB : f_AB.comp c_A = (algebraMap B' B).comp (φ₁.comp (algebraMap k₀ C)) := by
      ext x
      exact Localization.localRingHom_to_map q.asIdeal u₀.asIdeal φ₁ hq_eq (algebraMap k₀ C x)
    rw [← hComp_cB] at hρ_c
    exact hAbstract4 A B f_AB c_A b ρ_B hFlatAB hLocAB hMapMax hb hInfB hNotPrincB hDVR
      hρ_c hKer_ρ hGlue

  
  have hS3 :
      ∀ (C : Type u) [CommRing C] [_root_.IsReduced C] [Algebra k₀ C] [Algebra.FiniteType k₀ C]
        (S_sing : Finset (PrimeSpectrum C)),
        (∀ q ∈ S_sing, q.asIdeal.IsMaximal) →
        (∀ q : PrimeSpectrum C, q.asIdeal.IsMaximal → q ∉ S_sing →
          ∃ g : C, g ∉ q.asIdeal ∧
            IsDomain (Localization.Away g) ∧
            IsIntegrallyClosed (Localization.Away g)) →
        (∀ q ∈ S_sing,
          let A := Localization.AtPrime q.asIdeal
          let Q_A := Localization (nonZeroDivisors A)
          let A_tilde := integralClosure A Q_A
          (∀ (y : ↥A_tilde) (m : A), m ∈ IsLocalRing.maximalIdeal A →
            algebraMap A Q_A m * y.1 ∈ Set.range (algebraMap A Q_A)) ∧
          (∃ y₀ : ↥A_tilde, y₀.1 ∉ Set.range (algebraMap A Q_A) ∧
            ∀ y : ↥A_tilde, ∃ (c : k₀) (a : A),
              y.1 = algebraMap A Q_A (algebraMap C A (algebraMap k₀ C c)) * y₀.1 +
                algebraMap A Q_A a)) →
        let Q := Localization (nonZeroDivisors C)
        let C_tilde := integralClosure C Q
        let W_C : Submodule k₀ Q := LinearMap.range (IsScalarTower.toAlgHom k₀ C Q).toLinearMap
        let W_tilde : Submodule k₀ Q := C_tilde.toSubmodule.restrictScalars k₀
        Module.Finite k₀ (↥W_tilde ⧸ W_C.comap W_tilde.subtype) ∧
        Module.finrank k₀ (↥W_tilde ⧸ W_C.comap W_tilde.subtype) = S_sing.card ∧
        ((∀ q ∈ S_sing,
            ∃ 𝔭₁ ∈ minimalPrimes C, ∃ 𝔭₂ ∈ minimalPrimes C,
              𝔭₁ ≠ 𝔭₂ ∧ 𝔭₁ ≤ q.asIdeal ∧ 𝔭₂ ≤ q.asIdeal) →
          ∀ 𝔭 ∈ minimalPrimes C, IsIntegrallyClosed (C ⧸ 𝔭)) := by
    clear hEtDVR hS2 hS4
    intro C _ _ _ _ S_sing hMax hSm hLocNod
    classical
    dsimp only
    let Q := Localization (nonZeroDivisors C)
    let C_tilde := integralClosure C Q
    let W_C : Submodule k₀ Q := LinearMap.range (IsScalarTower.toAlgHom k₀ C Q).toLinearMap
    let W_tilde : Submodule k₀ Q := C_tilde.toSubmodule.restrictScalars k₀

    by_cases hSubC : Subsingleton C
    · haveI : Subsingleton C := hSubC
      haveI : IsEmpty (PrimeSpectrum C) :=
        ⟨fun p => p.isPrime.ne_top (Subsingleton.elim p.asIdeal ⊤)⟩
      have hSingEmpty : S_sing = ∅ := Finset.eq_empty_of_isEmpty S_sing
      have h0_nzd : (0 : C) ∈ nonZeroDivisors C :=
        mem_nonZeroDivisors_iff.mpr
          ⟨fun x _ => Subsingleton.elim x 0, fun x _ => Subsingleton.elim x 0⟩
      have hUnit0 : IsUnit (0 : Q) := by
        have hu := IsLocalization.map_units Q (⟨0, h0_nzd⟩ : nonZeroDivisors C)
        simpa using hu
      haveI : Subsingleton Q := subsingleton_of_zero_eq_one (by
        rcases hUnit0 with ⟨u, hu⟩
        calc
          (0 : Q) = 0 * ↑u⁻¹ := (zero_mul _).symm
          _ = ↑u * ↑u⁻¹ := by rw [hu]
          _ = 1 := Units.mul_inv u)
      haveI : Subsingleton (↥W_tilde ⧸ W_C.comap W_tilde.subtype) := inferInstance
      refine ⟨inferInstance, ?_, ?_⟩
      · rw [hSingEmpty, Finset.card_empty]
        exact Module.finrank_zero_of_subsingleton
      · intro _ 𝔭 h𝔭
        exact False.elim (h𝔭.1.1.ne_top (Subsingleton.elim 𝔭 ⊤))

    haveI : Nontrivial C := not_subsingleton_iff_nontrivial.mp hSubC
    haveI : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing k₀ C
    have hFinMin : (minimalPrimes C).Finite := minimalPrimes.finite_of_isNoetherianRing C
    let M_fin : Finset (Ideal C) := hFinMin.toFinset
    let ℳ := ↥M_fin
    have hℳ_min : ∀ 𝔭 : ℳ, 𝔭.1 ∈ minimalPrimes C :=
      fun 𝔭 => hFinMin.mem_toFinset.mp 𝔭.2
    haveI hℳ_prime : ∀ 𝔭 : ℳ, 𝔭.1.IsPrime := fun 𝔭 => (hℳ_min 𝔭).1.1
    haveI hℳ_dom : ∀ 𝔭 : ℳ, IsDomain (C ⧸ 𝔭.1) := fun 𝔭 => Ideal.Quotient.isDomain 𝔭.1
    let K_p : ℳ → Type u := fun 𝔭 => FractionRing (C ⧸ 𝔭.1)
    let Pi_K := ∀ 𝔭 : ℳ, K_p 𝔭

    have hZeroIff : ∀ c : C, c = 0 ↔ ∀ 𝔭 : ℳ, c ∈ 𝔭.1 := by
      intro c
      constructor
      · rintro rfl 𝔭
        exact 𝔭.1.zero_mem
      · intro hc
        have hcNil : c ∈ nilradical C := by
          rw [nilradical_eq_sInf, Ideal.mem_sInf]
          intro P hP
          haveI : P.IsPrime := hP
          obtain ⟨𝔭₀, h𝔭₀, hle⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal C) ≤ P)
          exact hle (hc ⟨𝔭₀, hFinMin.mem_toFinset.mpr h𝔭₀⟩)
        rwa [nilradical_eq_zero] at hcNil

    have hSepPair : ∀ 𝔭 𝔮 : ℳ, 𝔮 ≠ 𝔭 → ∃ y : C, y ∈ 𝔮.1 ∧ y ∉ 𝔭.1 := by
      intro 𝔭 𝔮 hne
      have hNotLe : ¬ (𝔮.1 ≤ 𝔭.1) := fun hle =>
        hne (Subtype.ext (le_antisymm hle ((hℳ_min 𝔭).2 (hℳ_min 𝔮).1 hle)))
      exact Set.not_subset.mp hNotLe

    let sep_y : ℳ → ℳ → C := fun 𝔭 𝔮 =>
      if h : 𝔮 ≠ 𝔭 then (hSepPair 𝔭 𝔮 h).choose else 1
    let z_p : ℳ → C := fun 𝔭 => ∏ 𝔮 ∈ Finset.univ.erase 𝔭, sep_y 𝔭 𝔮

    have hzp_not_self : ∀ 𝔭 : ℳ, z_p 𝔭 ∉ 𝔭.1 := by
      intro 𝔭 hMem
      obtain ⟨𝔮, h𝔮, hyMem⟩ := Ideal.IsPrime.prod_mem_iff.mp hMem
      have hne : 𝔮 ≠ 𝔭 := (Finset.mem_erase.mp h𝔮).1
      dsimp only [sep_y] at hyMem
      rw [dif_pos hne] at hyMem
      exact (hSepPair 𝔭 𝔮 hne).choose_spec.2 hyMem

    have hzp_mem_other : ∀ 𝔭 𝔮 : ℳ, 𝔮 ≠ 𝔭 → z_p 𝔭 ∈ 𝔮.1 := by
      intro 𝔭 𝔮 hne
      have h𝔮_er : 𝔮 ∈ (Finset.univ : Finset ℳ).erase 𝔭 :=
        Finset.mem_erase.mpr ⟨hne, Finset.mem_univ 𝔮⟩
      have hfac : sep_y 𝔭 𝔮 ∈ 𝔮.1 := by
        dsimp only [sep_y]
        rw [dif_pos hne]
        exact (hSepPair 𝔭 𝔮 hne).choose_spec.1
      dsimp only [z_p]
      rw [← Finset.mul_prod_erase _ _ h𝔮_er]
      exact Ideal.mul_mem_right _ _ hfac

    have hNzdIff : ∀ s : C, s ∈ nonZeroDivisors C ↔ ∀ 𝔭 : ℳ, s ∉ 𝔭.1 := by
      intro s
      constructor
      · intro hs 𝔭 hsMem
        have hzs0 : z_p 𝔭 * s = 0 := by
          rw [hZeroIff]
          intro 𝔮
          by_cases hne : 𝔮 = 𝔭
          · subst hne; exact Ideal.mul_mem_left _ _ hsMem
          · exact Ideal.mul_mem_right _ _ (hzp_mem_other 𝔭 𝔮 hne)
        have hzp0 : z_p 𝔭 = 0 := (mem_nonZeroDivisors_iff.mp hs).2 (z_p 𝔭) hzs0
        exact hzp_not_self 𝔭 (hzp0 ▸ 𝔭.1.zero_mem)
      · intro hs
        rw [mem_nonZeroDivisors_iff_right]
        intro d hds
        rw [hZeroIff]
        intro 𝔭
        have hMem : d * s ∈ 𝔭.1 := hds ▸ 𝔭.1.zero_mem
        exact ((hℳ_prime 𝔭).mem_or_mem hMem).resolve_right (hs 𝔭)

    let toKp : ∀ 𝔭 : ℳ, C →+* K_p 𝔭 :=
      fun 𝔭 => (algebraMap (C ⧸ 𝔭.1) (K_p 𝔭)).comp (Ideal.Quotient.mk 𝔭.1)
    let ι_Pi : C →+* Pi_K := Pi.ringHom toKp
    have hUnits_ιPi : ∀ s : nonZeroDivisors C, IsUnit (ι_Pi s) := by
      intro s
      rw [Pi.isUnit_iff]
      intro 𝔭
      have hsNot : s.1 ∉ 𝔭.1 := (hNzdIff s.1).mp s.2 𝔭
      have hmkNe : Ideal.Quotient.mk 𝔭.1 s.1 ≠ 0 :=
        fun h0 => hsNot (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      have hKpNe : toKp 𝔭 s.1 ≠ 0 :=
        fun h0 => hmkNe (IsFractionRing.injective (C ⧸ 𝔭.1) (K_p 𝔭)
          (h0.trans (map_zero _).symm))
      exact IsUnit.mk0 _ hKpNe

    let Ψ_Q : Q →+* Pi_K := IsLocalization.lift (M := nonZeroDivisors C) (S := Q) hUnits_ιPi
    have hΨ_alg : ∀ (c : C) (𝔭 : ℳ), Ψ_Q (algebraMap C Q c) 𝔭 = toKp 𝔭 c := by
      intro c 𝔭
      change (Ψ_Q (algebraMap C Q c)) 𝔭 = _
      rw [IsLocalization.lift_eq]
      rfl

    have hInj_Ψ : Function.Injective Ψ_Q := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨c, s⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors C) x
      dsimp only at hx ⊢
      have hc0 : c = 0 := by
        rw [hZeroIff]
        intro 𝔭
        have hmul : Ψ_Q (IsLocalization.mk' Q c s * algebraMap C Q s.1) 𝔭 = 0 := by
          rw [map_mul, hx, zero_mul, Pi.zero_apply]
        rw [IsLocalization.mk'_spec, hΨ_alg] at hmul
        have hmk0 : Ideal.Quotient.mk 𝔭.1 c = 0 :=
          IsFractionRing.injective (C ⧸ 𝔭.1) (K_p 𝔭) (hmul.trans (map_zero _).symm)
        exact Ideal.Quotient.eq_zero_iff_mem.mp hmk0
      rw [hc0, IsLocalization.mk'_zero]

    have hSurj_Ψ : Function.Surjective Ψ_Q := by
      intro f
      have hExAB : ∀ 𝔭 : ℳ, ∃ (a b : C) (_ : b ∉ 𝔭.1),
          f 𝔭 * toKp 𝔭 b = toKp 𝔭 a := by
        intro 𝔭
        obtain ⟨⟨a_bar, b_bar⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors (C ⧸ 𝔭.1)) (f 𝔭)
        dsimp only at hab
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a_bar
        obtain ⟨b, hb_eq⟩ := Ideal.Quotient.mk_surjective b_bar.1
        have hb_ne : b_bar.1 ≠ 0 := nonZeroDivisors.ne_zero b_bar.2
        have hb_not : b ∉ 𝔭.1 := by
          intro hbM
          apply hb_ne
          rw [← hb_eq]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr hbM
        refine ⟨a, b, hb_not, ?_⟩
        change f 𝔭 * algebraMap (C ⧸ 𝔭.1) (K_p 𝔭) (Ideal.Quotient.mk 𝔭.1 b) = _
        rw [hb_eq]
        exact hab
      let a_fn : ℳ → C := fun 𝔭 => (hExAB 𝔭).choose
      let b_fn : ℳ → C := fun 𝔭 => (hExAB 𝔭).choose_spec.choose
      have hb_not : ∀ 𝔭 : ℳ, b_fn 𝔭 ∉ 𝔭.1 :=
        fun 𝔭 => (hExAB 𝔭).choose_spec.choose_spec.choose
      have hab_eq : ∀ 𝔭 : ℳ, f 𝔭 * toKp 𝔭 (b_fn 𝔭) = toKp 𝔭 (a_fn 𝔭) :=
        fun 𝔭 => (hExAB 𝔭).choose_spec.choose_spec.choose_spec
      let num : C := ∑ 𝔭 : ℳ, a_fn 𝔭 * z_p 𝔭
      let den : C := ∑ 𝔭 : ℳ, b_fn 𝔭 * z_p 𝔭
      have hSumMod : ∀ (g : ℳ → C) (𝔭₀ : ℳ),
          Ideal.Quotient.mk 𝔭₀.1 (∑ 𝔭 : ℳ, g 𝔭 * z_p 𝔭) =
            Ideal.Quotient.mk 𝔭₀.1 (g 𝔭₀ * z_p 𝔭₀) := by
        intro g 𝔭₀
        rw [map_sum, Finset.sum_eq_single 𝔭₀]
        · intro 𝔭 _ hne
          rw [map_mul, Ideal.Quotient.eq_zero_iff_mem.mpr (hzp_mem_other 𝔭 𝔭₀ hne.symm), mul_zero]
        · intro hNotUniv
          exact False.elim (hNotUniv (Finset.mem_univ 𝔭₀))
      have hden_nzd : den ∈ nonZeroDivisors C := by
        rw [hNzdIff]
        intro 𝔭₀ hdenMem
        have h0 : Ideal.Quotient.mk 𝔭₀.1 den = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr hdenMem
        rw [hSumMod b_fn 𝔭₀] at h0
        have hProdMem : b_fn 𝔭₀ * z_p 𝔭₀ ∈ 𝔭₀.1 := Ideal.Quotient.eq_zero_iff_mem.mp h0
        rcases (hℳ_prime 𝔭₀).mem_or_mem hProdMem with hbM | hzM
        · exact hb_not 𝔭₀ hbM
        · exact hzp_not_self 𝔭₀ hzM
      refine ⟨IsLocalization.mk' Q num ⟨den, hden_nzd⟩, ?_⟩
      funext 𝔭₀
      have hden_unit : IsUnit (toKp 𝔭₀ den) := by
        have hhu := hUnits_ιPi ⟨den, hden_nzd⟩
        exact (Pi.isUnit_iff.mp hhu) 𝔭₀
      apply hden_unit.mul_right_cancel
      have hLHS : Ψ_Q (IsLocalization.mk' Q num ⟨den, hden_nzd⟩) 𝔭₀ * toKp 𝔭₀ den =
          toKp 𝔭₀ num := by
        rw [← hΨ_alg den 𝔭₀, ← Pi.mul_apply, ← map_mul Ψ_Q, IsLocalization.mk'_spec, hΨ_alg]
      rw [hLHS]
      have hden_eq : toKp 𝔭₀ den = toKp 𝔭₀ (b_fn 𝔭₀) * toKp 𝔭₀ (z_p 𝔭₀) := by
        dsimp [toKp]
        rw [hSumMod b_fn 𝔭₀, map_mul, map_mul]
      have hnum_eq : toKp 𝔭₀ num = toKp 𝔭₀ (a_fn 𝔭₀) * toKp 𝔭₀ (z_p 𝔭₀) := by
        dsimp [toKp]
        rw [hSumMod a_fn 𝔭₀, map_mul, map_mul]
      rw [hden_eq, hnum_eq, ← mul_assoc, hab_eq 𝔭₀]

    have hIntQ : ∀ x : Q, x ∈ C_tilde ↔ ∀ 𝔭 : ℳ, IsIntegral (C ⧸ 𝔭.1) (Ψ_Q x 𝔭) := by
      intro x
      constructor
      · intro hx 𝔭
        let ev_alg : Q →ₐ[C] K_p 𝔭 :=
          { toRingHom := (Pi.evalRingHom K_p 𝔭).comp Ψ_Q
            commutes' := fun c => by
              change Ψ_Q (algebraMap C Q c) 𝔭 = algebraMap C (K_p 𝔭) c
              rw [hΨ_alg, IsScalarTower.algebraMap_apply C (C ⧸ 𝔭.1) (K_p 𝔭)]
              rfl }
        have hIntC : IsIntegral C (Ψ_Q x 𝔭) := IsIntegral.map ev_alg hx
        exact IsIntegral.tower_top (R := C) (A := C ⧸ 𝔭.1) (B := K_p 𝔭) hIntC
      · intro hAll
        have hLiftP : ∀ 𝔭 : ℳ, ∃ P : Polynomial C,
            P.Monic ∧ Polynomial.eval₂ (toKp 𝔭) (Ψ_Q x 𝔭) P = 0 := by
          intro 𝔭
          obtain ⟨p, hpMon, hpEval⟩ := hAll 𝔭
          have hpLifts : p ∈ Polynomial.lifts (Ideal.Quotient.mk 𝔭.1) := by
            rw [Polynomial.lifts_iff_coeff_lifts]
            intro n
            exact Ideal.Quotient.mk_surjective (p.coeff n)
          obtain ⟨P, hP_map, _, hP_mon⟩ :=
            Polynomial.lifts_and_natDegree_eq_and_monic hpLifts hpMon
          refine ⟨P, hP_mon, ?_⟩
          have hEvalEq : Polynomial.eval₂ (toKp 𝔭) (Ψ_Q x 𝔭) P =
              Polynomial.eval₂ (algebraMap (C ⧸ 𝔭.1) (K_p 𝔭)) (Ψ_Q x 𝔭)
                (Polynomial.map (Ideal.Quotient.mk 𝔭.1) P) := by
            rw [Polynomial.eval₂_map]
          rw [hEvalEq, hP_map]
          exact hpEval
        let P_fn : ℳ → Polynomial C := fun 𝔭 => (hLiftP 𝔭).choose
        let P_prod : Polynomial C := ∏ 𝔭 : ℳ, P_fn 𝔭
        have hMonProd : P_prod.Monic :=
          Polynomial.monic_prod_of_monic Finset.univ P_fn (fun 𝔭 _ => (hLiftP 𝔭).choose_spec.1)
        refine ⟨P_prod, hMonProd, ?_⟩
        apply hInj_Ψ
        rw [map_zero]
        funext 𝔭₀
        let ev_𝔭₀ : Q →+* K_p 𝔭₀ := (Pi.evalRingHom K_p 𝔭₀).comp Ψ_Q
        have hComp : ev_𝔭₀.comp (algebraMap C Q) = toKp 𝔭₀ := by
          ext c
          exact hΨ_alg c 𝔭₀
        change ev_𝔭₀ (Polynomial.eval₂ (algebraMap C Q) x P_prod) = 0
        rw [Polynomial.hom_eval₂, hComp]
        dsimp only [P_prod]
        have h0 : Polynomial.eval₂ (toKp 𝔭₀) (ev_𝔭₀ x) (P_fn 𝔭₀) = 0 :=
          (hLiftP 𝔭₀).choose_spec.2
        rw [← Finset.mul_prod_erase Finset.univ P_fn (Finset.mem_univ 𝔭₀),
          Polynomial.eval₂_mul, h0, zero_mul]

    have hNzdLoc : ∀ (𝔪 : Ideal C) [𝔪.IsPrime] (s : nonZeroDivisors C),
        algebraMap C (Localization.AtPrime 𝔪) s.1 ∈
          nonZeroDivisors (Localization.AtPrime 𝔪) := by
      intro 𝔪 _ s
      rw [mem_nonZeroDivisors_iff_right]
      intro z hz
      obtain ⟨⟨c, t⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔪.primeCompl z
      dsimp only at hz ⊢
      have hcs : IsLocalization.mk' (Localization.AtPrime 𝔪) (c * s.1) t = 0 := by
        have hmul : IsLocalization.mk' (Localization.AtPrime 𝔪) c t *
            algebraMap C (Localization.AtPrime 𝔪) s.1 =
            IsLocalization.mk' (Localization.AtPrime 𝔪) (c * s.1) t := by
          rw [← IsLocalization.mk'_one (M := 𝔪.primeCompl) (Localization.AtPrime 𝔪) s.1,
            ← IsLocalization.mk'_mul, mul_one]
        rwa [← hmul]
      rw [IsLocalization.mk'_eq_zero_iff] at hcs
      obtain ⟨u, hu⟩ := hcs
      have huc0 : u.1 * c = 0 :=
        (mem_nonZeroDivisors_iff.mp s.2).2 (u.1 * c) (by rw [mul_assoc]; exact hu)
      rw [IsLocalization.mk'_eq_zero_iff]
      exact ⟨u, huc0⟩

    let resAt : ∀ (𝔪 : Ideal C) [𝔪.IsPrime],
        Q →+* Localization (nonZeroDivisors (Localization.AtPrime 𝔪)) :=
      fun 𝔪 _ =>
        IsLocalization.lift (M := nonZeroDivisors C) (S := Q)
          (g := (algebraMap (Localization.AtPrime 𝔪)
            (Localization (nonZeroDivisors (Localization.AtPrime 𝔪)))).comp
            (algebraMap C (Localization.AtPrime 𝔪)))
          (fun s => IsLocalization.map_units _ ⟨_, hNzdLoc 𝔪 s⟩)

    have hResAt_alg : ∀ (𝔪 : Ideal C) [𝔪.IsPrime] (c : C),
        resAt 𝔪 (algebraMap C Q c) =
          algebraMap (Localization.AtPrime 𝔪) _ (algebraMap C (Localization.AtPrime 𝔪) c) :=
      fun 𝔪 _ c => IsLocalization.lift_eq _ c

    have hResAt_int : ∀ (𝔪 : Ideal C) [𝔪.IsPrime] (x : Q),
        x ∈ C_tilde →
        resAt 𝔪 x ∈ integralClosure (Localization.AtPrime 𝔪)
          (Localization (nonZeroDivisors (Localization.AtPrime 𝔪))) := by
      intro 𝔪 _ x hx
      let A := Localization.AtPrime 𝔪
      let Q_A := Localization (nonZeroDivisors A)
      let res_alg : Q →ₐ[C] Q_A :=
        { toRingHom := resAt 𝔪
          commutes' := fun c => by
            change resAt 𝔪 (algebraMap C Q c) = algebraMap C Q_A c
            rw [hResAt_alg, IsScalarTower.algebraMap_apply C A Q_A] }
      have hIntC : IsIntegral C (resAt 𝔪 x) := IsIntegral.map res_alg hx
      exact IsIntegral.tower_top (R := C) (A := A) (B := Q_A) hIntC

    have hZeroFromQA : ∀ (𝔪 : Ideal C) [𝔪.IsPrime] (x : Q),
        resAt 𝔪 x = 0 →
        ∃ u_m : C, u_m ∉ 𝔪 ∧ algebraMap C Q u_m * x = 0 := by
      intro 𝔪 _ x h0
      let A := Localization.AtPrime 𝔪
      let Q_A := Localization (nonZeroDivisors A)
      obtain ⟨⟨c₁, d₁⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors C) x
      dsimp only at h0 ⊢
      have hMulQA : algebraMap A Q_A (algebraMap C A c₁) = 0 := by
        rw [← hResAt_alg 𝔪 c₁, ← IsLocalization.mk'_spec Q c₁ d₁, map_mul, h0, zero_mul]
      have hEqA : algebraMap C A c₁ = 0 :=
        IsLocalization.injective Q_A (le_refl (nonZeroDivisors A))
          (hMulQA.trans (map_zero _).symm)
      obtain ⟨t₁, ht₁⟩ := (IsLocalization.eq_iff_exists 𝔪.primeCompl A).mp
        (hEqA.trans (map_zero (algebraMap C A)).symm)
      rw [mul_zero] at ht₁
      refine ⟨t₁.1, t₁.2, ?_⟩
      apply (IsLocalization.map_units Q d₁).mul_right_cancel
      rw [zero_mul, mul_assoc, IsLocalization.mk'_spec, ← map_mul, ht₁, map_zero]

    have hLiftFromQA : ∀ (𝔪 : Ideal C) [𝔪.IsPrime] (x : Q),
        resAt 𝔪 x ∈ Set.range (algebraMap (Localization.AtPrime 𝔪) _) →
        ∃ u_m : C, u_m ∉ 𝔪 ∧ algebraMap C Q u_m * x ∈ W_C := by
      rintro 𝔪 _ x ⟨a₀, hEq⟩
      let A := Localization.AtPrime 𝔪
      let Q_A := Localization (nonZeroDivisors A)
      obtain ⟨⟨c₁, d₁⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors C) x
      obtain ⟨⟨c₀, t₀⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔪.primeCompl a₀
      dsimp only at hEq ⊢
      have hMulQA : resAt 𝔪 (IsLocalization.mk' Q c₁ d₁) *
          algebraMap A Q_A (algebraMap C A d₁.1) =
          algebraMap A Q_A (algebraMap C A c₁) := by
        rw [← hResAt_alg 𝔪 d₁.1, ← map_mul, IsLocalization.mk'_spec, hResAt_alg]
      rw [← hEq, ← map_mul] at hMulQA
      have hEqA : IsLocalization.mk' A c₀ t₀ * algebraMap C A d₁.1 = algebraMap C A c₁ :=
        IsLocalization.injective Q_A (le_refl (nonZeroDivisors A)) hMulQA
      have hEqA' : algebraMap C A (c₀ * d₁.1) = algebraMap C A (c₁ * t₀.1) := by
        calc
          algebraMap C A (c₀ * d₁.1) =
              (IsLocalization.mk' A c₀ t₀ * algebraMap C A t₀.1) * algebraMap C A d₁.1 := by
            rw [IsLocalization.mk'_spec, map_mul]
          _ = (IsLocalization.mk' A c₀ t₀ * algebraMap C A d₁.1) * algebraMap C A t₀.1 := by ring
          _ = algebraMap C A (c₁ * t₀.1) := by rw [hEqA, map_mul]
      obtain ⟨t₁, ht₁⟩ := (IsLocalization.eq_iff_exists 𝔪.primeCompl A).mp hEqA'
      refine ⟨t₁.1 * t₀.1, 𝔪.primeCompl.mul_mem t₁.2 t₀.2, t₁.1 * c₀, ?_⟩
      apply (IsLocalization.map_units Q d₁).mul_right_cancel
      calc
        algebraMap C Q (t₁.1 * c₀) * algebraMap C Q d₁.1 =
            algebraMap C Q (t₁.1 * (c₀ * d₁.1)) := by
          rw [← map_mul]; exact congrArg (algebraMap C Q) (by ring)
        _ = algebraMap C Q (t₁.1 * (c₁ * t₀.1)) := by rw [ht₁]
        _ = algebraMap C Q (t₁.1 * t₀.1) *
              (IsLocalization.mk' Q c₁ d₁ * algebraMap C Q d₁.1) := by
          rw [IsLocalization.mk'_spec, ← map_mul]
          exact congrArg (algebraMap C Q) (by ring)
        _ = algebraMap C Q (t₁.1 * t₀.1) * IsLocalization.mk' Q c₁ d₁ *
              algebraMap C Q d₁.1 := by ring

    have hSmAnn : ∀ (q : PrimeSpectrum C), q.asIdeal.IsMaximal → q ∉ S_sing →
        ∀ x ∈ C_tilde, ∃ u_q : C, u_q ∉ q.asIdeal ∧ algebraMap C Q u_q * x ∈ W_C := by
      intro q hqMax hqNot x hx
      obtain ⟨g, hgNot, hDomLg, hICLg⟩ := hSm q hqMax hqNot
      let L_g := Localization.Away g
      letI : IsDomain L_g := hDomLg
      haveI : IsIntegrallyClosed L_g := hICLg
      let φ_g : C →+* L_g := algebraMap C L_g
      let 𝔭_g : Ideal C := RingHom.ker φ_g
      haveI : 𝔭_g.IsPrime := RingHom.ker_isPrime φ_g
      have hg_not_𝔭g : g ∉ 𝔭_g := by
        intro hgKer
        have hUnitg : IsUnit (φ_g g) := IsLocalization.Away.algebraMap_isUnit g
        change φ_g g = 0 at hgKer
        rw [hgKer] at hUnitg
        exact not_isUnit_zero hUnitg
      obtain ⟨𝔭₀_id, h𝔭₀_min, h𝔭₀_le⟩ :=
        Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal C) ≤ 𝔭_g)
      let 𝔭₀ : ℳ := ⟨𝔭₀_id, hFinMin.mem_toFinset.mpr h𝔭₀_min⟩
      have hg_not_𝔭₀ : g ∉ 𝔭₀.1 := fun hgM => hg_not_𝔭g (h𝔭₀_le hgM)
      have hKerEq : 𝔭_g = 𝔭₀.1 := by
        apply le_antisymm _ h𝔭₀_le
        intro c hc
        change φ_g c = 0 at hc
        obtain ⟨⟨_, k, rfl⟩, hkc⟩ :=
          (IsLocalization.eq_iff_exists (Submonoid.powers g) L_g).mp
            (hc.trans (map_zero φ_g).symm)
        dsimp only at hkc
        rw [mul_zero] at hkc
        have hMem : g ^ k * c ∈ 𝔭₀.1 := hkc ▸ 𝔭₀.1.zero_mem
        have hgkNot : g ^ k ∉ 𝔭₀.1 :=
          fun hpow => hg_not_𝔭₀ ((hℳ_prime 𝔭₀).mem_of_pow_mem k hpow)
        exact ((hℳ_prime 𝔭₀).mem_or_mem hMem).resolve_left hgkNot
      have hg_in_other : ∀ 𝔮 : ℳ, 𝔮 ≠ 𝔭₀ → g ∈ 𝔮.1 := by
        intro 𝔮 hne
        have hz_in_𝔭₀ : z_p 𝔮 ∈ 𝔭_g := by
          rw [hKerEq]
          exact hzp_mem_other 𝔮 𝔭₀ hne.symm
        change φ_g (z_p 𝔮) = 0 at hz_in_𝔭₀
        obtain ⟨⟨_, k, rfl⟩, hkz⟩ :=
          (IsLocalization.eq_iff_exists (Submonoid.powers g) L_g).mp
            (hz_in_𝔭₀.trans (map_zero φ_g).symm)
        dsimp only at hkz
        rw [mul_zero] at hkz
        have hMem : g ^ k * z_p 𝔮 ∈ 𝔮.1 := hkz ▸ 𝔮.1.zero_mem
        have hgkMem : g ^ k ∈ 𝔮.1 :=
          ((hℳ_prime 𝔮).mem_or_mem hMem).resolve_right (hzp_not_self 𝔮)
        exact (hℳ_prime 𝔮).mem_of_pow_mem k hgkMem

      let F_g := FractionRing L_g
      let ι_quot : (C ⧸ 𝔭₀.1) →+* L_g :=
        (RingHom.kerLift φ_g).comp (Ideal.quotEquivOfEq hKerEq.symm).toRingHom
      have hInj_ιq : Function.Injective ι_quot :=
        (RingHom.kerLift_injective φ_g).comp (Ideal.quotEquivOfEq hKerEq.symm).injective
      let toFg : (C ⧸ 𝔭₀.1) →+* F_g := (algebraMap L_g F_g).comp ι_quot
      have hInj_toFg : Function.Injective toFg :=
        (IsFractionRing.injective L_g F_g).comp hInj_ιq
      have hUnits_toFg : ∀ t : nonZeroDivisors (C ⧸ 𝔭₀.1), IsUnit (toFg t) := by
        intro t
        have ht0 : t.1 ≠ 0 := nonZeroDivisors.ne_zero t.2
        exact IsUnit.mk0 _ (fun h0 => ht0 (hInj_toFg (h0.trans (map_zero _).symm)))
      let j_g : K_p 𝔭₀ →+* F_g :=
        IsLocalization.lift (M := nonZeroDivisors (C ⧸ 𝔭₀.1)) (S := K_p 𝔭₀) hUnits_toFg
      have hjg_toKp : ∀ c : C, j_g (toKp 𝔭₀ c) = algebraMap L_g F_g (φ_g c) := by
        intro c
        dsimp [j_g, toKp]
        rw [IsLocalization.lift_eq]
        rfl
      letI : Algebra (C ⧸ 𝔭₀.1) L_g := ι_quot.toAlgebra
      let j_g_alg : K_p 𝔭₀ →ₐ[C ⧸ 𝔭₀.1] F_g :=
        { toRingHom := j_g
          commutes' := fun q_bar => by
            rw [IsScalarTower.algebraMap_apply (C ⧸ 𝔭₀.1) L_g F_g q_bar]
            exact IsLocalization.lift_eq hUnits_toFg q_bar }
      have hIntKp : IsIntegral (C ⧸ 𝔭₀.1) (Ψ_Q x 𝔭₀) := (hIntQ x).mp hx 𝔭₀
      have hIntFg : IsIntegral (C ⧸ 𝔭₀.1) (j_g (Ψ_Q x 𝔭₀)) := IsIntegral.map j_g_alg hIntKp
      have hIntLg : IsIntegral L_g (j_g (Ψ_Q x 𝔭₀)) :=
        IsIntegral.tower_top (R := C ⧸ 𝔭₀.1) (A := L_g) (B := F_g) hIntFg
      obtain ⟨y_g, hy_g⟩ := (isIntegrallyClosed_iff F_g).mp inferInstance hIntLg
      let c₀ : C := (IsLocalization.Away.sec g y_g).1
      let n₀ : ℕ := (IsLocalization.Away.sec g y_g).2
      have hSec : y_g * φ_g (g ^ n₀) = φ_g c₀ := IsLocalization.Away.sec_spec g y_g
      have hSlot₀ : Ψ_Q (algebraMap C Q (g ^ (n₀ + 1)) * x) 𝔭₀ =
          Ψ_Q (algebraMap C Q (g * c₀)) 𝔭₀ := by
        apply j_g.injective
        rw [map_mul Ψ_Q, Pi.mul_apply, hΨ_alg, hΨ_alg, map_mul j_g,
          hjg_toKp, hjg_toKp, ← hy_g]
        calc
          algebraMap L_g F_g (φ_g (g ^ (n₀ + 1))) * algebraMap L_g F_g y_g =
              algebraMap L_g F_g (φ_g g * (y_g * φ_g (g ^ n₀))) := by
            rw [pow_succ]
            simp only [map_mul]
            ring
          _ = algebraMap L_g F_g (φ_g (g * c₀)) := by
            rw [hSec, ← map_mul φ_g]
      have hEqAll : algebraMap C Q (g ^ (n₀ + 1)) * x = algebraMap C Q (g * c₀) := by
        apply hInj_Ψ
        funext 𝔮
        by_cases hEq₀ : 𝔮 = 𝔭₀
        · subst hEq₀; exact hSlot₀
        · have hgMem : g ∈ 𝔮.1 := hg_in_other 𝔮 hEq₀
          have hg0 : toKp 𝔮 g = 0 := by
            dsimp [toKp]
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hgMem, map_zero]
          rw [map_mul Ψ_Q, Pi.mul_apply, hΨ_alg, hΨ_alg]
          have hLHS0 : toKp 𝔮 (g ^ (n₀ + 1)) = 0 := by
            rw [map_pow, hg0, zero_pow (Nat.succ_ne_zero n₀)]
          have hRHS0 : toKp 𝔮 (g * c₀) = 0 := by
            rw [map_mul, hg0, zero_mul]
          rw [hLHS0, zero_mul, hRHS0]
      have hgPowNot : g ^ (n₀ + 1) ∉ q.asIdeal :=
        fun hpow => hgNot (q.isPrime.mem_of_pow_mem (n₀ + 1) hpow)
      exact ⟨g ^ (n₀ + 1), hgPowNot, g * c₀, hEqAll.symm⟩

    have hInfSingAnn : ∀ (x : Q), x ∈ C_tilde →
        ∀ (a : C), (∀ q ∈ S_sing, a ∈ q.asIdeal) →
        algebraMap C Q a * x ∈ W_C := by
      intro x hx a haSing
      let J_col : Ideal C :=
        { carrier := { d : C | algebraMap C Q (d * a) * x ∈ W_C }
          add_mem' := by
            rintro d₁ d₂ ⟨c₁, hc₁⟩ ⟨c₂, hc₂⟩
            change algebraMap C Q c₁ = _ at hc₁
            change algebraMap C Q c₂ = _ at hc₂
            refine ⟨c₁ + c₂, ?_⟩
            change algebraMap C Q (c₁ + c₂) = algebraMap C Q ((d₁ + d₂) * a) * x
            rw [map_add, hc₁, hc₂, add_mul, map_add, add_mul]
          zero_mem' := by
            refine ⟨0, ?_⟩
            change algebraMap C Q 0 = algebraMap C Q (0 * a) * x
            rw [zero_mul, map_zero, zero_mul]
          smul_mem' := by
            rintro r d ⟨c, hc⟩
            change algebraMap C Q c = _ at hc
            refine ⟨r * c, ?_⟩
            change algebraMap C Q (r * c) = algebraMap C Q ((r • d) * a) * x
            rw [smul_eq_mul, map_mul, hc]
            calc
              algebraMap C Q r * (algebraMap C Q (d * a) * x) =
                  (algebraMap C Q r * algebraMap C Q (d * a)) * x := by ring
              _ = algebraMap C Q (r * d * a) * x := by rw [← map_mul, mul_assoc] }
      have hJTop : J_col = ⊤ := by
        by_contra hNeTop
        obtain ⟨𝔪, h𝔪Max, hJLe⟩ := Ideal.exists_le_maximal J_col hNeTop
        haveI : 𝔪.IsMaximal := h𝔪Max
        let q_m : PrimeSpectrum C := ⟨𝔪, inferInstance⟩
        by_cases hqm : q_m ∈ S_sing
        · have haMem : a ∈ 𝔪 := haSing q_m hqm
          let A := Localization.AtPrime 𝔪
          have haMaxA : algebraMap C A a ∈ IsLocalRing.maximalIdeal A :=
            (IsLocalization.AtPrime.to_map_mem_maximal_iff A 𝔪 a).mpr haMem
          have hRangeQA := (hLocNod q_m hqm).1 ⟨resAt 𝔪 x, hResAt_int 𝔪 x hx⟩
            (algebraMap C A a) haMaxA
          have hResProd : resAt 𝔪 (algebraMap C Q a * x) ∈
              Set.range (algebraMap A (Localization (nonZeroDivisors A))) := by
            rw [map_mul, hResAt_alg]
            exact hRangeQA
          obtain ⟨u_m, humNot, humWC⟩ := hLiftFromQA 𝔪 (algebraMap C Q a * x) hResProd
          have humJ : u_m ∈ J_col := by
            change algebraMap C Q (u_m * a) * x ∈ W_C
            rwa [map_mul, mul_assoc]
          exact humNot (hJLe humJ)
        · have hax_int : algebraMap C Q a * x ∈ C_tilde :=
            C_tilde.mul_mem (algebraMap_mem C_tilde a) hx
          obtain ⟨u_m, humNot, humWC⟩ := hSmAnn q_m h𝔪Max hqm (algebraMap C Q a * x) hax_int
          have humJ : u_m ∈ J_col := by
            change algebraMap C Q (u_m * a) * x ∈ W_C
            rwa [map_mul, mul_assoc]
          exact humNot (hJLe humJ)
      have h1J : (1 : C) ∈ J_col := hJTop ▸ Submodule.mem_top
      change algebraMap C Q (1 * a) * x ∈ W_C at h1J
      rwa [one_mul] at h1J

    have hCoprimePair : ∀ (q₁ q₂ : ↥S_sing), q₂ ≠ q₁ →
        ∃ (u_c v_c : C), u_c ∈ q₁.1.asIdeal ∧ v_c ∈ q₂.1.asIdeal ∧ u_c + v_c = 1 := by
      intro q₁ q₂ hne
      have hMax₁ : q₁.1.asIdeal.IsMaximal := hMax q₁.1 q₁.2
      have hMax₂ : q₂.1.asIdeal.IsMaximal := hMax q₂.1 q₂.2
      have hIdNe : q₁.1.asIdeal ≠ q₂.1.asIdeal :=
        fun hEq => hne (Subtype.ext (PrimeSpectrum.ext hEq.symm))
      have hSupTop : q₁.1.asIdeal ⊔ q₂.1.asIdeal = ⊤ :=
        Ideal.IsMaximal.coprime_of_ne hMax₁ hMax₂ hIdNe
      have h1Mem : (1 : C) ∈ q₁.1.asIdeal ⊔ q₂.1.asIdeal := hSupTop ▸ Submodule.mem_top
      obtain ⟨u_c, hu_c, v_c, hv_c, huv⟩ := Submodule.mem_sup.mp h1Mem
      exact ⟨u_c, v_c, hu_c, hv_c, huv⟩

    let crt_v : ↥S_sing → ↥S_sing → C := fun q₁ q₂ =>
      if h : q₂ ≠ q₁ then (hCoprimePair q₁ q₂ h).choose_spec.choose else 1
    let e_sing : ↥S_sing → C := fun q₁ => ∏ q₂ ∈ Finset.univ.erase q₁, crt_v q₁ q₂

    have he_other : ∀ (q₁ q₂ : ↥S_sing), q₂ ≠ q₁ → e_sing q₁ ∈ q₂.1.asIdeal := by
      intro q₁ q₂ hne
      have hq₂_er : q₂ ∈ (Finset.univ : Finset ↥S_sing).erase q₁ :=
        Finset.mem_erase.mpr ⟨hne, Finset.mem_univ q₂⟩
      have hfac : crt_v q₁ q₂ ∈ q₂.1.asIdeal := by
        dsimp only [crt_v]
        rw [dif_pos hne]
        exact (hCoprimePair q₁ q₂ hne).choose_spec.choose_spec.2.1
      dsimp only [e_sing]
      rw [← Finset.mul_prod_erase _ _ hq₂_er]
      exact Ideal.mul_mem_right _ _ hfac

    have he_self : ∀ q₁ : ↥S_sing, 1 - e_sing q₁ ∈ q₁.1.asIdeal := by
      intro q₁
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, sub_eq_zero]
      symm
      dsimp only [e_sing]
      rw [map_prod]
      apply Finset.prod_eq_one
      intro q₂ hq₂
      have hne : q₂ ≠ q₁ := (Finset.mem_erase.mp hq₂).1
      dsimp only [crt_v]
      rw [dif_pos hne]
      have huMem := (hCoprimePair q₁ q₂ hne).choose_spec.choose_spec.1
      have huvEq := (hCoprimePair q₁ q₂ hne).choose_spec.choose_spec.2.2
      have hv_eq : (hCoprimePair q₁ q₂ hne).choose_spec.choose =
          1 - (hCoprimePair q₁ q₂ hne).choose := by
        calc
          _ = ((hCoprimePair q₁ q₂ hne).choose +
                (hCoprimePair q₁ q₂ hne).choose_spec.choose) -
              (hCoprimePair q₁ q₂ hne).choose := by ring
          _ = 1 - (hCoprimePair q₁ q₂ hne).choose := by rw [huvEq]
      rw [hv_eq, map_sub, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr huMem, sub_zero]

    have he_sum : ∀ q : PrimeSpectrum C, q ∈ S_sing →
        1 - (∑ q₁ : ↥S_sing, e_sing q₁) ∈ q.asIdeal := by
      intro q hq
      let q₀ : ↥S_sing := ⟨q, hq⟩
      change 1 - (∑ q₁ : ↥S_sing, e_sing q₁) ∈ q₀.1.asIdeal
      rw [← Finset.add_sum_erase Finset.univ e_sing (Finset.mem_univ q₀)]
      have hEq : 1 - (e_sing q₀ + ∑ x ∈ Finset.univ.erase q₀, e_sing x) =
          (1 - e_sing q₀) - ∑ x ∈ Finset.univ.erase q₀, e_sing x := by ring
      rw [hEq]
      refine Ideal.sub_mem _ (he_self q₀) (Ideal.sum_mem _ fun q₁ hq₁ => ?_)
      exact he_other q₁ q₀ (Finset.mem_erase.mp hq₁).1.symm

    let A_loc : ↥S_sing → Type u := fun q => Localization.AtPrime q.1.asIdeal
    let QA_loc : ↥S_sing → Type u := fun q => Localization (nonZeroDivisors (A_loc q))
    let Atilde_loc : ∀ q : ↥S_sing, Subalgebra (A_loc q) (QA_loc q) :=
      fun q => integralClosure (A_loc q) (QA_loc q)
    let y₀_loc : ∀ q : ↥S_sing, ↥(Atilde_loc q) :=
      fun q => (hLocNod q.1 q.2).2.choose
    have hy₀_not_range : ∀ q : ↥S_sing,
        (y₀_loc q).1 ∉ Set.range (algebraMap (A_loc q) (QA_loc q)) :=
      fun q => (hLocNod q.1 q.2).2.choose_spec.1
    have hy₀_span : ∀ (q : ↥S_sing) (y : ↥(Atilde_loc q)),
        ∃ (c : k₀) (a : A_loc q),
          y.1 = algebraMap (A_loc q) (QA_loc q)
            (algebraMap C (A_loc q) (algebraMap k₀ C c)) * (y₀_loc q).1 +
            algebraMap (A_loc q) (QA_loc q) a :=
      fun q => (hLocNod q.1 q.2).2.choose_spec.2

    have hUniqCoeff : ∀ (q : ↥S_sing) (c₁ c₂ : k₀) (a₁ a₂ : A_loc q),
        algebraMap (A_loc q) (QA_loc q) (algebraMap C (A_loc q) (algebraMap k₀ C c₁)) *
            (y₀_loc q).1 + algebraMap (A_loc q) (QA_loc q) a₁ =
          algebraMap (A_loc q) (QA_loc q) (algebraMap C (A_loc q) (algebraMap k₀ C c₂)) *
            (y₀_loc q).1 + algebraMap (A_loc q) (QA_loc q) a₂ →
        c₁ = c₂ := by
      intro q c₁ c₂ a₁ a₂ hEq
      by_contra hne
      have hDiffNe : c₁ - c₂ ≠ 0 := sub_ne_zero.mpr hne
      let fk : k₀ →+* QA_loc q :=
        (algebraMap (A_loc q) (QA_loc q)).comp
          ((algebraMap C (A_loc q)).comp (algebraMap k₀ C))
      have hDiffEq : fk (c₁ - c₂) * (y₀_loc q).1 =
          algebraMap (A_loc q) (QA_loc q) (a₂ - a₁) := by
        have hsub : fk (c₁ - c₂) = fk c₁ - fk c₂ := map_sub fk c₁ c₂
        change (fk c₁ * (y₀_loc q).1 + algebraMap (A_loc q) (QA_loc q) a₁) =
          (fk c₂ * (y₀_loc q).1 + algebraMap (A_loc q) (QA_loc q) a₂) at hEq
        rw [hsub, map_sub]
        calc
          (fk c₁ - fk c₂) * (y₀_loc q).1 =
              (fk c₁ * (y₀_loc q).1 + algebraMap (A_loc q) (QA_loc q) a₁) -
                fk c₂ * (y₀_loc q).1 - algebraMap (A_loc q) (QA_loc q) a₁ := by ring
          _ = algebraMap (A_loc q) (QA_loc q) a₂ -
                algebraMap (A_loc q) (QA_loc q) a₁ := by rw [hEq]; ring
      have hInvMul : fk (c₁ - c₂)⁻¹ * fk (c₁ - c₂) = 1 := by
        rw [← map_mul, inv_mul_cancel₀ hDiffNe, map_one]
      have hy₀_in : (y₀_loc q).1 ∈ Set.range (algebraMap (A_loc q) (QA_loc q)) := by
        refine ⟨algebraMap C (A_loc q) (algebraMap k₀ C (c₁ - c₂)⁻¹) * (a₂ - a₁), ?_⟩
        rw [map_mul]
        change fk (c₁ - c₂)⁻¹ * algebraMap (A_loc q) (QA_loc q) (a₂ - a₁) = (y₀_loc q).1
        rw [← hDiffEq, ← mul_assoc, hInvMul, one_mul]
      exact hy₀_not_range q hy₀_in

    let ϕ_fn : ∀ q : ↥S_sing, ↥(Atilde_loc q) → k₀ :=
      fun q y => (hy₀_span q y).choose
    have hϕ_spec : ∀ (q : ↥S_sing) (y : ↥(Atilde_loc q)),
        ∃ a : A_loc q,
          y.1 = algebraMap (A_loc q) (QA_loc q)
            (algebraMap C (A_loc q) (algebraMap k₀ C (ϕ_fn q y))) * (y₀_loc q).1 +
            algebraMap (A_loc q) (QA_loc q) a :=
      fun q y => (hy₀_span q y).choose_spec

    have hϕ_eq_of_rep : ∀ (q : ↥S_sing) (y : ↥(Atilde_loc q)) (c : k₀) (a : A_loc q),
        y.1 = algebraMap (A_loc q) (QA_loc q)
          (algebraMap C (A_loc q) (algebraMap k₀ C c)) * (y₀_loc q).1 +
          algebraMap (A_loc q) (QA_loc q) a →
        ϕ_fn q y = c := by
      intro q y c a hrep
      obtain ⟨a', ha'⟩ := hϕ_spec q y
      exact hUniqCoeff q (ϕ_fn q y) c a' a (ha'.symm.trans hrep)

    have hϕ_zero_iff : ∀ (q : ↥S_sing) (y : ↥(Atilde_loc q)),
        ϕ_fn q y = 0 ↔ y.1 ∈ Set.range (algebraMap (A_loc q) (QA_loc q)) := by
      intro q y
      constructor
      · intro h0
        obtain ⟨a, ha⟩ := hϕ_spec q y
        rw [h0, map_zero, map_zero, map_zero, zero_mul, zero_add] at ha
        exact ⟨a, ha.symm⟩
      · rintro ⟨a, ha⟩
        refine hϕ_eq_of_rep q y 0 a ?_
        rw [map_zero, map_zero, map_zero, zero_mul, zero_add, ha]

    have hϕ_add : ∀ (q : ↥S_sing) (y₁ y₂ : ↥(Atilde_loc q)),
        ϕ_fn q (y₁ + y₂) = ϕ_fn q y₁ + ϕ_fn q y₂ := by
      intro q y₁ y₂
      obtain ⟨a₁, ha₁⟩ := hϕ_spec q y₁
      obtain ⟨a₂, ha₂⟩ := hϕ_spec q y₂
      refine hϕ_eq_of_rep q (y₁ + y₂) (ϕ_fn q y₁ + ϕ_fn q y₂) (a₁ + a₂) ?_
      change y₁.1 + y₂.1 = _
      rw [ha₁, ha₂, map_add, map_add, map_add, map_add]
      ring

    have hϕ_smul_k₀ : ∀ (q : ↥S_sing) (r : k₀) (y : ↥(Atilde_loc q)),
        ϕ_fn q ⟨algebraMap (A_loc q) (QA_loc q)
          (algebraMap C (A_loc q) (algebraMap k₀ C r)) * y.1,
          (Atilde_loc q).mul_mem (algebraMap_mem _ _) y.2⟩ = r * ϕ_fn q y := by
      intro q r y
      obtain ⟨a, ha⟩ := hϕ_spec q y
      refine hϕ_eq_of_rep q _ (r * ϕ_fn q y)
        (algebraMap C (A_loc q) (algebraMap k₀ C r) * a) ?_
      dsimp only
      rw [ha, map_mul, map_mul, map_mul, map_mul]
      ring

    have hLiftLocalTilde : ∀ q : ↥S_sing,
        ∃ (s : C) (x₀ : Q),
          s ∉ q.1.asIdeal ∧
          x₀ ∈ C_tilde ∧
          resAt q.1.asIdeal x₀ =
            algebraMap (A_loc q) (QA_loc q) (algebraMap C (A_loc q) s) * (y₀_loc q).1 := by
      intro q
      let 𝔪 := q.1.asIdeal
      haveI : 𝔪.IsMaximal := hMax q.1 q.2
      let A := A_loc q
      let Q_A := QA_loc q
      let y₀ := y₀_loc q
      have hExOut : ∀ 𝔮 : ℳ, ¬ (𝔮.1 ≤ 𝔪) → ∃ w : C, w ∈ 𝔮.1 ∧ w ∉ 𝔪 :=
        fun 𝔮 hNotLe => Set.not_subset.mp hNotLe
      let S_out : Finset ℳ := Finset.univ.filter (fun 𝔮 : ℳ => ¬ (𝔮.1 ≤ 𝔪))
      let w_out : ℳ → C := fun 𝔮 =>
        if h : ¬ (𝔮.1 ≤ 𝔪) then (hExOut 𝔮 h).choose else 1
      let t_out : C := ∏ 𝔮 ∈ S_out, w_out 𝔮
      have htout_not_𝔪 : t_out ∉ 𝔪 := by
        intro htM
        obtain ⟨𝔮, h𝔮S, hwM⟩ := Ideal.IsPrime.prod_mem_iff.mp htM
        have hNotLe : ¬ (𝔮.1 ≤ 𝔪) := (Finset.mem_filter.mp h𝔮S).2
        simp only [w_out, hNotLe, ↓reduceDIte] at hwM
        exact (hExOut 𝔮 hNotLe).choose_spec.2 hwM
      have htout_in_out : ∀ 𝔮 : ℳ, ¬ (𝔮.1 ≤ 𝔪) → t_out ∈ 𝔮.1 := by
        intro 𝔮 hNotLe
        have h𝔮S : 𝔮 ∈ S_out := Finset.mem_filter.mpr ⟨Finset.mem_univ 𝔮, hNotLe⟩
        have hfac : w_out 𝔮 ∈ 𝔮.1 := by
          simp only [w_out, hNotLe, ↓reduceDIte]
          exact (hExOut 𝔮 hNotLe).choose_spec.1
        dsimp only [t_out]
        rw [← Finset.mul_prod_erase S_out w_out h𝔮S]
        exact Ideal.mul_mem_right _ _ hfac
      have htout_kill_zp : ∀ 𝔮 ∈ S_out, t_out * z_p 𝔮 = 0 := by
        intro 𝔮 h𝔮S
        have hNotLe : ¬ (𝔮.1 ≤ 𝔪) := (Finset.mem_filter.mp h𝔮S).2
        rw [hZeroIff]
        intro 𝔯
        by_cases hEq : 𝔯 = 𝔮
        · subst hEq; exact Ideal.mul_mem_right _ _ (htout_in_out 𝔯 hNotLe)
        · exact Ideal.mul_mem_left _ _ (hzp_mem_other 𝔮 𝔯 hEq)

      obtain ⟨⟨a_num, b_den⟩, hy₀_mk⟩ := IsLocalization.mk'_surjective (nonZeroDivisors A) y₀.1
      obtain ⟨⟨c_num, t_num⟩, ha_mk⟩ := IsLocalization.mk'_surjective 𝔪.primeCompl a_num
      obtain ⟨⟨c_den, t_den⟩, hb_mk⟩ := IsLocalization.mk'_surjective 𝔪.primeCompl b_den.1
      dsimp only at hy₀_mk ha_mk hb_mk
      have hcden_eqA : algebraMap C A c_den = b_den.1 * algebraMap C A t_den.1 := by
        rw [← hb_mk, IsLocalization.mk'_spec]
      have hcden_nzdA : algebraMap C A c_den ∈ nonZeroDivisors A := by
        rw [hcden_eqA]
        refine Submonoid.mul_mem _ b_den.2 ?_
        exact IsUnit.mem_nonZeroDivisors (IsLocalization.map_units A t_den)
      have hcden_not_in : ∀ 𝔭 : ℳ, 𝔭.1 ≤ 𝔪 → c_den ∉ 𝔭.1 := by
        intro 𝔭 hle hcdMem
        have hProd0 : z_p 𝔭 * c_den = 0 := by
          rw [hZeroIff]
          intro 𝔮
          by_cases hEq : 𝔮 = 𝔭
          · subst hEq; exact Ideal.mul_mem_left _ _ hcdMem
          · exact Ideal.mul_mem_right _ _ (hzp_mem_other 𝔭 𝔮 hEq)
        have hProdA0 : algebraMap C A (z_p 𝔭) * algebraMap C A c_den = 0 := by
          rw [← map_mul, hProd0, map_zero]
        have hzpA0 : algebraMap C A (z_p 𝔭) = 0 :=
          (mem_nonZeroDivisors_iff.mp hcden_nzdA).2 _ hProdA0
        obtain ⟨u_m, hum0⟩ := (IsLocalization.eq_iff_exists 𝔪.primeCompl A).mp
          (hzpA0.trans (map_zero (algebraMap C A)).symm)
        rw [mul_zero] at hum0
        have humNot𝔭 : u_m.1 ∉ 𝔭.1 := fun hm => u_m.2 (hle hm)
        have hMem𝔭 : u_m.1 * z_p 𝔭 ∈ 𝔭.1 := hum0 ▸ 𝔭.1.zero_mem
        exact hzp_not_self 𝔭 (((hℳ_prime 𝔭).mem_or_mem hMem𝔭).resolve_left humNot𝔭)

      let d_reg : C := t_out * c_den + ∑ 𝔮 ∈ S_out, z_p 𝔮
      have hdreg_nzd : d_reg ∈ nonZeroDivisors C := by
        rw [hNzdIff]
        intro 𝔭 hdMem
        by_cases hle : 𝔭.1 ≤ 𝔪
        · have hSumMem : (∑ 𝔮 ∈ S_out, z_p 𝔮) ∈ 𝔭.1 := by
            refine Ideal.sum_mem _ fun 𝔮 h𝔮S => ?_
            have hne : 𝔭 ≠ 𝔮 := fun hEq => (Finset.mem_filter.mp h𝔮S).2 (hEq ▸ hle)
            exact hzp_mem_other 𝔮 𝔭 hne
          have htcMem : t_out * c_den ∈ 𝔭.1 :=
            (Ideal.add_mem_iff_left 𝔭.1 hSumMem).mp hdMem
          rcases (hℳ_prime 𝔭).mem_or_mem htcMem with htM | hcM
          · exact htout_not_𝔪 (hle htM)
          · exact hcden_not_in 𝔭 hle hcM
        · have h𝔭S : 𝔭 ∈ S_out := Finset.mem_filter.mpr ⟨Finset.mem_univ 𝔭, hle⟩
          have htcMem : t_out * c_den ∈ 𝔭.1 :=
            Ideal.mul_mem_right _ _ (htout_in_out 𝔭 hle)
          have hSumMem : (∑ 𝔮 ∈ S_out, z_p 𝔮) ∈ 𝔭.1 :=
            (Ideal.add_mem_iff_right 𝔭.1 htcMem).mp hdMem
          rw [← Finset.add_sum_erase S_out z_p h𝔭S] at hSumMem
          have hRestMem : (∑ 𝔮 ∈ S_out.erase 𝔭, z_p 𝔮) ∈ 𝔭.1 :=
            Ideal.sum_mem _ fun 𝔮 h𝔮E =>
              hzp_mem_other 𝔮 𝔭 (Finset.mem_erase.mp h𝔮E).1.symm
          exact hzp_not_self 𝔭 ((Ideal.add_mem_iff_left 𝔭.1 hRestMem).mp hSumMem)

      have htnum_dreg_eqA : algebraMap C A (t_out * d_reg) =
          algebraMap C A (t_out * t_out * c_den) := by
        apply congrArg (algebraMap C A)
        dsimp only [d_reg]
        rw [mul_add, Finset.mul_sum]
        have hSum0 : (∑ x ∈ S_out, t_out * z_p x) = 0 :=
          Finset.sum_eq_zero htout_kill_zp
        rw [hSum0, add_zero, mul_assoc]
      have hdreg_eqA : algebraMap C A d_reg = algebraMap C A (t_out * c_den) := by
        have hUnitTout : IsUnit (algebraMap C A t_out) :=
          IsLocalization.map_units A (⟨t_out, htout_not_𝔪⟩ : 𝔪.primeCompl)
        apply hUnitTout.mul_left_cancel
        rw [← map_mul, htnum_dreg_eqA, ← map_mul, mul_assoc]

      let q_raw : Q := IsLocalization.mk' Q (t_out * t_den.1 * c_num) ⟨d_reg, hdreg_nzd⟩
      have hRes_qraw : resAt 𝔪 q_raw =
          algebraMap A Q_A (algebraMap C A t_num.1) * y₀.1 := by
        have hUnitDen : IsUnit (algebraMap A Q_A (algebraMap C A d_reg)) :=
          IsLocalization.map_units Q_A ⟨_, hNzdLoc 𝔪 ⟨d_reg, hdreg_nzd⟩⟩
        apply hUnitDen.mul_right_cancel
        have hLHS : resAt 𝔪 q_raw * algebraMap A Q_A (algebraMap C A d_reg) =
            algebraMap A Q_A (algebraMap C A (t_out * t_den.1 * c_num)) := by
          rw [← hResAt_alg 𝔪 d_reg, ← map_mul, IsLocalization.mk'_spec, hResAt_alg]
        have htcA : algebraMap C A (t_out * c_den) =
            algebraMap C A t_out * (b_den.1 * algebraMap C A t_den.1) := by
          rw [map_mul, hcden_eqA]
        rw [hLHS, hdreg_eqA, htcA]
        have ha_spec : algebraMap C A t_num.1 * a_num = algebraMap C A c_num := by
          rw [← ha_mk, mul_comm, IsLocalization.mk'_spec]
        have hy₀_spec : y₀.1 * algebraMap A Q_A b_den.1 = algebraMap A Q_A a_num := by
          rw [← hy₀_mk, IsLocalization.mk'_spec]
        calc
          algebraMap A Q_A (algebraMap C A (t_out * t_den.1 * c_num)) =
              algebraMap A Q_A (algebraMap C A t_out * algebraMap C A t_den.1) *
                (algebraMap A Q_A (algebraMap C A t_num.1) * algebraMap A Q_A a_num) := by
            rw [← map_mul, ← map_mul, ha_spec, ← map_mul, ← map_mul]
          _ = algebraMap A Q_A (algebraMap C A t_num.1) *
                (y₀.1 * algebraMap A Q_A b_den.1) *
                algebraMap A Q_A (algebraMap C A t_out * algebraMap C A t_den.1) := by
            rw [hy₀_spec]
            ring
          _ = algebraMap A Q_A (algebraMap C A t_num.1) * y₀.1 *
                algebraMap A Q_A (algebraMap C A t_out *
                  (b_den.1 * algebraMap C A t_den.1)) := by
            rw [map_mul, map_mul, map_mul]
            ring

      let y₁ : Q_A := resAt 𝔪 q_raw
      have hy₁_int : IsIntegral A y₁ := by
        dsimp only [y₁]
        rw [hRes_qraw]
        exact (Atilde_loc q).mul_mem (algebraMap_mem (Atilde_loc q) _) y₀.2
      obtain ⟨P_A, hPA_mon, hPA_eval⟩ := hy₁_int
      let d := P_A.natDegree
      rcases Nat.eq_zero_or_pos d with hd0 | hd_pos
      · have hPA1 : P_A = 1 := Polynomial.eq_one_of_monic_natDegree_zero hPA_mon hd0
        rw [hPA1, Polynomial.eval₂_one] at hPA_eval
        haveI : Subsingleton Q_A := subsingleton_of_zero_eq_one hPA_eval.symm
        exact False.elim (hy₀_not_range q ⟨0, Subsingleton.elim _ _⟩)
      · have hCoeffSurj : ∀ i : Fin d,
            ∃ (ci : C) (si : 𝔪.primeCompl), IsLocalization.mk' A ci si = P_A.coeff i :=
          fun i => by
            obtain ⟨⟨ci, si⟩, h⟩ := IsLocalization.mk'_surjective 𝔪.primeCompl (P_A.coeff i)
            exact ⟨ci, si, h⟩
        let c_i : Fin d → C := fun i => (hCoeffSurj i).choose
        let s_i : Fin d → 𝔪.primeCompl := fun i => (hCoeffSurj i).choose_spec.choose
        have hsi_spec : ∀ i : Fin d, IsLocalization.mk' A (c_i i) (s_i i) = P_A.coeff i :=
          fun i => (hCoeffSurj i).choose_spec.choose_spec
        let S_prod : 𝔪.primeCompl := ∏ i : Fin d, s_i i
        let s₀ : C := S_prod.1
        have hs₀_not : s₀ ∉ 𝔪 := S_prod.2
        let rem_i : Fin d → C := fun i => ∏ j ∈ Finset.univ.erase i, (s_i j).1
        have hs₀_fac : ∀ i : Fin d, s₀ = (s_i i).1 * rem_i i := by
          intro i
          dsimp only [s₀, S_prod, rem_i]
          rw [Submonoid.coe_finset_prod]
          exact (Finset.mul_prod_erase Finset.univ (fun j : Fin d => (s_i j).1)
            (Finset.mem_univ i)).symm
        have hCoeffClear : ∀ i : Fin d,
            algebraMap C A (s₀ ^ (d - (i : ℕ))) * P_A.coeff i =
              algebraMap C A (s₀ ^ (d - 1 - (i : ℕ)) * rem_i i * c_i i) := by
          intro i
          have hi_lt : (i : ℕ) < d := i.2
          have hExp : d - (i : ℕ) = (d - 1 - (i : ℕ)) + 1 := by omega
          have hs₀_pow : s₀ ^ (d - (i : ℕ)) =
              s₀ ^ (d - 1 - (i : ℕ)) * ((s_i i).1 * rem_i i) := by
            rw [hExp, pow_succ, ← hs₀_fac i]
          rw [hs₀_pow, map_mul, map_mul, ← hsi_spec i]
          calc
            algebraMap C A (s₀ ^ (d - 1 - (i : ℕ))) *
                (algebraMap C A (s_i i).1 * algebraMap C A (rem_i i)) *
                IsLocalization.mk' A (c_i i) (s_i i) =
              algebraMap C A (s₀ ^ (d - 1 - (i : ℕ))) * algebraMap C A (rem_i i) *
                (IsLocalization.mk' A (c_i i) (s_i i) * algebraMap C A (s_i i).1) := by ring
            _ = algebraMap C A (s₀ ^ (d - 1 - (i : ℕ)) * rem_i i * c_i i) := by
              rw [IsLocalization.mk'_spec, ← map_mul, ← map_mul]

        let z_eval : Q := algebraMap C Q s₀ * q_raw
        let err_Q : Q := z_eval ^ d +
          ∑ i : Fin d,
            algebraMap C Q (s₀ ^ (d - 1 - (i : ℕ)) * rem_i i * c_i i) * z_eval ^ (i : ℕ)
        have hRes_err : resAt 𝔪 err_Q = 0 := by
          let s₀_QA : Q_A := algebraMap A Q_A (algebraMap C A s₀)
          have hRes_z : resAt 𝔪 z_eval = s₀_QA * y₁ := by
            dsimp only [z_eval, y₁, s₀_QA]
            rw [map_mul, hResAt_alg]
          dsimp only [err_Q]
          rw [map_add, map_pow, hRes_z, map_sum]
          have hSumEq : (∑ i : Fin d,
              resAt 𝔪 (algebraMap C Q (s₀ ^ (d - 1 - (i : ℕ)) * rem_i i * c_i i) *
                z_eval ^ (i : ℕ))) =
              ∑ i : Fin d, s₀_QA ^ d * (algebraMap A Q_A (P_A.coeff i) * y₁ ^ (i : ℕ)) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [map_mul, map_pow, hRes_z, hResAt_alg, ← hCoeffClear i]
            have hi_lt : (i : ℕ) < d := i.2
            have hExp : (d - (i : ℕ)) + (i : ℕ) = d := by omega
            calc
              algebraMap A Q_A (algebraMap C A (s₀ ^ (d - (i : ℕ))) * P_A.coeff i) *
                  (s₀_QA * y₁) ^ (i : ℕ) =
                (s₀_QA ^ (d - (i : ℕ)) * s₀_QA ^ (i : ℕ)) *
                  (algebraMap A Q_A (P_A.coeff i) * y₁ ^ (i : ℕ)) := by
                dsimp only [s₀_QA]
                rw [map_mul, map_pow, map_pow, mul_pow]
                ring
              _ = s₀_QA ^ d * (algebraMap A Q_A (P_A.coeff i) * y₁ ^ (i : ℕ)) := by
                rw [← pow_add, hExp]
          rw [hSumEq, ← Finset.mul_sum, mul_pow, ← mul_add]
          have hPA_sum : y₁ ^ d + ∑ i : Fin d, algebraMap A Q_A (P_A.coeff i) * y₁ ^ (i : ℕ) =
              Polynomial.eval₂ (algebraMap A Q_A) y₁ P_A := by
            rw [Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ, add_comm]
            have hLead : algebraMap A Q_A (P_A.coeff d) = 1 := by
              change algebraMap A Q_A P_A.leadingCoeff = 1
              rw [hPA_mon.leadingCoeff, map_one]
            rw [hLead, one_mul, Finset.sum_fin_eq_sum_range]
            congr 1
            refine Finset.sum_congr rfl fun k hk => ?_
            rw [dif_pos (Finset.mem_range.mp hk)]
          rw [hPA_sum, hPA_eval, mul_zero]

        obtain ⟨u_m, hum_not, hum_err0⟩ := hZeroFromQA 𝔪 err_Q hRes_err
        let s_final : C := u_m * s₀ * t_num.1
        have hs_final_not : s_final ∉ 𝔪 :=
          𝔪.primeCompl.mul_mem (𝔪.primeCompl.mul_mem hum_not hs₀_not) t_num.2
        let x₀ : Q := algebraMap C Q (u_m * s₀) * q_raw
        have hRes_x₀ : resAt 𝔪 x₀ =
            algebraMap A Q_A (algebraMap C A s_final) * y₀.1 := by
          have hRes_um : resAt 𝔪 (algebraMap C Q (u_m * s₀)) =
              algebraMap A Q_A (algebraMap C A (u_m * s₀)) := hResAt_alg 𝔪 (u_m * s₀)
          dsimp only [x₀, s_final]
          rw [map_mul, hRes_um, hRes_qraw]
          simp only [map_mul]
          ring
        have hx₀_int : x₀ ∈ C_tilde := by
          let Q_poly : Polynomial C := ∑ i : Fin d,
            Polynomial.C (u_m ^ (d - (i : ℕ)) *
              (s₀ ^ (d - 1 - (i : ℕ)) * rem_i i * c_i i)) * Polynomial.X ^ (i : ℕ)
          have hDegQ : Q_poly.degree < (d : WithBot ℕ) := by
            refine (Polynomial.degree_sum_le _ _).trans_lt ?_
            apply (Finset.sup_lt_iff (WithBot.bot_lt_coe d)).mpr
            intro i _
            refine (Polynomial.degree_C_mul_X_pow_le _ _).trans_lt ?_
            exact WithBot.coe_lt_coe.mpr i.2
          have hMonP' : (Polynomial.X ^ d + Q_poly).Monic :=
            Polynomial.monic_X_pow_add hDegQ
          refine ⟨Polynomial.X ^ d + Q_poly, hMonP', ?_⟩
          rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow]
          dsimp only [Q_poly]
          rw [Polynomial.eval₂_finset_sum]
          have hx₀_z : x₀ = algebraMap C Q u_m * z_eval := by
            dsimp only [x₀, z_eval]
            rw [map_mul, mul_assoc]
          have hSumEval : (∑ i : Fin d,
              Polynomial.eval₂ (algebraMap C Q) x₀
                (Polynomial.C (u_m ^ (d - (i : ℕ)) *
                  (s₀ ^ (d - 1 - (i : ℕ)) * rem_i i * c_i i)) * Polynomial.X ^ (i : ℕ))) =
              algebraMap C Q u_m ^ d *
                ∑ i : Fin d,
                  algebraMap C Q (s₀ ^ (d - 1 - (i : ℕ)) * rem_i i * c_i i) *
                    z_eval ^ (i : ℕ) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow, hx₀_z, mul_pow]
            have hExp : (d - (i : ℕ)) + (i : ℕ) = d := by omega
            calc
              algebraMap C Q (u_m ^ (d - (i : ℕ)) *
                  (s₀ ^ (d - 1 - (i : ℕ)) * rem_i i * c_i i)) *
                  (algebraMap C Q u_m ^ (i : ℕ) * z_eval ^ (i : ℕ)) =
                (algebraMap C Q u_m ^ (d - (i : ℕ)) * algebraMap C Q u_m ^ (i : ℕ)) *
                  (algebraMap C Q (s₀ ^ (d - 1 - (i : ℕ)) * rem_i i * c_i i) *
                    z_eval ^ (i : ℕ)) := by
                rw [map_mul, map_pow]
                ring
              _ = algebraMap C Q u_m ^ d *
                  (algebraMap C Q (s₀ ^ (d - 1 - (i : ℕ)) * rem_i i * c_i i) *
                    z_eval ^ (i : ℕ)) := by
                rw [← pow_add, hExp]
          rw [hSumEval, hx₀_z, mul_pow, ← mul_add]
          have hd_pred : d = (d - 1) + 1 := by omega
          calc
            algebraMap C Q u_m ^ d * err_Q =
                algebraMap C Q u_m ^ (d - 1) * (algebraMap C Q u_m * err_Q) := by
              conv_lhs => lhs; rw [hd_pred, pow_succ]
              ring
            _ = 0 := by rw [hum_err0, mul_zero]
        exact ⟨s_final, x₀, hs_final_not, hx₀_int, hRes_x₀⟩

    let K_sub : Submodule k₀ ↥W_tilde := W_C.comap W_tilde.subtype
    let evalSing_raw : ↥W_tilde →ₗ[k₀] (↥S_sing → k₀) :=
      { toFun := fun x q =>
          ϕ_fn q ⟨resAt q.1.asIdeal x.1, hResAt_int q.1.asIdeal x.1 x.2⟩
        map_add' := fun x₁ x₂ => by
          funext q
          have hSub : (⟨resAt q.1.asIdeal (x₁ + x₂).1,
              hResAt_int q.1.asIdeal (x₁ + x₂).1 (x₁ + x₂).2⟩ : ↥(Atilde_loc q)) =
              ⟨resAt q.1.asIdeal x₁.1, hResAt_int q.1.asIdeal x₁.1 x₁.2⟩ +
              ⟨resAt q.1.asIdeal x₂.1, hResAt_int q.1.asIdeal x₂.1 x₂.2⟩ := by
            ext
            exact map_add (resAt q.1.asIdeal) x₁.1 x₂.1
          rw [hSub, hϕ_add]
          rfl
        map_smul' := fun r x => by
          funext q
          have hrx : (r • x).1 = algebraMap C Q (algebraMap k₀ C r) * x.1 := by
            change r • x.1 = _
            rw [← IsScalarTower.algebraMap_apply k₀ C Q r, Algebra.smul_def]
          have hSub : (⟨resAt q.1.asIdeal (r • x).1,
              hResAt_int q.1.asIdeal (r • x).1 (r • x).2⟩ : ↥(Atilde_loc q)) =
              ⟨algebraMap (A_loc q) (QA_loc q) (algebraMap C (A_loc q) (algebraMap k₀ C r)) *
                resAt q.1.asIdeal x.1,
                (Atilde_loc q).mul_mem (algebraMap_mem _ _)
                  (hResAt_int q.1.asIdeal x.1 x.2)⟩ := by
            ext
            change resAt q.1.asIdeal (r • x).1 = _
            rw [hrx, map_mul, hResAt_alg]
          change ϕ_fn q _ = r * ϕ_fn q _
          rw [hSub]
          exact hϕ_smul_k₀ q r ⟨resAt q.1.asIdeal x.1, hResAt_int q.1.asIdeal x.1 x.2⟩ }

    have hKer_evalSing : K_sub ≤ LinearMap.ker evalSing_raw := by
      rintro x ⟨c, hc⟩
      change algebraMap C Q c = x.1 at hc
      rw [LinearMap.mem_ker]
      funext q
      change ϕ_fn q ⟨resAt q.1.asIdeal x.1, _⟩ = 0
      rw [hϕ_zero_iff]
      refine ⟨algebraMap C (A_loc q) c, ?_⟩
      change algebraMap (A_loc q) (QA_loc q) (algebraMap C (A_loc q) c) =
        resAt q.1.asIdeal x.1
      rw [← hc, hResAt_alg]

    let F_quot : (↥W_tilde ⧸ K_sub) →ₗ[k₀] (↥S_sing → k₀) :=
      K_sub.liftQ evalSing_raw hKer_evalSing

    have hInj_Fquot : Function.Injective F_quot := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective K_sub z
      change Submodule.Quotient.mk x = (0 : ↥W_tilde ⧸ K_sub)
      rw [Submodule.Quotient.mk_eq_zero]
      change x.1 ∈ W_C
      have hLocalRange : ∀ q : ↥S_sing,
          ∃ u_q : C, u_q ∉ q.1.asIdeal ∧ algebraMap C Q u_q * x.1 ∈ W_C := by
        intro q
        have hϕ0 : ϕ_fn q ⟨resAt q.1.asIdeal x.1, hResAt_int q.1.asIdeal x.1 x.2⟩ = 0 :=
          congrFun hz q
        have hRange := (hϕ_zero_iff q _).mp hϕ0
        exact hLiftFromQA q.1.asIdeal x.1 hRange
      let u_fn : ↥S_sing → C := fun q => (hLocalRange q).choose
      have hu_not : ∀ q : ↥S_sing, u_fn q ∉ q.1.asIdeal :=
        fun q => (hLocalRange q).choose_spec.1
      have hu_WC : ∀ q : ↥S_sing, algebraMap C Q (u_fn q) * x.1 ∈ W_C :=
        fun q => (hLocalRange q).choose_spec.2
      have hCopU' : ∀ q : ↥S_sing,
          ∃ (r_q m_q : C), m_q ∈ q.1.asIdeal ∧ r_q * u_fn q + m_q = 1 := by
        intro q
        have hMax_q : q.1.asIdeal.IsMaximal := hMax q.1 q.2
        have hSup : Ideal.span {u_fn q} ⊔ q.1.asIdeal = ⊤ := by
          by_contra hNeT
          obtain ⟨M, hMMax, hLeM⟩ := Ideal.exists_le_maximal _ hNeT
          have hEqM : q.1.asIdeal = M := hMax_q.eq_of_le hMMax.ne_top (le_sup_right.trans hLeM)
          exact hu_not q (hEqM.symm ▸ (le_sup_left.trans hLeM) (Ideal.subset_span rfl))
        have h1 : (1 : C) ∈ Ideal.span {u_fn q} ⊔ q.1.asIdeal := hSup ▸ Submodule.mem_top
        obtain ⟨y_u, hy_u, m_q, hm_q, hym⟩ := Submodule.mem_sup.mp h1
        obtain ⟨r_q, rfl⟩ := Ideal.mem_span_singleton.mp hy_u
        exact ⟨r_q, m_q, hm_q, by rw [mul_comm r_q, hym]⟩
      let r_fn : ↥S_sing → C := fun q => (hCopU' q).choose
      let m_fn : ↥S_sing → C := fun q => (hCopU' q).choose_spec.choose
      have hm_in : ∀ q : ↥S_sing, m_fn q ∈ q.1.asIdeal :=
        fun q => (hCopU' q).choose_spec.choose_spec.1
      have hrm_eq : ∀ q : ↥S_sing, r_fn q * u_fn q + m_fn q = 1 :=
        fun q => (hCopU' q).choose_spec.choose_spec.2
      let a_rad : C := (1 - ∑ q : ↥S_sing, e_sing q) + ∑ q : ↥S_sing, e_sing q * m_fn q
      have ha_rad_mem : ∀ q' ∈ S_sing, a_rad ∈ q'.asIdeal := by
        intro q' hq'
        refine Ideal.add_mem _ (he_sum q' hq') (Ideal.sum_mem _ fun q _ => ?_)
        by_cases hEq : q = ⟨q', hq'⟩
        · rw [hEq]; exact Ideal.mul_mem_left _ _ (hm_in ⟨q', hq'⟩)
        · exact Ideal.mul_mem_right _ _ (he_other q ⟨q', hq'⟩ (Ne.symm hEq))
      have h1_part : (1 : C) = a_rad + ∑ q : ↥S_sing, (e_sing q * r_fn q) * u_fn q := by
        dsimp only [a_rad]
        have hSumEq : (∑ q : ↥S_sing, e_sing q * m_fn q) +
            (∑ q : ↥S_sing, (e_sing q * r_fn q) * u_fn q) =
            ∑ q : ↥S_sing, e_sing q := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun q _ => ?_
          calc
            e_sing q * m_fn q + (e_sing q * r_fn q) * u_fn q =
                e_sing q * (r_fn q * u_fn q + m_fn q) := by ring
            _ = e_sing q := by rw [hrm_eq q, mul_one]
        rw [add_assoc, hSumEq, sub_add_cancel]
      have hx_decomp : x.1 = algebraMap C Q a_rad * x.1 +
          ∑ q : ↥S_sing, algebraMap C Q (e_sing q * r_fn q) *
            (algebraMap C Q (u_fn q) * x.1) := by
        calc
          x.1 = algebraMap C Q 1 * x.1 := by rw [map_one, one_mul]
          _ = algebraMap C Q (a_rad + ∑ q : ↥S_sing, (e_sing q * r_fn q) * u_fn q) * x.1 := by
            rw [← h1_part]
          _ = algebraMap C Q a_rad * x.1 +
              ∑ q : ↥S_sing, algebraMap C Q (e_sing q * r_fn q) *
                (algebraMap C Q (u_fn q) * x.1) := by
            rw [map_add, add_mul, map_sum, Finset.sum_mul]
            congr 1
            refine Finset.sum_congr rfl fun q _ => ?_
            rw [map_mul, mul_assoc]
      rw [hx_decomp]
      refine W_C.add_mem (hInfSingAnn x.1 x.2 a_rad ha_rad_mem) (W_C.sum_mem fun q _ => ?_)
      obtain ⟨c_q, hcq⟩ := hu_WC q
      change algebraMap C Q c_q = _ at hcq
      refine ⟨e_sing q * r_fn q * c_q, ?_⟩
      change algebraMap C Q (e_sing q * r_fn q * c_q) = _
      rw [map_mul, hcq]

    have hBasisSing : ∀ q₀ : ↥S_sing,
        ∃ w₀ : ↥W_tilde, F_quot (K_sub.mkQ w₀) = Pi.single q₀ (1 : k₀) := by
      intro q₀
      obtain ⟨s, x₀, hs_not, hx₀_int, hRes_x₀⟩ := hLiftLocalTilde q₀
      have hMax_q₀ : q₀.1.asIdeal.IsMaximal := hMax q₀.1 q₀.2
      have hSup : Ideal.span {s} ⊔ q₀.1.asIdeal = ⊤ := by
        by_contra hNeT
        obtain ⟨M, hMMax, hLeM⟩ := Ideal.exists_le_maximal _ hNeT
        have hEqM : q₀.1.asIdeal = M := hMax_q₀.eq_of_le hMMax.ne_top (le_sup_right.trans hLeM)
        exact hs_not (hEqM.symm ▸ (le_sup_left.trans hLeM) (Ideal.subset_span rfl))
      have h1 : (1 : C) ∈ Ideal.span {s} ⊔ q₀.1.asIdeal := hSup ▸ Submodule.mem_top
      obtain ⟨y_s, hy_s, m₀, hm₀, hsm⟩ := Submodule.mem_sup.mp h1
      obtain ⟨r₀, rfl⟩ := Ideal.mem_span_singleton.mp hy_s
      let w_val : Q := algebraMap C Q (e_sing q₀ * r₀) * x₀
      have hw_int : w_val ∈ C_tilde :=
        C_tilde.mul_mem (algebraMap_mem C_tilde _) hx₀_int
      refine ⟨⟨w_val, hw_int⟩, ?_⟩
      funext q'
      change ϕ_fn q' ⟨resAt q'.1.asIdeal w_val, _⟩ =
        (Pi.single q₀ (1 : k₀) : ↥S_sing → k₀) q'
      by_cases hEq : q' = q₀
      · subst hEq
        rw [Pi.single_eq_same]
        have h1_ers : 1 - (e_sing q' * r₀ * s) ∈ q'.1.asIdeal := by
          have hEq1 : 1 - (e_sing q' * r₀ * s) =
              (1 - e_sing q') + e_sing q' * (1 - s * r₀) := by ring
          have hsr : 1 - s * r₀ = m₀ := by
            calc
              1 - s * r₀ = (s * r₀ + m₀) - s * r₀ := by rw [hsm]
              _ = m₀ := by ring
          rw [hEq1, hsr]
          exact Ideal.add_mem _ (he_self q') (Ideal.mul_mem_left _ _ hm₀)
        let m' : C := 1 - (e_sing q' * r₀ * s)
        have hm'_max : algebraMap C (A_loc q') m' ∈ IsLocalRing.maximalIdeal (A_loc q') :=
          (IsLocalization.AtPrime.to_map_mem_maximal_iff (A_loc q') q'.1.asIdeal m').mpr h1_ers
        obtain ⟨a_m, ham⟩ := (hLocNod q'.1 q'.2).1 (y₀_loc q') (algebraMap C (A_loc q') m') hm'_max
        refine hϕ_eq_of_rep q' _ 1 (-a_m) ?_
        dsimp only [w_val]
        rw [map_mul, hResAt_alg, hRes_x₀, map_one, map_one, map_one, one_mul, map_neg]
        have hCoeff : algebraMap (A_loc q') (QA_loc q')
            (algebraMap C (A_loc q') (e_sing q' * r₀)) *
            (algebraMap (A_loc q') (QA_loc q') (algebraMap C (A_loc q') s) * (y₀_loc q').1) =
            (y₀_loc q').1 -
              algebraMap (A_loc q') (QA_loc q') (algebraMap C (A_loc q') m') * (y₀_loc q').1 := by
          have hm'_def : algebraMap C (A_loc q') (e_sing q' * r₀) * algebraMap C (A_loc q') s =
              1 - algebraMap C (A_loc q') m' := by
            dsimp only [m']
            rw [← map_mul, map_sub, map_one]
            ring
          rw [← mul_assoc, ← map_mul, hm'_def, map_sub, map_one, sub_mul, one_mul]
        rw [hCoeff, ← ham]
        ring
      · rw [Pi.single_eq_of_ne hEq, hϕ_zero_iff]
        change resAt q'.1.asIdeal w_val ∈ Set.range (algebraMap (A_loc q') (QA_loc q'))
        have he_mem : e_sing q₀ ∈ q'.1.asIdeal := he_other q₀ q' hEq
        have he_max : algebraMap C (A_loc q') (e_sing q₀) ∈ IsLocalRing.maximalIdeal (A_loc q') :=
          (IsLocalization.AtPrime.to_map_mem_maximal_iff (A_loc q') q'.1.asIdeal _).mpr he_mem
        have hrx_int : resAt q'.1.asIdeal (algebraMap C Q r₀ * x₀) ∈ Atilde_loc q' :=
          hResAt_int q'.1.asIdeal _ (C_tilde.mul_mem (algebraMap_mem C_tilde r₀) hx₀_int)
        have hw_eq : resAt q'.1.asIdeal w_val =
            algebraMap (A_loc q') (QA_loc q') (algebraMap C (A_loc q') (e_sing q₀)) *
              resAt q'.1.asIdeal (algebraMap C Q r₀ * x₀) := by
          dsimp only [w_val]
          rw [map_mul (algebraMap C Q), mul_assoc, map_mul (resAt q'.1.asIdeal), hResAt_alg]
        rw [hw_eq]
        exact (hLocNod q'.1 q'.2).1 ⟨_, hrx_int⟩ _ he_max

    have hSurj_Fquot : Function.Surjective F_quot := by
      intro g
      let b_fn : ↥S_sing → ↥W_tilde := fun q₀ => (hBasisSing q₀).choose
      have hb_spec : ∀ q₀ : ↥S_sing, F_quot (K_sub.mkQ (b_fn q₀)) = Pi.single q₀ (1 : k₀) :=
        fun q₀ => (hBasisSing q₀).choose_spec
      refine ⟨∑ q₀ : ↥S_sing, g q₀ • K_sub.mkQ (b_fn q₀), ?_⟩
      rw [map_sum]
      funext q'
      rw [Finset.sum_apply, Finset.sum_eq_single q']
      · simp only [LinearMap.map_smul, hb_spec, Pi.smul_apply, Pi.single_eq_same,
          smul_eq_mul, mul_one]
      · intro q₀ _ hne
        simp only [LinearMap.map_smul, hb_spec, Pi.smul_apply,
          Pi.single_eq_of_ne (Ne.symm hne), smul_zero]
      · intro hNotUniv
        exact False.elim (hNotUniv (Finset.mem_univ q'))

    let E_lin : (↥W_tilde ⧸ K_sub) ≃ₗ[k₀] (↥S_sing → k₀) :=
      LinearEquiv.ofBijective F_quot ⟨hInj_Fquot, hSurj_Fquot⟩
    have hModFin : Module.Finite k₀ (↥W_tilde ⧸ K_sub) :=
      Module.Finite.equiv E_lin.symm
    have hFinrank : Module.finrank k₀ (↥W_tilde ⧸ K_sub) = S_sing.card := by
      rw [LinearEquiv.finrank_eq E_lin, Module.finrank_fintype_fun_eq_card, Fintype.card_coe]

    refine ⟨hModFin, hFinrank, ?_⟩

    intro hTwoMin 𝔭₀_id h𝔭₀_min
    let 𝔭₀ : ℳ := ⟨𝔭₀_id, hFinMin.mem_toFinset.mpr h𝔭₀_min⟩
    haveI : 𝔭₀_id.IsPrime := h𝔭₀_min.1.1
    haveI : IsDomain (C ⧸ 𝔭₀_id) := Ideal.Quotient.isDomain 𝔭₀_id

    let inSep : Q → Prop := fun x =>
      ∀ 𝔭 : ℳ, Ψ_Q x 𝔭 ∈ Set.range (algebraMap (C ⧸ 𝔭.1) (K_p 𝔭))
    have hSep_sub_tilde : ∀ x : Q, inSep x → x ∈ C_tilde := by
      intro x hxSep
      rw [hIntQ]
      intro 𝔭
      obtain ⟨y_bar, hy_bar⟩ := hxSep 𝔭
      rw [← hy_bar]
      exact isIntegral_algebraMap
    have hWC_sub_Sep : ∀ x : Q, x ∈ W_C → inSep x := by
      rintro x ⟨c, rfl⟩ 𝔭
      exact ⟨Ideal.Quotient.mk 𝔭.1 c, (hΨ_alg c 𝔭).symm⟩
    have hSep_add : ∀ x y : Q, inSep x → inSep y → inSep (x + y) := by
      intro x y hx hy 𝔭
      rcases hx 𝔭 with ⟨ax, hax⟩
      rcases hy 𝔭 with ⟨ay, hay⟩
      exact ⟨ax + ay, by rw [map_add, hax, hay, ← Pi.add_apply, ← map_add]⟩
    have hSep_mulC : ∀ (c : C) (x : Q), inSep x → inSep (algebraMap C Q c * x) := by
      intro c x hx 𝔭
      rcases hx 𝔭 with ⟨ax, hax⟩
      refine ⟨Ideal.Quotient.mk 𝔭.1 c * ax, ?_⟩
      rw [map_mul, hax]
      change toKp 𝔭 c * Ψ_Q x 𝔭 = Ψ_Q (algebraMap C Q c * x) 𝔭
      rw [← hΨ_alg c 𝔭, ← Pi.mul_apply, ← map_mul]

    have hSepBasis : ∀ q : ↥S_sing,
        ∃ v_q : ↥W_tilde, inSep v_q.1 ∧ F_quot (K_sub.mkQ v_q) = Pi.single q (1 : k₀) := by
      intro q
      obtain ⟨𝔭₁_id, h𝔭₁_min, 𝔭₂_id, h𝔭₂_min, h𝔭12_ne, h𝔭₁_le, h𝔭₂_le⟩ := hTwoMin q.1 q.2
      let 𝔭₁ : ℳ := ⟨𝔭₁_id, hFinMin.mem_toFinset.mpr h𝔭₁_min⟩
      let 𝔭₂ : ℳ := ⟨𝔭₂_id, hFinMin.mem_toFinset.mpr h𝔭₂_min⟩
      have h𝔭12_ne' : 𝔭₁ ≠ 𝔭₂ := fun h => h𝔭12_ne (congrArg Subtype.val h)
      let ind_f : Pi_K := fun 𝔭 => if 𝔭 = 𝔭₁ then 1 else 0
      obtain ⟨e_ind, he_ind⟩ := hSurj_Ψ ind_f
      have he_sep : inSep e_ind := by
        intro 𝔭
        rw [he_ind]
        dsimp only [ind_f]
        split_ifs
        · exact ⟨1, map_one _⟩
        · exact ⟨0, map_zero _⟩
      have he_tilde : e_ind ∈ C_tilde := hSep_sub_tilde e_ind he_sep
      have he_not_loc :
          resAt q.1.asIdeal e_ind ∉ Set.range (algebraMap (A_loc q) (QA_loc q)) := by
        intro hInRange
        obtain ⟨u_m, hum_not, c₀, hc₀_eq⟩ := hLiftFromQA q.1.asIdeal e_ind hInRange
        change algebraMap C Q c₀ = _ at hc₀_eq
        have hSlot₁ : toKp 𝔭₁ c₀ = toKp 𝔭₁ u_m := by
          have h1 := congrFun (congrArg Ψ_Q hc₀_eq) 𝔭₁
          rw [hΨ_alg, map_mul Ψ_Q, Pi.mul_apply, hΨ_alg, he_ind] at h1
          dsimp only [ind_f] at h1
          rw [if_pos rfl, mul_one] at h1
          exact h1
        have hSlot₂ : toKp 𝔭₂ c₀ = 0 := by
          have h2 := congrFun (congrArg Ψ_Q hc₀_eq) 𝔭₂
          rw [hΨ_alg, map_mul Ψ_Q, Pi.mul_apply, hΨ_alg, he_ind] at h2
          dsimp only [ind_f] at h2
          rw [if_neg h𝔭12_ne'.symm, mul_zero] at h2
          exact h2
        have hc₀_sub_𝔭₁ : c₀ - u_m ∈ 𝔭₁.1 := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
          exact IsFractionRing.injective (C ⧸ 𝔭₁.1) (K_p 𝔭₁) hSlot₁
        have hc₀_𝔭₂ : c₀ ∈ 𝔭₂.1 := by
          rw [← Ideal.Quotient.eq_zero_iff_mem]
          exact IsFractionRing.injective (C ⧸ 𝔭₂.1) (K_p 𝔭₂)
            (hSlot₂.trans (map_zero _).symm)
        have hum_in_q : u_m ∈ q.1.asIdeal := by
          have hum_eq : u_m = c₀ - (c₀ - u_m) := by ring
          rw [hum_eq]
          exact Ideal.sub_mem _ (h𝔭₂_le hc₀_𝔭₂) (h𝔭₁_le hc₀_sub_𝔭₁)
        exact hum_not hum_in_q

      let μ_q : k₀ := ϕ_fn q ⟨resAt q.1.asIdeal e_ind, hResAt_int q.1.asIdeal e_ind he_tilde⟩
      have hμ_ne : μ_q ≠ 0 :=
        fun h0 => he_not_loc ((hϕ_zero_iff q _).mp h0)
      let v_val : Q := algebraMap C Q (algebraMap k₀ C μ_q⁻¹ * e_sing q) * e_ind
      have hv_sep : inSep v_val := hSep_mulC _ e_ind he_sep
      have hv_tilde : v_val ∈ C_tilde := hSep_sub_tilde v_val hv_sep
      refine ⟨⟨v_val, hv_tilde⟩, hv_sep, ?_⟩
      funext q'
      change ϕ_fn q' ⟨resAt q'.1.asIdeal v_val, _⟩ =
        (Pi.single q (1 : k₀) : ↥S_sing → k₀) q'
      by_cases hEq : q' = q
      · subst hEq
        rw [Pi.single_eq_same]
        let e_loc : ↥(Atilde_loc q') :=
          ⟨resAt q'.1.asIdeal e_ind, hResAt_int q'.1.asIdeal e_ind he_tilde⟩
        let eq_eloc : ↥(Atilde_loc q') :=
          ⟨algebraMap (A_loc q') (QA_loc q') (algebraMap C (A_loc q') (e_sing q')) * e_loc.1,
            (Atilde_loc q').mul_mem (algebraMap_mem _ _) e_loc.2⟩
        have hϕ_eq_μ : ϕ_fn q' eq_eloc = μ_q := by
          have hDiffRange : e_loc.1 - eq_eloc.1 ∈
              Set.range (algebraMap (A_loc q') (QA_loc q')) := by
            have hSub : e_loc.1 - eq_eloc.1 =
                algebraMap (A_loc q') (QA_loc q')
                  (algebraMap C (A_loc q') (1 - e_sing q')) * e_loc.1 := by
              dsimp only [eq_eloc]
              rw [map_sub, map_one, map_sub, map_one, sub_mul, one_mul]
            rw [hSub]
            have hMaxMem : algebraMap C (A_loc q') (1 - e_sing q') ∈
                IsLocalRing.maximalIdeal (A_loc q') :=
              (IsLocalization.AtPrime.to_map_mem_maximal_iff (A_loc q') q'.1.asIdeal _).mpr
                (he_self q')
            exact (hLocNod q'.1 q'.2).1 e_loc _ hMaxMem
          have hϕ_diff0 : ϕ_fn q' (e_loc + (-eq_eloc)) = 0 :=
            (hϕ_zero_iff q' (e_loc + (-eq_eloc))).mpr (by
              change e_loc.1 + (-eq_eloc.1) ∈ _
              rw [← sub_eq_add_neg]
              exact hDiffRange)
          have hϕ_neg : ϕ_fn q' (-eq_eloc) = - ϕ_fn q' eq_eloc := by
            have hneg1 : (-eq_eloc : ↥(Atilde_loc q')) =
                ⟨algebraMap (A_loc q') (QA_loc q')
                  (algebraMap C (A_loc q') (algebraMap k₀ C (-1))) * eq_eloc.1,
                  (Atilde_loc q').mul_mem (algebraMap_mem _ _) eq_eloc.2⟩ := by
              ext
              change -eq_eloc.1 =
                algebraMap (A_loc q') (QA_loc q')
                  (algebraMap C (A_loc q') (algebraMap k₀ C (-1))) * eq_eloc.1
              simp only [map_neg, map_one]
              ring
            rw [hneg1, hϕ_smul_k₀, neg_one_mul]
          rw [hϕ_add, hϕ_neg, ← sub_eq_add_neg] at hϕ_diff0
          exact (sub_eq_zero.mp hϕ_diff0).symm
        have hv_sub : (⟨resAt q'.1.asIdeal v_val,
            hResAt_int q'.1.asIdeal v_val hv_tilde⟩ : ↥(Atilde_loc q')) =
            ⟨algebraMap (A_loc q') (QA_loc q')
              (algebraMap C (A_loc q') (algebraMap k₀ C μ_q⁻¹)) * eq_eloc.1,
              (Atilde_loc q').mul_mem (algebraMap_mem _ _) eq_eloc.2⟩ := by
          ext
          dsimp only [v_val, eq_eloc, e_loc]
          rw [map_mul, hResAt_alg, map_mul, map_mul, mul_assoc]
        rw [hv_sub, hϕ_smul_k₀, hϕ_eq_μ, inv_mul_cancel₀ hμ_ne]
      · rw [Pi.single_eq_of_ne hEq, hϕ_zero_iff]
        change resAt q'.1.asIdeal v_val ∈ Set.range (algebraMap (A_loc q') (QA_loc q'))
        have he_mem : e_sing q ∈ q'.1.asIdeal := he_other q q' hEq
        have he_max : algebraMap C (A_loc q') (e_sing q) ∈ IsLocalRing.maximalIdeal (A_loc q') :=
          (IsLocalization.AtPrime.to_map_mem_maximal_iff (A_loc q') q'.1.asIdeal _).mpr he_mem
        have hv_eq : resAt q'.1.asIdeal v_val =
            algebraMap (A_loc q') (QA_loc q') (algebraMap C (A_loc q') (e_sing q)) *
              resAt q'.1.asIdeal (algebraMap C Q (algebraMap k₀ C μ_q⁻¹) * e_ind) := by
          dsimp only [v_val]
          rw [mul_comm (algebraMap k₀ C μ_q⁻¹) (e_sing q), map_mul (algebraMap C Q),
            mul_assoc, map_mul (resAt q'.1.asIdeal), hResAt_alg]
        rw [hv_eq]
        exact (hLocNod q'.1 q'.2).1
          ⟨_, hResAt_int q'.1.asIdeal _ (C_tilde.mul_mem (algebraMap_mem C_tilde _) he_tilde)⟩
          _ he_max

    have hTildeEqSep : ∀ x : Q, x ∈ C_tilde → inSep x := by
      intro x hx
      let v_fn : ↥S_sing → ↥W_tilde := fun q => (hSepBasis q).choose
      have hv_sep : ∀ q : ↥S_sing, inSep (v_fn q).1 :=
        fun q => (hSepBasis q).choose_spec.1
      have hv_F : ∀ q : ↥S_sing, F_quot (K_sub.mkQ (v_fn q)) = Pi.single q (1 : k₀) :=
        fun q => (hSepBasis q).choose_spec.2
      let x_w : ↥W_tilde := ⟨x, hx⟩
      let c_q : ↥S_sing → k₀ := F_quot (K_sub.mkQ x_w)
      let comb : ↥W_tilde := ∑ q : ↥S_sing, c_q q • v_fn q
      have hcomb_sep : inSep comb.1 := by
        have hval : comb.1 = ∑ q : ↥S_sing,
            algebraMap C Q (algebraMap k₀ C (c_q q)) * (v_fn q).1 := by
          change (∑ q : ↥S_sing, c_q q • v_fn q).1 = _
          rw [AddSubmonoidClass.coe_finset_sum]
          refine Finset.sum_congr rfl fun q _ => ?_
          change c_q q • (v_fn q).1 = _
          rw [← IsScalarTower.algebraMap_apply k₀ C Q (c_q q), Algebra.smul_def]
        rw [hval]
        have hSumSep : ∀ S : Finset ↥S_sing,
            inSep (∑ q ∈ S, algebraMap C Q (algebraMap k₀ C (c_q q)) * (v_fn q).1) := by
          intro S
          refine Finset.induction_on S ?_ ?_
          · rw [Finset.sum_empty]
            exact hWC_sub_Sep 0 W_C.zero_mem
          · intro q S' hqNot ih
            rw [Finset.sum_insert hqNot]
            exact hSep_add _ _ (hSep_mulC _ _ (hv_sep q)) ih
        exact hSumSep Finset.univ
      have hFEq : F_quot (K_sub.mkQ x_w) = F_quot (K_sub.mkQ comb) := by
        dsimp only [comb]
        rw [map_sum, map_sum]
        funext q'
        rw [Finset.sum_apply, Finset.sum_eq_single q']
        · simp only [LinearMap.map_smul, hv_F, Pi.smul_apply, Pi.single_eq_same,
            smul_eq_mul, mul_one, c_q]
        · intro q _ hne
          simp only [LinearMap.map_smul, hv_F, Pi.smul_apply,
            Pi.single_eq_of_ne (Ne.symm hne), smul_zero]
        · intro hNotU
          exact False.elim (hNotU (Finset.mem_univ q'))
      have hDiffKer : x_w - comb ∈ K_sub := by
        rw [← Submodule.Quotient.mk_eq_zero]
        apply hInj_Fquot
        rw [map_zero]
        change F_quot (K_sub.mkQ (x_w - comb)) = 0
        rw [map_sub, map_sub, hFEq, sub_self]
      have hDiffWC : x - comb.1 ∈ W_C := hDiffKer
      have hx_eq : x = (x - comb.1) + comb.1 := (sub_add_cancel x comb.1).symm
      rw [hx_eq]
      exact hSep_add _ _ (hWC_sub_Sep _ hDiffWC) hcomb_sep

    rw [isIntegrallyClosed_iff (K_p 𝔭₀)]
    intro z hzInt
    let z_Pi : Pi_K := fun 𝔭 => if h : 𝔭 = 𝔭₀ then h ▸ z else 0
    obtain ⟨x_z, hx_z⟩ := hSurj_Ψ z_Pi
    have hxz_tilde : x_z ∈ C_tilde := by
      rw [hIntQ]
      intro 𝔭
      rw [hx_z]
      dsimp only [z_Pi]
      by_cases h : 𝔭 = 𝔭₀
      · subst h; rw [dif_pos rfl]; exact hzInt
      · rw [dif_neg h]; exact isIntegral_zero
    have hxz_sep : inSep x_z := hTildeEqSep x_z hxz_tilde
    obtain ⟨y_bar, hy_bar⟩ := hxz_sep 𝔭₀
    refine ⟨y_bar, ?_⟩
    rw [hy_bar, hx_z]
    dsimp only [z_Pi]
    rw [dif_pos rfl]

  
  refine ⟨hEtDVR, ?_⟩
  intro C _ _ _ _ S_sing hMax hSmEt hNodRoof
  have hSm : ∀ q : PrimeSpectrum C, q.asIdeal.IsMaximal → q ∉ S_sing →
      ∃ g : C, g ∉ q.asIdeal ∧
        IsDomain (Localization.Away g) ∧
        IsIntegrallyClosed (Localization.Away g) := by
    intro q hqMax hqNot
    obtain ⟨g, ψ, hgNot, hDomLg, hEtψ, _hCompψ⟩ := hSmEt q hqMax hqNot
    letI : IsDomain (Localization.Away g) := hDomLg
    letI : Algebra (Polynomial k₀) (Localization.Away g) := ψ.toAlgebra
    haveI : Algebra.Etale (Polynomial k₀) (Localization.Away g) := hEtψ
    exact ⟨g, hgNot, hDomLg, (hEtDVR (Localization.Away g)).1⟩
  have hLocNod : ∀ q ∈ S_sing,
      let A := Localization.AtPrime q.asIdeal
      let Q_A := Localization (nonZeroDivisors A)
      let A_tilde := integralClosure A Q_A
      (∀ (y : ↥A_tilde) (m : A), m ∈ IsLocalRing.maximalIdeal A →
        algebraMap A Q_A m * y.1 ∈ Set.range (algebraMap A Q_A)) ∧
      (∃ y₀ : ↥A_tilde, y₀.1 ∉ Set.range (algebraMap A Q_A) ∧
        ∀ y : ↥A_tilde, ∃ (c : k₀) (a : A),
          y.1 = algebraMap A Q_A (algebraMap C A (algebraMap k₀ C c)) * y₀.1 +
            algebraMap A Q_A a) := by
    intro q hqSing
    haveI : q.asIdeal.IsMaximal := hMax q hqSing
    obtain ⟨B', _instCommB', u₀, φ₁, φ₂, hEt₁, hEt₂, hComap, hComp₁₂, hOrig, hDom⟩ :=
      hNodRoof q hqSing
    letI : CommRing B' := _instCommB'
    obtain ⟨_hMaxU₀, hb, hInfB, hMaxB_eq, hNotPrincB, hDVR, hGlueEx⟩ :=
      hS2 B' u₀ (φ₁.comp (algebraMap k₀ C)) φ₂ hEt₂ hComp₁₂.symm hOrig hDom
    exact hS4 C q B' u₀ φ₁ hEt₁ hComap
      (fun i => algebraMap B' (Localization.AtPrime u₀.asIdeal)
        (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))))
      hb hInfB hMaxB_eq hNotPrincB hDVR hGlueEx
  exact hS3 C S_sing hMax hSm hLocNod

theorem weil_twoChart_component_subscheme_minimalPrime_and_const_glue (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (hAppTop : ∀ (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Y]
        (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀)) [AlgebraicGeometry.IsProper p]
        (σ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Y),
      σ ≫ p = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀)) →
      Function.Bijective (p.appTop).hom)
    (Z₀ : AlgebraicGeometry.Scheme.{u})
    (p_Z₀ : Z₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    [AlgebraicGeometry.IsProper p_Z₀]
    [AlgebraicGeometry.IsReduced Z₀]
    (hFinComp : (irreducibleComponents ↥Z₀).Finite)
    (Sing_Z₀ : Set ↥Z₀)
    (Z_00 Z_01 : Z₀.Opens)
    (hAff0 : AlgebraicGeometry.IsAffineOpen Z_00)
    (hAff1 : AlgebraicGeometry.IsAffineOpen Z_01)
    (hCov01 : Z_00 ⊔ Z_01 = ⊤)
    (hSing01 : Sing_Z₀ ⊆ (Z_00 ⊓ Z_01 : Set ↥Z₀))
    (hMeetSm : ∀ Z_comp ∈ irreducibleComponents ↥Z₀,
      (Z_comp ∩ ((Z_00 ⊓ Z_01 : Set ↥Z₀) \ Sing_Z₀)).Nonempty)
    (y₁ : ↑(Z₀.presheaf.obj (Opposite.op Z_00)))
    (x₀ : ↑(Z₀.presheaf.obj (Opposite.op Z_01)))
    (hy₁_open : Z₀.basicOpen y₁ = Z_00 ⊓ Z_01)
    (hx₀_open : Z₀.basicOpen x₀ = Z_00 ⊓ Z_01)
    (hyx_one :
      (Z₀.presheaf.map (CategoryTheory.homOfLE (inf_le_left : Z_00 ⊓ Z_01 ≤ Z_00)).op).hom y₁ *
      (Z₀.presheaf.map (CategoryTheory.homOfLE (inf_le_right : Z_00 ⊓ Z_01 ≤ Z_01)).op).hom x₀ = 1)
    (hSmNeBot : ∀ q : PrimeSpectrum ↑(Z₀.presheaf.obj (Opposite.op Z_00)),
      hAff0.fromSpec.base q ∉ Sing_Z₀ →
      ∃ (g : ↑(Z₀.presheaf.obj (Opposite.op Z_00)))
        (_ : IsDomain (Localization.Away g)),
        g ∉ q.asIdeal ∧
        ∀ (𝔪 : Ideal (Localization.Away g)) [𝔪.IsMaximal], 𝔪 ≠ ⊥) :
    let B₀ : Type u := ↑(Z₀.presheaf.obj (Opposite.op Z_00))
    let C_aff : Type u := ↑(Z₀.presheaf.obj (Opposite.op Z_01))
    letI : Algebra k₀ B₀ :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_Z₀.appLE ⊤ Z_00 le_top).hom).toAlgebra
    letI : Algebra k₀ C_aff :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_Z₀.appLE ⊤ Z_01 le_top).hom).toAlgebra
    (Algebra.FiniteType k₀ B₀ ∧
      Algebra.FiniteType k₀ C_aff ∧
      _root_.IsReduced B₀ ∧
      _root_.IsReduced C_aff ∧
      (minimalPrimes C_aff).Finite ∧
      (minimalPrimes C_aff).ncard = (irreducibleComponents ↥Z₀).ncard ∧
      ∀ (𝔪 : Ideal B₀) (h𝔪 : 𝔪.IsMaximal), y₁ ∈ 𝔪 →
        hAff0.fromSpec.base ⟨𝔪, h𝔪.isPrime⟩ ∉ Sing_Z₀) ∧
    ∃ (e_comp : ↥(irreducibleComponents ↥Z₀) ≃ ↥(minimalPrimes C_aff))
      (e_B0 : ↥(minimalPrimes C_aff) ≃ ↥(minimalPrimes B₀)),
      ∀ (Z_comp : Set ↥Z₀) (hZ : Z_comp ∈ irreducibleComponents ↥Z₀),
        let 𝔭 : ↥(minimalPrimes C_aff) := e_comp ⟨Z_comp, hZ⟩
        let 𝔮 : ↥(minimalPrimes B₀) := e_B0 𝔭
        letI : 𝔭.1.IsPrime := 𝔭.2.1.1
        letI : 𝔮.1.IsPrime := 𝔮.2.1.1
        ∃ (Z_sch : AlgebraicGeometry.Scheme.{u})
          (ι_Z : Z_sch ⟶ Z₀)
          (_ : AlgebraicGeometry.IsClosedImmersion ι_Z)
          (_ : AlgebraicGeometry.IsIntegral Z_sch)
          (ι_B : (B₀ ⧸ 𝔮.1) →ₐ[k₀] FractionRing (C_aff ⧸ 𝔭.1)),
          Set.range ι_Z.base = Z_comp ∧
          y₁ ∉ 𝔮.1 ∧
          ¬ IsUnit (Ideal.Quotient.mk 𝔮.1 y₁) ∧
          Function.Injective ι_B ∧
          @IsFractionRing (B₀ ⧸ 𝔮.1) _ (FractionRing (C_aff ⧸ 𝔭.1)) _ ι_B.toRingHom.toAlgebra ∧
          (∀ (D : ℕ) (f : C_aff) (b : B₀),
            (Z₀.presheaf.map (CategoryTheory.homOfLE (inf_le_left : Z_00 ⊓ Z_01 ≤ Z_00)).op).hom b =
              ((Z₀.presheaf.map (CategoryTheory.homOfLE (inf_le_left : Z_00 ⊓ Z_01 ≤ Z_00)).op).hom y₁) ^ D *
                (Z₀.presheaf.map (CategoryTheory.homOfLE (inf_le_right : Z_00 ⊓ Z_01 ≤ Z_01)).op).hom f →
            (ι_B (Ideal.Quotient.mk 𝔮.1 y₁)) ^ D *
              algebraMap (C_aff ⧸ 𝔭.1) (FractionRing (C_aff ⧸ 𝔭.1)) (Ideal.Quotient.mk 𝔭.1 f) =
              ι_B (Ideal.Quotient.mk 𝔮.1 b)) ∧
          (∀ c : C_aff ⧸ 𝔭.1,
            (∃ (k : ℕ) (b : B₀ ⧸ 𝔮.1),
              (ι_B (Ideal.Quotient.mk 𝔮.1 y₁)) ^ k *
                algebraMap (C_aff ⧸ 𝔭.1) (FractionRing (C_aff ⧸ 𝔭.1)) c = ι_B b) ∧
            (∀ b₀ : B₀ ⧸ 𝔮.1,
              algebraMap (C_aff ⧸ 𝔭.1) (FractionRing (C_aff ⧸ 𝔭.1)) c = ι_B b₀ →
              ∃ a : k₀, c = algebraMap k₀ (C_aff ⧸ 𝔭.1) a)) ∧
          let U_Z0 : Z_sch.Opens := (TopologicalSpace.Opens.map ι_Z.base).obj Z_00
          let U_Z1 : Z_sch.Opens := (TopologicalSpace.Opens.map ι_Z.base).obj Z_01
          letI : Algebra k₀ ↑(Z_sch.presheaf.obj (Opposite.op U_Z0)) :=
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
              (ι_Z ≫ p_Z₀).appLE ⊤ U_Z0 le_top).hom).toAlgebra
          letI : Algebra k₀ ↑(Z_sch.presheaf.obj (Opposite.op U_Z1)) :=
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
              (ι_Z ≫ p_Z₀).appLE ⊤ U_Z1 le_top).hom).toAlgebra
          U_Z0 ⊔ U_Z1 = ⊤ ∧
          Nonempty ↥U_Z0 ∧
          Nonempty ↥U_Z1 ∧
          Z_sch.basicOpen ((ι_Z.app Z_00).hom y₁) = U_Z0 ⊓ U_Z1 ∧
          AlgebraicGeometry.IsAffineOpen U_Z0 ∧
          AlgebraicGeometry.IsAffineOpen U_Z1 ∧
          ∃ (isoB : (B₀ ⧸ 𝔮.1) ≃ₐ[k₀] ↑(Z_sch.presheaf.obj (Opposite.op U_Z0)))
            (isoC : (C_aff ⧸ 𝔭.1) ≃ₐ[k₀] ↑(Z_sch.presheaf.obj (Opposite.op U_Z1))),
            isoB (Ideal.Quotient.mk 𝔮.1 y₁) = (ι_Z.app Z_00).hom y₁ ∧
            ∀ (b₁ b₂ : B₀ ⧸ 𝔮.1) (c₁ : C_aff ⧸ 𝔭.1),
              ι_B b₁ * algebraMap (C_aff ⧸ 𝔭.1) (FractionRing (C_aff ⧸ 𝔭.1)) c₁ = ι_B b₂ →
              (Z_sch.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_Z0 ⊓ U_Z1 ≤ U_Z0)).op).hom
                  (isoB b₁) *
                (Z_sch.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_Z0 ⊓ U_Z1 ≤ U_Z1)).op).hom
                  (isoC c₁) =
              (Z_sch.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_Z0 ⊓ U_Z1 ≤ U_Z0)).op).hom
                (isoB b₂) :=
by
  let _ := hFinComp
  
  have h_s2 : ∀ (X : Type u) [TopologicalSpace X] (R : Type u) [CommRing R]
      (f : PrimeSpectrum R → X),
      Topology.IsOpenEmbedding f →
      (∀ Z ∈ irreducibleComponents X, (Z ∩ Set.range f).Nonempty) →
      ∃ (e : ↥(irreducibleComponents X) ≃ ↥(minimalPrimes R)),
        (minimalPrimes R).ncard = (irreducibleComponents X).ncard ∧
        (∀ (Z : Set X) (hZ : Z ∈ irreducibleComponents X),
          PrimeSpectrum.zeroLocus ((e ⟨Z, hZ⟩).1 : Set R) = f ⁻¹' Z ∧
          closure (f '' PrimeSpectrum.zeroLocus ((e ⟨Z, hZ⟩).1 : Set R)) = Z) := by
    intro X _ R _ f hf hMeet
    have hPreIrred : ∀ (T : Set X), IsIrreducible T → (T ∩ Set.range f).Nonempty →
        IsIrreducible (f ⁻¹' T) ∧ T ⊆ closure (f '' (f ⁻¹' T)) := by
      intro T hT hT_meet
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · rcases hT_meet with ⟨_, hyT, q, rfl⟩
        exact ⟨q, hyT⟩
      · intro U₁ U₂ hU₁ hU₂ ⟨q₁, hq₁T, hq₁U⟩ ⟨q₂, hq₂T, hq₂U⟩
        obtain ⟨y, hyT, ⟨p₁, hp₁U, hp₁eq⟩, ⟨p₂, hp₂U, hp₂eq⟩⟩ :=
          hT.isPreirreducible (f '' U₁) (f '' U₂)
            (hf.isOpenMap U₁ hU₁) (hf.isOpenMap U₂ hU₂)
            ⟨f q₁, hq₁T, q₁, hq₁U, rfl⟩ ⟨f q₂, hq₂T, q₂, hq₂U, rfl⟩
        have hp12 : p₁ = p₂ := hf.injective (hp₁eq.trans hp₂eq.symm)
        subst hp12
        have hp₁T : p₁ ∈ f ⁻¹' T := by
          show f p₁ ∈ T
          rwa [hp₁eq]
        exact ⟨p₁, hp₁T, hp₁U, hp₂U⟩
      · rw [Set.image_preimage_eq_inter_range]
        exact subset_closure_inter_of_isPreirreducible_of_isOpen
          hT.isPreirreducible hf.isOpen_range hT_meet
    have hFwd : ∀ (Z : Set X), Z ∈ irreducibleComponents X →
        PrimeSpectrum.vanishingIdeal (f ⁻¹' Z) ∈ minimalPrimes R ∧
        PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal (f ⁻¹' Z) : Set R) = f ⁻¹' Z ∧
        closure (f '' (f ⁻¹' Z)) = Z := by
      intro Z hZ
      obtain ⟨hFZ_irred, hZ_sub⟩ := hPreIrred Z hZ.1 (hMeet Z hZ)
      have hZ_cl : IsClosed Z := isClosed_of_mem_irreducibleComponents Z hZ
      have hFZ_cl : IsClosed (f ⁻¹' Z) := hZ_cl.preimage hf.continuous
      have hCl_eq : closure (f '' (f ⁻¹' Z)) = Z :=
        Set.Subset.antisymm (hZ_cl.closure_subset_iff.mpr (Set.image_preimage_subset f Z)) hZ_sub
      have hFZ_comp : f ⁻¹' Z ∈ irreducibleComponents (PrimeSpectrum R) := by
        refine ⟨hFZ_irred, fun S hS hSub => ?_⟩
        have hClS_irred : IsIrreducible (closure (f '' S)) :=
          (hS.image f hf.continuous.continuousOn).closure
        have hZ_le : Z ⊆ closure (f '' S) := hCl_eq ▸ closure_mono (Set.image_mono hSub)
        have hClS_le : closure (f '' S) ⊆ Z := hZ.2 hClS_irred hZ_le
        exact fun q hq => hClS_le (subset_closure ⟨q, hq, rfl⟩)
      have hMin : PrimeSpectrum.vanishingIdeal (f ⁻¹' Z) ∈ minimalPrimes R := by
        rw [PrimeSpectrum.vanishingIdeal_mem_minimalPrimes, hFZ_cl.closure_eq]
        exact hFZ_comp
      have hZero : PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal (f ⁻¹' Z) : Set R) =
          f ⁻¹' Z := by
        rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hFZ_cl.closure_eq]
      exact ⟨hMin, hZero, hCl_eq⟩
    have hBwd : ∀ (𝔭 : Ideal R), 𝔭 ∈ minimalPrimes R →
        closure (f '' PrimeSpectrum.zeroLocus (𝔭 : Set R)) ∈ irreducibleComponents X ∧
        f ⁻¹' closure (f '' PrimeSpectrum.zeroLocus (𝔭 : Set R)) =
          PrimeSpectrum.zeroLocus (𝔭 : Set R) := by
      intro 𝔭 h𝔭
      have h𝔭_prime : 𝔭.IsPrime := h𝔭.1.1
      have h𝔭_rad : 𝔭.radical = 𝔭 := h𝔭_prime.isRadical.radical
      have hW_comp : PrimeSpectrum.zeroLocus (𝔭 : Set R) ∈
          irreducibleComponents (PrimeSpectrum R) := by
        rw [PrimeSpectrum.zeroLocus_ideal_mem_irreducibleComponents, h𝔭_rad]
        exact h𝔭
      have hW_cl : IsClosed (PrimeSpectrum.zeroLocus (𝔭 : Set R)) :=
        PrimeSpectrum.isClosed_zeroLocus _
      have hPreEq : f ⁻¹' closure (f '' PrimeSpectrum.zeroLocus (𝔭 : Set R)) =
          PrimeSpectrum.zeroLocus (𝔭 : Set R) := by
        rw [← hf.isInducing.closure_eq_preimage_closure_image, hW_cl.closure_eq]
      have hZ_irred : IsIrreducible (closure (f '' PrimeSpectrum.zeroLocus (𝔭 : Set R))) :=
        (hW_comp.1.image f hf.continuous.continuousOn).closure
      refine ⟨⟨hZ_irred, fun T hT hSub => ?_⟩, hPreEq⟩
      rcases hW_comp.1.nonempty with ⟨q₀, hq₀⟩
      have hT_meet : (T ∩ Set.range f).Nonempty :=
        ⟨f q₀, hSub (subset_closure ⟨q₀, hq₀, rfl⟩), q₀, rfl⟩
      obtain ⟨hFT_irred, hT_sub⟩ := hPreIrred T hT hT_meet
      have hW_le : PrimeSpectrum.zeroLocus (𝔭 : Set R) ⊆ f ⁻¹' T := hPreEq ▸ Set.preimage_mono hSub
      have hFT_eq : f ⁻¹' T = PrimeSpectrum.zeroLocus (𝔭 : Set R) :=
        Set.Subset.antisymm (hW_comp.2 hFT_irred hW_le) hW_le
      rwa [hFT_eq] at hT_sub
    let e : ↥(irreducibleComponents X) ≃ ↥(minimalPrimes R) :=
      { toFun := fun Z => ⟨PrimeSpectrum.vanishingIdeal (f ⁻¹' Z.1), (hFwd Z.1 Z.2).1⟩
        invFun := fun 𝔭 => ⟨closure (f '' PrimeSpectrum.zeroLocus (𝔭.1 : Set R)), (hBwd 𝔭.1 𝔭.2).1⟩
        left_inv := fun ⟨Z, hZ⟩ => Subtype.ext (by
          dsimp
          rw [(hFwd Z hZ).2.1, (hFwd Z hZ).2.2])
        right_inv := fun ⟨𝔭, h𝔭⟩ => Subtype.ext (by
          dsimp
          rw [(hBwd 𝔭 h𝔭).2, PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
            h𝔭.1.1.isRadical.radical]) }
    have hCard : (minimalPrimes R).ncard = (irreducibleComponents X).ncard :=
      Set.ncard_congr
        (fun 𝔭 h𝔭 => (e.symm ⟨𝔭, h𝔭⟩).1)
        (fun 𝔭 h𝔭 => (e.symm ⟨𝔭, h𝔭⟩).2)
        (fun 𝔭₁ 𝔭₂ h₁ h₂ hEq => congrArg Subtype.val (e.symm.injective (Subtype.ext hEq)))
        (fun Z hZ => ⟨(e ⟨Z, hZ⟩).1, (e ⟨Z, hZ⟩).2,
          congrArg Subtype.val (e.symm_apply_apply ⟨Z, hZ⟩)⟩)
    refine ⟨e, hCard, ?_⟩
    intro Z hZ
    dsimp [e]
    refine ⟨(hFwd Z hZ).2.1, ?_⟩
    rw [(hFwd Z hZ).2.1]
    exact (hFwd Z hZ).2.2

  
  have h_s3 : ∀ (B₀ C_aff B_01 : Type u) [CommRing B₀] [CommRing C_aff] [CommRing B_01]
      [Algebra k₀ B₀] [Algebra k₀ C_aff] [Algebra k₀ B_01]
      (res₀ : B₀ →ₐ[k₀] B_01) (res₁ : C_aff →ₐ[k₀] B_01)
      (y₁ : B₀) (x₀ : C_aff),
      res₀ y₁ * res₁ x₀ = 1 →
      @IsLocalization.Away B₀ _ y₁ B_01 _ res₀.toRingHom.toAlgebra →
      @IsLocalization.Away C_aff _ x₀ B_01 _ res₁.toRingHom.toAlgebra →
      ∀ (𝔮 : Ideal B₀) (h𝔮_min : 𝔮 ∈ minimalPrimes B₀)
        (𝔭 : Ideal C_aff) [𝔭.IsPrime]
        (𝔯 : Ideal B_01) [𝔯.IsPrime],
        PrimeSpectrum.comap res₀.toRingHom ⁻¹' PrimeSpectrum.zeroLocus (𝔮 : Set B₀) =
          PrimeSpectrum.zeroLocus (𝔯 : Set B_01) →
        PrimeSpectrum.comap res₁.toRingHom ⁻¹' PrimeSpectrum.zeroLocus (𝔭 : Set C_aff) =
          PrimeSpectrum.zeroLocus (𝔯 : Set B_01) →
        letI : 𝔮.IsPrime := h𝔮_min.1.1
        ∃ (ι_B : (B₀ ⧸ 𝔮) →ₐ[k₀] FractionRing (C_aff ⧸ 𝔭))
          (ι_01 : (B_01 ⧸ 𝔯) →ₐ[k₀] FractionRing (C_aff ⧸ 𝔭)),
          y₁ ∉ 𝔮 ∧
          Function.Injective ι_B ∧
          Function.Injective ι_01 ∧
          @IsFractionRing (B₀ ⧸ 𝔮) _ (FractionRing (C_aff ⧸ 𝔭)) _ ι_B.toRingHom.toAlgebra ∧
          (∀ b : B₀, ι_01 (Ideal.Quotient.mk 𝔯 (res₀ b)) = ι_B (Ideal.Quotient.mk 𝔮 b)) ∧
          (∀ c : C_aff,
            ι_01 (Ideal.Quotient.mk 𝔯 (res₁ c)) =
              algebraMap (C_aff ⧸ 𝔭) (FractionRing (C_aff ⧸ 𝔭)) (Ideal.Quotient.mk 𝔭 c)) ∧
          (∀ (D : ℕ) (f : C_aff) (b : B₀),
            res₀ b = (res₀ y₁) ^ D * res₁ f →
            (ι_B (Ideal.Quotient.mk 𝔮 y₁)) ^ D *
              algebraMap (C_aff ⧸ 𝔭) (FractionRing (C_aff ⧸ 𝔭)) (Ideal.Quotient.mk 𝔭 f) =
              ι_B (Ideal.Quotient.mk 𝔮 b)) ∧
          (∀ c : C_aff ⧸ 𝔭,
            ∃ (k : ℕ) (b : B₀ ⧸ 𝔮),
              (ι_B (Ideal.Quotient.mk 𝔮 y₁)) ^ k *
                algebraMap (C_aff ⧸ 𝔭) (FractionRing (C_aff ⧸ 𝔭)) c = ι_B b) ∧
          ((∀ (c : C_aff ⧸ 𝔭) (b₀ : B₀ ⧸ 𝔮),
              algebraMap (C_aff ⧸ 𝔭) (FractionRing (C_aff ⧸ 𝔭)) c = ι_B b₀ →
              ∃ a : k₀, c = algebraMap k₀ (C_aff ⧸ 𝔭) a) →
            (∃ (q₀ : Ideal B₀) (_ : q₀.IsPrime) (g : B₀) (_ : IsDomain (Localization.Away g)),
              𝔮 ≤ q₀ ∧ g ∉ q₀ ∧
              ∀ (𝔪 : Ideal (Localization.Away g)) [𝔪.IsMaximal], 𝔪 ≠ ⊥) →
            ¬ IsUnit (Ideal.Quotient.mk 𝔮 y₁)) := by
    intro B₀ C_aff B_01 _ _ _ _ _ _ res₀ res₁ y₁ x₀ hyx hLoc0 hLoc1 𝔮 h𝔮_min 𝔭 h𝔭 𝔯 h𝔯 hZero0 hZero1
    have h𝔮 : 𝔮.IsPrime := h𝔮_min.1.1
    have hComapEq : ∀ (A : Type u) [CommRing A] (α : A →+* B_01) (t : A),
        IsUnit (α t) →
        @IsLocalization.Away A _ t B_01 _ α.toAlgebra →
        ∀ (J : Ideal A) (_ : J.IsPrime),
          PrimeSpectrum.comap α ⁻¹' PrimeSpectrum.zeroLocus (J : Set A) =
            PrimeSpectrum.zeroLocus (𝔯 : Set B_01) →
          Ideal.comap α 𝔯 = J ∧ t ∉ J := by
      intro A _ α t ht_unit hLoc J hJ hZero
      have hJ_le : J ≤ Ideal.comap α 𝔯 := by
        have hmem : (⟨𝔯, h𝔯⟩ : PrimeSpectrum B_01) ∈ PrimeSpectrum.zeroLocus (𝔯 : Set B_01) :=
          Set.Subset.rfl
        rw [← hZero] at hmem
        exact hmem
      have ht_not : t ∉ J := by
        intro ht
        exact h𝔯.ne_top (Ideal.eq_top_of_isUnit_mem 𝔯 (hJ_le ht) ht_unit)
      refine ⟨le_antisymm ?_ hJ_le, ht_not⟩
      intro a ha
      have hat_mem : a * t ∈ PrimeSpectrum.vanishingIdeal (PrimeSpectrum.zeroLocus (J : Set A)) := by
        rw [PrimeSpectrum.mem_vanishingIdeal]
        intro q hq
        by_cases htq : t ∈ q.asIdeal
        · exact Ideal.mul_mem_left q.asIdeal a htq
        · let _ : Algebra A B_01 := α.toAlgebra
          have _ : IsLocalization.Away t B_01 := hLoc
          have hDisj : Disjoint (Submonoid.powers t : Set A) (q.asIdeal : Set A) := by
            rw [Set.disjoint_left]
            rintro _ ⟨m, rfl⟩ htm
            exact htq (q.isPrime.mem_of_pow_mem m htm)
          let Q : Ideal B_01 := Ideal.map (algebraMap A B_01) q.asIdeal
          have hQ_prime : Q.IsPrime :=
            IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers t) B_01 q.asIdeal q.isPrime hDisj
          have hQ_under : Ideal.comap α Q = q.asIdeal :=
            IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers t) B_01 q.isPrime hDisj
          have hQ_mem : (⟨Q, hQ_prime⟩ : PrimeSpectrum B_01) ∈
              PrimeSpectrum.comap α ⁻¹' PrimeSpectrum.zeroLocus (J : Set A) := by
            change (J : Set A) ⊆ (Ideal.comap α Q : Set A)
            rw [hQ_under]
            exact hq
          rw [hZero] at hQ_mem
          have h_r_le_Q : (𝔯 : Set B_01) ⊆ (Q : Set B_01) := hQ_mem
          have haQ : a ∈ Ideal.comap α Q := h_r_le_Q ha
          rw [hQ_under] at haQ
          exact Ideal.mul_mem_right t q.asIdeal haQ
      rw [PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical, hJ.isRadical.radical] at hat_mem
      exact (hJ.mem_or_mem hat_mem).resolve_right ht_not
    have hy_unit : IsUnit (res₀ y₁) := IsUnit.of_mul_eq_one (res₁ x₀) hyx
    have hx_unit : IsUnit (res₁ x₀) :=
      IsUnit.of_mul_eq_one (res₀ y₁) ((mul_comm (res₁ x₀) (res₀ y₁)).trans hyx)
    obtain ⟨hComap0, hy₁_not_q⟩ := hComapEq B₀ res₀.toRingHom y₁ hy_unit hLoc0 𝔮 h𝔮 hZero0
    obtain ⟨hComap1, hx₀_not_p⟩ := hComapEq C_aff res₁.toRingHom x₀ hx_unit hLoc1 𝔭 h𝔭 hZero1
    let K_p := FractionRing (C_aff ⧸ 𝔭)
    let g_C : C_aff →ₐ[k₀] K_p :=
      (IsScalarTower.toAlgHom k₀ (C_aff ⧸ 𝔭) K_p).comp (Ideal.Quotient.mkₐ k₀ 𝔭)
    have hg_x0_ne : g_C x₀ ≠ 0 := by
      change algebraMap (C_aff ⧸ 𝔭) K_p (Ideal.Quotient.mk 𝔭 x₀) ≠ 0
      intro h0
      have hmk0 : Ideal.Quotient.mk 𝔭 x₀ = 0 :=
        IsFractionRing.injective (C_aff ⧸ 𝔭) K_p (h0.trans (map_zero _).symm)
      exact hx₀_not_p (Ideal.Quotient.eq_zero_iff_mem.mp hmk0)
    have hg_unit : IsUnit (g_C.toRingHom x₀) := IsUnit.mk0 _ hg_x0_ne
    let ψ_ring : B_01 →+* K_p :=
      @IsLocalization.Away.lift C_aff _ B_01 _ res₁.toRingHom.toAlgebra K_p _ x₀ hLoc1 g_C.toRingHom hg_unit
    have hψ_res1 : ∀ c : C_aff, ψ_ring (res₁ c) = g_C c :=
      fun c => @IsLocalization.Away.lift_eq C_aff _ B_01 _ res₁.toRingHom.toAlgebra K_p _ x₀ hLoc1
        g_C.toRingHom hg_unit c
    let ψ_alg : B_01 →ₐ[k₀] K_p :=
      { ψ_ring with
        commutes' := fun a => by
          rw [← res₁.commutes a]
          exact (hψ_res1 (algebraMap k₀ C_aff a)).trans (g_C.commutes a) }
    have hψ_ker : ∀ z : B_01, ψ_alg z = 0 ↔ z ∈ 𝔯 := by
      intro z
      obtain ⟨n, c, hzc⟩ :=
        @IsLocalization.Away.surj C_aff _ B_01 _ res₁.toRingHom.toAlgebra x₀ hLoc1 z
      have hzc_eq : z * (res₁ x₀) ^ n = res₁ c := hzc
      have hx_pow_not_r : (res₁ x₀) ^ n ∉ 𝔯 :=
        fun hmem => h𝔯.ne_top (Ideal.eq_top_of_isUnit_mem 𝔯 hmem (hx_unit.pow n))
      have hg_pow_ne : (g_C x₀) ^ n ≠ 0 := pow_ne_zero n hg_x0_ne
      have hψ_mul : ψ_alg z * (g_C x₀) ^ n = g_C c := by
        calc
          ψ_alg z * (g_C x₀) ^ n = ψ_alg z * (ψ_alg (res₁ x₀)) ^ n := by rw [← hψ_res1 x₀]; rfl
          _ = ψ_alg (z * (res₁ x₀) ^ n) := by rw [← map_pow, ← map_mul]
