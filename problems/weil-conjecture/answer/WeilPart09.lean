                have hne2 : d00 ≠ d01 := by intro h; have := congrArg (· 1) h; simp [d01, d00] at this
                subst hdeq
                simp [Φ₃_P, MvPolynomial.lcoeff_apply, MvPolynomial.coeff_monomial, hne1, hne2]
              · by_cases hd1_1 : d 1 = 1
                · have hdeq : d = d01 := by ext i; fin_cases i <;> simp [hd0, hd1_1, d01]
                  have hne0 : d01 ≠ d00 := by intro h; have := congrArg (· 1) h; simp [d01, d00] at this
                  have hne1 : d01 ≠ d10 := by intro h; have := congrArg (· 1) h; simp [d01, d10] at this
                  subst hdeq
                  simp [Φ₃_P, MvPolynomial.lcoeff_apply, MvPolynomial.coeff_monomial, hne0, hne1]
                · have hd1_ge2 : 2 ≤ d 1 := by omega
                  have hne0 : d ≠ d00 := by intro h; apply hd1; rw [h]; simp [d00]
                  have hne1 : d ≠ d10 := by intro h; apply hd1; rw [h]; simp [d10]
                  have hne2 : d ≠ d01 := by intro h; apply hd1_1; rw [h]; simp [d01]
                  have hΦ0 : Φ₃_P (MvPolynomial.monomial d a) = 0 := by
