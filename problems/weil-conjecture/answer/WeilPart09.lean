    let ψ_loc : L_N →+* L_4 := Localization.localRingHom q_N q₄ Psi4_bar rfl
    have hψ_loc_surj : Function.Surjective ψ_loc := by
      intro w
      obtain ⟨⟨x, s⟩, hx_eq⟩ := IsLocalization.surj q₄.primeCompl w
      dsimp only at hx_eq
      obtain ⟨x₀', rfl⟩ := hPsi4_bar_surj x
      obtain ⟨s₀', hs₀'⟩ := hPsi4_bar_surj s.1
