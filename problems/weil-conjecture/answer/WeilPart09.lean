        CategoryTheory.Limits.pullback.snd (𝒰_star.f a) (𝒰_star.f b)
      change fst_ab ≫ ψ_star a = snd_ab ≫ ψ_star b
      have hPb_cond : fst_ab ≫ ι_D (W₀ a) u_star = snd_ab ≫ ι_D (W₀ b) u_star :=
        CategoryTheory.Limits.pullback.condition (f := 𝒰_star.f a) (g := 𝒰_star.f b)
      have _ : AlgebraicGeometry.IsOpenImmersion (ι_D (W₀ a ⊓ W₀ b) u_star) :=
        show AlgebraicGeometry.IsOpenImmersion ((D.map u_star.hom) ⁻¹ᵁ (W₀ a ⊓ W₀ b)).ι from inferInstance
      have hRange_ab : Set.range (fst_ab ≫ ι_D (W₀ a) u_star).base ⊆
