    have hJ_top : J = ⊤ := by
      by_contra hJ_ne
      obtain ⟨p, hp_max, hJp⟩ := Ideal.exists_le_maximal J hJ_ne
      let z₀ : PrimeSpectrum R_U := ⟨p, hp_max.isPrime⟩
      let y : ↥P₁ := hU.fromSpec.base z₀
      have hy_U : y ∈ U := by
        show y ∈ (U : Set ↥P₁)
        rw [← hU.range_fromSpec]
        exact ⟨z₀, rfl⟩
      have ha_ex : ∃ a : Fin (1 + 1), y ∈ V_chart a := by
        rcases hMemChart y with hy0 | hy1
        · exact ⟨0, hy0⟩
        · exact ⟨1, hy1⟩
      obtain ⟨a, hy_Va⟩ := ha_ex
      obtain ⟨g, hg_le, hy_Wg⟩ :=
        (hAff_P1 a).exists_basicOpen_le (⟨y, hy_U⟩ : ↥U) hy_Va
      let W_g : P₁.Opens := P₁.basicOpen g
      have hWg : AlgebraicGeometry.IsAffineOpen W_g := (hAff_P1 a).basicOpen g
      have : IsDomain (Γ_chart a) := hDom_chart a
      have : IsIntegrallyClosed (Γ_chart a) := IsIntegrallyClosed.of_equiv (e_P1 a)
      have hg_ne : g ≠ 0 := by
        intro hg0
        have hy_va_range : y ∈ Set.range (hAff_P1 a).fromSpec.base := by
          rw [(hAff_P1 a).range_fromSpec]
          exact hy_Va
        obtain ⟨q_a, hqa⟩ := hy_va_range
        have hq_mem : q_a ∈ (hAff_P1 a).fromSpec ⁻¹ᵁ P₁.basicOpen g := by
          show (hAff_P1 a).fromSpec.base q_a ∈ P₁.basicOpen g
          rwa [hqa]
        rw [(hAff_P1 a).fromSpec_preimage_basicOpen g, hg0] at hq_mem
        exact hq_mem (Ideal.zero_mem _)
      have hSub_g : Submonoid.powers g ≤ nonZeroDivisors (Γ_chart a) := by
        rintro _ ⟨n, rfl⟩
        exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n hg_ne)
      have : IsLocalization.Away g ↑(P₁.presheaf.obj (Opposite.op W_g)) :=
        (hAff_P1 a).isLocalization_basicOpen g
      have : Nonempty ↥(W_g : AlgebraicGeometry.Scheme.{u}) := ⟨⟨y, hy_Wg⟩⟩
      have : IsDomain ↑(P₁.presheaf.obj (Opposite.op W_g)) :=
        @AlgebraicGeometry.IsIntegral.component_integral P₁ _ W_g _
      have hIC_Wg : IsIntegrallyClosed ↑(P₁.presheaf.obj (Opposite.op W_g)) :=
        isIntegrallyClosed_of_isLocalization (M := Submonoid.powers g)
          (S := ↑(P₁.presheaf.obj (Opposite.op W_g))) hSub_g
      obtain ⟨φ_Wg, hFrac_Wg, hφ_Wg⟩ := hFunc_P1 W_g hWg ⟨⟨y, hy_Wg⟩⟩
      let res_Ug : R_U →+* ↑(P₁.presheaf.obj (Opposite.op W_g)) :=
        (P₁.presheaf.map (CategoryTheory.homOfLE hg_le).op).hom
      have hcomp_Ug_hom := hφ_res_P1_comp hWg hU hg_le φ_Wg φ_U hφ_Wg hφ_U
      obtain ⟨P_int, hP_monic, hP_eval⟩ := hx
      have hx_Wg : RingHom.IsIntegralElem φ_Wg.hom x := by
        refine ⟨P_int.map res_Ug, hP_monic.map res_Ug, ?_⟩
        rw [Polynomial.eval₂_map]
        change Polynomial.eval₂ (φ_Wg.hom.comp res_Ug) x P_int = 0
        rw [hcomp_Ug_hom]
        exact hP_eval
      have hw_ex : ∃ w_g : ↑(P₁.presheaf.obj (Opposite.op W_g)), φ_Wg.hom w_g = x := by
        letI : Algebra ↑(P₁.presheaf.obj (Opposite.op W_g)) F := φ_Wg.hom.toAlgebra
        have : IsFractionRing ↑(P₁.presheaf.obj (Opposite.op W_g)) F := hFrac_Wg
        exact (isIntegrallyClosed_iff F).mp hIC_Wg hx_Wg
      obtain ⟨w_g, hw_g⟩ := hw_ex
      obtain ⟨f, hf_le_g, hy_Wf⟩ :=
        hU.exists_basicOpen_le (⟨y, hy_Wg⟩ : ↥W_g) hy_U
      have hf_not_p : f ∉ p := by
        have hz_pre : z₀ ∈ hU.fromSpec ⁻¹ᵁ P₁.basicOpen f := hy_Wf
        rw [hU.fromSpec_preimage_basicOpen f] at hz_pre
        exact hz_pre
      let W_f : P₁.Opens := P₁.basicOpen f
      have hWf : AlgebraicGeometry.IsAffineOpen W_f := hU.basicOpen f
      have hle_fU : W_f ≤ U := P₁.basicOpen_le f
      obtain ⟨φ_Wf', _hFrac_Wf', hφ_Wf'⟩ := hFunc_P1 W_f hWf ⟨⟨y, hy_Wf⟩⟩
      have hcomp_gf := hφ_res_P1 hWf hWg hf_le_g φ_Wf' φ_Wg hφ_Wf' hφ_Wg
      have hcomp_Uf := hφ_res_P1 hWf hU hle_fU φ_Wf' φ_U hφ_Wf' hφ_U
      have : IsLocalization.Away f ↑(P₁.presheaf.obj (Opposite.op W_f)) :=
        hU.isLocalization_basicOpen f
      let res_gf : ↑(P₁.presheaf.obj (Opposite.op W_g)) →+*
          ↑(P₁.presheaf.obj (Opposite.op W_f)) :=
        (P₁.presheaf.map (CategoryTheory.homOfLE hf_le_g).op).hom
      let res_Uf : R_U →+* ↑(P₁.presheaf.obj (Opposite.op W_f)) :=
        (P₁.presheaf.map (CategoryTheory.homOfLE hle_fU).op).hom
      obtain ⟨k_exp, r_f, hrf⟩ := IsLocalization.Away.surj f (res_gf w_g)
      have hrf_eq : res_gf w_g * res_Uf (f ^ k_exp) = res_Uf r_f := by
        rw [map_pow]
        exact hrf
      have hfk_J : f ^ k_exp ∈ J := by
        refine ⟨r_f, ?_⟩
        have h := congrArg φ_Wf'.hom hrf_eq
        change φ_Wf'.hom (res_gf w_g * res_Uf (f ^ k_exp)) = φ_Wf'.hom (res_Uf r_f) at h
        rw [map_mul, hcomp_gf w_g, hcomp_Uf (f ^ k_exp), hcomp_Uf r_f,
          hw_g, mul_comm] at h
        exact h
      exact hf_not_p (hp_max.isPrime.mem_of_pow_mem k_exp (hJp hfk_J))
    have h1_J : (1 : R_U) ∈ J := by
      rw [hJ_top]
      exact Submodule.mem_top
    obtain ⟨r, hr⟩ := h1_J
    refine ⟨r, ?_⟩
    change φ_U.hom r = x
    rw [map_one, one_mul] at hr
    exact hr.symm

  
  let W : Fin 3 → Y.Opens := ![U₁, Y.basicOpen s₁, Y.basicOpen s_reg]
  have hAffW : ∀ i : Fin 3, AlgebraicGeometry.IsAffineOpen (W i) := by
    intro i
    rcases hFin3 i with rfl | rfl | rfl
    · exact hU1
    · exact hU0.basicOpen s₁
    · exact hU0.basicOpen s_reg
  have hNe_basic0 : ∀ s : R₀, s ≠ 0 → Nonempty ↥(Y.basicOpen s) := by
    intro s hs_ne
