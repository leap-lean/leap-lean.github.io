        · intro x hx y hy
          rw [← huv_bar_span] at hx hy
          obtain ⟨a₁, b₁, rfl⟩ := Ideal.mem_span_pair.mp hx
          obtain ⟨a₂, b₂, rfl⟩ := Ideal.mem_span_pair.mp hy
