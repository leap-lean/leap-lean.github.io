        Ideal.map g_tilde.toRingHom (𝔪_S ^ k)
          = (Ideal.map g_tilde.toRingHom 𝔪_S) ^ k := Ideal.map_pow _ _ _
        _ ≤ I_k ^ k := pow_le_pow_left' hg_tilde_m k
        _ = ⊥ := hIk_pow
