      · change θ₀₁ (m₀ (Φ₀ Polynomial.X)) = z
        rw [hΦ₀_X]
        change θ_loc (m₀ (HomogeneousLocalization.Away.mk 𝒜 (hX_mem 0) 1
          (MvPolynomial.X 1) (hX_mem 1))).val = z
        rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
          Localization.mk_eq_mk']
        dsimp only [θ_loc]
        rw [IsLocalization.lift_mk'_spec]
        change ev (MvPolynomial.X 1 * MvPolynomial.X 1 ^ 1) = ev (P ^ 1) * z
        simp [hev_P, hev_X1]
    have hθ_m₀ : θ₀₁.comp m₀ = α₀.comp Φ₀.symm.toRingHom := by
      apply RingHom.ext
      intro u
      have hu := RingHom.congr_fun hθ_m₀_Φ₀ (Φ₀.symm u)
      simpa using hu
    have hθ_m₁_Φ₁ : (θ₀₁.comp m₁).comp Φ₁.toRingHom = ρ₁ := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change θ₀₁ (m₁ (Φ₁ (Polynomial.C c))) = ρ₁ (Polynomial.C c)
        rw [hΦ₁_C c, HomogeneousLocalization.awayMap_fromZeroRingHom, hθ_C c, hρC c]
      · change θ₀₁ (m₁ (Φ₁ Polynomial.X)) = ρ₁ Polynomial.X
        rw [hΦ₁_X]
        have hρXi : ρ₁ Polynomial.X = z⁻¹ := Polynomial.eval₂_X (α₀.comp Polynomial.C) z⁻¹
        rw [hρXi]
        change θ_loc (m₁ (HomogeneousLocalization.Away.mk 𝒜 (hX_mem 1) 1
          (MvPolynomial.X 0) (hX_mem 0))).val = z⁻¹
        rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
          Localization.mk_eq_mk']
        dsimp only [θ_loc]
        rw [IsLocalization.lift_mk'_spec]
        change ev (MvPolynomial.X 0 * MvPolynomial.X 0 ^ 1) = ev (P ^ 1) * z⁻¹
        simp [hev_P, hev_X0, mul_inv_cancel₀ hz]
    have hθ_m₁ : θ₀₁.comp m₁ = ρ₁.comp Φ₁.symm.toRingHom := by
      apply RingHom.ext
      intro u
      have hu := RingHom.congr_fun hθ_m₁_Φ₁ (Φ₁.symm u)
      simpa using hu
    have hSpec₀₁ :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom m₀) ≫ w₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom m₁) ≫ w₁ :=
      (AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX_mem 0) zero_lt_one (hX_mem 1) rfl).trans
        (AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX_mem 1) zero_lt_one (hX_mem 0)
          (mul_comm (MvPolynomial.X 0) (MvPolynomial.X 1))).symm
    have hcomp₀ : CommRingCat.ofHom Φ₀.symm.toRingHom ≫ CommRingCat.ofHom α₀ =
        CommRingCat.ofHom m₀ ≫ CommRingCat.ofHom θ₀₁ := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hθ_m₀]
    have hcomp₁ : CommRingCat.ofHom Φ₁.symm.toRingHom ≫ CommRingCat.ofHom ρ₁ =
        CommRingCat.ofHom m₁ ≫ CommRingCat.ofHom θ₀₁ := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hθ_m₁]
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ₀.symm.toRingHom) ≫ w₀) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ₁.symm.toRingHom) ≫ w₁)
    rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hcomp₀,
      AlgebraicGeometry.Spec.map_comp, Category.assoc, hSpec₀₁,
      ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← hcomp₁,
      AlgebraicGeometry.Spec.map_comp, Category.assoc]
  
  have hChartDense : ∀ (f : Polynomial Ω →+* K₀)
      (ι : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω)) ⟶
        (weilProjectiveSpaceOver Ω 1).left),
      RingHom.ker f = ⊥ →
      Set.range ι.base ⊆
        closure (Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f) ≫ ι).base) := by
    intro f ι hker
    have hcl : closure (Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)).base) =
        Set.univ := by
      change closure (Set.range (PrimeSpectrum.comap f)) =
        (Set.univ : Set (PrimeSpectrum (Polynomial Ω)))
      rw [PrimeSpectrum.closure_range_comap, hker]
      exact PrimeSpectrum.zeroLocus_bot
    calc
      Set.range ι.base
        = ι.base '' Set.univ := Set.image_univ.symm
      _ = ι.base '' closure (Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)).base) := by
          rw [hcl]
      _ ⊆ closure (ι.base '' Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)).base) :=
          image_closure_subset_closure_image ι.base.hom.continuous
      _ = closure (Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f) ≫ ι).base) := by
          rw [← Set.range_comp]
          rfl
  have hDom₀ : AlgebraicGeometry.IsDominant
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀) ≫ ι₀) := by
    let η := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀) ≫ ι₀
    have hα₀_ker : RingHom.ker α₀ = ⊥ :=
      (RingHom.ker_eq_bot_iff_eq_zero α₀).mpr (fun p hp => hα₀_inj (hp.trans (map_zero α₀).symm))
    have hsub₀ : Set.range ι₀.base ⊆ closure (Set.range η.base) :=
      hChartDense α₀ ι₀ hα₀_ker
    have hsub₁ : Set.range ι₁.base ⊆ closure (Set.range η.base) := by
      have h1 := hChartDense ρ₁ ι₁ hρ₁_ker
      rwa [← hGlue] at h1
    have huniv : (Set.univ : Set ↥(weilProjectiveSpaceOver Ω 1).left) ⊆
        closure (Set.range η.base) := by
      rw [← hCov]
      exact Set.union_subset hsub₀ hsub₁
    have hcl_eq : closure (Set.range η.base) = Set.univ :=
      Set.Subset.antisymm (Set.subset_univ _) huniv
    exact AlgebraicGeometry.IsDominant.mk (denseRange_iff_closure_range.mpr hcl_eq)
  exact ⟨ι₀, ι₁, ρ₁, hOpen₀, hOpen₁, hHom₀, hHom₁, hCov, hRedP₁, hSepP₁, hDom₀, hρC, hρX, hGlue⟩

theorem weil_smooth_proper_curve_twoChart_birational_iso_iff (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (E P₁ : AlgebraicGeometry.Scheme.{u})
    (p_E : E ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (p_P₁ : P₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (hIntE : AlgebraicGeometry.IsIntegral E)
    (hPropE : AlgebraicGeometry.IsProper p_E)
    (hSmE : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_E)
    (F : Type u) [Field F] [Algebra Ω F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ E)
    (hηF_comm : η_F ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω F)))
    (hFuncF : IsSchemeFunctionField E F η_F)
    (ι₀ ι₁ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω)) ⟶ P₁)
    (ρ₁ : Polynomial Ω →+* FractionRing (Polynomial Ω))
    (hOpen₀ : AlgebraicGeometry.IsOpenImmersion ι₀)
    (hOpen₁ : AlgebraicGeometry.IsOpenImmersion ι₁)
    (hHom₀ : ι₀ ≫ p_P₁ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (hHom₁ : ι₁ ≫ p_P₁ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (hCov : Set.range ι₀.base ∪ Set.range ι₁.base = Set.univ)
    (hRedP₁ : AlgebraicGeometry.IsReduced P₁)
    (hSepP₁ : P₁.IsSeparated)
    (hDom₀ : AlgebraicGeometry.IsDominant
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)))) ≫ ι₀))
    (hρC : ∀ c : Ω, ρ₁ (Polynomial.C c) =
      algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) (Polynomial.C c))
    (hρX : ρ₁ Polynomial.X *
      algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) Polynomial.X = 1)
    (hGlue : AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)))) ≫ ι₀ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁) ≫ ι₁) :
    (∃ isoP1 : E ≅ P₁, p_E = isoP1.hom ≫ p_P₁) ↔
    ∃ (e_F : F ≃+* FractionRing (Polynomial Ω)),
      ∀ c : Ω, e_F (algebraMap Ω F c) =
        algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) (Polynomial.C c) :=
by
  have h_s1 : ∀ (j₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω)) ⟶ E),
      AlgebraicGeometry.IsOpenImmersion j₀ →
      j₀ ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
      ∃ (e_F : F ≃+* FractionRing (Polynomial Ω)),
        ∀ c : Ω, e_F (algebraMap Ω F c) =
          algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) (Polynomial.C c) := by
    intro j₀ hOpen hHom
    have : AlgebraicGeometry.IsOpenImmersion j₀ := hOpen
    let V₀ : E.Opens := j₀.opensRange
    have hAffV₀ : AlgebraicGeometry.IsAffineOpen V₀ := AlgebraicGeometry.isAffineOpen_opensRange j₀
    let q₀ : PrimeSpectrum (Polynomial Ω) := ⟨⊥, inferInstance⟩
    have hNeV₀ : Nonempty ↥V₀ := ⟨⟨j₀.base q₀, ⟨q₀, rfl⟩⟩⟩
    obtain ⟨φ₀, hFrac₀, hSpec₀⟩ := hFuncF V₀ hAffV₀ hNeV₀
    let isoSpec : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω)) ≅
        AlgebraicGeometry.Spec (E.presheaf.obj (Opposite.op V₀)) :=
      j₀.isoOpensRange ≪≫ hAffV₀.isoSpec
    have hiso_j₀ : isoSpec.inv ≫ j₀ = hAffV₀.fromSpec := by
      dsimp [isoSpec]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.isoOpensRange_inv_comp,
        hAffV₀.isoSpec_inv_ι]
    let α_hom : CommRingCat.of (Polynomial Ω) ⟶ E.presheaf.obj (Opposite.op V₀) :=
      AlgebraicGeometry.Spec.preimage isoSpec.inv
    let β_hom : E.presheaf.obj (Opposite.op V₀) ⟶ CommRingCat.of (Polynomial Ω) :=
      AlgebraicGeometry.Spec.preimage isoSpec.hom
    have hαβ : α_hom ≫ β_hom = 𝟙 _ := by
      dsimp [α_hom, β_hom]
      rw [← AlgebraicGeometry.Spec.preimage_comp, isoSpec.hom_inv_id,
        AlgebraicGeometry.Spec.preimage_id]
    have hβα : β_hom ≫ α_hom = 𝟙 _ := by
      dsimp [α_hom, β_hom]
      rw [← AlgebraicGeometry.Spec.preimage_comp, isoSpec.inv_hom_id,
        AlgebraicGeometry.Spec.preimage_id]
    let θ : Polynomial Ω ≃+* ↑(E.presheaf.obj (Opposite.op V₀)) :=
      { toFun := α_hom.hom
        invFun := β_hom.hom
        left_inv := fun x => congrArg (fun f => f.hom x) hαβ
        right_inv := fun y => congrArg (fun f => f.hom y) hβα
        map_mul' := α_hom.hom.map_mul'
        map_add' := α_hom.hom.map_add' }
    let ψ : Polynomial Ω →+* F := φ₀.hom.comp θ.toRingHom
    have _ : IsDomain ↑(E.presheaf.obj (Opposite.op V₀)) :=
      Function.Injective.isDomain θ.symm.toRingHom θ.symm.injective
    have hInjφ₀ : Function.Injective φ₀.hom :=
      @IsFractionRing.injective ↑(E.presheaf.obj (Opposite.op V₀)) _ F _ φ₀.hom.toAlgebra hFrac₀
    have hInjψ : Function.Injective ψ := hInjφ₀.comp θ.injective
    let _ : Algebra (Polynomial Ω) F := ψ.toAlgebra
    have _ : IsFractionRing (Polynomial Ω) F :=
      { map_units := fun ⟨y, hy⟩ =>
          Ne.isUnit (fun h0 => nonZeroDivisors.ne_zero hy (hInjψ (h0.trans (map_zero ψ).symm)))
        surj := fun z => by
          obtain ⟨⟨a, b⟩, hab⟩ :=
            @IsLocalization.surj _ _ (nonZeroDivisors ↑(E.presheaf.obj (Opposite.op V₀))) F _
              φ₀.hom.toAlgebra hFrac₀ z
          have hb_ne : (b : ↑(E.presheaf.obj (Opposite.op V₀))) ≠ 0 := nonZeroDivisors.ne_zero b.2
          have hb'_ne : θ.symm b.1 ≠ 0 := fun h0 =>
            hb_ne (by rw [← θ.apply_symm_apply b.1, h0, map_zero])
          refine ⟨⟨θ.symm a, ⟨θ.symm b.1, mem_nonZeroDivisors_of_ne_zero hb'_ne⟩⟩, ?_⟩
          change z * ψ (θ.symm b.1) = ψ (θ.symm a)
          have ha_eq : ψ (θ.symm a) = φ₀.hom a := by
            change φ₀.hom (θ (θ.symm a)) = φ₀.hom a
            rw [θ.apply_symm_apply]
          have hb_eq : ψ (θ.symm b.1) = φ₀.hom b.1 := by
            change φ₀.hom (θ (θ.symm b.1)) = φ₀.hom b.1
            rw [θ.apply_symm_apply]
          rw [ha_eq, hb_eq]
          exact hab
        exists_of_eq := fun {x₁ x₂} h => ⟨1, by simp [hInjψ h]⟩ }
    have hSpec_ψC :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ.comp Polynomial.C)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω F)) := by
      have h_ofHom :
          CommRingCat.ofHom (ψ.comp Polynomial.C) =
            CommRingCat.ofHom Polynomial.C ≫ α_hom ≫ φ₀ := by
        ext p
        rfl
      rw [h_ofHom, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
      have hα_map : AlgebraicGeometry.Spec.map α_hom = isoSpec.inv :=
        AlgebraicGeometry.Spec.map_preimage isoSpec.inv
      rw [hα_map, ← hHom, ← CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc _ isoSpec.inv j₀, hiso_j₀, hSpec₀, hηF_comm]
    have hψC : ∀ c : Ω, ψ (Polynomial.C c) = algebraMap Ω F c := fun c =>
      congrArg (fun f => f.hom c) (AlgebraicGeometry.Spec.map_injective hSpec_ψC)
    let e_alg : FractionRing (Polynomial Ω) ≃ₐ[Polynomial Ω] F :=
      FractionRing.algEquiv (Polynomial Ω) F
    refine ⟨e_alg.symm.toRingEquiv, fun c => ?_⟩
    have hc : e_alg (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) (Polynomial.C c)) =
        algebraMap Ω F c :=
      (e_alg.commutes (Polynomial.C c)).trans (hψC c)
    rw [← hc]
    exact e_alg.symm_apply_apply _

  have h_s2 : ∀ (z_F : F) (x : E),
      ∃ (W : E.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
        (φ : E.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
        x ∈ W ∧
        @IsFractionRing ↑(E.presheaf.obj (Opposite.op W)) _ F _ φ.hom.toAlgebra ∧
        AlgebraicGeometry.Spec.map φ ≫ hW.fromSpec = η_F ∧
        (z_F ∈ Set.range φ.hom ∨ z_F⁻¹ ∈ Set.range φ.hom) := by
    have hEtaleAnn : ∀ (K₁ B : Type u) [Field K₁] [CommRing B] [Algebra K₁ B] [Algebra.Etale K₁ B]
        (P : Ideal B), (1 : B) ∉ P → ∃ e : B, e ∉ P ∧ ∀ b ∈ P, e * b = 0 := by
      intro K₁ B _ _ _ _ P h1P
      obtain ⟨I, hFinI, Ai, instFieldAi, instAlgAi, Φ, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K₁ B).mp inferInstance
      let _ : Fintype I := Fintype.ofFinite I
      let _ : DecidableEq I := Classical.decEq I
      have hSumOne : ∑ i : I, Φ.symm (Pi.single i 1) = 1 := by
        apply Φ.injective
        rw [map_sum, map_one]
        ext j
        simp [Finset.sum_apply]
      have hEx : ∃ i₀ : I, Φ.symm (Pi.single i₀ 1) ∉ P := by
        by_contra hAll
        apply h1P
        rw [← hSumOne]
        exact P.sum_mem fun i _ => Classical.not_not.mp (fun hi => hAll ⟨i, hi⟩)
      obtain ⟨i₀, hi₀⟩ := hEx
      refine ⟨Φ.symm (Pi.single i₀ 1), hi₀, fun b hb => ?_⟩
      have hbi₀ : Φ b i₀ = 0 := by
        by_contra hne
        apply hi₀
        have h_eq : b * Φ.symm (Pi.single i₀ (Φ b i₀)⁻¹) = Φ.symm (Pi.single i₀ 1) := by
          apply Φ.injective
          rw [map_mul, Φ.apply_symm_apply, Φ.apply_symm_apply]
          ext j
          by_cases hj : j = i₀
          · subst hj
            simp [Pi.single_eq_same, mul_inv_cancel₀ hne]
          · simp [Pi.single_eq_of_ne hj]
        rw [← h_eq]
        exact P.mul_mem_right _ hb
      apply Φ.injective
      rw [map_mul, map_zero, Φ.apply_symm_apply]
      ext j
      by_cases hj : j = i₀
      · subst hj
        simp [Pi.single_eq_same, hbi₀]
      · simp [Pi.single_eq_of_ne hj]

    intro z_F x
    obtain ⟨U, _, W₀, hW₀, hx₀, hle, hStd⟩ :=
      @AlgebraicGeometry.SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension
        1 _ _ p_E hSmE x
    obtain ⟨φ₀, hFrac₀, hη₀⟩ := hFuncF W₀ hW₀ ⟨⟨x, hx₀⟩⟩
    by_cases hz0 : z_F = 0
    · refine ⟨W₀, hW₀, φ₀, hx₀, hFrac₀, hη₀, Or.inl ⟨0, ?_⟩⟩
      rw [hz0, map_zero]
    · let A : Type u := ↑(E.presheaf.obj (Opposite.op W₀))
      let Ω_U : Type u := ↑((AlgebraicGeometry.Spec (CommRingCat.of Ω)).presheaf.obj (Opposite.op U))
      have hU_top : U = ⊤ := by
        ext y
        simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        have hy : y = p_E.base x := Subsingleton.elim y (p_E.base x)
        rw [hy]
        exact hle hx₀
      let isoΩ_U : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).presheaf.obj (Opposite.op U) ≅
          CommRingCat.of Ω :=
        ((AlgebraicGeometry.Spec (CommRingCat.of Ω)).presheaf.mapIso
          (CategoryTheory.eqToIso hU_top.symm).op) ≪≫
          AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)
      let eΩ_U : Ω_U ≃+* Ω :=
        { toFun := isoΩ_U.hom.hom
          invFun := isoΩ_U.inv.hom
          left_inv := fun z => congrArg (fun f => f.hom z) isoΩ_U.hom_inv_id
          right_inv := fun z => congrArg (fun f => f.hom z) isoΩ_U.inv_hom_id
          map_mul' := isoΩ_U.hom.hom.map_mul'
          map_add' := isoΩ_U.hom.hom.map_add' }
      let _ : Field Ω_U := (eΩ_U.toMulEquiv.isField (Field.toIsField Ω)).toField
      have hInj_φ₀ : Function.Injective φ₀.hom :=
        @IsLocalization.injective A _ (nonZeroDivisors A) F _ φ₀.hom.toAlgebra hFrac₀ le_rfl
      have _ : IsDomain A := Function.Injective.isDomain φ₀.hom hInj_φ₀
      obtain ⟨g_mv, _, hg_et⟩ := hStd.exists_etale_mvPolynomial
      let e_mv : Polynomial Ω_U ≃+* MvPolynomial (Fin 1) Ω_U :=
        ((Polynomial.mapAlgEquiv (MvPolynomial.isEmptyAlgEquiv Ω_U (Fin 0)).symm).trans
          (MvPolynomial.finSuccEquiv Ω_U 0).symm).toRingEquiv
      let ψ : Polynomial Ω_U →+* A := g_mv.comp e_mv.toRingHom
      have hψ_et : ψ.Etale := RingHom.Etale.respectsIso.right g_mv e_mv hg_et
      let _ : Algebra (Polynomial Ω_U) A := ψ.toAlgebra
      have _ : Algebra.Etale (Polynomial Ω_U) A := hψ_et.toAlgebra
      have _ : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing (Polynomial Ω_U) A

      have hx_range : x ∈ Set.range hW₀.fromSpec.base := by
        rw [hW₀.range_fromSpec]
        exact hx₀
      obtain ⟨p_x, hp_x⟩ := hx_range
      let p : Ideal A := p_x.asIdeal
      have _ : p.IsPrime := p_x.isPrime
      let R : Type u := Localization.AtPrime p
      have hSub_nzd : p.primeCompl ≤ nonZeroDivisors A := fun s hs =>
        mem_nonZeroDivisors_of_ne_zero (fun h0 => hs (h0 ▸ p.zero_mem))
      have hInj_AR : Function.Injective (algebraMap A R) :=
        IsLocalization.injective R hSub_nzd
      have _ : IsDomain R := IsLocalization.isDomain_of_le_nonZeroDivisors R hSub_nzd
      let q : Ideal (Polynomial Ω_U) := Ideal.comap ψ p
      have hq_prime : q.IsPrime := Ideal.IsPrime.comap ψ

      have hDvdTotal : ∀ u v : R, u ∣ v ∨ v ∣ u := by
        by_cases hq_bot : q = ⊥
        · let P₀ := Polynomial Ω_U
          let E₀ : Type u := FractionRing P₀
          have hUnits₀ : ∀ y : nonZeroDivisors P₀, IsUnit (((algebraMap A R).comp ψ) y.1) := by
            intro ⟨y, hy⟩
            have hy_ne : y ≠ 0 := nonZeroDivisors.ne_zero hy
            have hy_not_q : y ∉ q := by
              rw [hq_bot, Ideal.mem_bot]
              exact hy_ne
            have hψy : ψ y ∈ p.primeCompl := hy_not_q
            exact IsLocalization.map_units R ⟨ψ y, hψy⟩
          let lam₀ : E₀ →+* R :=
            IsLocalization.lift (M := nonZeroDivisors P₀) (g := (algebraMap A R).comp ψ) hUnits₀
          let f₀_alg : E₀ →ₐ[Polynomial Ω_U] R :=
            { lam₀ with
              commutes' := fun d =>
                (IsLocalization.lift_eq (M := nonZeroDivisors P₀) hUnits₀ d).trans
                  (IsScalarTower.algebraMap_apply (Polynomial Ω_U) A R d).symm }
          let g₀_alg : A →ₐ[Polynomial Ω_U] R := IsScalarTower.toAlgHom (Polynomial Ω_U) A R
          let T₀ : Type u := TensorProduct (Polynomial Ω_U) E₀ A
          have _ : Algebra.Etale E₀ T₀ := Algebra.Etale.baseChange (Polynomial Ω_U) A E₀
          let θ₀ : T₀ →+* R :=
            (Algebra.TensorProduct.lift f₀_alg g₀_alg (fun _ _ => Commute.all _ _)).toRingHom
          have hθ₀_eval : ∀ a : A, θ₀ ((1 : E₀) ⊗ₜ[Polynomial Ω_U] a) = algebraMap A R a := by
            intro a
            dsimp [θ₀]
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            rfl
          let P_T₀ : Ideal T₀ := Ideal.comap θ₀ (IsLocalRing.maximalIdeal R)
          have h1_not_PT₀ : (1 : T₀) ∉ P_T₀ := by
            change θ₀ 1 ∉ IsLocalRing.maximalIdeal R
            rw [map_one]
            exact fun h1 => (IsLocalRing.maximalIdeal.isMaximal R).ne_top
              (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
          obtain ⟨e₀, he₀_not, he₀_ann⟩ := hEtaleAnn E₀ T₀ P_T₀ h1_not_PT₀
          have he₀_unit : IsUnit (θ₀ e₀) := IsLocalRing.notMem_maximalIdeal.mp he₀_not
          have hp_bot : p = ⊥ := by
            ext a
            simp only [Ideal.mem_bot]
            constructor
            · intro ha
              have ha_max : algebraMap A R a ∈ IsLocalRing.maximalIdeal R :=
                (IsLocalization.AtPrime.to_map_mem_maximal_iff R p a).mpr ha
              have h1a_mem : (1 : E₀) ⊗ₜ[P₀] a ∈ P_T₀ := by
                change θ₀ ((1 : E₀) ⊗ₜ[P₀] a) ∈ IsLocalRing.maximalIdeal R
                rw [hθ₀_eval a]
                exact ha_max
              have h_zero := congrArg θ₀ (he₀_ann _ h1a_mem)
              rw [map_mul, map_zero, hθ₀_eval a] at h_zero
              obtain ⟨u₀, hu₀⟩ := he₀_unit
              rw [← hu₀] at h_zero
              have haR : algebraMap A R a = 0 := by
                have := congrArg (fun z : R => (↑u₀⁻¹ : R) * z) h_zero
                simpa [← mul_assoc] using this
              exact hInj_AR (haR.trans (map_zero _).symm)
            · rintro rfl
              exact p.zero_mem
          intro u v
          by_cases hu0 : u = 0
          · exact Or.inr (hu0 ▸ dvd_zero v)
          · obtain ⟨⟨a_u, s_u⟩, hau⟩ := IsLocalization.surj p.primeCompl u
            have hau_ne : a_u ≠ 0 := by
              intro h0
              rw [h0, map_zero] at hau
              obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp (IsLocalization.map_units R s_u)
              have := congrArg (· * w) hau
              exact hu0 (by simpa [mul_assoc, hw] using this)
            have hau_compl : a_u ∈ p.primeCompl := by
              change a_u ∉ p
              rw [hp_bot, Ideal.mem_bot]
              exact hau_ne
            have hu_unit : IsUnit u := by
              have hprod_unit : IsUnit (u * algebraMap A R s_u.1) := by
                rw [hau]
                exact IsLocalization.map_units R ⟨a_u, hau_compl⟩
              exact isUnit_of_mul_isUnit_left hprod_unit
            exact Or.inl hu_unit.dvd
        · let P₀ := Polynomial Ω_U
          have hq_max : q.IsMaximal := hq_prime.isMaximal hq_bot
          let E₁ : Type u := P₀ ⧸ q
          let _ : Field E₁ := Ideal.Quotient.field q
          let ϖ : P₀ := Submodule.IsPrincipal.generator q
          have hq_span : Ideal.span {ϖ} = q := Submodule.IsPrincipal.span_singleton_generator q
          have hϖ_mem_q : ϖ ∈ q := by
            rw [← hq_span]
            exact Ideal.subset_span (Set.mem_singleton ϖ)
          have hψϖ_mem_p : ψ ϖ ∈ p := hϖ_mem_q
          let ϖ_R : R := algebraMap A R (ψ ϖ)
          have hϖR_max : ϖ_R ∈ IsLocalRing.maximalIdeal R :=
            (IsLocalization.AtPrime.to_map_mem_maximal_iff R p (ψ ϖ)).mpr hψϖ_mem_p
          let I_ϖ : Ideal R := Ideal.span {ϖ_R}
          have hIϖ_le : I_ϖ ≤ IsLocalRing.maximalIdeal R :=
            Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hϖR_max)
          let Q : Type u := R ⧸ I_ϖ
          let π_Q : R →+* Q := Ideal.Quotient.mk I_ϖ
          have hKer_q : ∀ f ∈ q, (π_Q.comp ((algebraMap A R).comp ψ)) f = 0 := by
            intro f hf
            rw [← hq_span, Ideal.mem_span_singleton] at hf
            obtain ⟨c_f, rfl⟩ := hf
            change π_Q (algebraMap A R (ψ (ϖ * c_f))) = 0
            rw [map_mul, map_mul, map_mul]
            have h0 : π_Q ϖ_R = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
              (Ideal.subset_span (Set.mem_singleton ϖ_R))
            rw [h0, zero_mul]
          let lam₁ : E₁ →+* Q := Ideal.Quotient.lift q (π_Q.comp ((algebraMap A R).comp ψ)) hKer_q
          let f₁_alg : E₁ →ₐ[Polynomial Ω_U] Q :=
            { lam₁ with
              commutes' := fun d => by
                change π_Q (algebraMap A R (ψ d)) = algebraMap (Polynomial Ω_U) Q d
                rw [IsScalarTower.algebraMap_apply (Polynomial Ω_U) R Q d,
                  IsScalarTower.algebraMap_apply (Polynomial Ω_U) A R d]
                rfl }
          let g₁_alg : A →ₐ[Polynomial Ω_U] Q :=
            { π_Q.comp (algebraMap A R) with
              commutes' := fun d => by
                change π_Q (algebraMap A R (ψ d)) = algebraMap (Polynomial Ω_U) Q d
                rw [IsScalarTower.algebraMap_apply (Polynomial Ω_U) R Q d,
                  IsScalarTower.algebraMap_apply (Polynomial Ω_U) A R d]
                rfl }
          let T₁ : Type u := TensorProduct (Polynomial Ω_U) E₁ A
          have _ : Algebra.Etale E₁ T₁ := Algebra.Etale.baseChange (Polynomial Ω_U) A E₁
          let θ₁ : T₁ →+* Q :=
            (Algebra.TensorProduct.lift f₁_alg g₁_alg (fun _ _ => Commute.all _ _)).toRingHom
          have hθ₁_eval : ∀ a : A, θ₁ ((1 : E₁) ⊗ₜ[Polynomial Ω_U] a) = π_Q (algebraMap A R a) := by
            intro a
            dsimp [θ₁]
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            rfl
          let m_bar : Ideal Q := Ideal.map π_Q (IsLocalRing.maximalIdeal R)
          have h1_not_mbar : (1 : Q) ∉ m_bar := by
            intro h1
            have hcomap : (1 : R) ∈ Ideal.comap π_Q m_bar := h1
            rw [Ideal.comap_map_of_surjective' π_Q Ideal.Quotient.mk_surjective,
              Ideal.mk_ker, sup_eq_left.mpr hIϖ_le] at hcomap
            exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
              (Ideal.eq_top_of_isUnit_mem _ hcomap isUnit_one)
          let P_T₁ : Ideal T₁ := Ideal.comap θ₁ m_bar
          have h1_not_PT₁ : (1 : T₁) ∉ P_T₁ := by
            change θ₁ 1 ∉ m_bar
            rw [map_one]
            exact h1_not_mbar
          obtain ⟨e₁, he₁_not, he₁_ann⟩ := hEtaleAnn E₁ T₁ P_T₁ h1_not_PT₁
          obtain ⟨u_R, hu_R⟩ := Ideal.Quotient.mk_surjective (θ₁ e₁)
          have huR_not_max : u_R ∉ IsLocalRing.maximalIdeal R := by
            intro hu_mem
            apply he₁_not
            change θ₁ e₁ ∈ m_bar
            rw [← hu_R]
            exact Ideal.mem_map_of_mem π_Q hu_mem
          have he₁_unit : IsUnit (θ₁ e₁) := by
            rw [← hu_R]
            exact (IsLocalRing.notMem_maximalIdeal.mp huR_not_max).map π_Q
          have hMax_eq : IsLocalRing.maximalIdeal R = I_ϖ := by
            apply le_antisymm _ hIϖ_le
            intro y hy
            obtain ⟨⟨a_y, s_y⟩, hay⟩ := IsLocalization.surj p.primeCompl y
            have hs_unit : IsUnit (algebraMap A R s_y.1) := IsLocalization.map_units R s_y
            have hay_max : algebraMap A R a_y ∈ IsLocalRing.maximalIdeal R := by
              rw [← hay]
              exact (IsLocalRing.maximalIdeal R).mul_mem_right _ hy
            have h1a_mem : (1 : E₁) ⊗ₜ[P₀] a_y ∈ P_T₁ := by
              change θ₁ ((1 : E₁) ⊗ₜ[P₀] a_y) ∈ m_bar
              rw [hθ₁_eval a_y]
              exact Ideal.mem_map_of_mem π_Q hay_max
            have h_zero := congrArg θ₁ (he₁_ann _ h1a_mem)
            rw [map_mul, map_zero, hθ₁_eval a_y] at h_zero
            obtain ⟨u₁, hu₁⟩ := he₁_unit
            rw [← hu₁] at h_zero
            have haQ : π_Q (algebraMap A R a_y) = 0 := by
              have := congrArg (fun z : Q => (↑u₁⁻¹ : Q) * z) h_zero
              simpa [← mul_assoc] using this
            have ha_Iϖ : algebraMap A R a_y ∈ I_ϖ := Ideal.Quotient.eq_zero_iff_mem.mp haQ
            obtain ⟨v_s, hvs⟩ := hs_unit
            have hy_eq : y = algebraMap A R a_y * ↑v_s⁻¹ := by
              rw [← hay, ← hvs]
              simp [mul_assoc]
            rw [hy_eq]
            exact I_ϖ.mul_mem_right _ ha_Iϖ
          have hPrinc : (IsLocalRing.maximalIdeal R).IsPrincipal := by
            rw [hMax_eq]
            infer_instance
          by_cases hFieldR : IsField R
          · intro u v
            by_cases hu0 : u = 0
            · exact Or.inr (hu0 ▸ dvd_zero v)
            · obtain ⟨w, hw⟩ := hFieldR.mul_inv_cancel hu0
              exact Or.inl (IsUnit.of_mul_eq_one w hw).dvd
          · have hValR : ValuationRing R :=
              ((IsDiscreteValuationRing.TFAE R hFieldR).out 5 2).mp hPrinc
            intro u v
            exact ValuationRing.dvd_total u v

      obtain ⟨⟨a, b⟩, hab_raw⟩ :=
        @IsLocalization.surj A _ (nonZeroDivisors A) F _ φ₀.hom.toAlgebra hFrac₀ z_F
      have hab : z_F * φ₀.hom b.1 = φ₀.hom a := hab_raw
      have hb_ne : (b : A) ≠ 0 := nonZeroDivisors.ne_zero b.2
      have hφb_ne : φ₀.hom b.1 ≠ 0 := fun h0 => hb_ne (hInj_φ₀ (h0.trans (map_zero _).symm))
      have hφa_ne : φ₀.hom a ≠ 0 := by
        intro h0
        rw [h0] at hab
        exact hz0 (mul_eq_zero.mp hab |>.resolve_right hφb_ne)
      rcases hDvdTotal (algebraMap A R b.1) (algebraMap A R a) with ⟨q_R, hq_R⟩ | ⟨q_R, hq_R⟩
      · obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.surj p.primeCompl q_R
        have hs_ne : (s : A) ≠ 0 := fun h0 => s.2 (h0 ▸ p.zero_mem)
        have hφs_ne : φ₀.hom s.1 ≠ 0 := fun h0 => hs_ne (hInj_φ₀ (h0.trans (map_zero _).symm))
        have has_bc : a * s.1 = b.1 * c := by
          apply hInj_AR
          calc
            algebraMap A R (a * s.1) = algebraMap A R a * algebraMap A R s.1 := map_mul _ _ _
            _ = algebraMap A R b.1 * (q_R * algebraMap A R s.1) := by rw [hq_R, mul_assoc]
            _ = algebraMap A R (b.1 * c) := by rw [hcs, map_mul]
        let W : E.Opens := E.basicOpen s.1
        have hW : AlgebraicGeometry.IsAffineOpen W := hW₀.basicOpen s.1
        have hxW : x ∈ W := by
          rw [← hp_x]
          change p_x ∈ (TopologicalSpace.Opens.map hW₀.fromSpec.base).obj (E.basicOpen s.1)
          rw [hW₀.fromSpec_preimage_basicOpen s.1]
          exact s.2
        obtain ⟨φ, hFrac, hη⟩ := hFuncF W hW ⟨⟨x, hxW⟩⟩
        let res_s : E.presheaf.obj (Opposite.op W₀) ⟶ E.presheaf.obj (Opposite.op W) :=
          E.presheaf.map (CategoryTheory.homOfLE (E.basicOpen_le s.1)).op
        have hres_φ : res_s ≫ φ = φ₀ := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [← cancel_mono hW₀.fromSpec, AlgebraicGeometry.Spec.map_comp,
            CategoryTheory.Category.assoc,
            hW₀.map_fromSpec hW (CategoryTheory.homOfLE (E.basicOpen_le s.1)).op,
            hη, hη₀]
        have hφ_res : ∀ r : A, φ.hom (res_s.hom r) = φ₀.hom r := fun r =>
          congrArg (fun f => f.hom r) hres_φ
        have hu_res : IsUnit (res_s.hom s.1) := E.toRingedSpace.isUnit_res_basicOpen s.1
        obtain ⟨u_s, hu_s⟩ := hu_res
        let w : ↑(E.presheaf.obj (Opposite.op W)) := res_s.hom c * ↑u_s⁻¹
        refine ⟨W, hW, φ, hxW, hFrac, hη, Or.inl ⟨w, ?_⟩⟩
        have hw_s : φ.hom w * φ₀.hom s.1 = φ₀.hom c := by
          rw [← hφ_res s.1, ← hu_s, ← map_mul]
          dsimp [w]
          rw [mul_assoc, Units.inv_mul, mul_one, hφ_res c]
        have hw_bs : φ.hom w * (φ₀.hom b.1 * φ₀.hom s.1) = z_F * (φ₀.hom b.1 * φ₀.hom s.1) := by
          calc
            φ.hom w * (φ₀.hom b.1 * φ₀.hom s.1) = φ₀.hom b.1 * (φ.hom w * φ₀.hom s.1) := by ring
            _ = φ₀.hom b.1 * φ₀.hom c := by rw [hw_s]
            _ = φ₀.hom (b.1 * c) := (map_mul _ _ _).symm
            _ = φ₀.hom (a * s.1) := by rw [has_bc]
            _ = φ₀.hom a * φ₀.hom s.1 := map_mul _ _ _
            _ = (z_F * φ₀.hom b.1) * φ₀.hom s.1 := by rw [← hab]
            _ = z_F * (φ₀.hom b.1 * φ₀.hom s.1) := by ring
        exact mul_right_cancel₀ (mul_ne_zero hφb_ne hφs_ne) hw_bs
      · obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.surj p.primeCompl q_R
        have hs_ne : (s : A) ≠ 0 := fun h0 => s.2 (h0 ▸ p.zero_mem)
        have hφs_ne : φ₀.hom s.1 ≠ 0 := fun h0 => hs_ne (hInj_φ₀ (h0.trans (map_zero _).symm))
        have hbs_ac : b.1 * s.1 = a * c := by
          apply hInj_AR
          calc
            algebraMap A R (b.1 * s.1) = algebraMap A R b.1 * algebraMap A R s.1 := map_mul _ _ _
            _ = algebraMap A R a * (q_R * algebraMap A R s.1) := by rw [hq_R, mul_assoc]
            _ = algebraMap A R (a * c) := by rw [hcs, map_mul]
        let W : E.Opens := E.basicOpen s.1
        have hW : AlgebraicGeometry.IsAffineOpen W := hW₀.basicOpen s.1
        have hxW : x ∈ W := by
          rw [← hp_x]
          change p_x ∈ (TopologicalSpace.Opens.map hW₀.fromSpec.base).obj (E.basicOpen s.1)
          rw [hW₀.fromSpec_preimage_basicOpen s.1]
          exact s.2
        obtain ⟨φ, hFrac, hη⟩ := hFuncF W hW ⟨⟨x, hxW⟩⟩
        let res_s : E.presheaf.obj (Opposite.op W₀) ⟶ E.presheaf.obj (Opposite.op W) :=
          E.presheaf.map (CategoryTheory.homOfLE (E.basicOpen_le s.1)).op
        have hres_φ : res_s ≫ φ = φ₀ := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [← cancel_mono hW₀.fromSpec, AlgebraicGeometry.Spec.map_comp,
            CategoryTheory.Category.assoc,
            hW₀.map_fromSpec hW (CategoryTheory.homOfLE (E.basicOpen_le s.1)).op,
            hη, hη₀]
        have hφ_res : ∀ r : A, φ.hom (res_s.hom r) = φ₀.hom r := fun r =>
          congrArg (fun f => f.hom r) hres_φ
        have hu_res : IsUnit (res_s.hom s.1) := E.toRingedSpace.isUnit_res_basicOpen s.1
        obtain ⟨u_s, hu_s⟩ := hu_res
        let w : ↑(E.presheaf.obj (Opposite.op W)) := res_s.hom c * ↑u_s⁻¹
        refine ⟨W, hW, φ, hxW, hFrac, hη, Or.inr ⟨w, ?_⟩⟩
        have hw_s : φ.hom w * φ₀.hom s.1 = φ₀.hom c := by
          rw [← hφ_res s.1, ← hu_s, ← map_mul]
          dsimp [w]
          rw [mul_assoc, Units.inv_mul, mul_one, hφ_res c]
        have h_inv_ab : z_F⁻¹ * φ₀.hom a = φ₀.hom b.1 := by
          rw [← hab, ← mul_assoc, inv_mul_cancel₀ hz0, one_mul]
        have hw_as : φ.hom w * (φ₀.hom a * φ₀.hom s.1) = z_F⁻¹ * (φ₀.hom a * φ₀.hom s.1) := by
          calc
            φ.hom w * (φ₀.hom a * φ₀.hom s.1) = φ₀.hom a * (φ.hom w * φ₀.hom s.1) := by ring
            _ = φ₀.hom a * φ₀.hom c := by rw [hw_s]
            _ = φ₀.hom (a * c) := (map_mul _ _ _).symm
            _ = φ₀.hom (b.1 * s.1) := by rw [hbs_ac]
            _ = φ₀.hom b.1 * φ₀.hom s.1 := map_mul _ _ _
            _ = (z_F⁻¹ * φ₀.hom a) * φ₀.hom s.1 := by rw [← h_inv_ab]
            _ = z_F⁻¹ * (φ₀.hom a * φ₀.hom s.1) := by ring
        exact mul_right_cancel₀ (mul_ne_zero hφa_ne hφs_ne) hw_as

  have h_s3 : AlgebraicGeometry.IsDominant η_F →
      ∀ (e_F : F ≃+* FractionRing (Polynomial Ω)),
        (∀ c : Ω, e_F (algebraMap Ω F c) =
          algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) (Polynomial.C c)) →
        (∀ x : E,
          ∃ (W : E.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
            (φ : E.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
            x ∈ W ∧
            AlgebraicGeometry.Spec.map φ ≫ hW.fromSpec = η_F ∧
            (e_F.symm (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) Polynomial.X) ∈
                Set.range φ.hom ∨
              (e_F.symm (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) Polynomial.X))⁻¹ ∈
                Set.range φ.hom)) →
        ∃ (f : E ⟶ P₁),
          f ≫ p_P₁ = p_E ∧
          η_F ≫ f =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_F.symm.toRingHom) ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)))) ≫
              ι₀ := by
    intro hDomF e_F he_F hPoles
    have _ : AlgebraicGeometry.IsIntegral E := hIntE
    have _ : P₁.IsSeparated := hSepP₁
    let K₀ := FractionRing (Polynomial Ω)
    let α₀ : Polynomial Ω →+* K₀ := algebraMap (Polynomial Ω) K₀
    let X₀ : K₀ := α₀ Polynomial.X
    let z_F : F := e_F.symm X₀
    let η_P₁ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P₁ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_F.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀) ≫ ι₀
    have hρX_inv : ρ₁ Polynomial.X = X₀⁻¹ := eq_inv_of_mul_eq_one_left hρX
    have he_symm_C : ∀ c : Ω, e_F.symm (α₀ (Polynomial.C c)) = algebraMap Ω F c := by
      intro c
      rw [← he_F c]
      exact e_F.symm_apply_apply _
    have he_symm_ρX : e_F.symm (ρ₁ Polynomial.X) = z_F⁻¹ := by
      rw [hρX_inv, map_inv₀]
    choose W hW φ hxW hSpecφ hPole using hPoles
    let η_W : ∀ x : E, AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (W x).toScheme :=
      fun x => AlgebraicGeometry.Spec.map (φ x) ≫ (hW x).isoSpec.inv
    have hηW_ι : ∀ x : E, η_W x ≫ (W x).ι = η_F := by
      intro x
      dsimp [η_W]
      rw [CategoryTheory.Category.assoc, (hW x).isoSpec_inv_ι, hSpecφ x]
    have hLocal : ∀ x : E,
        ∃ f_x : (W x).toScheme ⟶ P₁,
          f_x ≫ p_P₁ = (W x).ι ≫ p_E ∧ η_W x ≫ f_x = η_P₁ := by
      intro x
      let A_x := ↑(E.presheaf.obj (Opposite.op (W x)))
      let γ_x : Ω →+* A_x :=
        (AlgebraicGeometry.Spec.preimage ((hW x).fromSpec ≫ p_E)).hom
      have hSpec_γ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_x) = (hW x).fromSpec ≫ p_E :=
        AlgebraicGeometry.Spec.map_preimage ((hW x).fromSpec ≫ p_E)
      have hφ_γ : ∀ c : Ω, (φ x).hom (γ_x c) = algebraMap Ω F c := by
        have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((φ x).hom.comp γ_x)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω F)) := by
          have hcomp : CommRingCat.ofHom ((φ x).hom.comp γ_x) = CommRingCat.ofHom γ_x ≫ φ x := rfl
          rw [hcomp, AlgebraicGeometry.Spec.map_comp, hSpec_γ, ← CategoryTheory.Category.assoc,
            hSpecφ x, hηF_comm]
        exact fun c => congrArg (fun g => g.hom c) (AlgebraicGeometry.Spec.map_injective h1)
      rcases hPole x with ⟨a_x, ha_x⟩ | ⟨b_x, hb_x⟩
      · let β_x : Polynomial Ω →+* A_x := Polynomial.eval₂RingHom γ_x a_x
        let f_x : (W x).toScheme ⟶ P₁ :=
          (hW x).isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_x) ≫ ι₀
        refine ⟨f_x, ?_, ?_⟩
        · dsimp [f_x]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hHom₀,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hβC : β_x.comp Polynomial.C = γ_x := by
            ext c
            simp [β_x]
          rw [hβC, hSpec_γ, ← CategoryTheory.Category.assoc]
          have hiso_from : (hW x).isoSpec.hom ≫ (hW x).fromSpec = (W x).ι := by
            rw [← (hW x).isoSpec_inv_ι, ← CategoryTheory.Category.assoc,
              CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp]
          rw [hiso_from]
        · dsimp [f_x, η_W, η_P₁]
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (hW x).isoSpec.inv,
            CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp,
            ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
          have h_eq_hom : CommRingCat.ofHom β_x ≫ φ x =
              CommRingCat.ofHom (e_F.symm.toRingHom.comp α₀) := by
            apply congrArg CommRingCat.ofHom
            apply Polynomial.ringHom_ext'
            · ext c
              change (φ x).hom (β_x (Polynomial.C c)) = e_F.symm (α₀ (Polynomial.C c))
              have h_eval_c : β_x (Polynomial.C c) = γ_x c := by simp [β_x]
              rw [h_eval_c, hφ_γ c, he_symm_C c]
            · change (φ x).hom (β_x Polynomial.X) = e_F.symm (α₀ Polynomial.X)
              simpa [β_x] using ha_x
          rw [h_eq_hom, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
            CategoryTheory.Category.assoc]
          rfl
      · let β'_x : Polynomial Ω →+* A_x := Polynomial.eval₂RingHom γ_x b_x
        let f_x : (W x).toScheme ⟶ P₁ :=
          (hW x).isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom β'_x) ≫ ι₁
        refine ⟨f_x, ?_, ?_⟩
        · dsimp [f_x]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hHom₁,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hβC : β'_x.comp Polynomial.C = γ_x := by
            ext c
            simp [β'_x]
          rw [hβC, hSpec_γ, ← CategoryTheory.Category.assoc]
          have hiso_from : (hW x).isoSpec.hom ≫ (hW x).fromSpec = (W x).ι := by
            rw [← (hW x).isoSpec_inv_ι, ← CategoryTheory.Category.assoc,
              CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp]
          rw [hiso_from]
        · dsimp [f_x, η_W, η_P₁]
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (hW x).isoSpec.inv,
            CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp,
            ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
          have h_eq_hom : CommRingCat.ofHom β'_x ≫ φ x =
              CommRingCat.ofHom (e_F.symm.toRingHom.comp ρ₁) := by
            apply congrArg CommRingCat.ofHom
            apply Polynomial.ringHom_ext'
            · ext c
              change (φ x).hom (β'_x (Polynomial.C c)) = e_F.symm (ρ₁ (Polynomial.C c))
              have h_eval_c : β'_x (Polynomial.C c) = γ_x c := by simp [β'_x]
              rw [h_eval_c, hφ_γ c, hρC c, he_symm_C c]
            · change (φ x).hom (β'_x Polynomial.X) = e_F.symm (ρ₁ Polynomial.X)
              rw [he_symm_ρX]
              simpa [β'_x] using hb_x
          rw [h_eq_hom, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
            CategoryTheory.Category.assoc, ← hGlue]
          rfl
    choose f_loc hf_p hf_η using hLocal
    have hSup : (⨆ x : ↥E, W x) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxW x⟩
    let 𝒰 : E.OpenCover := E.openCoverOfIsOpenCover W hSup
    have hCompat : ∀ x y : 𝒰.I₀,
        CategoryTheory.Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ f_loc x =
          CategoryTheory.Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ f_loc y := by
      intro x y
      change CategoryTheory.Limits.pullback.fst (W x).ι (W y).ι ≫ f_loc x =
        CategoryTheory.Limits.pullback.snd (W x).ι (W y).ι ≫ f_loc y
      let O_xy := CategoryTheory.Limits.pullback (W x).ι (W y).ι
      let j_xy : O_xy ⟶ E := CategoryTheory.Limits.pullback.fst (W x).ι (W y).ι ≫ (W x).ι
      have _ : AlgebraicGeometry.IsOpenImmersion j_xy := inferInstance
      have _ : AlgebraicGeometry.IsReduced O_xy :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion j_xy
      let η_xy : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ O_xy :=
        CategoryTheory.Limits.pullback.lift (η_W x) (η_W y) (by rw [hηW_ι x, hηW_ι y])
      have hDom_xy : AlgebraicGeometry.IsDominant η_xy := by
        rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
        ext o₀
        simp only [Set.mem_univ, iff_true, mem_closure_iff]
        intro V hV ho₀
        have hImgOpen : IsOpen (j_xy.base '' V) := j_xy.isOpenEmbedding.isOpenMap V hV
        have hImgNe : (j_xy.base '' V).Nonempty := ⟨j_xy.base o₀, o₀, ho₀, rfl⟩
        have hDenseF : Dense (Set.range η_F.base) :=
          (AlgebraicGeometry.isDominant_iff η_F).mp hDomF
        obtain ⟨_, ⟨o₁, ho₁V, rfl⟩, ⟨pt, hpt⟩⟩ :=
          hDenseF.inter_open_nonempty (j_xy.base '' V) hImgOpen hImgNe
        have h_comm : j_xy.base (η_xy.base pt) = η_F.base pt := by
          change (η_xy ≫ j_xy).base pt = η_F.base pt
          have h_eq : η_xy ≫ j_xy = η_F := by
            dsimp [η_xy, j_xy]
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hηW_ι x]
          rw [h_eq]
        have ho₁_eq : η_xy.base pt = o₁ := j_xy.isOpenEmbedding.injective (h_comm.trans hpt)
        exact ⟨o₁, ho₁V, pt, ho₁_eq⟩
      refine AlgebraicGeometry.ext_of_isDominant η_xy ?_
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hf_η x,
        ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hf_η y]
    let f : E ⟶ P₁ := 𝒰.glueMorphisms f_loc hCompat
    refine ⟨f, ?_, ?_⟩
    · refine 𝒰.hom_ext (f ≫ p_P₁) p_E fun x => ?_
      rw [← CategoryTheory.Category.assoc, 𝒰.ι_glueMorphisms f_loc hCompat x]
      exact hf_p x
    · have hIrredE : IrreducibleSpace ↥E := AlgebraicGeometry.irreducibleSpace_of_isIntegral E
      obtain ⟨x₀⟩ := hIrredE.toNonempty
      have h_glue_x₀ : (W x₀).ι ≫ f = f_loc x₀ := 𝒰.ι_glueMorphisms f_loc hCompat x₀
      change η_F ≫ f = η_P₁
      rw [← hηW_ι x₀, CategoryTheory.Category.assoc, h_glue_x₀, hf_η x₀]

  have h_s4 : ∀ (α : Polynomial Ω →+* F),
      @IsFractionRing (Polynomial Ω) _ F _ α.toAlgebra →
      (∀ c : Ω, α (Polynomial.C c) = algebraMap Ω F c) →
      ∃ (g_α : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω)) ⟶ E),
        g_α ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫ g_α = η_F := by
    intro α hFracα hαC
    have _ : AlgebraicGeometry.IsProper p_E := hPropE
    have hEqUC : AlgebraicGeometry.UniversallyClosed p_E =
        ((AlgebraicGeometry.topologically @SpecializingMap).universally p_E ∧
          AlgebraicGeometry.QuasiCompact p_E) :=
      congrFun (congrFun (congrFun AlgebraicGeometry.universallyClosed_eq_universallySpecializing _) _) p_E
    have hVC : AlgebraicGeometry.ValuativeCriterion.Existence p_E :=
      AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap p_E
        (Eq.mp hEqUC hPropE.toUniversallyClosed).1
    let P := Polynomial Ω
    let S : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of P)
    have hInj_α : Function.Injective α :=
      @IsFractionRing.injective P _ F _ α.toAlgebra hFracα

    have hLocalExt : ∀ q : PrimeSpectrum P,
        ∃ (W' : S.Opens) (g_q : W'.toScheme ⟶ E)
          (ξ_q : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ W'.toScheme),
          q ∈ W' ∧
          g_q ≫ p_E = W'.ι ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
          ξ_q ≫ W'.ι = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ∧
          ξ_q ≫ g_q = η_F := by
      intro q
      have _ : q.asIdeal.IsPrime := q.isPrime
      let O_q : Type u := Localization.AtPrime q.asIdeal
      have hSub_nzd : q.asIdeal.primeCompl ≤ nonZeroDivisors P := fun s hs =>
        mem_nonZeroDivisors_of_ne_zero (fun h0 => hs (h0 ▸ q.asIdeal.zero_mem))
      have hInj_POq : Function.Injective (algebraMap P O_q) :=
        IsLocalization.injective O_q hSub_nzd
      have _ : IsDomain O_q := IsLocalization.isDomain_of_le_nonZeroDivisors O_q hSub_nzd
      have _ : ValuationRing O_q := by
        by_cases hq_bot : q.asIdeal = ⊥
        · refine ValuationRing.iff_dvd_total.mpr ⟨fun x y => ?_⟩
          by_cases hx0 : x = 0
          · exact Or.inr (hx0 ▸ dvd_zero y)
          · obtain ⟨⟨a_x, s_x⟩, hax⟩ := IsLocalization.surj q.asIdeal.primeCompl x
            have hax_ne : a_x ≠ 0 := by
              intro h0
              rw [h0, map_zero] at hax
              obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp (IsLocalization.map_units O_q s_x)
              have := congrArg (· * w) hax
              exact hx0 (by simpa [mul_assoc, hw] using this)
            have hax_compl : a_x ∈ q.asIdeal.primeCompl := by
              change a_x ∉ q.asIdeal
              rw [hq_bot, Ideal.mem_bot]
              exact hax_ne
            have hx_unit : IsUnit x := by
              have hprod_unit : IsUnit (x * algebraMap P O_q s_x.1) := by
                rw [hax]
                exact IsLocalization.map_units O_q ⟨a_x, hax_compl⟩
              exact isUnit_of_mul_isUnit_left hprod_unit
            exact Or.inl hx_unit.dvd
        · have _ : IsDedekindDomain P := IsPrincipalIdealRing.isDedekindDomain P
          have _ : IsDiscreteValuationRing O_q :=
            IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain P hq_bot O_q
          exact of_isDiscreteValuationRing O_q
      have hUnits_q : ∀ y : q.asIdeal.primeCompl, IsUnit (α y.1) := fun ⟨y, hy⟩ =>
        Ne.isUnit (fun h0 =>
          (show y ≠ 0 from fun hy0 => hy (hy0 ▸ q.asIdeal.zero_mem))
            (hInj_α (h0.trans (map_zero _).symm)))
      let ι_q : O_q →+* F := IsLocalization.lift (M := q.asIdeal.primeCompl) (g := α) hUnits_q
      have hιq_eq : ∀ p : P, ι_q (algebraMap P O_q p) = α p :=
        fun p => IsLocalization.lift_eq (M := q.asIdeal.primeCompl) hUnits_q p
      have hInj_ιq : Function.Injective ι_q := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        obtain ⟨⟨a_z, s_z⟩, haz⟩ := IsLocalization.surj q.asIdeal.primeCompl z
        have hα_az : α a_z = 0 := by
          have h1 := congrArg ι_q haz
          rw [map_mul, hz, zero_mul, hιq_eq a_z] at h1
          exact h1.symm
        have haz_0 : a_z = 0 := hInj_α (hα_az.trans (map_zero _).symm)
        rw [haz_0, map_zero] at haz
        obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp (IsLocalization.map_units O_q s_z)
        have := congrArg (· * w) haz
        simpa [mul_assoc, hw] using this
      let _ : Algebra O_q F := ι_q.toAlgebra
      have _ : IsFractionRing O_q F :=
        { map_units := fun ⟨y, hy⟩ =>
            Ne.isUnit (fun h0 => nonZeroDivisors.ne_zero hy (hInj_ιq (h0.trans (map_zero ι_q).symm)))
          surj := fun z => by
            obtain ⟨⟨a, b⟩, hab⟩ := @IsLocalization.surj P _ (nonZeroDivisors P) F _ α.toAlgebra hFracα z
            have hb_ne : (b : P) ≠ 0 := nonZeroDivisors.ne_zero b.2
            have hb_Oq_ne : algebraMap P O_q b.1 ≠ 0 := fun h0 =>
              hb_ne (hInj_POq (h0.trans (map_zero _).symm))
            refine ⟨⟨algebraMap P O_q a, ⟨algebraMap P O_q b.1, mem_nonZeroDivisors_of_ne_zero hb_Oq_ne⟩⟩, ?_⟩
            change z * ι_q (algebraMap P O_q b.1) = ι_q (algebraMap P O_q a)
            rw [hιq_eq a, hιq_eq b.1]
            exact hab
          exists_of_eq := fun {x₁ x₂} h => ⟨1, by simp [hInj_ιq h]⟩ }
      let i₂ : AlgebraicGeometry.Spec (CommRingCat.of O_q) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap P O_q).comp Polynomial.C))
      have hsq : CategoryTheory.CommSq η_F
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap O_q F))) p_E i₂ := by
        refine ⟨?_⟩
        rw [hηF_comm]
        dsimp [i₂]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        apply congrArg AlgebraicGeometry.Spec.map
        apply congrArg CommRingCat.ofHom
        ext c
        change algebraMap Ω F c = ι_q (algebraMap P O_q (Polynomial.C c))
        rw [hιq_eq (Polynomial.C c), hαC c]
      let sq : AlgebraicGeometry.ValuativeCommSq p_E :=
        AlgebraicGeometry.ValuativeCommSq.mk O_q F η_F i₂ hsq
      obtain ⟨l_q⟩ := (hVC sq).exists_lift
      let η_tilde : AlgebraicGeometry.Spec (CommRingCat.of O_q) ⟶ E := l_q.l
      have hl_top : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_q) ≫ η_tilde = η_F := l_q.fac_left
      have hl_bot : η_tilde ≫ p_E = i₂ := l_q.fac_right

      obtain ⟨U_q, hAffU_q_mem, hz_Uq, _⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (AlgebraicGeometry.Scheme.isBasis_affineOpens E))
          (show η_tilde.base (IsLocalRing.closedPoint O_q) ∈ (⊤ : E.Opens) by trivial)
      have hAffU_q : AlgebraicGeometry.IsAffineOpen U_q := hAffU_q_mem
      have hPre_top : ((TopologicalSpace.Opens.map η_tilde.base).obj U_q) = ⊤ :=
        (IsLocalRing.closedPoint_mem_iff ((TopologicalSpace.Opens.map η_tilde.base).obj U_q)).mp hz_Uq
      have hRange_sub : Set.range η_tilde.base ⊆ Set.range hAffU_q.fromSpec.base := by
        rw [hAffU_q.range_fromSpec]
        rintro _ ⟨y, rfl⟩
        change y ∈ (TopologicalSpace.Opens.map η_tilde.base).obj U_q
        rw [hPre_top]
        trivial
      let u_q : AlgebraicGeometry.Spec (CommRingCat.of O_q) ⟶
          AlgebraicGeometry.Spec (E.presheaf.obj (Opposite.op U_q)) :=
        AlgebraicGeometry.IsOpenImmersion.lift hAffU_q.fromSpec η_tilde hRange_sub
      have hu_q_fac : u_q ≫ hAffU_q.fromSpec = η_tilde :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hAffU_q.fromSpec η_tilde hRange_sub
      let R_q : Type u := ↑(E.presheaf.obj (Opposite.op U_q))
      let θ_q : R_q →+* O_q := (AlgebraicGeometry.Spec.preimage u_q).hom
      have hSpec_θ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_q) = u_q :=
        AlgebraicGeometry.Spec.map_preimage u_q
      let γ_q : Ω →+* R_q := (AlgebraicGeometry.Spec.preimage (hAffU_q.fromSpec ≫ p_E)).hom
      have hSpec_γ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_q) = hAffU_q.fromSpec ≫ p_E :=
        AlgebraicGeometry.Spec.map_preimage (hAffU_q.fromSpec ≫ p_E)
      have hLFT_γ : AlgebraicGeometry.LocallyOfFiniteType
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_q)) := by
        rw [hSpec_γ]
        infer_instance
      have hFT_γ : γ_q.FiniteType :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_γ
      have hθ_γ : ∀ c : Ω, θ_q (γ_q c) = algebraMap P O_q (Polynomial.C c) := by
        have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_q.comp γ_q)) = i₂ := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_θ, hSpec_γ,
            ← CategoryTheory.Category.assoc, hu_q_fac, hl_bot]
        exact fun c => congrArg (fun f => f.hom c) (AlgebraicGeometry.Spec.map_injective h1)
      let _ : Algebra Ω R_q := γ_q.toAlgebra
      obtain ⟨t_set, ht_fin, ht_adj⟩ :=
        Subalgebra.fg_def.mp (@Algebra.FiniteType.out Ω R_q _ _ _ hFT_γ)
      let _ : DecidableEq R_q := Classical.decEq R_q
      let G_q : Finset R_q := ht_fin.toFinset
      have hG_adj : Algebra.adjoin Ω (↑G_q : Set R_q) = ⊤ := by
        simpa [G_q] using ht_adj

      have hSurj_gen : ∀ r : R_q, ∃ (a_r : P) (d_r : q.asIdeal.primeCompl),
          θ_q r * algebraMap P O_q d_r.1 = algebraMap P O_q a_r := fun r =>
        let ⟨⟨a_r, d_r⟩, hdr⟩ := IsLocalization.surj q.asIdeal.primeCompl (θ_q r)
        ⟨a_r, d_r, hdr⟩
      choose a_gen d_gen hd_gen using hSurj_gen
      let s_q : P := ∏ r ∈ G_q, (d_gen r).1
      have hsq_mem : s_q ∈ q.asIdeal.primeCompl :=
        Submonoid.prod_mem q.asIdeal.primeCompl (fun r _ => (d_gen r).2)
      have hsq_ne : s_q ≠ 0 := fun h0 => hsq_mem (h0 ▸ q.asIdeal.zero_mem)

      let P_sq : Type u := Localization.Away s_q
      have hUnit_sq_Oq : IsUnit (algebraMap P O_q s_q) := IsLocalization.map_units O_q ⟨s_q, hsq_mem⟩
      let lam_q : P_sq →+* O_q := IsLocalization.Away.lift s_q hUnit_sq_Oq
      have hlam_eq : ∀ p : P, lam_q (algebraMap P P_sq p) = algebraMap P O_q p :=
        fun p => IsLocalization.Away.lift_eq s_q hUnit_sq_Oq p
      have hInj_lam : Function.Injective lam_q := by
        rw [injective_iff_map_eq_zero]
        intro w hw
        obtain ⟨k, p_w, hpw⟩ := IsLocalization.Away.surj s_q w
        have hp_zero : algebraMap P O_q p_w = 0 := by
          have h1 := congrArg lam_q hpw
          rw [map_mul, hw, zero_mul, hlam_eq] at h1
          exact h1.symm
        have hpw0 : p_w = 0 := hInj_POq (hp_zero.trans (map_zero _).symm)
        rw [hpw0, map_zero] at hpw
        have hpow_unit : IsUnit ((algebraMap P P_sq s_q) ^ k) :=
          (IsLocalization.Away.algebraMap_isUnit s_q).pow k
        obtain ⟨u_k, huk⟩ := hpow_unit
        rw [← huk] at hpw
        have := congrArg (fun z : P_sq => z * (↑u_k⁻¹ : P_sq)) hpw
        simpa [mul_assoc] using this

      let M_sub : Subalgebra Ω R_q :=
        { carrier := {r : R_q | θ_q r ∈ Set.range lam_q}
          mul_mem' := by
            rintro x₁ x₂ ⟨w₁, hw₁⟩ ⟨w₂, hw₂⟩
            exact ⟨w₁ * w₂, by rw [map_mul, map_mul, hw₁, hw₂]⟩
          one_mem' := ⟨1, by rw [map_one, map_one]⟩
          add_mem' := by
            rintro x₁ x₂ ⟨w₁, hw₁⟩ ⟨w₂, hw₂⟩
            exact ⟨w₁ + w₂, by rw [map_add, map_add, hw₁, hw₂]⟩
          zero_mem' := ⟨0, by rw [map_zero, map_zero]⟩
          algebraMap_mem' := fun c => by
            refine ⟨algebraMap P P_sq (Polynomial.C c), ?_⟩
            rw [hlam_eq]
            exact (hθ_γ c).symm }
      have hG_sub : (↑G_q : Set R_q) ⊆ M_sub := by
        intro r hr
        have hr_mem : r ∈ G_q := Finset.mem_coe.mp hr
        obtain ⟨c_r, hcr⟩ := Finset.dvd_prod_of_mem (fun x => (d_gen x).1) hr_mem
        obtain ⟨u_sq, husq⟩ := IsLocalization.Away.algebraMap_isUnit (S := P_sq) s_q
        let w_r : P_sq := algebraMap P P_sq (a_gen r * c_r) * ↑u_sq⁻¹
        refine ⟨w_r, ?_⟩
        obtain ⟨v_sq, hvsq⟩ := hUnit_sq_Oq
        have h_mul : lam_q w_r * algebraMap P O_q s_q = θ_q r * algebraMap P O_q s_q := by
          calc
            lam_q w_r * algebraMap P O_q s_q
              = lam_q (w_r * algebraMap P P_sq s_q) := by rw [← hlam_eq s_q, ← lam_q.map_mul]
            _ = lam_q (algebraMap P P_sq (a_gen r * c_r)) := by
                  dsimp [w_r]
                  rw [← husq, mul_assoc, Units.inv_mul, mul_one]
            _ = algebraMap P O_q (a_gen r * c_r) := hlam_eq _
            _ = algebraMap P O_q (a_gen r) * algebraMap P O_q c_r := map_mul _ _ _
            _ = (θ_q r * algebraMap P O_q (d_gen r).1) * algebraMap P O_q c_r := by rw [← hd_gen r]
            _ = θ_q r * algebraMap P O_q ((d_gen r).1 * c_r) := by rw [mul_assoc, map_mul]
            _ = θ_q r * algebraMap P O_q s_q := by rw [← hcr]
        rw [← hvsq] at h_mul
        have := congrArg (fun z : O_q => z * (↑v_sq⁻¹ : O_q)) h_mul
        simpa [mul_assoc] using this
      have hAll_in_range : ∀ r : R_q, ∃ w : P_sq, lam_q w = θ_q r := by
        have hTop_le : (⊤ : Subalgebra Ω R_q) ≤ M_sub := by
          rw [← hG_adj]
          exact Algebra.adjoin_le hG_sub
        intro r
        exact hTop_le (by trivial : r ∈ (⊤ : Subalgebra Ω R_q))
      choose τ_fun hτ_fun using hAll_in_range
      let τ_q : R_q →+* P_sq :=
        { toFun := τ_fun
          map_one' := hInj_lam (by rw [hτ_fun, map_one, map_one])
          map_mul' := fun x₁ x₂ => hInj_lam (by rw [hτ_fun, map_mul, map_mul, hτ_fun, hτ_fun])
          map_zero' := hInj_lam (by rw [hτ_fun, map_zero, map_zero])
          map_add' := fun x₁ x₂ => hInj_lam (by rw [hτ_fun, map_add, map_add, hτ_fun, hτ_fun]) }
      have hlam_τ : lam_q.comp τ_q = θ_q := RingHom.ext hτ_fun
      have hτ_γ : τ_q.comp γ_q = (algebraMap P P_sq).comp Polynomial.C := by
        ext c
        apply hInj_lam
        change lam_q (τ_fun (γ_q c)) = lam_q (algebraMap P P_sq (Polynomial.C c))
        rw [hτ_fun, hlam_eq, hθ_γ c]

      have hUnit_α_sq : IsUnit (α s_q) :=
        Ne.isUnit (fun h0 => hsq_ne (hInj_α (h0.trans (map_zero _).symm)))
      let α_sq : P_sq →+* F := IsLocalization.Away.lift s_q hUnit_α_sq
      have hα_sq_comp : α_sq.comp (algebraMap P P_sq) = α :=
        RingHom.ext fun p => IsLocalization.Away.lift_eq s_q hUnit_α_sq p
      have hα_sq_eq_ιlam : α_sq = ι_q.comp lam_q := by
        refine IsLocalization.ringHom_ext (Submonoid.powers s_q) ?_
        refine RingHom.ext fun p => ?_
        change α_sq (algebraMap P P_sq p) = ι_q (lam_q (algebraMap P P_sq p))
        rw [IsLocalization.Away.lift_eq s_q hUnit_α_sq p, hlam_eq p, hιq_eq p]

      let j_q : AlgebraicGeometry.Spec (CommRingCat.of P_sq) ⟶ S :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P P_sq))
      have _ : AlgebraicGeometry.IsOpenImmersion j_q :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization s_q
      let W'_q : S.Opens := j_q.opensRange
      have hq_mem : q ∈ W'_q := by
        change q ∈ Set.range j_q.base
        change q ∈ Set.range (PrimeSpectrum.comap (algebraMap P P_sq))
        rw [PrimeSpectrum.localization_away_comap_range P_sq s_q]
        exact hsq_mem
      let g_q : W'_q.toScheme ⟶ E :=
        j_q.isoOpensRange.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_q) ≫ hAffU_q.fromSpec
      let ξ_q : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ W'_q.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_sq) ≫ j_q.isoOpensRange.hom
      refine ⟨W'_q, g_q, ξ_q, hq_mem, ?_, ?_, ?_⟩
      · dsimp [g_q]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← hSpec_γ,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hτ_γ,
          CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.Hom.isoOpensRange_inv_comp]
      · dsimp [ξ_q]
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hα_sq_comp]
      · dsimp [ξ_q, g_q]
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc j_q.isoOpensRange.hom,
          CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          hα_sq_eq_ιlam, RingHom.comp_assoc, hlam_τ, CommRingCat.ofHom_comp,
          AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hSpec_θ, hu_q_fac, hl_top]

    choose W' g_loc ξ_loc hq_W' hg_p hξ_ι hξ_g using hLocalExt
    have hSup : (⨆ q : ↥S, W' q) = ⊤ := by
      rw [eq_top_iff]
      intro q _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨q, hq_W' q⟩
    let 𝒰_S : S.OpenCover := S.openCoverOfIsOpenCover W' hSup
    have hDom_α : AlgebraicGeometry.IsDominant (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)) := by
      rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
      ext p₀
      simp only [Set.mem_univ, iff_true, mem_closure_iff]
      intro V hV hp₀V
      let pt : PrimeSpectrum F := ⟨⊥, inferInstance⟩
      have h_bot : ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).base pt).asIdeal = ⊥ := by
        ext f
        simp only [Ideal.mem_bot]
        change α f ∈ (⊥ : Ideal F) ↔ f = 0
        rw [Ideal.mem_bot]
        exact ⟨fun h0 => hInj_α (h0.trans (map_zero _).symm), fun h0 => h0 ▸ map_zero _⟩
      have hClosed_compl : IsClosed (Vᶜ : Set (PrimeSpectrum P)) := hV.isClosed_compl
      obtain ⟨I_set, hI_set⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus (Vᶜ : Set (PrimeSpectrum P))).mp hClosed_compl
      have hpt_in_V : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).base pt ∈ V := by
        by_contra hNotV
        have h_in_zl : ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).base pt : PrimeSpectrum P) ∈
            PrimeSpectrum.zeroLocus I_set := by
          rw [← hI_set]
          exact hNotV
        have hp₀_in_zl : (p₀ : PrimeSpectrum P) ∈ PrimeSpectrum.zeroLocus I_set := by
          intro z hz
          have hz_bot : z ∈ ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).base pt).asIdeal :=
            h_in_zl hz
          rw [h_bot, Ideal.mem_bot] at hz_bot
          exact hz_bot ▸ p₀.asIdeal.zero_mem
        rw [← hI_set] at hp₀_in_zl
        exact hp₀_in_zl hp₀V
      exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).base pt, hpt_in_V, pt, rfl⟩

    have hCompat : ∀ q₁ q₂ : 𝒰_S.I₀,
        CategoryTheory.Limits.pullback.fst (𝒰_S.f q₁) (𝒰_S.f q₂) ≫ g_loc q₁ =
          CategoryTheory.Limits.pullback.snd (𝒰_S.f q₁) (𝒰_S.f q₂) ≫ g_loc q₂ := by
      intro q₁ q₂
      change CategoryTheory.Limits.pullback.fst (W' q₁).ι (W' q₂).ι ≫ g_loc q₁ =
        CategoryTheory.Limits.pullback.snd (W' q₁).ι (W' q₂).ι ≫ g_loc q₂
      let O_12 := CategoryTheory.Limits.pullback (W' q₁).ι (W' q₂).ι
      let j_12 : O_12 ⟶ S := CategoryTheory.Limits.pullback.fst (W' q₁).ι (W' q₂).ι ≫ (W' q₁).ι
      have _ : AlgebraicGeometry.IsOpenImmersion j_12 := inferInstance
      have _ : AlgebraicGeometry.IsReduced O_12 :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion j_12
      let ξ_12 : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ O_12 :=
        CategoryTheory.Limits.pullback.lift (ξ_loc q₁) (ξ_loc q₂) (by rw [hξ_ι q₁, hξ_ι q₂])
      have hDom_12 : AlgebraicGeometry.IsDominant ξ_12 := by
        rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
        ext o₀
        simp only [Set.mem_univ, iff_true, mem_closure_iff]
        intro V hV ho₀
        have hImgOpen : IsOpen (j_12.base '' V) := j_12.isOpenEmbedding.isOpenMap V hV
        have hImgNe : (j_12.base '' V).Nonempty := ⟨j_12.base o₀, o₀, ho₀, rfl⟩
        have hDenseα : Dense (Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).base) :=
          (AlgebraicGeometry.isDominant_iff _).mp hDom_α
        obtain ⟨_, ⟨o₁, ho₁V, rfl⟩, ⟨pt, hpt⟩⟩ :=
          hDenseα.inter_open_nonempty (j_12.base '' V) hImgOpen hImgNe
        have h_comm : j_12.base (ξ_12.base pt) =
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).base pt := by
          change (ξ_12 ≫ j_12).base pt = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).base pt
          have h_eq : ξ_12 ≫ j_12 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) := by
            dsimp [ξ_12, j_12]
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hξ_ι q₁]
          rw [h_eq]
        have ho₁_eq : ξ_12.base pt = o₁ := j_12.isOpenEmbedding.injective (h_comm.trans hpt)
        exact ⟨o₁, ho₁V, pt, ho₁_eq⟩
      refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated p_E ?_ ξ_12 ?_
      · rw [CategoryTheory.Category.assoc, hg_p q₁, CategoryTheory.Category.assoc, hg_p q₂,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc]
      · rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hξ_g q₁,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hξ_g q₂]
    let g_α : S ⟶ E := 𝒰_S.glueMorphisms g_loc hCompat
    refine ⟨g_α, ?_, ?_⟩
    · refine 𝒰_S.hom_ext (g_α ≫ p_E) (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
        fun q => ?_
      rw [← CategoryTheory.Category.assoc, 𝒰_S.ι_glueMorphisms g_loc hCompat q]
      exact hg_p q
    · let q₀ : PrimeSpectrum P := ⟨⊥, inferInstance⟩
      have h_glue_q₀ : (W' q₀).ι ≫ g_α = g_loc q₀ := 𝒰_S.ι_glueMorphisms g_loc hCompat q₀
      rw [← hξ_ι q₀, CategoryTheory.Category.assoc, h_glue_q₀, hξ_g q₀]

  have h_s5 : ∀ (e_F : F ≃+* FractionRing (Polynomial Ω)),
      (∀ c : Ω, e_F (algebraMap Ω F c) =
        algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) (Polynomial.C c)) →
      AlgebraicGeometry.IsDominant
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_F.symm.toRingHom) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)))) ≫
          ι₀) →
      ∃ (g : P₁ ⟶ E),
        g ≫ p_E = p_P₁ ∧
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_F.symm.toRingHom) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)))) ≫
          ι₀) ≫ g = η_F := by
    intro e_F he_F hDom_P₁
    have _ : AlgebraicGeometry.IsProper p_E := hPropE
    have _ : AlgebraicGeometry.IsReduced P₁ := hRedP₁
    have _ : AlgebraicGeometry.IsOpenImmersion ι₀ := hOpen₀
    have _ : AlgebraicGeometry.IsOpenImmersion ι₁ := hOpen₁
    let α₀ : Polynomial Ω →+* FractionRing (Polynomial Ω) :=
      algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω))
    let X₀ : FractionRing (Polynomial Ω) := α₀ Polynomial.X

    let revPoly : ℕ → Polynomial Ω → Polynomial Ω := fun N p =>
      ∑ k ∈ Finset.range (N + 1), Polynomial.C (p.coeff k) * Polynomial.X ^ (N - k)
    have hRev_coeff : ∀ (N k : ℕ) (p : Polynomial Ω),
        k ≤ N → (revPoly N p).coeff (N - k) = p.coeff k := by
      intro N k p hk
      dsimp [revPoly]
      rw [Polynomial.finsetSum_coeff]
      have hk_mem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
      rw [Finset.sum_eq_single k]
      · rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
        simp only [ite_true, mul_one]
      · intro j hj _
        have hj_le : j < N + 1 := Finset.mem_range.mp hj
        have hne : N - k ≠ N - j := by omega
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
        simp only [hne, ite_false, mul_zero]
      · intro hk_not
        exact absurd hk_mem hk_not
    have hRev_eq_zero : ∀ (N : ℕ) (p : Polynomial Ω),
        p.natDegree ≤ N → revPoly N p = 0 → p = 0 := by
      intro N p hp h0
      ext k
      rw [Polynomial.coeff_zero]
      by_cases hk : k ≤ N
      · rw [← hRev_coeff N k p hk, h0, Polynomial.coeff_zero]
      · exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)

    have hPow_inv : ∀ m : ℕ, (ρ₁ Polynomial.X) ^ m * X₀ ^ m = 1 := by
      intro m
      rw [← mul_pow, hρX, one_pow]
    have hρ₁_mul_pow : ∀ (N : ℕ) (p : Polynomial Ω), p.natDegree ≤ N →
        ρ₁ p * X₀ ^ N = α₀ (revPoly N p) := by
      intro N p hp
      have hp_sum := Polynomial.as_sum_range_C_mul_X_pow' p (Nat.lt_succ_of_le hp)
      conv_lhs => rw [hp_sum]
      rw [map_sum, Finset.sum_mul]
      dsimp [revPoly]
      rw [map_sum]
      refine Finset.sum_congr rfl fun k hk => ?_
      have hk_le : k ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
      have hN_split : N = k + (N - k) := by omega
      conv_lhs => rw [hN_split, pow_add]
      rw [map_mul, map_pow, hρC (p.coeff k), map_mul, map_pow]
      calc
        (α₀ (Polynomial.C (p.coeff k)) * (ρ₁ Polynomial.X) ^ k) * (X₀ ^ k * X₀ ^ (N - k))
          = α₀ (Polynomial.C (p.coeff k)) * ((ρ₁ Polynomial.X) ^ k * X₀ ^ k) * X₀ ^ (N - k) := by ring
        _ = α₀ (Polynomial.C (p.coeff k)) * X₀ ^ (N - k) := by rw [hPow_inv k, mul_one]
    have hα₀_mul_pow : ∀ (N : ℕ) (p : Polynomial Ω), p.natDegree ≤ N →
        α₀ p * (ρ₁ Polynomial.X) ^ N = ρ₁ (revPoly N p) := by
      intro N p hp
      have hp_sum := Polynomial.as_sum_range_C_mul_X_pow' p (Nat.lt_succ_of_le hp)
      conv_lhs => rw [hp_sum]
      rw [map_sum, Finset.sum_mul]
      dsimp [revPoly]
      rw [map_sum]
      refine Finset.sum_congr rfl fun k hk => ?_
      have hk_le : k ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
      have hN_split : N = k + (N - k) := by omega
      conv_lhs => rw [hN_split, pow_add]
      rw [map_mul, map_pow, map_mul, map_pow, hρC (p.coeff k)]
      calc
        (α₀ (Polynomial.C (p.coeff k)) * X₀ ^ k) * ((ρ₁ Polynomial.X) ^ k * (ρ₁ Polynomial.X) ^ (N - k))
          = α₀ (Polynomial.C (p.coeff k)) * ((ρ₁ Polynomial.X) ^ k * X₀ ^ k) * (ρ₁ Polynomial.X) ^ (N - k) := by ring
        _ = α₀ (Polynomial.C (p.coeff k)) * (ρ₁ Polynomial.X) ^ (N - k) := by rw [hPow_inv k, mul_one]

    have hInj_α₀ : Function.Injective α₀ :=
      IsFractionRing.injective (Polynomial Ω) (FractionRing (Polynomial Ω))
    have hInj_ρ₁ : Function.Injective ρ₁ := by
      rw [injective_iff_map_eq_zero]
      intro p hp0
      have h1 := hρ₁_mul_pow p.natDegree p le_rfl
      rw [hp0, zero_mul] at h1
      exact hRev_eq_zero p.natDegree p le_rfl (hInj_α₀ (h1.symm.trans (map_zero _).symm))
    have hSurj_ρ₁ : ∀ z : FractionRing (Polynomial Ω),
        ∃ ab : Polynomial Ω × nonZeroDivisors (Polynomial Ω),
          z * ρ₁ ab.2.1 = ρ₁ ab.1 := by
      intro z
      obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors (Polynomial Ω)) z
      have hb_ne : (b : Polynomial Ω) ≠ 0 := nonZeroDivisors.ne_zero b.2
      let N : ℕ := max a.natDegree b.1.natDegree
      have ha_deg : a.natDegree ≤ N := le_max_left _ _
      have hb_deg : b.1.natDegree ≤ N := le_max_right _ _
      have hrev_b_ne : revPoly N b.1 ≠ 0 :=
        fun h0 => hb_ne (hRev_eq_zero N b.1 hb_deg h0)
      refine ⟨⟨revPoly N a, ⟨revPoly N b.1, mem_nonZeroDivisors_of_ne_zero hrev_b_ne⟩⟩, ?_⟩
      rw [← hα₀_mul_pow N b.1 hb_deg, ← hα₀_mul_pow N a ha_deg, ← mul_assoc]
      exact congrArg (· * (ρ₁ Polynomial.X) ^ N) hab
    have hFrac_ρ₁ : @IsFractionRing (Polynomial Ω) _ (FractionRing (Polynomial Ω)) _ ρ₁.toAlgebra := by
      let _ : Algebra (Polynomial Ω) (FractionRing (Polynomial Ω)) := ρ₁.toAlgebra
      exact
        { map_units := fun ⟨y, hy⟩ =>
            Ne.isUnit (fun h0 => nonZeroDivisors.ne_zero hy (hInj_ρ₁ (h0.trans (map_zero ρ₁).symm)))
          surj := hSurj_ρ₁
          exists_of_eq := fun {x₁ x₂} h => ⟨1, by simp [hInj_ρ₁ h]⟩ }

    have hTransFrac : ∀ (β : Polynomial Ω →+* FractionRing (Polynomial Ω)),
        @IsFractionRing (Polynomial Ω) _ (FractionRing (Polynomial Ω)) _ β.toAlgebra →
        @IsFractionRing (Polynomial Ω) _ F _ (e_F.symm.toRingHom.comp β).toAlgebra := by
      intro β hFracβ
      have hInj_β : Function.Injective β :=
        @IsFractionRing.injective (Polynomial Ω) _ (FractionRing (Polynomial Ω)) _ β.toAlgebra hFracβ
      let β' : Polynomial Ω →+* F := e_F.symm.toRingHom.comp β
      have hInj_β' : Function.Injective β' := e_F.symm.injective.comp hInj_β
      have hSurj_β' : ∀ z : F,
          ∃ ab : Polynomial Ω × nonZeroDivisors (Polynomial Ω), z * β' ab.2.1 = β' ab.1 := by
        intro z
        obtain ⟨⟨a, b⟩, hab_raw⟩ :=
          @IsLocalization.surj (Polynomial Ω) _ (nonZeroDivisors (Polynomial Ω))
            (FractionRing (Polynomial Ω)) _ β.toAlgebra hFracβ (e_F z)
        have hab : e_F z * β b.1 = β a := hab_raw
        refine ⟨⟨a, b⟩, ?_⟩
        change z * e_F.symm (β b.1) = e_F.symm (β a)
        have := congrArg e_F.symm hab
        rw [map_mul, e_F.symm_apply_apply] at this
        exact this
      let _ : Algebra (Polynomial Ω) F := β'.toAlgebra
      exact
        { map_units := fun ⟨y, hy⟩ =>
            Ne.isUnit (fun h0 => nonZeroDivisors.ne_zero hy (hInj_β' (h0.trans (map_zero β').symm)))
          surj := hSurj_β'
          exists_of_eq := fun {x₁ x₂} h => ⟨1, by simp [hInj_β' h]⟩ }

    have hFrac_α₀ : @IsFractionRing (Polynomial Ω) _ (FractionRing (Polynomial Ω)) _ α₀.toAlgebra := by
      have hAlg_eq : α₀.toAlgebra =
          (inferInstance : Algebra (Polynomial Ω) (FractionRing (Polynomial Ω))) :=
        Algebra.algebra_ext _ _ (fun _ => rfl)
      rw [hAlg_eq]
      infer_instance

    let α_tilde₀ : Polynomial Ω →+* F := e_F.symm.toRingHom.comp α₀
    let α_tilde₁ : Polynomial Ω →+* F := e_F.symm.toRingHom.comp ρ₁
    have he_symm_C : ∀ c : Ω, e_F.symm (α₀ (Polynomial.C c)) = algebraMap Ω F c := by
      intro c
      rw [← he_F c]
      exact e_F.symm_apply_apply _
    obtain ⟨g₀, hg₀_p, hg₀_η⟩ := h_s4 α_tilde₀ (hTransFrac α₀ hFrac_α₀) he_symm_C
    obtain ⟨g₁, hg₁_p, hg₁_η⟩ := h_s4 α_tilde₁ (hTransFrac ρ₁ hFrac_ρ₁)
      (fun c => by change e_F.symm (ρ₁ (Polynomial.C c)) = _; rw [hρC c, he_symm_C c])

    let η_P₁ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P₁ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_F.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀) ≫ ι₀
    let U_cov : Bool → P₁.Opens := fun b =>
      match b with
      | false => ι₀.opensRange
      | true => ι₁.opensRange
    have hSup_P₁ : (⨆ b : Bool, U_cov b) = ⊤ := by
      rw [eq_top_iff]
      intro y _
      have hy_univ : y ∈ Set.range ι₀.base ∪ Set.range ι₁.base := by
        rw [hCov]
        trivial
      rcases hy_univ with hy₀ | hy₁
      · exact TopologicalSpace.Opens.mem_iSup.mpr ⟨false, hy₀⟩
      · exact TopologicalSpace.Opens.mem_iSup.mpr ⟨true, hy₁⟩
    let 𝒰_P₁ : P₁.OpenCover := P₁.openCoverOfIsOpenCover U_cov hSup_P₁
    let g_chart : ∀ b : Bool, (U_cov b).toScheme ⟶ E := fun b =>
      match b with
      | false => ι₀.isoOpensRange.inv ≫ g₀
      | true => ι₁.isoOpensRange.inv ≫ g₁
    let ξ_chart : ∀ b : Bool, AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (U_cov b).toScheme := fun b =>
      match b with
      | false => AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_tilde₀) ≫ ι₀.isoOpensRange.hom
      | true => AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_tilde₁) ≫ ι₁.isoOpensRange.hom
    have hg_chart_p : ∀ b : Bool, g_chart b ≫ p_E = (U_cov b).ι ≫ p_P₁ := by
      intro b
      cases b
      · dsimp [g_chart, U_cov]
        rw [CategoryTheory.Category.assoc, hg₀_p, ← hHom₀, ← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.Hom.isoOpensRange_inv_comp]
      · dsimp [g_chart, U_cov]
        rw [CategoryTheory.Category.assoc, hg₁_p, ← hHom₁, ← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.Hom.isoOpensRange_inv_comp]
    have hξ_chart_ι : ∀ b : Bool, ξ_chart b ≫ (U_cov b).ι = η_P₁ := by
      intro b
      cases b
      · dsimp [ξ_chart, U_cov, α_tilde₀]
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι,
          CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        rfl
      · dsimp [ξ_chart, U_cov, α_tilde₁]
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι,
          AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, ← hGlue]
        rfl
    have hξ_chart_g : ∀ b : Bool, ξ_chart b ≫ g_chart b = η_F := by
      intro b
      cases b
      · dsimp [ξ_chart, g_chart]
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc ι₀.isoOpensRange.hom,
          CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp, hg₀_η]
      · dsimp [ξ_chart, g_chart]
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc ι₁.isoOpensRange.hom,
          CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp, hg₁_η]

    have hCompat : ∀ b₁ b₂ : 𝒰_P₁.I₀,
        CategoryTheory.Limits.pullback.fst (𝒰_P₁.f b₁) (𝒰_P₁.f b₂) ≫ g_chart b₁ =
          CategoryTheory.Limits.pullback.snd (𝒰_P₁.f b₁) (𝒰_P₁.f b₂) ≫ g_chart b₂ := by
      intro b₁ b₂
      change CategoryTheory.Limits.pullback.fst (U_cov b₁).ι (U_cov b₂).ι ≫ g_chart b₁ =
        CategoryTheory.Limits.pullback.snd (U_cov b₁).ι (U_cov b₂).ι ≫ g_chart b₂
      let O_12 := CategoryTheory.Limits.pullback (U_cov b₁).ι (U_cov b₂).ι
      let j_12 : O_12 ⟶ P₁ := CategoryTheory.Limits.pullback.fst (U_cov b₁).ι (U_cov b₂).ι ≫ (U_cov b₁).ι
      have _ : AlgebraicGeometry.IsOpenImmersion j_12 := inferInstance
      have _ : AlgebraicGeometry.IsReduced O_12 :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion j_12
      let ξ_12 : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ O_12 :=
        CategoryTheory.Limits.pullback.lift (ξ_chart b₁) (ξ_chart b₂)
          (by rw [hξ_chart_ι b₁, hξ_chart_ι b₂])
      have hDom_12 : AlgebraicGeometry.IsDominant ξ_12 := by
        rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
        ext o₀
        simp only [Set.mem_univ, iff_true, mem_closure_iff]
        intro V hV ho₀
        have hImgOpen : IsOpen (j_12.base '' V) := j_12.isOpenEmbedding.isOpenMap V hV
        have hImgNe : (j_12.base '' V).Nonempty := ⟨j_12.base o₀, o₀, ho₀, rfl⟩
        have hDenseP₁ : Dense (Set.range η_P₁.base) :=
          (AlgebraicGeometry.isDominant_iff _).mp hDom_P₁
        obtain ⟨_, ⟨o₁, ho₁V, rfl⟩, ⟨pt, hpt⟩⟩ :=
          hDenseP₁.inter_open_nonempty (j_12.base '' V) hImgOpen hImgNe
        have h_comm : j_12.base (ξ_12.base pt) = η_P₁.base pt := by
          change (ξ_12 ≫ j_12).base pt = η_P₁.base pt
          have h_eq : ξ_12 ≫ j_12 = η_P₁ := by
            dsimp [ξ_12, j_12]
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              hξ_chart_ι b₁]
          rw [h_eq]
        have ho₁_eq : ξ_12.base pt = o₁ := j_12.isOpenEmbedding.injective (h_comm.trans hpt)
        exact ⟨o₁, ho₁V, pt, ho₁_eq⟩
      refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated p_E ?_ ξ_12 ?_
      · rw [CategoryTheory.Category.assoc, hg_chart_p b₁, CategoryTheory.Category.assoc,
          hg_chart_p b₂, ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc]
      · rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          hξ_chart_g b₁, ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          hξ_chart_g b₂]
    let g : P₁ ⟶ E := 𝒰_P₁.glueMorphisms g_chart hCompat
    refine ⟨g, ?_, ?_⟩
    · refine 𝒰_P₁.hom_ext (g ≫ p_E) p_P₁ fun b => ?_
      rw [← CategoryTheory.Category.assoc, 𝒰_P₁.ι_glueMorphisms g_chart hCompat b]
      exact hg_chart_p b
    · have h_glue_f : (U_cov false).ι ≫ g = g_chart false :=
        𝒰_P₁.ι_glueMorphisms g_chart hCompat false
      change η_P₁ ≫ g = η_F
      rw [← hξ_chart_ι false, CategoryTheory.Category.assoc, h_glue_f, hξ_chart_g false]

  constructor
  · rintro ⟨isoP1, hp⟩
    let j₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω)) ⟶ E := ι₀ ≫ isoP1.inv
    have hj₀_open : AlgebraicGeometry.IsOpenImmersion j₀ := by
      have : AlgebraicGeometry.IsOpenImmersion ι₀ := hOpen₀
      infer_instance
    have hj₀_hom : j₀ ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      dsimp [j₀]
      rw [hp, CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc isoP1.inv,
        isoP1.inv_hom_id, CategoryTheory.Category.id_comp, hHom₀]
    exact h_s1 j₀ hj₀_open hj₀_hom
  · rintro ⟨e_F, he_F⟩
    have _ : AlgebraicGeometry.IsIntegral E := hIntE
    have _ : AlgebraicGeometry.IsProper p_E := hPropE
    have _ : AlgebraicGeometry.IsReduced P₁ := hRedP₁
    have _ : P₁.IsSeparated := hSepP₁
    have hDomF : AlgebraicGeometry.IsDominant η_F := by
      rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
      ext x
      simp only [Set.mem_univ, iff_true, mem_closure_iff]
      intro O hO hxO
      obtain ⟨U₀, hAffU₀_mem, hxU₀, hU₀_le⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (AlgebraicGeometry.Scheme.isBasis_affineOpens E))
          (show x ∈ (⟨O, hO⟩ : E.Opens) from hxO)
      have hAffU₀ : AlgebraicGeometry.IsAffineOpen U₀ := hAffU₀_mem
      obtain ⟨φ₀, _, hSpec₀⟩ := hFuncF U₀ hAffU₀ ⟨⟨x, hxU₀⟩⟩
      let pt : PrimeSpectrum F := ⟨⊥, inferInstance⟩
      have h_mem_U₀ : η_F.base pt ∈ (U₀ : Set E) := by
        rw [← hAffU₀.range_fromSpec, ← hSpec₀]
        exact ⟨(AlgebraicGeometry.Spec.map φ₀).base pt, rfl⟩
      exact ⟨η_F.base pt, hU₀_le h_mem_U₀, pt, rfl⟩
    let α₀ : Polynomial Ω →+* FractionRing (Polynomial Ω) :=
      algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω))
    let η_P₁ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P₁ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_F.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀) ≫ ι₀
    have hDom_P₁ : AlgebraicGeometry.IsDominant η_P₁ := by
      rw [AlgebraicGeometry.isDominant_iff]
      have hSurj_e : Function.Surjective
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_F.symm.toRingHom)).base := by
        intro pt
        refine ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_F.toRingHom)).base pt, ?_⟩
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_F.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_F.symm.toRingHom)).base pt = pt
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h_id : e_F.toRingHom.comp e_F.symm.toRingHom = RingHom.id _ :=
          RingHom.ext e_F.apply_symm_apply
        rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        rfl
      have hDense₀ : DenseRange
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀) ≫ ι₀).base :=
        (AlgebraicGeometry.isDominant_iff _).mp hDom₀
      exact hDense₀.comp hSurj_e.denseRange (by continuity)
    have hPoles : ∀ x : E,
        ∃ (W : E.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
          (φ : E.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
          x ∈ W ∧
          AlgebraicGeometry.Spec.map φ ≫ hW.fromSpec = η_F ∧
          (e_F.symm (α₀ Polynomial.X) ∈ Set.range φ.hom ∨
            (e_F.symm (α₀ Polynomial.X))⁻¹ ∈ Set.range φ.hom) := by
      intro x
      obtain ⟨W, hW, φ, hxW, _, hSpec, hP⟩ := h_s2 (e_F.symm (α₀ Polynomial.X)) x
      exact ⟨W, hW, φ, hxW, hSpec, hP⟩
    obtain ⟨f, hf_p, hf_η⟩ := h_s3 hDomF e_F he_F hPoles
    obtain ⟨g, hg_p, hg_η⟩ := h_s5 e_F he_F hDom_P₁
    have hfg : f ≫ g = 𝟙 E := by
      refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated p_E ?_ η_F ?_
      · rw [CategoryTheory.Category.assoc, hg_p, hf_p, CategoryTheory.Category.id_comp]
      · rw [← CategoryTheory.Category.assoc, hf_η, hg_η, CategoryTheory.Category.comp_id]
    have hgf : g ≫ f = 𝟙 P₁ := by
      refine AlgebraicGeometry.ext_of_isDominant η_P₁ ?_
      rw [← CategoryTheory.Category.assoc, hg_η, hf_η, CategoryTheory.Category.comp_id]
    exact ⟨{ hom := f, inv := g, hom_inv_id := hfg, inv_hom_id := hgf }, hf_p.symm⟩

theorem weil_nullstellensatz_mvPolynomial_system_descent (B : Type u) [CommRing B] [IsDomain B]
    (K_bar : Type u) [Field K_bar] [IsAlgClosed K_bar]
    (ι_B : B →+* K_bar) (hInj : Function.Injective ι_B)
    {σ : Type} [Finite σ] (S : Finset (MvPolynomial σ B))
    (hUnsat : ¬ ∃ x : σ → K_bar, ∀ f ∈ S, MvPolynomial.eval₂ ι_B x f = 0) :
    ∃ b : B, b ≠ 0 ∧
      ∀ (Ω : Type u) [CommRing Ω] (φ : B →+* Ω),
        φ b ≠ 0 →
        ¬ ∃ y : σ → Ω, ∀ f ∈ S, MvPolynomial.eval₂ φ y f = 0 :=
by
  let K : Type u := FractionRing B
  have hUnit : ∀ y : nonZeroDivisors B, IsUnit (ι_B y) := by
    intro y
    apply Ne.isUnit
    intro h0
    apply mem_nonZeroDivisors_iff_ne_zero.mp y.2
    exact hInj (h0.trans (map_zero ι_B).symm)
  let j : K →+* K_bar := IsLocalization.lift (M := nonZeroDivisors B) (S := K) hUnit
  have hj_comp : j.comp (algebraMap B K) = ι_B := by
    ext r
    exact IsLocalization.lift_eq (M := nonZeroDivisors B) (S := K) hUnit r
  let _ : Algebra K K_bar := j.toAlgebra
  have halg_comp : (algebraMap K K_bar).comp (algebraMap B K) = ι_B := hj_comp
  let _ : Algebra (MvPolynomial σ B) (MvPolynomial σ K) := MvPolynomial.algebraMvPolynomial
  let I_B : Ideal (MvPolynomial σ B) := Ideal.span (↑S : Set (MvPolynomial σ B))
  let I_K : Ideal (MvPolynomial σ K) :=
    Ideal.map (algebraMap (MvPolynomial σ B) (MvPolynomial σ K)) I_B
  have hZeroEmpty : MvPolynomial.zeroLocus K_bar I_K = (∅ : Set (σ → K_bar)) := by
    rw [Set.eq_empty_iff_forall_notMem]
    intro x hx
    apply hUnsat
    refine ⟨x, fun f hf => ?_⟩
    have hf_IB : f ∈ I_B := Ideal.subset_span (Finset.mem_coe.mpr hf)
    have hf_IK : (algebraMap (MvPolynomial σ B) (MvPolynomial σ K)) f ∈ I_K :=
      Ideal.mem_map_of_mem _ hf_IB
    have h_aeval : (MvPolynomial.aeval x) ((algebraMap (MvPolynomial σ B) (MvPolynomial σ K)) f) = 0 :=
      (MvPolynomial.mem_zeroLocus_iff.mp hx) _ hf_IK
    rw [MvPolynomial.algebraMap_def, MvPolynomial.aeval_def, MvPolynomial.eval₂_map, halg_comp] at h_aeval
    exact h_aeval
  have hRadTop : I_K.radical = ⊤ := by
    rw [← @MvPolynomial.vanishingIdeal_zeroLocus_eq_radical K K_bar _ _ _ σ _ _ I_K, hZeroEmpty]
    exact @MvPolynomial.vanishingIdeal_empty K K_bar _ _ _ σ
  have hIK_top : I_K = ⊤ := Ideal.radical_eq_top.mp hRadTop
  have hOne_IK : (algebraMap (MvPolynomial σ B) (MvPolynomial σ K)) 1 ∈ I_K := by
    rw [hIK_top]
    exact Submodule.mem_top
  let M_B : Submonoid (MvPolynomial σ B) := Submonoid.map MvPolynomial.C (nonZeroDivisors B)
  have _ : IsLocalization M_B (MvPolynomial σ K) :=
    MvPolynomial.isLocalization (nonZeroDivisors B) K
  obtain ⟨m, hm, hm_mem⟩ :=
    (@IsLocalization.algebraMap_mem_map_algebraMap_iff (MvPolynomial σ B) _ M_B (MvPolynomial σ K) _ _ _ I_B 1).mp
      hOne_IK
  obtain ⟨b, hb_nzd, hb_eq⟩ := Submonoid.mem_map.mp hm
  have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_nzd
  have hCb_mem : (MvPolynomial.C b : MvPolynomial σ B) ∈ I_B := by
    rw [hb_eq]
    simpa only [mul_one] using hm_mem
  refine ⟨b, hb_ne, ?_⟩
  intro Ω _ φ hφb ⟨y, hy⟩
  let ψ : MvPolynomial σ B →+* Ω := MvPolynomial.eval₂Hom φ y
  have hSpanLe : I_B ≤ RingHom.ker ψ := by
    refine Ideal.span_le.mpr fun f hf => ?_
    rw [SetLike.mem_coe, RingHom.mem_ker, MvPolynomial.coe_eval₂Hom]
    exact hy f (Finset.mem_coe.mp hf)
  have hCb_ker : (MvPolynomial.C b : MvPolynomial σ B) ∈ RingHom.ker ψ := hSpanLe hCb_mem
  rw [RingHom.mem_ker] at hCb_ker
  have hφb_zero : φ b = 0 := by
    simpa only [ψ, MvPolynomial.eval₂Hom_C] using hCb_ker
  exact hφb hφb_zero

theorem weil_monic_bivariate_reducible_iff_bounded_monic_factors (L : Type u) [Field L]
    (Q : Polynomial (Polynomial L)) (hMon : Q.Monic) (hDeg : 1 ≤ Q.natDegree)
    (M : ℕ) (hCoeff : ∀ k < Q.natDegree, (Q.coeff k).natDegree ≤ M) :
    (Irreducible Q →
      IsDomain (Polynomial (Polynomial L) ⧸
        Ideal.span ({Q} : Set (Polynomial (Polynomial L))))) ∧
    (¬ Irreducible Q ↔
      ∃ (d₁ : ℕ), (1 ≤ d₁ ∧ d₁ < Q.natDegree) ∧
        ∃ (F G : Polynomial (Polynomial L)),
          F.Monic ∧ F.natDegree = d₁ ∧ (∀ i < d₁, (F.coeff i).natDegree ≤ M) ∧
          G.Monic ∧ G.natDegree = Q.natDegree - d₁ ∧
          (∀ j < Q.natDegree - d₁, (G.coeff j).natDegree ≤ M) ∧
          F * G = Q) :=
by
  have hQ_ne : Q ≠ 0 := hMon.ne_zero
  have hQ_nu : ¬ IsUnit Q := by
    intro hU
    have h0 : Q.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hU
    omega
  have hQ_all : ∀ k : ℕ, (Q.coeff k).natDegree ≤ M := by
    intro k
    rcases lt_trichotomy k Q.natDegree with hk_lt | rfl | hk_gt
    · exact hCoeff k hk_lt
    · rw [Polynomial.coeff_natDegree, hMon.leadingCoeff, Polynomial.natDegree_one]
      exact Nat.zero_le M
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hk_gt, Polynomial.natDegree_zero]
      exact Nat.zero_le M
  refine ⟨?_, ?_⟩
  · intro hIrr
    have hPrime : Prime Q := UniqueFactorizationMonoid.irreducible_iff_prime.mp hIrr
    have hIdealPrime : (Ideal.span ({Q} : Set (Polynomial (Polynomial L)))).IsPrime :=
      (Ideal.span_singleton_prime hQ_ne).mpr hPrime
    exact (Ideal.Quotient.isDomain_iff_prime _).mpr hIdealPrime
  · constructor
    · intro hNotIrr
      have hEx :
          ∃ F₀ G₀ : Polynomial (Polynomial L), Q = F₀ * G₀ ∧ ¬ IsUnit F₀ ∧ ¬ IsUnit G₀ := by
        by_contra hNo
        apply hNotIrr (irreducible_iff.mpr ⟨hQ_nu, ?_⟩)
        intro a b hab
        by_contra hNotOr
        exact hNo ⟨a, b, hab, fun ha => hNotOr (Or.inl ha), fun hb => hNotOr (Or.inr hb)⟩
      rcases hEx with ⟨F₀, G₀, hQ_eq, hF₀_nu, hG₀_nu⟩
      have hFG₀ : F₀ * G₀ = Q := hQ_eq.symm
      let u₀ : Polynomial L := F₀.leadingCoeff
      let v₀ : Polynomial L := G₀.leadingCoeff
      have hu₀v₀ : u₀ * v₀ = 1 := by
        calc
          u₀ * v₀ = (F₀ * G₀).leadingCoeff := (Polynomial.leadingCoeff_mul F₀ G₀).symm
          _ = Q.leadingCoeff := by rw [hFG₀]
          _ = 1 := hMon.leadingCoeff
      have hv₀u₀ : v₀ * u₀ = 1 := by rw [mul_comm, hu₀v₀]
      let F : Polynomial (Polynomial L) := Polynomial.C v₀ * F₀
      let G : Polynomial (Polynomial L) := Polynomial.C u₀ * G₀
      have hFG : F * G = Q := by
        calc
          F * G = (Polynomial.C v₀ * Polynomial.C u₀) * (F₀ * G₀) := by ring
          _ = Polynomial.C (v₀ * u₀) * Q := by rw [← Polynomial.C_mul, hFG₀]
          _ = Q := by rw [hv₀u₀, Polynomial.C_1, one_mul]
      have hF_mon : F.Monic := by
        rw [Polynomial.Monic.def, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C]
        exact hv₀u₀
      have hG_mon : G.Monic := by
        rw [Polynomial.Monic.def, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C]
        exact hu₀v₀
      have hCu₀_unit : IsUnit (Polynomial.C u₀ : Polynomial (Polynomial L)) :=
        IsUnit.of_mul_eq_one (Polynomial.C v₀) (by rw [← Polynomial.C_mul, hu₀v₀, Polynomial.C_1])
      have hCv₀_unit : IsUnit (Polynomial.C v₀ : Polynomial (Polynomial L)) :=
        IsUnit.of_mul_eq_one (Polynomial.C u₀) (by rw [← Polynomial.C_mul, hv₀u₀, Polynomial.C_1])
      have hF_nu : ¬ IsUnit F := by
        intro hUF
        apply hF₀_nu
        have hEq : Polynomial.C u₀ * F = F₀ := by
          calc
            Polynomial.C u₀ * (Polynomial.C v₀ * F₀)
              = (Polynomial.C u₀ * Polynomial.C v₀) * F₀ := (mul_assoc _ _ _).symm
            _ = Polynomial.C (u₀ * v₀) * F₀ := by rw [← Polynomial.C_mul]
            _ = F₀ := by rw [hu₀v₀, Polynomial.C_1, one_mul]
        rw [← hEq]
        exact hCu₀_unit.mul hUF
      have hG_nu : ¬ IsUnit G := by
        intro hUG
        apply hG₀_nu
        have hEq : Polynomial.C v₀ * G = G₀ := by
          calc
            Polynomial.C v₀ * (Polynomial.C u₀ * G₀)
              = (Polynomial.C v₀ * Polynomial.C u₀) * G₀ := (mul_assoc _ _ _).symm
            _ = Polynomial.C (v₀ * u₀) * G₀ := by rw [← Polynomial.C_mul]
            _ = G₀ := by rw [hv₀u₀, Polynomial.C_1, one_mul]
        rw [← hEq]
        exact hCv₀_unit.mul hUG
      let d₁ : ℕ := F.natDegree
      have hd₁_pos : 0 < d₁ := hF_mon.natDegree_pos_of_not_isUnit hF_nu
      have hG_pos : 0 < G.natDegree := hG_mon.natDegree_pos_of_not_isUnit hG_nu
      have hDeg_add : d₁ + G.natDegree = Q.natDegree := by
        calc
          d₁ + G.natDegree = (F * G).natDegree := (hF_mon.natDegree_mul hG_mon).symm
          _ = Q.natDegree := by rw [hFG]
      let a : ℕ := F.support.sup (fun i => (F.coeff i).natDegree)
      let b : ℕ := G.support.sup (fun j => (G.coeff j).natDegree)
      have hFa : ∀ i : ℕ, (F.coeff i).natDegree ≤ a := by
        intro i
        by_cases hi : F.coeff i = 0
        · rw [hi, Polynomial.natDegree_zero]
          exact Nat.zero_le a
        · exact Finset.le_sup (f := fun k => (F.coeff k).natDegree) (Polynomial.mem_support_iff.mpr hi)
      have hGb : ∀ j : ℕ, (G.coeff j).natDegree ≤ b := by
        intro j
        by_cases hj : G.coeff j = 0
        · rw [hj, Polynomial.natDegree_zero]
          exact Nat.zero_le b
        · exact Finset.le_sup (f := fun k => (G.coeff k).natDegree) (Polynomial.mem_support_iff.mpr hj)
      have hab_le : a + b ≤ M := by
        by_cases hab0 : a + b = 0
        · rw [hab0]
          exact Nat.zero_le M
        · obtain ⟨i₁, hi₁_mem, hi₁_eq⟩ :=
            Finset.exists_mem_eq_sup F.support (Polynomial.support_nonempty.mpr hF_mon.ne_zero)
              (fun i => (F.coeff i).natDegree)
          obtain ⟨j₁, hj₁_mem, hj₁_eq⟩ :=
            Finset.exists_mem_eq_sup G.support (Polynomial.support_nonempty.mpr hG_mon.ne_zero)
              (fun j => (G.coeff j).natDegree)
          let S_F : Finset ℕ := F.support.filter (fun i => (F.coeff i).natDegree = a)
          let S_G : Finset ℕ := G.support.filter (fun j => (G.coeff j).natDegree = b)
          have hSF_ne : S_F.Nonempty := ⟨i₁, Finset.mem_filter.mpr ⟨hi₁_mem, hi₁_eq.symm⟩⟩
          have hSG_ne : S_G.Nonempty := ⟨j₁, Finset.mem_filter.mpr ⟨hj₁_mem, hj₁_eq.symm⟩⟩
          let i₀ : ℕ := S_F.min' hSF_ne
          let j₀ : ℕ := S_G.min' hSG_ne
          obtain ⟨hi₀_supp, hi₀_deg⟩ := Finset.mem_filter.mp (Finset.min'_mem S_F hSF_ne)
          obtain ⟨hj₀_supp, hj₀_deg⟩ := Finset.mem_filter.mp (Finset.min'_mem S_G hSG_ne)
          have hFi₀_ne : F.coeff i₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀_supp
          have hGj₀_ne : G.coeff j₀ ≠ 0 := Polynomial.mem_support_iff.mp hj₀_supp
          have hFi_lt : ∀ i < i₀, F.coeff i ≠ 0 → (F.coeff i).natDegree < a := by
            intro i hi_lt hFi_ne
            have h_le : (F.coeff i).natDegree ≤ a := hFa i
            have h_ne : (F.coeff i).natDegree ≠ a := by
              intro hEq
              have hi_mem : i ∈ S_F :=
                Finset.mem_filter.mpr ⟨Polynomial.mem_support_iff.mpr hFi_ne, hEq⟩
              have hmin : i₀ ≤ i := Finset.min'_le S_F i hi_mem
              omega
            omega
          have hGj_lt : ∀ j < j₀, G.coeff j ≠ 0 → (G.coeff j).natDegree < b := by
            intro j hj_lt hGj_ne
            have h_le : (G.coeff j).natDegree ≤ b := hGb j
            have h_ne : (G.coeff j).natDegree ≠ b := by
              intro hEq
              have hj_mem : j ∈ S_G :=
                Finset.mem_filter.mpr ⟨Polynomial.mem_support_iff.mpr hGj_ne, hEq⟩
              have hmin : j₀ ≤ j := Finset.min'_le S_G j hj_mem
              omega
            omega
          have hCoeff_sum :
              (Q.coeff (i₀ + j₀)).coeff (a + b) =
                (F.coeff i₀ * G.coeff j₀).coeff (a + b) := by
            rw [← hFG, Polynomial.coeff_mul, Polynomial.finsetSum_coeff]
            refine Finset.sum_eq_single (i₀, j₀) ?_ ?_
            · intro x hx_mem hx_ne
              have hx_add : x.1 + x.2 = i₀ + j₀ :=
                Finset.HasAntidiagonal.mem_antidiagonal.mp hx_mem
              have hx_not_both : ¬ (x.1 = i₀ ∧ x.2 = j₀) := by
                rintro ⟨h1, h2⟩
                exact hx_ne (Prod.ext h1 h2)
              have hDeg_lt : (F.coeff x.1 * G.coeff x.2).natDegree < a + b := by
                by_cases hFx : F.coeff x.1 = 0
                · rw [hFx, zero_mul, Polynomial.natDegree_zero]
                  omega
                · by_cases hGx : G.coeff x.2 = 0
                  · rw [hGx, mul_zero, Polynomial.natDegree_zero]
                    omega
                  · rw [Polynomial.natDegree_mul hFx hGx]
                    have hx_lt : x.1 < i₀ ∨ x.2 < j₀ := by omega
                    rcases hx_lt with h1 | h2
                    · have := hFi_lt x.1 h1 hFx
                      have := hGb x.2
                      omega
                    · have := hFa x.1
                      have := hGj_lt x.2 h2 hGx
                      omega
              exact Polynomial.coeff_eq_zero_of_natDegree_lt hDeg_lt
            · intro hNotMem
              exact False.elim (hNotMem (Finset.HasAntidiagonal.mem_antidiagonal.mpr rfl))
          have hProd_ne : F.coeff i₀ * G.coeff j₀ ≠ 0 := mul_ne_zero hFi₀_ne hGj₀_ne
          have hProd_deg : (F.coeff i₀ * G.coeff j₀).natDegree = a + b := by
            rw [Polynomial.natDegree_mul hFi₀_ne hGj₀_ne, hi₀_deg, hj₀_deg]
          have hDiag_ne : (F.coeff i₀ * G.coeff j₀).coeff (a + b) ≠ 0 := by
            rw [← hProd_deg, Polynomial.coeff_natDegree]
            exact Polynomial.leadingCoeff_ne_zero.mpr hProd_ne
          have hQ_coeff_ne : (Q.coeff (i₀ + j₀)).coeff (a + b) ≠ 0 := by
            rw [hCoeff_sum]
            exact hDiag_ne
          exact (Polynomial.le_natDegree_of_ne_zero hQ_coeff_ne).trans (hQ_all (i₀ + j₀))
      refine ⟨d₁, ⟨by omega, by omega⟩, F, G,
        hF_mon, rfl, ?_, hG_mon, by omega, ?_, hFG⟩
      · intro i _
        exact (hFa i).trans (by omega)
      · intro j _
        exact (hGb j).trans (by omega)
    · rintro ⟨d₁, ⟨hd₁_lo, hd₁_hi⟩, F, G, _hF_mon, hF_deg, _hF_c, _hG_mon, hG_deg, _hG_c, hFG⟩ hIrr
      have hF_nu : ¬ IsUnit F := by
        intro hUF
        have := Polynomial.natDegree_eq_zero_of_isUnit hUF
        omega
      have hG_nu : ¬ IsUnit G := by
        intro hUG
        have := Polynomial.natDegree_eq_zero_of_isUnit hUG
        omega
      rcases hIrr.isUnit_or_isUnit hFG.symm with hUF | hUG
      · exact hF_nu hUF
      · exact hG_nu hUG

theorem weil_monic_bivariate_rational_funcField_iff_bounded_polys (L : Type u) [Field L]
    (Q : Polynomial (Polynomial L)) (hMon : Q.Monic) (hDeg : 1 ≤ Q.natDegree)
    (hIrr : Irreducible Q)
    (M : ℕ) (hM : 1 ≤ M) (hCoeff : ∀ k < Q.natDegree, (Q.coeff k).natDegree ≤ M) :
    let d : ℕ := Q.natDegree
    let K_max : ℕ := M * d ^ 2 + 2
    ((∃ (e_L : FractionRing (Polynomial (Polynomial L) ⧸
          Ideal.span ({Q} : Set (Polynomial (Polynomial L)))) ≃+*
          FractionRing (Polynomial L)),
        ∀ c : L,
          e_L (Localization.mk (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) =
            Localization.mk (Polynomial.C c) 1) ↔
     ∃ (A₁ B₁ F₂ : Polynomial L) (C : Fin d → Polynomial L) (H : Polynomial L),
       A₁.natDegree ≤ d ∧
       B₁.natDegree ≤ d ∧
       F₂.natDegree ≤ M * d ∧
       (∀ j : Fin d, (C j).natDegree ≤ K_max) ∧
       H.natDegree ≤ K_max ∧
       B₁ * (∑ k ∈ Finset.range (K_max + 1),
         Polynomial.C (H.coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) ≠ 0 ∧
       F₂ ^ d + (∑ j ∈ Finset.range d,
         B₁ ^ (M * (d - 1 - j)) *
           (∑ k ∈ Finset.range (M + 1),
             Polynomial.C ((Q.coeff j).coeff k) * A₁ ^ k * B₁ ^ (M - k)) * F₂ ^ j) = 0 ∧
       (∑ j : Fin d,
         B₁ ^ (M * (d - 1 - j.1)) *
           (∑ k ∈ Finset.range (K_max + 1),
             Polynomial.C ((C j).coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) * F₂ ^ j.1) -
         Polynomial.X * B₁ ^ (M * (d - 1)) *
           (∑ k ∈ Finset.range (K_max + 1),
             Polynomial.C (H.coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) = 0) :=
by
  intro d K_max

  have hQ_decomp :
      Q = Polynomial.X ^ Q.natDegree +
        ∑ j ∈ Finset.range Q.natDegree, Polynomial.C (Q.coeff j) * Polynomial.X ^ j := by
    have h1 := Polynomial.as_sum_range_C_mul_X_pow' Q (Nat.lt_succ_self Q.natDegree)
    rw [Finset.sum_range_succ, show Q.coeff Q.natDegree = 1 from hMon.leadingCoeff,
      map_one, one_mul, add_comm] at h1
    exact h1

  have hSumDegLe : ∀ {α : Type} (s : Finset α) (f : α → Polynomial L) (N : ℕ),
      (∀ a ∈ s, (f a).natDegree ≤ N) → (∑ a ∈ s, f a).natDegree ≤ N := by
    intro α s f N hf
    rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
    intro m hm
    rw [Polynomial.finsetSum_coeff]
    exact Finset.sum_eq_zero fun a ha =>
      Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt (hf a ha) hm)

  have hTermDegLe : ∀ {A B : Polynomial L} {D_AB : ℕ},
      A.natDegree ≤ D_AB → B.natDegree ≤ D_AB →
      ∀ (N k : ℕ), k ≤ N → ∀ (c : L),
        (Polynomial.C c * A ^ k * B ^ (N - k)).natDegree ≤ N * D_AB := by
    intro A B D_AB hA hB N k hk c
    calc
      (Polynomial.C c * A ^ k * B ^ (N - k)).natDegree
        ≤ (Polynomial.C c * A ^ k).natDegree + (B ^ (N - k)).natDegree :=
          Polynomial.natDegree_mul_le
      _ ≤ (A ^ k).natDegree + (B ^ (N - k)).natDegree :=
          Nat.add_le_add_right (Polynomial.natDegree_C_mul_le _ _) _
      _ ≤ k * A.natDegree + (N - k) * B.natDegree :=
          Nat.add_le_add Polynomial.natDegree_pow_le Polynomial.natDegree_pow_le
      _ ≤ k * D_AB + (N - k) * D_AB :=
          Nat.add_le_add (Nat.mul_le_mul_left k hA) (Nat.mul_le_mul_left (N - k) hB)
      _ = N * D_AB := by rw [← Nat.add_mul, Nat.add_sub_of_le hk]

  have hHomogEval : ∀ (w : FractionRing (Polynomial L)) (A B : Polynomial L),
      algebraMap (Polynomial L) (FractionRing (Polynomial L)) B * w =
        algebraMap (Polynomial L) (FractionRing (Polynomial L)) A →
      ∀ (N : ℕ) (p : Polynomial L), p.natDegree ≤ N →
        algebraMap (Polynomial L) (FractionRing (Polynomial L))
          (∑ k ∈ Finset.range (N + 1), Polynomial.C (p.coeff k) * A ^ k * B ^ (N - k)) =
          (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B) ^ N *
            Polynomial.eval₂
              ((algebraMap (Polynomial L) (FractionRing (Polynomial L))).comp Polynomial.C) w p := by
    intro w A B hBw N p hp
    have hp_eq := Polynomial.as_sum_range_C_mul_X_pow' p (Nat.lt_succ_of_le hp)
    conv_rhs => rw [hp_eq]
    rw [Polynomial.eval₂_finsetSum, Finset.mul_sum, map_sum]
    refine Finset.sum_congr rfl fun k hk => ?_
    have hk_le : k ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
    have hN_split : N = k + (N - k) := (Nat.add_sub_of_le hk_le).symm
    simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow,
      RingHom.comp_apply, map_mul, map_pow]
    conv_rhs => rw [hN_split, pow_add]
    calc
      algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Polynomial.C (p.coeff k)) *
          algebraMap (Polynomial L) (FractionRing (Polynomial L)) A ^ k *
          algebraMap (Polynomial L) (FractionRing (Polynomial L)) B ^ (N - k)
        = algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Polynomial.C (p.coeff k)) *
            (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B * w) ^ k *
            algebraMap (Polynomial L) (FractionRing (Polynomial L)) B ^ (N - k) := by rw [hBw]
      _ = (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B ^ k *
            algebraMap (Polynomial L) (FractionRing (Polynomial L)) B ^ (N - k)) *
            (algebraMap (Polynomial L) (FractionRing (Polynomial L))
              (Polynomial.C (p.coeff k)) * w ^ k) := by
          rw [mul_pow]; ring

  have hIrr_Qu :
      Irreducible (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))) :=
    (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map hMon).mp hIrr

  have hArField :
      ((1 : AdjoinRoot (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))))) ≠ 0) ∧
      (∀ x y : AdjoinRoot (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))),
        x * y = 0 → x = 0 ∨ y = 0) ∧
      ∃ inv_ar : AdjoinRoot (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))) →
          AdjoinRoot (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))),
        inv_ar 1 = 1 ∧
        (∀ x y, inv_ar (x * y) = inv_ar x * inv_ar y) ∧
        (∀ x, x ≠ 0 → x * inv_ar x = 1) := by
    have : Fact (Irreducible (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))))) :=
      ⟨hIrr_Qu⟩
    refine ⟨one_ne_zero, fun x y => mul_eq_zero.mp, Inv.inv, inv_one, ?_,
      fun x hx => mul_inv_cancel₀ hx⟩
    intro x y
    by_cases hx : x = 0
    · subst hx; simp
    · by_cases hy : y = 0
      · subst hy; simp
      · apply mul_left_cancel₀ (mul_ne_zero hx hy)
        rw [mul_inv_cancel₀ (mul_ne_zero hx hy)]
        calc
          1 = (x * x⁻¹) * (y * y⁻¹) := by rw [mul_inv_cancel₀ hx, mul_inv_cancel₀ hy, mul_one]
          _ = (x * y) * (x⁻¹ * y⁻¹) := by ring
  obtain ⟨h1_ne_0_ar, hmul_zero_ar, inv_ar, hinv_1, hinv_mul, hinv_cancel⟩ := hArField

  
  have hStep1 :
      ∃ (θ : FractionRing (Polynomial (Polynomial L) ⧸
            Ideal.span ({Q} : Set (Polynomial (Polynomial L)))) ≃+*
          AdjoinRoot (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))))),
        ∀ c : L,
          θ (Localization.mk (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) =
            AdjoinRoot.of _
              (algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Polynomial.C c)) := by
    have hι_inj :
        Function.Injective (algebraMap (Polynomial L) (FractionRing (Polynomial L))) :=
      IsFractionRing.injective (Polynomial L) (FractionRing (Polynomial L))
    have hQu_deg :
        (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))).natDegree =
          Q.natDegree :=
      hMon.natDegree_map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))
    have hφ₀_ker :
        Ideal.span ({Q} : Set (Polynomial (Polynomial L))) ≤
          RingHom.ker ((AdjoinRoot.mk (Q.map (algebraMap (Polynomial L)
            (FractionRing (Polynomial L))))).comp
              (Polynomial.mapRingHom (algebraMap (Polynomial L) (FractionRing (Polynomial L))))) := by
      rw [Ideal.span_le]
      intro P hP
      rw [Set.mem_singleton_iff.mp hP]
      exact AdjoinRoot.mk_self
    obtain ⟨φ, hφ_def⟩ :
        ∃ φ : (Polynomial (Polynomial L) ⧸
            Ideal.span ({Q} : Set (Polynomial (Polynomial L)))) →+*
          AdjoinRoot (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))),
          ∀ P : Polynomial (Polynomial L),
            φ (Ideal.Quotient.mk _ P) =
              AdjoinRoot.mk _
                (P.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))) :=
      ⟨Ideal.Quotient.lift _ _ hφ₀_ker, fun _ => rfl⟩
    have hφ_inj : Function.Injective φ := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
      have hMod := Polynomial.modByMonic_add_div P Q
      have hπ_eq :
          Ideal.Quotient.mk (Ideal.span ({Q} : Set (Polynomial (Polynomial L)))) P =
            Ideal.Quotient.mk (Ideal.span ({Q} : Set (Polynomial (Polynomial L)))) (P %ₘ Q) := by
        rw [Ideal.Quotient.eq, Ideal.mem_span_singleton]
        refine ⟨P /ₘ Q, ?_⟩
        calc
          P - P %ₘ Q = (P %ₘ Q + Q * (P /ₘ Q)) - P %ₘ Q :=
            congrArg (· - P %ₘ Q) hMod.symm
          _ = Q * (P /ₘ Q) := add_sub_cancel_left _ _
      rw [hπ_eq] at hx ⊢
      rw [hφ_def] at hx
      have hdvd := AdjoinRoot.mk_eq_zero.mp hx
      have hRem_zero : P %ₘ Q = 0 := by
        by_contra hRem_ne
        have hRem_map_ne :
            (P %ₘ Q).map (algebraMap (Polynomial L) (FractionRing (Polynomial L))) ≠ 0 :=
          fun h0 => hRem_ne (Polynomial.map_injective _ hι_inj (by simpa using h0))
        have hdeg1 := Polynomial.natDegree_le_of_dvd hdvd hRem_map_ne
        have hdeg2 :
            ((P %ₘ Q).map
              (algebraMap (Polynomial L) (FractionRing (Polynomial L)))).natDegree ≤
              (P %ₘ Q).natDegree :=
          Polynomial.natDegree_map_le
        have hQ_ne_one : Q ≠ 1 := by
          intro h1
          rw [h1, Polynomial.natDegree_one] at hDeg
          omega
        have hdeg3 := Polynomial.natDegree_modByMonic_lt P hMon hQ_ne_one
        rw [hQu_deg] at hdeg1
        omega
      rw [hRem_zero, map_zero]
    have hφ_ne : ∀ y : nonZeroDivisors (Polynomial (Polynomial L) ⧸
        Ideal.span ({Q} : Set (Polynomial (Polynomial L)))), φ y.1 ≠ 0 := by
      intro y hy0
      have hy_zero : y.1 = 0 := hφ_inj (by rw [hy0, map_zero])
      have h10 : (1 : Polynomial (Polynomial L) ⧸
          Ideal.span ({Q} : Set (Polynomial (Polynomial L)))) = 0 :=
        (mem_nonZeroDivisors_iff.mp y.2).2 1 ((one_mul y.1).trans hy_zero)
      apply h1_ne_0_ar
      rw [← map_one φ, h10, map_zero]
    have hφ_wd : ∀ {a c : Polynomial (Polynomial L) ⧸
        Ideal.span ({Q} : Set (Polynomial (Polynomial L)))}
        {b d_s : nonZeroDivisors (Polynomial (Polynomial L) ⧸
          Ideal.span ({Q} : Set (Polynomial (Polynomial L))))},
        Localization.r _ (a, b) (c, d_s) →
          φ a * inv_ar (φ b.1) = φ c * inv_ar (φ d_s.1) := by
      intro a c b d_s hr
      obtain ⟨u, hu⟩ := Localization.r_iff_exists.mp hr
      have hmul := congrArg φ hu
      simp only [map_mul] at hmul
      have hbd : φ d_s.1 * φ a = φ b.1 * φ c := by
        have hdiff : φ u.1 * (φ d_s.1 * φ a - φ b.1 * φ c) = 0 := by
          linear_combination hmul
        exact sub_eq_zero.mp ((hmul_zero_ar _ _ hdiff).resolve_left (hφ_ne u))
      calc
        φ a * inv_ar (φ b.1)
          = (φ a * inv_ar (φ b.1)) * (φ d_s.1 * inv_ar (φ d_s.1)) := by
              rw [hinv_cancel _ (hφ_ne d_s), mul_one]
        _ = (φ d_s.1 * φ a) * inv_ar (φ b.1) * inv_ar (φ d_s.1) := by ring
        _ = (φ b.1 * φ c) * inv_ar (φ b.1) * inv_ar (φ d_s.1) := by rw [hbd]
        _ = (φ c * inv_ar (φ d_s.1)) * (φ b.1 * inv_ar (φ b.1)) := by ring
        _ = φ c * inv_ar (φ d_s.1) := by rw [hinv_cancel _ (hφ_ne b), mul_one]
    have h0_mk : (0 : FractionRing (Polynomial (Polynomial L) ⧸
        Ideal.span ({Q} : Set (Polynomial (Polynomial L))))) =
      Localization.mk 0 1 := by
      rw [Localization.mk_one_eq_algebraMap, map_zero]
    obtain ⟨θ_hom, hθ_mk⟩ :
        ∃ θ_hom : FractionRing (Polynomial (Polynomial L) ⧸
            Ideal.span ({Q} : Set (Polynomial (Polynomial L)))) →+*
          AdjoinRoot (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))),
          ∀ x s, θ_hom (Localization.mk x s) = φ x * inv_ar (φ s.1) :=
      ⟨{ toFun := fun z => Localization.liftOn z (fun a b => φ a * inv_ar (φ b.1)) hφ_wd
         map_one' := by
           rw [← Localization.mk_one, Localization.liftOn_mk, Submonoid.coe_one,
             map_one, hinv_1, mul_one]
         map_mul' := fun x y => by
           refine Localization.ind (fun ab => Localization.ind (fun cd => ?_) y) x
           rw [Localization.mk_mul, Localization.liftOn_mk, Localization.liftOn_mk,
             Localization.liftOn_mk, Submonoid.coe_mul, map_mul, map_mul, hinv_mul]
           ring
         map_zero' := by
           rw [h0_mk, Localization.liftOn_mk, map_zero, zero_mul]
         map_add' := fun x y => by
           refine Localization.ind (fun ab => Localization.ind (fun cd => ?_) y) x
           rw [Localization.add_mk, Localization.liftOn_mk, Localization.liftOn_mk,
             Localization.liftOn_mk, Submonoid.coe_mul, map_add, map_mul, map_mul, map_mul,
             hinv_mul]
           calc
             (φ ab.2.1 * φ cd.1 + φ cd.2.1 * φ ab.1) *
                 (inv_ar (φ ab.2.1) * inv_ar (φ cd.2.1))
               = (φ ab.1 * inv_ar (φ ab.2.1)) * (φ cd.2.1 * inv_ar (φ cd.2.1)) +
                   (φ cd.1 * inv_ar (φ cd.2.1)) * (φ ab.2.1 * inv_ar (φ ab.2.1)) := by ring
             _ = φ ab.1 * inv_ar (φ ab.2.1) + φ cd.1 * inv_ar (φ cd.2.1) := by
                 rw [hinv_cancel _ (hφ_ne cd.2), hinv_cancel _ (hφ_ne ab.2),
                   mul_one, mul_one] },
       fun x s => Localization.liftOn_mk (fun a b => φ a * inv_ar (φ b.1)) hφ_wd x s⟩
    have hθ_mk1 : ∀ x, θ_hom (Localization.mk x 1) = φ x := by
      intro x
      rw [hθ_mk, Submonoid.coe_one, map_one, hinv_1, mul_one]
    have hθ_inj : Function.Injective θ_hom := by
      rw [injective_iff_map_eq_zero]
      intro z_q
      refine Localization.ind (fun ab => ?_) z_q
      intro h0
      rw [hθ_mk] at h0
      have hinv_ne : inv_ar (φ ab.2.1) ≠ 0 :=
        fun hi0 => h1_ne_0_ar (by rw [← hinv_cancel _ (hφ_ne ab.2), hi0, mul_zero])
      have ha0 : ab.1 = 0 :=
        hφ_inj (by rw [(hmul_zero_ar _ _ h0).resolve_right hinv_ne, map_zero])
      rw [h0_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_one, one_mul]
      exact ha0.trans (mul_zero ab.2.1).symm
    have hθ_surj : Function.Surjective θ_hom := by
      have h_of_K : ∀ u : FractionRing (Polynomial L),
          ∃ x, θ_hom x = AdjoinRoot.of _ u := by
        intro u
        obtain ⟨⟨a, s⟩, hs_eq⟩ := IsLocalization.surj (nonZeroDivisors (Polynomial L)) u
        have hs_ne : s.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
        have hιs_ne : algebraMap (Polynomial L) (FractionRing (Polynomial L)) s.1 ≠ 0 :=
          fun h0 => hs_ne (hι_inj (by rw [h0, map_zero]))
        have hof_s_ne :
            AdjoinRoot.of (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))))
              (algebraMap _ _ s.1) ≠ 0 := by
          intro h0
          apply h1_ne_0_ar
          rw [← map_one (AdjoinRoot.of _), ← mul_inv_cancel₀ hιs_ne, map_mul, h0, zero_mul]
        have hφ_Cs_ne : φ (Ideal.Quotient.mk _ (Polynomial.C s.1)) ≠ 0 := by
          rw [hφ_def, Polynomial.map_C, AdjoinRoot.mk_C]
          exact hof_s_ne
        have hs_nzd : Ideal.Quotient.mk (Ideal.span ({Q} : Set (Polynomial (Polynomial L))))
            (Polynomial.C s.1) ∈
            nonZeroDivisors (Polynomial (Polynomial L) ⧸
              Ideal.span ({Q} : Set (Polynomial (Polynomial L)))) := by
          rw [mem_nonZeroDivisors_iff]
          constructor <;> intro z_r hzr
          · have hmul0 : φ (Ideal.Quotient.mk _ (Polynomial.C s.1)) * φ z_r = 0 := by
              rw [← map_mul, hzr, map_zero]
            exact hφ_inj (by rw [(hmul_zero_ar _ _ hmul0).resolve_left hφ_Cs_ne, map_zero])
          · have hmul0 : φ z_r * φ (Ideal.Quotient.mk _ (Polynomial.C s.1)) = 0 := by
              rw [← map_mul, hzr, map_zero]
            exact hφ_inj (by rw [(hmul_zero_ar _ _ hmul0).resolve_right hφ_Cs_ne, map_zero])
        refine ⟨Localization.mk (Ideal.Quotient.mk _ (Polynomial.C a)) ⟨_, hs_nzd⟩, ?_⟩
        rw [hθ_mk, hφ_def, hφ_def, Polynomial.map_C, Polynomial.map_C,
          AdjoinRoot.mk_C, AdjoinRoot.mk_C, ← hs_eq, map_mul, mul_assoc,
          hinv_cancel _ hof_s_ne, mul_one]
      intro y
      obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective y
      choose x_c hx_c using fun k : ℕ => h_of_K (g.coeff k)
      let x_T : FractionRing (Polynomial (Polynomial L) ⧸
          Ideal.span ({Q} : Set (Polynomial (Polynomial L)))) :=
        Localization.mk (Ideal.Quotient.mk _ Polynomial.X) 1
      refine ⟨∑ k ∈ Finset.range (g.natDegree + 1), x_c k * x_T ^ k, ?_⟩
      conv_rhs => rw [Polynomial.as_sum_range_C_mul_X_pow' g (Nat.lt_succ_self _)]
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      dsimp [x_T]
      rw [map_mul, map_pow, hx_c k, hθ_mk1, hφ_def, Polynomial.map_X, AdjoinRoot.mk_X,
        map_mul, map_pow, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
    have hθ_const_hom : ∀ c : L,
        θ_hom (Localization.mk (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) =
          AdjoinRoot.of _
            (algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Polynomial.C c)) := by
      intro c
      rw [hθ_mk1, hφ_def, Polynomial.map_C, AdjoinRoot.mk_C]
    exact ⟨RingEquiv.ofBijective θ_hom ⟨hθ_inj, hθ_surj⟩, hθ_const_hom⟩

  obtain ⟨θ, hθ_const⟩ := hStep1

  
  have hStep2 :
      ∀ (e : AdjoinRoot (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))) ≃+*
          FractionRing (Polynomial L)),
        (∀ c : L,
          e (AdjoinRoot.of _
              (algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Polynomial.C c))) =
            algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Polynomial.C c)) →
        ∃ (A₁ B₁ F₂ : Polynomial L),
          A₁.natDegree ≤ d ∧
          B₁.natDegree ≤ d ∧
          F₂.natDegree ≤ M * d ∧
          B₁ ≠ 0 ∧
          F₂ ^ d + (∑ j ∈ Finset.range d,
            B₁ ^ (M * (d - 1 - j)) *
              (∑ k ∈ Finset.range (M + 1),
                Polynomial.C ((Q.coeff j).coeff k) * A₁ ^ k * B₁ ^ (M - k)) * F₂ ^ j) = 0 ∧
          (∀ (C : Fin d → Polynomial L),
            (∀ j : Fin d, (C j).natDegree ≤ K_max) →
            (∑ j : Fin d,
              B₁ ^ (M * (d - 1 - j.1)) *
                (∑ k ∈ Finset.range (K_max + 1),
                  Polynomial.C ((C j).coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) * F₂ ^ j.1) = 0 →
            ∀ j : Fin d, C j = 0) := by
    intro e he
    have hι_inj :
        Function.Injective (algebraMap (Polynomial L) (FractionRing (Polynomial L))) :=
      IsFractionRing.injective (Polynomial L) (FractionRing (Polynomial L))
    have hQu_mon : (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))).Monic :=
      hMon.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))
    have hQu_deg :
        (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))).natDegree = d :=
      hMon.natDegree_map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))
    have hQu_ne_zero :
        Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))) ≠ 0 :=
      hQu_mon.ne_zero

    obtain ⟨z, hz_def⟩ :
        ∃ z : FractionRing (Polynomial L),
          z = algebraMap (Polynomial L) (FractionRing (Polynomial L)) Polynomial.X := ⟨_, rfl⟩
    obtain ⟨w, hw_def⟩ :
        ∃ w : FractionRing (Polynomial L),
          w = e (AdjoinRoot.of _
            (algebraMap (Polynomial L) (FractionRing (Polynomial L)) Polynomial.X)) := ⟨_, rfl⟩
    obtain ⟨τ, hτ_def⟩ :
        ∃ τ : FractionRing (Polynomial L), τ = e (AdjoinRoot.root _) := ⟨_, rfl⟩
    obtain ⟨α_w, hα_eval⟩ :
        ∃ α_w : Polynomial L →+* FractionRing (Polynomial L),
          α_w = Polynomial.eval₂RingHom
            ((algebraMap (Polynomial L) (FractionRing (Polynomial L))).comp Polynomial.C) w :=
      ⟨_, rfl⟩

    have hα_eq : ∀ p : Polynomial L,
        α_w p = e (AdjoinRoot.of _
          (algebraMap (Polynomial L) (FractionRing (Polynomial L)) p)) := by
      have h_hom : α_w = e.toRingHom.comp ((AdjoinRoot.of _).comp
          (algebraMap (Polynomial L) (FractionRing (Polynomial L)))) := by
        rw [hα_eval]
        apply Polynomial.ringHom_ext'
        · ext c
          simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
            RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
          exact (he c).symm
        · simp only [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, RingHom.comp_apply,
            RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hw_def]
      intro p
      exact RingHom.congr_fun h_hom p
    have hα_inj : Function.Injective α_w := by
      have : Fact (Irreducible
          (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))))) := ⟨hIrr_Qu⟩
      intro p₁ p₂ hp
      rw [hα_eq, hα_eq] at hp
      exact hι_inj ((AdjoinRoot.of _).injective (e.injective hp))
    have hαX : α_w Polynomial.X = w := by
      rw [hα_eval]
      exact Polynomial.eval₂_X _ w
    have hw_ne : w ≠ 0 := by
      rw [← hαX]
      exact fun h0 => Polynomial.X_ne_zero (hα_inj (by rw [h0, map_zero]))
    have hHomog_w : ∀ (N : ℕ) (p : Polynomial L) {A B : Polynomial L},
        algebraMap (Polynomial L) (FractionRing (Polynomial L)) B * w =
          algebraMap (Polynomial L) (FractionRing (Polynomial L)) A →
        p.natDegree ≤ N →
        algebraMap (Polynomial L) (FractionRing (Polynomial L))
          (∑ k ∈ Finset.range (N + 1), Polynomial.C (p.coeff k) * A ^ k * B ^ (N - k)) =
          (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B) ^ N * α_w p := by
      intro N p A B hBw hp
      rw [hHomogEval w A B hBw N p hp, hα_eval]
      rfl

    obtain ⟨⟨A₀, B₀⟩, hB₀_eq⟩ := IsLocalization.surj (nonZeroDivisors (Polynomial L)) w
    have hB₀_ne : B₀.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp B₀.2
    letI : DecidableEq L := Classical.decEq L
    obtain ⟨g_ab, hg_def⟩ : ∃ g_ab : Polynomial L, g_ab = EuclideanDomain.gcd A₀ B₀.1 := ⟨_, rfl⟩
    obtain ⟨A₁, hA₀⟩ : ∃ A₁, A₀ = g_ab * A₁ := by
      rw [hg_def]; exact EuclideanDomain.gcd_dvd_left A₀ B₀.1
    obtain ⟨B₁, hB₀⟩ : ∃ B₁, B₀.1 = g_ab * B₁ := by
      rw [hg_def]; exact EuclideanDomain.gcd_dvd_right A₀ B₀.1
    have hg_ne : g_ab ≠ 0 := fun hg0 => hB₀_ne (by rw [hB₀, hg0, zero_mul])
    have hB₁_ne : B₁ ≠ 0 := fun hB10 => hB₀_ne (by rw [hB₀, hB10, mul_zero])
    have hιg_ne : algebraMap (Polynomial L) (FractionRing (Polynomial L)) g_ab ≠ 0 :=
      fun h0 => hg_ne (hι_inj (by rw [h0, map_zero]))
    have hBw :
        algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁ * w =
          algebraMap (Polynomial L) (FractionRing (Polynomial L)) A₁ := by
      apply mul_left_cancel₀ hιg_ne
      calc
        algebraMap _ _ g_ab * (algebraMap _ _ B₁ * w)
          = w * (algebraMap _ _ g_ab * algebraMap _ _ B₁) := by ring
        _ = w * algebraMap _ _ B₀.1 := by rw [← map_mul, ← hB₀]
        _ = algebraMap _ _ A₀ := hB₀_eq
        _ = algebraMap _ _ g_ab * algebraMap _ _ A₁ := by rw [hA₀, map_mul]
    have hCop : IsCoprime A₁ B₁ := by
      refine ⟨EuclideanDomain.gcdA A₀ B₀.1, EuclideanDomain.gcdB A₀ B₀.1, ?_⟩
      apply mul_left_cancel₀ hg_ne
      have hbez := EuclideanDomain.gcd_eq_gcd_ab A₀ B₀.1
      rw [← hg_def] at hbez
      calc
        g_ab * (EuclideanDomain.gcdA A₀ B₀.1 * A₁ + EuclideanDomain.gcdB A₀ B₀.1 * B₁)
          = (g_ab * A₁) * EuclideanDomain.gcdA A₀ B₀.1 +
              (g_ab * B₁) * EuclideanDomain.gcdB A₀ B₀.1 := by ring
        _ = A₀ * EuclideanDomain.gcdA A₀ B₀.1 + B₀.1 * EuclideanDomain.gcdB A₀ B₀.1 := by
              rw [← hA₀, ← hB₀]
        _ = g_ab * 1 := by rw [← hbez, mul_one]

    have hDep_poly :
        ∃ (q₀ : Fin (d + 1) → Polynomial L) (i_nz : Fin (d + 1)),
          q₀ i_nz ≠ 0 ∧ ∑ i : Fin (d + 1), α_w (q₀ i) * z ^ i.1 = 0 := by
      let pb := AdjoinRoot.powerBasis hQu_ne_zero
      have : Module.Finite (FractionRing (Polynomial L))
          (AdjoinRoot (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))))) :=
        pb.finite
      have hpb_dim : pb.dim = d := (AdjoinRoot.powerBasis_dim hQu_ne_zero).trans hQu_deg
      have hfinrank :
          Module.finrank (FractionRing (Polynomial L))
            (AdjoinRoot (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))))) = d :=
        pb.finrank.trans hpb_dim
      have hv_dep :
          ¬ LinearIndependent (FractionRing (Polynomial L))
              (fun i : Fin (d + 1) => e.symm (z ^ i.1)) := by
        intro hli
        have hcard := hli.fintype_card_le_finrank
        rw [Fintype.card_fin, hfinrank] at hcard
        omega
      obtain ⟨g_lin, hg_sum, i_nz, hgi_ne⟩ := Fintype.not_linearIndependent_iff.mp hv_dep
      have hsurj_g : ∀ i : Fin (d + 1),
          ∃ p : Polynomial L × nonZeroDivisors (Polynomial L),
            g_lin i * algebraMap _ _ p.2.1 = algebraMap _ _ p.1 :=
        fun i => IsLocalization.surj (nonZeroDivisors (Polynomial L)) (g_lin i)
      choose p_g hp_g using hsurj_g
      obtain ⟨D_all, hD_def⟩ :
          ∃ D_all : Polynomial L, D_all = ∏ j : Fin (d + 1), (p_g j).2.1 := ⟨_, rfl⟩
      obtain ⟨q₀, hq₀_def⟩ :
          ∃ q₀ : Fin (d + 1) → Polynomial L,
            q₀ = fun i => (p_g i).1 * ∏ j ∈ Finset.univ.erase i, (p_g j).2.1 := ⟨_, rfl⟩
      have hD_all_ne : D_all ≠ 0 := by
        rw [hD_def]
        exact Finset.prod_ne_zero_iff.mpr fun j _ =>
          mem_nonZeroDivisors_iff_ne_zero.mp (p_g j).2.2
      have hιD_ne : algebraMap (Polynomial L) (FractionRing (Polynomial L)) D_all ≠ 0 :=
        fun h0 => hD_all_ne (hι_inj (by rw [h0, map_zero]))
      have hq₀_eq : ∀ i : Fin (d + 1),
          algebraMap (Polynomial L) (FractionRing (Polynomial L)) (q₀ i) =
            g_lin i * algebraMap _ _ D_all := by
        intro i
        have hsplit : D_all = (p_g i).2.1 * ∏ j ∈ Finset.univ.erase i, (p_g j).2.1 := by
          rw [hD_def]
          exact (Finset.mul_prod_erase Finset.univ (fun j => (p_g j).2.1)
            (Finset.mem_univ i)).symm
        rw [hq₀_def]
        calc
          algebraMap _ _ ((p_g i).1 * ∏ j ∈ Finset.univ.erase i, (p_g j).2.1)
            = algebraMap _ _ (p_g i).1 *
                algebraMap _ _ (∏ j ∈ Finset.univ.erase i, (p_g j).2.1) := map_mul _ _ _
          _ = (g_lin i * algebraMap _ _ (p_g i).2.1) *
                algebraMap _ _ (∏ j ∈ Finset.univ.erase i, (p_g j).2.1) := by rw [hp_g i]
          _ = g_lin i * algebraMap _ _ D_all := by rw [hsplit, map_mul, mul_assoc]
      have hq₀_nz : q₀ i_nz ≠ 0 := by
        intro h0
        exact mul_ne_zero hgi_ne hιD_ne (by rw [← hq₀_eq i_nz, h0, map_zero])
      refine ⟨q₀, i_nz, hq₀_nz, ?_⟩
      have h1 : AdjoinRoot.of _ (algebraMap _ _ D_all) *
          (∑ i : Fin (d + 1), g_lin i • e.symm (z ^ i.1)) = 0 := by
        rw [hg_sum, mul_zero]
      have h2 := congrArg e h1
      rw [map_zero, Finset.mul_sum, map_sum] at h2
      refine Eq.trans (Finset.sum_congr rfl fun i _ => ?_) h2
      rw [hα_eq (q₀ i), hq₀_eq i, Algebra.smul_def]
      change e (AdjoinRoot.of _ (g_lin i * algebraMap _ _ D_all)) * z ^ i.1 =
        e (AdjoinRoot.of _ (algebraMap _ _ D_all) *
          (AdjoinRoot.of _ (g_lin i) * e.symm (z ^ i.1)))
      simp only [map_mul, e.apply_symm_apply]
      ring

    obtain ⟨q₀, i_nz, hq₀_nz, hq₀_rel⟩ := hDep_poly

    have hReduceX : ∀ (n : ℕ) (q : Fin (d + 1) → Polynomial L),
        (q i_nz).natDegree ≤ n → q i_nz ≠ 0 →
        (∑ i : Fin (d + 1), α_w (q i) * z ^ i.1 = 0) →
        ∃ (q' : Fin (d + 1) → Polynomial L) (i₀ : Fin (d + 1)),
          (q' i₀).coeff 0 ≠ 0 ∧ ∑ i : Fin (d + 1), α_w (q' i) * z ^ i.1 = 0 := by
      intro n
      induction n with
      | zero =>
        intro q hdeg_le hq_ne hrel
        refine ⟨q, i_nz, ?_, hrel⟩
        intro hc0
        apply hq_ne
        rw [Polynomial.eq_C_of_natDegree_le_zero hdeg_le, hc0, map_zero]
      | succ n ih =>
        intro q hdeg_le hq_ne hrel
        by_cases hex : ∃ i₀ : Fin (d + 1), (q i₀).coeff 0 ≠ 0
        · obtain ⟨i₀, hi₀⟩ := hex
          exact ⟨q, i₀, hi₀, hrel⟩
        · push_neg at hex
          have hdvdX : ∀ i : Fin (d + 1), Polynomial.X ∣ q i :=
            fun i => Polynomial.X_dvd_iff.mpr (hex i)
          choose q' hq' using hdvdX
          have hq'_ne : q' i_nz ≠ 0 := by
            intro h0
            apply hq_ne
            rw [hq' i_nz, h0, mul_zero]
          have hdeg' : (q' i_nz).natDegree ≤ n := by
            have h1 : (q i_nz).natDegree = (q' i_nz).natDegree + 1 := by
              rw [hq' i_nz, Polynomial.natDegree_X_mul hq'_ne]
            omega
          have hrel' : ∑ i : Fin (d + 1), α_w (q' i) * z ^ i.1 = 0 := by
            have hsum_w : w * (∑ i : Fin (d + 1), α_w (q' i) * z ^ i.1) = 0 := by
              rw [Finset.mul_sum, ← hrel]
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [hq' i, map_mul, hαX, mul_assoc]
            exact (mul_eq_zero.mp hsum_w).resolve_left hw_ne
          exact ih q' hdeg' hq'_ne hrel'

    obtain ⟨q, i₀, hqi₀_0, hq_rel⟩ :=
      hReduceX (q₀ i_nz).natDegree q₀ le_rfl hq₀_nz hq₀_rel
    obtain ⟨r, hr_def⟩ :
        ∃ r : ℕ, r = Finset.univ.sup (fun i : Fin (d + 1) => (q i).natDegree) := ⟨_, rfl⟩
    have hr_ge : ∀ i : Fin (d + 1), (q i).natDegree ≤ r := by
      intro i; rw [hr_def]
      exact Finset.le_sup (f := fun j : Fin (d + 1) => (q j).natDegree) (Finset.mem_univ i)
    have hr_pos : 1 ≤ r := by
      by_contra hr_lt
      have hr0 : r = 0 := by omega
      have hq_const : ∀ i : Fin (d + 1), q i = Polynomial.C ((q i).coeff 0) := by
        intro i
        apply Polynomial.eq_C_of_natDegree_le_zero
        have hi := hr_ge i
        omega
      have hsum_K :
          algebraMap (Polynomial L) (FractionRing (Polynomial L))
            (∑ i : Fin (d + 1), Polynomial.C ((q i).coeff 0) * Polynomial.X ^ i.1) = 0 := by
        rw [map_sum]
        refine Eq.trans (Finset.sum_congr rfl fun i _ => ?_) hq_rel
        rw [map_mul, map_pow, ← hz_def]
        have hαC : α_w (q i) =
            algebraMap (Polynomial L) (FractionRing (Polynomial L))
              (Polynomial.C ((q i).coeff 0)) := by
          conv_lhs => rw [hq_const i, hα_eval]
          exact Polynomial.eval₂_C _ _
        rw [hαC]
      have hsum_R : ∑ i : Fin (d + 1), Polynomial.C ((q i).coeff 0) * Polynomial.X ^ i.1 = 0 :=
        hι_inj (by rw [hsum_K, map_zero])
      have hc0 := congrArg (fun p : Polynomial L => p.coeff i₀.1) hsum_R
      simp only [Polynomial.coeff_zero, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul,
        Polynomial.coeff_X_pow] at hc0
      rw [Finset.sum_eq_single i₀
        (fun j _ hj => by
          have hne : i₀.1 ≠ j.1 := fun h => hj (Fin.ext h.symm)
          simp [hne])
        (fun h => absurd (Finset.mem_univ i₀) h)] at hc0
      simp only [↓reduceIte, mul_one] at hc0
      exact hqi₀_0 hc0

    obtain ⟨i₁, _, hi₁_deg⟩ :=
      Finset.exists_mem_eq_sup Finset.univ Finset.univ_nonempty
        (fun i : Fin (d + 1) => (q i).natDegree)
    rw [← hr_def] at hi₁_deg
    have hqi₁_ne : q i₁ ≠ 0 := by
      intro h0
      rw [h0, Polynomial.natDegree_zero] at hi₁_deg
      omega
    have hqi₁_r : (q i₁).coeff r ≠ 0 := by
      rw [hi₁_deg]
      exact Polynomial.leadingCoeff_ne_zero.mpr hqi₁_ne

    obtain ⟨P_slice, hP_def⟩ :
        ∃ P_slice : ℕ → Polynomial L,
          P_slice = fun m =>
            ∑ i : Fin (d + 1), Polynomial.C ((q i).coeff m) * Polynomial.X ^ i.1 := ⟨_, rfl⟩
    have hP_deg : ∀ m : ℕ, (P_slice m).natDegree ≤ d := by
      intro m
      rw [hP_def]
      dsimp only
      refine hSumDegLe Finset.univ _ d fun i _ => ?_
      calc
        (Polynomial.C ((q i).coeff m) * Polynomial.X ^ i.1).natDegree
          ≤ (Polynomial.X ^ i.1 : Polynomial L).natDegree := Polynomial.natDegree_C_mul_le _ _
        _ ≤ i.1 * (Polynomial.X : Polynomial L).natDegree := Polynomial.natDegree_pow_le
        _ ≤ d := by rw [Polynomial.natDegree_X, mul_one]; omega
    have hP_coeff : ∀ (m : ℕ) (i : Fin (d + 1)), (P_slice m).coeff i.1 = (q i).coeff m := by
      intro m i
      rw [hP_def]
      simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      rw [Finset.sum_eq_single i
        (fun j _ hj => by
          have hne : i.1 ≠ j.1 := fun h => hj (Fin.ext h.symm)
          simp [hne])
        (fun h => absurd (Finset.mem_univ i) h)]
      simp
    have hP0_ne : P_slice 0 ≠ 0 := by
      intro h0
      have hc := hP_coeff 0 i₀
      rw [h0, Polynomial.coeff_zero] at hc
      exact hqi₀_0 hc.symm
    have hPr_ne : P_slice r ≠ 0 := by
      intro h0
      have hc := hP_coeff r i₁
      rw [h0, Polynomial.coeff_zero] at hc
      exact hqi₁_r hc.symm

    have hHomogRel : ∑ m ∈ Finset.range (r + 1), A₁ ^ m * B₁ ^ (r - m) * P_slice m = 0 := by
      have h1 :
          algebraMap (Polynomial L) (FractionRing (Polynomial L))
            (∑ i : Fin (d + 1),
              (∑ m ∈ Finset.range (r + 1),
                Polynomial.C ((q i).coeff m) * A₁ ^ m * B₁ ^ (r - m)) *
                Polynomial.X ^ i.1) = 0 := by
        rw [map_sum]
        have hmul0 :
            (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁) ^ r *
              (∑ i : Fin (d + 1), α_w (q i) * z ^ i.1) = 0 := by
          rw [hq_rel, mul_zero]
        rw [Finset.mul_sum] at hmul0
        refine Eq.trans (Finset.sum_congr rfl fun i _ => ?_) hmul0
        rw [map_mul, map_pow, ← hz_def, hHomog_w r (q i) hBw (hr_ge i)]
        ring
      have h2 : ∑ i : Fin (d + 1),
          (∑ m ∈ Finset.range (r + 1),
            Polynomial.C ((q i).coeff m) * A₁ ^ m * B₁ ^ (r - m)) * Polynomial.X ^ i.1 = 0 :=
        hι_inj (by rw [h1, map_zero])
      rw [← h2]
      simp_rw [Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [hP_def, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => by ring

    have hA₁_deg : A₁.natDegree ≤ d := by
      have hsplit := hHomogRel
      rw [Finset.sum_range_succ'] at hsplit
      simp only [pow_zero, one_mul, Nat.sub_zero] at hsplit
      have hdvd_mul : A₁ ∣ B₁ ^ r * P_slice 0 := by
        refine ⟨- ∑ m ∈ Finset.range r, A₁ ^ m * B₁ ^ (r - (m + 1)) * P_slice (m + 1), ?_⟩
        calc
          B₁ ^ r * P_slice 0
            = - ∑ m ∈ Finset.range r, A₁ ^ (m + 1) * B₁ ^ (r - (m + 1)) * P_slice (m + 1) :=
              eq_neg_of_add_eq_zero_right hsplit
          _ = A₁ * (- ∑ m ∈ Finset.range r, A₁ ^ m * B₁ ^ (r - (m + 1)) * P_slice (m + 1)) := by
              rw [mul_neg, Finset.mul_sum]
              congr 1
              refine Finset.sum_congr rfl fun m _ => by rw [pow_succ']; ring
      exact (Polynomial.natDegree_le_of_dvd
        (hCop.pow_right.dvd_of_dvd_mul_left hdvd_mul) hP0_ne).trans (hP_deg 0)

    have hB₁_deg : B₁.natDegree ≤ d := by
      have hsplit := hHomogRel
      rw [Finset.sum_range_succ] at hsplit
      simp only [Nat.sub_self, pow_zero, mul_one] at hsplit
      have hdvd_mul : B₁ ∣ A₁ ^ r * P_slice r := by
        refine ⟨- ∑ m ∈ Finset.range r, A₁ ^ m * B₁ ^ (r - 1 - m) * P_slice m, ?_⟩
        calc
          A₁ ^ r * P_slice r
            = - ∑ m ∈ Finset.range r, A₁ ^ m * B₁ ^ (r - m) * P_slice m :=
              eq_neg_of_add_eq_zero_right hsplit
          _ = B₁ * (- ∑ m ∈ Finset.range r, A₁ ^ m * B₁ ^ (r - 1 - m) * P_slice m) := by
              rw [mul_neg, Finset.mul_sum]
              congr 1
              refine Finset.sum_congr rfl fun m hm => ?_
              have hm_lt : m < r := Finset.mem_range.mp hm
              have hsub : r - m = (r - 1 - m) + 1 := by omega
              rw [hsub, pow_succ]
              ring
      exact (Polynomial.natDegree_le_of_dvd
        (hCop.symm.pow_right.dvd_of_dvd_mul_left hdvd_mul) hPr_ne).trans (hP_deg r)

    have hτ_eq : τ ^ d + ∑ j ∈ Finset.range d, α_w (Q.coeff j) * τ ^ j = 0 := by
      have hroot0 :=
        AdjoinRoot.eval₂_root (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))))
      have hQu_decomp :
          Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))) =
            Polynomial.X ^ d + ∑ j ∈ Finset.range d,
              Polynomial.C (algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Q.coeff j)) *
                Polynomial.X ^ j := by
        conv_lhs => rw [hQ_decomp]
        simp [Polynomial.map_sum, d]
      conv at hroot0 =>
        lhs
        arg 3
        rw [hQu_decomp]
      rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow,
        Polynomial.eval₂_finsetSum] at hroot0
      have he0 := congrArg e hroot0
      rw [map_zero, map_add, map_pow, map_sum, ← hτ_def] at he0
      refine Eq.trans ?_ he0
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow,
        map_mul, map_pow, hα_eq (Q.coeff j), ← hτ_def]

    obtain ⟨G_coeff, hG_def⟩ :
        ∃ G_coeff : ℕ → Polynomial L,
          G_coeff = fun j =>
            B₁ ^ (M * (d - 1 - j)) *
              (∑ k ∈ Finset.range (M + 1),
                Polynomial.C ((Q.coeff j).coeff k) * A₁ ^ k * B₁ ^ (M - k)) := ⟨_, rfl⟩
    obtain ⟨y_τ, hyτ_def⟩ :
        ∃ y_τ : FractionRing (Polynomial L),
          y_τ = (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁) ^ M * τ := ⟨_, rfl⟩
    have hyτ_root :
        y_τ ^ d + ∑ j ∈ Finset.range d,
          algebraMap (Polynomial L) (FractionRing (Polynomial L)) (G_coeff j) * y_τ ^ j = 0 := by
      have hmul0 :
          (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁) ^ (M * d) *
            (τ ^ d + ∑ j ∈ Finset.range d, α_w (Q.coeff j) * τ ^ j) = 0 := by
        rw [hτ_eq, mul_zero]
      rw [mul_add, Finset.mul_sum] at hmul0
      refine Eq.trans ?_ hmul0
      congr 1
      · rw [hyτ_def, mul_pow, ← pow_mul]
      · refine Finset.sum_congr rfl fun j hj => ?_
        have hj_lt : j < d := Finset.mem_range.mp hj
        have hexp : M * d = M * (d - 1 - j) + M + M * j := by
          have hd_split : d = (d - 1 - j) + 1 + j := by omega
          calc
            M * d = M * ((d - 1 - j) + 1 + j) := by rw [← hd_split]
            _ = M * (d - 1 - j) + M + M * j := by ring
        rw [hG_def, hyτ_def, map_mul, map_pow, hHomog_w M (Q.coeff j) hBw (hCoeff j hj_lt),
          mul_pow, ← pow_mul, hexp, pow_add, pow_add]
        ring

    have hyτ_int : IsIntegral (Polynomial L) y_τ := by
      refine ⟨Polynomial.X ^ d + ∑ j ∈ Finset.range d, Polynomial.C (G_coeff j) * Polynomial.X ^ j,
        ?_, ?_⟩
      · apply Polynomial.monic_X_pow_add
        rw [Polynomial.degree_lt_iff_coeff_zero]
        intro m hm
        rw [Polynomial.finsetSum_coeff]
        refine Finset.sum_eq_zero fun j hj => ?_
        have hmj : m ≠ j := by have := Finset.mem_range.mp hj; omega
        simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, hmj]
      · simp only [Polynomial.eval₂_add, Polynomial.eval₂_X_pow,
          Polynomial.eval₂_finsetSum, Polynomial.eval₂_mul, Polynomial.eval₂_C]
        exact hyτ_root
    obtain ⟨F₂, hF₂_eq⟩ := IsIntegrallyClosed.isIntegral_iff.mp hyτ_int
    have hEq3_G : F₂ ^ d + ∑ j ∈ Finset.range d, G_coeff j * F₂ ^ j = 0 := by
      apply hι_inj
      rw [map_zero, map_add, map_pow, map_sum, hF₂_eq]
      refine Eq.trans ?_ hyτ_root
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, map_pow, hF₂_eq]
    have hEq3 :
        F₂ ^ d + (∑ j ∈ Finset.range d,
          B₁ ^ (M * (d - 1 - j)) *
            (∑ k ∈ Finset.range (M + 1),
              Polynomial.C ((Q.coeff j).coeff k) * A₁ ^ k * B₁ ^ (M - k)) * F₂ ^ j) = 0 := by
      simpa [hG_def] using hEq3_G

    have hF₂_deg : F₂.natDegree ≤ M * d := by
      by_contra hgt
      have hF₂_gt : M * d + 1 ≤ F₂.natDegree := by omega
      have hF₂_ne : F₂ ≠ 0 := by
        intro h0
        rw [h0, Polynomial.natDegree_zero] at hF₂_gt
        omega
      have hdF₂_pos : 1 ≤ d * F₂.natDegree := by nlinarith
      have hG_deg : ∀ j ∈ Finset.range d, (G_coeff j).natDegree ≤ M * (d - j) * d := by
        intro j hj
        have hj_lt : j < d := Finset.mem_range.mp hj
        have h1 : (∑ k ∈ Finset.range (M + 1),
            Polynomial.C ((Q.coeff j).coeff k) * A₁ ^ k * B₁ ^ (M - k)).natDegree ≤ M * d :=
          hSumDegLe _ _ (M * d) fun k hk =>
            hTermDegLe hA₁_deg hB₁_deg M k (Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)) _
        rw [hG_def]
        calc
          (B₁ ^ (M * (d - 1 - j)) *
              ∑ k ∈ Finset.range (M + 1),
                Polynomial.C ((Q.coeff j).coeff k) * A₁ ^ k * B₁ ^ (M - k)).natDegree
            ≤ (B₁ ^ (M * (d - 1 - j))).natDegree +
                (∑ k ∈ Finset.range (M + 1),
                  Polynomial.C ((Q.coeff j).coeff k) * A₁ ^ k * B₁ ^ (M - k)).natDegree :=
              Polynomial.natDegree_mul_le
          _ ≤ M * (d - 1 - j) * B₁.natDegree + M * d :=
              Nat.add_le_add Polynomial.natDegree_pow_le h1
          _ ≤ M * (d - 1 - j) * d + M * d :=
              Nat.add_le_add_right (Nat.mul_le_mul_left _ hB₁_deg) _
          _ = M * (d - j) * d := by
              have hsub : d - 1 - j + 1 = d - j := by omega
              calc
                M * (d - 1 - j) * d + M * d = M * ((d - 1 - j) + 1) * d := by ring
                _ = M * (d - j) * d := by rw [hsub]
      have hSum_lt : (∑ j ∈ Finset.range d, G_coeff j * F₂ ^ j).natDegree ≤
          d * F₂.natDegree - 1 := by
        refine hSumDegLe _ _ (d * F₂.natDegree - 1) fun j hj => ?_
        have hj_lt : j < d := Finset.mem_range.mp hj
        have hterm : (G_coeff j * F₂ ^ j).natDegree ≤ M * (d - j) * d + j * F₂.natDegree := by
          calc
            (G_coeff j * F₂ ^ j).natDegree
              ≤ (G_coeff j).natDegree + (F₂ ^ j).natDegree := Polynomial.natDegree_mul_le
            _ ≤ M * (d - j) * d + j * F₂.natDegree :=
                Nat.add_le_add (hG_deg j hj) Polynomial.natDegree_pow_le
        have hstrict : M * (d - j) * d + j * F₂.natDegree + 1 ≤ d * F₂.natDegree := by
          have hd_split : (d - j) + j = d := by omega
          have hmul : (d - j) * (M * d + 1) ≤ (d - j) * F₂.natDegree :=
            Nat.mul_le_mul_left (d - j) hF₂_gt
          calc
            M * (d - j) * d + j * F₂.natDegree + 1
              ≤ (d - j) * (M * d) + (d - j) + j * F₂.natDegree := by
                have : M * (d - j) * d = (d - j) * (M * d) := by ring
                omega
            _ = (d - j) * (M * d + 1) + j * F₂.natDegree := by ring
            _ ≤ (d - j) * F₂.natDegree + j * F₂.natDegree := Nat.add_le_add_right hmul _
            _ = d * F₂.natDegree := by rw [← Nat.add_mul, hd_split]
        omega
      have hF₂_pow_eq : F₂ ^ d = - ∑ j ∈ Finset.range d, G_coeff j * F₂ ^ j :=
        eq_neg_of_add_eq_zero_left hEq3_G
      have hpow_deg : (F₂ ^ d).natDegree = d * F₂.natDegree := Polynomial.natDegree_pow F₂ d
      rw [hF₂_pow_eq, Polynomial.natDegree_neg] at hpow_deg
      omega

    have hIndep : ∀ (C : Fin d → Polynomial L),
        (∀ j : Fin d, (C j).natDegree ≤ K_max) →
        (∑ j : Fin d,
          B₁ ^ (M * (d - 1 - j.1)) *
            (∑ k ∈ Finset.range (K_max + 1),
              Polynomial.C ((C j).coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) * F₂ ^ j.1) = 0 →
        ∀ j : Fin d, C j = 0 := by
      intro C hC_deg hC_rel
      have hιB₁_ne : algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁ ≠ 0 :=
        fun h0 => hB₁_ne (hι_inj (by rw [h0, map_zero]))
      have hsum_K :
          (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁) ^ (M * (d - 1) + K_max) *
            (∑ j : Fin d, α_w (C j) * τ ^ j.1) = 0 := by
        have h0 := congrArg (algebraMap (Polynomial L) (FractionRing (Polynomial L))) hC_rel
        rw [map_zero, map_sum] at h0
        rw [Finset.mul_sum, ← h0]
        refine Finset.sum_congr rfl fun j _ => ?_
        have hexp : M * (d - 1) + K_max = M * (d - 1 - j.1) + K_max + M * j.1 := by
          have hd_split : d - 1 = (d - 1 - j.1) + j.1 := by omega
          calc
            M * (d - 1) + K_max = M * ((d - 1 - j.1) + j.1) + K_max := by rw [← hd_split]
            _ = M * (d - 1 - j.1) + K_max + M * j.1 := by ring
        rw [map_mul, map_mul, map_pow, map_pow, hF₂_eq, hyτ_def,
          hHomog_w K_max (C j) hBw (hC_deg j), mul_pow, ← pow_mul, hexp, pow_add, pow_add]
        ring
      have hsum_τ : ∑ j : Fin d, α_w (C j) * τ ^ j.1 = 0 :=
        (mul_eq_zero.mp hsum_K).resolve_left (pow_ne_zero _ hιB₁_ne)
      have hsum_ar : ∑ j : Fin d,
          AdjoinRoot.of (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))))
              (algebraMap _ _ (C j)) *
            (AdjoinRoot.root _) ^ j.1 = 0 := by
        apply e.injective
        rw [map_zero, map_sum, ← hsum_τ]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, map_pow, ← hα_eq (C j), ← hτ_def]
      let pb := AdjoinRoot.powerBasis hQu_ne_zero
      have hpb_dim : pb.dim = d := (AdjoinRoot.powerBasis_dim hQu_ne_zero).trans hQu_deg
      let g_pb : Fin pb.dim → FractionRing (Polynomial L) :=
        fun i => algebraMap _ _ (C (Fin.cast hpb_dim i))
      have hg_pb_zero : ∑ i : Fin pb.dim, g_pb i • pb.basis i = 0 := by
        have hreindex := (Fin.castOrderIso hpb_dim).toEquiv.sum_comp
          (fun j : Fin d =>
            AdjoinRoot.of (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))))
                (algebraMap _ _ (C j)) *
              (AdjoinRoot.root _) ^ j.1)
        rw [← hsum_ar, ← hreindex]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [pb.basis_eq_pow i, AdjoinRoot.powerBasis_gen hQu_ne_zero, Algebra.smul_def]
        rfl
      have hall_zero := Fintype.linearIndependent_iff.mp pb.basis.linearIndependent g_pb hg_pb_zero
      intro j
      have hj0 := hall_zero (Fin.cast hpb_dim.symm j)
      dsimp [g_pb] at hj0
      exact hι_inj (by rw [hj0, map_zero])

    exact ⟨A₁, B₁, F₂, hA₁_deg, hB₁_deg, hF₂_deg, hB₁_ne, hEq3, hIndep⟩

  
  have hStep3 :
      ∀ (A₁ B₁ F₂ : Polynomial L),
        A₁.natDegree ≤ d →
        B₁.natDegree ≤ d →
        F₂.natDegree ≤ M * d →
        B₁ ≠ 0 →
        (∀ (C : Fin d → Polynomial L),
          (∀ j : Fin d, (C j).natDegree ≤ K_max) →
          (∑ j : Fin d,
            B₁ ^ (M * (d - 1 - j.1)) *
              (∑ k ∈ Finset.range (K_max + 1),
                Polynomial.C ((C j).coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) * F₂ ^ j.1) = 0 →
          ∀ j : Fin d, C j = 0) →
        ∃ (C : Fin d → Polynomial L) (H : Polynomial L),
          (∀ j : Fin d, (C j).natDegree ≤ K_max) ∧
          H.natDegree ≤ K_max ∧
          B₁ * (∑ k ∈ Finset.range (K_max + 1),
            Polynomial.C (H.coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) ≠ 0 ∧
          (∑ j : Fin d,
            B₁ ^ (M * (d - 1 - j.1)) *
              (∑ k ∈ Finset.range (K_max + 1),
                Polynomial.C ((C j).coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) * F₂ ^ j.1) -
            Polynomial.X * B₁ ^ (M * (d - 1)) *
              (∑ k ∈ Finset.range (K_max + 1),
                Polynomial.C (H.coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) = 0 := by
    intro A₁ B₁ F₂ hA₁_deg hB₁_deg hF₂_deg hB₁_ne hIndep
    obtain ⟨D_z, hDz_def⟩ : ∃ D_z : ℕ, D_z = K_max * d + M * (d - 1) * d + 1 := ⟨_, rfl⟩
    obtain ⟨mkHomog, hmkHomog_def⟩ :
        ∃ mkHomog : (Fin (K_max + 1) → L) → Polynomial L,
          ∀ f, mkHomog f =
            ∑ k : Fin (K_max + 1), Polynomial.C (f k) * A₁ ^ k.1 * B₁ ^ (K_max - k.1) :=
      ⟨_, fun _ => rfl⟩
    have hmkHomog_add : ∀ f₁ f₂ : Fin (K_max + 1) → L,
        mkHomog (f₁ + f₂) = mkHomog f₁ + mkHomog f₂ := by
      intro f₁ f₂
      simp only [hmkHomog_def, Pi.add_apply, Polynomial.C_add, add_mul, Finset.sum_add_distrib]
    have hmkHomog_smul : ∀ (r_c : L) (f : Fin (K_max + 1) → L),
        mkHomog (r_c • f) = Polynomial.C r_c * mkHomog f := by
      intro r_c f
      simp only [hmkHomog_def, Pi.smul_apply, smul_eq_mul, Polynomial.C_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun k _ => by ring

    obtain ⟨P_lin, hPlin_def⟩ :
        ∃ P_lin :
            ((Fin d → Fin (K_max + 1) → L) × (Fin (K_max + 1) → L)) → Polynomial L,
          ∀ x, P_lin x =
            (∑ j : Fin d, B₁ ^ (M * (d - 1 - j.1)) * mkHomog (x.1 j) * F₂ ^ j.1) -
              Polynomial.X * B₁ ^ (M * (d - 1)) * mkHomog x.2 :=
      ⟨_, fun _ => rfl⟩
    have hPlin_add : ∀ x y, P_lin (x + y) = P_lin x + P_lin y := by
      intro x y
      simp only [hPlin_def, Prod.fst_add, Prod.snd_add, Pi.add_apply, hmkHomog_add,
        mul_add, add_mul, Finset.sum_add_distrib]
      ring
    have hPlin_smul : ∀ (r_c : L) (x), P_lin (r_c • x) = r_c • P_lin x := by
      intro r_c x
      simp only [hPlin_def, Prod.smul_fst, Prod.smul_snd, Pi.smul_apply, hmkHomog_smul,
        Polynomial.smul_eq_C_mul]
      rw [mul_sub, Finset.mul_sum]
      congr 1
      · refine Finset.sum_congr rfl fun j _ => by ring
      · ring

    obtain ⟨Λ, hΛ_def⟩ :
        ∃ Λ :
            ((Fin d → Fin (K_max + 1) → L) × (Fin (K_max + 1) → L)) →ₗ[L] (Fin (D_z + 1) → L),
          ∀ x m, Λ x m = (P_lin x).coeff m.1 :=
      ⟨{ toFun := fun x m => (P_lin x).coeff m.1
         map_add' := fun x y => by ext m; simp [hPlin_add]
         map_smul' := fun r_c x => by ext m; simp [hPlin_smul] },
       fun _ _ => rfl⟩

    have hPlin_deg :
        ∀ x : (Fin d → Fin (K_max + 1) → L) × (Fin (K_max + 1) → L),
          (P_lin x).natDegree ≤ D_z := by
      intro x
      have hmk_deg : ∀ f : Fin (K_max + 1) → L, (mkHomog f).natDegree ≤ K_max * d := by
        intro f
        rw [hmkHomog_def f]
        refine hSumDegLe Finset.univ _ (K_max * d) fun k _ =>
          hTermDegLe hA₁_deg hB₁_deg K_max k.1 (Nat.lt_succ_iff.mp k.2) (f k)
      rw [hPlin_def x]
      refine le_trans (Polynomial.natDegree_sub_le _ _) (max_le ?_ ?_)
      · refine hSumDegLe Finset.univ _ D_z fun j _ => ?_
        calc
          (B₁ ^ (M * (d - 1 - j.1)) * mkHomog (x.1 j) * F₂ ^ j.1).natDegree
            ≤ (B₁ ^ (M * (d - 1 - j.1)) * mkHomog (x.1 j)).natDegree +
                (F₂ ^ j.1).natDegree := Polynomial.natDegree_mul_le
          _ ≤ (B₁ ^ (M * (d - 1 - j.1))).natDegree + (mkHomog (x.1 j)).natDegree +
                (F₂ ^ j.1).natDegree :=
              Nat.add_le_add_right Polynomial.natDegree_mul_le _
          _ ≤ M * (d - 1 - j.1) * B₁.natDegree + K_max * d + j.1 * F₂.natDegree :=
              Nat.add_le_add
                (Nat.add_le_add Polynomial.natDegree_pow_le (hmk_deg (x.1 j)))
                Polynomial.natDegree_pow_le
          _ ≤ M * (d - 1 - j.1) * d + K_max * d + j.1 * (M * d) :=
              Nat.add_le_add
                (Nat.add_le_add_right (Nat.mul_le_mul_left _ hB₁_deg) _)
                (Nat.mul_le_mul_left _ hF₂_deg)
          _ ≤ D_z := by
              have hd_split : (d - 1 - j.1) + j.1 = d - 1 := by omega
              have h_eq : M * (d - 1 - j.1) * d + j.1 * (M * d) = M * (d - 1) * d := by
                calc
                  M * (d - 1 - j.1) * d + j.1 * (M * d)
                    = M * ((d - 1 - j.1) + j.1) * d := by ring
                  _ = M * (d - 1) * d := by rw [hd_split]
              rw [hDz_def]
              omega
      · calc
          (Polynomial.X * B₁ ^ (M * (d - 1)) * mkHomog x.2).natDegree
            ≤ (Polynomial.X * B₁ ^ (M * (d - 1))).natDegree + (mkHomog x.2).natDegree :=
              Polynomial.natDegree_mul_le
          _ ≤ (Polynomial.X : Polynomial L).natDegree + (B₁ ^ (M * (d - 1))).natDegree +
                (mkHomog x.2).natDegree :=
              Nat.add_le_add_right Polynomial.natDegree_mul_le _
          _ ≤ 1 + M * (d - 1) * B₁.natDegree + K_max * d := by
              rw [Polynomial.natDegree_X]
              exact Nat.add_le_add
                (Nat.add_le_add_left Polynomial.natDegree_pow_le 1)
                (hmk_deg x.2)
          _ ≤ 1 + M * (d - 1) * d + K_max * d :=
              Nat.add_le_add_right
                (Nat.add_le_add_left (Nat.mul_le_mul_left _ hB₁_deg) 1) _
          _ = D_z := by rw [hDz_def]; omega

    have hDimLt :
        Module.finrank L (Fin (D_z + 1) → L) <
          Module.finrank L ((Fin d → Fin (K_max + 1) → L) × (Fin (K_max + 1) → L)) := by
      have hCod : Module.finrank L (Fin (D_z + 1) → L) = D_z + 1 := by
        rw [Module.finrank_pi, Fintype.card_fin]
      have hDom :
          Module.finrank L ((Fin d → Fin (K_max + 1) → L) × (Fin (K_max + 1) → L)) =
            d * (K_max + 1) + (K_max + 1) := by
        rw [Module.finrank_prod, Module.finrank_pi_fintype, Module.finrank_pi]
        simp [Fintype.card_fin]
      rw [hCod, hDom, hDz_def]
      dsimp [K_max]
      have hd1 : d - 1 + 1 = d := by omega
      have hMd2 : M * (d - 1) * d ≤ M * d ^ 2 := by
        calc
          M * (d - 1) * d ≤ M * ((d - 1) + 1) * d :=
            Nat.mul_le_mul_right d (Nat.mul_le_mul_left M (Nat.le_succ _))
          _ = M * d ^ 2 := by rw [hd1]; ring
      nlinarith

    have hNotInj : ¬ Function.Injective Λ := by
      intro hInj
      have hle := (LinearMap.finrank_range_of_inj hInj).symm ▸ Submodule.finrank_le (LinearMap.range Λ)
      omega
    have hExKer :
        ∃ x : (Fin d → Fin (K_max + 1) → L) × (Fin (K_max + 1) → L), x ≠ 0 ∧ Λ x = 0 := by
      by_contra hNo
      push_neg at hNo
      apply hNotInj
      rw [injective_iff_map_eq_zero]
      exact fun x hx => by_contra fun hne => absurd hx (hNo x hne)
    obtain ⟨x_sol, hx_ne, hx_ker⟩ := hExKer

    obtain ⟨mkPoly, hmkPoly_def⟩ :
        ∃ mkPoly : (Fin (K_max + 1) → L) → Polynomial L,
          mkPoly = fun f =>
            ∑ k : Fin (K_max + 1), Polynomial.C (f k) * Polynomial.X ^ k.1 := ⟨_, rfl⟩
    have hmkPoly_deg : ∀ f : Fin (K_max + 1) → L, (mkPoly f).natDegree ≤ K_max := by
      intro f; rw [hmkPoly_def]; dsimp only
      refine hSumDegLe Finset.univ _ K_max fun k _ => ?_
      calc
        (Polynomial.C (f k) * Polynomial.X ^ k.1).natDegree
          ≤ (Polynomial.X ^ k.1 : Polynomial L).natDegree := Polynomial.natDegree_C_mul_le _ _
        _ ≤ k.1 * (Polynomial.X : Polynomial L).natDegree := Polynomial.natDegree_pow_le
        _ ≤ K_max := by rw [Polynomial.natDegree_X, mul_one]; omega
    have hmkPoly_coeff : ∀ (f : Fin (K_max + 1) → L) (k : Fin (K_max + 1)),
        (mkPoly f).coeff k.1 = f k := by
      intro f k; rw [hmkPoly_def]
      simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      rw [Finset.sum_eq_single k
        (fun j _ hj => by
          have hne : k.1 ≠ j.1 := fun h => hj (Fin.ext h.symm)
          simp [hne])
        (fun h => absurd (Finset.mem_univ k) h)]
      simp
    have hmkPoly_homog : ∀ f : Fin (K_max + 1) → L,
        (∑ k ∈ Finset.range (K_max + 1),
          Polynomial.C ((mkPoly f).coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) = mkHomog f := by
      intro f
      rw [hmkHomog_def f, ← Fin.sum_univ_eq_sum_range]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [hmkPoly_coeff f k]

    obtain ⟨C_sol, hC_def⟩ : ∃ C_sol : Fin d → Polynomial L, C_sol = fun j => mkPoly (x_sol.1 j) :=
      ⟨_, rfl⟩
    obtain ⟨H_sol, hH_def⟩ : ∃ H_sol : Polynomial L, H_sol = mkPoly x_sol.2 := ⟨_, rfl⟩
    have hC_deg : ∀ j : Fin d, (C_sol j).natDegree ≤ K_max := by
      intro j; rw [hC_def]; exact hmkPoly_deg (x_sol.1 j)
    have hH_deg : H_sol.natDegree ≤ K_max := by rw [hH_def]; exact hmkPoly_deg x_sol.2

    have hPlin_zero : P_lin x_sol = 0 := by
      ext m
      rw [Polynomial.coeff_zero]
      by_cases hm : m ≤ D_z
      · rw [← hΛ_def x_sol ⟨m, Nat.lt_succ_of_le hm⟩]
        exact congrFun hx_ker ⟨m, Nat.lt_succ_of_le hm⟩
      · exact Polynomial.coeff_eq_zero_of_natDegree_lt
          (lt_of_le_of_lt (hPlin_deg x_sol) (by omega))

    have hEq4 :
        (∑ j : Fin d,
          B₁ ^ (M * (d - 1 - j.1)) *
            (∑ k ∈ Finset.range (K_max + 1),
              Polynomial.C ((C_sol j).coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) * F₂ ^ j.1) -
          Polynomial.X * B₁ ^ (M * (d - 1)) *
            (∑ k ∈ Finset.range (K_max + 1),
              Polynomial.C (H_sol.coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) = 0 := by
      rw [hC_def, hH_def]
      simp_rw [hmkPoly_homog]
      rw [← hPlin_def x_sol]
      exact hPlin_zero

    have hEq2 :
        B₁ * (∑ k ∈ Finset.range (K_max + 1),
          Polynomial.C (H_sol.coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) ≠ 0 := by
      intro h0
      have hH_homog0 : (∑ k ∈ Finset.range (K_max + 1),
          Polynomial.C (H_sol.coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) = 0 :=
        (mul_eq_zero.mp h0).resolve_left hB₁_ne
      have hC_sum0 : (∑ j : Fin d,
          B₁ ^ (M * (d - 1 - j.1)) *
            (∑ k ∈ Finset.range (K_max + 1),
              Polynomial.C ((C_sol j).coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) * F₂ ^ j.1) = 0 := by
        have h4 := hEq4
        rw [hH_homog0, mul_zero, sub_zero] at h4
        exact h4
      have hC_all0 : ∀ j : Fin d, C_sol j = 0 := hIndep C_sol hC_deg hC_sum0
      let C_test : Fin d → Polynomial L := fun j => if j.1 = 0 then H_sol else 0
      have hC_test_deg : ∀ j : Fin d, (C_test j).natDegree ≤ K_max := by
        intro j
        dsimp [C_test]
        split_ifs
        · exact hH_deg
        · simp
      have hC_test_sum0 : (∑ j : Fin d,
          B₁ ^ (M * (d - 1 - j.1)) *
            (∑ k ∈ Finset.range (K_max + 1),
              Polynomial.C ((C_test j).coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) * F₂ ^ j.1) = 0 := by
        refine Finset.sum_eq_zero fun j _ => ?_
        dsimp [C_test]
        split_ifs
        · rw [hH_homog0, mul_zero, zero_mul]
        · simp
      have hH_zero : H_sol = 0 := by
        have h := hIndep C_test hC_test_deg hC_test_sum0 ⟨0, hDeg⟩
        simpa [C_test] using h
      apply hx_ne
      apply Prod.ext
      · ext j k
        rw [Prod.fst_zero, Pi.zero_apply, Pi.zero_apply, ← hmkPoly_coeff (x_sol.1 j) k]
        have hc : mkPoly (x_sol.1 j) = 0 := by rw [← hC_all0 j, hC_def]
        rw [hc, Polynomial.coeff_zero]
      · ext k
        rw [Prod.snd_zero, Pi.zero_apply, ← hmkPoly_coeff x_sol.2 k]
        rw [← hH_def, hH_zero, Polynomial.coeff_zero]

    exact ⟨C_sol, H_sol, hC_deg, hH_deg, hEq2, hEq4⟩

  
  have hStep4 :
      ∀ (A₁ B₁ F₂ : Polynomial L) (C : Fin d → Polynomial L) (H : Polynomial L),
        (∀ j : Fin d, (C j).natDegree ≤ K_max) →
        H.natDegree ≤ K_max →
        B₁ * (∑ k ∈ Finset.range (K_max + 1),
          Polynomial.C (H.coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) ≠ 0 →
        F₂ ^ d + (∑ j ∈ Finset.range d,
          B₁ ^ (M * (d - 1 - j)) *
            (∑ k ∈ Finset.range (M + 1),
              Polynomial.C ((Q.coeff j).coeff k) * A₁ ^ k * B₁ ^ (M - k)) * F₂ ^ j) = 0 →
        (∑ j : Fin d,
          B₁ ^ (M * (d - 1 - j.1)) *
            (∑ k ∈ Finset.range (K_max + 1),
              Polynomial.C ((C j).coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) * F₂ ^ j.1) -
          Polynomial.X * B₁ ^ (M * (d - 1)) *
            (∑ k ∈ Finset.range (K_max + 1),
              Polynomial.C (H.coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) = 0 →
        ∃ (e : AdjoinRoot (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))) ≃+*
            FractionRing (Polynomial L)),
          ∀ c : L,
            e (AdjoinRoot.of _
                (algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Polynomial.C c))) =
              algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Polynomial.C c) := by
    intro A₁ B₁ F₂ C H hC_deg hH_deg hEq2 hEq3 hEq4
    have hι_inj :
        Function.Injective (algebraMap (Polynomial L) (FractionRing (Polynomial L))) :=
      IsFractionRing.injective (Polynomial L) (FractionRing (Polynomial L))
    have hB₁_ne : B₁ ≠ 0 := left_ne_zero_of_mul hEq2
    have hHomogH_ne : (∑ k ∈ Finset.range (K_max + 1),
        Polynomial.C (H.coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) ≠ 0 :=
      right_ne_zero_of_mul hEq2
    have hιB₁_ne : algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁ ≠ 0 :=
      fun h0 => hB₁_ne (hι_inj (by rw [h0, map_zero]))
    obtain ⟨z, hz_def⟩ :
        ∃ z : FractionRing (Polynomial L),
          z = algebraMap (Polynomial L) (FractionRing (Polynomial L)) Polynomial.X := ⟨_, rfl⟩
    obtain ⟨w, hw_def⟩ :
        ∃ w : FractionRing (Polynomial L),
          w = algebraMap (Polynomial L) (FractionRing (Polynomial L)) A₁ /
            algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁ := ⟨_, rfl⟩
    obtain ⟨τ, hτ_def⟩ :
        ∃ τ : FractionRing (Polynomial L),
          τ = algebraMap (Polynomial L) (FractionRing (Polynomial L)) F₂ /
            (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁) ^ M := ⟨_, rfl⟩
    have hBw :
        algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁ * w =
          algebraMap (Polynomial L) (FractionRing (Polynomial L)) A₁ := by
      rw [hw_def]; exact mul_div_cancel₀ _ hιB₁_ne
    have hBMτ :
        (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁) ^ M * τ =
          algebraMap (Polynomial L) (FractionRing (Polynomial L)) F₂ := by
      rw [hτ_def]; exact mul_div_cancel₀ _ (pow_ne_zero M hιB₁_ne)
    obtain ⟨α_w, hα_def⟩ :
        ∃ α_w : Polynomial L →+* FractionRing (Polynomial L),
          α_w = Polynomial.eval₂RingHom
            ((algebraMap (Polynomial L) (FractionRing (Polynomial L))).comp Polynomial.C) w :=
      ⟨_, rfl⟩
    have hα_aeval : ∀ p : Polynomial L, α_w p = Polynomial.aeval w p := by
      intro p
      rw [hα_def, Polynomial.aeval_def]
      rfl
    have hHomog_w : ∀ (N : ℕ) (p : Polynomial L), p.natDegree ≤ N →
        algebraMap (Polynomial L) (FractionRing (Polynomial L))
          (∑ k ∈ Finset.range (N + 1), Polynomial.C (p.coeff k) * A₁ ^ k * B₁ ^ (N - k)) =
          (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁) ^ N * α_w p := by
      intro N p hp
      rw [hHomogEval w A₁ B₁ hBw N p hp, hα_def]
      rfl

    have hC1 : α_w H ≠ 0 := by
      intro h0
      apply hHomogH_ne
      apply hι_inj
      rw [map_zero, hHomog_w K_max H hH_deg, h0, mul_zero]

    have hC2 : τ ^ d + ∑ j ∈ Finset.range d, α_w (Q.coeff j) * τ ^ j = 0 := by
      have h0 := congrArg (algebraMap (Polynomial L) (FractionRing (Polynomial L))) hEq3
      rw [map_zero, map_add, map_pow, map_sum, ← hBMτ] at h0
      have hfact :
          (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁) ^ (M * d) *
            (τ ^ d + ∑ j ∈ Finset.range d, α_w (Q.coeff j) * τ ^ j) = 0 := by
        rw [mul_add, Finset.mul_sum, ← h0]
        congr 1
        · rw [mul_pow, ← pow_mul]
        · refine Finset.sum_congr rfl fun j hj => ?_
          have hj_lt : j < d := Finset.mem_range.mp hj
          have hexp : M * d = M * (d - 1 - j) + M + M * j := by
            have hd_split : d = (d - 1 - j) + 1 + j := by omega
            calc
              M * d = M * ((d - 1 - j) + 1 + j) := by rw [← hd_split]
              _ = M * (d - 1 - j) + M + M * j := by ring
          rw [map_mul, map_mul, map_pow, map_pow, ← hBMτ,
            hHomog_w M (Q.coeff j) (hCoeff j hj_lt), mul_pow, ← pow_mul, hexp, pow_add, pow_add]
          ring
      exact (mul_eq_zero.mp hfact).resolve_left (pow_ne_zero _ hιB₁_ne)

    have hC3 : ∑ j : Fin d, α_w (C j) * τ ^ j.1 = z * α_w H := by
      have h0 :=
        congrArg (algebraMap (Polynomial L) (FractionRing (Polynomial L))) (sub_eq_zero.mp hEq4)
      rw [map_sum, map_mul, map_mul, map_pow, ← hz_def, hHomog_w K_max H hH_deg] at h0
      apply mul_left_cancel₀ (pow_ne_zero (M * (d - 1) + K_max) hιB₁_ne)
      calc
        (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁) ^ (M * (d - 1) + K_max) *
            (∑ j : Fin d, α_w (C j) * τ ^ j.1)
          = ∑ j : Fin d,
              (algebraMap (Polynomial L) (FractionRing (Polynomial L)) B₁) ^
                (M * (d - 1) + K_max) * (α_w (C j) * τ ^ j.1) :=
            Finset.mul_sum _ _ _
        _ = ∑ j : Fin d,
              algebraMap (Polynomial L) (FractionRing (Polynomial L))
                (B₁ ^ (M * (d - 1 - j.1)) *
                  (∑ k ∈ Finset.range (K_max + 1),
                    Polynomial.C ((C j).coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) * F₂ ^ j.1) := by
            refine Finset.sum_congr rfl fun j _ => ?_
            have hexp : M * (d - 1) + K_max = M * (d - 1 - j.1) + K_max + M * j.1 := by
              have hd_split : d - 1 = (d - 1 - j.1) + j.1 := by omega
              calc
                M * (d - 1) + K_max = M * ((d - 1 - j.1) + j.1) + K_max := by rw [← hd_split]
                _ = M * (d - 1 - j.1) + K_max + M * j.1 := by ring
            rw [map_mul, map_mul, map_pow, map_pow, ← hBMτ,
              hHomog_w K_max (C j) (hC_deg j), mul_pow, ← pow_mul, hexp, pow_add, pow_add]
            ring
        _ = z * (algebraMap _ _ B₁) ^ (M * (d - 1)) * ((algebraMap _ _ B₁) ^ K_max * α_w H) := h0
        _ = (algebraMap _ _ B₁) ^ (M * (d - 1) + K_max) * (z * α_w H) := by rw [pow_add]; ring

    have hα_inj : Function.Injective α_w := by
      rw [injective_iff_map_eq_zero]
      intro p hp0
      by_contra hp_ne
      have hAlg_w : IsAlgebraic L w := ⟨p, hp_ne, by rwa [← hα_aeval p]⟩
      have hInt_w : IsIntegral L w := hAlg_w.isIntegral
      have : Algebra.IsIntegral L ↥(Algebra.adjoin L ({w} : Set (FractionRing (Polynomial L)))) :=
        Algebra.IsIntegral.adjoin (by intro x hx; rw [Set.mem_singleton_iff.mp hx]; exact hInt_w)
      let a_coeff : ℕ → ↥(Algebra.adjoin L ({w} : Set (FractionRing (Polynomial L)))) := fun j =>
        ⟨α_w (Q.coeff j), by
          rw [hα_aeval]
          exact Polynomial.aeval_mem_adjoin_singleton L w⟩
      have hInt_τ_Aw :
          IsIntegral ↥(Algebra.adjoin L ({w} : Set (FractionRing (Polynomial L)))) τ := by
        refine ⟨Polynomial.X ^ d + ∑ j ∈ Finset.range d, Polynomial.C (a_coeff j) * Polynomial.X ^ j,
          ?_, ?_⟩
        · apply Polynomial.monic_X_pow_add
          rw [Polynomial.degree_lt_iff_coeff_zero]
          intro m hm
          rw [Polynomial.finsetSum_coeff]
          refine Finset.sum_eq_zero fun j hj => ?_
          have hmj : m ≠ j := by have := Finset.mem_range.mp hj; omega
          simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, hmj]
        · simp only [Polynomial.eval₂_add, Polynomial.eval₂_X_pow,
            Polynomial.eval₂_finsetSum, Polynomial.eval₂_mul, Polynomial.eval₂_C]
          exact hC2
      have hInt_τ : IsIntegral L τ :=
        isIntegral_trans
          (R := L) (A := ↥(Algebra.adjoin L ({w} : Set (FractionRing (Polynomial L)))))
          τ hInt_τ_Aw
      have : Finite ↑({w, τ} : Set (FractionRing (Polynomial L))) := Set.toFinite _
      have : FiniteDimensional L
          ↥(IntermediateField.adjoin L ({w, τ} : Set (FractionRing (Polynomial L)))) :=
        IntermediateField.finiteDimensional_adjoin fun x hx => by
          rcases Set.mem_insert_iff.mp hx with hx | hx
          · rw [hx]; exact hInt_w
          · rw [Set.mem_singleton_iff.mp hx]; exact hInt_τ
      have hw_E : w ∈ IntermediateField.adjoin L ({w, τ} : Set (FractionRing (Polynomial L))) :=
        IntermediateField.subset_adjoin L _ (Or.inl rfl)
      have hτ_E : τ ∈ IntermediateField.adjoin L ({w, τ} : Set (FractionRing (Polynomial L))) :=
        IntermediateField.subset_adjoin L _ (Or.inr rfl)
      have hα_mem_E : ∀ q : Polynomial L,
          α_w q ∈ IntermediateField.adjoin L ({w, τ} : Set (FractionRing (Polynomial L))) := by
        intro q
        rw [Polynomial.as_sum_range_C_mul_X_pow' q (Nat.lt_succ_self _), map_sum]
        refine sum_mem fun k _ => ?_
        rw [map_mul, map_pow]
        have hc_mem : α_w (Polynomial.C (q.coeff k)) ∈
            IntermediateField.adjoin L ({w, τ} : Set (FractionRing (Polynomial L))) := by
          rw [hα_aeval, Polynomial.aeval_C]
          exact (IntermediateField.adjoin L _).algebraMap_mem (q.coeff k)
        have hw_eq : α_w Polynomial.X = w := by rw [hα_def]; exact Polynomial.eval₂_X _ w
        rw [hw_eq]
        exact mul_mem hc_mem (pow_mem hw_E k)
      have hz_eq : z = (∑ j : Fin d, α_w (C j) * τ ^ j.1) / α_w H :=
        (eq_div_iff hC1).mpr hC3.symm
      have hz_E : z ∈ IntermediateField.adjoin L ({w, τ} : Set (FractionRing (Polynomial L))) := by
        rw [hz_eq]
        exact div_mem (sum_mem fun j _ => mul_mem (hα_mem_E (C j)) (pow_mem hτ_E j.1))
          (hα_mem_E H)
      have : Algebra.IsIntegral L
          ↥(IntermediateField.adjoin L ({w, τ} : Set (FractionRing (Polynomial L)))) :=
        Algebra.IsIntegral.of_finite L _
      have hInt_z_E :
          IsIntegral L
            (⟨z, hz_E⟩ :
              ↥(IntermediateField.adjoin L ({w, τ} : Set (FractionRing (Polynomial L))))) :=
        Algebra.IsIntegral.isIntegral _
      have hInt_z : IsIntegral L z :=
        IsIntegral.map (IntermediateField.adjoin L _).val hInt_z_E
      obtain ⟨q_z, hqz_mon, hqz_eval⟩ := hInt_z
      have hιq_zero :
          algebraMap (Polynomial L) (FractionRing (Polynomial L)) q_z = 0 := by
        have h1 : Polynomial.eval₂ (algebraMap L (FractionRing (Polynomial L))) z q_z =
            algebraMap (Polynomial L) (FractionRing (Polynomial L))
              (Polynomial.eval₂ Polynomial.C Polynomial.X q_z) := by
          rw [hz_def, Polynomial.hom_eval₂]
          rfl
        rw [Polynomial.eval₂_C_X] at h1
        exact h1.symm.trans hqz_eval
      exact hqz_mon.ne_zero (hι_inj (by rw [hιq_zero, map_zero]))

    have hα_unit : ∀ y : nonZeroDivisors (Polynomial L), IsUnit (α_w y.1) := by
      intro y
      exact Ne.isUnit fun h0 =>
        mem_nonZeroDivisors_iff_ne_zero.mp y.2 (hα_inj (by rw [h0, map_zero]))
    obtain ⟨α_hat, hα_hat_eq⟩ :
        ∃ α_hat : FractionRing (Polynomial L) →+* FractionRing (Polynomial L),
          ∀ p : Polynomial L, α_hat (algebraMap _ _ p) = α_w p :=
      ⟨IsLocalization.lift (M := nonZeroDivisors (Polynomial L))
          (S := FractionRing (Polynomial L)) (g := α_w) hα_unit,
        IsLocalization.lift_eq (M := nonZeroDivisors (Polynomial L))
          (S := FractionRing (Polynomial L)) (g := α_w) hα_unit⟩
    have hτ_root_Qu :
        Polynomial.eval₂ α_hat τ
          (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))) = 0 := by
      have hQu_decomp :
          Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))) =
            Polynomial.X ^ d + ∑ j ∈ Finset.range d,
              Polynomial.C (algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Q.coeff j)) *
                Polynomial.X ^ j := by
        conv_lhs => rw [hQ_decomp]
        simp [Polynomial.map_sum, d]
      rw [hQu_decomp, Polynomial.eval₂_add, Polynomial.eval₂_X_pow,
        Polynomial.eval₂_finsetSum]
      refine Eq.trans ?_ hC2
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      simp [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow, hα_hat_eq]

    obtain ⟨e_hom, he_of, he_root⟩ :
        ∃ e_hom :
            AdjoinRoot (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L)))) →+*
              FractionRing (Polynomial L),
          (∀ u, e_hom (AdjoinRoot.of _ u) = α_hat u) ∧
          e_hom (AdjoinRoot.root _) = τ :=
      ⟨AdjoinRoot.lift α_hat τ hτ_root_Qu,
        fun u => AdjoinRoot.lift_of hτ_root_Qu,
        AdjoinRoot.lift_root hτ_root_Qu⟩
    have he_inj : Function.Injective e_hom := by
      have : Fact (Irreducible
          (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))))) := ⟨hIrr_Qu⟩
      exact e_hom.injective
    have he_const : ∀ c : L,
        e_hom (AdjoinRoot.of _
          (algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Polynomial.C c))) =
          algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Polynomial.C c) := by
      intro c
      rw [he_of, hα_hat_eq, hα_def]
      exact Polynomial.eval₂_C _ w
    have he_surj : Function.Surjective e_hom := by
      have hz_ex : ∃ ξ, e_hom ξ = z := by
        have huH_ne :
            AdjoinRoot.of (Q.map (algebraMap (Polynomial L) (FractionRing (Polynomial L))))
              (algebraMap _ _ H) ≠ 0 := by
          intro h0
          apply hC1
          have h1 := congrArg e_hom h0
          rw [map_zero, he_of, hα_hat_eq] at h1
          exact h1
        refine ⟨(∑ j : Fin d,
            AdjoinRoot.of _ (algebraMap _ _ (C j)) * (AdjoinRoot.root _) ^ j.1) *
            inv_ar (AdjoinRoot.of _ (algebraMap _ _ H)), ?_⟩
        apply mul_right_cancel₀ hC1
        have hinv_H :
            e_hom (inv_ar (AdjoinRoot.of _ (algebraMap _ _ H))) * α_w H = 1 := by
          have h1 := congrArg e_hom (hinv_cancel _ huH_ne)
          rw [map_mul, map_one, he_of, hα_hat_eq] at h1
          linear_combination h1
        rw [map_mul, map_sum, mul_assoc, hinv_H, mul_one]
        refine Eq.trans ?_ hC3
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, map_pow, he_of, he_root, hα_hat_eq]
      obtain ⟨ξ_z, hξ_z⟩ := hz_ex
      have hR_ex : ∀ p : Polynomial L,
          ∃ ξ, e_hom ξ = algebraMap (Polynomial L) (FractionRing (Polynomial L)) p := by
        intro p
        refine ⟨∑ k ∈ Finset.range (p.natDegree + 1),
          AdjoinRoot.of _ (algebraMap _ _ (Polynomial.C (p.coeff k))) * ξ_z ^ k, ?_⟩
        conv_rhs => rw [Polynomial.as_sum_range_C_mul_X_pow' p (Nat.lt_succ_self _)]
        rw [map_sum, map_sum]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [map_mul, map_pow, he_const (p.coeff k), hξ_z, hz_def, map_mul, map_pow]
      intro y
      obtain ⟨⟨a, s⟩, hs_eq⟩ := IsLocalization.surj (nonZeroDivisors (Polynomial L)) y
      have hs_ne : s.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hιs_ne : algebraMap (Polynomial L) (FractionRing (Polynomial L)) s.1 ≠ 0 :=
        fun h0 => hs_ne (hι_inj (by rw [h0, map_zero]))
      obtain ⟨ξ_a, hξ_a⟩ := hR_ex a
      obtain ⟨ξ_s, hξ_s⟩ := hR_ex s.1
      have hξ_s_ne : ξ_s ≠ 0 := fun h0 => hιs_ne (by rw [← hξ_s, h0, map_zero])
      refine ⟨ξ_a * inv_ar ξ_s, ?_⟩
      apply mul_right_cancel₀ hιs_ne
      have hinv_s : e_hom (inv_ar ξ_s) * algebraMap _ _ s.1 = 1 := by
        have h1 := congrArg e_hom (hinv_cancel _ hξ_s_ne)
        rw [map_mul, map_one, hξ_s] at h1
        linear_combination h1
      rw [map_mul, hξ_a, mul_assoc, hinv_s, mul_one, hs_eq]

    exact ⟨RingEquiv.ofBijective e_hom ⟨he_inj, he_surj⟩, he_const⟩

  
  constructor
  · rintro ⟨e_L, he_L⟩
    have he_trans : ∀ c : L,
        (θ.symm.trans e_L) (AdjoinRoot.of _
          (algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Polynomial.C c))) =
          algebraMap (Polynomial L) (FractionRing (Polynomial L)) (Polynomial.C c) := by
      intro c
      rw [RingEquiv.trans_apply, ← hθ_const c, θ.symm_apply_apply]
      exact (he_L c).trans (Localization.mk_one_eq_algebraMap _)
    obtain ⟨A₁, B₁, F₂, hA₁_deg, hB₁_deg, hF₂_deg, hB₁_ne, hEq3, hIndep⟩ :=
      hStep2 (θ.symm.trans e_L) he_trans
    obtain ⟨C, H, hC_deg, hH_deg, hEq2, hEq4⟩ :=
      hStep3 A₁ B₁ F₂ hA₁_deg hB₁_deg hF₂_deg hB₁_ne hIndep
    exact ⟨A₁, B₁, F₂, C, H, hA₁_deg, hB₁_deg, hF₂_deg, hC_deg, hH_deg, hEq2, hEq3, hEq4⟩
  · rintro ⟨A₁, B₁, F₂, C, H, _, _, _, hC_deg, hH_deg, hEq2, hEq3, hEq4⟩
    obtain ⟨e, he⟩ := hStep4 A₁ B₁ F₂ C H hC_deg hH_deg hEq2 hEq3 hEq4
    refine ⟨θ.trans e, fun c => ?_⟩
    rw [RingEquiv.trans_apply, hθ_const c, he c, Localization.mk_one_eq_algebraMap]

theorem weil_algClosed_projLine_funcField_and_poly_descent : (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (E : AlgebraicGeometry.Scheme.{u})
        (p_E : E ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω)),
      AlgebraicGeometry.IsIntegral E →
      AlgebraicGeometry.IsProper p_E →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 p_E →
      ∀ (U : E.Opens) (_hAff : AlgebraicGeometry.IsAffineOpen U) (_hNe : Nonempty ↥U)
        (α_U : Ω →+* ↑(E.presheaf.obj (Opposite.op U))),
        U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U) = U.ι ≫ p_E →
        ((∃ isoP1 : E ≅ (weilProjectiveSpaceOver Ω 1).left,
            p_E = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) ↔
         ∃ (e_K : FractionRing ↑(E.presheaf.obj (Opposite.op U)) ≃+* FractionRing (Polynomial Ω)),
           ∀ c : Ω, e_K (algebraMap _ _ (α_U c)) =
             algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) (Polynomial.C c))) ∧
    (∀ (B : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B]
        (K_bar : Type u) [Field K_bar] [IsAlgClosed K_bar]
        (ι_B : B →+* K_bar) (_hInj : Function.Injective ι_B)
        (P : Polynomial (Polynomial B)) (_hMon : P.Monic) (_hDeg : 1 ≤ P.natDegree),
      let P_bar : Polynomial (Polynomial K_bar) := P.map (Polynomial.mapRingHom ι_B)
      Irreducible P_bar →
      (∃ b₁ : B, b₁ ≠ 0 ∧
        ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (φ : B →+* Ω),
          φ b₁ ≠ 0 →
          Irreducible (P.map (Polynomial.mapRingHom φ)) ∧
          IsDomain (Polynomial (Polynomial Ω) ⧸
            Ideal.span ({P.map (Polynomial.mapRingHom φ)} : Set (Polynomial (Polynomial Ω))))) ∧
      ((¬ ∃ (e_bar : FractionRing (Polynomial (Polynomial K_bar) ⧸
              Ideal.span ({P_bar} : Set (Polynomial (Polynomial K_bar)))) ≃+*
              FractionRing (Polynomial K_bar)),
            ∀ c : K_bar,
              e_bar (Localization.mk
                  (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) =
                Localization.mk (Polynomial.C c) 1) →
        ∃ (b₂ : B), b₂ ≠ 0 ∧
          ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (φ : B →+* Ω),
            φ b₂ ≠ 0 →
            let Q_Ω : Type u := Polynomial (Polynomial Ω) ⧸
              Ideal.span ({P.map (Polynomial.mapRingHom φ)} : Set (Polynomial (Polynomial Ω)))
            ¬ ∃ (e_Ω : FractionRing Q_Ω ≃+* FractionRing (Polynomial Ω)),
                ∀ c : Ω,
                  e_Ω (Localization.mk
                      (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) =
                    Localization.mk (Polynomial.C c) 1)) :=
by
  refine ⟨?_, ?_⟩
  · intro Ω _ _ E p_E hInt hProp hSm U hAff hNe α_U hα_U
    obtain ⟨ι₀, ι₁, ρ₁, hOpen₀, hOpen₁, hHom₀, hHom₁, hCov,
        hRedP₁, hSepP₁, hDom₀, hρC, hρX, hGlue⟩ :=
      weil_projLine_twoChart_and_functionField_pkg Ω
    obtain ⟨F, instFieldF, instAlgΩF, η_F, hηF_comm, hFuncF, _⟩ :=
      weil_integral_scheme_functionField_over_field Ω E hInt p_E
    let _ : Field F := instFieldF
    let _ : Algebra Ω F := instAlgΩF
    obtain ⟨φ_U, hFracU, hφU_spec⟩ := hFuncF U hAff hNe
    have hSpec_α : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U) = hAff.fromSpec ≫ p_E := by
      have h1 := hAff.isoSpec.inv ≫= hα_U
      rw [← CategoryTheory.Category.assoc, ← hAff.isoSpec_hom, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc,
        hAff.isoSpec_inv_ι] at h1
      exact h1
    have hα_comm : ∀ c : Ω, φ_U.hom (α_U c) = algebraMap Ω F c := by
      have h2 : AlgebraicGeometry.Spec.map φ_U ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω F)) := by
        rw [hSpec_α, ← CategoryTheory.Category.assoc, hφU_spec, hηF_comm]
      rw [← AlgebraicGeometry.Spec.map_comp] at h2
      have h3 := AlgebraicGeometry.Spec.map_injective h2
      intro c
      simpa using congrArg (fun f => f.hom c) h3
    let _ : Algebra ↑(E.presheaf.obj (Opposite.op U)) F := φ_U.hom.toAlgebra
    let _ : IsFractionRing ↑(E.presheaf.obj (Opposite.op U)) F := hFracU
    let e_UF : FractionRing ↑(E.presheaf.obj (Opposite.op U)) ≃+* F :=
      (FractionRing.algEquiv ↑(E.presheaf.obj (Opposite.op U)) F).toRingEquiv
    have he_UF : ∀ c : Ω,
        e_UF (algebraMap _ (FractionRing ↑(E.presheaf.obj (Opposite.op U))) (α_U c)) =
          algebraMap Ω F c := by
      intro c
      exact ((FractionRing.algEquiv ↑(E.presheaf.obj (Opposite.op U)) F).commutes (α_U c)).trans
        (hα_comm c)
    have he_UF_symm : ∀ c : Ω,
        e_UF.symm (algebraMap Ω F c) =
          algebraMap _ (FractionRing ↑(E.presheaf.obj (Opposite.op U))) (α_U c) := by
      intro c
      rw [← he_UF c]
      exact e_UF.symm_apply_apply _
    have hIff_F :=
      weil_smooth_proper_curve_twoChart_birational_iso_iff Ω E (weilProjectiveSpaceOver Ω 1).left
        p_E (weilProjectiveSpaceOver Ω 1).hom hInt hProp hSm F η_F hηF_comm hFuncF
        ι₀ ι₁ ρ₁ hOpen₀ hOpen₁ hHom₀ hHom₁ hCov hRedP₁ hSepP₁ hDom₀ hρC hρX hGlue
    refine hIff_F.trans ⟨?_, ?_⟩
    · rintro ⟨e_F, he_F⟩
      refine ⟨e_UF.trans e_F, fun c => ?_⟩
      change e_F (e_UF (algebraMap _ _ (α_U c))) = _
      rw [he_UF c, he_F c]
    · rintro ⟨e_K, he_K⟩
      refine ⟨e_UF.symm.trans e_K, fun c => ?_⟩
      change e_K (e_UF.symm (algebraMap Ω F c)) = _
      rw [he_UF_symm c, he_K c]
  · intro B _ _ _ K_bar _ _ ι_B hInj P hMon hDeg P_bar hIrr_bar
    let d : ℕ := P.natDegree
    let M : ℕ := 1 + (Finset.range d).sup (fun k => (P.coeff k).natDegree)
    have hM : 1 ≤ M := Nat.le_add_right 1 _
    have hEval₂Hom : ∀ {τ : Type} {S : Type u} [CommSemiring S]
        (α : B →+* S) (w : τ → S) (g : MvPolynomial τ B),
        (MvPolynomial.eval₂Hom α w) g = MvPolynomial.eval₂ α w g :=
      fun _ _ _ => rfl
    have hMapP_monic : ∀ {L : Type u} [Field L] (φ : B →+* L),
        (P.map (Polynomial.mapRingHom φ)).Monic :=
      fun φ => hMon.map (Polynomial.mapRingHom φ)
    have hMapP_deg : ∀ {L : Type u} [Field L] (φ : B →+* L),
        (P.map (Polynomial.mapRingHom φ)).natDegree = d :=
      fun φ => hMon.natDegree_map (Polynomial.mapRingHom φ)
    have hMapP_coeff : ∀ {L : Type u} [Field L] (φ : B →+* L)
        (k : ℕ), k < (P.map (Polynomial.mapRingHom φ)).natDegree →
        ((P.map (Polynomial.mapRingHom φ)).coeff k).natDegree ≤ M := by
      intro L _ φ k hk
      rw [hMapP_deg φ] at hk
      rw [Polynomial.coeff_map, Polynomial.coe_mapRingHom]
      calc
        ((P.coeff k).map φ).natDegree ≤ (P.coeff k).natDegree := Polynomial.natDegree_map_le
        _ ≤ (Finset.range d).sup (fun i => (P.coeff i).natDegree) :=
          Finset.le_sup (f := fun i => (P.coeff i).natDegree) (Finset.mem_range.mpr hk)
        _ ≤ M := Nat.le_add_left _ 1
    have hFinPoly_deg : ∀ {L : Type u} [Semiring L] (N : ℕ) (c : Fin (N + 1) → L),
        (∑ k : Fin (N + 1), Polynomial.C (c k) * Polynomial.X ^ k.1).natDegree ≤ N := by
      intro L _ N c
      rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro m hm
      rw [Polynomial.finsetSum_coeff]
      refine Finset.sum_eq_zero fun k _ => ?_
      have hne : m ≠ k.1 := by omega
      simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, hne]
    have hFinPoly_eq : ∀ {L : Type u} [Semiring L] (N : ℕ) (p : Polynomial L),
        p.natDegree ≤ N →
        (∑ k : Fin (N + 1), Polynomial.C (p.coeff k.1) * Polynomial.X ^ k.1) = p := by
      intro L _ N p hp
      rw [Fin.sum_univ_eq_sum_range (fun k => Polynomial.C (p.coeff k) * Polynomial.X ^ k)]
      exact (Polynomial.as_sum_range_C_mul_X_pow' p (Nat.lt_succ_of_le hp)).symm
    have hMonicSum_props : ∀ {L : Type u} [Field L] (N : ℕ) (f : Fin N → Polynomial L),
        (∀ i : Fin N, (f i).natDegree ≤ M) →
        let Q_f : Polynomial (Polynomial L) :=
          Polynomial.X ^ N + ∑ i : Fin N, Polynomial.C (f i) * Polynomial.X ^ i.1
        Q_f.Monic ∧ Q_f.natDegree = N ∧ ∀ r < N, (Q_f.coeff r).natDegree ≤ M := by
      intro L _ N f hf Q_f
      have h_hi : ∀ r : ℕ, N < r → Q_f.coeff r = 0 := by
        intro r hr
        have hrN : r ≠ N := by omega
        simp only [Q_f, Polynomial.coeff_add, Polynomial.coeff_X_pow, hrN, ite_false,
          zero_add, Polynomial.finsetSum_coeff]
        refine Finset.sum_eq_zero fun i _ => ?_
        have hri : r ≠ i.1 := by omega
        simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, hri]
      have h_top : Q_f.coeff N = 1 := by
        simp only [Q_f, Polynomial.coeff_add, Polynomial.coeff_X_pow, ite_true,
          Polynomial.finsetSum_coeff]
        have h0 : (∑ i : Fin N, (Polynomial.C (f i) * Polynomial.X ^ i.1).coeff N) = 0 := by
          refine Finset.sum_eq_zero fun i _ => ?_
          have hNi : N ≠ i.1 := by omega
          simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, hNi]
        rw [h0, add_zero]
      have h_le : Q_f.natDegree ≤ N := Polynomial.natDegree_le_iff_coeff_eq_zero.mpr h_hi
      have h_ge : N ≤ Q_f.natDegree := by
        apply Polynomial.le_natDegree_of_ne_zero
        rw [h_top]
        exact one_ne_zero
      have h_deg : Q_f.natDegree = N := le_antisymm h_le h_ge
      have h_mon : Q_f.Monic := by
        rw [Polynomial.Monic, Polynomial.leadingCoeff, h_deg, h_top]
      refine ⟨h_mon, h_deg, ?_⟩
      intro r hr
      have hrN : r ≠ N := by omega
      have h_low : Q_f.coeff r = f ⟨r, hr⟩ := by
        simp only [Q_f, Polynomial.coeff_add, Polynomial.coeff_X_pow, hrN, ite_false,
          zero_add, Polynomial.finsetSum_coeff]
        rw [Finset.sum_eq_single ⟨r, hr⟩]
        · simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
        · intro i _ hi
          have hne : r ≠ i.1 := fun h => hi (Fin.ext h.symm)
          simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, hne]
        · intro h_abs
          exact False.elim (h_abs (Finset.mem_univ _))
      rw [h_low]
      exact hf ⟨r, hr⟩
    have hMonicSum_eq : ∀ {L : Type u} [Field L] (N : ℕ) (Q_0 : Polynomial (Polynomial L)),
        Q_0.Monic → Q_0.natDegree = N →
