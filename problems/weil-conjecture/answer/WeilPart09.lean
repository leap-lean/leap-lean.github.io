          rcases hFin2 b with rfl | rfl
          · simp only [htDiag_P1 0, map_one]
          · rw [hψ₂_t 1, show (![1, q₂] : Fin (1 + 1) → _) 1 = q₂ from rfl, hχ0_t]
            exact hq₂_F
      have hTop : (⊤ : Subring (Γ_chart 0)) ≤ RingHom.eqLocus (φ_W2.hom.comp ψ₂) χ_0 := by
        rw [← hGen_P1 0]
        exact Subring.closure_le.mpr hSub
      ext x
      exact hTop (Subring.mem_top x)
    let ψ₂_hom : P₁.presheaf.obj (Opposite.op (V_chart 0)) ⟶
        Y.presheaf.obj (Opposite.op (Y.basicOpen s_reg)) := CommRingCat.ofHom ψ₂
    let g₂ : (Y.basicOpen s_reg).toScheme ⟶ P₁ :=
      (Y.basicOpen s_reg).toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ₂_hom ≫ (hAff_P1 0).fromSpec
    refine ⟨g₂, η_W2, ?_, hηW2_ι, ?_⟩
    · dsimp [g₂]
      have hc_comp : CommRingCat.ofHom (c_P1 0) ≫ ψ₂_hom =
          CommRingCat.ofHom (α_Y (Y.basicOpen s_reg)) := by
        ext r
        exact RingHom.congr_fun hψ₂_c r
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← hcSpec_P1 0, ← AlgebraicGeometry.Spec.map_comp, hc_comp,
        hSpec_α (Y.basicOpen s_reg) hAff2_bo, ← CategoryTheory.Category.assoc,
        hAff2_bo.toSpecΓ_fromSpec]
    · dsimp [g₂, η_W2]
      have hhom : ψ₂_hom ≫ φ_W2 = CommRingCat.ofHom χ_0 := by
        ext x
        exact RingHom.congr_fun hψ₂_F x
      rw [← hAff2_bo.isoSpec_hom, CategoryTheory.Category.assoc,
        CategoryTheory.Iso.inv_hom_id_assoc, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, hhom]
  have hg_ex : ∀ i : Fin 3,
      ∃ (g_i : (W i).toScheme ⟶ P₁)
        (η_Wi : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (W i).toScheme),
        g_i ≫ p_P1 = (W i).ι ≫ p_Y ∧ η_Wi ≫ (W i).ι = η_Y ∧ η_Wi ≫ g_i = η_X := by
    intro i
    rcases hFin3 i with rfl | rfl | rfl
    · exact hg0_ex
    · exact hg1_ex
    · exact hg2_ex
  choose g η_W hg_base hηW_ι hηW_g using hg_ex

  
  have : AlgebraicGeometry.IsProper p_P1 := hProp_P1
  have hg_glue : ∀ i j : Fin 3,
      CategoryTheory.Limits.pullback.fst (W i).ι (W j).ι ≫ g i =
        CategoryTheory.Limits.pullback.snd (W i).ι (W j).ι ≫ g j := by
    intro i j
    let fst_ij := CategoryTheory.Limits.pullback.fst (W i).ι (W j).ι
    let snd_ij := CategoryTheory.Limits.pullback.snd (W i).ι (W j).ι
    have : AlgebraicGeometry.IsOpenImmersion (fst_ij ≫ (W i).ι) := inferInstance
    have : AlgebraicGeometry.IsReduced (CategoryTheory.Limits.pullback (W i).ι (W j).ι) :=
      AlgebraicGeometry.isReduced_of_isOpenImmersion (fst_ij ≫ (W i).ι)
    let η_ij : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶
        CategoryTheory.Limits.pullback (W i).ι (W j).ι :=
      CategoryTheory.Limits.pullback.lift (η_W i) (η_W j) ((hηW_ι i).trans (hηW_ι j).symm)
    have hη_comp : η_ij ≫ (fst_ij ≫ (W i).ι) = η_Y := by
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      exact hηW_ι i
    have : AlgebraicGeometry.IsDominant η_ij := by
      have : AlgebraicGeometry.IsDominant (η_ij ≫ (fst_ij ≫ (W i).ι)) := by rwa [hη_comp]
      exact AlgebraicGeometry.IsDominant.of_comp_of_isOpenImmersion η_ij (fst_ij ≫ (W i).ι)
    have h_base_ij : (fst_ij ≫ g i) ≫ p_P1 = (snd_ij ≫ g j) ≫ p_P1 := by
      rw [CategoryTheory.Category.assoc, hg_base i, CategoryTheory.Category.assoc, hg_base j]
      exact CategoryTheory.Limits.pullback.condition_assoc p_Y
    have h_gen_ij : η_ij ≫ (fst_ij ≫ g i) = η_ij ≫ (snd_ij ≫ g j) := by
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hηW_g i,
        ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hηW_g j]
    exact AlgebraicGeometry.ext_of_isDominant_of_isSeparated p_P1 h_base_ij η_ij h_gen_ij
  let 𝒰 := Y.openCoverOfIsOpenCover W hCoverW
  let π : Y ⟶ P₁ := AlgebraicGeometry.Scheme.Cover.glueMorphisms 𝒰 g hg_glue
  have hι_π : ∀ i : Fin 3, (W i).ι ≫ π = g i :=
    AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms 𝒰 g hg_glue
  have hπ_base : π ≫ p_P1 = p_Y := by
    apply AlgebraicGeometry.Scheme.Cover.hom_ext 𝒰
    intro i
    change (W i).ι ≫ (π ≫ p_P1) = (W i).ι ≫ p_Y
    rw [← CategoryTheory.Category.assoc, hι_π i, hg_base i]
  have hπ_η : η_Y ≫ π = η_X := by
    rw [← hηW_ι 0, CategoryTheory.Category.assoc, hι_π 0, hηW_g 0]
  have : AlgebraicGeometry.IsProper (π ≫ p_P1) := by
    rw [hπ_base]
    infer_instance
  have hProp_π : AlgebraicGeometry.IsProper π := AlgebraicGeometry.IsProper.of_comp π p_P1
  have : AlgebraicGeometry.IsProper π := hProp_π

  
  have hLocQF : ∀ z : Y,
      ∃ (U_X : P₁.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
        (V_C : Y.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
        (e_X : V_C ≤ (TopologicalSpace.Opens.map π.base).obj U_X),
        z ∈ V_C ∧
        (π.appLE U_X V_C e_X).hom.FiniteType ∧
        (π.appLE U_X V_C e_X).hom.QuasiFinite := by
    intro z
    have ha_ex : ∃ a : Fin (1 + 1), π.base z ∈ V_chart a := by
      rcases hMemChart (π.base z) with hz0 | hz1
      · exact ⟨0, hz0⟩
      · exact ⟨1, hz1⟩
    obtain ⟨a, hz_a⟩ := ha_ex
    let U_X : P₁.Opens := V_chart a
    have hUX : AlgebraicGeometry.IsAffineOpen U_X := hAff_P1 a
    have hUX_ne : Nonempty ↥U_X := ⟨⟨π.base z, hz_a⟩⟩
    obtain ⟨V_C, hVC, hz_VC, e_X_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (U := (TopologicalSpace.Opens.map π.base).obj U_X) (x := z) hz_a
    have e_X : V_C ≤ (TopologicalSpace.Opens.map π.base).obj U_X := e_X_sub
    have hVC_ne : Nonempty ↥V_C := ⟨⟨z, hz_VC⟩⟩
    have hFT : (π.appLE U_X V_C e_X).hom.FiniteType :=
      AlgebraicGeometry.LocallyOfFiniteType.finiteType_appLE π hUX hVC e_X
    refine ⟨U_X, hUX, V_C, hVC, e_X, hz_VC, hFT, ?_⟩
    let A_a : Type u := Γ_chart a
    let B_C : Type u := ↑(Y.presheaf.obj (Opposite.op V_C))
    let α_a : A_a →+* B_C := (π.appLE U_X V_C e_X).hom
    have : Nonempty ↥(V_C : AlgebraicGeometry.Scheme.{u}) := hVC_ne
    have : IsDomain B_C := @AlgebraicGeometry.IsIntegral.component_integral Y _ V_C _
    have : IsDomain A_a := hDom_chart a
    obtain ⟨φ_BC, _hFrac_BC, hφ_BC⟩ := hFuncY V_C hVC hVC_ne
    obtain ⟨φ_Aa, hFrac_Aa, hφ_Aa⟩ := hFunc_P1 U_X hUX hUX_ne
    have hInjB : Function.Injective φ_BC.hom :=
      @IsFractionRing.injective B_C _ F _ φ_BC.hom.toAlgebra _hFrac_BC
    have hInjA : Function.Injective φ_Aa.hom :=
      @IsFractionRing.injective A_a _ F _ φ_Aa.hom.toAlgebra hFrac_Aa
    have hComp : ∀ x_a : A_a, φ_BC.hom (α_a x_a) = φ_Aa.hom x_a := by
      have hm := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π hUX hVC e_X
      have heq : AlgebraicGeometry.Spec.map (π.appLE U_X V_C e_X ≫ φ_BC) ≫ hUX.fromSpec =
          AlgebraicGeometry.Spec.map φ_Aa ≫ hUX.fromSpec := by
        rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hm,
          ← CategoryTheory.Category.assoc, hφ_BC, hπ_η, hφ_Aa]
      have heq2 := (CategoryTheory.cancel_mono hUX.fromSpec).mp heq
      have heq3 := AlgebraicGeometry.Spec.map_injective heq2
      intro x_a
      exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom heq3) x_a
    letI : Algebra A_a B_C := α_a.toAlgebra
    have : Algebra.FiniteType A_a B_C := hFT
    change Algebra.QuasiFinite A_a B_C
    rw [Algebra.QuasiFinite.iff_finite_primesOver]
    intro p hp
    apply Set.Subsingleton.finite
    intro q₁ hq₁ q₂ hq₂
    have hq₁_prime : q₁.IsPrime := hq₁.1
    have hq₂_prime : q₂.IsPrime := hq₂.1
    have : q₁.LiesOver p := hq₁.2
    have : q₂.LiesOver p := hq₂.2
    have hq₁_over : Ideal.comap α_a q₁ = p := (Ideal.LiesOver.over (P := q₁) (p := p)).symm
    have hq₂_over : Ideal.comap α_a q₂ = p := (Ideal.LiesOver.over (P := q₂) (p := p)).symm
    let ψ_a : Polynomial k₀ →+* F := φ_Aa.hom.comp (e_P1 a).toRingHom
    have hInjψ : Function.Injective ψ_a := hInjA.comp (e_P1 a).injective
    ext b
    obtain ⟨⟨a_num, b_den⟩, h_surj⟩ :=
      @IsLocalization.surj A_a _ (nonZeroDivisors A_a) F _ φ_Aa.hom.toAlgebra hFrac_Aa (φ_BC.hom b)
    dsimp at h_surj
    have hb_ne : (b_den : A_a) ≠ 0 := nonZeroDivisors.ne_zero b_den.2
    let P₁_poly := (e_P1 a).symm a_num
    let Q₁_poly := (e_P1 a).symm (b_den : A_a)
    have hQ₁_ne : Q₁_poly ≠ 0 := by
      intro h0
      exact hb_ne ((e_P1 a).symm.injective (h0.trans (map_zero (e_P1 a).symm).symm))
    have h_eq1 : φ_BC.hom b * ψ_a Q₁_poly = ψ_a P₁_poly := by
      dsimp [ψ_a, P₁_poly, Q₁_poly]
      rw [(e_P1 a).apply_symm_apply, (e_P1 a).apply_symm_apply]
      exact h_surj
    let d := EuclideanDomain.gcd P₁_poly Q₁_poly
    have hd_ne : d ≠ 0 := by
      intro h0
      exact hQ₁_ne (EuclideanDomain.gcd_eq_zero_iff.mp h0).2
    obtain ⟨⟨P', hP₁_eq⟩, ⟨Q', hQ₁_eq⟩⟩ := EuclideanDomain.gcd_dvd P₁_poly Q₁_poly
    have hQ'_ne : Q' ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hQ₁_eq
      exact hQ₁_ne hQ₁_eq
    have hCop : IsCoprime P' Q' := by
      apply EuclideanDomain.isCoprime_of_dvd
      · rintro ⟨_, hQ0⟩
        exact hQ'_ne hQ0
      · intro z_div hz_nu _hz_n0 ⟨u₁, hu₁⟩ ⟨u₂, hu₂⟩
        have hdz_P₁ : d * z_div ∣ P₁_poly := ⟨u₁, by rw [hP₁_eq, hu₁, mul_assoc]⟩
        have hdz_Q₁ : d * z_div ∣ Q₁_poly := ⟨u₂, by rw [hQ₁_eq, hu₂, mul_assoc]⟩
        obtain ⟨w, hw⟩ := EuclideanDomain.dvd_gcd hdz_P₁ hdz_Q₁
        have h1 : d * 1 = d * (z_div * w) := by
          rw [mul_one, ← mul_assoc]
          exact hw
        have hzw : z_div * w = 1 := (mul_left_cancel₀ hd_ne h1).symm
        exact hz_nu (IsUnit.of_mul_eq_one w hzw)
    obtain ⟨u_bez, v_bez, hBez⟩ := hCop
    have h_eq2 : φ_BC.hom b * ψ_a Q' = ψ_a P' := by
      apply mul_left_cancel₀ (a := ψ_a d)
      · intro h0
        exact hd_ne (hInjψ (h0.trans (map_zero ψ_a).symm))
      · calc
          ψ_a d * (φ_BC.hom b * ψ_a Q') = φ_BC.hom b * (ψ_a d * ψ_a Q') := by ring
          _ = φ_BC.hom b * ψ_a Q₁_poly := by rw [← map_mul, ← hQ₁_eq]
          _ = ψ_a P₁_poly := h_eq1
          _ = ψ_a d * ψ_a P' := by rw [hP₁_eq, map_mul]
    let p' := e_P1 a P'
    let q' := e_P1 a Q'
    let u' := e_P1 a u_bez
    let v' := e_P1 a v_bez
    have hBez_A : u' * p' + v' * q' = 1 := by
      dsimp [p', q', u', v']
      rw [← map_mul, ← map_mul, ← map_add, hBez, map_one]
    have h_rel_B : α_a q' * b = α_a p' := by
      apply hInjB
      rw [map_mul, hComp q', hComp p']
      dsimp [q', p']
      calc
        φ_Aa.hom (e_P1 a Q') * φ_BC.hom b = φ_BC.hom b * ψ_a Q' := mul_comm _ _
        _ = ψ_a P' := h_eq2
        _ = φ_Aa.hom (e_P1 a P') := rfl
    have hq'_not_p : q' ∉ p := by
      intro hq'_p
      have hq'_q₁ : α_a q' ∈ q₁ := by
        show q' ∈ Ideal.comap α_a q₁
        rwa [hq₁_over]
      have hp'_q₁ : α_a p' ∈ q₁ := by
        rw [← h_rel_B]
        exact q₁.mul_mem_right b hq'_q₁
      have hp'_p : p' ∈ p := by
        rw [← hq₁_over]
        exact hp'_q₁
      have h1_p : (1 : A_a) ∈ p := by
        rw [← hBez_A]
        exact p.add_mem (p.mul_mem_left u' hp'_p) (p.mul_mem_left v' hq'_p)
      exact hp.ne_top (p.eq_top_iff_one.mpr h1_p)
    have hq'_not_q₁ : α_a q' ∉ q₁ := fun h => hq'_not_p (hq₁_over ▸ h)
    have hq'_not_q₂ : α_a q' ∉ q₂ := fun h => hq'_not_p (hq₂_over ▸ h)
    have hb_iff₁ : b ∈ q₁ ↔ p' ∈ p := by
      constructor
      · intro hb
        have : α_a p' ∈ q₁ := by
          rw [← h_rel_B]
          exact q₁.mul_mem_left (α_a q') hb
        rwa [← hq₁_over]
      · intro hp'
        have h_in : α_a p' ∈ q₁ := by
          show p' ∈ Ideal.comap α_a q₁
          rwa [hq₁_over]
        have : α_a q' * b ∈ q₁ := by rwa [h_rel_B]
        exact (hq₁_prime.mem_or_mem this).resolve_left hq'_not_q₁
    have hb_iff₂ : b ∈ q₂ ↔ p' ∈ p := by
      constructor
      · intro hb
        have : α_a p' ∈ q₂ := by
          rw [← h_rel_B]
          exact q₂.mul_mem_left (α_a q') hb
        rwa [← hq₂_over]
      · intro hp'
        have h_in : α_a p' ∈ q₂ := by
          show p' ∈ Ideal.comap α_a q₂
          rwa [hq₂_over]
        have : α_a q' * b ∈ q₂ := by rwa [h_rel_B]
        exact (hq₂_prime.mem_or_mem this).resolve_left hq'_not_q₂
    exact hb_iff₁.trans hb_iff₂.symm

  
  have : CategoryTheory.IsIso π :=
    hBirIso Y F π η_Y η_X inferInstance hInt_P1 hNorm_P1 hProp_π hDom_ηY
      hπ_η hFuncY hFunc_P1 hLocQF
  refine ⟨CategoryTheory.asIso π, ?_⟩
  rw [CategoryTheory.asIso_hom]
  exact hπ_base.symm

theorem weil_twoChart_p1_tree_pole_squeeze_and_component_iso (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (hAff_P1 : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen k₀ 1 a))
    (c_P1 : ∀ a : Fin (1 + 1),
      k₀ →+* ↑((weilProjectiveSpaceOver k₀ 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen k₀ 1 a))))
    (t_P1 : ∀ a : Fin (1 + 1), Fin (1 + 1) →
