      rw [Units.val_pow_eq_pow_val, hu_ZB₄, h_alg_eq, ← map_pow, ← map_mul, ← map_mul, h_Qbig_prod]
    let Q_D : MvPolynomial Unit D :=
      MvPolynomial.C c₂ * (MvPolynomial.X ()) ^ 2 -
        MvPolynomial.C (2 * a₂₀ + a₁₁) * MvPolynomial.X () + MvPolynomial.C a₂₀
    let D_Q : Type u := MvPolynomial Unit D ⧸ Ideal.span (Set.range (fun _ : Unit => Q_D))
    let π_DQ : MvPolynomial Unit D →+* D_Q :=
