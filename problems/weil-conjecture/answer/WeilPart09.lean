          algebraMap (C_aff ⧸ 𝔭) K_p (Ideal.Quotient.mk 𝔭 c) :=
      fun c => hψ_res1 c
    have hCocycle : ∀ (D : ℕ) (f : C_aff) (b : B₀),
        res₀ b = (res₀ y₁) ^ D * res₁ f →
        (ι_B (Ideal.Quotient.mk 𝔮 y₁)) ^ D *
          algebraMap (C_aff ⧸ 𝔭) K_p (Ideal.Quotient.mk 𝔭 f) =
          ι_B (Ideal.Quotient.mk 𝔮 b) := by
      intro D f b hb
      rw [← hI01_res0 y₁, ← hI01_res1 f, ← hI01_res0 b, ← map_pow, ← map_mul, ← map_pow, ← map_mul, hb]
    have hDenom : ∀ c : C_aff ⧸ 𝔭,
        ∃ (k : ℕ) (b : B₀ ⧸ 𝔮),
          (ι_B (Ideal.Quotient.mk 𝔮 y₁)) ^ k * algebraMap (C_aff ⧸ 𝔭) K_p c = ι_B b := by
      intro c
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective c
      obtain ⟨k, b₀, hfb⟩ :=
        @IsLocalization.Away.surj B₀ _ B_01 _ res₀.toRingHom.toAlgebra y₁ hLoc0 (res₁ f)
      refine ⟨k, Ideal.Quotient.mk 𝔮 b₀, ?_⟩
      exact hCocycle k f b₀ (by rw [mul_comm]; exact hfb.symm)
    have hybar_ne : Ideal.Quotient.mk 𝔮 y₁ ≠ 0 :=
      fun h0 => hy₁_not_q (Ideal.Quotient.eq_zero_iff_mem.mp h0)
    have hFrac_IB : @IsFractionRing (B₀ ⧸ 𝔮) _ K_p _ ι_B.toRingHom.toAlgebra := by
      let _ : Algebra (B₀ ⧸ 𝔮) K_p := ι_B.toRingHom.toAlgebra
      refine
        { map_units := fun s => by
            have hs0 : (s : B₀ ⧸ 𝔮) ≠ 0 := nonZeroDivisors.ne_zero s.2
            exact IsUnit.mk0 (ι_B s.1) (fun h0 => hs0 (hInj_IB (h0.trans (map_zero ι_B).symm)))
          surj := fun z => by
