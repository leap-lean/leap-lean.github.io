          _ = algebraMap N L_N s₀.1 * algebraMap N L_N s₁.1 * (x₀_loc * w₀) := by ring
          _ = algebraMap N L_N s₀.1 * algebraMap N L_N s₁.1 * (x₁_loc * w₁) := by rw [← hw₀, ← hw₁]
          _ = algebraMap N L_N s₀.1 * (w₁ * algebraMap N L_N s₁.1) * x₁_loc := by ring
          _ = algebraMap N L_N s₀.1 * algebraMap N L_N a₁ * x₁_loc := by rw [← ha₁_eq]
      obtain ⟨s₂, hs₂_eq⟩ := (IsLocalization.eq_iff_exists q_N.primeCompl L_N).mp h_eq_L
      have h_in_inter : s₂.1 * (s₁.1 * a₀ * x0_bar) ∈ Ideal.span {x0_bar} ⊓ Ideal.span {x1_bar} := by
        refine ⟨?_, ?_⟩
        · exact Ideal.mem_span_singleton.mpr ⟨s₂.1 * (s₁.1 * a₀), by ring⟩
        · rw [hs₂_eq]
