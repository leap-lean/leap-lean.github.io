          · intro h; have := congrArg (· 1) h; simp [d01, d00] at this
          · intro h; have := congrArg (· 0) h; simp [d20, d00] at this
          · intro h; have := congrArg (· 1) h; simp [d02, d00] at this
          · intro h; have := congrArg (· 1) h; simp [d01, d10] at this
          · intro h; have := congrArg (· 0) h; simp [d20, d10] at this
          · intro h; have := congrArg (· 1) h; simp [d02, d10] at this
          · intro h; have := congrArg (· 0) h; simp [d20, d01] at this
          · intro h; have := congrArg (· 1) h; simp [d02, d01] at this
