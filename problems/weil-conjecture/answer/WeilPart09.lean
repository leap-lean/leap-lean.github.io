          by_cases hm : Eq3_gen.coeff m = 0
          · rw [hm, map_zero]
          · have hmem : MvPolynomial.rename Sum.inl (Eq3_gen.coeff m) ∈ S_birat ν :=
              Finset.mem_insert_of_mem (Finset.mem_union_left _
                (Finset.mem_image.mpr ⟨m, Polynomial.mem_support_iff.mpr hm, rfl⟩))
            rw [← hRename]
            exact hz _ hmem
        have hEq4_zero : Eq4_gen.map ψ = 0 := by
          ext m
          rw [Polynomial.coeff_zero, Polynomial.coeff_map]
          by_cases hm : Eq4_gen.coeff m = 0
          · rw [hm, map_zero]
          · have hmem : MvPolynomial.rename Sum.inl (Eq4_gen.coeff m) ∈ S_birat ν :=
              Finset.mem_insert_of_mem (Finset.mem_union_right _
                (Finset.mem_image.mpr ⟨m, Polynomial.mem_support_iff.mpr hm, rfl⟩))
            rw [← hRename]
            exact hz _ hmem
        have hNondeg_ne : R_nondeg_gen.map ψ ≠ 0 := by
          have hrab := hz (f_rab ν) (Finset.mem_insert_self _ _)
          dsimp [f_rab] at hrab
          rw [MvPolynomial.eval₂_sub, MvPolynomial.eval₂_mul, hRename,
            MvPolynomial.eval₂_X, MvPolynomial.eval₂_one, sub_eq_zero] at hrab
          intro hZero
          have hc0 : ψ (R_nondeg_gen.coeff ν) = 0 := by
            have := congrArg (fun q => q.coeff ν) hZero
            simpa [Polynomial.coeff_map] using this
          rw [hc0, zero_mul] at hrab
          exact zero_ne_one hrab
        let A₁' := A₁_gen.map ψ
        let B₁' := B₁_gen.map ψ
        let F₂' := F₂_gen.map ψ
        let C' : Fin d → Polynomial K_bar := fun j => (C_gen j).map ψ
        let H' := H_gen.map ψ
        have hA₁'_deg : A₁'.natDegree ≤ d := by
          dsimp [A₁', A₁_gen]
          simpa [Polynomial.map_sum] using hFinPoly_deg d (fun k => ψ (MvPolynomial.X (vA k)))
        have hB₁'_deg : B₁'.natDegree ≤ d := by
          dsimp [B₁', B₁_gen]
          simpa [Polynomial.map_sum] using hFinPoly_deg d (fun k => ψ (MvPolynomial.X (vB k)))
        have hF₂'_deg : F₂'.natDegree ≤ M * d := by
          dsimp [F₂', F₂_gen]
          simpa [Polynomial.map_sum] using
            hFinPoly_deg (M * d) (fun k => ψ (MvPolynomial.X (vF k)))
        have hC'_deg : ∀ j : Fin d, (C' j).natDegree ≤ K_max := by
          intro j; dsimp [C', C_gen]
          simpa [Polynomial.map_sum] using
            hFinPoly_deg K_max (fun k => ψ (MvPolynomial.X (vC j k)))
        have hH'_deg : H'.natDegree ≤ K_max := by
          dsimp [H', H_gen]
          simpa [Polynomial.map_sum] using
            hFinPoly_deg K_max (fun k => ψ (MvPolynomial.X (vH k)))
        have hNondeg_eval : R_nondeg_gen.map ψ =
            B₁' * (∑ k ∈ Finset.range (K_max + 1),
              Polynomial.C (H'.coeff k) * A₁' ^ k * B₁' ^ (K_max - k)) := by
          simp [R_nondeg_gen, HomogH_gen, A₁', B₁', H', Polynomial.map_sum, Polynomial.coeff_map]
        have hEq3_eval : Eq3_gen.map ψ =
            F₂' ^ d + (∑ j ∈ Finset.range d,
              B₁' ^ (M * (d - 1 - j)) *
                (∑ k ∈ Finset.range (M + 1),
                  Polynomial.C ((P_bar.coeff j).coeff k) * A₁' ^ k * B₁' ^ (M - k)) * F₂' ^ j) := by
          simp [Eq3_gen, A₁', B₁', F₂', P_bar, ψ, Polynomial.map_sum, Polynomial.coeff_map,
            Polynomial.coe_mapRingHom, hEval₂Hom]
        have hEq4_eval : Eq4_gen.map ψ =
            (∑ j : Fin d,
              B₁' ^ (M * (d - 1 - j.1)) *
                (∑ k ∈ Finset.range (K_max + 1),
                  Polynomial.C ((C' j).coeff k) * A₁' ^ k * B₁' ^ (K_max - k)) * F₂' ^ j.1) -
              Polynomial.X * B₁' ^ (M * (d - 1)) *
                (∑ k ∈ Finset.range (K_max + 1),
                  Polynomial.C (H'.coeff k) * A₁' ^ k * B₁' ^ (K_max - k)) := by
          simp [Eq4_gen, HomogH_gen, A₁', B₁', F₂', C', H', Polynomial.map_sum,
            Polynomial.coeff_map]
        rw [hNondeg_eval] at hNondeg_ne
        rw [hEq3_eval] at hEq3_zero
        rw [hEq4_eval] at hEq4_zero
        have hRat_bar := (hRat_iff K_bar P_bar d (hMapP_deg ι_B)
          (hMapP_monic ι_B) hDeg hIrr_bar
          (fun k hk => hMapP_coeff ι_B k (by rwa [hMapP_deg ι_B]))).mpr
          ⟨A₁', B₁', F₂', C', H',
            hA₁'_deg, hB₁'_deg, hF₂'_deg, hC'_deg, hH'_deg,
            hNondeg_ne, hEq3_zero, hEq4_zero⟩
        exact hNonRat_bar hRat_bar
      exact weil_nullstellensatz_mvPolynomial_system_descent B K_bar ι_B hInj (S_birat ν) hUnsat_ν
    choose b_rat hb_rat_ne hb_rat_no using hPerCoeff
    let b₂ : B := b₁ * ∏ ν_x ∈ R_nondeg_gen.support.attach, b_rat ν_x
    have hb₂_ne : b₂ ≠ 0 :=
      mul_ne_zero hb₁_ne (Finset.prod_ne_zero_iff.mpr (fun ν_x _ => hb_rat_ne ν_x))
    refine ⟨b₂, hb₂_ne, ?_⟩
    intro Ω _ _ φ hφ_b₂ Q_Ω ⟨e_Ω, he_Ω⟩
    have hφ_mul : φ b₁ * φ (∏ ν_x ∈ R_nondeg_gen.support.attach, b_rat ν_x) ≠ 0 := by
      rwa [← map_mul]
    have hφ_b₁ : φ b₁ ≠ 0 := left_ne_zero_of_mul hφ_mul
    have hφ_prod : ∏ ν_x ∈ R_nondeg_gen.support.attach, φ (b_rat ν_x) ≠ 0 := by
      rw [← map_prod]
      exact right_ne_zero_of_mul hφ_mul
    let P_Ω := P.map (Polynomial.mapRingHom φ)
    have hIrr_Ω : Irreducible P_Ω := (hb₁_spec Ω φ hφ_b₁).1
    obtain ⟨A₁, B₁, F₂, C, H,
        hA₁_deg, hB₁_deg, hF₂_deg, hC_deg, hH_deg,
        hNondeg_Ω, hEq3_Ω, hEq4_Ω⟩ :=
      (hRat_iff Ω P_Ω d (hMapP_deg φ) (hMapP_monic φ) hDeg hIrr_Ω
        (fun k hk => hMapP_coeff φ k (by rwa [hMapP_deg φ]))).mp ⟨e_Ω, he_Ω⟩
    let y : σ₂ → Ω := fun v =>
      match v with
      | Sum.inl k => A₁.coeff k.1
      | Sum.inr (Sum.inl k) => B₁.coeff k.1
      | Sum.inr (Sum.inr (Sum.inl k)) => F₂.coeff k.1
      | Sum.inr (Sum.inr (Sum.inr (Sum.inl jk))) => (C jk.1).coeff jk.2.1
      | Sum.inr (Sum.inr (Sum.inr (Sum.inr k))) => H.coeff k.1
    let ψ : R₂ →+* Ω := MvPolynomial.eval₂Hom φ y
    have hA₁_map : A₁_gen.map ψ = A₁ := by
      have h1 : A₁_gen.map ψ = ∑ k : Fin (d + 1), Polynomial.C (A₁.coeff k.1) * Polynomial.X ^ k.1 := by
        simp [A₁_gen, ψ, y, vA, Polynomial.map_sum, hEval₂Hom]
      rw [h1, hFinPoly_eq d A₁ hA₁_deg]
    have hB₁_map : B₁_gen.map ψ = B₁ := by
      have h1 : B₁_gen.map ψ = ∑ k : Fin (d + 1), Polynomial.C (B₁.coeff k.1) * Polynomial.X ^ k.1 := by
        simp [B₁_gen, ψ, y, vB, Polynomial.map_sum, hEval₂Hom]
      rw [h1, hFinPoly_eq d B₁ hB₁_deg]
    have hF₂_map : F₂_gen.map ψ = F₂ := by
      have h1 : F₂_gen.map ψ =
          ∑ k : Fin (M * d + 1), Polynomial.C (F₂.coeff k.1) * Polynomial.X ^ k.1 := by
        simp [F₂_gen, ψ, y, vF, Polynomial.map_sum, hEval₂Hom]
      rw [h1, hFinPoly_eq (M * d) F₂ hF₂_deg]
    have hC_map : ∀ j : Fin d, (C_gen j).map ψ = C j := by
      intro j
      have h1 : (C_gen j).map ψ =
          ∑ k : Fin (K_max + 1), Polynomial.C ((C j).coeff k.1) * Polynomial.X ^ k.1 := by
        simp [C_gen, ψ, y, vC, Polynomial.map_sum, hEval₂Hom]
      rw [h1, hFinPoly_eq K_max (C j) (hC_deg j)]
    have hH_map : H_gen.map ψ = H := by
      have h1 : H_gen.map ψ =
          ∑ k : Fin (K_max + 1), Polynomial.C (H.coeff k.1) * Polynomial.X ^ k.1 := by
        simp [H_gen, ψ, y, vH, Polynomial.map_sum, hEval₂Hom]
      rw [h1, hFinPoly_eq K_max H hH_deg]
    have hNondeg_map : R_nondeg_gen.map ψ =
        B₁ * (∑ k ∈ Finset.range (K_max + 1),
          Polynomial.C (H.coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) := by
      have h1 : R_nondeg_gen.map ψ =
          (B₁_gen.map ψ) * (∑ k ∈ Finset.range (K_max + 1),
            Polynomial.C ((H_gen.map ψ).coeff k) * (A₁_gen.map ψ) ^ k *
              (B₁_gen.map ψ) ^ (K_max - k)) := by
        simp [R_nondeg_gen, HomogH_gen, Polynomial.map_sum, Polynomial.coeff_map]
      rw [h1, hA₁_map, hB₁_map, hH_map]
    have hEq3_map : Eq3_gen.map ψ =
        F₂ ^ d + (∑ j ∈ Finset.range d,
          B₁ ^ (M * (d - 1 - j)) *
            (∑ k ∈ Finset.range (M + 1),
              Polynomial.C ((P_Ω.coeff j).coeff k) * A₁ ^ k * B₁ ^ (M - k)) * F₂ ^ j) := by
      have h1 : Eq3_gen.map ψ =
          (F₂_gen.map ψ) ^ d + (∑ j ∈ Finset.range d,
            (B₁_gen.map ψ) ^ (M * (d - 1 - j)) *
              (∑ k ∈ Finset.range (M + 1),
                Polynomial.C ((P_Ω.coeff j).coeff k) * (A₁_gen.map ψ) ^ k *
                  (B₁_gen.map ψ) ^ (M - k)) * (F₂_gen.map ψ) ^ j) := by
        simp [Eq3_gen, P_Ω, ψ, Polynomial.map_sum, Polynomial.coeff_map,
          Polynomial.coe_mapRingHom, hEval₂Hom]
      rw [h1, hA₁_map, hB₁_map, hF₂_map]
    have hEq4_map : Eq4_gen.map ψ =
        (∑ j : Fin d,
          B₁ ^ (M * (d - 1 - j.1)) *
            (∑ k ∈ Finset.range (K_max + 1),
              Polynomial.C ((C j).coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) * F₂ ^ j.1) -
          Polynomial.X * B₁ ^ (M * (d - 1)) *
            (∑ k ∈ Finset.range (K_max + 1),
              Polynomial.C (H.coeff k) * A₁ ^ k * B₁ ^ (K_max - k)) := by
      have h1 : Eq4_gen.map ψ =
          (∑ j : Fin d,
            (B₁_gen.map ψ) ^ (M * (d - 1 - j.1)) *
              (∑ k ∈ Finset.range (K_max + 1),
                Polynomial.C (((C_gen j).map ψ).coeff k) * (A₁_gen.map ψ) ^ k *
                  (B₁_gen.map ψ) ^ (K_max - k)) * (F₂_gen.map ψ) ^ j.1) -
            Polynomial.X * (B₁_gen.map ψ) ^ (M * (d - 1)) *
              (∑ k ∈ Finset.range (K_max + 1),
                Polynomial.C ((H_gen.map ψ).coeff k) * (A₁_gen.map ψ) ^ k *
                  (B₁_gen.map ψ) ^ (K_max - k)) := by
        simp [Eq4_gen, HomogH_gen, Polynomial.map_sum, Polynomial.coeff_map]
      rw [h1, hA₁_map, hB₁_map, hF₂_map, hH_map]
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [hC_map j]
    have hR_ne : R_nondeg_gen.map ψ ≠ 0 := by
      rwa [hNondeg_map]
    have hEx_ν : ∃ ν : ℕ, ψ (R_nondeg_gen.coeff ν) ≠ 0 := by
      by_contra hNo
      apply hR_ne
      ext ν
      rw [Polynomial.coeff_zero, Polynomial.coeff_map]
      by_contra hne
      exact hNo ⟨ν, hne⟩
    obtain ⟨ν, hν_ψ_ne⟩ := hEx_ν
    have hν_mem : ν ∈ R_nondeg_gen.support := by
      rw [Polynomial.mem_support_iff]
      intro h0
      rw [h0, map_zero] at hν_ψ_ne
      exact hν_ψ_ne rfl
    let ν_x : ↥R_nondeg_gen.support := ⟨ν, hν_mem⟩
    have hφ_ν : φ (b_rat ν_x) ≠ 0 :=
      (Finset.prod_ne_zero_iff.mp hφ_prod) ν_x (Finset.mem_attach _ ν_x)
    let z : σ₂' → Ω := Sum.elim y (fun _ => (ψ (R_nondeg_gen.coeff ν))⁻¹)
    have hRename_z : ∀ g : R₂,
        MvPolynomial.eval₂ φ z (MvPolynomial.rename Sum.inl g) = ψ g := by
      intro g
      rw [MvPolynomial.eval₂_rename]
      rfl
    apply hb_rat_no ν_x Ω φ hφ_ν
    refine ⟨z, fun f hf => ?_⟩
    rcases Finset.mem_insert.mp hf with rfl | hf_rest
    · dsimp [f_rab]
      rw [MvPolynomial.eval₂_sub, MvPolynomial.eval₂_mul, hRename_z,
        MvPolynomial.eval₂_X, MvPolynomial.eval₂_one]
      change ψ (R_nondeg_gen.coeff ν) * (ψ (R_nondeg_gen.coeff ν))⁻¹ - 1 = 0
      rw [mul_inv_cancel₀ hν_ψ_ne, sub_self]
    · rcases Finset.mem_union.mp hf_rest with hf3 | hf4
      · rcases Finset.mem_image.mp hf3 with ⟨m, _, rfl⟩
        rw [hRename_z]
        have hm0 : (Eq3_gen.map ψ).coeff m = 0 := by
          rw [hEq3_map, hEq3_Ω, Polynomial.coeff_zero]
        simpa [Polynomial.coeff_map] using hm0
      · rcases Finset.mem_image.mp hf4 with ⟨m, _, rfl⟩
        rw [hRename_z]
        have hm0 : (Eq4_gen.map ψ).coeff m = 0 := by
          rw [hEq4_map, hEq4_Ω, Polynomial.coeff_zero]
        simpa [Polynomial.coeff_map] using hm0

theorem weil_topological_component_incidence_reassembly_and_extract : (∀ {X : Type u} [TopologicalSpace X] (c m : ℕ) (_hc : 1 ≤ c)
        (F : Fin c → Set X) (inc : Fin m → Fin c × Fin c),
      (∀ i : Fin c, IsClosed (F i) ∧ IsIrreducible (F i)) →
      (⋃ i : Fin c, F i) = Set.univ →
      (∀ i : Fin c, ∃ x ∈ F i, ∀ j : Fin c, j ≠ i → x ∉ F j) →
      (∀ S : Set (Fin c), S.Nonempty →
        (∀ i₁ ∈ S, ∀ i₂ : Fin c, i₂ ∉ S →
          ¬ ∃ a : Fin m, inc a = (i₁, i₂) ∨ inc a = (i₂, i₁)) →
        S = Set.univ) →
      (∀ a : Fin m, (F (inc a).1 ∩ F (inc a).2).Nonempty) →
      ConnectedSpace X ∧
      (_root_.Pairwise fun i₁ i₂ : Fin c => F i₁ ≠ F i₂) ∧
      irreducibleComponents X = Set.range F) ∧
    (∀ (X : Type u) [TopologicalSpace X],
      ConnectedSpace X →
      (irreducibleComponents X).Finite →
      ∃ (c : ℕ) (F : Fin c → Set X) (m : ℕ) (inc : Fin m → Fin c × Fin c),
        1 ≤ c ∧
        (∀ i : Fin c, F i ∈ irreducibleComponents X ∧ IsClosed (F i) ∧ IsIrreducible (F i)) ∧
        (⋃ i : Fin c, F i) = Set.univ ∧
        (∀ i : Fin c, ∃ x ∈ F i, ∀ j : Fin c, j ≠ i → x ∉ F j) ∧
        (∀ S : Set (Fin c), S.Nonempty →
          (∀ i₁ ∈ S, ∀ i₂ : Fin c, i₂ ∉ S →
            ¬ ∃ a : Fin m, inc a = (i₁, i₂) ∨ inc a = (i₂, i₁)) →
          S = Set.univ) ∧
        (∀ a : Fin m, (F (inc a).1 ∩ F (inc a).2).Nonempty)) :=
by
  refine ⟨?_, ?_⟩
  · intro X _ c m hc F inc hClosedIrred hCov hExcl hCut hEdge
    have hMemCov : ∀ x : X, ∃ i : Fin c, x ∈ F i := by
      intro x
      have hx : x ∈ (⋃ i : Fin c, F i) := by
        rw [hCov]
        exact Set.mem_univ x
      exact Set.mem_iUnion.mp hx
    refine ⟨?_, ?_, ?_⟩
    · refine connectedSpace_iff_clopen.mpr ⟨?_, ?_⟩
      · obtain ⟨x₀, _⟩ := (hClosedIrred ⟨0, hc⟩).2.nonempty
        exact ⟨x₀⟩
      · intro K hK
        rcases K.eq_empty_or_nonempty with rfl | ⟨y₀, hy₀⟩
        · exact Or.inl rfl
        · right
          obtain ⟨i_y, hy₀_F⟩ := hMemCov y₀
          let S : Set (Fin c) := {i : Fin c | F i ⊆ K}
          have hPre : ∀ i : Fin c, IsPreconnected (F i) :=
            fun i => (hClosedIrred i).2.isPreirreducible.isPreconnected
          have hS_ne : S.Nonempty :=
            ⟨i_y, (hPre i_y).subset_isClopen hK ⟨y₀, hy₀_F, hy₀⟩⟩
          have hS_univ : S = Set.univ := by
            refine hCut S hS_ne ?_
            rintro i₁ hi₁ i₂ hi₂ ⟨a, ha⟩
            obtain ⟨z, hz₁, hz₂⟩ := hEdge a
            rcases ha with h_eq | h_eq
            · rw [h_eq] at hz₁ hz₂
              exact hi₂ ((hPre i₂).subset_isClopen hK ⟨z, hz₂, hi₁ hz₁⟩)
            · rw [h_eq] at hz₁ hz₂
              exact hi₂ ((hPre i₂).subset_isClopen hK ⟨z, hz₁, hi₁ hz₂⟩)
          refine Set.eq_univ_of_forall fun x => ?_
          obtain ⟨i, hx_Fi⟩ := hMemCov x
          have hi_S : i ∈ S := by
            rw [hS_univ]
            exact Set.mem_univ i
          exact hi_S hx_Fi
    · intro i₁ i₂ hne hEq
      obtain ⟨x, hx₁, hx_excl⟩ := hExcl i₁
      have hx₂ : x ∈ F i₂ := by
        rw [← hEq]
        exact hx₁
      exact hx_excl i₂ hne.symm hx₂
    · have hSubRange : irreducibleComponents X ⊆ Set.range F := by
        intro E hE
        let _ : DecidableEq (Set X) := Classical.decEq (Set X)
        let t : Finset (Set X) := Finset.univ.image F
        have ht_closed : ∀ z ∈ t, IsClosed z := by
          intro z hz
          obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hz
          exact (hClosedIrred i).1
        have hE_sub : E ⊆ ⋃₀ (↑t : Set (Set X)) := by
          intro x _
          obtain ⟨i, hx_Fi⟩ := hMemCov x
          exact Set.mem_sUnion.mpr ⟨F i, Finset.mem_coe.mpr (Finset.mem_image_of_mem F (Finset.mem_univ i)), hx_Fi⟩
        obtain ⟨z, hz_t, hE_z⟩ := (isIrreducible_iff_sUnion_isClosed.mp hE.prop) t ht_closed hE_sub
        obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hz_t
        have hEq : E = F i := hE.eq_of_le (hClosedIrred i).2 hE_z
        exact ⟨i, hEq.symm⟩
      refine Set.Subset.antisymm hSubRange ?_
      rintro _ ⟨i, rfl⟩
      obtain ⟨E, hE, hFi_E⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible (F i) (hClosedIrred i).2
      obtain ⟨j, hj_eq⟩ := hSubRange hE
      obtain ⟨x, hx_Fi, hx_excl⟩ := hExcl i
      have hx_Fj : x ∈ F j := by
        rw [hj_eq]
        exact hFi_E hx_Fi
      have hji : j = i := by
        by_contra hne
        exact hx_excl j hne hx_Fj
      rw [← hji, hj_eq]
      exact hE
  · intro X _ hConn hFin
    let s_fin : Finset (Set X) := hFin.toFinset
    let c : ℕ := s_fin.card
    let e : Fin c ≃ ↥s_fin := s_fin.equivFin.symm
    let F : Fin c → Set X := fun i => (e i).1
    have hc : 1 ≤ c := by
      obtain ⟨x₀⟩ := hConn.toNonempty
      have hm₀ : irreducibleComponent x₀ ∈ s_fin :=
        hFin.mem_toFinset.mpr (irreducibleComponent_mem_irreducibleComponents x₀)
      exact Finset.card_pos.mpr ⟨irreducibleComponent x₀, hm₀⟩
    have hF_props : ∀ i : Fin c, F i ∈ irreducibleComponents X ∧ IsClosed (F i) ∧ IsIrreducible (F i) := by
      intro i
      have hMem : F i ∈ irreducibleComponents X := hFin.mem_toFinset.mp (e i).2
      exact ⟨hMem, isClosed_of_mem_irreducibleComponents (F i) hMem, hMem.prop⟩
    have hCov : (⋃ i : Fin c, F i) = Set.univ := by
      refine Set.eq_univ_of_forall fun x => ?_
      have hm : irreducibleComponent x ∈ s_fin :=
        hFin.mem_toFinset.mpr (irreducibleComponent_mem_irreducibleComponents x)
      let i : Fin c := e.symm ⟨irreducibleComponent x, hm⟩
      have hFi : F i = irreducibleComponent x := by
        change (e (e.symm ⟨irreducibleComponent x, hm⟩)).1 = irreducibleComponent x
        rw [e.apply_symm_apply]
      refine Set.mem_iUnion.mpr ⟨i, ?_⟩
      rw [hFi]
      exact mem_irreducibleComponent
    have hExcl : ∀ i : Fin c, ∃ x ∈ F i, ∀ j : Fin c, j ≠ i → x ∉ F j := by
      intro i
      by_contra! hNoExcl
      let _ : DecidableEq (Set X) := Classical.decEq (Set X)
      let t : Finset (Set X) := (Finset.univ.erase i).image F
      have ht_closed : ∀ z ∈ t, IsClosed z := by
        intro z hz
        obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hz
        exact (hF_props j).2.1
      have hFi_sub : F i ⊆ ⋃₀ (↑t : Set (Set X)) := by
        intro x hx
        obtain ⟨j, hji, hxj⟩ := hNoExcl x hx
        have hj_erase : j ∈ Finset.univ.erase i := Finset.mem_erase.mpr ⟨hji, Finset.mem_univ j⟩
        exact Set.mem_sUnion.mpr ⟨F j, Finset.mem_coe.mpr (Finset.mem_image_of_mem F hj_erase), hxj⟩
      obtain ⟨z, hz_t, hFi_z⟩ := (isIrreducible_iff_sUnion_isClosed.mp (hF_props i).2.2) t ht_closed hFi_sub
      obtain ⟨j, hj_erase, rfl⟩ := Finset.mem_image.mp hz_t
      have hji : j ≠ i := (Finset.mem_erase.mp hj_erase).1
      have hEq : F i = F j := (hF_props i).1.eq_of_le (hF_props j).2.2 hFi_z
      have he_eq : e i = e j := Subtype.ext hEq
      exact hji (e.injective he_eq).symm
    let _ : DecidablePred (fun p : Fin c × Fin c => (F p.1 ∩ F p.2).Nonempty) := Classical.decPred _
    let Edge : Type := {p : Fin c × Fin c // (F p.1 ∩ F p.2).Nonempty}
    let m : ℕ := Fintype.card Edge
    let e_edge : Fin m ≃ Edge := (Fintype.equivFin Edge).symm
    let inc : Fin m → Fin c × Fin c := fun a => (e_edge a).1
    have hEdge : ∀ a : Fin m, (F (inc a).1 ∩ F (inc a).2).Nonempty := fun a => (e_edge a).2
    have hCut : ∀ S : Set (Fin c), S.Nonempty →
        (∀ i₁ ∈ S, ∀ i₂ : Fin c, i₂ ∉ S →
          ¬ ∃ a : Fin m, inc a = (i₁, i₂) ∨ inc a = (i₂, i₁)) →
        S = Set.univ := by
      intro S ⟨i₀, hi₀⟩ hNoCross
      by_contra hS_ne
      have hExOut : ∃ j₀ : Fin c, j₀ ∉ S := by
        by_contra! hAll
        exact hS_ne (Set.eq_univ_of_forall hAll)
      obtain ⟨j₀, hj₀⟩ := hExOut
      let K₁ : Set X := ⋃ i ∈ S, F i
      let K₂ : Set X := ⋃ j ∈ Sᶜ, F j
      have hCl₁ : IsClosed K₁ := S.toFinite.isClosed_biUnion fun i _ => (hF_props i).2.1
      have hCl₂ : IsClosed K₂ := Sᶜ.toFinite.isClosed_biUnion fun j _ => (hF_props j).2.1
      have hCompl : K₁ = K₂ᶜ := by
        ext y
        simp only [K₁, K₂, Set.mem_iUnion, Set.mem_compl_iff, not_exists]
        constructor
        · rintro ⟨i₁, hi₁, hy₁⟩ i₂ hi₂ hy₂
          have hne : (F i₁ ∩ F i₂).Nonempty := ⟨y, hy₁, hy₂⟩
          let a : Fin m := e_edge.symm ⟨(i₁, i₂), hne⟩
          have ha : inc a = (i₁, i₂) := by
            change (e_edge (e_edge.symm ⟨(i₁, i₂), hne⟩)).1 = (i₁, i₂)
            rw [e_edge.apply_symm_apply]
          exact hNoCross i₁ hi₁ i₂ hi₂ ⟨a, Or.inl ha⟩
        · intro hy_not_K₂
          have hy_univ : y ∈ (⋃ k : Fin c, F k) := by
            rw [hCov]
            exact Set.mem_univ y
          obtain ⟨k, hy_Fk⟩ := Set.mem_iUnion.mp hy_univ
          by_cases hk : k ∈ S
          · exact ⟨k, hk, hy_Fk⟩
          · exact False.elim (hy_not_K₂ k hk hy_Fk)
      have hOp₁ : IsOpen K₁ := by
        rw [hCompl]
        exact isOpen_compl_iff.mpr hCl₂
      have hClopen₁ : IsClopen K₁ := ⟨hCl₁, hOp₁⟩
      rcases (connectedSpace_iff_clopen.mp hConn).2 K₁ hClopen₁ with hK₁_emp | hK₁_univ
      · obtain ⟨x₁, hx₁⟩ := (hF_props i₀).2.2.nonempty
        have hx₁_K₁ : x₁ ∈ K₁ := Set.mem_iUnion₂.mpr ⟨i₀, hi₀, hx₁⟩
        rw [hK₁_emp] at hx₁_K₁
        exact hx₁_K₁
      · obtain ⟨x₂, hx₂⟩ := (hF_props j₀).2.2.nonempty
        have hx₂_K₂ : x₂ ∈ K₂ := Set.mem_iUnion₂.mpr ⟨j₀, hj₀, hx₂⟩
        have hx₂_K₁ : x₂ ∈ K₁ := by
          rw [hK₁_univ]
          exact Set.mem_univ x₂
        rw [hCompl] at hx₂_K₁
        exact hx₂_K₁ hx₂_K₂
    exact ⟨c, F, m, inc, hc, hF_props, hCov, hExcl, hCut, hEdge⟩

theorem weil_scheme_reduced_closedSubscheme_and_algClosed_sections : (∀ {Z E₁ E₂ : AlgebraicGeometry.Scheme.{u}} (ι₁ : E₁ ⟶ Z) (ι₂ : E₂ ⟶ Z),
      AlgebraicGeometry.IsClosedImmersion ι₁ →
      AlgebraicGeometry.IsClosedImmersion ι₂ →
      AlgebraicGeometry.IsReduced E₁ →
      AlgebraicGeometry.IsReduced E₂ →
      Set.range ι₁.base = Set.range ι₂.base →
      ∃ e : E₁ ≅ E₂, e.hom ≫ ι₂ = ι₁) ∧
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (Y : AlgebraicGeometry.Scheme.{u})
        (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.LocallyOfFiniteType p_Y]
        (F : Set ↥Y),
      F ∈ irreducibleComponents ↥Y →
      ∃ (E_F : AlgebraicGeometry.Scheme.{u}) (ι_F : E_F ⟶ Y),
        AlgebraicGeometry.IsClosedImmersion ι_F ∧
        AlgebraicGeometry.IsIntegral E_F ∧
        Set.range ι_F.base = F ∧
        (AlgebraicGeometry.IsProper p_Y → AlgebraicGeometry.IsProper (ι_F ≫ p_Y)) ∧
        AlgebraicGeometry.LocallyOfFiniteType (ι_F ≫ p_Y) ∧
        (AlgebraicGeometry.IsReduced Y →
          ∀ (D₀ : Type u) [CommRing D₀] [Algebra Ω D₀]
            (j₀ : AlgebraicGeometry.Spec (CommRingCat.of D₀) ⟶ E_F),
            AlgebraicGeometry.IsOpenImmersion j₀ →
            j₀ ≫ (ι_F ≫ p_Y) = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D₀)) →
            ∀ (q₀ : PrimeSpectrum D₀), q₀.asIdeal.IsMaximal →
              ∃ (R : Type u) (_ : CommRing R) (_ : Algebra Ω R)
                (j_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y)
                (q_R : PrimeSpectrum R)
                (P_F : Ideal R),
                Algebra.FiniteType Ω R ∧
                _root_.IsReduced R ∧
                AlgebraicGeometry.IsOpenImmersion j_R ∧
                j_R ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω R)) ∧
                q_R.asIdeal.IsMaximal ∧
                P_F ∈ minimalPrimes R ∧
                P_F ≤ q_R.asIdeal ∧
                Nonempty (Localization.AtPrime q₀.asIdeal ≃ₐ[Ω]
                  (Localization.AtPrime q_R.asIdeal ⧸
                    Ideal.map (algebraMap R (Localization.AtPrime q_R.asIdeal)) P_F)))) ∧
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (Y E₁ E₂ : AlgebraicGeometry.Scheme.{u})
        (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.LocallyOfFiniteType p_Y]
        (ι₁ : E₁ ⟶ Y) (ι₂ : E₂ ⟶ Y),
      AlgebraicGeometry.IsClosedImmersion ι₁ →
      AlgebraicGeometry.IsClosedImmersion ι₂ →
      (Set.range ι₁.base ∩ Set.range ι₂.base).Nonempty →
      ∃ (pt : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y),
        pt ≫ p_Y = 𝟙 _ ∧
        (∃ s₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E₁, s₁ ≫ ι₁ = pt) ∧
        (∃ s₂ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E₂, s₂ ≫ ι₂ = pt)) :=
by
  
  have hDescendRingHom : ∀ {R A B : Type u} [CommRing R] [CommRing A] [CommRing B]
      (φ : R →+* A) (hφ : Function.Surjective φ) (ψ : R →+* B)
      (_hker : RingHom.ker φ ≤ RingHom.ker ψ),
      ∃ θ : A →+* B, θ.comp φ = ψ := by
    intro R A B _ _ _ φ hφ ψ hker
    let sec : A → R := fun a => Classical.choose (hφ a)
    have hsec : ∀ a : A, φ (sec a) = a := fun a => Classical.choose_spec (hφ a)
    have hwell : ∀ r₁ r₂ : R, φ r₁ = φ r₂ → ψ r₁ = ψ r₂ := by
      intro r₁ r₂ heq
      have hsub : r₁ - r₂ ∈ RingHom.ker φ := by
        change φ (r₁ - r₂) = 0
        rw [map_sub, heq, sub_self]
      have hψsub : ψ (r₁ - r₂) = 0 := hker hsub
      rw [map_sub] at hψsub
      exact sub_eq_zero.mp hψsub
    have hf_eq : ∀ r : R, ψ (sec (φ r)) = ψ r := fun r => hwell _ _ (hsec (φ r))
    refine ⟨{
      toFun := fun a => ψ (sec a)
      map_one' := by
        have h := hf_eq 1
        rw [map_one, map_one] at h
        exact h
      map_mul' := fun a₁ a₂ => by
        obtain ⟨r₁, rfl⟩ := hφ a₁
        obtain ⟨r₂, rfl⟩ := hφ a₂
        rw [← map_mul, hf_eq, hf_eq, hf_eq, map_mul]
      map_zero' := by
        have h := hf_eq 0
        rw [map_zero, map_zero] at h
        exact h
      map_add' := fun a₁ a₂ => by
        obtain ⟨r₁, rfl⟩ := hφ a₁
        obtain ⟨r₂, rfl⟩ := hφ a₂
        rw [← map_add, hf_eq, hf_eq, hf_eq, map_add]
    }, ?_⟩
    ext r
    exact hf_eq r

  
  have hNull : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (A : Type u) [CommRing A] [Algebra Ω A] [Algebra.FiniteType Ω A]
      (𝔪 : Ideal A), 𝔪.IsMaximal →
      ∃ (ev : A →ₐ[Ω] Ω), RingHom.ker ev.toRingHom = 𝔪 := by
    intro Ω _ _ A _ _ hFT 𝔪 h𝔪
    have _ : 𝔪.IsMaximal := h𝔪
    obtain ⟨s, hs⟩ := hFT.out
    let π : MvPolynomial ↥s Ω →ₐ[Ω] A := MvPolynomial.aeval Subtype.val
    have hπ_surj : Function.Surjective π := by
      have hrange : AlgHom.range π = ⊤ := by
        rw [MvPolynomial.aeval_range]
        have hset : Set.range (Subtype.val : ↥s → A) = (↑s : Set A) := by
          ext x
          simp
        rw [hset]
        exact hs
      intro a
      have ha : a ∈ AlgHom.range π := by
        rw [hrange]
        trivial
      exact ha
    let 𝔪₀ : Ideal (MvPolynomial ↥s Ω) := Ideal.comap π.toRingHom 𝔪
    have _ : 𝔪₀.IsMaximal := Ideal.comap_isMaximal_of_surjective π.toRingHom hπ_surj
    obtain ⟨x, hx⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := 𝔪₀)).mp ‹𝔪₀.IsMaximal›
    let ev₀ : MvPolynomial ↥s Ω →ₐ[Ω] Ω := MvPolynomial.aeval x
    have hker_le : RingHom.ker π.toRingHom ≤ RingHom.ker ev₀.toRingHom := by
      intro p hp
      have hp_m₀ : p ∈ 𝔪₀ := by
        change π p ∈ 𝔪
        have hp0 : π p = 0 := hp
        rw [hp0]
        exact 𝔪.zero_mem
      rw [hx, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hp_m₀
      exact hp_m₀
    obtain ⟨ev_ring, hev_comp⟩ := hDescendRingHom π.toRingHom hπ_surj ev₀.toRingHom hker_le
    let ev : A →ₐ[Ω] Ω := {
      ev_ring with
      commutes' := fun c => by
        have h1 : π (algebraMap Ω (MvPolynomial ↥s Ω) c) = algebraMap Ω A c := π.commutes c
        rw [← h1]
        change (ev_ring.comp π.toRingHom) (algebraMap Ω (MvPolynomial ↥s Ω) c) = algebraMap Ω Ω c
        rw [hev_comp]
        exact ev₀.commutes c
    }
    refine ⟨ev, ?_⟩
    ext a
    obtain ⟨p, rfl⟩ := hπ_surj a
    change (ev_ring.comp π.toRingHom) p = 0 ↔ π p ∈ 𝔪
    rw [hev_comp]
    change (MvPolynomial.aeval x) p = 0 ↔ p ∈ 𝔪₀
    rw [hx, MvPolynomial.mem_vanishingIdeal_singleton_iff]

  
  have hQuotLoc : ∀ (Ω : Type u) [CommRing Ω]
      (R : Type u) [CommRing R] [Algebra Ω R]
      (P : Ideal R) (q_R : PrimeSpectrum R) (q₁ : PrimeSpectrum (R ⧸ P)),
      PrimeSpectrum.comap (Ideal.Quotient.mk P) q₁ = q_R →
      Nonempty (Localization.AtPrime q₁.asIdeal ≃ₐ[Ω]
        (Localization.AtPrime q_R.asIdeal ⧸
          Ideal.map (algebraMap R (Localization.AtPrime q_R.asIdeal)) P)) := by
    intro Ω _ R _ _ P q_R q₁ hcomap
    have _ : q_R.asIdeal.IsPrime := q_R.isPrime
    have _ : q₁.asIdeal.IsPrime := q₁.isPrime
    have hq : Ideal.comap (Ideal.Quotient.mk P) q₁.asIdeal = q_R.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hcomap
    let Q := R ⧸ P
    let L := Localization.AtPrime q_R.asIdeal
    let 𝔭 : Ideal L := Ideal.map (algebraMap R L) P
    let L₁ := Localization.AtPrime q₁.asIdeal
    let f_Q : Q →+* (L ⧸ 𝔭) :=
      Ideal.Quotient.lift P ((Ideal.Quotient.mk 𝔭).comp (algebraMap R L))
        (fun r hr => Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hr))
    have hf_units : ∀ y : q₁.asIdeal.primeCompl, IsUnit (f_Q y.1) := by
      intro y
      obtain ⟨r, hr_eq⟩ := Ideal.Quotient.mk_surjective y.1
      have hr_not : r ∉ q_R.asIdeal := by
        rw [← hq]
        change Ideal.Quotient.mk P r ∉ q₁.asIdeal
        rw [hr_eq]
        exact y.2
      rw [← hr_eq]
      exact (IsLocalization.map_units L (⟨r, hr_not⟩ : q_R.asIdeal.primeCompl)).map
        (Ideal.Quotient.mk 𝔭)
    let φ_ring : L₁ →+* (L ⧸ 𝔭) := IsLocalization.lift hf_units
    let g₀ : R →+* L₁ := (algebraMap Q L₁).comp (Ideal.Quotient.mk P)
    have hg_units : ∀ v : q_R.asIdeal.primeCompl, IsUnit (g₀ v.1) := by
      intro v
      have hv_not : Ideal.Quotient.mk P v.1 ∉ q₁.asIdeal := by
        change v.1 ∉ Ideal.comap (Ideal.Quotient.mk P) q₁.asIdeal
        rw [hq]
        exact v.2
      exact IsLocalization.map_units L₁ (⟨Ideal.Quotient.mk P v.1, hv_not⟩ : q₁.asIdeal.primeCompl)
    let g_L : L →+* L₁ := IsLocalization.lift hg_units
    have hg_ker : ∀ y ∈ 𝔭, g_L y = 0 := by
      have hle : 𝔭 ≤ RingHom.ker g_L := by
        rw [Ideal.map_le_iff_le_comap]
        intro r hr
        change g_L (algebraMap R L r) = 0
        rw [IsLocalization.lift_eq hg_units r]
        change algebraMap Q L₁ (Ideal.Quotient.mk P r) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hr, map_zero]
      exact fun y hy => hle hy
    let ψ_ring : (L ⧸ 𝔭) →+* L₁ := Ideal.Quotient.lift 𝔭 g_L hg_ker
    have hψφ : ψ_ring.comp φ_ring = RingHom.id L₁ := by
      apply IsLocalization.ringHom_ext q₁.asIdeal.primeCompl
      apply Ideal.Quotient.ringHom_ext
      ext r
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [IsLocalization.lift_eq hf_units (Ideal.Quotient.mk P r)]
      change ψ_ring (Ideal.Quotient.mk 𝔭 (algebraMap R L r)) =
        algebraMap Q L₁ (Ideal.Quotient.mk P r)
      change g_L (algebraMap R L r) = algebraMap Q L₁ (Ideal.Quotient.mk P r)
      exact IsLocalization.lift_eq hg_units r
    have hφψ : φ_ring.comp ψ_ring = RingHom.id (L ⧸ 𝔭) := by
      apply Ideal.Quotient.ringHom_ext
      apply IsLocalization.ringHom_ext q_R.asIdeal.primeCompl
      ext r
      simp only [RingHom.comp_apply, RingHom.id_apply]
      change φ_ring (g_L (algebraMap R L r)) = Ideal.Quotient.mk 𝔭 (algebraMap R L r)
      rw [IsLocalization.lift_eq hg_units r]
      exact IsLocalization.lift_eq hf_units (Ideal.Quotient.mk P r)
    let e_ring : L₁ ≃+* (L ⧸ 𝔭) := {
      φ_ring with
      invFun := ψ_ring
      left_inv := fun x => RingHom.congr_fun hψφ x
      right_inv := fun y => RingHom.congr_fun hφψ y
    }
    refine ⟨AlgEquiv.ofRingEquiv (f := e_ring) (fun c => ?_)⟩
    have hc₁ : algebraMap Ω L₁ c =
        algebraMap Q L₁ (Ideal.Quotient.mk P (algebraMap Ω R c)) := by
      rw [IsScalarTower.algebraMap_apply Ω Q L₁ c, IsScalarTower.algebraMap_apply Ω R Q c]
      rfl
    have hc₂ : algebraMap Ω (L ⧸ 𝔭) c =
        Ideal.Quotient.mk 𝔭 (algebraMap R L (algebraMap Ω R c)) := by
      rw [IsScalarTower.algebraMap_apply Ω L (L ⧸ 𝔭) c, IsScalarTower.algebraMap_apply Ω R L c]
      rfl
    rw [hc₁, hc₂]
    exact IsLocalization.lift_eq hf_units (Ideal.Quotient.mk P (algebraMap Ω R c))

  
  have hUniqueRed : ∀ {Z E₁ E₂ : AlgebraicGeometry.Scheme.{u}} (ι₁ : E₁ ⟶ Z) (ι₂ : E₂ ⟶ Z),
      AlgebraicGeometry.IsClosedImmersion ι₁ →
      AlgebraicGeometry.IsClosedImmersion ι₂ →
      AlgebraicGeometry.IsReduced E₁ →
      AlgebraicGeometry.IsReduced E₂ →
      Set.range ι₁.base = Set.range ι₂.base →
      ∃ e : E₁ ≅ E₂, e.hom ≫ ι₂ = ι₁ := by
    have hKerVan : ∀ {Z E : AlgebraicGeometry.Scheme.{u}} (ι : E ⟶ Z)
        [AlgebraicGeometry.IsClosedImmersion ι] [AlgebraicGeometry.IsReduced E],
        Scheme.Hom.ker ι =
          Scheme.IdealSheafData.vanishingIdeal
            ⟨Set.range ι.base, ι.isClosedEmbedding.isClosed_range⟩ := by
      intro Z E ι _ _
      have hsupp : (Scheme.Hom.ker ι).support =
          ⟨Set.range ι.base, ι.isClosedEmbedding.isClosed_range⟩ := by
        ext x
        change x ∈ ((Scheme.Hom.ker ι).support : Set ↥Z) ↔ x ∈ Set.range ι.base
        rw [Scheme.Hom.support_ker, ι.isClosedEmbedding.isClosed_range.closure_eq]
      rw [← hsupp, Scheme.IdealSheafData.vanishingIdeal_support]
      apply Scheme.IdealSheafData.ext
      funext U
      rw [Scheme.IdealSheafData.radical_ideal, Scheme.Hom.ker_apply]
      symm
      rw [Ideal.radical_eq_iff]
      intro a ⟨n, han⟩
      have hRedComp : _root_.IsReduced ↑(E.presheaf.obj (Opposite.op (ι ⁻¹ᵁ (U : Z.Opens)))) :=
        AlgebraicGeometry.IsReduced.component_reduced (X := E) (ι ⁻¹ᵁ (U : Z.Opens))
      have hpow0 : ((ι.app (U : Z.Opens)).hom a) ^ n = 0 := by
        rw [← map_pow]
        exact han
      exact hRedComp.eq_zero ((ι.app (U : Z.Opens)).hom a) ⟨n, hpow0⟩
    intro Z E₁ E₂ ι₁ ι₂ hCl₁ hCl₂ hRed₁ hRed₂ hRange
    have _ := hCl₁
    have _ := hCl₂
    have _ := hRed₁
    have _ := hRed₂
    have hClosedEq :
        (⟨Set.range ι₂.base, ι₂.isClosedEmbedding.isClosed_range⟩ : TopologicalSpace.Closeds ↥Z) =
        ⟨Set.range ι₁.base, ι₁.isClosedEmbedding.isClosed_range⟩ := by
      ext x
      change x ∈ Set.range ι₂.base ↔ x ∈ Set.range ι₁.base
      rw [hRange]
    have hKerEq : Scheme.Hom.ker ι₂ = Scheme.Hom.ker ι₁ := by
      rw [hKerVan ι₂, hKerVan ι₁, hClosedEq]
    let f : E₁ ⟶ E₂ := AlgebraicGeometry.IsClosedImmersion.lift ι₂ ι₁ (le_of_eq hKerEq)
    have _ : CategoryTheory.IsIso f :=
      AlgebraicGeometry.IsClosedImmersion.isIso_lift ι₂ ι₁ hKerEq
    exact ⟨CategoryTheory.asIso f, AlgebraicGeometry.IsClosedImmersion.lift_fac ι₂ ι₁ (le_of_eq hKerEq)⟩

  
  have hCompPkg : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (F : Set ↥Y),
      F ∈ irreducibleComponents ↥Y →
      ∃ (E_F : AlgebraicGeometry.Scheme.{u}) (ι_F : E_F ⟶ Y),
        AlgebraicGeometry.IsClosedImmersion ι_F ∧
        AlgebraicGeometry.IsIntegral E_F ∧
        Set.range ι_F.base = F ∧
        (∀ {S : AlgebraicGeometry.Scheme.{u}} (p_Y : Y ⟶ S),
          (AlgebraicGeometry.IsProper p_Y → AlgebraicGeometry.IsProper (ι_F ≫ p_Y)) ∧
          (AlgebraicGeometry.LocallyOfFiniteType p_Y →
            AlgebraicGeometry.LocallyOfFiniteType (ι_F ≫ p_Y))) ∧
        (∀ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
          ((U : Set ↥Y) ∩ F).Nonempty →
          ∃ (P_F : Ideal ↑(Y.presheaf.obj (Opposite.op U)))
            (j₁ : AlgebraicGeometry.Spec
              (CommRingCat.of (↑(Y.presheaf.obj (Opposite.op U)) ⧸ P_F)) ⟶ E_F),
            P_F ∈ minimalPrimes ↑(Y.presheaf.obj (Opposite.op U)) ∧
            AlgebraicGeometry.IsOpenImmersion j₁ ∧
            PrimeSpectrum.zeroLocus (P_F : Set ↑(Y.presheaf.obj (Opposite.op U))) =
              hU.fromSpec.base ⁻¹' F ∧
            j₁ ≫ ι_F =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P_F)) ≫
                hU.fromSpec) := by
    
    have hLocReduced : ∀ {A : Type u} [CommRing A] (_hRedA : _root_.IsReduced A)
        {M : Submonoid A} {S : Type u} [CommRing S] {instAlg : Algebra A S}
        (_hLoc : @IsLocalization A _ M S _ instAlg),
        _root_.IsReduced S := by
      intro A _ hRedA M S _ instAlg hLoc
      let _ : Algebra A S := instAlg
      have _ : IsLocalization M S := hLoc
      refine ⟨fun z ⟨n, hzn⟩ => ?_⟩
      obtain ⟨⟨r, m⟩, hrm⟩ := IsLocalization.surj M z
      have hr_pow : algebraMap A S (r ^ n) = 0 := by
        rw [map_pow, ← hrm, mul_pow, hzn, zero_mul]
      obtain ⟨t, ht⟩ := (IsLocalization.map_eq_zero_iff M S (r ^ n)).mp hr_pow
      have htr_nil : (t.1 * r) ^ (n + 1) = 0 := by
        calc
          (t.1 * r) ^ (n + 1) = r * t.1 ^ n * (t.1 * r ^ n) := by ring
          _ = 0 := by rw [ht, mul_zero]
      have htr0 : t.1 * r = 0 := hRedA.eq_zero (t.1 * r) ⟨n + 1, htr_nil⟩
      have hmap_r : algebraMap A S r = 0 :=
        (IsLocalization.map_eq_zero_iff M S r).mpr ⟨t, htr0⟩
      rw [hmap_r] at hrm
      obtain ⟨u, hu⟩ := IsLocalization.map_units S m
      calc
        z = z * 1 := (mul_one z).symm
        _ = z * (u.val * ↑u⁻¹) := by rw [Units.mul_inv]
        _ = (z * algebraMap A S m.1) * ↑u⁻¹ := by rw [hu, mul_assoc]
        _ = 0 := by rw [hrm, zero_mul]
    intro Y F hF
    have hClF : IsClosed F := isClosed_of_mem_irreducibleComponents F hF
    have hIrredF : IsIrreducible F := hF.1
    let Z_F : TopologicalSpace.Closeds ↥Y := ⟨F, hClF⟩
    let I_F : Y.IdealSheafData := Scheme.IdealSheafData.vanishingIdeal Z_F
    let E_F : AlgebraicGeometry.Scheme.{u} := I_F.subscheme
    let ι_F : E_F ⟶ Y := I_F.subschemeι
    have hCl_ι : AlgebraicGeometry.IsClosedImmersion ι_F := inferInstance
    have hRange_ι : Set.range ι_F.base = F := by
      change Set.range ⇑I_F.subschemeι = F
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    have hStalkRed : ∀ z : ↥E_F, _root_.IsReduced ↑(E_F.presheaf.stalk z) := by
      intro z
      obtain ⟨U, hU, hzU, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := Y) (x := ι_F.base z)
          (U := ⊤) trivial
      let U_aff : ↑Y.affineOpens := ⟨U, hU⟩
      let V_E : E_F.Opens := ι_F ⁻¹ᵁ U
      have hAffHom : AlgebraicGeometry.IsAffineHom ι_F :=
        (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hCl_ι).1
      have hVE : AlgebraicGeometry.IsAffineOpen V_E := hU.preimage ι_F
      have hφ_surj : Function.Surjective ((ι_F.app U).hom) :=
        (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hCl_ι).2 U hU
      have hKer_φ : RingHom.ker ((ι_F.app U).hom) = I_F.ideal U_aff := by
        rw [← Scheme.Hom.ker_apply ι_F U_aff]
        change (Scheme.Hom.ker I_F.subschemeι).ideal U_aff = I_F.ideal U_aff
        rw [Scheme.IdealSheafData.ker_subschemeι]
      have hRad_IF : (I_F.ideal U_aff).IsRadical := by
        rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
        exact PrimeSpectrum.isRadical_vanishingIdeal _
      have hRed_VE : _root_.IsReduced ↑(E_F.presheaf.obj (Opposite.op V_E)) := by
        refine ⟨fun a ⟨n, han⟩ => ?_⟩
        obtain ⟨r, rfl⟩ := hφ_surj a
        have hrn : r ^ n ∈ I_F.ideal U_aff := by
          rw [← hKer_φ]
          change (ι_F.app U).hom (r ^ n) = 0
          rw [map_pow, han]
        have hr : r ∈ RingHom.ker ((ι_F.app U).hom) := by
          rw [hKer_φ]
          exact hRad_IF ⟨n, hrn⟩
        exact hr
      exact hLocReduced hRed_VE (hVE.isLocalization_stalk ⟨z, hzU⟩)
    have _ : AlgebraicGeometry.IsReduced E_F :=
      @AlgebraicGeometry.isReduced_of_isReduced_stalk E_F hStalkRed
    have _ : IrreducibleSpace ↥E_F := by
      refine {
        isPreirreducible_univ := ?_
        toNonempty := ?_
      }
      · intro O₁ O₂ hO₁ hO₂ ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩
        obtain ⟨W₁, hW₁, rfl⟩ := ι_F.isClosedEmbedding.isInducing.isOpen_iff.mp hO₁
        obtain ⟨W₂, hW₂, rfl⟩ := ι_F.isClosedEmbedding.isInducing.isOpen_iff.mp hO₂
        have hFW₁ : (F ∩ W₁).Nonempty :=
          ⟨ι_F.base x₁, by rw [← hRange_ι]; exact ⟨x₁, rfl⟩, hx₁⟩
        have hFW₂ : (F ∩ W₂).Nonempty :=
          ⟨ι_F.base x₂, by rw [← hRange_ι]; exact ⟨x₂, rfl⟩, hx₂⟩
        obtain ⟨y, hyF, hyW₁, hyW₂⟩ := hIrredF.isPreirreducible W₁ W₂ hW₁ hW₂ hFW₁ hFW₂
        rw [← hRange_ι] at hyF
        obtain ⟨x, rfl⟩ := hyF
        exact ⟨x, trivial, hyW₁, hyW₂⟩
      · obtain ⟨y₀, hy₀⟩ := hIrredF.nonempty
        rw [← hRange_ι] at hy₀
        obtain ⟨x₀, _⟩ := hy₀
        exact ⟨x₀⟩
    have hInt_EF : AlgebraicGeometry.IsIntegral E_F :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced E_F
    refine ⟨E_F, ι_F, hCl_ι, hInt_EF, hRange_ι, ?_, ?_⟩
    · intro S p_Y
      constructor
      · intro hProp
        have _ := hProp
        infer_instance
      · intro hLFT
        have _ := hLFT
        infer_instance
    · intro U hU ⟨y₀, hy₀U, hy₀F⟩
      let U_aff : ↑Y.affineOpens := ⟨U, hU⟩
      let R : Type u := ↑(Y.presheaf.obj (Opposite.op U))
      let S_F : Set (PrimeSpectrum R) := hU.fromSpec.base ⁻¹' F
      let P_F : Ideal R := I_F.ideal U_aff
      have hPF_van : P_F = PrimeSpectrum.vanishingIdeal S_F :=
        Scheme.IdealSheafData.vanishingIdeal_ideal Z_F U_aff
      have hCl_SF : IsClosed S_F := hClF.preimage hU.fromSpec.continuous
      have hZero_PF : PrimeSpectrum.zeroLocus (P_F : Set R) = S_F := by
        rw [hPF_van, PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hCl_SF.closure_eq]
      have hy₀_range : y₀ ∈ Set.range hU.fromSpec.base := by
        rw [hU.range_fromSpec]
        exact hy₀U
      obtain ⟨p₀, hp₀_eq⟩ := hy₀_range
      have hp₀_SF : p₀ ∈ S_F := by
        change hU.fromSpec.base p₀ ∈ F
        rw [hp₀_eq]
        exact hy₀F
      have hIrred_SF : IsIrreducible S_F := by
        refine ⟨⟨p₀, hp₀_SF⟩, ?_⟩
        intro W₁ W₂ hW₁ hW₂ ⟨p₁, hp₁_SF, hp₁_W₁⟩ ⟨p₂, hp₂_SF, hp₂_W₂⟩
        have hOpen₁ : IsOpen (hU.fromSpec.base '' W₁) :=
          hU.fromSpec.isOpenEmbedding.isOpenMap W₁ hW₁
        have hOpen₂ : IsOpen (hU.fromSpec.base '' W₂) :=
          hU.fromSpec.isOpenEmbedding.isOpenMap W₂ hW₂
        have hFW₁ : (F ∩ (hU.fromSpec.base '' W₁)).Nonempty :=
          ⟨hU.fromSpec.base p₁, hp₁_SF, p₁, hp₁_W₁, rfl⟩
        have hFW₂ : (F ∩ (hU.fromSpec.base '' W₂)).Nonempty :=
          ⟨hU.fromSpec.base p₂, hp₂_SF, p₂, hp₂_W₂, rfl⟩
        obtain ⟨y, hyF, ⟨q₁, hq₁W₁, hq₁y⟩, ⟨q₂, hq₂W₂, hq₂y⟩⟩ :=
          hIrredF.isPreirreducible _ _ hOpen₁ hOpen₂ hFW₁ hFW₂
        have hq₁₂ : q₁ = q₂ :=
          hU.fromSpec.isOpenEmbedding.injective (hq₁y.trans hq₂y.symm)
        rw [← hq₁₂] at hq₂W₂
        refine ⟨q₁, ?_, hq₁W₁, hq₂W₂⟩
        change hU.fromSpec.base q₁ ∈ F
        rw [hq₁y]
        exact hyF
      have hPF_prime : P_F.IsPrime := by
        rw [hPF_van, ← PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime]
        exact hIrred_SF
      have hPF_min : P_F ∈ minimalPrimes R := by
        refine ⟨⟨hPF_prime, bot_le⟩, ?_⟩
        rintro Q ⟨hQ_prime, _⟩ hQP
        let p_Q : PrimeSpectrum R := ⟨Q, hQ_prime⟩
        let Z_Q : Set (PrimeSpectrum R) := PrimeSpectrum.zeroLocus (Q : Set R)
        have hZQ_eq : closure ({p_Q} : Set (PrimeSpectrum R)) = Z_Q :=
          PrimeSpectrum.closure_singleton p_Q
        have hIrred_ZQ : IsIrreducible Z_Q := by
          rw [← hZQ_eq]
          exact isIrreducible_singleton.closure
        let K : Set ↥Y := closure (hU.fromSpec.base '' Z_Q)
        have hIrred_K : IsIrreducible K :=
          (hIrred_ZQ.image hU.fromSpec.base hU.fromSpec.continuous.continuousOn).closure
        have hF_sub_union : F ⊆ K ∪ (U : Set ↥Y)ᶜ := by
          intro w hwF
          by_cases hwU : w ∈ (U : Set ↥Y)
          · left
            have hw_range : w ∈ Set.range hU.fromSpec.base := by
              rw [hU.range_fromSpec]
              exact hwU
            obtain ⟨p, rfl⟩ := hw_range
            have hp_zero : p ∈ PrimeSpectrum.zeroLocus (P_F : Set R) := by
              rw [hZero_PF]
              exact hwF
            have hp_ZQ : p ∈ Z_Q := fun r hrQ => hp_zero (hQP hrQ)
            exact subset_closure ⟨p, hp_ZQ, rfl⟩
          · exact Or.inr hwU
        have hF_sub_K : F ⊆ K := by
          by_contra hNotSub
          obtain ⟨z₁, hz₁F, hz₁NotK⟩ := Set.not_subset.mp hNotSub
          have hFKc : (F ∩ Kᶜ).Nonempty := ⟨z₁, hz₁F, hz₁NotK⟩
          have hFU : (F ∩ (U : Set ↥Y)).Nonempty := ⟨y₀, hy₀F, hy₀U⟩
          obtain ⟨w, hwF, hwNotK, hwU⟩ :=
            hIrredF.isPreirreducible Kᶜ (U : Set ↥Y) isClosed_closure.isOpen_compl U.isOpen hFKc hFU
          rcases hF_sub_union hwF with hwK | hwNotU
          · exact hwNotK hwK
          · exact hwNotU hwU
        have hK_le_F : K ⊆ F := hF.2 hIrred_K hF_sub_K
        have hpQ_ZQ : p_Q ∈ Z_Q := fun _ hr => hr
        have hpQ_F : hU.fromSpec.base p_Q ∈ F :=
          hK_le_F (subset_closure ⟨p_Q, hpQ_ZQ, rfl⟩)
        have hpQ_zero : p_Q ∈ PrimeSpectrum.zeroLocus (P_F : Set R) := by
          rw [hZero_PF]
          exact hpQ_F
        exact hpQ_zero
      let V_E : E_F.Opens := ι_F ⁻¹ᵁ U
      have hAffHom : AlgebraicGeometry.IsAffineHom ι_F :=
        (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hCl_ι).1
      have hVE : AlgebraicGeometry.IsAffineOpen V_E := hU.preimage ι_F
      let A_E : Type u := ↑(E_F.presheaf.obj (Opposite.op V_E))
      let φ_E : R →+* A_E := (ι_F.app U).hom
      have hφ_surj : Function.Surjective φ_E :=
        (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hCl_ι).2 U hU
      have hKer_φ : RingHom.ker φ_E = P_F := by
        rw [← Scheme.Hom.ker_apply ι_F U_aff]
        change (Scheme.Hom.ker I_F.subschemeι).ideal U_aff = P_F
        rw [Scheme.IdealSheafData.ker_subschemeι]
      let α_quot : (R ⧸ P_F) →+* A_E :=
        Ideal.Quotient.lift P_F φ_E (fun r hr => by rw [← hKer_φ] at hr; exact hr)
      have hker_mk : RingHom.ker φ_E ≤ RingHom.ker (Ideal.Quotient.mk P_F) := by
        rw [hKer_φ, Ideal.mk_ker]
      obtain ⟨β_quot, hβ_comp⟩ :=
        hDescendRingHom φ_E hφ_surj (Ideal.Quotient.mk P_F) hker_mk
      have hαβ : CommRingCat.ofHom β_quot ≫ CommRingCat.ofHom α_quot =
          𝟙 (E_F.presheaf.obj (Opposite.op V_E)) := by
        ext a
        obtain ⟨r, rfl⟩ := hφ_surj a
        change α_quot ((β_quot.comp φ_E) r) = φ_E r
        rw [hβ_comp]
        rfl
      have hβα : CommRingCat.ofHom α_quot ≫ CommRingCat.ofHom β_quot =
          𝟙 (CommRingCat.of (R ⧸ P_F)) := by
        ext r
        exact RingHom.congr_fun hβ_comp r
      have _ : CategoryTheory.IsIso (CommRingCat.ofHom β_quot) :=
        ⟨⟨CommRingCat.ofHom α_quot, hαβ, hβα⟩⟩
      let j₁ : AlgebraicGeometry.Spec (CommRingCat.of (R ⧸ P_F)) ⟶ E_F :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_quot) ≫ hVE.fromSpec
      have hj₁_open : AlgebraicGeometry.IsOpenImmersion j₁ := inferInstance
      have hj₁_fac : j₁ ≫ ι_F =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P_F)) ≫ hU.fromSpec := by
        have hSpec_comm : AlgebraicGeometry.Spec.map (ι_F.app U) ≫ hU.fromSpec =
            hVE.fromSpec ≫ ι_F := by
          rw [Scheme.Hom.app_eq_appLE]
          exact hU.SpecMap_appLE_fromSpec ι_F hVE le_rfl
        have happ_comp : ι_F.app U ≫ CommRingCat.ofHom β_quot =
            CommRingCat.ofHom (Ideal.Quotient.mk P_F) := by
          ext r
          exact RingHom.congr_fun hβ_comp r
        calc
          j₁ ≫ ι_F = AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_quot) ≫
              (hVE.fromSpec ≫ ι_F) := CategoryTheory.Category.assoc _ _ _
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_quot) ≫
              (AlgebraicGeometry.Spec.map (ι_F.app U) ≫ hU.fromSpec) := by rw [← hSpec_comm]
          _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_quot) ≫
              AlgebraicGeometry.Spec.map (ι_F.app U)) ≫ hU.fromSpec :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = AlgebraicGeometry.Spec.map (ι_F.app U ≫ CommRingCat.ofHom β_quot) ≫
              hU.fromSpec :=
              congrArg (· ≫ hU.fromSpec)
                (AlgebraicGeometry.Spec.map_comp (ι_F.app U) (CommRingCat.ofHom β_quot)).symm
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P_F)) ≫
              hU.fromSpec := by rw [happ_comp]
      exact ⟨P_F, j₁, hPF_min, hj₁_open, hZero_PF, hj₁_fac⟩

  
  have hZigzag : ∀ (Ω : Type u) [CommRing Ω]
      (X : AlgebraicGeometry.Scheme.{u})
      (p : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (D₀ D₁ : Type u) [CommRing D₀] [Algebra Ω D₀] [CommRing D₁] [Algebra Ω D₁]
      (j₀ : AlgebraicGeometry.Spec (CommRingCat.of D₀) ⟶ X)
      (j₁ : AlgebraicGeometry.Spec (CommRingCat.of D₁) ⟶ X),
      AlgebraicGeometry.IsOpenImmersion j₀ →
      AlgebraicGeometry.IsOpenImmersion j₁ →
      j₀ ≫ p = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D₀)) →
      j₁ ≫ p = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D₁)) →
      ∀ (q₀ : PrimeSpectrum D₀) (q₁ : PrimeSpectrum D₁),
        j₀.base q₀ = j₁.base q₁ →
        Nonempty (Localization.AtPrime q₀.asIdeal ≃ₐ[Ω] Localization.AtPrime q₁.asIdeal) := by
    
    have hAwayLoc : ∀ {R : Type u} [CommRing R] (f : R)
        (P : PrimeSpectrum (Localization.Away f))
        (I : Ideal R) [I.IsPrime]
        (hIP : I = Ideal.comap (algebraMap R (Localization.Away f)) P.asIdeal),
        Function.Bijective
          (Localization.localRingHom I P.asIdeal (algebraMap R (Localization.Away f)) hIP) := by
      intro R _ f P I _ hIP
      subst hIP
      have _ : P.asIdeal.IsPrime := P.isPrime
      let e_R := IsLocalization.localizationLocalizationAtPrimeIsoLocalization
        (Submonoid.powers f) P.asIdeal
      have he_eq : e_R.toRingHom =
          Localization.localRingHom
            (Ideal.comap (algebraMap R (Localization.Away f)) P.asIdeal)
            P.asIdeal (algebraMap R (Localization.Away f)) rfl := by
        apply IsLocalization.ringHom_ext
          (Ideal.comap (algebraMap R (Localization.Away f)) P.asIdeal).primeCompl
        ext r
        change e_R
            (algebraMap R
              (Localization.AtPrime (Ideal.comap (algebraMap R (Localization.Away f)) P.asIdeal)) r) =
          (Localization.localRingHom
            (Ideal.comap (algebraMap R (Localization.Away f)) P.asIdeal)
            P.asIdeal (algebraMap R (Localization.Away f)) rfl)
            (algebraMap R
              (Localization.AtPrime (Ideal.comap (algebraMap R (Localization.Away f)) P.asIdeal)) r)
        rw [e_R.commutes r, Localization.localRingHom_to_map]
        exact IsScalarTower.algebraMap_apply R (Localization.Away f) (Localization.AtPrime P.asIdeal) r
      rw [← he_eq]
      exact e_R.bijective
    
    have hShrinkLift : ∀ {A B : Type u} [CommRing A] [CommRing B]
        {Z : AlgebraicGeometry.Scheme.{u}}
        (u : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Z)
        (v : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ Z)
        [AlgebraicGeometry.IsOpenImmersion u] [AlgebraicGeometry.IsOpenImmersion v]
        (x_A : PrimeSpectrum A) (x_B : PrimeSpectrum B),
        u.base x_A = v.base x_B →
        ∃ (f : A) (y_Af : PrimeSpectrum (Localization.Away f))
          (g : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f)) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of B))
          (φ : B →+* Localization.Away f),
          AlgebraicGeometry.IsOpenImmersion g ∧
          PrimeSpectrum.comap (algebraMap A (Localization.Away f)) y_Af = x_A ∧
          g ≫ v =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away f))) ≫ u ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) = g ∧
          g.base y_Af = x_B ∧
          PrimeSpectrum.comap φ y_Af = x_B := by
      intro A B _ _ Z u v _ _ x_A x_B hux
      let W : Set (PrimeSpectrum A) := u.base ⁻¹' (Set.range v.base)
      have hOpenW : IsOpen W := v.isOpenEmbedding.isOpen_range.preimage u.continuous
      have hxW : x_A ∈ W := ⟨x_B, hux.symm⟩
      obtain ⟨_, ⟨f, rfl⟩, hxf, hf_sub⟩ :=
        (PrimeSpectrum.isTopologicalBasis_basic_opens (R := A)).mem_nhds_iff.mp
          (hOpenW.mem_nhds hxW)
      let A_f := Localization.Away f
      let ι_f : AlgebraicGeometry.Spec (CommRingCat.of A_f) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of A) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A A_f))
      have hx_range : x_A ∈ Set.range (PrimeSpectrum.comap (algebraMap A A_f)) := by
        rw [PrimeSpectrum.localization_away_comap_range A_f f]
        exact hxf
      obtain ⟨y_Af, hy_Af⟩ := hx_range
      have hSub_range : Set.range (ι_f ≫ u).base ⊆ Set.range v.base := by
        rintro _ ⟨z, rfl⟩
        have hz_mem : PrimeSpectrum.comap (algebraMap A A_f) z ∈
            (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum A)) := by
          rw [← PrimeSpectrum.localization_away_comap_range A_f f]
          exact ⟨z, rfl⟩
        exact hf_sub hz_mem
      let g := AlgebraicGeometry.IsOpenImmersion.lift v (ι_f ≫ u) hSub_range
      have hg_open : AlgebraicGeometry.IsOpenImmersion g := inferInstance
      have hg_fac : g ≫ v = ι_f ≫ u :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac v (ι_f ≫ u) hSub_range
      let φ : B →+* A_f := (AlgebraicGeometry.Spec.preimage g).hom
      have hφ_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) = g :=
        AlgebraicGeometry.Spec.map_preimage g
      have hg_pt : g.base y_Af = x_B := by
        apply v.isOpenEmbedding.injective
        calc
          v.base (g.base y_Af) = (g ≫ v).base y_Af := rfl
          _ = (ι_f ≫ u).base y_Af := by rw [hg_fac]
          _ = u.base (PrimeSpectrum.comap (algebraMap A A_f) y_Af) := rfl
          _ = u.base x_A := by rw [hy_Af]
          _ = v.base x_B := hux
      have hφ_comap : PrimeSpectrum.comap φ y_Af = x_B := by
        have h1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).base y_Af =
            PrimeSpectrum.comap φ y_Af := rfl
        rw [← h1, hφ_map]
        exact hg_pt
      exact ⟨f, y_Af, g, φ, hg_open, hy_Af, hg_fac, hφ_map, hg_pt, hφ_comap⟩
    
    have hLocalComp : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
        (I : Ideal A) [I.IsPrime] (J : Ideal B) [J.IsPrime] (K : Ideal C) [K.IsPrime]
        (f : A →+* B) (hf : I = Ideal.comap f J)
        (g : B →+* C) (hg : J = Ideal.comap g K)
        (h : A →+* C) (hh : g.comp f = h) (hIK : I = Ideal.comap h K),
        (Localization.localRingHom J K g hg).comp (Localization.localRingHom I J f hf) =
          Localization.localRingHom I K h hIK := by
      intro A B C _ _ _ I _ J _ K _ f hf g hg h hh hIK
      apply IsLocalization.ringHom_ext I.primeCompl
      ext a
      simp only [RingHom.comp_apply]
      rw [Localization.localRingHom_to_map, Localization.localRingHom_to_map,
        Localization.localRingHom_to_map, ← hh]
      rfl
    intro Ω _ X p D₀ D₁ _ _ _ _ j₀ j₁ hj₀ hj₁ hj₀_comm hj₁_comm q₀ q₁ hq_eq
    have _ := hj₀
    have _ := hj₁
    
    obtain ⟨f₀, p₀, g₁, α, hg₁_open, hp₀_q₀, hg₁_fac, hα_map, hg₁_pt, hα_comap⟩ :=
      hShrinkLift j₀ j₁ q₀ q₁ hq_eq
    have _ := hg₁_open
    let A₀ := Localization.Away f₀
    have hα_alg : α.comp (algebraMap Ω D₁) = algebraMap Ω A₀ := by
      have hSpec_eq :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α.comp (algebraMap Ω D₁))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω A₀)) := by
        have htower : (algebraMap D₀ A₀).comp (algebraMap Ω D₀) = algebraMap Ω A₀ := by
          ext c
          exact (IsScalarTower.algebraMap_apply Ω D₀ A₀ c).symm
        calc
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α.comp (algebraMap Ω D₁)))
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D₁)) := by
                rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          _ = g₁ ≫ (j₁ ≫ p) := by rw [hα_map, hj₁_comm]
          _ = (g₁ ≫ j₁) ≫ p := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀ A₀)) ≫ j₀) ≫ p := by
                rw [hg₁_fac]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀ A₀)) ≫ (j₀ ≫ p) :=
                CategoryTheory.Category.assoc _ _ _
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀ A₀)) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D₀)) := by
                rw [hj₀_comm]
          _ = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((algebraMap D₀ A₀).comp (algebraMap Ω D₀))) := by
                rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω A₀)) := by
                rw [htower]
      have hpre := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
      rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hpre
      exact congrArg CommRingCat.Hom.hom hpre
    
    obtain ⟨f₁, p₁, g₂, β, hg₂_open, hp₁_q₁, hg₂_fac, hβ_map, hg₂_pt, hβ_comap⟩ :=
      hShrinkLift (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of D₁))) g₁ q₁ p₀ hg₁_pt.symm
    have _ := hg₂_open
    let A₁ := Localization.Away f₁
    have hβα : β.comp α = algebraMap D₁ A₁ := by
      have hSpec_eq :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β.comp α)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₁ A₁)) := by
        calc
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β.comp α))
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom β) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) := by
                rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          _ = g₂ ≫ g₁ := by rw [hβ_map, hα_map]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₁ A₁)) ≫ 𝟙 _ := hg₂_fac
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₁ A₁)) :=
                CategoryTheory.Category.comp_id _
      have hpre := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
      rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hpre
      exact congrArg CommRingCat.Hom.hom hpre
    
    obtain ⟨h₀, r₀, g₃, γ, _, hr₀_p₀, hg₃_fac, hγ_map, _, hγ_comap⟩ :=
      hShrinkLift (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of A₀))) g₂ p₀ p₁ hg₂_pt.symm
    let B₀ := Localization.Away h₀
    have hγβ : γ.comp β = algebraMap A₀ B₀ := by
      have hSpec_eq :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (γ.comp β)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ B₀)) := by
        calc
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (γ.comp β))
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom β) := by
                rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          _ = g₃ ≫ g₂ := by rw [hγ_map, hβ_map]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ B₀)) ≫ 𝟙 _ := hg₃_fac
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ B₀)) :=
                CategoryTheory.Category.comp_id _
      have hpre := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
      rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hpre
      exact congrArg CommRingCat.Hom.hom hpre
    
    have _ : q₀.asIdeal.IsPrime := q₀.isPrime
    have _ : q₁.asIdeal.IsPrime := q₁.isPrime
    have _ : p₀.asIdeal.IsPrime := p₀.isPrime
    have _ : p₁.asIdeal.IsPrime := p₁.isPrime
    have _ : r₀.asIdeal.IsPrime := r₀.isPrime
    have hα_id : q₁.asIdeal = Ideal.comap α p₀.asIdeal :=
      (congrArg PrimeSpectrum.asIdeal hα_comap).symm
    have hβ_id : p₀.asIdeal = Ideal.comap β p₁.asIdeal :=
      (congrArg PrimeSpectrum.asIdeal hβ_comap).symm
    have hγ_id : p₁.asIdeal = Ideal.comap γ r₀.asIdeal :=
      (congrArg PrimeSpectrum.asIdeal hγ_comap).symm
    have hp₁_id : q₁.asIdeal = Ideal.comap (algebraMap D₁ A₁) p₁.asIdeal :=
      (congrArg PrimeSpectrum.asIdeal hp₁_q₁).symm
    have hr₀_id : p₀.asIdeal = Ideal.comap (algebraMap A₀ B₀) r₀.asIdeal :=
      (congrArg PrimeSpectrum.asIdeal hr₀_p₀).symm
    let α_loc := Localization.localRingHom q₁.asIdeal p₀.asIdeal α hα_id
    let β_loc := Localization.localRingHom p₀.asIdeal p₁.asIdeal β hβ_id
    let γ_loc := Localization.localRingHom p₁.asIdeal r₀.asIdeal γ hγ_id
    have hComp₁ : β_loc.comp α_loc =
        Localization.localRingHom q₁.asIdeal p₁.asIdeal (algebraMap D₁ A₁) hp₁_id :=
      hLocalComp q₁.asIdeal p₀.asIdeal p₁.asIdeal α hα_id β hβ_id (algebraMap D₁ A₁) hβα hp₁_id
    have hComp₂ : γ_loc.comp β_loc =
        Localization.localRingHom p₀.asIdeal r₀.asIdeal (algebraMap A₀ B₀) hr₀_id :=
      hLocalComp p₀.asIdeal p₁.asIdeal r₀.asIdeal β hβ_id γ hγ_id (algebraMap A₀ B₀) hγβ hr₀_id
    have hBij₁ : Function.Bijective (β_loc.comp α_loc) := by
      rw [hComp₁]
      exact hAwayLoc f₁ p₁ q₁.asIdeal hp₁_id
    have hBij₂ : Function.Bijective (γ_loc.comp β_loc) := by
      rw [hComp₂]
      exact hAwayLoc h₀ r₀ p₀.asIdeal hr₀_id
    have hInj_α : Function.Injective α_loc :=
      fun x y hxy => hBij₁.1 (congrArg β_loc hxy)
    have hInj_β : Function.Injective β_loc :=
      fun x y hxy => hBij₂.1 (congrArg γ_loc hxy)
    have hBij_α : Function.Bijective α_loc := by
      refine ⟨hInj_α, fun y => ?_⟩
      obtain ⟨x, hx⟩ := hBij₁.2 (β_loc y)
      exact ⟨x, hInj_β hx⟩
    let α_alg : Localization.AtPrime q₁.asIdeal →ₐ[Ω] Localization.AtPrime p₀.asIdeal := {
      α_loc with
      commutes' := fun c => by
        rw [IsScalarTower.algebraMap_apply Ω D₁ (Localization.AtPrime q₁.asIdeal) c]
        change α_loc (algebraMap D₁ (Localization.AtPrime q₁.asIdeal) (algebraMap Ω D₁ c)) =
          algebraMap Ω (Localization.AtPrime p₀.asIdeal) c
        rw [Localization.localRingHom_to_map]
        have hc : α (algebraMap Ω D₁ c) = algebraMap Ω A₀ c := RingHom.congr_fun hα_alg c
        rw [hc, ← IsScalarTower.algebraMap_apply Ω A₀ (Localization.AtPrime p₀.asIdeal) c]
    }
    let e_10 : Localization.AtPrime q₁.asIdeal ≃ₐ[Ω] Localization.AtPrime p₀.asIdeal :=
      AlgEquiv.ofBijective α_alg hBij_α
    let e_00_D₀ : Localization.AtPrime (Ideal.comap (algebraMap D₀ A₀) p₀.asIdeal) ≃ₐ[D₀]
        Localization.AtPrime p₀.asIdeal :=
      IsLocalization.localizationLocalizationAtPrimeIsoLocalization (Submonoid.powers f₀) p₀.asIdeal
    let e_00_Ω : Localization.AtPrime (Ideal.comap (algebraMap D₀ A₀) p₀.asIdeal) ≃ₐ[Ω]
        Localization.AtPrime p₀.asIdeal :=
      e_00_D₀.restrictScalars Ω
    have hAtPrimeCongr : ∀ {A : Type u} [CommRing A] [Algebra Ω A]
        (I J : Ideal A) [I.IsPrime] [J.IsPrime],
        I = J → (Localization.AtPrime I ≃ₐ[Ω] Localization.AtPrime J) := by
      intro A _ _ I J _ _ hIJ
      subst hIJ
      exact AlgEquiv.refl
    let e_q₀ : Localization.AtPrime q₀.asIdeal ≃ₐ[Ω]
        Localization.AtPrime (Ideal.comap (algebraMap D₀ A₀) p₀.asIdeal) :=
      hAtPrimeCongr q₀.asIdeal (Ideal.comap (algebraMap D₀ A₀) p₀.asIdeal)
        (congrArg PrimeSpectrum.asIdeal hp₀_q₀).symm
    exact ⟨(e_q₀.trans e_00_Ω).trans e_10.symm⟩

  
  have hInterSec : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (Y E₁ E₂ : AlgebraicGeometry.Scheme.{u})
      (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      [AlgebraicGeometry.LocallyOfFiniteType p_Y]
      (ι₁ : E₁ ⟶ Y) (ι₂ : E₂ ⟶ Y),
      AlgebraicGeometry.IsClosedImmersion ι₁ →
      AlgebraicGeometry.IsClosedImmersion ι₂ →
      (Set.range ι₁.base ∩ Set.range ι₂.base).Nonempty →
      ∃ (pt : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y),
        pt ≫ p_Y = 𝟙 _ ∧
        (∃ s₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E₁, s₁ ≫ ι₁ = pt) ∧
        (∃ s₂ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E₂, s₂ ≫ ι₂ = pt) := by
    intro Ω _ _ Y E₁ E₂ p_Y _ ι₁ ι₂ hCl₁ hCl₂ ⟨z, ⟨e₁, he₁⟩, ⟨e₂, he₂⟩⟩
    obtain ⟨U, hU, hzU, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := Y) (x := z) (U := ⊤) trivial
    let R : Type u := ↑(Y.presheaf.obj (Opposite.op U))
    let j_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y := hU.fromSpec
    let α_R : Ω →+* R := (AlgebraicGeometry.Spec.preimage (j_R ≫ p_Y)).hom
    let _ : Algebra Ω R := α_R.toAlgebra
    have hjR_comm : j_R ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω R)) :=
      (AlgebraicGeometry.Spec.map_preimage (j_R ≫ p_Y)).symm
    have hLFT_jRp : AlgebraicGeometry.LocallyOfFiniteType (j_R ≫ p_Y) := inferInstance
    rw [hjR_comm] at hLFT_jRp
    have hFT_hom : (algebraMap Ω R).FiniteType :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp
        hLFT_jRp
    have _ : Algebra.FiniteType Ω R := RingHom.finiteType_algebraMap.mp hFT_hom
    have hz_range : z ∈ Set.range j_R.base := by
      change z ∈ Set.range ⇑hU.fromSpec
      rw [hU.range_fromSpec]
      exact hzU
    obtain ⟨z_R, hz_R⟩ := hz_range
    have hSubChart : ∀ {E : AlgebraicGeometry.Scheme.{u}} (ι : E ⟶ Y)
        [AlgebraicGeometry.IsClosedImmersion ι] (e : ↥E),
        ι.base e = z →
        ∃ (hV : AlgebraicGeometry.IsAffineOpen (ι ⁻¹ᵁ U)),
          Function.Surjective ((ι.app U).hom) ∧
          RingHom.ker ((ι.app U).hom) ≤ z_R.asIdeal ∧
          AlgebraicGeometry.Spec.map (ι.app U) ≫ j_R = hV.fromSpec ≫ ι := by
      intro E ι hCl e he
      let V : E.Opens := ι ⁻¹ᵁ U
      have hAffHom : AlgebraicGeometry.IsAffineHom ι :=
        (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hCl).1
      have hV : AlgebraicGeometry.IsAffineOpen V := hU.preimage ι
      have hSurj : Function.Surjective ((ι.app U).hom) :=
        (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hCl).2 U hU
      have hSpec_comm : AlgebraicGeometry.Spec.map (ι.app U) ≫ j_R = hV.fromSpec ≫ ι := by
        rw [Scheme.Hom.app_eq_appLE]
        exact hU.SpecMap_appLE_fromSpec ι hV le_rfl
      have heV : e ∈ V := by
        change ι.base e ∈ U
        rw [he]
        exact hzU
      have he_range : e ∈ Set.range hV.fromSpec.base := by
        rw [hV.range_fromSpec]
        exact heV
      obtain ⟨p_E, hp_E⟩ := he_range
      have hp_comap : (AlgebraicGeometry.Spec.map (ι.app U)).base p_E = z_R := by
        apply j_R.isOpenEmbedding.injective
        calc
          j_R.base ((AlgebraicGeometry.Spec.map (ι.app U)).base p_E)
            = (AlgebraicGeometry.Spec.map (ι.app U) ≫ j_R).base p_E := rfl
          _ = (hV.fromSpec ≫ ι).base p_E := by rw [hSpec_comm]
          _ = ι.base (hV.fromSpec.base p_E) := rfl
          _ = ι.base e := by rw [hp_E]
          _ = z := he
          _ = j_R.base z_R := hz_R.symm
      have hker_le : RingHom.ker ((ι.app U).hom) ≤ z_R.asIdeal := by
        intro r hr
        have h1 : (AlgebraicGeometry.Spec.map (ι.app U)).base p_E =
            PrimeSpectrum.comap ((ι.app U).hom) p_E := rfl
        rw [← hp_comap, h1]
        change (ι.app U).hom r ∈ p_E.asIdeal
        have hr0 : (ι.app U).hom r = 0 := hr
        rw [hr0]
        exact p_E.asIdeal.zero_mem
      exact ⟨hV, hSurj, hker_le, hSpec_comm⟩
    have _ := hCl₁
    have _ := hCl₂
    obtain ⟨hV₁, hSurj₁, hKer₁, hComm₁⟩ := hSubChart ι₁ e₁ he₁
    obtain ⟨hV₂, hSurj₂, hKer₂, hComm₂⟩ := hSubChart ι₂ e₂ he₂
    have hSup_ne_top : RingHom.ker ((ι₁.app U).hom) ⊔ RingHom.ker ((ι₂.app U).hom) ≠ ⊤ :=
      ne_top_of_le_ne_top z_R.isPrime.ne_top (sup_le hKer₁ hKer₂)
    obtain ⟨𝔪, h𝔪_max, hSup_𝔪⟩ := Ideal.exists_le_maximal _ hSup_ne_top
    obtain ⟨ev, hev_ker⟩ := hNull Ω R 𝔪 h𝔪_max
    let pt : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev.toRingHom) ≫ j_R
    have hpt_sec : pt ≫ p_Y = 𝟙 _ := by
      have hid : CommRingCat.ofHom (algebraMap Ω R) ≫ CommRingCat.ofHom ev.toRingHom =
          𝟙 (CommRingCat.of Ω) := by
        ext c
        exact ev.commutes c
      calc
        pt ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev.toRingHom) ≫ (j_R ≫ p_Y) :=
          CategoryTheory.Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω R)) := by rw [hjR_comm]
        _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap Ω R) ≫ CommRingCat.ofHom ev.toRingHom) := by
            rw [← AlgebraicGeometry.Spec.map_comp]
        _ = 𝟙 _ := by rw [hid, AlgebraicGeometry.Spec.map_id]
    obtain ⟨ev₁, hev₁⟩ := hDescendRingHom ((ι₁.app U).hom) hSurj₁ ev.toRingHom
      (le_sup_left.trans (hev_ker.symm ▸ hSup_𝔪))
    obtain ⟨ev₂, hev₂⟩ := hDescendRingHom ((ι₂.app U).hom) hSurj₂ ev.toRingHom
      (le_sup_right.trans (hev_ker.symm ▸ hSup_𝔪))
    have hmk_sec : ∀ {E : AlgebraicGeometry.Scheme.{u}} (ι : E ⟶ Y)
        (hV : AlgebraicGeometry.IsAffineOpen (ι ⁻¹ᵁ U))
        (hComm : AlgebraicGeometry.Spec.map (ι.app U) ≫ j_R = hV.fromSpec ≫ ι)
        (ev_E : ↑(E.presheaf.obj (Opposite.op (ι ⁻¹ᵁ U))) →+* Ω)
        (hev_E : ev_E.comp ((ι.app U).hom) = ev.toRingHom),
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_E) ≫ hV.fromSpec) ≫ ι = pt := by
      intro E ι hV hComm ev_E hev_E
      have hhom : ι.app U ≫ CommRingCat.ofHom ev_E = CommRingCat.ofHom ev.toRingHom := by
        ext r
        exact RingHom.congr_fun hev_E r
      calc
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_E) ≫ hV.fromSpec) ≫ ι
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_E) ≫ (hV.fromSpec ≫ ι) :=
            CategoryTheory.Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_E) ≫
            (AlgebraicGeometry.Spec.map (ι.app U) ≫ j_R) := by rw [← hComm]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_E) ≫
            AlgebraicGeometry.Spec.map (ι.app U)) ≫ j_R :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = AlgebraicGeometry.Spec.map (ι.app U ≫ CommRingCat.ofHom ev_E) ≫ j_R := by
            rw [← AlgebraicGeometry.Spec.map_comp]
        _ = pt := by rw [hhom]
    exact ⟨pt, hpt_sec,
      ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₁) ≫ hV₁.fromSpec,
        hmk_sec ι₁ hV₁ hComm₁ ev₁ hev₁⟩,
      ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₂) ≫ hV₂.fromSpec,
        hmk_sec ι₂ hV₂ hComm₂ ev₂ hev₂⟩⟩

  
  refine ⟨hUniqueRed, ?_, hInterSec⟩
  intro Ω _ _ Y p_Y _ F hF
  obtain ⟨E_F, ι_F, hCl_F, hInt_EF, hRange_F, hMor_F, hChart_F⟩ := hCompPkg Y F hF
  have _ := hCl_F
