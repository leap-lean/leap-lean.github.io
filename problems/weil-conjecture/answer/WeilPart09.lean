            _ = φ_g m₀ + φ_g r₀ * φ_g b := by rw [hbm]
            _ = φ_g (m₀ + b * r₀) := by rw [map_add, map_mul, mul_comm (φ_g r₀)]
            _ = 1 := by rw [hm_add, map_one]
        rw [← hφ_eq]
        exact J.add_mem (h𝔫J (Ideal.mem_map_of_mem φ_g hm₀)) (J.mul_mem_left _ hxJ)
      have hDVR_N : IsDiscreteValuationRing (Localization.AtPrime 𝔫) := (hDVR_g 𝔫).2
      let N_loc := Localization.AtPrime 𝔫
      let lam₀ : B₀ →+* N_loc := (algebraMap A_g N_loc).comp φ_g
      have hKer_lam₀ : RingHom.ker lam₀ = 𝔮 := by
        have hPr_lam₀ : (RingHom.ker lam₀).IsPrime := RingHom.ker_isPrime lam₀
        have hle : RingHom.ker lam₀ ≤ 𝔮 := by
          intro x hx
          have h0 : algebraMap A_g N_loc (φ_g x) = 0 := hx
          obtain ⟨⟨t, ht⟩, htx⟩ :=
            (IsLocalization.map_eq_zero_iff 𝔫.primeCompl N_loc (φ_g x)).mp h0
          have ht_ne : t ≠ 0 := fun h => ht (h ▸ 𝔫.zero_mem)
          have hφx0 : φ_g x = 0 := (mul_eq_zero.mp htx).resolve_left ht_ne
          obtain ⟨⟨m_p, hm_p⟩, hmx⟩ :=
            (IsLocalization.map_eq_zero_iff M_g A_g x).mp hφx0
          obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff m_p g).mp hm_p
          have hgx_mem : g ^ n * x ∈ 𝔮 := by
            dsimp at hmx
            rw [hmx]
            exact 𝔮.zero_mem
          have hg_not_𝔮 : g ∉ 𝔮 := fun hg => hg_not (h𝔮_le_𝔪_tilde hg)
          rcases h𝔮.1.1.mem_or_mem hgx_mem with hgn | hx_q
          · exact False.elim (hg_not_𝔮 (h𝔮.1.1.mem_of_pow_mem n hgn))
          · exact hx_q
        exact le_antisymm hle (h𝔮.2 ⟨hPr_lam₀, bot_le⟩ hle)
      let α_q : B_q →+* N_loc :=
        Ideal.Quotient.lift 𝔮 lam₀ (fun x hx => by rw [← RingHom.mem_ker, hKer_lam₀]; exact hx)
      have hα_inj : Function.Injective α_q := by
        rw [injective_iff_map_eq_zero]
        intro y hy
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (by rw [← hKer_lam₀]; exact hy)
      let instAlgBqN : Algebra B_q N_loc := α_q.toAlgebra
      have hIsLocBq : IsLocalization 𝔪.primeCompl N_loc := by
        refine ⟨?_, ?_, ?_⟩
        · intro s
          obtain ⟨b, hb_eq⟩ := Ideal.Quotient.mk_surjective s.1
          have hb_not : b ∉ 𝔪_tilde := by
            intro hb_in
            apply s.2
            rw [← hb_eq]
            exact hb_in
          have hφb_not : φ_g b ∉ 𝔫 := by
            rw [← Ideal.mem_comap, hComap_𝔫]
            exact hb_not
          have hEqMap : algebraMap B_q N_loc s.1 = algebraMap A_g N_loc (φ_g b) := by
            change α_q s.1 = lam₀ b
            rw [← hb_eq]
            rfl
          rw [hEqMap]
          exact IsLocalization.map_units N_loc (⟨φ_g b, hφb_not⟩ : 𝔫.primeCompl)
        · intro z
          obtain ⟨⟨a₁, t₁⟩, hat₁⟩ := IsLocalization.surj 𝔫.primeCompl z
          obtain ⟨⟨b₁, m₁⟩, hbm₁⟩ := IsLocalization.surj M_g a₁
          obtain ⟨⟨s₂, m₂⟩, hsm₂⟩ := IsLocalization.surj M_g t₁.1
          change z * algebraMap A_g N_loc t₁.1 = algebraMap A_g N_loc a₁ at hat₁
          change a₁ * φ_g m₁.1 = φ_g b₁ at hbm₁
          change t₁.1 * φ_g m₂.1 = φ_g s₂ at hsm₂
          have hφm₂_not : φ_g m₂.1 ∉ 𝔫 := by
            obtain ⟨k₂, hk₂⟩ := (Submonoid.mem_powers_iff m₂.1 g).mp m₂.2
            rw [← Ideal.mem_comap, hComap_𝔫, ← hk₂]
            exact fun hpow => hg_not (h𝔪_tilde_prime.mem_of_pow_mem k₂ hpow)
          have hs₂_not : s₂ ∉ 𝔪_tilde := by
            rw [← hComap_𝔫, Ideal.mem_comap, ← hsm₂]
            exact fun hmul => (h𝔫_prime.mem_or_mem hmul).elim t₁.2 hφm₂_not
          have hm₁_not : m₁.1 ∉ 𝔪_tilde := by
            obtain ⟨k₁, hk₁⟩ := (Submonoid.mem_powers_iff m₁.1 g).mp m₁.2
            rw [← hk₁]
            exact fun hpow => hg_not (h𝔪_tilde_prime.mem_of_pow_mem k₁ hpow)
          have hs_tot_not : Ideal.Quotient.mk 𝔮 (s₂ * m₁.1) ∉ 𝔪 :=
            fun hmem => (h𝔪_tilde_prime.mem_or_mem hmem).elim hs₂_not hm₁_not
          refine ⟨(Ideal.Quotient.mk 𝔮 (b₁ * m₂.1), ⟨Ideal.Quotient.mk 𝔮 (s₂ * m₁.1), hs_tot_not⟩), ?_⟩
          change z * lam₀ (s₂ * m₁.1) = lam₀ (b₁ * m₂.1)
          dsimp [lam₀]
          rw [map_mul φ_g s₂ m₁.1, map_mul (algebraMap A_g N_loc), ← hsm₂,
            map_mul (algebraMap A_g N_loc) t₁.1, ← mul_assoc, ← mul_assoc, hat₁,
            map_mul φ_g b₁ m₂.1, map_mul (algebraMap A_g N_loc)]
          have hbm₁_N := congrArg (algebraMap A_g N_loc) hbm₁
          rw [map_mul] at hbm₁_N
          calc
            algebraMap A_g N_loc a₁ * algebraMap A_g N_loc (φ_g m₂.1) *
                algebraMap A_g N_loc (φ_g m₁.1) =
              (algebraMap A_g N_loc a₁ * algebraMap A_g N_loc (φ_g m₁.1)) *
                algebraMap A_g N_loc (φ_g m₂.1) := by ring
            _ = algebraMap A_g N_loc (φ_g b₁) * algebraMap A_g N_loc (φ_g m₂.1) := by rw [hbm₁_N]
        · intro x₁ x₂ hx
          have hEq : x₁ = x₂ := hα_inj hx
          exact ⟨1, by rw [hEq]⟩
      have hUnits_K : ∀ y : 𝔪.primeCompl, IsUnit (ι_q.toRingHom y.1) := by
        intro y
        have hy0 : y.1 ≠ 0 := fun h0 => y.2 (h0 ▸ 𝔪.zero_mem)
        exact IsUnit.mk0 (ι_q y.1) (fun h => hy0 (hInj_ι (h.trans (map_zero ι_q).symm)))
      let j_ring : N_loc →+* K_q := IsLocalization.lift (M := 𝔪.primeCompl) hUnits_K
      have hj_eq : ∀ b : B_q, j_ring (α_q b) = ι_q b :=
        fun b => IsLocalization.lift_eq (M := 𝔪.primeCompl) hUnits_K b
      have hj_inj : Function.Injective j_ring := by
        rw [injective_iff_map_eq_zero]
        intro w hw
        obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj 𝔪.primeCompl w
        change w * α_q s.1 = α_q b at hbs
        have h_ib : ι_q b = 0 := by
          rw [← hj_eq b, ← hbs, map_mul, hw, zero_mul]
        have hb0 : b = 0 := hInj_ι (h_ib.trans (map_zero ι_q).symm)
        obtain ⟨u_s, hus⟩ := IsLocalization.map_units N_loc s
        change (u_s : N_loc) = α_q s.1 at hus
        have hw_mul : w * ↑u_s = 0 := by
          rw [hus, hbs, hb0, map_zero]
        calc
          w = (w * ↑u_s) * ↑(u_s⁻¹) := by rw [mul_assoc, Units.mul_inv, mul_one]
          _ = 0 := by rw [hw_mul, zero_mul]
      let instAlgkN : Algebra k₀ N_loc := (α_q.comp (algebraMap k₀ B_q)).toAlgebra
      let j_alg : N_loc →ₐ[k₀] K_q :=
        { toRingHom := j_ring
          commutes' := fun c => (hj_eq (algebraMap k₀ B_q c)).trans (ι_q.commutes c) }
      let O_j : Subalgebra k₀ K_q := j_alg.range
      let e_j : N_loc ≃ₐ[k₀] ↥O_j := AlgEquiv.ofInjective j_alg hj_inj
      have hDVR_O : IsDiscreteValuationRing ↥O_j :=
        IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing e_j
      have hLoc_O : IsLocalRing ↥O_j := inferInstance
      obtain ⟨t_j, ht_irr⟩ := IsDiscreteValuationRing.exists_irreducible ↥O_j
      have ht_ne : (t_j : K_q) ≠ 0 := fun h0 => ht_irr.ne_zero (Subtype.ext h0)
      have hMax_O : IsLocalRing.maximalIdeal ↥O_j = Ideal.span {t_j} :=
        (IsDiscreteValuationRing.irreducible_iff_uniformizer t_j).mp ht_irr
      have hMemB : ∀ b : B_q, ι_q b ∈ O_j := fun b => ⟨α_q b, hj_eq b⟩
      let β_j : B_q →ₐ[k₀] ↥O_j :=
        { toFun := fun b => ⟨ι_q b, hMemB b⟩
          map_one' := Subtype.ext (map_one ι_q)
          map_mul' := fun x y => Subtype.ext (map_mul ι_q x y)
          map_zero' := Subtype.ext (map_zero ι_q)
          map_add' := fun x y => Subtype.ext (map_add ι_q x y)
          commutes' := fun c => Subtype.ext (ι_q.commutes c) }
      have hβ_eq : ∀ b : B_q, β_j b = e_j (α_q b) :=
        fun b => Subtype.ext (hj_eq b).symm
      have hβ_mem_iff : ∀ b : B_q, β_j b ∈ Ideal.span {t_j} ↔ b ∈ 𝔪 := by
        intro b
        rw [← hMax_O]
        have hUnit_ej : IsUnit (e_j (α_q b)) ↔ IsUnit (α_q b) :=
          ⟨fun hu => by simpa using hu.map e_j.symm.toRingHom,
           fun hu => hu.map e_j.toRingHom⟩
        have h1 : β_j b ∉ IsLocalRing.maximalIdeal ↥O_j ↔ b ∉ 𝔪 := by
          rw [IsLocalRing.notMem_maximalIdeal, hβ_eq b, hUnit_ej,
            show α_q b = algebraMap B_q N_loc b from rfl,
            IsLocalization.AtPrime.isUnit_to_map_iff N_loc 𝔪 b]
          rfl
        exact not_iff_not.mp h1
      have hStalk_O : ∀ w : ↥O_j, ∃ (b s : B_q), s ∉ 𝔪 ∧ (w : K_q) * ι_q s = ι_q b := by
        intro w
        obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj 𝔪.primeCompl (e_j.symm w)
        change e_j.symm w * α_q s.1 = α_q b at hbs
        refine ⟨b, s.1, s.2, ?_⟩
        have h_app := congrArg j_ring hbs
        rw [map_mul, hj_eq b, hj_eq s.1] at h_app
        have hw_eq : j_ring (e_j.symm w) = (w : K_q) :=
          congrArg Subtype.val (e_j.apply_symm_apply w)
        rwa [hw_eq] at h_app
      have hResBij_O : Function.Bijective (algebraMap k₀ (↥O_j ⧸ Ideal.span {t_j})) := by
        have hMaxSpan : (Ideal.span {t_j} : Ideal ↥O_j).IsMaximal :=
          hMax_O ▸ IsLocalRing.maximalIdeal.isMaximal ↥O_j
        let _instFieldQuot : Field (↥O_j ⧸ Ideal.span {t_j}) :=
          Ideal.Quotient.field (Ideal.span {t_j})
        refine ⟨(algebraMap k₀ (↥O_j ⧸ Ideal.span {t_j})).injective, ?_⟩
        intro x
        obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective x
        obtain ⟨b, s, hs_not, hw_eq⟩ := hStalk_O w
        have hw_O : w * β_j s = β_j b := Subtype.ext hw_eq
        obtain ⟨c_b, hcb⟩ := hBij_𝔪.2 (Ideal.Quotient.mk 𝔪 b)
        obtain ⟨c_s, hcs⟩ := hBij_𝔪.2 (Ideal.Quotient.mk 𝔪 s)
        have hDiff_m : ∀ (a : B_q) (c : k₀),
            algebraMap k₀ (B_q ⧸ 𝔪) c = Ideal.Quotient.mk 𝔪 a →
            Ideal.Quotient.mk (Ideal.span {t_j}) (β_j a) =
              algebraMap k₀ (↥O_j ⧸ Ideal.span {t_j}) c := by
          intro a c hac
          have h_sub_m : a - algebraMap k₀ B_q c ∈ 𝔪 :=
            Ideal.Quotient.eq.mp hac.symm
          have h_sub_t : β_j a - algebraMap k₀ ↥O_j c ∈ Ideal.span {t_j} := by
            have h_eq : β_j (a - algebraMap k₀ B_q c) = β_j a - algebraMap k₀ ↥O_j c := by
              rw [map_sub, β_j.commutes]
            rw [← h_eq]
            exact (hβ_mem_iff _).mpr h_sub_m
          exact Ideal.Quotient.eq.mpr h_sub_t
        have hcs_ne : c_s ≠ 0 := by
          intro hc0
          rw [hc0, map_zero] at hcs
          exact hs_not (Ideal.Quotient.eq_zero_iff_mem.mp hcs.symm)
        have h_mod_eq : Ideal.Quotient.mk (Ideal.span {t_j}) w *
            algebraMap k₀ (↥O_j ⧸ Ideal.span {t_j}) c_s =
            algebraMap k₀ (↥O_j ⧸ Ideal.span {t_j}) c_b := by
          rw [← hDiff_m s c_s hcs, ← hDiff_m b c_b hcb, ← map_mul, hw_O]
        refine ⟨c_b * c_s⁻¹, ?_⟩
        have hcs_unit : algebraMap k₀ (↥O_j ⧸ Ideal.span {t_j}) c_s *
            algebraMap k₀ (↥O_j ⧸ Ideal.span {t_j}) c_s⁻¹ = 1 := by
          rw [← map_mul, mul_inv_cancel₀ hcs_ne, map_one]
        calc
          algebraMap k₀ (↥O_j ⧸ Ideal.span {t_j}) (c_b * c_s⁻¹) =
              algebraMap k₀ (↥O_j ⧸ Ideal.span {t_j}) c_b *
                algebraMap k₀ (↥O_j ⧸ Ideal.span {t_j}) c_s⁻¹ := map_mul _ _ _
          _ = (Ideal.Quotient.mk (Ideal.span {t_j}) w *
                algebraMap k₀ (↥O_j ⧸ Ideal.span {t_j}) c_s) *
                algebraMap k₀ (↥O_j ⧸ Ideal.span {t_j}) c_s⁻¹ := by rw [h_mod_eq]
          _ = Ideal.Quotient.mk (Ideal.span {t_j}) w := by rw [mul_assoc, hcs_unit, mul_one]
      have hβy_ne : β_j y_q ≠ 0 :=
        fun h0 => hy_ne (hInj_ι ((congrArg Subtype.val h0).trans (map_zero ι_q).symm))
      obtain ⟨m_j, v_y, hvy⟩ :=
        IsDiscreteValuationRing.associated_pow_irreducible hβy_ne ht_irr
      let u_j : ↥O_j := ↑(v_y⁻¹)
      have hu_unit : IsUnit u_j := Units.isUnit v_y⁻¹
      have hy_pow_O : β_j y_q = u_j * t_j ^ m_j := by
        calc
          β_j y_q = β_j y_q * (↑v_y * ↑(v_y⁻¹)) := by rw [Units.mul_inv, mul_one]
          _ = ↑(v_y⁻¹) * (β_j y_q * ↑v_y) := by ring
          _ = u_j * t_j ^ m_j := by rw [hvy]
      have hy_pow_K : ι_q y_q = (u_j : K_q) * (t_j : K_q) ^ m_j := by
        have hval := congrArg (O_j.val : ↥O_j →+* K_q) hy_pow_O
        rw [map_mul, map_pow] at hval
        exact hval
      have hm_pos : 1 ≤ m_j := by
        by_contra h0
        have hm0 : m_j = 0 := by omega
        rw [hm0, pow_zero, mul_one] at hy_pow_O
        have hUnit_y : IsUnit (β_j y_q) := hy_pow_O ▸ hu_unit
        have hNotMax : β_j y_q ∉ IsLocalRing.maximalIdeal ↥O_j :=
          IsLocalRing.notMem_maximalIdeal.mpr hUnit_y
        rw [hMax_O] at hNotMax
        exact hNotMax ((hβ_mem_iff y_q).mpr hy_𝔪)
      have hPole_O : ∀ z : K_q, ∃ k : ℕ, (ι_q y_q) ^ k * z ∈ O_j := by
        intro z
        obtain ⟨⟨a, b⟩, hab⟩ :=
          @IsLocalization.surj B_q _ (nonZeroDivisors B_q) K_q _ ι_q.toRingHom.toAlgebra hFrac z
        have hb_ne : b.1 ≠ 0 := nonZeroDivisors.ne_zero b.2
        have hib_ne : ι_q b.1 ≠ 0 :=
          fun h0 => hb_ne (hInj_ι (h0.trans (map_zero ι_q).symm))
        have hβb_ne : β_j b.1 ≠ 0 := fun h0 => hib_ne (congrArg Subtype.val h0)
        obtain ⟨k, v_b, hvb⟩ :=
          IsDiscreteValuationRing.associated_pow_irreducible hβb_ne ht_irr
        have hvb_K : ι_q b.1 * ((v_b : ↥O_j) : K_q) = (t_j : K_q) ^ k := by
          have hval := congrArg (O_j.val : ↥O_j →+* K_q) hvb
          rw [map_mul, map_pow] at hval
          exact hval
        have hk_le : k ≤ k * m_j := by
          simpa using Nat.mul_le_mul_left k hm_pos
        let d := k * m_j - k
        have hkd : m_j * k = k + d := by
          rw [Nat.mul_comm m_j k]
          exact (Nat.add_sub_of_le hk_le).symm
        let w_z : ↥O_j := u_j ^ k * t_j ^ d * (v_b : ↥O_j) * β_j a
        refine ⟨k, ?_⟩
        have hEq_K : ((ι_q y_q) ^ k * z) * ι_q b.1 = (w_z : K_q) * ι_q b.1 := by
          have hw_val : (w_z : K_q) =
              (u_j : K_q) ^ k * (t_j : K_q) ^ d * ((v_b : ↥O_j) : K_q) * ι_q a := by
            change (O_j.val : ↥O_j →+* K_q) w_z = _
            simp only [w_z, map_mul, map_pow]
            rfl
          have hab' : z * ι_q b.1 = ι_q a := hab
          calc
            ((ι_q y_q) ^ k * z) * ι_q b.1 = (ι_q y_q) ^ k * (z * ι_q b.1) := mul_assoc _ _ _
            _ = ((u_j : K_q) * (t_j : K_q) ^ m_j) ^ k * ι_q a := by rw [hab', hy_pow_K]
            _ = (u_j : K_q) ^ k * (t_j : K_q) ^ (m_j * k) * ι_q a := by rw [mul_pow, ← pow_mul]
            _ = (u_j : K_q) ^ k * ((t_j : K_q) ^ k * (t_j : K_q) ^ d) * ι_q a := by
              rw [hkd, pow_add]
            _ = (u_j : K_q) ^ k * ((ι_q b.1 * ((v_b : ↥O_j) : K_q)) * (t_j : K_q) ^ d) *
                ι_q a := by rw [hvb_K]
            _ = ((u_j : K_q) ^ k * (t_j : K_q) ^ d * ((v_b : ↥O_j) : K_q) * ι_q a) *
                ι_q b.1 := by ring
            _ = (w_z : K_q) * ι_q b.1 := by rw [hw_val]
        have h_eq_wz : (ι_q y_q) ^ k * z = (w_z : K_q) := mul_right_cancel₀ hib_ne hEq_K
        rw [h_eq_wz]
        exact w_z.2
      exact ⟨O_j, t_j, m_j, hm_pos, ⟨hMemB, hβ_mem_iff⟩, hStalk_O, ht_ne,
        ⟨hLoc_O, hMax_O⟩, hResBij_O, ⟨u_j, hu_unit, hy_pow_K⟩, hPole_O⟩
    choose O_m t_m m_mult hm_pos hMem_pair hStalk ht_ne hLocMax hResBij hUnitPow hPoleAbs
      using hPerJ_exists
    
    let β_m : ∀ j : Fin (r + 1), B_q →ₐ[k₀] ↥(O_m j) := fun j =>
      { toFun := fun b => ⟨ι_q b, (hMem_pair j).choose b⟩
        map_one' := Subtype.ext (map_one ι_q)
        map_mul' := fun x y => Subtype.ext (map_mul ι_q x y)
        map_zero' := Subtype.ext (map_zero ι_q)
        map_add' := fun x y => Subtype.ext (map_add ι_q x y)
        commutes' := fun c => Subtype.ext (ι_q.commutes c) }
    have hβ_mem : ∀ (j : Fin (r + 1)) (b : B_q),
        β_m j b ∈ Ideal.span {t_m j} ↔ b ∈ 𝔪_inf j :=
      fun j b => (hMem_pair j).choose_spec b
    let Q_pow : Fin (r + 1) → Type u :=
      fun j => ↥(O_m j) ⧸ Ideal.span {(t_m j) ^ (m_mult j)}
    let ψ_j : ∀ j : Fin (r + 1), B_q →ₐ[k₀] Q_pow j :=
      fun j => (Ideal.Quotient.mkₐ k₀ (Ideal.span {(t_m j) ^ (m_mult j)})).comp (β_m j)
    let I_pow : Fin (r + 1) → Ideal B_q :=
      fun j => Ideal.comap (β_m j).toRingHom (Ideal.span {(t_m j) ^ (m_mult j)})
    have hPowMemI : ∀ (j : Fin (r + 1)) {a : B_q}, a ∈ 𝔪_inf j → a ^ (m_mult j) ∈ I_pow j := by
      intro j a ha
      obtain ⟨v, hv⟩ := Ideal.mem_span_singleton.mp ((hβ_mem j a).mpr ha)
      change β_m j (a ^ (m_mult j)) ∈ Ideal.span {(t_m j) ^ (m_mult j)}
      rw [map_pow, hv, mul_pow]
      exact Ideal.mem_span_singleton.mpr ⟨v ^ (m_mult j), rfl⟩
    have hMaxOverI : ∀ (j : Fin (r + 1)) (𝔫 : Ideal B_q),
        𝔫.IsMaximal → I_pow j ≤ 𝔫 → 𝔫 = 𝔪_inf j := by
      intro j 𝔫 h𝔫_max hI_le
      have h_le : 𝔪_inf j ≤ 𝔫 := by
        intro a ha
        exact h𝔫_max.isPrime.mem_of_pow_mem (m_mult j) (hI_le (hPowMemI j ha))
      exact ((hm_prop j).1.eq_of_le h𝔫_max.ne_top h_le).symm
    have hψ_surj : ∀ j : Fin (r + 1), Function.Surjective (ψ_j j) := by
      intro j x
      obtain ⟨w, hw_x⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨b, s, hs_not, hw_K⟩ := hStalk j w
      have hw_O : w * β_m j s = β_m j b := Subtype.ext hw_K
      have hSupTop : I_pow j ⊔ Ideal.span {s} = ⊤ := by
        by_contra hNeTop
        obtain ⟨𝔫, h𝔫_max, h_le⟩ := Ideal.exists_le_maximal _ hNeTop
        have hEq := hMaxOverI j 𝔫 h𝔫_max (le_sup_left.trans h_le)
        exact hs_not (hEq ▸ le_sup_right.trans h_le (Ideal.mem_span_singleton_self s))
      have h1 : (1 : B_q) ∈ I_pow j ⊔ Ideal.span {s} := hSupTop ▸ Submodule.mem_top
      rw [Submodule.mem_sup] at h1
      rcases h1 with ⟨a, haI, c, hcS, hac1⟩
      obtain ⟨r_s, rfl⟩ := Ideal.mem_span_singleton.mp hcS
      refine ⟨r_s * b, ?_⟩
      rw [← hw_x]
      apply Ideal.Quotient.eq.mpr
      change β_m j (r_s * b) - w ∈ Ideal.span {(t_m j) ^ (m_mult j)}
      have h_diff : β_m j (r_s * b) - w = -(β_m j a * w) := by
        have h1_O : β_m j a + β_m j s * β_m j r_s = 1 := by
          rw [← map_mul, ← map_add, hac1, map_one]
        calc
          β_m j (r_s * b) - w = β_m j r_s * β_m j b - w := by rw [map_mul]
          _ = β_m j r_s * (w * β_m j s) - w := by rw [hw_O]
          _ = (β_m j s * β_m j r_s - 1) * w := by ring
          _ = -(β_m j a * w) := by
            have hsub : β_m j s * β_m j r_s - 1 = -β_m j a := by
              calc
                β_m j s * β_m j r_s - 1 = β_m j s * β_m j r_s - (β_m j a + β_m j s * β_m j r_s) := by
                  rw [h1_O]
                _ = -β_m j a := by ring
            rw [hsub, neg_mul]
      rw [h_diff]
      have ha_span : β_m j a ∈ Ideal.span {(t_m j) ^ (m_mult j)} := haI
      exact Submodule.neg_mem _ (Ideal.mul_mem_right w _ ha_span)
    have hCoprime_I : Pairwise (Function.onFun IsCoprime I_pow) := by
      intro i j hij
      rw [Function.onFun, Ideal.isCoprime_iff_sup_eq]
      by_contra hNeTop
      obtain ⟨𝔫, h𝔫_max, h_le⟩ := Ideal.exists_le_maximal _ hNeTop
      have hi := hMaxOverI i 𝔫 h𝔫_max (le_sup_left.trans h_le)
      have hj := hMaxOverI j 𝔫 h𝔫_max (le_sup_right.trans h_le)
      exact hij (hInj_m (hi.symm.trans hj))
    let Ψ₀ : B_q →ₐ[k₀] (∀ j : Fin (r + 1), Q_pow j) := AlgHom.pi ψ_j
    have hΨ₀_surj : Function.Surjective Ψ₀ := by
      intro z
      choose b_j hb_j using fun j => hψ_surj j (z j)
      let e_crt := Ideal.quotientInfRingEquivPiQuotient I_pow hCoprime_I
      obtain ⟨x_inf, hx_inf⟩ := e_crt.surjective (fun j => Ideal.Quotient.mk (I_pow j) (b_j j))
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x_inf
      refine ⟨b, ?_⟩
      ext j
      have h_eq_j : Ideal.Quotient.mk (I_pow j) b = Ideal.Quotient.mk (I_pow j) (b_j j) :=
        congrFun hx_inf j
      have h_sub : b - b_j j ∈ I_pow j := Ideal.Quotient.eq.mp h_eq_j
      have h_zero : ψ_j j (b - b_j j) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h_sub
      rw [map_sub, sub_eq_zero] at h_zero
      exact h_zero.trans (hb_j j)
    have hΨ₀_ker_iff : ∀ x : B_q, Ψ₀ x = 0 ↔ x ∈ Ideal.span {y_q} := by
      intro x
      constructor
      · intro hx0
        let J_x : Ideal B_q :=
          { carrier := {s : B_q | s * x ∈ Ideal.span {y_q}}
            zero_mem' := by simp
            add_mem' := fun {s₁ s₂} h₁ h₂ => by
              change (s₁ + s₂) * x ∈ Ideal.span {y_q}
              rw [add_mul]
              exact Ideal.add_mem _ h₁ h₂
            smul_mem' := fun c {s} hs => by
              change (c * s) * x ∈ Ideal.span {y_q}
              rw [mul_assoc]
              exact Ideal.mul_mem_left _ c hs }
        have hy_Jx : y_q ∈ J_x := Ideal.mem_span_singleton.mpr ⟨x, rfl⟩
        have hJx_top : J_x = ⊤ := by
          by_contra hNeTop
          obtain ⟨𝔫, h𝔫_max, h_le⟩ := Ideal.exists_le_maximal J_x hNeTop
          obtain ⟨j, rfl⟩ := hm_exhaust 𝔫 h𝔫_max.isPrime (h_le hy_Jx)
          have hx_Ij : β_m j x ∈ Ideal.span {(t_m j) ^ (m_mult j)} :=
            Ideal.Quotient.eq_zero_iff_mem.mp (congrFun hx0 j)
          obtain ⟨w, hw⟩ := Ideal.mem_span_singleton.mp hx_Ij
          obtain ⟨u_j, hu_unit, hy_uj⟩ := hUnitPow j
          obtain ⟨u_x, hux⟩ := hu_unit
          have hy_O : β_m j y_q = u_j * (t_m j) ^ (m_mult j) := Subtype.ext hy_uj
          let q_w : ↥(O_m j) := w * ↑(u_x⁻¹)
          have hqw_mul : β_m j x = q_w * β_m j y_q := by
            calc
              β_m j x = (t_m j) ^ (m_mult j) * w := hw
              _ = (w * (↑(u_x⁻¹) * ↑u_x)) * (t_m j) ^ (m_mult j) := by
                rw [Units.inv_mul, mul_one, mul_comm]
              _ = (w * ↑(u_x⁻¹)) * (u_j * (t_m j) ^ (m_mult j)) := by rw [hux]; ring
              _ = q_w * β_m j y_q := by rw [hy_O]
          obtain ⟨c, s, hs_not, hcs⟩ := hStalk j q_w
          have hsx_K : ι_q (s * x) = ι_q (y_q * c) := by
            have hqw_K : ι_q x = (q_w : K_q) * ι_q y_q :=
              congrArg Subtype.val hqw_mul
            calc
              ι_q (s * x) = ι_q s * ((q_w : K_q) * ι_q y_q) := by rw [map_mul, hqw_K]
              _ = ((q_w : K_q) * ι_q s) * ι_q y_q := by ring
              _ = ι_q c * ι_q y_q := by rw [hcs]
              _ = ι_q (y_q * c) := by rw [map_mul, mul_comm]
          have hs_Jx : s ∈ J_x :=
            Ideal.mem_span_singleton.mpr ⟨c, hInj_ι hsx_K⟩
          exact hs_not (h_le hs_Jx)
        have h1_Jx : (1 : B_q) ∈ J_x := hJx_top ▸ Submodule.mem_top
        have h1_mul : (1 : B_q) * x ∈ Ideal.span {y_q} := h1_Jx
        rwa [one_mul] at h1_mul
      · intro hx
        obtain ⟨r_y, rfl⟩ := Ideal.mem_span_singleton.mp hx
        ext j
        obtain ⟨u_j, _, hy_uj⟩ := hUnitPow j
        have hy_O : β_m j y_q = u_j * (t_m j) ^ (m_mult j) := Subtype.ext hy_uj
        change Ideal.Quotient.mk (Ideal.span {(t_m j) ^ (m_mult j)}) (β_m j (y_q * r_y)) = 0
        rw [map_mul, hy_O, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_span_singleton.mpr ⟨u_j * β_m j r_y, by ring⟩
    let Ψ : (B_q ⧸ Ideal.span {y_q}) →ₐ[k₀] (∀ j : Fin (r + 1), Q_pow j) :=
      Ideal.Quotient.liftₐ (Ideal.span {y_q}) Ψ₀ (fun a ha => (hΨ₀_ker_iff a).mpr ha)
    have hΨ_bij : Function.Bijective Ψ := by
      refine ⟨?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact Ideal.Quotient.eq_zero_iff_mem.mpr ((hΨ₀_ker_iff a).mp hx)
      · intro z
        obtain ⟨b, rfl⟩ := hΨ₀_surj z
        exact ⟨Ideal.Quotient.mk (Ideal.span {y_q}) b, rfl⟩
    let e_Ψ : (B_q ⧸ Ideal.span {y_q}) ≃ₐ[k₀] (∀ j : Fin (r + 1), Q_pow j) :=
      AlgEquiv.ofBijective Ψ hΨ_bij
    have hQ_fin_rank : ∀ j : Fin (r + 1),
        Module.Finite k₀ (Q_pow j) ∧ Module.finrank k₀ (Q_pow j) = m_mult j := by
      intro j
      have ht_ne_O : t_m j ≠ 0 := fun h0 => ht_ne j (congrArg Subtype.val h0)
      exact hPowFinrank ↥(O_m j) (t_m j) ht_ne_O (hResBij j) (m_mult j)
    have _hFinQpow : ∀ j : Fin (r + 1), Module.Finite k₀ (Q_pow j) := fun j => (hQ_fin_rank j).1
    have _hFreeQpow : ∀ j : Fin (r + 1), Module.Free k₀ (Q_pow j) :=
      fun j => Module.Free.of_divisionRing k₀ (Q_pow j)
    have hSumEq : ∑ j : Fin (r + 1), m_mult j = d_q := by
      calc
        ∑ j : Fin (r + 1), m_mult j =
            ∑ j : Fin (r + 1), Module.finrank k₀ (Q_pow j) :=
          Finset.sum_congr rfl fun j _ => ((hQ_fin_rank j).2).symm
        _ = Module.finrank k₀ (∀ j : Fin (r + 1), Q_pow j) := (Module.finrank_pi_fintype k₀).symm
        _ = d_q := e_Ψ.symm.toLinearEquiv.finrank_eq
    have hd_q_pos : 1 ≤ d_q := by
      have h0_le : m_mult 0 ≤ ∑ j : Fin (r + 1), m_mult j :=
        Finset.single_le_sum (fun j _ => Nat.zero_le (m_mult j)) (Finset.mem_univ 0)
      exact (hm_pos 0).trans (h0_le.trans_eq hSumEq)
    
    let denomIdeal : K_q → Ideal B_q := fun z =>
      { carrier := {s : B_q | ∃ b : B_q, ι_q s * z = ι_q b}
        zero_mem' := ⟨0, by simp⟩
        add_mem' := fun {s₁ s₂} ⟨b₁, h₁⟩ ⟨b₂, h₂⟩ =>
          ⟨b₁ + b₂, by rw [map_add, add_mul, h₁, h₂, ← map_add]⟩
        smul_mem' := fun r {s} ⟨b, h⟩ =>
          ⟨r * b, by simp only [smul_eq_mul, map_mul, mul_assoc, h]⟩ }
    refine ⟨r, O_m, t_m, m_mult, hd_q_pos, hSumEq, hm_pos, ?_, ?_, ?_⟩
    · intro j
      exact ⟨(hMem_pair j).choose, ht_ne j, hLocMax j, hResBij j, hUnitPow j, hPoleAbs j⟩
    · 
      intro z ⟨k, b, hykz⟩ hz_all
      have hyk_mem : y_q ^ k ∈ denomIdeal z :=
        ⟨b, by rw [map_pow, hykz]⟩
      have hTop : denomIdeal z = ⊤ := by
        by_contra hNeTop
        obtain ⟨𝔫, h𝔫_max, h_le⟩ := Ideal.exists_le_maximal (denomIdeal z) hNeTop
        have hy_𝔫 : y_q ∈ 𝔫 := h𝔫_max.isPrime.mem_of_pow_mem k (h_le hyk_mem)
        obtain ⟨j, rfl⟩ := hm_exhaust 𝔫 h𝔫_max.isPrime hy_𝔫
        obtain ⟨b', s, hs_not, hzs⟩ := hStalk j ⟨z, hz_all j⟩
        have hs_mem : s ∈ denomIdeal z := ⟨b', by rw [mul_comm]; exact hzs⟩
        exact hs_not (h_le hs_mem)
      have h1_mem : (1 : B_q) ∈ denomIdeal z := hTop ▸ Submodule.mem_top
      obtain ⟨b₀, hb₀⟩ := h1_mem
      rw [map_one, one_mul] at hb₀
      exact ⟨b₀, hb₀⟩
    · 
      intro u ⟨k, b, hyku⟩ hu_not0 htu_0 hu_ne0
      classical
      obtain ⟨instLoc0, hMax0⟩ := hLocMax 0
      let w₀ : ↥(O_m 0) := ⟨(t_m 0 : K_q) * u, htu_0⟩
      have hw₀_not_max : w₀ ∉ IsLocalRing.maximalIdeal ↥(O_m 0) := by
        rw [hMax0, Ideal.mem_span_singleton]
        rintro ⟨v, hv⟩
        have hv_K : (t_m 0 : K_q) * u = (t_m 0 : K_q) * (v : K_q) :=
          congrArg Subtype.val hv
        have hu_eq : u = (v : K_q) := mul_left_cancel₀ (ht_ne 0) hv_K
        exact hu_not0 (hu_eq ▸ v.2)
      obtain ⟨u_w, hu_w⟩ := IsLocalRing.notMem_maximalIdeal.mp hw₀_not_max
      let q₀ : ↥(O_m 0) := ↑(u_w⁻¹) * t_m 0
      have hq₀_u : (q₀ : K_q) * u = 1 := by
        have hw_val : ((u_w : ↥(O_m 0)) : K_q) = (t_m 0 : K_q) * u :=
          congrArg Subtype.val hu_w
        have h_inv_mul : ((↑(u_w⁻¹) : ↥(O_m 0)) : K_q) * ((u_w : ↥(O_m 0)) : K_q) = 1 := by
          have h1 := congrArg ((O_m 0).val : ↥(O_m 0) →+* K_q) (Units.inv_mul u_w)
          rw [map_mul, map_one] at h1
          exact h1
        calc
          (q₀ : K_q) * u = (((↑(u_w⁻¹) : ↥(O_m 0)) : K_q) * (t_m 0 : K_q)) * u := rfl
          _ = ((↑(u_w⁻¹) : ↥(O_m 0)) : K_q) * ((t_m 0 : K_q) * u) := mul_assoc _ _ _
          _ = ((↑(u_w⁻¹) : ↥(O_m 0)) : K_q) * ((u_w : ↥(O_m 0)) : K_q) := by rw [← hw_val]
          _ = 1 := h_inv_mul
      obtain ⟨a₁, s₁, hs₁_not, hqs₁⟩ := hStalk 0 q₀
      have hs₁_ne : s₁ ≠ 0 := fun h0 => hs₁_not (h0 ▸ (𝔪_inf 0).zero_mem)
      have ha₁_u : ι_q a₁ * u = ι_q s₁ := by
        calc
          ι_q a₁ * u = ((q₀ : K_q) * ι_q s₁) * u := by rw [← hqs₁]
          _ = ι_q s₁ * ((q₀ : K_q) * u) := by ring
          _ = ι_q s₁ := by rw [hq₀_u, mul_one]
      let S_bad : Finset (Ideal B_q) :=
        insert ⊥ ((Finset.univ.erase (0 : Fin (r + 1))).image 𝔪_inf)
      have hBotPrime : (⊥ : Ideal B_q).IsPrime := by
        rw [Ideal.isPrime_iff]
        refine ⟨bot_ne_top, fun {x y} hxy => ?_⟩
        rw [Ideal.mem_bot] at hxy
        simpa only [Ideal.mem_bot] using mul_eq_zero.mp hxy
      have hS_prime : ∀ P ∈ S_bad, P.IsPrime := by
        intro P hP
        rcases Finset.mem_insert.mp hP with rfl | hImg
        · exact hBotPrime
        · obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hImg
          exact (hm_prop j).1.isPrime
      have hNotSub : ¬ ((denomIdeal u : Set B_q) ⊆ ⋃ P ∈ (↑S_bad : Set (Ideal B_q)), (P : Set B_q)) := by
        intro hSub
        obtain ⟨P, hP_mem, h_le_P⟩ :=
          (Ideal.subset_union_prime (s := S_bad) (f := id) (⊥ : Ideal B_q) (⊥ : Ideal B_q)
            (fun P hP _ _ => hS_prime P hP)).mp hSub
        rcases Finset.mem_insert.mp hP_mem with rfl | hImg
        · have hyk_mem : y_q ^ k ∈ denomIdeal u := ⟨b, by rw [map_pow, hyku]⟩
          have hyk_bot : y_q ^ k = 0 := Ideal.mem_bot.mp (h_le_P hyk_mem)
          exact pow_ne_zero k hy_ne hyk_bot
        · obtain ⟨j, hj_er, rfl⟩ := Finset.mem_image.mp hImg
          have hj_ne0 : j ≠ 0 := (Finset.mem_erase.mp hj_er).1
          obtain ⟨b', s', hs'_not, hus'⟩ := hStalk j ⟨u, hu_ne0 j hj_ne0⟩
          have hs'_mem : s' ∈ denomIdeal u := ⟨b', by rw [mul_comm]; exact hus'⟩
          exact hs'_not (h_le_P hs'_mem)
      obtain ⟨s_reg, hs_reg_mem, hs_reg_out⟩ := Set.not_subset.mp hNotSub
      obtain ⟨b_reg, hs_reg_u⟩ := hs_reg_mem
      have hs_reg_ne : s_reg ≠ 0 := by
        intro h0
        apply hs_reg_out
        refine Set.mem_iUnion₂.mpr ⟨⊥, Finset.mem_insert_self ⊥ _, ?_⟩
        rw [h0]
        exact Submodule.zero_mem ⊥
      refine ⟨s₁, a₁, s_reg, b_reg, hs₁_ne, hs_reg_ne, ha₁_u, hs_reg_u, ?_⟩
      intro 𝔭 h𝔭 hy_p
      obtain ⟨j, rfl⟩ := hm_exhaust 𝔭 h𝔭 hy_p
      by_cases hj0 : j = 0
      · subst hj0
        exact Or.inl hs₁_not
      · right
        intro hs_in
        apply hs_reg_out
        have hj_in : 𝔪_inf j ∈ S_bad :=
          Finset.mem_insert_of_mem
            (Finset.mem_image_of_mem 𝔪_inf (Finset.mem_erase.mpr ⟨hj0, Finset.mem_univ j⟩))
        exact Set.mem_iUnion₂.mpr ⟨𝔪_inf j, hj_in, hs_in⟩

theorem weil_dvr_pole_filtration_squeeze_and_rational_generator (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (C_aff : Type u) [CommRing C_aff] [_root_.IsReduced C_aff] [Algebra k₀ C_aff] [Algebra.FiniteType k₀ C_aff]
    (c_num s_sing : ℕ)
    (hMinFin : (minimalPrimes C_aff).Finite)
    (hMinCard : (minimalPrimes C_aff).ncard = c_num)
    (hCondFin :
      let Q := Localization (nonZeroDivisors C_aff)
      let C_tilde := integralClosure C_aff Q
      let W_C : Submodule k₀ Q := LinearMap.range (IsScalarTower.toAlgHom k₀ C_aff Q).toLinearMap
      let W_tilde : Submodule k₀ Q := C_tilde.toSubmodule.restrictScalars k₀
      Module.Finite k₀ (↥W_tilde ⧸ W_C.comap W_tilde.subtype) ∧
      Module.finrank k₀ (↥W_tilde ⧸ W_C.comap W_tilde.subtype) = s_sing)
    (Q_k0 : ℕ → Submodule k₀ C_aff)
    (d_E D₁ : ℕ) (hd_E : 1 ≤ d_E) (hD₁ : 1 ≤ D₁)
    (hHilb0 : ∀ D : ℕ, D₁ ≤ D →
      Module.Finite k₀ (Q_k0 D) ∧ Module.finrank k₀ (Q_k0 D) = D * d_E + 1)
    (d_p : ↥(minimalPrimes C_aff) → ℕ)
    (r_p : ↥(minimalPrimes C_aff) → ℕ)
    (O_m : ∀ 𝔭 : ↥(minimalPrimes C_aff),
      Fin (r_p 𝔭 + 1) → Subalgebra k₀ (FractionRing (C_aff ⧸ 𝔭.1)))
    (t_m : ∀ (𝔭 : ↥(minimalPrimes C_aff)) (j : Fin (r_p 𝔭 + 1)), ↥(O_m 𝔭 j))
    (m_mult : ∀ 𝔭 : ↥(minimalPrimes C_aff), Fin (r_p 𝔭 + 1) → ℕ)
    (y_p : ∀ 𝔭 : ↥(minimalPrimes C_aff), FractionRing (C_aff ⧸ 𝔭.1))
    (hDegSum :
      letI : Fintype ↥(minimalPrimes C_aff) := hMinFin.fintype
      ∑ 𝔭 : ↥(minimalPrimes C_aff), d_p 𝔭 ≤ d_E)
    (hMult : ∀ 𝔭 : ↥(minimalPrimes C_aff),
      (∑ j : Fin (r_p 𝔭 + 1), m_mult 𝔭 j = d_p 𝔭) ∧
      (∀ j : Fin (r_p 𝔭 + 1), 1 ≤ m_mult 𝔭 j))
    (hDVR : ∀ (𝔭 : ↥(minimalPrimes C_aff)) (j : Fin (r_p 𝔭 + 1)),
      (t_m 𝔭 j : FractionRing (C_aff ⧸ 𝔭.1)) ≠ 0 ∧
      (∃ _ : IsLocalRing ↥(O_m 𝔭 j),
        IsLocalRing.maximalIdeal ↥(O_m 𝔭 j) = Ideal.span {t_m 𝔭 j}) ∧
      Function.Bijective (algebraMap k₀ (↥(O_m 𝔭 j) ⧸ Ideal.span {t_m 𝔭 j})) ∧
      (∃ u_j : ↥(O_m 𝔭 j), IsUnit u_j ∧
        y_p 𝔭 = (u_j : FractionRing (C_aff ⧸ 𝔭.1)) *
          (t_m 𝔭 j : FractionRing (C_aff ⧸ 𝔭.1)) ^ (m_mult 𝔭 j)) ∧
      (∀ z : FractionRing (C_aff ⧸ 𝔭.1), ∃ k : ℕ, (y_p 𝔭) ^ k * z ∈ O_m 𝔭 j))
    (hConst : ∀ (𝔭 : ↥(minimalPrimes C_aff)) (c : C_aff ⧸ 𝔭.1),
      (∀ j : Fin (r_p 𝔭 + 1),
        algebraMap (C_aff ⧸ 𝔭.1) (FractionRing (C_aff ⧸ 𝔭.1)) c ∈ O_m 𝔭 j) →
      ∃ a : k₀, c = algebraMap k₀ (C_aff ⧸ 𝔭.1) a)
