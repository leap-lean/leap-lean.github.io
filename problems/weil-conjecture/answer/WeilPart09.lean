          (s''_j.1 * s'_j.1) * y j - (s''_j.1 * a'_j) * d₀
            = s''_j.1 * (s'_j.1 * y j) - s''_j.1 * (a'_j * d₀) := by ring
          _ = 0 := sub_eq_zero.mpr hs''_eq
      choose t a hta using h_rel_each
      exact ⟨d₀, r, y, t, a, hd₀_mem, hy_adjoin, fun j => ⟨hy_mem j, (hta j).1, (hta j).2⟩⟩
    · rintro ⟨u, v, huv_span, huv_mem3⟩
      change Ideal.span {u, v} = 𝔪 at huv_span
      change u * v ∈ 𝔪 ^ 3 at huv_mem3
      obtain ⟨⟨d_u, s_u⟩, hdu_eq⟩ := IsLocalization.surj q.asIdeal.primeCompl u
      obtain ⟨⟨d_v, s_v⟩, hdv_eq⟩ := IsLocalization.surj q.asIdeal.primeCompl v
      dsimp only at hdu_eq hdv_eq
      let u_bar : L := algebraMap D L d_u
      let v_bar : L := algebraMap D L d_v
      obtain ⟨u_su, hu_su⟩ := IsLocalization.map_units L s_u
      obtain ⟨u_sv, hu_sv⟩ := IsLocalization.map_units L s_v
      have hu_bar_eq : u_bar = u * ↑u_su := by
        dsimp [u_bar]
        rw [← hdu_eq, hu_su]
      have hv_bar_eq : v_bar = v * ↑u_sv := by
        dsimp [v_bar]
        rw [← hdv_eq, hu_sv]
      have hu_eq_inv : u = u_bar * ↑u_su⁻¹ := by rw [hu_bar_eq]; simp
      have hv_eq_inv : v = v_bar * ↑u_sv⁻¹ := by rw [hv_bar_eq]; simp
      have hu_mem : u ∈ 𝔪 := by
        rw [← huv_span]
        exact Ideal.subset_span (by simp)
      have hv_mem : v ∈ 𝔪 := by
        rw [← huv_span]
        exact Ideal.subset_span (by simp)
      have hdu_mem : d_u ∈ q.asIdeal := by
        rw [← hres_ker]
        have h1 : res_L u_bar = 0 := by
          rw [hu_bar_eq, map_mul, hres_L_zero_of_mem u hu_mem, zero_mul]
        exact (RingHom.congr_fun hres_L_comp d_u).symm.trans h1
      have hdv_mem : d_v ∈ q.asIdeal := by
        rw [← hres_ker]
        have h1 : res_L v_bar = 0 := by
          rw [hv_bar_eq, map_mul, hres_L_zero_of_mem v hv_mem, zero_mul]
        exact (RingHom.congr_fun hres_L_comp d_v).symm.trans h1
