    hAff0.isLocalization_of_eq_basicOpen y₁
      (CategoryTheory.homOfLE (inf_le_left : Z_00 ⊓ Z_01 ≤ Z_00)) hy₁_open.symm
  have hLoc1 : @IsLocalization.Away C_aff _ x₀ B_01 _ res₁.toRingHom.toAlgebra :=
    hAff1.isLocalization_of_eq_basicOpen x₀
      (CategoryTheory.homOfLE (inf_le_right : Z_00 ⊓ Z_01 ≤ Z_01)) hx₀_open.symm
  have hMeet1 : ∀ Z_comp ∈ irreducibleComponents ↥Z₀,
      (Z_comp ∩ Set.range hAff1.fromSpec.base).Nonempty := by
    intro Z_comp hZ
    rcases hMeetSm Z_comp hZ with ⟨z, hzZ, ⟨_, hz1⟩, _⟩
    rw [hAff1.range_fromSpec]
    exact ⟨z, hzZ, hz1⟩
  have hMeet0 : ∀ Z_comp ∈ irreducibleComponents ↥Z₀,
      (Z_comp ∩ Set.range hAff0.fromSpec.base).Nonempty := by
    intro Z_comp hZ
    rcases hMeetSm Z_comp hZ with ⟨z, hzZ, ⟨hz0, _⟩, _⟩
    rw [hAff0.range_fromSpec]
    exact ⟨z, hzZ, hz0⟩
  have hMeet01 : ∀ Z_comp ∈ irreducibleComponents ↥Z₀,
      (Z_comp ∩ Set.range hAff01.fromSpec.base).Nonempty := by
    intro Z_comp hZ
    rcases hMeetSm Z_comp hZ with ⟨z, hzZ, hz01, _⟩
    rw [hAff01.range_fromSpec]
    exact ⟨z, hzZ, hz01⟩
  obtain ⟨e_comp, hMinCard, hComp1⟩ :=
    h_s2 ↥Z₀ C_aff hAff1.fromSpec.base hAff1.fromSpec.isOpenEmbedding hMeet1
  obtain ⟨e_0, _, hComp0⟩ :=
    h_s2 ↥Z₀ B₀ hAff0.fromSpec.base hAff0.fromSpec.isOpenEmbedding hMeet0
  obtain ⟨e_01, _, hComp01⟩ :=
    h_s2 ↥Z₀ B_01 hAff01.fromSpec.base hAff01.fromSpec.isOpenEmbedding hMeet01
  let e_B0 : ↥(minimalPrimes C_aff) ≃ ↥(minimalPrimes B₀) := e_comp.symm.trans e_0
  have hFromSpec : ∀ (U V : Z₀.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (hV : AlgebraicGeometry.IsAffineOpen V) (hle : V ≤ U)
      (q : PrimeSpectrum ↑(Z₀.presheaf.obj (Opposite.op V))),
      hU.fromSpec.base (PrimeSpectrum.comap (Z₀.presheaf.map (CategoryTheory.homOfLE hle).op).hom q) =
        hV.fromSpec.base q := by
    intro U V hU hV hle q
    let idZ : Z₀ ⟶ Z₀ := 𝟙 Z₀
    have hle' : V ≤ (TopologicalSpace.Opens.map idZ.base).obj U := hle
    have h1 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec idZ hU hV hle'
    have hid_comp : hV.fromSpec ≫ idZ = hV.fromSpec := CategoryTheory.Category.comp_id _
    have hid_app : idZ.appLE U V hle' = Z₀.presheaf.map (CategoryTheory.homOfLE hle).op :=
      (AlgebraicGeometry.Scheme.Hom.appLE_map idZ
        (le_rfl : U ≤ (TopologicalSpace.Opens.map idZ.base).obj U)
        (CategoryTheory.homOfLE hle).op).symm.trans
        ((congrArg (· ≫ Z₀.presheaf.map (CategoryTheory.homOfLE hle).op)
          (AlgebraicGeometry.Scheme.Hom.appLE_eq_app idZ)).trans
          (CategoryTheory.Category.id_comp _))
    rw [hid_comp, hid_app] at h1
    have h2 := congrArg (fun f => f.base q) h1
    change ((AlgebraicGeometry.Spec.map (Z₀.presheaf.map (CategoryTheory.homOfLE hle).op)).base ≫
        hU.fromSpec.base) q = hV.fromSpec.base q at h2
    rw [AlgebraicGeometry.Spec.map_base] at h2
    exact h2
  refine ⟨⟨hFT_B₀, hFT_C, hRed_B₀, hRed_C, hMinFin, hMinCard, hMaxNotSing⟩, e_comp, e_B0, ?_⟩
  intro Z_comp hZ
  let 𝔭 : ↥(minimalPrimes C_aff) := e_comp ⟨Z_comp, hZ⟩
  let 𝔮 : ↥(minimalPrimes B₀) := e_B0 𝔭
  let _ : 𝔭.1.IsPrime := 𝔭.2.1.1
  let _ : 𝔮.1.IsPrime := 𝔮.2.1.1
  let 𝔯 : ↥(minimalPrimes B_01) := e_01 ⟨Z_comp, hZ⟩
  let _ : 𝔯.1.IsPrime := 𝔯.2.1.1
  have h𝔮_eq : 𝔮 = e_0 ⟨Z_comp, hZ⟩ := by
    dsimp [𝔮, e_B0, 𝔭]
    exact congrArg e_0 (e_comp.symm_apply_apply ⟨Z_comp, hZ⟩)
  have hZero_p : PrimeSpectrum.zeroLocus (𝔭.1 : Set C_aff) = hAff1.fromSpec.base ⁻¹' Z_comp :=
    (hComp1 Z_comp hZ).1
  have hZero_q : PrimeSpectrum.zeroLocus (𝔮.1 : Set B₀) = hAff0.fromSpec.base ⁻¹' Z_comp := by
    rw [h𝔮_eq]
    exact (hComp0 Z_comp hZ).1
  have hZero_r : PrimeSpectrum.zeroLocus (𝔯.1 : Set B_01) = hAff01.fromSpec.base ⁻¹' Z_comp :=
    (hComp01 Z_comp hZ).1
  have hZero0 : PrimeSpectrum.comap res₀.toRingHom ⁻¹' PrimeSpectrum.zeroLocus (𝔮.1 : Set B₀) =
      PrimeSpectrum.zeroLocus (𝔯.1 : Set B_01) := by
    ext q
    have hq1 : PrimeSpectrum.comap res₀.toRingHom q ∈ PrimeSpectrum.zeroLocus (𝔮.1 : Set B₀) ↔
        hAff0.fromSpec.base (PrimeSpectrum.comap res₀.toRingHom q) ∈ Z_comp :=
      Iff.of_eq (congrArg (PrimeSpectrum.comap res₀.toRingHom q ∈ ·) hZero_q)
    have hq2 : q ∈ PrimeSpectrum.zeroLocus (𝔯.1 : Set B_01) ↔ hAff01.fromSpec.base q ∈ Z_comp :=
      Iff.of_eq (congrArg (q ∈ ·) hZero_r)
    exact hq1.trans
      ((Iff.of_eq (congrArg (· ∈ Z_comp)
        (hFromSpec Z_00 (Z_00 ⊓ Z_01) hAff0 hAff01 inf_le_left q))).trans hq2.symm)
  have hZero1 : PrimeSpectrum.comap res₁.toRingHom ⁻¹' PrimeSpectrum.zeroLocus (𝔭.1 : Set C_aff) =
      PrimeSpectrum.zeroLocus (𝔯.1 : Set B_01) := by
    ext q
    have hq1 : PrimeSpectrum.comap res₁.toRingHom q ∈ PrimeSpectrum.zeroLocus (𝔭.1 : Set C_aff) ↔
        hAff1.fromSpec.base (PrimeSpectrum.comap res₁.toRingHom q) ∈ Z_comp :=
      Iff.of_eq (congrArg (PrimeSpectrum.comap res₁.toRingHom q ∈ ·) hZero_p)
    have hq2 : q ∈ PrimeSpectrum.zeroLocus (𝔯.1 : Set B_01) ↔ hAff01.fromSpec.base q ∈ Z_comp :=
      Iff.of_eq (congrArg (q ∈ ·) hZero_r)
    exact hq1.trans
      ((Iff.of_eq (congrArg (· ∈ Z_comp)
        (hFromSpec Z_01 (Z_00 ⊓ Z_01) hAff1 hAff01 inf_le_right q))).trans hq2.symm)
  obtain ⟨ι_B, ι_01, hy₁_not_q, hInj_IB, hInj_I01, hFrac_IB,
      hI01_res0, hI01_res1, hCocycle_IB, hDenom_IB, hNonUnit_crit⟩ :=
    h_s3 B₀ C_aff B_01 res₀ res₁ y₁ x₀ hyx_one hLoc0 hLoc1 𝔮.1 𝔮.2 𝔭.1 𝔯.1 hZero0 hZero1
  have hZ_meet01 : (Z_comp ∩ (Z_00 ⊓ Z_01 : Set ↥Z₀)).Nonempty :=
    (hMeetSm Z_comp hZ).mono (Set.inter_subset_inter_right _ Set.sdiff_subset)
  obtain ⟨Z_sch, ι_Z, hCl_Z, hInt_Z, hRange_Z, hCov_Z, hNe0_Z, hNe1_Z,
      hBasic_Z, hAff_UZ0, hAff_UZ1, isoB, isoC, heB_mk, _heC_mk, hOverlap_mk, hConst_Z⟩ :=
    h_s4 hAff01 Z_comp (isClosed_of_mem_irreducibleComponents Z_comp hZ) hZ.1 hZ_meet01
      𝔮.1 𝔭.1 𝔯.1 hZero_q hZero_p hZero_r
  let U_Z0 : Z_sch.Opens := (TopologicalSpace.Opens.map ι_Z.base).obj Z_00
  let U_Z1 : Z_sch.Opens := (TopologicalSpace.Opens.map ι_Z.base).obj Z_01
  have hOverlap : ∀ (b₁ b₂ : B₀ ⧸ 𝔮.1) (c₁ : C_aff ⧸ 𝔭.1),
      ι_B b₁ * algebraMap (C_aff ⧸ 𝔭.1) (FractionRing (C_aff ⧸ 𝔭.1)) c₁ = ι_B b₂ →
      (Z_sch.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_Z0 ⊓ U_Z1 ≤ U_Z0)).op).hom
          (isoB b₁) *
        (Z_sch.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_Z0 ⊓ U_Z1 ≤ U_Z1)).op).hom
          (isoC c₁) =
      (Z_sch.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_Z0 ⊓ U_Z1 ≤ U_Z0)).op).hom
        (isoB b₂) := by
    intro b₁ b₂ c₁ hEq
    obtain ⟨x₁, rfl⟩ := Ideal.Quotient.mk_surjective b₁
    obtain ⟨x₂, rfl⟩ := Ideal.Quotient.mk_surjective b₂
    obtain ⟨y_c, rfl⟩ := Ideal.Quotient.mk_surjective c₁
    rw [← hI01_res0 x₁, ← hI01_res1 y_c, ← hI01_res0 x₂, ← map_mul, ← map_mul] at hEq
    exact hOverlap_mk x₁ x₂ y_c (hInj_I01 hEq)
  have hConst : ∀ (c : C_aff ⧸ 𝔭.1) (b₀ : B₀ ⧸ 𝔮.1),
      algebraMap (C_aff ⧸ 𝔭.1) (FractionRing (C_aff ⧸ 𝔭.1)) c = ι_B b₀ →
      ∃ a : k₀, c = algebraMap k₀ (C_aff ⧸ 𝔭.1) a := by
    intro c b₀ hc_eq
    have h1 : ι_B 1 * algebraMap (C_aff ⧸ 𝔭.1) (FractionRing (C_aff ⧸ 𝔭.1)) c = ι_B b₀ := by
      rw [map_one, one_mul]
      exact hc_eq
    have h2 := hOverlap 1 b₀ c h1
    rw [map_one, map_one, one_mul] at h2
    exact hConst_Z c b₀ h2
  have hNonUnit : ¬ IsUnit (Ideal.Quotient.mk 𝔮.1 y₁) := by
    rcases hMeetSm Z_comp hZ with ⟨z₀, hz₀_Z, ⟨hz₀_0, _⟩, hz₀_notSing⟩
    have hz₀_range : z₀ ∈ Set.range hAff0.fromSpec.base := by
      rw [hAff0.range_fromSpec]
      exact hz₀_0
    rcases hz₀_range with ⟨q₀, hq₀_eq⟩
    have h𝔮_le_q₀ : 𝔮.1 ≤ q₀.asIdeal := by
      have hq₀_pre : q₀ ∈ hAff0.fromSpec.base ⁻¹' Z_comp := by
        show hAff0.fromSpec.base q₀ ∈ Z_comp
        rwa [hq₀_eq]
      rw [← hZero_q] at hq₀_pre
      exact hq₀_pre
    have hq₀_notSing : hAff0.fromSpec.base q₀ ∉ Sing_Z₀ := by rwa [hq₀_eq]
    obtain ⟨g, hDom_g, hg_not_q₀, hMaxNeBot⟩ := hSmNeBot q₀ hq₀_notSing
    exact hNonUnit_crit hConst ⟨q₀.asIdeal, q₀.isPrime, g, hDom_g, h𝔮_le_q₀, hg_not_q₀, hMaxNeBot⟩
  exact ⟨Z_sch, ι_Z, hCl_Z, hInt_Z, ι_B, hRange_Z, hy₁_not_q, hNonUnit, hInj_IB, hFrac_IB,
    hCocycle_IB, fun c => ⟨hDenom_IB c, hConst c⟩,
    hCov_Z, hNe0_Z, hNe1_Z, hBasic_Z, hAff_UZ0, hAff_UZ1,
    isoB, isoC, heB_mk y₁, hOverlap⟩

theorem weil_infinity_quotient_crt_and_dvr_multiplicity_sum (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (B₀ : Type u) [CommRing B₀] [_root_.IsReduced B₀] [Algebra k₀ B₀] [Algebra.FiniteType k₀ B₀]
    (y₁ : B₀) (d_E : ℕ)
    (hCoker : Module.Finite k₀ (B₀ ⧸ Ideal.span {y₁}) ∧
      Module.finrank k₀ (B₀ ⧸ Ideal.span {y₁}) ≤ d_E)
    (hSmY₁ : ∀ (𝔪 : Ideal B₀), 𝔪.IsMaximal → y₁ ∈ 𝔪 →
      ∃ (g : B₀) (_ : IsDomain (Localization.Away g)),
        g ∉ 𝔪 ∧
        ∀ (𝔫 : Ideal (Localization.Away g)) [𝔫.IsMaximal],
          𝔫 ≠ ⊥ ∧ IsDiscreteValuationRing (Localization.AtPrime 𝔫))
    (hY₁NotMem : ∀ 𝔮 ∈ minimalPrimes B₀, y₁ ∉ 𝔮 ∧ ¬ IsUnit (Ideal.Quotient.mk 𝔮 y₁)) :
    (∃ hFinQ : (minimalPrimes B₀).Finite,
      letI : Fintype ↥(minimalPrimes B₀) := hFinQ.fintype
      ∑ 𝔮 : ↥(minimalPrimes B₀),
        Module.finrank k₀ ((B₀ ⧸ 𝔮.1) ⧸ Ideal.span {Ideal.Quotient.mk 𝔮.1 y₁}) ≤ d_E) ∧
    ∀ (𝔮 : Ideal B₀) (h𝔮 : 𝔮 ∈ minimalPrimes B₀),
      letI : 𝔮.IsPrime := h𝔮.1.1
      let B_q := B₀ ⧸ 𝔮
      let y_q := Ideal.Quotient.mk 𝔮 y₁
      let d_q := Module.finrank k₀ (B_q ⧸ Ideal.span {y_q})
      ∀ (K_q : Type u) [Field K_q] [Algebra k₀ K_q]
        (ι_q : B_q →ₐ[k₀] K_q),
        @IsFractionRing B_q _ K_q _ ι_q.toRingHom.toAlgebra →
        ∃ (r : ℕ)
          (O_m : Fin (r + 1) → Subalgebra k₀ K_q)
          (t_m : ∀ j : Fin (r + 1), ↥(O_m j))
          (m_mult : Fin (r + 1) → ℕ),
          1 ≤ d_q ∧
          (∑ j : Fin (r + 1), m_mult j = d_q) ∧
          (∀ j : Fin (r + 1), 1 ≤ m_mult j) ∧
          (∀ j : Fin (r + 1),
            (∀ b : B_q, ι_q b ∈ O_m j) ∧
            (t_m j : K_q) ≠ 0 ∧
            (∃ _ : IsLocalRing ↥(O_m j),
              IsLocalRing.maximalIdeal ↥(O_m j) = Ideal.span {t_m j}) ∧
            Function.Bijective (algebraMap k₀ (↥(O_m j) ⧸ Ideal.span {t_m j})) ∧
            (∃ u_j : ↥(O_m j), IsUnit u_j ∧
              ι_q y_q = (u_j : K_q) * (t_m j : K_q) ^ (m_mult j)) ∧
            (∀ z : K_q, ∃ k : ℕ, (ι_q y_q) ^ k * z ∈ O_m j)) ∧
          (∀ z : K_q,
            (∃ (k : ℕ) (b : B_q), (ι_q y_q) ^ k * z = ι_q b) →
            (∀ j : Fin (r + 1), z ∈ O_m j) →
            ∃ b₀ : B_q, z = ι_q b₀) ∧
          (∀ u : K_q,
            (∃ (k : ℕ) (b : B_q), (ι_q y_q) ^ k * u = ι_q b) →
            u ∉ O_m 0 →
            (t_m 0 : K_q) * u ∈ O_m 0 →
            (∀ j : Fin (r + 1), j ≠ 0 → u ∈ O_m j) →
            ∃ (s₁ a₁ s_reg b_reg : B_q),
              s₁ ≠ 0 ∧
              s_reg ≠ 0 ∧
              ι_q a₁ * u = ι_q s₁ ∧
              ι_q s_reg * u = ι_q b_reg ∧
              ∀ (𝔭 : Ideal B_q), 𝔭.IsPrime → y_q ∈ 𝔭 → (s₁ ∉ 𝔭 ∨ s_reg ∉ 𝔭)) :=
by
  have hNoethB₀ : IsNoetherianRing B₀ := Algebra.FiniteType.isNoetherianRing k₀ B₀
  have hFinQ : (minimalPrimes B₀).Finite := minimalPrimes.finite_of_isNoetherianRing B₀
  
  have hPowFinrank : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra k₀ D]
      (t : D), t ≠ 0 → Function.Bijective (algebraMap k₀ (D ⧸ Ideal.span {t})) →
      ∀ k : ℕ, Module.Finite k₀ (D ⧸ Ideal.span {t ^ k}) ∧
        Module.finrank k₀ (D ⧸ Ideal.span {t ^ k}) = k := by
    intro D _ _ _ t ht_ne hBij k
    let e₁ : k₀ ≃ₗ[k₀] (D ⧸ Ideal.span {t}) :=
      LinearEquiv.ofBijective (Algebra.linearMap k₀ (D ⧸ Ideal.span {t})) hBij
    have hFin₁ : Module.Finite k₀ (D ⧸ Ideal.span {t}) := Module.Finite.equiv e₁
    have hRank₁ : Module.finrank k₀ (D ⧸ Ideal.span {t}) = 1 :=
      e₁.symm.finrank_eq.trans (Module.finrank_self k₀)
    induction k with
    | zero =>
      have hSub : Subsingleton (D ⧸ Ideal.span {t ^ 0}) := by
        refine ⟨fun a b => ?_⟩
        induction a using Quotient.inductionOn' with | h d₁ =>
        induction b using Quotient.inductionOn' with | h d₂ =>
        apply Ideal.Quotient.eq.mpr
        rw [pow_zero, Ideal.span_singleton_one]
        exact Submodule.mem_top
      have hFin₀ : Module.Finite k₀ (D ⧸ Ideal.span {t ^ 0}) :=
        ⟨⟨∅, eq_top_iff.mpr fun x _ => Subsingleton.elim x 0 ▸ Submodule.zero_mem _⟩⟩
      exact ⟨hFin₀, Module.finrank_zero_of_subsingleton⟩
    | succ k ih =>
      obtain ⟨hFin_k, hRank_k⟩ := ih
      let I_k : Ideal D := Ideal.span {t ^ k}
      let I_succ : Ideal D := Ideal.span {t ^ (k + 1)}
      have h_le : I_succ ≤ I_k := by
        intro a ha
        obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp ha
        exact Ideal.mem_span_singleton.mpr ⟨t * q, by rw [pow_succ, mul_assoc]⟩
      let p_alg : (D ⧸ I_succ) →ₐ[k₀] (D ⧸ I_k) :=
        Ideal.Quotient.liftₐ I_succ (Ideal.Quotient.mkₐ k₀ I_k)
          (fun a ha => Ideal.Quotient.eq_zero_iff_mem.mpr (h_le ha))
      let p_lin : (D ⧸ I_succ) →ₗ[k₀] (D ⧸ I_k) := p_alg.toLinearMap
      have hp_surj : Function.Surjective p_lin := by
        intro y
        obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective y
        exact ⟨Ideal.Quotient.mk I_succ d, rfl⟩
      let μ_D : D →ₗ[D] (D ⧸ I_succ) :=
        { toFun := fun d => Ideal.Quotient.mk I_succ (t ^ k * d)
          map_add' := fun d₁ d₂ => by rw [mul_add, map_add]
          map_smul' := fun r d => by
            dsimp
            change Ideal.Quotient.mk I_succ (t ^ k * (r * d)) =
              r • Ideal.Quotient.mk I_succ (t ^ k * d)
            rw [mul_left_comm, map_mul]
            exact (Algebra.smul_def r (Ideal.Quotient.mk I_succ (t ^ k * d))).symm }
      have htk_ne : t ^ k ≠ 0 := pow_ne_zero k ht_ne
      have hμ_zero_iff : ∀ d : D, μ_D d = 0 ↔ d ∈ Ideal.span {t} := by
        intro d
        change Ideal.Quotient.mk I_succ (t ^ k * d) = 0 ↔ d ∈ Ideal.span {t}
        rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
        constructor
        · rintro ⟨q, hq⟩
          refine ⟨q, mul_left_cancel₀ htk_ne ?_⟩
          calc
            t ^ k * d = t ^ (k + 1) * q := hq
            _ = t ^ k * (t * q) := by rw [pow_succ, mul_assoc]
        · rintro ⟨q, rfl⟩
          exact ⟨q, by rw [pow_succ, mul_assoc]⟩
      have h_ker_le : Ideal.span {t} ≤ LinearMap.ker μ_D :=
        fun d hd => (hμ_zero_iff d).mpr hd
      let μ_bar_D : (D ⧸ Ideal.span {t}) →ₗ[D] (D ⧸ I_succ) :=
        Submodule.liftQ (Ideal.span {t}) μ_D h_ker_le
      let μ_bar : (D ⧸ Ideal.span {t}) →ₗ[k₀] (D ⧸ I_succ) :=
        μ_bar_D.restrictScalars k₀
      have hμ_inj : Function.Injective μ_bar := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact Ideal.Quotient.eq_zero_iff_mem.mpr ((hμ_zero_iff d).mp hx)
      have hRange_eq : LinearMap.range μ_bar = LinearMap.ker p_lin := by
        ext x
        constructor
        · rintro ⟨y, rfl⟩
          obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective y
          change p_lin (Ideal.Quotient.mk I_succ (t ^ k * d)) = 0
          change Ideal.Quotient.mk I_k (t ^ k * d) = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr ⟨d, rfl⟩)
        · intro hx
          obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
          have ha_mem : a ∈ I_k := Ideal.Quotient.eq_zero_iff_mem.mp hx
          obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton.mp ha_mem
          exact ⟨Ideal.Quotient.mk (Ideal.span {t}) d, rfl⟩
      let e_ker : (D ⧸ Ideal.span {t}) ≃ₗ[k₀] ↥(LinearMap.ker p_lin) :=
        (LinearEquiv.ofInjective μ_bar hμ_inj).trans (LinearEquiv.ofEq _ _ hRange_eq)
      have hFinKer : Module.Finite k₀ ↥(LinearMap.ker p_lin) := Module.Finite.equiv e_ker
      let e_quot : ((D ⧸ I_succ) ⧸ LinearMap.ker p_lin) ≃ₗ[k₀] (D ⧸ I_k) :=
        p_lin.quotKerEquivOfSurjective hp_surj
      have hFinQuot : Module.Finite k₀ ((D ⧸ I_succ) ⧸ LinearMap.ker p_lin) :=
        Module.Finite.equiv e_quot.symm
