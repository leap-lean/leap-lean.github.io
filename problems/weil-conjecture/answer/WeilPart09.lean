        Ideal.iInf_pow_eq_bot_of_isLocalRing 𝔪 (IsLocalRing.maximalIdeal.isMaximal R).ne_top
      have hex : ∃ n : ℕ, ¬ J ≤ 𝔪 ^ n := by
        by_contra h_all
        have h_le : ∀ n : ℕ, J ≤ 𝔪 ^ n := fun n => of_not_not (fun hn => h_all ⟨n, hn⟩)
        exact hJ_bot (le_bot_iff.mp (h_iInf ▸ le_iInf h_le))
      classical
      let n := Nat.find hex
      have hn_spec : ¬ J ≤ 𝔪 ^ n := Nat.find_spec hex
      have hn0 : n ≠ 0 := by
        intro h0
        apply hn_spec
        rw [h0, pow_zero, Ideal.one_eq_top]
        exact le_top
      have hn1 : n ≠ 1 := by
        intro h1
        apply hn_spec
        rw [h1, pow_one]
        exact hJ_le
      have hk_pos : 1 ≤ n - 1 := by omega
      let k := n - 1
      have hn_eq : n = k + 1 := by omega
      have hJ_le_k : J ≤ 𝔪 ^ k := by
