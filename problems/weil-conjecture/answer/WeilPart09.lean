            _ = f b - f (b - a) := map_sub f _ _
            _ = f b := by rw [hf _ hba, sub_zero])
        map_add' := fun x y => by
          obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
          obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
          exact map_add f a b
        map_smul' := fun c x => by
          obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
          exact map_smul f c a }, fun _ => rfl⟩
    constructor
    · intro p hp_max hp_bij ⟨Θ₂⟩
      have hMonEq₁ : ∀ (d : Fin 1 →₀ ℕ) (a : Ω),
