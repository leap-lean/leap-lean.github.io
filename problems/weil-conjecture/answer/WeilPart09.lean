import WeilPart08
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_coprime_polynomial_monomial_span_hilbert_stabilization (K : Type u) [Field K]
    (M : ℕ) (h1M : 1 ≤ M)
    (P : Fin (M + 1) → Polynomial K)
    (d_E : ℕ) (hd_E : 1 ≤ d_E)
    (hDegLE : ∀ μ : Fin (M + 1), (P μ).natDegree ≤ d_E)
    (hDegEq : ∃ μ_max : Fin (M + 1), (P μ_max).natDegree = d_E)
    (hCoprime : Ideal.span (Set.range P) = ⊤)
    (hAbsorb : ∀ (b : Fin (M + 1)), P b ≠ 0 → ∀ i : Fin (d_E + 1),
      ∃ (N : ℕ) (c : weilDegMonomialIdx M N → K),
        1 ≤ N ∧
        (P b) ^ (N - 1) * Polynomial.X ^ (i : ℕ) =
          ∑ e : weilDegMonomialIdx M N,
            Polynomial.C (c e) * ∏ μ : Fin (M + 1), (P μ) ^ (e.1 μ : ℕ)) :
    ∃ D₀ : ℕ,
      1 ≤ D₀ ∧
      ∀ D : ℕ, D₀ ≤ D →
        Submodule.span K (Set.range fun e : weilDegMonomialIdx M D =>
          ∏ μ : Fin (M + 1), (P μ) ^ (e.1 μ : ℕ)) =
        Polynomial.degreeLT K (D * d_E + 1) :=
by
  classical
  let _ := h1M
  let V_P : ℕ → Submodule K (Polynomial K) := fun D =>
    Submodule.span K (Set.range fun e : weilDegMonomialIdx M D =>
      ∏ μ : Fin (M + 1), (P μ) ^ (e.1 μ : ℕ))
  have hMemDegLT : ∀ (m : ℕ) (f : Polynomial K),
      f ∈ Polynomial.degreeLT K (m + 1) ↔ f.natDegree ≤ m := by
    intro m f
    by_cases hf0 : f = 0
    · subst hf0
      simp [(Polynomial.degreeLT K (m + 1)).zero_mem]
    · rw [Polynomial.mem_degreeLT, ← Polynomial.natDegree_lt_iff_degree_lt hf0]
      omega
  have hUpper : ∀ D : ℕ, V_P D ≤ Polynomial.degreeLT K (D * d_E + 1) := by
    intro D
    rw [Submodule.span_le, Set.range_subset_iff]
    intro e
    rw [SetLike.mem_coe, hMemDegLT]
    calc
      (∏ μ : Fin (M + 1), (P μ) ^ (e.1 μ : ℕ)).natDegree
        ≤ ∑ μ : Fin (M + 1), ((P μ) ^ (e.1 μ : ℕ)).natDegree := Polynomial.natDegree_prod_le _ _
      _ ≤ ∑ μ : Fin (M + 1), (e.1 μ : ℕ) * (P μ).natDegree :=
        Finset.sum_le_sum fun μ _ => Polynomial.natDegree_pow_le
      _ ≤ ∑ μ : Fin (M + 1), (e.1 μ : ℕ) * d_E :=
        Finset.sum_le_sum fun μ _ => Nat.mul_le_mul_left _ (hDegLE μ)
      _ = (∑ μ : Fin (M + 1), (e.1 μ : ℕ)) * d_E := (Finset.sum_mul _ _ _).symm
      _ = D * d_E := by rw [e.2]
  have hExpMem : ∀ (D : ℕ) (α : Fin (M + 1) → ℕ),
      (∑ μ : Fin (M + 1), α μ) = D →
      (∏ μ : Fin (M + 1), (P μ) ^ (α μ)) ∈ V_P D := by
    intro D α hα
    have hlt : ∀ μ : Fin (M + 1), α μ < D + 1 := by
      intro μ
      have hle : α μ ≤ ∑ ν : Fin (M + 1), α ν :=
        Finset.single_le_sum (fun ν _ => Nat.zero_le (α ν)) (Finset.mem_univ μ)
      omega
    let e : weilDegMonomialIdx M D := ⟨fun μ => ⟨α μ, hlt μ⟩, hα⟩
    exact Submodule.subset_span ⟨e, rfl⟩
  have hOneMem0 : (1 : Polynomial K) ∈ V_P 0 := by
    have h := hExpMem 0 (fun _ => 0) (by simp)
    simpa using h
  have hPowMem : ∀ (b : Fin (M + 1)) (m : ℕ), (P b) ^ m ∈ V_P m := by
    intro b m
    let α : Fin (M + 1) → ℕ := fun μ => if μ = b then m else 0
    have hsum : (∑ μ : Fin (M + 1), α μ) = m := by
      rw [Finset.sum_eq_single b]
      · simp [α]
      · intro μ _ hμb
        simp [α, hμb]
      · intro hb
        exact False.elim (hb (Finset.mem_univ b))
    have hprod : (∏ μ : Fin (M + 1), (P μ) ^ (α μ)) = (P b) ^ m := by
      rw [Finset.prod_eq_single b]
      · simp [α]
      · intro μ _ hμb
        simp [α, hμb]
      · intro hb
        exact False.elim (hb (Finset.mem_univ b))
    rw [← hprod]
    exact hExpMem m α hsum
  have hMulMem : ∀ (D₁ D₂ : ℕ) (f g : Polynomial K),
      f ∈ V_P D₁ → g ∈ V_P D₂ → f * g ∈ V_P (D₁ + D₂) := by
    intro D₁ D₂ f g hf hg
    induction hf using Submodule.span_induction with
    | zero =>
      rw [zero_mul]
      exact (V_P (D₁ + D₂)).zero_mem
    | add x₁ x₂ _ _ ih₁ ih₂ =>
      rw [add_mul]
      exact (V_P (D₁ + D₂)).add_mem ih₁ ih₂
    | smul a x _ ih =>
      rw [smul_mul_assoc]
      exact (V_P (D₁ + D₂)).smul_mem a ih
    | mem x hx =>
      rcases hx with ⟨e₁, rfl⟩
      induction hg using Submodule.span_induction with
      | zero =>
        rw [mul_zero]
        exact (V_P (D₁ + D₂)).zero_mem
      | add y₁ y₂ _ _ ihy₁ ihy₂ =>
        rw [mul_add]
        exact (V_P (D₁ + D₂)).add_mem ihy₁ ihy₂
      | smul a y _ ihy =>
        rw [mul_smul_comm]
        exact (V_P (D₁ + D₂)).smul_mem a ihy
      | mem y hy =>
        rcases hy with ⟨e₂, rfl⟩
        have hProd :
            (∏ μ : Fin (M + 1), (P μ) ^ (e₁.1 μ : ℕ)) *
              (∏ μ : Fin (M + 1), (P μ) ^ (e₂.1 μ : ℕ)) =
            ∏ μ : Fin (M + 1), (P μ) ^ ((e₁.1 μ : ℕ) + (e₂.1 μ : ℕ)) := by
          rw [← Finset.prod_mul_distrib]
          exact Finset.prod_congr rfl fun μ _ => (pow_add (P μ) _ _).symm
        rw [hProd]
        refine hExpMem (D₁ + D₂) (fun μ => (e₁.1 μ : ℕ) + (e₂.1 μ : ℕ)) ?_
        rw [Finset.sum_add_distrib, e₁.2, e₂.2]
  let N_fn : Fin (M + 1) × Fin (d_E + 1) → ℕ := fun p =>
    if h : P p.1 ≠ 0 then (hAbsorb p.1 h p.2).choose else 2
  let r₀ : ℕ := max 2 (Finset.univ.sup N_fn)
  have hr₀ : 2 ≤ r₀ := le_max_left 2 _
  have hAbsorb1 : ∀ (b : Fin (M + 1)) (i : ℕ), i ≤ d_E →
      (P b) ^ (r₀ - 1) * Polynomial.X ^ i ∈ V_P r₀ := by
    intro b i hi
    by_cases hb : P b = 0
    · rw [hb, zero_pow (by omega : r₀ - 1 ≠ 0), zero_mul]
      exact (V_P r₀).zero_mem
    · let i_fin : Fin (d_E + 1) := ⟨i, Nat.lt_succ_of_le hi⟩
      let N : ℕ := (hAbsorb b hb i_fin).choose
      obtain ⟨c, h1N, hEqN⟩ := (hAbsorb b hb i_fin).choose_spec
      have hMemN : (P b) ^ (N - 1) * Polynomial.X ^ i ∈ V_P N := by
        change (P b) ^ (N - 1) * Polynomial.X ^ (i_fin : ℕ) ∈ V_P N
        rw [hEqN]
        refine Submodule.sum_mem (V_P N) fun e _ => ?_
        rw [← Polynomial.smul_eq_C_mul]
        exact (V_P N).smul_mem (c e) (Submodule.subset_span ⟨e, rfl⟩)
      have hN_le_sup : N ≤ Finset.univ.sup N_fn := by
        have hN_eq : N = N_fn (b, i_fin) := by simp [N, N_fn, hb]
        rw [hN_eq]
        exact Finset.le_sup (f := N_fn) (Finset.mem_univ (b, i_fin))
      have hN_le_r₀ : N ≤ r₀ := le_trans hN_le_sup (le_max_right 2 _)
      have hProdMem := hMulMem N (r₀ - N) _ _ hMemN (hPowMem b (r₀ - N))
      have hAddN : N + (r₀ - N) = r₀ := by omega
      have hAddN1 : (N - 1) + (r₀ - N) = r₀ - 1 := by omega
      rw [hAddN] at hProdMem
      have hProdEq :
          ((P b) ^ (N - 1) * Polynomial.X ^ i) * (P b) ^ (r₀ - N) =
            (P b) ^ (r₀ - 1) * Polynomial.X ^ i := by
        calc
          ((P b) ^ (N - 1) * Polynomial.X ^ i) * (P b) ^ (r₀ - N)
            = ((P b) ^ (N - 1) * (P b) ^ (r₀ - N)) * Polynomial.X ^ i := by ring
          _ = (P b) ^ ((N - 1) + (r₀ - N)) * Polynomial.X ^ i := by rw [← pow_add]
          _ = (P b) ^ (r₀ - 1) * Polynomial.X ^ i := by rw [hAddN1]
      rwa [hProdEq] at hProdMem
  have hAbsorbMon : ∀ (q : ℕ) (b : Fin (M + 1)) (m : ℕ), m ≤ q * d_E →
      (P b) ^ (q * (r₀ - 1)) * Polynomial.X ^ m ∈ V_P (q * r₀) := by
    intro q
    induction q with
    | zero =>
      intro b m hm
      have hm0 : m = 0 := by omega
      subst hm0
      simpa using hOneMem0
    | succ q ih =>
      intro b m hm
      have hm' : m ≤ q * d_E + d_E := by
        simpa [Nat.succ_mul] using hm
      let m₁ : ℕ := min m d_E
      let m₂ : ℕ := m - m₁
      have hm₁_le : m₁ ≤ d_E := Nat.min_le_right m d_E
      have hm₂_le : m₂ ≤ q * d_E := by omega
      have hm_add : m₁ + m₂ = m := by omega
      have h1 := hAbsorb1 b m₁ hm₁_le
      have h2 := ih b m₂ hm₂_le
      have hProd := hMulMem r₀ (q * r₀) _ _ h1 h2
      have hDegEq1 : r₀ + q * r₀ = (q + 1) * r₀ := by ring
      have hExpEq1 : (r₀ - 1) + q * (r₀ - 1) = (q + 1) * (r₀ - 1) := by ring
      rw [hDegEq1] at hProd
      have hPolyEq :
          ((P b) ^ (r₀ - 1) * Polynomial.X ^ m₁) *
            ((P b) ^ (q * (r₀ - 1)) * Polynomial.X ^ m₂) =
          (P b) ^ ((q + 1) * (r₀ - 1)) * Polynomial.X ^ m := by
        calc
          ((P b) ^ (r₀ - 1) * Polynomial.X ^ m₁) *
              ((P b) ^ (q * (r₀ - 1)) * Polynomial.X ^ m₂)
            = ((P b) ^ (r₀ - 1) * (P b) ^ (q * (r₀ - 1))) *
                (Polynomial.X ^ m₁ * Polynomial.X ^ m₂) := by ring
          _ = (P b) ^ ((r₀ - 1) + q * (r₀ - 1)) * Polynomial.X ^ (m₁ + m₂) := by
            rw [← pow_add, ← pow_add]
          _ = (P b) ^ ((q + 1) * (r₀ - 1)) * Polynomial.X ^ m := by
            rw [hExpEq1, hm_add]
      rwa [hPolyEq] at hProd
  have hAbsorbPoly : ∀ (q : ℕ) (b : Fin (M + 1)) (H : Polynomial K),
      H.natDegree ≤ q * d_E →
      (P b) ^ (q * (r₀ - 1)) * H ∈ V_P (q * r₀) := by
    intro q b H hH
    have hH_expand :
        (P b) ^ (q * (r₀ - 1)) * H =
          ∑ m ∈ Finset.range (H.natDegree + 1),
            (P b) ^ (q * (r₀ - 1)) * (Polynomial.C (H.coeff m) * Polynomial.X ^ m) := by
      conv_lhs =>
        arg 2
        rw [Polynomial.as_sum_range_C_mul_X_pow H]
      exact Finset.mul_sum _ _ _
    rw [hH_expand]
    refine Submodule.sum_mem (V_P (q * r₀)) fun m hm => ?_
    have hm_lt : m < H.natDegree + 1 := Finset.mem_range.mp hm
    have hm_le : m ≤ q * d_E := by omega
    have hRewrite :
        (P b) ^ (q * (r₀ - 1)) * (Polynomial.C (H.coeff m) * Polynomial.X ^ m) =
          (H.coeff m) • ((P b) ^ (q * (r₀ - 1)) * Polynomial.X ^ m) := by
      rw [Polynomial.smul_eq_C_mul]
      ring
    rw [hRewrite]
    exact (V_P (q * r₀)).smul_mem (H.coeff m) (hAbsorbMon q b m hm_le)
  have hOneIdeal : (1 : Polynomial K) ∈ Submodule.span (Polynomial K) (Set.range P) :=
    (Ideal.eq_top_iff_one (Ideal.span (Set.range P))).mp hCoprime
  obtain ⟨A, hA_sum⟩ :=
    (Submodule.mem_span_range_iff_exists_fun (Polynomial K)).mp hOneIdeal
  have hBezout : (∑ μ : Fin (M + 1), A μ * P μ) = 1 := by
    simpa [smul_eq_mul] using hA_sum
  let k_A : ℕ := Finset.univ.sup fun μ : Fin (M + 1) => (A μ).natDegree
  let q₀ : ℕ := k_A + 2
  obtain ⟨μ_max, hμ_max⟩ := hDegEq
  have hPmax_ne : P μ_max ≠ 0 := by
    intro h0
    rw [h0, Polynomial.natDegree_zero] at hμ_max
    omega
  let c₀ : K := (P μ_max).leadingCoeff
  have hc₀ : c₀ ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hPmax_ne
  have hc₀_inv : c₀⁻¹ ≠ 0 := inv_ne_zero hc₀
  let M_max : Polynomial K := Polynomial.C c₀⁻¹ * P μ_max
  have hMon : M_max.Monic :=
    Polynomial.monic_C_mul_of_mul_leadingCoeff_eq_one (inv_mul_cancel₀ hc₀)
  have hDegM : M_max.natDegree = d_E :=
    (Polynomial.natDegree_C_mul hc₀_inv).trans hμ_max
  have hNe1 : M_max ≠ 1 := by
    intro h1
    have hdeg1 : M_max.natDegree = 0 := by rw [h1, Polynomial.natDegree_one]
    omega
  have hDivBezout : ∀ (m : ℕ), q₀ ≤ m → ∀ (H : Polynomial K), H.natDegree ≤ m * d_E →
      ∃ C : Fin (M + 1) → Polynomial K,
        (∀ μ : Fin (M + 1), (C μ).natDegree ≤ (m - 1) * d_E) ∧
        H = ∑ μ : Fin (M + 1), C μ * P μ := by
    intro m hm H hH
    let Q : Polynomial K := H /ₘ M_max
    let R : Polynomial K := H %ₘ M_max
    let C : Fin (M + 1) → Polynomial K := fun μ =>
      R * A μ + if μ = μ_max then Polynomial.C c₀⁻¹ * Q else 0
    refine ⟨C, ?_, ?_⟩
    · intro μ
      have hR_lt : R.natDegree < d_E := by
        rw [← hDegM]
        exact Polynomial.natDegree_modByMonic_lt H hMon hNe1
      have hA_le : (A μ).natDegree ≤ k_A :=
        Finset.le_sup (f := fun ν : Fin (M + 1) => (A ν).natDegree) (Finset.mem_univ μ)
      have hkA_mul : k_A ≤ k_A * d_E := by
        simpa using Nat.mul_le_mul_left k_A hd_E
      have hm_mul : (k_A + 1) * d_E ≤ (m - 1) * d_E :=
        Nat.mul_le_mul_right d_E (by omega)
      have hRA_le : (R * A μ).natDegree ≤ (m - 1) * d_E := by
        have h1 : (R * A μ).natDegree ≤ R.natDegree + (A μ).natDegree :=
          Polynomial.natDegree_mul_le
        have h2 : (k_A + 1) * d_E = k_A * d_E + d_E := by ring
        omega
      have hCQ_le : (if μ = μ_max then Polynomial.C c₀⁻¹ * Q else 0).natDegree ≤ (m - 1) * d_E := by
        split_ifs
        · calc
            (Polynomial.C c₀⁻¹ * Q).natDegree ≤ Q.natDegree := Polynomial.natDegree_C_mul_le _ _
            _ = H.natDegree - M_max.natDegree := Polynomial.natDegree_divByMonic H hMon
            _ = H.natDegree - d_E := by rw [hDegM]
            _ ≤ m * d_E - d_E := Nat.sub_le_sub_right hH d_E
            _ = (m - 1) * d_E := by
              simpa using (Nat.sub_mul m 1 d_E).symm
        · rw [Polynomial.natDegree_zero]
          exact Nat.zero_le _
      exact le_trans (Polynomial.natDegree_add_le _ _) (max_le hRA_le hCQ_le)
    · have hSum : (∑ μ : Fin (M + 1), C μ * P μ) = R + M_max * Q := by
        have hExpand : ∀ μ : Fin (M + 1),
            C μ * P μ = R * (A μ * P μ) +
              (if μ = μ_max then (Polynomial.C c₀⁻¹ * Q) * P μ else 0) := by
          intro μ
          dsimp [C]
          split_ifs <;> ring
        simp_rw [hExpand]
        rw [Finset.sum_add_distrib, ← Finset.mul_sum, hBezout, mul_one]
        congr 1
        rw [Finset.sum_eq_single μ_max]
        · simp only [↓reduceIte]
          dsimp [M_max]
          ring
        · intro μ _ hμ
          simp [hμ]
        · intro hAbs
          exact False.elim (hAbs (Finset.mem_univ μ_max))
      rw [hSum]
      exact (Polynomial.modByMonic_add_div H M_max).symm
  let D₀ : ℕ := q₀ + (M + 1) * (q₀ * (r₀ - 1)) + 1
  refine ⟨D₀, by omega, ?_⟩
  intro D hD
  let k : ℕ := D - q₀
  have hqk : q₀ + k = D := by omega
  have hk_gt : (M + 1) * (q₀ * (r₀ - 1)) < k := by omega
  have hAcc : ∀ (t : ℕ), t ≤ k →
      ∀ (α : Fin (M + 1) → ℕ), (∑ μ : Fin (M + 1), α μ) = k - t →
      ∀ (H : Polynomial K), H.natDegree ≤ (q₀ + t) * d_E →
      H * (∏ μ : Fin (M + 1), (P μ) ^ (α μ)) ∈ V_P D := by
    intro t
    induction t with
    | zero =>
      intro _ α hα H hH
      let c : ℕ := q₀ * (r₀ - 1)
      have hSumLt : (∑ _μ : Fin (M + 1), c) < ∑ μ : Fin (M + 1), α μ := by
        have hConst : (∑ _μ : Fin (M + 1), c) = (M + 1) * c := by
          simp [Finset.sum_const, smul_eq_mul]
        rw [hConst, hα, Nat.sub_zero]
        exact hk_gt
      obtain ⟨b, _, hb_lt⟩ := Finset.exists_lt_of_sum_lt hSumLt
      have hc_le : c ≤ α b := Nat.le_of_lt hb_lt
      let β : Fin (M + 1) → ℕ := Function.update α b (α b - c)
      let γ : Fin (M + 1) → ℕ := fun μ => if μ = b then c else 0
      have hβγ : ∀ μ : Fin (M + 1), β μ + γ μ = α μ := by
        intro μ
        by_cases hμ : μ = b
        · subst hμ
          simp [β, γ, Nat.sub_add_cancel hc_le]
        · simp [β, γ, hμ]
      have hγ_sum : (∑ μ : Fin (M + 1), γ μ) = c := by
        rw [Finset.sum_eq_single b]
        · simp [γ]
        · intro μ _ hμ
          simp [γ, hμ]
        · intro hb
          exact False.elim (hb (Finset.mem_univ b))
      have hβ_sum_c : (∑ μ : Fin (M + 1), β μ) + c = k := by
        calc
          (∑ μ : Fin (M + 1), β μ) + c
            = (∑ μ : Fin (M + 1), β μ) + (∑ μ : Fin (M + 1), γ μ) := by rw [hγ_sum]
          _ = ∑ μ : Fin (M + 1), (β μ + γ μ) := (Finset.sum_add_distrib).symm
          _ = ∑ μ : Fin (M + 1), α μ := Finset.sum_congr rfl fun μ _ => hβγ μ
          _ = k := by simpa using hα
      have hqr : q₀ * r₀ = q₀ + c := by
        have hr1 : r₀ = 1 + (r₀ - 1) := by omega
        calc
          q₀ * r₀ = q₀ * (1 + (r₀ - 1)) := by rw [← hr1]
          _ = q₀ + q₀ * (r₀ - 1) := by ring
          _ = q₀ + c := rfl
      have hDegSum : q₀ * r₀ + (∑ μ : Fin (M + 1), β μ) = D := by omega
      have hγ_prod : (∏ μ : Fin (M + 1), (P μ) ^ (γ μ)) = (P b) ^ c := by
        rw [Finset.prod_eq_single b]
        · simp [γ]
        · intro μ _ hμ
          simp [γ, hμ]
        · intro hb
          exact False.elim (hb (Finset.mem_univ b))
      have hα_prod :
          (∏ μ : Fin (M + 1), (P μ) ^ (α μ)) =
            (∏ μ : Fin (M + 1), (P μ) ^ (β μ)) * (P b) ^ c := by
        calc
          (∏ μ : Fin (M + 1), (P μ) ^ (α μ))
            = ∏ μ : Fin (M + 1), (P μ) ^ (β μ + γ μ) :=
              Finset.prod_congr rfl fun μ _ => by rw [hβγ μ]
          _ = ∏ μ : Fin (M + 1), ((P μ) ^ (β μ) * (P μ) ^ (γ μ)) :=
              Finset.prod_congr rfl fun μ _ => pow_add (P μ) (β μ) (γ μ)
          _ = (∏ μ : Fin (M + 1), (P μ) ^ (β μ)) * (∏ μ : Fin (M + 1), (P μ) ^ (γ μ)) :=
              Finset.prod_mul_distrib
          _ = (∏ μ : Fin (M + 1), (P μ) ^ (β μ)) * (P b) ^ c := by rw [hγ_prod]
      have hH_le : H.natDegree ≤ q₀ * d_E := by simpa using hH
      have hMem1 : (P b) ^ c * H ∈ V_P (q₀ * r₀) := hAbsorbPoly q₀ b H hH_le
      have hMem2 : (∏ μ : Fin (M + 1), (P μ) ^ (β μ)) ∈ V_P (∑ μ : Fin (M + 1), β μ) :=
        hExpMem _ β rfl
      have hProdMem := hMulMem (q₀ * r₀) (∑ μ : Fin (M + 1), β μ) _ _ hMem1 hMem2
      rw [hDegSum] at hProdMem
      have hRearr :
          H * (∏ μ : Fin (M + 1), (P μ) ^ (α μ)) =
            ((P b) ^ c * H) * (∏ μ : Fin (M + 1), (P μ) ^ (β μ)) := by
        rw [hα_prod]
        ring
      rwa [← hRearr] at hProdMem
    | succ t ih =>
      intro ht1 α hα H hH
      have hq_le : q₀ ≤ q₀ + (t + 1) := by omega
      obtain ⟨C, hC_deg, hC_sum⟩ := hDivBezout (q₀ + (t + 1)) hq_le H hH
      rw [hC_sum, Finset.sum_mul]
      refine Submodule.sum_mem (V_P D) fun ν _ => ?_
      let α_ν : Fin (M + 1) → ℕ := fun μ => α μ + if μ = ν then 1 else 0
      have hδ_sum : (∑ μ : Fin (M + 1), (if μ = ν then (1 : ℕ) else 0)) = 1 := by
        rw [Finset.sum_eq_single ν]
        · simp
        · intro μ _ hμ
          simp [hμ]
        · intro hν
          exact False.elim (hν (Finset.mem_univ ν))
      have hαν_sum : (∑ μ : Fin (M + 1), α_ν μ) = k - t := by
        have h1 : (∑ μ : Fin (M + 1), α_ν μ) = (∑ μ : Fin (M + 1), α μ) + 1 := by
          dsimp [α_ν]
          rw [Finset.sum_add_distrib, hδ_sum]
        omega
      have hδ_prod : (∏ μ : Fin (M + 1), (P μ) ^ (if μ = ν then (1 : ℕ) else 0)) = P ν := by
        rw [Finset.prod_eq_single ν]
        · simp
        · intro μ _ hμ
          simp [hμ]
        · intro hν
          exact False.elim (hν (Finset.mem_univ ν))
      have hαν_prod :
          (C ν * P ν) * (∏ μ : Fin (M + 1), (P μ) ^ (α μ)) =
            C ν * (∏ μ : Fin (M + 1), (P μ) ^ (α_ν μ)) := by
        have hp :
            (∏ μ : Fin (M + 1), (P μ) ^ (α_ν μ)) =
              (∏ μ : Fin (M + 1), (P μ) ^ (α μ)) * P ν := by
          calc
            (∏ μ : Fin (M + 1), (P μ) ^ (α_ν μ))
              = ∏ μ : Fin (M + 1), ((P μ) ^ (α μ) * (P μ) ^ (if μ = ν then (1 : ℕ) else 0)) :=
                Finset.prod_congr rfl fun μ _ => pow_add (P μ) (α μ) _
            _ = (∏ μ : Fin (M + 1), (P μ) ^ (α μ)) *
                  (∏ μ : Fin (M + 1), (P μ) ^ (if μ = ν then (1 : ℕ) else 0)) :=
                Finset.prod_mul_distrib
            _ = (∏ μ : Fin (M + 1), (P μ) ^ (α μ)) * P ν := by rw [hδ_prod]
        rw [hp]
        ring
      rw [hαν_prod]
      have hCν_deg : (C ν).natDegree ≤ (q₀ + t) * d_E := by
        have hsub : q₀ + (t + 1) - 1 = q₀ + t := by omega
        simpa [hsub] using hC_deg ν
      exact ih (Nat.le_of_succ_le ht1) α_ν hαν_sum (C ν) hCν_deg
  refine le_antisymm (hUpper D) ?_
  intro H hH
  have hH_deg : H.natDegree ≤ (q₀ + k) * d_E := by
    rw [hqk]
    exact (hMemDegLT (D * d_E) H).mp hH
  have hMem := hAcc k le_rfl (fun _ => 0) (by simp) H hH_deg
  simpa using hMem

theorem weil_algClosed_proj_p1_closedImmersion_hilbert_dim (K : Type u) [Field K] [IsAlgClosed K]
    (M : ℕ) (h1M : 1 ≤ M)
    (hAffK : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K M a))
    (c_K : ∀ a : Fin (M + 1),
      K →+* ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K M a))))
    (t_K : ∀ a : Fin (M + 1), Fin (M + 1) →
      ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K M a))))
    (hCoordK : IsCommRingProjCoordSystem K M hAffK c_K t_K)
    (hAffK1 : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K 1 a))
    (c_K1 : ∀ a : Fin (1 + 1),
      K →+* ↑((weilProjectiveSpaceOver K 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K 1 a))))
    (t_K1 : ∀ a : Fin (1 + 1), Fin (1 + 1) →
      ↑((weilProjectiveSpaceOver K 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K 1 a))))
    (hCoordK1 : IsCommRingProjCoordSystem K 1 hAffK1 c_K1 t_K1)
    (ψ_K : (weilProjectiveSpaceOver K 1).left ⟶ (weilProjectiveSpaceOver K M).left)
    (hClK : AlgebraicGeometry.IsClosedImmersion ψ_K)
    (hCommK : ψ_K ≫ (weilProjectiveSpaceOver K M).hom = (weilProjectiveSpaceOver K 1).hom)
    (a₀ : Fin (M + 1))
    (hNe : Nonempty ↥((TopologicalSpace.Opens.map ψ_K.base).obj (weilProjBasicOpen K M a₀))) :
    let E_a₀ := (TopologicalSpace.Opens.map ψ_K.base).obj (weilProjBasicOpen K M a₀)
    let B_Ka₀ : Type u := ↑((weilProjectiveSpaceOver K 1).left.presheaf.obj (Opposite.op E_a₀))
    letI : Algebra K B_Ka₀ := ((ψ_K.app (weilProjBasicOpen K M a₀)).hom.comp (c_K a₀)).toAlgebra
    let ξ_K : Fin (M + 1) → B_Ka₀ :=
      fun μ => (ψ_K.app (weilProjBasicOpen K M a₀)).hom (t_K a₀ μ)
    ∃ (d_E D₀ : ℕ),
      1 ≤ d_E ∧
      1 ≤ D₀ ∧
      ∀ D : ℕ, D₀ ≤ D →
        let Q_KD : Submodule K B_Ka₀ :=
          Submodule.span K (Set.range fun e : weilDegMonomialIdx M D =>
            ∏ μ : Fin (M + 1), (ξ_K μ) ^ (e.1 μ : ℕ))
        Module.Finite K Q_KD ∧ Module.finrank K Q_KD = D * d_E + 1 :=
by
  let E_a₀ := (TopologicalSpace.Opens.map ψ_K.base).obj (weilProjBasicOpen K M a₀)
  let B_Ka₀ : Type u := ↑((weilProjectiveSpaceOver K 1).left.presheaf.obj (Opposite.op E_a₀))
  letI : Algebra K B_Ka₀ := ((ψ_K.app (weilProjBasicOpen K M a₀)).hom.comp (c_K a₀)).toAlgebra
  let ξ_K : Fin (M + 1) → B_Ka₀ :=
    fun μ => (ψ_K.app (weilProjBasicOpen K M a₀)).hom (t_K a₀ μ)
  obtain ⟨hCoordGen, hP1Charts⟩ := weil_commRing_proj_coord_appLE_and_p1_chart_equiv K
  have hc1_0 : CommRingCat.ofHom (c_K1 0) =
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
        (weilProjectiveSpaceOver K 1).hom.appLE ⊤ (weilProjBasicOpen K 1 0) le_top :=
    (hCoordGen 1 hAffK1 c_K1 t_K1 hCoordK1 0).1
  have hc1_1 : CommRingCat.ofHom (c_K1 1) =
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
        (weilProjectiveSpaceOver K 1).hom.appLE ⊤ (weilProjBasicOpen K 1 1) le_top :=
    (hCoordGen 1 hAffK1 c_K1 t_K1 hCoordK1 1).1
  obtain ⟨hCov1, hNe0, hNe1, hNe01, hIrred1, Φ₀, Φ₁, hΦ₀_C, _hΦ₀_X, hΦ₁_C, _hΦ₁_X, huv, hRev⟩ :=
    hP1Charts hAffK1 c_K1 t_K1 hCoordK1
  letI : IrreducibleSpace ↥(weilProjectiveSpaceOver K 1).left := hIrred1
  have hC0 : CommRingCat.ofHom (Φ₀.toRingHom.comp Polynomial.C) =
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
        (weilProjectiveSpaceOver K 1).hom.appLE ⊤ (weilProjBasicOpen K 1 0) le_top := by
    rw [hΦ₀_C, hc1_0]
  have hC1 : CommRingCat.ofHom (Φ₁.toRingHom.comp Polynomial.C) =
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
        (weilProjectiveSpaceOver K 1).hom.appLE ⊤ (weilProjBasicOpen K 1 1) le_top := by
    rw [hΦ₁_C, hc1_1]
  obtain ⟨j_open, hJ1, hJ2, hJ3, hJ4, hJ5⟩ :=
    weil_two_polynomial_chart_scheme_fraction_and_polar_gluing K
      (weilProjectiveSpaceOver K 1).left (weilProjectiveSpaceOver K 1).hom
      (weilProjBasicOpen K 1 0) (weilProjBasicOpen K 1 1)
      (hAffK1 0) (hAffK1 1) hCov1 hNe0 hNe1 hNe01 Φ₀ Φ₁ hC0 hC1 huv hRev
  have hcK_appLE : ∀ a : Fin (M + 1),
      CommRingCat.ofHom (c_K a) =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
          (weilProjectiveSpaceOver K M).hom.appLE ⊤ (weilProjBasicOpen K M a) le_top :=
    fun a => (hCoordGen M hAffK c_K t_K hCoordK a).1
  have hGenK : ∀ (a : Fin (M + 1))
      (x : ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K M a)))),
      ∃ (D : ℕ) (c : weilDegMonomialIdx M D → K),
        1 ≤ D ∧
        x = ∑ e : weilDegMonomialIdx M D,
          c_K a (c e) * ∏ μ : Fin (M + 1), (t_K a μ) ^ (e.1 μ : ℕ) :=
    fun a => (hCoordGen M hAffK c_K t_K hCoordK a).2
  obtain ⟨P, d_E, hd_E, hPa₀, hDegLE, hDegEq, hCoprime, hScalar, hRatio, hAbsorb⟩ :=
    weil_closedImmersion_into_proj_coprime_poly_and_pos_deg K M h1M
      hAffK c_K t_K hCoordK hcK_appLE hGenK
      (weilProjectiveSpaceOver K 1).left (weilProjectiveSpaceOver K 1).hom
      (weilProjBasicOpen K 1 0) (weilProjBasicOpen K 1 1)
      (hAffK1 0) (hAffK1 1) hCov1 hNe0 hNe1 Φ₀ Φ₁ hRev
      j_open hJ1 hJ2 hJ3 hJ4 hJ5 ψ_K hClK hCommK a₀ hNe
  obtain ⟨D₀, hD₀, hStab⟩ :=
    weil_coprime_polynomial_monomial_span_hilbert_stabilization K M h1M P d_E hd_E
      hDegLE hDegEq hCoprime hAbsorb
  refine ⟨d_E, D₀, hd_E, hD₀, ?_⟩
  intro D hD
  let Q_KD : Submodule K B_Ka₀ :=
    Submodule.span K (Set.range fun e : weilDegMonomialIdx M D =>
      ∏ μ : Fin (M + 1), (ξ_K μ) ^ (e.1 μ : ℕ))
  let F_K := FractionRing (Polynomial K)
  let j_E : B_Ka₀ →+* F_K := j_open E_a₀ hNe
  have hj_inj : Function.Injective j_E := hJ1 E_a₀ hNe
  let j_lin : B_Ka₀ →ₗ[K] F_K :=
    { toFun := j_E
      map_add' := map_add j_E
      map_smul' := fun c x => by
        simp only [RingHom.id_apply]
        change j_E (((ψ_K.app (weilProjBasicOpen K M a₀)).hom (c_K a₀ c)) * x) = c • j_E x
        rw [map_mul, hScalar c, Algebra.smul_def,
          IsScalarTower.algebraMap_apply K (Polynomial K) F_K c, Polynomial.algebraMap_eq] }
  let u₀ : F_K := algebraMap (Polynomial K) F_K (P a₀)
  have hu₀_ne : u₀ ≠ 0 := by
    intro hu₀
    apply hPa₀
    apply IsFractionRing.injective (Polynomial K) F_K
    simpa [u₀] using hu₀
  have hu₀_pow_ne : (u₀⁻¹) ^ D ≠ 0 := pow_ne_zero D (inv_ne_zero hu₀_ne)
  let ψ_D : Polynomial K →ₗ[K] F_K :=
    { toFun := fun Q => algebraMap (Polynomial K) F_K Q * (u₀⁻¹) ^ D
      map_add' := fun Q₁ Q₂ => by rw [map_add, add_mul]
      map_smul' := fun c Q => by
        simp only [RingHom.id_apply, Algebra.smul_def, map_mul, mul_assoc,
          IsScalarTower.algebraMap_apply K (Polynomial K) F_K c] }
  have hψ_inj : Function.Injective ψ_D := by
    intro Q₁ Q₂ hEq
    apply IsFractionRing.injective (Polynomial K) F_K
    exact mul_right_cancel₀ hu₀_pow_ne hEq
  have hj_ξ : ∀ μ : Fin (M + 1),
      j_E (ξ_K μ) = algebraMap (Polynomial K) F_K (P μ) * u₀⁻¹ := by
    intro μ
    calc
      j_E (ξ_K μ) = (j_E (ξ_K μ) * u₀) * u₀⁻¹ := by
        rw [mul_assoc, mul_inv_cancel₀ hu₀_ne, mul_one]
      _ = algebraMap (Polynomial K) F_K (P μ) * u₀⁻¹ := by
        rw [hRatio μ]
  have hGen_eq : ∀ e : weilDegMonomialIdx M D,
      j_lin (∏ μ : Fin (M + 1), (ξ_K μ) ^ (e.1 μ : ℕ)) =
        ψ_D (∏ μ : Fin (M + 1), (P μ) ^ (e.1 μ : ℕ)) := by
    intro e
    change j_E (∏ μ : Fin (M + 1), (ξ_K μ) ^ (e.1 μ : ℕ)) =
      algebraMap (Polynomial K) F_K (∏ μ : Fin (M + 1), (P μ) ^ (e.1 μ : ℕ)) * (u₀⁻¹) ^ D
    rw [map_prod]
    simp_rw [map_pow, hj_ξ, mul_pow]
    rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, e.2, map_prod]
    simp_rw [map_pow]
  let V_PD : Submodule K (Polynomial K) :=
    Submodule.span K (Set.range fun e : weilDegMonomialIdx M D =>
      ∏ μ : Fin (M + 1), (P μ) ^ (e.1 μ : ℕ))
  have hRangeEq :
      LinearMap.range (j_lin.domRestrict Q_KD) =
        LinearMap.range (ψ_D.domRestrict (Polynomial.degreeLT K (D * d_E + 1))) := by
    rw [LinearMap.range_domRestrict, LinearMap.range_domRestrict, ← hStab D hD]
    dsimp only [Q_KD, V_PD]
    rw [Submodule.map_span, Submodule.map_span, ← Set.range_comp, ← Set.range_comp]
    congr 1
    ext x
    simp only [Set.mem_range, Function.comp_apply, hGen_eq]
  have hInj_j : Function.Injective (j_lin.domRestrict Q_KD) :=
    fun x y h => Subtype.ext (hj_inj h)
  have hInj_ψ : Function.Injective (ψ_D.domRestrict (Polynomial.degreeLT K (D * d_E + 1))) :=
    fun x y h => Subtype.ext (hψ_inj h)
  let e_D : ↥Q_KD ≃ₗ[K] (Fin (D * d_E + 1) → K) :=
    ((LinearEquiv.ofInjective (j_lin.domRestrict Q_KD) hInj_j).trans
      (LinearEquiv.ofEq _ _ hRangeEq)).trans
      (((LinearEquiv.ofInjective
          (ψ_D.domRestrict (Polynomial.degreeLT K (D * d_E + 1))) hInj_ψ).symm).trans
        (Polynomial.degreeLTEquiv K (D * d_E + 1)))
  exact ⟨Module.Finite.equiv e_D.symm,
    (LinearEquiv.finrank_eq e_D).trans (Module.finrank_fin_fun K)⟩

theorem weil_valuation_proj_closure_saturation_and_cokernel_bound (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Finite (PrimeSpectrum R)]
    (hMaxR : IsLocalRing.maximalIdeal R ≠ ⊥)
