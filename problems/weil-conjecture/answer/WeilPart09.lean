      rw [IsScalarTower.algebraMap_apply Ω D'_4 L_4 c]
      exact (RingHom.congr_fun hres_L4_comp _).trans (hev₄_c c)
    have hres_L4_surj : Function.Surjective res_L4 :=
      fun c => ⟨algebraMap Ω L_4 c, RingHom.congr_fun hres_L4_id c⟩
    have hker_res_L4 : RingHom.ker res_L4 = 𝔪_4 :=
      IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective res_L4 hres_L4_surj)
    have hFin_L4 : Module.finrank Ω (L_4 ⧸ 𝔪_4 ^ 2) = 3 := by
      have : Algebra.FormallyEtale D'_4 L_4 := Algebra.FormallyEtale.of_isLocalization q₄.primeCompl
      obtain ⟨e_jet1⟩ := hJet D D'_4 ev₄ hev₄_id 2 (by omega)
      obtain ⟨e_jet2⟩ := hJet D'_4 L_4 res_L4 hres_L4_id 2 (by omega)
      rw [hev₄_comp] at e_jet1
      rw [hres_L4_comp] at e_jet2
      rw [hker_res_L4] at e_jet2
      have h_eq := LinearEquiv.finrank_eq (e_jet1.trans e_jet2).toLinearEquiv
      omega
    have hBranchKill : ∀ (u_i u_j : L_N),
        Ideal.span {u_i, u_j} = 𝔪_N → u_i * u_j = 0 →
        ∀ h ∈ RingHom.ker ψ_loc, h ∉ Ideal.span {u_i} → False := by
      intro u_i u_j h_span_ij h_mul_ij h hh_ker hh_not_ui
      have hui_mem : u_i ∈ 𝔪_N := by
        rw [← h_span_ij]
        exact Ideal.subset_span (by simp)
      have huj_mem : u_j ∈ 𝔪_N := by
        rw [← h_span_ij]
        exact Ideal.subset_span (by simp)
      let R_i : Type u := L_N ⧸ Ideal.span {u_i}
      let π_i : L_N →+* R_i := Ideal.Quotient.mk (Ideal.span {u_i})
