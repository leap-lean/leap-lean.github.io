              MvPolynomial.monomial d10 (w 1) + MvPolynomial.monomial d01 (w 2))) := by
          intro w
          rw [hMonEq₂ d00, hMonEq₂ d10, hMonEq₂ d01]
          have hd10_1 : d10 1 = 0 := by simp [d10]
          have hd01_0 : d01 0 = 0 := by simp [d01]
          simp only [d00, Finsupp.coe_zero, Pi.zero_apply, hd10_1, hd01_0,
            d10, d01, Finsupp.single_eq_same, pow_zero, pow_one, mul_one]
          simp [Ψ₃, Algebra.smul_def, hAlg₂, map_add, map_mul]
        have hΦΨ₃ : ∀ w : Fin 3 → Ω, Φ₃ (Ψ₃ w) = w := by
          intro w
          rw [hΨ₃_apply w, hΦ₃_mk, hΦ₃_R_mk]
          have hne10_00 : d10 ≠ d00 := by intro h; have := congrArg (· 0) h; simp [d10, d00] at this
          have hne01_00 : d01 ≠ d00 := by intro h; have := congrArg (· 1) h; simp [d01, d00] at this
          have hne01_10 : d01 ≠ d10 := by intro h; have := congrArg (· 1) h; simp [d01, d10] at this
          ext j
          fin_cases j <;> simp [Φ₃_P, MvPolynomial.lcoeff_apply, MvPolynomial.coeff_monomial,
