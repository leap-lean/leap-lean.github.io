  have _ := hj₀_open
  have hLFT_j₀ : AlgebraicGeometry.LocallyOfFiniteType (j₀ ≫ (ι_F ≫ p_Y)) := inferInstance
  rw [hj₀_comm] at hLFT_j₀
  have hFT_D₀_hom : (algebraMap Ω D₀).FiniteType :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp
      hLFT_j₀
  have _ : Algebra.FiniteType Ω D₀ := RingHom.finiteType_algebraMap.mp hFT_D₀_hom
  obtain ⟨ev₀, hev₀_ker⟩ := hNull Ω D₀ q₀.asIdeal hq₀_max
  let x₀ : ↥E_F := j₀.base q₀
  let y : ↥Y := ι_F.base x₀
  have hyF : y ∈ F := by
    rw [← hRange_F]
