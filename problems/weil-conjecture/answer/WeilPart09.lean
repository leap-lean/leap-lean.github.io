      obtain ⟨x₂, rfl⟩ := Ideal.Quotient.mk_surjective b₂
      have hEq' : Ideal.Quotient.mk 𝔯 (res₀ x₁) = Ideal.Quotient.mk 𝔯 (res₀ x₂) := hEq
      have hsub : Ideal.Quotient.mk 𝔯 (res₀ (x₁ - x₂)) = 0 := by
