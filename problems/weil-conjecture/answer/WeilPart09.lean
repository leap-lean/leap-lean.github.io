          _ = ι_c W_ab ≫ φ := by rw [hres_c_L_ι]
          _ = (res_c_R ≫ ι_c (W₀ b)) ≫ φ := by rw [hres_c_R_ι]
          _ = res_c_R ≫ ((AlgebraicGeometry.opensCone D c i₀ (W₀ b)).π.app u₁ ≫ ψ₁ b) := by
                rw [CategoryTheory.Category.assoc, ← hψ₁_cone b]
          _ = c_ab.π.app u₁ ≫ (inc_diag_R a b u₁ ≫ ψ₁ b) := by
                rw [← CategoryTheory.Category.assoc, ← hπ_R, CategoryTheory.Category.assoc]
      exact AlgebraicGeometry.Scheme.exists_hom_comp_eq_comp_of_locallyOfFiniteType
        D_ab t_ab f c_ab hc_ab (inc_diag_L a b u₁ ≫ ψ₁ a) (inc_diag_R a b u₁ ≫ ψ₁ b)
        hL_over hR_over hLR_cone
    choose v_ov μ_ov hμ_ov using hOverlap
    have hCommonStar : ∃ (u_star : CategoryTheory.Over i₀) (m_star : u_star ⟶ u₁),
        ∀ p : ↥s × ↥s, ∃ k_p : u_star ⟶ v_ov p, k_p ≫ μ_ov p = m_star := by
      classical
      suffices ∀ S : Finset (↥s × ↥s), ∃ (u_S : CategoryTheory.Over i₀) (m_S : u_S ⟶ u₁),
          ∀ p ∈ S, ∃ k_p : u_S ⟶ v_ov p, k_p ≫ μ_ov p = m_S by
        obtain ⟨u_star, m_star, hm⟩ := this Finset.univ
        exact ⟨u_star, m_star, fun p => hm p (Finset.mem_univ p)⟩
      intro S
      refine Finset.induction_on S ?_ ?_
      · exact ⟨u₁, 𝟙 u₁, fun _ h => absurd h (Finset.notMem_empty _)⟩
      · intro p S' _ ⟨u_S, m_S, hm_S⟩
        let w₀ := CategoryTheory.IsCofiltered.min u_S (v_ov p)
        let π_L : w₀ ⟶ u_S := CategoryTheory.IsCofiltered.minToLeft u_S (v_ov p)
        let π_R : w₀ ⟶ v_ov p := CategoryTheory.IsCofiltered.minToRight u_S (v_ov p)
        let w₁ := CategoryTheory.IsCofiltered.eq (π_L ≫ m_S) (π_R ≫ μ_ov p)
        let e_w : w₁ ⟶ w₀ := CategoryTheory.IsCofiltered.eqHom (π_L ≫ m_S) (π_R ≫ μ_ov p)
        have he_eq : e_w ≫ π_L ≫ m_S = e_w ≫ π_R ≫ μ_ov p :=
          CategoryTheory.IsCofiltered.eq_condition (π_L ≫ m_S) (π_R ≫ μ_ov p)
        refine ⟨w₁, e_w ≫ π_L ≫ m_S, fun q hq => ?_⟩
        rcases Finset.mem_insert.mp hq with rfl | hq'
        · exact ⟨e_w ≫ π_R, by rw [CategoryTheory.Category.assoc, he_eq]⟩
        · obtain ⟨k_q, hk_q⟩ := hm_S q hq'
          exact ⟨e_w ≫ π_L ≫ k_q, by rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hk_q]⟩
    obtain ⟨u_star, m_star, hfac_star⟩ := hCommonStar
    let i_star : I := u_star.left
    let W_star : ↥s → (D.obj i_star).Opens := fun a => (D.map u_star.hom) ⁻¹ᵁ (W₀ a)
    have hCov_star : TopologicalSpace.IsOpenCover W_star := by
      refine TopologicalSpace.IsOpenCover.mk (eq_top_iff.mpr fun x _ => ?_)
      have hx : (D.map u_star.hom).base x ∈ (⊤ : (D.obj i₀).Opens) := trivial
      rw [← hCovW₀.iSup_eq_top, TopologicalSpace.Opens.mem_iSup] at hx
      obtain ⟨a, ha⟩ := hx
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ha⟩
    let 𝒰_star := (D.obj i_star).openCoverOfIsOpenCover W_star hCov_star
    let ψ_star : ∀ a : ↥s, (AlgebraicGeometry.opensDiagram D i₀ (W₀ a)).obj u_star ⟶ X :=
      fun a => (AlgebraicGeometry.opensDiagram D i₀ (W₀ a)).map m_star ≫ ψ₁ a
    have hGlueCompat : ∀ a b : 𝒰_star.I₀,
        CategoryTheory.Limits.pullback.fst (𝒰_star.f a) (𝒰_star.f b) ≫ ψ_star a =
          CategoryTheory.Limits.pullback.snd (𝒰_star.f a) (𝒰_star.f b) ≫ ψ_star b := by
      intro (a : ↥s) (b : ↥s)
      let fst_ab : CategoryTheory.Limits.pullback (ι_D (W₀ a) u_star) (ι_D (W₀ b) u_star) ⟶
