            hα_aux, (hSAB₀ j).1, (hSAB₀ j).2.1, (hSAB₀ j).2.2, hα_Wj, hα_X0, hα_Y1]
          rw [← map_mul, ← map_mul, ← map_mul, ← map_sub, ← map_sub, (hytab j).2.2, map_zero]
      | inr u =>
        cases u
        change α_big Q_rel = 0
        simp only [Q_rel, C_2, A_20, A_11, A_02, map_add, map_sub, map_mul, map_pow, map_ofNat,
