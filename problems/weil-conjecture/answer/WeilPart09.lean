          have h_u0 : Ideal.Quotient.mk (𝔪₁ ^ 2) u₁ = 0 :=
            h_tmul_one_injective Ω₁ Ω₂ (L₁ ⧸ 𝔪₁ ^ 2) (h_tmul0.trans (TensorProduct.tmul_zero _ _).symm)
          exact hu₁_not_sq (Ideal.Quotient.eq_zero_iff_mem.mp h_u0)
        have hu₂_mem : u₂ ∈ 𝔪₂ := by rw [← hspan₂]; exact Ideal.subset_span (by simp)
        have hv₂_mem : v₂ ∈ 𝔪₂ := by rw [← hspan₂]; exact Ideal.subset_span (by simp)
        have h_decomp_m2 : ∀ m ∈ 𝔪₂, ∃ (c₁ c₂ : Ω₂) (z : L₂),
            z ∈ 𝔪₂ ^ 2 ∧ m = c₁ • u₂ + c₂ • v₂ + z := by
          intro m hm
          rw [← hspan₂, Ideal.mem_span_pair] at hm
          obtain ⟨x, y, rfl⟩ := hm
          let c₁ := ev_L₂ x
          let c₂ := ev_L₂ y
          have hx_sub : x - algebraMap Ω₂ L₂ c₁ ∈ 𝔪₂ := by
            rw [← hker_ev_L₂]
            change ev_L₂ (x - algebraMap Ω₂ L₂ c₁) = 0
            rw [map_sub, ev_L₂.commutes]
            exact sub_self _
          have hy_sub : y - algebraMap Ω₂ L₂ c₂ ∈ 𝔪₂ := by
            rw [← hker_ev_L₂]
            change ev_L₂ (y - algebraMap Ω₂ L₂ c₂) = 0
            rw [map_sub, ev_L₂.commutes]
            exact sub_self _
          let z := (x - algebraMap Ω₂ L₂ c₁) * u₂ + (y - algebraMap Ω₂ L₂ c₂) * v₂
          have hz_mem : z ∈ 𝔪₂ ^ 2 := by
            rw [sq]
            exact Submodule.add_mem _
              (Ideal.mul_mem_mul hx_sub hu₂_mem)
              (Ideal.mul_mem_mul hy_sub hv₂_mem)
          refine ⟨c₁, c₂, z, hz_mem, ?_⟩
          dsimp only [z]
          rw [Algebra.smul_def, Algebra.smul_def]
          ring
        let π₃₂_2 : (L₂ ⧸ 𝔪₂ ^ 3) →ₗ[Ω₂] (L₂ ⧸ 𝔪₂ ^ 2) :=
          (Ideal.Quotient.liftₐ (𝔪₂ ^ 3) (Ideal.Quotient.mkₐ Ω₂ (𝔪₂ ^ 2))
            (fun z hz => Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_le_pow_right (by norm_num) hz))).toLinearMap
        have h_surj_π2 : Function.Surjective π₃₂_2 := fun x => by
          obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
          exact ⟨Ideal.Quotient.mk (𝔪₂ ^ 3) z, rfl⟩
        have h_ker_π2_dim : Module.finrank Ω₂ (LinearMap.ker π₃₂_2) = 2 := by
          have hrk := LinearMap.finrank_range_add_finrank_ker π₃₂_2
          rw [LinearMap.range_eq_top.mpr h_surj_π2, finrank_top, h2_3, h3_5] at hrk
          omega
        have h_mem_ker_π2 : ∀ z ∈ 𝔪₂ ^ 2, mk2_3 z ∈ LinearMap.ker π₃₂_2 :=
          fun z hz => Ideal.Quotient.eq_zero_iff_mem.mpr hz
        let b_u2 : LinearMap.ker π₃₂_2 :=
          ⟨mk2_3 (u₂ ^ 2), h_mem_ker_π2 _ (Ideal.pow_mem_pow hu₂_mem 2)⟩
        let b_v2 : LinearMap.ker π₃₂_2 :=
          ⟨mk2_3 (v₂ ^ 2), h_mem_ker_π2 _ (Ideal.pow_mem_pow hv₂_mem 2)⟩
        let S_map : (Fin 2 → Ω₂) →ₗ[Ω₂] LinearMap.ker π₃₂_2 :=
          { toFun := fun c => c 0 • b_u2 + c 1 • b_v2
            map_add' := fun c d => by simp [add_smul]; abel
            map_smul' := fun a c => by simp [smul_add, mul_smul] }
        have h_12_m2 : 𝔪₂ * 𝔪₂ ^ 2 ≤ 𝔪₂ ^ 3 := by
          rw [pow_succ' 𝔪₂ 2]
        have hS_surj : Function.Surjective S_map := by
          rintro ⟨q_z, hq_z⟩
          obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective q_z
          have hz_sq : z ∈ 𝔪₂ ^ 2 := Ideal.Quotient.eq_zero_iff_mem.mp hq_z
          suffices h_gen : ∀ z ∈ 𝔪₂ ^ 2, ∃ c : Fin 2 → Ω₂,
              z - (c 0 • u₂ ^ 2 + c 1 • v₂ ^ 2) ∈ 𝔪₂ ^ 3 by
            obtain ⟨c, hc⟩ := h_gen z hz_sq
            refine ⟨c, Subtype.ext ?_⟩
            change c 0 • mk2_3 (u₂ ^ 2) + c 1 • mk2_3 (v₂ ^ 2) = mk2_3 z
            symm
            rw [← sub_eq_zero, ← map_smul, ← map_smul, ← map_add, ← map_sub]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr hc
          intro z₀ hz₀
          rw [sq] at hz₀
          refine Submodule.mul_induction_on hz₀ ?_ ?_
          · intro g₁ hg₁ g₂ hg₂
            obtain ⟨d₁, d₂, z₁, hz₁, rfl⟩ := h_decomp_m2 g₁ hg₁
            obtain ⟨d'₁, d'₂, z₂, hz₂, rfl⟩ := h_decomp_m2 g₂ hg₂
            refine ⟨![d₁ * d'₁, d₂ * d'₂], ?_⟩
            have h_alg : (d₁ • u₂ + d₂ • v₂ + z₁) * (d'₁ • u₂ + d'₂ • v₂ + z₂) -
                ((d₁ * d'₁) • u₂ ^ 2 + (d₂ * d'₂) • v₂ ^ 2) =
                (d₁ * d'₂ + d₂ * d'₁) • (u₂ * v₂) + (d₁ • u₂ + d₂ • v₂) * z₂ +
