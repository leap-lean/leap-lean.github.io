      have ht₁₁_not : t₁₁ ∉ q.asIdeal := t₁₁_sub.2
      have hD_cubic : t₁₁ * d_u * d_v - c₃₀ * d_u ^ 3 - c₀₃ * d_v ^ 3 = 0 := by
