    have hg₀_comm : ∀ r : R, g₀_ring (algebraMap R S r) = algebraMap R (B_k ⧸ I_k) r := by
      intro r
      change Ideal.Quotient.mk I_k (Ideal.Quotient.mk (𝔪_R ^ k) (algebraMap Ω R (res_R r))) =
        Ideal.Quotient.mk I_k (Ideal.Quotient.mk (𝔪_R ^ k) r)
      rw [Ideal.Quotient.eq]
      have h_mem : algebraMap Ω R (res_R r) - r ∈ 𝔪_R := by
        change res_R (algebraMap Ω R (res_R r) - r) = 0
        rw [map_sub, hres_R, sub_self]
      rw [← map_sub]
      exact Ideal.mem_map_of_mem _ h_mem
