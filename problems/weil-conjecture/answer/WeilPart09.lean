          (LinearMap.proj (R := Ω) (φ := fun _ : Fin 3 => Ω) 1).smulRight (q₂ (π (MvPolynomial.X 0))) +
          (LinearMap.proj (R := Ω) (φ := fun _ : Fin 3 => Ω) 2).smulRight (q₂ (π (MvPolynomial.X 1)))
