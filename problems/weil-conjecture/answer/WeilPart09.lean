    let g_tilde : S →ₐ[R] B_k := Algebra.FormallySmooth.lift I_k hIk_nil g₀
    have hg_tilde_mk : ∀ s : S, Ideal.Quotient.mk I_k (g_tilde s) = g₀ s :=
      Algebra.FormallySmooth.mk_lift I_k hIk_nil g₀
    have hg_tilde_m : Ideal.map g_tilde.toRingHom 𝔪_S ≤ I_k := by
      rw [Ideal.map_le_iff_le_comap]
      intro s hs
      have hs0 : res_S s = 0 := hs
      have h0 : Ideal.Quotient.mk I_k (g_tilde s) = 0 := by
        rw [hg_tilde_mk s]
        change Ideal.Quotient.mk I_k (Ideal.Quotient.mk (𝔪_R ^ k) (algebraMap Ω R (res_S s))) = 0
        rw [hs0, map_zero, map_zero, map_zero]
