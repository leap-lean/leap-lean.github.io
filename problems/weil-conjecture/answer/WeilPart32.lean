            (q : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 f)).asIdeal := by
        rw [← (q : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 f)).isPrime.pow_mem_iff_mem m hm, hPowEq]
      have h3 : HomogeneousLocalization.Away.isLocalizationElem hf hg ∈
            (q : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 f)).asIdeal ↔
          g ∈ (x : ProjectiveSpectrum 𝒜).asHomogeneousIdeal.toIdeal := by
        have hPre1 : (q ∈ (TopologicalSpace.Opens.map (AlgebraicGeometry.Proj.awayι 𝒜 f hf hm).base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜 g)) ↔
            (q : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 f)) ∈
              PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hf hg) := by
          rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 hf hm hg hm]
          rfl
        have hPre2 : (q ∈ (TopologicalSpace.Opens.map (AlgebraicGeometry.Proj.awayι 𝒜 f hf hm).base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜 g)) ↔
            x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 g := by
          change (AlgebraicGeometry.Proj.awayι 𝒜 f hf hm).base q ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 g ↔ _
          rw [hq_eq]
        have hBoProj : x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 g ↔
            g ∉ (x : ProjectiveSpectrum 𝒜).asHomogeneousIdeal.toIdeal :=
          AlgebraicGeometry.Proj.mem_basicOpen 𝒜 g x
        have hBoSpec : (q : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 f)) ∈
            PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hf hg) ↔
            HomogeneousLocalization.Away.isLocalizationElem hf hg ∉
              (q : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 f)).asIdeal :=
          PrimeSpectrum.mem_basicOpen _ _
        exact not_iff_not.mp ((hBoSpec.symm.trans hPre1.symm).trans (hPre2.trans hBoProj))
      have h4 : g ∈ (x : ProjectiveSpectrum 𝒜).asHomogeneousIdeal.toIdeal ↔
          a.1 ∈ (x : ProjectiveSpectrum 𝒜).asHomogeneousIdeal.toIdeal := by
        dsimp [g]
        exact ⟨fun hgf =>
          ((x : ProjectiveSpectrum 𝒜).isPrime.mul_mem_iff_mem_or_mem.mp hgf).resolve_right hf_not,
          fun ha => Ideal.mul_mem_right f _ ha⟩
      exact h1.trans (h2.trans (h3.trans h4))
    refine ⟨S_elim, fun ℓ => ?_⟩
    let 𝔪_ℓ : PrimeSpectrum R := ⟨RingHom.ker (MvPolynomial.eval ℓ), RingHom.ker_isPrime _⟩
    have hFiberIff : ∀ x : ↥(AlgebraicGeometry.Proj 𝒜),
        π₀.base x = PrimeSpectrum.comap inv₀ 𝔪_ℓ ↔
          ∀ r : R,
            (MvPolynomial.C r ∈ (x : ProjectiveSpectrum 𝒜).asHomogeneousIdeal.toIdeal ↔
              MvPolynomial.eval ℓ r = 0) := by
      intro x
      let y : PrimeSpectrum ↥(𝒜 0) := π₀.base x
      have hExt : y = PrimeSpectrum.comap inv₀ 𝔪_ℓ ↔
          ∀ a : ↥(𝒜 0), a ∈ y.asIdeal ↔ inv₀ a ∈ 𝔪_ℓ.asIdeal := by
        rw [PrimeSpectrum.ext_iff, SetLike.ext_iff]
        rfl
      change (y = PrimeSpectrum.comap inv₀ 𝔪_ℓ) ↔ _
      rw [hExt]
      constructor
      · intro h r
        have hr := h ⟨MvPolynomial.C r, MvPolynomial.isHomogeneous_C ι r⟩
        rw [hProjIdeal] at hr
        simpa [𝔪_ℓ, hinv₀_C] using hr
      · intro h a
        rw [hProjIdeal, hC_inv₀ a]
        exact h (inv₀ a)
    have hMemZero : (∀ f ∈ S_elim, MvPolynomial.eval ℓ f = 0) ↔ 𝔪_ℓ ∈ W_elim := by
      rw [hW_eq, PrimeSpectrum.mem_zeroLocus]
      rfl
    rw [hMemZero]
    constructor
    · rintro ⟨x, hx_V, hx_base⟩
      have hCoeffIff := (hFiberIff x).mp hx_base
      let P_x : Ideal A := x.asHomogeneousIdeal.toIdeal
      haveI : P_x.IsPrime := x.isPrime
      obtain ⟨i₀, hXi₀⟩ : ∃ i₀ : ι, (MvPolynomial.X i₀ : A) ∉ P_x := by
        by_contra hall
        push_neg at hall
        apply x.not_irrelevant_le
        rw [HomogeneousIdeal.irrelevant_le]
        intro m hm F hFm
        have hF_hom : F.IsHomogeneous m := hFm
        rw [F.as_sum]
        refine Ideal.sum_mem P_x fun d hd => ?_
        have hd_deg : ∑ i ∈ d.support, d i = m :=
          (Finsupp.degree_apply d).symm.trans
            ((hWeightDeg d).symm.trans (hF_hom (MvPolynomial.mem_support_iff.mp hd)))
        obtain ⟨i₀, hi₀_pos⟩ : ∃ i₀ : ι, 0 < d i₀ := by
          by_contra hall0
          push_neg at hall0
          have h0 : ∑ i ∈ d.support, d i = 0 :=
            Finset.sum_eq_zero fun i _ => Nat.le_zero.mp (hall0 i)
          omega
        let d' : ι →₀ ℕ := d - Finsupp.single i₀ 1
        have hd_eq : d' + Finsupp.single i₀ 1 = d := by
          ext j
          simp only [d', Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
            Finsupp.single_apply]
          by_cases hj : i₀ = j
          · subst hj; simp; omega
          · simp [hj]
        have hmon : (MvPolynomial.monomial d (F.coeff d) : A) =
            MvPolynomial.monomial d' (F.coeff d) * MvPolynomial.X i₀ := by
          rw [MvPolynomial.X, MvPolynomial.monomial_mul, mul_one, hd_eq]
        rw [hmon]
        exact Ideal.mul_mem_left P_x _ (hall i₀)
      let ι_k : MvPolynomial ι k →+* A := MvPolynomial.map MvPolynomial.C
      let 𝔭_k : Ideal (MvPolynomial ι k) := Ideal.comap ι_k P_x
      have hpk_prime : 𝔭_k.IsPrime := Ideal.IsPrime.comap ι_k
      have hXi₀_not_pk : (MvPolynomial.X i₀ : MvPolynomial ι k) ∉ 𝔭_k := by
        change ι_k (MvPolynomial.X i₀) ∉ P_x
        dsimp [ι_k]
        rw [MvPolynomial.map_X]
        exact hXi₀
      have hNotVan : (MvPolynomial.X i₀ : MvPolynomial ι k) ∉
          MvPolynomial.vanishingIdeal k (MvPolynomial.zeroLocus k 𝔭_k) := by
        rwa [MvPolynomial.vanishingIdeal_zeroLocus_eq_radical, hpk_prime.radical]
      rw [MvPolynomial.mem_vanishingIdeal_iff] at hNotVan
      push_neg at hNotVan
      rcases hNotVan with ⟨s, hs_zl, hs_i₀⟩
      have hs_ne : s ≠ 0 := by
        intro hs0
        rw [hs0] at hs_i₀
        simp at hs_i₀
      have hDiffMem : ∀ F : A, F - ι_k (MvPolynomial.map (MvPolynomial.eval ℓ) F) ∈ P_x := by
        intro F
        induction F using MvPolynomial.induction_on with
        | C r =>
          dsimp [ι_k]
          rw [MvPolynomial.map_C, MvPolynomial.map_C, ← map_sub]
          refine (hCoeffIff (r - MvPolynomial.C (MvPolynomial.eval ℓ r))).mpr ?_
          simp
        | add p q hp hq =>
          have heq : p + q - ι_k (MvPolynomial.map (MvPolynomial.eval ℓ) (p + q)) =
              (p - ι_k (MvPolynomial.map (MvPolynomial.eval ℓ) p)) +
                (q - ι_k (MvPolynomial.map (MvPolynomial.eval ℓ) q)) := by
            simp only [map_add]; ring
          rw [heq]
          exact Ideal.add_mem P_x hp hq
        | mul_X p i hp =>
          dsimp [ι_k]
          rw [map_mul, map_mul, MvPolynomial.map_X, MvPolynomial.map_X, ← sub_mul]
          exact Ideal.mul_mem_right _ P_x hp
      refine ⟨s, hs_ne, fun j => ?_⟩
      have hx_V' : (x : ProjectiveSpectrum 𝒜) ∈ ProjectiveSpectrum.zeroLocus 𝒜 (Set.range G) := hx_V
      have hGj_mem : G j ∈ P_x :=
        ((ProjectiveSpectrum.mem_zeroLocus 𝒜 (x : ProjectiveSpectrum 𝒜) (Set.range G)).mp hx_V') ⟨j, rfl⟩
      have hSub := Ideal.sub_mem P_x hGj_mem (hDiffMem (G j))
      rw [sub_sub_cancel] at hSub
      have hGj_pk : MvPolynomial.map (MvPolynomial.eval ℓ) (G j) ∈ 𝔭_k := hSub
      have haev := (MvPolynomial.mem_zeroLocus_iff.mp hs_zl) _ hGj_pk
      simpa [MvPolynomial.aeval_def, MvPolynomial.eval] using haev
    · rintro ⟨s, hs_ne, hs_eval⟩
      obtain ⟨i₀, hs_i₀⟩ : ∃ i₀ : ι, s i₀ ≠ 0 := Function.ne_iff.mp hs_ne
      let Ψ : A →+* Polynomial k :=
        MvPolynomial.eval₂Hom (Polynomial.C.comp (MvPolynomial.eval ℓ))
          (fun i : ι => Polynomial.C (s i) * Polynomial.X)
      have hProdMonomial : ∀ (S : Finset ι) (f_deg : ι → ℕ) (f_val : ι → k),
          (∏ i ∈ S, Polynomial.monomial (f_deg i) (f_val i)) =
            Polynomial.monomial (∑ i ∈ S, f_deg i) (∏ i ∈ S, f_val i) := by
        intro S f_deg f_val
        induction S using Finset.cons_induction with
        | empty => simp
        | cons a S ha ih =>
          rw [Finset.prod_cons, ih, Polynomial.monomial_mul_monomial,
            Finset.sum_cons, Finset.prod_cons]
      have hΨ_monomial : ∀ (m : ι →₀ ℕ) (r : R),
          Ψ (MvPolynomial.monomial m r) =
            Polynomial.monomial (Finsupp.degree m)
              (MvPolynomial.eval s (MvPolynomial.map (MvPolynomial.eval ℓ)
                (MvPolynomial.monomial m r))) := by
        intro m r
        dsimp [Ψ]
        rw [MvPolynomial.eval₂Hom_monomial, RingHom.comp_apply, Finsupp.prod]
        have hpow : ∀ i ∈ m.support,
            (Polynomial.C (s i) * Polynomial.X) ^ m i =
              Polynomial.monomial (m i) (s i ^ m i) := by
          intro i _
          rw [mul_pow, ← Polynomial.C_pow, Polynomial.C_mul_X_pow_eq_monomial]
        rw [Finset.prod_congr rfl hpow, hProdMonomial, ← Polynomial.monomial_zero_left,
          Polynomial.monomial_mul_monomial, zero_add, ← Finsupp.degree_apply,
          MvPolynomial.map_monomial, MvPolynomial.eval_monomial, Finsupp.prod]
      have hΨ_homog : ∀ {d : ℕ} {F : A}, F ∈ 𝒜 d →
          Ψ F = Polynomial.monomial d (MvPolynomial.eval s (MvPolynomial.map (MvPolynomial.eval ℓ) F)) := by
        intro d F hF
        have hF' : F.IsHomogeneous d := hF
        conv_lhs => rw [F.as_sum]
        conv_rhs => rw [F.as_sum]
        simp only [map_sum]
        refine Finset.sum_congr rfl fun m hm => ?_
        have hm_deg : Finsupp.degree m = d :=
          (hWeightDeg m).symm.trans (hF' (MvPolynomial.mem_support_iff.mp hm))
        rw [hΨ_monomial, hm_deg]
      let K_hom : Ideal A := RingHom.ker Ψ
      haveI : K_hom.IsPrime := RingHom.ker_isPrime Ψ
      have hHom_K : Ideal.IsHomogeneous 𝒜 K_hom := by
        intro i r hr
        rw [RingHom.mem_ker] at hr ⊢
        set d_fn := DirectSum.decompose 𝒜 r
        by_cases hi : i ∈ d_fn.support
        · have hsum := congrArg (fun p => Polynomial.coeff p i)
            ((congrArg Ψ (DirectSum.sum_support_decompose 𝒜 r)).trans hr)
          rw [Polynomial.coeff_zero, map_sum, Polynomial.finset_sum_coeff] at hsum
          have hcomp_i : MvPolynomial.eval s
              (MvPolynomial.map (MvPolynomial.eval ℓ) (d_fn i : A)) = 0 := by
            rw [← hsum]
            symm
            rw [Finset.sum_eq_single i]
            · rw [hΨ_homog (d_fn i).2, Polynomial.coeff_monomial, if_pos rfl]
            · intro d _ hd_ne
              rw [hΨ_homog (d_fn d).2, Polynomial.coeff_monomial, if_neg hd_ne]
            · intro hmem; exact absurd hi hmem
          rw [hΨ_homog (d_fn i).2, hcomp_i, Polynomial.monomial_zero_right]
        · have h0 : d_fn i = 0 := DFinsupp.notMem_support_iff.mp hi
          rw [h0, ZeroMemClass.coe_zero, map_zero]
      have hNotIrrel : ¬ HomogeneousIdeal.irrelevant 𝒜 ≤ ⟨K_hom, hHom_K⟩ := by
        intro hirr
        have hX_mem : (MvPolynomial.X i₀ : A) ∈ HomogeneousIdeal.irrelevant 𝒜 :=
          HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 zero_lt_one (MvPolynomial.isHomogeneous_X R i₀)
        have hX_ker : Ψ (MvPolynomial.X i₀) = 0 := hirr hX_mem
        have hX_val : Ψ (MvPolynomial.X i₀) = Polynomial.C (s i₀) * Polynomial.X := by
          dsimp [Ψ]
          rw [MvPolynomial.eval₂Hom_X']
        rw [hX_val] at hX_ker
        have hc1 := congrArg (fun p => Polynomial.coeff p 1) hX_ker
        simp at hc1
        exact hs_i₀ hc1
      let x_ps : ProjectiveSpectrum 𝒜 :=
        ProjectiveSpectrum.mk ⟨K_hom, hHom_K⟩ inferInstance hNotIrrel
      let x : ↥(AlgebraicGeometry.Proj 𝒜) := x_ps
      have hx_V : x_ps ∈ ProjectiveSpectrum.zeroLocus 𝒜 (Set.range G) := by
        rw [ProjectiveSpectrum.mem_zeroLocus]
        rintro _ ⟨j, rfl⟩
        change Ψ (G j) = 0
        rw [hΨ_homog (hHomog j), hs_eval j, Polynomial.monomial_zero_right]
      have hx_base : π₀.base x = PrimeSpectrum.comap inv₀ 𝔪_ℓ := by
        rw [hFiberIff]
        intro r
        change Ψ (MvPolynomial.C r) = 0 ↔ MvPolynomial.eval ℓ r = 0
        dsimp [Ψ]
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, Polynomial.C_eq_zero]
      exact ⟨x, hx_V, hx_base⟩

  
  let I_d (d : ℕ) : Type := ↥((Finset.univ : Finset (Fin 3)).finsuppAntidiag d)
  let P_ℓ (ℓ : σ → k) : MvPolynomial (Fin 3) k := MvPolynomial.map (MvPolynomial.eval ℓ) P_fam
  let 𝔪_ℓ (ℓ : σ → k) : PrimeSpectrum R :=
    ⟨RingHom.ker (MvPolynomial.eval ℓ), RingHom.ker_isPrime _⟩
  have hP_ℓ_homog : ∀ ℓ : σ → k, P_ℓ ℓ ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k D := by
    intro ℓ m hm_ne
    dsimp [P_ℓ] at hm_ne
    rw [MvPolynomial.coeff_map] at hm_ne
    have hfam_ne : P_fam.coeff m ≠ 0 := by
      intro h0; rw [h0, map_zero] at hm_ne; exact hm_ne rfl
    exact hHomog_fam hfam_ne
  let Z : I_d D → R := fun γ => P_fam.coeff γ.1
  let W_zero : Set (PrimeSpectrum R) := PrimeSpectrum.zeroLocus (Set.range Z)
  have hW_zero_iff : ∀ ℓ : σ → k, 𝔪_ℓ ℓ ∈ W_zero ↔ P_ℓ ℓ = 0 := by
    intro ℓ
    rw [PrimeSpectrum.mem_zeroLocus, Set.range_subset_iff]
    constructor
    · intro hZ
      ext m
      have h0 : (0 : MvPolynomial (Fin 3) k).coeff m = 0 := by simp
      rw [h0]
      by_cases hm : Finsupp.degree m = D
      · let γ : I_d D := ⟨m, (hMem_I D m).mpr hm⟩
        have hγ : MvPolynomial.eval ℓ (Z γ) = 0 := hZ γ
        simpa [P_ℓ, Z, MvPolynomial.coeff_map] using hγ
      · have hhom : (P_ℓ ℓ).IsHomogeneous D := hP_ℓ_homog ℓ
        by_contra hne
        exact hm ((hWeightDeg m).symm.trans (hhom hne))
    · intro hP0 γ
      change MvPolynomial.eval ℓ (P_fam.coeff γ.1) = 0
      rw [← MvPolynomial.coeff_map]
      change (P_ℓ ℓ).coeff γ.1 = 0
      rw [hP0]
      simp
  let ι_seg (d₁ : ℕ) : Type := I_d d₁ × I_d (D - d₁)
  let idx_seg (d₁ : ℕ) : Type :=
    (I_d d₁ × I_d d₁ × I_d (D - d₁) × I_d (D - d₁)) ⊕ (I_d D × I_d D)
  let deg_seg (d₁ : ℕ) : idx_seg d₁ → ℕ := Sum.elim (fun _ => 2) (fun _ => 1)
  let M_lin (d₁ : ℕ) (γ : I_d D) : MvPolynomial (ι_seg d₁) R :=
    ∑ p ∈ Finset.univ.filter (fun p : ι_seg d₁ => p.1.1 + p.2.1 = γ.1), MvPolynomial.X p
  let G_seg (d₁ : ℕ) : idx_seg d₁ → MvPolynomial (ι_seg d₁) R :=
    Sum.elim
      (fun q =>
        MvPolynomial.X (q.1, q.2.2.1) * MvPolynomial.X (q.2.1, q.2.2.2) -
          MvPolynomial.X (q.1, q.2.2.2) * MvPolynomial.X (q.2.1, q.2.2.1))
      (fun q =>
        MvPolynomial.C (Z q.1) * M_lin d₁ q.2 - MvPolynomial.C (Z q.2) * M_lin d₁ q.1)
  have hdeg_seg : ∀ (d₁ : ℕ) (j : idx_seg d₁), 1 ≤ deg_seg d₁ j := by
    intro d₁ j
    cases j <;> simp [deg_seg]
  have hHomog_seg : ∀ (d₁ : ℕ) (j : idx_seg d₁),
      G_seg d₁ j ∈ MvPolynomial.homogeneousSubmodule (ι_seg d₁) R (deg_seg d₁ j) := by
    intro d₁ j
    cases j with
    | inl q =>
      change _ ∈ MvPolynomial.homogeneousSubmodule (ι_seg d₁) R (1 + 1)
      exact Submodule.sub_mem _
        (MvPolynomial.IsHomogeneous.mul
          (MvPolynomial.isHomogeneous_X R _) (MvPolynomial.isHomogeneous_X R _))
        (MvPolynomial.IsHomogeneous.mul
          (MvPolynomial.isHomogeneous_X R _) (MvPolynomial.isHomogeneous_X R _))
    | inr q =>
      have hM : ∀ γ : I_d D, M_lin d₁ γ ∈ MvPolynomial.homogeneousSubmodule (ι_seg d₁) R 1 :=
        fun γ => Submodule.sum_mem _ fun p _ => MvPolynomial.isHomogeneous_X R p
      exact Submodule.sub_mem _
        (MvPolynomial.IsHomogeneous.C_mul (hM q.2) (Z q.1))
        (MvPolynomial.IsHomogeneous.C_mul (hM q.1) (Z q.2))
  have hElim_seg : ∀ d₁ : ℕ, ∃ S_elim : Set R,
      ∀ ℓ : σ → k,
        (∀ f ∈ S_elim, MvPolynomial.eval ℓ f = 0) ↔
          ∃ s : ι_seg d₁ → k, s ≠ 0 ∧
            ∀ j : idx_seg d₁,
              MvPolynomial.eval s (MvPolynomial.map (MvPolynomial.eval ℓ) (G_seg d₁ j)) = 0 :=
    fun d₁ => hPillar3 (ι_seg d₁) (idx_seg d₁) (deg_seg d₁) (G_seg d₁)
      (hdeg_seg d₁) (hHomog_seg d₁)
  let S_seg (d₁ : ℕ) : Set R := Classical.choose (hElim_seg d₁)
  have hS_seg_spec : ∀ (d₁ : ℕ) (ℓ : σ → k),
      𝔪_ℓ ℓ ∈ PrimeSpectrum.zeroLocus (S_seg d₁) ↔
        ∃ s : ι_seg d₁ → k, s ≠ 0 ∧
          ∀ j : idx_seg d₁,
            MvPolynomial.eval s (MvPolynomial.map (MvPolynomial.eval ℓ) (G_seg d₁ j)) = 0 := by
    intro d₁ ℓ
    rw [PrimeSpectrum.mem_zeroLocus]
    exact Classical.choose_spec (hElim_seg d₁) ℓ
  have hSeg_d₁_iff : ∀ d₁ ∈ Finset.Ico 1 D, ∀ ℓ : σ → k,
      𝔪_ℓ ℓ ∈ PrimeSpectrum.zeroLocus (S_seg d₁) ↔
        (P_ℓ ℓ = 0 ∨
          ∃ (A_hom B_hom : MvPolynomial (Fin 3) k),
            A_hom ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d₁ ∧
            B_hom ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k (D - d₁) ∧
            A_hom ≠ 0 ∧ B_hom ≠ 0 ∧ P_ℓ ℓ = A_hom * B_hom) := by
    intro d₁ hd₁ ℓ
    have hd_eq : d₁ + (D - d₁) = D := by
      have hlt := (Finset.mem_Ico.mp hd₁).2
      omega
    have hP2 := hPillar2 d₁ (D - d₁) D hd_eq (P_ℓ ℓ) (hP_ℓ_homog ℓ)
    dsimp only at hP2
    rw [hS_seg_spec d₁ ℓ, ← hP2]
    refine exists_congr fun s => and_congr_right fun _ => ?_
    rw [Sum.forall]
    refine and_congr ?_ ?_
    · constructor
      · intro h α₁ α₂ β₁ β₂
        simpa [G_seg] using h (α₁, α₂, β₁, β₂)
      · rintro h ⟨α₁, α₂, β₁, β₂⟩
        simpa [G_seg] using h α₁ α₂ β₁ β₂
    · constructor
      · intro h γ₁ γ₂
        simpa [G_seg, M_lin, Z, P_ℓ, MvPolynomial.coeff_map, map_sum] using h (γ₁, γ₂)
      · rintro h ⟨γ₁, γ₂⟩
        simpa [G_seg, M_lin, Z, P_ℓ, MvPolynomial.coeff_map, map_sum] using h γ₁ γ₂
  let W_red : Set (PrimeSpectrum R) :=
    W_zero ∪ ⋃ d₁ ∈ Finset.Ico 1 D, PrimeSpectrum.zeroLocus (S_seg d₁)
  have hClosed_red : IsClosed W_red :=
    IsClosed.union (PrimeSpectrum.isClosed_zeroLocus _)
      ((Finset.Ico 1 D).finite_toSet.isClosed_biUnion fun d₁ _ => PrimeSpectrum.isClosed_zeroLocus _)
  obtain ⟨S_red, hW_red⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus W_red).mp hClosed_red
  have hW_red_iff : ∀ ℓ : σ → k, 𝔪_ℓ ℓ ∈ W_red ↔ ¬ Irreducible (P_ℓ ℓ) := by
    intro ℓ
    rw [hPillar1 (P_ℓ ℓ) (hP_ℓ_homog ℓ)]
    dsimp [W_red]
    rw [Set.mem_union, Set.mem_iUnion₂, hW_zero_iff ℓ]
    constructor
    · rintro (h0 | ⟨d₁, hd₁, hmem⟩)
      · exact Or.inl h0
      · rcases (hSeg_d₁_iff d₁ hd₁ ℓ).mp hmem with h0 | hfac
        · exact Or.inl h0
        · exact Or.inr ⟨d₁, hd₁, hfac⟩
    · rintro (h0 | ⟨d₁, hd₁, hfac⟩)
      · exact Or.inl h0
      · exact Or.inr ⟨d₁, hd₁, (hSeg_d₁_iff d₁ hd₁ ℓ).mpr (Or.inr hfac)⟩
  have hStarNotMem : 𝔪_ℓ ℓ_star ∉ PrimeSpectrum.zeroLocus S_red := by
    rw [← hW_red, hW_red_iff ℓ_star, not_not]
    exact hIrred_star
  rw [PrimeSpectrum.mem_zeroLocus, Set.not_subset] at hStarNotMem
  rcases hStarNotMem with ⟨Δ_irred, hΔ_mem, hΔ_star_ne⟩
  refine ⟨Δ_irred, hΔ_star_ne, fun ℓ hℓ => ?_⟩
  by_contra hNotIrr
  have hMem : 𝔪_ℓ ℓ ∈ PrimeSpectrum.zeroLocus S_red := by
    rw [← hW_red]
    exact (hW_red_iff ℓ).mpr hNotIrr
  exact hℓ (hMem hΔ_mem)

theorem weil_algClosed_hypersurface_net_bertini_irreducible_poly (k : Type u) [Field k] [IsAlgClosed k] (M D : ℕ) (hM : 3 ≤ M) (hD : 1 ≤ D)
    (P_amb : MvPolynomial (Fin (M + 1)) k)
    (hHomog : P_amb ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k D)
    (hIrred : Irreducible P_amb) :
    ∃ (Δ_irred : MvPolynomial (Fin 3 × Fin (M + 1)) k),
      Δ_irred ≠ 0 ∧
      ∀ (ℓ : Fin 3 × Fin (M + 1) → k), MvPolynomial.eval ℓ Δ_irred ≠ 0 →
        let P_disc : MvPolynomial (Fin 3) k :=
          MvPolynomial.eval₂ MvPolynomial.C
            (fun μ : Fin (M + 1) =>
              ∑ r : Fin 3, MvPolynomial.C (ℓ (r, μ)) * MvPolynomial.X r)
            P_amb
        P_disc ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k D ∧
        Irreducible P_disc :=
by
  classical
  have hP_disc_homog : ∀ (ℓ : Fin 3 × Fin (M + 1) → k),
      MvPolynomial.eval₂ MvPolynomial.C
        (fun μ : Fin (M + 1) =>
          ∑ r : Fin 3, MvPolynomial.C (ℓ (r, μ)) * MvPolynomial.X r)
        P_amb ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k D := by
    intro ℓ
    change (MvPolynomial.eval₂ MvPolynomial.C _ P_amb).IsHomogeneous D
    have hP_amb_hom : P_amb.IsHomogeneous D := hHomog
    have hg_hom : ∀ μ : Fin (M + 1),
        (∑ r : Fin 3, MvPolynomial.C (ℓ (r, μ)) * MvPolynomial.X r).IsHomogeneous 1 := by
      intro μ
      change _ ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k 1
      refine Submodule.sum_mem _ fun r _ => ?_
      rw [← MvPolynomial.smul_eq_C_mul]
      exact Submodule.smul_mem _ (ℓ (r, μ)) (MvPolynomial.isHomogeneous_X k r)
    have h1 := hP_amb_hom.eval₂ (MvPolynomial.C : k →+* MvPolynomial (Fin 3) k) _
      (fun c => MvPolynomial.isHomogeneous_C (Fin 3) c) hg_hom
    rwa [one_mul] at h1
  rcases eq_or_lt_of_le hD with hD1 | hD2
  · subst hD1
    let a : Fin (M + 1) → k := fun μ => P_amb.coeff (Finsupp.single μ 1)
    have hCX_coeff : ∀ {σ_idx : Type} (c : k) (x : σ_idx) (m : σ_idx →₀ ℕ),
        (MvPolynomial.C c * MvPolynomial.X x).coeff m =
          if Finsupp.single x 1 = m then c else 0 := by
      intro σ_idx c x m
      rw [MvPolynomial.C_mul_X_eq_monomial, MvPolynomial.coeff_monomial]
    have hP_lin : P_amb = ∑ μ : Fin (M + 1), MvPolynomial.C (a μ) * MvPolynomial.X μ := by
      ext m
      rw [MvPolynomial.coeff_sum]
      simp_rw [hCX_coeff]
      by_cases hex : ∃ μ : Fin (M + 1), Finsupp.single μ 1 = m
      · obtain ⟨μ₀, rfl⟩ := hex
        rw [Finset.sum_eq_single μ₀]
        · simp [a]
        · intro μ _ hμ
          have hne : Finsupp.single μ (1 : ℕ) ≠ Finsupp.single μ₀ 1 :=
            fun heq => hμ (Finsupp.single_left_injective one_ne_zero heq)
          simp [hne]
        · intro hmem; exact absurd (Finset.mem_univ μ₀) hmem
      · simp only [not_exists] at hex
        simp only [hex, ↓reduceIte, Finset.sum_const_zero]
        have hP_hom1 : P_amb.IsHomogeneous 1 := hHomog
        by_contra hne0
        have hdeg : Finsupp.degree m = 1 := by
          by_contra hdeg_ne
          exact hne0 (hP_hom1.coeff_eq_zero hdeg_ne)
        have hsum : ∑ μ : Fin (M + 1), m μ = 1 := by
          rw [Finsupp.degree_apply] at hdeg
          exact (Finset.sum_subset (Finset.subset_univ m.support) fun x _ hx =>
            Finsupp.notMem_support_iff.mp hx).symm.trans hdeg
        obtain ⟨μ₀, _, hμ₀_pos⟩ : ∃ μ₀ ∈ (Finset.univ : Finset (Fin (M + 1))), 0 < m μ₀ := by
          by_contra hall0
          simp only [not_exists, not_and, not_lt, Nat.le_zero] at hall0
          have h0 : ∑ μ : Fin (M + 1), m μ = 0 :=
            Finset.sum_eq_zero fun μ hμ => hall0 μ hμ
          omega
        have hμ₀_le : m μ₀ ≤ 1 :=
          (Finset.single_le_sum (f := fun x => m x) (fun _ _ => Nat.zero_le _)
            (Finset.mem_univ μ₀)).trans_eq hsum
        have hμ₀_eq : m μ₀ = 1 := by omega
        apply hex μ₀
        ext ν
        by_cases hν : ν = μ₀
        · subst hν; simp [hμ₀_eq]
        · have hne_ν : μ₀ ≠ ν := Ne.symm hν
          simp only [Finsupp.single_apply, hne_ν, ↓reduceIte]
          by_contra hν_ne
          have hpair : m μ₀ + m ν ≤ ∑ x : Fin (M + 1), m x := by
            have hsub : ({μ₀, ν} : Finset (Fin (M + 1))) ⊆ Finset.univ := Finset.subset_univ _
            have hp := Finset.sum_le_sum_of_subset (f := fun x => m x) hsub
            rwa [Finset.sum_pair hne_ν] at hp
          omega
    obtain ⟨μ₀, hμ₀_ne⟩ : ∃ μ₀ : Fin (M + 1), a μ₀ ≠ 0 := by
      by_contra hall0
      simp only [not_exists, not_not] at hall0
      apply hIrred.ne_zero
      rw [hP_lin]
      exact Finset.sum_eq_zero fun μ _ => by simp [hall0 μ]
    let Δ_irred : MvPolynomial (Fin 3 × Fin (M + 1)) k :=
      ∑ μ : Fin (M + 1), MvPolynomial.C (a μ) * MvPolynomial.X ((0 : Fin 3), μ)
    have hΔ_ne : Δ_irred ≠ 0 := by
      intro h0
      have hev := congrArg (MvPolynomial.eval (Pi.single ((0 : Fin 3), μ₀) (1 : k))) h0
      simp only [Δ_irred, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, map_zero] at hev
      rw [Finset.sum_eq_single μ₀] at hev
      · simp only [Pi.single_eq_same, mul_one] at hev
        exact hμ₀_ne hev
      · intro μ _ hμ
        have hne : ((0 : Fin 3), μ) ≠ ((0 : Fin 3), μ₀) := fun h => hμ (Prod.ext_iff.mp h).2
        simp [Pi.single_eq_of_ne hne]
      · intro hmem; exact absurd (Finset.mem_univ μ₀) hmem
    refine ⟨Δ_irred, hΔ_ne, fun ℓ hℓ => ⟨hP_disc_homog ℓ, ?_⟩⟩
    set P_disc : MvPolynomial (Fin 3) k :=
      MvPolynomial.eval₂ MvPolynomial.C
        (fun μ : Fin (M + 1) => ∑ r : Fin 3, MvPolynomial.C (ℓ (r, μ)) * MvPolynomial.X r) P_amb
    have hcoeff0 : P_disc.coeff (Finsupp.single (0 : Fin 3) 1) =
        MvPolynomial.eval ℓ Δ_irred := by
      have hP_disc_eq : P_disc =
          ∑ r : Fin 3, MvPolynomial.C (∑ μ : Fin (M + 1), a μ * ℓ (r, μ)) * MvPolynomial.X r := by
        dsimp [P_disc]
        conv_lhs => rw [hP_lin]
        rw [MvPolynomial.eval₂_sum]
        simp only [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C, MvPolynomial.eval₂_X,
          Finset.mul_sum, ← mul_assoc, ← MvPolynomial.C_mul, map_sum, Finset.sum_mul]
        exact Finset.sum_comm
      rw [hP_disc_eq, MvPolynomial.coeff_sum]
      simp_rw [hCX_coeff]
      rw [Finset.sum_eq_single (0 : Fin 3)]
      · simp [Δ_irred]
      · intro r _ hr
        have hne : Finsupp.single r (1 : ℕ) ≠ Finsupp.single (0 : Fin 3) 1 :=
          fun heq => hr (Finsupp.single_left_injective one_ne_zero heq)
        simp [hne]
      · intro hmem; exact absurd (Finset.mem_univ _) hmem
    have hcoeff0_ne : P_disc.coeff (Finsupp.single (0 : Fin 3) 1) ≠ 0 := by
      rwa [hcoeff0]
    have hP_disc_ne : P_disc ≠ 0 := by
      intro h0
      rw [h0] at hcoeff0_ne
      exact hcoeff0_ne (by simp)
    have hP_disc_hom1 : P_disc.IsHomogeneous 1 := hP_disc_homog ℓ
    have hdeg1 : P_disc.totalDegree = 1 := hP_disc_hom1.totalDegree hP_disc_ne
    refine MvPolynomial.irreducible_of_totalDegree_eq_one hdeg1 fun x hx => ?_
    refine isUnit_iff_ne_zero.mpr fun hx0 => ?_
    have hdvd := hx (Finsupp.single (0 : Fin 3) 1)
    rw [hx0, zero_dvd_iff] at hdvd
    exact hcoeff0_ne hdvd
  · obtain ⟨r₀, rfl⟩ : ∃ r₀ : ℕ, M = r₀ + 3 := ⟨M - 3, (Nat.sub_add_cancel hM).symm⟩
    let r : ℕ := r₀ + 2
    have hr : 2 ≤ r := by omega
    obtain ⟨G, c₀, f, α, hc₀_ne, hα_inj, hP₁_hom, hP₁_e0, hP₁_irred,
      hf_eq, hf_monic, hf_deg, hf_ndvd, hf₀⟩ :=
      weil_algClosed_homog_irred_monic_separable_dehomog k r D hr hD2 P_amb hHomog hIrred
    let P₁ : MvPolynomial (Fin (r + 2)) k :=
      MvPolynomial.C c₀ *
        MvPolynomial.eval₂ MvPolynomial.C
          (fun μ : Fin (r + 2) =>
            ∑ ν : Fin (r + 2), MvPolynomial.C (G μ ν) * MvPolynomial.X ν)
          P_amb
    obtain ⟨ζ, hζ_hom, hζ_zero, hζ_cong, hζ_obs⟩ :=
      weil_truncated_homog_newton_subset_obstructions k r D hD2 f α
        hf_monic hf_deg hf_ndvd hα_inj hf₀
    obtain ⟨c, _, hPc_irred⟩ :=
      weil_ternary_slice_irred_of_newton_obstructions k r D hr hD2 P₁ hP₁_hom hP₁_e0
        f hf_eq α hα_inj hf₀ ζ hζ_hom hζ_zero hζ_cong hζ_obs
    let g_slice : Fin (r + 2) → MvPolynomial (Fin 3) k :=
      Fin.cons (MvPolynomial.X 0)
        (Fin.cons (MvPolynomial.X 1)
          (fun i : Fin r => MvPolynomial.C (c i) * MvPolynomial.X 2))
    let ℓ₁ : Fin (r + 2) → Fin 3 → k :=
      Fin.cons ![1, 0, 0] (Fin.cons ![0, 1, 0] (fun i : Fin r => ![0, 0, c i]))
    have hg_slice_eq : ∀ ν : Fin (r + 2),
        g_slice ν = ∑ b : Fin 3, MvPolynomial.C (ℓ₁ ν b) * MvPolynomial.X b := by
      intro ν
      refine Fin.cases ?_ (fun ν' => Fin.cases ?_ (fun i => ?_) ν') ν
      · simp [g_slice, ℓ₁, Fin.sum_univ_three]
      · simp [g_slice, ℓ₁, Fin.sum_univ_three]
      · simp [g_slice, ℓ₁, Fin.sum_univ_three]
    let ℓ_star : Fin 3 × Fin (r + 2) → k :=
      fun p => ∑ ν : Fin (r + 2), G p.2 ν * ℓ₁ ν p.1
    let P_c : MvPolynomial (Fin 3) k := MvPolynomial.eval₂ MvPolynomial.C g_slice P₁
    let P_disc_star : MvPolynomial (Fin 3) k :=
      MvPolynomial.eval₂ MvPolynomial.C
        (fun μ : Fin (r + 2) =>
          ∑ b : Fin 3, MvPolynomial.C (ℓ_star (b, μ)) * MvPolynomial.X b)
        P_amb
    have hPc_eq : P_c = MvPolynomial.C c₀ * P_disc_star := by
      let φ_slice : MvPolynomial (Fin (r + 2)) k →ₐ[k] MvPolynomial (Fin 3) k :=
        MvPolynomial.aeval g_slice
      let φ_G : MvPolynomial (Fin (r + 2)) k →ₐ[k] MvPolynomial (Fin (r + 2)) k :=
        MvPolynomial.aeval (fun μ : Fin (r + 2) =>
          ∑ ν : Fin (r + 2), MvPolynomial.C (G μ ν) * MvPolynomial.X ν)
      let φ_star : MvPolynomial (Fin (r + 2)) k →ₐ[k] MvPolynomial (Fin 3) k :=
        MvPolynomial.aeval (fun μ : Fin (r + 2) =>
          ∑ b : Fin 3, MvPolynomial.C (ℓ_star (b, μ)) * MvPolynomial.X b)
      have hcomp : φ_slice.comp φ_G = φ_star := by
        apply MvPolynomial.algHom_ext
        intro μ
        simp only [φ_slice, φ_G, φ_star, AlgHom.comp_apply, MvPolynomial.aeval_X,
          map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq, hg_slice_eq,
          Finset.mul_sum, Finset.sum_mul, mul_assoc, ℓ_star]
        exact Finset.sum_comm
      change φ_slice (MvPolynomial.C c₀ * φ_G P_amb) = MvPolynomial.C c₀ * φ_star P_amb
      rw [map_mul, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq,
        ← AlgHom.comp_apply, hcomp]
    let u_c : (MvPolynomial (Fin 3) k)ˣ :=
      ⟨MvPolynomial.C c₀⁻¹, MvPolynomial.C c₀,
        by rw [← MvPolynomial.C_mul, inv_mul_cancel₀ hc₀_ne, map_one],
        by rw [← MvPolynomial.C_mul, mul_inv_cancel₀ hc₀_ne, map_one]⟩
    have hAssoc : Associated P_c P_disc_star := by
      refine ⟨u_c, ?_⟩
      change P_c * MvPolynomial.C c₀⁻¹ = P_disc_star
      rw [hPc_eq, mul_comm (MvPolynomial.C c₀), mul_assoc, ← MvPolynomial.C_mul,
        mul_inv_cancel₀ hc₀_ne, map_one, mul_one]
    have hIrred_star : Irreducible P_disc_star := hAssoc.irreducible hPc_irred
    let σ := Fin 3 × Fin (r + 2)
    let R := MvPolynomial σ k
    let P_univ : MvPolynomial (Fin 3) R :=
      MvPolynomial.eval₂ (MvPolynomial.C.comp MvPolynomial.C)
        (fun μ : Fin (r + 2) =>
          ∑ b : Fin 3, MvPolynomial.C (MvPolynomial.X (b, μ)) * MvPolynomial.X b)
        P_amb
    have hPuniv_hom : P_univ ∈ MvPolynomial.homogeneousSubmodule (Fin 3) R D := by
      change P_univ.IsHomogeneous D
      have hP_amb_hom : P_amb.IsHomogeneous D := hHomog
      have hg_univ_hom : ∀ μ : Fin (r + 2),
          (∑ b : Fin 3,
            (MvPolynomial.C (MvPolynomial.X (b, μ)) : MvPolynomial (Fin 3) R) *
              MvPolynomial.X b).IsHomogeneous 1 := by
        intro μ
        change _ ∈ MvPolynomial.homogeneousSubmodule (Fin 3) R 1
        refine Submodule.sum_mem _ fun b _ => ?_
        rw [← MvPolynomial.smul_eq_C_mul]
        exact Submodule.smul_mem _ (MvPolynomial.X (b, μ)) (MvPolynomial.isHomogeneous_X R b)
      have h1 := hP_amb_hom.eval₂ (MvPolynomial.C.comp MvPolynomial.C : k →+* MvPolynomial (Fin 3) R) _
        (fun a_val => MvPolynomial.isHomogeneous_C (Fin 3) (MvPolynomial.C a_val)) hg_univ_hom
      rwa [one_mul] at h1
    have hMap_univ : ∀ ℓ : σ → k,
        MvPolynomial.map (MvPolynomial.eval ℓ) P_univ =
          MvPolynomial.eval₂ MvPolynomial.C
            (fun μ : Fin (r + 2) =>
              ∑ b : Fin 3, MvPolynomial.C (ℓ (b, μ)) * MvPolynomial.X b)
            P_amb := by
      intro ℓ
      let ψ₁ : MvPolynomial (Fin (r + 2)) k →+* MvPolynomial (Fin 3) k :=
        (MvPolynomial.map (MvPolynomial.eval ℓ)).comp
          (MvPolynomial.eval₂Hom (MvPolynomial.C.comp MvPolynomial.C)
            (fun μ : Fin (r + 2) =>
              ∑ b : Fin 3, MvPolynomial.C (MvPolynomial.X (b, μ)) * MvPolynomial.X b))
      let ψ₂ : MvPolynomial (Fin (r + 2)) k →+* MvPolynomial (Fin 3) k :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (fun μ : Fin (r + 2) =>
            ∑ b : Fin 3, MvPolynomial.C (ℓ (b, μ)) * MvPolynomial.X b)
      have hψ : ψ₁ = ψ₂ := by
        apply MvPolynomial.ringHom_ext
        · intro a_val
          simp [ψ₁, ψ₂]
        · intro μ
          simp [ψ₁, ψ₂]
      exact DFunLike.congr_fun hψ P_amb
    have hIrred_univ_star : Irreducible (MvPolynomial.map (MvPolynomial.eval ℓ_star) P_univ) := by
      rw [hMap_univ ℓ_star]
      exact hIrred_star
    obtain ⟨Δ_irred, hEval_star_ne, hOpen⟩ :=
      weil_algClosed_ternary_homog_irred_zariski_open k σ D hD P_univ hPuniv_hom
        ℓ_star hIrred_univ_star
    have hΔ_ne : Δ_irred ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hEval_star_ne
      exact hEval_star_ne rfl
    refine ⟨Δ_irred, hΔ_ne, fun ℓ hℓ => ⟨hP_disc_homog ℓ, ?_⟩⟩
    have hIrred_ℓ := hOpen ℓ hℓ
    rwa [hMap_univ ℓ] at hIrred_ℓ

theorem weil_algClosed_pencil_line_separable_and_avoid_bad_poly (k : Type u) [Field k] [IsAlgClosed k] (M D : ℕ) (hM : 3 ≤ M) (hD : 1 ≤ D)
    (P_amb : MvPolynomial (Fin (M + 1)) k)
    (hHomog : P_amb ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k D)
    (hIrred : Irreducible P_amb)
    (F_bad : Set (weilProjectiveSpaceOver k M).left)
    (hClosed_bad : IsClosed F_bad)
    (hDim_bad : topologicalKrullDim ↥F_bad + 2 ≤ (M : WithBot ℕ∞)) :
    ∃ (Δ_line : MvPolynomial (Fin 2 × Fin (M + 1)) k),
      Δ_line ≠ 0 ∧
      ∀ (ℓ₀₁ : Fin 2 × Fin (M + 1) → k), MvPolynomial.eval ℓ₀₁ Δ_line ≠ 0 →
        let ℓ_raw : Fin 2 → Fin (M + 1) → k := fun b μ => ℓ₀₁ (b, μ)
        let P_line : Polynomial k :=
          MvPolynomial.eval₂ Polynomial.C
            (fun μ : Fin (M + 1) =>
              Polynomial.C (ℓ_raw 0 μ) + Polynomial.C (ℓ_raw 1 μ) * Polynomial.X)
            P_amb
        MvPolynomial.eval (ℓ_raw 1) P_amb ≠ 0 ∧
        P_line.natDegree = D ∧
        P_line.Separable ∧
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
          MvPolynomial.gradedAlgebra
         ∀ (t : Fin 2 → k) (q : (weilProjectiveSpaceOver k M).left),
          t ≠ 0 →
          (∀ (G : MvPolynomial (Fin (M + 1)) k) (e : ℕ),
            G ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k e →
            (G ∈ ProjectiveSpectrum.asHomogeneousIdeal q ↔
              MvPolynomial.eval (fun μ => t 0 * ℓ_raw 0 μ + t 1 * ℓ_raw 1 μ) G = 0)) →
          q ∉ F_bad) :=
by
  classical
  haveI : Infinite k := IsAlgClosed.instInfinite

  
  
  
  have hSepPkg : ∃ (Δ_sep : MvPolynomial (Fin 2 × Fin (M + 1)) k),
      Δ_sep ≠ 0 ∧
      ∀ (ℓ₀₁ : Fin 2 × Fin (M + 1) → k), MvPolynomial.eval ℓ₀₁ Δ_sep ≠ 0 →
        let ℓ_raw : Fin 2 → Fin (M + 1) → k := fun b μ => ℓ₀₁ (b, μ)
        let P_line : Polynomial k :=
          MvPolynomial.eval₂ Polynomial.C
            (fun μ : Fin (M + 1) =>
              Polynomial.C (ℓ_raw 0 μ) + Polynomial.C (ℓ_raw 1 μ) * Polynomial.X)
            P_amb
        MvPolynomial.eval (ℓ_raw 1) P_amb ≠ 0 ∧
        P_line.natDegree = D ∧
        P_line.Separable := by
    have hP_hom : P_amb.IsHomogeneous D := hHomog

    have hLineCoeff : ∀ {A : Type u} [CommRing A] [Algebra k A]
        (a b : Fin (M + 1) → A) {n : ℕ} (H : MvPolynomial (Fin (M + 1)) k),
        H.IsHomogeneous n →
        let p : Polynomial A :=
          MvPolynomial.aeval
            (fun μ => Polynomial.C (a μ) + Polynomial.C (b μ) * Polynomial.X) H
        (∀ j : ℕ, n < j → p.coeff j = 0) ∧
        p.coeff n = MvPolynomial.aeval b H := by
      intro A _ _ a b n H hH
      have hMul : ∀ (p q : Polynomial A) (d₁ d₂ : ℕ),
          (∀ j, d₁ < j → p.coeff j = 0) →
          (∀ j, d₂ < j → q.coeff j = 0) →
          (∀ j, d₁ + d₂ < j → (p * q).coeff j = 0) ∧
          (p * q).coeff (d₁ + d₂) = p.coeff d₁ * q.coeff d₂ := by
        intro p q d₁ d₂ hp hq
        refine ⟨fun j hj => ?_, ?_⟩
        · rw [Polynomial.coeff_mul]
          refine Finset.sum_eq_zero fun x hx => ?_
          have hx_sum : x.1 + x.2 = j := by simpa using hx
          by_cases h1 : d₁ < x.1
          · rw [hp x.1 h1, zero_mul]
          · have h2 : d₂ < x.2 := by omega
            rw [hq x.2 h2, mul_zero]
        · rw [Polynomial.coeff_mul, Finset.sum_eq_single (d₁, d₂)]
          · intro x hx hne
            have hx_sum : x.1 + x.2 = d₁ + d₂ := by simpa using hx
            by_cases h1 : d₁ < x.1
            · rw [hp x.1 h1, zero_mul]
            · by_cases h2 : d₂ < x.2
              · rw [hq x.2 h2, mul_zero]
              · exfalso
                apply hne
                ext <;> dsimp <;> omega
          · intro hnot
            exfalso
            simp at hnot
      let g : Fin (M + 1) → Polynomial A :=
        fun μ => Polynomial.C (a μ) + Polynomial.C (b μ) * Polynomial.X
      have hg_gt : ∀ (μ : Fin (M + 1)) (j : ℕ), 1 < j → (g μ).coeff j = 0 := by
        intro μ j hj
        simp only [g, Polynomial.coeff_add, Polynomial.coeff_C, Polynomial.coeff_C_mul,
          Polynomial.coeff_X]
        have hj0 : j ≠ 0 := by omega
        have hj1 : 1 ≠ j := by omega
        simp [hj0, hj1]
      have hg_one : ∀ μ : Fin (M + 1), (g μ).coeff 1 = b μ := by
        intro μ
        simp [g, Polynomial.coeff_C, Polynomial.coeff_X]
      have hPow : ∀ (μ : Fin (M + 1)) (m : ℕ),
          (∀ j, m < j → ((g μ) ^ m).coeff j = 0) ∧
          ((g μ) ^ m).coeff m = (b μ) ^ m := by
        intro μ m
        induction m with
        | zero =>
          refine ⟨fun j hj => ?_, by simp⟩
          have hj0 : j ≠ 0 := by omega
          simp [Polynomial.coeff_one, hj0]
        | succ m ih =>
          obtain ⟨ih_gt, ih_eq⟩ := ih
          obtain ⟨hm_gt, hm_eq⟩ := hMul ((g μ) ^ m) (g μ) m 1 ih_gt (hg_gt μ)
          rw [← pow_succ] at hm_gt hm_eq
          refine ⟨hm_gt, ?_⟩
          rw [hm_eq, ih_eq, hg_one, pow_succ]
      have hProd : ∀ (s : Fin (M + 1) →₀ ℕ) (S : Finset (Fin (M + 1))),
          (∀ j, (∑ μ ∈ S, s μ) < j → (∏ μ ∈ S, (g μ) ^ (s μ)).coeff j = 0) ∧
          (∏ μ ∈ S, (g μ) ^ (s μ)).coeff (∑ μ ∈ S, s μ) = ∏ μ ∈ S, (b μ) ^ (s μ) := by
        intro s S
        induction S using Finset.induction_on with
        | empty =>
          refine ⟨fun j hj => ?_, by simp⟩
          simp only [Finset.sum_empty] at hj
          have hj0 : j ≠ 0 := by omega
          simp [Polynomial.coeff_one, hj0]
        | @insert μ₀ S' hnot ih =>
          obtain ⟨ih_gt, ih_eq⟩ := ih
          obtain ⟨hp_gt, hp_eq⟩ := hPow μ₀ (s μ₀)
          obtain ⟨hm_gt, hm_eq⟩ :=
            hMul ((g μ₀) ^ (s μ₀)) (∏ μ ∈ S', (g μ) ^ (s μ)) (s μ₀) (∑ μ ∈ S', s μ) hp_gt ih_gt
          rw [Finset.prod_insert hnot, Finset.sum_insert hnot]
          exact ⟨hm_gt, by rw [hm_eq, hp_eq, ih_eq, Finset.prod_insert hnot]⟩
      dsimp only
      rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq, MvPolynomial.aeval_def,
        MvPolynomial.eval₂_eq]
      have hC_alg : ∀ c : k,
          (algebraMap k (Polynomial A)) c = Polynomial.C ((algebraMap k A) c) :=
        fun c => IsScalarTower.algebraMap_apply k A (Polynomial A) c
      have hs_sum : ∀ s ∈ H.support, ∑ μ ∈ s.support, s μ = n := by
        intro s hs
        have hdeg : Finsupp.degree s = n := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp hs) (hH.coeff_eq_zero hne)
        rwa [Finsupp.degree_apply] at hdeg
      refine ⟨fun j hj => ?_, ?_⟩
      · rw [Polynomial.finset_sum_coeff]
        refine Finset.sum_eq_zero fun s hs => ?_
        rw [hC_alg, Polynomial.coeff_C_mul]
        have hj' : (∑ μ ∈ s.support, s μ) < j := by rw [hs_sum s hs]; exact hj
        rw [(hProd s s.support).1 j hj', mul_zero]
      · rw [Polynomial.finset_sum_coeff]
        refine Finset.sum_congr rfl fun s hs => ?_
        rw [hC_alg, Polynomial.coeff_C_mul, ← hs_sum s hs, (hProd s s.support).2]

    let R₂ := MvPolynomial (Fin 2 × Fin (M + 1)) k
    let X₀ : Fin (M + 1) → R₂ := fun μ => MvPolynomial.X (0, μ)
    let X₁ : Fin (M + 1) → R₂ := fun μ => MvPolynomial.X (1, μ)
    let P_gen : Polynomial R₂ :=
      MvPolynomial.aeval (fun μ => Polynomial.C (X₀ μ) + Polynomial.C (X₁ μ) * Polynomial.X) P_amb
    let C_D : R₂ := MvPolynomial.rename (fun μ : Fin (M + 1) => ((1 : Fin 2), μ)) P_amb
    let Δ_sep : R₂ :=
      C_D * Polynomial.resultant P_gen (Polynomial.derivative P_gen) D (D - 1)

    have hEval_Pgen : ∀ ℓ₀₁ : Fin 2 × Fin (M + 1) → k,
        Polynomial.map (MvPolynomial.eval ℓ₀₁) P_gen =
          MvPolynomial.eval₂ Polynomial.C
            (fun μ : Fin (M + 1) =>
              Polynomial.C (ℓ₀₁ (0, μ)) + Polynomial.C (ℓ₀₁ (1, μ)) * Polynomial.X)
            P_amb := by
      intro ℓ₀₁
      have hmap_eq : Polynomial.map (MvPolynomial.eval ℓ₀₁) P_gen =
          (Polynomial.mapAlgHom (MvPolynomial.aeval ℓ₀₁)) P_gen := by
        have hrh : MvPolynomial.eval ℓ₀₁ = (MvPolynomial.aeval ℓ₀₁).toRingHom := by
          apply MvPolynomial.ringHom_ext <;> intro x <;> simp
        rw [hrh]
        rfl
      rw [hmap_eq]
      let ψ₁ : MvPolynomial (Fin (M + 1)) k →ₐ[k] Polynomial k :=
        (Polynomial.mapAlgHom (MvPolynomial.aeval ℓ₀₁)).comp
          (MvPolynomial.aeval (fun μ => Polynomial.C (X₀ μ) + Polynomial.C (X₁ μ) * Polynomial.X))
      let ψ₂ : MvPolynomial (Fin (M + 1)) k →ₐ[k] Polynomial k :=
        MvPolynomial.aeval (fun μ : Fin (M + 1) =>
          Polynomial.C (ℓ₀₁ (0, μ)) + Polynomial.C (ℓ₀₁ (1, μ)) * Polynomial.X)
      have hψ : ψ₁ = ψ₂ := by
        apply MvPolynomial.algHom_ext
        intro μ
        simp [ψ₁, ψ₂, X₀, X₁]
      have happ := DFunLike.congr_fun hψ P_amb
      change (Polynomial.mapAlgHom (MvPolynomial.aeval ℓ₀₁)) P_gen = ψ₂ P_amb at happ
      rwa [MvPolynomial.aeval_def, Polynomial.algebraMap_eq] at happ

    have hSuff : ∀ (ℓ₀₁ : Fin 2 × Fin (M + 1) → k), MvPolynomial.eval ℓ₀₁ Δ_sep ≠ 0 →
        let ℓ_raw : Fin 2 → Fin (M + 1) → k := fun b μ => ℓ₀₁ (b, μ)
        let P_line : Polynomial k :=
          MvPolynomial.eval₂ Polynomial.C
            (fun μ : Fin (M + 1) =>
              Polynomial.C (ℓ_raw 0 μ) + Polynomial.C (ℓ_raw 1 μ) * Polynomial.X)
            P_amb
        MvPolynomial.eval (ℓ_raw 1) P_amb ≠ 0 ∧
        P_line.natDegree = D ∧
        P_line.Separable := by
      intro ℓ₀₁ hne ℓ_raw P_line
      have hCD_eval : MvPolynomial.eval ℓ₀₁ C_D = MvPolynomial.eval (ℓ_raw 1) P_amb := by
        dsimp [C_D, ℓ_raw]
        rw [MvPolynomial.eval_rename]
        rfl
      have hRes_eval : MvPolynomial.eval ℓ₀₁
          (Polynomial.resultant P_gen (Polynomial.derivative P_gen) D (D - 1)) =
          Polynomial.resultant P_line (Polynomial.derivative P_line) D (D - 1) := by
        rw [← Polynomial.resultant_map_map P_gen (Polynomial.derivative P_gen) D (D - 1)
          (MvPolynomial.eval ℓ₀₁), ← Polynomial.derivative_map, hEval_Pgen ℓ₀₁]
      dsimp only [Δ_sep] at hne
      rw [map_mul, hCD_eval, hRes_eval] at hne
      have hEval1_ne : MvPolynomial.eval (ℓ_raw 1) P_amb ≠ 0 := left_ne_zero_of_mul hne
      have hResD_ne : Polynomial.resultant P_line (Polynomial.derivative P_line) D (D - 1) ≠ 0 :=
        right_ne_zero_of_mul hne
      have hPline_aeval : P_line =
          MvPolynomial.aeval
            (fun μ => Polynomial.C (ℓ_raw 0 μ) + Polynomial.C (ℓ_raw 1 μ) * Polynomial.X) P_amb := by
        rw [MvPolynomial.aeval_def, Polynomial.algebraMap_eq]
      obtain ⟨hPline_gt, hPline_coeffD⟩ := hLineCoeff (ℓ_raw 0) (ℓ_raw 1) P_amb hP_hom
      rw [← hPline_aeval] at hPline_gt hPline_coeffD
      rw [MvPolynomial.aeval_def, Algebra.algebraMap_self] at hPline_coeffD
      change P_line.coeff D = MvPolynomial.eval (ℓ_raw 1) P_amb at hPline_coeffD
      have hPline_le : P_line.natDegree ≤ D :=
        Polynomial.natDegree_le_iff_coeff_eq_zero.mpr hPline_gt
      have hPline_deg : P_line.natDegree = D :=
        Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hPline_le
          (hPline_coeffD.symm ▸ hEval1_ne)
      have hPline_ne : P_line ≠ 0 := by
        intro h0
        rw [h0, Polynomial.natDegree_zero] at hPline_deg
        omega
      let n' := (Polynomial.derivative P_line).natDegree
      have hn'_le : n' ≤ D - 1 := by
        have h := Polynomial.natDegree_derivative_le P_line
        omega
      have hD1_eq : D - 1 = n' + (D - 1 - n') := (Nat.add_sub_of_le hn'_le).symm
      have hRes_pad : Polynomial.resultant P_line (Polynomial.derivative P_line) D (D - 1) =
          P_line.coeff D ^ (D - 1 - n') * P_line.resultant (Polynomial.derivative P_line) := by
        conv_lhs => rw [hD1_eq]
        rw [Polynomial.resultant_add_right_deg P_line (Polynomial.derivative P_line)
          D n' (D - 1 - n') (le_refl n')]
        congr 1
        change Polynomial.resultant P_line (Polynomial.derivative P_line) D n' =
          Polynomial.resultant P_line (Polynomial.derivative P_line)
            P_line.natDegree (Polynomial.derivative P_line).natDegree
        rw [hPline_deg]
      rw [hRes_pad] at hResD_ne
      have hRes_std_ne : P_line.resultant (Polynomial.derivative P_line) ≠ 0 :=
        right_ne_zero_of_mul hResD_ne
      have hSep : P_line.Separable := by
        rw [Polynomial.separable_def]
        by_contra hncop
        exact hRes_std_ne (Polynomial.resultant_eq_zero_iff.mpr ⟨Or.inl hPline_ne, hncop⟩)
      exact ⟨hEval1_ne, hPline_deg, hSep⟩

    
    have hExistsPderiv : ∃ μ₀ : Fin (M + 1), MvPolynomial.pderiv μ₀ P_amb ≠ 0 := by
      by_contra hall
      push Not at hall
      have hExpZero : ∀ d ∈ P_amb.support, ∀ μ : Fin (M + 1), (d μ : k) = 0 := by
        intro d hd μ
        rcases Nat.eq_zero_or_pos (d μ) with h0 | hpos
        · simp [h0]
        · let m : Fin (M + 1) →₀ ℕ := d - Finsupp.single μ 1
          have hm_add : m + Finsupp.single μ 1 = d := by
            ext j
            simp only [m, Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
              Finsupp.single_apply]
            by_cases hj : μ = j
            · subst hj; simp; omega
            · simp [hj]
          have hm_at : ((m μ : k) + 1) = (d μ : k) := by
            have hm_nat : m μ + 1 = d μ := by
              simp only [m, Finsupp.coe_tsub, Pi.sub_apply, Finsupp.single_eq_same]
              omega
            have hcast := congrArg (Nat.cast (R := k)) hm_nat
            simpa only [Nat.cast_add, Nat.cast_one] using hcast
          have hc := congrArg (fun q => q.coeff m) (hall μ)
          rw [MvPolynomial.coeff_pderiv, AddMonoidAlgebra.coeff_zero, hm_add, hm_at] at hc
          exact (mul_eq_zero.mp hc).resolve_left (MvPolynomial.mem_support_iff.mp hd)
      let p := ringChar k
      rcases CharP.char_is_prime_or_zero k p with hp | hp0
      · have hp2 : 2 ≤ p := hp.two_le
        have hdvd : ∀ d ∈ P_amb.support, ∀ μ : Fin (M + 1), p ∣ d μ :=
          fun d hd μ => (CharP.cast_eq_zero_iff k p (d μ)).mp (hExpZero d hd μ)
        have hRoot : ∀ d : Fin (M + 1) →₀ ℕ, ∃ r : k, r ^ p = P_amb.coeff d := by
          intro d
          let f_d : Polynomial k := Polynomial.X ^ p - Polynomial.C (P_amb.coeff d)
          have hf_deg : f_d.natDegree = p := by
            dsimp [f_d]
            rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt, Polynomial.natDegree_X_pow]
            rw [Polynomial.natDegree_X_pow]
            exact (Polynomial.natDegree_C _).trans_lt (by omega)
          have hf_ne : f_d ≠ 0 := by
            intro h0; rw [h0, Polynomial.natDegree_zero] at hf_deg; omega
          have hf_deg_ne : f_d.degree ≠ 0 := by
            rw [Polynomial.degree_eq_natDegree hf_ne, hf_deg]
            exact_mod_cast (by omega : p ≠ 0)
          obtain ⟨r, hr⟩ := IsAlgClosed.exists_root f_d hf_deg_ne
          refine ⟨r, ?_⟩
          simp only [f_d, Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow,
            Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hr
          exact hr
        let r_fn : (Fin (M + 1) →₀ ℕ) → k := fun d => Classical.choose (hRoot d)
        let Q : MvPolynomial (Fin (M + 1)) k :=
          ∑ d ∈ P_amb.support,
            MvPolynomial.monomial (d.mapRange (· / p) (Nat.zero_div p)) (r_fn d)
        have : CharP (MvPolynomial (Fin (M + 1)) k) p :=
          (RingHom.charP_iff_charP (algebraMap k (MvPolynomial (Fin (M + 1)) k)) p).mp inferInstance
        have : Fact (Nat.Prime p) := ⟨hp⟩
        have hQp : Q ^ p = P_amb := by
          rw [← frobenius_def p Q, map_sum]
          conv_rhs => rw [P_amb.as_sum]
          refine Finset.sum_congr rfl fun d hd => ?_
          rw [frobenius_def p, MvPolynomial.monomial_pow, Classical.choose_spec (hRoot d)]
          refine congrArg (fun s => MvPolynomial.monomial s (P_amb.coeff d)) ?_
          ext μ
          simp [Nat.mul_div_cancel' (hdvd d hd μ)]
        have hQP_mul : P_amb = Q * Q ^ (p - 1) := by
          rw [← hQp, ← pow_succ', show p - 1 + 1 = p by omega]
        rcases hIrred.isUnit_or_isUnit hQP_mul with hUQ | hUQp
        · exact hIrred.not_isUnit (hQp ▸ hUQ.pow p)
        · have hUQ : IsUnit Q := (isUnit_pow_iff (by omega : p - 1 ≠ 0)).mp hUQp
          exact hIrred.not_isUnit (hQp ▸ hUQ.pow p)
      · have hChar0 : CharP k 0 := hp0 ▸ inferInstance
        obtain ⟨d, hd⟩ : P_amb.support.Nonempty :=
          Finset.nonempty_iff_ne_empty.mpr (MvPolynomial.support_eq_empty.not.mpr hIrred.ne_zero)
        have hd_deg : Finsupp.degree d = D := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp hd) (hP_hom.coeff_eq_zero hne)
        have hd_ne : d ≠ 0 := by
          intro h0; rw [h0, map_zero] at hd_deg; omega
        obtain ⟨μ₀, hμ₀⟩ : ∃ μ₀ : Fin (M + 1), 0 < d μ₀ := by
          by_contra h0
          push Not at h0
          apply hd_ne
          ext μ; exact Nat.le_zero.mp (h0 μ)
        have hd0 : d μ₀ = 0 := by
          have := (@CharP.cast_eq_zero_iff k _ 0 hChar0 (d μ₀)).mp (hExpZero d hd μ₀)
          omega
        omega

    obtain ⟨μ₀, hμ₀_ne⟩ := hExistsPderiv
    have hNotAllZero_x : ¬ ∀ x : Fin (M + 1) → k,
        MvPolynomial.eval x (MvPolynomial.pderiv μ₀ P_amb) = 0 :=
      fun hall => hμ₀_ne (MvPolynomial.funext_iff.mpr fun x => by rw [hall x, map_zero])
    obtain ⟨x₀, hx₀⟩ := not_forall.mp hNotAllZero_x

    let L_dir : MvPolynomial (Fin (M + 1)) k :=
      ∑ μ : Fin (M + 1),
        MvPolynomial.C (MvPolynomial.eval x₀ (MvPolynomial.pderiv μ P_amb)) * MvPolynomial.X μ
    have hL_dir_ne : L_dir ≠ 0 := by
      intro h0
      have hev := congrArg (MvPolynomial.eval (Pi.single μ₀ (1 : k))) h0
      simp only [L_dir, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X,
        map_zero] at hev
      rw [Finset.sum_eq_single μ₀] at hev
      · simp only [Pi.single_eq_same, mul_one] at hev
        exact hx₀ hev
      · intro μ _ hne; simp [Pi.single_eq_of_ne hne]
      · intro hnot; exact absurd (Finset.mem_univ _) hnot

    have hProd_ne : P_amb * L_dir ≠ 0 := mul_ne_zero hIrred.ne_zero hL_dir_ne
    have hNotAllZero_b : ¬ ∀ b : Fin (M + 1) → k, MvPolynomial.eval b (P_amb * L_dir) = 0 :=
      fun hall => hProd_ne (MvPolynomial.funext_iff.mpr fun b => by rw [hall b, map_zero])
    obtain ⟨b, hb_prod⟩ := not_forall.mp hNotAllZero_b
    rw [map_mul] at hb_prod
    let c₀ : k := MvPolynomial.eval b P_amb
    have hc₀_ne : c₀ ≠ 0 := left_ne_zero_of_mul hb_prod
    have hb_dir : MvPolynomial.eval b L_dir ≠ 0 := right_ne_zero_of_mul hb_prod
    have hb_ne : b ≠ 0 := by
      intro hb0
      subst hb0
      simp [L_dir] at hb_dir
    obtain ⟨ν₀, hν₀⟩ : ∃ ν₀ : Fin (M + 1), b ν₀ ≠ 0 := by
      by_contra hall
      push Not at hall
      exact hb_ne (funext hall)

    
    let σ_fwd : MvPolynomial (Fin (M + 1)) k →ₐ[k] MvPolynomial (Fin (M + 1)) k :=
      MvPolynomial.aeval fun μ =>
        if μ = ν₀ then MvPolynomial.C (b ν₀) * MvPolynomial.X ν₀
        else MvPolynomial.X μ + MvPolynomial.C (b μ) * MvPolynomial.X ν₀
    let σ_inv : MvPolynomial (Fin (M + 1)) k →ₐ[k] MvPolynomial (Fin (M + 1)) k :=
      MvPolynomial.aeval fun μ =>
        if μ = ν₀ then MvPolynomial.C (b ν₀)⁻¹ * MvPolynomial.X ν₀
        else MvPolynomial.X μ - MvPolynomial.C (b μ * (b ν₀)⁻¹) * MvPolynomial.X ν₀
    have hσ_left : σ_inv.comp σ_fwd = AlgHom.id k _ := by
      apply MvPolynomial.algHom_ext
      intro μ
      simp only [AlgHom.comp_apply, AlgHom.id_apply, σ_fwd, σ_inv, MvPolynomial.aeval_X]
      split_ifs with h
      · subst h
        simp only [map_mul, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq,
          MvPolynomial.aeval_X, ↓reduceIte]
        rw [← mul_assoc, ← MvPolynomial.C_mul, mul_inv_cancel₀ hν₀, MvPolynomial.C_1, one_mul]
      · simp only [map_add, map_mul, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq,
          MvPolynomial.aeval_X, h, ↓reduceIte]
        ring
    have hσ_right : σ_fwd.comp σ_inv = AlgHom.id k _ := by
      apply MvPolynomial.algHom_ext
      intro μ
      simp only [AlgHom.comp_apply, AlgHom.id_apply, σ_fwd, σ_inv, MvPolynomial.aeval_X]
      split_ifs with h
      · subst h
        simp only [map_mul, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq,
          MvPolynomial.aeval_X, ↓reduceIte]
        rw [← mul_assoc, ← MvPolynomial.C_mul, inv_mul_cancel₀ hν₀, MvPolynomial.C_1, one_mul]
      · simp only [map_sub, map_mul, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq,
          MvPolynomial.aeval_X, h, ↓reduceIte]
        have hcancel : MvPolynomial.C (b μ) * MvPolynomial.C (b ν₀)⁻¹ *
            (MvPolynomial.C (b ν₀) * MvPolynomial.X ν₀) =
            MvPolynomial.C (b μ) * MvPolynomial.X ν₀ := by
          calc MvPolynomial.C (b μ) * MvPolynomial.C (b ν₀)⁻¹ *
                (MvPolynomial.C (b ν₀) * MvPolynomial.X ν₀)
              = MvPolynomial.C (b μ) *
                  (MvPolynomial.C (b ν₀)⁻¹ * MvPolynomial.C (b ν₀)) *
                  MvPolynomial.X ν₀ := by ring
            _ = MvPolynomial.C (b μ) * MvPolynomial.X ν₀ := by
                rw [← MvPolynomial.C_mul, inv_mul_cancel₀ hν₀, MvPolynomial.C_1, mul_one]
        rw [hcancel, add_sub_cancel_right]
    let σ_equiv : MvPolynomial (Fin (M + 1)) k ≃ₐ[k] MvPolynomial (Fin (M + 1)) k :=
      AlgEquiv.ofAlgHom σ_fwd σ_inv hσ_right hσ_left

    let Q_amb : MvPolynomial (Fin (M + 1)) k := σ_equiv P_amb
    have hQ_irred : Irreducible Q_amb :=
      (MulEquiv.irreducible_iff σ_equiv.toRingEquiv.toMulEquiv).mpr hIrred
    have hQ_hom : Q_amb.IsHomogeneous D := by
      have hg_hom : ∀ μ : Fin (M + 1),
          (if μ = ν₀ then MvPolynomial.C (b ν₀) * MvPolynomial.X ν₀
           else MvPolynomial.X μ + MvPolynomial.C (b μ) * MvPolynomial.X ν₀).IsHomogeneous 1 := by
        intro μ
        change _ ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1
        split_ifs
        · rw [← MvPolynomial.smul_eq_C_mul]
          exact Submodule.smul_mem _ (b ν₀) (MvPolynomial.isHomogeneous_X k ν₀)
        · refine Submodule.add_mem _ (MvPolynomial.isHomogeneous_X k μ) ?_
          rw [← MvPolynomial.smul_eq_C_mul]
          exact Submodule.smul_mem _ (b μ) (MvPolynomial.isHomogeneous_X k ν₀)
      have h1 := hP_hom.eval₂ (MvPolynomial.C : k →+* MvPolynomial (Fin (M + 1)) k) _
        (fun c => MvPolynomial.isHomogeneous_C _ c) hg_hom
      rw [one_mul] at h1
      change (σ_fwd P_amb).IsHomogeneous D
      dsimp only [σ_fwd]
      rwa [MvPolynomial.aeval_def, MvPolynomial.algebraMap_eq]

    have hDeriv_aeval : ∀ (v : Fin (M + 1) → Polynomial k) (F : MvPolynomial (Fin (M + 1)) k),
        Polynomial.derivative (MvPolynomial.aeval v F) =
          ∑ i : Fin (M + 1), MvPolynomial.aeval v (MvPolynomial.pderiv i F) *
            Polynomial.derivative (v i) := by
      intro v F
      induction F using MvPolynomial.induction_on with
      | C c =>
        simp only [MvPolynomial.aeval_C, Polynomial.algebraMap_eq, Polynomial.derivative_C,
          MvPolynomial.pderiv_C, map_zero, zero_mul, Finset.sum_const_zero]
      | add p q hp hq =>
        simp only [map_add, Polynomial.derivative_add, hp, hq, add_mul, Finset.sum_add_distrib]
      | mul_X p j hp =>
        simp only [map_mul, MvPolynomial.aeval_X, Polynomial.derivative_mul, hp,
          MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, Pi.single_apply]
        rw [Finset.sum_mul]
        simp only [map_add, map_mul, apply_ite (MvPolynomial.aeval v), map_one, map_zero,
          add_mul, mul_ite, mul_one, mul_zero, Finset.sum_add_distrib]
        congr 1
        · refine Finset.sum_congr rfl fun i _ => ?_
          rw [MvPolynomial.aeval_X]
          ring
        · simp only [ite_mul, zero_mul]
          rw [Finset.sum_ite_eq Finset.univ j]
          simp only [Finset.mem_univ, ↓reduceIte]

    have hEval_aeval_poly : ∀ (v : Fin (M + 1) → Polynomial k) (x : k)
        (F : MvPolynomial (Fin (M + 1)) k),
        (MvPolynomial.aeval v F).eval x = MvPolynomial.eval (fun i => (v i).eval x) F := by
      intro v x F
      let ψ₁ : MvPolynomial (Fin (M + 1)) k →ₐ[k] k :=
        (Polynomial.aeval x).comp (MvPolynomial.aeval v)
      let ψ₂ : MvPolynomial (Fin (M + 1)) k →ₐ[k] k :=
        MvPolynomial.aeval (fun i => (v i).eval x)
      have hψ : ψ₁ = ψ₂ := by
        apply MvPolynomial.algHom_ext
        intro i
        simp [ψ₁, ψ₂]
      exact DFunLike.congr_fun hψ F

    have hQpderiv_ne : MvPolynomial.pderiv ν₀ Q_amb ≠ 0 := by
      let y₀ : Fin (M + 1) → k := fun μ =>
        if μ = ν₀ then (b ν₀)⁻¹ * x₀ ν₀ else x₀ μ - b μ * (b ν₀)⁻¹ * x₀ ν₀
      let v_Q : Fin (M + 1) → Polynomial k := fun μ =>
        Polynomial.C (y₀ μ) + if μ = ν₀ then Polynomial.X else 0
      let v_P : Fin (M + 1) → Polynomial k := fun μ =>
        Polynomial.C (x₀ μ) + Polynomial.C (b μ) * Polynomial.X
      have hQP_line : MvPolynomial.aeval v_Q Q_amb = MvPolynomial.aeval v_P P_amb := by
        change ((MvPolynomial.aeval v_Q).comp σ_fwd) P_amb = MvPolynomial.aeval v_P P_amb
        congr 1
        apply MvPolynomial.algHom_ext
        intro μ
        simp only [AlgHom.comp_apply, σ_fwd, MvPolynomial.aeval_X]
        split_ifs with h
        · subst h
          simp only [map_mul, MvPolynomial.aeval_C, Polynomial.algebraMap_eq, MvPolynomial.aeval_X,
            v_Q, v_P, ↓reduceIte, mul_add]
          dsimp only [y₀]
          rw [if_pos rfl, ← Polynomial.C_mul, ← mul_assoc, mul_inv_cancel₀ hν₀, one_mul]
        · simp only [map_add, map_mul, MvPolynomial.aeval_C, Polynomial.algebraMap_eq,
            MvPolynomial.aeval_X, v_Q, v_P, h, ↓reduceIte, add_zero, mul_add]
          dsimp only [y₀]
          have hc_eq : x₀ μ - b μ * (b ν₀)⁻¹ * x₀ ν₀ + b μ * ((b ν₀)⁻¹ * x₀ ν₀) = x₀ μ := by ring
          rw [if_neg h, if_pos rfl, ← add_assoc, ← Polynomial.C_mul, ← Polynomial.C_add, hc_eq]
      have hd_eq := congrArg (fun p => (Polynomial.derivative p).eval 0) hQP_line
      rw [hDeriv_aeval v_Q Q_amb, hDeriv_aeval v_P P_amb] at hd_eq
      simp only [Polynomial.eval_finsetSum, Polynomial.eval_mul, hEval_aeval_poly] at hd_eq
      have hvQ0 : (fun i => (v_Q i).eval 0) = y₀ := by
        funext i; simp only [v_Q]; split_ifs <;> simp
      have hvP0 : (fun i => (v_P i).eval 0) = x₀ := by
        funext i; simp [v_P]
      rw [hvQ0, hvP0] at hd_eq
      have hLHS : (∑ i : Fin (M + 1), MvPolynomial.eval y₀ (MvPolynomial.pderiv i Q_amb) *
          (Polynomial.derivative (v_Q i)).eval 0) =
          MvPolynomial.eval y₀ (MvPolynomial.pderiv ν₀ Q_amb) := by
        rw [Finset.sum_eq_single ν₀]
        · simp [v_Q]
        · intro i _ hne; simp [v_Q, hne]
        · intro hnot; exact absurd (Finset.mem_univ _) hnot
      have hRHS : (∑ i : Fin (M + 1), MvPolynomial.eval x₀ (MvPolynomial.pderiv i P_amb) *
          (Polynomial.derivative (v_P i)).eval 0) = MvPolynomial.eval b L_dir := by
        simp only [v_P, Polynomial.derivative_add, Polynomial.derivative_C,
          Polynomial.derivative_C_mul, Polynomial.derivative_X, mul_one, zero_add,
          Polynomial.eval_C, L_dir, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
      rw [hLHS, hRHS] at hd_eq
      intro h0
      rw [h0, map_zero] at hd_eq
      exact hb_dir hd_eq.symm

    
    let S' := {μ : Fin (M + 1) // μ ≠ ν₀}
    let R' := MvPolynomial S' k
    let K' := FractionRing R'
    let e_opt : MvPolynomial (Fin (M + 1)) k ≃ₐ[k] Polynomial R' :=
      (MvPolynomial.renameEquiv k (Equiv.optionSubtypeNe ν₀).symm).trans
        (MvPolynomial.optionEquivLeft k S')
    have he_opt_X : ∀ μ : Fin (M + 1),
        e_opt (MvPolynomial.X μ) =
          if h : μ = ν₀ then Polynomial.X else Polynomial.C (MvPolynomial.X ⟨μ, h⟩) := by
      intro μ
      change (MvPolynomial.optionEquivLeft k S')
        ((MvPolynomial.renameEquiv k (Equiv.optionSubtypeNe ν₀).symm) (MvPolynomial.X μ)) = _
      rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
      by_cases h : μ = ν₀
      · subst h
        have hnone : (Equiv.optionSubtypeNe μ).symm μ = none := by
          rw [Equiv.symm_apply_eq]; rfl
        rw [dif_pos rfl, hnone]
        exact MvPolynomial.optionEquivLeft_X_none k S'
      · have hsome : (Equiv.optionSubtypeNe ν₀).symm μ = some ⟨μ, h⟩ := by
          rw [Equiv.symm_apply_eq]; rfl
        rw [dif_neg h, hsome]
        exact MvPolynomial.optionEquivLeft_X_some k S' ⟨μ, h⟩

    let F_uni : Polynomial R' := e_opt Q_amb
    have hF_uni_irred : Irreducible F_uni :=
      (MulEquiv.irreducible_iff e_opt.toRingEquiv.toMulEquiv).mpr hQ_irred

    have he_opt_deriv : ∀ F : MvPolynomial (Fin (M + 1)) k,
        Polynomial.derivative (e_opt F) = e_opt (MvPolynomial.pderiv ν₀ F) := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C c =>
        rw [MvPolynomial.pderiv_C, map_zero, ← MvPolynomial.algebraMap_eq, e_opt.commutes,
          IsScalarTower.algebraMap_apply k R' (Polynomial R'), Polynomial.algebraMap_eq,
          Polynomial.derivative_C]
      | add p q hp hq =>
        simp [map_add, hp, hq]
      | mul_X p μ hp =>
        simp only [map_mul, Polynomial.derivative_mul, hp, MvPolynomial.pderiv_mul,
          MvPolynomial.pderiv_X, Pi.single_apply, map_add, apply_ite e_opt, map_one, map_zero]
        have hdX : Polynomial.derivative (e_opt (MvPolynomial.X μ)) =
            if μ = ν₀ then 1 else 0 := by
          rw [he_opt_X μ]
          by_cases h : μ = ν₀
          · subst h; simp
          · simp [h]
        rw [hdX]

    have hDeriv_Funi_ne : Polynomial.derivative F_uni ≠ 0 := by
      dsimp [F_uni]
      rw [he_opt_deriv]
      intro h0
      exact hQpderiv_ne (e_opt.injective (h0.trans (map_zero e_opt).symm))

    let a_gen : Fin (M + 1) → R' := fun μ => if h : μ = ν₀ then 0 else MvPolynomial.X ⟨μ, h⟩
    let b_gen : Fin (M + 1) → R' := fun μ => if μ = ν₀ then 1 else 0
    have hF_uni_aeval : F_uni =
        MvPolynomial.aeval
          (fun μ => Polynomial.C (a_gen μ) + Polynomial.C (b_gen μ) * Polynomial.X) Q_amb := by
      let ψ₁ : MvPolynomial (Fin (M + 1)) k →ₐ[k] Polynomial R' := e_opt.toAlgHom
      let ψ₂ : MvPolynomial (Fin (M + 1)) k →ₐ[k] Polynomial R' :=
        MvPolynomial.aeval
          (fun μ => Polynomial.C (a_gen μ) + Polynomial.C (b_gen μ) * Polynomial.X)
      have hψ : ψ₁ = ψ₂ := by
        apply MvPolynomial.algHom_ext
        intro μ
        change e_opt (MvPolynomial.X μ) = _
        rw [he_opt_X μ, MvPolynomial.aeval_X]
        by_cases h : μ = ν₀ <;> simp [a_gen, b_gen, h]
      exact DFunLike.congr_fun hψ Q_amb

    obtain ⟨hF_uni_gt, hF_uni_coeffD⟩ := hLineCoeff a_gen b_gen Q_amb hQ_hom
    rw [← hF_uni_aeval] at hF_uni_gt hF_uni_coeffD
    have hb_gen_Q : MvPolynomial.aeval b_gen Q_amb = MvPolynomial.C c₀ := by
      have h1 : MvPolynomial.aeval b_gen Q_amb =
          (Algebra.ofId k R') (MvPolynomial.eval (fun μ => if μ = ν₀ then 1 else 0) Q_amb) := by
        let ψ₁ : MvPolynomial (Fin (M + 1)) k →ₐ[k] R' := MvPolynomial.aeval b_gen
        let ψ₂ : MvPolynomial (Fin (M + 1)) k →ₐ[k] R' :=
          (Algebra.ofId k R').comp
            (MvPolynomial.aeval (fun μ : Fin (M + 1) => if μ = ν₀ then (1 : k) else 0))
        have hψ : ψ₁ = ψ₂ := by
          apply MvPolynomial.algHom_ext
          intro μ
          simp only [ψ₁, ψ₂, AlgHom.comp_apply, MvPolynomial.aeval_X, Algebra.ofId_apply, b_gen]
          split_ifs <;> simp
        exact DFunLike.congr_fun hψ Q_amb
      have h2 : MvPolynomial.eval (fun μ => if μ = ν₀ then (1 : k) else 0) Q_amb = c₀ := by
        let ψ₁ : MvPolynomial (Fin (M + 1)) k →ₐ[k] k :=
          (MvPolynomial.aeval (fun μ : Fin (M + 1) => if μ = ν₀ then (1 : k) else 0)).comp σ_fwd
        let ψ₂ : MvPolynomial (Fin (M + 1)) k →ₐ[k] k := MvPolynomial.aeval b
        have hψ : ψ₁ = ψ₂ := by
          apply MvPolynomial.algHom_ext
          intro μ
          simp only [ψ₁, ψ₂, AlgHom.comp_apply, σ_fwd, MvPolynomial.aeval_X]
          split_ifs with h
          · subst h; simp
          · simp [h]
        exact DFunLike.congr_fun hψ P_amb
      rw [h1, h2, Algebra.ofId_apply, MvPolynomial.algebraMap_eq]
    rw [hb_gen_Q] at hF_uni_coeffD

    
    let u_c0 : (Polynomial R')ˣ :=
      { val := Polynomial.C (MvPolynomial.C c₀⁻¹)
        inv := Polynomial.C (MvPolynomial.C c₀)
        val_inv := by rw [← map_mul, ← map_mul, inv_mul_cancel₀ hc₀_ne, map_one, map_one]
        inv_val := by rw [← map_mul, ← map_mul, mul_inv_cancel₀ hc₀_ne, map_one, map_one] }
    let F_mon : Polynomial R' := (u_c0 : Polynomial R') * F_uni
    have hF_uni_mon_assoc : Associated F_uni F_mon := ⟨u_c0, mul_comm F_uni _⟩
    have hF_mon_irred : Irreducible F_mon := hF_uni_mon_assoc.irreducible hF_uni_irred
    have hF_mon_gt : ∀ j : ℕ, D < j → F_mon.coeff j = 0 := by
      intro j hj
      change (Polynomial.C (MvPolynomial.C c₀⁻¹) * F_uni).coeff j = 0
      rw [Polynomial.coeff_C_mul, hF_uni_gt j hj, mul_zero]
    have hF_mon_coeffD : F_mon.coeff D = 1 := by
      change (Polynomial.C (MvPolynomial.C c₀⁻¹) * F_uni).coeff D = 1
      rw [Polynomial.coeff_C_mul, hF_uni_coeffD, ← map_mul, inv_mul_cancel₀ hc₀_ne, map_one]
    have hF_mon_deg : F_mon.natDegree = D :=
      Polynomial.natDegree_eq_of_le_of_coeff_ne_zero
        (Polynomial.natDegree_le_iff_coeff_eq_zero.mpr hF_mon_gt)
        (hF_mon_coeffD.symm ▸ one_ne_zero)
    have hF_mon_monic : F_mon.Monic := by
      rw [Polynomial.Monic, Polynomial.leadingCoeff, hF_mon_deg, hF_mon_coeffD]

    have hFM_K_irred : Irreducible (F_mon.map (algebraMap R' K')) :=
      (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map hF_mon_monic).mp hF_mon_irred
    let F_K : Polynomial K' := F_uni.map (algebraMap R' K')
    let c_K : K' := algebraMap R' K' (MvPolynomial.C c₀)
    have hc_K_ne : c_K ≠ 0 := by
      intro h0
      have hcR : (MvPolynomial.C c₀ : R') = 0 :=
        IsFractionRing.injective R' K' (h0.trans (map_zero _).symm)
      have hc0_eq := congrArg MvPolynomial.constantCoeff hcR
      simp only [MvPolynomial.constantCoeff_C, map_zero] at hc0_eq
      exact hc₀_ne hc0_eq
    let u_cK : (Polynomial K')ˣ :=
      { val := Polynomial.C c_K
        inv := Polynomial.C c_K⁻¹
        val_inv := by rw [← map_mul, mul_inv_cancel₀ hc_K_ne, map_one]
        inv_val := by rw [← map_mul, inv_mul_cancel₀ hc_K_ne, map_one] }
    have hFK_assoc : Associated (F_mon.map (algebraMap R' K')) F_K := by
      refine ⟨u_cK, ?_⟩
      have hF_eq : F_uni = Polynomial.C (MvPolynomial.C c₀) * F_mon := by
        change F_uni = (u_c0⁻¹ : (Polynomial R')ˣ) * ((u_c0 : Polynomial R') * F_uni)
        rw [← mul_assoc, Units.inv_mul, one_mul]
      have hmap_eq := congrArg (Polynomial.map (algebraMap R' K')) hF_eq
      rw [Polynomial.map_mul, Polynomial.map_C] at hmap_eq
      change F_mon.map (algebraMap R' K') * Polynomial.C c_K = F_K
      rw [mul_comm]
      exact hmap_eq.symm
    have hFK_irred : Irreducible F_K := hFK_assoc.irreducible hFM_K_irred
    have hDeriv_FK_ne : Polynomial.derivative F_K ≠ 0 := by
      dsimp [F_K]
      rw [Polynomial.derivative_map]
      intro h0
      exact hDeriv_Funi_ne
        (Polynomial.map_injective _ (IsFractionRing.injective R' K')
          (h0.trans (Polynomial.map_zero _).symm))
    have hFK_sep : F_K.Separable :=
      (Polynomial.separable_iff_derivative_ne_zero hFK_irred).mpr hDeriv_FK_ne
    have hFK_res : F_K.resultant (Polynomial.derivative F_K) ≠ 0 :=
      Polynomial.resultant_ne_zero F_K (Polynomial.derivative F_K) hFK_sep
    have hFK_deg : F_K.natDegree = D := by
      refine Polynomial.natDegree_eq_of_le_of_coeff_ne_zero
        (Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun j hj => ?_) ?_
      · rw [Polynomial.coeff_map, hF_uni_gt j hj, map_zero]
      · rw [Polynomial.coeff_map, hF_uni_coeffD]
        exact hc_K_ne

    let ℛ : R' := Polynomial.resultant F_uni (Polynomial.derivative F_uni) D (D - 1)
    have hℛ_ne : ℛ ≠ 0 := by
      intro h0
      have hmap0 : algebraMap R' K' ℛ = 0 := by rw [h0, map_zero]
      dsimp only [ℛ] at hmap0
      rw [← Polynomial.resultant_map_map F_uni (Polynomial.derivative F_uni) D (D - 1)
        (algebraMap R' K'), ← Polynomial.derivative_map] at hmap0
      change Polynomial.resultant F_K (Polynomial.derivative F_K) D (D - 1) = 0 at hmap0
      let n_K := (Polynomial.derivative F_K).natDegree
      have hnK_le : n_K ≤ D - 1 := by
        have h := Polynomial.natDegree_derivative_le F_K
        omega
      have hD1_eq : D - 1 = n_K + (D - 1 - n_K) := (Nat.add_sub_of_le hnK_le).symm
      rw [hD1_eq, Polynomial.resultant_add_right_deg F_K (Polynomial.derivative F_K)
        D n_K (D - 1 - n_K) (le_refl n_K)] at hmap0
      have hstd : Polynomial.resultant F_K (Polynomial.derivative F_K) D n_K =
          F_K.resultant (Polynomial.derivative F_K) := by
        change Polynomial.resultant F_K (Polynomial.derivative F_K) D n_K =
          Polynomial.resultant F_K (Polynomial.derivative F_K)
            F_K.natDegree (Polynomial.derivative F_K).natDegree
        rw [hFK_deg]
      rw [hstd] at hmap0
      have hFK_coeffD : F_K.coeff D = c_K := by rw [Polynomial.coeff_map, hF_uni_coeffD]
      rw [hFK_coeffD] at hmap0
      exact mul_ne_zero (pow_ne_zero _ hc_K_ne) hFK_res hmap0

    have hNotAllZero_u : ¬ ∀ u' : S' → k, MvPolynomial.eval u' ℛ = 0 :=
      fun hall => hℛ_ne (MvPolynomial.funext_iff.mpr fun u' => by rw [hall u', map_zero])
    obtain ⟨u', hu'⟩ := not_forall.mp hNotAllZero_u
    let a₀ : Fin (M + 1) → k := fun μ => if h : μ = ν₀ then 0 else u' ⟨μ, h⟩
    let ℓ_star : Fin 2 × Fin (M + 1) → k := fun p =>
      if p.1 = 0 then a₀ p.2 else b p.2
    have hMap_u' : Polynomial.map (MvPolynomial.eval u') F_uni =
        MvPolynomial.eval₂ Polynomial.C
          (fun μ : Fin (M + 1) =>
            Polynomial.C (ℓ_star (0, μ)) + Polynomial.C (ℓ_star (1, μ)) * Polynomial.X)
          P_amb := by
      have hmap_eq : Polynomial.map (MvPolynomial.eval u') F_uni =
          (Polynomial.mapAlgHom (MvPolynomial.aeval u')) F_uni := by
        have hrh : MvPolynomial.eval u' = (MvPolynomial.aeval u').toRingHom := by
          apply MvPolynomial.ringHom_ext <;> intro x <;> simp
        rw [hrh]
        rfl
      rw [hmap_eq]
      let φ_u : MvPolynomial (Fin (M + 1)) k →ₐ[k] Polynomial k :=
        (Polynomial.mapAlgHom (MvPolynomial.aeval u')).comp e_opt.toAlgHom
      have hφ_u_C : ∀ c : k, φ_u (MvPolynomial.C c) = Polynomial.C c := by
        intro c
        rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, Polynomial.algebraMap_eq]
      have hφ_u_X : ∀ μ : Fin (M + 1),
          φ_u (MvPolynomial.X μ) =
            if h : μ = ν₀ then Polynomial.X else Polynomial.C (u' ⟨μ, h⟩) := by
        intro μ
        change Polynomial.map (MvPolynomial.aeval u').toRingHom (e_opt (MvPolynomial.X μ)) = _
        rw [he_opt_X μ]
        by_cases h : μ = ν₀
        · subst h; simp
        · simp only [dif_neg h, Polynomial.map_C]
          congr 1
          exact MvPolynomial.aeval_X u' ⟨μ, h⟩
      let ψ₁ : MvPolynomial (Fin (M + 1)) k →ₐ[k] Polynomial k := φ_u.comp σ_fwd
      let ψ₂ : MvPolynomial (Fin (M + 1)) k →ₐ[k] Polynomial k :=
        MvPolynomial.aeval (fun μ : Fin (M + 1) =>
          Polynomial.C (ℓ_star (0, μ)) + Polynomial.C (ℓ_star (1, μ)) * Polynomial.X)
      have hψ : ψ₁ = ψ₂ := by
        apply MvPolynomial.algHom_ext
        intro μ
        simp only [ψ₁, ψ₂, AlgHom.comp_apply, σ_fwd, MvPolynomial.aeval_X, ℓ_star,
          ↓reduceIte, show ¬ ((1 : Fin 2) = 0) by decide]
        by_cases h : μ = ν₀
        · subst h
          simp only [↓reduceIte, ↓reduceDIte, map_mul, hφ_u_C, hφ_u_X, a₀, Polynomial.C_0, zero_add]
        · simp only [h, ↓reduceIte, ↓reduceDIte, map_add, map_mul, hφ_u_C, hφ_u_X, a₀]
      have happ := DFunLike.congr_fun hψ P_amb
      change (Polynomial.mapAlgHom (MvPolynomial.aeval u')) F_uni = ψ₂ P_amb at happ
      rwa [MvPolynomial.aeval_def, Polynomial.algebraMap_eq] at happ

    have hΔ_sep_ne : Δ_sep ≠ 0 := by
      intro h0
      have hev := congrArg (MvPolynomial.eval ℓ_star) h0
      dsimp only [Δ_sep] at hev
      rw [map_mul, map_zero, ← Polynomial.resultant_map_map P_gen (Polynomial.derivative P_gen)
        D (D - 1) (MvPolynomial.eval ℓ_star), ← Polynomial.derivative_map,
        hEval_Pgen ℓ_star] at hev
      have hCD_star : MvPolynomial.eval ℓ_star C_D = c₀ := by
        dsimp [C_D, c₀]
        rw [MvPolynomial.eval_rename]
        congr 1
      have hRes_star : MvPolynomial.eval u' ℛ =
          Polynomial.resultant
            (MvPolynomial.eval₂ Polynomial.C
              (fun μ : Fin (M + 1) =>
                Polynomial.C (ℓ_star (0, μ)) + Polynomial.C (ℓ_star (1, μ)) * Polynomial.X) P_amb)
            (Polynomial.derivative
              (MvPolynomial.eval₂ Polynomial.C
                (fun μ : Fin (M + 1) =>
                  Polynomial.C (ℓ_star (0, μ)) + Polynomial.C (ℓ_star (1, μ)) * Polynomial.X) P_amb))
            D (D - 1) := by
        dsimp [ℛ]
        rw [← Polynomial.resultant_map_map F_uni (Polynomial.derivative F_uni) D (D - 1)
          (MvPolynomial.eval u'), ← Polynomial.derivative_map, hMap_u']
      rw [hCD_star, ← hRes_star] at hev
      exact mul_ne_zero hc₀_ne hu' hev

    exact ⟨Δ_sep, hΔ_sep_ne, hSuff⟩

  
  
  
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  letI : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra

  have hBertiniStep : ∀ (Y : Set (weilProjectiveSpaceOver k M).left), IsClosed Y →
      ∃ c₀ : Fin (M + 1) → k,
        let H := ∑ μ : Fin (M + 1), MvPolynomial.C (c₀ μ) * MvPolynomial.X μ
        IsClosed (Y ∩ {q : (weilProjectiveSpaceOver k M).left |
          H ∈ ProjectiveSpectrum.asHomogeneousIdeal q}) ∧
        topologicalKrullDim ↥(Y ∩ {q : (weilProjectiveSpaceOver k M).left |
          H ∈ ProjectiveSpectrum.asHomogeneousIdeal q}) + 1 ≤
          topologicalKrullDim ↥Y := by
    intro Y hY
    let ι_spec : ProjectiveSpectrum 𝒜_M → PrimeSpectrum (MvPolynomial (Fin (M + 1)) k) :=
      fun x => ⟨x.asHomogeneousIdeal.toIdeal, x.isPrime⟩
    have hInd_proj : Topology.IsInducing ι_spec := by
      rw [Topology.isInducing_iff]
      apply TopologicalSpace.ext_isClosed
      intro Z
      rw [isClosed_induced_iff]
      constructor
      · intro hZ
        obtain ⟨S, rfl⟩ := (ProjectiveSpectrum.isClosed_iff_zeroLocus 𝒜_M Z).mp hZ
        exact ⟨PrimeSpectrum.zeroLocus S, PrimeSpectrum.isClosed_zeroLocus S, rfl⟩
      · rintro ⟨W, hW, rfl⟩
        obtain ⟨S, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus W).mp hW
        exact ProjectiveSpectrum.isClosed_zeroLocus 𝒜_M S
    have hNoethProj : TopologicalSpace.NoetherianSpace (ProjectiveSpectrum 𝒜_M) :=
      Topology.IsInducing.noetherianSpace hInd_proj
    let Y_proj : Set (ProjectiveSpectrum 𝒜_M) := Y
    have hNoethY : TopologicalSpace.NoetherianSpace ↥Y_proj :=
      Topology.IsInducing.noetherianSpace Topology.IsInducing.subtypeVal
    have hFin_comp : (irreducibleComponents ↥Y_proj).Finite :=
      @TopologicalSpace.NoetherianSpace.finite_irreducibleComponents ↥Y_proj _ hNoethY
    let S_comp : Finset (Set ↥Y_proj) := hFin_comp.toFinset
    have hSubspace : ∀ C ∈ S_comp,
        ∃ V_C : Subspace k (Fin (M + 1) → k), V_C ≠ ⊤ ∧
          ∃ y_C ∈ C, ∀ c : Fin (M + 1) → k,
            (∑ μ, MvPolynomial.C (c μ) * MvPolynomial.X μ) ∈ y_C.1.asHomogeneousIdeal.toIdeal →
              c ∈ V_C := by
      intro C hC
      have hC_mem : C ∈ irreducibleComponents ↥Y_proj := hFin_comp.mem_toFinset.mp hC
      obtain ⟨y_C, hy_C⟩ := hC_mem.1.nonempty
      have hNotAllX : ¬ ∀ μ : Fin (M + 1),
          (MvPolynomial.X μ : MvPolynomial (Fin (M + 1)) k) ∈ y_C.1.asHomogeneousIdeal := by
        intro hall
        apply y_C.1.not_irrelevant_le
        rw [HomogeneousIdeal.irrelevant_le]
        intro i hi_pos F hFi
        have hF_hom : F.IsHomogeneous i := hFi
        rw [F.as_sum]
        refine Ideal.sum_mem _ fun d hd => ?_
        have hd_deg : Finsupp.degree d = i := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp hd) (hF_hom.coeff_eq_zero hne)
        obtain ⟨μ, hμ⟩ : ∃ μ : Fin (M + 1), 0 < d μ := by
          by_contra h0
          push Not at h0
          have hd0 : d = 0 := by ext μ; exact Nat.le_zero.mp (h0 μ)
          rw [hd0, map_zero] at hd_deg
          omega
        let d' : Fin (M + 1) →₀ ℕ := d - Finsupp.single μ 1
        have hd_eq : d' + Finsupp.single μ 1 = d := by
          ext j
          simp only [d', Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
            Finsupp.single_apply]
          by_cases hj : μ = j
          · subst hj; simp; omega
          · simp [hj]
        have hmon : MvPolynomial.monomial d (F.coeff d) =
            MvPolynomial.monomial d' (F.coeff d) * MvPolynomial.X μ := by
          rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, mul_one, hd_eq]
        rw [hmon]
        exact Ideal.mul_mem_left _ _ (hall μ)
      push Not at hNotAllX
      obtain ⟨μ₀, hμ₀⟩ := hNotAllX
      let I_y := y_C.1.asHomogeneousIdeal.toIdeal
      let V_C : Subspace k (Fin (M + 1) → k) :=
        { carrier := {c | (∑ μ, MvPolynomial.C (c μ) * MvPolynomial.X μ) ∈ I_y}
          add_mem' := fun {c₁ c₂} h₁ h₂ => by
            have heq : (∑ μ, MvPolynomial.C ((c₁ + c₂) μ) * MvPolynomial.X μ) =
                (∑ μ, MvPolynomial.C (c₁ μ) * MvPolynomial.X μ) +
                  (∑ μ, MvPolynomial.C (c₂ μ) * MvPolynomial.X μ) := by
              rw [← Finset.sum_add_distrib]
              refine Finset.sum_congr rfl fun μ _ => ?_
              simp only [Pi.add_apply, map_add, add_mul]
            change _ ∈ I_y
            rw [heq]
            exact I_y.add_mem h₁ h₂
          zero_mem' := by
            change (∑ μ : Fin (M + 1), MvPolynomial.C (0 : k) * MvPolynomial.X μ) ∈ I_y
            simp [I_y.zero_mem]
          smul_mem' := fun a {c} hc => by
            have heq : (∑ μ, MvPolynomial.C ((a • c) μ) * MvPolynomial.X μ) =
                MvPolynomial.C a * (∑ μ, MvPolynomial.C (c μ) * MvPolynomial.X μ) := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl fun μ _ => ?_
              simp only [Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc]
            change _ ∈ I_y
            rw [heq]
            exact I_y.mul_mem_left _ hc }
      have hV_ne : V_C ≠ ⊤ := by
        intro htop
        let v_s : Fin (M + 1) → k := Pi.single μ₀ 1
        have hmem : v_s ∈ V_C := htop ▸ Submodule.mem_top
        have hmem' : (∑ μ, MvPolynomial.C (v_s μ) * MvPolynomial.X μ) ∈ I_y := hmem
        rw [Finset.sum_eq_single μ₀] at hmem'
        · simp only [v_s, Pi.single_eq_same, map_one, one_mul] at hmem'
          exact hμ₀ hmem'
        · intro μ _ hne; simp [v_s, Pi.single_eq_of_ne hne]
        · intro hnot; exact absurd (Finset.mem_univ _) hnot
      exact ⟨V_C, hV_ne, y_C, hy_C, fun c hc => hc⟩
    let fV : Set ↥Y_proj → Subspace k (Fin (M + 1) → k) :=
      fun C => if hC : C ∈ S_comp then Classical.choose (hSubspace C hC) else ⊥
    have hTopNotMem : (⊤ : Subspace k (Fin (M + 1) → k)) ∉ S_comp.image fV := by
      intro hmem
      obtain ⟨C, hC, hEq⟩ := Finset.mem_image.mp hmem
      have hne : fV C ≠ ⊤ := by
        dsimp [fV]; rw [dite_cond_eq_true (eq_true hC)]; exact (Classical.choose_spec (hSubspace C hC)).1
      exact hne hEq
    have hNeUniv := Subspace.biUnion_ne_univ_of_top_notMem hTopNotMem
    obtain ⟨c₀, hc₀⟩ : ∃ c₀ : Fin (M + 1) → k, c₀ ∉ ⋃ p ∈ S_comp.image fV, (p : Set _) := by
      by_contra hall
      push Not at hall
      exact hNeUniv (Set.eq_univ_of_forall hall)
    let H : MvPolynomial (Fin (M + 1)) k := ∑ μ, MvPolynomial.C (c₀ μ) * MvPolynomial.X μ
    have hH_avoid : ∀ C ∈ irreducibleComponents ↥Y_proj,
        ∃ y_C ∈ C, H ∉ y_C.1.asHomogeneousIdeal := by
      intro C hC_comp
      have hC : C ∈ S_comp := hFin_comp.mem_toFinset.mpr hC_comp
      obtain ⟨_, y_C, hy_C, hImp⟩ := Classical.choose_spec (hSubspace C hC)
      refine ⟨y_C, hy_C, fun hHin => ?_⟩
      have hc_in : c₀ ∈ fV C := by
        dsimp [fV]; rw [dite_cond_eq_true (eq_true hC)]; exact hImp c₀ hHin
      exact hc₀ (Set.mem_biUnion (Finset.mem_image_of_mem fV hC) hc_in)
    let Z_H : Set (ProjectiveSpectrum 𝒜_M) := {q | H ∈ q.asHomogeneousIdeal}
    have hZH_eq : Z_H = ProjectiveSpectrum.zeroLocus 𝒜_M {H} := by
      ext q; simp [Z_H, ProjectiveSpectrum.mem_zeroLocus]
    have hZH_closed : IsClosed Z_H := hZH_eq ▸ ProjectiveSpectrum.isClosed_zeroLocus 𝒜_M {H}
    let Y'_proj : Set (ProjectiveSpectrum 𝒜_M) := Y_proj ∩ Z_H
    have hY'_closed : IsClosed (Y ∩ {q : (weilProjectiveSpaceOver k M).left |
        H ∈ ProjectiveSpectrum.asHomogeneousIdeal q}) := hY.inter hZH_closed
    refine ⟨c₀, hY'_closed, ?_⟩
    change topologicalKrullDim ↥Y'_proj + 1 ≤ topologicalKrullDim ↥Y_proj
    let ι : ↥Y'_proj → ↥Y_proj := fun z => ⟨z.1, z.2.1⟩
    have hι_inj : Function.Injective ι :=
      fun z₁ z₂ h => Subtype.ext (congrArg (Subtype.val : ↥Y_proj → _) h)
    have hι_cont : Continuous ι := Continuous.subtype_mk continuous_subtype_val (fun z => z.2.1)
    have hι_range : Set.range ι = Subtype.val ⁻¹' Z_H := by
      ext y
      exact ⟨by rintro ⟨z, rfl⟩; exact z.2.2, fun hy => ⟨⟨y.1, y.2, hy⟩, rfl⟩⟩
    have hRange_closed : IsClosed (Set.range ι) :=
      hι_range ▸ hZH_closed.preimage continuous_subtype_val
    let mapIC : TopologicalSpace.IrreducibleCloseds ↥Y'_proj →o
        TopologicalSpace.IrreducibleCloseds ↥Y_proj :=
      { toFun := fun Z =>
          { carrier := ι '' Z.carrier
            isIrreducible' := Z.isIrreducible.image ι hι_cont.continuousOn
            isClosed' := by
              obtain ⟨F₀, hF₀, hZ_eq⟩ := isClosed_induced_iff.mp Z.isClosed
              have himg : ι '' Z.carrier = (Subtype.val ⁻¹' F₀) ∩ Set.range ι := by
                ext y
                constructor
                · rintro ⟨z, hz, rfl⟩
                  have hz' : z ∈ (Z : Set ↥Y'_proj) := hz
                  rw [← hZ_eq] at hz'
                  exact ⟨hz', ⟨z, rfl⟩⟩
                · rintro ⟨hyF, z, rfl⟩
                  refine ⟨z, ?_, rfl⟩
                  change z ∈ (Z : Set ↥Y'_proj)
                  rw [← hZ_eq]
                  exact hyF
              rw [himg]
              exact (hF₀.preimage continuous_subtype_val).inter hRange_closed }
        monotone' := fun _ _ hle => Set.image_mono hle }
    have hmapIC_strict : StrictMono mapIC := by
      intro Z₁ Z₂ hlt
      rw [lt_iff_le_and_ne] at hlt ⊢
      refine ⟨mapIC.monotone hlt.1, fun hEq => hlt.2 ?_⟩
      ext z
      have hEqSet : ι '' Z₁.carrier = ι '' Z₂.carrier := congrArg (·.carrier) hEq
      exact ⟨fun hz => hlt.1 hz, fun hz => by
        have : ι z ∈ ι '' Z₁.carrier := hEqSet.symm ▸ ⟨z, hz, rfl⟩
        rcases this with ⟨z', hz', hzz'⟩
        rwa [← hι_inj hzz']⟩
    have hChainBound : ∀ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y'_proj),
        ((p.length + 1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥Y_proj := by
      intro p
      let p' : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y_proj) :=
        p.map mapIC hmapIC_strict
      obtain ⟨C, hC_comp, hSubC⟩ :=
        exists_mem_irreducibleComponents_subset_of_isIrreducible
          (p'.last).carrier (p'.last).isIrreducible
      let C_ic : TopologicalSpace.IrreducibleCloseds ↥Y_proj :=
        ⟨C, hC_comp.1, isClosed_of_mem_irreducibleComponents C hC_comp⟩
      obtain ⟨y_C, hy_C, hy_notH⟩ := hH_avoid C hC_comp
      have hlt_C : p'.last < C_ic := by
        rw [lt_iff_le_and_ne]
        refine ⟨hSubC, fun hEq => ?_⟩
        have hy_in : y_C ∈ (p'.last).carrier := hEq ▸ hy_C
        rcases hy_in with ⟨z, _, rfl⟩
        exact hy_notH z.2.2
      let q := p'.snoc C_ic hlt_C
      have hlen : q.length = p.length + 1 := by simp [q, p']
      rw [← hlen]
      exact Order.LTSeries.length_le_krullDim q
    by_cases hEmpty : IsEmpty (TopologicalSpace.IrreducibleCloseds ↥Y'_proj)
    · have hbot : topologicalKrullDim ↥Y'_proj = ⊥ := @Order.krullDim_eq_bot _ _ hEmpty
      rw [hbot]
      exact bot_le
    · obtain ⟨Z₀⟩ := not_isEmpty_iff.mp hEmpty
      have : Nonempty (TopologicalSpace.IrreducibleCloseds ↥Y'_proj) := ⟨Z₀⟩
      let p₀ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y'_proj) := RelSeries.singleton _ Z₀
      generalize hdY : topologicalKrullDim ↥Y_proj = dY
      cases dY using WithBot.recBotCoe with
      | bot =>
        have h0 := hChainBound p₀
        rw [hdY] at h0
        exact absurd h0 (by simp)
      | coe b =>
        cases b using WithTop.recTopCoe with
        | top =>
          generalize hdY' : topologicalKrullDim ↥Y'_proj = dY'
          cases dY' using WithBot.recBotCoe with
          | bot => exact bot_le
          | coe a => exact WithBot.coe_le_coe.mpr le_top
        | coe m =>
          have hm_pos : 1 ≤ m := by
            have h0 := hChainBound p₀
            rw [hdY] at h0
            have h0' : ((p₀.length + 1 : ℕ) : ℕ∞) ≤ (m : ℕ∞) := WithBot.coe_le_coe.mp h0
            have h0'' : p₀.length + 1 ≤ m := Nat.cast_le.mp h0'
            omega
          have hle_sub : topologicalKrullDim ↥Y'_proj ≤ ((m - 1 : ℕ) : WithBot ℕ∞) := by
            rw [topologicalKrullDim, Order.krullDim_eq_iSup_length]
            refine WithBot.coe_le_coe.mpr (iSup_le fun p => ?_)
            have hp := hChainBound p
            rw [hdY] at hp
            have hp' : ((p.length + 1 : ℕ) : ℕ∞) ≤ (m : ℕ∞) := WithBot.coe_le_coe.mp hp
            have hp'' : p.length + 1 ≤ m := Nat.cast_le.mp hp'
            have hp3 : p.length ≤ m - 1 := by omega
            exact Nat.cast_le.mpr hp3
          calc topologicalKrullDim ↥Y'_proj + 1
              ≤ ((m - 1 : ℕ) : WithBot ℕ∞) + 1 := by gcongr
            _ = ((m : ℕ) : WithBot ℕ∞) := by
                have hm_eq : (m - 1) + 1 = m := Nat.sub_add_cancel hm_pos
                rw [← hm_eq]
                push_cast
                rfl

  
  
  
  have hCutAndRay :
      (∃ (r : ℕ) (e : Fin r → ℕ) (G : Fin r → MvPolynomial (Fin (M + 1)) k),
        (∀ i : Fin r, G i ∈ 𝒜_M (e i)) ∧
        (∀ q : (weilProjectiveSpaceOver k M).left,
          q ∈ F_bad ↔ ∀ i : Fin r, G i ∈ ProjectiveSpectrum.asHomogeneousIdeal q)) ∧
      (∀ v : Fin (M + 1) → k, v ≠ 0 →
        ∃ q_v : (weilProjectiveSpaceOver k M).left,
          ∀ (H : MvPolynomial (Fin (M + 1)) k) (d : ℕ),
            H ∈ 𝒜_M d →
            (H ∈ ProjectiveSpectrum.asHomogeneousIdeal q_v ↔ MvPolynomial.eval v H = 0)) := by
    refine ⟨?_, ?_⟩
    · let F_proj : Set (ProjectiveSpectrum 𝒜_M) := F_bad
      obtain ⟨S, hS_eq⟩ := (ProjectiveSpectrum.isClosed_iff_zeroLocus 𝒜_M F_proj).mp hClosed_bad
      obtain ⟨B₀, hB₀_span⟩ := Ideal.fg_of_isNoetherianRing (Ideal.span S)
      let CompIdx := (b : ↥B₀) × ↥((DirectSum.decompose 𝒜_M b.1).support)
      let r := Fintype.card CompIdx
      let ε_r : Fin r ≃ CompIdx := (Fintype.equivFin CompIdx).symm
      let e : Fin r → ℕ := fun i => (ε_r i).2.1
      let G : Fin r → MvPolynomial (Fin (M + 1)) k :=
        fun i => ((DirectSum.decompose 𝒜_M (ε_r i).1.1) (ε_r i).2.1 : MvPolynomial (Fin (M + 1)) k)
      refine ⟨r, e, G, fun i => Subtype.prop _, fun q => ?_⟩
      let q' : ProjectiveSpectrum 𝒜_M := q
      change q' ∈ F_proj ↔ ∀ i : Fin r, G i ∈ q'.asHomogeneousIdeal
      rw [hS_eq, ProjectiveSpectrum.mem_zeroLocus]
      have hSpan_iff : (∀ f ∈ S, f ∈ q'.asHomogeneousIdeal) ↔
          (∀ f ∈ B₀, f ∈ q'.asHomogeneousIdeal) := by
        change S ⊆ (q'.asHomogeneousIdeal.toIdeal : Set (MvPolynomial (Fin (M + 1)) k)) ↔
          (B₀ : Set (MvPolynomial (Fin (M + 1)) k)) ⊆
            (q'.asHomogeneousIdeal.toIdeal : Set (MvPolynomial (Fin (M + 1)) k))
        rw [← Ideal.span_le, ← hB₀_span, Ideal.span_le]
      change (∀ f ∈ S, f ∈ q'.asHomogeneousIdeal) ↔ _
      rw [hSpan_iff]
      constructor
      · intro hB i
        exact q'.asHomogeneousIdeal.isHomogeneous (e i) (hB _ (ε_r i).1.2)
      · intro hG b hb
        change b ∈ q'.asHomogeneousIdeal.toIdeal
        rw [← DirectSum.sum_support_decompose 𝒜_M b]
        refine Ideal.sum_mem _ fun d hd => ?_
        let idx : CompIdx := ⟨⟨b, hb⟩, ⟨d, hd⟩⟩
        have hGi : G (ε_r.symm idx) = ((DirectSum.decompose 𝒜_M b) d : MvPolynomial _ k) := by
          dsimp [G]
          rw [Equiv.apply_symm_apply]
        rw [← hGi]
        exact hG (ε_r.symm idx)
    · intro v hv
      let ψ_v : MvPolynomial (Fin (M + 1)) k →+* Polynomial k :=
        MvPolynomial.eval₂Hom Polynomial.C (fun μ => Polynomial.C (v μ) * Polynomial.X)
      have hψ_hom : ∀ (d : ℕ) (H : MvPolynomial (Fin (M + 1)) k), H ∈ 𝒜_M d →
          ψ_v H = Polynomial.C (MvPolynomial.eval v H) * Polynomial.X ^ d := by
        intro d H hHd
        have hH : H.IsHomogeneous d := hHd
        dsimp [ψ_v]
        rw [MvPolynomial.eval₂_eq, MvPolynomial.eval_eq, map_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl fun s hs => ?_
        have hs_deg : ∑ μ ∈ s.support, s μ = d := by
          have hd' : Finsupp.degree s = d := by
            by_contra hne
            exact (MvPolynomial.mem_support_iff.mp hs) (hH.coeff_eq_zero hne)
          rwa [Finsupp.degree_apply] at hd'
        have hprod : (∏ μ ∈ s.support, (Polynomial.C (v μ) * Polynomial.X) ^ s μ) =
            Polynomial.C (∏ μ ∈ s.support, v μ ^ s μ) * Polynomial.X ^ d := by
          calc (∏ μ ∈ s.support, (Polynomial.C (v μ) * Polynomial.X) ^ s μ)
              = ∏ μ ∈ s.support, (Polynomial.C (v μ) ^ s μ * Polynomial.X ^ s μ) :=
                Finset.prod_congr rfl fun μ _ => mul_pow _ _ _
            _ = (∏ μ ∈ s.support, Polynomial.C (v μ) ^ s μ) *
                  (∏ μ ∈ s.support, Polynomial.X ^ s μ) := Finset.prod_mul_distrib
            _ = Polynomial.C (∏ μ ∈ s.support, v μ ^ s μ) *
                  Polynomial.X ^ (∑ μ ∈ s.support, s μ) := by
                rw [Finset.prod_pow_eq_pow_sum]
                congr 1
                rw [map_prod]
                exact Finset.prod_congr rfl fun μ _ => (map_pow Polynomial.C (v μ) (s μ)).symm
            _ = Polynomial.C (∏ μ ∈ s.support, v μ ^ s μ) * Polynomial.X ^ d := by rw [hs_deg]
        rw [hprod, Polynomial.C_mul, mul_assoc]
      let I_v : Ideal (MvPolynomial (Fin (M + 1)) k) := RingHom.ker ψ_v
      have hIv_prime : I_v.IsPrime := RingHom.ker_isPrime ψ_v
      have hIv_hom : Ideal.IsHomogeneous 𝒜_M I_v := by
        intro d f hf
        rw [RingHom.mem_ker] at hf ⊢
        by_cases hd : d ∈ (DirectSum.decompose 𝒜_M f).support
        · have hsum := congrArg ψ_v (DirectSum.sum_support_decompose 𝒜_M f)
          rw [hf, map_sum] at hsum
          have hcoeff := congrArg (fun p => p.coeff d) hsum
          simp only [Polynomial.coeff_zero, Polynomial.finsetSum_coeff] at hcoeff
          have hterm : ∀ n ∈ (DirectSum.decompose 𝒜_M f).support,
              (ψ_v ((DirectSum.decompose 𝒜_M f n : 𝒜_M n) : MvPolynomial _ k)).coeff d =
                if d = n then MvPolynomial.eval v ((DirectSum.decompose 𝒜_M f n : 𝒜_M n) : MvPolynomial _ k)
                else 0 := by
            intro n _
            rw [hψ_hom n _ (Subtype.prop _), Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
            split_ifs with hnd
            · simp
            · simp
          have hsingle : (∑ n ∈ (DirectSum.decompose 𝒜_M f).support,
              (ψ_v ((DirectSum.decompose 𝒜_M f n : 𝒜_M n) : MvPolynomial _ k)).coeff d) =
              MvPolynomial.eval v ((DirectSum.decompose 𝒜_M f d : 𝒜_M d) : MvPolynomial _ k) := by
            rw [Finset.sum_eq_single d]
            · rw [hterm d hd, if_pos rfl]
            · intro n hn hne; rw [hterm n hn, if_neg hne.symm]
            · intro hnot; exact absurd hd hnot
          rw [hsingle] at hcoeff
          rw [hψ_hom d _ (Subtype.prop _), hcoeff, map_zero, zero_mul]
        · have h0 : DirectSum.decompose 𝒜_M f d = 0 := DFinsupp.notMem_support_iff.mp hd
          rw [h0, Submodule.coe_zero, map_zero]
      obtain ⟨μ₀, hμ₀⟩ : ∃ μ₀ : Fin (M + 1), v μ₀ ≠ 0 := by
        by_contra hall
        push Not at hall
        exact hv (funext hall)
      have hNotIrrel : ¬ HomogeneousIdeal.irrelevant 𝒜_M ≤ ⟨I_v, hIv_hom⟩ := by
        intro hle
        have hXin : (MvPolynomial.X μ₀ : MvPolynomial (Fin (M + 1)) k) ∈
            HomogeneousIdeal.irrelevant 𝒜_M :=
          HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_M zero_lt_one (MvPolynomial.isHomogeneous_X k μ₀)
        have hXker : ψ_v (MvPolynomial.X μ₀) = 0 := RingHom.mem_ker.mp (hle hXin)
        have hc1 := congrArg (fun p => p.coeff 1) hXker
        rw [hψ_hom 1 _ (MvPolynomial.isHomogeneous_X k μ₀), pow_one, Polynomial.coeff_C_mul,
          Polynomial.coeff_X_one, mul_one, MvPolynomial.eval_X, Polynomial.coeff_zero] at hc1
        exact hμ₀ hc1
      let q_v : ProjectiveSpectrum 𝒜_M := ⟨⟨I_v, hIv_hom⟩, hIv_prime, hNotIrrel⟩
      refine ⟨q_v, fun H d hHd => ?_⟩
      change ψ_v H = 0 ↔ MvPolynomial.eval v H = 0
      rw [hψ_hom d H hHd, mul_eq_zero]
      have hXd_ne : (Polynomial.X ^ d : Polynomial k) ≠ 0 :=
        pow_ne_zero d Polynomial.X_ne_zero
      simp [hXd_ne, Polynomial.C_eq_zero]

  obtain ⟨⟨r, e, G, hG_hom, hG_iff⟩, hRayPt⟩ := hCutAndRay

  
  
  
  have hIterSlice : ∀ n : ℕ,
      ∃ c_seq : Fin n → Fin (M + 1) → k,
        let Y_n : Set (weilProjectiveSpaceOver k M).left :=
          F_bad ∩ {q | ∀ j : Fin n,
            (∑ μ, MvPolynomial.C (c_seq j μ) * MvPolynomial.X μ) ∈
              ProjectiveSpectrum.asHomogeneousIdeal q}
        IsClosed Y_n ∧
        topologicalKrullDim ↥Y_n + ((n : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥F_bad := by
    intro n
    induction n with
    | zero =>
      let c0_empty : Fin 0 → Fin (M + 1) → k := Fin.elim0
      refine ⟨c0_empty, ?_, ?_⟩
      · have heq : (F_bad ∩ {q : (weilProjectiveSpaceOver k M).left | ∀ j : Fin 0,
            (∑ μ, MvPolynomial.C (c0_empty j μ) * MvPolynomial.X μ) ∈
              ProjectiveSpectrum.asHomogeneousIdeal q}) = F_bad := by
          ext q; simp
        rw [heq]; exact hClosed_bad
      · have heq : (F_bad ∩ {q : (weilProjectiveSpaceOver k M).left | ∀ j : Fin 0,
            (∑ μ, MvPolynomial.C (c0_empty j μ) * MvPolynomial.X μ) ∈
              ProjectiveSpectrum.asHomogeneousIdeal q}) = F_bad := by
          ext q; simp
        rw [heq]
        change topologicalKrullDim ↥F_bad + (0 : WithBot ℕ∞) ≤ topologicalKrullDim ↥F_bad
        rw [add_zero]
    | succ n ih =>
      obtain ⟨c_seq, hClosed_n, hDim_n⟩ := ih
      let Y_n : Set (weilProjectiveSpaceOver k M).left :=
        F_bad ∩ {q | ∀ j : Fin n,
          (∑ μ, MvPolynomial.C (c_seq j μ) * MvPolynomial.X μ) ∈
            ProjectiveSpectrum.asHomogeneousIdeal q}
      obtain ⟨c_new, hClosed_next, hDim_next⟩ := hBertiniStep Y_n hClosed_n
      let c_seq' : Fin (n + 1) → Fin (M + 1) → k := Fin.snoc c_seq c_new
      have hSet_eq : (F_bad ∩ {q : (weilProjectiveSpaceOver k M).left | ∀ j : Fin (n + 1),
          (∑ μ, MvPolynomial.C (c_seq' j μ) * MvPolynomial.X μ) ∈
            ProjectiveSpectrum.asHomogeneousIdeal q}) =
          (Y_n ∩ {q : (weilProjectiveSpaceOver k M).left |
            (∑ μ, MvPolynomial.C (c_new μ) * MvPolynomial.X μ) ∈
              ProjectiveSpectrum.asHomogeneousIdeal q}) := by
        ext q
        simp only [Y_n, Set.mem_inter_iff, Set.mem_setOf_eq, Fin.forall_fin_succ',
          c_seq', Fin.snoc_castSucc, Fin.snoc_last, and_assoc]
      refine ⟨c_seq', ?_⟩
      dsimp only
      rw [hSet_eq]
      refine ⟨hClosed_next, ?_⟩
      let Y_next := Y_n ∩ {q : (weilProjectiveSpaceOver k M).left |
        (∑ μ, MvPolynomial.C (c_new μ) * MvPolynomial.X μ) ∈
          ProjectiveSpectrum.asHomogeneousIdeal q}
      change topologicalKrullDim ↥Y_next + ((n + 1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥F_bad
      generalize hd_next : topologicalKrullDim ↥Y_next = d_next
      cases d_next using WithBot.recBotCoe with
      | bot => exact bot_le
      | coe a =>
        generalize hd_n : topologicalKrullDim ↥Y_n = d_n
        cases d_n using WithBot.recBotCoe with
        | bot =>
          have h1 := hDim_next
          rw [hd_next, hd_n] at h1
          exact absurd h1 (by simp)
        | coe b =>
          generalize hd_bad : topologicalKrullDim ↥F_bad = d_bad
          cases d_bad using WithBot.recBotCoe with
          | bot =>
            have h2 := hDim_n
            rw [hd_n, hd_bad] at h2
            exact absurd h2 (by simp)
          | coe c =>
            have h1 := hDim_next
            rw [hd_next, hd_n] at h1
            have h2 := hDim_n
            rw [hd_n, hd_bad] at h2
            have h1' : a + 1 ≤ b := WithBot.coe_le_coe.mp h1
            have h2' : b + (n : ℕ∞) ≤ c := WithBot.coe_le_coe.mp h2
            refine WithBot.coe_le_coe.mpr ?_
            calc a + ((n + 1 : ℕ) : ℕ∞)
                = (a + 1) + (n : ℕ∞) := by push_cast; ring
              _ ≤ b + (n : ℕ∞) := by gcongr
              _ ≤ c := h2'

  obtain ⟨c_hyp, _, hDim_M1⟩ := hIterSlice (M - 1)
  let Y_M1 : Set (weilProjectiveSpaceOver k M).left :=
    F_bad ∩ {q | ∀ j : Fin (M - 1),
      (∑ μ, MvPolynomial.C (c_hyp j μ) * MvPolynomial.X μ) ∈
        ProjectiveSpectrum.asHomogeneousIdeal q}
  have hYM1_empty : Y_M1 = ∅ := by
    ext x
    simp only [Set.mem_empty_iff_false, iff_false]
    intro hx
    let y : ↥Y_M1 := ⟨x, hx⟩
    let Z_y : TopologicalSpace.IrreducibleCloseds ↥Y_M1 :=
      ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
    let p_y : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y_M1) :=
      RelSeries.singleton _ Z_y
    have h0_le : (0 : WithBot ℕ∞) ≤ topologicalKrullDim ↥Y_M1 :=
      Order.LTSeries.length_le_krullDim p_y
    generalize hd_M1 : topologicalKrullDim ↥Y_M1 = d_M1
    cases d_M1 using WithBot.recBotCoe with
    | bot =>
      rw [hd_M1] at h0_le
      exact absurd h0_le (by simp)
    | coe a =>
      generalize hd_bad : topologicalKrullDim ↥F_bad = d_bad
      cases d_bad using WithBot.recBotCoe with
      | bot =>
        have h1 := hDim_M1
        rw [hd_M1, hd_bad] at h1
        exact absurd h1 (by simp)
      | coe b =>
        have h1 := hDim_M1
        rw [hd_M1, hd_bad] at h1
        have h2 := hDim_bad
        rw [hd_bad] at h2
        have h1' : a + ((M - 1 : ℕ) : ℕ∞) ≤ b := WithBot.coe_le_coe.mp h1
        have h2' : b + 2 ≤ (M : ℕ∞) := WithBot.coe_le_coe.mp h2
        have h3 : (((M - 1) + 2 : ℕ) : ℕ∞) ≤ (M : ℕ∞) := by
          calc (((M - 1) + 2 : ℕ) : ℕ∞)
              = 0 + ((M - 1 : ℕ) : ℕ∞) + 2 := by push_cast; ring
            _ ≤ a + ((M - 1 : ℕ) : ℕ∞) + 2 := by
                have h0a : (0 : ℕ∞) ≤ a := zero_le
                gcongr
            _ ≤ b + 2 := by gcongr
            _ ≤ (M : ℕ∞) := h2'
        have h4 : (M - 1) + 2 ≤ M := Nat.cast_le.mp h3
        omega

  let Λ : (Fin (M + 1) → k) →ₗ[k] (Fin (M - 1) → k) :=
    { toFun := fun v j => ∑ μ : Fin (M + 1), c_hyp j μ * v μ
      map_add' := fun v₁ v₂ => by
        ext j
        simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
      map_smul' := fun a v => by
        ext j
        simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
        refine Finset.sum_congr rfl fun μ _ => by ring }
  have hKer_ge2 : 2 ≤ Module.finrank k ↥Λ.ker := by
    have hrk := LinearMap.finrank_range_add_finrank_ker Λ
    have hle := Submodule.finrank_le Λ.range
    rw [Module.finrank_fin_fun k] at hrk
    rw [Module.finrank_fin_fun k] at hle
    omega
  let b_ker := Module.finBasis k ↥Λ.ker
  let i₀ : Fin (Module.finrank k ↥Λ.ker) := ⟨0, by omega⟩
  let i₁ : Fin (Module.finrank k ↥Λ.ker) := ⟨1, by omega⟩
  let ℓ_wit : Fin 2 → Fin (M + 1) → k := ![(b_ker i₀).1, (b_ker i₁).1]

  have hWit : ∀ t : Fin 2 → k, t ≠ 0 →
      ∃ i : Fin r,
        MvPolynomial.eval (fun μ => t 0 * ℓ_wit 0 μ + t 1 * ℓ_wit 1 μ) (G i) ≠ 0 := by
    intro t ht_ne
    let w_ker : ↥Λ.ker := t 0 • b_ker i₀ + t 1 • b_ker i₁
    let v_t : Fin (M + 1) → k := fun μ => t 0 * ℓ_wit 0 μ + t 1 * ℓ_wit 1 μ
    have hvt_eq : v_t = w_ker.1 := rfl
    have hvt_ne : v_t ≠ 0 := by
      intro h0
      have hw0 : w_ker = 0 := Subtype.ext h0
      let emb01 : Fin 2 → Fin (Module.finrank k ↥Λ.ker) := ![i₀, i₁]
      have hemb_inj : Function.Injective emb01 := by
        intro a b hab
        fin_cases a <;> fin_cases b
        · rfl
        · exact absurd (congrArg Fin.val hab) (by simp [emb01, i₀, i₁])
        · exact absurd (congrArg Fin.val hab) (by simp [emb01, i₀, i₁])
        · rfl
      have hli := b_ker.linearIndependent.comp emb01 hemb_inj
      have hsum0 : ∑ b : Fin 2, t b • b_ker (emb01 b) = 0 := by
        rw [Fin.sum_univ_two]
        exact hw0
      have ht_all := Fintype.linearIndependent_iff.mp hli t hsum0
      exact ht_ne (funext ht_all)
    obtain ⟨q_vt, hq_vt⟩ := hRayPt v_t hvt_ne
    have hq_not_bad : q_vt ∉ F_bad := by
      intro hbad
      have hInYM1 : q_vt ∈ Y_M1 := by
        refine ⟨hbad, fun j => ?_⟩
        let H_j := ∑ μ : Fin (M + 1), MvPolynomial.C (c_hyp j μ) * MvPolynomial.X μ
        have hHj_hom : H_j ∈ 𝒜_M 1 := by
          refine Submodule.sum_mem (𝒜_M 1) fun μ _ => ?_
          rw [← MvPolynomial.smul_eq_C_mul]
          exact Submodule.smul_mem (𝒜_M 1) (c_hyp j μ) (MvPolynomial.isHomogeneous_X k μ)
        rw [hq_vt H_j 1 hHj_hom]
        have hker_j : (Λ w_ker.1) j = 0 := congrFun (LinearMap.mem_ker.mp w_ker.2) j
        simp only [H_j, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, ← hvt_eq]
        exact hker_j
      rw [hYM1_empty] at hInYM1
      exact hInYM1
    have hNotAllG : ¬ ∀ i : Fin r, G i ∈ ProjectiveSpectrum.asHomogeneousIdeal q_vt :=
      mt (hG_iff q_vt).mpr hq_not_bad
    obtain ⟨i, hi_not⟩ := not_forall.mp hNotAllG
    exact ⟨i, mt (hq_vt (G i) (e i) (hG_hom i)).mpr hi_not⟩

  
  
  
  have hAvoidPkg : ∃ (Δ_avoid : MvPolynomial (Fin 2 × Fin (M + 1)) k),
      Δ_avoid ≠ 0 ∧
      ∀ (ℓ₀₁ : Fin 2 × Fin (M + 1) → k), MvPolynomial.eval ℓ₀₁ Δ_avoid ≠ 0 →
        ∀ (t : Fin 2 → k), t ≠ 0 →
          ∃ i : Fin r,
            MvPolynomial.eval (fun μ => t 0 * ℓ₀₁ (0, μ) + t 1 * ℓ₀₁ (1, μ)) (G i) ≠ 0 := by
    let binForm : ∀ {A : Type u} [CommRing A] [Algebra k A],
        (Fin 2 → Fin (M + 1) → A) → MvPolynomial (Fin (M + 1)) k → MvPolynomial (Fin 2) A :=
      fun ℓ_A H =>
        MvPolynomial.aeval
          (fun μ => MvPolynomial.C (ℓ_A 0 μ) * MvPolynomial.X 0 +
            MvPolynomial.C (ℓ_A 1 μ) * MvPolynomial.X 1) H

    have hBinHom : ∀ {A : Type u} [CommRing A] [Algebra k A]
        (ℓ_A : Fin 2 → Fin (M + 1) → A) {d : ℕ} (H : MvPolynomial (Fin (M + 1)) k),
        H.IsHomogeneous d → (binForm ℓ_A H).IsHomogeneous d := by
      intro A _ _ ℓ_A d H hH
      have hg_hom : ∀ μ : Fin (M + 1),
          (MvPolynomial.C (ℓ_A 0 μ) * MvPolynomial.X (0 : Fin 2) +
            MvPolynomial.C (ℓ_A 1 μ) * MvPolynomial.X (1 : Fin 2)).IsHomogeneous 1 := by
        intro μ
        change _ ∈ MvPolynomial.homogeneousSubmodule (Fin 2) A 1
        refine Submodule.add_mem _ ?_ ?_
        · rw [← MvPolynomial.smul_eq_C_mul]
          exact Submodule.smul_mem _ (ℓ_A 0 μ) (MvPolynomial.isHomogeneous_X A 0)
        · rw [← MvPolynomial.smul_eq_C_mul]
          exact Submodule.smul_mem _ (ℓ_A 1 μ) (MvPolynomial.isHomogeneous_X A 1)
      have hc_hom : ∀ c : k,
          ((algebraMap k (MvPolynomial (Fin 2) A)) c).IsHomogeneous 0 := by
        intro c
        rw [IsScalarTower.algebraMap_apply k A (MvPolynomial (Fin 2) A)]
        exact MvPolynomial.isHomogeneous_C _ _
      have h1 := hH.eval₂ (algebraMap k (MvPolynomial (Fin 2) A)) _ hc_hom hg_hom
      rw [one_mul] at h1
      dsimp [binForm]
      rwa [MvPolynomial.aeval_def]

    have hBinEval : ∀ (ℓ : Fin 2 → Fin (M + 1) → k) (t : Fin 2 → k)
        (H : MvPolynomial (Fin (M + 1)) k),
        MvPolynomial.eval t (binForm ℓ H) =
          MvPolynomial.eval (fun μ => t 0 * ℓ 0 μ + t 1 * ℓ 1 μ) H := by
      intro ℓ t H
      let ψ₁ : MvPolynomial (Fin (M + 1)) k →ₐ[k] k :=
        (MvPolynomial.aeval t).comp
          (MvPolynomial.aeval fun μ =>
            MvPolynomial.C (ℓ 0 μ) * MvPolynomial.X (0 : Fin 2) +
              MvPolynomial.C (ℓ 1 μ) * MvPolynomial.X (1 : Fin 2))
      let ψ₂ : MvPolynomial (Fin (M + 1)) k →ₐ[k] k :=
        MvPolynomial.aeval fun μ => t 0 * ℓ 0 μ + t 1 * ℓ 1 μ
      have hψ : ψ₁ = ψ₂ := by
        apply MvPolynomial.algHom_ext
        intro μ
        simp only [ψ₁, ψ₂, AlgHom.comp_apply, MvPolynomial.aeval_X, map_add, map_mul,
          MvPolynomial.aeval_C, Algebra.algebraMap_self, RingHom.id_apply]
        ring
      exact DFunLike.congr_fun hψ H

    
    have hPowerX0 : ∀ (B : Fin r → MvPolynomial (Fin 2) k),
        (∀ i : Fin r, (B i).IsHomogeneous (e i)) →
        (∀ t : Fin 2 → k, t ≠ 0 → ∃ i : Fin r, MvPolynomial.eval t (B i) ≠ 0) →
        ∃ (K : ℕ) (U : Fin r → MvPolynomial (Fin 2) k),
          (∀ i : Fin r, e i ≤ K) ∧
          (∀ i : Fin r, (U i).IsHomogeneous (K - e i)) ∧
          ∑ i : Fin r, U i * B i = (MvPolynomial.X 0) ^ K := by
      intro B hB_hom hB_nz
      let h : Fin r → Polynomial k := fun i => MvPolynomial.aeval ![1, Polynomial.X] (B i)
      have hh_eval : ∀ (i : Fin r) (τ : k), (h i).eval τ = MvPolynomial.eval ![1, τ] (B i) := by
        intro i τ
        let ψ₁ : MvPolynomial (Fin 2) k →ₐ[k] k :=
          (Polynomial.aeval τ).comp (MvPolynomial.aeval ![1, Polynomial.X])
        let ψ₂ : MvPolynomial (Fin 2) k →ₐ[k] k := MvPolynomial.aeval ![1, τ]
        have hψ : ψ₁ = ψ₂ := by
          apply MvPolynomial.algHom_ext
          intro b
          fin_cases b <;> simp [ψ₁, ψ₂]
        exact DFunLike.congr_fun hψ (B i)
      have hh_no_root : ∀ τ : k, ∃ i : Fin r, (h i).eval τ ≠ 0 := by
        intro τ
        have ht_ne : (![1, τ] : Fin 2 → k) ≠ 0 := fun h0 => one_ne_zero (congrFun h0 0)
        obtain ⟨i, hi⟩ := hB_nz ![1, τ] ht_ne
        exact ⟨i, (hh_eval i τ).symm ▸ hi⟩
      let I₁ : Ideal (Polynomial k) := Ideal.span (Set.range h)
      have hI₁_top : (1 : Polynomial k) ∈ I₁ := by
        by_contra hnot1
        let g : Polynomial k := Submodule.IsPrincipal.generator I₁
        have hg_mem : ∀ i : Fin r, ∃ q : Polynomial k, h i = q * g := by
          intro i
          have hi : h i ∈ I₁ := Ideal.subset_span ⟨i, rfl⟩
          obtain ⟨q, hq⟩ := (Submodule.IsPrincipal.mem_iff_eq_smul_generator I₁).mp hi
          exact ⟨q, hq⟩
        by_cases hg0 : g = 0
        · obtain ⟨i, hi0⟩ := hh_no_root 0
          obtain ⟨q, hq⟩ := hg_mem i
          rw [hq, hg0, mul_zero, Polynomial.eval_zero] at hi0
          exact hi0 rfl
        · have hg_not_unit : ¬ IsUnit g := by
            intro hu
            obtain ⟨u, hu_eq⟩ := hu
            apply hnot1
            have hgen_in : (u : Polynomial k) ∈ I₁ :=
              hu_eq ▸ Submodule.IsPrincipal.generator_mem I₁
            have h1_eq : (↑u⁻¹ : Polynomial k) * (u : Polynomial k) = 1 := Units.inv_mul u
            exact h1_eq ▸ I₁.mul_mem_left _ hgen_in
          have hg_deg_ne : g.degree ≠ 0 :=
            mt Polynomial.isUnit_iff_degree_eq_zero.mpr hg_not_unit
          obtain ⟨τ₀, hτ₀⟩ := IsAlgClosed.exists_root g hg_deg_ne
          obtain ⟨i, hiτ⟩ := hh_no_root τ₀
          obtain ⟨q, hq⟩ := hg_mem i
          rw [hq, Polynomial.eval_mul, hτ₀, mul_zero] at hiτ
          exact hiτ rfl
      obtain ⟨u, hu_sum⟩ := (Submodule.mem_span_range_iff_exists_fun (Polynomial k)).mp hI₁_top
      let K : ℕ := ∑ i : Fin r, ((u i).natDegree + e i)
      have he_le : ∀ i : Fin r, e i ≤ K := by
        intro i
        have hle := Finset.single_le_sum (fun j _ => Nat.zero_le ((u j).natDegree + e j))
          (Finset.mem_univ i)
        omega
      have hu_lt : ∀ i : Fin r, (u i).natDegree < K - e i + 1 := by
        intro i
        have hle := Finset.single_le_sum (fun j _ => Nat.zero_le ((u j).natDegree + e j))
          (Finset.mem_univ i)
        omega
      let U : Fin r → MvPolynomial (Fin 2) k := fun i =>
        ∑ d ∈ Finset.range (K - e i + 1),
          MvPolynomial.C ((u i).coeff d) *
            (MvPolynomial.X 0) ^ (K - e i - d) * (MvPolynomial.X 1) ^ d
      have hU_hom : ∀ i : Fin r, (U i).IsHomogeneous (K - e i) := by
        intro i
        change U i ∈ MvPolynomial.homogeneousSubmodule (Fin 2) k (K - e i)
        refine Submodule.sum_mem _ fun d hd => ?_
        rw [Finset.mem_range] at hd
        have h1 : (MvPolynomial.C ((u i).coeff d) *
            (MvPolynomial.X (0 : Fin 2)) ^ (K - e i - d)).IsHomogeneous (K - e i - d) := by
          have hc := MvPolynomial.isHomogeneous_C (Fin 2) ((u i).coeff d)
          have hx := MvPolynomial.isHomogeneous_X_pow (R := k) (0 : Fin 2) (K - e i - d)
          simpa only [zero_add] using hc.mul hx
        have h2 := h1.mul (MvPolynomial.isHomogeneous_X_pow (R := k) (1 : Fin 2) d)
        have hadd : (K - e i - d) + d = K - e i := by omega
        rwa [hadd] at h2
      have hU_aeval : ∀ i : Fin r, MvPolynomial.aeval ![1, Polynomial.X] (U i) = u i := by
        intro i
        dsimp [U]
        rw [map_sum]
        conv_rhs => rw [Polynomial.as_sum_range' (u i) (K - e i + 1) (hu_lt i)]
        refine Finset.sum_congr rfl fun d _ => ?_
        simp only [map_mul, map_pow, MvPolynomial.aeval_C, Polynomial.algebraMap_eq,
          MvPolynomial.aeval_X, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
          one_pow, mul_one, Polynomial.C_mul_X_pow_eq_monomial]
      let Q₀ : MvPolynomial (Fin 2) k := ∑ i : Fin r, U i * B i
      have hQ₀_hom : Q₀.IsHomogeneous K := by
        change Q₀ ∈ MvPolynomial.homogeneousSubmodule (Fin 2) k K
        refine Submodule.sum_mem _ fun i _ => ?_
        have hprod := (hU_hom i).mul (hB_hom i)
        rwa [Nat.sub_add_cancel (he_le i)] at hprod
      have hX0K_hom : ((MvPolynomial.X 0 : MvPolynomial (Fin 2) k) ^ K).IsHomogeneous K :=
        MvPolynomial.isHomogeneous_X_pow (0 : Fin 2) K
      have hQ₀_aeval :
          MvPolynomial.aeval (![1, Polynomial.X] : Fin 2 → Polynomial k) Q₀ =
          MvPolynomial.aeval (![1, Polynomial.X] : Fin 2 → Polynomial k)
            ((MvPolynomial.X 0 : MvPolynomial (Fin 2) k) ^ K) := by
        dsimp [Q₀]
        rw [map_sum]
        have hsum_eq : (∑ i : Fin r, MvPolynomial.aeval ![1, Polynomial.X] (U i * B i)) =
            ∑ i : Fin r, u i • h i := by
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_mul, hU_aeval i, smul_eq_mul]
        rw [hsum_eq, hu_sum, map_pow, MvPolynomial.aeval_X, Matrix.cons_val_zero, one_pow]
      have hHomDehom : ∀ (P : MvPolynomial (Fin 2) k), P.IsHomogeneous K →
          ∀ s : Fin 2 →₀ ℕ, s 0 + s 1 = K →
            P.coeff s = (MvPolynomial.aeval ![1, Polynomial.X] P).coeff (s 1) := by
        intro P hP s hsK
        conv_rhs => rw [P.as_sum]
        rw [map_sum, Polynomial.finset_sum_coeff]
        have hterm : ∀ m ∈ P.support,
            (MvPolynomial.aeval ![1, Polynomial.X] (MvPolynomial.monomial m (P.coeff m))).coeff (s 1) =
              if m = s then P.coeff m else 0 := by
          intro m hm
          have hm_deg : m 0 + m 1 = K := by
            have hd' : Finsupp.degree m = K := by
              by_contra hne
              exact (MvPolynomial.mem_support_iff.mp hm) (hP.coeff_eq_zero hne)
            rw [Finsupp.degree_eq_weight_one, Finsupp.weight_apply, Finsupp.sum_fintype,
              Fin.sum_univ_two] at hd'
            · simp only [Pi.one_apply, smul_eq_mul, mul_one] at hd'
              exact hd'
            · intro _; exact zero_smul ℕ 1
          have hm_prod : (m.prod fun i k_1 =>
              (![1, Polynomial.X] : Fin 2 → Polynomial k) i ^ k_1) =
              Polynomial.X ^ (m 1) := by
            rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_two]
            simp
          rw [MvPolynomial.aeval_monomial, Polynomial.algebraMap_eq, hm_prod,
            Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
          by_cases hms : m = s
          · subst hms; simp
          · rw [if_neg hms]
            have hm1_ne : s 1 ≠ m 1 := by
              intro heq
              apply hms
              ext b; fin_cases b <;> dsimp <;> omega
            rw [if_neg hm1_ne, mul_zero]
        by_cases hs : s ∈ P.support
        · rw [Finset.sum_eq_single s]
          · rw [hterm s hs, if_pos rfl]
          · intro m hm hne; rw [hterm m hm, if_neg hne]
          · intro hnot; exact absurd hs hnot
        · rw [MvPolynomial.notMem_support_iff.mp hs]
          symm
          refine Finset.sum_eq_zero fun m hm => ?_
          have hne : m ≠ s := fun hEq => hs (hEq ▸ hm)
          rw [hterm m hm, if_neg hne]
      refine ⟨K, U, he_le, hU_hom, ?_⟩
      ext s
      by_cases hsK : s 0 + s 1 = K
      · change Q₀.coeff s = _
        rw [hHomDehom Q₀ hQ₀_hom s hsK, hQ₀_aeval, ← hHomDehom _ hX0K_hom s hsK]
      · have hs_deg : Finsupp.degree s ≠ K := by
          rw [Finsupp.degree_eq_weight_one, Finsupp.weight_apply, Finsupp.sum_fintype,
            Fin.sum_univ_two]
          · simp only [Pi.one_apply, smul_eq_mul, mul_one]
            exact hsK
          · intro _; exact zero_smul ℕ 1
        change Q₀.coeff s = _
        rw [hQ₀_hom.coeff_eq_zero hs_deg, hX0K_hom.coeff_eq_zero hs_deg]

    let B_star : Fin r → MvPolynomial (Fin 2) k := fun i => binForm ℓ_wit (G i)
    have hB_star_hom : ∀ i : Fin r, (B_star i).IsHomogeneous (e i) :=
      fun i => hBinHom ℓ_wit (G i) (hG_hom i)
    have hB_star_nz : ∀ t : Fin 2 → k, t ≠ 0 → ∃ i : Fin r, MvPolynomial.eval t (B_star i) ≠ 0 := by
      intro t ht
      obtain ⟨i, hi⟩ := hWit t ht
      exact ⟨i, (hBinEval ℓ_wit t (G i)).symm ▸ hi⟩

    obtain ⟨K, U_star, he_le_K, hU_star_hom, hU_star_eq⟩ := hPowerX0 B_star hB_star_hom hB_star_nz

    let τ_swap : Fin 2 ≃ Fin 2 := Equiv.swap 0 1
    have hRenHom : ∀ {d : ℕ} (P : MvPolynomial (Fin 2) k),
        P.IsHomogeneous d → (MvPolynomial.rename τ_swap P).IsHomogeneous d := by
      intro d P hP
      have h1 := hP.eval₂ (MvPolynomial.C : k →+* MvPolynomial (Fin 2) k)
        (fun b => MvPolynomial.X (τ_swap b))
        (fun c => MvPolynomial.isHomogeneous_C _ c)
        (fun b => MvPolynomial.isHomogeneous_X k (τ_swap b))
      rw [one_mul] at h1
      rwa [MvPolynomial.rename_eq]
    let B_swap : Fin r → MvPolynomial (Fin 2) k :=
      fun i => MvPolynomial.rename τ_swap (B_star i)
    have hB_swap_hom : ∀ i : Fin r, (B_swap i).IsHomogeneous (e i) :=
      fun i => hRenHom (B_star i) (hB_star_hom i)
    have hB_swap_nz : ∀ t : Fin 2 → k, t ≠ 0 → ∃ i : Fin r, MvPolynomial.eval t (B_swap i) ≠ 0 := by
      intro t ht
      have ht_sw : (t ∘ τ_swap) ≠ 0 := by
        intro h0
        apply ht
        ext b
        fin_cases b
        · exact congrFun h0 1
        · exact congrFun h0 0
      obtain ⟨i, hi⟩ := hB_star_nz (t ∘ τ_swap) ht_sw
      refine ⟨i, ?_⟩
      dsimp [B_swap]
      rwa [MvPolynomial.eval_rename]
    obtain ⟨L, V_tilde, he_le_L, hV_tilde_hom, hV_tilde_eq⟩ :=
      hPowerX0 B_swap hB_swap_hom hB_swap_nz
    let V_star : Fin r → MvPolynomial (Fin 2) k :=
      fun i => MvPolynomial.rename τ_swap (V_tilde i)
    have hV_star_hom : ∀ i : Fin r, (V_star i).IsHomogeneous (L - e i) :=
      fun i => hRenHom (V_tilde i) (hV_tilde_hom i)
    have hV_star_eq : ∑ i : Fin r, V_star i * B_star i = (MvPolynomial.X 1) ^ L := by
      have hren := congrArg (MvPolynomial.rename τ_swap) hV_tilde_eq
      rw [map_sum] at hren
      have hLHS : (∑ i : Fin r, MvPolynomial.rename τ_swap (V_tilde i * B_swap i)) =
          ∑ i : Fin r, V_star i * B_star i := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul]
        congr 1
        dsimp [B_swap]
        rw [MvPolynomial.rename_rename]
        have hcomp : (τ_swap ∘ τ_swap : Fin 2 → Fin 2) = id := by
          funext b; fin_cases b <;> decide
        rw [hcomp, MvPolynomial.rename_id_apply]
      have hRHS : MvPolynomial.rename τ_swap ((MvPolynomial.X 0 : MvPolynomial (Fin 2) k) ^ L) =
          (MvPolynomial.X 1) ^ L := by
        rw [map_pow, MvPolynomial.rename_X]
        rfl
      rwa [hLHS, hRHS] at hren

    
    let N : ℕ := K + L + 1
    let μ_N : Fin (N + 1) → (Fin 2 →₀ ℕ) :=
      fun n => Finsupp.single 0 n.val + Finsupp.single 1 (N - n.val)
    have hμN_inj : Function.Injective μ_N := by
      intro m n hmn
      have h0 := congrArg (fun s : Fin 2 →₀ ℕ => s 0) hmn
      simp only [μ_N, Finsupp.coe_add, Pi.add_apply, Finsupp.single_eq_same,
        Finsupp.single_eq_of_ne (by decide : (0 : Fin 2) ≠ 1), add_zero] at h0
      exact Fin.ext h0
    have hMon_μN : ∀ n : Fin (N + 1),
        (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) ^ n.val *
          (MvPolynomial.X 1 : MvPolynomial (Fin 2) k) ^ (N - n.val) =
          MvPolynomial.monomial (μ_N n) 1 := by
      intro n
      rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.X_pow_eq_monomial,
        MvPolynomial.monomial_mul_monomial, one_mul]

    let W_star : Fin (N + 1) → Fin r → MvPolynomial (Fin 2) k := fun m i =>
      if K ≤ m.val then
        (MvPolynomial.X 0) ^ (m.val - K) * (MvPolynomial.X 1) ^ (N - m.val) * U_star i
      else
        (MvPolynomial.X 0) ^ m.val * (MvPolynomial.X 1) ^ (N - m.val - L) * V_star i
    have hW_star_hom : ∀ (m : Fin (N + 1)) (i : Fin r), (W_star m i).IsHomogeneous (N - e i) := by
      intro m i
      dsimp only [W_star]
      split_ifs with hmK
      · have h1 := (MvPolynomial.isHomogeneous_X_pow (R := k) (0 : Fin 2) (m.val - K)).mul
          (MvPolynomial.isHomogeneous_X_pow (R := k) (1 : Fin 2) (N - m.val))
        have h2 := h1.mul (hU_star_hom i)
        have hdeg : (m.val - K) + (N - m.val) + (K - e i) = N - e i := by
          have := he_le_K i; have := m.isLt; omega
        rwa [hdeg] at h2
      · have h1 := (MvPolynomial.isHomogeneous_X_pow (R := k) (0 : Fin 2) m.val).mul
          (MvPolynomial.isHomogeneous_X_pow (R := k) (1 : Fin 2) (N - m.val - L))
        have h2 := h1.mul (hV_star_hom i)
        have hdeg : m.val + (N - m.val - L) + (L - e i) = N - e i := by
          have := he_le_L i; have := m.isLt; omega
        rwa [hdeg] at h2
    have hW_star_sum : ∀ m : Fin (N + 1),
        ∑ i : Fin r, W_star m i * B_star i = MvPolynomial.monomial (μ_N m) 1 := by
      intro m
      dsimp only [W_star]
      split_ifs with hmK
      · have hfac : (∑ i : Fin r,
            (MvPolynomial.X 0) ^ (m.val - K) * (MvPolynomial.X 1) ^ (N - m.val) * U_star i *
              B_star i) =
            (MvPolynomial.X 0) ^ (m.val - K) * (MvPolynomial.X 1) ^ (N - m.val) *
              ∑ i : Fin r, U_star i * B_star i := by
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl fun i _ => by ring
        rw [hfac, hU_star_eq, ← hMon_μN m]
        have hexp : (m.val - K) + K = m.val := by omega
        calc (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) ^ (m.val - K) *
              (MvPolynomial.X 1) ^ (N - m.val) * (MvPolynomial.X 0) ^ K
            = ((MvPolynomial.X 0) ^ (m.val - K) * (MvPolynomial.X 0) ^ K) *
                (MvPolynomial.X 1) ^ (N - m.val) := by ring
          _ = (MvPolynomial.X 0) ^ m.val * (MvPolynomial.X 1) ^ (N - m.val) := by
              rw [← pow_add, hexp]
      · have hfac : (∑ i : Fin r,
            (MvPolynomial.X 0) ^ m.val * (MvPolynomial.X 1) ^ (N - m.val - L) * V_star i *
              B_star i) =
            (MvPolynomial.X 0) ^ m.val * (MvPolynomial.X 1) ^ (N - m.val - L) *
              ∑ i : Fin r, V_star i * B_star i := by
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl fun i _ => by ring
        rw [hfac, hV_star_eq, ← hMon_μN m]
        have hexp : (N - m.val - L) + L = N - m.val := by omega
        rw [mul_assoc, ← pow_add, hexp]

    let R₂ := MvPolynomial (Fin 2 × Fin (M + 1)) k
    let X_gen : Fin 2 → Fin (M + 1) → R₂ := fun b μ => MvPolynomial.X (b, μ)
    let W_const : Fin (N + 1) → Fin r → MvPolynomial (Fin 2) R₂ :=
      fun m i => MvPolynomial.map MvPolynomial.C (W_star m i)
    let F_gen : Fin (N + 1) → MvPolynomial (Fin 2) R₂ :=
      fun m => ∑ i : Fin r, W_const m i * binForm X_gen (G i)
    let Q_gen : Matrix (Fin (N + 1)) (Fin (N + 1)) R₂ :=
      Matrix.of fun m n => (F_gen m).coeff (μ_N n)
    let Δ_avoid : R₂ := Matrix.det Q_gen

    have hMap_binForm : ∀ (ℓ₀₁ : Fin 2 × Fin (M + 1) → k) (i : Fin r),
        MvPolynomial.map (MvPolynomial.eval ℓ₀₁) (binForm X_gen (G i)) =
          binForm (fun b μ => ℓ₀₁ (b, μ)) (G i) := by
      intro ℓ₀₁ i
      have hmap_eq : MvPolynomial.map (MvPolynomial.eval ℓ₀₁) (binForm X_gen (G i)) =
          (MvPolynomial.mapAlgHom (MvPolynomial.aeval ℓ₀₁)) (binForm X_gen (G i)) := by
        have hrh : MvPolynomial.eval ℓ₀₁ = (MvPolynomial.aeval ℓ₀₁).toRingHom := by
          apply MvPolynomial.ringHom_ext <;> intro x <;> simp
        rw [hrh]
        rfl
      rw [hmap_eq]
      let ψ₁ : MvPolynomial (Fin (M + 1)) k →ₐ[k] MvPolynomial (Fin 2) k :=
        (MvPolynomial.mapAlgHom (MvPolynomial.aeval ℓ₀₁)).comp
          (MvPolynomial.aeval fun μ =>
            MvPolynomial.C (X_gen 0 μ) * MvPolynomial.X (0 : Fin 2) +
              MvPolynomial.C (X_gen 1 μ) * MvPolynomial.X (1 : Fin 2))
      let ψ₂ : MvPolynomial (Fin (M + 1)) k →ₐ[k] MvPolynomial (Fin 2) k :=
        MvPolynomial.aeval fun μ =>
          MvPolynomial.C (ℓ₀₁ (0, μ)) * MvPolynomial.X (0 : Fin 2) +
            MvPolynomial.C (ℓ₀₁ (1, μ)) * MvPolynomial.X (1 : Fin 2)
      have hψ : ψ₁ = ψ₂ := by
        apply MvPolynomial.algHom_ext
        intro μ
        simp [ψ₁, ψ₂, X_gen]
      exact DFunLike.congr_fun hψ (G i)

    have hMap_Fgen : ∀ (ℓ₀₁ : Fin 2 × Fin (M + 1) → k) (m : Fin (N + 1)),
        MvPolynomial.map (MvPolynomial.eval ℓ₀₁) (F_gen m) =
          ∑ i : Fin r, W_star m i * binForm (fun b μ => ℓ₀₁ (b, μ)) (G i) := by
      intro ℓ₀₁ m
      dsimp [F_gen]
      rw [map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      have hWc : MvPolynomial.map (MvPolynomial.eval ℓ₀₁) (W_const m i) = W_star m i := by
        dsimp [W_const]
        rw [MvPolynomial.map_map]
        have hcomp : (MvPolynomial.eval ℓ₀₁).comp MvPolynomial.C = RingHom.id k := by
          ext c; simp
        rw [hcomp, MvPolynomial.map_id]
      rw [map_mul, hWc, hMap_binForm ℓ₀₁ i]

    have hΔ_avoid_ne : Δ_avoid ≠ 0 := by
      let ℓ_wit01 : Fin 2 × Fin (M + 1) → k := fun p => ℓ_wit p.1 p.2
      have hQ_id : (MvPolynomial.eval ℓ_wit01).mapMatrix Q_gen = 1 := by
        ext m n
        simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Q_gen, Matrix.of_apply,
          ← MvPolynomial.coeff_map, hMap_Fgen ℓ_wit01 m]
        have hF_wit : (∑ i : Fin r, W_star m i * binForm (fun b μ => ℓ_wit01 (b, μ)) (G i)) =
            MvPolynomial.monomial (μ_N m) 1 := hW_star_sum m
        rw [hF_wit, MvPolynomial.coeff_monomial, Matrix.one_apply]
        by_cases hmn : m = n
        · subst hmn; simp
        · have hne : μ_N m ≠ μ_N n := fun h => hmn (hμN_inj h)
          simp [hmn, hne]
      have hdet1 : MvPolynomial.eval ℓ_wit01 Δ_avoid = 1 := by
        dsimp [Δ_avoid]
        rw [RingHom.map_det, hQ_id, Matrix.det_one]
      intro h0
      rw [h0, map_zero] at hdet1
      exact zero_ne_one hdet1

    refine ⟨Δ_avoid, hΔ_avoid_ne, fun ℓ₀₁ hne t ht_ne => ?_⟩
    by_contra hall
    push Not at hall
    let ℓ_raw : Fin 2 → Fin (M + 1) → k := fun b μ => ℓ₀₁ (b, μ)
    let F_ℓ : Fin (N + 1) → MvPolynomial (Fin 2) k :=
      fun m => MvPolynomial.map (MvPolynomial.eval ℓ₀₁) (F_gen m)
    have hFℓ_hom : ∀ m : Fin (N + 1), (F_ℓ m).IsHomogeneous N := by
      intro m
      dsimp [F_ℓ]
      rw [hMap_Fgen ℓ₀₁ m]
      change _ ∈ MvPolynomial.homogeneousSubmodule (Fin 2) k N
      refine Submodule.sum_mem _ fun i _ => ?_
      have hp := (hW_star_hom m i).mul (hBinHom ℓ_raw (G i) (hG_hom i))
      have he_le_N : e i ≤ N := by have := he_le_K i; omega
      rwa [Nat.sub_add_cancel he_le_N] at hp
    have hFℓ_eval0 : ∀ m : Fin (N + 1), MvPolynomial.eval t (F_ℓ m) = 0 := by
      intro m
      dsimp [F_ℓ]
      rw [hMap_Fgen ℓ₀₁ m, map_sum]
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [map_mul, hBinEval ℓ_raw t (G i), hall i, mul_zero]
    have hFℓ_decomp : ∀ m : Fin (N + 1),
        F_ℓ m = ∑ n : Fin (N + 1),
          MvPolynomial.C ((F_ℓ m).coeff (μ_N n)) *
            (MvPolynomial.X 0) ^ n.val * (MvPolynomial.X 1) ^ (N - n.val) := by
      intro m
      have hmon_eq : ∀ n : Fin (N + 1),
          MvPolynomial.C ((F_ℓ m).coeff (μ_N n)) *
            (MvPolynomial.X (0 : Fin 2)) ^ n.val * (MvPolynomial.X 1) ^ (N - n.val) =
          MvPolynomial.monomial (μ_N n) ((F_ℓ m).coeff (μ_N n)) := by
        intro n
        rw [mul_assoc, hMon_μN n, MvPolynomial.C_mul_monomial, mul_one]
      simp_rw [hmon_eq]
      ext s
      rw [MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      by_cases hsN : s 0 + s 1 = N
      · let n_s : Fin (N + 1) := ⟨s 0, by omega⟩
        have hμ_ns : μ_N n_s = s := by
          ext b
          fin_cases b
          · simp [μ_N, n_s]
          · simp [μ_N, n_s]; omega
        rw [Finset.sum_eq_single n_s]
        · rw [if_pos hμ_ns, hμ_ns]
        · intro n _ hne
          have hμ_ne : μ_N n ≠ s := by
            rw [← hμ_ns]; exact fun h => hne (hμN_inj h)
          rw [if_neg hμ_ne]
        · intro hnot; exact absurd (Finset.mem_univ _) hnot
      · have hs_deg : Finsupp.degree s ≠ N := by
          rw [Finsupp.degree_eq_weight_one, Finsupp.weight_apply, Finsupp.sum_fintype,
            Fin.sum_univ_two]
          · simp only [Pi.one_apply, smul_eq_mul, mul_one]
            exact hsN
          · intro _; exact zero_smul ℕ 1
        rw [(hFℓ_hom m).coeff_eq_zero hs_deg]
        symm
        refine Finset.sum_eq_zero fun n _ => ?_
        have hμ_ne : μ_N n ≠ s := by
          intro hEq
          apply hsN
          rw [← hEq]
          have hn := n.isLt
          simp only [μ_N, Finsupp.coe_add, Pi.add_apply, Finsupp.single_eq_same,
            Finsupp.single_eq_of_ne (by decide : (1 : Fin 2) ≠ 0),
            Finsupp.single_eq_of_ne (by decide : (0 : Fin 2) ≠ 1), add_zero, zero_add]
          omega
        rw [if_neg hμ_ne]

    let M_ℓ : Matrix (Fin (N + 1)) (Fin (N + 1)) k := (MvPolynomial.eval ℓ₀₁).mapMatrix Q_gen
    let v_mon : Fin (N + 1) → k := fun n => t 0 ^ n.val * t 1 ^ (N - n.val)
    have hMulVec0 : M_ℓ.mulVec v_mon = 0 := by
      ext m
      rw [Pi.zero_apply, Matrix.mulVec, dotProduct]
      have hev := hFℓ_eval0 m
      conv_lhs at hev => rw [hFℓ_decomp m]
      simp only [map_sum, map_mul, map_pow, MvPolynomial.eval_C, MvPolynomial.eval_X] at hev
      have hsum_eq : (∑ n : Fin (N + 1), M_ℓ m n * v_mon n) =
          ∑ n : Fin (N + 1), (F_ℓ m).coeff (μ_N n) * t 0 ^ n.val * t 1 ^ (N - n.val) := by
        refine Finset.sum_congr rfl fun n _ => ?_
        simp only [M_ℓ, RingHom.mapMatrix_apply, Matrix.map_apply, Q_gen, Matrix.of_apply,
          F_ℓ, MvPolynomial.coeff_map, v_mon, mul_assoc]
      rwa [hsum_eq]
    have hDet_Mℓ : M_ℓ.det ≠ 0 := by
      dsimp [M_ℓ]
      rwa [← RingHom.map_det]
    have hInvMul : M_ℓ⁻¹ * M_ℓ = 1 := Matrix.nonsing_inv_mul M_ℓ (IsUnit.mk0 _ hDet_Mℓ)
    have hv_zero : v_mon = 0 := by
      calc v_mon = (1 : Matrix (Fin (N + 1)) (Fin (N + 1)) k).mulVec v_mon :=
            (Matrix.one_mulVec v_mon).symm
        _ = (M_ℓ⁻¹ * M_ℓ).mulVec v_mon := by rw [hInvMul]
        _ = M_ℓ⁻¹.mulVec (M_ℓ.mulVec v_mon) := (Matrix.mulVec_mulVec v_mon M_ℓ⁻¹ M_ℓ).symm
        _ = M_ℓ⁻¹.mulVec 0 := by rw [hMulVec0]
        _ = 0 := Matrix.mulVec_zero M_ℓ⁻¹
    have ht0_pow : t 0 ^ N = 0 := by
      have hlast := congrFun hv_zero (Fin.last N)
      simpa only [v_mon, Fin.val_last, Nat.sub_self, pow_zero, mul_one, Pi.zero_apply] using hlast
    have ht1_pow : t 1 ^ N = 0 := by
      have hzero := congrFun hv_zero 0
      simpa only [v_mon, Fin.val_zero, pow_zero, one_mul, Nat.sub_zero, Pi.zero_apply] using hzero
    have hPowZero : ∀ (x : k) (m : ℕ), x ^ m = 0 → x = 0 := by
      intro x m hm
      induction m with
      | zero => rw [pow_zero] at hm; exact absurd hm one_ne_zero
      | succ m ih =>
        rw [pow_succ] at hm
        rcases mul_eq_zero.mp hm with h1 | h2
        · exact ih h1
        · exact h2
    have ht0 : t 0 = 0 := hPowZero (t 0) N ht0_pow
    have ht1 : t 1 = 0 := hPowZero (t 1) N ht1_pow
    apply ht_ne
    ext b; fin_cases b; exact ht0; exact ht1

  
  
  
  obtain ⟨Δ_sep, hΔ_sep_ne, hΔ_sep⟩ := hSepPkg
  obtain ⟨Δ_avoid, hΔ_avoid_ne, hΔ_avoid⟩ := hAvoidPkg
  refine ⟨Δ_sep * Δ_avoid, mul_ne_zero hΔ_sep_ne hΔ_avoid_ne, fun ℓ₀₁ hne => ?_⟩
  rw [map_mul] at hne
  obtain ⟨hEval1, hDeg, hSep⟩ := hΔ_sep ℓ₀₁ (left_ne_zero_of_mul hne)
  refine ⟨hEval1, hDeg, hSep, fun t q ht_ne hq_iff hq_bad => ?_⟩
  obtain ⟨i, hi_ne⟩ := hΔ_avoid ℓ₀₁ (right_ne_zero_of_mul hne) t ht_ne
  have hGi_in : G i ∈ ProjectiveSpectrum.asHomogeneousIdeal q := (hG_iff q).mp hq_bad i
  exact hi_ne ((hq_iff (G i) (e i) (hG_hom i)).mp hGi_in)

theorem weil_algClosed_dual_variety_net_and_pencil_line (k : Type u) [Field k] [IsAlgClosed k] (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hVer : IsCubicVeroneseEmbeddedOver k m M Z_bar ι_bar) :
    Nonempty (WeilAlgClosedDualNetAndPencilLine k m M Z_bar ι_bar) :=
by
  classical
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
    MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
    MvPolynomial.gradedAlgebra
  haveI : Infinite k := IsAlgClosed.instInfinite
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k

  
  have hM : 3 ≤ M := hVer.1
  have hCl_ι : AlgebraicGeometry.IsClosedImmersion ι_bar.left := hVer.2.1
  obtain ⟨j_aff, s_inf, ι_line, hCoord_line, hLine_plane, hPlaneCurve⟩ :=
    weil_algClosed_proj_plane_curve_and_line_coords k
  obtain ⟨D_amb, P_amb, F_bad, hD_amb, hP_homog, hP_irred, hF_closed, hF_dim, hTrans_out, hOdp_on⟩ :=
    weil_algClosed_dual_hypersurface_and_odp_bad_locus k m M Z_bar hInt ι_bar hVer
  obtain ⟨Δ_axis, hΔ_axis_ne, hΔ_axis⟩ :=
    weil_algClosed_net_axis_transversal_open_poly k m M hM Z_bar hInt ι_bar hCl_ι
  obtain ⟨Δ_irred, hΔ_irred_ne, hΔ_irred⟩ :=
    weil_algClosed_hypersurface_net_bertini_irreducible_poly k M D_amb hM hD_amb
      P_amb hP_homog hP_irred
  obtain ⟨Δ_line₀, hΔ_line₀_ne, hΔ_line₀⟩ :=
    weil_algClosed_pencil_line_separable_and_avoid_bad_poly k M D_amb hM hD_amb
      P_amb hP_homog hP_irred F_bad hF_closed hF_dim

  
  let ι₂₃ : Fin 2 × Fin (M + 1) → Fin 3 × Fin (M + 1) := fun p => (p.1.castSucc, p.2)
  have hι₂₃_inj : Function.Injective ι₂₃ := by
    rintro ⟨a₁, b₁⟩ ⟨a₂, b₂⟩ hpq
    have h₁ : a₁.castSucc = a₂.castSucc := congrArg Prod.fst hpq
    have h₂ : b₁ = b₂ := congrArg Prod.snd hpq
    exact Prod.ext (Fin.castSucc_injective 2 h₁) h₂
  let Δ_line : MvPolynomial (Fin 3 × Fin (M + 1)) k := MvPolynomial.rename ι₂₃ Δ_line₀
  have hΔ_line_ne : Δ_line ≠ 0 := fun h0 =>
    hΔ_line₀_ne (MvPolynomial.rename_injective ι₂₃ hι₂₃_inj (h0.trans (map_zero _).symm))

  let emb3 : Fin 3 → Fin (M + 1) := Fin.castLE (by omega : 3 ≤ M + 1)
  let Δ_linIndep : MvPolynomial (Fin 3 × Fin (M + 1)) k :=
    Matrix.det (Matrix.of fun r s : Fin 3 => MvPolynomial.X (r, emb3 s))
  have hΔ_indep_ne : Δ_linIndep ≠ 0 := by
    let ℓ_id : Fin 3 × Fin (M + 1) → k := fun p => if p.1.1 = p.2.1 then 1 else 0
    have h_id : MvPolynomial.eval ℓ_id Δ_linIndep = 1 := by
      dsimp [Δ_linIndep]
      rw [RingHom.map_det]
      have hmat : (MvPolynomial.eval ℓ_id).mapMatrix
          (Matrix.of fun r s : Fin 3 => MvPolynomial.X (r, emb3 s)) = 1 := by
        ext r s
        simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply,
          MvPolynomial.eval_X, ℓ_id, emb3, Fin.coe_castLE, Matrix.one_apply, Fin.ext_iff]
      rw [hmat, Matrix.det_one]
    intro h0
    rw [h0, map_zero] at h_id
    exact zero_ne_one h_id

  let Δ_tot : MvPolynomial (Fin 3 × Fin (M + 1)) k :=
    Δ_linIndep * Δ_axis * Δ_irred * Δ_line
  have hΔ_tot_ne : Δ_tot ≠ 0 :=
    mul_ne_zero (mul_ne_zero (mul_ne_zero hΔ_indep_ne hΔ_axis_ne) hΔ_irred_ne) hΔ_line_ne
  have h_not_all_zero : ¬ ∀ x : Fin 3 × Fin (M + 1) → k, MvPolynomial.eval x Δ_tot = 0 :=
    fun hall => hΔ_tot_ne (MvPolynomial.funext_iff.mpr fun x => by rw [hall x, map_zero])
  obtain ⟨ℓ_tilde, hℓ_tot⟩ := not_forall.mp h_not_all_zero
  simp only [Δ_tot, map_mul] at hℓ_tot
  have hℓ_123 : MvPolynomial.eval ℓ_tilde Δ_linIndep *
      MvPolynomial.eval ℓ_tilde Δ_axis * MvPolynomial.eval ℓ_tilde Δ_irred ≠ 0 :=
    left_ne_zero_of_mul hℓ_tot
  have hℓ_line : MvPolynomial.eval ℓ_tilde Δ_line ≠ 0 := right_ne_zero_of_mul hℓ_tot
  have hℓ_12 : MvPolynomial.eval ℓ_tilde Δ_linIndep * MvPolynomial.eval ℓ_tilde Δ_axis ≠ 0 :=
    left_ne_zero_of_mul hℓ_123
  have hℓ_irred : MvPolynomial.eval ℓ_tilde Δ_irred ≠ 0 := right_ne_zero_of_mul hℓ_123
  have hℓ_indep : MvPolynomial.eval ℓ_tilde Δ_linIndep ≠ 0 := left_ne_zero_of_mul hℓ_12
  have hℓ_axis : MvPolynomial.eval ℓ_tilde Δ_axis ≠ 0 := right_ne_zero_of_mul hℓ_12
  have hℓ_line₀ : MvPolynomial.eval (ℓ_tilde ∘ ι₂₃) Δ_line₀ ≠ 0 := by
    rwa [← MvPolynomial.eval_rename]

  
  let ℓ_raw : Fin 3 → Fin (M + 1) → k := fun r μ => ℓ_tilde (r, μ)
  obtain ⟨hEval_ℓ1, hDeg_Pline, hSep_Pline, hAvoid_ℓ01⟩ := hΔ_line₀ (ℓ_tilde ∘ ι₂₃) hℓ_line₀
  let P_line : Polynomial k :=
    MvPolynomial.eval₂ Polynomial.C
      (fun μ : Fin (M + 1) => Polynomial.C (ℓ_raw 0 μ) + Polynomial.C (ℓ_raw 1 μ) * Polynomial.X)
      P_amb
  have hDeg_Pline' : P_line.natDegree = D_amb := hDeg_Pline
  have hSep_Pline' : P_line.Separable := hSep_Pline
  have hPline_ne : P_line ≠ 0 := by
    intro h0
    rw [h0, Polynomial.natDegree_zero] at hDeg_Pline'
    omega
  have hPline_deg_ne : P_line.degree ≠ 0 := by
    rw [Polynomial.degree_eq_natDegree hPline_ne, hDeg_Pline']
    exact_mod_cast (by omega : D_amb ≠ 0)
  obtain ⟨r₀, hr₀_root⟩ := IsAlgClosed.exists_root P_line hPline_deg_ne
  have hr₀_eval : P_line.eval r₀ = 0 := hr₀_root
  have hPline_deriv_ne : ∀ x : k, P_line.eval x = 0 → (Polynomial.derivative P_line).eval x ≠ 0 := by
    intro x hx hdx
    obtain ⟨u_p, v_p, huv⟩ := hSep_Pline'
    have h1 := congrArg (Polynomial.eval x) huv
    simp only [Polynomial.eval_add, Polynomial.eval_mul, hx, hdx, mul_zero, add_zero,
      Polynomial.eval_one] at h1
    exact zero_ne_one h1

  let ℓ : Fin 3 → Fin (M + 1) → k :=
    ![ℓ_raw 1, fun μ => ℓ_raw 0 μ + r₀ * ℓ_raw 1 μ, ℓ_raw 2]
  let L_raw : Fin 3 → MvPolynomial (Fin (M + 1)) k :=
    fun r => ∑ μ : Fin (M + 1), MvPolynomial.C (ℓ_raw r μ) * MvPolynomial.X μ
  let L : Fin 3 → MvPolynomial (Fin (M + 1)) k :=
    fun r => ∑ μ : Fin (M + 1), MvPolynomial.C (ℓ r μ) * MvPolynomial.X μ

  have hL0 : L 0 = L_raw 1 := rfl
  have hL2 : L 2 = L_raw 2 := rfl
  have hL1 : L 1 = L_raw 0 + MvPolynomial.C r₀ * L_raw 1 := by
    dsimp only [L, L_raw, ℓ, Matrix.cons_val_one, Matrix.cons_val_zero]
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun μ _ => ?_
    simp only [map_add, map_mul]
    ring

  have hL_homog : ∀ r : Fin 3, L r ∈ 𝒜_M 1 := by
    intro r
    refine Submodule.sum_mem (𝒜_M 1) fun μ _ => ?_
    rw [← MvPolynomial.smul_eq_C_mul]
    exact Submodule.smul_mem (𝒜_M 1) (ℓ r μ) (MvPolynomial.isHomogeneous_X k μ)
  have hL_raw_homog : ∀ r : Fin 3, L_raw r ∈ 𝒜_M 1 := by
    intro r
    refine Submodule.sum_mem (𝒜_M 1) fun μ _ => ?_
    rw [← MvPolynomial.smul_eq_C_mul]
    exact Submodule.smul_mem (𝒜_M 1) (ℓ_raw r μ) (MvPolynomial.isHomogeneous_X k μ)

  
  let M_ℓ_raw : Matrix (Fin 3) (Fin 3) k := Matrix.of fun r s => ℓ_raw r (emb3 s)
  let M_ℓ : Matrix (Fin 3) (Fin 3) k := Matrix.of fun r s => ℓ r (emb3 s)
  let S_mat : Matrix (Fin 3) (Fin 3) k := ![![0, 1, 0], ![1, r₀, 0], ![0, 0, 1]]
  have hMℓ_eq : M_ℓ = S_mat * M_ℓ_raw := by
    ext r s
    rw [Matrix.mul_apply, Fin.sum_univ_three]
    fin_cases r <;>
      simp [M_ℓ, M_ℓ_raw, S_mat, ℓ] <;>
      ring
  have hDet_S : S_mat.det = -1 := by
    rw [Matrix.det_fin_three]
    simp [S_mat]
  have hDet_Mℓ_raw : M_ℓ_raw.det = MvPolynomial.eval ℓ_tilde Δ_linIndep := by
    dsimp [Δ_linIndep]
    rw [RingHom.map_det]
    congr 1
    ext r s
    simp [M_ℓ_raw, ℓ_raw]
  have hDet_Mℓ : M_ℓ.det ≠ 0 := by
    rw [hMℓ_eq, Matrix.det_mul, hDet_S, hDet_Mℓ_raw]
    exact mul_ne_zero (neg_ne_zero.mpr one_ne_zero) hℓ_indep

  have hL_linIndep : ∀ c : Fin 3 → k, c ≠ 0 → (∑ r : Fin 3, MvPolynomial.C (c r) * L r) ≠ 0 := by
    intro c hc hsum
    have hvec : Matrix.vecMul c M_ℓ = 0 := by
      ext s
      have hs := congrArg (MvPolynomial.eval (Pi.single (emb3 s) (1 : k))) hsum
      simp only [map_sum, map_mul, MvPolynomial.eval_C, map_zero] at hs
      have hLr : ∀ r : Fin 3,
          MvPolynomial.eval (Pi.single (emb3 s) (1 : k)) (L r) = ℓ r (emb3 s) := by
        intro r
        dsimp [L]
        rw [map_sum]
        rw [Finset.sum_eq_single (emb3 s)]
        · simp
        · intro μ _ hμ
          simp [Pi.single_eq_of_ne hμ]
        · intro hmem
          exact absurd (Finset.mem_univ _) hmem
      simp only [hLr] at hs
      exact hs
    have hc_zero : c = 0 :=
      Matrix.vecMul_injective_of_isUnit
        ((Matrix.isUnit_iff_isUnit_det M_ℓ).mpr (IsUnit.mk0 _ hDet_Mℓ))
        (hvec.trans (Matrix.zero_vecMul M_ℓ).symm)
    exact hc hc_zero

  
  obtain ⟨hTrans_axis_tilde, hNet_m0_tilde, hNet_pos_tilde⟩ := hΔ_axis ℓ_tilde hℓ_axis
  have hHyp_iff : ∀ (p : (weilProjectiveSpaceOver k M).left) (G : MvPolynomial (Fin (M + 1)) k),
      p ∈ weilProjHyperplaneSet k M G ↔ G ∈ ProjectiveSpectrum.asHomogeneousIdeal p := by
    intro p G
    let p' : AlgebraicGeometry.Proj 𝒜_M := p
    change p' ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_M G ↔ G ∈ p'.asHomogeneousIdeal
    rw [AlgebraicGeometry.Proj.mem_basicOpen, not_not]

  have hVanish01 : ∀ z : Z_bar.left,
      ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 0) →
      ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 1) →
      ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L_raw 0) ∧
      ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L_raw 1) := by
    intro z hz0 hz1
    rw [hHyp_iff] at hz0 hz1 ⊢
    rw [hHyp_iff]
    have h1 : L_raw 1 ∈ (ProjectiveSpectrum.asHomogeneousIdeal (ι_bar.left.base z)).toIdeal := hz0
    have h01 : L_raw 0 + MvPolynomial.C r₀ * L_raw 1 ∈
        (ProjectiveSpectrum.asHomogeneousIdeal (ι_bar.left.base z)).toIdeal := by
      rwa [← hL1]
    have h0 : L_raw 0 ∈ (ProjectiveSpectrum.asHomogeneousIdeal (ι_bar.left.base z)).toIdeal := by
      have hsub := Ideal.sub_mem _ h01 (Ideal.mul_mem_left _ (MvPolynomial.C r₀) h1)
      rwa [add_sub_cancel_right] at hsub
    exact ⟨h0, h1⟩

  have hNet_m0 : m = 0 → ∀ z : Z_bar.left,
      ∃ r : Fin 3, ι_bar.left.base z ∉ weilProjHyperplaneSet k M (L r) := by
    intro hm0 z
    by_contra hall
    push_neg at hall
    obtain ⟨h0, h1⟩ := hVanish01 z (hall 0) (hall 1)
    obtain ⟨r, hr⟩ := hNet_m0_tilde hm0 z
    fin_cases r
    · exact hr h0
    · exact hr h1
    · exact hr (hall 2)

  
  have hAwayLin : ∀ (n_v : ℕ) (α₀ : Fin (M + 1)) (V : Z_bar.left.Opens)
      (hAffV : AlgebraicGeometry.IsAffineOpen V)
      (hVα : V ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α₀)))
      (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (M + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
      (hpos : 0 < 1)
      (φ : MvPolynomial (Fin n_v) k →+* ↑(Z_bar.left.presheaf.obj (Opposite.op V)))
      (_hComm : V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V.ι ≫ Z_bar.hom)
      (F₀ F₁ F_sum : MvPolynomial (Fin (M + 1)) k)
      (hF₀ : F₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
      (hF₁ : F₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
      (hF_sum : F_sum ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
      (_hEq_sum : F_sum = F₀ + MvPolynomial.C r₀ * F₁),
      let ψ := ((AlgebraicGeometry.Proj.basicOpenIsoAway
          (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
          (MvPolynomial.X α₀) hXα hpos).hom ≫
        ι_bar.left.appLE
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α₀))
          V hVα).hom
      ψ (HomogeneousLocalization.mk ⟨1, ⟨F_sum, hF_sum⟩,
          ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩) =
        ψ (HomogeneousLocalization.mk ⟨1, ⟨F₀, hF₀⟩,
            ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩) +
        φ (MvPolynomial.C r₀) *
          ψ (HomogeneousLocalization.mk ⟨1, ⟨F₁, hF₁⟩,
              ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩) := by
    intro n_v α₀ V hAffV hVα hXα hpos φ hComm F₀ F₁ F_sum hF₀ hF₁ hF_sum hEq_sum
    let f_Z : Z_bar.left ⟶ AlgebraicGeometry.Proj 𝒜_M := ι_bar.left
    let Dα : (AlgebraicGeometry.Proj 𝒜_M).Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀)
    have hVα' : V ≤ (TopologicalSpace.Opens.map f_Z.base).obj Dα := hVα
    let ψ_mor : CommRingCat.of (HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α₀)) ⟶
        Z_bar.left.presheaf.obj (Opposite.op V) :=
      AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X α₀) ≫ f_Z.appLE Dα V hVα'
    have hψ_eq :
        ((AlgebraicGeometry.Proj.basicOpenIsoAway
            (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
            (MvPolynomial.X α₀) hXα hpos).hom ≫
          ι_bar.left.appLE
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α₀))
            V hVα) = ψ_mor := by
      change (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α₀) hXα hpos).hom ≫
        f_Z.appLE Dα V hVα' = ψ_mor
      rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
    dsimp only []
    rw [hψ_eq]
    let c_hom : k →+* HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α₀) :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜_M (Submonoid.powers (MvPolynomial.X α₀))).comp
        (algebraMap k ↥(𝒜_M 0))
    have hConst : φ (MvPolynomial.C r₀) = ψ_mor.hom (c_hom r₀) := by
      have hSpec_φ : V.toSpecΓ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp MvPolynomial.C)) =
          V.ι ≫ Z_bar.hom := by
        have hc : CommRingCat.ofHom (φ.comp MvPolynomial.C) =
            CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom φ := rfl
        rw [hc, AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc]
        simpa only [CategoryTheory.Category.assoc] using hComm
      have hSpec_sq : V.toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ_mor =
          f_Z.resLE Dα V hVα' ≫
            AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_M (MvPolynomial.X α₀) := by
        dsimp only [ψ_mor]
        rw [AlgebraicGeometry.Spec.map_comp,
          AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE_assoc]
        rfl
      have hSpec_ψ : V.toSpecΓ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_mor.hom.comp c_hom)) =
          V.ι ≫ Z_bar.hom := by
        have hhom : CommRingCat.ofHom (ψ_mor.hom.comp c_hom) =
            CommRingCat.ofHom c_hom ≫ ψ_mor := rfl
        have hc_comp : CommRingCat.ofHom c_hom =
            CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0)) ≫
              CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜_M
                (Submonoid.powers (MvPolynomial.X α₀))) := rfl
        let hom_P : AlgebraicGeometry.Proj 𝒜_M ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
          AlgebraicGeometry.Proj.toSpecZero 𝒜_M ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0)))
        have hf_w : f_Z ≫ hom_P = Z_bar.hom := CategoryTheory.Over.w ι_bar
        rw [hhom, AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
          hSpec_sq, hc_comp, AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_M (MvPolynomial.X α₀) hXα hpos,
          ← AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_M (MvPolynomial.X α₀) hXα hpos]
        calc (f_Z.resLE Dα V hVα' ≫
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (MvPolynomial.X α₀) hXα hpos).hom) ≫
              (AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α₀) hXα hpos ≫
                AlgebraicGeometry.Proj.toSpecZero 𝒜_M) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0)))
            = f_Z.resLE Dα V hVα' ≫
                ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (MvPolynomial.X α₀) hXα hpos).hom ≫
                  (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (MvPolynomial.X α₀) hXα hpos).inv ≫
                  Dα.ι) ≫ hom_P := by
              rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_M (MvPolynomial.X α₀) hXα hpos]
              simp only [hom_P, Dα, CategoryTheory.Category.assoc]
          _ = (f_Z.resLE Dα V hVα' ≫ Dα.ι) ≫ hom_P := by
              rw [CategoryTheory.Iso.hom_inv_id_assoc, ← CategoryTheory.Category.assoc]
          _ = V.ι ≫ f_Z ≫ hom_P := by
              rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, CategoryTheory.Category.assoc]
          _ = V.ι ≫ Z_bar.hom := by rw [hf_w]
      haveI : CategoryTheory.IsIso V.toSpecΓ := by
        rw [← hAffV.isoSpec_hom]; infer_instance
      have hEqMap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp MvPolynomial.C)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_mor.hom.comp c_hom)) :=
        (CategoryTheory.cancel_epi V.toSpecΓ).mp (hSpec_φ.trans hSpec_ψ.symm)
      have hEqHom := congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hEqMap)
      exact congrFun (congrArg DFunLike.coe hEqHom) r₀
    rw [hConst, ← map_mul, ← map_add]
    congr 1
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_add, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
    have hc_val : (c_hom r₀).val = Localization.mk (MvPolynomial.C r₀) 1 := rfl
    rw [hc_val, Localization.mk_mul, Localization.add_mk, one_mul,
      Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [Submonoid.coe_one, Submonoid.coe_mul, one_mul, hEq_sum]
    ring

  have hTrans_axis : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m) 2 ![L 0, L 1] := by
    refine ⟨fun j => by fin_cases j; exact hL_homog 0; exact hL_homog 1, ?_⟩
    intro x hxU hxAll
    obtain ⟨hx0, hx1⟩ := hVanish01 x (hxAll 0) (hxAll 1)
    obtain ⟨α₀, V, hAffV, hxV, hVU, hVα, hXα, hpos, s, φ, q, f_raw_lift, idx,
      hSurj, hInj, hComm, hKer, hf_raw_eq, hUnit_s, hUnit_s2⟩ :=
      hTrans_axis_tilde.2 x hxU (fun j => by fin_cases j; exact hx0; exact hx1)
    let f_lift : Fin 2 → MvPolynomial (Fin (s + 2 + 2 * m)) k :=
      ![f_raw_lift 1, f_raw_lift 0 + MvPolynomial.C r₀ * f_raw_lift 1]
    refine ⟨α₀, V, hAffV, hxV, hVU, hVα, hXα, hpos, s, φ, q, f_lift, idx,
      hSurj, hInj, hComm, hKer, ?_, hUnit_s, ?_⟩
    · intro j hFj
      fin_cases j
      · exact hf_raw_eq 1 (hL_raw_homog 1)
      · change φ (f_raw_lift 0 + MvPolynomial.C r₀ * f_raw_lift 1) = _
        rw [map_add, map_mul, hf_raw_eq 0 (hL_raw_homog 0), hf_raw_eq 1 (hL_raw_homog 1)]
        exact (hAwayLin _ α₀ V hAffV hVα hXα hpos φ hComm
          (![L_raw 0, L_raw 1] 0) (![L_raw 0, L_raw 1] 1) (![L 0, L 1] 1)
          (hL_raw_homog 0) (hL_raw_homog 1) hFj hL1).symm
    · let R_V := ↑(Z_bar.left.presheaf.obj (Opposite.op V))
      let A_old : Matrix (Fin (s + 2)) (Fin (s + 2)) R_V :=
        Matrix.of fun a b => φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_raw_lift a))
      let A_new : Matrix (Fin (s + 2)) (Fin (s + 2)) R_V :=
        Matrix.of fun a b => φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a))
      change IsUnit A_new.det
      let e := @finSumFinEquiv s 2
      let T₂ : Matrix (Fin 2) (Fin 2) R_V := ![![0, 1], ![1, φ (MvPolynomial.C r₀)]]
      have hDet_T₂ : T₂.det = -1 := by
        rw [Matrix.det_fin_two]
        simp [T₂]
      have hSub_eq : A_new.submatrix e e =
          Matrix.fromBlocks (1 : Matrix (Fin s) (Fin s) R_V) 0 0 T₂ * A_old.submatrix e e := by
        ext i b
        rw [Matrix.mul_apply, Fintype.sum_sum_type]
        cases i with
        | inl a =>
          simp [Matrix.fromBlocks, Matrix.one_apply, A_new, A_old, e]
        | inr r =>
          have h0 : ∑ x : Fin s, (0 : Matrix (Fin 2) (Fin s) R_V) r x *
              (A_old.submatrix e e) (Sum.inl x) b = 0 := by simp
          simp only [Matrix.fromBlocks_apply₂₁, Matrix.fromBlocks_apply₂₂]
          rw [h0, zero_add, Fin.sum_univ_two]
          fin_cases r <;>
            simp [T₂, A_new, A_old, e, f_lift, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C]
      rw [← Matrix.det_submatrix_equiv_self e A_new, hSub_eq, Matrix.det_mul,
        Matrix.det_fromBlocks_zero₂₁, Matrix.det_one, one_mul, hDet_T₂,
        Matrix.det_submatrix_equiv_self e A_old]
      exact isUnit_one.neg.mul hUnit_s2

  have hNet_pos : 1 ≤ m → IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m - 1) 3 L := by
    intro hm
    have htilde := hNet_pos_tilde hm
    refine ⟨hL_homog, ?_⟩
    intro x hxU hxAll
    obtain ⟨hx0, hx1⟩ := hVanish01 x (hxAll 0) (hxAll 1)
    have hxAll_tilde : ∀ j : Fin 3, ι_bar.left.base x ∈ weilProjHyperplaneSet k M (L_raw j) := by
      intro j
      fin_cases j
      · exact hx0
      · exact hx1
      · exact hxAll 2
    obtain ⟨α₀, V, hAffV, hxV, hVU, hVα, hXα, hpos, s, φ, q, f_raw_lift, idx,
      hSurj, hInj, hComm, hKer, hf_raw_eq, hUnit_s, hUnit_s3⟩ :=
      htilde.2 x hxU hxAll_tilde
    let f_lift : Fin 3 → MvPolynomial (Fin (s + 3 + (2 * m - 1))) k :=
      ![f_raw_lift 1, f_raw_lift 0 + MvPolynomial.C r₀ * f_raw_lift 1, f_raw_lift 2]
    refine ⟨α₀, V, hAffV, hxV, hVU, hVα, hXα, hpos, s, φ, q, f_lift, idx,
      hSurj, hInj, hComm, hKer, ?_, hUnit_s, ?_⟩
    · intro j hFj
      fin_cases j
      · exact hf_raw_eq 1 (hL_raw_homog 1)
      · change φ (f_raw_lift 0 + MvPolynomial.C r₀ * f_raw_lift 1) = _
        rw [map_add, map_mul, hf_raw_eq 0 (hL_raw_homog 0), hf_raw_eq 1 (hL_raw_homog 1)]
        exact (hAwayLin _ α₀ V hAffV hVα hXα hpos φ hComm
          (L_raw 0) (L_raw 1) (L 1)
          (hL_raw_homog 0) (hL_raw_homog 1) hFj hL1).symm
      · exact hf_raw_eq 2 (hL_raw_homog 2)
    · let R_V := ↑(Z_bar.left.presheaf.obj (Opposite.op V))
      let A_old : Matrix (Fin (s + 3)) (Fin (s + 3)) R_V :=
        Matrix.of fun a b => φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_raw_lift a))
      let A_new : Matrix (Fin (s + 3)) (Fin (s + 3)) R_V :=
        Matrix.of fun a b => φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a))
      change IsUnit A_new.det
      let e := @finSumFinEquiv s 3
      let T₃ : Matrix (Fin 3) (Fin 3) R_V :=
        ![![0, 1, 0], ![1, φ (MvPolynomial.C r₀), 0], ![0, 0, 1]]
      have hDet_T₃ : T₃.det = -1 := by
        rw [Matrix.det_fin_three]
        simp [T₃]
      have hSub_eq : A_new.submatrix e e =
          Matrix.fromBlocks (1 : Matrix (Fin s) (Fin s) R_V) 0 0 T₃ * A_old.submatrix e e := by
        ext i b
        rw [Matrix.mul_apply, Fintype.sum_sum_type]
        cases i with
        | inl a =>
          simp [Matrix.fromBlocks, Matrix.one_apply, A_new, A_old, e]
        | inr r =>
          have h0 : ∑ x : Fin s, (0 : Matrix (Fin 3) (Fin s) R_V) r x *
              (A_old.submatrix e e) (Sum.inl x) b = 0 := by simp
          simp only [Matrix.fromBlocks_apply₂₁, Matrix.fromBlocks_apply₂₂]
          rw [h0, zero_add, Fin.sum_univ_three]
          fin_cases r <;>
            simp [T₃, A_new, A_old, e, f_lift, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C]
      rw [← Matrix.det_submatrix_equiv_self e A_new, hSub_eq, Matrix.det_mul,
        Matrix.det_fromBlocks_zero₂₁, Matrix.det_one, one_mul, hDet_T₃,
        Matrix.det_submatrix_equiv_self e A_old]
      exact isUnit_one.neg.mul hUnit_s3

  
  let P_raw_disc : MvPolynomial (Fin 3) k :=
    MvPolynomial.eval₂ MvPolynomial.C
      (fun μ : Fin (M + 1) => ∑ r : Fin 3, MvPolynomial.C (ℓ_raw r μ) * MvPolynomial.X r) P_amb
  let P_disc : MvPolynomial (Fin 3) k :=
    MvPolynomial.eval₂ MvPolynomial.C
      (fun μ : Fin (M + 1) => ∑ r : Fin 3, MvPolynomial.C (ℓ r μ) * MvPolynomial.X r) P_amb
  obtain ⟨hP_raw_homog, hP_raw_irred⟩ := hΔ_irred ℓ_tilde hℓ_irred

  let σ_fwd : MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 3) k :=
    MvPolynomial.aeval ![MvPolynomial.X 1,
      MvPolynomial.X 0 + MvPolynomial.C r₀ * MvPolynomial.X 1, MvPolynomial.X 2]
  let σ_inv : MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 3) k :=
    MvPolynomial.aeval ![MvPolynomial.X 1 - MvPolynomial.C r₀ * MvPolynomial.X 0,
      MvPolynomial.X 0, MvPolynomial.X 2]
  have hσ_left : σ_inv.comp σ_fwd = AlgHom.id k _ := by
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i <;> simp [σ_fwd, σ_inv] <;> ring
  have hσ_right : σ_fwd.comp σ_inv = AlgHom.id k _ := by
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i <;> simp [σ_fwd, σ_inv] <;> ring
  let σ_equiv : MvPolynomial (Fin 3) k ≃ₐ[k] MvPolynomial (Fin 3) k :=
    AlgEquiv.ofAlgHom σ_fwd σ_inv hσ_right hσ_left

  have hP_disc_eq_fwd : P_disc = σ_fwd P_raw_disc := by
    let φ₁ : MvPolynomial (Fin (M + 1)) k →ₐ[k] MvPolynomial (Fin 3) k :=
      MvPolynomial.aeval fun μ => ∑ r : Fin 3, MvPolynomial.C (ℓ r μ) * MvPolynomial.X r
    let φ₂ : MvPolynomial (Fin (M + 1)) k →ₐ[k] MvPolynomial (Fin 3) k :=
      σ_fwd.comp (MvPolynomial.aeval fun μ =>
        ∑ r : Fin 3, MvPolynomial.C (ℓ_raw r μ) * MvPolynomial.X r)
    have hφ_eq : φ₁ = φ₂ := by
      apply MvPolynomial.algHom_ext
      intro μ
      simp only [φ₁, φ₂, AlgHom.comp_apply, MvPolynomial.aeval_X, σ_fwd, Fin.sum_univ_three,
        map_add, map_mul, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq, ℓ,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        Matrix.head_cons, Matrix.tail_cons]
      ring
    exact DFunLike.congr_fun hφ_eq P_amb

  have hP_disc_irred : Irreducible P_disc := by
    have h_eq : P_disc = σ_equiv P_raw_disc := hP_disc_eq_fwd
    rw [h_eq]
    exact (MulEquiv.irreducible_iff σ_equiv.toRingEquiv.toMulEquiv).mpr hP_raw_irred

  have hP_disc_homog : P_disc ∈ 𝒜_2 D_amb := by
    change P_disc.IsHomogeneous D_amb
    have hP_amb_hom : P_amb.IsHomogeneous D_amb := hP_homog
    have hg_hom : ∀ μ : Fin (M + 1),
        (∑ r : Fin 3, MvPolynomial.C (ℓ r μ) * MvPolynomial.X r).IsHomogeneous 1 := by
      intro μ
      change _ ∈ 𝒜_2 1
      refine Submodule.sum_mem (𝒜_2 1) fun r _ => ?_
      rw [← MvPolynomial.smul_eq_C_mul]
      exact Submodule.smul_mem (𝒜_2 1) (ℓ r μ) (MvPolynomial.isHomogeneous_X k r)
    have h1 := hP_amb_hom.eval₂ (MvPolynomial.C : k →+* MvPolynomial (Fin 3) k) _
      (fun c => MvPolynomial.isHomogeneous_C (Fin 3) c) hg_hom
    rwa [one_mul] at h1

  
  have hEval_Pdisc : ∀ w : Fin 3 → k,
      MvPolynomial.eval w P_disc =
        MvPolynomial.eval (fun μ => ∑ r : Fin 3, w r * ℓ r μ) P_amb := by
    intro w
    let ψ₁ : MvPolynomial (Fin (M + 1)) k →ₐ[k] k :=
      (MvPolynomial.aeval w).comp
        (MvPolynomial.aeval fun μ => ∑ r : Fin 3, MvPolynomial.C (ℓ r μ) * MvPolynomial.X r)
    let ψ₂ : MvPolynomial (Fin (M + 1)) k →ₐ[k] k :=
      MvPolynomial.aeval fun μ => ∑ r : Fin 3, w r * ℓ r μ
    have hψ : ψ₁ = ψ₂ := by
      apply MvPolynomial.algHom_ext
      intro μ
      simp only [ψ₁, ψ₂, AlgHom.comp_apply, MvPolynomial.aeval_X, map_sum, map_mul,
        MvPolynomial.aeval_C, Algebra.algebraMap_self, RingHom.id_apply]
      refine Finset.sum_congr rfl fun r _ => mul_comm _ _
    exact DFunLike.congr_fun hψ P_amb

  have hEval_Pdisc_σ : ∀ w : Fin 3 → k,
      MvPolynomial.eval w P_disc = MvPolynomial.eval ![w 1, w 0 + r₀ * w 1, w 2] P_raw_disc := by
    intro w
    rw [hP_disc_eq_fwd]
    let ψ₁ : MvPolynomial (Fin 3) k →ₐ[k] k := (MvPolynomial.aeval w).comp σ_fwd
    let ψ₂ : MvPolynomial (Fin 3) k →ₐ[k] k :=
      MvPolynomial.aeval ![w 1, w 0 + r₀ * w 1, w 2]
    have hψ : ψ₁ = ψ₂ := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i <;> simp [ψ₁, ψ₂, σ_fwd]
    exact DFunLike.congr_fun hψ P_raw_disc

  
  have hDeriv_aeval : ∀ (v : Fin 3 → Polynomial k) (F : MvPolynomial (Fin 3) k),
      Polynomial.derivative (MvPolynomial.aeval v F) =
        ∑ i : Fin 3, MvPolynomial.aeval v (MvPolynomial.pderiv i F) *
          Polynomial.derivative (v i) := by
    intro v F
    induction F using MvPolynomial.induction_on with
    | C c =>
      simp only [MvPolynomial.aeval_C, Polynomial.algebraMap_eq, Polynomial.derivative_C,
        MvPolynomial.pderiv_C, map_zero, zero_mul, Finset.sum_const_zero]
    | add p q hp hq =>
      simp only [map_add, Polynomial.derivative_add, hp, hq, add_mul, Finset.sum_add_distrib]
    | mul_X p j hp =>
      simp only [map_mul, MvPolynomial.aeval_X, Polynomial.derivative_mul, hp,
        MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, Pi.single_apply]
      rw [Finset.sum_mul]
      simp only [map_add, map_mul, apply_ite (MvPolynomial.aeval v), map_one, map_zero,
        add_mul, mul_ite, mul_one, mul_zero, Finset.sum_add_distrib]
      congr 1
      · refine Finset.sum_congr rfl fun i _ => ?_
        rw [MvPolynomial.aeval_X]
        ring
      · simp only [ite_mul, zero_mul]
        rw [Finset.sum_ite_eq Finset.univ j]
        simp only [Finset.mem_univ, ↓reduceIte]

  have hEval_aeval_poly : ∀ (v : Fin 3 → Polynomial k) (x : k) (F : MvPolynomial (Fin 3) k),
      (MvPolynomial.aeval v F).eval x = MvPolynomial.eval (fun i => (v i).eval x) F := by
    intro v x F
    let ψ₁ : MvPolynomial (Fin 3) k →ₐ[k] k := (Polynomial.aeval x).comp (MvPolynomial.aeval v)
    let ψ₂ : MvPolynomial (Fin 3) k →ₐ[k] k := MvPolynomial.aeval (fun i => (v i).eval x)
    have hψ : ψ₁ = ψ₂ := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [ψ₁, ψ₂]
    exact DFunLike.congr_fun hψ F

  have hPline_eq_P_raw : P_line = MvPolynomial.aeval ![1, Polynomial.X, 0] P_raw_disc := by
    let ψ₁ : MvPolynomial (Fin (M + 1)) k →ₐ[k] Polynomial k :=
      MvPolynomial.aeval fun μ => Polynomial.C (ℓ_raw 0 μ) + Polynomial.C (ℓ_raw 1 μ) * Polynomial.X
    let ψ₂ : MvPolynomial (Fin (M + 1)) k →ₐ[k] Polynomial k :=
      (MvPolynomial.aeval ![1, Polynomial.X, 0]).comp
        (MvPolynomial.aeval fun μ => ∑ r : Fin 3, MvPolynomial.C (ℓ_raw r μ) * MvPolynomial.X r)
    have hψ : ψ₁ = ψ₂ := by
      apply MvPolynomial.algHom_ext
      intro μ
      simp [ψ₁, ψ₂, Fin.sum_univ_three, Polynomial.algebraMap_eq]
    exact DFunLike.congr_fun hψ P_amb

  have hDeriv_Pline : Polynomial.derivative P_line =
      MvPolynomial.aeval ![1, Polynomial.X, 0] (MvPolynomial.pderiv 1 P_raw_disc) := by
    rw [hPline_eq_P_raw, hDeriv_aeval, Fin.sum_univ_three]
    simp

  have hPdisc_X10 : MvPolynomial.aeval ![Polynomial.X, 1, 0] P_disc =
      P_line.comp (Polynomial.X + Polynomial.C r₀) := by
    rw [hP_disc_eq_fwd, hPline_eq_P_raw, Polynomial.comp_eq_aeval]
    let ψ₁ : MvPolynomial (Fin 3) k →ₐ[k] Polynomial k :=
      (MvPolynomial.aeval ![Polynomial.X, 1, 0]).comp σ_fwd
    let ψ₂ : MvPolynomial (Fin 3) k →ₐ[k] Polynomial k :=
      (Polynomial.aeval (Polynomial.X + Polynomial.C r₀)).comp
        (MvPolynomial.aeval ![1, Polynomial.X, 0])
    have hψ : ψ₁ = ψ₂ := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i <;> simp [ψ₁, ψ₂, σ_fwd, Polynomial.algebraMap_eq, add_comm]
    exact DFunLike.congr_fun hψ P_raw_disc

  have hEval_inf : MvPolynomial.eval ![0, 1, 0] P_disc = 0 := by
    rw [hEval_Pdisc_σ]
    have h1 := congrArg (Polynomial.eval r₀) hPline_eq_P_raw
    rw [hr₀_eval, hEval_aeval_poly] at h1
    have hv : (fun i : Fin 3 => (![1, Polynomial.X, 0] i : Polynomial k).eval r₀) =
        ![![0, 1, 0] 1, ![0, 1, 0] 0 + r₀ * ![0, 1, 0] 1, ![0, 1, 0] 2] := by
      funext i; fin_cases i <;> simp
    rw [hv] at h1
    exact h1.symm

  have hPderiv_inf : MvPolynomial.eval ![0, 1, 0] (MvPolynomial.pderiv (0 : Fin 3) P_disc) ≠ 0 := by
    have h1 : MvPolynomial.aeval (![Polynomial.X, 1, 0] : Fin 3 → Polynomial k)
          (MvPolynomial.pderiv 0 P_disc) =
        Polynomial.derivative
          (MvPolynomial.aeval (![Polynomial.X, 1, 0] : Fin 3 → Polynomial k) P_disc) := by
      rw [hDeriv_aeval, Fin.sum_univ_three]
      simp
    have h2 := congrArg (Polynomial.eval 0) h1
    rw [hEval_aeval_poly] at h2
    have hvec : (fun i : Fin 3 => (![Polynomial.X, 1, 0] i : Polynomial k).eval 0) = ![0, 1, 0] := by
      funext i; fin_cases i <;> simp
    rw [hvec, hPdisc_X10, Polynomial.derivative_comp, Polynomial.derivative_add,
      Polynomial.derivative_X, Polynomial.derivative_C, add_zero, one_mul,
      Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C,
      zero_add] at h2
    rw [h2]
    exact hPline_deriv_ne r₀ hr₀_eval

  have hEval_100 : MvPolynomial.eval ![1, 0, 0] P_disc ≠ 0 := by
    rw [hEval_Pdisc]
    have hvec : (fun μ : Fin (M + 1) => ∑ r : Fin 3, (![1, 0, 0] : Fin 3 → k) r * ℓ r μ) = ℓ_raw 1 := by
      funext μ
      simp [Fin.sum_univ_three, ℓ]
    rwa [hvec]

  let q_aff : Polynomial k := MvPolynomial.aeval ![1, Polynomial.X, 0] P_disc
  have hq_eval : ∀ b : k, q_aff.eval b = MvPolynomial.eval ![1, b, 0] P_disc := by
    intro b
    rw [hEval_aeval_poly]
    have hv : (fun i : Fin 3 => (![1, Polynomial.X, 0] i : Polynomial k).eval b) = ![1, b, 0] := by
      funext i; fin_cases i <;> simp
    rw [hv]
  have hq_ne : q_aff ≠ 0 := by
    intro h0
    have h00 := hq_eval 0
    rw [h0, Polynomial.eval_zero] at h00
    exact hEval_100 h00.symm
  let S_aff : Finset k := q_aff.roots.toFinset
  have hRoots_aff : ∀ b : k, MvPolynomial.eval ![1, b, 0] P_disc = 0 ↔ b ∈ S_aff := by
    intro b
    rw [← hq_eval b, Multiset.mem_toFinset, Polynomial.mem_roots hq_ne, Polynomial.IsRoot.def]

  
  have hHomogScale : ∀ {d : ℕ} (F : MvPolynomial (Fin 3) k),
      F.IsHomogeneous d → ∀ (a : k) (v : Fin 3 → k),
        MvPolynomial.eval (fun i => a * v i) F = a ^ d * MvPolynomial.eval v F := by
    intro d F hF a v
    rw [MvPolynomial.eval_eq, MvPolynomial.eval_eq, Finset.mul_sum]
    refine Finset.sum_congr rfl fun s hs => ?_
    have hs_deg : Finsupp.degree s = d := by
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp hs) (hF.coeff_eq_zero hne)
    rw [Finsupp.degree_apply] at hs_deg
    have hprod : (∏ i ∈ s.support, (a * v i) ^ s i) =
        a ^ d * ∏ i ∈ s.support, v i ^ s i := by
      calc (∏ i ∈ s.support, (a * v i) ^ s i)
          = ∏ i ∈ s.support, (a ^ s i * v i ^ s i) :=
            Finset.prod_congr rfl fun i _ => mul_pow a (v i) (s i)
        _ = (∏ i ∈ s.support, a ^ s i) * ∏ i ∈ s.support, v i ^ s i :=
            Finset.prod_mul_distrib
        _ = a ^ (∑ i ∈ s.support, s i) * ∏ i ∈ s.support, v i ^ s i := by
            rw [Finset.prod_pow_eq_pow_sum]
        _ = a ^ d * ∏ i ∈ s.support, v i ^ s i := by rw [hs_deg]
    rw [hprod]
    ring

  have hPderiv_aff : ∀ a ∈ S_aff,
      MvPolynomial.eval ![1, a, 0] (MvPolynomial.pderiv (1 : Fin 3) P_disc) ≠ 0 := by
    intro a ha
    have ha_eval : MvPolynomial.eval ![1, a, 0] P_disc = 0 := (hRoots_aff a).mpr ha
    have ha_ne : a ≠ 0 := by
      intro ha0
      subst ha0
      exact hEval_100 ha_eval
    
    have hP_hom_prop : P_disc.IsHomogeneous D_amb := hP_disc_homog
    have hEuler := congrArg (MvPolynomial.eval ![1, a, 0]) hP_hom_prop.sum_X_mul_pderiv
    simp only [Fin.sum_univ_three, map_add, map_mul, MvPolynomial.eval_X,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons,
      one_mul, zero_mul, add_zero, map_nsmul, ha_eval, smul_zero] at hEuler
    
    have h_p0_eq : MvPolynomial.eval ![1, a, 0] (MvPolynomial.pderiv 0 P_disc) =
        MvPolynomial.eval ![a, 1 + r₀ * a, 0] (MvPolynomial.pderiv 1 P_raw_disc) := by
      let v_a : Fin 3 → Polynomial k := ![Polynomial.X, Polynomial.C a, 0]
      let w_a : Fin 3 → Polynomial k :=
        ![Polynomial.C a, Polynomial.X + Polynomial.C (r₀ * a), 0]
      have h_poly_eq : MvPolynomial.aeval v_a P_disc = MvPolynomial.aeval w_a P_raw_disc := by
        rw [hP_disc_eq_fwd]
        let ψ₁ : MvPolynomial (Fin 3) k →ₐ[k] Polynomial k := (MvPolynomial.aeval v_a).comp σ_fwd
        let ψ₂ : MvPolynomial (Fin 3) k →ₐ[k] Polynomial k := MvPolynomial.aeval w_a
        have hψ : ψ₁ = ψ₂ := by
          apply MvPolynomial.algHom_ext
          intro i
          fin_cases i <;> simp [ψ₁, ψ₂, v_a, w_a, σ_fwd, Polynomial.algebraMap_eq, mul_assoc]
        exact DFunLike.congr_fun hψ P_raw_disc
      have hd_poly := congrArg (fun p => (Polynomial.derivative p).eval 1) h_poly_eq
      rw [hDeriv_aeval v_a P_disc, hDeriv_aeval w_a P_raw_disc, Fin.sum_univ_three,
        Fin.sum_univ_three] at hd_poly
      simp only [v_a, w_a, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        Matrix.head_cons, Matrix.tail_cons, Polynomial.derivative_X, Polynomial.derivative_C,
        Polynomial.derivative_add, Polynomial.derivative_zero, mul_one, mul_zero, add_zero,
        zero_add, hEval_aeval_poly] at hd_poly
      have hv1 : (fun i : Fin 3 => (![Polynomial.X, Polynomial.C a, 0] i : Polynomial k).eval 1) =
          ![1, a, 0] := by
        funext i; fin_cases i <;> simp
      have hw1 : (fun i : Fin 3 =>
          (![Polynomial.C a, Polynomial.X + Polynomial.C (r₀ * a), 0] i : Polynomial k).eval 1) =
          ![a, 1 + r₀ * a, 0] := by
        funext i; fin_cases i <;> simp
      rwa [hv1, hw1] at hd_poly
    
    let s_a : k := a⁻¹ + r₀
    have h_scale_vec : (fun i : Fin 3 => a * (![1, s_a, 0] : Fin 3 → k) i) =
        ![a, 1 + r₀ * a, 0] := by
      funext i
      fin_cases i
      · simp
      · simp [s_a, mul_add, mul_inv_cancel₀ ha_ne]
        ring
      · simp
    have hP_raw_hom_prop : P_raw_disc.IsHomogeneous D_amb := hP_raw_homog
    have hv_sa : (fun i : Fin 3 => (![1, Polynomial.X, 0] i : Polynomial k).eval s_a) =
        ![1, s_a, 0] := by
      funext i; fin_cases i <;> simp
    have h_root_sa : P_line.eval s_a = 0 := by
      have h0 : MvPolynomial.eval ![a, 1 + r₀ * a, 0] P_raw_disc = 0 := by
        have h := hEval_Pdisc_σ ![1, a, 0]
        have hv_1a0 : ![(![1, a, 0] : Fin 3 → k) 1,
            (![1, a, 0] : Fin 3 → k) 0 + r₀ * (![1, a, 0] : Fin 3 → k) 1,
            (![1, a, 0] : Fin 3 → k) 2] = ![a, 1 + r₀ * a, 0] := by
          funext i; fin_cases i <;> simp
        rw [ha_eval, hv_1a0] at h
        exact h.symm
      rw [← h_scale_vec, hHomogScale P_raw_disc hP_raw_hom_prop a ![1, s_a, 0]] at h0
      have h_eval_sa : MvPolynomial.eval ![1, s_a, 0] P_raw_disc = 0 :=
        (mul_eq_zero.mp h0).resolve_left (pow_ne_zero D_amb ha_ne)
      rw [hPline_eq_P_raw, hEval_aeval_poly, hv_sa]
      exact h_eval_sa
    have h_deriv_sa_ne : (Polynomial.derivative P_line).eval s_a ≠ 0 :=
      hPline_deriv_ne s_a h_root_sa
    have h_p0_ne : MvPolynomial.eval ![1, a, 0] (MvPolynomial.pderiv 0 P_disc) ≠ 0 := by
      rw [h_p0_eq, ← h_scale_vec,
        hHomogScale _ (hP_raw_hom_prop.pderiv (i := 1)) a ![1, s_a, 0]]
      have h_eval_d : MvPolynomial.eval ![1, s_a, 0] (MvPolynomial.pderiv 1 P_raw_disc) =
          (Polynomial.derivative P_line).eval s_a := by
        rw [hDeriv_Pline, hEval_aeval_poly, hv_sa]
      rw [h_eval_d]
      exact mul_ne_zero (pow_ne_zero (D_amb - 1) ha_ne) h_deriv_sa_ne
    intro hp1_zero
    rw [hp1_zero, mul_zero, add_zero] at hEuler
    exact h_p0_ne hEuler

  
  obtain ⟨u_val, hu_val⟩ := Infinite.exists_notMem_finset S_aff
  have hLinearComb_eq : ∀ w : Fin 3 → k,
      (∑ μ : Fin (M + 1), MvPolynomial.C (∑ r : Fin 3, w r * ℓ r μ) * MvPolynomial.X μ) =
        ∑ r : Fin 3, MvPolynomial.C (w r) * L r := by
    intro w
    dsimp [L]
    simp only [map_sum, map_mul, Finset.sum_mul, Finset.mul_sum, mul_assoc]
    exact Finset.sum_comm

  have hTrans_net_smooth : ∀ w : Fin 3 → k, w ≠ 0 → MvPolynomial.eval w P_disc ≠ 0 →
      IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m + 1) 1
        ![∑ r : Fin 3, MvPolynomial.C (w r) * L r] := by
    intro w hw_ne hw_eval
    let c_w : Fin (M + 1) → k := fun μ => ∑ r : Fin 3, w r * ℓ r μ
    have hcw_ne : c_w ≠ 0 := by
      intro hcw0
      have hsum0 : (∑ r : Fin 3, MvPolynomial.C (w r) * L r) = 0 := by
        rw [← hLinearComb_eq w]
        change (∑ μ : Fin (M + 1), MvPolynomial.C (c_w μ) * MvPolynomial.X μ) = 0
        rw [hcw0]
        simp
      exact hL_linIndep w hw_ne hsum0
    have hcw_eval : MvPolynomial.eval c_w P_amb ≠ 0 := by
      rwa [← hEval_Pdisc w]
    have htr := hTrans_out c_w hcw_ne hcw_eval
    rwa [hLinearComb_eq w] at htr

  have hTrans_u₀ : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m + 1) 1
      ![L 0 + MvPolynomial.C u_val * L 1] := by
    have hw_ne : (![1, u_val, 0] : Fin 3 → k) ≠ 0 := by
      intro h0
      exact one_ne_zero (congrFun h0 0)
    have hw_eval : MvPolynomial.eval ![1, u_val, 0] P_disc ≠ 0 :=
      fun hev => hu_val ((hRoots_aff u_val).mp hev)
    have htr := hTrans_net_smooth ![1, u_val, 0] hw_ne hw_eval
    have hcomb : (∑ r : Fin 3, MvPolynomial.C ((![1, u_val, 0] : Fin 3 → k) r) * L r) =
        L 0 + MvPolynomial.C u_val * L 1 := by
      simp [Fin.sum_univ_three]
    rwa [hcomb] at htr

  
  let g_lin : Fin (M + 1) → MvPolynomial (Fin 3) k :=
    fun μ => ∑ r : Fin 3, MvPolynomial.C (ℓ r μ) * MvPolynomial.X r
  have hg_homog : ∀ μ : Fin (M + 1), (g_lin μ).IsHomogeneous 1 := by
    intro μ
    change g_lin μ ∈ 𝒜_2 1
    refine Submodule.sum_mem (𝒜_2 1) fun r _ => ?_
    rw [← MvPolynomial.smul_eq_C_mul]
    exact Submodule.smul_mem (𝒜_2 1) (ℓ r μ) (MvPolynomial.isHomogeneous_X k r)
  let f_plane : 𝒜_M →+*ᵍ 𝒜_2 :=
    { toRingHom := (MvPolynomial.aeval g_lin).toRingHom
      map_mem := fun {d P} hP => by
        let hP' : P.IsHomogeneous d := hP
        have h1 := hP'.eval₂ (MvPolynomial.C : k →+* MvPolynomial (Fin 3) k) g_lin
          (fun c => MvPolynomial.isHomogeneous_C (Fin 3) c) hg_homog
        rw [one_mul] at h1
        change (MvPolynomial.aeval g_lin P).IsHomogeneous d
        rwa [MvPolynomial.aeval_def] }
  have hf_irr : HomogeneousIdeal.irrelevant 𝒜_2 ≤
      HomogeneousIdeal.map f_plane (HomogeneousIdeal.irrelevant 𝒜_M) := by
    rw [HomogeneousIdeal.irrelevant_le]
    intro i hi_pos F hFi
    change F ∈ Ideal.map f_plane.toRingHom (HomogeneousIdeal.irrelevant 𝒜_M).toIdeal
    let N_inv : Matrix (Fin 3) (Fin 3) k := M_ℓ⁻¹
    have hMN : M_ℓ * N_inv = 1 := Matrix.mul_nonsing_inv M_ℓ (IsUnit.mk0 _ hDet_Mℓ)
    let J : Ideal (MvPolynomial (Fin 3) k) :=
      Ideal.map f_plane.toRingHom (HomogeneousIdeal.irrelevant 𝒜_M).toIdeal
    have hX_mem : ∀ r₁ : Fin 3, (MvPolynomial.X r₁ : MvPolynomial (Fin 3) k) ∈ J := by
      intro r₁
      have h_lin : (MvPolynomial.X r₁ : MvPolynomial (Fin 3) k) =
          ∑ s : Fin 3, MvPolynomial.C (N_inv s r₁) * f_plane.toRingHom (MvPolynomial.X (emb3 s)) := by
        have h_rhs :
            (∑ s : Fin 3, MvPolynomial.C (N_inv s r₁) * f_plane.toRingHom (MvPolynomial.X (emb3 s))) =
              ∑ r : Fin 3, MvPolynomial.C ((M_ℓ * N_inv) r r₁) * MvPolynomial.X r := by
          calc (∑ s : Fin 3, MvPolynomial.C (N_inv s r₁) * f_plane.toRingHom (MvPolynomial.X (emb3 s)))
              = ∑ s : Fin 3, MvPolynomial.C (N_inv s r₁) *
                  (∑ r : Fin 3, MvPolynomial.C (M_ℓ r s) * MvPolynomial.X r) := by
                refine Finset.sum_congr rfl fun s _ => ?_
                change MvPolynomial.C (N_inv s r₁) *
                  MvPolynomial.aeval g_lin (MvPolynomial.X (emb3 s)) = _
                rw [MvPolynomial.aeval_X]
                rfl
            _ = ∑ s : Fin 3, ∑ r : Fin 3,
                  MvPolynomial.C (M_ℓ r s * N_inv s r₁) * MvPolynomial.X r := by
                refine Finset.sum_congr rfl fun s _ => ?_
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl fun r _ => ?_
                rw [← mul_assoc, ← map_mul, mul_comm (N_inv s r₁)]
            _ = ∑ r : Fin 3, ∑ s : Fin 3,
                  MvPolynomial.C (M_ℓ r s * N_inv s r₁) * MvPolynomial.X r := Finset.sum_comm
            _ = ∑ r : Fin 3, MvPolynomial.C ((M_ℓ * N_inv) r r₁) * MvPolynomial.X r := by
                refine Finset.sum_congr rfl fun r _ => ?_
                rw [← Finset.sum_mul, ← map_sum, Matrix.mul_apply]
        rw [h_rhs, hMN]
        simp only [Matrix.one_apply, apply_ite MvPolynomial.C, map_one, map_zero, ite_mul,
          one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
      rw [h_lin]
      refine Ideal.sum_mem J fun s _ => Ideal.mul_mem_left J _ ?_
      exact Ideal.mem_map_of_mem f_plane.toRingHom
        (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_M zero_lt_one
          (MvPolynomial.isHomogeneous_X k (emb3 s)))
    have hF_hom : F.IsHomogeneous i := hFi
    rw [F.as_sum]
    refine Ideal.sum_mem J fun d hd => ?_
    have hd_deg : Finsupp.degree d = i := by
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp hd) (hF_hom.coeff_eq_zero hne)
    have hd0 : d ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hd_deg
      omega
    obtain ⟨r₁, hr₁⟩ : ∃ r₁ : Fin 3, 0 < d r₁ := by
      by_contra hall
      push_neg at hall
      apply hd0
      ext r₁
      exact Nat.le_zero.mp (hall r₁)
    let d' : Fin 3 →₀ ℕ := d - Finsupp.single r₁ 1
    have hd_eq : d' + Finsupp.single r₁ 1 = d := by
      ext j
      simp only [d', Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
        Finsupp.single_apply]
      by_cases hj : r₁ = j
      · subst hj; simp; omega
      · simp [hj]
    have hmon : ∀ c : k, MvPolynomial.monomial d c =
        MvPolynomial.monomial d' c * MvPolynomial.X r₁ := fun c => by
      rw [MvPolynomial.X, MvPolynomial.monomial_mul, mul_one, hd_eq]
    rw [hmon]
    exact Ideal.mul_mem_left J _ (hX_mem r₁)

  let ι_P : AlgebraicGeometry.Proj 𝒜_2 ⟶ AlgebraicGeometry.Proj 𝒜_M :=
    AlgebraicGeometry.Proj.map f_plane hf_irr
  let F_bad_proj : Set (AlgebraicGeometry.Proj 𝒜_M) := F_bad
  let F_bad_plane : Set (weilProjectiveSpaceOver k 2).left := ι_P.base ⁻¹' F_bad_proj
  have hClosed_bad_plane : IsClosed F_bad_plane := hF_closed.preimage ι_P.continuous

  have hEval_fplane : ∀ (w : Fin 3 → k) (G : MvPolynomial (Fin (M + 1)) k),
      MvPolynomial.eval w (f_plane G) =
        MvPolynomial.eval (fun μ => ∑ r : Fin 3, w r * ℓ r μ) G := by
    intro w G
    let ψ₁ : MvPolynomial (Fin (M + 1)) k →ₐ[k] k :=
      (MvPolynomial.aeval w).comp (MvPolynomial.aeval g_lin)
    let ψ₂ : MvPolynomial (Fin (M + 1)) k →ₐ[k] k :=
      MvPolynomial.aeval fun μ => ∑ r : Fin 3, w r * ℓ r μ
    have hψ : ψ₁ = ψ₂ := by
      apply MvPolynomial.algHom_ext
      intro μ
      simp only [ψ₁, ψ₂, g_lin, AlgHom.comp_apply, MvPolynomial.aeval_X, map_sum, map_mul,
        MvPolynomial.aeval_C, Algebra.algebraMap_self, RingHom.id_apply]
      refine Finset.sum_congr rfl fun r _ => mul_comm _ _
    exact DFunLike.congr_fun hψ G

  have hAvoid_plane_line : ∀ (t : Fin 2 → k) (p : (weilProjectiveSpaceOver k 2).left),
      t ≠ 0 →
      (∀ (F : MvPolynomial (Fin 3) k) (d : ℕ),
        F ∈ 𝒜_2 d →
        (F ∈ ProjectiveSpectrum.asHomogeneousIdeal p ↔
          MvPolynomial.eval ![t 0, t 1, 0] F = 0)) →
      p ∉ F_bad_plane := by
    intro t p ht_ne hp_ideal
    let t_raw : Fin 2 → k := ![t 1, t 0 + r₀ * t 1]
    have ht_raw_ne : t_raw ≠ 0 := by
      intro h0
      have ht1 : t 1 = 0 := congrFun h0 0
      have ht01 : t 0 + r₀ * t 1 = 0 := congrFun h0 1
      rw [ht1, mul_zero, add_zero] at ht01
      apply ht_ne
      ext b; fin_cases b; exact ht01; exact ht1
    let p_proj : AlgebraicGeometry.Proj 𝒜_2 := p
    refine hAvoid_ℓ01 t_raw (ι_P.base p_proj) ht_raw_ne ?_
    intro G e hGe
    have hmem : (G ∈ ProjectiveSpectrum.asHomogeneousIdeal (ι_P.base p_proj) ↔
        f_plane G ∈ ProjectiveSpectrum.asHomogeneousIdeal p) := Iff.rfl
    rw [hmem, hp_ideal (f_plane G) e (f_plane.map_mem hGe), hEval_fplane]
    have hvec : (fun μ : Fin (M + 1) => ∑ r : Fin 3, (![t 0, t 1, 0] : Fin 3 → k) r * ℓ r μ) =
        fun μ => t_raw 0 * ℓ_raw 0 μ + t_raw 1 * ℓ_raw 1 μ := by
      funext μ
      simp only [Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, zero_mul, add_zero, ℓ, t_raw]
      ring
    rw [hvec]
    exact Iff.rfl

  
  obtain ⟨U₀, C_disc, ι_disc, U_disc_reg, hHyp_disc, hInt_disc, hProp_disc, hNe_reg,
    hSm_reg, hU₀_eq, hPre_line, hImg_line, hReg_pts⟩ :=
    hPlaneCurve D_amb P_disc S_aff F_bad_plane hD_amb hP_disc_homog hP_disc_irred
      hClosed_bad_plane hAvoid_plane_line hEval_inf hPderiv_inf hEval_100 hRoots_aff hPderiv_aff

  haveI : Algebra.IsAlgebraic k k := Algebra.IsAlgebraic.of_finite k k
  have hPb_id : CategoryTheory.IsPullback (𝟙 C_disc.left) C_disc.hom C_disc.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k k))) := by
    have halg : CommRingCat.ofHom (algebraMap k k) = 𝟙 (CommRingCat.of k) := by
      rw [Algebra.algebraMap_self, CommRingCat.ofHom_id]
    rw [halg, AlgebraicGeometry.Spec.map_id]
    exact CategoryTheory.IsPullback.of_id_fst
  have hGeom_disc : AlgebraicGeometry.GeometricallyIrreducible C_disc.hom :=
    weil_geometricallyIrreducible_of_algClosure_pullback k k C_disc C_disc
      hInt_disc (𝟙 C_disc.left) hPb_id

  
  refine ⟨{
    L := L
    j_aff := j_aff
    s_inf := s_inf
    ι_line := ι_line
    u_val := u_val
    hCoord_line := hCoord_line
    hLine_plane := hLine_plane
    hL_homog := hL_homog
    hL_linIndep := hL_linIndep
    hTrans_axis := hTrans_axis
    hNet_m0 := hNet_m0
    hNet_pos := hNet_pos
    hTrans_u₀ := hTrans_u₀
    hDichotomy := Or.inr ⟨S_aff, U₀, D_amb, P_disc, C_disc, ι_disc, U_disc_reg,
      hD_amb, hP_disc_irred, hHyp_disc, hInt_disc, hGeom_disc, hProp_disc,
      hNe_reg, hSm_reg, hu_val, hU₀_eq, hPre_line, hImg_line, hPderiv_inf,
      hPderiv_aff, hTrans_net_smooth, ?_⟩
  }⟩
  intro c hc_reg hc_closed
  obtain ⟨hc_not_bad, w, hw_ne, hw_ideal⟩ := hReg_pts c hc_reg hc_closed
  let c_w : Fin (M + 1) → k := fun μ => ∑ r : Fin 3, w r * ℓ r μ
  have hcw_ne : c_w ≠ 0 := by
    intro hcw0
    have hsum0 : (∑ r : Fin 3, MvPolynomial.C (w r) * L r) = 0 := by
      rw [← hLinearComb_eq w]
      change (∑ μ : Fin (M + 1), MvPolynomial.C (c_w μ) * MvPolynomial.X μ) = 0
      rw [hcw0]
      simp
    exact hL_linIndep w hw_ne hsum0
  have hPdisc_in_c : P_disc ∈ ProjectiveSpectrum.asHomogeneousIdeal (ι_disc.left.base c) := by
    obtain ⟨_, hRange_disc, _⟩ := hHyp_disc.2
    have hc_mem : ι_disc.left.base c ∈ Set.range ι_disc.left.base := ⟨c, rfl⟩
    rw [hRange_disc, Set.mem_compl_iff] at hc_mem
    let p_c : AlgebraicGeometry.Proj 𝒜_2 := ι_disc.left.base c
    change p_c ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_2 P_disc at hc_mem
    rwa [AlgebraicGeometry.Proj.mem_basicOpen, not_not] at hc_mem
  have hcw_eval : MvPolynomial.eval c_w P_amb = 0 := by
    rw [← hEval_Pdisc w]
    exact (hw_ideal P_disc D_amb hP_disc_homog).mp hPdisc_in_c
  have hcw_not_bad : ∀ q : (weilProjectiveSpaceOver k M).left,
      (∀ (G : MvPolynomial (Fin (M + 1)) k) (e : ℕ),
        G ∈ 𝒜_M e →
        (G ∈ ProjectiveSpectrum.asHomogeneousIdeal q ↔ MvPolynomial.eval c_w G = 0)) →
      q ∉ F_bad := by
    intro q hq_ideal
    let q' : AlgebraicGeometry.Proj 𝒜_M := q
    let p_c : AlgebraicGeometry.Proj 𝒜_2 := ι_disc.left.base c
    let q₀' : AlgebraicGeometry.Proj 𝒜_M := ι_P.base p_c
    have hq_eq : q' = q₀' := by
      apply ProjectiveSpectrum.ext
      ext G
      have hhom_iff : ∀ (H : MvPolynomial (Fin (M + 1)) k) (e : ℕ),
          H ∈ 𝒜_M e →
          (H ∈ q'.asHomogeneousIdeal ↔ H ∈ q₀'.asHomogeneousIdeal) := by
        intro H e hHe
        have hmem₀ : (H ∈ q₀'.asHomogeneousIdeal ↔
            f_plane H ∈ ProjectiveSpectrum.asHomogeneousIdeal (ι_disc.left.base c)) := Iff.rfl
        rw [hq_ideal H e hHe, hmem₀, hw_ideal (f_plane H) e (f_plane.map_mem hHe),
          hEval_fplane w H]
      exact ⟨fun hG => by
        rw [← DirectSum.sum_support_decompose 𝒜_M G]
        refine Ideal.sum_mem _ fun e _ => ?_
        exact (hhom_iff _ e (Subtype.prop _)).mp (q'.asHomogeneousIdeal.isHomogeneous e hG),
      fun hG => by
        rw [← DirectSum.sum_support_decompose 𝒜_M G]
        refine Ideal.sum_mem _ fun e _ => ?_
        exact (hhom_iff _ e (Subtype.prop _)).mpr (q₀'.asHomogeneousIdeal.isHomogeneous e hG)⟩
    change q' ∉ F_bad_proj
    rw [hq_eq]
    exact hc_not_bad
  obtain ⟨z_c, hClosed_zc, hOdp_zc, hTrans_zc⟩ :=
    hOdp_on c_w hcw_ne hcw_eval hcw_not_bad
  rw [hLinearComb_eq w] at hOdp_zc hTrans_zc
  exact ⟨w, z_c, hClosed_zc, hw_ne, hw_ideal, hOdp_zc, hTrans_zc⟩

theorem weil_algClosed_transversal_slice_and_smooth_connected_integral (k : Type u) [Field k] [IsAlgClosed k] :
    (∀ (N d ν : ℕ)
        (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper X.hom]
        (ι_X : X ⟶ weilProjectiveSpaceOver k N),
      AlgebraicGeometry.IsClosedImmersion ι_X.left →
      ∀ (F : Fin ν → MvPolynomial (Fin (N + 1)) k),
      IsTransversalLinearSlice k N X ι_X ⊤ d ν F →
      ∃ (S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ι_S : S ⟶ X),
        AlgebraicGeometry.IsClosedImmersion ι_S.left ∧
        AlgebraicGeometry.IsProper S.hom ∧
        IsProjectiveOverField k S ∧
        AlgebraicGeometry.SmoothOfRelativeDimension d S.hom ∧
        Set.range ι_S.left.base =
          { x : X.left | ∀ j : Fin ν, ι_X.left.base x ∈ weilProjHyperplaneSet k N (F j) } ∧
        (ν = 1 → (∀ j : Fin ν, F j ≠ 0) →
          ∃ U_aff : X.left.Opens,
            (U_aff : Set X.left) = (Set.range ι_S.left.base)ᶜ ∧
            AlgebraicGeometry.IsAffineOpen U_aff) ∧
        (1 ≤ ν →
          (∃ j : Fin ν, ∃ x : X.left, ι_X.left.base x ∉ weilProjHyperplaneSet k N (F j)) →
          ∃ U_c : X.left.Opens,
            (U_c : Set X.left) = (Set.range ι_S.left.base)ᶜ ∧
            Nonempty U_c)) ∧
    (∀ (d : ℕ)
        (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.SmoothOfRelativeDimension d W.hom],
      ConnectedSpace ↥W.left →
      AlgebraicGeometry.IsIntegral W.left ∧
      topologicalKrullDim W.left = (d : WithBot ℕ∞)) ∧
    (∀ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
      AlgebraicGeometry.IsIntegral C.left →
      ∀ [AlgebraicGeometry.IsProper C.hom]
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom],
      IsProjectiveOverField k C →
      ∃ (H₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (i_H : H₀ ⟶ C),
        AlgebraicGeometry.IsIntegral H₀.left ∧
        AlgebraicGeometry.IsProper H₀.hom ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 0 H₀.hom ∧
        IsProjectiveOverField k H₀ ∧
        AlgebraicGeometry.IsClosedImmersion i_H.left) :=
by
  classical
  have helper_submersiveSmoothAlg :
      ∀ (s ν d : ℕ) (A B : Type u) [CommRing A] [CommRing B] [Algebra k B]
        (π : A →+* B) (hπ_surj : Function.Surjective π)
        (φ : MvPolynomial (Fin (s + ν + d)) k →+* A) (hφ_surj : Function.Surjective φ)
        (hAlg : algebraMap k B = (π.comp φ).comp MvPolynomial.C)
        (q : Fin s → MvPolynomial (Fin (s + ν + d)) k)
        (hker_φ : RingHom.ker φ = Ideal.span (Set.range q))
        (f_lift : Fin ν → MvPolynomial (Fin (s + ν + d)) k)
        (hker_π : RingHom.ker π = Ideal.span (Set.range (fun j : Fin ν => φ (f_lift j))))
        (idx : Fin (s + ν) → Fin (s + ν + d)) (hidx : Function.Injective idx)
        (hJ : IsUnit (Matrix.det (Matrix.of fun a b : Fin (s + ν) =>
          φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a))))),
        Algebra.IsStandardSmoothOfRelativeDimension d k B := by
    intro s ν d A B _ _ _ π hπ_surj φ hφ_surj hAlg q hker_φ f_lift hker_π idx hidx hJ
    let φ_B : MvPolynomial (Fin (s + ν + d)) k →+* B := π.comp φ
    have h_aeval_eq : (MvPolynomial.aeval (R := k) (S₁ := B)
        (fun i : Fin (s + ν + d) => φ_B (MvPolynomial.X i))).toRingHom = φ_B := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_comp, RingHom.coe_coe, Function.comp_apply,
          MvPolynomial.aeval_C, hAlg]
        rfl
      · intro i
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X]
    have h_aeval_surj : Function.Surjective
        (MvPolynomial.aeval (R := k) (S₁ := B) (fun i => φ_B (MvPolynomial.X i))) := by
      change Function.Surjective (MvPolynomial.aeval (R := k) (S₁ := B)
        (fun i => φ_B (MvPolynomial.X i))).toRingHom
      rw [h_aeval_eq]
      exact hπ_surj.comp hφ_surj
    let G : Algebra.Generators k B (Fin (s + ν + d)) :=
      Algebra.Generators.ofSurjective (fun i => φ_B (MvPolynomial.X i)) h_aeval_surj
    have hG_algMap : (algebraMap G.Ring B : MvPolynomial (Fin (s + ν + d)) k →+* B) = φ_B :=
      h_aeval_eq
    let rel : Fin (s + ν) → G.Ring :=
      Fin.addCases (motive := fun _ => G.Ring) q f_lift
    have hG_ker : Ideal.span (Set.range rel) = G.ker := by
      apply Ideal.ext
      intro P
      have hmem_ker : P ∈ G.ker ↔ φ_B P = 0 := by
        change P ∈ RingHom.ker (algebraMap G.Ring B) ↔ φ_B P = 0
        rw [RingHom.mem_ker]
        exact Eq.congr_left (RingHom.congr_fun hG_algMap P)
      rw [hmem_ker]
      constructor
      · intro hP_span
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hP_span
        · rintro _ ⟨a, rfl⟩
          refine Fin.addCases (fun a₀ => ?_) (fun j₀ => ?_) a
          · show π (φ (rel (Fin.castAdd ν a₀))) = 0
            have hrel_q : rel (Fin.castAdd ν a₀) = q a₀ := by simp [rel]
            rw [hrel_q]
            have h0 : φ (q a₀) = 0 := by
              rw [← RingHom.mem_ker, hker_φ]
              exact Ideal.subset_span ⟨a₀, rfl⟩
            rw [h0, map_zero]
          · show π (φ (rel (Fin.natAdd s j₀))) = 0
            have hrel_f : rel (Fin.natAdd s j₀) = f_lift j₀ := by simp [rel]
            rw [hrel_f, ← RingHom.mem_ker, hker_π]
            exact Ideal.subset_span ⟨j₀, rfl⟩
        · exact map_zero φ_B
        · intro x y _ _ hx hy
          rw [map_add, hx, hy, add_zero]
        · intro c x _ hx
          rw [smul_eq_mul, map_mul, hx, mul_zero]
      · intro hP
        have hφP : φ P ∈ RingHom.ker π := hP
        rw [hker_π] at hφP
        have hmap_span : Ideal.span (Set.range (fun j : Fin ν => φ (f_lift j))) =
            Ideal.map φ (Ideal.span (Set.range f_lift)) := by
          rw [Ideal.map_span]
          congr 1
          ext y
          simp only [Set.mem_range, Set.mem_image, exists_exists_eq_and]
        rw [hmap_span] at hφP
        have hex : ∃ Q ∈ Ideal.span (Set.range f_lift), φ Q = φ P := by
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hφP
          · rintro _ ⟨Q, hQ, rfl⟩
            exact ⟨Q, hQ, rfl⟩
          · exact ⟨0, Ideal.zero_mem _, map_zero φ⟩
          · rintro _ _ _ _ ⟨Q₁, hQ₁, h1⟩ ⟨Q₂, hQ₂, h2⟩
            exact ⟨Q₁ + Q₂, Ideal.add_mem _ hQ₁ hQ₂, by rw [map_add, h1, h2]⟩
          · rintro a₀ _ _ ⟨Q, hQ, h1⟩
            obtain ⟨R₀, rfl⟩ := hφ_surj a₀
            exact ⟨R₀ * Q, Ideal.mul_mem_left _ R₀ hQ, by rw [map_mul, h1, smul_eq_mul]⟩
        obtain ⟨Q, hQ_mem, hQ_eq⟩ := hex
        have hPQ : P - Q ∈ RingHom.ker φ := by
          rw [RingHom.mem_ker, map_sub, hQ_eq, sub_self]
        rw [hker_φ] at hPQ
        have hsub_q : Ideal.span (Set.range q) ≤ Ideal.span (Set.range rel) := by
          refine Ideal.span_mono ?_
          rintro _ ⟨a₀, rfl⟩
          exact ⟨Fin.castAdd ν a₀, by simp [rel]⟩
        have hsub_f : Ideal.span (Set.range f_lift) ≤ Ideal.span (Set.range rel) := by
          refine Ideal.span_mono ?_
          rintro _ ⟨j₀, rfl⟩
          exact ⟨Fin.natAdd s j₀, by simp [rel]⟩
        have hP_eq : P = (P - Q) + Q := (sub_add_cancel P Q).symm
        rw [hP_eq]
        exact Ideal.add_mem _ (hsub_q hPQ) (hsub_f hQ_mem)
    let P_pres : Algebra.Presentation k B (Fin (s + ν + d)) (Fin (s + ν)) :=
      { toGenerators := G
        relation := rel
        span_range_relation_eq_ker := hG_ker }
    let P_pre : Algebra.PreSubmersivePresentation k B (Fin (s + ν + d)) (Fin (s + ν)) :=
      { toPresentation := P_pres
        map := idx
        map_inj := hidx }
    have hJac_unit : IsUnit P_pre.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, ← Matrix.det_transpose]
      have halg_det : (algebraMap P_pre.Ring B) (Matrix.transpose P_pre.jacobiMatrix).det =
          φ_B (Matrix.transpose P_pre.jacobiMatrix).det :=
        RingHom.congr_fun hG_algMap _
      rw [halg_det]
      have hmat_eq : φ.mapMatrix (Matrix.transpose P_pre.jacobiMatrix) =
          Matrix.of (fun a b : Fin (s + ν) =>
            φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a))) := by
        ext a b
        simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.transpose_apply,
          Algebra.PreSubmersivePresentation.jacobiMatrix_apply, Matrix.of_apply]
        rfl
      have hdet_eq : φ_B (Matrix.transpose P_pre.jacobiMatrix).det =
          π ((Matrix.of fun a b : Fin (s + ν) =>
            φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a))).det) := by
        change π (φ (Matrix.transpose P_pre.jacobiMatrix).det) = _
        rw [RingHom.map_det, hmat_eq]
      rw [hdet_eq]
      exact hJ.map π
    let P_sub : Algebra.SubmersivePresentation k B (Fin (s + ν + d)) (Fin (s + ν)) :=
      { toPreSubmersivePresentation := P_pre
        jacobian_isUnit := hJac_unit }
    have hdim : P_sub.dimension = d := by
      show Nat.card (Fin (s + ν + d)) - Nat.card (Fin (s + ν)) = d
      rw [Nat.card_fin, Nat.card_fin]
      omega
    exact P_sub.isStandardSmoothOfRelativeDimension hdim

  have helper_projLinearSlice :
      ∀ (N ν : ℕ)
        (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper X.hom]
        (ι_X : X ⟶ weilProjectiveSpaceOver k N)
        (hClX : AlgebraicGeometry.IsClosedImmersion ι_X.left)
        (F : Fin ν → MvPolynomial (Fin (N + 1)) k)
        (hF : ∀ j : Fin ν, F j ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1),
      ∃ (S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ι_S : S ⟶ X),
        AlgebraicGeometry.IsClosedImmersion ι_S.left ∧
        AlgebraicGeometry.IsProper S.hom ∧
        IsProjectiveOverField k S ∧
        Set.range ι_S.left.base =
          { x : X.left | ∀ j : Fin ν, ι_X.left.base x ∈ weilProjHyperplaneSet k N (F j) } ∧
        (∀ (α₀ : Fin (N + 1)) (V : X.left.Opens),
          AlgebraicGeometry.IsAffineOpen V →
          ∀ (hVα : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
                MvPolynomial.gradedAlgebra
              V ≤ (TopologicalSpace.Opens.map ι_X.left.base).obj
                (AlgebraicGeometry.Proj.basicOpen
                  (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X α₀)))
            (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (N + 1)) k) ∈
              MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
            (hpos : 0 < 1),
            letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
              MvPolynomial.gradedAlgebra
            Function.Surjective (ι_S.left.app V).hom ∧
            RingHom.ker (ι_S.left.app V).hom =
              Ideal.span (Set.range (fun j : Fin ν =>
                ((AlgebraicGeometry.Proj.basicOpenIsoAway
                  (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
                  (MvPolynomial.X α₀) hXα hpos).hom ≫
                  ι_X.left.appLE
                    (AlgebraicGeometry.Proj.basicOpen
                      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X α₀))
                    V hVα).hom
                  (HomogeneousLocalization.mk
                    ⟨1, ⟨F j, hF j⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩)))) ∧
        (ν = 1 → (∀ j : Fin ν, F j ≠ 0) →
          ∃ U_aff : X.left.Opens,
            (U_aff : Set X.left) = (Set.range ι_S.left.base)ᶜ ∧
            AlgebraicGeometry.IsAffineOpen U_aff) ∧
        (1 ≤ ν →
          (∃ j : Fin ν, ∃ x : X.left, ι_X.left.base x ∉ weilProjHyperplaneSet k N (F j)) →
          ∃ U_c : X.left.Opens,
            (U_c : Set X.left) = (Set.range ι_S.left.base)ᶜ ∧
            Nonempty U_c) := by
    intro N ν X hPropX ι_X hClX F hF
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let P : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
    let X₀ : AlgebraicGeometry.Scheme.{u} := X.left
    let f_X : X₀ ⟶ P := ι_X.left
    let D : Fin (N + 1) → P.Opens := fun α => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α)
    let C_open : Fin (N + 1) → X₀.Opens := fun α => (TopologicalSpace.Opens.map f_X.base).obj (D α)
    have hD_top : (⨆ α : Fin (N + 1), D α) = ⊤ := by
      rw [eq_top_iff]
      intro p _
      rw [TopologicalSpace.Opens.mem_iSup]
      by_contra hnot
      let p' : ProjectiveSpectrum 𝒜 := p
      have hX_mem : ∀ α : Fin (N + 1),
          (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈ p'.asHomogeneousIdeal := by
        intro α
        have hpα : p' ∉ ProjectiveSpectrum.basicOpen 𝒜 (MvPolynomial.X α) := fun hmem => hnot ⟨α, hmem⟩
        rwa [ProjectiveSpectrum.mem_basicOpen, not_not] at hpα
      have hirrel : HomogeneousIdeal.irrelevant 𝒜 ≤ p'.asHomogeneousIdeal := by
        rw [HomogeneousIdeal.irrelevant_le]
        intro d hd q hq
        rw [q.as_sum]
        refine Ideal.sum_mem p'.asHomogeneousIdeal.toIdeal fun m hm => ?_
        have hdeg : (∑ α : Fin (N + 1), m α) = d := by
          have hhom : MvPolynomial.IsHomogeneous q d := hq
          have hw := hhom (MvPolynomial.mem_support_iff.mp hm)
          rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => by simp)] at hw
          simpa [smul_eq_mul, mul_one] using hw
        have hex_α : ∃ α : Fin (N + 1), 1 ≤ m α := by
          by_contra hall0
          have hsum0 : (∑ α : Fin (N + 1), m α) = 0 :=
            Finset.sum_eq_zero fun α _ => by
              have hlt : ¬ (1 ≤ m α) := fun hle => hall0 ⟨α, hle⟩
              omega
          omega
        obtain ⟨α, hα_pos⟩ := hex_α
        have hm_split : m = (m - Finsupp.single α 1) + Finsupp.single α 1 := by
          apply Finsupp.ext
          intro β
          by_cases hβα : β = α
          · subst hβα
            simp only [Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_eq_same]
            omega
          · simp only [Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_apply,
              ite_eq_right_iff.mpr fun h => absurd h (Ne.symm hβα), Nat.sub_zero, add_zero]
        have hmon_eq : MvPolynomial.monomial m (q.coeff m) =
            MvPolynomial.monomial (m - Finsupp.single α 1) (q.coeff m) * MvPolynomial.X α := by
          symm
          rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, mul_one, ← hm_split]
        rw [hmon_eq]
        exact p'.asHomogeneousIdeal.toIdeal.mul_mem_left _ (hX_mem α)
      exact p'.not_irrelevant_le hirrel
    have hX_deg : ∀ α : Fin (N + 1),
        (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜 1 :=
      fun α => MvPolynomial.isHomogeneous_X k α
    let z_F : ∀ (α : Fin (N + 1)), Fin ν → HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α) :=
      fun α j => HomogeneousLocalization.mk
        ⟨1, ⟨F j, hF j⟩, ⟨MvPolynomial.X α, hX_deg α⟩, ⟨1, pow_one _⟩⟩
    let ℓ_sec : ∀ (α : Fin (N + 1)) (W : X₀.Opens), W ≤ C_open α →
        Fin ν → ↑(X₀.presheaf.obj (Opposite.op W)) :=
      fun α W hW j =>
        (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X α) ≫
          f_X.appLE (D α) W hW).hom (z_F α j)
    let J_id : ∀ (α : Fin (N + 1)) (W : X₀.Opens), W ≤ C_open α →
        Ideal ↑(X₀.presheaf.obj (Opposite.op W)) :=
      fun α W hW => Ideal.span (Set.range (ℓ_sec α W hW))
    have hℓ_res : ∀ (α : Fin (N + 1)) (W W' : X₀.Opens) (hW : W ≤ C_open α)
        (hWW' : W' ≤ W) (j : Fin ν),
        (X₀.presheaf.map (CategoryTheory.homOfLE hWW').op).hom (ℓ_sec α W hW j) =
          ℓ_sec α W' (hWW'.trans hW) j := by
      intro α W W' hW hWW' j
      dsimp [ℓ_sec]
      have hcomp := AlgebraicGeometry.Scheme.Hom.appLE_map f_X hW (CategoryTheory.homOfLE hWW').op
      calc (X₀.presheaf.map (CategoryTheory.homOfLE hWW').op).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X α) ≫ f_X.appLE (D α) W hW).hom
              (z_F α j))
          = ((AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X α) ≫ f_X.appLE (D α) W hW) ≫
              X₀.presheaf.map (CategoryTheory.homOfLE hWW').op).hom (z_F α j) := rfl
        _ = (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X α) ≫
              f_X.appLE (D α) W' (hWW'.trans hW)).hom (z_F α j) := by
            rw [CategoryTheory.Category.assoc, hcomp]
    have hJ_res : ∀ (α : Fin (N + 1)) (W W' : X₀.Opens) (hW : W ≤ C_open α) (hWW' : W' ≤ W),
        Ideal.map (X₀.presheaf.map (CategoryTheory.homOfLE hWW').op).hom (J_id α W hW) =
          J_id α W' (hWW'.trans hW) := by
      intro α W W' hW hWW'
      dsimp [J_id]
      rw [Ideal.map_span]
      congr 1
      ext y
      simp only [Set.mem_image, Set.mem_range, exists_exists_eq_and]
      constructor
      · rintro ⟨j, rfl⟩
        exact ⟨j, (hℓ_res α W W' hW hWW' j).symm⟩
      · rintro ⟨j, rfl⟩
        exact ⟨j, hℓ_res α W W' hW hWW' j⟩
    have hJ_overlap : ∀ (α α' : Fin (N + 1)) (W : X₀.Opens)
        (hWα : W ≤ C_open α) (hWα' : W ≤ C_open α'),
        J_id α W hWα = J_id α' W hWα' := by
      have hJ_le : ∀ (α α' : Fin (N + 1)) (W : X₀.Opens)
          (hWα : W ≤ C_open α) (hWα' : W ≤ C_open α'),
          J_id α W hWα ≤ J_id α' W hWα' := by
        intro α α' W hWα hWα'
        dsimp [J_id]
        rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        let x_prod : MvPolynomial (Fin (N + 1)) k := MvPolynomial.X α * MvPolynomial.X α'
        have hD_mul : AlgebraicGeometry.Proj.basicOpen 𝒜 x_prod = D α ⊓ D α' :=
