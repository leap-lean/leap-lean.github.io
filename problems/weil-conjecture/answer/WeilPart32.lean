    let ψ₀ : B →+* (B_Q ⧸ J_Q) := (Ideal.Quotient.mk J_Q).comp (algebraMap B B_Q)
    have hJB_ker : ∀ b ∈ J_B, ψ₀ b = 0 := by
      intro b hb
      change Ideal.Quotient.mk J_Q (algebraMap B B_Q b) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, hJQ_eq]
      exact Ideal.mem_map_of_mem _ hb
    let ψ_E : (B ⧸ J_B) →+* (B_Q ⧸ J_Q) := Ideal.Quotient.lift J_B ψ₀ hJB_ker
    have hm_E : ∀ m : M_E, IsUnit (ψ_E m.1) := by
      intro m
      rcases m.2 with ⟨s, hs, hms⟩
      rw [← hms]
      change IsUnit (Ideal.Quotient.mk J_Q (algebraMap B B_Q s))
      exact (IsLocalization.map_units B_Q (⟨s, hs⟩ : Q.primeCompl)).map (Ideal.Quotient.mk J_Q)
    let β : Localization M_E →+* (B_Q ⧸ J_Q) :=
      IsLocalization.lift (S := Localization M_E) hm_E
    have h_left : β.comp α = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply IsLocalization.ringHom_ext Q.primeCompl
      ext b
      change β (α (Ideal.Quotient.mk J_Q (algebraMap B B_Q b))) =
        Ideal.Quotient.mk J_Q (algebraMap B B_Q b)
      change β (φ_BQ (algebraMap B B_Q b)) = Ideal.Quotient.mk J_Q (algebraMap B B_Q b)
      rw [IsLocalization.lift_eq]
      change β (algebraMap (B ⧸ J_B) (Localization M_E) (Ideal.Quotient.mk J_B b)) =
        Ideal.Quotient.mk J_Q (algebraMap B B_Q b)
      rw [IsLocalization.lift_eq]
      rfl
    have hα_inj : Function.Injective α := by
      intro x y hxy
      have hx : β (α x) = x := RingHom.congr_fun h_left x
      have hy : β (α y) = y := RingHom.congr_fun h_left y
      rw [← hx, ← hy, hxy]
    exact isReduced_of_injective α hα_inj

theorem weil_mvPoly_fin2_nodal_threeJet_and_branch_nondiv (k : Type u) [Field k] :
    let P_2 := MvPolynomial (Fin 2) k
    let m_0 : Ideal P_2 := Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1}
    (∀ (p_0 : Ideal P_2) [p_0.IsPrime],
      p_0 = m_0 →
      ∀ n : ℕ,
        ∃ E_n : (P_2 ⧸ m_0 ^ n) ≃ₐ[k]
          (Localization.AtPrime p_0 ⧸
            (IsLocalRing.maximalIdeal (Localization.AtPrime p_0)) ^ n),
          ∀ f : P_2,
            E_n (Ideal.Quotient.mk _ f) =
              Ideal.Quotient.mk _ (algebraMap P_2 (Localization.AtPrime p_0) f)) ∧
    (∀ q_ℓ : P_2,
      q_ℓ ∈ m_0 →
      Nonempty ((P_2 ⧸ (Ideal.span {q_ℓ} ⊔ m_0 ^ 3)) ≃ₐ[k]
        (P_2 ⧸ (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set P_2) ⊔ m_0 ^ 3))) →
      q_ℓ ∉ m_0 ^ 3 ∧
      ∃ a₀₀ a₀₁ a₁₀ a₁₁ : k,
        a₀₀ * a₁₁ - a₀₁ * a₁₀ ≠ 0 ∧
        (MvPolynomial.C a₀₀ * MvPolynomial.X 0 + MvPolynomial.C a₀₁ * MvPolynomial.X 1) *
          (MvPolynomial.C a₁₀ * MvPolynomial.X 0 + MvPolynomial.C a₁₁ * MvPolynomial.X 1) -
          q_ℓ ∈ m_0 ^ 3) ∧
    (∀ (c₁ c₂ : k), c₁ ≠ 0 → c₂ ≠ 0 →
      ∀ (r_u r_v : P_2), r_u ∈ m_0 ^ 2 → r_v ∈ m_0 ^ 2 →
      ∀ n : ℕ,
        let U := MvPolynomial.C c₁ * MvPolynomial.X 1 + r_u
        let V := MvPolynomial.C c₂ * MvPolynomial.X 0 + r_v
        V ^ n ∉ Ideal.span {U} ⊔ m_0 ^ (n + 1) ∧
        U ^ n ∉ Ideal.span {V} ⊔ m_0 ^ (n + 1)) :=
by
  intro P_2 m_0
  let e : Fin 2 → (Fin 2 →₀ ℕ) := fun j => Finsupp.single j 1
  let vanishesBelow : ℕ → P_2 → Prop := fun m f =>
    ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 < m → f.coeff d = 0
  have coeff_zero_eq : ∀ d : Fin 2 →₀ ℕ, (0 : P_2).coeff d = 0 :=
    fun d => map_zero (MvPolynomial.lcoeff k d)
  have coeff_add_eq : ∀ (f g : P_2) (d : Fin 2 →₀ ℕ),
      (f + g).coeff d = f.coeff d + g.coeff d :=
    fun f g d => map_add (MvPolynomial.lcoeff k d) f g
  have coeff_sub_eq : ∀ (f g : P_2) (d : Fin 2 →₀ ℕ),
      (f - g).coeff d = f.coeff d - g.coeff d :=
    fun f g d => map_sub (MvPolynomial.lcoeff k d) f g
  have hX0_mem : (MvPolynomial.X 0 : P_2) ∈ m_0 :=
    Ideal.subset_span (Set.mem_insert _ _)
  have hX1_mem : (MvPolynomial.X 1 : P_2) ∈ m_0 :=
    Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hX_mem : ∀ b : Fin 2, (MvPolynomial.X b : P_2) ∈ m_0 := by
    intro b
    fin_cases b
    · exact hX0_mem
    · exact hX1_mem
  have h_vb_mul : ∀ {a b : ℕ} {f g : P_2},
      vanishesBelow a f → vanishesBelow b g → vanishesBelow (a + b) (f * g) := by
    intro a b f g hf hg d hd
    rw [MvPolynomial.coeff_mul]
    refine Finset.sum_eq_zero fun x hx => ?_
    have hsum : x.1 + x.2 = d := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
    have h0 : x.1 0 + x.2 0 = d 0 := by rw [← hsum, Finsupp.add_apply]
    have h1 : x.1 1 + x.2 1 = d 1 := by rw [← hsum, Finsupp.add_apply]
    by_cases hlt : x.1 0 + x.1 1 < a
    · rw [hf x.1 hlt, zero_mul]
    · have hlt2 : x.2 0 + x.2 1 < b := by omega
      rw [hg x.2 hlt2, mul_zero]
  let J : ℕ → Ideal P_2 := fun m =>
    { carrier := {f : P_2 | vanishesBelow m f}
      zero_mem' := fun d _ => coeff_zero_eq d
      add_mem' := fun {f g} hf hg d hd => by
        rw [coeff_add_eq, hf d hd, hg d hd, add_zero]
      smul_mem' := fun r {f} hf => by
        change vanishesBelow m (r * f)
        have hr : vanishesBelow 0 r := fun _ hd => absurd hd (Nat.not_lt_zero _)
        simpa only [zero_add] using h_vb_mul hr hf }
  have hm0_le_J1 : m_0 ≤ J 1 := by
    rw [Ideal.span_le]
    intro f hf
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hf
    intro d hd
    rcases hf with rfl | rfl
    · rw [MvPolynomial.X, MvPolynomial.coeff_monomial]
      have hne : Finsupp.single (0 : Fin 2) 1 ≠ d := by
        intro heq
        have h1 : (Finsupp.single (0 : Fin 2) 1 : Fin 2 →₀ ℕ) 0 = d 0 := by rw [heq]
        simp only [Finsupp.single_eq_same] at h1
        omega
      simp [hne]
    · rw [MvPolynomial.X, MvPolynomial.coeff_monomial]
      have hne : Finsupp.single (1 : Fin 2) 1 ≠ d := by
        intro heq
        have h1 : (Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) 1 = d 1 := by rw [heq]
        simp only [Finsupp.single_eq_same] at h1
        omega
      simp [hne]
  have hpow_le_J : ∀ m : ℕ, m_0 ^ m ≤ J m := by
    intro m
    induction m with
    | zero =>
      rw [pow_zero]
      intro f _ d hd
      exact absurd hd (Nat.not_lt_zero _)
    | succ m ih =>
      rw [pow_succ, Submodule.mul_le]
      intro f hf g hg
      exact h_vb_mul (ih hf) (hm0_le_J1 hg)
  have h_monomial_mem : ∀ (d : Fin 2 →₀ ℕ) (a : k),
      (MvPolynomial.monomial d a : P_2) ∈ m_0 ^ (d 0 + d 1) := by
    intro d a
    have hd_decomp : Finsupp.single (0 : Fin 2) (d 0) + Finsupp.single (1 : Fin 2) (d 1) = d := by
      ext i
      fin_cases i <;> simp
    have hmon_eq : MvPolynomial.C a * ((MvPolynomial.X 0 : P_2) ^ (d 0) * (MvPolynomial.X 1 : P_2) ^ (d 1)) =
        MvPolynomial.monomial d a := by
      rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.X_pow_eq_monomial,
        MvPolynomial.monomial_mul_monomial, mul_one, ← MvPolynomial.monomial_zero',
        MvPolynomial.monomial_mul_monomial, zero_add, mul_one, hd_decomp]
    rw [← hmon_eq, pow_add]
    exact Ideal.mul_mem_left _ _
      (Ideal.mul_mem_mul (Ideal.pow_mem_pow hX0_mem (d 0)) (Ideal.pow_mem_pow hX1_mem (d 1)))
  have h_mem_pow : ∀ (m : ℕ) (f : P_2), f ∈ m_0 ^ m ↔ vanishesBelow m f := by
    intro m f
    refine ⟨fun hf => hpow_le_J m hf, fun hf => ?_⟩
    rw [MvPolynomial.as_sum f]
    refine Ideal.sum_mem _ fun d hd => ?_
    have hne : f.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
    have hge : m ≤ d 0 + d 1 := by
      by_contra hlt
      exact hne (hf d (Nat.lt_of_not_ge hlt))
    exact Ideal.pow_le_pow_right hge (h_monomial_mem d (f.coeff d))
  have h_mem_m0 : ∀ f : P_2, f ∈ m_0 ↔ f.coeff 0 = 0 := by
    intro f
    rw [← pow_one m_0, h_mem_pow 1 f]
    refine ⟨fun h => h 0 (by simp), fun h0 d hd => ?_⟩
    have hd0 : d = 0 := by
      ext i
      fin_cases i <;> (simp; omega)
    rwa [hd0]
  have h_sub_const : ∀ f : P_2, f - MvPolynomial.C (f.coeff 0) ∈ m_0 := by
    intro f
    rw [h_mem_m0, coeff_sub_eq, MvPolynomial.coeff_C]
    simp
  have h_one_jet : ∀ f : P_2, f ∈ m_0 →
      f - (MvPolynomial.C (f.coeff (e 0)) * MvPolynomial.X 0 +
        MvPolynomial.C (f.coeff (e 1)) * MvPolynomial.X 1) ∈ m_0 ^ 2 := by
    intro f hf
    have hf0 : f.coeff 0 = 0 := (h_mem_m0 f).mp hf
    rw [h_mem_pow 2]
    intro d hd
    rw [coeff_sub_eq, coeff_add_eq, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_C_mul,
      MvPolynomial.X, MvPolynomial.X, MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial]
    have hcases : d = 0 ∨ d = e 0 ∨ d = e 1 := by
      by_cases hd0 : d 0 = 0
      · by_cases hd1 : d 1 = 0
        · left
          ext i; fin_cases i <;> simp [hd0, hd1]
        · right; right
          ext i
          fin_cases i
          · simp [e, hd0]
          · simp [e]; omega
      · right; left
        ext i; fin_cases i <;> (simp [e]; omega)
    rcases hcases with rfl | rfl | rfl
    · have hne0 : Finsupp.single (0 : Fin 2) 1 ≠ (0 : Fin 2 →₀ ℕ) := by
        intro h; have := Finsupp.ext_iff.mp h 0; simp at this
      have hne1 : Finsupp.single (1 : Fin 2) 1 ≠ (0 : Fin 2 →₀ ℕ) := by
        intro h; have := Finsupp.ext_iff.mp h 1; simp at this
      simp [hf0, hne0, hne1]
    · have hne10 : Finsupp.single (1 : Fin 2) 1 ≠ e 0 := by
        intro h; have := Finsupp.ext_iff.mp h 0; simp [e] at this
      simp [e, hne10]
    · have hne01 : Finsupp.single (0 : Fin 2) 1 ≠ e 1 := by
        intro h; have := Finsupp.ext_iff.mp h 0; simp [e] at this
      simp [e, hne01]

  refine ⟨?_, ?_, ?_⟩

  
  
  
  · intro p_0 _ hp0 n
    let R_0 := _root_.Localization.AtPrime p_0
    let M_0 := IsLocalRing.maximalIdeal R_0
    have hmap_m0 : Ideal.map (algebraMap P_2 R_0) m_0 = M_0 := by
      rw [← hp0]
      exact IsLocalization.AtPrime.map_eq_maximalIdeal p_0 R_0
    have hmap_pow : Ideal.map (algebraMap P_2 R_0) (m_0 ^ n) = M_0 ^ n := by
      rw [Ideal.map_pow, hmap_m0]
    let α : P_2 →ₐ[k] (R_0 ⧸ M_0 ^ n) :=
      (Ideal.Quotient.mkₐ k (M_0 ^ n)).comp (IsScalarTower.toAlgHom k P_2 R_0)
    have hα_ker : ∀ x ∈ m_0 ^ n, α x = 0 := by
      intro x hx
      change Ideal.Quotient.mk (M_0 ^ n) (algebraMap P_2 R_0 x) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, ← hmap_pow]
      exact Ideal.mem_map_of_mem (algebraMap P_2 R_0) hx
    let φ_n : (P_2 ⧸ m_0 ^ n) →ₐ[k] (R_0 ⧸ M_0 ^ n) :=
      Ideal.Quotient.liftₐ (m_0 ^ n) α hα_ker
    let π_n : P_2 →+* (P_2 ⧸ m_0 ^ n) := Ideal.Quotient.mk (m_0 ^ n)
    have h_units : ∀ s : p_0.primeCompl, IsUnit (π_n s.1) := by
      intro s
      have hs_not_m0 : s.1 ∉ m_0 := by
        rw [← hp0]
        exact s.2
      have hc : s.1.coeff 0 ≠ 0 := fun h0 => hs_not_m0 ((h_mem_m0 s.1).mpr h0)
      let c : k := s.1.coeff 0
      let r : P_2 := s.1 - MvPolynomial.C c
      have hr_mem : r ∈ m_0 := h_sub_const s.1
      have hu_c : IsUnit (π_n (MvPolynomial.C c)) :=
        (IsUnit.mk0 c hc).map (π_n.comp MvPolynomial.C)
      have hnil_r : IsNilpotent (π_n r) := by
        refine ⟨n, ?_⟩
        rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.pow_mem_pow hr_mem n
      have hu_sum : IsUnit (π_n (MvPolynomial.C c) + π_n r) :=
        hnil_r.isUnit_add_left_of_commute hu_c (Commute.all _ _)
      have hs_eq : π_n (MvPolynomial.C c) + π_n r = π_n s.1 := by
        rw [← map_add, add_sub_cancel]
      rwa [hs_eq] at hu_sum
    let lam_n : R_0 →+* (P_2 ⧸ m_0 ^ n) := IsLocalization.lift (M := p_0.primeCompl) h_units
    have hlam_ker : ∀ z ∈ M_0 ^ n, lam_n z = 0 := by
      have hle : M_0 ^ n ≤ RingHom.ker lam_n := by
        rw [← hmap_pow, Ideal.map_le_iff_le_comap]
        intro x hx
        change lam_n (algebraMap P_2 R_0 x) = 0
        rw [IsLocalization.lift_eq (M := p_0.primeCompl) h_units x]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hx
      exact fun z hz => hle hz
    let ψ_n : (R_0 ⧸ M_0 ^ n) →+* (P_2 ⧸ m_0 ^ n) :=
      Ideal.Quotient.lift (M_0 ^ n) lam_n hlam_ker
    have h_left : Function.LeftInverse ψ_n φ_n := by
      intro x
      rcases Ideal.Quotient.mk_surjective x with ⟨f, rfl⟩
      change ψ_n (Ideal.Quotient.mk (M_0 ^ n) (algebraMap P_2 R_0 f)) = π_n f
      change lam_n (algebraMap P_2 R_0 f) = π_n f
      exact IsLocalization.lift_eq (M := p_0.primeCompl) h_units f
    have h_comp_id : φ_n.toRingHom.comp lam_n = Ideal.Quotient.mk (M_0 ^ n) := by
      apply IsLocalization.ringHom_ext p_0.primeCompl
      apply RingHom.ext
      intro f
      simp only [RingHom.comp_apply]
      rw [IsLocalization.lift_eq (M := p_0.primeCompl) h_units f]
      rfl
    have h_right : Function.RightInverse ψ_n φ_n := by
      intro y
      rcases Ideal.Quotient.mk_surjective y with ⟨z, rfl⟩
      change (φ_n.toRingHom.comp lam_n) z = Ideal.Quotient.mk (M_0 ^ n) z
      rw [h_comp_id]
    refine ⟨AlgEquiv.ofBijective φ_n ⟨h_left.injective, h_right.surjective⟩, fun f => rfl⟩

  
  
  
  · intro q_ℓ hq_mem ⟨Θ⟩
    let I₁ : Ideal P_2 := Ideal.span {q_ℓ} ⊔ m_0 ^ 3
    let I₂ : Ideal P_2 := Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set P_2) ⊔ m_0 ^ 3
    have hI₁_le_m0 : I₁ ≤ m_0 :=
      sup_le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hq_mem))
        (Ideal.pow_le_self (by decide : 3 ≠ 0))
    have hI₂_le_m02 : I₂ ≤ m_0 ^ 2 := by
      refine sup_le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_))
        (Ideal.pow_le_pow_right (by decide : 2 ≤ 3))
      rw [sq]
      exact Ideal.mul_mem_mul hX0_mem hX1_mem
    have hI₂_le_m0 : I₂ ≤ m_0 :=
      hI₂_le_m02.trans (Ideal.pow_le_self (by decide : 2 ≠ 0))
    obtain ⟨g₀, hg₀⟩ := Ideal.Quotient.mk_surjective (Θ.symm (Ideal.Quotient.mk I₂ (MvPolynomial.X 0)))
    obtain ⟨g₁, hg₁⟩ := Ideal.Quotient.mk_surjective (Θ.symm (Ideal.Quotient.mk I₂ (MvPolynomial.X 1)))
    obtain ⟨h₀, hh₀⟩ := Ideal.Quotient.mk_surjective (Θ (Ideal.Quotient.mk I₁ (MvPolynomial.X 0)))
    obtain ⟨h₁, hh₁⟩ := Ideal.Quotient.mk_surjective (Θ (Ideal.Quotient.mk I₁ (MvPolynomial.X 1)))
    let g : Fin 2 → P_2 := ![g₀, g₁]
    let h : Fin 2 → P_2 := ![h₀, h₁]
    have hg_mk : ∀ b : Fin 2,
        Ideal.Quotient.mk I₁ (g b) = Θ.symm (Ideal.Quotient.mk I₂ (MvPolynomial.X b)) := by
      intro b
      fin_cases b
      · exact hg₀
      · exact hg₁
    have hh_mk : ∀ b : Fin 2,
        Ideal.Quotient.mk I₂ (h b) = Θ (Ideal.Quotient.mk I₁ (MvPolynomial.X b)) := by
      intro b
      fin_cases b
      · exact hh₀
      · exact hh₁
    have hΘ_hom : Θ.toAlgHom.comp (Ideal.Quotient.mkₐ k I₁) =
        (Ideal.Quotient.mkₐ k I₂).comp (MvPolynomial.aeval h) := by
      apply MvPolynomial.algHom_ext
      intro b
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, MvPolynomial.aeval_X]
      exact (hh_mk b).symm
    have hΘsymm_hom : Θ.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k I₂) =
        (Ideal.Quotient.mkₐ k I₁).comp (MvPolynomial.aeval g) := by
      apply MvPolynomial.algHom_ext
      intro b
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, MvPolynomial.aeval_X]
      exact (hg_mk b).symm
    have hΘ_aeval : ∀ f : P_2,
        Θ (Ideal.Quotient.mk I₁ f) = Ideal.Quotient.mk I₂ (MvPolynomial.aeval h f) :=
      fun f => AlgHom.congr_fun hΘ_hom f
    have hΘsymm_aeval : ∀ f : P_2,
        Θ.symm (Ideal.Quotient.mk I₂ f) = Ideal.Quotient.mk I₁ (MvPolynomial.aeval g f) :=
      fun f => AlgHom.congr_fun hΘsymm_hom f
    have hg_mem_m0 : ∀ b : Fin 2, g b ∈ m_0 := by
      intro b
      have hXb3 : (MvPolynomial.X b : P_2) ^ 3 ∈ I₂ :=
        Ideal.mem_sup_right (Ideal.pow_mem_pow (hX_mem b) 3)
      have hmk0 : Ideal.Quotient.mk I₂ ((MvPolynomial.X b : P_2) ^ 3) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hXb3
      have hgb3_mk : Ideal.Quotient.mk I₁ ((g b) ^ 3) = 0 := by
        rw [map_pow, hg_mk b, ← map_pow, ← map_pow, hmk0, map_zero]
      have hgb3_m0 : (g b) ^ 3 ∈ m_0 := hI₁_le_m0 (Ideal.Quotient.eq_zero_iff_mem.mp hgb3_mk)
      have hc3 : (MvPolynomial.constantCoeff (g b)) ^ 3 = 0 := by
        rw [← map_pow, MvPolynomial.constantCoeff_eq]
        exact (h_mem_m0 _).mp hgb3_m0
      rw [h_mem_m0, ← MvPolynomial.constantCoeff_eq]
      by_contra hne
      exact pow_ne_zero 3 hne hc3
    have hh_mem_m0 : ∀ b : Fin 2, h b ∈ m_0 := by
      intro b
      have hXb3 : (MvPolynomial.X b : P_2) ^ 3 ∈ I₁ :=
        Ideal.mem_sup_right (Ideal.pow_mem_pow (hX_mem b) 3)
      have hmk0 : Ideal.Quotient.mk I₁ ((MvPolynomial.X b : P_2) ^ 3) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hXb3
      have hhb3_mk : Ideal.Quotient.mk I₂ ((h b) ^ 3) = 0 := by
        rw [map_pow, hh_mk b, ← map_pow, ← map_pow, hmk0, map_zero]
      have hhb3_m0 : (h b) ^ 3 ∈ m_0 := hI₂_le_m0 (Ideal.Quotient.eq_zero_iff_mem.mp hhb3_mk)
      have hc3 : (MvPolynomial.constantCoeff (h b)) ^ 3 = 0 := by
        rw [← map_pow, MvPolynomial.constantCoeff_eq]
        exact (h_mem_m0 _).mp hhb3_m0
      rw [h_mem_m0, ← MvPolynomial.constantCoeff_eq]
      by_contra hne
      exact pow_ne_zero 3 hne hc3
    have haeval_h_m0 : Ideal.map (MvPolynomial.aeval h).toRingHom m_0 ≤ m_0 := by
      rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
      intro f hf
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hf
      rcases hf with rfl | rfl
      · change MvPolynomial.aeval h (MvPolynomial.X 0) ∈ m_0
        rw [MvPolynomial.aeval_X]; exact hh_mem_m0 0
      · change MvPolynomial.aeval h (MvPolynomial.X 1) ∈ m_0
        rw [MvPolynomial.aeval_X]; exact hh_mem_m0 1
    have haeval_h_m02 : ∀ r : P_2, r ∈ m_0 ^ 2 → MvPolynomial.aeval h r ∈ m_0 ^ 2 := by
      intro r hr
      have hmem : (MvPolynomial.aeval h).toRingHom r ∈
          Ideal.map (MvPolynomial.aeval h).toRingHom (m_0 ^ 2) :=
        Ideal.mem_map_of_mem _ hr
      rw [Ideal.map_pow] at hmem
      exact pow_le_pow_left' haeval_h_m0 2 hmem
    let A : Matrix (Fin 2) (Fin 2) k := Matrix.of fun b j => (g b).coeff (e j)
    let B : Matrix (Fin 2) (Fin 2) k := Matrix.of fun b j => (h b).coeff (e j)
    let L : Fin 2 → P_2 := fun b =>
      MvPolynomial.C (A b 0) * MvPolynomial.X 0 + MvPolynomial.C (A b 1) * MvPolynomial.X 1
    let M : Fin 2 → P_2 := fun b =>
      MvPolynomial.C (B b 0) * MvPolynomial.X 0 + MvPolynomial.C (B b 1) * MvPolynomial.X 1
    have hg_jet : ∀ b : Fin 2, g b - L b ∈ m_0 ^ 2 :=
      fun b => h_one_jet (g b) (hg_mem_m0 b)
    have hh_jet : ∀ b : Fin 2, h b - M b ∈ m_0 ^ 2 :=
      fun b => h_one_jet (h b) (hh_mem_m0 b)
    have haeval_lin_jet : ∀ c₀ c₁ : k,
        MvPolynomial.aeval h (MvPolynomial.C c₀ * MvPolynomial.X 0 + MvPolynomial.C c₁ * MvPolynomial.X 1) -
          (MvPolynomial.C (c₀ * B 0 0 + c₁ * B 1 0) * MvPolynomial.X 0 +
            MvPolynomial.C (c₀ * B 0 1 + c₁ * B 1 1) * MvPolynomial.X 1) ∈ m_0 ^ 2 := by
      intro c₀ c₁
      have heq : MvPolynomial.aeval h
            (MvPolynomial.C c₀ * MvPolynomial.X 0 + MvPolynomial.C c₁ * MvPolynomial.X 1) -
          (MvPolynomial.C (c₀ * B 0 0 + c₁ * B 1 0) * MvPolynomial.X 0 +
            MvPolynomial.C (c₀ * B 0 1 + c₁ * B 1 1) * MvPolynomial.X 1) =
          MvPolynomial.C c₀ * (h 0 - M 0) + MvPolynomial.C c₁ * (h 1 - M 1) := by
        have halg : (algebraMap k P_2) = MvPolynomial.C := MvPolynomial.algebraMap_eq k (Fin 2)
        simp only [M, map_add, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X, halg]
        ring
      rw [heq]
      exact add_mem (Ideal.mul_mem_left _ _ (hh_jet 0)) (Ideal.mul_mem_left _ _ (hh_jet 1))
    have h_lin_coeff_zero : ∀ u₀ u₁ : k,
        MvPolynomial.C u₀ * (MvPolynomial.X 0 : P_2) + MvPolynomial.C u₁ * MvPolynomial.X 1 ∈ m_0 ^ 2 →
        u₀ = 0 ∧ u₁ = 0 := by
      intro u₀ u₁ hmem
      have hvb := (h_mem_pow 2 _).mp hmem
      have he0_lt : (e 0) 0 + (e 0) 1 < 2 := by simp [e]
      have he1_lt : (e 1) 0 + (e 1) 1 < 2 := by simp [e]
      have h0 := hvb (e 0) he0_lt
      have h1 := hvb (e 1) he1_lt
      have hne10 : Finsupp.single (1 : Fin 2) 1 ≠ e 0 := by
        intro hc; have := Finsupp.ext_iff.mp hc 0; simp [e] at this
      have hne01 : Finsupp.single (0 : Fin 2) 1 ≠ e 1 := by
        intro hc; have := Finsupp.ext_iff.mp hc 0; simp [e] at this
      rw [coeff_add_eq, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_C_mul,
        MvPolynomial.X, MvPolynomial.X, MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial] at h0 h1
      simp only [e, ite_true, hne10, hne01, ite_false, mul_one, mul_zero, add_zero, zero_add] at h0 h1
      exact ⟨h0, h1⟩
    have hAB_row : ∀ b : Fin 2,
        MvPolynomial.C (A b 0 * B 0 0 + A b 1 * B 1 0) * (MvPolynomial.X 0 : P_2) +
          MvPolynomial.C (A b 0 * B 0 1 + A b 1 * B 1 1) * MvPolynomial.X 1 -
          MvPolynomial.X b ∈ m_0 ^ 2 := by
      intro b
      have hcomp_mk : Ideal.Quotient.mk I₂ (MvPolynomial.aeval h (g b)) =
          Ideal.Quotient.mk I₂ (MvPolynomial.X b) := by
        rw [← hΘ_aeval, hg_mk b, AlgEquiv.apply_symm_apply]
      have hcomp_m02 : MvPolynomial.aeval h (g b) - MvPolynomial.X b ∈ m_0 ^ 2 :=
        hI₂_le_m02 (Ideal.Quotient.eq_zero_iff_mem.mp (sub_eq_zero.mpr hcomp_mk))
      have hrem1 : MvPolynomial.aeval h (g b - L b) ∈ m_0 ^ 2 :=
        haeval_h_m02 _ (hg_jet b)
      have hrem2 := haeval_lin_jet (A b 0) (A b 1)
      have hid : MvPolynomial.C (A b 0 * B 0 0 + A b 1 * B 1 0) * (MvPolynomial.X 0 : P_2) +
          MvPolynomial.C (A b 0 * B 0 1 + A b 1 * B 1 1) * MvPolynomial.X 1 -
          MvPolynomial.X b =
          (MvPolynomial.aeval h (g b) - MvPolynomial.X b) -
            MvPolynomial.aeval h (g b - L b) -
            (MvPolynomial.aeval h (L b) -
              (MvPolynomial.C (A b 0 * B 0 0 + A b 1 * B 1 0) * MvPolynomial.X 0 +
                MvPolynomial.C (A b 0 * B 0 1 + A b 1 * B 1 1) * MvPolynomial.X 1)) := by
        rw [map_sub]
        dsimp [L]
        ring
      rw [hid]
      exact sub_mem (sub_mem hcomp_m02 hrem1) hrem2
    have hAB : A * B = 1 := by
      have hr0 : MvPolynomial.C (A 0 0 * B 0 0 + A 0 1 * B 1 0 - 1) * (MvPolynomial.X 0 : P_2) +
          MvPolynomial.C (A 0 0 * B 0 1 + A 0 1 * B 1 1) * MvPolynomial.X 1 ∈ m_0 ^ 2 := by
        have h0 := hAB_row 0
        have heq : MvPolynomial.C (A 0 0 * B 0 0 + A 0 1 * B 1 0 - 1) * (MvPolynomial.X 0 : P_2) +
            MvPolynomial.C (A 0 0 * B 0 1 + A 0 1 * B 1 1) * MvPolynomial.X 1 =
            MvPolynomial.C (A 0 0 * B 0 0 + A 0 1 * B 1 0) * MvPolynomial.X 0 +
              MvPolynomial.C (A 0 0 * B 0 1 + A 0 1 * B 1 1) * MvPolynomial.X 1 -
              MvPolynomial.X 0 := by
          rw [map_sub, map_one]
          ring
        rwa [heq]
      have hr1 : MvPolynomial.C (A 1 0 * B 0 0 + A 1 1 * B 1 0) * (MvPolynomial.X 0 : P_2) +
          MvPolynomial.C (A 1 0 * B 0 1 + A 1 1 * B 1 1 - 1) * MvPolynomial.X 1 ∈ m_0 ^ 2 := by
        have h1 := hAB_row 1
        have heq : MvPolynomial.C (A 1 0 * B 0 0 + A 1 1 * B 1 0) * (MvPolynomial.X 0 : P_2) +
            MvPolynomial.C (A 1 0 * B 0 1 + A 1 1 * B 1 1 - 1) * MvPolynomial.X 1 =
            MvPolynomial.C (A 1 0 * B 0 0 + A 1 1 * B 1 0) * MvPolynomial.X 0 +
              MvPolynomial.C (A 1 0 * B 0 1 + A 1 1 * B 1 1) * MvPolynomial.X 1 -
              MvPolynomial.X 1 := by
          rw [map_sub, map_one]
          ring
        rwa [heq]
      obtain ⟨h00, h01⟩ := h_lin_coeff_zero _ _ hr0
      obtain ⟨h10, h11⟩ := h_lin_coeff_zero _ _ hr1
      ext b j
      rw [Matrix.mul_apply, Fin.sum_univ_two]
      fin_cases b <;> fin_cases j
      · exact sub_eq_zero.mp h00
      · exact h01
      · exact h10
      · exact sub_eq_zero.mp h11
    have hdet_mul : A.det * B.det = 1 := by
      rw [← Matrix.det_mul, hAB, Matrix.det_one]
    have hdetA : A.det ≠ 0 := left_ne_zero_of_mul_eq_one hdet_mul
    have hdetB : B.det ≠ 0 := right_ne_zero_of_mul_eq_one hdet_mul
    have hq_mem_m02 : q_ℓ ∈ m_0 ^ 2 := by
      have hq_I₁ : q_ℓ ∈ I₁ := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton q_ℓ))
      have haeval_q_mk : Ideal.Quotient.mk I₂ (MvPolynomial.aeval h q_ℓ) = 0 := by
        rw [← hΘ_aeval, Ideal.Quotient.eq_zero_iff_mem.mpr hq_I₁, map_zero]
      have haeval_q_m02 : MvPolynomial.aeval h q_ℓ ∈ m_0 ^ 2 :=
        hI₂_le_m02 (Ideal.Quotient.eq_zero_iff_mem.mp haeval_q_mk)
      let c₀ : k := q_ℓ.coeff (e 0)
      let c₁ : k := q_ℓ.coeff (e 1)
      let L_q : P_2 := MvPolynomial.C c₀ * MvPolynomial.X 0 + MvPolynomial.C c₁ * MvPolynomial.X 1
      have hq_jet : q_ℓ - L_q ∈ m_0 ^ 2 := h_one_jet q_ℓ hq_mem
      have hrem1 : MvPolynomial.aeval h (q_ℓ - L_q) ∈ m_0 ^ 2 := haeval_h_m02 _ hq_jet
      have hrem2 := haeval_lin_jet c₀ c₁
      have hlin_in : MvPolynomial.C (c₀ * B 0 0 + c₁ * B 1 0) * (MvPolynomial.X 0 : P_2) +
          MvPolynomial.C (c₀ * B 0 1 + c₁ * B 1 1) * MvPolynomial.X 1 ∈ m_0 ^ 2 := by
        have hid : MvPolynomial.C (c₀ * B 0 0 + c₁ * B 1 0) * (MvPolynomial.X 0 : P_2) +
            MvPolynomial.C (c₀ * B 0 1 + c₁ * B 1 1) * MvPolynomial.X 1 =
            MvPolynomial.aeval h q_ℓ - MvPolynomial.aeval h (q_ℓ - L_q) -
              (MvPolynomial.aeval h L_q -
                (MvPolynomial.C (c₀ * B 0 0 + c₁ * B 1 0) * MvPolynomial.X 0 +
                  MvPolynomial.C (c₀ * B 0 1 + c₁ * B 1 1) * MvPolynomial.X 1)) := by
          rw [map_sub]
          dsimp [L_q]
          ring
        rw [hid]
        exact sub_mem (sub_mem haeval_q_m02 hrem1) hrem2
      obtain ⟨hu₀, hu₁⟩ := h_lin_coeff_zero _ _ hlin_in
      have hc₀_det : c₀ * B.det = 0 := by
        rw [Matrix.det_fin_two]
        calc c₀ * (B 0 0 * B 1 1 - B 0 1 * B 1 0)
          _ = (c₀ * B 0 0 + c₁ * B 1 0) * B 1 1 - (c₀ * B 0 1 + c₁ * B 1 1) * B 1 0 := by ring
          _ = 0 * B 1 1 - 0 * B 1 0 := by rw [hu₀, hu₁]
          _ = 0 := by ring
      have hc₁_det : c₁ * B.det = 0 := by
        rw [Matrix.det_fin_two]
        calc c₁ * (B 0 0 * B 1 1 - B 0 1 * B 1 0)
          _ = B 0 0 * (c₀ * B 0 1 + c₁ * B 1 1) - B 0 1 * (c₀ * B 0 0 + c₁ * B 1 0) := by ring
          _ = B 0 0 * 0 - B 0 1 * 0 := by rw [hu₁, hu₀]
          _ = 0 := by ring
      have hc₀ : c₀ = 0 := (mul_eq_zero.mp hc₀_det).resolve_right hdetB
      have hc₁ : c₁ = 0 := (mul_eq_zero.mp hc₁_det).resolve_right hdetB
      have hLq0 : L_q = 0 := by simp [L_q, hc₀, hc₁]
      simpa [hLq0] using hq_jet
    have hg01_I₁ : g 0 * g 1 ∈ I₁ := by
      have hX01_I₂ : (MvPolynomial.X 0 * MvPolynomial.X 1 : P_2) ∈ I₂ :=
        Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _))
      have hmk0 : Ideal.Quotient.mk I₁
          (MvPolynomial.aeval g (MvPolynomial.X 0 * MvPolynomial.X 1 : P_2)) = 0 := by
        rw [← hΘsymm_aeval, Ideal.Quotient.eq_zero_iff_mem.mpr hX01_I₂, map_zero]
      rw [map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X] at hmk0
      exact Ideal.Quotient.eq_zero_iff_mem.mp hmk0
    have hL0_mem : L 0 ∈ m_0 :=
      add_mem (Ideal.mul_mem_left _ _ hX0_mem) (Ideal.mul_mem_left _ _ hX1_mem)
    have hLL_diff_m03 : g 0 * g 1 - L 0 * L 1 ∈ m_0 ^ 3 := by
      have hid : g 0 * g 1 - L 0 * L 1 = (g 0 - L 0) * g 1 + (g 1 - L 1) * L 0 := by ring
      rw [hid, pow_succ m_0 2]
      exact add_mem (Ideal.mul_mem_mul (hg_jet 0) (hg_mem_m0 1))
        (Ideal.mul_mem_mul (hg_jet 1) hL0_mem)
    have hLL_I₁ : L 0 * L 1 ∈ I₁ := by
      have heq : L 0 * L 1 = g 0 * g 1 - (g 0 * g 1 - L 0 * L 1) := by ring
      rw [heq]
      exact sub_mem hg01_I₁ (Ideal.mem_sup_right hLL_diff_m03)
    rcases Submodule.mem_sup.mp hLL_I₁ with ⟨y, hy, r₃, hr₃, hyr₃⟩
    rcases Ideal.mem_span_singleton.mp hy with ⟨f, rfl⟩
    let c : k := f.coeff 0
    have hqf_rem : q_ℓ * (f - MvPolynomial.C c) ∈ m_0 ^ 3 := by
      rw [pow_succ m_0 2]
      exact Ideal.mul_mem_mul hq_mem_m02 (h_sub_const f)
    have hLL_sub_cq : L 0 * L 1 - MvPolynomial.C c * q_ℓ ∈ m_0 ^ 3 := by
      have hid : L 0 * L 1 - MvPolynomial.C c * q_ℓ = q_ℓ * (f - MvPolynomial.C c) + r₃ := by
        rw [← hyr₃]
        ring
      rw [hid]
      exact add_mem hqf_rem hr₃
    have hLL_not_m03 : L 0 * L 1 ∉ m_0 ^ 3 := by
      intro hLL_m03
      have hvb := (h_mem_pow 3 _).mp hLL_m03
      have hLL_expand : L 0 * L 1 =
          MvPolynomial.C (A 0 0 * A 1 0) * MvPolynomial.monomial (e 0 + e 0) 1 +
            MvPolynomial.C (A 0 0 * A 1 1 + A 0 1 * A 1 0) * MvPolynomial.monomial (e 0 + e 1) 1 +
            MvPolynomial.C (A 0 1 * A 1 1) * MvPolynomial.monomial (e 1 + e 1) 1 := by
        have hX00 : (MvPolynomial.X 0 * MvPolynomial.X 0 : P_2) = MvPolynomial.monomial (e 0 + e 0) 1 := by
          rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, mul_one]
        have hX01 : (MvPolynomial.X 0 * MvPolynomial.X 1 : P_2) = MvPolynomial.monomial (e 0 + e 1) 1 := by
          rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul_monomial, mul_one]
        have hX11 : (MvPolynomial.X 1 * MvPolynomial.X 1 : P_2) = MvPolynomial.monomial (e 1 + e 1) 1 := by
          rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, mul_one]
        calc L 0 * L 1
          _ = MvPolynomial.C (A 0 0 * A 1 0) * (MvPolynomial.X 0 * MvPolynomial.X 0) +
                MvPolynomial.C (A 0 0 * A 1 1 + A 0 1 * A 1 0) * (MvPolynomial.X 0 * MvPolynomial.X 1) +
                MvPolynomial.C (A 0 1 * A 1 1) * (MvPolynomial.X 1 * MvPolynomial.X 1) := by
              dsimp [L]; simp only [map_add, map_mul]; ring
          _ = _ := by rw [hX00, hX01, hX11]
      have hne_01_00 : e 0 + e 1 ≠ e 0 + e 0 := by
        intro hc; have := Finsupp.ext_iff.mp hc 0; simp [e] at this
      have hne_11_00 : e 1 + e 1 ≠ e 0 + e 0 := by
        intro hc; have := Finsupp.ext_iff.mp hc 0; simp [e] at this
      have hne_11_01 : e 1 + e 1 ≠ e 0 + e 1 := by
        intro hc; have := Finsupp.ext_iff.mp hc 0; simp [e] at this
      have hc00 : A 0 0 * A 1 0 = 0 := by
        have h := hvb (e 0 + e 0) (by simp [e])
        rw [hLL_expand, coeff_add_eq, coeff_add_eq,
          MvPolynomial.coeff_C_mul, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_C_mul,
          MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial] at h
        simpa only [ite_true, hne_01_00, hne_11_00, ite_false, mul_one, mul_zero, add_zero] using h
      have hc01 : A 0 0 * A 1 1 + A 0 1 * A 1 0 = 0 := by
        have h := hvb (e 0 + e 1) (by simp [e])
        rw [hLL_expand, coeff_add_eq, coeff_add_eq,
          MvPolynomial.coeff_C_mul, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_C_mul,
          MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial] at h
        simpa only [ite_true, Ne.symm hne_01_00, hne_11_01, ite_false, mul_one, mul_zero,
          zero_add, add_zero] using h
      have hc11 : A 0 1 * A 1 1 = 0 := by
        have h := hvb (e 1 + e 1) (by simp [e])
        rw [hLL_expand, coeff_add_eq, coeff_add_eq,
          MvPolynomial.coeff_C_mul, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_C_mul,
          MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial] at h
        simpa only [ite_true, Ne.symm hne_11_00, Ne.symm hne_11_01, ite_false, mul_one, mul_zero,
          zero_add] using h
      have hdet_sq : A.det ^ 2 = 0 := by
        rw [Matrix.det_fin_two]
        calc (A 0 0 * A 1 1 - A 0 1 * A 1 0) ^ 2
          _ = (A 0 0 * A 1 1 + A 0 1 * A 1 0) ^ 2 - 4 * (A 0 0 * A 1 0) * (A 0 1 * A 1 1) := by ring
          _ = 0 ^ 2 - 4 * 0 * 0 := by rw [hc01, hc00, hc11]
          _ = 0 := by ring
      exact pow_ne_zero 2 hdetA hdet_sq
    have hq_not_m03 : q_ℓ ∉ m_0 ^ 3 := by
      intro hq3
      apply hLL_not_m03
      have heq : L 0 * L 1 = (L 0 * L 1 - MvPolynomial.C c * q_ℓ) + MvPolynomial.C c * q_ℓ := by ring
      rw [heq]
      exact add_mem hLL_sub_cq (Ideal.mul_mem_left _ _ hq3)
    have hc_ne : c ≠ 0 := by
      intro hc0
      apply hLL_not_m03
      have hsub := hLL_sub_cq
      rw [hc0, map_zero, zero_mul, sub_zero] at hsub
      exact hsub
    refine ⟨hq_not_m03, c⁻¹ * A 0 0, c⁻¹ * A 0 1, A 1 0, A 1 1, ?_, ?_⟩
    · have hdet_scale : (c⁻¹ * A 0 0) * A 1 1 - (c⁻¹ * A 0 1) * A 1 0 = c⁻¹ * A.det := by
        rw [Matrix.det_fin_two]; ring
      rw [hdet_scale]
      exact mul_ne_zero (inv_ne_zero hc_ne) hdetA
    · have hpoly_scale :
          (MvPolynomial.C (c⁻¹ * A 0 0) * (MvPolynomial.X 0 : P_2) +
              MvPolynomial.C (c⁻¹ * A 0 1) * MvPolynomial.X 1) *
            (MvPolynomial.C (A 1 0) * MvPolynomial.X 0 +
              MvPolynomial.C (A 1 1) * MvPolynomial.X 1) - q_ℓ =
          MvPolynomial.C c⁻¹ * (L 0 * L 1 - MvPolynomial.C c * q_ℓ) := by
        have hcc : (MvPolynomial.C c⁻¹ : P_2) * MvPolynomial.C c = 1 := by
          rw [← map_mul, inv_mul_cancel₀ hc_ne, map_one]
        dsimp [L]
        simp only [map_mul]
        calc (MvPolynomial.C c⁻¹ * MvPolynomial.C (A 0 0) * MvPolynomial.X 0 +
                MvPolynomial.C c⁻¹ * MvPolynomial.C (A 0 1) * MvPolynomial.X 1) *
              (MvPolynomial.C (A 1 0) * MvPolynomial.X 0 +
                MvPolynomial.C (A 1 1) * MvPolynomial.X 1) - q_ℓ
          _ = MvPolynomial.C c⁻¹ *
                ((MvPolynomial.C (A 0 0) * MvPolynomial.X 0 +
                    MvPolynomial.C (A 0 1) * MvPolynomial.X 1) *
                  (MvPolynomial.C (A 1 0) * MvPolynomial.X 0 +
                    MvPolynomial.C (A 1 1) * MvPolynomial.X 1)) -
              (1 : P_2) * q_ℓ := by ring
          _ = MvPolynomial.C c⁻¹ *
                ((MvPolynomial.C (A 0 0) * MvPolynomial.X 0 +
                    MvPolynomial.C (A 0 1) * MvPolynomial.X 1) *
                  (MvPolynomial.C (A 1 0) * MvPolynomial.X 0 +
                    MvPolynomial.C (A 1 1) * MvPolynomial.X 1)) -
              (MvPolynomial.C c⁻¹ * MvPolynomial.C c) * q_ℓ := by rw [hcc]
          _ = _ := by ring
      rw [hpoly_scale]
      exact Ideal.mul_mem_left _ _ hLL_sub_cq

  
  
  
  · have h_first : ∀ (c₁ c₂ : k), c₁ ≠ 0 → c₂ ≠ 0 →
        ∀ (r_u r_v : P_2), r_u ∈ m_0 ^ 2 → r_v ∈ m_0 ^ 2 →
        ∀ n : ℕ,
          (MvPolynomial.C c₂ * MvPolynomial.X 0 + r_v) ^ n ∉
            Ideal.span {MvPolynomial.C c₁ * MvPolynomial.X 1 + r_u} ⊔ m_0 ^ (n + 1) := by
      intro c₁ c₂ hc₁ hc₂ r_u r_v hru hrv n hVn_mem
      let L_U : P_2 := MvPolynomial.C c₁ * MvPolynomial.X 1
      let L_V : P_2 := MvPolynomial.C c₂ * MvPolynomial.X 0
      let U : P_2 := L_U + r_u
      let V : P_2 := L_V + r_v
      have hLU_mem : L_U ∈ m_0 := Ideal.mul_mem_left _ _ hX1_mem
      have hLV_mem : L_V ∈ m_0 := Ideal.mul_mem_left _ _ hX0_mem
      have hU_mem : U ∈ m_0 := add_mem hLU_mem (Ideal.pow_le_self (by decide : 2 ≠ 0) hru)
      have hV_mem : V ∈ m_0 := add_mem hLV_mem (Ideal.pow_le_self (by decide : 2 ≠ 0) hrv)
      have hLV_pow : ∀ m : ℕ,
          L_V ^ m = MvPolynomial.monomial (Finsupp.single (0 : Fin 2) m) (c₂ ^ m) := by
        intro m
        dsimp [L_V]
        rw [mul_pow, ← map_pow, MvPolynomial.C_mul_X_pow_eq_monomial]
      have hV_pow_sub : ∀ m : ℕ, V ^ m - L_V ^ m ∈ m_0 ^ (m + 1) := by
        intro m
        induction m with
        | zero =>
          simp
        | succ m ih =>
          have hid : V ^ (m + 1) - L_V ^ (m + 1) =
              r_v * V ^ m + L_V * (V ^ m - L_V ^ m) := by
            dsimp [V]
            ring
          rw [hid]
          have hterm1 : r_v * V ^ m ∈ m_0 ^ (m + 2) := by
            rw [Nat.add_comm m 2, pow_add]
            exact Ideal.mul_mem_mul hrv (Ideal.pow_mem_pow hV_mem m)
          have hterm2 : L_V * (V ^ m - L_V ^ m) ∈ m_0 ^ (m + 2) := by
            rw [pow_succ' m_0 (m + 1)]
            exact Ideal.mul_mem_mul hLV_mem ih
          exact add_mem hterm1 hterm2
      rcases Submodule.mem_sup.mp hVn_mem with ⟨y, hy, R, hR, hyR⟩
      rcases Ideal.mem_span_singleton.mp hy with ⟨W, rfl⟩
      have hUW_sub : U * W - L_V ^ n ∈ m_0 ^ (n + 1) := by
        have hid : U * W - L_V ^ n = (V ^ n - L_V ^ n) - R := by
          have hVn_eq : V ^ n = U * W + R := hyR.symm
          rw [hVn_eq]
          ring
        rw [hid]
        exact sub_mem (hV_pow_sub n) hR
      have hW_pow : ∀ j : ℕ, j ≤ n → W ∈ m_0 ^ j := by
        intro j
        induction j with
        | zero =>
          intro _
          exact (h_mem_pow 0 W).mpr fun _ hd => absurd hd (Nat.not_lt_zero _)
        | succ j ih =>
          intro hj
          have hWj : W ∈ m_0 ^ j := ih (Nat.le_of_succ_le hj)
          rw [h_mem_pow (j + 1)]
          intro d hd
          by_cases hlt : d 0 + d 1 < j
          · exact (h_mem_pow j W).mp hWj d hlt
          · have hd_eq : d 0 + d 1 = j := by omega
            let d' : Fin 2 →₀ ℕ := d + e 1
            have hd'_deg : d' 0 + d' 1 = j + 1 := by
              simp only [d', e, Finsupp.add_apply, Finsupp.single_eq_of_ne (by decide : (0 : Fin 2) ≠ 1),
                Finsupp.single_eq_same]
              omega
            have hdiff_d' : (U * W - L_V ^ n).coeff d' = 0 :=
              (h_mem_pow (n + 1) _).mp hUW_sub d' (by omega)
            have hLV_d' : (L_V ^ n).coeff d' = 0 := by
              rw [hLV_pow n, MvPolynomial.coeff_monomial]
              have hne : Finsupp.single (0 : Fin 2) n ≠ d' := by
                intro hc
                have h1 : (Finsupp.single (0 : Fin 2) n : Fin 2 →₀ ℕ) 1 = d' 1 := by rw [hc]
                simp only [d', e, Finsupp.add_apply,
                  Finsupp.single_eq_of_ne (by decide : (1 : Fin 2) ≠ 0),
                  Finsupp.single_eq_same] at h1
                omega
              simp [hne]
            have hUW_d' : (U * W).coeff d' = 0 := by
              rw [coeff_sub_eq, hLV_d', sub_zero] at hdiff_d'
              exact hdiff_d'
            have hruW_mem : r_u * W ∈ m_0 ^ (j + 2) := by
              rw [Nat.add_comm j 2, pow_add]
              exact Ideal.mul_mem_mul hru hWj
            have hruW_d' : (r_u * W).coeff d' = 0 :=
              (h_mem_pow (j + 2) _).mp hruW_mem d' (by omega)
            have hUW_split : U * W = MvPolynomial.C c₁ * (W * MvPolynomial.X 1) + r_u * W := by
              dsimp [U, L_U]
              ring
            rw [hUW_split, coeff_add_eq, hruW_d', add_zero, MvPolynomial.coeff_C_mul] at hUW_d'
            dsimp only [d', e] at hUW_d'
            rw [MvPolynomial.coeff_mul_X] at hUW_d'
            exact (mul_eq_zero.mp hUW_d').resolve_left hc₁
      have hWn : W ∈ m_0 ^ n := hW_pow n le_rfl
      have hUW_mem : U * W ∈ m_0 ^ (n + 1) := by
        rw [pow_succ' m_0 n]
        exact Ideal.mul_mem_mul hU_mem hWn
      have hLVn_mem : L_V ^ n ∈ m_0 ^ (n + 1) := by
        have hsub := sub_mem hUW_mem hUW_sub
        rwa [sub_sub_cancel] at hsub
      let d₀ : Fin 2 →₀ ℕ := Finsupp.single 0 n
      have hd₀_lt : d₀ 0 + d₀ 1 < n + 1 := by
        simp [d₀]
      have h0_coeff : (L_V ^ n).coeff d₀ = 0 :=
        (h_mem_pow (n + 1) _).mp hLVn_mem d₀ hd₀_lt
      rw [hLV_pow n, MvPolynomial.coeff_monomial] at h0_coeff
      simp only [d₀, ↓reduceIte] at h0_coeff
      exact pow_ne_zero n hc₂ h0_coeff
    intro c₁ c₂ hc₁ hc₂ r_u r_v hru hrv n
    refine ⟨h_first c₁ c₂ hc₁ hc₂ r_u r_v hru hrv n, ?_⟩
    intro hUn_mem
    let τ : P_2 ≃ₐ[k] P_2 := MvPolynomial.renameEquiv k (Equiv.swap (0 : Fin 2) 1)
    have hτ_X0 : τ (MvPolynomial.X 0) = MvPolynomial.X 1 := by
      change MvPolynomial.rename (Equiv.swap (0 : Fin 2) 1) (MvPolynomial.X 0) = MvPolynomial.X 1
      rw [MvPolynomial.rename_X, Equiv.swap_apply_left]
    have hτ_X1 : τ (MvPolynomial.X 1) = MvPolynomial.X 0 := by
      change MvPolynomial.rename (Equiv.swap (0 : Fin 2) 1) (MvPolynomial.X 1) = MvPolynomial.X 0
      rw [MvPolynomial.rename_X, Equiv.swap_apply_right]
    have hτ_C : ∀ a : k, τ (MvPolynomial.C a) = MvPolynomial.C a := by
      intro a
      change MvPolynomial.rename (Equiv.swap (0 : Fin 2) 1) (MvPolynomial.C a) = MvPolynomial.C a
      exact MvPolynomial.rename_C _ a
    have hτ_m0 : Ideal.map τ.toRingHom m_0 ≤ m_0 := by
      rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
      intro f hf
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hf
      rcases hf with rfl | rfl
      · change τ (MvPolynomial.X 0) ∈ m_0
        rw [hτ_X0]; exact hX1_mem
      · change τ (MvPolynomial.X 1) ∈ m_0
        rw [hτ_X1]; exact hX0_mem
    have hτ_pow : ∀ (m : ℕ) {f : P_2}, f ∈ m_0 ^ m → τ f ∈ m_0 ^ m := by
      intro m f hf
      have hmem : τ.toRingHom f ∈ Ideal.map τ.toRingHom (m_0 ^ m) :=
        Ideal.mem_map_of_mem _ hf
      rw [Ideal.map_pow] at hmem
      exact pow_le_pow_left' hτ_m0 m hmem
    rcases Submodule.mem_sup.mp hUn_mem with ⟨y, hy, R, hR, hyR⟩
    rcases Ideal.mem_span_singleton.mp hy with ⟨W, rfl⟩
    have hτU : τ (MvPolynomial.C c₁ * MvPolynomial.X 1 + r_u) =
        MvPolynomial.C c₁ * MvPolynomial.X 0 + τ r_u := by
      rw [map_add, map_mul, hτ_C, hτ_X1]
    have hτV : τ (MvPolynomial.C c₂ * MvPolynomial.X 0 + r_v) =
        MvPolynomial.C c₂ * MvPolynomial.X 1 + τ r_v := by
      rw [map_add, map_mul, hτ_C, hτ_X0]
    have hswap_mem : (MvPolynomial.C c₁ * MvPolynomial.X 0 + τ r_u) ^ n ∈
        Ideal.span {MvPolynomial.C c₂ * MvPolynomial.X 1 + τ r_v} ⊔ m_0 ^ (n + 1) := by
      have heq : (MvPolynomial.C c₁ * MvPolynomial.X 0 + τ r_u) ^ n =
          (MvPolynomial.C c₂ * MvPolynomial.X 1 + τ r_v) * τ W + τ R := by
        rw [← hτU, ← hτV, ← map_pow, ← map_mul, ← map_add, hyR]
      rw [heq]
      exact add_mem
        (Ideal.mem_sup_left (Ideal.mem_span_singleton.mpr ⟨τ W, rfl⟩))
        (Ideal.mem_sup_right (hτ_pow (n + 1) hR))
    exact h_first c₂ c₁ hc₂ hc₁ (τ r_v) (τ r_u) (hτ_pow 2 hrv) (hτ_pow 2 hru) n hswap_mem

theorem weil_ring_standardEtale_quad_nodal_factorization (k : Type u) [Field k]
    (A_Z : Type u) [CommRing A_Z]
    (ψ'_Z : MvPolynomial (Fin 2) k →+* A_Z) (hψ' : ψ'_Z.Etale)
    (p_z : Ideal A_Z) [p_z.IsMaximal]
    (ε_Z : A_Z →+* k)
    (hker_Z : RingHom.ker ε_Z = p_z)
    (hε_id : ε_Z.comp (ψ'_Z.comp MvPolynomial.C) = RingHom.id k)
    (hp'_center : ∀ i : Fin 2, ψ'_Z (MvPolynomial.X i) ∈ p_z)
    (ℓ : A_Z)
    (hm_Z_span : IsLocalRing.maximalIdeal (Localization.AtPrime p_z) =
      Ideal.span {algebraMap A_Z (Localization.AtPrime p_z) (ψ'_Z (MvPolynomial.X 0)),
        algebraMap A_Z (Localization.AtPrime p_z) (ψ'_Z (MvPolynomial.X 1))})
    (hℓ_jet : algebraMap A_Z (Localization.AtPrime p_z)
        (ℓ - ψ'_Z (MvPolynomial.X 0 * MvPolynomial.X 1)) ∈
      (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 3) :
    ∃ (A'_Z : CommRingCat.{u})
      (ι_et : A_Z →+* A'_Z)
      (q'_0 : Ideal A'_Z)
      (ε'_Z : A'_Z →+* k)
      (u_A v_A : A'_Z)
      (c_s : k),
      (ι_et.Etale ∧ q'_0.IsMaximal ∧ RingHom.ker ε'_Z = q'_0 ∧
        ε'_Z.comp ι_et = ε_Z ∧ p_z = Ideal.comap ι_et q'_0) ∧
      u_A * v_A = ι_et ℓ ∧
      Ideal.span {u_A, v_A} =
        Ideal.span {ι_et (ψ'_Z (MvPolynomial.X 0)), ι_et (ψ'_Z (MvPolynomial.X 1))} ∧
      (c_s ≠ 0 ∧
        u_A - ι_et (ψ'_Z (MvPolynomial.C c_s * MvPolynomial.X 1)) ∈ q'_0 ^ 2 ∧
        v_A - ι_et (ψ'_Z (MvPolynomial.C c_s⁻¹ * MvPolynomial.X 0)) ∈ q'_0 ^ 2) :=
by
  have _ := hψ'
  have hpz_prime : p_z.IsPrime := Ideal.IsMaximal.isPrime inferInstance
  have : p_z.IsPrime := hpz_prime
  have : Nontrivial A_Z := by
    refine ⟨⟨0, 1, fun h01 => hpz_prime.ne_top ?_⟩⟩
    rw [Ideal.eq_top_iff_one, ← h01]
    exact p_z.zero_mem

  
  let x₀ : A_Z := ψ'_Z (MvPolynomial.X 0)
  let x₁ : A_Z := ψ'_Z (MvPolynomial.X 1)
  have hx₀ : x₀ ∈ p_z := hp'_center 0
  have hx₁ : x₁ ∈ p_z := hp'_center 1
  let J : Ideal A_Z := Ideal.span {x₀, x₁}
  let R_Z := Localization.AtPrime p_z
  let loc : A_Z →+* R_Z := algebraMap A_Z R_Z

  have hm_map : IsLocalRing.maximalIdeal R_Z = Ideal.map loc J := by
    rw [hm_Z_span, Ideal.map_span]
    congr 1
    ext y
    simp [x₀, x₁, loc, R_Z]

  have hm3_map : (IsLocalRing.maximalIdeal R_Z) ^ 3 = Ideal.map loc (J ^ 3) := by
    rw [hm_map, Ideal.map_pow]

  have hloc_mem : loc (ℓ - x₀ * x₁) ∈ Ideal.map loc (J ^ 3) := by
    rw [← hm3_map]
    simpa only [loc, R_Z, x₀, x₁, map_mul] using hℓ_jet

  obtain ⟨s₀, hs₀, hs₀_mem⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff p_z.primeCompl R_Z (J ^ 3)
      (ℓ - x₀ * x₁)).mp hloc_mem
  have hs₀_not_pz : s₀ ∉ p_z := hs₀

  
  let S₂ : Ideal A_Z :=
    { carrier := {w : A_Z | ∃ c₀ c₁ c₂ : A_Z, w = c₀ * x₀ ^ 2 + c₁ * x₀ * x₁ + c₂ * x₁ ^ 2}
      zero_mem' := ⟨0, 0, 0, by ring⟩
      add_mem' := by
        rintro _ _ ⟨a₀, a₁, a₂, rfl⟩ ⟨b₀, b₁, b₂, rfl⟩
        exact ⟨a₀ + b₀, a₁ + b₁, a₂ + b₂, by ring⟩
      smul_mem' := by
        rintro r _ ⟨a₀, a₁, a₂, rfl⟩
        exact ⟨r * a₀, r * a₁, r * a₂, by ring⟩ }

  let S_ideal : Ideal A_Z :=
    { carrier := {w : A_Z | ∃ Q₁₁ ∈ p_z, ∃ Q₂₂ ∈ p_z, w = Q₁₁ * x₀ ^ 2 + Q₂₂ * x₁ ^ 2}
      zero_mem' := ⟨0, p_z.zero_mem, 0, p_z.zero_mem, by ring⟩
      add_mem' := by
        rintro _ _ ⟨q₁, hq₁, q₂, hq₂, rfl⟩ ⟨q₁', hq₁', q₂', hq₂', rfl⟩
        exact ⟨q₁ + q₁', p_z.add_mem hq₁ hq₁', q₂ + q₂', p_z.add_mem hq₂ hq₂', by ring⟩
      smul_mem' := by
        rintro r _ ⟨q₁, hq₁, q₂, hq₂, rfl⟩
        exact ⟨r * q₁, p_z.mul_mem_left r hq₁, r * q₂, p_z.mul_mem_left r hq₂, by ring⟩ }

  have hJ2 : J * J ≤ S₂ := by
    rw [Ideal.mul_le]
    intro u hu v hv
    obtain ⟨a₁, b₁, rfl⟩ := Ideal.mem_span_pair.mp hu
    obtain ⟨a₂, b₂, rfl⟩ := Ideal.mem_span_pair.mp hv
    exact ⟨a₁ * a₂, a₁ * b₂ + b₁ * a₂, b₁ * b₂, by ring⟩

  have hJS2 : J * S₂ ≤ S_ideal := by
    rw [Ideal.mul_le]
    intro u hu w hw
    obtain ⟨a, b, rfl⟩ := Ideal.mem_span_pair.mp hu
    obtain ⟨c₀, c₁, c₂, rfl⟩ := hw
    refine ⟨a * c₀ * x₀ + (a * c₁ + b * c₀) * x₁,
      p_z.add_mem (p_z.mul_mem_left _ hx₀) (p_z.mul_mem_left _ hx₁),
      (a * c₂ + b * c₁) * x₀ + b * c₂ * x₁,
      p_z.add_mem (p_z.mul_mem_left _ hx₀) (p_z.mul_mem_left _ hx₁), ?_⟩
    ring

  have hJ3 : J ^ 3 ≤ S_ideal := by
    have hpow3 : J ^ 3 = J * (J * J) := by ring
    rw [hpow3]
    exact (Ideal.mul_mono_right hJ2).trans hJS2

  obtain ⟨Q₁₁, hQ₁₁, Q₂₂, hQ₂₂, hs₀_diff⟩ := hJ3 hs₀_mem
  have hs₀_ell : s₀ * ℓ = Q₁₁ * x₀ ^ 2 + s₀ * x₀ * x₁ + Q₂₂ * x₁ ^ 2 := by
    linear_combination hs₀_diff

  
  let P_quad : Polynomial A_Z :=
    Polynomial.X ^ 2 - Polynomial.C s₀ * Polynomial.X + Polynomial.C (Q₁₁ * Q₂₂)
  let p₁ : Polynomial A_Z :=
    (Polynomial.C s₀ - Polynomial.X) * Polynomial.C s₀
  let g_et : Polynomial A_Z := Polynomial.derivative P_quad * p₁

  have hMon : P_quad.Monic :=
    (Polynomial.isMonicOfDegree_sub_add_two s₀ (Q₁₁ * Q₂₂)).monic

  let P_et : StandardEtalePair A_Z :=
    StandardEtalePair.mk P_quad hMon g_et ⟨p₁, 0, 1, by rw [mul_zero, add_zero, pow_one]⟩

  let A'_Z : CommRingCat.{u} := CommRingCat.of P_et.Ring
  let ι_et : A_Z →+* A'_Z := algebraMap A_Z P_et.Ring
  have hι_et : ι_et.Etale :=
    RingHom.etale_algebraMap.mpr (StandardEtalePair.instEtaleRing P_et)

  have hderiv : Polynomial.derivative P_quad =
      Polynomial.C 2 * Polynomial.X - Polynomial.C s₀ := by
    dsimp only [P_quad]
    rw [Polynomial.derivative_add, Polynomial.derivative_sub, Polynomial.derivative_X_pow,
      Polynomial.derivative_C_mul, Polynomial.derivative_X, Polynomial.derivative_C]
    simp only [Nat.cast_ofNat, Nat.reduceSub, pow_one, mul_one, add_zero]

  
  let c_s : k := ε_Z s₀
  have hc_s : c_s ≠ 0 := by
    intro hc0
    have hmem : s₀ ∈ RingHom.ker ε_Z := hc0
    rw [hker_Z] at hmem
    exact hs₀_not_pz hmem

  have hε_Q₁₁ : ε_Z Q₁₁ = 0 := by
    have hmem : Q₁₁ ∈ RingHom.ker ε_Z := hker_Z.symm ▸ hQ₁₁
    exact hmem

  have hAug : ∃ (ε'_Z : A'_Z →+* k),
      ε'_Z.comp ι_et = ε_Z ∧ ε'_Z P_et.X = 0 := by
    let _ : Algebra A_Z k := ε_Z.toAlgebra
    have hHasMap0 : P_et.HasMap (0 : k) := by
      refine ⟨?_, ?_⟩
      · change Polynomial.aeval (0 : k) P_quad = 0
        dsimp only [P_quad]
        rw [map_add, map_sub, map_pow, map_mul, Polynomial.aeval_X, Polynomial.aeval_C,
          Polynomial.aeval_C]
        change (0 : k) ^ 2 - ε_Z s₀ * 0 + ε_Z (Q₁₁ * Q₂₂) = 0
        rw [map_mul, hε_Q₁₁]
        ring
      · change IsUnit (Polynomial.aeval (0 : k) g_et)
        dsimp only [g_et, p₁]
        rw [hderiv, map_mul, map_mul, map_sub, map_sub, map_mul,
          Polynomial.aeval_X, Polynomial.aeval_C, Polynomial.aeval_C]
        change IsUnit ((ε_Z 2 * (0 : k) - c_s) * ((c_s - 0) * c_s))
        have hval : (ε_Z 2 * (0 : k) - c_s) * ((c_s - 0) * c_s) = -(c_s ^ 3) := by ring
        rw [hval]
        exact Ne.isUnit (neg_ne_zero.mpr (pow_ne_zero 3 hc_s))
    let ε'_alg : P_et.Ring →ₐ[A_Z] k := P_et.lift (0 : k) hHasMap0
    refine ⟨ε'_alg.toRingHom, ?_, P_et.lift_X (0 : k) hHasMap0⟩
    ext a
    exact ε'_alg.commutes a

  obtain ⟨ε'_Z, hε'_comp, hθ_ker⟩ := hAug
  let q'_0 : Ideal A'_Z := RingHom.ker ε'_Z

  have hε'_C : ∀ c : k, ε'_Z (ι_et (ψ'_Z (MvPolynomial.C c))) = c := by
    intro c
    change (ε'_Z.comp ι_et) (ψ'_Z (MvPolynomial.C c)) = c
    rw [hε'_comp]
    exact RingHom.congr_fun hε_id c

  have hε'_surj : Function.Surjective ε'_Z := fun c =>
    ⟨ι_et (ψ'_Z (MvPolynomial.C c)), hε'_C c⟩

  have hq'0_max : q'_0.IsMaximal :=
    RingHom.ker_isMaximal_of_surjective ε'_Z hε'_surj

  have hpz_comap : p_z = Ideal.comap ι_et q'_0 := by
    rw [← hker_Z]
    ext a
    change ε_Z a = 0 ↔ ε'_Z (ι_et a) = 0
    rw [← hε'_comp]
    rfl

  
  let θ : A'_Z := P_et.X
  let s₀' : A'_Z := ι_et s₀
  let q₁ : A'_Z := ι_et Q₁₁
  let q₂ : A'_Z := ι_et Q₂₂
  let x₀' : A'_Z := ι_et x₀
  let x₁' : A'_Z := ι_et x₁
  let μ : A'_Z := s₀' - θ
  let δ : A'_Z := 2 * θ - s₀'

  obtain ⟨hX_f, hX_g⟩ := P_et.hasMap_X

  have hq12 : q₁ * q₂ = μ * θ := by
    have hf0 : Polynomial.aeval θ P_quad = 0 := hX_f
    dsimp only [P_quad] at hf0
    rw [map_add, map_sub, map_pow, map_mul, Polynomial.aeval_X, Polynomial.aeval_C,
      Polynomial.aeval_C] at hf0
    change θ ^ 2 - s₀' * θ + ι_et (Q₁₁ * Q₂₂) = 0 at hf0
    rw [map_mul] at hf0
    change θ ^ 2 - s₀' * θ + q₁ * q₂ = 0 at hf0
    dsimp only [μ]
    linear_combination hf0

  have hUnit_prod : IsUnit (δ * (μ * s₀')) := by
    have hg_u : IsUnit (Polynomial.aeval θ g_et) := hX_g
    dsimp only [g_et, p₁] at hg_u
    rw [hderiv, map_mul, map_mul, map_sub, map_sub, map_mul,
      Polynomial.aeval_X, Polynomial.aeval_C, Polynomial.aeval_C] at hg_u
    change IsUnit ((ι_et 2 * θ - s₀') * ((s₀' - θ) * s₀')) at hg_u
    rw [map_ofNat] at hg_u
    exact hg_u

  have hδ : IsUnit δ := isUnit_of_mul_isUnit_left hUnit_prod
  have hμs : IsUnit (μ * s₀') := isUnit_of_mul_isUnit_right hUnit_prod
  have hμ : IsUnit μ := isUnit_of_mul_isUnit_left hμs
  have hs₀' : IsUnit s₀' := isUnit_of_mul_isUnit_right hμs

  let s₀'_inv : A'_Z := ↑(hs₀'.unit⁻¹)
  let μ_inv : A'_Z := ↑(hμ.unit⁻¹)
  let δ_inv : A'_Z := ↑(hδ.unit⁻¹)

  have hs₀'_mul : s₀' * s₀'_inv = 1 := hs₀'.mul_val_inv
  have hμ_mul : μ * μ_inv = 1 := hμ.mul_val_inv
  have hδ_mul : δ * δ_inv = 1 := hδ.mul_val_inv

  let u_A : A'_Z := q₁ * x₀' + μ * x₁'
  let v_A : A'_Z := s₀'_inv * (x₀' + μ_inv * q₂ * x₁')

  have hι_ell : s₀' * ι_et ℓ = q₁ * x₀' ^ 2 + s₀' * x₀' * x₁' + q₂ * x₁' ^ 2 := by
    have h := congrArg ι_et hs₀_ell
    simpa only [map_mul, map_add, map_pow, s₀', q₁, q₂, x₀', x₁'] using h

  have huv_prod : u_A * v_A = ι_et ℓ := by
    dsimp only [u_A, v_A, μ] at *
    linear_combination
      s₀'_inv * μ_inv * x₀' * x₁' * hq12 +
      s₀'_inv * (θ * x₀' * x₁' + q₂ * x₁' ^ 2) * hμ_mul -
      s₀'_inv * hι_ell +
      ι_et ℓ * hs₀'_mul

  have huv_span : Ideal.span {u_A, v_A} = Ideal.span {x₀', x₁'} := by
    apply le_antisymm
    · rw [Ideal.span_le]
      intro z hz
      have hx₀'_mem : x₀' ∈ Ideal.span {x₀', x₁'} :=
        Ideal.subset_span (Set.mem_insert _ _)
      have hx₁'_mem : x₁' ∈ Ideal.span {x₀', x₁'} :=
        Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
      rcases Set.mem_insert_iff.mp hz with rfl | hz1
      · exact Ideal.add_mem _
          (Ideal.mul_mem_left _ q₁ hx₀'_mem)
          (Ideal.mul_mem_left _ μ hx₁'_mem)
      · rw [Set.mem_singleton_iff.mp hz1]
        have hv_eq : v_A = s₀'_inv * x₀' + (s₀'_inv * μ_inv * q₂) * x₁' := by
          dsimp only [v_A]
          ring
        rw [hv_eq]
        exact Ideal.add_mem _
          (Ideal.mul_mem_left _ s₀'_inv hx₀'_mem)
          (Ideal.mul_mem_left _ (s₀'_inv * μ_inv * q₂) hx₁'_mem)
    · rw [Ideal.span_le]
      intro z hz
      have hu_mem : u_A ∈ Ideal.span {u_A, v_A} :=
        Ideal.subset_span (Set.mem_insert _ _)
      have hv_mem : v_A ∈ Ideal.span {u_A, v_A} :=
        Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
      let a₁₁ : A'_Z := q₁
      let a₁₂ : A'_Z := μ
      let a₂₁ : A'_Z := s₀'_inv
      let a₂₂ : A'_Z := s₀'_inv * μ_inv * q₂
      let d_det : A'_Z := a₁₁ * a₂₂ - a₁₂ * a₂₁
      let d_inv : A'_Z := s₀' * δ_inv
      have hd_det : d_det = s₀'_inv * δ := by
        dsimp only [d_det, a₁₁, a₁₂, a₂₁, a₂₂, μ, δ] at *
        linear_combination
          s₀'_inv * μ_inv * hq12 + s₀'_inv * θ * hμ_mul
      have hd_inv : d_inv * d_det = 1 := by
        rw [hd_det]
        dsimp only [d_inv]
        linear_combination (δ * δ_inv) * hs₀'_mul + hδ_mul
      rcases Set.mem_insert_iff.mp hz with rfl | hz1
      · have hx₀_cramer : x₀' = (d_inv * a₂₂) * u_A + (-d_inv * a₁₂) * v_A := by
          have hcram : a₂₂ * u_A - a₁₂ * v_A = d_det * x₀' := by
            dsimp only [u_A, v_A, d_det, a₁₁, a₁₂, a₂₁, a₂₂]
            ring
          linear_combination -x₀' * hd_inv + d_inv * hcram
        rw [hx₀_cramer]
        exact Ideal.add_mem _
          (Ideal.mul_mem_left _ (d_inv * a₂₂) hu_mem)
          (Ideal.mul_mem_left _ (-d_inv * a₁₂) hv_mem)
      · rw [Set.mem_singleton_iff.mp hz1]
        have hx₁_cramer : x₁' = (-d_inv * a₂₁) * u_A + (d_inv * a₁₁) * v_A := by
          have hcram : a₁₁ * v_A - a₂₁ * u_A = d_det * x₁' := by
            dsimp only [u_A, v_A, d_det, a₁₁, a₁₂, a₂₁, a₂₂]
            ring
          linear_combination -x₁' * hd_inv + d_inv * hcram
        rw [hx₁_cramer]
        exact Ideal.add_mem _
          (Ideal.mul_mem_left _ (-d_inv * a₂₁) hu_mem)
          (Ideal.mul_mem_left _ (d_inv * a₁₁) hv_mem)

  have hx₀'_q : x₀' ∈ q'_0 := by
    change x₀ ∈ Ideal.comap ι_et q'_0
    rwa [← hpz_comap]
  have hx₁'_q : x₁' ∈ q'_0 := by
    change x₁ ∈ Ideal.comap ι_et q'_0
    rwa [← hpz_comap]
  have hq₁_q : q₁ ∈ q'_0 := by
    change Q₁₁ ∈ Ideal.comap ι_et q'_0
    rwa [← hpz_comap]
  have hq₂_q : q₂ ∈ q'_0 := by
    change Q₂₂ ∈ Ideal.comap ι_et q'_0
    rwa [← hpz_comap]

  have hmul_q2 : ∀ a b : A'_Z, a ∈ q'_0 → b ∈ q'_0 → a * b ∈ q'_0 ^ 2 := by
    intro a b ha hb
    rw [sq]
    exact Ideal.mul_mem_mul ha hb

  have hε'_s₀' : ε'_Z s₀' = c_s := by
    change (ε'_Z.comp ι_et) s₀ = c_s
    rw [hε'_comp]

  have hu_jet : u_A - ι_et (ψ'_Z (MvPolynomial.C c_s * MvPolynomial.X 1)) ∈ q'_0 ^ 2 := by
    have heq : u_A - ι_et (ψ'_Z (MvPolynomial.C c_s * MvPolynomial.X 1)) =
        q₁ * x₀' + (μ - ι_et (ψ'_Z (MvPolynomial.C c_s))) * x₁' := by
      rw [map_mul, map_mul]
      dsimp only [u_A, x₁', x₀']
      ring
    rw [heq]
    have hμ_diff : μ - ι_et (ψ'_Z (MvPolynomial.C c_s)) ∈ q'_0 := by
      change ε'_Z (μ - ι_et (ψ'_Z (MvPolynomial.C c_s))) = 0
      dsimp only [μ, θ]
      rw [map_sub, map_sub, hε'_s₀', hθ_ker, hε'_C]
      ring
    exact (q'_0 ^ 2).add_mem
      (hmul_q2 q₁ x₀' hq₁_q hx₀'_q)
      (hmul_q2 _ x₁' hμ_diff hx₁'_q)

  have hv_jet : v_A - ι_et (ψ'_Z (MvPolynomial.C c_s⁻¹ * MvPolynomial.X 0)) ∈ q'_0 ^ 2 := by
    have heq : v_A - ι_et (ψ'_Z (MvPolynomial.C c_s⁻¹ * MvPolynomial.X 0)) =
        (s₀'_inv - ι_et (ψ'_Z (MvPolynomial.C c_s⁻¹))) * x₀' +
          (s₀'_inv * μ_inv * q₂) * x₁' := by
      rw [map_mul, map_mul]
      dsimp only [v_A, x₀', x₁']
      ring
    rw [heq]
    have hε'_s₀'_inv : ε'_Z s₀'_inv = c_s⁻¹ := by
      have h1 : c_s * ε'_Z s₀'_inv = 1 := by
        rw [← hε'_s₀', ← map_mul, hs₀'_mul, map_one]
      calc ε'_Z s₀'_inv = c_s⁻¹ * (c_s * ε'_Z s₀'_inv) := by
            rw [← mul_assoc, inv_mul_cancel₀ hc_s, one_mul]
        _ = c_s⁻¹ := by rw [h1, mul_one]
    have hs_diff : s₀'_inv - ι_et (ψ'_Z (MvPolynomial.C c_s⁻¹)) ∈ q'_0 := by
      change ε'_Z (s₀'_inv - ι_et (ψ'_Z (MvPolynomial.C c_s⁻¹))) = 0
      rw [map_sub, hε'_s₀'_inv, hε'_C, sub_self]
    exact (q'_0 ^ 2).add_mem
      (hmul_q2 _ x₀' hs_diff hx₀'_q)
      (hmul_q2 _ x₁' (q'_0.mul_mem_left (s₀'_inv * μ_inv) hq₂_q) hx₁'_q)

  exact ⟨A'_Z, ι_et, q'_0, ε'_Z, u_A, v_A, c_s,
    ⟨hι_et, hq'0_max, rfl, hε'_comp, hpz_comap⟩,
    huv_prod, huv_span, ⟨hc_s, hu_jet, hv_jet⟩⟩

theorem weil_local_nodal_split_two_branches_and_pole_clearing (A_Z : Type u) [CommRing A_Z]
    (p_z : Ideal A_Z) [p_z.IsMaximal]
    (ℓ : A_Z) (hℓ_p : ℓ ∈ p_z)
    (R'_Z : Type u) [CommRing R'_Z] [IsDomain R'_Z] [IsLocalRing R'_Z] [IsNoetherianRing R'_Z]
    (φ_loc : Localization.AtPrime p_z →+* R'_Z) [IsLocalHom φ_loc]
    (hFlat : φ_loc.Flat)
    (u_tilde v_tilde : R'_Z)
    (h_prod : φ_loc (algebraMap A_Z (Localization.AtPrime p_z) ℓ) = u_tilde * v_tilde)
    (h_max_span : IsLocalRing.maximalIdeal R'_Z = Ideal.span {u_tilde, v_tilde})
    (h_nondiv_u : ∀ n : ℕ, v_tilde ^ n ∉ Ideal.span {u_tilde})
    (h_nondiv_v : ∀ n : ℕ, u_tilde ^ n ∉ Ideal.span {v_tilde})
    (h_red : ∀ (P : Ideal A_Z) [P.IsPrime], P < p_z →
      IsReduced (R'_Z ⧸ Ideal.map (φ_loc.comp (algebraMap A_Z (Localization.AtPrime p_z))) P)) :
    (¬ ∃ (P₁ P₂ P₃ : Ideal A_Z),
      P₁.IsPrime ∧ P₂.IsPrime ∧ P₃.IsPrime ∧
      P₁ ≠ P₂ ∧ P₁ ≠ P₃ ∧ P₂ ≠ P₃ ∧
      P₁ < p_z ∧ P₂ < p_z ∧ P₃ < p_z ∧
      ℓ ∈ P₁ ∧ ℓ ∈ P₂ ∧ ℓ ∈ P₃) ∧
    (∀ (P₁ P₂ : Ideal A_Z) [P₁.IsPrime] [P₂.IsPrime],
      P₁ < p_z → P₂ < p_z → ¬(P₁ ≤ P₂) → ¬(P₂ ≤ P₁) →
      ℓ ∈ P₁ → ℓ ∈ P₂ →
      ∀ (u_unit s g c t_diff : A_Z) (j : ℕ),
        u_unit ∉ p_z →
        s ∉ P₁ →
        t_diff ∈ p_z →
        algebraMap A_Z (Localization.AtPrime p_z) (s * g) =
          (algebraMap A_Z (Localization.AtPrime p_z) (u_unit * ℓ)) ^ j *
            algebraMap A_Z (Localization.AtPrime p_z) c →
        ∃ (d r : A_Z), d ∉ p_z ∧ d * t_diff ^ j * c - s * r ∈ P₁) :=
by
  have _ := hℓ_p
  have h_prime_dich :
      ∀ (u v : R'_Z),
        IsLocalRing.maximalIdeal R'_Z = Ideal.span {u, v} →
        (∀ n : ℕ, v ^ n ∉ Ideal.span {u}) →
        (Ideal.span {u}).IsPrime ∧
        ∀ (Q : Ideal R'_Z), Q.IsPrime → u ∈ Q →
          Q = Ideal.span {u} ∨ Q = IsLocalRing.maximalIdeal R'_Z := by
    intro u v h_max h_nondiv
    let I_u : Ideal R'_Z := Ideal.span {u}
    have hIu_ne_top : I_u ≠ ⊤ := by
      intro htop
      apply h_nondiv 0
      change v ^ 0 ∈ I_u
      rw [htop]
      trivial
    let S := R'_Z ⧸ I_u
    let π : R'_Z →+* S := Ideal.Quotient.mk I_u
    have hπ_surj : Function.Surjective π := Ideal.Quotient.mk_surjective
    have : Nontrivial S := Ideal.Quotient.nontrivial_iff.mpr hIu_ne_top
    have : IsLocalRing S := IsLocalRing.of_surjective' π hπ_surj
    have : IsNoetherianRing S := Ideal.Quotient.isNoetherianRing I_u
    let v_bar : S := π v
    let J_v : Ideal S := Ideal.span {v_bar}
    have hπ_u : π u = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton u))
    have hJv_ne_top : J_v ≠ ⊤ := by
      intro htop
      have h1 : (1 : S) ∈ J_v := by rw [htop]; trivial
      rcases Ideal.mem_span_singleton.mp h1 with ⟨w, hw⟩
      obtain ⟨r, rfl⟩ := hπ_surj w
      have hmem_u : 1 - v * r ∈ I_u := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        change π (1 - v * r) = 0
        rw [map_sub, map_one, map_mul]
        change 1 - v_bar * π r = 0
        rw [← hw, sub_self]
      rcases Ideal.mem_span_singleton.mp hmem_u with ⟨z, hz⟩
      have h1_max : (1 : R'_Z) ∈ IsLocalRing.maximalIdeal R'_Z := by
        rw [h_max, Ideal.mem_span_pair]
        refine ⟨z, r, ?_⟩
        linear_combination -hz
      exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) h1_max
    have h_unit_of_not_mem : ∀ w : S, w ∉ J_v → IsUnit w := by
      intro w hw_not
      obtain ⟨r, rfl⟩ := hπ_surj w
      have hr_not_max : r ∉ IsLocalRing.maximalIdeal R'_Z := by
        intro hr_max
        rw [h_max, Ideal.mem_span_pair] at hr_max
        rcases hr_max with ⟨a, b, hab⟩
        apply hw_not
        rw [Ideal.mem_span_singleton]
        refine ⟨π b, ?_⟩
        have hπr : π r = π (a * u + b * v) := congrArg π hab.symm
        rw [map_add, map_mul, map_mul, hπ_u, mul_zero, zero_add] at hπr
        exact hπr.trans (mul_comm (π b) v_bar)
      exact (IsLocalRing.notMem_maximalIdeal.mp hr_not_max).map π
    have h_krull : (⨅ n : ℕ, J_v ^ n) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing J_v hJv_ne_top
    have h_factor : ∀ x : S, x ≠ 0 → ∃ (a : ℕ) (w : S), IsUnit w ∧ x = v_bar ^ a * w := by
      intro x hx
      have hx_not_bot : x ∉ (⊥ : Ideal S) := by
        rwa [Ideal.mem_bot]
      rw [← h_krull, Ideal.mem_iInf] at hx_not_bot
      push Not at hx_not_bot
      classical
      let N : ℕ := Nat.find hx_not_bot
      have hN_spec : x ∉ J_v ^ N := Nat.find_spec hx_not_bot
      have hN_ne_zero : N ≠ 0 := by
        intro h0
        apply hN_spec
        rw [h0, pow_zero, Ideal.one_eq_top]
        trivial
      let a : ℕ := N - 1
      have hNa : N = a + 1 := (Nat.sub_add_cancel (Nat.pos_of_ne_zero hN_ne_zero)).symm
      have ha_lt : a < N := by omega
      have hxa : x ∈ J_v ^ a := by
        by_contra hnot
        exact Nat.find_min hx_not_bot ha_lt hnot
      rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hxa
      rcases hxa with ⟨w, hw_eq⟩
      have hw_not : w ∉ J_v := by
        intro hw_mem
        rcases Ideal.mem_span_singleton.mp hw_mem with ⟨z, rfl⟩
        apply hN_spec
        rw [hNa, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        refine ⟨z, ?_⟩
        rw [hw_eq, pow_succ]
        ring
      exact ⟨a, w, h_unit_of_not_mem w hw_not, hw_eq⟩
    have hS_noZeroDiv : NoZeroDivisors S := by
      refine ⟨fun {x y} hxy => ?_⟩
      by_contra h_both
      push Not at h_both
      rcases h_both with ⟨hx, hy⟩
      obtain ⟨a, w₁, hw₁, rfl⟩ := h_factor x hx
      obtain ⟨b, w₂, hw₂, rfl⟩ := h_factor y hy
      have hprod_eq : v_bar ^ (a + b) * (w₁ * w₂) = 0 := by
        calc v_bar ^ (a + b) * (w₁ * w₂)
          _ = (v_bar ^ a * w₁) * (v_bar ^ b * w₂) := by rw [pow_add]; ring
          _ = 0 := hxy
      have hw12 : IsUnit (w₁ * w₂) := hw₁.mul hw₂
      have hv_pow_zero : v_bar ^ (a + b) = 0 := by
        calc v_bar ^ (a + b)
          _ = v_bar ^ (a + b) * ((w₁ * w₂) * ↑(hw12.unit⁻¹)) := by
              rw [hw12.mul_val_inv, mul_one]
          _ = (v_bar ^ (a + b) * (w₁ * w₂)) * ↑(hw12.unit⁻¹) := by ring
          _ = 0 := by rw [hprod_eq, zero_mul]
      have hv_mem : v ^ (a + b) ∈ I_u := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        change π (v ^ (a + b)) = 0
        rw [map_pow]
        exact hv_pow_zero
      exact h_nondiv (a + b) hv_mem
    have : IsDomain S := NoZeroDivisors.to_isDomain S
    have hIu_prime : I_u.IsPrime := (Ideal.Quotient.isDomain_iff_prime I_u).mp inferInstance
    refine ⟨hIu_prime, ?_⟩
    intro Q hQ huQ
    have hIu_le_Q : I_u ≤ Q := by
      change Ideal.span {u} ≤ Q
      rw [Ideal.span_singleton_le_iff_mem]
      exact huQ
    by_cases hQ_le : Q ≤ I_u
    · exact Or.inl (le_antisymm hQ_le hIu_le_Q)
    · right
      have h_ex_q : ∃ q ∈ Q, q ∉ I_u := by
        by_contra h_all
        push Not at h_all
        exact hQ_le h_all
      rcases h_ex_q with ⟨q, hqQ, hq_not⟩
      have hπq_ne : π q ≠ 0 := by
        intro h0
        exact hq_not (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      obtain ⟨a, w, hw, hπq_eq⟩ := h_factor (π q) hπq_ne
      obtain ⟨z, hz⟩ := hπ_surj ↑(hw.unit⁻¹)
      have hdiff_mem : q * z - v ^ a ∈ I_u := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        change π (q * z - v ^ a) = 0
        rw [map_sub, map_mul, map_pow, hπq_eq, hz]
        change v_bar ^ a * w * ↑(hw.unit⁻¹) - v_bar ^ a = 0
        rw [mul_assoc, hw.mul_val_inv, mul_one, sub_self]
      have hva_Q : v ^ a ∈ Q := by
        have hqz_Q : q * z ∈ Q := Q.mul_mem_right z hqQ
        have hdiff_Q : q * z - v ^ a ∈ Q := hIu_le_Q hdiff_mem
        have heq : v ^ a = q * z - (q * z - v ^ a) := by ring
        rw [heq]
        exact Q.sub_mem hqz_Q hdiff_Q
      have hvQ : v ∈ Q := hQ.mem_of_pow_mem a hva_Q
      have hmax_le_Q : IsLocalRing.maximalIdeal R'_Z ≤ Q := by
        rw [h_max, Ideal.span_le]
        intro x hx
        rcases Set.mem_insert_iff.mp hx with rfl | hx'
        · exact huQ
        · rw [Set.mem_singleton_iff.mp hx']
          exact hvQ
      have hQ_le_max : Q ≤ IsLocalRing.maximalIdeal R'_Z :=
        IsLocalRing.le_maximalIdeal hQ.ne_top
      exact le_antisymm hQ_le_max hmax_le_Q

  have : p_z.IsPrime := Ideal.IsMaximal.isPrime inferInstance
  let R_Z := Localization.AtPrime p_z
  let ι : A_Z →+* R_Z := algebraMap A_Z R_Z
  let ι' : A_Z →+* R'_Z := φ_loc.comp ι

  have h_ff_pkg :
      Ideal.comap ι' (IsLocalRing.maximalIdeal R'_Z) = p_z ∧
      (∀ (P : Ideal A_Z) [P.IsPrime], P < p_z →
        ∃ Q : Ideal R'_Z, Q.IsPrime ∧ Ideal.comap ι' Q = P ∧ Q ≠ IsLocalRing.maximalIdeal R'_Z) ∧
      (∀ (J : Ideal A_Z) (x : A_Z), ι' x ∈ Ideal.map ι' J → ∃ d : A_Z, d ∉ p_z ∧ d * x ∈ J) := by
    let _ : Algebra R_Z R'_Z := φ_loc.toAlgebra
    have : IsLocalHom (algebraMap R_Z R'_Z) := ‹IsLocalHom φ_loc›
    have : Module.Flat R_Z R'_Z := hFlat
    have : Module.FaithfullyFlat R_Z R'_Z :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hcomap_φ_max :
        Ideal.comap φ_loc (IsLocalRing.maximalIdeal R'_Z) = IsLocalRing.maximalIdeal R_Z := by
      apply le_antisymm
      · apply IsLocalRing.le_maximalIdeal
        intro htop
        have h1 : (1 : R_Z) ∈ Ideal.comap φ_loc (IsLocalRing.maximalIdeal R'_Z) := by
          rw [htop]; trivial
        have h1' : (1 : R'_Z) ∈ IsLocalRing.maximalIdeal R'_Z := by
          rwa [Ideal.mem_comap, map_one] at h1
        exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) h1'
      · intro x hx
        change φ_loc x ∈ IsLocalRing.maximalIdeal R'_Z
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        have hx_u : IsUnit x := isUnit_of_map_unit φ_loc x hu
        exact (IsLocalRing.notMem_maximalIdeal.mpr hx_u) hx
    have hcomap_max : Ideal.comap ι' (IsLocalRing.maximalIdeal R'_Z) = p_z := by
      change Ideal.comap (φ_loc.comp ι) (IsLocalRing.maximalIdeal R'_Z) = p_z
      rw [← Ideal.comap_comap, hcomap_φ_max]
      exact IsLocalization.AtPrime.under_maximalIdeal R_Z p_z
    refine ⟨hcomap_max, ?_, ?_⟩
    · intro P _ hP_lt
      have hdisj : Disjoint (p_z.primeCompl : Set A_Z) (P : Set A_Z) := by
        rw [Set.disjoint_left]
        intro s hs hsP
        exact hs (hP_lt.le hsP)
      let P_loc : Ideal R_Z := Ideal.map ι P
      have hPloc_prime : P_loc.IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint p_z.primeCompl R_Z P inferInstance hdisj
      have hPloc_under : Ideal.comap ι P_loc = P :=
        IsLocalization.under_map_of_isPrime_disjoint p_z.primeCompl R_Z inferInstance hdisj
      obtain ⟨⟨Q, hQ_prime⟩, hQ_eq⟩ :=
        PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := R_Z) (B := R'_Z) ⟨P_loc, hPloc_prime⟩
      have hQ_comap_φ : Ideal.comap φ_loc Q = P_loc :=
        congrArg PrimeSpectrum.asIdeal hQ_eq
      have hQ_comap : Ideal.comap ι' Q = P := by
        change Ideal.comap (φ_loc.comp ι) Q = P
        rw [← Ideal.comap_comap, hQ_comap_φ, hPloc_under]
      have hQ_ne_max : Q ≠ IsLocalRing.maximalIdeal R'_Z := by
        intro hEq
        rw [hEq, hcomap_max] at hQ_comap
        exact hP_lt.ne hQ_comap.symm
      exact ⟨Q, hQ_prime, hQ_comap, hQ_ne_max⟩
    · intro J x hx
      have hx_map : φ_loc (ι x) ∈ Ideal.map φ_loc (Ideal.map ι J) := by
        rw [Ideal.map_map]
        exact hx
      have hx_comap : ι x ∈ Ideal.comap φ_loc (Ideal.map φ_loc (Ideal.map ι J)) := hx_map
      have hff_eq :
          Ideal.comap φ_loc (Ideal.map φ_loc (Ideal.map ι J)) = Ideal.map ι J :=
        Ideal.comap_map_eq_self_of_faithfullyFlat (Ideal.map ι J)
      have hx_loc : ι x ∈ Ideal.map ι J := by
        rwa [hff_eq] at hx_comap
      rcases (IsLocalization.algebraMap_mem_map_algebraMap_iff p_z.primeCompl R_Z J x).mp hx_loc with
        ⟨d, hd, hdx⟩
      exact ⟨d, hd, hdx⟩

  have h_domain_cancel :
      ∀ (w₁ w₂ u' s' g' c' t' : R'_Z) (j : ℕ),
        (Ideal.span {w₁}).IsPrime →
        w₁ ≠ 0 →
        s' ∉ Ideal.span {w₁} →
        IsUnit u' →
        t' ∈ Ideal.span {w₁, w₂} →
        s' * g' = (u' * (w₁ * w₂)) ^ j * c' →
        t' ^ j * c' ∈ Ideal.span {w₁} ⊔ Ideal.span {s'} := by
    intro w₁ w₂ u' s' g' c' t' j hw₁_prime hw₁_ne hs' hu' ht' heq
    have h_cancel : ∀ (k : ℕ) (y z : R'_Z), s' * y = w₁ ^ k * z → ∃ h' : R'_Z, s' * h' = z := by
      intro k
      induction k with
      | zero =>
        intro y z hyz
        rw [pow_zero, one_mul] at hyz
        exact ⟨y, hyz⟩
      | succ m ih =>
        intro y z hyz
        have hmem : s' * y ∈ Ideal.span {w₁} := by
          rw [Ideal.mem_span_singleton]
          refine ⟨w₁ ^ m * z, ?_⟩
          rw [hyz, pow_succ']
          ring
        have hy_mem : y ∈ Ideal.span {w₁} :=
          (hw₁_prime.mem_or_mem hmem).resolve_left hs'
        rcases Ideal.mem_span_singleton.mp hy_mem with ⟨y₁, rfl⟩
        have hmul : w₁ * (s' * y₁) = w₁ * (w₁ ^ m * z) := by
          calc w₁ * (s' * y₁)
            _ = s' * (w₁ * y₁) := by ring
            _ = w₁ ^ (m + 1) * z := hyz
            _ = w₁ * (w₁ ^ m * z) := by rw [pow_succ']; ring
        exact ih y₁ z (mul_left_cancel₀ hw₁_ne hmul)
    have heq_rearr : s' * g' = w₁ ^ j * ((u' * w₂) ^ j * c') := by
      rw [heq]
      ring
    obtain ⟨h', hh'⟩ := h_cancel j g' ((u' * w₂) ^ j * c') heq_rearr
    let u_inv : R'_Z := ↑(hu'.unit⁻¹)
    have hu_inv : u_inv * u' = 1 := hu'.val_inv_mul
    have hw2_c : w₂ ^ j * c' = s' * (u_inv ^ j * h') := by
      calc w₂ ^ j * c'
        _ = (u_inv * u') ^ j * w₂ ^ j * c' := by rw [hu_inv, one_pow, one_mul]
        _ = u_inv ^ j * ((u' * w₂) ^ j * c') := by ring
        _ = u_inv ^ j * (s' * h') := by rw [hh']
        _ = s' * (u_inv ^ j * h') := by ring
    rcases Ideal.mem_span_pair.mp ht' with ⟨α₁, α₂, hα⟩
    have hsub_eq : t' - α₂ * w₂ = α₁ * w₁ := by
      linear_combination -hα
    rcases sub_dvd_pow_sub_pow t' (α₂ * w₂) j with ⟨γ, hγ⟩
    have hdecomp :
        t' ^ j * c' = w₁ * (α₁ * γ * c') + s' * (α₂ ^ j * (u_inv ^ j * h')) := by
      have htj : t' ^ j = (α₁ * w₁) * γ + α₂ ^ j * w₂ ^ j := by
        have h1 : t' ^ j - (α₂ * w₂) ^ j = (α₁ * w₁) * γ := by
          rw [← hsub_eq]
          exact hγ
        calc t' ^ j
          _ = (t' ^ j - (α₂ * w₂) ^ j) + (α₂ * w₂) ^ j := by ring
          _ = (α₁ * w₁) * γ + α₂ ^ j * w₂ ^ j := by rw [h1]; ring
      calc t' ^ j * c'
        _ = ((α₁ * w₁) * γ + α₂ ^ j * w₂ ^ j) * c' := by rw [htj]
        _ = w₁ * (α₁ * γ * c') + α₂ ^ j * (w₂ ^ j * c') := by ring
        _ = w₁ * (α₁ * γ * c') + α₂ ^ j * (s' * (u_inv ^ j * h')) := by rw [hw2_c]
        _ = w₁ * (α₁ * γ * c') + s' * (α₂ ^ j * (u_inv ^ j * h')) := by ring
    rw [hdecomp]
    exact Ideal.add_mem _
      (Ideal.mem_sup_left (Ideal.mem_span_singleton.mpr ⟨α₁ * γ * c', rfl⟩))
      (Ideal.mem_sup_right (Ideal.mem_span_singleton.mpr ⟨α₂ ^ j * (u_inv ^ j * h'), rfl⟩))

  obtain ⟨hu_prime, hu_dich⟩ := h_prime_dich u_tilde v_tilde h_max_span h_nondiv_u
  have h_max_span_symm : IsLocalRing.maximalIdeal R'_Z = Ideal.span {v_tilde, u_tilde} := by
    rw [h_max_span, Set.pair_comm]
  obtain ⟨hv_prime, hv_dich⟩ := h_prime_dich v_tilde u_tilde h_max_span_symm h_nondiv_v
  have huv_dich : ∀ Q : Ideal R'_Z, Q.IsPrime → u_tilde * v_tilde ∈ Q →
      Q = Ideal.span {u_tilde} ∨ Q = Ideal.span {v_tilde} ∨
        Q = IsLocalRing.maximalIdeal R'_Z := by
    intro Q hQ huv
    rcases hQ.mem_or_mem huv with hu | hv
    · rcases hu_dich Q hQ hu with h1 | h2
      · exact Or.inl h1
      · exact Or.inr (Or.inr h2)
    · rcases hv_dich Q hQ hv with h1 | h2
      · exact Or.inr (Or.inl h1)
      · exact Or.inr (Or.inr h2)
  obtain ⟨hcomap_max, hlift_prime, hdescent⟩ := h_ff_pkg
  have h_branch_comap : ∀ (P : Ideal A_Z) [P.IsPrime], P < p_z → ℓ ∈ P →
      P = Ideal.comap ι' (Ideal.span {u_tilde}) ∨
        P = Ideal.comap ι' (Ideal.span {v_tilde}) := by
    intro P _ hP_lt hℓ_P
    obtain ⟨Q, hQ_prime, hQ_comap, hQ_ne_max⟩ := hlift_prime P hP_lt
    have huv_Q : u_tilde * v_tilde ∈ Q := by
      rw [← h_prod]
      have hmem : ℓ ∈ Ideal.comap ι' Q := by rwa [hQ_comap]
      exact hmem
    rcases huv_dich Q hQ_prime huv_Q with rfl | rfl | hmax
    · exact Or.inl hQ_comap.symm
    · exact Or.inr hQ_comap.symm
    · exact absurd hmax hQ_ne_max
  refine ⟨?_, ?_⟩
  · rintro ⟨P₁, P₂, P₃, hP₁, hP₂, hP₃, h12, h13, h23, hlt1, hlt2, hlt3, hℓ1, hℓ2, hℓ3⟩
    have hb1 := @h_branch_comap P₁ hP₁ hlt1 hℓ1
    have hb2 := @h_branch_comap P₂ hP₂ hlt2 hℓ2
    have hb3 := @h_branch_comap P₃ hP₃ hlt3 hℓ3
    rcases hb1 with h1 | h1 <;> rcases hb2 with h2 | h2 <;> rcases hb3 with h3 | h3
    · exact h12 (h1.trans h2.symm)
    · exact h12 (h1.trans h2.symm)
    · exact h13 (h1.trans h3.symm)
    · exact h23 (h2.trans h3.symm)
    · exact h23 (h2.trans h3.symm)
    · exact h13 (h1.trans h3.symm)
    · exact h12 (h1.trans h2.symm)
    · exact h12 (h1.trans h2.symm)
  · intro P₁ P₂ _ _ hP₁_lt hP₂_lt hnot12 _ hℓ1 hℓ2 u_unit s g c t_diff j hu_unit hs_not ht_diff heq_loc
    have h_pole_branch :
        ∀ (w₁ w₂ : R'_Z),
          ι' ℓ = w₁ * w₂ →
          (Ideal.span {w₁}).IsPrime →
          IsLocalRing.maximalIdeal R'_Z = Ideal.span {w₁, w₂} →
          (∀ n : ℕ, w₁ ^ n ∉ Ideal.span {w₂}) →
          (∀ Q : Ideal R'_Z, Q.IsPrime → w₁ * w₂ ∈ Q →
            Q = Ideal.span {w₁} ∨ Q = Ideal.span {w₂} ∨ Q = IsLocalRing.maximalIdeal R'_Z) →
          P₁ = Ideal.comap ι' (Ideal.span {w₁}) →
          P₂ = Ideal.comap ι' (Ideal.span {w₂}) →
          ∃ (d r : A_Z), d ∉ p_z ∧ d * t_diff ^ j * c - s * r ∈ P₁ := by
      intro w₁ w₂ hw_prod hw₁_prime hw_max hw_nondiv₂ hw_dich hP₁_eq hP₂_eq
      have hmap_P₁ : Ideal.map ι' P₁ = Ideal.span {w₁} := by
        apply le_antisymm
        · exact Ideal.map_le_iff_le_comap.mpr hP₁_eq.le
        · rw [Ideal.span_singleton_le_iff_mem]
          have hrad : (Ideal.map ι' P₁).IsRadical :=
            (Ideal.isRadical_iff_quotient_reduced (Ideal.map ι' P₁)).mpr (h_red P₁ hP₁_lt)
          rw [← hrad.radical, Ideal.radical_eq_sInf, Ideal.mem_sInf]
          rintro Q ⟨hQ_le, hQ_prime⟩
          have hw12_Q : w₁ * w₂ ∈ Q := by
            rw [← hw_prod]
            exact hQ_le (Ideal.mem_map_of_mem ι' hℓ1)
          rcases hw_dich Q hQ_prime hw12_Q with rfl | rfl | rfl
          · exact Ideal.subset_span (Set.mem_singleton w₁)
          · exfalso
            apply hnot12
            rw [hP₂_eq]
            exact Ideal.map_le_iff_le_comap.mp hQ_le
          · rw [hw_max]
            exact Ideal.subset_span (Set.mem_insert w₁ {w₂})
      have hw₁_ne : w₁ ≠ 0 := by
        intro h0
        apply hw_nondiv₂ 1
        rw [h0, pow_one]
        exact Ideal.zero_mem _
      have hs' : ι' s ∉ Ideal.span {w₁} := by
        intro hmem
        apply hs_not
        rw [hP₁_eq]
        exact hmem
      have hu' : IsUnit (ι' u_unit) :=
        (IsLocalization.map_units R_Z (⟨u_unit, hu_unit⟩ : p_z.primeCompl)).map φ_loc
      have ht' : ι' t_diff ∈ Ideal.span {w₁, w₂} := by
        rw [← hw_max]
        have hmem : t_diff ∈ Ideal.comap ι' (IsLocalRing.maximalIdeal R'_Z) := by
          rwa [hcomap_max]
        exact hmem
      have heq' : ι' s * ι' g = (ι' u_unit * (w₁ * w₂)) ^ j * ι' c := by
        have hφ := congrArg φ_loc heq_loc
        change φ_loc (ι (s * g)) = φ_loc ((ι (u_unit * ℓ)) ^ j * ι c) at hφ
        simp only [map_mul, map_pow] at hφ
        change ι' s * ι' g = (ι' u_unit * ι' ℓ) ^ j * ι' c at hφ
        rwa [hw_prod] at hφ
      have hmem_sup : (ι' t_diff) ^ j * ι' c ∈ Ideal.span {w₁} ⊔ Ideal.span {ι' s} :=
        h_domain_cancel w₁ w₂ (ι' u_unit) (ι' s) (ι' g) (ι' c)
          (ι' t_diff) j hw₁_prime hw₁_ne hs' hu' ht' heq'
      have hmap_sup :
          Ideal.map ι' (P₁ ⊔ Ideal.span {s}) = Ideal.span {w₁} ⊔ Ideal.span {ι' s} := by
        rw [Ideal.map_sup, hmap_P₁, Ideal.map_span, Set.image_singleton]
      have hmem_map : ι' (t_diff ^ j * c) ∈ Ideal.map ι' (P₁ ⊔ Ideal.span {s}) := by
        rw [hmap_sup, map_mul, map_pow]
        exact hmem_sup
      obtain ⟨d, hd, hdx⟩ := hdescent (P₁ ⊔ Ideal.span {s}) (t_diff ^ j * c) hmem_map
      rcases Submodule.mem_sup.mp hdx with ⟨p, hp, q, hq, hpq⟩
      rcases Ideal.mem_span_singleton.mp hq with ⟨r, rfl⟩
      refine ⟨d, r, hd, ?_⟩
      have heq_sub : d * t_diff ^ j * c - s * r = p := by
        calc d * t_diff ^ j * c - s * r
          _ = d * (t_diff ^ j * c) - s * r := by ring
          _ = (p + s * r) - s * r := by rw [← hpq]
          _ = p := add_sub_cancel_right p (s * r)
      rwa [heq_sub]
    rcases h_branch_comap P₁ hP₁_lt hℓ1 with hP₁_u | hP₁_v <;>
      rcases h_branch_comap P₂ hP₂_lt hℓ2 with hP₂_u | hP₂_v
    · exfalso
      apply hnot12
      rw [hP₁_u, hP₂_u]
    · exact h_pole_branch u_tilde v_tilde h_prod hu_prime h_max_span h_nondiv_v huv_dich
        hP₁_u hP₂_v
    · have hw_prod_vu : ι' ℓ = v_tilde * u_tilde := by
        change φ_loc (ι ℓ) = v_tilde * u_tilde
        rw [h_prod, mul_comm]
      have hvu_dich : ∀ Q : Ideal R'_Z, Q.IsPrime → v_tilde * u_tilde ∈ Q →
          Q = Ideal.span {v_tilde} ∨ Q = Ideal.span {u_tilde} ∨
            Q = IsLocalRing.maximalIdeal R'_Z := by
        intro Q hQ hvu
        rw [mul_comm] at hvu
        rcases huv_dich Q hQ hvu with h1 | h2 | h3
        · exact Or.inr (Or.inl h1)
        · exact Or.inl h2
        · exact Or.inr (Or.inr h3)
      exact h_pole_branch v_tilde u_tilde hw_prod_vu hv_prime h_max_span_symm h_nondiv_u
        hvu_dich hP₁_v hP₂_u
    · exfalso
      apply hnot12
      rw [hP₁_v, hP₂_v]

theorem weil_algClosed_ring_nodal_roof_split_and_dvr (k : Type u) [Field k] [IsAlgClosed k] :
    (∀ (B : Type u) [CommRing B] (ψ : Polynomial k →+* B),
      ψ.Etale →
      ∀ (q : Ideal B) [q.IsPrime],
        IsDomain (Localization.AtPrime q)) ∧
    (∀ (A_Z : Type u) [CommRing A_Z]
        (ψ_Z : MvPolynomial (Fin 2) k →+* A_Z),
      ψ_Z.Etale →
      ∀ (p_z : Ideal A_Z) [p_z.IsMaximal],
        (∀ i : Fin 2, ψ_Z (MvPolynomial.X i) ∈ p_z) →
        ∀ (ℓ : A_Z), ℓ ∈ p_z →
        ∀ (B' : Type u) [CommRing B']
          (q_v : Ideal B') [q_v.IsPrime]
          (φ₁ : (A_Z ⧸ Ideal.span {ℓ}) →+* B')
          (φ₂ : (MvPolynomial (Fin 2) k ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B'),
          φ₁.Etale →
          φ₂.Etale →
          Ideal.comap φ₁ q_v = Ideal.map (Ideal.Quotient.mk (Ideal.span {ℓ})) p_z →
          (∀ b : Fin 2,
            φ₂ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})
              (MvPolynomial.X b)) ∈ q_v) →
          φ₁.comp ((Ideal.Quotient.mk (Ideal.span {ℓ})).comp (ψ_Z.comp MvPolynomial.C)) =
            φ₂.comp ((Ideal.Quotient.mk
              (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})).comp MvPolynomial.C) →
          (ℓ ≠ 0 ∧
            ¬ ∃ (P₁ P₂ P₃ : Ideal A_Z),
              P₁.IsPrime ∧ P₂.IsPrime ∧ P₃.IsPrime ∧
              P₁ ≠ P₂ ∧ P₁ ≠ P₃ ∧ P₂ ≠ P₃ ∧
              P₁ < p_z ∧ P₂ < p_z ∧ P₃ < p_z ∧
              ℓ ∈ P₁ ∧ ℓ ∈ P₂ ∧ ℓ ∈ P₃) ∧
          (∀ (P₁ P₂ : Ideal A_Z) [P₁.IsPrime] [P₂.IsPrime],
            P₁ < p_z → P₂ < p_z → ¬(P₁ ≤ P₂) → ¬(P₂ ≤ P₁) →
            ℓ ∈ P₁ → ℓ ∈ P₂ →
            ∀ (u_unit s g c t_diff : A_Z) (j : ℕ),
              u_unit ∉ p_z →
              s ∉ P₁ →
              t_diff ∈ p_z →
              algebraMap A_Z (Localization.AtPrime p_z) (s * g) =
                (algebraMap A_Z (Localization.AtPrime p_z) (u_unit * ℓ)) ^ j *
                  algebraMap A_Z (Localization.AtPrime p_z) c →
              ∃ (d r : A_Z), d ∉ p_z ∧ d * t_diff ^ j * c - s * r ∈ P₁)) :=
by
  have hDomAtPrime : ∀ (C : Type u) [CommRing C] (q : Ideal C) [q.IsPrime]
      (f : C), f ∉ q → IsDomain (Localization.Away f) → IsDomain (Localization.AtPrime q) := by
    intro C _ q _ f hf hDom
    have : IsDomain (Localization.Away f) := hDom
    let D := Localization.Away f
    let K := FractionRing D
    let φ : C →+* K := (algebraMap D K).comp (algebraMap C D)
    have hφ_units : ∀ s : q.primeCompl, IsUnit (φ s.1) := by
      intro s
      apply Ne.isUnit
      intro h0
      have hD0 : algebraMap C D s.1 = 0 :=
        (IsFractionRing.injective D K) (h0.trans (map_zero _).symm)
      obtain ⟨⟨m, n, rfl⟩, hmul⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers f) D s.1).mp hD0
      have hmem : f ^ n * s.1 ∈ q := by
        rw [hmul]
        exact q.zero_mem
      rcases Ideal.IsPrime.mem_or_mem inferInstance hmem with hfn | hs
      · exact hf (Ideal.IsPrime.mem_of_pow_mem inferInstance n hfn)
      · exact s.2 hs
    let Φ : Localization.AtPrime q →+* K := IsLocalization.lift hφ_units
    have hΦ_inj : Function.Injective Φ := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj q.primeCompl x
      have hΦb : Φ (algebraMap C (Localization.AtPrime q) b) = 0 := by
        rw [← hbs, map_mul, hx, zero_mul]
      rw [IsLocalization.lift_eq] at hΦb
      have hDb : algebraMap C D b = 0 :=
        (IsFractionRing.injective D K) (hΦb.trans (map_zero _).symm)
      obtain ⟨⟨m, n, rfl⟩, hmul⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers f) D b).mp hDb
      have hfn_not_q : f ^ n ∉ q := fun h => hf (Ideal.IsPrime.mem_of_pow_mem inferInstance n h)
      have hfn_unit : IsUnit (algebraMap C (Localization.AtPrime q) (f ^ n)) :=
        IsLocalization.map_units (Localization.AtPrime q) (⟨f ^ n, hfn_not_q⟩ : q.primeCompl)
      have hb0 : algebraMap C (Localization.AtPrime q) b = 0 := by
        have hprod0 : algebraMap C (Localization.AtPrime q) (f ^ n) *
            algebraMap C (Localization.AtPrime q) b = 0 := by
          rw [← map_mul, hmul, map_zero]
        exact (hfn_unit.mul_right_eq_zero).mp hprod0
      rw [hb0] at hbs
      have hs_unit : IsUnit (algebraMap C (Localization.AtPrime q) s.1) :=
        IsLocalization.map_units (Localization.AtPrime q) s
      exact (hs_unit.mul_left_eq_zero).mp hbs
    exact Function.Injective.isDomain Φ hΦ_inj

  refine ⟨?_, ?_⟩
  · intro B _ ψ hψ q _
    let _ : Algebra (Polynomial k) B := ψ.toAlgebra
    have : Algebra.Etale (Polynomial k) B := hψ.toAlgebra
    obtain ⟨f, hf, hDom⟩ :=
      weil_integrallyClosed_noetherian_etale_away_isDomain (Polynomial k) B q
    exact hDomAtPrime B q f hf hDom

  · obtain ⟨hEtE1, hEtE2, hEtE3, hEtE4⟩ :=
      weil_algClosed_etale_aug_and_trunc_local_equiv k
    obtain ⟨hMvM1, hMvM2, hMvM3⟩ :=
      weil_mvPoly_fin2_nodal_threeJet_and_branch_nondiv k
    let P_2 := MvPolynomial (Fin 2) k
    let m_0 : Ideal P_2 := Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1}
    let I_node : Ideal P_2 := Ideal.span {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1}
    let R_node := P_2 ⧸ I_node
    let ε_0 : P_2 →ₐ[k] k := MvPolynomial.aeval 0
    let p_0 : Ideal P_2 := RingHom.ker ε_0.toRingHom

    have hε0_C : ∀ c : k, ε_0 (MvPolynomial.C c) = c := fun c =>
      MvPolynomial.aeval_C (0 : Fin 2 → k) c
    have hε0_X : ∀ i : Fin 2, ε_0 (MvPolynomial.X i) = 0 := fun i =>
      MvPolynomial.aeval_X (0 : Fin 2 → k) i

    have hε0_surj : Function.Surjective ε_0.toRingHom := fun c =>
      ⟨MvPolynomial.C c, hε0_C c⟩
    have hp0_max : p_0.IsMaximal := RingHom.ker_isMaximal_of_surjective _ hε0_surj
    have hp0_prime : p_0.IsPrime := hp0_max.isPrime

    have hm0_le_p0 : m_0 ≤ p_0 := by
      rw [Ideal.span_le]
      intro g hg
      rcases Set.mem_insert_iff.mp hg with rfl | hg1
      · exact hε0_X 0
      · rw [Set.mem_singleton_iff.mp hg1]
        exact hε0_X 1

    have hp0_eq_m0 : p_0 = m_0 := by
      apply le_antisymm
      · intro f hf
        have hf0 : ε_0 f = 0 := hf
        have hsplit : f = MvPolynomial.C (f.coeff 0) +
            ∑ d ∈ f.support.erase 0, MvPolynomial.monomial d (f.coeff d) := by
          conv_lhs => rw [f.as_sum]
          by_cases h0 : (0 : Fin 2 →₀ ℕ) ∈ f.support
          · rw [← Finset.add_sum_erase _ _ h0, MvPolynomial.monomial_zero']
          · rw [Finset.erase_eq_of_notMem h0, MvPolynomial.notMem_support_iff.mp h0,
              map_zero, zero_add]
        have hsum_m0 : (∑ d ∈ f.support.erase 0,
            MvPolynomial.monomial d (f.coeff d)) ∈ m_0 := by
          refine Ideal.sum_mem _ fun d hd => ?_
          have hd_ne : d ≠ 0 := (Finset.mem_erase.mp hd).1
          have hex : ∃ i : Fin 2, 1 ≤ d i := by
            by_contra hall
            apply hd_ne
            ext i
            exact Nat.eq_zero_of_not_pos fun hpos => hall ⟨i, hpos⟩
          obtain ⟨i, hi⟩ := hex
          have hXi_mem : (MvPolynomial.X i : P_2) ∈ m_0 := by
            fin_cases i
            · exact Ideal.subset_span (Set.mem_insert _ _)
            · exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
          have hmon_eq : MvPolynomial.monomial d (f.coeff d) =
              MvPolynomial.X i * MvPolynomial.monomial (d - Finsupp.single i 1) (f.coeff d) := by
            rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, one_mul, add_tsub_cancel_of_le]
            intro j
            by_cases hj : j = i
            · subst hj; simp; omega
            · simp [hj]
          rw [hmon_eq]
          exact m_0.mul_mem_right _ hXi_mem
        have hsum_0 : ε_0 (∑ d ∈ f.support.erase 0,
            MvPolynomial.monomial d (f.coeff d)) = 0 := hm0_le_p0 hsum_m0
        have hc0 : f.coeff 0 = 0 := by
          have h1 := congrArg ε_0 hsplit
          rw [hf0, map_add, hsum_0, add_zero, hε0_C] at h1
          exact h1.symm
        rw [hsplit, hc0, map_zero, zero_add]
        exact hsum_m0
      · exact hm0_le_p0

    have hQuotSupEquiv : ∀ {A₁ A₂ : Type u} [CommRing A₁] [Algebra k A₁]
        [CommRing A₂] [Algebra k A₂]
        (I₁ M₁ : Ideal A₁) (I₂ M₂ : Ideal A₂)
        (E : (A₁ ⧸ M₁) ≃ₐ[k] (A₂ ⧸ M₂)),
        Ideal.map (Ideal.Quotient.mk M₂) I₂ =
          Ideal.map E.toRingHom (Ideal.map (Ideal.Quotient.mk M₁) I₁) →
        Nonempty ((A₁ ⧸ (I₁ ⊔ M₁)) ≃ₐ[k] (A₂ ⧸ (I₂ ⊔ M₂))) := by
      intro A₁ A₂ _ _ _ _ I₁ M₁ I₂ M₂ E hmap
      have e1 : (A₁ ⧸ (I₁ ⊔ M₁)) ≃ₐ[k] (A₁ ⧸ (M₁ ⊔ I₁)) :=
        Ideal.quotientEquivAlgOfEq k (sup_comm I₁ M₁)
      have e2 : (A₁ ⧸ (M₁ ⊔ I₁)) ≃ₐ[k]
          ((A₁ ⧸ M₁) ⧸ Ideal.map (Ideal.Quotient.mkₐ k M₁) I₁) :=
        (DoubleQuot.quotQuotEquivQuotSupₐ k M₁ I₁).symm
      have hmap' : Ideal.map (Ideal.Quotient.mkₐ k M₂) I₂ =
          Ideal.map (↑E) (Ideal.map (Ideal.Quotient.mkₐ k M₁) I₁) := hmap
      have e3 : ((A₁ ⧸ M₁) ⧸ Ideal.map (Ideal.Quotient.mkₐ k M₁) I₁) ≃ₐ[k]
          ((A₂ ⧸ M₂) ⧸ Ideal.map (Ideal.Quotient.mkₐ k M₂) I₂) :=
        Ideal.quotientEquivAlg _ _ E hmap'
      have e4 : ((A₂ ⧸ M₂) ⧸ Ideal.map (Ideal.Quotient.mkₐ k M₂) I₂) ≃ₐ[k]
          (A₂ ⧸ (M₂ ⊔ I₂)) :=
        DoubleQuot.quotQuotEquivQuotSupₐ k M₂ I₂
      have e5 : (A₂ ⧸ (M₂ ⊔ I₂)) ≃ₐ[k] (A₂ ⧸ (I₂ ⊔ M₂)) :=
        Ideal.quotientEquivAlgOfEq k (sup_comm M₂ I₂)
      exact ⟨(((e1.trans e2).trans e3).trans e4).trans e5⟩

    intro A_Z _ ψ_Z hψ_Z p_z hpz_max hp_center ℓ hℓ_pz B' _ q_v hqv_prime
      φ₁ φ₂ hφ₁ hφ₂ hq_comap hq_center h_k_comm
    have : p_z.IsPrime := hpz_max.isPrime

    let I_ℓ : Ideal A_Z := Ideal.span {ℓ}
    let C_ℓ := A_Z ⧸ I_ℓ
    let _ : Algebra k A_Z := (ψ_Z.comp MvPolynomial.C).toAlgebra
    let _ : Algebra k B' :=
      (φ₂.comp ((Ideal.Quotient.mk I_node).comp MvPolynomial.C)).toAlgebra

    let ψ_Z_alg : P_2 →ₐ[k] A_Z :=
      { ψ_Z with commutes' := fun _ => rfl }
    let φ₂_alg : R_node →ₐ[k] B' :=
      { φ₂ with commutes' := fun _ => rfl }
    let φ₁_alg : C_ℓ →ₐ[k] B' :=
      { φ₁ with
        commutes' := fun c => RingHom.congr_fun h_k_comm c }

    
    have hp0_le_pz : RingHom.ker ε_0.toRingHom ≤ Ideal.comap ψ_Z_alg.toRingHom p_z := by
      change p_0 ≤ Ideal.comap ψ_Z p_z
      rw [hp0_eq_m0, Ideal.span_le]
      intro g hg
      rcases Set.mem_insert_iff.mp hg with rfl | hg1
      · exact hp_center 0
      · rw [Set.mem_singleton_iff.mp hg1]
        exact hp_center 1
    obtain ⟨ε_Z, hker_εZ, hεZ_comp, _⟩ :=
      hEtE1 P_2 A_Z ψ_Z_alg hψ_Z ε_0 p_z hp0_le_pz
    have hp0_comap_pz : p_0 = Ideal.comap ψ_Z_alg.toRingHom p_z := by
      rw [← hker_εZ]
      change RingHom.ker ε_0.toRingHom = RingHom.ker (ε_Z.comp ψ_Z_alg).toRingHom
      rw [hεZ_comp]

    
    have hInode_le_p0 : I_node ≤ p_0 := by
      rw [hp0_eq_m0, Ideal.span_le, Set.singleton_subset_iff]
      exact m_0.mul_mem_right (MvPolynomial.X 1) (Ideal.subset_span (Set.mem_insert _ _))
    let ε_node : R_node →ₐ[k] k :=
      Ideal.Quotient.liftₐ I_node ε_0 fun x hx => hInode_le_p0 hx
    let m_node : Ideal R_node := RingHom.ker ε_node.toRingHom
    have hεnode_surj : Function.Surjective ε_node.toRingHom := fun c =>
      ⟨algebraMap k R_node c, ε_node.commutes c⟩
    have hmnode_max : m_node.IsMaximal := RingHom.ker_isMaximal_of_surjective _ hεnode_surj
    have hmnode_prime : m_node.IsPrime := hmnode_max.isPrime
    have hmnode_comap : Ideal.comap (Ideal.Quotient.mk I_node) m_node = p_0 := by
      ext f
      rfl
    have hmnode_le_qv : RingHom.ker ε_node.toRingHom ≤ Ideal.comap φ₂_alg.toRingHom q_v := by
      intro x hx
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
      have hf_m0 : f ∈ m_0 := by
        rw [← hp0_eq_m0, ← hmnode_comap]
        exact hx
      have hm0_le : m_0 ≤ Ideal.comap (φ₂.comp (Ideal.Quotient.mk I_node)) q_v := by
        rw [Ideal.span_le]
        intro g hg
        rcases Set.mem_insert_iff.mp hg with rfl | hg1
        · exact hq_center 0
        · rw [Set.mem_singleton_iff.mp hg1]
          exact hq_center 1
      exact hm0_le hf_m0
    obtain ⟨ε_B, hker_εB, hεB_comp_φ₂, _⟩ :=
      hEtE1 R_node B' φ₂_alg hφ₂ ε_node q_v hmnode_le_qv
    have hmnode_comap_qv : m_node = Ideal.comap φ₂_alg.toRingHom q_v := by
      rw [← hker_εB]
      change RingHom.ker ε_node.toRingHom = RingHom.ker (ε_B.comp φ₂_alg).toRingHom
      rw [hεB_comp_φ₂]

    
    have hIℓ_le_pz : I_ℓ ≤ p_z := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      exact hℓ_pz
    let ε_C : C_ℓ →ₐ[k] k :=
      Ideal.Quotient.liftₐ I_ℓ ε_Z fun x hx => by
        have hx' : x ∈ RingHom.ker ε_Z.toRingHom := by
          rw [hker_εZ]
          exact hIℓ_le_pz hx
        exact hx'
    let p_bar_z : Ideal C_ℓ := Ideal.map (Ideal.Quotient.mk I_ℓ) p_z
    have hpbar_comap : Ideal.comap (Ideal.Quotient.mk I_ℓ) p_bar_z = p_z := by
      rw [Ideal.comap_map_of_surjective (Ideal.Quotient.mk I_ℓ) Ideal.Quotient.mk_surjective]
      have hker_Iℓ : Ideal.comap (Ideal.Quotient.mk I_ℓ) ⊥ = I_ℓ := Ideal.mk_ker
      rw [hker_Iℓ]
      exact sup_eq_left.mpr hIℓ_le_pz
    have hker_εC : RingHom.ker ε_C.toRingHom = p_bar_z := by
      ext y
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
      change ε_Z a = 0 ↔ Ideal.Quotient.mk I_ℓ a ∈ p_bar_z
      have h1 : ε_Z a = 0 ↔ a ∈ p_z := by
        rw [← hker_εZ]
        rfl
      have h2 : Ideal.Quotient.mk I_ℓ a ∈ p_bar_z ↔ a ∈ p_z := by
        rw [← Ideal.mem_comap, hpbar_comap]
      exact h1.trans h2.symm
    have hεC_surj : Function.Surjective ε_C.toRingHom := fun c =>
      ⟨algebraMap k C_ℓ c, ε_C.commutes c⟩
    have hpbar_max : p_bar_z.IsMaximal := by
      rw [← hker_εC]
      exact RingHom.ker_isMaximal_of_surjective _ hεC_surj
    have hpbar_prime : p_bar_z.IsPrime := hpbar_max.isPrime
    have hpbar_comap_qv : p_bar_z = Ideal.comap φ₁_alg.toRingHom q_v := hq_comap.symm
    have hεB_comp_φ₁ : ε_B.comp φ₁_alg = ε_C := by
      ext y
      have hmem : y - algebraMap k C_ℓ (ε_C y) ∈ RingHom.ker (ε_B.comp φ₁_alg).toRingHom := by
        change φ₁ (y - algebraMap k C_ℓ (ε_C y)) ∈ RingHom.ker ε_B.toRingHom
        rw [hker_εB, ← Ideal.mem_comap, hq_comap]
        change y - algebraMap k C_ℓ (ε_C y) ∈ p_bar_z
        rw [← hker_εC]
        change ε_C (y - algebraMap k C_ℓ (ε_C y)) = 0
        rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
      have h0 : (ε_B.comp φ₁_alg) (y - algebraMap k C_ℓ (ε_C y)) = 0 := hmem
      rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_eq_zero] at h0
      exact h0

    
    let R_Z := Localization.AtPrime p_z
    let m_Z := IsLocalRing.maximalIdeal R_Z
    obtain ⟨E_0_3, hE03_apply⟩ := hMvM1 p_0 hp0_eq_m0 3
    obtain ⟨Φ_ψ_3, hΦψ3_apply⟩ :=
      (hEtE2 P_2 A_Z ψ_Z_alg hψ_Z p_0 p_z hp0_comap_pz ε_0 ε_Z rfl hker_εZ hεZ_comp).1 3
    let E_Z : (P_2 ⧸ m_0 ^ 3) ≃ₐ[k] (R_Z ⧸ m_Z ^ 3) := E_0_3.trans Φ_ψ_3
    have hEZ_apply : ∀ f : P_2,
        E_Z (Ideal.Quotient.mk _ f) =
          Ideal.Quotient.mk _ (algebraMap A_Z R_Z (ψ_Z f)) := by
      intro f
      change Φ_ψ_3 (E_0_3 (Ideal.Quotient.mk _ f)) = _
      rw [hE03_apply, hΦψ3_apply, Localization.localRingHom_to_map]

    obtain ⟨q_ℓ, hqℓ_lift⟩ :=
      Ideal.Quotient.mk_surjective (E_Z.symm (Ideal.Quotient.mk _ (algebraMap A_Z R_Z ℓ)))
    have hEZ_qℓ : E_Z (Ideal.Quotient.mk _ q_ℓ) =
        Ideal.Quotient.mk _ (algebraMap A_Z R_Z ℓ) := by
      rw [hqℓ_lift, AlgEquiv.apply_symm_apply]
    have hℓ_sub_mZ3 : algebraMap A_Z R_Z (ℓ - ψ_Z q_ℓ) ∈ m_Z ^ 3 := by
      rw [map_sub, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, ← hEZ_apply, hEZ_qℓ, sub_self]
    have hqℓ_m0 : q_ℓ ∈ m_0 := by
      have hmZ3_le : m_Z ^ 3 ≤ m_Z := Ideal.pow_le_self (by decide)
      have hmem_mZ : algebraMap A_Z R_Z (ℓ - ψ_Z q_ℓ) ∈ m_Z := hmZ3_le hℓ_sub_mZ3
      have hcomap_mZ : Ideal.comap (algebraMap A_Z R_Z) m_Z = p_z :=
        IsLocalization.AtPrime.under_maximalIdeal R_Z p_z
      have hsub_pz : ℓ - ψ_Z q_ℓ ∈ p_z := by
        rw [← hcomap_mZ]
        exact hmem_mZ
      have hψ_pz : ψ_Z q_ℓ ∈ p_z := by
        have h1 := p_z.sub_mem hℓ_pz hsub_pz
        simpa using h1
      rw [← hp0_eq_m0, hp0_comap_pz]
      exact hψ_pz

    have hmap_qℓ : Ideal.map (Ideal.Quotient.mk (m_Z ^ 3)) (Ideal.map (algebraMap A_Z R_Z) I_ℓ) =
        Ideal.map E_Z.toRingHom (Ideal.map (Ideal.Quotient.mk (m_0 ^ 3)) (Ideal.span {q_ℓ})) := by
      rw [Ideal.map_map, Ideal.map_span, Set.image_singleton,
        Ideal.map_map, Ideal.map_span, Set.image_singleton]
      change Ideal.span {Ideal.Quotient.mk (m_Z ^ 3) (algebraMap A_Z R_Z ℓ)} =
        Ideal.span {E_Z (Ideal.Quotient.mk (m_0 ^ 3) q_ℓ)}
      rw [hEZ_qℓ]
    obtain ⟨Θ₁⟩ := hQuotSupEquiv (Ideal.span {q_ℓ}) (m_0 ^ 3)
      (Ideal.map (algebraMap A_Z R_Z) I_ℓ) (m_Z ^ 3) E_Z hmap_qℓ

    have hmap_node : Ideal.map (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal (Localization.AtPrime p_0)) ^ 3))
        (Ideal.map (algebraMap P_2 (Localization.AtPrime p_0)) I_node) =
        Ideal.map E_0_3.toRingHom (Ideal.map (Ideal.Quotient.mk (m_0 ^ 3)) I_node) := by
      rw [Ideal.map_map, Ideal.map_span, Set.image_singleton,
        Ideal.map_map, Ideal.map_span, Set.image_singleton]
      change Ideal.span {Ideal.Quotient.mk _ (algebraMap P_2 (Localization.AtPrime p_0) _)} =
        Ideal.span {E_0_3 (Ideal.Quotient.mk (m_0 ^ 3) _)}
      rw [hE03_apply]
    obtain ⟨Θ₆⟩ := hQuotSupEquiv I_node (m_0 ^ 3)
      (Ideal.map (algebraMap P_2 (Localization.AtPrime p_0)) I_node)
      ((IsLocalRing.maximalIdeal (Localization.AtPrime p_0)) ^ 3) E_0_3 hmap_node

    obtain ⟨Θ₂⟩ := hEtE3 A_Z p_z I_ℓ hIℓ_le_pz p_bar_z hpbar_comap 3
    obtain ⟨Θ₃, _⟩ :=
      (hEtE2 C_ℓ B' φ₁_alg hφ₁ p_bar_z q_v hpbar_comap_qv ε_C ε_B hker_εC hker_εB hεB_comp_φ₁).1 3
    obtain ⟨Θ₄_inv, _⟩ :=
      (hEtE2 R_node B' φ₂_alg hφ₂ m_node q_v hmnode_comap_qv ε_node ε_B rfl hker_εB hεB_comp_φ₂).1 3
    obtain ⟨Θ₅_inv⟩ := hEtE3 P_2 p_0 I_node hInode_le_p0 m_node hmnode_comap 3

    have hΘ_nonempty : Nonempty ((P_2 ⧸ (Ideal.span {q_ℓ} ⊔ m_0 ^ 3)) ≃ₐ[k]
        (P_2 ⧸ (I_node ⊔ m_0 ^ 3))) :=
      ⟨((((Θ₁.trans Θ₂).trans Θ₃).trans Θ₄_inv.symm).trans Θ₅_inv.symm).trans Θ₆.symm⟩

    obtain ⟨hqℓ_not_m3, a₀₀, a₀₁, a₁₀, a₁₁, hdet_ne, hL_jet⟩ :=
      hMvM2 q_ℓ hqℓ_m0 hΘ_nonempty

    have hℓ_ne_zero : ℓ ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at hEZ_qℓ
      have hmk0 : Ideal.Quotient.mk (m_0 ^ 3) q_ℓ = 0 :=
        E_Z.injective (hEZ_qℓ.trans (map_zero E_Z).symm)
      exact hqℓ_not_m3 (Ideal.Quotient.eq_zero_iff_mem.mp hmk0)

    
    let L₀ : P_2 := MvPolynomial.C a₀₀ * MvPolynomial.X 0 + MvPolynomial.C a₀₁ * MvPolynomial.X 1
    let L₁ : P_2 := MvPolynomial.C a₁₀ * MvPolynomial.X 0 + MvPolynomial.C a₁₁ * MvPolynomial.X 1
    let Δ_det : k := a₀₀ * a₁₁ - a₀₁ * a₁₀
    have hΔ_inv : Δ_det⁻¹ * Δ_det = 1 := inv_mul_cancel₀ hdet_ne
    let M₀ : P_2 := MvPolynomial.C (Δ_det⁻¹ * a₁₁) * MvPolynomial.X 0 +
      MvPolynomial.C (-(Δ_det⁻¹ * a₀₁)) * MvPolynomial.X 1
    let M₁ : P_2 := MvPolynomial.C (-(Δ_det⁻¹ * a₁₀)) * MvPolynomial.X 0 +
      MvPolynomial.C (Δ_det⁻¹ * a₀₀) * MvPolynomial.X 1
    let σ_inv : P_2 →ₐ[k] P_2 := MvPolynomial.aeval ![L₀, L₁]
    let σ_fwd : P_2 →ₐ[k] P_2 := MvPolynomial.aeval ![M₀, M₁]

    have hσ_inv_C : ∀ c : k, σ_inv (MvPolynomial.C c) = MvPolynomial.C c := fun c =>
      (MvPolynomial.aeval_C ![L₀, L₁] c).trans
        (RingHom.congr_fun (MvPolynomial.algebraMap_eq k (Fin 2)) c)
    have hσ_fwd_C : ∀ c : k, σ_fwd (MvPolynomial.C c) = MvPolynomial.C c := fun c =>
      (MvPolynomial.aeval_C ![M₀, M₁] c).trans
        (RingHom.congr_fun (MvPolynomial.algebraMap_eq k (Fin 2)) c)

    have hLinComb : ∀ (b₀ b₁ c₀₀ c₀₁ c₁₀ c₁₁ : k),
        MvPolynomial.C b₀ * (MvPolynomial.C c₀₀ * MvPolynomial.X (0 : Fin 2) +
            MvPolynomial.C c₀₁ * MvPolynomial.X 1) +
          MvPolynomial.C b₁ * (MvPolynomial.C c₁₀ * MvPolynomial.X 0 +
            MvPolynomial.C c₁₁ * MvPolynomial.X 1) =
        MvPolynomial.C (b₀ * c₀₀ + b₁ * c₁₀) * MvPolynomial.X 0 +
          MvPolynomial.C (b₀ * c₀₁ + b₁ * c₁₁) * MvPolynomial.X 1 := by
      intro b₀ b₁ c₀₀ c₀₁ c₁₀ c₁₁
      simp only [map_add, map_mul]
      ring

    have hσ_fwd_L₀ : σ_fwd L₀ = MvPolynomial.X 0 := by
      dsimp only [L₀]
      rw [map_add, map_mul, map_mul, hσ_fwd_C, hσ_fwd_C, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      change MvPolynomial.C a₀₀ * M₀ + MvPolynomial.C a₀₁ * M₁ = MvPolynomial.X 0
      dsimp only [M₀, M₁]
      rw [hLinComb]
      have h0 : a₀₀ * (Δ_det⁻¹ * a₁₁) + a₀₁ * (-(Δ_det⁻¹ * a₁₀)) = 1 := by
        calc a₀₀ * (Δ_det⁻¹ * a₁₁) + a₀₁ * (-(Δ_det⁻¹ * a₁₀))
          _ = Δ_det⁻¹ * Δ_det := by dsimp [Δ_det]; ring
          _ = 1 := hΔ_inv
      have h1 : a₀₀ * (-(Δ_det⁻¹ * a₀₁)) + a₀₁ * (Δ_det⁻¹ * a₀₀) = 0 := by ring
      rw [h0, h1, map_one, one_mul, map_zero, zero_mul, add_zero]

    have hσ_fwd_L₁ : σ_fwd L₁ = MvPolynomial.X 1 := by
      dsimp only [L₁]
      rw [map_add, map_mul, map_mul, hσ_fwd_C, hσ_fwd_C, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      change MvPolynomial.C a₁₀ * M₀ + MvPolynomial.C a₁₁ * M₁ = MvPolynomial.X 1
      dsimp only [M₀, M₁]
      rw [hLinComb]
      have h0 : a₁₀ * (Δ_det⁻¹ * a₁₁) + a₁₁ * (-(Δ_det⁻¹ * a₁₀)) = 0 := by ring
      have h1 : a₁₀ * (-(Δ_det⁻¹ * a₀₁)) + a₁₁ * (Δ_det⁻¹ * a₀₀) = 1 := by
        calc a₁₀ * (-(Δ_det⁻¹ * a₀₁)) + a₁₁ * (Δ_det⁻¹ * a₀₀)
          _ = Δ_det⁻¹ * Δ_det := by dsimp [Δ_det]; ring
          _ = 1 := hΔ_inv
      rw [h0, h1, map_zero, zero_mul, zero_add, map_one, one_mul]

    have hσ_inv_M₀ : σ_inv M₀ = MvPolynomial.X 0 := by
      change σ_inv (MvPolynomial.C (Δ_det⁻¹ * a₁₁) * MvPolynomial.X 0 +
          MvPolynomial.C (-(Δ_det⁻¹ * a₀₁)) * MvPolynomial.X 1) = MvPolynomial.X 0
      rw [map_add σ_inv, map_mul σ_inv, map_mul σ_inv, hσ_inv_C, hσ_inv_C,
        MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      change MvPolynomial.C (Δ_det⁻¹ * a₁₁) * L₀ +
          MvPolynomial.C (-(Δ_det⁻¹ * a₀₁)) * L₁ = MvPolynomial.X 0
      dsimp only [L₀, L₁]
      rw [hLinComb]
      have h0 : (Δ_det⁻¹ * a₁₁) * a₀₀ + (-(Δ_det⁻¹ * a₀₁)) * a₁₀ = 1 := by
        calc (Δ_det⁻¹ * a₁₁) * a₀₀ + (-(Δ_det⁻¹ * a₀₁)) * a₁₀
          _ = Δ_det⁻¹ * Δ_det := by dsimp [Δ_det]; ring
          _ = 1 := hΔ_inv
      have h1 : (Δ_det⁻¹ * a₁₁) * a₀₁ + (-(Δ_det⁻¹ * a₀₁)) * a₁₁ = 0 := by ring
      rw [h0, h1, map_one, one_mul, map_zero, zero_mul, add_zero]

    have hσ_inv_M₁ : σ_inv M₁ = MvPolynomial.X 1 := by
      dsimp only [M₁]
      rw [map_add, map_mul, map_mul, hσ_inv_C, hσ_inv_C, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      change MvPolynomial.C (-(Δ_det⁻¹ * a₁₀)) * L₀ +
          MvPolynomial.C (Δ_det⁻¹ * a₀₀) * L₁ = MvPolynomial.X 1
      dsimp only [L₀, L₁]
      rw [hLinComb]
      have h0 : (-(Δ_det⁻¹ * a₁₀)) * a₀₀ + (Δ_det⁻¹ * a₀₀) * a₁₀ = 0 := by ring
      have h1 : (-(Δ_det⁻¹ * a₁₀)) * a₀₁ + (Δ_det⁻¹ * a₀₀) * a₁₁ = 1 := by
        calc (-(Δ_det⁻¹ * a₁₀)) * a₀₁ + (Δ_det⁻¹ * a₀₀) * a₁₁
          _ = Δ_det⁻¹ * Δ_det := by dsimp [Δ_det]; ring
          _ = 1 := hΔ_inv
      rw [h0, h1, map_zero, zero_mul, zero_add, map_one, one_mul]

    have hσ_left : σ_fwd.comp σ_inv = AlgHom.id k P_2 := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i
      · change σ_fwd (σ_inv (MvPolynomial.X 0)) = MvPolynomial.X 0
        rw [MvPolynomial.aeval_X]
        exact hσ_fwd_L₀
      · change σ_fwd (σ_inv (MvPolynomial.X 1)) = MvPolynomial.X 1
        rw [MvPolynomial.aeval_X]
        exact hσ_fwd_L₁

    have hσ_right : σ_inv.comp σ_fwd = AlgHom.id k P_2 := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i
      · change σ_inv (σ_fwd (MvPolynomial.X 0)) = MvPolynomial.X 0
        rw [MvPolynomial.aeval_X]
        exact hσ_inv_M₀
      · change σ_inv (σ_fwd (MvPolynomial.X 1)) = MvPolynomial.X 1
        rw [MvPolynomial.aeval_X]
        exact hσ_inv_M₁

    have hσ_bij : Function.Bijective σ_inv.toRingHom := by
      refine ⟨?_, ?_⟩
      · intro x y hxy
        have hx := AlgHom.congr_fun hσ_left x
        have hy := AlgHom.congr_fun hσ_left y
        change σ_fwd (σ_inv.toRingHom x) = x at hx
        change σ_fwd (σ_inv.toRingHom y) = y at hy
        rw [← hx, ← hy, hxy]
      · intro y
        refine ⟨σ_fwd y, ?_⟩
        exact AlgHom.congr_fun hσ_right y
    have hσ_et : σ_inv.toRingHom.Etale := RingHom.Etale.of_bijective hσ_bij

    let ψ'_Z_alg : P_2 →ₐ[k] A_Z := ψ_Z_alg.comp σ_inv
    let ψ'_Z : P_2 →+* A_Z := ψ'_Z_alg.toRingHom
    have hψ'_et : ψ'_Z.Etale :=
      RingHom.Etale.stableUnderComposition σ_inv.toRingHom ψ_Z hσ_et hψ_Z
    have hε0_σ : ε_0.comp σ_inv = ε_0 := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i
      · change ε_0 (σ_inv (MvPolynomial.X 0)) = ε_0 (MvPolynomial.X 0)
        rw [MvPolynomial.aeval_X, hε0_X]
        change ε_0 L₀ = 0
        dsimp only [L₀]
        rw [map_add, map_mul, map_mul, hε0_C, hε0_C, hε0_X, hε0_X, mul_zero, mul_zero, add_zero]
      · change ε_0 (σ_inv (MvPolynomial.X 1)) = ε_0 (MvPolynomial.X 1)
        rw [MvPolynomial.aeval_X, hε0_X]
        change ε_0 L₁ = 0
        dsimp only [L₁]
        rw [map_add, map_mul, map_mul, hε0_C, hε0_C, hε0_X, hε0_X, mul_zero, mul_zero, add_zero]
    have hεZ_comp' : ε_Z.comp ψ'_Z_alg = ε_0 := by
      rw [← AlgHom.comp_assoc, hεZ_comp, hε0_σ]
    have hp0_comap_pz' : p_0 = Ideal.comap ψ'_Z_alg.toRingHom p_z := by
      rw [← hker_εZ]
      change RingHom.ker ε_0.toRingHom = RingHom.ker (ε_Z.comp ψ'_Z_alg).toRingHom
      rw [hεZ_comp']
    have hp'_center : ∀ i : Fin 2, ψ'_Z (MvPolynomial.X i) ∈ p_z := by
      intro i
      rw [← Ideal.mem_comap]
      change MvPolynomial.X i ∈ Ideal.comap ψ'_Z_alg.toRingHom p_z
      rw [← hp0_comap_pz', hp0_eq_m0]
      fin_cases i
      · exact Ideal.subset_span (Set.mem_insert _ _)
      · exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    have hεZ_id' : ε_Z.toRingHom.comp (ψ'_Z.comp MvPolynomial.C) = RingHom.id k := by
      ext c
      change ε_Z (ψ_Z (σ_inv (MvPolynomial.C c))) = c
      rw [hσ_inv_C]
      change ε_Z (algebraMap k A_Z c) = c
      rw [AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]

    have hNoeth_AZ : IsNoetherianRing A_Z := by
      let _ : Algebra P_2 A_Z := ψ'_Z.toAlgebra
      have : Algebra.Etale P_2 A_Z := hψ'_et.toAlgebra
      exact Algebra.FiniteType.isNoetherianRing P_2 A_Z

    have hmZ_eq_map : Ideal.map (Localization.localRingHom p_0 p_z ψ'_Z hp0_comap_pz')
        (IsLocalRing.maximalIdeal (Localization.AtPrime p_0)) = m_Z :=
      (hEtE2 P_2 A_Z ψ'_Z_alg hψ'_et p_0 p_z hp0_comap_pz' ε_0 ε_Z rfl hker_εZ hεZ_comp').2
        hNoeth_AZ
    have hm_p0_eq : IsLocalRing.maximalIdeal (Localization.AtPrime p_0) =
        Ideal.map (algebraMap P_2 (Localization.AtPrime p_0)) m_0 := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p_0 (Localization.AtPrime p_0)]
      exact congrArg (Ideal.map (algebraMap P_2 (Localization.AtPrime p_0))) hp0_eq_m0
    have hmZ_span : m_Z =
        Ideal.span {algebraMap A_Z R_Z (ψ'_Z (MvPolynomial.X 0)),
          algebraMap A_Z R_Z (ψ'_Z (MvPolynomial.X 1))} := by
      rw [← hmZ_eq_map, hm_p0_eq, Ideal.map_map, Ideal.map_span]
      congr 1
      ext y
      simp only [Set.mem_image, Set.mem_insert_iff, Set.mem_singleton_iff, RingHom.comp_apply,
        Localization.localRingHom_to_map]
      constructor
      · rintro ⟨x, rfl | rfl, rfl⟩
        · exact Or.inl rfl
        · exact Or.inr rfl
      · rintro (rfl | rfl)
        · exact ⟨MvPolynomial.X 0, Or.inl rfl, rfl⟩
        · exact ⟨MvPolynomial.X 1, Or.inr rfl, rfl⟩

    have hm0_to_mZ : Ideal.map ((algebraMap A_Z R_Z).comp ψ_Z) m_0 ≤ m_Z := by
      rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
      intro g hg
      change algebraMap A_Z R_Z (ψ_Z g) ∈ IsLocalRing.maximalIdeal R_Z
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p_z R_Z]
      apply Ideal.mem_map_of_mem
      rcases Set.mem_insert_iff.mp hg with rfl | hg1
      · exact hp_center 0
      · rw [Set.mem_singleton_iff.mp hg1]
        exact hp_center 1
    have hL_diff_mZ3 : algebraMap A_Z R_Z (ψ_Z (L₀ * L₁ - q_ℓ)) ∈ m_Z ^ 3 := by
      have h1 : algebraMap A_Z R_Z (ψ_Z (L₀ * L₁ - q_ℓ)) ∈
          Ideal.map ((algebraMap A_Z R_Z).comp ψ_Z) (m_0 ^ 3) :=
        Ideal.mem_map_of_mem _ hL_jet
      rw [Ideal.map_pow] at h1
      exact pow_le_pow_left' hm0_to_mZ 3 h1
    have hψ'_X0X1 : ψ'_Z (MvPolynomial.X 0 * MvPolynomial.X 1) = ψ_Z (L₀ * L₁) := by
      change ψ_Z (σ_inv (MvPolynomial.X 0 * MvPolynomial.X 1)) = ψ_Z (L₀ * L₁)
      rw [map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      rfl
    have hℓ_jet' : algebraMap A_Z R_Z (ℓ - ψ'_Z (MvPolynomial.X 0 * MvPolynomial.X 1)) ∈ m_Z ^ 3 := by
      have heq : ℓ - ψ'_Z (MvPolynomial.X 0 * MvPolynomial.X 1) =
          (ℓ - ψ_Z q_ℓ) - ψ_Z (L₀ * L₁ - q_ℓ) := by
        rw [hψ'_X0X1, map_sub]
        ring
      rw [heq, map_sub]
      exact (m_Z ^ 3).sub_mem hℓ_sub_mZ3 hL_diff_mZ3

    
    obtain ⟨A'_Z, ι_et, q'_0, ε'_Z, u_A, v_A, c_s,
        ⟨hι_et, hq'0_max, hker_ε'Z, hε'Z_comp, hpz_comap_q'0⟩,
        huv_prod, huv_span, ⟨hcs_ne, hu_jet, hv_jet⟩⟩ :=
      weil_ring_standardEtale_quad_nodal_factorization k A_Z ψ'_Z hψ'_et p_z
        ε_Z.toRingHom hker_εZ hεZ_id' hp'_center ℓ hmZ_span hℓ_jet'

    have hq'0_prime : q'_0.IsPrime := hq'0_max.isPrime
    let R'_Z := Localization.AtPrime q'_0
    let m'_Z := IsLocalRing.maximalIdeal R'_Z
    let φ_loc : R_Z →+* R'_Z := Localization.localRingHom p_z q'_0 ι_et hpz_comap_q'0
    have : IsLocalHom φ_loc := Localization.isLocalHom_localRingHom p_z q'_0 ι_et hpz_comap_q'0

    let ψ''_Z : P_2 →+* A'_Z := ι_et.comp ψ'_Z
    have hψ''_et : ψ''_Z.Etale :=
      RingHom.Etale.stableUnderComposition ψ'_Z ι_et hψ'_et hι_et

    have hDom_R'Z : IsDomain R'_Z := by
      let _ : Algebra P_2 A'_Z := ψ''_Z.toAlgebra
      have : Algebra.Etale P_2 A'_Z := hψ''_et.toAlgebra
      obtain ⟨f, hf, hDom⟩ :=
        weil_integrallyClosed_noetherian_etale_away_isDomain P_2 A'_Z q'_0
      exact hDomAtPrime A'_Z q'_0 f hf hDom

    have hNoeth_A'Z : IsNoetherianRing A'_Z := by
      let _ : Algebra P_2 A'_Z := ψ''_Z.toAlgebra
      have : Algebra.Etale P_2 A'_Z := hψ''_et.toAlgebra
      exact Algebra.FiniteType.isNoetherianRing P_2 A'_Z
    have hNoeth_R'Z : IsNoetherianRing R'_Z :=
      IsLocalization.isNoetherianRing q'_0.primeCompl R'_Z hNoeth_A'Z

    have hFlat_loc : φ_loc.Flat := by
      have hFlat_ι : ι_et.Flat := by
        let _ : Algebra A_Z A'_Z := ι_et.toAlgebra
        have : Algebra.Etale A_Z A'_Z := hι_et.toAlgebra
        exact Algebra.Smooth.flat A_Z A'_Z
      exact RingHom.Flat.localRingHom hFlat_ι q'_0 p_z hpz_comap_q'0

    let u_tilde : R'_Z := algebraMap A'_Z R'_Z u_A
    let v_tilde : R'_Z := algebraMap A'_Z R'_Z v_A

    have h_prod_loc : φ_loc (algebraMap A_Z R_Z ℓ) = u_tilde * v_tilde := by
      change Localization.localRingHom p_z q'_0 ι_et hpz_comap_q'0 (algebraMap A_Z R_Z ℓ) = _
      rw [Localization.localRingHom_to_map, ← huv_prod, map_mul]

    let _ : Algebra k A'_Z := (ψ''_Z.comp MvPolynomial.C).toAlgebra
    let ψ''_Z_alg : P_2 →ₐ[k] A'_Z := { ψ''_Z with commutes' := fun _ => rfl }
    let ε'_Z_alg : A'_Z →ₐ[k] k :=
      { ε'_Z with
        commutes' := fun c => by
          change (ε'_Z.comp (ι_et.comp (ψ'_Z.comp MvPolynomial.C))) c = c
          rw [← RingHom.comp_assoc, hε'Z_comp]
          exact RingHom.congr_fun hεZ_id' c }
    have hε'Z_ψ'' : ε'_Z_alg.comp ψ''_Z_alg = ε_0 := by
      apply MvPolynomial.algHom_ext
      intro i
      change ε'_Z (ι_et (ψ'_Z (MvPolynomial.X i))) = ε_0 (MvPolynomial.X i)
      have h1 : ε'_Z (ι_et (ψ'_Z (MvPolynomial.X i))) = ε_Z (ψ'_Z (MvPolynomial.X i)) :=
        RingHom.congr_fun hε'Z_comp _
      have h2 : ε_Z (ψ'_Z (MvPolynomial.X i)) = ε_0 (MvPolynomial.X i) :=
        AlgHom.congr_fun hεZ_comp' _
      exact h1.trans h2
    have hp0_comap_q'0 : p_0 = Ideal.comap ψ''_Z_alg.toRingHom q'_0 := by
      rw [← hker_ε'Z]
      change RingHom.ker ε_0.toRingHom = RingHom.ker (ε'_Z_alg.comp ψ''_Z_alg).toRingHom
      rw [hε'Z_ψ'']

    have hm'Z_eq_map : Ideal.map (Localization.localRingHom p_0 q'_0 ψ''_Z hp0_comap_q'0)
        (IsLocalRing.maximalIdeal (Localization.AtPrime p_0)) = m'_Z :=
      (hEtE2 P_2 A'_Z ψ''_Z_alg hψ''_et p_0 q'_0 hp0_comap_q'0 ε_0 ε'_Z_alg
        rfl hker_ε'Z hε'Z_ψ'').2 hNoeth_A'Z
    have hm'Z_coords : m'_Z =
        Ideal.span {algebraMap A'_Z R'_Z (ψ''_Z (MvPolynomial.X 0)),
          algebraMap A'_Z R'_Z (ψ''_Z (MvPolynomial.X 1))} := by
      rw [← hm'Z_eq_map, hm_p0_eq, Ideal.map_map, Ideal.map_span]
      congr 1
      ext y
      simp only [Set.mem_image, Set.mem_insert_iff, Set.mem_singleton_iff, RingHom.comp_apply,
        Localization.localRingHom_to_map]
      constructor
      · rintro ⟨x, rfl | rfl, rfl⟩
        · exact Or.inl rfl
        · exact Or.inr rfl
      · rintro (rfl | rfl)
        · exact ⟨MvPolynomial.X 0, Or.inl rfl, rfl⟩
        · exact ⟨MvPolynomial.X 1, Or.inr rfl, rfl⟩
    have hm'Z_span_uv : m'_Z = Ideal.span {u_tilde, v_tilde} := by
      have hmap_uv : Ideal.map (algebraMap A'_Z R'_Z) (Ideal.span {u_A, v_A}) =
          Ideal.map (algebraMap A'_Z R'_Z)
            (Ideal.span {ψ''_Z (MvPolynomial.X 0), ψ''_Z (MvPolynomial.X 1)}) :=
        congrArg (Ideal.map (algebraMap A'_Z R'_Z)) huv_span
      rw [Ideal.map_span, Ideal.map_span] at hmap_uv
      have hset1 : (algebraMap A'_Z R'_Z) '' ({u_A, v_A} : Set A'_Z) = {u_tilde, v_tilde} := by
        ext y; simp [u_tilde, v_tilde]
      have hset2 : (algebraMap A'_Z R'_Z) ''
          ({ψ''_Z (MvPolynomial.X 0), ψ''_Z (MvPolynomial.X 1)} : Set A'_Z) =
          {algebraMap A'_Z R'_Z (ψ''_Z (MvPolynomial.X 0)),
            algebraMap A'_Z R'_Z (ψ''_Z (MvPolynomial.X 1))} := by
        ext y; simp
      rw [hset1, hset2] at hmap_uv
      rw [hm'Z_coords, ← hmap_uv]

    
    have hq'0_to_m'Z2 : ∀ x : A'_Z, x ∈ q'_0 ^ 2 → algebraMap A'_Z R'_Z x ∈ m'_Z ^ 2 := by
      intro x hx
      have h1 : algebraMap A'_Z R'_Z x ∈ Ideal.map (algebraMap A'_Z R'_Z) (q'_0 ^ 2) :=
        Ideal.mem_map_of_mem _ hx
      rw [Ideal.map_pow, IsLocalization.AtPrime.map_eq_maximalIdeal q'_0 R'_Z] at h1
      exact h1
    have hu_tilde_jet : u_tilde - algebraMap A'_Z R'_Z
        (ψ''_Z (MvPolynomial.C c_s * MvPolynomial.X 1)) ∈ m'_Z ^ 2 := by
      have h := hq'0_to_m'Z2 _ hu_jet
      simpa only [map_sub, u_tilde, ψ''_Z, RingHom.comp_apply] using h
    have hv_tilde_jet : v_tilde - algebraMap A'_Z R'_Z
        (ψ''_Z (MvPolynomial.C c_s⁻¹ * MvPolynomial.X 0)) ∈ m'_Z ^ 2 := by
      have h := hq'0_to_m'Z2 _ hv_jet
      simpa only [map_sub, v_tilde, ψ''_Z, RingHom.comp_apply] using h

    have h_nondiv_both : ∀ n : ℕ,
        v_tilde ^ n ∉ Ideal.span {u_tilde} ∧ u_tilde ^ n ∉ Ideal.span {v_tilde} := by
      intro n
      let k_jet := n + 2
      obtain ⟨E_0_k, hE0k_apply⟩ := hMvM1 p_0 hp0_eq_m0 k_jet
      obtain ⟨Φ_ψ''_k, hΦψ''k_apply⟩ :=
        (hEtE2 P_2 A'_Z ψ''_Z_alg hψ''_et p_0 q'_0 hp0_comap_q'0 ε_0 ε'_Z_alg
          rfl hker_ε'Z hε'Z_ψ'').1 k_jet
      let F_k : (P_2 ⧸ m_0 ^ k_jet) ≃ₐ[k] (R'_Z ⧸ m'_Z ^ k_jet) := E_0_k.trans Φ_ψ''_k
      have hFk_apply : ∀ f : P_2,
          F_k (Ideal.Quotient.mk _ f) =
            Ideal.Quotient.mk _ (algebraMap A'_Z R'_Z (ψ''_Z f)) := by
        intro f
        change Φ_ψ''_k (E_0_k (Ideal.Quotient.mk _ f)) = _
        rw [hE0k_apply, hΦψ''k_apply, Localization.localRingHom_to_map]
      have hm'Z_mod_eq : Ideal.map (Ideal.Quotient.mk (m'_Z ^ k_jet)) m'_Z =
          Ideal.map (Ideal.Quotient.mk (m'_Z ^ k_jet))
            (Ideal.span {algebraMap A'_Z R'_Z (ψ''_Z (MvPolynomial.X 0)),
              algebraMap A'_Z R'_Z (ψ''_Z (MvPolynomial.X 1))}) :=
        congrArg (Ideal.map (Ideal.Quotient.mk (m'_Z ^ k_jet))) hm'Z_coords
      have hFsymm_m : Ideal.map F_k.symm.toRingHom
          (Ideal.map (Ideal.Quotient.mk (m'_Z ^ k_jet)) m'_Z) ≤
          Ideal.map (Ideal.Quotient.mk (m_0 ^ k_jet)) m_0 := by
        rw [hm'Z_mod_eq, Ideal.map_span, Ideal.map_span, Ideal.span_le]
        intro y hy
        simp only [Set.mem_image, Set.mem_insert_iff, Set.mem_singleton_iff] at hy
        rcases hy with ⟨_, ⟨x, rfl | rfl, rfl⟩, rfl⟩
        · change F_k.symm (Ideal.Quotient.mk _ (algebraMap A'_Z R'_Z (ψ''_Z (MvPolynomial.X 0)))) ∈ _
          rw [← hFk_apply, AlgEquiv.symm_apply_apply]
          exact Ideal.mem_map_of_mem _ (Ideal.subset_span (Set.mem_insert _ _))
        · change F_k.symm (Ideal.Quotient.mk _ (algebraMap A'_Z R'_Z (ψ''_Z (MvPolynomial.X 1)))) ∈ _
          rw [← hFk_apply, AlgEquiv.symm_apply_apply]
          exact Ideal.mem_map_of_mem _
            (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
      have hLift_m2 : ∀ δ : R'_Z, δ ∈ m'_Z ^ 2 →
          ∃ r : P_2, r ∈ m_0 ^ 2 ∧
            F_k (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ δ := by
        intro δ hδ
        obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (F_k.symm (Ideal.Quotient.mk _ δ))
        have hFk_r : F_k (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ δ := by
          rw [hr, AlgEquiv.apply_symm_apply]
        have hmk_δ : Ideal.Quotient.mk (m'_Z ^ k_jet) δ ∈
            (Ideal.map (Ideal.Quotient.mk (m'_Z ^ k_jet)) m'_Z) ^ 2 := by
          rw [← Ideal.map_pow]
          exact Ideal.mem_map_of_mem _ hδ
        have hmk_r : Ideal.Quotient.mk (m_0 ^ k_jet) r ∈
            Ideal.map (Ideal.Quotient.mk (m_0 ^ k_jet)) (m_0 ^ 2) := by
          rw [Ideal.map_pow]
          have h1 : F_k.symm.toRingHom (Ideal.Quotient.mk (m'_Z ^ k_jet) δ) ∈
              Ideal.map F_k.symm.toRingHom
                ((Ideal.map (Ideal.Quotient.mk (m'_Z ^ k_jet)) m'_Z) ^ 2) :=
            Ideal.mem_map_of_mem _ hmk_δ
          rw [Ideal.map_pow] at h1
          have h2 : F_k.symm.toRingHom (Ideal.Quotient.mk (m'_Z ^ k_jet) δ) =
              Ideal.Quotient.mk (m_0 ^ k_jet) r := hr.symm
          rw [h2] at h1
          exact pow_le_pow_left' hFsymm_m 2 h1
        have hcomap_m2 : r ∈ Ideal.comap (Ideal.Quotient.mk (m_0 ^ k_jet))
            (Ideal.map (Ideal.Quotient.mk (m_0 ^ k_jet)) (m_0 ^ 2)) := hmk_r
        rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective] at hcomap_m2
        have hker_mk : Ideal.comap (Ideal.Quotient.mk (m_0 ^ k_jet)) ⊥ = m_0 ^ k_jet :=
          Ideal.mk_ker
        rw [hker_mk] at hcomap_m2
        have hle2 : m_0 ^ k_jet ≤ m_0 ^ 2 := Ideal.pow_le_pow_right (by omega)
        rw [sup_eq_left.mpr hle2] at hcomap_m2
        exact ⟨r, hcomap_m2, hFk_r⟩
      obtain ⟨r_u, hru_m2, hFk_ru⟩ := hLift_m2 _ hu_tilde_jet
      obtain ⟨r_v, hrv_m2, hFk_rv⟩ := hLift_m2 _ hv_tilde_jet
      let U : P_2 := MvPolynomial.C c_s * MvPolynomial.X 1 + r_u
      let V : P_2 := MvPolynomial.C c_s⁻¹ * MvPolynomial.X 0 + r_v
      have hFk_U : F_k (Ideal.Quotient.mk _ U) = Ideal.Quotient.mk _ u_tilde := by
        dsimp [U]
        rw [map_add, map_add, hFk_apply, hFk_ru, ← map_add, add_sub_cancel]
      have hFk_V : F_k (Ideal.Quotient.mk _ V) = Ideal.Quotient.mk _ v_tilde := by
        dsimp [V]
        rw [map_add, map_add, hFk_apply, hFk_rv, ← map_add, add_sub_cancel]
      obtain ⟨hVn_not, hUn_not⟩ :=
        hMvM3 c_s c_s⁻¹ hcs_ne (inv_ne_zero hcs_ne) r_u r_v hru_m2 hrv_m2 n
      have hle_n1 : m_0 ^ k_jet ≤ m_0 ^ (n + 1) := Ideal.pow_le_pow_right (by omega)
      refine ⟨?_, ?_⟩
      · intro hmem
        rw [Ideal.mem_span_singleton] at hmem
        rcases hmem with ⟨z, hz⟩
        obtain ⟨W, hW⟩ := Ideal.Quotient.mk_surjective (F_k.symm (Ideal.Quotient.mk _ z))
        have hFk_W : F_k (Ideal.Quotient.mk _ W) = Ideal.Quotient.mk _ z := by
          rw [hW, AlgEquiv.apply_symm_apply]
        have hdiff0 : F_k (Ideal.Quotient.mk _ (V ^ n - U * W)) = 0 := by
          rw [map_sub, map_pow, map_mul, map_sub, map_pow, map_mul, hFk_V, hFk_U, hFk_W,
            ← map_pow, ← map_mul, ← map_sub, hz, sub_self, map_zero]
        have hmk0 : Ideal.Quotient.mk (m_0 ^ k_jet) (V ^ n - U * W) = 0 :=
          F_k.injective (hdiff0.trans (map_zero F_k).symm)
        have hrem : V ^ n - U * W ∈ m_0 ^ (n + 1) :=
          hle_n1 (Ideal.Quotient.eq_zero_iff_mem.mp hmk0)
        have hVn_in : V ^ n ∈ Ideal.span {U} ⊔ m_0 ^ (n + 1) := by
          have heq : V ^ n = U * W + (V ^ n - U * W) := by ring
          rw [heq]
          exact Ideal.add_mem _
            (Ideal.mem_sup_left (Ideal.mem_span_singleton.mpr ⟨W, rfl⟩))
            (Ideal.mem_sup_right hrem)
        exact hVn_not hVn_in
      · intro hmem
        rw [Ideal.mem_span_singleton] at hmem
        rcases hmem with ⟨z, hz⟩
        obtain ⟨W, hW⟩ := Ideal.Quotient.mk_surjective (F_k.symm (Ideal.Quotient.mk _ z))
        have hFk_W : F_k (Ideal.Quotient.mk _ W) = Ideal.Quotient.mk _ z := by
          rw [hW, AlgEquiv.apply_symm_apply]
        have hdiff0 : F_k (Ideal.Quotient.mk _ (U ^ n - V * W)) = 0 := by
          rw [map_sub, map_pow, map_mul, map_sub, map_pow, map_mul, hFk_U, hFk_V, hFk_W,
            ← map_pow, ← map_mul, ← map_sub, hz, sub_self, map_zero]
        have hmk0 : Ideal.Quotient.mk (m_0 ^ k_jet) (U ^ n - V * W) = 0 :=
          F_k.injective (hdiff0.trans (map_zero F_k).symm)
        have hrem : U ^ n - V * W ∈ m_0 ^ (n + 1) :=
          hle_n1 (Ideal.Quotient.eq_zero_iff_mem.mp hmk0)
        have hUn_in : U ^ n ∈ Ideal.span {V} ⊔ m_0 ^ (n + 1) := by
          have heq : U ^ n = V * W + (U ^ n - V * W) := by ring
          rw [heq]
          exact Ideal.add_mem _
            (Ideal.mem_sup_left (Ideal.mem_span_singleton.mpr ⟨W, rfl⟩))
            (Ideal.mem_sup_right hrem)
        exact hUn_not hUn_in

    have h_red_all : ∀ (P : Ideal A_Z) [P.IsPrime], P < p_z →
        IsReduced (R'_Z ⧸ Ideal.map (φ_loc.comp (algebraMap A_Z R_Z)) P) := by
      intro P _ _
      have hcomp_eq : φ_loc.comp (algebraMap A_Z R_Z) = (algebraMap A'_Z R'_Z).comp ι_et := by
        ext a
        exact Localization.localRingHom_to_map p_z q'_0 ι_et hpz_comap_q'0 a
      rw [hcomp_eq]
      exact hEtE4 A_Z A'_Z ι_et hι_et P q'_0

    obtain ⟨hNoThree, hPoleClear⟩ :=
      weil_local_nodal_split_two_branches_and_pole_clearing
        A_Z p_z ℓ hℓ_pz R'_Z φ_loc hFlat_loc u_tilde v_tilde
        h_prod_loc hm'Z_span_uv
        (fun n => (h_nondiv_both n).1)
        (fun n => (h_nondiv_both n).2)
        h_red_all

    exact ⟨⟨hℓ_ne_zero, hNoThree⟩, hPoleClear⟩

theorem weil_algClosed_surface_nodal_reducible_two_components (k : Type u) [Field k] [IsAlgClosed k]
    (N : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 2 Z_bar.hom]
    (ι₀ : Z_bar ⟶ weilProjectiveSpaceOver k N)
    (hCl₀ : AlgebraicGeometry.IsClosedImmersion ι₀.left)
    (F_L : MvPolynomial (Fin (N + 1)) k)
    (hFL : F_L ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 3)
    (hNondeg : ∃ z : Z_bar.left, ι₀.left.base z ∉ weilProjHyperplaneSet k N F_L)
    (C_L : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_CL : C_L ⟶ Z_bar)
    (hPull : IsHomogeneousHypersurfacePullbackOver k N 3 ι₀ F_L ι_CL.left)
    (hConn : ConnectedSpace ↥C_L.left)
    (hSmOrNode : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_L.hom ∨
      ∃ x₀ : C_L.left, IsClosed ({x₀} : Set C_L.left) ∧
        (∀ y : C_L.left, y ≠ x₀ → ∃ V : C_L.left.Opens, y ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ C_L.hom)) ∧
        ∃ (V' : AlgebraicGeometry.Scheme.{u}) (v₀ : V') (e₁ : V' ⟶ C_L.left)
          (e₂ : V' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) k ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
          AlgebraicGeometry.Etale e₁ ∧ AlgebraicGeometry.Etale e₂ ∧ e₁.base v₀ = x₀ ∧
          (∀ b : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X b) ∈ (e₂.base v₀).asIdeal) ∧
          e₁ ≫ C_L.hom = e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))
    (hDVR1D : ∀ (B : Type u) [CommRing B] (ψ : Polynomial k →+* B),
      ψ.Etale →
      ∀ (q : Ideal B) [q.IsPrime],
        IsDomain (Localization.AtPrime q))
    (hNode2D : ∀ (A_Z : Type u) [CommRing A_Z]
        (ψ_Z : MvPolynomial (Fin 2) k →+* A_Z),
      ψ_Z.Etale →
      ∀ (p_z : Ideal A_Z) [p_z.IsMaximal],
        (∀ i : Fin 2, ψ_Z (MvPolynomial.X i) ∈ p_z) →
        ∀ (ℓ : A_Z), ℓ ∈ p_z →
        ∀ (B' : Type u) [CommRing B']
          (q_v : Ideal B') [q_v.IsPrime]
          (φ₁ : (A_Z ⧸ Ideal.span {ℓ}) →+* B')
          (φ₂ : (MvPolynomial (Fin 2) k ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B'),
          φ₁.Etale →
          φ₂.Etale →
          Ideal.comap φ₁ q_v = Ideal.map (Ideal.Quotient.mk (Ideal.span {ℓ})) p_z →
          (∀ b : Fin 2,
            φ₂ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})
              (MvPolynomial.X b)) ∈ q_v) →
          φ₁.comp ((Ideal.Quotient.mk (Ideal.span {ℓ})).comp (ψ_Z.comp MvPolynomial.C)) =
            φ₂.comp ((Ideal.Quotient.mk
              (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})).comp MvPolynomial.C) →
          (ℓ ≠ 0 ∧
            ¬ ∃ (P₁ P₂ P₃ : Ideal A_Z),
              P₁.IsPrime ∧ P₂.IsPrime ∧ P₃.IsPrime ∧
              P₁ ≠ P₂ ∧ P₁ ≠ P₃ ∧ P₂ ≠ P₃ ∧
              P₁ < p_z ∧ P₂ < p_z ∧ P₃ < p_z ∧
              ℓ ∈ P₁ ∧ ℓ ∈ P₂ ∧ ℓ ∈ P₃) ∧
          (∀ (P₁ P₂ : Ideal A_Z) [P₁.IsPrime] [P₂.IsPrime],
            P₁ < p_z → P₂ < p_z → ¬(P₁ ≤ P₂) → ¬(P₂ ≤ P₁) →
            ℓ ∈ P₁ → ℓ ∈ P₂ →
            ∀ (u_unit s g c t_diff : A_Z) (j : ℕ),
              u_unit ∉ p_z →
              s ∉ P₁ →
              t_diff ∈ p_z →
              algebraMap A_Z (Localization.AtPrime p_z) (s * g) =
                (algebraMap A_Z (Localization.AtPrime p_z) (u_unit * ℓ)) ^ j *
                  algebraMap A_Z (Localization.AtPrime p_z) c →
              ∃ (d r : A_Z), d ∉ p_z ∧ d * t_diff ^ j * c - s * r ∈ P₁))
    (hNotIrred : ¬ IrreducibleSpace ↥C_L.left) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
      MvPolynomial.gradedAlgebra
    ∃ (z₀ : Z_bar.left)
      (C₁ C₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (ι₁ : C₁ ⟶ Z_bar) (ι₂ : C₂ ⟶ Z_bar),
      IsClosed ({z₀} : Set Z_bar.left) ∧
      AlgebraicGeometry.IsIntegral C₁.left ∧
      AlgebraicGeometry.IsIntegral C₂.left ∧
      AlgebraicGeometry.IsProper C₁.hom ∧
      AlgebraicGeometry.IsProper C₂.hom ∧
      AlgebraicGeometry.IsClosedImmersion ι₁.left ∧
      AlgebraicGeometry.IsClosedImmersion ι₂.left ∧
      Set.range ι_CL.left.base = Set.range ι₁.left.base ∪ Set.range ι₂.left.base ∧
      Set.range ι₁.left.base ∩ Set.range ι₂.left.base = {z₀} ∧
      1 ≤ topologicalKrullDim C₁.left ∧
      1 ≤ topologicalKrullDim C₂.left ∧
      ∀ (H : MvPolynomial (Fin (N + 1)) k)
        (hH : H ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
        (U : Z_bar.left.Opens) (hAffU : AlgebraicGeometry.IsAffineOpen U)
        (hU_sub : U ≤ (TopologicalSpace.Opens.map ι₀.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) H)),
        let A_U : Type u := ↑(Z_bar.left.presheaf.obj (Opposite.op U))
        let τ_U : A_U :=
          (ι₀.left.appLE
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) H) U hU_sub).hom
            ((AlgebraicGeometry.Proj.awayToSection
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) H).hom
              (HomogeneousLocalization.Away.mk
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) hH 3 F_L hFL))
        let P₁ : Ideal A_U := RingHom.ker (ι₁.left.app U).hom
        let P₂ : Ideal A_U := RingHom.ker (ι₂.left.app U).hom
        (Function.Surjective (ι₁.left.app U).hom ∧
          Function.Surjective (ι₂.left.app U).hom ∧
          τ_U ∈ P₁ ∧ τ_U ∈ P₂ ∧
          (Nonempty ↥U → τ_U ≠ 0)) ∧
        (∀ (q : Ideal A_U) [q.IsPrime],
          (∀ hz : z₀ ∈ U, q ≠ (hAffU.primeIdealOf ⟨z₀, hz⟩).asIdeal) →
          let R_q := Localization.AtPrime q
          ¬(P₁ ≤ q ∧ P₂ ≤ q) ∧
          (P₁ ≤ q →
            Ideal.map (algebraMap A_U R_q) P₁ = Ideal.span {algebraMap A_U R_q τ_U}) ∧
          (P₂ ≤ q →
            Ideal.map (algebraMap A_U R_q) P₂ = Ideal.span {algebraMap A_U R_q τ_U}) ∧
          (¬(P₁ ≤ q) → ¬(P₂ ≤ q) → IsUnit (algebraMap A_U R_q τ_U))) ∧
        (∀ (hz₀ : z₀ ∈ U),
          let p_z₀ : Ideal A_U := (hAffU.primeIdealOf ⟨z₀, hz₀⟩).asIdeal
          p_z₀.IsMaximal ∧ P₁.IsPrime ∧ P₂.IsPrime ∧
          P₁ ≤ p_z₀ ∧ P₂ ≤ p_z₀ ∧
          (∀ (s g c t_diff : A_U) (j : ℕ),
            s ∉ P₁ → t_diff ∈ p_z₀ → s * g = τ_U ^ j * c →
            ∃ (d r : A_U), d ∉ p_z₀ ∧ d * t_diff ^ j * c - s * r ∈ P₁) ∧
          (∀ (s g c t_diff : A_U) (j : ℕ),
            s ∉ P₂ → t_diff ∈ p_z₀ → s * g = τ_U ^ j * c →
            ∃ (d r : A_U), d ∉ p_z₀ ∧ d * t_diff ^ j * c - s * r ∈ P₂)) :=
by
  
  have hTopoClopen : ∀ (X : Type u) [TopologicalSpace X]
      [TopologicalSpace.NoetherianSpace X] [ConnectedSpace X],
      ¬ IrreducibleSpace X →
      ∀ (K : Set X), K ∈ irreducibleComponents X →
        (∀ y ∈ K, ∀ K' ∈ irreducibleComponents X, y ∈ K' → K = K') → False := by
    intro X _ _ _ hNotIrredX K hK hIso
    have hFin : (irreducibleComponents X).Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    let S_other : Set (Set X) := irreducibleComponents X \ {K}
    have hFin_other : S_other.Finite := hFin.sdiff
    let U_other : Set X := ⋃ K' ∈ S_other, K'
    have hCl_other : IsClosed U_other :=
      hFin_other.isClosed_biUnion fun K' hK' => isClosed_of_mem_irreducibleComponents K' hK'.1
    have hDisj : Disjoint K U_other := by
      rw [Set.disjoint_left]
      intro y hyK hyU
      rcases Set.mem_iUnion₂.mp hyU with ⟨K', hK'_mem, hyK'⟩
      exact hK'_mem.2 (hIso y hyK K' hK'_mem.1 hyK').symm
    have hUnion : K ∪ U_other = Set.univ := by
      ext x
      simp only [Set.mem_union, Set.mem_univ, iff_true]
      by_cases hx : x ∈ K
      · exact Or.inl hx
      · right
        refine Set.mem_iUnion₂.mpr ⟨irreducibleComponent x,
          ⟨irreducibleComponent_mem_irreducibleComponents x, ?_⟩, mem_irreducibleComponent⟩
        rintro (hEq : irreducibleComponent x = K)
        exact hx (hEq ▸ mem_irreducibleComponent)
    have hCompl : K = U_otherᶜ := by
      ext x
      constructor
      · intro hxK hxU
        exact Set.disjoint_left.mp hDisj hxK hxU
      · intro hxNotU
        have : x ∈ K ∪ U_other := hUnion.symm ▸ Set.mem_univ x
        rcases this with hxK | hxU
        · exact hxK
        · exact False.elim (hxNotU hxU)
    have hClK : IsClosed K := isClosed_of_mem_irreducibleComponents K hK
    have hOpenK : IsOpen K := hCompl ▸ hCl_other.isOpen_compl
    have hClopenK : IsClopen K := ⟨hClK, hOpenK⟩
    rcases isClopen_iff.mp hClopenK with hEmpty | hUniv
    · exact Set.not_nonempty_empty (hEmpty ▸ hK.1.nonempty)
    · exact hNotIrredX { isPreirreducible_univ := (hUniv ▸ hK.1).isPreirreducible, toNonempty := inferInstance }

  have hTopoNodal : ∀ (X : Type u) [TopologicalSpace X]
      [TopologicalSpace.NoetherianSpace X] [ConnectedSpace X],
      ¬ IrreducibleSpace X →
      ∀ (x₀ : X),
        (∀ (y : X), y ≠ x₀ →
          ∀ (K₁ K₂ : Set X), K₁ ∈ irreducibleComponents X → K₂ ∈ irreducibleComponents X →
            y ∈ K₁ → y ∈ K₂ → K₁ = K₂) →
        (∀ K ∈ irreducibleComponents X,
          IsClosed K ∧ IsIrreducible K ∧ x₀ ∈ K ∧ (∃ y ∈ K, y ≠ x₀) ∧
          (∀ (W : Set X), IsOpen W → x₀ ∈ W →
            ∀ K' ∈ irreducibleComponents X, K ≠ K' → ¬(K ∩ W ⊆ K' ∩ W))) ∧
        ((¬ ∃ (K₁ K₂ K₃ : Set X),
            K₁ ∈ irreducibleComponents X ∧ K₂ ∈ irreducibleComponents X ∧ K₃ ∈ irreducibleComponents X ∧
            K₁ ≠ K₂ ∧ K₁ ≠ K₃ ∧ K₂ ≠ K₃) →
          ∃ (K₁ K₂ : Set X),
            K₁ ∈ irreducibleComponents X ∧ K₂ ∈ irreducibleComponents X ∧ K₁ ≠ K₂ ∧
            IsClosed K₁ ∧ IsIrreducible K₁ ∧ IsClosed K₂ ∧ IsIrreducible K₂ ∧
            K₁ ∪ K₂ = Set.univ ∧ K₁ ∩ K₂ = {x₀} ∧
            (∃ y₁ ∈ K₁, y₁ ≠ x₀) ∧ (∃ y₂ ∈ K₂, y₂ ≠ x₀)) := by
    intro X _ _ _ hNotIrredX x₀ hUniqAway
    have hx₀_all : ∀ K ∈ irreducibleComponents X, x₀ ∈ K := by
      intro K hK
      by_contra hx₀_not
      refine hTopoClopen X hNotIrredX K hK ?_
      intro y hyK K' hK' hyK'
      have hy_ne : y ≠ x₀ := fun hEq => hx₀_not (hEq ▸ hyK)
      exact hUniqAway y hy_ne K K' hK hK' hyK hyK'
    have hExistsOther : ∀ K ∈ irreducibleComponents X, ∃ K' ∈ irreducibleComponents X, K' ≠ K := by
      intro K hK
      by_contra hNo
      have hAllEq : ∀ K' ∈ irreducibleComponents X, K' = K := by
        intro K' hK'
        by_contra hne
        exact hNo ⟨K', hK', hne⟩
      have hUniv : K = Set.univ := by
        ext x
        simp only [Set.mem_univ, iff_true]
        have hmem := irreducibleComponent_mem_irreducibleComponents x
        rw [← hAllEq (irreducibleComponent x) hmem]
        exact mem_irreducibleComponent
      exact hNotIrredX { isPreirreducible_univ := (hUniv ▸ hK.1).isPreirreducible, toNonempty := inferInstance }
    have hClosureInter : ∀ K : Set X, IsClosed K → IsIrreducible K →
        ∀ W : Set X, IsOpen W → (K ∩ W).Nonempty → closure (K ∩ W) = K := by
      intro K hClK hIrrK W hOpenW hNe
      apply Set.Subset.antisymm
      · exact hClK.closure_subset_iff.mpr Set.inter_subset_left
      · intro z hzK
        by_contra hzNot
        have hOpenCompl : IsOpen (closure (K ∩ W))ᶜ := isClosed_closure.isOpen_compl
        rcases hIrrK.2 (closure (K ∩ W))ᶜ W hOpenCompl hOpenW ⟨z, hzK, hzNot⟩ hNe with ⟨w, hwK, hwCompl, hwW⟩
        exact hwCompl (subset_closure ⟨hwK, hwW⟩)
    have hPartA : ∀ K ∈ irreducibleComponents X,
        IsClosed K ∧ IsIrreducible K ∧ x₀ ∈ K ∧ (∃ y ∈ K, y ≠ x₀) ∧
        (∀ (W : Set X), IsOpen W → x₀ ∈ W →
          ∀ K' ∈ irreducibleComponents X, K ≠ K' → ¬(K ∩ W ⊆ K' ∩ W)) := by
      intro K hK
      have hClK : IsClosed K := isClosed_of_mem_irreducibleComponents K hK
      have hx₀_K : x₀ ∈ K := hx₀_all K hK
      have hNontriv : ∃ y ∈ K, y ≠ x₀ := by
        by_contra hNo
        obtain ⟨K', hK', hK'_ne⟩ := hExistsOther K hK
        have hSubK' : K ⊆ K' := fun y hy => by
          have hy_eq : y = x₀ := by
            by_contra hy_ne
            exact hNo ⟨y, hy, hy_ne⟩
          rw [hy_eq]
          exact hx₀_all K' hK'
        exact hK'_ne (Set.Subset.antisymm (hK.2 hK'.1 hSubK') hSubK')
      refine ⟨hClK, hK.1, hx₀_K, hNontriv, ?_⟩
      intro W hOpenW hx₀W K' hK' hne hSubW
      have hClK' : IsClosed K' := isClosed_of_mem_irreducibleComponents K' hK'
      have hEqClK := hClosureInter K hClK hK.1 W hOpenW ⟨x₀, hx₀_K, hx₀W⟩
      have hEqClK' := hClosureInter K' hClK' hK'.1 W hOpenW ⟨x₀, hx₀_all K' hK', hx₀W⟩
      have hKK' : K ⊆ K' := by
        rw [← hEqClK, ← hEqClK']
        exact closure_mono hSubW
      exact hne (Set.Subset.antisymm hKK' (hK.2 hK'.1 hKK'))
    refine ⟨hPartA, fun hNo3 => ?_⟩
    let K₁ : Set X := irreducibleComponent x₀
    have hK₁ : K₁ ∈ irreducibleComponents X := irreducibleComponent_mem_irreducibleComponents x₀
    obtain ⟨K₂, hK₂, hK₂_ne⟩ := hExistsOther K₁ hK₁
    have hK₁_ne_K₂ : K₁ ≠ K₂ := Ne.symm hK₂_ne
    obtain ⟨hCl₁, hIrr₁, hx₀_1, hNontriv₁, _⟩ := hPartA K₁ hK₁
    obtain ⟨hCl₂, hIrr₂, hx₀_2, hNontriv₂, _⟩ := hPartA K₂ hK₂
    have hUnion12 : K₁ ∪ K₂ = Set.univ := by
      ext x
      simp only [Set.mem_union, Set.mem_univ, iff_true]
      let Kx := irreducibleComponent x
      have hKx : Kx ∈ irreducibleComponents X := irreducibleComponent_mem_irreducibleComponents x
      have hxKx : x ∈ Kx := mem_irreducibleComponent
      by_cases hx1 : Kx = K₁
      · exact Or.inl (hx1 ▸ hxKx)
      · by_cases hx2 : Kx = K₂
        · exact Or.inr (hx2 ▸ hxKx)
        · exfalso
          exact hNo3 ⟨K₁, K₂, Kx, hK₁, hK₂, hKx, hK₁_ne_K₂, Ne.symm hx1, Ne.symm hx2⟩
    have hInter12 : K₁ ∩ K₂ = {x₀} := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_singleton_iff]
      constructor
      · rintro ⟨hy1, hy2⟩
        by_contra hy_ne
        exact hK₁_ne_K₂ (hUniqAway y hy_ne K₁ K₂ hK₁ hK₂ hy1 hy2)
      · rintro rfl
        exact ⟨hx₀_1, hx₀_2⟩
    exact ⟨K₁, K₂, hK₁, hK₂, hK₁_ne_K₂, hCl₁, hIrr₁, hCl₂, hIrr₂,
      hUnion12, hInter12, hNontriv₁, hNontriv₂⟩

  
  have hSmooth1D : ∀ (y : C_L.left),
      (AlgebraicGeometry.SmoothOfRelativeDimension 1 C_L.hom ∨
        ∃ V : C_L.left.Opens, y ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ C_L.hom)) →
      IsDomain ↑(C_L.left.presheaf.stalk y) ∧
      ∀ (K₁ K₂ : Set C_L.left),
        K₁ ∈ irreducibleComponents ↥C_L.left →
        K₂ ∈ irreducibleComponents ↥C_L.left →
        y ∈ K₁ → y ∈ K₂ → K₁ = K₂ := by
    intro y hSm
    have hSmOpen : ∃ V : C_L.left.Opens, y ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ C_L.hom) := by
      rcases hSm with hAll | hEx
      · refine ⟨⊤, trivial, ?_⟩
        have : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_L.hom := hAll
        have : AlgebraicGeometry.SmoothOfRelativeDimension 0 (⊤ : C_L.left.Opens).ι := inferInstance
        simpa using (inferInstance : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) ((⊤ : C_L.left.Opens).ι ≫ C_L.hom))
      · exact hEx
    have hDomStalk : IsDomain ↑(C_L.left.presheaf.stalk y) := by
      rcases hSmOpen with ⟨V, hyV, hSmV⟩
      let f := V.ι ≫ C_L.hom
      obtain ⟨U_k, _, V₀, hAffV₀, hy₀, he, hStd⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 f).mp hSmV ⟨y, hyV⟩
      have hUk_top : U_k = ⊤ := by
        rw [eq_top_iff]
        intro z _
        have hz_eq : z = f.base ⟨y, hyV⟩ := Subsingleton.elim z _
        rw [hz_eq]
        exact he hy₀
      let iso_k_Uk : CommRingCat.of k ≅ (AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U_k) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm ≪≫
          (AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.mapIso (eqToIso (congrArg Opposite.op hUk_top.symm))
      let e_k : k ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U_k)) :=
        iso_k_Uk.commRingCatIsoToRingEquiv
      let B : Type u := ↑(V.toScheme.presheaf.obj (Opposite.op V₀))
      let f₀ : k →+* B := (f.appLE U_k V₀ he).hom.comp e_k.toRingHom
      have hStd₀ : RingHom.IsStandardSmoothOfRelativeDimension 1 f₀ :=
        (RingHom.isStandardSmoothOfRelativeDimension_respectsIso (n := 1)).2
          (f.appLE U_k V₀ he).hom e_k hStd
      obtain ⟨g, _, hg_et⟩ := hStd₀.exists_etale_mvPolynomial
      let e_poly : Polynomial k ≃+* MvPolynomial (Fin 1) k :=
        ((MvPolynomial.finSuccEquiv k 0).trans
          (Polynomial.mapAlgEquiv (MvPolynomial.isEmptyAlgEquiv k (Fin 0)))).symm.toRingEquiv
      let ψ : Polynomial k →+* B := g.comp e_poly.toRingHom
      have hψ_et : ψ.Etale := RingHom.Etale.respectsIso.2 g e_poly hg_et
      let q₀ : Ideal B := (hAffV₀.primeIdealOf ⟨⟨y, hyV⟩, hy₀⟩).asIdeal
      have : IsDomain (Localization.AtPrime q₀) := hDVR1D B ψ hψ_et q₀
      let : Algebra B ↑(V.toScheme.presheaf.stalk ⟨y, hyV⟩) :=
        (V.toScheme.presheaf.germ V₀ ⟨y, hyV⟩ hy₀).hom.toAlgebra
      have : IsLocalization.AtPrime ↑(V.toScheme.presheaf.stalk ⟨y, hyV⟩) q₀ :=
        hAffV₀.isLocalization_stalk ⟨⟨y, hyV⟩, hy₀⟩
      let e_loc : ↑(V.toScheme.presheaf.stalk ⟨y, hyV⟩) ≃+* Localization.AtPrime q₀ :=
        (IsLocalization.algEquiv q₀.primeCompl
          ↑(V.toScheme.presheaf.stalk ⟨y, hyV⟩) (Localization.AtPrime q₀)).toRingEquiv
      let e_stalk : ↑(V.toScheme.presheaf.stalk ⟨y, hyV⟩) ≃+* ↑(C_L.left.presheaf.stalk y) :=
        (V.stalkIso ⟨y, hyV⟩).commRingCatIsoToRingEquiv
      exact Function.Injective.isDomain (e_stalk.symm.trans e_loc).toRingHom
        (e_stalk.symm.trans e_loc).injective
    refine ⟨hDomStalk, ?_⟩
    obtain ⟨W, hAffW, hyW, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    let q_y := (hAffW.primeIdealOf ⟨y, hyW⟩).asIdeal
    let : Algebra ↑(C_L.left.presheaf.obj (Opposite.op W)) ↑(C_L.left.presheaf.stalk y) :=
      (C_L.left.presheaf.germ W y hyW).hom.toAlgebra
    have : IsLocalization.AtPrime ↑(C_L.left.presheaf.stalk y) q_y :=
      hAffW.isLocalization_stalk ⟨y, hyW⟩
    let e_W : Localization.AtPrime q_y ≃+* ↑(C_L.left.presheaf.stalk y) :=
      (IsLocalization.algEquiv q_y.primeCompl
        (Localization.AtPrime q_y) ↑(C_L.left.presheaf.stalk y)).toRingEquiv
    have : IsDomain (Localization.AtPrime q_y) :=
      Function.Injective.isDomain e_W.toRingHom e_W.injective
    let p₀ := RingHom.ker (algebraMap ↑(C_L.left.presheaf.obj (Opposite.op W)) (Localization.AtPrime q_y))
    have hp₀_prime : p₀.IsPrime := RingHom.ker_isPrime _
    let Z₀ : Set ↥(AlgebraicGeometry.Spec (C_L.left.presheaf.obj (Opposite.op W))) :=
      PrimeSpectrum.zeroLocus (p₀ : Set _)
    have hZ₀_irr : IsIrreducible Z₀ := by
      change IsIrreducible (PrimeSpectrum.zeroLocus (p₀ : Set ↑(C_L.left.presheaf.obj (Opposite.op W))))
      rw [PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime,
        PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical, hp₀_prime.radical]
      exact hp₀_prime
    let M₀ : Set C_L.left := closure (hAffW.fromSpec.base '' Z₀)
    have hM₀_irr : IsIrreducible M₀ :=
      (hZ₀_irr.image _ hAffW.fromSpec.base.hom.continuous.continuousOn).closure
    have hEqM₀ : ∀ K ∈ irreducibleComponents ↥C_L.left, y ∈ K → K = M₀ := by
      intro K hK hyK
      have hClK : IsClosed K := isClosed_of_mem_irreducibleComponents K hK
      have hKW_eq : closure (K ∩ (W : Set C_L.left)) = K := by
        apply Set.Subset.antisymm
        · exact hClK.closure_subset_iff.mpr Set.inter_subset_left
        · intro z hzK
          by_contra hzNot
          rcases hK.1.2 (closure (K ∩ (W : Set C_L.left)))ᶜ (W : Set C_L.left)
            isClosed_closure.isOpen_compl W.isOpen ⟨z, hzK, hzNot⟩ ⟨y, hyK, hyW⟩ with ⟨w, hwK, hwCompl, hwW⟩
          exact hwCompl (subset_closure ⟨hwK, hwW⟩)
      let S : Set ↥(AlgebraicGeometry.Spec (C_L.left.presheaf.obj (Opposite.op W))) :=
        hAffW.fromSpec.base ⁻¹' K
      have hClS : IsClosed S := hClK.preimage hAffW.fromSpec.base.hom.continuous
      have hImgS : hAffW.fromSpec.base '' S = K ∩ (W : Set C_L.left) := by
        rw [Set.image_preimage_eq_inter_range, hAffW.range_fromSpec]
      have hy_mem_S : hAffW.primeIdealOf ⟨y, hyW⟩ ∈ S := by
        change hAffW.fromSpec.base (hAffW.primeIdealOf ⟨y, hyW⟩) ∈ K
        rw [IsAffineOpen.fromSpec_primeIdealOf]
        exact hyK
      have hOpenEmb := hAffW.fromSpec.isOpenEmbedding
      have hIrrS : IsIrreducible S := by
        refine ⟨⟨hAffW.primeIdealOf ⟨y, hyW⟩, hy_mem_S⟩, ?_⟩
        intro U₁ U₂ hU₁ hU₂ ⟨x₁, hx₁S, hx₁U₁⟩ ⟨x₂, hx₂S, hx₂U₂⟩
        rcases hK.1.2 (hAffW.fromSpec.base '' U₁) (hAffW.fromSpec.base '' U₂)
          (hOpenEmb.isOpenMap U₁ hU₁) (hOpenEmb.isOpenMap U₂ hU₂)
          ⟨hAffW.fromSpec.base x₁, hx₁S, x₁, hx₁U₁, rfl⟩
          ⟨hAffW.fromSpec.base x₂, hx₂S, x₂, hx₂U₂, rfl⟩ with
          ⟨w, hwK, ⟨u₁, hu₁, rfl⟩, ⟨u₂, hu₂, hu_eq⟩⟩
        have hu12 : u₁ = u₂ := hOpenEmb.injective hu_eq.symm
        exact ⟨u₁, hwK, hu₁, hu12 ▸ hu₂⟩
      let p_K := PrimeSpectrum.vanishingIdeal S
      have hpK_prime : p_K.IsPrime := by
        change (PrimeSpectrum.vanishingIdeal S).IsPrime
        exact PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp hIrrS
      have hpK_le_qy : p_K ≤ q_y := fun a ha =>
        (PrimeSpectrum.mem_vanishingIdeal S a).mp ha _ hy_mem_S
      have hp₀_le_pK : p₀ ≤ p_K := by
        intro b hb
        rw [RingHom.mem_ker, IsLocalization.map_eq_zero_iff q_y.primeCompl] at hb
        rcases hb with ⟨m, hmb⟩
        have hmem : m.1 * b ∈ p_K := hmb.symm ▸ p_K.zero_mem
        rcases hpK_prime.mem_or_mem hmem with hm | hb_pK
        · exact False.elim (m.2 (hpK_le_qy hm))
        · exact hb_pK
      have hS_sub_Z₀ : S ⊆ Z₀ := by
        have hS_eq : PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal S : Set ↑(C_L.left.presheaf.obj (Opposite.op W))) = S :=
          (PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure S).trans hClS.closure_eq
        change S ⊆ PrimeSpectrum.zeroLocus (p₀ : Set ↑(C_L.left.presheaf.obj (Opposite.op W)))
        rw [← hS_eq]
        exact PrimeSpectrum.zeroLocus_anti_mono hp₀_le_pK
      have hK_sub_M₀ : K ⊆ M₀ := by
        rw [← hKW_eq, ← hImgS]
        exact closure_mono (Set.image_mono hS_sub_Z₀)
      exact Set.Subset.antisymm hK_sub_M₀ (hK.2 hM₀_irr hK_sub_M₀)
    intro K₁ K₂ hK₁ hK₂ hy1 hy2
    exact (hEqM₀ K₁ hK₁ hy1).trans (hEqM₀ K₂ hK₂ hy2).symm

  
  have hVanSub : ∀ (z₀ : Z_bar.left), IsClosed ({z₀} : Set Z_bar.left) →
      ∀ (Z_r : Set Z_bar.left), IsClosed Z_r → IsIrreducible Z_r →
        z₀ ∈ Z_r → (∃ z₁ ∈ Z_r, z₁ ≠ z₀) →
        ∃ (C_r : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (ι_r : C_r ⟶ Z_bar),
          (AlgebraicGeometry.IsIntegral C_r.left ∧
            AlgebraicGeometry.IsProper C_r.hom ∧
            AlgebraicGeometry.IsClosedImmersion ι_r.left ∧
            Set.range ι_r.left.base = Z_r ∧
            1 ≤ topologicalKrullDim C_r.left) ∧
          (∀ (U : Z_bar.left.Opens) (hAffU : AlgebraicGeometry.IsAffineOpen U),
            let A_U : Type u := ↑(Z_bar.left.presheaf.obj (Opposite.op U))
            let P_r : Ideal A_U := RingHom.ker (ι_r.left.app U).hom
            Function.Surjective (ι_r.left.app U).hom ∧
            P_r = PrimeSpectrum.vanishingIdeal (hAffU.fromSpec.base ⁻¹' Z_r) ∧
            (∀ (q : Ideal A_U) [q.IsPrime],
              P_r ≤ q ↔ hAffU.fromSpec.base ⟨q, ‹_›⟩ ∈ Z_r) ∧
            (∀ (hz₀ : z₀ ∈ U),
              let p_z₀ : Ideal A_U := (hAffU.primeIdealOf ⟨z₀, hz₀⟩).asIdeal
              p_z₀.IsMaximal ∧ P_r.IsPrime ∧ P_r < p_z₀)) ∧
          (∀ (U V : Z_bar.left.Opens)
            (_hAffU : AlgebraicGeometry.IsAffineOpen U)
            (_hAffV : AlgebraicGeometry.IsAffineOpen V)
            (hz₀_U : z₀ ∈ U) (hz₀_V : z₀ ∈ V),
            Ideal.map (Z_bar.left.presheaf.germ U z₀ hz₀_U).hom (RingHom.ker (ι_r.left.app U).hom) =
              Ideal.map (Z_bar.left.presheaf.germ V z₀ hz₀_V).hom (RingHom.ker (ι_r.left.app V).hom)) := by
    intro z₀ hz₀_cl Z_r hCl hIrr hz₀_mem hNontriv
    let I_r : Z_bar.left.IdealSheafData :=
      AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨Z_r, hCl⟩
    let C_r : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (I_r.subschemeι ≫ Z_bar.hom)
    let ι_r : C_r ⟶ Z_bar := CategoryTheory.Over.homMk I_r.subschemeι rfl
    have hRange : Set.range I_r.subschemeι.base = Z_r :=
      I_r.range_subschemeι.trans
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal ⟨Z_r, hCl⟩)
    have hClEmb := I_r.subschemeι.isClosedEmbedding
    have hRed_stalk : ∀ x : ↥I_r.subscheme, _root_.IsReduced ↑(I_r.subscheme.presheaf.stalk x) := by
      intro x
      obtain ⟨U, hAffU, hxU, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := I_r.subschemeι.base x) (U := ⊤) trivial
      let V : I_r.subscheme.Opens := (TopologicalSpace.Opens.map I_r.subschemeι.base).obj U
      have hxV : x ∈ V := hxU
      have hAffV : AlgebraicGeometry.IsAffineOpen V :=
        AlgebraicGeometry.IsAffineHom.isAffine_preimage U hAffU
      have hRad : (I_r.ideal ⟨U, hAffU⟩).IsRadical := by
        rw [AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal]
        exact PrimeSpectrum.isRadical_vanishingIdeal _
      have : _root_.IsReduced (↑(Z_bar.left.presheaf.obj (Opposite.op U)) ⧸ I_r.ideal ⟨U, hAffU⟩) :=
        (Ideal.isRadical_iff_quotient_reduced _).mp hRad
      let e_obj := (I_r.subschemeObjIso ⟨U, hAffU⟩).commRingCatIsoToRingEquiv
      have : _root_.IsReduced ↑(I_r.subscheme.presheaf.obj (Opposite.op V)) := by
        refine ⟨fun b ⟨n, hbn⟩ => e_obj.injective ?_⟩
        rw [map_zero]
        exact eq_zero_of_pow_eq_zero (n := n) (by rw [← map_pow, hbn, map_zero])
      let q_x := (hAffV.primeIdealOf ⟨x, hxV⟩).asIdeal
      let : Algebra ↑(I_r.subscheme.presheaf.obj (Opposite.op V)) ↑(I_r.subscheme.presheaf.stalk x) :=
        (I_r.subscheme.presheaf.germ V x hxV).hom.toAlgebra
      have : IsLocalization.AtPrime ↑(I_r.subscheme.presheaf.stalk x) q_x :=
        hAffV.isLocalization_stalk ⟨x, hxV⟩
      refine ⟨fun z ⟨n, hzn⟩ => ?_⟩
      obtain ⟨⟨b, m⟩, hzm⟩ := IsLocalization.surj q_x.primeCompl z
      have hbn0 : algebraMap ↑(I_r.subscheme.presheaf.obj (Opposite.op V))
          ↑(I_r.subscheme.presheaf.stalk x) (b ^ n) = 0 := by
        rw [map_pow, ← hzm, mul_pow, hzn, zero_mul]
      obtain ⟨c, hcbn⟩ := (IsLocalization.map_eq_zero_iff q_x.primeCompl _ _).mp hbn0
      have hcb_pow : (c.1 * b) ^ (n + 1) = 0 := by
        calc (c.1 * b) ^ (n + 1)
          _ = c.1 ^ n * b * (c.1 * b ^ n) := by ring
          _ = 0 := by rw [hcbn, mul_zero]
      have hcb0 : c.1 * b = 0 := eq_zero_of_pow_eq_zero hcb_pow
      have hz_unit0 : z * algebraMap _ _ (c * m).1 = 0 := by
        calc z * algebraMap _ _ (c.1 * m.1)
          _ = algebraMap _ _ c.1 * (z * algebraMap _ _ m.1) := by rw [map_mul]; ring
          _ = algebraMap _ _ (c.1 * b) := by rw [hzm, map_mul]
          _ = 0 := by rw [hcb0, map_zero]
      have hu : IsUnit (algebraMap ↑(I_r.subscheme.presheaf.obj (Opposite.op V))
          ↑(I_r.subscheme.presheaf.stalk x) (c * m).1) :=
        IsLocalization.map_units _ (c * m)
      exact (hu.mul_left_eq_zero).mp hz_unit0
    have hRed : AlgebraicGeometry.IsReduced C_r.left :=
      @AlgebraicGeometry.isReduced_of_isReduced_stalk I_r.subscheme hRed_stalk
    obtain ⟨c₀, hc₀⟩ : ∃ c₀ : C_r.left, I_r.subschemeι.base c₀ = z₀ :=
      Set.mem_range.mp (hRange.symm ▸ hz₀_mem)
    obtain ⟨z₁, hz₁_mem, hz₁_ne⟩ := hNontriv
    obtain ⟨c₁, hc₁⟩ : ∃ c₁ : C_r.left, I_r.subschemeι.base c₁ = z₁ :=
      Set.mem_range.mp (hRange.symm ▸ hz₁_mem)
    have hc₁_ne : c₁ ≠ c₀ := fun hEq => hz₁_ne (hc₁.symm.trans ((congrArg I_r.subschemeι.base hEq).trans hc₀))
    have hIrredSpace : IrreducibleSpace ↥C_r.left := by
      refine { isPreirreducible_univ := ?_, toNonempty := ⟨c₀⟩ }
      intro V₁ V₂ hV₁ hV₂ ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩
      obtain ⟨W₁, hW₁, rfl⟩ := hClEmb.isEmbedding.isInducing.isOpen_iff.mp hV₁
      obtain ⟨W₂, hW₂, rfl⟩ := hClEmb.isEmbedding.isInducing.isOpen_iff.mp hV₂
      have hx₁Z : I_r.subschemeι.base x₁ ∈ Z_r := hRange ▸ ⟨x₁, rfl⟩
      have hx₂Z : I_r.subschemeι.base x₂ ∈ Z_r := hRange ▸ ⟨x₂, rfl⟩
      obtain ⟨w, hwZ, hw₁, hw₂⟩ := hIrr.2 W₁ W₂ hW₁ hW₂
        ⟨I_r.subschemeι.base x₁, hx₁Z, hx₁⟩ ⟨I_r.subschemeι.base x₂, hx₂Z, hx₂⟩
      obtain ⟨x_w, rfl⟩ : ∃ x_w : C_r.left, I_r.subschemeι.base x_w = w :=
        Set.mem_range.mp (hRange.symm ▸ hwZ)
      exact ⟨x_w, trivial, hw₁, hw₂⟩
    have hIntC : AlgebraicGeometry.IsIntegral C_r.left :=
      @AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced C_r.left hRed hIrredSpace
    have hc₀_cl : IsClosed ({c₀} : Set C_r.left) := by
      have hpre : I_r.subschemeι.base ⁻¹' ({z₀} : Set Z_bar.left) = {c₀} := by
        ext x
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        exact ⟨fun hx => hClEmb.injective (hx.trans hc₀.symm), fun hx => hx ▸ hc₀⟩
      rw [← hpre]
      exact hz₀_cl.preimage I_r.subschemeι.base.hom.continuous
    have hDim : 1 ≤ topologicalKrullDim C_r.left := by
      let s₀ : TopologicalSpace.IrreducibleCloseds ↥C_r.left :=
        ⟨{c₀}, isIrreducible_singleton, hc₀_cl⟩
      let s₁ : TopologicalSpace.IrreducibleCloseds ↥C_r.left :=
        ⟨Set.univ, @IrreducibleSpace.isIrreducible_univ ↥C_r.left _ hIrredSpace, isClosed_univ⟩
      have hs_lt : s₀ < s₁ := by
        rw [lt_iff_le_not_ge]
        refine ⟨Set.subset_univ _, fun hge => hc₁_ne ?_⟩
        exact Set.mem_singleton_iff.mp (hge (Set.mem_univ c₁))
      let p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥C_r.left) :=
        { length := 1
          toFun := ![s₀, s₁]
          step := fun i => by
            fin_cases i
            exact hs_lt }
      exact Order.LTSeries.length_le_krullDim p
    have hPropC : AlgebraicGeometry.IsProper C_r.hom :=
      (inferInstance : AlgebraicGeometry.IsProper (I_r.subschemeι ≫ Z_bar.hom))
    have hClC : AlgebraicGeometry.IsClosedImmersion ι_r.left :=
      (inferInstance : AlgebraicGeometry.IsClosedImmersion I_r.subschemeι)
    refine ⟨C_r, ι_r, ⟨hIntC, hPropC, hClC, hRange, hDim⟩, ?_, ?_⟩
    · intro U hAffU
      let A_U : Type u := ↑(Z_bar.left.presheaf.obj (Opposite.op U))
      have hSurj : Function.Surjective (ι_r.left.app U).hom :=
        (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hClC).2 U hAffU
      have hKer : RingHom.ker (ι_r.left.app U).hom =
          PrimeSpectrum.vanishingIdeal (hAffU.fromSpec.base ⁻¹' Z_r) :=
        (I_r.ker_subschemeι_app ⟨U, hAffU⟩).trans
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal ⟨Z_r, hCl⟩ ⟨U, hAffU⟩)
      have hCl_pre : IsClosed (hAffU.fromSpec.base ⁻¹' Z_r) :=
        hCl.preimage hAffU.fromSpec.base.hom.continuous
      have hMem_iff : ∀ (q : Ideal A_U) [q.IsPrime],
          RingHom.ker (ι_r.left.app U).hom ≤ q ↔ hAffU.fromSpec.base ⟨q, ‹_›⟩ ∈ Z_r := by
        intro q hq
        rw [hKer]
        have hZL : PrimeSpectrum.zeroLocus
            (PrimeSpectrum.vanishingIdeal (hAffU.fromSpec.base ⁻¹' Z_r) : Set A_U) =
            hAffU.fromSpec.base ⁻¹' Z_r :=
          (PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure _).trans hCl_pre.closure_eq
        have h1 : (⟨q, hq⟩ : PrimeSpectrum A_U) ∈
            PrimeSpectrum.zeroLocus
              (PrimeSpectrum.vanishingIdeal (hAffU.fromSpec.base ⁻¹' Z_r) : Set A_U) ↔
            hAffU.fromSpec.base ⟨q, hq⟩ ∈ Z_r := by
          rw [hZL]
          rfl
        exact h1
      refine ⟨hSurj, hKer, hMem_iff, ?_⟩
      intro hz₀
      let pt₀ := hAffU.primeIdealOf ⟨z₀, hz₀⟩
      have hpt₀_cl : IsClosed ({pt₀} : Set ↥(AlgebraicGeometry.Spec (Z_bar.left.presheaf.obj (Opposite.op U)))) := by
        have hpre₀ : hAffU.fromSpec.base ⁻¹' ({z₀} : Set Z_bar.left) = {pt₀} := by
          ext x
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          refine ⟨fun hx => hAffU.fromSpec.isOpenEmbedding.injective ?_, fun hx => ?_⟩
          · rw [hx]
            exact (IsAffineOpen.fromSpec_primeIdealOf hAffU ⟨z₀, hz₀⟩).symm
          · rw [hx]
            exact IsAffineOpen.fromSpec_primeIdealOf hAffU ⟨z₀, hz₀⟩
        rw [← hpre₀]
        exact hz₀_cl.preimage hAffU.fromSpec.base.hom.continuous
      have hpz₀_max : pt₀.asIdeal.IsMaximal :=
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal pt₀).mp hpt₀_cl
      have hpt₀_mem : pt₀ ∈ hAffU.fromSpec.base ⁻¹' Z_r := by
        change hAffU.fromSpec.base pt₀ ∈ Z_r
        rw [IsAffineOpen.fromSpec_primeIdealOf]
        exact hz₀_mem
      have hOpenEmb := hAffU.fromSpec.isOpenEmbedding
      have hIrr_pre : IsIrreducible (hAffU.fromSpec.base ⁻¹' Z_r) := by
        refine ⟨⟨pt₀, hpt₀_mem⟩, ?_⟩
        intro U₁ U₂ hU₁ hU₂ ⟨x₁, hx₁S, hx₁U₁⟩ ⟨x₂, hx₂S, hx₂U₂⟩
        rcases hIrr.2 (hAffU.fromSpec.base '' U₁) (hAffU.fromSpec.base '' U₂)
          (hOpenEmb.isOpenMap U₁ hU₁) (hOpenEmb.isOpenMap U₂ hU₂)
          ⟨hAffU.fromSpec.base x₁, hx₁S, x₁, hx₁U₁, rfl⟩
          ⟨hAffU.fromSpec.base x₂, hx₂S, x₂, hx₂U₂, rfl⟩ with
          ⟨w, hwZ, ⟨u₁, hu₁, rfl⟩, ⟨u₂, hu₂, hu_eq⟩⟩
        have hu12 : u₁ = u₂ := hOpenEmb.injective hu_eq.symm
        exact ⟨u₁, hwZ, hu₁, hu12 ▸ hu₂⟩
      have hPr_prime : (RingHom.ker (ι_r.left.app U).hom).IsPrime := by
        rw [hKer]
        exact PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp hIrr_pre
      have hPr_le : RingHom.ker (ι_r.left.app U).hom ≤ pt₀.asIdeal :=
        (@hMem_iff pt₀.asIdeal pt₀.isPrime).mpr hpt₀_mem
      have hPr_lt : RingHom.ker (ι_r.left.app U).hom < pt₀.asIdeal := by
        refine lt_of_le_of_ne hPr_le fun hEq => hz₁_ne ?_
        have hZU_sub : Z_r ∩ (U : Set Z_bar.left) ⊆ {z₀} := by
          rintro y ⟨hyZ, hyU⟩
          let pt_y := hAffU.primeIdealOf ⟨y, hyU⟩
          have hy_from : hAffU.fromSpec.base pt_y = y :=
            IsAffineOpen.fromSpec_primeIdealOf hAffU ⟨y, hyU⟩
          have hle_y : pt₀.asIdeal ≤ pt_y.asIdeal := by
            rw [← hEq]
            exact (@hMem_iff pt_y.asIdeal pt_y.isPrime).mpr (hy_from.symm ▸ hyZ)
          have hEq_ideal : pt₀.asIdeal = pt_y.asIdeal :=
            hpz₀_max.eq_of_le pt_y.isPrime.ne_top hle_y
          have hEq_pt : pt₀ = pt_y := PrimeSpectrum.ext hEq_ideal
          rw [Set.mem_singleton_iff, ← hy_from, ← hEq_pt]
          exact IsAffineOpen.fromSpec_primeIdealOf hAffU ⟨z₀, hz₀⟩
        have hZ_sub_cl : Z_r ⊆ closure (Z_r ∩ (U : Set Z_bar.left)) := by
          intro w hwZ
          by_contra hwNot
          rcases hIrr.2 (closure (Z_r ∩ (U : Set Z_bar.left)))ᶜ (U : Set Z_bar.left)
            isClosed_closure.isOpen_compl U.isOpen ⟨w, hwZ, hwNot⟩ ⟨z₀, hz₀_mem, hz₀⟩ with
            ⟨y, hyZ, hyCompl, hyU⟩
          exact hyCompl (subset_closure ⟨hyZ, hyU⟩)
        have hz₁_in : z₁ ∈ closure ({z₀} : Set Z_bar.left) :=
          closure_mono hZU_sub (hZ_sub_cl hz₁_mem)
        rwa [hz₀_cl.closure_eq, Set.mem_singleton_iff] at hz₁_in
      exact ⟨hpz₀_max, hPr_prime, hPr_lt⟩
    · intro U V hAffU hAffV hz₀_U hz₀_V
      obtain ⟨g_U, g_V, h_open, hz₀_W⟩ :=
        AlgebraicGeometry.exists_basicOpen_le_affine_inter hAffU hAffV z₀ ⟨hz₀_U, hz₀_V⟩
      let W : Z_bar.left.Opens := Z_bar.left.basicOpen g_U
      have hAffW : AlgebraicGeometry.IsAffineOpen W := hAffU.basicOpen g_U
      have hWU : (⟨W, hAffW⟩ : Z_bar.left.affineOpens) ≤ ⟨U, hAffU⟩ := Z_bar.left.basicOpen_le g_U
      have hWV : (⟨W, hAffW⟩ : Z_bar.left.affineOpens) ≤ ⟨V, hAffV⟩ := by
        show W ≤ V
        change Z_bar.left.basicOpen g_U ≤ V
        rw [h_open]
        exact Z_bar.left.basicOpen_le g_V
      have hKerU : RingHom.ker (ι_r.left.app U).hom = I_r.ideal ⟨U, hAffU⟩ :=
        I_r.ker_subschemeι_app ⟨U, hAffU⟩
      have hKerV : RingHom.ker (ι_r.left.app V).hom = I_r.ideal ⟨V, hAffV⟩ :=
        I_r.ker_subschemeι_app ⟨V, hAffV⟩
      have hGermU : (Z_bar.left.presheaf.germ W z₀ hz₀_W).hom.comp
          (Z_bar.left.presheaf.map (CategoryTheory.homOfLE hWU).op).hom =
          (Z_bar.left.presheaf.germ U z₀ hz₀_U).hom :=
        congrArg CommRingCat.Hom.hom (Z_bar.left.presheaf.germ_res (CategoryTheory.homOfLE hWU) z₀ hz₀_W)
      have hGermV : (Z_bar.left.presheaf.germ W z₀ hz₀_W).hom.comp
          (Z_bar.left.presheaf.map (CategoryTheory.homOfLE hWV).op).hom =
          (Z_bar.left.presheaf.germ V z₀ hz₀_V).hom :=
        congrArg CommRingCat.Hom.hom (Z_bar.left.presheaf.germ_res (CategoryTheory.homOfLE hWV) z₀ hz₀_W)
      rw [hKerU, hKerV, ← hGermU, ← hGermV, ← Ideal.map_map, ← Ideal.map_map,
        I_r.map_ideal hWU, I_r.map_ideal hWV]

  
  have hLocAtPrimeQuot : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (π : A →+* B), Function.Surjective π →
      ∀ (ℓ : A), RingHom.ker π = Ideal.span {ℓ} →
      ∀ (q_B : Ideal B) [q_B.IsPrime] (q_A : Ideal A) [q_A.IsPrime],
        q_B.comap π = q_A →
        Nonempty ((Localization.AtPrime q_A ⧸
          Ideal.span {algebraMap A (Localization.AtPrime q_A) ℓ}) ≃+*
          Localization.AtPrime q_B) := by
    intro A B _ _ π hSurj ℓ hKer q_B _ q_A _ hq
    let R_A := Localization.AtPrime q_A
    let R_B := Localization.AtPrime q_B
    let J_A : Ideal R_A := Ideal.span {algebraMap A R_A ℓ}
    have hUnitsA : ∀ m : q_A.primeCompl, IsUnit (((algebraMap B R_B).comp π) m.1) := by
      intro ⟨m, hm⟩
      have hmB : π m ∈ q_B.primeCompl := by
        change π m ∉ q_B
        rw [← Ideal.mem_comap, hq]
        exact hm
      exact IsLocalization.map_units R_B ⟨π m, hmB⟩
    let Φ₀ : R_A →+* R_B := IsLocalization.lift hUnitsA
    have hΦ₀_ker : J_A ≤ RingHom.ker Φ₀ := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
        IsLocalization.lift_eq hUnitsA ℓ, RingHom.comp_apply]
      have hℓ_ker : ℓ ∈ RingHom.ker π := by
        rw [hKer]
        exact Ideal.subset_span (Set.mem_singleton ℓ)
      rw [RingHom.mem_ker.mp hℓ_ker, map_zero]
    let Φ : (R_A ⧸ J_A) →+* R_B :=
      Ideal.Quotient.lift J_A Φ₀ (fun a ha => RingHom.mem_ker.mp (hΦ₀_ker ha))
    let toQuotA : A →+* (R_A ⧸ J_A) := (Ideal.Quotient.mk J_A).comp (algebraMap A R_A)
    have hKer_le : RingHom.ker π ≤ RingHom.ker toQuotA := by
      rw [hKer, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      change Ideal.Quotient.mk J_A (algebraMap A R_A ℓ) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
    let ψ_quot : (A ⧸ RingHom.ker π) →+* (R_A ⧸ J_A) :=
      Ideal.Quotient.lift (RingHom.ker π) toQuotA (fun a ha => RingHom.mem_ker.mp (hKer_le ha))
    let e_ker : (A ⧸ RingHom.ker π) ≃+* B := RingHom.quotientKerEquivOfSurjective hSurj
    let ψ_B : B →+* (R_A ⧸ J_A) := ψ_quot.comp e_ker.symm.toRingHom
    have hψ_B_pi : ∀ a : A, ψ_B (π a) = toQuotA a := by
      intro a
      have he : e_ker.symm (π a) = Ideal.Quotient.mk (RingHom.ker π) a :=
        e_ker.injective (by rw [e_ker.apply_symm_apply]; rfl)
      change ψ_quot (e_ker.symm (π a)) = toQuotA a
      rw [he]
      rfl
    have hUnitsB : ∀ s : q_B.primeCompl, IsUnit (ψ_B s.1) := by
      intro ⟨s, hs⟩
      obtain ⟨m, rfl⟩ := hSurj s
      have hmA : m ∈ q_A.primeCompl := by
        change m ∉ q_A
        rw [← hq]
        exact hs
      rw [hψ_B_pi m]
      exact (IsLocalization.map_units R_A ⟨m, hmA⟩).map (Ideal.Quotient.mk J_A)
    let Ψ : R_B →+* (R_A ⧸ J_A) := IsLocalization.lift hUnitsB
    have hΨΦ : Ψ.comp Φ = RingHom.id (R_A ⧸ J_A) := by
      apply Ideal.Quotient.ringHom_ext
      apply IsLocalization.ringHom_ext q_A.primeCompl
      ext a
      dsimp only [Φ, Φ₀, Ψ, RingHom.comp_apply, RingHom.id_apply]
      rw [Ideal.Quotient.lift_mk, IsLocalization.lift_eq, RingHom.comp_apply,
        IsLocalization.lift_eq, hψ_B_pi]
      rfl
    have hΦΨ : Φ.comp Ψ = RingHom.id R_B := by
      apply IsLocalization.ringHom_ext q_B.primeCompl
      ext b
      obtain ⟨a, rfl⟩ := hSurj b
      dsimp only [Φ, Φ₀, Ψ, toQuotA, RingHom.comp_apply, RingHom.id_apply]
      rw [IsLocalization.lift_eq, hψ_B_pi]
      dsimp only [toQuotA, RingHom.comp_apply]
      rw [Ideal.Quotient.lift_mk, IsLocalization.lift_eq, RingHom.comp_apply]
    exact ⟨
      { toFun := Φ
        invFun := Ψ
        left_inv := fun x => RingHom.congr_fun hΨΦ x
        right_inv := fun y => RingHom.congr_fun hΦΨ y
        map_mul' := Φ.map_mul
        map_add' := Φ.map_add }⟩

  have hProjBridge :
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      (TopologicalSpace.NoetherianSpace ↥C_L.left ∧
        ∀ x : AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k),
          ∃ μ : Fin (N + 1),
            x ∈ AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X μ)) ∧
      ∀ (H : MvPolynomial (Fin (N + 1)) k)
        (hH : H ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
        (U : Z_bar.left.Opens) (hAffU : AlgebraicGeometry.IsAffineOpen U)
        (hU_sub : U ≤ (TopologicalSpace.Opens.map ι₀.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) H)),
        let A_U : Type u := ↑(Z_bar.left.presheaf.obj (Opposite.op U))
        let τ_U : A_U :=
          (ι₀.left.appLE
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) H) U hU_sub).hom
            ((AlgebraicGeometry.Proj.awayToSection
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) H).hom
              (HomogeneousLocalization.Away.mk
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) hH 3 F_L hFL))
        (Nonempty ↥U → τ_U ≠ 0) ∧
        (∀ (q : Ideal A_U) [q.IsPrime],
          τ_U ∈ q ↔ hAffU.fromSpec.base ⟨q, ‹_›⟩ ∈ Set.range ι_CL.left.base) ∧
        (∀ (x_y : C_L.left) (hy : ι_CL.left.base x_y ∈ U),
          let q_y : Ideal A_U := (hAffU.primeIdealOf ⟨ι_CL.left.base x_y, hy⟩).asIdeal
          let R_y := Localization.AtPrime q_y
          Nonempty ((R_y ⧸ Ideal.span {algebraMap A_U R_y τ_U}) ≃+* ↑(C_L.left.presheaf.stalk x_y))) ∧
        (∀ (μ₀ : Fin (N + 1))
          (hXμ₀ : (MvPolynomial.X μ₀ : MvPolynomial (Fin (N + 1)) k) ∈
            MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
          (V_Z : Z_bar.left.Opens) (_hAffZ : AlgebraicGeometry.IsAffineOpen V_Z)
          (hVZ_μ₀ : V_Z ≤ (TopologicalSpace.Opens.map ι₀.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X μ₀)))
          (z₀ : Z_bar.left) (hz₀_U : z₀ ∈ U) (hz₀_Z : z₀ ∈ V_Z),
          let ℓ₀ : ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z)) :=
            (ι₀.left.appLE
              (AlgebraicGeometry.Proj.basicOpen
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X μ₀)) V_Z hVZ_μ₀).hom
              ((AlgebraicGeometry.Proj.awayToSection
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X μ₀)).hom
                (HomogeneousLocalization.Away.mk
                  (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) hXμ₀ 3 F_L hFL))
          ∃ u_stalk : Units ↑(Z_bar.left.presheaf.stalk z₀),
            (Z_bar.left.presheaf.germ U z₀ hz₀_U).hom τ_U =
              ↑u_stalk * (Z_bar.left.presheaf.germ V_Z z₀ hz₀_Z).hom ℓ₀) := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    obtain ⟨hCl_CL, hFL', hRange_CL, hKer_CL⟩ := hPull
    have hNoeth : TopologicalSpace.NoetherianSpace ↥C_L.left := by
      have : AlgebraicGeometry.IsClosedImmersion ι_CL.left := hCl_CL
      let g_CL : C_L.left ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) := ι_CL.left ≫ Z_bar.hom
      have : AlgebraicGeometry.IsProper g_CL := inferInstance
      have : CompactSpace ↥C_L.left :=
        AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace g_CL
      have : AlgebraicGeometry.IsLocallyNoetherian C_L.left :=
        AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian g_CL
      have : AlgebraicGeometry.IsNoetherian C_L.left := {}
      exact AlgebraicGeometry.IsNoetherian.noetherianSpace
    have hProjCover : ∀ x : AlgebraicGeometry.Proj 𝒜,
        ∃ μ : Fin (N + 1), x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X μ) := by
      intro x
      by_contra h
      apply x.not_irrelevant_le
      intro P hP
      rw [HomogeneousIdeal.mem_irrelevant_iff] at hP
      have hP0 : P.coeff 0 = 0 := by
        have hsplit : P = MvPolynomial.C (P.coeff 0) +
            ∑ d ∈ P.support.erase 0, MvPolynomial.monomial d (P.coeff d) := by
          conv_lhs => rw [P.as_sum]
          by_cases h0 : (0 : Fin (N + 1) →₀ ℕ) ∈ P.support
          · rw [← Finset.add_sum_erase _ _ h0, MvPolynomial.monomial_zero']
          · rw [Finset.erase_eq_of_notMem h0, MvPolynomial.notMem_support_iff.mp h0,
              map_zero, zero_add]
        have hproj_sum : GradedRing.proj 𝒜 0
            (∑ d ∈ P.support.erase 0, MvPolynomial.monomial d (P.coeff d)) = 0 := by
          rw [map_sum]
          refine Finset.sum_eq_zero fun d hd => ?_
          have hd_ne : d ≠ 0 := (Finset.mem_erase.mp hd).1
          have hdeg_ne : d.degree ≠ 0 := by
            intro hsum
            apply hd_ne
            ext i
            have hsum' : ∑ j ∈ d.support, d j = 0 := hsum
            rw [Finset.sum_eq_zero_iff] at hsum'
            by_cases hi : i ∈ d.support
            · exact hsum' i hi
            · exact Finsupp.notMem_support_iff.mp hi
          have hmem : MvPolynomial.monomial d (P.coeff d) ∈ 𝒜 d.degree :=
            MvPolynomial.isHomogeneous_monomial (P.coeff d) rfl
          rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_ne 𝒜 hmem hdeg_ne]
        have hC_mem : (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜 0 :=
          MvPolynomial.isHomogeneous_C _ _
        have hproj_C : GradedRing.proj 𝒜 0
            (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (N + 1)) k) =
            MvPolynomial.C (P.coeff 0) := by
          rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒜 hC_mem]
        have hP_eq : (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (N + 1)) k) = 0 := by
          calc (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (N + 1)) k)
            _ = GradedRing.proj 𝒜 0 (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (N + 1)) k) +
                GradedRing.proj 𝒜 0
                  (∑ d ∈ P.support.erase 0, MvPolynomial.monomial d (P.coeff d)) := by
              rw [hproj_C, hproj_sum, add_zero]
            _ = GradedRing.proj 𝒜 0 P := by rw [← map_add, ← hsplit]
            _ = 0 := hP
        simpa using congrArg MvPolynomial.constantCoeff hP_eq
      rw [P.as_sum]
      refine Ideal.sum_mem _ fun d hd => ?_
      have hd0 : d ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hd) hP0
      have ⟨μ, hμ⟩ : ∃ μ : Fin (N + 1), 0 < d μ := by
        by_contra hall
        apply hd0
        ext μ
        exact Nat.eq_zero_of_not_pos (fun hpos => hall ⟨μ, hpos⟩)
      have hX_mem : (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k) ∈
          x.asHomogeneousIdeal := by
        by_contra hnot
        exact h ⟨μ, (ProjectiveSpectrum.mem_basicOpen 𝒜 (MvPolynomial.X μ) x).mpr hnot⟩
      obtain ⟨r, hr⟩ : (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k) ∣
          MvPolynomial.monomial d (P.coeff d) := by
        refine ⟨MvPolynomial.monomial (d - Finsupp.single μ 1) (P.coeff d), ?_⟩
        rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, one_mul, add_tsub_cancel_of_le]
        intro i
        by_cases hi : i = μ
        · subst hi; simp; omega
        · simp [hi]
      rw [hr]
      exact x.asHomogeneousIdeal.toIdeal.mul_mem_right r hX_mem
    let f₀ : Z_bar.left ⟶ AlgebraicGeometry.Proj 𝒜 := ι₀.left
