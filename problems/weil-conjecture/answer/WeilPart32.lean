    rw [← MorphismProperty.isomorphisms.iff]
    rw [IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := MorphismProperty.isomorphisms Scheme) O hO_top]
    intro p
    rw [MorphismProperty.isomorphisms.iff]
    have hVp_le_U : V_p p ≤ U_axis := by
      rw [← hSup_Vp]
