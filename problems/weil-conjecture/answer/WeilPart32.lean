    have hK_W₁_ne : (K_comp l ∩ (W₁ : Set Γ₀.left)).Nonempty := by
      by_contra hemp
      rw [Set.not_nonempty_iff_eq_empty] at hemp
      have hsub : Y_K l ∩ weilProjHyperplaneSet k N H₁ = Y_K l := by
        ext p
        refine ⟨fun hp => hp.1, fun hp => ⟨hp, ?_⟩⟩
        rcases hp with ⟨⟨x, hx_K⟩, rfl⟩
        change ¬(x ∈ (W₁ : Set Γ₀.left))
        intro hx_W₁
        have hmem : x ∈ K_comp l ∩ (W₁ : Set Γ₀.left) := ⟨hx_K, hx_W₁⟩
        rw [hemp] at hmem
        exact hmem
      have hdim_le := hDim_YK_H₁ l
      rw [hsub, hDim_YK l] at hdim_le
      exact absurd hdim_le (by simp)
    have hK_W₂_ne : (K_comp l ∩ (W₂ : Set Γ₀.left)).Nonempty := ⟨y, hy_K, hy₂⟩
    have hK_WF_ne : (K_comp l ∩ (W_F : Set Γ₀.left)).Nonempty := ⟨y, hy_K, hyF⟩
    have hPre := (hK_props l).2.2.1.2
    obtain ⟨z₁, hz₁_K, hz₁_W₂, hz₁_W₁⟩ :=
      hPre (W₂ : Set Γ₀.left) (W₁ : Set Γ₀.left) W₂.isOpen W₁.isOpen hK_W₂_ne hK_W₁_ne
    obtain ⟨z₂, hz₂_K, hz₂_WF, hz₂_W₁⟩ :=
      hPre (W_F : Set Γ₀.left) (W₁ : Set Γ₀.left) W_F.isOpen W₁.isOpen hK_WF_ne hK_W₁_ne
    have hz₁_not : u₁₂ ∉ (hAff_W₂.primeIdealOf ⟨z₁, hz₁_W₂⟩).asIdeal := by
      rw [hPrime_u12 hAff_W₂ z₁ hz₁_W₂]
      intro hmem
      exact hmem hz₁_W₁
    have hz₂_not_S : S_Γ ∉ (hAff_WF.primeIdealOf ⟨z₂, hz₂_WF⟩).asIdeal := by
      rw [hPrime_S hAff_WF z₂ hz₂_WF, hHyp_H₁_pow3]
      intro hmem
      exact hmem hz₂_W₁
    have hz₂_not_T : T_Γ ∉ (hAff_W₁.primeIdealOf ⟨z₂, hz₂_W₁⟩).asIdeal := by
      rw [hPrime_T hAff_W₁ z₂ hz₂_W₁]
      intro hmem
      exact hmem hz₂_WF
    exact ⟨⟨y, hy₂, hyF, hy_K, hy_u₁₂, hy_S⟩,
      ⟨z₁, hz₁_W₂, hz₁_K, hz₁_not⟩,
      ⟨z₂, hz₂_WF, hz₂_W₁, hz₂_K, hz₂_not_S, hz₂_not_T⟩⟩

  have hTF_W₂ :
