      have h_fst : ι_Z_Q₁ ≫ p₁_Z = π₀_sch := Limits.pullback.lift_fst _ _ _
      rwa [h_fst] at h_iso
    let O : Fin (M + 1) × Fin 2 → U_axis.toScheme.Opens :=
