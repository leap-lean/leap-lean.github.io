      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality] at h_top2
      have h_nat_P := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
        (CommRingCat.ofHom (Polynomial.mapRingHom κ_A))
