      exact ⟨⟨y, hyF, hy_K, hy_S⟩, ⟨z₂, hz₂F, hz₂_K, hz₂_not_S⟩⟩

  have hT_nzd : T_Γ ∈ nonZeroDivisors ↑B_Γ0 :=
    (hK_tf W₁ hAff_W₁ T_Γ).1 fun l _ => by
