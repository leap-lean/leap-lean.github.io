theorem weil_net_incidence_schur_submersive_smooth (k : Type u) [Field k] :
    (∀ (d : ℕ) (A : Type u) [CommRing A] (κ_A : k →+* A),
      RingHom.IsStandardSmoothOfRelativeDimension d κ_A →
      ∀ (a₀ a₁ a₂ : A),
        IsUnit a₁ ∨ IsUnit a₂ →
        RingHom.IsStandardSmoothOfRelativeDimension (d + 1)
          ((Ideal.Quotient.mk
            (Ideal.span
              ({MvPolynomial.C a₀ + MvPolynomial.C a₁ * MvPolynomial.X (0 : Fin 2) +
                MvPolynomial.C a₂ * MvPolynomial.X (1 : Fin 2)} :
                Set (MvPolynomial (Fin 2) A)))).comp
            (MvPolynomial.C.comp κ_A))) ∧
    (∀ (s d₀ : ℕ) (A : Type u) [CommRing A]
        (φ : MvPolynomial (Fin (s + 3 + d₀)) k →+* A)
        (q : Fin s → MvPolynomial (Fin (s + 3 + d₀)) k)
        (f_lift : Fin 3 → MvPolynomial (Fin (s + 3 + d₀)) k)
        (idx : Fin (s + 3) → Fin (s + 3 + d₀)),
      Function.Surjective φ →
      Function.Injective idx →
      RingHom.ker φ = Ideal.span (Set.range q) →
      IsUnit (Matrix.det (Matrix.of fun a b : Fin s =>
        φ (MvPolynomial.pderiv (idx (Fin.castAdd 3 b)) (q a)))) →
      IsUnit (Matrix.det (Matrix.of fun a b : Fin (s + 3) =>
        φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a)))) →
      (∀ (β : Fin 3),
        let I_β : Ideal (MvPolynomial (Fin 2) A) :=
          Ideal.span ({MvPolynomial.C (φ (f_lift β)) +
            MvPolynomial.C (φ (f_lift (β.succAbove 0))) * MvPolynomial.X (0 : Fin 2) +
            MvPolynomial.C (φ (f_lift (β.succAbove 1))) * MvPolynomial.X (1 : Fin 2)} :
              Set (MvPolynomial (Fin 2) A))
        ∀ (𝔭 : PrimeSpectrum (MvPolynomial (Fin 2) A ⧸ I_β)),
          ∃ Δ : MvPolynomial (Fin 2) A ⧸ I_β,
            Δ ∉ 𝔭.asIdeal ∧
            RingHom.IsStandardSmoothOfRelativeDimension (d₀ + 4)
              ((algebraMap (MvPolynomial (Fin 2) A ⧸ I_β) (Localization.Away Δ)).comp
                ((Ideal.Quotient.mk I_β).comp
                  (MvPolynomial.C.comp (φ.comp MvPolynomial.C))))) ∧
      (let I_net : Ideal A := Ideal.span (Set.range (fun r : Fin 3 => φ (f_lift r)))
       RingHom.IsStandardSmoothOfRelativeDimension (d₀ + 2)
        ((MvPolynomial.C : (A ⧸ I_net) →+* MvPolynomial (Fin 2) (A ⧸ I_net)).comp
          ((Ideal.Quotient.mk I_net).comp (φ.comp MvPolynomial.C))))) :=
by
  have hGenAlgMap : ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S] {ι : Type}
      (f : MvPolynomial ι R →ₐ[R] S) (hf : Function.Surjective f)
      (x : MvPolynomial ι R),
      algebraMap (Algebra.Generators.ofAlgHom f hf).Ring S x = f x := by
    intro R S _ _ _ ι f hf x
    rw [Algebra.Generators.algebraMap_apply]
    have heq : MvPolynomial.aeval (Algebra.Generators.ofAlgHom f hf).val = f := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [Algebra.Generators.ofAlgHom]
    exact AlgHom.congr_fun heq x
  have hMakePre :
      ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
        {ι σ : Type} [Fintype σ] [DecidableEq σ]
        (f : MvPolynomial ι R →ₐ[R] S) (hf : Function.Surjective f)
        (rel : σ → MvPolynomial ι R) (hker : Ideal.span (Set.range rel) = RingHom.ker f.toRingHom)
        (idx : σ → ι) (hidx : Function.Injective idx),
        ∃ P : Algebra.PreSubmersivePresentation R S ι σ,
          P.jacobian =
            Matrix.det (Matrix.of fun a b : σ => f (MvPolynomial.pderiv (idx b) (rel a))) := by
    intro R S _ _ _ ι σ _ _ f hf rel hker idx hidx
    let G := Algebra.Generators.ofAlgHom f hf
    have hkerG : Ideal.span (Set.range rel) = G.ker := by
      dsimp only [G]
      rw [Algebra.Generators.ker_ofAlgHom]
      exact hker
    let P_pres := Algebra.Presentation.mk G rel hkerG
    let P := Algebra.PreSubmersivePresentation.mk P_pres idx hidx
    refine ⟨P, ?_⟩
    rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
      ← Matrix.det_transpose, hGenAlgMap f hf]
    change f.toRingHom P.jacobiMatrix.transpose.det = _
    rw [RingHom.map_det]
    congr 1
    ext a b
    simp [P, P_pres, Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
  have hSmoothOfPre :
      ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
        {ι σ : Type} [Finite ι] [Finite σ]
        (P : Algebra.PreSubmersivePresentation R S ι σ),
        IsUnit P.jacobian →
        ∀ (n : ℕ), Nat.card ι - Nat.card σ = n →
        RingHom.IsStandardSmoothOfRelativeDimension n (algebraMap R S) := by
    intro R S _ _ _ ι σ _ _ P hUnit n hdim
    let P_sub : Algebra.SubmersivePresentation R S ι σ :=
      Algebra.SubmersivePresentation.mk P hUnit
    exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mpr
      (P_sub.isStandardSmoothOfRelativeDimension hdim)
  have hSmoothLocAway :
      ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
        {ι σ : Type} [Finite ι] [Finite σ]
        (P : Algebra.PreSubmersivePresentation R S ι σ)
        (Δ : S), P.jacobian = Δ →
        ∀ (n : ℕ), Nat.card (Unit ⊕ ι) - Nat.card (Unit ⊕ σ) = n →
        RingHom.IsStandardSmoothOfRelativeDimension n
          ((algebraMap S (Localization.Away Δ)).comp (algebraMap R S)) := by
    intro R S _ _ _ ι σ _ _ P Δ hΔ n hdim
    let Q_loc : Algebra.PreSubmersivePresentation S (Localization.Away Δ) Unit Unit :=
      Algebra.PreSubmersivePresentation.localizationAway (Localization.Away Δ) Δ
    let P_tot_pre := Q_loc.comp P
    have hUnit_tot : IsUnit P_tot_pre.jacobian := by
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        hΔ, Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
      exact (IsLocalization.Away.algebraMap_isUnit Δ).mul
        (IsLocalization.Away.algebraMap_isUnit Δ)
    let P_tot : Algebra.SubmersivePresentation R (Localization.Away Δ) _ _ :=
      Algebra.SubmersivePresentation.mk P_tot_pre hUnit_tot
    have hdim_tot : P_tot.dimension = n := hdim
    rw [← IsScalarTower.algebraMap_eq R S (Localization.Away Δ)]
    exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mpr
      (P_tot.isStandardSmoothOfRelativeDimension hdim_tot)
  refine ⟨?_, ?_⟩
  · 
    intro d A _ κ_A hκ a₀ a₁ a₂ hUnit
    set g₁ : MvPolynomial (Fin 2) A :=
      MvPolynomial.C a₀ + MvPolynomial.C a₁ * MvPolynomial.X (0 : Fin 2) +
        MvPolynomial.C a₂ * MvPolynomial.X (1 : Fin 2)
    set I₁ : Ideal (MvPolynomial (Fin 2) A) :=
