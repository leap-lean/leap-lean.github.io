                (IsOpenImmersion.isoOfRangeEq_hom_fac (W₁.ι ≫ pre_U.ι) W₂.ι hrange_W).symm
        _ = (e_WW.hom ≫ (π₀_sch ∣_ V_p p)) ≫ (V_p p).ι := by
              rw [Category.assoc, ← morphismRestrict_ι, ← Category.assoc]
