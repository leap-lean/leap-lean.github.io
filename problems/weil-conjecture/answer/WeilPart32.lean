        let ι_idx := Module.Basis.ofVectorSpaceIndex k A_dom
        let b_vec : Module.Basis ι_idx k A_dom := Module.Basis.ofVectorSpace k A_dom
        let bΩ : Module.Basis ι_idx Ω (TensorProduct k Ω A_dom) := b_vec.baseChange Ω
