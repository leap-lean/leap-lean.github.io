    rw [h2, hπ_app (κ_Z c)]
  · intro y i
    have hDehomP2 := hDehom_P2 P_2 (𝟙 P_2) β (MvPolynomial.isHomogeneous_X k β) D_β (hAff_P2 β) (le_refl _)
    have hBo_P2 := (hDehomP2.1 (MvPolynomial.X (β.succAbove i))
