        (AlgebraicGeometry.Scheme.Opens.ι (W_cov α) ≫ p₂_PM) ((D_k α).ι ≫ p₀_hom) g_kΩ :=
      (AlgebraicGeometry.isPullback_morphismRestrict p₁_PM (D_k α)).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback p₀_hom g_kΩ)
    let e_cone := CategoryTheory.IsPullback.isoIsPullback _ _ hPB_V hPB_W
    have hΦ_eq : Φ_PM ∣_ W_cov α = e_cone.hom := by
      apply hPB_W.hom_ext
      · exact (CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPB_V hPB_W).symm
      · rw [CategoryTheory.IsPullback.isoIsPullback_hom_snd, ← Category.assoc,
          AlgebraicGeometry.morphismRestrict_ι, Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd]
    rw [hΦ_eq]
    infer_instance
  let ι₀_left : Z_bar.left ⟶ AlgebraicGeometry.Proj 𝒜_k := ι_bar.left
  have hι₀_w : ι₀_left ≫ p₀_hom = Z_bar.hom := CategoryTheory.Over.w ι_bar
  have hj_comm : (q_Z ≫ ι₀_left) ≫ p₀_hom = W_Ω.hom ≫ g_kΩ := by
    rw [Category.assoc, hι₀_w]; exact CategoryTheory.Limits.pullback.condition
  let j_PM : W_Ω.left ⟶ Q_PM := CategoryTheory.Limits.pullback.lift (q_Z ≫ ι₀_left) W_Ω.hom hj_comm
  have hPB_jPM : CategoryTheory.IsPullback q_Z j_PM ι₀_left p₁_PM := by
    refine (CategoryTheory.IsPullback.of_right ?_ ?_
      (CategoryTheory.IsPullback.of_hasPullback p₀_hom g_kΩ).flip).flip
    · rw [CategoryTheory.Limits.pullback.lift_snd, hι₀_w]
      exact (CategoryTheory.IsPullback.of_hasPullback Z_bar.hom g_kΩ).flip
    · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hClosed_jPM : AlgebraicGeometry.IsClosedImmersion j_PM :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsClosedImmersion) hPB_jPM hCl_ι
  let ι_WΩ_left : W_Ω.left ⟶ AlgebraicGeometry.Proj 𝒜_Ω := j_PM ≫ CategoryTheory.inv Φ_PM
  have hCl_WΩ_left : AlgebraicGeometry.IsClosedImmersion ι_WΩ_left :=
    AlgebraicGeometry.IsClosedImmersion.comp j_PM (CategoryTheory.inv Φ_PM)
  have h_ιWΩ_w : ι_WΩ_left ≫ p₁_hom = W_Ω.hom := by
    have hΦp₂ : Φ_PM ≫ p₂_PM = p₁_hom := CategoryTheory.Limits.pullback.lift_snd π_PM p₁_hom hComm
    calc
      ι_WΩ_left ≫ p₁_hom = j_PM ≫ CategoryTheory.inv Φ_PM ≫ (Φ_PM ≫ p₂_PM) := by rw [hΦp₂]; rfl
      _ = j_PM ≫ (CategoryTheory.inv Φ_PM ≫ Φ_PM) ≫ p₂_PM := by simp only [Category.assoc]
      _ = j_PM ≫ p₂_PM := by rw [CategoryTheory.IsIso.inv_hom_id, Category.id_comp]
      _ = W_Ω.hom := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have h_ιWΩ_π : ι_WΩ_left ≫ π_PM = q_Z ≫ ι₀_left := by
    have hΦp₁ : Φ_PM ≫ p₁_PM = π_PM := CategoryTheory.Limits.pullback.lift_fst π_PM p₁_hom hComm
    calc
      ι_WΩ_left ≫ π_PM = j_PM ≫ CategoryTheory.inv Φ_PM ≫ (Φ_PM ≫ p₁_PM) := by rw [hΦp₁]; rfl
      _ = j_PM ≫ (CategoryTheory.inv Φ_PM ≫ Φ_PM) ≫ p₁_PM := by simp only [Category.assoc]
      _ = j_PM ≫ p₁_PM := by rw [CategoryTheory.IsIso.inv_hom_id, Category.id_comp]
      _ = q_Z ≫ ι₀_left := CategoryTheory.Limits.pullback.lift_fst _ _ _
  let ι_WΩ : W_Ω ⟶ PM_Ω := CategoryTheory.Over.homMk ι_WΩ_left h_ιWΩ_w
  have hCl_WΩ : AlgebraicGeometry.IsClosedImmersion ι_WΩ.left := hCl_WΩ_left

  have hChart_eq : ∀ α : Fin (M + 1),
      (TopologicalSpace.Opens.map ι_WΩ.left.base).obj (D_Ω α) =
      (TopologicalSpace.Opens.map q_Z.base).obj
        ((TopologicalSpace.Opens.map ι_bar.left.base).obj (D_k α)) := by
    intro α
    have hD : (TopologicalSpace.Opens.map π_PM.base).obj (D_k α) = D_Ω α := by
      have h := AlgebraicGeometry.Proj.map_preimage_basicOpen f_M hf_irrel (MvPolynomial.X α)
      rwa [hfX α] at h
    rw [← hD]
    ext w
    change (ι_WΩ_left ≫ π_PM).base w ∈ D_k α ↔ (q_Z ≫ ι₀_left).base w ∈ D_k α
    rw [h_ιWΩ_π]

  have hPull_F : ∀ (F : MvPolynomial (Fin (M + 1)) k) (hF : F ∈ 𝒜_k 1) (α : Fin (M + 1))
      (hVW_Ω : (TopologicalSpace.Opens.map q_Z.base).obj
          ((TopologicalSpace.Opens.map ι_bar.left.base).obj (D_k α)) ≤
        (TopologicalSpace.Opens.map ι_WΩ.left.base).obj (D_Ω α)),
      let V_Z : Z_bar.left.Opens := (TopologicalSpace.Opens.map ι_bar.left.base).obj (D_k α)
      let V_W : W_Ω.left.Opens := (TopologicalSpace.Opens.map q_Z.base).obj V_Z
      ((Proj.basicOpenIsoAway 𝒜_Ω (MvPolynomial.X α) (hXα_Ω α) zero_lt_one).hom ≫
        ι_WΩ.left.appLE (D_Ω α) V_W hVW_Ω).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨f_M F, f_M.map_mem hF⟩, ⟨MvPolynomial.X α, hXα_Ω α⟩, ⟨1, pow_one _⟩⟩) =
      (q_Z.appLE V_Z V_W le_rfl).hom
        (((Proj.basicOpenIsoAway 𝒜_k (MvPolynomial.X α) (hXα_k α) zero_lt_one).hom ≫
          ι_bar.left.appLE (D_k α) V_Z le_rfl).hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α, hXα_k α⟩, ⟨1, pow_one _⟩⟩)) := by
    intro F hF α hVW_Ω V_Z V_W
    have hD_sub : D_Ω α ≤ (TopologicalSpace.Opens.map π_PM.base).obj (D_k α) := by
      have h := AlgebraicGeometry.Proj.map_preimage_basicOpen f_M hf_irrel (MvPolynomial.X α)
      rw [hfX α] at h
      exact h.symm.le
    have h1 := hProjMapAway' f_M hf_irrel (MvPolynomial.X α) (MvPolynomial.X α) (hfX α)
      (hXα_k α) (hXα_Ω α) hD_sub F hF (f_M.map_mem hF)
    have h2 : ((Proj.basicOpenIsoAway 𝒜_Ω (MvPolynomial.X α) (hXα_Ω α) zero_lt_one).hom ≫
        ι_WΩ_left.appLE (D_Ω α) V_W hVW_Ω).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨f_M F, f_M.map_mem hF⟩, ⟨MvPolynomial.X α, hXα_Ω α⟩, ⟨1, pow_one _⟩⟩) =
      ((Proj.basicOpenIsoAway 𝒜_k (MvPolynomial.X α) (hXα_k α) zero_lt_one).hom ≫
        (π_PM.appLE (D_k α) (D_Ω α) hD_sub ≫ ι_WΩ_left.appLE (D_Ω α) V_W hVW_Ω)).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α, hXα_k α⟩, ⟨1, pow_one _⟩⟩) :=
      congrArg (ι_WΩ_left.appLE (D_Ω α) V_W hVW_Ω).hom h1.symm
    have h_app_eq : π_PM.appLE (D_k α) (D_Ω α) hD_sub ≫ ι_WΩ_left.appLE (D_Ω α) V_W hVW_Ω =
        ι₀_left.appLE (D_k α) V_Z le_rfl ≫ q_Z.appLE V_Z V_W le_rfl :=
      (Scheme.Hom.appLE_comp_appLE ι_WΩ_left π_PM (D_k α) (D_Ω α) V_W hD_sub hVW_Ω).trans
        ((hCongrAppLE h_ιWΩ_π (D_k α) V_W _ _).trans
          (Scheme.Hom.appLE_comp_appLE q_Z ι₀_left (D_k α) V_Z V_W le_rfl le_rfl).symm)
    exact h2.trans (ConcreteCategory.congr_hom
      (congrArg ((Proj.basicOpenIsoAway 𝒜_k (MvPolynomial.X α) (hXα_k α) zero_lt_one).hom ≫ ·)
        h_app_eq) _)

  
  let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
  let _ : GradedAlgebra 𝒜_1 := MvPolynomial.gradedAlgebra
  let D₁ : Fin 2 → (AlgebraicGeometry.Proj 𝒜_1).Opens :=
    fun b => AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b)
  have hCov_P₁ : ⨆ b : Fin 2, D₁ b = ⊤ :=
    AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜_1 MvPolynomial.X (hIrrel 1 k)
  let pt₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) := (⊥ : PrimeSpectrum Ω)
  have hpt₀_mem : s.base pt₀ ∈ (⨆ b : Fin 2, D₁ b) := by rw [hCov_P₁]; trivial
  obtain ⟨b, hb_pt₀⟩ := TopologicalSpace.Opens.mem_iSup.mp hpt₀_mem
  have h_top_s : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
      (TopologicalSpace.Opens.map s.base).obj (D₁ b) := by
    intro y _
    have hy : y = pt₀ := Subsingleton.elim y pt₀
    rw [hy]
    exact hb_pt₀
  have hTb : (MvPolynomial.X b : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k b)
  let ψ_s : HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) →+* Ω :=
    ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b) hTb zero_lt_one).hom ≫
      s.appLE (D₁ b) ⊤ h_top_s ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom).hom
  let m_1 : Fin 2 → HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) := fun a =>
    HomogeneousLocalization.mk
      ⟨1, ⟨MvPolynomial.X a, (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X k a)⟩, ⟨MvPolynomial.X b, hTb⟩, ⟨1, pow_one _⟩⟩
  let c : Fin 2 → Ω := fun a => ψ_s (m_1 a)
  have hcb_one : c b = 1 := by
    have hm1 : m_1 b = 1 := by
      apply HomogeneousLocalization.val_injective
      dsimp only [m_1]
      rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_one]
      exact Localization.mk_self
        (⟨(MvPolynomial.X b : MvPolynomial (Fin 2) k), ⟨1, pow_one _⟩⟩ :
          Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin 2) k))
    dsimp [c]
    rw [hm1, map_one]
  let L_s : MvPolynomial (Fin (M + 1)) Ω :=
    MvPolynomial.C (c 0) * f_M (F_pen 0) + MvPolynomial.C (c 1) * f_M (F_pen 1)
  have hLs_hom : L_s ∈ 𝒜_Ω 1 := by
    have hC0 : MvPolynomial.C (c 0) ∈ 𝒜_Ω 0 :=
      (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr (MvPolynomial.isHomogeneous_C _ _)
    have hC1 : MvPolynomial.C (c 1) ∈ 𝒜_Ω 0 :=
      (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr (MvPolynomial.isHomogeneous_C _ _)
    have hm0 : MvPolynomial.C (c 0) * f_M (F_pen 0) ∈ 𝒜_Ω (0 + 1) :=
      SetLike.GradedMul.mul_mem hC0 (f_M.map_mem (hF_homog 0))
    have hm1 : MvPolynomial.C (c 1) * f_M (F_pen 1) ∈ 𝒜_Ω (0 + 1) :=
      SetLike.GradedMul.mul_mem hC1 (f_M.map_mem (hF_homog 1))
    rw [Nat.zero_add] at hm0 hm1
    exact Submodule.add_mem _ hm0 hm1
  have hLs_ne : L_s ≠ 0 := by
    intro hLs0
    fin_cases b
    · dsimp at hcb_one
      have hF1_ne : F_pen 1 ≠ 0 := by
        intro h0
        have hc_ne : (![0, (1 : k)] : Fin 2 → k) ≠ 0 := by
          intro hc; exact one_ne_zero (congrFun hc 1)
        apply hF_linIndep ![0, 1] hc_ne
        simp [h0]
      have h_ex : ∃ μ, (F_pen 1).coeff μ ≠ 0 := by
        by_contra hall; push_neg at hall; apply hF1_ne; ext μ; simpa using hall μ
      obtain ⟨μ, hμ⟩ := h_ex
      have hcoeff := congrArg (fun q => q.coeff μ) hLs0
      simp only [L_s, MvPolynomial.coeff_add, MvPolynomial.coeff_C_mul, f_M,
        GradedRingHom.coe_mk, MvPolynomial.coeff_map, hcb_one, one_mul,
        MvPolynomial.coeff_zero] at hcoeff
      have haμ_ne : algebraMap k Ω ((F_pen 1).coeff μ) ≠ 0 :=
        (map_ne_zero (algebraMap k Ω)).mpr hμ
      let lam : k := - (F_pen 0).coeff μ * ((F_pen 1).coeff μ)⁻¹
      have hc1_eq : c 1 = algebraMap k Ω lam := by
        apply mul_right_cancel₀ haμ_ne
        rw [← map_mul]
        dsimp [lam]
        rw [mul_assoc, inv_mul_cancel₀ hμ, mul_one, map_neg]
        exact eq_neg_of_add_eq_zero_right hcoeff
      have hmap_eq : MvPolynomial.map (algebraMap k Ω)
          (MvPolynomial.C 1 * F_pen 0 + MvPolynomial.C lam * F_pen 1) = 0 := by
        rw [map_add, map_mul, map_mul, MvPolynomial.map_C, MvPolynomial.map_C, map_one, ← hc1_eq]
        simpa [L_s, hcb_one, f_M] using hLs0
      have hk_eq : MvPolynomial.C (1 : k) * F_pen 0 + MvPolynomial.C lam * F_pen 1 = 0 :=
        MvPolynomial.map_injective (algebraMap k Ω) (algebraMap k Ω).injective
          (hmap_eq.trans (map_zero _).symm)
      have hd_ne : (![(1 : k), lam] : Fin 2 → k) ≠ 0 := by
        intro hc; exact one_ne_zero (congrFun hc 0)
      exact hF_linIndep ![1, lam] hd_ne hk_eq
    · dsimp at hcb_one
      have hF0_ne : F_pen 0 ≠ 0 := by
        intro h0
        have hc_ne : (![(1 : k), 0] : Fin 2 → k) ≠ 0 := by
          intro hc; exact one_ne_zero (congrFun hc 0)
        apply hF_linIndep ![1, 0] hc_ne
        simp [h0]
      have h_ex : ∃ μ, (F_pen 0).coeff μ ≠ 0 := by
        by_contra hall; push_neg at hall; apply hF0_ne; ext μ; simpa using hall μ
      obtain ⟨μ, hμ⟩ := h_ex
      have hcoeff := congrArg (fun q => q.coeff μ) hLs0
      simp only [L_s, MvPolynomial.coeff_add, MvPolynomial.coeff_C_mul, f_M,
        GradedRingHom.coe_mk, MvPolynomial.coeff_map, hcb_one, one_mul,
        MvPolynomial.coeff_zero] at hcoeff
      have haμ_ne : algebraMap k Ω ((F_pen 0).coeff μ) ≠ 0 :=
        (map_ne_zero (algebraMap k Ω)).mpr hμ
      obtain ⟨lam, hlam_def⟩ : ∃ lam : k,
          lam = - (F_pen 1).coeff μ * ((F_pen 0).coeff μ)⁻¹ := ⟨_, rfl⟩
      have hc0_eq : c 0 = algebraMap k Ω lam := by
        apply mul_right_cancel₀ haμ_ne
        rw [← map_mul, hlam_def, mul_assoc, inv_mul_cancel₀ hμ, mul_one, map_neg]
        exact eq_neg_of_add_eq_zero_left hcoeff
      have hmap_eq : MvPolynomial.map (algebraMap k Ω)
          (MvPolynomial.C lam * F_pen 0 + MvPolynomial.C 1 * F_pen 1) = 0 := by
        rw [map_add, map_mul, map_mul, MvPolynomial.map_C, MvPolynomial.map_C, map_one, ← hc0_eq]
        simpa [L_s, hcb_one, f_M] using hLs0
      have hk_eq : MvPolynomial.C lam * F_pen 0 + MvPolynomial.C (1 : k) * F_pen 1 = 0 :=
        MvPolynomial.map_injective (algebraMap k Ω) (algebraMap k Ω).injective
          (hmap_eq.trans (map_zero _).symm)
      have hd_ne : (![lam, (1 : k)] : Fin 2 → k) ≠ 0 := by
        intro hc; exact one_ne_zero (congrFun hc 1)
      exact hF_linIndep ![lam, 1] hd_ne hk_eq

  
  have hNondeg_W : ∃ w : W_Ω.left, ι_WΩ.left.base w ∉ weilProjHyperplaneSet Ω M L_s := by
    obtain ⟨z₀⟩ := hNonempty_Z
    have hz₀_cov : ι₀_left.base z₀ ∈ (⨆ α : Fin (M + 1), D_k α) := by rw [hCov_k]; trivial
    obtain ⟨α₀, hz₀_α⟩ := TopologicalSpace.Opens.mem_iSup.mp hz₀_cov
    let V_Z : Z_bar.left.Opens := (TopologicalSpace.Opens.map ι_bar.left.base).obj (D_k α₀)
    let V_W : W_Ω.left.Opens := (TopologicalSpace.Opens.map q_Z.base).obj V_Z
    have hVW_Ω : V_W ≤ (TopologicalSpace.Opens.map ι_WΩ.left.base).obj (D_Ω α₀) :=
      (hChart_eq α₀).symm.le
    have hAff_Dk : AlgebraicGeometry.IsAffineOpen (D_k α₀) :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_k (MvPolynomial.X α₀) (hXα_k α₀) zero_lt_one
    have hAff_VZ : AlgebraicGeometry.IsAffineOpen V_Z :=
      @AlgebraicGeometry.IsAffineOpen.preimage _ _ _ hAff_Dk ι_bar.left
        (@AlgebraicGeometry.IsClosedImmersion.instIsAffineHom _ _ ι_bar.left hCl_ι)
    let A_cat := Z_bar.left.presheaf.obj (Opposite.op V_Z)
    let A := ↑A_cat
    let φ_kA : CommRingCat.of k ⟶ A_cat :=
      (Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ Z_bar.hom.appLE ⊤ V_Z (fun _ _ => trivial)
    let _ : Algebra k A := φ_kA.hom.toAlgebra
    let ℓ_Z : Fin 2 → A := fun a =>
      ((Proj.basicOpenIsoAway 𝒜_k (MvPolynomial.X α₀) (hXα_k α₀) zero_lt_one).hom ≫
        ι_bar.left.appLE (D_k α₀) V_Z le_rfl).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨F_pen a, hF_homog a⟩, ⟨MvPolynomial.X α₀, hXα_k α₀⟩, ⟨1, pow_one _⟩⟩)
    have hLI_ℓZ : LinearIndependent k ℓ_Z := by
      rw [Fintype.linearIndependent_iff]
      intro d_k hd_sum
      rw [Fin.sum_univ_two] at hd_sum
      by_contra hd_ne
      have hd_ne_fn : d_k ≠ 0 := by
        intro h0; apply hd_ne; intro a; rw [h0]; rfl
      let F_comb := MvPolynomial.C (d_k 0) * F_pen 0 + MvPolynomial.C (d_k 1) * F_pen 1
      have hF_comb_hom : F_comb ∈ 𝒜_k 1 := by
        have hC0 : MvPolynomial.C (d_k 0) ∈ 𝒜_k 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr (MvPolynomial.isHomogeneous_C _ _)
        have hC1 : MvPolynomial.C (d_k 1) ∈ 𝒜_k 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr (MvPolynomial.isHomogeneous_C _ _)
        have hm0 : MvPolynomial.C (d_k 0) * F_pen 0 ∈ 𝒜_k (0 + 1) :=
          SetLike.GradedMul.mul_mem hC0 (hF_homog 0)
        have hm1 : MvPolynomial.C (d_k 1) * F_pen 1 ∈ 𝒜_k (0 + 1) :=
          SetLike.GradedMul.mul_mem hC1 (hF_homog 1)
        rw [Nat.zero_add] at hm0 hm1
        exact Submodule.add_mem _ hm0 hm1
      have hF_comb_ne : F_comb ≠ 0 := hF_linIndep d_k hd_ne_fn
      obtain ⟨z_nd, hz_nd⟩ := hNondeg F_comb hF_comb_hom hF_comb_ne
      let U_nd : Z_bar.left.Opens :=
        (TopologicalSpace.Opens.map ι_bar.left.base).obj (Proj.basicOpen 𝒜_k F_comb)
      have hz_nd_mem : z_nd ∈ U_nd := Classical.not_not.mp hz_nd
      have : AlgebraicGeometry.IsIntegral Z_bar.left := hInt
      have hIrred_Z : IrreducibleSpace ↥Z_bar.left := inferInstance
      have hInter_univ := hIrred_Z.isPreirreducible_univ
        (V_Z : Set Z_bar.left) (U_nd : Set Z_bar.left) V_Z.isOpen U_nd.isOpen
        ⟨z₀, trivial, hz₀_α⟩ ⟨z_nd, trivial, hz_nd_mem⟩
      obtain ⟨z₁, -, hz₁_VZ, hz₁_nd⟩ := hInter_univ
      have hz₁_not_hyp : ι_bar.left.base z₁ ∉ weilProjHyperplaneSet k M F_comb :=
        fun h => h hz₁_nd
      obtain ⟨hDict_k, hLin_k⟩ := hBasicDict_K k Z_bar ι_bar α₀ (hXα_k α₀) V_Z le_rfl
      have hz₁_bo := (hDict_k F_comb hF_comb_hom z₁ hz₁_VZ).mpr hz₁_not_hyp
      have h_lin_eq := hLin_k (F_pen 0) (F_pen 1) (hF_homog 0) (hF_homog 1) (d_k 0) (d_k 1) hF_comb_hom
      have h_zero_sec : (((Proj.basicOpenIsoAway 𝒜_k (MvPolynomial.X α₀) (hXα_k α₀) zero_lt_one).hom ≫
          ι_bar.left.appLE (D_k α₀) V_Z le_rfl).hom
          (HomogeneousLocalization.mk
