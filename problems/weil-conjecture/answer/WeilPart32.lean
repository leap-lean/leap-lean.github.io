    let S_z : Type u := ↑(Z_bar.left.presheaf.stalk z₀)
    let γ_Z : A_Z →+* S_z := (Z_bar.left.presheaf.germ V_Z z₀ hz₀_Z).hom
    let γ_U : A_U →+* S_z := (Z_bar.left.presheaf.germ U z₀ hz₀_U).hom
    let alg_Z : Algebra A_Z S_z := γ_Z.toAlgebra
    let alg_U : Algebra A_U S_z := γ_U.toAlgebra
