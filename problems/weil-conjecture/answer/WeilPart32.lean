    have hL_ne : L ≠ 0 := by
      rintro rfl
      have hmk0 : (HomogeneousLocalization.mk ⟨1, ⟨0, hL⟩, ⟨MvPolynomial.X α₀, hXα₀⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α₀)) = 0 := by
