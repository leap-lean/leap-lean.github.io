        rw [Fin.sum_univ_add]
        simp only [Matrix.of_apply, T_mat, Fin.addCases_left, Fin.addCases_right]
        have h_inr : (∑ j : Fin d,
            φ (MvPolynomial.pderiv (Fin.natAdd s j) (Ψ m')) * (if j = γ₀ then 1 else 0)) =
            φ (MvPolynomial.pderiv (Fin.natAdd s γ₀) (Ψ m')) := by
          simp [mul_ite]
        have h_inl : (∑ b : Fin s,
            φ (MvPolynomial.pderiv (Fin.castAdd d b) (Ψ m')) *
              (M₀⁻¹ * Matrix.of fun a (_ : Unit) => M₁ a γ₀) b default) =
            - ∑ b : Fin s, φ (MvPolynomial.pderiv (Fin.castAdd d b) (Ψ m')) * W b γ₀ := by
          rw [← Finset.sum_neg_distrib]
          refine Finset.sum_congr rfl fun b _ => ?_
          have h_entry : (M₀⁻¹ * Matrix.of fun a (_ : Unit) => M₁ a γ₀) b default =
