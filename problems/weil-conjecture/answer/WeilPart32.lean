  classical
  let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  let _ : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
  let P_N := weilProjectiveSpaceOver k N

  
  have hEmpty_of_dim : ∀ {α : Type u} [TopologicalSpace α],
      topologicalKrullDim α + 1 ≤ (0 : WithBot ℕ∞) → IsEmpty α := by
    intro α _ h
    refine ⟨fun x => ?_⟩
    let Z₀ : TopologicalSpace.IrreducibleCloseds α :=
      ⟨closure ({x} : Set α), isIrreducible_singleton.closure, isClosed_closure⟩
    have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim α := by
      change (0 : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds α)
      simpa using Order.LTSeries.length_le_krullDim (RelSeries.singleton _ Z₀)
    rcases hdim : topologicalKrullDim α with _ | d
    · change topologicalKrullDim α = ⊥ at hdim
      rw [hdim] at h0
      exact WithBot.not_coe_le_bot 0 h0
    · change topologicalKrullDim α = (d : WithBot ℕ∞) at hdim
      rw [hdim] at h
      have hd : d + 1 ≤ 0 := WithBot.coe_le_coe.mp h
      exact absurd hd (by simp)

  have hSub_dim : ∀ {α : Type u} [TopologicalSpace α] [Subsingleton α],
      topologicalKrullDim α ≤ (0 : WithBot ℕ∞) := by
    intro α _ _
    have : Subsingleton (TopologicalSpace.IrreducibleCloseds α) := ⟨fun A B => by
      ext x
      obtain ⟨a, ha⟩ := A.2.1
      obtain ⟨b, hb⟩ := B.2.1
      exact ⟨fun _ => Subsingleton.elim x b ▸ hb, fun _ => Subsingleton.elim x a ▸ ha⟩⟩
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds α) ≤ 0
    rw [Order.krullDim]
    refine iSup_le fun p => ?_
    have hp0 : p.length = 0 := by
      by_contra hne
      have hlt : p 0 < p ⟨1, Nat.succ_lt_succ (Nat.pos_of_ne_zero hne)⟩ :=
        p.step ⟨0, Nat.pos_of_ne_zero hne⟩
      exact hlt.ne (Subsingleton.elim _ _)
    simp [hp0]

  have hDim_pred : ∀ {d : WithBot ℕ∞} {n : ℕ},
      d + 1 ≤ ((n + 1 : ℕ) : WithBot ℕ∞) → d ≤ ((n : ℕ) : WithBot ℕ∞) := by
    intro d n h
    rcases d with _ | a
    · exact bot_le
    · change ((a + 1 : ℕ∞) : WithBot ℕ∞) ≤ (((n + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) at h
      have ha : a + 1 ≤ ((n + 1 : ℕ) : ℕ∞) := WithBot.coe_le_coe.mp h
      match a with
      | ⊤ => exact absurd ha (by simp)
      | (m : ℕ) =>
        change (((m : ℕ) : ℕ∞) : WithBot ℕ∞) ≤ (((n : ℕ) : ℕ∞) : WithBot ℕ∞)
        rw [WithBot.coe_le_coe, Nat.cast_le]
        have hm : m + 1 ≤ n + 1 := by exact_mod_cast ha
        omega

  have hProper_dim : ∀ {C Z : Type u} [TopologicalSpace C] [TopologicalSpace Z] [IrreducibleSpace Z]
      (f : C → Z), Topology.IsClosedEmbedding f →
      (∃ z_out : Z, z_out ∉ Set.range f) →
      topologicalKrullDim Z = ((2 : ℕ) : WithBot ℕ∞) →
      topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    rintro C Z _ _ _ f hf ⟨z_out, hz_out⟩ hDimZ
    let g : TopologicalSpace.IrreducibleCloseds C → TopologicalSpace.IrreducibleCloseds Z :=
      fun S => ⟨f '' S.1, S.2.image f hf.continuous.continuousOn,
        hf.isClosed_iff_image_isClosed.mp S.3⟩
    have hg_mono : StrictMono g := by
      intro S₁ S₂ hlt
      rw [lt_iff_le_and_ne] at hlt ⊢
      refine ⟨Set.image_mono hlt.1, fun heq => hlt.2 ?_⟩
      have himg : f '' S₁.1 = f '' S₂.1 := congrArg SetLike.coe heq
      have hpre := congrArg (fun T => f ⁻¹' T) himg
      rw [Set.preimage_image_eq _ hf.injective, Set.preimage_image_eq _ hf.injective] at hpre
      exact SetLike.coe_injective hpre
    let topZ : TopologicalSpace.IrreducibleCloseds Z :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ Z, isClosed_univ⟩
    have hg_lt : ∀ S, g S < topZ := by
      intro S
      rw [lt_iff_le_and_ne]
      refine ⟨Set.subset_univ _, fun heq => hz_out ?_⟩
      have hz_mem : z_out ∈ (g S : Set Z) := by
        rw [congrArg SetLike.coe heq]
        trivial
      rcases hz_mem with ⟨c, _, rfl⟩
      exact ⟨c, rfl⟩
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds C) ≤ ((1 : ℕ) : WithBot ℕ∞)
    rw [Order.krullDim]
    refine iSup_le fun p => ?_
    let q := (p.map g hg_mono).snoc topZ (hg_lt p.last)
    have hq : ((q.length : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim Z :=
      Order.LTSeries.length_le_krullDim q
    rw [hDimZ] at hq
    have hlen : q.length = p.length + 1 := rfl
    rw [hlen] at hq
    have hnat : p.length + 1 ≤ 2 := by exact_mod_cast WithBot.coe_le_coe.mp hq
    have hp1 : p.length ≤ 1 := by omega
    exact_mod_cast hp1

