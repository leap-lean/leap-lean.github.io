      Γ₀.hom.appLE ⊤ W₂ le_top).hom
  let h₁₂ : ↑(Γ₀.left.presheaf.obj (Opposite.op W₁)) :=
    (ι_ΓP.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₁) W₁ le_rfl).hom
      ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₁).hom
        (HomogeneousLocalization.Away.mk 𝒜_N hH₁ 1 H₂ hH₂))
  let u₁₂ : ↑(Γ₀.left.presheaf.obj (Opposite.op W₂)) :=
    (ι_ΓP.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) W₂ le_rfl).hom
