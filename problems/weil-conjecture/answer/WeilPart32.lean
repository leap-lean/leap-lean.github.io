              ι_X.left.appLE (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K)
                (MvPolynomial.X α)) U_X hUX).hom
              (HomogeneousLocalization.mk ⟨1, ⟨L_K, hLK⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
          (x ∈ X.left.basicOpen ℓ_L ↔ ι_X.left.base x ∉ weilProjHyperplaneSet K M L_K)) ∧
        (∀ (F₀ F₁ : MvPolynomial (Fin (M + 1)) K)
           (hF₀ : F₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K 1)
           (hF₁ : F₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K 1) (d₀ d₁ : K)
           (hComb : MvPolynomial.C d₀ * F₀ + MvPolynomial.C d₁ * F₁ ∈
