    have hSpecFlat : AlgebraicGeometry.Flat
        (AlgebraicGeometry.Spec.map (g₂.left.appLE (D_P β) V_Y inf_le_right)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr hFlat_appLE
    have hAffDβ' : AlgebraicGeometry.IsAffineOpen (D_P β) := hAffDβ
    have hAffVY' : AlgebraicGeometry.IsAffineOpen V_Y := hAffVY
    have hFactor : V_Y.ι ≫ g₂.left =
        hAffVY'.isoSpec.hom ≫
          AlgebraicGeometry.Spec.map (g₂.left.appLE (D_P β) V_Y inf_le_right) ≫
          hAffDβ'.fromSpec := by
      rw [hAffVY'.isoSpec_hom, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE g₂.left (D_P β) V_Y inf_le_right,
        CategoryTheory.Category.assoc]
      have hU_from : (D_P β).toSpecΓ ≫ hAffDβ'.fromSpec = (D_P β).ι := by
        rw [← hAffDβ'.isoSpec_hom]
        change hAffDβ'.isoSpec.hom ≫ hAffDβ'.isoSpec.inv ≫ (D_P β).ι = (D_P β).ι
        rw [← CategoryTheory.Category.assoc, hAffDβ'.isoSpec.hom_inv_id,
          CategoryTheory.Category.id_comp]
      rw [hU_from, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
    rw [hFactor]
    exact @AlgebraicGeometry.Flat.comp _ _ _ hAffVY'.isoSpec.hom _ inferInstance
      (@AlgebraicGeometry.Flat.comp _ _ _ _ hAffDβ'.fromSpec hSpecFlat inferInstance)

  have hSchur := weil_net_incidence_schur_submersive_smooth k
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  have hAffTop : AlgebraicGeometry.IsAffineOpen (⊤ : S_k.Opens) :=
    isAffineOpen_top S_k

  have hSm_Y₂ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 3) Y₂.hom := by
    refine AlgebraicGeometry.SmoothOfRelativeDimension.mk fun y => ?_
    let z : Z_bar.left := π_Y.left.base y
    by_cases hOff : ∃ r₀ : Fin 3, ι_bar.left.base z ∉ weilProjHyperplaneSet k M (L r₀)
    · obtain ⟨r₀, hr₀⟩ := hOff
      have hz_cov : z ∈ (⨆ α : Fin (M + 1), C_Z α) := by
        rw [hCov_Z']
        trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hz_cov
      obtain ⟨α, hz_α⟩ := hz_cov
      have hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1 :=
        MvPolynomial.isHomogeneous_X k α
      obtain ⟨U_k, _, U_sm, hAffUsm, hz_sm, e_sm, hSm_Usm⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff (2 * m + 2) Z_bar.hom).mp inferInstance z
      have hUk_top : U_k = ⊤ := by
        ext pt
        simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        rw [Subsingleton.elim pt (Z_bar.hom.base z)]
        exact e_sm hz_sm
      subst hUk_top
