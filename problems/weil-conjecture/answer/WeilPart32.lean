            by_contra hnot0
            exact hAll (r₀.succAbove 0) (Fin.succAbove_ne r₀ 0) ((hX_iff y_V0 0).mpr hnot0)
          have hX1_mem : e_Y0 (Ideal.Quotient.mk _ (MvPolynomial.X (1 : Fin 2))) ∈
              (hAffVY0.primeIdealOf y_V0).asIdeal := by
            by_contra hnot1
            exact hAll (r₀.succAbove 1) (Fin.succAbove_ne r₀ 1) ((hX_iff y_V0 1).mpr hnot1)
          have hRel0 : Ideal.Quotient.mk
              (Ideal.span ({MvPolynomial.C (ℓ_r r₀) +
                MvPolynomial.C (ℓ_r (r₀.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
                MvPolynomial.C (ℓ_r (r₀.succAbove 1)) * MvPolynomial.X (1 : Fin 2)} :
                Set (MvPolynomial (Fin 2) A)))
              (MvPolynomial.C (ℓ_r r₀) +
                MvPolynomial.C (ℓ_r (r₀.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
                MvPolynomial.C (ℓ_r (r₀.succAbove 1)) * MvPolynomial.X (1 : Fin 2)) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          have hUnit_eY : IsUnit (e_Y0 (Ideal.Quotient.mk _ (MvPolynomial.C (ℓ_r r₀)))) :=
            hUnit_r₀.map (e_Y0.toRingHom.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))
          have hUnit_mem : e_Y0 (Ideal.Quotient.mk _ (MvPolynomial.C (ℓ_r r₀))) ∈
              (hAffVY0.primeIdealOf y_V0).asIdeal := by
            have h1 := congrArg e_Y0 hRel0
            simp only [map_zero, map_add, map_mul] at h1
            have hsum_mem :
                e_Y0 (Ideal.Quotient.mk _ (MvPolynomial.C (ℓ_r (r₀.succAbove 0)))) *
                  e_Y0 (Ideal.Quotient.mk _ (MvPolynomial.X (0 : Fin 2))) +
                e_Y0 (Ideal.Quotient.mk _ (MvPolynomial.C (ℓ_r (r₀.succAbove 1)))) *
                  e_Y0 (Ideal.Quotient.mk _ (MvPolynomial.X (1 : Fin 2))) ∈
                (hAffVY0.primeIdealOf y_V0).asIdeal :=
              Ideal.add_mem _ (Ideal.mul_mem_left _ _ hX0_mem) (Ideal.mul_mem_left _ _ hX1_mem)
            have heq : e_Y0 (Ideal.Quotient.mk _ (MvPolynomial.C (ℓ_r r₀))) =
                -(e_Y0 (Ideal.Quotient.mk _ (MvPolynomial.C (ℓ_r (r₀.succAbove 0)))) *
                    e_Y0 (Ideal.Quotient.mk _ (MvPolynomial.X (0 : Fin 2))) +
                  e_Y0 (Ideal.Quotient.mk _ (MvPolynomial.C (ℓ_r (r₀.succAbove 1)))) *
                    e_Y0 (Ideal.Quotient.mk _ (MvPolynomial.X (1 : Fin 2)))) :=
