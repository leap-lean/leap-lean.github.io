    rw [hResSubChart α hXα β (MvPolynomial.isHomogeneous_X k β) hL_homog
        U_Z hUZ D_β (le_refl _) W inf_le_left inf_le_right hW_CQ]
    have hTermSimp : ∀ r : Fin 3,
        (p₁.appLE U_Z W inf_le_left).hom
          (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
            ι_bar.left.appLE (D_M α) U_Z hUZ).hom
            (HomogeneousLocalization.mk ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)) *
        (p₂.appLE D_β W inf_le_right).hom
          (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β)
            (MvPolynomial.isHomogeneous_X k β) zero_lt_one).hom ≫
            P_2.left.presheaf.map (CategoryTheory.homOfLE (le_refl D_β)).op).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨MvPolynomial.X r, MvPolynomial.isHomogeneous_X k r⟩,
                ⟨MvPolynomial.X β, MvPolynomial.isHomogeneous_X k β⟩, ⟨1, pow_one _⟩⟩)) =
        (p₁.appLE U_Z W inf_le_left).hom (ℓ_r r) *
        (p₂.appLE D_β W inf_le_right).hom (w_tilde β r) := by
      intro r
      congr 1
    have hSumSimp : (∑ r : Fin 3,
          (p₁.appLE U_Z W inf_le_left).hom
            (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
              ι_bar.left.appLE (D_M α) U_Z hUZ).hom
              (HomogeneousLocalization.mk ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)) *
          (p₂.appLE D_β W inf_le_right).hom
            (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β)
              (MvPolynomial.isHomogeneous_X k β) zero_lt_one).hom ≫
              P_2.left.presheaf.map (CategoryTheory.homOfLE (le_refl D_β)).op).hom
