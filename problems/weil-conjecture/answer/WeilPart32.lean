        map_add' := ψ_β.map_add }
    let isoA := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β) hWβ zero_lt_one
    let e_P : MvPolynomial (Fin 2) k ≃+*
        ↑((weilProjectiveSpaceOver k 2).left.presheaf.obj (Opposite.op D_β)) :=
      e_away.trans isoA.commRingCatIsoToRingEquiv
    refine ⟨e_P, ?_, ?_, ?_⟩
    · intro c
      have he : e_P (MvPolynomial.C c) = isoA.hom.hom (ψ_β (MvPolynomial.C c)) := rfl
      rw [he]
      have hψc : ψ_β (MvPolynomial.C c) =
          HomogeneousLocalization.fromZeroRingHom 𝒜_2 S_β (algebraMap k ↥(𝒜_2 0) c) := by
        simp [ψ_β]
      rw [hψc]
    · intro i
      have he : e_P (MvPolynomial.X i) = isoA.hom.hom (ψ_β (MvPolynomial.X i)) := rfl
      rw [he]
      have hψx : ψ_β (MvPolynomial.X i) = x_coord i := by simp [ψ_β]
      rw [hψx]
    · have h1 : (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X β, hWβ⟩, ⟨MvPolynomial.X β, hWβ⟩, ⟨1, pow_one _⟩⟩ : Away_β) = 1 := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_one,
          ← map_one (algebraMap (MvPolynomial (Fin 3) k) Loc_β),
          ← Localization.mk_one_eq_algebraMap]
        change Localization.mk (MvPolynomial.X β) (⟨MvPolynomial.X β, ⟨1, pow_one _⟩⟩ : S_β) =
          Localization.mk 1 (1 : S_β)
        exact Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq (by simp))
      rw [h1, map_one]

  
  
  
  have hPart3 : ∀ (Q : AlgebraicGeometry.Scheme.{u}) (ι : Type)
      (C : ι → Q.Opens), (⨆ i : ι, C i) = ⊤ →
      ∀ (Φ : ∀ i : ι, ↑(Q.presheaf.obj (Opposite.op (C i)))),
      (∀ i j : ι,
        ∃ u : ↑(Q.presheaf.obj (Opposite.op (C i ⊓ C j))),
          IsUnit u ∧
          (Q.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (Φ i) =
            u * (Q.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (Φ j)) →
      ∃ (Y_sch : AlgebraicGeometry.Scheme.{u}) (ι_Y : Y_sch ⟶ Q),
        AlgebraicGeometry.IsClosedImmersion ι_Y ∧
        (∀ (i : ι) (W : Q.Opens) (_ : AlgebraicGeometry.IsAffineOpen W) (hW : W ≤ C i),
          RingHom.ker (ι_Y.app W).hom =
            Ideal.span {(Q.presheaf.map (CategoryTheory.homOfLE hW).op).hom (Φ i)}) ∧
        (∀ (i : ι) (W : Q.Opens) (_hAffW : AlgebraicGeometry.IsAffineOpen W) (hW : W ≤ C i)
           (V : Y_sch.Opens) (hV : V = (TopologicalSpace.Opens.map ι_Y.base).obj W),
          let J_W : Ideal ↑(Q.presheaf.obj (Opposite.op W)) :=
            Ideal.span {(Q.presheaf.map (CategoryTheory.homOfLE hW).op).hom (Φ i)}
          ∃ (_hAffV : AlgebraicGeometry.IsAffineOpen V)
            (e_V : (↑(Q.presheaf.obj (Opposite.op W)) ⧸ J_W) ≃+*
              ↑(Y_sch.presheaf.obj (Opposite.op V))),
            ∀ s : ↑(Q.presheaf.obj (Opposite.op W)),
              (ι_Y.appLE W V hV.le).hom s = e_V (Ideal.Quotient.mk J_W s)) := by
    intro Q ι C hCov Φ hUnit
    let I : ∀ U : Q.affineOpens, Ideal ↑(Q.presheaf.obj (Opposite.op U.1)) :=
      fun U =>
        ⨅ (i : ι), ⨅ (W : Q.affineOpens), ⨅ (hW : W.1 ≤ U.1 ⊓ C i),
          Ideal.comap
            ((Q.presheaf.map (CategoryTheory.homOfLE (hW.trans inf_le_left)).op).hom)
            (Ideal.span
              {(Q.presheaf.map (CategoryTheory.homOfLE (hW.trans inf_le_right)).op).hom (Φ i)})
    have mem_I_iff : ∀ (U : Q.affineOpens) (b : ↑(Q.presheaf.obj (Opposite.op U.1))),
        b ∈ I U ↔
          ∀ (i : ι) (W : Q.affineOpens) (hW : W.1 ≤ U.1 ⊓ C i),
            (Q.presheaf.map (CategoryTheory.homOfLE (hW.trans inf_le_left)).op).hom b ∈
              Ideal.span
                {(Q.presheaf.map (CategoryTheory.homOfLE (hW.trans inf_le_right)).op).hom (Φ i)} := by
      intro U b; simp only [I, Ideal.mem_iInf, Ideal.mem_comap]
    have hResComp : ∀ {U₁ U₂ U₃ : Q.Opens} (h₁₂ : U₂ ≤ U₁) (h₂₃ : U₃ ≤ U₂)
        (x : ↑(Q.presheaf.obj (Opposite.op U₁))),
        (Q.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom
          ((Q.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom x) =
        (Q.presheaf.map (CategoryTheory.homOfLE (h₂₃.trans h₁₂)).op).hom x := by
      intro U₁ U₂ U₃ h₁₂ h₂₃ x
      have hcomp : Q.presheaf.map (CategoryTheory.homOfLE h₁₂).op ≫
          Q.presheaf.map (CategoryTheory.homOfLE h₂₃).op =
          Q.presheaf.map (CategoryTheory.homOfLE (h₂₃.trans h₁₂)).op := by
        rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.op_comp]; rfl
      exact congrArg
        (fun f : Q.presheaf.obj (Opposite.op U₁) ⟶ Q.presheaf.obj (Opposite.op U₃) => f.hom x) hcomp
    have hChart : ∀ (U : Q.affineOpens) (i₀ : ι) (hU₀ : U.1 ≤ C i₀),
        I U = Ideal.span {(Q.presheaf.map (CategoryTheory.homOfLE hU₀).op).hom (Φ i₀)} := by
      intro U i₀ hU₀
      apply le_antisymm
      · intro b hb
        have hb₀ := (mem_I_iff U b).mp hb i₀ U (le_inf (le_refl U.1) hU₀)
        have hid : Q.presheaf.map (CategoryTheory.homOfLE (le_refl U.1)).op = 𝟙 _ := by
          rw [Subsingleton.elim (CategoryTheory.homOfLE (le_refl U.1)) (𝟙 U.1),
            CategoryTheory.op_id, CategoryTheory.Functor.map_id]
        simpa [hid] using hb₀
      · rw [Ideal.span_singleton_le_iff_mem, mem_I_iff]
        intro i W hW
        have hW_ov : W.1 ≤ C i₀ ⊓ C i :=
          le_inf ((hW.trans inf_le_left).trans hU₀) (hW.trans inf_le_right)
        obtain ⟨u, _, hu⟩ := hUnit i₀ i
        rw [hResComp hU₀ (hW.trans inf_le_left) (Φ i₀)]
        have hLHS : (Q.presheaf.map (CategoryTheory.homOfLE ((hW.trans inf_le_left).trans hU₀)).op).hom (Φ i₀) =
            (Q.presheaf.map (CategoryTheory.homOfLE hW_ov).op).hom
              ((Q.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (Φ i₀)) :=
          (hResComp inf_le_left hW_ov (Φ i₀)).symm
        rw [hLHS, hu, map_mul, hResComp inf_le_right hW_ov (Φ i)]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
    have hAwayClear : ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
        (f : R) [IsLocalization.Away f S] (b ϕ : R),
        algebraMap R S b ∈ Ideal.span {algebraMap R S ϕ} →
        ∃ d : ℕ, f ^ d * b ∈ Ideal.span {ϕ} := by
      intro R S _ _ _ f _ b ϕ hmem
      rw [Ideal.mem_span_singleton] at hmem
      obtain ⟨q, hq⟩ := hmem
      obtain ⟨m₁, c, hc⟩ := IsLocalization.Away.surj f q
      have heq : algebraMap R S (f ^ m₁ * b) = algebraMap R S (c * ϕ) := by
        calc algebraMap R S (f ^ m₁ * b)
          _ = (algebraMap R S f) ^ m₁ * algebraMap R S b := by rw [map_mul, map_pow]
          _ = (algebraMap R S f) ^ m₁ * (algebraMap R S ϕ * q) := by rw [hq]
          _ = (q * (algebraMap R S f) ^ m₁) * algebraMap R S ϕ := by ring
          _ = algebraMap R S c * algebraMap R S ϕ := by rw [hc]
          _ = algebraMap R S (c * ϕ) := (map_mul _ _ _).symm
      obtain ⟨⟨s, m₂, hm₂⟩, hs_eq⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers f) heq
      dsimp at hm₂ hs_eq
      refine ⟨m₂ + m₁, Ideal.mem_span_singleton.mpr ⟨f ^ m₂ * c, ?_⟩⟩
      calc f ^ (m₂ + m₁) * b
        _ = f ^ m₂ * (f ^ m₁ * b) := by rw [pow_add, mul_assoc]
        _ = s * (f ^ m₁ * b) := by rw [hm₂]
        _ = s * (c * ϕ) := hs_eq
        _ = f ^ m₂ * (c * ϕ) := by rw [← hm₂]
        _ = ϕ * (f ^ m₂ * c) := by ring
    have hPartition : ∀ (U : Q.affineOpens),
        ∃ (n : ℕ) (g : Fin n → ↑(Q.presheaf.obj (Opposite.op U.1)))
          (idx : Fin n → ι) (h_le : ∀ k : Fin n, Q.basicOpen (g k) ≤ C (idx k)),
          Ideal.span (Set.range g) = ⊤ ∧
          ∀ b : ↑(Q.presheaf.obj (Opposite.op U.1)),
            (∀ k : Fin n,
              (Q.presheaf.map (CategoryTheory.homOfLE (Q.basicOpen_le (g k))).op).hom b ∈
                Ideal.span {(Q.presheaf.map (CategoryTheory.homOfLE (h_le k)).op).hom (Φ (idx k))}) →
            b ∈ I U := by
      intro U
      let R := ↑(Q.presheaf.obj (Opposite.op U.1))
      let S_U : Set R := { g : R | ∃ i : ι, Q.basicOpen g ≤ C i }
      have hU_le : U.1 ≤ ⨆ g : S_U, Q.basicOpen g.1 := by
        intro x hxU
        rw [TopologicalSpace.Opens.mem_iSup]
        have hx_top : x ∈ (⊤ : Q.Opens) := trivial
        rw [← hCov, TopologicalSpace.Opens.mem_iSup] at hx_top
        obtain ⟨i, hxCi⟩ := hx_top
        obtain ⟨g, hg_le, hxg⟩ :=
          U.2.exists_basicOpen_le (V := U.1 ⊓ C i) ⟨x, hxU, hxCi⟩ hxU
        exact ⟨⟨g, i, hg_le.trans inf_le_right⟩, hxg⟩
      have hSpanSU : Ideal.span S_U = ⊤ := U.2.self_le_iSup_basicOpen_iff.mp hU_le
      have h1_mem : (1 : R) ∈ Ideal.span S_U := by rw [hSpanSU]; trivial
      obtain ⟨n, r, g_sub, hsum1⟩ := Submodule.mem_span_set'.mp h1_mem
      let g : Fin n → R := fun k => (g_sub k).1
      let idx : Fin n → ι := fun k => Classical.choose (g_sub k).2
      have h_le : ∀ k : Fin n, Q.basicOpen (g k) ≤ C (idx k) :=
        fun k => Classical.choose_spec (g_sub k).2
      have hSpanG : Ideal.span (Set.range g) = ⊤ := by
        rw [Ideal.eq_top_iff_one, ← hsum1]
        refine Submodule.sum_mem _ fun k _ => ?_
        change r k * g k ∈ Ideal.span (Set.range g)
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)
      refine ⟨n, g, idx, h_le, hSpanG, fun b hb => ?_⟩
      rw [mem_I_iff]
      intro j W hW
      let A_W := ↑(Q.presheaf.obj (Opposite.op W.1))
      let res_UW : R →+* A_W :=
        (Q.presheaf.map (CategoryTheory.homOfLE (hW.trans inf_le_left)).op).hom
      let b_W : A_W := res_UW b
      let ϕ_W : A_W := (Q.presheaf.map (CategoryTheory.homOfLE (hW.trans inf_le_right)).op).hom (Φ j)
      let h_W : Fin n → A_W := fun k => res_UW (g k)
      have hSpanHW : Ideal.span (Set.range h_W) = ⊤ := by
        rw [Ideal.eq_top_iff_one]
        have h1W : (∑ k : Fin n, res_UW (r k) * h_W k) = 1 := by
          calc ∑ k : Fin n, res_UW (r k) * h_W k
            _ = res_UW (∑ k : Fin n, r k * g k) := by simp [h_W, map_sum, map_mul]
            _ = res_UW 1 := congrArg res_UW hsum1
            _ = 1 := map_one res_UW
        rw [← h1W]
        refine Submodule.sum_mem _ fun k _ => ?_
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)
      have hd_ex : ∀ k : Fin n, ∃ d : ℕ, (h_W k) ^ d * b_W ∈ Ideal.span {ϕ_W} := by
        intro k
        let hk := h_W k
        have hBasic_hk : Q.basicOpen hk = W.1 ⊓ Q.basicOpen (g k) :=
          Q.toRingedSpace.basicOpen_res (CategoryTheory.homOfLE (hW.trans inf_le_left)).op (g k)
        have h_le_gk : Q.basicOpen hk ≤ Q.basicOpen (g k) := hBasic_hk.le.trans inf_le_right
        have h_le_W : Q.basicOpen hk ≤ W.1 := Q.basicOpen_le hk
        have h_ov : Q.basicOpen hk ≤ C (idx k) ⊓ C j :=
          le_inf (h_le_gk.trans (h_le k)) (h_le_W.trans (hW.trans inf_le_right))
        obtain ⟨u_kj, _, hu_kj⟩ := hUnit (idx k) j
        let res_W_hk : A_W →+* ↑(Q.presheaf.obj (Opposite.op (Q.basicOpen hk))) :=
          (Q.presheaf.map (CategoryTheory.homOfLE h_le_W).op).hom
        let _ : Algebra A_W ↑(Q.presheaf.obj (Opposite.op (Q.basicOpen hk))) := res_W_hk.toAlgebra
        have _ : IsLocalization.Away hk ↑(Q.presheaf.obj (Opposite.op (Q.basicOpen hk))) :=
          W.2.isLocalization_basicOpen hk
        apply hAwayClear (S := ↑(Q.presheaf.obj (Opposite.op (Q.basicOpen hk)))) hk b_W ϕ_W
        change res_W_hk b_W ∈ Ideal.span {res_W_hk ϕ_W}
        have hb_hk : res_W_hk b_W =
            (Q.presheaf.map (CategoryTheory.homOfLE h_le_gk).op).hom
              ((Q.presheaf.map (CategoryTheory.homOfLE (Q.basicOpen_le (g k))).op).hom b) := by
          dsimp [res_W_hk, b_W, res_UW]; rw [hResComp, hResComp]
        have hbk_mem : (Q.presheaf.map (CategoryTheory.homOfLE h_le_gk).op).hom
            ((Q.presheaf.map (CategoryTheory.homOfLE (Q.basicOpen_le (g k))).op).hom b) ∈
            Ideal.span {(Q.presheaf.map (CategoryTheory.homOfLE (h_le_gk.trans (h_le k))).op).hom
              (Φ (idx k))} := by
          obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp (hb k)
          refine Ideal.mem_span_singleton.mpr ⟨(Q.presheaf.map (CategoryTheory.homOfLE h_le_gk).op).hom q, ?_⟩
          rw [hq, map_mul, hResComp]
        rw [hb_hk]
        have hsub_span : Ideal.span
            {(Q.presheaf.map (CategoryTheory.homOfLE (h_le_gk.trans (h_le k))).op).hom (Φ (idx k))} ≤
            Ideal.span {res_W_hk ϕ_W} := by
          rw [Ideal.span_singleton_le_iff_mem]
          have hΦ_eq : (Q.presheaf.map (CategoryTheory.homOfLE (h_le_gk.trans (h_le k))).op).hom (Φ (idx k)) =
              (Q.presheaf.map (CategoryTheory.homOfLE h_ov).op).hom
                ((Q.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (Φ (idx k))) :=
            (hResComp inf_le_left h_ov (Φ (idx k))).symm
          rw [hΦ_eq, hu_kj, map_mul, hResComp inf_le_right h_ov (Φ j)]
          have hϕ_eq : (Q.presheaf.map (CategoryTheory.homOfLE (h_ov.trans inf_le_right)).op).hom (Φ j) =
              res_W_hk ϕ_W := by dsimp [res_W_hk, ϕ_W]; rw [hResComp]
          rw [hϕ_eq]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
        exact hsub_span hbk_mem
      let S_W : Set A_W := Set.range h_W
      have hd_SW : ∀ x : S_W, ∃ d : ℕ, (x : A_W) ^ d * b_W ∈ Ideal.span {ϕ_W} := by
        rintro ⟨x, k, rfl⟩; exact hd_ex k
      let d_fn : S_W → ℕ := fun x => Classical.choose (hd_SW x)
      have hPowTop : Ideal.span (Set.range fun x : S_W => (x : A_W) ^ d_fn x) = ⊤ :=
        Ideal.span_range_pow_eq_top S_W hSpanHW d_fn
      have h1_pow : (1 : A_W) ∈ Ideal.span (Set.range fun x : S_W => (x : A_W) ^ d_fn x) := by
        rw [hPowTop]; trivial
      have hMulMem : ∀ z ∈ Ideal.span (Set.range fun x : S_W => (x : A_W) ^ d_fn x),
          z * b_W ∈ Ideal.span {ϕ_W} := by
        intro z hz
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
        · rintro _ ⟨x, rfl⟩; exact Classical.choose_spec (hd_SW x)
        · rw [zero_mul]; exact Ideal.zero_mem _
        · intro x₁ x₂ _ _ hx₁ hx₂; rw [add_mul]; exact Ideal.add_mem _ hx₁ hx₂
        · intro c x₁ _ hx₁
          change (c * x₁) * b_W ∈ Ideal.span {ϕ_W}
          rw [mul_assoc]; exact Ideal.mul_mem_left _ c hx₁
      simpa [one_mul] using hMulMem 1 h1_pow
    have hMapBasic : ∀ (U : Q.affineOpens) (f : ↑(Q.presheaf.obj (Opposite.op U.1))),
        Ideal.map ((Q.presheaf.map (CategoryTheory.homOfLE (Q.basicOpen_le f)).op).hom) (I U) =
          I (Q.affineBasicOpen f) := by
      intro U f
      let R := ↑(Q.presheaf.obj (Opposite.op U.1))
      let U_f : Q.affineOpens := ⟨Q.basicOpen f, U.2.basicOpen f⟩
      let ρ_f : R →+* ↑(Q.presheaf.obj (Opposite.op U_f.1)) :=
        (Q.presheaf.map (CategoryTheory.homOfLE (Q.basicOpen_le f)).op).hom
      change Ideal.map ρ_f (I U) = I U_f
      apply le_antisymm
      · intro y hy
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
        · rintro _ ⟨a, ha, rfl⟩
          rw [mem_I_iff]
          intro i W hW
          have hW' : W.1 ≤ U.1 ⊓ C i :=
            le_inf ((hW.trans inf_le_left).trans (Q.basicOpen_le f)) (hW.trans inf_le_right)
          have ha' := (mem_I_iff U a).mp ha i W hW'
          dsimp [ρ_f]
          rwa [hResComp (Q.basicOpen_le f) (hW.trans inf_le_left) a]
        · exact Ideal.zero_mem _
        · intro x₁ x₂ _ _ hx₁ hx₂; exact Ideal.add_mem _ hx₁ hx₂
        · intro c x₁ _ hx₁; exact Ideal.mul_mem_left _ c hx₁
      · intro y hy
        let _ : Algebra R ↑(Q.presheaf.obj (Opposite.op (Q.basicOpen f))) := ρ_f.toAlgebra
        have _ : IsLocalization.Away f ↑(Q.presheaf.obj (Opposite.op (Q.basicOpen f))) :=
          U.2.isLocalization_basicOpen f
        obtain ⟨n₀, a, ha_eq⟩ := IsLocalization.Away.surj f y
        have hρa_mem : ρ_f a ∈ I U_f := by
          change algebraMap R ↑(Q.presheaf.obj (Opposite.op (Q.basicOpen f))) a ∈ I U_f
          rw [← ha_eq, mul_comm]
          exact Ideal.mul_mem_left _ _ hy
        obtain ⟨n, g, idx, h_le, _, hCrit⟩ := hPartition U
        have hm_ex : ∀ k : Fin n, ∃ m : ℕ,
            (Q.presheaf.map (CategoryTheory.homOfLE (Q.basicOpen_le (g k))).op).hom (f ^ m * a) ∈
              Ideal.span {(Q.presheaf.map (CategoryTheory.homOfLE (h_le k)).op).hom (Φ (idx k))} := by
          intro k
          let W_k : Q.affineOpens := ⟨Q.basicOpen (g k), U.2.basicOpen (g k)⟩
          let res_k : R →+* ↑(Q.presheaf.obj (Opposite.op (Q.basicOpen (g k)))) :=
            (Q.presheaf.map (CategoryTheory.homOfLE (Q.basicOpen_le (g k))).op).hom
          let f_k := res_k f
          let W_kf : Q.affineOpens := ⟨Q.basicOpen f_k, W_k.2.basicOpen f_k⟩
          have hBasic_fk : W_kf.1 = Q.basicOpen (g k) ⊓ Q.basicOpen f :=
            Q.toRingedSpace.basicOpen_res (CategoryTheory.homOfLE (Q.basicOpen_le (g k))).op f
          have hW_kf_le : W_kf.1 ≤ U_f.1 ⊓ C (idx k) :=
            le_inf (hBasic_fk.le.trans inf_le_right)
              ((hBasic_fk.le.trans inf_le_left).trans (h_le k))
          have hmem_kf := (mem_I_iff U_f (ρ_f a)).mp hρa_mem (idx k) W_kf hW_kf_le
          let res_Wk_Wkf : ↑(Q.presheaf.obj (Opposite.op (Q.basicOpen (g k)))) →+*
              ↑(Q.presheaf.obj (Opposite.op (Q.basicOpen f_k))) :=
            (Q.presheaf.map (CategoryTheory.homOfLE (Q.basicOpen_le f_k)).op).hom
          let _ : Algebra ↑(Q.presheaf.obj (Opposite.op (Q.basicOpen (g k))))
              ↑(Q.presheaf.obj (Opposite.op (Q.basicOpen f_k))) := res_Wk_Wkf.toAlgebra
          have _ : IsLocalization.Away f_k ↑(Q.presheaf.obj (Opposite.op (Q.basicOpen f_k))) :=
            W_k.2.isLocalization_basicOpen f_k
          have hmem_loc : res_Wk_Wkf (res_k a) ∈
              Ideal.span {res_Wk_Wkf ((Q.presheaf.map (CategoryTheory.homOfLE (h_le k)).op).hom (Φ (idx k)))} := by
            have hLHS_kf : res_Wk_Wkf (res_k a) =
                (Q.presheaf.map (CategoryTheory.homOfLE (hW_kf_le.trans inf_le_left)).op).hom (ρ_f a) := by
              dsimp [res_Wk_Wkf, res_k, ρ_f]
              rw [hResComp (Q.basicOpen_le (g k)) (Q.basicOpen_le f_k) a,
                hResComp (Q.basicOpen_le f) (hW_kf_le.trans inf_le_left) a]
