        have hm₁_sec :
            CommRingCat.ofHom m₁ ≫ AlgebraicGeometry.Proj.awayToSection 𝒜 x_prod ≫
              f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 x_prod) W hW_prod =
            AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X α) ≫ f_X.appLE (D α) W hWα := by
          have h1 := AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜 (hX_deg α')
            (rfl : x_prod = MvPolynomial.X α * MvPolynomial.X α')
          rw [← CategoryTheory.Category.assoc, h1, CategoryTheory.Category.assoc,
            AlgebraicGeometry.Scheme.Hom.map_appLE]
        have hm₂_sec :
            CommRingCat.ofHom m₂ ≫ AlgebraicGeometry.Proj.awayToSection 𝒜 x_prod ≫
              f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 x_prod) W hW_prod =
            AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X α') ≫ f_X.appLE (D α') W hWα' := by
          have h2 := AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜 (hX_deg α)
            (mul_comm (MvPolynomial.X α) (MvPolynomial.X α'))
          rw [← CategoryTheory.Category.assoc, h2, CategoryTheory.Category.assoc,
            AlgebraicGeometry.Scheme.Hom.map_appLE]
        let ρ_prod := (AlgebraicGeometry.Proj.awayToSection 𝒜 x_prod ≫
          f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 x_prod) W hW_prod).hom
        have hℓ_eq : ℓ_sec α W hWα j = ρ_prod (m₁ u_α) * ℓ_sec α' W hWα' j := by
          have hlhs : ℓ_sec α W hWα j = ρ_prod (m₁ (z_F α j)) := by
            show (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X α) ≫
              f_X.appLE (D α) W hWα).hom (z_F α j) =
              (CommRingCat.ofHom m₁ ≫ AlgebraicGeometry.Proj.awayToSection 𝒜 x_prod ≫
                f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 x_prod) W hW_prod).hom (z_F α j)
            rw [hm₁_sec]
          have hrhs : ℓ_sec α' W hWα' j = ρ_prod (m₂ (z_F α' j)) := by
            show (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X α') ≫
