            (Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert u₀ {τ₂})))
            (Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert_of_mem u₀ rfl)))
        · refine Ideal.span_le.mpr ?_
          intro z hz
          rcases Set.mem_insert_iff.mp hz with hzu | hz'
          · rw [hzu]
            have hu : u₀ ∈ RingHom.ker f := by
              rw [hf_ker]; exact Ideal.mem_span_singleton_self u₀
            change Ideal.Quotient.mk _ (f u₀) = 0
            rw [RingHom.mem_ker.mp hu, map_zero]
          · rw [Set.mem_singleton_iff.mp hz']
            change Ideal.Quotient.mk _ (f τ₂) = 0
            rw [hf_τ₂]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      let e_ring : (A₂_t ⧸ Ideal.span {u₀, τ₂}) ≃+* (B₂_t ⧸ Ideal.span {τ₁₂}) :=
        (Ideal.quotEquivOfEq hg_ker.symm).trans (RingHom.quotientKerEquivOfSurjective hg_surj)
      exact ⟨{ e_ring.toAddEquiv with
        map_smul' := fun c x => by
