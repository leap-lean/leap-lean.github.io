    · 
      intro I_net
      let A_net := A ⧸ I_net
      have hSm_mv : RingHom.IsStandardSmoothOfRelativeDimension 2
          (MvPolynomial.C : A_net →+* MvPolynomial (Fin 2) A_net) := by
        let f_mv : MvPolynomial (Fin 2) A_net →ₐ[A_net] MvPolynomial (Fin 2) A_net :=
          AlgHom.id A_net _
        have hf_mv_surj : Function.Surjective f_mv := fun x => ⟨x, rfl⟩
        let rel_mv : Fin 0 → MvPolynomial (Fin 2) A_net := Fin.elim0
        have hker_mv : Ideal.span (Set.range rel_mv) = RingHom.ker f_mv.toRingHom := by
          have hempty : Set.range rel_mv = ∅ := by
            ext x
            simp [rel_mv]
          rw [hempty, Ideal.span_empty]
          ext x
          simp [f_mv]
        obtain ⟨P_mv_pre, hP_mv_jac⟩ :=
          hMakePre f_mv hf_mv_surj rel_mv hker_mv Fin.elim0 (fun x => Fin.elim0 x)
        have hJac_mv : IsUnit P_mv_pre.jacobian := by
          rw [hP_mv_jac, Matrix.det_isEmpty]
          exact isUnit_one
        exact hSmoothOfPre P_mv_pre hJac_mv 2 (by simp)
      let f_net : k →+* A_net := (Ideal.Quotient.mk I_net).comp (φ.comp MvPolynomial.C)
      letI : Algebra k A_net := f_net.toAlgebra
      let ψ_net : MvPolynomial (Fin N₀) k →ₐ[k] A_net :=
        { ((Ideal.Quotient.mk I_net).comp φ) with commutes' := fun _ => rfl }
      have hψ_surj : Function.Surjective ψ_net :=
        Ideal.Quotient.mk_surjective.comp hφ_surj
      let H : Fin (s + 3) → MvPolynomial (Fin N₀) k := Fin.addCases q f_lift
      have hker_net : Ideal.span (Set.range H) = RingHom.ker ψ_net.toRingHom := by
        apply le_antisymm
        · rw [Ideal.span_le]
          rintro _ ⟨a, rfl⟩
          obtain ⟨x, rfl⟩ := finSumFinEquiv.surjective a
          rcases x with i | r
          · change Ideal.Quotient.mk I_net (φ (H (finSumFinEquiv (Sum.inl i)))) = 0
            rw [finSumFinEquiv_apply_left]
            dsimp [H]
            rw [Fin.addCases_left]
            have hqi : q i ∈ RingHom.ker φ := by
              rw [hφ_ker]
              exact Ideal.subset_span ⟨i, rfl⟩
            rw [RingHom.mem_ker.mp hqi, map_zero]
          · change Ideal.Quotient.mk I_net (φ (H (finSumFinEquiv (Sum.inr r)))) = 0
            rw [finSumFinEquiv_apply_right]
            dsimp [H]
            rw [Fin.addCases_right]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨r, rfl⟩)
        · intro P hP
          have hφP : φ P ∈ I_net := Ideal.Quotient.eq_zero_iff_mem.mp hP
          have hLift : ∃ Q ∈ Ideal.span (Set.range f_lift), φ Q = φ P := by
            refine Submodule.span_induction
              (p := fun y _ => ∃ Q ∈ Ideal.span (Set.range f_lift), φ Q = y)
              ?_ ?_ ?_ ?_ hφP
            · rintro _ ⟨r, rfl⟩
              exact ⟨f_lift r, Ideal.subset_span ⟨r, rfl⟩, rfl⟩
            · exact ⟨0, Submodule.zero_mem _, map_zero φ⟩
            · rintro _ _ _ _ ⟨Q₁, hQ₁, rfl⟩ ⟨Q₂, hQ₂, rfl⟩
              exact ⟨Q₁ + Q₂, Submodule.add_mem _ hQ₁ hQ₂, map_add φ Q₁ Q₂⟩
            · rintro a _ _ ⟨Q, hQ, rfl⟩
              obtain ⟨R₀, rfl⟩ := hφ_surj a
              exact ⟨R₀ * Q, Ideal.mul_mem_left _ R₀ hQ,
                (map_mul φ R₀ Q).trans (smul_eq_mul _ _).symm⟩
          obtain ⟨Q, hQ, hφQ⟩ := hLift
          have hPQ_ker : P - Q ∈ RingHom.ker φ := by
            rw [RingHom.mem_ker, map_sub, hφQ, sub_self]
          rw [hφ_ker] at hPQ_ker
          have hq_sub : Set.range q ⊆ Set.range H := by
            rintro _ ⟨i, rfl⟩
            exact ⟨Fin.castAdd 3 i, Fin.addCases_left i⟩
          have hf_sub : Set.range f_lift ⊆ Set.range H := by
            rintro _ ⟨r, rfl⟩
            exact ⟨Fin.natAdd s r, Fin.addCases_right r⟩
          have hPQ_H : P - Q ∈ Ideal.span (Set.range H) := Ideal.span_mono hq_sub hPQ_ker
          have hQ_H : Q ∈ Ideal.span (Set.range H) := Ideal.span_mono hf_sub hQ
          have hSum := Submodule.add_mem _ hPQ_H hQ_H
          rwa [sub_add_cancel] at hSum
      obtain ⟨P_net_pre, hP_net_jac⟩ :=
        hMakePre ψ_net hψ_surj H hker_net idx hidx_inj
      have hJac_net : IsUnit P_net_pre.jacobian := by
        rw [hP_net_jac]
        have hMat_net :
            (Matrix.of fun a b : Fin (s + 3) => ψ_net (MvPolynomial.pderiv (idx b) (H a))) =
            (Ideal.Quotient.mk I_net).mapMatrix (Matrix.of fun a b : Fin (s + 3) =>
              φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a))) := by
          ext a b
          rfl
        rw [hMat_net, ← RingHom.map_det]
        exact hdet_full.map (Ideal.Quotient.mk I_net)
      have hdim_net : Nat.card (Fin N₀) - Nat.card (Fin (s + 3)) = d₀ := by
        simp only [Nat.card_fin]
        dsimp [N₀]
        omega
      have hSm_net : RingHom.IsStandardSmoothOfRelativeDimension d₀ f_net :=
        hSmoothOfPre P_net_pre hJac_net d₀ hdim_net
      rw [Nat.add_comm d₀ 2]
      exact hSm_mv.comp hSm_net

theorem weil_algClosed_net_incidence_isIntegral (k : Type u) [Field k] [IsAlgClosed k]
    (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (L : Fin 3 → MvPolynomial (Fin (M + 1)) k)
    (hL_homog : ∀ r : Fin 3, L r ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
    (hL_nondeg : ∀ r : Fin 3,
      ∃ z : Z_bar.left, ι_bar.left.base z ∉ weilProjHyperplaneSet k M (L r))
    (hNet_m0 : m = 0 → ∀ z : Z_bar.left,
      ∃ r : Fin 3, ι_bar.left.base z ∉ weilProjHyperplaneSet k M (L r))
    (Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 3) Y₂.hom]
    (π_Y : Y₂ ⟶ Z_bar)
    (g₂ : Y₂ ⟶ weilProjectiveSpaceOver k 2)
    (hCov_Z :
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
        MvPolynomial.gradedAlgebra
      (⨆ (α : Fin (M + 1)),
        (TopologicalSpace.Opens.map ι_bar.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α))) = ⊤)
    (hCov_P :
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
        MvPolynomial.gradedAlgebra
      (⨆ (β : Fin 3),
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin 3) k) (MvPolynomial.X β) :
          (weilProjectiveSpaceOver k 2).left.Opens)) = ⊤)
    (hCharts :
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
        MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
        MvPolynomial.gradedAlgebra
      let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
      let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k
      ∀ (β : Fin 3) (α : Fin (M + 1))
        (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
        (U_Z : Z_bar.left.Opens)
        (hAffZ : AlgebraicGeometry.IsAffineOpen U_Z)
        (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α))),
        let D_β : (weilProjectiveSpaceOver k 2).left.Opens :=
          AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X β)
        let V_Y : Y₂.left.Opens :=
          (TopologicalSpace.Opens.map π_Y.left.base).obj U_Z ⊓
            (TopologicalSpace.Opens.map g₂.left.base).obj D_β
        let A := ↑(Z_bar.left.presheaf.obj (Opposite.op U_Z))
        let ℓ_r : Fin 3 → A := fun r =>
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
            ι_bar.left.appLE
              (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) U_Z hUZ).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
        let B_quot := MvPolynomial (Fin 2) A ⧸
          Ideal.span ({MvPolynomial.C (ℓ_r β) +
            MvPolynomial.C (ℓ_r (β.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
            MvPolynomial.C (ℓ_r (β.succAbove 1)) * MvPolynomial.X (1 : Fin 2)} :
              Set (MvPolynomial (Fin 2) A))
        ∃ (hAffVY : AlgebraicGeometry.IsAffineOpen V_Y)
          (e_Y : B_quot ≃+* ↑(Y₂.left.presheaf.obj (Opposite.op V_Y))),
          (∀ (z : ↥U_Z) (r : Fin 3),
            ι_bar.left.base z.1 ∈ weilProjHyperplaneSet k M (L r) ↔
              ℓ_r r ∈ (hAffZ.primeIdealOf z).asIdeal) ∧
          (∀ a : A,
            (π_Y.left.appLE U_Z V_Y inf_le_left).hom a =
              e_Y (Ideal.Quotient.mk _ (MvPolynomial.C a))) ∧
          (∀ (y : ↥V_Y) (i : Fin 2),
            g₂.left.base y.1 ∈
              AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X (β.succAbove i)) ↔
              e_Y (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∉
                (hAffVY.primeIdealOf y).asIdeal))
    (hAxis_sm :
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
        MvPolynomial.gradedAlgebra
      let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
      1 ≤ m → ∀ z : Z_bar.left,
        (∀ r : Fin 3, ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L r)) →
        ∃ (α : Fin (M + 1))
          (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
          (V_Z : Z_bar.left.Opens)
          (_ : AlgebraicGeometry.IsAffineOpen V_Z)
          (hVZ : V_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)))
          (κ_net : k →+* MvPolynomial (Fin 2)
            (↑(Z_bar.left.presheaf.obj (Opposite.op V_Z)) ⧸
              Ideal.span (Set.range (fun r : Fin 3 =>
                ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M
                    (MvPolynomial.X α) hXα zero_lt_one).hom ≫
                  ι_bar.left.appLE
                    (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) V_Z hVZ).hom
                  (HomogeneousLocalization.mk
                    ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩))))),
          z ∈ V_Z ∧ RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 1) κ_net) :
    AlgebraicGeometry.IsIntegral Y₂.left :=
by
  classical
  have hOffAlg : ∀ (A : Type u) [CommRing A] (ℓ : Fin 3 → A) (r : Fin 3), IsUnit (ℓ r) →
      (let I_r : Ideal (MvPolynomial (Fin 2) A) :=
         Ideal.span ({MvPolynomial.C (ℓ r) +
           MvPolynomial.C (ℓ (r.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
           MvPolynomial.C (ℓ (r.succAbove 1)) * MvPolynomial.X (1 : Fin 2)} :
             Set (MvPolynomial (Fin 2) A))
       ∀ 𝔭 : PrimeSpectrum (MvPolynomial (Fin 2) A ⧸ I_r),
         ∃ i : Fin 2, Ideal.Quotient.mk I_r (MvPolynomial.X i) ∉ 𝔭.asIdeal) ∧
      (IsDomain A →
        (∀ (β : Fin 3), β ≠ r →
          let I_β : Ideal (MvPolynomial (Fin 2) A) :=
            Ideal.span ({MvPolynomial.C (ℓ β) +
              MvPolynomial.C (ℓ (β.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
              MvPolynomial.C (ℓ (β.succAbove 1)) * MvPolynomial.X (1 : Fin 2)} :
                Set (MvPolynomial (Fin 2) A))
          IsDomain (MvPolynomial (Fin 2) A ⧸ I_β)) ∧
        (let β₀ : Fin 3 := r.succAbove 0
         let β₁ : Fin 3 := r.succAbove 1
         let I_β₀ : Ideal (MvPolynomial (Fin 2) A) :=
           Ideal.span ({MvPolynomial.C (ℓ β₀) +
             MvPolynomial.C (ℓ (β₀.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
             MvPolynomial.C (ℓ (β₀.succAbove 1)) * MvPolynomial.X (1 : Fin 2)} :
               Set (MvPolynomial (Fin 2) A))
         ∃ (i₁ : Fin 2) (𝔭 : PrimeSpectrum (MvPolynomial (Fin 2) A ⧸ I_β₀)),
           β₀.succAbove i₁ = β₁ ∧
           Ideal.Quotient.mk I_β₀ (MvPolynomial.X i₁) ∉ 𝔭.asIdeal)) := by
    intro A _ ℓ r hUnit
    have hElim : ∀ (β : Fin 3), β ≠ r →
        let I_β : Ideal (MvPolynomial (Fin 2) A) :=
          Ideal.span ({MvPolynomial.C (ℓ β) +
            MvPolynomial.C (ℓ (β.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
            MvPolynomial.C (ℓ (β.succAbove 1)) * MvPolynomial.X (1 : Fin 2)} :
              Set (MvPolynomial (Fin 2) A))
        ∃ (i₁ : Fin 2) (e : Polynomial A ≃+* (MvPolynomial (Fin 2) A ⧸ I_β)),
          β.succAbove i₁ ≠ r ∧ e Polynomial.X = Ideal.Quotient.mk I_β (MvPolynomial.X i₁) := by
      intro β hβ_ne I_β
      obtain ⟨i₀, hi₀⟩ := Fin.exists_succAbove_eq hβ_ne.symm
      rcases hUnit with ⟨u₀, hu₀⟩
      let u : A := ↑(u₀⁻¹)
      have hu_mul : u * ℓ r = 1 := by rw [← hu₀]; exact Units.inv_mul u₀
      have hmul_u : ℓ r * u = 1 := by rw [mul_comm]; exact hu_mul
      have hCu : Polynomial.C (ℓ r) * Polynomial.C u = (1 : Polynomial A) := by
        rw [← Polynomial.C_mul, hmul_u, Polynomial.C_1]
      have hG0 : Ideal.Quotient.mk I_β (MvPolynomial.C (ℓ β) +
          MvPolynomial.C (ℓ (β.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
          MvPolynomial.C (ℓ (β.succAbove 1)) * MvPolynomial.X (1 : Fin 2)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      have hqCu : Ideal.Quotient.mk I_β (MvPolynomial.C u) *
          Ideal.Quotient.mk I_β (MvPolynomial.C (ℓ r)) = 1 := by
        rw [← map_mul, ← MvPolynomial.C_mul, hu_mul, map_one, map_one]
      fin_cases i₀
      · dsimp at hi₀
        have hi₁_ne : β.succAbove 1 ≠ r := by
          rw [← hi₀]
          exact (Fin.succAbove_right_injective (p := β)).ne (by decide)
        let ψ : Polynomial A →+* (MvPolynomial (Fin 2) A ⧸ I_β) :=
          Polynomial.eval₂RingHom ((Ideal.Quotient.mk I_β).comp MvPolynomial.C)
            (Ideal.Quotient.mk I_β (MvPolynomial.X 1))
        let v₀ : Polynomial A :=
          -Polynomial.C u * (Polynomial.C (ℓ β) + Polynomial.C (ℓ (β.succAbove 1)) * Polynomial.X)
        let φ₀ : MvPolynomial (Fin 2) A →+* Polynomial A :=
          MvPolynomial.eval₂Hom Polynomial.C ![v₀, Polynomial.X]
        have hker : ∀ x ∈ I_β, φ₀ x = 0 := by
          intro x hx
          have hle : I_β ≤ RingHom.ker φ₀ := by
            rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
            simp only [φ₀, hi₀, map_add, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
              Matrix.cons_val_zero, Matrix.cons_val_one, v₀]
            linear_combination -(Polynomial.C (ℓ β) + Polynomial.C (ℓ (β.succAbove 1)) * Polynomial.X) * hCu
          exact RingHom.mem_ker.mp (hle hx)
        let φ : (MvPolynomial (Fin 2) A ⧸ I_β) →+* Polynomial A :=
          Ideal.Quotient.lift I_β φ₀ hker
        have hφψ : φ.comp ψ = RingHom.id (Polynomial A) := by
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext; intro a
            change φ (ψ (Polynomial.C a)) = Polynomial.C a
            simp [ψ, φ, φ₀, Polynomial.eval₂_C, MvPolynomial.eval₂Hom_C]
          · change φ (ψ Polynomial.X) = Polynomial.X
            simp [ψ, φ, φ₀, Polynomial.eval₂_X, MvPolynomial.eval₂Hom_X']
        have hψφ : ψ.comp φ = RingHom.id (MvPolynomial (Fin 2) A ⧸ I_β) := by
          apply Ideal.Quotient.ringHom_ext
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext; intro a
            change ψ (φ (Ideal.Quotient.mk I_β (MvPolynomial.C a))) =
              Ideal.Quotient.mk I_β (MvPolynomial.C a)
            simp [ψ, φ, φ₀, Polynomial.eval₂_C, MvPolynomial.eval₂Hom_C]
          · intro i
            fin_cases i
            · change ψ (φ (Ideal.Quotient.mk I_β (MvPolynomial.X 0))) =
                Ideal.Quotient.mk I_β (MvPolynomial.X 0)
              simp only [φ, Ideal.Quotient.lift_mk, φ₀, MvPolynomial.eval₂Hom_X',
                Matrix.cons_val_zero, v₀, map_neg, map_mul, map_add, ψ, Polynomial.coe_eval₂RingHom,
                Polynomial.eval₂_C, Polynomial.eval₂_X, RingHom.comp_apply]
              rw [hi₀, map_add, map_add, map_mul, map_mul] at hG0
              linear_combination -Ideal.Quotient.mk I_β (MvPolynomial.C u) * hG0 +
                Ideal.Quotient.mk I_β (MvPolynomial.X 0) * hqCu
            · change ψ (φ (Ideal.Quotient.mk I_β (MvPolynomial.X 1))) =
                Ideal.Quotient.mk I_β (MvPolynomial.X 1)
              simp [ψ, φ, φ₀, Polynomial.eval₂_X, MvPolynomial.eval₂Hom_X']
        let e : Polynomial A ≃+* (MvPolynomial (Fin 2) A ⧸ I_β) :=
          { ψ with
            invFun := φ
            left_inv := fun p => RingHom.congr_fun hφψ p
            right_inv := fun q => RingHom.congr_fun hψφ q }
        exact ⟨1, e, hi₁_ne, by change ψ Polynomial.X = _; simp [ψ, Polynomial.eval₂_X]⟩
      · dsimp at hi₀
        have hi₁_ne : β.succAbove 0 ≠ r := by
          rw [← hi₀]
          exact (Fin.succAbove_right_injective (p := β)).ne (by decide)
        let ψ : Polynomial A →+* (MvPolynomial (Fin 2) A ⧸ I_β) :=
          Polynomial.eval₂RingHom ((Ideal.Quotient.mk I_β).comp MvPolynomial.C)
            (Ideal.Quotient.mk I_β (MvPolynomial.X 0))
        let v₁ : Polynomial A :=
          -Polynomial.C u * (Polynomial.C (ℓ β) + Polynomial.C (ℓ (β.succAbove 0)) * Polynomial.X)
        let φ₀ : MvPolynomial (Fin 2) A →+* Polynomial A :=
          MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, v₁]
        have hker : ∀ x ∈ I_β, φ₀ x = 0 := by
          intro x hx
          have hle : I_β ≤ RingHom.ker φ₀ := by
            rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
            simp only [φ₀, hi₀, map_add, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
              Matrix.cons_val_zero, Matrix.cons_val_one, v₁]
            linear_combination -(Polynomial.C (ℓ β) + Polynomial.C (ℓ (β.succAbove 0)) * Polynomial.X) * hCu
          exact RingHom.mem_ker.mp (hle hx)
        let φ : (MvPolynomial (Fin 2) A ⧸ I_β) →+* Polynomial A :=
          Ideal.Quotient.lift I_β φ₀ hker
        have hφψ : φ.comp ψ = RingHom.id (Polynomial A) := by
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext; intro a
            change φ (ψ (Polynomial.C a)) = Polynomial.C a
            simp [ψ, φ, φ₀, Polynomial.eval₂_C, MvPolynomial.eval₂Hom_C]
          · change φ (ψ Polynomial.X) = Polynomial.X
            simp [ψ, φ, φ₀, Polynomial.eval₂_X, MvPolynomial.eval₂Hom_X']
        have hψφ : ψ.comp φ = RingHom.id (MvPolynomial (Fin 2) A ⧸ I_β) := by
          apply Ideal.Quotient.ringHom_ext
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext; intro a
            change ψ (φ (Ideal.Quotient.mk I_β (MvPolynomial.C a))) =
              Ideal.Quotient.mk I_β (MvPolynomial.C a)
            simp [ψ, φ, φ₀, Polynomial.eval₂_C, MvPolynomial.eval₂Hom_C]
          · intro i
            fin_cases i
            · change ψ (φ (Ideal.Quotient.mk I_β (MvPolynomial.X 0))) =
                Ideal.Quotient.mk I_β (MvPolynomial.X 0)
              simp [ψ, φ, φ₀, Polynomial.eval₂_X, MvPolynomial.eval₂Hom_X']
            · change ψ (φ (Ideal.Quotient.mk I_β (MvPolynomial.X 1))) =
                Ideal.Quotient.mk I_β (MvPolynomial.X 1)
              simp only [φ, Ideal.Quotient.lift_mk, φ₀, MvPolynomial.eval₂Hom_X',
                Matrix.cons_val_one, Matrix.cons_val_zero, v₁, map_neg, map_mul, map_add, ψ,
                Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, Polynomial.eval₂_X,
                RingHom.comp_apply]
              rw [hi₀, map_add, map_add, map_mul, map_mul] at hG0
              linear_combination -Ideal.Quotient.mk I_β (MvPolynomial.C u) * hG0 +
                Ideal.Quotient.mk I_β (MvPolynomial.X 1) * hqCu
        let e : Polynomial A ≃+* (MvPolynomial (Fin 2) A ⧸ I_β) :=
          { ψ with
            invFun := φ
            left_inv := fun p => RingHom.congr_fun hφψ p
            right_inv := fun q => RingHom.congr_fun hψφ q }
        exact ⟨0, e, hi₁_ne, by change ψ Polynomial.X = _; simp [ψ, Polynomial.eval₂_X]⟩
    refine ⟨?_, ?_⟩
    · intro I_r 𝔭
      by_contra! hall
      have hG0 : Ideal.Quotient.mk I_r (MvPolynomial.C (ℓ r) +
          MvPolynomial.C (ℓ (r.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
          MvPolynomial.C (ℓ (r.succAbove 1)) * MvPolynomial.X (1 : Fin 2)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [map_add, map_add, map_mul, map_mul] at hG0
      have hsum_mem :
          Ideal.Quotient.mk I_r (MvPolynomial.C (ℓ (r.succAbove 0))) *
            Ideal.Quotient.mk I_r (MvPolynomial.X (0 : Fin 2)) +
          Ideal.Quotient.mk I_r (MvPolynomial.C (ℓ (r.succAbove 1))) *
            Ideal.Quotient.mk I_r (MvPolynomial.X (1 : Fin 2)) ∈ 𝔭.asIdeal :=
        Ideal.add_mem _ (Ideal.mul_mem_left _ _ (hall 0)) (Ideal.mul_mem_left _ _ (hall 1))
      have heq : Ideal.Quotient.mk I_r (MvPolynomial.C (ℓ r)) =
          -(Ideal.Quotient.mk I_r (MvPolynomial.C (ℓ (r.succAbove 0))) *
              Ideal.Quotient.mk I_r (MvPolynomial.X (0 : Fin 2)) +
            Ideal.Quotient.mk I_r (MvPolynomial.C (ℓ (r.succAbove 1))) *
              Ideal.Quotient.mk I_r (MvPolynomial.X (1 : Fin 2))) :=
        eq_neg_of_add_eq_zero_left (by linear_combination hG0)
      have hmem_unit : Ideal.Quotient.mk I_r (MvPolynomial.C (ℓ r)) ∈ 𝔭.asIdeal := by
        rw [heq]
        exact Submodule.neg_mem _ hsum_mem
      have hunit_q : IsUnit (Ideal.Quotient.mk I_r (MvPolynomial.C (ℓ r))) :=
        hUnit.map ((Ideal.Quotient.mk I_r).comp MvPolynomial.C)
      exact 𝔭.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem_unit hunit_q)
    · intro hDomA
      refine ⟨?_, ?_⟩
      · intro β hβ_ne I_β
        obtain ⟨_, e, _, _⟩ := hElim β hβ_ne
        exact Function.Injective.isDomain e.symm.toRingHom e.symm.injective
      · intro β₀ β₁ I_β₀
        have hβ₀_ne : β₀ ≠ r := Fin.succAbove_ne r 0
        obtain ⟨i₁, e, hi₁_ne_r, heX⟩ := hElim β₀ hβ₀_ne
        have hi₁_eq : β₀.succAbove i₁ = β₁ := by
          revert hi₁_ne_r
          dsimp [β₀, β₁]
          fin_cases r <;> fin_cases i₁ <;> decide
        obtain ⟨𝔪, h𝔪⟩ := Ideal.exists_maximal A
        have : 𝔪.IsPrime := h𝔪.isPrime
        let ev : (MvPolynomial (Fin 2) A ⧸ I_β₀) →+* A :=
          (Polynomial.evalRingHom 1).comp e.symm.toRingHom
        let 𝔭 : PrimeSpectrum (MvPolynomial (Fin 2) A ⧸ I_β₀) :=
          PrimeSpectrum.comap ev ⟨𝔪, h𝔪.isPrime⟩
        refine ⟨i₁, 𝔭, hi₁_eq, ?_⟩
        change ev (Ideal.Quotient.mk I_β₀ (MvPolynomial.X i₁)) ∉ 𝔪
        rw [← heX]
        simp only [ev, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
          RingEquiv.symm_apply_apply, Polynomial.coe_evalRingHom, Polynomial.eval_X]
        exact fun h1 => h𝔪.ne_top ((Ideal.eq_top_iff_one 𝔪).mpr h1)

  have hAxisLift :
      ∀ (A C₀ : Type u) [CommRing A] [CommRing C₀]
        (ℓ : Fin 3 → A) (β : Fin 3)
        (θ : (MvPolynomial (Fin 2) A ⧸
          Ideal.span ({MvPolynomial.C (ℓ β) +
            MvPolynomial.C (ℓ (β.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
            MvPolynomial.C (ℓ (β.succAbove 1)) * MvPolynomial.X (1 : Fin 2)} :
              Set (MvPolynomial (Fin 2) A))) →+* C₀),
        Function.Injective (PrimeSpectrum.comap θ) →
        (∀ (q : PrimeSpectrum C₀) (r : Fin 3),
          θ (Ideal.Quotient.mk _ (MvPolynomial.C (ℓ r))) ∈ q.asIdeal) →
        ∀ L₀ : LTSeries (PrimeSpectrum C₀),
          ∃ L_net : LTSeries (PrimeSpectrum
            (MvPolynomial (Fin 2) (A ⧸ Ideal.span (Set.range ℓ)))),
            L_net.length = L₀.length := by
    intro A C₀ _ _ ℓ β θ hθ_inj hθ_axis L₀
    let I_inc : Ideal (MvPolynomial (Fin 2) A) :=
      Ideal.span ({MvPolynomial.C (ℓ β) +
        MvPolynomial.C (ℓ (β.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
        MvPolynomial.C (ℓ (β.succAbove 1)) * MvPolynomial.X (1 : Fin 2)} :
          Set (MvPolynomial (Fin 2) A))
    let I_net : Ideal A := Ideal.span (Set.range ℓ)
    let q_A : A →+* A ⧸ I_net := Ideal.Quotient.mk I_net
    let S_net := MvPolynomial (Fin 2) (A ⧸ I_net)
    let π_axis : MvPolynomial (Fin 2) A →+* S_net := MvPolynomial.map q_A
    have hπ_surj : Function.Surjective π_axis :=
      MvPolynomial.map_surjective q_A Ideal.Quotient.mk_surjective
    have hqA_zero : ∀ r : Fin 3, q_A (ℓ r) = 0 := fun r =>
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨r, rfl⟩)
    have hI_le : ∀ x ∈ I_inc, π_axis x = 0 := by
      intro x hx
      have hle : I_inc ≤ RingHom.ker π_axis := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        dsimp [π_axis]
        rw [map_add, map_add, map_mul, map_mul, MvPolynomial.map_C, MvPolynomial.map_C,
          MvPolynomial.map_C, hqA_zero, hqA_zero, hqA_zero]
        simp
      exact RingHom.mem_ker.mp (hle hx)
    let π_bar : (MvPolynomial (Fin 2) A ⧸ I_inc) →+* S_net :=
      Ideal.Quotient.lift I_inc π_axis hI_le
    have hπ_bar_surj : Function.Surjective π_bar := by
      intro s
      obtain ⟨P, rfl⟩ := hπ_surj s
      exact ⟨Ideal.Quotient.mk I_inc P, rfl⟩
    have hker_le : ∀ q : PrimeSpectrum C₀, RingHom.ker π_bar ≤ Ideal.comap θ q.asIdeal := by
      intro q b hb
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective b
      have hP_ker : P ∈ RingHom.ker (MvPolynomial.map q_A) := hb
      rw [MvPolynomial.ker_map, Ideal.mk_ker] at hP_ker
      have hmap_le : Ideal.map MvPolynomial.C I_net ≤
          Ideal.comap (θ.comp (Ideal.Quotient.mk I_inc)) q.asIdeal := by
        rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
        rintro _ ⟨r, rfl⟩
        exact hθ_axis q r
      exact hmap_le hP_ker
    let Ψ : PrimeSpectrum C₀ → PrimeSpectrum S_net := fun q =>
      ⟨Ideal.map π_bar (PrimeSpectrum.comap θ q).asIdeal,
        Ideal.map_isPrime_of_surjective hπ_bar_surj (hker_le q)⟩
    have hΨ_mono : Monotone Ψ := fun q₁ q₂ hle =>
      Ideal.map_mono (Ideal.comap_mono hle)
    have hΨ_inj : Function.Injective Ψ := by
      intro q₁ q₂ heq
      have h1 := congrArg (Ideal.comap π_bar ∘ PrimeSpectrum.asIdeal) heq
      dsimp [Ψ] at h1
      rw [Ideal.comap_map_of_surjective π_bar hπ_bar_surj,
        Ideal.comap_map_of_surjective π_bar hπ_bar_surj,
        ← RingHom.ker_eq_comap_bot,
        sup_eq_left.mpr (hker_le q₁), sup_eq_left.mpr (hker_le q₂)] at h1
      exact hθ_inj (PrimeSpectrum.ext h1)
    have hΨ_strict : StrictMono Ψ := fun q₁ q₂ hlt =>
      lt_of_le_of_ne (hΨ_mono hlt.le) (fun heq => hlt.ne (hΨ_inj heq))
    exact ⟨L₀.map Ψ (fun _ _ h => hΨ_strict h), rfl⟩

  have hPrimeBounds :
      (∀ (k₀ : Type u) [Field k₀] [Infinite k₀] (d : ℕ) (C₀ : Type u) [CommRing C₀]
          [Nonempty (PrimeSpectrum C₀)] (f : k₀ →+* C₀),
        RingHom.IsStandardSmoothOfRelativeDimension d f →
        ∃ L : LTSeries (PrimeSpectrum C₀), L.length = d) ∧
      (∀ (k₀ : Type u) [Field k₀] (d : ℕ) (S : Type u) [CommRing S] (f : k₀ →+* S),
        RingHom.IsStandardSmoothOfRelativeDimension d f →
        ∀ L : LTSeries (PrimeSpectrum S), L.length ≤ d) := by
    refine ⟨?_, ?_⟩
    · intro k₀ _ _ d C₀ _ hneSpec f hf
      obtain ⟨g, _, hg⟩ := hf.exists_etale_mvPolynomial
      let P := MvPolynomial (Fin d) k₀
      let _ : Algebra P C₀ := g.toAlgebra
      have : Algebra.Etale P C₀ := hg
      have : Algebra.HasGoingDown P C₀ := Algebra.HasGoingDown.of_flat
      have hOpenMap : IsOpenMap (PrimeSpectrum.comap (algebraMap P C₀)) :=
        PrimeSpectrum.isOpenMap_comap_of_hasGoingDown_of_finitePresentation
      obtain ⟨q_init⟩ := hneSpec
      have hmem_range : PrimeSpectrum.comap (algebraMap P C₀) q_init ∈
          Set.range (PrimeSpectrum.comap (algebraMap P C₀)) := ⟨q_init, rfl⟩
      obtain ⟨_, ⟨_, ⟨h, rfl⟩, rfl⟩, hp_mem_h, hh_sub⟩ :=
        PrimeSpectrum.isBasis_basic_opens.exists_subset_of_mem_open hmem_range hOpenMap.isOpen_range
      have hh_ne : h ≠ 0 := fun h0 => hp_mem_h (h0 ▸ Ideal.zero_mem _)
      have hex_a : ∃ a : Fin d → k₀, MvPolynomial.eval a h ≠ 0 := by
        by_contra! hall
        exact hh_ne (MvPolynomial.funext_iff.mpr fun a => by simp [hall a])
      obtain ⟨a, ha⟩ := hex_a
      let φ : Fin (d + 1) → (P →+* P) := fun j =>
        MvPolynomial.eval₂Hom MvPolynomial.C
          (fun i : Fin d => if i.1 < j.1 then MvPolynomial.C (a i) else MvPolynomial.X i)
      let 𝔭 : Fin (d + 1) → PrimeSpectrum P := fun j =>
        ⟨RingHom.ker (φ j), RingHom.ker_isPrime (φ j)⟩
      have hstep : ∀ j : Fin d, 𝔭 j.castSucc < 𝔭 j.succ := by
        intro j
        have hcomp_j : (φ j.succ).comp (φ j.castSucc) = φ j.succ := by
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext; intro c
            dsimp only [φ, RingHom.comp_apply]
            rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
          · intro i
            dsimp only [φ, RingHom.comp_apply]
            rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
            by_cases h1 : i.1 < (j.castSucc).1
            · have h2 : i.1 < (j.succ).1 := Nat.lt_succ_of_lt h1
              simp only [h1, h2, ↓reduceIte]
              exact MvPolynomial.eval₂Hom_C _ _ (a i)
            · simp only [h1, ↓reduceIte]
              exact MvPolynomial.eval₂Hom_X' _ _ i
        have hle : 𝔭 j.castSucc ≤ 𝔭 j.succ := by
          intro x hx
          change φ j.succ x = 0
          have hx0 : φ j.castSucc x = 0 := hx
          rw [← hcomp_j, RingHom.comp_apply, hx0, map_zero]
        let w : P := MvPolynomial.X j - MvPolynomial.C (a j)
        have hw_in : w ∈ (𝔭 j.succ).asIdeal := by
          change φ j.succ w = 0
          dsimp only [w, φ]
          rw [map_sub, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C]
          simp only [Fin.val_succ, lt_add_iff_pos_right, zero_lt_one, ↓reduceIte, sub_self]
        have hw_out : w ∉ (𝔭 j.castSucc).asIdeal := by
          intro hw0
          have hw_eq : φ j.castSucc w = MvPolynomial.X j - MvPolynomial.C (a j) := by
            dsimp only [w, φ]
            rw [map_sub, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C]
            simp only [Fin.val_castSucc, lt_self_iff_false, ↓reduceIte]
          have hw_eval : MvPolynomial.eval (Function.update a j (a j + 1)) (φ j.castSucc w) = 1 := by
            rw [hw_eq]
            simp
          rw [show φ j.castSucc w = 0 from hw0, map_zero] at hw_eval
          exact zero_ne_one hw_eval
        exact lt_of_le_of_ne hle (fun heq => hw_out (heq ▸ hw_in))
      let l : LTSeries (PrimeSpectrum P) := RelSeries.mk d 𝔭 hstep
      have hφ_last : φ (Fin.last d) = MvPolynomial.C.comp (MvPolynomial.eval a) := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext; intro c
          simp only [RingHom.comp_apply, φ, MvPolynomial.eval₂Hom_C, MvPolynomial.eval_C]
        · intro i
          simp only [RingHom.comp_apply, φ, MvPolynomial.eval₂Hom_X', Fin.val_last, i.isLt,
            ↓reduceIte, MvPolynomial.eval_X]
      have hp_last_mem : l.last ∈ (PrimeSpectrum.basicOpen h : Set (PrimeSpectrum P)) := by
        change h ∉ (𝔭 (Fin.last d)).asIdeal
        intro hh0
        have hc0 : MvPolynomial.C (MvPolynomial.eval a h) = (0 : P) := by
          have h1 : φ (Fin.last d) h = 0 := hh0
          rwa [hφ_last, RingHom.comp_apply] at h1
        have hev0 : MvPolynomial.eval a h = 0 := by
          simpa using congrArg MvPolynomial.constantCoeff hc0
        exact ha hev0
      obtain ⟨Q_d, hQd⟩ := hh_sub hp_last_mem
      have : Q_d.asIdeal.IsPrime := Q_d.isPrime
      have : Q_d.asIdeal.LiesOver l.last.asIdeal := ⟨congrArg PrimeSpectrum.asIdeal hQd.symm⟩
      obtain ⟨L_chain, hL_len, _⟩ := Ideal.exists_ltSeries_of_hasGoingDown l Q_d.asIdeal
      exact ⟨L_chain, hL_len⟩
    · intro k₀ _ d S _ f hf L_chain
      obtain ⟨g, _, hg⟩ := hf.exists_etale_mvPolynomial
      let P := MvPolynomial (Fin d) k₀
      let _ : Algebra P S := g.toAlgebra
      have : Algebra.Etale P S := hg
      have hStrict : StrictMono (PrimeSpectrum.comap (algebraMap P S)) := by
        intro q₁ q₂ hlt
        refine lt_of_le_of_ne (Ideal.comap_mono hlt.le) fun heq => ?_
        let 𝔭 : PrimeSpectrum P := PrimeSpectrum.comap (algebraMap P S) q₂
        have h𝔭_eq : 𝔭.asIdeal = Ideal.comap (algebraMap P S) q₂.asIdeal := rfl
        have h𝔭_q₁ : 𝔭.asIdeal = Ideal.comap (algebraMap P S) q₁.asIdeal :=
          (congrArg PrimeSpectrum.asIdeal heq).symm
        let R₀ := Localization.AtPrime 𝔭.asIdeal
        let S₀ := Localization.AtPrime q₂.asIdeal
        let locHom : R₀ →+* S₀ :=
          Localization.localRingHom 𝔭.asIdeal q₂.asIdeal (algebraMap P S) h𝔭_eq
        let _ : Algebra R₀ S₀ := locHom.toAlgebra
        have : IsLocalHom (algebraMap R₀ S₀) :=
          Localization.isLocalHom_localRingHom 𝔭.asIdeal q₂.asIdeal (algebraMap P S) h𝔭_eq
        have : IsScalarTower P R₀ S₀ :=
          IsScalarTower.of_algebraMap_eq fun x =>
            (Localization.localRingHom_to_map 𝔭.asIdeal q₂.asIdeal (algebraMap P S) h𝔭_eq x).symm
        have : Algebra.FormallyUnramified P S₀ :=
          Algebra.FormallyUnramified.instLocalization (R := P) (S := S) q₂.asIdeal.primeCompl
        have : Algebra.FormallyUnramified R₀ S₀ :=
          Algebra.FormallyUnramified.localization_base 𝔭.asIdeal.primeCompl
        have : Algebra.EssFiniteType S S₀ :=
          Algebra.EssFiniteType.of_isLocalization S₀ q₂.asIdeal.primeCompl
        have : Algebra.EssFiniteType P S₀ := Algebra.EssFiniteType.comp P S S₀
        have : Algebra.EssFiniteType R₀ S₀ := Algebra.EssFiniteType.of_comp P R₀ S₀
        have hmax : Ideal.map (algebraMap R₀ S₀) (IsLocalRing.maximalIdeal R₀) =
            IsLocalRing.maximalIdeal S₀ :=
          Algebra.FormallyUnramified.map_maximalIdeal (R := R₀) (S := S₀)
        have hmax_R₀ : Ideal.map (algebraMap P R₀) 𝔭.asIdeal = IsLocalRing.maximalIdeal R₀ :=
          Localization.AtPrime.map_eq_maximalIdeal
        have hmax_S₀ : Ideal.map (algebraMap S S₀) q₂.asIdeal = IsLocalRing.maximalIdeal S₀ :=
          Localization.AtPrime.map_eq_maximalIdeal
        have hmap_eq : Ideal.map (algebraMap S S₀) q₂.asIdeal =
            Ideal.map (algebraMap S S₀) (Ideal.map (algebraMap P S) 𝔭.asIdeal) := by
          rw [hmax_S₀, ← hmax, ← hmax_R₀, Ideal.map_map, ← IsScalarTower.algebraMap_eq P R₀ S₀,
            IsScalarTower.algebraMap_eq P S S₀, ← Ideal.map_map]
        have hmap_le : Ideal.map (algebraMap S S₀) q₂.asIdeal ≤
            Ideal.map (algebraMap S S₀) q₁.asIdeal := by
          rw [hmap_eq]
          apply Ideal.map_mono
          rw [h𝔭_q₁]
          exact Ideal.map_comap_le
        have hdisj₂ : Disjoint (q₂.asIdeal.primeCompl : Set S) q₂.asIdeal :=
          Set.disjoint_compl_left_iff_subset.mpr Set.Subset.rfl
        have hdisj₁ : Disjoint (q₂.asIdeal.primeCompl : Set S) q₁.asIdeal :=
          Set.disjoint_compl_left_iff_subset.mpr hlt.le
        have hcomap_le : Ideal.under S (Ideal.map (algebraMap S S₀) q₂.asIdeal) ≤
            Ideal.under S (Ideal.map (algebraMap S S₀) q₁.asIdeal) :=
          Ideal.comap_mono hmap_le
        rw [IsLocalization.under_map_of_isPrime_disjoint q₂.asIdeal.primeCompl S₀ q₂.isPrime hdisj₂,
          IsLocalization.under_map_of_isPrime_disjoint q₂.asIdeal.primeCompl S₀ q₁.isPrime hdisj₁]
          at hcomap_le
        exact not_le_of_gt hlt hcomap_le
      let L_P : LTSeries (PrimeSpectrum P) :=
        L_chain.map (PrimeSpectrum.comap (algebraMap P S)) (fun _ _ h => hStrict h)
      have hkrull : ((L_chain.length : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (PrimeSpectrum P) :=
        Order.le_krullDim_iff.mpr ⟨L_P, rfl⟩
      have hdimP : Order.krullDim (PrimeSpectrum P) = ((d : ℕ) : WithBot ℕ∞) := by
        change ringKrullDim P = _
        rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add,
          ENat.card_eq_coe_fintype_card, Fintype.card_fin]
        rfl
      rw [hdimP] at hkrull
      exact_mod_cast hkrull

  let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
    MvPolynomial.gradedAlgebra
  let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
    MvPolynomial.gradedAlgebra
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k
  let C_Z : Fin (M + 1) → Z_bar.left.Opens := fun α =>
    (TopologicalSpace.Opens.map ι_bar.left.base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α))
  let D_P : Fin 3 → (weilProjectiveSpaceOver k 2).left.Opens := fun β =>
    AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X β)
  let U_r : Fin 3 → Z_bar.left.Opens := fun r =>
    (TopologicalSpace.Opens.map ι_bar.left.base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜_M (L r))
  let U_net : Z_bar.left.Opens := ⨆ r : Fin 3, U_r r
  let U_Y : Y₂.left.Opens := (TopologicalSpace.Opens.map π_Y.left.base).obj U_net
  have hCov_Z' : (⨆ α : Fin (M + 1), C_Z α) = ⊤ := hCov_Z
  have hCov_P' : (⨆ β : Fin 3, D_P β) = ⊤ := hCov_P

  have hIsUnit_of_forall_prime : ∀ {R : Type u} [CommRing R] (x : R),
      (∀ p : PrimeSpectrum R, x ∉ p.asIdeal) → IsUnit x := by
    intro R _ x hx
    by_contra hnu
    obtain ⟨𝔪, h𝔪_max, hx𝔪⟩ :=
      Ideal.exists_le_maximal (Ideal.span {x}) (Ideal.span_singleton_ne_top hnu)
    exact hx ⟨𝔪, h𝔪_max.isPrime⟩ (hx𝔪 (Ideal.subset_span rfl))

  have hIrred_affineOpen : ∀ (U : Y₂.left.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U),
      IsDomain ↑(Y₂.left.presheaf.obj (Opposite.op U)) →
      IsIrreducible (U : Set Y₂.left) := by
    intro U hAff hDom
    have : IsDomain ↑(Y₂.left.presheaf.obj (Opposite.op U)) := hDom
    have : IrreducibleSpace (AlgebraicGeometry.Spec (Y₂.left.presheaf.obj (Opposite.op U))) :=
      PrimeSpectrum.irreducibleSpace
    let f : AlgebraicGeometry.Spec (Y₂.left.presheaf.obj (Opposite.op U)) ⟶ Y₂.left :=
      hAff.isoSpec.inv ≫ U.ι
    have himg : f.base '' Set.univ = (U : Set Y₂.left) := by
      ext y
      constructor
      · rintro ⟨p, -, rfl⟩
        exact (hAff.isoSpec.inv.base p).2
      · intro hy
        refine ⟨hAff.isoSpec.hom.base ⟨y, hy⟩, trivial, ?_⟩
        change ((hAff.isoSpec.hom ≫ hAff.isoSpec.inv).base ⟨y, hy⟩).1 = y
        rw [hAff.isoSpec.hom_inv_id]
        rfl
    rw [← himg]
    have hirr_spec : IsIrreducible
        (Set.univ : Set (AlgebraicGeometry.Spec (Y₂.left.presheaf.obj (Opposite.op U)))) :=
      ⟨Set.univ_nonempty, PreirreducibleSpace.isPreirreducible_univ⟩
    exact hirr_spec.image f.base f.continuous.continuousOn

  have hUnion2_preirred : ∀ {S₀ S₁ : Set Y₂.left},
      IsOpen S₀ → IsOpen S₁ →
      IsPreirreducible S₀ → IsPreirreducible S₁ → (S₀ ∩ S₁).Nonempty →
      IsPreirreducible (S₀ ∪ S₁) := by
    intro S₀ S₁ hOpen₀ hOpen₁ h0 h1 hInter u v hu hv ⟨a, haS, hau⟩ ⟨b, hbS, hbv⟩
    rcases haS with ha0 | ha1
    · rcases hbS with hb0 | hb1
      · obtain ⟨w, hw0, hwuv⟩ := h0 u v hu hv ⟨a, ha0, hau⟩ ⟨b, hb0, hbv⟩
        exact ⟨w, Or.inl hw0, hwuv⟩
      · obtain ⟨c, _, hc1, hcu⟩ := h0 S₁ u hOpen₁ hu hInter ⟨a, ha0, hau⟩
        obtain ⟨w, hw1, hwuv⟩ := h1 u v hu hv ⟨c, hc1, hcu⟩ ⟨b, hb1, hbv⟩
        exact ⟨w, Or.inr hw1, hwuv⟩
    · rcases hbS with hb0 | hb1
      · have hInter' : (S₁ ∩ S₀).Nonempty := by rwa [Set.inter_comm]
        obtain ⟨c, _, hc0, hcu⟩ := h1 S₀ u hOpen₀ hu hInter' ⟨a, ha1, hau⟩
        obtain ⟨w, hw0, hwuv⟩ := h0 u v hu hv ⟨c, hc0, hcu⟩ ⟨b, hb0, hbv⟩
        exact ⟨w, Or.inl hw0, hwuv⟩
      · obtain ⟨w, hw1, hwuv⟩ := h1 u v hu hv ⟨a, ha1, hau⟩ ⟨b, hb1, hbv⟩
        exact ⟨w, Or.inr hw1, hwuv⟩

  have hUnionFam_preirred : ∀ {ι : Type u} (F : ι → Set Y₂.left),
      (∀ i, IsOpen (F i)) → (∀ i, IsPreirreducible (F i)) → (∀ i j, (F i ∩ F j).Nonempty) →
      IsPreirreducible (⋃ i, F i) := by
    intro ι F hOpen hPre hPair u v hu hv ⟨a, haF, hau⟩ ⟨b, hbF, hbv⟩
    rw [Set.mem_iUnion] at haF hbF
    obtain ⟨i, hai⟩ := haF
    obtain ⟨j, hbj⟩ := hbF
    obtain ⟨c, _, hcj, hcu⟩ := hPre i (F j) u (hOpen j) hu (hPair i j) ⟨a, hai, hau⟩
    obtain ⟨w, hwj, hwuv⟩ := hPre j u v hu hv ⟨c, hcj, hcu⟩ ⟨b, hbj, hbv⟩
    exact ⟨w, Set.mem_iUnion.mpr ⟨j, hwj⟩, hwuv⟩

  have hComap_appLE : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
      (U : Y.Opens) (V : X.Opens) (hUV : V ≤ (TopologicalSpace.Opens.map f.base).obj U)
      (hAffU : AlgebraicGeometry.IsAffineOpen U) (hAffV : AlgebraicGeometry.IsAffineOpen V)
      (q : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op V))),
      PrimeSpectrum.comap (f.appLE U V hUV).hom q =
        hAffU.primeIdealOf ⟨f.base (hAffV.isoSpec.inv.base q).1,
          hUV (hAffV.isoSpec.inv.base q).2⟩ := by
    intro X Y f U V hUV hAffU hAffV q
    have hcomm := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE f U V hUV
    rw [← hAffV.isoSpec_hom, ← hAffU.isoSpec_hom] at hcomm
    have hcomm' : AlgebraicGeometry.Spec.map (f.appLE U V hUV) =
        hAffV.isoSpec.inv ≫ f.resLE U V hUV ≫ hAffU.isoSpec.hom := by
      rw [← hcomm, ← CategoryTheory.Category.assoc, hAffV.isoSpec.inv_hom_id,
        CategoryTheory.Category.id_comp]
    have hbase := congrArg (fun g => g.base q) hcomm'
    have hres : (f.resLE U V hUV).base (hAffV.isoSpec.inv.base q) =
        ⟨f.base (hAffV.isoSpec.inv.base q).1, hUV (hAffV.isoSpec.inv.base q).2⟩ := by
      apply Subtype.ext
      change ((f.resLE U V hUV ≫ U.ι).base) (hAffV.isoSpec.inv.base q) = _
      rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
      rfl
    change (AlgebraicGeometry.Spec.map (f.appLE U V hUV)).base q = _
    rw [hbase]
    change hAffU.isoSpec.hom.base ((f.resLE U V hUV).base (hAffV.isoSpec.inv.base q)) = _
    rw [hres]
    rfl

  let IdxOff :=
    { p : Fin 3 × Fin (M + 1) × Z_bar.left.affineOpens //
      Nonempty ↥p.2.2.1 ∧ p.2.2.1 ≤ U_r p.1 ⊓ C_Z p.2.1 }
  let W_off : IdxOff → Y₂.left.Opens := fun p =>
    (TopologicalSpace.Opens.map π_Y.left.base).obj p.1.2.2.1

  have hW_off_irred : ∀ p : IdxOff, IsIrreducible (W_off p : Set Y₂.left) := by
    rintro ⟨⟨r, α, U_Z⟩, hne, hle⟩
    have hUZ_Ur : U_Z.1 ≤ U_r r := hle.trans inf_le_left
    have hUZ_CZ : U_Z.1 ≤ C_Z α := hle.trans inf_le_right
    have hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1 :=
      MvPolynomial.isHomogeneous_X k α
    let A := ↑(Z_bar.left.presheaf.obj (Opposite.op U_Z.1))
    have hDomA : IsDomain A :=
      @AlgebraicGeometry.IsIntegral.component_integral Z_bar.left hInt U_Z.1 hne
    let ℓ_r : Fin 3 → A := fun j =>
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
        ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) U_Z.1 hUZ_CZ).hom
        (HomogeneousLocalization.mk ⟨1, ⟨L j, hL_homog j⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
    have hUnit : IsUnit (ℓ_r r) := by
      obtain ⟨_, _, hVan0, _, _⟩ := hCharts 0 α hXα U_Z.1 U_Z.2 hUZ_CZ
      refine hIsUnit_of_forall_prime (ℓ_r r) fun q hq => ?_
      let z : ↥U_Z.1 := U_Z.2.isoSpec.inv.base q
      have hz_p : U_Z.2.primeIdealOf z = q := by
        change (U_Z.2.isoSpec.inv ≫ U_Z.2.isoSpec.hom).base q = q
        rw [U_Z.2.isoSpec.inv_hom_id]
        rfl
      rw [← hz_p, ← hVan0 z r] at hq
      exact hq (hUZ_Ur z.2)
    obtain ⟨hSwitch, hDom_and_ov⟩ := hOffAlg A ℓ_r r hUnit
    obtain ⟨hDom_β, i₁, 𝔭_ov, hi₁_eq, h𝔭_ov⟩ := hDom_and_ov hDomA
    let β₀ : Fin 3 := r.succAbove 0
    let β₁ : Fin 3 := r.succAbove 1
    let V_Y : Fin 3 → Y₂.left.Opens := fun β =>
      (TopologicalSpace.Opens.map π_Y.left.base).obj U_Z.1 ⊓
        (TopologicalSpace.Opens.map g₂.left.base).obj (D_P β)
    have hW_eq : ((TopologicalSpace.Opens.map π_Y.left.base).obj U_Z.1 : Set Y₂.left) =
        (V_Y β₀ : Set Y₂.left) ∪ (V_Y β₁ : Set Y₂.left) := by
      ext y
      constructor
      · intro hy_UZ
        have hgy : g₂.left.base y ∈ (⨆ β : Fin 3, D_P β) := by
          rw [hCov_P']
          trivial
        rw [TopologicalSpace.Opens.mem_iSup] at hgy
        obtain ⟨β, hy_β⟩ := hgy
        by_cases hβ_ne : β ≠ r
        · obtain ⟨i, hi⟩ := Fin.exists_succAbove_eq hβ_ne
          fin_cases i
          · dsimp at hi
            have hy_β₀ : g₂.left.base y ∈ D_P β₀ := by dsimp [β₀]; rwa [hi]
            exact Or.inl ⟨hy_UZ, hy_β₀⟩
          · dsimp at hi
            have hy_β₁ : g₂.left.base y ∈ D_P β₁ := by dsimp [β₁]; rwa [hi]
            exact Or.inr ⟨hy_UZ, hy_β₁⟩
        · have hβ_eq : β = r := Classical.not_not.mp hβ_ne
          subst β
          obtain ⟨hAffVY_r, e_Yr, _, _, hX_iff_r⟩ := hCharts r α hXα U_Z.1 U_Z.2 hUZ_CZ
          let y_r : ↥(V_Y r) := ⟨y, hy_UZ, hy_β⟩
          obtain ⟨i, hi_not⟩ :=
            hSwitch (PrimeSpectrum.comap e_Yr.toRingHom (hAffVY_r.primeIdealOf y_r))
          have hy_succ : g₂.left.base y ∈ D_P (r.succAbove i) :=
            (hX_iff_r y_r i).mpr hi_not
          fin_cases i
          · exact Or.inl ⟨hy_UZ, hy_succ⟩
          · exact Or.inr ⟨hy_UZ, hy_succ⟩
      · rintro (hy0 | hy1)
        · exact hy0.1
        · exact hy1.1
    obtain ⟨hAffVY_β₀, e_Yβ₀, _, _, hX_iff_β₀⟩ := hCharts β₀ α hXα U_Z.1 U_Z.2 hUZ_CZ
    obtain ⟨hAffVY_β₁, e_Yβ₁, _, _, _⟩ := hCharts β₁ α hXα U_Z.1 U_Z.2 hUZ_CZ
    have hDom_VY₀ : IsDomain ↑(Y₂.left.presheaf.obj (Opposite.op (V_Y β₀))) := by
      have := hDom_β β₀ (Fin.succAbove_ne r 0)
      exact Function.Injective.isDomain e_Yβ₀.symm.toRingHom e_Yβ₀.symm.injective
    have hDom_VY₁ : IsDomain ↑(Y₂.left.presheaf.obj (Opposite.op (V_Y β₁))) := by
      have := hDom_β β₁ (Fin.succAbove_ne r 1)
      exact Function.Injective.isDomain e_Yβ₁.symm.toRingHom e_Yβ₁.symm.injective
    have hIrred₀ : IsIrreducible (V_Y β₀ : Set Y₂.left) :=
      hIrred_affineOpen (V_Y β₀) hAffVY_β₀ hDom_VY₀
    have hIrred₁ : IsIrreducible (V_Y β₁ : Set Y₂.left) :=
      hIrred_affineOpen (V_Y β₁) hAffVY_β₁ hDom_VY₁
    have hInter_ne : ((V_Y β₀ : Set Y₂.left) ∩ (V_Y β₁ : Set Y₂.left)).Nonempty := by
      let q_ov : PrimeSpectrum ↑(Y₂.left.presheaf.obj (Opposite.op (V_Y β₀))) :=
        PrimeSpectrum.comap e_Yβ₀.symm.toRingHom 𝔭_ov
      let y_ov : ↥(V_Y β₀) := hAffVY_β₀.isoSpec.inv.base q_ov
      have hy_prime : hAffVY_β₀.primeIdealOf y_ov = q_ov := by
        change (hAffVY_β₀.isoSpec.inv ≫ hAffVY_β₀.isoSpec.hom).base q_ov = q_ov
        rw [hAffVY_β₀.isoSpec.inv_hom_id]
        rfl
      have hnot_mem : e_Yβ₀ (Ideal.Quotient.mk _ (MvPolynomial.X i₁)) ∉
          (hAffVY_β₀.primeIdealOf y_ov).asIdeal := by
        rw [hy_prime]
        change e_Yβ₀.symm (e_Yβ₀ (Ideal.Quotient.mk _ (MvPolynomial.X i₁))) ∉ 𝔭_ov.asIdeal
        rw [e_Yβ₀.symm_apply_apply]
        exact h𝔭_ov
      have hy_β₁ : g₂.left.base y_ov.1 ∈ D_P β₁ := by
        change g₂.left.base y_ov.1 ∈ D_P (r.succAbove 1)
        rw [← hi₁_eq]
        exact (hX_iff_β₀ y_ov i₁).mpr hnot_mem
      exact ⟨y_ov.1, y_ov.2, y_ov.2.1, hy_β₁⟩
    change IsIrreducible ((TopologicalSpace.Opens.map π_Y.left.base).obj U_Z.1 : Set Y₂.left)
    rw [hW_eq]
    exact ⟨hIrred₀.1.mono Set.subset_union_left,
      hUnion2_preirred (V_Y β₀).2 (V_Y β₁).2 hIrred₀.2 hIrred₁.2 hInter_ne⟩

  have hUY_eq_iUnion : (U_Y : Set Y₂.left) = ⋃ p : IdxOff, (W_off p : Set Y₂.left) := by
    ext y
    rw [Set.mem_iUnion]
    constructor
    · intro hy
      change π_Y.left.base y ∈ ⨆ r : Fin 3, U_r r at hy
      rw [TopologicalSpace.Opens.mem_iSup] at hy
      obtain ⟨r, hz_r⟩ := hy
      have hz_cov : π_Y.left.base y ∈ (⨆ α : Fin (M + 1), C_Z α) := by
        rw [hCov_Z']
        trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hz_cov
      obtain ⟨α, hz_α⟩ := hz_cov
      obtain ⟨U_Z, hAffUZ, hzUZ, hUZ_le⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := U_r r ⊓ C_Z α) ⟨hz_r, hz_α⟩
      exact ⟨⟨⟨r, α, ⟨U_Z, hAffUZ⟩⟩, ⟨⟨π_Y.left.base y, hzUZ⟩, hUZ_le⟩⟩, hzUZ⟩
    · rintro ⟨⟨⟨r, α, U_Z⟩, _, hle⟩, hy_W⟩
      have hUr_le : U_r r ≤ U_net := le_iSup U_r r
      exact hUr_le ((hle.trans inf_le_left) hy_W)

  have hIrred_UY : IsIrreducible (U_Y : Set Y₂.left) := by
    have : IrreducibleSpace Z_bar.left :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral Z_bar.left hInt
    have hPair : ∀ p₁ p₂ : IdxOff,
        ((W_off p₁ : Set Y₂.left) ∩ (W_off p₂ : Set Y₂.left)).Nonempty := by
      intro p₁ p₂
      have hne1 : (p₁.1.2.2.1 : Set Z_bar.left).Nonempty :=
        let ⟨x, hx⟩ := p₁.2.1; ⟨x, hx⟩
      have hne2 : (p₂.1.2.2.1 : Set Z_bar.left).Nonempty :=
        let ⟨x, hx⟩ := p₂.2.1; ⟨x, hx⟩
      obtain ⟨z₁₂, hz₁, hz₂⟩ :=
        nonempty_preirreducible_inter p₁.1.2.2.1.2 p₂.1.2.2.1.2 hne1 hne2
      obtain ⟨U₃, hAffU₃, hz₃, hU₃_le⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (U := p₁.1.2.2.1 ⊓ p₂.1.2.2.1) ⟨hz₁, hz₂⟩
      let p₃ : IdxOff :=
        ⟨⟨p₁.1.1, p₁.1.2.1, ⟨U₃, hAffU₃⟩⟩,
          ⟨⟨z₁₂, hz₃⟩, (hU₃_le.trans inf_le_left).trans p₁.2.2⟩⟩
      obtain ⟨y₁₂, hy₁₂⟩ := (hW_off_irred p₃).1
      exact ⟨y₁₂, (hU₃_le.trans inf_le_left) hy₁₂, (hU₃_le.trans inf_le_right) hy₁₂⟩
    obtain ⟨z₀, hz₀⟩ := hL_nondeg 0
    have hz₀_Ur : z₀ ∈ U_r 0 := Classical.not_not.mp hz₀
    have hz₀_cov : z₀ ∈ (⨆ α : Fin (M + 1), C_Z α) := by
      rw [hCov_Z']
      trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hz₀_cov
    obtain ⟨α₀, hz₀_α⟩ := hz₀_cov
    obtain ⟨U_Z₀, hAffUZ₀, hz₀_UZ, hUZ₀_le⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (U := U_r 0 ⊓ C_Z α₀) ⟨hz₀_Ur, hz₀_α⟩
    let p₀ : IdxOff := ⟨⟨0, α₀, ⟨U_Z₀, hAffUZ₀⟩⟩, ⟨⟨z₀, hz₀_UZ⟩, hUZ₀_le⟩⟩
    rw [hUY_eq_iUnion]
    exact ⟨(hW_off_irred p₀).1.mono (Set.subset_iUnion (fun p => (W_off p : Set Y₂.left)) p₀),
      hUnionFam_preirred (fun p => (W_off p : Set Y₂.left))
        (fun p => (W_off p).2) (fun p => (hW_off_irred p).2) hPair⟩

  have hDense_UY : Dense (U_Y : Set Y₂.left) := by
    rw [dense_iff_inter_open]
    intro W hW_open ⟨y₀, hy₀⟩
    by_contra hEmpty
    have hDisj : ∀ y ∈ W, y ∉ (U_Y : Set Y₂.left) := fun y hyW hyU =>
      hEmpty ⟨y, hyW, hyU⟩
    rcases Nat.eq_zero_or_pos m with rfl | hm
    · obtain ⟨r, hr⟩ := hNet_m0 rfl (π_Y.left.base y₀)
      have hy₀_UY : y₀ ∈ (U_Y : Set Y₂.left) :=
        (le_iSup U_r r) (Classical.not_not.mp hr)
      exact hDisj y₀ hy₀ hy₀_UY
    · have hz₀_axis : ∀ r : Fin 3,
          ι_bar.left.base (π_Y.left.base y₀) ∈ weilProjHyperplaneSet k M (L r) := by
        intro r
        by_contra hnot
        exact hDisj y₀ hy₀ ((le_iSup U_r r) (Classical.not_not.mp hnot))
      obtain ⟨α, hXα, V_Z, hAffVZ, hVZ, κ_net, hz₀_VZ, hSm_net⟩ :=
        hAxis_sm hm (π_Y.left.base y₀) hz₀_axis
      have hgy₀ : g₂.left.base y₀ ∈ (⨆ β : Fin 3, D_P β) := by
        rw [hCov_P']
        trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hgy₀
      obtain ⟨β, hy₀_β⟩ := hgy₀
      let V_Y : Y₂.left.Opens :=
        (TopologicalSpace.Opens.map π_Y.left.base).obj V_Z ⊓
          (TopologicalSpace.Opens.map g₂.left.base).obj (D_P β)
      obtain ⟨hAffVY, e_Y, hVan, hπ_app, _⟩ := hCharts β α hXα V_Z hAffVZ hVZ
      obtain ⟨U_k, _, U_sm, hAffUsm, hy₀_Usm, e_sm, hSm_Usm⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff (2 * m + 3) Y₂.hom).mp inferInstance y₀
      have hUk_top : U_k = ⊤ := by
        ext pt
        simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        rw [Subsingleton.elim pt (Y₂.hom.base y₀)]
        exact e_sm hy₀_Usm
      subst hUk_top
      let W₀ : Y₂.left.Opens := ⟨W, hW_open⟩
      obtain ⟨g₀, hg₀_le, hy₀_g₀⟩ :=
        hAffUsm.exists_basicOpen_le (V := W₀ ⊓ V_Y) ⟨y₀, hy₀, hz₀_VZ, hy₀_β⟩ hy₀_Usm
      let V₀ : Y₂.left.Opens := Y₂.left.basicOpen g₀
      have hAffV0 : AlgebraicGeometry.IsAffineOpen V₀ := hAffUsm.basicOpen g₀
      have hV0_Usm : V₀ ≤ U_sm := Y₂.left.basicOpen_le g₀
      have hV0_W0 : V₀ ≤ W₀ := hg₀_le.trans inf_le_left
      have hV0_VY : V₀ ≤ V_Y := hg₀_le.trans inf_le_right
      let C₀ := ↑(Y₂.left.presheaf.obj (Opposite.op V₀))
      let κ₀ : k →+* C₀ :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Y₂.hom.appLE ⊤ V₀ le_top).hom
      have hSm_κ₀ : RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 3) κ₀ := by
        let res_g₀ : ↑(Y₂.left.presheaf.obj (Opposite.op U_sm)) →+* C₀ :=
          (Y₂.left.presheaf.map (CategoryTheory.homOfLE hV0_Usm).op).hom
        let _ : Algebra ↑(Y₂.left.presheaf.obj (Opposite.op U_sm)) C₀ := res_g₀.toAlgebra
        have : IsLocalization.Away g₀ C₀ := hAffUsm.isLocalization_basicOpen g₀
        have hLoc0 : RingHom.IsStandardSmoothOfRelativeDimension 0 res_g₀ :=
          RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway g₀
        have hSm_base : RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 3)
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              Y₂.hom.appLE ⊤ U_sm e_sm).hom) :=
          (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_left_isIso
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (Y₂.hom.appLE ⊤ U_sm e_sm)).mpr hSm_Usm
        have hComp : κ₀ = res_g₀.comp
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              Y₂.hom.appLE ⊤ U_sm e_sm).hom) := by
          have h1 : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              (Y₂.hom.appLE ⊤ U_sm e_sm ≫
                Y₂.left.presheaf.map (CategoryTheory.homOfLE hV0_Usm).op) =
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                Y₂.hom.appLE ⊤ V₀ le_top := by
            rw [AlgebraicGeometry.Scheme.Hom.appLE_map]
          ext c
          exact congrArg (fun f : CommRingCat.of k ⟶ _ => f.hom c) h1.symm
        rw [hComp, ← Nat.zero_add (2 * m + 3)]
        exact hLoc0.comp hSm_base
      have : Infinite k := IsAlgClosed.instInfinite
      have : Nonempty (PrimeSpectrum C₀) := ⟨hAffV0.primeIdealOf ⟨y₀, hy₀_g₀⟩⟩
      obtain ⟨L₀, hL₀_len⟩ := hPrimeBounds.1 k (2 * m + 3) C₀ κ₀ hSm_κ₀
      let A := ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z))
      let ℓ_r : Fin 3 → A := fun r =>
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
          ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) V_Z hVZ).hom
          (HomogeneousLocalization.mk ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
      let idY : Y₂.left ⟶ Y₂.left := 𝟙 Y₂.left
      let res_VY_V0 : ↑(Y₂.left.presheaf.obj (Opposite.op V_Y)) →+* C₀ :=
        (idY.appLE V_Y V₀ hV0_VY).hom
      let θ := res_VY_V0.comp e_Y.toRingHom
      have hθ_inj : Function.Injective (PrimeSpectrum.comap θ) := by
        intro q₁ q₂ heq
        have hq_eq : PrimeSpectrum.comap res_VY_V0 q₁ = PrimeSpectrum.comap res_VY_V0 q₂ := by
          have h1 := congrArg (PrimeSpectrum.comap e_Y.symm.toRingHom) heq
          change PrimeSpectrum.comap (e_Y.toRingHom.comp e_Y.symm.toRingHom)
              (PrimeSpectrum.comap res_VY_V0 q₁) =
            PrimeSpectrum.comap (e_Y.toRingHom.comp e_Y.symm.toRingHom)
              (PrimeSpectrum.comap res_VY_V0 q₂) at h1
          simpa [RingEquiv.toRingHom_comp_symm_toRingHom] using h1
        change PrimeSpectrum.comap (idY.appLE V_Y V₀ hV0_VY).hom q₁ =
          PrimeSpectrum.comap (idY.appLE V_Y V₀ hV0_VY).hom q₂ at hq_eq
        rw [hComap_appLE idY V_Y V₀ hV0_VY hAffVY hAffV0 q₁,
          hComap_appLE idY V_Y V₀ hV0_VY hAffVY hAffV0 q₂] at hq_eq
        have hpt := congrArg hAffVY.isoSpec.inv.base hq_eq
        change ((hAffVY.isoSpec.hom ≫ hAffVY.isoSpec.inv).base _) =
          ((hAffVY.isoSpec.hom ≫ hAffVY.isoSpec.inv).base _) at hpt
        rw [hAffVY.isoSpec.hom_inv_id] at hpt
        have hpt' :
            (⟨(hAffV0.isoSpec.inv.base q₁).1, hV0_VY (hAffV0.isoSpec.inv.base q₁).2⟩ : ↥V_Y) =
            ⟨(hAffV0.isoSpec.inv.base q₂).1, hV0_VY (hAffV0.isoSpec.inv.base q₂).2⟩ := hpt
        have hx_val : (hAffV0.isoSpec.inv.base q₁).1 = (hAffV0.isoSpec.inv.base q₂).1 :=
          congrArg (fun x : ↥V_Y => x.1) hpt'
        have hx_eq : hAffV0.isoSpec.inv.base q₁ = hAffV0.isoSpec.inv.base q₂ :=
          Subtype.ext hx_val
        have hq12 := congrArg hAffV0.isoSpec.hom.base hx_eq
        change ((hAffV0.isoSpec.inv ≫ hAffV0.isoSpec.hom).base q₁) =
          ((hAffV0.isoSpec.inv ≫ hAffV0.isoSpec.hom).base q₂) at hq12
        rwa [hAffV0.isoSpec.inv_hom_id] at hq12
      have hθ_axis : ∀ (q : PrimeSpectrum C₀) (r : Fin 3),
          θ (Ideal.Quotient.mk _ (MvPolynomial.C (ℓ_r r))) ∈ q.asIdeal := by
        intro q r
        let x : ↥V₀ := hAffV0.isoSpec.inv.base q
        have h0Z : V₀ ≤ (TopologicalSpace.Opens.map π_Y.left.base).obj V_Z :=
          hV0_VY.trans inf_le_left
        have hx_axis : ι_bar.left.base (π_Y.left.base x.1) ∈
            weilProjHyperplaneSet k M (L r) := by
          by_contra hnot
          exact hDisj x.1 (hV0_W0 x.2) ((le_iSup U_r r) (Classical.not_not.mp hnot))
        have hℓ_mem : ℓ_r r ∈
            (hAffVZ.primeIdealOf ⟨π_Y.left.base x.1, h0Z x.2⟩).asIdeal :=
          (hVan ⟨π_Y.left.base x.1, h0Z x.2⟩ r).mp hx_axis
        have hcomap_z := hComap_appLE π_Y.left V_Z V₀ h0Z hAffVZ hAffV0 q
        rw [← hcomap_z] at hℓ_mem
        change (π_Y.left.appLE V_Z V₀ h0Z).hom (ℓ_r r) ∈ q.asIdeal at hℓ_mem
        have happ_comp :=
          AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE idY π_Y.left V_Z V_Y V₀ inf_le_left hV0_VY
        have happLE_congr : ∀ {f₁ f₂ : Y₂.left ⟶ Z_bar.left} (hf : f₁ = f₂)
            (h₁ : V₀ ≤ (TopologicalSpace.Opens.map f₁.base).obj V_Z)
            (h₂ : V₀ ≤ (TopologicalSpace.Opens.map f₂.base).obj V_Z),
            f₁.appLE V_Z V₀ h₁ = f₂.appLE V_Z V₀ h₂ := by
          rintro f₁ _ rfl h₁ h₂; rfl
        have happ_eq : π_Y.left.appLE V_Z V₀ h0Z =
            π_Y.left.appLE V_Z V_Y inf_le_left ≫ idY.appLE V_Y V₀ hV0_VY :=
          (happLE_congr (CategoryTheory.Category.id_comp π_Y.left).symm h0Z _).trans happ_comp.symm
        have hθ_val : (π_Y.left.appLE V_Z V₀ h0Z).hom (ℓ_r r) =
            θ (Ideal.Quotient.mk _ (MvPolynomial.C (ℓ_r r))) := by
          rw [happ_eq]
          change res_VY_V0 ((π_Y.left.appLE V_Z V_Y inf_le_left).hom (ℓ_r r)) = _
          rw [hπ_app (ℓ_r r)]
          rfl
        rwa [← hθ_val]
      obtain ⟨L_net, hL_net_len⟩ := hAxisLift A C₀ ℓ_r β θ hθ_inj hθ_axis L₀
      have hL_net_le : L_net.length ≤ 2 * m + 1 :=
        hPrimeBounds.2 k (2 * m + 1) _ κ_net hSm_net L_net
      omega

  have hIrred_univ : IsIrreducible (Set.univ : Set Y₂.left) := by
    rw [← hDense_UY.closure_eq]
    exact hIrred_UY.closure
  have : PreirreducibleSpace ↥Y₂.left := ⟨hIrred_univ.2⟩
  have : Nonempty ↥Y₂.left := let ⟨y, _⟩ := hIrred_univ.1; ⟨y⟩
  have : IrreducibleSpace ↥Y₂.left :=
    { toPreirreducibleSpace := inferInstance, toNonempty := inferInstance }
  have : AlgebraicGeometry.IsReduced Y₂.left := by
    have hRed_std : ∀ (S : Type u) [CommRing S] (f : k →+* S),
        RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 3) f → _root_.IsReduced S := by
      intro S _ f hf
      obtain ⟨g, _, hg⟩ := hf.exists_etale_mvPolynomial
      let P := MvPolynomial (Fin (2 * m + 3)) k
      let _ : Algebra P S := g.toAlgebra
      have : Algebra.Etale P S := hg
      let K := FractionRing P
      have hinj_PK : Function.Injective (Algebra.linearMap P K) := IsFractionRing.injective P K
      have hinj_rT : Function.Injective (LinearMap.rTensor S (Algebra.linearMap P K)) :=
        Module.Flat.rTensor_preserves_injective_linearMap (M := S) (Algebra.linearMap P K) hinj_PK
      let inc : S →ₐ[P] TensorProduct P K S := Algebra.TensorProduct.includeRight
      have hinj_inc : Function.Injective inc := by
        intro s₁ s₂ hs
        have h1 : LinearMap.rTensor S (Algebra.linearMap P K) ((1 : P) ⊗ₜ[P] s₁) =
            LinearMap.rTensor S (Algebra.linearMap P K) ((1 : P) ⊗ₜ[P] s₂) := by
          simpa [inc] using hs
        have h2 := congrArg (Algebra.TensorProduct.lid P S) (hinj_rT h1)
        simpa using h2
      have : Algebra.Etale K (TensorProduct P K S) := inferInstance
      have : _root_.IsReduced (TensorProduct P K S) :=
        Algebra.FormallyUnramified.isReduced_of_field K (TensorProduct P K S)
      exact isReduced_of_injective inc hinj_inc
    have hCov : ∀ y : Y₂.left, ∃ V : Y₂.left.Opens,
        AlgebraicGeometry.IsAffineOpen V ∧ y ∈ V ∧
        _root_.IsReduced ↑(Y₂.left.presheaf.obj (Opposite.op V)) := by
      intro y
      obtain ⟨U_k, _, V, hAffV, hyV, e_V, hSm_V⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff (2 * m + 3) Y₂.hom).mp inferInstance y
      have hUk_top : U_k = ⊤ := by
        ext pt
        simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        rw [Subsingleton.elim pt (Y₂.hom.base y)]
        exact e_V hyV
      subst hUk_top
      have hSm_f : RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 3)
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            Y₂.hom.appLE ⊤ V e_V).hom) :=
        (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_left_isIso
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
          (Y₂.hom.appLE ⊤ V e_V)).mpr hSm_V
      exact ⟨V, hAffV, hyV, hRed_std _ _ hSm_f⟩
    let V_y : Y₂.left → Y₂.left.Opens := fun y => Classical.choose (hCov y)
    have hV_spec : ∀ y : Y₂.left, AlgebraicGeometry.IsAffineOpen (V_y y) ∧ y ∈ V_y y ∧
        _root_.IsReduced ↑(Y₂.left.presheaf.obj (Opposite.op (V_y y))) :=
      fun y => Classical.choose_spec (hCov y)
    have hSupr : TopologicalSpace.IsOpenCover V_y := by
      change (⨆ y : Y₂.left, V_y y) = ⊤
      rw [eq_top_iff]
      intro y _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨y, (hV_spec y).2.1⟩
    let 𝒰 := Y₂.left.openCoverOfIsOpenCover V_y hSupr
    have : ∀ i : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X i) := by
      intro y
      have : AlgebraicGeometry.IsAffine (V_y y).toScheme := (hV_spec y).1
      have : _root_.IsReduced ↑(Y₂.left.presheaf.obj (Opposite.op (V_y y))) := (hV_spec y).2.2
      have : _root_.IsReduced ↑((V_y y).toScheme.presheaf.obj (Opposite.op ⊤)) :=
        isReduced_of_injective (V_y y).topIso.hom.hom
          (ConcreteCategory.bijective_of_isIso (V_y y).topIso.hom).1
      exact AlgebraicGeometry.isReduced_of_isAffine_isReduced (V_y y).toScheme
    exact AlgebraicGeometry.IsReduced.of_openCover Y₂.left 𝒰
  exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Y₂.left

theorem weil_algClosed_net_incidence_smooth_flat (k : Type u) [Field k] [IsAlgClosed k]
    (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hM : 3 ≤ M)
    (hCl_ι : AlgebraicGeometry.IsClosedImmersion ι_bar.left)
    (hNondeg : ∀ L_form : MvPolynomial (Fin (M + 1)) k,
      L_form ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1 → L_form ≠ 0 →
      ∃ z : Z_bar.left, ι_bar.left.base z ∉ weilProjHyperplaneSet k M L_form)
    (L : Fin 3 → MvPolynomial (Fin (M + 1)) k)
    (hL_homog : ∀ r : Fin 3, L r ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
    (hL_linIndep : ∀ c : Fin 3 → k, c ≠ 0 → (∑ r : Fin 3, MvPolynomial.C (c r) * L r) ≠ 0)
    (hNet_m0 : m = 0 → ∀ z : Z_bar.left,
      ∃ r : Fin 3, ι_bar.left.base z ∉ weilProjHyperplaneSet k M (L r))
    (hNet_pos : 1 ≤ m → IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m - 1) 3 L) :
    ∃ (Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π_Y : Y₂ ⟶ Z_bar)
      (g₂ : Y₂ ⟶ weilProjectiveSpaceOver k 2),
      IsLinearNetIncidenceFamily k M Z_bar ι_bar L Y₂ π_Y g₂ ∧
      AlgebraicGeometry.IsIntegral Y₂.left ∧
      AlgebraicGeometry.IsProper Y₂.hom ∧
      AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 3) Y₂.hom ∧
      IsProjectiveOverField k Y₂ ∧
      AlgebraicGeometry.Flat g₂.left ∧
      AlgebraicGeometry.IsProper g₂.left :=
by
  classical
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
    MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
    MvPolynomial.gradedAlgebra
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k

  have hMemBasicOpen_iff : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U : X.Opens}
      (hAff : AlgebraicGeometry.IsAffineOpen U)
      (f : ↑(X.presheaf.obj (Opposite.op U))) (x : ↥U),
      x.1 ∈ X.basicOpen f ↔ f ∉ (hAff.primeIdealOf x).asIdeal := by
    intro X U hAff f x
    have hx_from : hAff.fromSpec.base (hAff.primeIdealOf x) = x.1 :=
      hAff.fromSpec_primeIdealOf x
    have hpre : hAff.fromSpec ⁻¹ᵁ X.basicOpen f = PrimeSpectrum.basicOpen f := by
      rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, hAff.basicOpen_fromSpec_app f]
    rw [← hx_from]
    change hAff.primeIdealOf x ∈ (hAff.fromSpec ⁻¹ᵁ X.basicOpen f) ↔ _
    rw [hpre]
    exact PrimeSpectrum.mem_basicOpen f (hAff.primeIdealOf x)

  have hIsUnit_of_forall_prime : ∀ {R : Type u} [CommRing R] (x : R),
      (∀ p : PrimeSpectrum R, x ∉ p.asIdeal) → IsUnit x := by
    intro R _ x hx
    by_contra hnu
    obtain ⟨𝔪, h𝔪_max, hx𝔪⟩ :=
      Ideal.exists_le_maximal (Ideal.span {x}) (Ideal.span_singleton_ne_top hnu)
    exact hx ⟨𝔪, h𝔪_max.isPrime⟩ (hx𝔪 (Ideal.subset_span rfl))

  obtain ⟨Y₂, π_Y, g₂, hNet_inc, ⟨hProp_Y₂, hProp_g₂⟩,
      ⟨ι_Y₂, hCl_Y₂, hπ_eq, hg_eq⟩, ⟨hCov_Z, hCov_P⟩, hCharts⟩ :=
    weil_net_incidence_subscheme_and_chart_iso k M Z_bar ι_bar L hL_homog

  have hProj_Y₂ : IsProjectiveOverField k Y₂ := by
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let Z_base : CategoryTheory.Over S_k := CategoryTheory.Over.mk (𝟙 S_k)
    haveI : AlgebraicGeometry.IsSeparated Z_base.hom := by
      dsimp [Z_base]
      infer_instance
    let g₁_ov : Z_bar ⟶ Z_base :=
      CategoryTheory.Over.homMk Z_bar.hom (CategoryTheory.Category.comp_id _)
    let g₂_ov : weilProjectiveSpaceOver k 2 ⟶ Z_base :=
      CategoryTheory.Over.homMk (weilProjectiveSpaceOver k 2).hom (CategoryTheory.Category.comp_id _)
    have hProj₁ : IsProjectiveOverField k Z_bar := ⟨M, ι_bar, hCl_ι⟩
    have hProj₂ : IsProjectiveOverField k (weilProjectiveSpaceOver k 2) :=
      ⟨2, 𝟙 _, by dsimp; infer_instance⟩
    obtain ⟨N_Q, ι_Q, hCl_Q⟩ :=
      weil_projectiveOverField_pullback_of_isSeparated k Z_bar (weilProjectiveSpaceOver k 2)
        Z_base g₁_ov g₂_ov hProj₁ hProj₂
    let Q_ov := CategoryTheory.Over.mk
      (CategoryTheory.Limits.pullback.fst g₁_ov.left g₂_ov.left ≫ Z_bar.hom)
    have hYQ_w : ι_Y₂ ≫ Q_ov.hom = Y₂.hom := by
      change ι_Y₂ ≫
        (CategoryTheory.Limits.pullback.fst Z_bar.hom (weilProjectiveSpaceOver k 2).hom ≫
          Z_bar.hom) = Y₂.hom
      rw [← CategoryTheory.Category.assoc, hπ_eq, CategoryTheory.Over.w]
    let ι_YQ : Y₂ ⟶ Q_ov := CategoryTheory.Over.homMk ι_Y₂ hYQ_w
    exact ⟨N_Q, ι_YQ ≫ ι_Q,
      @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ ι_Y₂ ι_Q.left hCl_Y₂ hCl_Q⟩

  have hL_nondeg : ∀ r : Fin 3,
      ∃ z : Z_bar.left, ι_bar.left.base z ∉ weilProjHyperplaneSet k M (L r) := by
    intro r
    let c_r : Fin 3 → k := Pi.single r 1
    have hc_r : c_r ≠ 0 := by
      intro h0
      have h1 : c_r r = 0 := congrFun h0 r
      simp [c_r] at h1
    have hsum : (∑ j : Fin 3, MvPolynomial.C (c_r j) * L j) = L r := by
      rw [Finset.sum_eq_single r]
      · simp [c_r]
      · intro j _ hj
        simp [c_r, Pi.single_eq_of_ne hj]
      · intro hr
        exact absurd (Finset.mem_univ r) hr
    have hLr_ne : L r ≠ 0 := by
      rw [← hsum]
      exact hL_linIndep c_r hc_r
    exact hNondeg (L r) (hL_homog r) hLr_ne

  let C_Z : Fin (M + 1) → Z_bar.left.Opens := fun α =>
    (TopologicalSpace.Opens.map ι_bar.left.base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α))
  let D_P : Fin 3 → (weilProjectiveSpaceOver k 2).left.Opens := fun β =>
    AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X β)
  have hCov_Z' : (⨆ α : Fin (M + 1), C_Z α) = ⊤ := hCov_Z
  have hCov_P' : (⨆ β : Fin 3, D_P β) = ⊤ := hCov_P

  have hFlat_g₂ : AlgebraicGeometry.Flat g₂.left := by
    let IdxFlat :=
      { p : Fin 3 × Fin (M + 1) × Z_bar.left.affineOpens // p.2.2.1 ≤ C_Z p.2.1 }
    let V_cov : IdxFlat → Y₂.left.Opens := fun ⟨⟨β, _, U_Z⟩, _⟩ =>
      (TopologicalSpace.Opens.map π_Y.left.base).obj U_Z.1 ⊓
        (TopologicalSpace.Opens.map g₂.left.base).obj (D_P β)
    have hV_cov_top : (⨆ idx : IdxFlat, V_cov idx) = ⊤ := by
      rw [eq_top_iff]
      intro y _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hgy : g₂.left.base y ∈ (⨆ β : Fin 3, D_P β) := by
        rw [hCov_P']
        trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hgy
      obtain ⟨β, hβ⟩ := hgy
      have hzy : π_Y.left.base y ∈ (⨆ α : Fin (M + 1), C_Z α) := by
        rw [hCov_Z']
        trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hzy
      obtain ⟨α, hα⟩ := hzy
      obtain ⟨U_Z, U_Z_aff, hzUZ, hUZ_le⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hα
      exact ⟨⟨⟨β, α, ⟨U_Z, U_Z_aff⟩⟩, hUZ_le⟩, ⟨hzUZ, hβ⟩⟩
    haveI hLocalSrc : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.Flat) :=
      @AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        (@AlgebraicGeometry.Flat) (@RingHom.Flat) inferInstance
    apply AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top (P := @AlgebraicGeometry.Flat)
      V_cov hV_cov_top
    rintro ⟨⟨β, α, U_Z⟩, hUZ⟩
    have hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1 :=
      MvPolynomial.isHomogeneous_X k α
    obtain ⟨hAffDβ, e_P, hChartβ⟩ := hCharts β
    obtain ⟨hAffVY, e_Y, _, hVanLin, _, hg_appLE, _, _⟩ :=
      hChartβ α hXα U_Z.1 U_Z.2 hUZ
    let V_Y : Y₂.left.Opens := V_cov ⟨⟨β, α, U_Z⟩, hUZ⟩
    let A := ↑(Z_bar.left.presheaf.obj (Opposite.op U_Z.1))
    let κ_Z : k →+* A :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        Z_bar.hom.appLE ⊤ U_Z.1 le_top).hom
    let ℓ_r : Fin 3 → A := fun r =>
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
        ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) U_Z.1 hUZ).hom
        (HomogeneousLocalization.mk ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
    have hA_cond : Subsingleton A ∨
        (IsDomain A ∧ ∀ c : Fin 3 → k, c ≠ 0 →
          κ_Z (c 0) * ℓ_r β + κ_Z (c 1) * ℓ_r (β.succAbove 0) +
            κ_Z (c 2) * ℓ_r (β.succAbove 1) ≠ 0) := by
      by_cases hne : Nonempty ↥U_Z.1
      · right
        have hDomA : IsDomain A :=
          @AlgebraicGeometry.IsIntegral.component_integral Z_bar.left hInt U_Z.1
            (let ⟨x, hx⟩ := hne; ⟨x, hx⟩)
        refine ⟨hDomA, fun c hc => ?_⟩
        let c' : Fin 3 → k := Fin.succAboveCases β (c 0) (fun i => c i.succ)
        have hc' : c' ≠ 0 := by
          intro hc'0
          apply hc
          ext j
          fin_cases j
          · have h0 := congrFun hc'0 β
            simpa [c'] using h0
          · have h1 := congrFun hc'0 (β.succAbove 0)
            simpa [c'] using h1
          · have h2 := congrFun hc'0 (β.succAbove 1)
            simpa [c'] using h2
        let L_c : MvPolynomial (Fin (M + 1)) k := ∑ r : Fin 3, MvPolynomial.C (c' r) * L r
        have hLc_hom : L_c ∈ 𝒜_M 1 := by
          refine Submodule.sum_mem _ fun r _ => ?_
          exact (hL_homog r).C_mul (c' r)
        have hLc_ne : L_c ≠ 0 := hL_linIndep c' hc'
        obtain ⟨z₁, hz₁⟩ := hNondeg L_c hLc_hom hLc_ne
        let U_Lc : Z_bar.left.Opens :=
          (TopologicalSpace.Opens.map ι_bar.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_M L_c)
        have hULc_ne : (U_Lc : Set Z_bar.left).Nonempty := ⟨z₁, Classical.not_not.mp hz₁⟩
        have hUZ_ne : (U_Z.1 : Set Z_bar.left).Nonempty :=
          let ⟨x, hx⟩ := hne; ⟨x, hx⟩
        haveI : AlgebraicGeometry.IsIntegral Z_bar.left := hInt
        obtain ⟨z₂, hz₂_UZ, hz₂_ULc⟩ :=
          nonempty_preirreducible_inter U_Z.1.2 U_Lc.2 hUZ_ne hULc_ne
        have hNotMem : (∑ r : Fin 3, κ_Z (c' r) * ℓ_r r) ∉
            (U_Z.2.primeIdealOf ⟨z₂, hz₂_UZ⟩).asIdeal := by
          rw [← hVanLin ⟨z₂, hz₂_UZ⟩ c']
          intro hmem_compl
          exact hmem_compl hz₂_ULc
        have hSumEq : (∑ r : Fin 3, κ_Z (c' r) * ℓ_r r) =
            κ_Z (c 0) * ℓ_r β + κ_Z (c 1) * ℓ_r (β.succAbove 0) +
              κ_Z (c 2) * ℓ_r (β.succAbove 1) := by
          rw [Fin.sum_univ_succAbove _ β, Fin.sum_univ_two]
          simp [c', add_assoc]
        intro hZero
        rw [← hSumEq] at hZero
        exact hNotMem (hZero ▸ Ideal.zero_mem _)
      · left
        rw [not_nonempty_iff] at hne
        have hEmpSpec : IsEmpty (PrimeSpectrum A) :=
          ⟨fun p => hne.false ⟨(U_Z.2.isoSpec.inv.base p).1, (U_Z.2.isoSpec.inv.base p).2⟩⟩
        exact PrimeSpectrum.isEmpty_iff_subsingleton.mp hEmpSpec
    have hFlat_quot : RingHom.Flat
        ((Ideal.Quotient.mk
          (Ideal.span
            ({MvPolynomial.C (ℓ_r β) +
              MvPolynomial.C (ℓ_r (β.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
              MvPolynomial.C (ℓ_r (β.succAbove 1)) * MvPolynomial.X (1 : Fin 2)} :
              Set (MvPolynomial (Fin 2) A)))).comp
          (MvPolynomial.map κ_Z)) :=
      weil_algClosed_incidence_quotient_flat k A κ_Z
        (ℓ_r β) (ℓ_r (β.succAbove 0)) (ℓ_r (β.succAbove 1)) hA_cond
    let ψ_flat := (Ideal.Quotient.mk
      (Ideal.span
        ({MvPolynomial.C (ℓ_r β) +
          MvPolynomial.C (ℓ_r (β.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
          MvPolynomial.C (ℓ_r (β.succAbove 1)) * MvPolynomial.X (1 : Fin 2)} :
          Set (MvPolynomial (Fin 2) A)))).comp (MvPolynomial.map κ_Z)
    have hFlat_appLE : RingHom.Flat (g₂.left.appLE (D_P β) V_Y inf_le_right).hom := by
      have h1 : RingHom.Flat ((e_Y.toCommRingCatIso.hom).hom.comp (CommRingCat.ofHom ψ_flat).hom) := by
        exact (RingHom.Flat.respectsIso.cancel_right_isIso
          (CommRingCat.ofHom ψ_flat) e_Y.toCommRingCatIso.hom).mpr hFlat_quot
      have h2 : RingHom.Flat
          ((CommRingCat.ofHom (e_Y.toRingHom.comp ψ_flat)).hom.comp
            (e_P.symm.toCommRingCatIso.hom).hom) := by
        refine (RingHom.Flat.respectsIso.cancel_left_isIso
          e_P.symm.toCommRingCatIso.hom (CommRingCat.ofHom (e_Y.toRingHom.comp ψ_flat))).mpr ?_
        simpa [RingEquiv.toCommRingCatIso_hom] using h1
      have hEqHom : (g₂.left.appLE (D_P β) V_Y inf_le_right).hom =
          (CommRingCat.ofHom (e_Y.toRingHom.comp ψ_flat)).hom.comp
            (e_P.symm.toCommRingCatIso.hom).hom := by
        ext x
        have hx1 : (g₂.left.appLE (D_P β) V_Y inf_le_right).hom x =
            (g₂.left.appLE (D_P β) V_Y inf_le_right).hom (e_P (e_P.symm x)) :=
          congrArg _ (e_P.apply_symm_apply x).symm
        exact hx1.trans (hg_appLE (e_P.symm x))
      rw [hEqHom]
