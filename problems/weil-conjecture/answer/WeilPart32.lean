        let _ : Algebra P_aux A := (ψ_V.comp e₂.toRingHom).toAlgebra
        have : IsScalarTower P_aux (MvPolynomial (Fin d) k) A := IsScalarTower.of_algebraMap_eq' rfl
        have : Algebra.Etale P_aux (MvPolynomial (Fin d) k) :=
          RingHom.etale_algebraMap.mp (RingHom.Etale.of_bijective e₂.bijective)
        have : Algebra.Etale (MvPolynomial (Fin d) k) A := RingHom.etale_algebraMap.mp hψV_et
        exact RingHom.etale_algebraMap.mpr (Algebra.Etale.comp P_aux (MvPolynomial (Fin d) k) A)
      let _ : Algebra (MvPolynomial (Fin d) k) P_aux := e₁.toRingHom.toAlgebra
      let _ : Algebra P_aux A := (ψ_V.comp e₂.toRingHom).toAlgebra
      let _ : Algebra (MvPolynomial (Fin d) k) A := ψ_z.toAlgebra
      have hcomp_eq : (ψ_V.comp e₂.toRingHom).comp e₁.toRingHom = ψ_z := by
        apply RingHom.ext
        intro P
        change ψ_V (τ_shift (e₁.symm (e₁ P))) = ψ_V (τ_shift P)
        rw [e₁.symm_apply_apply]
