            (algebraMap _ R_z g₀ - algebraMap _ R_z (ψ_V (MvPolynomial.C u₀))) *
              algebraMap _ R_z (ψ_V Q) := by
        let loc_z := algebraMap (↑(Z_bar.left.presheaf.obj (Opposite.op V))) R_z
        change loc_z g₀ * loc_z (ℓ_V - ψ_V Q) =
          loc_z (f_V - ψ_V (MvPolynomial.C u₀ * Q)) -
            (loc_z g₀ - loc_z (ψ_V (MvPolynomial.C u₀))) * loc_z (ψ_V Q)
        have hgf : loc_z g₀ * loc_z ℓ_V = loc_z f_V := by
          rw [← map_mul, hL_eq]
        rw [map_sub, mul_sub, hgf, map_sub, map_mul, map_mul]
        ring
      rw [hid]
      have hterm2 : (algebraMap _ R_z g₀ - algebraMap _ R_z (ψ_V (MvPolynomial.C u₀))) *
          algebraMap _ R_z (ψ_V Q) ∈ 𝔪_z ^ 3 := by
        have h3 : 𝔪_z * (𝔪_z ^ 2) = 𝔪_z ^ 3 := (pow_succ' 𝔪_z 2).symm
        rw [← h3]
