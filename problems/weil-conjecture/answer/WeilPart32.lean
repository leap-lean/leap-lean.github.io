  have hs4 : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (W₀ W_inf : Y.left.Opens)
      (_ : AlgebraicGeometry.IsAffineOpen W₀)
      (_ : AlgebraicGeometry.IsAffineOpen W_inf)
      (T : ↑(Y.left.presheaf.obj (Opposite.op W₀)))
      (S : ↑(Y.left.presheaf.obj (Opposite.op W_inf)))
      (_ : Y.left.basicOpen T = W₀ ⊓ W_inf)
      (_ : Y.left.basicOpen S = W₀ ⊓ W_inf)
      (_ : (Y.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀ ⊓ W_inf ≤ W₀)).op).hom T *
        (Y.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀ ⊓ W_inf ≤ W_inf)).op).hom S = 1),
      let φ_0 : k →+* ↑(Y.left.presheaf.obj (Opposite.op W₀)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Y.hom.appLE ⊤ W₀ le_top).hom
      let φ_inf : k →+* ↑(Y.left.presheaf.obj (Opposite.op W_inf)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Y.hom.appLE ⊤ W_inf le_top).hom
      letI : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W₀)) := φ_0.toAlgebra
      letI : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W_inf)) := φ_inf.toAlgebra
      ∃ e : Localization.Away T ≃ₐ[k] Localization.Away S,
        e (algebraMap ↑(Y.left.presheaf.obj (Opposite.op W₀)) (Localization.Away T) T) *
          algebraMap ↑(Y.left.presheaf.obj (Opposite.op W_inf)) (Localization.Away S) S = 1 := by
    intro Y W₀ W_inf hAff₀ hAff_inf T S hBasicT hBasicS hInv φ_0 φ_inf
    let R₀ := ↑(Y.left.presheaf.obj (Opposite.op W₀))
    let R_inf := ↑(Y.left.presheaf.obj (Opposite.op W_inf))
    let R₀_inf := ↑(Y.left.presheaf.obj (Opposite.op (W₀ ⊓ W_inf)))
    let res₀ : R₀ →+* R₀_inf :=
      (Y.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀ ⊓ W_inf ≤ W₀)).op).hom
    let res_inf : R_inf →+* R₀_inf :=
      (Y.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀ ⊓ W_inf ≤ W_inf)).op).hom
    let φ₀_inf : k →+* R₀_inf :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        Y.hom.appLE ⊤ (W₀ ⊓ W_inf) le_top).hom
    have hres₀_φ : ∀ c : k, res₀ (φ_0 c) = φ₀_inf c := by
      intro c
      have h_top0 : W₀ ≤ (TopologicalSpace.Opens.map Y.hom.base).obj ⊤ := le_top
      have hmap := Y.hom.appLE_map h_top0
        (CategoryTheory.homOfLE (inf_le_left : W₀ ⊓ W_inf ≤ W₀)).op
      have hcomp : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Y.hom.appLE ⊤ W₀ h_top0) ≫
          Y.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀ ⊓ W_inf ≤ W₀)).op =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            Y.hom.appLE ⊤ (W₀ ⊓ W_inf) le_top := by
        rw [CategoryTheory.Category.assoc, hmap]
      exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hcomp) c
    have hres_inf_φ : ∀ c : k, res_inf (φ_inf c) = φ₀_inf c := by
      intro c
      have h_top_inf : W_inf ≤ (TopologicalSpace.Opens.map Y.hom.base).obj ⊤ := le_top
      have hmap := Y.hom.appLE_map h_top_inf
        (CategoryTheory.homOfLE (inf_le_right : W₀ ⊓ W_inf ≤ W_inf)).op
      have hcomp : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Y.hom.appLE ⊤ W_inf h_top_inf) ≫
          Y.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀ ⊓ W_inf ≤ W_inf)).op =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            Y.hom.appLE ⊤ (W₀ ⊓ W_inf) le_top := by
        rw [CategoryTheory.Category.assoc, hmap]
      exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hcomp) c
    have heT_ex : ∃ e_T : Localization.Away T ≃+* R₀_inf,
        ∀ a : R₀, e_T (algebraMap R₀ (Localization.Away T) a) = res₀ a := by
      let _ : Algebra R₀ R₀_inf := res₀.toAlgebra
      have _ : IsLocalization.Away T R₀_inf :=
        @AlgebraicGeometry.IsAffineOpen.isLocalization_of_eq_basicOpen Y.left W₀ hAff₀ T
          (W₀ ⊓ W_inf) (CategoryTheory.homOfLE inf_le_left) hBasicT.symm
      let e_alg : Localization.Away T ≃ₐ[R₀] R₀_inf :=
        IsLocalization.algEquiv (Submonoid.powers T) (Localization.Away T) R₀_inf
      exact ⟨e_alg.toRingEquiv, fun a => e_alg.commutes a⟩
    have heS_ex : ∃ e_S : Localization.Away S ≃+* R₀_inf,
        ∀ b : R_inf, e_S (algebraMap R_inf (Localization.Away S) b) = res_inf b := by
      let _ : Algebra R_inf R₀_inf := res_inf.toAlgebra
      have _ : IsLocalization.Away S R₀_inf :=
        @AlgebraicGeometry.IsAffineOpen.isLocalization_of_eq_basicOpen Y.left W_inf hAff_inf S
          (W₀ ⊓ W_inf) (CategoryTheory.homOfLE inf_le_right) hBasicS.symm
      let e_alg : Localization.Away S ≃ₐ[R_inf] R₀_inf :=
        IsLocalization.algEquiv (Submonoid.powers S) (Localization.Away S) R₀_inf
      exact ⟨e_alg.toRingEquiv, fun b => e_alg.commutes b⟩
    obtain ⟨e_T, he_T⟩ := heT_ex
    obtain ⟨e_S, he_S⟩ := heS_ex
    let _ : Algebra k R₀ := φ_0.toAlgebra
    let _ : Algebra k R_inf := φ_inf.toAlgebra
    let e_ring : Localization.Away T ≃+* Localization.Away S := e_T.trans e_S.symm
    have hcomm_k : ∀ c : k,
        e_ring (algebraMap k (Localization.Away T) c) =
          algebraMap k (Localization.Away S) c := by
      intro c
      apply e_S.injective
      change e_S (e_S.symm (e_T (algebraMap R₀ (Localization.Away T) (φ_0 c)))) =
        e_S (algebraMap R_inf (Localization.Away S) (φ_inf c))
      rw [e_S.apply_symm_apply, he_T (φ_0 c), he_S (φ_inf c), hres₀_φ c, hres_inf_φ c]
    let e : Localization.Away T ≃ₐ[k] Localization.Away S :=
      AlgEquiv.ofRingEquiv (f := e_ring) hcomm_k
    refine ⟨e, ?_⟩
    apply e_S.injective
    rw [map_mul, map_one]
    change e_S (e_S.symm (e_T (algebraMap R₀ (Localization.Away T) T))) *
        e_S (algebraMap R_inf (Localization.Away S) S) = 1
    rw [e_S.apply_symm_apply, he_T T, he_S S]
    exact hInv

  
  
  
