          have hcomp : AlgebraicGeometry.Proj.awayToSection 𝒜_N H_b ≫
              f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H_b) W hWb =
              CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜_N hHa (mul_comm H_a H_b)) ≫
                (AlgebraicGeometry.Proj.awayToSection 𝒜_N (H_a * H_b) ≫
                  f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (H_a * H_b)) W hW_prod) := by
            rw [← f_X.map_appLE hW_prod (CategoryTheory.homOfLE hiB).op,
              ← CategoryTheory.Category.assoc,
              ← AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜_N hHa (mul_comm H_a H_b),
              CategoryTheory.Category.assoc]
          exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hcomp) η
        let ξ_a := HomogeneousLocalization.Away.mk 𝒜_N hHa 1 H₀ hH₀
        let ξ_b := HomogeneousLocalization.Away.mk 𝒜_N hHb 1 H₀ hH₀
        let u_ab := HomogeneousLocalization.Away.mk 𝒜_N hHa 1 H_b hHb
        have hrel : HomogeneousLocalization.awayMap 𝒜_N hHb rfl ξ_a =
            HomogeneousLocalization.awayMap 𝒜_N hHb rfl u_ab *
              HomogeneousLocalization.awayMap 𝒜_N hHa (mul_comm H_a H_b) ξ_b := by
          apply HomogeneousLocalization.val_injective
          dsimp only [ξ_a, ξ_b, u_ab]
          simp only [HomogeneousLocalization.val_mul,
            HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
            Localization.mk_mul]
          rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
          refine ⟨1, ?_⟩
          simp only [OneMemClass.coe_one, MulMemClass.coe_mul]
          ring
        refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
        change (f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H_a) W hWa).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H_a).hom ξ_a) ∈
          Ideal.span {(f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H_b) W hWb).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H_b).hom ξ_b)}
        rw [hΦa ξ_a, hΦb ξ_b, hrel, map_mul]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      intro H_a H_b hHa hHb W hWa hWb
      exact le_antisymm (h_le H_a H_b hHa hHb W hWa hWb) (h_le H_b H_a hHb hHa W hWb hWa)
    · 
      intro α hXα W hW x hx
      let P_N : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜_N
      let D_α : P_N.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)
      let num_den : HomogeneousLocalization.NumDenSameDeg 𝒜_N
          (Submonoid.powers (MvPolynomial.X α)) :=
        ⟨1, ⟨H₀, hH₀⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩
      let z₀ : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α) :=
        HomogeneousLocalization.mk num_den
      have hmk_eq : HomogeneousLocalization.Away.mk 𝒜_N hXα 1 H₀ hH₀ = z₀ := by
        apply HomogeneousLocalization.val_injective
        simp [z₀, num_den, HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_mk,
          pow_one]
      let s_P := (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α)).hom z₀
      rw [hmk_eq, AlgebraicGeometry.Scheme.basicOpen_appLE]
      have hx_Dα : f_X.base x ∈ D_α := hW hx
      let y_D : ↥D_α := ⟨f_X.base x, hx_Dα⟩
      have hpre1 :
          (TopologicalSpace.Opens.map
              (AlgebraicGeometry.ProjectiveSpectrum.Proj.toSpec 𝒜_N (MvPolynomial.X α)).base).obj
            (PrimeSpectrum.basicOpen z₀) =
          (TopologicalSpace.Opens.map D_α.ι.base).obj (P_N.basicOpen s_P) := by
        change (TopologicalSpace.Opens.map
            (D_α.toSpecΓ ≫
              AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α))).base).obj
            (PrimeSpectrum.basicOpen z₀) = _
        have hcomp_map :
            (TopologicalSpace.Opens.map
              (D_α.toSpecΓ ≫
                AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α))).base).obj
              (PrimeSpectrum.basicOpen z₀) =
            (TopologicalSpace.Opens.map D_α.toSpecΓ.base).obj
              ((TopologicalSpace.Opens.map
                (AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α))).base).obj
                (PrimeSpectrum.basicOpen z₀)) := rfl
        rw [hcomp_map, AlgebraicGeometry.SpecMap_preimage_basicOpen]
        exact D_α.toSpecΓ_preimage_basicOpen s_P
      have hpre2 := AlgebraicGeometry.ProjectiveSpectrum.Proj.toSpec_preimage_basicOpen 𝒜_N num_den
      have hy_iff := SetLike.ext_iff.mp (hpre1.symm.trans hpre2) y_D
      change x ∈ W ∧ f_X.base x ∈ P_N.basicOpen s_P ↔
        ¬(f_X.base x ∉ (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₀).1)
      rw [Classical.not_not]
      exact ⟨fun h => hy_iff.mp h.2, fun h => ⟨hx, hy_iff.mpr h⟩⟩

  
  
  
  
  have h_s2 : ∀ (X₀ : AlgebraicGeometry.Scheme.{u}) (m_cov : ℕ)
      (C_cov : Fin m_cov → X₀.Opens)
      (_ : (⨆ α : Fin m_cov, C_cov α) = ⊤)
      (ℓ_cov : ∀ (α : Fin m_cov) (W : X₀.Opens),
        W ≤ C_cov α → ↑(X₀.presheaf.obj (Opposite.op W)))
      (S_supp : Set X₀),
      (∀ (α : Fin m_cov) (W W' : X₀.Opens) (hW : W ≤ C_cov α) (hWW' : W' ≤ W),
        (X₀.presheaf.map (CategoryTheory.homOfLE hWW').op).hom (ℓ_cov α W hW) =
          ℓ_cov α W' (hWW'.trans hW)) →
      (∀ (α β : Fin m_cov) (W : X₀.Opens) (hWα : W ≤ C_cov α) (hWβ : W ≤ C_cov β),
        Ideal.span {ℓ_cov α W hWα} = Ideal.span {ℓ_cov β W hWβ}) →
      (∀ (α : Fin m_cov) (W : X₀.Opens) (hW : W ≤ C_cov α) (x : X₀),
        x ∈ W → (x ∈ X₀.basicOpen (ℓ_cov α W hW) ↔ x ∉ S_supp)) →
      ∃ (Z : AlgebraicGeometry.Scheme.{u}) (ι_Z : Z ⟶ X₀),
        AlgebraicGeometry.IsClosedImmersion ι_Z ∧
        Set.range ι_Z.base = S_supp ∧
        ∀ (U : X₀.Opens) (_ : AlgebraicGeometry.IsAffineOpen U)
          (s_U : ↑(X₀.presheaf.obj (Opposite.op U))),
          (∀ (α : Fin m_cov) (g : ↑(X₀.presheaf.obj (Opposite.op U)))
              (hg : X₀.basicOpen g ≤ C_cov α),
            Ideal.span
                {(X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g)).op).hom s_U} =
              Ideal.span {ℓ_cov α (X₀.basicOpen g) hg}) →
          Function.Surjective (ι_Z.app U).hom ∧
          RingHom.ker (ι_Z.app U).hom = Ideal.span {s_U} := by
    intro X₀ m_cov C_cov hCov ℓ_cov S_supp hRes hOverlap hSupp

    have h_loc_glue : ∀ {R : Type u} [CommRing R] (I : Ideal R) {m : ℕ} (g : Fin m → R),
        Ideal.span (Set.range g) = ⊤ →
        ∀ r : R, (∀ i : Fin m, ∃ n : ℕ, (g i) ^ n * r ∈ I) → r ∈ I := by
      intro R _ I m g htop r hex
      choose n hn using hex
      let K : ℕ := Finset.univ.sup n
      have hpow_mem : ∀ i : Fin m, (g i) ^ K * r ∈ I := by
        intro i
        have hle : n i ≤ K := Finset.le_sup (Finset.mem_univ i)
        have heq : K = (K - n i) + n i := (Nat.sub_add_cancel hle).symm
        rw [heq, pow_add, mul_assoc]
        exact Ideal.mul_mem_left I _ (hn i)
      have hpow_top : Ideal.span ((fun x : R => x ^ K) '' Set.range g) = ⊤ :=
        Ideal.span_pow_eq_top (Set.range g) htop K
      have h1 : (1 : R) ∈ Ideal.span ((fun x : R => x ^ K) '' Set.range g) := by
        rw [hpow_top]; trivial
      have hmul := Submodule.span_induction
        (p := fun x _ => x * r ∈ I)
        (fun x hx => by
          rcases hx with ⟨_, ⟨i, rfl⟩, rfl⟩
          exact hpow_mem i)
        (by simp)
        (fun x y _ _ hx hy => by rw [add_mul]; exact add_mem hx hy)
        (fun c x _ hx => by rw [smul_eq_mul, mul_assoc]; exact Ideal.mul_mem_left I c hx)
        h1
      simpa using hmul

    have h_away_pow : ∀ {R S : Type u} [CommRing R] [CommRing S] (ρ : R →+* S) (g : R),
        @IsLocalization.Away R _ g S _ ρ.toAlgebra →
        ∀ (I : Ideal R) (r : R), ρ r ∈ Ideal.map ρ I → ∃ n : ℕ, g ^ n * r ∈ I := by
      intro R S _ _ ρ g hLoc I r hmem
      let _ : Algebra R S := ρ.toAlgebra
      have hmem' : algebraMap R S r ∈ Ideal.map (algebraMap R S) I := hmem
      obtain ⟨⟨⟨y, hy⟩, ⟨_, ⟨k₁, rfl⟩⟩⟩, heq⟩ :=
        (@IsLocalization.mem_map_algebraMap_iff R _ (Submonoid.powers g) S _ _ hLoc I
          (algebraMap R S r)).mp hmem'
      rw [← map_mul] at heq
      obtain ⟨⟨_, ⟨k₂, rfl⟩⟩, heq2⟩ :=
        (@IsLocalization.eq_iff_exists R _ (Submonoid.powers g) S _ _ hLoc _ _).mp heq
      refine ⟨k₂ + k₁, ?_⟩
      have hgoal : g ^ k₂ * (r * g ^ k₁) = g ^ k₂ * y := heq2
      have hrew : g ^ (k₂ + k₁) * r = g ^ k₂ * (r * g ^ k₁) := by rw [pow_add]; ring
      rw [hrew, hgoal]
      exact Ideal.mul_mem_left I _ hy

    have h_res_comp : ∀ {U V W : X₀.Opens} (hVW : W ≤ V) (hUV : V ≤ U)
        (x : ↑(X₀.presheaf.obj (Opposite.op U))),
        (X₀.presheaf.map (CategoryTheory.homOfLE hVW).op).hom
          ((X₀.presheaf.map (CategoryTheory.homOfLE hUV).op).hom x) =
          (X₀.presheaf.map (CategoryTheory.homOfLE (hVW.trans hUV)).op).hom x := by
      intro U V W hVW hUV x
      have hmor : (CategoryTheory.homOfLE hUV).op ≫ (CategoryTheory.homOfLE hVW).op =
          (CategoryTheory.homOfLE (hVW.trans hUV)).op :=
        Subsingleton.elim _ _
      exact RingHom.congr_fun
        (congrArg CommRingCat.Hom.hom (X₀.presheaf.map_comp _ _).symm) x |>.trans
        (by rw [hmor])

    have hJ_res : ∀ (α : Fin m_cov) {W W' : X₀.Opens} (hW : W ≤ C_cov α) (hWW' : W' ≤ W),
        Ideal.map (X₀.presheaf.map (CategoryTheory.homOfLE hWW').op).hom
          (Ideal.span {ℓ_cov α W hW}) =
          Ideal.span {ℓ_cov α W' (hWW'.trans hW)} := by
      intro α W W' hW hWW'
      rw [Ideal.map_span, Set.image_singleton, hRes]

    let ideal_fn : (U : X₀.affineOpens) → Ideal ↑(X₀.presheaf.obj (Opposite.op U.1)) :=
      fun U =>
        ⨅ (α : Fin m_cov) (g : ↑(X₀.presheaf.obj (Opposite.op U.1)))
          (hg : X₀.basicOpen g ≤ C_cov α),
          Ideal.comap
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g)).op).hom
            (Ideal.span {ℓ_cov α (X₀.basicOpen g) hg})

    have hmem_ideal_fn : ∀ (U : X₀.affineOpens) (r : ↑(X₀.presheaf.obj (Opposite.op U.1))),
        r ∈ ideal_fn U ↔
          ∀ (α : Fin m_cov) (g : ↑(X₀.presheaf.obj (Opposite.op U.1)))
            (hg : X₀.basicOpen g ≤ C_cov α),
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g)).op).hom r ∈
              Ideal.span {ℓ_cov α (X₀.basicOpen g) hg} := by
      intro U r
      simp only [ideal_fn, Ideal.mem_iInf, Ideal.mem_comap]

    have hex_pt_chart : ∀ (U : X₀.affineOpens) (x : X₀), x ∈ U.1 →
        ∃ (α₀ : Fin m_cov) (g₀ : ↑(X₀.presheaf.obj (Opposite.op U.1))),
          x ∈ X₀.basicOpen g₀ ∧ X₀.basicOpen g₀ ≤ C_cov α₀ := by
      intro U x hxU
      have hx_top : x ∈ (⊤ : X₀.Opens) := trivial
      rw [← hCov, TopologicalSpace.Opens.mem_iSup] at hx_top
      rcases hx_top with ⟨α₀, hxα⟩
      let q : PrimeSpectrum ↑(X₀.presheaf.obj (Opposite.op U.1)) := U.2.primeIdealOf ⟨x, hxU⟩
      have hq_eq : U.2.fromSpec.base q = x := U.2.fromSpec_primeIdealOf ⟨x, hxU⟩
      let O : TopologicalSpace.Opens (PrimeSpectrum ↑(X₀.presheaf.obj (Opposite.op U.1))) :=
        (TopologicalSpace.Opens.map U.2.fromSpec.base).obj (C_cov α₀)
      have hq_O : q ∈ (O : Set _) := by
        change U.2.fromSpec.base q ∈ C_cov α₀
        rw [hq_eq]
        exact hxα
      obtain ⟨B, ⟨g₀, rfl⟩, hq_B, hB_sub⟩ :=
        PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hq_O O.isOpen
      have h_img := U.2.fromSpec_image_basicOpen g₀
      refine ⟨α₀, g₀, ?_, ?_⟩
      · rw [← h_img]
        exact ⟨q, hq_B, hq_eq⟩
      · intro y hy
        rw [← h_img] at hy
        rcases hy with ⟨q', hq'B, rfl⟩
        exact hB_sub hq'B

    have hex_fin_cov : ∀ (U : X₀.affineOpens),
        ∃ (m : ℕ) (α_cov : Fin m → Fin m_cov)
          (g_cov : Fin m → ↑(X₀.presheaf.obj (Opposite.op U.1))),
          (∀ i : Fin m, X₀.basicOpen (g_cov i) ≤ C_cov (α_cov i)) ∧
          Ideal.span (Set.range g_cov) = ⊤ := by
      intro U
      let R := ↑(X₀.presheaf.obj (Opposite.op U.1))
      let S_good : Set R := { g : R | ∃ α : Fin m_cov, X₀.basicOpen g ≤ C_cov α }
      have hspan_top : Ideal.span S_good = ⊤ := by
        by_contra hne
        obtain ⟨𝔪, h𝔪_max, hle_𝔪⟩ := Ideal.exists_le_maximal (Ideal.span S_good) hne
        let q : PrimeSpectrum R := ⟨𝔪, h𝔪_max.isPrime⟩
        let x : X₀ := U.2.fromSpec.base q
        have hxU : x ∈ (U.1 : Set X₀) := by
          rw [← U.2.range_fromSpec]
          exact ⟨q, rfl⟩
        obtain ⟨α₀, g₀, hx_g₀, hg₀_le⟩ := hex_pt_chart U x hxU
        have hg₀_in_S : g₀ ∈ S_good := ⟨α₀, hg₀_le⟩
        have hg₀_mem : g₀ ∈ 𝔪 := hle_𝔪 (Ideal.subset_span hg₀_in_S)
        have hq_bo : q ∈ (TopologicalSpace.Opens.map U.2.fromSpec.base).obj (X₀.basicOpen g₀) :=
          hx_g₀
        rw [U.2.fromSpec_preimage_basicOpen g₀] at hq_bo
        exact hq_bo hg₀_mem
      have h1_mem : (1 : R) ∈ Ideal.span S_good := by
        rw [hspan_top]; trivial
      classical
      have hex_fin : ∃ F : Finset R, (↑F : Set R) ⊆ S_good ∧
          (1 : R) ∈ Ideal.span (↑F : Set R) := by
        refine Submodule.span_induction
          (p := fun x _ => ∃ F : Finset R, (↑F : Set R) ⊆ S_good ∧
            x ∈ Ideal.span (↑F : Set R))
          (fun g hg => ⟨{g}, by simpa using hg,
            Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_singleton_self g))⟩)
          ⟨∅, by simp, zero_mem _⟩
          (fun x y _ _ ⟨Fx, hFx, hx⟩ ⟨Fy, hFy, hy⟩ =>
            ⟨Fx ∪ Fy,
              by rw [Finset.coe_union]; exact Set.union_subset hFx hFy,
              add_mem
                (Ideal.span_mono (by rw [Finset.coe_union]; exact Set.subset_union_left) hx)
                (Ideal.span_mono (by rw [Finset.coe_union]; exact Set.subset_union_right) hy)⟩)
          (fun c x _ ⟨Fx, hFx, hx⟩ =>
            ⟨Fx, hFx, Ideal.mul_mem_left _ c hx⟩)
          h1_mem
      rcases hex_fin with ⟨F, hF_sub, h1_F⟩
      let e := F.equivFin
      let g_cov : Fin F.card → R := fun i => (e.symm i).1
      have hg_good : ∀ i : Fin F.card, ∃ α : Fin m_cov, X₀.basicOpen (g_cov i) ≤ C_cov α :=
        fun i => hF_sub (e.symm i).2
      choose α_cov hα_cov using hg_good
      have hrange : Set.range g_cov = (↑F : Set R) := by
        ext r
        simp only [Set.mem_range, Finset.mem_coe, g_cov]
        refine ⟨fun ⟨i, hi⟩ => hi ▸ (e.symm i).2, fun hr => ⟨e ⟨r, hr⟩, ?_⟩⟩
        simp
      refine ⟨F.card, α_cov, g_cov, hα_cov, ?_⟩
      rw [hrange]
      exact (Ideal.eq_top_iff_one _).mpr h1_F

    have hmem_of_cov : ∀ (U : X₀.affineOpens) {m : ℕ}
        (α_cov : Fin m → Fin m_cov)
        (g_cov : Fin m → ↑(X₀.presheaf.obj (Opposite.op U.1)))
        (hg_cov : ∀ i : Fin m, X₀.basicOpen (g_cov i) ≤ C_cov (α_cov i)),
        Ideal.span (Set.range g_cov) = ⊤ →
        ∀ r : ↑(X₀.presheaf.obj (Opposite.op U.1)),
          (∀ i : Fin m,
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le (g_cov i))).op).hom r ∈
              Ideal.span {ℓ_cov (α_cov i) (X₀.basicOpen (g_cov i)) (hg_cov i)}) →
          r ∈ ideal_fn U := by
      intro U m α_cov g_cov hg_cov htop r hr_cov
      rw [hmem_ideal_fn]
      intro α h hh
      let U_h : X₀.Opens := X₀.basicOpen h
      have hAff_Uh : AlgebraicGeometry.IsAffineOpen U_h := U.2.basicOpen h
      let res_h := (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le h)).op).hom
      let g_h : Fin m → ↑(X₀.presheaf.obj (Opposite.op U_h)) := fun i => res_h (g_cov i)
      have htop_h : Ideal.span (Set.range g_h) = ⊤ := by
        have hrng : Set.range g_h = res_h '' Set.range g_cov := by
          ext y; simp [g_h]
        rw [hrng, ← Ideal.map_span, htop, Ideal.map_top]
      refine h_loc_glue (Ideal.span {ℓ_cov α U_h hh}) g_h htop_h (res_h r) fun i => ?_
      let W_i : X₀.Opens := X₀.basicOpen (g_h i)
      let res_wi := (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le (g_h i))).op).hom
      have hWi_eq : W_i = U_h ⊓ X₀.basicOpen (g_cov i) :=
        X₀.basicOpen_res (g_cov i) (CategoryTheory.homOfLE (X₀.basicOpen_le h)).op
      have hWi_gi : W_i ≤ X₀.basicOpen (g_cov i) := by
        rw [hWi_eq]; exact inf_le_right
      have h_mem_Wi : res_wi (res_h r) ∈
          Ideal.map res_wi (Ideal.span {ℓ_cov α U_h hh}) := by
        have hcomp_eq : res_wi (res_h r) =
            (X₀.presheaf.map (CategoryTheory.homOfLE hWi_gi).op).hom
              ((X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le (g_cov i))).op).hom r) := by
          rw [h_res_comp, h_res_comp]
        rw [hcomp_eq, hJ_res α hh (X₀.basicOpen_le (g_h i)),
          hOverlap α (α_cov i) W_i _ (hWi_gi.trans (hg_cov i)),
          ← hJ_res (α_cov i) (hg_cov i) hWi_gi]
        exact Ideal.mem_map_of_mem _ (hr_cov i)
      exact h_away_pow res_wi (g_h i) (hAff_Uh.isLocalization_basicOpen (g_h i))
        (Ideal.span {ℓ_cov α U_h hh}) (res_h r) h_mem_Wi

    have hideal_gen : ∀ (U : X₀.affineOpens) (s_U : ↑(X₀.presheaf.obj (Opposite.op U.1))),
        (∀ (α : Fin m_cov) (g : ↑(X₀.presheaf.obj (Opposite.op U.1)))
            (hg : X₀.basicOpen g ≤ C_cov α),
          Ideal.span
              {(X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g)).op).hom s_U} =
            Ideal.span {ℓ_cov α (X₀.basicOpen g) hg}) →
        ideal_fn U = Ideal.span {s_U} := by
      intro U s_U hs_U
      apply le_antisymm
      · obtain ⟨m, α_cov, g_cov, hg_cov, htop⟩ := hex_fin_cov U
        intro r hr
        rw [hmem_ideal_fn] at hr
        refine h_loc_glue (Ideal.span {s_U}) g_cov htop r fun i => ?_
        let res_i := (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le (g_cov i))).op).hom
        have hmem_i : res_i r ∈ Ideal.map res_i (Ideal.span {s_U}) := by
          rw [Ideal.map_span, Set.image_singleton, hs_U (α_cov i) (g_cov i) (hg_cov i)]
          exact hr (α_cov i) (g_cov i) (hg_cov i)
        exact h_away_pow res_i (g_cov i) (U.2.isLocalization_basicOpen (g_cov i))
          (Ideal.span {s_U}) r hmem_i
      · refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
        change s_U ∈ ideal_fn U
        rw [hmem_ideal_fn]
        intro α g hg
        rw [← hs_U α g hg]
        exact Ideal.mem_span_singleton_self _

    have hideal_on_chart : ∀ (U : X₀.affineOpens) (α₀ : Fin m_cov) (hUα : U.1 ≤ C_cov α₀),
        ideal_fn U = Ideal.span {ℓ_cov α₀ U.1 hUα} := by
      intro U α₀ hUα
      refine hideal_gen U (ℓ_cov α₀ U.1 hUα) fun α g hg => ?_
      rw [hRes α₀ U.1 (X₀.basicOpen g) hUα (X₀.basicOpen_le g)]
      exact hOverlap α₀ α (X₀.basicOpen g) ((X₀.basicOpen_le g).trans hUα) hg

    have hmap_basicOpen : ∀ (U : X₀.affineOpens) (f : ↑(X₀.presheaf.obj (Opposite.op U.1))),
        Ideal.map (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le f)).op).hom
          (ideal_fn U) = ideal_fn (X₀.affineBasicOpen f) := by
      intro U f
      let U_f : X₀.affineOpens := X₀.affineBasicOpen f
      let res_f := (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le f)).op).hom
      have hLoc_f := U.2.isLocalization_basicOpen f
      let _ : Algebra ↑(X₀.presheaf.obj (Opposite.op U.1))
          ↑(X₀.presheaf.obj (Opposite.op U_f.1)) := res_f.toAlgebra
      apply le_antisymm
      · refine Ideal.map_le_iff_le_comap.mpr fun r hr => ?_
        let r_f : ↑(X₀.presheaf.obj (Opposite.op U_f.1)) := res_f r
        change r_f ∈ ideal_fn U_f
        rw [hmem_ideal_fn U_f r_f]
        intro α w hw
        let w₀ : ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen f))) := w
        have hw₀ : X₀.basicOpen w₀ ≤ C_cov α := hw
        obtain ⟨⟨h₀, ⟨_, ⟨k, rfl⟩⟩⟩, hsurj⟩ :=
          @IsLocalization.surj _ _ (Submonoid.powers f) _ _ _ hLoc_f w₀
        have hsurj' : w₀ * res_f (f ^ k) = res_f h₀ := hsurj
        have hu_fk : IsUnit (res_f (f ^ k)) :=
          @IsLocalization.map_units _ _ (Submonoid.powers f) _ _ _ hLoc_f ⟨f ^ k, k, rfl⟩
        have hbo_eq : X₀.basicOpen (f * h₀) = X₀.basicOpen w₀ := by
          calc
            X₀.basicOpen (f * h₀) = X₀.basicOpen f ⊓ X₀.basicOpen h₀ := X₀.basicOpen_mul f h₀
            _ = X₀.basicOpen (res_f h₀) :=
                (X₀.basicOpen_res h₀ (CategoryTheory.homOfLE (X₀.basicOpen_le f)).op).symm
            _ = X₀.basicOpen (w₀ * res_f (f ^ k)) := by rw [hsurj']
            _ = X₀.basicOpen w₀ ⊓ X₀.basicOpen (res_f (f ^ k)) := X₀.basicOpen_mul _ _
            _ = X₀.basicOpen w₀ ⊓ X₀.basicOpen f := by rw [X₀.basicOpen_of_isUnit hu_fk]
            _ = X₀.basicOpen w₀ := inf_eq_left.mpr (X₀.basicOpen_le w₀)
        have hfh₀_le : X₀.basicOpen (f * h₀) ≤ C_cov α := hbo_eq.le.trans hw₀
        have hr_fh₀ :
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le (f * h₀))).op).hom r ∈
              Ideal.span {ℓ_cov α (X₀.basicOpen (f * h₀)) hfh₀_le} :=
          (hmem_ideal_fn U r).mp hr α (f * h₀) hfh₀_le
        have hle_w_fh₀ : X₀.basicOpen w₀ ≤ X₀.basicOpen (f * h₀) := hbo_eq.symm.le
        have hmem_w := Ideal.mem_map_of_mem
          (X₀.presheaf.map (CategoryTheory.homOfLE hle_w_fh₀).op).hom hr_fh₀
        rw [hJ_res α hfh₀_le hle_w_fh₀, h_res_comp] at hmem_w
        have hcomp_eq :
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le w₀)).op).hom (res_f r) =
              (X₀.presheaf.map
                (CategoryTheory.homOfLE (hle_w_fh₀.trans (X₀.basicOpen_le (f * h₀)))).op).hom r :=
          h_res_comp _ _ r
        change (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le w₀)).op).hom (res_f r) ∈ _
        rwa [hcomp_eq]
      · intro z hz
        obtain ⟨⟨r₀, ⟨_, ⟨e₀, rfl⟩⟩⟩, hz_eq⟩ :=
          @IsLocalization.surj _ _ (Submonoid.powers f) _ _ _ hLoc_f z
        have hz_eq' : z * res_f (f ^ e₀) = res_f r₀ := hz_eq
        have hr₀_mem : res_f r₀ ∈ ideal_fn U_f := by
          rw [← hz_eq', mul_comm]
          exact Ideal.mul_mem_left _ _ hz
        obtain ⟨m, α_cov, g_cov, hg_cov, htop⟩ := hex_fin_cov U
        have hex_ki : ∀ i : Fin m, ∃ k_i : ℕ,
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le (g_cov i))).op).hom
              (f ^ k_i * r₀) ∈
              Ideal.span {ℓ_cov (α_cov i) (X₀.basicOpen (g_cov i)) (hg_cov i)} := by
          intro i
          let U_i : X₀.Opens := X₀.basicOpen (g_cov i)
          have hAff_Ui : AlgebraicGeometry.IsAffineOpen U_i := U.2.basicOpen (g_cov i)
          let res_i := (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le (g_cov i))).op).hom
          let f_i := res_i f
          let g'_i := res_f (g_cov i)
          have hg'_le : X₀.basicOpen g'_i ≤ C_cov (α_cov i) := by
            rw [X₀.basicOpen_res]
            exact inf_le_right.trans (hg_cov i)
          have hbo_symm : X₀.basicOpen f_i ≤ X₀.basicOpen g'_i := by
            rw [X₀.basicOpen_res, X₀.basicOpen_res, inf_comm]
          have hmem_g' :
              (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g'_i)).op).hom
                (res_f r₀) ∈ Ideal.span {ℓ_cov (α_cov i) (X₀.basicOpen g'_i) hg'_le} :=
            (hmem_ideal_fn U_f (res_f r₀)).mp hr₀_mem (α_cov i) g'_i hg'_le
          have hmem_fi := Ideal.mem_map_of_mem
            (X₀.presheaf.map (CategoryTheory.homOfLE hbo_symm).op).hom hmem_g'
          rw [hJ_res (α_cov i) hg'_le hbo_symm, h_res_comp, h_res_comp] at hmem_fi
          let res_fi := (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le f_i)).op).hom
          have hmem_map : res_fi (res_i r₀) ∈
              Ideal.map res_fi (Ideal.span {ℓ_cov (α_cov i) U_i (hg_cov i)}) := by
            rw [hJ_res (α_cov i) (hg_cov i) (X₀.basicOpen_le f_i), h_res_comp]
            exact hmem_fi
          obtain ⟨k_i, hki⟩ :=
            h_away_pow res_fi f_i (hAff_Ui.isLocalization_basicOpen f_i)
              (Ideal.span {ℓ_cov (α_cov i) U_i (hg_cov i)}) (res_i r₀) hmem_map
          refine ⟨k_i, ?_⟩
          rwa [map_mul, map_pow]
        choose k_fn hk_fn using hex_ki
        let K : ℕ := Finset.univ.sup k_fn
        have hfK_mem : f ^ K * r₀ ∈ ideal_fn U := by
          refine hmem_of_cov U α_cov g_cov hg_cov htop (f ^ K * r₀) fun i => ?_
          have hle : k_fn i ≤ K := Finset.le_sup (Finset.mem_univ i)
          have heq : f ^ K * r₀ = f ^ (K - k_fn i) * (f ^ k_fn i * r₀) := by
            rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hle]
          rw [heq, map_mul]
          exact Ideal.mul_mem_left _ _ (hk_fn i)
        have hu_tot : IsUnit (res_f (f ^ (e₀ + K))) :=
          @IsLocalization.map_units _ _ (Submonoid.powers f) _ _ _ hLoc_f
            ⟨f ^ (e₀ + K), e₀ + K, rfl⟩
        have hz_prod : z * res_f (f ^ (e₀ + K)) = res_f (f ^ K * r₀) := by
          rw [pow_add, map_mul, ← mul_assoc, hz_eq', ← map_mul, mul_comm]
        have hprod_in : z * res_f (f ^ (e₀ + K)) ∈ Ideal.map res_f (ideal_fn U) := by
          rw [hz_prod]
          exact Ideal.mem_map_of_mem res_f hfK_mem
        rcases hu_tot with ⟨u, hu⟩
        have hz_u : z = ↑u⁻¹ * (z * res_f (f ^ (e₀ + K))) := by
          rw [← hu, mul_comm z (u : _), ← mul_assoc, Units.inv_mul, one_mul]
        rw [hz_u]
        exact Ideal.mul_mem_left _ _ hprod_in

    have hsupport_iff : ∀ (U : X₀.affineOpens), ∀ x ∈ U.1,
        x ∈ S_supp ↔ x ∈ X₀.zeroLocus (ideal_fn U : Set ↑(X₀.presheaf.obj (Opposite.op U.1))) := by
      intro U x hxU
      obtain ⟨α₀, g₀, hx_g₀, hg₀_le⟩ := hex_pt_chart U x hxU
      let U_g₀ : X₀.affineOpens := X₀.affineBasicOpen g₀
      let res_g₀ := (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g₀)).op).hom
      let ℓ₀ := ℓ_cov α₀ (X₀.basicOpen g₀) hg₀_le
      have hmap_eq : Ideal.map res_g₀ (ideal_fn U) = Ideal.span {ℓ₀} :=
        (hmap_basicOpen U g₀).trans (hideal_on_chart U_g₀ α₀ hg₀_le)
      have hsupp_ℓ₀ : x ∈ S_supp ↔ x ∉ X₀.basicOpen ℓ₀ := by
        have hiff := hSupp α₀ (X₀.basicOpen g₀) hg₀_le x hx_g₀
        tauto
      rw [hsupp_ℓ₀, X₀.mem_zeroLocus_iff]
      constructor
      · intro hx_not f hf hx_f
        have hres_mem : res_g₀ f ∈ Ideal.span {ℓ₀} := by
          rw [← hmap_eq]
          exact Ideal.mem_map_of_mem res_g₀ hf
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hres_mem
        have hx_res : x ∈ X₀.basicOpen (res_g₀ f) := by
          rw [X₀.basicOpen_res]
          exact ⟨hx_g₀, hx_f⟩
        rw [hc, X₀.basicOpen_mul] at hx_res
        exact hx_not hx_res.1
      · intro hall
        have hℓ₀_mem : ℓ₀ ∈ Ideal.map res_g₀ (ideal_fn U) := by
          rw [hmap_eq]
          exact Ideal.mem_span_singleton_self ℓ₀
        refine Submodule.span_induction
          (p := fun y _ => x ∉ X₀.basicOpen y)
          (fun y hy => by
            rcases hy with ⟨f, hf, rfl⟩
            rw [X₀.basicOpen_res]
            exact fun h => hall f hf h.2)
          (by rw [AlgebraicGeometry.Scheme.basicOpen_zero]; exact fun h => h)
          (fun y₁ y₂ _ _ hy₁ hy₂ hy_add => by
            rcases X₀.basicOpen_add_le y₁ y₂ hy_add with h1 | h2
            · exact hy₁ h1
            · exact hy₂ h2)
          (fun c y _ hy hy_smul => by
            rw [smul_eq_mul, X₀.basicOpen_mul] at hy_smul
            exact hy hy_smul.2)
          hℓ₀_mem

    let I_sheaf : X₀.IdealSheafData :=
      AlgebraicGeometry.Scheme.IdealSheafData.mkOfMemSupportIff
        ideal_fn hmap_basicOpen S_supp hsupport_iff
    refine ⟨I_sheaf.subscheme, I_sheaf.subschemeι, inferInstance, ?_, ?_⟩
    · exact I_sheaf.range_subschemeι.trans
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_mkOfMemSupportIff
          ideal_fn hmap_basicOpen S_supp hsupport_iff)
    · intro U hAffU s_U hs_U
      let U_aff : X₀.affineOpens := ⟨U, hAffU⟩
      refine ⟨AlgebraicGeometry.Scheme.Hom.app_surjective I_sheaf.subschemeι U hAffU, ?_⟩
      calc
        RingHom.ker (I_sheaf.subschemeι.app U).hom
          = I_sheaf.subschemeι.ker.ideal U_aff :=
              (I_sheaf.subschemeι.ker_apply U_aff).symm
        _ = I_sheaf.ideal U_aff :=
              congrArg (fun J => J.ideal U_aff) I_sheaf.ker_subschemeι
        _ = ideal_fn U_aff :=
              AlgebraicGeometry.Scheme.IdealSheafData.mkOfMemSupportIff_ideal
                ideal_fn hmap_basicOpen S_supp hsupport_iff U_aff
        _ = Ideal.span {s_U} := hideal_gen U_aff s_U hs_U

  
  
  
  
  have h_s3_alg : ∀ (s : ℕ) (A B : Type u) [CommRing A] [CommRing B] [Algebra k B]
      (π : A →+* B) (_ : Function.Surjective π)
      (φ : MvPolynomial (Fin (s + 1 + d)) k →+* A) (_ : Function.Surjective φ)
      (_ : algebraMap k B = (π.comp φ).comp MvPolynomial.C)
      (q : Fin s → MvPolynomial (Fin (s + 1 + d)) k)
      (_ : RingHom.ker φ = Ideal.span (Set.range q))
      (f_lift : Fin 1 → MvPolynomial (Fin (s + 1 + d)) k)
      (_ : RingHom.ker π = Ideal.span {φ (f_lift 0)})
      (idx : Fin (s + 1) → Fin (s + 1 + d)) (_ : Function.Injective idx),
      IsUnit (Matrix.det (Matrix.of fun a b : Fin (s + 1) =>
        φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a)))) →
      Algebra.IsStandardSmoothOfRelativeDimension d k B := by
    intro s A B _ _ _ π hπ_surj φ hφ_surj hAlg q hker_φ f_lift hker_π idx hidx hJ
    let φ_B : MvPolynomial (Fin (s + 1 + d)) k →+* B := π.comp φ
    have haeval_eq :
        (MvPolynomial.aeval (R := k) (S₁ := B) (fun i => φ_B (MvPolynomial.X i))).toRingHom =
          φ_B := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        simp [φ_B, hAlg]
      · intro i
        simp [φ_B]
    have haeval_surj :
        Function.Surjective (MvPolynomial.aeval (R := k) (S₁ := B)
          (fun i => φ_B (MvPolynomial.X i))) := by
      intro b
      obtain ⟨P, hP⟩ := (hπ_surj.comp hφ_surj) b
      exact ⟨P, (RingHom.congr_fun haeval_eq P).trans hP⟩
    let G : Algebra.Generators k B (Fin (s + 1 + d)) :=
      Algebra.Generators.ofSurjective (fun i => φ_B (MvPolynomial.X i)) haeval_surj
    have halg_G : (algebraMap G.Ring B : MvPolynomial (Fin (s + 1 + d)) k →+* B) = φ_B :=
      haeval_eq
    let rel : Fin (s + 1) → G.Ring := Fin.addCases (motive := fun _ => G.Ring) q f_lift
    have hG_ker : Ideal.span (Set.range rel) = G.ker := by
      apply le_antisymm
      · refine Ideal.span_le.mpr ?_
        rintro _ ⟨a, rfl⟩
        change algebraMap G.Ring B (rel a) = 0
        rw [halg_G]
        refine Fin.addCases (motive := fun a => φ_B (rel a) = 0) (fun i => ?_) (fun j => ?_) a
        · have hmem : q i ∈ RingHom.ker φ := by
            rw [hker_φ]
            exact Ideal.subset_span ⟨i, rfl⟩
          simp [rel, φ_B, RingHom.mem_ker.mp hmem]
        · have hj : j = 0 := Subsingleton.elim j 0
          subst hj
          have hmem : φ (f_lift 0) ∈ RingHom.ker π := by
            rw [hker_π]
            exact Ideal.mem_span_singleton_self _
          simp [rel, φ_B, RingHom.mem_ker.mp hmem]
      · intro P hP
        have hP0 : π (φ P) = 0 := by
          have h1 : algebraMap G.Ring B P = 0 := hP
          rwa [halg_G] at h1
        have hφP : φ P ∈ Ideal.span {φ (f_lift 0)} := by
          rw [← hker_π]
          exact hP0
        obtain ⟨a₀, ha₀⟩ := Ideal.mem_span_singleton.mp hφP
        obtain ⟨R₀, rfl⟩ := hφ_surj a₀
        let Q : G.Ring := f_lift 0 * R₀
        have hQ_mem : Q ∈ Ideal.span (Set.range rel) := by
          refine Ideal.mul_mem_right R₀ _ (Ideal.subset_span ⟨Fin.natAdd s 0, ?_⟩)
          simp [rel]
        have hsub_ker : P - Q ∈ RingHom.ker φ := by
          rw [RingHom.mem_ker, map_sub, map_mul, ha₀, sub_self]
        rw [hker_φ] at hsub_ker
        have hq_sub : Set.range q ⊆ Set.range rel := by
          rintro _ ⟨i, rfl⟩
          exact ⟨Fin.castAdd 1 i, by simp [rel]⟩
        have hsub_mem : P - Q ∈ Ideal.span (Set.range rel) :=
          Ideal.span_mono hq_sub hsub_ker
        have hsum := add_mem hsub_mem hQ_mem
        rwa [sub_add_cancel] at hsum
    let P_pres : Algebra.Presentation k B (Fin (s + 1 + d)) (Fin (s + 1)) :=
      { G with
        relation := rel
        span_range_relation_eq_ker := hG_ker }
    let P_pre : Algebra.PreSubmersivePresentation k B (Fin (s + 1 + d)) (Fin (s + 1)) :=
      { P_pres with
        map := idx
        map_inj := hidx }
    have hJac_unit : IsUnit P_pre.jacobian := by
      rw [P_pre.jacobian_eq_jacobiMatrix_det, ← Matrix.det_transpose]
      have h1 : (algebraMap P_pre.Ring B : MvPolynomial (Fin (s + 1 + d)) k →+* B) = π.comp φ :=
        halg_G
      have hdet_eq : (algebraMap P_pre.Ring B) P_pre.jacobiMatrix.transpose.det =
          π ((Matrix.of fun a b : Fin (s + 1) =>
            φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a))).det) := by
        rw [h1, RingHom.comp_apply, RingHom.map_det φ]
        congr 2
        ext a b
        change φ (P_pre.jacobiMatrix.transpose a b) =
          φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a))
        rw [Matrix.transpose_apply, P_pre.jacobiMatrix_apply]
      rw [hdet_eq]
      exact hJ.map π
    let P_sub : Algebra.SubmersivePresentation k B (Fin (s + 1 + d)) (Fin (s + 1)) :=
      { P_pre with jacobian_isUnit := hJac_unit }
    have hdim : P_sub.dimension = d := by
      change Nat.card (Fin (s + 1 + d)) - Nat.card (Fin (s + 1)) = d
      rw [Nat.card_fin, Nat.card_fin]
      omega
    exact P_sub.isStandardSmoothOfRelativeDimension hdim

  have h_s3 : ∀ (s : ℕ) (A B : Type u) [CommRing A] [CommRing B]
      (π : A →+* B) (_ : Function.Surjective π)
      (φ : MvPolynomial (Fin (s + 1 + d)) k →+* A) (_ : Function.Surjective φ)
      (q : Fin s → MvPolynomial (Fin (s + 1 + d)) k)
      (_ : RingHom.ker φ = Ideal.span (Set.range q))
      (f_lift : Fin 1 → MvPolynomial (Fin (s + 1 + d)) k)
      (_ : RingHom.ker π = Ideal.span {φ (f_lift 0)})
      (idx : Fin (s + 1) → Fin (s + 1 + d)) (_ : Function.Injective idx),
      IsUnit (Matrix.det (Matrix.of fun a b : Fin (s + 1) =>
        φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a)))) →
      RingHom.IsStandardSmoothOfRelativeDimension d ((π.comp φ).comp MvPolynomial.C) := by
    intro s A B _ _ π hπ_surj φ hφ_surj q hker_φ f_lift hker_π idx hidx hJ
    let _ : Algebra k B := ((π.comp φ).comp MvPolynomial.C).toAlgebra
    exact @h_s3_alg s A B _ _ _ π hπ_surj φ hφ_surj rfl q hker_φ f_lift hker_π idx hidx hJ

  
  
  
  let P_N : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜_N
  let X₀ : AlgebraicGeometry.Scheme.{u} := X.left
  let f_X : X₀ ⟶ P_N := ι_X.left

  obtain ⟨hCov_X, hOverlap_all, hBasic_supp⟩ := h_s1 X₀ f_X

  let C_cov : Fin (N + 1) → X₀.Opens := fun α =>
    (TopologicalSpace.Opens.map f_X.base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α))
  have hX_deg : ∀ α : Fin (N + 1),
      (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1 :=
    fun α => MvPolynomial.isHomogeneous_X k α
  let ℓ_cov : ∀ (α : Fin (N + 1)) (W : X₀.Opens),
      W ≤ C_cov α → ↑(X₀.presheaf.obj (Opposite.op W)) :=
    fun α W hW =>
      (f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)) W hW).hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α)).hom
          (HomogeneousLocalization.Away.mk 𝒜_N (hX_deg α) 1 H₀ hH₀))
  let S_supp : Set X₀ := ι_X.left.base ⁻¹' weilProjHyperplaneSet k N H₀

  obtain ⟨Z, ι_Z, hCl_Z, hRange_Z, hChart_Z⟩ :=
    h_s2 X₀ (N + 1) C_cov hCov_X ℓ_cov S_supp
      (fun α W W' hW hWW' => by
        have hcomp := f_X.appLE_map hW (CategoryTheory.homOfLE hWW').op
        exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hcomp) _)
      (fun α β W hWα hWβ =>
        hOverlap_all (MvPolynomial.X α) (MvPolynomial.X β) (hX_deg α) (hX_deg β) W hWα hWβ)
      (fun α W hW x hx => hBasic_supp α (hX_deg α) W hW x hx)

  have _ : AlgebraicGeometry.IsClosedImmersion ι_Z := hCl_Z
  let Γ₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (ι_Z ≫ X.hom)
  let ι_Γ : Γ₀ ⟶ X := CategoryTheory.Over.homMk ι_Z rfl

  have hConj5 : ∀ (H : MvPolynomial (Fin (N + 1)) k) (hH : H ∈ 𝒜_N 1)
      (U : X.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U)
      (hU_sub : U ≤ (TopologicalSpace.Opens.map ι_X.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N H)),
      Function.Surjective (ι_Γ.left.app U).hom ∧
      RingHom.ker (ι_Γ.left.app U).hom =
        Ideal.span {(ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H) U hU_sub).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H).hom
            (HomogeneousLocalization.Away.mk 𝒜_N hH 1 H₀ hH₀))} := by
    intro H hH U hAffU hU_sub
    let s_U := (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H) U hU_sub).hom
      ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H).hom
        (HomogeneousLocalization.Away.mk 𝒜_N hH 1 H₀ hH₀))
    refine hChart_Z U hAffU s_U fun α g hg => ?_
    have hres_sU :
        (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g)).op).hom s_U =
          (f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H) (X₀.basicOpen g)
            ((X₀.basicOpen_le g).trans hU_sub)).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H).hom
              (HomogeneousLocalization.Away.mk 𝒜_N hH 1 H₀ hH₀)) := by
      have hcomp := f_X.appLE_map hU_sub (CategoryTheory.homOfLE (X₀.basicOpen_le g)).op
      exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hcomp) _
    rw [hres_sU]
    exact hOverlap_all H (MvPolynomial.X α) hH (hX_deg α) (X₀.basicOpen g)
      ((X₀.basicOpen_le g).trans hU_sub) hg

  refine ⟨Γ₀, ι_Γ, hCl_Z, AlgebraicGeometry.IsProper.instCompScheme ι_Z X.hom, ?_, hRange_Z, hConj5⟩

  
  obtain ⟨_, hSlice_pts⟩ := hSlice
  apply AlgebraicGeometry.SmoothOfRelativeDimension.mk
  intro y
  let x : X.left := ι_Γ.left.base y
  have hx_range : x ∈ Set.range ι_Z.base := ⟨y, rfl⟩
  rw [hRange_Z] at hx_range
  have hx_slice : ∀ j : Fin 1, ι_X.left.base x ∈ weilProjHyperplaneSet k N (![H₀] j) := by
    intro j
    have hj : j = 0 := Subsingleton.elim j 0
    subst hj
    exact hx_range
  obtain ⟨α₀, V, hAffV, hxV, _, hVα, hXα, hpos, s, φ, q, f_lift, idx,
    hφ_surj, hidx, hφ_hom, hker_φ, hf_eq, _, hJ⟩ := hSlice_pts x trivial hx_slice

  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let W_Γ : Γ₀.left.Opens := (TopologicalSpace.Opens.map ι_Γ.left.base).obj V
  have hAffW : AlgebraicGeometry.IsAffineOpen W_Γ := hAffV.preimage ι_Z
  have hyW : y ∈ W_Γ := hxV
  obtain ⟨hπ_surj, hker_π_sV⟩ := hConj5 (MvPolynomial.X α₀) hXα V hAffV hVα

  have hf0_eq : φ (f_lift 0) =
      (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α₀)) V hVα).hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α₀)).hom
          (HomogeneousLocalization.Away.mk 𝒜_N hXα 1 H₀ hH₀)) := by
    have h1 := hf_eq 0 hH₀
    rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom] at h1
    let nd : HomogeneousLocalization.NumDenSameDeg 𝒜_N
        (Submonoid.powers (MvPolynomial.X α₀)) :=
      ⟨1, ⟨![H₀] 0, hH₀⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩
    have hmk : HomogeneousLocalization.mk nd =
        HomogeneousLocalization.Away.mk 𝒜_N hXα 1 H₀ hH₀ := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.Away.val_mk]
      congr 1
      exact Subtype.ext (pow_one _).symm
    exact h1.trans (congrArg _ hmk)

  have hker_π : RingHom.ker (ι_Γ.left.app V).hom = Ideal.span {φ (f_lift 0)} := by
    rw [hker_π_sV, hf0_eq]

  have hStd : RingHom.IsStandardSmoothOfRelativeDimension d
      (((ι_Γ.left.app V).hom.comp φ).comp MvPolynomial.C) :=
    h_s3 s _ _ (ι_Γ.left.app V).hom hπ_surj φ hφ_surj q hker_φ f_lift hker_π idx hidx hJ

  have hV_top : V ≤ (TopologicalSpace.Opens.map X.hom.base).obj ⊤ := fun _ _ => trivial
  have hW_top : W_Γ ≤ (TopologicalSpace.Opens.map Γ₀.hom.base).obj ⊤ := fun _ _ => trivial
  have hW_V : W_Γ ≤ (TopologicalSpace.Opens.map ι_Z.base).obj V := le_rfl

  refine ⟨(⊤ : S_k.Opens), isAffineOpen_top S_k, W_Γ, hAffW, hyW, hW_top, ?_⟩

  
  let φ_cat : CommRingCat.of k ⟶ X.left.presheaf.obj (Opposite.op V) :=
    CommRingCat.ofHom (φ.comp MvPolynomial.C)
  have hsch_eq :
      V.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ_cat ≫ S_k.toSpecΓ =
      V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (X.hom.appLE ⊤ V hV_top) := by
    have hL : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
        AlgebraicGeometry.Spec.map φ_cat := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h1 : V.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ_cat = V.ι ≫ X.hom := by
      rw [← hL]
      exact hφ_hom
    rw [← CategoryTheory.Category.assoc, h1, ← X.hom.resLE_comp_ι hV_top,
      CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Opens.toSpecΓ_top,
      ← AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE]

  have happ_top := congrArg AlgebraicGeometry.Scheme.Hom.appTop hsch_eq
  simp only [AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc] at happ_top
  have _ : CategoryTheory.IsIso V.toSpecΓ.appTop := by
    rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop]
    infer_instance
  have happ_cancel :
      S_k.toSpecΓ.appTop ≫ (AlgebraicGeometry.Spec.map φ_cat).appTop =
      (AlgebraicGeometry.Spec.map (X.hom.appLE ⊤ V hV_top)).appTop :=
    (cancel_mono V.toSpecΓ.appTop).mp happ_top

  have hX_appLE :
      X.hom.appLE ⊤ V hV_top =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫ φ_cat := by
    have hnat1 := AlgebraicGeometry.Scheme.ΓSpecIso_naturality φ_cat
    have hnat2 := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (X.hom.appLE ⊤ V hV_top)
    rw [AlgebraicGeometry.Scheme.toSpecΓ_appTop] at happ_cancel
    have heq_iso :
        (AlgebraicGeometry.Scheme.ΓSpecIso (S_k.presheaf.obj (Opposite.op ⊤))).hom ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫ φ_cat =
        (AlgebraicGeometry.Scheme.ΓSpecIso (S_k.presheaf.obj (Opposite.op ⊤))).hom ≫
          X.hom.appLE ⊤ V hV_top := by
      calc
        (AlgebraicGeometry.Scheme.ΓSpecIso (S_k.presheaf.obj (Opposite.op ⊤))).hom ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫ φ_cat
          = (AlgebraicGeometry.Scheme.ΓSpecIso (S_k.presheaf.obj (Opposite.op ⊤))).hom ≫
              (AlgebraicGeometry.Spec.map φ_cat).appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (X.left.presheaf.obj (Opposite.op V))).hom := by
              rw [hnat1]
        _ = ((AlgebraicGeometry.Scheme.ΓSpecIso (S_k.presheaf.obj (Opposite.op ⊤))).hom ≫
              (AlgebraicGeometry.Spec.map φ_cat).appTop) ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (X.left.presheaf.obj (Opposite.op V))).hom := by
              rw [CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Spec.map (X.hom.appLE ⊤ V hV_top)).appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (X.left.presheaf.obj (Opposite.op V))).hom := by
              rw [happ_cancel]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (S_k.presheaf.obj (Opposite.op ⊤))).hom ≫
              X.hom.appLE ⊤ V hV_top := hnat2
    exact ((cancel_epi _).mp heq_iso).symm

  have hhom_eq :
      (Γ₀.hom.appLE ⊤ W_Γ hW_top).hom =
        (((ι_Γ.left.app V).hom.comp φ).comp MvPolynomial.C).comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom := by
    have hcomp : Γ₀.hom.appLE ⊤ W_Γ hW_top =
        X.hom.appLE ⊤ V hV_top ≫ ι_Z.appLE V W_Γ hW_V :=
      (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_Z X.hom ⊤ V W_Γ hV_top hW_V).symm
    have happ_eq : (ι_Z.appLE V W_Γ hW_V).hom = (ι_Γ.left.app V).hom :=
      congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appLE_eq_app ι_Z)
    ext c
    have h1 := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hcomp) c
    have h2 := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hX_appLE) c
    exact h1.trans ((congrArg (ι_Z.appLE V W_Γ hW_V).hom h2).trans
      (RingHom.congr_fun happ_eq _))
  rw [hhom_eq]
  exact (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso d).right
    (((ι_Γ.left.app V).hom.comp φ).comp MvPolynomial.C)
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv
    hStd

theorem weil_proj_basepointFree_triple_and_twoChart_line_finite (k : Type u) [Field k] :
    (∀ (N : ℕ)
        (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper X.hom]
        (ι_X : X ⟶ weilProjectiveSpaceOver k N),
      AlgebraicGeometry.IsClosedImmersion ι_X.left →
      ∀ (H₀ H₁ H₂ : MvPolynomial (Fin (N + 1)) k)
        (hH₀ : H₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
        (hH₁ : H₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
        (hH₂ : H₂ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1),
      (∀ x : X.left,
        ι_X.left.base x ∉ weilProjHyperplaneSet k N H₀ ∨
        ι_X.left.base x ∉ weilProjHyperplaneSet k N H₁ ∨
        ι_X.left.base x ∉ weilProjHyperplaneSet k N H₂) →
      let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
      let U₂ : X.left.Opens :=
        (TopologicalSpace.Opens.map ι_X.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂)
      let φ_k₂ : k →+* ↑(X.left.presheaf.obj (Opposite.op U₂)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          X.hom.appLE ⊤ U₂ le_top).hom
      let u₀ : ↑(X.left.presheaf.obj (Opposite.op U₂)) :=
        (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) U₂ (le_refl U₂)).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₂).hom
            (HomogeneousLocalization.Away.mk 𝒜_N hH₂ 1 H₀ hH₀))
      let u₁ : ↑(X.left.presheaf.obj (Opposite.op U₂)) :=
        (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) U₂ (le_refl U₂)).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₂).hom
            (HomogeneousLocalization.Away.mk 𝒜_N hH₂ 1 H₁ hH₁))
      letI : Algebra (MvPolynomial (Fin 2) k) ↑(X.left.presheaf.obj (Opposite.op U₂)) :=
        (MvPolynomial.eval₂Hom φ_k₂ ![u₀, u₁]).toAlgebra
      Module.Finite (MvPolynomial (Fin 2) k) ↑(X.left.presheaf.obj (Opposite.op U₂))) ∧
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper Y.hom]
        (W₀ W_inf : Y.left.Opens),
      AlgebraicGeometry.IsAffineOpen W₀ →
      AlgebraicGeometry.IsAffineOpen W_inf →
      W₀ ⊔ W_inf = ⊤ →
      ∀ (T : ↑(Y.left.presheaf.obj (Opposite.op W₀)))
        (S : ↑(Y.left.presheaf.obj (Opposite.op W_inf))),
      Y.left.basicOpen T = W₀ ⊓ W_inf →
      Y.left.basicOpen S = W₀ ⊓ W_inf →
      (Y.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀ ⊓ W_inf ≤ W₀)).op).hom T *
        (Y.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀ ⊓ W_inf ≤ W_inf)).op).hom S =
        1 →
      let φ_0 : k →+* ↑(Y.left.presheaf.obj (Opposite.op W₀)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Y.hom.appLE ⊤ W₀ le_top).hom
      let φ_inf : k →+* ↑(Y.left.presheaf.obj (Opposite.op W_inf)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Y.hom.appLE ⊤ W_inf le_top).hom
      (letI : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W₀)) := φ_0.toAlgebra
       letI : Algebra (Polynomial k) ↑(Y.left.presheaf.obj (Opposite.op W₀)) :=
         (Polynomial.aeval T).toRingHom.toAlgebra
       Module.Finite (Polynomial k) ↑(Y.left.presheaf.obj (Opposite.op W₀))) ∧
      (letI : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W_inf)) := φ_inf.toAlgebra
       letI : Algebra (Polynomial k) ↑(Y.left.presheaf.obj (Opposite.op W_inf)) :=
         (Polynomial.aeval S).toRingHom.toAlgebra
       Module.Finite (Polynomial k) ↑(Y.left.presheaf.obj (Opposite.op W_inf))) ∧
      (letI : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W₀)) := φ_0.toAlgebra
       letI : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W_inf)) := φ_inf.toAlgebra
       ∃ e : Localization.Away T ≃ₐ[k] Localization.Away S,
         e (algebraMap ↑(Y.left.presheaf.obj (Opposite.op W₀)) (Localization.Away T) T) *
           algebraMap ↑(Y.left.presheaf.obj (Opposite.op W_inf)) (Localization.Away S) S = 1)) :=
by
  classical
  
  
  
  have hToSpec_φ : ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (W : Z.left.Opens),
      W.toSpecΓ ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Z.hom.appLE ⊤ W le_top).hom)) =
      W.ι ≫ Z.hom := by
    intro Z W
    let top_k : (AlgebraicGeometry.Spec (CommRingCat.of k)).Opens := ⊤
    have hW_top : W ≤ Z.hom ⁻¹ᵁ top_k := le_top
    have h_app_eq : Z.hom.appLE ⊤ W le_top = Z.hom.appLE top_k W hW_top := rfl
    rw [CommRingCat.ofHom_hom, h_app_eq, AlgebraicGeometry.Spec.map_comp,
      ← CategoryTheory.Category.assoc]
    have h_res : Z.hom.resLE top_k W hW_top = Z.left.homOfLE hW_top ≫ (Z.hom ∣_ top_k) :=
      (AlgebraicGeometry.Scheme.Hom.map_resLE Z.hom (le_refl _) hW_top).symm.trans
        (congrArg (Z.left.homOfLE hW_top ≫ ·)
          (AlgebraicGeometry.Scheme.Hom.resLE_eq_morphismRestrict Z.hom))
    have h1 : W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (Z.hom.appLE top_k W hW_top) =
        Z.left.homOfLE hW_top ≫ (Z.hom ∣_ top_k) ≫ top_k.toSpecΓ := by
      rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE Z.hom top_k W hW_top,
        h_res, CategoryTheory.Category.assoc]
    have hSpec_inv : (AlgebraicGeometry.Spec (CommRingCat.of k)).toSpecΓ ≫
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
      rw [← AlgebraicGeometry.SpecMap_ΓSpecIso_hom, ← AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Iso.inv_hom_id, AlgebraicGeometry.Spec.map_id]
    have h2 : top_k.toSpecΓ ≫
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv =
        top_k.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_top, CategoryTheory.Category.assoc,
        hSpec_inv, CategoryTheory.Category.comp_id]
    rw [h1]
    simp only [CategoryTheory.Category.assoc]
    rw [h2, AlgebraicGeometry.morphismRestrict_ι, ← CategoryTheory.Category.assoc,
      AlgebraicGeometry.Scheme.homOfLE_ι]

  have hToSpec_away : ∀ (M : ℕ) (S : AlgebraicGeometry.Scheme.{u})
      (f : MvPolynomial (Fin (M + 1)) k)
      (hf : f ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1),
      let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
      letI : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
      ∀ (g_P : S ⟶ AlgebraicGeometry.Proj 𝒜_M)
        (W : S.Opens)
        (hW : W ≤ g_P ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜_M f),
        let D_f : (AlgebraicGeometry.Proj 𝒜_M).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_M f
        (W.toSpecΓ ≫ AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Proj.awayToSection 𝒜_M f ≫ g_P.appLE D_f W hW) =
          S.homOfLE hW ≫ (g_P ∣_ D_f) ≫
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M f hf zero_lt_one).hom) ∧
        ((W.toSpecΓ ≫ AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Proj.awayToSection 𝒜_M f ≫ g_P.appLE D_f W hW)) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_M f hf zero_lt_one =
          W.ι ≫ g_P) := by
    intro M S f hf 𝒜_M g_P W hW D_f
    let _ : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
    have h_res : g_P.resLE D_f W hW = S.homOfLE hW ≫ (g_P ∣_ D_f) :=
      (AlgebraicGeometry.Scheme.Hom.map_resLE g_P (le_refl _) hW).symm.trans
        (congrArg (S.homOfLE hW ≫ ·)
          (AlgebraicGeometry.Scheme.Hom.resLE_eq_morphismRestrict g_P))
    have h1 : W.toSpecΓ ≫ AlgebraicGeometry.Spec.map
        (AlgebraicGeometry.Proj.awayToSection 𝒜_M f ≫ g_P.appLE D_f W hW) =
        S.homOfLE hW ≫ (g_P ∣_ D_f) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M f hf zero_lt_one).hom := by
      rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE g_P D_f W hW,
        h_res]
      simp only [CategoryTheory.Category.assoc]
      congr 2
    refine ⟨h1, ?_⟩
    have h_iso_ι :
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M f hf zero_lt_one).hom ≫
          AlgebraicGeometry.Proj.awayι 𝒜_M f hf zero_lt_one = D_f.ι := by
      dsimp only [D_f]
      rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_M f hf zero_lt_one,
        CategoryTheory.Iso.hom_inv_id_assoc]
    rw [h1]
    simp only [CategoryTheory.Category.assoc]
    rw [h_iso_ι, AlgebraicGeometry.morphismRestrict_ι, ← CategoryTheory.Category.assoc,
      S.homOfLE_ι]

  
  
  
  have hs1 : ∀ (ν : ℕ)
      (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsProper Z.hom]
      (g : Z.left ⟶ (weilProjectiveSpaceOver k ν).left)
      (_ : g ≫ (weilProjectiveSpaceOver k ν).hom = Z.hom)
      (_ : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k) :=
             MvPolynomial.gradedAlgebra
           ∀ b : Fin (ν + 1),
             AlgebraicGeometry.IsAffineOpen
               ((TopologicalSpace.Opens.map g.base).obj
                 (AlgebraicGeometry.Proj.basicOpen
                   (MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k) (MvPolynomial.X b)))),
      let 𝒜_ν := MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k
      letI : GradedAlgebra 𝒜_ν := MvPolynomial.gradedAlgebra
      AlgebraicGeometry.IsFinite g ∧
      ∀ (a : Fin (ν + 1))
        (hXa : (MvPolynomial.X a : MvPolynomial (Fin (ν + 1)) k) ∈ 𝒜_ν 1)
        (W : Z.left.Opens)
        (_ : (TopologicalSpace.Opens.map g.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_ν (MvPolynomial.X a)) = W)
        (hW_le : W ≤ (TopologicalSpace.Opens.map g.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_ν (MvPolynomial.X a)))
        (ι : Fin ν → Fin (ν + 1))
        (_ : ∀ b : Fin (ν + 1), b = a ∨ ∃ i : Fin ν, ι i = b),
        let φ_W : k →+* ↑(Z.left.presheaf.obj (Opposite.op W)) :=
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            Z.hom.appLE ⊤ W le_top).hom
        let w : Fin ν → ↑(Z.left.presheaf.obj (Opposite.op W)) :=
          fun i =>
            (g.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_ν (MvPolynomial.X a)) W hW_le).hom
              ((AlgebraicGeometry.Proj.awayToSection 𝒜_ν (MvPolynomial.X a)).hom
                (HomogeneousLocalization.Away.mk 𝒜_ν hXa 1 (MvPolynomial.X (ι i))
                  (MvPolynomial.isHomogeneous_X k (ι i))))
        (MvPolynomial.eval₂Hom φ_W w).Finite := by
    intro ν Z _ g hg_hom hPreAff 𝒜_ν
    let _ : GradedAlgebra 𝒜_ν := MvPolynomial.gradedAlgebra
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜_ν 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : AlgebraicGeometry.IsClosedImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_ν 0)))) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _ hSurj0
    have hSep_P : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k ν).hom := by
      dsimp only [weilProjectiveSpaceOver, CategoryTheory.Over.mk_hom]
      infer_instance
    have hProp_comp : AlgebraicGeometry.IsProper (g ≫ (weilProjectiveSpaceOver k ν).hom) := by
      rw [hg_hom]
      infer_instance
    have hProp_g : AlgebraicGeometry.IsProper g :=
      @AlgebraicGeometry.IsProper.of_comp _ _ _ g (weilProjectiveSpaceOver k ν).hom
        hProp_comp hSep_P
    have hCov_ν : ∀ y : (weilProjectiveSpaceOver k ν).left,
        ∃ b : Fin (ν + 1),
          y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_ν (MvPolynomial.X b) := by
      intro y
      by_contra! hAll
      apply y.not_irrelevant_le
      rw [HomogeneousIdeal.irrelevant_le]
      intro d hd p hp
      have hp_hom : p.IsHomogeneous d := hp
      rw [MvPolynomial.as_sum p]
      apply y.asHomogeneousIdeal.toIdeal.sum_mem
      intro s hs
      have hs_deg : (∑ b : Fin (ν + 1), s b) = d := by
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using
          hp_hom (MvPolynomial.mem_support_iff.mp hs)
      have ⟨b₀, hb₀⟩ : ∃ b₀ : Fin (ν + 1), 1 ≤ s b₀ := by
        by_contra! hZero
        have hsum0 : (∑ b : Fin (ν + 1), s b) = 0 :=
          Finset.sum_eq_zero (fun b _ => Nat.lt_one_iff.mp (hZero b))
        omega
      have hXb₀ : (MvPolynomial.X b₀ : MvPolynomial (Fin (ν + 1)) k) ∈
          y.asHomogeneousIdeal.toIdeal := by
        have hnot := hAll b₀
        have hm := @AlgebraicGeometry.Proj.mem_basicOpen _ _ _ _ _ 𝒜_ν _
          (MvPolynomial.X b₀) y
        exact not_not.mp (mt hm.mpr hnot)
      rw [MvPolynomial.monomial_eq, Finsupp.prod_of_support_subset _ (Finset.subset_univ _)
        _ (fun _ _ => pow_zero _)]
      apply y.asHomogeneousIdeal.toIdeal.mul_mem_left
      obtain ⟨r, hr⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : s b₀ ≠ 0)
      rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ b₀), hr, pow_succ']
      exact y.asHomogeneousIdeal.toIdeal.mul_mem_right _
        (y.asHomogeneousIdeal.toIdeal.mul_mem_right _ hXb₀)
    have hAff_g : AlgebraicGeometry.IsAffineHom g := by
      apply AlgebraicGeometry.isAffineHom_of_forall_exists_isAffineOpen
      intro y
      obtain ⟨b, hyb⟩ := hCov_ν y
      exact ⟨AlgebraicGeometry.Proj.basicOpen 𝒜_ν (MvPolynomial.X b), hyb,
        AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_ν (MvPolynomial.X b)
          (MvPolynomial.isHomogeneous_X k b) zero_lt_one,
        hPreAff b⟩
    have hFin_g : AlgebraicGeometry.IsFinite g :=
      AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨hProp_g, hAff_g⟩
    refine ⟨hFin_g, ?_⟩
    intro a hXa W hW_eq hW_le ι hι_cov φ_W w
    let D_a : (AlgebraicGeometry.Proj 𝒜_ν).Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜_ν (MvPolynomial.X a)
    let g_P : Z.left ⟶ AlgebraicGeometry.Proj 𝒜_ν := g
    let z_a := HomogeneousLocalization.fromZeroRingHom 𝒜_ν
      (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (ν + 1)) k))
    let homog : MvPolynomial (Fin ν) k →+*
        HomogeneousLocalization.Away 𝒜_ν (MvPolynomial.X a) :=
      MvPolynomial.eval₂Hom (z_a.comp (algebraMap k ↥(𝒜_ν 0)))
        (fun i : Fin ν =>
          HomogeneousLocalization.Away.mk 𝒜_ν hXa 1 (MvPolynomial.X (ι i))
            (MvPolynomial.isHomogeneous_X k (ι i)))
    have h_homog_surj : Function.Surjective homog := by
      let τ : Fin (ν + 1) → MvPolynomial (Fin ν) k := fun b =>
        if h : b = a then 1
        else MvPolynomial.X (Classical.choose ((hι_cov b).resolve_left h))
      have hτ_val : ∀ b : Fin (ν + 1),
          (homog (τ b)).val =
            Localization.mk (MvPolynomial.X b)
              (⟨(MvPolynomial.X a) ^ 1, ⟨1, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (ν + 1)) k)) := by
        intro b
        dsimp only [τ]
        split_ifs with hba
        · subst hba
          rw [map_one, HomogeneousLocalization.val_one]
          have hself := Localization.mk_self
            (⟨(MvPolynomial.X b) ^ 1, ⟨1, rfl⟩⟩ :
              Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin (ν + 1)) k))
          simpa only [pow_one] using hself.symm
        · let ib := Classical.choose ((hι_cov b).resolve_left hba)
          have hi : ι ib = b := Classical.choose_spec ((hι_cov b).resolve_left hba)
          change (homog (MvPolynomial.X ib)).val = _
          dsimp only [homog]
          rw [MvPolynomial.eval₂Hom_X']
          change Localization.mk (MvPolynomial.X (ι ib))
              (⟨(MvPolynomial.X a) ^ 1, ⟨1, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (ν + 1)) k)) = _
          rw [hi]
      have hτ_pow : ∀ (b : Fin (ν + 1)) (e : ℕ),
          ((homog (τ b)) ^ e).val =
            Localization.mk ((MvPolynomial.X b) ^ e)
              (⟨(MvPolynomial.X a) ^ e, ⟨e, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (ν + 1)) k)) := by
        intro b e
        induction e with
        | zero =>
          rw [pow_zero, HomogeneousLocalization.val_one]
          exact (Localization.mk_one).symm
        | succ e ih =>
          rw [pow_succ, HomogeneousLocalization.val_mul, ih, hτ_val b, Localization.mk_mul]
          exact congrArg₂ Localization.mk (pow_succ _ _).symm
            (Subtype.ext (pow_add (MvPolynomial.X a) e 1).symm)
      have hτ_prod : ∀ (s : Finset (Fin (ν + 1))) (d : Fin (ν + 1) →₀ ℕ),
          (∏ b ∈ s, (homog (τ b)) ^ (d b)).val =
            Localization.mk (∏ b ∈ s, (MvPolynomial.X b : MvPolynomial (Fin (ν + 1)) k) ^ (d b))
              (⟨(MvPolynomial.X a) ^ (∑ b ∈ s, d b), ⟨∑ b ∈ s, d b, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (ν + 1)) k)) := by
        intro s d
        induction s using Finset.induction_on with
        | empty =>
          simp only [Finset.prod_empty, Finset.sum_empty, HomogeneousLocalization.val_one]
          exact (Localization.mk_one).symm
        | @insert b s hbs ih =>
          rw [Finset.prod_insert hbs, HomogeneousLocalization.val_mul, hτ_pow b (d b), ih,
            Localization.mk_mul, Finset.prod_insert hbs]
          refine congrArg₂ Localization.mk rfl (Subtype.ext ?_)
          change (MvPolynomial.X a) ^ (d b) * (MvPolynomial.X a) ^ (∑ x ∈ s, d x) =
            (MvPolynomial.X a) ^ (∑ x ∈ insert b s, d x)
          rw [Finset.sum_insert hbs, pow_add]
      have hC_val : ∀ c : k,
          (homog (MvPolynomial.C c)).val =
            Localization.mk (MvPolynomial.C c)
              (1 : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (ν + 1)) k)) := by
        intro c
        dsimp only [homog, z_a]
        rw [MvPolynomial.eval₂Hom_C]
        rfl
      intro z
      obtain ⟨n, P, hP, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_ν hXa z
      have hP' : P ∈ 𝒜_ν n := by simpa [nsmul_eq_mul, mul_one] using hP
      have hP_hom : P.IsHomogeneous n := hP'
      let liftP : MvPolynomial (Fin (ν + 1)) k →+* MvPolynomial (Fin ν) k :=
        MvPolynomial.eval₂Hom MvPolynomial.C τ
      refine ⟨liftP P, HomogeneousLocalization.val_injective _ ?_⟩
      rw [HomogeneousLocalization.Away.val_mk]
      have hmon : ∀ d ∈ P.support,
          (homog (liftP (MvPolynomial.monomial d (P.coeff d)))).val =
            Localization.mk (MvPolynomial.monomial d (P.coeff d))
              (⟨(MvPolynomial.X a) ^ n, ⟨n, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (ν + 1)) k)) := by
        intro d hd
        have hd_sum : (∑ b : Fin (ν + 1), d b) = n := by
          simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using
            hP_hom (MvPolynomial.mem_support_iff.mp hd)
        have hm_eq : MvPolynomial.monomial d (P.coeff d) =
            MvPolynomial.C (P.coeff d) *
              ∏ b : Fin (ν + 1), (MvPolynomial.X b : MvPolynomial (Fin (ν + 1)) k) ^ (d b) := by
          rw [MvPolynomial.monomial_eq,
            Finsupp.prod_of_support_subset _ (Finset.subset_univ _) _ (fun _ _ => pow_zero _)]
        have hlift_m : homog (liftP (MvPolynomial.monomial d (P.coeff d))) =
            homog (MvPolynomial.C (P.coeff d)) * ∏ b : Fin (ν + 1), (homog (τ b)) ^ (d b) := by
          rw [hm_eq, map_mul, map_mul, map_prod, map_prod]
          simp only [liftP, MvPolynomial.eval₂Hom_C, map_pow, MvPolynomial.eval₂Hom_X']
        rw [hlift_m, HomogeneousLocalization.val_mul, hC_val, hτ_prod Finset.univ d,
          Localization.mk_mul, ← hm_eq]
        refine congrArg₂ Localization.mk rfl (Subtype.ext ?_)
        change (1 : MvPolynomial (Fin (ν + 1)) k) * (MvPolynomial.X a) ^ (∑ b : Fin (ν + 1), d b) =
          (MvPolynomial.X a) ^ n
        rw [one_mul, hd_sum]
      have hsum_val : ∀ (S : Finset (Fin (ν + 1) →₀ ℕ)), S ⊆ P.support →
          (∑ d ∈ S, homog (liftP (MvPolynomial.monomial d (P.coeff d)))).val =
            Localization.mk (∑ d ∈ S, MvPolynomial.monomial d (P.coeff d))
              (⟨(MvPolynomial.X a) ^ n, ⟨n, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (ν + 1)) k)) := by
        intro S hS
        induction S using Finset.induction_on with
        | empty =>
          simp only [Finset.sum_empty, HomogeneousLocalization.val_zero]
          exact (Localization.mk_zero _).symm
        | @insert d S hdS ih =>
          have hd_in : d ∈ P.support := hS (Finset.mem_insert_self d S)
          have hS_sub : S ⊆ P.support := (Finset.subset_insert d S).trans hS
          rw [Finset.sum_insert hdS, HomogeneousLocalization.val_add, hmon d hd_in,
            ih hS_sub, Localization.add_mk_self, Finset.sum_insert hdS]
      have hP_sum := MvPolynomial.as_sum P
      conv_lhs => rw [hP_sum, map_sum, map_sum]
      rw [hsum_val P.support Finset.Subset.rfl, ← hP_sum]
    have h_homog_fin : homog.Finite := RingHom.Finite.of_surjective homog h_homog_surj
    have hAff_Da : AlgebraicGeometry.IsAffineOpen D_a :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_ν (MvPolynomial.X a) hXa zero_lt_one
    have hFin_app : (g_P.app D_a).hom.Finite :=
      ((AlgebraicGeometry.isFinite_iff g).mp hFin_g).2 D_a hAff_Da
    have hW_eq' : (TopologicalSpace.Opens.map g_P.base).obj D_a = W := hW_eq
    have h_appLE_eq : g_P.appLE D_a W hW_le =
        g_P.app D_a ≫ Z.left.presheaf.map (CategoryTheory.homOfLE hW_eq'.symm.le).op := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
    have h_res_surj : Function.Surjective
        (Z.left.presheaf.map (CategoryTheory.homOfLE hW_eq'.symm.le).op).hom := by
      intro x
      refine ⟨(Z.left.presheaf.map (CategoryTheory.homOfLE hW_eq'.le).op).hom x, ?_⟩
      have hcomp : Z.left.presheaf.map (CategoryTheory.homOfLE hW_eq'.le).op ≫
          Z.left.presheaf.map (CategoryTheory.homOfLE hW_eq'.symm.le).op =
          𝟙 (Z.left.presheaf.obj (Opposite.op W)) := by
        rw [← CategoryTheory.Functor.map_comp]
        have hid : (CategoryTheory.homOfLE hW_eq'.le).op ≫
            (CategoryTheory.homOfLE hW_eq'.symm.le).op = 𝟙 (Opposite.op W) :=
          Subsingleton.elim _ _
        rw [hid, CategoryTheory.Functor.map_id]
      exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hcomp) x
    have hFin_appLE : (g_P.appLE D_a W hW_le).hom.Finite := by
      have hcomp_hom : (g_P.appLE D_a W hW_le).hom =
          (Z.left.presheaf.map (CategoryTheory.homOfLE hW_eq'.symm.le).op).hom.comp
            (g_P.app D_a).hom := by
        rw [h_appLE_eq]
        rfl
      rw [hcomp_hom]
      exact RingHom.Finite.comp
        (RingHom.Finite.of_surjective _ h_res_surj) hFin_app
    have h_away_surj : Function.Surjective
        (AlgebraicGeometry.Proj.awayToSection 𝒜_ν (MvPolynomial.X a)).hom := by
      rw [← AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜_ν (MvPolynomial.X a) hXa zero_lt_one]
      intro x
      refine ⟨(AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_ν (MvPolynomial.X a) hXa zero_lt_one).inv.hom x, ?_⟩
      exact RingHom.congr_fun
        (congrArg CommRingCat.Hom.hom
          (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_ν (MvPolynomial.X a) hXa zero_lt_one).inv_hom_id) x
    let β_mor := AlgebraicGeometry.Proj.awayToSection 𝒜_ν (MvPolynomial.X a) ≫
      g_P.appLE D_a W hW_le
    have hβ_fin : β_mor.hom.Finite :=
      RingHom.Finite.comp hFin_appLE (RingHom.Finite.of_surjective _ h_away_surj)
    have h_comp_fin : (β_mor.hom.comp homog).Finite := RingHom.Finite.comp hβ_fin h_homog_fin
    have h_eq_eval : β_mor.hom.comp homog = MvPolynomial.eval₂Hom φ_W w := by
      have hAffW : AlgebraicGeometry.IsAffineOpen W := hW_eq' ▸ hPreAff a
      have : CategoryTheory.IsIso W.toSpecΓ := by
        rw [← hAffW.isoSpec_hom]
        infer_instance
      have hSpec_eq : W.toSpecΓ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((β_mor.hom.comp z_a).comp (algebraMap k ↥(𝒜_ν 0)))) =
          W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_W) := by
        rw [hToSpec_φ Z W]
        let p_ν : AlgebraicGeometry.Proj 𝒜_ν ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
          AlgebraicGeometry.Proj.toSpecZero 𝒜_ν ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_ν 0)))
        have hg_hom' : g_P ≫ p_ν = Z.hom := hg_hom
        have h_mor : CommRingCat.ofHom ((β_mor.hom.comp z_a).comp (algebraMap k ↥(𝒜_ν 0))) =
            CommRingCat.ofHom (algebraMap k ↥(𝒜_ν 0)) ≫ CommRingCat.ofHom z_a ≫ β_mor := rfl
        have h_away_zero :
            AlgebraicGeometry.Proj.awayι 𝒜_ν (MvPolynomial.X a) hXa zero_lt_one ≫ p_ν =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom z_a) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_ν 0))) := by
          dsimp only [p_ν]
          rw [← CategoryTheory.Category.assoc,
            AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_ν (MvPolynomial.X a) hXa zero_lt_one]
        have hlhs : W.toSpecΓ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((β_mor.hom.comp z_a).comp (algebraMap k ↥(𝒜_ν 0)))) =
            ((W.toSpecΓ ≫ AlgebraicGeometry.Spec.map β_mor) ≫
              AlgebraicGeometry.Proj.awayι 𝒜_ν (MvPolynomial.X a) hXa zero_lt_one) ≫ p_ν := by
          rw [h_mor, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
          simp only [CategoryTheory.Category.assoc]
          rw [← h_away_zero]
        rw [hlhs, (hToSpec_away ν Z.left (MvPolynomial.X a) hXa g_P W hW_le).2,
          CategoryTheory.Category.assoc, hg_hom']
      have hHom_eq := AlgebraicGeometry.Spec.map_inj.mp
        ((CategoryTheory.cancel_epi W.toSpecΓ).mp hSpec_eq)
      apply MvPolynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, homog, MvPolynomial.eval₂Hom_C]
        exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hHom_eq) c
      · intro i
        simp only [RingHom.comp_apply, homog, MvPolynomial.eval₂Hom_X', β_mor, w]
        rfl
    rwa [h_eq_eval] at h_comp_fin

  
  
  
  have hs2 : ∀ (N : ℕ)
      (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (ι_X : X ⟶ weilProjectiveSpaceOver k N)
      (_ : AlgebraicGeometry.IsClosedImmersion ι_X.left)
      (H₀ H₁ H₂ : MvPolynomial (Fin (N + 1)) k)
      (hH₀ : H₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
      (hH₁ : H₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
      (hH₂ : H₂ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
      (_ : ∀ x : X.left,
        ι_X.left.base x ∉ weilProjHyperplaneSet k N H₀ ∨
        ι_X.left.base x ∉ weilProjHyperplaneSet k N H₁ ∨
        ι_X.left.base x ∉ weilProjHyperplaneSet k N H₂),
      let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k
      letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
      letI : GradedAlgebra 𝒜_2 := MvPolynomial.gradedAlgebra
      let U₂ : X.left.Opens :=
        (TopologicalSpace.Opens.map ι_X.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂)
      ∃ (π : X.left ⟶ (weilProjectiveSpaceOver k 2).left),
        π ≫ (weilProjectiveSpaceOver k 2).hom = X.hom ∧
        (∀ b : Fin 3,
          (TopologicalSpace.Opens.map π.base).obj
              (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X b)) =
            (TopologicalSpace.Opens.map ι_X.left.base).obj
              (AlgebraicGeometry.Proj.basicOpen 𝒜_N (![H₀, H₁, H₂] b)) ∧
          AlgebraicGeometry.IsAffineOpen
            ((TopologicalSpace.Opens.map π.base).obj
              (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X b)))) ∧
        (∀ (hY2 : (MvPolynomial.X 2 : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1)
           (h_le : U₂ ≤ (TopologicalSpace.Opens.map π.base).obj
             (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X 2))),
          (π.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X 2)) U₂ h_le).hom
              ((AlgebraicGeometry.Proj.awayToSection 𝒜_2 (MvPolynomial.X 2)).hom
                (HomogeneousLocalization.Away.mk 𝒜_2 hY2 1 (MvPolynomial.X 0)
                  (MvPolynomial.isHomogeneous_X k 0))) =
            (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) U₂ (le_refl U₂)).hom
              ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₂).hom
                (HomogeneousLocalization.Away.mk 𝒜_N hH₂ 1 H₀ hH₀)) ∧
          (π.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X 2)) U₂ h_le).hom
              ((AlgebraicGeometry.Proj.awayToSection 𝒜_2 (MvPolynomial.X 2)).hom
                (HomogeneousLocalization.Away.mk 𝒜_2 hY2 1 (MvPolynomial.X 1)
                  (MvPolynomial.isHomogeneous_X k 1))) =
            (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) U₂ (le_refl U₂)).hom
              ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₂).hom
                (HomogeneousLocalization.Away.mk 𝒜_N hH₂ 1 H₁ hH₁))) := by
    intro N X ι_X hCl_X H₀ H₁ H₂ hH₀ hH₁ hH₂ hBPF 𝒜_N 𝒜_2 U₂
    let _ : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra 𝒜_2 := MvPolynomial.gradedAlgebra
    let Φ : Fin 3 → MvPolynomial (Fin (N + 1)) k := ![H₀, H₁, H₂]
    have hΦ_hom : ∀ a : Fin 3, Φ a ∈ 𝒜_N 1 := by
      intro a
      fin_cases a
      · exact hH₀
      · exact hH₁
      · exact hH₂
    let Φ₀ : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin (N + 1)) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C Φ
    have hdeg : ∀ (i : ℕ) (p : MvPolynomial (Fin 3) k), p ∈ 𝒜_2 i → Φ₀ p ∈ 𝒜_N i := by
      intro i p hp
      have hp' : p.IsHomogeneous i := hp
      have hev : (MvPolynomial.eval₂ MvPolynomial.C Φ p).IsHomogeneous (1 * i) :=
        hp'.eval₂ MvPolynomial.C Φ (fun r => MvPolynomial.isHomogeneous_C _ r) hΦ_hom
      rwa [Nat.one_mul] at hev
    let Φ_gr : 𝒜_2 →+*ᵍ 𝒜_N := { toRingHom := Φ₀, map_mem := @hdeg }
    let D_N : Fin 3 → (weilProjectiveSpaceOver k N).left.Opens :=
      fun a => AlgebraicGeometry.Proj.basicOpen 𝒜_N (Φ a)
    let D_2 : Fin 3 → (weilProjectiveSpaceOver k 2).left.Opens :=
      fun a => AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X a)
    let V : Fin 3 → X.left.Opens :=
      fun a => (TopologicalSpace.Opens.map ι_X.left.base).obj (D_N a)
    have hCovV : ∀ x : X.left, ∃ a : Fin 3, x ∈ V a := by
      intro x
      rcases hBPF x with h0 | h1 | h2
      · exact ⟨0, not_not.mp h0⟩
      · exact ⟨1, not_not.mp h1⟩
      · exact ⟨2, not_not.mp h2⟩
    have hCovV_top : (⨆ a : Fin 3, V a) = ⊤ := by
      ext x
      exact ⟨fun _ => trivial, fun _ => TopologicalSpace.Opens.mem_iSup.mpr (hCovV x)⟩
    have hYa : ∀ a : Fin 3, (MvPolynomial.X a : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1 :=
      fun a => MvPolynomial.isHomogeneous_X k a
    have hsub : ∀ a : Fin 3,
        Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin 3) k) ≤
          Submonoid.comap Φ₀ (Submonoid.powers (Φ a)) := by
      intro a
      apply Submonoid.powers_le.mpr
      change Φ₀ (MvPolynomial.X a) ∈ Submonoid.powers (Φ a)
      simp [Φ₀, Submonoid.mem_powers]
    let π_tilde : ∀ a : Fin 3,
        (D_N a : AlgebraicGeometry.Scheme.{u}) ⟶ (weilProjectiveSpaceOver k 2).left :=
      fun a =>
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (Φ a) (hΦ_hom a) zero_lt_one).hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub a))) ≫
        AlgebraicGeometry.Proj.awayι 𝒜_2 (MvPolynomial.X a) (hYa a) zero_lt_one
    let π_loc : ∀ a : Fin 3,
        (V a : AlgebraicGeometry.Scheme.{u}) ⟶ (weilProjectiveSpaceOver k 2).left :=
      fun a => (ι_X.left ∣_ D_N a) ≫ π_tilde a
    have hOverlap_V : ∀ a a' : Fin 3,
        X.left.homOfLE (inf_le_left : V a ⊓ V a' ≤ V a) ≫ π_loc a =
        X.left.homOfLE (inf_le_right : V a ⊓ V a' ≤ V a') ≫ π_loc a' := by
      intro a a'
      let F_aa' : MvPolynomial (Fin (N + 1)) k := Φ a * Φ a'
      let Y_aa' : MvPolynomial (Fin 3) k := MvPolynomial.X a * MvPolynomial.X a'
      have hY_aa' : Y_aa' ∈ 𝒜_2 2 := by
        simpa using SetLike.mul_mem_graded (hYa a) (hYa a')
      have hsub_aa' : Submonoid.powers Y_aa' ≤ Submonoid.comap Φ₀ (Submonoid.powers F_aa') := by
        apply Submonoid.powers_le.mpr
        change Φ₀ (MvPolynomial.X a * MvPolynomial.X a') ∈ Submonoid.powers (Φ a * Φ a')
        simp [Φ₀, Submonoid.mem_powers]
      let D_aa' : (weilProjectiveSpaceOver k N).left.Opens :=
        AlgebraicGeometry.Proj.basicOpen 𝒜_N F_aa'
      have hD_eq : D_aa' = D_N a ⊓ D_N a' :=
        AlgebraicGeometry.Proj.basicOpen_mul 𝒜_N (Φ a) (Φ a')
      have hle_D_L : D_aa' ≤ D_N a := hD_eq.le.trans inf_le_left
      have hle_D_R : D_aa' ≤ D_N a' := hD_eq.le.trans inf_le_right
      have hFactor : ∀ (b c : Fin 3) (hx : F_aa' = Φ b * Φ c)
          (hy : Y_aa' = MvPolynomial.X b * MvPolynomial.X c) (hle : D_aa' ≤ D_N b),
          (weilProjectiveSpaceOver k N).left.homOfLE hle ≫ π_tilde b =
            AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N F_aa' ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.map Φ_gr hsub_aa')) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_2 Y_aa' hY_aa' zero_lt_two := by
        intro b c hx hy hle
        have h_iso_hom :
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (Φ b) (hΦ_hom b) zero_lt_one).hom =
            AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (Φ b) :=
          AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_N (Φ b) (hΦ_hom b) zero_lt_one
        have h_toSpec :
            (weilProjectiveSpaceOver k N).left.homOfLE hle ≫
              AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (Φ b) =
            AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N F_aa' ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (HomogeneousLocalization.awayMap 𝒜_N (hΦ_hom c) hx)) :=
          (AlgebraicGeometry.Proj.basicOpenToSpec_SpecMap_awayMap 𝒜_N (hΦ_hom c) hx).symm
        have h_ring :
            (HomogeneousLocalization.awayMap 𝒜_N (hΦ_hom c) hx).comp
              (HomogeneousLocalization.map Φ_gr (hsub b)) =
            (HomogeneousLocalization.map Φ_gr hsub_aa').comp
              (HomogeneousLocalization.awayMap 𝒜_2 (hYa c) hy) := by
          ext z
          obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_2 (hYa b) z
          have h1 : HomogeneousLocalization.map Φ_gr (hsub b)
              (HomogeneousLocalization.Away.mk 𝒜_2 (hYa b) n p hp) =
            HomogeneousLocalization.Away.mk 𝒜_N (hΦ_hom b) n (Φ₀ p) (hdeg (n • 1) p hp) := by
            apply HomogeneousLocalization.val_injective _
            rw [HomogeneousLocalization.Away.val_mk]
            erw [HomogeneousLocalization.map_mk]
            simp [Φ_gr, Φ₀]
          simp only [RingHom.comp_apply, h1, HomogeneousLocalization.awayMap_mk]
          rw [HomogeneousLocalization.Away.val_mk]
          erw [HomogeneousLocalization.map_mk]
          simp [Φ_gr, Φ₀, hx, hy, mul_pow]
        have h_awayι :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.awayMap 𝒜_2 (hYa c) hy)) ≫
              AlgebraicGeometry.Proj.awayι 𝒜_2 (MvPolynomial.X b) (hYa b) zero_lt_one =
            AlgebraicGeometry.Proj.awayι 𝒜_2 Y_aa' hY_aa' zero_lt_two :=
          AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜_2 (hYa b) zero_lt_one (hYa c) hy
        let tail_b :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub b))) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_2 (MvPolynomial.X b) (hYa b) zero_lt_one
        have hs1 : (weilProjectiveSpaceOver k N).left.homOfLE hle ≫ π_tilde b =
            ((weilProjectiveSpaceOver k N).left.homOfLE hle ≫
              AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (Φ b)) ≫ tail_b := by
          dsimp only [π_tilde, tail_b]
          rw [← CategoryTheory.Category.assoc]
          exact congrArg (· ≫ tail_b)
            (congrArg ((weilProjectiveSpaceOver k N).left.homOfLE hle ≫ ·) h_iso_hom)
        have hs2' : ((weilProjectiveSpaceOver k N).left.homOfLE hle ≫
              AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (Φ b)) ≫ tail_b =
            (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N F_aa' ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (HomogeneousLocalization.awayMap 𝒜_N (hΦ_hom c) hx))) ≫ tail_b :=
          congrArg (· ≫ tail_b) h_toSpec
        have hs3 : (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N F_aa' ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (HomogeneousLocalization.awayMap 𝒜_N (hΦ_hom c) hx))) ≫ tail_b =
            AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N F_aa' ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (HomogeneousLocalization.map Φ_gr hsub_aa')) ≫
              AlgebraicGeometry.Proj.awayι 𝒜_2 Y_aa' hY_aa' zero_lt_two := by
          dsimp only [tail_b]
          rw [CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, h_ring,
            CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
            CategoryTheory.Category.assoc, h_awayι]
        exact (hs1.trans hs2').trans hs3
      have hTildeEq :
          (weilProjectiveSpaceOver k N).left.homOfLE hle_D_L ≫ π_tilde a =
          (weilProjectiveSpaceOver k N).left.homOfLE hle_D_R ≫ π_tilde a' :=
        (hFactor a a' rfl rfl hle_D_L).trans
          (hFactor a' a (mul_comm (Φ a) (Φ a')) (mul_comm (MvPolynomial.X a) (MvPolynomial.X a'))
            hle_D_R).symm
      have hV_le : V a ⊓ V a' ≤ (TopologicalSpace.Opens.map ι_X.left.base).obj D_aa' := by
        intro x hx
        change ι_X.left.base x ∈ D_aa'
        rw [hD_eq]
        exact hx
      let u_aa' : ((V a ⊓ V a' : X.left.Opens) : AlgebraicGeometry.Scheme.{u}) ⟶
          (D_aa' : AlgebraicGeometry.Scheme.{u}) :=
        X.left.homOfLE hV_le ≫ (ι_X.left ∣_ D_aa')
      have hPull : ∀ (b : Fin 3) (hle_V : V a ⊓ V a' ≤ V b) (hle_D : D_aa' ≤ D_N b),
          X.left.homOfLE hle_V ≫ (ι_X.left ∣_ D_N b) =
          u_aa' ≫ (weilProjectiveSpaceOver k N).left.homOfLE hle_D := by
        intro b hle_V hle_D
        rw [← CategoryTheory.cancel_mono (D_N b).ι]
        dsimp only [u_aa']
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          AlgebraicGeometry.Scheme.homOfLE_ι_assoc,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.morphismRestrict_ι,
          AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
      dsimp only [π_loc]
      rw [← CategoryTheory.Category.assoc, hPull a inf_le_left hle_D_L,
        CategoryTheory.Category.assoc, hTildeEq,
        ← CategoryTheory.Category.assoc, ← hPull a' inf_le_right hle_D_R,
        CategoryTheory.Category.assoc]
    let 𝒰 : X.left.OpenCover :=
      X.left.openCoverOfIsOpenCover V (TopologicalSpace.IsOpenCover.mk hCovV_top)
    have hGlueCond : ∀ (a a' : 𝒰.I₀),
        CategoryTheory.Limits.pullback.fst (𝒰.f a) (𝒰.f a') ≫ π_loc a =
        CategoryTheory.Limits.pullback.snd (𝒰.f a) (𝒰.f a') ≫ π_loc a' := by
      intro (a : Fin 3) (a' : Fin 3)
      let fst := CategoryTheory.Limits.pullback.fst (V a).ι (V a').ι
      let snd := CategoryTheory.Limits.pullback.snd (V a).ι (V a').ι
      have hcond : fst ≫ (V a).ι = snd ≫ (V a').ι := CategoryTheory.Limits.pullback.condition
      have hrange : Set.range (fst ≫ (V a).ι).base ⊆ Set.range (V a ⊓ V a').ι.base := by
        rw [(V a ⊓ V a').range_ι]
        rintro _ ⟨z, rfl⟩
        refine ⟨?_, ?_⟩
        · have h1 : (V a).ι.base (fst.base z) = (fst.base z).1 :=
            AlgebraicGeometry.Scheme.Opens.ι_apply (V a) (fst.base z)
          change (V a).ι.base (fst.base z) ∈ V a
          rw [h1]
          exact (fst.base z).2
        · rw [hcond]
          have h2 : (V a').ι.base (snd.base z) = (snd.base z).1 :=
            AlgebraicGeometry.Scheme.Opens.ι_apply (V a') (snd.base z)
          change (V a').ι.base (snd.base z) ∈ V a'
          rw [h2]
          exact (snd.base z).2
      let p_inf : CategoryTheory.Limits.pullback (V a).ι (V a').ι ⟶
          ((V a ⊓ V a' : X.left.Opens) : AlgebraicGeometry.Scheme.{u}) :=
        AlgebraicGeometry.IsOpenImmersion.lift (V a ⊓ V a').ι (fst ≫ (V a).ι) hrange
      have hp_fac : p_inf ≫ (V a ⊓ V a').ι = fst ≫ (V a).ι :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (V a ⊓ V a').ι (fst ≫ (V a).ι) hrange
      have hp_fst : fst = p_inf ≫ X.left.homOfLE (inf_le_left : V a ⊓ V a' ≤ V a) := by
        rw [← CategoryTheory.cancel_mono (V a).ι, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.homOfLE_ι, hp_fac]
      have hp_snd : snd = p_inf ≫ X.left.homOfLE (inf_le_right : V a ⊓ V a' ≤ V a') := by
        rw [← CategoryTheory.cancel_mono (V a').ι, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.homOfLE_ι, hp_fac, hcond]
      change fst ≫ π_loc a = snd ≫ π_loc a'
      rw [hp_fst, hp_snd, CategoryTheory.Category.assoc, hOverlap_V a a',
        CategoryTheory.Category.assoc]
    let π : X.left ⟶ (weilProjectiveSpaceOver k 2).left := 𝒰.glueMorphisms π_loc hGlueCond
    have hChart_V : ∀ a : Fin 3, (V a).ι ≫ π = π_loc a :=
      fun a => 𝒰.ι_glueMorphisms π_loc hGlueCond a
    have hπ_w : π ≫ (weilProjectiveSpaceOver k 2).hom = X.hom := by
      apply 𝒰.hom_ext
      intro (a : Fin 3)
      change (V a).ι ≫ π ≫ (weilProjectiveSpaceOver k 2).hom = (V a).ι ≫ X.hom
      rw [← CategoryTheory.Category.assoc, hChart_V a]
      let z_2 := HomogeneousLocalization.fromZeroRingHom 𝒜_2 (Submonoid.powers (MvPolynomial.X a))
      let z_N := HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (Φ a))
      have hZeroRing :
          ((HomogeneousLocalization.map Φ_gr (hsub a)).comp z_2).comp (algebraMap k ↥(𝒜_2 0)) =
          z_N.comp (algebraMap k ↥(𝒜_N 0)) := by
        ext r
        simp only [RingHom.comp_apply, z_2, z_N]
        erw [HomogeneousLocalization.map_mk]
        have hr : (algebraMap k ↥(𝒜_2 0) r : MvPolynomial (Fin 3) k) = MvPolynomial.C r := rfl
        have hr' : (algebraMap k ↥(𝒜_N 0) r : MvPolynomial (Fin (N + 1)) k) = MvPolynomial.C r := rfl
        change Localization.mk (Φ₀ ((algebraMap k ↥(𝒜_2 0) r : MvPolynomial (Fin 3) k)))
            ⟨Φ₀ 1, _⟩ =
          Localization.mk ((algebraMap k ↥(𝒜_N 0) r : MvPolynomial (Fin (N + 1)) k)) ⟨1, _⟩
        have hnum : Φ₀ ((algebraMap k ↥(𝒜_2 0) r : MvPolynomial (Fin 3) k)) =
            ((algebraMap k ↥(𝒜_N 0) r : MvPolynomial (Fin (N + 1)) k)) := by
          rw [hr, hr']
          simp [Φ₀]
        have hden : (⟨Φ₀ 1, (hsub a) (Submonoid.one_mem _)⟩ : Submonoid.powers (Φ a)) =
            ⟨1, Submonoid.one_mem _⟩ := Subtype.ext (map_one Φ₀)
        rw [hnum, hden]
      have hTilde_hom :
          π_tilde a ≫ (weilProjectiveSpaceOver k 2).hom =
          (D_N a).ι ≫ (weilProjectiveSpaceOver k N).hom := by
        have hDN_ι : (D_N a).ι =
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (Φ a) (hΦ_hom a) zero_lt_one).hom ≫
            AlgebraicGeometry.Proj.awayι 𝒜_N (Φ a) (hΦ_hom a) zero_lt_one := by
          dsimp only [D_N]
          rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_N (Φ a) (hΦ_hom a) zero_lt_one,
            CategoryTheory.Iso.hom_inv_id_assoc]
          rfl
        have h_away_2 :
            AlgebraicGeometry.Proj.awayι 𝒜_2 (MvPolynomial.X a) (hYa a) zero_lt_one ≫
              (weilProjectiveSpaceOver k 2).hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_2.comp (algebraMap k ↥(𝒜_2 0)))) := by
          change AlgebraicGeometry.Proj.awayι 𝒜_2 (MvPolynomial.X a) (hYa a) zero_lt_one ≫
              AlgebraicGeometry.Proj.toSpecZero 𝒜_2 ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_2 0))) = _
          rw [← CategoryTheory.Category.assoc,
            AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_2 (MvPolynomial.X a) (hYa a) zero_lt_one,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h_away_N :
            AlgebraicGeometry.Proj.awayι 𝒜_N (Φ a) (hΦ_hom a) zero_lt_one ≫
              (weilProjectiveSpaceOver k N).hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) := by
          change AlgebraicGeometry.Proj.awayι 𝒜_N (Φ a) (hΦ_hom a) zero_lt_one ≫
              AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0))) = _
          rw [← CategoryTheory.Category.assoc,
            AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_N (Φ a) (hΦ_hom a) zero_lt_one,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h_mid :
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub a))) ≫
              AlgebraicGeometry.Proj.awayι 𝒜_2 (MvPolynomial.X a) (hYa a) zero_lt_one) ≫
              (weilProjectiveSpaceOver k 2).hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) := by
          have hm1 := CategoryTheory.Category.assoc
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub a))))
            (AlgebraicGeometry.Proj.awayι 𝒜_2 (MvPolynomial.X a) (hYa a) zero_lt_one)
            (weilProjectiveSpaceOver k 2).hom
          have hm2 := congrArg
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub a))) ≫ ·)
            h_away_2
          have hm3 :
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub a))) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_2.comp (algebraMap k ↥(𝒜_2 0)))) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
              ← RingHom.comp_assoc, hZeroRing]
          exact (hm1.trans hm2).trans hm3
        have ht1 : π_tilde a ≫ (weilProjectiveSpaceOver k 2).hom =
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (Φ a) (hΦ_hom a) zero_lt_one).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) :=
          (CategoryTheory.Category.assoc _ _ _).trans
            (congrArg ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (Φ a) (hΦ_hom a) zero_lt_one).hom ≫ ·) h_mid)
        have ht2 : (D_N a).ι ≫ (weilProjectiveSpaceOver k N).hom =
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (Φ a) (hΦ_hom a) zero_lt_one).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) :=
          (congrArg (· ≫ (weilProjectiveSpaceOver k N).hom) hDN_ι).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              (congrArg ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (Φ a) (hΦ_hom a) zero_lt_one).hom ≫ ·) h_away_N))
        exact ht1.trans ht2.symm
      dsimp only [π_loc]
      rw [CategoryTheory.Category.assoc, hTilde_hom, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc,
        CategoryTheory.Over.w ι_X]
    have hPre_π : ∀ b : Fin 3,
        (TopologicalSpace.Opens.map π.base).obj (D_2 b) = V b ∧
