          MvPolynomial.monomial (d_exp - Finsupp.single α₀ 1) (q.coeff d_exp) *
            MvPolynomial.X α₀ := by
        rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, mul_one, ← hd_eq]
      rw [hmon]
      exact Ideal.mul_mem_left _ _ (hp α₀)
    · 
      have h_le : ∀ (H_a H_b : MvPolynomial (Fin (N + 1)) k)
