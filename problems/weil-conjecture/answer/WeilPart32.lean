              ((∀ r : Fin (d + 1), ∑ μ : Fin (M + 1), ev_z (J_V r μ) * c μ = 0) ∧
                Matrix.det (Matrix.of fun r₁ r₂ : Fin d =>
                  ∑ μ : Fin (M + 1), c μ * ev_z (D_V r₂ (D_V r₁ (X_i μ)))) ≠ 0)) := by
    intro i _
    obtain ⟨hSurj, hSpec, hKer, _, hDet0, _, _, _, hLin, _⟩ := hCharts_top i
    obtain ⟨ψ_V, D_V, hDom, hFT, hTr, _, _, _, _, hDerU, hHyp, hMax, hJet, hOdp⟩ :=
      weil_algClosed_smooth_chart_jet1_and_etale_odp_bridge k m M (s i) Z_bar hInt ι_bar
        (α₀ i) (V i) (hAffV i) (hVα i) (φ i) (q i) (x_coord i) (Ψ i) (v i)
        hSurj hSpec hKer hDet0 hLin (hΨ i) (hSchur i)
    exact ⟨ψ_V, D_V, hDom, hFT, hTr, hDerU, hHyp, hMax, hJet, hOdp⟩

  let A_ch : Fin m_charts → Type u := fun i => ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))
  let alg_ch : ∀ i : Fin m_charts, Algebra k (A_ch i) := fun i => ((φ i).comp MvPolynomial.C).toAlgebra
  let X_ch : ∀ i : Fin m_charts, Fin (M + 1) → A_ch i :=
    fun i => (α₀ i).insertNth 1 (x_coord i)
  let ψ_ch : ∀ (i : Fin m_charts) [Nonempty (V i)], MvPolynomial (Fin d) k →+* A_ch i :=
    fun i _ => Classical.choose (hGlobalBridge i)
  let D_ch : ∀ (i : Fin m_charts) [Nonempty (V i)],
      letI : Algebra k (A_ch i) := alg_ch i
      Fin d → Derivation k (A_ch i) (A_ch i) :=
    fun i _ => Classical.choose (Classical.choose_spec (hGlobalBridge i))
  let J_ch : ∀ (i : Fin m_charts) [Nonempty (V i)], Matrix (Fin (d + 1)) (Fin (M + 1)) (A_ch i) :=
    fun i _ =>
      letI : Algebra k (A_ch i) := alg_ch i
      Matrix.of (Fin.cases (X_ch i) (fun r μ => D_ch i r (X_ch i μ)))
  have hSpec_ch : ∀ (i : Fin m_charts) [Nonempty (V i)],
      letI : Algebra k (A_ch i) := alg_ch i
      IsDomain (A_ch i) ∧
      Algebra.FiniteType k (A_ch i) ∧
      Algebra.trdeg k (A_ch i) ≤ (d : Cardinal.{u}) ∧
      (∀ (E : Type u) [Field E] (σ : A_ch i →+* E),
        letI : Algebra k E := (σ.comp (algebraMap k (A_ch i))).toAlgebra
        ∀ (D : Derivation k E E) (a : A_ch i),
          D (σ a) = ∑ r : Fin d, σ (D_ch i r a) * D (σ (ψ_ch i (MvPolynomial.X r)))) ∧
      (∀ (x : ↥(V i)) (c : Fin (M + 1) → k),
        ι_bar.left.base x.1 ∈ weilProjHyperplaneSet k M (L_lin c) ↔
          (∑ μ : Fin (M + 1), algebraMap k (A_ch i) (c μ) * X_ch i μ) ∈
            ((hAffV i).primeIdealOf x).asIdeal) ∧
      ((∀ (𝔪 : Ideal (A_ch i)) (h𝔪 : 𝔪.IsMaximal),
          ∃ ev_𝔪 : A_ch i →ₐ[k] k,
            RingHom.ker ev_𝔪.toRingHom = 𝔪 ∧
            (hAffV i).fromSpec.base ⟨𝔪, h𝔪.isPrime⟩ ∈ V i ∧
            IsClosed ({(hAffV i).fromSpec.base ⟨𝔪, h𝔪.isPrime⟩} : Set Z_bar.left) ∧
            ∀ hz : (hAffV i).fromSpec.base ⟨𝔪, h𝔪.isPrime⟩ ∈ V i,
              ((hAffV i).primeIdealOf ⟨(hAffV i).fromSpec.base ⟨𝔪, h𝔪.isPrime⟩, hz⟩).asIdeal = 𝔪) ∧
        (∀ (z : Z_bar.left) (hz : z ∈ V i), IsClosed ({z} : Set Z_bar.left) →
          (((hAffV i).primeIdealOf ⟨z, hz⟩).asIdeal).IsMaximal ∧
          (hAffV i).fromSpec.base ((hAffV i).primeIdealOf ⟨z, hz⟩) = z)) ∧
      (∀ (z : Z_bar.left) (hz : z ∈ V i), IsClosed ({z} : Set Z_bar.left) →
        ∀ (ev_z : A_ch i →ₐ[k] k),
          RingHom.ker ev_z.toRingHom = ((hAffV i).primeIdealOf ⟨z, hz⟩).asIdeal →
          (∃ ψ_z : MvPolynomial (Fin d) k →+* A_ch i,
            AlgebraicGeometry.Etale ((V i).toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z)) ∧
            ((V i).toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = (V i).ι ≫ Z_bar.hom) ∧
            (∀ r : Fin d, ψ_z (MvPolynomial.X r) ∈ ((hAffV i).primeIdealOf ⟨z, hz⟩).asIdeal) ∧
            (∀ (c : Fin (M + 1) → k) (hLc : L_lin c ∈ 𝒜_M 1)
              (hXα : (MvPolynomial.X (α₀ i) : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
              (c₀ : k) (w : Fin d → k),
              let p_z := ((hAffV i).primeIdealOf ⟨z, hz⟩).asIdeal
              let ℓ_z := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M
                (MvPolynomial.X (α₀ i)) hXα zero_lt_one).hom ≫
                ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X (α₀ i)))
                  (V i) (hVα i)).hom
                (HomogeneousLocalization.mk ⟨1, ⟨L_lin c, hLc⟩,
                  ⟨MvPolynomial.X (α₀ i), hXα⟩, ⟨1, pow_one _⟩⟩)
              algebraMap (A_ch i) (Localization.AtPrime p_z)
                (ℓ_z - ψ_z (MvPolynomial.C c₀ +
                  ∑ r : Fin d, MvPolynomial.C (w r) * MvPolynomial.X r)) ∈
                (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 2 ↔
                (∑ μ : Fin (M + 1), ev_z (J_ch i 0 μ) * c μ = c₀ ∧
