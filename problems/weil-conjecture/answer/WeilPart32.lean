  have hTF_BΓ0 :
      letI : Algebra k ↑B_Γ0 := φ_Γ0.toAlgebra
      letI : Algebra (Polynomial k) ↑B_Γ0 := (Polynomial.aeval T_Γ).toRingHom.toAlgebra
      Module.IsTorsionFree (Polynomial k) ↑B_Γ0 := by
    let _ : Algebra k ↑B_Γ0 := φ_Γ0.toAlgebra
    let _ : Algebra k ↑B_Γ_inf := φ_Γ_inf.toAlgebra
    exact (weil_algClosed_smooth_curve_components_and_torsionFree_quotient k).2.1
      (↑B_Γ0) (↑B_Γ_inf) T_Γ S_Γ hT_nzd hTF_BΓinf hAway_iso_Γ

  obtain ⟨hTrans_Fin_BΓ2, hTrans_TF_BΓ2⟩ :=
    hPoly_trans φ_k₂ φ_W₂ (ι_Γ.left.app U₂_c).hom hSurj_Γ₂ hΓ_k₂
      (Ideal.span {u₀}) hKer_Γ₂ u₁ u₁₂ hΓ_u₁
  have hFin_BΓ2 := hTrans_Fin_BΓ2 hFin_W₂
  have hTF_BΓ2 := hTrans_TF_BΓ2 hTF_W₂

  have hNontriv_BΓ2 : Nontrivial
      ((↑(Z_bar.left.presheaf.obj (Opposite.op U₂_c)) ⧸ Ideal.span {u₀}) ⧸
        Ideal.span {Ideal.Quotient.mk (Ideal.span {u₀}) u₁}) := by
    have hYZ_H₀_ge1 : ((1 : ℕ) : WithBot ℕ∞) ≤
        topologicalKrullDim ↥(Y_Z ∩ weilProjHyperplaneSet k N H₀) :=
      ((weil_algClosed_proj_hyperplane_krullDim_bounds_and_ratPoint k N).1
        Y_Z hYZ_cl 2 (by decide) hDimYZ.symm.le H₀ hH₀ hH₀_ne).2
    have hYZ_H₀₁_ne :=
      ((weil_algClosed_proj_hyperplane_krullDim_bounds_and_ratPoint k N).1
        (Y_Z ∩ weilProjHyperplaneSet k N H₀) (hYZ_cl.inter (hHyp_cl H₀))
        1 (le_refl 1) hYZ_H₀_ge1 H₁ hH₁ hH₁_ne).1
    rcases hYZ_H₀₁_ne with ⟨_, ⟨⟨w, rfl⟩, hw₀⟩, hw₁⟩
    have hw₂ : w ∈ U₂_c := by
      change ι₀.left.base w ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂
      by_contra hnot
      exact hEmpty_YZ_H₀₁₂.false ⟨ι₀.left.base w, ⟨⟨⟨w, rfl⟩, hw₀⟩, hw₁⟩, hnot⟩
    let 𝔮 := (hAff₂.primeIdealOf ⟨w, hw₂⟩).asIdeal
    have h𝔮_prime : 𝔮.IsPrime := (hAff₂.primeIdealOf ⟨w, hw₂⟩).isPrime
    have hu₀_q : u₀ ∈ 𝔮 := (hPrime_u₀ hAff₂ w hw₂).mpr hw₀
    have hu₁_q : u₁ ∈ 𝔮 := (hPrime_u₁ hAff₂ w hw₂).mpr hw₁
    let π₁ := Ideal.Quotient.lift (Ideal.span {u₀}) (Ideal.Quotient.mk 𝔮) fun a ha =>
      Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hu₀_q) ha)
