      · obtain ⟨k₀, hk₀⟩ := Nat.exists_eq_succ_of_ne_zero hd0
        rw [hk₀, pow_succ]
        have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) ∈
