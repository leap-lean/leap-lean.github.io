          (CommRingCat.ofHom ψ_sm) e_Y.toCommRingCatIso.hom).mpr hSm_quot
      have hEqInv : (Y₂.hom.appLE ⊤ V_Y le_top).hom.comp
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom =
          (e_Y.toCommRingCatIso.hom).hom.comp (CommRingCat.ofHom ψ_sm).hom := by
        ext c
        exact hY_hom c
      refine (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_left_isIso
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
        (Y₂.hom.appLE ⊤ V_Y le_top)).mp ?_
      rw [hEqInv]
      exact h1
    · have hOnAxis : ∀ r₀ : Fin 3, ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L r₀) :=
        fun r₀ => Classical.not_not.mp fun hnot => hOff ⟨r₀, hnot⟩
      have hm : 1 ≤ m := by
        rcases Nat.eq_zero_or_pos m with rfl | hpos_m
        · exfalso
          obtain ⟨r₀, hr₀⟩ := hNet_m0 rfl z
          exact hr₀ (hOnAxis r₀)
        · exact hpos_m
      have hgy_cov : g₂.left.base y ∈ (⨆ β : Fin 3, D_P β) := by
        rw [hCov_P']
        trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hgy_cov
      obtain ⟨β, hy_β⟩ := hgy_cov
      obtain ⟨α₀, V_Z, hAffVZ, hzV, _, hVα, hXα, hpos, s, φ, q, f_lift, idx,
          hφ_surj, hidx_inj, hφ_str, hφ_ker, hf_lift, hdet_q, hdet_full⟩ :=
        (hNet_pos hm).2 z trivial hOnAxis
      obtain ⟨_, _, hChart_β⟩ := hCharts β
      obtain ⟨hAffVY, e_Y, _, _, _, _, hY_hom, _⟩ := hChart_β α₀ hXα V_Z hAffVZ hVα
      let V_Y : Y₂.left.Opens :=
        (TopologicalSpace.Opens.map π_Y.left.base).obj V_Z ⊓
          (TopologicalSpace.Opens.map g₂.left.base).obj (D_P β)
      let A := ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z))
      let κ_Z : k →+* A :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Z_bar.hom.appLE ⊤ V_Z le_top).hom
      let ℓ_r : Fin 3 → A := fun r =>
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α₀) hXα zero_lt_one).hom ≫
          ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀)) V_Z hVα).hom
          (HomogeneousLocalization.mk ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩)
      have hφ_C : φ.comp MvPolynomial.C = κ_Z := by
        have h_iso_str :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp MvPolynomial.C)) =
              hAffVZ.fromSpec ≫ Z_bar.hom := by
          have h1 := congrArg (fun m => hAffVZ.isoSpec.inv ≫ m) hφ_str
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            ← hAffVZ.isoSpec_hom, ← CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc, hAffVZ.isoSpec.inv_hom_id,
            CategoryTheory.Category.id_comp] at h1
          exact h1
        have h_from_le : (⊤ : (AlgebraicGeometry.Spec (Z_bar.left.presheaf.obj (Opposite.op V_Z))).Opens) ≤
            (TopologicalSpace.Opens.map hAffVZ.fromSpec.base).obj V_Z := by
          intro p _
          exact (hAffVZ.isoSpec.inv.base p).2
        have h_app_comp :
            Z_bar.hom.appLE ⊤ V_Z le_top ≫ hAffVZ.fromSpec.appLE V_Z ⊤ h_from_le =
              (hAffVZ.fromSpec ≫ Z_bar.hom).appTop :=
          AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
            hAffVZ.fromSpec Z_bar.hom ⊤ V_Z ⊤ le_top h_from_le
        have h_from_app : hAffVZ.fromSpec.appLE V_Z ⊤ h_from_le =
            (AlgebraicGeometry.Scheme.ΓSpecIso (Z_bar.left.presheaf.obj (Opposite.op V_Z))).inv := by
          have happ_map : hAffVZ.fromSpec.app V_Z ≫
              (AlgebraicGeometry.Spec (Z_bar.left.presheaf.obj (Opposite.op V_Z))).presheaf.map
                (CategoryTheory.homOfLE h_from_le).op =
              hAffVZ.fromSpec.appLE V_Z ⊤ h_from_le := by
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
              AlgebraicGeometry.Scheme.Hom.appLE_map]
          have h_map_id :
              ∀ (u : Opposite.op
                  (⊤ : (AlgebraicGeometry.Spec (Z_bar.left.presheaf.obj (Opposite.op V_Z))).Opens) ⟶
                Opposite.op ⊤),
                (AlgebraicGeometry.Spec (Z_bar.left.presheaf.obj (Opposite.op V_Z))).presheaf.map u =
                  𝟙 _ := by
            intro u
            rw [Subsingleton.elim u (𝟙 _), CategoryTheory.Functor.map_id]
          rw [← happ_map, hAffVZ.fromSpec_app_self, CategoryTheory.Category.assoc,
            ← CategoryTheory.Functor.map_comp, h_map_id, CategoryTheory.Category.comp_id]
        rw [h_from_app, ← h_iso_str] at h_app_comp
        have h_app_eq : Z_bar.hom.appLE ⊤ V_Z le_top =
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp MvPolynomial.C))).appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (Z_bar.left.presheaf.obj (Opposite.op V_Z))).hom := by
          rw [← h_app_comp, CategoryTheory.Category.assoc, Iso.inv_hom_id,
            CategoryTheory.Category.comp_id]
        have h_κ : CommRingCat.ofHom κ_Z = CommRingCat.ofHom (φ.comp MvPolynomial.C) := by
          change (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              Z_bar.hom.appLE ⊤ V_Z le_top = _
          rw [h_app_eq, AlgebraicGeometry.Scheme.ΓSpecIso_naturality,
            ← CategoryTheory.Category.assoc, Iso.inv_hom_id, CategoryTheory.Category.id_comp]
        exact congrArg CommRingCat.Hom.hom h_κ.symm
      have hf_eq : ∀ r : Fin 3, φ (f_lift r) = ℓ_r r := fun r => hf_lift r (hL_homog r)
      let I_β : Ideal (MvPolynomial (Fin 2) A) :=
        Ideal.span ({MvPolynomial.C (φ (f_lift β)) +
          MvPolynomial.C (φ (f_lift (β.succAbove 0))) * MvPolynomial.X (0 : Fin 2) +
          MvPolynomial.C (φ (f_lift (β.succAbove 1))) * MvPolynomial.X (1 : Fin 2)} :
            Set (MvPolynomial (Fin 2) A))
      have hI_eq : I_β = Ideal.span ({MvPolynomial.C (ℓ_r β) +
          MvPolynomial.C (ℓ_r (β.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
          MvPolynomial.C (ℓ_r (β.succAbove 1)) * MvPolynomial.X (1 : Fin 2)} :
            Set (MvPolynomial (Fin 2) A)) := by
        simp only [I_β, hf_eq]
      let e_Y' : (MvPolynomial (Fin 2) A ⧸ I_β) ≃+* ↑(Y₂.left.presheaf.obj (Opposite.op V_Y)) :=
        (Ideal.quotEquivOfEq hI_eq).trans e_Y
      let y_VY : ↥V_Y := ⟨y, hzV, hy_β⟩
      let 𝔭 : PrimeSpectrum (MvPolynomial (Fin 2) A ⧸ I_β) :=
        PrimeSpectrum.comap e_Y'.toRingHom (hAffVY.primeIdealOf y_VY)
      obtain ⟨Δ, hΔ_not_mem, hSm_loc⟩ :=
        (hSchur.2 s (2 * m - 1) A φ q f_lift idx hφ_surj hidx_inj hφ_ker hdet_q hdet_full).1 β 𝔭
      have hdim_eq : (2 * m - 1) + 4 = 2 * m + 3 := by omega
      rw [hdim_eq] at hSm_loc
      let Δ_Y : ↑(Y₂.left.presheaf.obj (Opposite.op V_Y)) := e_Y' Δ
      have hy_basic : y ∈ Y₂.left.basicOpen Δ_Y :=
        (hMemBasicOpen_iff hAffVY Δ_Y y_VY).mpr hΔ_not_mem
      have hAffBasic : AlgebraicGeometry.IsAffineOpen (Y₂.left.basicOpen Δ_Y) :=
        hAffVY.basicOpen Δ_Y
      refine ⟨⊤, hAffTop, Y₂.left.basicOpen Δ_Y, hAffBasic, hy_basic, le_top, ?_⟩
      let R_basic := ↑(Y₂.left.presheaf.obj (Opposite.op (Y₂.left.basicOpen Δ_Y)))
      let res_Δ : ↑(Y₂.left.presheaf.obj (Opposite.op V_Y)) →+* R_basic :=
        (Y₂.left.presheaf.map (CategoryTheory.homOfLE (Y₂.left.basicOpen_le Δ_Y)).op).hom
      letI : Algebra ↑(Y₂.left.presheaf.obj (Opposite.op V_Y)) R_basic := res_Δ.toAlgebra
      haveI : IsLocalization.Away Δ_Y R_basic := hAffVY.isLocalization_basicOpen Δ_Y
      have hSub_eq : Submonoid.map e_Y'.toMonoidHom (Submonoid.powers Δ) =
          Submonoid.powers Δ_Y := Submonoid.map_powers e_Y' Δ
      let e_loc : Localization.Away Δ ≃+* R_basic :=
        IsLocalization.ringEquivOfRingEquiv (Localization.Away Δ) R_basic e_Y' hSub_eq
      let ψ_loc : k →+* Localization.Away Δ :=
        (algebraMap (MvPolynomial (Fin 2) A ⧸ I_β) (Localization.Away Δ)).comp
          ((Ideal.Quotient.mk I_β).comp (MvPolynomial.C.comp (φ.comp MvPolynomial.C)))
      have h1 : RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 3)
          ((e_loc.toCommRingCatIso.hom).hom.comp (CommRingCat.ofHom ψ_loc).hom) :=
        (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_right_isIso
          (CommRingCat.ofHom ψ_loc) e_loc.toCommRingCatIso.hom).mpr hSm_loc
      have hEqBasic : (Y₂.hom.appLE ⊤ (Y₂.left.basicOpen Δ_Y) le_top).hom.comp
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom =
          (e_loc.toCommRingCatIso.hom).hom.comp (CommRingCat.ofHom ψ_loc).hom := by
        have happ : Y₂.hom.appLE ⊤ (Y₂.left.basicOpen Δ_Y) le_top =
            Y₂.hom.appLE ⊤ V_Y le_top ≫
              Y₂.left.presheaf.map (CategoryTheory.homOfLE (Y₂.left.basicOpen_le Δ_Y)).op :=
          (AlgebraicGeometry.Scheme.Hom.appLE_map Y₂.hom le_top
            (CategoryTheory.homOfLE (Y₂.left.basicOpen_le Δ_Y)).op).symm
        ext c
        have hc1 : ((Y₂.hom.appLE ⊤ (Y₂.left.basicOpen Δ_Y) le_top).hom.comp
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom) c =
            res_Δ (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              Y₂.hom.appLE ⊤ V_Y le_top).hom c) := by
          rw [happ]
          rfl
        rw [hc1, hY_hom c]
        change (algebraMap ↑(Y₂.left.presheaf.obj (Opposite.op V_Y)) R_basic)
            (e_Y (Ideal.Quotient.mk _ (MvPolynomial.C (κ_Z c)))) =
          e_loc (algebraMap (MvPolynomial (Fin 2) A ⧸ I_β) (Localization.Away Δ)
            (Ideal.Quotient.mk I_β (MvPolynomial.C ((φ.comp MvPolynomial.C) c))))
        rw [hφ_C]
        have heY_eq : e_Y (Ideal.Quotient.mk _ (MvPolynomial.C (κ_Z c))) =
            e_Y' (Ideal.Quotient.mk I_β (MvPolynomial.C (κ_Z c))) := rfl
        rw [heY_eq]
        exact (IsLocalization.ringEquivOfRingEquiv_eq hSub_eq
          (Ideal.Quotient.mk I_β (MvPolynomial.C (κ_Z c)))).symm
      refine (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_left_isIso
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
        (Y₂.hom.appLE ⊤ (Y₂.left.basicOpen Δ_Y) le_top)).mp ?_
      rw [hEqBasic]
      exact h1

  letI : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 3) Y₂.hom := hSm_Y₂
  have hCharts_s6 :
      ∀ (β : Fin 3) (α : Fin (M + 1))
        (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
        (U_Z : Z_bar.left.Opens)
        (hAffZ : AlgebraicGeometry.IsAffineOpen U_Z)
        (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α))),
        let D_β : (weilProjectiveSpaceOver k 2).left.Opens :=
          AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X β)
        let V_Y : Y₂.left.Opens :=
          (TopologicalSpace.Opens.map π_Y.left.base).obj U_Z ⊓
            (TopologicalSpace.Opens.map g₂.left.base).obj D_β
        let A := ↑(Z_bar.left.presheaf.obj (Opposite.op U_Z))
        let ℓ_r : Fin 3 → A := fun r =>
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
            ι_bar.left.appLE
              (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) U_Z hUZ).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
        let B_quot := MvPolynomial (Fin 2) A ⧸
          Ideal.span ({MvPolynomial.C (ℓ_r β) +
            MvPolynomial.C (ℓ_r (β.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
            MvPolynomial.C (ℓ_r (β.succAbove 1)) * MvPolynomial.X (1 : Fin 2)} :
              Set (MvPolynomial (Fin 2) A))
        ∃ (hAffVY : AlgebraicGeometry.IsAffineOpen V_Y)
          (e_Y : B_quot ≃+* ↑(Y₂.left.presheaf.obj (Opposite.op V_Y))),
          (∀ (z : ↥U_Z) (r : Fin 3),
            ι_bar.left.base z.1 ∈ weilProjHyperplaneSet k M (L r) ↔
              ℓ_r r ∈ (hAffZ.primeIdealOf z).asIdeal) ∧
          (∀ a : A,
            (π_Y.left.appLE U_Z V_Y inf_le_left).hom a =
              e_Y (Ideal.Quotient.mk _ (MvPolynomial.C a))) ∧
          (∀ (y : ↥V_Y) (i : Fin 2),
            g₂.left.base y.1 ∈
              AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X (β.succAbove i)) ↔
              e_Y (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∉
                (hAffVY.primeIdealOf y).asIdeal) := by
    intro β α hXα U_Z hAffZ hUZ
    obtain ⟨_, _, hChart_β⟩ := hCharts β
    obtain ⟨hAffVY, e_Y, hVan, _, hπ_app, _, _, hX_iff⟩ :=
      hChart_β α hXα U_Z hAffZ hUZ
    exact ⟨hAffVY, e_Y, hVan, hπ_app, hX_iff⟩

  have hAxis_sm :
      1 ≤ m → ∀ z : Z_bar.left,
        (∀ r : Fin 3, ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L r)) →
        ∃ (α : Fin (M + 1))
          (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
          (V_Z : Z_bar.left.Opens)
          (_ : AlgebraicGeometry.IsAffineOpen V_Z)
          (hVZ : V_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)))
          (κ_net : k →+* MvPolynomial (Fin 2)
            (↑(Z_bar.left.presheaf.obj (Opposite.op V_Z)) ⧸
              Ideal.span (Set.range (fun r : Fin 3 =>
                ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M
                    (MvPolynomial.X α) hXα zero_lt_one).hom ≫
                  ι_bar.left.appLE
                    (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) V_Z hVZ).hom
                  (HomogeneousLocalization.mk
                    ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩))))),
          z ∈ V_Z ∧ RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 1) κ_net := by
    intro hm z hz_axis
    obtain ⟨α₀, V_Z, hAffVZ, hzV, _, hVα, hXα, _, s, φ, q, f_lift, idx,
        hφ_surj, hidx_inj, _, hφ_ker, hf_lift, hdet_q, hdet_full⟩ :=
      (hNet_pos hm).2 z trivial hz_axis
    have hSm_net :=
      (hSchur.2 s (2 * m - 1) _ φ q f_lift idx hφ_surj hidx_inj hφ_ker hdet_q hdet_full).2
    have hdim_net : (2 * m - 1) + 2 = 2 * m + 1 := by omega
    rw [hdim_net] at hSm_net
    have hSpanEq :
        Ideal.span (Set.range (fun r : Fin 3 => φ (f_lift r))) =
        Ideal.span (Set.range (fun r : Fin 3 =>
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M
              (MvPolynomial.X α₀) hXα zero_lt_one).hom ≫
            ι_bar.left.appLE
              (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀)) V_Z hVα).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩))) := by
      congr 1
      ext x
      simp only [Set.mem_range]
      constructor
      · rintro ⟨r, rfl⟩
        exact ⟨r, (hf_lift r (hL_homog r)).symm⟩
      · rintro ⟨r, rfl⟩
        exact ⟨r, hf_lift r (hL_homog r)⟩
    refine ⟨α₀, hXα, V_Z, hAffVZ, hVα, ?_, hzV, ?_⟩
    · exact (MvPolynomial.mapEquiv (Fin 2) (Ideal.quotEquivOfEq hSpanEq)).toRingHom.comp
        ((MvPolynomial.C : _ →+* MvPolynomial (Fin 2) _).comp
          ((Ideal.Quotient.mk _).comp (φ.comp MvPolynomial.C)))
    · let e_mv := MvPolynomial.mapEquiv (Fin 2) (Ideal.quotEquivOfEq hSpanEq)
      let ψ_net := (MvPolynomial.C : _ →+* MvPolynomial (Fin 2) _).comp
        ((Ideal.Quotient.mk (Ideal.span (Set.range (fun r : Fin 3 => φ (f_lift r))))).comp
          (φ.comp MvPolynomial.C))
      exact (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_right_isIso
        (CommRingCat.ofHom ψ_net) e_mv.toCommRingCatIso.hom).mpr hSm_net

  have hInt_Y₂ : AlgebraicGeometry.IsIntegral Y₂.left :=
    weil_algClosed_net_incidence_isIntegral k m M Z_bar hInt ι_bar L hL_homog hL_nondeg hNet_m0
      Y₂ π_Y g₂ hCov_Z hCov_P hCharts_s6 hAxis_sm

  exact ⟨Y₂, π_Y, g₂, hNet_inc, hInt_Y₂, hProp_Y₂, hSm_Y₂, hProj_Y₂, hFlat_g₂, hProp_g₂⟩

theorem weil_pencil_line_pullback_local_eq_and_open_iso (k : Type u) [Field k] (M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hCl_ι : AlgebraicGeometry.IsClosedImmersion ι_bar.left)
    (L : Fin 3 → MvPolynomial (Fin (M + 1)) k)
    (hL_homog : ∀ r : Fin 3, L r ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      (weilProjectiveSpaceOver k 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
      (weilProjectiveSpaceOver k 1).left)
    (ι_line : weilProjectiveSpaceOver k 1 ⟶ weilProjectiveSpaceOver k 2)
    (u_val : k)
    (hCoord_line : IsStandardProjLineCoord k j_aff s_inf)
    (hLine_plane : IsStandardProjLineInPlane k ι_line)
    (U_axis : Z_bar.left.Opens)
    (hU_axis_eq : (U_axis : Set Z_bar.left) =
      ({ z : Z_bar.left |
        ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 0) ∧
        ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 1) })ᶜ)
    (Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π_Y : Y₂ ⟶ Z_bar)
    (g₂ : Y₂ ⟶ weilProjectiveSpaceOver k 2)
    (hNet_inc : IsLinearNetIncidenceFamily k M Z_bar ι_bar L Y₂ π_Y g₂) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
      MvPolynomial.gradedAlgebra
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
      MvPolynomial.gradedAlgebra
    let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
    let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    let P₁ := weilProjectiveSpaceOver k 1
    let Q₁ := CategoryTheory.Limits.pullback Z_bar.hom P₁.hom
    let p₁_Z := CategoryTheory.Limits.pullback.fst Z_bar.hom P₁.hom
    let p₁_P := CategoryTheory.Limits.pullback.snd Z_bar.hom P₁.hom
    let ι_Ytilde_sch := CategoryTheory.Limits.pullback.fst g₂.left ι_line.left
    let f₀_sch := CategoryTheory.Limits.pullback.snd g₂.left ι_line.left
    let π₀_sch := ι_Ytilde_sch ≫ π_Y.left
    let u₀_sec := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (Polynomial.evalRingHom u_val)) ≫ j_aff
    let ι_Zu₀ := CategoryTheory.Limits.pullback.fst f₀_sch u₀_sec
    ∃ (hcomm_Z : π₀_sch ≫ Z_bar.hom = f₀_sch ≫ P₁.hom),
      let ι_Z_Q₁ := CategoryTheory.Limits.pullback.lift π₀_sch f₀_sch hcomm_Z
      AlgebraicGeometry.IsClosedImmersion ι_Z_Q₁ ∧
      (∀ (α : Fin (M + 1)) (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
         (hF_axis : ∀ a : Fin 2, ![L 0, L 1] a ∈ 𝒜_M 1)
         (b : Fin 2) (hTb : (MvPolynomial.X b : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1)
         (U_Z : Z_bar.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_Z)
         (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
           (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)))
         (U_P : P₁.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_P)
         (hUP : U_P ≤ AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b))
         (W_pb : Q₁.Opens) (_ : AlgebraicGeometry.IsAffineOpen W_pb)
         (hWZ : W_pb ≤ (TopologicalSpace.Opens.map p₁_Z.base).obj U_Z)
         (hWP : W_pb ≤ (TopologicalSpace.Opens.map p₁_P.base).obj U_P),
        let ℓ_a : Fin 2 → ↑(Z_bar.left.presheaf.obj (Opposite.op U_Z)) := fun a =>
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) U_Z hUZ).hom
            (HomogeneousLocalization.mk ⟨1, ⟨![L 0, L 1] a, hF_axis a⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
        let t_a : Fin 2 → ↑(P₁.left.presheaf.obj (Opposite.op U_P)) := fun a =>
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b) hTb zero_lt_one).hom ≫
            P₁.left.presheaf.map (CategoryTheory.homOfLE hUP).op).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨MvPolynomial.X a, MvPolynomial.isHomogeneous_X k a⟩, ⟨MvPolynomial.X b, hTb⟩, ⟨1, pow_one _⟩⟩)
        RingHom.ker (ι_Z_Q₁.app W_pb).hom =
          Ideal.span {∑ a : Fin 2,
            (p₁_Z.appLE U_Z W_pb hWZ).hom (ℓ_a a) *
            (p₁_P.appLE U_P W_pb hWP).hom (t_a a)}) ∧
      CategoryTheory.IsIso (π₀_sch ∣_ U_axis) ∧
      ((ι_Zu₀ ≫ π₀_sch) ≫ Z_bar.hom = CategoryTheory.Limits.pullback.snd f₀_sch u₀_sec) ∧
      AlgebraicGeometry.IsClosedImmersion (ι_Zu₀ ≫ π₀_sch) ∧
      Set.range (ι_Zu₀ ≫ π₀_sch).base =
        { z : Z_bar.left |
          ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 0 + MvPolynomial.C u_val * L 1) } ∧
      (∀ (α : Fin (M + 1)) (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
         (hLu₀ : L 0 + MvPolynomial.C u_val * L 1 ∈ 𝒜_M 1)
         (U_Z : Z_bar.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_Z)
         (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
           (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α))),
        RingHom.ker ((ι_Zu₀ ≫ π₀_sch).app U_Z).hom =
          Ideal.span {((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) U_Z hUZ).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨L 0 + MvPolynomial.C u_val * L 1, hLu₀⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)}) :=
by
  let : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
    MvPolynomial.gradedAlgebra
  let : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
    MvPolynomial.gradedAlgebra
  let : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
    MvPolynomial.gradedAlgebra
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
  let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k
  let P₁ := weilProjectiveSpaceOver k 1
  let P₂ := weilProjectiveSpaceOver k 2
  let Q₁ := CategoryTheory.Limits.pullback Z_bar.hom P₁.hom
  let p₁_Z := CategoryTheory.Limits.pullback.fst Z_bar.hom P₁.hom
  let p₁_P := CategoryTheory.Limits.pullback.snd Z_bar.hom P₁.hom
  let Q₂ := CategoryTheory.Limits.pullback Z_bar.hom P₂.hom
  let p₂_Z := CategoryTheory.Limits.pullback.fst Z_bar.hom P₂.hom
  let p₂_P := CategoryTheory.Limits.pullback.snd Z_bar.hom P₂.hom
  let ι_Ytilde_sch := CategoryTheory.Limits.pullback.fst g₂.left ι_line.left
  let f₀_sch := CategoryTheory.Limits.pullback.snd g₂.left ι_line.left
  let π₀_sch := ι_Ytilde_sch ≫ π_Y.left
  let u₀_sec := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (Polynomial.evalRingHom u_val)) ≫ j_aff
  let ι_Zu₀ := CategoryTheory.Limits.pullback.fst f₀_sch u₀_sec

  
  have h_appLE_rfl : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens),
      f.appLE U ((TopologicalSpace.Opens.map f.base).obj U) le_rfl = f.app U := by
    intro X Y f U
    have hid : (CategoryTheory.homOfLE le_rfl :
        (TopologicalSpace.Opens.map f.base).obj U ⟶ (TopologicalSpace.Opens.map f.base).obj U) =
        𝟙 _ := Subsingleton.elim _ _
    rw [Scheme.Hom.appLE, hid, op_id, CategoryTheory.Functor.map_id, Category.comp_id]

  
  have h_pb_map_isos : ∀ {P X₁ X₂ S X₁' X₂' S' : Scheme.{u}}
      {f₁ : P ⟶ X₁} {f₂ : P ⟶ X₂} {g₁ : X₁ ⟶ S} {g₂ : X₂ ⟶ S}
      (hPb : IsPullback f₁ f₂ g₁ g₂)
      (e₁ : X₁ ≅ X₁') (e₂ : X₂ ≅ X₂') (eS : S ≅ S')
      {g₁' : X₁' ⟶ S'} {g₂' : X₂' ⟶ S'}
      (_ : e₁.hom ≫ g₁' = g₁ ≫ eS.hom)
      (_ : e₂.hom ≫ g₂' = g₂ ≫ eS.hom),
      IsPullback (f₁ ≫ e₁.hom) (f₂ ≫ e₂.hom) g₁' g₂' := by
    intro P X₁ X₂ S X₁' X₂' S' f₁ f₂ g₁ g₂ hPb e₁ e₂ eS g₁' g₂' hg₁ hg₂
    refine ⟨⟨by rw [Category.assoc, hg₁, ← Category.assoc, hPb.w, Category.assoc, ← hg₂, Category.assoc]⟩,
      ⟨Limits.PullbackCone.IsLimit.mk _
        (fun s => hPb.lift (s.fst ≫ e₁.inv) (s.snd ≫ e₂.inv) (by
          apply (cancel_mono eS.hom).mp
          have h1 : e₁.inv ≫ g₁ ≫ eS.hom = g₁' := by rw [← hg₁, Iso.inv_hom_id_assoc]
          have h2 : e₂.inv ≫ g₂ ≫ eS.hom = g₂' := by rw [← hg₂, Iso.inv_hom_id_assoc]
          rw [Category.assoc, Category.assoc, h1, Category.assoc, Category.assoc, h2, s.condition]))
        (fun s => by rw [← Category.assoc, hPb.lift_fst, Category.assoc, Iso.inv_hom_id, Category.comp_id])
        (fun s => by rw [← Category.assoc, hPb.lift_snd, Category.assoc, Iso.inv_hom_id, Category.comp_id])
        (fun s m hm₁ hm₂ => by
          refine hPb.hom_ext ?_ ?_
          · rw [hPb.lift_fst, ← hm₁, Category.assoc, Category.assoc, Iso.hom_inv_id, Category.comp_id]
          · rw [hPb.lift_snd, ← hm₂, Category.assoc, Category.assoc, Iso.hom_inv_id, Category.comp_id])⟩⟩

  
  have h_pb_resLE : ∀ {P X₁ X₂ S S₀ : Scheme.{u}}
      {f₁ : P ⟶ X₁} {f₂ : P ⟶ X₂} {g₁ : X₁ ⟶ S} {g₂ : X₂ ⟶ S}
      (hPb : IsPullback f₁ f₂ g₁ g₂)
      (U₁ : X₁.Opens) (U₂ : X₂.Opens) (W : P.Opens)
      (hW₁ : W ≤ (TopologicalSpace.Opens.map f₁.base).obj U₁)
      (hW₂ : W ≤ (TopologicalSpace.Opens.map f₂.base).obj U₂)
      (_ : ∀ p : P, f₁.base p ∈ U₁ → f₂.base p ∈ U₂ → p ∈ W)
      (j_S : S₀ ⟶ S) [Mono j_S]
      (g₁' : U₁.toScheme ⟶ S₀) (g₂' : U₂.toScheme ⟶ S₀)
      (_ : g₁' ≫ j_S = U₁.ι ≫ g₁)
      (_ : g₂' ≫ j_S = U₂.ι ≫ g₂),
      IsPullback (f₁.resLE U₁ W hW₁) (f₂.resLE U₂ W hW₂) g₁' g₂' := by
    intro P X₁ X₂ S S₀ f₁ f₂ g₁ g₂ hPb U₁ U₂ W hW₁ hW₂ hW_iff j_S _ g₁' g₂' hg₁' hg₂'
    have hw : f₁.resLE U₁ W hW₁ ≫ g₁' = f₂.resLE U₂ W hW₂ ≫ g₂' := by
      apply (cancel_mono j_S).mp
      rw [Category.assoc, hg₁', Scheme.Hom.resLE_comp_ι_assoc, hPb.w,
        Category.assoc, hg₂', Scheme.Hom.resLE_comp_ι_assoc]
    refine ⟨⟨hw⟩, ⟨Limits.PullbackCone.IsLimit.mk _
      (fun s => by
        have hs : (s.fst ≫ U₁.ι) ≫ g₁ = (s.snd ≫ U₂.ι) ≫ g₂ := by
          rw [Category.assoc, ← hg₁', ← Category.assoc, s.condition, Category.assoc, hg₂', Category.assoc]
        let l : s.pt ⟶ P := hPb.lift (s.fst ≫ U₁.ι) (s.snd ≫ U₂.ι) hs
        have hrange : Set.range l.base ⊆ Set.range W.ι.base := by
          rw [Scheme.Opens.range_ι]
          rintro _ ⟨t, rfl⟩
          apply hW_iff
          · have h1 : (l ≫ f₁).base t = (s.fst ≫ U₁.ι).base t := by rw [hPb.lift_fst]
            change (l ≫ f₁).base t ∈ U₁
            rw [h1]
            exact (s.fst.base t).2
          · have h2 : (l ≫ f₂).base t = (s.snd ≫ U₂.ι).base t := by rw [hPb.lift_snd]
            change (l ≫ f₂).base t ∈ U₂
            rw [h2]
            exact (s.snd.base t).2
        exact IsOpenImmersion.lift W.ι l hrange)
      (fun s => by
        apply (cancel_mono U₁.ι).mp
        rw [Category.assoc, Scheme.Hom.resLE_comp_ι, IsOpenImmersion.lift_fac_assoc, hPb.lift_fst])
      (fun s => by
        apply (cancel_mono U₂.ι).mp
        rw [Category.assoc, Scheme.Hom.resLE_comp_ι, IsOpenImmersion.lift_fac_assoc, hPb.lift_snd])
      (fun s m hm₁ hm₂ => by
        apply (cancel_mono W.ι).mp
        rw [IsOpenImmersion.lift_fac]
        refine hPb.hom_ext ?_ ?_
        · rw [hPb.lift_fst, ← hm₁, Category.assoc]
          exact (congrArg (m ≫ ·) (Scheme.Hom.resLE_comp_ι f₁ hW₁)).symm
        · rw [hPb.lift_snd, ← hm₂, Category.assoc]
          exact (congrArg (m ≫ ·) (Scheme.Hom.resLE_comp_ι f₂ hW₂)).symm)⟩⟩

  
  have h_toSpecΓ_toSpec : ∀ {X : Scheme.{u}} (U : X.Opens) {R : CommRingCat.{u}} (g : X ⟶ Spec R),
      U.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso R).inv ≫ g.appLE ⊤ U le_top) = U.ι ≫ g := by
    intro X U R g
    have hle : U ≤ (TopologicalSpace.Opens.map g.base).obj ⊤ := le_top
    have h1 := Scheme.Opens.toSpecΓ_SpecMap_appLE g ⊤ U hle
    rw [Spec.map_comp, ← Category.assoc, h1, Category.assoc]
    have h2 : (⊤ : (Spec R).Opens).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso R).inv = (⊤ : (Spec R).Opens).ι := by
      have hAff_top : IsAffineOpen (⊤ : (Spec R).Opens) := isAffineOpen_top (Spec R)
      apply (cancel_epi hAff_top.isoSpec.inv).mp
      rw [← Category.assoc, ← IsAffineOpen.isoSpec_hom hAff_top, hAff_top.isoSpec.inv_hom_id,
        Category.id_comp]
      have hpre : Spec.preimage (Spec.map (Scheme.ΓSpecIso R).inv) =
          Spec.preimage (hAff_top.isoSpec.inv ≫ (⊤ : (Spec R).Opens).ι) := by
        apply (cancel_epi (Scheme.ΓSpecIso R).hom).mp
        rw [← Scheme.ΓSpecIso_naturality, ← Scheme.ΓSpecIso_naturality,
          Spec.map_preimage, Spec.map_preimage]
        apply (cancel_mono (Scheme.ΓSpecIso Γ(Spec R, ⊤)).inv).mp
        rw [Category.assoc, Iso.hom_inv_id, Category.comp_id, Category.assoc, Iso.hom_inv_id, Category.comp_id]
        have hn := Scheme.ΓSpecIso_naturality (Scheme.ΓSpecIso R).inv
        have hlhs : (Spec.map (Scheme.ΓSpecIso R).inv).appTop = (Scheme.ΓSpecIso Γ(Spec R, ⊤)).inv := by
          apply (cancel_mono (Scheme.ΓSpecIso Γ(Spec R, ⊤)).hom).mp
          rw [hn, Iso.hom_inv_id, Iso.inv_hom_id]
        rw [hlhs, Scheme.Hom.comp_appTop]
        have htop_app : (⊤ : (Spec R).Opens).ι.appTop = (⊤ : (Spec R).Opens).topIso.inv := by
          rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
          exact congrArg (Spec R).presheaf.map (Subsingleton.elim _ _)
        have h_hom_inv_top : ((Scheme.ΓSpecIso Γ(Spec R, ⊤)).hom ≫
            (⊤ : (Spec R).Opens).topIso.inv) ≫ hAff_top.isoSpec.inv.appTop = 𝟙 _ := by
          rw [← Scheme.Opens.toSpecΓ_appTop, ← IsAffineOpen.isoSpec_hom hAff_top,
            ← Scheme.Hom.comp_appTop, hAff_top.isoSpec.inv_hom_id, Scheme.Hom.id_appTop]
        rw [htop_app]
        apply (cancel_epi (Scheme.ΓSpecIso Γ(Spec R, ⊤)).hom).mp
        rw [Iso.hom_inv_id, ← Category.assoc, h_hom_inv_top]
      calc Spec.map (Scheme.ΓSpecIso R).inv
          = Spec.map (Spec.preimage (Spec.map (Scheme.ΓSpecIso R).inv)) := (Spec.map_preimage _).symm
        _ = Spec.map (Spec.preimage (hAff_top.isoSpec.inv ≫ (⊤ : (Spec R).Opens).ι)) := by rw [hpre]
        _ = hAff_top.isoSpec.inv ≫ (⊤ : (Spec R).Opens).ι := Spec.map_preimage _
    rw [h2]
    exact Scheme.Hom.resLE_comp_ι g hle

  
  have hCl_ker : ∀ {Y' Y S' S : Scheme.{u}}
      (p_Y : Y' ⟶ Y) (ι' : Y' ⟶ S') (ι : Y ⟶ S) (g : S' ⟶ S),
      IsPullback p_Y ι' ι g →
      IsClosedImmersion ι →
      ∀ (U : S.Opens), IsAffineOpen U →
      ∀ (U' : S'.Opens), IsAffineOpen U' →
      ∀ (hU' : U' ≤ (TopologicalSpace.Opens.map g.base).obj U),
        RingHom.ker (ι'.app U').hom =
          Ideal.map (g.appLE U U' hU').hom (RingHom.ker (ι.app U).hom) := by
    intro Y' Y S' S p_Y ι' ι g hPb hCl U hU U' hU' hU'_le
    have : IsClosedImmersion ι := hCl
    have : IsClosedImmersion ι' :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb hCl
    let V : Y.Opens := (TopologicalSpace.Opens.map ι.base).obj U
    let V' : Y'.Opens := (TopologicalSpace.Opens.map ι'.base).obj U'
    have hV : IsAffineOpen V := hU.preimage ι
    have hV' : IsAffineOpen V' := hU'.preimage ι'
    have hV'_le : V' ≤ (TopologicalSpace.Opens.map p_Y.base).obj V := fun y' hy' => by
      change ι.base (p_Y.base y') ∈ U
      rw [← Scheme.Hom.comp_apply, hPb.w, Scheme.Hom.comp_apply]
      exact hU'_le hy'
    have hPb_res : IsPullback (p_Y.resLE V V' hV'_le) (ι'.resLE U' V' le_rfl)
        (ι.resLE U V le_rfl) (g.resLE U U' hU'_le) :=
      h_pb_resLE hPb V U' V' hV'_le le_rfl (fun _ _ h2 => h2) U.ι
        (ι.resLE U V le_rfl) (g.resLE U U' hU'_le)
        (Scheme.Hom.resLE_comp_ι _ _) (Scheme.Hom.resLE_comp_ι _ _)
    have h_app_ι : ι.appLE U V le_rfl = ι.app U := h_appLE_rfl ι U
    have h_app_ι' : ι'.appLE U' V' le_rfl = ι'.app U' := h_appLE_rfl ι' U'
    have hPb_res_spec : IsPullback
        (p_Y.resLE V V' hV'_le ≫ hV.isoSpec.hom)
        (ι'.resLE U' V' le_rfl ≫ hU'.isoSpec.hom)
        (Spec.map (ι.app U))
        (Spec.map (g.appLE U U' hU'_le)) :=
      h_pb_map_isos hPb_res hV.isoSpec hU'.isoSpec hU.isoSpec
        (by rw [← h_app_ι, IsAffineOpen.isoSpec_hom, IsAffineOpen.isoSpec_hom,
              Scheme.Opens.toSpecΓ_SpecMap_appLE])
        (by rw [IsAffineOpen.isoSpec_hom, IsAffineOpen.isoSpec_hom,
              Scheme.Opens.toSpecΓ_SpecMap_appLE])
    let R := S.presheaf.obj (Opposite.op U)
    let R_Y := Y.presheaf.obj (Opposite.op V)
    let R' := S'.presheaf.obj (Opposite.op U')
    let R'_Y := Y'.presheaf.obj (Opposite.op V')
    have hSurj : Function.Surjective (ι.app U).hom :=
      (isClosedImmersion_iff_isAffineHom.mp hCl).2 U hU
    let I : Ideal ↑R := RingHom.ker (ι.app U).hom
    let φ : ↑R →+* ↑R' := (g.appLE U U' hU'_le).hom
    let J : Ideal ↑R' := Ideal.map φ I
    let e_Y : ↑R ⧸ I ≃+* ↑R_Y := RingHom.quotientKerEquivOfSurjective hSurj
    have hI_le : ∀ r ∈ I, ((Ideal.Quotient.mk J).comp φ) r = 0 := fun r hr => by
      simp only [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem φ hr
    let φ_bar : ↑R ⧸ I →+* ↑R' ⧸ J := Ideal.Quotient.lift I ((Ideal.Quotient.mk J).comp φ) hI_le
    let φ_Y : R_Y ⟶ CommRingCat.of (↑R' ⧸ J) := CommRingCat.ofHom (φ_bar.comp e_Y.symm.toRingHom)
    let q_J : R' ⟶ CommRingCat.of (↑R' ⧸ J) := CommRingCat.ofHom (Ideal.Quotient.mk J)
    have h_eY_mk : ∀ r : ↑R, e_Y.symm ((ι.app U).hom r) = Ideal.Quotient.mk I r := fun r =>
      e_Y.injective (by rw [e_Y.apply_symm_apply]; rfl)
    have hPush : IsPushout (ι.app U) (g.appLE U U' hU'_le) φ_Y q_J := by
      have hw_push : ι.app U ≫ φ_Y = g.appLE U U' hU'_le ≫ q_J := by
        ext r
        change φ_bar (e_Y.symm ((ι.app U).hom r)) = Ideal.Quotient.mk J (φ r)
        rw [h_eY_mk r]
        rfl
      refine ⟨⟨hw_push⟩, ⟨Limits.PushoutCocone.IsColimit.mk _
        (fun s => CommRingCat.ofHom (Ideal.Quotient.lift J s.inr.hom (by
          show J ≤ RingHom.ker s.inr.hom
          rw [Ideal.map_le_iff_le_comap]
          intro r hr
          have hsr : s.inl.hom ((ι.app U).hom r) = s.inr.hom (φ r) :=
            ConcreteCategory.congr_hom s.condition r
          change s.inr.hom (φ r) = 0
          have h0 : (ι.app U).hom r = 0 := hr
          rw [← hsr, h0, map_zero])))
        (fun s => by
          ext y
          obtain ⟨r, rfl⟩ := hSurj y
          have hsr : s.inl.hom ((ι.app U).hom r) = s.inr.hom (φ r) :=
            ConcreteCategory.congr_hom s.condition r
          simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
          change Ideal.Quotient.lift J s.inr.hom _ (φ_bar (e_Y.symm ((ι.app U).hom r))) =
            s.inl.hom ((ι.app U).hom r)
          rw [h_eY_mk r]
          exact hsr.symm)
        (fun s => by ext r'; rfl)
        (fun s m _ hm₂ => by ext r'; exact ConcreteCategory.congr_hom hm₂ r')⟩⟩
    have hPb_spec := isPullback_SpecMap_of_isPushout _ _ _ _ hPush
    let α_iso : V'.toScheme ≅ Spec (CommRingCat.of (↑R' ⧸ J)) :=
      IsPullback.isoIsPullback _ _ hPb_res_spec hPb_spec
    have hα_snd : α_iso.hom ≫ Spec.map q_J = hV'.isoSpec.hom ≫ Spec.map (ι'.app U') := by
      have h1 : α_iso.hom ≫ Spec.map q_J = ι'.resLE U' V' le_rfl ≫ hU'.isoSpec.hom :=
        IsPullback.isoIsPullback_hom_snd _ _ hPb_res_spec hPb_spec
      rw [h1, ← h_app_ι', IsAffineOpen.isoSpec_hom, IsAffineOpen.isoSpec_hom,
        Scheme.Opens.toSpecΓ_SpecMap_appLE]
    let β_iso : Spec (CommRingCat.of (↑R' ⧸ J)) ≅ Spec R'_Y := α_iso.symm ≪≫ hV'.isoSpec
    have hβ : β_iso.hom ≫ Spec.map (ι'.app U') = Spec.map q_J := by
      dsimp [β_iso]
      rw [Category.assoc, ← hα_snd, Iso.inv_hom_id_assoc]
    have h_pre : ι'.app U' ≫ Spec.preimage β_iso.hom = q_J := by
      have := congrArg Spec.preimage hβ
      rwa [Spec.preimage_comp, Spec.preimage_map, Spec.preimage_map] at this
    have h_pre_inv : Spec.preimage β_iso.hom ≫ Spec.preimage β_iso.inv = 𝟙 _ := by
      rw [← Spec.preimage_comp, β_iso.inv_hom_id, Spec.preimage_id]
    have hker_eq : RingHom.ker (ι'.app U').hom = RingHom.ker q_J.hom := by
      ext x
      simp only [RingHom.mem_ker]
      constructor
      · intro hx
        have h1 := ConcreteCategory.congr_hom h_pre x
        change (Spec.preimage β_iso.hom).hom ((ι'.app U').hom x) = q_J.hom x at h1
        rw [hx, map_zero] at h1
        exact h1.symm
      · intro hx
        have h1 := ConcreteCategory.congr_hom h_pre x
        change (Spec.preimage β_iso.hom).hom ((ι'.app U').hom x) = q_J.hom x at h1
        have h2 := congrArg (Spec.preimage β_iso.inv).hom h1
        have h3 := ConcreteCategory.congr_hom h_pre_inv ((ι'.app U').hom x)
        change (Spec.preimage β_iso.inv).hom ((Spec.preimage β_iso.hom).hom ((ι'.app U').hom x)) =
          (ι'.app U').hom x at h3
        rw [h3, hx, map_zero] at h2
        exact h2
    rw [hker_eq]
    exact Ideal.mk_ker

  
  have hProd_aff : ∀ {X₁ X₂ B : Scheme.{u}} [IsAffine B]
      (f₁ : X₁ ⟶ B) (f₂ : X₂ ⟶ B) (U₁ : X₁.Opens) (U₂ : X₂.Opens),
      IsAffineOpen U₁ → IsAffineOpen U₂ →
      IsAffineOpen
        ((TopologicalSpace.Opens.map (Limits.pullback.fst f₁ f₂).base).obj U₁ ⊓
          (TopologicalSpace.Opens.map (Limits.pullback.snd f₁ f₂).base).obj U₂) := by
    intro X₁ X₂ B _ f₁ f₂ U₁ U₂ hU₁ hU₂
    let p₁ := Limits.pullback.fst f₁ f₂
    let p₂ := Limits.pullback.snd f₁ f₂
    let W := (TopologicalSpace.Opens.map p₁.base).obj U₁ ⊓ (TopologicalSpace.Opens.map p₂.base).obj U₂
    have hPb_W : IsPullback (p₁.resLE U₁ W inf_le_left) (p₂.resLE U₂ W inf_le_right)
        (U₁.ι ≫ f₁) (U₂.ι ≫ f₂) :=
      h_pb_resLE (IsPullback.of_hasPullback f₁ f₂) U₁ U₂ W
        inf_le_left inf_le_right (fun _ h1 h2 => ⟨h1, h2⟩) (𝟙 B)
        (U₁.ι ≫ f₁) (U₂.ι ≫ f₂) (Category.comp_id _) (Category.comp_id _)
    have : IsAffine U₁.toScheme := hU₁
    have : IsAffine U₂.toScheme := hU₂
    exact isAffine_of_isAffineHom hPb_W.isoPullback.hom

  
  have h_proj_scalar : ∀ (N : ℕ) (α : Fin (N + 1))
      (hXα : (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
      (c : k),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      let P_N := weilProjectiveSpaceOver k N
      let D_α : P_N.left.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)
      (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom.hom
        (HomogeneousLocalization.fromZeroRingHom 𝒜_N
          (Submonoid.powers (MvPolynomial.X α)) (algebraMap k ↥(𝒜_N 0) c)) =
      (P_N.hom.appLE ⊤ D_α le_top).hom
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom c) := by
    intro N α hXα c
    let : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
      MvPolynomial.gradedAlgebra
    let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let D_α : (AlgebraicGeometry.Proj 𝒜_N).Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)
    let p_hom : AlgebraicGeometry.Proj 𝒜_N ⟶ Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
        Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0)))
    change (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom.hom _ =
      (p_hom.appLE ⊤ D_α le_top).hom ((Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom c)
    have hAff_D : IsAffineOpen D_α :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_N (MvPolynomial.X α) hXα zero_lt_one
    let e_spec := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X α) hXα zero_lt_one
    let e_away := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one
    have he_spec : e_spec.hom = D_α.toSpecΓ ≫ Spec.map e_away.hom := by
      rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
      rfl
    have h_lhs := h_toSpecΓ_toSpec D_α p_hom
    have h_rhs : D_α.ι ≫ p_hom =
        D_α.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom 𝒜_N
          (Submonoid.powers (MvPolynomial.X α))).comp (algebraMap k ↥(𝒜_N 0))) ≫ e_away.hom) := by
      have hj : D_α.ι = e_spec.hom ≫ AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) hXα zero_lt_one := by
        dsimp [e_spec, D_α]
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
      dsimp [p_hom]
      rw [hj, Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, he_spec,
        Category.assoc, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h_eq_spec : Spec.map ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ p_hom.appLE ⊤ D_α le_top) =
        Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom 𝒜_N
          (Submonoid.powers (MvPolynomial.X α))).comp (algebraMap k ↥(𝒜_N 0))) ≫ e_away.hom) := by
      have h_both := h_lhs.trans h_rhs
      rw [← IsAffineOpen.isoSpec_hom hAff_D] at h_both
      exact (cancel_epi hAff_D.isoSpec.hom).mp h_both
    have h_hom := congrArg Spec.preimage h_eq_spec
    rw [Spec.preimage_map, Spec.preimage_map] at h_hom
    exact (ConcreteCategory.congr_hom h_hom c).symm

  
  have hCov_Proj : ∀ (N : ℕ),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      (⨆ α : Fin (N + 1),
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α) :
          (weilProjectiveSpaceOver k N).left.Opens)) = ⊤ := by
    intro N
    let : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
      MvPolynomial.gradedAlgebra
    let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    change (⨆ α : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)) = ⊤
    apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top
    intro p hp
    let M_pos : MvPolynomial (Fin (N + 1)) k :=
      ∑ d ∈ p.support.erase 0, MvPolynomial.monomial d (p.coeff d)
    have h_factor : ∀ d ∈ p.support.erase 0,
        ∃ α : Fin (N + 1), MvPolynomial.monomial d (p.coeff d) =
          MvPolynomial.X α * MvPolynomial.monomial (d - Finsupp.single α 1) (p.coeff d) := by
      intro d hd
      have hd_ne : d ≠ 0 := Finset.ne_of_mem_erase hd
      have h_ex : ∃ α : Fin (N + 1), d α ≠ 0 := by
        by_contra! hall
        exact hd_ne (Finsupp.ext hall)
      obtain ⟨α, hα⟩ := h_ex
      refine ⟨α, ?_⟩
      have h_le : Finsupp.single α 1 ≤ d := Finsupp.single_le_iff.mpr (Nat.one_le_iff_ne_zero.mpr hα)
      have hd_eq : Finsupp.single α 1 + (d - Finsupp.single α 1) = d := add_tsub_cancel_of_le h_le
      rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, hd_eq, one_mul]
    have hM_span : M_pos ∈ Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) k)) := by
      refine Submodule.sum_mem _ fun d hd => ?_
      obtain ⟨α, h_eq⟩ := h_factor d hd
      rw [h_eq]
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨α, rfl⟩)
    have hM_irrel : M_pos ∈ (HomogeneousIdeal.irrelevant 𝒜_N).toIdeal := by
      refine Submodule.sum_mem _ fun d hd => ?_
      obtain ⟨α, h_eq⟩ := h_factor d hd
      rw [h_eq]
      have hX_irrel : (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈
          (HomogeneousIdeal.irrelevant 𝒜_N).toIdeal :=
        HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_N zero_lt_one (MvPolynomial.isHomogeneous_X k α)
      exact Ideal.mul_mem_right _ _ hX_irrel
    have hp_decomp : p = MvPolynomial.C (p.coeff 0) + M_pos := by
      conv_lhs => rw [MvPolynomial.as_sum p]
      by_cases h0 : (0 : Fin (N + 1) →₀ ℕ) ∈ p.support
      · rw [← Finset.add_sum_erase _ _ h0, MvPolynomial.monomial_zero']
      · have hc0 : p.coeff 0 = 0 := MvPolynomial.notMem_support_iff.mp h0
        rw [hc0, map_zero, zero_add]
        dsimp [M_pos]
        rw [Finset.erase_eq_of_notMem h0]
    have hC_irrel : (MvPolynomial.C (p.coeff 0) : MvPolynomial (Fin (N + 1)) k) ∈
        HomogeneousIdeal.irrelevant 𝒜_N := by
      change (MvPolynomial.C (p.coeff 0) : MvPolynomial (Fin (N + 1)) k) ∈
        (HomogeneousIdeal.irrelevant 𝒜_N).toIdeal
      have hsub : p - M_pos = MvPolynomial.C (p.coeff 0) := by
        conv_lhs => rw [hp_decomp]
        exact add_sub_cancel_right _ _
      rw [← hsub]
      exact Submodule.sub_mem _ hp hM_irrel
    have hC_zero : (MvPolynomial.C (p.coeff 0) : MvPolynomial (Fin (N + 1)) k) = 0 := by
      have hproj0 := (HomogeneousIdeal.mem_irrelevant_iff 𝒜_N _).mp hC_irrel
      have hC_mem0 : (MvPolynomial.C (p.coeff 0) : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 0 :=
        MvPolynomial.isHomogeneous_C _ _
      have hproj_same : GradedRing.proj 𝒜_N 0
          (MvPolynomial.C (p.coeff 0) : MvPolynomial (Fin (N + 1)) k) =
          MvPolynomial.C (p.coeff 0) :=
        DirectSum.decompose_of_mem_same 𝒜_N hC_mem0
      exact hproj_same.symm.trans hproj0
    rw [hp_decomp, hC_zero, zero_add]
    exact hM_span

  
  have hBasic_Proj : ∀ (N : ℕ)
      (W_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (ι_W : W_ov ⟶ weilProjectiveSpaceOver k N)
      (α : Fin (N + 1))
      (hXα : (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
      (F : MvPolynomial (Fin (N + 1)) k)
      (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      let D_α : (weilProjectiveSpaceOver k N).left.Opens :=
        AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)
      let V_α : W_ov.left.Opens := (TopologicalSpace.Opens.map ι_W.left.base).obj D_α
      let ℓ_F : ↑(W_ov.left.presheaf.obj (Opposite.op V_α)) :=
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom ≫
          ι_W.left.app D_α).hom
          (HomogeneousLocalization.mk ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
      W_ov.left.basicOpen ℓ_F =
        V_α ⊓ (TopologicalSpace.Opens.map ι_W.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N F) := by
    intro N W_ov ι_W α hXα F hF
    let : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
      MvPolynomial.gradedAlgebra
    let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let P_sch : Scheme.{u} := AlgebraicGeometry.Proj 𝒜_N
    let ι_left : W_ov.left ⟶ P_sch := ι_W.left
    let D_α : P_sch.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)
    have hAff_D : IsAffineOpen D_α :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_N (MvPolynomial.X α) hXα zero_lt_one
    let e_spec := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X α) hXα zero_lt_one
    let e_away := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one
    let j_α := AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) hXα zero_lt_one
    let s_pow : Submonoid.powers (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) :=
      ⟨MvPolynomial.X α, 1, pow_one _⟩
    let x_F : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α) :=
      HomogeneousLocalization.mk ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α, hXα⟩, s_pow.2⟩
    let s_F : ↑(P_sch.presheaf.obj (Opposite.op D_α)) := e_away.hom.hom x_F
    change W_ov.left.basicOpen ((ι_left.app D_α).hom s_F) =
      (TopologicalSpace.Opens.map ι_left.base).obj D_α ⊓
        (TopologicalSpace.Opens.map ι_left.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜_N F)
    rw [← Scheme.preimage_basicOpen]
    suffices hP_eq : P_sch.basicOpen s_F = D_α ⊓ AlgebraicGeometry.Proj.basicOpen 𝒜_N F by
      change (TopologicalSpace.Opens.map ι_left.base).obj (P_sch.basicOpen s_F) = _
      rw [hP_eq]
      rfl
    have hj_eq : j_α = Spec.map e_away.inv ≫ hAff_D.fromSpec := by
      have he_spec : e_spec.hom = hAff_D.isoSpec.hom ≫ Spec.map e_away.hom := by
        rw [IsAffineOpen.isoSpec_hom, AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
        rfl
      have he_inv : e_spec.inv = Spec.map e_away.inv ≫ hAff_D.isoSpec.inv := by
        apply (cancel_epi e_spec.hom).mp
        rw [e_spec.hom_inv_id, he_spec, Category.assoc, ← Category.assoc (Spec.map e_away.hom),
          ← Spec.map_comp, e_away.inv_hom_id, Spec.map_id, Category.id_comp, hAff_D.isoSpec.hom_inv_id]
      dsimp [j_α, e_spec, D_α]
      rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι, he_inv, Category.assoc]
      rfl
    have hj_lhs : (TopologicalSpace.Opens.map j_α.base).obj (P_sch.basicOpen s_F) =
        PrimeSpectrum.basicOpen x_F := by
      rw [hj_eq]
      change (TopologicalSpace.Opens.map (Spec.map e_away.inv).base).obj
        ((TopologicalSpace.Opens.map hAff_D.fromSpec.base).obj (P_sch.basicOpen s_F)) = _
      rw [hAff_D.fromSpec_preimage_basicOpen]
      have h_inv_s : e_away.inv.hom s_F = x_F :=
        ConcreteCategory.congr_hom e_away.hom_inv_id x_F
      ext q
      change s_F ∉ Ideal.comap e_away.inv.hom q.asIdeal ↔ x_F ∉ q.asIdeal
      rw [Ideal.mem_comap, h_inv_s]
    have hj_rhs : (TopologicalSpace.Opens.map j_α.base).obj
        (D_α ⊓ AlgebraicGeometry.Proj.basicOpen 𝒜_N F) = PrimeSpectrum.basicOpen x_F := by
      have hj_D : (TopologicalSpace.Opens.map j_α.base).obj D_α = ⊤ := by
        ext q
        refine ⟨fun _ => trivial, fun _ => ?_⟩
        dsimp [j_α, D_α]
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
        exact (e_spec.inv.base q).2
      change (TopologicalSpace.Opens.map j_α.base).obj D_α ⊓
        (TopologicalSpace.Opens.map j_α.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜_N F) = _
      rw [hj_D, top_inf_eq,
        AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_N hXα zero_lt_one hF zero_lt_one]
      have hx_eq : HomogeneousLocalization.Away.isLocalizationElem hXα hF = x_F := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk]
        have hxF_val : x_F.val = Localization.mk F s_pow := HomogeneousLocalization.val_mk _
        rw [hxF_val]
        apply Localization.mk_eq_mk_iff.mpr
        apply Localization.r_of_eq
        simp [s_pow, pow_one]
      rw [hx_eq]
    ext p
    by_cases hp : p ∈ D_α
    · let d_pt : D_α.toScheme := ⟨p, hp⟩
      let q := e_spec.hom.base d_pt
      have h_jq : j_α.base q = p := by
        dsimp [j_α]
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
        change D_α.ι.base ((e_spec.hom ≫ e_spec.inv).base d_pt) = p
        rw [e_spec.hom_inv_id]
        rfl
      have h_iff := TopologicalSpace.Opens.ext_iff.mp (hj_lhs.trans hj_rhs.symm)
      have hq := Set.ext_iff.mp h_iff q
      change p ∈ P_sch.basicOpen s_F ↔ p ∈ D_α ∧ p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N F
      rw [← h_jq] at *
      exact hq
    · constructor
      · intro hmem
        exact absurd (P_sch.basicOpen_le s_F hmem) hp
      · intro hmem
        exact absurd hmem.1 hp

  
  have hLin_Proj : ∀ (α : Fin (M + 1))
      (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
      (hLu : L 0 + MvPolynomial.C u_val * L 1 ∈ 𝒜_M 1)
      (U_Z : Z_bar.left.Opens)
      (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α))),
      let D_α := AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)
      let mk_sec := fun (F : MvPolynomial (Fin (M + 1)) k) (hF : F ∈ 𝒜_M 1) =>
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
          ι_bar.left.appLE D_α U_Z hUZ).hom
          (HomogeneousLocalization.mk ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
      mk_sec (L 0 + MvPolynomial.C u_val * L 1) hLu =
        mk_sec (L 0) (hL_homog 0) +
          (Z_bar.hom.appLE ⊤ U_Z le_top).hom
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom u_val) *
            mk_sec (L 1) (hL_homog 1) := by
    intro α hXα hLu U_Z hUZ
    let D_α : (weilProjectiveSpaceOver k M).left.Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)
    let s_pow : Submonoid.powers (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) :=
      ⟨MvPolynomial.X α, 1, pow_one _⟩
    let x_mk := fun (F : MvPolynomial (Fin (M + 1)) k) (hF : F ∈ 𝒜_M 1) =>
      (HomogeneousLocalization.mk ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α, hXα⟩, s_pow.2⟩ :
        HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α))
    have hx_lin : x_mk (L 0 + MvPolynomial.C u_val * L 1) hLu =
        x_mk (L 0) (hL_homog 0) +
          HomogeneousLocalization.fromZeroRingHom 𝒜_M (Submonoid.powers (MvPolynomial.X α))
            (algebraMap k ↥(𝒜_M 0) u_val) * x_mk (L 1) (hL_homog 1) := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_add, HomogeneousLocalization.val_mul]
      have h_mk_val : ∀ (F : MvPolynomial (Fin (M + 1)) k) (hF : F ∈ 𝒜_M 1),
          (x_mk F hF).val = Localization.mk F s_pow := fun F hF =>
        HomogeneousLocalization.val_mk _
      have h0_val : (HomogeneousLocalization.fromZeroRingHom 𝒜_M
          (Submonoid.powers (MvPolynomial.X α)) (algebraMap k ↥(𝒜_M 0) u_val)).val =
          Localization.mk (MvPolynomial.C u_val) 1 :=
        HomogeneousLocalization.val_mk _
      rw [h_mk_val, h_mk_val, h_mk_val, h0_val, Localization.mk_mul, one_mul,
        Localization.add_mk_self]
    change ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
        ι_bar.left.appLE D_α U_Z hUZ).hom (x_mk (L 0 + MvPolynomial.C u_val * L 1) hLu) = _
    rw [hx_lin, map_add, map_mul]
    congr 2
    change (ι_bar.left.appLE D_α U_Z hUZ).hom
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom.hom _) = _
    rw [h_proj_scalar M α hXα u_val]
    have hcomp := Scheme.Hom.appLE_comp_appLE ι_bar.left (weilProjectiveSpaceOver k M).hom ⊤ D_α U_Z le_top hUZ
    have hw_over : ι_bar.left ≫ (weilProjectiveSpaceOver k M).hom = Z_bar.hom :=
      CategoryTheory.Over.w ι_bar
    have h_app := ConcreteCategory.congr_hom hcomp
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom u_val)
    change (ι_bar.left.appLE D_α U_Z hUZ).hom
      (((weilProjectiveSpaceOver k M).hom.appLE ⊤ D_α le_top).hom _) =
      ((ι_bar.left ≫ (weilProjectiveSpaceOver k M).hom).appLE ⊤ U_Z _).hom _ at h_app
    rw [h_app]
    congr 1
    rw [hw_over]

  
  have hDehom_P1 : ∀ (b : Fin 2)
      (hTb : (MvPolynomial.X b : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1),
      let D_b : P₁.left.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b)
      let t_b : Fin 2 → ↑(P₁.left.presheaf.obj (Opposite.op D_b)) := fun a =>
        (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b) hTb zero_lt_one).hom.hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X a, MvPolynomial.isHomogeneous_X k a⟩,
              ⟨MvPolynomial.X b, hTb⟩, ⟨1, pow_one _⟩⟩)
      t_b b = 1 ∧
      ∃ e_b : Polynomial k ≃+* ↑(P₁.left.presheaf.obj (Opposite.op D_b)),
        (∀ c : k,
          e_b (Polynomial.C c) =
            (P₁.hom.appLE ⊤ D_b le_top).hom
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom c)) ∧
        e_b Polynomial.X = t_b (Fin.rev b) := by
    intro b hTb
    let D_b : P₁.left.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b)
    let e_away := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b) hTb zero_lt_one
    let sb_one : Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin 2) k) :=
      ⟨MvPolynomial.X b, 1, pow_one _⟩
    let t_b : Fin 2 → ↑(P₁.left.presheaf.obj (Opposite.op D_b)) := fun a =>
      e_away.hom.hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X a, MvPolynomial.isHomogeneous_X k a⟩,
            ⟨MvPolynomial.X b, hTb⟩, sb_one.2⟩)
    refine ⟨?_, ?_⟩
    · have h1_away : (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X b, MvPolynomial.isHomogeneous_X k b⟩,
            ⟨MvPolynomial.X b, hTb⟩, sb_one.2⟩ :
          HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b)) = 1 := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_one]
        exact Localization.mk_self sb_one
      change e_away.hom.hom _ = 1
      rw [h1_away, map_one]
    · let x_rev : HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) :=
        HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X (Fin.rev b), MvPolynomial.isHomogeneous_X k (Fin.rev b)⟩,
            ⟨MvPolynomial.X b, hTb⟩, sb_one.2⟩
      let κ_0 : k →+* HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜_1
          (Submonoid.powers (MvPolynomial.X b))).comp (algebraMap k ↥(𝒜_1 0))
      let φ_fwd : Polynomial k →+* HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) :=
        Polynomial.eval₂RingHom κ_0 x_rev
      let dehom : MvPolynomial (Fin 2) k →+* Polynomial k :=
        MvPolynomial.eval₂Hom Polynomial.C (fun a : Fin 2 => if a = b then 1 else Polynomial.X)
      have hdehom_pow : ∀ y : Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin 2) k),
          dehom y.1 = 1 := by
        rintro ⟨_, m, rfl⟩
        simp [dehom]
      have hdehom_unit : ∀ y : Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin 2) k),
          IsUnit (dehom y.1) := fun y => by
        rw [hdehom_pow y]
        exact isUnit_one
      let ψ_loc : Localization.Away (MvPolynomial.X b : MvPolynomial (Fin 2) k) →+* Polynomial k :=
        IsLocalization.lift hdehom_unit
      have hψ_mk : ∀ (p : MvPolynomial (Fin 2) k)
          (y : Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin 2) k)),
          ψ_loc (Localization.mk p y) = dehom p := by
        intro p y
        rw [Localization.mk_eq_mk']
        have hmul := IsLocalization.mk'_spec'
          (Localization.Away (MvPolynomial.X b : MvPolynomial (Fin 2) k)) p y
        have hmap := congrArg ψ_loc hmul
        rw [map_mul, IsLocalization.lift_eq, IsLocalization.lift_eq, hdehom_pow y, one_mul] at hmap
        exact hmap
      let val_hom : HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) →+*
          Localization.Away (MvPolynomial.X b : MvPolynomial (Fin 2) k) :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := HomogeneousLocalization.val_mul
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := HomogeneousLocalization.val_add }
      let φ_bwd : HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) →+* Polynomial k :=
        ψ_loc.comp val_hom
      have h_rev_ne : Fin.rev b ≠ b := by fin_cases b <;> decide
      have h_left_inv : φ_bwd.comp φ_fwd = RingHom.id (Polynomial k) := by
        apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun c => ?_
          simp only [RingHom.comp_apply, RingHom.id_apply, φ_fwd, Polynomial.coe_eval₂RingHom,
            Polynomial.eval₂_C]
          have h0_val : (κ_0 c).val = Localization.mk (MvPolynomial.C c) 1 :=
            HomogeneousLocalization.val_mk _
          change ψ_loc (κ_0 c).val = Polynomial.C c
          rw [h0_val, hψ_mk]
          simp [dehom]
        · simp only [RingHom.comp_apply, RingHom.id_apply, φ_fwd, Polynomial.coe_eval₂RingHom,
            Polynomial.eval₂_X]
          have hx_val : x_rev.val = Localization.mk (MvPolynomial.X (Fin.rev b)) sb_one :=
            HomogeneousLocalization.val_mk _
          change ψ_loc x_rev.val = Polynomial.X
          rw [hx_val, hψ_mk]
          simp [dehom, h_rev_ne]
      have h_right_inv : ∀ z : HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b),
          φ_fwd (φ_bwd z) = z := by
        intro z
        obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_1 hTb z
        apply HomogeneousLocalization.val_injective
        let sb_n : Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin 2) k) :=
          ⟨(MvPolynomial.X b) ^ n, n, rfl⟩
        have hz_val : (HomogeneousLocalization.Away.mk 𝒜_1 hTb n p hp).val =
            Localization.mk p sb_n :=
          HomogeneousLocalization.Away.val_mk 𝒜_1 n hTb p hp
        have h_bwd_p : φ_bwd (HomogeneousLocalization.Away.mk 𝒜_1 hTb n p hp) = dehom p := by
          change ψ_loc (HomogeneousLocalization.Away.mk 𝒜_1 hTb n p hp).val = dehom p
          rw [hz_val, hψ_mk]
        rw [h_bwd_p, hz_val]
        let θ : MvPolynomial (Fin 2) k →+* Localization.Away (MvPolynomial.X b : MvPolynomial (Fin 2) k) :=
          (val_hom.comp φ_fwd).comp dehom
        change θ p = Localization.mk p sb_n
        have hθ_C : ∀ c : k, θ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
          intro c
          change HomogeneousLocalization.val (φ_fwd (dehom (MvPolynomial.C c))) = _
          have hdc : dehom (MvPolynomial.C c) = Polynomial.C c := by simp [dehom]
          have hfc : φ_fwd (Polynomial.C c) = κ_0 c := by simp [φ_fwd]
          rw [hdc, hfc]
          exact HomogeneousLocalization.val_mk _
        have hθ_X : ∀ a : Fin 2, θ (MvPolynomial.X a) =
            Localization.mk (MvPolynomial.X a) sb_one := by
          intro a
          change HomogeneousLocalization.val (φ_fwd (dehom (MvPolynomial.X a))) = _
          by_cases hab : a = b
          · subst hab
            have hdb : dehom (MvPolynomial.X a) = 1 := by simp [dehom]
            rw [hdb, map_one, HomogeneousLocalization.val_one]
            exact (Localization.mk_self sb_one).symm
          · have ha_rev : a = Fin.rev b := by
              fin_cases a <;> fin_cases b <;> simp_all [Fin.rev]
            have hda : dehom (MvPolynomial.X a) = Polynomial.X := by simp [dehom, hab]
            have hfx : φ_fwd Polynomial.X = x_rev := by simp [φ_fwd]
            rw [hda, hfx]
            have hxr : x_rev.val = Localization.mk (MvPolynomial.X (Fin.rev b)) sb_one :=
              HomogeneousLocalization.val_mk _
            rw [hxr, ha_rev]
        let mk_n : MvPolynomial (Fin 2) k →+ Localization.Away (MvPolynomial.X b : MvPolynomial (Fin 2) k) :=
          { toFun := fun q => Localization.mk q sb_n
            map_zero' := Localization.mk_zero _
            map_add' := fun q₁ q₂ => (Localization.add_mk_self q₁ _ q₂).symm }
        change θ p = mk_n p
        conv_lhs => rw [MvPolynomial.as_sum p]
        conv_rhs => rw [MvPolynomial.as_sum p]
        rw [map_sum, map_sum]
        refine Finset.sum_congr rfl fun d hd => ?_
        have hd_deg : d 0 + d 1 = n := by
          rw [Nat.nsmul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule] at hp
          have hcoeff : p.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
          have hsum := hp hcoeff
          change (d.sum fun _ m => m • 1) = n at hsum
          rw [Finsupp.sum_fintype d (fun _ m => m • (1 : ℕ)) (fun _ => zero_smul _ _),
            Fin.sum_univ_two] at hsum
          simpa using hsum
        have hmon_eq : MvPolynomial.monomial d (p.coeff d) =
            MvPolynomial.C (p.coeff d) *
              (MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1) := by
          rw [MvPolynomial.monomial_eq,
            Finsupp.prod_fintype d (fun i e => MvPolynomial.X i ^ e) (fun _ => pow_zero _),
            Fin.prod_univ_two]
        rw [hmon_eq, map_mul, map_mul, map_pow, map_pow, hθ_C, hθ_X 0, hθ_X 1,
          Localization.mk_pow, Localization.mk_pow, Localization.mk_mul, Localization.mk_mul]
        change Localization.mk _ _ = Localization.mk _ sb_n
        apply Localization.mk_eq_mk_iff.mpr
        apply Localization.r_of_eq
        simp only [sb_one, sb_n, Submonoid.coe_mul, one_mul, SubmonoidClass.coe_pow]
        rw [← pow_add, hd_deg]
      let e_poly_away : Polynomial k ≃+* HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) :=
        RingEquiv.ofBijective φ_fwd
          ⟨fun p₁ p₂ hp => by
            have := congrArg φ_bwd hp
            simpa only [← RingHom.comp_apply, h_left_inv, RingHom.id_apply] using this,
           fun z => ⟨φ_bwd z, h_right_inv z⟩⟩
      let e_b : Polynomial k ≃+* ↑(P₁.left.presheaf.obj (Opposite.op D_b)) :=
        e_poly_away.trans e_away.commRingCatIsoToRingEquiv
      refine ⟨e_b, ?_, ?_⟩
      · intro c
        change e_away.hom.hom (φ_fwd (Polynomial.C c)) = _
        have hfc : φ_fwd (Polynomial.C c) = κ_0 c := by simp [φ_fwd]
        rw [hfc]
        exact h_proj_scalar 1 b hTb c
      · change e_away.hom.hom (φ_fwd Polynomial.X) = t_b (Fin.rev b)
        have hfx : φ_fwd Polynomial.X = x_rev := by simp [φ_fwd]
        rw [hfx]

  
  have hChart_iso : ∀ (P₁_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (Z_tilde_sch : Scheme.{u})
      (ι_Z_Q₁ : Z_tilde_sch ⟶ Limits.pullback Z_bar.hom P₁_ov.hom)
      (hCl_ZQ₁ : IsClosedImmersion ι_Z_Q₁)
      (D₁ : Fin 2 → P₁_ov.left.Opens)
      (hAff_D₁ : ∀ b : Fin 2, IsAffineOpen (D₁ b))
      (hCov_D₁ : D₁ 0 ⊔ D₁ 1 = ⊤)
      (t_sec : ∀ b : Fin 2, Fin 2 → ↑(P₁_ov.left.presheaf.obj (Opposite.op (D₁ b))))
      (ht_diag : ∀ b : Fin 2, t_sec b b = 1)
      (ht_basic : ∀ b : Fin 2, P₁_ov.left.basicOpen (t_sec b (Fin.rev b)) = D₁ b ⊓ D₁ (Fin.rev b))
      (e_P1 : ∀ b : Fin 2, Polynomial k ≃+* ↑(P₁_ov.left.presheaf.obj (Opposite.op (D₁ b))))
      (he_C : ∀ (b : Fin 2) (c : k),
        e_P1 b (Polynomial.C c) =
          (P₁_ov.hom.appLE ⊤ (D₁ b) le_top).hom ((Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom c))
      (he_X : ∀ b : Fin 2, e_P1 b Polynomial.X = t_sec b (Fin.rev b))
      (V : Z_bar.left.Opens) (hAff_V : IsAffineOpen V)
      (ℓ : Fin 2 → ↑(Z_bar.left.presheaf.obj (Opposite.op V)))
      (r : Fin 2) (hUnit_r : IsUnit (ℓ r))
      (hAff_W : ∀ b : Fin 2,
        IsAffineOpen ((TopologicalSpace.Opens.map (Limits.pullback.fst Z_bar.hom P₁_ov.hom).base).obj V ⊓
          (TopologicalSpace.Opens.map (Limits.pullback.snd Z_bar.hom P₁_ov.hom).base).obj (D₁ b)))
      (hKer_W : ∀ b : Fin 2,
        let pZ := Limits.pullback.fst Z_bar.hom P₁_ov.hom
        let pP := Limits.pullback.snd Z_bar.hom P₁_ov.hom
        let W_b := (TopologicalSpace.Opens.map pZ.base).obj V ⊓
          (TopologicalSpace.Opens.map pP.base).obj (D₁ b)
        RingHom.ker (ι_Z_Q₁.app W_b).hom =
          Ideal.span {∑ a : Fin 2,
            (pZ.appLE V W_b inf_le_left).hom (ℓ a) *
            (pP.appLE (D₁ b) W_b inf_le_right).hom (t_sec b a)}),
      IsIso ((ι_Z_Q₁ ≫ Limits.pullback.fst Z_bar.hom P₁_ov.hom) ∣_ V) := by
    intro P₁_ov Z_tilde_sch ι_Z_Q₁ hCl_ZQ₁ D₁ hAff_D₁ hCov_D₁ t_sec ht_diag ht_basic e_P1 he_C he_X
      V hAff_V ℓ r hUnit_r hAff_W hKer_W
    have : IsClosedImmersion ι_Z_Q₁ := hCl_ZQ₁
    let Q_ov := Limits.pullback Z_bar.hom P₁_ov.hom
    let pZ := Limits.pullback.fst Z_bar.hom P₁_ov.hom
    let pP := Limits.pullback.snd Z_bar.hom P₁_ov.hom
    let π := ι_Z_Q₁ ≫ pZ
    let A := ↑(Z_bar.left.presheaf.obj (Opposite.op V))
    let W : Fin 2 → Q_ov.Opens := fun b =>
      (TopologicalSpace.Opens.map pZ.base).obj V ⊓
        (TopologicalSpace.Opens.map pP.base).obj (D₁ b)
    let Z_op : Fin 2 → Z_tilde_sch.Opens := fun b =>
      (TopologicalSpace.Opens.map ι_Z_Q₁.base).obj (W b)
    have hAff_Z : ∀ b : Fin 2, IsAffineOpen (Z_op b) := fun b => (hAff_W b).preimage ι_Z_Q₁
    have hCov_r : D₁ r ⊔ D₁ (Fin.rev r) = ⊤ := by
      fin_cases r <;> simpa [Fin.rev, sup_comm] using hCov_D₁
    have hPre_sup : (TopologicalSpace.Opens.map π.base).obj V = Z_op r ⊔ Z_op (Fin.rev r) := by
      ext z
      have hP_top : pP.base (ι_Z_Q₁.base z) ∈ (⊤ : P₁_ov.left.Opens) := trivial
      rw [← hCov_r] at hP_top
      change pZ.base (ι_Z_Q₁.base z) ∈ V ↔
        (pZ.base (ι_Z_Q₁.base z) ∈ V ∧ pP.base (ι_Z_Q₁.base z) ∈ D₁ r) ∨
        (pZ.base (ι_Z_Q₁.base z) ∈ V ∧ pP.base (ι_Z_Q₁.base z) ∈ D₁ (Fin.rev r))
      rcases hP_top with hr | hrev <;> tauto
    have hFin2_sum : ∀ {M₀ : Type u} [AddCommMonoid M₀] (b : Fin 2) (f : Fin 2 → M₀),
        ∑ a : Fin 2, f a = f b + f (Fin.rev b) := by
      intro M₀ _ b f
      fin_cases b <;> simp [Fin.sum_univ_two, Fin.rev, add_comm]
    obtain ⟨u_r, hu_r⟩ := hUnit_r
    have hZ_le : Z_op r ≤ Z_op (Fin.rev r) := by
      let ψ_r := (ι_Z_Q₁.app (W r)).hom
      let α_Z := (pZ.appLE V (W r) inf_le_left).hom
      let α_P := (pP.appLE (D₁ r) (W r) inf_le_right).hom
      let g_r := ∑ a : Fin 2, α_Z (ℓ a) * α_P (t_sec r a)
      have hg_ker : ψ_r g_r = 0 := by
        apply RingHom.mem_ker.mp
        rw [hKer_W r]
        exact Ideal.subset_span rfl
      have hg_eq : g_r = α_Z (u_r : A) + α_Z (ℓ (Fin.rev r)) * α_P (t_sec r (Fin.rev r)) := by
        dsimp [g_r]
        rw [hFin2_sum r (fun a => α_Z (ℓ a) * α_P (t_sec r a)), ht_diag r, map_one, mul_one, hu_r]
      let τ_Z := ψ_r (α_P (t_sec r (Fin.rev r)))
      let μ_Z := ψ_r (α_Z (-(↑u_r⁻¹ : A) * ℓ (Fin.rev r)))
      have h_unit_τ : IsUnit τ_Z := by
        rw [isUnit_iff_exists_inv]
        refine ⟨μ_Z, ?_⟩
        have h1 : 1 - τ_Z * μ_Z = ψ_r (α_Z (↑u_r⁻¹ : A) * g_r) := by
          dsimp [τ_Z, μ_Z]
          rw [hg_eq]
          have hu1 : α_Z (↑u_r⁻¹ : A) * α_Z (u_r : A) = 1 := by
            rw [← map_mul, u_r.inv_mul, map_one]
          have hu2 : α_Z (-(↑u_r⁻¹ : A) * ℓ (Fin.rev r)) =
              - (α_Z (↑u_r⁻¹ : A) * α_Z (ℓ (Fin.rev r))) := by
            rw [neg_mul, map_neg, map_mul]
          rw [hu2, mul_add, hu1, map_add, map_one, map_mul, map_mul, map_neg, map_mul]
          ring
        rw [map_mul, hg_ker, mul_zero] at h1
        exact (sub_eq_zero.mp h1).symm
      have h_bo_τ : Z_tilde_sch.basicOpen τ_Z = Z_op r :=
        Z_tilde_sch.basicOpen_of_isUnit h_unit_τ
      rw [← h_bo_τ]
      dsimp [τ_Z, ψ_r]
      rw [← Scheme.preimage_basicOpen]
      have h_appLE_P : α_P (t_sec r (Fin.rev r)) =
          (Q_ov.presheaf.map
            (homOfLE (inf_le_right : W r ≤ (TopologicalSpace.Opens.map pP.base).obj (D₁ r))).op).hom
            ((pP.app (D₁ r)).hom (t_sec r (Fin.rev r))) := rfl
      rw [h_appLE_P, Q_ov.basicOpen_res, ← Scheme.preimage_basicOpen, ht_basic r]
      intro z hz
      exact ⟨hz.1.1, hz.2.2⟩
    let b' : Fin 2 := Fin.rev r
    have hb'_rev : Fin.rev b' = r := Fin.rev_rev r
    let W' : Q_ov.Opens := W b'
    let Z' : Z_tilde_sch.Opens := Z_op b'
    have hEq_Z : (TopologicalSpace.Opens.map π.base).obj V = Z' := by
      rw [hPre_sup]
      exact sup_eq_right.mpr hZ_le
    let R_k := CommRingCat.of k
    let R_V := Z_bar.left.presheaf.obj (Opposite.op V)
    let R_P := P₁_ov.left.presheaf.obj (Opposite.op (D₁ b'))
    let c_V : R_k ⟶ R_V := (Scheme.ΓSpecIso R_k).inv ≫ Z_bar.hom.appLE ⊤ V le_top
    let c_P : R_k ⟶ R_P := (Scheme.ΓSpecIso R_k).inv ≫ P₁_ov.hom.appLE ⊤ (D₁ b') le_top
    let inl_A : R_V ⟶ CommRingCat.of (Polynomial A) := CommRingCat.ofHom Polynomial.C
    let inr_P : R_P ⟶ CommRingCat.of (Polynomial A) :=
      CommRingCat.ofHom ((Polynomial.mapRingHom c_V.hom).comp (e_P1 b').symm.toRingHom)
    have h_inr_X : inr_P.hom (t_sec b' r) = Polynomial.X := by
      have hX_symm : (e_P1 b').symm (t_sec b' r) = Polynomial.X :=
        (e_P1 b').injective (by rw [(e_P1 b').apply_symm_apply, he_X b', hb'_rev])
      change Polynomial.map c_V.hom ((e_P1 b').symm (t_sec b' r)) = Polynomial.X
      rw [hX_symm, Polynomial.map_X]
    have hPush_poly : IsPushout c_V c_P inl_A inr_P := by
      have hw_poly : c_V ≫ inl_A = c_P ≫ inr_P := by
        apply CommRingCat.hom_ext
        refine RingHom.ext fun x => ?_
        have hx : (e_P1 b').symm (c_P.hom x) = Polynomial.C x :=
          (e_P1 b').injective (by rw [(e_P1 b').apply_symm_apply]; exact (he_C b' x).symm)
        change Polynomial.C (c_V.hom x) = Polynomial.map c_V.hom ((e_P1 b').symm (c_P.hom x))
        rw [hx, Polynomial.map_C]
      refine ⟨⟨hw_poly⟩, ⟨Limits.PushoutCocone.IsColimit.mk _
        (fun s => CommRingCat.ofHom (Polynomial.eval₂RingHom s.inl.hom (s.inr.hom (t_sec b' r))))
        (fun s => by
          apply CommRingCat.hom_ext
          refine RingHom.ext fun a => ?_
          simp [inl_A])
        (fun s => by
          ext y
          obtain ⟨p, rfl⟩ := (e_P1 b').surjective y
          have h_hom_eq : (Polynomial.eval₂RingHom s.inl.hom (s.inr.hom (t_sec b' r))).comp
              (Polynomial.mapRingHom c_V.hom) = s.inr.hom.comp (e_P1 b').toRingHom := by
            apply Polynomial.ringHom_ext'
            · refine RingHom.ext fun x => ?_
              simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
                Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, RingEquiv.toRingHom_eq_coe,
                RingHom.coe_coe]
              rw [he_C b' x]
              exact ConcreteCategory.congr_hom s.condition x
            · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
                Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, RingEquiv.toRingHom_eq_coe,
                RingHom.coe_coe, he_X b', hb'_rev]
          simp only [inr_P, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
            RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.symm_apply_apply]
          exact RingHom.congr_fun h_hom_eq p)
        (fun s m hm₁ hm₂ => by
          apply CommRingCat.hom_ext
          simp only [CommRingCat.hom_ofHom]
          apply Polynomial.ringHom_ext'
          · refine RingHom.ext fun a => ?_
            simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
            exact ConcreteCategory.congr_hom hm₁ a
          · simp only [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
            rw [← h_inr_X]
            exact ConcreteCategory.congr_hom hm₂ (t_sec b' r))⟩⟩
    have hPb_poly_spec := isPullback_SpecMap_of_isPushout _ _ _ _ hPush_poly
    have hPb_W' : IsPullback (pZ.resLE V W' inf_le_left) (pP.resLE (D₁ b') W' inf_le_right)
        (V.ι ≫ Z_bar.hom) ((D₁ b').ι ≫ P₁_ov.hom) :=
      h_pb_resLE (IsPullback.of_hasPullback Z_bar.hom P₁_ov.hom) V (D₁ b') W'
        inf_le_left inf_le_right (fun _ h1 h2 => ⟨h1, h2⟩) (𝟙 (Spec R_k))
        (V.ι ≫ Z_bar.hom) ((D₁ b').ι ≫ P₁_ov.hom) (Category.comp_id _) (Category.comp_id _)
    have hPb_W'_spec : IsPullback
        (pZ.resLE V W' inf_le_left ≫ hAff_V.isoSpec.hom)
        (pP.resLE (D₁ b') W' inf_le_right ≫ (hAff_D₁ b').isoSpec.hom)
        (Spec.map c_V) (Spec.map c_P) :=
      h_pb_map_isos hPb_W' hAff_V.isoSpec (hAff_D₁ b').isoSpec (Iso.refl (Spec R_k))
        (by
          change hAff_V.isoSpec.hom ≫ Spec.map c_V = (V.ι ≫ Z_bar.hom) ≫ 𝟙 (Spec R_k)
          rw [Category.comp_id, IsAffineOpen.isoSpec_hom]
          exact h_toSpecΓ_toSpec V Z_bar.hom)
        (by
          change (hAff_D₁ b').isoSpec.hom ≫ Spec.map c_P = ((D₁ b').ι ≫ P₁_ov.hom) ≫ 𝟙 (Spec R_k)
          rw [Category.comp_id, IsAffineOpen.isoSpec_hom]
          exact h_toSpecΓ_toSpec (D₁ b') P₁_ov.hom)
    let α_W : W'.toScheme ≅ Spec (CommRingCat.of (Polynomial A)) :=
      IsPullback.isoIsPullback _ _ hPb_W'_spec hPb_poly_spec
    let γ_W : Spec (CommRingCat.of (Polynomial A)) ≅ Spec (Q_ov.presheaf.obj (Opposite.op W')) :=
      α_W.symm ≪≫ (hAff_W b').isoSpec
    let e_W_cat : CommRingCat.of (Polynomial A) ≅ Q_ov.presheaf.obj (Opposite.op W') :=
      { hom := Spec.preimage γ_W.inv
        inv := Spec.preimage γ_W.hom
        hom_inv_id := by rw [← Spec.preimage_comp, γ_W.hom_inv_id, Spec.preimage_id]
        inv_hom_id := by rw [← Spec.preimage_comp, γ_W.inv_hom_id, Spec.preimage_id] }
    let e_W : Polynomial A ≃+* ↑(Q_ov.presheaf.obj (Opposite.op W')) :=
      e_W_cat.commRingCatIsoToRingEquiv
    have he_W_inl : inl_A ≫ e_W_cat.hom = pZ.appLE V W' inf_le_left := by
      have h1 : α_W.hom ≫ Spec.map inl_A = pZ.resLE V W' inf_le_left ≫ hAff_V.isoSpec.hom :=
        IsPullback.isoIsPullback_hom_fst _ _ hPb_W'_spec hPb_poly_spec
      rw [IsAffineOpen.isoSpec_hom, ← Scheme.Opens.toSpecΓ_SpecMap_appLE,
        ← IsAffineOpen.isoSpec_hom (hAff_W b')] at h1
      have h2 : γ_W.inv ≫ Spec.map inl_A = Spec.map (pZ.appLE V W' inf_le_left) := by
        dsimp [γ_W]
        rw [Category.assoc, h1, Iso.inv_hom_id_assoc]
      have h3 := congrArg Spec.preimage h2
      rwa [Spec.preimage_comp, Spec.preimage_map, Spec.preimage_map] at h3
    have he_W_inr : inr_P ≫ e_W_cat.hom = pP.appLE (D₁ b') W' inf_le_right := by
      have h1 : α_W.hom ≫ Spec.map inr_P =
          pP.resLE (D₁ b') W' inf_le_right ≫ (hAff_D₁ b').isoSpec.hom :=
        IsPullback.isoIsPullback_hom_snd _ _ hPb_W'_spec hPb_poly_spec
      rw [IsAffineOpen.isoSpec_hom, ← Scheme.Opens.toSpecΓ_SpecMap_appLE,
        ← IsAffineOpen.isoSpec_hom (hAff_W b')] at h1
      have h2 : γ_W.inv ≫ Spec.map inr_P = Spec.map (pP.appLE (D₁ b') W' inf_le_right) := by
        dsimp [γ_W]
        rw [Category.assoc, h1, Iso.inv_hom_id_assoc]
      have h3 := congrArg Spec.preimage h2
      rwa [Spec.preimage_comp, Spec.preimage_map, Spec.preimage_map] at h3
    have he_W_C : ∀ a : A, e_W (Polynomial.C a) = (pZ.appLE V W' inf_le_left).hom a := fun a =>
      ConcreteCategory.congr_hom he_W_inl a
    have he_W_X : e_W Polynomial.X = (pP.appLE (D₁ b') W' inf_le_right).hom (t_sec b' r) := by
      have h := ConcreteCategory.congr_hom he_W_inr (t_sec b' r)
      change e_W (inr_P.hom (t_sec b' r)) = _ at h
      rwa [h_inr_X] at h
    let ψ_Z := (ι_Z_Q₁.app W').hom
    have hSurj_ψ : Function.Surjective ψ_Z :=
      (isClosedImmersion_iff_isAffineHom.mp hCl_ZQ₁).2 W' (hAff_W b')
    let Φ : Polynomial A →+* ↑(Z_tilde_sch.presheaf.obj (Opposite.op Z')) :=
      ψ_Z.comp e_W.toRingHom
    have hSurj_Φ : Function.Surjective Φ := hSurj_ψ.comp e_W.surjective
    let c₀ : A := -(↑u_r⁻¹ : A) * ℓ b'
    let p₀ : Polynomial A := Polynomial.X - Polynomial.C c₀
    let q₀ : Polynomial A := Polynomial.C (ℓ b') + Polynomial.C (ℓ r) * Polynomial.X
    have he_W_q₀ : e_W q₀ = ∑ a : Fin 2,
        (pZ.appLE V W' inf_le_left).hom (ℓ a) *
        (pP.appLE (D₁ b') W' inf_le_right).hom (t_sec b' a) := by
      rw [hFin2_sum b' (fun a =>
          (pZ.appLE V W' inf_le_left).hom (ℓ a) *
          (pP.appLE (D₁ b') W' inf_le_right).hom (t_sec b' a)),
        hb'_rev, ht_diag b', map_one, mul_one,
        ← he_W_C (ℓ b'), ← he_W_C (ℓ r), ← he_W_X, ← map_mul, ← map_add]
    have hq₀_eq : q₀ = Polynomial.C (u_r : A) * p₀ := by
      dsimp [q₀, p₀, c₀]
      rw [← hu_r, mul_sub, ← Polynomial.C_mul]
      have h_ur : (u_r : A) * (-(↑u_r⁻¹ : A) * ℓ b') = - ℓ b' := by
        rw [← mul_assoc, mul_neg, u_r.mul_inv, neg_one_mul]
      rw [h_ur, Polynomial.C_neg, sub_neg_eq_add, add_comm]
    have hp₀_eq : p₀ = Polynomial.C (↑u_r⁻¹ : A) * q₀ := by
      rw [hq₀_eq, ← mul_assoc, ← Polynomial.C_mul, u_r.inv_mul, Polynomial.C_1, one_mul]
    have hSpan_eq : Ideal.span ({q₀} : Set (Polynomial A)) = Ideal.span ({p₀} : Set (Polynomial A)) := by
      apply le_antisymm
      · rw [Ideal.span_le, Set.singleton_subset_iff, hq₀_eq]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
      · rw [Ideal.span_le, Set.singleton_subset_iff, hp₀_eq]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
    have hKer_Φ : RingHom.ker Φ = Ideal.span ({p₀} : Set (Polynomial A)) := by
      ext p
      simp only [RingHom.mem_ker, Φ, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
      change e_W p ∈ RingHom.ker ψ_Z ↔ p ∈ Ideal.span {p₀}
      rw [hKer_W b', ← he_W_q₀, ← hSpan_eq, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
      constructor
      · rintro ⟨s, hs⟩
        refine ⟨e_W.symm s, e_W.injective ?_⟩
        rw [map_mul, e_W.apply_symm_apply]
        exact hs
      · rintro ⟨s, rfl⟩
        exact ⟨e_W s, map_mul e_W q₀ s⟩
    let θ : A →+* ↑(Z_tilde_sch.presheaf.obj (Opposite.op Z')) := Φ.comp Polynomial.C
    let ev : Polynomial A →+* A := Polynomial.eval₂RingHom (RingHom.id A) c₀
    have hSpan_ev : Ideal.span ({p₀} : Set (Polynomial A)) ≤ RingHom.ker ev := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      change ev p₀ = 0
      simp [ev, p₀]
    have hBij_θ : Function.Bijective θ := by
      refine ⟨?_, ?_⟩
      · intro a₁ a₂ ha
        have hsub : θ (a₁ - a₂) = 0 := by rw [map_sub, ha, sub_self]
        have hmem : Polynomial.C (a₁ - a₂) ∈ RingHom.ker Φ := hsub
        rw [hKer_Φ] at hmem
        have hev0 : ev (Polynomial.C (a₁ - a₂)) = 0 := hSpan_ev hmem
        have hev_id : ev (Polynomial.C (a₁ - a₂)) = a₁ - a₂ := by simp [ev]
        rw [hev_id] at hev0
        exact sub_eq_zero.mp hev0
      · intro z
        obtain ⟨p, rfl⟩ := hSurj_Φ z
        refine ⟨ev p, ?_⟩
        let J₀ : Ideal (Polynomial A) := Ideal.span ({p₀} : Set (Polynomial A))
        have h_quot_eq : Ideal.Quotient.mk J₀ =
            (Ideal.Quotient.mk J₀).comp (Polynomial.C.comp ev) := by
          apply Polynomial.ringHom_ext'
          · refine RingHom.ext fun a => ?_
            simp [ev]
          · simp only [RingHom.comp_apply, ev, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
            exact sub_eq_zero.mp (by
              rw [← map_sub]
              exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl))
        have h_mk_p : Ideal.Quotient.mk J₀ p = Ideal.Quotient.mk J₀ (Polynomial.C (ev p)) :=
          RingHom.congr_fun h_quot_eq p
        have h_diff_ker : p - Polynomial.C (ev p) ∈ RingHom.ker Φ := by
          rw [hKer_Φ]
          exact Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_sub, h_mk_p, sub_self])
        have hΦ_sub : Φ (p - Polynomial.C (ev p)) = 0 := h_diff_ker
        rw [map_sub] at hΦ_sub
        exact (sub_eq_zero.mp hΦ_sub).symm
    have h_appLE_π : π.appLE V Z' hEq_Z.ge = CommRingCat.ofHom θ := by
      have hcomp := Scheme.Hom.appLE_comp_appLE ι_Z_Q₁ pZ V W' Z' inf_le_left le_rfl
      rw [h_appLE_rfl ι_Z_Q₁ W'] at hcomp
      rw [← hcomp]
      ext a
      change ψ_Z ((pZ.appLE V W' inf_le_left).hom a) = ψ_Z (e_W (Polynomial.C a))
      rw [he_W_C a]
    have : IsIso (CommRingCat.ofHom θ) :=
      (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom θ)).mpr hBij_θ
    have : IsIso (π.appLE V Z' hEq_Z.ge) := by
      rw [h_appLE_π]
      infer_instance
    have h_app_π : π.app V ≫ Z_tilde_sch.presheaf.map (eqToHom hEq_Z.symm).op =
        π.appLE V Z' hEq_Z.ge := by
      rw [Scheme.Hom.appLE]
      congr 2
    have : IsIso (π.app V ≫ Z_tilde_sch.presheaf.map (eqToHom hEq_Z.symm).op) := by
      rw [h_app_π]
      infer_instance
    have : IsIso (π.app V) :=
      IsIso.of_isIso_comp_right (π.app V) (Z_tilde_sch.presheaf.map (eqToHom hEq_Z.symm).op)
    let preV : Z_tilde_sch.Opens := (TopologicalSpace.Opens.map π.base).obj V
    have hAff_preV : IsAffineOpen preV := by
      change IsAffineOpen ((TopologicalSpace.Opens.map π.base).obj V)
      rw [hEq_Z]
      exact hAff_Z b'
    have : IsIso preV.toSpecΓ := by
      rw [← IsAffineOpen.isoSpec_hom hAff_preV]
      infer_instance
    have : IsIso V.toSpecΓ := by
      rw [← IsAffineOpen.isoSpec_hom hAff_V]
      infer_instance
    have h_nat : preV.toSpecΓ ≫ Spec.map (π.app V) = (π ∣_ V) ≫ V.toSpecΓ :=
      Scheme.Opens.toSpecΓ_naturality π V
    have : IsIso ((π ∣_ V) ≫ V.toSpecΓ) := by
      rw [← h_nat]
      infer_instance
    exact IsIso.of_isIso_comp_right (π ∣_ V) V.toSpecΓ

  
  have hcomm_Z : π₀_sch ≫ Z_bar.hom = f₀_sch ≫ P₁.hom := by
    dsimp only [π₀_sch, ι_Ytilde_sch, f₀_sch, P₁]
    rw [Category.assoc, CategoryTheory.Over.w π_Y, ← CategoryTheory.Over.w g₂,
      ← Category.assoc, Limits.pullback.condition, Category.assoc,
      CategoryTheory.Over.w ι_line]

  refine ⟨hcomm_Z, ?_⟩
  let ι_Z_Q₁ := Limits.pullback.lift π₀_sch f₀_sch hcomm_Z
  rcases hNet_inc with ⟨hcomm_Y, hL', hCl_YQ₂, hKer_YQ₂⟩
  let ι_Y_Q₂ : Y₂.left ⟶ Q₂ := Limits.pullback.lift π_Y.left g₂.left hcomm_Y
  let j_Q : Q₁ ⟶ Q₂ := Limits.pullback.lift p₁_Z (p₁_P ≫ ι_line.left)
    (by rw [Category.assoc, CategoryTheory.Over.w ι_line]; exact Limits.pullback.condition)

  have hPb_jQ : IsPullback j_Q p₁_P p₂_P ι_line.left := by
    refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
      (IsPullback.of_hasPullback Z_bar.hom P₂.hom)
    rw [Limits.pullback.lift_fst, CategoryTheory.Over.w ι_line]
    exact IsPullback.of_hasPullback Z_bar.hom P₁.hom

  have hPb_ZQ₁ : IsPullback ι_Ytilde_sch ι_Z_Q₁ ι_Y_Q₂ j_Q := by
    refine (IsPullback.of_right ?_ ?_ hPb_jQ.flip).flip
    · rw [Limits.pullback.lift_snd, Limits.pullback.lift_snd]
      exact (IsPullback.of_hasPullback g₂.left ι_line.left).flip
    · apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst,
          Category.assoc, Limits.pullback.lift_fst]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
          Category.assoc, Limits.pullback.lift_snd]
        exact Limits.pullback.condition.symm

  
  have hCl_ZQ₁ : IsClosedImmersion ι_Z_Q₁ :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ZQ₁ hCl_YQ₂

  
  have hKer_ZQ₁ : ∀ (α : Fin (M + 1)) (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
      (hF_axis : ∀ a : Fin 2, ![L 0, L 1] a ∈ 𝒜_M 1)
      (b : Fin 2) (hTb : (MvPolynomial.X b : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1)
      (U_Z : Z_bar.left.Opens) (_ : IsAffineOpen U_Z)
      (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)))
      (U_P : P₁.left.Opens) (_ : IsAffineOpen U_P)
      (hUP : U_P ≤ AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b))
      (W_pb : Q₁.Opens) (_ : IsAffineOpen W_pb)
      (hWZ : W_pb ≤ (TopologicalSpace.Opens.map p₁_Z.base).obj U_Z)
      (hWP : W_pb ≤ (TopologicalSpace.Opens.map p₁_P.base).obj U_P),
      let ℓ_a : Fin 2 → ↑(Z_bar.left.presheaf.obj (Opposite.op U_Z)) := fun a =>
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
          ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) U_Z hUZ).hom
          (HomogeneousLocalization.mk ⟨1, ⟨![L 0, L 1] a, hF_axis a⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
      let t_a : Fin 2 → ↑(P₁.left.presheaf.obj (Opposite.op U_P)) := fun a =>
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b) hTb zero_lt_one).hom ≫
          P₁.left.presheaf.map (CategoryTheory.homOfLE hUP).op).hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X a, MvPolynomial.isHomogeneous_X k a⟩, ⟨MvPolynomial.X b, hTb⟩, ⟨1, pow_one _⟩⟩)
      RingHom.ker (ι_Z_Q₁.app W_pb).hom =
        Ideal.span {∑ a : Fin 2,
          (p₁_Z.appLE U_Z W_pb hWZ).hom (ℓ_a a) *
          (p₁_P.appLE U_P W_pb hWP).hom (t_a a)} := by
    intro α hXα hF_axis b hTb U_Z hAff_UZ hUZ U_P hAff_UP hUP W_pb hAff_Wpb hWZ hWP
    let hWb2 : (MvPolynomial.X b.castSucc : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1 :=
      MvPolynomial.isHomogeneous_X k b.castSucc
    let D₁_b : P₁.left.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b)
    let D₂_b : P₂.left.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X b.castSucc)
    have hAff_D₂b : IsAffineOpen D₂_b :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_2 (MvPolynomial.X b.castSucc) hWb2 zero_lt_one
    let W_prod : Q₂.Opens :=
      (TopologicalSpace.Opens.map p₂_Z.base).obj U_Z ⊓
        (TopologicalSpace.Opens.map p₂_P.base).obj D₂_b
    have hAff_Wprod : IsAffineOpen W_prod :=
      hProd_aff Z_bar.hom P₂.hom U_Z D₂_b hAff_UZ hAff_D₂b
    obtain ⟨h_b, hLine_a, hLine_2⟩ := hLine_plane.2.2 b
    have hW_jQ : W_pb ≤ (TopologicalSpace.Opens.map j_Q.base).obj W_prod := by
      intro x hx
      refine ⟨?_, ?_⟩
      · have h1 : (j_Q ≫ p₂_Z).base x = p₁_Z.base x := by rw [Limits.pullback.lift_fst]
        change (j_Q ≫ p₂_Z).base x ∈ U_Z
        rw [h1]
        exact hWZ hx
      · have h2 : (j_Q ≫ p₂_P).base x = (p₁_P ≫ ι_line.left).base x := by
          rw [Limits.pullback.lift_snd]
        change (j_Q ≫ p₂_P).base x ∈ D₂_b
        rw [h2]
        exact h_b (hUP (hWP hx))
    rw [hCl_ker ι_Ytilde_sch ι_Z_Q₁ ι_Y_Q₂ j_Q hPb_ZQ₁ hCl_YQ₂ W_prod hAff_Wprod W_pb hAff_Wpb hW_jQ,
      hKer_YQ₂ α hXα b.castSucc hWb2 U_Z hAff_UZ hUZ D₂_b hAff_D₂b le_rfl W_prod hAff_Wprod
        inf_le_left inf_le_right,
      Ideal.map_span, Set.image_singleton]
    congr 2
    rw [map_sum, Fin.sum_univ_three, Fin.sum_univ_two, map_mul, map_mul, map_mul]
    have hZ_comp : p₂_Z.appLE U_Z W_prod inf_le_left ≫ j_Q.appLE W_prod W_pb hW_jQ =
        p₁_Z.appLE U_Z W_pb hWZ := by
      rw [Scheme.Hom.appLE_comp_appLE]
      congr 1
      exact Limits.pullback.lift_fst _ _ _
    have hZ_apply : ∀ x, (j_Q.appLE W_prod W_pb hW_jQ).hom
        ((p₂_Z.appLE U_Z W_prod inf_le_left).hom x) = (p₁_Z.appLE U_Z W_pb hWZ).hom x :=
      fun x => ConcreteCategory.congr_hom hZ_comp x
    have hP_comp : p₂_P.appLE D₂_b W_prod inf_le_right ≫ j_Q.appLE W_prod W_pb hW_jQ =
        ι_line.left.appLE D₂_b D₁_b h_b ≫
          P₁.left.presheaf.map (homOfLE hUP).op ≫ p₁_P.appLE U_P W_pb hWP := by
      rw [Scheme.Hom.appLE_comp_appLE]
      have hjP : j_Q ≫ p₂_P = p₁_P ≫ ι_line.left := Limits.pullback.lift_snd _ _ _
      have hUP_le : U_P ≤ (TopologicalSpace.Opens.map ι_line.left.base).obj D₂_b := hUP.trans h_b
      have hWP_le : W_pb ≤ (TopologicalSpace.Opens.map (p₁_P ≫ ι_line.left).base).obj D₂_b :=
        fun x hx => hUP_le (hWP hx)
      have h_rhs : (p₁_P ≫ ι_line.left).appLE D₂_b W_pb hWP_le =
          ι_line.left.appLE D₂_b D₁_b h_b ≫
            P₁.left.presheaf.map (homOfLE hUP).op ≫ p₁_P.appLE U_P W_pb hWP := by
        rw [← Category.assoc]
        erw [Scheme.Hom.appLE_map, Scheme.Hom.appLE_comp_appLE]
      calc (j_Q ≫ p₂_P).appLE D₂_b W_pb _
          = (p₁_P ≫ ι_line.left).appLE D₂_b W_pb hWP_le := by congr 1
        _ = _ := h_rhs
    have hP_apply : ∀ y, (j_Q.appLE W_prod W_pb hW_jQ).hom
        ((p₂_P.appLE D₂_b W_prod inf_le_right).hom y) =
        (p₁_P.appLE U_P W_pb hWP).hom
          ((P₁.left.presheaf.map (homOfLE hUP).op).hom
            ((ι_line.left.appLE D₂_b D₁_b h_b).hom y)) :=
      fun y => ConcreteCategory.congr_hom hP_comp y
    rw [hZ_apply, hZ_apply, hZ_apply, hP_apply, hP_apply, hP_apply]
