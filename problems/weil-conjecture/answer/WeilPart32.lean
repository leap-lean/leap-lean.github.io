    have hψz_alg : ψ_z.comp MvPolynomial.C = algebraMap k A := by
      ext r
      change ψ_V (τ_shift (algebraMap k (MvPolynomial (Fin d) k) r)) = algebraMap k A r
      rw [τ_shift.commutes, MvPolynomial.algebraMap_eq, hψV_C_apply]
    have hψz_et : ψ_z.Etale := by
