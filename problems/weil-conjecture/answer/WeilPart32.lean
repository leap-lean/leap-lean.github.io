          rw [map_mul, he_u, e₀.apply_symm_apply, hy]
        · refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
          change Ideal.Quotient.mk _ (e₀ ((Ideal.Quotient.mk (Ideal.span {u₀}) u₁) ^ 3)) = 0
          rw [he_u]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      let e_ring : (qA ⧸ Ideal.span {(Ideal.Quotient.mk (Ideal.span {u₀}) u₁) ^ 3}) ≃+*
