    [AlgebraicGeometry.SmoothOfRelativeDimension d B₀.hom]
    (ι_B : B₀ ⟶ Z_bar)
    (hCl_B : AlgebraicGeometry.IsClosedImmersion ι_B.left)
    (U_axis : Z_bar.left.Opens)
    (hU_axis_eq : (U_axis : Set Z_bar.left) = (Set.range ι_B.left.base)ᶜ)
    (hU_axis_ne : Nonempty U_axis)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (d + 2) Z_tilde.hom]
    (π₀ : Z_tilde ⟶ Z_bar)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver k 1)
    (hCl_prod : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift π₀.left f₀.left
        ((CategoryTheory.Over.w π₀).trans (CategoryTheory.Over.w f₀).symm)))
    (hIso_U : CategoryTheory.IsIso (π₀.left ∣_ U_axis)) :
    AlgebraicGeometry.IsIntegral Z_tilde.left :=
by
  
  have hk_noeth : IsNoetherianRing k :=
    (isNoetherianRing_iff_ideal_fg k).mpr fun I => by
      rcases Ideal.eq_bot_or_top I with rfl | rfl
      · exact ⟨∅, by simp⟩
      · exact ⟨{1}, by simp⟩
  have hk_sub_spec : Subsingleton (PrimeSpectrum k) :=
    ⟨fun p q => PrimeSpectrum.ext <| by
      have hp : p.asIdeal = ⊥ := (Ideal.eq_bot_or_top p.asIdeal).resolve_right p.isPrime.ne_top
      have hq : q.asIdeal = ⊥ := (Ideal.eq_bot_or_top q.asIdeal).resolve_right q.isPrime.ne_top
      exact hp.trans hq.symm⟩

  
  
  
  have hSm_P1 : AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver k 1).hom := by
    dsimp only [weilProjectiveSpaceOver, CategoryTheory.Over.mk_hom]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hX_mem : ∀ a : Fin (1 + 1), (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) ∈ 𝒜 1 := by
      intro a
      rw [MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_X k a
    
    have hCover_P1 : ∀ x : ↥(AlgebraicGeometry.Proj 𝒜),
        ∃ a : Fin (1 + 1), x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a) := by
      intro x
      by_contra! h_none
      have hX_in : ∀ a : Fin (1 + 1), MvPolynomial.X a ∈ x.asHomogeneousIdeal :=
        fun a => not_not.mp fun hx_not =>
          h_none a ((ProjectiveSpectrum.mem_basicOpen 𝒜 (MvPolynomial.X a) x).mpr hx_not)
      apply x.not_irrelevant_le
      intro f hf
      rw [HomogeneousIdeal.mem_irrelevant_iff] at hf
      have hf0 : f.coeff 0 = 0 := by
        by_cases h0 : (0 : Fin (1 + 1) →₀ ℕ) ∈ f.support
        · have hproj : (GradedRing.proj 𝒜 0) f = MvPolynomial.C (f.coeff 0) := by
            conv_lhs => rw [MvPolynomial.as_sum f, map_sum]
            rw [← Finset.add_sum_erase _ _ h0]
            have hm0 : MvPolynomial.monomial (0 : Fin (1 + 1) →₀ ℕ) (f.coeff 0) ∈ 𝒜 0 := by
              rw [MvPolynomial.mem_homogeneousSubmodule]
              exact MvPolynomial.isHomogeneous_monomial (f.coeff 0) (by simp [Finsupp.degree])
            have hfirst : (GradedRing.proj 𝒜 0) (MvPolynomial.monomial 0 (f.coeff 0)) =
                MvPolynomial.C (f.coeff 0) := by
              rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒜 hm0, MvPolynomial.monomial_zero']
            have hrest : ∑ v ∈ f.support.erase 0,
                (GradedRing.proj 𝒜 0) (MvPolynomial.monomial v (f.coeff v)) = 0 := by
              refine Finset.sum_eq_zero fun v hv => ?_
              have hv_ne : v ≠ 0 := Finset.ne_of_mem_erase hv
              let deg_v : ℕ := Finsupp.degree v
              have hdeg_ne : deg_v ≠ 0 := by
                intro hdeg0
                apply hv_ne
                ext a
                by_cases ha_supp : a ∈ v.support
                · exact Finset.sum_eq_zero_iff.mp hdeg0 a ha_supp
                · exact Finsupp.notMem_support_iff.mp ha_supp
              have hmv : MvPolynomial.monomial v (f.coeff v) ∈ 𝒜 deg_v := by
                rw [MvPolynomial.mem_homogeneousSubmodule]
                exact MvPolynomial.isHomogeneous_monomial (f.coeff v) rfl
              rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_ne 𝒜 hmv hdeg_ne]
            rw [hfirst, hrest, add_zero]
          have hC0 : (MvPolynomial.C (f.coeff 0) : MvPolynomial (Fin (1 + 1)) k) = 0 :=
            hproj.symm.trans hf
          have hcoeff := congrArg (fun p : MvPolynomial (Fin (1 + 1)) k => p.coeff 0) hC0
          simpa using hcoeff
        · exact MvPolynomial.notMem_support_iff.mp h0
      rw [MvPolynomial.as_sum f]
      refine Submodule.sum_mem x.asHomogeneousIdeal.toIdeal fun v hv => ?_
      have hv_ne : v ≠ 0 := by
        intro hv0
        subst hv0
        exact (MvPolynomial.mem_support_iff.mp hv) hf0
      have hex_a : ∃ a : Fin (1 + 1), 1 ≤ v a := by
        by_contra! hall
        apply hv_ne
        ext a
        exact Nat.lt_one_iff.mp (hall a)
      rcases hex_a with ⟨a, ha⟩
      have hv_eq : Finsupp.single a 1 + (v - Finsupp.single a 1) = v :=
        add_tsub_cancel_of_le (Finsupp.single_le_iff.mpr ha)
      have hmon_eq : MvPolynomial.monomial v (f.coeff v) =
          MvPolynomial.X a * MvPolynomial.monomial (v - Finsupp.single a 1) (f.coeff v) := by
        change MvPolynomial.monomial v (f.coeff v) =
          MvPolynomial.monomial (Finsupp.single a 1) (1 : k) *
            MvPolynomial.monomial (v - Finsupp.single a 1) (f.coeff v)
        rw [MvPolynomial.monomial_mul_monomial, one_mul, hv_eq]
      rw [hmon_eq]
      exact Ideal.mul_mem_right _ x.asHomogeneousIdeal.toIdeal (hX_in a)
    
    have hDehom : ∀ a : Fin (1 + 1),
        ∃ e : MvPolynomial (Fin 1) k ≃+*
            HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k),
          e.toRingHom.comp MvPolynomial.C =
            (HomogeneousLocalization.fromZeroRingHom 𝒜
              (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k))).comp
              (algebraMap k ↥(𝒜 0)) := by
      intro a
      let b : Fin (1 + 1) := Fin.rev a
      have hb_ne : b ≠ a := by fin_cases a <;> decide
      let c_hom : k →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜
          (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k))).comp (algebraMap k ↥(𝒜 0))
      let u_a : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) :=
        HomogeneousLocalization.Away.mk 𝒜 (hX_mem a) 1 (MvPolynomial.X b) (by simpa using hX_mem b)
      let instAlg_a : Algebra k (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k)) :=
        c_hom.toAlgebra
      let Φ_a : MvPolynomial (Fin 1) k →+*
          HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) :=
        (@MvPolynomial.aeval k (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k))
          (Fin 1) _ _ instAlg_a (fun _ => u_a)).toRingHom
      have hΦ_C : Φ_a.comp MvPolynomial.C = c_hom :=
        RingHom.ext fun r =>
          @MvPolynomial.aeval_C k (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k))
            (Fin 1) _ _ instAlg_a (fun _ => u_a) r
      let ψ_a : MvPolynomial (Fin (1 + 1)) k →+* MvPolynomial (Fin 1) k :=
        (MvPolynomial.aeval (fun i : Fin (1 + 1) =>
          if i = a then (1 : MvPolynomial (Fin 1) k) else MvPolynomial.X 0)).toRingHom
      have hψ_Xa_eq : ψ_a (MvPolynomial.X a) = 1 := by
        change MvPolynomial.aeval _ (MvPolynomial.X a) = 1
        rw [MvPolynomial.aeval_X]
        simp
      have hψ_Xb_eq : ψ_a (MvPolynomial.X b) = MvPolynomial.X 0 := by
        change MvPolynomial.aeval _ (MvPolynomial.X b) = MvPolynomial.X 0
        rw [MvPolynomial.aeval_X]
        simp [hb_ne]
      have hψ_C : ∀ r : k, ψ_a (MvPolynomial.C r) = MvPolynomial.C r :=
        fun r => MvPolynomial.aeval_C _ r
      have hψ_Xa : IsUnit (ψ_a (MvPolynomial.X a)) := by
        rw [hψ_Xa_eq]
        exact isUnit_one
      let ψ_loc : Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) →+* MvPolynomial (Fin 1) k :=
        IsLocalization.Away.lift (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) hψ_Xa
      let val_hom : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) →+*
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := HomogeneousLocalization.val_mul
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := HomogeneousLocalization.val_add }
      have hval_apply : ∀ z : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k),
          val_hom z = HomogeneousLocalization.val z := fun _ => rfl
      let Ψ_a : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) →+*
          MvPolynomial (Fin 1) k :=
        ψ_loc.comp val_hom
      have hc_val : ∀ r : k, val_hom (c_hom r) =
          algebraMap (MvPolynomial (Fin (1 + 1)) k)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k))
            (MvPolynomial.C r) := by
        intro r
        have hc_eq : c_hom r = HomogeneousLocalization.Away.mk 𝒜 (hX_mem a) 0 (MvPolynomial.C r)
            (by rw [zero_smul, MvPolynomial.mem_homogeneousSubmodule]; exact MvPolynomial.isHomogeneous_C _ r) := by
          apply HomogeneousLocalization.val_injective
          rw [HomogeneousLocalization.Away.val_mk]
          rfl
        rw [hc_eq, hval_apply, HomogeneousLocalization.Away.val_mk]
        exact congrArg₂ Localization.mk rfl (Subtype.ext (pow_zero _))
      have h_left : Ψ_a.comp Φ_a = RingHom.id (MvPolynomial (Fin 1) k) := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro r
          simp only [RingHom.comp_assoc, hΦ_C, RingHom.comp_apply, RingHom.id_apply, Ψ_a]
          rw [hc_val r, IsLocalization.Away.lift_eq, hψ_C]
        · intro i
          have hi : i = 0 := Subsingleton.elim i 0
          subst hi
          have hΦX : Φ_a (MvPolynomial.X 0) = u_a :=
            @MvPolynomial.aeval_X k
              (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k))
              (Fin 1) _ _ instAlg_a (fun _ => u_a) 0
          simp only [RingHom.comp_apply, RingHom.id_apply, Ψ_a]
          rw [hΦX, hval_apply, HomogeneousLocalization.Away.val_mk]
          dsimp only [ψ_loc, IsLocalization.Away.lift]
          simp only [pow_one, Localization.mk_eq_mk']
          rw [IsLocalization.lift_mk'_spec, hψ_Xb_eq, hψ_Xa_eq, one_mul]
      have h_right : ∀ z : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k),
          Φ_a (Ψ_a z) = z := by
        intro z
        obtain ⟨n, f, hf, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX_mem a) z
        apply HomogeneousLocalization.val_injective
        rw [← hval_apply]
        have hΨ_mk : Ψ_a (HomogeneousLocalization.Away.mk 𝒜 (hX_mem a) n f hf) = ψ_a f := by
          simp only [Ψ_a, RingHom.comp_apply]
          rw [hval_apply, HomogeneousLocalization.Away.val_mk]
          dsimp only [ψ_loc, IsLocalization.Away.lift]
          rw [Localization.mk_eq_mk', IsLocalization.lift_mk'_spec, map_pow, hψ_Xa_eq,
            one_pow, one_mul]
        rw [hΨ_mk, HomogeneousLocalization.Away.val_mk]
        let θ : MvPolynomial (Fin (1 + 1)) k →+*
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) :=
          (val_hom.comp Φ_a).comp ψ_a
        change θ f = Localization.mk f ⟨(MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) ^ n, _⟩
        have hθ_C : ∀ r : k, θ (MvPolynomial.C r) =
            algebraMap (MvPolynomial (Fin (1 + 1)) k)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k)) (MvPolynomial.C r) := by
          intro r
          simp only [θ, RingHom.comp_apply]
          rw [hψ_C]
          have hΦC_r : Φ_a (MvPolynomial.C r) = c_hom r := RingHom.congr_fun hΦ_C r
          rw [hΦC_r, hc_val r]
        have hθ_Xa : θ (MvPolynomial.X a) = 1 := by
          simp only [θ, RingHom.comp_apply]
          rw [hψ_Xa_eq, map_one, map_one]
        have hθ_Xb : θ (MvPolynomial.X b) =
            Localization.mk (MvPolynomial.X b)
              ⟨(MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k), Submonoid.mem_powers _⟩ := by
          simp only [θ, RingHom.comp_apply]
          rw [hψ_Xb_eq]
          have hΦX : Φ_a (MvPolynomial.X 0) = u_a :=
            @MvPolynomial.aeval_X k
              (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k))
              (Fin 1) _ _ instAlg_a (fun _ => u_a) 0
          rw [hΦX, hval_apply, HomogeneousLocalization.Away.val_mk]
          exact congrArg₂ Localization.mk rfl (Subtype.ext (pow_one _))
        let invXa : Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) :=
          Localization.mk 1 ⟨(MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k), Submonoid.mem_powers _⟩
        have h_mul_inv : algebraMap (MvPolynomial (Fin (1 + 1)) k)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k))
            (MvPolynomial.X a) * invXa = 1 := by
          change Localization.mk (MvPolynomial.X a) 1 * Localization.mk 1 ⟨MvPolynomial.X a, _⟩ = 1
          rw [Localization.mk_mul, mul_one, one_mul]
          exact Localization.mk_self
            (⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
              Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k))
        have hf_homog : MvPolynomial.IsHomogeneous f n := by
          rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule] at hf
          exact hf
        have h_sum : θ f = algebraMap _ (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k)) f *
            invXa ^ n := by
          conv_lhs => rw [MvPolynomial.as_sum f, map_sum]
          conv_rhs => rw [MvPolynomial.as_sum f, map_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl fun v hv => ?_
          have hv_deg : v a + v b = n := by
            have hdeg := hf_homog (MvPolynomial.mem_support_iff.mp hv)
            rw [Finsupp.weight_apply] at hdeg
            simp only [Pi.one_apply, smul_eq_mul, mul_one] at hdeg
            rw [Finsupp.sum_fintype v (fun _ c => c) (fun _ => rfl), Fin.sum_univ_two] at hdeg
            fin_cases a
            · exact hdeg
            · change v 1 + v 0 = n; omega
          rw [MvPolynomial.monomial_eq, map_mul, hθ_C, map_mul]
          rw [Finsupp.prod_of_support_subset v (Finset.subset_univ v.support) _ (fun _ _ => pow_zero _)]
          rw [map_prod, map_prod]
          let ι_loc := algebraMap (MvPolynomial (Fin (1 + 1)) k)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k))
          have hprod_lhs : (∏ i : Fin (1 + 1), θ (MvPolynomial.X i ^ v i)) =
              (ι_loc (MvPolynomial.X b) * invXa) ^ v b := by
            have h2 : (∏ i : Fin (1 + 1), θ (MvPolynomial.X i ^ v i)) =
                θ (MvPolynomial.X a ^ v a) * θ (MvPolynomial.X b ^ v b) := by
              rw [Fin.prod_univ_two]
              fin_cases a
              · rfl
              · exact mul_comm _ _
            rw [h2, map_pow, map_pow, hθ_Xa, one_pow, one_mul, hθ_Xb]
            congr 1
            change Localization.mk (MvPolynomial.X b) ⟨MvPolynomial.X a, _⟩ =
              Localization.mk (MvPolynomial.X b) 1 * Localization.mk 1 ⟨MvPolynomial.X a, _⟩
            rw [Localization.mk_mul, mul_one, one_mul]
          have hprod_rhs : (∏ i : Fin (1 + 1), ι_loc (MvPolynomial.X i ^ v i)) =
              (ι_loc (MvPolynomial.X a)) ^ v a * (ι_loc (MvPolynomial.X b)) ^ v b := by
            rw [Fin.prod_univ_two, map_pow, map_pow]
            fin_cases a
            · rfl
            · exact mul_comm _ _
          rw [hprod_lhs, hprod_rhs, ← hv_deg, pow_add, mul_pow]
          have hcancel : (ι_loc (MvPolynomial.X a)) ^ v a * invXa ^ v a = 1 := by
            rw [← mul_pow]
            exact (congrArg (· ^ v a) h_mul_inv).trans (one_pow _)
          calc ι_loc (MvPolynomial.C (f.coeff v)) *
                ((ι_loc (MvPolynomial.X b)) ^ v b * invXa ^ v b)
              = ι_loc (MvPolynomial.C (f.coeff v)) *
                (1 * (ι_loc (MvPolynomial.X b)) ^ v b * invXa ^ v b) := by ring
            _ = ι_loc (MvPolynomial.C (f.coeff v)) *
                (((ι_loc (MvPolynomial.X a)) ^ v a * invXa ^ v a) *
                  (ι_loc (MvPolynomial.X b)) ^ v b * invXa ^ v b) := by rw [hcancel]
            _ = ι_loc (MvPolynomial.C (f.coeff v)) *
                ((ι_loc (MvPolynomial.X a)) ^ v a * (ι_loc (MvPolynomial.X b)) ^ v b) *
                (invXa ^ v a * invXa ^ v b) := by ring
        rw [h_sum]
        have hinv_pow : ∀ m_pow : ℕ, invXa ^ m_pow =
            Localization.mk 1 ⟨(MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) ^ m_pow,
              Submonoid.pow_mem _ (Submonoid.mem_powers _) m_pow⟩ := by
          intro m_pow
          induction m_pow with
          | zero => simp [invXa]
          | succ m ihm =>
            rw [pow_succ, ihm]
            dsimp [invXa]
            rw [Localization.mk_mul]
            exact congrArg₂ Localization.mk (by ring) (Subtype.ext (by simp [pow_succ]))
        rw [hinv_pow n]
        change Localization.mk f 1 * Localization.mk 1 ⟨MvPolynomial.X a ^ n, _⟩ = _
        rw [Localization.mk_mul, mul_one, one_mul]
      exact ⟨{ Φ_a with invFun := Ψ_a, left_inv := fun p => RingHom.congr_fun h_left p, right_inv := h_right }, hΦ_C⟩
    refine ⟨fun x => ?_⟩
    obtain ⟨a, hx_a⟩ := hCover_P1 x
    let U_a : (AlgebraicGeometry.Proj 𝒜).Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)
    have hAff_Ua : AlgebraicGeometry.IsAffineOpen U_a :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X a) (hX_mem a) zero_lt_one
    refine ⟨⊤, AlgebraicGeometry.isAffineOpen_top _, U_a, hAff_Ua, hx_a, le_top, ?_⟩
    obtain ⟨e_a, he_C⟩ := hDehom a
    let iso_a := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜
      (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) (hX_mem a) zero_lt_one
    let c_hom : k →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k) :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜
        (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k))).comp (algebraMap k ↥(𝒜 0))
    let p₁ : AlgebraicGeometry.Proj 𝒜 ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))
    have h_chart_comm : U_a.ι ≫ p₁ =
        iso_a.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_hom) := by
      rw [← CategoryTheory.Iso.inv_comp_eq]
      change (iso_a.inv ≫ U_a.ι) ≫
          (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) = _
      rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayι_toSpecZero, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
    have h_appTop := congrArg AlgebraicGeometry.Scheme.Hom.appTop h_chart_comm
    have h_lhs : (U_a.ι ≫ p₁).appTop ≫ U_a.topIso.hom = p₁.appLE ⊤ U_a le_top := by
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Opens.ι_appTop]
      simp only [AlgebraicGeometry.Scheme.Hom.appLE, AlgebraicGeometry.Scheme.Hom.appTop,
        AlgebraicGeometry.Scheme.Opens.topIso_hom]
      refine congrArg (p₁.app ⊤ ≫ ·) ?_
      exact ((AlgebraicGeometry.Proj 𝒜).presheaf.map_comp _ _).symm.trans
        (congrArg (AlgebraicGeometry.Proj 𝒜).presheaf.map (Subsingleton.elim _ _))
    let iso_left : (AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤) ≅
        CommRingCat.of k :=
      AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)
    let iso_appTop : (AlgebraicGeometry.Spec (CommRingCat.of
        (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k)))).presheaf.obj
          (Opposite.op ⊤) ≅
        (U_a.toScheme).presheaf.obj (Opposite.op ⊤) :=
      { hom := iso_a.hom.appTop
        inv := iso_a.inv.appTop
        hom_inv_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, iso_a.inv_hom_id]
          exact AlgebraicGeometry.Scheme.Hom.id_appTop
        inv_hom_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, iso_a.hom_inv_id]
          exact AlgebraicGeometry.Scheme.Hom.id_appTop }
    let iso_right : CommRingCat.of (MvPolynomial (Fin 1) k) ≅
        ((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op U_a)) :=
      e_a.toCommRingCatIso ≪≫
        (AlgebraicGeometry.Scheme.ΓSpecIso
          (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k)))).symm ≪≫
        iso_appTop ≪≫
        U_a.topIso
    have h_rhs : (iso_a.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_hom)).appTop ≫
        U_a.topIso.hom =
        iso_left.hom ≫ CommRingCat.ofHom MvPolynomial.C ≫ iso_right.hom := by
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop]
      have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom c_hom)
      have h1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_hom)).appTop =
          iso_left.hom ≫ CommRingCat.ofHom c_hom ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso
              (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k)))).inv := by
        have hnat_inv := congrArg (fun φ => φ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso
          (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k)))).inv) hnat
        simpa only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
          CategoryTheory.Category.comp_id] using hnat_inv
      rw [h1]
      have he_cat : CommRingCat.ofHom c_hom =
          CommRingCat.ofHom MvPolynomial.C ≫ e_a.toCommRingCatIso.hom := by
        change CommRingCat.ofHom c_hom = CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom e_a.toRingHom
        rw [← CommRingCat.ofHom_comp, he_C]
      rw [he_cat]
      simp only [iso_right, iso_appTop, Iso.trans_hom, CategoryTheory.Category.assoc, Iso.symm_hom]
    have h_appLE_eq : p₁.appLE ⊤ U_a le_top =
        iso_left.hom ≫ CommRingCat.ofHom MvPolynomial.C ≫ iso_right.hom := by
      rw [← h_lhs, h_appTop, h_rhs]
    have hStd_poly : RingHom.IsStandardSmoothOfRelativeDimension 1
        (MvPolynomial.C : k →+* MvPolynomial (Fin 1) k) := by
      have hAlgStd : Algebra.IsStandardSmoothOfRelativeDimension (Nat.card (Fin 1)) k
          (MvPolynomial (Fin 1) k) :=
        Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial k (Fin 1)
      rw [Nat.card_eq_fintype_card, Fintype.card_fin] at hAlgStd
      exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hAlgStd
    change RingHom.IsStandardSmoothOfRelativeDimension 1 (p₁.appLE ⊤ U_a le_top).hom
    rw [h_appLE_eq]
    exact (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_left_isIso
      iso_left.hom (CommRingCat.ofHom MvPolynomial.C ≫ iso_right.hom)).mpr
      ((RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_right_isIso
        (CommRingCat.ofHom MvPolynomial.C) iso_right.hom).mpr hStd_poly)

  
  
  
  
  have hWeakRegSurjLen : ∀ (len : ℕ) {A B M N : Type u} [CommRing A] [CommRing B]
      [AddCommGroup M] [Module A M] [AddCommGroup N] [Module B N]
      (π : A →+* B) (_hπ : Function.Surjective π) (eM : M ≃+ N)
      (_hsmul : ∀ (a : A) (m : M), eM (a • m) = π a • eM m)
      (rs : List A),
      rs.length = len →
      (RingTheory.Sequence.IsWeaklyRegular M rs ↔
        RingTheory.Sequence.IsWeaklyRegular N (rs.map π)) := by
    intro len
    induction len with
    | zero =>
      intro A B M N _ _ _ _ _ _ π _ _ _ rs hlen
      cases rs with
      | nil =>
        simp only [List.map_nil]
        exact ⟨fun _ => RingTheory.Sequence.IsWeaklyRegular.nil B N,
          fun _ => RingTheory.Sequence.IsWeaklyRegular.nil A M⟩
      | cons _ _ => simp at hlen
    | succ len ih =>
      intro A B M N _ _ _ _ _ _ π hπ eM hsmul rs hlen
      cases rs with
      | nil => simp at hlen
      | cons r tail =>
        simp only [List.length_cons, Nat.add_right_cancel_iff] at hlen
        rw [List.map_cons, RingTheory.Sequence.isWeaklyRegular_cons_iff,
          RingTheory.Sequence.isWeaklyRegular_cons_iff]
        have hsmul_symm : ∀ (a : A) (n : N), eM.symm (π a • n) = a • eM.symm n := by
          intro a n
          apply eM.injective
          rw [eM.apply_symm_apply, hsmul, eM.apply_symm_apply]
        have hReg_head : IsSMulRegular M r ↔ IsSMulRegular N (π r) := by
          constructor
          · intro hr n₁ n₂ hn
            dsimp only at hn
            have hn' : r • eM.symm n₁ = r • eM.symm n₂ := by
              rw [← hsmul_symm, ← hsmul_symm, hn]
            exact eM.symm.injective (hr hn')
          · intro hπr m₁ m₂ hm
            dsimp only at hm
            have hm' : π r • eM m₁ = π r • eM m₂ := by
              rw [← hsmul, ← hsmul, hm]
            exact eM.injective (hπr hm')
        let g_fwd : M →+ QuotSMulTop (π r) N :=
          (Submodule.mkQ _).toAddMonoidHom.comp eM.toAddMonoidHom
        have hg_fwd_ker : ∀ m : M, m ∈ Ideal.span ({r} : Set A) • (⊤ : Submodule A M) → g_fwd m = 0 := by
          intro m hm
          refine Submodule.smul_induction_on hm ?_ ?_
          · intro a ha x _
            rw [Ideal.mem_span_singleton] at ha
            rcases ha with ⟨c, rfl⟩
            change Submodule.Quotient.mk (eM ((r * c) • x)) = (0 : QuotSMulTop (π r) N)
            rw [mul_comm r c, mul_smul, hsmul, hsmul, Submodule.Quotient.mk_eq_zero,
              ← Submodule.ideal_span_singleton_smul]
            rw [← mul_smul, mul_comm (π c) (π r)]
            exact Submodule.smul_mem_smul (Ideal.mem_span_singleton.mpr ⟨π c, rfl⟩) Submodule.mem_top
          · intro x y hx hy
            rw [map_add, hx, hy, add_zero]
        let f_fwd : QuotSMulTop r M →+ QuotSMulTop (π r) N :=
          QuotientAddGroup.lift _ g_fwd (fun m hm => by
            rw [Submodule.ideal_span_singleton_smul] at hg_fwd_ker
            exact hg_fwd_ker m hm)
        let g_bwd : N →+ QuotSMulTop r M :=
          (Submodule.mkQ _).toAddMonoidHom.comp eM.symm.toAddMonoidHom
        have hg_bwd_ker : ∀ n : N, n ∈ Ideal.span ({π r} : Set B) • (⊤ : Submodule B N) → g_bwd n = 0 := by
          intro n hn
          refine Submodule.smul_induction_on hn ?_ ?_
          · intro b hb y _
            rw [Ideal.mem_span_singleton] at hb
            rcases hb with ⟨d, rfl⟩
            rcases hπ d with ⟨c, rfl⟩
            change Submodule.Quotient.mk (eM.symm ((π r * π c) • y)) = (0 : QuotSMulTop r M)
            rw [← map_mul, hsmul_symm, Submodule.Quotient.mk_eq_zero,
              ← Submodule.ideal_span_singleton_smul]
            exact Submodule.smul_mem_smul (Ideal.mem_span_singleton.mpr ⟨c, rfl⟩) Submodule.mem_top
          · intro x y hx hy
            rw [map_add, hx, hy, add_zero]
        let f_bwd : QuotSMulTop (π r) N →+ QuotSMulTop r M :=
          QuotientAddGroup.lift _ g_bwd (fun n hn => by
            rw [Submodule.ideal_span_singleton_smul] at hg_bwd_ker
            exact hg_bwd_ker n hn)
        let eM_quot : QuotSMulTop r M ≃+ QuotSMulTop (π r) N :=
          { f_fwd with
            invFun := f_bwd
            left_inv := fun z => by
              rcases Submodule.Quotient.mk_surjective _ z with ⟨x, rfl⟩
              change Submodule.Quotient.mk (eM.symm (eM x)) = Submodule.Quotient.mk x
              rw [eM.symm_apply_apply]
            right_inv := fun z => by
              rcases Submodule.Quotient.mk_surjective _ z with ⟨y, rfl⟩
              change Submodule.Quotient.mk (eM (eM.symm y)) = Submodule.Quotient.mk y
              rw [eM.apply_symm_apply] }
        have hsmul_quot : ∀ (a : A) (z : QuotSMulTop r M),
            eM_quot (a • z) = π a • eM_quot z := by
          intro a z
          rcases Submodule.Quotient.mk_surjective _ z with ⟨m, rfl⟩
          change Submodule.Quotient.mk (eM (a • m)) = Submodule.Quotient.mk (π a • eM m)
          rw [hsmul]
        exact and_congr hReg_head (ih π hπ eM_quot hsmul_quot tail hlen)

  have hWeakRegEquiv : ∀ {A B : Type u} [CommRing A] [CommRing B] (e : A ≃+* B) (rs : List A),
      RingTheory.Sequence.IsWeaklyRegular A rs →
      RingTheory.Sequence.IsWeaklyRegular B (rs.map e) :=
    fun e rs hrs =>
      (hWeakRegSurjLen rs.length e.toRingHom e.surjective e.toAddEquiv
        (fun a m => map_mul e a m) rs rfl).mp hrs

  
  have hMvPolyOriginReg : ∀ (m : ℕ),
      let L₀ : List (MvPolynomial (Fin m) k) := (List.finRange m).map MvPolynomial.X
      RingTheory.Sequence.IsWeaklyRegular (MvPolynomial (Fin m) k) L₀ ∧
      Ideal.ofList L₀ = RingHom.ker (MvPolynomial.aeval (0 : Fin m → k)).toRingHom := by
    intro m
    induction m with
    | zero =>
      refine ⟨?_, ?_⟩
      · change RingTheory.Sequence.IsWeaklyRegular (MvPolynomial (Fin 0) k) []
        exact RingTheory.Sequence.IsWeaklyRegular.nil (MvPolynomial (Fin 0) k) (MvPolynomial (Fin 0) k)
      · change Ideal.ofList [] = _
        rw [Ideal.ofList_nil]
        have hp_const : ∀ q : MvPolynomial (Fin 0) k,
            q = MvPolynomial.C ((MvPolynomial.aeval (0 : Fin 0 → k)) q) := by
          intro q
          induction q using MvPolynomial.induction_on with
          | C a => simp
          | add p₁ p₂ ih₁ ih₂ => rw [map_add, map_add, ← ih₁, ← ih₂]
          | mul_X q₀ i => exact Fin.elim0 i
        ext p
        simp only [Ideal.mem_bot, RingHom.mem_ker, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]
        constructor
        · rintro rfl; exact map_zero _
        · intro hp0
          rw [hp_const p, hp0, map_zero]
    | succ m ihm =>
      obtain ⟨hReg_m, hKer_m⟩ := ihm
      let L_m : List (MvPolynomial (Fin m) k) := (List.finRange m).map MvPolynomial.X
      let e_succ : MvPolynomial (Fin (m + 1)) k ≃+* Polynomial (MvPolynomial (Fin m) k) :=
        (MvPolynomial.finSuccEquiv k m).toRingEquiv
      have hX_reg : IsSMulRegular (Polynomial (MvPolynomial (Fin m) k))
          (Polynomial.X : Polynomial (MvPolynomial (Fin m) k)) := by
        intro q₁ q₂ hq
        simp only [smul_eq_mul] at hq
        apply Polynomial.ext
        intro d
        have hc := congrArg (fun p : Polynomial (MvPolynomial (Fin m) k) => p.coeff (d + 1)) hq
        simpa [Polynomial.coeff_X_mul] using hc
      let ev0 : Polynomial (MvPolynomial (Fin m) k) →+* MvPolynomial (Fin m) k :=
        Polynomial.evalRingHom 0
      have hev0_surj : Function.Surjective ev0 := fun p => ⟨Polynomial.C p, Polynomial.eval_C⟩
      let I_X : Ideal (Polynomial (MvPolynomial (Fin m) k)) := Ideal.span {Polynomial.X}
      have hev0_ker : RingHom.ker ev0 = I_X := by
        ext q
        rw [RingHom.mem_ker, Ideal.mem_span_singleton,
          ← sub_zero (Polynomial.X : Polynomial (MvPolynomial (Fin m) k)),
          ← Polynomial.C_0, Polynomial.dvd_iff_isRoot]
        rfl
      let qIso : (Polynomial (MvPolynomial (Fin m) k) ⧸ I_X) ≃+*
          MvPolynomial (Fin m) k :=
        (Ideal.quotEquivOfEq hev0_ker.symm).trans (RingHom.quotientKerEquivOfSurjective hev0_surj)
      let qTop : QuotSMulTop (Polynomial.X : Polynomial (MvPolynomial (Fin m) k))
          (Polynomial (MvPolynomial (Fin m) k)) ≃+
          (Polynomial (MvPolynomial (Fin m) k) ⧸ I_X) :=
        (Submodule.quotEquivOfEq _ I_X
          (by rw [← Submodule.ideal_span_singleton_smul]; exact Ideal.mul_top _)).toAddEquiv
      let eM_poly : QuotSMulTop (Polynomial.X : Polynomial (MvPolynomial (Fin m) k))
          (Polynomial (MvPolynomial (Fin m) k)) ≃+ MvPolynomial (Fin m) k :=
        qTop.trans qIso.toAddEquiv
      have hsmul_poly : ∀ (q : Polynomial (MvPolynomial (Fin m) k))
          (z : QuotSMulTop (Polynomial.X : Polynomial (MvPolynomial (Fin m) k))
            (Polynomial (MvPolynomial (Fin m) k))),
          eM_poly (q • z) = ev0 q • eM_poly z := by
        intro q z
        rcases Submodule.Quotient.mk_surjective _ z with ⟨f, rfl⟩
        change ev0 (q * f) = ev0 q * ev0 f
        exact map_mul ev0 q f
      have hPolyReg : RingTheory.Sequence.IsWeaklyRegular (Polynomial (MvPolynomial (Fin m) k))
          (Polynomial.X :: L_m.map Polynomial.C) := by
        rw [RingTheory.Sequence.isWeaklyRegular_cons_iff]
        refine ⟨hX_reg, ?_⟩
        rw [hWeakRegSurjLen (L_m.map Polynomial.C).length ev0 hev0_surj eM_poly hsmul_poly
          (L_m.map Polynomial.C) rfl]
        have hmap_ev0 : (L_m.map Polynomial.C).map ev0 = L_m := by
          rw [List.map_map]
          exact (List.map_congr_left fun p _ =>
            (Polynomial.eval_C : Polynomial.eval (0 : MvPolynomial (Fin m) k) (Polynomial.C p) = p)).trans
            (List.map_id L_m)
        rwa [hmap_ev0]
      have hfin_C : ∀ r : k, (MvPolynomial.finSuccEquiv k m) (MvPolynomial.C r) =
          Polynomial.C (MvPolynomial.C r) := by
        intro r
        rw [MvPolynomial.finSuccEquiv_apply, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      have hfin_X0 : (MvPolynomial.finSuccEquiv k m) (MvPolynomial.X 0) = Polynomial.X := by
        rw [MvPolynomial.finSuccEquiv_apply, MvPolynomial.eval₂Hom_X', Fin.cases_zero]
      have hList_map : ((List.finRange (m + 1)).map (MvPolynomial.X : Fin (m + 1) → MvPolynomial (Fin (m + 1)) k)) =
          (Polynomial.X :: L_m.map Polynomial.C).map ⇑e_succ.symm := by
        rw [List.finRange_succ, List.map_cons, List.map_cons, List.map_map, List.map_map, List.map_map]
        congr 1
        · apply (MvPolynomial.finSuccEquiv k m).injective
          change (MvPolynomial.finSuccEquiv k m) (MvPolynomial.X 0) =
            (MvPolynomial.finSuccEquiv k m) ((MvPolynomial.finSuccEquiv k m).symm Polynomial.X)
          rw [hfin_X0, (MvPolynomial.finSuccEquiv k m).apply_symm_apply]
        · refine List.map_congr_left fun i _ => ?_
          apply (MvPolynomial.finSuccEquiv k m).injective
          change (MvPolynomial.finSuccEquiv k m) (MvPolynomial.X i.succ) =
            (MvPolynomial.finSuccEquiv k m)
              ((MvPolynomial.finSuccEquiv k m).symm (Polynomial.C (MvPolynomial.X i)))
          rw [MvPolynomial.finSuccEquiv_X_succ, (MvPolynomial.finSuccEquiv k m).apply_symm_apply]
      refine ⟨?_, ?_⟩
      · rw [hList_map]
        exact hWeakRegEquiv e_succ.symm _ hPolyReg
      · have hPolyIdeal : Ideal.ofList (Polynomial.X :: L_m.map Polynomial.C) =
            RingHom.ker ((MvPolynomial.aeval (0 : Fin m → k)).toRingHom.comp ev0) := by
          ext q
          rw [Ideal.ofList_cons, RingHom.mem_ker, RingHom.comp_apply, ← RingHom.mem_ker, ← hKer_m]
          have hC_map : Ideal.ofList (L_m.map Polynomial.C) = Ideal.map Polynomial.C (Ideal.ofList L_m) := by
            simp only [Ideal.ofList, Ideal.map_span]
            congr 1
            ext x
            simp
          have hX_sup : ∀ I : Ideal (MvPolynomial (Fin m) k),
              I_X ⊔ Ideal.map Polynomial.C I = Ideal.comap ev0 I := by
            intro I
            apply le_antisymm
            · rw [sup_le_iff]
              refine ⟨?_, ?_⟩
              · rw [← hev0_ker]
                intro p hp
                rw [Ideal.mem_comap, RingHom.mem_ker.mp hp]
                exact I.zero_mem
              · rw [Ideal.map_le_iff_le_comap]
                intro p hp
                rw [Ideal.mem_comap]
                change Polynomial.eval 0 (Polynomial.C p) ∈ I
                simpa using hp
            · intro p hp
              rw [Ideal.mem_comap] at hp
              have hp_sub : p - Polynomial.C (ev0 p) ∈ I_X := by
                rw [← hev0_ker, RingHom.mem_ker, map_sub]
                change ev0 p - ev0 (Polynomial.C (ev0 p)) = 0
                rw [show ev0 (Polynomial.C (ev0 p)) = ev0 p from Polynomial.eval_C, sub_self]
              have hp_C : Polynomial.C (ev0 p) ∈ Ideal.map Polynomial.C I :=
                Ideal.mem_map_of_mem Polynomial.C hp
              have hp_sum := Submodule.add_mem (I_X ⊔ Ideal.map Polynomial.C I)
                (Ideal.mem_sup_right hp_C) (Ideal.mem_sup_left hp_sub)
              simpa using hp_sum
          rw [hC_map, hX_sup]
          rfl
        rw [hList_map]
        have hmap_ofList : Ideal.ofList ((Polynomial.X :: L_m.map Polynomial.C).map ⇑e_succ.symm) =
            Ideal.comap e_succ.toRingHom (Ideal.ofList (Polynomial.X :: L_m.map Polynomial.C)) := by
          ext p
          have h1 : Ideal.ofList ((Polynomial.X :: L_m.map Polynomial.C).map ⇑e_succ.symm) =
              Ideal.map e_succ.symm.toRingHom (Ideal.ofList (Polynomial.X :: L_m.map Polynomial.C)) := by
            simp only [Ideal.ofList, Ideal.map_span]
            congr 1
            ext x
            simp [eq_comm]
          rw [h1, Ideal.mem_comap]
          constructor
          · intro h
            have hm := Ideal.mem_map_of_mem e_succ.toRingHom h
            rw [Ideal.map_map] at hm
            have hid : e_succ.toRingHom.comp e_succ.symm.toRingHom = RingHom.id _ :=
              RingHom.ext fun x => e_succ.apply_symm_apply x
            rwa [hid, Ideal.map_id] at hm
          · intro h
            have hm := Ideal.mem_map_of_mem e_succ.symm.toRingHom h
            simpa only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.symm_apply_apply] using hm
        rw [hmap_ofList, hPolyIdeal]
        ext p
        rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.mem_ker]
        have hev_eq : ((MvPolynomial.aeval (0 : Fin m → k)).toRingHom.comp ev0).comp e_succ.toRingHom =
            (MvPolynomial.aeval (0 : Fin (m + 1) → k)).toRingHom := by
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
              RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, e_succ, AlgEquiv.coe_ringEquiv,
              ev0, Polynomial.coe_evalRingHom]
            rw [hfin_C, Polynomial.eval_C, MvPolynomial.aeval_C, MvPolynomial.aeval_C]
          · intro i
            refine Fin.cases ?_ ?_ i
            · simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
                RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, e_succ, AlgEquiv.coe_ringEquiv,
                ev0, Polynomial.coe_evalRingHom]
              rw [hfin_X0, Polynomial.eval_X, map_zero, MvPolynomial.aeval_X, Pi.zero_apply]
            · intro j
              simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
                RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, e_succ, AlgEquiv.coe_ringEquiv,
                ev0, Polynomial.coe_evalRingHom]
              rw [MvPolynomial.finSuccEquiv_X_succ, Polynomial.eval_C, MvPolynomial.aeval_X,
                MvPolynomial.aeval_X, Pi.zero_apply, Pi.zero_apply]
        exact Iff.of_eq (congrArg (· = 0) (RingHom.congr_fun hev_eq p))

  
  have hLocalWeakRegDomainLen : ∀ (len : ℕ) {R : Type u} [CommRing R] [IsLocalRing R]
      [IsNoetherianRing R] (L : List R),
      L.length = len →
      RingTheory.Sequence.IsWeaklyRegular R L →
      Ideal.ofList L = IsLocalRing.maximalIdeal R →
      IsDomain R := by
    intro len
    induction len with
    | zero =>
      intro R _ _ _ L hlen _ hMax
      cases L with
      | nil =>
        rw [Ideal.ofList_nil] at hMax
        let _ : Field R := (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hMax.symm).toField
        exact inferInstance
      | cons _ _ => simp at hlen
    | succ len ih =>
      intro R _ _ _ L hlen hReg hMax
      cases L with
      | nil => simp at hlen
      | cons t ts =>
        simp only [List.length_cons, Nat.add_right_cancel_iff] at hlen
        rw [RingTheory.Sequence.isWeaklyRegular_cons_iff] at hReg
        obtain ⟨ht_reg, hts_reg⟩ := hReg
        set I := Ideal.span ({t} : Set R)
        have ht_mem : t ∈ IsLocalRing.maximalIdeal R := by
          rw [← hMax, Ideal.ofList_cons]
          exact Ideal.mem_sup_left (Ideal.subset_span rfl)
        have hI_le : I ≤ IsLocalRing.maximalIdeal R :=
          Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ht_mem)
        have hI_ne_top : I ≠ ⊤ := fun htop =>
          (IsLocalRing.maximalIdeal.isMaximal R).ne_top (top_unique (htop ▸ hI_le))
        have hNontriv_Q : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI_ne_top
        let instLocal_Q : IsLocalRing (R ⧸ I) :=
          @IsLocalRing.of_surjective' R (R ⧸ I) _ _ _ hNontriv_Q (Ideal.Quotient.mk I)
            Ideal.Quotient.mk_surjective
        let instNoeth_Q : IsNoetherianRing (R ⧸ I) := inferInstance
        let qTop : QuotSMulTop t R ≃+ (R ⧸ I) :=
          (Submodule.quotEquivOfEq _ I
            (by rw [← Submodule.ideal_span_singleton_smul]; exact Ideal.mul_top _)).toAddEquiv
        have hsmul_qTop : ∀ (a : R) (z : QuotSMulTop t R),
            qTop (a • z) = (Ideal.Quotient.mk I a) • qTop z := by
          intro a z
          rcases Submodule.Quotient.mk_surjective _ z with ⟨x, rfl⟩
          change Ideal.Quotient.mk I (a * x) = Ideal.Quotient.mk I a * Ideal.Quotient.mk I x
          exact map_mul (Ideal.Quotient.mk I) a x
        have hReg_Q : RingTheory.Sequence.IsWeaklyRegular (R ⧸ I) (ts.map (Ideal.Quotient.mk I)) :=
          (hWeakRegSurjLen len (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
            qTop hsmul_qTop ts hlen).mp hts_reg
        have hMax_Q : Ideal.ofList (ts.map (Ideal.Quotient.mk I)) =
            @IsLocalRing.maximalIdeal (R ⧸ I) _ instLocal_Q := by
          have h_map_max : Ideal.map (Ideal.Quotient.mk I) (IsLocalRing.maximalIdeal R) =
              @IsLocalRing.maximalIdeal (R ⧸ I) _ instLocal_Q := by
            ext q
            rcases Ideal.Quotient.mk_surjective q with ⟨r, rfl⟩
            rw [@IsLocalRing.mem_maximalIdeal (R ⧸ I) _ instLocal_Q]
            constructor
            · intro hmem hunit
              rcases (Ideal.mem_map_iff_of_surjective (Ideal.Quotient.mk I)
                Ideal.Quotient.mk_surjective).mp hmem with ⟨r', hr'm, hr'eq⟩
              have hdiff : r - r' ∈ I := Ideal.Quotient.eq.mp hr'eq.symm
              have hr_mem : r ∈ IsLocalRing.maximalIdeal R := by
                have h1 := Submodule.add_mem (IsLocalRing.maximalIdeal R) hr'm (hI_le hdiff)
                simpa using h1
              rcases hunit with ⟨u, hu⟩
              rcases Ideal.Quotient.mk_surjective ((u⁻¹ : (R ⧸ I)ˣ) : R ⧸ I) with ⟨s, hs⟩
              have hprod_eq : (Ideal.Quotient.mk I) (r * s) = 1 := by
                rw [map_mul, ← hu, hs]
                exact Units.mul_inv u
              have hrs_sub : r * s - 1 ∈ I := Ideal.Quotient.eq.mp hprod_eq
              have h1_mem : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
                have h_rs : r * s ∈ IsLocalRing.maximalIdeal R := Ideal.mul_mem_right s _ hr_mem
                have h_sub : r * s - (r * s - 1) ∈ IsLocalRing.maximalIdeal R :=
                  Submodule.sub_mem _ h_rs (hI_le hrs_sub)
                rwa [sub_sub_cancel] at h_sub
              exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
                (Ideal.eq_top_of_isUnit_mem _ h1_mem isUnit_one)
            · intro hnonunit
              have hr_mem : r ∈ IsLocalRing.maximalIdeal R := by
                rw [IsLocalRing.mem_maximalIdeal]
                exact fun hu => hnonunit (hu.map (Ideal.Quotient.mk I))
              exact Ideal.mem_map_of_mem _ hr_mem
          rw [← h_map_max, ← hMax, Ideal.ofList_cons, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq]
          simp only [Ideal.ofList, Ideal.map_span]
          congr 1
          ext x
          simp
        have hDom_Q : IsDomain (R ⧸ I) :=
          @ih (R ⧸ I) _ instLocal_Q instNoeth_Q _ (by rw [List.length_map, hlen]) hReg_Q hMax_Q
        have hI_prime : I.IsPrime := (Ideal.Quotient.isDomain_iff_prime I).mp hDom_Q
        have hKrull_bot : ⨅ m : ℕ, I ^ m = ⊥ := Ideal.iInf_pow_eq_bot_of_isLocalRing I hI_ne_top
        have hExtract : ∀ x : R, x ≠ 0 → ∃ (a : ℕ) (x' : R), x = t ^ a * x' ∧ x' ∉ I := by
          intro x hx
          classical
          have hnot_all : ∃ m : ℕ, x ∉ I ^ m := by
            by_contra! hall
            have hx_bot : x ∈ (⊥ : Ideal R) := hKrull_bot ▸ Ideal.mem_iInf.mpr hall
            exact hx (Ideal.mem_bot.mp hx_bot)
          let m₀ := Nat.find hnot_all
          have hm₀_spec : x ∉ I ^ m₀ := Nat.find_spec hnot_all
          have hm₀_pos : 1 ≤ m₀ := by
            rcases Nat.eq_zero_or_pos m₀ with hm0 | hpos
            · exfalso
              apply hm₀_spec
              rw [hm0, pow_zero, Ideal.one_eq_top]
              exact Submodule.mem_top
            · exact hpos
          let a := m₀ - 1
          have ha_succ : a + 1 = m₀ := Nat.sub_add_cancel hm₀_pos
          have ha_lt : a < m₀ := by omega
          have hx_mem_a : x ∈ I ^ a := not_not.mp (Nat.find_min hnot_all ha_lt)
          rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hx_mem_a
          rcases hx_mem_a with ⟨x', hx'⟩
          refine ⟨a, x', hx', fun hx'I => hm₀_spec ?_⟩
          rw [← ha_succ, pow_succ, hx']
          exact Ideal.mul_mem_mul (by rw [Ideal.span_singleton_pow]; exact Ideal.subset_span rfl) hx'I
        have _ : NoZeroDivisors R :=
          { eq_zero_or_eq_zero_of_mul_eq_zero := fun {x y} hxy => by
              by_contra! hne
              obtain ⟨hx_ne, hy_ne⟩ := hne
              obtain ⟨a, x', rfl, hx'I⟩ := hExtract x hx_ne
              obtain ⟨b, y', rfl, hy'I⟩ := hExtract y hy_ne
              have hxy'_not_I : x' * y' ∉ I := fun hmem =>
                (hI_prime.mem_or_mem hmem).elim hx'I hy'I
              have hxy'_ne : x' * y' ≠ 0 := fun h0 => hxy'_not_I (h0 ▸ I.zero_mem)
              have hpow_reg : IsSMulRegular R (t ^ (a + b)) := ht_reg.pow (a + b)
              have hprod_zero : (t ^ (a + b)) • (x' * y') = (t ^ (a + b)) • (0 : R) := by
                simp only [smul_eq_mul, mul_zero, pow_add]
                calc t ^ a * t ^ b * (x' * y') = (t ^ a * x') * (t ^ b * y') := by ring
                  _ = 0 := hxy
              exact hxy'_ne (hpow_reg hprod_zero) }
        exact NoZeroDivisors.to_isDomain R

  
  have hStdSmoothAlg : ∀ (m : ℕ) (S : Type u) [CommRing S] (f : k →+* S),
      RingHom.IsStandardSmoothOfRelativeDimension m f →
      (∀ 𝔮 : PrimeSpectrum S, IsDomain (Localization.AtPrime 𝔮.asIdeal)) ∧
      (∀ 𝔮 : PrimeSpectrum S,
        ∃ U_spec : Set (PrimeSpectrum S),
          IsOpen U_spec ∧ 𝔮 ∈ U_spec ∧ IsIrreducible U_spec) ∧
      topologicalKrullDim (PrimeSpectrum S) ≤ (m : WithBot ℕ∞) ∧
      (Nonempty (PrimeSpectrum S) → topologicalKrullDim (PrimeSpectrum S) = (m : WithBot ℕ∞)) := by
    intro m S _ f hf
    obtain ⟨g, hg_comp, hg_et⟩ := RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hf
    let _ : Algebra k S := f.toAlgebra
    let _ : Algebra (MvPolynomial (Fin m) k) S := g.toAlgebra
    have : IsScalarTower k (MvPolynomial (Fin m) k) S := IsScalarTower.of_algebraMap_eq' hg_comp.symm
    have : Algebra.Etale (MvPolynomial (Fin m) k) S := hg_et.toAlgebra
    have : IsNoetherianRing k := hk_noeth
    have instFT_kS : Algebra.FiniteType k S :=
      Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType k (MvPolynomial (Fin m) k))
        (inferInstance : Algebra.FiniteType (MvPolynomial (Fin m) k) S)
    have instNoeth_S : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing k S
    
    have hMaxDom : ∀ (𝔪 : Ideal S) [𝔪.IsMaximal],
        IsDomain (Localization.AtPrime 𝔪) ∧
        ringKrullDim (Localization.AtPrime 𝔪) = (m : WithBot ℕ∞) := by
      intro 𝔪 h𝔪_max
      let 𝔭 : Ideal (MvPolynomial (Fin m) k) := Ideal.comap g 𝔪
      have h𝔭_prime : 𝔭.IsPrime := Ideal.comap_isPrime g 𝔪
      obtain ⟨r_gen, ψ_gen, hψ_surj⟩ := (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := S)).mp instFT_kS
      let 𝔐 : Ideal (MvPolynomial (Fin r_gen) k) := Ideal.comap ψ_gen.toRingHom 𝔪
      have h𝔐_max : 𝔐.IsMaximal := by
        rw [Ideal.Quotient.maximal_ideal_iff_isField_quotient]
        let qMap : (MvPolynomial (Fin r_gen) k ⧸ 𝔐) →+* (S ⧸ 𝔪) :=
          Ideal.quotientMap 𝔪 ψ_gen.toRingHom le_rfl
        have hq_inj : Function.Injective qMap := Ideal.quotientMap_injective' le_rfl
        have hq_surj : Function.Surjective qMap := by
          intro y
          rcases Ideal.Quotient.mk_surjective y with ⟨s, rfl⟩
          rcases hψ_surj s with ⟨p₀, rfl⟩
          exact ⟨Ideal.Quotient.mk 𝔐 p₀, rfl⟩
        let e_field : (MvPolynomial (Fin r_gen) k ⧸ 𝔐) ≃+* (S ⧸ 𝔪) :=
          RingEquiv.ofBijective qMap ⟨hq_inj, hq_surj⟩
        let instField_Sm : Field (S ⧸ 𝔪) := Ideal.Quotient.field 𝔪
        exact MulEquiv.isField instField_Sm.toIsField e_field.toMulEquiv
      obtain ⟨b_pt, hb_pt⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp h𝔐_max
      have hk_surj_Sm : Function.Surjective ((Ideal.Quotient.mk 𝔪).comp f) := by
        intro y
        rcases Ideal.Quotient.mk_surjective y with ⟨s, rfl⟩
        rcases hψ_surj s with ⟨p₀, rfl⟩
        let c₀ : k := MvPolynomial.aeval b_pt p₀
        refine ⟨c₀, ?_⟩
        have hp_sub : p₀ - MvPolynomial.C c₀ ∈ 𝔐 := by
          rw [hb_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
          simp [c₀]
        rw [Ideal.mem_comap] at hp_sub
        have hψ_C : ψ_gen.toRingHom (MvPolynomial.C c₀) = f c₀ := ψ_gen.commutes c₀
        rw [map_sub, hψ_C] at hp_sub
        exact (Ideal.Quotient.eq.mpr hp_sub).symm
      have h𝔭_max : 𝔭.IsMaximal := by
        rw [Ideal.Quotient.maximal_ideal_iff_isField_quotient]
        let ι_pq : (MvPolynomial (Fin m) k ⧸ 𝔭) →+* (S ⧸ 𝔪) := Ideal.quotientMap 𝔪 g le_rfl
        have hι_inj : Function.Injective ι_pq := Ideal.quotientMap_injective' le_rfl
        have hι_surj : Function.Surjective ι_pq := by
          intro y
          obtain ⟨c₀, hc₀⟩ := hk_surj_Sm y
          refine ⟨Ideal.Quotient.mk 𝔭 (MvPolynomial.C c₀), ?_⟩
          change Ideal.Quotient.mk 𝔪 (g (MvPolynomial.C c₀)) = y
          have hgc : g (MvPolynomial.C c₀) = f c₀ := RingHom.congr_fun hg_comp c₀
          rw [hgc]
          exact hc₀
        let instField_Sm : Field (S ⧸ 𝔪) := Ideal.Quotient.field 𝔪
        exact MulEquiv.isField instField_Sm.toIsField
          (RingEquiv.ofBijective ι_pq ⟨hι_inj, hι_surj⟩).toMulEquiv
      obtain ⟨a_pt, ha_pt⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp h𝔭_max
      have h𝔭_ker : 𝔭 = RingHom.ker (MvPolynomial.aeval a_pt).toRingHom := by
        rw [ha_pt]
        ext p
        exact MvPolynomial.mem_vanishingIdeal_singleton_iff a_pt p
      
      let τ_alg : MvPolynomial (Fin m) k →ₐ[k] MvPolynomial (Fin m) k :=
        MvPolynomial.aeval (fun i : Fin m => MvPolynomial.X i - MvPolynomial.C (a_pt i))
      let τ_alg_inv : MvPolynomial (Fin m) k →ₐ[k] MvPolynomial (Fin m) k :=
        MvPolynomial.aeval (fun i : Fin m => MvPolynomial.X i + MvPolynomial.C (a_pt i))
      have hτ_left : τ_alg_inv.comp τ_alg = AlgHom.id k (MvPolynomial (Fin m) k) := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [AlgHom.comp_apply, AlgHom.id_apply]
        dsimp only [τ_alg, τ_alg_inv]
        rw [MvPolynomial.aeval_X, map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
          MvPolynomial.algebraMap_eq, add_sub_cancel_right]
      have hτ_right : τ_alg.comp τ_alg_inv = AlgHom.id k (MvPolynomial (Fin m) k) := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [AlgHom.comp_apply, AlgHom.id_apply]
        dsimp only [τ_alg, τ_alg_inv]
        rw [MvPolynomial.aeval_X, map_add, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
          MvPolynomial.algebraMap_eq, sub_add_cancel]
      let τ_eq : MvPolynomial (Fin m) k ≃+* MvPolynomial (Fin m) k :=
        (AlgEquiv.ofAlgHom τ_alg τ_alg_inv hτ_right hτ_left).toRingEquiv
      obtain ⟨hReg0, hKer0⟩ := hMvPolyOriginReg m
      let L_a : List (MvPolynomial (Fin m) k) := ((List.finRange m).map MvPolynomial.X).map ⇑τ_eq
      have hReg_La : RingTheory.Sequence.IsWeaklyRegular (MvPolynomial (Fin m) k) L_a :=
        hWeakRegEquiv τ_eq _ hReg0
      have hIdeal_La : Ideal.ofList L_a = 𝔭 := by
        rw [h𝔭_ker]
        have hmap_L : Ideal.ofList L_a =
            Ideal.comap τ_eq.symm.toRingHom (Ideal.ofList ((List.finRange m).map MvPolynomial.X)) := by
          have h1 : Ideal.ofList L_a =
              Ideal.map τ_eq.toRingHom (Ideal.ofList ((List.finRange m).map MvPolynomial.X)) := by
            simp only [L_a, Ideal.ofList, Ideal.map_span]
            congr 1
            ext x
            simp
          rw [h1]
          ext p
          rw [Ideal.mem_comap]
          constructor
          · intro h
            have hm := Ideal.mem_map_of_mem τ_eq.symm.toRingHom h
            rw [Ideal.map_map] at hm
            have hid : τ_eq.symm.toRingHom.comp τ_eq.toRingHom = RingHom.id _ :=
              RingHom.ext fun x => τ_eq.symm_apply_apply x
            rwa [hid, Ideal.map_id] at hm
          · intro h
            have hm := Ideal.mem_map_of_mem τ_eq.toRingHom h
            simpa only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.apply_symm_apply] using hm
        rw [hmap_L, hKer0]
        ext p
        rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.mem_ker]
        have hev_alg : (MvPolynomial.aeval (0 : Fin m → k)).comp τ_alg_inv =
            MvPolynomial.aeval a_pt := by
          apply MvPolynomial.algHom_ext
          intro i
          rw [AlgHom.comp_apply]
          dsimp only [τ_alg_inv]
          simp
        exact Iff.of_eq (congrArg (· = 0) (AlgHom.congr_fun hev_alg p))
      
      let S_m := Localization.AtPrime 𝔪
      let P_p := Localization.AtPrime 𝔭
      let g_loc : P_p →+* S_m := Localization.localRingHom 𝔭 𝔪 g rfl
      have instLocalHom_gloc : IsLocalHom g_loc := Localization.isLocalHom_localRingHom 𝔭 𝔪 g rfl
      let instAlg_PSm : Algebra (MvPolynomial (Fin m) k) S_m := ((algebraMap S S_m).comp g).toAlgebra
      have instTower_PSSm : @IsScalarTower (MvPolynomial (Fin m) k) S S_m _ _ instAlg_PSm.toSMul :=
        @IsScalarTower.of_algebraMap_eq' (MvPolynomial (Fin m) k) S S_m _ _ _ _ _ instAlg_PSm rfl
      let instAlg_PpSm : Algebra P_p S_m := g_loc.toAlgebra
      have instTower_PPpSm : @IsScalarTower (MvPolynomial (Fin m) k) P_p S_m _
          instAlg_PpSm.toSMul instAlg_PSm.toSMul :=
        @IsScalarTower.of_algebraMap_eq' (MvPolynomial (Fin m) k) P_p S_m _ _ _ _ instAlg_PpSm instAlg_PSm
          (RingHom.ext fun p => (Localization.localRingHom_to_map 𝔭 𝔪 g rfl p).symm)
      have instFlat_SSm : Module.Flat S S_m := IsLocalization.flat S_m 𝔪.primeCompl
      have instFlat_PSm : @Module.Flat (MvPolynomial (Fin m) k) S_m _ _ instAlg_PSm.toModule :=
        @Module.Flat.trans (MvPolynomial (Fin m) k) S S_m _ _ _ _ instAlg_PSm.toModule _
          instTower_PSSm inferInstance instFlat_SSm
      have hReg_Sm : RingTheory.Sequence.IsWeaklyRegular S_m
          (L_a.map (@algebraMap (MvPolynomial (Fin m) k) S_m _ _ instAlg_PSm)) :=
        @RingTheory.Sequence.IsWeaklyRegular.of_flat (MvPolynomial (Fin m) k) S_m _ _
          instAlg_PSm instFlat_PSm L_a hReg_La
      have instUnram_PSm : @Algebra.FormallyUnramified (MvPolynomial (Fin m) k) S_m _ _ instAlg_PSm := by
        have h1 : Algebra.FormallyUnramified S S_m :=
          Algebra.FormallyUnramified.of_isLocalization 𝔪.primeCompl
        exact @Algebra.FormallyUnramified.comp (MvPolynomial (Fin m) k) _ S _ _ S_m _
          instAlg_PSm _ instTower_PSSm inferInstance h1
      have instUnram_PpSm : @Algebra.FormallyUnramified P_p S_m _ _ instAlg_PpSm := by
        rw [@Algebra.FormallyUnramified.iff_comp_injective P_p _ S_m _ instAlg_PpSm]
        intro B _ instAlg_PpB I hI2 φ₁ φ₂ hEq
        let instAlg_PB : Algebra (MvPolynomial (Fin m) k) B :=
          ((@algebraMap P_p B _ _ instAlg_PpB).comp (algebraMap (MvPolynomial (Fin m) k) P_p)).toAlgebra
        have instTower_PPpB : @IsScalarTower (MvPolynomial (Fin m) k) P_p B _
            instAlg_PpB.toSMul instAlg_PB.toSMul :=
          @IsScalarTower.of_algebraMap_eq' (MvPolynomial (Fin m) k) P_p B _ _ _ _ instAlg_PpB instAlg_PB rfl
        let φ₁' : @AlgHom (MvPolynomial (Fin m) k) S_m B _ _ _ instAlg_PSm instAlg_PB :=
          @AlgHom.restrictScalars (MvPolynomial (Fin m) k) P_p S_m B _ _ _ _ _
            instAlg_PpSm instAlg_PpB instAlg_PSm instAlg_PB instTower_PPpSm instTower_PPpB φ₁
        let φ₂' : @AlgHom (MvPolynomial (Fin m) k) S_m B _ _ _ instAlg_PSm instAlg_PB :=
          @AlgHom.restrictScalars (MvPolynomial (Fin m) k) P_p S_m B _ _ _ _ _
            instAlg_PpSm instAlg_PpB instAlg_PSm instAlg_PB instTower_PPpSm instTower_PPpB φ₂
        have hEq' : (@Ideal.Quotient.mkₐ (MvPolynomial (Fin m) k) B _ _ instAlg_PB I).comp φ₁' =
            (@Ideal.Quotient.mkₐ (MvPolynomial (Fin m) k) B _ _ instAlg_PB I).comp φ₂' := by
          ext s
          exact AlgHom.congr_fun hEq s
        have hφ_eq := (@Algebra.FormallyUnramified.comp_injective (MvPolynomial (Fin m) k) _
          S_m _ instAlg_PSm B _ instAlg_PB I instUnram_PSm hI2) hEq'
        ext s
        exact AlgHom.congr_fun hφ_eq s
      have instEssFT_SSm : Algebra.EssFiniteType S S_m :=
        Algebra.EssFiniteType.of_isLocalization S_m 𝔪.primeCompl
      have instEssFT_PSm : @Algebra.EssFiniteType (MvPolynomial (Fin m) k) S_m _ _ instAlg_PSm :=
        @Algebra.EssFiniteType.comp (MvPolynomial (Fin m) k) S S_m _ _ _ _ instAlg_PSm _
          instTower_PSSm inferInstance instEssFT_SSm
      have instEssFT_PpSm : @Algebra.EssFiniteType P_p S_m _ _ instAlg_PpSm :=
        @Algebra.EssFiniteType.of_comp (MvPolynomial (Fin m) k) P_p S_m _ _ _ _
          instAlg_PSm instAlg_PpSm instTower_PPpSm instEssFT_PSm
      have hMax_map : Ideal.map g_loc (IsLocalRing.maximalIdeal P_p) = IsLocalRing.maximalIdeal S_m :=
        @Algebra.FormallyUnramified.map_maximalIdeal P_p S_m _ _ instAlg_PpSm _ _
          instLocalHom_gloc instEssFT_PpSm instUnram_PpSm
      have hMax_Pp : Ideal.map (algebraMap (MvPolynomial (Fin m) k) P_p) 𝔭 = IsLocalRing.maximalIdeal P_p :=
        IsLocalization.AtPrime.map_eq_maximalIdeal 𝔭 P_p
      have hMax_Sm : Ideal.ofList (L_a.map (@algebraMap (MvPolynomial (Fin m) k) S_m _ _ instAlg_PSm)) =
          IsLocalRing.maximalIdeal S_m := by
        have h1 : IsLocalRing.maximalIdeal S_m =
            Ideal.map (@algebraMap (MvPolynomial (Fin m) k) S_m _ _ instAlg_PSm) 𝔭 := by
          rw [← hMax_map, ← hMax_Pp, Ideal.map_map]
          have hcomp_eq : g_loc.comp (algebraMap (MvPolynomial (Fin m) k) P_p) =
              @algebraMap (MvPolynomial (Fin m) k) S_m _ _ instAlg_PSm :=
            (@IsScalarTower.algebraMap_eq (MvPolynomial (Fin m) k) P_p S_m _ _ _ _
              instAlg_PpSm instAlg_PSm instTower_PPpSm).symm
          rw [hcomp_eq]
        rw [h1, ← hIdeal_La]
        simp only [Ideal.ofList, Ideal.map_span]
        congr 1
        ext x
        simp
      have instNoeth_Sm : IsNoetherianRing S_m := IsLocalization.isNoetherianRing 𝔪.primeCompl S_m instNoeth_S
      let L_Sm : List S_m := L_a.map (@algebraMap (MvPolynomial (Fin m) k) S_m _ _ instAlg_PSm)
      have hDom_Sm : IsDomain S_m := @hLocalWeakRegDomainLen _ S_m _ _ instNoeth_Sm L_Sm rfl hReg_Sm hMax_Sm
      have hSub_max : ∀ x ∈ L_Sm, x ∈ IsLocalRing.maximalIdeal S_m := by
        intro x hx
        rw [← hMax_Sm]
        exact Ideal.subset_span hx
      have hIsReg_Sm : RingTheory.Sequence.IsRegular S_m L_Sm :=
        (@IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal S_m S_m _ _ _ _ _ _
          L_Sm hSub_max).mpr hReg_Sm
      have hDim_eq := @ringKrullDim_add_length_eq_ringKrullDim_of_isRegular S_m _ instNoeth_Sm _
        L_Sm hIsReg_Sm
      have hQuot_field : IsField (S_m ⧸ Ideal.ofList L_Sm) := by
        have hMax_quot : (Ideal.ofList L_Sm).IsMaximal := by
          rw [hMax_Sm]
          exact IsLocalRing.maximalIdeal.isMaximal S_m
        exact (@Ideal.Quotient.field _ _ (Ideal.ofList L_Sm) hMax_quot).toIsField
      have hDim_quot : ringKrullDim (S_m ⧸ Ideal.ofList L_Sm) = 0 :=
        ringKrullDim_eq_zero_of_isField hQuot_field
      have hLen_LSm : L_Sm.length = m := by
        simp [L_Sm, L_a]
      rw [hDim_quot, hLen_LSm, zero_add] at hDim_eq
      exact ⟨hDom_Sm, hDim_eq.symm⟩
    
    have hAllDom : ∀ 𝔮 : PrimeSpectrum S, IsDomain (Localization.AtPrime 𝔮.asIdeal) := by
      intro 𝔮
      obtain ⟨𝔪, h𝔪_max, h𝔮_le⟩ := Ideal.exists_le_maximal 𝔮.asIdeal 𝔮.isPrime.ne_top
      have hDom_m : IsDomain (Localization.AtPrime 𝔪) := (@hMaxDom 𝔪 h𝔪_max).1
      have _ : 𝔮.asIdeal.IsPrime := 𝔮.isPrime
      have _ : NoZeroDivisors (Localization.AtPrime 𝔮.asIdeal) :=
        { eq_zero_or_eq_zero_of_mul_eq_zero := fun {z₁ z₂} hz_mul => by
            revert hz_mul
            refine Localization.induction_on z₁ fun ⟨x₁, s₁⟩ => ?_
            refine Localization.induction_on z₂ fun ⟨x₂, s₂⟩ hz_mul => ?_
            rw [Localization.mk_mul, Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff] at hz_mul
            rcases hz_mul with ⟨u, hu_zero⟩
            have h_in_m : (algebraMap S (Localization.AtPrime 𝔪) (↑u * x₁)) *
                (algebraMap S (Localization.AtPrime 𝔪) x₂) = 0 := by
              rw [← map_mul, mul_assoc]
              have hux : (u : S) * (x₁ * x₂) = 0 := hu_zero
              rw [hux, map_zero]
            rcases mul_eq_zero.mp h_in_m with h1 | h2
            · left
              obtain ⟨t, ht_eq⟩ := (IsLocalization.map_eq_zero_iff 𝔪.primeCompl (Localization.AtPrime 𝔪) _).mp h1
              have ht_q : (t : S) ∈ 𝔮.asIdeal.primeCompl := fun ht_in => t.2 (h𝔮_le ht_in)
              rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff]
              exact ⟨⟨(t : S) * (u : S), Submonoid.mul_mem _ ht_q u.2⟩, by simpa [mul_assoc] using ht_eq⟩
            · right
              obtain ⟨t, ht_eq⟩ := (IsLocalization.map_eq_zero_iff 𝔪.primeCompl (Localization.AtPrime 𝔪) _).mp h2
              have ht_q : (t : S) ∈ 𝔮.asIdeal.primeCompl := fun ht_in => t.2 (h𝔮_le ht_in)
              rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff]
              exact ⟨⟨(t : S), ht_q⟩, ht_eq⟩ }
      exact NoZeroDivisors.to_isDomain (Localization.AtPrime 𝔮.asIdeal)
    
    let M_min : Set (Ideal S) := minimalPrimes S
    have hFin_min : M_min.Finite := minimalPrimes.finite_of_isNoetherianRing S
    have hUnique_min : ∀ (𝔮' : PrimeSpectrum S) {𝔭₁ 𝔭₂ : Ideal S},
        𝔭₁ ∈ M_min → 𝔭₂ ∈ M_min → 𝔭₁ ≤ 𝔮'.asIdeal → 𝔭₂ ≤ 𝔮'.asIdeal → 𝔭₁ = 𝔭₂ := by
      intro 𝔮' 𝔭₁ 𝔭₂ h₁ h₂ hle₁ hle₂
      have hDom_q' : IsDomain (Localization.AtPrime 𝔮'.asIdeal) := hAllDom 𝔮'
      let 𝔯 : Ideal S := Ideal.comap (algebraMap S (Localization.AtPrime 𝔮'.asIdeal)) ⊥
      have hbot_prime : (⊥ : Ideal (Localization.AtPrime 𝔮'.asIdeal)).IsPrime :=
        { ne_top' := bot_ne_top
          mem_or_mem' := fun {a b} hab => by simpa using hab }
      have h𝔯_prime : 𝔯.IsPrime := Ideal.comap_isPrime _ ⊥
      have h𝔯_le : ∀ {𝔭 : Ideal S}, 𝔭.IsPrime → 𝔭 ≤ 𝔮'.asIdeal → 𝔯 ≤ 𝔭 := by
        intro 𝔭 h𝔭_pr h𝔭_le x hx
        rw [Ideal.mem_comap, Ideal.mem_bot] at hx
        obtain ⟨s, hs_eq⟩ := (IsLocalization.map_eq_zero_iff 𝔮'.asIdeal.primeCompl
          (Localization.AtPrime 𝔮'.asIdeal) x).mp hx
        have hs_not : (s : S) ∉ 𝔭 := fun hs_in => s.2 (h𝔭_le hs_in)
        exact (h𝔭_pr.mem_or_mem (hs_eq ▸ 𝔭.zero_mem)).resolve_left hs_not
      have h1_eq : 𝔭₁ = 𝔯 := le_antisymm (h₁.2 ⟨h𝔯_prime, bot_le⟩ (h𝔯_le h₁.1.1 hle₁)) (h𝔯_le h₁.1.1 hle₁)
      have h2_eq : 𝔭₂ = 𝔯 := le_antisymm (h₂.2 ⟨h𝔯_prime, bot_le⟩ (h𝔯_le h₂.1.1 hle₂)) (h𝔯_le h₂.1.1 hle₂)
      exact h1_eq.trans h2_eq.symm
    have hOpenIrred : ∀ 𝔮 : PrimeSpectrum S,
        ∃ U_spec : Set (PrimeSpectrum S),
          IsOpen U_spec ∧ 𝔮 ∈ U_spec ∧ IsIrreducible U_spec := by
      intro 𝔮
      obtain ⟨𝔭₀, h𝔭₀_min, h𝔭₀_le⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal S) ≤ 𝔮.asIdeal)
      let U_spec : Set (PrimeSpectrum S) := PrimeSpectrum.zeroLocus (𝔭₀ : Set S)
      have hU_compl : U_spec = (⋃ 𝔭' ∈ M_min \ {𝔭₀}, PrimeSpectrum.zeroLocus (𝔭' : Set S))ᶜ := by
        ext 𝔮'
        simp only [U_spec, Set.mem_compl_iff, Set.mem_iUnion, PrimeSpectrum.mem_zeroLocus,
          SetLike.coe_subset_coe, not_exists]
        constructor
        · intro h₀ 𝔭' h𝔭'_diff h'
          exact h𝔭'_diff.2 (hUnique_min 𝔮' h𝔭'_diff.1 h𝔭₀_min h' h₀)
        · intro hnot
          obtain ⟨𝔭', h𝔭'_min, h𝔭'_le⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal S) ≤ 𝔮'.asIdeal)
          by_cases heq : 𝔭' = 𝔭₀
          · rwa [← heq]
          · exfalso; exact hnot 𝔭' ⟨h𝔭'_min, heq⟩ h𝔭'_le
      have hClosed_union : IsClosed (⋃ 𝔭' ∈ M_min \ {𝔭₀}, PrimeSpectrum.zeroLocus (𝔭' : Set S)) :=
        hFin_min.sdiff.isClosed_biUnion fun 𝔭' _ => PrimeSpectrum.isClosed_zeroLocus _
      have hOpen_U : IsOpen U_spec := by
        rw [hU_compl]
        exact hClosed_union.isOpen_compl
      have h𝔮_mem : 𝔮 ∈ U_spec := by
        rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
        exact h𝔭₀_le
      have hIrred_U : IsIrreducible U_spec := by
        rw [PrimeSpectrum.isIrreducible_zeroLocus_iff]
        rw [𝔭₀.radical_eq_iff.mpr h𝔭₀_min.1.1.isRadical]
        exact h𝔭₀_min.1.1
      exact ⟨U_spec, hOpen_U, h𝔮_mem, hIrred_U⟩
    
    have hDim_S_le : topologicalKrullDim (PrimeSpectrum S) ≤ (m : WithBot ℕ∞) := by
      rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
      change Order.krullDim (PrimeSpectrum S) ≤ (m : WithBot ℕ∞)
      rcases isEmpty_or_nonempty (PrimeSpectrum S) with hEmp | _
      · rw [Order.krullDim_eq_bot_iff.mpr hEmp]
        exact bot_le
      · rw [Order.krullDim_eq_iSup_length]
        change ((⨆ p : LTSeries (PrimeSpectrum S), (p.length : ℕ∞) : ℕ∞) : WithBot ℕ∞) ≤
          ((m : ℕ∞) : WithBot ℕ∞)
        rw [WithBot.coe_le_coe]
        refine iSup_le fun p => ?_
        let 𝔮_top := p (Fin.last p.length)
        obtain ⟨𝔪, h𝔪_max, htop_le⟩ := Ideal.exists_le_maximal 𝔮_top.asIdeal 𝔮_top.isPrime.ne_top
        have hDim_m : ringKrullDim (Localization.AtPrime 𝔪) = (m : WithBot ℕ∞) := (@hMaxDom 𝔪 h𝔪_max).2
        let e_ord := (IsLocalization.AtPrime.orderIsoOfPrime (Localization.AtPrime 𝔪) 𝔪).symm
        have hp_le_m : ∀ i : Fin (p.length + 1), (p i).asIdeal ≤ 𝔪 :=
          fun i => (show (p i).asIdeal ≤ 𝔮_top.asIdeal from p.monotone (Fin.le_last i)).trans htop_le
        let q_fun : Fin (p.length + 1) → PrimeSpectrum (Localization.AtPrime 𝔪) := fun i =>
          let P_i := e_ord ⟨(p i).asIdeal, (p i).isPrime, hp_le_m i⟩
          ⟨P_i.1, P_i.2⟩
        let q_series : LTSeries (PrimeSpectrum (Localization.AtPrime 𝔪)) :=
          { length := p.length
            toFun := q_fun
            step := fun i => by
              have hlt : p (Fin.castSucc i) < p i.succ := p.step i
              show q_fun (Fin.castSucc i) < q_fun i.succ
              exact e_ord.strictMono (show (⟨(p (Fin.castSucc i)).asIdeal, (p (Fin.castSucc i)).isPrime,
                hp_le_m (Fin.castSucc i)⟩ : { I : Ideal S // I.IsPrime ∧ I ≤ 𝔪 }) <
                ⟨(p i.succ).asIdeal, (p i.succ).isPrime, hp_le_m i.succ⟩ from hlt) }
        have hlen : ((p.length : ℕ∞) : WithBot ℕ∞) ≤ ringKrullDim (Localization.AtPrime 𝔪) :=
          Order.LTSeries.length_le_krullDim q_series
        exact WithBot.coe_le_coe.mp (hlen.trans hDim_m.le)
    have hDim_S_eq : Nonempty (PrimeSpectrum S) →
        topologicalKrullDim (PrimeSpectrum S) = (m : WithBot ℕ∞) := by
      rintro ⟨𝔮₀⟩
      apply le_antisymm hDim_S_le
      obtain ⟨𝔪, h𝔪_max, _⟩ := Ideal.exists_le_maximal 𝔮₀.asIdeal 𝔮₀.isPrime.ne_top
      have hDim_m : ringKrullDim (Localization.AtPrime 𝔪) = (m : WithBot ℕ∞) := (@hMaxDom 𝔪 h𝔪_max).2
      rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim, ← hDim_m]
      let g_comap : PrimeSpectrum (Localization.AtPrime 𝔪) → PrimeSpectrum S :=
        PrimeSpectrum.comap (algebraMap S (Localization.AtPrime 𝔪))
      have hStrict : StrictMono g_comap := by
        intro P₁ P₂ hlt
        rw [lt_iff_le_not_ge] at hlt ⊢
        refine ⟨Ideal.comap_mono hlt.1, fun hge => hlt.2 ?_⟩
        have hcomap_eq : Ideal.comap (algebraMap S (Localization.AtPrime 𝔪)) P₁.asIdeal =
            Ideal.comap (algebraMap S (Localization.AtPrime 𝔪)) P₂.asIdeal :=
          le_antisymm (Ideal.comap_mono hlt.1) hge
        have hord_eq : IsLocalization.AtPrime.orderIsoOfPrime (Localization.AtPrime 𝔪) 𝔪 ⟨P₁.asIdeal, P₁.isPrime⟩ =
            IsLocalization.AtPrime.orderIsoOfPrime (Localization.AtPrime 𝔪) 𝔪 ⟨P₂.asIdeal, P₂.isPrime⟩ :=
          Subtype.ext hcomap_eq
        have hP_eq := (IsLocalization.AtPrime.orderIsoOfPrime (Localization.AtPrime 𝔪) 𝔪).injective hord_eq
        have hIdeal_eq : P₁.asIdeal = P₂.asIdeal := congrArg Subtype.val hP_eq
        exact hIdeal_eq.ge
      exact Order.krullDim_le_of_strictMono g_comap hStrict
    exact ⟨hAllDom, hOpenIrred, hDim_S_le, hDim_S_eq⟩

  
  
  
  have hLocIrred : ∀ (T : Type u) [TopologicalSpace T],
      (∀ x : T, ∃ O : Set T, IsOpen O ∧ x ∈ O ∧ IsIrreducible O) →
      (∀ x : T, IsOpen (irreducibleComponent x)) ∧
      (∀ (x : T) (S : Set T), IsPreirreducible S → x ∈ S → S ⊆ irreducibleComponent x) ∧
      (∀ n : ℕ,
        (∀ x : T, topologicalKrullDim ↥(irreducibleComponent x) ≤ (n : WithBot ℕ∞)) →
        topologicalKrullDim T ≤ (n : WithBot ℕ∞)) := by
    intro T _ hLoc
    have hOpen : ∀ x : T, IsOpen (irreducibleComponent x) := by
      intro x
      rw [isOpen_iff_forall_mem_open]
      intro y hy
      obtain ⟨O_y, hOpen_O, hy_O, hIrred_O⟩ := hLoc y
      have h_cov : irreducibleComponent x ⊆ closure O_y ∪ O_yᶜ := fun z _ => by
        by_cases hz : z ∈ O_y
        · exact Or.inl (subset_closure hz)
        · exact Or.inr hz
      have h_split := isPreirreducible_iff_isClosed_union_isClosed.mp
        isIrreducible_irreducibleComponent.isPreirreducible
        (closure O_y) O_yᶜ isClosed_closure hOpen_O.isClosed_compl h_cov
      have h_sub : irreducibleComponent x ⊆ closure O_y :=
        h_split.resolve_right fun h_compl => h_compl hy hy_O
      have h_eq : closure O_y = irreducibleComponent x :=
        (irreducibleComponent_property x).2.2 (closure O_y) hIrred_O.closure.isPreirreducible h_sub
      exact ⟨O_y, subset_closure.trans_eq h_eq, hOpen_O, hy_O⟩
    have hSub : ∀ (x : T) (S : Set T), IsPreirreducible S → x ∈ S → S ⊆ irreducibleComponent x := by
      intro x S hPre hxS
      have h_cov : S ⊆ irreducibleComponent x ∪ (irreducibleComponent x)ᶜ :=
        fun z _ => Classical.em (z ∈ irreducibleComponent x)
      have h_split := isPreirreducible_iff_isClosed_union_isClosed.mp hPre
        (irreducibleComponent x) (irreducibleComponent x)ᶜ
        isClosed_irreducibleComponent (hOpen x).isClosed_compl h_cov
      exact h_split.resolve_right fun h_compl => h_compl hxS mem_irreducibleComponent
    refine ⟨hOpen, hSub, fun n hBound => ?_⟩
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds T) ≤ (n : WithBot ℕ∞)
    rcases isEmpty_or_nonempty (TopologicalSpace.IrreducibleCloseds T) with hEmp | _
    · rw [Order.krullDim_eq_bot_iff.mpr hEmp]
      exact bot_le
    · rw [Order.krullDim_eq_iSup_length]
      change ((⨆ p : LTSeries (TopologicalSpace.IrreducibleCloseds T), (p.length : ℕ∞) : ℕ∞) : WithBot ℕ∞) ≤
        ((n : ℕ∞) : WithBot ℕ∞)
      rw [WithBot.coe_le_coe]
      refine iSup_le fun p => ?_
      let Z_top := p (Fin.last p.length)
      obtain ⟨y₀, hy₀⟩ := Z_top.isIrreducible.nonempty
      let C := irreducibleComponent y₀
      have hZ_sub : (Z_top : Set T) ⊆ C := hSub y₀ Z_top Z_top.isIrreducible.isPreirreducible hy₀
      have hp_sub : ∀ i : Fin (p.length + 1), (p i : Set T) ⊆ C :=
        fun i => (show (p i : Set T) ⊆ (Z_top : Set T) from p.monotone (Fin.le_last i)).trans hZ_sub
      have hEmb : Topology.IsOpenEmbedding (Subtype.val : ↥C → T) :=
        (hOpen y₀).isOpenEmbedding_subtypeVal
      let q_fun : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥C := fun i =>
        { carrier := Subtype.val ⁻¹' (p i : Set T)
          isIrreducible' := by
            obtain ⟨w, hw⟩ := (p i).isIrreducible.nonempty
            exact ⟨⟨⟨w, hp_sub i hw⟩, hw⟩, (p i).isIrreducible.isPreirreducible.preimage hEmb⟩
          isClosed' := (p i).isClosed.preimage continuous_subtype_val }
      let q_series : LTSeries (TopologicalSpace.IrreducibleCloseds ↥C) :=
        { length := p.length
          toFun := q_fun
          step := fun i => by
            have hlt : p (Fin.castSucc i) < p i.succ := p.step i
            show q_fun (Fin.castSucc i) < q_fun i.succ
            rw [lt_iff_le_not_ge] at hlt ⊢
            refine ⟨fun x hx => hlt.1 hx, fun hge => hlt.2 fun z hz => ?_⟩
            exact hge (show (⟨z, hp_sub i.succ hz⟩ : ↥C) ∈ q_fun i.succ from hz) }
      have hlen : ((p.length : ℕ∞) : WithBot ℕ∞) ≤ topologicalKrullDim ↥C :=
        Order.LTSeries.length_le_krullDim q_series
      have hle := hlen.trans (hBound y₀)
      exact WithBot.coe_le_coe.mp hle

  
  
  
  let P₁ := weilProjectiveSpaceOver k 1
  have hExcDimLe : ∀ (C : Set ↥Z_tilde.left),
      (∀ z ∈ C, π₀.left.base z ∉ U_axis) →
      topologicalKrullDim ↥C ≤
        topologicalKrullDim ↥(CategoryTheory.Limits.pullback B₀.hom P₁.hom) := by
    intro C hC_disj
    set Q_Z := CategoryTheory.Limits.pullback Z_bar.hom P₁.hom
    set fst_Z := CategoryTheory.Limits.pullback.fst Z_bar.hom P₁.hom
    set snd_Z := CategoryTheory.Limits.pullback.snd Z_bar.hom P₁.hom
    set Q_B := CategoryTheory.Limits.pullback B₀.hom P₁.hom
    set fst_B := CategoryTheory.Limits.pullback.fst B₀.hom P₁.hom
    set snd_B := CategoryTheory.Limits.pullback.snd B₀.hom P₁.hom
    have hjB_comm : (fst_B ≫ ι_B.left) ≫ Z_bar.hom = snd_B ≫ P₁.hom := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w ι_B]
      exact CategoryTheory.Limits.pullback.condition
    let j_B : Q_B ⟶ Q_Z := CategoryTheory.Limits.pullback.lift (fst_B ≫ ι_B.left) snd_B hjB_comm
    have hPb_outer : CategoryTheory.IsPullback (j_B ≫ snd_Z) fst_B P₁.hom (ι_B.left ≫ Z_bar.hom) := by
      rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Over.w ι_B]
      exact (CategoryTheory.IsPullback.of_hasPullback B₀.hom P₁.hom).flip
    have hPb_right : CategoryTheory.IsPullback snd_Z fst_Z P₁.hom Z_bar.hom :=
      (CategoryTheory.IsPullback.of_hasPullback Z_bar.hom P₁.hom).flip
    have hPb : CategoryTheory.IsPullback fst_B j_B ι_B.left fst_Z :=
      (CategoryTheory.IsPullback.of_right hPb_outer (CategoryTheory.Limits.pullback.lift_fst _ _ _) hPb_right).flip
    have hCl_jB : AlgebraicGeometry.IsClosedImmersion j_B :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb hCl_B
    have hjB_ind : Topology.IsInducing j_B.base := j_B.isClosedEmbedding.isInducing
    let ι_prod : Z_tilde.left ⟶ Q_Z :=
      CategoryTheory.Limits.pullback.lift π₀.left f₀.left
        ((CategoryTheory.Over.w π₀).trans (CategoryTheory.Over.w f₀).symm)
    have hCl_iprod : AlgebraicGeometry.IsClosedImmersion ι_prod := hCl_prod
    have hι_ind : Topology.IsInducing ι_prod.base := ι_prod.isClosedEmbedding.isInducing
    let e_PB : Q_B ≅ CategoryTheory.Limits.pullback ι_B.left fst_Z := hPb.isoPullback
    have he_PB_snd : e_PB.inv ≫ j_B = CategoryTheory.Limits.pullback.snd ι_B.left fst_Z :=
      hPb.isoPullback_inv_snd
    have hLift : ∀ z : ↥C, ∃ q : ↥Q_B, j_B.base q = ι_prod.base z.1 := by
      intro z
      have hz_not_U : π₀.left.base z.1 ∉ (U_axis : Set Z_bar.left) := hC_disj z.1 z.2
      rw [hU_axis_eq, Set.notMem_compl_iff] at hz_not_U
      rcases hz_not_U with ⟨b, hb⟩
      let q_Z : ↥Q_Z := ι_prod.base z.1
      have h_fst_qZ : fst_Z.base q_Z = π₀.left.base z.1 := by
        change (ι_prod ≫ fst_Z).base z.1 = π₀.left.base z.1
        rw [CategoryTheory.Limits.pullback.lift_fst]
      obtain ⟨w, -, hw_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback b q_Z (hb.trans h_fst_qZ.symm)
      refine ⟨e_PB.inv.base w, ?_⟩
      change (e_PB.inv ≫ j_B).base w = q_Z
      rw [he_PB_snd]
      exact hw_snd
    choose g_map hg_map using hLift
    have hcomp_eq : j_B.base ∘ g_map = ι_prod.base ∘ (Subtype.val : ↥C → ↥Z_tilde.left) :=
      funext hg_map
    have hg_ind : Topology.IsInducing g_map := by
      rw [← Topology.IsInducing.of_comp_iff hjB_ind, hcomp_eq]
      exact hι_ind.comp Topology.IsInducing.subtypeVal
    exact hg_ind.topologicalKrullDim_le

  
  
  
  
  have hOpenEmbDimLe : ∀ {A B : Type u} [TopologicalSpace A] [TopologicalSpace B]
      (j : A → B), Topology.IsOpenEmbedding j → topologicalKrullDim A ≤ topologicalKrullDim B := by
    intro A B _ _ j hj
    let cl_map : TopologicalSpace.IrreducibleCloseds A → TopologicalSpace.IrreducibleCloseds B :=
      fun K =>
        { carrier := closure (j '' (K : Set A))
          isIrreducible' := (K.isIrreducible.image j hj.continuous.continuousOn).closure
          isClosed' := isClosed_closure }
    have hpre_cl : ∀ K : TopologicalSpace.IrreducibleCloseds A,
        j ⁻¹' closure (j '' (K : Set A)) = (K : Set A) := by
      intro K
      apply Set.Subset.antisymm
      · obtain ⟨F, hF_cl, hF_pre⟩ := hj.isInducing.isClosed_iff.mp K.isClosed
        have hjK_sub : j '' (K : Set A) ⊆ F := by
          rintro _ ⟨a, ha, rfl⟩
          rw [← hF_pre] at ha
          exact ha
        have hcl_sub : closure (j '' (K : Set A)) ⊆ F := closure_minimal hjK_sub hF_cl
        exact (Set.preimage_mono hcl_sub).trans_eq hF_pre
      · intro a ha
        exact subset_closure ⟨a, ha, rfl⟩
    have hStrict : StrictMono cl_map := by
      intro K₁ K₂ hlt
      rw [lt_iff_le_not_ge] at hlt ⊢
      refine ⟨closure_mono (Set.image_mono hlt.1), fun hge => hlt.2 ?_⟩
      change (K₂ : Set A) ⊆ (K₁ : Set A)
      rw [← hpre_cl K₂, ← hpre_cl K₁]
      exact Set.preimage_mono hge
    exact Order.krullDim_le_of_strictMono cl_map hStrict

  have hSmoothSchemeStruct : ∀ (m : ℕ)
      (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.SmoothOfRelativeDimension m W.hom],
      AlgebraicGeometry.IsReduced W.left ∧
      (∀ (x : ↥W.left) (S : Set ↥W.left), IsPreirreducible S → x ∈ S → S ⊆ irreducibleComponent x) ∧
      (∀ x : ↥W.left, topologicalKrullDim ↥(irreducibleComponent x) = (m : WithBot ℕ∞)) ∧
      topologicalKrullDim ↥W.left ≤ (m : WithBot ℕ∞) := by
    intro m W _
    have hChartPkg : ∀ x : ↥W.left,
        (_root_.IsReduced ↑(W.left.presheaf.stalk x)) ∧
        (∃ O : Set ↥W.left, IsOpen O ∧ x ∈ O ∧ IsIrreducible O) ∧
        (∃ V : W.left.Opens, x ∈ V ∧ topologicalKrullDim ↥V.toScheme = (m : WithBot ℕ∞)) := by
      intro x
      obtain ⟨U, _, V, hAffV, hxV, e_UV, hStd_UV⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff m W.hom).mp inferInstance x
      have hU_top : U = ⊤ := by
        ext p
        refine ⟨fun _ => trivial, fun _ => ?_⟩
        have hp_eq : p = W.hom.base x := Subsingleton.elim p (W.hom.base x)
        rw [hp_eq]
        exact e_UV hxV
      let iso_U_k : CommRingCat.of k ≅ (AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm ≪≫
          ((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.mapIso (eqToIso (congrArg Opposite.op hU_top.symm)))
      let f_V : k →+* ↑(W.left.presheaf.obj (Opposite.op V)) :=
        (iso_U_k.hom ≫ W.hom.appLE U V e_UV).hom
      have hf_V : RingHom.IsStandardSmoothOfRelativeDimension m f_V :=
        (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_left_isIso
          iso_U_k.hom (W.hom.appLE U V e_UV)).mpr hStd_UV
      obtain ⟨hDom_V, hOpenIrred_V, _, hDim_V_eq⟩ := hStdSmoothAlg m _ f_V hf_V
      let xV_sch : ↥V.toScheme := ⟨x, hxV⟩
      let homeoV := AlgebraicGeometry.Scheme.homeoOfIso hAffV.isoSpec
      have hDim_V : topologicalKrullDim ↥V.toScheme = (m : WithBot ℕ∞) :=
        homeoV.isHomeomorph.topologicalKrullDim_eq.trans (hDim_V_eq ⟨homeoV xV_sch⟩)
      refine ⟨?_, ?_, ⟨V, hxV, hDim_V⟩⟩
      · 
        let xV : ↥V := ⟨x, hxV⟩
        let 𝔮 := hAffV.primeIdealOf xV
        have hDom_q : IsDomain (Localization.AtPrime 𝔮.asIdeal) := hDom_V 𝔮
        let _ := TopCat.Presheaf.algebra_section_stalk W.left.presheaf xV
        have hLoc_stk := hAffV.isLocalization_stalk xV
        let e_stk : Localization.AtPrime 𝔮.asIdeal ≃+* ↑(W.left.presheaf.stalk x) :=
          (@IsLocalization.algEquiv _ _ 𝔮.asIdeal.primeCompl
            (Localization.AtPrime 𝔮.asIdeal) _ _ _
            ↑(W.left.presheaf.stalk x) _ _ hLoc_stk).toRingEquiv
        have hDom_stk : IsDomain ↑(W.left.presheaf.stalk x) :=
          e_stk.symm.toMulEquiv.isDomain
        exact inferInstance
      · 
        obtain ⟨U_spec, hOpen_Uspec, hx_Uspec, hIrred_Uspec⟩ := hOpenIrred_V (homeoV xV_sch)
        let O_V : Set ↥V.toScheme := homeoV ⁻¹' U_spec
        have hOpen_OV : IsOpen O_V := hOpen_Uspec.preimage homeoV.continuous
        have hx_OV : xV_sch ∈ O_V := hx_Uspec
        have hIrred_OV : IsIrreducible O_V := by
          have heq : O_V = homeoV.symm '' U_spec := by
            ext y
            constructor
            · intro hy
              exact ⟨homeoV y, hy, homeoV.symm_apply_apply y⟩
            · rintro ⟨z, hz, rfl⟩
              change homeoV (homeoV.symm z) ∈ U_spec
              rwa [homeoV.apply_symm_apply]
          rw [heq]
          exact hIrred_Uspec.image homeoV.symm homeoV.symm.continuous.continuousOn
        refine ⟨V.ι.base '' O_V, V.ι.isOpenEmbedding.isOpenMap O_V hOpen_OV,
          ⟨xV_sch, hx_OV, rfl⟩, hIrred_OV.image V.ι.base V.ι.continuous.continuousOn⟩
    have _ : ∀ x, _root_.IsReduced ↑(W.left.presheaf.stalk x) := fun x => (hChartPkg x).1
    have hRed_W : AlgebraicGeometry.IsReduced W.left :=
      AlgebraicGeometry.isReduced_of_isReduced_stalk W.left
    obtain ⟨hOpen_comp, hSub_comp, _⟩ := hLocIrred ↥W.left (fun x => (hChartPkg x).2.1)
    
    have hGlobalUpper : topologicalKrullDim ↥W.left ≤ (m : WithBot ℕ∞) := by
      change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥W.left) ≤ (m : WithBot ℕ∞)
      rcases isEmpty_or_nonempty (TopologicalSpace.IrreducibleCloseds ↥W.left) with hEmp | _
      · rw [Order.krullDim_eq_bot_iff.mpr hEmp]
        exact bot_le
      · rw [Order.krullDim_eq_iSup_length]
        change ((⨆ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥W.left), (p.length : ℕ∞) : ℕ∞) : WithBot ℕ∞) ≤
          ((m : ℕ∞) : WithBot ℕ∞)
        rw [WithBot.coe_le_coe]
        refine iSup_le fun p => ?_
        obtain ⟨x₀, hx₀⟩ := (p 0).isIrreducible.nonempty
        obtain ⟨V, hx₀V, hDim_V⟩ := (hChartPkg x₀).2.2
        have hx₀_all : ∀ i : Fin (p.length + 1), x₀ ∈ (p i : Set ↥W.left) :=
          fun i => (show (p 0 : Set ↥W.left) ⊆ (p i : Set ↥W.left) from p.monotone (Fin.zero_le i)) hx₀
        let q_fun : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥V.toScheme := fun i =>
          { carrier := V.ι.base ⁻¹' (p i : Set ↥W.left)
            isIrreducible' := ⟨⟨⟨x₀, hx₀V⟩, hx₀_all i⟩,
              (p i).isIrreducible.isPreirreducible.preimage V.ι.isOpenEmbedding⟩
            isClosed' := (p i).isClosed.preimage V.ι.continuous }
        let q_series : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V.toScheme) :=
          { length := p.length
            toFun := q_fun
            step := fun i => by
              have hlt : p (Fin.castSucc i) < p i.succ := p.step i
              show q_fun (Fin.castSucc i) < q_fun i.succ
              rw [lt_iff_le_not_ge] at hlt ⊢
              refine ⟨fun x hx => hlt.1 hx, fun hge => hlt.2 ?_⟩
              have h_cov : (p i.succ : Set ↥W.left) ⊆
                  (p (Fin.castSucc i) : Set ↥W.left) ∪ (Set.range V.ι.base)ᶜ := by
                intro z hz
                by_cases hz_r : z ∈ Set.range V.ι.base
                · rcases hz_r with ⟨v, rfl⟩
                  exact Or.inl (hge hz)
                · exact Or.inr hz_r
              have h_split := isPreirreducible_iff_isClosed_union_isClosed.mp
                (p i.succ).isIrreducible.isPreirreducible
                (p (Fin.castSucc i)) (Set.range V.ι.base)ᶜ
                (p (Fin.castSucc i)).isClosed V.ι.isOpenEmbedding.isOpen_range.isClosed_compl h_cov
              exact h_split.resolve_right fun h_compl =>
                h_compl (hx₀_all i.succ) ⟨⟨x₀, hx₀V⟩, rfl⟩ }
        have hlen : ((p.length : ℕ∞) : WithBot ℕ∞) ≤ topologicalKrullDim ↥V.toScheme :=
          Order.LTSeries.length_le_krullDim q_series
        exact WithBot.coe_le_coe.mp (hlen.trans hDim_V.le)
    have hComp_dim : ∀ x : ↥W.left,
        topologicalKrullDim ↥(irreducibleComponent x) = (m : WithBot ℕ∞) := by
      intro x
      let U_x : W.left.Opens := ⟨irreducibleComponent x, hOpen_comp x⟩
      have hUpper_x : topologicalKrullDim ↥(irreducibleComponent x) ≤ (m : WithBot ℕ∞) :=
        (hOpenEmbDimLe U_x.ι.base U_x.ι.isOpenEmbedding).trans hGlobalUpper
      
      obtain ⟨V, hxV, _⟩ := (hChartPkg x).2.2
      let VU : W.left.Opens := V ⊓ U_x
      have hxVU : x ∈ VU := ⟨hxV, mem_irreducibleComponent⟩
      have hSm_comp : AlgebraicGeometry.SmoothOfRelativeDimension (0 + m) (VU.ι ≫ W.hom) :=
        AlgebraicGeometry.smoothOfRelativeDimension_comp 0 m VU.ι W.hom
      rw [Nat.zero_add] at hSm_comp
      obtain ⟨U₀, _, V₀, hAffV₀, hxV₀, e_UV₀, hStd_UV₀⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff m (VU.ι ≫ W.hom)).mp hSm_comp ⟨x, hxVU⟩
      have hU₀_top : U₀ = ⊤ := by
        ext p
        refine ⟨fun _ => trivial, fun _ => ?_⟩
        have hp_eq : p = (VU.ι ≫ W.hom).base ⟨x, hxVU⟩ := Subsingleton.elim p _
        rw [hp_eq]
        exact e_UV₀ hxV₀
      let iso_U₀_k : CommRingCat.of k ≅
          (AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U₀) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm ≪≫
          ((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.mapIso
            (eqToIso (congrArg Opposite.op hU₀_top.symm)))
      let f_V₀ : k →+* ↑(VU.toScheme.presheaf.obj (Opposite.op V₀)) :=
        (iso_U₀_k.hom ≫ (VU.ι ≫ W.hom).appLE U₀ V₀ e_UV₀).hom
      have hf_V₀ : RingHom.IsStandardSmoothOfRelativeDimension m f_V₀ :=
        (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_left_isIso
          iso_U₀_k.hom ((VU.ι ≫ W.hom).appLE U₀ V₀ e_UV₀)).mpr hStd_UV₀
      obtain ⟨_, _, _, hDim_V₀_eq⟩ := hStdSmoothAlg m _ f_V₀ hf_V₀
      let homeoV₀ := AlgebraicGeometry.Scheme.homeoOfIso hAffV₀.isoSpec
      let xV₀_sch : ↥V₀.toScheme := ⟨⟨x, hxVU⟩, hxV₀⟩
      have hDim_V₀ : topologicalKrullDim ↥V₀.toScheme = (m : WithBot ℕ∞) :=
        homeoV₀.isHomeomorph.topologicalKrullDim_eq.trans (hDim_V₀_eq ⟨homeoV₀ xV₀_sch⟩)
      let j_V₀_Ux : ↥V₀.toScheme → ↥(irreducibleComponent x) :=
        fun y => ⟨(V₀.ι ≫ VU.ι).base y, ((V₀.ι.base y).2).2⟩
      have hj_open : Topology.IsOpenEmbedding j_V₀_Ux := by
        have h1 : Topology.IsOpenEmbedding (V₀.ι ≫ VU.ι).base :=
          VU.ι.isOpenEmbedding.comp V₀.ι.isOpenEmbedding
        have hcomp : (Subtype.val : ↥(irreducibleComponent x) → ↥W.left) ∘ j_V₀_Ux =
            (V₀.ι ≫ VU.ι).base := rfl
        have hInd : Topology.IsInducing j_V₀_Ux := by
          rw [← Topology.IsInducing.of_comp_iff Topology.IsInducing.subtypeVal, hcomp]
          exact h1.isInducing
        have hInj : Function.Injective j_V₀_Ux :=
          fun y₁ y₂ hy => h1.injective
            (congrArg (Subtype.val : ↥(irreducibleComponent x) → ↥W.left) hy)
        refine ⟨⟨hInd, hInj⟩, ?_⟩
        have hRange : Set.range j_V₀_Ux =
            Subtype.val ⁻¹' Set.range (V₀.ι ≫ VU.ι).base := by
          ext z
          constructor
          · rintro ⟨y, rfl⟩
            exact ⟨y, rfl⟩
          · rintro ⟨y, hy⟩
            refine ⟨y, Subtype.ext hy⟩
        rw [hRange]
        exact h1.isOpen_range.preimage continuous_subtype_val
      have hLower_x : (m : WithBot ℕ∞) ≤ topologicalKrullDim ↥(irreducibleComponent x) :=
        hDim_V₀.symm.le.trans (hOpenEmbDimLe j_V₀_Ux hj_open)
      exact le_antisymm hUpper_x hLower_x
    exact ⟨hRed_W, hSub_comp, hComp_dim, hGlobalUpper⟩

  
  have hSm_fstB : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (CategoryTheory.Limits.pullback.fst B₀.hom P₁.hom) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback B₀.hom P₁.hom).flip hSm_P1
  have hSm_Bprod : AlgebraicGeometry.SmoothOfRelativeDimension (d + 1)
      (CategoryTheory.Limits.pullback.fst B₀.hom P₁.hom ≫ B₀.hom) := by
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (CategoryTheory.Limits.pullback.fst B₀.hom P₁.hom) := hSm_fstB
    have h1 : AlgebraicGeometry.SmoothOfRelativeDimension (1 + d)
        (CategoryTheory.Limits.pullback.fst B₀.hom P₁.hom ≫ B₀.hom) :=
      AlgebraicGeometry.smoothOfRelativeDimension_comp 1 d
        (CategoryTheory.Limits.pullback.fst B₀.hom P₁.hom) B₀.hom
    rwa [Nat.add_comm 1 d] at h1
  let B_prod : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.fst B₀.hom P₁.hom ≫ B₀.hom)
  have hDim_QB_le : topologicalKrullDim ↥(CategoryTheory.Limits.pullback B₀.hom P₁.hom) ≤
      ((d + 1 : ℕ) : WithBot ℕ∞) :=
    (@hSmoothSchemeStruct (d + 1) B_prod hSm_Bprod).2.2.2

  
  let W_U : Z_tilde.left.Opens := π₀.left ⁻¹ᵁ U_axis
  let φ_U : W_U.toScheme ⟶ Z_bar.left := (π₀.left ∣_ U_axis) ≫ U_axis.ι
  have _ : CategoryTheory.IsIso (π₀.left ∣_ U_axis) := hIso_U
  have _ : AlgebraicGeometry.IsIntegral Z_bar.left := hInt_Z
  let w₀ : ↥W_U.toScheme := (CategoryTheory.inv (π₀.left ∣_ U_axis)).base hU_axis_ne.some
  have _ : Nonempty ↥W_U.toScheme := ⟨w₀⟩
  have hInt_WU : AlgebraicGeometry.IsIntegral W_U.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion φ_U
  have hIrred_WU_sp : IrreducibleSpace ↥W_U.toScheme :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral W_U.toScheme hInt_WU
  have hIrred_WU_set : IsIrreducible (W_U : Set ↥Z_tilde.left) :=
    (isIrreducible_iff_irreducibleSpace (s := (W_U : Set ↥Z_tilde.left))).mpr hIrred_WU_sp

  obtain ⟨hRed_Ztilde, hSub_Z, hDim_Z, -⟩ := hSmoothSchemeStruct (d + 2) Z_tilde
  let u₀ : ↥Z_tilde.left := w₀.1
  let C₀ : Set ↥Z_tilde.left := irreducibleComponent u₀
  have hWU_sub_C₀ : (W_U : Set ↥Z_tilde.left) ⊆ C₀ :=
    hSub_Z u₀ W_U hIrred_WU_set.isPreirreducible w₀.2
  have hC₀_univ : C₀ = Set.univ := by
    ext z₁
    simp only [Set.mem_univ, iff_true]
    by_contra hz₁_not
    let C₁ : Set ↥Z_tilde.left := irreducibleComponent z₁
    have hC₁_disj : ∀ z ∈ C₁, π₀.left.base z ∉ U_axis := by
      intro z hz_C₁ hz_WU
      have hz_C₀ : z ∈ C₀ := hWU_sub_C₀ hz_WU
      have hC₀_sub_z : C₀ ⊆ irreducibleComponent z :=
        hSub_Z z C₀ isIrreducible_irreducibleComponent.isPreirreducible hz_C₀
      have hz_sub_C₀ : irreducibleComponent z ⊆ C₀ :=
        hSub_Z u₀ (irreducibleComponent z)
          isIrreducible_irreducibleComponent.isPreirreducible
          (hC₀_sub_z mem_irreducibleComponent)
      have hC₁_sub_z : C₁ ⊆ irreducibleComponent z :=
        hSub_Z z C₁ isIrreducible_irreducibleComponent.isPreirreducible hz_C₁
      exact hz₁_not (hz_sub_C₀ (hC₁_sub_z mem_irreducibleComponent))
    have hDim_C₁ : topologicalKrullDim ↥C₁ = ((d + 2 : ℕ) : WithBot ℕ∞) := hDim_Z z₁
    have hLe_all : ((d + 2 : ℕ) : WithBot ℕ∞) ≤ ((d + 1 : ℕ) : WithBot ℕ∞) :=
      hDim_C₁.symm.le.trans ((hExcDimLe C₁ hC₁_disj).trans hDim_QB_le)
    change (((d + 2 : ℕ) : ℕ∞) : WithBot ℕ∞) ≤ (((d + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) at hLe_all
    rw [WithBot.coe_le_coe, Nat.cast_le] at hLe_all
    omega
  have hPre_Ztilde : PreirreducibleSpace ↥Z_tilde.left := by
    refine PreirreducibleSpace.mk ?_
    rw [← hC₀_univ]
    exact isIrreducible_irreducibleComponent.isPreirreducible
  have hIrred_Ztilde : IrreducibleSpace ↥Z_tilde.left :=
    @IrreducibleSpace.mk ↥Z_tilde.left _ hPre_Ztilde ⟨u₀⟩
  exact @AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced
    Z_tilde.left hRed_Ztilde hIrred_Ztilde

theorem weil_algClosed_pencil_geom_fiber_hyperplane_section (k : Type u) [Field k] [IsAlgClosed k] (d M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d Z_bar.hom]
    (hNonempty_Z : Nonempty Z_bar.left)
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hCl_ι : AlgebraicGeometry.IsClosedImmersion ι_bar.left)
    (hNondeg : ∀ L_form : MvPolynomial (Fin (M + 1)) k,
      L_form ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1 → L_form ≠ 0 →
      ∃ z : Z_bar.left, ι_bar.left.base z ∉ weilProjHyperplaneSet k M L_form)
    (F_pen : Fin 2 → MvPolynomial (Fin (M + 1)) k)
    (hF_homog : ∀ a : Fin 2, F_pen a ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
    (hF_linIndep : ∀ c : Fin 2 → k, c ≠ 0 →
      MvPolynomial.C (c 0) * F_pen 0 + MvPolynomial.C (c 1) * F_pen 1 ≠ 0)
    (Z_tilde_sch : AlgebraicGeometry.Scheme.{u})
    (ι_Z_Q₁ : Z_tilde_sch ⟶
      CategoryTheory.Limits.pullback Z_bar.hom (weilProjectiveSpaceOver k 1).hom)
    (f₀_sch : Z_tilde_sch ⟶ (weilProjectiveSpaceOver k 1).left)
    (hf₀_eq : ι_Z_Q₁ ≫
      CategoryTheory.Limits.pullback.snd Z_bar.hom (weilProjectiveSpaceOver k 1).hom = f₀_sch)
    (hCl_ZQ₁ : AlgebraicGeometry.IsClosedImmersion ι_Z_Q₁)
    (hKer_ZQ₁ :
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
        MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
        MvPolynomial.gradedAlgebra
      let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
      let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
      let P₁ := weilProjectiveSpaceOver k 1
      let Q₁ := CategoryTheory.Limits.pullback Z_bar.hom P₁.hom
      let p₁_Z := CategoryTheory.Limits.pullback.fst Z_bar.hom P₁.hom
      let p₁_P := CategoryTheory.Limits.pullback.snd Z_bar.hom P₁.hom
      ∀ (α : Fin (M + 1)) (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
        (hF_ax : ∀ a : Fin 2, F_pen a ∈ 𝒜_M 1)
        (b : Fin 2) (hTb : (MvPolynomial.X b : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1)
        (U_Z : Z_bar.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_Z)
        (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)))
        (U_P : P₁.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_P)
        (hUP : U_P ≤ AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b))
        (W_pb : Q₁.Opens) (_ : AlgebraicGeometry.IsAffineOpen W_pb)
        (hWZ : W_pb ≤ (TopologicalSpace.Opens.map p₁_Z.base).obj U_Z)
        (hWP : W_pb ≤ (TopologicalSpace.Opens.map p₁_P.base).obj U_P),
        let ℓ_a : Fin 2 → ↑(Z_bar.left.presheaf.obj (Opposite.op U_Z)) := fun a =>
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) U_Z hUZ).hom
            (HomogeneousLocalization.mk ⟨1, ⟨F_pen a, hF_ax a⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
