import WeilPart31
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_algClosed_cubic_odp_jet_at_closedPoint (k : Type u) [Field k] [IsAlgClosed k] (m N : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_bar.hom]
    (ι₀ : Z_bar ⟶ weilProjectiveSpaceOver k N)
    (hCl₀ : AlgebraicGeometry.IsClosedImmersion ι₀.left)
    (z₀ : Z_bar.left) (hz₀_cl : IsClosed ({z₀} : Set Z_bar.left))
    (U₀ : Z_bar.left.Opens) (hz₀_U₀ : z₀ ∈ U₀) :
    let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
    ∃ (μ₀ : Fin (N + 1))
      (hXμ : (MvPolynomial.X μ₀ : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1)
      (V : Z_bar.left.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V)
      (hz₀_V : z₀ ∈ V) (hVU₀ : V ≤ U₀)
      (hVμ : V ≤ (TopologicalSpace.Opens.map ι₀.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ₀)))
      (ψ_V : MvPolynomial (Fin (2 * m + 2)) k →+* ↑(Z_bar.left.presheaf.obj (Opposite.op V)))
      (Q : MvPolynomial (Fin (2 * m + 2)) k),
      let p_z := (hAffV.primeIdealOf ⟨z₀, hz₀_V⟩).asIdeal
      let R_z := Localization.AtPrime p_z
      let 𝔪_z := IsLocalRing.maximalIdeal R_z
      AlgebraicGeometry.Etale (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_V)) ∧
      (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_V) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V.ι ≫ Z_bar.hom) ∧
      (∀ i : Fin (2 * m + 2), ψ_V (MvPolynomial.X i) ∈ p_z) ∧
      (∀ r : R_z, ∃ c : k, r - algebraMap _ R_z (ψ_V (MvPolynomial.C c)) ∈ 𝔪_z) ∧
      (∀ (c : k) (v : Fin (2 * m + 2) → k),
        algebraMap _ R_z (ψ_V (MvPolynomial.C c + ∑ i, MvPolynomial.C (v i) * MvPolynomial.X i)) ∈
          𝔪_z ^ 2 → c = 0 ∧ ∀ i, v i = 0) ∧
      Q ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) k 2 ∧
      Matrix.det (Matrix.of fun i j : Fin (2 * m + 2) =>
        MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q))) ≠ 0 ∧
      algebraMap _ R_z (ψ_V Q) ∉ 𝔪_z ^ 3 ∧
      ∀ u₀ : k, ∃ (F : MvPolynomial (Fin (N + 1)) k) (hF : F ∈ 𝒜_N 3),
        let f_V := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one).hom ≫
          ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ₀)) V hVμ).hom
          (HomogeneousLocalization.mk ⟨3, ⟨F, hF⟩,
            ⟨MvPolynomial.X μ₀ ^ 3, (MvPolynomial.mem_homogeneousSubmodule 3 _).mpr
              (MvPolynomial.isHomogeneous_X_pow μ₀ 3)⟩, ⟨3, rfl⟩⟩)
        algebraMap _ R_z (f_V - ψ_V (MvPolynomial.C u₀ * Q)) ∈ 𝔪_z ^ 3 :=
by
  intro 𝒜_N
  let _ : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
  let d : ℕ := 2 * m + 2
  have hd_def : d = 2 * m + 2 := rfl
  let P_T := MvPolynomial (Fin d) k
  let 𝔪_T : Ideal P_T := Ideal.span (Set.range (MvPolynomial.X : Fin d → P_T))

  
  have hDegFilt : ∀ (n : ℕ) (P : P_T), P ∈ 𝔪_T ^ n →
      ∀ e ∈ P.support, n ≤ ∑ i : Fin d, e i := by
    let J : ℕ → Ideal P_T := fun r =>
      { carrier := { P : P_T | ∀ e ∈ P.support, r ≤ ∑ i : Fin d, e i }
        add_mem' := fun {a b} ha hb e he => by
          rcases Finset.mem_union.mp (MvPolynomial.support_add he) with hae | hbe
          · exact ha e hae
          · exact hb e hbe
        zero_mem' := fun e he => by
          rw [MvPolynomial.support_zero] at he
          exact absurd he (Finset.notMem_empty e)
        smul_mem' := fun c a ha e he => by
          rw [smul_eq_mul] at he
          obtain ⟨e₁, _, e₂, he₂, rfl⟩ := Finset.mem_add.mp (MvPolynomial.support_mul c a he)
          have hsum : (∑ i : Fin d, (e₁ + e₂) i) = (∑ i : Fin d, e₁ i) + (∑ i : Fin d, e₂ i) := by
            simp only [Finsupp.add_apply, Finset.sum_add_distrib]
          have h2 := ha e₂ he₂
          omega }
    have hmT_le_J1 : 𝔪_T ≤ J 1 := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩ e he
      rw [MvPolynomial.support_X, Finset.mem_singleton] at he
      subst he
      rw [Finset.sum_eq_single i]
      · simp
      · intro j _ hji
        exact Finsupp.single_eq_of_ne hji
      · intro hi
        exact absurd (Finset.mem_univ i) hi
    have hJ_mul : ∀ r : ℕ, J r * J 1 ≤ J (r + 1) := by
      intro r
      rw [Ideal.mul_le]
      intro u hu v hv e he
      obtain ⟨e₁, he₁, e₂, he₂, rfl⟩ := Finset.mem_add.mp (MvPolynomial.support_mul u v he)
      have hsum : (∑ i : Fin d, (e₁ + e₂) i) = (∑ i : Fin d, e₁ i) + (∑ i : Fin d, e₂ i) := by
        simp only [Finsupp.add_apply, Finset.sum_add_distrib]
      have h1 := hu e₁ he₁
      have h2 := hv e₂ he₂
      omega
    have hmT_pow_le : ∀ n : ℕ, 𝔪_T ^ n ≤ J n := by
      intro n
      induction n with
      | zero =>
        rw [pow_zero, Ideal.one_eq_top]
        intro P _ e _
        exact Nat.zero_le _
      | succ n ih =>
        rw [pow_succ]
        exact (Ideal.mul_mono ih hmT_le_J1).trans (hJ_mul n)
    intro n P hP
    exact hmT_pow_le n hP

  
  let a_idx : Fin (m + 1) → Fin d := fun s => ⟨2 * s.1, by omega⟩
  let b_idx : Fin (m + 1) → Fin d := fun s => ⟨2 * s.1 + 1, by omega⟩
  let Q : P_T := ∑ s : Fin (m + 1), MvPolynomial.X (a_idx s) * MvPolynomial.X (b_idx s)
  have hQ_pkg :
      Q ∈ MvPolynomial.homogeneousSubmodule (Fin d) k 2 ∧
      Matrix.det (Matrix.of fun i j : Fin d =>
        MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q))) ≠ 0 ∧
      Q ∉ 𝔪_T ^ 3 := by
    refine ⟨?_, ?_, ?_⟩
    · refine Submodule.sum_mem _ fun s _ => ?_
      rw [MvPolynomial.mem_homogeneousSubmodule]
      exact (MvPolynomial.isHomogeneous_X k (a_idx s)).mul (MvPolynomial.isHomogeneous_X k (b_idx s))
    · let σ : Fin d → Fin d := fun i =>
        if _ : i.1 % 2 = 0 then ⟨i.1 + 1, by have := i.2; omega⟩
        else ⟨i.1 - 1, by have := i.2; omega⟩
      have hσ_inv : ∀ i : Fin d, σ (σ i) = i := by
        intro i
        have hi_lt : i.1 < d := i.2
        ext
        dsimp [σ]
        by_cases h : i.1 % 2 = 0
        · rw [dif_pos h]
          have h1 : (i.1 + 1) % 2 ≠ 0 := by omega
          rw [dif_neg h1]
          dsimp
        · rw [dif_neg h]
          have h1 : (i.1 - 1) % 2 = 0 := by omega
          rw [dif_pos h1]
          dsimp
          omega
      have hσ_ne : ∀ i : Fin d, σ i ≠ i := by
        intro i h
        have hi_lt : i.1 < d := i.2
        have h1 := congrArg Fin.val h
        dsimp [σ] at h1
        by_cases hev : i.1 % 2 = 0
        · rw [dif_pos hev] at h1
          dsimp at h1
          omega
        · rw [dif_neg hev] at h1
          dsimp at h1
          omega
      let B : Matrix (Fin d) (Fin d) k := Matrix.of fun i j : Fin d =>
        MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q))
      have hB_entry : ∀ i j : Fin d, B i j = if j = σ i then 1 else 0 := by
        intro i j
        have hi_lt : i.1 < d := i.2
        change MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q)) = _
        dsimp only [Q]
        rw [map_sum, map_sum, map_sum]
        let s₀ : Fin (m + 1) := ⟨i.1 / 2, by omega⟩
        have hs₀_val : s₀.1 = i.1 / 2 := rfl
        rw [Finset.sum_eq_single s₀]
        · by_cases hi : i.1 % 2 = 0
          · have hia : a_idx s₀ = i := by ext; change 2 * s₀.1 = i.1; omega
            have hσb : b_idx s₀ = σ i := by
              ext
              change 2 * s₀.1 + 1 = (σ i).1
              dsimp [σ]
              rw [dif_pos hi]
              dsimp
              omega
            rw [hia, hσb, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_self,
              MvPolynomial.pderiv_X_of_ne (hσ_ne i), one_mul, mul_zero, add_zero]
            by_cases hj : j = σ i
            · subst hj
              simp only [↓reduceIte, MvPolynomial.pderiv_X_self, map_one]
            · simp only [hj, ↓reduceIte, MvPolynomial.pderiv_X_of_ne (Ne.symm hj), map_zero]
          · have hib : b_idx s₀ = i := by ext; change 2 * s₀.1 + 1 = i.1; omega
            have hσa : a_idx s₀ = σ i := by
              ext
              change 2 * s₀.1 = (σ i).1
              dsimp [σ]
              rw [dif_neg hi]
              dsimp
              omega
            rw [hib, hσa, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_of_ne (hσ_ne i),
              MvPolynomial.pderiv_X_self, zero_mul, mul_one, zero_add]
            by_cases hj : j = σ i
            · subst hj
              simp only [↓reduceIte, MvPolynomial.pderiv_X_self, map_one]
            · simp only [hj, ↓reduceIte, MvPolynomial.pderiv_X_of_ne (Ne.symm hj), map_zero]
        · intro s _ hs_ne
          have hne_val : s.1 ≠ i.1 / 2 := fun h => hs_ne (Fin.ext h)
          have hia : a_idx s ≠ i := by
            intro h; have h1 : 2 * s.1 = i.1 := congrArg Fin.val h; omega
          have hib : b_idx s ≠ i := by
            intro h; have h1 : 2 * s.1 + 1 = i.1 := congrArg Fin.val h; omega
          rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_of_ne hia,
            MvPolynomial.pderiv_X_of_ne hib, zero_mul, mul_zero, add_zero, map_zero, map_zero]
        · intro hs₀
          exact absurd (Finset.mem_univ s₀) hs₀
      have hBB : B * B = (1 : Matrix (Fin d) (Fin d) k) := by
        ext i l
        rw [Matrix.mul_apply, Matrix.one_apply]
        simp_rw [hB_entry]
        rw [Finset.sum_eq_single (σ i)]
        · simp only [↓reduceIte, one_mul, hσ_inv, eq_comm]
        · intro j _ hj
          simp only [hj, ↓reduceIte, zero_mul]
        · intro hmem
          exact absurd (Finset.mem_univ (σ i)) hmem
      have hdet_sq : B.det * B.det = 1 := by
        rw [← Matrix.det_mul, hBB, Matrix.det_one]
      intro hdet0
      rw [hdet0, zero_mul] at hdet_sq
      exact zero_ne_one hdet_sq
    · intro hQ_mem
      let s₀ : Fin (m + 1) := ⟨0, by omega⟩
      have ha0_val : (a_idx s₀).1 = 0 := rfl
      have hb0_val : (b_idx s₀).1 = 1 := rfl
      let d₀ : Fin d →₀ ℕ := Finsupp.single (a_idx s₀) 1 + Finsupp.single (b_idx s₀) 1
      have hterm : ∀ s : Fin (m + 1),
          (MvPolynomial.X (a_idx s) * MvPolynomial.X (b_idx s) : P_T) =
            MvPolynomial.monomial (Finsupp.single (a_idx s) 1 + Finsupp.single (b_idx s) 1) 1 := by
        intro s
        have hXa : (MvPolynomial.X (a_idx s) : P_T) = MvPolynomial.monomial (Finsupp.single (a_idx s) 1) 1 := by
          simpa using (@MvPolynomial.X_pow_eq_monomial k (Fin d) 1 (a_idx s) _)
        have hXb : (MvPolynomial.X (b_idx s) : P_T) = MvPolynomial.monomial (Finsupp.single (b_idx s) 1) 1 := by
          simpa using (@MvPolynomial.X_pow_eq_monomial k (Fin d) 1 (b_idx s) _)
        rw [hXa, hXb, MvPolynomial.monomial_mul_monomial, one_mul]
      have hcoeff : Q.coeff d₀ = 1 := by
        dsimp only [Q]
        rw [MvPolynomial.coeff_sum, Finset.sum_eq_single s₀]
        · rw [hterm s₀, MvPolynomial.coeff_monomial, ite_eq_left_iff.mpr fun h => absurd rfl h]
        · intro s _ hs_ne
          rw [hterm s, MvPolynomial.coeff_monomial]
          refine ite_eq_right_iff.mpr fun heq => ?_
          exfalso
          have hval := congrArg (fun f : Fin d →₀ ℕ => f (a_idx s₀)) heq
          have hs_pos : s.1 ≠ 0 := fun h => hs_ne (Fin.ext h)
          have ha_ne : a_idx s ≠ a_idx s₀ := by
            intro h
            have h1 : 2 * s.1 = (a_idx s₀).1 := congrArg Fin.val h
            omega
          have hb_ne : b_idx s ≠ a_idx s₀ := by
            intro h
            have h1 : 2 * s.1 + 1 = (a_idx s₀).1 := congrArg Fin.val h
            omega
          have hb0_ne : b_idx s₀ ≠ a_idx s₀ := by
            intro h
            have h1 : (b_idx s₀).1 = (a_idx s₀).1 := congrArg Fin.val h
            omega
          simp only [d₀, Finsupp.add_apply, Finsupp.single_eq_same,
            Finsupp.single_eq_of_ne (Ne.symm ha_ne), Finsupp.single_eq_of_ne (Ne.symm hb_ne),
            Finsupp.single_eq_of_ne (Ne.symm hb0_ne)] at hval
          exact zero_ne_one hval
        · intro hs₀
          exact absurd (Finset.mem_univ s₀) hs₀
      have hd₀_supp : d₀ ∈ Q.support := MvPolynomial.mem_support_iff.mpr (by rw [hcoeff]; exact one_ne_zero)
      have hdeg_ge : 3 ≤ ∑ i : Fin d, d₀ i := hDegFilt 3 Q hQ_mem d₀ hd₀_supp
      have hsum_single : ∀ j : Fin d, (∑ i : Fin d, Finsupp.single j 1 i) = 1 := by
        intro j
        rw [Finset.sum_eq_single j]
        · exact Finsupp.single_eq_same
        · intro i _ hij
          exact Finsupp.single_eq_of_ne hij
        · intro hj
          exact absurd (Finset.mem_univ j) hj
      have hdeg_eq : (∑ i : Fin d, d₀ i) = 2 := by
        simp only [d₀, Finsupp.add_apply, Finset.sum_add_distrib, hsum_single]
      omega

  
  let ι_proj : Z_bar.left ⟶ AlgebraicGeometry.Proj 𝒜_N := ι₀.left
  have hex_μ₀ : ∃ μ₀ : Fin (N + 1),
      ι_proj.base z₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ₀) := by
    let x₀ : AlgebraicGeometry.Proj 𝒜_N := ι_proj.base z₀
    by_contra! hnot
    have hX_mem : ∀ μ : Fin (N + 1), MvPolynomial.X μ ∈ x₀.asHomogeneousIdeal := by
      intro μ
      have hmem_iff := AlgebraicGeometry.Proj.mem_basicOpen 𝒜_N (MvPolynomial.X μ) x₀
      exact not_not.mp (hmem_iff.not.mp (hnot μ))
    have hirrel : HomogeneousIdeal.irrelevant 𝒜_N ≤ x₀.asHomogeneousIdeal := by
      intro p hp
      rw [HomogeneousIdeal.mem_irrelevant_iff] at hp
      have hp_zero : (DirectSum.decompose 𝒜_N p 0 : MvPolynomial (Fin (N + 1)) k) = 0 := hp
      have hcoeff0 : p.coeff 0 = 0 := by
        classical
        conv_lhs => rw [← DirectSum.sum_support_decompose 𝒜_N p]
        rw [MvPolynomial.coeff_sum]
        refine Finset.sum_eq_zero fun deg _ => ?_
        by_cases hdeg0 : deg = 0
        · subst hdeg0
          rw [hp_zero]
          rfl
        · by_contra hne
          have hhom : (DirectSum.decompose 𝒜_N p deg : MvPolynomial (Fin (N + 1)) k).IsHomogeneous deg :=
            (DirectSum.decompose 𝒜_N p deg).2
          have hdeg_eq := hhom hne
          rw [map_zero] at hdeg_eq
          exact hdeg0 hdeg_eq.symm
      rw [MvPolynomial.as_sum p]
      refine Ideal.sum_mem x₀.asHomogeneousIdeal.toIdeal fun e he => ?_
      have he_ne : e ≠ 0 := by
        intro h0
        subst h0
        exact (MvPolynomial.mem_support_iff.mp he) hcoeff0
      have hex_μ : ∃ μ : Fin (N + 1), e μ ≠ 0 := by
        by_contra! hall
        apply he_ne
        ext μ
        exact hall μ
      obtain ⟨μ, hμ_ne⟩ := hex_μ
      let e' : Fin (N + 1) →₀ ℕ := e - Finsupp.single μ 1
      have he_eq : Finsupp.single μ 1 + e' = e := by
        ext ν
        simp only [Finsupp.add_apply, e', Finsupp.tsub_apply]
        by_cases hνμ : ν = μ
        · subst hνμ
          simp only [Finsupp.single_eq_same]
          omega
        · rw [Finsupp.single_eq_of_ne hνμ, zero_add, Nat.sub_zero]
      have hmon : MvPolynomial.monomial e (p.coeff e) =
          MvPolynomial.X μ * MvPolynomial.monomial e' (p.coeff e) := by
        have hX1 : (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k) =
            MvPolynomial.monomial (Finsupp.single μ 1) 1 := by
          simpa using (@MvPolynomial.X_pow_eq_monomial k (Fin (N + 1)) 1 μ _)
        rw [hX1, MvPolynomial.monomial_mul_monomial, one_mul, he_eq]
      rw [hmon]
      exact x₀.asHomogeneousIdeal.toIdeal.mul_mem_right _ (hX_mem μ)
    exact x₀.not_irrelevant_le hirrel

  obtain ⟨μ₀, hz_Dμ₀⟩ := hex_μ₀
  have hXμ : (MvPolynomial.X μ₀ : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k μ₀)
  let D_μ₀ : (AlgebraicGeometry.Proj 𝒜_N).Opens :=
    AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ₀)
  have hAff_Dμ₀ : AlgebraicGeometry.IsAffineOpen D_μ₀ :=
    AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one
  let U_μ₀ : Z_bar.left.Opens := (TopologicalSpace.Opens.map ι_proj.base).obj D_μ₀
  have hz_Uμ₀ : z₀ ∈ U_μ₀ := hz_Dμ₀
  have _ : AlgebraicGeometry.IsClosedImmersion ι_proj := hCl₀
  have hAff_Uμ₀ : AlgebraicGeometry.IsAffineOpen U_μ₀ := hAff_Dμ₀.preimage ι_proj
  let H₀ := HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₀)
  let θ₀ : H₀ →+* ↑(Z_bar.left.presheaf.obj (Opposite.op U_μ₀)) :=
    ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one).hom ≫
      ι_proj.app D_μ₀).hom
  have hθ₀_surj : Function.Surjective θ₀ := by
    have h1 : Function.Surjective (ι_proj.app D_μ₀).hom :=
      AlgebraicGeometry.Scheme.Hom.app_surjective ι_proj D_μ₀ hAff_Dμ₀
    have h2 : Function.Surjective
        (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one).hom.hom :=
      (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one).commRingCatIsoToRingEquiv.surjective
    exact h1.comp h2

  
  obtain ⟨U_base, _, W_sm, hAff_Wsm, hz_Wsm, e_sm, hStd⟩ :=
    (AlgebraicGeometry.smoothOfRelativeDimension_iff d Z_bar.hom).mp inferInstance z₀
  let S_base := AlgebraicGeometry.Spec (CommRingCat.of k)
  let iso_U_hom : CommRingCat.of k ⟶ S_base.presheaf.obj (Opposite.op U_base) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
      S_base.presheaf.map (CategoryTheory.homOfLE (le_top : U_base ≤ ⊤)).op
  have hU_top : U_base = ⊤ := by
    ext p
    exact ⟨fun _ => trivial, fun _ => Subsingleton.elim (Z_bar.hom.base z₀) p ▸ e_sm hz_Wsm⟩
  have _ : CategoryTheory.IsIso (S_base.presheaf.map (CategoryTheory.homOfLE (le_top : U_base ≤ ⊤)).op) := by
    have heq : (CategoryTheory.homOfLE (le_top : U_base ≤ ⊤)).op =
        CategoryTheory.eqToHom (congrArg Opposite.op hU_top.symm) := Subsingleton.elim _ _
    rw [heq]
    infer_instance
  have _ : CategoryTheory.IsIso iso_U_hom := CategoryTheory.IsIso.comp_isIso
  let e_U : k ≃+* ↑(S_base.presheaf.obj (Opposite.op U_base)) :=
    (CategoryTheory.asIso iso_U_hom).commRingCatIsoToRingEquiv
  obtain ⟨ψ_sm_U, hψ_sm_U_comp, hψ_sm_U_et⟩ :=
    RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hStd
  let e_poly : P_T ≃+* MvPolynomial (Fin d) ↑(S_base.presheaf.obj (Opposite.op U_base)) :=
    MvPolynomial.mapEquiv (Fin d) e_U
  let ψ_sm : P_T →+* ↑(Z_bar.left.presheaf.obj (Opposite.op W_sm)) :=
    ψ_sm_U.comp e_poly.toRingHom
  have hψ_sm_et : RingHom.Etale ψ_sm :=
    RingHom.Etale.respectsIso.right ψ_sm_U e_poly hψ_sm_U_et
  have hψ_sm_C : CommRingCat.ofHom (ψ_sm.comp MvPolynomial.C) =
      iso_U_hom ≫ Z_bar.hom.appLE U_base W_sm e_sm := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    change ψ_sm_U (MvPolynomial.map e_U.toRingHom (MvPolynomial.C c)) =
      (Z_bar.hom.appLE U_base W_sm e_sm).hom (iso_U_hom.hom c)
    rw [MvPolynomial.map_C]
    exact RingHom.congr_fun hψ_sm_U_comp (e_U c)
  have hW_sm_comm :
      W_sm.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sm) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
      W_sm.ι ≫ Z_bar.hom := by
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ_sm_C,
      AlgebraicGeometry.Spec.map_comp,
      AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE_assoc]
    dsimp [iso_U_hom]
    rw [AlgebraicGeometry.Spec.map_comp,
      AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_top_assoc]
    have hSpec_id : S_base.toSpecΓ ≫
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv =
        𝟙 S_base := by
      rw [← AlgebraicGeometry.Scheme.isoSpec_hom S_base,
        ← AlgebraicGeometry.Scheme.isoSpec_Spec_inv (CommRingCat.of k), CategoryTheory.Iso.hom_inv_id]
    rw [hSpec_id, CategoryTheory.Category.comp_id, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]

  
  obtain ⟨g₀, hg₀_le, hz_W'sm⟩ :=
    hAff_Wsm.exists_basicOpen_le (⟨z₀, ⟨hz_Wsm, hz₀_U₀⟩⟩ : ↥(W_sm ⊓ U₀)) hz_Wsm
  let W'_sm : Z_bar.left.Opens := Z_bar.left.basicOpen g₀
  have hAff_W'sm : AlgebraicGeometry.IsAffineOpen W'_sm := hAff_Wsm.basicOpen g₀
  obtain ⟨h_sm, h_μ₀, hV_eq, hz₀_V⟩ :=
    AlgebraicGeometry.exists_basicOpen_le_affine_inter hAff_W'sm hAff_Uμ₀ z₀ ⟨hz_W'sm, hz_Uμ₀⟩
  let V : Z_bar.left.Opens := Z_bar.left.basicOpen h_sm
  have hAffV : AlgebraicGeometry.IsAffineOpen V := hAff_W'sm.basicOpen h_sm
  have hVW'sm : V ≤ W'_sm := Z_bar.left.basicOpen_le h_sm
  have hVWsm : V ≤ W_sm := hVW'sm.trans (hg₀_le.trans inf_le_left)
  have hVU₀ : V ≤ U₀ := hVW'sm.trans (hg₀_le.trans inf_le_right)
  have hVμ : V ≤ U_μ₀ := by
    rw [show V = Z_bar.left.basicOpen h_μ₀ from hV_eq]
    exact Z_bar.left.basicOpen_le h_μ₀

  let A_V := ↑(Z_bar.left.presheaf.obj (Opposite.op V))
  let res_Wsm_V : ↑(Z_bar.left.presheaf.obj (Opposite.op W_sm)) →+* A_V :=
    (Z_bar.left.presheaf.map (CategoryTheory.homOfLE hVWsm).op).hom
  let ψ₀ : P_T →+* A_V := res_Wsm_V.comp ψ_sm
  have hV_ψ₀_mor :
      V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) =
        Z_bar.left.homOfLE hVWsm ≫ W_sm.toSpecΓ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sm) := by
    have hhom : CommRingCat.ofHom ψ₀ =
        CommRingCat.ofHom ψ_sm ≫ Z_bar.left.presheaf.map (CategoryTheory.homOfLE hVWsm).op := rfl
    rw [hhom, AlgebraicGeometry.Spec.map_comp,
      AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_assoc]
  have hEt₀ : RingHom.Etale ψ₀ := by
    have _ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sm)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ_sm_et
    have _ : CategoryTheory.IsIso W_sm.toSpecΓ := hAff_Wsm.isoSpec_hom ▸ inferInstance
    have _ : CategoryTheory.IsIso V.toSpecΓ := hAffV.isoSpec_hom ▸ inferInstance
    have hEt_comp : AlgebraicGeometry.Etale
        (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀)) := by
      rw [hV_ψ₀_mor]
      infer_instance
    have hEt_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀)) := by
      have _ := hEt_comp
      have heq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) =
          CategoryTheory.inv V.toSpecΓ ≫
            (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀)) := by
        rw [CategoryTheory.IsIso.inv_hom_id_assoc]
      rw [heq]
      infer_instance
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.Etale)).mp hEt_spec
  have hComm₀ :
      V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
      V.ι ≫ Z_bar.hom := by
    rw [← CategoryTheory.Category.assoc, hV_ψ₀_mor, CategoryTheory.Category.assoc,
      CategoryTheory.Category.assoc, hW_sm_comm, ← CategoryTheory.Category.assoc,
      AlgebraicGeometry.Scheme.homOfLE_ι]

  
  let φ_V : H₀ →+* A_V :=
    ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one).hom ≫
      ι_proj.appLE D_μ₀ V hVμ).hom
  have hDμ₀_spec :
      D_μ₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map
        (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one).hom =
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one).hom := by
    rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom, AlgebraicGeometry.Proj.basicOpenIsoSpec_hom]
    rfl
  have hScalar₀ : ∀ c : k,
      φ_V (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (MvPolynomial.X μ₀))
        (algebraMap k ↥(𝒜_N 0) c)) = ψ₀ (MvPolynomial.C c) := by
    let s_zero : CommRingCat.of k ⟶ CommRingCat.of H₀ :=
      CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom 𝒜_N
        (Submonoid.powers (MvPolynomial.X μ₀))).comp (algebraMap k ↥(𝒜_N 0)))
    have hφ_mor :
        V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (s_zero ≫ CommRingCat.ofHom φ_V) =
          V.ι ≫ Z_bar.hom := by
      have hφ_def : CommRingCat.ofHom φ_V =
          (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one).hom ≫
            ι_proj.appLE D_μ₀ V hVμ := rfl
      have hs_def : s_zero =
          CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0)) ≫
            CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜_N
              (Submonoid.powers (MvPolynomial.X μ₀))) := rfl
      have h_away_zero :
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (MvPolynomial.X μ₀)))) =
          D_μ₀.ι ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜_N := by
        rw [← CategoryTheory.Iso.eq_inv_comp,
          ← AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one,
          ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι_assoc]
      have hw : ι_proj ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0))) = Z_bar.hom :=
        CategoryTheory.Over.w ι₀
      calc
        V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (s_zero ≫ CommRingCat.ofHom φ_V)
            = V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_V) ≫
                AlgebraicGeometry.Spec.map s_zero := by
              rw [AlgebraicGeometry.Spec.map_comp]
        _ = V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (ι_proj.appLE D_μ₀ V hVμ) ≫
              AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one).hom ≫
              AlgebraicGeometry.Spec.map s_zero := by
              rw [hφ_def, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = ι_proj.resLE D_μ₀ V hVμ ≫
              (D_μ₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one).hom) ≫
              AlgebraicGeometry.Spec.map s_zero := by
              rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE_assoc,
                CategoryTheory.Category.assoc]
        _ = ι_proj.resLE D_μ₀ V hVμ ≫
              ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one).hom ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (MvPolynomial.X μ₀))))) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0))) := by
              rw [hDμ₀_spec, hs_def, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = (ι_proj.resLE D_μ₀ V hVμ ≫ D_μ₀.ι) ≫
              AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0))) := by
              rw [h_away_zero, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        _ = V.ι ≫ Z_bar.hom := by
              rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, CategoryTheory.Category.assoc, hw]
    have hψ_mor :
        V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀.comp MvPolynomial.C)) =
          V.ι ≫ Z_bar.hom := by
      have h1 : CommRingCat.ofHom (ψ₀.comp MvPolynomial.C) =
          CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom ψ₀ := rfl
      rw [h1, AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc]
      exact hComm₀
    have _ : CategoryTheory.IsIso V.toSpecΓ := hAffV.isoSpec_hom ▸ inferInstance
    have hSpec_eq := (CategoryTheory.cancel_epi V.toSpecΓ).mp (hφ_mor.trans hψ_mor.symm)
    have hHom_eq := AlgebraicGeometry.Spec.map_injective hSpec_eq
    intro c
    exact ConcreteCategory.congr_hom hHom_eq c

  
  obtain ⟨u_den, hu_den⟩ := hθ₀_surj h_μ₀
  have hUnit_and_Span :
      IsUnit (φ_V u_den) ∧
      ∀ x : A_V, ∃ (n : ℕ) (w : H₀), x * (φ_V u_den) ^ n = φ_V w := by
    let V_μ : Z_bar.left.Opens := Z_bar.left.basicOpen h_μ₀
    have hLoc : @IsLocalization.Away _ _ h_μ₀
        ↑(Z_bar.left.presheaf.obj (Opposite.op V_μ)) _
        (Z_bar.left.presheaf.map (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h_μ₀)).op).hom.toAlgebra :=
      hAff_Uμ₀.isLocalization_basicOpen h_μ₀
    let _ : Algebra ↑(Z_bar.left.presheaf.obj (Opposite.op U_μ₀))
        ↑(Z_bar.left.presheaf.obj (Opposite.op V_μ)) :=
      (Z_bar.left.presheaf.map (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h_μ₀)).op).hom.toAlgebra
    let iso_VV : Z_bar.left.presheaf.obj (Opposite.op V_μ) ≅ Z_bar.left.presheaf.obj (Opposite.op V) :=
      Z_bar.left.presheaf.mapIso (CategoryTheory.eqToIso (congrArg Opposite.op hV_eq.symm))
    have hres_eq : Z_bar.left.presheaf.map (CategoryTheory.homOfLE hVμ).op =
        Z_bar.left.presheaf.map (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h_μ₀)).op ≫
          iso_VV.hom := by
      dsimp [iso_VV]
      rw [← Z_bar.left.presheaf.map_comp]
      congr 1
    have hφ_eq : ∀ w : H₀, φ_V w =
        (Z_bar.left.presheaf.map (CategoryTheory.homOfLE hVμ).op).hom (θ₀ w) := by
      intro w
      have happ : ι_proj.appLE D_μ₀ V hVμ =
          ι_proj.app D_μ₀ ≫ Z_bar.left.presheaf.map (CategoryTheory.homOfLE hVμ).op := by
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_eq_app, AlgebraicGeometry.Scheme.Hom.appLE_map]
      change ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ₀) hXμ zero_lt_one).hom ≫
        ι_proj.appLE D_μ₀ V hVμ).hom w = _
      rw [happ]
      rfl
    have hφ_uden : φ_V u_den = iso_VV.hom.hom
        (algebraMap ↑(Z_bar.left.presheaf.obj (Opposite.op U_μ₀))
          ↑(Z_bar.left.presheaf.obj (Opposite.op V_μ)) h_μ₀) := by
      rw [hφ_eq u_den, hu_den, hres_eq]
      rfl
    refine ⟨?_, ?_⟩
    · rw [hφ_uden]
      have hu_Vμ : IsUnit (algebraMap ↑(Z_bar.left.presheaf.obj (Opposite.op U_μ₀))
          ↑(Z_bar.left.presheaf.obj (Opposite.op V_μ)) h_μ₀) :=
        @IsLocalization.map_units _ _ (Submonoid.powers h_μ₀) _ _ _ hLoc ⟨h_μ₀, Submonoid.mem_powers h_μ₀⟩
      exact hu_Vμ.map iso_VV.hom.hom
    · intro x
      obtain ⟨⟨a, ⟨_, n, rfl⟩⟩, ha_eq⟩ :=
        @IsLocalization.surj _ _ (Submonoid.powers h_μ₀) _ _ _ hLoc (iso_VV.inv.hom x)
      dsimp only at ha_eq
      rw [map_pow] at ha_eq
      obtain ⟨w, rfl⟩ := hθ₀_surj a
      refine ⟨n, w, ?_⟩
      have h_app := congrArg iso_VV.hom.hom ha_eq
      rw [map_mul, map_pow] at h_app
      have hx_id : iso_VV.hom.hom (iso_VV.inv.hom x) = x :=
        ConcreteCategory.congr_hom iso_VV.inv_hom_id x
      have hrhs_eq : iso_VV.hom.hom
          (algebraMap ↑(Z_bar.left.presheaf.obj (Opposite.op U_μ₀))
            ↑(Z_bar.left.presheaf.obj (Opposite.op V_μ)) (θ₀ w)) = φ_V w := by
        rw [hφ_eq w, hres_eq]
        rfl
      rw [hx_id, ← hφ_uden, hrhs_eq] at h_app
      exact h_app
  obtain ⟨hUnit_uden, hSpan_uden⟩ := hUnit_and_Span

  
  let p_z : Ideal A_V := (hAffV.primeIdealOf ⟨z₀, hz₀_V⟩).asIdeal
  have hp_max : p_z.IsMaximal :=
    hAffV.primeIdealOf_isMaximal_of_isClosed ⟨z₀, hz₀_V⟩ hz₀_cl
  let R_z := Localization.AtPrime p_z
  let 𝔪_z := IsLocalRing.maximalIdeal R_z
  let loc : A_V →+* R_z := algebraMap A_V R_z

  have hNull : ∀ a : A_V, ∃ c : k, a - ψ₀ (MvPolynomial.C c) ∈ p_z := by
    let _ : Algebra P_T A_V := ψ₀.toAlgebra
    let _ : Algebra k A_V := (ψ₀.comp MvPolynomial.C).toAlgebra
    have _ : IsScalarTower k P_T A_V := IsScalarTower.of_algebraMap_eq' rfl
    have _ : Algebra.Etale P_T A_V := RingHom.etale_algebraMap.mp hEt₀
    have _ : Algebra.FiniteType k A_V := Algebra.FiniteType.trans (S := P_T) inferInstance inferInstance
    let K_p := A_V ⧸ p_z
    let _ : Field K_p := Ideal.Quotient.field p_z
    have _ : Algebra.FiniteType k K_p :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k p_z) Ideal.Quotient.mk_surjective
    obtain ⟨s, π_k, hπ_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
      (inferInstance : Algebra.FiniteType k K_p)
    have hker_max : (RingHom.ker π_k.toRingHom).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective π_k.toRingHom hπ_surj
    obtain ⟨pt, hker_eq⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp hker_max
    intro a
    obtain ⟨F_a, hF_a⟩ := hπ_surj (Ideal.Quotient.mk p_z a)
    let c : k := MvPolynomial.aeval pt F_a
    have hmem_ker : F_a - MvPolynomial.C c ∈ RingHom.ker π_k.toRingHom := by
      rw [hker_eq, MvPolynomial.mem_vanishingIdeal_iff]
      intro y hy
      rw [Set.mem_singleton_iff.mp hy, map_sub]
      simp [c]
    have hπ_eq : π_k F_a = π_k (MvPolynomial.C c) := sub_eq_zero.mp (by rw [← map_sub]; exact hmem_ker)
    have hπ_C : π_k (MvPolynomial.C c) = Ideal.Quotient.mk p_z (ψ₀ (MvPolynomial.C c)) :=
      π_k.commutes c
    have hq_eq : Ideal.Quotient.mk p_z a = Ideal.Quotient.mk p_z (ψ₀ (MvPolynomial.C c)) := by
      rw [← hF_a, hπ_eq, hπ_C]
    exact ⟨c, Ideal.Quotient.eq.mp hq_eq⟩

  choose c_center hc_center using fun i : Fin d => hNull (ψ₀ (MvPolynomial.X i))
  let τ_alg : P_T ≃ₐ[k] P_T :=
    { toFun := MvPolynomial.aeval (fun i : Fin d => MvPolynomial.X i - MvPolynomial.C (c_center i))
      invFun := MvPolynomial.aeval (fun i : Fin d => MvPolynomial.X i + MvPolynomial.C (c_center i))
      left_inv := fun P => by
        have hcomp : (MvPolynomial.aeval (fun i : Fin d => MvPolynomial.X i + MvPolynomial.C (c_center i))).comp
            (MvPolynomial.aeval (fun i : Fin d => MvPolynomial.X i - MvPolynomial.C (c_center i))) =
            AlgHom.id k P_T := by
          apply MvPolynomial.algHom_ext
          intro i
          dsimp [P_T]
          simp [MvPolynomial.algebraMap_eq]
        exact AlgHom.congr_fun hcomp P
      right_inv := fun P => by
        have hcomp : (MvPolynomial.aeval (fun i : Fin d => MvPolynomial.X i - MvPolynomial.C (c_center i))).comp
            (MvPolynomial.aeval (fun i : Fin d => MvPolynomial.X i + MvPolynomial.C (c_center i))) =
            AlgHom.id k P_T := by
          apply MvPolynomial.algHom_ext
          intro i
          dsimp [P_T]
          simp [MvPolynomial.algebraMap_eq]
        exact AlgHom.congr_fun hcomp P
      map_mul' := map_mul _
      map_add' := map_add _
      commutes' := (MvPolynomial.aeval _).commutes }

  let ψ_V : P_T →+* A_V := ψ₀.comp τ_alg.toRingEquiv.toRingHom
  have hCompC : ψ_V.comp MvPolynomial.C = ψ₀.comp MvPolynomial.C := by
    ext c
    change ψ₀ (τ_alg (algebraMap k P_T c)) = ψ₀ (MvPolynomial.C c)
    rw [τ_alg.commutes c]
    rfl
  have hEt_ψ : RingHom.Etale ψ_V :=
    RingHom.Etale.respectsIso.right ψ₀ τ_alg.toRingEquiv hEt₀
  have hCenter : ∀ i : Fin d, ψ_V (MvPolynomial.X i) ∈ p_z := by
    intro i
    change ψ₀ (τ_alg (MvPolynomial.X i)) ∈ p_z
    have hτX : τ_alg (MvPolynomial.X i) = MvPolynomial.X i - MvPolynomial.C (c_center i) := by
      change MvPolynomial.aeval _ (MvPolynomial.X i) = _
      exact MvPolynomial.aeval_X _ i
    rw [hτX, map_sub]
    exact hc_center i

  
  let κ_res : k →+* A_V ⧸ p_z := (Ideal.Quotient.mk p_z).comp (ψ_V.comp MvPolynomial.C)
  have hκ_bij : Function.Bijective κ_res := by
    let _ : Field (A_V ⧸ p_z) := Ideal.Quotient.field p_z
    refine ⟨κ_res.injective, ?_⟩
    intro q
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective q
    obtain ⟨c, hc⟩ := hNull a
    refine ⟨c, ?_⟩
    change Ideal.Quotient.mk p_z ((ψ_V.comp MvPolynomial.C) c) = Ideal.Quotient.mk p_z a
    rw [hCompC]
    exact (Ideal.Quotient.eq.mpr hc).symm
  let e_res : k ≃+* (A_V ⧸ p_z) := RingEquiv.ofBijective κ_res hκ_bij
  let q_A : A_V →+* k := e_res.symm.toRingHom.comp (Ideal.Quotient.mk p_z)
  have hqA_C : ∀ c : k, q_A (ψ_V (MvPolynomial.C c)) = c := by
    intro c
    exact e_res.symm_apply_apply c
  have hqA_ker : ∀ a : A_V, q_A a = 0 ↔ a ∈ p_z := by
    intro a
    change e_res.symm (Ideal.Quotient.mk p_z a) = 0 ↔ a ∈ p_z
    rw [← map_zero e_res.symm, e_res.symm.injective.eq_iff, Ideal.Quotient.eq_zero_iff_mem]
  have hqA_units : ∀ y : p_z.primeCompl, IsUnit (q_A y.1) := by
    intro y
    exact isUnit_iff_ne_zero.mpr (fun h0 => y.2 ((hqA_ker y.1).mp h0))
  let ev_ring : R_z →+* k := IsLocalization.lift (M := p_z.primeCompl) hqA_units
  have hev_loc : ∀ a : A_V, ev_ring (loc a) = q_A a :=
    IsLocalization.lift_eq hqA_units
  have hev_C : ∀ c : k, ev_ring (loc (ψ_V (MvPolynomial.C c))) = c := by
    intro c
    rw [hev_loc, hqA_C]
  have hev_mem_mz : ∀ r : R_z, r ∈ 𝔪_z ↔ ev_ring r = 0 := by
    intro r
    refine ⟨?_, ?_⟩
    · have hmz_eq : Ideal.map loc p_z = 𝔪_z :=
        IsLocalization.AtPrime.map_eq_maximalIdeal p_z R_z
      rw [← hmz_eq]
      have hle : Ideal.map loc p_z ≤ RingHom.ker ev_ring := by
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        change ev_ring (loc a) = 0
        rw [hev_loc]
        exact (hqA_ker a).mpr ha
      exact fun hr => hle hr
    · intro hr0
      by_contra hnot
      have hu : IsUnit r := IsLocalRing.notMem_maximalIdeal.mp hnot
      have hu0 : IsUnit (ev_ring r) := hu.map ev_ring
      rw [hr0] at hu0
      exact not_isUnit_zero hu0

  have hRes : ∀ r : R_z, ∃ c : k, r - loc (ψ_V (MvPolynomial.C c)) ∈ 𝔪_z := by
    intro r
    refine ⟨ev_ring r, (hev_mem_mz _).mpr ?_⟩
    rw [map_sub, hev_C, sub_self]

  
  have hJetInj : ∀ (n : ℕ) (P : P_T), loc (ψ_V P) ∈ 𝔪_z ^ n → P ∈ 𝔪_T ^ n := by
    let _ : Algebra P_T A_V := ψ_V.toAlgebra
    let _ : Algebra P_T k := MvPolynomial.constantCoeff.toAlgebra
    have _ : Algebra.Etale P_T A_V := RingHom.etale_algebraMap.mp hEt_ψ
    have _ : Algebra.FormallySmooth P_T A_V := inferInstance
    have _ : Algebra.FormallySmooth P_T R_z :=
      Algebra.FormallySmooth.instLocalization (R := P_T) (A := A_V) p_z.primeCompl
    have hev_comm : (ev_ring.comp (loc.comp ψ_V)) = MvPolynomial.constantCoeff := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change ev_ring (loc (ψ_V (MvPolynomial.C c))) = MvPolynomial.constantCoeff (MvPolynomial.C c)
        rw [hev_C, MvPolynomial.constantCoeff_C]
      · intro i
        change ev_ring (loc (ψ_V (MvPolynomial.X i))) = MvPolynomial.constantCoeff (MvPolynomial.X i)
        rw [hev_loc, (hqA_ker _).mpr (hCenter i), MvPolynomial.constantCoeff_X]
    let ev_z : R_z →ₐ[P_T] k :=
      { ev_ring with
        commutes' := fun P => by
          rw [IsScalarTower.algebraMap_apply P_T A_V R_z P]
          exact RingHom.congr_fun hev_comm P }
    have hmT_le_ker : 𝔪_T ≤ RingHom.ker (MvPolynomial.constantCoeff : P_T →+* k) := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact MvPolynomial.constantCoeff_X k i
    have hker_le_mT : RingHom.ker (MvPolynomial.constantCoeff : P_T →+* k) ≤ 𝔪_T := by
      intro P hP0
      have hcoeff0 : P.coeff 0 = 0 := hP0
      rw [MvPolynomial.as_sum P]
      refine Ideal.sum_mem 𝔪_T fun e he => ?_
      have he_ne : e ≠ 0 := by
        intro h0
        subst h0
        exact (MvPolynomial.mem_support_iff.mp he) hcoeff0
      have hex_i : ∃ i : Fin d, e i ≠ 0 := by
        by_contra! hall
        apply he_ne
        ext i
        exact hall i
      obtain ⟨i, hi_ne⟩ := hex_i
      let e' : Fin d →₀ ℕ := e - Finsupp.single i 1
      have he_eq : Finsupp.single i 1 + e' = e := by
        ext j
        simp only [Finsupp.add_apply, e', Finsupp.tsub_apply]
        by_cases hji : j = i
        · subst hji
          simp only [Finsupp.single_eq_same]
          omega
        · rw [Finsupp.single_eq_of_ne hji, zero_add, Nat.sub_zero]
      have hmon : MvPolynomial.monomial e (P.coeff e) =
          MvPolynomial.X i * MvPolynomial.monomial e' (P.coeff e) := by
        have hX1 : (MvPolynomial.X i : P_T) = MvPolynomial.monomial (Finsupp.single i 1) 1 := by
          simpa using (@MvPolynomial.X_pow_eq_monomial k (Fin d) 1 i _)
        rw [hX1, MvPolynomial.monomial_mul_monomial, one_mul, he_eq]
      rw [hmon]
      exact 𝔪_T.mul_mem_right _ (Ideal.subset_span ⟨i, rfl⟩)
    intro n P hP_in
    rcases Nat.eq_zero_or_pos n with rfl | hn_pos
    · rw [pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    · let B_n := P_T ⧸ (𝔪_T ^ n)
      have hpow_le : 𝔪_T ^ n ≤ RingHom.ker (MvPolynomial.constantCoeff : P_T →+* k) :=
        (Ideal.pow_le_self hn_pos.ne').trans hmT_le_ker
      let g_n_ring : B_n →+* k := Ideal.Quotient.lift (𝔪_T ^ n) MvPolynomial.constantCoeff hpow_le
      let g_n : B_n →ₐ[P_T] k :=
        { g_n_ring with
          commutes' := fun _ => rfl }
      have hg_surj : Function.Surjective g_n := by
        intro c
        refine ⟨Ideal.Quotient.mk (𝔪_T ^ n) (MvPolynomial.C c), ?_⟩
        exact MvPolynomial.constantCoeff_C (Fin d) c
      have hker_map : RingHom.ker (g_n : B_n →+* k) ≤
          Ideal.map (Ideal.Quotient.mk (𝔪_T ^ n)) 𝔪_T := by
        intro b hb
        obtain ⟨Q₀, rfl⟩ := Ideal.Quotient.mk_surjective b
        exact Ideal.mem_map_of_mem _ (hker_le_mT hb)
      have hpow_bot : (RingHom.ker (g_n : B_n →+* k)) ^ n = ⊥ := by
        refine eq_bot_iff.mpr ?_
        calc
          (RingHom.ker (g_n : B_n →+* k)) ^ n
              ≤ (Ideal.map (Ideal.Quotient.mk (𝔪_T ^ n)) 𝔪_T) ^ n :=
            Ideal.pow_right_mono hker_map n
          _ = Ideal.map (Ideal.Quotient.mk (𝔪_T ^ n)) (𝔪_T ^ n) :=
            (Ideal.map_pow (Ideal.Quotient.mk (𝔪_T ^ n)) 𝔪_T n).symm
          _ ≤ ⊥ := by
            rw [Ideal.map_le_iff_le_comap]
            intro x hx
            rw [Ideal.mem_comap, Submodule.mem_bot, Ideal.Quotient.eq_zero_iff_mem]
            exact hx
      have hg_nil : IsNilpotent (RingHom.ker (g_n : B_n →+* k)) := ⟨n, hpow_bot⟩
      let σ_n : R_z →ₐ[P_T] B_n :=
        Algebra.FormallySmooth.liftOfSurjective ev_z g_n hg_surj hg_nil
      have hσ_mz : Ideal.map σ_n.toRingHom 𝔪_z ≤ RingHom.ker (g_n : B_n →+* k) := by
        rw [Ideal.map_le_iff_le_comap]
        intro x hx
        exact (Algebra.FormallySmooth.liftOfSurjective_apply ev_z g_n hg_surj hg_nil x).trans
          ((hev_mem_mz x).mp hx)
      have hσ_pow_bot : Ideal.map σ_n.toRingHom (𝔪_z ^ n) ≤ ⊥ := by
        calc
          Ideal.map σ_n.toRingHom (𝔪_z ^ n) = (Ideal.map σ_n.toRingHom 𝔪_z) ^ n :=
            Ideal.map_pow σ_n.toRingHom 𝔪_z n
          _ ≤ (RingHom.ker (g_n : B_n →+* k)) ^ n := Ideal.pow_right_mono hσ_mz n
          _ = ⊥ := hpow_bot
      have hσ_zero : σ_n (loc (ψ_V P)) = 0 := by
        have hmem_bot := hσ_pow_bot (Ideal.mem_map_of_mem σ_n.toRingHom hP_in)
        rwa [Submodule.mem_bot] at hmem_bot
      have hσ_comm : σ_n (loc (ψ_V P)) = Ideal.Quotient.mk (𝔪_T ^ n) P := by
        have halg : loc (ψ_V P) = algebraMap P_T R_z P :=
          (IsScalarTower.algebraMap_apply P_T A_V R_z P).symm
        rw [halg]
        exact σ_n.commutes P
      rw [hσ_comm] at hσ_zero
      exact Ideal.Quotient.eq_zero_iff_mem.mp hσ_zero

  
  have hLinInj : ∀ (c : k) (v : Fin d → k),
      loc (ψ_V (MvPolynomial.C c + ∑ i : Fin d, MvPolynomial.C (v i) * MvPolynomial.X i)) ∈
        𝔪_z ^ 2 → c = 0 ∧ ∀ i : Fin d, v i = 0 := by
    intro c v hmem
    let L_lin : P_T := MvPolynomial.C c + ∑ i : Fin d, MvPolynomial.C (v i) * MvPolynomial.X i
    have hL_mT2 : L_lin ∈ 𝔪_T ^ 2 := hJetInj 2 L_lin hmem
    have hc0 : c = 0 := by
      have hnot_supp : (0 : Fin d →₀ ℕ) ∉ L_lin.support := by
        intro h0
        have hdeg := hDegFilt 2 L_lin hL_mT2 0 h0
        simp at hdeg
      have hcoeff0 : MvPolynomial.constantCoeff L_lin = 0 :=
        MvPolynomial.notMem_support_iff.mp hnot_supp
      dsimp [L_lin] at hcoeff0
      simp only [map_add, MvPolynomial.constantCoeff_C, map_sum, map_mul,
        MvPolynomial.constantCoeff_X, mul_zero, Finset.sum_const_zero, add_zero] at hcoeff0
      exact hcoeff0
    refine ⟨hc0, fun i₀ => ?_⟩
    let e₀ : Fin d →₀ ℕ := Finsupp.single i₀ 1
    have hnot_supp : e₀ ∉ L_lin.support := by
      intro he₀
      have hdeg := hDegFilt 2 L_lin hL_mT2 e₀ he₀
      have hsum1 : (∑ j : Fin d, e₀ j) = 1 := by
        rw [Finset.sum_eq_single i₀]
        · exact Finsupp.single_eq_same
        · intro j _ hji₀
          exact Finsupp.single_eq_of_ne hji₀
        · intro hi₀
          exact absurd (Finset.mem_univ i₀) hi₀
      omega
    have hcoeff_e₀ : (MvPolynomial.lcoeff k e₀) L_lin = 0 := by
      rw [MvPolynomial.lcoeff_apply]
      exact MvPolynomial.notMem_support_iff.mp hnot_supp
    dsimp [L_lin] at hcoeff_e₀
    have he₀_ne : (0 : Fin d →₀ ℕ) ≠ e₀ := (Finsupp.single_ne_zero.mpr one_ne_zero).symm
    rw [map_add, map_sum, MvPolynomial.lcoeff_apply, MvPolynomial.coeff_C,
      ite_eq_right_iff.mpr fun h => absurd h he₀_ne, zero_add,
      Finset.sum_eq_single i₀] at hcoeff_e₀
    · rw [MvPolynomial.lcoeff_apply, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X',
        ite_eq_left_iff.mpr fun h => absurd rfl h, mul_one] at hcoeff_e₀
      exact hcoeff_e₀
    · intro i _ hii₀
      rw [MvPolynomial.lcoeff_apply, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X']
      have hne_single : Finsupp.single i 1 ≠ e₀ := by
        intro heq
        have hval := congrArg (fun f : Fin d →₀ ℕ => f i₀) heq
        simp only [e₀, Finsupp.single_eq_same, Finsupp.single_eq_of_ne (Ne.symm hii₀)] at hval
        exact zero_ne_one hval
      rw [ite_eq_right_iff.mpr fun h => absurd h hne_single, mul_zero]
    · intro hi₀
      exact absurd (Finset.mem_univ i₀) hi₀

  
  have hScalar : ∀ c : k,
      φ_V (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (MvPolynomial.X μ₀))
        (algebraMap k ↥(𝒜_N 0) c)) = ψ_V (MvPolynomial.C c) := by
    intro c
    rw [hScalar₀ c]
    exact (RingHom.congr_fun hCompC c).symm

  let S_pow : Submonoid (MvPolynomial (Fin (N + 1)) k) := Submonoid.powers (MvPolynomial.X μ₀)
  let x_pow1 : ↥(Submonoid.powers (MvPolynomial.X μ₀ : MvPolynomial (Fin (N + 1)) k)) :=
    ⟨MvPolynomial.X μ₀, Submonoid.mem_powers (MvPolynomial.X μ₀)⟩
  let valRingHom : H₀ →+* Localization S_pow :=
    { toFun := HomogeneousLocalization.val
      map_one' := HomogeneousLocalization.val_one
      map_mul' := HomogeneousLocalization.val_mul
      map_zero' := HomogeneousLocalization.val_zero
      map_add' := HomogeneousLocalization.val_add }
  have hval_eq : ∀ z : H₀, z.val = valRingHom z := fun _ => rfl
  have hval_mk : ∀ nd : HomogeneousLocalization.NumDenSameDeg 𝒜_N S_pow,
      valRingHom (HomogeneousLocalization.mk nd) =
        Localization.mk nd.num.1 ⟨nd.den.1, nd.den_mem⟩ :=
    HomogeneousLocalization.val_mk
  let hl₁ : ∀ (L : MvPolynomial (Fin (N + 1)) k), L ∈ 𝒜_N 1 → H₀ :=
    fun L hL => HomogeneousLocalization.mk
      ⟨1, ⟨L, hL⟩, ⟨MvPolynomial.X μ₀, hXμ⟩, Submonoid.mem_powers (MvPolynomial.X μ₀)⟩
  let fromZero : k → H₀ := fun c =>
    HomogeneousLocalization.fromZeroRingHom 𝒜_N S_pow (algebraMap k ↥(𝒜_N 0) c)
  have hval_fromZero : ∀ c : k,
      valRingHom (fromZero c) = Localization.mk (MvPolynomial.C c) 1 := by
    intro c
    have hmk : fromZero c = HomogeneousLocalization.mk
        ⟨0, algebraMap k ↥(𝒜_N 0) c, 1, S_pow.one_mem⟩ := rfl
    rw [hmk, hval_mk, SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    rfl
  have hval_hl₁ : ∀ (L : MvPolynomial (Fin (N + 1)) k) (hL : L ∈ 𝒜_N 1),
      valRingHom (hl₁ L hL) = Localization.mk L x_pow1 := by
    intro L hL
    exact hval_mk _
  have hmk_eq_of_mul : ∀ (a b : MvPolynomial (Fin (N + 1)) k)
      (s t : ↥(Submonoid.powers (MvPolynomial.X μ₀ : MvPolynomial (Fin (N + 1)) k))),
      a * t.1 = b * s.1 → Localization.mk a s = Localization.mk b t := by
    intro a b s t hmul
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [Submonoid.coe_one, one_mul]
    calc
      t.1 * a = a * t.1 := mul_comm _ _
      _ = b * s.1 := hmul
      _ = s.1 * b := mul_comm _ _
  have h_loc_mk_sum : ∀ {α : Type} (s : Finset α) (f : α → MvPolynomial (Fin (N + 1)) k)
      (den : ↥(Submonoid.powers (MvPolynomial.X μ₀ : MvPolynomial (Fin (N + 1)) k))),
      (∑ x ∈ s, Localization.mk (f x) den) = Localization.mk (∑ x ∈ s, f x) den := by
    classical
    intro α s f den
    induction s using Finset.induction_on with
    | empty =>
      simp [Localization.mk_zero]
    | @insert x s' hxs ih =>
      rw [Finset.sum_insert hxs, Finset.sum_insert hxs, ih, Localization.add_mk_self]
  have h_loc_mk_prod : ∀ {α : Type} (s : Finset α) (f : α → MvPolynomial (Fin (N + 1)) k)
      (g : α → ↥(Submonoid.powers (MvPolynomial.X μ₀ : MvPolynomial (Fin (N + 1)) k))),
      (∏ x ∈ s, Localization.mk (f x) (g x)) = Localization.mk (∏ x ∈ s, f x) (∏ x ∈ s, g x) := by
    classical
    intro α s f g
    induction s using Finset.induction_on with
    | empty =>
      simp [Localization.mk_one]
    | @insert x s' hxs ih =>
      rw [Finset.prod_insert hxs, Finset.prod_insert hxs, Finset.prod_insert hxs, ih,
        Localization.mk_mul]

  let hX_ν : ∀ ν : Fin (N + 1), (MvPolynomial.X ν : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1 :=
    fun ν => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k ν)
  let Y_ν : Fin (N + 1) → H₀ := fun ν => hl₁ (MvPolynomial.X ν) (hX_ν ν)
  let y_ν : Fin (N + 1) → A_V := fun ν => φ_V (Y_ν ν)
  let a_ν : Fin (N + 1) → k := fun ν => ev_ring (loc (y_ν ν))
  let X_tilde : Fin (N + 1) → MvPolynomial (Fin (N + 1)) k :=
    fun ν => MvPolynomial.X ν - MvPolynomial.C (a_ν ν) * MvPolynomial.X μ₀
  have hX_tilde_mem : ∀ ν : Fin (N + 1), X_tilde ν ∈ 𝒜_N 1 := by
    intro ν
    refine Submodule.sub_mem _ (hX_ν ν) ?_
    rw [← MvPolynomial.smul_eq_C_mul]
    exact Submodule.smul_mem _ (a_ν ν) hXμ
  let y_tilde : Fin (N + 1) → A_V := fun ν => φ_V (hl₁ (X_tilde ν) (hX_tilde_mem ν))
  have hy_tilde_eq : ∀ ν : Fin (N + 1), y_tilde ν = y_ν ν - ψ_V (MvPolynomial.C (a_ν ν)) := by
    intro ν
    have hH_eq : hl₁ (X_tilde ν) (hX_tilde_mem ν) = Y_ν ν - fromZero (a_ν ν) := by
      apply HomogeneousLocalization.val_injective
      rw [hval_eq, hval_eq, map_sub, hval_hl₁, hval_hl₁, hval_fromZero]
      have h1 : Localization.mk (MvPolynomial.C (a_ν ν)) (1 : S_pow) =
          Localization.mk (MvPolynomial.C (a_ν ν) * MvPolynomial.X μ₀) x_pow1 := by
        apply hmk_eq_of_mul
        dsimp [x_pow1]
        simp
      rw [h1, sub_eq_add_neg, Localization.neg_mk, Localization.add_mk_self, ← sub_eq_add_neg]
    change φ_V (hl₁ (X_tilde ν) (hX_tilde_mem ν)) = _
    rw [hH_eq, map_sub, hScalar]
  have hy_tilde_mz : ∀ ν : Fin (N + 1), loc (y_tilde ν) ∈ 𝔪_z := by
    intro ν
    rw [hy_tilde_eq, map_sub, hev_mem_mz, map_sub, hev_C]
    exact sub_self (a_ν ν)

  let jet_lin : (Fin (N + 1) → k) → R_z :=
    fun b => ∑ ν : Fin (N + 1), loc (ψ_V (MvPolynomial.C (b ν))) * loc (y_tilde ν)
  have hjet_lin_mz : ∀ b : Fin (N + 1) → k, jet_lin b ∈ 𝔪_z := by
    intro b
    exact Ideal.sum_mem 𝔪_z fun ν _ => 𝔪_z.mul_mem_left _ (hy_tilde_mz ν)
  let jet_elem : k → (Fin (N + 1) → k) → R_z :=
    fun c b => loc (ψ_V (MvPolynomial.C c)) + jet_lin b
  have hjet_zero : jet_elem 0 (fun _ => 0) = 0 := by
    simp [jet_elem, jet_lin]
  have hjet_add : ∀ (c₁ c₂ : k) (b₁ b₂ : Fin (N + 1) → k),
      jet_elem (c₁ + c₂) (fun ν => b₁ ν + b₂ ν) = jet_elem c₁ b₁ + jet_elem c₂ b₂ := by
    intro c₁ c₂ b₁ b₂
    dsimp only [jet_elem, jet_lin]
    simp only [map_add, add_mul, Finset.sum_add_distrib]
    ring

  let S_lin : Subring R_z :=
    { carrier := { z : R_z | ∃ (c : k) (b : Fin (N + 1) → k), z - jet_elem c b ∈ 𝔪_z ^ 2 }
      zero_mem' := ⟨0, fun _ => 0, by
        rw [hjet_zero, sub_self]
        exact Ideal.zero_mem _⟩
      one_mem' := ⟨1, fun _ => 0, by
        have h1 : jet_elem 1 (fun _ => 0) = 1 := by
          simp [jet_elem, jet_lin]
        rw [h1, sub_self]
        exact Ideal.zero_mem _⟩
      add_mem' := fun {z₁ z₂} ⟨c₁, b₁, hz₁⟩ ⟨c₂, b₂, hz₂⟩ => ⟨c₁ + c₂, fun ν => b₁ ν + b₂ ν, by
        have hdiff : (z₁ + z₂) - jet_elem (c₁ + c₂) (fun ν => b₁ ν + b₂ ν) =
            (z₁ - jet_elem c₁ b₁) + (z₂ - jet_elem c₂ b₂) := by
          rw [hjet_add]; ring
        rw [hdiff]
        exact Ideal.add_mem _ hz₁ hz₂⟩
      neg_mem' := fun {z} ⟨c, b, hz⟩ => ⟨-c, fun ν => -b ν, by
        have hneg : jet_elem (-c) (fun ν => -b ν) = -jet_elem c b := by
          apply eq_neg_of_add_eq_zero_left
          rw [← hjet_add, neg_add_cancel]
          have hb0 : (fun ν : Fin (N + 1) => -b ν + b ν) = (fun _ => 0) := by
            ext ν
            exact neg_add_cancel (b ν)
          rw [hb0, hjet_zero]
        have hdiff : -z - jet_elem (-c) (fun ν => -b ν) = -(z - jet_elem c b) := by
          rw [hneg]; ring
        rw [hdiff]
        exact (𝔪_z ^ 2).neg_mem hz⟩
      mul_mem' := fun {z₁ z₂} ⟨c₁, b₁, hz₁⟩ ⟨c₂, b₂, hz₂⟩ =>
        ⟨c₁ * c₂, fun ν => c₁ * b₂ ν + c₂ * b₁ ν, by
          let γ₁ := loc (ψ_V (MvPolynomial.C c₁))
          let γ₂ := loc (ψ_V (MvPolynomial.C c₂))
          let δ₁ := jet_lin b₁
          let δ₂ := jet_lin b₂
          let ε₁ := z₁ - (γ₁ + δ₁)
          let ε₂ := z₂ - (γ₂ + δ₂)
          have hjet_mul : jet_elem (c₁ * c₂) (fun ν => c₁ * b₂ ν + c₂ * b₁ ν) =
              γ₁ * γ₂ + γ₁ * δ₂ + γ₂ * δ₁ := by
            dsimp only [jet_elem, jet_lin, γ₁, γ₂, δ₁, δ₂]
            simp only [map_mul, map_add, add_mul, Finset.mul_sum]
            rw [add_assoc]
            congr 1
            rw [← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl fun ν _ => by ring
          have hdiff : z₁ * z₂ - jet_elem (c₁ * c₂) (fun ν => c₁ * b₂ ν + c₂ * b₁ ν) =
              δ₁ * δ₂ + ε₁ * z₂ + (γ₁ + δ₁) * ε₂ := by
            rw [hjet_mul]
            dsimp [ε₁, ε₂]
            ring
          rw [hdiff]
          have hδ_prod : δ₁ * δ₂ ∈ 𝔪_z ^ 2 := by
            rw [pow_two]
            exact Ideal.mul_mem_mul (hjet_lin_mz b₁) (hjet_lin_mz b₂)
          have hε₁_mem : ε₁ * z₂ ∈ 𝔪_z ^ 2 := (𝔪_z ^ 2).mul_mem_right z₂ hz₁
          have hε₂_mem : (γ₁ + δ₁) * ε₂ ∈ 𝔪_z ^ 2 := (𝔪_z ^ 2).mul_mem_left (γ₁ + δ₁) hz₂
          exact Ideal.add_mem _ (Ideal.add_mem _ hδ_prod hε₁_mem) hε₂_mem⟩ }
  have hmem_S_lin : ∀ z : R_z,
      z ∈ S_lin ↔ ∃ (c : k) (b : Fin (N + 1) → k), z - jet_elem c b ∈ 𝔪_z ^ 2 :=
    fun _ => Iff.rfl

  have hS_inv : ∀ (u : R_z) (hu : IsUnit u), u ∈ S_lin → (↑(hu.unit⁻¹) : R_z) ∈ S_lin := by
    intro u hu hu_S
    obtain ⟨c, b, hu_mem⟩ := (hmem_S_lin u).mp hu_S
    let γ := loc (ψ_V (MvPolynomial.C c))
    let δ := jet_lin b
    let ε := u - (γ + δ)
    have hε_m2 : ε ∈ 𝔪_z ^ 2 := hu_mem
    have hε_m : ε ∈ 𝔪_z := Ideal.pow_le_self (by decide : 2 ≠ 0) hε_m2
    have hc_ne : c ≠ 0 := by
      intro hc0
      have hγ0 : γ = 0 := by simp [γ, hc0]
      have hu_eq : u = δ + ε := by dsimp [ε]; rw [hγ0]; ring
      have hu_in_mz : u ∈ 𝔪_z := hu_eq ▸ Ideal.add_mem _ (hjet_lin_mz b) hε_m
      exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hu_in_mz
    let b' : Fin (N + 1) → k := fun ν => -(c⁻¹ ^ 2) * b ν
    let γ_inv := loc (ψ_V (MvPolynomial.C c⁻¹))
    have hγγ : γ * γ_inv = 1 := by
      dsimp [γ, γ_inv]
      rw [← map_mul, ← map_mul, ← map_mul, mul_inv_cancel₀ hc_ne, map_one, map_one, map_one]
    have hjet_b' : jet_elem c⁻¹ b' = γ_inv - γ_inv ^ 2 * δ := by
      apply eq_sub_of_add_eq
      have hsum0 : jet_lin b' + γ_inv ^ 2 * δ = 0 := by
        dsimp only [jet_lin, γ_inv, δ, b']
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_eq_zero fun ν _ => ?_
        have h0 : -(c⁻¹ ^ 2) * b ν + c⁻¹ ^ 2 * b ν = 0 := by ring
        have hterm : loc (ψ_V (MvPolynomial.C (-(c⁻¹ ^ 2) * b ν))) * loc (y_tilde ν) +
            loc (ψ_V (MvPolynomial.C c⁻¹)) ^ 2 *
              (loc (ψ_V (MvPolynomial.C (b ν))) * loc (y_tilde ν)) =
            loc (ψ_V (MvPolynomial.C (-(c⁻¹ ^ 2) * b ν + c⁻¹ ^ 2 * b ν))) * loc (y_tilde ν) := by
          simp only [map_add, map_mul, map_pow]
          ring
        rw [hterm, h0, map_zero, map_zero, map_zero, zero_mul]
      dsimp only [jet_elem]
      rw [add_assoc, hsum0, add_zero]
    let v := jet_elem c⁻¹ b'
    have huv_m2 : u * v - 1 ∈ 𝔪_z ^ 2 := by
      have hid : u * v - 1 =
          -(γ_inv ^ 2) * (δ * δ) + (γ * γ_inv - 1) * (1 - γ_inv * δ) + ε * v := by
        calc
          u * v - 1 = (γ + δ) * v - 1 + ε * v := by dsimp [ε]; ring
          _ = (γ + δ) * (γ_inv - γ_inv ^ 2 * δ) - 1 + ε * v := by dsimp [v]; rw [hjet_b']
          _ = -(γ_inv ^ 2) * (δ * δ) + (γ * γ_inv - 1) * (1 - γ_inv * δ) + ε * v := by ring
      rw [hid, hγγ, sub_self, zero_mul, add_zero]
      have hδ2 : -(γ_inv ^ 2) * (δ * δ) ∈ 𝔪_z ^ 2 := by
        refine (𝔪_z ^ 2).mul_mem_left _ ?_
        rw [pow_two]
        exact Ideal.mul_mem_mul (hjet_lin_mz b) (hjet_lin_mz b)
      exact Ideal.add_mem _ hδ2 ((𝔪_z ^ 2).mul_mem_right v hε_m2)
    refine ⟨c⁻¹, b', ?_⟩
    have hu_inv_mul : (↑(hu.unit⁻¹) : R_z) * u = 1 := Units.inv_mul hu.unit
    have hdiff : (↑(hu.unit⁻¹) : R_z) - v = -(↑(hu.unit⁻¹) : R_z) * (u * v - 1) := by
      calc
        (↑(hu.unit⁻¹) : R_z) - v = (↑(hu.unit⁻¹) : R_z) - ((↑(hu.unit⁻¹) : R_z) * u) * v := by
          rw [hu_inv_mul, one_mul]
        _ = -(↑(hu.unit⁻¹) : R_z) * (u * v - 1) := by ring
    rw [hdiff]
    exact (𝔪_z ^ 2).mul_mem_left _ huv_m2

  have hScalar_mem_S : ∀ c : k, loc (ψ_V (MvPolynomial.C c)) ∈ S_lin := by
    intro c
    refine ⟨c, fun _ => 0, ?_⟩
    have h0 : jet_lin (fun _ => 0) = 0 := by simp [jet_lin]
    simp [jet_elem, h0]
  have hy_mem_S : ∀ ν : Fin (N + 1), loc (y_ν ν) ∈ S_lin := by
    intro ν
    classical
    refine ⟨a_ν ν, Pi.single ν 1, ?_⟩
    have hlin : jet_lin (Pi.single ν 1) = loc (y_tilde ν) := by
      dsimp [jet_lin]
      rw [Finset.sum_eq_single ν]
      · simp
      · intro μ _ hμν
        rw [Pi.single_eq_of_ne hμν]
        simp
      · intro hν
        exact absurd (Finset.mem_univ ν) hν
    have heq : loc (y_ν ν) - jet_elem (a_ν ν) (Pi.single ν 1) = 0 := by
      dsimp [jet_elem]
      rw [hlin, hy_tilde_eq, map_sub]
      ring
    rw [heq]
    exact Ideal.zero_mem _
  have hH₀_mem_S : ∀ w : H₀, loc (φ_V w) ∈ S_lin := by
    classical
    intro w
    obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective w
    obtain ⟨e, he⟩ := nd.den_mem
    have he' : MvPolynomial.X μ₀ ^ e = nd.den.1 := he
    have hdeg_eq : nd.deg = e := by
      have hpow : (MvPolynomial.X μ₀ ^ e : MvPolynomial (Fin (N + 1)) k) =
          MvPolynomial.monomial (Finsupp.single μ₀ e) 1 := by
        simpa using (@MvPolynomial.X_pow_eq_monomial k (Fin (N + 1)) e μ₀ _)
      have hcoeff_ne : nd.den.1.coeff (Finsupp.single μ₀ e) ≠ 0 := by
        rw [← he', hpow, MvPolynomial.coeff_monomial, ite_eq_left_iff.mpr fun h => absurd rfl h]
        exact one_ne_zero
      have hhom : nd.den.1.IsHomogeneous nd.deg := nd.den.2
      have h1 := hhom hcoeff_ne
      simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1.symm
    let P_num := nd.num.1
    have hdecomp : HomogeneousLocalization.mk nd =
        ∑ m_exp ∈ P_num.support,
          fromZero (P_num.coeff m_exp) * ∏ ν : Fin (N + 1), (Y_ν ν) ^ (m_exp ν) := by
      apply HomogeneousLocalization.val_injective
      rw [hval_eq, hval_eq, hval_mk, map_sum]
      have hterm_eq : ∀ m_exp ∈ P_num.support,
          valRingHom (fromZero (P_num.coeff m_exp) * ∏ ν : Fin (N + 1), (Y_ν ν) ^ (m_exp ν)) =
            Localization.mk (MvPolynomial.monomial m_exp (P_num.coeff m_exp))
              ⟨nd.den.1, nd.den_mem⟩ := by
        intro m_exp hm_exp
        have hm_deg : (∑ ν : Fin (N + 1), m_exp ν) = e := by
          have hhom : P_num.IsHomogeneous nd.deg := nd.num.2
          have h1 := hhom (MvPolynomial.mem_support_iff.mp hm_exp)
          have h2 : (∑ ν : Fin (N + 1), m_exp ν) = nd.deg := by
            simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1
          exact h2.trans hdeg_eq
        rw [map_mul, hval_fromZero, map_prod]
        have hpow_val : ∀ ν : Fin (N + 1),
            valRingHom ((Y_ν ν) ^ (m_exp ν)) =
              Localization.mk ((MvPolynomial.X ν : MvPolynomial (Fin (N + 1)) k) ^ (m_exp ν))
                (x_pow1 ^ (m_exp ν)) := by
          intro ν
          rw [map_pow, hval_hl₁, Localization.mk_pow]
        simp_rw [hpow_val]
        rw [h_loc_mk_prod Finset.univ, Localization.mk_mul, one_mul]
        apply hmk_eq_of_mul
        have hden_prod : ((∏ x : Fin (N + 1), x_pow1 ^ (m_exp x)) :
            ↥(Submonoid.powers (MvPolynomial.X μ₀ : MvPolynomial (Fin (N + 1)) k))).1 =
            MvPolynomial.X μ₀ ^ e := by
          rw [Submonoid.coe_finsetProd]
          simp only [SubmonoidClass.coe_pow, x_pow1]
          rw [Finset.prod_pow_eq_pow_sum, hm_deg]
        rw [← he', hden_prod, MvPolynomial.monomial_eq,
          Finsupp.prod_of_support_subset m_exp (Finset.subset_univ _) _ (fun ν _ => pow_zero _)]
      rw [Finset.sum_congr rfl hterm_eq, h_loc_mk_sum P_num.support, ← MvPolynomial.as_sum P_num]
    rw [hdecomp, map_sum, map_sum]
    refine S_lin.sum_mem fun m_exp _ => ?_
    rw [map_mul, map_mul, hScalar]
    refine S_lin.mul_mem (hScalar_mem_S _) ?_
    rw [map_prod, map_prod]
    refine S_lin.prod_mem fun ν _ => ?_
    rw [map_pow, map_pow]
    exact S_lin.pow_mem (hy_mem_S ν) _

  have hAV_mem_S : ∀ x : A_V, loc x ∈ S_lin := by
    intro x
    obtain ⟨n, w, hxw⟩ := hSpan_uden x
    have hu_n : IsUnit (loc ((φ_V u_den) ^ n)) := (hUnit_uden.pow n).map loc
    have hu_n_S : loc ((φ_V u_den) ^ n) ∈ S_lin := by
      rw [← map_pow]
      exact hH₀_mem_S (u_den ^ n)
    have hinv_S : (↑(hu_n.unit⁻¹) : R_z) ∈ S_lin := hS_inv _ hu_n hu_n_S
    have hmul1 : loc ((φ_V u_den) ^ n) * (↑(hu_n.unit⁻¹) : R_z) = 1 := Units.mul_inv hu_n.unit
    have hx_eq : loc x = loc (φ_V w) * (↑(hu_n.unit⁻¹) : R_z) := by
      calc
        loc x = loc x * (loc ((φ_V u_den) ^ n) * (↑(hu_n.unit⁻¹) : R_z)) := by
          rw [hmul1, mul_one]
        _ = loc (x * (φ_V u_den) ^ n) * (↑(hu_n.unit⁻¹) : R_z) := by
          rw [map_mul, mul_assoc]
        _ = loc (φ_V w) * (↑(hu_n.unit⁻¹) : R_z) := by rw [hxw]
    rw [hx_eq]
    exact S_lin.mul_mem (hH₀_mem_S w) hinv_S

  choose c_lift b_lift hb_lift using fun i : Fin d => hAV_mem_S (ψ_V (MvPolynomial.X i))
  have hc_lift_zero : ∀ i : Fin d, c_lift i = 0 := by
    intro i
    have hdiff_mz : loc (ψ_V (MvPolynomial.X i)) - jet_elem (c_lift i) (b_lift i) ∈ 𝔪_z :=
      Ideal.pow_le_self (by decide : 2 ≠ 0) (hb_lift i)
    have ht_mz : loc (ψ_V (MvPolynomial.X i)) ∈ 𝔪_z :=
      (hev_mem_mz _).mpr (by rw [hev_loc]; exact (hqA_ker _).mpr (hCenter i))
    have hγ_mz : loc (ψ_V (MvPolynomial.C (c_lift i))) ∈ 𝔪_z := by
      have heq : loc (ψ_V (MvPolynomial.C (c_lift i))) =
          loc (ψ_V (MvPolynomial.X i)) -
            (loc (ψ_V (MvPolynomial.X i)) - jet_elem (c_lift i) (b_lift i)) -
            jet_lin (b_lift i) := by
        dsimp [jet_elem]
        ring
      rw [heq]
      exact Ideal.sub_mem _ (Ideal.sub_mem _ ht_mz hdiff_mz) (hjet_lin_mz (b_lift i))
    have h0 := (hev_mem_mz _).mp hγ_mz
    rwa [hev_C] at h0

  let L_form : Fin d → MvPolynomial (Fin (N + 1)) k :=
    fun i => ∑ ν : Fin (N + 1), MvPolynomial.C (b_lift i ν) * X_tilde ν
  have hL_mem : ∀ i : Fin d, L_form i ∈ 𝒜_N 1 := by
    intro i
    refine Submodule.sum_mem _ fun ν _ => ?_
    rw [← MvPolynomial.smul_eq_C_mul]
    exact Submodule.smul_mem _ (b_lift i ν) (hX_tilde_mem ν)
  have hL_hl₁_eq : ∀ i : Fin d,
      loc (φ_V (hl₁ (L_form i) (hL_mem i))) = jet_lin (b_lift i) := by
    intro i
    have hH_eq : hl₁ (L_form i) (hL_mem i) =
        ∑ ν : Fin (N + 1), fromZero (b_lift i ν) * hl₁ (X_tilde ν) (hX_tilde_mem ν) := by
      apply HomogeneousLocalization.val_injective
      rw [hval_eq, hval_eq, hval_hl₁, map_sum]
      have hterm : ∀ ν : Fin (N + 1),
          valRingHom (fromZero (b_lift i ν) * hl₁ (X_tilde ν) (hX_tilde_mem ν)) =
            Localization.mk (MvPolynomial.C (b_lift i ν) * X_tilde ν) x_pow1 := by
        intro ν
        rw [map_mul, hval_fromZero, hval_hl₁, Localization.mk_mul]
        apply hmk_eq_of_mul
        dsimp [x_pow1]
        simp
      simp_rw [hterm]
      rw [h_loc_mk_sum Finset.univ]
    rw [hH_eq, map_sum, map_sum]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [map_mul, map_mul, hScalar]
  have hL_approx : ∀ i : Fin d,
      loc (φ_V (hl₁ (L_form i) (hL_mem i))) - loc (ψ_V (MvPolynomial.X i)) ∈ 𝔪_z ^ 2 := by
    intro i
    rw [hL_hl₁_eq i]
    have hb := hb_lift i
    dsimp [jet_elem] at hb
    rw [hc_lift_zero i, map_zero, map_zero, map_zero, zero_add] at hb
    have hneg := (𝔪_z ^ 2).neg_mem hb
    rwa [neg_sub] at hneg

  
  refine ⟨μ₀, hXμ, V, hAffV, hz₀_V, hVU₀, hVμ, ψ_V, Q, ?_, ?_, hCenter, hRes, hLinInj,
    hQ_pkg.1, hQ_pkg.2.1, ?_, ?_⟩
  · have _ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_V)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_ψ
    have _ : CategoryTheory.IsIso V.toSpecΓ := hAffV.isoSpec_hom ▸ inferInstance
    infer_instance
  · have hC_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_V) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hCompC,
        CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    rw [hC_eq]
    exact hComm₀
  · intro hQ_in
    exact hQ_pkg.2.2 (hJetInj 3 Q hQ_in)
  · intro u₀
    let S_quad : MvPolynomial (Fin (N + 1)) k :=
      ∑ s : Fin (m + 1), L_form (a_idx s) * L_form (b_idx s)
    have hS_quad_mem : S_quad ∈ 𝒜_N 2 := by
      refine Submodule.sum_mem _ fun s _ => ?_
      rw [MvPolynomial.mem_homogeneousSubmodule]
      have ha : (L_form (a_idx s)).IsHomogeneous 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mp (hL_mem (a_idx s))
      have hb : (L_form (b_idx s)).IsHomogeneous 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mp (hL_mem (b_idx s))
      exact ha.mul hb
    let F : MvPolynomial (Fin (N + 1)) k :=
      MvPolynomial.C u₀ * MvPolynomial.X μ₀ * S_quad
    have hF : F ∈ 𝒜_N 3 := by
      dsimp [F]
      rw [mul_assoc, ← MvPolynomial.smul_eq_C_mul]
      refine Submodule.smul_mem _ u₀ ?_
      rw [MvPolynomial.mem_homogeneousSubmodule]
      have hX_hom : (MvPolynomial.X μ₀ : MvPolynomial (Fin (N + 1)) k).IsHomogeneous 1 :=
        MvPolynomial.isHomogeneous_X k μ₀
      have hS_hom : S_quad.IsHomogeneous 2 :=
        (MvPolynomial.mem_homogeneousSubmodule 2 _).mp hS_quad_mem
      exact hX_hom.mul hS_hom
    refine ⟨F, hF, ?_⟩
    have hF_hl :
        (HomogeneousLocalization.mk ⟨3, ⟨F, hF⟩,
          ⟨MvPolynomial.X μ₀ ^ 3, (MvPolynomial.mem_homogeneousSubmodule 3 _).mpr
            (MvPolynomial.isHomogeneous_X_pow μ₀ 3)⟩, ⟨3, rfl⟩⟩ : H₀) =
        fromZero u₀ * ∑ s : Fin (m + 1),
          hl₁ (L_form (a_idx s)) (hL_mem (a_idx s)) *
            hl₁ (L_form (b_idx s)) (hL_mem (b_idx s)) := by
      apply HomogeneousLocalization.val_injective
      rw [hval_eq, hval_eq, hval_mk, map_mul, hval_fromZero, map_sum]
      have hpair : ∀ s : Fin (m + 1),
          valRingHom (hl₁ (L_form (a_idx s)) (hL_mem (a_idx s)) *
            hl₁ (L_form (b_idx s)) (hL_mem (b_idx s))) =
          Localization.mk (L_form (a_idx s) * L_form (b_idx s))
            (x_pow1 ^ 2) := by
        intro s
        rw [map_mul, hval_hl₁, hval_hl₁, Localization.mk_mul]
        apply hmk_eq_of_mul
        dsimp [x_pow1]
        ring
      simp_rw [hpair]
      rw [h_loc_mk_sum Finset.univ, Localization.mk_mul]
      apply hmk_eq_of_mul
      dsimp [F, S_quad, x_pow1]
      ring
    change loc (φ_V _ - ψ_V (MvPolynomial.C u₀ * Q)) ∈ 𝔪_z ^ 3
    rw [hF_hl, map_sub, map_mul, hScalar u₀, map_sum, map_mul, map_mul, map_mul, map_sum,
      ← mul_sub]
    refine (𝔪_z ^ 3).mul_mem_left (loc (ψ_V (MvPolynomial.C u₀))) ?_
    dsimp only [Q]
    rw [map_sum, map_sum, ← Finset.sum_sub_distrib]
    refine Ideal.sum_mem (𝔪_z ^ 3) fun s _ => ?_
    rw [map_mul, map_mul, map_mul, map_mul]
    let ℓ_a := loc (φ_V (hl₁ (L_form (a_idx s)) (hL_mem (a_idx s))))
    let ℓ_b := loc (φ_V (hl₁ (L_form (b_idx s)) (hL_mem (b_idx s))))
    let t_a := loc (ψ_V (MvPolynomial.X (a_idx s)))
    let t_b := loc (ψ_V (MvPolynomial.X (b_idx s)))
    change ℓ_a * ℓ_b - t_a * t_b ∈ 𝔪_z ^ 3
    have hid : ℓ_a * ℓ_b - t_a * t_b = (ℓ_a - t_a) * ℓ_b + t_a * (ℓ_b - t_b) := by ring
    rw [hid]
    have ht_a_mz : t_a ∈ 𝔪_z :=
      (hev_mem_mz _).mpr (by rw [hev_loc]; exact (hqA_ker _).mpr (hCenter (a_idx s)))
    have ht_b_mz : t_b ∈ 𝔪_z :=
      (hev_mem_mz _).mpr (by rw [hev_loc]; exact (hqA_ker _).mpr (hCenter (b_idx s)))
    have hℓ_b_mz : ℓ_b ∈ 𝔪_z := by
      have heq : ℓ_b = (ℓ_b - t_b) + t_b := by ring
      rw [heq]
      exact Ideal.add_mem _ (Ideal.pow_le_self (by decide : 2 ≠ 0) (hL_approx (b_idx s))) ht_b_mz
    have h1 : (ℓ_a - t_a) * ℓ_b ∈ 𝔪_z ^ 3 := by
      rw [show (3 : ℕ) = 2 + 1 from rfl, pow_succ]
      exact Ideal.mul_mem_mul (hL_approx (a_idx s)) hℓ_b_mz
    have h2 : t_a * (ℓ_b - t_b) ∈ 𝔪_z ^ 3 := by
      rw [show (3 : ℕ) = 2 + 1 from rfl, pow_succ']
      exact Ideal.mul_mem_mul ht_a_mz (hL_approx (b_idx s))
    exact Ideal.add_mem _ h1 h2

theorem weil_algClosed_cubic_twoPoint_oneJet_surj (k : Type u) [Field k] [IsAlgClosed k] (N : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι₀ : Z_bar ⟶ weilProjectiveSpaceOver k N)
    (hCl₀ : AlgebraicGeometry.IsClosedImmersion ι₀.left)
    (z₁ z₂ : Z_bar.left)
    (hz₁_cl : IsClosed ({z₁} : Set Z_bar.left))
    (hz₂_cl : IsClosed ({z₂} : Set Z_bar.left))
    (h12 : z₁ ≠ z₂)
    (μ₁ μ₂ : Fin (N + 1))
    (hXμ₁ : (MvPolynomial.X μ₁ : MvPolynomial (Fin (N + 1)) k) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
    (hXμ₂ : (MvPolynomial.X μ₂ : MvPolynomial (Fin (N + 1)) k) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
    (W₁ W₂ : Z_bar.left.Opens)
    (hAff₁ : AlgebraicGeometry.IsAffineOpen W₁) (hz₁ : z₁ ∈ W₁)
    (hAff₂ : AlgebraicGeometry.IsAffineOpen W₂) (hz₂ : z₂ ∈ W₂)
    (hW₁ : W₁ ≤ (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      (TopologicalSpace.Opens.map ι₀.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          (MvPolynomial.X μ₁))))
    (hW₂ : W₂ ≤ (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      (TopologicalSpace.Opens.map ι₀.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          (MvPolynomial.X μ₂))))
    (s₁ : Localization.AtPrime (hAff₁.primeIdealOf ⟨z₁, hz₁⟩).asIdeal)
    (s₂ : Localization.AtPrime (hAff₂.primeIdealOf ⟨z₂, hz₂⟩).asIdeal) :
    let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
    ∃ (F : MvPolynomial (Fin (N + 1)) k) (hF : F ∈ 𝒜_N 3),
      let p₁ := (hAff₁.primeIdealOf ⟨z₁, hz₁⟩).asIdeal
      let p₂ := (hAff₂.primeIdealOf ⟨z₂, hz₂⟩).asIdeal
      let f₁ := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ₁) hXμ₁ zero_lt_one).hom ≫
        ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ₁)) W₁ hW₁).hom
        (HomogeneousLocalization.mk ⟨3, ⟨F, hF⟩,
          ⟨MvPolynomial.X μ₁ ^ 3, (MvPolynomial.mem_homogeneousSubmodule 3 _).mpr
            (MvPolynomial.isHomogeneous_X_pow μ₁ 3)⟩, ⟨3, rfl⟩⟩)
      let f₂ := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ₂) hXμ₂ zero_lt_one).hom ≫
        ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ₂)) W₂ hW₂).hom
        (HomogeneousLocalization.mk ⟨3, ⟨F, hF⟩,
          ⟨MvPolynomial.X μ₂ ^ 3, (MvPolynomial.mem_homogeneousSubmodule 3 _).mpr
            (MvPolynomial.isHomogeneous_X_pow μ₂ 3)⟩, ⟨3, rfl⟩⟩)
      algebraMap _ (Localization.AtPrime p₁) f₁ - s₁ ∈
        (IsLocalRing.maximalIdeal (Localization.AtPrime p₁)) ^ 2 ∧
      algebraMap _ (Localization.AtPrime p₂) f₂ - s₂ ∈
        (IsLocalRing.maximalIdeal (Localization.AtPrime p₂)) ^ 2 :=
by
  let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
  have : AlgebraicGeometry.IsClosedImmersion ι₀.left := hCl₀

  
  have hLocalSq : ∀ {A B : Type u} [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
      (φ : A →+* B) [IsLocalHom φ] {w : A},
      w ∈ (IsLocalRing.maximalIdeal A) ^ 2 → φ w ∈ (IsLocalRing.maximalIdeal B) ^ 2 := by
    intro A B _ _ _ _ φ _ w hw
    have hle : Ideal.map φ (IsLocalRing.maximalIdeal A) ≤ IsLocalRing.maximalIdeal B := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal]
      rw [IsLocalRing.mem_maximalIdeal] at hx
      exact map_nonunit φ x hx
    have hw_map : φ w ∈ Ideal.map φ ((IsLocalRing.maximalIdeal A) ^ 2) :=
      Ideal.mem_map_of_mem φ hw
    rw [Ideal.map_pow] at hw_map
    exact pow_le_pow_left' hle 2 hw_map

  have hEquivLocal : ∀ {A B : Type u} [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
      (e : A ≃+* B), IsLocalHom e.toRingHom := by
    intro A B _ _ _ _ e
    refine ⟨fun a ha => ?_⟩
    simpa using ha.map e.symm.toRingHom

  have hWeight_eq : ∀ m : Fin (N + 1) →₀ ℕ,
      (Finsupp.weight 1) m = ∑ i ∈ m.support, m i := by
    intro m
    rw [Finsupp.weight_apply]
    simp [Finsupp.sum]

  
  have hChartPull : ∀ (z : Z_bar.left) (hz_cl : IsClosed ({z} : Set Z_bar.left))
      (μ : Fin (N + 1)) (hXμ : (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1)
      (W : Z_bar.left.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W) (hz : z ∈ W)
      (hW : W ≤ (TopologicalSpace.Opens.map ι₀.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ)))
      (s : Localization.AtPrime (hAffW.primeIdealOf ⟨z, hz⟩).asIdeal),
      let R_μ := HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ)
      let p_W := (hAffW.primeIdealOf ⟨z, hz⟩).asIdeal
      ∃ (r : PrimeSpectrum R_μ) (_ : r.asIdeal.IsMaximal)
        (t_tilde : Localization.AtPrime r.asIdeal)
        (Θ : Localization.AtPrime r.asIdeal →+* Localization.AtPrime p_W),
        (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).base r =
          ι₀.left.base z ∧
        Θ t_tilde = s ∧
        (∀ g : R_μ,
          Θ (algebraMap R_μ (Localization.AtPrime r.asIdeal) g) =
            algebraMap _ (Localization.AtPrime p_W)
              (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).hom ≫
                ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ)) W hW).hom g)) ∧
        (∀ w ∈ (IsLocalRing.maximalIdeal (Localization.AtPrime r.asIdeal)) ^ 2,
          Θ w ∈ (IsLocalRing.maximalIdeal (Localization.AtPrime p_W)) ^ 2) := by
    intro z hz_cl μ hXμ W hAffW hz hW s R_μ p_W
    let Y : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜_N
    let f_Z : Z_bar.left ⟶ Y := ι₀.left
    have hf_Z : AlgebraicGeometry.IsClosedImmersion f_Z := hCl₀
    let D : Y.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ)
    have hAffD : AlgebraicGeometry.IsAffineOpen D :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one
    let y_D : ↥D := ⟨f_Z.base z, hW hz⟩
    let P_D := hAffD.primeIdealOf y_D
    have hy_cl : IsClosed ({(y_D : Y)} : Set Y) := by
      have h1 := f_Z.isClosedEmbedding.isClosedMap {z} hz_cl
      rwa [Set.image_singleton] at h1
    have hMaxPD : P_D.asIdeal.IsMaximal :=
      hAffD.primeIdealOf_isMaximal_of_isClosed y_D hy_cl
    letI : Algebra ↑(Y.presheaf.obj (Opposite.op D)) ↑(Y.presheaf.stalk ↑y_D) :=
      TopCat.Presheaf.algebra_section_stalk Y.presheaf y_D
    have : IsLocalization.AtPrime ↑(Y.presheaf.stalk ↑y_D) P_D.asIdeal :=
      hAffD.isLocalization_stalk y_D
    let e_D_alg := Localization.algEquiv P_D.asIdeal.primeCompl ↑(Y.presheaf.stalk ↑y_D)
    let e_D : Localization.AtPrime P_D.asIdeal ≃+* ↑(Y.presheaf.stalk (f_Z.base z)) :=
      e_D_alg.toRingEquiv
    let z_W : ↥W := ⟨z, hz⟩
    letI : Algebra ↑(Z_bar.left.presheaf.obj (Opposite.op W)) ↑(Z_bar.left.presheaf.stalk ↑z_W) :=
      TopCat.Presheaf.algebra_section_stalk Z_bar.left.presheaf z_W
    have : IsLocalization.AtPrime ↑(Z_bar.left.presheaf.stalk ↑z_W) p_W :=
      hAffW.isLocalization_stalk z_W
    let e_W_alg := Localization.algEquiv p_W.primeCompl ↑(Z_bar.left.presheaf.stalk ↑z_W)
    let e_W : ↑(Z_bar.left.presheaf.stalk z) ≃+* Localization.AtPrime p_W :=
      e_W_alg.symm.toRingEquiv
    obtain ⟨hStalkSurj_all⟩ := @AlgebraicGeometry.IsClosedImmersion.toSurjectiveOnStalks _ _ f_Z hf_Z
    have hStalkSurj : Function.Surjective (f_Z.stalkMap z).hom := hStalkSurj_all z
    let iso := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one
    have hiso_surj : Function.Surjective iso.hom.hom :=
      fun y => ⟨iso.inv.hom y, ConcreteCategory.congr_hom iso.inv_hom_id y⟩
    let r : PrimeSpectrum R_μ := PrimeSpectrum.comap iso.hom.hom P_D
    have hr_comap : r.asIdeal = Ideal.comap iso.hom.hom P_D.asIdeal :=
      PrimeSpectrum.comap_asIdeal iso.hom.hom P_D
    have hMax_r : r.asIdeal.IsMaximal :=
      Ideal.comap_isMaximal_of_surjective iso.hom.hom hiso_surj
    let α_hat : Localization.AtPrime r.asIdeal →+* Localization.AtPrime P_D.asIdeal :=
      Localization.localRingHom r.asIdeal P_D.asIdeal iso.hom.hom hr_comap
    have hα_surj : Function.Surjective α_hat := by
      intro w
      obtain ⟨⟨b, ⟨t, ht⟩⟩, rfl⟩ := IsLocalization.mk'_surjective P_D.asIdeal.primeCompl w
      obtain ⟨a, rfl⟩ := hiso_surj b
      obtain ⟨u, rfl⟩ := hiso_surj t
      have hu : u ∈ r.asIdeal.primeCompl := ht
      exact ⟨IsLocalization.mk' (Localization.AtPrime r.asIdeal) a ⟨u, hu⟩,
        Localization.localRingHom_mk' r.asIdeal P_D.asIdeal iso.hom.hom hr_comap a ⟨u, hu⟩⟩
    let Θ : Localization.AtPrime r.asIdeal →+* Localization.AtPrime p_W :=
      e_W.toRingHom.comp ((f_Z.stalkMap z).hom.comp (e_D.toRingHom.comp α_hat))
    have hΘ_surj : Function.Surjective Θ :=
      e_W.surjective.comp (hStalkSurj.comp (e_D.surjective.comp hα_surj))
    obtain ⟨t_tilde, ht_tilde⟩ := hΘ_surj s
    have hpt : (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).base r =
        f_Z.base z := by
      have hSpec : D.toSpecΓ ≫ AlgebraicGeometry.Spec.map iso.hom ≫
          AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one =
          D.toSpecΓ ≫ hAffD.fromSpec := by
        have h1 : D.toSpecΓ ≫ AlgebraicGeometry.Spec.map iso.hom =
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).hom := by
          rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
          exact (AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).symm
        rw [← CategoryTheory.Category.assoc, h1,
          ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one,
          ← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
          CategoryTheory.Category.id_comp, ← hAffD.isoSpec_inv_ι,
          ← CategoryTheory.Category.assoc, hAffD.toSpecΓ_isoSpec_inv,
          CategoryTheory.Category.id_comp]
      have : CategoryTheory.IsIso D.toSpecΓ := by
        rw [← hAffD.isoSpec_hom]
        infer_instance
      have hSpec' := (CategoryTheory.cancel_epi D.toSpecΓ).mp hSpec
      have hcongr : (AlgebraicGeometry.Spec.map iso.hom ≫
          AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).base P_D =
          hAffD.fromSpec.base P_D :=
        congrArg (fun φ : AlgebraicGeometry.Spec _ ⟶ Y => φ.base P_D) hSpec'
      change (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).base
          ((AlgebraicGeometry.Spec.map iso.hom).base P_D) = hAffD.fromSpec.base P_D at hcongr
      have hmap_pt : (AlgebraicGeometry.Spec.map iso.hom).base P_D = r := by
        rw [AlgebraicGeometry.Spec.map_base]
        rfl
      rw [hmap_pt] at hcongr
      exact hcongr.trans (hAffD.fromSpec_primeIdealOf y_D)
    have : IsLocalHom α_hat :=
      Localization.isLocalHom_localRingHom r.asIdeal P_D.asIdeal iso.hom.hom hr_comap
    have : IsLocalHom e_D.toRingHom := hEquivLocal e_D
    have : IsLocalHom e_W.toRingHom := hEquivLocal e_W
    have : IsLocalHom (e_D.toRingHom.comp α_hat) := RingHom.isLocalHom_comp _ _
    have : IsLocalHom ((f_Z.stalkMap z).hom.comp (e_D.toRingHom.comp α_hat)) :=
      RingHom.isLocalHom_comp _ _
    have : IsLocalHom Θ := RingHom.isLocalHom_comp _ _
    refine ⟨r, hMax_r, t_tilde, Θ, hpt, ht_tilde, ?_, fun w hw => hLocalSq Θ hw⟩
    intro g
    have h1 : α_hat (algebraMap R_μ (Localization.AtPrime r.asIdeal) g) =
        algebraMap _ (Localization.AtPrime P_D.asIdeal) (iso.hom.hom g) :=
      Localization.localRingHom_to_map r.asIdeal P_D.asIdeal iso.hom.hom hr_comap g
    have h2 : e_D (algebraMap _ (Localization.AtPrime P_D.asIdeal) (iso.hom.hom g)) =
        (Y.presheaf.germ D (f_Z.base z) (hW hz)).hom (iso.hom.hom g) := by
      change e_D_alg (algebraMap _ _ (iso.hom.hom g)) = _
      rw [e_D_alg.commutes, TopCat.Presheaf.stalk_open_algebraMap Y.presheaf y_D]
    have h3 : (f_Z.stalkMap z).hom ((Y.presheaf.germ D (f_Z.base z) (hW hz)).hom (iso.hom.hom g)) =
        (Z_bar.left.presheaf.germ (f_Z ⁻¹ᵁ D) z (hW hz)).hom ((f_Z.app D).hom (iso.hom.hom g)) :=
      AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply f_Z D z (hW hz) (iso.hom.hom g)
    have h4 : (Z_bar.left.presheaf.germ (f_Z ⁻¹ᵁ D) z (hW hz)).hom ((f_Z.app D).hom (iso.hom.hom g)) =
        (Z_bar.left.presheaf.germ W z hz).hom
          ((Z_bar.left.presheaf.map (CategoryTheory.homOfLE (hW : W ≤ f_Z ⁻¹ᵁ D)).op).hom
            ((f_Z.app D).hom (iso.hom.hom g))) :=
      (TopCat.Presheaf.germ_res_apply Z_bar.left.presheaf
        (CategoryTheory.homOfLE (hW : W ≤ f_Z ⁻¹ᵁ D)) z hz _).symm
    have h5 : e_W ((Z_bar.left.presheaf.germ W z hz).hom
          ((Z_bar.left.presheaf.map (CategoryTheory.homOfLE (hW : W ≤ f_Z ⁻¹ᵁ D)).op).hom
            ((f_Z.app D).hom (iso.hom.hom g)))) =
        algebraMap _ (Localization.AtPrime p_W)
          ((iso.hom ≫ f_Z.appLE D W (hW : W ≤ f_Z ⁻¹ᵁ D)).hom g) := by
      change e_W_alg.symm ((Z_bar.left.presheaf.germ W z hz).hom
        ((iso.hom ≫ f_Z.appLE D W (hW : W ≤ f_Z ⁻¹ᵁ D)).hom g)) = _
      rw [← TopCat.Presheaf.stalk_open_algebraMap Z_bar.left.presheaf z_W]
      exact e_W_alg.symm.commutes _
    change e_W ((f_Z.stalkMap z).hom (e_D (α_hat (algebraMap R_μ (Localization.AtPrime r.asIdeal) g)))) = _
    exact (congrArg (fun x => e_W ((f_Z.stalkMap z).hom (e_D x))) h1).trans
      ((congrArg (fun x => e_W ((f_Z.stalkMap z).hom x)) h2).trans
        ((congrArg e_W (h3.trans h4)).trans h5))

  
  have hs2 : ∀ (μ : Fin (N + 1))
      (hXμ : (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1)
      (r : PrimeSpectrum (HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ))),
      r.asIdeal.IsMaximal →
      let R_μ := HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ)
      (∃ a : Fin (N + 1) → k,
        a μ = 1 ∧
        (∀ (d : ℕ), 1 ≤ d → ∀ (G : MvPolynomial (Fin (N + 1)) k), G ∈ 𝒜_N d →
          (G ∈ ((AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).base r).asHomogeneousIdeal ↔
            MvPolynomial.eval a G = 0)) ∧
        (∀ (L : MvPolynomial (Fin (N + 1)) k) (hL : L ∈ 𝒜_N 1),
          (HomogeneousLocalization.mk ⟨1, ⟨L, hL⟩, ⟨MvPolynomial.X μ, hXμ⟩, ⟨1, pow_one _⟩⟩ : R_μ) ∈
            r.asIdeal ↔ MvPolynomial.eval a L = 0)) ∧
      (∀ t : Localization.AtPrime r.asIdeal,
        ∃ (M : MvPolynomial (Fin (N + 1)) k) (hM : M ∈ 𝒜_N 1),
          algebraMap R_μ (Localization.AtPrime r.asIdeal)
            (HomogeneousLocalization.mk ⟨1, ⟨M, hM⟩, ⟨MvPolynomial.X μ, hXμ⟩, ⟨1, pow_one _⟩⟩) - t ∈
            (IsLocalRing.maximalIdeal (Localization.AtPrime r.asIdeal)) ^ 2) := by
    intro μ hXμ r hMax_r R_μ
    let τ_μ := {ν : Fin (N + 1) // ν ≠ μ}
    let P_μ := MvPolynomial τ_μ k
    let S_μ := Submonoid.powers (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k)
    let ι_k : k →+* R_μ :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜_N S_μ).comp (algebraMap k ↥(𝒜_N 0))
    let u_μ : τ_μ → R_μ := fun ν =>
      HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X ν.1, MvPolynomial.isHomogeneous_X k ν.1⟩,
          ⟨MvPolynomial.X μ, hXμ⟩, ⟨1, pow_one _⟩⟩
    let Φ_μ : P_μ →+* R_μ := MvPolynomial.eval₂Hom ι_k u_μ
    let w_μ : Fin (N + 1) → P_μ := fun j => if h : j = μ then 1 else MvPolynomial.X ⟨j, h⟩
    let dehom_μ : MvPolynomial (Fin (N + 1)) k →+* P_μ :=
      MvPolynomial.eval₂Hom MvPolynomial.C w_μ
    have hdehom_S : ∀ y : S_μ, dehom_μ y.1 = 1 := by
      rintro ⟨_, n, rfl⟩
      rw [map_pow]
      have hw : dehom_μ (MvPolynomial.X μ) = 1 := by
        rw [MvPolynomial.eval₂Hom_X' MvPolynomial.C w_μ μ]
        simp [w_μ]
      rw [hw, one_pow]
    have hy_unit : ∀ y : S_μ, IsUnit (dehom_μ y.1) := by
      intro y
      rw [hdehom_S y]
      exact isUnit_one
    let β_loc : Localization S_μ →+* P_μ := IsLocalization.lift hy_unit
    have hβ_mk : ∀ (p : MvPolynomial (Fin (N + 1)) k) (y : S_μ),
        β_loc (Localization.mk p y) = dehom_μ p := by
      intro p y
      dsimp only [β_loc]
      rw [Localization.mk_eq_mk', IsLocalization.lift_mk'_spec, hdehom_S y, one_mul]
    let valHom : R_μ →+* Localization S_μ :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := fun x y => HomogeneousLocalization.val_mul x y
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := fun x y => HomogeneousLocalization.val_add x y }
    let Ψ_μ : R_μ →+* P_μ := β_loc.comp valHom
    have hΨ_mk : ∀ v : HomogeneousLocalization.NumDenSameDeg 𝒜_N S_μ,
        Ψ_μ (HomogeneousLocalization.mk v) = dehom_μ v.num.1 := by
      intro v
      change β_loc (HomogeneousLocalization.mk v).val = dehom_μ v.num.1
      rw [HomogeneousLocalization.val_mk]
      exact hβ_mk v.num.1 ⟨v.den.1, v.den_mem⟩
    have hΨΦ : Ψ_μ.comp Φ_μ = RingHom.id P_μ := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp only [RingHom.comp_apply, Φ_μ, MvPolynomial.eval₂Hom_C ι_k u_μ c]
        change β_loc (HomogeneousLocalization.fromZeroRingHom 𝒜_N S_μ (algebraMap k ↥(𝒜_N 0) c)).val =
          MvPolynomial.C c
        have hval : (HomogeneousLocalization.fromZeroRingHom 𝒜_N S_μ (algebraMap k ↥(𝒜_N 0) c)).val =
            Localization.mk (MvPolynomial.C c) 1 := by
          change Localization.mk (algebraMap k ↥(𝒜_N 0) c).1 1 = Localization.mk (MvPolynomial.C c) 1
          rw [← MvPolynomial.algebraMap_eq]
          rfl
        rw [hval, hβ_mk, MvPolynomial.eval₂Hom_C]
      · intro ν
        simp only [RingHom.comp_apply, Φ_μ, MvPolynomial.eval₂Hom_X' ι_k u_μ ν]
        rw [hΨ_mk]
        dsimp only [dehom_μ]
        rw [MvPolynomial.eval₂Hom_X' MvPolynomial.C w_μ ν.1]
        exact dif_neg ν.2
    have hΨΦ_apply : ∀ P : P_μ, Ψ_μ (Φ_μ P) = P :=
      fun P => RingHom.congr_fun hΨΦ P
    
    let Θ : MvPolynomial (Fin (N + 1)) k →+* Localization S_μ :=
      valHom.comp (Φ_μ.comp dehom_μ)
    let ξ_μ : S_μ := ⟨MvPolynomial.X μ, ⟨1, pow_one _⟩⟩
    have hΘ_C : ∀ c : k, Θ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
      intro c
      change valHom (Φ_μ (dehom_μ (MvPolynomial.C c))) = Localization.mk (MvPolynomial.C c) 1
      rw [MvPolynomial.eval₂Hom_C MvPolynomial.C w_μ c, MvPolynomial.eval₂Hom_C ι_k u_μ c]
