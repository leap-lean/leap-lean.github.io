    have h_comm_iso : ((π₀_sch ∣_ U_axis) ∣_ O_sch) ≫ e_OV.hom = e_WW.hom ≫ (π₀_sch ∣_ V_p p) := by
      apply (cancel_mono (V_p p).ι).mp
      calc (((π₀_sch ∣_ U_axis) ∣_ O_sch) ≫ e_OV.hom) ≫ (V_p p).ι
          = ((π₀_sch ∣_ U_axis) ∣_ O_sch) ≫ O_sch.ι ≫ U_axis.ι := by
              rw [Category.assoc]
              exact congrArg (((π₀_sch ∣_ U_axis) ∣_ O_sch) ≫ ·)
                (IsOpenImmersion.isoOfRangeEq_hom_fac (O_sch.ι ≫ U_axis.ι) (V_p p).ι hrange_O)
        _ = (W₁.ι ≫ pre_U.ι) ≫ π₀_sch := by
              rw [← Category.assoc, morphismRestrict_ι, Category.assoc, morphismRestrict_ι,
                ← Category.assoc]
