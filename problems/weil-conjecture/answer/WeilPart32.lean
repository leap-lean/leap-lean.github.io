  have hQuot_A₂_W₂ :
      letI : Algebra k ↑(Z_bar.left.presheaf.obj (Opposite.op U₂_c)) := φ_k₂.toAlgebra
      letI : Algebra k ↑(Γ₀.left.presheaf.obj (Opposite.op W₂)) := φ_W₂.toAlgebra
      Nonempty ((↑(Z_bar.left.presheaf.obj (Opposite.op U₂_c)) ⧸ Ideal.span {u₀, τ₂}) ≃ₗ[k]
