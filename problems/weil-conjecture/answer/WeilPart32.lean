          rw [hf_k c] }⟩
    · let qA : Type u := A₂_t ⧸ Ideal.span {u₀}
      let e₀ : qA ≃+* B₂_t :=
        (Ideal.quotEquivOfEq hf_ker.symm).trans (RingHom.quotientKerEquivOfSurjective hf_surj)
      let g : qA →+* B₂_t ⧸ Ideal.span {u₁₂ ^ 3} :=
        (Ideal.Quotient.mk (Ideal.span {u₁₂ ^ 3})).comp e₀.toRingHom
