        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Z_bar.hom.appLE ⊤ U_Z le_top).hom
      have hSm_κZ : RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 2) κ_Z := by
        let res_g₁ : ↑(Z_bar.left.presheaf.obj (Opposite.op U_sm)) →+* A :=
