    rintro y ⟨hFL_y, hH₂_y⟩
    have hz_FL : ι_Γ.left.base y ∈ ι₀.left.base ⁻¹' weilProjHyperplaneSet k N F_L := hFL_y
    rw [← hUnion] at hz_FL
    rcases hz_FL with ⟨c₁, hc₁⟩ | ⟨c₂, hc₂⟩
    · have hYC₁ : ι_ΓP.left.base y ∈ Y_C₁ := ⟨c₁, by change ι₀.left.base (ι₁.left.base c₁) = _; rw [hc₁]; rfl⟩
