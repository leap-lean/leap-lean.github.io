            p ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_2 F := by
          rw [AlgebraicGeometry.Proj.mem_basicOpen, not_not]
        change F ∈ (p : ProjectiveSpectrum 𝒜_2).asHomogeneousIdeal ↔ _
        rw [hmem_iff]
        have hp_basic : p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_2 F ↔
            iso_eβ.hom.base 𝔪_spec ∈ (TopologicalSpace.Opens.map away_β.base).obj
