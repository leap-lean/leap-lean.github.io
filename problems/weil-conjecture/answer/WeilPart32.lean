                (HomogeneousLocalization.mk ⟨1, ⟨_, hLc⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩)
              algebraMap A (Localization.AtPrime p_z)
                (ℓ_z - ψ_z (MvPolynomial.C c₀ +
                  ∑ i : Fin (2 * m + 2), MvPolynomial.C (w i) * MvPolynomial.X i)) ∈
                (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 2 ↔
                (∑ μ : Fin (M + 1), ev_z (J_V 0 μ) * c μ = c₀ ∧
                  ∀ i : Fin (2 * m + 2), ∑ μ : Fin (M + 1), ev_z (J_V i.succ μ) * c μ = w i))) ∧
          (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
            MvPolynomial.gradedAlgebra
