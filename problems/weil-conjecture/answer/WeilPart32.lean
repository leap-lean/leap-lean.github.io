      (∀ i j : Fin (2 * m + 2), D_V i (ψ_V (MvPolynomial.X j)) = if i = j then 1 else 0) ∧
      (∀ (m' : Fin M) (γ₀ : Fin (2 * m + 2)), v m' γ₀ = D_V γ₀ (x_coord m')) ∧
      (∀ (E : Type u) [Field E] (σ : A →+* E),
        letI : Algebra k E := (σ.comp (algebraMap k A)).toAlgebra
        ∀ (D : Derivation k E E) (a : A),
          D (σ a) = ∑ i : Fin (2 * m + 2), σ (D_V i a) * D (σ (ψ_V (MvPolynomial.X i)))) ∧
      (∀ (x : ↥V) (c : Fin (M + 1) → k),
        ι_bar.left.base x.1 ∈
          weilProjHyperplaneSet k M (∑ μ : Fin (M + 1), MvPolynomial.C (c μ) * MvPolynomial.X μ) ↔
        (∑ μ : Fin (M + 1), algebraMap k A (c μ) * X_full μ) ∈ (hAffV.primeIdealOf x).asIdeal) ∧
      ((∀ (𝔪 : Ideal A) (h𝔪 : 𝔪.IsMaximal),
