    have : IsIso (((π₀_sch ∣_ U_axis) ∣_ O_sch) ≫ e_OV.hom) := by
      rw [h_comm_iso]
      infer_instance
    exact IsIso.of_isIso_comp_right ((π₀_sch ∣_ U_axis) ∣_ O_sch) e_OV.hom

  
  have hu₀_hom : u₀_sec ≫ P₁.hom = 𝟙 (Spec (CommRingCat.of k)) := by
