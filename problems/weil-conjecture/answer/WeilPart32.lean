        (Ideal.Quotient.mk (Ideal.span {τ₁₂})).comp f
      have hg_surj : Function.Surjective g :=
        (Ideal.Quotient.mk_surjective).comp hf_surj
      have hg_ker : RingHom.ker g = Ideal.span {u₀, τ₂} := by
        apply le_antisymm
        · intro x hx
          have hmem : f x ∈ Ideal.span {τ₁₂} := Ideal.Quotient.eq_zero_iff_mem.mp hx
          obtain ⟨y, hy⟩ := Ideal.mem_span_singleton.mp hmem
          obtain ⟨r, rfl⟩ := hf_surj y
