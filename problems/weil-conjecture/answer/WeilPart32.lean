      rw [Finset.sum_congr rfl h_mono, h_sum_mk, ← hp_sum]
    have h_αβ : α_b.comp β_b = RingHom.id R_away := by
      refine RingHom.ext fun z => ?_
      apply HomogeneousLocalization.val_injective S_b
      refine Quotient.inductionOn' z fun nd => ?_
      obtain ⟨m, hm⟩ := nd.den_mem
