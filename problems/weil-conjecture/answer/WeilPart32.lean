            Pi.single_eq_of_ne (fun h => hne (Fin.succAbove_right_injective h)) 1
          rw [hc0, map_zero, map_zero, zero_mul]
        · intro habs; exact absurd (Finset.mem_univ _) habs
      have haddCases_q : ∀ a : Fin s,
          Fin.addCases (motive := fun _ => MvPolynomial (Fin (s + 0 + d)) k) q Fin.elim0 a = q a := by
        intro a
        change Fin.addCases (motive := fun _ => MvPolynomial (Fin (s + 0 + d)) k) q Fin.elim0
          (Fin.castAdd 0 a) = q a
        exact Fin.addCases_left a
      have hSch := hSchur c γ₀
      rw [hc_sum_Ψ, hc_sum_v] at hSch
      have hRHS_M₀ : (Matrix.of fun a b : Fin (s + 0) =>
          φ (MvPolynomial.pderiv (Fin.castAdd d b) (Fin.addCases q Fin.elim0 a))) = M₀ := by
        ext a b
        simp [M₀, haddCases_q]
      rw [hRHS_M₀] at hSch
      let N_lhs : Matrix (Fin (s + 1)) (Fin (s + 1)) A :=
        Matrix.of fun a b : Fin (s + 0 + 1) =>
          φ (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin (s + 0 + d))
              (Fin.castAdd d) (Fin.natAdd (s + 0) γ₀) b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin (s + 0 + d)) k)
              (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s + 0 + d)) k) q Fin.elim0)
