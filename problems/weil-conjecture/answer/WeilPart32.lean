        have hW_prod : W ≤ (TopologicalSpace.Opens.map f_X.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜 x_prod) := by
          rw [hD_mul]
          exact le_inf hWα hWα'
        let m₁ := HomogeneousLocalization.awayMap 𝒜 (hX_deg α')
          (rfl : x_prod = MvPolynomial.X α * MvPolynomial.X α')
        let m₂ := HomogeneousLocalization.awayMap 𝒜 (hX_deg α)
          (mul_comm (MvPolynomial.X α) (MvPolynomial.X α'))
        let u_α : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α) :=
          HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X α', hX_deg α'⟩, ⟨MvPolynomial.X α, hX_deg α⟩, ⟨1, pow_one _⟩⟩
        have hz_eq : m₁ (z_F α j) = m₁ u_α * m₂ (z_F α' j) := by
          have hz1 : z_F α j = HomogeneousLocalization.Away.mk 𝒜 (hX_deg α) 1 (F j)
              (by rw [one_smul]; exact hF j) := by
            apply HomogeneousLocalization.val_injective
            simp [z_F, HomogeneousLocalization.Away.mk, HomogeneousLocalization.val_mk]
          have hz2 : z_F α' j = HomogeneousLocalization.Away.mk 𝒜 (hX_deg α') 1 (F j)
              (by rw [one_smul]; exact hF j) := by
            apply HomogeneousLocalization.val_injective
            simp [z_F, HomogeneousLocalization.Away.mk, HomogeneousLocalization.val_mk]
          have hu : u_α = HomogeneousLocalization.Away.mk 𝒜 (hX_deg α) 1 (MvPolynomial.X α')
              (by rw [one_smul]; exact hX_deg α') := by
            apply HomogeneousLocalization.val_injective
            simp [u_α, HomogeneousLocalization.Away.mk, HomogeneousLocalization.val_mk]
          rw [hz1, hz2, hu, HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
            HomogeneousLocalization.awayMap_mk]
          apply HomogeneousLocalization.val_injective
          rw [HomogeneousLocalization.val_mul]
          simp only [HomogeneousLocalization.Away.mk, HomogeneousLocalization.val_mk, pow_one,
            Localization.mk_mul]
          rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
