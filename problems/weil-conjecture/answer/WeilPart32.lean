    rcases hSlice_ne with ⟨_, ⟨⟨y, hy_K⟩, rfl⟩, hy_H₁⟩
    have hy₂ : y ∈ W₂ := by
      change ι_ΓP.left.base y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂
      by_contra hnot
      exact hEmpty_YZ_H₀₁₂.false
        ⟨ι_ΓP.left.base y, ⟨⟨⟨ι_Γ.left.base y, rfl⟩, hΓ_in_H₀ y⟩, hy_H₁⟩, hnot⟩
    have hyF : y ∈ W_F := by
