  have hIso_π₀ : IsIso (π₀_sch ∣_ U_axis) := by
    have : IsClosedImmersion ι_bar.left := hCl_ι
    have hF_axis : ∀ a : Fin 2, ![L 0, L 1] a ∈ 𝒜_M 1 := by
      intro a
      fin_cases a <;> exact hL_homog _
    let D_M : Fin (M + 1) → (weilProjectiveSpaceOver k M).left.Opens :=
      fun α => AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)
    have hAff_DM : ∀ α : Fin (M + 1), IsAffineOpen (D_M α) := fun α =>
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_M (MvPolynomial.X α)
        (MvPolynomial.isHomogeneous_X k α) zero_lt_one
    let V_M : Fin (M + 1) → Z_bar.left.Opens :=
      fun α => (TopologicalSpace.Opens.map ι_bar.left.base).obj (D_M α)
    have hAff_VM : ∀ α : Fin (M + 1), IsAffineOpen (V_M α) :=
      fun α => (hAff_DM α).preimage ι_bar.left
    let ℓ_VM : ∀ (α : Fin (M + 1)), Fin 2 → ↑(Z_bar.left.presheaf.obj (Opposite.op (V_M α))) :=
      fun α a =>
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α)
            (MvPolynomial.isHomogeneous_X k α) zero_lt_one).hom ≫
          ι_bar.left.app (D_M α)).hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨![L 0, L 1] a, hF_axis a⟩,
              ⟨MvPolynomial.X α, MvPolynomial.isHomogeneous_X k α⟩, ⟨1, pow_one _⟩⟩)
    let V_p : Fin (M + 1) × Fin 2 → Z_bar.left.Opens :=
      fun p => Z_bar.left.basicOpen (ℓ_VM p.1 p.2)
    have hAff_Vp : ∀ p : Fin (M + 1) × Fin 2, IsAffineOpen (V_p p) :=
      fun p => (hAff_VM p.1).basicOpen (ℓ_VM p.1 p.2)
    have hVp_eq : ∀ p : Fin (M + 1) × Fin 2,
        V_p p = V_M p.1 ⊓ (TopologicalSpace.Opens.map ι_bar.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M (![L 0, L 1] p.2)) :=
      fun p => hBasic_Proj M Z_bar ι_bar p.1 (MvPolynomial.isHomogeneous_X k p.1)
        (![L 0, L 1] p.2) (hF_axis p.2)
    have hSup_Vp : (⨆ p : Fin (M + 1) × Fin 2, V_p p) = U_axis := by
      ext z
      simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion]
      have hcovM : (⨆ α : Fin (M + 1), D_M α) = ⊤ := hCov_Proj M
      have hz_cov : ι_bar.left.base z ∈ ((⊤ : (weilProjectiveSpaceOver k M).left.Opens) : Set _) :=
        trivial
      rw [← hcovM, TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion] at hz_cov
      obtain ⟨α₀, hα₀⟩ := hz_cov
      change (∃ p : Fin (M + 1) × Fin 2, z ∈ V_p p) ↔ z ∈ (U_axis : Set Z_bar.left)
      rw [hU_axis_eq]
      simp only [weilProjHyperplaneSet, Set.mem_compl_iff, Set.mem_ofPred_eq, not_and_or]
      constructor
      · rintro ⟨⟨α, r⟩, hzp⟩
        rw [hVp_eq] at hzp
        fin_cases r
        · exact Or.inl fun hc => hc hzp.2
        · exact Or.inr fun hc => hc hzp.2
      · intro hor
        rcases hor with h0 | h1
        · refine ⟨(α₀, 0), ?_⟩
          rw [hVp_eq]
          exact ⟨hα₀, Classical.not_not.mp h0⟩
        · refine ⟨(α₀, 1), ?_⟩
          rw [hVp_eq]
          exact ⟨hα₀, Classical.not_not.mp h1⟩
    let D₁ : Fin 2 → P₁.left.Opens :=
      fun b => AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b)
    have hAff_D₁ : ∀ b : Fin 2, IsAffineOpen (D₁ b) := fun b =>
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_1 (MvPolynomial.X b)
        (MvPolynomial.isHomogeneous_X k b) zero_lt_one
    have hCov_D₁ : D₁ 0 ⊔ D₁ 1 = ⊤ := by
      have hcov1 : (⨆ b : Fin 2, D₁ b) = ⊤ := hCov_Proj 1
      rw [← hcov1]
      ext y
      simp [TopologicalSpace.Opens.coe_iSup, Fin.exists_fin_two]
    let t_sec : ∀ b : Fin 2, Fin 2 → ↑(P₁.left.presheaf.obj (Opposite.op (D₁ b))) :=
      fun b a =>
        (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b)
          (MvPolynomial.isHomogeneous_X k b) zero_lt_one).hom.hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X a, MvPolynomial.isHomogeneous_X k a⟩,
              ⟨MvPolynomial.X b, MvPolynomial.isHomogeneous_X k b⟩, ⟨1, pow_one _⟩⟩)
    have ht_diag : ∀ b : Fin 2, t_sec b b = 1 :=
      fun b => (hDehom_P1 b (MvPolynomial.isHomogeneous_X k b)).1
    have ht_basic : ∀ b : Fin 2, P₁.left.basicOpen (t_sec b (Fin.rev b)) = D₁ b ⊓ D₁ (Fin.rev b) := by
      intro b
      have hb := hBasic_Proj 1 P₁ (𝟙 P₁) b (MvPolynomial.isHomogeneous_X k b)
        (MvPolynomial.X (Fin.rev b)) (MvPolynomial.isHomogeneous_X k (Fin.rev b))
      have h_sec_eq : ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b)
          (MvPolynomial.isHomogeneous_X k b) zero_lt_one).hom ≫
          (𝟙 P₁ : P₁ ⟶ P₁).left.app (D₁ b)).hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X (Fin.rev b), MvPolynomial.isHomogeneous_X k (Fin.rev b)⟩,
