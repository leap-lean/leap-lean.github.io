    rw [Limits.pullback.lift_fst, hu₀_hom]
    exact IsPullback.of_horiz_isIso ⟨by rw [Category.id_comp, Category.comp_id]⟩

  have hPb_Zu₀_Z : IsPullback ι_Zu₀ (ι_Zu₀ ≫ π₀_sch) ι_Z_Q₁ j_u₀ := by
    refine (IsPullback.of_right ?_ ?_ hPb_ju₀.flip).flip
    · rw [h_w_Zu₀, Limits.pullback.lift_snd]
      exact (IsPullback.of_hasPullback f₀_sch u₀_sec).flip
    · apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id,
          Category.assoc, Limits.pullback.lift_fst]
      · rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc, h_w_Zu₀,
          Category.assoc, Limits.pullback.lift_snd, Limits.pullback.condition]

  have hCl_Zu₀_Z : IsClosedImmersion (ι_Zu₀ ≫ π₀_sch) :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Zu₀_Z hCl_ZQ₁

  have hKer_Zu₀_Z : ∀ (α : Fin (M + 1)) (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
      (hLu₀ : L 0 + MvPolynomial.C u_val * L 1 ∈ 𝒜_M 1)
      (U_Z : Z_bar.left.Opens) (_ : IsAffineOpen U_Z)
      (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α))),
      RingHom.ker ((ι_Zu₀ ≫ π₀_sch).app U_Z).hom =
        Ideal.span {((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
          ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) U_Z hUZ).hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨L 0 + MvPolynomial.C u_val * L 1, hLu₀⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)} := by
    intro α hXα hLu₀ U_Z hAff_UZ hUZ
    have hF_axis : ∀ a : Fin 2, ![L 0, L 1] a ∈ 𝒜_M 1 := by
      intro a
      fin_cases a <;> exact hL_homog _
    let hT0 : (MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1 :=
      MvPolynomial.isHomogeneous_X k 0
    let D₁_0 : P₁.left.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X 0)
    have hAff_D₁0 : IsAffineOpen D₁_0 :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_1 (MvPolynomial.X 0) hT0 zero_lt_one
    let W_pb : Q₁.Opens :=
      (TopologicalSpace.Opens.map p₁_Z.base).obj U_Z ⊓
        (TopologicalSpace.Opens.map p₁_P.base).obj D₁_0
    have hAff_Wpb : IsAffineOpen W_pb :=
      hProd_aff Z_bar.hom P₁.hom U_Z D₁_0 hAff_UZ hAff_D₁0
    obtain ⟨h_jaff, hX_jaff⟩ := hCoord_line.2.2.2.2.2
    have hU_j : U_Z ≤ (TopologicalSpace.Opens.map j_u₀.base).obj W_pb := by
      intro z hz
      refine ⟨?_, ?_⟩
      · have h1 : (j_u₀ ≫ p₁_Z).base z = z := by rw [Limits.pullback.lift_fst]; rfl
        change (j_u₀ ≫ p₁_Z).base z ∈ U_Z
        rwa [h1]
      · have h2 : (j_u₀ ≫ p₁_P).base z = (Z_bar.hom ≫ u₀_sec).base z := by
          rw [Limits.pullback.lift_snd]
        change (j_u₀ ≫ p₁_P).base z ∈ D₁_0
        rw [h2]
        exact h_jaff trivial
    rw [hCl_ker ι_Zu₀ (ι_Zu₀ ≫ π₀_sch) ι_Z_Q₁ j_u₀ hPb_Zu₀_Z hCl_ZQ₁ W_pb hAff_Wpb U_Z hAff_UZ hU_j,
      hKer_ZQ₁ α hXα hF_axis 0 hT0 U_Z hAff_UZ hUZ D₁_0 hAff_D₁0 le_rfl W_pb hAff_Wpb
        inf_le_left inf_le_right,
      Ideal.map_span, Set.image_singleton]
    congr 2
    rw [map_sum, Fin.sum_univ_two, map_mul, map_mul]
    have hZ_id : p₁_Z.appLE U_Z W_pb inf_le_left ≫ j_u₀.appLE W_pb U_Z hU_j = 𝟙 _ := by
      rw [Scheme.Hom.appLE_comp_appLE]
      have hjZ : j_u₀ ≫ p₁_Z = 𝟙 Z_bar.left := Limits.pullback.lift_fst _ _ _
      have hid_le : (𝟙 Z_bar.left : Z_bar.left ⟶ Z_bar.left).appLE U_Z U_Z le_rfl = 𝟙 _ := by
        erw [h_appLE_rfl (𝟙 Z_bar.left) U_Z, Scheme.Hom.id_app]
      calc (j_u₀ ≫ p₁_Z).appLE U_Z U_Z _
          = (𝟙 Z_bar.left : Z_bar.left ⟶ Z_bar.left).appLE U_Z U_Z le_rfl := by congr 1
        _ = 𝟙 _ := hid_le
    have hZ_apply : ∀ x, (j_u₀.appLE W_pb U_Z hU_j).hom
        ((p₁_Z.appLE U_Z W_pb inf_le_left).hom x) = x :=
      fun x => ConcreteCategory.congr_hom hZ_id x
    rw [hZ_apply, hZ_apply]
    have h_map_id0 : P₁.left.presheaf.map (homOfLE (le_rfl : D₁_0 ≤ D₁_0)).op = 𝟙 _ := by
      have hid : (homOfLE (le_rfl : D₁_0 ≤ D₁_0)) = 𝟙 _ := Subsingleton.elim _ _
      rw [hid, op_id, CategoryTheory.Functor.map_id]
    have ht0_one : (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X 0) hT0 zero_lt_one).hom ≫
        P₁.left.presheaf.map (homOfLE le_rfl).op).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X 0, MvPolynomial.isHomogeneous_X k 0⟩,
            ⟨MvPolynomial.X 0, hT0⟩, ⟨1, pow_one _⟩⟩)) = 1 := by
      erw [h_map_id0, Category.comp_id]
      exact (hDehom_P1 0 hT0).1
    dsimp only
    erw [ht0_one, map_one, map_one, mul_one]
    have hP_comp : p₁_P.appLE D₁_0 W_pb inf_le_right ≫ j_u₀.appLE W_pb U_Z hU_j =
        j_aff.appLE D₁_0 ⊤ h_jaff ≫
          (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom u_val))).appTop ≫
          Z_bar.hom.appLE ⊤ U_Z le_top := by
      rw [Scheme.Hom.appLE_comp_appLE]
      have hjP : j_u₀ ≫ p₁_P =
          (Z_bar.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom u_val))) ≫ j_aff := by
        rw [Limits.pullback.lift_snd]
        dsimp [u₀_sec]
        rw [Category.assoc]
      let ev_map := Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom u_val))
      have h1_le := Scheme.Hom.appLE_comp_appLE Z_bar.hom ev_map ⊤ ⊤ U_Z le_rfl le_top
      have h2_le := Scheme.Hom.appLE_comp_appLE (Z_bar.hom ≫ ev_map) j_aff D₁_0 ⊤ U_Z h_jaff le_top
      have hUZ_jaff : U_Z ≤ (TopologicalSpace.Opens.map
          ((Z_bar.hom ≫ ev_map) ≫ j_aff).base).obj D₁_0 :=
        fun _ _ => h_jaff trivial
      calc (j_u₀ ≫ p₁_P).appLE D₁_0 U_Z _
          = ((Z_bar.hom ≫ ev_map) ≫ j_aff).appLE D₁_0 U_Z hUZ_jaff := by congr 1
        _ = j_aff.appLE D₁_0 ⊤ h_jaff ≫ (Z_bar.hom ≫ ev_map).appLE ⊤ U_Z le_top := h2_le.symm
        _ = j_aff.appLE D₁_0 ⊤ h_jaff ≫ ev_map.appLE ⊤ ⊤ le_rfl ≫ Z_bar.hom.appLE ⊤ U_Z le_top := by
              rw [← h1_le]
        _ = j_aff.appLE D₁_0 ⊤ h_jaff ≫ ev_map.appTop ≫ Z_bar.hom.appLE ⊤ U_Z le_top :=
              congrArg (fun f => j_aff.appLE D₁_0 ⊤ h_jaff ≫ f ≫ Z_bar.hom.appLE ⊤ U_Z le_top)
                (h_appLE_rfl ev_map ⊤)
    let t1_sec := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X 0) hT0 zero_lt_one).hom ≫
        P₁.left.presheaf.map (homOfLE le_rfl).op).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X 1, MvPolynomial.isHomogeneous_X k 1⟩,
            ⟨MvPolynomial.X 0, hT0⟩, ⟨1, pow_one _⟩⟩)
    have ht1_jaff : (j_aff.appLE D₁_0 ⊤ h_jaff).hom t1_sec =
        (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv.hom Polynomial.X := by
      dsimp [t1_sec]
      erw [h_map_id0, Category.comp_id]
      apply (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).commRingCatIsoToRingEquiv.injective
      change (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom.hom
        ((j_aff.appLE D₁_0 ⊤ h_jaff).hom _) =
        (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv.hom Polynomial.X)
      have h_inv_hom := ConcreteCategory.congr_hom
        (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv_hom_id Polynomial.X
      change (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv.hom Polynomial.X) = Polynomial.X at h_inv_hom
      rw [h_inv_hom]
      exact hX_jaff
    have hP_t1 : (j_u₀.appLE W_pb U_Z hU_j).hom ((p₁_P.appLE D₁_0 W_pb inf_le_right).hom t1_sec) =
        (Z_bar.hom.appLE ⊤ U_Z le_top).hom ((Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom u_val) := by
      have hc := ConcreteCategory.congr_hom hP_comp t1_sec
      change (j_u₀.appLE W_pb U_Z hU_j).hom ((p₁_P.appLE D₁_0 W_pb inf_le_right).hom t1_sec) =
        (Z_bar.hom.appLE ⊤ U_Z le_top).hom
          (((Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom u_val))).appTop).hom
            ((j_aff.appLE D₁_0 ⊤ h_jaff).hom t1_sec)) at hc
      rw [hc, ht1_jaff]
      congr 1
      have hnat := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (Polynomial.evalRingHom u_val))
      have hnat' : (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
          (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom u_val))).appTop =
          CommRingCat.ofHom (Polynomial.evalRingHom u_val) ≫
            (Scheme.ΓSpecIso (CommRingCat.of k)).inv := by
        apply (cancel_epi (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom).mp
        apply (cancel_mono (Scheme.ΓSpecIso (CommRingCat.of k)).hom).mp
        rw [Iso.hom_inv_id_assoc, hnat, Category.assoc, Category.assoc,
          Iso.inv_hom_id, Category.comp_id]
      have hX_ev := ConcreteCategory.congr_hom hnat' Polynomial.X
      change ((Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom u_val))).appTop).hom
        ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv.hom Polynomial.X) =
        (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom
          (Polynomial.evalRingHom u_val Polynomial.X) at hX_ev
      rw [hX_ev, Polynomial.coe_evalRingHom, Polynomial.eval_X]
    change _ + _ * (j_u₀.appLE W_pb U_Z hU_j).hom ((p₁_P.appLE D₁_0 W_pb inf_le_right).hom t1_sec) = _
    rw [hP_t1, mul_comm _ ((Z_bar.hom.appLE ⊤ U_Z le_top).hom _)]
    exact (hLin_Proj α hXα hLu₀ U_Z hUZ).symm

  
  have hRange_Zu₀_Z : Set.range (ι_Zu₀ ≫ π₀_sch).base =
      { z : Z_bar.left |
        ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 0 + MvPolynomial.C u_val * L 1) } := by
    let f_u₀ := ι_Zu₀ ≫ π₀_sch
    have : IsClosedImmersion f_u₀ := hCl_Zu₀_Z
    have : IsClosedImmersion ι_bar.left := hCl_ι
    have hLu₀ : L 0 + MvPolynomial.C u_val * L 1 ∈ 𝒜_M 1 := by
      have hC : MvPolynomial.C u_val ∈ 𝒜_M 0 := MvPolynomial.isHomogeneous_C _ _
      have hMul : MvPolynomial.C u_val * L 1 ∈ 𝒜_M (0 + 1) :=
        SetLike.GradedMul.mul_mem hC (hL_homog 1)
      rw [Nat.zero_add] at hMul
      exact Submodule.add_mem _ (hL_homog 0) hMul
    have h_supp : (f_u₀.ker.support : Set Z_bar.left) = Set.range f_u₀.base := by
      rw [Scheme.Hom.support_ker, f_u₀.isClosedEmbedding.isClosed_range.closure_eq]
    ext z
    rw [← h_supp]
    let D_M : Fin (M + 1) → (weilProjectiveSpaceOver k M).left.Opens :=
      fun α => AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)
    have hcovM : (⨆ α : Fin (M + 1), D_M α) = ⊤ := hCov_Proj M
    have hz_cov : ι_bar.left.base z ∈
        ((⊤ : (weilProjectiveSpaceOver k M).left.Opens) : Set _) := trivial
    rw [← hcovM, TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion] at hz_cov
    obtain ⟨α, hα⟩ := hz_cov
    let hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1 :=
      MvPolynomial.isHomogeneous_X k α
    let D_α : (weilProjectiveSpaceOver k M).left.Opens := D_M α
    have hAff_Dα : IsAffineOpen D_α :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_M (MvPolynomial.X α) hXα zero_lt_one
    let V_α : Z_bar.left.Opens := (TopologicalSpace.Opens.map ι_bar.left.base).obj D_α
    have hAff_Vα : IsAffineOpen V_α := hAff_Dα.preimage ι_bar.left
    let U_aff : Z_bar.left.affineOpens := ⟨V_α, hAff_Vα⟩
    have hz_mem : z ∈ (U_aff : Z_bar.left.Opens) := hα
    change z ∈ f_u₀.ker.supportSet ↔ _
    rw [Scheme.IdealSheafData.mem_supportSet_iff_of_mem hz_mem, f_u₀.ker_apply U_aff,
      hKer_Zu₀_Z α hXα hLu₀ V_α hAff_Vα le_rfl,
      Z_bar.left.zeroLocus_span, Z_bar.left.mem_zeroLocus_iff]
    simp only [Set.mem_singleton_iff, forall_eq]
    have h_app_eq : ι_bar.left.appLE D_α V_α le_rfl = ι_bar.left.app D_α :=
      h_appLE_rfl ι_bar.left D_α
    rw [h_app_eq]
    have h_bo := hBasic_Proj M Z_bar ι_bar α hXα (L 0 + MvPolynomial.C u_val * L 1) hLu₀
    dsimp only at h_bo
    change z ∉ Z_bar.left.basicOpen _ ↔ _
    rw [h_bo]
    change ¬ (z ∈ V_α ∧ ι_bar.left.base z ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M
      (L 0 + MvPolynomial.C u_val * L 1)) ↔
      ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 0 + MvPolynomial.C u_val * L 1)
    simp only [weilProjHyperplaneSet]
    exact ⟨fun h hn => h ⟨hα, hn⟩, fun h ⟨_, hn⟩ => h hn⟩

  exact ⟨hCl_ZQ₁, hKer_ZQ₁, hIso_π₀, h_w_Zu₀, hCl_Zu₀_Z, hRange_Zu₀_Z, hKer_Zu₀_Z⟩

theorem weil_pencil_blowup_and_slice_transversal_smooth (k : Type u) [Field k] (M d_axis : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.SmoothOfRelativeDimension (d_axis + 2) Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hCl_ι : AlgebraicGeometry.IsClosedImmersion ι_bar.left) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
      MvPolynomial.gradedAlgebra
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
      MvPolynomial.gradedAlgebra
    let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
    let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    let P₁ := weilProjectiveSpaceOver k 1
    let Q₁ := CategoryTheory.Limits.pullback Z_bar.hom P₁.hom
    let p₁_Z := CategoryTheory.Limits.pullback.fst Z_bar.hom P₁.hom
    let p₁_P := CategoryTheory.Limits.pullback.snd Z_bar.hom P₁.hom
    (∀ (F_axis : Fin 2 → MvPolynomial (Fin (M + 1)) k)
       (hTrans_axis : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ d_axis 2 F_axis)
       (U_axis : Z_bar.left.Opens)
       (hU_axis_eq : (U_axis : Set Z_bar.left) =
         ({ z : Z_bar.left |
           ι_bar.left.base z ∈ weilProjHyperplaneSet k M (F_axis 0) ∧
           ι_bar.left.base z ∈ weilProjHyperplaneSet k M (F_axis 1) })ᶜ)
       (Z_tilde_sch : AlgebraicGeometry.Scheme.{u})
       (ι_Z_Q₁ : Z_tilde_sch ⟶ Q₁)
       (π₀_sch : Z_tilde_sch ⟶ Z_bar.left)
       (hom_Ztilde : Z_tilde_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of k)),
      AlgebraicGeometry.IsClosedImmersion ι_Z_Q₁ →
      ι_Z_Q₁ ≫ p₁_Z = π₀_sch →
      π₀_sch ≫ Z_bar.hom = hom_Ztilde →
      CategoryTheory.IsIso (π₀_sch ∣_ U_axis) →
      (∀ (α : Fin (M + 1)) (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
         (hF_ax : ∀ a : Fin 2, F_axis a ∈ 𝒜_M 1)
         (b : Fin 2) (hTb : (MvPolynomial.X b : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1)
         (U_Z : Z_bar.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_Z)
         (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
           (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)))
         (U_P : P₁.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_P)
         (hUP : U_P ≤ AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b))
         (W_pb : Q₁.Opens) (_ : AlgebraicGeometry.IsAffineOpen W_pb)
         (hWZ : W_pb ≤ (TopologicalSpace.Opens.map p₁_Z.base).obj U_Z)
         (hWP : W_pb ≤ (TopologicalSpace.Opens.map p₁_P.base).obj U_P),
        let ℓ_a : Fin 2 → ↑(Z_bar.left.presheaf.obj (Opposite.op U_Z)) := fun a =>
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) U_Z hUZ).hom
            (HomogeneousLocalization.mk ⟨1, ⟨F_axis a, hF_ax a⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
        let t_a : Fin 2 → ↑(P₁.left.presheaf.obj (Opposite.op U_P)) := fun a =>
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b) hTb zero_lt_one).hom ≫
            P₁.left.presheaf.map (CategoryTheory.homOfLE hUP).op).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨MvPolynomial.X a, MvPolynomial.isHomogeneous_X k a⟩, ⟨MvPolynomial.X b, hTb⟩, ⟨1, pow_one _⟩⟩)
        RingHom.ker (ι_Z_Q₁.app W_pb).hom =
          Ideal.span {∑ a : Fin 2,
            (p₁_Z.appLE U_Z W_pb hWZ).hom (ℓ_a a) *
            (p₁_P.appLE U_P W_pb hWP).hom (t_a a)}) →
      AlgebraicGeometry.SmoothOfRelativeDimension (d_axis + 2) hom_Ztilde) ∧
    (∀ (d_sl : ℕ) (L_sl : MvPolynomial (Fin (M + 1)) k)
       (hL_sl : L_sl ∈ 𝒜_M 1)
       (hTrans_sl : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ d_sl 1 ![L_sl])
       (S_sch : AlgebraicGeometry.Scheme.{u})
       (ι_S : S_sch ⟶ Z_bar.left)
       (hom_S : S_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of k)),
      AlgebraicGeometry.IsClosedImmersion ι_S →
      ι_S ≫ Z_bar.hom = hom_S →
      Set.range ι_S.base = { z : Z_bar.left | ι_bar.left.base z ∈ weilProjHyperplaneSet k M L_sl } →
      (∀ (α : Fin (M + 1)) (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
         (U_Z : Z_bar.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_Z)
         (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
           (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α))),
        RingHom.ker (ι_S.app U_Z).hom =
          Ideal.span {((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) U_Z hUZ).hom
            (HomogeneousLocalization.mk ⟨1, ⟨L_sl, hL_sl⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)}) →
      AlgebraicGeometry.SmoothOfRelativeDimension d_sl hom_S) :=
by
  
  have h_s5 : ∀ (d : ℕ) (Z_sch X : AlgebraicGeometry.Scheme.{u})
      (p_Z : Z_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      (π : X ⟶ Z_sch)
      (hom_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of k)),
      π ≫ p_Z = hom_X →
      (∀ x : X,
        (∃ W : X.Opens, x ∈ W ∧
          AlgebraicGeometry.SmoothOfRelativeDimension d (W.ι ≫ hom_X)) ∨
        (∃ (V : Z_sch.Opens) (_ : AlgebraicGeometry.IsAffineOpen V)
           (W : X.Opens) (_ : AlgebraicGeometry.IsAffineOpen W) (_ : x ∈ W)
           (hWV : W ≤ (TopologicalSpace.Opens.map π.base).obj V)
           (κ_V : k →+* ↑(Z_sch.presheaf.obj (Opposite.op V))),
          (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_V) = V.ι ≫ p_Z) ∧
          RingHom.IsStandardSmoothOfRelativeDimension d
            ((π.appLE V W hWV).hom.comp κ_V))) →
      AlgebraicGeometry.SmoothOfRelativeDimension d hom_X := by
    intro d Z_sch X p_Z π hom_X h_hom hLoc
    refine AlgebraicGeometry.SmoothOfRelativeDimension.mk fun x => ?_
    rcases hLoc x with ⟨W, hxW, hSmW⟩ | ⟨V, hAffV, W, hAffW, hxW, hWV, κ_V, hk, hStd⟩
    · obtain ⟨U, hAffU, V₀, hAffV₀, hxV₀, e₀, hStd₀⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff (n := d) (f := W.ι ≫ hom_X)).mp hSmW ⟨x, hxW⟩
      let V' : X.Opens := W.ι ''ᵁ V₀
      have hAffV' : AlgebraicGeometry.IsAffineOpen V' := hAffV₀.image_of_isOpenImmersion W.ι
      have hxV' : x ∈ V' := ⟨⟨x, hxW⟩, hxV₀, rfl⟩
      have e' : V' ≤ (TopologicalSpace.Opens.map hom_X.base).obj U := by
        rintro _ ⟨z, hz, rfl⟩
        exact e₀ hz
      have hpre : (TopologicalSpace.Opens.map W.ι.base).obj V' = V₀ := by
        ext z
        exact ⟨fun ⟨z', hz', h_eq⟩ => W.ι.isOpenEmbedding.injective h_eq ▸ hz', fun hz => ⟨z, hz, rfl⟩⟩
      have hIso_app : CategoryTheory.IsIso (W.ι.app V') := by
        change CategoryTheory.IsIso (W.ι.c.app (Opposite.op ((W.ι.opensFunctor).obj V₀)))
        infer_instance
      have h_appLE_eq : W.ι.appLE V' V₀ hpre.ge =
          W.ι.app V' ≫ W.toScheme.presheaf.map (CategoryTheory.eqToHom hpre.symm).op := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      have hIso_appLE : CategoryTheory.IsIso (W.ι.appLE V' V₀ hpre.ge) := by
        rw [h_appLE_eq]
        infer_instance
      have h_comp : (W.ι ≫ hom_X).appLE U V₀ e₀ =
          hom_X.appLE U V' e' ≫ W.ι.appLE V' V₀ hpre.ge :=
        (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE W.ι hom_X U V' V₀ e' hpre.ge).symm
      let e_iso := (CategoryTheory.asIso (W.ι.appLE V' V₀ hpre.ge)).commRingCatIsoToRingEquiv
      have h_hom_eq : (hom_X.appLE U V' e').hom =
          e_iso.symm.toRingHom.comp ((W.ι ≫ hom_X).appLE U V₀ e₀).hom := by
        ext r
        change (hom_X.appLE U V' e').hom r =
          e_iso.symm (((W.ι ≫ hom_X).appLE U V₀ e₀).hom r)
        rw [h_comp]
        exact (e_iso.symm_apply_apply ((hom_X.appLE U V' e').hom r)).symm
      refine ⟨U, hAffU, V', hAffV', hxV', e', ?_⟩
      rw [h_hom_eq]
      exact RingHom.isStandardSmoothOfRelativeDimension_respectsIso.1
        ((W.ι ≫ hom_X).appLE U V₀ e₀).hom e_iso.symm hStd₀
    · have hAffTop : AlgebraicGeometry.IsAffineOpen
          (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k)).Opens) :=
        AlgebraicGeometry.isAffineOpen_top _
      have hk_top := congrArg AlgebraicGeometry.Scheme.Hom.appTop hk
      have h_lhs : (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_V)).appTop =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫
            CommRingCat.ofHom κ_V ≫ V.topIso.inv := by
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_V)).appTop ≫ V.toSpecΓ.appTop = _
        rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop, ← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.ΓSpecIso_naturality]
        simp only [CategoryTheory.Category.assoc]
      have h_rhs : (V.ι ≫ p_Z).appTop = p_Z.appLE ⊤ V (fun _ _ => trivial) ≫ V.topIso.inv := by
        rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, AlgebraicGeometry.Scheme.Opens.ι_appTop]
        dsimp only [AlgebraicGeometry.Scheme.Hom.appTop, AlgebraicGeometry.Scheme.Opens.topIso]
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
        erw [AlgebraicGeometry.Scheme.Hom.appLE_map, AlgebraicGeometry.Scheme.Hom.appLE_map]
        rfl
      rw [h_lhs, h_rhs, ← CategoryTheory.Category.assoc, CategoryTheory.cancel_mono] at hk_top
      have hp_Z_eq : p_Z.appLE ⊤ V (fun _ _ => trivial) =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫ CommRingCat.ofHom κ_V :=
        hk_top.symm
      have hW_top : W ≤ (TopologicalSpace.Opens.map hom_X.base).obj ⊤ := fun _ _ => trivial
      have h_hom_W : hom_X.appLE ⊤ W hW_top =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫
            CommRingCat.ofHom ((π.appLE V W hWV).hom.comp κ_V) := by
        have h1 : hom_X.appLE ⊤ W hW_top =
            p_Z.appLE ⊤ V (fun _ _ => trivial) ≫ π.appLE V W hWV := by
          subst h_hom
          exact (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE π p_Z ⊤ V W
            (fun _ _ => trivial) hWV).symm
        rw [h1, hp_Z_eq, CategoryTheory.Category.assoc]
        rfl
      let e_k := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv
      refine ⟨⊤, hAffTop, W, hAffW, hxW, hW_top, ?_⟩
      have h_fn : (hom_X.appLE ⊤ W hW_top).hom =
          ((π.appLE V W hWV).hom.comp κ_V).comp e_k.toRingHom := by
        rw [h_hom_W]
        rfl
      rw [h_fn]
      exact RingHom.isStandardSmoothOfRelativeDimension_respectsIso.2
        ((π.appLE V W hWV).hom.comp κ_V) e_k hStd

  
  have h_s4 : ∀ (s ν d_sl : ℕ) (A B : Type u) [CommRing A] [CommRing B]
      (π : A →+* B), Function.Surjective π →
      ∀ (φ : MvPolynomial (Fin (s + ν + d_sl)) k →+* A), Function.Surjective φ →
      ∀ (q : Fin s → MvPolynomial (Fin (s + ν + d_sl)) k),
      RingHom.ker φ = Ideal.span (Set.range q) →
      ∀ (f_lift : Fin ν → MvPolynomial (Fin (s + ν + d_sl)) k),
      RingHom.ker π = Ideal.span (Set.range (fun j : Fin ν => φ (f_lift j))) →
      ∀ (idx : Fin (s + ν) → Fin (s + ν + d_sl)), Function.Injective idx →
      IsUnit (Matrix.det (Matrix.of fun i j : Fin (s + ν) =>
        φ (MvPolynomial.pderiv (idx j) (Fin.addCases q f_lift i)))) →
      RingHom.IsStandardSmoothOfRelativeDimension d_sl ((π.comp φ).comp MvPolynomial.C) := by
    intro s ν d_sl A B _ _ π hπ_surj φ hφ_surj q hker_φ f_lift hker_π idx hidx hDet
    let _ : Algebra k B := ((π.comp φ).comp MvPolynomial.C).toAlgebra
    change Algebra.IsStandardSmoothOfRelativeDimension d_sl k B
    let φ_B : MvPolynomial (Fin (s + ν + d_sl)) k →+* B := π.comp φ
    let val_B : Fin (s + ν + d_sl) → B := fun v => φ_B (MvPolynomial.X v)
    have h_aeval_eq : (MvPolynomial.aeval (R := k) val_B).toRingHom = φ_B := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        exact MvPolynomial.aeval_C val_B c
      · intro v
        exact MvPolynomial.aeval_X val_B v
    have h_aeval_apply : ∀ P, MvPolynomial.aeval (R := k) val_B P = φ_B P :=
      fun P => RingHom.congr_fun h_aeval_eq P
    have h_surj_B : Function.Surjective (MvPolynomial.aeval (R := k) val_B) := by
      intro y
      obtain ⟨P, rfl⟩ := (hπ_surj.comp hφ_surj) y
      exact ⟨P, h_aeval_apply P⟩
    let G : Algebra.Generators k B (Fin (s + ν + d_sl)) :=
      Algebra.Generators.ofSurjective val_B h_surj_B
    let rel_B : Fin (s + ν) → MvPolynomial (Fin (s + ν + d_sl)) k := Fin.addCases q f_lift
    have h_ker_B : Ideal.span (Set.range rel_B) = G.ker := by
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨m, rfl⟩
        change MvPolynomial.aeval (R := k) val_B (rel_B m) = 0
        rw [h_aeval_apply]
        refine Fin.addCases (fun i => ?_) (fun j => ?_) m
        · dsimp [rel_B]
          rw [Fin.addCases_left]
          have hq_mem : q i ∈ RingHom.ker φ := by
            rw [hker_φ]
            exact Ideal.subset_span ⟨i, rfl⟩
          change π (φ (q i)) = 0
          rw [RingHom.mem_ker.mp hq_mem, map_zero]
        · dsimp [rel_B]
          rw [Fin.addCases_right]
          have hf_mem : φ (f_lift j) ∈ RingHom.ker π := by
            rw [hker_π]
            exact Ideal.subset_span ⟨j, rfl⟩
          exact RingHom.mem_ker.mp hf_mem
      · intro P hP
        have hP' : π (φ P) = 0 := by
          have h1 : MvPolynomial.aeval (R := k) val_B P = 0 := hP
          rwa [h_aeval_apply] at h1
        have hφP : φ P ∈ Ideal.map φ (Ideal.span (Set.range f_lift)) := by
          rw [Ideal.map_span, ← Set.range_comp]
          exact hker_π ▸ RingHom.mem_ker.mpr hP'
        obtain ⟨Q, hQ_mem, hφQ⟩ := (Ideal.mem_map_iff_of_surjective φ hφ_surj).mp hφP
        have hPQ : P - Q ∈ Ideal.span (Set.range q) := by
          rw [← hker_φ, RingHom.mem_ker, map_sub, hφQ, sub_self]
        have hsub_q : Set.range q ⊆ Set.range rel_B := by
          rintro _ ⟨i, rfl⟩
          exact ⟨Fin.castAdd ν i, Fin.addCases_left i⟩
        have hsub_f : Set.range f_lift ⊆ Set.range rel_B := by
          rintro _ ⟨j, rfl⟩
          exact ⟨Fin.natAdd s j, Fin.addCases_right j⟩
        have h1 := Ideal.span_mono hsub_q hPQ
        have h2 := Ideal.span_mono hsub_f hQ_mem
        simpa only [sub_add_cancel] using Ideal.add_mem _ h1 h2
    let P_pre : Algebra.PreSubmersivePresentation k B (Fin (s + ν + d_sl)) (Fin (s + ν)) :=
      { toGenerators := G
        relation := rel_B
        span_range_relation_eq_ker := h_ker_B
        map := idx
        map_inj := hidx }
    have h_jac : P_pre.jacobian =
        π (Matrix.det (Matrix.of fun i j : Fin (s + ν) =>
          φ (MvPolynomial.pderiv (idx j) (Fin.addCases q f_lift i)))) := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      let M_poly : Matrix (Fin (s + ν)) (Fin (s + ν)) (MvPolynomial (Fin (s + ν + d_sl)) k) :=
        Matrix.of fun i j => MvPolynomial.pderiv (idx j) (rel_B i)
      have h_mat_eq : P_pre.jacobiMatrix = M_poly.transpose :=
        Matrix.ext fun i j => P_pre.jacobiMatrix_apply i j
      have h_alg : algebraMap P_pre.Ring B = φ_B := h_aeval_eq
      change (algebraMap P_pre.Ring B) P_pre.jacobiMatrix.det = _
      rw [h_alg, h_mat_eq, Matrix.det_transpose]
      change π (φ M_poly.det) = _
      rw [RingHom.map_det φ M_poly]
      rfl
    let P_sub : Algebra.SubmersivePresentation k B (Fin (s + ν + d_sl)) (Fin (s + ν)) :=
      { toPreSubmersivePresentation := P_pre
        jacobian_isUnit := h_jac ▸ hDet.map π }
    have h_dim : P_sub.dimension = d_sl := by
      change Nat.card (Fin (s + ν + d_sl)) - Nat.card (Fin (s + ν)) = d_sl
      simp only [Nat.card_eq_fintype_card, Fintype.card_fin]
      omega
    exact P_sub.isStandardSmoothOfRelativeDimension h_dim

  
  have h_schur_mat : ∀ (s : ℕ) (A R_tilde : Type u) [CommRing A] [CommRing R_tilde]
      (ι_A : A →+* R_tilde)
      (A_q : Matrix (Fin s) (Fin s) A)
      (B_q : Matrix (Fin s) (Fin 2) A)
      (C_f : Matrix (Fin 2) (Fin s) A)
      (D_f : Matrix (Fin 2) (Fin 2) A),
      IsUnit A_q.det →
      IsUnit (Matrix.fromBlocks A_q B_q C_f D_f).det →
      ∀ (b : Fin 2) (w : Fin 2 → R_tilde), w b = 1 →
      let Δ_mat : Fin 2 → R_tilde := fun c =>
        (Matrix.fromBlocks (ι_A.mapMatrix A_q)
          (Matrix.of fun i (_ : Fin 1) => ι_A (B_q i c))
          (Matrix.of fun (_ : Fin 1) j => ∑ a : Fin 2, w a * ι_A (C_f a j))
          (Matrix.of fun (_ _ : Fin 1) => ∑ a : Fin 2, w a * ι_A (D_f a c))).det
      ∃ r : Fin 2 → R_tilde, Δ_mat 0 * r 0 + Δ_mat 1 * r 1 = 1 := by
    intro s A R_tilde _ _ ι_A A_q B_q C_f D_f hDet_q hDet_full b w hwb Δ_mat
    let _ : Invertible A_q.det := hDet_q.invertible
    let _ : Invertible A_q := Matrix.invertibleOfDetInvertible A_q
    let S : Matrix (Fin 2) (Fin 2) A := D_f - C_f * ⅟A_q * B_q
    have h_fb : (Matrix.fromBlocks A_q B_q C_f D_f).det = A_q.det * S.det :=
      Matrix.det_fromBlocks₁₁ A_q B_q C_f D_f
    have hUnit_S : IsUnit S.det := by
      rw [h_fb] at hDet_full
      rcases hDet_full with ⟨u, hu⟩
      exact isUnit_iff_exists_inv.mpr ⟨A_q.det * ↑u⁻¹, by
        calc S.det * (A_q.det * ↑u⁻¹) = (A_q.det * S.det) * ↑u⁻¹ := by ring
          _ = ↑u * ↑u⁻¹ := by rw [← hu]
          _ = 1 := Units.mul_inv u⟩
    let _ : Invertible S.det := hUnit_S.invertible
    let _ : Invertible S := Matrix.invertibleOfDetInvertible S
    let S_inv : Matrix (Fin 2) (Fin 2) A := ⅟S
    have hS_mul : S * S_inv = 1 := mul_invOf_self S
    let A_q' : Matrix (Fin s) (Fin s) R_tilde := ι_A.mapMatrix A_q
    let inv_Aq' : Matrix (Fin s) (Fin s) R_tilde := ι_A.mapMatrix (⅟A_q)
    have hAq'_mul : inv_Aq' * A_q' = 1 := by
      dsimp [A_q', inv_Aq']
      rw [← map_mul, invOf_mul_self, map_one]
    have hAq'_mul2 : A_q' * inv_Aq' = 1 := by
      dsimp [A_q', inv_Aq']
      rw [← map_mul, mul_invOf_self, map_one]
    let _ : Invertible A_q' := ⟨inv_Aq', hAq'_mul, hAq'_mul2⟩
    have hΔ_eq : ∀ c : Fin 2, Δ_mat c = ι_A A_q.det * ∑ a : Fin 2, w a * ι_A (S a c) := by
      intro c
      let B_tilde : Matrix (Fin s) (Fin 1) R_tilde := Matrix.of fun i _ => ι_A (B_q i c)
      let C_tilde : Matrix (Fin 1) (Fin s) R_tilde :=
        Matrix.of fun _ j => ∑ a : Fin 2, w a * ι_A (C_f a j)
      let D_tilde : Matrix (Fin 1) (Fin 1) R_tilde :=
        Matrix.of fun _ _ => ∑ a : Fin 2, w a * ι_A (D_f a c)
      change (Matrix.fromBlocks A_q' B_tilde C_tilde D_tilde).det = _
      rw [Matrix.det_fromBlocks₁₁ A_q' B_tilde C_tilde D_tilde, Matrix.det_fin_one]
      have hdet_Aq' : A_q'.det = ι_A A_q.det := (RingHom.map_det ι_A A_q).symm
      rw [hdet_Aq']
      congr 1
      change D_tilde 0 0 - (C_tilde * inv_Aq' * B_tilde) 0 0 = _
      have h_triple : (C_tilde * inv_Aq' * B_tilde) 0 0 =
          ∑ a : Fin 2, w a * ι_A ((C_f * ⅟A_q * B_q) a c) := by
        calc (C_tilde * inv_Aq' * B_tilde) 0 0
            = ∑ k : Fin s, (∑ j : Fin s, (∑ a : Fin 2, w a * ι_A (C_f a j)) *
                ι_A ((⅟A_q) j k)) * ι_A (B_q k c) := by
              simp only [Matrix.mul_apply, C_tilde, B_tilde, inv_Aq', Matrix.of_apply,
                RingHom.mapMatrix_apply, Matrix.map_apply]
          _ = ∑ k : Fin s, ∑ a : Fin 2, w a *
                (∑ j : Fin s, ι_A (C_f a j) * ι_A ((⅟A_q) j k)) * ι_A (B_q k c) := by
              refine Finset.sum_congr rfl fun k _ => ?_
              simp only [Finset.sum_mul, Finset.mul_sum]
              rw [Finset.sum_comm]
              exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
          _ = ∑ a : Fin 2, w a *
                ∑ k : Fin s, (∑ j : Fin s, ι_A (C_f a j) * ι_A ((⅟A_q) j k)) * ι_A (B_q k c) := by
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl fun a _ => ?_
              rw [Finset.mul_sum]
              exact Finset.sum_congr rfl fun _ _ => by ring
          _ = ∑ a : Fin 2, w a * ι_A ((C_f * ⅟A_q * B_q) a c) := by
              refine Finset.sum_congr rfl fun a _ => ?_
              congr 1
              simp only [Matrix.mul_apply, map_sum, map_mul]
      rw [h_triple]
      dsimp [D_tilde, S]
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [map_sub, mul_sub]
    let u_Aq : A := ⅟(A_q.det)
    have hu_Aq : A_q.det * u_Aq = 1 := mul_invOf_self A_q.det
    refine ⟨fun c => ι_A (u_Aq * S_inv c b), ?_⟩
    have h_sum : Δ_mat 0 * ι_A (u_Aq * S_inv 0 b) + Δ_mat 1 * ι_A (u_Aq * S_inv 1 b) =
        ∑ c : Fin 2, Δ_mat c * ι_A (u_Aq * S_inv c b) :=
      (Fin.sum_univ_two fun c => Δ_mat c * ι_A (u_Aq * S_inv c b)).symm
    rw [h_sum]
    have h_cancel_Aq : ι_A A_q.det * ι_A u_Aq = 1 := by
      rw [← map_mul, hu_Aq, map_one]
    calc ∑ c : Fin 2, Δ_mat c * ι_A (u_Aq * S_inv c b)
        = ∑ c : Fin 2, ∑ a : Fin 2, w a * ι_A (S a c * S_inv c b) := by
          refine Finset.sum_congr rfl fun c _ => ?_
          rw [hΔ_eq c, ι_A.map_mul u_Aq (S_inv c b)]
          calc (ι_A A_q.det * ∑ a : Fin 2, w a * ι_A (S a c)) * (ι_A u_Aq * ι_A (S_inv c b))
              = (ι_A A_q.det * ι_A u_Aq) *
                  ((∑ a : Fin 2, w a * ι_A (S a c)) * ι_A (S_inv c b)) := by ring
            _ = (∑ a : Fin 2, w a * ι_A (S a c)) * ι_A (S_inv c b) := by
                rw [h_cancel_Aq, one_mul]
            _ = ∑ a : Fin 2, w a * (ι_A (S a c) * ι_A (S_inv c b)) := by
                rw [Finset.sum_mul]
                exact Finset.sum_congr rfl fun _ _ => by ring
            _ = ∑ a : Fin 2, w a * ι_A (S a c * S_inv c b) := by
                refine Finset.sum_congr rfl fun a _ => ?_
                rw [← ι_A.map_mul]
      _ = ∑ a : Fin 2, w a * ι_A ((S * S_inv) a b) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [← Finset.mul_sum, ← map_sum]
          rfl
      _ = 1 := by
          rw [hS_mul, Fin.sum_univ_two]
          have hb_cases : b = 0 ∨ b = 1 := by omega
          rcases hb_cases with rfl | rfl
          · have h00 : (1 : Matrix (Fin 2) (Fin 2) A) 0 0 = 1 := rfl
            have h10 : (1 : Matrix (Fin 2) (Fin 2) A) 1 0 = 0 := rfl
            rw [h00, h10, hwb, map_one, map_zero, mul_one, mul_zero, add_zero]
          · have h01 : (1 : Matrix (Fin 2) (Fin 2) A) 0 1 = 0 := rfl
            have h11 : (1 : Matrix (Fin 2) (Fin 2) A) 1 1 = 1 := rfl
            rw [h01, h11, hwb, map_zero, map_one, mul_zero, mul_one, zero_add]

  
  have h_loc_smooth : ∀ (N M_rel d_out : ℕ), (N + 1) - (M_rel + 1) = d_out →
      ∀ (R_tilde : Type u) [CommRing R_tilde]
      (φ_tilde : MvPolynomial (Fin N) k →+* R_tilde), Function.Surjective φ_tilde →
      ∀ (rel_tilde : Fin M_rel → MvPolynomial (Fin N) k),
      RingHom.ker φ_tilde = Ideal.span (Set.range rel_tilde) →
      ∀ (idx_c : Fin M_rel → Fin N), Function.Injective idx_c →
      ∀ (R_loc : Type u) [CommRing R_loc] [Algebra R_tilde R_loc]
      (D_poly : MvPolynomial (Fin N) k),
      D_poly = Matrix.det (Matrix.of fun r' c' : Fin M_rel =>
        MvPolynomial.pderiv (idx_c c') (rel_tilde r')) →
      ∀ (δ : R_tilde), δ = φ_tilde D_poly →
      [IsLocalization.Away δ R_loc] →
      RingHom.IsStandardSmoothOfRelativeDimension d_out
        ((algebraMap R_tilde R_loc).comp (φ_tilde.comp MvPolynomial.C)) := by
    intro N M_rel d_out h_dim_eq R_tilde _ φ_tilde hφ_surj rel_tilde hker_φ idx_c hidx_c
      R_loc _ _ D_poly hD_poly δ hδ _
    let locMap : R_tilde →+* R_loc := algebraMap R_tilde R_loc
    let _ : Algebra k R_loc := (locMap.comp (φ_tilde.comp MvPolynomial.C)).toAlgebra
    change Algebra.IsStandardSmoothOfRelativeDimension d_out k R_loc
    let z_inv : R_loc := IsLocalization.Away.invSelf (S := R_loc) δ
    have h_inv : locMap δ * z_inv = 1 := IsLocalization.Away.mul_invSelf δ
    let val_loc : Fin (N + 1) → R_loc :=
      Fin.lastCases z_inv (fun v => locMap (φ_tilde (MvPolynomial.X v)))
    let ψ_loc : MvPolynomial (Fin (N + 1)) k →+* R_loc :=
      (MvPolynomial.aeval (R := k) val_loc).toRingHom
    have hψ_rename : ∀ P : MvPolynomial (Fin N) k,
        ψ_loc (MvPolynomial.rename Fin.castSucc P) = locMap (φ_tilde P) := by
      have h_hom : ψ_loc.comp (MvPolynomial.rename (R := k) Fin.castSucc).toRingHom =
          locMap.comp φ_tilde := by
        apply MvPolynomial.ringHom_ext'
        · ext c
          change MvPolynomial.aeval (R := k) val_loc
            (MvPolynomial.rename Fin.castSucc (MvPolynomial.C c)) = _
          rw [MvPolynomial.rename_C, MvPolynomial.aeval_C]
          rfl
        · intro v
          change MvPolynomial.aeval (R := k) val_loc
            (MvPolynomial.rename Fin.castSucc (MvPolynomial.X v)) = _
          rw [MvPolynomial.rename_X, MvPolynomial.aeval_X]
          exact Fin.lastCases_castSucc v
      exact fun P => RingHom.congr_fun h_hom P
    have hψ_last : ψ_loc (MvPolynomial.X (Fin.last N)) = z_inv := by
      change MvPolynomial.aeval (R := k) val_loc (MvPolynomial.X (Fin.last N)) = z_inv
      rw [MvPolynomial.aeval_X]
      exact Fin.lastCases_last
    have h_surj_loc : Function.Surjective (MvPolynomial.aeval (R := k) val_loc) := by
      intro y
      obtain ⟨m, x, hxm⟩ := IsLocalization.Away.surj δ y
      obtain ⟨P, rfl⟩ := hφ_surj x
      refine ⟨MvPolynomial.rename Fin.castSucc P * MvPolynomial.X (Fin.last N) ^ m, ?_⟩
      change ψ_loc (MvPolynomial.rename Fin.castSucc P * MvPolynomial.X (Fin.last N) ^ m) = y
      rw [map_mul, map_pow, hψ_rename, hψ_last]
      have hxm' : y * locMap δ ^ m = locMap (φ_tilde P) := hxm
      rw [← hxm']
      calc y * locMap δ ^ m * z_inv ^ m
          = y * (locMap δ * z_inv) ^ m := by ring
        _ = y := by rw [h_inv, one_pow, mul_one]
    let G_loc : Algebra.Generators k R_loc (Fin (N + 1)) :=
      Algebra.Generators.ofSurjective val_loc h_surj_loc
    let D_0 : MvPolynomial (Fin (N + 1)) k := MvPolynomial.rename Fin.castSucc D_poly
    let X_last : MvPolynomial (Fin (N + 1)) k := MvPolynomial.X (Fin.last N)
    let rel_loc : Fin (M_rel + 1) → MvPolynomial (Fin (N + 1)) k :=
      Fin.lastCases (X_last * D_0 - 1)
        (fun r' => MvPolynomial.rename Fin.castSucc (rel_tilde r'))
    let J_loc : Ideal (MvPolynomial (Fin (N + 1)) k) := Ideal.span (Set.range rel_loc)
    have h_unit_mod : X_last * D_0 - 1 ∈ J_loc :=
      Ideal.subset_span ⟨Fin.last M_rel, Fin.lastCases_last⟩
    have h_pow_mod : ∀ m : ℕ, (X_last * D_0) ^ m - 1 ∈ J_loc := by
      intro m
      induction m with
      | zero => simp
      | succ m ihm =>
        have h_eq : (X_last * D_0) ^ (m + 1) - 1 =
            (X_last * D_0) * ((X_last * D_0) ^ m - 1) + (X_last * D_0 - 1) := by ring
        rw [h_eq]
        exact J_loc.add_mem (J_loc.mul_mem_left _ ihm) h_unit_mod
    have h_map_ker : ∀ P ∈ RingHom.ker φ_tilde,
        MvPolynomial.rename Fin.castSucc P ∈ J_loc := by
      have h_le : Ideal.map (MvPolynomial.rename (R := k) Fin.castSucc).toRingHom
          (RingHom.ker φ_tilde) ≤ J_loc := by
        rw [hker_φ, Ideal.map_span, Ideal.span_le]
        rintro _ ⟨_, ⟨r', rfl⟩, rfl⟩
        exact Ideal.subset_span ⟨r'.castSucc, Fin.lastCases_castSucc r'⟩
      exact fun P hP => h_le (Ideal.mem_map_of_mem _ hP)
    have h_clear : ∀ Q : MvPolynomial (Fin (N + 1)) k,
        ∃ (d : ℕ) (P_0 : MvPolynomial (Fin N) k),
          D_0 ^ d * Q - MvPolynomial.rename Fin.castSucc P_0 ∈ J_loc := by
      intro Q
      refine MvPolynomial.induction_on
        (motive := fun Q => ∃ (d : ℕ) (P_0 : MvPolynomial (Fin N) k),
          D_0 ^ d * Q - MvPolynomial.rename Fin.castSucc P_0 ∈ J_loc)
        Q (fun c => ?_) (fun Q₁ Q₂ ih₁ ih₂ => ?_) (fun Q₁ w ih => ?_)
      · refine ⟨0, MvPolynomial.C c, ?_⟩
        rw [pow_zero, one_mul, MvPolynomial.rename_C, sub_self]
        exact J_loc.zero_mem
      · rcases ih₁ with ⟨d₁, P₁, h₁⟩
        rcases ih₂ with ⟨d₂, P₂, h₂⟩
        refine ⟨d₁ + d₂, D_poly ^ d₂ * P₁ + D_poly ^ d₁ * P₂, ?_⟩
        have h_eq : D_0 ^ (d₁ + d₂) * (Q₁ + Q₂) -
              MvPolynomial.rename Fin.castSucc (D_poly ^ d₂ * P₁ + D_poly ^ d₁ * P₂) =
            D_0 ^ d₂ * (D_0 ^ d₁ * Q₁ - MvPolynomial.rename Fin.castSucc P₁) +
            D_0 ^ d₁ * (D_0 ^ d₂ * Q₂ - MvPolynomial.rename Fin.castSucc P₂) := by
          simp only [map_add, map_mul, map_pow]
          dsimp [D_0]
          ring
        rw [h_eq]
        exact J_loc.add_mem (J_loc.mul_mem_left _ h₁) (J_loc.mul_mem_left _ h₂)
      · rcases ih with ⟨d₁, P₁, h₁⟩
        refine Fin.lastCases ?_ (fun v => ?_) w
        · refine ⟨d₁ + 1, P₁, ?_⟩
          have h_eq : D_0 ^ (d₁ + 1) * (Q₁ * X_last) - MvPolynomial.rename Fin.castSucc P₁ =
              (X_last * D_0) * (D_0 ^ d₁ * Q₁ - MvPolynomial.rename Fin.castSucc P₁) +
              MvPolynomial.rename Fin.castSucc P₁ * (X_last * D_0 - 1) := by ring
          change D_0 ^ (d₁ + 1) * (Q₁ * X_last) - MvPolynomial.rename Fin.castSucc P₁ ∈ J_loc
          rw [h_eq]
          exact J_loc.add_mem (J_loc.mul_mem_left _ h₁) (J_loc.mul_mem_left _ h_unit_mod)
        · refine ⟨d₁, P₁ * MvPolynomial.X v, ?_⟩
          have h_eq : D_0 ^ d₁ * (Q₁ * MvPolynomial.X v.castSucc) -
                MvPolynomial.rename Fin.castSucc (P₁ * MvPolynomial.X v) =
              MvPolynomial.X v.castSucc *
                (D_0 ^ d₁ * Q₁ - MvPolynomial.rename Fin.castSucc P₁) := by
            rw [map_mul, MvPolynomial.rename_X]
            ring
          rw [h_eq]
          exact J_loc.mul_mem_left _ h₁
    have h_le_ker : J_loc ≤ G_loc.ker := by
      rw [Ideal.span_le]
      rintro _ ⟨m, rfl⟩
      change ψ_loc (rel_loc m) = 0
      refine Fin.lastCases ?_ (fun r' => ?_) m
      · dsimp [rel_loc]
        rw [Fin.lastCases_last, map_sub, map_mul, map_one, hψ_last]
        dsimp [D_0]
        rw [hψ_rename, ← hδ, mul_comm, h_inv, sub_self]
      · dsimp [rel_loc]
        rw [Fin.lastCases_castSucc, hψ_rename]
        have h_mem : rel_tilde r' ∈ RingHom.ker φ_tilde := by
          rw [hker_φ]
          exact Ideal.subset_span ⟨r', rfl⟩
        rw [RingHom.mem_ker.mp h_mem, map_zero]
    have h_ker_eq : J_loc = G_loc.ker := by
      apply le_antisymm h_le_ker
      intro Q hQ
      have hψQ : ψ_loc Q = 0 := hQ
      obtain ⟨d, P_0, h_cl⟩ := h_clear Q
      have hψ_cl : ψ_loc (D_0 ^ d * Q - MvPolynomial.rename Fin.castSucc P_0) = 0 :=
        h_le_ker h_cl
      rw [map_sub, map_mul, hψQ, mul_zero, zero_sub, neg_eq_zero, hψ_rename] at hψ_cl
      obtain ⟨⟨_, m, rfl⟩, hm_zero⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers δ) R_loc (φ_tilde P_0)).mp hψ_cl
      dsimp only at hm_zero
      have h_mem_ker : D_poly ^ m * P_0 ∈ RingHom.ker φ_tilde := by
        rw [RingHom.mem_ker, map_mul, map_pow, ← hδ]
        exact hm_zero
      have h_ren_mem : D_0 ^ m * MvPolynomial.rename Fin.castSucc P_0 ∈ J_loc := by
        have h1 := h_map_ker (D_poly ^ m * P_0) h_mem_ker
        simpa only [map_mul, map_pow, D_0] using h1
      have h_D_Q : D_0 ^ (m + d) * Q ∈ J_loc := by
        have h_eq : D_0 ^ (m + d) * Q =
            D_0 ^ m * (D_0 ^ d * Q - MvPolynomial.rename Fin.castSucc P_0) +
            D_0 ^ m * MvPolynomial.rename Fin.castSucc P_0 := by ring
        rw [h_eq]
        exact J_loc.add_mem (J_loc.mul_mem_left _ h_cl) h_ren_mem
      have h_Q_id : Q = X_last ^ (m + d) * (D_0 ^ (m + d) * Q) -
          Q * ((X_last * D_0) ^ (m + d) - 1) := by ring
      rw [h_Q_id]
      exact J_loc.sub_mem (J_loc.mul_mem_left _ h_D_Q)
        (J_loc.mul_mem_left _ (h_pow_mod (m + d)))
    let map_loc : Fin (M_rel + 1) → Fin (N + 1) :=
      Fin.lastCases (Fin.last N) (fun c' => (idx_c c').castSucc)
    have hmap_inj : Function.Injective map_loc := by
      intro x y
      refine Fin.lastCases ?_ (fun c₁ => ?_) x <;>
        refine Fin.lastCases ?_ (fun c₂ => ?_) y <;> intro hxy
      · rfl
      · dsimp [map_loc] at hxy
        rw [Fin.lastCases_last, Fin.lastCases_castSucc] at hxy
        exact absurd hxy.symm (Fin.castSucc_ne_last _)
      · dsimp [map_loc] at hxy
        rw [Fin.lastCases_castSucc, Fin.lastCases_last] at hxy
        exact absurd hxy (Fin.castSucc_ne_last _)
      · dsimp [map_loc] at hxy
        rw [Fin.lastCases_castSucc, Fin.lastCases_castSucc] at hxy
        exact congrArg Fin.castSucc (hidx_c (Fin.castSucc_inj.mp hxy))
    let P_pre : Algebra.PreSubmersivePresentation k R_loc (Fin (N + 1)) (Fin (M_rel + 1)) :=
      { toGenerators := G_loc
        relation := rel_loc
        span_range_relation_eq_ker := h_ker_eq
        map := map_loc
        map_inj := hmap_inj }
    have hpderiv_last_rename : ∀ P : MvPolynomial (Fin N) k,
        MvPolynomial.pderiv (Fin.last N) (MvPolynomial.rename Fin.castSucc P) = 0 := by
      intro P
      apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
      intro hmem
      have hmem' := MvPolynomial.vars_rename Fin.castSucc P hmem
      rw [Finset.mem_image] at hmem'
      rcases hmem' with ⟨v, _, hv⟩
      exact Fin.castSucc_ne_last v hv
    have h_jac_eq : P_pre.jacobian = locMap δ * locMap δ := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      let J_mat : Matrix (Fin (M_rel + 1)) (Fin (M_rel + 1)) R_loc :=
        Matrix.of fun i j => ψ_loc (MvPolynomial.pderiv (map_loc j) (rel_loc i))
      have h_tr : (algebraMap P_pre.Ring R_loc).mapMatrix P_pre.jacobiMatrix = J_mat.transpose :=
        Matrix.ext fun i j => by
          change ψ_loc (P_pre.jacobiMatrix i j) = J_mat j i
          rw [P_pre.jacobiMatrix_apply]
          rfl
      change (algebraMap P_pre.Ring R_loc) P_pre.jacobiMatrix.det = _
      rw [RingHom.map_det, h_tr, Matrix.det_transpose]
      let J_tl : Matrix (Fin M_rel) (Fin M_rel) R_loc :=
        Matrix.of fun r' c' => locMap (φ_tilde (MvPolynomial.pderiv (idx_c c') (rel_tilde r')))
      let J_bl : Matrix (Fin 1) (Fin M_rel) R_loc :=
        Matrix.of fun _ c' => J_mat (Fin.last M_rel) c'.castSucc
      let J_br : Matrix (Fin 1) (Fin 1) R_loc :=
        Matrix.of fun _ _ => locMap δ
      have h_reidx : Matrix.reindex finSumFinEquiv finSumFinEquiv
          (Matrix.fromBlocks J_tl (0 : Matrix (Fin M_rel) (Fin 1) R_loc) J_bl J_br) = J_mat :=
        Matrix.ext fun i j => by
          rcases finSumFinEquiv.surjective i with ⟨i₀ | i₀, rfl⟩ <;>
            rcases finSumFinEquiv.surjective j with ⟨j₀ | j₀, rfl⟩
          · rw [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_apply_apply,
              Equiv.symm_apply_apply, Matrix.fromBlocks_apply₁₁, finSumFinEquiv_apply_left,
              finSumFinEquiv_apply_left]
            have hi : Fin.castAdd 1 i₀ = i₀.castSucc := rfl
            have hj : Fin.castAdd 1 j₀ = j₀.castSucc := rfl
            rw [hi, hj]
            dsimp [J_tl, J_mat, map_loc, rel_loc]
            rw [Fin.lastCases_castSucc, Fin.lastCases_castSucc,
              MvPolynomial.pderiv_rename (Fin.castSucc_injective N), hψ_rename]
          · rw [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_apply_apply,
              Equiv.symm_apply_apply, Matrix.fromBlocks_apply₁₂, Matrix.zero_apply,
              finSumFinEquiv_apply_left, finSumFinEquiv_apply_right]
            have hi : Fin.castAdd 1 i₀ = i₀.castSucc := rfl
            have hj : Fin.natAdd M_rel j₀ = Fin.last M_rel := by ext; simp [Fin.eq_zero j₀]
            rw [hi, hj]
            dsimp [J_mat, map_loc, rel_loc]
            rw [Fin.lastCases_last, Fin.lastCases_castSucc, hpderiv_last_rename, map_zero]
          · rw [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_apply_apply,
              Equiv.symm_apply_apply, Matrix.fromBlocks_apply₂₁,
              finSumFinEquiv_apply_right, finSumFinEquiv_apply_left]
            have hi : Fin.natAdd M_rel i₀ = Fin.last M_rel := by ext; simp [Fin.eq_zero i₀]
            have hj : Fin.castAdd 1 j₀ = j₀.castSucc := rfl
            rw [hi, hj]
            rfl
          · rw [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_apply_apply,
              Equiv.symm_apply_apply, Matrix.fromBlocks_apply₂₂,
              finSumFinEquiv_apply_right, finSumFinEquiv_apply_right]
            have hi : Fin.natAdd M_rel i₀ = Fin.last M_rel := by ext; simp [Fin.eq_zero i₀]
            have hj : Fin.natAdd M_rel j₀ = Fin.last M_rel := by ext; simp [Fin.eq_zero j₀]
            rw [hi, hj]
            dsimp [J_br, J_mat, map_loc, rel_loc]
            rw [Fin.lastCases_last, Fin.lastCases_last, map_sub,
              Derivation.map_one_eq_zero, sub_zero, MvPolynomial.pderiv_mul]
            simp only [X_last, D_0, MvPolynomial.pderiv_X_self, hpderiv_last_rename, mul_zero,
              add_zero, one_mul, hψ_rename, hδ]
      rw [← h_reidx, Matrix.det_reindex_self, Matrix.det_fromBlocks_zero₁₂, Matrix.det_fin_one]
      have h_tl_det : J_tl.det = locMap δ := by
        have h1 : J_tl = (locMap.comp φ_tilde).mapMatrix
            (Matrix.of fun r' c' : Fin M_rel => MvPolynomial.pderiv (idx_c c') (rel_tilde r')) :=
          Matrix.ext fun _ _ => rfl
        rw [h1, ← RingHom.map_det, RingHom.comp_apply, ← hD_poly, ← hδ]
      rw [h_tl_det]
      rfl
    have h_unit_jac : IsUnit P_pre.jacobian := by
      rw [h_jac_eq]
      exact isUnit_iff_exists_inv.mpr ⟨z_inv * z_inv, by
        calc (locMap δ * locMap δ) * (z_inv * z_inv)
            = (locMap δ * z_inv) * (locMap δ * z_inv) := by ring
          _ = 1 := by rw [h_inv, mul_one]⟩
    let P_sub : Algebra.SubmersivePresentation k R_loc (Fin (N + 1)) (Fin (M_rel + 1)) :=
      { toPreSubmersivePresentation := P_pre
        jacobian_isUnit := h_unit_jac }
    have h_dim : P_sub.dimension = d_out := by
      change Nat.card (Fin (N + 1)) - Nat.card (Fin (M_rel + 1)) = d_out
      simpa only [Nat.card_eq_fintype_card, Fintype.card_fin] using h_dim_eq
    exact P_sub.isStandardSmoothOfRelativeDimension h_dim

  
  have h_s3 : ∀ (s d_ax : ℕ) (A : Type u) [CommRing A]
      (φ : MvPolynomial (Fin (s + 2 + d_ax)) k →+* A), Function.Surjective φ →
      ∀ (q : Fin s → MvPolynomial (Fin (s + 2 + d_ax)) k),
      RingHom.ker φ = Ideal.span (Set.range q) →
      ∀ (f_lift : Fin 2 → MvPolynomial (Fin (s + 2 + d_ax)) k)
      (idx : Fin (s + 2) → Fin (s + 2 + d_ax)), Function.Injective idx →
      IsUnit (Matrix.det (Matrix.of fun i j : Fin s =>
        φ (MvPolynomial.pderiv (idx (Fin.castAdd 2 j)) (q i)))) →
      IsUnit (Matrix.det (Matrix.of fun i j : Fin (s + 2) =>
        φ (MvPolynomial.pderiv (idx j) (Fin.addCases q f_lift i)))) →
      ∀ (b : Fin 2) (R_tilde : Type u) [CommRing R_tilde]
      (π_tilde : Polynomial A →+* R_tilde), Function.Surjective π_tilde →
      RingHom.ker π_tilde =
        Ideal.span {∑ a : Fin 2,
          Polynomial.C (φ (f_lift a)) * (if a = b then 1 else Polynomial.X)} →
      ∃ (Δ r : Fin 2 → R_tilde),
        Δ 0 * r 0 + Δ 1 * r 1 = 1 ∧
        ∀ (c : Fin 2) (R_loc : Type u) [CommRing R_loc] [Algebra R_tilde R_loc]
          [IsLocalization.Away (Δ c) R_loc],
          RingHom.IsStandardSmoothOfRelativeDimension (d_ax + 2)
            ((algebraMap R_tilde R_loc).comp
              (π_tilde.comp (Polynomial.C.comp (φ.comp MvPolynomial.C)))) := by
    intro s d_ax A _ φ hφ_surj q hker_φ f_lift idx hidx hDet_q hDet_full b R_tilde _
      π_tilde hπ_surj hker_π
    let n : ℕ := s + 2 + d_ax
    let toPoly : MvPolynomial (Fin (n + 1)) k →+* Polynomial (MvPolynomial (Fin n) k) :=
      MvPolynomial.eval₂Hom (Polynomial.C.comp MvPolynomial.C)
        (Fin.lastCases Polynomial.X (fun v => Polynomial.C (MvPolynomial.X v)))
    let fromPoly : Polynomial (MvPolynomial (Fin n) k) →+* MvPolynomial (Fin (n + 1)) k :=
      Polynomial.eval₂RingHom (MvPolynomial.rename (R := k) Fin.castSucc).toRingHom
        (MvPolynomial.X (Fin.last n))
    have h_from_to : fromPoly.comp toPoly = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        simp [toPoly, fromPoly]
      · intro w
        refine Fin.lastCases ?_ (fun v => ?_) w
        · simp [toPoly, fromPoly]
        · simp [toPoly, fromPoly]
    have h_to_rename : toPoly.comp (MvPolynomial.rename (R := k) Fin.castSucc).toRingHom =
        Polynomial.C := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        simp [toPoly]
      · intro v
        simp [toPoly]
    have h_to_from : toPoly.comp fromPoly = RingHom.id _ := by
      apply Polynomial.ringHom_ext'
      · refine RingHom.ext fun P => ?_
        simpa [fromPoly] using RingHom.congr_fun h_to_rename P
      · simp [toPoly, fromPoly]
    let e_poly : MvPolynomial (Fin (n + 1)) k ≃+* Polynomial (MvPolynomial (Fin n) k) :=
      { toFun := toPoly
        invFun := fromPoly
        left_inv := fun P => RingHom.congr_fun h_from_to P
        right_inv := fun P => RingHom.congr_fun h_to_from P
        map_mul' := toPoly.map_mul
        map_add' := toPoly.map_add }
    let φ_tilde : MvPolynomial (Fin (n + 1)) k →+* R_tilde :=
      π_tilde.comp ((Polynomial.mapRingHom φ).comp e_poly.toRingHom)
    have hφ_tilde_surj : Function.Surjective φ_tilde :=
      hπ_surj.comp ((Polynomial.map_surjective φ hφ_surj).comp e_poly.surjective)
    have hφ_tilde_rename : ∀ P : MvPolynomial (Fin n) k,
        φ_tilde (MvPolynomial.rename Fin.castSucc P) = π_tilde (Polynomial.C (φ P)) := by
      intro P
      change π_tilde (Polynomial.map φ (toPoly (MvPolynomial.rename Fin.castSucc P))) = _
      have h1 : toPoly (MvPolynomial.rename Fin.castSucc P) = Polynomial.C P :=
        RingHom.congr_fun h_to_rename P
      rw [h1, Polynomial.map_C]
    have hφ_tilde_C : φ_tilde.comp MvPolynomial.C =
        π_tilde.comp (Polynomial.C.comp (φ.comp MvPolynomial.C)) := by
      ext c
      simp [φ_tilde, e_poly, toPoly]
    let Q_inc : MvPolynomial (Fin (n + 1)) k :=
      ∑ a : Fin 2, MvPolynomial.rename Fin.castSucc (f_lift a) *
        (if a = b then 1 else MvPolynomial.X (Fin.last n))
    let rel_tilde : Fin (s + 1) → MvPolynomial (Fin (n + 1)) k :=
      Fin.lastCases Q_inc (fun i => MvPolynomial.rename Fin.castSucc (q i))
    let Φ_b : Polynomial A :=
      ∑ a : Fin 2, Polynomial.C (φ (f_lift a)) * (if a = b then 1 else Polynomial.X)
    have h_map_Qinc : Polynomial.map φ (e_poly Q_inc) = Φ_b := by
      dsimp [Q_inc, Φ_b, e_poly]
      rw [_root_.map_sum toPoly, Polynomial.map_sum]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [_root_.map_mul toPoly, Polynomial.map_mul]
      have h1 : toPoly (MvPolynomial.rename Fin.castSucc (f_lift a)) = Polynomial.C (f_lift a) :=
        RingHom.congr_fun h_to_rename (f_lift a)
      rw [h1, Polynomial.map_C]
      congr 1
      split_ifs <;> simp [toPoly]
    have hker_φ_tilde : RingHom.ker φ_tilde = Ideal.span (Set.range rel_tilde) := by
      apply le_antisymm
      · intro P hP
        have h_mem_π : Polynomial.map φ (e_poly P) ∈ RingHom.ker π_tilde := hP
        rw [hker_π, Ideal.mem_span_singleton] at h_mem_π
        rcases h_mem_π with ⟨g_A, hg_A⟩
        obtain ⟨g_0, rfl⟩ := Polynomial.map_surjective φ hφ_surj g_A
        let H : MvPolynomial (Fin (n + 1)) k := e_poly.symm g_0
        let R_poly : Polynomial (MvPolynomial (Fin n) k) := e_poly (P - Q_inc * H)
        have hR_zero : Polynomial.map φ R_poly = 0 := by
          dsimp [R_poly, H]
          rw [map_sub, map_mul, e_poly.apply_symm_apply, Polynomial.map_sub, Polynomial.map_mul,
            h_map_Qinc, hg_A]
          exact sub_self _
        have h_map_q : Ideal.map (MvPolynomial.rename (R := k) Fin.castSucc).toRingHom
            (RingHom.ker φ) ≤ Ideal.span (Set.range rel_tilde) := by
          rw [hker_φ, Ideal.map_span, Ideal.span_le]
          rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
          exact Ideal.subset_span ⟨i.castSucc, Fin.lastCases_castSucc i⟩
        have hR_symm : e_poly.symm R_poly ∈ Ideal.span (Set.range rel_tilde) := by
          rw [Polynomial.as_sum_support_C_mul_X_pow R_poly, map_sum]
          refine Ideal.sum_mem _ fun m _ => ?_
          change fromPoly (Polynomial.C (R_poly.coeff m) * Polynomial.X ^ m) ∈ _
          rw [map_mul, map_pow]
          change Polynomial.eval₂ (MvPolynomial.rename (R := k) Fin.castSucc).toRingHom
              (MvPolynomial.X (Fin.last n)) (Polynomial.C (R_poly.coeff m)) *
            Polynomial.eval₂ (MvPolynomial.rename (R := k) Fin.castSucc).toRingHom
              (MvPolynomial.X (Fin.last n)) Polynomial.X ^ m ∈ _
          rw [Polynomial.eval₂_C, Polynomial.eval₂_X]
          refine Ideal.mul_mem_right _ _ (h_map_q (Ideal.mem_map_of_mem _ ?_))
          rw [RingHom.mem_ker, ← Polynomial.coeff_map, hR_zero, Polynomial.coeff_zero]
        have hPQ_mem : P - Q_inc * H ∈ Ideal.span (Set.range rel_tilde) := by
          simpa [R_poly] using hR_symm
        have hQ_mem : Q_inc ∈ Ideal.span (Set.range rel_tilde) :=
          Ideal.subset_span ⟨Fin.last s, Fin.lastCases_last⟩
        simpa only [sub_add_cancel] using
          Ideal.add_mem _ hPQ_mem (Ideal.mul_mem_right H _ hQ_mem)
      · rw [Ideal.span_le]
        rintro _ ⟨m, rfl⟩
        change φ_tilde (rel_tilde m) = 0
        refine Fin.lastCases ?_ (fun i => ?_) m
        · dsimp [rel_tilde]
          rw [Fin.lastCases_last]
          change π_tilde (Polynomial.map φ (e_poly Q_inc)) = 0
          rw [h_map_Qinc, ← RingHom.mem_ker, hker_π]
          exact Ideal.subset_span rfl
        · dsimp [rel_tilde]
          rw [Fin.lastCases_castSucc, hφ_tilde_rename]
          have hq_i : q i ∈ RingHom.ker φ := by
            rw [hker_φ]
            exact Ideal.subset_span ⟨i, rfl⟩
          rw [RingHom.mem_ker.mp hq_i, map_zero, map_zero]
    let idx_c : Fin 2 → Fin (s + 1) → Fin (n + 1) := fun c =>
      Fin.lastCases ((idx (Fin.natAdd s c)).castSucc) (fun j => (idx (Fin.castAdd 2 j)).castSucc)
    have hidx_c_inj : ∀ c : Fin 2, Function.Injective (idx_c c) := by
      intro c x y
      refine Fin.lastCases ?_ (fun j₁ => ?_) x <;>
        refine Fin.lastCases ?_ (fun j₂ => ?_) y <;> intro hxy
      · rfl
      · dsimp [idx_c] at hxy
        rw [Fin.lastCases_last, Fin.lastCases_castSucc] at hxy
        have h1 := hidx (Fin.castSucc_inj.mp hxy)
        have h2 := congrArg Fin.val h1
        simp only [Fin.val_natAdd, Fin.val_castAdd] at h2
        omega
      · dsimp [idx_c] at hxy
        rw [Fin.lastCases_castSucc, Fin.lastCases_last] at hxy
        have h1 := hidx (Fin.castSucc_inj.mp hxy)
        have h2 := congrArg Fin.val h1
        simp only [Fin.val_natAdd, Fin.val_castAdd] at h2
        omega
      · dsimp [idx_c] at hxy
        rw [Fin.lastCases_castSucc, Fin.lastCases_castSucc] at hxy
        have h1 := hidx (Fin.castSucc_inj.mp hxy)
        exact congrArg Fin.castSucc (Fin.castAdd_injective _ _ h1)
    let D_poly : Fin 2 → MvPolynomial (Fin (n + 1)) k := fun c =>
      Matrix.det (Matrix.of fun r' c' : Fin (s + 1) =>
        MvPolynomial.pderiv (idx_c c c') (rel_tilde r'))
    let Δ : Fin 2 → R_tilde := fun c => φ_tilde (D_poly c)
    let A_q : Matrix (Fin s) (Fin s) A :=
      Matrix.of fun i j => φ (MvPolynomial.pderiv (idx (Fin.castAdd 2 j)) (q i))
    let B_q : Matrix (Fin s) (Fin 2) A :=
      Matrix.of fun i c => φ (MvPolynomial.pderiv (idx (Fin.natAdd s c)) (q i))
    let C_f : Matrix (Fin 2) (Fin s) A :=
      Matrix.of fun a j => φ (MvPolynomial.pderiv (idx (Fin.castAdd 2 j)) (f_lift a))
    let D_f : Matrix (Fin 2) (Fin 2) A :=
      Matrix.of fun a c => φ (MvPolynomial.pderiv (idx (Fin.natAdd s c)) (f_lift a))
    have hDet_fb : IsUnit (Matrix.fromBlocks A_q B_q C_f D_f).det := by
      have h_reidx : Matrix.reindex finSumFinEquiv finSumFinEquiv
          (Matrix.fromBlocks A_q B_q C_f D_f) =
          Matrix.of (fun i j : Fin (s + 2) =>
            φ (MvPolynomial.pderiv (idx j) (Fin.addCases q f_lift i))) :=
        Matrix.ext fun i j => by
          rcases finSumFinEquiv.surjective i with ⟨i₀ | i₀, rfl⟩ <;>
            rcases finSumFinEquiv.surjective j with ⟨j₀ | j₀, rfl⟩
          · simp [A_q]
          · simp [B_q]
          · simp [C_f]
          · simp [D_f]
      rw [← Matrix.det_reindex_self finSumFinEquiv (Matrix.fromBlocks A_q B_q C_f D_f), h_reidx]
      exact hDet_full
    let ι_A : A →+* R_tilde := π_tilde.comp Polynomial.C
    let w : Fin 2 → R_tilde :=
      fun a => if a = b then 1 else φ_tilde (MvPolynomial.X (Fin.last n))
    have hwb : w b = 1 := by simp [w]
    obtain ⟨r, hBez_mat⟩ := h_schur_mat s A R_tilde ι_A A_q B_q C_f D_f hDet_q hDet_fb b w hwb
    have hΔ_match : ∀ c : Fin 2, Δ c =
        (Matrix.fromBlocks (ι_A.mapMatrix A_q)
          (Matrix.of fun i (_ : Fin 1) => ι_A (B_q i c))
          (Matrix.of fun (_ : Fin 1) j => ∑ a : Fin 2, w a * ι_A (C_f a j))
          (Matrix.of fun (_ _ : Fin 1) => ∑ a : Fin 2, w a * ι_A (D_f a c))).det := by
      intro c
      dsimp [Δ, D_poly]
      rw [RingHom.map_det]
      have hpderiv_Qinc : ∀ v : Fin n,
          φ_tilde (MvPolynomial.pderiv v.castSucc Q_inc) =
            ∑ a : Fin 2, w a * ι_A (φ (MvPolynomial.pderiv v (f_lift a))) := by
        intro v
        dsimp [Q_inc]
        rw [map_sum, map_sum]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_rename (Fin.castSucc_injective n)]
        have h_rhs_deriv : MvPolynomial.pderiv v.castSucc
            (if a = b then (1 : MvPolynomial (Fin (n + 1)) k)
              else MvPolynomial.X (Fin.last n)) = 0 := by
          split_ifs
          · exact Derivation.map_one_eq_zero _
          · exact MvPolynomial.pderiv_X_of_ne (Fin.castSucc_ne_last v).symm
        rw [h_rhs_deriv, mul_zero, add_zero, map_mul, hφ_tilde_rename, mul_comm]
        congr 1
        dsimp [w]
        split_ifs <;> simp
      have h_reidx : Matrix.reindex finSumFinEquiv finSumFinEquiv
          (Matrix.fromBlocks (ι_A.mapMatrix A_q)
            (Matrix.of fun i (_ : Fin 1) => ι_A (B_q i c))
            (Matrix.of fun (_ : Fin 1) j => ∑ a : Fin 2, w a * ι_A (C_f a j))
            (Matrix.of fun (_ _ : Fin 1) => ∑ a : Fin 2, w a * ι_A (D_f a c))) =
          φ_tilde.mapMatrix (Matrix.of fun r' c' : Fin (s + 1) =>
            MvPolynomial.pderiv (idx_c c c') (rel_tilde r')) :=
        Matrix.ext fun i j => by
          rcases finSumFinEquiv.surjective i with ⟨i₀ | i₀, rfl⟩ <;>
            rcases finSumFinEquiv.surjective j with ⟨j₀ | j₀, rfl⟩
          · rw [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_apply_apply,
              Equiv.symm_apply_apply, Matrix.fromBlocks_apply₁₁, finSumFinEquiv_apply_left,
              finSumFinEquiv_apply_left, RingHom.mapMatrix_apply, Matrix.map_apply,
              RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
            have hi : Fin.castAdd 1 i₀ = i₀.castSucc := rfl
            have hj : Fin.castAdd 1 j₀ = j₀.castSucc := rfl
            rw [hi, hj]
            dsimp [A_q, idx_c, rel_tilde, ι_A]
            rw [Fin.lastCases_castSucc, Fin.lastCases_castSucc,
              MvPolynomial.pderiv_rename (Fin.castSucc_injective n), hφ_tilde_rename]
          · rw [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_apply_apply,
              Equiv.symm_apply_apply, Matrix.fromBlocks_apply₁₂, finSumFinEquiv_apply_left,
              finSumFinEquiv_apply_right, RingHom.mapMatrix_apply, Matrix.map_apply,
              Matrix.of_apply, Matrix.of_apply]
            have hi : Fin.castAdd 1 i₀ = i₀.castSucc := rfl
            have hj : Fin.natAdd s j₀ = Fin.last s := by ext; simp [Fin.eq_zero j₀]
            rw [hi, hj]
            dsimp [B_q, idx_c, rel_tilde, ι_A]
            rw [Fin.lastCases_last, Fin.lastCases_castSucc,
              MvPolynomial.pderiv_rename (Fin.castSucc_injective n), hφ_tilde_rename]
          · rw [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_apply_apply,
              Equiv.symm_apply_apply, Matrix.fromBlocks_apply₂₁, finSumFinEquiv_apply_right,
              finSumFinEquiv_apply_left, RingHom.mapMatrix_apply, Matrix.map_apply,
              Matrix.of_apply, Matrix.of_apply]
            have hi : Fin.natAdd s i₀ = Fin.last s := by ext; simp [Fin.eq_zero i₀]
            have hj : Fin.castAdd 1 j₀ = j₀.castSucc := rfl
            rw [hi, hj]
            dsimp [C_f, idx_c, rel_tilde]
            rw [Fin.lastCases_last, Fin.lastCases_castSucc, hpderiv_Qinc]
          · rw [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_apply_apply,
              Equiv.symm_apply_apply, Matrix.fromBlocks_apply₂₂, finSumFinEquiv_apply_right,
              finSumFinEquiv_apply_right, RingHom.mapMatrix_apply, Matrix.map_apply,
              Matrix.of_apply, Matrix.of_apply]
            have hi : Fin.natAdd s i₀ = Fin.last s := by ext; simp [Fin.eq_zero i₀]
            have hj : Fin.natAdd s j₀ = Fin.last s := by ext; simp [Fin.eq_zero j₀]
            rw [hi, hj]
            dsimp [D_f, idx_c, rel_tilde]
            rw [Fin.lastCases_last, Fin.lastCases_last, hpderiv_Qinc]
      rw [← h_reidx, Matrix.det_reindex_self]
    refine ⟨Δ, r, ?_, fun c R_loc _ _ _ => ?_⟩
    · rwa [hΔ_match 0, hΔ_match 1]
    · rw [← hφ_tilde_C]
      exact h_loc_smooth (n + 1) (s + 1) (d_ax + 2) (by dsimp [n]; omega)
        R_tilde φ_tilde hφ_tilde_surj rel_tilde hker_φ_tilde (idx_c c) (hidx_c_inj c)
        R_loc (D_poly c) rfl (Δ c) rfl

  
  have h_pb_poly : ∀ (Z_sch P₁_sch : AlgebraicGeometry.Scheme.{u})
      (p_Z : Z_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      (p_P : P₁_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      (U_Z : Z_sch.Opens), AlgebraicGeometry.IsAffineOpen U_Z →
      ∀ (κ_A : k →+* ↑(Z_sch.presheaf.obj (Opposite.op U_Z))),
      U_Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_A) = U_Z.ι ≫ p_Z →
      ∀ (D_b : P₁_sch.Opens), AlgebraicGeometry.IsAffineOpen D_b →
      ∀ (e_Db_cat : CommRingCat.of (Polynomial k) ≅ P₁_sch.presheaf.obj (Opposite.op D_b)),
      D_b.toSpecΓ ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k) ≫ e_Db_cat.hom) =
        D_b.ι ≫ p_P →
      let Q₁_pb := CategoryTheory.Limits.pullback p_Z p_P
      let fst_Z := CategoryTheory.Limits.pullback.fst p_Z p_P
      let snd_P := CategoryTheory.Limits.pullback.snd p_Z p_P
      let W_pb : Q₁_pb.Opens :=
        (TopologicalSpace.Opens.map fst_Z.base).obj U_Z ⊓
          (TopologicalSpace.Opens.map snd_P.base).obj D_b
      let A := ↑(Z_sch.presheaf.obj (Opposite.op U_Z))
      ∃ (_ : AlgebraicGeometry.IsAffineOpen W_pb)
        (e_pb : Polynomial A ≃+* ↑(Q₁_pb.presheaf.obj (Opposite.op W_pb))),
        (∀ r : A, e_pb (Polynomial.C r) = (fst_Z.appLE U_Z W_pb inf_le_left).hom r) ∧
        (snd_P.appLE D_b W_pb inf_le_right).hom (e_Db_cat.hom.hom Polynomial.X) =
          e_pb Polynomial.X := by
    intro Z_sch P₁_sch p_Z p_P U_Z hAffUZ κ_A hk_A D_b hAffDb e_Db_cat hk_Db
      Q₁_pb fst_Z snd_P W_pb A
    let iso_Db_hom : D_b.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
      D_b.toSpecΓ ≫ AlgebraicGeometry.Spec.map e_Db_cat.hom
    let iso_Db_inv : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ D_b.toScheme :=
      AlgebraicGeometry.Spec.map e_Db_cat.inv ≫ hAffDb.isoSpec.inv
    have h_Db_hom_inv : iso_Db_hom ≫ iso_Db_inv = 𝟙 D_b.toScheme := by
      dsimp only [iso_Db_hom, iso_Db_inv]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
        ← AlgebraicGeometry.Spec.map_comp, e_Db_cat.inv_hom_id, AlgebraicGeometry.Spec.map_id,
        CategoryTheory.Category.id_comp, ← hAffDb.isoSpec_hom, hAffDb.isoSpec.hom_inv_id]
    have h_Db_inv_hom : iso_Db_inv ≫ iso_Db_hom = 𝟙 _ := by
      dsimp only [iso_Db_hom, iso_Db_inv]
      rw [← hAffDb.isoSpec_hom, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc hAffDb.isoSpec.inv, hAffDb.isoSpec.inv_hom_id,
        CategoryTheory.Category.id_comp, ← AlgebraicGeometry.Spec.map_comp,
        e_Db_cat.hom_inv_id, AlgebraicGeometry.Spec.map_id]
    have hk_Db' : iso_Db_hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) =
        D_b.ι ≫ p_P := by
      dsimp only [iso_Db_hom]
      rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      exact hk_Db
    let f₁ : W_pb.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of A) :=
      fst_Z.resLE U_Z W_pb inf_le_left ≫ U_Z.toSpecΓ
    let f₂ : W_pb.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
      snd_P.resLE D_b W_pb inf_le_right ≫ iso_Db_hom
    have hw_W : f₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_A) =
        f₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      dsimp only [f₁, f₂]
      rw [CategoryTheory.Category.assoc, hk_A, CategoryTheory.Category.assoc, hk_Db',
        ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
        ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
        CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc]
    have hUZ_hom_inv : U_Z.toSpecΓ ≫ hAffUZ.isoSpec.inv = 𝟙 U_Z.toScheme := by
      rw [← hAffUZ.isoSpec_hom]
      exact hAffUZ.isoSpec.hom_inv_id
    have h_mono_Db : CategoryTheory.Mono iso_Db_inv :=
      ⟨fun g₁ g₂ h => by
        have := congrArg (· ≫ iso_Db_hom) h
        simpa only [CategoryTheory.Category.assoc, h_Db_inv_hom,
          CategoryTheory.Category.comp_id] using this⟩
    have h_cone_lift : ∀ s : CategoryTheory.Limits.PullbackCone
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_A))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)),
        ∃ l : s.pt ⟶ W_pb.toScheme, l ≫ f₁ = s.fst ∧ l ≫ f₂ = s.snd := by
      intro s
      let q_Q₁ : s.pt ⟶ Q₁_pb :=
        CategoryTheory.Limits.pullback.lift
          (s.fst ≫ hAffUZ.isoSpec.inv ≫ U_Z.ι)
          (s.snd ≫ iso_Db_inv ≫ D_b.ι)
          (by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← hk_A,
              ← hAffUZ.isoSpec_hom, ← CategoryTheory.Category.assoc hAffUZ.isoSpec.inv,
              hAffUZ.isoSpec.inv_hom_id, CategoryTheory.Category.id_comp,
              ← CategoryTheory.Category.assoc, s.condition,
              CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← hk_Db',
              ← CategoryTheory.Category.assoc iso_Db_inv, h_Db_inv_hom,
              CategoryTheory.Category.id_comp])
      have h_range : Set.range q_Q₁.base ⊆ Set.range W_pb.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨t, rfl⟩
        refine ⟨?_, ?_⟩
        · change (q_Q₁ ≫ fst_Z).base t ∈ U_Z
          rw [CategoryTheory.Limits.pullback.lift_fst]
          exact ((s.fst ≫ hAffUZ.isoSpec.inv).base t).2
        · change (q_Q₁ ≫ snd_P).base t ∈ D_b
          rw [CategoryTheory.Limits.pullback.lift_snd]
          exact ((s.snd ≫ iso_Db_inv).base t).2
      let l : s.pt ⟶ W_pb.toScheme := AlgebraicGeometry.IsOpenImmersion.lift W_pb.ι q_Q₁ h_range
      have hl_fac : l ≫ W_pb.ι = q_Q₁ := AlgebraicGeometry.IsOpenImmersion.lift_fac W_pb.ι q_Q₁ h_range
      refine ⟨l, ?_, ?_⟩
      · rw [← CategoryTheory.cancel_mono hAffUZ.isoSpec.inv]
        dsimp only [f₁]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          hUZ_hom_inv, CategoryTheory.Category.comp_id,
          ← CategoryTheory.cancel_mono U_Z.ι, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, ← CategoryTheory.Category.assoc,
          hl_fac]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      · rw [← CategoryTheory.cancel_mono iso_Db_inv]
        dsimp only [f₂]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          h_Db_hom_inv, CategoryTheory.Category.comp_id,
          ← CategoryTheory.cancel_mono D_b.ι, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, ← CategoryTheory.Category.assoc,
          hl_fac]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_W : CategoryTheory.IsPullback f₁ f₂
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_A))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) := by
      refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hw_W
          (fun s => Classical.choose (h_cone_lift s))
          (fun s => (Classical.choose_spec (h_cone_lift s)).1)
          (fun s => (Classical.choose_spec (h_cone_lift s)).2)
          (fun s m hm₁ hm₂ => ?_))
      have hl₁ := (Classical.choose_spec (h_cone_lift s)).1
      have hl₂ := (Classical.choose_spec (h_cone_lift s)).2
      rw [← CategoryTheory.cancel_mono W_pb.ι]
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (m ≫ W_pb.ι) ≫ fst_Z = (Classical.choose (h_cone_lift s) ≫ W_pb.ι) ≫ fst_Z
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Scheme.Hom.resLE_comp_ι fst_Z inf_le_left,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc]
        have h_eq := congrArg (· ≫ hAffUZ.isoSpec.inv ≫ U_Z.ι) (hm₁.trans hl₁.symm)
        dsimp only [f₁] at h_eq
        simpa only [CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc U_Z.toSpecΓ, hUZ_hom_inv,
          CategoryTheory.Category.id_comp] using h_eq
      · change (m ≫ W_pb.ι) ≫ snd_P = (Classical.choose (h_cone_lift s) ≫ W_pb.ι) ≫ snd_P
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Scheme.Hom.resLE_comp_ι snd_P inf_le_right,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc]
        have h_eq := congrArg (· ≫ iso_Db_inv ≫ D_b.ι) (hm₂.trans hl₂.symm)
        dsimp only [f₂] at h_eq
        simpa only [CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc iso_Db_hom, h_Db_hom_inv,
          CategoryTheory.Category.id_comp] using h_eq
    have hcomm_ring : CommRingCat.ofHom κ_A ≫ CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A) =
        CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k) ≫
          CommRingCat.ofHom (Polynomial.mapRingHom κ_A) :=
      CommRingCat.hom_ext (RingHom.ext fun _ => (Polynomial.map_C κ_A).symm)
    have hPush : CategoryTheory.IsPushout
        (CommRingCat.ofHom κ_A)
        (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
        (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A))
        (CommRingCat.ofHom (Polynomial.mapRingHom κ_A)) := by
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_ring
          (fun s => CommRingCat.ofHom (Polynomial.eval₂RingHom s.inl.hom (s.inr.hom Polynomial.X)))
          (fun s => CommRingCat.hom_ext (RingHom.ext fun _ => Polynomial.eval₂_C _ _))
          (fun s => ?_) (fun s m hm₁ hm₂ => ?_))
      · apply CommRingCat.hom_ext; apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun c => ?_
          change Polynomial.eval₂ s.inl.hom (s.inr.hom Polynomial.X)
            (Polynomial.map κ_A (Polynomial.C c)) = s.inr.hom (Polynomial.C c)
          rw [Polynomial.map_C, Polynomial.eval₂_C]
          exact ConcreteCategory.congr_hom s.condition c
        · change Polynomial.eval₂ s.inl.hom (s.inr.hom Polynomial.X)
            (Polynomial.map κ_A Polynomial.X) = s.inr.hom Polynomial.X
          rw [Polynomial.map_X, Polynomial.eval₂_X]
      · apply CommRingCat.hom_ext; apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun a => ?_
          simpa using ConcreteCategory.congr_hom hm₁ a
        · simpa using ConcreteCategory.congr_hom hm₂ Polynomial.X
    have hPb_Spec := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush
    let iso_W : W_pb.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A)) :=
      CategoryTheory.IsPullback.isoIsPullback _ _ hPb_W hPb_Spec
    have h_isoW_fst : iso_W.hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A)) = f₁ :=
      CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPb_W hPb_Spec
    have h_isoW_snd : iso_W.hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom κ_A)) = f₂ :=
      CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPb_W hPb_Spec
