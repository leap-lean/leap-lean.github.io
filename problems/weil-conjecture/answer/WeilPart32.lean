    obtain ⟨C₁, ι₁, ⟨hInt₁, hProp₁, hCl₁, hRange₁, hDim₁⟩, hChart₁, hStalk₁⟩ :=
      hVanSub z₀ hz₀_cl Z₁ hClZ₁ hIrrZ₁ hz₀_Z₁ hNontrivZ₁
    obtain ⟨C₂, ι₂, ⟨hInt₂, hProp₂, hCl₂, hRange₂, hDim₂⟩, hChart₂, hStalk₂⟩ :=
      hVanSub z₀ hz₀_cl Z₂ hClZ₂ hIrrZ₂ hz₀_Z₂ hNontrivZ₂
    have hRangeUnion : Set.range ι_CL.left.base = Set.range ι₁.left.base ∪ Set.range ι₂.left.base := by
      rw [hRange₁, hRange₂]
      change Set.range ι_CL.left.base = (ι_CL.left.base '' K₁) ∪ (ι_CL.left.base '' K₂)
      rw [← Set.image_union, hUnionK, Set.image_univ]
    have hRangeInter : Set.range ι₁.left.base ∩ Set.range ι₂.left.base = {z₀} := by
      rw [hRange₁, hRange₂]
      change (ι_CL.left.base '' K₁) ∩ (ι_CL.left.base '' K₂) = {z₀}
      rw [← Set.image_inter hEmb_CL.injective, hInterK, Set.image_singleton]
    let P_VZ1 : Ideal A_Z := RingHom.ker (ι₁.left.app V_Z).hom
    let P_VZ2 : Ideal A_Z := RingHom.ker (ι₂.left.app V_Z).hom
    obtain ⟨_, hKerVZ1, _, hAtzVZ1⟩ := hChart₁ V_Z hAffZ
    obtain ⟨_, hKerVZ2, _, hAtzVZ2⟩ := hChart₂ V_Z hAffZ
    obtain ⟨_, hPrimeVZ1, hLtVZ1⟩ := hAtzVZ1 hz₀_Z
    obtain ⟨_, hPrimeVZ2, hLtVZ2⟩ := hAtzVZ2 hz₀_Z
    have hNotLe_VZ12 : ¬(P_VZ1 ≤ P_VZ2) := by
      dsimp only [P_VZ1, P_VZ2]
      rw [hKerVZ1, hKerVZ2]
      exact hCompNotLe K₁ K₂ hK₁_mem hK₂_mem hK12_ne
    have hNotLe_VZ21 : ¬(P_VZ2 ≤ P_VZ1) := by
      dsimp only [P_VZ1, P_VZ2]
      rw [hKerVZ1, hKerVZ2]
      exact hCompNotLe K₂ K₁ hK₂_mem hK₁_mem (Ne.symm hK12_ne)
    have hℓ_PVZ1 : ℓ₀ ∈ P_VZ1 := by
      dsimp only [P_VZ1]; rwa [hKerVZ1]
    have hℓ_PVZ2 : ℓ₀ ∈ P_VZ2 := by
      dsimp only [P_VZ2]; rwa [hKerVZ2]
    refine ⟨z₀, C₁, C₂, ι₁, ι₂, hz₀_cl, hInt₁, hInt₂, hProp₁, hProp₂, hCl₁, hCl₂,
      hRangeUnion, hRangeInter, hDim₁, hDim₂, ?_⟩
    intro H hH U hAffU hU_sub
    let A_U : Type u := ↑(Z_bar.left.presheaf.obj (Opposite.op U))
    let τ_U : A_U :=
      (ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 H) U hU_sub).hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜 H).hom
          (HomogeneousLocalization.Away.mk 𝒜 hH 3 F_L hFL))
    let P₁ : Ideal A_U := RingHom.ker (ι₁.left.app U).hom
    let P₂ : Ideal A_U := RingHom.ker (ι₂.left.app U).hom
    obtain ⟨hTauNe, hTauMemRange, hStalkQuot, hTauUnitZ⟩ := hChartProj H hH U hAffU hU_sub
    obtain ⟨hSurj₁, hKerU₁, hMemU₁, hAtzU₁⟩ := hChart₁ U hAffU
    obtain ⟨hSurj₂, hKerU₂, hMemU₂, hAtzU₂⟩ := hChart₂ U hAffU
    have hTau_P₁ : τ_U ∈ P₁ := by
      dsimp only [P₁]
      rw [hKerU₁, PrimeSpectrum.mem_vanishingIdeal]
      intro pt hpt
      have hpt_in : hAffU.fromSpec.base pt ∈ Set.range ι_CL.left.base := by
        rw [hRangeUnion, hRange₁]
        exact Or.inl hpt
      exact (@hTauMemRange pt.asIdeal pt.isPrime).mpr hpt_in
    have hTau_P₂ : τ_U ∈ P₂ := by
      dsimp only [P₂]
      rw [hKerU₂, PrimeSpectrum.mem_vanishingIdeal]
      intro pt hpt
      have hpt_in : hAffU.fromSpec.base pt ∈ Set.range ι_CL.left.base := by
        rw [hRangeUnion, hRange₂]
        exact Or.inr hpt
      exact (@hTauMemRange pt.asIdeal pt.isPrime).mpr hpt_in
    refine ⟨⟨hSurj₁, hSurj₂, hTau_P₁, hTau_P₂, hTauNe⟩, ?_, ?_⟩
    · intro q hq hq_ne
      let R_q := Localization.AtPrime q
      let q_pt : ↥(AlgebraicGeometry.Spec (Z_bar.left.presheaf.obj (Opposite.op U))) := ⟨q, hq⟩
      let y : Z_bar.left := hAffU.fromSpec.base q_pt
      have hy_U : y ∈ U := by
        have hmem : y ∈ Set.range hAffU.fromSpec.base := ⟨q_pt, rfl⟩
        rwa [hAffU.range_fromSpec] at hmem
      have hPrimeIdeal_y : (hAffU.primeIdealOf ⟨y, hy_U⟩).asIdeal = q := by
        have hpt_eq : hAffU.primeIdealOf ⟨y, hy_U⟩ = q_pt := by
          apply hAffU.fromSpec.isOpenEmbedding.injective
          exact IsAffineOpen.fromSpec_primeIdealOf hAffU ⟨y, hy_U⟩
        exact congrArg PrimeSpectrum.asIdeal hpt_eq
      have hy_ne_z₀ : y ≠ z₀ := by
        intro hyz₀
        have hz₀_in_U : z₀ ∈ U := hyz₀ ▸ hy_U
        have hsub_eq : (⟨z₀, hz₀_in_U⟩ : ↥U) = ⟨y, hy_U⟩ := Subtype.ext hyz₀.symm
        exact hq_ne hz₀_in_U (by rw [hsub_eq, hPrimeIdeal_y])
      have hNotBoth : ¬(P₁ ≤ q ∧ P₂ ≤ q) := by
        rintro ⟨hle1, hle2⟩
        have hy1 : y ∈ Z₁ := (@hMemU₁ q hq).mp hle1
        have hy2 : y ∈ Z₂ := (@hMemU₂ q hq).mp hle2
        have hy_inter : y ∈ Set.range ι₁.left.base ∩ Set.range ι₂.left.base := by
          rw [hRange₁, hRange₂]
          exact ⟨hy1, hy2⟩
        rw [hRangeInter, Set.mem_singleton_iff] at hy_inter
        exact hy_ne_z₀ hy_inter
      have hPrinHelper : ∀ (P_a P_b : Ideal A_U) (Z_a Z_b : Set Z_bar.left),
          Z_a ∪ Z_b = Set.range ι_CL.left.base →
          (∀ (Q : Ideal A_U) [Q.IsPrime], P_a ≤ Q ↔ hAffU.fromSpec.base ⟨Q, ‹_›⟩ ∈ Z_a) →
          (∀ (Q : Ideal A_U) [Q.IsPrime], P_b ≤ Q ↔ hAffU.fromSpec.base ⟨Q, ‹_›⟩ ∈ Z_b) →
          τ_U ∈ P_a → P_a ≤ q → ¬(P_b ≤ q) →
          Ideal.map (algebraMap A_U R_q) P_a = Ideal.span {algebraMap A_U R_q τ_U} := by
        intro P_a P_b Z_a Z_b hUnion_ab hMem_a hMem_b hTau_a hPa_q hNot_Pb_q
        have hy_Za : y ∈ Z_a := (@hMem_a q hq).mp hPa_q
        have hy_CL : y ∈ Set.range ι_CL.left.base := hUnion_ab ▸ Or.inl hy_Za
        obtain ⟨x_y, hx_y_eq⟩ := hy_CL
        have hx_y_ne : x_y ≠ x₀ := fun hEq => hy_ne_z₀ (hx_y_eq.symm.trans (congrArg ι_CL.left.base hEq))
        have hDom_xy : IsDomain ↑(C_L.left.presheaf.stalk x_y) :=
          (hSmooth1D x_y (Or.inr (hSmAway x_y hx_y_ne))).1
        have hy_U' : ι_CL.left.base x_y ∈ U := hx_y_eq.symm ▸ hy_U
        obtain ⟨eqv_stalk⟩ := hStalkQuot x_y hy_U'
        have hq_xy_eq : (hAffU.primeIdealOf ⟨ι_CL.left.base x_y, hy_U'⟩).asIdeal = q := by
          have hsub : (⟨ι_CL.left.base x_y, hy_U'⟩ : ↥U) = ⟨y, hy_U⟩ := Subtype.ext hx_y_eq
          rw [hsub]
          exact hPrimeIdeal_y
        have hDom_quot : IsDomain (R_q ⧸ Ideal.span {algebraMap A_U R_q τ_U}) := by
          let q_xy := (hAffU.primeIdealOf ⟨ι_CL.left.base x_y, hy_U'⟩).asIdeal
          have hDom_qxy : IsDomain (Localization.AtPrime q_xy ⧸
              Ideal.span {algebraMap A_U (Localization.AtPrime q_xy) τ_U}) :=
            Function.Injective.isDomain eqv_stalk.toRingHom eqv_stalk.injective
          have htr : ∀ (Q : Ideal A_U) [Q.IsPrime], Q = q →
              IsDomain (Localization.AtPrime Q ⧸ Ideal.span {algebraMap A_U (Localization.AtPrime Q) τ_U}) →
              IsDomain (R_q ⧸ Ideal.span {algebraMap A_U R_q τ_U}) := by
            rintro Q hQ rfl hD
            have hinst : hQ = hq := Subsingleton.elim _ _
            subst hinst
            exact hD
          exact htr q_xy hq_xy_eq hDom_qxy
        let J : Ideal R_q := Ideal.span {algebraMap A_U R_q τ_U}
        have hJ_prime : J.IsPrime := (Ideal.Quotient.isDomain_iff_prime J).mp hDom_quot
        let Q₀ : Ideal A_U := J.comap (algebraMap A_U R_q)
        have hQ₀_prime : Q₀.IsPrime := hJ_prime.comap (algebraMap A_U R_q)
        have hQ₀_le_q : Q₀ ≤ q := by
          intro a ha
          by_contra ha_not
          have hu : IsUnit (algebraMap A_U R_q a) :=
            IsLocalization.map_units R_q (⟨a, ha_not⟩ : q.primeCompl)
          exact hJ_prime.ne_top (Ideal.eq_top_of_isUnit_mem J ha hu)
        have hTau_Q₀ : τ_U ∈ Q₀ := Ideal.subset_span (Set.mem_singleton _)
        have hQ₀_range : hAffU.fromSpec.base ⟨Q₀, hQ₀_prime⟩ ∈ Set.range ι_CL.left.base :=
          (@hTauMemRange Q₀ hQ₀_prime).mp hTau_Q₀
        rw [← hUnion_ab] at hQ₀_range
        have hPa_le_Q₀ : P_a ≤ Q₀ := by
          rcases hQ₀_range with hInA | hInB
          · exact (@hMem_a Q₀ hQ₀_prime).mpr hInA
          · exact False.elim (hNot_Pb_q (((@hMem_b Q₀ hQ₀_prime).mpr hInB).trans hQ₀_le_q))
        apply le_antisymm
        · calc Ideal.map (algebraMap A_U R_q) P_a
            _ ≤ Ideal.map (algebraMap A_U R_q) Q₀ := Ideal.map_mono hPa_le_Q₀
            _ = J := IsLocalization.map_under q.primeCompl R_q J
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
          exact Ideal.mem_map_of_mem (algebraMap A_U R_q) hTau_a
      refine ⟨hNotBoth, ?_, ?_, ?_⟩
      · intro hP₁_q
        have hNot_P₂_q : ¬(P₂ ≤ q) := fun hP₂_q => hNotBoth ⟨hP₁_q, hP₂_q⟩
        have hUnion12_eq : Z₁ ∪ Z₂ = Set.range ι_CL.left.base := by
          rw [hRangeUnion, hRange₁, hRange₂]
        exact hPrinHelper P₁ P₂ Z₁ Z₂ hUnion12_eq hMemU₁ hMemU₂ hTau_P₁ hP₁_q hNot_P₂_q
      · intro hP₂_q
        have hNot_P₁_q : ¬(P₁ ≤ q) := fun hP₁_q => hNotBoth ⟨hP₁_q, hP₂_q⟩
        have hUnion21_eq : Z₂ ∪ Z₁ = Set.range ι_CL.left.base := by
          rw [Set.union_comm, hRangeUnion, hRange₁, hRange₂]
        exact hPrinHelper P₂ P₁ Z₂ Z₁ hUnion21_eq hMemU₂ hMemU₁ hTau_P₂ hP₂_q hNot_P₁_q
      · intro hNot₁ hNot₂
        have hy_not_CL : y ∉ Set.range ι_CL.left.base := by
          rw [hRangeUnion, hRange₁, hRange₂, Set.mem_union]
          rintro (hy1 | hy2)
          · exact hNot₁ ((@hMemU₁ q hq).mpr hy1)
          · exact hNot₂ ((@hMemU₂ q hq).mpr hy2)
        have hTau_not_q : τ_U ∉ q := fun hmem => hy_not_CL ((@hTauMemRange q hq).mp hmem)
        exact IsLocalization.map_units R_q (⟨τ_U, hTau_not_q⟩ : q.primeCompl)
    · intro hz₀_U
      let p_z₀ : Ideal A_U := (hAffU.primeIdealOf ⟨z₀, hz₀_U⟩).asIdeal
      obtain ⟨hpz₀_max, hP₁_prime, hP₁_lt⟩ := hAtzU₁ hz₀_U
      obtain ⟨_, hP₂_prime, hP₂_lt⟩ := hAtzU₂ hz₀_U
      have hStalkEq₁ := hStalk₁ U V_Z hAffU hAffZ hz₀_U hz₀_Z
      have hStalkEq₂ := hStalk₂ U V_Z hAffU hAffZ hz₀_U hz₀_Z
      have hUnitStalk := hTauUnitZ μ₀ hXμ₀ V_Z hAffZ hVZ_μ₀ z₀ hz₀_U hz₀_Z
      refine ⟨hpz₀_max, hP₁_prime, hP₂_prime, hP₁_lt.le, hP₂_lt.le, ?_, ?_⟩
      · intro s g c t_diff j hs ht hsg
        exact @hPoleTransfer P_VZ1 P_VZ2 hPrimeVZ1 hPrimeVZ2 hLtVZ1 hLtVZ2
          hNotLe_VZ12 hNotLe_VZ21 hℓ_PVZ1 hℓ_PVZ2
          U hAffU hz₀_U P₁ hP₁_prime hP₁_lt.le hStalkEq₁ τ_U hUnitStalk
          s g c t_diff j hs ht hsg
      · intro s g c t_diff j hs ht hsg
        exact @hPoleTransfer P_VZ2 P_VZ1 hPrimeVZ2 hPrimeVZ1 hLtVZ2 hLtVZ1
          hNotLe_VZ21 hNotLe_VZ12 hℓ_PVZ2 hℓ_PVZ1
          U hAffU hz₀_U P₂ hP₂_prime hP₂_lt.le hStalkEq₂ τ_U hUnitStalk
          s g c t_diff j hs ht hsg

theorem weil_proj_chart_overlap_identities_and_closedImmersion_ker (k : Type u) [Field k] (N : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_X : X ⟶ weilProjectiveSpaceOver k N)
    (hCl_X : AlgebraicGeometry.IsClosedImmersion ι_X.left) :
    let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
    ((∀ (m : ℕ), 0 < m → ∀ (F : MvPolynomial (Fin (N + 1)) k), F ∈ 𝒜_N m →
        AlgebraicGeometry.IsAffineOpen
          ((TopologicalSpace.Opens.map ι_X.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_N F))) ∧
      (∀ (m n : ℕ), 0 < m → 0 < n →
        ∀ (F : MvPolynomial (Fin (N + 1)) k) (hF : F ∈ 𝒜_N m)
          (G : MvPolynomial (Fin (N + 1)) k) (hG : G ∈ 𝒜_N (n • m))
          (W_F : X.left.Opens)
          (hWF_sub : W_F ≤ (TopologicalSpace.Opens.map ι_X.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_N F)),
        W_F = (TopologicalSpace.Opens.map ι_X.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N F) →
        let s : ↑(X.left.presheaf.obj (Opposite.op W_F)) :=
          (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N F) W_F hWF_sub).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_N F).hom
              (HomogeneousLocalization.Away.mk 𝒜_N hF n G hG))
        X.left.basicOpen s =
          W_F ⊓ (TopologicalSpace.Opens.map ι_X.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_N G) ∧
        ∀ (hAff : AlgebraicGeometry.IsAffineOpen W_F) (x : X.left) (hx : x ∈ W_F),
          s ∈ (hAff.primeIdealOf ⟨x, hx⟩).asIdeal ↔
            ι_X.left.base x ∈ weilProjHyperplaneSet k N G)) ∧
    (∀ (H₀ H₁ H₂ F_L : MvPolynomial (Fin (N + 1)) k)
        (hH₀ : H₀ ∈ 𝒜_N 1) (hH₁ : H₁ ∈ 𝒜_N 1) (hH₂ : H₂ ∈ 𝒜_N 1) (hFL : F_L ∈ 𝒜_N 3)
        (U₂ U₀ : X.left.Opens)
        (hU₂_sub : U₂ ≤ (TopologicalSpace.Opens.map ι_X.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂))
        (hU₀_sub : U₀ ≤ (TopologicalSpace.Opens.map ι_X.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₀)),
      U₂ = (TopologicalSpace.Opens.map ι_X.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) →
      U₀ = (TopologicalSpace.Opens.map ι_X.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₀) →
      ∀ (h_inf_r : U₀ ⊓ U₂ ≤ U₂) (h_inf_l : U₀ ⊓ U₂ ≤ U₀),
      let u₀ : ↑(X.left.presheaf.obj (Opposite.op U₂)) :=
        (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) U₂ hU₂_sub).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₂).hom
            (HomogeneousLocalization.Away.mk 𝒜_N hH₂ 1 H₀ hH₀))
      let u₁ : ↑(X.left.presheaf.obj (Opposite.op U₂)) :=
        (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) U₂ hU₂_sub).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₂).hom
            (HomogeneousLocalization.Away.mk 𝒜_N hH₂ 1 H₁ hH₁))
      let τ₂ : ↑(X.left.presheaf.obj (Opposite.op U₂)) :=
        (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) U₂ hU₂_sub).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₂).hom
            (HomogeneousLocalization.Away.mk 𝒜_N hH₂ 3 F_L hFL))
      let S_Z : ↑(X.left.presheaf.obj (Opposite.op U₀)) :=
        (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₀) U₀ hU₀_sub).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₀).hom
            (HomogeneousLocalization.Away.mk 𝒜_N hH₀ 1 H₂ hH₂))
      let v₁ : ↑(X.left.presheaf.obj (Opposite.op U₀)) :=
        (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₀) U₀ hU₀_sub).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₀).hom
            (HomogeneousLocalization.Away.mk 𝒜_N hH₀ 1 H₁ hH₁))
      let τ₀ : ↑(X.left.presheaf.obj (Opposite.op U₀)) :=
        (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₀) U₀ hU₀_sub).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₀).hom
            (HomogeneousLocalization.Away.mk 𝒜_N hH₀ 3 F_L hFL))
      let res₂ : ↑(X.left.presheaf.obj (Opposite.op U₂)) →+*
          ↑(X.left.presheaf.obj (Opposite.op (U₀ ⊓ U₂))) :=
        (X.left.presheaf.map (CategoryTheory.homOfLE h_inf_r).op).hom
      let res₀ : ↑(X.left.presheaf.obj (Opposite.op U₀)) →+*
          ↑(X.left.presheaf.obj (Opposite.op (U₀ ⊓ U₂))) :=
        (X.left.presheaf.map (CategoryTheory.homOfLE h_inf_l).op).hom
      (res₀ S_Z * res₂ u₀ = 1 ∧
        res₀ S_Z * res₂ u₁ = res₀ v₁ ∧
        res₀ S_Z ^ 3 * res₂ τ₂ = res₀ τ₀) ∧
      (∀ (hAff₂ : AlgebraicGeometry.IsAffineOpen U₂)
          (_ : AlgebraicGeometry.IsAffineOpen U₀)
          (C : AlgebraicGeometry.Scheme.{u}) (j : C ⟶ X.left),
        AlgebraicGeometry.IsClosedImmersion j →
        Ideal.map res₂ (RingHom.ker (j.app U₂).hom) =
          Ideal.map res₀ (RingHom.ker (j.app U₀).hom) ∧
        ∀ (y : C) (hy : j.base y ∈ U₂),
          RingHom.ker (j.app U₂).hom ≤ (hAff₂.primeIdealOf ⟨j.base y, hy⟩).asIdeal)) ∧
    (∀ (H₁ H₂ F_L : MvPolynomial (Fin (N + 1)) k)
        (hH₁ : H₁ ∈ 𝒜_N 1) (hH₂ : H₂ ∈ 𝒜_N 1) (hFL : F_L ∈ 𝒜_N 3)
        (hH1_3 : H₁ ^ 3 ∈ 𝒜_N 3) (hH2_3 : H₂ ^ 3 ∈ 𝒜_N 3),
      let W₁ : X.left.Opens :=
        (TopologicalSpace.Opens.map ι_X.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₁)
      let W₂ : X.left.Opens :=
        (TopologicalSpace.Opens.map ι_X.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂)
      let W_F : X.left.Opens :=
        (TopologicalSpace.Opens.map ι_X.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N F_L)
      let T₁ : ↑(X.left.presheaf.obj (Opposite.op W₁)) :=
        (ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₁) W₁ le_rfl).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₁).hom
            (HomogeneousLocalization.Away.mk 𝒜_N hH₁ 3 F_L hFL))
      let h₁₂ : ↑(X.left.presheaf.obj (Opposite.op W₁)) :=
