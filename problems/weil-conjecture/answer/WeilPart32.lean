            have hterm2 : (P_tr r₀ - L_tr r₀) *
                MvPolynomial.aeval L_tr (MvPolynomial.monomial s' (1 : k)) ∈ 𝔪_T ^ (m + 1 + 1 + 1) := by
              rw [show m + 1 + 1 + 1 = 2 + (m + 1) from by omega, pow_add]
              exact Ideal.mul_mem_mul (hPtr_sub_L r₀) hv_mem
            exact Ideal.add_mem _ hterm1 hterm2
