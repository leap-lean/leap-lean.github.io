    exact ⟨L, hL, hL_ne, hL, α₀, hXα₀, V, hAffV, hz₀_V, hVα₀, ψ_V, Q,
      hEt, hComm, hCenter, hQ_hom, hQ_det, hℓ_mod⟩

  
  have hV2 : ∀ (z₁ z₂ : Z_bar.left),
      IsClosed ({z₁} : Set Z_bar.left) → IsClosed ({z₂} : Set Z_bar.left) → z₁ ≠ z₂ →
      ∀ (α₁ α₂ : Fin (M + 1))
        (hX₁ : (MvPolynomial.X α₁ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
