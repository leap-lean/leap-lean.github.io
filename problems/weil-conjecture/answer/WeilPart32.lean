      have hm_eq : m = nd.deg := by
        have h_eval : MvPolynomial.eval (fun _ => (1 : k)) (MvPolynomial.X b ^ m) = 1 := by simp
        have h_ne : (MvPolynomial.X b : MvPolynomial (Fin 2) k) ^ m ≠ 0 := by
          intro h0; rw [h0, map_zero] at h_eval; exact zero_ne_one h_eval
        obtain ⟨d₀, hd₀⟩ := MvPolynomial.support_nonempty.mpr h_ne
        have hd₀_ne : (MvPolynomial.X b ^ m : MvPolynomial (Fin 2) k).coeff d₀ ≠ 0 :=
