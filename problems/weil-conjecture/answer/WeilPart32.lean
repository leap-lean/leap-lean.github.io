        letI : Algebra ↑(Z_bar.left.presheaf.obj (Opposite.op U_sm)) A := res_g₁.toAlgebra
        haveI : IsLocalization.Away g₁ A := hAffUsm.isLocalization_basicOpen g₁
        have hLoc0 : RingHom.IsStandardSmoothOfRelativeDimension 0 res_g₁ :=
          RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway g₁
        have hSm_base : RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 2)
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              Z_bar.hom.appLE ⊤ U_sm e_sm).hom) := by
          exact (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_left_isIso
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (Z_bar.hom.appLE ⊤ U_sm e_sm)).mpr hSm_Usm
        have hComp : κ_Z = res_g₁.comp
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              Z_bar.hom.appLE ⊤ U_sm e_sm).hom) := by
          have h1 : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              (Z_bar.hom.appLE ⊤ U_sm e_sm ≫
                Z_bar.left.presheaf.map (CategoryTheory.homOfLE hUZ_sm).op) =
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                Z_bar.hom.appLE ⊤ U_Z le_top := by
            rw [AlgebraicGeometry.Scheme.Hom.appLE_map]
          ext c
          exact congrArg (fun f : CommRingCat.of k ⟶ _ => f.hom c) h1.symm
        rw [hComp, ← Nat.zero_add (2 * m + 2)]
        exact hLoc0.comp hSm_base
      let ℓ_r : Fin 3 → A := fun r =>
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
          ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) U_Z hUZ_α).hom
          (HomogeneousLocalization.mk ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
      have hUnit_r₀ : IsUnit (ℓ_r r₀) := by
        obtain ⟨_, _, hChart0⟩ := hCharts 0
        obtain ⟨_, _, hVan0, _, _, _, _, _⟩ := hChart0 α hXα U_Z hAffUZ hUZ_α
        refine hIsUnit_of_forall_prime (ℓ_r r₀) fun p hp => ?_
        let x : ↥U_Z := hAffUZ.isoSpec.inv.base p
        have hx_p : hAffUZ.primeIdealOf x = p := by
          change (hAffUZ.isoSpec.inv ≫ hAffUZ.isoSpec.hom).base p = p
