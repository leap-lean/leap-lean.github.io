              MvPolynomial.C (w 0) + ∑ j, MvPolynomial.C (v_comb j) * MvPolynomial.X j := by
            simp only [v_comb, map_zero, zero_mul, Finset.sum_const_zero, add_zero, zero_add,
              map_one, mul_one, mul_zero, map_add, map_mul, Finset.mul_sum]
            rw [add_assoc, ← Finset.sum_add_distrib]
            congr 1
            refine Finset.sum_congr rfl fun j _ => ?_
            ring
          calc ψ₁ (MvPolynomial.C (w 0)) * J₀ + ψ₁ (MvPolynomial.C (w 1)) * J₁ +
                ψ₁ (MvPolynomial.C (w 2)) * J₂ + ψ₁ (MvPolynomial.C (w 3)) * J₃
            _ = (ψ₁ (MvPolynomial.C (w 0)) * ℓ₁_0 + ψ₁ (MvPolynomial.C (w 1)) * ℓ₁_1 +
                  ψ₁ (MvPolynomial.C (w 2)) * ℓ₁_2 + ψ₁ (MvPolynomial.C (w 3)) * ℓ₁_3) -
                ψ₁ (MvPolynomial.C (w 0) * (MvPolynomial.C 1 + ∑ j, MvPolynomial.C (0 : k) * MvPolynomial.X j) +
                  MvPolynomial.C (w 1) * (MvPolynomial.C 0 + ∑ j, MvPolynomial.C (0 : k) * MvPolynomial.X j) +
                  MvPolynomial.C (w 2) * (MvPolynomial.C 0 + ∑ j, MvPolynomial.C (e₀_vec j) * MvPolynomial.X j) +
                  MvPolynomial.C (w 3) * (MvPolynomial.C 0 + ∑ j, MvPolynomial.C (e₁_vec j) * MvPolynomial.X j)) := by
              dsimp only [J₀, J₁, J₂, J₃]
              simp only [map_add, map_mul]
              ring
            _ = - ψ₁ (MvPolynomial.C (w 0) + ∑ j, MvPolynomial.C (v_comb j) * MvPolynomial.X j) := by
              rw [hcomb₁, hlin_eq, zero_sub]
        rw [heq_J, map_neg, Ideal.neg_mem_iff] at hsum_J
        exact hsum_J
      have hm₂_mem : algebraMap _ R₂
          (ψ₂ (MvPolynomial.C (w 1) + ∑ j : Fin (2 * m + 2), MvPolynomial.C (0 : k) * MvPolynomial.X j)) ∈
          𝔪₂ ^ 2 := by
        let J₀ := ℓ₂_0 - ψ₂ (MvPolynomial.C 0 + ∑ j : Fin (2 * m + 2), MvPolynomial.C (0 : k) * MvPolynomial.X j)
        let J₁ := ℓ₂_1 - ψ₂ (MvPolynomial.C 1 + ∑ j : Fin (2 * m + 2), MvPolynomial.C (0 : k) * MvPolynomial.X j)
        let J₂ := ℓ₂_2 - ψ₂ (MvPolynomial.C 0 + ∑ j : Fin (2 * m + 2), MvPolynomial.C (0 : k) * MvPolynomial.X j)
        let J₃ := ℓ₂_3 - ψ₂ (MvPolynomial.C 0 + ∑ j : Fin (2 * m + 2), MvPolynomial.C (0 : k) * MvPolynomial.X j)
        have hsum_J : algebraMap _ R₂
            (ψ₂ (MvPolynomial.C (w 0)) * J₀ + ψ₂ (MvPolynomial.C (w 1)) * J₁ +
              ψ₂ (MvPolynomial.C (w 2)) * J₂ + ψ₂ (MvPolynomial.C (w 3)) * J₃) ∈ 𝔪₂ ^ 2 := by
          simp only [map_add, map_mul]
          exact add_mem (add_mem (add_mem
            ((𝔪₂ ^ 2).mul_mem_left _ hJet₀_2)
            ((𝔪₂ ^ 2).mul_mem_left _ hJet₁_2))
            ((𝔪₂ ^ 2).mul_mem_left _ hJet₂_2))
            ((𝔪₂ ^ 2).mul_mem_left _ hJet₃_2)
        have heq_J : ψ₂ (MvPolynomial.C (w 0)) * J₀ + ψ₂ (MvPolynomial.C (w 1)) * J₁ +
            ψ₂ (MvPolynomial.C (w 2)) * J₂ + ψ₂ (MvPolynomial.C (w 3)) * J₃ =
            - ψ₂ (MvPolynomial.C (w 1) + ∑ j, MvPolynomial.C (0 : k) * MvPolynomial.X j) := by
          have hlin_eq : MvPolynomial.C (w 0) * (MvPolynomial.C 0 + ∑ j : Fin (2 * m + 2), MvPolynomial.C (0 : k) * MvPolynomial.X j) +
              MvPolynomial.C (w 1) * (MvPolynomial.C 1 + ∑ j : Fin (2 * m + 2), MvPolynomial.C (0 : k) * MvPolynomial.X j) +
              MvPolynomial.C (w 2) * (MvPolynomial.C 0 + ∑ j : Fin (2 * m + 2), MvPolynomial.C (0 : k) * MvPolynomial.X j) +
              MvPolynomial.C (w 3) * (MvPolynomial.C 0 + ∑ j : Fin (2 * m + 2), MvPolynomial.C (0 : k) * MvPolynomial.X j) =
              MvPolynomial.C (w 1) + ∑ j : Fin (2 * m + 2), MvPolynomial.C (0 : k) * MvPolynomial.X j := by
            simp only [map_zero, zero_mul, Finset.sum_const_zero, add_zero, zero_add,
              map_one, mul_one, mul_zero]
          calc ψ₂ (MvPolynomial.C (w 0)) * J₀ + ψ₂ (MvPolynomial.C (w 1)) * J₁ +
                ψ₂ (MvPolynomial.C (w 2)) * J₂ + ψ₂ (MvPolynomial.C (w 3)) * J₃
            _ = (ψ₂ (MvPolynomial.C (w 0)) * ℓ₂_0 + ψ₂ (MvPolynomial.C (w 1)) * ℓ₂_1 +
                  ψ₂ (MvPolynomial.C (w 2)) * ℓ₂_2 + ψ₂ (MvPolynomial.C (w 3)) * ℓ₂_3) -
                ψ₂ (MvPolynomial.C (w 0) * (MvPolynomial.C 0 + ∑ j, MvPolynomial.C (0 : k) * MvPolynomial.X j) +
                  MvPolynomial.C (w 1) * (MvPolynomial.C 1 + ∑ j, MvPolynomial.C (0 : k) * MvPolynomial.X j) +
                  MvPolynomial.C (w 2) * (MvPolynomial.C 0 + ∑ j, MvPolynomial.C (0 : k) * MvPolynomial.X j) +
                  MvPolynomial.C (w 3) * (MvPolynomial.C 0 + ∑ j, MvPolynomial.C (0 : k) * MvPolynomial.X j)) := by
              dsimp only [J₀, J₁, J₂, J₃]
              simp only [map_add, map_mul]
              ring
            _ = - ψ₂ (MvPolynomial.C (w 1) + ∑ j, MvPolynomial.C (0 : k) * MvPolynomial.X j) := by
              rw [hcomb₂, hlin_eq, zero_sub]
        rw [heq_J, map_neg, Ideal.neg_mem_iff] at hsum_J
        exact hsum_J
      obtain ⟨hw0, hv_comb⟩ := hLinInj₁ (w 0) v_comb hm₁_mem
      obtain ⟨hw1, _⟩ := hLinInj₂ (w 1) (fun _ => 0) hm₂_mem
      have hw2 : w 2 = 0 := by
        have h := hv_comb i₀
        simpa [v_comb, e₀_vec, e₁_vec, hi01] using h
      have hw3 : w 3 = 0 := by
        have h := hv_comb i₁
        simpa [v_comb, e₀_vec, e₁_vec, hi01.symm] using h
      intro s
      fin_cases s
      · exact hw0
      · exact hw1
      · exact hw2
      · exact hw3
    
    let v_gen : Fin (M + 1) → ↥(𝒜_M 1) :=
      fun β => ⟨MvPolynomial.X β, MvPolynomial.isHomogeneous_X k β⟩
    have hspan : Submodule.span k (Set.range v_gen) = ⊤ := by
      rw [eq_top_iff]
      rintro ⟨P, hP⟩ _
      have hcoeff : ∀ β : Fin (M + 1),
          P.coeff (Finsupp.single β 1) • v_gen β ∈ Submodule.span k (Set.range v_gen) :=
        fun β => Submodule.smul_mem _ _ (Submodule.subset_span ⟨β, rfl⟩)
      have hsum_eq : (⟨P, hP⟩ : ↥(𝒜_M 1)) =
          ∑ β : Fin (M + 1), P.coeff (Finsupp.single β 1) • v_gen β := by
        apply Subtype.ext
        push_cast
        ext d
        rw [MvPolynomial.coeff_sum]
        by_cases hd : d ∈ P.support
        · have hd_deg : ∑ β : Fin (M + 1), d β = 1 := by
            have h1 := (MvPolynomial.mem_homogeneousSubmodule 1 P).mp hP (MvPolynomial.mem_support_iff.mp hd)
            simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1
          have ⟨β₀, hβ₀_pos⟩ : ∃ β₀ : Fin (M + 1), 0 < d β₀ := by
            by_contra hall
            have h0 : ∑ β : Fin (M + 1), d β = 0 :=
              Finset.sum_eq_zero fun β _ => Nat.eq_zero_of_not_pos (fun hpos => hall ⟨β, hpos⟩)
            omega
          have hd_single : d = Finsupp.single β₀ 1 := by
            have hsplit := (Finset.add_sum_erase Finset.univ d (Finset.mem_univ β₀)).symm
            rw [hd_deg] at hsplit
            have hd_β₀ : d β₀ = 1 := by omega
            have hd_rest : ∀ β ∈ Finset.univ.erase β₀, d β = 0 :=
              Finset.sum_eq_zero_iff.mp (by omega : ∑ x ∈ Finset.univ.erase β₀, d x = 0)
            ext β
            by_cases hβ : β = β₀
            · subst hβ; simp [hd_β₀]
            · simp [hβ, hd_rest β (Finset.mem_erase.mpr ⟨hβ, Finset.mem_univ β⟩)]
          subst hd_single
          rw [Finset.sum_eq_single β₀]
          · simp [v_gen, MvPolynomial.coeff_X]
          · intro β _ hβ
            have hne : Finsupp.single β 1 ≠ Finsupp.single β₀ 1 :=
              fun heq => hβ ((Finsupp.single_left_inj one_ne_zero).mp heq)
            simp [v_gen, MvPolynomial.X, MvPolynomial.coeff_monomial, hne]
          · intro hmem; exact False.elim (hmem (Finset.mem_univ β₀))
        · rw [MvPolynomial.notMem_support_iff.mp hd]
          symm
          refine Finset.sum_eq_zero fun β _ => ?_
          by_cases hsingle : d = Finsupp.single β 1
          · subst hsingle
            simp [MvPolynomial.notMem_support_iff.mp hd]
          · simp [v_gen, MvPolynomial.X, MvPolynomial.coeff_monomial, Ne.symm hsingle]
      rw [hsum_eq]
      exact Submodule.sum_mem _ fun β _ => hcoeff β
    have hFG : (⊤ : Submodule k ↥(𝒜_M 1)).FG := hspan ▸ Submodule.fg_span (Set.finite_range v_gen)
    let _ : Module.Finite k ↥(𝒜_M 1) := Module.Finite.of_fg_top hFG
    have h4_le : 4 ≤ Module.finrank k ↥(𝒜_M 1) := by
      simpa using hLinIndep.fintype_card_le_finrank
    have hfin_le : Module.finrank k ↥(𝒜_M 1) ≤ M + 1 :=
      (finrank_le_of_span_eq_top hspan).trans_eq (Fintype.card_fin (M + 1))
    omega

  
  have hV3 : m = 0 → ∀ (L : MvPolynomial (Fin (M + 1)) k), L ∈ 𝒜_M 1 → L ≠ 0 →
      ∀ (C_L : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ι_CL : C_L ⟶ Z_bar),
        IsHomogeneousHypersurfacePullbackOver k M 1 ι_bar L ι_CL.left →
        ConnectedSpace ↥C_L.left →
        (AlgebraicGeometry.SmoothOfRelativeDimension 1 C_L.hom ∨
          ∃ x₀ : C_L.left, IsClosed ({x₀} : Set C_L.left) ∧
            (∀ y : C_L.left, y ≠ x₀ → ∃ V : C_L.left.Opens, y ∈ V ∧
              AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ C_L.hom)) ∧
            ∃ (V' : AlgebraicGeometry.Scheme.{u}) (v₀ : V') (e₁ : V' ⟶ C_L.left)
              (e₂ : V' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
                (MvPolynomial (Fin 2) k ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
              AlgebraicGeometry.Etale e₁ ∧ AlgebraicGeometry.Etale e₂ ∧ e₁.base v₀ = x₀ ∧
              (∀ b : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X b) ∈ (e₂.base v₀).asIdeal) ∧
              e₁ ≫ C_L.hom = e₂ ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) →
        IrreducibleSpace ↥C_L.left := by
    rintro rfl L hL hL_ne C_L ι_CL hPull hConn hSmOrNode
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 2 Z_bar.hom := by
      simpa using (inferInstance : AlgebraicGeometry.SmoothOfRelativeDimension (2 * 0 + 2) Z_bar.hom)
    obtain ⟨F_L, hFL, hNondeg_FL, hPull_FL⟩ := hPull_trans L hL hL_ne ι_CL.left hPull
    exact weil_algClosed_surface_cubic_section_irred k N Z_bar hInt ι₀ hCl₀
      F_L hFL hNondeg_FL C_L ι_CL hPull_FL hConn hSmOrNode

  exact ⟨M, ι_bar, hM_ge3, hCl_bar, hNondeg_bar, hV1, hV2, hV3⟩

theorem weil_algClosed_proj_plane_curve_and_line_coords (k : Type u) [Field k] [IsAlgClosed k] :
    ∃ (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
        (weilProjectiveSpaceOver k 1).left)
      (s_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        (weilProjectiveSpaceOver k 1).left)
      (ι_line : weilProjectiveSpaceOver k 1 ⟶ weilProjectiveSpaceOver k 2),
      IsStandardProjLineCoord k j_aff s_inf ∧
      IsStandardProjLineInPlane k ι_line ∧
      ∀ (D_disc : ℕ) (P_disc : MvPolynomial (Fin 3) k) (S_aff : Finset k)
        (F_bad_plane : Set (weilProjectiveSpaceOver k 2).left),
        1 ≤ D_disc →
        P_disc ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k D_disc →
        Irreducible P_disc →
        IsClosed F_bad_plane →
        (∀ (t : Fin 2 → k) (p : (weilProjectiveSpaceOver k 2).left),
          t ≠ 0 →
          (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
            MvPolynomial.gradedAlgebra
           ∀ (F : MvPolynomial (Fin 3) k) (d : ℕ),
            F ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d →
            (F ∈ ProjectiveSpectrum.asHomogeneousIdeal p ↔
              MvPolynomial.eval ![t 0, t 1, 0] F = 0)) →
          p ∉ F_bad_plane) →
        MvPolynomial.eval ![0, 1, 0] P_disc = 0 →
        MvPolynomial.eval ![0, 1, 0] (MvPolynomial.pderiv (0 : Fin 3) P_disc) ≠ 0 →
        MvPolynomial.eval ![1, 0, 0] P_disc ≠ 0 →
        (∀ b : k, MvPolynomial.eval ![1, b, 0] P_disc = 0 ↔ b ∈ S_aff) →
        (∀ a ∈ S_aff, MvPolynomial.eval ![1, a, 0] (MvPolynomial.pderiv (1 : Fin 3) P_disc) ≠ 0) →
        ∃ (U₀ : (weilProjectiveSpaceOver k 1).left.Opens)
          (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (ι_disc : C_disc ⟶ weilProjectiveSpaceOver k 2)
          (U_disc_reg : C_disc.left.Opens),
          IsHomogeneousHypersurfacePullbackOver k 2 D_disc
            (𝟙 (weilProjectiveSpaceOver k 2)) P_disc ι_disc.left ∧
          AlgebraicGeometry.IsIntegral C_disc.left ∧
          AlgebraicGeometry.IsProper C_disc.hom ∧
          Nonempty U_disc_reg ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_disc_reg.ι ≫ C_disc.hom) ∧
          (U₀ : Set (weilProjectiveSpaceOver k 1).left) =
            j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) |
              ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal } ∧
          ι_line.left.base ⁻¹' (Set.range ι_disc.left.base) = (U₀ : Set _)ᶜ ∧
          ι_line.left.base '' ((U₀ : Set _)ᶜ) ⊆
            ι_disc.left.base '' (U_disc_reg : Set C_disc.left) ∧
          (∀ c : C_disc.left, c ∈ U_disc_reg → IsClosed ({c} : Set C_disc.left) →
            (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
              MvPolynomial.gradedAlgebra
             ι_disc.left.base c ∉ F_bad_plane ∧
             ∃ w : Fin 3 → k,
               w ≠ 0 ∧
               ∀ (F : MvPolynomial (Fin 3) k) (d : ℕ),
                 F ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d →
                 (F ∈ ProjectiveSpectrum.asHomogeneousIdeal (ι_disc.left.base c) ↔
                   MvPolynomial.eval w F = 0))) :=
by
  have part1_s2 :
      ∃ (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
            (weilProjectiveSpaceOver k 1).left)
        (s_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
            (weilProjectiveSpaceOver k 1).left),
        IsStandardProjLineCoord k j_aff s_inf ∧
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
          MvPolynomial.gradedAlgebra
         (∀ (pt : AlgebraicGeometry.Spec (CommRingCat.of k))
            (G : MvPolynomial (Fin 2) k) (d : ℕ),
            G ∈ MvPolynomial.homogeneousSubmodule (Fin 2) k d →
            (G ∈ ProjectiveSpectrum.asHomogeneousIdeal (s_inf.base pt) ↔
              MvPolynomial.eval ![0, 1] G = 0)) ∧
         (∀ (p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
            (G : MvPolynomial (Fin 2) k) (d : ℕ),
            G ∈ MvPolynomial.homogeneousSubmodule (Fin 2) k d →
            (G ∈ ProjectiveSpectrum.asHomogeneousIdeal (j_aff.base p) ↔
              MvPolynomial.eval₂ Polynomial.C ![1, Polynomial.X] G ∈ p.asIdeal))) := by
    classical
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
      MvPolynomial.gradedAlgebra
    let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k

    have hIrrel_1 : (HomogeneousIdeal.irrelevant 𝒜_1).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) k)) := by
      intro p hp
      have hp0 : GradedRing.proj 𝒜_1 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜_1 p).mp hp
      have hcoeff0 : p.coeff 0 = 0 := by
        have hdecomp := DirectSum.sum_support_decompose 𝒜_1 p
        have hsum_coeff :
            (∑ i ∈ (DirectSum.decompose 𝒜_1 p).support,
              ((DirectSum.decompose 𝒜_1 p i : MvPolynomial (Fin 2) k)).coeff 0) =
            p.coeff 0 := by
          rw [← MvPolynomial.coeff_sum, hdecomp]
        rw [← hsum_coeff]
        refine Finset.sum_eq_zero fun i _ => ?_
        by_cases hi : i = 0
        · subst hi
          have h0 : (DirectSum.decompose 𝒜_1 p 0 : MvPolynomial (Fin 2) k) = 0 := hp0
          rw [h0]; rfl
        · by_contra hne
          have hhom : ((DirectSum.decompose 𝒜_1 p i : MvPolynomial (Fin 2) k)).IsHomogeneous i :=
            (MvPolynomial.mem_homogeneousSubmodule i _).mp (DirectSum.decompose 𝒜_1 p i).2
          have hdeg := hhom hne
          simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at hdeg
          exact hi hdeg.symm
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm_ne : m ≠ 0 := by
        intro h0; rw [h0] at hm; exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
      by_contra h_all
      apply hm_ne
      ext i
      by_contra hmi
      exact h_all ⟨i, Set.mem_univ i, hmi⟩

    have hDeg0_1 : ∀ (G : MvPolynomial (Fin 2) k), G ∈ 𝒜_1 0 →
        G = MvPolynomial.C (G.coeff 0) := by
      intro G hG
      ext d
      by_cases hd0 : d = 0
      · subst hd0; simp [MvPolynomial.coeff_C]
      · rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr fun h => False.elim (hd0 h.symm)]
        by_contra hne
        have h1 := (MvPolynomial.mem_homogeneousSubmodule 0 G).mp hG hne
        have hsum : (∑ i : Fin 2, d i) = 0 := by
          simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1
        apply hd0
        ext i
        exact Finset.sum_eq_zero_iff.mp hsum i (Finset.mem_univ i)

    have hChart_P1 : ∀ b : Fin 2,
        let v_b : Fin 2 → Polynomial k :=
          if b = 0 then ![1, Polynomial.X] else ![Polynomial.X, 1]
        let dehom_b : MvPolynomial (Fin 2) k →+* Polynomial k :=
          MvPolynomial.eval₂Hom Polynomial.C v_b
        let b_oth : Fin 2 := if b = 0 then 1 else 0
        ∃ (e_b : Polynomial k ≃+* HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b)),
          (∀ c : k, e_b (Polynomial.C c) =
            (HomogeneousLocalization.fromZeroRingHom 𝒜_1
              (Submonoid.powers (MvPolynomial.X b))) (algebraMap k ↥(𝒜_1 0) c)) ∧
          e_b Polynomial.X = HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X b_oth,
                (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k b_oth)⟩,
              ⟨MvPolynomial.X b,
                (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k b)⟩,
              Submonoid.mem_powers (MvPolynomial.X b)⟩ ∧
          (∀ (d : ℕ) (F : MvPolynomial (Fin 2) k) (hF : F ∈ 𝒜_1 d)
             (den : MvPolynomial (Fin 2) k) (hden : den ∈ 𝒜_1 d)
             (hp : den ∈ Submonoid.powers (MvPolynomial.X b)),
            e_b.symm (HomogeneousLocalization.mk ⟨d, ⟨F, hF⟩, ⟨den, hden⟩, hp⟩) =
              dehom_b F) := by
      intro b
      let v_b : Fin 2 → Polynomial k :=
        if b = 0 then ![1, Polynomial.X] else ![Polynomial.X, 1]
      let dehom_b : MvPolynomial (Fin 2) k →+* Polynomial k :=
        MvPolynomial.eval₂Hom Polynomial.C v_b
      let b_oth : Fin 2 := if b = 0 then 1 else 0
      let S_b := Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin 2) k)
      let xb_mem : (MvPolynomial.X b : MvPolynomial (Fin 2) k) ∈ S_b := Submonoid.mem_powers _
      have h_dehom_Xb : dehom_b (MvPolynomial.X b) = 1 := by
        fin_cases b <;> simp [dehom_b, v_b]
      have h_dehom_Xoth : dehom_b (MvPolynomial.X b_oth) = Polynomial.X := by
        fin_cases b <;> simp [dehom_b, v_b, b_oth]
      have h_units : ∀ y : S_b, IsUnit (dehom_b y.1) := by
        rintro ⟨_, n, rfl⟩
        rw [map_pow, h_dehom_Xb, one_pow]
        exact isUnit_one
      let L_b := Localization.Away (MvPolynomial.X b : MvPolynomial (Fin 2) k)
      let loc_lift : L_b →+* Polynomial k := IsLocalization.lift h_units
      have h_loc_mk : ∀ (F : MvPolynomial (Fin 2) k) (s : S_b),
          loc_lift (Localization.mk F s) = dehom_b F := by
        intro F s
        rcases s with ⟨_, n, rfl⟩
        have hmk' : Localization.mk F (⟨MvPolynomial.X b ^ n, ⟨n, rfl⟩⟩ : S_b) =
            IsLocalization.mk' L_b F (⟨MvPolynomial.X b ^ n, ⟨n, rfl⟩⟩ : S_b) :=
          congrFun (congrFun Localization.mk_eq_mk' F) _
        rw [hmk']
        exact (IsLocalization.lift_mk'_spec h_units F (dehom_b F) _).mpr
          (by rw [map_pow, h_dehom_Xb, one_pow, one_mul])
      let val_hom : HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) →+* L_b :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := fun _ _ => HomogeneousLocalization.val_mul _ _
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := fun _ _ => HomogeneousLocalization.val_add _ _ }
      let β_b : HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) →+* Polynomial k :=
        loc_lift.comp val_hom
      let ι_kb : k →+* HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜_1 S_b).comp (algebraMap k ↥(𝒜_1 0))
      let u_b : HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) :=
        HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X b_oth,
              (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k b_oth)⟩,
            ⟨MvPolynomial.X b,
              (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k b)⟩,
            xb_mem⟩
      let α_b : Polynomial k →+* HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) :=
        Polynomial.eval₂RingHom ι_kb u_b
      have h_ι_val : ∀ c : k, (ι_kb c).val = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        have hc_val : (algebraMap k ↥(𝒜_1 0) c : MvPolynomial (Fin 2) k) = MvPolynomial.C c := by
          rw [Algebra.algebraMap_eq_smul_one, Algebra.smul_def, mul_one]; rfl
        change (HomogeneousLocalization.mk
          { deg := 0
            num := algebraMap k ↥(𝒜_1 0) c
            den := ⟨1, SetLike.one_mem_graded 𝒜_1⟩
            den_mem := S_b.one_mem }).val = Localization.mk (MvPolynomial.C c) 1
        rw [HomogeneousLocalization.val_mk]
        exact congrArg (fun q => Localization.mk q 1) hc_val
      have h_β_α : β_b.comp α_b = RingHom.id (Polynomial k) := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          change loc_lift ((α_b (Polynomial.C c)).val) = Polynomial.C c
          have hαC : α_b (Polynomial.C c) = ι_kb c := by
            simp [α_b]
          rw [hαC, h_ι_val c, h_loc_mk]
          exact MvPolynomial.eval₂Hom_C Polynomial.C v_b c
        · change loc_lift ((α_b Polynomial.X).val) = Polynomial.X
          have hαX : α_b Polynomial.X = u_b := by
            simp [α_b]
          rw [hαX]
          dsimp only [u_b]
          rw [HomogeneousLocalization.val_mk, h_loc_mk, h_dehom_Xoth]
      have h_val_α_X : ∀ j : Fin 2,
          (α_b (dehom_b (MvPolynomial.X j))).val =
            Localization.mk (MvPolynomial.X j) ⟨MvPolynomial.X b, xb_mem⟩ := by
        intro j
        by_cases hjb : j = b
        · subst hjb
          rw [h_dehom_Xb, map_one, HomogeneousLocalization.val_one]
          exact (Localization.mk_self (⟨MvPolynomial.X j, xb_mem⟩ : S_b)).symm
        · have hj_oth : j = b_oth := by
            fin_cases b <;> fin_cases j <;> revert hjb <;> decide
          subst hj_oth
          have hαX : α_b Polynomial.X = u_b := by simp [α_b]
          rw [h_dehom_Xoth, hαX]
          dsimp only [u_b]
          exact HomogeneousLocalization.val_mk _
      have h_α_β : α_b.comp β_b = RingHom.id _ := by
        apply RingHom.ext
        intro z
        rw [RingHom.comp_apply, RingHom.id_apply]
        have hXb_mem : (MvPolynomial.X b : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1 :=
          MvPolynomial.isHomogeneous_X k b
        obtain ⟨n, F, hF, rfl⟩ :=
          HomogeneousLocalization.Away.mk_surjective 𝒜_1 hXb_mem z
        apply HomogeneousLocalization.val_injective
        have hβ_mk : β_b (HomogeneousLocalization.Away.mk 𝒜_1 hXb_mem n F hF) = dehom_b F := by
          change loc_lift (HomogeneousLocalization.Away.mk 𝒜_1 hXb_mem n F hF).val = dehom_b F
          rw [HomogeneousLocalization.Away.val_mk, h_loc_mk]
        rw [hβ_mk, HomogeneousLocalization.Away.val_mk]
        have hF_hom : F.IsHomogeneous n := by
          have h1 : n • (1 : ℕ) = n := nsmul_one n
          exact h1 ▸ hF
        change (val_hom.comp (α_b.comp dehom_b)) F = _
        conv_lhs => rw [F.as_sum]
        conv_rhs => rw [F.as_sum]
        rw [map_sum]
        have hsum_mk : ∀ (T : Finset (Fin 2 →₀ ℕ)) (f : (Fin 2 →₀ ℕ) → MvPolynomial (Fin 2) k)
            (y : S_b),
            (∑ s ∈ T, Localization.mk (f s) y) = Localization.mk (∑ s ∈ T, f s) y := by
          intro T f y
          induction T using Finset.induction_on with
          | empty => simp [Localization.mk_zero]
          | @insert s₀ T' hs₀ ih =>
            rw [Finset.sum_insert hs₀, Finset.sum_insert hs₀, ih, Localization.add_mk_self]
        rw [← hsum_mk]
        refine Finset.sum_congr rfl fun s hs => ?_
        have hs_deg : (∑ j ∈ s.support, s j) = n := by
          have hd_eq : Finsupp.degree s = n := by
            by_contra hne
            exact (MvPolynomial.mem_support_iff.mp hs) (hF_hom.coeff_eq_zero hne)
          rwa [Finsupp.degree_apply] at hd_eq
        rw [MvPolynomial.monomial_eq, map_mul]
        have hC : (val_hom.comp (α_b.comp dehom_b)) (MvPolynomial.C (F.coeff s)) =
            Localization.mk (MvPolynomial.C (F.coeff s)) 1 := by
          change (α_b (dehom_b (MvPolynomial.C (F.coeff s)))).val = _
          have hdC : dehom_b (MvPolynomial.C (F.coeff s)) = Polynomial.C (F.coeff s) :=
            MvPolynomial.eval₂Hom_C _ _ _
          have hαC : α_b (Polynomial.C (F.coeff s)) = ι_kb (F.coeff s) := by simp [α_b]
          rw [hdC, hαC, h_ι_val]
        rw [hC]
        change _ * (val_hom.comp (α_b.comp dehom_b)) (∏ j ∈ s.support, MvPolynomial.X j ^ s j) = _
        rw [map_prod]
        simp_rw [map_pow]
        have hprod_mk : ∀ (T : Finset (Fin 2)),
            (∏ j ∈ T, ((val_hom.comp (α_b.comp dehom_b)) (MvPolynomial.X j)) ^ s j) =
              Localization.mk (∏ j ∈ T, MvPolynomial.X j ^ s j)
                ⟨MvPolynomial.X b ^ (∑ j ∈ T, s j), S_b.pow_mem xb_mem (∑ j ∈ T, s j)⟩ := by
          intro T
          induction T using Finset.induction_on with
          | empty => simp
          | @insert j₀ T' hj₀ ih =>
            rw [Finset.prod_insert hj₀, Finset.prod_insert hj₀, Finset.sum_insert hj₀, ih]
            have hj0 : (val_hom.comp (α_b.comp dehom_b)) (MvPolynomial.X j₀) =
                Localization.mk (MvPolynomial.X j₀) ⟨MvPolynomial.X b, xb_mem⟩ := h_val_α_X j₀
            rw [hj0, Localization.mk_pow, Localization.mk_mul]
            congr 1; ext; simp [pow_add]
        rw [hprod_mk s.support, Localization.mk_mul, one_mul]
        congr 1
        ext; simp [hs_deg]
      let e_b : Polynomial k ≃+* HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) :=
        { toFun := α_b
          invFun := β_b
          left_inv := fun x => DFunLike.congr_fun h_β_α x
          right_inv := fun y => DFunLike.congr_fun h_α_β y
          map_mul' := map_mul α_b
          map_add' := map_add α_b }
      refine ⟨e_b, ?_, ?_, ?_⟩
      · intro c
        change α_b (Polynomial.C c) = ι_kb c
        simp [α_b]
      · change α_b Polynomial.X = u_b
        simp [α_b]
      · intro d F hF den hden hp
        change loc_lift (HomogeneousLocalization.mk ⟨d, ⟨F, hF⟩, ⟨den, hden⟩, hp⟩).val = dehom_b F
        rw [HomogeneousLocalization.val_mk, h_loc_mk]

    obtain ⟨e₀, he₀_C, he₀_X, he₀_symm⟩ := hChart_P1 0
    obtain ⟨e₁, he₁_C, he₁_X, he₁_symm⟩ := hChart_P1 1
    have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1 :=
      MvPolynomial.isHomogeneous_X k 0
    have hX1 : (MvPolynomial.X 1 : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1 :=
      MvPolynomial.isHomogeneous_X k 1

    let iso_e₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X 0))) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            e₀.symm_toRingHom_comp_toRingHom, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            e₀.toRingHom_comp_symm_toRingHom, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }

    let X_1 : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜_1
    let away₀ : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X 0))) ⟶
        X_1 := AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X 0) hX0 zero_lt_one
    let away₁ : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X 1))) ⟶
        X_1 := AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X 1) hX1 zero_lt_one
    let j_aff₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ X_1 :=
      iso_e₀.hom ≫ away₀
    let φ_inf : HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X 1) →+* k :=
      (Polynomial.evalRingHom 0).comp e₁.symm.toRingHom
    let s_inf₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X_1 :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_inf) ≫ away₁

    have : AlgebraicGeometry.IsOpenImmersion away₀ := by
      dsimp only [away₀]
      rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_1 (MvPolynomial.X 0) hX0 zero_lt_one]
      exact AlgebraicGeometry.IsOpenImmersion.comp _ _
    have : CategoryTheory.IsIso iso_e₀.hom := iso_e₀.isIso_hom
    have hOpen_jaff₀ : AlgebraicGeometry.IsOpenImmersion j_aff₀ :=
      AlgebraicGeometry.IsOpenImmersion.comp iso_e₀.hom away₀

    let j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
        (weilProjectiveSpaceOver k 1).left := j_aff₀
    let s_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        (weilProjectiveSpaceOver k 1).left := s_inf₀
    have hOpen_jaff : AlgebraicGeometry.IsOpenImmersion j_aff := hOpen_jaff₀

    have h_jaff_hom : j_aff ≫ (weilProjectiveSpaceOver k 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      change (iso_e₀.hom ≫ away₀) ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜_1 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_1 0)))) = _
      rw [CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc away₀,
        AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_1 (MvPolynomial.X 0) hX0 zero_lt_one,
        ← AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, iso_e₀]
      have hc := congrArg e₀.symm (he₀_C c)
      rw [e₀.symm_apply_apply] at hc
      exact hc.symm

    have h_sinf_hom : s_inf ≫ (weilProjectiveSpaceOver k 1).hom =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_inf) ≫ away₁) ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜_1 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_1 0)))) = _
      rw [CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc away₁,
        AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_1 (MvPolynomial.X 1) hX1 zero_lt_one,
        ← AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Spec.map_id]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_id,
        RingHom.comp_apply, RingHom.id_apply, φ_inf]
      have hc := congrArg e₁.symm (he₁_C c)
      rw [e₁.symm_apply_apply] at hc
      simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, ← hc,
        Polynomial.coe_evalRingHom, Polynomial.eval_C]

    let D₀ : X_1.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X 0)
    have hRange_away₀ : Set.range away₀.base = (D₀ : Set X_1) := by
      have h_inv_ι := AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_1 (MvPolynomial.X 0) hX0 zero_lt_one
      let iso₀ := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_1 (MvPolynomial.X 0) hX0 zero_lt_one
      ext p
      constructor
      · rintro ⟨v, rfl⟩
        dsimp only [away₀]
        rw [← h_inv_ι, AlgebraicGeometry.Scheme.Hom.comp_apply]
        rw [← D₀.range_ι]
        exact ⟨iso₀.inv.base v, rfl⟩
      · intro hp
        rw [← D₀.range_ι] at hp
        rcases hp with ⟨u, rfl⟩
        refine ⟨iso₀.hom.base u, ?_⟩
        dsimp only [away₀]
        rw [← h_inv_ι]
        change ((iso₀.hom ≫ iso₀.inv) ≫ D₀.ι).base u = D₀.ι.base u
        rw [iso₀.hom_inv_id, CategoryTheory.Category.id_comp]

    have hRange_jaff : Set.range j_aff.base = (weilProjHyperplaneSet k 1 (MvPolynomial.X 0))ᶜ := by
      have hRange_jaff₀ : Set.range j_aff₀.base = Set.range away₀.base := by
        ext p
        constructor
        · rintro ⟨x, rfl⟩
          exact ⟨iso_e₀.hom.base x, rfl⟩
        · rintro ⟨y, rfl⟩
          refine ⟨iso_e₀.inv.base y, ?_⟩
          change ((iso_e₀.inv ≫ iso_e₀.hom) ≫ away₀).base y = away₀.base y
          rw [iso_e₀.inv_hom_id, CategoryTheory.Category.id_comp]
      change Set.range j_aff₀.base = _
      rw [hRange_jaff₀, hRange_away₀]
      ext p
      exact ⟨fun hp hnot => hnot hp, fun hnn => Classical.not_not.mp hnn⟩

    have h_jaff_le₀ : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))).Opens) ≤
        (TopologicalSpace.Opens.map j_aff₀.base).obj D₀ := by
      intro x _
      change j_aff₀.base x ∈ (D₀ : Set X_1)
      rw [← hRange_away₀]
      exact ⟨iso_e₀.hom.base x, rfl⟩

    have h_jaff_coord₀ :
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X 0) hX0 zero_lt_one).hom ≫
          j_aff₀.appLE D₀ ⊤ h_jaff_le₀ ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom).hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X 1, hX1⟩, ⟨MvPolynomial.X 0, hX0⟩, ⟨1, pow_one _⟩⟩) =
          Polynomial.X := by
      let S_poly := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
      let V_top : S_poly.Opens := ⊤
      let hAffTop : AlgebraicGeometry.IsAffineOpen V_top := isAffineOpen_top S_poly
      let ψ_lhs : CommRingCat.of (HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X 0)) ⟶
          CommRingCat.of (Polynomial k) :=
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X 0) hX0 zero_lt_one).hom ≫
          j_aff₀.appLE D₀ V_top h_jaff_le₀) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom
      have hV_ι_hom : V_top.ι ≫
          AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom =
          V_top.toSpecΓ := by
        have hiso : AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom =
            S_poly.isoSpec.hom := by
          rw [AlgebraicGeometry.Scheme.isoSpec_Spec]
          rfl
        have hfrom : hAffTop.isoSpec.inv ≫ V_top.ι = S_poly.isoSpec.inv := by
          rw [hAffTop.isoSpec_inv_ι, AlgebraicGeometry.IsAffineOpen.fromSpec_top]
        calc V_top.ι ≫ AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom
            = (V_top.toSpecΓ ≫ hAffTop.isoSpec.inv) ≫ V_top.ι ≫ S_poly.isoSpec.hom := by
              rw [hAffTop.toSpecΓ_isoSpec_inv, CategoryTheory.Category.id_comp, hiso]
          _ = V_top.toSpecΓ ≫ (hAffTop.isoSpec.inv ≫ V_top.ι) ≫ S_poly.isoSpec.hom := by
              simp only [CategoryTheory.Category.assoc]
          _ = V_top.toSpecΓ ≫ S_poly.isoSpec.inv ≫ S_poly.isoSpec.hom := by rw [hfrom]
          _ = V_top.toSpecΓ := by rw [CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.comp_id]
      have hSpec_away : V_top.ι ≫ AlgebraicGeometry.Spec.map ψ_lhs ≫ away₀ =
          V_top.ι ≫ iso_e₀.hom ≫ away₀ := by
        dsimp only [ψ_lhs]
        rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc V_top.ι,
          ← CategoryTheory.Category.assoc V_top.ι, hV_ι_hom,
          AlgebraicGeometry.Proj.basicOpenIsoAway_hom, AlgebraicGeometry.Spec.map_comp]
        simp only [CategoryTheory.Category.assoc]
        rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE_assoc]
        change (j_aff₀.resLE D₀ V_top h_jaff_le₀ ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_1 (MvPolynomial.X 0) hX0 zero_lt_one).hom) ≫
          away₀ = V_top.ι ≫ j_aff₀
        dsimp only [away₀]
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_1 (MvPolynomial.X 0) hX0 zero_lt_one,
          CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc,
          AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
      have : CategoryTheory.IsIso V_top.ι := by
        change CategoryTheory.IsIso (⊤ : S_poly.Opens).ι
        rw [← S_poly.topIso_hom]
        infer_instance
      have hSpec_away' : AlgebraicGeometry.Spec.map ψ_lhs ≫ away₀ = iso_e₀.hom ≫ away₀ :=
        (CategoryTheory.cancel_epi V_top.ι).mp hSpec_away
      have hSpec_eq : AlgebraicGeometry.Spec.map ψ_lhs = iso_e₀.hom := by
        dsimp only [away₀] at hSpec_away'
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_1 (MvPolynomial.X 0) hX0 zero_lt_one,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc] at hSpec_away'
        exact (CategoryTheory.cancel_mono _).mp ((CategoryTheory.cancel_mono D₀.ι).mp hSpec_away')
      have hψ_eq : ψ_lhs = CommRingCat.ofHom e₀.symm.toRingHom :=
        AlgebraicGeometry.Spec.map_injective hSpec_eq
      change ψ_lhs.hom _ = Polynomial.X
      rw [hψ_eq]
      change e₀.symm _ = Polynomial.X
      rw [he₀_symm 1 (MvPolynomial.X 1) hX1 (MvPolynomial.X 0) hX0 ⟨1, pow_one _⟩]
      simp

    have hV_X0_ideal : ∀ (q : ProjectiveSpectrum 𝒜_1),
        MvPolynomial.X 0 ∈ q.asHomogeneousIdeal →
        ∀ (G : MvPolynomial (Fin 2) k) (d : ℕ),
          G ∈ 𝒜_1 d →
          (G ∈ q.asHomogeneousIdeal ↔ MvPolynomial.eval ![0, 1] G = 0) := by
      intro q hX0_in G d hGd
      have hX1_not : MvPolynomial.X 1 ∉ q.asHomogeneousIdeal := by
        intro hX1_in
        apply q.not_irrelevant_le
        change (HomogeneousIdeal.irrelevant 𝒜_1).toIdeal ≤ q.asHomogeneousIdeal.toIdeal
        refine hIrrel_1.trans (Ideal.span_le.mpr ?_)
        rintro _ ⟨b, rfl⟩
        fin_cases b
        · exact hX0_in
        · exact hX1_in
      have hG_decomp : G - MvPolynomial.C (MvPolynomial.eval ![0, 1] G) *
          (MvPolynomial.X 1) ^ d ∈ q.asHomogeneousIdeal.toIdeal := by
        have hG_eq_sum : G - MvPolynomial.C (MvPolynomial.eval ![0, 1] G) *
            (MvPolynomial.X 1) ^ d =
            ∑ s ∈ G.support,
              (MvPolynomial.monomial s (G.coeff s) -
                MvPolynomial.C (G.coeff s * ∏ i ∈ s.support, (![0, 1] i : k) ^ s i) *
                  (MvPolynomial.X 1) ^ d) := by
          rw [Finset.sum_sub_distrib, ← G.as_sum, MvPolynomial.eval_eq, map_sum, Finset.sum_mul]
        rw [hG_eq_sum]
        refine Ideal.sum_mem _ fun s hs => ?_
        have hs_deg : s 0 + s 1 = d := by
          have h1 := (MvPolynomial.mem_homogeneousSubmodule d G).mp hGd
            (MvPolynomial.mem_support_iff.mp hs)
          simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using h1
        have hprod_eval : (∏ i ∈ s.support, (![0, 1] i : k) ^ s i) =
            (0 : k) ^ (s 0) * (1 : k) ^ (s 1) := by
          change s.prod (fun i e => (![0, 1] i : k) ^ e) = _
          rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_two]
          rfl
        have hmon_eq : MvPolynomial.monomial s (G.coeff s) =
            MvPolynomial.C (G.coeff s) * (MvPolynomial.X 0 ^ s 0 * MvPolynomial.X 1 ^ s 1) := by
          rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
            Fin.prod_univ_two]
        rw [hprod_eval, one_pow, mul_one, hmon_eq]
        rcases Nat.eq_zero_or_pos (s 0) with hs0 | hs0
        · have hs1 : s 1 = d := by omega
          rw [hs0, hs1, pow_zero, pow_zero, mul_one, one_mul, sub_self]
          exact Ideal.zero_mem _
        · obtain ⟨m, hm⟩ : ∃ m, s 0 = m + 1 := ⟨s 0 - 1, (Nat.sub_add_cancel hs0).symm⟩
          rw [hm, zero_pow (Nat.succ_ne_zero m), mul_zero, map_zero, zero_mul, sub_zero]
          convert Ideal.mul_mem_right
            (MvPolynomial.C (G.coeff s) * (MvPolynomial.X (0 : Fin 2)) ^ m *
              (MvPolynomial.X (1 : Fin 2)) ^ s 1)
            q.asHomogeneousIdeal.toIdeal hX0_in using 1
          rw [pow_succ]; ring
      let c₀ : k := MvPolynomial.eval ![0, 1] G
      have hiff : G ∈ q.asHomogeneousIdeal ↔
          MvPolynomial.C c₀ * (MvPolynomial.X 1) ^ d ∈ q.asHomogeneousIdeal.toIdeal := by
        constructor
        · intro hG_in
          have hsub := Ideal.sub_mem q.asHomogeneousIdeal.toIdeal hG_in hG_decomp
          dsimp only [c₀]
          rwa [sub_sub_cancel] at hsub
        · intro hC_in
          dsimp only [c₀] at hC_in
          have hadd := Ideal.add_mem q.asHomogeneousIdeal.toIdeal hG_decomp hC_in
          change G ∈ q.asHomogeneousIdeal.toIdeal
          rwa [sub_add_cancel] at hadd
      rw [hiff]
      constructor
      · intro hmem
        by_contra hc_ne
        have hX1d_in : (MvPolynomial.X 1 : MvPolynomial (Fin 2) k) ^ d ∈
            q.asHomogeneousIdeal.toIdeal := by
          have hmul := Ideal.mul_mem_left q.asHomogeneousIdeal.toIdeal (MvPolynomial.C c₀⁻¹) hmem
          rwa [← mul_assoc, ← map_mul, inv_mul_cancel₀ hc_ne, map_one, one_mul] at hmul
        rcases Nat.eq_zero_or_pos d with rfl | hd_pos
        · rw [pow_zero] at hX1d_in
          exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hX1d_in isUnit_one)
        · exact hX1_not (q.isPrime.mem_of_pow_mem d hX1d_in)
      · intro hc0
        dsimp only [c₀]
        rw [hc0, map_zero, zero_mul]
        exact Ideal.zero_mem _

    have h_sinf_X0 : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k),
        MvPolynomial.X 0 ∈ ProjectiveSpectrum.asHomogeneousIdeal (s_inf.base pt) := by
      intro pt
      let q : X_1 := s_inf₀.base pt
      have hpre := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_1 hX1 zero_lt_one hX0 zero_lt_one
      have hnot_D0 : q ∉ D₀ := by
        intro hmem
        have hmem1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_inf)).base pt ∈
            (TopologicalSpace.Opens.map away₁.base).obj D₀ := hmem
        rw [hpre] at hmem1
        let p_away : PrimeSpectrum (HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X 1)) :=
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_inf)).base pt
        have hnot_ideal : HomogeneousLocalization.Away.isLocalizationElem hX1 hX0 ∉
            p_away.asIdeal := (PrimeSpectrum.mem_basicOpen _ p_away).mp hmem1
        have hp_ideal : HomogeneousLocalization.Away.isLocalizationElem hX1 hX0 ∈
            p_away.asIdeal ↔ φ_inf (HomogeneousLocalization.Away.isLocalizationElem hX1 hX0) ∈
              (pt : PrimeSpectrum k).asIdeal := Iff.rfl
        rw [hp_ideal] at hnot_ideal
        have helem_eq : HomogeneousLocalization.Away.isLocalizationElem hX1 hX0 =
            HomogeneousLocalization.mk ⟨1, ⟨MvPolynomial.X 0, hX0⟩, ⟨MvPolynomial.X 1, hX1⟩,
              Submonoid.mem_powers (MvPolynomial.X 1)⟩ := by
          apply HomogeneousLocalization.val_injective
          dsimp [HomogeneousLocalization.Away.isLocalizationElem]
          simp [pow_one]
        have hφ_zero : φ_inf (HomogeneousLocalization.Away.isLocalizationElem hX1 hX0) = 0 := by
          rw [helem_eq]
          dsimp only [φ_inf, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
          rw [he₁_symm 1 (MvPolynomial.X 0) hX0 (MvPolynomial.X 1) hX1
            (Submonoid.mem_powers (MvPolynomial.X 1))]
          simp
        rw [hφ_zero] at hnot_ideal
        exact hnot_ideal (Ideal.zero_mem _)
      change MvPolynomial.X 0 ∈ (q : ProjectiveSpectrum 𝒜_1).asHomogeneousIdeal
      rwa [AlgebraicGeometry.Proj.mem_basicOpen, not_not] at hnot_D0

    have hIdeal_sinf : ∀ (pt : AlgebraicGeometry.Spec (CommRingCat.of k))
        (G : MvPolynomial (Fin 2) k) (d : ℕ),
        G ∈ 𝒜_1 d →
        (G ∈ ProjectiveSpectrum.asHomogeneousIdeal (s_inf.base pt) ↔
          MvPolynomial.eval ![0, 1] G = 0) :=
      fun pt G d hGd => hV_X0_ideal (s_inf.base pt) (h_sinf_X0 pt) G d hGd

    have hCompl_range : (Set.range j_aff.base)ᶜ = Set.range s_inf.base := by
      rw [hRange_jaff, compl_compl]
      have hNe_spec : Nonempty (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        (inferInstance : Nonempty (PrimeSpectrum k))
      obtain ⟨pt₀⟩ := hNe_spec
      ext q
      let q' : X_1 := q
      have hq_iff : q ∈ weilProjHyperplaneSet k 1 (MvPolynomial.X 0) ↔
          MvPolynomial.X 0 ∈ (q' : ProjectiveSpectrum 𝒜_1).asHomogeneousIdeal := by
        change q' ∉ D₀ ↔ _
        rw [AlgebraicGeometry.Proj.mem_basicOpen, not_not]
      rw [hq_iff]
      constructor
      · intro hX0_q
        refine ⟨pt₀, ?_⟩
        apply ProjectiveSpectrum.ext
        ext F
        have hhom_eq : ∀ (G : MvPolynomial (Fin 2) k) (d : ℕ), G ∈ 𝒜_1 d →
            (G ∈ (s_inf.base pt₀).asHomogeneousIdeal ↔
              G ∈ (q' : ProjectiveSpectrum 𝒜_1).asHomogeneousIdeal) := by
          intro G d hGd
          rw [hIdeal_sinf pt₀ G d hGd, hV_X0_ideal q' hX0_q G d hGd]
        exact ⟨fun hF => by
          rw [← DirectSum.sum_support_decompose 𝒜_1 F]
          refine Ideal.sum_mem _ fun d _ => ?_
          exact (hhom_eq _ d (Subtype.prop _)).mp
            ((s_inf.base pt₀).asHomogeneousIdeal.isHomogeneous d hF),
        fun hF => by
          rw [← DirectSum.sum_support_decompose 𝒜_1 F]
          refine Ideal.sum_mem _ fun d _ => ?_
          exact (hhom_eq _ d (Subtype.prop _)).mpr
            ((q' : ProjectiveSpectrum 𝒜_1).asHomogeneousIdeal.isHomogeneous d hF)⟩
      · rintro ⟨pt, rfl⟩
        exact h_sinf_X0 pt

    have hIdeal_jaff : ∀ (p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
        (G : MvPolynomial (Fin 2) k) (d : ℕ),
        G ∈ 𝒜_1 d →
        (G ∈ ProjectiveSpectrum.asHomogeneousIdeal (j_aff.base p) ↔
          MvPolynomial.eval₂ Polynomial.C ![1, Polynomial.X] G ∈ p.asIdeal) := by
      intro p G d hGd
      rcases Nat.eq_zero_or_pos d with rfl | hd_pos
      · have hGC := hDeg0_1 G hGd
        rw [hGC, MvPolynomial.eval₂_C]
        let q_p : ProjectiveSpectrum 𝒜_1 := j_aff.base p
        constructor
        · intro hc_in
          by_contra hc_not
          have hc_ne : G.coeff 0 ≠ 0 := by
            intro hc0; rw [hc0, map_zero] at hc_not; exact hc_not (Ideal.zero_mem _)
          have h1_in := Ideal.mul_mem_left q_p.asHomogeneousIdeal.toIdeal (MvPolynomial.C (G.coeff 0)⁻¹) hc_in
          rw [← map_mul, inv_mul_cancel₀ hc_ne, map_one] at h1_in
          exact q_p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1_in isUnit_one)
        · intro hc_in
          by_contra hc_not
          have hc_ne : G.coeff 0 ≠ 0 := by
            intro hc0; rw [hc0, map_zero] at hc_not; exact hc_not (Ideal.zero_mem _)
          have h1_in := Ideal.mul_mem_left p.asIdeal (Polynomial.C (G.coeff 0)⁻¹) hc_in
          rw [← map_mul, inv_mul_cancel₀ hc_ne, map_one] at h1_in
          exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1_in isUnit_one)
      · let q_p : X_1 := j_aff₀.base p
        have hmem_iff : G ∈ (q_p : ProjectiveSpectrum 𝒜_1).asHomogeneousIdeal ↔
            q_p ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_1 G := by
          rw [AlgebraicGeometry.Proj.mem_basicOpen, not_not]
        change G ∈ (q_p : ProjectiveSpectrum 𝒜_1).asHomogeneousIdeal ↔ _
        rw [hmem_iff]
        have hpre := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_1 hX0 zero_lt_one hGd hd_pos
        have hp_mem : q_p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_1 G ↔
            iso_e₀.hom.base p ∈ (TopologicalSpace.Opens.map away₀.base).obj
              (AlgebraicGeometry.Proj.basicOpen 𝒜_1 G) := Iff.rfl
        rw [hp_mem, hpre]
        let p_away : PrimeSpectrum (HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X 0)) :=
          iso_e₀.hom.base p
        have hbasic : p_away ∈ PrimeSpectrum.basicOpen
            (HomogeneousLocalization.Away.isLocalizationElem hX0 hGd) ↔
            e₀.symm (HomogeneousLocalization.Away.isLocalizationElem hX0 hGd) ∉ p.asIdeal :=
          PrimeSpectrum.mem_basicOpen _ p_away
        change p_away ∉ PrimeSpectrum.basicOpen
          (HomogeneousLocalization.Away.isLocalizationElem hX0 hGd) ↔ _
        rw [hbasic, not_not]
        have hX0d : (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) ^ d ∈ 𝒜_1 d :=
          (MvPolynomial.mem_homogeneousSubmodule d _).mpr (MvPolynomial.isHomogeneous_X_pow 0 d)
        have helem_eq : HomogeneousLocalization.Away.isLocalizationElem hX0 hGd =
            HomogeneousLocalization.mk ⟨d, ⟨G, hGd⟩, ⟨(MvPolynomial.X 0) ^ d, hX0d⟩,
              pow_mem (Submonoid.mem_powers (MvPolynomial.X 0)) d⟩ := by
          apply HomogeneousLocalization.val_injective
          dsimp [HomogeneousLocalization.Away.isLocalizationElem]
          simp [pow_one]
        rw [helem_eq, he₀_symm d G hGd ((MvPolynomial.X 0) ^ d) hX0d
          (pow_mem (Submonoid.mem_powers (MvPolynomial.X 0)) d)]
        rfl

    exact ⟨j_aff, s_inf,
      ⟨hOpen_jaff, h_jaff_hom, h_sinf_hom, hRange_jaff, hCompl_range, h_jaff_le₀, h_jaff_coord₀⟩,
      hIdeal_sinf, hIdeal_jaff⟩

  have part2_s3 :
      ∃ (ι_line : weilProjectiveSpaceOver k 1 ⟶ weilProjectiveSpaceOver k 2),
        IsStandardProjLineInPlane k ι_line ∧
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
          MvPolynomial.gradedAlgebra
         letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
          MvPolynomial.gradedAlgebra
         ∀ (q : (weilProjectiveSpaceOver k 1).left)
           (F : MvPolynomial (Fin 3) k) (d : ℕ),
           F ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d →
           (F ∈ ProjectiveSpectrum.asHomogeneousIdeal (ι_line.left.base q) ↔
             MvPolynomial.eval₂ MvPolynomial.C ![MvPolynomial.X 0, MvPolynomial.X 1, 0] F ∈
               ProjectiveSpectrum.asHomogeneousIdeal q)) := by
    classical
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
      MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
      MvPolynomial.gradedAlgebra
    let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k

    have hIrrel : ∀ (N : ℕ),
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
          MvPolynomial.gradedAlgebra
        (HomogeneousIdeal.irrelevant
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)).toIdeal ≤
          Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) k)) := by
      intro N
      let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      let _ : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
      intro p hp
      have hp0 : GradedRing.proj 𝒜_N 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜_N p).mp hp
      have hcoeff0 : p.coeff 0 = 0 := by
        have hdecomp := DirectSum.sum_support_decompose 𝒜_N p
        have hsum_coeff :
            (∑ i ∈ (DirectSum.decompose 𝒜_N p).support,
              ((DirectSum.decompose 𝒜_N p i : MvPolynomial (Fin (N + 1)) k)).coeff 0) =
            p.coeff 0 := by
          rw [← MvPolynomial.coeff_sum, hdecomp]
        rw [← hsum_coeff]
        refine Finset.sum_eq_zero fun i _ => ?_
        by_cases hi : i = 0
        · subst hi
          have h0 : (DirectSum.decompose 𝒜_N p 0 : MvPolynomial (Fin (N + 1)) k) = 0 := hp0
          rw [h0]; rfl
        · by_contra hne
          have hhom : ((DirectSum.decompose 𝒜_N p i :
              MvPolynomial (Fin (N + 1)) k)).IsHomogeneous i :=
            (MvPolynomial.mem_homogeneousSubmodule i _).mp (DirectSum.decompose 𝒜_N p i).2
          have hdeg := hhom hne
          simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at hdeg
          exact hi hdeg.symm
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm_ne : m ≠ 0 := by
        intro h0; rw [h0] at hm; exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
      by_contra h_all
      apply hm_ne
      ext i
      by_contra hmi
      exact h_all ⟨i, Set.mem_univ i, hmi⟩

    let v_line : Fin 3 → MvPolynomial (Fin 2) k := ![MvPolynomial.X 0, MvPolynomial.X 1, 0]
    have hv_homog : ∀ i : Fin 3, (v_line i).IsHomogeneous 1 := by
      intro i; fin_cases i
      · exact MvPolynomial.isHomogeneous_X k 0
      · exact MvPolynomial.isHomogeneous_X k 1
      · exact MvPolynomial.isHomogeneous_zero (Fin 2) k 1
    let π₀ : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 2) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C v_line
    let π_line : 𝒜_2 →+*ᵍ 𝒜_1 :=
      { toRingHom := π₀
        map_mem := fun {d F} hF => by
          have hF' : F.IsHomogeneous d := hF
          have h1 := hF'.eval₂ MvPolynomial.C v_line
            (fun c => MvPolynomial.isHomogeneous_C (Fin 2) c) hv_homog
          rwa [one_mul] at h1 }

    have hπ_X_cast : ∀ b : Fin 2, π_line (MvPolynomial.X b.castSucc) = MvPolynomial.X b := by
      intro b
      change MvPolynomial.eval₂Hom MvPolynomial.C v_line (MvPolynomial.X b.castSucc) = _
      rw [MvPolynomial.eval₂Hom_X']
      fin_cases b <;> rfl
    have hπ_X2 : π_line (MvPolynomial.X 2) = 0 := by
      change MvPolynomial.eval₂Hom MvPolynomial.C v_line (MvPolynomial.X 2) = 0
      rw [MvPolynomial.eval₂Hom_X']
      rfl
    have hπ_C : ∀ c : k, π_line (MvPolynomial.C c) = MvPolynomial.C c := by
      intro c
      exact MvPolynomial.eval₂Hom_C MvPolynomial.C v_line c

    let σ_lift : MvPolynomial (Fin 2) k →+* MvPolynomial (Fin 3) k :=
      (MvPolynomial.rename Fin.castSucc).toRingHom
    have hπ_σ : π₀.comp σ_lift = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c; simp [π₀, σ_lift]
      · intro b; fin_cases b <;> simp [π₀, σ_lift, v_line]
    have hσ_homog : ∀ {d : ℕ} {G : MvPolynomial (Fin 2) k}, G ∈ 𝒜_1 d → σ_lift G ∈ 𝒜_2 d := by
      intro d G hG
      have hG' : G.IsHomogeneous d := hG
      exact hG'.rename_isHomogeneous

    have hf_line : HomogeneousIdeal.irrelevant 𝒜_1 ≤
        HomogeneousIdeal.map π_line (HomogeneousIdeal.irrelevant 𝒜_2) := by
      change (HomogeneousIdeal.irrelevant 𝒜_1).toIdeal ≤
        (HomogeneousIdeal.map π_line (HomogeneousIdeal.irrelevant 𝒜_2)).toIdeal
      rw [HomogeneousIdeal.toIdeal_map]
      refine (hIrrel 1).trans (Ideal.span_le.mpr ?_)
      rintro _ ⟨b, rfl⟩
      rw [← hπ_X_cast b]
      exact Ideal.mem_map_of_mem π_line.toRingHom
        (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_2 zero_lt_one
          (MvPolynomial.isHomogeneous_X k b.castSucc))

    let ι_left : AlgebraicGeometry.Proj 𝒜_1 ⟶ AlgebraicGeometry.Proj 𝒜_2 :=
      AlgebraicGeometry.Proj.map π_line hf_line

    let U_1_raw : Fin 2 → (AlgebraicGeometry.Proj 𝒜_1).Opens :=
      fun b => AlgebraicGeometry.Proj.basicOpen 𝒜_1 (π_line (MvPolynomial.X b.castSucc))
    have h_iSup_P1 : iSup U_1_raw = ⊤ := by
      refine AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜_1 _ ?_
      refine (hIrrel 1).trans (Ideal.span_le.mpr ?_)
      rintro _ ⟨b, rfl⟩
      rw [← hπ_X_cast b]
      exact Ideal.subset_span ⟨b, rfl⟩

    have h_over : ι_left ≫ (weilProjectiveSpaceOver k 2).hom =
        (weilProjectiveSpaceOver k 1).hom := by
      let p2_hom : AlgebraicGeometry.Proj 𝒜_2 ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Proj.toSpecZero 𝒜_2 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_2 0)))
      let p1_hom : AlgebraicGeometry.Proj 𝒜_1 ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Proj.toSpecZero 𝒜_1 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_1 0)))
      change ι_left ≫ p2_hom = p1_hom
      let 𝒰 := AlgebraicGeometry.Scheme.openCoverOfIsOpenCover
        (AlgebraicGeometry.Proj 𝒜_1) U_1_raw (TopologicalSpace.IsOpenCover.mk h_iSup_P1)
      apply AlgebraicGeometry.Scheme.Cover.hom_ext 𝒰
      intro b_idx
      let b : Fin 2 := b_idx
      change (U_1_raw b).ι ≫ ι_left ≫ p2_hom = (U_1_raw b).ι ≫ p1_hom
      have hX2_mem : (MvPolynomial.X b.castSucc : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1 :=
        MvPolynomial.isHomogeneous_X k b.castSucc
      have hX1_mem : π_line (MvPolynomial.X b.castSucc) ∈ 𝒜_1 1 := π_line.map_mem hX2_mem
      let iso₁ := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_1
        (π_line (MvPolynomial.X b.castSucc)) hX1_mem zero_lt_one
      apply (CategoryTheory.cancel_epi iso₁.inv).mp
      rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι_assoc,
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι_assoc]
      change (AlgebraicGeometry.Proj.awayι 𝒜_1 (π_line (MvPolynomial.X b.castSucc)) hX1_mem zero_lt_one ≫
        ι_left) ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜_2 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_2 0)))) =
        AlgebraicGeometry.Proj.awayι 𝒜_1 (π_line (MvPolynomial.X b.castSucc)) hX1_mem zero_lt_one ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜_1 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_1 0))))
      rw [AlgebraicGeometry.Proj.awayι_comp_map π_line hf_line zero_lt_one
        (MvPolynomial.X b.castSucc) hX2_mem]
      simp only [CategoryTheory.Category.assoc]
      rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.Proj.awayι 𝒜_2 _ _ _),
        AlgebraicGeometry.Proj.awayι_toSpecZero,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Proj.awayι 𝒜_1 _ _ _),
        AlgebraicGeometry.Proj.awayι_toSpecZero,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      apply HomogeneousLocalization.val_injective
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
      change (HomogeneousLocalization.map π_line _
        (HomogeneousLocalization.mk
          { deg := 0
            num := algebraMap k ↥(𝒜_2 0) c
            den := ⟨1, SetLike.one_mem_graded 𝒜_2⟩
            den_mem := Submonoid.one_mem _ })).val =
        (HomogeneousLocalization.mk
          { deg := 0
            num := algebraMap k ↥(𝒜_1 0) c
            den := ⟨1, SetLike.one_mem_graded 𝒜_1⟩
            den_mem := Submonoid.one_mem _ }).val
      rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
        HomogeneousLocalization.val_mk]
      have hc2 : (algebraMap k ↥(𝒜_2 0) c : MvPolynomial (Fin 3) k) = MvPolynomial.C c := by
        rw [Algebra.algebraMap_eq_smul_one, Algebra.smul_def, mul_one]; rfl
      have hc1 : (algebraMap k ↥(𝒜_1 0) c : MvPolynomial (Fin 2) k) = MvPolynomial.C c := by
        rw [Algebra.algebraMap_eq_smul_one, Algebra.smul_def, mul_one]; rfl
      refine Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq ?_)
      dsimp only
      rw [one_mul, map_one, one_mul, hc2, hc1, hπ_C c]

    let ι_line : weilProjectiveSpaceOver k 1 ⟶ weilProjectiveSpaceOver k 2 :=
      CategoryTheory.Over.homMk ι_left h_over

    have hRange_line : Set.range ι_line.left.base =
        weilProjHyperplaneSet k 2 (MvPolynomial.X 2) := by
      ext p
      let p' : AlgebraicGeometry.Proj 𝒜_2 := p
      let p_spec : ProjectiveSpectrum 𝒜_2 := p
      have hp_iff : p ∈ weilProjHyperplaneSet k 2 (MvPolynomial.X 2) ↔
          MvPolynomial.X 2 ∈ p_spec.asHomogeneousIdeal := by
        change p' ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X 2) ↔ _
        rw [AlgebraicGeometry.Proj.mem_basicOpen, not_not]
      rw [hp_iff]
      constructor
      · rintro ⟨q, rfl⟩
        change π_line (MvPolynomial.X 2) ∈ (q : ProjectiveSpectrum 𝒜_1).asHomogeneousIdeal
        rw [hπ_X2]
        exact Ideal.zero_mem _
      · intro hX2_in
        let σ_gr : 𝒜_1 →+*ᵍ 𝒜_2 :=
          { toRingHom := σ_lift
            map_mem := fun {_ _} hG => hσ_homog hG }
        let q_hom : HomogeneousIdeal 𝒜_1 := p_spec.asHomogeneousIdeal.comap σ_gr
        have : p_spec.asHomogeneousIdeal.toIdeal.IsPrime := p_spec.isPrime
        have hq_prime : q_hom.toIdeal.IsPrime := Ideal.IsPrime.comap σ_lift
        have hq_not_irr : ¬ HomogeneousIdeal.irrelevant 𝒜_1 ≤ q_hom := by
          intro hle
          have hX0_q : (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) ∈ q_hom :=
            hle (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_1 zero_lt_one (MvPolynomial.isHomogeneous_X k 0))
          have hX1_q : (MvPolynomial.X 1 : MvPolynomial (Fin 2) k) ∈ q_hom :=
            hle (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_1 zero_lt_one (MvPolynomial.isHomogeneous_X k 1))
          have hX0_in : (MvPolynomial.X 0 : MvPolynomial (Fin 3) k) ∈ p_spec.asHomogeneousIdeal := by
            change σ_lift (MvPolynomial.X 0) ∈ p_spec.asHomogeneousIdeal at hX0_q
            simpa [σ_lift] using hX0_q
          have hX1_in : (MvPolynomial.X 1 : MvPolynomial (Fin 3) k) ∈ p_spec.asHomogeneousIdeal := by
            change σ_lift (MvPolynomial.X 1) ∈ p_spec.asHomogeneousIdeal at hX1_q
            simpa [σ_lift] using hX1_q
          apply p_spec.not_irrelevant_le
          change (HomogeneousIdeal.irrelevant 𝒜_2).toIdeal ≤ p_spec.asHomogeneousIdeal.toIdeal
          refine (hIrrel 2).trans (Ideal.span_le.mpr ?_)
          rintro _ ⟨j, rfl⟩
          fin_cases j
          · exact hX0_in
          · exact hX1_in
          · exact hX2_in
        let q_pt : ProjectiveSpectrum 𝒜_1 := ⟨q_hom, hq_prime, hq_not_irr⟩
        have h_diff_X2 : ∀ F : MvPolynomial (Fin 3) k,
            MvPolynomial.X 2 ∣ F - σ_lift (π₀ F) := by
          intro F
          induction F using MvPolynomial.induction_on with
          | C c => simp [π₀, σ_lift]
          | add A B hA hB =>
            rw [map_add, map_add, add_sub_add_comm]
            exact dvd_add hA hB
          | mul_X A j hA =>
            have hFin3 : ∀ x : Fin 3, x = 0 ∨ x = 1 ∨ x = 2 := by decide
            rw [map_mul, map_mul]
            rcases hFin3 j with rfl | rfl | rfl
            · have hX0 : σ_lift (π₀ (MvPolynomial.X 0)) = MvPolynomial.X 0 := by
                simp [π₀, σ_lift, v_line]
              rw [hX0]
              have hid : A * MvPolynomial.X 0 - σ_lift (π₀ A) * MvPolynomial.X 0 =
                  (A - σ_lift (π₀ A)) * MvPolynomial.X 0 := by ring
              rw [hid]
              exact dvd_mul_of_dvd_left hA _
            · have hX1 : σ_lift (π₀ (MvPolynomial.X 1)) = MvPolynomial.X 1 := by
                simp [π₀, σ_lift, v_line]
              rw [hX1]
              have hid : A * MvPolynomial.X 1 - σ_lift (π₀ A) * MvPolynomial.X 1 =
                  (A - σ_lift (π₀ A)) * MvPolynomial.X 1 := by ring
              rw [hid]
              exact dvd_mul_of_dvd_left hA _
            · have hX2_0 : σ_lift (π₀ (MvPolynomial.X 2)) = 0 := by
                simp [π₀, σ_lift, v_line]
              rw [hX2_0, mul_zero, sub_zero]
              exact ⟨A, mul_comm A _⟩
        refine ⟨q_pt, ?_⟩
        apply ProjectiveSpectrum.ext
        ext F
        change σ_lift (π₀ F) ∈ p_spec.asHomogeneousIdeal.toIdeal ↔
          F ∈ p_spec.asHomogeneousIdeal.toIdeal
        rcases h_diff_X2 F with ⟨H, hFH⟩
        have hH_mem : MvPolynomial.X 2 * H ∈ p_spec.asHomogeneousIdeal.toIdeal :=
          Ideal.mul_mem_right H _ hX2_in
        constructor
        · intro hσ_in
          have hsum := Ideal.add_mem p_spec.asHomogeneousIdeal.toIdeal (hFH ▸ hH_mem) hσ_in
          simpa only [sub_add_cancel] using hsum
        · intro hF_in
          have hsub := Ideal.sub_mem p_spec.asHomogeneousIdeal.toIdeal hF_in (hFH ▸ hH_mem)
          simpa only [sub_sub_cancel] using hsub

    have hCoords_line : ∀ b : Fin 2,
        let U₁ := AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b)
        let U₂ := AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X b.castSucc)
        ∃ h_b : U₁ ≤ (TopologicalSpace.Opens.map ι_line.left.base).obj U₂,
          (∀ a : Fin 2,
            ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X b.castSucc)
                (MvPolynomial.isHomogeneous_X k b.castSucc) zero_lt_one).hom ≫
              ι_line.left.appLE U₂ U₁ h_b).hom
              (HomogeneousLocalization.mk
                ⟨1, ⟨MvPolynomial.X a.castSucc, MvPolynomial.isHomogeneous_X k a.castSucc⟩,
                  ⟨MvPolynomial.X b.castSucc, MvPolynomial.isHomogeneous_X k b.castSucc⟩,
                  ⟨1, pow_one _⟩⟩) =
            (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b)
              (MvPolynomial.isHomogeneous_X k b) zero_lt_one).hom.hom
              (HomogeneousLocalization.mk
                ⟨1, ⟨MvPolynomial.X a, MvPolynomial.isHomogeneous_X k a⟩,
                  ⟨MvPolynomial.X b, MvPolynomial.isHomogeneous_X k b⟩, ⟨1, pow_one _⟩⟩)) ∧
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X b.castSucc)
              (MvPolynomial.isHomogeneous_X k b.castSucc) zero_lt_one).hom ≫
            ι_line.left.appLE U₂ U₁ h_b).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨MvPolynomial.X 2, MvPolynomial.isHomogeneous_X k 2⟩,
                ⟨MvPolynomial.X b.castSucc, MvPolynomial.isHomogeneous_X k b.castSucc⟩,
                ⟨1, pow_one _⟩⟩) = 0 := by
      intro b
      let U₁ := AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b)
      let U₂ := AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X b.castSucc)
      have hpre_eq : (TopologicalSpace.Opens.map ι_left.base).obj U₂ = U₁ := by
        have h1 := AlgebraicGeometry.Proj.map_preimage_basicOpen π_line hf_line
          (MvPolynomial.X b.castSucc)
        dsimp only [U₁, U₂, ι_left]
        rw [h1, hπ_X_cast b]
      have h_b0 : U₁ ≤ (TopologicalSpace.Opens.map ι_left.base).obj U₂ :=
        le_of_eq hpre_eq.symm
      have hXb2 : (MvPolynomial.X b.castSucc : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1 :=
        MvPolynomial.isHomogeneous_X k b.castSucc
      have hXb1 : (MvPolynomial.X b : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1 :=
        MvPolynomial.isHomogeneous_X k b
      have hsub_b : Submonoid.powers (MvPolynomial.X b.castSucc : MvPolynomial (Fin 3) k) ≤
          Submonoid.comap π_line
            (Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin 2) k)) := by
        rintro _ ⟨n, rfl⟩
        simp only [Submonoid.mem_comap, map_pow]
        rw [hπ_X_cast b]
        exact ⟨n, rfl⟩
      let φ_map_b : HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X b.castSucc) →+*
          HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) :=
        HomogeneousLocalization.map π_line hsub_b
      let ψ_lhs : CommRingCat.of (HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X b.castSucc)) ⟶
          (AlgebraicGeometry.Proj 𝒜_1).presheaf.obj (Opposite.op U₁) :=
        (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X b.castSucc) hXb2 zero_lt_one).hom ≫
          ι_left.appLE U₂ U₁ h_b0
      let ψ_rhs : CommRingCat.of (HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X b.castSucc)) ⟶
          (AlgebraicGeometry.Proj 𝒜_1).presheaf.obj (Opposite.op U₁) :=
        CommRingCat.ofHom φ_map_b ≫
          (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b) hXb1 zero_lt_one).hom
      have hψ_eq : ψ_lhs = ψ_rhs := by
        have hAffU₁ : AlgebraicGeometry.IsAffineOpen U₁ :=
          AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_1 (MvPolynomial.X b) hXb1 zero_lt_one
        have : CategoryTheory.IsIso U₁.toSpecΓ := by
          rw [← hAffU₁.isoSpec_hom]; infer_instance
        apply AlgebraicGeometry.Spec.map_injective
        apply (CategoryTheory.cancel_epi U₁.toSpecΓ).mp
        let away₂ := AlgebraicGeometry.Proj.awayι 𝒜_2 (MvPolynomial.X b.castSucc) hXb2 zero_lt_one
        have hSpec_away : (U₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ_lhs) ≫ away₂ =
            (U₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ_rhs) ≫ away₂ := by
          have hlhs : (U₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ_lhs) ≫ away₂ =
              U₁.ι ≫ ι_left := by
            dsimp only [ψ_lhs, away₂]
            rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom, AlgebraicGeometry.Spec.map_comp,
              AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE_assoc]
            change (ι_left.resLE U₂ U₁ h_b0 ≫
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_2 (MvPolynomial.X b.castSucc) hXb2 zero_lt_one).hom) ≫
              AlgebraicGeometry.Proj.awayι 𝒜_2 (MvPolynomial.X b.castSucc) hXb2 zero_lt_one = _
            rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_2 (MvPolynomial.X b.castSucc) hXb2 zero_lt_one,
              CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc,
              AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
          have hrhs : (U₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ_rhs) ≫ away₂ =
              U₁.ι ≫ ι_left := by
            dsimp only [ψ_rhs]
            rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom, AlgebraicGeometry.Spec.map_comp,
              ← CategoryTheory.Category.assoc U₁.toSpecΓ]
            change ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_1 (MvPolynomial.X b) hXb1 zero_lt_one).hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_map_b)) ≫ away₂ = U₁.ι ≫ ι_left
            have hsub_eq1 : Submonoid.powers (π_line (MvPolynomial.X b.castSucc)) ≤
                Submonoid.comap (GradedRingHom.id 𝒜_1)
                  (Submonoid.powers (MvPolynomial.X b)) := by
              rintro _ ⟨n, rfl⟩
              simp only [Submonoid.mem_comap, GradedRingHom.id_apply, hπ_X_cast b]
              exact ⟨n, rfl⟩
            have hsub_eq2 : Submonoid.powers (MvPolynomial.X b) ≤
                Submonoid.comap (GradedRingHom.id 𝒜_1)
                  (Submonoid.powers (π_line (MvPolynomial.X b.castSucc))) := by
              rintro _ ⟨n, rfl⟩
              simp only [Submonoid.mem_comap, GradedRingHom.id_apply, ← hπ_X_cast b]
              exact ⟨n, rfl⟩
            let e_id1 : HomogeneousLocalization.Away 𝒜_1 (π_line (MvPolynomial.X b.castSucc)) →+*
                HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) :=
              HomogeneousLocalization.map (GradedRingHom.id 𝒜_1) hsub_eq1
            let e_id2 : HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b) →+*
                HomogeneousLocalization.Away 𝒜_1 (π_line (MvPolynomial.X b.castSucc)) :=
              HomogeneousLocalization.map (GradedRingHom.id 𝒜_1) hsub_eq2
            have hφ_comp : e_id1.comp (HomogeneousLocalization.Away.map π_line
                (MvPolynomial.X b.castSucc)) = φ_map_b := by
              apply RingHom.ext
              intro z
              obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective z
              apply HomogeneousLocalization.val_injective
              dsimp only [RingHom.comp_apply, e_id1, HomogeneousLocalization.Away.map, φ_map_b]
              rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.map_mk,
                HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
                HomogeneousLocalization.val_mk]
              rfl
            have h_away_id : AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_id2) ≫
                AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) hXb1 zero_lt_one =
                AlgebraicGeometry.Proj.awayι 𝒜_1 (π_line (MvPolynomial.X b.castSucc))
                  (π_line.map_mem hXb2) zero_lt_one := by
              have heq_f : π_line (MvPolynomial.X b.castSucc) = MvPolynomial.X b := hπ_X_cast b
              revert e_id2 hsub_eq2
              have hmem' : π_line (MvPolynomial.X b.castSucc) ∈ 𝒜_1 1 := π_line.map_mem hXb2
              change ∀ (hsub2 : Submonoid.powers (MvPolynomial.X b) ≤ _),
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (HomogeneousLocalization.map (GradedRingHom.id 𝒜_1) hsub2)) ≫
                  AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) hXb1 zero_lt_one =
                  AlgebraicGeometry.Proj.awayι 𝒜_1 (π_line (MvPolynomial.X b.castSucc))
                    hmem' zero_lt_one
              generalize π_line (MvPolynomial.X b.castSucc) = f_b at heq_f hmem'
              subst heq_f
              intro hsub2
              have hid_hom : HomogeneousLocalization.map (GradedRingHom.id 𝒜_1) hsub2 =
                  RingHom.id _ := by
                apply RingHom.ext
                intro z
                obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective z
                apply HomogeneousLocalization.val_injective
                rw [RingHom.id_apply, HomogeneousLocalization.map_mk,
                  HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
                rfl
              rw [hid_hom, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id,
                CategoryTheory.Category.id_comp]
            have he12 : e_id1.comp e_id2 = RingHom.id _ := by
              apply RingHom.ext
              intro z
              obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective z
              apply HomogeneousLocalization.val_injective
              rw [RingHom.comp_apply, RingHom.id_apply]
              change (HomogeneousLocalization.map (GradedRingHom.id 𝒜_1) hsub_eq1
                (HomogeneousLocalization.map (GradedRingHom.id 𝒜_1) hsub_eq2
                  (HomogeneousLocalization.mk nd))).val = (HomogeneousLocalization.mk nd).val
              rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.map_mk,
                HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
              rfl
            have h_away_b : AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) hXb1 zero_lt_one ≫
                ι_left = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_map_b) ≫ away₂ := by
              calc AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) hXb1 zero_lt_one ≫ ι_left
                  = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e_id1.comp e_id2)) ≫
                      AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) hXb1 zero_lt_one) ≫
                      ι_left := by
                    rw [he12, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id,
                      CategoryTheory.Category.id_comp]
                _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_id1) ≫
                      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_id2) ≫
                        AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) hXb1 zero_lt_one) ≫
                      ι_left := by
                    rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
                    simp only [CategoryTheory.Category.assoc]
                _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_id1) ≫
                      AlgebraicGeometry.Proj.awayι 𝒜_1 (π_line (MvPolynomial.X b.castSucc))
                        (π_line.map_mem hXb2) zero_lt_one ≫ ι_left := by
                    rw [h_away_id]
                _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_id1) ≫
                      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                        (HomogeneousLocalization.Away.map π_line (MvPolynomial.X b.castSucc))) ≫
                      away₂ := by
                    dsimp only [ι_left, away₂]
                    rw [AlgebraicGeometry.Proj.awayι_comp_map π_line hf_line zero_lt_one
                      (MvPolynomial.X b.castSucc) hXb2]
                _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_map_b) ≫ away₂ := by
                    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                      ← CommRingCat.ofHom_comp, hφ_comp]
            rw [CategoryTheory.Category.assoc, ← h_away_b, ← CategoryTheory.Category.assoc]
            have hiso1 : (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_1 (MvPolynomial.X b) hXb1
                zero_lt_one).hom ≫
                AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) hXb1 zero_lt_one = U₁.ι := by
              rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_1 (MvPolynomial.X b) hXb1 zero_lt_one,
                CategoryTheory.Iso.hom_inv_id_assoc]
            rw [hiso1]
          rw [hlhs, hrhs]
        dsimp only [away₂] at hSpec_away
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_2 (MvPolynomial.X b.castSucc) hXb2 zero_lt_one,
          ← CategoryTheory.Category.assoc _ _ U₂.ι,
          ← CategoryTheory.Category.assoc _ _ U₂.ι] at hSpec_away
        exact (CategoryTheory.cancel_mono _).mp ((CategoryTheory.cancel_mono U₂.ι).mp hSpec_away)
      refine ⟨h_b0, ?_, ?_⟩
      · intro a
        change ψ_lhs.hom _ = _
        rw [hψ_eq]
        simp only [ψ_rhs, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        congr 1
        apply HomogeneousLocalization.val_injective
        dsimp only [φ_map_b]
        rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
          HomogeneousLocalization.val_mk]
        exact congrArg₂ Localization.mk (hπ_X_cast a) (Subtype.ext (hπ_X_cast b))
      · change ψ_lhs.hom _ = 0
        rw [hψ_eq]
        simp only [ψ_rhs, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        have hX2_1 : (MvPolynomial.X 2 : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1 :=
          MvPolynomial.isHomogeneous_X k 2
        have h0 : φ_map_b (HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X 2, hX2_1⟩,
              ⟨MvPolynomial.X b.castSucc, hXb2⟩,
              Submonoid.mem_powers (MvPolynomial.X b.castSucc)⟩) = 0 := by
          apply HomogeneousLocalization.val_injective
          dsimp only [φ_map_b]
          rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
            HomogeneousLocalization.val_zero, ← Localization.mk_zero 1]
          refine Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq ?_)
          dsimp only
          rw [Submonoid.coe_one, one_mul, mul_zero, hπ_X2]
        rw [h0, map_zero]

    have hClosed_line : AlgebraicGeometry.IsClosedImmersion ι_line.left := by
      let U_cov : Fin 3 → (AlgebraicGeometry.Proj 𝒜_2).Opens :=
        fun j => AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X j)
      have h_iSup_P2 : iSup U_cov = ⊤ :=
        AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜_2 MvPolynomial.X (hIrrel 2)
      change AlgebraicGeometry.IsClosedImmersion ι_left
      refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top U_cov h_iSup_P2 ?_
      intro j
      have h_chart_01 : ∀ b : Fin 2,
          AlgebraicGeometry.IsClosedImmersion (ι_left ∣_ U_cov b.castSucc) := by
        intro b
        have hXj : (MvPolynomial.X b.castSucc : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1 :=
          MvPolynomial.isHomogeneous_X k b.castSucc
        have hπXj : π_line (MvPolynomial.X b.castSucc) ∈ 𝒜_1 1 := π_line.map_mem hXj
        let W_b : (AlgebraicGeometry.Proj 𝒜_1).Opens :=
          (TopologicalSpace.Opens.map ι_left.base).obj (U_cov b.castSucc)
        have hWb_eq : W_b = AlgebraicGeometry.Proj.basicOpen 𝒜_1 (π_line (MvPolynomial.X b.castSucc)) :=
          AlgebraicGeometry.Proj.map_preimage_basicOpen π_line hf_line (MvPolynomial.X b.castSucc)
        let iso_tgt := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_2 (MvPolynomial.X b.castSucc) hXj zero_lt_one
        let iso_src := (AlgebraicGeometry.Proj 𝒜_1).isoOfEq hWb_eq ≪≫
          AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_1 (π_line (MvPolynomial.X b.castSucc)) hπXj zero_lt_one
        let φ_loc := HomogeneousLocalization.Away.map π_line (MvPolynomial.X b.castSucc)
        have hφ_surj : Function.Surjective φ_loc := by
          intro z
          obtain ⟨n, G, hG, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_1 hπXj z
          have hG_hom : G ∈ 𝒜_1 n := by rwa [nsmul_one] at hG
          have hσG_hom : σ_lift G ∈ 𝒜_2 (n • 1) := by
            rw [nsmul_one]
            exact hσ_homog hG_hom
          refine ⟨HomogeneousLocalization.Away.mk 𝒜_2 hXj n (σ_lift G) hσG_hom, ?_⟩
          apply HomogeneousLocalization.val_injective
          change (HomogeneousLocalization.map π_line _
            (HomogeneousLocalization.mk
              { deg := n • 1
                num := ⟨σ_lift G, hσG_hom⟩
                den := ⟨MvPolynomial.X b.castSucc ^ n, SetLike.pow_mem_graded n hXj⟩
                den_mem := pow_mem (Submonoid.mem_powers (MvPolynomial.X b.castSucc)) n })).val =
            (HomogeneousLocalization.Away.mk 𝒜_1 hπXj n G hG).val
          rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
            HomogeneousLocalization.Away.val_mk]
          exact congrArg₂ Localization.mk (DFunLike.congr_fun hπ_σ G)
            (Subtype.ext (map_pow π_line (MvPolynomial.X b.castSucc) n))
        have : AlgebraicGeometry.IsClosedImmersion
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc)) :=
          AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom φ_loc) hφ_surj
        have h_comm_sq : iso_src.inv ≫ (ι_left ∣_ U_cov b.castSucc) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫ iso_tgt.inv := by
          apply (CategoryTheory.cancel_mono (U_cov b.castSucc).ι).mp
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι,
            AlgebraicGeometry.morphismRestrict_ι]
          dsimp only [iso_src, CategoryTheory.Iso.trans_inv]
          have hiso_ι : ((AlgebraicGeometry.Proj 𝒜_1).isoOfEq hWb_eq).inv ≫ W_b.ι =
              (AlgebraicGeometry.Proj.basicOpen 𝒜_1 (π_line (MvPolynomial.X b.castSucc))).ι := by
            rw [CategoryTheory.Iso.inv_comp_eq, AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
          change (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_1
              (π_line (MvPolynomial.X b.castSucc)) hπXj zero_lt_one).inv ≫
            (((AlgebraicGeometry.Proj 𝒜_1).isoOfEq hWb_eq).inv ≫ W_b.ι) ≫ ι_left = _
          rw [hiso_ι, ← CategoryTheory.Category.assoc,
            AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
          exact AlgebraicGeometry.Proj.awayι_comp_map π_line hf_line zero_lt_one
            (MvPolynomial.X b.castSucc) hXj
        have h_factor : (ι_left ∣_ U_cov b.castSucc) =
            iso_src.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫ iso_tgt.inv := by
          rw [← h_comm_sq, CategoryTheory.Iso.hom_inv_id_assoc]
        rw [h_factor]
        infer_instance
      have hFin3 : ∀ x : Fin 3, x = 0 ∨ x = 1 ∨ x = 2 := by decide
      rcases hFin3 j with rfl | rfl | rfl
      · exact h_chart_01 0
      · exact h_chart_01 1
      · let W_2 : (AlgebraicGeometry.Proj 𝒜_1).Opens :=
          (TopologicalSpace.Opens.map ι_left.base).obj (U_cov 2)
        have hW2_bot : W_2 = ⊥ := by
          have h1 := AlgebraicGeometry.Proj.map_preimage_basicOpen π_line hf_line (MvPolynomial.X 2)
          dsimp only [W_2, U_cov, ι_left]
          rw [h1, hπ_X2, AlgebraicGeometry.Proj.basicOpen_zero]
        have : IsEmpty ↥W_2.toScheme := by
          rw [hW2_bot]
          exact ⟨fun x => x.2⟩
        have : AlgebraicGeometry.IsAffine W_2.toScheme :=
          AlgebraicGeometry.isAffine_of_isEmpty
        have hAff_tgt : AlgebraicGeometry.IsAffineOpen (U_cov 2) :=
          AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_2 (MvPolynomial.X 2)
            (MvPolynomial.isHomogeneous_X k 2) zero_lt_one
        have : AlgebraicGeometry.IsAffine (U_cov 2).toScheme := hAff_tgt
        apply AlgebraicGeometry.IsClosedImmersion.of_surjective_of_isAffine
        intro y
        exact ⟨0, Subsingleton.elim _ _⟩

    refine ⟨ι_line, ⟨hClosed_line, hRange_line, hCoords_line⟩, ?_⟩
    intro q F d _
    exact Iff.rfl

  have part3_s4 : ∀ (D : ℕ) (_ : 1 ≤ D) (P : MvPolynomial (Fin 3) k)
      (_ : P ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k D)
      (_ : Irreducible P) (β : Fin 3),
      let dehom : MvPolynomial (Fin 3) k →+* MvPolynomial {r : Fin 3 // r ≠ β} k :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (fun j : Fin 3 => if h : j = β then 1 else MvPolynomial.X ⟨j, h⟩)
      (Ideal.span {dehom P}).IsRadical ∧
      (∀ (I : Ideal (MvPolynomial (Fin 3) k)),
        I.IsPrime → P ∈ I → MvPolynomial.X β ∉ I →
        (∃ r₀ : Fin 3, MvPolynomial.pderiv r₀ P ∉ I) →
        ∃ r : {r : Fin 3 // r ≠ β}, MvPolynomial.pderiv r.1 P ∉ I) ∧
      (∀ (r : {r : Fin 3 // r ≠ β}) (h₀ : MvPolynomial {r : Fin 3 // r ≠ β} k),
        RingHom.IsStandardSmoothOfRelativeDimension 1
          (((Ideal.Quotient.mk (Ideal.span
              {algebraMap (MvPolynomial {r : Fin 3 // r ≠ β} k)
                (Localization.Away (h₀ * dehom (MvPolynomial.pderiv r.1 P)))
                (dehom P)})).comp
            (algebraMap (MvPolynomial {r : Fin 3 // r ≠ β} k)
              (Localization.Away (h₀ * dehom (MvPolynomial.pderiv r.1 P))))).comp
            MvPolynomial.C)) := by
    intro D hD P hHomog hIrred β
    classical
    let τ := {r : Fin 3 // r ≠ β}
    let dehom : MvPolynomial (Fin 3) k →+* MvPolynomial τ k :=
      MvPolynomial.eval₂Hom MvPolynomial.C
        (fun j : Fin 3 => if h : j = β then 1 else MvPolynomial.X ⟨j, h⟩)
    change (Ideal.span {dehom P}).IsRadical ∧
      (∀ (I : Ideal (MvPolynomial (Fin 3) k)),
        I.IsPrime → P ∈ I → MvPolynomial.X β ∉ I →
        (∃ r₀ : Fin 3, MvPolynomial.pderiv r₀ P ∉ I) →
        ∃ r : τ, MvPolynomial.pderiv r.1 P ∉ I) ∧
      (∀ (r : τ) (h₀ : MvPolynomial τ k),
        RingHom.IsStandardSmoothOfRelativeDimension 1
          (((Ideal.Quotient.mk (Ideal.span
              {algebraMap (MvPolynomial τ k)
                (Localization.Away (h₀ * dehom (MvPolynomial.pderiv r.1 P)))
                (dehom P)})).comp
            (algebraMap (MvPolynomial τ k)
              (Localization.Away (h₀ * dehom (MvPolynomial.pderiv r.1 P))))).comp
            MvPolynomial.C))

    have hdehom_C : ∀ c : k, dehom (MvPolynomial.C c) = MvPolynomial.C c :=
      fun c => MvPolynomial.eval₂Hom_C _ _ c
    have hdehom_X : ∀ j : Fin 3,
        dehom (MvPolynomial.X j) = if h : j = β then 1 else MvPolynomial.X ⟨j, h⟩ :=
      fun j => MvPolynomial.eval₂Hom_X' _ _ j

    have hXβ_ne : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ≠ 0 :=
      MvPolynomial.X_ne_zero β
    have hXβ_not_unit : ¬ IsUnit (MvPolynomial.X β : MvPolynomial (Fin 3) k) := by
      rintro ⟨u, hu⟩
      have hmul : (u : MvPolynomial (Fin 3) k) * ↑u⁻¹ = 1 := Units.mul_inv u
      rw [hu] at hmul
      have h1 := congrArg (MvPolynomial.eval (0 : Fin 3 → k)) hmul
      simp at h1

    have hRad : (Ideal.span {dehom P}).IsRadical := by
      by_cases hdvd : MvPolynomial.X β ∣ P
      · rcases hdvd with ⟨U, hPU⟩
        have hU_unit : IsUnit U := (hIrred.isUnit_or_isUnit hPU).resolve_left hXβ_not_unit
        have hdehom_unit : IsUnit (dehom P) := by
          rw [hPU, map_mul, hdehom_X β, dif_pos rfl, one_mul]
          exact hU_unit.map dehom
        rw [Ideal.span_singleton_eq_top.mpr hdehom_unit]
        intro _ _
        trivial
      · let S_pow := Submonoid.powers (MvPolynomial.X β : MvPolynomial (Fin 3) k)
        let xβ_mem : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ∈ S_pow :=
          Submonoid.mem_powers _
        let L_β := Localization.Away (MvPolynomial.X β : MvPolynomial (Fin 3) k)
        let c_loc : k →+* L_β := (algebraMap (MvPolynomial (Fin 3) k) L_β).comp MvPolynomial.C
        let v_loc : τ → L_β := fun i => Localization.mk (MvPolynomial.X i.1) ⟨MvPolynomial.X β, xβ_mem⟩
        let ψ_loc : MvPolynomial τ k →+* L_β := MvPolynomial.eval₂Hom c_loc v_loc
        have hψ_comp_X : ∀ j : Fin 3,
            ψ_loc (dehom (MvPolynomial.X j)) =
              Localization.mk (MvPolynomial.X j) ⟨MvPolynomial.X β, xβ_mem⟩ := by
          intro j
          rw [hdehom_X j]
          split_ifs with hj
          · subst hj
            rw [map_one]
            exact (Localization.mk_self ⟨MvPolynomial.X j, xβ_mem⟩).symm
          · exact MvPolynomial.eval₂Hom_X' c_loc v_loc ⟨j, hj⟩
        have hψ_homog : ∀ {d : ℕ} {A : MvPolynomial (Fin 3) k},
            A.IsHomogeneous d →
            ψ_loc (dehom A) =
              Localization.mk A ⟨(MvPolynomial.X β) ^ d, S_pow.pow_mem xβ_mem d⟩ := by
          intro d A hA
          conv_lhs => rw [A.as_sum]
          conv_rhs => rw [A.as_sum]
          rw [map_sum, map_sum]
          have hsum_mk : ∀ (S : Finset (Fin 3 →₀ ℕ)) (f : (Fin 3 →₀ ℕ) → MvPolynomial (Fin 3) k)
              (y : S_pow),
              (∑ s ∈ S, Localization.mk (f s) y) = Localization.mk (∑ s ∈ S, f s) y := by
            intro S f y
            induction S using Finset.induction_on with
            | empty =>
              simp [Localization.mk_zero]
            | @insert s₀ s' hs₀ ih =>
              rw [Finset.sum_insert hs₀, Finset.sum_insert hs₀, ih, Localization.add_mk_self]
          rw [← hsum_mk]
          refine Finset.sum_congr rfl fun s hs => ?_
          have hs_deg : (∑ j ∈ s.support, s j) = d := by
            have hd_eq : Finsupp.degree s = d := by
              by_contra hne
              exact (MvPolynomial.mem_support_iff.mp hs) (hA.coeff_eq_zero hne)
            rwa [Finsupp.degree_apply] at hd_eq
          rw [MvPolynomial.monomial_eq, map_mul, map_mul, hdehom_C]
          have hC : ψ_loc (MvPolynomial.C (A.coeff s)) =
              Localization.mk (MvPolynomial.C (A.coeff s)) 1 :=
            MvPolynomial.eval₂Hom_C c_loc v_loc (A.coeff s)
          rw [hC]
          change _ * ψ_loc (dehom (∏ j ∈ s.support, MvPolynomial.X j ^ s j)) = _
          rw [map_prod, map_prod]
          simp_rw [map_pow]
          have hprod_mk : ∀ (T : Finset (Fin 3)),
              (∏ j ∈ T, (ψ_loc (dehom (MvPolynomial.X j))) ^ s j) =
                Localization.mk (∏ j ∈ T, MvPolynomial.X j ^ s j)
                  ⟨MvPolynomial.X β ^ (∑ j ∈ T, s j), S_pow.pow_mem xβ_mem (∑ j ∈ T, s j)⟩ := by
            intro T
            induction T using Finset.induction_on with
            | empty =>
              simp
            | @insert j₀ T' hj₀ ih =>
              rw [Finset.prod_insert hj₀, Finset.prod_insert hj₀, Finset.sum_insert hj₀,
                ih, hψ_comp_X j₀, Localization.mk_pow, Localization.mk_mul]
              congr 1
              ext
              simp [pow_add]
          rw [hprod_mk s.support, Localization.mk_mul, one_mul]
          congr 1
          ext; simp [hs_deg]
        have hDehom_eq : ∀ {dA dB : ℕ} {A B : MvPolynomial (Fin 3) k},
            A.IsHomogeneous dA → B.IsHomogeneous dB → dehom A = dehom B →
            (MvPolynomial.X β) ^ dB * A = (MvPolynomial.X β) ^ dA * B := by
          intro dA dB A B hA hB hEq
          have hloc := congrArg ψ_loc hEq
          rw [hψ_homog hA, hψ_homog hB, Localization.mk_eq_mk_iff, Localization.r_iff_exists] at hloc
          rcases hloc with ⟨⟨c, k_pow, rfl⟩, hc_eq⟩
          exact mul_left_cancel₀ (pow_ne_zero k_pow hXβ_ne) hc_eq

        let homog : MvPolynomial τ k → MvPolynomial (Fin 3) k := fun q =>
          ∑ s ∈ q.support,
            MvPolynomial.C (q.coeff s) *
              (MvPolynomial.X β) ^ (q.totalDegree - ∑ i : τ, s i) *
              ∏ i : τ, (MvPolynomial.X i.1) ^ (s i)
        have hHomog_sec : ∀ q : MvPolynomial τ k,
            (homog q).IsHomogeneous q.totalDegree ∧ dehom (homog q) = q := by
          intro q
          refine ⟨?_, ?_⟩
          · change homog q ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k q.totalDegree
            refine Submodule.sum_mem _ fun s hs => ?_
            have hs_le : (∑ i : τ, s i) ≤ q.totalDegree := by
              have hle := MvPolynomial.le_totalDegree hs
              have hsum_eq : s.sum (fun _ e => e) = ∑ i : τ, s i := by
                rw [Finsupp.sum_fintype _ _ (fun _ => rfl)]
              rwa [← hsum_eq]
            have hC_hom : (MvPolynomial.C (q.coeff s) : MvPolynomial (Fin 3) k).IsHomogeneous 0 :=
              MvPolynomial.isHomogeneous_C (Fin 3) (q.coeff s)
            have hX_pow_hom : ((MvPolynomial.X β : MvPolynomial (Fin 3) k) ^
                (q.totalDegree - ∑ i : τ, s i)).IsHomogeneous (q.totalDegree - ∑ i : τ, s i) :=
              MvPolynomial.isHomogeneous_X_pow β _
            have hProd_hom : ∀ (T : Finset τ),
                (∏ i ∈ T, (MvPolynomial.X i.1 : MvPolynomial (Fin 3) k) ^ (s i)).IsHomogeneous
                  (∑ i ∈ T, s i) := by
              intro T
              induction T using Finset.induction_on with
              | empty =>
                simpa using MvPolynomial.isHomogeneous_one (Fin 3) k
              | @insert i₀ T' hi₀ ih =>
                rw [Finset.prod_insert hi₀, Finset.sum_insert hi₀]
                exact (MvPolynomial.isHomogeneous_X_pow i₀.1 (s i₀)).mul ih
            have hTerm := (hC_hom.mul hX_pow_hom).mul (hProd_hom Finset.univ)
            have hdeg_sum : 0 + (q.totalDegree - ∑ i : τ, s i) + ∑ i : τ, s i = q.totalDegree := by
              omega
            rwa [hdeg_sum] at hTerm
          · dsimp only [homog]
            rw [map_sum]
            conv_rhs => rw [q.as_sum]
            refine Finset.sum_congr rfl fun s _ => ?_
            rw [map_mul, map_mul, map_pow, map_prod, hdehom_C, hdehom_X β, dif_pos rfl,
              one_pow, mul_one]
            have hprod_eq : (∏ x : τ, dehom (MvPolynomial.X x.1 ^ s x)) =
                ∏ x : τ, MvPolynomial.X x ^ s x := by
              refine Finset.prod_congr rfl fun x _ => ?_
              rw [map_pow, hdehom_X x.1, dif_neg x.2]
            rw [hprod_eq, MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]

        have hPrimeP : Prime P := UniqueFactorizationMonoid.irreducible_iff_prime.mp hIrred
        let π_kill : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 3) k :=
          MvPolynomial.eval₂Hom MvPolynomial.C
            (fun j : Fin 3 => if j = β then 0 else MvPolynomial.X j)
        have h_kill_dvd : ∀ Q : MvPolynomial (Fin 3) k, MvPolynomial.X β ∣ Q - π_kill Q := by
          intro Q
          induction Q using MvPolynomial.induction_on with
          | C c =>
            simp [π_kill]
          | add A B hA hB =>
            rw [map_add, add_sub_add_comm]
            exact dvd_add hA hB
          | mul_X A j hA =>
            rw [map_mul]
            have hXj : π_kill (MvPolynomial.X j) = if j = β then 0 else MvPolynomial.X j :=
              MvPolynomial.eval₂Hom_X' _ _ j
            rw [hXj]
            split_ifs with hj
            · subst hj
              rw [mul_zero, sub_zero]
              exact ⟨A, mul_comm A _⟩
            · have hsub : A * MvPolynomial.X j - π_kill A * MvPolynomial.X j =
                  (A - π_kill A) * MvPolynomial.X j := by ring
              rw [hsub]
              exact dvd_mul_of_dvd_left hA _
        have hP_not_dvd_pow : ∀ n : ℕ, ¬ (P ∣ (MvPolynomial.X β) ^ n) := by
          intro n hPn
          have hPX : P ∣ MvPolynomial.X β := hPrimeP.dvd_of_dvd_pow hPn
          rcases hPX with ⟨V, hPV⟩
          have h0 := congrArg π_kill hPV
          have hX0 : π_kill (MvPolynomial.X β) = 0 := by
            change MvPolynomial.eval₂Hom MvPolynomial.C
              (fun j : Fin 3 => if j = β then (0 : MvPolynomial (Fin 3) k) else MvPolynomial.X j)
              (MvPolynomial.X β) = 0
            rw [MvPolynomial.eval₂Hom_X', if_pos rfl]
          rw [hX0, map_mul] at h0
          rcases mul_eq_zero.mp h0.symm with hP0 | hV0
          · have hdvdP := h_kill_dvd P
            rw [hP0, sub_zero] at hdvdP
            exact hdvd hdvdP
          · have hdvdV := h_kill_dvd V
            rw [hV0, sub_zero] at hdvdV
            rcases hdvdV with ⟨V', hV'⟩
            have hcancel : MvPolynomial.X β * 1 = MvPolynomial.X β * (P * V') := by
              calc MvPolynomial.X β * 1 = MvPolynomial.X β := mul_one _
                _ = P * V := hPV
                _ = P * (MvPolynomial.X β * V') := by rw [hV']
                _ = MvPolynomial.X β * (P * V') := by ring
            have hPV1 : P * V' = 1 := (mul_left_cancel₀ hXβ_ne hcancel).symm
            exact hIrred.not_isUnit ⟨⟨P, V', hPV1, mul_comm P V' ▸ hPV1⟩, rfl⟩

        have hP_hom : P.IsHomogeneous D := hHomog
        have hp_not_unit : ¬ IsUnit (dehom P) := by
          rintro ⟨u, hu⟩
          let r_inv : MvPolynomial τ k := ↑u⁻¹
          have hpr1 : dehom P * r_inv = 1 := by
            rw [← hu]
            exact Units.mul_inv u
          obtain ⟨hR_hom, hR_dehom⟩ := hHomog_sec r_inv
          have hPR_hom : (P * homog r_inv).IsHomogeneous (D + r_inv.totalDegree) :=
            hP_hom.mul hR_hom
          have h1_hom : (1 : MvPolynomial (Fin 3) k).IsHomogeneous 0 :=
            MvPolynomial.isHomogeneous_one (Fin 3) k
          have hdehom_PR : dehom (P * homog r_inv) = dehom 1 := by
            rw [map_mul, hR_dehom, hpr1, map_one]
          have hEq := hDehom_eq hPR_hom h1_hom hdehom_PR
          rw [pow_zero, one_mul, mul_one] at hEq
          exact hP_not_dvd_pow (D + r_inv.totalDegree) ⟨homog r_inv, hEq.symm⟩

        have hp_irred : Irreducible (dehom P) := by
          refine ⟨hp_not_unit, ?_⟩
          intro f g hfg
          obtain ⟨hF_hom, hF_dehom⟩ := hHomog_sec f
          obtain ⟨hG_hom, hG_dehom⟩ := hHomog_sec g
          have hFG_hom : (homog f * homog g).IsHomogeneous (f.totalDegree + g.totalDegree) :=
            hF_hom.mul hG_hom
          have hdehom_FG : dehom (homog f * homog g) = dehom P := by
            rw [map_mul, hF_dehom, hG_dehom, ← hfg]
          have hEq := hDehom_eq hFG_hom hP_hom hdehom_FG
          have hP_dvd_lhs : P ∣ (MvPolynomial.X β) ^ D * (homog f * homog g) :=
            ⟨(MvPolynomial.X β) ^ (f.totalDegree + g.totalDegree), by rw [hEq]; ring⟩
          have hP_dvd_FG : P ∣ homog f * homog g :=
            (hPrimeP.dvd_mul.mp hP_dvd_lhs).resolve_left (hP_not_dvd_pow D)
          rcases hPrimeP.dvd_mul.mp hP_dvd_FG with ⟨H, hFH⟩ | ⟨H, hGH⟩
          · right
            have hcancel : P * ((MvPolynomial.X β) ^ D * H * homog g) =
                P * (MvPolynomial.X β) ^ (f.totalDegree + g.totalDegree) := by
              calc P * ((MvPolynomial.X β) ^ D * H * homog g)
                  = (MvPolynomial.X β) ^ D * ((P * H) * homog g) := by ring
                _ = (MvPolynomial.X β) ^ D * (homog f * homog g) := by rw [← hFH]
                _ = (MvPolynomial.X β) ^ (f.totalDegree + g.totalDegree) * P := hEq
                _ = P * (MvPolynomial.X β) ^ (f.totalDegree + g.totalDegree) := by ring
            have hHG := mul_left_cancel₀ hIrred.ne_zero hcancel
            have hd_HG := congrArg dehom hHG
            rw [map_mul, map_mul, map_pow, map_pow, hdehom_X β, dif_pos rfl,
              one_pow, one_pow, one_mul, hG_dehom] at hd_HG
            have hgH : g * dehom H = 1 := mul_comm (dehom H) g ▸ hd_HG
            exact ⟨⟨g, dehom H, hgH, hd_HG⟩, rfl⟩
          · left
            have hcancel : P * ((MvPolynomial.X β) ^ D * homog f * H) =
                P * (MvPolynomial.X β) ^ (f.totalDegree + g.totalDegree) := by
              calc P * ((MvPolynomial.X β) ^ D * homog f * H)
                  = (MvPolynomial.X β) ^ D * (homog f * (P * H)) := by ring
                _ = (MvPolynomial.X β) ^ D * (homog f * homog g) := by rw [← hGH]
                _ = (MvPolynomial.X β) ^ (f.totalDegree + g.totalDegree) * P := hEq
                _ = P * (MvPolynomial.X β) ^ (f.totalDegree + g.totalDegree) := by ring
            have hFH' := mul_left_cancel₀ hIrred.ne_zero hcancel
            have hd_FH := congrArg dehom hFH'
            rw [map_mul, map_mul, map_pow, map_pow, hdehom_X β, dif_pos rfl,
              one_pow, one_pow, one_mul, hF_dehom] at hd_FH
            exact ⟨⟨f, dehom H, hd_FH, mul_comm f (dehom H) ▸ hd_FH⟩, rfl⟩

        have hp_prime : Prime (dehom P) :=
          UniqueFactorizationMonoid.irreducible_iff_prime.mp hp_irred
        have hSpan_prime : (Ideal.span {dehom P}).IsPrime :=
          (Ideal.span_singleton_prime hp_irred.ne_zero).mpr hp_prime
        exact hSpan_prime.isRadical

    have hEuler : ∀ (I : Ideal (MvPolynomial (Fin 3) k)),
        I.IsPrime → P ∈ I → MvPolynomial.X β ∉ I →
        (∃ r₀ : Fin 3, MvPolynomial.pderiv r₀ P ∉ I) →
        ∃ r : τ, MvPolynomial.pderiv r.1 P ∉ I := by
      intro I hI_prime hP_mem hXβ_not ⟨r₀, hr₀⟩
      by_cases hr₀β : r₀ = β
      · subst hr₀β
        by_contra hall
        have hall' : ∀ r : τ, MvPolynomial.pderiv r.1 P ∈ I := fun r =>
          Classical.not_not.mp (fun hnot => hall ⟨r, hnot⟩)
        have hP_hom : P.IsHomogeneous D := hHomog
        have hSum := hP_hom.sum_X_mul_pderiv
        rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ r₀)] at hSum
        have hRest_mem : (∑ i ∈ Finset.univ.erase r₀,
            MvPolynomial.X i * MvPolynomial.pderiv i P) ∈ I := by
          refine Ideal.sum_mem I fun i hi => ?_
          have hi_ne : i ≠ r₀ := (Finset.mem_erase.mp hi).1
          exact Ideal.mul_mem_left I _ (hall' ⟨i, hi_ne⟩)
        have hRhs_mem : D • P ∈ I := by
          rw [nsmul_eq_mul]
          exact Ideal.mul_mem_left I (D : MvPolynomial (Fin 3) k) hP_mem
        have hTermβ : MvPolynomial.X r₀ * MvPolynomial.pderiv r₀ P ∈ I := by
          have hsub := Ideal.sub_mem I (hSum ▸ hRhs_mem) hRest_mem
          simpa only [add_sub_cancel_right] using hsub
        rcases hI_prime.mem_or_mem hTermβ with hX_in | hd_in
        · exact hXβ_not hX_in
        · exact hr₀ hd_in
      · exact ⟨⟨r₀, hr₀β⟩, hr₀⟩

    have hSmooth : ∀ (r : τ) (h₀ : MvPolynomial τ k),
        RingHom.IsStandardSmoothOfRelativeDimension 1
          (((Ideal.Quotient.mk (Ideal.span
              {algebraMap (MvPolynomial τ k)
                (Localization.Away (h₀ * dehom (MvPolynomial.pderiv r.1 P)))
                (dehom P)})).comp
            (algebraMap (MvPolynomial τ k)
              (Localization.Away (h₀ * dehom (MvPolynomial.pderiv r.1 P))))).comp
            MvPolynomial.C) := by
      intro r h₀
      have hPderiv_dehom : ∀ Q : MvPolynomial (Fin 3) k,
          MvPolynomial.pderiv r (dehom Q) = dehom (MvPolynomial.pderiv r.1 Q) := by
        intro Q
        induction Q using MvPolynomial.induction_on with
        | C c =>
          rw [hdehom_C, MvPolynomial.pderiv_C, MvPolynomial.pderiv_C, map_zero]
        | add A B hA hB =>
          simp [map_add, hA, hB]
        | mul_X A j hA =>
          rw [map_mul, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_mul, map_add,
            map_mul, map_mul, hA, hdehom_X j]
          split_ifs with hj
          · subst hj
            have hne : j ≠ r.1 := r.2.symm
            simp [MvPolynomial.pderiv_X, Pi.single_eq_of_ne hne]
          · by_cases hjr : j = r.1
            · have hsub_eq : (⟨j, hj⟩ : τ) = r := Subtype.ext hjr
              simp [MvPolynomial.pderiv_X, hsub_eq, hjr]
            · have hsub_ne : (⟨j, hj⟩ : τ) ≠ r := fun h => hjr (congrArg Subtype.val h)
              simp [MvPolynomial.pderiv_X, hsub_ne, hjr]

      have hex_other_all : ∀ (b : Fin 3) (r' : {x : Fin 3 // x ≠ b}),
          ∃ s_oth : {x : Fin 3 // x ≠ b}, s_oth ≠ r' ∧ ∀ x : {x : Fin 3 // x ≠ b}, x = r' ∨ x = s_oth := by
        decide
      obtain ⟨s_oth, hs_oth_ne, hr_exhaust⟩ := hex_other_all β r
      let e_τ : Fin 2 ≃ τ :=
        { toFun := ![r, s_oth]
          invFun := fun x => if x = r then 0 else 1
          left_inv := fun i => by fin_cases i <;> simp [hs_oth_ne]
          right_inv := fun x => by
            rcases hr_exhaust x with h | h <;> subst h <;> simp [hs_oth_ne] }
      have he_symm_r : e_τ.symm r = 0 := by simp [e_τ]
      let ι₂ : τ → Fin 3 := Fin.castSucc ∘ e_τ.symm
      have hι₂_inj : Function.Injective ι₂ :=
        (Fin.castSucc_injective 2).comp e_τ.symm.injective
      have hι₂_r : ι₂ r = 0 := by simp [ι₂, he_symm_r]
      have hι₂_ne2 : ∀ x : τ, ι₂ x ≠ 2 := by
        intro x
        dsimp [ι₂]
        exact (Fin.castSucc_lt_last (e_τ.symm x)).ne

      let p_β : MvPolynomial τ k := dehom P
      let d_r : MvPolynomial τ k := dehom (MvPolynomial.pderiv r.1 P)
      let g₀ : MvPolynomial τ k := h₀ * d_r
      let L₀ := Localization.Away g₀
      let J₀ : Ideal L₀ := Ideal.span {algebraMap (MvPolynomial τ k) L₀ p_β}
      let S := L₀ ⧸ J₀
      let π_S : MvPolynomial τ k →+* S :=
        (Ideal.Quotient.mk J₀).comp (algebraMap (MvPolynomial τ k) L₀)
      let φ_S : k →+* S := π_S.comp MvPolynomial.C
      rw [RingHom.IsStandardSmoothOfRelativeDimension]
      letI : Algebra k S := φ_S.toAlgebra
      have halg_S : ∀ c : k, algebraMap k S c = π_S (MvPolynomial.C c) := fun _ => rfl

      let z_inv : S := Ideal.Quotient.mk J₀ (IsLocalization.Away.invSelf (S := L₀) g₀)
      have h_gz : π_S g₀ * z_inv = 1 := by
        change Ideal.Quotient.mk J₀ (algebraMap (MvPolynomial τ k) L₀ g₀) *
          Ideal.Quotient.mk J₀ (IsLocalization.Away.invSelf (S := L₀) g₀) = 1
        rw [← map_mul, IsLocalization.Away.mul_invSelf, map_one]

      let val : Fin 3 → S :=
        ![π_S (MvPolynomial.X (e_τ 0)), π_S (MvPolynomial.X (e_τ 1)), z_inv]
      have haeval_rename : ∀ q : MvPolynomial τ k,
          MvPolynomial.aeval val (MvPolynomial.rename ι₂ q) = π_S q := by
        intro q
        let ψ₁ : MvPolynomial τ k →+* S :=
          (MvPolynomial.aeval val).toRingHom.comp (MvPolynomial.rename ι₂).toRingHom
        have hψ : ψ₁ = π_S := by
          apply MvPolynomial.ringHom_ext
          · intro c
            simp [ψ₁, halg_S]
          · intro x
            simp only [ψ₁, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
              MvPolynomial.rename_X, MvPolynomial.aeval_X, ι₂, Function.comp_apply]
            rcases hr_exhaust x with h | h <;> subst h
            · simp [val, e_τ]
            · simp [val, e_τ, hs_oth_ne]
        exact DFunLike.congr_fun hψ q

      have hSurj : Function.Surjective (MvPolynomial.aeval (R := k) val) := by
        intro y
        obtain ⟨y₀, rfl⟩ := Ideal.Quotient.mk_surjective y
        obtain ⟨m, a, hma⟩ := IsLocalization.Away.surj g₀ y₀
        refine ⟨MvPolynomial.rename ι₂ a * (MvPolynomial.X 2) ^ m, ?_⟩
        rw [map_mul, map_pow, haeval_rename a, MvPolynomial.aeval_X]
        have hval2 : val 2 = z_inv := rfl
        rw [hval2]
        have hq_ma := congrArg (Ideal.Quotient.mk J₀) hma
        rw [map_mul, map_pow] at hq_ma
        have hq_ma' : Ideal.Quotient.mk J₀ y₀ * π_S g₀ ^ m = π_S a := hq_ma
        calc π_S a * z_inv ^ m
            = (Ideal.Quotient.mk J₀ y₀ * π_S g₀ ^ m) * z_inv ^ m := by
              rw [← hq_ma']
          _ = Ideal.Quotient.mk J₀ y₀ * (π_S g₀ * z_inv) ^ m := by ring
          _ = Ideal.Quotient.mk J₀ y₀ := by rw [h_gz, one_pow, mul_one]

      let G_gen : Algebra.Generators k S (Fin 3) := Algebra.Generators.ofSurjective val hSurj
      let R₀ : MvPolynomial (Fin 3) k := MvPolynomial.rename ι₂ p_β
      let R₁ : MvPolynomial (Fin 3) k := MvPolynomial.rename ι₂ g₀ * MvPolynomial.X 2 - 1
      let rel : Fin 2 → G_gen.Ring := ![R₀, R₁]
      let J_rel : Ideal (MvPolynomial (Fin 3) k) := Ideal.span (Set.range rel)
      have hR₀_mem : R₀ ∈ J_rel := Ideal.subset_span ⟨0, rfl⟩
      have hR₁_mem : R₁ ∈ J_rel := Ideal.subset_span ⟨1, rfl⟩

      have hG_pow_X2 : ∀ N : ℕ,
          (MvPolynomial.rename ι₂ g₀) ^ N * (MvPolynomial.X 2) ^ N - 1 ∈ J_rel := by
        intro N
        induction N with
        | zero =>
          simp
        | succ N ih =>
          have hid : (MvPolynomial.rename ι₂ g₀) ^ (N + 1) * (MvPolynomial.X 2) ^ (N + 1) - 1 =
              ((MvPolynomial.rename ι₂ g₀) ^ N * (MvPolynomial.X 2) ^ N - 1) *
                (MvPolynomial.rename ι₂ g₀ * MvPolynomial.X 2) + R₁ := by
            dsimp [R₁]; ring
          rw [hid]
          exact Ideal.add_mem J_rel (Ideal.mul_mem_right _ J_rel ih) hR₁_mem

      have hClear_X2 : ∀ Q : MvPolynomial (Fin 3) k,
          ∃ (N : ℕ) (a : MvPolynomial τ k),
            (MvPolynomial.rename ι₂ g₀) ^ N * Q - MvPolynomial.rename ι₂ a ∈ J_rel := by
        intro Q
        induction Q using MvPolynomial.induction_on with
        | C c =>
          refine ⟨0, MvPolynomial.C c, ?_⟩
          simp
        | add A B hA hB =>
          rcases hA with ⟨NA, a, ha⟩
          rcases hB with ⟨NB, b, hb⟩
          refine ⟨NA + NB, g₀ ^ NB * a + g₀ ^ NA * b, ?_⟩
          have hid : (MvPolynomial.rename ι₂ g₀) ^ (NA + NB) * (A + B) -
                MvPolynomial.rename ι₂ (g₀ ^ NB * a + g₀ ^ NA * b) =
              (MvPolynomial.rename ι₂ g₀) ^ NB *
                ((MvPolynomial.rename ι₂ g₀) ^ NA * A - MvPolynomial.rename ι₂ a) +
              (MvPolynomial.rename ι₂ g₀) ^ NA *
                ((MvPolynomial.rename ι₂ g₀) ^ NB * B - MvPolynomial.rename ι₂ b) := by
            simp only [map_add, map_mul, map_pow]
            ring
          rw [hid]
          exact Ideal.add_mem J_rel (Ideal.mul_mem_left J_rel _ ha) (Ideal.mul_mem_left J_rel _ hb)
        | mul_X A j hA =>
          rcases hA with ⟨N, a, ha⟩
          have hFin3 : ∀ x : Fin 3, x = 0 ∨ x = 1 ∨ x = 2 := by decide
          rcases hFin3 j with rfl | rfl | rfl
          · refine ⟨N, a * MvPolynomial.X (e_τ 0), ?_⟩
            have hX0 : MvPolynomial.rename ι₂ (MvPolynomial.X (R := k) (e_τ 0)) =
                (MvPolynomial.X 0 : MvPolynomial (Fin 3) k) := by
              simp [ι₂]
            have hid : (MvPolynomial.rename ι₂ g₀) ^ N * (A * MvPolynomial.X 0) -
                  MvPolynomial.rename ι₂ (a * MvPolynomial.X (e_τ 0)) =
                ((MvPolynomial.rename ι₂ g₀) ^ N * A - MvPolynomial.rename ι₂ a) *
                  MvPolynomial.X 0 := by
              rw [map_mul (MvPolynomial.rename ι₂) a, hX0]; ring
            rw [hid]
            exact Ideal.mul_mem_right _ J_rel ha
          · refine ⟨N, a * MvPolynomial.X (e_τ 1), ?_⟩
            have hX1 : MvPolynomial.rename ι₂ (MvPolynomial.X (R := k) (e_τ 1)) =
                (MvPolynomial.X 1 : MvPolynomial (Fin 3) k) := by
              simp [ι₂]
            have hid : (MvPolynomial.rename ι₂ g₀) ^ N * (A * MvPolynomial.X 1) -
                  MvPolynomial.rename ι₂ (a * MvPolynomial.X (e_τ 1)) =
                ((MvPolynomial.rename ι₂ g₀) ^ N * A - MvPolynomial.rename ι₂ a) *
                  MvPolynomial.X 1 := by
              rw [map_mul (MvPolynomial.rename ι₂) a, hX1]; ring
            rw [hid]
            exact Ideal.mul_mem_right _ J_rel ha
          · refine ⟨N + 1, a, ?_⟩
            have hid : (MvPolynomial.rename ι₂ g₀) ^ (N + 1) * (A * MvPolynomial.X 2) -
                  MvPolynomial.rename ι₂ a =
                ((MvPolynomial.rename ι₂ g₀) ^ N * A - MvPolynomial.rename ι₂ a) *
                  (MvPolynomial.rename ι₂ g₀ * MvPolynomial.X 2) +
                MvPolynomial.rename ι₂ a * R₁ := by
              dsimp [R₁]; ring
            rw [hid]
            exact Ideal.add_mem J_rel
              (Ideal.mul_mem_right _ J_rel ha) (Ideal.mul_mem_left J_rel _ hR₁_mem)

      have hKer : Ideal.span (Set.range rel) = G_gen.ker := by
        apply le_antisymm
        · rw [Ideal.span_le]
          rintro _ ⟨i, rfl⟩
          change MvPolynomial.aeval val (rel i) = 0
          fin_cases i
          · change MvPolynomial.aeval val R₀ = 0
            rw [haeval_rename p_β]
            dsimp [π_S]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          · change MvPolynomial.aeval val R₁ = 0
            dsimp [R₁]
            rw [map_sub, map_mul, haeval_rename g₀, MvPolynomial.aeval_X, map_one]
            have hval2 : val 2 = z_inv := rfl
            rw [hval2, h_gz, sub_self]
        · intro Q hQ
          have hQ_zero : MvPolynomial.aeval val Q = 0 := hQ
          obtain ⟨N, a, hNa⟩ := hClear_X2 Q
          have ha_eval : π_S a = 0 := by
            have h0 : MvPolynomial.aeval val
                ((MvPolynomial.rename ι₂ g₀) ^ N * Q - MvPolynomial.rename ι₂ a) = 0 := by
              have hle : J_rel ≤ RingHom.ker (MvPolynomial.aeval val).toRingHom := by
                rw [Ideal.span_le]
                rintro _ ⟨i, rfl⟩
                fin_cases i
                · change MvPolynomial.aeval val R₀ = 0
                  rw [haeval_rename p_β]
                  exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
                · change MvPolynomial.aeval val R₁ = 0
                  dsimp [R₁]
                  rw [map_sub, map_mul, haeval_rename g₀, MvPolynomial.aeval_X, map_one]
                  exact sub_eq_zero.mpr h_gz
              exact hle hNa
            rw [map_sub, map_mul, hQ_zero, mul_zero, zero_sub, haeval_rename a, neg_eq_zero] at h0
            exact h0
          have ha_mem_J0 : algebraMap (MvPolynomial τ k) L₀ a ∈ J₀ :=
            Ideal.Quotient.eq_zero_iff_mem.mp ha_eval
          rw [Ideal.mem_span_singleton] at ha_mem_J0
          rcases ha_mem_J0 with ⟨c_loc, hc_loc⟩
          obtain ⟨k_exp, b, hkb⟩ := IsLocalization.Away.surj g₀ c_loc
          have hloc_eq : algebraMap (MvPolynomial τ k) L₀ (g₀ ^ k_exp * a) =
              algebraMap (MvPolynomial τ k) L₀ (b * p_β) := by
            rw [map_mul, map_pow, hc_loc]
            calc algebraMap (MvPolynomial τ k) L₀ g₀ ^ k_exp *
                  (algebraMap (MvPolynomial τ k) L₀ p_β * c_loc)
                = algebraMap (MvPolynomial τ k) L₀ p_β *
                    (c_loc * algebraMap (MvPolynomial τ k) L₀ g₀ ^ k_exp) := by ring
              _ = algebraMap (MvPolynomial τ k) L₀ p_β *
                    algebraMap (MvPolynomial τ k) L₀ b := by rw [hkb]
              _ = algebraMap (MvPolynomial τ k) L₀ (b * p_β) := by rw [map_mul]; ring
          have hex_pow : ∃ l_exp : ℕ, g₀ ^ l_exp * (g₀ ^ k_exp * a) = g₀ ^ l_exp * (b * p_β) := by
            obtain ⟨⟨_, l_exp, rfl⟩, hl⟩ :=
              (IsLocalization.eq_iff_exists (Submonoid.powers g₀) L₀).mp hloc_eq
            exact ⟨l_exp, hl⟩
          rcases hex_pow with ⟨l_exp, hl_eq⟩
          have hren_a_mem : (MvPolynomial.rename ι₂ g₀) ^ (l_exp + k_exp) *
              MvPolynomial.rename ι₂ a ∈ J_rel := by
            have h1 : g₀ ^ (l_exp + k_exp) * a = (g₀ ^ l_exp * b) * p_β := by
              calc g₀ ^ (l_exp + k_exp) * a = g₀ ^ l_exp * (g₀ ^ k_exp * a) := by ring
                _ = g₀ ^ l_exp * (b * p_β) := hl_eq
                _ = (g₀ ^ l_exp * b) * p_β := by ring
            have h2 : (MvPolynomial.rename ι₂ g₀) ^ (l_exp + k_exp) * MvPolynomial.rename ι₂ a =
                MvPolynomial.rename ι₂ (g₀ ^ l_exp * b) * R₀ := by
              dsimp only [R₀]
              simp only [← map_pow, ← map_mul]
              exact congrArg (MvPolynomial.rename ι₂) h1
            rw [h2]
            exact Ideal.mul_mem_left J_rel _ hR₀_mem
          have hQ_g_mem : (MvPolynomial.rename ι₂ g₀) ^ (N + l_exp + k_exp) * Q ∈ J_rel := by
            have hid : (MvPolynomial.rename ι₂ g₀) ^ (N + l_exp + k_exp) * Q =
                (MvPolynomial.rename ι₂ g₀) ^ (l_exp + k_exp) *
                  ((MvPolynomial.rename ι₂ g₀) ^ N * Q - MvPolynomial.rename ι₂ a) +
                ((MvPolynomial.rename ι₂ g₀) ^ (l_exp + k_exp) * MvPolynomial.rename ι₂ a) := by
              ring
            rw [hid]
            exact Ideal.add_mem J_rel (Ideal.mul_mem_left J_rel _ hNa) hren_a_mem
          let M_tot := N + l_exp + k_exp
          have hfinal : Q = (MvPolynomial.X 2) ^ M_tot *
                ((MvPolynomial.rename ι₂ g₀) ^ M_tot * Q) -
              Q * ((MvPolynomial.rename ι₂ g₀) ^ M_tot * (MvPolynomial.X 2) ^ M_tot - 1) := by
            ring
          rw [hfinal]
          exact Ideal.sub_mem J_rel
            (Ideal.mul_mem_left J_rel _ hQ_g_mem)
            (Ideal.mul_mem_left J_rel _ (hG_pow_X2 M_tot))

      let P_pres : Algebra.Presentation k S (Fin 3) (Fin 2) :=
        Algebra.Presentation.mk G_gen rel hKer
      let map_idx : Fin 2 → Fin 3 := ![0, 2]
      have hmap_inj : Function.Injective map_idx := by
        intro i j hij
        fin_cases i <;> fin_cases j <;> simp [map_idx] at hij ⊢
      let P_pre : Algebra.PreSubmersivePresentation k S (Fin 3) (Fin 2) :=
        Algebra.PreSubmersivePresentation.mk P_pres map_idx hmap_inj

      have hpderiv_0_R0 : MvPolynomial.pderiv 0 R₀ = MvPolynomial.rename ι₂ d_r := by
        dsimp [R₀]
        rw [← hι₂_r, MvPolynomial.pderiv_rename hι₂_inj r p_β]
        dsimp [p_β, d_r]
        rw [hPderiv_dehom P]
      have h2_not_vars : ∀ q : MvPolynomial τ k, (2 : Fin 3) ∉ (MvPolynomial.rename ι₂ q).vars := by
        intro q hmem
        have hmem' := MvPolynomial.vars_rename ι₂ q hmem
        rw [Finset.mem_image] at hmem'
        rcases hmem' with ⟨x, _, hx2⟩
        exact hι₂_ne2 x hx2
      have hpderiv_2_R0 : MvPolynomial.pderiv 2 R₀ = 0 :=
        MvPolynomial.pderiv_eq_zero_of_notMem_vars (h2_not_vars p_β)
      have hpderiv_2_R1 : MvPolynomial.pderiv 2 R₁ = MvPolynomial.rename ι₂ g₀ := by
        dsimp [R₁]
        rw [map_sub, MvPolynomial.pderiv_one, sub_zero, MvPolynomial.pderiv_mul,
          MvPolynomial.pderiv_eq_zero_of_notMem_vars (h2_not_vars g₀), zero_mul, zero_add,
          MvPolynomial.pderiv_X_self, mul_one]

      have hJac_unit : IsUnit P_pre.jacobian := by
        rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, Matrix.det_fin_two]
        simp only [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        have h00 : algebraMap P_pre.Ring S (MvPolynomial.pderiv (P_pre.map 0) (P_pre.relation 0)) =
            π_S d_r := by
          change MvPolynomial.aeval val (MvPolynomial.pderiv 0 R₀) = π_S d_r
          rw [hpderiv_0_R0, haeval_rename]
        have h10 : algebraMap P_pre.Ring S (MvPolynomial.pderiv (P_pre.map 1) (P_pre.relation 0)) =
            0 := by
          change MvPolynomial.aeval val (MvPolynomial.pderiv 2 R₀) = 0
          rw [hpderiv_2_R0, map_zero]
        have h11 : algebraMap P_pre.Ring S (MvPolynomial.pderiv (P_pre.map 1) (P_pre.relation 1)) =
            π_S g₀ := by
          change MvPolynomial.aeval val (MvPolynomial.pderiv 2 R₁) = π_S g₀
          rw [hpderiv_2_R1, haeval_rename]
        rw [map_sub, map_mul, map_mul, h00, h10, h11, mul_zero, sub_zero]
        have hmul1 : (π_S d_r * π_S g₀) * (π_S h₀ * z_inv ^ 2) = 1 := by
          have hg0_pi : π_S h₀ * π_S d_r = π_S g₀ := (map_mul π_S h₀ d_r).symm
          calc (π_S d_r * π_S g₀) * (π_S h₀ * z_inv ^ 2)
              = (π_S h₀ * π_S d_r) * π_S g₀ * z_inv ^ 2 := by ring
            _ = (π_S g₀ * z_inv) ^ 2 := by rw [hg0_pi]; ring
            _ = 1 := by rw [h_gz, one_pow]
        have hmul2 : (π_S h₀ * z_inv ^ 2) * (π_S d_r * π_S g₀) = 1 := by
          rw [mul_comm, hmul1]
        exact ⟨⟨π_S d_r * π_S g₀, π_S h₀ * z_inv ^ 2, hmul1, hmul2⟩, rfl⟩

      let P_sub : Algebra.SubmersivePresentation k S (Fin 3) (Fin 2) :=
        Algebra.SubmersivePresentation.mk P_pre hJac_unit
      have hdim : P_sub.dimension = 1 := by
        simp [Algebra.Presentation.dimension]
      exact P_sub.isStandardSmoothOfRelativeDimension hdim

    exact ⟨hRad, hEuler, hSmooth⟩

  have part4_s5 : ∀
      (D_disc : ℕ) (_ : 1 ≤ D_disc) (P_disc : MvPolynomial (Fin 3) k)
      (_ : P_disc ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k D_disc)
      (_ : Irreducible P_disc)
      (_ : MvPolynomial.eval ![0, 1, 0] P_disc = 0)
      (F_bad_plane : Set (weilProjectiveSpaceOver k 2).left)
      (_ : IsClosed F_bad_plane)
      (_ : ∀ β : Fin 3,
        let dehom : MvPolynomial (Fin 3) k →+* MvPolynomial {r : Fin 3 // r ≠ β} k :=
          MvPolynomial.eval₂Hom MvPolynomial.C
            (fun j : Fin 3 => if h : j = β then 1 else MvPolynomial.X ⟨j, h⟩)
        (Ideal.span {dehom P_disc}).IsRadical)
      (_ : ∀ (β : Fin 3) (I : Ideal (MvPolynomial (Fin 3) k)),
        I.IsPrime → P_disc ∈ I → MvPolynomial.X β ∉ I →
        (∃ r₀ : Fin 3, MvPolynomial.pderiv r₀ P_disc ∉ I) →
        ∃ r : {r : Fin 3 // r ≠ β}, MvPolynomial.pderiv r.1 P_disc ∉ I)
      (_ : ∀ (β : Fin 3) (r : {r : Fin 3 // r ≠ β})
        (h₀ : MvPolynomial {r : Fin 3 // r ≠ β} k),
        let dehom : MvPolynomial (Fin 3) k →+* MvPolynomial {r : Fin 3 // r ≠ β} k :=
          MvPolynomial.eval₂Hom MvPolynomial.C
            (fun j : Fin 3 => if h : j = β then 1 else MvPolynomial.X ⟨j, h⟩)
        RingHom.IsStandardSmoothOfRelativeDimension 1
          (((Ideal.Quotient.mk (Ideal.span
              {algebraMap (MvPolynomial {r : Fin 3 // r ≠ β} k)
                (Localization.Away (h₀ * dehom (MvPolynomial.pderiv r.1 P_disc)))
                (dehom P_disc)})).comp
            (algebraMap (MvPolynomial {r : Fin 3 // r ≠ β} k)
              (Localization.Away (h₀ * dehom (MvPolynomial.pderiv r.1 P_disc))))).comp
            MvPolynomial.C)),
      ∃ (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ι_disc : C_disc ⟶ weilProjectiveSpaceOver k 2)
        (U_disc_reg : C_disc.left.Opens),
        IsHomogeneousHypersurfacePullbackOver k 2 D_disc
          (𝟙 (weilProjectiveSpaceOver k 2)) P_disc ι_disc.left ∧
        AlgebraicGeometry.IsIntegral C_disc.left ∧
        AlgebraicGeometry.IsProper C_disc.hom ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_disc_reg.ι ≫ C_disc.hom) ∧
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
          MvPolynomial.gradedAlgebra
         ι_disc.left.base '' (U_disc_reg : Set C_disc.left) =
          { p : (weilProjectiveSpaceOver k 2).left |
            P_disc ∈ ProjectiveSpectrum.asHomogeneousIdeal p ∧
            p ∉ F_bad_plane ∧
            ∃ r : Fin 3, MvPolynomial.pderiv r P_disc ∉ ProjectiveSpectrum.asHomogeneousIdeal p }) ∧
        (∀ c : C_disc.left, c ∈ U_disc_reg → IsClosed ({c} : Set C_disc.left) →
          (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
            MvPolynomial.gradedAlgebra
           ι_disc.left.base c ∉ F_bad_plane ∧
           ∃ w : Fin 3 → k,
             w ≠ 0 ∧
             ∀ (F : MvPolynomial (Fin 3) k) (d : ℕ),
               F ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d →
               (F ∈ ProjectiveSpectrum.asHomogeneousIdeal (ι_disc.left.base c) ↔
                 MvPolynomial.eval w F = 0))) := by
    intro D_disc hD P_disc hHomog hIrred hEval010 F_bad_plane hClosed_bad
      hRad hEuler_aff hSm_alg
    classical
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
      MvPolynomial.gradedAlgebra
    let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k
    let P_2 := weilProjectiveSpaceOver k 2
    let X_2 : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜_2

    have hIrrel_2 : (HomogeneousIdeal.irrelevant 𝒜_2).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin 3 → MvPolynomial (Fin 3) k)) := by
      intro p hp
      have hp0 : GradedRing.proj 𝒜_2 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜_2 p).mp hp
      have hcoeff0 : p.coeff 0 = 0 := by
        have hdecomp := DirectSum.sum_support_decompose 𝒜_2 p
        have hsum_coeff :
            (∑ i ∈ (DirectSum.decompose 𝒜_2 p).support,
              ((DirectSum.decompose 𝒜_2 p i : MvPolynomial (Fin 3) k)).coeff 0) =
            p.coeff 0 := by
          rw [← MvPolynomial.coeff_sum, hdecomp]
        rw [← hsum_coeff]
        refine Finset.sum_eq_zero fun i _ => ?_
        by_cases hi : i = 0
        · subst hi
          have h0 : (DirectSum.decompose 𝒜_2 p 0 : MvPolynomial (Fin 3) k) = 0 := hp0
          rw [h0]; rfl
        · by_contra hne
          have hhom : ((DirectSum.decompose 𝒜_2 p i : MvPolynomial (Fin 3) k)).IsHomogeneous i :=
            (MvPolynomial.mem_homogeneousSubmodule i _).mp (DirectSum.decompose 𝒜_2 p i).2
          have hdeg := hhom hne
          simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at hdeg
          exact hi hdeg.symm
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm_ne : m ≠ 0 := by
        intro h0; rw [h0] at hm; exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
      by_contra h_all
      apply hm_ne
      ext i
      by_contra hmi
      exact h_all ⟨i, Set.mem_univ i, hmi⟩

    have hDeg0_2 : ∀ (F : MvPolynomial (Fin 3) k), F ∈ 𝒜_2 0 →
        F = MvPolynomial.C (F.coeff 0) := by
      intro F hF
      ext d
      by_cases hd0 : d = 0
      · subst hd0; simp [MvPolynomial.coeff_C]
      · rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr fun h => False.elim (hd0 h.symm)]
        by_contra hne
        have h1 := (MvPolynomial.mem_homogeneousSubmodule 0 F).mp hF hne
        have hsum : (∑ i : Fin 3, d i) = 0 := by
          simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1
        apply hd0
        ext i
        exact Finset.sum_eq_zero_iff.mp hsum i (Finset.mem_univ i)

    have hChart_P2 : ∀ β : Fin 3,
        let dehom_β : MvPolynomial (Fin 3) k →+* MvPolynomial {r : Fin 3 // r ≠ β} k :=
          MvPolynomial.eval₂Hom MvPolynomial.C
            (fun j : Fin 3 => if h : j = β then 1 else MvPolynomial.X ⟨j, h⟩)
        ∃ (e_β : MvPolynomial {r : Fin 3 // r ≠ β} k ≃+*
            HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β)),
          (∀ c : k, e_β (MvPolynomial.C c) =
            (HomogeneousLocalization.fromZeroRingHom 𝒜_2
              (Submonoid.powers (MvPolynomial.X β))) (algebraMap k ↥(𝒜_2 0) c)) ∧
          (∀ (d : ℕ) (F : MvPolynomial (Fin 3) k) (hF : F ∈ 𝒜_2 d)
             (den : MvPolynomial (Fin 3) k) (hden : den ∈ 𝒜_2 d)
             (hp : den ∈ Submonoid.powers (MvPolynomial.X β)),
            e_β.symm (HomogeneousLocalization.mk ⟨d, ⟨F, hF⟩, ⟨den, hden⟩, hp⟩) =
              dehom_β F) := by
      intro β
      let τ_β := {r : Fin 3 // r ≠ β}
      let dehom_β : MvPolynomial (Fin 3) k →+* MvPolynomial τ_β k :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (fun j : Fin 3 => if h : j = β then 1 else MvPolynomial.X ⟨j, h⟩)
      let S_β := Submonoid.powers (MvPolynomial.X β : MvPolynomial (Fin 3) k)
      let xβ_mem : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ∈ S_β := Submonoid.mem_powers _
      have h_dehom_X : ∀ j : Fin 3,
          dehom_β (MvPolynomial.X j) = if h : j = β then 1 else MvPolynomial.X ⟨j, h⟩ :=
        fun j => MvPolynomial.eval₂Hom_X' _ _ j
      have h_units : ∀ y : S_β, IsUnit (dehom_β y.1) := by
        rintro ⟨_, n, rfl⟩
        rw [map_pow, h_dehom_X β, dif_pos rfl, one_pow]
        exact isUnit_one
      let L_β := Localization.Away (MvPolynomial.X β : MvPolynomial (Fin 3) k)
      let loc_lift : L_β →+* MvPolynomial τ_β k := IsLocalization.lift h_units
      have h_loc_mk : ∀ (F : MvPolynomial (Fin 3) k) (s : S_β),
          loc_lift (Localization.mk F s) = dehom_β F := by
        intro F s
        rcases s with ⟨_, n, rfl⟩
        have hmk' : Localization.mk F (⟨MvPolynomial.X β ^ n, ⟨n, rfl⟩⟩ : S_β) =
            IsLocalization.mk' L_β F (⟨MvPolynomial.X β ^ n, ⟨n, rfl⟩⟩ : S_β) :=
          congrFun (congrFun Localization.mk_eq_mk' F) _
        rw [hmk']
        exact (IsLocalization.lift_mk'_spec h_units F (dehom_β F) _).mpr
          (by rw [map_pow, h_dehom_X β, dif_pos rfl, one_pow, one_mul])
      let val_hom : HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β) →+* L_β :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := fun _ _ => HomogeneousLocalization.val_mul _ _
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := fun _ _ => HomogeneousLocalization.val_add _ _ }
      let inv_hom : HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β) →+* MvPolynomial τ_β k :=
        loc_lift.comp val_hom
      let ι_kβ : k →+* HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β) :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜_2 S_β).comp (algebraMap k ↥(𝒜_2 0))
      let u_var : τ_β → HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β) := fun i =>
        HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X i.1,
              (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i.1)⟩,
            ⟨MvPolynomial.X β,
              (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k β)⟩,
            xβ_mem⟩
      let fwd_hom : MvPolynomial τ_β k →+* HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β) :=
        MvPolynomial.eval₂Hom ι_kβ u_var
      have h_ι_val : ∀ c : k, (ι_kβ c).val = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        have hc_val : (algebraMap k ↥(𝒜_2 0) c : MvPolynomial (Fin 3) k) = MvPolynomial.C c := by
          rw [Algebra.algebraMap_eq_smul_one, Algebra.smul_def, mul_one]; rfl
        change (HomogeneousLocalization.mk
          { deg := 0
            num := algebraMap k ↥(𝒜_2 0) c
            den := ⟨1, SetLike.one_mem_graded 𝒜_2⟩
            den_mem := S_β.one_mem }).val = Localization.mk (MvPolynomial.C c) 1
        rw [HomogeneousLocalization.val_mk]
        exact congrArg (fun q => Localization.mk q 1) hc_val
      have h_inv_fwd : inv_hom.comp fwd_hom = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext
        · intro c
          change loc_lift ((fwd_hom (MvPolynomial.C c)).val) = MvPolynomial.C c
          rw [MvPolynomial.eval₂Hom_C, h_ι_val c, h_loc_mk]
          exact MvPolynomial.eval₂Hom_C _ _ c
        · intro i
          change loc_lift ((fwd_hom (MvPolynomial.X i)).val) = MvPolynomial.X i
          rw [MvPolynomial.eval₂Hom_X']
          dsimp only [u_var]
          rw [HomogeneousLocalization.val_mk, h_loc_mk, h_dehom_X i.1, dif_neg i.2]
      have h_val_fwd_X : ∀ j : Fin 3,
          (fwd_hom (dehom_β (MvPolynomial.X j))).val =
            Localization.mk (MvPolynomial.X j) ⟨MvPolynomial.X β, xβ_mem⟩ := by
        intro j
        rw [h_dehom_X j]
        split_ifs with hj
        · subst hj
          rw [map_one, HomogeneousLocalization.val_one]
          exact (Localization.mk_self (⟨MvPolynomial.X j, xβ_mem⟩ : S_β)).symm
        · change (MvPolynomial.eval₂Hom ι_kβ u_var (MvPolynomial.X ⟨j, hj⟩)).val = _
          rw [MvPolynomial.eval₂Hom_X']
          dsimp only [u_var]
          exact HomogeneousLocalization.val_mk _
      have h_fwd_inv : fwd_hom.comp inv_hom = RingHom.id _ := by
        apply RingHom.ext
        intro z
        rw [RingHom.comp_apply, RingHom.id_apply]
        have hXβ_mem : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1 :=
          MvPolynomial.isHomogeneous_X k β
        obtain ⟨n, F, hF, rfl⟩ :=
          HomogeneousLocalization.Away.mk_surjective 𝒜_2 hXβ_mem z
        apply HomogeneousLocalization.val_injective
        have hinv_mk : inv_hom (HomogeneousLocalization.Away.mk 𝒜_2 hXβ_mem n F hF) = dehom_β F := by
          change loc_lift (HomogeneousLocalization.Away.mk 𝒜_2 hXβ_mem n F hF).val = dehom_β F
          rw [HomogeneousLocalization.Away.val_mk, h_loc_mk]
        rw [hinv_mk, HomogeneousLocalization.Away.val_mk]
        have hF_hom : F.IsHomogeneous n := by
          have h1 : n • (1 : ℕ) = n := nsmul_one n
          exact h1 ▸ hF
        change (val_hom.comp (fwd_hom.comp dehom_β)) F = _
        conv_lhs => rw [F.as_sum]
        conv_rhs => rw [F.as_sum]
        rw [map_sum]
        have hsum_mk : ∀ (T : Finset (Fin 3 →₀ ℕ)) (f : (Fin 3 →₀ ℕ) → MvPolynomial (Fin 3) k)
            (y : S_β),
            (∑ s ∈ T, Localization.mk (f s) y) = Localization.mk (∑ s ∈ T, f s) y := by
          intro T f y
          induction T using Finset.induction_on with
          | empty => simp [Localization.mk_zero]
          | @insert s₀ T' hs₀ ih =>
            rw [Finset.sum_insert hs₀, Finset.sum_insert hs₀, ih, Localization.add_mk_self]
        rw [← hsum_mk]
        refine Finset.sum_congr rfl fun s hs => ?_
        have hs_deg : (∑ j ∈ s.support, s j) = n := by
          have hd_eq : Finsupp.degree s = n := by
            by_contra hne
            exact (MvPolynomial.mem_support_iff.mp hs) (hF_hom.coeff_eq_zero hne)
          rwa [Finsupp.degree_apply] at hd_eq
        rw [MvPolynomial.monomial_eq, map_mul]
        have hC : (val_hom.comp (fwd_hom.comp dehom_β)) (MvPolynomial.C (F.coeff s)) =
            Localization.mk (MvPolynomial.C (F.coeff s)) 1 := by
          change (fwd_hom (dehom_β (MvPolynomial.C (F.coeff s)))).val = _
          have hdC : dehom_β (MvPolynomial.C (F.coeff s)) = MvPolynomial.C (F.coeff s) :=
            MvPolynomial.eval₂Hom_C _ _ _
          have hfC : fwd_hom (MvPolynomial.C (F.coeff s)) = ι_kβ (F.coeff s) :=
            MvPolynomial.eval₂Hom_C _ _ _
          rw [hdC, hfC, h_ι_val]
        rw [hC]
        change _ * (val_hom.comp (fwd_hom.comp dehom_β)) (∏ j ∈ s.support, MvPolynomial.X j ^ s j) = _
        rw [map_prod]
        simp_rw [map_pow]
        have hprod_mk : ∀ (T : Finset (Fin 3)),
            (∏ j ∈ T, ((val_hom.comp (fwd_hom.comp dehom_β)) (MvPolynomial.X j)) ^ s j) =
              Localization.mk (∏ j ∈ T, MvPolynomial.X j ^ s j)
                ⟨MvPolynomial.X β ^ (∑ j ∈ T, s j), S_β.pow_mem xβ_mem (∑ j ∈ T, s j)⟩ := by
          intro T
          induction T using Finset.induction_on with
          | empty => simp
          | @insert j₀ T' hj₀ ih =>
            rw [Finset.prod_insert hj₀, Finset.prod_insert hj₀, Finset.sum_insert hj₀, ih]
            have hj0 : (val_hom.comp (fwd_hom.comp dehom_β)) (MvPolynomial.X j₀) =
                Localization.mk (MvPolynomial.X j₀) ⟨MvPolynomial.X β, xβ_mem⟩ := h_val_fwd_X j₀
            rw [hj0, Localization.mk_pow, Localization.mk_mul]
            congr 1; ext; simp [pow_add]
        rw [hprod_mk s.support, Localization.mk_mul, one_mul]
        congr 1
        ext; simp [hs_deg]
      let e_β : MvPolynomial τ_β k ≃+* HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β) :=
        { toFun := fwd_hom
          invFun := inv_hom
          left_inv := fun x => DFunLike.congr_fun h_inv_fwd x
          right_inv := fun y => DFunLike.congr_fun h_fwd_inv y
          map_mul' := map_mul fwd_hom
          map_add' := map_add fwd_hom }
      refine ⟨e_β, ?_, ?_⟩
      · intro c
        exact MvPolynomial.eval₂Hom_C ι_kβ u_var c
      · intro d F hF den hden hp
        change loc_lift (HomogeneousLocalization.mk ⟨d, ⟨F, hF⟩, ⟨den, hden⟩, hp⟩).val = dehom_β F
        rw [HomogeneousLocalization.val_mk, h_loc_mk]

    let e_chart : ∀ β : Fin 3,
        MvPolynomial {r : Fin 3 // r ≠ β} k ≃+*
          HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β) :=
      fun β => Classical.choose (hChart_P2 β)
    have he_chart_C : ∀ (β : Fin 3) (c : k),
        e_chart β (MvPolynomial.C c) =
          (HomogeneousLocalization.fromZeroRingHom 𝒜_2
            (Submonoid.powers (MvPolynomial.X β))) (algebraMap k ↥(𝒜_2 0) c) :=
      fun β => (Classical.choose_spec (hChart_P2 β)).1
    have he_chart_symm : ∀ (β : Fin 3) (d : ℕ) (F : MvPolynomial (Fin 3) k) (hF : F ∈ 𝒜_2 d)
        (den : MvPolynomial (Fin 3) k) (hden : den ∈ 𝒜_2 d)
        (hp : den ∈ Submonoid.powers (MvPolynomial.X β)),
        (e_chart β).symm (HomogeneousLocalization.mk ⟨d, ⟨F, hF⟩, ⟨den, hden⟩, hp⟩) =
          MvPolynomial.eval₂Hom MvPolynomial.C
            (fun j : Fin 3 => if h : j = β then 1 else MvPolynomial.X ⟨j, h⟩) F :=
      fun β => (Classical.choose_spec (hChart_P2 β)).2

    let D_std : Fin 3 → X_2.Opens :=
      fun β => AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X β)
    have h_iSup_P2 : iSup D_std = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜_2 MvPolynomial.X hIrrel_2

    have hBasicOpen_away : ∀ (β : Fin 3) (hXβ : MvPolynomial.X β ∈ 𝒜_2 1)
        (d : ℕ) (hd : 0 < d) (G : MvPolynomial (Fin 3) k) (hG : G ∈ 𝒜_2 d)
        (hGd : G ∈ 𝒜_2 (d • 1)),
        X_2.basicOpen
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_2 (MvPolynomial.X β)).hom
            (HomogeneousLocalization.Away.mk 𝒜_2 hXβ d G hGd)) =
          D_std β ⊓ AlgebraicGeometry.Proj.basicOpen 𝒜_2 G := by
      intro β hXβ d hd G hG hGd
      let s_G := (AlgebraicGeometry.Proj.awayToSection 𝒜_2 (MvPolynomial.X β)).hom
        (HomogeneousLocalization.Away.mk 𝒜_2 hXβ d G hGd)
      have h_elem_eq : HomogeneousLocalization.Away.mk 𝒜_2 hXβ d G hGd =
          HomogeneousLocalization.Away.isLocalizationElem hXβ hG := by
        apply HomogeneousLocalization.val_injective
        dsimp [HomogeneousLocalization.Away.isLocalizationElem]
        simp [pow_one]
      ext p
      by_cases hp : p ∈ D_std β
      · have hp_rhs : p ∈ D_std β ⊓ AlgebraicGeometry.Proj.basicOpen 𝒜_2 G ↔
            p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_2 G := by
          change p ∈ (D_std β : Set _) ∧ p ∈ _ ↔ _
          exact and_iff_right hp
        change p ∈ X_2.basicOpen s_G ↔ p ∈ D_std β ⊓ AlgebraicGeometry.Proj.basicOpen 𝒜_2 G
        rw [hp_rhs]
        let iso_spec := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one
        let away_β := AlgebraicGeometry.Proj.awayι 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one
        let v_p := iso_spec.hom.base ⟨p, hp⟩
        have h_away_vp : away_β.base v_p = p := by
          dsimp [away_β, v_p, iso_spec]
          rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one]
          change ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one).hom ≫
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one).inv ≫
            (D_std β).ι).base ⟨p, hp⟩ = p
          rw [CategoryTheory.Iso.hom_inv_id_assoc]
          rfl
        have hp_G : p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_2 G ↔
            (v_p : PrimeSpectrum _) ∈ PrimeSpectrum.basicOpen
              (HomogeneousLocalization.Away.mk 𝒜_2 hXβ d G hGd) := by
          conv_lhs => rw [← h_away_vp]
          change v_p ∈ (TopologicalSpace.Opens.map away_β.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_2 G) ↔ _
          rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_2 hXβ zero_lt_one hG hd, h_elem_eq]
          rfl
        have h_hom_eq : iso_spec.hom =
            (D_std β).toSpecΓ ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_2 (MvPolynomial.X β)) :=
          AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one
        have hp_sG : p ∈ X_2.basicOpen s_G ↔
            (v_p : PrimeSpectrum _) ∈ PrimeSpectrum.basicOpen
              (HomogeneousLocalization.Away.mk 𝒜_2 hXβ d G hGd) := by
          have h1 : p ∈ X_2.basicOpen s_G ↔
              (⟨p, hp⟩ : ↥(D_std β)) ∈ (TopologicalSpace.Opens.map (D_std β).ι.base).obj
                (X_2.basicOpen s_G) := Iff.rfl
          rw [h1, ← AlgebraicGeometry.Scheme.Opens.toSpecΓ_preimage_basicOpen]
          change (D_std β).toSpecΓ.base ⟨p, hp⟩ ∈ PrimeSpectrum.basicOpen s_G ↔ _
          dsimp [s_G]
          rw [← AlgebraicGeometry.SpecMap_preimage_basicOpen]
          dsimp [v_p]
          rw [h_hom_eq]
          rfl
        rw [hp_sG, hp_G]
      · have hnot_lhs : p ∉ X_2.basicOpen s_G :=
          fun hmem => hp (X_2.basicOpen_le s_G hmem)
        have hnot_rhs : p ∉ D_std β ⊓ AlgebraicGeometry.Proj.basicOpen 𝒜_2 G :=
          fun hmem => hp hmem.1
        exact ⟨fun h => absurd h hnot_lhs, fun h => absurd h hnot_rhs⟩

    let D_P : X_2.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_2 P_disc
    let Z_disc : TopologicalSpace.Closeds ↥X_2 := ⟨(D_P : Set X_2)ᶜ, D_P.2.isClosed_compl⟩
    let I_disc : X_2.IdealSheafData :=
      AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z_disc
    let C_sch : AlgebraicGeometry.Scheme.{u} := I_disc.subscheme
    let sub_ι : C_sch ⟶ X_2 := I_disc.subschemeι
    let C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (sub_ι ≫ P_2.hom)
    let ι_disc : C_disc ⟶ P_2 := CategoryTheory.Over.homMk sub_ι rfl

    have hCl_sub : AlgebraicGeometry.IsClosedImmersion sub_ι := inferInstance
    have hCl_disc : AlgebraicGeometry.IsClosedImmersion ι_disc.left := hCl_sub

    have hProp_disc : AlgebraicGeometry.IsProper C_disc.hom := by
      have : IsScalarTower k ↥(𝒜_2 0) (MvPolynomial (Fin 3) k) :=
        IsScalarTower.of_algebraMap_eq (R := k) (S := ↥(𝒜_2 0))
          (A := MvPolynomial (Fin 3) k) fun c => by
          change MvPolynomial.C c = (algebraMap k ↥(𝒜_2 0) c : MvPolynomial (Fin 3) k)
          rw [Algebra.algebraMap_eq_smul_one, Algebra.smul_def, mul_one]; rfl
      have : Algebra.FiniteType ↥(𝒜_2 0) (MvPolynomial (Fin 3) k) :=
        Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜_2 0) (MvPolynomial (Fin 3) k)
      have hsurj_zero : Function.Surjective (algebraMap k ↥(𝒜_2 0)) := fun x =>
        ⟨x.1.coeff 0, Subtype.ext <| by
          rw [Algebra.algebraMap_eq_smul_one, Algebra.smul_def, mul_one]
          exact (hDeg0_2 x.1 x.2).symm⟩
      have : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_2 0)))) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
          (CommRingCat.ofHom (algebraMap k ↥(𝒜_2 0))) hsurj_zero
      change AlgebraicGeometry.IsProper
        (sub_ι ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜_2 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_2 0))))
      infer_instance

    have hRange_sub : Set.range sub_ι.base = (D_P : Set X_2)ᶜ := by
      dsimp [sub_ι]
      rw [I_disc.range_subschemeι, AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl

    have hRad_away : ∀ {R R_g : Type u} [CommRing R] [CommRing R_g] [Algebra R R_g]
        (f g : R) [IsLocalization.Away g R_g],
        (Ideal.span {f}).IsRadical → (Ideal.span {algebraMap R R_g f}).IsRadical := by
      rintro R R_g _ _ _ f g _ hRad_f y ⟨m, hym⟩
      rcases Nat.eq_zero_or_pos m with rfl | hm_pos
      · rw [pow_zero] at hym
        have htop : Ideal.span ({algebraMap R R_g f} : Set R_g) = ⊤ :=
          Ideal.eq_top_of_isUnit_mem _ hym isUnit_one
        rw [htop]
        trivial
      · rw [Ideal.mem_span_singleton] at hym ⊢
        rcases hym with ⟨z, hyz⟩
        obtain ⟨k_y, a, hya⟩ := IsLocalization.Away.surj g y
        obtain ⟨k_z, b, hzb⟩ := IsLocalization.Away.surj g z
        have h_alg_eq : algebraMap R R_g (g ^ k_z * a ^ m) =
            algebraMap R R_g (f * b * g ^ (m * k_y)) := by
          rw [map_mul, map_pow, map_pow, ← hya]
          calc algebraMap R R_g g ^ k_z * (y * algebraMap R R_g g ^ k_y) ^ m
              = y ^ m * algebraMap R R_g g ^ k_z * algebraMap R R_g g ^ (m * k_y) := by ring
            _ = algebraMap R R_g f * (z * algebraMap R R_g g ^ k_z) *
                  algebraMap R R_g g ^ (m * k_y) := by rw [hyz]; ring
            _ = algebraMap R R_g f * algebraMap R R_g b *
                  algebraMap R R_g g ^ (m * k_y) := by rw [hzb]
            _ = algebraMap R R_g (f * b * g ^ (m * k_y)) := by simp [map_mul, map_pow]
        obtain ⟨⟨_, l, rfl⟩, hl_eq⟩ :=
          (IsLocalization.eq_iff_exists (Submonoid.powers g) R_g).mp h_alg_eq
        have h_pow_in : (g ^ (l + k_z) * a) ^ m ∈ Ideal.span ({f} : Set R) := by
          rw [Ideal.mem_span_singleton]
          obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, (Nat.sub_add_cancel hm_pos).symm⟩
          have hl_eq' : g ^ l * (g ^ k_z * a ^ (m' + 1)) =
              g ^ l * (f * b * g ^ ((m' + 1) * k_y)) := hl_eq
          refine ⟨g ^ (m' * (l + k_z)) * g ^ l * b * g ^ ((m' + 1) * k_y), ?_⟩
          calc (g ^ (l + k_z) * a) ^ (m' + 1)
              = g ^ (m' * (l + k_z)) * (g ^ l * (g ^ k_z * a ^ (m' + 1))) := by ring
            _ = g ^ (m' * (l + k_z)) * (g ^ l * (f * b * g ^ ((m' + 1) * k_y))) := by rw [hl_eq']
            _ = f * (g ^ (m' * (l + k_z)) * g ^ l * b * g ^ ((m' + 1) * k_y)) := by ring
        have ha_in := hRad_f ⟨m, h_pow_in⟩
        rw [Ideal.mem_span_singleton] at ha_in
        rcases ha_in with ⟨c, hfc⟩
        let g_inv : R_g := IsLocalization.Away.invSelf (S := R_g) g
        have hgg : algebraMap R R_g g * g_inv = 1 := IsLocalization.Away.mul_invSelf g
        refine ⟨algebraMap R R_g c * g_inv ^ (l + k_z + k_y), ?_⟩
        have h_fc_alg := congrArg (algebraMap R R_g) hfc
        rw [map_mul, map_pow, map_mul] at h_fc_alg
        calc y = y * (algebraMap R R_g g * g_inv) ^ k_y *
                (algebraMap R R_g g * g_inv) ^ (l + k_z) := by
              rw [hgg, one_pow, one_pow, mul_one, mul_one]
          _ = (algebraMap R R_g g ^ (l + k_z) * (y * algebraMap R R_g g ^ k_y)) *
                g_inv ^ (l + k_z + k_y) := by ring
          _ = (algebraMap R R_g g ^ (l + k_z) * algebraMap R R_g a) *
                g_inv ^ (l + k_z + k_y) := by rw [hya]
          _ = (algebraMap R R_g f * algebraMap R R_g c) * g_inv ^ (l + k_z + k_y) := by
              rw [h_fc_alg]
          _ = algebraMap R R_g f * (algebraMap R R_g c * g_inv ^ (l + k_z + k_y)) := by ring

    have hid_appLE : ∀ {V U : X_2.Opens}
        (e : U ≤ (𝟙 X_2) ⁻¹ᵁ V),
        AlgebraicGeometry.Scheme.Hom.appLE (𝟙 X_2) V U e =
          X_2.presheaf.map (CategoryTheory.homOfLE (e : U ≤ V)).op := by
      intro V U e
      have h1 := AlgebraicGeometry.Scheme.Hom.appLE_map (𝟙 X_2)
        (le_rfl : (𝟙 X_2) ⁻¹ᵁ V ≤ _)
        (CategoryTheory.homOfLE e).op
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE (𝟙 X_2),
        AlgebraicGeometry.Scheme.Hom.id_app] at h1
      have h2 : AlgebraicGeometry.Scheme.Hom.appLE (𝟙 X_2) V U e =
          𝟙 (X_2.presheaf.obj (Opposite.op V)) ≫
            X_2.presheaf.map (CategoryTheory.homOfLE (e : U ≤ V)).op := h1.symm
      exact h2.trans (CategoryTheory.Category.id_comp _)

    have hFP : P_disc ∈ 𝒜_2 (D_disc • 1) := by rwa [nsmul_one]

    have hHyp_disc : IsHomogeneousHypersurfacePullbackOver k 2 D_disc
        (𝟙 P_2) P_disc ι_disc.left := by
      refine ⟨hCl_disc, hFP, hRange_sub, ?_⟩
      intro μ hXμ U_P hAffU_P hU_sub
      let U : X_2.Opens := U_P
      let hAffU : AlgebraicGeometry.IsAffineOpen U := hAffU_P
      let U_aff : X_2.affineOpens := ⟨U, hAffU⟩
      have hU_le : U ≤ D_std μ := hU_sub
      have hU_le_id : U ≤ (𝟙 X_2) ⁻¹ᵁ D_std μ := hU_sub
      let iso_away := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X μ) hXμ zero_lt_one
      let R_μ := ↑(X_2.presheaf.obj (Opposite.op (D_std μ)))
      let R_U := ↑(X_2.presheaf.obj (Opposite.op U))
      let f_μ : R_μ :=
        (AlgebraicGeometry.Proj.awayToSection 𝒜_2 (MvPolynomial.X μ)).hom
          (HomogeneousLocalization.Away.mk 𝒜_2 hXμ D_disc P_disc hFP)
      let f_U : R_U := (AlgebraicGeometry.Scheme.Hom.appLE (𝟙 X_2) (D_std μ) U hU_le_id).hom f_μ
      change RingHom.ker (I_disc.subschemeι.app U_aff.1).hom = Ideal.span ({f_U} : Set R_U)
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι_app,
        AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal]
      have hfU_res : f_U = (X_2.presheaf.map (CategoryTheory.homOfLE hU_le).op).hom f_μ := by
        dsimp only [f_U]
        rw [hid_appLE hU_le_id]
        rfl
      have hBasic_fU : X_2.basicOpen f_U = U ⊓ D_P := by
        rw [hfU_res, AlgebraicGeometry.Scheme.basicOpen_res,
          hBasicOpen_away μ hXμ D_disc hD P_disc hHomog hFP,
          ← inf_assoc, inf_eq_left.mpr hU_le]
      have hPre_Z : hAffU.fromSpec.base ⁻¹' (Z_disc : Set X_2) =
          PrimeSpectrum.zeroLocus ({f_U} : Set R_U) := by
        ext v
        have hv_in_U : hAffU.fromSpec.base v ∈ (U : Set X_2) := by
          rw [← U.range_ι, ← hAffU.isoSpec_inv_ι]
          exact ⟨hAffU.isoSpec.inv.base v, rfl⟩
        change hAffU.fromSpec.base v ∉ (D_P : Set X_2) ↔
          ({f_U} : Set R_U) ⊆ (v : PrimeSpectrum R_U).asIdeal
        rw [Set.singleton_subset_iff]
        have h_in_basic : hAffU.fromSpec.base v ∈ (D_P : Set X_2) ↔
            hAffU.fromSpec.base v ∈ X_2.basicOpen f_U := by
          rw [hBasic_fU]
          exact (and_iff_right hv_in_U).symm
        rw [h_in_basic]
        change v ∉ (TopologicalSpace.Opens.map hAffU.fromSpec.base).obj (X_2.basicOpen f_U) ↔ _
        rw [hAffU.fromSpec_preimage_basicOpen f_U]
        let v' : PrimeSpectrum R_U := v
        change v' ∉ PrimeSpectrum.basicOpen f_U ↔ _
        rw [PrimeSpectrum.mem_basicOpen, not_not]
        rfl
      have hvan_eq : PrimeSpectrum.vanishingIdeal
          (hAffU.fromSpec.base ⁻¹' (Z_disc : Set X_2)) =
          (Ideal.span ({f_U} : Set R_U)).radical :=
        (congrArg PrimeSpectrum.vanishingIdeal
          ((hPre_Z : (hAffU.fromSpec.base ⁻¹' (Z_disc : Set X_2) : Set (PrimeSpectrum R_U)) =
            PrimeSpectrum.zeroLocus ({f_U} : Set R_U)).trans
            (PrimeSpectrum.zeroLocus_span ({f_U} : Set R_U)).symm)).trans
          (PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical (Ideal.span ({f_U} : Set R_U)))
      let eq_away : HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X μ) ≃+* R_μ :=
        { toFun := iso_away.hom.hom
          invFun := iso_away.inv.hom
          left_inv := fun x => by
            change (iso_away.hom ≫ iso_away.inv).hom x = x
            rw [iso_away.hom_inv_id]; rfl
          right_inv := fun y => by
            change (iso_away.inv ≫ iso_away.hom).hom y = y
            rw [iso_away.inv_hom_id]; rfl
          map_mul' := fun _ _ => map_mul _ _ _
          map_add' := fun _ _ => map_add _ _ _ }
      let φ_μ : MvPolynomial {r : Fin 3 // r ≠ μ} k ≃+* R_μ := (e_chart μ).trans eq_away
      have hφ_p : φ_μ (MvPolynomial.eval₂Hom MvPolynomial.C
          (fun j : Fin 3 => if h : j = μ then 1 else MvPolynomial.X ⟨j, h⟩) P_disc) = f_μ := by
        dsimp only [φ_μ, eq_away, iso_away, f_μ, RingEquiv.trans_apply]
        change (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X μ) hXμ zero_lt_one).hom.hom _ = _
        rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
        congr 1
        have hXμD : (MvPolynomial.X μ : MvPolynomial (Fin 3) k) ^ D_disc ∈ 𝒜_2 D_disc :=
          (MvPolynomial.mem_homogeneousSubmodule D_disc _).mpr (MvPolynomial.isHomogeneous_X_pow μ D_disc)
        have hsymm := he_chart_symm μ D_disc P_disc hHomog ((MvPolynomial.X μ) ^ D_disc) hXμD
          (pow_mem (Submonoid.mem_powers (MvPolynomial.X μ)) D_disc)
        have hmk_eq : HomogeneousLocalization.mk ⟨D_disc, ⟨P_disc, hHomog⟩,
            ⟨(MvPolynomial.X μ) ^ D_disc, hXμD⟩,
            pow_mem (Submonoid.mem_powers (MvPolynomial.X μ)) D_disc⟩ =
            HomogeneousLocalization.Away.mk 𝒜_2 hXμ D_disc P_disc hFP := by
          apply HomogeneousLocalization.val_injective
          rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.Away.val_mk]
        rw [hmk_eq] at hsymm
        rw [← hsymm, RingEquiv.apply_symm_apply]
      have hRad_fμ : (Ideal.span ({f_μ} : Set R_μ)).IsRadical := by
        rintro x ⟨m, hxm⟩
        have h1 : (φ_μ.symm x) ^ m ∈ Ideal.span
            {MvPolynomial.eval₂Hom MvPolynomial.C
              (fun j : Fin 3 => if h : j = μ then 1 else MvPolynomial.X ⟨j, h⟩) P_disc} := by
          rw [Ideal.mem_span_singleton] at hxm ⊢
          rcases hxm with ⟨c, hxc⟩
          refine ⟨φ_μ.symm c, ?_⟩
          apply φ_μ.injective
          rw [map_pow, map_mul, hφ_p, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply, hxc]
        have h2 := hRad μ ⟨m, h1⟩
        rw [Ideal.mem_span_singleton] at h2 ⊢
        rcases h2 with ⟨c, hc⟩
        refine ⟨φ_μ c, ?_⟩
        rw [← hφ_p, ← map_mul, ← hc, RingEquiv.apply_symm_apply]
      have hAff_Dμ : AlgebraicGeometry.IsAffineOpen (D_std μ) :=
        AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_2 (MvPolynomial.X μ) hXμ zero_lt_one
      have hRad_fU : (Ideal.span ({f_U} : Set R_U)).IsRadical := by
        rintro r ⟨m, hrm⟩
        let colon_J : Ideal R_U :=
          { carrier := { s : R_U | s * r ∈ Ideal.span ({f_U} : Set R_U) }
            add_mem' := fun {a b} ha hb => by
              simp only [Set.mem_setOf_eq] at ha hb ⊢
              rw [add_mul]; exact Ideal.add_mem _ ha hb
            zero_mem' := by
              simp only [Set.mem_setOf_eq]
              rw [zero_mul]; exact Ideal.zero_mem _
            smul_mem' := fun c {a} ha => by
              simp only [Set.mem_setOf_eq] at ha ⊢
              rw [smul_eq_mul, mul_assoc]
              exact Ideal.mul_mem_left _ c ha }
        suffices htop : colon_J = ⊤ by
          have h1 : (1 : R_U) ∈ colon_J := htop ▸ Submodule.mem_top
          have h1' : (1 : R_U) * r ∈ Ideal.span ({f_U} : Set R_U) := h1
          rwa [one_mul] at h1'
        by_contra hne_top
        obtain ⟨𝔪, h𝔪_max, hJ_le⟩ := Ideal.exists_le_maximal colon_J hne_top
        let p_U : PrimeSpectrum R_U := ⟨𝔪, h𝔪_max.isPrime⟩
        let x_pt : X_2 := hAffU.fromSpec.base p_U
        have hx_U : x_pt ∈ U := by
          change hAffU.fromSpec.base p_U ∈ (U : Set X_2)
          rw [← U.range_ι, ← hAffU.isoSpec_inv_ι]
          exact ⟨hAffU.isoSpec.inv.base p_U, rfl⟩
        obtain ⟨g, hW_le_U, hx_W⟩ := hAff_Dμ.exists_basicOpen_le ⟨x_pt, hx_U⟩ (hU_le hx_U)
        let W := X_2.basicOpen g
        let res_μU := (X_2.presheaf.map (CategoryTheory.homOfLE hU_le).op).hom
        let g_U : R_U := res_μU g
        have hW_eq : X_2.basicOpen g_U = W := by
          dsimp [g_U, res_μU, W]
          rw [AlgebraicGeometry.Scheme.basicOpen_res, inf_eq_right.mpr hW_le_U]
        have hgU_not_𝔪 : g_U ∉ 𝔪 := by
          have hx_gU : hAffU.fromSpec.base p_U ∈ X_2.basicOpen g_U := hW_eq.symm ▸ hx_W
          change (p_U : ↥(AlgebraicGeometry.Spec _)) ∈
            (TopologicalSpace.Opens.map hAffU.fromSpec.base).obj (X_2.basicOpen g_U) at hx_gU
          rw [hAffU.fromSpec_preimage_basicOpen g_U] at hx_gU
          exact (PrimeSpectrum.mem_basicOpen g_U p_U).mp hx_gU
        let R_W := ↑(X_2.presheaf.obj (Opposite.op W))
        let R_W' := ↑(X_2.presheaf.obj (Opposite.op (X_2.basicOpen g_U)))
        let res_μW : R_μ →+* R_W :=
          (X_2.presheaf.map (CategoryTheory.homOfLE (X_2.basicOpen_le g)).op).hom
        let res_UW : R_U →+* R_W :=
          (X_2.presheaf.map (CategoryTheory.homOfLE hW_le_U).op).hom
        have h_res_comp : res_UW.comp res_μU = res_μW := by
          dsimp [res_UW, res_μU, res_μW]
          rw [← CommRingCat.hom_comp, ← X_2.presheaf.map_comp]
          rfl
        let _ : Algebra R_μ R_W := res_μW.toAlgebra
        have : IsLocalization.Away g R_W := hAff_Dμ.isLocalization_basicOpen g
        have hRad_W : (Ideal.span ({res_μW f_μ} : Set R_W)).IsRadical :=
          hRad_away f_μ g hRad_fμ
        have hfW_eq : res_UW f_U = res_μW f_μ := by
          rw [hfU_res, ← RingHom.comp_apply, h_res_comp]
        have hrW_pow : (res_UW r) ^ m ∈ Ideal.span ({res_μW f_μ} : Set R_W) := by
          rw [← hfW_eq, ← map_pow]
          rcases Ideal.mem_span_singleton.mp hrm with ⟨c, hc⟩
          exact Ideal.mem_span_singleton.mpr ⟨res_UW c, by rw [← map_mul, hc]⟩
        have hrW_mem : res_UW r ∈ Ideal.span ({res_μW f_μ} : Set R_W) := hRad_W ⟨m, hrW_pow⟩
        rw [← hfW_eq, Ideal.mem_span_singleton] at hrW_mem
        rcases hrW_mem with ⟨z_W, hz_W⟩
        let res_UW' : R_U →+* R_W' :=
          (X_2.presheaf.map (CategoryTheory.homOfLE (X_2.basicOpen_le g_U)).op).hom
        let iso_WW' := X_2.presheaf.mapIso (CategoryTheory.eqToIso hW_eq).op
        let _ : Algebra R_U R_W' := res_UW'.toAlgebra
        have : IsLocalization.Away g_U R_W' := hAffU.isLocalization_basicOpen g_U
        have h_iso_res : ∀ u : R_U, iso_WW'.hom.hom (res_UW u) = res_UW' u := by
          intro u
          have h_eq_mor : X_2.presheaf.map (CategoryTheory.homOfLE hW_le_U).op ≫ iso_WW'.hom =
              X_2.presheaf.map (CategoryTheory.homOfLE (X_2.basicOpen_le g_U)).op := by
            dsimp [iso_WW']
            rw [← X_2.presheaf.map_comp]
            congr 1
          exact congrArg (fun φ => φ.hom u) h_eq_mor
        let z_W' : R_W' := iso_WW'.hom.hom z_W
        have hz_W' : res_UW' r = res_UW' f_U * z_W' := by
          rw [← h_iso_res r, ← h_iso_res f_U, ← map_mul iso_WW'.hom.hom, hz_W]
        obtain ⟨k_z, b_U, hzb_U⟩ := IsLocalization.Away.surj g_U z_W'
        have hzb_U' : z_W' * res_UW' g_U ^ k_z = res_UW' b_U := hzb_U
        have h_alg_U : algebraMap R_U R_W' (g_U ^ k_z * r) =
            algebraMap R_U R_W' (f_U * b_U) := by
          change res_UW' (g_U ^ k_z * r) = res_UW' (f_U * b_U)
          rw [map_mul, map_pow, hz_W', map_mul]
          calc res_UW' g_U ^ k_z * (res_UW' f_U * z_W')
              = res_UW' f_U * (z_W' * res_UW' g_U ^ k_z) := by ring
            _ = res_UW' f_U * res_UW' b_U := by rw [hzb_U']
        obtain ⟨⟨_, l_U, rfl⟩, hl_U⟩ :=
          (IsLocalization.eq_iff_exists (Submonoid.powers g_U) R_W').mp h_alg_U
        have hg_in_J : g_U ^ (l_U + k_z) ∈ colon_J := by
          change g_U ^ (l_U + k_z) * r ∈ Ideal.span ({f_U} : Set R_U)
          rw [Ideal.mem_span_singleton]
          refine ⟨g_U ^ l_U * b_U, ?_⟩
          calc g_U ^ (l_U + k_z) * r = g_U ^ l_U * (g_U ^ k_z * r) := by ring
            _ = g_U ^ l_U * (f_U * b_U) := hl_U
            _ = f_U * (g_U ^ l_U * b_U) := by ring
        have hg_in_𝔪 : g_U ^ (l_U + k_z) ∈ 𝔪 := hJ_le hg_in_J
        rcases Nat.eq_zero_or_pos (l_U + k_z) with h0 | hpos
        · rw [h0, pow_zero] at hg_in_𝔪
          exact h𝔪_max.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hg_in_𝔪 isUnit_one)
        · exact hgU_not_𝔪 (h𝔪_max.isPrime.mem_of_pow_mem _ hg_in_𝔪)
      exact hvan_eq.trans hRad_fU.radical

    have hRed_sch : AlgebraicGeometry.IsReduced C_sch := by
      let W_cov : Fin 3 → C_sch.Opens :=
        fun β => (TopologicalSpace.Opens.map sub_ι.base).obj (D_std β)
      have hW_aff : ∀ β : Fin 3, AlgebraicGeometry.IsAffineOpen (W_cov β) := fun β =>
        (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_2 (MvPolynomial.X β)
          (MvPolynomial.isHomogeneous_X k β) zero_lt_one).preimage sub_ι
      have h_cov_red : ∀ c : ↥C_sch, ∃ (β : Fin 3) (x : ↥(AlgebraicGeometry.Spec
          (C_sch.presheaf.obj (Opposite.op (W_cov β))))),
          ((hW_aff β).fromSpec).base x = c := by
        intro c
        have hp_top : sub_ι.base c ∈ (⊤ : X_2.Opens) := TopologicalSpace.Opens.mem_top _
        rw [← h_iSup_P2, TopologicalSpace.Opens.mem_iSup] at hp_top
        rcases hp_top with ⟨β, hc_β⟩
        have hc_W : c ∈ W_cov β := hc_β
        refine ⟨β, (hW_aff β).isoSpec.hom.base ⟨c, hc_W⟩, ?_⟩
        rw [← (hW_aff β).isoSpec_inv_ι]
        change ((hW_aff β).isoSpec.hom ≫ (hW_aff β).isoSpec.inv ≫ (W_cov β).ι).base ⟨c, hc_W⟩ = c
        rw [CategoryTheory.Iso.hom_inv_id_assoc]
        rfl
      let 𝒰_red : C_sch.OpenCover :=
        AlgebraicGeometry.Scheme.Cover.mkOfCovers (Fin 3)
          (fun β => AlgebraicGeometry.Spec (C_sch.presheaf.obj (Opposite.op (W_cov β))))
          (fun β => (hW_aff β).fromSpec)
          h_cov_red
          (fun _ => inferInstance)
      have : ∀ β : 𝒰_red.I₀, AlgebraicGeometry.IsReduced (𝒰_red.X β) := by
        intro β
        let β_fin : Fin 3 := β
        change AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (C_sch.presheaf.obj (Opposite.op (W_cov β_fin))))
        rw [AlgebraicGeometry.affine_isReduced_iff]
        let U_β : X_2.affineOpens :=
          ⟨D_std β_fin, AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_2 (MvPolynomial.X β_fin)
            (MvPolynomial.isHomogeneous_X k β_fin) zero_lt_one⟩
        have hsurj_app : Function.Surjective (sub_ι.app U_β.1).hom :=
          AlgebraicGeometry.Scheme.Hom.app_surjective sub_ι U_β.1 U_β.2
        have hker_rad : (RingHom.ker (sub_ι.app U_β.1).hom).IsRadical := by
          dsimp only [sub_ι]
          rw [AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι_app,
            AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal]
          rintro x ⟨n, hxn⟩
          exact (PrimeSpectrum.mem_vanishingIdeal _ x).mpr fun p hp =>
            p.isPrime.mem_of_pow_mem n ((PrimeSpectrum.mem_vanishingIdeal _ (x ^ n)).mp hxn p hp)
        have : IsReduced (↑(X_2.presheaf.obj (Opposite.op U_β.1)) ⧸
            RingHom.ker (sub_ι.app U_β.1).hom) := by
          refine ⟨fun q ⟨n, hqn⟩ => ?_⟩
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q
          rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem] at hqn
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (hker_rad ⟨n, hqn⟩)
        let eq_quot := RingHom.quotientKerEquivOfSurjective hsurj_app
        exact isReduced_of_injective eq_quot.symm.toRingHom eq_quot.symm.injective
      exact AlgebraicGeometry.IsReduced.of_openCover C_sch 𝒰_red

    have hIrredSpace_sch : IrreducibleSpace ↥C_sch := by
      have hPrimeP : Prime P_disc := UniqueFactorizationMonoid.irreducible_iff_prime.mp hIrred
      let I_η : Ideal (MvPolynomial (Fin 3) k) := Ideal.span {P_disc}
      have hI_η_prime : I_η.IsPrime := (Ideal.span_singleton_prime hIrred.ne_zero).mpr hPrimeP
      have hI_η_hom : I_η.IsHomogeneous 𝒜_2 :=
        Ideal.homogeneous_span 𝒜_2 {P_disc}
          (fun x hx => by rw [Set.mem_singleton_iff.mp hx]; exact ⟨D_disc, hHomog⟩)
      let H_η : HomogeneousIdeal 𝒜_2 := ⟨I_η, hI_η_hom⟩
      have h_not_irr : ¬ HomogeneousIdeal.irrelevant 𝒜_2 ≤ H_η := by
        intro hle
        have hX1_in : MvPolynomial.X 1 ∈ I_η :=
          hle (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_2 zero_lt_one (MvPolynomial.isHomogeneous_X k 1))
        rw [Ideal.mem_span_singleton] at hX1_in
        rcases hX1_in with ⟨Q, hPQ⟩
        have hev := congrArg (MvPolynomial.eval ![0, 1, 0]) hPQ
        simp [hEval010] at hev
      let η_pt : ProjectiveSpectrum 𝒜_2 := ⟨H_η, hI_η_prime, h_not_irr⟩
      let η_X2 : X_2 := η_pt
      have hη_in_range : η_X2 ∈ Set.range sub_ι.base := by
        rw [hRange_sub, Set.mem_compl_iff]
        change η_X2 ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_2 P_disc
        rw [AlgebraicGeometry.Proj.mem_basicOpen, not_not]
        exact Ideal.subset_span rfl
      obtain ⟨c_η, hc_η⟩ := hη_in_range
      have hClosedEmb := AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding sub_ι
      have hDense_η : ∀ V : Set ↥C_sch, IsOpen V → V.Nonempty → c_η ∈ V := by
        intro V hV_open ⟨c₀, hc₀⟩
        have hVc_closed : IsClosed (sub_ι.base '' Vᶜ) :=
          hClosedEmb.isClosedMap Vᶜ hV_open.isClosed_compl
        let O_amb : Set (ProjectiveSpectrum 𝒜_2) := (sub_ι.base '' Vᶜ)ᶜ
        have hO_open : IsOpen O_amb := hVc_closed.isOpen_compl
        rw [ProjectiveSpectrum.isOpen_iff] at hO_open
        rcases hO_open with ⟨s_set, hs_eq⟩
        have hc₀_in_O : (sub_ι.base c₀ : ProjectiveSpectrum 𝒜_2) ∈ O_amb := by
          rintro ⟨c', hc'_compl, hc'_eq⟩
          have hc'_c0 : c' = c₀ := hClosedEmb.injective hc'_eq
          subst hc'_c0
          exact hc'_compl hc₀
        by_contra hc_η_not
        have hη_not_O : η_pt ∉ O_amb := by
          intro h
          apply h
          exact ⟨c_η, hc_η_not, hc_η⟩
        have hη_in_Oc : η_pt ∈ O_ambᶜ := hη_not_O
        rw [hs_eq] at hη_in_Oc
        have hs_le_Iη : s_set ⊆ I_η := hη_in_Oc
        have hP_in_c0 : P_disc ∈ (sub_ι.base c₀ : ProjectiveSpectrum 𝒜_2).asHomogeneousIdeal := by
          have hmem : sub_ι.base c₀ ∈ Set.range sub_ι.base := ⟨c₀, rfl⟩
          rw [hRange_sub, Set.mem_compl_iff] at hmem
          change sub_ι.base c₀ ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_2 P_disc at hmem
          rwa [AlgebraicGeometry.Proj.mem_basicOpen, not_not] at hmem
        have hIη_le_c0 : I_η ≤ (sub_ι.base c₀ : ProjectiveSpectrum 𝒜_2).asHomogeneousIdeal.toIdeal := by
          rw [Ideal.span_le, Set.singleton_subset_iff]
          exact hP_in_c0
        have hc₀_in_zero : (sub_ι.base c₀ : ProjectiveSpectrum 𝒜_2) ∈
            ProjectiveSpectrum.zeroLocus 𝒜_2 s_set :=
          Set.Subset.trans hs_le_Iη hIη_le_c0
        rw [← hs_eq] at hc₀_in_zero
        exact hc₀_in_zero hc₀_in_O
      exact {
        isPreirreducible_univ := fun U₁ U₂ hU₁ hU₂ ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩ =>
          ⟨c_η, trivial, hDense_η U₁ hU₁ ⟨x₁, hx₁⟩, hDense_η U₂ hU₂ ⟨x₂, hx₂⟩⟩
        toNonempty := ⟨c_η⟩
      }

    have hInt_sch : AlgebraicGeometry.IsIntegral C_sch :=
      @AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced C_sch hRed_sch hIrredSpace_sch
    have hInt_disc : AlgebraicGeometry.IsIntegral C_disc.left := hInt_sch

    let F_bad_X2 : Set X_2 := F_bad_plane
    have hClosed_bad_X2 : IsClosed F_bad_X2 := hClosed_bad
    let S_sing : Set X_2 :=
      ⋂ r : Fin 3, (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.pderiv r P_disc) : Set X_2)ᶜ
    have hClosed_sing : IsClosed S_sing :=
      isClosed_iInter fun r =>
        (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.pderiv r P_disc)).2.isClosed_compl
    let W_reg_amb : X_2.Opens :=
      ⟨(F_bad_X2 ∪ S_sing)ᶜ, (hClosed_bad_X2.union hClosed_sing).isOpen_compl⟩
    let U_reg_sch : C_sch.Opens :=
      (TopologicalSpace.Opens.map sub_ι.base).obj W_reg_amb
    let U_disc_reg : C_disc.left.Opens := U_reg_sch

    have hImg_reg_sch : sub_ι.base '' (U_reg_sch : Set C_sch) =
        { p : X_2 |
          P_disc ∈ (p : ProjectiveSpectrum 𝒜_2).asHomogeneousIdeal ∧
          p ∉ F_bad_X2 ∧
          ∃ r : Fin 3, MvPolynomial.pderiv r P_disc ∉
            (p : ProjectiveSpectrum 𝒜_2).asHomogeneousIdeal } := by
      ext p
      have hp_range : p ∈ Set.range sub_ι.base ↔
          P_disc ∈ (p : ProjectiveSpectrum 𝒜_2).asHomogeneousIdeal := by
        rw [hRange_sub, Set.mem_compl_iff]
        change p ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_2 P_disc ↔ _
        rw [AlgebraicGeometry.Proj.mem_basicOpen, not_not]
      have hp_W : p ∈ (W_reg_amb : Set X_2) ↔
          p ∉ F_bad_X2 ∧ ∃ r : Fin 3, MvPolynomial.pderiv r P_disc ∉
            (p : ProjectiveSpectrum 𝒜_2).asHomogeneousIdeal := by
        change p ∉ F_bad_X2 ∪ S_sing ↔ _
        rw [Set.mem_union, not_or]
        refine and_congr_right fun _ => ?_
        dsimp [S_sing]
        rw [Set.mem_iInter, not_forall]
        refine exists_congr fun r => ?_
        change ¬ (p ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.pderiv r P_disc)) ↔ _
        rw [not_not, AlgebraicGeometry.Proj.mem_basicOpen]
      constructor
      · rintro ⟨c, hc_reg, rfl⟩
        have hc_range : sub_ι.base c ∈ Set.range sub_ι.base := ⟨c, rfl⟩
        have hc_W : sub_ι.base c ∈ (W_reg_amb : Set X_2) := hc_reg
        exact ⟨hp_range.mp hc_range, (hp_W.mp hc_W).1, (hp_W.mp hc_W).2⟩
      · rintro ⟨hP_in, hnot_bad, hex_r⟩
        obtain ⟨c, rfl⟩ := hp_range.mpr hP_in
        have hc_reg : c ∈ U_reg_sch := hp_W.mpr ⟨hnot_bad, hex_r⟩
        exact ⟨c, hc_reg, rfl⟩

    have hImg_reg : ι_disc.left.base '' (U_disc_reg : Set C_disc.left) =
        { p : P_2.left |
          P_disc ∈ ProjectiveSpectrum.asHomogeneousIdeal p ∧
          p ∉ F_bad_plane ∧
          ∃ r : Fin 3, MvPolynomial.pderiv r P_disc ∉ ProjectiveSpectrum.asHomogeneousIdeal p } :=
      hImg_reg_sch

    have hSm_reg : AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_disc_reg.ι ≫ C_disc.hom) := by
      let p2_hom : X_2 ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) := P_2.hom
      have hLocalChart : ∀ x : ↥U_reg_sch,
          ∃ (R_x : CommRingCat.{u})
            (j_x : AlgebraicGeometry.Spec R_x ⟶ U_reg_sch.toScheme)
            (φ_Rx : CommRingCat.of k ⟶ R_x),
            AlgebraicGeometry.IsOpenImmersion j_x ∧
            x ∈ Set.range j_x.base ∧
            RingHom.IsStandardSmoothOfRelativeDimension 1 φ_Rx.hom ∧
            j_x ≫ U_reg_sch.ι ≫ sub_ι ≫ p2_hom =
              AlgebraicGeometry.Spec.map φ_Rx := by
        intro x
        let c : C_sch := x.1
        let p : X_2 := sub_ι.base c
        have hp_img : p ∈ sub_ι.base '' (U_reg_sch : Set C_sch) := ⟨c, x.2, rfl⟩
        rw [hImg_reg_sch] at hp_img
        rcases hp_img with ⟨hP_in_p, _, hex_r0⟩
        have hp_top : p ∈ (⊤ : X_2.Opens) := trivial
        rw [← h_iSup_P2, TopologicalSpace.Opens.mem_iSup] at hp_top
        rcases hp_top with ⟨β, hp_Dβ⟩
        have hXβ : MvPolynomial.X β ∈ 𝒜_2 1 := MvPolynomial.isHomogeneous_X k β
        let p_spec : ProjectiveSpectrum 𝒜_2 := p
        have hXβ_not_p : MvPolynomial.X β ∉ p_spec.asHomogeneousIdeal :=
          (AlgebraicGeometry.Proj.mem_basicOpen 𝒜_2 (MvPolynomial.X β) p).mp hp_Dβ
        obtain ⟨r, hr_not_p⟩ :=
          hEuler_aff β p_spec.asHomogeneousIdeal.toIdeal p_spec.isPrime hP_in_p hXβ_not_p hex_r0
        let G_βr : MvPolynomial (Fin 3) k := MvPolynomial.X β * MvPolynomial.pderiv r.1 P_disc
        have hG_βr_hom : G_βr ∈ 𝒜_2 D_disc := by
          change G_βr.IsHomogeneous D_disc
          have hP' : P_disc.IsHomogeneous D_disc := hHomog
          have h1 := (MvPolynomial.isHomogeneous_X k β).mul (hP'.pderiv (i := r.1))
          have hdeg : 1 + (D_disc - 1) = D_disc := by omega
          rwa [hdeg] at h1
        have hG_βr_hom_d : G_βr ∈ 𝒜_2 (D_disc • 1) := by rwa [nsmul_one]
        have hp_G : p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_2 G_βr := by
          rw [AlgebraicGeometry.Proj.mem_basicOpen]
          intro hG_in
          rcases p_spec.isPrime.mem_or_mem hG_in with h1 | h2
          · exact hXβ_not_p h1
          · exact hr_not_p h2
        let hAff_Dβ : AlgebraicGeometry.IsAffineOpen (D_std β) :=
          AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one
        have hp_W : p ∈ D_std β ⊓ W_reg_amb := ⟨hp_Dβ, x.2⟩
        obtain ⟨h_sec, h_le_DW, hp_bh⟩ := hAff_Dβ.exists_basicOpen_le ⟨p, hp_W⟩ hp_Dβ
        let R_β := ↑(X_2.presheaf.obj (Opposite.op (D_std β)))
        let iso_away := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one
        let eq_away : HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β) ≃+* R_β :=
          { toFun := iso_away.hom.hom
            invFun := iso_away.inv.hom
            left_inv := fun z => by
              change (iso_away.hom ≫ iso_away.inv).hom z = z; rw [iso_away.hom_inv_id]; rfl
            right_inv := fun y => by
              change (iso_away.inv ≫ iso_away.hom).hom y = y; rw [iso_away.inv_hom_id]; rfl
            map_mul' := fun _ _ => map_mul _ _ _
            map_add' := fun _ _ => map_add _ _ _ }
        let φ_β : MvPolynomial {r : Fin 3 // r ≠ β} k ≃+* R_β := (e_chart β).trans eq_away
        let dehom_β : MvPolynomial (Fin 3) k →+* MvPolynomial {r : Fin 3 // r ≠ β} k :=
          MvPolynomial.eval₂Hom MvPolynomial.C
            (fun j : Fin 3 => if h : j = β then 1 else MvPolynomial.X ⟨j, h⟩)
        let h₀ : MvPolynomial {r : Fin 3 // r ≠ β} k := φ_β.symm h_sec
        let d_βr : MvPolynomial {r : Fin 3 // r ≠ β} k := dehom_β (MvPolynomial.pderiv r.1 P_disc)
        let s_r : R_β :=
          (AlgebraicGeometry.Proj.awayToSection 𝒜_2 (MvPolynomial.X β)).hom
            (HomogeneousLocalization.Away.mk 𝒜_2 hXβ D_disc G_βr hG_βr_hom_d)
        have hXβD : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ^ D_disc ∈ 𝒜_2 D_disc :=
          (MvPolynomial.mem_homogeneousSubmodule D_disc _).mpr (MvPolynomial.isHomogeneous_X_pow β D_disc)
        have hφ_sr : φ_β d_βr = s_r := by
          dsimp only [φ_β, eq_away, iso_away, s_r, d_βr, RingEquiv.trans_apply]
          change (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one).hom.hom _ = _
          rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
          congr 1
          have hsymm := he_chart_symm β D_disc G_βr hG_βr_hom ((MvPolynomial.X β) ^ D_disc) hXβD
            (pow_mem (Submonoid.mem_powers (MvPolynomial.X β)) D_disc)
          have hmk_eq : HomogeneousLocalization.mk ⟨D_disc, ⟨G_βr, hG_βr_hom⟩,
              ⟨(MvPolynomial.X β) ^ D_disc, hXβD⟩,
              pow_mem (Submonoid.mem_powers (MvPolynomial.X β)) D_disc⟩ =
              HomogeneousLocalization.Away.mk 𝒜_2 hXβ D_disc G_βr hG_βr_hom_d := by
            apply HomogeneousLocalization.val_injective
            rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.Away.val_mk]
          rw [hmk_eq] at hsymm
          have hdehom_G : dehom_β G_βr = dehom_β (MvPolynomial.pderiv r.1 P_disc) := by
            dsimp only [G_βr]
            rw [map_mul]
            have hX1 : dehom_β (MvPolynomial.X β) = 1 := by
              dsimp only [dehom_β]; rw [MvPolynomial.eval₂Hom_X', dif_pos rfl]
            rw [hX1, one_mul]
          rw [hdehom_G] at hsymm
          rw [← hsymm, RingEquiv.apply_symm_apply]
        have hp_bsr : p ∈ X_2.basicOpen s_r := by
          rw [hBasicOpen_away β hXβ D_disc hD G_βr hG_βr_hom hG_βr_hom_d]
          exact ⟨hp_Dβ, hp_G⟩
        let g_sec : R_β := h_sec * s_r
        let B_x : X_2.Opens := X_2.basicOpen g_sec
        have hBx_eq : B_x = X_2.basicOpen h_sec ⊓ X_2.basicOpen s_r :=
          X_2.basicOpen_mul h_sec s_r
        have hp_Bx : p ∈ B_x := by rw [hBx_eq]; exact ⟨hp_bh, hp_bsr⟩
        have hBx_le_Dβ : B_x ≤ D_std β := X_2.basicOpen_le g_sec
        have hBx_le_W : B_x ≤ W_reg_amb := by
          rw [hBx_eq]
          exact le_trans inf_le_left (le_trans h_le_DW inf_le_right)
        have hAff_Bx : AlgebraicGeometry.IsAffineOpen B_x := hAff_Dβ.basicOpen g_sec
        let W_c : C_sch.Opens := (TopologicalSpace.Opens.map sub_ι.base).obj B_x
        have hWc_le_reg : W_c ≤ U_reg_sch :=
          (TopologicalSpace.Opens.map sub_ι.base).monotone hBx_le_W
        have hAff_Wc : AlgebraicGeometry.IsAffineOpen W_c := hAff_Bx.preimage sub_ι
        have hc_Wc : c ∈ W_c := hp_Bx

        let P_τ := MvPolynomial {r : Fin 3 // r ≠ β} k
        let g₀ : P_τ := h₀ * d_βr
        have hφ_g0 : φ_β g₀ = g_sec := by
          dsimp [g₀, g_sec, h₀]
          rw [map_mul, RingEquiv.apply_symm_apply, hφ_sr]
        let L₀ := Localization.Away g₀
        let R_Bx := ↑(X_2.presheaf.obj (Opposite.op B_x))
        let res_βBx : R_β →+* R_Bx :=
          (X_2.presheaf.map (CategoryTheory.homOfLE hBx_le_Dβ).op).hom
        let _ : Algebra R_β R_Bx := res_βBx.toAlgebra
        have : IsLocalization.Away g_sec R_Bx := hAff_Dβ.isLocalization_basicOpen g_sec
        have h_units_L0 : ∀ y : Submonoid.powers g_sec,
            IsUnit ((algebraMap P_τ L₀).comp φ_β.symm.toRingHom y.1) := by
          rintro ⟨_, n, rfl⟩
          simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
            map_pow, ← hφ_g0, RingEquiv.symm_apply_apply]
          exact IsUnit.pow n (IsLocalization.Away.algebraMap_isUnit g₀)
        let to_L0 : R_Bx →+* L₀ := IsLocalization.lift h_units_L0
        have h_units_RBx : ∀ y : Submonoid.powers g₀,
            IsUnit (res_βBx.comp φ_β.toRingHom y.1) := by
          rintro ⟨_, n, rfl⟩
          simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
            map_pow, hφ_g0]
          exact IsUnit.pow n (IsLocalization.Away.algebraMap_isUnit (S := R_Bx) g_sec)
        let from_L0 : L₀ →+* R_Bx := IsLocalization.lift h_units_RBx
        have h_to_from : to_L0.comp from_L0 = RingHom.id L₀ := by
          apply IsLocalization.ringHom_ext (Submonoid.powers g₀)
          apply RingHom.ext
          intro q
          simp only [RingHom.comp_apply, RingHom.id_apply, from_L0, to_L0]
          change to_L0 (from_L0 (algebraMap P_τ L₀ q)) = algebraMap P_τ L₀ q
          rw [IsLocalization.lift_eq]
          change to_L0 (algebraMap R_β R_Bx (φ_β q)) = algebraMap P_τ L₀ q
          rw [IsLocalization.lift_eq]
          simp
        have h_from_to : from_L0.comp to_L0 = RingHom.id R_Bx := by
          apply IsLocalization.ringHom_ext (Submonoid.powers g_sec)
          apply RingHom.ext
          intro r_b
          simp only [RingHom.comp_apply, RingHom.id_apply, from_L0, to_L0]
          change from_L0 (to_L0 (algebraMap R_β R_Bx r_b)) = algebraMap R_β R_Bx r_b
          rw [IsLocalization.lift_eq]
          change from_L0 (algebraMap P_τ L₀ (φ_β.symm r_b)) = res_βBx r_b
          rw [IsLocalization.lift_eq]
          simp
        let eq_loc : R_Bx ≃+* L₀ :=
          { toFun := to_L0
            invFun := from_L0
            left_inv := fun z => DFunLike.congr_fun h_from_to z
            right_inv := fun y => DFunLike.congr_fun h_to_from y
            map_mul' := map_mul to_L0
            map_add' := map_add to_L0 }

        let f_β : R_β :=
          (AlgebraicGeometry.Proj.awayToSection 𝒜_2 (MvPolynomial.X β)).hom
            (HomogeneousLocalization.Away.mk 𝒜_2 hXβ D_disc P_disc hFP)
        have hφ_p : φ_β (dehom_β P_disc) = f_β := by
          dsimp only [φ_β, eq_away, iso_away, f_β, RingEquiv.trans_apply]
          change (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one).hom.hom _ = _
          rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
          congr 1
          have hsymm := he_chart_symm β D_disc P_disc hHomog ((MvPolynomial.X β) ^ D_disc) hXβD
            (pow_mem (Submonoid.mem_powers (MvPolynomial.X β)) D_disc)
          have hmk_eq : HomogeneousLocalization.mk ⟨D_disc, ⟨P_disc, hHomog⟩,
              ⟨(MvPolynomial.X β) ^ D_disc, hXβD⟩,
              pow_mem (Submonoid.mem_powers (MvPolynomial.X β)) D_disc⟩ =
              HomogeneousLocalization.Away.mk 𝒜_2 hXβ D_disc P_disc hFP := by
            apply HomogeneousLocalization.val_injective
            rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.Away.val_mk]
          rw [hmk_eq] at hsymm
          rw [← hsymm, RingEquiv.apply_symm_apply]
        let f_Bx : R_Bx := res_βBx f_β
        have hBx_le_id : B_x ≤ (𝟙 X_2) ⁻¹ᵁ D_std β := hBx_le_Dβ
        have h_ker_Bx : RingHom.ker (sub_ι.app B_x).hom = Ideal.span {f_Bx} := by
          have hker := hHyp_disc.2.2.2 β hXβ B_x hAff_Bx hBx_le_Dβ
          change RingHom.ker (sub_ι.app B_x).hom =
            Ideal.span {(AlgebraicGeometry.Scheme.Hom.appLE (𝟙 X_2) (D_std β) B_x hBx_le_id).hom f_β} at hker
          rw [hid_appLE hBx_le_id] at hker
          exact hker
        have heq_loc_f : eq_loc f_Bx = algebraMap P_τ L₀ (dehom_β P_disc) := by
          change to_L0 (algebraMap R_β R_Bx f_β) = _
          rw [IsLocalization.lift_eq]
          simp [← hφ_p]
        let J₀ : Ideal L₀ := Ideal.span {algebraMap P_τ L₀ (dehom_β P_disc)}
        let S_x := L₀ ⧸ J₀
        let R_Wc_cat : CommRingCat.{u} := C_sch.presheaf.obj (Opposite.op W_c)
        have hsurj_Bx : Function.Surjective (sub_ι.app B_x).hom :=
          AlgebraicGeometry.Scheme.Hom.app_surjective sub_ι B_x hAff_Bx
        let eq_quot1 : R_Bx ⧸ RingHom.ker (sub_ι.app B_x).hom ≃+* ↑R_Wc_cat :=
          RingHom.quotientKerEquivOfSurjective hsurj_Bx
        have hJ_map : Ideal.map eq_loc (RingHom.ker (sub_ι.app B_x).hom) = J₀ := by
          rw [h_ker_Bx, Ideal.map_span, Set.image_singleton, heq_loc_f]
        let eq_quot2 : R_Bx ⧸ RingHom.ker (sub_ι.app B_x).hom ≃+* S_x :=
          Ideal.quotientEquiv (RingHom.ker (sub_ι.app B_x).hom) J₀ eq_loc hJ_map.symm
        let eq_Wc_Sx : ↑R_Wc_cat ≃+* S_x := eq_quot1.symm.trans eq_quot2
        have h_eq_mk : ∀ u : R_Bx,
            eq_Wc_Sx ((sub_ι.app B_x).hom u) = Ideal.Quotient.mk J₀ (eq_loc u) := by
          intro u
          dsimp only [eq_Wc_Sx, eq_quot1, eq_quot2, RingEquiv.trans_apply]
          have hsymm_u : (RingHom.quotientKerEquivOfSurjective hsurj_Bx).symm
              ((sub_ι.app B_x).hom u) = Ideal.Quotient.mk _ u := by
            apply (RingHom.quotientKerEquivOfSurjective hsurj_Bx).injective
            rw [RingEquiv.apply_symm_apply]
            rfl
          rw [hsymm_u]
          rfl

        let hom_Wc_Sx : R_Wc_cat ⟶ CommRingCat.of S_x :=
          CommRingCat.ofHom eq_Wc_Sx.toRingHom
        let inv_Wc_Sx : CommRingCat.of S_x ⟶ R_Wc_cat :=
          CommRingCat.ofHom eq_Wc_Sx.symm.toRingHom
        let iso_Spec_Sx : AlgebraicGeometry.Spec (CommRingCat.of S_x) ≅
            AlgebraicGeometry.Spec R_Wc_cat :=
          { hom := AlgebraicGeometry.Spec.map hom_Wc_Sx
            inv := AlgebraicGeometry.Spec.map inv_Wc_Sx
            hom_inv_id := by
              rw [← AlgebraicGeometry.Spec.map_comp]
              have h1 : inv_Wc_Sx ≫ hom_Wc_Sx = 𝟙 (CommRingCat.of S_x) := by
                apply CommRingCat.hom_ext
                exact eq_Wc_Sx.toRingHom_comp_symm_toRingHom
              rw [h1, AlgebraicGeometry.Spec.map_id]
            inv_hom_id := by
              rw [← AlgebraicGeometry.Spec.map_comp]
              have h1 : hom_Wc_Sx ≫ inv_Wc_Sx = 𝟙 R_Wc_cat := by
                apply CommRingCat.hom_ext
                exact eq_Wc_Sx.symm_toRingHom_comp_toRingHom
              rw [h1, AlgebraicGeometry.Spec.map_id] }
        let g_x : AlgebraicGeometry.Spec (CommRingCat.of S_x) ⟶ C_sch :=
          iso_Spec_Sx.hom ≫ hAff_Wc.fromSpec
        have : CategoryTheory.IsIso iso_Spec_Sx.hom := iso_Spec_Sx.isIso_hom
        have : AlgebraicGeometry.IsOpenImmersion g_x :=
          AlgebraicGeometry.IsOpenImmersion.comp iso_Spec_Sx.hom hAff_Wc.fromSpec
        have h_range_gx : Set.range g_x.base ⊆ Set.range U_reg_sch.ι.base := by
          rintro _ ⟨v, rfl⟩
          rw [U_reg_sch.range_ι]
          apply hWc_le_reg
          change g_x.base v ∈ (W_c : Set ↥C_sch)
          rw [← W_c.range_ι]
          refine ⟨hAff_Wc.isoSpec.inv.base (iso_Spec_Sx.hom.base v), ?_⟩
          dsimp only [g_x]
          rw [← hAff_Wc.isoSpec_inv_ι]
          rfl
        let j_x : AlgebraicGeometry.Spec (CommRingCat.of S_x) ⟶ U_reg_sch.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift U_reg_sch.ι g_x h_range_gx
        have hj_fac : j_x ≫ U_reg_sch.ι = g_x :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac U_reg_sch.ι g_x h_range_gx
        have hx_in_jx : x ∈ Set.range j_x.base := by
          let v_c := iso_Spec_Sx.inv.base (hAff_Wc.isoSpec.hom.base ⟨c, hc_Wc⟩)
          refine ⟨v_c, ?_⟩
          apply U_reg_sch.ι.isOpenEmbedding.injective
          change (j_x ≫ U_reg_sch.ι).base v_c = c
          rw [hj_fac]
          dsimp [g_x, v_c]
          rw [← hAff_Wc.isoSpec_inv_ι]
          change (iso_Spec_Sx.inv ≫ iso_Spec_Sx.hom ≫ hAff_Wc.isoSpec.inv ≫ W_c.ι).base
            (hAff_Wc.isoSpec.hom.base ⟨c, hc_Wc⟩) = c
          rw [iso_Spec_Sx.inv_hom_id_assoc]
          change (hAff_Wc.isoSpec.hom ≫ hAff_Wc.isoSpec.inv ≫ W_c.ι).base ⟨c, hc_Wc⟩ = c
          rw [CategoryTheory.Iso.hom_inv_id_assoc]
          rfl

        let φ_Sx : k →+* S_x :=
          (((Ideal.Quotient.mk J₀).comp (algebraMap P_τ L₀)).comp MvPolynomial.C)
        have hSm_Sx : RingHom.IsStandardSmoothOfRelativeDimension 1 φ_Sx := hSm_alg β r h₀

        have h_gx_hom : g_x ≫ sub_ι ≫ p2_hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Sx) := by
          dsimp only [g_x]
          have h_fromSpec_sub : hAff_Wc.fromSpec ≫ sub_ι =
              AlgebraicGeometry.Spec.map (sub_ι.app B_x) ≫ hAff_Bx.fromSpec := by
            apply (CategoryTheory.cancel_epi hAff_Wc.isoSpec.hom).mp
            rw [← CategoryTheory.Category.assoc, hAff_Wc.isoSpec_hom,
              ← hAff_Wc.isoSpec_inv_ι, hAff_Wc.toSpecΓ_isoSpec_inv_assoc,
              AlgebraicGeometry.Scheme.Hom.app_eq_appLE sub_ι,
              AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE_assoc,
              ← hAff_Bx.isoSpec_inv_ι, hAff_Bx.toSpecΓ_isoSpec_inv_assoc,
              AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
          let c_to_Rβ : CommRingCat.of k ⟶ X_2.presheaf.obj (Opposite.op (D_std β)) :=
            CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom 𝒜_2
              (Submonoid.powers (MvPolynomial.X β))).comp (algebraMap k ↥(𝒜_2 0))) ≫
              AlgebraicGeometry.Proj.awayToSection 𝒜_2 (MvPolynomial.X β)
          let res_mor : X_2.presheaf.obj (Opposite.op (D_std β)) ⟶
              X_2.presheaf.obj (Opposite.op B_x) :=
            X_2.presheaf.map (CategoryTheory.homOfLE hBx_le_Dβ).op
          have hc_to_Rβ_apply : ∀ c_k : k, c_to_Rβ.hom c_k = φ_β (MvPolynomial.C c_k) := by
            intro c_k
            dsimp only [c_to_Rβ, φ_β, eq_away, iso_away, RingEquiv.trans_apply]
            simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
            change _ = (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one).hom.hom _
            rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom, he_chart_C β c_k]
          have h_fromSpec_Bx : hAff_Bx.fromSpec ≫ p2_hom =
              AlgebraicGeometry.Spec.map (c_to_Rβ ≫ res_mor) := by
            apply (CategoryTheory.cancel_epi hAff_Bx.isoSpec.hom).mp
            rw [← CategoryTheory.Category.assoc, hAff_Bx.isoSpec_hom,
              ← hAff_Bx.isoSpec_inv_ι, hAff_Bx.toSpecΓ_isoSpec_inv_assoc]
            have h_res_Dβ : B_x.toSpecΓ ≫ AlgebraicGeometry.Spec.map res_mor =
                AlgebraicGeometry.Scheme.Hom.resLE (𝟙 X_2) (D_std β) B_x hBx_le_id ≫
                  (D_std β).toSpecΓ := by
              have h1 := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE
                (𝟙 X_2) (D_std β) B_x hBx_le_id
              rw [hid_appLE hBx_le_id] at h1
              exact h1
            have h_Dβ_hom : (D_std β).toSpecΓ ≫ AlgebraicGeometry.Spec.map c_to_Rβ =
                (D_std β).ι ≫ p2_hom := by
              dsimp only [c_to_Rβ]
              rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc]
              change (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_2 (MvPolynomial.X β)) ≫ _ = _
              rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one]
              have hc2 : CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom 𝒜_2
                  (Submonoid.powers (MvPolynomial.X β))).comp (algebraMap k ↥(𝒜_2 0))) =
                  CommRingCat.ofHom (algebraMap k ↥(𝒜_2 0)) ≫
                    CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜_2 _) := rfl
              change _ = (D_std β).ι ≫
                (AlgebraicGeometry.Proj.toSpecZero 𝒜_2 ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_2 0))))
              rw [hc2, AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
                ← AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one,
                ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one]
              simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
              rfl
            rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
              h_res_Dβ, CategoryTheory.Category.assoc, h_Dβ_hom,
              AlgebraicGeometry.Scheme.Hom.resLE_comp_ι_assoc, CategoryTheory.Category.id_comp]
          calc (iso_Spec_Sx.hom ≫ hAff_Wc.fromSpec) ≫ sub_ι ≫ p2_hom
              = AlgebraicGeometry.Spec.map hom_Wc_Sx ≫ (hAff_Wc.fromSpec ≫ sub_ι) ≫ p2_hom := by
                dsimp only [iso_Spec_Sx]
                simp only [CategoryTheory.Category.assoc]
            _ = AlgebraicGeometry.Spec.map hom_Wc_Sx ≫
                  AlgebraicGeometry.Spec.map (sub_ι.app B_x) ≫
                  AlgebraicGeometry.Spec.map (c_to_Rβ ≫ res_mor) := by
                rw [h_fromSpec_sub, CategoryTheory.Category.assoc, h_fromSpec_Bx]
            _ = AlgebraicGeometry.Spec.map
                  ((c_to_Rβ ≫ res_mor) ≫ sub_ι.app B_x ≫ hom_Wc_Sx) := by
                rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
                simp only [CategoryTheory.Category.assoc]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Sx) := by
                congr 1
                apply CommRingCat.hom_ext
                apply RingHom.ext
                intro c_k
                change eq_Wc_Sx ((sub_ι.app B_x).hom (res_βBx (c_to_Rβ.hom c_k))) = φ_Sx c_k
                rw [hc_to_Rβ_apply c_k, h_eq_mk]
                dsimp only [φ_Sx, RingHom.comp_apply]
                congr 1
                change to_L0 (algebraMap R_β R_Bx (φ_β (MvPolynomial.C c_k))) = _
                rw [IsLocalization.lift_eq]
                simp
        refine ⟨CommRingCat.of S_x, j_x, CommRingCat.ofHom φ_Sx, inferInstance, hx_in_jx, hSm_Sx, ?_⟩
        rw [← CategoryTheory.Category.assoc, hj_fac, h_gx_hom]

      let 𝒰_sm : U_reg_sch.toScheme.OpenCover :=
        AlgebraicGeometry.Scheme.Cover.mkOfCovers ↥U_reg_sch
          (fun x => AlgebraicGeometry.Spec (Classical.choose (hLocalChart x)))
          (fun x => Classical.choose (Classical.choose_spec (hLocalChart x)))
          (fun x => by
            let h2 := Classical.choose_spec (Classical.choose_spec (hLocalChart x))
            obtain ⟨y, hy⟩ := (Classical.choose_spec h2).2.1
            exact ⟨x, y, hy⟩)
          (fun x => by
            let h2 := Classical.choose_spec (Classical.choose_spec (hLocalChart x))
            exact (Classical.choose_spec h2).1)
      have : AlgebraicGeometry.IsZariskiLocalAtSource
          (@AlgebraicGeometry.SmoothOfRelativeDimension.{u} 1) :=
        AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
          (P := @AlgebraicGeometry.SmoothOfRelativeDimension.{u} 1)
      change AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_reg_sch.ι ≫ sub_ι ≫ p2_hom)
      refine (AlgebraicGeometry.IsZariskiLocalAtSource.iff_of_openCover
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension.{u} 1) 𝒰_sm).mpr ?_
      intro x
      let j_x := Classical.choose (Classical.choose_spec (hLocalChart x))
      let h2 := Classical.choose_spec (Classical.choose_spec (hLocalChart x))
      let φ_Rx := Classical.choose h2
      obtain ⟨_, _, hSm_Rx, hEq_Rx⟩ := Classical.choose_spec h2
      change AlgebraicGeometry.SmoothOfRelativeDimension 1 (j_x ≫ U_reg_sch.ι ≫ sub_ι ≫ p2_hom)
