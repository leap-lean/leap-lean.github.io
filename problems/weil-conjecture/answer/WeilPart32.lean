  have hPoly_trans : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (φ_A : k →+* A) (φ_B : k →+* B) (f : A →+* B),
      Function.Surjective f →
      (∀ c : k, f (φ_A c) = φ_B c) →
      ∀ (I : Ideal A), RingHom.ker f = I →
      ∀ (a : A) (b : B), f a = b →
      (letI : Algebra k B := φ_B.toAlgebra
       letI : Algebra (Polynomial k) B := (Polynomial.aeval b).toRingHom.toAlgebra
       Module.Finite (Polynomial k) B →
       letI : Algebra k A := φ_A.toAlgebra
       letI : Algebra (Polynomial k) (A ⧸ I) :=
         (Polynomial.aeval (Ideal.Quotient.mk I a)).toRingHom.toAlgebra
       Module.Finite (Polynomial k) (A ⧸ I)) ∧
      (letI : Algebra k B := φ_B.toAlgebra
       letI : Algebra (Polynomial k) B := (Polynomial.aeval b).toRingHom.toAlgebra
       Module.IsTorsionFree (Polynomial k) B →
       letI : Algebra k A := φ_A.toAlgebra
       letI : Algebra (Polynomial k) (A ⧸ I) :=
         (Polynomial.aeval (Ideal.Quotient.mk I a)).toRingHom.toAlgebra
       Module.IsTorsionFree (Polynomial k) (A ⧸ I)) := by
    intro A B _ _ φ_A φ_B f hf hk I hI a b hab
    let _ : Algebra k A := φ_A.toAlgebra
    let _ : Algebra k B := φ_B.toAlgebra
    let _ : Algebra (Polynomial k) (A ⧸ I) :=
      (Polynomial.aeval (Ideal.Quotient.mk I a)).toRingHom.toAlgebra
    let _ : Algebra (Polynomial k) B := (Polynomial.aeval b).toRingHom.toAlgebra
    let e_ring : (A ⧸ I) ≃+* B :=
      (Ideal.quotEquivOfEq hI.symm).trans (RingHom.quotientKerEquivOfSurjective hf)
    have he_mk : ∀ x : A, e_ring (Ideal.Quotient.mk I x) = f x := fun _ => rfl
    have he_poly : ∀ P : Polynomial k,
        e_ring (algebraMap (Polynomial k) (A ⧸ I) P) = algebraMap (Polynomial k) B P := by
      intro P
      change e_ring (Polynomial.aeval (Ideal.Quotient.mk I a) P) = Polynomial.aeval b P
      induction P using Polynomial.induction_on' with
      | add p q hp hq => simp only [map_add, hp, hq]
      | monomial n c =>
        simp only [Polynomial.aeval_monomial, map_mul, map_pow, he_mk, hab]
        congr 1
        exact hk c
    let e_lin : (A ⧸ I) ≃ₗ[Polynomial k] B :=
      { e_ring.toAddEquiv with
        map_smul' := fun P x => by
          change e_ring (algebraMap (Polynomial k) (A ⧸ I) P * x) =
            algebraMap (Polynomial k) B P * e_ring x
          rw [map_mul, he_poly] }
    refine ⟨fun hFin => Module.Finite.equiv e_lin.symm, fun hTF => ?_⟩
    refine Module.IsTorsionFree.of_smul_eq_zero fun P x hx => ?_
    have hx' : P • e_lin x = 0 := by rw [← map_smul, hx, map_zero]
    rcases smul_eq_zero.mp hx' with hP | hex
    · exact Or.inl hP
    · exact Or.inr (e_lin.injective (hex.trans (map_zero e_lin).symm))

  
  have hApp_compat : ∀ {Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
      (ι : Y ⟶ Z_bar) (D : P_N.left.Opens)
      (hU_sub : (TopologicalSpace.Opens.map ι₀.left.base).obj D ≤
        (TopologicalSpace.Opens.map ι₀.left.base).obj D)
      (h_top : (TopologicalSpace.Opens.map ι₀.left.base).obj D ≤
        (TopologicalSpace.Opens.map Z_bar.hom.base).obj ⊤),
      let U : Z_bar.left.Opens := (TopologicalSpace.Opens.map ι₀.left.base).obj D
      let W : Y.left.Opens := (TopologicalSpace.Opens.map (ι ≫ ι₀).left.base).obj D
      (∀ c : k,
        (ι.left.app U).hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            Z_bar.hom.appLE ⊤ U h_top).hom c) =
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            Y.hom.appLE ⊤ W le_top).hom c)) ∧
      (∀ s : ↑(P_N.left.presheaf.obj (Opposite.op D)),
        (ι.left.app U).hom ((ι₀.left.appLE D U hU_sub).hom s) =
          (((ι ≫ ι₀).left.appLE D W le_rfl).hom s)) := by
    intro Y ι D hU_sub h_top U W
    refine ⟨?_, ?_⟩
    · intro c
      have hw : ι.left ≫ Z_bar.hom = Y.hom := ι.w
      have happ : Z_bar.hom.appLE ⊤ U h_top ≫ ι.left.appLE U W le_rfl =
          Y.hom.appLE ⊤ W le_top := by
        simpa [hw] using AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
          ι.left Z_bar.hom ⊤ U W h_top le_rfl
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      have hcomp : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Z_bar.hom.appLE ⊤ U h_top) ≫ ι.left.appLE U W le_rfl =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            Y.hom.appLE ⊤ W le_top := by
        rw [CategoryTheory.Category.assoc, happ]
      exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hcomp) c
    · intro s
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      have happ := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
        ι.left ι₀.left D U W hU_sub le_rfl
      exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom happ) s

  
