        (φ_M ((P_M.left.presheaf.map (CategoryTheory.homOfLE _).op).hom (s_M α' r)) *
          φ_2 ((P_2.left.presheaf.map (CategoryTheory.homOfLE _).op).hom (w_tilde β' r)))
    rw [h_eqM_r, h_eq2_r, map_mul φ_M, map_mul φ_2]
    ring

  obtain ⟨Y_sch, ι_Y₂, hCl_Y₂, hKer_Q, hChart_Q⟩ :=
    hPart3 Q₂ Idx C_Q hCov_Q Φ hUnit_Q

  let Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (ι_Y₂ ≫ p₁ ≫ Z_bar.hom)
  let π_Y : Y₂ ⟶ Z_bar :=
    CategoryTheory.Over.homMk (ι_Y₂ ≫ p₁) (CategoryTheory.Category.assoc _ _ _)
  let g₂ : Y₂ ⟶ P_2 :=
    CategoryTheory.Over.homMk (ι_Y₂ ≫ p₂) (by
      change (ι_Y₂ ≫ p₂) ≫ P_2.hom = ι_Y₂ ≫ p₁ ≫ Z_bar.hom
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition])

  have hResSubChart : ∀ (α : Fin (M + 1))
      (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
      (β : Fin 3)
      (hWβ : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1)
      (hL' : ∀ r : Fin 3, L r ∈ 𝒜_M 1)
      (U_Z : Z_bar.left.Opens) (hUZ : U_Z ≤ C_Z α)
      (U_P : P_2.left.Opens) (hUP : U_P ≤ D_P β)
      (W_pb : Q₂.Opens)
      (hWZ : W_pb ≤ (TopologicalSpace.Opens.map p₁.base).obj U_Z)
      (hWP : W_pb ≤ (TopologicalSpace.Opens.map p₂.base).obj U_P)
      (hW_CQ : W_pb ≤ C_Q (α, β)),
      (Q₂.presheaf.map (CategoryTheory.homOfLE hW_CQ).op).hom (Φ (α, β)) =
        ∑ r : Fin 3,
          (p₁.appLE U_Z W_pb hWZ).hom
            (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
              ι_bar.left.appLE (D_M α) U_Z hUZ).hom
              (HomogeneousLocalization.mk ⟨1, ⟨L r, hL' r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)) *
          (p₂.appLE U_P W_pb hWP).hom
            (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β) hWβ zero_lt_one).hom ≫
              P_2.left.presheaf.map (CategoryTheory.homOfLE hUP).op).hom
              (HomogeneousLocalization.mk
                ⟨1, ⟨MvPolynomial.X r, MvPolynomial.isHomogeneous_X k r⟩,
                  ⟨MvPolynomial.X β, hWβ⟩, ⟨1, pow_one _⟩⟩)) := by
    intro α hXα β hWβ hL' U_Z hUZ U_P hUP W_pb hWZ hWP hW_CQ
    dsimp [Φ]
    rw [map_sum]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [map_mul]
    congr 1
    · have hp₁_1 : p₁.appLE (C_Z α) (C_Q (α, β)) inf_le_left ≫
          Q₂.presheaf.map (CategoryTheory.homOfLE hW_CQ).op =
          p₁.appLE (C_Z α) W_pb (hW_CQ.trans inf_le_left) :=
        AlgebraicGeometry.Scheme.Hom.appLE_map p₁ inf_le_left (CategoryTheory.homOfLE hW_CQ).op
      have hp₁_2 : Z_bar.left.presheaf.map (CategoryTheory.homOfLE hUZ).op ≫
          p₁.appLE U_Z W_pb hWZ =
          p₁.appLE (C_Z α) W_pb (hW_CQ.trans inf_le_left) :=
        AlgebraicGeometry.Scheme.Hom.map_appLE p₁ hWZ (CategoryTheory.homOfLE hUZ).op
      have hι_app : ι_bar.left.app (D_M α) ≫ Z_bar.left.presheaf.map (CategoryTheory.homOfLE hUZ).op =
          ι_bar.left.appLE (D_M α) U_Z hUZ := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE ι_bar.left (U := D_M α),
          AlgebraicGeometry.Scheme.Hom.appLE_map]
      have h_tot : (ι_bar.left.app (D_M α) ≫ p₁.appLE (C_Z α) (C_Q (α, β)) inf_le_left) ≫
          Q₂.presheaf.map (CategoryTheory.homOfLE hW_CQ).op =
          ι_bar.left.appLE (D_M α) U_Z hUZ ≫ p₁.appLE U_Z W_pb hWZ := by
        rw [CategoryTheory.Category.assoc, hp₁_1, ← hp₁_2, ← CategoryTheory.Category.assoc, hι_app]
      have h_eval := congrArg (fun f : P_M.left.presheaf.obj (Opposite.op (D_M α)) ⟶
        Q₂.presheaf.obj (Opposite.op W_pb) => f.hom (s_M α r)) h_tot
      exact h_eval
    · have hp₂_1 : p₂.appLE (D_P β) (C_Q (α, β)) inf_le_right ≫
          Q₂.presheaf.map (CategoryTheory.homOfLE hW_CQ).op =
          p₂.appLE (D_P β) W_pb (hW_CQ.trans inf_le_right) :=
        AlgebraicGeometry.Scheme.Hom.appLE_map p₂ inf_le_right (CategoryTheory.homOfLE hW_CQ).op
      have hp₂_2 : P_2.left.presheaf.map (CategoryTheory.homOfLE hUP).op ≫
          p₂.appLE U_P W_pb hWP =
          p₂.appLE (D_P β) W_pb (hW_CQ.trans inf_le_right) :=
        AlgebraicGeometry.Scheme.Hom.map_appLE p₂ hWP (CategoryTheory.homOfLE hUP).op
      have h_tot : p₂.appLE (D_P β) (C_Q (α, β)) inf_le_right ≫
          Q₂.presheaf.map (CategoryTheory.homOfLE hW_CQ).op =
          P_2.left.presheaf.map (CategoryTheory.homOfLE hUP).op ≫ p₂.appLE U_P W_pb hWP :=
        hp₂_1.trans hp₂_2.symm
      exact congrArg (fun f : P_2.left.presheaf.obj (Opposite.op (D_P β)) ⟶
        Q₂.presheaf.obj (Opposite.op W_pb) => f.hom (w_tilde β r)) h_tot

  have hIncFam : IsLinearNetIncidenceFamily k M Z_bar ι_bar L Y₂ π_Y g₂ := by
    have hcomm : π_Y.left ≫ Z_bar.hom = g₂.left ≫ P_2.hom := by
