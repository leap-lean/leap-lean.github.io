      have hSm_quot : RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 3) ψ_sm :=
        hSchur.1 (2 * m + 2) A κ_Z hSm_κZ (ℓ_r β) (ℓ_r (β.succAbove 0)) (ℓ_r (β.succAbove 1))
