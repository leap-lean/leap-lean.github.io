            exact Submodule.neg_mem _ hsum_mem
          exact (hAffVY0.primeIdealOf y_V0).2.ne_top
            (Ideal.eq_top_of_isUnit_mem _ hUnit_mem hUnit_eY)
      obtain ⟨β, hβ_ne, hy_β⟩ := hExists_β
      obtain ⟨i₀, hi₀⟩ := Fin.exists_succAbove_eq hβ_ne.symm
      have hUnit_or : IsUnit (ℓ_r (β.succAbove 0)) ∨ IsUnit (ℓ_r (β.succAbove 1)) := by
        fin_cases i₀
        · dsimp at hi₀; left; rwa [hi₀]
        · dsimp at hi₀; right; rwa [hi₀]
      obtain ⟨_, _, hChart_β⟩ := hCharts β
      obtain ⟨hAffVY, e_Y, _, _, _, _, hY_hom, _⟩ := hChart_β α hXα U_Z hAffUZ hUZ_α
      let V_Y : Y₂.left.Opens :=
        (TopologicalSpace.Opens.map π_Y.left.base).obj U_Z ⊓
