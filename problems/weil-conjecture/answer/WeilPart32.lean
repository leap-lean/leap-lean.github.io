    (hK_tf W₂ hAff_W₂ u₁₂).2 fun l _ => by
      obtain ⟨⟨y, hy₂, _, hy_K, hy_u₁₂, _⟩, ⟨z₁, hz₁, hz₁_K, hz₁_not⟩, _⟩ := hComp_pts l
      exact ⟨⟨y, hy₂, hy_K, hy_u₁₂⟩, ⟨z₁, hz₁, hz₁_K, hz₁_not⟩⟩

  have hTF_BΓinf :
      letI : Algebra k ↑B_Γ_inf := φ_Γ_inf.toAlgebra
      letI : Algebra (Polynomial k) ↑B_Γ_inf := (Polynomial.aeval S_Γ).toRingHom.toAlgebra
      Module.IsTorsionFree (Polynomial k) ↑B_Γ_inf :=
