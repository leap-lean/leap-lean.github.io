        rw [Ideal.map_pow] at hmem_map
        have hmem_r2 : Φ_μ (P_u * P_v - P_x) ∈ r.asIdeal ^ 2 :=
          pow_le_pow_left' hmap_le 2 hmem_map
        rwa [map_sub, map_mul, hΦΨ_apply u, hΦΨ_apply x, ← hm_R_eq] at hmem_r2
      let loc := algebraMap R_μ (Localization.AtPrime r.asIdeal)
      let 𝔪_r := IsLocalRing.maximalIdeal (Localization.AtPrime r.asIdeal)
      have hloc_r2 : loc (u * m_R - x) ∈ 𝔪_r ^ 2 := by
        have h1 : loc (u * m_R - x) ∈ Ideal.map loc (r.asIdeal ^ 2) :=
          Ideal.mem_map_of_mem loc hum_mod
        rw [Ideal.map_pow, IsLocalization.AtPrime.map_eq_maximalIdeal r.asIdeal] at h1
        exact h1
      have hu_unit : IsUnit (loc u) :=
        IsLocalization.map_units (Localization.AtPrime r.asIdeal) ⟨u, hu⟩
      have hprod_eq : loc u * (loc m_R - IsLocalization.mk' (Localization.AtPrime r.asIdeal) x ⟨u, hu⟩) =
          loc (u * m_R - x) := by
        rw [mul_sub, ← map_mul, mul_comm (loc u), IsLocalization.mk'_spec, map_sub]
      refine ⟨M, hM, ?_⟩
      have heq : loc m_R - IsLocalization.mk' (Localization.AtPrime r.asIdeal) x ⟨u, hu⟩ =
          ↑(hu_unit.unit⁻¹) *
            (loc u * (loc m_R - IsLocalization.mk' (Localization.AtPrime r.asIdeal) x ⟨u, hu⟩)) := by
        rw [← mul_assoc, IsUnit.val_inv_mul, one_mul]
      rw [heq, hprod_eq]
      exact (𝔪_r ^ 2).mul_mem_left _ hloc_r2

  
  have hs3_sep : ∀ (a b : Fin (N + 1) → k),
      a μ₁ = 1 → b μ₂ = 1 →
      (∃ (d : ℕ), 1 ≤ d ∧ ∃ G ∈ 𝒜_N d, ¬ (MvPolynomial.eval a G = 0 ↔ MvPolynomial.eval b G = 0)) →
      ∃ (H₁ H₂ : MvPolynomial (Fin (N + 1)) k),
        H₁ ∈ 𝒜_N 1 ∧ H₂ ∈ 𝒜_N 1 ∧
        MvPolynomial.eval a H₁ = 0 ∧ MvPolynomial.eval b H₁ ≠ 0 ∧
        MvPolynomial.eval b H₂ = 0 ∧ MvPolynomial.eval a H₂ ≠ 0 := by
    intro a b ha₁ hb₂ hDiff
    have hMinor : ∃ ν ν' : Fin (N + 1), a ν * b ν' ≠ a ν' * b ν := by
      by_contra hProp
      push_neg at hProp
      let c : k := a μ₂
      have ha_eq : ∀ j : Fin (N + 1), a j = c * b j := by
        intro j
        have h := hProp j μ₂
        rw [hb₂, mul_one] at h
        exact h
      have hc_ne : c ≠ 0 := by
        intro hc0
        have h1 := ha_eq μ₁
        rw [ha₁, hc0, zero_mul] at h1
        exact one_ne_zero h1
      rcases hDiff with ⟨d, _, G, hG, hNotIff⟩
      have hG_hom : G.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule d G).mp hG
      have heval_scale : MvPolynomial.eval a G = c ^ d * MvPolynomial.eval b G := by
        conv_lhs => rw [G.as_sum]
        conv_rhs => rw [G.as_sum]
        rw [map_sum, map_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun m hm => ?_
        have hdeg : (∑ j ∈ m.support, m j) = d :=
          (hWeight_eq m).symm.trans (hG_hom (MvPolynomial.mem_support_iff.mp hm))
        rw [MvPolynomial.eval_monomial, MvPolynomial.eval_monomial]
        dsimp only [Finsupp.prod]
        have hprod : (∏ j ∈ m.support, (a j) ^ (m j)) =
            c ^ d * (∏ j ∈ m.support, (b j) ^ (m j)) := by
          have h1 : ∀ j ∈ m.support, (a j) ^ (m j) = c ^ (m j) * (b j) ^ (m j) := by
            intro j _
            rw [ha_eq j, mul_pow]
          rw [Finset.prod_congr rfl h1, Finset.prod_mul_distrib,
            Finset.prod_pow_eq_pow_sum, hdeg]
        rw [hprod]
        ring
      have hc_pow : c ^ d ≠ 0 := pow_ne_zero d hc_ne
      apply hNotIff
      rw [heval_scale, mul_eq_zero, or_iff_right hc_pow]
    obtain ⟨ν, ν', hneq⟩ := hMinor
    let H₁ : MvPolynomial (Fin (N + 1)) k :=
      MvPolynomial.C (a ν) * MvPolynomial.X ν' - MvPolynomial.C (a ν') * MvPolynomial.X ν
    let H₂ : MvPolynomial (Fin (N + 1)) k :=
      MvPolynomial.C (b ν') * MvPolynomial.X ν - MvPolynomial.C (b ν) * MvPolynomial.X ν'
    have hH₁ : H₁ ∈ 𝒜_N 1 := by
      refine (𝒜_N 1).sub_mem ?_ ?_
      · rw [← MvPolynomial.smul_eq_C_mul]; exact (𝒜_N 1).smul_mem _ (MvPolynomial.isHomogeneous_X k ν')
      · rw [← MvPolynomial.smul_eq_C_mul]; exact (𝒜_N 1).smul_mem _ (MvPolynomial.isHomogeneous_X k ν)
    have hH₂ : H₂ ∈ 𝒜_N 1 := by
      refine (𝒜_N 1).sub_mem ?_ ?_
      · rw [← MvPolynomial.smul_eq_C_mul]; exact (𝒜_N 1).smul_mem _ (MvPolynomial.isHomogeneous_X k ν)
      · rw [← MvPolynomial.smul_eq_C_mul]; exact (𝒜_N 1).smul_mem _ (MvPolynomial.isHomogeneous_X k ν')
    refine ⟨H₁, H₂, hH₁, hH₂, ?_, ?_, ?_, ?_⟩
    · simp only [H₁, map_sub, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]; ring
    · simp only [H₁, map_sub, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
      exact sub_ne_zero.mpr hneq
    · simp only [H₂, map_sub, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]; ring
    · simp only [H₂, map_sub, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
      intro h0
      apply hneq
      linear_combination h0

  have hs3_cubic : ∀ (μ : Fin (N + 1))
      (hXμ : (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1)
      {H₁ H₂ M₁ M₂ : MvPolynomial (Fin (N + 1)) k}
      (hH₁ : H₁ ∈ 𝒜_N 1) (hH₂ : H₂ ∈ 𝒜_N 1) (hM₁ : M₁ ∈ 𝒜_N 1) (hM₂ : M₂ ∈ 𝒜_N 1)
      (hF : H₂ ^ 2 * M₁ + H₁ ^ 2 * M₂ ∈ 𝒜_N 3),
      (HomogeneousLocalization.mk ⟨3, ⟨H₂ ^ 2 * M₁ + H₁ ^ 2 * M₂, hF⟩,
        ⟨MvPolynomial.X μ ^ 3, (MvPolynomial.mem_homogeneousSubmodule 3 _).mpr
          (MvPolynomial.isHomogeneous_X_pow μ 3)⟩, ⟨3, rfl⟩⟩ :
          HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ)) =
      (HomogeneousLocalization.mk ⟨1, ⟨H₂, hH₂⟩, ⟨MvPolynomial.X μ, hXμ⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ)) ^ 2 *
        (HomogeneousLocalization.mk ⟨1, ⟨M₁, hM₁⟩, ⟨MvPolynomial.X μ, hXμ⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ)) +
      (HomogeneousLocalization.mk ⟨1, ⟨H₁, hH₁⟩, ⟨MvPolynomial.X μ, hXμ⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ)) ^ 2 *
        (HomogeneousLocalization.mk ⟨1, ⟨M₂, hM₂⟩, ⟨MvPolynomial.X μ, hXμ⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ)) := by
    intro μ hXμ H₁ H₂ M₁ M₂ hH₁ hH₂ hM₁ hM₂ hF
    apply HomogeneousLocalization.val_injective
    simp only [sq, HomogeneousLocalization.val_add, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.val_mk, Localization.mk_mul]
    have hden : (⟨MvPolynomial.X μ, ⟨1, pow_one _⟩⟩ * ⟨MvPolynomial.X μ, ⟨1, pow_one _⟩⟩ *
        ⟨MvPolynomial.X μ, ⟨1, pow_one _⟩⟩ :
          Submonoid.powers (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k)) =
        ⟨MvPolynomial.X μ ^ 3, ⟨3, rfl⟩⟩ := by
      ext
      simp only [Submonoid.coe_mul]
      ring
    rw [hden, Localization.add_mk_self]

  
  obtain ⟨r₁, hMax₁, t_tilde₁, Θ₁, hpt₁, hΘ₁_t, hΘ₁_alg, hΘ₁_sq⟩ :=
    hChartPull z₁ hz₁_cl μ₁ hXμ₁ W₁ hAff₁ hz₁ hW₁ s₁
  obtain ⟨r₂, hMax₂, t_tilde₂, Θ₂, hpt₂, hΘ₂_t, hΘ₂_alg, hΘ₂_sq⟩ :=
    hChartPull z₂ hz₂_cl μ₂ hXμ₂ W₂ hAff₂ hz₂ hW₂ s₂
  obtain ⟨⟨a, ha₁, ha_proj, ha_lin⟩, hJet₁⟩ := hs2 μ₁ hXμ₁ r₁ hMax₁
  obtain ⟨⟨b, hb₂, hb_proj, hb_lin⟩, hJet₂⟩ := hs2 μ₂ hXμ₂ r₂ hMax₂

  let y₁ := (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X μ₁) hXμ₁ zero_lt_one).base r₁
  let y₂ := (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X μ₂) hXμ₂ zero_lt_one).base r₂
  have hy12 : y₁ ≠ y₂ := by
    intro heq
    apply h12
    apply ι₀.left.isClosedEmbedding.injective
    exact hpt₁.symm.trans (heq.trans hpt₂)

  have hDeg0_mem : ∀ (I : Ideal (MvPolynomial (Fin (N + 1)) k)) [I.IsPrime]
      (G : MvPolynomial (Fin (N + 1)) k), G ∈ 𝒜_N 0 → (G ∈ I ↔ G = 0) := by
    intro I hI G hG0
    have hG_hom : G.IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule 0 G).mp hG0
    have hG_eq : G = MvPolynomial.C (G.coeff 0) := by
      ext m
      by_cases hm : m = 0
      · subst hm
        simp [MvPolynomial.coeff_C]
      · rw [MvPolynomial.coeff_C, if_neg (Ne.symm hm)]
        by_contra hne
        have hsum : (∑ j ∈ m.support, m j) = 0 :=
          (hWeight_eq m).symm.trans (hG_hom hne)
        rw [Finset.sum_eq_zero_iff] at hsum
        apply hm
        ext j
        by_cases hj : j ∈ m.support
        · exact hsum j hj
        · exact Finsupp.notMem_support_iff.mp hj
    refine ⟨fun hmem => ?_, fun h0 => h0.symm ▸ I.zero_mem⟩
    rw [hG_eq]
    by_contra hne
    have hc_ne : G.coeff 0 ≠ 0 := fun hc => hne (by rw [hc, map_zero])
    have h1_mem : (1 : MvPolynomial (Fin (N + 1)) k) ∈ I := by
      have hmul : (MvPolynomial.C (G.coeff 0) * MvPolynomial.C (G.coeff 0)⁻¹ :
          MvPolynomial (Fin (N + 1)) k) = 1 := by
        rw [← MvPolynomial.C_mul, mul_inv_cancel₀ hc_ne, map_one]
      rw [← hmul, ← hG_eq]
      exact I.mul_mem_right _ hmem
    exact hI.ne_top (I.eq_top_iff_one.mpr h1_mem)

  have hDiff : ∃ (d : ℕ), 1 ≤ d ∧
      ∃ G ∈ 𝒜_N d, ¬ (MvPolynomial.eval a G = 0 ↔ MvPolynomial.eval b G = 0) := by
    by_contra hNoDiff
    push_neg at hNoDiff
    apply hy12
    apply ProjectiveSpectrum.ext
    apply HomogeneousIdeal.ext'
    intro d G hG
    rcases Nat.eq_zero_or_pos d with rfl | hd_pos
    · have : y₁.asHomogeneousIdeal.toIdeal.IsPrime := y₁.isPrime
      have : y₂.asHomogeneousIdeal.toIdeal.IsPrime := y₂.isPrime
      exact (hDeg0_mem y₁.asHomogeneousIdeal.toIdeal G hG).trans
        (hDeg0_mem y₂.asHomogeneousIdeal.toIdeal G hG).symm
    · exact (ha_proj d hd_pos G hG).trans
        ((hNoDiff d hd_pos G hG).trans (hb_proj d hd_pos G hG).symm)

  obtain ⟨H₁, H₂, hH₁, hH₂, haH₁, hbH₁, hbH₂, haH₂⟩ := hs3_sep a b ha₁ hb₂ hDiff

  let loc₁ := algebraMap (HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₁))
    (Localization.AtPrime r₁.asIdeal)
  let loc₂ := algebraMap (HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₂))
    (Localization.AtPrime r₂.asIdeal)
  let 𝔪_r₁ := IsLocalRing.maximalIdeal (Localization.AtPrime r₁.asIdeal)
  let 𝔪_r₂ := IsLocalRing.maximalIdeal (Localization.AtPrime r₂.asIdeal)

  let h₂₁ := (HomogeneousLocalization.mk
    ⟨1, ⟨H₂, hH₂⟩, ⟨MvPolynomial.X μ₁, hXμ₁⟩, ⟨1, pow_one _⟩⟩ :
      HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₁))
  let h₁₁ := (HomogeneousLocalization.mk
    ⟨1, ⟨H₁, hH₁⟩, ⟨MvPolynomial.X μ₁, hXμ₁⟩, ⟨1, pow_one _⟩⟩ :
      HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₁))
  let h₁₂ := (HomogeneousLocalization.mk
    ⟨1, ⟨H₁, hH₁⟩, ⟨MvPolynomial.X μ₂, hXμ₂⟩, ⟨1, pow_one _⟩⟩ :
      HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₂))
  let h₂₂ := (HomogeneousLocalization.mk
    ⟨1, ⟨H₂, hH₂⟩, ⟨MvPolynomial.X μ₂, hXμ₂⟩, ⟨1, pow_one _⟩⟩ :
      HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₂))

  have hh₂₁_not : h₂₁ ∉ r₁.asIdeal := fun hm => haH₂ ((ha_lin H₂ hH₂).mp hm)
  have hh₁₁_mem : h₁₁ ∈ r₁.asIdeal := (ha_lin H₁ hH₁).mpr haH₁
  have hh₁₂_not : h₁₂ ∉ r₂.asIdeal := fun hm => hbH₁ ((hb_lin H₁ hH₁).mp hm)
  have hh₂₂_mem : h₂₂ ∈ r₂.asIdeal := (hb_lin H₂ hH₂).mpr hbH₂

  have hu₁ : IsUnit ((loc₁ h₂₁) ^ 2) :=
    (IsLocalization.map_units (Localization.AtPrime r₁.asIdeal)
      (⟨h₂₁, hh₂₁_not⟩ : r₁.asIdeal.primeCompl)).pow 2
  have hu₂ : IsUnit ((loc₂ h₁₂) ^ 2) :=
    (IsLocalization.map_units (Localization.AtPrime r₂.asIdeal)
      (⟨h₁₂, hh₁₂_not⟩ : r₂.asIdeal.primeCompl)).pow 2

  have hh₁₁_sq : (loc₁ h₁₁) ^ 2 ∈ 𝔪_r₁ ^ 2 := by
    have hm : loc₁ h₁₁ ∈ 𝔪_r₁ := by
      dsimp only [𝔪_r₁]
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal r₁.asIdeal]
      exact Ideal.mem_map_of_mem loc₁ hh₁₁_mem
    exact Ideal.pow_mem_pow hm 2

  have hh₂₂_sq : (loc₂ h₂₂) ^ 2 ∈ 𝔪_r₂ ^ 2 := by
    have hm : loc₂ h₂₂ ∈ 𝔪_r₂ := by
      dsimp only [𝔪_r₂]
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal r₂.asIdeal]
      exact Ideal.mem_map_of_mem loc₂ hh₂₂_mem
    exact Ideal.pow_mem_pow hm 2

  obtain ⟨M₁, hM₁, hM₁_jet⟩ := hJet₁ (↑(hu₁.unit⁻¹) * t_tilde₁)
  obtain ⟨M₂, hM₂, hM₂_jet⟩ := hJet₂ (↑(hu₂.unit⁻¹) * t_tilde₂)

  let F : MvPolynomial (Fin (N + 1)) k := H₂ ^ 2 * M₁ + H₁ ^ 2 * M₂
  have hF : F ∈ 𝒜_N 3 := by
    have h21 : H₂ ^ 2 * M₁ ∈ 𝒜_N (2 • 1 + 1) :=
      SetLike.mul_mem_graded (SetLike.pow_mem_graded 2 hH₂) hM₁
    have h12' : H₁ ^ 2 * M₂ ∈ 𝒜_N (2 • 1 + 1) :=
      SetLike.mul_mem_graded (SetLike.pow_mem_graded 2 hH₁) hM₂
    exact (𝒜_N 3).add_mem h21 h12'

  refine ⟨F, hF, ?_, ?_⟩
  · 
    let f_R₁ := (HomogeneousLocalization.mk ⟨3, ⟨F, hF⟩,
      ⟨MvPolynomial.X μ₁ ^ 3, (MvPolynomial.mem_homogeneousSubmodule 3 _).mpr
        (MvPolynomial.isHomogeneous_X_pow μ₁ 3)⟩, ⟨3, rfl⟩⟩ :
          HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₁))
    have hf_R₁_eq : f_R₁ = h₂₁ ^ 2 *
        (HomogeneousLocalization.mk ⟨1, ⟨M₁, hM₁⟩, ⟨MvPolynomial.X μ₁, hXμ₁⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₁)) +
        h₁₁ ^ 2 *
        (HomogeneousLocalization.mk ⟨1, ⟨M₂, hM₂⟩, ⟨MvPolynomial.X μ₁, hXμ₁⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₁)) :=
      hs3_cubic μ₁ hXμ₁ hH₁ hH₂ hM₁ hM₂ hF
    have hdiff₁ : loc₁ f_R₁ - t_tilde₁ ∈ 𝔪_r₁ ^ 2 := by
      let m₁₁ := (HomogeneousLocalization.mk ⟨1, ⟨M₁, hM₁⟩, ⟨MvPolynomial.X μ₁, hXμ₁⟩, ⟨1, pow_one _⟩⟩ :
        HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₁))
      let m₂₁ := (HomogeneousLocalization.mk ⟨1, ⟨M₂, hM₂⟩, ⟨MvPolynomial.X μ₁, hXμ₁⟩, ⟨1, pow_one _⟩⟩ :
        HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₁))
      have hid : loc₁ f_R₁ - t_tilde₁ =
          (loc₁ h₂₁) ^ 2 * (loc₁ m₁₁ - ↑(hu₁.unit⁻¹) * t_tilde₁) +
            (loc₁ h₁₁) ^ 2 * loc₁ m₂₁ := by
        rw [hf_R₁_eq, map_add, map_mul, map_mul, map_pow, map_pow, mul_sub,
          ← mul_assoc ((loc₁ h₂₁) ^ 2), IsUnit.mul_val_inv, one_mul]
        ring
      rw [hid]
      exact Ideal.add_mem _
        ((𝔪_r₁ ^ 2).mul_mem_left _ hM₁_jet)
        ((𝔪_r₁ ^ 2).mul_mem_right _ hh₁₁_sq)
    have hθ₁ := hΘ₁_sq (loc₁ f_R₁ - t_tilde₁) hdiff₁
    rwa [map_sub, hΘ₁_alg f_R₁, hΘ₁_t] at hθ₁
  · 
    let f_R₂ := (HomogeneousLocalization.mk ⟨3, ⟨F, hF⟩,
      ⟨MvPolynomial.X μ₂ ^ 3, (MvPolynomial.mem_homogeneousSubmodule 3 _).mpr
        (MvPolynomial.isHomogeneous_X_pow μ₂ 3)⟩, ⟨3, rfl⟩⟩ :
          HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₂))
    have hf_R₂_eq : f_R₂ = h₂₂ ^ 2 *
        (HomogeneousLocalization.mk ⟨1, ⟨M₁, hM₁⟩, ⟨MvPolynomial.X μ₂, hXμ₂⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₂)) +
        h₁₂ ^ 2 *
        (HomogeneousLocalization.mk ⟨1, ⟨M₂, hM₂⟩, ⟨MvPolynomial.X μ₂, hXμ₂⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₂)) :=
      hs3_cubic μ₂ hXμ₂ hH₁ hH₂ hM₁ hM₂ hF
    have hdiff₂ : loc₂ f_R₂ - t_tilde₂ ∈ 𝔪_r₂ ^ 2 := by
      let m₁₂ := (HomogeneousLocalization.mk ⟨1, ⟨M₁, hM₁⟩, ⟨MvPolynomial.X μ₂, hXμ₂⟩, ⟨1, pow_one _⟩⟩ :
        HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₂))
      let m₂₂ := (HomogeneousLocalization.mk ⟨1, ⟨M₂, hM₂⟩, ⟨MvPolynomial.X μ₂, hXμ₂⟩, ⟨1, pow_one _⟩⟩ :
        HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X μ₂))
      have hid : loc₂ f_R₂ - t_tilde₂ =
          (loc₂ h₂₂) ^ 2 * loc₂ m₁₂ +
            (loc₂ h₁₂) ^ 2 * (loc₂ m₂₂ - ↑(hu₂.unit⁻¹) * t_tilde₂) := by
        rw [hf_R₂_eq, map_add, map_mul, map_mul, map_pow, map_pow, mul_sub,
          ← mul_assoc ((loc₂ h₁₂) ^ 2), IsUnit.mul_val_inv, one_mul]
        ring
      rw [hid]
      exact Ideal.add_mem _
        ((𝔪_r₂ ^ 2).mul_mem_right _ hh₂₂_sq)
        ((𝔪_r₂ ^ 2).mul_mem_left _ hM₂_jet)
    have hθ₂ := hΘ₂_sq (loc₂ f_R₂ - t_tilde₂) hdiff₂
    rwa [map_sub, hΘ₂_alg f_R₂, hΘ₂_t] at hθ₂

theorem weil_algClosed_etale_aug_and_trunc_local_equiv (k : Type u) [Field k] [IsAlgClosed k] :
    (∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra k R] [Algebra k S]
        (g : R →ₐ[k] S),
      g.toRingHom.Etale →
      ∀ (ε₀ : R →ₐ[k] k) (Q : Ideal S) [Q.IsPrime],
        RingHom.ker ε₀.toRingHom ≤ Ideal.comap g.toRingHom Q →
        ∃ ε_S : S →ₐ[k] k,
          RingHom.ker ε_S.toRingHom = Q ∧ ε_S.comp g = ε₀ ∧ Q.IsMaximal) ∧
    (∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra k R] [Algebra k S]
        (f : R →ₐ[k] S),
      f.toRingHom.Etale →
      ∀ (P : Ideal R) [P.IsPrime] (Q : Ideal S) [Q.IsPrime]
        (hPQ : P = Ideal.comap f.toRingHom Q)
        (ε_R : R →ₐ[k] k) (ε_S : S →ₐ[k] k),
        RingHom.ker ε_R.toRingHom = P →
        RingHom.ker ε_S.toRingHom = Q →
        ε_S.comp f = ε_R →
        (∀ n : ℕ,
          ∃ Φ_n :
            (Localization.AtPrime P ⧸
              (IsLocalRing.maximalIdeal (Localization.AtPrime P)) ^ n) ≃ₐ[k]
            (Localization.AtPrime Q ⧸
              (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) ^ n),
            ∀ x : Localization.AtPrime P,
              Φ_n (Ideal.Quotient.mk _ x) =
                Ideal.Quotient.mk _ (Localization.localRingHom P Q f.toRingHom hPQ x)) ∧
        (IsNoetherianRing S →
          Ideal.map (Localization.localRingHom P Q f.toRingHom hPQ)
            (IsLocalRing.maximalIdeal (Localization.AtPrime P)) =
            IsLocalRing.maximalIdeal (Localization.AtPrime Q))) ∧
    (∀ (R : Type u) [CommRing R] [Algebra k R]
        (P : Ideal R) [P.IsPrime]
        (I : Ideal R),
      I ≤ P →
      ∀ (P_bar : Ideal (R ⧸ I)) [P_bar.IsPrime],
        Ideal.comap (Ideal.Quotient.mk I) P_bar = P →
        ∀ n : ℕ,
          Nonempty
            ((Localization.AtPrime P ⧸
                (Ideal.map (algebraMap R (Localization.AtPrime P)) I ⊔
                  (IsLocalRing.maximalIdeal (Localization.AtPrime P)) ^ n)) ≃ₐ[k]
              (Localization.AtPrime P_bar ⧸
                (IsLocalRing.maximalIdeal (Localization.AtPrime P_bar)) ^ n))) ∧
    (∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B),
      f.Etale →
      ∀ (P : Ideal A) [P.IsPrime] (Q : Ideal B) [Q.IsPrime],
        IsReduced (Localization.AtPrime Q ⧸
          Ideal.map ((algebraMap B (Localization.AtPrime Q)).comp f) P)) :=
by
  refine ⟨?_, ?_, ?_, ?_⟩
  · 
    intro R S _ _ _ _ g hg ε₀ Q _ hle
    let P₀ : Ideal R := RingHom.ker ε₀.toRingHom
    let J₀ : Ideal S := Ideal.map g.toRingHom P₀
    have hEt_kE : Algebra.Etale k (S ⧸ J₀) := by
      let ε₀_bar : (R ⧸ P₀) →+* k := Ideal.Quotient.lift P₀ ε₀.toRingHom (fun _ h => h)
      have hbij_D₀ : Function.Bijective (algebraMap k (R ⧸ P₀)) := by
        refine ⟨?_, ?_⟩
        · intro c₁ c₂ hc
          have h1 : ε₀_bar (algebraMap k (R ⧸ P₀) c₁) = c₁ := ε₀.commutes c₁
          have h2 : ε₀_bar (algebraMap k (R ⧸ P₀) c₂) = c₂ := ε₀.commutes c₂
          rw [← h1, ← h2, hc]
        · intro d
          obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective d
          refine ⟨ε₀ r, ?_⟩
          change Ideal.Quotient.mk P₀ (algebraMap k R (ε₀ r)) = Ideal.Quotient.mk P₀ r
          rw [Ideal.Quotient.eq]
          change ε₀.toRingHom (algebraMap k R (ε₀ r) - r) = 0
          rw [map_sub]
          change ε₀ (algebraMap k R (ε₀ r)) - ε₀ r = 0
          rw [ε₀.commutes (ε₀ r), Algebra.algebraMap_self, RingHom.id_apply, sub_self]
      haveI : Algebra.Etale k (R ⧸ P₀) :=
        RingHom.etale_algebraMap.mp (RingHom.Etale.of_bijective hbij_D₀)
      letI : Algebra R S := g.toRingHom.toAlgebra
      haveI : Algebra.Etale R S := hg.toAlgebra
      haveI : Algebra.Etale (R ⧸ P₀) (TensorProduct R (R ⧸ P₀) S) :=
        Algebra.Etale.baseChange R S (R ⧸ P₀)
      let φ_DE : (R ⧸ P₀) →+* (S ⧸ J₀) :=
        Ideal.Quotient.lift P₀ ((Ideal.Quotient.mk J₀).comp g.toRingHom) fun r hr => by
          change Ideal.Quotient.mk J₀ (g.toRingHom r) = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem g.toRingHom hr)
      letI : Algebra (R ⧸ P₀) (S ⧸ J₀) := φ_DE.toAlgebra
      let e_ring : TensorProduct R (R ⧸ P₀) S ≃+* (S ⧸ J₀) :=
        (Algebra.TensorProduct.comm R (R ⧸ P₀) S).toRingEquiv.trans
          (Algebra.TensorProduct.quotIdealMapEquivTensorQuot S P₀).symm.toRingEquiv
      have he_comm : ∀ d : R ⧸ P₀,
          e_ring (algebraMap (R ⧸ P₀) (TensorProduct R (R ⧸ P₀) S) d) =
            algebraMap (R ⧸ P₀) (S ⧸ J₀) d := by
        intro d
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective d
        change (Algebra.TensorProduct.quotIdealMapEquivTensorQuot S P₀).symm
          ((Algebra.TensorProduct.comm R (R ⧸ P₀) S) ((Ideal.Quotient.mk P₀ r) ⊗ₜ[R] (1 : S))) =
          φ_DE (Ideal.Quotient.mk P₀ r)
        rw [Algebra.TensorProduct.comm_tmul,
          Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul]
        change Ideal.Quotient.mk J₀ (g.toRingHom r * 1) = Ideal.Quotient.mk J₀ (g.toRingHom r)
        rw [mul_one]
      let e_DE : TensorProduct R (R ⧸ P₀) S ≃ₐ[R ⧸ P₀] (S ⧸ J₀) :=
        AlgEquiv.ofRingEquiv he_comm
      haveI : Algebra.Etale (R ⧸ P₀) (S ⧸ J₀) := Algebra.Etale.of_equiv e_DE
      haveI : IsScalarTower k (R ⧸ P₀) (S ⧸ J₀) := IsScalarTower.of_algebraMap_eq fun c => by
        rw [IsScalarTower.algebraMap_apply k R (R ⧸ P₀),
          IsScalarTower.algebraMap_apply k S (S ⧸ J₀)]
        change Ideal.Quotient.mk J₀ (algebraMap k S c) =
          Ideal.Quotient.mk J₀ (g.toRingHom (algebraMap k R c))
        exact congrArg (Ideal.Quotient.mk J₀) (g.commutes c).symm
      exact Algebra.Etale.comp k (R ⧸ P₀) (S ⧸ J₀)
    obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod k (S ⧸ J₀)).mp hEt_kE
    letI : Finite I := hFinI
    letI : ∀ i : I, Field (Ai i) := hFieldAi
    letI : ∀ i : I, Algebra k (Ai i) := hAlgAi
    haveI : IsSepClosed k := IsSepClosed.of_isAlgClosed k
    let e_i : ∀ i : I, Ai i ≃ₐ[k] k := fun i => by
      haveI : Algebra.IsSeparable k (Ai i) := (hSep i).2
      exact (AlgEquiv.ofBijective (Algebra.ofId k (Ai i))
        ⟨(algebraMap k (Ai i)).injective, IsSepClosed.algebraMap_surjective k (Ai i)⟩).symm
    let e_pi : (S ⧸ J₀) ≃ₐ[k] (I → k) := e_prod.trans (AlgEquiv.piCongrRight e_i)
    let π_Q : S →ₐ[k] (I → k) := e_pi.toAlgHom.comp (Ideal.Quotient.mkₐ k J₀)
    have hπ_surj : Function.Surjective π_Q.toRingHom :=
      e_pi.surjective.comp Ideal.Quotient.mk_surjective
    have hker_πQ : RingHom.ker π_Q.toRingHom = J₀ := by
      ext s
      change e_pi (Ideal.Quotient.mk J₀ s) = 0 ↔ s ∈ J₀
      rw [map_eq_zero_iff e_pi e_pi.injective, Ideal.Quotient.eq_zero_iff_mem]
    have hJ₀_le_Q : J₀ ≤ Q := Ideal.map_le_iff_le_comap.mpr hle
    let Q' : Ideal (I → k) := Ideal.map π_Q.toRingHom Q
    have hQ'_comap : Ideal.comap π_Q.toRingHom Q' = Q := by
      rw [Ideal.comap_map_of_surjective π_Q.toRingHom hπ_surj Q]
      change Q ⊔ RingHom.ker π_Q.toRingHom = Q
      rw [hker_πQ, sup_eq_left.mpr hJ₀_le_Q]
    have hQ'_prime : Q'.IsPrime :=
      Ideal.map_isPrime_of_surjective hπ_surj (by rw [hker_πQ]; exact hJ₀_le_Q)
    classical
    letI : Fintype I := Fintype.ofFinite I
    have hex_i₀ : ∃ i₀ : I, Pi.single i₀ (1 : k) ∉ Q' := by
      by_contra hall
      have hsum : (∑ i : I, Pi.single i (1 : k)) ∈ Q' :=
        Q'.sum_mem fun i _ => Classical.not_not.mp fun hnot => hall ⟨i, hnot⟩
      have hsum_eq : (∑ i : I, Pi.single i (1 : k)) = (1 : I → k) :=
        LinearMap.sum_single_apply (fun _ : I => k) (1 : I → k)
      rw [hsum_eq] at hsum
      exact ((Ideal.ne_top_iff_one Q').mp hQ'_prime.ne_top) hsum
    obtain ⟨i₀, hi₀⟩ := hex_i₀
    have hQ'_iff : ∀ h : I → k, h ∈ Q' ↔ h i₀ = 0 := by
      intro h
      have hmul : (h - algebraMap k (I → k) (h i₀)) * Pi.single i₀ (1 : k) = 0 := by
        ext j
        by_cases hj : j = i₀
        · subst hj
          simp
        · simp [Pi.single_eq_of_ne hj]
      have hdiff_mem : h - algebraMap k (I → k) (h i₀) ∈ Q' := by
        have h0 : (h - algebraMap k (I → k) (h i₀)) * Pi.single i₀ (1 : k) ∈ Q' := by
          rw [hmul]
          exact Q'.zero_mem
        rcases hQ'_prime.mem_or_mem h0 with hleft | hright
        · exact hleft
        · exact False.elim (hi₀ hright)
      constructor
      · intro hh
        by_contra hne
        have hconst_mem : algebraMap k (I → k) (h i₀) ∈ Q' := by
          have heq : algebraMap k (I → k) (h i₀) =
              h - (h - algebraMap k (I → k) (h i₀)) := by ring
          rw [heq]
          exact Q'.sub_mem hh hdiff_mem
        have hone_mem : (1 : I → k) ∈ Q' := by
          have hprod := Q'.mul_mem_left (algebraMap k (I → k) (h i₀)⁻¹) hconst_mem
          rw [← map_mul, inv_mul_cancel₀ hne, map_one] at hprod
          exact hprod
        exact ((Ideal.ne_top_iff_one Q').mp hQ'_prime.ne_top) hone_mem
      · intro hh0
        rw [hh0, map_zero, sub_zero] at hdiff_mem
        exact hdiff_mem
    let ε_S : S →ₐ[k] k := (Pi.evalAlgHom k (fun _ : I => k) i₀).comp π_Q
    have hker_εS : RingHom.ker ε_S.toRingHom = Q := by
      ext s
      change (π_Q s) i₀ = 0 ↔ s ∈ Q
      rw [← hQ'_iff (π_Q s), ← hQ'_comap]
      rfl
    have hQ_max : Q.IsMaximal := by
      rw [← hker_εS]
      exact RingHom.ker_isMaximal_of_surjective ε_S.toRingHom
        (fun c => ⟨algebraMap k S c, ε_S.commutes c⟩)
    have hcomp_εS : ε_S.comp g = ε₀ := by
      ext r
      have hr_mem : r - algebraMap k R (ε₀ r) ∈ P₀ := by
        change ε₀.toRingHom (r - algebraMap k R (ε₀ r)) = 0
        rw [map_sub]
        change ε₀ r - ε₀ (algebraMap k R (ε₀ r)) = 0
        rw [ε₀.commutes (ε₀ r), Algebra.algebraMap_self, RingHom.id_apply, sub_self]
      have hgr_mem : g.toRingHom (r - algebraMap k R (ε₀ r)) ∈ RingHom.ker ε_S.toRingHom := by
        rw [hker_εS]
        exact hle hr_mem
      change ε_S.toRingHom (g.toRingHom (r - algebraMap k R (ε₀ r))) = 0 at hgr_mem
      rw [map_sub, map_sub] at hgr_mem
      change ε_S (g r) - ε_S (g (algebraMap k R (ε₀ r))) = 0 at hgr_mem
      rw [g.commutes (ε₀ r), ε_S.commutes (ε₀ r), Algebra.algebraMap_self,
        RingHom.id_apply] at hgr_mem
      exact sub_eq_zero.mp hgr_mem
    exact ⟨ε_S, hker_εS, hcomp_εS, hQ_max⟩
  · 
    intro R S _ _ _ _ f hf P _ Q _ hPQ ε_R ε_S hker_R hker_S hcomp
    let f_loc : Localization.AtPrime P →+* Localization.AtPrime Q :=
      Localization.localRingHom P Q f.toRingHom hPQ
    haveI : IsLocalHom f_loc := Localization.isLocalHom_localRingHom P Q f.toRingHom hPQ
    have hm_comap : Ideal.comap f_loc (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) =
        IsLocalRing.maximalIdeal (Localization.AtPrime P) := by
      ext x
      change f_loc x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) ↔
        x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime P)
      rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal,
        map_mem_nonunits_iff f_loc x]
    have hm_le : Ideal.map f_loc (IsLocalRing.maximalIdeal (Localization.AtPrime P)) ≤
        IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
      Ideal.map_le_iff_le_comap.mpr hm_comap.ge
    let f_loc_alg : Localization.AtPrime P →ₐ[k] Localization.AtPrime Q :=
      { f_loc with
        commutes' := fun c => by
          rw [IsScalarTower.algebraMap_apply k R (Localization.AtPrime P),
            IsScalarTower.algebraMap_apply k S (Localization.AtPrime Q)]
          change Localization.localRingHom P Q f.toRingHom hPQ
              (algebraMap R (Localization.AtPrime P) (algebraMap k R c)) =
            algebraMap S (Localization.AtPrime Q) (algebraMap k S c)
          rw [Localization.localRingHom_to_map]
          exact congrArg (algebraMap S (Localization.AtPrime Q)) (f.commutes c) }
    have hTrunc : ∀ n : ℕ,
        ∃ Φ_n :
          (Localization.AtPrime P ⧸
            (IsLocalRing.maximalIdeal (Localization.AtPrime P)) ^ n) ≃ₐ[k]
          (Localization.AtPrime Q ⧸
            (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) ^ n),
          ∀ x : Localization.AtPrime P,
            Φ_n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (f_loc x) := by
      intro n
      let m_P := IsLocalRing.maximalIdeal (Localization.AtPrime P)
      let m_Q := IsLocalRing.maximalIdeal (Localization.AtPrime Q)
      have hmap_pow_le : ∀ x ∈ m_P ^ n,
          ((Ideal.Quotient.mkₐ k (m_Q ^ n)).comp f_loc_alg) x = 0 := by
        intro x hx
        change Ideal.Quotient.mk (m_Q ^ n) (f_loc x) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem]
        have hmem : f_loc x ∈ Ideal.map f_loc (m_P ^ n) := Ideal.mem_map_of_mem f_loc hx
        rw [Ideal.map_pow] at hmem
        exact pow_le_pow_left' hm_le n hmem
      let Φ_n_hom :
          (Localization.AtPrime P ⧸ m_P ^ n) →ₐ[k] (Localization.AtPrime Q ⧸ m_Q ^ n) :=
        Ideal.Quotient.liftₐ (m_P ^ n)
          ((Ideal.Quotient.mkₐ k (m_Q ^ n)).comp f_loc_alg) hmap_pow_le
      have hΦ_mk : ∀ x : Localization.AtPrime P,
          Φ_n_hom (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (f_loc x) := fun _ => rfl
      rcases eq_or_ne n 0 with rfl | hn
      · haveI : Subsingleton (Localization.AtPrime P ⧸ m_P ^ 0) :=
          Ideal.Quotient.subsingleton_iff.mpr (by rw [pow_zero, Ideal.one_eq_top])
        haveI : Subsingleton (Localization.AtPrime Q ⧸ m_Q ^ 0) :=
          Ideal.Quotient.subsingleton_iff.mpr (by rw [pow_zero, Ideal.one_eq_top])
        exact ⟨AlgEquiv.ofBijective Φ_n_hom
          ⟨fun a b _ => Subsingleton.elim a b, fun b => ⟨0, Subsingleton.elim _ _⟩⟩, hΦ_mk⟩
      · have ht_R : ∀ y : P.primeCompl, IsUnit (ε_R.toRingHom y.1) := by
          intro y
          have hy : ε_R.toRingHom y.1 ≠ 0 := by
            intro h0
            have hmem : y.1 ∈ RingHom.ker ε_R.toRingHom := h0
            rw [hker_R] at hmem
            exact y.2 hmem
          exact hy.isUnit
        let ε_R_loc : Localization.AtPrime P →+* k :=
          IsLocalization.lift (S := Localization.AtPrime P) ht_R
        have hε_R_loc_surj : Function.Surjective ε_R_loc := by
          intro c
          refine ⟨algebraMap k (Localization.AtPrime P) c, ?_⟩
          rw [IsScalarTower.algebraMap_apply k R (Localization.AtPrime P),
            IsLocalization.lift_eq]
          exact ε_R.commutes c
        have hker_εR_loc : RingHom.ker ε_R_loc = m_P :=
          (IsLocalRing.isMaximal_iff (Localization.AtPrime P)).mp
            (RingHom.ker_isMaximal_of_surjective ε_R_loc hε_R_loc_surj)
        have hmP_pow_ker : ∀ x ∈ m_P ^ n, ε_R_loc x = 0 := by
          intro x hx
          have hmem : x ∈ m_P := Ideal.pow_le_self hn hx
          rwa [← hker_εR_loc] at hmem
        let π_R : (Localization.AtPrime P ⧸ m_P ^ n) →+* k :=
          Ideal.Quotient.lift (m_P ^ n) ε_R_loc hmP_pow_ker
        have hπ_R_alg : ∀ c : k,
            π_R (algebraMap k (Localization.AtPrime P ⧸ m_P ^ n) c) = c := by
          intro c
          change ε_R_loc (algebraMap k (Localization.AtPrime P) c) = c
          rw [IsScalarTower.algebraMap_apply k R (Localization.AtPrime P),
            IsLocalization.lift_eq]
          exact ε_R.commutes c
        have hπ_R_surj : Function.Surjective π_R := fun c => ⟨algebraMap k _ c, hπ_R_alg c⟩
        have hker_πR : RingHom.ker π_R = Ideal.map (Ideal.Quotient.mk (m_P ^ n)) m_P := by
          apply le_antisymm
          · intro z hz
            obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
            have hx : x ∈ RingHom.ker ε_R_loc := hz
            rw [hker_εR_loc] at hx
            exact Ideal.mem_map_of_mem _ hx
          · rw [Ideal.map_le_iff_le_comap]
            intro x hx
            rw [← hker_εR_loc] at hx
            exact hx
        have hker_πR_pow : (RingHom.ker π_R) ^ n = ⊥ := by
          rw [hker_πR, ← Ideal.map_pow, Ideal.map_quotient_self]
        have hπ_R_nil : IsNilpotent (RingHom.ker π_R) := ⟨n, hker_πR_pow⟩
        have ht_S : ∀ y : Q.primeCompl, IsUnit (ε_S.toRingHom y.1) := by
          intro y
          have hy : ε_S.toRingHom y.1 ≠ 0 := by
            intro h0
            have hmem : y.1 ∈ RingHom.ker ε_S.toRingHom := h0
            rw [hker_S] at hmem
            exact y.2 hmem
          exact hy.isUnit
        let ε_S_loc : Localization.AtPrime Q →+* k :=
          IsLocalization.lift (S := Localization.AtPrime Q) ht_S
        have hε_S_loc_surj : Function.Surjective ε_S_loc := by
          intro c
          refine ⟨algebraMap k (Localization.AtPrime Q) c, ?_⟩
          rw [IsScalarTower.algebraMap_apply k S (Localization.AtPrime Q),
            IsLocalization.lift_eq]
          exact ε_S.commutes c
        have hker_εS_loc : RingHom.ker ε_S_loc = m_Q :=
          (IsLocalRing.isMaximal_iff (Localization.AtPrime Q)).mp
            (RingHom.ker_isMaximal_of_surjective ε_S_loc hε_S_loc_surj)
        have hmQ_pow_ker : ∀ y ∈ m_Q ^ n, ε_S_loc y = 0 := by
          intro y hy
          have hmem : y ∈ m_Q := Ideal.pow_le_self hn hy
          rwa [← hker_εS_loc] at hmem
        let π_S : (Localization.AtPrime Q ⧸ m_Q ^ n) →+* k :=
          Ideal.Quotient.lift (m_Q ^ n) ε_S_loc hmQ_pow_ker
        have hker_πS : RingHom.ker π_S = Ideal.map (Ideal.Quotient.mk (m_Q ^ n)) m_Q := by
          apply le_antisymm
          · intro z hz
            obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
            have hy : y ∈ RingHom.ker ε_S_loc := hz
            rw [hker_εS_loc] at hy
            exact Ideal.mem_map_of_mem _ hy
          · rw [Ideal.map_le_iff_le_comap]
            intro y hy
            rw [← hker_εS_loc] at hy
            exact hy
        have hker_πS_pow : (RingHom.ker π_S) ^ n = ⊥ := by
          rw [hker_πS, ← Ideal.map_pow, Ideal.map_quotient_self]
        have hπ_S_nil : IsNilpotent (RingHom.ker π_S) := ⟨n, hker_πS_pow⟩
        have hπ_comp : π_S.comp Φ_n_hom.toRingHom = π_R := by
          apply Ideal.Quotient.ringHom_ext
          apply IsLocalization.ringHom_ext P.primeCompl
          ext r
          change π_S (Φ_n_hom (Ideal.Quotient.mk (m_P ^ n)
