    intro y
    have hy : y ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜_1).Opens) := trivial
    rw [← h_top, TopologicalSpace.Opens.mem_iSup] at hy
    exact hy

  
  have h_p1_dehom : ∀ (b : Fin 2) (hTb : (MvPolynomial.X b : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1),
      let D_b : (AlgebraicGeometry.Proj 𝒜_1).Opens :=
        AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b)
      ∃ e_Db_cat : CommRingCat.of (Polynomial k) ≅
          (AlgebraicGeometry.Proj 𝒜_1).presheaf.obj (Opposite.op D_b),
