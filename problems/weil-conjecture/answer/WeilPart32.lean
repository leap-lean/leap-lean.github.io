            (Category.assoc _ (ι_bar.left.app (D_M p.1)) (Z_bar.left.presheaf.map (homOfLE hV_le).op)) _
        · apply congrArg (p₁_P.appLE (D₁ b) W_b inf_le_right).hom
          have hid : (homOfLE (le_rfl : D₁ b ≤ D₁ b)) = 𝟙 _ := Subsingleton.elim _ _
          have h_id_map : P₁.left.presheaf.map (homOfLE (le_rfl : D₁ b ≤ D₁ b)).op = 𝟙 _ := by
            rw [hid, op_id, CategoryTheory.Functor.map_id]
          dsimp [t_sec]
          erw [h_id_map, Category.comp_id]
          rfl
      have h_iso := hChart_iso P₁ _ ι_Z_Q₁ hCl_ZQ₁ D₁ hAff_D₁ hCov_D₁ t_sec ht_diag ht_basic
