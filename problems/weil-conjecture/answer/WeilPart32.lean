      hBasic_T hBasic_S hInv_T_S

  
  obtain ⟨hSurj_Γ₂, hKer_Γ₂⟩ := hKer_Γ H₂ hH₂ U₂_c hAff₂ hU₂_sub
  obtain ⟨hΓ_k₂, hΓ_sec₂⟩ :=
    hApp_compat ι_Γ (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) hU₂_sub h_top₂
  have hΓ_u₁ : (ι_Γ.left.app U₂_c).hom u₁ = u₁₂ := hΓ_sec₂ _
  have hΓ_τ₂ : (ι_Γ.left.app U₂_c).hom τ₂ = τ₁₂ := hΓ_sec₂ _

  
  have hHyp_H₁_pow3 : ∀ p : P_N.left,
      p ∈ weilProjHyperplaneSet k N (H₁ ^ 3) ↔ p ∈ weilProjHyperplaneSet k N H₁ := by
    intro p
    change p ∉ (AlgebraicGeometry.Proj.basicOpen 𝒜_N (H₁ ^ 3)).1 ↔
