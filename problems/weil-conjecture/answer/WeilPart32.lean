  let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
    MvPolynomial.gradedAlgebra
  let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
    MvPolynomial.gradedAlgebra
  intro 𝒜_M 𝒜_1 P₁ Q₁ p₁_Z p₁_P

  
  have h_p1_cov : ∀ y : AlgebraicGeometry.Proj 𝒜_1, ∃ b : Fin 2,
      y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b) := by
    classical
    have h_irrel : (HomogeneousIdeal.irrelevant 𝒜_1).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) k)) := by
      intro p hp
      have hp0 : GradedRing.proj 𝒜_1 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜_1 p).mp hp
      have h_eval0 : MvPolynomial.eval (0 : Fin 2 → k) p = 0 := by
        rw [← DirectSum.sum_support_decompose 𝒜_1 p, map_sum]
        refine Finset.sum_eq_zero fun i _ => ?_
        by_cases hi : i = 0
        · rw [hi]
          change MvPolynomial.eval 0 (GradedRing.proj 𝒜_1 0 p) = 0
          rw [hp0, map_zero]
        · have h_hom : ((DirectSum.decompose 𝒜_1 p i : 𝒜_1 i) :
              MvPolynomial (Fin 2) k).IsHomogeneous i := (DirectSum.decompose 𝒜_1 p i).2
          let q : MvPolynomial (Fin 2) k := (DirectSum.decompose 𝒜_1 p i : 𝒜_1 i)
          change MvPolynomial.eval 0 q = 0
          rw [MvPolynomial.as_sum q, map_sum]
          refine Finset.sum_eq_zero fun d hd => ?_
          have hd_ne0 : Finsupp.degree d ≠ 0 := by
            intro hd0
            have h_i : Finsupp.degree d ≠ i := by omega
            exact (MvPolynomial.mem_support_iff.mp hd) (h_hom.coeff_eq_zero h_i)
          have hd_sum : d 0 + d 1 ≠ 0 := by
            have hdeg : Finsupp.degree d = d 0 + d 1 := by
              change d.sum (fun _ n => n) = d 0 + d 1
              rw [Finsupp.sum_fintype d _ (fun _ => rfl)]
              exact Fin.sum_univ_two d
            omega
          rw [MvPolynomial.eval_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
            Fin.prod_univ_two]
          simp only [Pi.zero_apply]
          by_cases hd0 : d 0 = 0
          · have hd1 : d 1 ≠ 0 := by omega
            rw [zero_pow hd1, mul_zero, mul_zero]
          · rw [zero_pow hd0, zero_mul, mul_zero]
      have h_coeff0 : p.coeff 0 = 0 := by
        have h1 : MvPolynomial.eval (0 : Fin 2 → k) p = p.coeff 0 := by
          rw [MvPolynomial.as_sum p, map_sum]
          rw [Finset.sum_eq_single (0 : Fin 2 →₀ ℕ)]
          · simp
          · intro d _ hd_ne
            rw [MvPolynomial.eval_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
              Fin.prod_univ_two]
            simp only [Pi.zero_apply]
            by_cases hd0 : d 0 = 0
            · have hd1 : d 1 ≠ 0 := by
                intro h1
                apply hd_ne
                ext j
                by_cases hj : j = 0
                · rw [hj]; exact hd0
                · have hj1 : j = 1 := by omega
                  rw [hj1]; exact h1
              rw [zero_pow hd1, mul_zero, mul_zero]
            · rw [zero_pow hd0, zero_mul, mul_zero]
          · intro h_not_mem
            rw [MvPolynomial.notMem_support_iff.mp h_not_mem, MvPolynomial.monomial_zero, map_zero]
        exact h1.symm.trans h_eval0
      rw [MvPolynomial.as_sum p]
      refine Ideal.sum_mem _ fun d hd => ?_
      have hd_ne : d ≠ 0 := by
        intro hd0
        rw [hd0] at hd
        exact (MvPolynomial.mem_support_iff.mp hd) h_coeff0
      rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
