            rw [h_prod, Matrix.det_fromBlocks_zero₂₁, Matrix.det_fin_one] at h_zero_det
            have h_entry : (C_row * B_β + D_β) 0 0 = ∑ r : Fin (n + 1), c r * M₀ r β := by
              rw [Fin.sum_univ_castSucc]
              simp [C_row, B_β, D_β, c, Matrix.mul_apply]
            rw [h_entry] at h_zero_det
            exact (mul_eq_zero.mp h_zero_det).resolve_left hδ
      let J : Matrix (Fin ν) (Fin d) L :=
        Matrix.of fun r β =>
          ∑ m_idx : Fin N, w (r, α₀.succAbove m_idx) * algebraMap F L (v_tilde m_idx β)
      obtain ⟨c, hc_ne, hc_orth⟩ := h_row_dep ν J hMinors
      obtain ⟨r₀, hr₀_ne⟩ : ∃ r₀ : Fin ν, c r₀ ≠ 0 := Function.ne_iff.mp hc_ne
      let ν' := ν - 1
      let e_ν : Fin (ν' + 1) ≃ Fin ν := finCongr (Nat.sub_add_cancel hν)
      let p₀ : Fin (ν' + 1) := e_ν.symm r₀
      have hp₀ : e_ν p₀ = r₀ := e_ν.apply_symm_apply r₀
      let r_s : Fin ν' → Fin ν := fun s => e_ν (p₀.succAbove s)
      let lam : Fin ν' → L := fun s => - (c (r_s s) / c r₀)
      have hJ_r0 : ∀ β : Fin d, J r₀ β = ∑ s : Fin ν', lam s * J (r_s s) β := by
        intro β
        have h_sum0 := hc_orth β
        rw [← Equiv.sum_comp e_ν (fun r => c r * J r β),
          Fin.sum_univ_succAbove _ p₀, hp₀] at h_sum0
        have h_eq1 : c r₀ * J r₀ β = - ∑ s : Fin ν', c (r_s s) * J (r_s s) β :=
          eq_neg_of_add_eq_zero_left h_sum0
        apply mul_left_cancel₀ hr₀_ne
        rw [h_eq1, Finset.mul_sum, ← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun s _ => ?_
        dsimp only [lam]
        have h_div : c r₀ * - (c (r_s s) / c r₀) = - c (r_s s) := by
          rw [mul_neg, mul_div_cancel₀ _ hr₀_ne]
        rw [← mul_assoc, h_div, neg_mul]
      let u_vec : Fin N → L := fun m_idx =>
        w (r₀, α₀.succAbove m_idx) - ∑ s : Fin ν', lam s * w (r_s s, α₀.succAbove m_idx)
      have hu_v : ∀ β : Fin d,
          ∑ m_idx : Fin N, u_vec m_idx * algebraMap F L (v_tilde m_idx β) = 0 := by
        intro β
        have h_expand : (∑ m_idx : Fin N, u_vec m_idx * algebraMap F L (v_tilde m_idx β)) =
            J r₀ β - ∑ s : Fin ν', lam s * J (r_s s) β := by
          dsimp only [u_vec, J]
          simp_rw [Matrix.of_apply, sub_mul, Finset.sum_sub_distrib, Finset.sum_mul,
            Finset.mul_sum, mul_assoc]
          rw [Finset.sum_comm]
        rw [h_expand, hJ_r0 β, sub_self]
      let t_ker : Fin (N - d) → L := fun j =>
        ∑ m₀ : Fin N, u_vec m₀ * algebraMap F L (μ_coeff m₀ j)
      have hu_eq : ∀ m_idx : Fin N,
          u_vec m_idx = ∑ j : Fin (N - d), t_ker j * algebraMap F L ((b_ker j).1 m_idx) := by
        intro m_idx
        have h1 : ∑ m₀ : Fin N, u_vec m₀ * algebraMap F L (Q_proj m₀ m_idx) = u_vec m_idx := by
          dsimp only [Q_proj]
          simp only [Matrix.sub_apply, Matrix.one_apply, Matrix.mul_apply, map_sub, map_sum,
            map_mul, apply_ite (algebraMap F L), map_one, map_zero, mul_sub,
            Finset.sum_sub_distrib, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
            Finset.mem_univ, ↓reduceIte]
          have h_van : ∑ x : Fin N, u_vec x *
              (∑ x_1 : Fin d,
                algebraMap F L (v_tilde x x_1) * algebraMap F L (U_tilde x_1 m_idx)) = 0 := by
            simp_rw [Finset.mul_sum, ← mul_assoc]
            rw [Finset.sum_comm]
            refine Finset.sum_eq_zero fun β _ => ?_
            rw [← Finset.sum_mul, hu_v β, zero_mul]
          rw [h_van, sub_zero]
        rw [← h1]
        simp_rw [hQ_decomp _ m_idx, map_sum, map_mul, Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun j _ => ?_
        dsimp only [t_ker]
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun m₀ _ => by ring
      let Idx₂ := (Fin ν' × Fin N) ⊕ Fin ν' ⊕ Fin (N - d)
      let t₂ : Idx₂ → L
        | Sum.inl p => w (r_s p.1, α₀.succAbove p.2)
        | Sum.inr (Sum.inl s) => lam s
        | Sum.inr (Sum.inr j) => t_ker j
      let Φ₂ : MvPolynomial Idx₂ F →ₐ[F] L := MvPolynomial.aeval t₂
      have hw_rs_mem : ∀ (s : Fin ν') (m_idx : Fin N),
          w (r_s s, α₀.succAbove m_idx) ∈ Φ₂.range :=
        fun s m_idx => ⟨MvPolynomial.X (Sum.inl (s, m_idx)), MvPolynomial.aeval_X t₂ _⟩
      have hlam_mem : ∀ s : Fin ν', lam s ∈ Φ₂.range :=
        fun s => ⟨MvPolynomial.X (Sum.inr (Sum.inl s)), MvPolynomial.aeval_X t₂ _⟩
      have htker_mem : ∀ j : Fin (N - d), t_ker j ∈ Φ₂.range :=
        fun j => ⟨MvPolynomial.X (Sum.inr (Sum.inr j)), MvPolynomial.aeval_X t₂ _⟩
      have hu_mem : ∀ m_idx : Fin N, u_vec m_idx ∈ Φ₂.range := by
        intro m_idx
        rw [hu_eq m_idx]
        exact sum_mem fun j _ => mul_mem (htker_mem j) (Φ₂.range.algebraMap_mem _)
      have hw_r0_mem : ∀ m_idx : Fin N, w (r₀, α₀.succAbove m_idx) ∈ Φ₂.range := by
        intro m_idx
        have h_add : w (r₀, α₀.succAbove m_idx) =
            u_vec m_idx + ∑ s : Fin ν', lam s * w (r_s s, α₀.succAbove m_idx) := by
          dsimp only [u_vec]; ring
        rw [h_add]
        exact add_mem (hu_mem m_idx)
          (sum_mem fun s _ => mul_mem (hlam_mem s) (hw_rs_mem s m_idx))
      have hw_succ_mem : ∀ (r : Fin ν) (m_idx : Fin N),
          w (r, α₀.succAbove m_idx) ∈ Φ₂.range := by
        intro r m_idx
        have hr : r = e_ν (e_ν.symm r) := (e_ν.apply_symm_apply r).symm
        rw [hr]
        refine Fin.succAboveCases p₀ ?_ ?_ (e_ν.symm r)
        · rw [hp₀]; exact hw_r0_mem m_idx
        · intro s; exact hw_rs_mem s m_idx
      have h_le₂ : Algebra.adjoin F (Set.range w) ≤ Φ₂.range := by
        rw [Algebra.adjoin_le_iff]
        rintro _ ⟨⟨r, μ⟩, rfl⟩
        refine Fin.succAboveCases α₀ ?_ ?_ μ
        · have h0 : w (r, α₀) =
              - ∑ m_idx : Fin N, algebraMap F L (x_tilde m_idx) * w (r, α₀.succAbove m_idx) :=
            eq_neg_of_add_eq_zero_left (hInc r)
          rw [h0]
          exact neg_mem (sum_mem fun m_idx _ =>
            mul_mem (Φ₂.range.algebraMap_mem (x_tilde m_idx)) (hw_succ_mem r m_idx))
        · intro m_idx; exact hw_succ_mem r m_idx
      have h_res₂ := h_trdeg_from_gen t₂ (Algebra.adjoin F (Set.range w)) h_le₂ hFrac
      have h_card₂ : Fintype.card Idx₂ = (ν - 1) * (N + 1) + (N - d) := by
        dsimp only [Idx₂, ν']
        simp only [Fintype.card_sum, Fintype.card_prod, Fintype.card_fin]
        ring
      rwa [h_card₂] at h_res₂

  
  have h_s7 : ∀ (N ν B : ℕ),
      B < ν * (N + 1) →
      ∀ (R : Type u) [CommRing R] (κ : k →+* R)
        (S_gen : Set (MvPolynomial (Fin ν × Fin (N + 1)) R)),
      (∀ (F_p L : Type u) [Field F_p] [Field L] [Algebra k F_p] [Algebra k L]
          [Algebra F_p L] [IsScalarTower k F_p L] (σ_Fp : R →+* F_p)
          (w : Fin ν × Fin (N + 1) → L),
        (∀ a : k, σ_Fp (κ a) = algebraMap k F_p a) →
        (∀ z : F_p, ∃ u v : R, σ_Fp v ≠ 0 ∧ z * σ_Fp v = σ_Fp u) →
        (∀ g ∈ S_gen, MvPolynomial.eval₂ ((algebraMap F_p L).comp σ_Fp) w g = 0) →
        (∀ z : L, ∃ x y : ↥(Algebra.adjoin F_p (Set.range w)), z = (x : L) / (y : L)) →
        Algebra.trdeg k L ≤ (B : Cardinal.{u})) →
      ∃ Δ : MvPolynomial (Fin ν × Fin (N + 1)) k,
        Δ ≠ 0 ∧
        ∀ (c : Fin ν × Fin (N + 1) → k) (𝔭 : PrimeSpectrum R),
          MvPolynomial.eval c Δ ≠ 0 →
          ∃ g ∈ S_gen, MvPolynomial.eval (κ ∘ c) g ∉ 𝔭.asIdeal := by
    intro N ν B hB R _ κ S_gen hTower
    let σ_var := Fin ν × Fin (N + 1)
    let P_C := MvPolynomial σ_var k
    let R_SC := MvPolynomial σ_var R
    let ι_PC : P_C →+* R_SC := MvPolynomial.map κ
    let I_bad : Ideal R_SC := Ideal.span S_gen
    let M_SC : Submonoid R_SC := (nonZeroDivisors P_C).map ι_PC
    have h_trdeg_lower : ∀ (K : Type u) [Field K] [Algebra k K]
        (ψ_PC : P_C →ₐ[k] K), Function.Injective ψ_PC →
        ((ν * (N + 1) : ℕ) : Cardinal.{u}) ≤ Algebra.trdeg k K := by
      intro K _ _ ψ_PC hInj
      have h1 := trdeg_le_of_injective ψ_PC hInj
      rw [MvPolynomial.trdeg_of_isDomain] at h1
      have hcard : Cardinal.lift.{u, 0} (Cardinal.mk σ_var) =
          ((ν * (N + 1) : ℕ) : Cardinal.{u}) := by simp [σ_var]
      rwa [hcard] at h1
    have h_not_disj : ¬ Disjoint (I_bad : Set R_SC) (M_SC : Set R_SC) := by
      intro hDisj
      obtain ⟨𝔓, h𝔓_prime, hI_le, h𝔓_disj⟩ := Ideal.exists_le_prime_disjoint I_bad M_SC hDisj
      let 𝔭₀ : Ideal R := Ideal.comap MvPolynomial.C 𝔓
      have _ : 𝔭₀.IsPrime := Ideal.IsPrime.comap MvPolynomial.C
      let D_p := R ⧸ 𝔭₀
      let D_P := R_SC ⧸ 𝔓
      let F_p := FractionRing D_p
      let L := FractionRing D_P
      let j_quot : D_p →+* D_P := Ideal.quotientMap 𝔓 MvPolynomial.C le_rfl
      have hj_inj : Function.Injective j_quot := Ideal.quotientMap_injective
      have hjL_inj : Function.Injective ((algebraMap D_P L).comp j_quot) :=
        (IsFractionRing.injective D_P L).comp hj_inj
      let i_FL : F_p →+* L := IsFractionRing.lift hjL_inj
      let σ_Fp : R →+* F_p := (algebraMap D_p F_p).comp (Ideal.Quotient.mk 𝔭₀)
      let θ_SC : R_SC →+* L := (algebraMap D_P L).comp (Ideal.Quotient.mk 𝔓)
      have h_comm_C : ∀ r : R, i_FL (σ_Fp r) = θ_SC (MvPolynomial.C r) := by
        intro r
        change IsFractionRing.lift hjL_inj (algebraMap D_p F_p (Ideal.Quotient.mk 𝔭₀ r)) = _
        rw [IsFractionRing.lift_algebraMap]
        rfl
      let _ : Algebra k F_p := (σ_Fp.comp κ).toAlgebra
      let _ : Algebra F_p L := i_FL.toAlgebra
      let _ : Algebra k L := (i_FL.comp (σ_Fp.comp κ)).toAlgebra
      have _ : IsScalarTower k F_p L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      let w : σ_var → L := fun idx => θ_SC (MvPolynomial.X idx)
      have h_eval_θ : MvPolynomial.eval₂Hom ((algebraMap F_p L).comp σ_Fp) w = θ_SC := by
        apply MvPolynomial.ringHom_ext
        · intro r
          rw [MvPolynomial.eval₂Hom_C]
          exact h_comm_C r
        · intro idx
          exact MvPolynomial.eval₂Hom_X' _ w idx
      have h_Fp_frac : ∀ z : F_p, ∃ u v : R, σ_Fp v ≠ 0 ∧ z * σ_Fp v = σ_Fp u := by
        intro z
        obtain ⟨⟨x_b, s_b⟩, h_eq⟩ := IsLocalization.surj (nonZeroDivisors D_p) z
        obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective x_b
        obtain ⟨v, hv⟩ := Ideal.Quotient.mk_surjective s_b.1
        have hs_ne : s_b.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s_b.2
        have hv_ne : σ_Fp v ≠ 0 := by
          change algebraMap D_p F_p (Ideal.Quotient.mk 𝔭₀ v) ≠ 0
          rw [hv]
          exact fun h0 => hs_ne ((injective_iff_map_eq_zero (algebraMap D_p F_p)).mp
            (IsFractionRing.injective D_p F_p) s_b.1 h0)
        refine ⟨u, v, hv_ne, ?_⟩
        change z * algebraMap D_p F_p (Ideal.Quotient.mk 𝔭₀ v) =
          algebraMap D_p F_p (Ideal.Quotient.mk 𝔭₀ u)
        rwa [hv]
      have h_Sgen_zero : ∀ g ∈ S_gen,
          MvPolynomial.eval₂ ((algebraMap F_p L).comp σ_Fp) w g = 0 := by
        intro g hg
        change MvPolynomial.eval₂Hom ((algebraMap F_p L).comp σ_Fp) w g = 0
        rw [DFunLike.congr_fun h_eval_θ g]
        change algebraMap D_P L (Ideal.Quotient.mk 𝔓 g) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (hI_le (Ideal.subset_span hg)), map_zero]
      have h_θ_mem : ∀ G : R_SC, θ_SC G ∈ Algebra.adjoin F_p (Set.range w) := by
        intro G
        induction G using MvPolynomial.induction_on with
        | C r =>
          rw [← h_comm_C r]
          exact Subalgebra.algebraMap_mem _ (σ_Fp r)
        | add p₁ p₂ hp₁ hp₂ =>
          rw [map_add]
          exact add_mem hp₁ hp₂
        | mul_X p idx hp =>
          rw [map_mul]
          exact mul_mem hp (Algebra.subset_adjoin ⟨idx, rfl⟩)
      have h_L_frac : ∀ z : L,
          ∃ x y : ↥(Algebra.adjoin F_p (Set.range w)), z = (x : L) / (y : L) := by
        intro z
        obtain ⟨⟨x_b, s_b⟩, h_eq⟩ := IsLocalization.surj (nonZeroDivisors D_P) z
        obtain ⟨G_x, rfl⟩ := Ideal.Quotient.mk_surjective x_b
        obtain ⟨G_s, hGs⟩ := Ideal.Quotient.mk_surjective s_b.1
        have hs_ne : s_b.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s_b.2
        have hθs_ne : θ_SC G_s ≠ 0 := by
          change algebraMap D_P L (Ideal.Quotient.mk 𝔓 G_s) ≠ 0
          rw [hGs]
          exact fun h0 => hs_ne ((injective_iff_map_eq_zero (algebraMap D_P L)).mp
            (IsFractionRing.injective D_P L) s_b.1 h0)
        refine ⟨⟨θ_SC G_x, h_θ_mem G_x⟩, ⟨θ_SC G_s, h_θ_mem G_s⟩, ?_⟩
        rw [eq_div_iff hθs_ne]
        change z * algebraMap D_P L (Ideal.Quotient.mk 𝔓 G_s) =
          algebraMap D_P L (Ideal.Quotient.mk 𝔓 G_x)
        rwa [hGs]
      have h_upper : Algebra.trdeg k L ≤ (B : Cardinal.{u}) :=
        hTower F_p L σ_Fp w (fun _ => rfl) h_Fp_frac h_Sgen_zero h_L_frac
      let ψ_PC : P_C →ₐ[k] L :=
        { toRingHom := θ_SC.comp ι_PC
          commutes' := fun a => by
            change θ_SC (MvPolynomial.map κ (MvPolynomial.C a)) = i_FL (σ_Fp (κ a))
            rw [MvPolynomial.map_C, h_comm_C] }
      have hψ_inj : Function.Injective ψ_PC := by
        rw [injective_iff_map_eq_zero]
        intro P hP0
        by_contra hP_ne
        have hP_nzd : P ∈ nonZeroDivisors P_C := mem_nonZeroDivisors_iff_ne_zero.mpr hP_ne
        have h_in_M : ι_PC P ∈ M_SC := ⟨P, hP_nzd, rfl⟩
        have h_mk0 : Ideal.Quotient.mk 𝔓 (ι_PC P) = 0 :=
          (injective_iff_map_eq_zero (algebraMap D_P L)).mp
            (IsFractionRing.injective D_P L) _ hP0
        have h_in_P : ι_PC P ∈ 𝔓 := Ideal.Quotient.eq_zero_iff_mem.mp h_mk0
        exact Set.disjoint_left.mp h𝔓_disj h_in_P h_in_M
      have h_lower := h_trdeg_lower L ψ_PC hψ_inj
      have h_le : (ν * (N + 1) : ℕ) ≤ B := Nat.cast_le.mp (h_lower.trans h_upper)
      omega
    rw [Set.not_disjoint_iff] at h_not_disj
    obtain ⟨_, hx_bad, ⟨Δ, hΔ_nzd, rfl⟩⟩ := h_not_disj
    have hΔ_ne : Δ ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hΔ_nzd
    refine ⟨Δ, hΔ_ne, fun c 𝔭 hc_ne => ?_⟩
    by_contra h_none
    push Not at h_none
    have h_le_p : I_bad ≤ Ideal.comap (MvPolynomial.eval (κ ∘ c)) 𝔭.asIdeal := by
      rw [Ideal.span_le]
      intro g hg
      exact h_none g hg
    have h_mem_p : MvPolynomial.eval (κ ∘ c) (ι_PC Δ) ∈ 𝔭.asIdeal := h_le_p hx_bad
    have h_eval_eq : MvPolynomial.eval (κ ∘ c) (ι_PC Δ) = κ (MvPolynomial.eval c Δ) := by
      change MvPolynomial.eval (κ ∘ c) (MvPolynomial.map κ Δ) = _
      rw [MvPolynomial.eval_map]
      exact (MvPolynomial.hom_eval₂ Δ (RingHom.id k) κ c).symm
    rw [h_eval_eq] at h_mem_p
    have h_unit : IsUnit (κ (MvPolynomial.eval c Δ)) :=
      (isUnit_iff_ne_zero.mpr hc_ne).map κ
    exact 𝔭.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem 𝔭.asIdeal h_mem_p h_unit)

  
  let d₀ : ℕ := 2 * m + 2
  have hSm_top : AlgebraicGeometry.SmoothOfRelativeDimension d₀
      ((⊤ : Z_bar.left.Opens).ι ≫ Z_bar.hom) :=
    Nat.zero_add d₀ ▸ inferInstance
  have hSlice0 : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ d₀ 0 Fin.elim0 :=
    (weil_algClosed_bertini_transversal_step k M).1 Z_bar ι_bar hCl ⊤ d₀ hSm_top
  obtain ⟨m_charts, α₀, V, hAffV, hVU, hVα, s, φ, q, f_lift0, x_coord, P_h, hCov, hCharts⟩ :=
    (weil_bertini_scheme_chart_cover_and_advance k M Z_bar ι_bar hCl ⊤ d₀ 0 Fin.elim0 hSlice0).1

  have hFrame : ∀ i : Fin m_charts,
      let R_i := ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))
      ∃ (Ψ : Fin M → MvPolynomial (Fin (s i + d₀)) k)
        (v : Matrix (Fin M) (Fin d₀) R_i)
        (U : Matrix (Fin d₀) (Fin M) R_i),
        (∀ m_idx : Fin M, (φ i) (Ψ m_idx) = x_coord i m_idx) ∧
        U * v = 1 ∧
        IsUnit (Matrix.det (Matrix.of fun a b : Fin (s i) =>
          (φ i) (MvPolynomial.pderiv (Fin.castAdd d₀ b) (q i a)))) ∧
        (∀ (c : Fin (M + 1) → k) (γ₀ : Fin d₀),
          Matrix.det (Matrix.of fun a b : Fin (s i + 1) =>
            (φ i) (MvPolynomial.pderiv
              (Fin.snoc (α := fun _ => Fin (s i + d₀)) (Fin.castAdd d₀) (Fin.natAdd (s i) γ₀) b)
              (Fin.snoc (α := fun _ => MvPolynomial (Fin (s i + d₀)) k) (q i)
                ((MvPolynomial.C (c (α₀ i)) : MvPolynomial (Fin (s i + d₀)) k) +
                  ∑ m_idx : Fin M,
                    (MvPolynomial.C (c ((α₀ i).succAbove m_idx)) :
                      MvPolynomial (Fin (s i + d₀)) k) * Ψ m_idx) a))) =
            Matrix.det (Matrix.of fun a b : Fin (s i) =>
              (φ i) (MvPolynomial.pderiv (Fin.castAdd d₀ b) (q i a))) *
              ∑ m_idx : Fin M,
                (φ i) (MvPolynomial.C (c ((α₀ i).succAbove m_idx))) * v m_idx γ₀) := by
    intro i
    let R_i := ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))
    obtain ⟨hSurj_i, _, hKer_i, _, _, hUnit_qadd_i, hUnit_Ph_i, hLoc_Ph_i, _, _⟩ := hCharts i
    obtain ⟨Ψ_i, v_i, U_quot, hΨ_i, hUv_quot, hSchur_raw⟩ :=
      weil_bertini_tangent_frame_and_schur_det k M (s i) 0 d₀ R_i (φ i) hSurj_i
        (q i) hKer_i (f_lift0 i) hUnit_qadd_i (α₀ i) (x_coord i) (P_h i) hUnit_Ph_i hLoc_Ph_i
    let I_0 : Ideal R_i := Ideal.span (Set.range (fun j : Fin 0 => (φ i) (f_lift0 i j)))
    have hI0_le : I_0 ≤ RingHom.ker (RingHom.id R_i) := by
      rw [Ideal.span_le]
      rintro _ ⟨j, _⟩
      exact Fin.elim0 j
    let π_inv : R_i ⧸ I_0 →+* R_i :=
      Ideal.Quotient.lift I_0 (RingHom.id R_i) (fun _ hx => hI0_le hx)
    let U_i : Matrix (Fin d₀) (Fin M) R_i := U_quot.map π_inv
    have hv_map : (v_i.map (Ideal.Quotient.mk I_0)).map π_inv = v_i := by
      ext m_idx γ; rfl
    have hUv_i : U_i * v_i = 1 := by
      calc U_i * v_i
          = U_quot.map π_inv * (v_i.map (Ideal.Quotient.mk I_0)).map π_inv := by rw [hv_map]
        _ = (U_quot * v_i.map (Ideal.Quotient.mk I_0)).map π_inv := by
            ext a b; exact (RingHom.map_matrix_mul _ _ a b π_inv).symm
        _ = (1 : Matrix (Fin d₀) (Fin d₀) (R_i ⧸ I_0)).map π_inv := by rw [hUv_quot]
        _ = 1 := Matrix.map_one π_inv (map_zero _) (map_one _)
    have hq_add : Fin.addCases (motive := fun _ => MvPolynomial (Fin (s i + d₀)) k)
        (q i) (f_lift0 i) = q i := by
      funext a
      have ha : a = Fin.castAdd 0 a := Fin.ext rfl
      conv_lhs => rw [ha]
      exact Fin.addCases_left a
    rw [hq_add] at hUnit_qadd_i hSchur_raw
    exact ⟨Ψ_i, v_i, U_i, hΨ_i, hUv_i, hUnit_qadd_i, hSchur_raw⟩

  let Ψ : ∀ i : Fin m_charts, Fin M → MvPolynomial (Fin (s i + d₀)) k :=
    fun i => Classical.choose (hFrame i)
  let v_frame : ∀ i : Fin m_charts,
      Matrix (Fin M) (Fin d₀) ↑(Z_bar.left.presheaf.obj (Opposite.op (V i))) :=
    fun i => Classical.choose (Classical.choose_spec (hFrame i))
  let U_frame : ∀ i : Fin m_charts,
      Matrix (Fin d₀) (Fin M) ↑(Z_bar.left.presheaf.obj (Opposite.op (V i))) :=
    fun i => Classical.choose (Classical.choose_spec (Classical.choose_spec (hFrame i)))
  have hFrame_spec : ∀ i : Fin m_charts,
      (∀ m_idx : Fin M, (φ i) (Ψ i m_idx) = x_coord i m_idx) ∧
      U_frame i * v_frame i = 1 ∧
      IsUnit (Matrix.det (Matrix.of fun a b : Fin (s i) =>
        (φ i) (MvPolynomial.pderiv (Fin.castAdd d₀ b) (q i a)))) ∧
      (∀ (c : Fin (M + 1) → k) (γ₀ : Fin d₀),
        Matrix.det (Matrix.of fun a b : Fin (s i + 1) =>
          (φ i) (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin (s i + d₀)) (Fin.castAdd d₀) (Fin.natAdd (s i) γ₀) b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin (s i + d₀)) k) (q i)
              ((MvPolynomial.C (c (α₀ i)) : MvPolynomial (Fin (s i + d₀)) k) +
                ∑ m_idx : Fin M,
                  (MvPolynomial.C (c ((α₀ i).succAbove m_idx)) :
                    MvPolynomial (Fin (s i + d₀)) k) * Ψ i m_idx) a))) =
          Matrix.det (Matrix.of fun a b : Fin (s i) =>
            (φ i) (MvPolynomial.pderiv (Fin.castAdd d₀ b) (q i a))) *
            ∑ m_idx : Fin M,
              (φ i) (MvPolynomial.C (c ((α₀ i).succAbove m_idx))) * v_frame i m_idx γ₀) :=
    fun i => Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hFrame i)))

  have hq_zero : ∀ (i : Fin m_charts) (a : Fin (s i)), (φ i) (q i a) = 0 := by
    intro i a
    rw [← RingHom.mem_ker, (hCharts i).2.2.1]
    exact Ideal.subset_span ⟨a, rfl⟩

  let G_inc : ∀ (i : Fin m_charts) (ν : ℕ),
      Fin ν → MvPolynomial (Fin ν × Fin (M + 1))
        ↑(Z_bar.left.presheaf.obj (Opposite.op (V i))) :=
    fun i ν r =>
      MvPolynomial.X (r, α₀ i) +
        ∑ m_idx : Fin M,
          MvPolynomial.C (x_coord i m_idx) *
            MvPolynomial.X (r, (α₀ i).succAbove m_idx)
  let G_minor : ∀ (i : Fin m_charts) (ν : ℕ),
      (Fin ν → Fin d₀) → MvPolynomial (Fin ν × Fin (M + 1))
        ↑(Z_bar.left.presheaf.obj (Opposite.op (V i))) :=
    fun i ν γ =>
      Matrix.det (Matrix.of fun r t : Fin ν =>
        ∑ m_idx : Fin M,
          MvPolynomial.C (v_frame i m_idx (γ t)) *
            MvPolynomial.X (r, (α₀ i).succAbove m_idx))

  have hElim_trans : ∀ (i : Fin m_charts) (ν : ℕ), 1 ≤ ν →
      ∃ Δ : MvPolynomial (Fin ν × Fin (M + 1)) k,
        Δ ≠ 0 ∧
        ∀ (c : Fin ν × Fin (M + 1) → k)
          (𝔭 : PrimeSpectrum ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))),
          MvPolynomial.eval c Δ ≠ 0 →
          (∀ r : Fin ν,
            MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ c) (G_inc i ν r) ∈ 𝔭.asIdeal) →
          ∃ γ : Fin ν → Fin d₀,
            MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ c) (G_minor i ν γ) ∉ 𝔭.asIdeal := by
    intro i ν hν
    let R_i := ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))
    let B := ν * (M + 1) - 1
    have hB : B < ν * (M + 1) :=
      Nat.sub_lt (Nat.mul_pos hν (Nat.succ_pos M)) zero_lt_one
    let S_gen : Set (MvPolynomial (Fin ν × Fin (M + 1)) R_i) :=
      Set.range (G_inc i ν) ∪ Set.range (G_minor i ν)
    obtain ⟨Δ, hΔ_ne, hΔ_prop⟩ :=
      h_s7 M ν B hB R_i ((φ i).comp MvPolynomial.C) S_gen fun F_p L _ _ _ _ _ _ σ_Fp w
          hκ hFp_frac hS_zero hL_frac => by
        have h_tr_Fp : Algebra.trdeg k F_p ≤ (d₀ : Cardinal.{u}) :=
          h_s5 (s i) d₀ R_i (φ i) (hCharts i).1 (q i) (hq_zero i) (hFrame_spec i).2.2.1
            F_p σ_Fp hκ hFp_frac
        let v_t : Matrix (Fin M) (Fin d₀) F_p := (v_frame i).map σ_Fp
        let U_t : Matrix (Fin d₀) (Fin M) F_p := (U_frame i).map σ_Fp
        let x_t : Fin M → F_p := fun m_idx => σ_Fp (x_coord i m_idx)
        have hUv_t : U_t * v_t = 1 := by
          ext a b
          change ((U_frame i).map σ_Fp * (v_frame i).map σ_Fp) a b = _
          rw [← RingHom.map_matrix_mul, (hFrame_spec i).2.1]
          simp [Matrix.one_apply, apply_ite σ_Fp]
        have hInc_w : ∀ r : Fin ν,
            w (r, α₀ i) +
              ∑ m_idx : Fin M, algebraMap F_p L (x_t m_idx) * w (r, (α₀ i).succAbove m_idx) = 0 := by
          intro r
          have h0 := hS_zero (G_inc i ν r) (Or.inl ⟨r, rfl⟩)
          change MvPolynomial.eval₂Hom ((algebraMap F_p L).comp σ_Fp) w (G_inc i ν r) = 0 at h0
          dsimp only [G_inc] at h0
          simpa [map_add, map_sum, map_mul, MvPolynomial.eval₂Hom_X',
            MvPolynomial.eval₂Hom_C, x_t] using h0
        have hMin_w : ∀ γ : Fin ν → Fin d₀,
            Matrix.det (Matrix.of fun r t : Fin ν =>
              ∑ m_idx : Fin M,
                w (r, (α₀ i).succAbove m_idx) * algebraMap F_p L (v_t m_idx (γ t))) = 0 := by
          intro γ
          have h0 := hS_zero (G_minor i ν γ) (Or.inr ⟨γ, rfl⟩)
          change MvPolynomial.eval₂Hom ((algebraMap F_p L).comp σ_Fp) w (G_minor i ν γ) = 0 at h0
          dsimp only [G_minor] at h0
          rw [RingHom.map_det] at h0
          rw [← h0]
          congr 1
          ext r t
          simp only [Matrix.of_apply, RingHom.mapMatrix_apply, Matrix.map_apply, map_sum,
            map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X', RingHom.comp_apply, v_t]
          exact Finset.sum_congr rfl fun m_idx _ => mul_comm _ _
        obtain ⟨hd_le, h_tr_L⟩ :=
          (h_s6 F_p L M (α₀ i) x_t).2 d₀ ν hν v_t U_t hUv_t w hInc_w hMin_w hL_frac
        have h_sum_le : Algebra.trdeg k L ≤
            ((d₀ + ((ν - 1) * (M + 1) + (M - d₀)) : ℕ) : Cardinal.{u}) := by
          rw [← trdeg_add_eq k F_p (A := L), Nat.cast_add]
          exact add_le_add h_tr_Fp h_tr_L
        have h_arith : d₀ + ((ν - 1) * (M + 1) + (M - d₀)) = B := by
          dsimp only [B]
          have h1 : d₀ + ((ν - 1) * (M + 1) + (M - d₀)) =
              (ν - 1) * (M + 1) + (d₀ + (M - d₀)) := by omega
          have h2 : d₀ + (M - d₀) = M := Nat.add_sub_of_le hd_le
          have h3 : ν * (M + 1) = (ν - 1) * (M + 1) + (M + 1) := by
            conv_lhs => rw [← Nat.sub_add_cancel hν, Nat.add_one_mul]
          rw [h1, h2, h3]
          omega
        rwa [h_arith] at h_sum_le
    refine ⟨Δ, hΔ_ne, fun c 𝔭 hc_ne hInc_mem => ?_⟩
    obtain ⟨g, hg_mem, hg_notMem⟩ := hΔ_prop c 𝔭 hc_ne
    rcases hg_mem with ⟨r, rfl⟩ | ⟨γ, rfl⟩
    · exact False.elim (hg_notMem (hInc_mem r))
    · exact ⟨γ, hg_notMem⟩

  have hElim_empty : ∀ (i : Fin m_charts), m = 0 →
      ∃ Δ : MvPolynomial (Fin 3 × Fin (M + 1)) k,
        Δ ≠ 0 ∧
        ∀ (c : Fin 3 × Fin (M + 1) → k)
          (𝔭 : PrimeSpectrum ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))),
          MvPolynomial.eval c Δ ≠ 0 →
          ∃ r : Fin 3,
            MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ c) (G_inc i 3 r) ∉ 𝔭.asIdeal := by
    intro i hm0
    let R_i := ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))
    let B := 3 * M + 2
    have hB : B < 3 * (M + 1) := by omega
    let S_gen : Set (MvPolynomial (Fin 3 × Fin (M + 1)) R_i) := Set.range (G_inc i 3)
    obtain ⟨Δ, hΔ_ne, hΔ_prop⟩ :=
      h_s7 M 3 B hB R_i ((φ i).comp MvPolynomial.C) S_gen fun F_p L _ _ _ _ _ _ σ_Fp w
          hκ hFp_frac hS_zero hL_frac => by
        have h_tr_Fp : Algebra.trdeg k F_p ≤ (d₀ : Cardinal.{u}) :=
          h_s5 (s i) d₀ R_i (φ i) (hCharts i).1 (q i) (hq_zero i) (hFrame_spec i).2.2.1
            F_p σ_Fp hκ hFp_frac
        let x_t : Fin M → F_p := fun m_idx => σ_Fp (x_coord i m_idx)
        have hInc_w : ∀ r : Fin 3,
            w (r, α₀ i) +
              ∑ m_idx : Fin M, algebraMap F_p L (x_t m_idx) * w (r, (α₀ i).succAbove m_idx) = 0 := by
          intro r
          have h0 := hS_zero (G_inc i 3 r) ⟨r, rfl⟩
          change MvPolynomial.eval₂Hom ((algebraMap F_p L).comp σ_Fp) w (G_inc i 3 r) = 0 at h0
          dsimp only [G_inc] at h0
          simpa [map_add, map_sum, map_mul, MvPolynomial.eval₂Hom_X',
            MvPolynomial.eval₂Hom_C, x_t] using h0
        have h_tr_L := (h_s6 F_p L M (α₀ i) x_t).1 3 w hInc_w hL_frac
        have h_sum_le : Algebra.trdeg k L ≤ ((d₀ + 3 * M : ℕ) : Cardinal.{u}) := by
          rw [← trdeg_add_eq k F_p (A := L), Nat.cast_add]
          exact add_le_add h_tr_Fp h_tr_L
        have h_d0_eq : d₀ + 3 * M = B := by dsimp [d₀, B]; omega
        rwa [h_d0_eq] at h_sum_le
    refine ⟨Δ, hΔ_ne, fun c 𝔭 hc_ne => ?_⟩
    obtain ⟨g, ⟨r, rfl⟩, hg_notMem⟩ := hΔ_prop c 𝔭 hc_ne
    exact ⟨r, hg_notMem⟩

  let Δ_t1 : Fin m_charts → MvPolynomial (Fin 1 × Fin (M + 1)) k :=
    fun i => Classical.choose (hElim_trans i 1 (le_refl 1))
  have hΔ_t1 : ∀ i : Fin m_charts,
      Δ_t1 i ≠ 0 ∧
      ∀ (c : Fin 1 × Fin (M + 1) → k)
        (𝔭 : PrimeSpectrum ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))),
        MvPolynomial.eval c (Δ_t1 i) ≠ 0 →
        (∀ r : Fin 1,
          MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ c) (G_inc i 1 r) ∈ 𝔭.asIdeal) →
        ∃ γ : Fin 1 → Fin d₀,
          MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ c) (G_minor i 1 γ) ∉ 𝔭.asIdeal :=
    fun i => Classical.choose_spec (hElim_trans i 1 (le_refl 1))

  let Δ_t2 : Fin m_charts → MvPolynomial (Fin 2 × Fin (M + 1)) k :=
    fun i => Classical.choose (hElim_trans i 2 (by decide))
  have hΔ_t2 : ∀ i : Fin m_charts,
      Δ_t2 i ≠ 0 ∧
      ∀ (c : Fin 2 × Fin (M + 1) → k)
        (𝔭 : PrimeSpectrum ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))),
        MvPolynomial.eval c (Δ_t2 i) ≠ 0 →
        (∀ r : Fin 2,
          MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ c) (G_inc i 2 r) ∈ 𝔭.asIdeal) →
        ∃ γ : Fin 2 → Fin d₀,
          MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ c) (G_minor i 2 γ) ∉ 𝔭.asIdeal :=
    fun i => Classical.choose_spec (hElim_trans i 2 (by decide))

  let Δ_t3 : Fin m_charts → MvPolynomial (Fin 3 × Fin (M + 1)) k :=
    fun i => Classical.choose (hElim_trans i 3 (by decide))
  have hΔ_t3 : ∀ i : Fin m_charts,
      Δ_t3 i ≠ 0 ∧
      ∀ (c : Fin 3 × Fin (M + 1) → k)
        (𝔭 : PrimeSpectrum ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))),
        MvPolynomial.eval c (Δ_t3 i) ≠ 0 →
        (∀ r : Fin 3,
          MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ c) (G_inc i 3 r) ∈ 𝔭.asIdeal) →
        ∃ γ : Fin 3 → Fin d₀,
          MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ c) (G_minor i 3 γ) ∉ 𝔭.asIdeal :=
    fun i => Classical.choose_spec (hElim_trans i 3 (by decide))

  let Δ_emp : ∀ i : Fin m_charts, m = 0 → MvPolynomial (Fin 3 × Fin (M + 1)) k :=
    fun i hm0 => Classical.choose (hElim_empty i hm0)
  have hΔ_emp : ∀ (i : Fin m_charts) (hm0 : m = 0),
      Δ_emp i hm0 ≠ 0 ∧
      ∀ (c : Fin 3 × Fin (M + 1) → k)
        (𝔭 : PrimeSpectrum ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))),
        MvPolynomial.eval c (Δ_emp i hm0) ≠ 0 →
        ∃ r : Fin 3,
          MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ c) (G_inc i 3 r) ∉ 𝔭.asIdeal :=
    fun i hm0 => Classical.choose_spec (hElim_empty i hm0)

  let ι₁₃ : Fin 1 × Fin (M + 1) → Fin 3 × Fin (M + 1) :=
    fun p => (⟨p.1.1, by omega⟩, p.2)
  have hι₁₃_inj : Function.Injective ι₁₃ := by
    rintro ⟨a₁, b₁⟩ ⟨a₂, b₂⟩ hpq
    have h₁ : (⟨a₁.1, by omega⟩ : Fin 3) = ⟨a₂.1, by omega⟩ := congrArg Prod.fst hpq
    have h₁' : a₁.1 = a₂.1 := congrArg (Fin.val : Fin 3 → ℕ) h₁
    have h₂ : b₁ = b₂ := congrArg Prod.snd hpq
    exact Prod.ext (Fin.ext h₁') h₂
  let ι₂₃ : Fin 2 × Fin (M + 1) → Fin 3 × Fin (M + 1) :=
    fun p => (p.1.castSucc, p.2)
  have hι₂₃_inj : Function.Injective ι₂₃ := by
    rintro ⟨a₁, b₁⟩ ⟨a₂, b₂⟩ hpq
    have h₁ : a₁.castSucc = a₂.castSucc := congrArg Prod.fst hpq
    have h₂ : b₁ = b₂ := congrArg Prod.snd hpq
    exact Prod.ext (Fin.castSucc_injective 2 h₁) h₂

  let Δ_chart : Fin m_charts → MvPolynomial (Fin 3 × Fin (M + 1)) k := fun i =>
    MvPolynomial.rename ι₁₃ (Δ_t1 i) *
      MvPolynomial.rename ι₂₃ (Δ_t2 i) *
      (if hm0 : m = 0 then Δ_emp i hm0 else Δ_t3 i)
  have hΔ_chart_ne : ∀ i : Fin m_charts, Δ_chart i ≠ 0 := by
    intro i
    have h1 : MvPolynomial.rename ι₁₃ (Δ_t1 i) ≠ 0 := fun h0 =>
      (hΔ_t1 i).1 (MvPolynomial.rename_injective ι₁₃ hι₁₃_inj (h0.trans (map_zero _).symm))
    have h2 : MvPolynomial.rename ι₂₃ (Δ_t2 i) ≠ 0 := fun h0 =>
      (hΔ_t2 i).1 (MvPolynomial.rename_injective ι₂₃ hι₂₃_inj (h0.trans (map_zero _).symm))
    have h3 : (if hm0 : m = 0 then Δ_emp i hm0 else Δ_t3 i) ≠ 0 := by
      split_ifs with hm0
      · exact (hΔ_emp i hm0).1
      · exact (hΔ_t3 i).1
    exact mul_ne_zero (mul_ne_zero h1 h2) h3

  let Δ_axis : MvPolynomial (Fin 3 × Fin (M + 1)) k := ∏ i : Fin m_charts, Δ_chart i
  have hΔ_axis_ne : Δ_axis ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ => hΔ_chart_ne i

  have hLin_homog : ∀ c : Fin (M + 1) → k,
      (∑ μ : Fin (M + 1), MvPolynomial.C (c μ) * MvPolynomial.X μ) ∈
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1 := by
    intro c
    refine Submodule.sum_mem _ fun μ _ => ?_
    rw [← MvPolynomial.smul_eq_C_mul]
    exact Submodule.smul_mem _ (c μ) (MvPolynomial.isHomogeneous_X k μ)

  have hHyp_to_Ginc : ∀ (i : Fin m_charts) (x : Z_bar.left) (hxV : x ∈ V i)
      (ν : ℕ) (c : Fin ν × Fin (M + 1) → k) (r : Fin ν),
      ι_bar.left.base x ∈
        weilProjHyperplaneSet k M
          (∑ μ : Fin (M + 1), MvPolynomial.C (c (r, μ)) * MvPolynomial.X μ) →
      MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ c) (G_inc i ν r) ∈
        ((hAffV i).primeIdealOf ⟨x, hxV⟩).asIdeal := by
    intro i x hxV ν c r hx_hyp
    have hmem := (hCharts i).2.2.2.2.2.2.2.2.2 ⟨x, hxV⟩
      (∑ μ : Fin (M + 1), MvPolynomial.C (c (r, μ)) * MvPolynomial.X μ)
      (hLin_homog (fun μ => c (r, μ)))
      (MvPolynomial.isHomogeneous_X k (α₀ i)) zero_lt_one hx_hyp
    rw [(hCharts i).2.2.2.2.2.2.2.2.1 (fun μ => c (r, μ))
      (hLin_homog (fun μ => c (r, μ)))
      (MvPolynomial.isHomogeneous_X k (α₀ i)) zero_lt_one] at hmem
    have hev : MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ c) (G_inc i ν r) =
        (φ i) (MvPolynomial.C (c (r, α₀ i))) +
          ∑ m_idx : Fin M,
            (φ i) (MvPolynomial.C (c (r, (α₀ i).succAbove m_idx))) * x_coord i m_idx := by
      dsimp only [G_inc]
      simp only [map_add, map_sum, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_C,
        Function.comp_apply, RingHom.comp_apply]
      congr 1
      exact Finset.sum_congr rfl fun m_idx _ => mul_comm _ _
    rwa [hev]

  have hAdvance : ∀ (ν_p d_p : ℕ) (hd_eq : ν_p + d_p = d₀) (hd_pos : 1 ≤ d_p)
      (ℓ_cur : Fin (ν_p + 1) × Fin (M + 1) → k)
      (F_prev : Fin ν_p → MvPolynomial (Fin (M + 1)) k)
      (F_new : MvPolynomial (Fin (M + 1)) k),
      (∀ j : Fin ν_p,
        F_prev j = ∑ μ : Fin (M + 1), MvPolynomial.C (ℓ_cur (j.castSucc, μ)) * MvPolynomial.X μ) →
      (F_new = ∑ μ : Fin (M + 1), MvPolynomial.C (ℓ_cur (Fin.last ν_p, μ)) * MvPolynomial.X μ) →
      (∀ (i : Fin m_charts)
          (𝔭 : PrimeSpectrum ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))),
        (∀ r : Fin (ν_p + 1),
          MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ ℓ_cur)
            (G_inc i (ν_p + 1) r) ∈ 𝔭.asIdeal) →
        ∃ γ : Fin (ν_p + 1) → Fin d₀,
          MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ ℓ_cur)
            (G_minor i (ν_p + 1) γ) ∉ 𝔭.asIdeal) →
      IsTransversalLinearSlice k M Z_bar ι_bar ⊤ d_p ν_p F_prev →
      IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (d_p - 1) (ν_p + 1) (Fin.snoc F_prev F_new) := by
    intro ν_p d_p hd_eq hd_pos ℓ_cur F_prev F_new hF_prev hF_new hMinor_ex hSl_prev
    have hFn_homog : F_new ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1 := by
      rw [hF_new]
      exact hLin_homog _
    refine (weil_bertini_scheme_chart_cover_and_advance k M Z_bar ι_bar hCl
      ⊤ d_p ν_p F_prev hSl_prev).2 hd_pos F_new hFn_homog ?_
    intro x hxU hxPrev hxNew
    obtain ⟨i, hxV⟩ := hCov x trivial (fun j => Fin.elim0 j)
    let 𝔭_x := (hAffV i).primeIdealOf ⟨x, hxV⟩
    have hInc_all : ∀ r : Fin (ν_p + 1),
        MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ ℓ_cur)
          (G_inc i (ν_p + 1) r) ∈ 𝔭_x.asIdeal := by
      intro r
      refine hHyp_to_Ginc i x hxV (ν_p + 1) ℓ_cur r ?_
      refine Fin.lastCases ?_ ?_ r
      · rw [← hF_new]; exact hxNew
      · intro j; rw [← hF_prev j]; exact hxPrev j
    obtain ⟨γ, hγ_notMem⟩ := hMinor_ex i 𝔭_x hInc_all
    let M_minor : Matrix (Fin (ν_p + 1)) (Fin (ν_p + 1))
        ↑(Z_bar.left.presheaf.obj (Opposite.op (V i))) :=
      Matrix.of fun r t =>
        ∑ m_idx : Fin M,
          (φ i) (MvPolynomial.C (ℓ_cur (r, (α₀ i).succAbove m_idx))) *
            v_frame i m_idx (γ t)
    have hMinor_det_eq :
        MvPolynomial.eval (((φ i).comp MvPolynomial.C) ∘ ℓ_cur) (G_minor i (ν_p + 1) γ) =
          M_minor.det := by
      dsimp only [G_minor, M_minor]
      rw [RingHom.map_det]
      congr 1
      ext r t
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, map_sum,
        map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, Function.comp_apply,
        RingHom.comp_apply]
      exact Finset.sum_congr rfl fun m_idx _ => mul_comm _ _
    rw [hMinor_det_eq] at hγ_notMem
    have hγ_inj : Function.Injective γ := by
      intro t₁ t₂ ht_eq
      by_contra hne
      have hdet0 : M_minor.det = 0 :=
        Matrix.det_zero_of_column_eq hne fun r => by simp [M_minor, ht_eq]
      rw [hdet0] at hγ_notMem
      exact hγ_notMem (Ideal.zero_mem _)
    obtain ⟨φ', q', f_lift', f_new_lift', γ₀', hSurj', hCompC', hKer',
      hf_lift', hf_new', hUnit_q', hDet_aug'⟩ :=
      h_s4 M (s i) d₀ ν_p d_p hd_eq hd_pos _ (φ i) (hCharts i).1 (q i) (hCharts i).2.2.1
        (hFrame_spec i).2.2.1 (α₀ i) (Ψ i) (v_frame i) (hFrame_spec i).2.2.2
        (fun r μ => ℓ_cur (r, μ)) γ hγ_inj
    refine ⟨α₀ i, V i, hAffV i, hxV, hVU i, hVα i, s i, φ', q', f_lift', f_new_lift', γ₀',
      hSurj', ?_, hKer', ?_, ?_, hUnit_q', ?_⟩
    · have h_map_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ') ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ i)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        exact congrArg AlgebraicGeometry.Spec.map (CommRingCat.Hom.ext hCompC')
      rw [h_map_eq]
      exact (hCharts i).2.1
    · intro j hFj hXα hpos
      rw [hf_lift' j]
      simp only [map_add, map_sum, map_mul, (hFrame_spec i).1]
      have hFj' : (∑ a : Fin (M + 1), MvPolynomial.C (ℓ_cur (j.castSucc, a)) * MvPolynomial.X a) ∈
          MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1 := by
        rwa [← hF_prev j]
      have h_lin := (hCharts i).2.2.2.2.2.2.2.2.1 (fun a => ℓ_cur (j.castSucc, a)) hFj' hXα hpos
      rw [← h_lin]
      have h_num : (⟨∑ a : Fin (M + 1),
          MvPolynomial.C (ℓ_cur (j.castSucc, a)) * MvPolynomial.X a, hFj'⟩ :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)) = ⟨F_prev j, hFj⟩ :=
        Subtype.ext (hF_prev j).symm
      rw [h_num]
    · intro hFn hXα hpos
      rw [hf_new']
      simp only [map_add, map_sum, map_mul, (hFrame_spec i).1]
      have hFn' : (∑ a : Fin (M + 1),
          MvPolynomial.C (ℓ_cur (Fin.last ν_p, a)) * MvPolynomial.X a) ∈
          MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1 := by
        rwa [← hF_new]
      have h_lin := (hCharts i).2.2.2.2.2.2.2.2.1 (fun a => ℓ_cur (Fin.last ν_p, a)) hFn' hXα hpos
      rw [← h_lin]
      have h_num : (⟨∑ a : Fin (M + 1),
          MvPolynomial.C (ℓ_cur (Fin.last ν_p, a)) * MvPolynomial.X a, hFn'⟩ :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)) = ⟨F_new, hFn⟩ :=
        Subtype.ext hF_new.symm
      rw [h_num]
    · rw [hDet_aug']
      have hDq_notMem : Matrix.det (Matrix.of fun a b : Fin (s i) =>
          (φ i) (MvPolynomial.pderiv (Fin.castAdd d₀ b) (q i a))) ∉ 𝔭_x.asIdeal :=
        fun hmem => 𝔭_x.isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem 𝔭_x.asIdeal hmem (hFrame_spec i).2.2.1)
      exact 𝔭_x.isPrime.mul_notMem hDq_notMem hγ_notMem

  refine ⟨Δ_axis, hΔ_axis_ne, ?_⟩
  intro ℓ hℓ_ne L
  have hℓ_chart : ∀ i : Fin m_charts, MvPolynomial.eval ℓ (Δ_chart i) ≠ 0 := by
    rw [map_prod, Finset.prod_ne_zero_iff] at hℓ_ne
    exact fun i => hℓ_ne i (Finset.mem_univ i)
  have hℓ_t1 : ∀ i : Fin m_charts, MvPolynomial.eval (ℓ ∘ ι₁₃) (Δ_t1 i) ≠ 0 := by
    intro i
    have hi := hℓ_chart i
    dsimp only [Δ_chart] at hi
    rw [map_mul, map_mul, MvPolynomial.eval_rename] at hi
    exact left_ne_zero_of_mul (left_ne_zero_of_mul hi)
  have hℓ_t2 : ∀ i : Fin m_charts, MvPolynomial.eval (ℓ ∘ ι₂₃) (Δ_t2 i) ≠ 0 := by
    intro i
    have hi := hℓ_chart i
    dsimp only [Δ_chart] at hi
    rw [map_mul, map_mul, MvPolynomial.eval_rename, MvPolynomial.eval_rename] at hi
    exact right_ne_zero_of_mul (left_ne_zero_of_mul hi)
  have hℓ_third : ∀ i : Fin m_charts,
      MvPolynomial.eval ℓ (if hm0 : m = 0 then Δ_emp i hm0 else Δ_t3 i) ≠ 0 := by
    intro i
    have hi := hℓ_chart i
    dsimp only [Δ_chart] at hi
    rw [map_mul] at hi
    exact right_ne_zero_of_mul hi

  have hSl_1_raw : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m + 1) 1
      (Fin.snoc Fin.elim0 (L 0)) :=
    hAdvance 0 (2 * m + 2) (Nat.zero_add _) (by omega) (ℓ ∘ ι₁₃) Fin.elim0 (L 0)
      (fun j => Fin.elim0 j) rfl
      (fun i 𝔭 hInc => (hΔ_t1 i).2 (ℓ ∘ ι₁₃) 𝔭 (hℓ_t1 i) hInc)
      hSlice0
  have hSnoc_1 : Fin.snoc (Fin.elim0 : Fin 0 → MvPolynomial (Fin (M + 1)) k) (L 0) = ![L 0] := by
    funext j; fin_cases j; rfl
  rw [hSnoc_1] at hSl_1_raw

  have hSl_2_raw : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m) 2
      (Fin.snoc ![L 0] (L 1)) :=
    hAdvance 1 (2 * m + 1) (by dsimp [d₀]; omega) (by omega) (ℓ ∘ ι₂₃) ![L 0] (L 1)
      (fun j => by fin_cases j; rfl) rfl
      (fun i 𝔭 hInc => (hΔ_t2 i).2 (ℓ ∘ ι₂₃) 𝔭 (hℓ_t2 i) hInc)
      hSl_1_raw
  have hSnoc_2 : Fin.snoc ![L 0] (L 1) = ![L 0, L 1] := by
    funext j; fin_cases j <;> rfl
  rw [hSnoc_2] at hSl_2_raw

  refine ⟨hSl_2_raw, ?_, ?_⟩
  · intro hm0 z
    obtain ⟨i, hzV⟩ := hCov z trivial (fun j => Fin.elim0 j)
    have h_emp_ne : MvPolynomial.eval ℓ (Δ_emp i hm0) ≠ 0 := by
      have h3 := hℓ_third i
      simpa only [hm0, ↓reduceDIte] using h3
    obtain ⟨r, hr_notMem⟩ := (hΔ_emp i hm0).2 ℓ ((hAffV i).primeIdealOf ⟨z, hzV⟩) h_emp_ne
    refine ⟨r, fun hz_hyp => hr_notMem ?_⟩
    exact hHyp_to_Ginc i z hzV 3 ℓ r hz_hyp
  · intro hm1
    have hm_ne : m ≠ 0 := by omega
    have hℓ_t3 : ∀ i : Fin m_charts, MvPolynomial.eval ℓ (Δ_t3 i) ≠ 0 := by
      intro i
      have h3 := hℓ_third i
      simpa only [hm_ne, ↓reduceDIte] using h3
    have hSl_3_raw : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m - 1) 3
        (Fin.snoc ![L 0, L 1] (L 2)) :=
      hAdvance 2 (2 * m) (by dsimp [d₀]; omega) (by omega) ℓ ![L 0, L 1] (L 2)
        (fun j => by fin_cases j <;> rfl) rfl
        (fun i 𝔭 hInc => (hΔ_t3 i).2 ℓ 𝔭 (hℓ_t3 i) hInc)
        hSl_2_raw
    have hSnoc_3 : Fin.snoc ![L 0, L 1] (L 2) = L := by
      funext j; fin_cases j <;> rfl
    rwa [hSnoc_3] at hSl_3_raw

theorem weil_algClosed_homog_irred_monic_separable_dehomog (k : Type u) [Field k] [IsAlgClosed k] (r D : ℕ) (hr : 2 ≤ r) (hD : 2 ≤ D)
    (P_amb : MvPolynomial (Fin (r + 2)) k)
    (hHomog : P_amb ∈ MvPolynomial.homogeneousSubmodule (Fin (r + 2)) k D)
    (hIrred : Irreducible P_amb) :
    ∃ (G : Fin (r + 2) → Fin (r + 2) → k) (c₀ : k)
      (f : Polynomial (MvPolynomial (Fin r) k)) (α : Fin D → k),
      c₀ ≠ 0 ∧
      Function.Injective α ∧
      let P₁ : MvPolynomial (Fin (r + 2)) k :=
        MvPolynomial.C c₀ *
          MvPolynomial.eval₂ MvPolynomial.C
            (fun μ : Fin (r + 2) =>
              ∑ ν : Fin (r + 2), MvPolynomial.C (G μ ν) * MvPolynomial.X ν)
            P_amb
      P₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (r + 2)) k D ∧
      MvPolynomial.eval (Pi.single 0 1) P₁ = 1 ∧
      Irreducible P₁ ∧
      f = MvPolynomial.eval₂ (Polynomial.C.comp MvPolynomial.C)
        (Fin.cons Polynomial.X
          (Fin.cons 1 (fun i : Fin r => Polynomial.C (MvPolynomial.X i))))
        P₁ ∧
      f.Monic ∧
      f.natDegree = D ∧
      (∀ A : Polynomial (MvPolynomial (Fin r) k),
        A.Monic → 1 ≤ A.natDegree → A.natDegree < D → ¬ (A ∣ f)) ∧
      Polynomial.map MvPolynomial.constantCoeff f =
        ∏ ν : Fin D, (Polynomial.X - Polynomial.C (α ν)) :=
by
  classical
  have _ := hr
  have _ : Infinite k := IsAlgClosed.instInfinite
  have hHom_sum : ∀ {d : ℕ} {F : MvPolynomial (Fin (r + 2)) k},
      F.IsHomogeneous d → ∀ {m : Fin (r + 2) →₀ ℕ}, F.coeff m ≠ 0 →
        (m.sum fun _ e => e) = d := by
    intro d F hF m hm
    have h1 := hF hm
    simpa [Finsupp.weight_apply, Finsupp.linearCombination_apply] using h1

  have hExistsEvalNeZero : ∀ {σ : Type} {F : MvPolynomial σ k},
      F ≠ 0 → ∃ x : σ → k, MvPolynomial.eval x F ≠ 0 := by
    intro σ F hF
    by_contra! h0
    exact hF (MvPolynomial.funext fun x => (h0 x).trans (map_zero _).symm)

  
  
  
  have hStep2 : ∀ (P : MvPolynomial (Fin (r + 2)) k),
      P.IsHomogeneous D →
      MvPolynomial.eval (Pi.single 0 1) P = 1 →
      Irreducible P →
      MvPolynomial.pderiv 0 P ≠ 0 →
      let f_raw : Polynomial (MvPolynomial (Fin r) k) :=
        MvPolynomial.eval₂ (Polynomial.C.comp MvPolynomial.C)
          (Fin.cons Polynomial.X
            (Fin.cons 1 (fun i : Fin r => Polynomial.C (MvPolynomial.X i))))
          P
      f_raw.Monic ∧
      f_raw.natDegree = D ∧
      Irreducible f_raw ∧
      Polynomial.derivative f_raw ≠ 0 := by
    clear P_amb hHomog hIrred
    intro P hPm_hom hPm_e0 hPm_irred hPm_pderiv
    let g_dehom : Fin (r + 2) → Polynomial (MvPolynomial (Fin r) k) :=
      Fin.cons Polynomial.X (Fin.cons 1 (fun i : Fin r => Polynomial.C (MvPolynomial.X i)))
    let dehom : MvPolynomial (Fin (r + 2)) k →+* Polynomial (MvPolynomial (Fin r) k) :=
      MvPolynomial.eval₂Hom (Polynomial.C.comp MvPolynomial.C) g_dehom
    change (dehom P).Monic ∧ (dehom P).natDegree = D ∧
      Irreducible (dehom P) ∧ Polynomial.derivative (dehom P) ≠ 0

    have hDehomMonomial : ∀ (m : Fin (r + 2) →₀ ℕ) (c : k),
        dehom (MvPolynomial.monomial m c) =
          Polynomial.monomial (m 0) (MvPolynomial.monomial (Finsupp.tail (Finsupp.tail m)) c) := by
      intro m c
      change MvPolynomial.eval₂ (Polynomial.C.comp MvPolynomial.C) g_dehom
          (MvPolynomial.monomial m c) = _
      rw [MvPolynomial.eval₂_monomial]
      simp only [RingHom.comp_apply]
      have hprod : (m.prod fun ν e => g_dehom ν ^ e) =
          Polynomial.C ((Finsupp.tail (Finsupp.tail m)).prod fun i e => MvPolynomial.X i ^ e) *
            Polynomial.X ^ m 0 := by
        rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_succ, Fin.prod_univ_succ]
        have hg0 : g_dehom 0 = Polynomial.X := rfl
        have hg1 : g_dehom (Fin.succ 0) = 1 := rfl
        have hgi : ∀ i : Fin r, g_dehom i.succ.succ = Polynomial.C (MvPolynomial.X i) :=
          fun _ => rfl
        have htail : ∀ i : Fin r, m i.succ.succ = Finsupp.tail (Finsupp.tail m) i :=
          fun _ => rfl
        rw [hg0, hg1, one_pow, one_mul, mul_comm (Polynomial.X ^ m 0)]
        congr 1
        rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _), map_prod]
        refine Finset.prod_congr rfl fun i _ => ?_
        rw [hgi i, htail i, map_pow]
      rw [hprod, ← mul_assoc, ← Polynomial.C_mul, ← MvPolynomial.monomial_eq,
        Polynomial.C_mul_X_pow_eq_monomial]

    let lift_d : ℕ → ℕ → (Fin r →₀ ℕ) → (Fin (r + 2) →₀ ℕ) :=
      fun d j n => Finsupp.cons j (Finsupp.cons (d - (j + (n.sum fun _ e => e))) n)
    have hLift_zero : ∀ d j n, (lift_d d j n) 0 = j := fun _ _ _ => Finsupp.cons_zero _ _
    have hLift_tail2 : ∀ d j n, Finsupp.tail (Finsupp.tail (lift_d d j n)) = n := by
      intro d j n
      ext i
      simp [lift_d]
    have hLift_sum : ∀ {d j : ℕ} {n : Fin r →₀ ℕ},
        j + (n.sum fun _ e => e) ≤ d → ((lift_d d j n).sum fun _ e => e) = d := by
      intro d j n hle
      dsimp [lift_d]
      rw [Finsupp.sum_cons, Finsupp.sum_cons]
      omega
    have hDecomp_sum : ∀ m : Fin (r + 2) →₀ ℕ,
        (m.sum fun _ e => e) =
          m 0 + (Finsupp.tail m 0 + ((Finsupp.tail (Finsupp.tail m)).sum fun _ e => e)) := by
      intro m
      conv_lhs => rw [← Finsupp.cons_tail m, ← Finsupp.cons_tail (Finsupp.tail m)]
      rw [Finsupp.sum_cons, Finsupp.sum_cons]

    have hDehomCoeffLE : ∀ {d : ℕ} {F : MvPolynomial (Fin (r + 2)) k},
        F.IsHomogeneous d → ∀ (j : ℕ) (n : Fin r →₀ ℕ),
          j + (n.sum fun _ e => e) ≤ d →
          ((dehom F).coeff j).coeff n = F.coeff (lift_d d j n) := by
      intro d F hF j n hle
      conv_lhs => rw [F.as_sum]
      rw [map_sum, Polynomial.finsetSum_coeff, MvPolynomial.coeff_sum]
      simp_rw [hDehomMonomial, Polynomial.coeff_monomial]
      rw [Finset.sum_eq_single (lift_d d j n)]
      · simp [hLift_zero, hLift_tail2]
      · intro m hm hne
        split_ifs with hm0
        · rw [MvPolynomial.coeff_monomial]
          split_ifs with hmtail
          · exfalso
            have hdeg : (m.sum fun _ e => e) = d :=
              hHom_sum hF (MvPolynomial.mem_support_iff.mp hm)
            rw [hDecomp_sum m, hm0, hmtail] at hdeg
            have hm1 : Finsupp.tail m 0 = d - (j + (n.sum fun _ e => e)) := by omega
            have hm_eq : m = lift_d d j n := by
              conv_lhs => rw [← Finsupp.cons_tail m, ← Finsupp.cons_tail (Finsupp.tail m)]
              rw [hm0, hm1, hmtail]
            exact hne hm_eq
          · rfl
        · simp
      · intro hnot
        simp only [hLift_zero, ↓reduceIte, hLift_tail2, MvPolynomial.coeff_monomial]
        exact MvPolynomial.notMem_support_iff.mp hnot

    have hDehomCoeffGT : ∀ {d : ℕ} {F : MvPolynomial (Fin (r + 2)) k},
        F.IsHomogeneous d → ∀ (j : ℕ) (n : Fin r →₀ ℕ),
          d < j + (n.sum fun _ e => e) →
          ((dehom F).coeff j).coeff n = 0 := by
      intro d F hF j n hgt
      conv_lhs => rw [F.as_sum]
      rw [map_sum, Polynomial.finsetSum_coeff, MvPolynomial.coeff_sum]
      simp_rw [hDehomMonomial, Polynomial.coeff_monomial]
      refine Finset.sum_eq_zero fun m hm => ?_
      split_ifs with hm0
      · rw [MvPolynomial.coeff_monomial]
        split_ifs with hmtail
        · exfalso
          have hdeg : (m.sum fun _ e => e) = d :=
            hHom_sum hF (MvPolynomial.mem_support_iff.mp hm)
          rw [hDecomp_sum m, hm0, hmtail] at hdeg
          omega
        · rfl
      · simp

    have hDehomInj : ∀ {d : ℕ} {F₁ F₂ : MvPolynomial (Fin (r + 2)) k},
        F₁.IsHomogeneous d → F₂.IsHomogeneous d → dehom F₁ = dehom F₂ → F₁ = F₂ := by
      intro d F₁ F₂ hF₁ hF₂ heq
      ext m
      by_cases hm : (m.sum fun _ e => e) = d
      · have h1 := hDecomp_sum m
        have hle : m 0 + (m.tail.tail.sum fun _ e => e) ≤ d := by omega
        have hm1 : Finsupp.tail m 0 = d - (m 0 + (m.tail.tail.sum fun _ e => e)) := by omega
        have hm_eq : m = lift_d d (m 0) m.tail.tail := by
          conv_lhs => rw [← Finsupp.cons_tail m, ← Finsupp.cons_tail (Finsupp.tail m)]
          dsimp [lift_d]
          rw [hm1]
        rw [hm_eq, ← hDehomCoeffLE hF₁ (m 0) m.tail.tail hle, heq,
          hDehomCoeffLE hF₂ (m 0) m.tail.tail hle]
      · have hc₁ : F₁.coeff m = 0 := by
          by_contra hne1
          exact hm (hHom_sum hF₁ hne1)
        have hc₂ : F₂.coeff m = 0 := by
          by_contra hne2
          exact hm (hHom_sum hF₂ hne2)
        rw [hc₁, hc₂]

    have hPm_coeff_D0 : P.coeff (Finsupp.single 0 D) = 1 := by
      have hev := hPm_e0
      conv at hev =>
        lhs
        rw [P.as_sum, map_sum]
      simp_rw [MvPolynomial.eval_monomial] at hev
      rw [Finset.sum_eq_single (Finsupp.single 0 D)] at hev
      · rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
          Finset.prod_eq_single (0 : Fin (r + 2))] at hev
        · simp only [Finsupp.single_eq_same, Pi.single_eq_same, one_pow, mul_one] at hev
          exact hev
        · intro κ _ hκ0
          rw [Finsupp.single_eq_of_ne hκ0, pow_zero]
        · intro habs; exact absurd (Finset.mem_univ _) habs
      · intro m hm hne
        have hdeg : (m.sum fun _ e => e) = D :=
          hHom_sum hPm_hom (MvPolynomial.mem_support_iff.mp hm)
        have hex : ∃ ν : Fin (r + 2), ν ≠ 0 ∧ m ν ≠ 0 := by
          by_contra! hall
          have hm_single : m = Finsupp.single 0 (m 0) := by
            ext ν
            by_cases hν : ν = 0
            · subst hν; simp
            · rw [hall ν hν, Finsupp.single_eq_of_ne hν]
          rw [hm_single, Finsupp.sum_single_index rfl] at hdeg
          rw [hm_single, hdeg] at hne
          exact hne rfl
        obtain ⟨ν, hν0, hmν⟩ := hex
        rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
        refine mul_eq_zero_of_right _ (Finset.prod_eq_zero (Finset.mem_univ ν) ?_)
        rw [Pi.single_eq_of_ne hν0, zero_pow hmν]
      · intro hnot
        rw [MvPolynomial.notMem_support_iff.mp hnot, zero_mul]

    have hf_raw_coeff_gt : ∀ j : ℕ, D < j → (dehom P).coeff j = 0 := by
      intro j hj
      ext n
      simpa using hDehomCoeffGT hPm_hom j n (by omega)
    have hf_raw_coeff_D : (dehom P).coeff D = 1 := by
      ext n
      by_cases hn : n = 0
      · subst hn
        have hle : D + ((0 : Fin r →₀ ℕ).sum fun _ e => e) ≤ D := by simp
        rw [hDehomCoeffLE hPm_hom D 0 hle]
        simp only [MvPolynomial.coeff_one, ↓reduceIte]
        have hlift_eq : lift_d D D 0 = Finsupp.single 0 D := by
          ext ν
          refine Fin.cases ?_ (fun ν' => Fin.cases ?_ (fun i => ?_) ν') ν
          · simp [lift_d]
          · change (Finsupp.cons D
                (Finsupp.cons (D - (D + ((0 : Fin r →₀ ℕ).sum fun _ e => e))) 0)) (Fin.succ 0) =
              (Finsupp.single 0 D) (Fin.succ 0)
            rw [Finsupp.cons_succ, Finsupp.cons_zero, Finsupp.single_apply]
            simp
          · change (Finsupp.cons D
                (Finsupp.cons (D - (D + ((0 : Fin r →₀ ℕ).sum fun _ e => e))) 0)) i.succ.succ =
              (Finsupp.single 0 D) i.succ.succ
            rw [Finsupp.cons_succ, Finsupp.cons_succ, Finsupp.zero_apply, Finsupp.single_apply]
            split_ifs with h0
            · exact absurd h0.symm (Fin.succ_ne_zero _)
            · rfl
        rw [hlift_eq, hPm_coeff_D0]
      · have hn_pos : 0 < (n.sum fun _ e => e) := by
          obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.mpr hn
          have hi_pos : 0 < n i := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hi)
          have hle_sum : n i ≤ (n.sum fun _ e => e) :=
            Finset.single_le_sum (fun _ _ => Nat.zero_le _) hi
          omega
        rw [hDehomCoeffGT hPm_hom D n (by omega), MvPolynomial.coeff_one]
        simp [Ne.symm hn]

    have hf_raw_deg_le : (dehom P).natDegree ≤ D :=
      Polynomial.natDegree_le_iff_coeff_eq_zero.mpr hf_raw_coeff_gt
    have hf_raw_deg : (dehom P).natDegree = D :=
      Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hf_raw_deg_le
        (by rw [hf_raw_coeff_D]; exact one_ne_zero)
    have hf_raw_monic : (dehom P).Monic := by
      rw [Polynomial.Monic, Polynomial.leadingCoeff, hf_raw_deg, hf_raw_coeff_D]

    have hDehomDeriv : ∀ F : MvPolynomial (Fin (r + 2)) k,
        Polynomial.derivative (dehom F) = dehom (MvPolynomial.pderiv 0 F) := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C a =>
        have hC : dehom (MvPolynomial.C a) = Polynomial.C (MvPolynomial.C a) := by
          simp [dehom]
        rw [hC, Polynomial.derivative_C, MvPolynomial.pderiv_C, map_zero]
      | add p q hp hq =>
        rw [map_add, Polynomial.derivative_add, hp, hq, map_add, map_add]
      | mul_X p ν ih =>
        have hX_deriv : Polynomial.derivative (dehom (MvPolynomial.X ν)) =
            dehom (MvPolynomial.pderiv 0 (MvPolynomial.X ν)) := by
          refine Fin.cases ?_ (fun ν' => Fin.cases ?_ (fun i => ?_) ν') ν
          · have hX0 : dehom (MvPolynomial.X 0) = Polynomial.X := by simp [dehom, g_dehom]
            rw [hX0, Polynomial.derivative_X, MvPolynomial.pderiv_X,
              Pi.single_eq_same, map_one]
          · have hX1 : dehom (MvPolynomial.X (Fin.succ 0)) = 1 := by simp [dehom, g_dehom]
            have h10 : (Fin.succ (0 : Fin (r + 1)) : Fin (r + 2)) ≠ 0 := Fin.succ_ne_zero 0
            rw [hX1, Polynomial.derivative_one, MvPolynomial.pderiv_X,
              Pi.single_eq_of_ne h10, map_zero]
          · have hXi : dehom (MvPolynomial.X i.succ.succ) = Polynomial.C (MvPolynomial.X i) := by
              simp [dehom, g_dehom]
            have hi0 : (i.succ.succ : Fin (r + 2)) ≠ 0 := Fin.succ_ne_zero _
            rw [hXi, Polynomial.derivative_C, MvPolynomial.pderiv_X,
              Pi.single_eq_of_ne hi0, map_zero]
        rw [map_mul, Polynomial.derivative_mul, ih, hX_deriv, MvPolynomial.pderiv_mul,
          map_add, map_mul, map_mul]
    have hf_raw_deriv : Polynomial.derivative (dehom P) ≠ 0 := by
      rw [hDehomDeriv]
      intro h0
      have hpderiv_hom : (MvPolynomial.pderiv 0 P).IsHomogeneous (D - 1) :=
        hPm_hom.pderiv
      have hzero_hom : (0 : MvPolynomial (Fin (r + 2)) k).IsHomogeneous (D - 1) :=
        MvPolynomial.isHomogeneous_zero (Fin (r + 2)) k (D - 1)
      have h_eq : MvPolynomial.pderiv 0 P = 0 :=
        hDehomInj hpderiv_hom hzero_hom (h0.trans (map_zero dehom).symm)
      exact hPm_pderiv h_eq

    let Ψ : Polynomial (MvPolynomial (Fin r) k) ≃ₐ[k] MvPolynomial (Option (Fin r)) k :=
      (MvPolynomial.optionEquivLeft k (Fin r)).symm
    have hΨ_coeff : ∀ (q : Polynomial (MvPolynomial (Fin r) k)) (j : ℕ) (n : Fin r →₀ ℕ),
        (Ψ q).coeff (Finsupp.optionElim j n) = (q.coeff j).coeff n := by
      intro q j n
      have h1 := MvPolynomial.optionEquivLeft_coeff_coeff k (Ψ q) j n
      rw [AlgEquiv.apply_symm_apply] at h1
      exact h1.symm
    have hΨ_f_raw_deg : (Ψ (dehom P)).totalDegree ≤ D := by
      rw [MvPolynomial.totalDegree]
      refine Finset.sup_le fun s hs => ?_
      have hs_ne : (Ψ (dehom P)).coeff s ≠ 0 := MvPolynomial.mem_support_iff.mp hs
      have hs_eq : Finsupp.optionElim (s none) s.some = s := Finsupp.optionElim_some s
      rw [← hs_eq, hΨ_coeff] at hs_ne
      have hle : s none + (s.some.sum fun _ e => e) ≤ D := by
        by_contra! hgt
        exact hs_ne (hDehomCoeffGT hPm_hom (s none) s.some hgt)
      have hsum_opt : (s.sum fun _ e => e) = s none + (s.some.sum fun _ e => e) :=
        Finsupp.sum_option_index s (fun _ e => e) (fun _ => rfl) (fun _ _ _ => rfl)
      omega
    have hΨ_monic_lower : ∀ {q : Polynomial (MvPolynomial (Fin r) k)},
        q.Monic → q.natDegree ≤ (Ψ q).totalDegree := by
      intro q hq
      let s₀ : Option (Fin r) →₀ ℕ := Finsupp.optionElim q.natDegree 0
      have hs₀_mem : s₀ ∈ (Ψ q).support := by
        rw [MvPolynomial.mem_support_iff, hΨ_coeff]
        have hq_lead : q.coeff q.natDegree = 1 := hq.leadingCoeff
        simp [hq_lead]
      have hle := MvPolynomial.le_totalDegree hs₀_mem
      have hs₀_none : s₀ none = q.natDegree := Finsupp.optionElim_apply_none _ _
      have hs₀_some : s₀.some = 0 := by
        ext i
        change s₀ (some i) = 0
        simp [s₀]
      have hsum_s₀ : (s₀.sum fun _ e => e) = q.natDegree := by
        rw [Finsupp.sum_option_index s₀ (fun _ e => e) (fun _ => rfl) (fun _ _ _ => rfl),
          hs₀_none, hs₀_some, Finsupp.sum_zero_index, add_zero]
      rwa [hsum_s₀] at hle
    have hΨ_term_le : ∀ {q : Polynomial (MvPolynomial (Fin r) k)} {j : ℕ} {n : Fin r →₀ ℕ},
        (q.coeff j).coeff n ≠ 0 →
        j + (n.sum fun _ e => e) ≤ (Ψ q).totalDegree := by
      intro q j n hne
      let s : Option (Fin r) →₀ ℕ := Finsupp.optionElim j n
      have hs_mem : s ∈ (Ψ q).support := by
        rw [MvPolynomial.mem_support_iff, hΨ_coeff]
        exact hne
      have hle := MvPolynomial.le_totalDegree hs_mem
      have hs_none : s none = j := Finsupp.optionElim_apply_none _ _
      have hs_some : s.some = n := by
        ext i
        change s (some i) = n i
        simp [s]
      have hsum_s : (s.sum fun _ e => e) = j + (n.sum fun _ e => e) := by
        rw [Finsupp.sum_option_index s (fun _ e => e) (fun _ => rfl) (fun _ _ _ => rfl),
          hs_none, hs_some]
      rwa [hsum_s] at hle

    let homog : ℕ → Polynomial (MvPolynomial (Fin r) k) → MvPolynomial (Fin (r + 2)) k :=
      fun d q =>
        ∑ j ∈ q.support,
          ∑ n ∈ (q.coeff j).support,
            MvPolynomial.monomial (lift_d d j n) ((q.coeff j).coeff n)
    have hHomog_isHom : ∀ {d : ℕ} {q : Polynomial (MvPolynomial (Fin r) k)},
        (∀ j : ℕ, ∀ n ∈ (q.coeff j).support, j + (n.sum fun _ e => e) ≤ d) →
        (homog d q).IsHomogeneous d := by
      intro d q hbound
      change homog d q ∈ MvPolynomial.homogeneousSubmodule (Fin (r + 2)) k d
      refine Submodule.sum_mem _ fun j _ => Submodule.sum_mem _ fun n hn => ?_
      intro m hm
      rw [MvPolynomial.coeff_monomial] at hm
      split_ifs at hm with h_eq
      · subst h_eq
        simpa [Finsupp.weight_apply, Finsupp.linearCombination_apply] using
          hLift_sum (hbound j n hn)
      · exact absurd rfl hm
    have hDehom_homog : ∀ (d : ℕ) (q : Polynomial (MvPolynomial (Fin r) k)),
        dehom (homog d q) = q := by
      intro d q
      ext j n
      dsimp [homog]
      rw [map_sum, Polynomial.finsetSum_coeff]
      simp_rw [map_sum, hDehomMonomial, hLift_zero, hLift_tail2,
        ← map_sum (Polynomial.monomial _), ← (q.coeff _).as_sum, Polynomial.coeff_monomial]
      by_cases hj : j ∈ q.support
      · rw [Finset.sum_eq_single j]
        · simp
        · intro j' _ hj'
          simp [hj']
        · intro hnot
          exact absurd hj hnot
      · rw [Finset.sum_eq_zero]
        · rw [Polynomial.notMem_support_iff.mp hj]
        · intro j' hj'
          have hne : j' ≠ j := fun heq => hj (heq ▸ hj')
          simp [hne]

    have hf_raw_ne_one : dehom P ≠ 1 := by
      intro h1
      have hdeg1 := congrArg Polynomial.natDegree h1
      rw [hf_raw_deg, Polynomial.natDegree_one] at hdeg1
      omega
    have hf_raw_irred : Irreducible (dehom P) := by
      rw [Polynomial.irreducible_of_monic hf_raw_monic hf_raw_ne_one]
      intro A Q hA_monic hQ_monic hAQ
      let d₁ := A.natDegree
      let d₂ := Q.natDegree
      have hd_sum : d₁ + d₂ = D := by
        rw [← hf_raw_deg, ← hAQ]
        exact (hA_monic.natDegree_mul hQ_monic).symm
      have hΨA_ne : Ψ A ≠ 0 := by
        intro h0
        exact hA_monic.ne_zero (Ψ.injective (h0.trans (map_zero Ψ).symm))
      have hΨQ_ne : Ψ Q ≠ 0 := by
        intro h0
        exact hQ_monic.ne_zero (Ψ.injective (h0.trans (map_zero Ψ).symm))
      have hdeg_mul : (Ψ A).totalDegree + (Ψ Q).totalDegree ≤ D := by
        rw [← MvPolynomial.totalDegree_mul_of_isDomain hΨA_ne hΨQ_ne, ← map_mul Ψ, hAQ]
        exact hΨ_f_raw_deg
      have hd₁_le : d₁ ≤ (Ψ A).totalDegree := hΨ_monic_lower hA_monic
      have hd₂_le : d₂ ≤ (Ψ Q).totalDegree := hΨ_monic_lower hQ_monic
      have hΨA_eq : (Ψ A).totalDegree = d₁ := by omega
      have hΨQ_eq : (Ψ Q).totalDegree = d₂ := by omega
      have hA_bound : ∀ j : ℕ, ∀ n ∈ (A.coeff j).support, j + (n.sum fun _ e => e) ≤ d₁ := by
        intro j n hn
        rw [← hΨA_eq]
        exact hΨ_term_le (MvPolynomial.mem_support_iff.mp hn)
      have hQ_bound : ∀ j : ℕ, ∀ n ∈ (Q.coeff j).support, j + (n.sum fun _ e => e) ≤ d₂ := by
        intro j n hn
        rw [← hΨQ_eq]
        exact hΨ_term_le (MvPolynomial.mem_support_iff.mp hn)
      let A_hom := homog d₁ A
      let Q_hom := homog d₂ Q
      have hAhom_hom : A_hom.IsHomogeneous d₁ := hHomog_isHom hA_bound
      have hQhom_hom : Q_hom.IsHomogeneous d₂ := hHomog_isHom hQ_bound
      have hProd_hom : (A_hom * Q_hom).IsHomogeneous D := by
        rw [← hd_sum]
        exact hAhom_hom.mul hQhom_hom
      have hDehom_prod : dehom (A_hom * Q_hom) = dehom P := by
        rw [map_mul, hDehom_homog d₁ A, hDehom_homog d₂ Q, hAQ]
      have hP_fac : P = A_hom * Q_hom :=
        (hDehomInj hProd_hom hPm_hom hDehom_prod).symm
      rcases hPm_irred.isUnit_or_isUnit hP_fac with huA | huQ
      · left
        have huA_dehom : IsUnit A := by
          rw [← hDehom_homog d₁ A]
          exact huA.map dehom
        exact hA_monic.natDegree_eq_zero.mp (Polynomial.natDegree_eq_zero_of_isUnit huA_dehom)
      · right
        have huQ_dehom : IsUnit Q := by
          rw [← hDehom_homog d₂ Q]
          exact huQ.map dehom
        exact hQ_monic.natDegree_eq_zero.mp (Polynomial.natDegree_eq_zero_of_isUnit huQ_dehom)

    exact ⟨hf_raw_monic, hf_raw_deg, hf_raw_irred, hf_raw_deriv⟩

  
  
  
  have hStep3 : ∀ (f_raw : Polynomial (MvPolynomial (Fin r) k)),
      f_raw.Monic →
      f_raw.natDegree = D →
      Irreducible f_raw →
      Polynomial.derivative f_raw ≠ 0 →
      ∃ (a : Fin r → k) (α : Fin D → k),
        Function.Injective α ∧
        let f : Polynomial (MvPolynomial (Fin r) k) :=
          Polynomial.map
            (MvPolynomial.eval₂Hom MvPolynomial.C
              (fun i : Fin r => MvPolynomial.X i + MvPolynomial.C (a i)))
            f_raw
        f.Monic ∧
        f.natDegree = D ∧
        (∀ A : Polynomial (MvPolynomial (Fin r) k),
          A.Monic → 1 ≤ A.natDegree → A.natDegree < D → ¬ (A ∣ f)) ∧
        Polynomial.map MvPolynomial.constantCoeff f =
          ∏ ν : Fin D, (Polynomial.X - Polynomial.C (α ν)) := by
    clear P_amb hHomog hIrred hStep2 hHom_sum
    intro f_raw hf_raw_monic hf_raw_deg hf_raw_irred hf_raw_deriv
    have hInjBK : Function.Injective
        (algebraMap (MvPolynomial (Fin r) k) (FractionRing (MvPolynomial (Fin r) k))) :=
      IsFractionRing.injective (MvPolynomial (Fin r) k) (FractionRing (MvPolynomial (Fin r) k))
    let f_K : Polynomial (FractionRing (MvPolynomial (Fin r) k)) :=
      Polynomial.map
        (algebraMap (MvPolynomial (Fin r) k) (FractionRing (MvPolynomial (Fin r) k))) f_raw
    have hf_K_irred : Irreducible f_K :=
      (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map hf_raw_monic).mp hf_raw_irred
    have hf_K_deriv : Polynomial.derivative f_K ≠ 0 := by
      dsimp [f_K]
      rw [Polynomial.derivative_map]
      intro h0
      exact hf_raw_deriv (Polynomial.map_injective _ hInjBK
        (h0.trans (Polynomial.map_zero _).symm))
    have hf_K_sep : f_K.Separable :=
      (Polynomial.separable_iff_derivative_ne_zero hf_K_irred).mpr hf_K_deriv
    obtain ⟨u_K, v_K, huv_K⟩ := (Polynomial.separable_def' f_K).mp hf_K_sep

    have hClearDen : ∀ q_K : Polynomial (FractionRing (MvPolynomial (Fin r) k)),
        ∃ (b : MvPolynomial (Fin r) k) (Q : Polynomial (MvPolynomial (Fin r) k)), b ≠ 0 ∧
          Polynomial.map
            (algebraMap (MvPolynomial (Fin r) k) (FractionRing (MvPolynomial (Fin r) k))) Q =
          Polynomial.C
            (algebraMap (MvPolynomial (Fin r) k) (FractionRing (MvPolynomial (Fin r) k)) b) * q_K := by
      intro q_K
      refine Polynomial.induction_on' q_K ?_ ?_
      · intro p₁ p₂ ⟨b₁, Q₁, hb₁, hQ₁⟩ ⟨b₂, Q₂, hb₂, hQ₂⟩
        refine ⟨b₁ * b₂, Polynomial.C b₂ * Q₁ + Polynomial.C b₁ * Q₂, mul_ne_zero hb₁ hb₂, ?_⟩
        rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C,
          Polynomial.map_C, hQ₁, hQ₂, map_mul, Polynomial.C_mul]
        ring
      · intro j c_K
        obtain ⟨x, y, hy_mem, hxy⟩ :=
          IsFractionRing.div_surjective (A := MvPolynomial (Fin r) k) c_K
        have hy_ne : y ≠ 0 := nonZeroDivisors.ne_zero hy_mem
        have hy_K_ne :
            algebraMap (MvPolynomial (Fin r) k)
              (FractionRing (MvPolynomial (Fin r) k)) y ≠ 0 :=
          fun h0 => hy_ne (hInjBK (h0.trans (map_zero _).symm))
        have hmul_eq :
            algebraMap (MvPolynomial (Fin r) k)
              (FractionRing (MvPolynomial (Fin r) k)) x =
            algebraMap (MvPolynomial (Fin r) k)
              (FractionRing (MvPolynomial (Fin r) k)) y * c_K := by
          rw [← hxy, mul_div_cancel₀ _ hy_K_ne]
        refine ⟨y, Polynomial.monomial j x, hy_ne, ?_⟩
        rw [Polynomial.map_monomial, hmul_eq, ← Polynomial.C_mul_monomial]

    obtain ⟨b₁, U₀, hb₁_ne, hU₀⟩ := hClearDen u_K
    obtain ⟨b₂, V₀, hb₂_ne, hV₀⟩ := hClearDen v_K
    let Δ_den : MvPolynomial (Fin r) k := b₁ * b₂
    have hΔ_ne : Δ_den ≠ 0 := mul_ne_zero hb₁_ne hb₂_ne
    let U : Polynomial (MvPolynomial (Fin r) k) := Polynomial.C b₂ * U₀
    let V : Polynomial (MvPolynomial (Fin r) k) := Polynomial.C b₁ * V₀
    have hBezout : U * f_raw + V * Polynomial.derivative f_raw = Polynomial.C Δ_den := by
      apply Polynomial.map_injective _ hInjBK
      let ι := algebraMap (MvPolynomial (Fin r) k) (FractionRing (MvPolynomial (Fin r) k))
      change Polynomial.map ι (Polynomial.C b₂ * U₀ * f_raw +
          Polynomial.C b₁ * V₀ * Polynomial.derivative f_raw) =
        Polynomial.map ι (Polynomial.C (b₁ * b₂))
      simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
        ← Polynomial.derivative_map]
      rw [hU₀, hV₀, map_mul]
      have hcalc :
          Polynomial.C (ι b₂) * (Polynomial.C (ι b₁) * u_K) * f_K +
            Polynomial.C (ι b₁) * (Polynomial.C (ι b₂) * v_K) * Polynomial.derivative f_K =
          Polynomial.C (ι b₁ * ι b₂) * (u_K * f_K + v_K * Polynomial.derivative f_K) := by
        rw [Polynomial.C_mul]
        ring
      change Polynomial.C (ι b₂) * (Polynomial.C (ι b₁) * u_K) * f_K +
          Polynomial.C (ι b₁) * (Polynomial.C (ι b₂) * v_K) * Polynomial.derivative f_K =
        Polynomial.C (ι b₁ * ι b₂)
      rw [hcalc, huv_K, mul_one]

    obtain ⟨a, hδ₀⟩ := hExistsEvalNeZero hΔ_ne
    let τ_a : MvPolynomial (Fin r) k →+* MvPolynomial (Fin r) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C
        (fun i : Fin r => MvPolynomial.X i + MvPolynomial.C (a i))
    let τ_neg_a : MvPolynomial (Fin r) k →+* MvPolynomial (Fin r) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C
        (fun i : Fin r => MvPolynomial.X i - MvPolynomial.C (a i))
    have hτ_left : τ_neg_a.comp τ_a = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c; simp [τ_a, τ_neg_a]
      · intro i; simp [τ_a, τ_neg_a]
    have hτ_right : τ_a.comp τ_neg_a = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c; simp [τ_a, τ_neg_a]
      · intro i; simp [τ_a, τ_neg_a]
    let e_τ : MvPolynomial (Fin r) k ≃+* MvPolynomial (Fin r) k :=
      { τ_a with
        invFun := τ_neg_a
        left_inv := fun x => DFunLike.congr_fun hτ_left x
        right_inv := fun x => DFunLike.congr_fun hτ_right x }
    let e_poly : Polynomial (MvPolynomial (Fin r) k) ≃+* Polynomial (MvPolynomial (Fin r) k) :=
      Polynomial.mapEquiv e_τ
    let f : Polynomial (MvPolynomial (Fin r) k) := Polynomial.map τ_a f_raw

    have hf_monic : f.Monic := hf_raw_monic.map τ_a
    have hf_deg : f.natDegree = D := (hf_raw_monic.natDegree_map τ_a).trans hf_raw_deg
    have hf_irred : Irreducible f := by
      have hf_e : f = e_poly f_raw := by
        dsimp [f, e_poly]
        rw [Polynomial.mapEquiv_apply]
        congr 1
      rw [hf_e]
      exact (MulEquiv.irreducible_iff e_poly.toMulEquiv).mpr hf_raw_irred
    have hf_ndvd : ∀ A : Polynomial (MvPolynomial (Fin r) k),
        A.Monic → 1 ≤ A.natDegree → A.natDegree < D → ¬ (A ∣ f) := by
      intro A hA_monic hA_ge hA_lt ⟨Q, hfac⟩
      rcases hf_irred.isUnit_or_isUnit hfac with huA | huQ
      · have h0 := Polynomial.natDegree_eq_zero_of_isUnit huA
        omega
      · have hQ0 := Polynomial.natDegree_eq_zero_of_isUnit huQ
        have hA_ne : A ≠ 0 := hA_monic.ne_zero
        have hQ_ne : Q ≠ 0 := huQ.ne_zero
        have hdeg_eq := congrArg Polynomial.natDegree hfac
        rw [hf_deg, Polynomial.natDegree_mul hA_ne hQ_ne, hQ0, add_zero] at hdeg_eq
        omega

    let f₀ : Polynomial k := Polynomial.map MvPolynomial.constantCoeff f
    have hConst_comp_τ :
        (MvPolynomial.constantCoeff : MvPolynomial (Fin r) k →+* k).comp τ_a =
          MvPolynomial.eval a := by
      apply MvPolynomial.ringHom_ext
      · intro c; simp [τ_a]
      · intro i; simp [τ_a]
    have hf₀_eq_eval : f₀ = Polynomial.map (MvPolynomial.eval a) f_raw := by
      dsimp [f₀, f]
      rw [Polynomial.map_map, hConst_comp_τ]
    have hf₀_sep : f₀.Separable := by
      rw [Polynomial.separable_def']
      have hmap := congrArg (Polynomial.map (MvPolynomial.eval a)) hBezout
      have hmap2 :
          Polynomial.map (MvPolynomial.eval a) U * f₀ +
            Polynomial.map (MvPolynomial.eval a) V * Polynomial.derivative f₀ =
          Polynomial.C (MvPolynomial.eval a Δ_den) := by
        rw [hf₀_eq_eval, Polynomial.derivative_map]
        simpa only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C] using hmap
      let δ₀ : k := MvPolynomial.eval a Δ_den
      refine ⟨Polynomial.C δ₀⁻¹ * Polynomial.map (MvPolynomial.eval a) U,
        Polynomial.C δ₀⁻¹ * Polynomial.map (MvPolynomial.eval a) V, ?_⟩
      calc
        (Polynomial.C δ₀⁻¹ * Polynomial.map (MvPolynomial.eval a) U) * f₀ +
            (Polynomial.C δ₀⁻¹ * Polynomial.map (MvPolynomial.eval a) V) *
              Polynomial.derivative f₀
          = Polynomial.C δ₀⁻¹ *
              (Polynomial.map (MvPolynomial.eval a) U * f₀ +
                Polynomial.map (MvPolynomial.eval a) V * Polynomial.derivative f₀) := by ring
        _ = Polynomial.C δ₀⁻¹ * Polynomial.C δ₀ := by rw [hmap2]
        _ = 1 := by rw [← Polynomial.C_mul, inv_mul_cancel₀ hδ₀, map_one]

    have hf₀_monic : f₀.Monic := hf_monic.map MvPolynomial.constantCoeff
    have hf₀_deg : f₀.natDegree = D :=
      (hf_monic.natDegree_map MvPolynomial.constantCoeff).trans hf_deg
    have hf₀_splits : f₀.Splits := IsAlgClosed.splits f₀
    have hf₀_nodup : f₀.roots.Nodup :=
      (Polynomial.nodup_roots_iff_of_splits hf₀_monic.ne_zero hf₀_splits).mpr hf₀_sep
    have hf₀_card_deg : f₀.roots.card = f₀.natDegree :=
      (Polynomial.Splits.natDegree_eq_card_roots hf₀_splits).symm
    let S_roots : Finset k := f₀.roots.toFinset
    have hS_val : S_roots.val = f₀.roots := by
      dsimp [S_roots]
      exact (Multiset.toFinset_val _).trans (Multiset.dedup_eq_self.mpr hf₀_nodup)
    have hS_card : Fintype.card ↥S_roots = D := by
      rw [Fintype.card_coe, Finset.card_def, hS_val, hf₀_card_deg, hf₀_deg]
    let e_fin : Fin D ≃ ↥S_roots := (Fintype.equivFinOfCardEq hS_card).symm
    let α : Fin D → k := fun ν => (e_fin ν).1
    have hα_inj : Function.Injective α := Subtype.val_injective.comp e_fin.injective
    have hf₀_prod : f₀ = ∏ ν : Fin D, (Polynomial.X - Polynomial.C (α ν)) := by
      have hprod := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C hf₀_card_deg
      rw [hf₀_monic.leadingCoeff, map_one, one_mul] at hprod
      rw [← hprod, ← hS_val]
      change (Multiset.map (fun x => Polynomial.X - Polynomial.C x) S_roots.val).prod = _
      rw [← Finset.prod_eq_multiset_prod, ← Finset.prod_coe_sort S_roots]
      exact (Equiv.prod_comp e_fin (fun x : ↥S_roots => Polynomial.X - Polynomial.C x.1)).symm

    exact ⟨a, α, hα_inj, hf_monic, hf_deg, hf_ndvd, hf₀_prod⟩

  
  
  
  have hStep1 : ∃ (G₁ : Fin (r + 2) → Fin (r + 2) → k) (c₀ : k),
      c₀ ≠ 0 ∧
      let P_monic : MvPolynomial (Fin (r + 2)) k :=
        MvPolynomial.C c₀ *
          MvPolynomial.eval₂ MvPolynomial.C
            (fun μ : Fin (r + 2) =>
              ∑ ν : Fin (r + 2), MvPolynomial.C (G₁ μ ν) * MvPolynomial.X ν)
            P_amb
      P_monic.IsHomogeneous D ∧
      MvPolynomial.eval (Pi.single 0 1) P_monic = 1 ∧
      Irreducible P_monic ∧
      MvPolynomial.pderiv 0 P_monic ≠ 0 := by
    clear hStep2 hStep3
    have hP_hom : P_amb.IsHomogeneous D := hHomog
    have hExistsPderiv : ∃ μ₀ : Fin (r + 2), MvPolynomial.pderiv μ₀ P_amb ≠ 0 := by
      by_contra! hp0
      have hCoeffMulZero : ∀ m ∈ P_amb.support, ∀ μ : Fin (r + 2),
          (m μ : k) * P_amb.coeff m = 0 := by
        intro m hm μ
        have hLHS : (MvPolynomial.X μ * MvPolynomial.pderiv μ P_amb).coeff m = 0 := by
          rw [hp0 μ, mul_zero]
          simp
        have hRHS : (MvPolynomial.X μ * MvPolynomial.pderiv μ P_amb).coeff m =
            (m μ : k) * P_amb.coeff m := by
          conv_lhs => rw [P_amb.as_sum]
          rw [map_sum, Finset.mul_sum, MvPolynomial.coeff_sum]
          simp_rw [MvPolynomial.X_mul_pderiv_monomial, MvPolynomial.coeff_smul,
            MvPolynomial.coeff_monomial, nsmul_eq_mul]
          rw [Finset.sum_eq_single m]
          · simp
          · intro m' _ hm'
            simp [hm']
          · intro hnot
            exact absurd hm hnot
        exact hRHS.symm.trans hLHS
      have hCharDvd : ∀ m ∈ P_amb.support, ∀ μ : Fin (r + 2), ringChar k ∣ m μ := by
        intro m hm μ
        have hc_ne : P_amb.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
        have hm0 : (m μ : k) = 0 := (mul_eq_zero.mp (hCoeffMulZero m hm μ)).resolve_right hc_ne
        exact (ringChar.spec k (m μ)).mp hm0
      set p := ringChar k
      rcases eq_or_ne p 0 with hp | hp
      · obtain ⟨m₀, hm₀⟩ := MvPolynomial.support_nonempty.mpr hIrred.ne_zero
        have hm₀_eq : m₀ = 0 := by
          ext μ
          have hdvd := hCharDvd m₀ hm₀ μ
          rw [hp, zero_dvd_iff] at hdvd
          exact hdvd
        have hdeg := hHom_sum hP_hom (MvPolynomial.mem_support_iff.mp hm₀)
        rw [hm₀_eq, Finsupp.sum_zero_index] at hdeg
        omega
      · have _ : CharP k p := ringChar.charP k
        have hp_pos : 0 < p := Nat.pos_of_ne_zero hp
        have hp_prime : Nat.Prime p := (CharP.char_is_prime_or_zero k p).resolve_right hp
        have hp_ge2 : 2 ≤ p := hp_prime.two_le
        let _ : Fact (Nat.Prime p) := ⟨hp_prime⟩
        let _ : CharP (MvPolynomial (Fin (r + 2)) k) p := MvPolynomial.instCharP _ k p
        have hRoot : ∀ c : k, ∃ b : k, b ^ p = c := by
          intro c
          let q_c : Polynomial k := Polynomial.X ^ p - Polynomial.C c
          have hdeg : q_c.degree ≠ 0 := by
            dsimp [q_c]
            rw [Polynomial.degree_X_pow_sub_C hp_pos c]
            exact_mod_cast hp
          obtain ⟨b, hb⟩ := IsAlgClosed.exists_root q_c hdeg
          refine ⟨b, ?_⟩
          rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow,
            Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hb
          exact hb
        choose b hb using hRoot
        let m_div : (Fin (r + 2) →₀ ℕ) → (Fin (r + 2) →₀ ℕ) :=
          fun m => m.mapRange (· / p) (Nat.zero_div p)
        let Q : MvPolynomial (Fin (r + 2)) k :=
          ∑ m ∈ P_amb.support, MvPolynomial.monomial (m_div m) (b (P_amb.coeff m))
        have hQp : Q ^ p = P_amb := by
          dsimp [Q]
          rw [sum_pow_char p]
          conv_rhs => rw [P_amb.as_sum]
          refine Finset.sum_congr rfl fun m hm => ?_
          have hm_div_eq : p • m_div m = m := by
            ext μ
            change p * (m μ / p) = m μ
            exact Nat.mul_div_cancel' (hCharDvd m hm μ)
          rw [MvPolynomial.monomial_pow, hm_div_eq, hb (P_amb.coeff m)]
        have hfac : P_amb = Q ^ (p - 1) * Q := by
          rw [← hQp, ← pow_succ, Nat.sub_add_cancel (by omega : 1 ≤ p)]
        have hUnitQ : IsUnit Q := by
          rcases hIrred.isUnit_or_isUnit hfac with hu1 | hu2
          · exact (isUnit_pow_iff (by omega : p - 1 ≠ 0)).mp hu1
          · exact hu2
        have hUnitP : IsUnit P_amb := by
          rw [← hQp]
          exact hUnitQ.pow p
        exact hIrred.not_isUnit hUnitP

    obtain ⟨μ₀, hμ₀⟩ := hExistsPderiv
    obtain ⟨x₀, hx₀⟩ := hExistsEvalNeZero hμ₀
    let d_vec : Fin (r + 2) → k := fun μ => MvPolynomial.eval x₀ (MvPolynomial.pderiv μ P_amb)
    let L_dir : MvPolynomial (Fin (r + 2)) k :=
      ∑ μ : Fin (r + 2), MvPolynomial.C (d_vec μ) * MvPolynomial.X μ
    have hL_ne : L_dir ≠ 0 := by
      intro hL0
      have hev : MvPolynomial.eval (Pi.single μ₀ 1) L_dir = d_vec μ₀ := by
        simp [L_dir, Pi.single_apply]
      rw [hL0, map_zero] at hev
      exact hx₀ hev.symm
    obtain ⟨v, hv_prod⟩ := hExistsEvalNeZero (mul_ne_zero hIrred.ne_zero hL_ne)
    rw [map_mul] at hv_prod
    have hv_P : MvPolynomial.eval v P_amb ≠ 0 := left_ne_zero_of_mul hv_prod
    have hv_L : ∑ μ : Fin (r + 2), d_vec μ * v μ ≠ 0 := by
      have hev : MvPolynomial.eval v L_dir = ∑ μ : Fin (r + 2), d_vec μ * v μ := by
        simp [L_dir]
      rw [← hev]
      exact right_ne_zero_of_mul hv_prod
    have hv_ne_zero : v ≠ 0 := by
      intro hv0
      rw [hv0] at hv_P
      have h0_coeff : P_amb.coeff 0 = 0 := by
        by_contra h0_ne
        have hdeg := hHom_sum hP_hom h0_ne
        rw [Finsupp.sum_zero_index] at hdeg
        omega
      have hev0 : MvPolynomial.eval (0 : Fin (r + 2) → k) P_amb = P_amb.coeff 0 := by
        rw [MvPolynomial.eval_zero, MvPolynomial.constantCoeff_eq]
      exact hv_P (hev0.trans h0_coeff)
    obtain ⟨κ₀, hκ₀_raw⟩ := Function.ne_iff.mp hv_ne_zero
    have hκ₀ : v κ₀ ≠ 0 := hκ₀_raw

    let π : Equiv.Perm (Fin (r + 2)) := Equiv.swap 0 κ₀
    let G₁ : Fin (r + 2) → Fin (r + 2) → k := fun μ ν =>
      if μ = κ₀ then
        if ν = 0 then v κ₀ else 0
      else
        if ν = 0 then v μ else if ν = π μ then 1 else 0
    have hG₁_col0 : ∀ μ : Fin (r + 2), G₁ μ 0 = v μ := by
      intro μ
      dsimp [G₁]
      split_ifs with hμ
      · subst hμ; rfl
      · rfl
    let g₁ : Fin (r + 2) → MvPolynomial (Fin (r + 2)) k :=
      fun μ => ∑ ν : Fin (r + 2), MvPolynomial.C (G₁ μ ν) * MvPolynomial.X ν
    have hg₁_κ₀ : g₁ κ₀ = MvPolynomial.C (v κ₀) * MvPolynomial.X 0 := by
      dsimp [g₁]
      rw [Finset.sum_eq_single 0]
      · simp [G₁]
      · intro ν _ hν0
        simp [G₁, hν0]
      · intro habs; exact absurd (Finset.mem_univ _) habs
    have hπ_eq_zero_iff : ∀ μ : Fin (r + 2), π μ = 0 ↔ μ = κ₀ := by
      intro μ
      dsimp [π]
      constructor
      · intro h
        have h2 := congrArg (Equiv.swap (0 : Fin (r + 2)) κ₀) h
        simpa using h2
      · intro h
        subst h
        exact Equiv.swap_apply_right 0 μ
    have hg₁_ne : ∀ {μ : Fin (r + 2)}, μ ≠ κ₀ →
        g₁ μ = MvPolynomial.C (v μ) * MvPolynomial.X 0 + MvPolynomial.X (π μ) := by
      intro μ hμ
      have hπ0 : π μ ≠ 0 := mt (hπ_eq_zero_iff μ).mp hμ
      dsimp [g₁]
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ (0 : Fin (r + 2))), hG₁_col0]
      congr 1
      rw [Finset.sum_eq_single (π μ)]
      · simp [G₁, hμ, hπ0]
      · intro ν hν_mem hν_ne
        have hν0 : ν ≠ 0 := Finset.ne_of_mem_erase hν_mem
        simp [G₁, hμ, hν0, hν_ne]
      · intro hnot
        exact absurd (Finset.mem_erase.mpr ⟨hπ0, Finset.mem_univ _⟩) hnot

    let g₁_inv : Fin (r + 2) → MvPolynomial (Fin (r + 2)) k := fun ρ =>
      if ρ = 0 then
        MvPolynomial.C (v κ₀)⁻¹ * MvPolynomial.X κ₀
      else
        MvPolynomial.X (π ρ) - MvPolynomial.C (v (π ρ) * (v κ₀)⁻¹) * MvPolynomial.X κ₀
    let φ₁ : MvPolynomial (Fin (r + 2)) k →ₐ[k] MvPolynomial (Fin (r + 2)) k :=
      MvPolynomial.aeval g₁
    let φ₁_inv : MvPolynomial (Fin (r + 2)) k →ₐ[k] MvPolynomial (Fin (r + 2)) k :=
      MvPolynomial.aeval g₁_inv
    have hφ₁_X : ∀ μ, φ₁ (MvPolynomial.X μ) = g₁ μ := MvPolynomial.aeval_X g₁
    have hφ₁_C : ∀ c, φ₁ (MvPolynomial.C c) = MvPolynomial.C c := fun c => by simp [φ₁]
    have hφ₁_inv_X : ∀ ρ, φ₁_inv (MvPolynomial.X ρ) = g₁_inv ρ := MvPolynomial.aeval_X g₁_inv
    have hφ₁_inv_C : ∀ c, φ₁_inv (MvPolynomial.C c) = MvPolynomial.C c :=
      fun c => by simp [φ₁_inv]
    have hg₁_inv_0 : g₁_inv 0 = MvPolynomial.C (v κ₀)⁻¹ * MvPolynomial.X κ₀ := by
      simp [g₁_inv]
    have hg₁_inv_ne : ∀ {ρ : Fin (r + 2)}, ρ ≠ 0 →
        g₁_inv ρ =
          MvPolynomial.X (π ρ) - MvPolynomial.C (v (π ρ) * (v κ₀)⁻¹) * MvPolynomial.X κ₀ := by
      intro ρ hρ
      simp [g₁_inv, hρ]

    have hφ₁_left : φ₁_inv.comp φ₁ = AlgHom.id k (MvPolynomial (Fin (r + 2)) k) := by
      apply MvPolynomial.algHom_ext
      intro μ
      rw [AlgHom.comp_apply, AlgHom.id_apply, hφ₁_X]
      by_cases hμ : μ = κ₀
      · subst hμ
        rw [hg₁_κ₀, map_mul, hφ₁_inv_C, hφ₁_inv_X, hg₁_inv_0, ← mul_assoc,
          ← MvPolynomial.C_mul, mul_inv_cancel₀ hκ₀, map_one, one_mul]
      · have hπ0 : π μ ≠ 0 := mt (hπ_eq_zero_iff μ).mp hμ
        have hππ : π (π μ) = μ := Equiv.swap_apply_self 0 κ₀ μ
        rw [hg₁_ne hμ, map_add, map_mul, hφ₁_inv_C, hφ₁_inv_X, hφ₁_inv_X,
          hg₁_inv_0, hg₁_inv_ne hπ0, hππ, ← mul_assoc, ← MvPolynomial.C_mul]
        ring
    have hφ₁_right : φ₁.comp φ₁_inv = AlgHom.id k (MvPolynomial (Fin (r + 2)) k) := by
      apply MvPolynomial.algHom_ext
      intro ρ
      rw [AlgHom.comp_apply, AlgHom.id_apply, hφ₁_inv_X]
      by_cases hρ : ρ = 0
      · subst hρ
        rw [hg₁_inv_0, map_mul, hφ₁_C, hφ₁_X, hg₁_κ₀, ← mul_assoc,
          ← MvPolynomial.C_mul, inv_mul_cancel₀ hκ₀, map_one, one_mul]
      · have hπρ_ne : π ρ ≠ κ₀ := by
          intro h_eq
          have h2 := congrArg π h_eq
          have hππ : π (π ρ) = ρ := Equiv.swap_apply_self 0 κ₀ ρ
          have hπκ : π κ₀ = 0 := Equiv.swap_apply_right 0 κ₀
          rw [hππ, hπκ] at h2
          exact hρ h2
        have hππ : π (π ρ) = ρ := Equiv.swap_apply_self 0 κ₀ ρ
        rw [hg₁_inv_ne hρ, map_sub, map_mul, hφ₁_C, hφ₁_X, hφ₁_X,
          hg₁_ne hπρ_ne, hg₁_κ₀, hππ, ← mul_assoc, ← MvPolynomial.C_mul,
          mul_assoc, inv_mul_cancel₀ hκ₀, mul_one]
        ring
    let e₁ : MvPolynomial (Fin (r + 2)) k ≃ₐ[k] MvPolynomial (Fin (r + 2)) k :=
      AlgEquiv.ofAlgHom φ₁ φ₁_inv hφ₁_right hφ₁_left

    let c₀ : k := (MvPolynomial.eval v P_amb)⁻¹
    have hc₀_ne : c₀ ≠ 0 := inv_ne_zero hv_P
    let P_monic : MvPolynomial (Fin (r + 2)) k :=
      MvPolynomial.C c₀ * MvPolynomial.eval₂ MvPolynomial.C g₁ P_amb
    have hPm_eq : P_monic = MvPolynomial.C c₀ * e₁ P_amb := rfl

    have hg₁_hom : ∀ μ : Fin (r + 2), (g₁ μ).IsHomogeneous 1 := by
      intro μ
      change g₁ μ ∈ MvPolynomial.homogeneousSubmodule (Fin (r + 2)) k 1
      refine Submodule.sum_mem _ fun ν _ => ?_
      rw [← MvPolynomial.smul_eq_C_mul]
      exact Submodule.smul_mem _ (G₁ μ ν) (MvPolynomial.isHomogeneous_X k ν)
    have hPm_hom : P_monic.IsHomogeneous D := by
      have h1 := hP_hom.eval₂ MvPolynomial.C g₁ (fun a => MvPolynomial.isHomogeneous_C _ a) hg₁_hom
      rw [one_mul] at h1
      exact h1.C_mul c₀
    have hPm_e0 : MvPolynomial.eval (Pi.single 0 1) P_monic = 1 := by
      have hcomp : (MvPolynomial.eval (Pi.single 0 1)).comp
          (MvPolynomial.eval₂Hom MvPolynomial.C g₁) = MvPolynomial.eval v := by
        apply MvPolynomial.ringHom_ext
        · intro a; simp
        · intro μ
          simp [g₁, Pi.single_apply, hG₁_col0]
      change MvPolynomial.eval (Pi.single 0 1)
        (MvPolynomial.C c₀ * MvPolynomial.eval₂Hom MvPolynomial.C g₁ P_amb) = 1
      rw [map_mul, MvPolynomial.eval_C, ← RingHom.comp_apply, hcomp]
      exact inv_mul_cancel₀ hv_P
    have hPm_irred : Irreducible P_monic := by
      have hirr1 : Irreducible (e₁ P_amb) :=
        (MulEquiv.irreducible_iff e₁.toRingEquiv.toMulEquiv).mpr hIrred
      let u_c₀ : (MvPolynomial (Fin (r + 2)) k)ˣ :=
        ⟨MvPolynomial.C c₀, MvPolynomial.C c₀⁻¹,
          by rw [← MvPolynomial.C_mul, mul_inv_cancel₀ hc₀_ne, map_one],
          by rw [← MvPolynomial.C_mul, inv_mul_cancel₀ hc₀_ne, map_one]⟩
      have hassoc : Associated (e₁ P_amb) P_monic := by
        refine ⟨u_c₀, ?_⟩
        change e₁ P_amb * MvPolynomial.C c₀ = MvPolynomial.C c₀ * e₁ P_amb
        exact mul_comm _ _
      exact hassoc.irreducible hirr1
    have hChain₁ : ∀ F : MvPolynomial (Fin (r + 2)) k,
        MvPolynomial.pderiv 0 (e₁ F) =
          e₁ (∑ μ : Fin (r + 2), MvPolynomial.C (v μ) * MvPolynomial.pderiv μ F) := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C a =>
        have he₁C : e₁ (MvPolynomial.C a) = MvPolynomial.C a := hφ₁_C a
        simp [he₁C]
      | add p q hp hq =>
        simp only [map_add, hp, hq, mul_add, Finset.sum_add_distrib]
      | mul_X p μ₁ ih =>
        have he₁X : e₁ (MvPolynomial.X μ₁) = g₁ μ₁ := hφ₁_X μ₁
        have hpderiv_g₁ : MvPolynomial.pderiv 0 (g₁ μ₁) = MvPolynomial.C (v μ₁) := by
          dsimp [g₁]
          rw [map_sum]
          simp_rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C, zero_mul, zero_add,
            MvPolynomial.pderiv_X, Pi.single_apply]
          rw [Finset.sum_eq_single 0]
          · simp [hG₁_col0]
          · intro ν _ hν0
            simp [hν0]
          · intro habs; exact absurd (Finset.mem_univ _) habs
        rw [map_mul, MvPolynomial.pderiv_mul, ih, he₁X, hpderiv_g₁]
        simp_rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, Pi.single_apply]
        have hsum_split :
            (∑ μ : Fin (r + 2),
              MvPolynomial.C (v μ) *
                (MvPolynomial.pderiv μ p * MvPolynomial.X μ₁ +
                  p * if μ₁ = μ then 1 else 0)) =
            (∑ μ : Fin (r + 2), MvPolynomial.C (v μ) * MvPolynomial.pderiv μ p) *
                MvPolynomial.X μ₁ +
              p * MvPolynomial.C (v μ₁) := by
          simp_rw [mul_add, ← mul_assoc, Finset.sum_add_distrib, ← Finset.sum_mul]
          congr 1
          rw [Finset.sum_eq_single μ₁]
          · simp [mul_comm]
          · intro μ _ hμ
            simp [Ne.symm hμ]
          · intro habs; exact absurd (Finset.mem_univ _) habs
        rw [hsum_split, map_add, map_mul, map_mul, he₁X]
        have he₁Cv : e₁ (MvPolynomial.C (v μ₁)) = MvPolynomial.C (v μ₁) := hφ₁_C (v μ₁)
        rw [he₁Cv]
    have hPm_pderiv : MvPolynomial.pderiv 0 P_monic ≠ 0 := by
      rw [hPm_eq, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C, zero_mul, zero_add, hChain₁]
      intro h0
      have hCc₀_ne : (MvPolynomial.C c₀ : MvPolynomial (Fin (r + 2)) k) ≠ 0 := by
        simpa using hc₀_ne
      have he₁_zero : e₁ (∑ μ : Fin (r + 2), MvPolynomial.C (v μ) * MvPolynomial.pderiv μ P_amb) = 0 :=
        (mul_eq_zero.mp h0).resolve_left hCc₀_ne
      have hsum_zero : (∑ μ : Fin (r + 2), MvPolynomial.C (v μ) * MvPolynomial.pderiv μ P_amb) = 0 :=
        e₁.injective (he₁_zero.trans (map_zero e₁).symm)
      have heval_zero := congrArg (MvPolynomial.eval x₀) hsum_zero
      simp only [map_sum, map_mul, MvPolynomial.eval_C, map_zero] at heval_zero
      have heval_comm : (∑ μ : Fin (r + 2), d_vec μ * v μ) = 0 := by
        simpa [d_vec, mul_comm] using heval_zero
      exact hv_L heval_comm

    exact ⟨G₁, c₀, hc₀_ne, hPm_hom, hPm_e0, hPm_irred, hPm_pderiv⟩

  
  
  
  clear hHom_sum hExistsEvalNeZero
  obtain ⟨G₁, c₀, hc₀_ne, hPm_hom, hPm_e0, hPm_irred, hPm_pderiv⟩ := hStep1
  let P_monic : MvPolynomial (Fin (r + 2)) k :=
    MvPolynomial.C c₀ *
      MvPolynomial.eval₂ MvPolynomial.C
        (fun μ : Fin (r + 2) =>
          ∑ ν : Fin (r + 2), MvPolynomial.C (G₁ μ ν) * MvPolynomial.X ν)
        P_amb
  obtain ⟨hf_raw_monic, hf_raw_deg, hf_raw_irred, hf_raw_deriv⟩ :=
    hStep2 P_monic hPm_hom hPm_e0 hPm_irred hPm_pderiv
  let g_dehom : Fin (r + 2) → Polynomial (MvPolynomial (Fin r) k) :=
    Fin.cons Polynomial.X (Fin.cons 1 (fun i : Fin r => Polynomial.C (MvPolynomial.X i)))
  let dehom : MvPolynomial (Fin (r + 2)) k →+* Polynomial (MvPolynomial (Fin r) k) :=
    MvPolynomial.eval₂Hom (Polynomial.C.comp MvPolynomial.C) g_dehom
  let f_raw : Polynomial (MvPolynomial (Fin r) k) := dehom P_monic
  obtain ⟨a, α, hα_inj, hf_monic, hf_deg, hf_ndvd, hf₀_prod⟩ :=
    hStep3 f_raw hf_raw_monic hf_raw_deg hf_raw_irred hf_raw_deriv
  clear hStep2 hStep3

  let τ_a : MvPolynomial (Fin r) k →+* MvPolynomial (Fin r) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C
      (fun i : Fin r => MvPolynomial.X i + MvPolynomial.C (a i))
  let f : Polynomial (MvPolynomial (Fin r) k) := Polynomial.map τ_a f_raw

  let g₂ : Fin (r + 2) → MvPolynomial (Fin (r + 2)) k :=
    Fin.cons (MvPolynomial.X 0)
      (Fin.cons (MvPolynomial.X 1)
        (fun i : Fin r =>
          MvPolynomial.X i.succ.succ + MvPolynomial.C (a i) * MvPolynomial.X 1))
  let g₂_inv : Fin (r + 2) → MvPolynomial (Fin (r + 2)) k :=
    Fin.cons (MvPolynomial.X 0)
      (Fin.cons (MvPolynomial.X 1)
        (fun i : Fin r =>
          MvPolynomial.X i.succ.succ - MvPolynomial.C (a i) * MvPolynomial.X 1))
  let G₂ : Fin (r + 2) → Fin (r + 2) → k :=
    Fin.cons (Pi.single 0 1)
      (Fin.cons (Pi.single 1 1)
        (fun i : Fin r => Pi.single i.succ.succ 1 + Pi.single 1 (a i)))
  have hg₂_ss : ∀ i : Fin r,
      g₂ i.succ.succ = MvPolynomial.X i.succ.succ + MvPolynomial.C (a i) * MvPolynomial.X 1 := by
    intro i; simp [g₂]
  have hg₂_inv_ss : ∀ i : Fin r,
      g₂_inv i.succ.succ =
        MvPolynomial.X i.succ.succ - MvPolynomial.C (a i) * MvPolynomial.X 1 := by
    intro i; simp [g₂_inv]
  have hg₂_eq : ∀ ν : Fin (r + 2),
      g₂ ν = ∑ ρ : Fin (r + 2), MvPolynomial.C (G₂ ν ρ) * MvPolynomial.X ρ := by
    intro ν
    refine Fin.cases ?_ (fun ν' => Fin.cases ?_ (fun i => ?_) ν') ν
    · simp [g₂, G₂, Pi.single_apply]
    · simp [g₂, G₂, Pi.single_apply, Fin.succ_zero_eq_one]
    · have hG₂_ss : G₂ i.succ.succ = Pi.single i.succ.succ 1 + Pi.single 1 (a i) := by
        simp [G₂]
      rw [hg₂_ss, hG₂_ss]
      simp_rw [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
      congr 1
      · rw [Finset.sum_eq_single i.succ.succ]
        · simp
        · intro ρ _ hρ
          simp [Pi.single_eq_of_ne hρ]
        · intro habs; exact absurd (Finset.mem_univ _) habs
      · rw [Finset.sum_eq_single 1]
        · simp
        · intro ρ _ hρ
          simp [Pi.single_eq_of_ne hρ]
        · intro habs; exact absurd (Finset.mem_univ _) habs

  let G : Fin (r + 2) → Fin (r + 2) → k :=
    fun μ ρ => ∑ ν : Fin (r + 2), G₁ μ ν * G₂ ν ρ
  let φ₂ : MvPolynomial (Fin (r + 2)) k →ₐ[k] MvPolynomial (Fin (r + 2)) k :=
    MvPolynomial.aeval g₂
  let φ₂_inv : MvPolynomial (Fin (r + 2)) k →ₐ[k] MvPolynomial (Fin (r + 2)) k :=
    MvPolynomial.aeval g₂_inv
  have hφ₂_X : ∀ ν, φ₂ (MvPolynomial.X ν) = g₂ ν := MvPolynomial.aeval_X g₂
  have hφ₂_C : ∀ c, φ₂ (MvPolynomial.C c) = MvPolynomial.C c := fun c => by simp [φ₂]
  have hφ₂_inv_X : ∀ ν, φ₂_inv (MvPolynomial.X ν) = g₂_inv ν := MvPolynomial.aeval_X g₂_inv
  have hφ₂_inv_C : ∀ c, φ₂_inv (MvPolynomial.C c) = MvPolynomial.C c :=
    fun c => by simp [φ₂_inv]
  have h1_eq_succ0 : (1 : Fin (r + 2)) = Fin.succ 0 := Fin.succ_zero_eq_one.symm
  have hg₂_1 : g₂ 1 = MvPolynomial.X 1 := by
    rw [h1_eq_succ0]; simp [g₂]
  have hg₂_inv_1 : g₂_inv 1 = MvPolynomial.X 1 := by
    rw [h1_eq_succ0]; simp [g₂_inv]
  have hφ₂_left : φ₂_inv.comp φ₂ = AlgHom.id k (MvPolynomial (Fin (r + 2)) k) := by
    apply MvPolynomial.algHom_ext
    intro ν
    rw [AlgHom.comp_apply, AlgHom.id_apply, hφ₂_X]
    refine Fin.cases ?_ (fun ν' => Fin.cases ?_ (fun i => ?_) ν') ν
    · have hg0 : g₂ 0 = MvPolynomial.X 0 := by simp [g₂]
      rw [hg0, hφ₂_inv_X]; simp [g₂_inv]
    · rw [Fin.succ_zero_eq_one, hg₂_1, hφ₂_inv_X, hg₂_inv_1]
    · rw [hg₂_ss, map_add, map_mul, hφ₂_inv_C, hφ₂_inv_X, hφ₂_inv_X, hg₂_inv_ss, hg₂_inv_1]
      ring
  have hφ₂_right : φ₂.comp φ₂_inv = AlgHom.id k (MvPolynomial (Fin (r + 2)) k) := by
    apply MvPolynomial.algHom_ext
    intro ν
    rw [AlgHom.comp_apply, AlgHom.id_apply, hφ₂_inv_X]
    refine Fin.cases ?_ (fun ν' => Fin.cases ?_ (fun i => ?_) ν') ν
    · have hg0 : g₂_inv 0 = MvPolynomial.X 0 := by simp [g₂_inv]
      rw [hg0, hφ₂_X]; simp [g₂]
    · rw [Fin.succ_zero_eq_one, hg₂_inv_1, hφ₂_X, hg₂_1]
    · rw [hg₂_inv_ss, map_sub, map_mul, hφ₂_C, hφ₂_X, hφ₂_X, hg₂_ss, hg₂_1]
      ring
  let e₂ : MvPolynomial (Fin (r + 2)) k ≃ₐ[k] MvPolynomial (Fin (r + 2)) k :=
    AlgEquiv.ofAlgHom φ₂ φ₂_inv hφ₂_right hφ₂_left

  let P₁ : MvPolynomial (Fin (r + 2)) k :=
    MvPolynomial.C c₀ *
      MvPolynomial.eval₂ MvPolynomial.C
        (fun μ : Fin (r + 2) =>
          ∑ ν : Fin (r + 2), MvPolynomial.C (G μ ν) * MvPolynomial.X ν)
        P_amb
  have hP₁_eq_e₂ : P₁ = e₂ P_monic := by
    let φ₁ : MvPolynomial (Fin (r + 2)) k →ₐ[k] MvPolynomial (Fin (r + 2)) k :=
      MvPolynomial.aeval (fun μ : Fin (r + 2) =>
        ∑ ν : Fin (r + 2), MvPolynomial.C (G₁ μ ν) * MvPolynomial.X ν)
    let φ_G : MvPolynomial (Fin (r + 2)) k →ₐ[k] MvPolynomial (Fin (r + 2)) k :=
      MvPolynomial.aeval (fun μ : Fin (r + 2) =>
        ∑ ρ : Fin (r + 2), MvPolynomial.C (G μ ρ) * MvPolynomial.X ρ)
    have hcomp : φ₂.comp φ₁ = φ_G := by
      apply MvPolynomial.algHom_ext
      intro μ
      simp only [AlgHom.comp_apply, φ₁, φ₂, φ_G, MvPolynomial.aeval_X,
        map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq, hg₂_eq,
        Finset.mul_sum, Finset.sum_mul, mul_assoc, G]
      exact Finset.sum_comm
    change MvPolynomial.C c₀ * φ_G P_amb = φ₂ (MvPolynomial.C c₀ * φ₁ P_amb)
    rw [map_mul, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq, ← AlgHom.comp_apply, hcomp]

  have hg₂_hom : ∀ ν : Fin (r + 2), (g₂ ν).IsHomogeneous 1 := by
    intro ν
    rw [hg₂_eq ν]
    change _ ∈ MvPolynomial.homogeneousSubmodule (Fin (r + 2)) k 1
    refine Submodule.sum_mem _ fun ρ _ => ?_
    rw [← MvPolynomial.smul_eq_C_mul]
    exact Submodule.smul_mem _ (G₂ ν ρ) (MvPolynomial.isHomogeneous_X k ρ)
  have hP₁_hom : P₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (r + 2)) k D := by
    change P₁.IsHomogeneous D
    rw [hP₁_eq_e₂]
    have h1 := hPm_hom.eval₂ MvPolynomial.C g₂ (fun c => MvPolynomial.isHomogeneous_C _ c) hg₂_hom
    rwa [one_mul] at h1

  have hP₁_e0 : MvPolynomial.eval (Pi.single 0 1) P₁ = 1 := by
    have hcomp : (MvPolynomial.eval (Pi.single 0 1)).comp φ₂.toRingHom =
        MvPolynomial.eval (Pi.single 0 1) := by
      apply MvPolynomial.ringHom_ext
      · intro c; simp [φ₂]
      · intro ν
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          φ₂, MvPolynomial.aeval_X]
        refine Fin.cases ?_ (fun ν' => Fin.cases ?_ (fun i => ?_) ν') ν
        · simp [g₂]
        · simp [g₂]
        · simp [g₂]
    rw [hP₁_eq_e₂]
    change ((MvPolynomial.eval (Pi.single 0 1)).comp φ₂.toRingHom) P_monic = 1
    rw [hcomp]
    exact hPm_e0

  have hP₁_irred : Irreducible P₁ := by
    rw [hP₁_eq_e₂]
    exact (MulEquiv.irreducible_iff e₂.toRingEquiv.toMulEquiv).mpr hPm_irred

  have hf_eq_dehom : f = dehom P₁ := by
    have hcomp : dehom.comp φ₂.toRingHom = (Polynomial.mapRingHom τ_a).comp dehom := by
      apply MvPolynomial.ringHom_ext
      · intro c
        simp [dehom, φ₂, τ_a]
      · intro ν
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          φ₂, MvPolynomial.aeval_X, Polynomial.coe_mapRingHom]
        refine Fin.cases ?_ (fun ν' => Fin.cases ?_ (fun i => ?_) ν') ν
        · simp [g₂, dehom, g_dehom]
        · have hdehom1 : dehom (MvPolynomial.X 1) = 1 := by
            rw [h1_eq_succ0]; simp [dehom, g_dehom]
          rw [Fin.succ_zero_eq_one, hg₂_1, hdehom1, Polynomial.map_one]
        · have hdehom1 : dehom (MvPolynomial.X 1) = 1 := by
            rw [h1_eq_succ0]; simp [dehom, g_dehom]
          rw [hg₂_ss, map_add, map_mul, hdehom1, mul_one]
          have hXi : dehom (MvPolynomial.X i.succ.succ) = Polynomial.C (MvPolynomial.X i) := by
            simp [dehom, g_dehom]
          have hCa : dehom (MvPolynomial.C (a i)) = Polynomial.C (MvPolynomial.C (a i)) := by
            simp [dehom]
          rw [hXi, hCa, ← Polynomial.C_add, Polynomial.map_C]
          simp [τ_a]
    rw [hP₁_eq_e₂]
    have heq := DFunLike.congr_fun hcomp P_monic
    exact heq.symm

  refine ⟨G, c₀, f, α, hc₀_ne, hα_inj, hP₁_hom, hP₁_e0, hP₁_irred,
    hf_eq_dehom, hf_monic, hf_deg, hf_ndvd, hf₀_prod⟩

theorem weil_truncated_homog_newton_subset_obstructions (k : Type u) [Field k] (r D : ℕ) (hD : 2 ≤ D)
    (f : Polynomial (MvPolynomial (Fin r) k)) (α : Fin D → k)
    (hf_monic : f.Monic) (hf_deg : f.natDegree = D)
    (hf_ndvd : ∀ A : Polynomial (MvPolynomial (Fin r) k),
      A.Monic → 1 ≤ A.natDegree → A.natDegree < D → ¬ (A ∣ f))
    (hα_inj : Function.Injective α)
    (hf₀ : Polynomial.map MvPolynomial.constantCoeff f =
      ∏ ν : Fin D, (Polynomial.X - Polynomial.C (α ν))) :
    ∃ (ζ : Fin D → ℕ → MvPolynomial (Fin r) k),
      (∀ (ν : Fin D) (m : ℕ), ζ ν m ∈ MvPolynomial.homogeneousSubmodule (Fin r) k m) ∧
      (∀ ν : Fin D, ζ ν 0 = MvPolynomial.C (α ν)) ∧
      (∀ (N₀ : ℕ), 1 ≤ N₀ → ∀ (j m : ℕ), m < N₀ →
        MvPolynomial.homogeneousComponent m
          ((f - ∏ ν : Fin D,
            (Polynomial.X - Polynomial.C (∑ s ∈ Finset.range N₀, ζ ν s))).coeff j) = 0) ∧
      (∀ I : Finset (Fin D), 1 ≤ I.card → I.card < D →
        ∃ (j_I s_I : ℕ), j_I < I.card ∧ D < s_I ∧
          MvPolynomial.homogeneousComponent s_I
            ((∏ ν ∈ I,
              (Polynomial.X - Polynomial.C (∑ s ∈ Finset.range (s_I + 1), ζ ν s))).coeff j_I) ≠ 0) :=
by
  classical
  have _ := hD
  let VanishBelow (N : ℕ) (p : MvPolynomial (Fin r) k) : Prop :=
    ∀ d : Fin r →₀ ℕ, Finsupp.degree d < N → p.coeff d = 0

  have hVB_iff_homog : ∀ (N : ℕ) (p : MvPolynomial (Fin r) k),
      VanishBelow N p ↔ ∀ m < N, MvPolynomial.homogeneousComponent m p = 0 := by
    intro N p
    constructor
    · intro hV m hm
      ext d
      rw [MvPolynomial.coeff_homogeneousComponent]
      split_ifs with hd
      · subst hd
        simpa using hV d hm
      · simp
    · intro hH d hd
      have h0 := congrArg (fun q : MvPolynomial (Fin r) k => q.coeff d) (hH (Finsupp.degree d) hd)
      simpa [MvPolynomial.coeff_homogeneousComponent] using h0

  have hVB_zero : ∀ N : ℕ, VanishBelow N 0 := by
    intro N d _
    rfl

  have hVB_add : ∀ {N : ℕ} {p q : MvPolynomial (Fin r) k},
      VanishBelow N p → VanishBelow N q → VanishBelow N (p + q) := by
    intro N p q hp hq d hd
    rw [AddMonoidAlgebra.coeff_add, Finsupp.add_apply, hp d hd, hq d hd, add_zero]

  have hVB_mono : ∀ {N₁ N₂ : ℕ} {p : MvPolynomial (Fin r) k},
      N₁ ≤ N₂ → VanishBelow N₂ p → VanishBelow N₁ p := by
    intro N₁ N₂ p hle hp d hd
    exact hp d (lt_of_lt_of_le hd hle)

  have hVB_of_homog : ∀ {n : ℕ} {p : MvPolynomial (Fin r) k},
      p ∈ MvPolynomial.homogeneousSubmodule (Fin r) k n → VanishBelow n p := by
    intro n p hp d hd
    have hp' : p.IsHomogeneous n := (MvPolynomial.mem_homogeneousSubmodule n p).mp hp
    exact hp'.coeff_eq_zero (ne_of_lt hd)

  have hVB_mul : ∀ {a b : ℕ} {p q : MvPolynomial (Fin r) k},
      VanishBelow a p → VanishBelow b q → VanishBelow (a + b) (p * q) := by
    intro a b p q hp hq d hd
    rw [MvPolynomial.coeff_mul]
    refine Finset.sum_eq_zero fun x hx => ?_
    have hsum_d : x.1 + x.2 = d := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
    have hdeg : Finsupp.degree x.1 + Finsupp.degree x.2 = Finsupp.degree d := by
      rw [← map_add Finsupp.degree x.1 x.2, hsum_d]
    by_cases h1 : Finsupp.degree x.1 < a
    · rw [hp x.1 h1, zero_mul]
    · have h2 : Finsupp.degree x.2 < b := by omega
      rw [hq x.2 h2, mul_zero]

  have hVB_zero_base : ∀ p : MvPolynomial (Fin r) k, VanishBelow 0 p := by
    intro p d hd
    omega

  have hVB_mul_right : ∀ {a : ℕ} {p : MvPolynomial (Fin r) k} (q : MvPolynomial (Fin r) k),
      VanishBelow a p → VanishBelow a (p * q) := by
    intro a p q hp
    simpa using hVB_mul hp (hVB_zero_base q)

  have hVB_mul_left : ∀ {a : ℕ} (p : MvPolynomial (Fin r) k) {q : MvPolynomial (Fin r) k},
      VanishBelow a q → VanishBelow a (p * q) := by
    intro a p q hq
    rw [mul_comm]
    exact hVB_mul_right p hq

  have hVB_one_iff : ∀ p : MvPolynomial (Fin r) k,
      VanishBelow 1 p ↔ MvPolynomial.constantCoeff p = 0 := by
    intro p
    constructor
    · intro hp
      exact hp 0 (by simp)
    · intro hc d hd
      have hd0 : Finsupp.degree d = 0 := by omega
      have hd_eq : d = 0 := by
        ext i
        simp only [Finsupp.coe_zero, Pi.zero_apply]
        by_contra hi
        have hmem : i ∈ d.support := Finsupp.mem_support_iff.mpr hi
        have hle : d i ≤ Finsupp.degree d := by
          rw [Finsupp.degree_apply]
          exact Finset.single_le_sum (f := fun j => d j) (fun _ _ => Nat.zero_le _) hmem
        omega
      subst hd_eq
      exact hc

  let J (N : ℕ) : Ideal (MvPolynomial (Fin r) k) :=
    { carrier := { p | VanishBelow N p }
      zero_mem' := hVB_zero N
      add_mem' := fun hp hq => hVB_add hp hq
      smul_mem' := fun c p hp => by
        change VanishBelow N (c • p)
        rw [smul_eq_mul]
        exact hVB_mul_left c hp }

  have hJ_mem_iff : ∀ (N : ℕ) (p : MvPolynomial (Fin r) k),
      p ∈ J N ↔ ∀ m < N, MvPolynomial.homogeneousComponent m p = 0 :=
    hVB_iff_homog

  have hJ_nontrivial : ∀ {N : ℕ}, 1 ≤ N → Nontrivial (MvPolynomial (Fin r) k ⧸ J N) := by
    intro N hN
    rw [Ideal.Quotient.nontrivial_iff]
    intro htop
    have h1 : (1 : MvPolynomial (Fin r) k) ∈ J N := by
      rw [htop]
      trivial
    have hdeg0 : Finsupp.degree (0 : Fin r →₀ ℕ) < N := by
      rw [map_zero Finsupp.degree]
      omega
    have hcoeff1 : MvPolynomial.constantCoeff (1 : MvPolynomial (Fin r) k) = 0 := h1 0 hdeg0
    rw [map_one] at hcoeff1
    exact one_ne_zero hcoeff1

  have hJ_eq_zero_of_totalDegree_lt : ∀ {N : ℕ} {p : MvPolynomial (Fin r) k},
      p ∈ J N → p.totalDegree < N → p = 0 := by
    intro N p hpJ hdeg
    rw [← MvPolynomial.sum_homogeneousComponent p]
    refine Finset.sum_eq_zero fun m hm => ?_
    rw [Finset.mem_range] at hm
    exact (hVB_iff_homog N p).mp hpJ m (by omega)

  let f₀ : Polynomial k := Polynomial.map MvPolynomial.constantCoeff f

  have hf₀_root : ∀ ν : Fin D, f₀.eval (α ν) = 0 := by
    intro ν
    dsimp [f₀]
    rw [hf₀, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ ν),
      Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C,
      sub_self, zero_mul]

  have hf₀_deriv : ∀ ν : Fin D, (Polynomial.derivative f₀).eval (α ν) ≠ 0 := by
    intro ν
    let Q_ν : Polynomial k := ∏ μ ∈ Finset.univ.erase ν, (Polynomial.X - Polynomial.C (α μ))
    have hf₀_fac : f₀ = (Polynomial.X - Polynomial.C (α ν)) * Q_ν := by
      dsimp [f₀, Q_ν]
      rw [hf₀, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ ν)]
    have heval_deriv : (Polynomial.derivative f₀).eval (α ν) = Q_ν.eval (α ν) := by
      rw [hf₀_fac, Polynomial.derivative_mul, Polynomial.derivative_sub,
        Polynomial.derivative_X, Polynomial.derivative_C, sub_zero, one_mul,
        Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_sub,
        Polynomial.eval_X, Polynomial.eval_C, sub_self, zero_mul, add_zero]
    rw [heval_deriv]
    dsimp [Q_ν]
    rw [Polynomial.eval_prod]
    refine Finset.prod_ne_zero_iff.mpr fun μ hμ => ?_
    rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
    exact sub_ne_zero.mpr (hα_inj.ne (Finset.ne_of_mem_erase hμ).symm)

  have hTaylor : ∀ (P : Polynomial (MvPolynomial (Fin r) k)) (z δ : MvPolynomial (Fin r) k),
      ∃ Q : MvPolynomial (Fin r) k,
        P.eval (z + δ) = P.eval z + (Polynomial.derivative P).eval z * δ + δ ^ 2 * Q := by
    intro P z δ
    refine Polynomial.induction_on P
      (fun a => ⟨0, by simp⟩)
      (fun p q ⟨Qp, hQp⟩ ⟨Qq, hQq⟩ => ⟨Qp + Qq, by
        simp only [Polynomial.eval_add, Polynomial.derivative_add, hQp, hQq]
        ring⟩)
      (fun n a ⟨Qn, hQn⟩ => ?_)
    let Pn : Polynomial (MvPolynomial (Fin r) k) := Polynomial.C a * Polynomial.X ^ n
    refine ⟨(Polynomial.derivative Pn).eval z + Qn * (z + δ), ?_⟩
    have hmul : Polynomial.C a * Polynomial.X ^ (n + 1) = Pn * Polynomial.X := by
      dsimp [Pn]
      rw [pow_succ, mul_assoc]
    have hlhs : (Pn * Polynomial.X).eval (z + δ) = Pn.eval (z + δ) * (z + δ) := by
      rw [Polynomial.eval_mul, Polynomial.eval_X]
    have hrhs1 : (Pn * Polynomial.X).eval z = Pn.eval z * z := by
      rw [Polynomial.eval_mul, Polynomial.eval_X]
    have hrhs2 : (Polynomial.derivative (Pn * Polynomial.X)).eval z =
        (Polynomial.derivative Pn).eval z * z + Pn.eval z := by
      rw [Polynomial.derivative_mul, Polynomial.derivative_X, mul_one,
        Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_X]
    rw [hmul, hlhs, hrhs1, hrhs2]
    change Pn.eval (z + δ) * (z + δ) = _
    rw [hQn]
    ring

  let c₀ (ν : Fin D) : k := (Polynomial.derivative f₀).eval (α ν)
  let step (ν : Fin D) (w : MvPolynomial (Fin r) k) (s : ℕ) : MvPolynomial (Fin r) k :=
    -MvPolynomial.C (c₀ ν)⁻¹ * MvPolynomial.homogeneousComponent (s + 1) (f.eval w)
  let z (ν : Fin D) : ℕ → MvPolynomial (Fin r) k :=
    Nat.rec (MvPolynomial.C (α ν)) (fun s w => w + step ν w s)
  let ζ (ν : Fin D) (m : ℕ) : MvPolynomial (Fin r) k :=
    Nat.casesOn m (MvPolynomial.C (α ν)) (fun s => step ν (z ν s) s)

  have hζ_zero : ∀ ν : Fin D, ζ ν 0 = MvPolynomial.C (α ν) := fun _ => rfl

  have hζ_hom : ∀ (ν : Fin D) (m : ℕ),
      ζ ν m ∈ MvPolynomial.homogeneousSubmodule (Fin r) k m := by
    intro ν m
    rcases m with _ | s
    · exact (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr
        (MvPolynomial.isHomogeneous_C (Fin r) (α ν))
    · change -MvPolynomial.C (c₀ ν)⁻¹ *
          MvPolynomial.homogeneousComponent (s + 1) (f.eval (z ν s)) ∈ _
      have h_smul : -MvPolynomial.C (c₀ ν)⁻¹ *
          MvPolynomial.homogeneousComponent (s + 1) (f.eval (z ν s)) =
          (-(c₀ ν)⁻¹) • MvPolynomial.homogeneousComponent (s + 1) (f.eval (z ν s)) := by
        rw [MvPolynomial.smul_eq_C_mul, map_neg, neg_mul]
      rw [h_smul]
      exact Submodule.smul_mem _ _ (MvPolynomial.homogeneousComponent_mem (s + 1) _)

  have hz_sum : ∀ (ν : Fin D) (s : ℕ), ∑ j ∈ Finset.range (s + 1), ζ ν j = z ν s := by
    intro ν s
    induction s with
    | zero => simp [ζ, z]
    | succ s ih => rw [Finset.sum_range_succ, ih]

  have hz_const : ∀ (ν : Fin D) (s : ℕ), MvPolynomial.constantCoeff (z ν s) = α ν := by
    intro ν s
    induction s with
    | zero => simp [z]
    | succ s ih =>
      change MvPolynomial.constantCoeff (z ν s + ζ ν (s + 1)) = α ν
      have hζ_c0 : MvPolynomial.constantCoeff (ζ ν (s + 1)) = 0 :=
        (hVB_one_iff _).mp (hVB_mono (by omega) (hVB_of_homog (hζ_hom ν (s + 1))))
      rw [map_add, ih, hζ_c0, add_zero]

  have hz_poly_const : ∀ (P : Polynomial (MvPolynomial (Fin r) k)) (ν : Fin D) (s : ℕ),
      MvPolynomial.constantCoeff (P.eval (z ν s)) =
        (P.map MvPolynomial.constantCoeff).eval (α ν) := by
    intro P ν s
    rw [Polynomial.eval_map, ← hz_const ν s, Polynomial.eval₂_hom]

  have hz_eval_VB : ∀ (ν : Fin D) (s : ℕ), VanishBelow (s + 1) (f.eval (z ν s)) := by
    intro ν s
    induction s with
    | zero =>
      rw [hVB_one_iff, hz_poly_const]
      exact hf₀_root ν
    | succ s ih =>
      set δ : MvPolynomial (Fin r) k := ζ ν (s + 1)
      have hδ_VB : VanishBelow (s + 1) δ := hVB_of_homog (hζ_hom ν (s + 1))
      obtain ⟨Q, hQ⟩ := hTaylor f (z ν s) δ
      change VanishBelow (s + 2) (f.eval (z ν s + δ))
      have h_decomp : f.eval (z ν s + δ) =
          (f.eval (z ν s) + MvPolynomial.C (c₀ ν) * δ) +
          ((Polynomial.derivative f).eval (z ν s) - MvPolynomial.C (c₀ ν)) * δ +
          δ ^ 2 * Q := by
        rw [hQ]
        ring
      rw [h_decomp]
      have hE1 : VanishBelow (s + 2) (f.eval (z ν s) + MvPolynomial.C (c₀ ν) * δ) := by
        have hcδ : MvPolynomial.C (c₀ ν) * δ =
            -MvPolynomial.homogeneousComponent (s + 1) (f.eval (z ν s)) := by
          dsimp [δ, ζ, step]
          rw [← mul_assoc, mul_neg, ← MvPolynomial.C_mul, mul_inv_cancel₀ (hf₀_deriv ν),
            map_one, neg_one_mul]
        rw [hcδ, hVB_iff_homog]
        intro m hm
        rw [← sub_eq_add_neg, LinearMap.map_sub,
          MvPolynomial.homogeneousComponent_of_mem
            (MvPolynomial.homogeneousComponent_mem (s + 1) (f.eval (z ν s)))]
        split_ifs with hms
        · subst hms
          exact sub_self _
        · rw [(hVB_iff_homog (s + 1) _).mp ih m (by omega), sub_zero]
      have hE2 : VanishBelow (s + 2)
          (((Polynomial.derivative f).eval (z ν s) - MvPolynomial.C (c₀ ν)) * δ) := by
        have h_drift : VanishBelow 1
            ((Polynomial.derivative f).eval (z ν s) - MvPolynomial.C (c₀ ν)) := by
          rw [hVB_one_iff, map_sub, hz_poly_const, MvPolynomial.constantCoeff_C,
            ← Polynomial.derivative_map]
          exact sub_self (c₀ ν)
        have h1s : 1 + (s + 1) = s + 2 := by omega
        rw [← h1s]
        exact hVB_mul h_drift hδ_VB
      have hE3 : VanishBelow (s + 2) (δ ^ 2 * Q) := by
        have hδ2 : VanishBelow ((s + 1) + (s + 1)) (δ ^ 2) := by
          rw [sq]
          exact hVB_mul hδ_VB hδ_VB
        exact hVB_mono (by omega) (hVB_mul_right Q hδ2)
      exact hVB_add (hVB_add hE1 hE2) hE3

  have hζ_cong : ∀ (N₀ : ℕ), 1 ≤ N₀ → ∀ (j m : ℕ), m < N₀ →
      MvPolynomial.homogeneousComponent m
        ((f - ∏ ν : Fin D,
          (Polynomial.X - Polynomial.C (∑ s ∈ Finset.range N₀, ζ ν s))).coeff j) = 0 := by
    intro N₀ hN₀
    let π : MvPolynomial (Fin r) k →+* (MvPolynomial (Fin r) k ⧸ J N₀) :=
      Ideal.Quotient.mk (J N₀)
    have : Nontrivial (MvPolynomial (Fin r) k ⧸ J N₀) := hJ_nontrivial hN₀
    let z_tr (ν : Fin D) : MvPolynomial (Fin r) k := ∑ s ∈ Finset.range N₀, ζ ν s
    let zb (ν : Fin D) : MvPolynomial (Fin r) k ⧸ J N₀ := π (z_tr ν)
    have hz_tr_eq : ∀ ν : Fin D, z_tr ν = z ν (N₀ - 1) := by
      intro ν
      dsimp [z_tr]
      simpa [Nat.sub_add_cancel hN₀] using hz_sum ν (N₀ - 1)
    have hf_zb_root : ∀ ν : Fin D, (f.map π).eval (zb ν) = 0 := by
      intro ν
      dsimp [zb]
      rw [Polynomial.eval_map, Polynomial.eval₂_hom, Ideal.Quotient.eq_zero_iff_mem, hz_tr_eq]
      change VanishBelow N₀ (f.eval (z ν (N₀ - 1)))
      simpa [Nat.sub_add_cancel hN₀] using hz_eval_VB ν (N₀ - 1)
    have hzb_diff_unit : ∀ {ν μ : Fin D}, ν ≠ μ → IsUnit (zb ν - zb μ) := by
      intro ν μ hne
      let c : k := α ν - α μ
      have hc : c ≠ 0 := sub_ne_zero.mpr (hα_inj.ne hne)
      let w : MvPolynomial (Fin r) k := (z_tr ν - z_tr μ) - MvPolynomial.C c
      have hw1 : VanishBelow 1 w := by
        rw [hVB_one_iff]
        dsimp [w, c]
        rw [map_sub, map_sub, hz_tr_eq, hz_tr_eq, hz_const, hz_const,
          MvPolynomial.constantCoeff_C, sub_self]
      have hw_pow : ∀ n : ℕ, VanishBelow n (w ^ n) := by
        intro n
        induction n with
        | zero => exact hVB_zero_base _
        | succ n ih =>
          rw [pow_succ]
          exact hVB_mul ih hw1
      have hπw_nil : IsNilpotent (π w) := by
        refine ⟨N₀, ?_⟩
        rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
        exact hw_pow N₀
      have h_mul_nil : IsNilpotent (π (MvPolynomial.C c⁻¹) * π w) :=
        (Commute.all (π (MvPolynomial.C c⁻¹)) (π w)).isNilpotent_mul_left hπw_nil
      have hu1 : IsUnit (1 + π (MvPolynomial.C c⁻¹) * π w) := h_mul_nil.isUnit_one_add
      let u_c : (MvPolynomial (Fin r) k ⧸ J N₀)ˣ :=
        ⟨π (MvPolynomial.C c), π (MvPolynomial.C c⁻¹),
          by rw [← map_mul, ← MvPolynomial.C_mul, mul_inv_cancel₀ hc, map_one, map_one],
          by rw [← map_mul, ← MvPolynomial.C_mul, inv_mul_cancel₀ hc, map_one, map_one]⟩
      have hu_prod : IsUnit ((u_c : MvPolynomial (Fin r) k ⧸ J N₀) *
          (1 + π (MvPolynomial.C c⁻¹) * π w)) := u_c.isUnit.mul hu1
      have heq_zb : (u_c : MvPolynomial (Fin r) k ⧸ J N₀) *
          (1 + π (MvPolynomial.C c⁻¹) * π w) = zb ν - zb μ := by
        change π (MvPolynomial.C c) * (1 + π (MvPolynomial.C c⁻¹) * π w) =
          π (z_tr ν) - π (z_tr μ)
        rw [mul_add, mul_one, ← mul_assoc, ← map_mul, ← MvPolynomial.C_mul,
          mul_inv_cancel₀ hc, map_one, map_one, one_mul, ← map_add, ← map_sub]
        congr 1
        dsimp [w]
        ring
      rwa [heq_zb] at hu_prod
    have hdvd_finset : ∀ S : Finset (Fin D),
        (∏ μ ∈ S, (Polynomial.X - Polynomial.C (zb μ))) ∣ f.map π := by
      intro S
      induction S using Finset.induction_on with
      | empty => simp
      | insert ν S hνS ih =>
        rcases ih with ⟨Q_S, hQ_S⟩
        have heval_zero : (∏ μ ∈ S, (zb ν - zb μ)) * Q_S.eval (zb ν) = 0 := by
          have h0 := hf_zb_root ν
          rw [hQ_S, Polynomial.eval_mul, Polynomial.eval_prod] at h0
          simpa only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C] using h0
        have hprod_unit : IsUnit (∏ μ ∈ S, (zb ν - zb μ)) := by
          refine Finset.prod_induction _ IsUnit (fun _ _ => IsUnit.mul) isUnit_one fun μ hμ => ?_
          exact hzb_diff_unit (fun h_eq => hνS (h_eq ▸ hμ))
        rcases hprod_unit with ⟨u_S, hu_S⟩
        rw [← hu_S] at heval_zero
        have hQ_root : Polynomial.IsRoot Q_S (zb ν) := by
          rw [Polynomial.IsRoot.def]
          have h1 := congrArg ((↑u_S⁻¹ : MvPolynomial (Fin r) k ⧸ J N₀) * ·) heval_zero
          simpa only [← mul_assoc, Units.inv_mul, one_mul, mul_zero] using h1
        rcases Polynomial.dvd_iff_isRoot.mpr hQ_root with ⟨Q', hQ'⟩
        refine ⟨Q', ?_⟩
        rw [hQ_S, hQ', Finset.prod_insert hνS]
        ring
    let P_bar : Polynomial (MvPolynomial (Fin r) k ⧸ J N₀) :=
      ∏ ν : Fin D, (Polynomial.X - Polynomial.C (zb ν))
    obtain ⟨Q_end, hQ_end⟩ : P_bar ∣ f.map π := hdvd_finset Finset.univ
    have hf_bar_monic : (f.map π).Monic := hf_monic.map π
    have hf_bar_deg : (f.map π).natDegree = D := (hf_monic.natDegree_map π).trans hf_deg
    have hP_bar_monic : P_bar.Monic :=
      Polynomial.monic_prod_of_monic _ _ fun ν _ => Polynomial.monic_X_sub_C (zb ν)
    have hP_bar_deg : P_bar.natDegree = D := by
      dsimp [P_bar]
      rw [Polynomial.natDegree_prod_of_monic _ _ (fun ν _ => Polynomial.monic_X_sub_C (zb ν))]
      simp
    have hQ_ne : Q_end ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hQ_end
      exact hf_bar_monic.ne_zero hQ_end
    have hlc_ne : P_bar.leadingCoeff * Q_end.leadingCoeff ≠ 0 := by
      rw [hP_bar_monic.leadingCoeff, one_mul]
      exact Polynomial.leadingCoeff_ne_zero.mpr hQ_ne
    have hQ_deg0 : Q_end.natDegree = 0 := by
      have hdeg_eq := congrArg Polynomial.natDegree hQ_end
      rw [hf_bar_deg, Polynomial.natDegree_mul' hlc_ne, hP_bar_deg] at hdeg_eq
      omega
    have hQ_eq1 : Q_end = 1 := by
      have hlc_eq := congrArg Polynomial.leadingCoeff hQ_end
      rw [hf_bar_monic.leadingCoeff, Polynomial.leadingCoeff_mul' hlc_ne,
        hP_bar_monic.leadingCoeff, one_mul, Polynomial.leadingCoeff, hQ_deg0] at hlc_eq
      rw [Polynomial.eq_C_of_natDegree_eq_zero hQ_deg0, ← hlc_eq, map_one]
    rw [hQ_eq1, mul_one] at hQ_end
    have hmap_prod : (∏ ν : Fin D, (Polynomial.X - Polynomial.C (z_tr ν))).map π = P_bar := by
      dsimp [P_bar, zb]
      simp [Polynomial.map_prod]
    intro j m hm
    have hdiff_mem :
        (f - ∏ ν : Fin D, (Polynomial.X - Polynomial.C (z_tr ν))).coeff j ∈ J N₀ := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change π ((f - ∏ ν : Fin D, (Polynomial.X - Polynomial.C (z_tr ν))).coeff j) = 0
      rw [← Polynomial.coeff_map, Polynomial.map_sub, hQ_end, hmap_prod, sub_self,
        Polynomial.coeff_zero]
    exact (hVB_iff_homog N₀ _).mp hdiff_mem m hm

  have hζ_obs : ∀ I : Finset (Fin D), 1 ≤ I.card → I.card < D →
      ∃ (j_I s_I : ℕ), j_I < I.card ∧ D < s_I ∧
        MvPolynomial.homogeneousComponent s_I
          ((∏ ν ∈ I,
            (Polynomial.X - Polynomial.C (∑ s ∈ Finset.range (s_I + 1), ζ ν s))).coeff j_I) ≠ 0 := by
    intro I hI_pos hI_lt
    let P_sub (S : Finset (Fin D)) (N : ℕ) : Polynomial (MvPolynomial (Fin r) k) :=
      ∏ ν ∈ S, (Polynomial.X - Polynomial.C (∑ s ∈ Finset.range N, ζ ν s))
    have hStab : ∀ (m N j : ℕ), m + 1 ≤ N →
        MvPolynomial.homogeneousComponent m ((P_sub I N).coeff j) =
          MvPolynomial.homogeneousComponent m ((P_sub I (m + 1)).coeff j) := by
      intro m N j hmN
      let π_m : MvPolynomial (Fin r) k →+* (MvPolynomial (Fin r) k ⧸ J (m + 1)) :=
        Ideal.Quotient.mk (J (m + 1))
      have hsum_eq : ∀ (ν : Fin D) (t : ℕ),
          π_m (∑ s ∈ Finset.range ((m + 1) + t), ζ ν s) =
            π_m (∑ s ∈ Finset.range (m + 1), ζ ν s) := by
        intro ν t
        induction t with
        | zero => rfl
        | succ t ih =>
          rw [← Nat.add_assoc (m + 1) t 1, Finset.sum_range_succ, map_add, ih]
          have hmem : ζ ν ((m + 1) + t) ∈ J (m + 1) :=
            hVB_mono (by omega) (hVB_of_homog (hζ_hom ν ((m + 1) + t)))
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, add_zero]
      have hP_map_eq : (P_sub I N).map π_m = (P_sub I (m + 1)).map π_m := by
        dsimp [P_sub]
        simp only [Polynomial.map_prod, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
        refine Finset.prod_congr rfl fun ν _ => ?_
        have hN_split : N = (m + 1) + (N - (m + 1)) := by omega
        conv_lhs => rw [hN_split]
        rw [hsum_eq ν (N - (m + 1))]
      have hcoeff_eq : π_m ((P_sub I N).coeff j) = π_m ((P_sub I (m + 1)).coeff j) := by
        rw [← Polynomial.coeff_map, ← Polynomial.coeff_map, hP_map_eq]
      have hsub_mem : (P_sub I N).coeff j - (P_sub I (m + 1)).coeff j ∈ J (m + 1) :=
        Ideal.Quotient.eq.mp hcoeff_eq
      have hhom0 : MvPolynomial.homogeneousComponent m
          ((P_sub I N).coeff j - (P_sub I (m + 1)).coeff j) = 0 :=
        (hVB_iff_homog (m + 1) _).mp hsub_mem m (Nat.lt_succ_self m)
      rw [LinearMap.map_sub] at hhom0
      exact sub_eq_zero.mp hhom0
    by_contra h_none
    simp only [not_exists, not_and, not_ne_iff] at h_none
    let g (j s : ℕ) : MvPolynomial (Fin r) k :=
      MvPolynomial.homogeneousComponent s ((P_sub I (s + 1)).coeff j)
    let a (j : ℕ) : MvPolynomial (Fin r) k := ∑ s ∈ Finset.range (D + 1), g j s
    let S_low : Polynomial (MvPolynomial (Fin r) k) :=
      ∑ j ∈ Finset.range I.card, Polynomial.monomial j (a j)
    let A_I : Polynomial (MvPolynomial (Fin r) k) := Polynomial.X ^ I.card + S_low
    have hA_coeff_lt : ∀ {j : ℕ}, j < I.card → A_I.coeff j = a j := by
      intro j hj
      dsimp [A_I, S_low]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.finsetSum_coeff]
      simp only [ne_of_lt hj, ↓reduceIte, zero_add, Polynomial.coeff_monomial,
        Finset.sum_ite_eq' (Finset.range I.card) j, Finset.mem_range.mpr hj]
    have hA_coeff_eq : A_I.coeff I.card = 1 := by
      dsimp [A_I, S_low]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.finsetSum_coeff]
      have h0 : ∑ i ∈ Finset.range I.card, (Polynomial.monomial i (a i)).coeff I.card = 0 := by
        refine Finset.sum_eq_zero fun i hi => ?_
        simp [Polynomial.coeff_monomial, ne_of_lt (Finset.mem_range.mp hi)]
      simp [h0]
    have hA_coeff_gt : ∀ {j : ℕ}, I.card < j → A_I.coeff j = 0 := by
      intro j hj
      dsimp [A_I, S_low]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.finsetSum_coeff]
      have h0 : ∑ i ∈ Finset.range I.card, (Polynomial.monomial i (a i)).coeff j = 0 := by
        refine Finset.sum_eq_zero fun i hi => ?_
        simp [Polynomial.coeff_monomial, ne_of_lt ((Finset.mem_range.mp hi).trans hj)]
      simp [ne_of_gt hj, h0]
    have hA_deg : A_I.natDegree = I.card := by
      apply le_antisymm
      · exact Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun j hj => hA_coeff_gt hj
      · apply Polynomial.le_natDegree_of_ne_zero
        rw [hA_coeff_eq]
        exact one_ne_zero
    have hA_monic : A_I.Monic := by
      rw [Polynomial.Monic.def, Polynomial.leadingCoeff, hA_deg, hA_coeff_eq]
    let R_rem : Polynomial (MvPolynomial (Fin r) k) := f %ₘ A_I
    let N₀ : ℕ := max (D + 1) (R_rem.support.sup (fun j => (R_rem.coeff j).totalDegree) + 1)
    have hDN₀ : D + 1 ≤ N₀ := le_max_left _ _
    have hN₀_pos : 1 ≤ N₀ := by omega
    let π : MvPolynomial (Fin r) k →+* (MvPolynomial (Fin r) k ⧸ J N₀) :=
      Ideal.Quotient.mk (J N₀)
    have : Nontrivial (MvPolynomial (Fin r) k ⧸ J N₀) := hJ_nontrivial hN₀_pos
    have hP_sub_monic : (P_sub I N₀).Monic :=
      Polynomial.monic_prod_of_monic _ _ fun ν _ => Polynomial.monic_X_sub_C _
    have hP_sub_deg : (P_sub I N₀).natDegree = I.card := by
      dsimp [P_sub]
      rw [Polynomial.natDegree_prod_of_monic _ _ (fun ν _ => Polynomial.monic_X_sub_C _)]
      simp only [Polynomial.natDegree_X_sub_C, Finset.sum_const, smul_eq_mul, mul_one]
    have hA_cong : A_I.map π = (P_sub I N₀).map π := by
      apply Polynomial.ext
      intro j
      rw [Polynomial.coeff_map, Polynomial.coeff_map]
      rcases lt_trichotomy j I.card with hj | rfl | hj
      · rw [hA_coeff_lt hj, Ideal.Quotient.eq, hJ_mem_iff]
        intro m hm
        rw [LinearMap.map_sub, hStab m N₀ j (by omega)]
        change MvPolynomial.homogeneousComponent m (a j) - g j m = 0
        dsimp [a]
        rw [map_sum]
        have hsum_ite : (∑ s ∈ Finset.range (D + 1), MvPolynomial.homogeneousComponent m (g j s)) =
            ∑ s ∈ Finset.range (D + 1), if m = s then g j s else 0 := by
          refine Finset.sum_congr rfl fun s _ => ?_
          exact MvPolynomial.homogeneousComponent_of_mem (MvPolynomial.homogeneousComponent_mem s _)
        rw [hsum_ite, Finset.sum_ite_eq (Finset.range (D + 1)) m]
        by_cases hmD : m ≤ D
        · have hmem_m : m ∈ Finset.range (D + 1) := Finset.mem_range.mpr (by omega)
          simp [hmem_m]
        · have hnmem_m : m ∉ Finset.range (D + 1) := by rw [Finset.mem_range]; omega
          have hg0 : g j m = 0 := h_none j m hj (by omega)
          simp [hnmem_m, hg0]
      · have hP_lc : (P_sub I N₀).coeff I.card = 1 := by
          rw [← hP_sub_deg, ← Polynomial.leadingCoeff, hP_sub_monic.leadingCoeff]
        rw [hA_coeff_eq, hP_lc]
      · rw [hA_coeff_gt hj, Polynomial.coeff_eq_zero_of_natDegree_lt (hP_sub_deg.trans_lt hj)]
    have hf_map_eq : f.map π = (P_sub Finset.univ N₀).map π := by
      apply Polynomial.ext
      intro j
      rw [Polynomial.coeff_map, Polynomial.coeff_map, Ideal.Quotient.eq, ← Polynomial.coeff_sub,
        hJ_mem_iff]
      intro m hm
      exact hζ_cong N₀ hN₀_pos j m hm
    have hP_univ_split : P_sub Finset.univ N₀ = P_sub I N₀ * P_sub Iᶜ N₀ := by
      dsimp [P_sub]
      exact (Finset.prod_mul_prod_compl I _).symm
    have hA_dvd_map : A_I.map π ∣ f.map π := by
      refine ⟨(P_sub Iᶜ N₀).map π, ?_⟩
      rw [hf_map_eq, hP_univ_split, Polynomial.map_mul, hA_cong]
    have hR_map_zero : R_rem.map π = 0 := by
      dsimp [R_rem]
      rw [Polynomial.map_modByMonic π hA_monic]
      exact (Polynomial.modByMonic_eq_zero_iff_dvd (hA_monic.map π)).mpr hA_dvd_map
    have hR_zero : R_rem = 0 := by
      apply Polynomial.ext
      intro j
      rw [Polynomial.coeff_zero]
      by_cases hj_supp : j ∈ R_rem.support
      · have hmemJ : R_rem.coeff j ∈ J N₀ := by
          rw [← Ideal.Quotient.eq_zero_iff_mem]
          change π (R_rem.coeff j) = 0
          rw [← Polynomial.coeff_map, hR_map_zero, Polynomial.coeff_zero]
        have hdeg_lt : (R_rem.coeff j).totalDegree < N₀ := by
          have hle1 : (R_rem.coeff j).totalDegree ≤
              R_rem.support.sup (fun i => (R_rem.coeff i).totalDegree) :=
            Finset.le_sup (f := fun i => (R_rem.coeff i).totalDegree) hj_supp
          have hle2 : R_rem.support.sup (fun i => (R_rem.coeff i).totalDegree) + 1 ≤ N₀ :=
            le_max_right _ _
          omega
        exact hJ_eq_zero_of_totalDegree_lt hmemJ hdeg_lt
      · exact Polynomial.notMem_support_iff.mp hj_supp
    have hA_dvd : A_I ∣ f := (Polynomial.modByMonic_eq_zero_iff_dvd hA_monic).mp hR_zero
    exact hf_ndvd A_I hA_monic (hA_deg ▸ hI_pos) (hA_deg ▸ hI_lt) hA_dvd

  exact ⟨ζ, hζ_hom, hζ_zero, hζ_cong, hζ_obs⟩

theorem weil_ternary_slice_irred_of_newton_obstructions (k : Type u) [Field k] [IsAlgClosed k] (r D : ℕ) (hr : 2 ≤ r) (hD : 2 ≤ D)
    (P₁ : MvPolynomial (Fin (r + 2)) k)
    (hP₁_hom : P₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (r + 2)) k D)
    (hP₁_e0 : MvPolynomial.eval (Pi.single 0 1) P₁ = 1)
    (f : Polynomial (MvPolynomial (Fin r) k))
    (hf_eq : f = MvPolynomial.eval₂ (Polynomial.C.comp MvPolynomial.C)
      (Fin.cons Polynomial.X
        (Fin.cons 1 (fun i : Fin r => Polynomial.C (MvPolynomial.X i))))
      P₁)
    (α : Fin D → k) (hα_inj : Function.Injective α)
    (hf₀ : Polynomial.map MvPolynomial.constantCoeff f =
      ∏ ν : Fin D, (Polynomial.X - Polynomial.C (α ν)))
    (ζ : Fin D → ℕ → MvPolynomial (Fin r) k)
    (hζ_hom : ∀ (ν : Fin D) (m : ℕ), ζ ν m ∈ MvPolynomial.homogeneousSubmodule (Fin r) k m)
    (hζ_zero : ∀ ν : Fin D, ζ ν 0 = MvPolynomial.C (α ν))
    (hζ_cong : ∀ (N₀ : ℕ), 1 ≤ N₀ → ∀ (j m : ℕ), m < N₀ →
      MvPolynomial.homogeneousComponent m
        ((f - ∏ ν : Fin D,
          (Polynomial.X - Polynomial.C (∑ s ∈ Finset.range N₀, ζ ν s))).coeff j) = 0)
    (hζ_obs : ∀ I : Finset (Fin D), 1 ≤ I.card → I.card < D →
      ∃ (j_I s_I : ℕ), j_I < I.card ∧ D < s_I ∧
        MvPolynomial.homogeneousComponent s_I
          ((∏ ν ∈ I,
            (Polynomial.X - Polynomial.C (∑ s ∈ Finset.range (s_I + 1), ζ ν s))).coeff j_I) ≠ 0) :
    ∃ (c : Fin r → k),
      let P_c : MvPolynomial (Fin 3) k :=
        MvPolynomial.eval₂ MvPolynomial.C
          (Fin.cons (MvPolynomial.X 0)
            (Fin.cons (MvPolynomial.X 1)
              (fun i : Fin r => MvPolynomial.C (c i) * MvPolynomial.X 2)))
          P₁
      P_c ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k D ∧
      Irreducible P_c :=
by
  classical
  have _ := hr
  have : Infinite k := IsAlgClosed.instInfinite

  
  let ℱ : Finset (Finset (Fin D)) :=
    (Finset.univ : Finset (Fin D)).powerset.filter (fun I => 1 ≤ I.card ∧ I.card < D)
  let j_fn : Finset (Fin D) → ℕ := fun I =>
    if hI : 1 ≤ I.card ∧ I.card < D then Classical.choose (hζ_obs I hI.1 hI.2) else 0
  let s_fn : Finset (Fin D) → ℕ := fun I =>
    if hI : 1 ≤ I.card ∧ I.card < D then
      Classical.choose (Classical.choose_spec (hζ_obs I hI.1 hI.2))
    else 0
  let H_fn : Finset (Fin D) → MvPolynomial (Fin r) k := fun I =>
    MvPolynomial.homogeneousComponent (s_fn I)
      ((∏ ν ∈ I,
        (Polynomial.X - Polynomial.C (∑ s ∈ Finset.range (s_fn I + 1), ζ ν s))).coeff (j_fn I))
  have hObs_spec : ∀ I : Finset (Fin D), 1 ≤ I.card → I.card < D →
      j_fn I < I.card ∧ D < s_fn I ∧ H_fn I ≠ 0 := by
    intro I hI1 hID
    have hI : 1 ≤ I.card ∧ I.card < D := ⟨hI1, hID⟩
    have hspec := Classical.choose_spec (Classical.choose_spec (hζ_obs I hI.1 hI.2))
    dsimp only [H_fn, j_fn, s_fn]
    simp only [hI]
    exact hspec
  let H_prod : MvPolynomial (Fin r) k := ∏ I ∈ ℱ, H_fn I
  have hH_prod_ne : H_prod ≠ 0 := by
    rw [Finset.prod_ne_zero_iff]
    intro I hI
    rw [Finset.mem_filter] at hI
    exact (hObs_spec I hI.2.1 hI.2.2).2.2
  have h_exists_c : ∃ c : Fin r → k, MvPolynomial.eval c H_prod ≠ 0 := by
    by_contra hall
    simp only [not_exists, not_not] at hall
    apply hH_prod_ne
    rw [MvPolynomial.funext_iff]
    intro c
    rw [hall c, map_zero]
  obtain ⟨c, hc_prod⟩ := h_exists_c
  have hc_obs : ∀ I : Finset (Fin D), 1 ≤ I.card → I.card < D →
      MvPolynomial.eval c (H_fn I) ≠ 0 := by
    intro I hI1 hID
    have hI_mem : I ∈ ℱ :=
      Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr (Finset.subset_univ I), hI1, hID⟩
    rw [map_prod, Finset.prod_ne_zero_iff] at hc_prod
    exact hc_prod I hI_mem

  
  let g_slice : Fin (r + 2) → MvPolynomial (Fin 3) k :=
    Fin.cons (MvPolynomial.X 0)
      (Fin.cons (MvPolynomial.X 1)
        (fun i : Fin r => MvPolynomial.C (c i) * MvPolynomial.X 2))
  let P_c : MvPolynomial (Fin 3) k := MvPolynomial.eval₂ MvPolynomial.C g_slice P₁
  have hg_slice_hom : ∀ ν : Fin (r + 2), (g_slice ν).IsHomogeneous 1 := by
    intro ν
    refine Fin.cases ?_ (fun ν' => Fin.cases ?_ (fun i => ?_) ν') ν
    · simpa [g_slice] using MvPolynomial.isHomogeneous_X k (0 : Fin 3)
    · simpa [g_slice] using MvPolynomial.isHomogeneous_X k (1 : Fin 3)
    · simpa [g_slice] using (MvPolynomial.isHomogeneous_X k (2 : Fin 3)).C_mul (c i)
  have hPc_hom : P_c ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k D := by
    change P_c.IsHomogeneous D
    have hP₁_hom' : P₁.IsHomogeneous D := hP₁_hom
    have h1 := hP₁_hom'.eval₂ (MvPolynomial.C : k →+* MvPolynomial (Fin 3) k) g_slice
      (fun a => MvPolynomial.isHomogeneous_C (Fin 3) a) hg_slice_hom
    rwa [one_mul] at h1
  refine ⟨c, hPc_hom, ?_⟩

  have hPc_e0 : MvPolynomial.eval ![1, 0, 0] P_c = 1 := by
    let ψ₁ : MvPolynomial (Fin (r + 2)) k →+* k :=
      (MvPolynomial.eval ![1, 0, 0]).comp (MvPolynomial.eval₂Hom MvPolynomial.C g_slice)
    let ψ₂ : MvPolynomial (Fin (r + 2)) k →+* k :=
      MvPolynomial.eval (Pi.single 0 1)
    have hψ : ψ₁ = ψ₂ := by
      apply MvPolynomial.ringHom_ext'
      · ext a; simp [ψ₁, ψ₂]
      · intro ν
        refine Fin.cases ?_ (fun ν' => Fin.cases ?_ (fun i => ?_) ν') ν
        · simp [ψ₁, ψ₂, g_slice]
        · simp [ψ₁, ψ₂, g_slice]
        · simp [ψ₁, ψ₂, g_slice]
    change ψ₁ P₁ = 1
    rw [hψ]
    exact hP₁_e0

  let δ : MvPolynomial (Fin 3) k →+* Polynomial (Polynomial k) :=
    MvPolynomial.eval₂Hom (Polynomial.C.comp Polynomial.C)
      ![Polynomial.X, 1, Polynomial.C Polynomial.X]
  let ρ_c : MvPolynomial (Fin r) k →+* Polynomial k :=
    MvPolynomial.eval₂Hom Polynomial.C (fun i : Fin r => Polynomial.C (c i) * Polynomial.X)

  have hδ_Pc : δ P_c = Polynomial.map ρ_c f := by
    let Φ₁ : MvPolynomial (Fin (r + 2)) k →+* Polynomial (Polynomial k) :=
      δ.comp (MvPolynomial.eval₂Hom MvPolynomial.C g_slice)
    let Φ₂ : MvPolynomial (Fin (r + 2)) k →+* Polynomial (Polynomial k) :=
      (Polynomial.mapRingHom ρ_c).comp
        (MvPolynomial.eval₂Hom (Polynomial.C.comp MvPolynomial.C)
          (Fin.cons Polynomial.X
            (Fin.cons 1 (fun i : Fin r => Polynomial.C (MvPolynomial.X i)))))
    have hΦ : Φ₁ = Φ₂ := by
      apply MvPolynomial.ringHom_ext'
      · ext a
        simp [Φ₁, Φ₂, δ, ρ_c]
      · intro ν
        refine Fin.cases ?_ (fun ν' => Fin.cases ?_ (fun i => ?_) ν') ν
        · simp [Φ₁, Φ₂, δ, ρ_c, g_slice]
        · simp [Φ₁, Φ₂, δ, ρ_c, g_slice]
        · simp [Φ₁, Φ₂, δ, ρ_c, g_slice, Polynomial.C_mul]
    rw [hf_eq]
    exact DFunLike.congr_fun hΦ P₁

  have hρ_const : Polynomial.constantCoeff.comp ρ_c = MvPolynomial.constantCoeff := by
    apply MvPolynomial.ringHom_ext'
    · ext a; simp [ρ_c]
    · intro i; simp [ρ_c]

  have hρ_monomial : ∀ (d : Fin r →₀ ℕ) (a : k),
      ρ_c (MvPolynomial.monomial d a) =
        Polynomial.monomial (Finsupp.degree d) (a * ∏ i ∈ d.support, c i ^ d i) := by
    intro d a
    change MvPolynomial.eval₂ Polynomial.C (fun i : Fin r => Polynomial.C (c i) * Polynomial.X)
        (MvPolynomial.monomial d a) = _
    rw [MvPolynomial.eval₂_monomial]
    have hprod : (d.prod fun i e => (Polynomial.C (c i) * Polynomial.X : Polynomial k) ^ e) =
        Polynomial.C (∏ i ∈ d.support, c i ^ d i) * Polynomial.X ^ Finsupp.degree d := by
      change (∏ i ∈ d.support, (Polynomial.C (c i) * Polynomial.X : Polynomial k) ^ d i) = _
      calc (∏ i ∈ d.support, (Polynomial.C (c i) * Polynomial.X : Polynomial k) ^ d i)
          = ∏ i ∈ d.support, (Polynomial.C (c i ^ d i) * Polynomial.X ^ d i) := by
              refine Finset.prod_congr rfl fun i _ => ?_
              rw [mul_pow, Polynomial.C_pow]
        _ = (∏ i ∈ d.support, Polynomial.C (c i ^ d i)) *
              (∏ i ∈ d.support, (Polynomial.X : Polynomial k) ^ d i) :=
              Finset.prod_mul_distrib
        _ = Polynomial.C (∏ i ∈ d.support, c i ^ d i) * Polynomial.X ^ Finsupp.degree d := by
              rw [← map_prod, Finset.prod_pow_eq_pow_sum, ← Finsupp.degree_apply]
    rw [hprod, ← mul_assoc, ← Polynomial.C_mul, Polynomial.C_mul_X_pow_eq_monomial]

  have hρ_coeff : ∀ (p : MvPolynomial (Fin r) k) (m : ℕ),
      (ρ_c p).coeff m = MvPolynomial.eval c (MvPolynomial.homogeneousComponent m p) := by
    intro p m
    conv_lhs => rw [MvPolynomial.as_sum p]
    rw [map_sum, Polynomial.finsetSum_coeff, MvPolynomial.homogeneousComponent_apply, map_sum]
    simp_rw [hρ_monomial, Polynomial.coeff_monomial, MvPolynomial.eval_monomial]
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl fun d _ => ?_
    rfl

  
  by_contra hPc_not_irred
  have hPc_ne : P_c ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hPc_e0
    exact zero_ne_one hPc_e0
  have hPc_hom' : P_c.IsHomogeneous D := hPc_hom
  have hPc_tdeg : P_c.totalDegree = D := hPc_hom'.totalDegree hPc_ne
  have hPc_not_unit : ¬ IsUnit P_c := by
    rw [MvPolynomial.isUnit_iff_totalDegree_of_isReduced]
    intro hU
    omega
  rw [irreducible_iff, not_and_or] at hPc_not_irred
  rcases hPc_not_irred with h_nu | h_prod
  · exact h_nu hPc_not_unit
  simp only [not_forall, Classical.not_imp, not_or] at h_prod
  obtain ⟨A_raw, B_raw, hPc_mul₀, hA_not_unit, hB_not_unit⟩ := h_prod
  have hPc_mul : P_c = A_raw * B_raw := hPc_mul₀
  have hAB_ne : A_raw * B_raw ≠ 0 := hPc_mul ▸ hPc_ne
  have hA_ne : A_raw ≠ 0 := left_ne_zero_of_mul hAB_ne
  have hB_ne : B_raw ≠ 0 := right_ne_zero_of_mul hAB_ne

  let d₁ : ℕ := A_raw.totalDegree
  let d₂ : ℕ := B_raw.totalDegree
  have hd_sum : d₁ + d₂ = D := by
    dsimp only [d₁, d₂]
    rw [← MvPolynomial.totalDegree_mul_of_isDomain hA_ne hB_ne, ← hPc_mul, hPc_tdeg]

  have hMinComp : ∀ (Q : MvPolynomial (Fin 3) k), Q ≠ 0 →
      ∃ q_min : ℕ,
        q_min ≤ Q.totalDegree ∧
        (∀ d ∈ Q.support, q_min ≤ Finsupp.degree d) ∧
        (∀ i < q_min, MvPolynomial.homogeneousComponent i Q = 0) ∧
        MvPolynomial.homogeneousComponent q_min Q ≠ 0 := by
    intro Q hQ
    have hsupp : Q.support.Nonempty := MvPolynomial.support_nonempty.mpr hQ
    let D_Q : Finset ℕ := Q.support.image Finsupp.degree
    let q_min : ℕ := D_Q.min' (hsupp.image Finsupp.degree)
    have hq_mem : q_min ∈ D_Q := Finset.min'_mem D_Q (hsupp.image Finsupp.degree)
    obtain ⟨m₀, hm₀_supp, hm₀_deg⟩ := Finset.mem_image.mp hq_mem
    have hle_tot : q_min ≤ Q.totalDegree := by
      rw [← hm₀_deg, Finsupp.degree_apply]
      exact MvPolynomial.le_totalDegree hm₀_supp
    have hmin_le : ∀ d ∈ Q.support, q_min ≤ Finsupp.degree d := fun d hd =>
      Finset.min'_le D_Q _ (Finset.mem_image_of_mem Finsupp.degree hd)
    have hlt_zero : ∀ i < q_min, MvPolynomial.homogeneousComponent i Q = 0 := by
      intro i hi
      apply MvPolynomial.homogeneousComponent_eq_zero'
      intro d hd hdeg
      have := hmin_le d hd
      omega
    have hne_zero : MvPolynomial.homogeneousComponent q_min Q ≠ 0 := by
      intro h0
      have hc : (MvPolynomial.homogeneousComponent q_min Q).coeff m₀ = 0 := by
        rw [h0]; rfl
      simp only [MvPolynomial.coeff_homogeneousComponent, hm₀_deg, ↓reduceIte] at hc
      exact (MvPolynomial.mem_support_iff.mp hm₀_supp) hc
    exact ⟨q_min, hle_tot, hmin_le, hlt_zero, hne_zero⟩

  obtain ⟨a_min, ha_le, ha_min_supp, ha_lt_zero, ha_min_ne⟩ := hMinComp A_raw hA_ne
  obtain ⟨b_min, hb_le, hb_min_supp, hb_lt_zero, hb_min_ne⟩ := hMinComp B_raw hB_ne

  have hComp_min : MvPolynomial.homogeneousComponent (a_min + b_min) P_c =
      MvPolynomial.homogeneousComponent a_min A_raw *
        MvPolynomial.homogeneousComponent b_min B_raw := by
    have hP_exp : P_c =
        ∑ i ∈ Finset.range (d₁ + 1), ∑ j ∈ Finset.range (d₂ + 1),
          MvPolynomial.homogeneousComponent i A_raw *
            MvPolynomial.homogeneousComponent j B_raw := by
      rw [hPc_mul]
      conv_lhs =>
        rw [← MvPolynomial.sum_homogeneousComponent A_raw,
          ← MvPolynomial.sum_homogeneousComponent B_raw]
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.mul_sum]
    conv_lhs => rw [hP_exp]
    simp_rw [map_sum]
    rw [Finset.sum_eq_single a_min]
    · rw [Finset.sum_eq_single b_min]
      · have hmem : MvPolynomial.homogeneousComponent a_min A_raw *
            MvPolynomial.homogeneousComponent b_min B_raw ∈
              MvPolynomial.homogeneousSubmodule (Fin 3) k (a_min + b_min) :=
          (MvPolynomial.homogeneousComponent_mem a_min A_raw).mul
            (MvPolynomial.homogeneousComponent_mem b_min B_raw)
        simp only [MvPolynomial.homogeneousComponent_of_mem hmem, ↓reduceIte]
      · intro j _ hj_ne
        by_cases hj_lt : j < b_min
        · rw [hb_lt_zero j hj_lt, mul_zero, map_zero]
        · have hmem : MvPolynomial.homogeneousComponent a_min A_raw *
              MvPolynomial.homogeneousComponent j B_raw ∈
                MvPolynomial.homogeneousSubmodule (Fin 3) k (a_min + j) :=
            (MvPolynomial.homogeneousComponent_mem a_min A_raw).mul
              (MvPolynomial.homogeneousComponent_mem j B_raw)
          have hne_sum : a_min + b_min ≠ a_min + j := by omega
          simp only [MvPolynomial.homogeneousComponent_of_mem hmem, hne_sum, ↓reduceIte]
      · intro hmem
        exact absurd (Finset.mem_range.mpr (by omega)) hmem
    · intro i _ hi_ne
      refine Finset.sum_eq_zero fun j _ => ?_
      by_cases hi_lt : i < a_min
      · rw [ha_lt_zero i hi_lt, zero_mul, map_zero]
      · by_cases hj_lt : j < b_min
        · rw [hb_lt_zero j hj_lt, mul_zero, map_zero]
        · have hmem : MvPolynomial.homogeneousComponent i A_raw *
              MvPolynomial.homogeneousComponent j B_raw ∈
                MvPolynomial.homogeneousSubmodule (Fin 3) k (i + j) :=
            (MvPolynomial.homogeneousComponent_mem i A_raw).mul
              (MvPolynomial.homogeneousComponent_mem j B_raw)
          have hne_sum : a_min + b_min ≠ i + j := by omega
          simp only [MvPolynomial.homogeneousComponent_of_mem hmem, hne_sum, ↓reduceIte]
    · intro hmem
      exact absurd (Finset.mem_range.mpr (by omega)) hmem

  have hab_eq_D : a_min + b_min = D := by
    have hne : MvPolynomial.homogeneousComponent (a_min + b_min) P_c ≠ 0 := by
      rw [hComp_min]
      exact mul_ne_zero ha_min_ne hb_min_ne
    rw [MvPolynomial.homogeneousComponent_of_mem hPc_hom] at hne
    by_contra hne_D
    simp only [hne_D, ↓reduceIte, ne_eq, not_true_eq_false] at hne

  have ha_eq : a_min = d₁ := by omega
  have hb_eq : b_min = d₂ := by omega

  have hA_raw_hom : A_raw.IsHomogeneous d₁ := by
    have hsum := MvPolynomial.sum_homogeneousComponent A_raw
    change ∑ i ∈ Finset.range (d₁ + 1), MvPolynomial.homogeneousComponent i A_raw = A_raw at hsum
    rw [Finset.sum_eq_single d₁] at hsum
    · rw [← hsum]
      exact MvPolynomial.homogeneousComponent_mem d₁ A_raw
    · intro i hi hi_ne
      have hi_lt : i < a_min := by
        rw [Finset.mem_range] at hi
        omega
      exact ha_lt_zero i hi_lt
    · intro hmem
      exact absurd (Finset.mem_range.mpr (Nat.lt_succ_self d₁)) hmem

  have hB_raw_hom : B_raw.IsHomogeneous d₂ := by
    have hsum := MvPolynomial.sum_homogeneousComponent B_raw
    change ∑ i ∈ Finset.range (d₂ + 1), MvPolynomial.homogeneousComponent i B_raw = B_raw at hsum
    rw [Finset.sum_eq_single d₂] at hsum
    · rw [← hsum]
      exact MvPolynomial.homogeneousComponent_mem d₂ B_raw
    · intro i hi hi_ne
      have hi_lt : i < b_min := by
        rw [Finset.mem_range] at hi
        omega
      exact hb_lt_zero i hi_lt
    · intro hmem
      exact absurd (Finset.mem_range.mpr (Nat.lt_succ_self d₂)) hmem

  have hu_AB : MvPolynomial.eval ![1, 0, 0] A_raw * MvPolynomial.eval ![1, 0, 0] B_raw = 1 := by
    rw [← map_mul, ← hPc_mul, hPc_e0]
  let u_A : k := MvPolynomial.eval ![1, 0, 0] A_raw
  let u_B : k := MvPolynomial.eval ![1, 0, 0] B_raw
  have hu_A_ne : u_A ≠ 0 := left_ne_zero_of_mul_eq_one hu_AB

  have hd₁_pos : 1 ≤ d₁ := by
    by_contra hd₁0
    have hd₁_eq0 : d₁ = 0 := by omega
    apply hA_not_unit
    rw [MvPolynomial.isUnit_iff_totalDegree_of_isReduced]
    refine ⟨isUnit_iff_ne_zero.mpr ?_, hd₁_eq0⟩
    intro hc0
    have hsum := MvPolynomial.sum_homogeneousComponent A_raw
    change ∑ i ∈ Finset.range (d₁ + 1), MvPolynomial.homogeneousComponent i A_raw = A_raw at hsum
    rw [hd₁_eq0, Finset.sum_range_one] at hsum
    apply hA_ne
    rw [← hsum]
    ext d
    rw [MvPolynomial.coeff_homogeneousComponent]
    change (if Finsupp.degree d = 0 then A_raw.coeff d else 0) = 0
    split_ifs with hd0
    · have hd_eq0 : d = 0 := by
        rw [Finsupp.degree_apply] at hd0
        ext i
        rw [Finsupp.coe_zero, Pi.zero_apply]
        by_contra hi_ne
        have hle := Finset.single_le_sum (f := fun x => d x) (fun _ _ => Nat.zero_le _)
          (Finsupp.mem_support_iff.mpr hi_ne)
        omega
      rw [hd_eq0]
      exact hc0
    · rfl

  have hd₂_pos : 1 ≤ d₂ := by
    by_contra hd₂0
    have hd₂_eq0 : d₂ = 0 := by omega
    apply hB_not_unit
    rw [MvPolynomial.isUnit_iff_totalDegree_of_isReduced]
    refine ⟨isUnit_iff_ne_zero.mpr ?_, hd₂_eq0⟩
    intro hc0
    have hsum := MvPolynomial.sum_homogeneousComponent B_raw
    change ∑ i ∈ Finset.range (d₂ + 1), MvPolynomial.homogeneousComponent i B_raw = B_raw at hsum
    rw [hd₂_eq0, Finset.sum_range_one] at hsum
    apply hB_ne
    rw [← hsum]
    ext d
    rw [MvPolynomial.coeff_homogeneousComponent]
    change (if Finsupp.degree d = 0 then B_raw.coeff d else 0) = 0
    split_ifs with hd0
    · have hd_eq0 : d = 0 := by
        rw [Finsupp.degree_apply] at hd0
        ext i
        rw [Finsupp.coe_zero, Pi.zero_apply]
        by_contra hi_ne
        have hle := Finset.single_le_sum (f := fun x => d x) (fun _ _ => Nat.zero_le _)
          (Finsupp.mem_support_iff.mpr hi_ne)
        omega
      rw [hd_eq0]
      exact hc0
    · rfl

  let A_hom : MvPolynomial (Fin 3) k := MvPolynomial.C u_A⁻¹ * A_raw
  let B_hom : MvPolynomial (Fin 3) k := MvPolynomial.C u_A * B_raw
  have hPc_AB_hom : P_c = A_hom * B_hom := by
    dsimp only [A_hom, B_hom]
    rw [mul_mul_mul_comm, ← MvPolynomial.C_mul, inv_mul_cancel₀ hu_A_ne, map_one, one_mul, hPc_mul]
  have hA_hom_deg : A_hom.IsHomogeneous d₁ := hA_raw_hom.C_mul u_A⁻¹
  have hB_hom_deg : B_hom.IsHomogeneous d₂ := hB_raw_hom.C_mul u_A
  have hA_hom_e0 : MvPolynomial.eval ![1, 0, 0] A_hom = 1 := by
    simp only [A_hom, map_mul, MvPolynomial.eval_C]
    exact inv_mul_cancel₀ hu_A_ne
  have hB_hom_e0 : MvPolynomial.eval ![1, 0, 0] B_hom = 1 := by
    simp only [B_hom, map_mul, MvPolynomial.eval_C]
    exact hu_AB

  have hδ_monomial : ∀ (m : Fin 3 →₀ ℕ) (a : k),
      δ (MvPolynomial.monomial m a) =
        Polynomial.monomial (m 0) (Polynomial.monomial (m 2) a) := by
    intro m a
    change MvPolynomial.eval₂ (Polynomial.C.comp Polynomial.C)
        ![Polynomial.X, 1, Polynomial.C Polynomial.X] (MvPolynomial.monomial m a) = _
    rw [MvPolynomial.eval₂_monomial]
    have hprod : (m.prod fun i e =>
          ((![Polynomial.X, 1, Polynomial.C Polynomial.X] :
            Fin 3 → Polynomial (Polynomial k)) i) ^ e) =
        Polynomial.X ^ m 0 * Polynomial.C (Polynomial.X ^ m 2) := by
      rw [Finsupp.prod_of_support_subset m (Finset.subset_univ m.support) _ (fun _ _ => pow_zero _),
        Fin.prod_univ_three]
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
        Matrix.tail_cons, one_pow, mul_one, Polynomial.C_pow]
    simp only [RingHom.comp_apply]
    rw [hprod, ← mul_assoc, mul_right_comm (Polynomial.C (Polynomial.C a)),
      ← Polynomial.C_mul, Polynomial.C_mul_X_pow_eq_monomial, Polynomial.C_mul_X_pow_eq_monomial]

  have hδ_coeff : ∀ (F : MvPolynomial (Fin 3) k) (j s : ℕ),
      ((δ F).coeff j).coeff s =
        ∑ m ∈ F.support, if m 0 = j then (if m 2 = s then F.coeff m else 0) else 0 := by
    intro F j s
    conv_lhs => rw [MvPolynomial.as_sum F]
    rw [map_sum, Polynomial.finsetSum_coeff, Polynomial.finsetSum_coeff]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [hδ_monomial]
    by_cases hm0 : m 0 = j
    · subst hm0
      simp only [↓reduceIte, Polynomial.coeff_monomial]
    · simp only [hm0, ↓reduceIte, Polynomial.coeff_monomial, Polynomial.coeff_zero]

  have hδ_hom_props : ∀ (F : MvPolynomial (Fin 3) k) (d : ℕ),
      F.IsHomogeneous d → MvPolynomial.eval ![1, 0, 0] F = 1 →
      (δ F).Monic ∧ (δ F).natDegree = d ∧
        ∀ (j s : ℕ), d < j + s → ((δ F).coeff j).coeff s = 0 := by
    intro F d hF hFe0
    have hm_sum : ∀ m ∈ F.support, m 0 + m 1 + m 2 = d := by
      intro m hm
      have hdeg : Finsupp.degree m = d := by
        have hcomp : MvPolynomial.homogeneousComponent d F = F := by
          simp only [MvPolynomial.homogeneousComponent_of_mem hF, ↓reduceIte]
        have hc := congrArg (fun p : MvPolynomial (Fin 3) k => p.coeff m) hcomp
        rw [MvPolynomial.coeff_homogeneousComponent] at hc
        by_contra hne
        simp only [hne, ↓reduceIte] at hc
        exact (MvPolynomial.mem_support_iff.mp hm) hc.symm
      rw [Finsupp.degree_apply] at hdeg
      have hsub : (∑ i ∈ m.support, m i) = ∑ i : Fin 3, m i :=
        Finset.sum_subset (Finset.subset_univ m.support)
          (fun i _ hi => Finsupp.notMem_support_iff.mp hi)
      rw [Fin.sum_univ_three] at hsub
      exact hsub.symm.trans hdeg
    have hvan : ∀ (j s : ℕ), d < j + s → ((δ F).coeff j).coeff s = 0 := by
      intro j s hlt
      rw [hδ_coeff]
      refine Finset.sum_eq_zero fun m hm => ?_
      have hms := hm_sum m hm
      split_ifs with h0 h2
      · omega
      · rfl
      · rfl
    have hcoeff_gt : ∀ j : ℕ, d < j → (δ F).coeff j = 0 := by
      intro j hj
      ext s
      rw [Polynomial.coeff_zero]
      exact hvan j s (by omega)
    have hcoeff_d : (δ F).coeff d = 1 := by
      ext s
      rcases eq_or_ne s 0 with rfl | hs
      · rw [Polynomial.coeff_one_zero, hδ_coeff, ← hFe0, MvPolynomial.eval_eq]
        refine Finset.sum_congr rfl fun m hm => ?_
        have hms := hm_sum m hm
        have hprod_m : (∏ i ∈ m.support, (![1, 0, 0] : Fin 3 → k) i ^ m i) =
            (1 : k) ^ m 0 * (0 : k) ^ m 1 * (0 : k) ^ m 2 := by
          have hp : (∏ i ∈ m.support, (![1, 0, 0] : Fin 3 → k) i ^ m i) =
              ∏ i : Fin 3, (![1, 0, 0] : Fin 3 → k) i ^ m i :=
            Finset.prod_subset (Finset.subset_univ m.support)
              (fun i _ hi => by rw [Finsupp.notMem_support_iff.mp hi, pow_zero])
          rw [hp, Fin.prod_univ_three]
          simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
            Matrix.head_cons, Matrix.tail_cons]
        rw [hprod_m, one_pow, one_mul]
        by_cases hm0 : m 0 = d
        · have hm1 : m 1 = 0 := by omega
          have hm2 : m 2 = 0 := by omega
          simp [hm0, hm1, hm2]
        · simp only [hm0, ↓reduceIte]
          have hm12 : m 1 ≠ 0 ∨ m 2 ≠ 0 := by omega
          rcases hm12 with hm1 | hm2
          · simp [zero_pow hm1]
          · simp [zero_pow hm2]
      · simp only [Polynomial.coeff_one, hs, ↓reduceIte]
        exact hvan d s (by omega)
    have hdeg_le : (δ F).natDegree ≤ d := Polynomial.natDegree_le_iff_coeff_eq_zero.mpr hcoeff_gt
    have hdeg_eq : (δ F).natDegree = d :=
      Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hdeg_le (by rw [hcoeff_d]; exact one_ne_zero)
    have hmon : (δ F).Monic := by
      rw [Polynomial.Monic.def, Polynomial.leadingCoeff, hdeg_eq, hcoeff_d]
    exact ⟨hmon, hdeg_eq, hvan⟩

  let A : Polynomial (Polynomial k) := δ A_hom
  let B : Polynomial (Polynomial k) := δ B_hom
  obtain ⟨hA_mon, hA_deg, hA_van⟩ := hδ_hom_props A_hom d₁ hA_hom_deg hA_hom_e0
  obtain ⟨hB_mon, hB_deg, _⟩ := hδ_hom_props B_hom d₂ hB_hom_deg hB_hom_e0
  let g : Polynomial (Polynomial k) := Polynomial.map ρ_c f
  have hg_eq : g = A * B := by
    dsimp only [g, A, B]
    rw [← hδ_Pc, hPc_AB_hom, map_mul]

  
  have hProdDvd : ∀ {R : Type u} [CommRing R] (S : Finset (Fin D)) (w : Fin D → R)
      (P : Polynomial R),
      (∀ ν ∈ S, ∀ μ ∈ S, ν ≠ μ → IsUnit (w ν - w μ)) →
      (∀ ν ∈ S, P.eval (w ν) = 0) →
      (∏ ν ∈ S, (Polynomial.X - Polynomial.C (w ν))) ∣ P := by
    intro R _ S w P hsep hroots
    induction S using Finset.induction_on with
    | empty => simp
    | insert a S' ha ih =>
      have hsep' : ∀ ν ∈ S', ∀ μ ∈ S', ν ≠ μ → IsUnit (w ν - w μ) := fun ν hν μ hμ =>
        hsep ν (Finset.mem_insert_of_mem hν) μ (Finset.mem_insert_of_mem hμ)
      have hroots' : ∀ ν ∈ S', P.eval (w ν) = 0 := fun ν hν =>
        hroots ν (Finset.mem_insert_of_mem hν)
      obtain ⟨Q_rem, hQ_rem⟩ := ih hsep' hroots'
      have ha_eval : P.eval (w a) = 0 := hroots a (Finset.mem_insert_self a S')
      rw [hQ_rem, Polynomial.eval_mul, Polynomial.eval_prod] at ha_eval
      have hprod_eq : (∏ ν ∈ S', (Polynomial.X - Polynomial.C (w ν)).eval (w a)) =
          ∏ ν ∈ S', (w a - w ν) := by
        refine Finset.prod_congr rfl fun ν _ => ?_
        simp
      rw [hprod_eq] at ha_eval
      have hu_prod : IsUnit (∏ ν ∈ S', (w a - w ν)) := by
        rw [IsUnit.prod_iff]
        intro ν hν
        have hne : a ≠ ν := fun heq => ha (heq ▸ hν)
        exact hsep a (Finset.mem_insert_self a S') ν (Finset.mem_insert_of_mem hν) hne
      have hQ_root : Q_rem.IsRoot (w a) := hu_prod.mul_right_eq_zero.mp ha_eval
      obtain ⟨Q₂, hQ₂⟩ := Polynomial.dvd_iff_isRoot.mpr hQ_root
      refine ⟨Q₂, ?_⟩
      rw [Finset.prod_insert ha, hQ_rem, hQ₂]
      ring

  have hMonicEq : ∀ {R : Type u} [CommRing R] [Nontrivial R] {M₁ M₂ : Polynomial R},
      M₁.Monic → M₂.Monic → M₁.natDegree = M₂.natDegree → M₁ ∣ M₂ → M₁ = M₂ := by
    intro R _ _ M₁ M₂ hM₁ hM₂ hdeg hdvd
    rcases hdvd with ⟨R_q, hRq⟩
    have hRq_ne : R_q ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hRq
      exact hM₂.ne_zero hRq
    have hlc_ne : M₁.leadingCoeff * R_q.leadingCoeff ≠ 0 := by
      rw [hM₁.leadingCoeff, one_mul]
      exact Polynomial.leadingCoeff_ne_zero.mpr hRq_ne
    have hdeg_mul := Polynomial.natDegree_mul' hlc_ne
    rw [← hRq, ← hdeg] at hdeg_mul
    have hRq_deg : R_q.natDegree = 0 := by omega
    have hlc_eq := Polynomial.leadingCoeff_mul' hlc_ne
    rw [← hRq, hM₂.leadingCoeff, hM₁.leadingCoeff, one_mul,
      Polynomial.leadingCoeff, hRq_deg] at hlc_eq
    have hRq_one : R_q = 1 := by
      rw [Polynomial.eq_C_of_natDegree_eq_zero hRq_deg, ← hlc_eq, map_one]
    rw [hRq, hRq_one, mul_one]

  let A₀ : Polynomial k := A.map Polynomial.constantCoeff
  let B₀ : Polynomial k := B.map Polynomial.constantCoeff
  have hA₀_mon : A₀.Monic := hA_mon.map Polynomial.constantCoeff
  have hB₀_mon : B₀.Monic := hB_mon.map Polynomial.constantCoeff
  have hA₀_deg : A₀.natDegree = d₁ := (hA_mon.natDegree_map Polynomial.constantCoeff).trans hA_deg
  have hB₀_deg : B₀.natDegree = d₂ := (hB_mon.natDegree_map Polynomial.constantCoeff).trans hB_deg
  have hAB₀ : A₀ * B₀ = ∏ ν : Fin D, (Polynomial.X - Polynomial.C (α ν)) := by
    dsimp only [A₀, B₀]
    rw [← Polynomial.map_mul, ← hg_eq]
    dsimp only [g]
    rw [Polynomial.map_map, hρ_const, hf₀]

  let I : Finset (Fin D) := Finset.univ.filter (fun ν : Fin D => A₀.eval (α ν) = 0)
  have hα_sep : ∀ (S : Finset (Fin D)), ∀ ν ∈ S, ∀ μ ∈ S, ν ≠ μ → IsUnit (α ν - α μ) := by
    intro S ν _ μ _ hne
    exact isUnit_iff_ne_zero.mpr (sub_ne_zero.mpr fun heq => hne (hα_inj heq))
  have hI_dvd_A₀ : (∏ ν ∈ I, (Polynomial.X - Polynomial.C (α ν))) ∣ A₀ :=
    hProdDvd I α A₀ (hα_sep I) (fun ν hν => (Finset.mem_filter.mp hν).2)
  have hIc_roots : ∀ ν ∈ Iᶜ, B₀.eval (α ν) = 0 := by
    intro ν hν
    have hnotI : A₀.eval (α ν) ≠ 0 := by
      rw [Finset.mem_compl, Finset.mem_filter] at hν
      exact fun h0 => hν ⟨Finset.mem_univ ν, h0⟩
    have hprod0 : (A₀ * B₀).eval (α ν) = 0 := by
      rw [hAB₀, Polynomial.eval_prod]
      exact Finset.prod_eq_zero (Finset.mem_univ ν) (by simp)
    rw [Polynomial.eval_mul] at hprod0
    exact (mul_eq_zero.mp hprod0).resolve_left hnotI
  have hIc_dvd_B₀ : (∏ ν ∈ Iᶜ, (Polynomial.X - Polynomial.C (α ν))) ∣ B₀ :=
    hProdDvd Iᶜ α B₀ (hα_sep Iᶜ) hIc_roots

  have hProd_deg_k : ∀ S : Finset (Fin D),
      (∏ ν ∈ S, (Polynomial.X - Polynomial.C (α ν))).natDegree = S.card := by
    intro S
    rw [Polynomial.natDegree_prod_of_monic _ _ (fun ν _ => Polynomial.monic_X_sub_C (α ν))]
    simp
  have hI_le : I.card ≤ d₁ := by
    rw [← hProd_deg_k I, ← hA₀_deg]
    exact Polynomial.natDegree_le_of_dvd hI_dvd_A₀ hA₀_mon.ne_zero
  have hIc_le : Iᶜ.card ≤ d₂ := by
    rw [← hProd_deg_k Iᶜ, ← hB₀_deg]
    exact Polynomial.natDegree_le_of_dvd hIc_dvd_B₀ hB₀_mon.ne_zero
  have hI_compl_sum : I.card + Iᶜ.card = D := by
    simp
  have hI_card : I.card = d₁ := by omega
  have hIc_card : Iᶜ.card = d₂ := by omega

  have hIc_mon : (∏ ν ∈ Iᶜ, (Polynomial.X - Polynomial.C (α ν))).Monic :=
    Polynomial.monic_prod_of_monic _ _ (fun ν _ => Polynomial.monic_X_sub_C (α ν))
  have hB₀_eq : B₀ = ∏ μ ∈ Iᶜ, (Polynomial.X - Polynomial.C (α μ)) :=
    (hMonicEq hIc_mon hB₀_mon ((hProd_deg_k Iᶜ).trans (hIc_card.trans hB₀_deg.symm))
      hIc_dvd_B₀).symm
  have hB₀_ne_on_I : ∀ ν ∈ I, B₀.eval (α ν) ≠ 0 := by
    intro ν hν
    rw [hB₀_eq, Polynomial.eval_prod]
    rw [Finset.prod_ne_zero_iff]
    intro μ hμ
    simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
    have hne : ν ≠ μ := fun heq => Finset.mem_compl.mp hμ (heq ▸ hν)
    exact sub_ne_zero.mpr fun heq => hne (hα_inj heq)

  
  have hI_1 : 1 ≤ I.card := by omega
  have hI_lt_D : I.card < D := by omega
  obtain ⟨_, hD_lt_sI, _⟩ := hObs_spec I hI_1 hI_lt_D
  have hc_HI_ne : MvPolynomial.eval c (H_fn I) ≠ 0 := hc_obs I hI_1 hI_lt_D
  let j_I : ℕ := j_fn I
  let s_I : ℕ := s_fn I
  let N₀ : ℕ := s_I + 1
  have hN₀_pos : 1 ≤ N₀ := by omega
  let z : Fin D → Polynomial k := fun ν => ρ_c (∑ s ∈ Finset.range N₀, ζ ν s)

  let J_ideal : Ideal (Polynomial k) := Ideal.span ({Polynomial.X ^ N₀} : Set (Polynomial k))
  let Q := Polynomial k ⧸ J_ideal
  let π : Polynomial k →+* Q := Ideal.Quotient.mk J_ideal

  have hπ_zero : ∀ p : Polynomial k, π p = 0 ↔ ∀ m < N₀, p.coeff m = 0 := by
    intro p
    dsimp only [π]
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton, Polynomial.X_pow_dvd_iff]

  have : Nontrivial Q := by
    refine ⟨⟨1, 0, ?_⟩⟩
    intro h10
    have hcoeff := (hπ_zero 1).mp h10 0 (by omega)
    simp at hcoeff

  have hπ_unit : ∀ p : Polynomial k, p.coeff 0 ≠ 0 → IsUnit (π p) := by
    intro p hp0
    let u₀ : k := p.coeff 0
    let r_p : Polynomial k := Polynomial.C u₀⁻¹ * p - 1
    have hr0 : r_p.coeff 0 = 0 := by
      simp only [r_p, Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_one_zero]
      exact sub_eq_zero.mpr (inv_mul_cancel₀ hp0)
    obtain ⟨q_r, hq_r⟩ := Polynomial.X_dvd_iff.mpr hr0
    have hr_nil : (π r_p) ^ N₀ = 0 := by
      rw [← map_pow]
      dsimp only [π]
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton, hq_r, mul_pow]
      exact dvd_mul_right _ _
    have hu_1r : IsUnit (1 + π r_p) :=
      IsNilpotent.isUnit_one_add ⟨N₀, hr_nil⟩
    have hu_u0 : IsUnit (π (Polynomial.C u₀)) :=
      (π.comp Polynomial.C).isUnit_map (IsUnit.mk0 u₀ hp0)
    have hp_eq : π p = π (Polynomial.C u₀) * (1 + π r_p) := by
      rw [← map_one π, ← map_add, ← map_mul]
      congr 1
      dsimp only [r_p]
      rw [add_sub_cancel, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hp0, map_one, one_mul]
    rw [hp_eq]
    exact hu_u0.mul hu_1r

  have hz0 : ∀ ν : Fin D, (z ν).coeff 0 = α ν := by
    intro ν
    dsimp only [z]
    rw [hρ_coeff, map_sum, map_sum]
    have h0_mem : 0 ∈ Finset.range N₀ := Finset.mem_range.mpr (by omega)
    rw [Finset.sum_eq_single 0]
    · rw [MvPolynomial.homogeneousComponent_of_mem (hζ_hom ν 0)]
      simp only [↓reduceIte, hζ_zero ν, MvPolynomial.eval_C]
    · intro s _ hs_ne
      rw [MvPolynomial.homogeneousComponent_of_mem (hζ_hom ν s)]
      simp only [hs_ne.symm, ↓reduceIte, map_zero]
    · intro hmem; exact absurd h0_mem hmem

  let w : Fin D → Q := fun ν => π (z ν)
  have hg_π : g.map π = ∏ ν : Fin D, (Polynomial.X - Polynomial.C (w ν)) := by
    have hdiff0 : (g - ∏ ν : Fin D, (Polynomial.X - Polynomial.C (z ν))).map π = 0 := by
      ext j
      rw [Polynomial.coeff_map, Polynomial.coeff_zero, hπ_zero]
      intro m hm
      have hmap_prod : (∏ ν : Fin D, (Polynomial.X - Polynomial.C (z ν))) =
          (∏ ν : Fin D,
            (Polynomial.X - Polynomial.C (∑ s ∈ Finset.range N₀, ζ ν s))).map ρ_c := by
        rw [Polynomial.map_prod]
        refine Finset.prod_congr rfl fun ν _ => ?_
        rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
      dsimp only [g]
      rw [hmap_prod, ← Polynomial.map_sub, Polynomial.coeff_map, hρ_coeff,
        hζ_cong N₀ hN₀_pos j m hm, map_zero]
    rw [Polynomial.map_sub, sub_eq_zero] at hdiff0
    rw [hdiff0, Polynomial.map_prod]
    refine Finset.prod_congr rfl fun ν _ => ?_
    rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]

  have hAB_π : (A.map π) * (B.map π) = ∏ ν : Fin D, (Polynomial.X - Polynomial.C (w ν)) := by
    rw [← Polynomial.map_mul, ← hg_eq, hg_π]

  have hw_sep : ∀ ν ∈ I, ∀ μ ∈ I, ν ≠ μ → IsUnit (w ν - w μ) := by
    intro ν _ μ _ hne
    dsimp only [w]
    rw [← map_sub]
    apply hπ_unit
    rw [Polynomial.coeff_sub, hz0 ν, hz0 μ]
    exact sub_ne_zero.mpr fun heq => hne (hα_inj heq)

  have hAπ_roots : ∀ ν ∈ I, (A.map π).eval (w ν) = 0 := by
    intro ν hν
    have hprod_w : ((A.map π) * (B.map π)).eval (w ν) = 0 := by
      rw [hAB_π, Polynomial.eval_prod]
      exact Finset.prod_eq_zero (Finset.mem_univ ν) (by simp)
    rw [Polynomial.eval_mul] at hprod_w
    have hB_unit : IsUnit ((B.map π).eval (w ν)) := by
      dsimp only [w]
      rw [Polynomial.eval_map, Polynomial.eval₂_hom]
      apply hπ_unit
      change Polynomial.constantCoeff (B.eval (z ν)) ≠ 0
      rw [← Polynomial.eval₂_hom Polynomial.constantCoeff (z ν),
        ← Polynomial.eval_map]
      change B₀.eval ((z ν).coeff 0) ≠ 0
      rw [hz0 ν]
      exact hB₀_ne_on_I ν hν
    exact hB_unit.mul_left_eq_zero.mp hprod_w

  have hI_dvd_Aπ : (∏ ν ∈ I, (Polynomial.X - Polynomial.C (w ν))) ∣ A.map π :=
    hProdDvd I w (A.map π) hw_sep hAπ_roots
  have hProd_w_mon : (∏ ν ∈ I, (Polynomial.X - Polynomial.C (w ν))).Monic :=
    Polynomial.monic_prod_of_monic _ _ (fun ν _ => Polynomial.monic_X_sub_C (w ν))
  have hProd_w_deg : (∏ ν ∈ I, (Polynomial.X - Polynomial.C (w ν))).natDegree = d₁ := by
    rw [Polynomial.natDegree_prod_of_monic _ _ (fun ν _ => Polynomial.monic_X_sub_C (w ν))]
    simp [hI_card]
  have hAπ_mon : (A.map π).Monic := hA_mon.map π
  have hAπ_deg : (A.map π).natDegree = d₁ := (hA_mon.natDegree_map π).trans hA_deg

  have hAπ_eq : A.map π = (∏ ν ∈ I, (Polynomial.X - Polynomial.C (z ν))).map π := by
    have h1 := (hMonicEq hProd_w_mon hAπ_mon (hProd_w_deg.trans hAπ_deg.symm) hI_dvd_Aπ).symm
    rw [h1, Polynomial.map_prod]
    refine Finset.prod_congr rfl fun ν _ => ?_
    rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]

  have hcoeff_π : π (A.coeff j_I - (∏ ν ∈ I, (Polynomial.X - Polynomial.C (z ν))).coeff j_I) = 0 := by
    rw [map_sub, ← Polynomial.coeff_map, ← Polynomial.coeff_map, hAπ_eq, sub_self]
  have hcoeff_eq : (A.coeff j_I).coeff s_I =
      ((∏ ν ∈ I, (Polynomial.X - Polynomial.C (z ν))).coeff j_I).coeff s_I := by
    have hsub0 := (hπ_zero _).mp hcoeff_π s_I (Nat.lt_succ_self s_I)
    rw [Polynomial.coeff_sub] at hsub0
    exact sub_eq_zero.mp hsub0

  have hlhs_zero : (A.coeff j_I).coeff s_I = 0 := hA_van j_I s_I (by omega)
  have hrhs_eval : ((∏ ν ∈ I, (Polynomial.X - Polynomial.C (z ν))).coeff j_I).coeff s_I =
      MvPolynomial.eval c (H_fn I) := by
    have hmap_I : (∏ ν ∈ I, (Polynomial.X - Polynomial.C (z ν))) =
        (∏ ν ∈ I,
          (Polynomial.X - Polynomial.C (∑ s ∈ Finset.range (s_I + 1), ζ ν s))).map ρ_c := by
      rw [Polynomial.map_prod]
      refine Finset.prod_congr rfl fun ν _ => ?_
      rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
    rw [hmap_I, Polynomial.coeff_map, hρ_coeff]

  rw [hlhs_zero, hrhs_eval] at hcoeff_eq
  exact hc_HI_ne hcoeff_eq.symm

theorem weil_algClosed_ternary_homog_irred_zariski_open (k : Type u) [Field k] [IsAlgClosed k] (σ : Type) [Fintype σ]
    (D : ℕ) (hD : 1 ≤ D)
    (P_fam : MvPolynomial (Fin 3) (MvPolynomial σ k))
    (hHomog_fam : P_fam ∈ MvPolynomial.homogeneousSubmodule (Fin 3) (MvPolynomial σ k) D)
    (ℓ_star : σ → k)
    (hIrred_star : Irreducible (MvPolynomial.map (MvPolynomial.eval ℓ_star) P_fam)) :
    ∃ (Δ_irred : MvPolynomial σ k),
      MvPolynomial.eval ℓ_star Δ_irred ≠ 0 ∧
      ∀ (ℓ : σ → k), MvPolynomial.eval ℓ Δ_irred ≠ 0 →
        Irreducible (MvPolynomial.map (MvPolynomial.eval ℓ) P_fam) :=
by
  classical
  have hWeightDeg : ∀ {ι_v : Type} (m : ι_v →₀ ℕ), (Finsupp.weight 1) m = Finsupp.degree m := by
    intro ι_v m
    rw [Finsupp.weight_apply, Finsupp.degree_apply, Finsupp.sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp

  have hMem_I : ∀ (d : ℕ) (e : Fin 3 →₀ ℕ),
      e ∈ (Finset.univ : Finset (Fin 3)).finsuppAntidiag d ↔ Finsupp.degree e = d := by
    intro d e
    rw [Finset.mem_finsuppAntidiag']
    refine ⟨fun h => ?_, fun h => ⟨?_, Finset.subset_univ _⟩⟩
    · rw [Finsupp.degree_apply]; exact h.1
    · rw [Finsupp.degree_apply] at h; exact h

  
  have hPillar1 : ∀ (P : MvPolynomial (Fin 3) k),
      P ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k D →
      (¬ Irreducible P ↔
        P = 0 ∨
        ∃ d₁ ∈ Finset.Ico 1 D,
          ∃ (A_hom B_hom : MvPolynomial (Fin 3) k),
            A_hom ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d₁ ∧
            B_hom ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k (D - d₁) ∧
            A_hom ≠ 0 ∧ B_hom ≠ 0 ∧ P = A_hom * B_hom) := by
    intro P hHomog
    have hNotUnitOfHomog : ∀ {d : ℕ} {Q : MvPolynomial (Fin 3) k},
        1 ≤ d → Q ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d → Q ≠ 0 → ¬ IsUnit Q := by
      intro d Q hd hQ_hom hQ_ne hQu
      rcases hQu with ⟨u, rfl⟩
      have hQ_hom' : u.val.IsHomogeneous d := hQ_hom
      have hdeg_val : u.val.totalDegree = d := hQ_hom'.totalDegree hQ_ne
      have hinv_ne : u.inv ≠ 0 := by
        intro h0
        have h1 : u.val * u.inv = 1 := u.val_inv
        rw [h0, mul_zero] at h1
        exact zero_ne_one h1
      have hdeg_mul : (u.val * u.inv).totalDegree = u.val.totalDegree + u.inv.totalDegree :=
        MvPolynomial.totalDegree_mul_of_isDomain hQ_ne hinv_ne
      rw [u.val_inv, MvPolynomial.totalDegree_one, hdeg_val] at hdeg_mul
      omega
    constructor
    · intro hNotIrr
      by_cases hP0 : P = 0
      · exact Or.inl hP0
      · right
        have hP_notUnit : ¬ IsUnit P := hNotUnitOfHomog hD hHomog hP0
        have hNotForall : ¬ ∀ a b : MvPolynomial (Fin 3) k, P = a * b → IsUnit a ∨ IsUnit b :=
          fun hall => hNotIrr ⟨hP_notUnit, hall⟩
        push_neg at hNotForall
        rcases hNotForall with ⟨A, B, hP_eq, hA_nu, hB_nu⟩
        have hA_ne : A ≠ 0 := by
          intro h0; rw [h0, zero_mul] at hP_eq; exact hP0 hP_eq
        have hB_ne : B ≠ 0 := by
          intro h0; rw [h0, mul_zero] at hP_eq; exact hP0 hP_eq
        have hA_supp : A.support.Nonempty := MvPolynomial.support_nonempty.mpr hA_ne
        have hB_supp : B.support.Nonempty := MvPolynomial.support_nonempty.mpr hB_ne
        let a_min := A.support.inf' hA_supp Finsupp.degree
        let a_max := A.support.sup' hA_supp Finsupp.degree
        let b_min := B.support.inf' hB_supp Finsupp.degree
        let b_max := B.support.sup' hB_supp Finsupp.degree
        obtain ⟨ma_min, hma_min_mem, hma_min_deg⟩ := Finset.exists_mem_eq_inf' hA_supp Finsupp.degree
        obtain ⟨ma_max, hma_max_mem, hma_max_deg⟩ := Finset.exists_mem_eq_sup' hA_supp Finsupp.degree
        obtain ⟨mb_min, hmb_min_mem, hmb_min_deg⟩ := Finset.exists_mem_eq_inf' hB_supp Finsupp.degree
        obtain ⟨mb_max, hmb_max_mem, hmb_max_deg⟩ := Finset.exists_mem_eq_sup' hB_supp Finsupp.degree
        have ha_le : a_min ≤ a_max :=
          (Finset.inf'_le Finsupp.degree hma_max_mem).trans (Finset.le_sup' Finsupp.degree hma_max_mem)
        have hb_le : b_min ≤ b_max :=
          (Finset.inf'_le Finsupp.degree hmb_max_mem).trans (Finset.le_sup' Finsupp.degree hmb_max_mem)
        have hCompNe : ∀ {Q : MvPolynomial (Fin 3) k} {n : ℕ} {m : Fin 3 →₀ ℕ},
            m ∈ Q.support → Finsupp.degree m = n → MvPolynomial.homogeneousComponent n Q ≠ 0 := by
          intro Q n m hm hdeg h0
          have hc := congrArg (fun p => p.coeff m) h0
          have h0c : (0 : MvPolynomial (Fin 3) k).coeff m = 0 := by simp
          rw [MvPolynomial.coeff_homogeneousComponent, if_pos hdeg, h0c] at hc
          exact (MvPolynomial.mem_support_iff.mp hm) hc
        have hAmin_ne : MvPolynomial.homogeneousComponent a_min A ≠ 0 :=
          hCompNe hma_min_mem hma_min_deg.symm
        have hAmax_ne : MvPolynomial.homogeneousComponent a_max A ≠ 0 :=
          hCompNe hma_max_mem hma_max_deg.symm
        have hBmin_ne : MvPolynomial.homogeneousComponent b_min B ≠ 0 :=
          hCompNe hmb_min_mem hmb_min_deg.symm
        have hBmax_ne : MvPolynomial.homogeneousComponent b_max B ≠ 0 :=
          hCompNe hmb_max_mem hmb_max_deg.symm
        have hA_zero_lt : ∀ i < a_min, MvPolynomial.homogeneousComponent i A = 0 := by
          intro i hi
          refine MvPolynomial.homogeneousComponent_eq_zero' i A fun d hd hdeg => ?_
          have hle : a_min ≤ Finsupp.degree d := Finset.inf'_le Finsupp.degree hd
          omega
        have hA_zero_gt : ∀ i > a_max, MvPolynomial.homogeneousComponent i A = 0 := by
          intro i hi
          refine MvPolynomial.homogeneousComponent_eq_zero' i A fun d hd hdeg => ?_
          have hle : Finsupp.degree d ≤ a_max := Finset.le_sup' Finsupp.degree hd
          omega
        have hB_zero_lt : ∀ j < b_min, MvPolynomial.homogeneousComponent j B = 0 := by
          intro j hj
          refine MvPolynomial.homogeneousComponent_eq_zero' j B fun d hd hdeg => ?_
          have hle : b_min ≤ Finsupp.degree d := Finset.inf'_le Finsupp.degree hd
          omega
        have hB_zero_gt : ∀ j > b_max, MvPolynomial.homogeneousComponent j B = 0 := by
          intro j hj
          refine MvPolynomial.homogeneousComponent_eq_zero' j B fun d hd hdeg => ?_
          have hle : Finsupp.degree d ≤ b_max := Finset.le_sup' Finsupp.degree hd
          omega
        have hma_min_le_td : a_min < A.totalDegree + 1 := by
          have hle : (ma_min.sum fun _ e => e) ≤ A.totalDegree :=
            Finset.le_sup (f := fun s => s.sum fun _ e => e) hma_min_mem
          have hdeg_eq : (ma_min.sum fun _ e => e) = Finsupp.degree ma_min := rfl
          omega
        have hma_max_le_td : a_max < A.totalDegree + 1 := by
          have hle : (ma_max.sum fun _ e => e) ≤ A.totalDegree :=
            Finset.le_sup (f := fun s => s.sum fun _ e => e) hma_max_mem
          have hdeg_eq : (ma_max.sum fun _ e => e) = Finsupp.degree ma_max := rfl
          omega
        have hmb_min_le_td : b_min < B.totalDegree + 1 := by
          have hle : (mb_min.sum fun _ e => e) ≤ B.totalDegree :=
            Finset.le_sup (f := fun s => s.sum fun _ e => e) hmb_min_mem
          have hdeg_eq : (mb_min.sum fun _ e => e) = Finsupp.degree mb_min := rfl
          omega
        have hmb_max_le_td : b_max < B.totalDegree + 1 := by
          have hle : (mb_max.sum fun _ e => e) ≤ B.totalDegree :=
            Finset.le_sup (f := fun s => s.sum fun _ e => e) hmb_max_mem
          have hdeg_eq : (mb_max.sum fun _ e => e) = Finsupp.degree mb_max := rfl
          omega
        have hProdExpand : ∀ n : ℕ,
            MvPolynomial.homogeneousComponent n P =
              ∑ i ∈ Finset.range (A.totalDegree + 1),
                ∑ j ∈ Finset.range (B.totalDegree + 1),
                  MvPolynomial.homogeneousComponent n
                    (MvPolynomial.homogeneousComponent i A * MvPolynomial.homogeneousComponent j B) := by
          intro n
          conv_lhs =>
            rw [hP_eq, ← MvPolynomial.sum_homogeneousComponent A,
              ← MvPolynomial.sum_homogeneousComponent B, Finset.sum_mul]
          rw [map_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Finset.mul_sum, map_sum]
        have hMinComp : MvPolynomial.homogeneousComponent (a_min + b_min) P =
            MvPolynomial.homogeneousComponent a_min A * MvPolynomial.homogeneousComponent b_min B := by
          rw [hProdExpand (a_min + b_min)]
          rw [Finset.sum_eq_single a_min]
          · rw [Finset.sum_eq_single b_min]
            · have hmem : MvPolynomial.homogeneousComponent a_min A *
                  MvPolynomial.homogeneousComponent b_min B ∈
                  MvPolynomial.homogeneousSubmodule (Fin 3) k (a_min + b_min) :=
                MvPolynomial.IsHomogeneous.mul
                  (MvPolynomial.homogeneousComponent_mem a_min A)
                  (MvPolynomial.homogeneousComponent_mem b_min B)
              rw [MvPolynomial.homogeneousComponent_of_mem hmem, if_pos rfl]
            · intro j _ hj_ne
              by_cases hj_lt : j < b_min
              · rw [hB_zero_lt j hj_lt, mul_zero, map_zero]
              · have hmem : MvPolynomial.homogeneousComponent a_min A *
                    MvPolynomial.homogeneousComponent j B ∈
                    MvPolynomial.homogeneousSubmodule (Fin 3) k (a_min + j) :=
                  MvPolynomial.IsHomogeneous.mul
                    (MvPolynomial.homogeneousComponent_mem a_min A)
                    (MvPolynomial.homogeneousComponent_mem j B)
                rw [MvPolynomial.homogeneousComponent_of_mem hmem, if_neg (by omega)]
            · intro hmem; exact absurd (Finset.mem_range.mpr hmb_min_le_td) hmem
          · intro i _ hi_ne
            refine Finset.sum_eq_zero fun j _ => ?_
            by_cases hi_lt : i < a_min
            · rw [hA_zero_lt i hi_lt, zero_mul, map_zero]
            · by_cases hj_lt : j < b_min
              · rw [hB_zero_lt j hj_lt, mul_zero, map_zero]
              · have hmem : MvPolynomial.homogeneousComponent i A *
                    MvPolynomial.homogeneousComponent j B ∈
                    MvPolynomial.homogeneousSubmodule (Fin 3) k (i + j) :=
                  MvPolynomial.IsHomogeneous.mul
                    (MvPolynomial.homogeneousComponent_mem i A)
                    (MvPolynomial.homogeneousComponent_mem j B)
                rw [MvPolynomial.homogeneousComponent_of_mem hmem, if_neg (by omega)]
          · intro hmem; exact absurd (Finset.mem_range.mpr hma_min_le_td) hmem
        have hMaxComp : MvPolynomial.homogeneousComponent (a_max + b_max) P =
            MvPolynomial.homogeneousComponent a_max A * MvPolynomial.homogeneousComponent b_max B := by
          rw [hProdExpand (a_max + b_max)]
          rw [Finset.sum_eq_single a_max]
          · rw [Finset.sum_eq_single b_max]
            · have hmem : MvPolynomial.homogeneousComponent a_max A *
                  MvPolynomial.homogeneousComponent b_max B ∈
                  MvPolynomial.homogeneousSubmodule (Fin 3) k (a_max + b_max) :=
                MvPolynomial.IsHomogeneous.mul
                  (MvPolynomial.homogeneousComponent_mem a_max A)
                  (MvPolynomial.homogeneousComponent_mem b_max B)
              rw [MvPolynomial.homogeneousComponent_of_mem hmem, if_pos rfl]
            · intro j _ hj_ne
              by_cases hj_gt : j > b_max
              · rw [hB_zero_gt j hj_gt, mul_zero, map_zero]
              · have hmem : MvPolynomial.homogeneousComponent a_max A *
                    MvPolynomial.homogeneousComponent j B ∈
                    MvPolynomial.homogeneousSubmodule (Fin 3) k (a_max + j) :=
                  MvPolynomial.IsHomogeneous.mul
                    (MvPolynomial.homogeneousComponent_mem a_max A)
                    (MvPolynomial.homogeneousComponent_mem j B)
                rw [MvPolynomial.homogeneousComponent_of_mem hmem, if_neg (by omega)]
            · intro hmem; exact absurd (Finset.mem_range.mpr hmb_max_le_td) hmem
          · intro i _ hi_ne
            refine Finset.sum_eq_zero fun j _ => ?_
            by_cases hi_gt : i > a_max
            · rw [hA_zero_gt i hi_gt, zero_mul, map_zero]
            · by_cases hj_gt : j > b_max
              · rw [hB_zero_gt j hj_gt, mul_zero, map_zero]
              · have hmem : MvPolynomial.homogeneousComponent i A *
                    MvPolynomial.homogeneousComponent j B ∈
                    MvPolynomial.homogeneousSubmodule (Fin 3) k (i + j) :=
                  MvPolynomial.IsHomogeneous.mul
                    (MvPolynomial.homogeneousComponent_mem i A)
                    (MvPolynomial.homogeneousComponent_mem j B)
                rw [MvPolynomial.homogeneousComponent_of_mem hmem, if_neg (by omega)]
          · intro hmem; exact absurd (Finset.mem_range.mpr hma_max_le_td) hmem
        have hSumMin : a_min + b_min = D := by
          by_contra hne
          have h0 : MvPolynomial.homogeneousComponent (a_min + b_min) P = 0 := by
            rw [MvPolynomial.homogeneousComponent_of_mem hHomog, if_neg hne]
          rw [hMinComp] at h0
          exact mul_ne_zero hAmin_ne hBmin_ne h0
        have hSumMax : a_max + b_max = D := by
          by_contra hne
          have h0 : MvPolynomial.homogeneousComponent (a_max + b_max) P = 0 := by
            rw [MvPolynomial.homogeneousComponent_of_mem hHomog, if_neg hne]
          rw [hMaxComp] at h0
          exact mul_ne_zero hAmax_ne hBmax_ne h0
        have ha_eq : a_min = a_max := by omega
        have hb_eq : b_min = b_max := by omega
        have hb_D : b_min = D - a_min := by omega
        have hA_hom : A ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k a_min := by
          rw [MvPolynomial.mem_homogeneousSubmodule]
          intro d hd
          rw [hWeightDeg]
          have hmem_supp : d ∈ A.support := MvPolynomial.mem_support_iff.mpr hd
          have h1 : a_min ≤ Finsupp.degree d := Finset.inf'_le Finsupp.degree hmem_supp
          have h2 : Finsupp.degree d ≤ a_max := Finset.le_sup' Finsupp.degree hmem_supp
          omega
        have hB_hom : B ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k (D - a_min) := by
          rw [MvPolynomial.mem_homogeneousSubmodule]
          intro d hd
          rw [hWeightDeg]
          have hmem_supp : d ∈ B.support := MvPolynomial.mem_support_iff.mpr hd
          have h1 : b_min ≤ Finsupp.degree d := Finset.inf'_le Finsupp.degree hmem_supp
          have h2 : Finsupp.degree d ≤ b_max := Finset.le_sup' Finsupp.degree hmem_supp
          omega
        have hUnitOfHom0 : ∀ {Q : MvPolynomial (Fin 3) k},
            Q ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k 0 → Q ≠ 0 → IsUnit Q := by
          intro Q hQ0 hQ_ne
          have hQ_eq : Q = MvPolynomial.C (Q.coeff 0) := by
            ext m
            by_cases hm0 : m = 0
            · subst hm0; simp
            · rw [MvPolynomial.coeff_C, if_neg (Ne.symm hm0)]
              by_contra hne
              have hdeg0 : ∑ i ∈ m.support, m i = 0 :=
                (Finsupp.degree_apply m).symm.trans ((hWeightDeg m).symm.trans (hQ0 hne))
              apply hm0
              ext i
              simp only [Finsupp.coe_zero, Pi.zero_apply]
              by_contra hi
              have hmem : i ∈ m.support := Finsupp.mem_support_iff.mpr hi
              have hle : m i ≤ ∑ j ∈ m.support, m j :=
                Finset.single_le_sum (fun _ _ => Nat.zero_le _) hmem
              omega
          have hc_ne : Q.coeff 0 ≠ 0 := by
            intro hc0; rw [hc0, map_zero] at hQ_eq; exact hQ_ne hQ_eq
          rw [hQ_eq]
          exact (IsUnit.mk0 (Q.coeff 0) hc_ne).map MvPolynomial.C
        have ha_pos : 1 ≤ a_min := by
          rcases Nat.eq_zero_or_pos a_min with h0 | hpos
          · rw [h0] at hA_hom
            exact absurd (hUnitOfHom0 hA_hom hA_ne) hA_nu
          · exact hpos
        have hb_pos : 1 ≤ D - a_min := by
          rcases Nat.eq_zero_or_pos (D - a_min) with h0 | hpos
          · rw [h0] at hB_hom
            exact absurd (hUnitOfHom0 hB_hom hB_ne) hB_nu
          · exact hpos
        exact ⟨a_min, Finset.mem_Ico.mpr ⟨ha_pos, by omega⟩, A, B, hA_hom, hB_hom, hA_ne, hB_ne, hP_eq⟩
    · rintro (rfl | ⟨d₁, hd₁, A_hom, B_hom, hA_hom, hB_hom, hA_ne, hB_ne, hP_eq⟩)
      · exact fun hIrr => hIrr.ne_zero rfl
      · intro hIrr
        rw [Finset.mem_Ico] at hd₁
        have hA_nu : ¬ IsUnit A_hom := hNotUnitOfHomog hd₁.1 hA_hom hA_ne
        have hB_nu : ¬ IsUnit B_hom := hNotUnitOfHomog (by omega) hB_hom hB_ne
        rcases hIrr.isUnit_or_isUnit hP_eq with hAu | hBu
        · exact hA_nu hAu
        · exact hB_nu hBu

  
  have hPillar2 : ∀ (d₁ d₂ D₀ : ℕ), d₁ + d₂ = D₀ →
      ∀ (P : MvPolynomial (Fin 3) k),
        P ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k D₀ →
        let I₁ := ↥((Finset.univ : Finset (Fin 3)).finsuppAntidiag d₁)
        let I₂ := ↥((Finset.univ : Finset (Fin 3)).finsuppAntidiag d₂)
        let I_D := ↥((Finset.univ : Finset (Fin 3)).finsuppAntidiag D₀)
        ((∃ s : I₁ × I₂ → k, s ≠ 0 ∧
          (∀ (α₁ α₂ : I₁) (β₁ β₂ : I₂),
            s (α₁, β₁) * s (α₂, β₂) - s (α₁, β₂) * s (α₂, β₁) = 0) ∧
          (∀ (γ₁ γ₂ : I_D),
            P.coeff γ₁.1 *
                (∑ p ∈ Finset.univ.filter (fun p : I₁ × I₂ => p.1.1 + p.2.1 = γ₂.1), s p) -
              P.coeff γ₂.1 *
                (∑ p ∈ Finset.univ.filter (fun p : I₁ × I₂ => p.1.1 + p.2.1 = γ₁.1), s p) = 0)) ↔
        (P = 0 ∨
          ∃ (A_hom B_hom : MvPolynomial (Fin 3) k),
            A_hom ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d₁ ∧
            B_hom ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d₂ ∧
            A_hom ≠ 0 ∧ B_hom ≠ 0 ∧ P = A_hom * B_hom)) := by
    intro d₁ d₂ D₀ hD_eq P hHomog
    subst hD_eq
    intro I₁ I₂ I_D
    have hConv : ∀ (A_hom B_hom : MvPolynomial (Fin 3) k),
        A_hom ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d₁ →
        B_hom ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d₂ →
        ∀ γ : I_D,
          (A_hom * B_hom).coeff γ.1 =
            ∑ p ∈ Finset.univ.filter (fun p : I₁ × I₂ => p.1.1 + p.2.1 = γ.1),
              A_hom.coeff p.1.1 * B_hom.coeff p.2.1 := by
      intro A_hom B_hom hA_hom hB_hom γ
      have hA_hom' : A_hom.IsHomogeneous d₁ := hA_hom
      have hB_hom' : B_hom.IsHomogeneous d₂ := hB_hom
      rw [MvPolynomial.coeff_mul]
      have hFilter : (∑ x ∈ Finset.HasAntidiagonal.antidiagonal γ.1,
            A_hom.coeff x.1 * B_hom.coeff x.2) =
          ∑ x ∈ (Finset.HasAntidiagonal.antidiagonal γ.1).filter
            (fun x => Finsupp.degree x.1 = d₁ ∧ Finsupp.degree x.2 = d₂),
            A_hom.coeff x.1 * B_hom.coeff x.2 := by
        rw [Finset.sum_filter]
        refine Finset.sum_congr rfl fun x _ => ?_
        split_ifs with hdeg
        · rfl
        · rw [not_and_or] at hdeg
          rcases hdeg with h1 | h2
          · rw [hA_hom'.coeff_eq_zero h1, zero_mul]
          · rw [hB_hom'.coeff_eq_zero h2, mul_zero]
      rw [hFilter]
      symm
      refine Finset.sum_bij (fun (p : I₁ × I₂) _ => (p.1.1, p.2.1)) ?_ ?_ ?_ (fun _ _ => rfl)
      · intro p hp
        rw [Finset.mem_filter] at hp ⊢
        exact ⟨Finset.HasAntidiagonal.mem_antidiagonal.mpr hp.2,
          (hMem_I d₁ p.1.1).mp p.1.2, (hMem_I d₂ p.2.1).mp p.2.2⟩
      · intro p₁ _ p₂ _ heq
        exact Prod.ext (Subtype.ext (Prod.ext_iff.mp heq).1) (Subtype.ext (Prod.ext_iff.mp heq).2)
      · intro x hx
        rw [Finset.mem_filter, Finset.HasAntidiagonal.mem_antidiagonal] at hx
        let α : I₁ := ⟨x.1, (hMem_I d₁ x.1).mpr hx.2.1⟩
        let β : I₂ := ⟨x.2, (hMem_I d₂ x.2).mpr hx.2.2⟩
        exact ⟨(α, β), Finset.mem_filter.mpr ⟨Finset.mem_univ _, hx.1⟩, rfl⟩
    constructor
    · rintro ⟨s, hs_ne, hs_minors, hs_prop⟩
      obtain ⟨⟨α₀, β₀⟩, hc₀_ne⟩ : ∃ p : I₁ × I₂, s p ≠ 0 := Function.ne_iff.mp hs_ne
      set c₀ : k := s (α₀, β₀)
      let A₀ : MvPolynomial (Fin 3) k :=
        ∑ α : I₁, MvPolynomial.monomial α.1 (s (α, β₀) * c₀⁻¹)
      let B₀ : MvPolynomial (Fin 3) k :=
        ∑ β : I₂, MvPolynomial.monomial β.1 (s (α₀, β))
      have hA₀_hom : A₀ ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d₁ := by
        refine Submodule.sum_mem _ fun α _ => ?_
        exact MvPolynomial.isHomogeneous_monomial _ ((hMem_I d₁ α.1).mp α.2)
      have hB₀_hom : B₀ ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d₂ := by
        refine Submodule.sum_mem _ fun β _ => ?_
        exact MvPolynomial.isHomogeneous_monomial _ ((hMem_I d₂ β.1).mp β.2)
      have hA₀_coeff : ∀ α : I₁, A₀.coeff α.1 = s (α, β₀) * c₀⁻¹ := by
        intro α
        simp only [A₀, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
        rw [Finset.sum_eq_single α]
        · simp
        · intro α' _ hne
          rw [if_neg (fun heq => hne (Subtype.ext heq))]
        · intro hmem; exact absurd (Finset.mem_univ α) hmem
      have hB₀_coeff : ∀ β : I₂, B₀.coeff β.1 = s (α₀, β) := by
        intro β
        simp only [B₀, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
        rw [Finset.sum_eq_single β]
        · simp
        · intro β' _ hne
          rw [if_neg (fun heq => hne (Subtype.ext heq))]
        · intro hmem; exact absurd (Finset.mem_univ β) hmem
      have hA₀_ne : A₀ ≠ 0 := by
        intro h0
        have hc := hA₀_coeff α₀
        have h0c : (0 : MvPolynomial (Fin 3) k).coeff α₀.1 = 0 := by simp
        rw [h0, h0c, mul_inv_cancel₀ hc₀_ne] at hc
        exact zero_ne_one hc
      have hB₀_ne : B₀ ≠ 0 := by
        intro h0
        have hc := hB₀_coeff β₀
        have h0c : (0 : MvPolynomial (Fin 3) k).coeff β₀.1 = 0 := by simp
        rw [h0, h0c] at hc
        exact hc₀_ne hc.symm
      have hProdCoeff : ∀ (α : I₁) (β : I₂), A₀.coeff α.1 * B₀.coeff β.1 = s (α, β) := by
        intro α β
        rw [hA₀_coeff α, hB₀_coeff β]
        have hmin : s (α, β) * c₀ = s (α, β₀) * s (α₀, β) :=
          sub_eq_zero.mp (hs_minors α α₀ β β₀)
        calc
          (s (α, β₀) * c₀⁻¹) * s (α₀, β) = (s (α, β₀) * s (α₀, β)) * c₀⁻¹ := by ring
          _ = (s (α, β) * c₀) * c₀⁻¹ := by rw [hmin]
          _ = s (α, β) := mul_inv_cancel_right₀ hc₀_ne (s (α, β))
      have hAB_sum : ∀ γ : I_D,
          (A₀ * B₀).coeff γ.1 =
            ∑ p ∈ Finset.univ.filter (fun p : I₁ × I₂ => p.1.1 + p.2.1 = γ.1), s p := by
        intro γ
        rw [hConv A₀ B₀ hA₀_hom hB₀_hom γ]
        refine Finset.sum_congr rfl fun p _ => hProdCoeff p.1 p.2
      have hAB_ne : A₀ * B₀ ≠ 0 := mul_ne_zero hA₀_ne hB₀_ne
      have hAB_hom : (A₀ * B₀).IsHomogeneous (d₁ + d₂) :=
        MvPolynomial.IsHomogeneous.mul hA₀_hom hB₀_hom
      obtain ⟨e₀, he₀_supp⟩ := MvPolynomial.support_nonempty.mpr hAB_ne
      have he₀_ne : (A₀ * B₀).coeff e₀ ≠ 0 := MvPolynomial.mem_support_iff.mp he₀_supp
      have he₀_deg : Finsupp.degree e₀ = d₁ + d₂ :=
        (hWeightDeg e₀).symm.trans (hAB_hom he₀_ne)
      let γ₀ : I_D := ⟨e₀, (hMem_I (d₁ + d₂) e₀).mpr he₀_deg⟩
      set m₀ : k := (A₀ * B₀).coeff γ₀.1
      have hm₀_ne : m₀ ≠ 0 := he₀_ne
      let lam : k := P.coeff γ₀.1 * m₀⁻¹
      have hP_eq : P = (MvPolynomial.C lam * A₀) * B₀ := by
        ext e
        rw [mul_assoc, MvPolynomial.coeff_C_mul]
        by_cases hdeg : Finsupp.degree e = d₁ + d₂
        · let γ : I_D := ⟨e, (hMem_I (d₁ + d₂) e).mpr hdeg⟩
          have hpr := hs_prop γ γ₀
          rw [← hAB_sum γ₀, ← hAB_sum γ, sub_eq_zero] at hpr
          change P.coeff γ.1 = lam * (A₀ * B₀).coeff γ.1
          calc
            P.coeff γ.1 = (P.coeff γ.1 * m₀) * m₀⁻¹ := (mul_inv_cancel_right₀ hm₀_ne _).symm
            _ = (P.coeff γ₀.1 * (A₀ * B₀).coeff γ.1) * m₀⁻¹ := by rw [hpr]
            _ = lam * (A₀ * B₀).coeff γ.1 := by dsimp [lam]; ring
        · have hP_hom' : P.IsHomogeneous (d₁ + d₂) := hHomog
          rw [hP_hom'.coeff_eq_zero hdeg, hAB_hom.coeff_eq_zero hdeg, mul_zero]
      by_cases hlam : lam = 0
      · left
        rw [hP_eq, hlam, map_zero, zero_mul, zero_mul]
      · right
        refine ⟨MvPolynomial.C lam * A₀, B₀,
          MvPolynomial.IsHomogeneous.C_mul hA₀_hom lam, hB₀_hom,
          mul_ne_zero (MvPolynomial.C_ne_zero.mpr hlam) hA₀_ne, hB₀_ne, hP_eq⟩
    · rintro (rfl | ⟨A_hom, B_hom, hA_hom, hB_hom, hA_ne, hB_ne, rfl⟩)
      · let α₀ : I₁ := ⟨Finsupp.single 0 d₁, (hMem_I d₁ _).mpr (Finsupp.degree_single 0 d₁)⟩
        let β₀ : I₂ := ⟨Finsupp.single 0 d₂, (hMem_I d₂ _).mpr (Finsupp.degree_single 0 d₂)⟩
        let u : I₁ → k := fun α => if α = α₀ then 1 else 0
        let v : I₂ → k := fun β => if β = β₀ then 1 else 0
        refine ⟨fun p => u p.1 * v p.2, ?_, ?_, ?_⟩
        · intro h0
          have h1 := congrFun h0 (α₀, β₀)
          simp [u, v] at h1
        · intro α₁ α₂ β₁ β₂
          dsimp
          ring
        · intro γ₁ γ₂
          simp
      · have hA_hom' : A_hom.IsHomogeneous d₁ := hA_hom
        have hB_hom' : B_hom.IsHomogeneous d₂ := hB_hom
        obtain ⟨ea, hea⟩ := MvPolynomial.support_nonempty.mpr hA_ne
        obtain ⟨eb, heb⟩ := MvPolynomial.support_nonempty.mpr hB_ne
        have hea_ne : A_hom.coeff ea ≠ 0 := MvPolynomial.mem_support_iff.mp hea
        have heb_ne : B_hom.coeff eb ≠ 0 := MvPolynomial.mem_support_iff.mp heb
        let α₀ : I₁ := ⟨ea, (hMem_I d₁ ea).mpr ((hWeightDeg ea).symm.trans (hA_hom' hea_ne))⟩
        let β₀ : I₂ := ⟨eb, (hMem_I d₂ eb).mpr ((hWeightDeg eb).symm.trans (hB_hom' heb_ne))⟩
        refine ⟨fun p => A_hom.coeff p.1.1 * B_hom.coeff p.2.1, ?_, ?_, ?_⟩
        · intro h0
          exact mul_ne_zero hea_ne heb_ne (congrFun h0 (α₀, β₀))
        · intro α₁ α₂ β₁ β₂
          dsimp
          ring
        · intro γ₁ γ₂
          rw [← hConv A_hom B_hom hA_hom hB_hom γ₂, ← hConv A_hom B_hom hA_hom hB_hom γ₁]
          ring

  
  let R := MvPolynomial σ k
  have hPillar3 : ∀ (ι idx : Type) [Fintype ι]
      (deg : idx → ℕ)
      (G : idx → MvPolynomial ι R),
      (∀ j : idx, 1 ≤ deg j) →
      (∀ j : idx, G j ∈ MvPolynomial.homogeneousSubmodule ι R (deg j)) →
      ∃ S_elim : Set R,
        ∀ ℓ : σ → k,
          (∀ f ∈ S_elim, MvPolynomial.eval ℓ f = 0) ↔
            ∃ s : ι → k, s ≠ 0 ∧
              ∀ j : idx, MvPolynomial.eval s (MvPolynomial.map (MvPolynomial.eval ℓ) (G j)) = 0 := by
    intro ι idx _ deg G _ hHomog
    let A := MvPolynomial ι R
    let 𝒜 := MvPolynomial.homogeneousSubmodule ι R
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hGen : ∀ F : A, F ∈ Algebra.adjoin ↥(𝒜 0) ↑(Finset.univ.image (MvPolynomial.X : ι → A)) := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C r =>
        have hCr : (MvPolynomial.C r : A) ∈ 𝒜 0 := MvPolynomial.isHomogeneous_C ι r
        exact Subalgebra.algebraMap_mem _ (⟨MvPolynomial.C r, hCr⟩ : ↥(𝒜 0))
      | add p q hp hq => exact Subalgebra.add_mem _ hp hq
      | mul_X p i hp =>
        refine Subalgebra.mul_mem _ hp (Algebra.subset_adjoin ?_)
        exact Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ i))
    haveI : Algebra.FiniteType ↥(𝒜 0) A :=
      ⟨⟨Finset.univ.image (MvPolynomial.X : ι → A), eq_top_iff.mpr fun F _ => hGen F⟩⟩
    let π₀ := AlgebraicGeometry.Proj.toSpecZero 𝒜
    let V_proj : Set ↥(AlgebraicGeometry.Proj 𝒜) := ProjectiveSpectrum.zeroLocus 𝒜 (Set.range G)
    have hClosed_V : IsClosed V_proj := ProjectiveSpectrum.isClosed_zeroLocus 𝒜 (Set.range G)
    have hClosed_img : IsClosed (π₀.base '' V_proj) := π₀.isProperMap.isClosedMap V_proj hClosed_V
    let inv₀ : ↥(𝒜 0) →+* R := MvPolynomial.constantCoeff.comp (algebraMap ↥(𝒜 0) A)
    have hinv₀_C : ∀ r : R, inv₀ ⟨MvPolynomial.C r, MvPolynomial.isHomogeneous_C ι r⟩ = r := by
      intro r
      change MvPolynomial.constantCoeff (MvPolynomial.C r : A) = r
      rw [MvPolynomial.constantCoeff_eq, MvPolynomial.coeff_C, if_pos rfl]
    have hC_inv₀ : ∀ a : ↥(𝒜 0), a.1 = MvPolynomial.C (inv₀ a) := by
      intro a
      apply MvPolynomial.ext
      intro m
      by_cases hm0 : m = 0
      · subst hm0
        rw [MvPolynomial.coeff_C, if_pos rfl]
        rfl
      · rw [MvPolynomial.coeff_C, if_neg (Ne.symm hm0)]
        by_contra hne
        have hdeg0 : ∑ i ∈ m.support, m i = 0 :=
