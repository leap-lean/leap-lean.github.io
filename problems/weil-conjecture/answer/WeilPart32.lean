        ext (a | ⟨⟩) (b | ⟨⟩)
        · simp [Matrix.reindex_apply, Matrix.submatrix_apply, e_blk, N_lhs, M₀, haddCases_q]
        · simp [Matrix.reindex_apply, Matrix.submatrix_apply, e_blk, N_lhs, B₁₂, M₁, haddCases_q]
        · simp [Matrix.reindex_apply, Matrix.submatrix_apply, e_blk, N_lhs, C₂₁]
        · simp [Matrix.reindex_apply, Matrix.submatrix_apply, e_blk, N_lhs, D₂₂]
      let _ : Invertible M₀ := Matrix.invertibleOfIsUnitDet M₀ hM₀_det
      have hinv_eq : (⅟M₀ : Matrix (Fin s) (Fin s) A) = M₀⁻¹ := Matrix.invOf_eq_nonsing_inv M₀
      have hN_det : N_lhs.det = M₀.det * D_V γ₀ (x_coord m') := by
        rw [← Matrix.det_reindex_self e_blk.symm N_lhs, hBlk,
          Matrix.det_fromBlocks₁₁ M₀ B₁₂ C₂₁ D₂₂,
          Matrix.det_unique (D₂₂ - C₂₁ * ⅟M₀ * B₁₂)]
        congr 1
        rw [← hΨ m', hDV_φ, hinv_eq, Matrix.mul_assoc, Matrix.sub_apply, Matrix.mul_apply]
