  have hW_CQ : W ≤ C_Q (α, β) :=
    inf_le_inf_right _ ((TopologicalSpace.Opens.map p₁.base).monotone hUZ)
  have hVY_eq : V_Y = (TopologicalSpace.Opens.map ι_Y₂.base).obj W := by
    ext y; rfl
  obtain ⟨hAffVY, e_V, hι_appLE⟩ := hChart_Q (α, β) W hAffW hW_CQ V_Y hVY_eq
  let J_W : Ideal ↑(Q₂.presheaf.obj (Opposite.op W)) :=
    Ideal.span {(Q₂.presheaf.map (CategoryTheory.homOfLE hW_CQ).op).hom (Φ (α, β))}
  let G_inc : MvPolynomial (Fin 2) A :=
    MvPolynomial.C (ℓ_r β) +
      MvPolynomial.C (ℓ_r (β.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
      MvPolynomial.C (ℓ_r (β.succAbove 1)) * MvPolynomial.X (1 : Fin 2)
  have hPhi_W : (Q₂.presheaf.map (CategoryTheory.homOfLE hW_CQ).op).hom (Φ (α, β)) =
