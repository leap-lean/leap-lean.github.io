            RingHom.ker ev_𝔪.toRingHom = 𝔪 ∧
            hAffV.fromSpec.base ⟨𝔪, h𝔪.isPrime⟩ ∈ V ∧
            IsClosed ({hAffV.fromSpec.base ⟨𝔪, h𝔪.isPrime⟩} : Set Z_bar.left) ∧
            ∀ hz : hAffV.fromSpec.base ⟨𝔪, h𝔪.isPrime⟩ ∈ V,
              (hAffV.primeIdealOf ⟨hAffV.fromSpec.base ⟨𝔪, h𝔪.isPrime⟩, hz⟩).asIdeal = 𝔪) ∧
        (∀ (z : Z_bar.left) (hz : z ∈ V), IsClosed ({z} : Set Z_bar.left) →
          ((hAffV.primeIdealOf ⟨z, hz⟩).asIdeal).IsMaximal ∧
          hAffV.fromSpec.base (hAffV.primeIdealOf ⟨z, hz⟩) = z)) ∧
      (∀ (z : Z_bar.left) (hz : z ∈ V), IsClosed ({z} : Set Z_bar.left) →
        ∀ (ev_z : A →ₐ[k] k), RingHom.ker ev_z.toRingHom = (hAffV.primeIdealOf ⟨z, hz⟩).asIdeal →
          (∃ ψ_z : MvPolynomial (Fin (2 * m + 2)) k →+* A,
            AlgebraicGeometry.Etale (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z)) ∧
            (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V.ι ≫ Z_bar.hom) ∧
            (∀ i : Fin (2 * m + 2), ψ_z (MvPolynomial.X i) ∈ (hAffV.primeIdealOf ⟨z, hz⟩).asIdeal) ∧
            (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
              MvPolynomial.gradedAlgebra
             ∀ (c : Fin (M + 1) → k)
              (hLc : (∑ μ : Fin (M + 1), MvPolynomial.C (c μ) * MvPolynomial.X μ) ∈
                MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
              (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (M + 1)) k) ∈
                MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
              (c₀ : k) (w : Fin (2 * m + 2) → k),
              let p_z := (hAffV.primeIdealOf ⟨z, hz⟩).asIdeal
              let ℓ_z := ((AlgebraicGeometry.Proj.basicOpenIsoAway
                (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
                (MvPolynomial.X α₀) hXα zero_lt_one).hom ≫
                ι_bar.left.appLE
                  (AlgebraicGeometry.Proj.basicOpen
                    (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α₀))
