          have h1_in := Ideal.mul_mem_left p_spec.asHomogeneousIdeal.toIdeal (MvPolynomial.C c₀⁻¹) hc_in
          rw [← map_mul, inv_mul_cancel₀ hc_ne, map_one] at h1_in
