      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V.ι ≫ Z_bar.hom)
    (hKer : RingHom.ker φ = Ideal.span (Set.range q))
    (hDet0 : IsUnit (Matrix.det (Matrix.of fun a b : Fin s =>
      φ (MvPolynomial.pderiv (Fin.castAdd (2 * m + 2) (Fin.castAdd 0 b)) (q a)))))
