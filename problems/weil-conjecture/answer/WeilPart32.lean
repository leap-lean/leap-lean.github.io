      by_cases hd0 : d 0 = 0
      · have hd1 : d 1 ≠ 0 := by
          intro h1
          apply hd_ne
          ext i
          by_cases hi0 : i = 0
          · rw [hi0]; exact hd0
          · have hi1 : i = 1 := by omega
            rw [hi1]; exact h1
        obtain ⟨k₁, hk₁⟩ := Nat.exists_eq_succ_of_ne_zero hd1
        rw [hk₁, pow_succ]
        have hX1 : (MvPolynomial.X 1 : MvPolynomial (Fin 2) k) ∈
