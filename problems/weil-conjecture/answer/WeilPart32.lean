  obtain ⟨hBasic_S0, hPrime_S⟩ :=
    hBasic_Γ 3 1 (by decide) zero_lt_one F_L hFL (H₁ ^ 3) hH1_3 W_F le_rfl rfl
  obtain ⟨hBasic_hF2_0, _⟩ :=
    hBasic_Γ 3 1 (by decide) zero_lt_one F_L hFL (H₂ ^ 3) hH2_3 W_F le_rfl rfl

  have hBasic_S : Γ₀.left.basicOpen S_Γ = W₁ ⊓ W_F := by
    rw [hBasic_S0, hPow_H1_Γ, inf_comm]
  have hBasic_hF2 : Γ₀.left.basicOpen h_F2 = W_F ⊓ W₂ := by
    rw [hBasic_hF2_0, hPow_H2_Γ]

  have hΓ_in_H₀ : ∀ y : Γ₀.left, ι_ΓP.left.base y ∈ weilProjHyperplaneSet k N H₀ := by
    intro y
    have hy_range : ι_Γ.left.base y ∈ Set.range ι_Γ.left.base := ⟨y, rfl⟩
