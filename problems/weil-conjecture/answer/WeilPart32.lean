    (x_coord : Fin M → ↑(Z_bar.left.presheaf.obj (Opposite.op V)))
    (Ψ : Fin M → MvPolynomial (Fin (s + 0 + (2 * m + 2))) k)
    (v : Matrix (Fin M) (Fin (2 * m + 2)) ↑(Z_bar.left.presheaf.obj (Opposite.op V)))
