          (P₁.hom.appLE ⊤ (D₁ b) le_top).hom ((Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom c) :=
      fun b => (Classical.choose_spec (hDehom_P1 b (MvPolynomial.isHomogeneous_X k b)).2).1
    have he_X : ∀ b : Fin 2, e_P1 b Polynomial.X = t_sec b (Fin.rev b) :=
      fun b => (Classical.choose_spec (hDehom_P1 b (MvPolynomial.isHomogeneous_X k b)).2).2
    have hIso_Vp : ∀ p : Fin (M + 1) × Fin 2, IsIso (π₀_sch ∣_ V_p p) := by
