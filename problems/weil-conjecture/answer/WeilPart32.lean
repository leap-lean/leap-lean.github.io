    have hq₂Q₁_range : Set.range q₂Q₁.base = q₁Q.base ⁻¹' (p₂.base ⁻¹' (U₂ : Set X₂)) := by
      have hr := AlgebraicGeometry.IsOpenImmersion.range_pullbackSnd j₂ (q₁Q ≫ p₂)
      have hj₂_or : j₂.opensRange = U₂ := TopologicalSpace.Opens.ext hj₂_range
      rw [hr, hj₂_or]; rfl
    have hψ_range : Set.range ψ.base = (W : Set Q) := by
      have hθ_surj : Function.Surjective θ.hom.base := fun pt =>
        ⟨θ.inv.base pt, by change (θ.inv ≫ θ.hom).base pt = pt; rw [θ.inv_hom_id]; rfl⟩
      change Set.range ((q₂Q₁ ≫ q₁Q).base ∘ θ.hom.base) = _
      rw [Set.range_comp, hθ_surj.range_eq, Set.image_univ]
      change Set.range (q₁Q.base ∘ q₂Q₁.base) = _
      rw [Set.range_comp, hq₂Q₁_range]
      ext q; constructor
      · rintro ⟨q₁, hq₁_mem, rfl⟩
        have hp₁_mem : q₁Q.base q₁ ∈ p₁.base ⁻¹' (U₁ : Set X₁) := by
          rw [← hq₁Q_range]; exact ⟨q₁, rfl⟩
        exact ⟨hp₁_mem, hq₁_mem⟩
      · rintro ⟨hp₁_mem, hp₂_mem⟩
        change q ∈ p₁.base ⁻¹' (U₁ : Set X₁) at hp₁_mem
        rw [← hq₁Q_range] at hp₁_mem
        obtain ⟨q₁, rfl⟩ := hp₁_mem; exact ⟨q₁, hp₂_mem, rfl⟩
    have hOpensRange : ψ.opensRange = W := TopologicalSpace.Opens.ext hψ_range
    have hAffW : AlgebraicGeometry.IsAffineOpen W :=
      hOpensRange ▸ AlgebraicGeometry.isAffineOpen_opensRange ψ
    let R_W := Q.presheaf.obj (Opposite.op W)
    have hRangeEqFrom : Set.range ψ.base = Set.range hAffW.fromSpec.base :=
      hψ_range.trans hAffW.range_fromSpec.symm
    let β_W : AlgebraicGeometry.Spec P_c ≅ AlgebraicGeometry.Spec R_W :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq ψ hAffW.fromSpec hRangeEqFrom
    have hβW_fac : β_W.hom ≫ hAffW.fromSpec = ψ :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac ψ hAffW.fromSpec hRangeEqFrom
    let iso_Q : P_c ≅ R_W :=
      { hom := AlgebraicGeometry.Spec.preimage β_W.inv
        inv := AlgebraicGeometry.Spec.preimage β_W.hom
        hom_inv_id := by
          apply hSpecMapInj
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
            AlgebraicGeometry.Spec.map_preimage, β_W.hom_inv_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          apply hSpecMapInj
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
            AlgebraicGeometry.Spec.map_preimage, β_W.inv_hom_id, AlgebraicGeometry.Spec.map_id] }
    let e_Q : MvPolynomial (Fin n) A ≃+* ↑R_W := iso_Q.commRingCatIsoToRingEquiv
    have hψ_eq_from : ψ = AlgebraicGeometry.Spec.map iso_Q.inv ≫ hAffW.fromSpec := by
      rw [← hβW_fac]; congr 1
      exact (AlgebraicGeometry.Spec.map_preimage β_W.hom).symm
    have hψ_le_W : (⊤ : (AlgebraicGeometry.Spec P_c).Opens) ≤
        (TopologicalSpace.Opens.map ψ.base).obj W := by
      intro pt _; change ψ.base pt ∈ (W : Set Q); rw [← hψ_range]; exact ⟨pt, rfl⟩
    have h_fromW_le : (⊤ : (AlgebraicGeometry.Spec R_W).Opens) ≤
        (TopologicalSpace.Opens.map hAffW.fromSpec.base).obj W :=
      fun pt _ => (hAffW.isoSpec.inv.base pt).2
    have hψ_appW : ψ.appLE W ⊤ hψ_le_W =
        iso_Q.inv ≫ (AlgebraicGeometry.Scheme.ΓSpecIso P_c).inv := by
      have h_le' : (⊤ : (AlgebraicGeometry.Spec P_c).Opens) ≤
          (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Spec.map iso_Q.inv ≫ hAffW.fromSpec).base).obj W := by
        rwa [← hψ_eq_from]
      have h1 : ψ.appLE W ⊤ hψ_le_W =
          (AlgebraicGeometry.Spec.map iso_Q.inv ≫ hAffW.fromSpec).appLE W ⊤ h_le' := by congr 1
      rw [h1, ← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
          (AlgebraicGeometry.Spec.map iso_Q.inv) hAffW.fromSpec W ⊤ ⊤ h_fromW_le le_top]
      change hAffW.fromSpec.appLE W ⊤ h_fromW_le ≫
        (AlgebraicGeometry.Spec.map iso_Q.inv).appTop = _
      rw [hFromSpecApp hAffW h_fromW_le, ← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality]
    refine ⟨hAffW, e_Q, ?_, ?_⟩
    · intro a
      have h_j₁_le : (⊤ : (AlgebraicGeometry.Spec A_c).Opens) ≤
          (TopologicalSpace.Opens.map j₁.base).obj U₁ :=
        fun pt _ => (hAff₁.isoSpec.inv.base pt).2
      have h_lhs_le : (⊤ : (AlgebraicGeometry.Spec P_c).Opens) ≤
          (TopologicalSpace.Opens.map (ψ ≫ p₁).base).obj U₁ :=
        hψ_le_W.trans ((TopologicalSpace.Opens.map ψ.base).monotone inf_le_left)
      have h_rhs_le : (⊤ : (AlgebraicGeometry.Spec P_c).Opens) ≤
          (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map inl ≫ j₁).base).obj U₁ := by
        rwa [← hψ_p₁]
      have hL : (ψ ≫ p₁).appLE U₁ ⊤ h_lhs_le =
          p₁.appLE U₁ W inf_le_left ≫ iso_Q.inv ≫ (AlgebraicGeometry.Scheme.ΓSpecIso P_c).inv := by
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ψ p₁ U₁ W ⊤ inf_le_left hψ_le_W,
          hψ_appW]
      have hR : (AlgebraicGeometry.Spec.map inl ≫ j₁).appLE U₁ ⊤ h_rhs_le =
          inl ≫ (AlgebraicGeometry.Scheme.ΓSpecIso P_c).inv := by
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
            (AlgebraicGeometry.Spec.map inl) j₁ U₁ ⊤ ⊤ h_j₁_le le_top]
        change j₁.appLE U₁ ⊤ h_j₁_le ≫ (AlgebraicGeometry.Spec.map inl).appTop = _
        rw [hFromSpecApp hAff₁ h_j₁_le, ← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality]
      have hEqApp : (ψ ≫ p₁).appLE U₁ ⊤ h_lhs_le =
          (AlgebraicGeometry.Spec.map inl ≫ j₁).appLE U₁ ⊤ h_rhs_le := by congr 1
      rw [hL, hR] at hEqApp
      have hEq1 := congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso P_c).hom ≫ iso_Q.hom) hEqApp
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc,
        CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.comp_id] at hEq1
      exact congrArg (fun f : A_c ⟶ _ => f.hom a) hEq1
    · intro P
      have h_from₂_le : (⊤ : (AlgebraicGeometry.Spec (X₂.presheaf.obj (Opposite.op U₂))).Opens) ≤
          (TopologicalSpace.Opens.map hAff₂.fromSpec.base).obj U₂ :=
        fun pt _ => (hAff₂.isoSpec.inv.base pt).2
      have h_j₂_le : (⊤ : (AlgebraicGeometry.Spec B_c).Opens) ≤
          (TopologicalSpace.Opens.map j₂.base).obj U₂ :=
        fun pt _ => @h_from₂_le ((AlgebraicGeometry.Spec.map iso_e₂.inv).base pt) trivial
      have h_lhs_le : (⊤ : (AlgebraicGeometry.Spec P_c).Opens) ≤
          (TopologicalSpace.Opens.map (ψ ≫ p₂).base).obj U₂ :=
        hψ_le_W.trans ((TopologicalSpace.Opens.map ψ.base).monotone inf_le_right)
      have h_rhs_le : (⊤ : (AlgebraicGeometry.Spec P_c).Opens) ≤
          (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map inr ≫ j₂).base).obj U₂ := by
        rwa [← hψ_p₂]
      have hL : (ψ ≫ p₂).appLE U₂ ⊤ h_lhs_le =
          p₂.appLE U₂ W inf_le_right ≫ iso_Q.inv ≫ (AlgebraicGeometry.Scheme.ΓSpecIso P_c).inv := by
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ψ p₂ U₂ W ⊤ inf_le_right hψ_le_W,
          hψ_appW]
      have hj₂_app : j₂.appLE U₂ ⊤ h_j₂_le =
          iso_e₂.inv ≫ (AlgebraicGeometry.Scheme.ΓSpecIso B_c).inv := by
        dsimp [j₂]
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
            (AlgebraicGeometry.Spec.map iso_e₂.inv) hAff₂.fromSpec U₂ ⊤ ⊤ h_from₂_le le_top]
        change hAff₂.fromSpec.appLE U₂ ⊤ h_from₂_le ≫
          (AlgebraicGeometry.Spec.map iso_e₂.inv).appTop = _
        rw [hFromSpecApp hAff₂ h_from₂_le, ← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality]
      have hR : (AlgebraicGeometry.Spec.map inr ≫ j₂).appLE U₂ ⊤ h_rhs_le =
          iso_e₂.inv ≫ inr ≫ (AlgebraicGeometry.Scheme.ΓSpecIso P_c).inv := by
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
            (AlgebraicGeometry.Spec.map inr) j₂ U₂ ⊤ ⊤ h_j₂_le le_top]
        change j₂.appLE U₂ ⊤ h_j₂_le ≫ (AlgebraicGeometry.Spec.map inr).appTop = _
        rw [hj₂_app, CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality]
      have hEqApp : (ψ ≫ p₂).appLE U₂ ⊤ h_lhs_le =
          (AlgebraicGeometry.Spec.map inr ≫ j₂).appLE U₂ ⊤ h_rhs_le := by congr 1
      rw [hL, hR] at hEqApp
      have hEq1 := congrArg (iso_e₂.hom ≫ · ≫ (AlgebraicGeometry.Scheme.ΓSpecIso P_c).hom ≫ iso_Q.hom) hEqApp
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc,
        CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.comp_id,
        CategoryTheory.Iso.hom_inv_id_assoc] at hEq1
      exact congrArg (fun f : B_c ⟶ _ => f.hom P) hEq1

  
  
  
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
    MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
    MvPolynomial.gradedAlgebra
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k
  let P_M := weilProjectiveSpaceOver k M
  let P_2 := weilProjectiveSpaceOver k 2

  obtain ⟨hCov_PM, ⟨_, hAff_PM⟩, _, hOverlap_PM, hDehom_PM⟩ := hPart1 M
  obtain ⟨hCov_P2, ⟨hProp_P2, hAff_P2⟩, hConst_P2, hOverlap_P2, hDehom_P2⟩ := hPart1 2

  let D_M : Fin (M + 1) → P_M.left.Opens :=
    fun α => AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)
  let C_Z : Fin (M + 1) → Z_bar.left.Opens :=
    fun α => (TopologicalSpace.Opens.map ι_bar.left.base).obj (D_M α)
  let D_P : Fin 3 → P_2.left.Opens :=
    fun β => AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X β)

  have hCov_Z : (⨆ α : Fin (M + 1), C_Z α) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    rw [TopologicalSpace.Opens.mem_iSup]
    let x_M : AlgebraicGeometry.Proj 𝒜_M := ι_bar.left.base z
    have hx_M : x_M ∈
        (⨆ α : Fin (M + 1),
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α) :
            (AlgebraicGeometry.Proj 𝒜_M).Opens)) := by
      rw [hCov_PM]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hx_M
    exact hx_M

  have hCov_P : (⨆ β : Fin 3, D_P β) = ⊤ := hCov_P2

  let Q₂ := CategoryTheory.Limits.pullback Z_bar.hom P_2.hom
  let p₁ := CategoryTheory.Limits.pullback.fst Z_bar.hom P_2.hom
  let p₂ := CategoryTheory.Limits.pullback.snd Z_bar.hom P_2.hom

  let Idx : Type := Fin (M + 1) × Fin 3
  let C_Q : Idx → Q₂.Opens := fun γ =>
    (TopologicalSpace.Opens.map p₁.base).obj (C_Z γ.1) ⊓
      (TopologicalSpace.Opens.map p₂.base).obj (D_P γ.2)

  have hCov_Q : (⨆ γ : Idx, C_Q γ) = ⊤ := by
    rw [eq_top_iff]
    intro q _
    rw [TopologicalSpace.Opens.mem_iSup]
    have hq₁ : p₁.base q ∈ (⨆ α : Fin (M + 1), C_Z α) := by rw [hCov_Z]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hq₁
    obtain ⟨α, hα⟩ := hq₁
    have hq₂ : p₂.base q ∈ (⨆ β : Fin 3, D_P β) := by rw [hCov_P]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hq₂
    obtain ⟨β, hβ⟩ := hq₂
    exact ⟨⟨α, β⟩, ⟨hα, hβ⟩⟩

  let s_M : ∀ α : Fin (M + 1), Fin 3 → ↑(P_M.left.presheaf.obj (Opposite.op (D_M α))) :=
    fun α r =>
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α)
        (MvPolynomial.isHomogeneous_X k α) zero_lt_one).hom).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α, MvPolynomial.isHomogeneous_X k α⟩,
            ⟨1, pow_one _⟩⟩)

  let ℓ_tilde : ∀ α : Fin (M + 1), Fin 3 → ↑(Z_bar.left.presheaf.obj (Opposite.op (C_Z α))) :=
    fun α r => (ι_bar.left.app (D_M α)).hom (s_M α r)

  let w_tilde : ∀ β : Fin 3, Fin 3 → ↑(P_2.left.presheaf.obj (Opposite.op (D_P β))) :=
    fun β r =>
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β)
        (MvPolynomial.isHomogeneous_X k β) zero_lt_one).hom).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X r, MvPolynomial.isHomogeneous_X k r⟩,
            ⟨MvPolynomial.X β, MvPolynomial.isHomogeneous_X k β⟩, ⟨1, pow_one _⟩⟩)

  let Φ : ∀ γ : Idx, ↑(Q₂.presheaf.obj (Opposite.op (C_Q γ))) := fun γ =>
    ∑ r : Fin 3,
      (p₁.appLE (C_Z γ.1) (C_Q γ) inf_le_left).hom (ℓ_tilde γ.1 r) *
        (p₂.appLE (D_P γ.2) (C_Q γ) inf_le_right).hom (w_tilde γ.2 r)

  have hResTerm : ∀ (γ : Idx) (O : Q₂.Opens) (hO : O ≤ C_Q γ) (r : Fin 3),
      (Q₂.presheaf.map (CategoryTheory.homOfLE hO).op).hom
        ((p₁.appLE (C_Z γ.1) (C_Q γ) inf_le_left).hom (ℓ_tilde γ.1 r) *
          (p₂.appLE (D_P γ.2) (C_Q γ) inf_le_right).hom (w_tilde γ.2 r)) =
      ((p₁ ≫ ι_bar.left).appLE (D_M γ.1) O (hO.trans inf_le_left)).hom (s_M γ.1 r) *
        (p₂.appLE (D_P γ.2) O (hO.trans inf_le_right)).hom (w_tilde γ.2 r) := by
    intro γ O hO r
    rw [map_mul]
    congr 1
    · have h1 : p₁.appLE (C_Z γ.1) (C_Q γ) inf_le_left ≫
          Q₂.presheaf.map (CategoryTheory.homOfLE hO).op =
          p₁.appLE (C_Z γ.1) O (hO.trans inf_le_left) :=
        AlgebraicGeometry.Scheme.Hom.appLE_map p₁ inf_le_left (CategoryTheory.homOfLE hO).op
      have h2 : ι_bar.left.app (D_M γ.1) ≫ p₁.appLE (C_Z γ.1) O (hO.trans inf_le_left) =
          (p₁ ≫ ι_bar.left).appLE (D_M γ.1) O (hO.trans inf_le_left) := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE ι_bar.left (U := D_M γ.1)]
        exact AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
          p₁ ι_bar.left (D_M γ.1) (C_Z γ.1) O (le_refl _) (hO.trans inf_le_left)
      have h3 : (ι_bar.left.app (D_M γ.1) ≫ p₁.appLE (C_Z γ.1) (C_Q γ) inf_le_left) ≫
          Q₂.presheaf.map (CategoryTheory.homOfLE hO).op =
          (p₁ ≫ ι_bar.left).appLE (D_M γ.1) O (hO.trans inf_le_left) := by
        rw [CategoryTheory.Category.assoc, h1, h2]
      exact congrArg (fun f : P_M.left.presheaf.obj (Opposite.op (D_M γ.1)) ⟶
        Q₂.presheaf.obj (Opposite.op O) => f.hom (s_M γ.1 r)) h3
    · have h1 : p₂.appLE (D_P γ.2) (C_Q γ) inf_le_right ≫
          Q₂.presheaf.map (CategoryTheory.homOfLE hO).op =
          p₂.appLE (D_P γ.2) O (hO.trans inf_le_right) :=
        AlgebraicGeometry.Scheme.Hom.appLE_map p₂ inf_le_right (CategoryTheory.homOfLE hO).op
      exact congrArg (fun f : P_2.left.presheaf.obj (Opposite.op (D_P γ.2)) ⟶
        Q₂.presheaf.obj (Opposite.op O) => f.hom (w_tilde γ.2 r)) h1

  have hUnit_Q : ∀ γ γ' : Idx,
      ∃ u : ↑(Q₂.presheaf.obj (Opposite.op (C_Q γ ⊓ C_Q γ'))),
        IsUnit u ∧
        (Q₂.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (Φ γ) =
          u * (Q₂.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (Φ γ') := by
    rintro ⟨α, β⟩ ⟨α', β'⟩
    let O : Q₂.Opens := C_Q (α, β) ⊓ C_Q (α', β')
    obtain ⟨u_M, hu_M, hEq_M⟩ := hOverlap_PM α α'
      (MvPolynomial.isHomogeneous_X k α) (MvPolynomial.isHomogeneous_X k α')
    obtain ⟨u_2, hu_2, hEq_2⟩ := hOverlap_P2 β β'
      (MvPolynomial.isHomogeneous_X k β) (MvPolynomial.isHomogeneous_X k β')
    let u_M' : ↑(P_M.left.presheaf.obj (Opposite.op (D_M α ⊓ D_M α'))) := u_M
    let u_2' : ↑(P_2.left.presheaf.obj (Opposite.op (D_P β ⊓ D_P β'))) := u_2
    have hu_M' : IsUnit u_M' := hu_M
    have hu_2' : IsUnit u_2' := hu_2
    have hO_DM : O ≤ (TopologicalSpace.Opens.map (p₁ ≫ ι_bar.left).base).obj (D_M α ⊓ D_M α') :=
      le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_left)
    have hO_DP : O ≤ (TopologicalSpace.Opens.map p₂.base).obj (D_P β ⊓ D_P β') :=
      le_inf (inf_le_left.trans inf_le_right) (inf_le_right.trans inf_le_right)
    let φ_M : ↑(P_M.left.presheaf.obj (Opposite.op (D_M α ⊓ D_M α'))) →+*
        ↑(Q₂.presheaf.obj (Opposite.op O)) :=
      ((p₁ ≫ ι_bar.left).appLE (D_M α ⊓ D_M α') O hO_DM).hom
    let φ_2 : ↑(P_2.left.presheaf.obj (Opposite.op (D_P β ⊓ D_P β'))) →+*
        ↑(Q₂.presheaf.obj (Opposite.op O)) :=
      (p₂.appLE (D_P β ⊓ D_P β') O hO_DP).hom
    let u : ↑(Q₂.presheaf.obj (Opposite.op O)) := φ_M u_M' * φ_2 u_2'
    refine ⟨u, (hu_M'.map φ_M).mul (hu_2'.map φ_2), ?_⟩
    dsimp [Φ, u]
    rw [map_sum, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [hResTerm (α, β) O inf_le_left r, hResTerm (α', β') O inf_le_right r]
    have hM_left : P_M.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D_M α ⊓ D_M α' ≤ D_M α)).op ≫
        (p₁ ≫ ι_bar.left).appLE (D_M α ⊓ D_M α') O hO_DM =
        (p₁ ≫ ι_bar.left).appLE (D_M α) O (inf_le_left.trans inf_le_left) :=
      AlgebraicGeometry.Scheme.Hom.map_appLE (p₁ ≫ ι_bar.left) hO_DM
        (CategoryTheory.homOfLE (inf_le_left : D_M α ⊓ D_M α' ≤ D_M α)).op
    have hM_right : P_M.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D_M α ⊓ D_M α' ≤ D_M α')).op ≫
        (p₁ ≫ ι_bar.left).appLE (D_M α ⊓ D_M α') O hO_DM =
        (p₁ ≫ ι_bar.left).appLE (D_M α') O (inf_le_right.trans inf_le_left) :=
      AlgebraicGeometry.Scheme.Hom.map_appLE (p₁ ≫ ι_bar.left) hO_DM
        (CategoryTheory.homOfLE (inf_le_right : D_M α ⊓ D_M α' ≤ D_M α')).op
    have h2_left : P_2.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D_P β ⊓ D_P β' ≤ D_P β)).op ≫
        p₂.appLE (D_P β ⊓ D_P β') O hO_DP =
        p₂.appLE (D_P β) O (inf_le_left.trans inf_le_right) :=
      AlgebraicGeometry.Scheme.Hom.map_appLE p₂ hO_DP
        (CategoryTheory.homOfLE (inf_le_left : D_P β ⊓ D_P β' ≤ D_P β)).op
    have h2_right : P_2.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D_P β ⊓ D_P β' ≤ D_P β')).op ≫
        p₂.appLE (D_P β ⊓ D_P β') O hO_DP =
        p₂.appLE (D_P β') O (inf_le_right.trans inf_le_right) :=
      AlgebraicGeometry.Scheme.Hom.map_appLE p₂ hO_DP
        (CategoryTheory.homOfLE (inf_le_right : D_P β ⊓ D_P β' ≤ D_P β')).op
    have hsM_l := congrArg (fun f : P_M.left.presheaf.obj (Opposite.op (D_M α)) ⟶
      Q₂.presheaf.obj (Opposite.op O) => f.hom (s_M α r)) hM_left.symm
    have hsM_r := congrArg (fun f : P_M.left.presheaf.obj (Opposite.op (D_M α')) ⟶
      Q₂.presheaf.obj (Opposite.op O) => f.hom (s_M α' r)) hM_right.symm
    have hw_l := congrArg (fun f : P_2.left.presheaf.obj (Opposite.op (D_P β)) ⟶
      Q₂.presheaf.obj (Opposite.op O) => f.hom (w_tilde β r)) h2_left.symm
    have hw_r := congrArg (fun f : P_2.left.presheaf.obj (Opposite.op (D_P β')) ⟶
      Q₂.presheaf.obj (Opposite.op O) => f.hom (w_tilde β' r)) h2_right.symm
    rw [hsM_l, hsM_r, hw_l, hw_r]
    have h_eqM_r : ((P_M.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D_M α ⊓ D_M α' ≤ D_M α)).op).hom
        (s_M α r)) =
        u_M' * ((P_M.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D_M α ⊓ D_M α' ≤ D_M α')).op).hom
          (s_M α' r)) := hEq_M (L r) (hL_homog r)
    have h_eq2_r : ((P_2.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D_P β ⊓ D_P β' ≤ D_P β)).op).hom
        (w_tilde β r)) =
        u_2' * ((P_2.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D_P β ⊓ D_P β' ≤ D_P β')).op).hom
