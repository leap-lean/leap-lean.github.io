    intro z₀ hz₀_cl
    obtain ⟨α₀, hz₀_α₀⟩ := hProjCover M (ι_bar.left.base z₀)
    have hXα₀ : (MvPolynomial.X α₀ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1 :=
