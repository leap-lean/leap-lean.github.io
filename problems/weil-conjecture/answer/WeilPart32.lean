      rw [hSC0, map_zero, zero_mul] at hInvC_fold
      exact zero_ne_one hInvC_fold

    have hCov_C : V_C0 ⊔ V_C2 = ⊤ := by
      ext c
      simp only [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top, Set.mem_union,
        Set.mem_univ, iff_true]
      by_cases h0 : c ∈ V_C0
      · exact Or.inl h0
      · refine Or.inr ?_
        change ιCP.left.base c ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂
        by_contra h2
        exact hEmpty_YC_H₀₂.false ⟨ιCP.left.base c, ⟨⟨c, rfl⟩, h0⟩, h2⟩

    obtain ⟨hFin_VC0, hFin_VC2, _⟩ :=
      (weil_proj_basepointFree_triple_and_twoChart_line_finite k).2
        C V_C0 V_C2 hAff_VC0 hAff_VC2 hCov_C S_C u₀_C
        hBasic_SC (hBasic_u₀C.trans (inf_comm _ _)) hInv_SC_u₀C

    have hSurj_C2 : Function.Surjective (ιC.left.app U₂_c).hom :=
      AlgebraicGeometry.Scheme.Hom.app_surjective ιC.left U₂_c hAff₂
    have hSurj_C0 : Function.Surjective (ιC.left.app U₀_c).hom :=
      AlgebraicGeometry.Scheme.Hom.app_surjective ιC.left U₀_c hAff₀

    let φ_VC2 : k →+* ↑(C.left.presheaf.obj (Opposite.op V_C2)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        C.hom.appLE ⊤ V_C2 le_top).hom
    let φ_VC0 : k →+* ↑(C.left.presheaf.obj (Opposite.op V_C0)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        C.hom.appLE ⊤ V_C0 le_top).hom

    have hFin_PC := (hPoly_trans φ_k₂ φ_VC2 (ιC.left.app U₂_c).hom hSurj_C2 hC_k₂
      P_C rfl u₀ u₀_C hC_u₀).1 hFin_VC2
    have hFin_QC := (hPoly_trans φ_k₀ φ_VC0 (ιC.left.app U₀_c).hom hSurj_C0 hC_k₀
      Q_C rfl S_Z S_C hC_SZ).1 hFin_VC0

    exact ⟨hSZ_not_QC, hNontriv_PC, hMap_PQ, hFin_PC, hFin_QC⟩

  obtain ⟨hSZ_Q₁, hNontriv_P₁, hMap_P₁, hFin_P₁, hFin_Q₁⟩ :=
    hBranch_pkg C₁ hInt₁ ι₁ hCl₁ hYC₁_cl hDimYC₁_ge hDim_YC₁_H₀ hEmpty_C₁_H₀₂
  obtain ⟨hSZ_Q₂, hNontriv_P₂, hMap_P₂, hFin_P₂, hFin_Q₂⟩ :=
    hBranch_pkg C₂ hInt₂ ι₂ hCl₂ hYC₂_cl hDimYC₂_ge hDim_YC₂_H₀ hEmpty_C₂_H₀₂

  exact ⟨⟨hDom₂, hNoeth_and_Null.1, hDom₀, hDom₀₂, hu₀_ne, hSZ_ne,
      hu₀_not_pz, hSZ_not_pz, hNoeth_and_Null.2, hres₂_alg, hres₀_alg,
      hInj₂, hInj₀, hInv_SZ_u₀, hRel_u₁_v₁, hRel_τ₂_τ₀,
      hClear₂, hClear₀, hFin_A₂⟩,
    ⟨⟨hFin_BΓ2, hTF_BΓ2⟩, ⟨hFin_BΓ0, hTF_BΓ0⟩, ⟨hFin_BΓinf, hTF_BΓinf⟩,
      hNontriv_BΓ2, hAway_iso_Γ, hQuot1_final, hQuot2_final⟩,
    ⟨hSZ_Q₁, hSZ_Q₂, hNontriv_P₁, hNontriv_P₂, hMap_P₁, hMap_P₂,
      hFin_P₁, hFin_P₂, hFin_Q₁, hFin_Q₂⟩⟩

theorem weil_algClosed_pid_cubic_filtration_contradiction (k : Type u) [Field k]
    (A₂ A₀ A₀₂ : Type u) [CommRing A₂] [CommRing A₀] [CommRing A₀₂]
    [IsDomain A₂] [IsNoetherianRing A₂] [IsDomain A₀] [IsDomain A₀₂]
    [Algebra k A₂] [Algebra k A₀] [Algebra k A₀₂]
    (u₀ u₁ τ₂ : A₂) (S_Z v₁ τ₀ : A₀)
    (res₂ : A₂ →ₐ[k] A₀₂) (res₀ : A₀ →ₐ[k] A₀₂)
    (B_Γ0 B_Γ_inf : Type u) [CommRing B_Γ0] [CommRing B_Γ_inf]
    [Algebra k B_Γ0] [Algebra k B_Γ_inf]
    (T_Γ : B_Γ0) (S_Γ : B_Γ_inf)
    (p_z₀ P₁ P₂ : Ideal A₂) [p_z₀.IsMaximal] [P₁.IsPrime] [P₂.IsPrime]
    (Q₁ Q₂ : Ideal A₀) [Q₁.IsPrime] [Q₂.IsPrime]
    (t₀ : k)
    (hC1 : u₀ ≠ 0 ∧ τ₂ ≠ 0 ∧ S_Z ≠ 0 ∧ τ₀ ≠ 0 ∧
      u₀ ∉ p_z₀ ∧ u₀ - algebraMap k A₂ t₀ ∈ p_z₀ ∧
      Function.Injective res₂ ∧ Function.Injective res₀ ∧
      res₀ S_Z * res₂ u₀ = 1 ∧
      res₀ S_Z * res₂ u₁ = res₀ v₁ ∧
      res₀ S_Z ^ 3 * res₂ τ₂ = res₀ τ₀ ∧
      (∀ z : A₀₂, ∃ (m : ℕ) (x : A₂), res₂ u₀ ^ m * z = res₂ x) ∧
      (∀ z : A₀₂, ∃ (m : ℕ) (y : A₀), res₀ S_Z ^ m * z = res₀ y) ∧
      (letI : Algebra (MvPolynomial (Fin 2) k) A₂ :=
        (MvPolynomial.eval₂Hom (algebraMap k A₂) ![u₀, u₁]).toAlgebra
       Module.Finite (MvPolynomial (Fin 2) k) A₂))
    (hC2 :
      let B_Γ2 : Type u := A₂ ⧸ Ideal.span {u₀}
      let u₁_bar : B_Γ2 := Ideal.Quotient.mk (Ideal.span {u₀}) u₁
      (letI : Algebra (Polynomial k) B_Γ2 := (Polynomial.aeval u₁_bar).toRingHom.toAlgebra
       Module.Finite (Polynomial k) B_Γ2 ∧ Module.IsTorsionFree (Polynomial k) B_Γ2) ∧
      (letI : Algebra (Polynomial k) B_Γ0 := (Polynomial.aeval T_Γ).toRingHom.toAlgebra
       Module.Finite (Polynomial k) B_Γ0 ∧ Module.IsTorsionFree (Polynomial k) B_Γ0) ∧
      (letI : Algebra (Polynomial k) B_Γ_inf := (Polynomial.aeval S_Γ).toRingHom.toAlgebra
       Module.Finite (Polynomial k) B_Γ_inf ∧ Module.IsTorsionFree (Polynomial k) B_Γ_inf) ∧
      Nontrivial (B_Γ2 ⧸ Ideal.span {u₁_bar}) ∧
      (∃ e_Γ : Localization.Away T_Γ ≃ₐ[k] Localization.Away S_Γ,
        e_Γ (algebraMap B_Γ0 (Localization.Away T_Γ) T_Γ) *
          algebraMap B_Γ_inf (Localization.Away S_Γ) S_Γ = 1) ∧
      Nonempty ((B_Γ0 ⧸ Ideal.span {T_Γ}) ≃ₗ[k] (A₂ ⧸ Ideal.span {u₀, τ₂})) ∧
      Nonempty ((B_Γ_inf ⧸ Ideal.span {S_Γ}) ≃ₗ[k] (B_Γ2 ⧸ Ideal.span {u₁_bar ^ 3})))
    (hC3 : τ₂ ∈ P₁ ∧ τ₂ ∈ P₂ ∧ P₁ ≤ p_z₀ ∧ P₂ ≤ p_z₀ ∧
      τ₀ ∈ Q₁ ∧ τ₀ ∈ Q₂ ∧ S_Z ∉ Q₁ ∧ S_Z ∉ Q₂ ∧
      Ideal.map res₂.toRingHom P₁ = Ideal.map res₀.toRingHom Q₁ ∧
      Ideal.map res₂.toRingHom P₂ = Ideal.map res₀.toRingHom Q₂ ∧
      Nontrivial (A₂ ⧸ (P₁ ⊔ Ideal.span {u₀})) ∧
      Nontrivial (A₂ ⧸ (P₂ ⊔ Ideal.span {u₀})) ∧
      (letI : Algebra (Polynomial k) (A₂ ⧸ P₁) :=
        (Polynomial.aeval (Ideal.Quotient.mk P₁ u₀)).toRingHom.toAlgebra
       Module.Finite (Polynomial k) (A₂ ⧸ P₁)) ∧
      (letI : Algebra (Polynomial k) (A₂ ⧸ P₂) :=
        (Polynomial.aeval (Ideal.Quotient.mk P₂ u₀)).toRingHom.toAlgebra
       Module.Finite (Polynomial k) (A₂ ⧸ P₂)) ∧
      (letI : Algebra (Polynomial k) (A₀ ⧸ Q₁) :=
        (Polynomial.aeval (Ideal.Quotient.mk Q₁ S_Z)).toRingHom.toAlgebra
       Module.Finite (Polynomial k) (A₀ ⧸ Q₁)) ∧
      (letI : Algebra (Polynomial k) (A₀ ⧸ Q₂) :=
        (Polynomial.aeval (Ideal.Quotient.mk Q₂ S_Z)).toRingHom.toAlgebra
       Module.Finite (Polynomial k) (A₀ ⧸ Q₂)))
    (hC4 :
      (∀ (q : Ideal A₂) [q.IsPrime], q ≠ p_z₀ →
        let R_q := Localization.AtPrime q
        ¬(P₁ ≤ q ∧ P₂ ≤ q) ∧
        (P₁ ≤ q →
          Ideal.map (algebraMap A₂ R_q) P₁ = Ideal.span {algebraMap A₂ R_q τ₂}) ∧
        (P₂ ≤ q →
          Ideal.map (algebraMap A₂ R_q) P₂ = Ideal.span {algebraMap A₂ R_q τ₂}) ∧
        (¬(P₁ ≤ q) → ¬(P₂ ≤ q) → IsUnit (algebraMap A₂ R_q τ₂))) ∧
      (∀ (q : Ideal A₀) [q.IsPrime], S_Z ∈ q →
        let R_0q := Localization.AtPrime q
        (Q₁ ≤ q →
          Ideal.map (algebraMap A₀ R_0q) Q₁ = Ideal.span {algebraMap A₀ R_0q τ₀}) ∧
        (Q₂ ≤ q →
          Ideal.map (algebraMap A₀ R_0q) Q₂ = Ideal.span {algebraMap A₀ R_0q τ₀})) ∧
      (∀ (s g c : A₂) (j : ℕ),
        s ∉ P₁ → s * g = τ₂ ^ j * c →
        ∃ (d r : A₂), d ∉ p_z₀ ∧ d * (u₀ - algebraMap k A₂ t₀) ^ j * c - s * r ∈ P₁) ∧
      (∀ (s g c : A₂) (j : ℕ),
        s ∉ P₂ → s * g = τ₂ ^ j * c →
        ∃ (d r : A₂), d ∉ p_z₀ ∧ d * (u₀ - algebraMap k A₂ t₀) ^ j * c - s * r ∈ P₂)) :
    False :=
by
  classical
  obtain ⟨hu₀_ne, hτ₂_ne, _, hτ₀_ne, hu₀_pz, _, hinj₂, hinj₀,
    hSu₀, hSu₁, hS3τ, hClear₂, hClear₀, hFinMv⟩ := hC1
  let B_Γ2 : Type u := A₂ ⧸ Ideal.span {u₀}
  let u₁_bar : B_Γ2 := Ideal.Quotient.mk (Ideal.span {u₀}) u₁
  obtain ⟨hBΓ2, hBΓ0, hBΓinf, hNontriv_u₁bar, hLaur, ⟨e_Γ0_Q⟩, ⟨e_Γinf_Q⟩⟩ := hC2
  obtain ⟨hτ₂_P₁, hτ₂_P₂, hP₁_pz, hP₂_pz, _, _, hSZ_Q₁, hSZ_Q₂,
    hMap₁, hMap₂, hNontriv_P₁, hNontriv_P₂, hFin_P₁, hFin_P₂, hFin_Q₁, hFin_Q₂⟩ := hC3
  obtain ⟨hAway₂, hAway₀, hNode₁, hNode₂⟩ := hC4

  
  
  
  have hPart1a : ∀ {K : Type u} [Field K] {M : Type u} [CommRing M] [Algebra K M]
      (t : M) (n m : ℕ),
      (letI : Algebra (Polynomial K) M := (Polynomial.aeval t).toRingHom.toAlgebra
       Nonempty (Module.Basis (Fin n) (Polynomial K) M)) →
      Module.Finite K (M ⧸ Ideal.span {t ^ m}) ∧
        Module.finrank K (M ⧸ Ideal.span {t ^ m}) = n * m := by
    intro K _ M _ _ t n m hb
    letI : Algebra (Polynomial K) M := (Polynomial.aeval t).toRingHom.toAlgebra
    have hsmul_def : ∀ (P : Polynomial K) (x : M), P • x = Polynomial.aeval t P * x :=
      fun _ _ => rfl
    haveI : IsScalarTower K (Polynomial K) M :=
      IsScalarTower.of_algebraMap_smul fun c x => by
        rw [Polynomial.algebraMap_eq, hsmul_def, Polynomial.aeval_C, Algebra.smul_def]
    obtain ⟨b⟩ := hb
    let I_tm : Ideal M := Ideal.span {t ^ m}
    let mk_tm : M →ₗ[K] M ⧸ I_tm := (Ideal.Quotient.mkₐ K I_tm).toLinearMap
    let Φ : (Fin n × Fin m → K) →ₗ[K] (M ⧸ I_tm) :=
      { toFun := fun f => mk_tm (∑ i : Fin n, ∑ j : Fin m, f (i, j) • (t ^ j.1 * b i))
        map_add' := fun f g => by
          simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib, map_add]
        map_smul' := fun c f => by
          simp only [Pi.smul_apply, smul_eq_mul, ← smul_smul, ← Finset.smul_sum, map_smul,
            RingHom.id_apply] }
    have hΦ_bij : Function.Bijective Φ := by
      constructor
      · intro f g hfg
        have h0 : Φ (f - g) = 0 := by rw [map_sub, hfg, sub_self]
        suffices hzero : f - g = 0 from sub_eq_zero.mp hzero
        set h := f - g
        have hmem : (∑ i : Fin n, ∑ j : Fin m, h (i, j) • (t ^ j.1 * b i)) ∈ I_tm :=
          Ideal.Quotient.eq_zero_iff_mem.mp h0
        rw [Ideal.mem_span_singleton] at hmem
        obtain ⟨y, hy⟩ := hmem
        let R_poly : Fin n → Polynomial K :=
          fun i => ∑ j : Fin m, Polynomial.C (h (i, j)) * Polynomial.X ^ j.1
        have hLHS : (∑ i : Fin n, ∑ j : Fin m, h (i, j) • (t ^ j.1 * b i)) =
            ∑ i : Fin n, (R_poly i) • b i := by
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [hsmul_def]
          dsimp [R_poly]
          rw [map_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X, Algebra.smul_def, mul_assoc]
        have hRHS : t ^ m * y = ∑ i : Fin n, (Polynomial.X ^ m * b.repr y i) • b i := by
          conv_lhs => rw [← b.sum_repr y]
          have htm : t ^ m * (∑ i : Fin n, (b.repr y i) • b i) =
              (Polynomial.X ^ m : Polynomial K) • (∑ i : Fin n, (b.repr y i) • b i) := by
            rw [hsmul_def, map_pow, Polynomial.aeval_X]
          rw [htm, Finset.smul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [smul_smul]
        rw [hLHS, hRHS] at hy
        ext ⟨i, j⟩
        have hi_eq : R_poly i = Polynomial.X ^ m * b.repr y i := by
          have hrepr := congrArg (fun z => b.repr z i) hy
          simpa only [map_sum, map_smul, Module.Basis.repr_self, Finsupp.smul_single', mul_one,
            Finsupp.coe_finsetSum, Finset.sum_apply, Finsupp.single_apply, Finset.sum_ite_eq',
            Finset.mem_univ, ↓reduceIte] using hrepr
        have hcoeff := congrArg (fun P => P.coeff j.1) hi_eq
        have hR_coeff : (R_poly i).coeff j.1 = h (i, j) := by
          dsimp [R_poly]
          rw [Polynomial.finsetSum_coeff]
          rw [Finset.sum_eq_single j]
          · simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
          · intro j' _ hj'
            have hne : j'.1 ≠ j.1 := fun heq => hj' (Fin.ext heq)
            simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, Ne.symm hne]
          · intro hj; exact False.elim (hj (Finset.mem_univ j))
        rw [hR_coeff, Polynomial.coeff_X_pow_mul'] at hcoeff
        split_ifs at hcoeff with hle
        · omega
        · exact hcoeff
      · intro z
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
        let P : Fin n → Polynomial K := fun i => b.repr x i
        have hmon : (Polynomial.X ^ m : Polynomial K).Monic := Polynomial.monic_X_pow m
        let R : Fin n → Polynomial K := fun i => P i %ₘ (Polynomial.X ^ m)
        let Q : Fin n → Polynomial K := fun i => P i /ₘ (Polynomial.X ^ m)
        have hR_sum : ∀ i : Fin n,
            R i = ∑ j : Fin m, Polynomial.C ((R i).coeff j.1) * Polynomial.X ^ j.1 := by
          intro i
          ext d
          rw [Polynomial.finsetSum_coeff]
          by_cases hd : d < m
          · rw [Finset.sum_eq_single ⟨d, hd⟩]
            · simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
            · intro j _ hj
              have hne : j.1 ≠ d := fun heq => hj (Fin.ext heq)
              simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, Ne.symm hne]
            · intro hmem; exact False.elim (hmem (Finset.mem_univ _))
          · have hdeg : (R i).degree < ↑d := by
              calc (R i).degree < (Polynomial.X ^ m : Polynomial K).degree :=
                    Polynomial.degree_modByMonic_lt (P i) hmon
                _ = ↑m := Polynomial.degree_X_pow m
                _ ≤ ↑d := by exact_mod_cast (Nat.le_of_not_lt hd)
            rw [Polynomial.coeff_eq_zero_of_degree_lt hdeg]
            symm
            refine Finset.sum_eq_zero fun j _ => ?_
            have hne : d ≠ j.1 := by omega
            simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, hne]
        refine ⟨fun p => (R p.1).coeff p.2.1, ?_⟩
        change Ideal.Quotient.mk I_tm _ = Ideal.Quotient.mk I_tm x
        rw [Ideal.Quotient.eq]
        have hx_split : x = (∑ i : Fin n, ∑ j : Fin m, ((R i).coeff j.1) • (t ^ j.1 * b i)) +
            t ^ m * (∑ i : Fin n, (Q i) • b i) := by
          conv_lhs => rw [← b.sum_repr x]
          have hsum_P : (∑ i : Fin n, (P i) • b i) =
              (∑ i : Fin n, (R i) • b i) + ∑ i : Fin n, (Polynomial.X ^ m * Q i) • b i := by
            rw [← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [← add_smul, Polynomial.modByMonic_add_div (P i) (Polynomial.X ^ m)]
          rw [hsum_P]
          congr 1
          · refine Finset.sum_congr rfl fun i _ => ?_
            conv_lhs => rw [hR_sum i]
            rw [hsmul_def, map_sum, Finset.sum_mul]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X, Algebra.smul_def,
              mul_assoc]
          · rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [← smul_smul, hsmul_def, map_pow, Polynomial.aeval_X]
        have hdiff : (∑ i : Fin n, ∑ j : Fin m, ((R i).coeff j.1) • (t ^ j.1 * b i)) - x =
            t ^ m * (-(∑ i : Fin n, (Q i) • b i)) := by
          rw [hx_split]; ring
        rw [hdiff, Ideal.mem_span_singleton]
        exact ⟨_, rfl⟩
    let eΦ : (Fin n × Fin m → K) ≃ₗ[K] (M ⧸ I_tm) := LinearEquiv.ofBijective Φ hΦ_bij
    haveI : Module.Finite K (M ⧸ I_tm) := Module.Finite.of_surjective eΦ.toLinearMap eΦ.surjective
    refine ⟨inferInstance, ?_⟩
    rw [← eΦ.finrank_eq, Module.finrank_fintype_fun_eq_card, Fintype.card_prod,
      Fintype.card_fin, Fintype.card_fin]

  
  
  
  have hPart1b : ∀ {D : Type u} [CommRing D] [IsDomain D] [Algebra k D] (u : D),
      u ≠ 0 → Nontrivial (D ⧸ Ideal.span {u}) →
      (letI : Algebra (Polynomial k) D := (Polynomial.aeval u).toRingHom.toAlgebra
       Module.Finite (Polynomial k) D) →
      (letI : Algebra (Polynomial k) D := (Polynomial.aeval u).toRingHom.toAlgebra
       ∃ a : ℕ, 1 ≤ a ∧ Nonempty (Module.Basis (Fin a) (Polynomial k) D) ∧
         Module.Finite k (D ⧸ Ideal.span {u}) ∧
         Module.finrank k (D ⧸ Ideal.span {u}) = a) := by
    intro D _ _ _ u hu0 hNontriv hFinD
    letI : Algebra (Polynomial k) D := (Polynomial.aeval u).toRingHom.toAlgebra
    haveI : Module.Finite (Polynomial k) D := hFinD
    have haeval_ne : ∀ (n : ℕ) (P : Polynomial k), P.natDegree = n → P ≠ 0 →
        Polynomial.aeval u P ≠ 0 := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro P hdeg hP0 hev
        have hdiv := congrArg (Polynomial.aeval u) (Polynomial.X_mul_divX_add P)
        rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, hev] at hdiv
        by_cases hc : P.coeff 0 = 0
        · rw [hc, map_zero, add_zero] at hdiv
          have hdiv_ev : Polynomial.aeval u P.divX = 0 :=
            (mul_eq_zero.mp hdiv).resolve_left hu0
          have hXP : Polynomial.X * P.divX = P := by
            have h := Polynomial.X_mul_divX_add P
            rwa [hc, map_zero, add_zero] at h
          have hdiv_ne : P.divX ≠ 0 := by
            intro h0; rw [h0, mul_zero] at hXP; exact hP0 hXP.symm
          have hdeg_lt : P.divX.natDegree < n := by
            have h1 := Polynomial.natDegree_X_mul hdiv_ne
            rw [hXP, hdeg] at h1
            omega
          exact ih P.divX.natDegree hdeg_lt P.divX rfl hdiv_ne hdiv_ev
        · have hdiv' : u * Polynomial.aeval u P.divX = -algebraMap k D (P.coeff 0) :=
            eq_neg_of_add_eq_zero_left hdiv
          have hinv : u * (Polynomial.aeval u P.divX * algebraMap k D (-(P.coeff 0)⁻¹)) = 1 := by
            rw [← mul_assoc, hdiv', ← map_neg, ← map_mul, neg_mul_neg, mul_inv_cancel₀ hc, map_one]
          have h1_mem : (1 : D) ∈ Ideal.span {u} :=
            Ideal.mem_span_singleton.mpr ⟨_, hinv.symm⟩
          have h1_eq_0 : (1 : D ⧸ Ideal.span {u}) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr h1_mem
          exact zero_ne_one h1_eq_0.symm
    haveI : Module.IsTorsionFree (Polynomial k) D :=
      (Module.isTorsionFree_iff_smul_eq_zero (R := Polynomial k) (M := D)).mpr fun P d hPd => by
        change Polynomial.aeval u P * d = 0 at hPd
        rcases mul_eq_zero.mp hPd with hP | hd
        · by_cases hP0 : P = 0
          · exact Or.inl hP0
          · exact False.elim (haeval_ne P.natDegree P rfl hP0 hP)
        · exact Or.inr hd
    let ⟨a, b_D⟩ := Module.basisOfFiniteTypeTorsionFree' (R := Polynomial k) (M := D)
    obtain ⟨hFinQ, hRankQ⟩ := hPart1a (K := k) u a 1 ⟨b_D⟩
    rw [pow_one] at hFinQ
    rw [pow_one, Nat.mul_one] at hRankQ
    haveI : Module.Finite k (D ⧸ Ideal.span {u}) := hFinQ
    have ha_pos : 1 ≤ a := by
      rw [← hRankQ]
      exact Module.finrank_pos
    exact ⟨a, ha_pos, ⟨b_D⟩, hFinQ, hRankQ⟩

  
  
  
  have hPart1c :
      Module.Finite k (B_Γ0 ⧸ Ideal.span {T_Γ}) ∧
      Module.Finite k (B_Γ_inf ⧸ Ideal.span {S_Γ}) ∧
      Module.finrank k (B_Γ0 ⧸ Ideal.span {T_Γ}) =
        Module.finrank k (B_Γ_inf ⧸ Ideal.span {S_Γ}) := by
    obtain ⟨e_Γ, he_inv⟩ := hLaur
    let L₀ := Localization.Away (Polynomial.X : Polynomial k)
    have hPowX_nzd : Submonoid.powers (Polynomial.X : Polynomial k) ≤
        nonZeroDivisors (Polynomial k) := by
      rintro _ ⟨m, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (Polynomial.monic_X_pow m).ne_zero
    haveI : IsDomain L₀ := IsLocalization.isDomain_localization hPowX_nzd
    haveI : InvariantBasisNumber L₀ := invariantBasisNumber_of_nontrivial_of_commRing
    let X_loc : L₀ := algebraMap (Polynomial k) L₀ Polynomial.X
    have huX : IsUnit X_loc := IsLocalization.Away.algebraMap_isUnit Polynomial.X
    let X_inv : L₀ := ↑(huX.unit⁻¹)
    have hX_mul : X_loc * X_inv = 1 := huX.mul_val_inv
    have hX_inv_mul : X_inv * X_loc = 1 := huX.val_inv_mul
    have huX_inv : IsUnit X_inv := ⟨huX.unit⁻¹, rfl⟩

    have hLocBasis : ∀ {B : Type u} [CommRing B] [Algebra k B] (t : B) (r : ℕ),
        (letI : Algebra (Polynomial k) B := (Polynomial.aeval t).toRingHom.toAlgebra
         Module.IsTorsionFree (Polynomial k) B ∧
         Nonempty (Module.Basis (Fin r) (Polynomial k) B)) →
        let g_t : Polynomial k →+* Localization.Away t :=
          (algebraMap B (Localization.Away t)).comp (Polynomial.aeval t).toRingHom
        have hu_t : IsUnit (g_t Polynomial.X) := by
          simpa [g_t] using IsLocalization.Away.algebraMap_isUnit (S := Localization.Away t) t
        letI : Algebra L₀ (Localization.Away t) :=
          (IsLocalization.Away.lift Polynomial.X hu_t).toAlgebra
        Nonempty (Module.Basis (Fin r) L₀ (Localization.Away t)) := by
      intro B _ _ t r ⟨hTF, ⟨b⟩⟩
      letI : Algebra (Polynomial k) B := (Polynomial.aeval t).toRingHom.toAlgebra
      haveI : Module.IsTorsionFree (Polynomial k) B := hTF
      let R_t := Localization.Away t
      let g_t : Polynomial k →+* R_t := (algebraMap B R_t).comp (Polynomial.aeval t).toRingHom
      have hu_t : IsUnit (g_t Polynomial.X) := by
        simpa [g_t] using IsLocalization.Away.algebraMap_isUnit (S := R_t) t
      let φ_t : L₀ →+* R_t := IsLocalization.Away.lift Polynomial.X hu_t
      letI : Algebra L₀ R_t := φ_t.toAlgebra
      have hφ_eq : ∀ P : Polynomial k, φ_t (algebraMap (Polynomial k) L₀ P) =
          algebraMap B R_t (Polynomial.aeval t P) :=
        fun P => IsLocalization.Away.lift_eq Polynomial.X hu_t P
      have hφ_X : φ_t X_loc = algebraMap B R_t t := by
        simpa using hφ_eq Polynomial.X
      have hinj_B : Function.Injective (algebraMap B R_t) := by
        rw [injective_iff_map_eq_zero]
        intro y hy
        obtain ⟨⟨s, m, rfl⟩, hsm⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers t) R_t y).mp hy
        have hsm' : (Polynomial.X ^ m : Polynomial k) • y = 0 := by
          change Polynomial.aeval t (Polynomial.X ^ m) * y = 0
          simpa [map_pow] using hsm
        exact (smul_eq_zero.mp hsm').resolve_left (Polynomial.monic_X_pow m).ne_zero
      let v : Fin r → R_t := fun i => algebraMap B R_t (b i)
      have hli : LinearIndependent L₀ v := by
        rw [Fintype.linearIndependent_iff]
        intro c hc
        have hsurj : ∀ i : Fin r, ∃ (n : ℕ) (P : Polynomial k),
            c i * X_loc ^ n = algebraMap (Polynomial k) L₀ P :=
          fun i => IsLocalization.Away.surj Polynomial.X (c i)
        let n_fn : Fin r → ℕ := fun i => Classical.choose (hsurj i)
        let P_fn : Fin r → Polynomial k := fun i => Classical.choose (Classical.choose_spec (hsurj i))
        have hP_spec : ∀ i : Fin r, c i * X_loc ^ (n_fn i) = algebraMap (Polynomial k) L₀ (P_fn i) :=
          fun i => Classical.choose_spec (Classical.choose_spec (hsurj i))
        let N : ℕ := Finset.univ.sup n_fn
        let Q_fn : Fin r → Polynomial k := fun i => P_fn i * Polynomial.X ^ (N - n_fn i)
        have hQ_spec : ∀ i : Fin r, c i * X_loc ^ N = algebraMap (Polynomial k) L₀ (Q_fn i) := by
          intro i
          have hle : n_fn i ≤ N := Finset.le_sup (Finset.mem_univ i)
          have hsub : n_fn i + (N - n_fn i) = N := Nat.add_sub_of_le hle
          calc c i * X_loc ^ N = (c i * X_loc ^ (n_fn i)) * X_loc ^ (N - n_fn i) := by
                conv_lhs => rw [← hsub, pow_add]
                ring
            _ = algebraMap (Polynomial k) L₀ (P_fn i) *
                  algebraMap (Polynomial k) L₀ (Polynomial.X ^ (N - n_fn i)) := by
                rw [hP_spec i, map_pow]
            _ = algebraMap (Polynomial k) L₀ (Q_fn i) := (map_mul _ _ _).symm
        have hc_mul : φ_t (X_loc ^ N) * (∑ i : Fin r, c i • v i) = 0 := by rw [hc, mul_zero]
        rw [Finset.mul_sum] at hc_mul
        have hsum_B : algebraMap B R_t (∑ i : Fin r, (Q_fn i) • b i) = 0 := by
          rw [map_sum]
          rw [← hc_mul]
          refine Finset.sum_congr rfl fun i _ => ?_
          change algebraMap B R_t (Polynomial.aeval t (Q_fn i) * b i) =
            φ_t (X_loc ^ N) * (φ_t (c i) * algebraMap B R_t (b i))
          rw [map_mul, ← hφ_eq (Q_fn i), ← hQ_spec i, map_mul]
          ring
        have hsum0 : ∑ i : Fin r, (Q_fn i) • b i = 0 :=
          hinj_B (hsum_B.trans (map_zero _).symm)
        have hQ0 : ∀ i : Fin r, Q_fn i = 0 := Fintype.linearIndependent_iff.mp b.linearIndependent Q_fn hsum0
        intro i
        have hcX : c i * X_loc ^ N = 0 := by rw [hQ_spec i, hQ0 i, map_zero]
        exact ((huX.pow N).mul_left_eq_zero).mp hcX
      have hsp : ⊤ ≤ Submodule.span L₀ (Set.range v) := by
        intro z _
        obtain ⟨m, y, hzy⟩ := IsLocalization.Away.surj t z
        have hunit_cancel : z = φ_t (X_inv ^ m) * algebraMap B R_t y := by
          calc z = z * ((algebraMap B R_t t) ^ m * φ_t (X_inv ^ m)) := by
                rw [← hφ_X, ← map_pow, ← map_mul, ← mul_pow, hX_mul, one_pow, map_one, mul_one]
            _ = (z * (algebraMap B R_t t) ^ m) * φ_t (X_inv ^ m) := by ring
            _ = φ_t (X_inv ^ m) * algebraMap B R_t y := by rw [hzy, mul_comm]
        rw [hunit_cancel, ← b.sum_repr y, map_sum, Finset.mul_sum]
        refine Submodule.sum_mem _ fun i _ => ?_
        have hterm : φ_t (X_inv ^ m) * algebraMap B R_t ((b.repr y i) • b i) =
            (X_inv ^ m * algebraMap (Polynomial k) L₀ (b.repr y i)) • v i := by
          change φ_t (X_inv ^ m) * algebraMap B R_t (Polynomial.aeval t (b.repr y i) * b i) =
            φ_t (X_inv ^ m * algebraMap (Polynomial k) L₀ (b.repr y i)) * v i
          rw [map_mul, map_mul, hφ_eq]
          ring
        rw [hterm]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
      exact ⟨Module.Basis.mk hli hsp⟩

    obtain ⟨r_0, b₀, hFinQ0, hRankQ0⟩ :
        ∃ (r_0 : ℕ), (letI : Algebra (Polynomial k) B_Γ0 := (Polynomial.aeval T_Γ).toRingHom.toAlgebra
          Nonempty (Module.Basis (Fin r_0) (Polynomial k) B_Γ0)) ∧
          Module.Finite k (B_Γ0 ⧸ Ideal.span {T_Γ}) ∧
          Module.finrank k (B_Γ0 ⧸ Ideal.span {T_Γ}) = r_0 := by
      letI : Algebra (Polynomial k) B_Γ0 := (Polynomial.aeval T_Γ).toRingHom.toAlgebra
      haveI : Module.Finite (Polynomial k) B_Γ0 := hBΓ0.1
      haveI : Module.IsTorsionFree (Polynomial k) B_Γ0 := hBΓ0.2
      let ⟨r_0, b₀⟩ := Module.basisOfFiniteTypeTorsionFree' (R := Polynomial k) (M := B_Γ0)
      obtain ⟨hf, hr⟩ := hPart1a (K := k) T_Γ r_0 1 ⟨b₀⟩
      rw [pow_one] at hf; rw [pow_one, Nat.mul_one] at hr
      exact ⟨r_0, ⟨b₀⟩, hf, hr⟩
    obtain ⟨r_inf, b_inf, hFinQinf, hRankQinf⟩ :
        ∃ (r_inf : ℕ), (letI : Algebra (Polynomial k) B_Γ_inf := (Polynomial.aeval S_Γ).toRingHom.toAlgebra
          Nonempty (Module.Basis (Fin r_inf) (Polynomial k) B_Γ_inf)) ∧
          Module.Finite k (B_Γ_inf ⧸ Ideal.span {S_Γ}) ∧
          Module.finrank k (B_Γ_inf ⧸ Ideal.span {S_Γ}) = r_inf := by
      letI : Algebra (Polynomial k) B_Γ_inf := (Polynomial.aeval S_Γ).toRingHom.toAlgebra
      haveI : Module.Finite (Polynomial k) B_Γ_inf := hBΓinf.1
      haveI : Module.IsTorsionFree (Polynomial k) B_Γ_inf := hBΓinf.2
      let ⟨r_inf, b_inf⟩ := Module.basisOfFiniteTypeTorsionFree' (R := Polynomial k) (M := B_Γ_inf)
      obtain ⟨hf, hr⟩ := hPart1a (K := k) S_Γ r_inf 1 ⟨b_inf⟩
      rw [pow_one] at hf; rw [pow_one, Nat.mul_one] at hr
      exact ⟨r_inf, ⟨b_inf⟩, hf, hr⟩
    refine ⟨hFinQ0, hFinQinf, ?_⟩
    rw [hRankQ0, hRankQinf]
    let R_T := Localization.Away T_Γ
    let R_S := Localization.Away S_Γ
    let g_T : Polynomial k →+* R_T :=
      (algebraMap B_Γ0 R_T).comp (Polynomial.aeval T_Γ).toRingHom
    have hu_T : IsUnit (g_T Polynomial.X) := by
      simpa [g_T] using IsLocalization.Away.algebraMap_isUnit (S := R_T) T_Γ
    let φ_T : L₀ →+* R_T := IsLocalization.Away.lift Polynomial.X hu_T
    let g_S : Polynomial k →+* R_S :=
      (algebraMap B_Γ_inf R_S).comp (Polynomial.aeval S_Γ).toRingHom
    have hu_S : IsUnit (g_S Polynomial.X) := by
      simpa [g_S] using IsLocalization.Away.algebraMap_isUnit (S := R_S) S_Γ
    let φ_S : L₀ →+* R_S := IsLocalization.Away.lift Polynomial.X hu_S

    obtain ⟨B_T⟩ := hLocBasis T_Γ r_0 ⟨hBΓ0.2, b₀⟩
    obtain ⟨B_S⟩ := hLocBasis S_Γ r_inf ⟨hBΓinf.2, b_inf⟩

    let ψ_inv : Polynomial k →+* L₀ :=
      Polynomial.eval₂RingHom (algebraMap k L₀) X_inv
    have hu_ψ : IsUnit (ψ_inv Polynomial.X) := by
      simpa [ψ_inv] using huX_inv
    let σ_hom : L₀ →+* L₀ := IsLocalization.Away.lift Polynomial.X hu_ψ
    have hσ_X : σ_hom X_loc = X_inv := by
      simp [σ_hom, X_loc, ψ_inv]
    have hkc_L₀ : ∀ c : k, algebraMap k L₀ c = algebraMap (Polynomial k) L₀ (Polynomial.C c) :=
      fun _ => rfl
    have hσ_C : ∀ c : k, σ_hom (algebraMap (Polynomial k) L₀ (Polynomial.C c)) =
        algebraMap (Polynomial k) L₀ (Polynomial.C c) := by
      intro c
      rw [IsLocalization.Away.lift_eq]
      change Polynomial.eval₂ (algebraMap k L₀) X_inv (Polynomial.C c) = _
      rw [Polynomial.eval₂_C, hkc_L₀]
    have hσ_inv : σ_hom.comp σ_hom = RingHom.id L₀ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial k))
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, RingHom.id_apply]
        change σ_hom (σ_hom (algebraMap (Polynomial k) L₀ (Polynomial.C c))) =
          algebraMap (Polynomial k) L₀ (Polynomial.C c)
        rw [hσ_C, hσ_C]
      · simp only [RingHom.comp_apply, RingHom.id_apply]
        change σ_hom (σ_hom X_loc) = X_loc
        rw [hσ_X]
        have hmul1 : σ_hom X_inv * X_inv = 1 := by
          calc σ_hom X_inv * X_inv = σ_hom X_inv * σ_hom X_loc := by rw [hσ_X]
            _ = σ_hom (X_inv * X_loc) := (map_mul _ _ _).symm
            _ = 1 := by rw [hX_inv_mul, map_one]
        exact huX_inv.mul_right_cancel (hmul1.trans hX_mul.symm)
    have he_inter : e_Γ.toRingHom.comp φ_T = φ_S.comp σ_hom := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial k))
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply]
        change e_Γ (φ_T (algebraMap (Polynomial k) L₀ (Polynomial.C c))) =
          φ_S (σ_hom (algebraMap (Polynomial k) L₀ (Polynomial.C c)))
        rw [hσ_C, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq]
        change e_Γ (algebraMap B_Γ0 R_T (Polynomial.aeval T_Γ (Polynomial.C c))) =
          algebraMap B_Γ_inf R_S (Polynomial.aeval S_Γ (Polynomial.C c))
        rw [Polynomial.aeval_C, Polynomial.aeval_C,
          ← IsScalarTower.algebraMap_apply k B_Γ0 R_T c,
          ← IsScalarTower.algebraMap_apply k B_Γ_inf R_S c,
          e_Γ.commutes c]
      · simp only [RingHom.comp_apply]
        change e_Γ (φ_T X_loc) = φ_S (σ_hom X_loc)
        rw [hσ_X]
        have hT_X : φ_T X_loc = algebraMap B_Γ0 R_T T_Γ := by simp [φ_T, X_loc, g_T]
        have hS_X : φ_S X_loc = algebraMap B_Γ_inf R_S S_Γ := by simp [φ_S, X_loc, g_S]
        rw [hT_X]
        have huS_unit : IsUnit (algebraMap B_Γ_inf R_S S_Γ) :=
          IsLocalization.Away.algebraMap_isUnit S_Γ
        have h1 : φ_S X_inv * algebraMap B_Γ_inf R_S S_Γ = 1 := by
          rw [← hS_X, ← map_mul, hX_inv_mul, map_one]
        exact huS_unit.mul_right_cancel (he_inv.trans h1.symm)

    letI : Algebra L₀ R_T := φ_T.toAlgebra
    letI : Algebra L₀ R_S := φ_S.toAlgebra
    let w : Fin r_inf → R_T := fun j => e_Γ.symm (B_S j)
    have hw_li : LinearIndependent L₀ w := by
      rw [Fintype.linearIndependent_iff]
      intro c hc
      have he_c : e_Γ (∑ j : Fin r_inf, c j • w j) = 0 := by rw [hc, map_zero]
      rw [map_sum] at he_c
      have he_sum : ∑ j : Fin r_inf, (σ_hom (c j)) • B_S j = 0 := by
        rw [← he_c]
        refine Finset.sum_congr rfl fun j _ => ?_
        change φ_S (σ_hom (c j)) * B_S j = e_Γ (φ_T (c j) * e_Γ.symm (B_S j))
        rw [map_mul, e_Γ.apply_symm_apply]
        have hfun : e_Γ (φ_T (c j)) = φ_S (σ_hom (c j)) := RingHom.congr_fun he_inter (c j)
        rw [hfun]
      have hσ0 := Fintype.linearIndependent_iff.mp B_S.linearIndependent (fun j => σ_hom (c j)) he_sum
      intro j
      have hcj := congrArg σ_hom (hσ0 j)
      rw [map_zero] at hcj
      have hcomp : σ_hom (σ_hom (c j)) = c j := RingHom.congr_fun hσ_inv (c j)
      exact hcomp.symm.trans hcj
    have hw_sp : ⊤ ≤ Submodule.span L₀ (Set.range w) := by
      intro z _
      have hzS : e_Γ z = ∑ j : Fin r_inf, (B_S.repr (e_Γ z) j) • B_S j := (B_S.sum_repr (e_Γ z)).symm
      have hzT : z = e_Γ.symm (e_Γ z) := (e_Γ.symm_apply_apply z).symm
      rw [hzT, hzS, map_sum]
      refine Submodule.sum_mem _ fun j _ => ?_
      have hterm : e_Γ.symm ((B_S.repr (e_Γ z) j) • B_S j) =
          (σ_hom (B_S.repr (e_Γ z) j)) • w j := by
        change e_Γ.symm (φ_S (B_S.repr (e_Γ z) j) * B_S j) =
          φ_T (σ_hom (B_S.repr (e_Γ z) j)) * e_Γ.symm (B_S j)
        rw [map_mul]
        congr 1
        apply e_Γ.injective
        rw [e_Γ.apply_symm_apply]
        have hfun : e_Γ (φ_T (σ_hom (B_S.repr (e_Γ z) j))) =
            φ_S (σ_hom (σ_hom (B_S.repr (e_Γ z) j))) :=
          RingHom.congr_fun he_inter (σ_hom (B_S.repr (e_Γ z) j))
        have hcomp : σ_hom (σ_hom (B_S.repr (e_Γ z) j)) = B_S.repr (e_Γ z) j :=
          RingHom.congr_fun hσ_inv (B_S.repr (e_Γ z) j)
        rw [hcomp] at hfun
        exact hfun.symm
      rw [hterm]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
    let B_T2 : Module.Basis (Fin r_inf) L₀ R_T := Module.Basis.mk hw_li hw_sp
    exact Fintype.card_fin r_0 ▸ Fintype.card_fin r_inf ▸ Fintype.card_congr (B_T.indexEquiv B_T2)

  
  
  
  have hPart2 : Nonempty ((A₂ ⧸ Ideal.span {u₀, τ₂}) ≃ₗ[k]
      (A₂ ⧸ (P₁ ⊔ Ideal.span {u₀})) × (A₂ ⧸ (P₂ ⊔ Ideal.span {u₀}))) := by
    let I₁ : Ideal A₂ := P₁ ⊔ Ideal.span {u₀}
    let I₂ : Ideal A₂ := P₂ ⊔ Ideal.span {u₀}
    let J₀ : Ideal A₂ := Ideal.span {u₀, τ₂}
    have hu₀_J₀ : u₀ ∈ J₀ := Ideal.subset_span (by simp)
    have hτ₂_J₀ : τ₂ ∈ J₀ := Ideal.subset_span (by simp)
    have hCoprime : IsCoprime I₁ I₂ := by
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra hne
      obtain ⟨q, hq_max, hle⟩ := Ideal.exists_le_maximal (I₁ ⊔ I₂) hne
      haveI : q.IsPrime := hq_max.isPrime
      have hu₀_I₁ : u₀ ∈ I₁ := Submodule.mem_sup_right (Ideal.mem_span_singleton_self u₀)
      have hu₀_q : u₀ ∈ q := hle (Submodule.mem_sup_left hu₀_I₁)
      have hq_ne : q ≠ p_z₀ := fun heq => hu₀_pz (heq ▸ hu₀_q)
      have hP₁_q : P₁ ≤ q := (le_sup_left.trans le_sup_left).trans hle
      have hP₂_q : P₂ ≤ q := (le_sup_left.trans le_sup_right).trans hle
      exact (hAway₂ q hq_ne).1 ⟨hP₁_q, hP₂_q⟩
    have hJ₀_eq : J₀ = I₁ ⊓ I₂ := by
      apply le_antisymm
      · rw [Ideal.span_le]
        intro x hx
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rcases hx with hx | hx
        · rw [hx]
          exact ⟨Submodule.mem_sup_right (Ideal.mem_span_singleton_self u₀),
            Submodule.mem_sup_right (Ideal.mem_span_singleton_self u₀)⟩
        · rw [hx]
          exact ⟨Submodule.mem_sup_left hτ₂_P₁, Submodule.mem_sup_left hτ₂_P₂⟩
      · rintro x ⟨hx1, hx2⟩
        obtain ⟨p₁, hp₁, a₁, ha₁, hx_eq1⟩ := Submodule.mem_sup.mp hx1
        obtain ⟨p₂, hp₂, a₂, ha₂, hx_eq2⟩ := Submodule.mem_sup.mp hx2
        have ha₁_J₀ : a₁ ∈ J₀ := Ideal.span_mono (by intro z hz; simp at hz; simp [hz]) ha₁
        have ha₂_J₀ : a₂ ∈ J₀ := Ideal.span_mono (by intro z hz; simp at hz; simp [hz]) ha₂
        let C_x : Ideal A₂ :=
          { carrier := { a : A₂ | a * x ∈ J₀ }
            add_mem' := fun {b₁ b₂} hb₁ hb₂ => by
              change (b₁ + b₂) * x ∈ J₀; rw [add_mul]; exact J₀.add_mem hb₁ hb₂
            zero_mem' := by change 0 * x ∈ J₀; rw [zero_mul]; exact J₀.zero_mem
            smul_mem' := fun r {b} hb => by
              change (r • b) * x ∈ J₀; rw [smul_eq_mul, mul_assoc]; exact J₀.mul_mem_left r hb }
        have hCx_top : C_x = ⊤ := by
          by_contra hne
          obtain ⟨q, hq_max, hle⟩ := Ideal.exists_le_maximal C_x hne
          haveI : q.IsPrime := hq_max.isPrime
          have hu₀_Cx : u₀ ∈ C_x := J₀.mul_mem_right x hu₀_J₀
          have hq_ne : q ≠ p_z₀ := fun heq => hu₀_pz (heq ▸ hle hu₀_Cx)
          obtain ⟨_, hP₁_loc, hP₂_loc, hUnit_loc⟩ := hAway₂ q hq_ne
          let R_q := Localization.AtPrime q
          have hinj_q : Function.Injective (algebraMap A₂ R_q) :=
            IsLocalization.injective R_q q.primeCompl_le_nonZeroDivisors
          by_cases hP₁q : P₁ ≤ q
          · have hmem : algebraMap A₂ R_q p₁ ∈ Ideal.span {algebraMap A₂ R_q τ₂} := by
              rw [← hP₁_loc hP₁q]; exact Ideal.mem_map_of_mem _ hp₁
            obtain ⟨w, hw⟩ := Ideal.mem_span_singleton.mp hmem
            obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.surj q.primeCompl w
            have hsp₁ : s.1 * p₁ = τ₂ * c := hinj_q (by
              calc algebraMap A₂ R_q (s.1 * p₁)
                _ = algebraMap A₂ R_q p₁ * algebraMap A₂ R_q s.1 := by rw [map_mul, mul_comm]
                _ = algebraMap A₂ R_q τ₂ * (w * algebraMap A₂ R_q s.1) := by rw [hw, mul_assoc]
                _ = algebraMap A₂ R_q (τ₂ * c) := by rw [hcs, map_mul])
            have hs_Cx : s.1 ∈ C_x := by
              change s.1 * x ∈ J₀; rw [← hx_eq1, mul_add, hsp₁]
              exact J₀.add_mem (J₀.mul_mem_right c hτ₂_J₀) (J₀.mul_mem_left s.1 ha₁_J₀)
            exact s.2 (hle hs_Cx)
          · by_cases hP₂q : P₂ ≤ q
            · have hmem : algebraMap A₂ R_q p₂ ∈ Ideal.span {algebraMap A₂ R_q τ₂} := by
                rw [← hP₂_loc hP₂q]; exact Ideal.mem_map_of_mem _ hp₂
              obtain ⟨w, hw⟩ := Ideal.mem_span_singleton.mp hmem
              obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.surj q.primeCompl w
              have hsp₂ : s.1 * p₂ = τ₂ * c := hinj_q (by
                calc algebraMap A₂ R_q (s.1 * p₂)
                  _ = algebraMap A₂ R_q p₂ * algebraMap A₂ R_q s.1 := by rw [map_mul, mul_comm]
                  _ = algebraMap A₂ R_q τ₂ * (w * algebraMap A₂ R_q s.1) := by rw [hw, mul_assoc]
                  _ = algebraMap A₂ R_q (τ₂ * c) := by rw [hcs, map_mul])
              have hs_Cx : s.1 ∈ C_x := by
                change s.1 * x ∈ J₀; rw [← hx_eq2, mul_add, hsp₂]
                exact J₀.add_mem (J₀.mul_mem_right c hτ₂_J₀) (J₀.mul_mem_left s.1 ha₂_J₀)
              exact s.2 (hle hs_Cx)
            · have hτ₂_not_q : τ₂ ∉ q :=
                (IsLocalization.AtPrime.isUnit_to_map_iff R_q q τ₂).mp (hUnit_loc hP₁q hP₂q)
              have hτ₂_Cx : τ₂ ∈ C_x := J₀.mul_mem_right x hτ₂_J₀
              exact hτ₂_not_q (hle hτ₂_Cx)
        have h1 : (1 : A₂) ∈ C_x := hCx_top ▸ Submodule.mem_top
        change 1 * x ∈ J₀ at h1; rwa [one_mul] at h1
    let e_ring : (A₂ ⧸ J₀) ≃+* (A₂ ⧸ I₁) × (A₂ ⧸ I₂) :=
      (Ideal.quotEquivOfEq hJ₀_eq).trans (Ideal.quotientInfEquivQuotientProd I₁ I₂ hCoprime)
    exact ⟨{ e_ring.toAddEquiv with
      map_smul' := fun c z => by
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
        change e_ring (Ideal.Quotient.mk J₀ (c • a)) = c • e_ring (Ideal.Quotient.mk J₀ a)
        simp only [Algebra.smul_def, map_mul]; rfl }⟩

  
  
  
  have hPart3 : ∀ (d_Z : ℕ),
      Nontrivial B_Γ2 →
      (letI : Algebra (Polynomial k) B_Γ2 := (Polynomial.aeval u₁_bar).toRingHom.toAlgebra
       Nonempty (Module.Basis (Fin d_Z) (Polynomial k) B_Γ2)) →
      ∃ r₀ : ℕ, ∀ K : ℕ, r₀ ≤ K →
        ∃ W_K : Submodule k A₂,
          Module.Finite k W_K ∧
          2 * Module.finrank k W_K = d_Z * (K - r₀ + 2) * (K - r₀ + 1) ∧
          ∀ g ∈ W_K, ∃ g₀ : A₀, res₀ S_Z ^ K * res₂ g = res₀ g₀ := by
    intro d_Z hNontriv_BΓ2 hb_Γ2
    letI : Algebra (Polynomial k) B_Γ2 := (Polynomial.aeval u₁_bar).toRingHom.toAlgebra
    obtain ⟨b_Γ2⟩ := hb_Γ2
    haveI : Module.IsTorsionFree (Polynomial k) B_Γ2 := b_Γ2.isTorsionFree

    let R₁ := Polynomial k
    let ev₁ : R₁ →ₐ[k] A₂ := Polynomial.aeval u₁
    let R₂ := Polynomial R₁
    let ev₀₁ : R₂ →+* A₂ := Polynomial.eval₂RingHom ev₁.toRingHom u₀
    let algR₂A₂ : Algebra R₂ A₂ := ev₀₁.toAlgebra

    
    have hFinR₂ : @Module.Finite R₂ A₂ _ _ algR₂A₂.toModule := by
      let algMv : Algebra (MvPolynomial (Fin 2) k) A₂ :=
        (MvPolynomial.eval₂Hom (algebraMap k A₂) ![u₀, u₁]).toAlgebra
      obtain ⟨s_gen, hs_gen⟩ := @Module.Finite.fg_top (MvPolynomial (Fin 2) k) A₂ _ _ algMv.toModule hFinMv
      let ψ : MvPolynomial (Fin 2) k →+* R₂ :=
        MvPolynomial.eval₂Hom ((Polynomial.C : R₁ →+* R₂).comp Polynomial.C)
          ![Polynomial.X, Polynomial.C Polynomial.X]
      have hcomp_ev : ev₀₁.comp ψ =
          MvPolynomial.eval₂Hom (algebraMap k A₂) ![u₀, u₁] := by
        apply MvPolynomial.ringHom_ext
        · intro c
          simp only [RingHom.comp_apply, ψ, MvPolynomial.eval₂Hom_C]
          change Polynomial.eval₂ ev₁.toRingHom u₀ (Polynomial.C (Polynomial.C c)) = algebraMap k A₂ c
          rw [Polynomial.eval₂_C]
          exact Polynomial.aeval_C u₁ c
        · intro i
          fin_cases i
          · simp only [Fin.zero_eta, RingHom.comp_apply, ψ, MvPolynomial.eval₂Hom_X',
              Matrix.cons_val_zero]
            change Polynomial.eval₂ ev₁.toRingHom u₀ Polynomial.X = u₀
            exact Polynomial.eval₂_X ev₁.toRingHom u₀
          · simp only [Fin.mk_one, RingHom.comp_apply, ψ, MvPolynomial.eval₂Hom_X',
              Matrix.cons_val_one, Matrix.cons_val_zero]
            change Polynomial.eval₂ ev₁.toRingHom u₀ (Polynomial.C Polynomial.X) = u₁
            rw [Polynomial.eval₂_C]
            exact Polynomial.aeval_X u₁
      refine @Module.Finite.of_fg_top R₂ A₂ _ _ algR₂A₂.toModule ⟨s_gen, eq_top_iff.mpr ?_⟩
      intro x _
      have hx_mv : x ∈ @Submodule.span (MvPolynomial (Fin 2) k) A₂ _ _ algMv.toModule (s_gen : Set A₂) := by
        rw [hs_gen]; trivial
      letI : Module (MvPolynomial (Fin 2) k) A₂ := algMv.toModule
      letI : Module R₂ A₂ := algR₂A₂.toModule
      refine Submodule.span_induction
        (p := fun y _ => y ∈ Submodule.span R₂ (s_gen : Set A₂))
        (mem := fun y hy => Submodule.subset_span hy)
        (zero := Submodule.zero_mem _)
        (add := fun _ _ _ _ hy₁ hy₂ => Submodule.add_mem _ hy₁ hy₂)
        (smul := fun Q y _ hy => by
          have hsmul_eq : Q • y = (ψ Q) • y := by
            change MvPolynomial.eval₂Hom (algebraMap k A₂) ![u₀, u₁] Q * y = ev₀₁ (ψ Q) * y
            rw [← hcomp_ev]; rfl
          rw [hsmul_eq]
          exact Submodule.smul_mem _ (ψ Q) hy) hx_mv

    
    have hmk_ev₁ : ∀ q : R₁, Ideal.Quotient.mk (Ideal.span {u₀}) (ev₁ q) =
        Polynomial.aeval u₁_bar q := by
      intro q
      have halg : (Ideal.Quotient.mkₐ k (Ideal.span {u₀})).comp ev₁ =
          Polynomial.aeval u₁_bar := by ext; simp [ev₁, u₁_bar]
      exact AlgHom.congr_fun halg q

    have hinj_ev₁ : Function.Injective ev₁ := by
      rw [injective_iff_map_eq_zero]
      intro q hq
      have hquot : q • (1 : B_Γ2) = 0 := by
        change Polynomial.aeval u₁_bar q * 1 = 0
        rw [mul_one, ← hmk_ev₁ q, hq, map_zero]
      exact (smul_eq_zero.mp hquot).resolve_right one_ne_zero

    
    let F₁ := FractionRing R₁
    let M₁ : Submonoid A₂ := (nonZeroDivisors R₁).map ev₁.toRingHom
    have hM₁_nzd : M₁ ≤ nonZeroDivisors A₂ := by
      rintro _ ⟨q, hq, rfl⟩
      have hq0 : q ≠ 0 := nonZeroDivisors.ne_zero hq
      exact mem_nonZeroDivisors_of_ne_zero fun hev =>
        hq0 (hinj_ev₁ (hev.trans (map_zero _).symm))
    let A₂_loc := Localization M₁
    haveI : IsDomain A₂_loc := IsLocalization.isDomain_localization hM₁_nzd
    let ι_loc : A₂ →+* A₂_loc := algebraMap A₂ A₂_loc
    have hinj_loc : Function.Injective ι_loc := IsLocalization.injective A₂_loc hM₁_nzd
    have hunit_ev₁ : ∀ q : nonZeroDivisors R₁, IsUnit ((ι_loc.comp ev₁.toRingHom) q) := by
      intro q
      have hmem : ev₁.toRingHom q.1 ∈ M₁ := Submonoid.mem_map.mpr ⟨q.1, q.2, rfl⟩
      exact IsLocalization.map_units A₂_loc ⟨ev₁.toRingHom q.1, hmem⟩
    let φ_F₁ : F₁ →+* A₂_loc := IsLocalization.lift hunit_ev₁
    letI : Algebra F₁ A₂_loc := φ_F₁.toAlgebra
    have hφ_F₁_eq : ∀ q : R₁, algebraMap F₁ A₂_loc (algebraMap R₁ F₁ q) = ι_loc (ev₁ q) :=
      fun q => IsLocalization.lift_eq hunit_ev₁ q
    let u₀_loc : A₂_loc := ι_loc u₀
    have hu₀_loc_ne : u₀_loc ≠ 0 :=
      fun h0 => hu₀_ne (hinj_loc (h0.trans (map_zero _).symm))
    letI : Algebra (Polynomial F₁) A₂_loc := (Polynomial.aeval u₀_loc).toRingHom.toAlgebra

    have hmap_aeval : ∀ P : R₂,
        Polynomial.aeval u₀_loc (P.map (algebraMap R₁ F₁)) = ι_loc (ev₀₁ P) := by
      intro P
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      have hcomp_eq : (algebraMap F₁ A₂_loc).comp (algebraMap R₁ F₁) =
          ι_loc.comp ev₁.toRingHom := RingHom.ext hφ_F₁_eq
      rw [hcomp_eq]
      exact (Polynomial.hom_eval₂ P ev₁.toRingHom ι_loc u₀).symm

    have hFin_PF₁ : Module.Finite (Polynomial F₁) A₂_loc := by
      obtain ⟨s_gen, hs_gen⟩ := @Module.Finite.fg_top R₂ A₂ _ _ algR₂A₂.toModule hFinR₂
      refine Module.Finite.of_fg_top ⟨s_gen.image ι_loc, eq_top_iff.mpr ?_⟩
      have hA₂_in_span : ∀ a : A₂,
          ι_loc a ∈ Submodule.span (Polynomial F₁) (↑(s_gen.image ι_loc) : Set A₂_loc) := by
        intro a
        have ha_top : a ∈ @Submodule.span R₂ A₂ _ _ algR₂A₂.toModule (s_gen : Set A₂) := by
          rw [hs_gen]; trivial
        letI : Module R₂ A₂ := algR₂A₂.toModule
        refine Submodule.span_induction
          (p := fun y _ => ι_loc y ∈ Submodule.span (Polynomial F₁) (↑(s_gen.image ι_loc) : Set A₂_loc))
          (mem := fun y hy => Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem ι_loc hy)))
          (zero := by rw [map_zero]; exact Submodule.zero_mem _)
          (add := fun _ _ _ _ hy₁ hy₂ => by rw [map_add]; exact Submodule.add_mem _ hy₁ hy₂)
          (smul := fun P y _ hy => by
            have hsm : ι_loc (P • y) = (P.map (algebraMap R₁ F₁)) • (ι_loc y) := by
              change ι_loc (ev₀₁ P * y) = Polynomial.aeval u₀_loc (P.map (algebraMap R₁ F₁)) * ι_loc y
              rw [map_mul, hmap_aeval]
            rw [hsm]
            exact Submodule.smul_mem _ _ hy) ha_top
      intro z _
      obtain ⟨⟨a, m⟩, hzm⟩ := IsLocalization.surj M₁ z
      obtain ⟨q, hq, hmq⟩ := m.2
      have hq_ne : algebraMap R₁ F₁ q ≠ 0 :=
        fun h0 => nonZeroDivisors.ne_zero hq ((IsFractionRing.injective R₁ F₁) (h0.trans (map_zero _).symm))
      have hz_eq : z = (Polynomial.C ((algebraMap R₁ F₁ q)⁻¹)) • (ι_loc a) := by
        change z = Polynomial.aeval u₀_loc (Polynomial.C ((algebraMap R₁ F₁ q)⁻¹)) * ι_loc a
        rw [Polynomial.aeval_C, ← hzm]
        have hm_eq : ι_loc m.1 = algebraMap F₁ A₂_loc (algebraMap R₁ F₁ q) := by
          rw [← hmq, hφ_F₁_eq]; rfl
        change z = _ * (z * ι_loc m.1)
        rw [hm_eq]
        calc z = z * (algebraMap F₁ A₂_loc (algebraMap R₁ F₁ q * (algebraMap R₁ F₁ q)⁻¹)) := by
              rw [mul_inv_cancel₀ hq_ne, map_one, mul_one]
          _ = algebraMap F₁ A₂_loc ((algebraMap R₁ F₁ q)⁻¹) *
                (z * algebraMap F₁ A₂_loc (algebraMap R₁ F₁ q)) := by
              rw [map_mul]; ring
      rw [hz_eq]
      exact Submodule.smul_mem _ _ (hA₂_in_span a)
    haveI : Module.Finite (Polynomial F₁) A₂_loc := hFin_PF₁

    have haeval_PF₁_ne : ∀ (n : ℕ) (P : Polynomial F₁), P.natDegree = n → P ≠ 0 →
        Polynomial.aeval u₀_loc P ≠ 0 := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro P hdeg hP0 hev
        have hdiv := congrArg (Polynomial.aeval u₀_loc) (Polynomial.X_mul_divX_add P)
        rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, hev] at hdiv
        by_cases hc : P.coeff 0 = 0
        · rw [hc, map_zero, add_zero] at hdiv
          have hdiv_ev : Polynomial.aeval u₀_loc P.divX = 0 :=
            (mul_eq_zero.mp hdiv).resolve_left hu₀_loc_ne
          have hXP : Polynomial.X * P.divX = P := by
            have h := Polynomial.X_mul_divX_add P
            rwa [hc, map_zero, add_zero] at h
          have hdiv_ne : P.divX ≠ 0 := by
            intro h0; rw [h0, mul_zero] at hXP; exact hP0 hXP.symm
          have hdeg_lt : P.divX.natDegree < n := by
            have h1 := Polynomial.natDegree_X_mul hdiv_ne
            rw [hXP, hdeg] at h1
            omega
          exact ih P.divX.natDegree hdeg_lt P.divX rfl hdiv_ne hdiv_ev
        · have hdiv' : u₀_loc * Polynomial.aeval u₀_loc P.divX =
              -algebraMap F₁ A₂_loc (P.coeff 0) :=
            eq_neg_of_add_eq_zero_left hdiv
          let w_loc : A₂_loc :=
            Polynomial.aeval u₀_loc P.divX * algebraMap F₁ A₂_loc (-(P.coeff 0)⁻¹)
          have hinv : u₀_loc * w_loc = 1 := by
            dsimp [w_loc]
            rw [← mul_assoc, hdiv', ← map_neg, ← map_mul, neg_mul_neg, mul_inv_cancel₀ hc, map_one]
          obtain ⟨⟨y_loc, m_loc⟩, hwm⟩ := IsLocalization.surj M₁ w_loc
          obtain ⟨q, hq, hmq⟩ := m_loc.2
          have hu₀y_eq : u₀ * y_loc = ev₁ q := hinj_loc (by
            have hwm' : w_loc * ι_loc m_loc.1 = ι_loc y_loc := hwm
            calc ι_loc (u₀ * y_loc)
              _ = u₀_loc * ι_loc y_loc := map_mul _ _ _
              _ = u₀_loc * (w_loc * ι_loc m_loc.1) := by rw [← hwm']
              _ = (u₀_loc * w_loc) * ι_loc m_loc.1 := by ring
              _ = ι_loc (ev₁ q) := by rw [hinv, one_mul, ← hmq]; rfl)
          have hq_smul : q • (1 : B_Γ2) = 0 := by
            change Polynomial.aeval u₁_bar q * 1 = 0
            rw [mul_one, ← hmk_ev₁ q, ← hu₀y_eq]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr ⟨_, rfl⟩)
          exact nonZeroDivisors.ne_zero hq ((smul_eq_zero.mp hq_smul).resolve_right one_ne_zero)

    have hTF_PF₁ : Module.IsTorsionFree (Polynomial F₁) A₂_loc :=
      (Module.isTorsionFree_iff_smul_eq_zero (R := Polynomial F₁) (M := A₂_loc)).mpr fun P z hPz => by
        change Polynomial.aeval u₀_loc P * z = 0 at hPz
        rcases mul_eq_zero.mp hPz with hP | hz
        · by_cases hP0 : P = 0
          · exact Or.inl hP0
          · exact False.elim (haeval_PF₁_ne P.natDegree P rfl hP0 hP)
        · exact Or.inr hz
    haveI : Module.IsTorsionFree (Polynomial F₁) A₂_loc := hTF_PF₁

    let pkg_loc := @Module.basisOfFiniteTypeTorsionFree' (Polynomial F₁) _ A₂_loc _ _ _ _ hFin_PF₁ hTF_PF₁
    let r_Z := pkg_loc.1
    let b_loc := pkg_loc.2
    obtain ⟨_, hRank_rZ⟩ := hPart1a (K := F₁) u₀_loc r_Z 1 ⟨b_loc⟩
    rw [pow_one, Nat.mul_one] at hRank_rZ

    let Q_loc := A₂_loc ⧸ Ideal.span {u₀_loc}
    let a_lift : Fin d_Z → A₂ := fun ν => Quotient.out (b_Γ2 ν)
    have ha_lift : ∀ ν : Fin d_Z, Ideal.Quotient.mk (Ideal.span {u₀}) (a_lift ν) = b_Γ2 ν :=
      fun ν => Quotient.out_eq (b_Γ2 ν)
    let w_bar : Fin d_Z → Q_loc :=
      fun ν => Ideal.Quotient.mk (Ideal.span {u₀_loc}) (ι_loc (a_lift ν))
    have hw_li : LinearIndependent F₁ w_bar := by
      rw [Fintype.linearIndependent_iff]
      intro c hc
      have hsurj_c : ∀ ν : Fin d_Z, ∃ p : R₁ × nonZeroDivisors R₁,
          c ν * algebraMap R₁ F₁ p.2.1 = algebraMap R₁ F₁ p.1 :=
        fun ν => IsLocalization.surj (nonZeroDivisors R₁) (c ν)
      let p_fn : Fin d_Z → R₁ × nonZeroDivisors R₁ := fun ν => Classical.choose (hsurj_c ν)
      have hp_spec : ∀ ν : Fin d_Z,
          c ν * algebraMap R₁ F₁ (p_fn ν).2.1 = algebraMap R₁ F₁ (p_fn ν).1 :=
        fun ν => Classical.choose_spec (hsurj_c ν)
      let Q_val : R₁ := ∏ ν : Fin d_Z, (p_fn ν).2.1
      have hQ_val_ne : Q_val ≠ 0 :=
        Finset.prod_ne_zero_iff.mpr fun ν _ => nonZeroDivisors.ne_zero (p_fn ν).2.2
      let P_ν : Fin d_Z → R₁ :=
        fun ν => (p_fn ν).1 * ∏ ν' ∈ Finset.univ.erase ν, (p_fn ν').2.1
      have hP_spec : ∀ ν : Fin d_Z,
          algebraMap R₁ F₁ Q_val * c ν = algebraMap R₁ F₁ (P_ν ν) := by
        intro ν
        have hQ_split : Q_val = (p_fn ν).2.1 * ∏ ν' ∈ Finset.univ.erase ν, (p_fn ν').2.1 :=
          (Finset.mul_prod_erase Finset.univ (fun x => (p_fn x).2.1) (Finset.mem_univ ν)).symm
        calc algebraMap R₁ F₁ Q_val * c ν
          _ = (c ν * algebraMap R₁ F₁ (p_fn ν).2.1) *
                algebraMap R₁ F₁ (∏ ν' ∈ Finset.univ.erase ν, (p_fn ν').2.1) := by
              rw [hQ_split, map_mul]; ring
          _ = algebraMap R₁ F₁ (P_ν ν) := by rw [hp_spec ν, ← map_mul]
      have hc_mul : (algebraMap R₁ F₁ Q_val) • (∑ ν : Fin d_Z, c ν • w_bar ν) = 0 := by
        rw [hc, smul_zero]
      rw [Finset.smul_sum] at hc_mul
      have hmem_loc : ι_loc (∑ ν : Fin d_Z, ev₁ (P_ν ν) * a_lift ν) ∈ Ideal.span {u₀_loc} := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        rw [map_sum, map_sum, ← hc_mul]
        refine Finset.sum_congr rfl fun ν _ => ?_
        rw [smul_smul, hP_spec ν]
        change Ideal.Quotient.mk (Ideal.span {u₀_loc}) (ι_loc (ev₁ (P_ν ν) * a_lift ν)) =
          (algebraMap R₁ F₁ (P_ν ν)) • Ideal.Quotient.mk (Ideal.span {u₀_loc}) (ι_loc (a_lift ν))
        rw [map_mul, ← hφ_F₁_eq]; rfl
      obtain ⟨z_w, hzw⟩ := Ideal.mem_span_singleton.mp hmem_loc
      obtain ⟨⟨y_w, m_w⟩, hzm_w⟩ := IsLocalization.surj M₁ z_w
      obtain ⟨q', hq', hmq'⟩ := m_w.2
      have hA₂_eq : ev₁ q' * (∑ ν : Fin d_Z, ev₁ (P_ν ν) * a_lift ν) = u₀ * y_w := hinj_loc (by
        have hm_eq : ι_loc m_w.1 = ι_loc (ev₁ q') := by rw [← hmq']; rfl
        have hzm_w' : z_w * ι_loc m_w.1 = ι_loc y_w := hzm_w
        calc ι_loc (ev₁ q' * ∑ ν, ev₁ (P_ν ν) * a_lift ν)
          _ = ι_loc (ev₁ q') * ι_loc (∑ ν, ev₁ (P_ν ν) * a_lift ν) := map_mul _ _ _
          _ = u₀_loc * (z_w * ι_loc m_w.1) := by rw [hzw, hm_eq]; ring
          _ = ι_loc (u₀ * y_w) := by rw [hzm_w', map_mul])
      have hBΓ2_zero : ∑ ν : Fin d_Z, (q' * P_ν ν) • b_Γ2 ν = 0 := by
        have hmk0 : Ideal.Quotient.mk (Ideal.span {u₀}) (u₀ * y_w) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr ⟨_, rfl⟩)
        rw [← hA₂_eq, Finset.mul_sum, map_sum] at hmk0
        rw [← hmk0]
        refine Finset.sum_congr rfl fun ν _ => ?_
        change Polynomial.aeval u₁_bar (q' * P_ν ν) * b_Γ2 ν =
          Ideal.Quotient.mk (Ideal.span {u₀}) (ev₁ q' * (ev₁ (P_ν ν) * a_lift ν))
        conv_rhs => rw [map_mul, map_mul, hmk_ev₁, hmk_ev₁, ha_lift ν]
        rw [map_mul, mul_assoc]
      have hqP0 := Fintype.linearIndependent_iff.mp b_Γ2.linearIndependent
        (fun ν => q' * P_ν ν) hBΓ2_zero
      intro ν
      have hP0 : P_ν ν = 0 := (mul_eq_zero.mp (hqP0 ν)).resolve_left (nonZeroDivisors.ne_zero hq')
      have hcQ0 : algebraMap R₁ F₁ Q_val * c ν = 0 := by rw [hP_spec ν, hP0, map_zero]
      have hQ_ne : algebraMap R₁ F₁ Q_val ≠ 0 :=
        fun h0 => hQ_val_ne ((IsFractionRing.injective R₁ F₁) (h0.trans (map_zero _).symm))
      exact (mul_eq_zero.mp hcQ0).resolve_left hQ_ne
    have hw_sp : ⊤ ≤ Submodule.span F₁ (Set.range w_bar) := by
      intro z_bar _
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z_bar
      obtain ⟨⟨a, m⟩, hzm⟩ := IsLocalization.surj M₁ z
      obtain ⟨q, hq, hmq⟩ := m.2
      have hq_ne : algebraMap R₁ F₁ q ≠ 0 :=
        fun h0 => nonZeroDivisors.ne_zero hq
          ((IsFractionRing.injective R₁ F₁) (h0.trans (map_zero _).symm))
      let a_bar : B_Γ2 := Ideal.Quotient.mk (Ideal.span {u₀}) a
      have ha_diff : a - ∑ ν : Fin d_Z, ev₁ (b_Γ2.repr a_bar ν) * a_lift ν ∈ Ideal.span {u₀} := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        rw [map_sub, sub_eq_zero]
        change a_bar = Ideal.Quotient.mk (Ideal.span {u₀}) _
        conv_lhs => rw [← b_Γ2.sum_repr a_bar]
        rw [map_sum]
        refine Finset.sum_congr rfl fun ν _ => ?_
        change Polynomial.aeval u₁_bar (b_Γ2.repr a_bar ν) * b_Γ2 ν =
          Ideal.Quotient.mk (Ideal.span {u₀}) (ev₁ (b_Γ2.repr a_bar ν) * a_lift ν)
        rw [map_mul, hmk_ev₁, ha_lift ν]
      obtain ⟨y_u, hy_u⟩ := Ideal.mem_span_singleton.mp ha_diff
      have hmk_a : Ideal.Quotient.mk (Ideal.span {u₀_loc}) (ι_loc a) =
          ∑ ν : Fin d_Z, (algebraMap R₁ F₁ (b_Γ2.repr a_bar ν)) • w_bar ν := by
        have ha_eq : a = u₀ * y_u + ∑ ν : Fin d_Z, ev₁ (b_Γ2.repr a_bar ν) * a_lift ν :=
          eq_add_of_sub_eq hy_u
        have hmk_u : Ideal.Quotient.mk (Ideal.span {u₀_loc}) (ι_loc (u₀ * y_u)) = 0 := by
          rw [map_mul]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr ⟨_, rfl⟩)
        rw [ha_eq, map_add, map_add, hmk_u, zero_add, map_sum, map_sum]
        refine Finset.sum_congr rfl fun ν _ => ?_
        change Ideal.Quotient.mk (Ideal.span {u₀_loc}) (ι_loc (ev₁ (b_Γ2.repr a_bar ν) * a_lift ν)) =
          (algebraMap R₁ F₁ (b_Γ2.repr a_bar ν)) • w_bar ν
        rw [map_mul, ← hφ_F₁_eq]; rfl
      have hz_eq : Ideal.Quotient.mk (Ideal.span {u₀_loc}) z =
          ((algebraMap R₁ F₁ q)⁻¹) • Ideal.Quotient.mk (Ideal.span {u₀_loc}) (ι_loc a) := by
        have hm_eq : ι_loc m.1 = algebraMap F₁ A₂_loc (algebraMap R₁ F₁ q) := by
          rw [← hmq, hφ_F₁_eq]; rfl
        have hzm_bar : (algebraMap R₁ F₁ q) • Ideal.Quotient.mk (Ideal.span {u₀_loc}) z =
            Ideal.Quotient.mk (Ideal.span {u₀_loc}) (ι_loc a) := by
          have hzm' : z * ι_loc m.1 = ι_loc a := hzm
          rw [← hzm', map_mul, hm_eq, mul_comm]; rfl
        rw [← hzm_bar, smul_smul, inv_mul_cancel₀ hq_ne, one_smul]
      rw [hz_eq, hmk_a, Finset.smul_sum]
      refine Submodule.sum_mem _ fun ν _ => ?_
      rw [smul_smul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨ν, rfl⟩)
    let B_Q : Module.Basis (Fin d_Z) F₁ Q_loc := Module.Basis.mk hw_li hw_sp
    have hRank_dZ : Module.finrank F₁ Q_loc = d_Z := by
      rw [Module.finrank_eq_card_basis B_Q, Fintype.card_fin]
    have hrZ_eq : r_Z = d_Z := hRank_rZ.symm.trans hRank_dZ
    let b_hat : Module.Basis (Fin d_Z) (Polynomial F₁) A₂_loc := b_loc.reindex (finCongr hrZ_eq)

    have hsurj_b : ∀ ν : Fin d_Z, ∃ p : A₂ × M₁, b_hat ν * ι_loc p.2.1 = ι_loc p.1 :=
      fun ν => IsLocalization.surj M₁ (b_hat ν)
    let e_pair : Fin d_Z → A₂ × M₁ := fun ν => Classical.choose (hsurj_b ν)
    let e_vec : Fin d_Z → A₂ := fun ν => (e_pair ν).1
    have he_spec : ∀ ν : Fin d_Z, b_hat ν * ι_loc (e_pair ν).2.1 = ι_loc (e_vec ν) :=
      fun ν => Classical.choose_spec (hsurj_b ν)
    have he_linIndep : ∀ P : Fin d_Z → R₂,
        (∑ ν : Fin d_Z, ev₀₁ (P ν) * e_vec ν) = 0 → ∀ ν : Fin d_Z, P ν = 0 := by
      intro P hPsum
      have hloc_sum : ∑ ν : Fin d_Z,
          ((P ν).map (algebraMap R₁ F₁) *
            Polynomial.C (algebraMap R₁ F₁ (Classical.choose (e_pair ν).2.2))) • b_hat ν = 0 := by
        have h0 : ι_loc (∑ ν : Fin d_Z, ev₀₁ (P ν) * e_vec ν) = 0 := by rw [hPsum, map_zero]
        rw [map_sum] at h0
        rw [← h0]
        refine Finset.sum_congr rfl fun ν _ => ?_
        let q_ν := Classical.choose (e_pair ν).2.2
        have hq_ν : ev₁ q_ν = (e_pair ν).2.1 := (Classical.choose_spec (e_pair ν).2.2).2
        change Polynomial.aeval u₀_loc
            ((P ν).map (algebraMap R₁ F₁) * Polynomial.C (algebraMap R₁ F₁ q_ν)) * b_hat ν =
          ι_loc (ev₀₁ (P ν) * e_vec ν)
        rw [map_mul, Polynomial.aeval_C, hφ_F₁_eq, hq_ν, hmap_aeval, map_mul, mul_assoc,
          mul_comm (ι_loc (e_pair ν).2.1) (b_hat ν), he_spec ν]
      have hcoeff0 := Fintype.linearIndependent_iff.mp b_hat.linearIndependent _ hloc_sum
      intro ν
      let q_ν := Classical.choose (e_pair ν).2.2
      have hq_mem : q_ν ∈ nonZeroDivisors R₁ := (Classical.choose_spec (e_pair ν).2.2).1
      have hC_ne : Polynomial.C (algebraMap R₁ F₁ q_ν) ≠ 0 := by
        rw [ne_eq, Polynomial.C_eq_zero]
        exact fun h0 => nonZeroDivisors.ne_zero hq_mem
          ((IsFractionRing.injective R₁ F₁) (h0.trans (map_zero _).symm))
      have hmap0 : (P ν).map (algebraMap R₁ F₁) = 0 :=
        (mul_eq_zero.mp (hcoeff0 ν)).resolve_right hC_ne
      exact Polynomial.map_injective _ (IsFractionRing.injective R₁ F₁)
        (hmap0.trans (Polynomial.map_zero _).symm)

    let m_pole : Fin d_Z → ℕ := fun ν => Classical.choose (hClear₀ (res₂ (e_vec ν)))
    let y_pole : Fin d_Z → A₀ :=
      fun ν => Classical.choose (Classical.choose_spec (hClear₀ (res₂ (e_vec ν))))
    have hy_pole : ∀ ν : Fin d_Z, res₀ S_Z ^ (m_pole ν) * res₂ (e_vec ν) = res₀ (y_pole ν) :=
      fun ν => Classical.choose_spec (Classical.choose_spec (hClear₀ (res₂ (e_vec ν))))
    let r₀ : ℕ := Finset.univ.sup m_pole
    let e_tilde : Fin d_Z → A₀ := fun ν => S_Z ^ (r₀ - m_pole ν) * y_pole ν
    have he_tilde : ∀ ν : Fin d_Z, res₀ S_Z ^ r₀ * res₂ (e_vec ν) = res₀ (e_tilde ν) := by
      intro ν
      have hle : m_pole ν ≤ r₀ := Finset.le_sup (Finset.mem_univ ν)
      have hsub : r₀ - m_pole ν + m_pole ν = r₀ := Nat.sub_add_cancel hle
      calc res₀ S_Z ^ r₀ * res₂ (e_vec ν)
        _ = res₀ S_Z ^ (r₀ - m_pole ν) * (res₀ S_Z ^ (m_pole ν) * res₂ (e_vec ν)) := by
            conv_lhs => rw [← hsub, pow_add]
            ring
        _ = res₀ S_Z ^ (r₀ - m_pole ν) * res₀ (y_pole ν) := by rw [hy_pole ν]
        _ = res₀ (e_tilde ν) := by dsimp [e_tilde]; rw [map_mul, map_pow]

    have hSimplex : ∀ D : ℕ, 2 * (∑ i ∈ Finset.range (D + 1), (D + 1 - i)) = (D + 2) * (D + 1) := by
      intro D
      induction D with
      | zero => simp
      | succ D ih =>
        rw [Finset.sum_range_succ']
        have hsub : ∑ k_idx ∈ Finset.range (D + 1), (D + 2 - (k_idx + 1)) =
            ∑ k_idx ∈ Finset.range (D + 1), (D + 1 - k_idx) :=
          Finset.sum_congr rfl fun k_idx _ => by omega
        rw [hsub, Nat.sub_zero]
        linarith

    refine ⟨r₀, fun K hK => ?_⟩
    let D := K - r₀
    let I_D := Σ i : Fin (D + 1), Fin (D + 1 - i.1)
    have hcard_ID : 2 * Fintype.card I_D = (D + 2) * (D + 1) := by
      have h1 : Fintype.card I_D = ∑ i ∈ Finset.range (D + 1), (D + 1 - i) := by
        simp only [I_D, Fintype.card_sigma, Fintype.card_fin, Fin.sum_univ_eq_sum_range]
      rw [h1, hSimplex D]
    let Φ_K : (Fin d_Z × I_D → k) →ₗ[k] A₂ :=
      { toFun := fun c => ∑ ν : Fin d_Z, ∑ p : I_D,
          c (ν, p) • (u₀ ^ p.1.1 * u₁ ^ p.2.1 * e_vec ν)
        map_add' := fun c₁ c₂ => by
          simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
        map_smul' := fun α c => by
          simp only [Pi.smul_apply, smul_eq_mul, ← smul_smul, ← Finset.smul_sum, RingHom.id_apply] }
    have hΦK_inj : Function.Injective Φ_K := by
      rw [injective_iff_map_eq_zero]
      intro c hc
      let P_c : Fin d_Z → R₂ := fun ν =>
        ∑ p : I_D, Polynomial.monomial p.1.1 (Polynomial.monomial p.2.1 (c (ν, p)))
      have hΦ_eq : Φ_K c = ∑ ν : Fin d_Z, ev₀₁ (P_c ν) * e_vec ν := by
        dsimp [Φ_K, P_c]
        refine Finset.sum_congr rfl fun ν _ => ?_
        rw [map_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl fun p _ => ?_
        have hmon : ev₀₁ (Polynomial.monomial p.1.1 (Polynomial.monomial p.2.1 (c (ν, p)))) =
            c (ν, p) • (u₀ ^ p.1.1 * u₁ ^ p.2.1) := by
          change Polynomial.eval₂ ev₁.toRingHom u₀
              (Polynomial.monomial p.1.1 (Polynomial.monomial p.2.1 (c (ν, p)))) = _
          rw [Polynomial.eval₂_monomial]
          change ev₁ (Polynomial.monomial p.2.1 (c (ν, p))) * u₀ ^ p.1.1 = _
          rw [Polynomial.aeval_monomial, Algebra.smul_def]
          ring
        rw [hmon, smul_mul_assoc]
      rw [hΦ_eq] at hc
      have hP0 := he_linIndep P_c hc
      ext ⟨ν, p⟩
      have hcoeff1 := congrArg (fun Q => (Q.coeff p.1.1).coeff p.2.1) (hP0 ν)
      simp only [Polynomial.coeff_zero] at hcoeff1
      dsimp [P_c] at hcoeff1
      rw [Polynomial.finsetSum_coeff, Polynomial.finsetSum_coeff] at hcoeff1
      rw [Finset.sum_eq_single p] at hcoeff1
      · simpa [Polynomial.coeff_monomial] using hcoeff1
      · intro q _ hqp
        by_cases hi : p.1 = q.1
        · cases p with | mk pi pj => cases q with | mk qi qj =>
          dsimp at hi; subst hi
          have hj_ne : pj.1 ≠ qj.1 :=
            fun hjeq => hqp (Sigma.ext rfl (heq_of_eq (Fin.ext hjeq.symm)))
          simp [Polynomial.coeff_monomial, Ne.symm hj_ne]
        · have hi_ne : p.1.1 ≠ q.1.1 := fun hieq => hi (Fin.ext hieq)
          simp [Polynomial.coeff_monomial, Ne.symm hi_ne]
      · intro hmem; exact False.elim (hmem (Finset.mem_univ p))
    let W_K : Submodule k A₂ := LinearMap.range Φ_K
    haveI : Module.Finite k W_K := Module.Finite.range Φ_K
    have hdim_WK : 2 * Module.finrank k W_K = d_Z * (K - r₀ + 2) * (K - r₀ + 1) := by
      rw [LinearMap.finrank_range_of_inj hΦK_inj, Module.finrank_fintype_fun_eq_card,
        Fintype.card_prod, Fintype.card_fin]
      calc 2 * (d_Z * Fintype.card I_D) = d_Z * (2 * Fintype.card I_D) := by ring
        _ = d_Z * ((D + 2) * (D + 1)) := by rw [hcard_ID]
        _ = d_Z * (K - r₀ + 2) * (K - r₀ + 1) := by dsimp [D]; ring
    refine ⟨W_K, inferInstance, hdim_WK, ?_⟩
    rintro g ⟨c, rfl⟩
    let g₀_term : Fin d_Z → I_D → A₀ := fun ν p =>
      c (ν, p) • (v₁ ^ p.2.1 * S_Z ^ (K - r₀ - p.1.1 - p.2.1) * e_tilde ν)
    refine ⟨∑ ν : Fin d_Z, ∑ p : I_D, g₀_term ν p, ?_⟩
    dsimp [Φ_K, g₀_term]
    rw [map_sum, Finset.mul_sum, map_sum]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [map_sum, Finset.mul_sum, map_sum]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [map_smul, map_smul, mul_smul_comm]
    congr 1
    have hp_le : p.1.1 + p.2.1 ≤ K - r₀ := by
      have := p.2.2; dsimp [D] at this; omega
    have hexp : K = p.1.1 + p.2.1 + (K - r₀ - p.1.1 - p.2.1) + r₀ := by omega
    calc res₀ S_Z ^ K * res₂ (u₀ ^ p.1.1 * u₁ ^ p.2.1 * e_vec ν)
      _ = (res₀ S_Z * res₂ u₀) ^ p.1.1 * (res₀ S_Z * res₂ u₁) ^ p.2.1 *
            res₀ S_Z ^ (K - r₀ - p.1.1 - p.2.1) * (res₀ S_Z ^ r₀ * res₂ (e_vec ν)) := by
          conv_lhs => rw [hexp]
          simp only [pow_add, map_mul, map_pow]; ring
      _ = 1 ^ p.1.1 * (res₀ v₁) ^ p.2.1 * res₀ S_Z ^ (K - r₀ - p.1.1 - p.2.1) *
            res₀ (e_tilde ν) := by rw [hSu₀, hSu₁, he_tilde ν]
      _ = res₀ (v₁ ^ p.2.1 * S_Z ^ (K - r₀ - p.1.1 - p.2.1) * e_tilde ν) := by
          simp only [one_pow, one_mul, map_mul, map_pow]

  
  
  
  have hBranchContradiction : ∀ (P : Ideal A₂) [P.IsPrime] (Q : Ideal A₀) [Q.IsPrime]
      (a d_Z r₀ : ℕ),
      τ₂ ∈ P → P ≤ p_z₀ → S_Z ∉ Q →
      Ideal.map res₂.toRingHom P = Ideal.map res₀.toRingHom Q →
      Nontrivial (A₂ ⧸ (P ⊔ Ideal.span {u₀})) →
      1 ≤ a → 2 * a ≤ 3 * d_Z →
      (letI : Algebra (Polynomial k) (A₂ ⧸ P) :=
        (Polynomial.aeval (Ideal.Quotient.mk P u₀)).toRingHom.toAlgebra
       Nonempty (Module.Basis (Fin a) (Polynomial k) (A₂ ⧸ P))) →
      (letI : Algebra (Polynomial k) (A₀ ⧸ Q) :=
        (Polynomial.aeval (Ideal.Quotient.mk Q S_Z)).toRingHom.toAlgebra
       Module.Finite (Polynomial k) (A₀ ⧸ Q)) →
      (∀ (q : Ideal A₂) [q.IsPrime], q ≠ p_z₀ → P ≤ q →
        Ideal.map (algebraMap A₂ (Localization.AtPrime q)) P =
          Ideal.span {algebraMap A₂ (Localization.AtPrime q) τ₂}) →
      (∀ (q : Ideal A₀) [q.IsPrime], S_Z ∈ q → Q ≤ q →
        Ideal.map (algebraMap A₀ (Localization.AtPrime q)) Q =
          Ideal.span {algebraMap A₀ (Localization.AtPrime q) τ₀}) →
      (∀ (s g c : A₂) (j : ℕ), s ∉ P → s * g = τ₂ ^ j * c →
        ∃ (d r : A₂), d ∉ p_z₀ ∧ d * (u₀ - algebraMap k A₂ t₀) ^ j * c - s * r ∈ P) →
      (∀ K : ℕ, r₀ ≤ K →
        ∃ W_K : Submodule k A₂,
          Module.Finite k W_K ∧
          2 * Module.finrank k W_K = d_Z * (K - r₀ + 2) * (K - r₀ + 1) ∧
          ∀ g ∈ W_K, ∃ g₀ : A₀, res₀ S_Z ^ K * res₂ g = res₀ g₀) →
      False := by
    intro P _ Q _ a d_Z r₀ hτ₂_P hP_le_pz hSZ_Q hMapPQ hNontrivP ha_pos ha_le
      hb_B0 hFin_Binf hLoc₂ hLoc₀ hNode hWK_fam
    have hPrimeDiv : ∀ {R : Type u} [CommRing R] [IsDomain R] (π : R),
        π ≠ 0 → (Ideal.span {π}).IsPrime →
        ∀ (j : ℕ) (s x y : R), s ∉ Ideal.span {π} → s * x = π ^ j * y →
          ∃ q : R, x = π ^ j * q ∧ s * q = y := by
      intro R _ _ π hπ0 hπ_pr j
      induction j with
      | zero =>
        intro s x y _ hxy
        rw [pow_zero, one_mul] at hxy
        exact ⟨x, by rw [pow_zero, one_mul], hxy⟩
      | succ j ih =>
        intro s x y hs hxy
        have hmem : s * x ∈ Ideal.span {π} := by
          rw [hxy, pow_succ', mul_assoc]
          exact Ideal.mem_span_singleton.mpr ⟨_, rfl⟩
        have hx_mem : x ∈ Ideal.span {π} := (hπ_pr.mem_or_mem hmem).resolve_left hs
        obtain ⟨x₁, rfl⟩ := Ideal.mem_span_singleton.mp hx_mem
        have hsx₁ : s * x₁ = π ^ j * y := by
          apply mul_left_cancel₀ hπ0
          calc π * (s * x₁) = s * (π * x₁) := by ring
            _ = π ^ (j + 1) * y := hxy
            _ = π * (π ^ j * y) := by rw [pow_succ']; ring
        obtain ⟨q, hq₁, hsq⟩ := ih s x₁ y hs hsx₁
        exact ⟨q, by rw [hq₁, pow_succ']; ring, hsq⟩

    have hLocalDiv : ∀ {R : Type u} [CommRing R] [IsDomain R] (π : R),
        π ≠ 0 → ∀ (𝔭 q : Ideal R) [𝔭.IsPrime] [q.IsPrime], 𝔭 ≤ q →
        Ideal.map (algebraMap R (Localization.AtPrime q)) 𝔭 =
          Ideal.span {algebraMap R (Localization.AtPrime q) π} →
        ∀ (j : ℕ) (s g c : R), s ∉ 𝔭 → s * g = π ^ j * c →
          ∃ (d r : R), d ∉ q ∧ d * c = s * r := by
      intro R _ _ π hπ0 𝔭 q _ _ h𝔭q hGen j s g c hs hsg
      let R_q := Localization.AtPrime q
      haveI : IsDomain R_q := IsLocalization.isDomain_localization q.primeCompl_le_nonZeroDivisors
      have hinj_q : Function.Injective (algebraMap R R_q) :=
        IsLocalization.injective R_q q.primeCompl_le_nonZeroDivisors
      have hDisj : Disjoint (q.primeCompl : Set R) (𝔭 : Set R) :=
        Set.disjoint_left.mpr fun x hxq hx𝔭 => hxq (h𝔭q hx𝔭)
      have hPrime_sp : (Ideal.span {algebraMap R R_q π}).IsPrime :=
        hGen ▸ IsLocalization.isPrime_of_isPrime_disjoint q.primeCompl R_q 𝔭 ‹𝔭.IsPrime› hDisj
      have hs_not_sp : algebraMap R R_q s ∉ Ideal.span {algebraMap R R_q π} := by
        intro hmem
        rw [← hGen] at hmem
        have hs_u : s ∈ Ideal.under R (Ideal.map (algebraMap R R_q) 𝔭) := hmem
        rw [IsLocalization.under_map_of_isPrime_disjoint q.primeCompl R_q ‹𝔭.IsPrime› hDisj] at hs_u
        exact hs hs_u
      have hπ_loc_ne : algebraMap R R_q π ≠ 0 :=
        fun h0 => hπ0 (hinj_q (h0.trans (map_zero _).symm))
      have hsg_loc : algebraMap R R_q s * algebraMap R R_q g =
          (algebraMap R R_q π) ^ j * algebraMap R R_q c := by
        simpa only [map_mul, map_pow] using congrArg (algebraMap R R_q) hsg
      obtain ⟨q_loc, _, hsq_loc⟩ :=
        hPrimeDiv (algebraMap R R_q π) hπ_loc_ne hPrime_sp j _ _ _ hs_not_sp hsg_loc
      obtain ⟨⟨r, d⟩, hrd⟩ := IsLocalization.surj q.primeCompl q_loc
      refine ⟨d.1, r, d.2, hinj_q ?_⟩
      calc algebraMap R R_q (d.1 * c)
        _ = algebraMap R R_q d.1 * (algebraMap R R_q s * q_loc) := by rw [map_mul, ← hsq_loc]
        _ = algebraMap R R_q s * (q_loc * algebraMap R R_q d.1) := by ring
        _ = algebraMap R R_q (s * r) := by rw [hrd, map_mul]

    have hContract : ∀ {R : Type u} [CommRing R] (f : R →+* A₀₂) (u : R) (𝔭 : Ideal R) [𝔭.IsPrime],
        Function.Injective f → u ∉ 𝔭 →
        (∀ z : A₀₂, ∃ (m : ℕ) (x : R), f u ^ m * z = f x) →
        Ideal.comap f (Ideal.map f 𝔭) = 𝔭 := by
      intro R _ f u 𝔭 _ hinj_f hu_𝔭 hCl
      apply le_antisymm _ Ideal.le_comap_map
      intro a₀ ha₀
      have hspan_clear : ∀ w ∈ Ideal.map f 𝔭, ∃ (M : ℕ) (p : R), p ∈ 𝔭 ∧ f u ^ M * w = f p := by
        intro w hw
        refine Submodule.span_induction
          (p := fun w _ => ∃ (M : ℕ) (p : R), p ∈ 𝔭 ∧ f u ^ M * w = f p)
          (mem := ?_) (zero := ?_) (add := ?_) (smul := ?_) hw
        · rintro _ ⟨p, hp, rfl⟩
          exact ⟨0, p, hp, by rw [pow_zero, one_mul]⟩
        · exact ⟨0, 0, 𝔭.zero_mem, by rw [mul_zero, map_zero]⟩
        · rintro w₁ w₂ _ _ ⟨M₁, p₁, hp₁, hw₁⟩ ⟨M₂, p₂, hp₂, hw₂⟩
          refine ⟨M₁ + M₂, u ^ M₂ * p₁ + u ^ M₁ * p₂,
            𝔭.add_mem (𝔭.mul_mem_left _ hp₁) (𝔭.mul_mem_left _ hp₂), ?_⟩
          calc f u ^ (M₁ + M₂) * (w₁ + w₂)
            _ = f u ^ M₂ * (f u ^ M₁ * w₁) + f u ^ M₁ * (f u ^ M₂ * w₂) := by rw [pow_add]; ring
            _ = f (u ^ M₂ * p₁ + u ^ M₁ * p₂) := by rw [hw₁, hw₂]; simp [map_add, map_mul, map_pow]
        · rintro z w _ ⟨M, p, hp, hw_eq⟩
          obtain ⟨m, x, hzx⟩ := hCl z
          refine ⟨m + M, x * p, 𝔭.mul_mem_left x hp, ?_⟩
          calc f u ^ (m + M) * (z • w)
            _ = (f u ^ m * z) * (f u ^ M * w) := by rw [pow_add, smul_eq_mul]; ring
            _ = f (x * p) := by rw [hzx, hw_eq, map_mul]
      obtain ⟨M, p, hp, hap⟩ := hspan_clear (f a₀) ha₀
      have huMa : u ^ M * a₀ = p := hinj_f (by rw [map_mul, map_pow, hap])
      have huM_not : u ^ M ∉ 𝔭 := fun h => hu_𝔭 (‹𝔭.IsPrime›.mem_of_pow_mem M h)
      exact (‹𝔭.IsPrime›.mem_or_mem (huMa.symm ▸ hp)).resolve_left huM_not

    have hu₀_P : u₀ ∉ P := fun h => hu₀_pz (hP_le_pz h)
    let I₀₂ : Ideal A₀₂ := Ideal.map res₂.toRingHom P
    have hComap₂ : Ideal.comap res₂.toRingHom I₀₂ = P :=
      hContract res₂.toRingHom u₀ P hinj₂ hu₀_P hClear₂
    have hComap₀ : Ideal.comap res₀.toRingHom I₀₂ = Q := by
      change Ideal.comap res₀.toRingHom (Ideal.map res₂.toRingHom P) = Q
      rw [hMapPQ]
      exact hContract res₀.toRingHom S_Z Q hinj₀ hSZ_Q hClear₀
    haveI : I₀₂.IsPrime := by
      rw [Ideal.isPrime_iff]
      refine ⟨?_, ?_⟩
      · intro htop
        have h1 : (1 : A₂) ∈ Ideal.comap res₂.toRingHom I₀₂ := by
          change res₂ 1 ∈ I₀₂; rw [map_one, htop]; trivial
        rw [hComap₂] at h1
        exact ‹P.IsPrime›.ne_top (Ideal.eq_top_of_isUnit_mem P h1 isUnit_one)
      · intro z₁ z₂ hz12
        obtain ⟨m₁, x₁, hz₁⟩ := hClear₂ z₁
        obtain ⟨m₂, x₂, hz₂⟩ := hClear₂ z₂
        have hx12_I : res₂ (x₁ * x₂) ∈ I₀₂ := by
          have h : res₂ (x₁ * x₂) = res₂ u₀ ^ (m₁ + m₂) * (z₁ * z₂) := by
            rw [map_mul, ← hz₁, ← hz₂, pow_add]; ring
          rw [h]; exact I₀₂.mul_mem_left _ hz12
        have hx12_P : x₁ * x₂ ∈ P := by rwa [← hComap₂]
        rcases ‹P.IsPrime›.mem_or_mem hx12_P with hx₁ | hx₂
        · left
          have hz₁_eq : z₁ = res₀ S_Z ^ m₁ * res₂ x₁ := by
            calc z₁ = (res₀ S_Z * res₂ u₀) ^ m₁ * z₁ := by rw [hSu₀, one_pow, one_mul]
              _ = res₀ S_Z ^ m₁ * (res₂ u₀ ^ m₁ * z₁) := by rw [mul_pow]; ring
              _ = res₀ S_Z ^ m₁ * res₂ x₁ := by rw [hz₁]
          rw [hz₁_eq]; exact I₀₂.mul_mem_left _ (Ideal.mem_map_of_mem _ hx₁)
        · right
          have hz₂_eq : z₂ = res₀ S_Z ^ m₂ * res₂ x₂ := by
            calc z₂ = (res₀ S_Z * res₂ u₀) ^ m₂ * z₂ := by rw [hSu₀, one_pow, one_mul]
              _ = res₀ S_Z ^ m₂ * (res₂ u₀ ^ m₂ * z₂) := by rw [mul_pow]; ring
              _ = res₀ S_Z ^ m₂ * res₂ x₂ := by rw [hz₂]
          rw [hz₂_eq]; exact I₀₂.mul_mem_left _ (Ideal.mem_map_of_mem _ hx₂)

    let B₀ := A₂ ⧸ P
    let B_inf := A₀ ⧸ Q
    let B_ov := A₀₂ ⧸ I₀₂
    haveI : IsDomain B₀ := Ideal.Quotient.isDomain P
    haveI : IsDomain B_inf := Ideal.Quotient.isDomain Q
    haveI : IsDomain B_ov := Ideal.Quotient.isDomain I₀₂
    let T : B₀ := Ideal.Quotient.mk P u₀
    let S : B_inf := Ideal.Quotient.mk Q S_Z
    have hS_ne : S ≠ 0 := fun h0 => hSZ_Q (Ideal.Quotient.eq_zero_iff_mem.mp h0)
    let ι_B0 : B₀ →ₐ[k] B_ov :=
      Ideal.Quotient.liftₐ P ((Ideal.Quotient.mkₐ k I₀₂).comp res₂) fun a₀ ha₀ =>
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha₀)
    let ι_Binf : B_inf →ₐ[k] B_ov :=
      Ideal.Quotient.liftₐ Q ((Ideal.Quotient.mkₐ k I₀₂).comp res₀) fun b hb => by
        apply Ideal.Quotient.eq_zero_iff_mem.mpr
        change res₀ b ∈ Ideal.map res₂.toRingHom P
        rw [hMapPQ]; exact Ideal.mem_map_of_mem _ hb
    have hinj_B0 : Function.Injective ι_B0 := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
      have hmem : res₂ x ∈ I₀₂ := Ideal.Quotient.eq_zero_iff_mem.mp hz
      have hxP : x ∈ P := by rwa [← hComap₂]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hxP
    have hinj_Binf : Function.Injective ι_Binf := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      have hmem : res₀ y ∈ I₀₂ := Ideal.Quotient.eq_zero_iff_mem.mp hz
      have hyQ : y ∈ Q := by rwa [← hComap₀]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hyQ
    have hST_ov : ι_Binf S * ι_B0 T = 1 := by
      change Ideal.Quotient.mk I₀₂ (res₀ S_Z) * Ideal.Quotient.mk I₀₂ (res₂ u₀) = 1
      rw [← map_mul, hSu₀, map_one]

    let algB0 : Algebra (Polynomial k) B₀ := (Polynomial.aeval T).toRingHom.toAlgebra
    let algBinf : Algebra (Polynomial k) B_inf := (Polynomial.aeval S).toRingHom.toAlgebra
    obtain ⟨v⟩ := hb_B0
    have hsmul_B0 : ∀ (R : Polynomial k) (z : B₀),
        @HSMul.hSMul _ _ _ (@instHSMul _ _ algB0.toModule.toSMul) R z = Polynomial.aeval T R * z :=
      fun _ _ => rfl
    obtain ⟨s_inf, hs_inf⟩ := by
      letI : Algebra (Polynomial k) B_inf := algBinf
      haveI : Module.Finite (Polynomial k) B_inf := hFin_Binf
      exact Module.Finite.fg_top (R := Polynomial k) (M := B_inf)
    let m_inf_fn : B_inf → ℕ := fun w => Classical.choose (hClear₂ (res₀ (Quotient.out w)))
    let x_inf_fn : B_inf → A₂ :=
      fun w => Classical.choose (Classical.choose_spec (hClear₂ (res₀ (Quotient.out w))))
    have hx_inf_spec : ∀ w : B_inf,
        res₂ u₀ ^ (m_inf_fn w) * res₀ (Quotient.out w) = res₂ (x_inf_fn w) :=
      fun w => Classical.choose_spec (Classical.choose_spec (hClear₂ (res₀ (Quotient.out w))))
    let M_inf : ℕ := s_inf.sup m_inf_fn
    let x_hat : B_inf → B₀ :=
      fun w => T ^ (M_inf - m_inf_fn w) * Ideal.Quotient.mk P (x_inf_fn w)
    have hx_hat_ov : ∀ w ∈ s_inf, ι_B0 (T ^ M_inf) * ι_Binf w = ι_B0 (x_hat w) := by
      intro w hw
      have hle : m_inf_fn w ≤ M_inf := Finset.le_sup hw
      have hsub : M_inf - m_inf_fn w + m_inf_fn w = M_inf := Nat.sub_add_cancel hle
      have hw_out : Ideal.Quotient.mk Q (Quotient.out w) = w := Quotient.out_eq w
      conv_lhs => rw [← hw_out, ← hsub, pow_add, map_mul, mul_assoc]
      have h1 : ι_B0 (T ^ m_inf_fn w) * ι_Binf (Ideal.Quotient.mk Q (Quotient.out w)) =
          ι_B0 (Ideal.Quotient.mk P (x_inf_fn w)) := by
        change Ideal.Quotient.mk I₀₂ (res₂ (u₀ ^ m_inf_fn w)) *
            Ideal.Quotient.mk I₀₂ (res₀ (Quotient.out w)) =
          Ideal.Quotient.mk I₀₂ (res₂ (x_inf_fn w))
        rw [← map_mul, map_pow, hx_inf_spec w]
      rw [h1, ← map_mul]
    let deg_hat : B_inf → ℕ := fun w => Finset.univ.sup fun μ : Fin a =>
      ((v.repr (x_hat w)) μ).natDegree
    let C₀ : ℕ := s_inf.sup deg_hat

    have hBinf_deg : ∀ y : B_inf, ∃ (N_R : ℕ) (z_B : B₀),
        ι_B0 (T ^ (N_R + M_inf)) * ι_Binf y = ι_B0 z_B ∧
        ∀ μ : Fin a, ((v.repr z_B) μ).natDegree ≤ N_R + C₀ := by
      let P_deg : B_inf → Prop := fun y => ∃ (N_R : ℕ) (z_B : B₀),
        ι_B0 (T ^ (N_R + M_inf)) * ι_Binf y = ι_B0 z_B ∧
        ∀ μ : Fin a, ((v.repr z_B) μ).natDegree ≤ N_R + C₀
      have hP_zero : P_deg 0 := ⟨0, 0, by simp, fun μ => by simp⟩
      have hP_add : ∀ {y₁ y₂ : B_inf}, P_deg y₁ → P_deg y₂ → P_deg (y₁ + y₂) := by
        rintro y₁ y₂ ⟨N₁, z₁, heq₁, hdeg₁⟩ ⟨N₂, z₂, heq₂, hdeg₂⟩
        letI : Algebra (Polynomial k) B₀ := algB0
        let z_B : B₀ := (Polynomial.X ^ N₂ : Polynomial k) • z₁ +
          (Polynomial.X ^ N₁ : Polynomial k) • z₂
        refine ⟨N₁ + N₂, z_B, ?_, fun μ => ?_⟩
        · have hz_val : z_B = T ^ N₂ * z₁ + T ^ N₁ * z₂ := by
            change Polynomial.aeval T (Polynomial.X ^ N₂) * z₁ +
              Polynomial.aeval T (Polynomial.X ^ N₁) * z₂ = _
            simp [map_pow]
          rw [hz_val]
          calc ι_B0 (T ^ (N₁ + N₂ + M_inf)) * ι_Binf (y₁ + y₂)
            _ = ι_B0 (T ^ N₂) * (ι_B0 (T ^ (N₁ + M_inf)) * ι_Binf y₁) +
                  ι_B0 (T ^ N₁) * (ι_B0 (T ^ (N₂ + M_inf)) * ι_Binf y₂) := by
                simp only [pow_add, map_add, map_mul, map_pow]; ring
            _ = ι_B0 (T ^ N₂ * z₁ + T ^ N₁ * z₂) := by rw [heq₁, heq₂]; simp [map_add, map_mul]
        · dsimp [z_B]
          rw [map_add, map_smul, map_smul, Finsupp.add_apply, Finsupp.smul_apply, Finsupp.smul_apply,
            smul_eq_mul, smul_eq_mul]
          calc (Polynomial.X ^ N₂ * v.repr z₁ μ + Polynomial.X ^ N₁ * v.repr z₂ μ).natDegree
            _ ≤ max (Polynomial.X ^ N₂ * v.repr z₁ μ).natDegree
                  (Polynomial.X ^ N₁ * v.repr z₂ μ).natDegree := Polynomial.natDegree_add_le _ _
            _ ≤ max ((Polynomial.X ^ N₂ : Polynomial k).natDegree + (v.repr z₁ μ).natDegree)
                  ((Polynomial.X ^ N₁ : Polynomial k).natDegree + (v.repr z₂ μ).natDegree) :=
                max_le_max Polynomial.natDegree_mul_le Polynomial.natDegree_mul_le
            _ ≤ N₁ + N₂ + C₀ := by
                rw [Polynomial.natDegree_X_pow, Polynomial.natDegree_X_pow]
                have h1 := hdeg₁ μ; have h2 := hdeg₂ μ; omega
      have hP_sum : ∀ (m : ℕ) (f : ℕ → B_inf), (∀ d ∈ Finset.range m, P_deg (f d)) →
          P_deg (∑ d ∈ Finset.range m, f d) := by
        intro m f hf
        induction m with
        | zero => simpa using hP_zero
        | succ m ih =>
          rw [Finset.sum_range_succ]
          exact hP_add (ih fun d hd => hf d (Finset.mem_range_succ_iff.mpr (Nat.le_of_lt (Finset.mem_range.mp hd))))
            (hf m (Finset.mem_range.mpr (Nat.lt_succ_self m)))
      intro y
      letI : Algebra (Polynomial k) B_inf := algBinf
      have hy_top : y ∈ Submodule.span (Polynomial k) (s_inf : Set B_inf) := by rw [hs_inf]; trivial
      refine Submodule.span_induction (p := fun y _ => P_deg y)
        (mem := ?_) (zero := hP_zero)
        (add := fun _ _ _ _ h₁ h₂ => hP_add h₁ h₂) (smul := ?_) hy_top
      · intro w hw
        refine ⟨0, x_hat w, by rw [zero_add]; exact hx_hat_ov w hw, fun μ => ?_⟩
        rw [zero_add]
        have h1 : ((v.repr (x_hat w)) μ).natDegree ≤ deg_hat w :=
          Finset.le_sup (f := fun μ : Fin a => ((v.repr (x_hat w)) μ).natDegree) (Finset.mem_univ μ)
        exact h1.trans (Finset.le_sup (f := deg_hat) hw)
      · rintro R y₀ _ ⟨N₁, z₁, heq₁, hdeg₁⟩
        have hR_sum : R • y₀ = ∑ d ∈ Finset.range (R.natDegree + 1),
            (Polynomial.C (R.coeff d) * Polynomial.X ^ d) • y₀ := by
          rw [← Finset.sum_smul, ← Polynomial.as_sum_range_C_mul_X_pow R]
        rw [hR_sum]
        refine hP_sum (R.natDegree + 1) _ fun d _ => ?_
        letI : Algebra (Polynomial k) B₀ := algB0
        let z_d : B₀ := (Polynomial.C (R.coeff d) : Polynomial k) • z₁
        refine ⟨d + N₁, z_d, ?_, fun μ => ?_⟩
        · have hsmul_d : (Polynomial.C (R.coeff d) * Polynomial.X ^ d) • y₀ =
              algebraMap k B_inf (R.coeff d) * S ^ d * y₀ := by
            change Polynomial.aeval S (Polynomial.C (R.coeff d) * Polynomial.X ^ d) * y₀ = _
            simp [map_mul, map_pow]
          have hzd_val : z_d = algebraMap k B₀ (R.coeff d) * z₁ := by
            change Polynomial.aeval T (Polynomial.C (R.coeff d)) * z₁ = _
            simp
          rw [hsmul_d, hzd_val]
          calc ι_B0 (T ^ (d + N₁ + M_inf)) * ι_Binf (algebraMap k B_inf (R.coeff d) * S ^ d * y₀)
            _ = algebraMap k B_ov (R.coeff d) * (ι_Binf S * ι_B0 T) ^ d *
                  (ι_B0 (T ^ (N₁ + M_inf)) * ι_Binf y₀) := by
                simp only [pow_add, map_mul, map_pow, AlgHom.commutes]; ring
            _ = ι_B0 (algebraMap k B₀ (R.coeff d) * z₁) := by
                rw [hST_ov, one_pow, mul_one, heq₁, map_mul, AlgHom.commutes]
        · dsimp [z_d]
          rw [map_smul, Finsupp.smul_apply, smul_eq_mul]
          exact (Polynomial.natDegree_C_mul_le (R.coeff d) (v.repr z₁ μ)).trans
            ((hdeg₁ μ).trans (by omega))

    have hP_ne_pz : P ≠ p_z₀ := by
      intro heq; subst heq
      have hsup_top : P ⊔ Ideal.span {u₀} = ⊤ := by
        by_contra hne
        have heq_sup := ‹P.IsMaximal›.eq_of_le hne le_sup_left
        have hu₀_mem : u₀ ∈ P :=
          heq_sup.symm ▸ Submodule.mem_sup_right (Ideal.mem_span_singleton_self u₀)
        exact hu₀_pz hu₀_mem
      haveI : Subsingleton (A₂ ⧸ (P ⊔ Ideal.span {u₀})) :=
        Ideal.Quotient.subsingleton_iff.mpr hsup_top
      exact not_subsingleton (A₂ ⧸ (P ⊔ Ideal.span {u₀})) inferInstance

    let R_P := Localization.AtPrime P
    haveI : IsDomain R_P := IsLocalization.isDomain_localization P.primeCompl_le_nonZeroDivisors
    haveI : IsNoetherianRing R_P :=
      IsLocalization.isNoetherianRing P.primeCompl R_P ‹IsNoetherianRing A₂›
    have hinj_P : Function.Injective (algebraMap A₂ R_P) :=
      IsLocalization.injective R_P P.primeCompl_le_nonZeroDivisors
    have hMax_RP : IsLocalRing.maximalIdeal R_P = Ideal.span {algebraMap A₂ R_P τ₂} := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P R_P]
      exact hLoc₂ P hP_ne_pz le_rfl

    haveI : Nontrivial B₀ := by
      letI : Algebra (Polynomial k) B₀ := algB0
      exact ⟨⟨v ⟨0, by omega⟩, 0, v.ne_zero ⟨0, by omega⟩⟩⟩
    let u_sh : B₀ := T - algebraMap k B₀ t₀
    have hu_sh_ne : u_sh ≠ 0 := by
      letI : Algebra (Polynomial k) B₀ := algB0
      haveI : Module.IsTorsionFree (Polynomial k) B₀ := v.isTorsionFree
      intro h0
      have hsmul0 : (Polynomial.X - Polynomial.C t₀ : Polynomial k) • (1 : B₀) = 0 := by
        change Polynomial.aeval T (Polynomial.X - Polynomial.C t₀) * 1 = 0
        simpa [u_sh] using h0
      rcases smul_eq_zero.mp hsmul0 with hpoly | h1
      · exact (Polynomial.monic_X_sub_C t₀).ne_zero hpoly
      · exact zero_ne_one h1.symm

    have hBound : ∀ (K : ℕ) (W : Submodule k A₂), Module.Finite k W →
        (∀ g ∈ W, ∃ g₀ : A₀, res₀ S_Z ^ K * res₂ g = res₀ g₀) →
        Module.finrank k W ≤ ∑ j ∈ Finset.range ((K + C₀) / 2 + 1), a * (K + C₀ - 2 * j + 1) := by
      intro K W hFinW hW_pole
      haveI : Module.Finite k W := hFinW
      let W_sub : ℕ → Submodule k A₂ := fun j =>
        { carrier := { g : A₂ | g ∈ W ∧ ∃ s : A₂, s ∉ P ∧ ∃ c : A₂, s * g = τ₂ ^ j * c }
          add_mem' := fun {g₁ g₂} ⟨hg₁, s₁, hs₁, c₁, hc₁⟩ ⟨hg₂, s₂, hs₂, c₂, hc₂⟩ =>
            ⟨W.add_mem hg₁ hg₂, s₁ * s₂, fun h => (‹P.IsPrime›.mem_or_mem h).elim hs₁ hs₂,
              s₂ * c₁ + s₁ * c₂, by
                calc (s₁ * s₂) * (g₁ + g₂)
                  _ = s₂ * (s₁ * g₁) + s₁ * (s₂ * g₂) := by ring
                  _ = τ₂ ^ j * (s₂ * c₁ + s₁ * c₂) := by rw [hc₁, hc₂]; ring⟩
          zero_mem' := ⟨W.zero_mem, 1, ‹P.IsPrime›.one_notMem, 0, by simp⟩
          smul_mem' := fun α {g} ⟨hg, s, hs, c, hc⟩ =>
            ⟨W.smul_mem α hg, s, hs, α • c, by
              change s * (α • g) = τ₂ ^ j * (α • c)
              rw [Algebra.smul_def, Algebra.smul_def]
              calc s * (algebraMap k A₂ α * g) = algebraMap k A₂ α * (s * g) := by ring
                _ = algebraMap k A₂ α * (τ₂ ^ j * c) := by rw [hc]
                _ = τ₂ ^ j * (algebraMap k A₂ α * c) := by ring⟩ }
      have hW_le : ∀ j : ℕ, W_sub j ≤ W := fun _ _ hx => hx.1
      have hW0_eq : W_sub 0 = W := by
        ext g
        exact ⟨fun h => h.1, fun hg => ⟨hg, 1, ‹P.IsPrime›.one_notMem, g, by simp⟩⟩
      have hW_anti : ∀ j : ℕ, W_sub (j + 1) ≤ W_sub j := by
        rintro j g ⟨hg, s, hs, c, hc⟩
        exact ⟨hg, s, hs, τ₂ * c, by rw [hc, pow_succ']; ring⟩
      have hW_krull : ∀ g : A₂, (∀ j : ℕ, g ∈ W_sub j) → g = 0 := by
        intro g hall
        apply hinj_P; rw [map_zero]
        have hmem_iInf : algebraMap A₂ R_P g ∈ ⨅ j : ℕ, (IsLocalRing.maximalIdeal R_P) ^ j := by
          rw [Ideal.mem_iInf]; intro j
          obtain ⟨_, s, hs, c, hsc⟩ := hall j
          have hu_s : IsUnit (algebraMap A₂ R_P s) :=
            (IsLocalization.AtPrime.isUnit_to_map_iff R_P P s).mpr hs
          have hx_loc : algebraMap A₂ R_P g =
              (algebraMap A₂ R_P τ₂) ^ j * (algebraMap A₂ R_P c * ↑(hu_s.unit⁻¹)) := by
            apply hu_s.mul_left_cancel
            calc algebraMap A₂ R_P s * algebraMap A₂ R_P g
              _ = algebraMap A₂ R_P (s * g) := (map_mul _ _ _).symm
              _ = algebraMap A₂ R_P (τ₂ ^ j * c) := by rw [hsc]
              _ = (algebraMap A₂ R_P τ₂) ^ j * algebraMap A₂ R_P c * 1 := by
                  rw [map_mul, map_pow, mul_one]
              _ = (algebraMap A₂ R_P τ₂) ^ j * algebraMap A₂ R_P c *
                    (algebraMap A₂ R_P s * ↑(hu_s.unit⁻¹)) := by rw [hu_s.mul_val_inv]
              _ = algebraMap A₂ R_P s *
                    ((algebraMap A₂ R_P τ₂) ^ j * (algebraMap A₂ R_P c * ↑(hu_s.unit⁻¹))) := by ring
          rw [hMax_RP, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
          exact ⟨_, hx_loc⟩
        rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _
          (IsLocalRing.maximalIdeal.isMaximal R_P).ne_top] at hmem_iInf
        exact hmem_iInf

      have hNodalDiv : ∀ (j : ℕ) (g s c : A₂), s ∉ P → s * g = τ₂ ^ j * c →
          ∃ q_B : B₀, Ideal.Quotient.mk P s * q_B = u_sh ^ j * Ideal.Quotient.mk P c := by
        intro j g s c hs hsg
        let s_bar := Ideal.Quotient.mk P s
        let c_bar := Ideal.Quotient.mk P c
        let I_div : Ideal B₀ :=
          { carrier := { b : B₀ | ∃ r : B₀, b * (u_sh ^ j * c_bar) = s_bar * r }
            add_mem' := fun {b₁ b₂} ⟨r₁, hr₁⟩ ⟨r₂, hr₂⟩ =>
              ⟨r₁ + r₂, by rw [add_mul, hr₁, hr₂, mul_add]⟩
            zero_mem' := ⟨0, by simp⟩
            smul_mem' := fun a₀ {b} ⟨r, hr⟩ =>
              ⟨a₀ * r, by change (a₀ * b) * _ = _; rw [mul_assoc, hr, ← mul_assoc, mul_comm a₀ s_bar, mul_assoc]⟩ }
        have hI_top : I_div = ⊤ := by
          by_contra hne
          obtain ⟨𝔪₀, h𝔪₀_max, hle⟩ := Ideal.exists_le_maximal I_div hne
          haveI : 𝔪₀.IsPrime := h𝔪₀_max.isPrime
          let q : Ideal A₂ := Ideal.comap (Ideal.Quotient.mk P) 𝔪₀
          haveI : q.IsPrime := Ideal.IsPrime.comap (Ideal.Quotient.mk P)
          have hPq : P ≤ q := fun p hp => by
            change Ideal.Quotient.mk P p ∈ 𝔪₀
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hp]; exact 𝔪₀.zero_mem
          by_cases hqpz : q = p_z₀
          · obtain ⟨d, r, hd_pz, hdr_P⟩ := hNode s g c j hs hsg
            have hd_I : Ideal.Quotient.mk P d ∈ I_div := by
              refine ⟨Ideal.Quotient.mk P r, ?_⟩
              have h0 : Ideal.Quotient.mk P (d * (u₀ - algebraMap k A₂ t₀) ^ j * c - s * r) = 0 :=
                Ideal.Quotient.eq_zero_iff_mem.mpr hdr_P
              rw [map_sub, sub_eq_zero, map_mul, map_mul, map_mul, map_pow, map_sub] at h0
              have hu_eq : Ideal.Quotient.mk P u₀ - Ideal.Quotient.mk P (algebraMap k A₂ t₀) = u_sh := rfl
              rw [hu_eq, mul_assoc] at h0; exact h0
            exact hd_pz (hqpz ▸ hle hd_I)
          · obtain ⟨d, r, hd_q, hdc⟩ := hLocalDiv τ₂ hτ₂_ne P q hPq (hLoc₂ q hqpz hPq) j s g c hs hsg
            have hd_I : Ideal.Quotient.mk P d ∈ I_div := by
              refine ⟨u_sh ^ j * Ideal.Quotient.mk P r, ?_⟩
              have hmk := congrArg (Ideal.Quotient.mk P) hdc
              rw [map_mul, map_mul] at hmk
              calc Ideal.Quotient.mk P d * (u_sh ^ j * c_bar)
                _ = u_sh ^ j * (Ideal.Quotient.mk P d * c_bar) := by ring
                _ = u_sh ^ j * (s_bar * Ideal.Quotient.mk P r) := by rw [hmk]
                _ = s_bar * (u_sh ^ j * Ideal.Quotient.mk P r) := by ring
            exact hd_q (hle hd_I)
        have h1 : (1 : B₀) ∈ I_div := hI_top ▸ Submodule.mem_top
        obtain ⟨q_B, hq_B⟩ := h1; rw [one_mul] at hq_B; exact ⟨q_B, hq_B.symm⟩

      have hNodalUnique : ∀ (j : ℕ) (g s₁ c₁ s₂ c₂ : A₂) (q₁ q₂ : B₀),
          s₁ ∉ P → s₁ * g = τ₂ ^ j * c₁ →
          Ideal.Quotient.mk P s₁ * q₁ = u_sh ^ j * Ideal.Quotient.mk P c₁ →
          s₂ ∉ P → s₂ * g = τ₂ ^ j * c₂ →
          Ideal.Quotient.mk P s₂ * q₂ = u_sh ^ j * Ideal.Quotient.mk P c₂ →
          q₁ = q₂ := by
        intro j g s₁ c₁ s₂ c₂ q₁ q₂ hs₁ hsg₁ hq₁ hs₂ hsg₂ hq₂
        have hs₁_ne : Ideal.Quotient.mk P s₁ ≠ 0 := fun h0 => hs₁ (Ideal.Quotient.eq_zero_iff_mem.mp h0)
        have hs₂_ne : Ideal.Quotient.mk P s₂ ≠ 0 := fun h0 => hs₂ (Ideal.Quotient.eq_zero_iff_mem.mp h0)
        have hsc_eq : s₂ * c₁ = s₁ * c₂ := by
          apply mul_left_cancel₀ (pow_ne_zero j hτ₂_ne)
          calc τ₂ ^ j * (s₂ * c₁) = s₂ * (τ₂ ^ j * c₁) := by ring
            _ = s₂ * (s₁ * g) := by rw [← hsg₁]
            _ = s₁ * (s₂ * g) := by ring
            _ = s₁ * (τ₂ ^ j * c₂) := by rw [hsg₂]
            _ = τ₂ ^ j * (s₁ * c₂) := by ring
        have hmk_sc : Ideal.Quotient.mk P s₂ * Ideal.Quotient.mk P c₁ =
            Ideal.Quotient.mk P s₁ * Ideal.Quotient.mk P c₂ := by
          simpa [map_mul] using congrArg (Ideal.Quotient.mk P) hsc_eq
        apply mul_left_cancel₀ (mul_ne_zero hs₁_ne hs₂_ne)
        calc (Ideal.Quotient.mk P s₁ * Ideal.Quotient.mk P s₂) * q₁
          _ = Ideal.Quotient.mk P s₂ * (Ideal.Quotient.mk P s₁ * q₁) := by ring
          _ = u_sh ^ j * (Ideal.Quotient.mk P s₂ * Ideal.Quotient.mk P c₁) := by rw [hq₁]; ring
          _ = u_sh ^ j * (Ideal.Quotient.mk P s₁ * Ideal.Quotient.mk P c₂) := by rw [hmk_sc]
          _ = Ideal.Quotient.mk P s₁ * (u_sh ^ j * Ideal.Quotient.mk P c₂) := by ring
          _ = Ideal.Quotient.mk P s₁ * (Ideal.Quotient.mk P s₂ * q₂) := by rw [← hq₂]
          _ = (Ideal.Quotient.mk P s₁ * Ideal.Quotient.mk P s₂) * q₂ := by ring

      let s_wit : ∀ j : ℕ, W_sub j → A₂ := fun j x => Classical.choose x.2.2
      have hs_wit : ∀ (j : ℕ) (x : W_sub j), s_wit j x ∉ P :=
        fun j x => (Classical.choose_spec x.2.2).1
      let c_wit : ∀ j : ℕ, W_sub j → A₂ :=
        fun j x => Classical.choose (Classical.choose_spec x.2.2).2
      have hc_wit : ∀ (j : ℕ) (x : W_sub j), s_wit j x * x.1 = τ₂ ^ j * c_wit j x :=
        fun j x => Classical.choose_spec (Classical.choose_spec x.2.2).2

      let ψ_fn : ∀ j : ℕ, W_sub j → B₀ := fun j x =>
        Classical.choose (hNodalDiv j x.1 (s_wit j x) (c_wit j x) (hs_wit j x) (hc_wit j x))
      have hψ_spec : ∀ (j : ℕ) (x : W_sub j),
          Ideal.Quotient.mk P (s_wit j x) * ψ_fn j x =
            u_sh ^ j * Ideal.Quotient.mk P (c_wit j x) :=
        fun j x => Classical.choose_spec
          (hNodalDiv j x.1 (s_wit j x) (c_wit j x) (hs_wit j x) (hc_wit j x))
      have hψ_any : ∀ (j : ℕ) (x : W_sub j) (s c : A₂) (q_B : B₀),
          s ∉ P → s * x.1 = τ₂ ^ j * c →
          Ideal.Quotient.mk P s * q_B = u_sh ^ j * Ideal.Quotient.mk P c →
          ψ_fn j x = q_B :=
        fun j x s c q_B hs hsc hq =>
          hNodalUnique j x.1 (s_wit j x) (c_wit j x) s c (ψ_fn j x) q_B
            (hs_wit j x) (hc_wit j x) (hψ_spec j x) hs hsc hq

      let ψ_lin : ∀ j : ℕ, W_sub j →ₗ[k] B₀ := fun j =>
        { toFun := ψ_fn j
          map_add' := fun x₁ x₂ => by
            let s₁ := s_wit j x₁; let c₁ := c_wit j x₁
            let s₂ := s_wit j x₂; let c₂ := c_wit j x₂
            have hs12 : s₁ * s₂ ∉ P :=
              fun h => (‹P.IsPrime›.mem_or_mem h).elim (hs_wit j x₁) (hs_wit j x₂)
            have hsc12 : (s₁ * s₂) * (x₁ + x₂).1 = τ₂ ^ j * (s₂ * c₁ + s₁ * c₂) := by
              change (s₁ * s₂) * (x₁.1 + x₂.1) = _
              calc (s₁ * s₂) * (x₁.1 + x₂.1)
                _ = s₂ * (s₁ * x₁.1) + s₁ * (s₂ * x₂.1) := by ring
                _ = τ₂ ^ j * (s₂ * c₁ + s₁ * c₂) := by rw [hc_wit j x₁, hc_wit j x₂]; ring
            refine hψ_any j (x₁ + x₂) (s₁ * s₂) (s₂ * c₁ + s₁ * c₂) (ψ_fn j x₁ + ψ_fn j x₂)
              hs12 hsc12 ?_
            simp only [map_mul, map_add]
            calc (Ideal.Quotient.mk P s₁ * Ideal.Quotient.mk P s₂) * (ψ_fn j x₁ + ψ_fn j x₂)
              _ = Ideal.Quotient.mk P s₂ * (Ideal.Quotient.mk P s₁ * ψ_fn j x₁) +
                    Ideal.Quotient.mk P s₁ * (Ideal.Quotient.mk P s₂ * ψ_fn j x₂) := by ring
              _ = u_sh ^ j * (Ideal.Quotient.mk P s₂ * Ideal.Quotient.mk P c₁ +
                    Ideal.Quotient.mk P s₁ * Ideal.Quotient.mk P c₂) := by
                  rw [hψ_spec j x₁, hψ_spec j x₂]; ring
          map_smul' := fun α x => by
            let s := s_wit j x; let c := c_wit j x
            have hsc_α : s * (α • x).1 = τ₂ ^ j * (α • c) := by
              change s * (α • x.1) = τ₂ ^ j * (α • c)
              rw [Algebra.smul_def, Algebra.smul_def]
              calc s * (algebraMap k A₂ α * x.1) = algebraMap k A₂ α * (s * x.1) := by ring
                _ = τ₂ ^ j * (algebraMap k A₂ α * c) := by rw [hc_wit j x]; ring
            refine hψ_any j (α • x) s (α • c) (α • ψ_fn j x) (hs_wit j x) hsc_α ?_
            simp only [Algebra.smul_def, map_mul]
            have halg_eq : Ideal.Quotient.mk P (algebraMap k A₂ α) = algebraMap k B₀ α := rfl
            rw [halg_eq]
            calc Ideal.Quotient.mk P s * (algebraMap k B₀ α * ψ_fn j x)
              _ = algebraMap k B₀ α * (Ideal.Quotient.mk P s * ψ_fn j x) := by ring
              _ = algebraMap k B₀ α * (u_sh ^ j * Ideal.Quotient.mk P c) := by rw [hψ_spec j x]
              _ = u_sh ^ j * (algebraMap k B₀ α * Ideal.Quotient.mk P c) := by ring }

      have hψ_ker : ∀ (j : ℕ) (x : W_sub j),
          ψ_lin j x = 0 ↔ x.1 ∈ W_sub (j + 1) := by
        intro j x
        constructor
        · intro h0
          have hspec := hψ_spec j x
          change Ideal.Quotient.mk P (s_wit j x) * ψ_lin j x = _ at hspec
          rw [h0, mul_zero] at hspec
          have hc0 : Ideal.Quotient.mk P (c_wit j x) = 0 :=
            (mul_eq_zero.mp hspec.symm).resolve_left (pow_ne_zero j hu_sh_ne)
          have hcP : c_wit j x ∈ P := Ideal.Quotient.eq_zero_iff_mem.mp hc0
          have hc_RP : algebraMap A₂ R_P (c_wit j x) ∈ Ideal.span {algebraMap A₂ R_P τ₂} := by
            rw [← hLoc₂ P hP_ne_pz le_rfl]; exact Ideal.mem_map_of_mem _ hcP
          obtain ⟨w_loc, hw_loc⟩ := Ideal.mem_span_singleton.mp hc_RP
          obtain ⟨⟨c', s'⟩, hcs'⟩ := IsLocalization.surj P.primeCompl w_loc
          have hs'c : s'.1 * c_wit j x = τ₂ * c' := hinj_P (by
            calc algebraMap A₂ R_P (s'.1 * c_wit j x)
              _ = algebraMap A₂ R_P (c_wit j x) * algebraMap A₂ R_P s'.1 := by rw [map_mul, mul_comm]
              _ = algebraMap A₂ R_P τ₂ * (w_loc * algebraMap A₂ R_P s'.1) := by rw [hw_loc, mul_assoc]
              _ = algebraMap A₂ R_P (τ₂ * c') := by rw [hcs', map_mul])
          refine ⟨x.2.1, s'.1 * s_wit j x, fun h => (‹P.IsPrime›.mem_or_mem h).elim s'.2 (hs_wit j x), c', ?_⟩
          calc (s'.1 * s_wit j x) * x.1 = s'.1 * (s_wit j x * x.1) := by ring
            _ = s'.1 * (τ₂ ^ j * c_wit j x) := by rw [hc_wit j x]
            _ = τ₂ ^ j * (s'.1 * c_wit j x) := by ring
            _ = τ₂ ^ (j + 1) * c' := by rw [hs'c, pow_succ']; ring
        · rintro ⟨_, s', hs', c', hsc'⟩
          have hsc_j : s' * x.1 = τ₂ ^ j * (τ₂ * c') := by rw [hsc', pow_succ']; ring
          have hmk_τc : Ideal.Quotient.mk P (τ₂ * c') = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (P.mul_mem_right c' hτ₂_P)
          exact hψ_any j x s' (τ₂ * c') 0 hs' hsc_j (by rw [mul_zero, hmk_τc, mul_zero])

      have hψ_deg : ∀ (j : ℕ) (x : W_sub j) (μ : Fin a),
          (v.repr (ψ_lin j x) μ) ≠ 0 →
          2 * j + (v.repr (ψ_lin j x) μ).natDegree ≤ K + C₀ := by
        intro j x μ hμ_ne
        let g := x.1
        let s := s_wit j x
        let c := c_wit j x
        let q_B := ψ_lin j x
        obtain ⟨g₀, hg₀⟩ := hW_pole g x.2.1
        obtain ⟨m_s, s₀', hs₀'⟩ := hClear₀ (res₂ s)
        obtain ⟨m_c, c₀', hc₀'⟩ := hClear₀ (res₂ c)
        let M_sc := m_s + m_c
        let s₀ : A₀ := S_Z ^ m_c * s₀'
        let c₀ : A₀ := S_Z ^ m_s * c₀'
        have hs₀_eq : res₀ S_Z ^ M_sc * res₂ s = res₀ s₀ := by
          dsimp [M_sc, s₀]; rw [pow_add, map_mul, map_pow]; linear_combination res₀ S_Z ^ m_c * hs₀'
        have hc₀_eq : res₀ S_Z ^ M_sc * res₂ c = res₀ c₀ := by
          dsimp [M_sc, c₀]; rw [pow_add, map_mul, map_pow]; linear_combination res₀ S_Z ^ m_s * hc₀'
        have hs₀_Q : s₀ ∉ Q := by
          intro hmem
          have hres_s : res₂ s ∈ I₀₂ := by
            have hs_ov : res₂ s = res₂ u₀ ^ M_sc * res₀ s₀ := by
              calc res₂ s = (res₀ S_Z * res₂ u₀) ^ M_sc * res₂ s := by rw [hSu₀, one_pow, one_mul]
                _ = res₂ u₀ ^ M_sc * (res₀ S_Z ^ M_sc * res₂ s) := by rw [mul_pow]; ring
                _ = res₂ u₀ ^ M_sc * res₀ s₀ := by rw [hs₀_eq]
            rw [hs_ov]
            have hmem₀ : res₀ s₀ ∈ I₀₂ := by
              change res₀ s₀ ∈ Ideal.map res₂.toRingHom P
              rw [hMapPQ]; exact Ideal.mem_map_of_mem _ hmem
            exact I₀₂.mul_mem_left _ hmem₀
          have hsP : s ∈ P := by rwa [← hComap₂]
          exact hs_wit j x hsP

        have hA₀_rel : (s₀ * S_Z ^ (3 * j)) * g₀ = τ₀ ^ j * (S_Z ^ K * c₀) := hinj₀ (by
          calc res₀ ((s₀ * S_Z ^ (3 * j)) * g₀)
            _ = res₀ s₀ * res₀ S_Z ^ (3 * j) * res₀ g₀ := by simp [map_mul, map_pow]
            _ = (res₀ S_Z ^ M_sc * res₂ s) * res₀ S_Z ^ (3 * j) *
                  (res₀ S_Z ^ K * res₂ g) := by rw [← hs₀_eq, ← hg₀]
            _ = res₀ S_Z ^ M_sc * res₀ S_Z ^ (3 * j) * res₀ S_Z ^ K * res₂ (s * g) := by
                rw [map_mul]; ring
            _ = res₀ S_Z ^ M_sc * res₀ S_Z ^ (3 * j) * res₀ S_Z ^ K * res₂ (τ₂ ^ j * c) := by
                rw [hc_wit j x]
            _ = (res₀ S_Z ^ 3 * res₂ τ₂) ^ j * res₀ S_Z ^ K * (res₀ S_Z ^ M_sc * res₂ c) := by
                rw [map_mul, map_pow]; ring
            _ = res₀ τ₀ ^ j * res₀ S_Z ^ K * res₀ c₀ := by rw [hS3τ, hc₀_eq]
            _ = res₀ (τ₀ ^ j * (S_Z ^ K * c₀)) := by simp only [map_mul, map_pow]; ring)

        let s₀_bar : B_inf := Ideal.Quotient.mk Q s₀
        let c₀_bar : B_inf := Ideal.Quotient.mk Q c₀
        let z_num : B_inf := (1 - algebraMap k B_inf t₀ * S) ^ j * S ^ K * c₀_bar

        have hs₀_ov : ι_Binf s₀_bar = ι_Binf S ^ M_sc * ι_B0 (Ideal.Quotient.mk P s) := by
          change Ideal.Quotient.mk I₀₂ (res₀ s₀) =
            Ideal.Quotient.mk I₀₂ (res₀ S_Z) ^ M_sc * Ideal.Quotient.mk I₀₂ (res₂ s)
          rw [← hs₀_eq, map_mul, map_pow]
        have hc₀_ov : ι_Binf c₀_bar = ι_Binf S ^ M_sc * ι_B0 (Ideal.Quotient.mk P c) := by
          change Ideal.Quotient.mk I₀₂ (res₀ c₀) =
            Ideal.Quotient.mk I₀₂ (res₀ S_Z) ^ M_sc * Ideal.Quotient.mk I₀₂ (res₂ c)
          rw [← hc₀_eq, map_mul, map_pow]
        have hsh_ov : ι_Binf (1 - algebraMap k B_inf t₀ * S) = ι_Binf S * ι_B0 u_sh := by
          dsimp [u_sh]
          rw [map_sub, map_one, map_mul, map_sub, AlgHom.commutes, AlgHom.commutes]
          calc 1 - algebraMap k B_ov t₀ * ι_Binf S
            _ = ι_Binf S * ι_B0 T - algebraMap k B_ov t₀ * ι_Binf S := by rw [hST_ov]
            _ = ι_Binf S * (ι_B0 T - algebraMap k B_ov t₀) := by ring

        have hMaster : ι_Binf (s₀_bar * S ^ (3 * j)) * ι_Binf (S ^ K) * ι_B0 (T ^ (2 * j) * q_B) =
            ι_Binf z_num := by
          have hS3T2 : ι_Binf S ^ (3 * j) * ι_B0 T ^ (2 * j) = ι_Binf S ^ j := by
            calc ι_Binf S ^ (3 * j) * ι_B0 T ^ (2 * j)
              _ = ι_Binf S ^ j * (ι_Binf S * ι_B0 T) ^ (2 * j) := by ring
              _ = ι_Binf S ^ j := by rw [hST_ov, one_pow, mul_one]
          have hsq_eq : Ideal.Quotient.mk P s * q_B = u_sh ^ j * Ideal.Quotient.mk P c :=
            hψ_spec j x
          calc ι_Binf (s₀_bar * S ^ (3 * j)) * ι_Binf (S ^ K) * ι_B0 (T ^ (2 * j) * q_B)
            _ = ι_Binf s₀_bar * (ι_Binf S ^ (3 * j) * ι_B0 T ^ (2 * j)) *
                  ι_Binf S ^ K * ι_B0 q_B := by simp only [map_mul, map_pow]; ring
            _ = ι_Binf S ^ M_sc * ι_Binf S ^ j * ι_Binf S ^ K *
                  ι_B0 (Ideal.Quotient.mk P s * q_B) := by rw [hs₀_ov, hS3T2, map_mul]; ring
            _ = ι_Binf S ^ M_sc * ι_Binf S ^ j * ι_Binf S ^ K *
                  ι_B0 (u_sh ^ j * Ideal.Quotient.mk P c) := by rw [hsq_eq]
            _ = (ι_Binf S * ι_B0 u_sh) ^ j * ι_Binf S ^ K *
                  (ι_Binf S ^ M_sc * ι_B0 (Ideal.Quotient.mk P c)) := by
                simp only [map_mul, map_pow]; ring
            _ = ι_Binf (1 - algebraMap k B_inf t₀ * S) ^ j * ι_Binf S ^ K * ι_Binf c₀_bar := by
                rw [← hsh_ov, ← hc₀_ov]
            _ = ι_Binf z_num := by dsimp [z_num]; simp [map_mul, map_pow]

        let I_inf : Ideal B_inf :=
          { carrier := { b : B_inf | ∃ y : B_inf, b * z_num = (s₀_bar * S ^ (3 * j)) * y }
            add_mem' := fun {b₁ b₂} ⟨y₁, hy₁⟩ ⟨y₂, hy₂⟩ =>
              ⟨y₁ + y₂, by rw [add_mul, hy₁, hy₂, mul_add]⟩
            zero_mem' := ⟨0, by simp⟩
            smul_mem' := fun a₀ {b} ⟨y, hy⟩ =>
              ⟨a₀ * y, by change (a₀ * b) * _ = _; rw [mul_assoc, hy]; ring⟩ }
        have hI_inf_top : I_inf = ⊤ := by
          by_contra hne
          obtain ⟨𝔪_inf, h𝔪_max, hle⟩ := Ideal.exists_le_maximal I_inf hne
          haveI : 𝔪_inf.IsPrime := h𝔪_max.isPrime
          let q : Ideal A₀ := Ideal.comap (Ideal.Quotient.mk Q) 𝔪_inf
          haveI : q.IsPrime := Ideal.IsPrime.comap (Ideal.Quotient.mk Q)
          have hQq : Q ≤ q := fun p hp => by
            change Ideal.Quotient.mk Q p ∈ 𝔪_inf
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hp]; exact 𝔪_inf.zero_mem
          by_cases hSq : S_Z ∈ q
          · have hsS_Q : s₀ * S_Z ^ (3 * j) ∉ Q :=
              fun h => (‹Q.IsPrime›.mem_or_mem h).elim hs₀_Q
                (fun hp => hSZ_Q (‹Q.IsPrime›.mem_of_pow_mem (3 * j) hp))
            obtain ⟨d₀, r₀_el, hd₀_q, hd₀_eq⟩ :=
              hLocalDiv τ₀ hτ₀_ne Q q hQq (hLoc₀ q hSq hQq) j
                (s₀ * S_Z ^ (3 * j)) g₀ (S_Z ^ K * c₀) hsS_Q hA₀_rel
            have hd₀_I : Ideal.Quotient.mk Q d₀ ∈ I_inf := by
              refine ⟨(1 - algebraMap k B_inf t₀ * S) ^ j * Ideal.Quotient.mk Q r₀_el, ?_⟩
              have hmk := congrArg (Ideal.Quotient.mk Q) hd₀_eq
              simp only [map_mul, map_pow] at hmk
              change Ideal.Quotient.mk Q d₀ * ((1 - algebraMap k B_inf t₀ * S) ^ j * S ^ K * c₀_bar) =
                (s₀_bar * S ^ (3 * j)) * ((1 - algebraMap k B_inf t₀ * S) ^ j * Ideal.Quotient.mk Q r₀_el)
              calc Ideal.Quotient.mk Q d₀ * ((1 - algebraMap k B_inf t₀ * S) ^ j * S ^ K * c₀_bar)
                _ = (1 - algebraMap k B_inf t₀ * S) ^ j *
                      (Ideal.Quotient.mk Q d₀ * (Ideal.Quotient.mk Q S_Z ^ K * Ideal.Quotient.mk Q c₀)) := by
                    dsimp [S, c₀_bar]; ring
                _ = (1 - algebraMap k B_inf t₀ * S) ^ j *
                      ((Ideal.Quotient.mk Q s₀ * Ideal.Quotient.mk Q S_Z ^ (3 * j)) *
                        Ideal.Quotient.mk Q r₀_el) := by rw [hmk]
                _ = (s₀_bar * S ^ (3 * j)) *
                      ((1 - algebraMap k B_inf t₀ * S) ^ j * Ideal.Quotient.mk Q r₀_el) := by
                    dsimp [s₀_bar, S]; ring
            exact hd₀_q (hle hd₀_I)
          · let q_tilde : A₂ := Quotient.out q_B
            have hq_out : Ideal.Quotient.mk P q_tilde = q_B := Quotient.out_eq q_B
            obtain ⟨N_q, y₀, hy₀⟩ := hClear₀ (res₂ (u₀ ^ (2 * j) * q_tilde))
            have hy₀_ov : ι_Binf (S ^ N_q) * ι_B0 (T ^ (2 * j) * q_B) =
                ι_Binf (Ideal.Quotient.mk Q y₀) := by
              rw [← hq_out]
              change Ideal.Quotient.mk I₀₂ (res₀ (S_Z ^ N_q)) *
                  Ideal.Quotient.mk I₀₂ (res₂ (u₀ ^ (2 * j) * q_tilde)) =
                Ideal.Quotient.mk I₀₂ (res₀ y₀)
              rw [← map_mul, map_pow, hy₀]
            have hSN_I : S ^ N_q ∈ I_inf := by
              refine ⟨S ^ K * Ideal.Quotient.mk Q y₀, hinj_Binf ?_⟩
              calc ι_Binf (S ^ N_q * z_num)
                _ = ι_Binf (S ^ N_q) * ι_Binf z_num := map_mul _ _ _
                _ = ι_Binf (S ^ N_q) *
                      (ι_Binf (s₀_bar * S ^ (3 * j)) * ι_Binf (S ^ K) * ι_B0 (T ^ (2 * j) * q_B)) := by
                    rw [← hMaster]
                _ = ι_Binf (s₀_bar * S ^ (3 * j)) * ι_Binf (S ^ K) *
                      (ι_Binf (S ^ N_q) * ι_B0 (T ^ (2 * j) * q_B)) := by ring
                _ = ι_Binf ((s₀_bar * S ^ (3 * j)) * (S ^ K * Ideal.Quotient.mk Q y₀)) := by
                    rw [hy₀_ov]; simp only [map_mul]; ring
            have hSN_m : S ^ N_q ∈ 𝔪_inf := hle hSN_I
            have hS_m : S ∈ 𝔪_inf := h𝔪_max.isPrime.mem_of_pow_mem N_q hSN_m
            exact hSq hS_m

        have h1_inf : (1 : B_inf) ∈ I_inf := hI_inf_top ▸ Submodule.mem_top
        obtain ⟨y_inf, hy_inf⟩ := h1_inf; rw [one_mul] at hy_inf
        have hsS_ne : ι_Binf (s₀_bar * S ^ (3 * j)) ≠ 0 := by
          have hs₀_ne : s₀_bar ≠ 0 := fun h0 => hs₀_Q (Ideal.Quotient.eq_zero_iff_mem.mp h0)
          have hprod_ne : s₀_bar * S ^ (3 * j) ≠ 0 := mul_ne_zero hs₀_ne (pow_ne_zero _ hS_ne)
          exact fun h0 => hprod_ne (hinj_Binf (h0.trans (map_zero _).symm))
        have hSqB_eq : ι_Binf (S ^ K) * ι_B0 (T ^ (2 * j) * q_B) = ι_Binf y_inf := by
          apply mul_left_cancel₀ hsS_ne
          calc ι_Binf (s₀_bar * S ^ (3 * j)) * (ι_Binf (S ^ K) * ι_B0 (T ^ (2 * j) * q_B))
            _ = ι_Binf z_num := by rw [← mul_assoc, hMaster]
            _ = ι_Binf (s₀_bar * S ^ (3 * j)) * ι_Binf y_inf := by rw [hy_inf, map_mul]
        have hT2j_eq : ι_B0 (T ^ (2 * j) * q_B) = ι_B0 (T ^ K) * ι_Binf y_inf := by
          calc ι_B0 (T ^ (2 * j) * q_B)
            _ = (ι_Binf S * ι_B0 T) ^ K * ι_B0 (T ^ (2 * j) * q_B) := by rw [hST_ov, one_pow, one_mul]
            _ = ι_B0 (T ^ K) * (ι_Binf (S ^ K) * ι_B0 (T ^ (2 * j) * q_B)) := by
                rw [mul_pow, map_pow, map_pow]; ring
            _ = ι_B0 (T ^ K) * ι_Binf y_inf := by rw [hSqB_eq]

        obtain ⟨N_R, z_B, hz_ov, hz_deg⟩ := hBinf_deg y_inf
        have hB0_eq : T ^ (2 * j + N_R + M_inf) * q_B = T ^ K * z_B := hinj_B0 (by
          calc ι_B0 (T ^ (2 * j + N_R + M_inf) * q_B)
            _ = ι_B0 (T ^ (N_R + M_inf)) * ι_B0 (T ^ (2 * j) * q_B) := by
                simp only [pow_add, map_mul, map_pow]; ring
            _ = ι_B0 (T ^ K) * (ι_B0 (T ^ (N_R + M_inf)) * ι_Binf y_inf) := by rw [hT2j_eq]; ring
            _ = ι_B0 (T ^ K * z_B) := by rw [hz_ov, map_mul])
        letI : Algebra (Polynomial k) B₀ := algB0
        have hpoly_eq : Polynomial.X ^ (2 * j + N_R + M_inf) * v.repr q_B μ =
            Polynomial.X ^ K * v.repr z_B μ := by
          have hsmul_eq : (Polynomial.X ^ (2 * j + N_R + M_inf) : Polynomial k) • q_B =
              (Polynomial.X ^ K : Polynomial k) • z_B := by
            simpa [hsmul_B0, map_pow] using hB0_eq
          have hrepr := congrArg (fun w => v.repr w μ) hsmul_eq
          simpa [map_smul, smul_eq_mul] using hrepr
        have hLHS_ne : Polynomial.X ^ (2 * j + N_R + M_inf) * v.repr q_B μ ≠ 0 :=
          mul_ne_zero (Polynomial.monic_X_pow _).ne_zero hμ_ne
        have hz_μ_ne : v.repr z_B μ ≠ 0 := fun h0 => by
          rw [h0, mul_zero] at hpoly_eq; exact hLHS_ne hpoly_eq
        have hdeg_eq := congrArg Polynomial.natDegree hpoly_eq
        rw [Polynomial.natDegree_mul (Polynomial.monic_X_pow _).ne_zero hμ_ne,
          Polynomial.natDegree_mul (Polynomial.monic_X_pow _).ne_zero hz_μ_ne,
          Polynomial.natDegree_X_pow, Polynomial.natDegree_X_pow] at hdeg_eq
        have hz_le := hz_deg μ
        omega

      let J := (K + C₀) / 2
      have hW_step_ge : ∀ j : ℕ, J + 1 ≤ j → W_sub j ≤ W_sub (j + 1) := by
        intro j hj x hx
        refine (hψ_ker j ⟨x, hx⟩).mp ?_
        apply v.repr.injective; rw [map_zero]
        refine Finsupp.ext fun μ => ?_
        simp only [Finsupp.coe_zero, Pi.zero_apply]
        by_contra hne
        have hdeg := hψ_deg j ⟨x, hx⟩ μ hne
        omega
      have hWJ_bot : W_sub (J + 1) = ⊥ := by
        rw [eq_bot_iff]; intro x hx
        suffices hx0 : x = 0 by rw [hx0]; exact Submodule.zero_mem ⊥
        apply hW_krull x; intro m
        by_cases hm : m ≤ J + 1
        · have h_anti_le : ∀ d : ℕ, W_sub (m + d) ≤ W_sub m := by
            intro d; induction d with
            | zero => exact le_rfl
            | succ d ih => exact (hW_anti (m + d)).trans ih
          have hsub : m + (J + 1 - m) = J + 1 := Nat.add_sub_of_le hm
          exact h_anti_le (J + 1 - m) (hsub.symm ▸ hx)
        · have h_up : ∀ d : ℕ, W_sub (J + 1) ≤ W_sub (J + 1 + d) := by
            intro d; induction d with
            | zero => exact le_rfl
            | succ d ih => exact ih.trans (hW_step_ge (J + 1 + d) (by omega))
          have hsub : J + 1 + (m - (J + 1)) = m := Nat.add_sub_of_le (by omega)
          have h1 := h_up (m - (J + 1)) hx
          rwa [hsub] at h1

      have hStepDim : ∀ j : ℕ, j ≤ J →
          Module.finrank k (W_sub j) ≤
            a * (K + C₀ - 2 * j + 1) + Module.finrank k (W_sub (j + 1)) := by
        intro j hj
        haveI : Module.Finite k (W_sub j) :=
          Module.Finite.of_injective (Submodule.inclusion (hW_le j))
            (Submodule.inclusion_injective (hW_le j))
        let L_j := K + C₀ - 2 * j + 1
        let K_j : Submodule k ↥(W_sub j) := Submodule.comap (W_sub j).subtype (W_sub (j + 1))
        have hKj_eq_range : K_j = LinearMap.range (Submodule.inclusion (hW_anti j)) := by
          ext x
          simp only [K_j, Submodule.mem_comap, LinearMap.mem_range]
          exact ⟨fun hx => ⟨⟨x.1, hx⟩, rfl⟩, fun ⟨y, hy⟩ => hy ▸ y.2⟩
        have hKj_dim : Module.finrank k K_j = Module.finrank k (W_sub (j + 1)) := by
          rw [hKj_eq_range]
          exact LinearMap.finrank_range_of_inj (Submodule.inclusion_injective (hW_anti j))
        letI : Algebra (Polynomial k) B₀ := algB0
        haveI : IsScalarTower k (Polynomial k) B₀ :=
          IsScalarTower.of_algebraMap_smul fun c z => by
            rw [Polynomial.algebraMap_eq, hsmul_B0, Polynomial.aeval_C, Algebra.smul_def]
        let θ_j : ↥(W_sub j) →ₗ[k] (Fin a × Fin L_j → k) :=
          { toFun := fun x p => (v.repr (ψ_lin j x) p.1).coeff p.2.1
            map_add' := fun x₁ x₂ => by ext p; simp [map_add]
            map_smul' := fun α x => by
              ext p
              have hrepr_smul : v.repr (α • ψ_lin j x) = α • v.repr (ψ_lin j x) := by
                rw [algebra_compatible_smul (Polynomial k) α, map_smul, ← algebra_compatible_smul]
              simp [map_smul, hrepr_smul, Polynomial.coeff_smul, smul_eq_mul] }
        have hker_eq : LinearMap.ker θ_j = K_j := by
          apply le_antisymm
          · intro x hx
            rw [LinearMap.mem_ker] at hx
            change x.1 ∈ W_sub (j + 1)
            rw [← hψ_ker j x]
            apply v.repr.injective; rw [map_zero]
            refine Finsupp.ext fun μ => Polynomial.ext fun d => ?_
            simp only [Finsupp.coe_zero, Pi.zero_apply, Polynomial.coeff_zero]
            by_cases hμ_zero : v.repr (ψ_lin j x) μ = 0
            · simp [hμ_zero]
            · have hdeg := hψ_deg j x μ hμ_zero
              have hdeg_lt : (v.repr (ψ_lin j x) μ).natDegree < L_j := by dsimp [L_j]; omega
              by_cases hd : d < L_j
              · exact congrFun hx (μ, ⟨d, hd⟩)
              · exact Polynomial.coeff_eq_zero_of_natDegree_lt
                  (hdeg_lt.trans_le (Nat.le_of_not_lt hd))
          · intro x hx
            have hψ0 : ψ_lin j x = 0 := (hψ_ker j x).mpr hx
            rw [LinearMap.mem_ker]; ext p; simp [θ_j, hψ0]
        have hrange_le : Module.finrank k ↥(LinearMap.range θ_j) ≤ a * L_j := by
          calc Module.finrank k ↥(LinearMap.range θ_j)
            _ ≤ Module.finrank k (Fin a × Fin L_j → k) := Submodule.finrank_le _
            _ = a * L_j := by
                rw [Module.finrank_fintype_fun_eq_card, Fintype.card_prod, Fintype.card_fin,
                  Fintype.card_fin]
        have hrn := LinearMap.finrank_range_add_finrank_ker θ_j
        rw [hker_eq, hKj_dim] at hrn
        rw [← hrn]
        exact Nat.add_le_add_right hrange_le _

      have hTele : ∀ n : ℕ, n ≤ J + 1 →
          Module.finrank k (W_sub 0) ≤
            (∑ j ∈ Finset.range n, a * (K + C₀ - 2 * j + 1)) + Module.finrank k (W_sub n) := by
        intro n; induction n with
        | zero => intro _; simp
        | succ n ih =>
          intro hn; rw [Finset.sum_range_succ]
          have h1 := ih (by omega); have h2 := hStepDim n (by omega); omega

      have hTeleJ := hTele (J + 1) le_rfl
      have hW0_dim : Module.finrank k (W_sub 0) = Module.finrank k W := by rw [hW0_eq]
      have hWJ_dim : Module.finrank k (W_sub (J + 1)) = 0 := by rw [hWJ_bot, finrank_bot]
      rw [hW0_dim, hWJ_dim, add_zero] at hTeleJ
      exact hTeleJ

    let S₀ := r₀ + C₀ + 4
    let K := 16 * S₀
    have hr₀_le_K : r₀ ≤ K := by dsimp [K, S₀]; omega
    obtain ⟨W_K, hFinWK, hWK_dim, hWK_pole⟩ := hWK_fam K hr₀_le_K
    have hWK_upper := hBound K W_K hFinWK hWK_pole

    let J := (K + C₀) / 2
    let M := K + C₀ + 1
    have hSumArith : ∀ n : ℕ, 2 * n ≤ M →
        (∑ j ∈ Finset.range (n + 1), (M - 2 * j)) + n * (n + 1) = (n + 1) * M := by
      intro n; induction n with
      | zero => intro _; simp
      | succ n ih =>
        intro hn; rw [Finset.sum_range_succ]
        have h_ih := ih (by omega)
        have h_sub : M - 2 * (n + 1) + (n + 1) * (n + 2) = n * (n + 1) + M := by
          have hle : 2 * (n + 1) ≤ M := hn; zify [hle]; ring
        linarith

    have h2J_le_M : 2 * J ≤ M := by dsimp [J, M]; omega
    have hSum_eq : ∑ j ∈ Finset.range (J + 1), a * (K + C₀ - 2 * j + 1) =
        a * ((J + 1) * (M - J)) := by
      have hcongr : ∑ j ∈ Finset.range (J + 1), a * (K + C₀ - 2 * j + 1) =
          a * ∑ j ∈ Finset.range (J + 1), (M - 2 * j) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j hj => ?_
        have hj_le : j ≤ J := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
        dsimp [M, J] at hj_le ⊢; congr 1; omega
      rw [hcongr]; congr 1
      have hJ := hSumArith J h2J_le_M
      have hJ_le_M : J ≤ M := by omega
      zify [hJ_le_M] at hJ ⊢; linarith

    rw [hSum_eq] at hWK_upper
    have hJM_sum : (J + 1) + (M - J) ≤ 17 * S₀ := by dsimp [J, M, K, S₀]; omega
    have h4U : 4 * ((J + 1) * (M - J)) ≤ (17 * S₀) ^ 2 := by
      have h_amgm : 4 * ((J + 1) * (M - J)) ≤ ((J + 1) + (M - J)) ^ 2 := by
        zify
        have hsq : (0 : ℤ) ≤ ((J + 1 : ℤ) - ↑(M - J)) ^ 2 := sq_nonneg _
        linarith
      exact h_amgm.trans (Nat.pow_le_pow_left hJM_sum 2)
    have h12_upper : 12 * Module.finrank k W_K ≤ 867 * (a * S₀ ^ 2) := by
      calc 12 * Module.finrank k W_K
        _ ≤ 12 * (a * ((J + 1) * (M - J))) := Nat.mul_le_mul_left 12 hWK_upper
        _ = 3 * a * (4 * ((J + 1) * (M - J))) := by ring
        _ ≤ 3 * a * (17 * S₀) ^ 2 := Nat.mul_le_mul_left (3 * a) h4U
        _ = 867 * (a * S₀ ^ 2) := by ring

    have hKr1 : 15 * S₀ ≤ K - r₀ + 1 := by dsimp [K, S₀]; omega
    have hKr2 : 15 * S₀ ≤ K - r₀ + 2 := by dsimp [K, S₀]; omega
    have h12_lower : 900 * (a * S₀ ^ 2) ≤ 12 * Module.finrank k W_K := by
      calc 900 * (a * S₀ ^ 2)
        _ = 2 * (2 * a) * ((15 * S₀) * (15 * S₀)) := by ring
        _ ≤ 2 * (3 * d_Z) * ((K - r₀ + 2) * (K - r₀ + 1)) :=
            Nat.mul_le_mul (Nat.mul_le_mul_left 2 ha_le) (Nat.mul_le_mul hKr2 hKr1)
        _ = 6 * (d_Z * (K - r₀ + 2) * (K - r₀ + 1)) := by ring
        _ = 6 * (2 * Module.finrank k W_K) := by rw [← hWK_dim]
        _ = 12 * Module.finrank k W_K := by ring

    have hS₀_pos : 4 ≤ S₀ := by dsimp [S₀]; omega
    have haS_pos : 1 ≤ a * S₀ ^ 2 := by nlinarith
    linarith

  
  
  
  have hNontriv_BΓ2 : Nontrivial B_Γ2 := by
    obtain ⟨z₁, z₂, hz12⟩ := exists_pair_ne (B_Γ2 ⧸ Ideal.span {u₁_bar})
    obtain ⟨x₁, rfl⟩ := Ideal.Quotient.mk_surjective z₁
    obtain ⟨x₂, rfl⟩ := Ideal.Quotient.mk_surjective z₂
    exact ⟨⟨x₁, x₂, fun h => hz12 (congrArg _ h)⟩⟩

  obtain ⟨d_Z, hb_Γ2, hRank_BΓ2_3⟩ :
      ∃ d_Z : ℕ,
        (letI : Algebra (Polynomial k) B_Γ2 := (Polynomial.aeval u₁_bar).toRingHom.toAlgebra
         Nonempty (Module.Basis (Fin d_Z) (Polynomial k) B_Γ2)) ∧
        Module.finrank k (B_Γ2 ⧸ Ideal.span {u₁_bar ^ 3}) = d_Z * 3 := by
    letI : Algebra (Polynomial k) B_Γ2 := (Polynomial.aeval u₁_bar).toRingHom.toAlgebra
    haveI : Module.Finite (Polynomial k) B_Γ2 := hBΓ2.1
    haveI : Module.IsTorsionFree (Polynomial k) B_Γ2 := hBΓ2.2
    let ⟨d_Z, b_Γ2⟩ := Module.basisOfFiniteTypeTorsionFree' (R := Polynomial k) (M := B_Γ2)
    obtain ⟨_, hr3⟩ := hPart1a (K := k) u₁_bar d_Z 3 ⟨b_Γ2⟩
    exact ⟨d_Z, ⟨b_Γ2⟩, hr3⟩

  obtain ⟨_, _, hRank_Γ0_inf⟩ := hPart1c
  have hRank_u0_τ2 : Module.finrank k (A₂ ⧸ Ideal.span {u₀, τ₂}) = 3 * d_Z := by
    rw [← e_Γ0_Q.finrank_eq, hRank_Γ0_inf, e_Γinf_Q.finrank_eq, hRank_BΓ2_3, mul_comm]

  have hBranchRank : ∀ (P : Ideal A₂) [P.IsPrime],
      P ≤ p_z₀ → Nontrivial (A₂ ⧸ (P ⊔ Ideal.span {u₀})) →
      (letI : Algebra (Polynomial k) (A₂ ⧸ P) :=
        (Polynomial.aeval (Ideal.Quotient.mk P u₀)).toRingHom.toAlgebra
       Module.Finite (Polynomial k) (A₂ ⧸ P)) →
      ∃ a : ℕ, 1 ≤ a ∧
        (letI : Algebra (Polynomial k) (A₂ ⧸ P) :=
          (Polynomial.aeval (Ideal.Quotient.mk P u₀)).toRingHom.toAlgebra
         Nonempty (Module.Basis (Fin a) (Polynomial k) (A₂ ⧸ P))) ∧
        Module.Finite k (A₂ ⧸ (P ⊔ Ideal.span {u₀})) ∧
        Module.finrank k (A₂ ⧸ (P ⊔ Ideal.span {u₀})) = a := by
    intro P _ hP_pz hNontriv_sup hFin_P
    haveI : IsDomain (A₂ ⧸ P) := Ideal.Quotient.isDomain P
    have hu₀_Pbar : Ideal.Quotient.mk P u₀ ≠ 0 :=
      fun h0 => hu₀_pz (hP_pz (Ideal.Quotient.eq_zero_iff_mem.mp h0))
    have hmap_span : Ideal.map (Ideal.Quotient.mkₐ k P) (Ideal.span {u₀}) =
        Ideal.span {Ideal.Quotient.mk P u₀} := by
      rw [Ideal.map_span, Set.image_singleton]; rfl
    let e_dq : ((A₂ ⧸ P) ⧸ Ideal.span {Ideal.Quotient.mk P u₀}) ≃ₐ[k]
        (A₂ ⧸ (P ⊔ Ideal.span {u₀})) :=
      (AlgEquiv.ofRingEquiv (f := Ideal.quotEquivOfEq hmap_span.symm) (fun _ => rfl)).trans
        (DoubleQuot.quotQuotEquivQuotSupₐ k P (Ideal.span {u₀}))
    have hNontriv_dq : Nontrivial ((A₂ ⧸ P) ⧸ Ideal.span {Ideal.Quotient.mk P u₀}) := by
      obtain ⟨z₁, z₂, hz12⟩ := exists_pair_ne (A₂ ⧸ (P ⊔ Ideal.span {u₀}))
      exact ⟨⟨e_dq.symm z₁, e_dq.symm z₂, fun h => hz12 (e_dq.symm.injective h)⟩⟩
    obtain ⟨a, ha_pos, hb_P, hFin_dq, hRank_dq⟩ :=
      hPart1b (Ideal.Quotient.mk P u₀) hu₀_Pbar hNontriv_dq hFin_P
    haveI : Module.Finite k ((A₂ ⧸ P) ⧸ Ideal.span {Ideal.Quotient.mk P u₀}) := hFin_dq
    have hFin_sup : Module.Finite k (A₂ ⧸ (P ⊔ Ideal.span {u₀})) :=
      Module.Finite.of_surjective e_dq.toLinearEquiv.toLinearMap e_dq.surjective
    have hRank_sup : Module.finrank k (A₂ ⧸ (P ⊔ Ideal.span {u₀})) = a := by
      rw [← e_dq.toLinearEquiv.finrank_eq, hRank_dq]
    exact ⟨a, ha_pos, hb_P, hFin_sup, hRank_sup⟩

  obtain ⟨a₁, ha₁_pos, hb_P₁, hFin_I₁, hRank_I₁⟩ :=
    hBranchRank P₁ hP₁_pz hNontriv_P₁ hFin_P₁
  obtain ⟨a₂, ha₂_pos, hb_P₂, hFin_I₂, hRank_I₂⟩ :=
    hBranchRank P₂ hP₂_pz hNontriv_P₂ hFin_P₂

  obtain ⟨e_crt⟩ := hPart2
  have ha12_sum : a₁ + a₂ = 3 * d_Z := by
    haveI : Module.Finite k (A₂ ⧸ (P₁ ⊔ Ideal.span {u₀})) := hFin_I₁
    haveI : Module.Finite k (A₂ ⧸ (P₂ ⊔ Ideal.span {u₀})) := hFin_I₂
    rw [← hRank_I₁, ← hRank_I₂, ← Module.finrank_prod, ← e_crt.finrank_eq, hRank_u0_τ2]

  obtain ⟨r₀, hWK_fam⟩ := hPart3 d_Z hNontriv_BΓ2 hb_Γ2

  have h_branch_or : 2 * a₁ ≤ 3 * d_Z ∨ 2 * a₂ ≤ 3 * d_Z := by omega
  rcases h_branch_or with ha₁_le | ha₂_le
  · exact hBranchContradiction P₁ Q₁ a₁ d_Z r₀ hτ₂_P₁ hP₁_pz hSZ_Q₁ hMap₁ hNontriv_P₁
      ha₁_pos ha₁_le hb_P₁ hFin_Q₁
      (fun q _ hne hPq => (hAway₂ q hne).2.1 hPq)
      (fun q _ hSq hQq => (hAway₀ q hSq).1 hQq)
      hNode₁ hWK_fam
  · exact hBranchContradiction P₂ Q₂ a₂ d_Z r₀ hτ₂_P₂ hP₂_pz hSZ_Q₂ hMap₂ hNontriv_P₂
      ha₂_pos ha₂_le hb_P₂ hFin_Q₂
      (fun q _ hne hPq => (hAway₂ q hne).2.2.1 hPq)
      (fun q _ hSq hQq => (hAway₀ q hSq).2 hQq)
      hNode₂ hWK_fam

theorem weil_algClosed_surface_cubic_section_irred (k : Type u) [Field k] [IsAlgClosed k] (N : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 2 Z_bar.hom]
    (ι₀ : Z_bar ⟶ weilProjectiveSpaceOver k N)
    (hCl₀ : AlgebraicGeometry.IsClosedImmersion ι₀.left)
    (F_L : MvPolynomial (Fin (N + 1)) k)
    (hFL : F_L ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 3)
    (hNondeg : ∃ z : Z_bar.left, ι₀.left.base z ∉ weilProjHyperplaneSet k N F_L)
    (C_L : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_CL : C_L ⟶ Z_bar)
    (hPull : IsHomogeneousHypersurfacePullbackOver k N 3 ι₀ F_L ι_CL.left)
    (hConn : ConnectedSpace ↥C_L.left)
    (hSmOrNode : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_L.hom ∨
      ∃ x₀ : C_L.left, IsClosed ({x₀} : Set C_L.left) ∧
        (∀ y : C_L.left, y ≠ x₀ → ∃ V : C_L.left.Opens, y ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ C_L.hom)) ∧
        ∃ (V' : AlgebraicGeometry.Scheme.{u}) (v₀ : V') (e₁ : V' ⟶ C_L.left)
          (e₂ : V' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) k ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
          AlgebraicGeometry.Etale e₁ ∧ AlgebraicGeometry.Etale e₂ ∧ e₁.base v₀ = x₀ ∧
          (∀ b : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X b) ∈ (e₂.base v₀).asIdeal) ∧
          e₁ ≫ C_L.hom = e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) :
    IrreducibleSpace ↥C_L.left :=
by
  by_contra hNotIrred
  let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
  obtain ⟨hDVR1D, hNode2D⟩ := weil_algClosed_ring_nodal_roof_split_and_dvr k
  obtain ⟨z₀, C₁, C₂, ι₁, ι₂, hz₀_cl, hInt₁, hInt₂, hProp₁, hProp₂,
    hCl₁, hCl₂, hRangeEq, _hInterEq, hDim₁, hDim₂, hChart⟩ :=
    weil_algClosed_surface_nodal_reducible_two_components k N Z_bar hInt ι₀ hCl₀
      F_L hFL hNondeg C_L ι_CL hPull hConn hSmOrNode hDVR1D hNode2D hNotIrred
  haveI : AlgebraicGeometry.IsProper C₁.hom := hProp₁
  haveI : AlgebraicGeometry.IsProper C₂.hom := hProp₂
  have hUnion : Set.range ι₁.left.base ∪ Set.range ι₂.left.base =
      ι₀.left.base ⁻¹' weilProjHyperplaneSet k N F_L := by
    obtain ⟨_, _, hRangePull, _⟩ := hPull
    rw [← hRangeEq, hRangePull]
    rfl
  obtain ⟨H₀, H₁, H₂, hH₀, hH₁, hH₂, B_Γ0, B_Γ_inf, φ_Γ0, φ_Γ_inf,
    T_Γ, S_Γ, hz₀_2, hz₀_0, hAff₂, hAff₀, hS_all⟩ :=
    weil_algClosed_proj_triple_slice_and_chart_finite k N Z_bar hInt ι₀ hCl₀
      F_L hFL hNondeg z₀ hz₀_cl C₁ C₂ hInt₁ hInt₂ ι₁ ι₂ hCl₁ hCl₂ hDim₁ hDim₂ hUnion
      (weil_algClosed_bertini_transversal_step k N)
  letI : Algebra k ↑B_Γ0 := φ_Γ0.toAlgebra
  letI : Algebra k ↑B_Γ_inf := φ_Γ_inf.toAlgebra
  let U₂ : Z_bar.left.Opens :=
    (TopologicalSpace.Opens.map ι₀.left.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂)
  let U₀ : Z_bar.left.Opens :=
    (TopologicalSpace.Opens.map ι₀.left.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₀)
  let A₂ : Type u := ↑(Z_bar.left.presheaf.obj (Opposite.op U₂))
  let A₀ : Type u := ↑(Z_bar.left.presheaf.obj (Opposite.op U₀))
  let A₀₂ : Type u := ↑(Z_bar.left.presheaf.obj (Opposite.op (U₀ ⊓ U₂)))
  letI : Algebra k A₂ :=
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
      Z_bar.hom.appLE ⊤ U₂ le_top).hom).toAlgebra
  letI : Algebra k A₀ :=
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
      Z_bar.hom.appLE ⊤ U₀ le_top).hom).toAlgebra
  letI : Algebra k A₀₂ :=
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
      Z_bar.hom.appLE ⊤ (U₀ ⊓ U₂) le_top).hom).toAlgebra
  let u₀ : A₂ :=
    (ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) U₂ (le_refl U₂)).hom
      ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₂).hom
        (HomogeneousLocalization.Away.mk 𝒜_N hH₂ 1 H₀ hH₀))
  let u₁ : A₂ :=
    (ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) U₂ (le_refl U₂)).hom
      ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₂).hom
        (HomogeneousLocalization.Away.mk 𝒜_N hH₂ 1 H₁ hH₁))
  let τ₂ : A₂ :=
    (ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) U₂ (le_refl U₂)).hom
      ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₂).hom
        (HomogeneousLocalization.Away.mk 𝒜_N hH₂ 3 F_L hFL))
  let S_Z : A₀ :=
    (ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₀) U₀ (le_refl U₀)).hom
      ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₀).hom
        (HomogeneousLocalization.Away.mk 𝒜_N hH₀ 1 H₂ hH₂))
  let v₁ : A₀ :=
    (ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₀) U₀ (le_refl U₀)).hom
      ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₀).hom
        (HomogeneousLocalization.Away.mk 𝒜_N hH₀ 1 H₁ hH₁))
  let τ₀ : A₀ :=
    (ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₀) U₀ (le_refl U₀)).hom
      ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₀).hom
        (HomogeneousLocalization.Away.mk 𝒜_N hH₀ 3 F_L hFL))
  let res₂_hom : A₂ →+* A₀₂ :=
    (Z_bar.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
  let res₀_hom : A₀ →+* A₀₂ :=
    (Z_bar.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
  let P₁ : Ideal A₂ := RingHom.ker (ι₁.left.app U₂).hom
  let P₂ : Ideal A₂ := RingHom.ker (ι₂.left.app U₂).hom
  let Q₁ : Ideal A₀ := RingHom.ker (ι₁.left.app U₀).hom
  let Q₂ : Ideal A₀ := RingHom.ker (ι₂.left.app U₀).hom
  let p_z₀ : Ideal A₂ := (hAff₂.primeIdealOf ⟨z₀, hz₀_2⟩).asIdeal
  obtain ⟨hS1, hS2, hS3⟩ :=
    hS_all U₂ U₀ (le_refl U₂) (le_refl U₀) rfl rfl hz₀_2 hz₀_0 hAff₂ hAff₀
      le_top le_top le_top inf_le_right inf_le_left
  obtain ⟨hDom₂, hNoeth₂, hDom₀, hDom₀₂, hu₀_ne, hSZ_ne, hu₀_not_pz, hSZ_not_pz,
    ⟨t₀, ht₀_mem⟩, hres₂_alg, hres₀_alg, hInj₂, hInj₀, hInv₀₂, hu₁_v₁, hτ₂_τ₀,
    hClear₂, hClear₀, hFinA₂⟩ := hS1
  haveI : IsDomain A₂ := hDom₂
  haveI : IsNoetherianRing A₂ := hNoeth₂
  haveI : IsDomain A₀ := hDom₀
  haveI : IsDomain A₀₂ := hDom₀₂
  let res₂ : A₂ →ₐ[k] A₀₂ := { res₂_hom with commutes' := hres₂_alg }
  let res₀ : A₀ →ₐ[k] A₀₂ := { res₀_hom with commutes' := hres₀_alg }
  obtain ⟨⟨_, _, hτ₂_P₁, hτ₂_P₂, hτ₂_ne_le⟩, hAway₂_le, hNode₂_le⟩ :=
    hChart H₂ hH₂ U₂ hAff₂ (le_refl U₂)
  obtain ⟨⟨_, _, hτ₀_Q₁, hτ₀_Q₂, hτ₀_ne_le⟩, hAway₀_le, hNode₀_le⟩ :=
    hChart H₀ hH₀ U₀ hAff₀ (le_refl U₀)
  obtain ⟨hpz₀_max, hP₁_prime, hP₂_prime, hP₁_le_pz₀, hP₂_le_pz₀, hPoleP₁, hPoleP₂⟩ :=
    hNode₂_le hz₀_2
  obtain ⟨_, hQ₁_prime, hQ₂_prime, _, _, _, _⟩ := hNode₀_le hz₀_0
  haveI : p_z₀.IsMaximal := hpz₀_max
  haveI : P₁.IsPrime := hP₁_prime
  haveI : P₂.IsPrime := hP₂_prime
  haveI : Q₁.IsPrime := hQ₁_prime
  haveI : Q₂.IsPrime := hQ₂_prime
  have hτ₂_ne : τ₂ ≠ 0 := hτ₂_ne_le ⟨⟨z₀, hz₀_2⟩⟩
  have hτ₀_ne : τ₀ ≠ 0 := hτ₀_ne_le ⟨⟨z₀, hz₀_0⟩⟩
  obtain ⟨hSZ_Q₁, hSZ_Q₂, hNontriv₁, hNontriv₂, hMap₁, hMap₂,
    hFinP₁, hFinP₂, hFinQ₁, hFinQ₂⟩ := hS3
  exact weil_algClosed_pid_cubic_filtration_contradiction k A₂ A₀ A₀₂
    u₀ u₁ τ₂ S_Z v₁ τ₀ res₂ res₀ (↑B_Γ0) (↑B_Γ_inf) T_Γ S_Γ p_z₀ P₁ P₂ Q₁ Q₂ t₀
    ⟨hu₀_ne, hτ₂_ne, hSZ_ne, hτ₀_ne, hu₀_not_pz, ht₀_mem, hInj₂, hInj₀,
      hInv₀₂, hu₁_v₁, hτ₂_τ₀, hClear₂, hClear₀, hFinA₂⟩
    hS2
    ⟨hτ₂_P₁, hτ₂_P₂, hP₁_le_pz₀, hP₂_le_pz₀, hτ₀_Q₁, hτ₀_Q₂, hSZ_Q₁, hSZ_Q₂,
      hMap₁, hMap₂, hNontriv₁, hNontriv₂, hFinP₁, hFinP₂, hFinQ₁, hFinQ₂⟩
    ⟨fun q hq hne => @hAway₂_le q hq (fun _ => hne),
     fun q hq hSZ_mem => by
      have hne' : ∀ hz : z₀ ∈ U₀, q ≠ (hAff₀.primeIdealOf ⟨z₀, hz⟩).asIdeal := by
        intro _ heq
        exact hSZ_not_pz (heq ▸ hSZ_mem)
      have hloc := @hAway₀_le q hq hne'
      exact ⟨hloc.2.1, hloc.2.2.1⟩,
     fun s g c j hs hsg => hPoleP₁ s g c (u₀ - algebraMap k A₂ t₀) j hs ht₀_mem hsg,
     fun s g c j hs hsg => hPoleP₂ s g c (u₀ - algebraMap k A₂ t₀) j hs ht₀_mem hsg⟩

theorem weil_algClosed_cubic_veronese_embedding_and_irred (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_bar.hom]
    (hProj : IsProjectiveOverField k Z_bar) :
    ∃ (M : ℕ) (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M),
      IsCubicVeroneseEmbeddedOver k m M Z_bar ι_bar :=
by
  classical
  
  have hProjCover : ∀ (R_dim : ℕ) (x : (weilProjectiveSpaceOver k R_dim).left),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (R_dim + 1)) k) :=
        MvPolynomial.gradedAlgebra
      ∃ μ : Fin (R_dim + 1),
        x ∈ AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (R_dim + 1)) k) (MvPolynomial.X μ) := by
    intro R_dim x
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (R_dim + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    by_contra h
    apply x.not_irrelevant_le
    intro P hP
    rw [HomogeneousIdeal.mem_irrelevant_iff] at hP
    have hP0 : P.coeff 0 = 0 := by
      have hsplit : P = MvPolynomial.C (P.coeff 0) +
          ∑ d ∈ P.support.erase 0, MvPolynomial.monomial d (P.coeff d) := by
        conv_lhs => rw [P.as_sum]
        by_cases h0 : (0 : Fin (R_dim + 1) →₀ ℕ) ∈ P.support
        · rw [← Finset.add_sum_erase _ _ h0, MvPolynomial.monomial_zero']
        · rw [Finset.erase_eq_of_notMem h0, MvPolynomial.notMem_support_iff.mp h0,
            map_zero, zero_add]
      have hproj_sum : GradedRing.proj 𝒜 0
          (∑ d ∈ P.support.erase 0, MvPolynomial.monomial d (P.coeff d)) = 0 := by
        rw [map_sum]
        refine Finset.sum_eq_zero fun d hd => ?_
        have hd_ne : d ≠ 0 := (Finset.mem_erase.mp hd).1
        have hdeg_ne : d.degree ≠ 0 := by
          intro hsum
          apply hd_ne
          ext i
          have hsum' : ∑ j ∈ d.support, d j = 0 := hsum
          rw [Finset.sum_eq_zero_iff] at hsum'
          by_cases hi : i ∈ d.support
          · exact hsum' i hi
          · exact Finsupp.notMem_support_iff.mp hi
        have hmem : MvPolynomial.monomial d (P.coeff d) ∈ 𝒜 d.degree :=
          MvPolynomial.isHomogeneous_monomial (P.coeff d) rfl
        rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_ne 𝒜 hmem hdeg_ne]
      have hC_mem : (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (R_dim + 1)) k) ∈ 𝒜 0 :=
        MvPolynomial.isHomogeneous_C _ _
      have hproj_C : GradedRing.proj 𝒜 0
          (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (R_dim + 1)) k) =
          MvPolynomial.C (P.coeff 0) := by
        rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒜 hC_mem]
      have hP_eq : (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (R_dim + 1)) k) = 0 := by
        calc (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (R_dim + 1)) k)
          _ = GradedRing.proj 𝒜 0 (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (R_dim + 1)) k) +
              GradedRing.proj 𝒜 0
                (∑ d ∈ P.support.erase 0, MvPolynomial.monomial d (P.coeff d)) := by
            rw [hproj_C, hproj_sum, add_zero]
          _ = GradedRing.proj 𝒜 0 P := by rw [← map_add, ← hsplit]
          _ = 0 := hP
      simpa using congrArg MvPolynomial.constantCoeff hP_eq
    rw [P.as_sum]
    refine Ideal.sum_mem _ fun d hd => ?_
    have hd0 : d ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hd) hP0
    have ⟨μ, hμ⟩ : ∃ μ : Fin (R_dim + 1), 0 < d μ := by
      by_contra hall
      apply hd0
      ext μ
      exact Nat.eq_zero_of_not_pos (fun hpos => hall ⟨μ, hpos⟩)
    have hX_mem : (MvPolynomial.X μ : MvPolynomial (Fin (R_dim + 1)) k) ∈
        x.asHomogeneousIdeal := by
      by_contra hnot
      exact h ⟨μ, (ProjectiveSpectrum.mem_basicOpen 𝒜 (MvPolynomial.X μ) x).mpr hnot⟩
    obtain ⟨r, hr⟩ : (MvPolynomial.X μ : MvPolynomial (Fin (R_dim + 1)) k) ∣
        MvPolynomial.monomial d (P.coeff d) := by
      refine ⟨MvPolynomial.monomial (d - Finsupp.single μ 1) (P.coeff d), ?_⟩
      rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, one_mul, add_tsub_cancel_of_le]
      intro i
      by_cases hi : i = μ
      · subst hi; simp; omega
      · simp [hi]
    rw [hr]
    exact x.asHomogeneousIdeal.toIdeal.mul_mem_right r hX_mem

  
  have hCompactZ : CompactSpace Z_bar.left :=
    QuasiCompact.compactSpace_of_compactSpace Z_bar.hom
  have hClosedPt : ∀ (S : Set Z_bar.left), IsClosed S → S.Nonempty →
      ∃ z ∈ S, IsClosed ({z} : Set Z_bar.left) := by
    intro S hS_cl hS_ne
    let 𝒞 : Set (Set Z_bar.left) := {K | K ⊆ S ∧ IsClosed K ∧ K.Nonempty}
    obtain ⟨K₀, _, hK₀_min⟩ := zorn_superset_nonempty (S := 𝒞)
      (fun c hc_sub hc_chain hc_ne => by
        have : Nonempty ↑c := hc_ne.to_subtype
        have hdir : DirectedOn (· ⊇ ·) c := fun A hA B hB => by
          rcases hc_chain.total hA hB with hAB | hBA
          · exact ⟨A, hA, le_rfl, hAB⟩
          · exact ⟨B, hB, hBA, le_rfl⟩
        refine ⟨⋂₀ c, ⟨?_, isClosed_sInter fun U hU => (hc_sub hU).2.1, ?_⟩,
          fun U hU => Set.sInter_subset_of_mem hU⟩
        · obtain ⟨U₀, hU₀⟩ := hc_ne
          exact (Set.sInter_subset_of_mem hU₀).trans (hc_sub hU₀).1
        · exact IsCompact.nonempty_sInter_of_directed_nonempty_isCompact_isClosed hdir
            (fun U hU => (hc_sub hU).2.2)
            (fun U hU => by have := hCompactZ; exact (hc_sub hU).2.1.isCompact)
            (fun U hU => (hc_sub hU).2.1)) S ⟨le_rfl, hS_cl, hS_ne⟩
    have hK₀_mem : K₀ ∈ 𝒞 := hK₀_min.prop
    obtain ⟨z, rfl⟩ := minimal_nonempty_closed_eq_singleton hK₀_mem.2.1 hK₀_mem.2.2
      fun t ht hne hcl => le_antisymm ht (hK₀_min.le_of_le ⟨ht.trans hK₀_mem.1, hcl, hne⟩ ht)
    exact ⟨z, hK₀_mem.1 (Set.mem_singleton z), hK₀_mem.2.1⟩

  
  have hHomog2_mem_sq : ∀ {A : Type u} [CommRing A] (p : Ideal A) [p.IsPrime]
      (ψ : MvPolynomial (Fin (2 * m + 2)) k →+* A)
      (_ : ∀ i : Fin (2 * m + 2), ψ (MvPolynomial.X i) ∈ p)
      (Q : MvPolynomial (Fin (2 * m + 2)) k),
      Q ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) k 2 →
      algebraMap A (Localization.AtPrime p) (ψ Q) ∈
        (IsLocalRing.maximalIdeal (Localization.AtPrime p)) ^ 2 := by
    intro A _ p _ ψ hCenter Q hQ
    let R := Localization.AtPrime p
    let 𝔪 := IsLocalRing.maximalIdeal R
    have hX_m : ∀ i : Fin (2 * m + 2), algebraMap A R (ψ (MvPolynomial.X i)) ∈ 𝔪 := by
      intro i
      dsimp only [𝔪]
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p R]
      exact Ideal.mem_map_of_mem (algebraMap A R) (hCenter i)
    have hprod_pow : ∀ (s : Finset (Fin (2 * m + 2))) (d : Fin (2 * m + 2) →₀ ℕ),
        (∏ i ∈ s, (algebraMap A R (ψ (MvPolynomial.X i))) ^ (d i)) ∈ 𝔪 ^ (∑ i ∈ s, d i) := by
      intro s d
      induction s using Finset.induction_on with
      | empty => simp
      | @insert a s ha ih =>
        rw [Finset.prod_insert ha, Finset.sum_insert ha, pow_add]
        exact Ideal.mul_mem_mul (Ideal.pow_mem_pow (hX_m a) (d a)) ih
    rw [Q.as_sum, map_sum, map_sum]
    refine Ideal.sum_mem _ fun d hd => ?_
    have hd_deg : ∑ i : Fin (2 * m + 2), d i = 2 := by
      have h1 := (MvPolynomial.mem_homogeneousSubmodule 2 Q).mp hQ (MvPolynomial.mem_support_iff.mp hd)
      simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1
    rw [MvPolynomial.monomial_eq, map_mul, map_mul, Finsupp.prod, map_prod ψ]
    have hsub : d.support ⊆ Finset.univ := Finset.subset_univ _
    have hprod_eq : ∏ x ∈ d.support, ψ (MvPolynomial.X x ^ d x) =
        ∏ x : Fin (2 * m + 2), (ψ (MvPolynomial.X x)) ^ (d x) := by
      rw [← Finset.prod_subset hsub (fun x _ hx => by rw [Finsupp.notMem_support_iff.mp hx, pow_zero])]
      exact Finset.prod_congr rfl fun x _ => map_pow ψ _ _
    rw [hprod_eq, map_prod]
    simp only [map_pow]
    have hmem2 : (∏ x : Fin (2 * m + 2), (algebraMap A R (ψ (MvPolynomial.X x))) ^ (d x)) ∈ 𝔪 ^ 2 :=
      Eq.mp (congrArg (fun k_exp =>
        (∏ x : Fin (2 * m + 2), (algebraMap A R (ψ (MvPolynomial.X x))) ^ (d x)) ∈ 𝔪 ^ k_exp) hd_deg)
        (hprod_pow Finset.univ d)
    exact Ideal.mul_mem_left _ _ hmem2

  
  have hBasicLoc : ∀ {V : Z_bar.left.Opens} (hAff : AlgebraicGeometry.IsAffineOpen V)
      (z : Z_bar.left) (hz : z ∈ V) (h : ↑(Z_bar.left.presheaf.obj (Opposite.op V)))
      (hz' : z ∈ Z_bar.left.basicOpen h),
      let hAffW : AlgebraicGeometry.IsAffineOpen (Z_bar.left.basicOpen h) := hAff.basicOpen h
      let p := (hAff.primeIdealOf ⟨z, hz⟩).asIdeal
      let p' := (hAffW.primeIdealOf ⟨z, hz'⟩).asIdeal
      let res := (Z_bar.left.presheaf.map (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op).hom
      ∃ Φ : Localization.AtPrime p' →+* Localization.AtPrime p,
        (∀ x : ↑(Z_bar.left.presheaf.obj (Opposite.op V)),
          Φ (algebraMap _ (Localization.AtPrime p') (res x)) =
            algebraMap _ (Localization.AtPrime p) x) ∧
        (∀ w ∈ (IsLocalRing.maximalIdeal (Localization.AtPrime p')) ^ 2,
          Φ w ∈ (IsLocalRing.maximalIdeal (Localization.AtPrime p)) ^ 2) := by
    intro V hAff z hz h hz' hAffW p p' res
    let A := ↑(Z_bar.left.presheaf.obj (Opposite.op V))
    let A' := ↑(Z_bar.left.presheaf.obj (Opposite.op (Z_bar.left.basicOpen h)))
    let R := Localization.AtPrime p
    let R' := Localization.AtPrime p'
    have hp_prime : p.IsPrime := (hAff.primeIdealOf ⟨z, hz⟩).isPrime
    have hp'_prime : p'.IsPrime := (hAffW.primeIdealOf ⟨z, hz'⟩).isPrime
    have hLoc : IsLocalization.Away h A' := hAff.isLocalization_basicOpen h
    have halg_eq : ∀ x : A, algebraMap A A' x = res x := fun _ => rfl
    have hp_comap : Ideal.comap res p' = p := by
      have hmap := hAff.map_fromSpec hAffW (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op
      have hpt : (AlgebraicGeometry.Spec.map
          (Z_bar.left.presheaf.map (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op)).base
          (hAffW.primeIdealOf ⟨z, hz'⟩) = hAff.primeIdealOf ⟨z, hz⟩ := by
        apply hAff.fromSpec.isOpenEmbedding.injective
        have h1 : hAff.fromSpec.base
            ((AlgebraicGeometry.Spec.map
              (Z_bar.left.presheaf.map (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op)).base
              (hAffW.primeIdealOf ⟨z, hz'⟩)) =
            hAffW.fromSpec.base (hAffW.primeIdealOf ⟨z, hz'⟩) := by
          change (AlgebraicGeometry.Spec.map
              (Z_bar.left.presheaf.map (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op) ≫
              hAff.fromSpec).base (hAffW.primeIdealOf ⟨z, hz'⟩) = _
          rw [hmap]
        rw [IsAffineOpen.fromSpec_primeIdealOf] at h1
        exact h1.trans (IsAffineOpen.fromSpec_primeIdealOf hAff ⟨z, hz⟩).symm
      exact congrArg PrimeSpectrum.asIdeal hpt
    have hh_not_mem : h ∉ p := by
      have hz_pre : hAff.primeIdealOf ⟨z, hz⟩ ∈
          (TopologicalSpace.Opens.map hAff.fromSpec.base).obj (Z_bar.left.basicOpen h) := by
        change hAff.fromSpec.base (hAff.primeIdealOf ⟨z, hz⟩) ∈ Z_bar.left.basicOpen h
        simpa [IsAffineOpen.fromSpec_primeIdealOf] using hz'
      rw [hAff.fromSpec_preimage_basicOpen h] at hz_pre
      exact (PrimeSpectrum.mem_basicOpen h _).mp hz_pre
    have hh_unit : IsUnit (algebraMap A R h) :=
      IsLocalization.map_units R (⟨h, hh_not_mem⟩ : p.primeCompl)
    let ψ_away : A' →+* R := IsLocalization.Away.lift h hh_unit
    have hψ_res : ∀ x : A, ψ_away (res x) = algebraMap A R x :=
      fun x => IsLocalization.Away.lift_eq h hh_unit x
    have hψ_units : ∀ y : p'.primeCompl, IsUnit (ψ_away y.1) := by
      intro ⟨y, hy⟩
      obtain ⟨⟨a, n⟩, hya⟩ := @IsLocalization.surj A _ (Submonoid.powers h) A' _ _ hLoc y
      obtain ⟨k_pow, hk_pow⟩ := n.2
      have ha_eq : y * res (h ^ k_pow) = res a := by
        simpa only [← hk_pow, halg_eq] using hya
      have hres_h_not_mem : res (h ^ k_pow) ∉ p' := by
        intro hmem
        have : h ^ k_pow ∈ p := by rw [← hp_comap]; exact hmem
        exact hh_not_mem (hp_prime.mem_of_pow_mem k_pow this)
      have ha_not_mem : a ∉ p := by
        rw [← hp_comap]
        intro ha_mem
        have hprod_mem : y * res (h ^ k_pow) ∈ p' := by rw [ha_eq]; exact ha_mem
        rcases hp'_prime.mem_or_mem hprod_mem with hy' | hh'
        · exact hy hy'
        · exact hres_h_not_mem hh'
      have hprod_unit : IsUnit (ψ_away y * ψ_away (res (h ^ k_pow))) := by
        rw [← map_mul, ha_eq, hψ_res]
        exact IsLocalization.map_units R (⟨a, ha_not_mem⟩ : p.primeCompl)
      exact isUnit_of_mul_isUnit_left hprod_unit
    let Φ : R' →+* R := IsLocalization.lift hψ_units
    refine ⟨Φ, ?_, ?_⟩
    · intro x
      rw [IsLocalization.lift_eq hψ_units (res x), hψ_res x]
    · have hΦ_max : Ideal.map Φ (IsLocalRing.maximalIdeal R') ≤ IsLocalRing.maximalIdeal R := by
        rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p' R', Ideal.map_map]
        rw [Ideal.map_le_iff_le_comap]
        intro y hy
        change Φ (algebraMap A' R' y) ∈ IsLocalRing.maximalIdeal R
        rw [IsLocalization.lift_eq hψ_units y]
        obtain ⟨⟨a, n⟩, hya⟩ := @IsLocalization.surj A _ (Submonoid.powers h) A' _ _ hLoc y
        obtain ⟨k_pow, hk_pow⟩ := n.2
        have ha_eq : y * res (h ^ k_pow) = res a := by
          simpa only [← hk_pow, halg_eq] using hya
        have ha_mem : a ∈ p := by
          rw [← hp_comap]
          change res a ∈ p'
          rw [← ha_eq]
          exact p'.mul_mem_right _ hy
        have hhk_unit : IsUnit (ψ_away (res (h ^ k_pow))) := by
          rw [hψ_res, map_pow]
          exact hh_unit.pow k_pow
        have hprod_max : ψ_away y * ψ_away (res (h ^ k_pow)) ∈ IsLocalRing.maximalIdeal R := by
          rw [← map_mul, ha_eq, hψ_res, ← IsLocalization.AtPrime.map_eq_maximalIdeal p R]
          exact Ideal.mem_map_of_mem (algebraMap A R) ha_mem
        have hy_eq : ψ_away y = (ψ_away y * ψ_away (res (h ^ k_pow))) * ↑(hhk_unit.unit⁻¹) := by
          rw [mul_assoc, IsUnit.mul_val_inv, mul_one]
        rw [hy_eq]
        exact (IsLocalRing.maximalIdeal R).mul_mem_right _ hprod_max
      intro w hw
      have hw_map : Φ w ∈ Ideal.map Φ ((IsLocalRing.maximalIdeal R') ^ 2) :=
        Ideal.mem_map_of_mem Φ hw
      rw [Ideal.map_pow] at hw_map
      exact pow_le_pow_left' hΦ_max 2 hw_map

  
  obtain ⟨N, ι₀, hCl₀⟩ := hProj
  let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
