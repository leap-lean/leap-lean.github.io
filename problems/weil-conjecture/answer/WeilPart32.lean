        (PrimeSpectrum.isClosed_singleton_iff_isMaximal 𝔪).mp h𝔪_closed
      obtain ⟨a, ha_van⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp h𝔪_max
