        MvPolynomial.gradedAlgebra
      ∀ (c : Fin (M + 1) → k)
        (hFc : (∑ a : Fin (M + 1), MvPolynomial.C (c a) * MvPolynomial.X a) ∈
          MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
        (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (M + 1)) k) ∈
          MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
        (hpos : 0 < 1),
        ((AlgebraicGeometry.Proj.basicOpenIsoAway
          (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
          (MvPolynomial.X α₀) hXα hpos).hom ≫
          ι_bar.left.appLE
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α₀))
            V hVα).hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨∑ a : Fin (M + 1), MvPolynomial.C (c a) * MvPolynomial.X a, hFc⟩,
              ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩) =
          φ (MvPolynomial.C (c α₀)) +
            ∑ m' : Fin M, φ (MvPolynomial.C (c (α₀.succAbove m'))) * x_coord m')
    (hΨ : ∀ m' : Fin M, φ (Ψ m') = x_coord m')
    (hSchur : ∀ (c : Fin (M + 1) → k) (γ₀ : Fin (2 * m + 2)),
      Matrix.det (Matrix.of fun a b : Fin (s + 0 + 1) =>
        φ (MvPolynomial.pderiv
          (Fin.snoc (α := fun _ => Fin (s + 0 + (2 * m + 2)))
            (Fin.castAdd (2 * m + 2)) (Fin.natAdd (s + 0) γ₀) b)
          (Fin.snoc (α := fun _ => MvPolynomial (Fin (s + 0 + (2 * m + 2))) k)
            (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s + 0 + (2 * m + 2))) k) q Fin.elim0)
            (MvPolynomial.C (c α₀) +
              ∑ m' : Fin M, MvPolynomial.C (c (α₀.succAbove m')) * Ψ m') a))) =
        Matrix.det (Matrix.of fun a b : Fin (s + 0) =>
          φ (MvPolynomial.pderiv (Fin.castAdd (2 * m + 2) b) (Fin.addCases q Fin.elim0 a))) *
          ∑ m' : Fin M, φ (MvPolynomial.C (c (α₀.succAbove m'))) * v m' γ₀) :
    let A := ↑(Z_bar.left.presheaf.obj (Opposite.op V))
    letI : Algebra k A := (φ.comp MvPolynomial.C).toAlgebra
    let X_full : Fin (M + 1) → A := α₀.insertNth 1 x_coord
    ∃ (ψ_V : MvPolynomial (Fin (2 * m + 2)) k →+* A)
