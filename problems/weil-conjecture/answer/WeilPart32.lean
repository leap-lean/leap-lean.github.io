        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom] at h_lhs_P
    refine ⟨hAffWpb, e_pb, fun r => ConcreteCategory.congr_hom he_C_hom r, ?_⟩
    have hX : (snd_P.appLE D_b W_pb inf_le_right).hom (e_Db_cat.hom.hom Polynomial.X) =
