          (∀ (c : Fin (M + 1) → k) (hLc : L_lin c ∈ 𝒜_M 1),
            (∀ r : Fin (d + 1), ∑ μ : Fin (M + 1), ev_z (J_ch i r μ) * c μ = 0) ↔
            ∀ (α' : Fin (M + 1))
              (hXα' : (MvPolynomial.X α' : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
              (W : Z_bar.left.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W) (hzW : z ∈ W)
              (hWα' : W ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
                (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α'))),
              algebraMap _ (Localization.AtPrime (hAffW.primeIdealOf ⟨z, hzW⟩).asIdeal)
                (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M
                  (MvPolynomial.X α') hXα' zero_lt_one).hom ≫
                  ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α'))
                    W hWα').hom
                  (HomogeneousLocalization.mk ⟨1, ⟨L_lin c, hLc⟩,
                    ⟨MvPolynomial.X α', hXα'⟩, ⟨1, pow_one _⟩⟩)) ∈
                (IsLocalRing.maximalIdeal
                  (Localization.AtPrime (hAffW.primeIdealOf ⟨z, hzW⟩).asIdeal)) ^ 2)) ∧
      (∀ (z : Z_bar.left) (hz : z ∈ V i), IsClosed ({z} : Set Z_bar.left) →
        ∀ (ev_z : A_ch i →ₐ[k] k),
          RingHom.ker ev_z.toRingHom = ((hAffV i).primeIdealOf ⟨z, hz⟩).asIdeal →
          ∀ (c : Fin (M + 1) → k),
            IsEtaleLocalOdpHypersurfaceAt k m M Z_bar ι_bar (L_lin c) z ↔
            ((∀ r : Fin (d + 1), ∑ μ : Fin (M + 1), ev_z (J_ch i r μ) * c μ = 0) ∧
              Matrix.det (Matrix.of fun r₁ r₂ : Fin d =>
                ∑ μ : Fin (M + 1), c μ * ev_z (D_ch i r₂ (D_ch i r₁ (X_ch i μ)))) ≠ 0)) :=
    fun i _ => Classical.choose_spec (Classical.choose_spec (hGlobalBridge i))

  
  obtain ⟨x_init⟩ := (inferInstance : Nonempty Z_bar.left)
  obtain ⟨i₀, hx_init⟩ := hCov_top x_init trivial (fun j => Fin.elim0 j)
  letI hNe_i₀ : Nonempty (V i₀) := ⟨⟨x_init, hx_init⟩⟩
  letI : Algebra k (A_ch i₀) := alg_ch i₀
  have hDom_i₀ : IsDomain (A_ch i₀) := (hSpec_ch i₀).1
  letI : IsDomain (A_ch i₀) := hDom_i₀
  obtain ⟨𝔪₀, h𝔪₀⟩ := Ideal.exists_maximal (A_ch i₀)
  obtain ⟨ev_z₀, hKer_evz₀, hz₀, hClosed_z₀, hpz₀_eq⟩ := (hSpec_ch i₀).2.2.2.2.2.1.1 𝔪₀ h𝔪₀
  let z₀ : Z_bar.left := (hAffV i₀).fromSpec.base ⟨𝔪₀, h𝔪₀.isPrime⟩
  have hKer_z₀ : RingHom.ker ev_z₀.toRingHom = ((hAffV i₀).primeIdealOf ⟨z₀, hz₀⟩).asIdeal :=
    hKer_evz₀.trans (hpz₀_eq hz₀).symm

  have hExistsDistinctClosed : ∀ (i₁ : Fin m_charts) (z₁ : Z_bar.left),
      z₁ ∈ V i₁ → IsClosed ({z₁} : Set Z_bar.left) →
      ∃ (i₂ : Fin m_charts) (hNe₂ : Nonempty (V i₂)) (z₂ : Z_bar.left) (hz₂ : z₂ ∈ V i₂),
        letI : Algebra k (A_ch i₂) := alg_ch i₂
        IsClosed ({z₂} : Set Z_bar.left) ∧ z₂ ≠ z₁ ∧
        ∃ ev₂ : A_ch i₂ →ₐ[k] k,
          RingHom.ker ev₂.toRingHom = ((hAffV i₂).primeIdealOf ⟨z₂, hz₂⟩).asIdeal := by
    intro i₁ z₁ hz₁ _
    let Y_Z : Set (weilProjectiveSpaceOver k M).left := Set.range ι_bar.left.base
    have hClosed_YZ : IsClosed Y_Z := hCl_ι.isClosedEmbedding.isClosed_range
    have hDim_Z : topologicalKrullDim Z_bar.left = (d : WithBot ℕ∞) :=
      weil_smooth_integral_krullDim_over_field k d Z_bar hInt
    have hDim_YZ : topologicalKrullDim ↥Y_Z = (d : WithBot ℕ∞) := by
      rw [← hCl_ι.isClosedEmbedding.toIsEmbedding.toHomeomorph.isHomeomorph.topologicalKrullDim_eq]
      exact hDim_Z
    have hX_ne : (MvPolynomial.X (α₀ i₁) : MvPolynomial (Fin (M + 1)) k) ≠ 0 :=
      MvPolynomial.X_ne_zero (α₀ i₁)
    obtain ⟨⟨p₂, ⟨x₂, rfl⟩, hp₂_hyp⟩, _⟩ :=
      (weil_algClosed_proj_hyperplane_krullDim_bounds_and_ratPoint k M).1 Y_Z hClosed_YZ
        d hd (le_of_eq hDim_YZ.symm) (MvPolynomial.X (α₀ i₁)) (hX_homog (α₀ i₁)) hX_ne
    obtain ⟨i₂, hx₂⟩ := hCov_top x₂ trivial (fun j => Fin.elim0 j)
    letI hNe₂ : Nonempty (V i₂) := ⟨⟨x₂, hx₂⟩⟩
    letI : Algebra k (A_ch i₂) := alg_ch i₂
    let c_α : Fin (M + 1) → k := Pi.single (α₀ i₁) 1
    have hLc_α : L_lin c_α = MvPolynomial.X (α₀ i₁) := by
      dsimp only [L_lin]
      rw [Finset.sum_eq_single (α₀ i₁)]
      · simp [c_α]
      · intro μ _ hne; simp [c_α, Pi.single_eq_of_ne hne]
      · intro habs; exact absurd (Finset.mem_univ _) habs
    have hx₂_hyp' : ι_bar.left.base x₂ ∈ weilProjHyperplaneSet k M (L_lin c_α) := by
      rwa [hLc_α]
    have h_in_px₂ : (∑ μ : Fin (M + 1), algebraMap k (A_ch i₂) (c_α μ) * X_ch i₂ μ) ∈
        ((hAffV i₂).primeIdealOf ⟨x₂, hx₂⟩).asIdeal :=
      ((hSpec_ch i₂).2.2.2.2.1 ⟨x₂, hx₂⟩ c_α).mp hx₂_hyp'
    let 𝔭₂ := ((hAffV i₂).primeIdealOf ⟨x₂, hx₂⟩).asIdeal
    obtain ⟨𝔪₂, h𝔪₂, hle_𝔪₂⟩ :=
      Ideal.exists_le_maximal 𝔭₂ ((hAffV i₂).primeIdealOf ⟨x₂, hx₂⟩).isPrime.ne_top
    obtain ⟨ev₂, hKer_ev₂, hz₂, hCl₂, hpz₂_eq⟩ := (hSpec_ch i₂).2.2.2.2.2.1.1 𝔪₂ h𝔪₂
    let z₂ : Z_bar.left := (hAffV i₂).fromSpec.base ⟨𝔪₂, h𝔪₂.isPrime⟩
    have hz₂_hyp : ι_bar.left.base z₂ ∈ weilProjHyperplaneSet k M (MvPolynomial.X (α₀ i₁)) := by
      rw [← hLc_α]
      apply ((hSpec_ch i₂).2.2.2.2.1 ⟨z₂, hz₂⟩ c_α).mpr
      rw [hpz₂_eq hz₂]
      exact hle_𝔪₂ h_in_px₂
    have hz₁_not_hyp : ι_bar.left.base z₁ ∉ weilProjHyperplaneSet k M (MvPolynomial.X (α₀ i₁)) := by
      have hz₁_bo : ι_bar.left.base z₁ ∈
          AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X (α₀ i₁)) := hVα i₁ hz₁
      intro hmem
      exact hmem hz₁_bo
    have hz₂_ne_z₁ : z₂ ≠ z₁ := fun heq => hz₁_not_hyp (heq ▸ hz₂_hyp)
    exact ⟨i₂, hNe₂, z₂, hz₂, hCl₂, hz₂_ne_z₁, ev₂, hKer_ev₂.trans (hpz₂_eq hz₂).symm⟩

  have hTwoPtSurj : ∀ (i₁ i₂ : Fin m_charts) [Nonempty (V i₁)] [Nonempty (V i₂)]
      (z₁ z₂ : Z_bar.left) (hz₁ : z₁ ∈ V i₁) (hz₂ : z₂ ∈ V i₂),
      IsClosed ({z₁} : Set Z_bar.left) → IsClosed ({z₂} : Set Z_bar.left) → z₁ ≠ z₂ →
      letI : Algebra k (A_ch i₁) := alg_ch i₁
      letI : Algebra k (A_ch i₂) := alg_ch i₂
      ∀ (ev₁ : A_ch i₁ →ₐ[k] k) (ev₂ : A_ch i₂ →ₐ[k] k),
        RingHom.ker ev₁.toRingHom = ((hAffV i₁).primeIdealOf ⟨z₁, hz₁⟩).asIdeal →
        RingHom.ker ev₂.toRingHom = ((hAffV i₂).primeIdealOf ⟨z₂, hz₂⟩).asIdeal →
        Function.Surjective
          (Matrix.of (Fin.addCases
            (fun r μ => ev₁ (J_ch i₁ r μ))
            (fun r μ => ev₂ (J_ch i₂ r μ))) :
            Matrix (Fin ((d + 1) + (d + 1))) (Fin (M + 1)) k).mulVecLin := by
    intro i₁ i₂ _ _ z₁ z₂ hz₁ hz₂ hCl₁ hCl₂ h12 ev₁ ev₂ hKer₁ hKer₂ w_pair
    letI : Algebra k (A_ch i₁) := alg_ch i₁
    letI : Algebra k (A_ch i₂) := alg_ch i₂
    obtain ⟨ψ₁_z, hEt₁, hSp₁, hMem₁, hJet₁⟩ :=
      ((hSpec_ch i₁).2.2.2.2.2.2.1 z₁ hz₁ hCl₁ ev₁ hKer₁).1
    obtain ⟨ψ₂_z, hEt₂, hSp₂, hMem₂, hJet₂⟩ :=
      ((hSpec_ch i₂).2.2.2.2.2.2.1 z₂ hz₂ hCl₂ ev₂ hKer₂).1
    let c₁_t : k := w_pair (Fin.castAdd (d + 1) 0)
    let v₁_t : Fin d → k := fun r => w_pair (Fin.castAdd (d + 1) r.succ)
    let c₂_t : k := w_pair (Fin.natAdd (d + 1) 0)
    let v₂_t : Fin d → k := fun r => w_pair (Fin.natAdd (d + 1) r.succ)
    obtain ⟨L, hL, hMod₁, hMod₂⟩ :=
      hTwoPt_jet1 z₁ z₂ hCl₁ hCl₂ h12 (α₀ i₁) (α₀ i₂)
        (hX_homog (α₀ i₁)) (hX_homog (α₀ i₂)) (V i₁) (V i₂)
        (hAffV i₁) hz₁ (hAffV i₂) hz₂ (hVα i₁) (hVα i₂) ψ₁_z ψ₂_z
        hEt₁ hSp₁ hMem₁ hEt₂ hSp₂ hMem₂ c₁_t c₂_t v₁_t v₂_t
    obtain ⟨c, rfl⟩ := hL_mem_1_eq L hL
    obtain ⟨heq₁_0, heq₁_s⟩ := (hJet₁ c hL (hX_homog (α₀ i₁)) c₁_t v₁_t).mp hMod₁
    obtain ⟨heq₂_0, heq₂_s⟩ := (hJet₂ c hL (hX_homog (α₀ i₂)) c₂_t v₂_t).mp hMod₂
    refine ⟨c, ?_⟩
    ext idx
    refine Fin.addCases (fun r₁ => ?_) (fun r₂ => ?_) idx
    · simp only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, Matrix.of_apply,
        Fin.addCases_left]
      exact Fin.cases heq₁_0 heq₁_s r₁
    · simp only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, Matrix.of_apply,
        Fin.addCases_right]
      exact Fin.cases heq₂_0 heq₂_s r₂

  have h2d2_le : 2 * d + 2 ≤ M + 1 := by
    obtain ⟨i₂, hNe₂, z₂, hz₂, hCl₂, hz₂_ne, ev₂, hKer₂⟩ :=
      hExistsDistinctClosed i₀ z₀ hz₀ hClosed_z₀
    letI : Nonempty (V i₂) := hNe₂
    letI : Algebra k (A_ch i₂) := alg_ch i₂
    have hSurj_02 := hTwoPtSurj i₀ i₂ z₀ z₂ hz₀ hz₂ hClosed_z₀ hCl₂ hz₂_ne.symm
      ev_z₀ ev₂ hKer_z₀ hKer₂
    have hle := LinearMap.finrank_le_finrank_of_surjective hSurj_02
    rw [Module.finrank_fin_fun, Module.finrank_fin_fun] at hle
    omega
  have hdM : d + 1 ≤ M := by omega
  have hMd_sum : (d + 1) + (M - d) = M + 1 := by omega

  have hOnePtSurj : ∀ (i₁ : Fin m_charts) [Nonempty (V i₁)] (z₁ : Z_bar.left) (hz₁ : z₁ ∈ V i₁),
      IsClosed ({z₁} : Set Z_bar.left) →
      letI : Algebra k (A_ch i₁) := alg_ch i₁
      ∀ (ev₁ : A_ch i₁ →ₐ[k] k),
        RingHom.ker ev₁.toRingHom = ((hAffV i₁).primeIdealOf ⟨z₁, hz₁⟩).asIdeal →
        Function.Surjective ((J_ch i₁).map ev₁).mulVecLin := by
    intro i₁ _ z₁ hz₁ hCl₁ ev₁ hKer₁ w
    letI : Algebra k (A_ch i₁) := alg_ch i₁
    obtain ⟨i₂, hNe₂, z₂, hz₂, hCl₂, hz₂_ne, ev₂, hKer₂⟩ :=
      hExistsDistinctClosed i₁ z₁ hz₁ hCl₁
    letI : Nonempty (V i₂) := hNe₂
    letI : Algebra k (A_ch i₂) := alg_ch i₂
    have hSurj_12 := hTwoPtSurj i₁ i₂ z₁ z₂ hz₁ hz₂ hCl₁ hCl₂ hz₂_ne.symm ev₁ ev₂ hKer₁ hKer₂
    obtain ⟨c, hc⟩ := hSurj_12 (Fin.addCases w (fun _ => 0))
    refine ⟨c, ?_⟩
    ext r
    have hr := congrFun hc (Fin.castAdd (d + 1) r)
    simpa [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct] using hr

  
  obtain ⟨L₀_odp, hL₀_hom, _, hOdp_z₀⟩ := hOdp_wit z₀ hClosed_z₀
  obtain ⟨c₀, rfl⟩ := hL_mem_1_eq L₀_odp hL₀_hom
  obtain ⟨hCrit_c₀, hHess_c₀⟩ :=
    ((hSpec_ch i₀).2.2.2.2.2.2.2 z₀ hz₀ hClosed_z₀ ev_z₀ hKer_z₀ c₀).mp hOdp_z₀
  obtain ⟨S₀, hS₀_card, hS₀_det⟩ :=
    hPivotMinor (d + 1) (M + 1) ((J_ch i₀).map ev_z₀)
      (hOnePtSurj i₀ z₀ hz₀ hClosed_z₀ ev_z₀ hKer_z₀)
  obtain ⟨e_col₀, e_sub₀, he_col₀_inl⟩ := hFinsetSplit hMd_sum S₀ hS₀_card
  let M_piv₀_A : Matrix (Fin (d + 1)) (Fin (d + 1)) (A_ch i₀) :=
    Matrix.of fun r s => J_ch i₀ r (e_col₀ (Sum.inl s))
  let δ₀ : A_ch i₀ := M_piv₀_A.det
  have hev_δ₀_ne : ev_z₀ δ₀ ≠ 0 := by
    have hmap : ev_z₀.toRingHom.mapMatrix M_piv₀_A =
        Matrix.of fun r s => ((J_ch i₀).map ev_z₀) r (e_sub₀ s).1 := by
      ext r s
      simp [M_piv₀_A, he_col₀_inl]
    change ev_z₀.toRingHom M_piv₀_A.det ≠ 0
    rw [RingHom.map_det, hmap]
    exact hS₀_det e_sub₀
  have hδ₀_ne : δ₀ ≠ 0 := fun h0 => hev_δ₀_ne (by rw [h0, map_zero])

  let B₀ := Localization.Away δ₀
  obtain ⟨hDom_B₀, hTr_B₀⟩ := hAwayDomTrdeg (hSpec_ch i₀).2.2.1 δ₀ hδ₀_ne
  letI : IsDomain B₀ := hDom_B₀
  have hFT_A₀ : Algebra.FiniteType k (A_ch i₀) := (hSpec_ch i₀).2.1
  letI : Algebra.FiniteType k (A_ch i₀) := hFT_A₀
  have hFP_B₀ : Algebra.FinitePresentation (A_ch i₀) B₀ :=
    IsLocalization.Away.finitePresentation δ₀
  letI : Algebra.FinitePresentation (A_ch i₀) B₀ := hFP_B₀
  have hFT_B₀ : Algebra.FiniteType k B₀ :=
    Algebra.FiniteType.trans (R := k) (S := A_ch i₀) (A := B₀) inferInstance inferInstance
  letI : Algebra.FiniteType k B₀ := hFT_B₀

  choose D₀ hD₀_alg using fun r : Fin d => hExistsDerivAway δ₀ hδ₀_ne (D_ch i₀ r)
  let X₀ : Fin (M + 1) → B₀ := fun μ => algebraMap (A_ch i₀) B₀ (X_ch i₀ μ)
  let ev₀ : B₀ →ₐ[k] k :=
    IsLocalization.liftAlgHom (M := Submonoid.powers δ₀) (S := B₀) (f := ev_z₀)
      (by
        rintro ⟨_, n, rfl⟩
        rw [map_pow]
        exact (IsUnit.mk0 _ hev_δ₀_ne).pow n)
  have hev₀_alg : ∀ a : A_ch i₀, ev₀ (algebraMap (A_ch i₀) B₀ a) = ev_z₀ a := fun a => by
    change (IsLocalization.lift _ : B₀ →+* k) (algebraMap (A_ch i₀) B₀ a) = ev_z₀ a
    exact IsLocalization.lift_eq _ a
  have hJ₀_eq : ∀ (r : Fin (d + 1)) (μ : Fin (M + 1)),
      Matrix.of (Fin.cases X₀ (fun i μ' => D₀ i (X₀ μ'))) r μ =
        algebraMap (A_ch i₀) B₀ (J_ch i₀ r μ) := by
    refine Fin.cases (fun μ => rfl) (fun i μ => ?_)
    dsimp only [J_ch]
    simp only [Matrix.of_apply, Fin.cases_succ, X₀]
    exact hD₀_alg i (X_ch i₀ μ)
  let M_piv₀ : Matrix (Fin (d + 1)) (Fin (d + 1)) B₀ :=
    Matrix.of fun r s => Matrix.of (Fin.cases X₀ (fun i μ => D₀ i (X₀ μ))) r (e_col₀ (Sum.inl s))
  have hMpiv₀_det : M_piv₀.det = algebraMap (A_ch i₀) B₀ δ₀ := by
    have hmat : M_piv₀ = (algebraMap (A_ch i₀) B₀).mapMatrix M_piv₀_A := by
      ext r s
      simp [M_piv₀, M_piv₀_A, hJ₀_eq]
    rw [hmat, RingHom.map_det]
  have hUnit_Mpiv₀ : IsUnit M_piv₀.det := by
    rw [hMpiv₀_det]
    exact IsLocalization.Away.algebraMap_isUnit δ₀
  have hCrit_B₀ : ∀ r : Fin (d + 1),
      ∑ μ : Fin (M + 1),
        ev₀ (Matrix.of (Fin.cases X₀ (fun i μ => D₀ i (X₀ μ))) r μ) * c₀ μ = 0 := by
    intro r
    simp_rw [hJ₀_eq, hev₀_alg]
    exact hCrit_c₀ r
  have hHess_B₀ : Matrix.det (Matrix.of fun i j : Fin d =>
      ∑ μ : Fin (M + 1), c₀ μ * ev₀ (D₀ j (D₀ i (X₀ μ)))) ≠ 0 := by
    have h2 : ∀ (i j : Fin d) (μ : Fin (M + 1)),
        ev₀ (D₀ j (D₀ i (X₀ μ))) = ev_z₀ (D_ch i₀ j (D_ch i₀ i (X_ch i₀ μ))) := by
      intro i j μ
      dsimp only [X₀]
      rw [hD₀_alg, hD₀_alg, hev₀_alg]
    simp_rw [h2]
    exact hHess_c₀

  obtain ⟨D_amb, P_amb, E₀, Q₀, hD_amb, hP_homog, hP_irred, hKer_Φ₀,
    hQ₀_homog, hndvd_Q₀, hOdp_lift, hUnivElim⟩ :=
    weil_algClosed_conormal_ufd_dual_poly_and_eliminant k d M hd hdM B₀ hTr_B₀ D₀ X₀
      e_col₀ ev₀ c₀ hUnit_Mpiv₀ hCrit_B₀ hHess_B₀

  let J₀_B : Matrix (Fin (d + 1)) (Fin (M + 1)) B₀ :=
    Matrix.of (Fin.cases X₀ (fun i μ => D₀ i (X₀ μ)))
  let J_free₀ : Matrix (Fin (d + 1)) (Fin (M - d)) B₀ :=
    Matrix.of fun r a => J₀_B r (e_col₀ (Sum.inr a))
  let Φ₀ : MvPolynomial (Fin (M + 1)) k →ₐ[k] MvPolynomial (Fin (M - d)) B₀ :=
    MvPolynomial.aeval (fun μ =>
      Sum.elim
        (fun s => - ∑ a : Fin (M - d),
          MvPolynomial.C (((Ring.inverse M_piv₀.det • M_piv₀.adjugate) * J_free₀) s a) *
            MvPolynomial.X a)
        MvPolynomial.X (e_col₀.symm μ))
  have hΦ₀_Pamb : Φ₀ P_amb = 0 := by
    have hmem : P_amb ∈ RingHom.ker Φ₀.toRingHom := by
      rw [hKer_Φ₀]
      exact Ideal.subset_span (Set.mem_singleton P_amb)
    exact hmem

  
  let n_free : ℕ := (M + 1) - (2 * d + 2)
  have h_nfree : (2 * d + 2) + n_free = M + 1 := by omega
  let Idx_btg := Fin m_charts × Fin m_charts × { S : Finset (Fin (M + 1)) // S.card = 2 * d + 2 }
  have hBtgElim : ∀ α : Idx_btg,
      ∃ (E_α : ℕ) (Q_α : MvPolynomial (Fin (M + 1)) k),
        Q_α ∈ 𝒜_M E_α ∧ ¬ (P_amb ∣ Q_α) ∧
        ∀ (_ : Nonempty (V α.1)) (_ : Nonempty (V α.2.1)),
          letI : Algebra k (A_ch α.1) := alg_ch α.1
          letI : Algebra k (A_ch α.2.1) := alg_ch α.2.1
          ∀ (ev₁ : A_ch α.1 →ₐ[k] k) (ev₂ : A_ch α.2.1 →ₐ[k] k) (c : Fin (M + 1) → k),
            (∀ r : Fin (d + 1), ∑ μ : Fin (M + 1), ev₁ (J_ch α.1 r μ) * c μ = 0) →
            (∀ r : Fin (d + 1), ∑ μ : Fin (M + 1), ev₂ (J_ch α.2.1 r μ) * c μ = 0) →
            (∀ e : Fin (2 * d + 2) ≃ ↥α.2.2.1,
              (Matrix.of fun (r : Fin (2 * d + 2)) (s : Fin (2 * d + 2)) =>
                (Matrix.of (Fin.addCases
                  (fun r₁ μ => ev₁ (J_ch α.1 r₁ μ))
                  (fun r₂ μ => ev₂ (J_ch α.2.1 r₂ μ))) :
                  Matrix (Fin ((d + 1) + (d + 1))) (Fin (M + 1)) k)
                  (finCongr (by omega : 2 * d + 2 = (d + 1) + (d + 1)) r) (e s).1).det ≠ 0) →
            MvPolynomial.eval c Q_α = 0 := by
    rintro ⟨i₁, i₂, S_sub, hS_card⟩
    dsimp only []
    by_cases hNe : Nonempty (V i₁) ∧ Nonempty (V i₂)
    · rcases hNe with ⟨hNe₁, hNe₂⟩
      letI : Nonempty (V i₁) := hNe₁
      letI : Nonempty (V i₂) := hNe₂
      letI : Algebra k (A_ch i₁) := alg_ch i₁
      letI : Algebra k (A_ch i₂) := alg_ch i₂
      have hDom₁ : IsDomain (A_ch i₁) := (hSpec_ch i₁).1
      have hFT₁ : Algebra.FiniteType k (A_ch i₁) := (hSpec_ch i₁).2.1
      have hDom₂ : IsDomain (A_ch i₂) := (hSpec_ch i₂).1
      have hFT₂ : Algebra.FiniteType k (A_ch i₂) := (hSpec_ch i₂).2.1
      letI : IsDomain (A_ch i₁) := hDom₁
      letI : Algebra.FiniteType k (A_ch i₁) := hFT₁
      letI : IsDomain (A_ch i₂) := hDom₂
      letI : Algebra.FiniteType k (A_ch i₂) := hFT₂
      obtain ⟨hDom_C₁₂, hTr_C₁₂⟩ :=
        hTensorDomTrdeg (A_ch i₁) (A_ch i₂) (hSpec_ch i₁).2.2.1 (hSpec_ch i₂).2.2.1
      let C₁₂ := TensorProduct k (A_ch i₁) (A_ch i₂)
      letI : IsDomain C₁₂ := hDom_C₁₂
      let inlC : A_ch i₁ →ₐ[k] C₁₂ := Algebra.TensorProduct.includeLeft
      let inrC : A_ch i₂ →ₐ[k] C₁₂ := Algebra.TensorProduct.includeRight
      let e_row : Fin (2 * d + 2) ≃ Fin ((d + 1) + (d + 1)) := finCongr (by omega)
      let J_pair : Matrix (Fin (2 * d + 2)) (Fin (M + 1)) C₁₂ :=
        Matrix.of fun r μ =>
          Fin.addCases
            (fun r₁ => inlC (J_ch i₁ r₁ μ))
            (fun r₂ => inrC (J_ch i₂ r₂ μ))
            (e_row r)
