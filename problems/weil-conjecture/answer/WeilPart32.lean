    have h_ideal_p : ∀ (F : MvPolynomial (Fin 3) k) (d : ℕ),
        F ∈ 𝒜_2 d →
        (F ∈ ProjectiveSpectrum.asHomogeneousIdeal (ι_line.left.base (j_aff.base p)) ↔
          q_poly F ∈ p.asIdeal) := by
      intro F d hF
      rw [hIdeal_line (j_aff.base p) F d hF, hπ₀_eq,
        hIdeal_jaff p (π₀ F) d (hπ₀_homog hF), hEval_aff_π₀]
    by_cases hp_bot : p.asIdeal = ⊥
    · have h_not_compl : j_aff.base p ∉ (U₀ : Set _)ᶜ := by
        rw [h_jaff_compl]; rintro ⟨a, _, hmem⟩
        rw [hp_bot, Ideal.mem_bot] at hmem; exact Polynomial.X_sub_C_ne_zero a hmem
      have h_not_pre : j_aff.base p ∉ ι_line.left.base ⁻¹' (Set.range ι_disc.left.base) := by
        rw [Set.mem_preimage, hRange_disc, h_ideal_p P_disc D_disc hP_homog, hp_bot, Ideal.mem_bot]
        intro hq0; have hev := hEval_qpoly 0 P_disc
        rw [hq0, Polynomial.eval_zero] at hev; exact hEval_100 hev.symm
      exact ⟨⟨fun h => absurd h h_not_pre, fun h => absurd h h_not_compl⟩,
        fun h => absurd h h_not_compl⟩
    · obtain ⟨g_raw, hg_raw⟩ := IsPrincipalIdealRing.principal p.asIdeal
      let g : Polynomial k := g_raw
      have hg_span : p.asIdeal = Ideal.span {g} := hg_raw
      have hg_ne : g ≠ 0 := by
        intro hg0; apply hp_bot; rw [hg_span, hg0, Ideal.span_singleton_eq_bot]
      have hp_prime : (Ideal.span {g}).IsPrime := hg_span ▸ p.isPrime
      have hg_prime : Prime g := (Ideal.span_singleton_prime hg_ne).mp hp_prime
      have hg_irred : Irreducible g := hg_prime.irreducible
      have hg_deg_ne : g.degree ≠ 0 := by
        intro hdeg0; have hgC := Polynomial.eq_C_of_degree_eq_zero hdeg0
        have hc_ne : g.coeff 0 ≠ 0 := by
          intro hc0; apply hg_ne; rw [hgC, hc0, map_zero]
        exact hg_irred.not_isUnit (hgC ▸ Polynomial.isUnit_C.mpr (IsUnit.mk0 _ hc_ne))
      obtain ⟨b, hb_root⟩ := IsAlgClosed.exists_root g hg_deg_ne
      obtain ⟨u, hu_eq⟩ := Polynomial.dvd_iff_isRoot.mpr hb_root
      have hu_unit : IsUnit u :=
        (hg_irred.isUnit_or_isUnit hu_eq).resolve_left (Polynomial.not_isUnit_X_sub_C b)
      have hp_span_b : p.asIdeal = Ideal.span {Polynomial.X - Polynomial.C b} := by
        rw [hg_span, hu_eq, Ideal.span_singleton_mul_right_unit hu_unit]
      have h_mem_p : ∀ f : Polynomial k, f ∈ p.asIdeal ↔ f.eval b = 0 := by
        intro f
        rw [hp_span_b, Ideal.mem_span_singleton, Polynomial.dvd_iff_isRoot, Polynomial.IsRoot.def]
      have h_compl_iff : j_aff.base p ∈ (U₀ : Set _)ᶜ ↔ b ∈ S_aff := by
        rw [h_jaff_compl]
        constructor
        · rintro ⟨a, ha, hmem⟩
          rw [h_mem_p, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C,
            sub_eq_zero] at hmem; rwa [hmem]
        · intro hb; refine ⟨b, hb, ?_⟩
          rw [h_mem_p, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self]
      have h_ideal_b : ∀ (F : MvPolynomial (Fin 3) k) (d : ℕ),
          F ∈ 𝒜_2 d →
          (F ∈ ProjectiveSpectrum.asHomogeneousIdeal (ι_line.left.base (j_aff.base p)) ↔
            MvPolynomial.eval ![1, b, 0] F = 0) := by
        intro F d hF; rw [h_ideal_p F d hF, h_mem_p, hEval_qpoly]
      have h_pre_iff :
          j_aff.base p ∈ ι_line.left.base ⁻¹' (Set.range ι_disc.left.base) ↔ b ∈ S_aff := by
        rw [Set.mem_preimage, hRange_disc, h_ideal_b P_disc D_disc hP_homog, hRoots_aff]
      refine ⟨h_pre_iff.trans h_compl_iff.symm, ?_⟩
      intro h_in_compl
      have hb_mem : b ∈ S_aff := h_compl_iff.mp h_in_compl
      have hP_in : P_disc ∈
          ProjectiveSpectrum.asHomogeneousIdeal (ι_line.left.base (j_aff.base p)) :=
        (h_ideal_b P_disc D_disc hP_homog).mpr ((hRoots_aff b).mpr hb_mem)
      have ht_ne : (![1, b] : Fin 2 → k) ≠ 0 := fun h0 => one_ne_zero (congrFun h0 0)
      have h_not_bad : ι_line.left.base (j_aff.base p) ∉ F_bad_plane :=
        hAvoid_line ![1, b] (ι_line.left.base (j_aff.base p)) ht_ne h_ideal_b
      have h_pderiv_not : MvPolynomial.pderiv (1 : Fin 3) P_disc ∉
          ProjectiveSpectrum.asHomogeneousIdeal (ι_line.left.base (j_aff.base p)) := by
        rw [h_ideal_b _ (D_disc - 1) (hPderiv_homog 1)]; exact hPderiv_aff b hb_mem
      rw [hImg_reg]; exact ⟨hP_in, h_not_bad, 1, h_pderiv_not⟩
  refine ⟨U₀, C_disc, ι_disc, U_disc_reg, hHyp_disc, hInt_disc, hProp_disc,
    hNe_reg, hSm_reg, hU₀_eq, ?_, ?_, hClosed_pts⟩
  · ext q
    by_cases hq : q ∈ Set.range j_aff.base
    · rcases hq with ⟨p, rfl⟩; exact (hAff_props p).1
    · have hq_inf : q ∈ Set.range s_inf.base := by
        rw [← hCoord_line.2.2.2.2.1]; exact hq
      rcases hq_inf with ⟨pt, rfl⟩
      exact ⟨fun _ => (hInf_props pt).1, fun _ => (hInf_props pt).2.1⟩
  · rintro _ ⟨q, hq_compl, rfl⟩
    by_cases hq : q ∈ Set.range j_aff.base
    · rcases hq with ⟨p, rfl⟩; exact (hAff_props p).2 hq_compl
    · have hq_inf : q ∈ Set.range s_inf.base := by
        rw [← hCoord_line.2.2.2.2.1]; exact hq
      rcases hq_inf with ⟨pt, rfl⟩; exact (hInf_props pt).2.2

theorem weil_algClosed_smooth_chart_jet1_and_etale_odp_bridge (k : Type u) [Field k] [IsAlgClosed k] (m M s : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (α₀ : Fin (M + 1)) (V : Z_bar.left.Opens)
    (hAffV : AlgebraicGeometry.IsAffineOpen V) [Nonempty V]
    (hVα : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
        MvPolynomial.gradedAlgebra
      V ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α₀)))
    (φ : MvPolynomial (Fin (s + 0 + (2 * m + 2))) k →+* ↑(Z_bar.left.presheaf.obj (Opposite.op V)))
