      let w_FZ : Fin (M + 1) → MvPolynomial (Fin (M - d)) F_Z :=
        fun μ => MvPolynomial.map τ_i (Φ_i (MvPolynomial.X μ))
      have hw_ann_i : ∀ r : Fin (d + 1),
          ∑ μ : Fin (M + 1), MvPolynomial.C (σ_i (J_ch i r μ)) * w_FZ μ = 0 := by
        intro r
        have hm := congrArg (MvPolynomial.map τ_i) (hΦi_ann r)
        rw [map_sum, map_zero] at hm
        refine Eq.trans ?_ hm
        refine Finset.sum_congr rfl fun μ _ => ?_
        rw [map_mul, MvPolynomial.map_C]
        change MvPolynomial.C (σ_i (J_ch i r μ)) * w_FZ μ =
          MvPolynomial.C (τ_i (algebraMap (A_ch i) B_i (J_ch i r μ))) * w_FZ μ
        rw [hτi_alg]
      have hw_ann_0 : ∀ r : Fin (d + 1),
          ∑ μ : Fin (M + 1), (MvPolynomial.C.comp τ_0) (J₀_B r μ) * w_FZ μ = 0 := by
        intro r
        have hrow : ∀ μ : Fin (M + 1),
            ((MvPolynomial.C.comp τ_0) (J₀_B r μ) : MvPolynomial (Fin (M - d)) F_Z) =
            ∑ s_r : Fin (d + 1), MvPolynomial.C (T_mat r s_r) *
              MvPolynomial.C (σ_i (J_ch i s_r μ)) := by
          intro μ
          dsimp only [J₀_B]
          simp only [RingHom.comp_apply, hJ₀_eq, hτ0_alg, ← map_mul, ← map_sum]
          congr 1
          have hentry := congrFun (congrFun hT_mat r) μ
          rw [Matrix.map_apply, Matrix.mul_apply] at hentry
          simp only [Matrix.map_apply] at hentry
          exact hentry
        simp_rw [hrow, Finset.sum_mul]
        rw [Finset.sum_comm]
        refine Finset.sum_eq_zero fun s_r _ => ?_
        simp_rw [mul_assoc, ← Finset.mul_sum, hw_ann_i s_r, mul_zero]

      obtain ⟨_, _, hΦ0_uniq⟩ := hCramer J₀_B e_col₀ hUnit_Mpiv₀
      let θ_FZ : MvPolynomial (Fin (M - d)) B₀ →+* MvPolynomial (Fin (M - d)) F_Z :=
        MvPolynomial.eval₂Hom (MvPolynomial.C.comp τ_0) (fun a => w_FZ (e_col₀ (Sum.inr a)))
      have h_hom_eq : (MvPolynomial.map τ_i).comp Φ_i.toRingHom = θ_FZ.comp Φ₀.toRingHom := by
        apply MvPolynomial.ringHom_ext
        · intro r
          rw [RingHom.comp_apply, RingHom.comp_apply]
          change MvPolynomial.map τ_i (Φ_i (MvPolynomial.C r)) = θ_FZ (Φ₀ (MvPolynomial.C r))
          dsimp only [Φ_i, Φ₀, θ_FZ]
          rw [MvPolynomial.aeval_C, MvPolynomial.aeval_C,
            IsScalarTower.algebraMap_apply k B_i (MvPolynomial (Fin (M - d)) B_i) r,
            IsScalarTower.algebraMap_apply k B₀ (MvPolynomial (Fin (M - d)) B₀) r,
            MvPolynomial.algebraMap_eq, MvPolynomial.algebraMap_eq,
            MvPolynomial.map_C, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
          have hi_r : algebraMap k B_i r = algebraMap (A_ch i) B_i (((φ i).comp MvPolynomial.C) r) :=
            IsScalarTower.algebraMap_apply k (A_ch i) B_i r
          have h0_r : algebraMap k B₀ r = algebraMap (A_ch i₀) B₀ (((φ i₀).comp MvPolynomial.C) r) :=
            IsScalarTower.algebraMap_apply k (A_ch i₀) B₀ r
          rw [hi_r, h0_r, hτi_alg, hτ0_alg]
          exact congrArg MvPolynomial.C (RingHom.congr_fun hκ_eq r)
        · intro μ
          rw [RingHom.comp_apply, RingHom.comp_apply]
          symm
          exact hΦ0_uniq (MvPolynomial.C.comp τ_0) w_FZ hw_ann_0 μ
      have hΦi_FZ : MvPolynomial.map τ_i (Φ_i P_amb) = 0 := by
        have h1 := RingHom.congr_fun h_hom_eq P_amb
        change MvPolynomial.map τ_i (Φ_i P_amb) = θ_FZ (Φ₀ P_amb) at h1
        rw [hΦ₀_Pamb, map_zero] at h1
        exact h1
      have hΦi_Pamb : Φ_i P_amb = 0 :=
        MvPolynomial.map_injective τ_i hτi_inj (hΦi_FZ.trans (map_zero _).symm)

      let ev_Bi : B_i →ₐ[k] k :=
        IsLocalization.liftAlgHom (M := Submonoid.powers δ_i) (S := B_i) (f := ev_z)
          (by
            rintro ⟨_, n, rfl⟩
            rw [map_pow]
            exact (IsUnit.mk0 _ hev_δi_ne).pow n)
      have hev_Bi_alg : ∀ a : A_ch i, ev_Bi (algebraMap (A_ch i) B_i a) = ev_z a :=
        fun a => IsLocalization.lift_eq _ a
      have hCrit_Bi : ∀ r : Fin (d + 1),
          ∑ μ : Fin (M + 1), ev_Bi (J_Bi r μ) * c μ = 0 := by
        intro r
        simpa only [J_Bi, Matrix.map_apply, hev_Bi_alg] using hCrit_i r
      have hX_ev_i := hΦi_uniq ev_Bi.toRingHom c hCrit_Bi
      let θ_evi : MvPolynomial (Fin (M - d)) B_i →+* k :=
        MvPolynomial.eval₂Hom ev_Bi.toRingHom (fun a => c (e_col_i (Sum.inr a)))
      have hcomp_evi : θ_evi.comp Φ_i.toRingHom = MvPolynomial.eval c := by
        apply MvPolynomial.ringHom_ext
        · intro r
          rw [RingHom.comp_apply, MvPolynomial.eval_C]
          change θ_evi (Φ_i (MvPolynomial.C r)) = r
          dsimp only [Φ_i, θ_evi]
          rw [MvPolynomial.aeval_C,
            IsScalarTower.algebraMap_apply k B_i (MvPolynomial (Fin (M - d)) B_i) r,
            MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C]
          exact ev_Bi.commutes r
        · intro μ
          rw [RingHom.comp_apply, MvPolynomial.eval_X]
          exact hX_ev_i μ
      have hEval0 : MvPolynomial.eval c P_amb = 0 := by
        rw [← hcomp_evi]
        change θ_evi (Φ_i P_amb) = 0
        rw [hΦi_Pamb, map_zero]
      exact hc_eval_ne hEval0
    obtain ⟨γ₀, hγ₀⟩ := hex_γ₀
    refine ⟨α₀ i, V i, hAffV i, hxV, le_top, hVα i, s i, φ i, q i, Fin.elim0, f_new_i, γ₀,
      hSurj_i, hSpec_i, hKer_i, fun j => Fin.elim0 j, hf_new_eq, hDet0_i, hγ₀⟩

  
  · intro c hc_ne hc_evalP hq_avoid
    have hQtot_ne : MvPolynomial.eval c Q_tot ≠ 0 := hF_avoid_Qtot c hc_ne hc_evalP hq_avoid
    simp only [Q_tot, map_mul, map_prod] at hQtot_ne
    have hQ₀_ne : MvPolynomial.eval c Q₀ ≠ 0 := left_ne_zero_of_mul hQtot_ne
    have hProd_ne : (∏ α : Idx_btg, MvPolynomial.eval c (Q_btg α)) ≠ 0 :=
      right_ne_zero_of_mul hQtot_ne
    have hQbtg_ne : ∀ α : Idx_btg, MvPolynomial.eval c (Q_btg α) ≠ 0 := fun α h0 =>
      hProd_ne (Finset.prod_eq_zero (Finset.mem_univ α) h0)

    
    obtain ⟨ev_c, hCrit_evc, hHess_evc⟩ := hOdp_lift c hc_ne hc_evalP hQ₀_ne
    let ev_zc : A_ch i₀ →ₐ[k] k := ev_c.comp (IsScalarTower.toAlgHom k (A_ch i₀) B₀)
    have hev_zc_surj : Function.Surjective ev_zc.toRingHom := fun a =>
      ⟨algebraMap k (A_ch i₀) a, ev_zc.commutes a⟩
    have h𝔪_zc : (RingHom.ker ev_zc.toRingHom).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective ev_zc.toRingHom hev_zc_surj
    obtain ⟨_, _, hz_c, hClosed_zc, hp_zc_eq⟩ :=
      (hSpec_ch i₀).2.2.2.2.2.1.1 (RingHom.ker ev_zc.toRingHom) h𝔪_zc
    let z_c : Z_bar.left :=
      (hAffV i₀).fromSpec.base ⟨RingHom.ker ev_zc.toRingHom, h𝔪_zc.isPrime⟩
    have hKer_zc : RingHom.ker ev_zc.toRingHom = ((hAffV i₀).primeIdealOf ⟨z_c, hz_c⟩).asIdeal :=
      (hp_zc_eq hz_c).symm
    have hev_zc_eq : ∀ a : A_ch i₀, ev_c (algebraMap (A_ch i₀) B₀ a) = ev_zc a := fun _ => rfl
    have hCrit_zc : ∀ r : Fin (d + 1), ∑ μ : Fin (M + 1), ev_zc (J_ch i₀ r μ) * c μ = 0 := by
      intro r
      simpa only [hJ₀_eq, hev_zc_eq] using hCrit_evc r
    have hHess_zc : Matrix.det (Matrix.of fun r₁ r₂ : Fin d =>
        ∑ μ : Fin (M + 1), c μ * ev_zc (D_ch i₀ r₂ (D_ch i₀ r₁ (X_ch i₀ μ)))) ≠ 0 := by
      have h2 : ∀ (r₁ r₂ : Fin d) (μ : Fin (M + 1)),
          ev_c (D₀ r₂ (D₀ r₁ (X₀ μ))) = ev_zc (D_ch i₀ r₂ (D_ch i₀ r₁ (X_ch i₀ μ))) := by
        intro r₁ r₂ μ
        dsimp only [X₀, ev_zc]
        rw [hD₀_alg, hD₀_alg]
        rfl
      simpa only [h2] using hHess_evc
    have hOdp_zc : IsEtaleLocalOdpHypersurfaceAt k m M Z_bar ι_bar (L_lin c) z_c :=
      ((hSpec_ch i₀).2.2.2.2.2.2.2 z_c hz_c hClosed_zc ev_zc hKer_zc c).mpr ⟨hCrit_zc, hHess_zc⟩

    
    let U_c : Z_bar.left.Opens := ⟨{z_c}ᶜ, hClosed_zc.isOpen_compl⟩
    refine ⟨z_c, hClosed_zc, hOdp_zc, ?_⟩
    have hSm_Uc : AlgebraicGeometry.SmoothOfRelativeDimension d (U_c.ι ≫ Z_bar.hom) := by
      simpa only [Nat.zero_add] using
        (inferInstance : AlgebraicGeometry.SmoothOfRelativeDimension (0 + d) (U_c.ι ≫ Z_bar.hom))
    have hSlice0_Uc : IsTransversalLinearSlice k M Z_bar ι_bar U_c d 0 Fin.elim0 :=
      weil_bertini_transversalLinearSlice_init_zero k M Z_bar ι_bar hCl_ι U_c d hSm_Uc
    have hPkg_Uc :=
      weil_bertini_scheme_chart_cover_and_advance k M Z_bar ι_bar hCl_ι U_c d 0 Fin.elim0 hSlice0_Uc
    obtain ⟨m_Uc, α_Uc, V_Uc, hAff_Uc, hLe_Uc, hVα_Uc, s_Uc, φ_Uc, q_Uc, f_lift_Uc,
      x_Uc, P_h_Uc, hCov_Uc, hCharts_Uc⟩ := hPkg_Uc.1
    have hsnoc_eq : Fin.snoc (α := fun _ => MvPolynomial (Fin (M + 1)) k) Fin.elim0 (L_lin c) =
        ![L_lin c] := by
      ext j; fin_cases j; rfl
    have hd_sub : d - 1 = 2 * m + 1 := by omega
    rw [← hsnoc_eq, ← hd_sub]
    refine hPkg_Uc.2 hd (L_lin c) (hL_lin_homog c) ?_
    intro x hxUc _ hxHyp
    obtain ⟨j, hxV_Uc⟩ := hCov_Uc x hxUc (fun r => Fin.elim0 r)
    obtain ⟨hSurj_j, hSpec_j, hKer_j, _, hDet0_j, hDet00_j, hUnitPh_j, hLocPh_j, hLin_j, _⟩ :=
      hCharts_Uc j
    have hf0_j : f_lift_Uc j = Fin.elim0 := Subsingleton.elim _ _
    rw [hf0_j] at hDet00_j
    obtain ⟨Ψ_j, v_j, _, hΨ_j, _, hSch_j⟩ :=
      weil_bertini_tangent_frame_and_schur_det k M (s_Uc j) 0 d _ (φ_Uc j) hSurj_j (q_Uc j)
        hKer_j Fin.elim0 hDet00_j (α_Uc j) (x_Uc j) (P_h_Uc j) hUnitPh_j hLocPh_j
    let f_new_j : MvPolynomial (Fin (s_Uc j + 0 + d)) k :=
      MvPolynomial.C (c (α_Uc j)) +
        ∑ m' : Fin M, MvPolynomial.C (c ((α_Uc j).succAbove m')) * Ψ_j m'
    have hf_new_j_eq : ∀ (hFn : L_lin c ∈ 𝒜_M 1)
        (hXα : (MvPolynomial.X (α_Uc j) : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1) (hpos : 0 < 1),
        (φ_Uc j) f_new_j =
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X (α_Uc j)) hXα hpos).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X (α_Uc j)))
              (V_Uc j) (hVα_Uc j)).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨L_lin c, hFn⟩, ⟨MvPolynomial.X (α_Uc j), hXα⟩, ⟨1, pow_one _⟩⟩) := by
      intro hFn hXα hpos
      rw [hLin_j c hFn hXα hpos]
      dsimp only [f_new_j]
      simp only [map_add, map_sum, map_mul, hΨ_j]
    have hex_γ₀ : ∃ γ₀ : Fin d,
        Matrix.det (Matrix.of fun a b : Fin (s_Uc j + 0 + 1) =>
          (φ_Uc j) (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin (s_Uc j + 0 + d))
              (Fin.castAdd d) (Fin.natAdd (s_Uc j + 0) γ₀) b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin (s_Uc j + 0 + d)) k)
              (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s_Uc j + 0 + d)) k)
                (q_Uc j) Fin.elim0)
              f_new_j a))) ∉ ((hAff_Uc j).primeIdealOf ⟨x, hxV_Uc⟩).asIdeal := by
      by_contra h_none
      rw [not_exists] at h_none
      have hAllDet : ∀ γ₀ : Fin d, _ ∈ ((hAff_Uc j).primeIdealOf ⟨x, hxV_Uc⟩).asIdeal :=
        fun γ₀ => not_not.mp (h_none γ₀)
      obtain ⟨z', hz'_Uc, hCl_z', _, _, _, _, hIntr_z'⟩ :=
        hCritSpecialize (α_Uc j) (V_Uc j) (hAff_Uc j) (hVα_Uc j) (s_Uc j) (φ_Uc j) (q_Uc j)
          (x_Uc j) Ψ_j v_j hSurj_j hSpec_j hKer_j hDet0_j hDet00_j hLin_j hΨ_j hSch_j
          x hxV_Uc c hxHyp hAllDet
      have hz'_in_Uc : z' ∈ U_c := hLe_Uc j hz'_Uc
      have hz'_ne_zc : z_c ≠ z' := fun heq => hz'_in_Uc (heq.symm ▸ Set.mem_singleton z_c)
      obtain ⟨i₂, hz'_i₂⟩ := hCov_top z' trivial (fun r => Fin.elim0 r)
      letI hNe_i₂ : Nonempty (V i₂) := ⟨⟨z', hz'_i₂⟩⟩
      letI : Algebra k (A_ch i₂) := alg_ch i₂
      obtain ⟨hMax_pz', _⟩ := (hSpec_ch i₂).2.2.2.2.2.1.2 z' hz'_i₂ hCl_z'
      obtain ⟨ev_z', hKer_evz', _, _, _⟩ :=
        (hSpec_ch i₂).2.2.2.2.2.1.1 (((hAffV i₂).primeIdealOf ⟨z', hz'_i₂⟩).asIdeal) hMax_pz'
      have hCrit_z' : ∀ r : Fin (d + 1), ∑ μ : Fin (M + 1), ev_z' (J_ch i₂ r μ) * c μ = 0 :=
        (((hSpec_ch i₂).2.2.2.2.2.2.1 z' hz'_i₂ hCl_z' ev_z' hKer_evz').2 c
          (hL_lin_homog c)).mpr hIntr_z'
      have hSurj_pair :=
        hTwoPtSurj i₀ i₂ z_c z' hz_c hz'_i₂ hClosed_zc hCl_z' hz'_ne_zc ev_zc ev_z'
          hKer_zc hKer_evz'
      let e_row : Fin (2 * d + 2) ≃ Fin ((d + 1) + (d + 1)) := finCongr (by omega)
      let M_pair_k : Matrix (Fin (2 * d + 2)) (Fin (M + 1)) k :=
        Matrix.of fun r μ =>
          (Matrix.of (Fin.addCases
            (fun r₁ μ' => ev_zc (J_ch i₀ r₁ μ'))
            (fun r₂ μ' => ev_z' (J_ch i₂ r₂ μ'))) :
            Matrix (Fin ((d + 1) + (d + 1))) (Fin (M + 1)) k) (e_row r) μ
      have hSurj_Mpair : Function.Surjective M_pair_k.mulVecLin := by
        intro w
        obtain ⟨u, hu⟩ := hSurj_pair (w ∘ e_row.symm)
        refine ⟨u, ?_⟩
        ext r
        have hr := congrFun hu (e_row r)
        simpa [M_pair_k, Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct] using hr
      obtain ⟨S_btg, hS_btg_card, hS_btg_det⟩ := hPivotMinor (2 * d + 2) (M + 1) M_pair_k hSurj_Mpair
      let α_wit : Idx_btg := (i₀, i₂, ⟨S_btg, hS_btg_card⟩)
      have hEval_zero : MvPolynomial.eval c (Q_btg α_wit) = 0 :=
        hQ_btg_vanish α_wit hNe_i₀ hNe_i₂ ev_zc ev_z' c hCrit_zc hCrit_z' hS_btg_det
      exact hQbtg_ne α_wit hEval_zero
    obtain ⟨γ₀, hγ₀⟩ := hex_γ₀
    refine ⟨α_Uc j, V_Uc j, hAff_Uc j, hxV_Uc, hLe_Uc j, hVα_Uc j, s_Uc j, φ_Uc j, q_Uc j,
      Fin.elim0, f_new_j, γ₀, hSurj_j, hSpec_j, hKer_j, fun r => Fin.elim0 r,
      hf_new_j_eq, hDet0_j, hγ₀⟩

theorem weil_algClosed_net_axis_transversal_open_poly (k : Type u) [Field k] [IsAlgClosed k] (m M : ℕ) (hM : 3 ≤ M)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hCl : AlgebraicGeometry.IsClosedImmersion ι_bar.left) :
    ∃ (Δ_axis : MvPolynomial (Fin 3 × Fin (M + 1)) k),
      Δ_axis ≠ 0 ∧
      ∀ (ℓ : Fin 3 × Fin (M + 1) → k), MvPolynomial.eval ℓ Δ_axis ≠ 0 →
        let L : Fin 3 → MvPolynomial (Fin (M + 1)) k :=
          fun r => ∑ μ : Fin (M + 1), MvPolynomial.C (ℓ (r, μ)) * MvPolynomial.X μ
        IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m) 2 ![L 0, L 1] ∧
        (m = 0 → ∀ z : Z_bar.left,
          ∃ r : Fin 3, ι_bar.left.base z ∉ weilProjHyperplaneSet k M (L r)) ∧
        (1 ≤ m → IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m - 1) 3 L) :=
by
  classical
  have _ : 3 ≤ M ∧ AlgebraicGeometry.IsIntegral Z_bar.left := ⟨hM, hInt⟩
  
  have h_s4 : ∀ (N s d ν_p d_p : ℕ),
      ν_p + d_p = d → 1 ≤ d_p →
      ∀ (R : Type u) [CommRing R]
        (φ : MvPolynomial (Fin (s + d)) k →+* R),
      Function.Surjective φ →
      ∀ (q : Fin s → MvPolynomial (Fin (s + d)) k),
      RingHom.ker φ = Ideal.span (Set.range q) →
      IsUnit (Matrix.det (Matrix.of fun a b : Fin s =>
        φ (MvPolynomial.pderiv (Fin.castAdd d b) (q a)))) →
      ∀ (α₀ : Fin (N + 1))
        (Ψ : Fin N → MvPolynomial (Fin (s + d)) k)
        (v : Matrix (Fin N) (Fin d) R),
      (∀ (c : Fin (N + 1) → k) (γ₀ : Fin d),
        Matrix.det (Matrix.of fun a b : Fin (s + 1) =>
          φ (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin (s + d)) (Fin.castAdd d) (Fin.natAdd s γ₀) b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin (s + d)) k) q
              (MvPolynomial.C (c α₀) +
                ∑ m_idx : Fin N, MvPolynomial.C (c (α₀.succAbove m_idx)) * Ψ m_idx) a))) =
          Matrix.det (Matrix.of fun a b : Fin s =>
            φ (MvPolynomial.pderiv (Fin.castAdd d b) (q a))) *
            ∑ m_idx : Fin N, φ (MvPolynomial.C (c (α₀.succAbove m_idx))) * v m_idx γ₀) →
      ∀ (ℓ_cur : Fin (ν_p + 1) → Fin (N + 1) → k)
        (γ : Fin (ν_p + 1) → Fin d),
      Function.Injective γ →
      ∃ (φ' : MvPolynomial (Fin (s + ν_p + d_p)) k →+* R)
        (q' : Fin s → MvPolynomial (Fin (s + ν_p + d_p)) k)
        (f_lift' : Fin ν_p → MvPolynomial (Fin (s + ν_p + d_p)) k)
        (f_new_lift' : MvPolynomial (Fin (s + ν_p + d_p)) k)
        (γ₀' : Fin d_p),
        Function.Surjective φ' ∧
        φ'.comp MvPolynomial.C = φ.comp MvPolynomial.C ∧
        RingHom.ker φ' = Ideal.span (Set.range q') ∧
        (∀ j : Fin ν_p,
          φ' (f_lift' j) =
            φ (MvPolynomial.C (ℓ_cur j.castSucc α₀) +
              ∑ m_idx : Fin N, MvPolynomial.C (ℓ_cur j.castSucc (α₀.succAbove m_idx)) * Ψ m_idx)) ∧
        φ' f_new_lift' =
          φ (MvPolynomial.C (ℓ_cur (Fin.last ν_p) α₀) +
            ∑ m_idx : Fin N, MvPolynomial.C (ℓ_cur (Fin.last ν_p) (α₀.succAbove m_idx)) * Ψ m_idx) ∧
        IsUnit (Matrix.det (Matrix.of fun a b : Fin s =>
          φ' (MvPolynomial.pderiv (Fin.castAdd d_p (Fin.castAdd ν_p b)) (q' a)))) ∧
        Matrix.det (Matrix.of fun a b : Fin (s + ν_p + 1) =>
          φ' (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin (s + ν_p + d_p))
              (Fin.castAdd d_p) (Fin.natAdd (s + ν_p) γ₀') b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin (s + ν_p + d_p)) k)
              (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s + ν_p + d_p)) k) q' f_lift')
              f_new_lift' a))) =
          Matrix.det (Matrix.of fun a b : Fin s =>
            φ (MvPolynomial.pderiv (Fin.castAdd d b) (q a))) *
          Matrix.det (Matrix.of fun r t : Fin (ν_p + 1) =>
            ∑ m_idx : Fin N, φ (MvPolynomial.C (ℓ_cur r (α₀.succAbove m_idx))) * v m_idx (γ t)) := by
    intro N s d ν_p d_p hd_eq hd_pos R _ φ hSurj q hKer hUnit_Aq α₀ Ψ v hSchur1 ℓ_cur γ hγ_inj
    let S_im : Finset (Fin d) := Finset.univ.image γ
    have h_card_im : S_im.card = ν_p + 1 := by
      rw [Finset.card_image_of_injective _ hγ_inj, Finset.card_univ, Fintype.card_fin]
    have h_card_rem : Fintype.card (Fin (d_p - 1)) = Fintype.card ↥(S_imᶜ : Finset (Fin d)) := by
      rw [Fintype.card_fin, Fintype.card_coe, Finset.card_compl, Fintype.card_fin, h_card_im]
      omega
    let e_rem : Fin (d_p - 1) ≃ ↥(S_imᶜ : Finset (Fin d)) := Fintype.equivOfCardEq h_card_rem
    let γ₀' : Fin d_p := ⟨0, hd_pos⟩
    let τ_d : Fin ν_p ⊕ Fin d_p → Fin d
      | Sum.inl j => γ j.castSucc
      | Sum.inr u => if h0 : u.1 = 0 then γ (Fin.last ν_p) else (e_rem ⟨u.1 - 1, by omega⟩).1
    have hτ_inj : Function.Injective τ_d := by
      intro x y hxy
      cases x with
      | inl j₁ =>
        cases y with
        | inl j₂ =>
          exact congrArg Sum.inl (Fin.castSucc_injective ν_p (hγ_inj hxy))
        | inr u₂ =>
          dsimp [τ_d] at hxy
          split_ifs at hxy with h0
          · have hj := congrArg Fin.val (hγ_inj hxy)
            simp at hj
            omega
          · have hmem : γ j₁.castSucc ∈ S_im := Finset.mem_image_of_mem γ (Finset.mem_univ _)
            rw [hxy] at hmem
            exact False.elim ((Finset.mem_compl.mp (e_rem _).2) hmem)
      | inr u₁ =>
        cases y with
        | inl j₂ =>
          dsimp [τ_d] at hxy
          split_ifs at hxy with h0
          · have hj := congrArg Fin.val (hγ_inj hxy)
            simp at hj
            omega
          · have hmem : γ j₂.castSucc ∈ S_im := Finset.mem_image_of_mem γ (Finset.mem_univ _)
            rw [← hxy] at hmem
            exact False.elim ((Finset.mem_compl.mp (e_rem _).2) hmem)
        | inr u₂ =>
          dsimp [τ_d] at hxy
          split_ifs at hxy with h1 h2 h2
          · exact congrArg Sum.inr (Fin.ext (h1.trans h2.symm))
          · have hmem : γ (Fin.last ν_p) ∈ S_im := Finset.mem_image_of_mem γ (Finset.mem_univ _)
            rw [hxy] at hmem
            exact False.elim ((Finset.mem_compl.mp (e_rem _).2) hmem)
          · have hmem : γ (Fin.last ν_p) ∈ S_im := Finset.mem_image_of_mem γ (Finset.mem_univ _)
            rw [← hxy] at hmem
            exact False.elim ((Finset.mem_compl.mp (e_rem _).2) hmem)
          · have heq := congrArg Fin.val (e_rem.injective (Subtype.ext hxy))
            dsimp at heq
            exact congrArg Sum.inr (Fin.ext (by omega))
    let e_d : Fin ν_p ⊕ Fin d_p ≃ Fin d :=
      Equiv.ofBijective τ_d
        ((Fintype.bijective_iff_injective_and_card τ_d).mpr ⟨hτ_inj, by simp [hd_eq]⟩)
    let σ_tilde : Fin (s + ν_p + d_p) ≃ Fin (s + d) :=
      finSumFinEquiv.symm.trans
        (((Equiv.sumCongr finSumFinEquiv.symm (Equiv.refl (Fin d_p))).trans
          (Equiv.sumAssoc (Fin s) (Fin ν_p) (Fin d_p))).trans
            ((Equiv.sumCongr (Equiv.refl (Fin s)) e_d).trans finSumFinEquiv))
    have hσ_q : ∀ b : Fin s, σ_tilde (Fin.castAdd d_p (Fin.castAdd ν_p b)) = Fin.castAdd d b := by
      intro b
      simp [σ_tilde, finSumFinEquiv_apply_left]
    have hσ_sl : ∀ j : Fin ν_p,
        σ_tilde (Fin.castAdd d_p (Fin.natAdd s j)) = Fin.natAdd s (γ j.castSucc) := by
      intro j
      simp [σ_tilde, e_d, τ_d, finSumFinEquiv_apply_right]
    have hσ_new : σ_tilde (Fin.natAdd (s + ν_p) γ₀') = Fin.natAdd s (γ (Fin.last ν_p)) := by
      have h_eq : Fin.natAdd (s + ν_p) γ₀' = finSumFinEquiv (Sum.inr γ₀') :=
        (finSumFinEquiv_apply_right γ₀').symm
      rw [h_eq]
      simp only [σ_tilde, Equiv.trans_apply, Equiv.symm_apply_apply]
      simp [e_d, τ_d, γ₀', finSumFinEquiv_apply_right]
    let e_ren : MvPolynomial (Fin (s + ν_p + d_p)) k ≃ₐ[k] MvPolynomial (Fin (s + d)) k :=
      MvPolynomial.renameEquiv k σ_tilde
    let φ' : MvPolynomial (Fin (s + ν_p + d_p)) k →+* R := φ.comp e_ren.toRingHom
    let f_raw : Fin (ν_p + 1) → MvPolynomial (Fin (s + d)) k := fun r =>
      MvPolynomial.C (ℓ_cur r α₀) +
        ∑ m_idx : Fin N, MvPolynomial.C (ℓ_cur r (α₀.succAbove m_idx)) * Ψ m_idx
    let q' : Fin s → MvPolynomial (Fin (s + ν_p + d_p)) k := fun a => e_ren.symm (q a)
    let f_lift' : Fin ν_p → MvPolynomial (Fin (s + ν_p + d_p)) k :=
      fun j => e_ren.symm (f_raw j.castSucc)
    let f_new_lift' : MvPolynomial (Fin (s + ν_p + d_p)) k :=
      e_ren.symm (f_raw (Fin.last ν_p))
    have h_pderiv : ∀ (w : Fin (s + ν_p + d_p)) (P : MvPolynomial (Fin (s + d)) k),
        φ' (MvPolynomial.pderiv w (e_ren.symm P)) = φ (MvPolynomial.pderiv (σ_tilde w) P) := by
      intro w P
      have hw : w = σ_tilde.symm (σ_tilde w) := (σ_tilde.symm_apply_apply w).symm
      change φ (MvPolynomial.rename σ_tilde (MvPolynomial.pderiv w (MvPolynomial.rename σ_tilde.symm P))) = _
      conv_lhs => rw [hw]
      rw [MvPolynomial.pderiv_rename σ_tilde.symm.injective, MvPolynomial.rename_rename,
        Equiv.self_comp_symm, MvPolynomial.rename_id, AlgHom.id_apply]
    refine ⟨φ', q', f_lift', f_new_lift', γ₀', hSurj.comp e_ren.surjective, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · ext c
      simp [φ', e_ren]
    · ext P
      rw [RingHom.mem_ker]
      change φ (e_ren P) = 0 ↔ P ∈ Ideal.span (Set.range q')
      rw [← RingHom.mem_ker, hKer]
      have hmap : Ideal.map e_ren.symm.toRingHom (Ideal.span (Set.range q)) =
          Ideal.span (Set.range q') := by
        rw [Ideal.map_span]
        congr 1
        ext x
        simp [q']
      rw [← hmap]
      exact ⟨fun h => by simpa using Ideal.mem_map_of_mem e_ren.symm.toRingHom h,
        fun h => by
          have h1 := Ideal.mem_map_of_mem e_ren.toRingHom h
          rw [Ideal.map_map] at h1
          have hid : e_ren.toRingHom.comp e_ren.symm.toRingHom = RingHom.id _ :=
            RingHom.ext fun x => e_ren.apply_symm_apply x
          rwa [hid, Ideal.map_id] at h1⟩
    · intro j
      change φ (e_ren (e_ren.symm (f_raw j.castSucc))) = φ (f_raw j.castSucc)
      rw [e_ren.apply_symm_apply]
    · change φ (e_ren (e_ren.symm (f_raw (Fin.last ν_p)))) = φ (f_raw (Fin.last ν_p))
      rw [e_ren.apply_symm_apply]
    · have hAq_eq : (Matrix.of fun a b : Fin s =>
          φ' (MvPolynomial.pderiv (Fin.castAdd d_p (Fin.castAdd ν_p b)) (q' a))) =
        Matrix.of fun a b : Fin s => φ (MvPolynomial.pderiv (Fin.castAdd d b) (q a)) := by
        ext a b
        simp only [Matrix.of_apply, q', h_pderiv, hσ_q]
      rw [hAq_eq]
      exact hUnit_Aq
    · let A_q : Matrix (Fin s) (Fin s) R :=
        Matrix.of fun a b => φ (MvPolynomial.pderiv (Fin.castAdd d b) (q a))
      let B_mat : Matrix (Fin s) (Fin (ν_p + 1)) R :=
        Matrix.of fun a t => φ (MvPolynomial.pderiv (Fin.natAdd s (γ t)) (q a))
      let C_mat : Matrix (Fin (ν_p + 1)) (Fin s) R :=
        Matrix.of fun r b => φ (MvPolynomial.pderiv (Fin.castAdd d b) (f_raw r))
      let D_mat : Matrix (Fin (ν_p + 1)) (Fin (ν_p + 1)) R :=
        Matrix.of fun r t => φ (MvPolynomial.pderiv (Fin.natAdd s (γ t)) (f_raw r))
      let M_aug' : Matrix (Fin (s + ν_p + 1)) (Fin (s + ν_p + 1)) R :=
        Matrix.of fun a b =>
          φ' (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin (s + ν_p + d_p))
              (Fin.castAdd d_p) (Fin.natAdd (s + ν_p) γ₀') b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin (s + ν_p + d_p)) k)
              (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s + ν_p + d_p)) k) q' f_lift')
              f_new_lift' a))
      let e_idx : Fin s ⊕ Fin (ν_p + 1) ≃ Fin (s + ν_p + 1) :=
        finSumFinEquiv.trans (finCongr (Nat.add_assoc s ν_p 1).symm)
      have h_e_inl : ∀ a : Fin s, e_idx (Sum.inl a) = Fin.castSucc (Fin.castAdd ν_p a) := by
        intro a; ext; simp [e_idx, finSumFinEquiv_apply_left]
      have h_e_inr_cast : ∀ j : Fin ν_p,
          e_idx (Sum.inr j.castSucc) = Fin.castSucc (Fin.natAdd s j) := by
        intro j; ext; simp [e_idx, finSumFinEquiv_apply_right]
      have h_e_inr_last : e_idx (Sum.inr (Fin.last ν_p)) = Fin.last (s + ν_p) := by
        ext; simp [e_idx, finSumFinEquiv_apply_right]
      have h_row : ∀ u : Fin s ⊕ Fin (ν_p + 1),
          Fin.snoc (α := fun _ => MvPolynomial (Fin (s + ν_p + d_p)) k)
            (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s + ν_p + d_p)) k) q' f_lift')
            f_new_lift' (e_idx u) =
          match u with
          | Sum.inl a => e_ren.symm (q a)
          | Sum.inr r => e_ren.symm (f_raw r) := by
        intro u
        cases u with
        | inl a => rw [h_e_inl, Fin.snoc_castSucc, Fin.addCases_left]
        | inr r =>
          refine Fin.lastCases ?_ ?_ r
          · rw [h_e_inr_last, Fin.snoc_last]
          · intro j; rw [h_e_inr_cast, Fin.snoc_castSucc, Fin.addCases_right]
      have h_col : ∀ u : Fin s ⊕ Fin (ν_p + 1),
          σ_tilde (Fin.snoc (α := fun _ => Fin (s + ν_p + d_p))
            (Fin.castAdd d_p) (Fin.natAdd (s + ν_p) γ₀') (e_idx u)) =
          match u with
          | Sum.inl b => Fin.castAdd d b
          | Sum.inr t => Fin.natAdd s (γ t) := by
        intro u
        cases u with
        | inl b => rw [h_e_inl, Fin.snoc_castSucc, hσ_q]
        | inr t =>
          refine Fin.lastCases ?_ ?_ t
          · rw [h_e_inr_last, Fin.snoc_last, hσ_new]
          · intro j; rw [h_e_inr_cast, Fin.snoc_castSucc, hσ_sl]
      have h_sub : M_aug'.submatrix e_idx e_idx = Matrix.fromBlocks A_q B_mat C_mat D_mat := by
        ext u w
        change M_aug' (e_idx u) (e_idx w) = _
        dsimp only [M_aug', Matrix.of_apply]
        rw [h_row u]
        cases u <;> cases w <;> simp only [h_pderiv, h_col, Matrix.fromBlocks_apply₁₁,
          Matrix.fromBlocks_apply₁₂, Matrix.fromBlocks_apply₂₁, Matrix.fromBlocks_apply₂₂,
          A_q, B_mat, C_mat, D_mat, Matrix.of_apply]
      let _ : Invertible A_q := Matrix.invertibleOfIsUnitDet A_q hUnit_Aq
      have h_det_blk : M_aug'.det = A_q.det * (D_mat - C_mat * ⅟A_q * B_mat).det := by
        rw [← Matrix.det_submatrix_equiv_self e_idx M_aug', h_sub, Matrix.det_fromBlocks₁₁]
      change M_aug'.det = A_q.det * _
      rw [h_det_blk]
      congr 2
      ext r t
      apply hUnit_Aq.mul_left_cancel
      let B₁ : Matrix (Fin s) (Fin 1) R := Matrix.of fun a _ => B_mat a t
      let C₁ : Matrix (Fin 1) (Fin s) R := Matrix.of fun _ b => C_mat r b
      let D₁ : Matrix (Fin 1) (Fin 1) R := Matrix.of fun _ _ => D_mat r t
      let M₁ : Matrix (Fin (s + 1)) (Fin (s + 1)) R :=
        Matrix.of fun a b =>
          φ (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin (s + d)) (Fin.castAdd d) (Fin.natAdd s (γ t)) b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin (s + d)) k) q (f_raw r) a))
      let e₁ : Fin s ⊕ Fin 1 ≃ Fin (s + 1) := finSumFinEquiv
      have h_e1_inl : ∀ a : Fin s, e₁ (Sum.inl a) = a.castSucc := by
        intro a; ext; simp [e₁, finSumFinEquiv_apply_left]
      have h_e1_inr : ∀ u : Fin 1, e₁ (Sum.inr u) = Fin.last s := by
        intro u; ext; have := u.isLt; simp [e₁, finSumFinEquiv_apply_right]
      have h_sub1 : M₁.submatrix e₁ e₁ = Matrix.fromBlocks A_q B₁ C₁ D₁ := by
        ext u w
        cases u with
        | inl a =>
          cases w with
          | inl b => simp [M₁, A_q, h_e1_inl]
          | inr z => simp [M₁, B₁, B_mat, h_e1_inl, h_e1_inr]
        | inr z =>
          cases w with
          | inl b => simp [M₁, C₁, C_mat, h_e1_inl, h_e1_inr]
          | inr z' => simp [M₁, D₁, D_mat, h_e1_inr]
      have h_M1_det : M₁.det = A_q.det * (D_mat - C_mat * ⅟A_q * B_mat) r t := by
        rw [← Matrix.det_submatrix_equiv_self e₁ M₁, h_sub1, Matrix.det_fromBlocks₁₁,
          Matrix.det_fin_one]
        rfl
      rw [← h_M1_det]
      exact hSchur1 (ℓ_cur r) (γ t)

  
  have h_s5 : ∀ (s d : ℕ) (R : Type u) [CommRing R]
      (φ : MvPolynomial (Fin (s + d)) k →+* R),
      Function.Surjective φ →
      ∀ (q : Fin s → MvPolynomial (Fin (s + d)) k),
      (∀ a : Fin s, φ (q a) = 0) →
      IsUnit (Matrix.det (Matrix.of fun a b : Fin s =>
        φ (MvPolynomial.pderiv (Fin.castAdd d b) (q a)))) →
      ∀ (F_p : Type u) [Field F_p] [Algebra k F_p] (σ_Fp : R →+* F_p),
      (∀ a : k, σ_Fp (φ (MvPolynomial.C a)) = algebraMap k F_p a) →
      (∀ z : F_p, ∃ u v : R, σ_Fp v ≠ 0 ∧ z * σ_Fp v = σ_Fp u) →
      Algebra.trdeg k F_p ≤ (d : Cardinal.{u}) := by
    intro s d R _ φ hSurj q hq_zero hUnit_J F_p _ _ σ_Fp hσ_κ hσ_frac
    let ψ_bar : MvPolynomial (Fin (s + d)) k →ₐ[k] F_p :=
      { toRingHom := σ_Fp.comp φ, commutes' := hσ_κ }
    let y_raw : Fin d → F_p := fun γ => ψ_bar (MvPolynomial.X (Fin.natAdd s γ))
    let z_dep : Fin s → F_p := fun b => ψ_bar (MvPolynomial.X (Fin.castAdd d b))
    have h_from_E0 : ∀ (E₀ : Type u) [Field E₀] [Algebra k E₀] [Algebra E₀ F_p]
        [IsScalarTower k E₀ F_p] (y_free : Fin d → E₀),
        Algebra.trdeg k E₀ ≤ (d : Cardinal.{u}) →
        (∀ γ : Fin d, algebraMap E₀ F_p (y_free γ) = y_raw γ) →
        Algebra.trdeg k F_p ≤ (d : Cardinal.{u}) := by
      intro E₀ _ _ _ _ y_free h_tr_E0 hy_free
      let var_map : Fin (s + d) → MvPolynomial (Fin s) E₀ := fun idx =>
        match finSumFinEquiv.symm idx with
        | Sum.inl b => MvPolynomial.X b
        | Sum.inr γ => MvPolynomial.C (y_free γ)
      have h_var_inl : ∀ b' : Fin s, var_map (Fin.castAdd d b') = MvPolynomial.X b' := by
        intro b'
        rw [← finSumFinEquiv_apply_left b']
        simp [var_map]
      have h_var_inr : ∀ γ : Fin d, var_map (Fin.natAdd s γ) = MvPolynomial.C (y_free γ) := by
        intro γ
        rw [← finSumFinEquiv_apply_right γ]
        simp [var_map]
      let eval_part : MvPolynomial (Fin (s + d)) k →ₐ[k] MvPolynomial (Fin s) E₀ :=
        MvPolynomial.aeval var_map
      let ev_z : MvPolynomial (Fin s) E₀ →ₐ[E₀] F_p := MvPolynomial.aeval z_dep
      have h_ev_comp : (ev_z.restrictScalars k).comp eval_part = ψ_bar := by
        apply MvPolynomial.algHom_ext
        intro idx
        obtain ⟨u, rfl⟩ := finSumFinEquiv.surjective idx
        cases u with
        | inl b =>
          rw [finSumFinEquiv_apply_left]
          simp [eval_part, h_var_inl, ev_z, z_dep]
        | inr γ =>
          rw [finSumFinEquiv_apply_right]
          simp [eval_part, h_var_inr, ev_z, hy_free, y_raw]
      have h_ev_apply : ∀ P : MvPolynomial (Fin (s + d)) k, ev_z (eval_part P) = ψ_bar P :=
        fun P => DFunLike.congr_fun h_ev_comp P
      have h_pderiv_part : ∀ (b : Fin s) (P : MvPolynomial (Fin (s + d)) k),
          MvPolynomial.pderiv b (eval_part P) =
            eval_part (MvPolynomial.pderiv (Fin.castAdd d b) P) := by
        intro b P
        induction P using MvPolynomial.induction_on with
        | C c => simp [eval_part]
        | add p₁ p₂ hp₁ hp₂ => simp [map_add, hp₁, hp₂]
        | mul_X p idx hp =>
          simp only [MvPolynomial.pderiv_mul, map_add, map_mul, hp]
          obtain ⟨u, rfl⟩ := finSumFinEquiv.surjective idx
          cases u with
          | inl b' =>
            rw [finSumFinEquiv_apply_left]
            have h_eval_X : eval_part (MvPolynomial.X (Fin.castAdd d b')) = MvPolynomial.X b' := by
              simp [eval_part, h_var_inl]
            rw [h_eval_X]
            by_cases hbb : b' = b
            · subst hbb; simp
            · have hbb' : Fin.castAdd d b' ≠ Fin.castAdd d b :=
                fun heq => hbb (Fin.castAdd_injective _ _ heq)
              rw [MvPolynomial.pderiv_X_of_ne hbb, MvPolynomial.pderiv_X_of_ne hbb', map_zero]
          | inr γ =>
            rw [finSumFinEquiv_apply_right]
            have hne : Fin.natAdd s γ ≠ Fin.castAdd d b := by
              intro heq; have hv := congrArg Fin.val heq; simp at hv; omega
            have h_eval_X : eval_part (MvPolynomial.X (Fin.natAdd s γ)) =
                MvPolynomial.C (y_free γ) := by
              simp [eval_part, h_var_inr]
            rw [h_eval_X, MvPolynomial.pderiv_C, MvPolynomial.pderiv_X_of_ne hne, map_zero]
      let H_E₀ : Fin s → MvPolynomial (Fin s) E₀ := fun a => eval_part (q a)
      have hH_zero : ∀ a : Fin s, ev_z (H_E₀ a) = 0 := by
        intro a
        rw [h_ev_apply]
        change σ_Fp (φ (q a)) = 0
        rw [hq_zero a, map_zero]
      let J_poly : Matrix (Fin s) (Fin s) (MvPolynomial (Fin s) E₀) :=
        Matrix.of fun a b => MvPolynomial.pderiv b (H_E₀ a)
      let D_jac : MvPolynomial (Fin s) E₀ := J_poly.det
      have hD_eval : ev_z D_jac =
          σ_Fp (Matrix.det (Matrix.of fun a b : Fin s =>
            φ (MvPolynomial.pderiv (Fin.castAdd d b) (q a)))) := by
        dsimp only [D_jac]
        change ev_z.toRingHom J_poly.det = σ_Fp _
        rw [RingHom.map_det, RingHom.map_det]
        congr 1
        ext a b
        simp only [RingHom.mapMatrix_apply, Matrix.map_apply, J_poly, Matrix.of_apply, H_E₀,
          h_pderiv_part]
        exact h_ev_apply _
      have hD_ne : ev_z D_jac ≠ 0 := by
        rw [hD_eval]
        exact (hUnit_J.map σ_Fp).ne_zero
      let ren_s : MvPolynomial (Fin s) E₀ →ₐ[E₀] MvPolynomial (Fin (s + 1)) E₀ :=
        MvPolynomial.rename Fin.castSucc
      let v_rel : Fin (s + 1) → MvPolynomial (Fin (s + 1)) E₀ :=
        Fin.snoc (fun a : Fin s => ren_s (H_E₀ a))
          (MvPolynomial.X (Fin.last s) * ren_s D_jac - 1)
      let I_et : Ideal (MvPolynomial (Fin (s + 1)) E₀) := Ideal.span (Set.range v_rel)
      let A_et := MvPolynomial (Fin (s + 1)) E₀ ⧸ I_et
      have h_pderiv_last_ren : ∀ P : MvPolynomial (Fin s) E₀,
          MvPolynomial.pderiv (Fin.last s) (ren_s P) = 0 := by
        intro P
        induction P using MvPolynomial.induction_on with
        | C c => simp [ren_s]
        | add p₁ p₂ hp₁ hp₂ => simp [map_add, hp₁, hp₂]
        | mul_X p b hp =>
          have hne : b.castSucc ≠ Fin.last s := Fin.castSucc_ne_last b
          simp [ren_s, hp, MvPolynomial.pderiv_X_of_ne hne]
      let P_pre : Algebra.PreSubmersivePresentation E₀ A_et (Fin (s + 1)) (Fin (s + 1)) :=
        Algebra.PreSubmersivePresentation.naive (v := v_rel) id Function.injective_id
      let e₁ : Fin s ⊕ Fin 1 ≃ Fin (s + 1) := finSumFinEquiv
      have h_e1_inl : ∀ b : Fin s, e₁ (Sum.inl b) = b.castSucc := by
        intro b; ext; simp [e₁, finSumFinEquiv_apply_left]
      have h_e1_inr : ∀ u : Fin 1, e₁ (Sum.inr u) = Fin.last s := by
        intro u; ext; have := u.isLt; simp [e₁, finSumFinEquiv_apply_right]
      let J_ren : Matrix (Fin s) (Fin s) (MvPolynomial (Fin (s + 1)) E₀) :=
        Matrix.of fun b a => ren_s (MvPolynomial.pderiv b (H_E₀ a))
      let B_top : Matrix (Fin s) (Fin 1) (MvPolynomial (Fin (s + 1)) E₀) :=
        Matrix.of fun b _ => MvPolynomial.pderiv b.castSucc (v_rel (Fin.last s))
      let D_bot : Matrix (Fin 1) (Fin 1) (MvPolynomial (Fin (s + 1)) E₀) :=
        Matrix.of fun _ _ => ren_s D_jac
      have h_jac_sub : P_pre.jacobiMatrix.submatrix e₁ e₁ =
          Matrix.fromBlocks J_ren B_top 0 D_bot := by
        apply Matrix.ext
        intro u w
        change P_pre.jacobiMatrix (e₁ u) (e₁ w) = _
        rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        change MvPolynomial.pderiv (e₁ u) (v_rel (e₁ w)) = _
        cases u with
        | inl b =>
          cases w with
          | inl a =>
            rw [h_e1_inl, h_e1_inl]
            simp only [v_rel, Fin.snoc_castSucc, ren_s,
              MvPolynomial.pderiv_rename (Fin.castSucc_injective s),
              Matrix.fromBlocks_apply₁₁, J_ren, Matrix.of_apply]
          | inr z =>
            rw [h_e1_inl, h_e1_inr]
            simp [B_top]
        | inr z =>
          cases w with
          | inl a =>
            rw [h_e1_inr, h_e1_inl]
            simp only [v_rel, Fin.snoc_castSucc, h_pderiv_last_ren,
              Matrix.fromBlocks_apply₂₁, Matrix.zero_apply]
          | inr z' =>
            rw [h_e1_inr, h_e1_inr]
            simp only [v_rel, Fin.snoc_last, map_sub, MvPolynomial.pderiv_mul,
              MvPolynomial.pderiv_X_self, one_mul, h_pderiv_last_ren, mul_zero, add_zero,
              Matrix.fromBlocks_apply₂₂, D_bot, Matrix.of_apply]
            rw [← MvPolynomial.C_1, MvPolynomial.pderiv_C, sub_zero]
      have h_Jren_det : J_ren.det = ren_s D_jac := by
        have hJ_eq : J_ren = ren_s.toRingHom.mapMatrix J_poly.transpose := by
          ext b a
          simp [J_ren, J_poly]
        rw [hJ_eq, ← RingHom.map_det, Matrix.det_transpose]
        rfl
      have h_jac_det : P_pre.jacobiMatrix.det = ren_s D_jac * ren_s D_jac := by
        rw [← Matrix.det_submatrix_equiv_self e₁ P_pre.jacobiMatrix, h_jac_sub,
          Matrix.det_fromBlocks_zero₂₁, h_Jren_det, Matrix.det_fin_one]
        rfl
      have h_renD_unit : IsUnit (Ideal.Quotient.mk I_et (ren_s D_jac)) := by
        have hmem : v_rel (Fin.last s) ∈ I_et := Ideal.subset_span ⟨Fin.last s, rfl⟩
        have hzero : Ideal.Quotient.mk I_et (v_rel (Fin.last s)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr hmem
        dsimp only [v_rel] at hzero
        rw [Fin.snoc_last, map_sub, map_mul, map_one, sub_eq_zero] at hzero
        exact IsUnit.of_mul_eq_one (Ideal.Quotient.mk I_et (MvPolynomial.X (Fin.last s)))
          (by rw [mul_comm]; exact hzero)
      have h_jac_unit : IsUnit P_pre.jacobian := by
        rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
        change IsUnit (Ideal.Quotient.mk I_et P_pre.jacobiMatrix.det)
        rw [h_jac_det, map_mul]
        exact h_renD_unit.mul h_renD_unit
      let P_sub : Algebra.SubmersivePresentation E₀ A_et (Fin (s + 1)) (Fin (s + 1)) :=
        { P_pre with jacobian_isUnit := h_jac_unit }
      have _ : Algebra.IsStandardSmoothOfRelativeDimension 0 E₀ A_et :=
        P_sub.isStandardSmoothOfRelativeDimension (Nat.sub_self _)
      have _ : Algebra.Etale E₀ A_et := inferInstance
      have _ : Module.Finite E₀ A_et := by
        obtain ⟨I_idx, hFin_I, Ai, hField_I, hAlg_I, e_et, hProps_I⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod E₀ A_et).mp inferInstance
        let _ : Finite I_idx := hFin_I
        let _ : ∀ i, Field (Ai i) := hField_I
        let _ : ∀ i, Algebra E₀ (Ai i) := hAlg_I
        let _ : ∀ i, Module.Finite E₀ (Ai i) := fun i => (hProps_I i).1
        exact Module.Finite.equiv e_et.symm.toLinearEquiv
      let ev_et : MvPolynomial (Fin (s + 1)) E₀ →ₐ[E₀] F_p :=
        MvPolynomial.aeval (Fin.snoc z_dep (ev_z D_jac)⁻¹)
      have h_ev_ren : ∀ P : MvPolynomial (Fin s) E₀, ev_et (ren_s P) = ev_z P := by
        intro P
        have h_comp : ev_et.comp ren_s = ev_z := by
          apply MvPolynomial.algHom_ext
          intro b
          simp [ev_et, ren_s, ev_z]
        exact DFunLike.congr_fun h_comp P
      have h_Iet_le : I_et ≤ RingHom.ker ev_et.toRingHom := by
        rw [Ideal.span_le]
        rintro _ ⟨idx, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker]
        refine Fin.lastCases ?_ ?_ idx
        · dsimp only [v_rel]
          rw [Fin.snoc_last]
          change ev_et (MvPolynomial.X (Fin.last s) * ren_s D_jac - 1) = 0
          rw [map_sub, map_mul, MvPolynomial.aeval_X, Fin.snoc_last, h_ev_ren, map_one,
            inv_mul_cancel₀ hD_ne, sub_self]
        · intro a
          dsimp only [v_rel]
          rw [Fin.snoc_castSucc]
          change ev_et (ren_s (H_E₀ a)) = 0
          rw [h_ev_ren, hH_zero]
      let θ_et : A_et →ₐ[E₀] F_p := Ideal.Quotient.liftₐ I_et ev_et (fun x hx => h_Iet_le hx)
      let B₀ : Subalgebra E₀ F_p := θ_et.range
      have _ : Module.Finite E₀ ↥B₀ :=
        Module.Finite.of_surjective θ_et.rangeRestrict.toLinearMap
          (AlgHom.rangeRestrict_surjective θ_et)
      have _ : Algebra.IsAlgebraic E₀ ↥B₀ := Algebra.IsAlgebraic.of_finite E₀ ↥B₀
      have h_range_R : ∀ r : R, σ_Fp r ∈ B₀ := by
        intro r
        obtain ⟨P, rfl⟩ := hSurj r
        change ψ_bar P ∈ B₀
        rw [← h_ev_apply P, ← h_ev_ren (eval_part P)]
        exact ⟨Ideal.Quotient.mk I_et (ren_s (eval_part P)), rfl⟩
      have _ : IsFractionRing ↥B₀ F_p := by
        refine IsFractionRing.of_field ↥B₀ F_p fun z => ?_
        obtain ⟨u, v, hv_ne, huv⟩ := hσ_frac z
        refine ⟨⟨σ_Fp u, h_range_R u⟩, ⟨σ_Fp v, h_range_R v⟩, ?_⟩
        exact (eq_div_iff hv_ne).mpr huv
      have _ : Algebra.IsAlgebraic ↥B₀ F_p :=
        (IsFractionRing.isAlgebraic_iff' ↥B₀ ↥B₀ F_p).mp Algebra.IsIntegral.isAlgebraic
      have h_tr_E0_Fp : Algebra.trdeg E₀ F_p = 0 := by
        rw [← trdeg_add_eq E₀ ↥B₀ (A := F_p), trdeg_eq_zero (R := E₀) (A := ↥B₀),
          trdeg_eq_zero (R := ↥B₀) (A := F_p), add_zero]
      rw [← trdeg_add_eq k E₀ (A := F_p), h_tr_E0_Fp, add_zero]
      exact h_tr_E0
    let Φ_free : MvPolynomial (Fin d) k →ₐ[k] F_p := MvPolynomial.aeval y_raw
    let A_free : Subalgebra k F_p := Φ_free.range
    have h_tr_Afree : Algebra.trdeg k ↥A_free ≤ (d : Cardinal.{u}) := by
      have h1 := trdeg_le_of_surjective Φ_free.rangeRestrict
        (AlgHom.rangeRestrict_surjective Φ_free)
      rw [MvPolynomial.trdeg_of_isDomain] at h1
      simpa using h1
    let E₀ := FractionRing ↥A_free
    have _ : Algebra.IsAlgebraic ↥A_free E₀ :=
      (IsFractionRing.isAlgebraic_iff' ↥A_free ↥A_free E₀).mp Algebra.IsIntegral.isAlgebraic
    have h_tr_E0 : Algebra.trdeg k E₀ ≤ (d : Cardinal.{u}) := by
      rw [← trdeg_add_eq k ↥A_free (A := E₀), trdeg_eq_zero (R := ↥A_free) (A := E₀), add_zero]
      exact h_tr_Afree
    let g_inc : ↥A_free →+* F_p := A_free.val.toRingHom
    have hg_inj : Function.Injective g_inc := Subtype.coe_injective
    let ι_E₀ : E₀ →+* F_p := IsFractionRing.lift (K := E₀) (g := g_inc) hg_inj
    let _ : Algebra E₀ F_p := ι_E₀.toAlgebra
    have _ : IsScalarTower k E₀ F_p := by
      refine IsScalarTower.of_algebraMap_eq fun c => ?_
      change algebraMap k F_p c =
        IsFractionRing.lift hg_inj (algebraMap ↥A_free E₀ (algebraMap k ↥A_free c))
      rw [IsFractionRing.lift_algebraMap]
      rfl
    let y_free : Fin d → E₀ := fun γ =>
      algebraMap ↥A_free E₀ ⟨y_raw γ, ⟨MvPolynomial.X γ, MvPolynomial.aeval_X y_raw γ⟩⟩
    have hy_free : ∀ γ : Fin d, algebraMap E₀ F_p (y_free γ) = y_raw γ := by
      intro γ
      change IsFractionRing.lift hg_inj (algebraMap ↥A_free E₀ _) = _
      rw [IsFractionRing.lift_algebraMap]
      rfl
    exact h_from_E0 E₀ y_free h_tr_E0 hy_free

  
  have h_s6 : ∀ (F L : Type u) [Field F] [Field L] [Algebra F L] (N : ℕ) (α₀ : Fin (N + 1))
      (x_tilde : Fin N → F),
      (∀ (ν : ℕ) (w : Fin ν × Fin (N + 1) → L),
        (∀ r : Fin ν,
          w (r, α₀) + ∑ m_idx : Fin N, algebraMap F L (x_tilde m_idx) * w (r, α₀.succAbove m_idx) = 0) →
        (∀ z : L, ∃ x y : ↥(Algebra.adjoin F (Set.range w)), z = (x : L) / (y : L)) →
        Algebra.trdeg F L ≤ ((ν * N : ℕ) : Cardinal.{u})) ∧
      (∀ (d ν : ℕ), 1 ≤ ν →
        ∀ (v_tilde : Matrix (Fin N) (Fin d) F)
          (U_tilde : Matrix (Fin d) (Fin N) F),
        U_tilde * v_tilde = 1 →
        ∀ (w : Fin ν × Fin (N + 1) → L),
        (∀ r : Fin ν,
          w (r, α₀) + ∑ m_idx : Fin N, algebraMap F L (x_tilde m_idx) * w (r, α₀.succAbove m_idx) = 0) →
        (∀ γ : Fin ν → Fin d,
          Matrix.det (Matrix.of fun r t : Fin ν =>
            ∑ m_idx : Fin N, w (r, α₀.succAbove m_idx) * algebraMap F L (v_tilde m_idx (γ t))) = 0) →
        (∀ z : L, ∃ x y : ↥(Algebra.adjoin F (Set.range w)), z = (x : L) / (y : L)) →
        d ≤ N ∧ Algebra.trdeg F L ≤ (((ν - 1) * (N + 1) + (N - d) : ℕ) : Cardinal.{u})) := by
    intro F L _ _ _ N α₀ x_tilde
    have h_trdeg_from_gen : ∀ {σ : Type} [Fintype σ] (t : σ → L)
        (A_w : Subalgebra F L),
        A_w ≤ (MvPolynomial.aeval t : MvPolynomial σ F →ₐ[F] L).range →
        (∀ z : L, ∃ x y : ↥A_w, z = (x : L) / (y : L)) →
        Algebra.trdeg F L ≤ ((Fintype.card σ : ℕ) : Cardinal.{u}) := by
      intro σ _ t A_w h_le hFrac
      let Φ : MvPolynomial σ F →ₐ[F] L := MvPolynomial.aeval t
      have h_inj := trdeg_le_of_injective (Subalgebra.inclusion h_le)
        (Subalgebra.inclusion_injective h_le)
      have h_surj := trdeg_le_of_surjective Φ.rangeRestrict
        (AlgHom.rangeRestrict_surjective Φ)
      rw [MvPolynomial.trdeg_of_isDomain] at h_surj
      have h_card : Cardinal.lift.{u, 0} (Cardinal.mk σ) =
          ((Fintype.card σ : ℕ) : Cardinal.{u}) := by simp
      rw [h_card] at h_surj
      have _ : IsFractionRing ↥A_w L := IsFractionRing.of_field ↥A_w L hFrac
      have _ : Algebra.IsAlgebraic ↥A_w L :=
        (IsFractionRing.isAlgebraic_iff' ↥A_w ↥A_w L).mp Algebra.IsIntegral.isAlgebraic
      rw [← trdeg_add_eq F ↥A_w (A := L), trdeg_eq_zero (R := ↥A_w) (A := L), add_zero]
      exact h_inj.trans h_surj
    refine ⟨?_, ?_⟩
    · intro ν w hInc hFrac
      let t₁ : Fin ν × Fin N → L := fun p => w (p.1, α₀.succAbove p.2)
      let Φ₁ : MvPolynomial (Fin ν × Fin N) F →ₐ[F] L := MvPolynomial.aeval t₁
      have h_le : Algebra.adjoin F (Set.range w) ≤ Φ₁.range := by
        rw [Algebra.adjoin_le_iff]
        rintro _ ⟨⟨r, μ⟩, rfl⟩
        refine Fin.succAboveCases α₀ ?_ ?_ μ
        · have h0 : w (r, α₀) =
              - ∑ m_idx : Fin N, algebraMap F L (x_tilde m_idx) * w (r, α₀.succAbove m_idx) :=
            eq_neg_of_add_eq_zero_left (hInc r)
          rw [h0]
          refine neg_mem (sum_mem fun m_idx _ => mul_mem ?_ ?_)
          · exact Φ₁.range.algebraMap_mem (x_tilde m_idx)
          · exact ⟨MvPolynomial.X (r, m_idx), MvPolynomial.aeval_X t₁ (r, m_idx)⟩
        · intro m_idx
          exact ⟨MvPolynomial.X (r, m_idx), MvPolynomial.aeval_X t₁ (r, m_idx)⟩
      have h_res := h_trdeg_from_gen t₁ (Algebra.adjoin F (Set.range w)) h_le hFrac
      simpa using h_res
    · intro d ν hν v_tilde U_tilde hUv w hInc hMinors hFrac
      let T_v : (Fin N → F) →ₗ[F] (Fin d → F) := Matrix.vecMulLinear v_tilde
      have hSurj_Tv : Function.Surjective T_v := by
        intro y
        refine ⟨fun m_idx => ∑ δ : Fin d, y δ * U_tilde δ m_idx, ?_⟩
        ext β
        change Matrix.vecMul (Matrix.vecMul y U_tilde) v_tilde β = y β
        rw [Matrix.vecMul_vecMul, hUv, Matrix.vecMul_one]
      have h_rk_eq : d + Module.finrank F ↥(LinearMap.ker T_v) = N := by
        have hr := LinearMap.finrank_range_add_finrank_ker T_v
        rw [LinearMap.range_eq_top.mpr hSurj_Tv, finrank_top,
          Module.finrank_fin_fun, Module.finrank_fin_fun] at hr
