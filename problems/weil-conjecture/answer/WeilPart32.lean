    rw [hev_C, CommRingCat.ofHom_id, Spec.map_id]

  have h_w_Zu₀ : (ι_Zu₀ ≫ π₀_sch) ≫ Z_bar.hom = Limits.pullback.snd f₀_sch u₀_sec := by
    rw [Category.assoc, hcomm_Z, ← Category.assoc, Limits.pullback.condition,
      Category.assoc, hu₀_hom, Category.comp_id]

  let j_u₀ : Z_bar.left ⟶ Q₁ := Limits.pullback.lift (𝟙 Z_bar.left) (Z_bar.hom ≫ u₀_sec)
    (by rw [Category.id_comp, Category.assoc, hu₀_hom, Category.comp_id])

  have hPb_ju₀ : IsPullback j_u₀ Z_bar.hom p₁_P u₀_sec := by
    refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
