        change E_ring (Ideal.Quotient.mk (Ideal.span {a}) (φ_A c) * q) =
          Ideal.Quotient.mk (Ideal.span {b}) (φ_B c) * E_ring q
        rw [map_mul]
        congr 1
        apply Ψ_B.injective
        change Ψ_B (Ψ_B.symm ((Ideal.quotEquivOfEq hspan) (Ψ_A (Ideal.Quotient.mk (Ideal.span {a}) (φ_A c))))) =
          Ψ_B (Ideal.Quotient.mk (Ideal.span {b}) (φ_B c))
        rw [Ψ_B.apply_symm_apply, hΨ_A, hΨ_B, Ideal.quotEquivOfEq_mk, hres_φ c] }⟩

  · 
    intro A _ _ hFT p _ u
    obtain ⟨s_fin, hs_top⟩ := hFT.out
    let ψ : MvPolynomial ↥s_fin k →ₐ[k] A := MvPolynomial.aeval (Subtype.val : ↥s_fin → A)
    have hψ_surj : Function.Surjective ψ := by
      rw [← AlgHom.range_eq_top, MvPolynomial.aeval_range, Subtype.range_coe_subtype]
      simpa using hs_top
    let : Field (A ⧸ p) := Ideal.Quotient.field p
    let π_ψ : MvPolynomial ↥s_fin k →ₐ[k] (A ⧸ p) := (Ideal.Quotient.mkₐ k p).comp ψ
    have hπψ_surj : Function.Surjective π_ψ.toRingHom :=
      (Ideal.Quotient.mk_surjective).comp hψ_surj
    have hKer_max : (RingHom.ker π_ψ.toRingHom).IsMaximal := by
      rw [Ideal.Quotient.maximal_ideal_iff_isField_quotient]
      exact (RingHom.quotientKerEquivOfSurjective hπψ_surj).toMulEquiv.isField
        (Field.toIsField (A ⧸ p))
    obtain ⟨b_pt, hb_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton
        (K := k) (σ := ↥s_fin) (I := RingHom.ker π_ψ.toRingHom)).mp hKer_max
    obtain ⟨Q, rfl⟩ := hψ_surj u
    let t₀ : k := MvPolynomial.eval b_pt Q
    refine ⟨t₀, ?_⟩
    have hmem_van : Q - MvPolynomial.C t₀ ∈ MvPolynomial.vanishingIdeal k ({b_pt} : Set (↥s_fin → k)) := by
      rw [MvPolynomial.mem_vanishingIdeal_singleton_iff]
      simp [t₀]
    have hmem_ker : Q - MvPolynomial.C t₀ ∈ RingHom.ker π_ψ.toRingHom := by
      rwa [hb_pt]
    have hq_zero : Ideal.Quotient.mk p (ψ Q - algebraMap k A t₀) = 0 := by
      have h0 : π_ψ (Q - MvPolynomial.C t₀) = 0 := hmem_ker
      simpa [π_ψ] using h0
    exact Ideal.Quotient.eq_zero_iff_mem.mp hq_zero

