      let J_V : Matrix (Fin ((2 * m + 2) + 1)) (Fin (M + 1)) A :=
        Matrix.of (Fin.cases X_full (fun i μ => D_V i (X_full μ)))
      IsDomain A ∧
      Algebra.FiniteType k A ∧
      Algebra.trdeg k A ≤ ((2 * m + 2 : ℕ) : Cardinal.{u}) ∧
      AlgebraicGeometry.Etale (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_V)) ∧
      (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_V) ≫
