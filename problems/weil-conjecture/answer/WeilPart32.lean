          invFun := Fin.lastCases (Sum.inr ()) Sum.inl
          left_inv := by rintro (a | ⟨⟩) <;> simp
          right_inv := by refine Fin.lastCases ?_ (fun a => ?_) <;> simp }
      let B₁₂ : Matrix (Fin s) Unit A := Matrix.of fun a _ => M₁ a γ₀
      let C₂₁ : Matrix Unit (Fin s) A :=
        Matrix.of fun _ b => φ (MvPolynomial.pderiv (Fin.castAdd d b) (Ψ m'))
      let D₂₂ : Matrix Unit Unit A :=
        Matrix.of fun _ _ => φ (MvPolynomial.pderiv (Fin.natAdd s γ₀) (Ψ m'))
      have hBlk : Matrix.reindex e_blk.symm e_blk.symm N_lhs =
