        IsScalarTower.of_algebraMap_eq' hcomp_eq.symm
      have : Algebra.Etale (MvPolynomial (Fin d) k) P_aux :=
        RingHom.etale_algebraMap.mp (RingHom.Etale.of_bijective e₁.bijective)
      have : Algebra.Etale P_aux A := RingHom.etale_algebraMap.mp h1
      exact RingHom.etale_algebraMap.mpr (Algebra.Etale.comp (MvPolynomial (Fin d) k) P_aux A)
    have hψz_X_apply : ∀ i : Fin d,
        ψ_z (MvPolynomial.X i) = ψ_V (MvPolynomial.X i) - algebraMap k A (a₀ i) := by
      intro i
      change ψ_V (τ_fwd (MvPolynomial.X i)) = _
      simp [τ_fwd, hψV_C_apply]
    have hψz_mem : ∀ i : Fin d, ψ_z (MvPolynomial.X i) ∈ p_z := by
      intro i
      rw [← hKer_evz, RingHom.mem_ker]
      change ev_z (ψ_z (MvPolynomial.X i)) = 0
      rw [hψz_X_apply, map_sub, ev_z.commutes]
      exact sub_self (a₀ i)
    have hevz_ψz : ∀ P : MvPolynomial (Fin d) k,
        ev_z (ψ_z P) = MvPolynomial.constantCoeff P := by
      have hhom : ev_z.toRingHom.comp ψ_z = MvPolynomial.constantCoeff := by
        apply MvPolynomial.ringHom_ext
        · intro r
          change ev_z (ψ_z (MvPolynomial.C r)) = _
          have hc : ψ_z (MvPolynomial.C r) = algebraMap k A r := RingHom.congr_fun hψz_alg r
          rw [hc, ev_z.commutes, MvPolynomial.constantCoeff_C]
          rfl
        · intro i
          have hm : ψ_z (MvPolynomial.X i) ∈ RingHom.ker ev_z.toRingHom := by
            rw [hKer_evz]; exact hψz_mem i
          change ev_z.toRingHom (ψ_z (MvPolynomial.X i)) = _
          rw [hm, MvPolynomial.constantCoeff_X]
      exact fun P => RingHom.congr_fun hhom P
    have hDV_ψz : ∀ (i : Fin d) (P : MvPolynomial (Fin d) k),
        D_V i (ψ_z P) = ψ_z (MvPolynomial.pderiv i P) := by
      intro i P
      induction P using MvPolynomial.induction_on with
      | C r =>
        have hc : ψ_z (MvPolynomial.C r) = algebraMap k A r := RingHom.congr_fun hψz_alg r
        rw [hc, (D_V i).map_algebraMap, MvPolynomial.pderiv_C, map_zero]
      | add P₁ P₂ ih₁ ih₂ =>
        simp only [map_add, ih₁, ih₂]
      | mul_X P₁ j ih =>
        rw [map_mul, (D_V i).leibniz, smul_eq_mul, smul_eq_mul, ih,
          MvPolynomial.pderiv_mul, map_add, map_mul, map_mul, mul_comm (ψ_z (MvPolynomial.X j)),
          add_comm]
        congr 1
        rw [hψz_X_apply, map_sub, (D_V i).map_algebraMap, sub_zero, hDV_X i j,
          MvPolynomial.pderiv_X, Pi.single_apply]
        by_cases hij : i = j
        · subst hij; simp
        · simp [hij, Ne.symm hij]
    let ev_loc : Localization.AtPrime p_z →ₐ[k] k :=
      IsLocalization.liftAlgHom (M := p_z.primeCompl) (S := Localization.AtPrime p_z) (f := ev_z)
        (by
          rintro ⟨s, hs⟩
          have hne : ev_z s ≠ 0 := by
            intro h0
            apply hs
            rw [← hKer_evz]
            exact h0
          exact IsUnit.mk0 _ hne)
    have hev_loc_alg : ∀ a : A, ev_loc (algebraMap A (Localization.AtPrime p_z) a) = ev_z a :=
      fun a => IsLocalization.lift_eq _ a
    have hev_loc_surj : Function.Surjective ev_loc.toRingHom := fun r =>
      ⟨algebraMap k (Localization.AtPrime p_z) r, ev_loc.commutes r⟩
    have hKer_ev_loc :
        RingHom.ker ev_loc.toRingHom = IsLocalRing.maximalIdeal (Localization.AtPrime p_z) :=
      IsLocalRing.eq_maximalIdeal
        (RingHom.ker_isMaximal_of_surjective ev_loc.toRingHom hev_loc_surj)
    let 𝔪_T : Ideal (MvPolynomial (Fin d) k) := Ideal.span (Set.range MvPolynomial.X)
    let J_deg : ℕ → Ideal (MvPolynomial (Fin d) k) := fun n =>
      { carrier := { P : MvPolynomial (Fin d) k |
          ∀ s : Fin d →₀ ℕ, Finsupp.degree s < n → P.coeff s = 0 }
        add_mem' := fun {P Q} hP hQ s hs => by
          rw [MvPolynomial.coeff_add, hP s hs, hQ s hs, add_zero]
        zero_mem' := fun s _ => by simp
        smul_mem' := fun G {P} hP s hs => by
          change (G * P).coeff s = 0
          rw [MvPolynomial.coeff_mul]
          refine Finset.sum_eq_zero fun x hx => ?_
          have hx_sum : x.1 + x.2 = s := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
          have hdeg_sum : Finsupp.degree x.1 + Finsupp.degree x.2 = Finsupp.degree s := by
            rw [← map_add, hx_sum]
          have hx2 : Finsupp.degree x.2 < n := by omega
          rw [hP x.2 hx2, mul_zero] }
    have h𝔪T_le_J1 : 𝔪_T ≤ J_deg 1 := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩ s hs
      have hs0 : s = 0 := hDeg0 (by omega)
      subst hs0
      simp [MvPolynomial.coeff_X']
    have hJ_mul : ∀ a b : ℕ, J_deg a * J_deg b ≤ J_deg (a + b) := by
      intro a b
      rw [Submodule.mul_le]
      intro P hP Q hQ s hs
      rw [MvPolynomial.coeff_mul]
      refine Finset.sum_eq_zero fun x hx => ?_
      have hx_sum : x.1 + x.2 = s := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
      have hdeg_sum : Finsupp.degree x.1 + Finsupp.degree x.2 = Finsupp.degree s := by
        rw [← map_add, hx_sum]
      by_cases hx1 : Finsupp.degree x.1 < a
      · rw [hP x.1 hx1, zero_mul]
      · have hx2 : Finsupp.degree x.2 < b := by omega
        rw [hQ x.2 hx2, mul_zero]
    have h𝔪T_pow_eq : ∀ n : ℕ, 𝔪_T ^ n = J_deg n := by
      intro n
      apply le_antisymm
      · induction n with
        | zero =>
          rw [pow_zero]
          intro P _ s hs
          omega
        | succ n ih =>
          rw [pow_succ]
          exact (hMulMono ih h𝔪T_le_J1).trans (hJ_mul n 1)
      · intro P hP
        rw [← P.sum_single]
        refine Ideal.sum_mem (𝔪_T ^ n) fun s hs => ?_
        have hs_ge : n ≤ Finsupp.degree s := by
          by_contra hlt
          exact MvPolynomial.mem_support_iff.mp hs (hP s (lt_of_not_ge hlt))
        change MvPolynomial.monomial s (P.coeff s) ∈ 𝔪_T ^ n
        rw [MvPolynomial.monomial_eq]
        refine Ideal.mul_mem_left (𝔪_T ^ n) _ ?_
        have hprod_mem : ∀ S_fin : Finset (Fin d),
            (∏ i ∈ S_fin, (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ s i) ∈
              𝔪_T ^ (∑ i ∈ S_fin, s i) := by
          intro S_fin
          induction S_fin using Finset.induction_on with
          | empty => simp
          | insert i S_fin hi ih =>
            rw [Finset.prod_insert hi, Finset.sum_insert hi, pow_add]
            have hXi : (MvPolynomial.X i : MvPolynomial (Fin d) k) ∈ 𝔪_T :=
              Ideal.subset_span ⟨i, rfl⟩
            exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hXi (s i)) ih
        exact Ideal.pow_le_pow_right hs_ge
          (by simpa [Finsupp.prod, Finsupp.degree_apply] using hprod_mem s.support)
    have hInfIso : ∀ (ψ_loc : MvPolynomial (Fin d) k →+* Localization.AtPrime p_z) (n : ℕ),
        1 ≤ n →
        ψ_loc.comp MvPolynomial.C = algebraMap k (Localization.AtPrime p_z) →
        @Algebra.FormallyEtale (MvPolynomial (Fin d) k) (Localization.AtPrime p_z) _ _
          ψ_loc.toAlgebra →
        (∀ i : Fin d, ψ_loc (MvPolynomial.X i) ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) →
        ∃ θ_bar : (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n) ≃ₐ[k]
            (Localization.AtPrime p_z ⧸
              (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ n),
          ∀ P : MvPolynomial (Fin d) k, θ_bar (Ideal.Quotient.mk (𝔪_T ^ n) P) =
            Ideal.Quotient.mk ((IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ n)
              (ψ_loc P) := by
      intro ψ_loc n hn h_alg h_fe h_mem
      let 𝔪_loc := IsLocalRing.maximalIdeal (Localization.AtPrime p_z)
      let _ : Algebra (MvPolynomial (Fin d) k) (Localization.AtPrime p_z) := ψ_loc.toAlgebra
      have : Algebra.FormallyEtale (MvPolynomial (Fin d) k) (Localization.AtPrime p_z) := h_fe
      have : IsScalarTower k (MvPolynomial (Fin d) k) (Localization.AtPrime p_z) :=
        { smul_assoc := fun r P x => by
            change ψ_loc (r • P) * x = r • (ψ_loc P * x)
            have hc : ψ_loc (MvPolynomial.C r) = algebraMap k (Localization.AtPrime p_z) r :=
              RingHom.congr_fun h_alg r
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, MvPolynomial.algebraMap_eq, hc,
              mul_assoc] }
      let _ : Algebra (MvPolynomial (Fin d) k) k := MvPolynomial.constantCoeff.toAlgebra
      have : IsScalarTower k (MvPolynomial (Fin d) k) k :=
        { smul_assoc := fun r P x => by
            change MvPolynomial.constantCoeff (r • P) * x = r * (MvPolynomial.constantCoeff P * x)
            rw [Algebra.smul_def, map_mul, MvPolynomial.algebraMap_eq, MvPolynomial.constantCoeff_C,
              mul_assoc] }
      have h_map_𝔪 : Ideal.map ψ_loc 𝔪_T ≤ 𝔪_loc := by
        rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        exact h_mem i
      have h_map_pow : Ideal.map ψ_loc (𝔪_T ^ n) ≤ 𝔪_loc ^ n := by
        rw [Ideal.map_pow]
        exact hIdealPowMono h_map_𝔪 n
      have h_le_ker_θ : 𝔪_T ^ n ≤
          RingHom.ker ((Ideal.Quotient.mkₐ (MvPolynomial (Fin d) k) (𝔪_loc ^ n)).comp
            (Algebra.ofId (MvPolynomial (Fin d) k) (Localization.AtPrime p_z))).toRingHom := by
        intro P hP
        rw [RingHom.mem_ker]
        change Ideal.Quotient.mk (𝔪_loc ^ n) (ψ_loc P) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact h_map_pow (Ideal.mem_map_of_mem ψ_loc hP)
      let θ_PT : (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n) →ₐ[MvPolynomial (Fin d) k]
          (Localization.AtPrime p_z ⧸ 𝔪_loc ^ n) :=
        Ideal.Quotient.liftₐ (𝔪_T ^ n)
          ((Ideal.Quotient.mkₐ (MvPolynomial (Fin d) k) (𝔪_loc ^ n)).comp
            (Algebra.ofId (MvPolynomial (Fin d) k) (Localization.AtPrime p_z)))
          (fun P hP => h_le_ker_θ hP)
      have hev_ψ_loc : ev_loc.toRingHom.comp ψ_loc = MvPolynomial.constantCoeff := by
        apply MvPolynomial.ringHom_ext
        · intro r
          change ev_loc (ψ_loc (MvPolynomial.C r)) = _
          have hc : ψ_loc (MvPolynomial.C r) = algebraMap k (Localization.AtPrime p_z) r :=
            RingHom.congr_fun h_alg r
          rw [hc, ev_loc.commutes, MvPolynomial.constantCoeff_C]
          rfl
        · intro i
          have hm : ψ_loc (MvPolynomial.X i) ∈ RingHom.ker ev_loc.toRingHom := by
            rw [hKer_ev_loc]; exact h_mem i
          change ev_loc.toRingHom (ψ_loc (MvPolynomial.X i)) = _
          rw [hm, MvPolynomial.constantCoeff_X]
      let f_res : Localization.AtPrime p_z →ₐ[MvPolynomial (Fin d) k] k :=
        { toRingHom := ev_loc.toRingHom
          commutes' := fun P => RingHom.congr_fun hev_ψ_loc P }
      have h𝔪T_n_le_cc : ∀ P ∈ 𝔪_T ^ n, (Algebra.ofId (MvPolynomial (Fin d) k) k) P = 0 := by
        intro P hP
        rw [h𝔪T_pow_eq n] at hP
        change P.coeff 0 = 0
        exact hP 0 (by simp; omega)
      let g_n : (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n) →ₐ[MvPolynomial (Fin d) k] k :=
        Ideal.Quotient.liftₐ (𝔪_T ^ n) (Algebra.ofId (MvPolynomial (Fin d) k) k) h𝔪T_n_le_cc
      have hg_surj : Function.Surjective g_n := fun r =>
        ⟨Ideal.Quotient.mk (𝔪_T ^ n) (MvPolynomial.C r), by
          change MvPolynomial.constantCoeff (MvPolynomial.C r) = r
          exact MvPolynomial.constantCoeff_C (σ := Fin d) r⟩
      have hg_ker_le : RingHom.ker (g_n : (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n) →+* k) ≤
          Ideal.map (Ideal.Quotient.mk (𝔪_T ^ n)) 𝔪_T := by
        intro x hx
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
        have hP0 : P.coeff 0 = 0 := hx
        have hP_J1 : P ∈ 𝔪_T := by
          rw [← pow_one 𝔪_T, h𝔪T_pow_eq 1]
          intro s hs
          have hs0 : s = 0 := hDeg0 (by omega)
          subst hs0
          exact hP0
        exact Ideal.mem_map_of_mem _ hP_J1
      have hg_ker_bot : (RingHom.ker (g_n : (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n) →+* k)) ^ n = ⊥ := by
        apply le_bot_iff.mp
        calc (RingHom.ker (g_n : (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n) →+* k)) ^ n
            ≤ (Ideal.map (Ideal.Quotient.mk (𝔪_T ^ n)) 𝔪_T) ^ n := hIdealPowMono hg_ker_le n
          _ = Ideal.map (Ideal.Quotient.mk (𝔪_T ^ n)) (𝔪_T ^ n) := (Ideal.map_pow _ _ _).symm
          _ = ⊥ := Ideal.map_quotient_self (𝔪_T ^ n)
      have hg_nil : IsNilpotent (RingHom.ker (g_n : (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n) →+* k)) :=
        ⟨n, hg_ker_bot⟩
      let σ_tilde : Localization.AtPrime p_z →ₐ[MvPolynomial (Fin d) k]
          (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n) :=
        Algebra.FormallySmooth.liftOfSurjective f_res g_n hg_surj hg_nil
      have hcomp_σ : g_n.comp σ_tilde = f_res :=
        Algebra.FormallySmooth.comp_liftOfSurjective f_res g_n hg_surj hg_nil
      have h𝔪Rz_le_ker : Ideal.map σ_tilde.toRingHom 𝔪_loc ≤
          RingHom.ker (g_n : (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n) →+* k) := by
        rw [Ideal.map_le_iff_le_comap]
        intro r hr
        rw [Ideal.mem_comap, RingHom.mem_ker]
        change (g_n.comp σ_tilde) r = 0
        rw [hcomp_σ]
        change ev_loc.toRingHom r = 0
        rw [← RingHom.mem_ker, hKer_ev_loc]
        exact hr
      have h𝔪Rz_n_kill : ∀ r ∈ 𝔪_loc ^ n, σ_tilde r = 0 := by
        intro r hr
        have hmem : σ_tilde.toRingHom r ∈ Ideal.map σ_tilde.toRingHom (𝔪_loc ^ n) :=
          Ideal.mem_map_of_mem _ hr
        rw [Ideal.map_pow] at hmem
        have h0 : σ_tilde.toRingHom r ∈ (⊥ : Ideal (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n)) := by
          rw [← hg_ker_bot]
          exact hIdealPowMono h𝔪Rz_le_ker n hmem
        exact h0
      let σ_PT : (Localization.AtPrime p_z ⧸ 𝔪_loc ^ n) →ₐ[MvPolynomial (Fin d) k]
          (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n) :=
        Ideal.Quotient.liftₐ (𝔪_loc ^ n) σ_tilde h𝔪Rz_n_kill
      have h_left_inv : ∀ x : MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n, σ_PT (θ_PT x) = x := by
        intro x
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
        change σ_tilde (ψ_loc P) = Ideal.Quotient.mk (𝔪_T ^ n) P
        change σ_tilde (algebraMap (MvPolynomial (Fin d) k) (Localization.AtPrime p_z) P) =
          algebraMap (MvPolynomial (Fin d) k) (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n) P
        exact σ_tilde.commutes P
      let I_Rz : Ideal (Localization.AtPrime p_z ⧸ 𝔪_loc ^ n) :=
        Ideal.map (Ideal.Quotient.mk (𝔪_loc ^ n)) 𝔪_loc
      have hI_Rz_nil : IsNilpotent I_Rz := by
        refine ⟨n, ?_⟩
        dsimp only [I_Rz]
        rw [← Ideal.map_pow, Ideal.map_quotient_self, Ideal.zero_eq_bot]
      have h_fres_pow : ∀ r ∈ 𝔪_loc ^ n, f_res r = 0 := by
        intro r hr
        have hn_ne : n ≠ 0 := by omega
        have hr1 : r ∈ IsLocalRing.maximalIdeal (Localization.AtPrime p_z) :=
          Ideal.pow_le_self hn_ne hr
        rw [← hKer_ev_loc] at hr1
        exact hr1
      let h_n : (Localization.AtPrime p_z ⧸ 𝔪_loc ^ n) →ₐ[MvPolynomial (Fin d) k] k :=
        Ideal.Quotient.liftₐ (𝔪_loc ^ n) f_res h_fres_pow
      have h_ker_hn : RingHom.ker h_n.toRingHom ≤ I_Rz := by
        intro y hy
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
        have hr : r ∈ RingHom.ker ev_loc.toRingHom := hy
        rw [hKer_ev_loc] at hr
        exact Ideal.mem_map_of_mem _ hr
      have h_hn_θ : h_n.comp θ_PT = g_n := by
        apply AlgHom.ext
        intro x
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
        change f_res (ψ_loc P) = MvPolynomial.constantCoeff P
        exact RingHom.congr_fun hev_ψ_loc P
      let α₁ : Localization.AtPrime p_z →ₐ[MvPolynomial (Fin d) k]
          (Localization.AtPrime p_z ⧸ 𝔪_loc ^ n) := θ_PT.comp σ_tilde
      let α₂ : Localization.AtPrime p_z →ₐ[MvPolynomial (Fin d) k]
          (Localization.AtPrime p_z ⧸ 𝔪_loc ^ n) :=
        Ideal.Quotient.mkₐ (MvPolynomial (Fin d) k) (𝔪_loc ^ n)
      have hα_eq : α₁ = α₂ := by
        refine Algebra.FormallyUnramified.ext I_Rz hI_Rz_nil fun r => ?_
        rw [Ideal.Quotient.eq]
        apply h_ker_hn
        rw [RingHom.mem_ker, map_sub, sub_eq_zero]
        change (h_n.comp (θ_PT.comp σ_tilde)) r = (h_n.comp α₂) r
        rw [← AlgHom.comp_assoc, h_hn_θ, hcomp_σ]
        rfl
      have h_right_inv : ∀ y : Localization.AtPrime p_z ⧸ 𝔪_loc ^ n, θ_PT (σ_PT y) = y := by
        intro y
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
        exact AlgHom.congr_fun hα_eq r
      let e_PT : (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ n) ≃ₐ[MvPolynomial (Fin d) k]
          (Localization.AtPrime p_z ⧸ 𝔪_loc ^ n) :=
        AlgEquiv.ofAlgHom θ_PT σ_PT (AlgHom.ext h_right_inv) (AlgHom.ext h_left_inv)
      exact ⟨e_PT.restrictScalars k, fun P => rfl⟩
    have hLeibnizPow : ∀ (D : Derivation k A A) (I : Ideal A) (r : ℕ),
        1 ≤ r → ∀ x ∈ I ^ (r + 1), D x ∈ I ^ r := by
      intro D I r hr
      obtain ⟨m, rfl⟩ : ∃ m : ℕ, r = m + 1 := ⟨r - 1, (Nat.sub_add_cancel hr).symm⟩
      clear hr
      induction m with
      | zero =>
        intro x hx
        rw [pow_one]
        rw [show 0 + 1 + 1 = 2 from rfl, sq] at hx
        refine Submodule.mul_induction_on hx ?_ ?_
        · intro a ha b hb
          rw [D.leibniz, smul_eq_mul, smul_eq_mul]
          exact Ideal.add_mem I (Ideal.mul_mem_right _ I ha) (Ideal.mul_mem_right _ I hb)
        · intro x y hx hy
          rw [map_add]
          exact Ideal.add_mem I hx hy
      | succ m ih =>
        intro x hx
        have hsplit : I ^ (m + 1 + 1 + 1) = I * I ^ (m + 1 + 1) := by
          rw [pow_succ']
        rw [hsplit] at hx
        refine Submodule.mul_induction_on hx ?_ ?_
        · intro a ha b hb
          rw [D.leibniz, smul_eq_mul, smul_eq_mul, pow_succ']
          have hb' : b ∈ I * I ^ (m + 1) := by
            rw [← pow_succ']
            exact Ideal.pow_le_pow_right (by omega) hb
          exact Ideal.add_mem _ (Ideal.mul_mem_mul ha (ih b hb))
            (Ideal.mul_mem_right _ _ hb')
        · intro x y hx hy
          rw [map_add]
          exact Ideal.add_mem _ hx hy
    have hClearDenom : ∀ (n : ℕ) (x : A),
        algebraMap A (Localization.AtPrime p_z) x ∈
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ n →
        ∃ s₀ : A, s₀ ∉ p_z ∧ s₀ * x ∈ p_z ^ n := by
      intro n x hx
      have hmap_max : Ideal.map (algebraMap A (Localization.AtPrime p_z)) (p_z ^ n) =
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ n := by
        rw [Ideal.map_pow, IsLocalization.AtPrime.map_eq_maximalIdeal p_z (Localization.AtPrime p_z)]
      rw [← hmap_max,
        IsLocalization.mem_map_algebraMap_iff p_z.primeCompl (Localization.AtPrime p_z)] at hx
      obtain ⟨⟨⟨y, hy⟩, ⟨s₁, hs₁⟩⟩, heq⟩ := hx
      rw [← map_mul] at heq
      obtain ⟨⟨c, hc⟩, hc_eq⟩ :=
        (IsLocalization.eq_iff_exists p_z.primeCompl (Localization.AtPrime p_z)).mp heq
      refine ⟨c * s₁, p_z.primeCompl.mul_mem hc hs₁, ?_⟩
      have hmul : (c * s₁) * x = c * y := by
        calc (c * s₁) * x = c * (x * s₁) := by ring
          _ = c * y := hc_eq
      rw [hmul]
      exact Ideal.mul_mem_left (p_z ^ n) c hy
    have hMod2_vanish : ∀ x : A,
        algebraMap A (Localization.AtPrime p_z) x ∈
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 2 →
        ev_z x = 0 ∧ ∀ i : Fin d, ev_z (D_V i x) = 0 := by
      intro x hx
      obtain ⟨s₀, hs₀, hsx⟩ := hClearDenom 2 x hx
      have hsx_p : s₀ * x ∈ p_z := Ideal.pow_le_self (by decide : 2 ≠ 0) hsx
      have hx_p : x ∈ p_z :=
        (Ideal.IsPrime.mem_or_mem inferInstance hsx_p).resolve_left hs₀
      have hex0 : ev_z x = 0 := by
        change x ∈ RingHom.ker ev_z.toRingHom
        rwa [hKer_evz]
      refine ⟨hex0, fun i => ?_⟩
      have hD_sx : D_V i (s₀ * x) ∈ p_z := by
        simpa only [pow_one] using hLeibnizPow (D_V i) p_z 1 (le_refl 1) (s₀ * x) hsx
      rw [(D_V i).leibniz, smul_eq_mul, smul_eq_mul] at hD_sx
      have hsDx : s₀ * D_V i x ∈ p_z := by
        have hsub := Ideal.sub_mem p_z hD_sx (Ideal.mul_mem_right (D_V i s₀) p_z hx_p)
        rwa [add_sub_cancel_right] at hsub
      have hDx_p : D_V i x ∈ p_z :=
        (Ideal.IsPrime.mem_or_mem inferInstance hsDx).resolve_left hs₀
      change D_V i x ∈ RingHom.ker ev_z.toRingHom
      rwa [hKer_evz]
    have hMod3_vanish : ∀ x : A,
        algebraMap A (Localization.AtPrime p_z) x ∈
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 3 →
        ∀ i j : Fin d, ev_z (D_V j (D_V i x)) = 0 := by
      intro x hx i j
      obtain ⟨s₀, hs₀, hsx⟩ := hClearDenom 3 x hx
      have hsx2 : s₀ * x ∈ p_z ^ 2 := Ideal.pow_le_pow_right (by decide : 2 ≤ 3) hsx
      have hx_p : x ∈ p_z :=
        (Ideal.IsPrime.mem_or_mem inferInstance
          (Ideal.pow_le_self (by decide : 2 ≠ 0) hsx2)).resolve_left hs₀
      have hDx_p : ∀ r : Fin d, D_V r x ∈ p_z := by
        intro r
        have h1 : D_V r (s₀ * x) ∈ p_z := by
          simpa only [pow_one] using hLeibnizPow (D_V r) p_z 1 (le_refl 1) (s₀ * x) hsx2
        rw [(D_V r).leibniz, smul_eq_mul, smul_eq_mul] at h1
        have h2 := Ideal.sub_mem p_z h1 (Ideal.mul_mem_right (D_V r s₀) p_z hx_p)
        rw [add_sub_cancel_right] at h2
        exact (Ideal.IsPrime.mem_or_mem inferInstance h2).resolve_left hs₀
      have hDi_p2 : D_V i (s₀ * x) ∈ p_z ^ 2 :=
        hLeibnizPow (D_V i) p_z 2 (by decide) (s₀ * x) hsx
      have hDjDi_p : D_V j (D_V i (s₀ * x)) ∈ p_z := by
        simpa only [pow_one] using hLeibnizPow (D_V j) p_z 1 (le_refl 1) _ hDi_p2
      have hexpand : D_V j (D_V i (s₀ * x)) =
          s₀ * D_V j (D_V i x) +
            (D_V i x * D_V j s₀ + (x * D_V j (D_V i s₀) + D_V j x * D_V i s₀)) := by
        rw [(D_V i).leibniz, smul_eq_mul, smul_eq_mul, map_add,
          (D_V j).leibniz, (D_V j).leibniz, smul_eq_mul, smul_eq_mul, smul_eq_mul, smul_eq_mul]
        ring
      rw [hexpand] at hDjDi_p
      have hrest_p : D_V i x * D_V j s₀ + (x * D_V j (D_V i s₀) + D_V j x * D_V i s₀) ∈ p_z :=
        Ideal.add_mem p_z (Ideal.mul_mem_right _ p_z (hDx_p i))
          (Ideal.add_mem p_z (Ideal.mul_mem_right _ p_z hx_p)
            (Ideal.mul_mem_right _ p_z (hDx_p j)))
      have hsDDx : s₀ * D_V j (D_V i x) ∈ p_z := by
        have hsub := Ideal.sub_mem p_z hDjDi_p hrest_p
        rwa [add_sub_cancel_right] at hsub
      have hDDx_p : D_V j (D_V i x) ∈ p_z :=
        (Ideal.IsPrime.mem_or_mem inferInstance hsDDx).resolve_left hs₀
      change D_V j (D_V i x) ∈ RingHom.ker ev_z.toRingHom
      rwa [hKer_evz]
    let ψz_loc : MvPolynomial (Fin d) k →+* Localization.AtPrime p_z :=
      (algebraMap A (Localization.AtPrime p_z)).comp ψ_z
    have hψz_loc_alg : ψz_loc.comp MvPolynomial.C = algebraMap k (Localization.AtPrime p_z) := by
      ext r
      change algebraMap A (Localization.AtPrime p_z) (ψ_z (MvPolynomial.C r)) =
        algebraMap k (Localization.AtPrime p_z) r
      have hc : ψ_z (MvPolynomial.C r) = algebraMap k A r := RingHom.congr_fun hψz_alg r
      rw [hc, ← IsScalarTower.algebraMap_apply k A (Localization.AtPrime p_z)]
    have hψz_loc_fe : @Algebra.FormallyEtale (MvPolynomial (Fin d) k) (Localization.AtPrime p_z) _ _
        ψz_loc.toAlgebra := by
      let _ : Algebra (MvPolynomial (Fin d) k) A := ψ_z.toAlgebra
      have : Algebra.Etale (MvPolynomial (Fin d) k) A := RingHom.etale_algebraMap.mp hψz_et
      have : Algebra.FormallyEtale (MvPolynomial (Fin d) k) A := inferInstance
      have : Algebra.FormallyEtale A (Localization.AtPrime p_z) :=
        Algebra.FormallyEtale.of_isLocalization p_z.primeCompl
      have hfe_std : Algebra.FormallyEtale (MvPolynomial (Fin d) k) (Localization.AtPrime p_z) :=
        Algebra.FormallyEtale.comp (MvPolynomial (Fin d) k) A (Localization.AtPrime p_z)
      have hEquivFE : ∀ {R B₁ B₂ : Type u} [CommRing R] [CommRing B₁] [CommRing B₂]
          (alg₁ : Algebra R B₁) (alg₂ : Algebra R B₂),
          @Algebra.FormallyEtale R B₁ _ _ alg₁ →
          ∀ (e : B₁ ≃+* B₂),
            (∀ r : R, e (@algebraMap R B₁ _ _ alg₁ r) = @algebraMap R B₂ _ _ alg₂ r) →
            True ∧ @Algebra.FormallyEtale R B₂ _ _ alg₂ := by
        intro R B₁ B₂ _ _ _ alg₁ alg₂ hfe e hcomm
        let _ : Algebra R B₁ := alg₁
        let _ : Algebra R B₂ := alg₂
        have : Algebra.FormallyEtale R B₁ := hfe
        let e_alg : B₁ ≃ₐ[R] B₂ := { e with commutes' := hcomm }
        exact ⟨trivial, Algebra.FormallyEtale.of_equiv e_alg⟩
      exact (hEquivFE inferInstance ψz_loc.toAlgebra hfe_std
        (RingEquiv.refl (Localization.AtPrime p_z))
        (fun P => IsScalarTower.algebraMap_apply (MvPolynomial (Fin d) k) A
          (Localization.AtPrime p_z) P)).2
    have hψz_loc_mem : ∀ i : Fin d, ψz_loc (MvPolynomial.X i) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime p_z) := by
      intro i
      change algebraMap A (Localization.AtPrime p_z) (ψ_z (MvPolynomial.X i)) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime p_z)
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p_z (Localization.AtPrime p_z)]
      exact Ideal.mem_map_of_mem _ (hψz_mem i)
    have hHomog0_eq : ∀ P : MvPolynomial (Fin d) k,
        MvPolynomial.homogeneousComponent 0 P = MvPolynomial.C (P.coeff 0) := by
      intro P
      ext s
      rw [MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_C]
      by_cases hs : s = 0
      · subst hs; simp
      · have hdeg : Finsupp.degree s ≠ 0 := fun h0 => hs (hDeg0 h0)
        simp [Ne.symm hs, hdeg]
    have hHomog1_eq : ∀ P : MvPolynomial (Fin d) k,
        MvPolynomial.homogeneousComponent 1 P =
          ∑ i : Fin d, MvPolynomial.C (P.coeff (Finsupp.single i 1)) * MvPolynomial.X i := by
      intro P
      ext s
      rw [MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_sum]
      have hRHS : (∑ i : Fin d,
          (MvPolynomial.C (P.coeff (Finsupp.single i 1)) * MvPolynomial.X i).coeff s) =
          ∑ i : Fin d,
            if Finsupp.single i 1 = s then P.coeff (Finsupp.single i 1) else 0 := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X]
        split_ifs with h
        · rw [h, mul_one]
        · rw [mul_zero]
      rw [hRHS]
      by_cases hdeg : Finsupp.degree s = 1
      · rw [if_pos hdeg]
        have hex : ∃ i₀ : Fin d, s i₀ ≠ 0 := by
          by_contra hall
          rw [not_exists] at hall
          have hs0 : s = 0 := by ext i; exact not_not.mp (hall i)
          rw [hs0, map_zero] at hdeg
          omega
        obtain ⟨i₀, hi₀⟩ := hex
        have hs_eq : s = Finsupp.single i₀ 1 := by
          have hsum : ∑ i ∈ s.support, s i = 1 := by
            rwa [← Finsupp.degree_apply]
          have hi₀_mem : i₀ ∈ s.support := Finsupp.mem_support_iff.mpr hi₀
          have hsplit := Finset.add_sum_erase s.support (fun i => s i) hi₀_mem
          have hrest : ∑ i ∈ s.support.erase i₀, s i = 0 := by omega
          have hsi₀ : s i₀ = 1 := by omega
          ext i
          by_cases hi : i = i₀
          · subst hi; simp [hsi₀]
          · simp only [Finsupp.single_apply, if_neg (Ne.symm hi)]
            by_cases him : i ∈ s.support
            · exact (Finset.sum_eq_zero_iff_of_nonneg (fun _ _ => Nat.zero_le _)).mp hrest i
                (Finset.mem_erase.mpr ⟨hi, him⟩)
            · exact Finsupp.notMem_support_iff.mp him
        subst hs_eq
        rw [Finset.sum_eq_single i₀]
        · simp
        · intro i _ hne
          have hne' : Finsupp.single i 1 ≠ Finsupp.single i₀ 1 :=
            fun h => hne (Finsupp.single_left_injective (by decide : 1 ≠ 0) h)
          simp [hne']
        · intro habs; exact absurd (Finset.mem_univ _) habs
      · rw [if_neg hdeg]
        symm
        refine Finset.sum_eq_zero fun i _ => if_neg ?_
        rintro rfl
        exact hdeg (by simp [Finsupp.degree_apply])
    have hLin_eval : ∀ (c₀ : k) (w : Fin d → k),
        let L : MvPolynomial (Fin d) k :=
          MvPolynomial.C c₀ + ∑ i : Fin d, MvPolynomial.C (w i) * MvPolynomial.X i
        ev_z (ψ_z L) = c₀ ∧ ∀ j : Fin d, ev_z (D_V j (ψ_z L)) = w j := by
      intro c₀ w L
      refine ⟨?_, fun j => ?_⟩
      · rw [hevz_ψz]
        dsimp only [L]
        simp [map_add, map_sum, map_mul]
      · rw [hDV_ψz, hevz_ψz]
        dsimp only [L]
        rw [map_add, MvPolynomial.pderiv_C, zero_add, map_sum, map_sum]
        rw [Finset.sum_eq_single j]
        · simp [MvPolynomial.pderiv_mul]
        · intro i _ hij
          have hp0 : MvPolynomial.pderiv j (MvPolynomial.X i : MvPolynomial (Fin d) k) = 0 := by
            rw [MvPolynomial.pderiv_X, Pi.single_eq_of_ne hij]
          simp [hp0]
        · intro habs; exact absurd (Finset.mem_univ _) habs
    have hPart2 : ∀ (f : A) (c₀ : k) (w : Fin d → k),
        algebraMap A (Localization.AtPrime p_z)
          (f - ψ_z (MvPolynomial.C c₀ +
            ∑ i : Fin d, MvPolynomial.C (w i) * MvPolynomial.X i)) ∈
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 2 ↔
          (ev_z f = c₀ ∧ ∀ i : Fin d, ev_z (D_V i f) = w i) := by
      intro f c₀ w
      let L : MvPolynomial (Fin d) k :=
        MvPolynomial.C c₀ + ∑ i : Fin d, MvPolynomial.C (w i) * MvPolynomial.X i
      obtain ⟨hL0, hL1⟩ := hLin_eval c₀ w
      constructor
      · intro hmem
        obtain ⟨h0, h1⟩ := hMod2_vanish (f - ψ_z L) hmem
        rw [map_sub, hL0, sub_eq_zero] at h0
        refine ⟨h0, fun i => ?_⟩
        have hi := h1 i
        rw [map_sub, map_sub, hL1 i, sub_eq_zero] at hi
        exact hi
      · rintro ⟨hf0, hf1⟩
        let 𝔪_loc := IsLocalRing.maximalIdeal (Localization.AtPrime p_z)
        obtain ⟨θ₂, hθ₂_mk⟩ := hInfIso ψz_loc 2 (by decide) hψz_loc_alg hψz_loc_fe hψz_loc_mem
        obtain ⟨q_bar, hq_bar⟩ :=
          θ₂.surjective (Ideal.Quotient.mk (𝔪_loc ^ 2) (algebraMap A (Localization.AtPrime p_z) f))
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q_bar
        rw [hθ₂_mk P] at hq_bar
        have hdiff_P : algebraMap A (Localization.AtPrime p_z) (f - ψ_z P) ∈ 𝔪_loc ^ 2 := by
          rw [map_sub, ← Ideal.Quotient.eq]
          exact hq_bar.symm
        let P₀₁ : MvPolynomial (Fin d) k :=
          MvPolynomial.homogeneousComponent 0 P + MvPolynomial.homogeneousComponent 1 P
        have hP_rem : P - P₀₁ ∈ 𝔪_T ^ 2 := by
          rw [h𝔪T_pow_eq 2]
          intro s hs
          dsimp only [P₀₁]
          rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_add,
            MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_homogeneousComponent]
          have h01 : Finsupp.degree s = 0 ∨ Finsupp.degree s = 1 := by omega
          rcases h01 with h0 | h1
          · simp [h0]
          · simp [h1]
        have hψz_rem : algebraMap A (Localization.AtPrime p_z) (ψ_z (P - P₀₁)) ∈ 𝔪_loc ^ 2 := by
          rw [← Ideal.Quotient.eq_zero_iff_mem]
          change Ideal.Quotient.mk (𝔪_loc ^ 2) (ψz_loc (P - P₀₁)) = 0
          rw [← hθ₂_mk (P - P₀₁), (Ideal.Quotient.eq_zero_iff_mem).mpr hP_rem, map_zero]
        have hdiff_P01 : algebraMap A (Localization.AtPrime p_z) (f - ψ_z P₀₁) ∈ 𝔪_loc ^ 2 := by
          have hsum := Ideal.add_mem (𝔪_loc ^ 2) hdiff_P hψz_rem
          have heq : f - ψ_z P + ψ_z (P - P₀₁) = f - ψ_z P₀₁ := by
            rw [map_sub]; ring
          rwa [← map_add, heq] at hsum
        have hP₀₁_form : P₀₁ = MvPolynomial.C (P.coeff 0) +
            ∑ i : Fin d, MvPolynomial.C (P.coeff (Finsupp.single i 1)) * MvPolynomial.X i := by
          dsimp only [P₀₁]
          rw [hHomog0_eq, hHomog1_eq]
        rw [hP₀₁_form] at hdiff_P01
        obtain ⟨hL'0, hL'1⟩ := hLin_eval (P.coeff 0) (fun i => P.coeff (Finsupp.single i 1))
        obtain ⟨hc_eq, hw_eq⟩ := hMod2_vanish _ hdiff_P01
        rw [map_sub, hL'0, hf0, sub_eq_zero] at hc_eq
        have hw_eq' : ∀ i : Fin d, w i = P.coeff (Finsupp.single i 1) := fun i => by
          have hi := hw_eq i
          rw [map_sub, map_sub, hL'1 i, hf1 i, sub_eq_zero] at hi
          exact hi
        have hL_eq : (MvPolynomial.C (P.coeff 0) +
            ∑ i : Fin d, MvPolynomial.C (P.coeff (Finsupp.single i 1)) * MvPolynomial.X i) = L := by
          dsimp only [L]
          rw [← hc_eq]
          congr 1
          refine Finset.sum_congr rfl fun i _ => by rw [← hw_eq' i]
        rwa [hL_eq] at hdiff_P01
    have hPart3 : ∀ (f : A), ev_z f = 0 → (∀ i : Fin d, ev_z (D_V i f) = 0) →
        ∃ Q : MvPolynomial (Fin d) k,
          Q ∈ MvPolynomial.homogeneousSubmodule (Fin d) k 2 ∧
          (∀ i j : Fin d,
            MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q)) =
              ev_z (D_V j (D_V i f))) ∧
          algebraMap A (Localization.AtPrime p_z) (f - ψ_z Q) ∈
            (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 3 := by
      intro f hf0 hf1
      let 𝔪_loc := IsLocalRing.maximalIdeal (Localization.AtPrime p_z)
      obtain ⟨θ₃, hθ₃_mk⟩ := hInfIso ψz_loc 3 (by decide) hψz_loc_alg hψz_loc_fe hψz_loc_mem
      obtain ⟨q_bar, hq_bar⟩ :=
        θ₃.surjective (Ideal.Quotient.mk (𝔪_loc ^ 3) (algebraMap A (Localization.AtPrime p_z) f))
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q_bar
      rw [hθ₃_mk P] at hq_bar
      have hdiff_P : algebraMap A (Localization.AtPrime p_z) (f - ψ_z P) ∈ 𝔪_loc ^ 3 := by
        rw [map_sub, ← Ideal.Quotient.eq]
        exact hq_bar.symm
      let P₀₁ : MvPolynomial (Fin d) k :=
        MvPolynomial.homogeneousComponent 0 P + MvPolynomial.homogeneousComponent 1 P
      let Q : MvPolynomial (Fin d) k := MvPolynomial.homogeneousComponent 2 P
      have hQ_hom : Q ∈ MvPolynomial.homogeneousSubmodule (Fin d) k 2 := by
        rw [MvPolynomial.mem_homogeneousSubmodule]
        exact MvPolynomial.homogeneousComponent_isHomogeneous 2 P
      have hP_rem3 : P - (P₀₁ + Q) ∈ 𝔪_T ^ 3 := by
        rw [h𝔪T_pow_eq 3]
        intro s hs
        dsimp only [P₀₁, Q]
        rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_add, MvPolynomial.coeff_add,
          MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_homogeneousComponent,
          MvPolynomial.coeff_homogeneousComponent]
        have h012 : Finsupp.degree s = 0 ∨ Finsupp.degree s = 1 ∨ Finsupp.degree s = 2 := by omega
        rcases h012 with h0 | h1 | h2
        · simp [h0]
        · simp [h1]
        · simp [h2]
      have hψz_rem3 : algebraMap A (Localization.AtPrime p_z) (ψ_z (P - (P₀₁ + Q))) ∈ 𝔪_loc ^ 3 := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        change Ideal.Quotient.mk (𝔪_loc ^ 3) (ψz_loc (P - (P₀₁ + Q))) = 0
        rw [← hθ₃_mk, (Ideal.Quotient.eq_zero_iff_mem).mpr hP_rem3, map_zero]
      have hdiff_012 : algebraMap A (Localization.AtPrime p_z) (f - ψ_z (P₀₁ + Q)) ∈ 𝔪_loc ^ 3 := by
        have hsum := Ideal.add_mem (𝔪_loc ^ 3) hdiff_P hψz_rem3
        have heq : f - ψ_z P + ψ_z (P - (P₀₁ + Q)) = f - ψ_z (P₀₁ + Q) := by
          rw [map_sub]; ring
        rwa [← map_add, heq] at hsum
      have hQ_in_mT2 : Q ∈ 𝔪_T ^ 2 := by
        rw [h𝔪T_pow_eq 2]
        intro s hs
        dsimp only [Q]
        rw [MvPolynomial.coeff_homogeneousComponent, if_neg (by omega)]
      have hψzQ_m2 : algebraMap A (Localization.AtPrime p_z) (ψ_z Q) ∈ 𝔪_loc ^ 2 := by
        obtain ⟨θ₂, hθ₂_mk⟩ := hInfIso ψz_loc 2 (by decide) hψz_loc_alg hψz_loc_fe hψz_loc_mem
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        change Ideal.Quotient.mk (𝔪_loc ^ 2) (ψz_loc Q) = 0
        rw [← hθ₂_mk Q, (Ideal.Quotient.eq_zero_iff_mem).mpr hQ_in_mT2, map_zero]
      have hdiff_01_m2 : algebraMap A (Localization.AtPrime p_z) (f - ψ_z P₀₁) ∈ 𝔪_loc ^ 2 := by
        have hm2 : algebraMap A (Localization.AtPrime p_z) (f - ψ_z (P₀₁ + Q)) ∈ 𝔪_loc ^ 2 :=
          Ideal.pow_le_pow_right (by decide : 2 ≤ 3) hdiff_012
        have hsum := Ideal.add_mem (𝔪_loc ^ 2) hm2 hψzQ_m2
        have heq : f - ψ_z (P₀₁ + Q) + ψ_z Q = f - ψ_z P₀₁ := by
          rw [map_add]; ring
        rwa [← map_add, heq] at hsum
      have hP₀₁_form : P₀₁ = MvPolynomial.C (P.coeff 0) +
          ∑ i : Fin d, MvPolynomial.C (P.coeff (Finsupp.single i 1)) * MvPolynomial.X i := by
        dsimp only [P₀₁]; rw [hHomog0_eq, hHomog1_eq]
      rw [hP₀₁_form] at hdiff_01_m2
      obtain ⟨hc0_eq, hw_eq⟩ :=
        (hPart2 f (P.coeff 0) (fun i => P.coeff (Finsupp.single i 1))).mp hdiff_01_m2
      have hP₀₁_zero : P₀₁ = 0 := by
        rw [hP₀₁_form, ← hc0_eq, hf0, map_zero, zero_add]
        refine Finset.sum_eq_zero fun i _ => ?_
        rw [← hw_eq i, hf1 i, map_zero, zero_mul]
      rw [hP₀₁_zero, zero_add] at hdiff_012
      refine ⟨Q, hQ_hom, fun i j => ?_, hdiff_012⟩
      have h0 := hMod3_vanish (f - ψ_z Q) hdiff_012 i j
      rw [map_sub, map_sub, map_sub, sub_eq_zero] at h0
      rw [h0, hDV_ψz, hDV_ψz, hevz_ψz]
    have hPart4 : ∀ (ψ'_loc : MvPolynomial (Fin d) k →+* Localization.AtPrime p_z)
        (u : Localization.AtPrime p_z) (Q' : MvPolynomial (Fin d) k) (f : A),
        ψ'_loc.comp MvPolynomial.C = algebraMap k (Localization.AtPrime p_z) →
        @Algebra.FormallyEtale (MvPolynomial (Fin d) k) (Localization.AtPrime p_z) _ _
          ψ'_loc.toAlgebra →
        (∀ i : Fin d, ψ'_loc (MvPolynomial.X i) ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) →
        IsUnit u →
        Q' ∈ MvPolynomial.homogeneousSubmodule (Fin d) k 2 →
        Matrix.det (Matrix.of fun i j : Fin d =>
          MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q'))) ≠ 0 →
        algebraMap A (Localization.AtPrime p_z) f - u * ψ'_loc Q' ∈
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 3 →
        (ev_z f = 0 ∧ ∀ i : Fin d, ev_z (D_V i f) = 0) ∧
          Matrix.det (Matrix.of fun i j : Fin d => ev_z (D_V j (D_V i f))) ≠ 0 := by
      intro ψ'_loc u Q' f hψ'_alg hψ'_fe hψ'_mem hu hQ'_hom hQ'_det hMod3
      let 𝔪_loc := IsLocalRing.maximalIdeal (Localization.AtPrime p_z)
      have hQ'_isHom : Q'.IsHomogeneous 2 :=
        (MvPolynomial.mem_homogeneousSubmodule 2 Q').mp hQ'_hom
      have hQ'_deg : ∀ {s : Fin d →₀ ℕ}, Q'.coeff s ≠ 0 → Finsupp.degree s = 2 := by
        intro s hs
        have h := hQ'_isHom hs
        rw [Finsupp.weight_apply] at h
        simpa [Finsupp.sum, Finsupp.degree_apply, Pi.one_apply, smul_eq_mul] using h
      have hQ'_in_mT2 : Q' ∈ 𝔪_T ^ 2 := by
        rw [h𝔪T_pow_eq 2]
        intro s hs
        by_contra hne
        have := hQ'_deg hne
        omega
      have h_map_m' : Ideal.map ψ'_loc 𝔪_T ≤ 𝔪_loc := by
        rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        exact hψ'_mem i
      have hψ'Q'_m2 : ψ'_loc Q' ∈ 𝔪_loc ^ 2 := by
        have hm : ψ'_loc Q' ∈ Ideal.map ψ'_loc (𝔪_T ^ 2) := Ideal.mem_map_of_mem _ hQ'_in_mT2
        rw [Ideal.map_pow] at hm
        exact hIdealPowMono h_map_m' 2 hm
      have hlocf_m2 : algebraMap A (Localization.AtPrime p_z) f ∈ 𝔪_loc ^ 2 := by
        have hm2 : algebraMap A (Localization.AtPrime p_z) f - u * ψ'_loc Q' ∈ 𝔪_loc ^ 2 :=
          Ideal.pow_le_pow_right (by decide : 2 ≤ 3) hMod3
        have hsum := Ideal.add_mem (𝔪_loc ^ 2) hm2 (Ideal.mul_mem_left (𝔪_loc ^ 2) u hψ'Q'_m2)
        rwa [sub_add_cancel] at hsum
      have hCrit : ev_z f = 0 ∧ ∀ i : Fin d, ev_z (D_V i f) = 0 := by
        apply (hPart2 f 0 0).mp
        simpa using hlocf_m2
      obtain ⟨θ₃, hθ₃_mk⟩ := hInfIso ψz_loc 3 (by decide) hψz_loc_alg hψz_loc_fe hψz_loc_mem
      obtain ⟨θ'₃, hθ'₃_mk⟩ := hInfIso ψ'_loc 3 (by decide) hψ'_alg hψ'_fe hψ'_mem
      let Φ : (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ 3) ≃ₐ[k] (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ 3) :=
        θ'₃.trans θ₃.symm
      have hθ₃_Φ : ∀ q : MvPolynomial (Fin d) k ⧸ 𝔪_T ^ 3, θ₃ (Φ q) = θ'₃ q :=
        fun q => θ₃.apply_symm_apply (θ'₃ q)
      let P_tr : Fin d → MvPolynomial (Fin d) k := fun r =>
        Classical.choose (Ideal.Quotient.mk_surjective
          (Φ (Ideal.Quotient.mk (𝔪_T ^ 3) (MvPolynomial.X r))))
      have hP_tr_mk : ∀ r : Fin d,
          Ideal.Quotient.mk (𝔪_T ^ 3) (P_tr r) =
            Φ (Ideal.Quotient.mk (𝔪_T ^ 3) (MvPolynomial.X r)) :=
        fun r => Classical.choose_spec (Ideal.Quotient.mk_surjective _)
      let P_inv : Fin d → MvPolynomial (Fin d) k := fun r =>
        Classical.choose (Ideal.Quotient.mk_surjective
          (Φ.symm (Ideal.Quotient.mk (𝔪_T ^ 3) (MvPolynomial.X r))))
      have hP_inv_mk : ∀ r : Fin d,
          Ideal.Quotient.mk (𝔪_T ^ 3) (P_inv r) =
            Φ.symm (Ideal.Quotient.mk (𝔪_T ^ 3) (MvPolynomial.X r)) :=
        fun r => Classical.choose_spec (Ideal.Quotient.mk_surjective _)
      have h_ev_quot3 : ∀ r ∈ 𝔪_loc ^ 3, ev_loc.toRingHom r = 0 := fun r hr => by
        have hr1 : r ∈ IsLocalRing.maximalIdeal (Localization.AtPrime p_z) :=
          Ideal.pow_le_self (by decide : 3 ≠ 0) hr
        rw [← hKer_ev_loc] at hr1
        exact hr1
      let ev_bar3 : (Localization.AtPrime p_z ⧸ 𝔪_loc ^ 3) →+* k :=
        Ideal.Quotient.lift (𝔪_loc ^ 3) ev_loc.toRingHom h_ev_quot3
      have hev_bar3_θ₃ : ∀ G : MvPolynomial (Fin d) k,
          ev_bar3 (θ₃ (Ideal.Quotient.mk (𝔪_T ^ 3) G)) = MvPolynomial.constantCoeff G := by
        intro G
        rw [hθ₃_mk G]
        change ev_loc (algebraMap A (Localization.AtPrime p_z) (ψ_z G)) = _
        rw [hev_loc_alg, hevz_ψz]
      have hev_bar3_θ'₃ : ∀ G : MvPolynomial (Fin d) k,
          ev_bar3 (θ'₃ (Ideal.Quotient.mk (𝔪_T ^ 3) G)) = MvPolynomial.constantCoeff G := by
        have hhom : ev_loc.toRingHom.comp ψ'_loc = MvPolynomial.constantCoeff := by
          apply MvPolynomial.ringHom_ext
          · intro r
            change ev_loc (ψ'_loc (MvPolynomial.C r)) = _
            have hc : ψ'_loc (MvPolynomial.C r) = algebraMap k (Localization.AtPrime p_z) r :=
              RingHom.congr_fun hψ'_alg r
            rw [hc, ev_loc.commutes, MvPolynomial.constantCoeff_C]
            rfl
          · intro i
            have hm : ψ'_loc (MvPolynomial.X i) ∈ RingHom.ker ev_loc.toRingHom := by
              rw [hKer_ev_loc]; exact hψ'_mem i
            change ev_loc.toRingHom (ψ'_loc (MvPolynomial.X i)) = _
            rw [hm, MvPolynomial.constantCoeff_X]
        intro G
        rw [hθ'₃_mk G]
        exact RingHom.congr_fun hhom G
      have hPtr_cc : ∀ r : Fin d, MvPolynomial.constantCoeff (P_tr r) = 0 := by
        intro r
        rw [← hev_bar3_θ₃ (P_tr r), hP_tr_mk r, hθ₃_Φ, hev_bar3_θ'₃, MvPolynomial.constantCoeff_X]
      have hPinv_cc : ∀ r : Fin d, MvPolynomial.constantCoeff (P_inv r) = 0 := by
        intro r
        rw [← hev_bar3_θ'₃ (P_inv r)]
        have h1 : θ'₃ (Ideal.Quotient.mk (𝔪_T ^ 3) (P_inv r)) =
            θ₃ (Ideal.Quotient.mk (𝔪_T ^ 3) (MvPolynomial.X r)) := by
          rw [hP_inv_mk r, ← hθ₃_Φ, Φ.apply_symm_apply]
        rw [h1, hev_bar3_θ₃, MvPolynomial.constantCoeff_X]
      have hPtr_mT : ∀ r : Fin d, P_tr r ∈ 𝔪_T := by
        intro r
        rw [← pow_one 𝔪_T, h𝔪T_pow_eq 1]
        intro s hs
        have hs0 : s = 0 := hDeg0 (by omega)
        subst hs0
        exact hPtr_cc r
      have hPinv_mT : ∀ r : Fin d, P_inv r ∈ 𝔪_T := by
        intro r
        rw [← pow_one 𝔪_T, h𝔪T_pow_eq 1]
        intro s hs
        have hs0 : s = 0 := hDeg0 (by omega)
        subst hs0
        exact hPinv_cc r
      let A_tr : Matrix (Fin d) (Fin d) k :=
        Matrix.of fun r a => (P_tr r).coeff (Finsupp.single a 1)
      let B_tr : Matrix (Fin d) (Fin d) k :=
        Matrix.of fun a b => (P_inv a).coeff (Finsupp.single b 1)
      let L_tr : Fin d → MvPolynomial (Fin d) k := fun r =>
        ∑ a : Fin d, MvPolynomial.C (A_tr r a) * MvPolynomial.X a
      let L_inv : Fin d → MvPolynomial (Fin d) k := fun a =>
        ∑ b : Fin d, MvPolynomial.C (B_tr a b) * MvPolynomial.X b
      have hPtr_sub_L : ∀ r : Fin d, P_tr r - L_tr r ∈ 𝔪_T ^ 2 := by
        intro r
        have hL_eq : L_tr r = MvPolynomial.homogeneousComponent 1 (P_tr r) :=
          (hHomog1_eq (P_tr r)).symm
        rw [hL_eq, h𝔪T_pow_eq 2]
        intro s hs
        rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_homogeneousComponent]
        have h01 : Finsupp.degree s = 0 ∨ Finsupp.degree s = 1 := by omega
        rcases h01 with h0 | h1
        · rw [if_neg (by omega), sub_zero]
          have hs0 : s = 0 := hDeg0 h0
          subst hs0
          exact hPtr_cc r
        · simp [h1]
      have hPinv_sub_L : ∀ a : Fin d, P_inv a - L_inv a ∈ 𝔪_T ^ 2 := by
        intro a
        have hL_eq : L_inv a = MvPolynomial.homogeneousComponent 1 (P_inv a) :=
          (hHomog1_eq (P_inv a)).symm
        rw [hL_eq, h𝔪T_pow_eq 2]
        intro s hs
        rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_homogeneousComponent]
        have h01 : Finsupp.degree s = 0 ∨ Finsupp.degree s = 1 := by omega
        rcases h01 with h0 | h1
        · rw [if_neg (by omega), sub_zero]
          have hs0 : s = 0 := hDeg0 h0
          subst hs0
          exact hPinv_cc a
        · simp [h1]
      have hΦ_aeval : ∀ G : MvPolynomial (Fin d) k,
          Φ (Ideal.Quotient.mk (𝔪_T ^ 3) G) =
            Ideal.Quotient.mk (𝔪_T ^ 3) (MvPolynomial.aeval P_tr G) := by
        let α₁ : MvPolynomial (Fin d) k →ₐ[k] (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ 3) :=
          Φ.toAlgHom.comp (Ideal.Quotient.mkₐ k (𝔪_T ^ 3))
        let α₂ : MvPolynomial (Fin d) k →ₐ[k] (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ 3) :=
          (Ideal.Quotient.mkₐ k (𝔪_T ^ 3)).comp (MvPolynomial.aeval P_tr)
        have hα : α₁ = α₂ := by
          apply MvPolynomial.algHom_ext
          intro r
          change Φ (Ideal.Quotient.mk (𝔪_T ^ 3) (MvPolynomial.X r)) =
            Ideal.Quotient.mk (𝔪_T ^ 3) (MvPolynomial.aeval P_tr (MvPolynomial.X r))
          rw [MvPolynomial.aeval_X, hP_tr_mk r]
        exact fun G => AlgHom.congr_fun hα G
      have hΦsymm_aeval : ∀ G : MvPolynomial (Fin d) k,
          Φ.symm (Ideal.Quotient.mk (𝔪_T ^ 3) G) =
            Ideal.Quotient.mk (𝔪_T ^ 3) (MvPolynomial.aeval P_inv G) := by
        let α₁ : MvPolynomial (Fin d) k →ₐ[k] (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ 3) :=
          Φ.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k (𝔪_T ^ 3))
        let α₂ : MvPolynomial (Fin d) k →ₐ[k] (MvPolynomial (Fin d) k ⧸ 𝔪_T ^ 3) :=
          (Ideal.Quotient.mkₐ k (𝔪_T ^ 3)).comp (MvPolynomial.aeval P_inv)
        have hα : α₁ = α₂ := by
          apply MvPolynomial.algHom_ext
          intro r
          change Φ.symm (Ideal.Quotient.mk (𝔪_T ^ 3) (MvPolynomial.X r)) =
            Ideal.Quotient.mk (𝔪_T ^ 3) (MvPolynomial.aeval P_inv (MvPolynomial.X r))
          rw [MvPolynomial.aeval_X, hP_inv_mk r]
        exact fun G => AlgHom.congr_fun hα G
      have hAB_one : A_tr * B_tr = 1 := by
        have haeval_Pinv_mT2 : ∀ G ∈ 𝔪_T ^ 2, MvPolynomial.aeval P_inv G ∈ 𝔪_T ^ 2 := by
          have hmap : Ideal.map (MvPolynomial.aeval P_inv).toRingHom 𝔪_T ≤ 𝔪_T := by
            rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
            rintro _ ⟨a, rfl⟩
            change MvPolynomial.aeval P_inv (MvPolynomial.X a) ∈ 𝔪_T
            rw [MvPolynomial.aeval_X]
            exact hPinv_mT a
          intro G hG
          have hm := Ideal.mem_map_of_mem (MvPolynomial.aeval P_inv).toRingHom hG
          rw [Ideal.map_pow] at hm
          exact hIdealPowMono hmap 2 hm
        ext r b
        have h1 : Ideal.Quotient.mk (𝔪_T ^ 3) (MvPolynomial.X r) =
            Ideal.Quotient.mk (𝔪_T ^ 3) (MvPolynomial.aeval P_inv (P_tr r)) := by
          rw [← hΦsymm_aeval (P_tr r), hP_tr_mk r, Φ.symm_apply_apply]
        have h_in3 : MvPolynomial.X r - MvPolynomial.aeval P_inv (P_tr r) ∈ 𝔪_T ^ 3 :=
          Ideal.Quotient.eq.mp h1
        have h_in2 : MvPolynomial.X r - MvPolynomial.aeval P_inv (P_tr r) ∈ 𝔪_T ^ 2 :=
          Ideal.pow_le_pow_right (by decide : 2 ≤ 3) h_in3
        have h_rem2 : MvPolynomial.aeval P_inv (P_tr r - L_tr r) ∈ 𝔪_T ^ 2 :=
          haeval_Pinv_mT2 _ (hPtr_sub_L r)
        have h_L_in2 : MvPolynomial.X r - MvPolynomial.aeval P_inv (L_tr r) ∈ 𝔪_T ^ 2 := by
          have hsum := Ideal.add_mem (𝔪_T ^ 2) h_in2 h_rem2
          have heq : MvPolynomial.X r - MvPolynomial.aeval P_inv (P_tr r) +
              MvPolynomial.aeval P_inv (P_tr r - L_tr r) =
              MvPolynomial.X r - MvPolynomial.aeval P_inv (L_tr r) := by
            rw [map_sub]; ring
          rwa [heq] at hsum
        have h_lin_diff : MvPolynomial.aeval P_inv (L_tr r) -
            MvPolynomial.aeval L_inv (L_tr r) ∈ 𝔪_T ^ 2 := by
          dsimp only [L_tr]
          rw [map_sum, map_sum, ← Finset.sum_sub_distrib]
          refine Ideal.sum_mem (𝔪_T ^ 2) fun a _ => ?_
          simp only [map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X, ← mul_sub]
          exact Ideal.mul_mem_left (𝔪_T ^ 2) _ (hPinv_sub_L a)
        have h_tot_in2 : MvPolynomial.X r - MvPolynomial.aeval L_inv (L_tr r) ∈ 𝔪_T ^ 2 := by
          have hsum := Ideal.add_mem (𝔪_T ^ 2) h_L_in2 h_lin_diff
          rwa [sub_add_sub_cancel] at hsum
        rw [h𝔪T_pow_eq 2] at h_tot_in2
        have hcoeff := h_tot_in2 (Finsupp.single b 1) (by simp [Finsupp.degree_apply])
        rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_X, sub_eq_zero] at hcoeff
        have h_rhs_coeff : (MvPolynomial.aeval L_inv (L_tr r)).coeff (Finsupp.single b 1) =
            (A_tr * B_tr) r b := by
          have h_expand : MvPolynomial.aeval L_inv (L_tr r) =
              ∑ a : Fin d, ∑ b' : Fin d,
                MvPolynomial.C (A_tr r a * B_tr a b') * MvPolynomial.X b' := by
            dsimp only [L_tr, L_inv]
            rw [map_sum]
            refine Finset.sum_congr rfl fun a _ => ?_
            rw [map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X, MvPolynomial.algebraMap_eq,
              Finset.mul_sum]
            refine Finset.sum_congr rfl fun b' _ => by rw [← mul_assoc, ← MvPolynomial.C_mul]
          rw [h_expand, MvPolynomial.coeff_sum, Matrix.mul_apply]
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [MvPolynomial.coeff_sum, Finset.sum_eq_single b]
          · rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X, if_pos rfl, mul_one]
          · intro b' _ hb'
            have hne : Finsupp.single b' 1 ≠ Finsupp.single b 1 :=
              fun h => hb' (Finsupp.single_left_injective (by decide : 1 ≠ 0) h)
            rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X, if_neg hne, mul_zero]
          · intro habs; exact absurd (Finset.mem_univ _) habs
        rw [h_rhs_coeff] at hcoeff
        rw [← hcoeff, Matrix.one_apply]
        by_cases hrb : r = b
        · subst hrb; simp
        · have hne : Finsupp.single r 1 ≠ Finsupp.single b 1 :=
            fun h => hrb (Finsupp.single_left_injective (by decide : 1 ≠ 0) h)
          simp [hrb, hne]
      have hAtr_det_ne : A_tr.det ≠ 0 := by
        intro h0
        have h1 := congrArg Matrix.det hAB_one
        rw [Matrix.det_mul, h0, zero_mul, Matrix.det_one] at h1
        exact zero_ne_one h1
      let u₀ : k := ev_loc u
      have hu₀_ne : u₀ ≠ 0 := (hu.map ev_loc.toRingHom).ne_zero
      have hdu_m : u - algebraMap k (Localization.AtPrime p_z) u₀ ∈ 𝔪_loc := by
        dsimp only [𝔪_loc]
        rw [← hKer_ev_loc, RingHom.mem_ker]
        change ev_loc (u - algebraMap k (Localization.AtPrime p_z) u₀) = 0
        rw [map_sub, ev_loc.commutes]
        exact sub_self u₀
      have hdu_Q'_m3 : (u - algebraMap k (Localization.AtPrime p_z) u₀) * ψ'_loc Q' ∈ 𝔪_loc ^ 3 := by
        rw [show (3 : ℕ) = 1 + 2 from rfl, pow_add, pow_one]
        exact Ideal.mul_mem_mul hdu_m hψ'Q'_m2
      have hMod3_u0 : algebraMap A (Localization.AtPrime p_z) f -
          algebraMap k (Localization.AtPrime p_z) u₀ * ψ'_loc Q' ∈ 𝔪_loc ^ 3 := by
        have hsum := Ideal.add_mem (𝔪_loc ^ 3) hMod3 hdu_Q'_m3
        have heq : algebraMap A (Localization.AtPrime p_z) f - u * ψ'_loc Q' +
            (u - algebraMap k (Localization.AtPrime p_z) u₀) * ψ'_loc Q' =
            algebraMap A (Localization.AtPrime p_z) f -
              algebraMap k (Localization.AtPrime p_z) u₀ * ψ'_loc Q' := by ring
        rwa [heq] at hsum
      have hLtr_mT : ∀ r : Fin d, L_tr r ∈ 𝔪_T := fun r =>
        Ideal.sum_mem 𝔪_T fun a _ =>
          Ideal.mul_mem_left 𝔪_T _ (Ideal.subset_span ⟨a, rfl⟩)
      have hMon_approx : ∀ (n_deg : ℕ), 1 ≤ n_deg →
          ∀ (s : Fin d →₀ ℕ), Finsupp.degree s = n_deg →
          MvPolynomial.aeval L_tr (MvPolynomial.monomial s (1 : k)) ∈ 𝔪_T ^ n_deg ∧
          MvPolynomial.aeval P_tr (MvPolynomial.monomial s (1 : k)) -
            MvPolynomial.aeval L_tr (MvPolynomial.monomial s (1 : k)) ∈ 𝔪_T ^ (n_deg + 1) := by
        intro n_deg hn_deg
        obtain ⟨m, rfl⟩ : ∃ m : ℕ, n_deg = m + 1 := ⟨n_deg - 1, (Nat.sub_add_cancel hn_deg).symm⟩
        clear hn_deg
        induction m with
        | zero =>
          intro s hs
          have hex : ∃ r₀ : Fin d, s r₀ ≠ 0 := by
            by_contra hall
            rw [not_exists] at hall
            have hs0 : s = 0 := by ext r; exact not_not.mp (hall r)
            rw [hs0, map_zero] at hs
            omega
          obtain ⟨r₀, hr₀⟩ := hex
          have hs_eq : s = Finsupp.single r₀ 1 := by
            have hsum : ∑ r ∈ s.support, s r = 1 := by rwa [← Finsupp.degree_apply]
            have hr₀_mem : r₀ ∈ s.support := Finsupp.mem_support_iff.mpr hr₀
            have hsplit := Finset.add_sum_erase s.support (fun r => s r) hr₀_mem
            have hrest : ∑ r ∈ s.support.erase r₀, s r = 0 := by omega
            have hsr₀ : s r₀ = 1 := by omega
            ext r
            by_cases hr : r = r₀
            · subst hr; simp [hsr₀]
            · simp only [Finsupp.single_apply, if_neg (Ne.symm hr)]
              by_cases hrm : r ∈ s.support
              · exact (Finset.sum_eq_zero_iff_of_nonneg (fun _ _ => Nat.zero_le _)).mp hrest r
                  (Finset.mem_erase.mpr ⟨hr, hrm⟩)
              · exact Finsupp.notMem_support_iff.mp hrm
          subst hs_eq
          change MvPolynomial.aeval L_tr (MvPolynomial.X r₀) ∈ 𝔪_T ^ (0 + 1) ∧
            MvPolynomial.aeval P_tr (MvPolynomial.X r₀) -
              MvPolynomial.aeval L_tr (MvPolynomial.X r₀) ∈ 𝔪_T ^ (0 + 1 + 1)
          rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X, zero_add, pow_one]
          exact ⟨hLtr_mT r₀, hPtr_sub_L r₀⟩
        | succ m ih =>
          intro s hs
          have hex : ∃ r₀ : Fin d, 0 < s r₀ := by
            by_contra hall
            push_neg at hall
            have hs0 : s = 0 := by ext r; exact Nat.le_zero.mp (hall r)
            rw [hs0, map_zero] at hs
            omega
          obtain ⟨r₀, hr₀⟩ := hex
          let s' : Fin d →₀ ℕ := s - Finsupp.single r₀ 1
          have hs_split : Finsupp.single r₀ 1 + s' = s := by
            ext r
            simp only [s', Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
              Finsupp.single_apply]
            by_cases hr : r₀ = r
            · subst hr; simp; omega
            · simp [hr]
          have hs'_deg : Finsupp.degree s' = m + 1 := by
            have h1 := congrArg Finsupp.degree hs_split
            rw [map_add, hs] at h1
            have hsingle : Finsupp.degree (Finsupp.single r₀ 1) = 1 := by simp [Finsupp.degree_apply]
            omega
          obtain ⟨hv_mem, hdv_mem⟩ := ih s' hs'_deg
          have hmon_mul : MvPolynomial.monomial s (1 : k) =
              MvPolynomial.X r₀ * MvPolynomial.monomial s' (1 : k) := by
            change MvPolynomial.monomial s 1 =
              MvPolynomial.monomial (Finsupp.single r₀ 1) 1 * MvPolynomial.monomial s' 1
            rw [MvPolynomial.monomial_mul_monomial, one_mul, hs_split]
          rw [hmon_mul, map_mul, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
          refine ⟨?_, ?_⟩
          · rw [show m + 1 + 1 = 1 + (m + 1) from by omega, pow_add, pow_one]
            exact Ideal.mul_mem_mul (hLtr_mT r₀) hv_mem
          · have h_id : P_tr r₀ * MvPolynomial.aeval P_tr (MvPolynomial.monomial s' (1 : k)) -
                L_tr r₀ * MvPolynomial.aeval L_tr (MvPolynomial.monomial s' (1 : k)) =
                P_tr r₀ * (MvPolynomial.aeval P_tr (MvPolynomial.monomial s' (1 : k)) -
                  MvPolynomial.aeval L_tr (MvPolynomial.monomial s' (1 : k))) +
