    have heP_Xi_eq : (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β)
          (MvPolynomial.isHomogeneous_X k β) zero_lt_one).hom ≫
        (𝟙 P_2 : P_2 ⟶ P_2).left.appLE D_β D_β (le_refl _)).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X (β.succAbove i), MvPolynomial.isHomogeneous_X k (β.succAbove i)⟩,
            ⟨MvPolynomial.X β, MvPolynomial.isHomogeneous_X k β⟩, ⟨1, pow_one _⟩⟩)) =
        e_P (MvPolynomial.X i) := by
      change ((𝟙 P_2 : P_2 ⟶ P_2).left.appLE D_β D_β (le_refl _)).hom
          (w_tilde β (β.succAbove i)) = e_P (MvPolynomial.X i)
      rw [hid_app]
      exact (heP_X i).symm
    rw [heP_Xi_eq] at hBo_P2
    have hBo_Y : Y₂.left.basicOpen (e_Y (Ideal.Quotient.mk I_inc (MvPolynomial.X i))) =
        V_Y ⊓ (TopologicalSpace.Opens.map g₂.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X (β.succAbove i))) := by
      have hg_Xi : e_Y (Ideal.Quotient.mk I_inc (MvPolynomial.X i)) =
          (g₂.left.appLE D_β V_Y inf_le_right).hom (e_P (MvPolynomial.X i)) := by
        have h1 := (hg_app (MvPolynomial.X i)).symm
        rwa [MvPolynomial.map_X] at h1
      have hg_res : (g₂.left.appLE D_β V_Y inf_le_right).hom (e_P (MvPolynomial.X i)) =
          (Y₂.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V_Y ≤ g₂.left ⁻¹ᵁ D_β)).op).hom
            ((g₂.left.app D_β).hom (e_P (MvPolynomial.X i))) := by
        have happ : g₂.left.app D_β ≫
            Y₂.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V_Y ≤ g₂.left ⁻¹ᵁ D_β)).op =
            g₂.left.appLE D_β V_Y inf_le_right := by
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE g₂.left (U := D_β),
            AlgebraicGeometry.Scheme.Hom.appLE_map]
        exact congrArg (fun f : P_2.left.presheaf.obj (Opposite.op D_β) ⟶
          Y₂.left.presheaf.obj (Opposite.op V_Y) => f.hom (e_P (MvPolynomial.X i))) happ.symm
      rw [hg_Xi, hg_res]
      have hres_bo : Y₂.left.basicOpen
          ((Y₂.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V_Y ≤ g₂.left ⁻¹ᵁ D_β)).op).hom
            ((g₂.left.app D_β).hom (e_P (MvPolynomial.X i)))) =
          V_Y ⊓ Y₂.left.basicOpen ((g₂.left.app D_β).hom (e_P (MvPolynomial.X i))) :=
        Y₂.left.toRingedSpace.basicOpen_res
          (CategoryTheory.homOfLE (inf_le_right : V_Y ≤ g₂.left ⁻¹ᵁ D_β)).op
          ((g₂.left.app D_β).hom (e_P (MvPolynomial.X i)))
      rw [hres_bo, ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, hBo_P2]
      change V_Y ⊓ ((TopologicalSpace.Opens.map g₂.left.base).obj D_β ⊓
        (TopologicalSpace.Opens.map g₂.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X (β.succAbove i)))) = _
      rw [← inf_assoc, inf_eq_left.mpr inf_le_right]
    have hy_mem : y.1 ∈ Y₂.left.basicOpen (e_Y (Ideal.Quotient.mk I_inc (MvPolynomial.X i))) ↔
        e_Y (Ideal.Quotient.mk I_inc (MvPolynomial.X i)) ∉ (hAffVY.primeIdealOf y).asIdeal := by
      let f_i : ↑(Y_sch.presheaf.obj (Opposite.op V_Y)) :=
        e_Y (Ideal.Quotient.mk I_inc (MvPolynomial.X i))
      have hy_from : hAffVY.fromSpec.base (hAffVY.primeIdealOf y) = y.1 :=
        hAffVY.fromSpec_primeIdealOf y
      have hpre : hAffVY.fromSpec ⁻¹ᵁ Y_sch.basicOpen f_i = PrimeSpectrum.basicOpen f_i := by
        rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, hAffVY.basicOpen_fromSpec_app]
      change y.1 ∈ Y_sch.basicOpen f_i ↔ f_i ∉ (hAffVY.primeIdealOf y).asIdeal
      rw [← hy_from]
      change hAffVY.primeIdealOf y ∈ (hAffVY.fromSpec ⁻¹ᵁ Y_sch.basicOpen f_i) ↔ _
      rw [hpre]
      exact PrimeSpectrum.mem_basicOpen f_i (hAffVY.primeIdealOf y)
    have hy_lhs : y.1 ∈ Y₂.left.basicOpen (e_Y (Ideal.Quotient.mk I_inc (MvPolynomial.X i))) ↔
        g₂.left.base y.1 ∈
          AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X (β.succAbove i)) := by
      rw [hBo_Y]
      exact ⟨fun h => h.2, fun h => ⟨y.2, h⟩⟩
    exact hy_lhs.symm.trans hy_mem

theorem weil_algClosed_incidence_quotient_flat (k : Type u) [Field k] [IsAlgClosed k]
    (A : Type u) [CommRing A] (κ_A : k →+* A) (ℓ₀ ℓ₁ ℓ₂ : A)
    (hA : Subsingleton A ∨
      (IsDomain A ∧ ∀ c : Fin 3 → k, c ≠ 0 →
        κ_A (c 0) * ℓ₀ + κ_A (c 1) * ℓ₁ + κ_A (c 2) * ℓ₂ ≠ 0)) :
    RingHom.Flat
      ((Ideal.Quotient.mk
        (Ideal.span
          ({MvPolynomial.C ℓ₀ + MvPolynomial.C ℓ₁ * MvPolynomial.X (0 : Fin 2) +
            MvPolynomial.C ℓ₂ * MvPolynomial.X (1 : Fin 2)} :
            Set (MvPolynomial (Fin 2) A)))).comp
        (MvPolynomial.map κ_A)) :=
by
  classical
  let _ : Algebra k A := κ_A.toAlgebra
  have h_smul_kA : ∀ (c : k) (a : A), c • a = κ_A c * a := fun _ _ => rfl
  let φ : MvPolynomial (Fin 2) k →+* MvPolynomial (Fin 2) A := MvPolynomial.map κ_A
  let F : MvPolynomial (Fin 2) A :=
    MvPolynomial.C ℓ₀ + MvPolynomial.C ℓ₁ * MvPolynomial.X (0 : Fin 2) +
      MvPolynomial.C ℓ₂ * MvPolynomial.X (1 : Fin 2)
  let J_F : Ideal (MvPolynomial (Fin 2) A) := Ideal.span ({F} : Set (MvPolynomial (Fin 2) A))
  let π_fun : (A →ₗ[k] k) → MvPolynomial (Fin 2) A → MvPolynomial (Fin 2) k := fun l Q =>
    ∑ m ∈ Q.support, MvPolynomial.monomial m (l (Q.coeff m))
  have hπ_fun_coeff : ∀ (l : A →ₗ[k] k) (Q : MvPolynomial (Fin 2) A) (m : Fin 2 →₀ ℕ),
      (π_fun l Q).coeff m = l (Q.coeff m) := by
    intro l Q m
    dsimp [π_fun]
    rw [MvPolynomial.coeff_sum]
    by_cases hm : m ∈ Q.support
    · rw [Finset.sum_eq_single m]
      · simp
      · intro m' _ hm'
        simp [MvPolynomial.coeff_monomial, hm']
      · intro hnot
        exact absurd hm hnot
    · have h0 : Q.coeff m = 0 := Finsupp.notMem_support_iff.mp hm
      rw [h0, map_zero]
      refine Finset.sum_eq_zero fun m' hm' => ?_
      have hm_ne : m' ≠ m := fun heq => hm (heq ▸ hm')
      simp [MvPolynomial.coeff_monomial, hm_ne]
  let π : (A →ₗ[k] k) → (MvPolynomial (Fin 2) A →+ MvPolynomial (Fin 2) k) := fun l =>
    { toFun := π_fun l
      map_zero' := by
        apply MvPolynomial.ext
        intro m
        simp [hπ_fun_coeff]
      map_add' := by
        intro Q₁ Q₂
        apply MvPolynomial.ext
        intro m
        simp [hπ_fun_coeff] }
  have hπ_coeff : ∀ (l : A →ₗ[k] k) (Q : MvPolynomial (Fin 2) A) (m : Fin 2 →₀ ℕ),
      (π l Q).coeff m = l (Q.coeff m) := hπ_fun_coeff
  have hπ_C : ∀ (l : A →ₗ[k] k) (a : A), π l (MvPolynomial.C a) = MvPolynomial.C (l a) := by
    intro l a
    apply MvPolynomial.ext
    intro m
    rw [hπ_coeff, MvPolynomial.coeff_C, MvPolynomial.coeff_C]
    split_ifs <;> simp
  have hπ_map_mul : ∀ (l : A →ₗ[k] k) (r : MvPolynomial (Fin 2) k) (Q : MvPolynomial (Fin 2) A),
      π l (φ r * Q) = r * π l Q := by
    intro l r Q
    apply MvPolynomial.ext
    intro m
    rw [hπ_coeff, MvPolynomial.coeff_mul, MvPolynomial.coeff_mul, map_sum]
    refine Finset.sum_congr rfl fun x _ => ?_
    rw [MvPolynomial.coeff_map, ← h_smul_kA, map_smul, smul_eq_mul, hπ_coeff]
  have hπ_C_mul : ∀ (l : A →ₗ[k] k) (a : A) (Q : MvPolynomial (Fin 2) A),
      π l (MvPolynomial.C a * Q) = π (l.comp (LinearMap.mulLeft k a)) Q := by
    intro l a Q
    apply MvPolynomial.ext
    intro m
    rw [hπ_coeff, MvPolynomial.coeff_C_mul, hπ_coeff, LinearMap.comp_apply,
      LinearMap.mulLeft_apply]
  let ι := Module.Basis.ofVectorSpaceIndex k A
  let b_A : Module.Basis ι k A := Module.Basis.ofVectorSpace k A
  let coord : ι → (A →ₗ[k] k) := fun i => (Finsupp.lapply i).comp b_A.repr.toLinearMap
  let suppB : MvPolynomial (Fin 2) A → Finset ι := fun Q =>
    Q.support.biUnion (fun m => (b_A.repr (Q.coeff m)).support)
  have h_decomp : ∀ Q : MvPolynomial (Fin 2) A,
      Q = ∑ i ∈ suppB Q, φ (π (coord i) Q) * MvPolynomial.C (b_A i) := by
    intro Q
    apply MvPolynomial.ext
    intro m
    rw [MvPolynomial.coeff_sum]
    have h_term : ∀ i : ι,
        (φ (π (coord i) Q) * MvPolynomial.C (b_A i)).coeff m =
          ((b_A.repr (Q.coeff m)) i) • b_A i := by
      intro i
      rw [mul_comm, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map, hπ_coeff]
      change b_A i * κ_A ((b_A.repr (Q.coeff m)) i) = _
      rw [mul_comm, ← h_smul_kA]
    simp_rw [h_term]
    by_cases hm : m ∈ Q.support
    · have hsub : (b_A.repr (Q.coeff m)).support ⊆ suppB Q :=
        Finset.subset_biUnion_of_mem (fun m' => (b_A.repr (Q.coeff m')).support) hm
      have hsum_sub :
          (∑ i ∈ suppB Q, ((b_A.repr (Q.coeff m)) i) • b_A i) =
            ∑ i ∈ (b_A.repr (Q.coeff m)).support, ((b_A.repr (Q.coeff m)) i) • b_A i := by
        refine (Finset.sum_subset hsub ?_).symm
        intro i _ hi_not
        rw [Finsupp.notMem_support_iff.mp hi_not, zero_smul]
      rw [hsum_sub]
      have h_repr : b_A.repr.symm (b_A.repr (Q.coeff m)) = Q.coeff m :=
        b_A.repr.symm_apply_apply (Q.coeff m)
      rw [Module.Basis.repr_symm_apply, Finsupp.linearCombination_apply] at h_repr
      exact h_repr.symm
    · have h0 : Q.coeff m = 0 := Finsupp.notMem_support_iff.mp hm
      rw [h0, map_zero]
      simp
  have h_mem_map : ∀ (K : Ideal (MvPolynomial (Fin 2) k)) (Q : MvPolynomial (Fin 2) A),
      Q ∈ Ideal.map φ K ↔ ∀ l : A →ₗ[k] k, π l Q ∈ K := by
    intro K Q
    constructor
    · intro hQ
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hQ
      · rintro _ ⟨r, hr, rfl⟩ l
        have h1 : π l (φ r) = r * π l 1 := by
          simpa only [mul_one] using hπ_map_mul l r 1
        rw [h1]
        exact Ideal.mul_mem_right _ K hr
      · intro l
        rw [map_zero]
        exact K.zero_mem
      · intro x y _ _ ihx ihy l
        rw [map_add]
        exact K.add_mem (ihx l) (ihy l)
      · intro P x _ ihx l
        change π l (P * x) ∈ K
        have hP_sum : P * x =
            ∑ m ∈ P.support,
              φ (MvPolynomial.monomial m 1) * (MvPolynomial.C (P.coeff m) * x) := by
          conv_lhs => rw [MvPolynomial.as_sum P]
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun m _ => ?_
          have hmon : MvPolynomial.monomial m (P.coeff m) =
              φ (MvPolynomial.monomial m 1) * MvPolynomial.C (P.coeff m) := by
            apply MvPolynomial.ext
            intro d
            rw [mul_comm, MvPolynomial.coeff_C_mul]
            dsimp [φ]
            rw [MvPolynomial.map_monomial, map_one, MvPolynomial.coeff_monomial,
              MvPolynomial.coeff_monomial]
            split_ifs <;> simp
          rw [hmon, mul_assoc]
        rw [hP_sum, map_sum]
        refine K.sum_mem fun m _ => ?_
        rw [hπ_map_mul, hπ_C_mul]
        exact Ideal.mul_mem_left K _ (ihx (l.comp (LinearMap.mulLeft k (P.coeff m))))
    · intro hall
      rw [h_decomp Q]
      refine (Ideal.map φ K).sum_mem fun i _ => ?_
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem φ (hall (coord i)))
  suffices hReg : ∀ (I : Ideal (MvPolynomial (Fin 2) k)) (b : MvPolynomial (Fin 2) A),
      F * b ∈ Ideal.map φ I → b ∈ Ideal.map φ I by
    let _ : Algebra (MvPolynomial (Fin 2) k) (MvPolynomial (Fin 2) A) := φ.toAlgebra
    have h_smul_RB : ∀ (r : MvPolynomial (Fin 2) k) (Q : MvPolynomial (Fin 2) A),
        r • Q = φ r * Q := fun _ _ => rfl
    let v : ι → MvPolynomial (Fin 2) A := fun i => MvPolynomial.C (b_A i)
    have hv_lin : LinearIndependent (MvPolynomial (Fin 2) k) v := by
      rw [linearIndependent_iff']
      intro s g hg j hj
      have h0 : π (coord j) (∑ i ∈ s, g i • v i) = 0 := by
        rw [hg, map_zero]
      rw [map_sum] at h0
      have h_eval : (∑ i ∈ s, π (coord j) (g i • v i)) = g j := by
        rw [Finset.sum_eq_single j]
        · rw [h_smul_RB, hπ_map_mul, hπ_C]
          have h1 : (coord j) (b_A j) = 1 := by
            change (b_A.repr (b_A j)) j = 1
            rw [b_A.repr_self]
            simp
          rw [h1, map_one, mul_one]
        · intro i _ hij
          rw [h_smul_RB, hπ_map_mul, hπ_C]
          have h0' : (coord j) (b_A i) = 0 := by
            change (b_A.repr (b_A i)) j = 0
            rw [b_A.repr_self]
            simp [hij.symm]
          rw [h0', map_zero, mul_zero]
        · intro hnot
          exact absurd hj hnot
      rwa [h_eval] at h0
    have hv_span : ⊤ ≤ Submodule.span (MvPolynomial (Fin 2) k) (Set.range v) := by
      intro Q _
      rw [h_decomp Q]
      refine Submodule.sum_mem _ fun i _ => ?_
      rw [← h_smul_RB]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    let b_B : Module.Basis ι (MvPolynomial (Fin 2) k) (MvPolynomial (Fin 2) A) :=
      Module.Basis.mk hv_lin hv_span
    have _ : Module.Free (MvPolynomial (Fin 2) k) (MvPolynomial (Fin 2) A) :=
      Module.Free.of_basis b_B
    have _ : Module.Flat (MvPolynomial (Fin 2) k) (MvPolynomial (Fin 2) A) :=
      Module.Flat.of_free
    change RingHom.Flat (algebraMap (MvPolynomial (Fin 2) k) (MvPolynomial (Fin 2) A ⧸ J_F))
    rw [RingHom.flat_algebraMap_iff, Module.Flat.iff_rTensor_injective']
    intro I
    let ψ_I : TensorProduct (MvPolynomial (Fin 2) k) I (MvPolynomial (Fin 2) A) →ₗ[MvPolynomial (Fin 2) k]
        MvPolynomial (Fin 2) A :=
      (TensorProduct.lid (MvPolynomial (Fin 2) k) (MvPolynomial (Fin 2) A)).toLinearMap.comp
        (LinearMap.rTensor (MvPolynomial (Fin 2) A) I.subtype)
    have hψ_inj : Function.Injective ψ_I :=
      (TensorProduct.lid (MvPolynomial (Fin 2) k) (MvPolynomial (Fin 2) A)).injective.comp
        (Module.Flat.iff_rTensor_injective'.mp inferInstance I)
    have hψ_tmul : ∀ (r : I) (b : MvPolynomial (Fin 2) A),
        ψ_I (TensorProduct.tmul (MvPolynomial (Fin 2) k) r b) = φ r.1 * b :=
      fun _ _ => rfl
    have hψ_lTensor_mul : ∀ (c : MvPolynomial (Fin 2) A)
        (w : TensorProduct (MvPolynomial (Fin 2) k) I (MvPolynomial (Fin 2) A)),
        ψ_I ((LinearMap.lTensor I (LinearMap.mulLeft (MvPolynomial (Fin 2) k) c)) w) = c * ψ_I w := by
      intro c
      have h_lin :
          ψ_I.comp (LinearMap.lTensor I (LinearMap.mulLeft (MvPolynomial (Fin 2) k) c)) =
            (LinearMap.mulLeft (MvPolynomial (Fin 2) k) c).comp ψ_I := by
        apply TensorProduct.ext'
        intro r b
        change ψ_I ((LinearMap.lTensor I (LinearMap.mulLeft (MvPolynomial (Fin 2) k) c))
          (TensorProduct.tmul (MvPolynomial (Fin 2) k) r b)) =
          c * ψ_I (TensorProduct.tmul (MvPolynomial (Fin 2) k) r b)
        rw [LinearMap.lTensor_tmul, LinearMap.mulLeft_apply, hψ_tmul, hψ_tmul, mul_left_comm]
      intro w
      exact LinearMap.congr_fun h_lin w
    have hψ_mem : ∀ w : TensorProduct (MvPolynomial (Fin 2) k) I (MvPolynomial (Fin 2) A),
        ψ_I w ∈ Ideal.map φ I := by
      let J_sub : Submodule (MvPolynomial (Fin 2) k) (MvPolynomial (Fin 2) A) :=
        (Ideal.map φ I).restrictScalars (MvPolynomial (Fin 2) k)
      have h_zero : (Submodule.mkQ J_sub).comp ψ_I = 0 := by
        apply TensorProduct.ext'
        intro r b
        change Submodule.mkQ J_sub (ψ_I (TensorProduct.tmul (MvPolynomial (Fin 2) k) r b)) = 0
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        change ψ_I (TensorProduct.tmul (MvPolynomial (Fin 2) k) r b) ∈ Ideal.map φ I
        rw [hψ_tmul]
        exact Ideal.mul_mem_right b _ (Ideal.mem_map_of_mem φ r.2)
      intro w
      have hw0 : Submodule.mkQ J_sub (ψ_I w) = 0 := LinearMap.congr_fun h_zero w
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hw0
      exact hw0
    have hψ_surj_on : ∀ x ∈ Ideal.map φ I,
        ∃ w : TensorProduct (MvPolynomial (Fin 2) k) I (MvPolynomial (Fin 2) A), ψ_I w = x := by
      intro x hx
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
      · rintro _ ⟨r, hr, rfl⟩
        exact ⟨TensorProduct.tmul (MvPolynomial (Fin 2) k) ⟨r, hr⟩ 1, by rw [hψ_tmul, mul_one]⟩
      · exact ⟨0, map_zero ψ_I⟩
      · rintro x₁ x₂ _ _ ⟨w₁, rfl⟩ ⟨w₂, rfl⟩
        exact ⟨w₁ + w₂, map_add ψ_I w₁ w₂⟩
      · rintro c x₁ _ ⟨w₁, rfl⟩
        exact ⟨(LinearMap.lTensor I (LinearMap.mulLeft (MvPolynomial (Fin 2) k) c)) w₁,
          hψ_lTensor_mul c w₁⟩
    let q : MvPolynomial (Fin 2) A →ₗ[MvPolynomial (Fin 2) k] (MvPolynomial (Fin 2) A ⧸ J_F) :=
      (Submodule.mkQ J_F).restrictScalars (MvPolynomial (Fin 2) k)
    have hq_surj : Function.Surjective q := Submodule.mkQ_surjective J_F
    let ψ_M : TensorProduct (MvPolynomial (Fin 2) k) I (MvPolynomial (Fin 2) A ⧸ J_F) →ₗ[MvPolynomial (Fin 2) k]
        (MvPolynomial (Fin 2) A ⧸ J_F) :=
      (TensorProduct.lid (MvPolynomial (Fin 2) k) (MvPolynomial (Fin 2) A ⧸ J_F)).toLinearMap.comp
        (LinearMap.rTensor (MvPolynomial (Fin 2) A ⧸ J_F) I.subtype)
    have h_comm : ∀ v_t : TensorProduct (MvPolynomial (Fin 2) k) I (MvPolynomial (Fin 2) A),
        ψ_M ((LinearMap.lTensor I q) v_t) = q (ψ_I v_t) := by
      have h_lin : ψ_M.comp (LinearMap.lTensor I q) = q.comp ψ_I := by
        apply TensorProduct.ext'
        intro r b
        change ψ_M (TensorProduct.tmul (MvPolynomial (Fin 2) k) r (q b)) =
          q (ψ_I (TensorProduct.tmul (MvPolynomial (Fin 2) k) r b))
        have h_lhs : ψ_M (TensorProduct.tmul (MvPolynomial (Fin 2) k) r (q b)) = r.1 • q b := rfl
        rw [h_lhs, hψ_tmul, ← h_smul_RB, map_smul]
      intro v_t
      exact LinearMap.congr_fun h_lin v_t
    rw [injective_iff_map_eq_zero]
    intro u hu
    obtain ⟨v_t, rfl⟩ := LinearMap.lTensor_surjective I hq_surj u
    have hq_zero : q (ψ_I v_t) = 0 := by
      rw [← h_comm v_t]
      dsimp [ψ_M]
      rw [hu, map_zero]
    have h_mem_JF : ψ_I v_t ∈ J_F := Ideal.Quotient.eq_zero_iff_mem.mp hq_zero
    obtain ⟨b, hb_eq⟩ := Ideal.mem_span_singleton.mp h_mem_JF
    have hb_mem : b ∈ Ideal.map φ I := by
      apply hReg I b
      rw [← hb_eq]
      exact hψ_mem v_t
    obtain ⟨w, hw⟩ := hψ_surj_on b hb_mem
    have hv_eq : v_t = (LinearMap.lTensor I (LinearMap.mulLeft (MvPolynomial (Fin 2) k) F)) w := by
      apply hψ_inj
