        change (1 : S_V ⧸ 𝔪) = 0
        rw [← map_one (algebraMap k (S_V ⧸ 𝔪)), ← mul_inv_cancel₀ hc0, map_mul, hc, zero_mul]
      exact h𝔪.ne_top ((Ideal.eq_top_iff_one 𝔪).mpr (Ideal.Quotient.eq_zero_iff_mem.mp h1))
    let e_res : k ≃+* (S_V ⧸ 𝔪) := RingEquiv.ofBijective (algebraMap k (S_V ⧸ 𝔪)) ⟨hk_inj, hk_surj⟩
    let ε : S_V →+* k := e_res.symm.toRingHom.comp (Ideal.Quotient.mk 𝔪)
    have hε_fV : ∀ c : k, ε (f_V c) = c := fun c => e_res.symm_apply_apply c
    let ε_hom : C.left.presheaf.obj (Opposite.op V) ⟶ CommRingCat.of k := CommRingCat.ofHom ε
    have hcomp_ε : (e_Γ.inv ≫ C.hom.appLE ⊤ V hle) ≫ ε_hom = 𝟙 (CommRingCat.of k) :=
      CommRingCat.hom_ext (RingHom.ext fun c => hε_fV c)
    have happ_ε : C.hom.appLE ⊤ V hle ≫ ε_hom = e_Γ.hom := by
      have h1 := e_Γ.hom ≫= hcomp_ε
      simpa only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc,
        CategoryTheory.Category.comp_id] using h1
    let q_x : S_k ⟶ C.left :=
      S_k.isoSpec.hom ≫ AlgebraicGeometry.Spec.map e_Γ.inv ≫
        AlgebraicGeometry.Spec.map ε_hom ≫ hAffV.fromSpec
    have hq_sec : q_x ≫ C.hom = 𝟙 S_k := by
      dsimp only [q_x]
      have hSpec_comm :
          AlgebraicGeometry.Spec.map (C.hom.appLE ⊤ V hle) ≫
            (AlgebraicGeometry.isAffineOpen_top S_k).fromSpec =
          hAffV.fromSpec ≫ C.hom :=
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec C.hom
          (AlgebraicGeometry.isAffineOpen_top S_k) hAffV hle
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, ← hSpec_comm,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map ε_hom),
        ← AlgebraicGeometry.Spec.map_comp, happ_ε,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map e_Γ.inv),
        ← AlgebraicGeometry.Spec.map_comp, e_Γ.hom_inv_id,
        AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp,
        AlgebraicGeometry.IsAffineOpen.fromSpec_top,
        S_k.isoSpec.hom_inv_id]
    let H₀ : CategoryTheory.Over S_k := CategoryTheory.Over.mk (𝟙 S_k)
    let i_H : H₀ ⟶ C := CategoryTheory.Over.homMk q_x hq_sec
    have hInt_H₀ : AlgebraicGeometry.IsIntegral H₀.left := by
      change AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (CommRingCat.of k))
      exact (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of k)).mpr
        (@Field.isDomain k _)
    have hProp_H₀ : AlgebraicGeometry.IsProper H₀.hom := by
      dsimp [H₀]
      infer_instance
    have hSm_H₀ : AlgebraicGeometry.SmoothOfRelativeDimension 0 H₀.hom := by
      dsimp [H₀]
      exact (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero (𝟙 S_k)).mp inferInstance
    have hProj_H₀ : IsProjectiveOverField k H₀ := by
      have : CategoryTheory.IsIso (weilProjectiveSpaceOver k 0).hom := helper_projZeroIso
      let e_P0 : (weilProjectiveSpaceOver k 0).left ≅ S_k :=
        CategoryTheory.asIso (weilProjectiveSpaceOver k 0).hom
      let ι_H0 : H₀ ⟶ weilProjectiveSpaceOver k 0 :=
        CategoryTheory.Over.homMk e_P0.inv (by
          dsimp [H₀, e_P0]
          exact CategoryTheory.IsIso.inv_hom_id (weilProjectiveSpaceOver k 0).hom)
      refine ⟨0, ι_H0, ?_⟩
      change AlgebraicGeometry.IsClosedImmersion e_P0.inv
      infer_instance
    have hCl_iH : AlgebraicGeometry.IsClosedImmersion i_H.left := by
      change AlgebraicGeometry.IsClosedImmersion q_x
      have : AlgebraicGeometry.IsClosedImmersion (q_x ≫ C.hom) := by
        rw [hq_sec]
        infer_instance
      exact AlgebraicGeometry.IsClosedImmersion.of_comp q_x C.hom
    exact ⟨H₀, i_H, hInt_H₀, hProp_H₀, hSm_H₀, hProj_H₀, hCl_iH⟩

theorem weil_net_incidence_subscheme_and_chart_iso (k : Type u) [Field k] (M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (L : Fin 3 → MvPolynomial (Fin (M + 1)) k)
    (hL_homog : ∀ r : Fin 3, L r ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1) :
    ∃ (Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π_Y : Y₂ ⟶ Z_bar)
      (g₂ : Y₂ ⟶ weilProjectiveSpaceOver k 2),
      IsLinearNetIncidenceFamily k M Z_bar ι_bar L Y₂ π_Y g₂ ∧
      (AlgebraicGeometry.IsProper Y₂.hom ∧ AlgebraicGeometry.IsProper g₂.left) ∧
      (∃ (ι_Y₂ : Y₂.left ⟶
          CategoryTheory.Limits.pullback Z_bar.hom (weilProjectiveSpaceOver k 2).hom),
        AlgebraicGeometry.IsClosedImmersion ι_Y₂ ∧
        ι_Y₂ ≫ CategoryTheory.Limits.pullback.fst Z_bar.hom (weilProjectiveSpaceOver k 2).hom =
          π_Y.left ∧
        ι_Y₂ ≫ CategoryTheory.Limits.pullback.snd Z_bar.hom (weilProjectiveSpaceOver k 2).hom =
          g₂.left) ∧
      ((letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
          MvPolynomial.gradedAlgebra
        (⨆ (α : Fin (M + 1)),
          (TopologicalSpace.Opens.map ι_bar.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α))) = ⊤) ∧
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
          MvPolynomial.gradedAlgebra
        (⨆ (β : Fin 3),
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin 3) k) (MvPolynomial.X β) :
            (weilProjectiveSpaceOver k 2).left.Opens)) = ⊤)) ∧
      (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
          MvPolynomial.gradedAlgebra
       letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
          MvPolynomial.gradedAlgebra
       ∀ (β : Fin 3),
        AlgebraicGeometry.IsAffineOpen
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin 3) k) (MvPolynomial.X β) :
            (weilProjectiveSpaceOver k 2).left.Opens) ∧
        ∃ (e_P : MvPolynomial (Fin 2) k ≃+*
            ↑((weilProjectiveSpaceOver k 2).left.presheaf.obj
              (Opposite.op
                (AlgebraicGeometry.Proj.basicOpen
                  (MvPolynomial.homogeneousSubmodule (Fin 3) k) (MvPolynomial.X β) :
                  (weilProjectiveSpaceOver k 2).left.Opens)))),
          ∀ (α : Fin (M + 1))
            (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈
              MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
            (U_Z : Z_bar.left.Opens)
            (hAffZ : AlgebraicGeometry.IsAffineOpen U_Z)
            (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
              (AlgebraicGeometry.Proj.basicOpen
                (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α))),
            let D_β : (weilProjectiveSpaceOver k 2).left.Opens :=
              AlgebraicGeometry.Proj.basicOpen
                (MvPolynomial.homogeneousSubmodule (Fin 3) k) (MvPolynomial.X β)
            let V_Y : Y₂.left.Opens :=
              (TopologicalSpace.Opens.map π_Y.left.base).obj U_Z ⊓
                (TopologicalSpace.Opens.map g₂.left.base).obj D_β
            let A := ↑(Z_bar.left.presheaf.obj (Opposite.op U_Z))
            let κ_Z : k →+* A :=
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                Z_bar.hom.appLE ⊤ U_Z le_top).hom
            let ℓ_r : Fin 3 → A := fun r =>
              ((AlgebraicGeometry.Proj.basicOpenIsoAway
                  (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
                  (MvPolynomial.X α) hXα zero_lt_one).hom ≫
                ι_bar.left.appLE
                  (AlgebraicGeometry.Proj.basicOpen
                    (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α))
                  U_Z hUZ).hom
                (HomogeneousLocalization.mk
                  ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
            let I_inc : Ideal (MvPolynomial (Fin 2) A) :=
              Ideal.span ({MvPolynomial.C (ℓ_r β) +
                MvPolynomial.C (ℓ_r (β.succAbove 0)) * MvPolynomial.X (0 : Fin 2) +
                MvPolynomial.C (ℓ_r (β.succAbove 1)) * MvPolynomial.X (1 : Fin 2)} :
                  Set (MvPolynomial (Fin 2) A))
            ∃ (hAffVY : AlgebraicGeometry.IsAffineOpen V_Y)
              (e_Y : (MvPolynomial (Fin 2) A ⧸ I_inc) ≃+*
                ↑(Y₂.left.presheaf.obj (Opposite.op V_Y))),
              (∀ (z : ↥U_Z) (r : Fin 3),
                ι_bar.left.base z.1 ∈ weilProjHyperplaneSet k M (L r) ↔
                  ℓ_r r ∈ (hAffZ.primeIdealOf z).asIdeal) ∧
              (∀ (z : ↥U_Z) (c : Fin 3 → k),
                ι_bar.left.base z.1 ∈
                  weilProjHyperplaneSet k M (∑ r : Fin 3, MvPolynomial.C (c r) * L r) ↔
                  (∑ r : Fin 3, κ_Z (c r) * ℓ_r r) ∈ (hAffZ.primeIdealOf z).asIdeal) ∧
              (∀ a : A,
                (π_Y.left.appLE U_Z V_Y inf_le_left).hom a =
                  e_Y (Ideal.Quotient.mk I_inc (MvPolynomial.C a))) ∧
              (∀ P : MvPolynomial (Fin 2) k,
                (g₂.left.appLE D_β V_Y inf_le_right).hom (e_P P) =
                  e_Y (Ideal.Quotient.mk I_inc (MvPolynomial.map κ_Z P))) ∧
              (∀ c : k,
                ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                  Y₂.hom.appLE ⊤ V_Y le_top).hom c =
                  e_Y (Ideal.Quotient.mk I_inc (MvPolynomial.C (κ_Z c)))) ∧
              (∀ (y : ↥V_Y) (i : Fin 2),
                g₂.left.base y.1 ∈
                  AlgebraicGeometry.Proj.basicOpen
                    (MvPolynomial.homogeneousSubmodule (Fin 3) k)
                    (MvPolynomial.X (β.succAbove i)) ↔
                  e_Y (Ideal.Quotient.mk I_inc (MvPolynomial.X i)) ∉
                    (hAffVY.primeIdealOf y).asIdeal)) :=
by
  classical

  
  
  
  have hPart1 : ∀ (N : ℕ),
      let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      let _ : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
      ((letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
        (⨆ (α : Fin (N + 1)),
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α) :
            (AlgebraicGeometry.Proj 𝒜_N).Opens)) = ⊤) ∧
       (AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom ∧
        (letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
         ∀ (α : Fin (N + 1)),
          AlgebraicGeometry.IsAffineOpen
            (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)))) ∧
       (letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
        ∀ (α : Fin (N + 1))
          (hXα : (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1)
          (c : k),
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            (weilProjectiveSpaceOver k N).hom.appLE ⊤
              (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)) le_top).hom c =
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom).hom
            (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (MvPolynomial.X α))
              (algebraMap k ↥(𝒜_N 0) c))) ∧
       (letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
        ∀ (α α' : Fin (N + 1))
          (hXα : (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1)
          (hXα' : (MvPolynomial.X α' : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1),
          let D_α := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)
          let D_α' := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α')
          ∃ u : ↑((AlgebraicGeometry.Proj 𝒜_N).presheaf.obj (Opposite.op (D_α ⊓ D_α'))),
            IsUnit u ∧
            ∀ (F : MvPolynomial (Fin (N + 1)) k) (hF : F ∈ 𝒜_N 1),
              ((AlgebraicGeometry.Proj 𝒜_N).presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
                (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom).hom
                  (HomogeneousLocalization.mk
                    ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)) =
              u * ((AlgebraicGeometry.Proj 𝒜_N).presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
                (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α') hXα' zero_lt_one).hom).hom
                  (HomogeneousLocalization.mk
                    ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α', hXα'⟩, ⟨1, pow_one _⟩⟩))) ∧
       (letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
        ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (ι : Z ⟶ weilProjectiveSpaceOver k N)
          (α : Fin (N + 1))
          (hXα : (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1)
          (U_Z : Z.left.Opens)
          (hAffZ : AlgebraicGeometry.IsAffineOpen U_Z)
          (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α))),
          (∀ (F : MvPolynomial (Fin (N + 1)) k) (hF : F ∈ 𝒜_N 1),
            let dehom_F : ↑(Z.left.presheaf.obj (Opposite.op U_Z)) :=
              ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom ≫
                ι.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)) U_Z hUZ).hom
                (HomogeneousLocalization.mk
                  ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
            Z.left.basicOpen dehom_F =
              U_Z ⊓ (TopologicalSpace.Opens.map ι.left.base).obj
                (AlgebraicGeometry.Proj.basicOpen 𝒜_N F) ∧
            ∀ (z : ↥U_Z),
              ι.left.base z.1 ∈ weilProjHyperplaneSet k N F ↔
                dehom_F ∈ (hAffZ.primeIdealOf z).asIdeal) ∧
          (∀ (m : ℕ) (c : Fin m → k) (F : Fin m → MvPolynomial (Fin (N + 1)) k)
             (hF : ∀ j : Fin m, F j ∈ 𝒜_N 1)
             (hSum : (∑ j : Fin m,
               (MvPolynomial.C (c j) : MvPolynomial (Fin (N + 1)) k) * F j) ∈ 𝒜_N 1),
            ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom ≫
              ι.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)) U_Z hUZ).hom
              (HomogeneousLocalization.mk
                ⟨1, ⟨∑ j : Fin m,
                  (MvPolynomial.C (c j) : MvPolynomial (Fin (N + 1)) k) * F j, hSum⟩,
                  ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩) =
            ∑ j : Fin m,
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                Z.hom.appLE ⊤ U_Z le_top).hom (c j)) *
              ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom ≫
                ι.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)) U_Z hUZ).hom
                (HomogeneousLocalization.mk
                  ⟨1, ⟨F j, hF j⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)))) := by
    intro N
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
      MvPolynomial.gradedAlgebra
    let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let P_N := weilProjectiveSpaceOver k N

    have hAdjoin : Algebra.adjoin (↥(𝒜_N 0))
        (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) k)) = ⊤ := by
      ext p
      simp only [Algebra.mem_top, iff_true]
      induction p using MvPolynomial.induction_on with
      | C a =>
        let a₀ : ↥(𝒜_N 0) := ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C (Fin (N + 1)) a⟩
        have ha₀ : algebraMap (↥(𝒜_N 0)) (MvPolynomial (Fin (N + 1)) k) a₀ = MvPolynomial.C a := rfl
        rw [← ha₀]
        exact Subalgebra.algebraMap_mem _ a₀
      | add p q hp hq => exact Subalgebra.add_mem _ hp hq
      | mul_X p i hp =>
        exact Subalgebra.mul_mem _ hp (Algebra.subset_adjoin ⟨i, rfl⟩)

    have hCov : (⨆ (α : Fin (N + 1)),
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α) :
          (AlgebraicGeometry.Proj 𝒜_N).Opens)) = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜_N MvPolynomial.X
        (fun α => ⟨1, MvPolynomial.isHomogeneous_X k α⟩) hAdjoin

    have hAff : ∀ (α : Fin (N + 1)),
        AlgebraicGeometry.IsAffineOpen
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)) :=
      fun α => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_N (MvPolynomial.X α)
        (MvPolynomial.isHomogeneous_X k α) zero_lt_one

    have hProp : AlgebraicGeometry.IsProper P_N.hom := by
      have _ : Algebra.FiniteType (↥(𝒜_N 0)) (MvPolynomial (Fin (N + 1)) k) :=
        ⟨Finset.univ.image MvPolynomial.X, by simpa using hAdjoin⟩
      have _ : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜_N) :=
        AlgebraicGeometry.Proj.instIsProperToSpecZeroOfFiniteTypeSubtypeMemOfNatNat 𝒜_N
      let φ₀ : k →+* ↥(𝒜_N 0) := algebraMap k ↥(𝒜_N 0)
      have hBij : Function.Bijective φ₀ := by
        refine ⟨?_, ?_⟩
        · intro c₁ c₂ h
          have hval : (φ₀ c₁).1 = (φ₀ c₂).1 := congrArg Subtype.val h
          exact @MvPolynomial.C_injective (Fin (N + 1)) k _ c₁ c₂ hval
        · rintro ⟨P, hP⟩
          refine ⟨MvPolynomial.constantCoeff P, Subtype.ext ?_⟩
          change MvPolynomial.C (MvPolynomial.constantCoeff P) = P
          ext d
          by_cases hd : d = 0
          · subst hd
            simp only [MvPolynomial.coeff_C, ↓reduceIte]
            rfl
          · rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr fun h0 => absurd h0.symm hd]
            by_contra hne
            have hP' : P.IsHomogeneous 0 :=
              (MvPolynomial.mem_homogeneousSubmodule 0 P).mp hP
            have hdeg := hP' (Ne.symm hne)
            rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => by simp)] at hdeg
            simp only [Pi.one_apply, smul_eq_mul, mul_one] at hdeg
            apply hd
            ext i
            simp only [Finsupp.coe_zero, Pi.zero_apply]
            have hle : d i ≤ ∑ j : Fin (N + 1), d j :=
              Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
            omega
      let e₀ : k ≃+* ↥(𝒜_N 0) := RingEquiv.ofBijective φ₀ hBij
      have he₀ : CommRingCat.ofHom φ₀ = e₀.toCommRingCatIso.hom := rfl
      have _ : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) := by
        rw [he₀]
        infer_instance
      change AlgebraicGeometry.IsProper
        (AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀))
      infer_instance

    have hAwayEq : ∀ (α : Fin (N + 1))
        (hXα : (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1),
        AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) hXα zero_lt_one =
          AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).inv ≫
            (hAff α).fromSpec := by
      intro α hXα
      let D_α := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)
      let isoS := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X α) hXα zero_lt_one
      let isoA := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one
      rw [← CategoryTheory.cancel_epi isoS.hom]
      have hL : isoS.hom ≫ AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) hXα zero_lt_one =
          D_α.ι := by
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι, ← CategoryTheory.Category.assoc,
          isoS.hom_inv_id, CategoryTheory.Category.id_comp]
      have hS_hom : isoS.hom =
          D_α.toSpecΓ ≫ AlgebraicGeometry.Spec.map isoA.hom := by
        change isoS.hom = D_α.toSpecΓ ≫ AlgebraicGeometry.Spec.map _
        rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_hom, AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
        rfl
      have hfrom : D_α.toSpecΓ ≫ (hAff α).fromSpec = D_α.ι := by
        rw [← (hAff α).isoSpec_hom]
        change (hAff α).isoSpec.hom ≫ (hAff α).isoSpec.inv ≫ D_α.ι = D_α.ι
        rw [← CategoryTheory.Category.assoc, (hAff α).isoSpec.hom_inv_id,
          CategoryTheory.Category.id_comp]
      rw [hL, hS_hom, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map isoA.hom),
        ← AlgebraicGeometry.Spec.map_comp, isoA.inv_hom_id, AlgebraicGeometry.Spec.map_id,
        CategoryTheory.Category.id_comp, hfrom]

    have hConst : ∀ (α : Fin (N + 1))
        (hXα : (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1)
        (c : k),
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          P_N.hom.appLE ⊤ (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)) le_top).hom c =
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom).hom
          (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (MvPolynomial.X α))
            (algebraMap k ↥(𝒜_N 0) c)) := by
      intro α hXα c
      let D_α := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)
      let p_hom : AlgebraicGeometry.Proj 𝒜_N ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0)))
      let isoA := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one
      let R_α := CommRingCat.of (HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α))
      let φ_c : CommRingCat.of k ⟶ R_α :=
        CommRingCat.ofHom
          ((HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (MvPolynomial.X α))).comp
            (algebraMap k ↥(𝒜_N 0)))
      have hSpec_eq : AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) hXα zero_lt_one ≫ p_hom =
          AlgebraicGeometry.Spec.map φ_c := by
        dsimp [p_hom]
        rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h_from_le : (⊤ : (AlgebraicGeometry.Spec
          ((AlgebraicGeometry.Proj 𝒜_N).presheaf.obj (Opposite.op D_α))).Opens) ≤
          (TopologicalSpace.Opens.map (hAff α).fromSpec.base).obj D_α := by
        intro p _
        exact ((hAff α).isoSpec.inv.base p).2
      have h_away_le : (⊤ : (AlgebraicGeometry.Spec R_α).Opens) ≤
          (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).base).obj D_α := by
        rw [hAwayEq α hXα]
        intro p _
        exact @h_from_le ((AlgebraicGeometry.Spec.map isoA.inv).base p) trivial
      have h_app_comp :
          p_hom.appLE ⊤ D_α le_top ≫
            (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).appLE D_α ⊤ h_away_le =
          (AlgebraicGeometry.Spec.map φ_c).appTop := by
        rw [← hSpec_eq]
        exact AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE _ p_hom ⊤ D_α ⊤ le_top h_away_le
      have h_from_app : (hAff α).fromSpec.appLE D_α ⊤ h_from_le =
          (AlgebraicGeometry.Scheme.ΓSpecIso
            ((AlgebraicGeometry.Proj 𝒜_N).presheaf.obj (Opposite.op D_α))).inv := by
        have happ_map : (hAff α).fromSpec.app D_α ≫
            (AlgebraicGeometry.Spec
              ((AlgebraicGeometry.Proj 𝒜_N).presheaf.obj (Opposite.op D_α))).presheaf.map
              (CategoryTheory.homOfLE h_from_le).op =
            (hAff α).fromSpec.appLE D_α ⊤ h_from_le := by
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE (hAff α).fromSpec (U := D_α),
            AlgebraicGeometry.Scheme.Hom.appLE_map]
        have h_map_id : ∀ (u : Opposite.op
                (⊤ : (AlgebraicGeometry.Spec
                  ((AlgebraicGeometry.Proj 𝒜_N).presheaf.obj (Opposite.op D_α))).Opens) ⟶
              Opposite.op ⊤),
            (AlgebraicGeometry.Spec
              ((AlgebraicGeometry.Proj 𝒜_N).presheaf.obj (Opposite.op D_α))).presheaf.map u = 𝟙 _ := by
          intro u
          rw [Subsingleton.elim u (𝟙 _), CategoryTheory.Functor.map_id]
        rw [← happ_map, (hAff α).fromSpec_app_self, CategoryTheory.Category.assoc,
          ← CategoryTheory.Functor.map_comp, h_map_id, CategoryTheory.Category.comp_id]
      have h_away_app :
          (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).appLE D_α ⊤ h_away_le =
            isoA.inv ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R_α).inv := by
        have h_comp_le : (⊤ : (AlgebraicGeometry.Spec R_α).Opens) ≤
            (TopologicalSpace.Opens.map
              (AlgebraicGeometry.Spec.map isoA.inv ≫ (hAff α).fromSpec).base).obj D_α := by
          rwa [← hAwayEq α hXα]
        have h1 : (AlgebraicGeometry.Spec.map isoA.inv ≫ (hAff α).fromSpec).appLE D_α ⊤ h_comp_le =
            (hAff α).fromSpec.appLE D_α ⊤ h_from_le ≫
              (AlgebraicGeometry.Spec.map isoA.inv).appLE ⊤ ⊤ le_top :=
          (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE _ _ D_α ⊤ ⊤ h_from_le le_top).symm
        have h2 : (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).appLE D_α ⊤ h_away_le =
            (AlgebraicGeometry.Spec.map isoA.inv ≫ (hAff α).fromSpec).appLE D_α ⊤ h_comp_le := by
          congr 1
          exact hAwayEq α hXα
        rw [h2, h1, h_from_app]
        change (AlgebraicGeometry.Scheme.ΓSpecIso _).inv ≫ (AlgebraicGeometry.Spec.map isoA.inv).appTop = _
        rw [← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality]
      rw [h_away_app] at h_app_comp
      have h_eq1 : p_hom.appLE ⊤ D_α le_top ≫ isoA.inv =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫ φ_c := by
        have h3 := congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R_α).hom) h_app_comp
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.comp_id] at h3
        exact h3.trans (AlgebraicGeometry.Scheme.ΓSpecIso_naturality φ_c)
      have h_eq2 : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          p_hom.appLE ⊤ D_α le_top = φ_c ≫ isoA.hom := by
        calc (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ p_hom.appLE ⊤ D_α le_top
          _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                (p_hom.appLE ⊤ D_α le_top ≫ isoA.inv) ≫ isoA.hom := by
              rw [CategoryTheory.Category.assoc, isoA.inv_hom_id, CategoryTheory.Category.comp_id]
          _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫ φ_c) ≫ isoA.hom := by
              rw [h_eq1]
          _ = φ_c ≫ isoA.hom := by
              simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
      exact congrArg (fun f : CommRingCat.of k ⟶ _ => f.hom c) h_eq2

    have hOverlap : ∀ (α α' : Fin (N + 1))
        (hXα : (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1)
        (hXα' : (MvPolynomial.X α' : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1),
        let D_α := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)
        let D_α' := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α')
        ∃ u : ↑((AlgebraicGeometry.Proj 𝒜_N).presheaf.obj (Opposite.op (D_α ⊓ D_α'))),
          IsUnit u ∧
          ∀ (F : MvPolynomial (Fin (N + 1)) k) (hF : F ∈ 𝒜_N 1),
            ((AlgebraicGeometry.Proj 𝒜_N).presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
              (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom).hom
                (HomogeneousLocalization.mk
                  ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)) =
            u * ((AlgebraicGeometry.Proj 𝒜_N).presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
              (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α') hXα' zero_lt_one).hom).hom
                (HomogeneousLocalization.mk
                  ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α', hXα'⟩, ⟨1, pow_one _⟩⟩)) := by
      intro α α' hXα hXα'
      let D_α := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)
      let D_α' := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α')
      let x : MvPolynomial (Fin (N + 1)) k := MvPolynomial.X α * MvPolynomial.X α'
      let S_x := Submonoid.powers x
      have hx_left : x = MvPolynomial.X α * MvPolynomial.X α' := rfl
      have hx_right : x = MvPolynomial.X α' * MvPolynomial.X α := mul_comm _ _
      have hD_eq : AlgebraicGeometry.Proj.basicOpen 𝒜_N x = D_α ⊓ D_α' :=
        AlgebraicGeometry.Proj.basicOpen_mul 𝒜_N (MvPolynomial.X α) (MvPolynomial.X α')
      let res_x : (AlgebraicGeometry.Proj 𝒜_N).presheaf.obj
            (Opposite.op (AlgebraicGeometry.Proj.basicOpen 𝒜_N x)) ⟶
          (AlgebraicGeometry.Proj 𝒜_N).presheaf.obj (Opposite.op (D_α ⊓ D_α')) :=
        (AlgebraicGeometry.Proj 𝒜_N).presheaf.map (CategoryTheory.homOfLE hD_eq.ge).op
      let τ_x : HomogeneousLocalization.Away 𝒜_N x →+*
          ↑((AlgebraicGeometry.Proj 𝒜_N).presheaf.obj (Opposite.op (D_α ⊓ D_α'))) :=
        (AlgebraicGeometry.Proj.awayToSection 𝒜_N x ≫ res_x).hom
      have hLeftMap : ∀ s : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α),
          ((AlgebraicGeometry.Proj 𝒜_N).presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
            (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom).hom s) =
          τ_x (HomogeneousLocalization.awayMap 𝒜_N hXα' hx_left s) := by
        intro s
        rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
        have h1 := AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜_N hXα' hx_left
        have h2 := congrArg (· ≫ res_x) h1
        have h_rhs : (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α) ≫
              (AlgebraicGeometry.Proj 𝒜_N).presheaf.map
                (CategoryTheory.homOfLE (by rw [hx_left, AlgebraicGeometry.Proj.basicOpen_mul]; exact inf_le_left)).op) ≫
            res_x =
            AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α) ≫
              (AlgebraicGeometry.Proj 𝒜_N).presheaf.map (CategoryTheory.homOfLE inf_le_left).op := by
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp]
          congr 2
        have h3 := h2.trans h_rhs
        exact (congrArg
          (fun f : CommRingCat.of (HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α)) ⟶
              (AlgebraicGeometry.Proj 𝒜_N).presheaf.obj (Opposite.op (D_α ⊓ D_α')) => f.hom s) h3).symm
      have hRightMap : ∀ s : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α'),
          ((AlgebraicGeometry.Proj 𝒜_N).presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
            (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α') hXα' zero_lt_one).hom).hom s) =
          τ_x (HomogeneousLocalization.awayMap 𝒜_N hXα hx_right s) := by
        intro s
        rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
        have h1 := AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜_N hXα hx_right
        have h2 := congrArg (· ≫ res_x) h1
        have h_rhs : (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α') ≫
              (AlgebraicGeometry.Proj 𝒜_N).presheaf.map
                (CategoryTheory.homOfLE (by rw [hx_right, AlgebraicGeometry.Proj.basicOpen_mul]; exact inf_le_left)).op) ≫
            res_x =
            AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α') ≫
              (AlgebraicGeometry.Proj 𝒜_N).presheaf.map (CategoryTheory.homOfLE inf_le_right).op := by
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp]
          congr 2
        have h3 := h2.trans h_rhs
        exact (congrArg
          (fun f : CommRingCat.of (HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α')) ⟶
              (AlgebraicGeometry.Proj 𝒜_N).presheaf.obj (Opposite.op (D_α ⊓ D_α')) => f.hom s) h3).symm
      have hMkEqAwayMk : ∀ {y : MvPolynomial (Fin (N + 1)) k} (hy : y ∈ 𝒜_N 1)
          (G : MvPolynomial (Fin (N + 1)) k) (hG : G ∈ 𝒜_N 1),
          (HomogeneousLocalization.mk ⟨1, ⟨G, hG⟩, ⟨y, hy⟩, ⟨1, pow_one _⟩⟩ :
            HomogeneousLocalization.Away 𝒜_N y) =
          HomogeneousLocalization.Away.mk 𝒜_N hy 1 G (by simpa using hG) := by
        intro y hy G hG
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk]
        change Localization.mk G (⟨y, ⟨1, pow_one _⟩⟩ : Submonoid.powers y) =
          Localization.mk G (⟨y ^ 1, ⟨1, rfl⟩⟩ : Submonoid.powers y)
        exact Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq (by simp))
      let u₀ : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α) :=
        HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X α', hXα'⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩
      let v₀ : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α') :=
        HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X α, hXα⟩, ⟨MvPolynomial.X α', hXα'⟩, ⟨1, pow_one _⟩⟩
      let u : ↑((AlgebraicGeometry.Proj 𝒜_N).presheaf.obj (Opposite.op (D_α ⊓ D_α'))) :=
        ((AlgebraicGeometry.Proj 𝒜_N).presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
          (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom).hom u₀)
      let v : ↑((AlgebraicGeometry.Proj 𝒜_N).presheaf.obj (Opposite.op (D_α ⊓ D_α'))) :=
        ((AlgebraicGeometry.Proj 𝒜_N).presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
          (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α') hXα' zero_lt_one).hom).hom v₀)
      have huv_away : HomogeneousLocalization.awayMap 𝒜_N hXα' hx_left u₀ *
          HomogeneousLocalization.awayMap 𝒜_N hXα hx_right v₀ = 1 := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one]
        dsimp [u₀, v₀]
        rw [hMkEqAwayMk hXα (MvPolynomial.X α') hXα',
          hMkEqAwayMk hXα' (MvPolynomial.X α) hXα,
          HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
          Localization.mk_mul,
          ← map_one (algebraMap (MvPolynomial (Fin (N + 1)) k) (Localization S_x)),
          ← Localization.mk_one_eq_algebraMap]
        refine Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq ?_)
        simp [x]
        ring
      have huv : u * v = 1 := by
        dsimp [u, v]
        rw [hLeftMap u₀, hRightMap v₀, ← map_mul, huv_away, map_one]
      refine ⟨u, isUnit_iff_exists_inv.mpr ⟨v, huv⟩, fun F hF => ?_⟩
      dsimp [u]
      rw [hLeftMap, hLeftMap u₀, hRightMap, ← map_mul]
      congr 1
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul]
      dsimp [u₀]
      rw [hMkEqAwayMk hXα F hF, hMkEqAwayMk hXα (MvPolynomial.X α') hXα',
        hMkEqAwayMk hXα' F hF,
        HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, Localization.mk_mul]
      refine Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq ?_)
      simp [x]
      ring

    refine ⟨hCov, ⟨hProp, hAff⟩, hConst, hOverlap, ?_⟩
    intro Z ι α hXα U_Z hAffZ hUZ
    let D_α := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)
    let isoA := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) hXα zero_lt_one
    refine ⟨?_, ?_⟩
    · intro F hF dehom_F
      let m_F : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α) :=
        HomogeneousLocalization.mk ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩
      have hm_eq : m_F = HomogeneousLocalization.Away.isLocalizationElem hXα hF := by
        apply HomogeneousLocalization.val_injective
        change Localization.mk F
            (⟨MvPolynomial.X α, ⟨1, pow_one _⟩⟩ : Submonoid.powers (MvPolynomial.X α)) = _
        rw [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk]
        exact Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq (by simp))
      have hBasicP : (AlgebraicGeometry.Proj 𝒜_N).basicOpen (isoA.hom.hom m_F) =
          D_α ⊓ AlgebraicGeometry.Proj.basicOpen 𝒜_N F := by
        let isoS := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X α) hXα zero_lt_one
        let W₁ := (AlgebraicGeometry.Proj 𝒜_N).basicOpen (isoA.hom.hom m_F)
        let W₂ := D_α ⊓ AlgebraicGeometry.Proj.basicOpen 𝒜_N F
        have hW₁_le : W₁ ≤ D_α := (AlgebraicGeometry.Proj 𝒜_N).basicOpen_le _
        have hW₂_le : W₂ ≤ D_α := inf_le_left
        have hPreEq : (TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).base).obj W₁ =
            (TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).base).obj W₂ := by
          have hPre₁ : (TopologicalSpace.Opens.map
                (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).base).obj W₁ =
              PrimeSpectrum.basicOpen m_F := by
            rw [hAwayEq α hXα]
            change (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map isoA.inv).base).obj
                ((hAff α).fromSpec ⁻¹ᵁ (AlgebraicGeometry.Proj 𝒜_N).basicOpen (isoA.hom.hom m_F)) = _
            rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, (hAff α).basicOpen_fromSpec_app,
              AlgebraicGeometry.SpecMap_preimage_basicOpen]
            congr 1
            exact congrArg
              (fun f : CommRingCat.of (HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α)) ⟶
                  CommRingCat.of (HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α)) => f.hom m_F)
              isoA.hom_inv_id
          have hPre₂ : (TopologicalSpace.Opens.map
