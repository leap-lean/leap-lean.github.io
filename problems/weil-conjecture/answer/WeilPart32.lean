  have hComp_pts : ∀ l : Fin m_comp,
      (∃ (y : Γ₀.left) (hy₂ : y ∈ W₂) (hyF : y ∈ W_F),
        y ∈ K_comp l ∧
        u₁₂ ∈ (hAff_W₂.primeIdealOf ⟨y, hy₂⟩).asIdeal ∧
        S_Γ ∈ (hAff_WF.primeIdealOf ⟨y, hyF⟩).asIdeal) ∧
      (∃ (z₁ : Γ₀.left) (hz₁ : z₁ ∈ W₂),
        z₁ ∈ K_comp l ∧ u₁₂ ∉ (hAff_W₂.primeIdealOf ⟨z₁, hz₁⟩).asIdeal) ∧
      (∃ (z₂ : Γ₀.left) (hz₂F : z₂ ∈ W_F) (hz₂1 : z₂ ∈ W₁),
        z₂ ∈ K_comp l ∧
        S_Γ ∉ (hAff_WF.primeIdealOf ⟨z₂, hz₂F⟩).asIdeal ∧
        T_Γ ∉ (hAff_W₁.primeIdealOf ⟨z₂, hz₂1⟩).asIdeal) := by
    intro l
    have hSlice_ne :=
