      have h_ker_dim : Module.finrank F ↥(LinearMap.ker T_v) = N - d := by omega
      refine ⟨hd_le, ?_⟩
      let b_ker : Module.Basis (Fin (N - d)) F ↥(LinearMap.ker T_v) :=
        (Module.finBasis F ↥(LinearMap.ker T_v)).reindex (finCongr h_ker_dim)
