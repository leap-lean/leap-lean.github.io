    have hτ_right : τ_fwd.comp τ_inv = AlgHom.id k (MvPolynomial (Fin d) k) := by
      apply MvPolynomial.algHom_ext; intro i; simp [τ_fwd, τ_inv]
    have hτ_left : τ_inv.comp τ_fwd = AlgHom.id k (MvPolynomial (Fin d) k) := by
      apply MvPolynomial.algHom_ext; intro i; simp [τ_fwd, τ_inv]
