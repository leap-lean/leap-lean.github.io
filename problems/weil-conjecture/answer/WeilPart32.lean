            (TopologicalSpace.Opens.map p₁_P.base).obj (D₁ b)) :=
        fun b => hProd_aff Z_bar.hom P₁.hom V (D₁ b) (hAff_Vp p) (hAff_D₁ b)
      have hKer_W : ∀ b : Fin 2,
