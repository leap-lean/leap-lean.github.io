      AlgebraicGeometry.Scheme.IdealSheafData.mem_support_iff_of_mem
        (I := AlgebraicGeometry.Scheme.Hom.ker ι_Z_Q₁) (U := W_pb_aff) hjw_Wpb
    let ℓ_Z : Fin 2 → ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z)) := fun a =>
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_k (MvPolynomial.X α) (hXα_k α) zero_lt_one).hom ≫
        ι_bar.left.appLE (D_k α) V_Z le_rfl).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨F_pen a, hF_homog a⟩, ⟨MvPolynomial.X α, hXα_k α⟩, ⟨1, pow_one _⟩⟩)
    let t_b : Fin 2 → ↑(P₁.left.presheaf.obj (Opposite.op (D₁ b))) := fun a =>
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b) hTb zero_lt_one).hom ≫
        P₁.left.presheaf.map (CategoryTheory.homOfLE (le_rfl : D₁ b ≤ D₁ b)).op).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X a, MvPolynomial.isHomogeneous_X k a⟩,
            ⟨MvPolynomial.X b, hTb⟩, ⟨1, pow_one _⟩⟩)
    let Φ_pb : ↑(Q₁.presheaf.obj (Opposite.op W_pb)) :=
      ∑ a : Fin 2,
        (p₁_Z.appLE V_Z W_pb inf_le_left).hom (ℓ_Z a) *
        (p₁_P.appLE (D₁ b) W_pb inf_le_right).hom (t_b a)
    have h_ker_eq : (AlgebraicGeometry.Scheme.Hom.ker ι_Z_Q₁).ideal W_pb_aff =
        Ideal.span {Φ_pb} := by
      rw [AlgebraicGeometry.Scheme.Hom.ker_apply]
      exact hKer_ZQ₁ α (hXα_k α) hF_homog b hTb V_Z hAff_VZ le_rfl
        (D₁ b) hAff_D₁b le_rfl W_pb hAff_Wpb inf_le_left inf_le_right
    change j_s.base w ∈ ((AlgebraicGeometry.Scheme.Hom.ker ι_Z_Q₁).support : Set Q₁) ↔
      ι_WΩ.left.base w ∈ weilProjHyperplaneSet Ω M L_s
    rw [h_mem_ker, h_ker_eq, AlgebraicGeometry.Scheme.zeroLocus_span,
      AlgebraicGeometry.Scheme.zeroLocus_singleton, Set.mem_compl_iff]
    let ℓ_Ls : ↑(W_Ω.left.presheaf.obj (Opposite.op V_W)) :=
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_Ω (MvPolynomial.X α) (hXα_Ω α) zero_lt_one).hom ≫
        ι_WΩ.left.appLE (D_Ω α) V_W hVW_Ω).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨L_s, hLs_hom⟩, ⟨MvPolynomial.X α, hXα_Ω α⟩, ⟨1, pow_one _⟩⟩)
    have h_js_Φ : (j_s.appLE W_pb V_W hVW_pb).hom Φ_pb = ℓ_Ls := by
      dsimp [Φ_pb]
      rw [Fin.sum_univ_two, map_add, map_mul, map_mul]
      have h_Z_pull : ∀ a : Fin 2,
          (j_s.appLE W_pb V_W hVW_pb).hom ((p₁_Z.appLE V_Z W_pb inf_le_left).hom (ℓ_Z a)) =
          (q_Z.appLE V_Z V_W le_rfl).hom (ℓ_Z a) := by
        intro a
        have h_hom : p₁_Z.appLE V_Z W_pb inf_le_left ≫ j_s.appLE W_pb V_W hVW_pb =
            q_Z.appLE V_Z V_W le_rfl :=
          (Scheme.Hom.appLE_comp_appLE j_s p₁_Z V_Z W_pb V_W inf_le_left hVW_pb).trans
            (hCongrAppLE (CategoryTheory.Limits.pullback.lift_fst q_Z (W_Ω.hom ≫ s) hjs_comm)
              V_Z V_W _ le_rfl)
        exact ConcreteCategory.congr_hom h_hom (ℓ_Z a)
      let c_map : Ω →+* ↑(W_Ω.left.presheaf.obj (Opposite.op V_W)) :=
        ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ W_Ω.hom.appLE ⊤ V_W le_top).hom
      have h_P_pull : ∀ a : Fin 2,
          (j_s.appLE W_pb V_W hVW_pb).hom ((p₁_P.appLE (D₁ b) W_pb inf_le_right).hom (t_b a)) =
          c_map (c a) := by
        intro a
        have h_hom1 : p₁_P.appLE (D₁ b) W_pb inf_le_right ≫ j_s.appLE W_pb V_W hVW_pb =
            s.appLE (D₁ b) ⊤ h_top_s ≫ W_Ω.hom.appLE ⊤ V_W le_top :=
          (Scheme.Hom.appLE_comp_appLE j_s p₁_P (D₁ b) W_pb V_W inf_le_right hVW_pb).trans
            ((hCongrAppLE (CategoryTheory.Limits.pullback.lift_snd q_Z (W_Ω.hom ≫ s) hjs_comm)
              (D₁ b) V_W _ _).trans
              (Scheme.Hom.appLE_comp_appLE W_Ω.hom s (D₁ b) ⊤ V_W h_top_s
                (fun _ _ => trivial)).symm)
        have h_tb : t_b a =
            ((Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b) hTb zero_lt_one).hom).hom (m_1 a) := by
          have hid : P₁.left.presheaf.map (CategoryTheory.homOfLE (le_rfl : D₁ b ≤ D₁ b)).op = 𝟙 _ :=
            (hPresheafMapEq _ (𝟙 _)).trans (P₁.left.presheaf.map_id _)
          exact ConcreteCategory.congr_hom
            ((congrArg ((Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b) hTb zero_lt_one).hom ≫ ·) hid).trans
              (Category.comp_id _)) (m_1 a)
        have h_s_ca : (s.appLE (D₁ b) ⊤ h_top_s).hom (t_b a) =
            ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv).hom (c a) := by
          have h1 := congrArg (s.appLE (D₁ b) ⊤ h_top_s).hom h_tb
          refine h1.trans ?_
          exact (ConcreteCategory.congr_hom
            (Scheme.ΓSpecIso (CommRingCat.of Ω)).hom_inv_id
            ((s.appLE (D₁ b) ⊤ h_top_s).hom
              (((Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b) hTb zero_lt_one).hom).hom (m_1 a)))).symm
        have h_ap := ConcreteCategory.congr_hom h_hom1 (t_b a)
        exact h_ap.trans (congrArg (W_Ω.hom.appLE ⊤ V_W le_top).hom h_s_ca)
      obtain ⟨_, hLin_Ω⟩ := hBasicDict_K Ω W_Ω ι_WΩ α (hXα_Ω α) V_W hVW_Ω
      have h_lin := hLin_Ω (f_M (F_pen 0)) (f_M (F_pen 1))
        (f_M.map_mem (hF_homog 0)) (f_M.map_mem (hF_homog 1)) (c 0) (c 1) hLs_hom
      have hp0 := hPull_F (F_pen 0) (hF_homog 0) α hVW_Ω
      have hp1 := hPull_F (F_pen 1) (hF_homog 1) α hVW_Ω
      rw [h_Z_pull 0, h_Z_pull 1, h_P_pull 0, h_P_pull 1, mul_comm _ (c_map (c 0)),
        mul_comm _ (c_map (c 1)), ← hp0, ← hp1]
      exact h_lin.symm
    have h_bo_iff : j_s.base w ∈ Q₁.basicOpen Φ_pb ↔ w ∈ W_Ω.left.basicOpen ℓ_Ls := by
      have h_res : W_Ω.left.basicOpen ℓ_Ls =
          V_W ⊓ (TopologicalSpace.Opens.map j_s.base).obj (Q₁.basicOpen Φ_pb) := by
        rw [← h_js_Φ]
        change W_Ω.left.basicOpen
          ((W_Ω.left.presheaf.map (homOfLE hVW_pb).op).hom ((j_s.app W_pb).hom Φ_pb)) = _
        rw [Scheme.basicOpen_res, Scheme.Hom.preimage_basicOpen]
      rw [h_res]
      exact ⟨fun h => ⟨hw_VW, h⟩, fun h => h.2⟩
    obtain ⟨hDict_Ω, _⟩ := hBasicDict_K Ω W_Ω ι_WΩ α (hXα_Ω α) V_W hVW_Ω
    have h_iff_pos : j_s.base w ∈ (Q₁.basicOpen Φ_pb : Set Q₁) ↔
        ι_WΩ.left.base w ∉ weilProjHyperplaneSet Ω M L_s :=
      h_bo_iff.trans (hDict_Ω L_s hLs_hom w hw_VW)
    exact ⟨fun h => Classical.not_not.mp (mt h_iff_pos.mpr h),
      fun h hmem => (h_iff_pos.mp hmem) h⟩

  exact ⟨W_Ω, hProp_WΩ, hSm_WΩ, ι_WΩ, L_s, ι_fib,
    hInt_WΩ, hCl_WΩ, hLs_hom, hLs_ne, hNondeg_W, hCl_fib, hRange_fib⟩

theorem weil_algClosed_pencil_blowup_and_fiber_pullback (k : Type u) [Field k] [IsAlgClosed k]
    (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hM : 3 ≤ M)
    (hCl_ι : AlgebraicGeometry.IsClosedImmersion ι_bar.left)
    (hNondeg : ∀ L_form : MvPolynomial (Fin (M + 1)) k,
      L_form ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1 → L_form ≠ 0 →
      ∃ z : Z_bar.left, ι_bar.left.base z ∉ weilProjHyperplaneSet k M L_form)
    (L : Fin 3 → MvPolynomial (Fin (M + 1)) k)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      (weilProjectiveSpaceOver k 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
      (weilProjectiveSpaceOver k 1).left)
    (ι_line : weilProjectiveSpaceOver k 1 ⟶ weilProjectiveSpaceOver k 2)
    (u_val : k)
    (hCoord_line : IsStandardProjLineCoord k j_aff s_inf)
    (hLine_plane : IsStandardProjLineInPlane k ι_line)
    (hL_homog : ∀ r : Fin 3, L r ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
    (hL_linIndep : ∀ c : Fin 3 → k, c ≠ 0 → (∑ r : Fin 3, MvPolynomial.C (c r) * L r) ≠ 0)
    (hTrans_axis : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m) 2 ![L 0, L 1])
    (hTrans_u₀ : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m + 1) 1
      ![L 0 + MvPolynomial.C u_val * L 1])
    (B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper B₀.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) B₀.hom]
    (hProj_B₀ : IsProjectiveOverField k B₀)
    (ι_B : B₀ ⟶ Z_bar)
    (hCl_B : AlgebraicGeometry.IsClosedImmersion ι_B.left)
    (hRange_B₀ : Set.range ι_B.left.base =
      { z : Z_bar.left |
        ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 0) ∧
        ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 1) })
    (U_axis : Z_bar.left.Opens)
    (hU_axis_eq : (U_axis : Set Z_bar.left) = (Set.range ι_B.left.base)ᶜ)
    (hU_axis_ne : Nonempty U_axis)
    (Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π_Y : Y₂ ⟶ Z_bar)
    (g₂ : Y₂ ⟶ weilProjectiveSpaceOver k 2)
    (hNet_inc : IsLinearNetIncidenceFamily k M Z_bar ι_bar L Y₂ π_Y g₂)
    (hProj_Y₂ : IsProjectiveOverField k Y₂)
    (hFlat_g₂ : AlgebraicGeometry.Flat g₂.left)
    (hProp_g₂ : AlgebraicGeometry.IsProper g₂.left) :
    ∃ (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π₀ : Z_tilde ⟶ Z_bar)
      (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver k 1)
      (ι_Ytilde : Z_tilde ⟶ Y₂)
      (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (ι_Zu₀ : Z_u₀.left ⟶ Z_tilde.left)
      (ι_Zu₀_M : Z_u₀ ⟶ weilProjectiveSpaceOver k M),
      CategoryTheory.IsPullback ι_Ytilde.left f₀.left g₂.left ι_line.left ∧
      ι_Ytilde ≫ π_Y = π₀ ∧
      AlgebraicGeometry.IsIntegral Z_tilde.left ∧
      AlgebraicGeometry.IsProper Z_tilde.hom ∧
      AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom ∧
      IsProjectiveOverField k Z_tilde ∧
      AlgebraicGeometry.IsProper π₀.left ∧
      AlgebraicGeometry.Surjective π₀.left ∧
      CategoryTheory.IsIso (π₀.left ∣_ U_axis) ∧
      AlgebraicGeometry.Flat f₀.left ∧
      AlgebraicGeometry.IsProper f₀.left ∧
      AlgebraicGeometry.Surjective f₀.left ∧
      CategoryTheory.IsPullback ι_Zu₀ Z_u₀.hom f₀.left
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom u_val)) ≫ j_aff) ∧
      AlgebraicGeometry.IsProper Z_u₀.hom ∧
      AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_u₀.hom ∧
      IsProjectiveOverField k Z_u₀ ∧
      AlgebraicGeometry.IsClosedImmersion ι_Zu₀_M.left ∧
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            (weilProjectiveSpaceOver k 1).left),
        ∃ (W_Ω : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
          (_ : AlgebraicGeometry.IsProper W_Ω.hom)
          (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) W_Ω.hom)
          (ι_WΩ : W_Ω ⟶ weilProjectiveSpaceOver Ω M)
          (L_s : MvPolynomial (Fin (M + 1)) Ω)
          (ι_fib : CategoryTheory.Limits.pullback f₀.left s ⟶ W_Ω.left),
          AlgebraicGeometry.IsIntegral W_Ω.left ∧
          AlgebraicGeometry.IsClosedImmersion ι_WΩ.left ∧
          L_s ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω 1 ∧
          L_s ≠ 0 ∧
          (∃ w : W_Ω.left, ι_WΩ.left.base w ∉ weilProjHyperplaneSet Ω M L_s) ∧
          AlgebraicGeometry.IsClosedImmersion ι_fib ∧
          Set.range ι_fib.base =
            { w : W_Ω.left | ι_WΩ.left.base w ∈ weilProjHyperplaneSet Ω M L_s }) :=
by
  let P₁ := weilProjectiveSpaceOver k 1
  let ι_Ytilde_sch := CategoryTheory.Limits.pullback.fst g₂.left ι_line.left
  let f₀_sch := CategoryTheory.Limits.pullback.snd g₂.left ι_line.left
  let Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (f₀_sch ≫ P₁.hom)
  let f₀ : Z_tilde ⟶ P₁ := CategoryTheory.Over.homMk f₀_sch rfl
  have h_w_Ytilde : ι_Ytilde_sch ≫ Y₂.hom = Z_tilde.hom := by
    change ι_Ytilde_sch ≫ Y₂.hom = f₀_sch ≫ P₁.hom
    rw [← CategoryTheory.Over.w g₂, ← CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
      CategoryTheory.Over.w ι_line]
  let ι_Ytilde : Z_tilde ⟶ Y₂ := CategoryTheory.Over.homMk ι_Ytilde_sch h_w_Ytilde
  let π₀ : Z_tilde ⟶ Z_bar := ι_Ytilde ≫ π_Y

  have hPb_line : CategoryTheory.IsPullback ι_Ytilde.left f₀.left g₂.left ι_line.left :=
    CategoryTheory.IsPullback.of_hasPullback g₂.left ι_line.left

  have hFlat_f₀ : AlgebraicGeometry.Flat f₀.left :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_line hFlat_g₂
  have hProp_f₀ : AlgebraicGeometry.IsProper f₀.left :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_line hProp_g₂
  have hCl_Ytilde : AlgebraicGeometry.IsClosedImmersion ι_Ytilde.left :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_line.flip hLine_plane.1

  have hProj_Ztilde : IsProjectiveOverField k Z_tilde := by
    rcases hProj_Y₂ with ⟨N_Y, ι_NY, hCl_NY⟩
    refine ⟨N_Y, ι_Ytilde ≫ ι_NY, ?_⟩
    have : AlgebraicGeometry.IsClosedImmersion ι_Ytilde.left := hCl_Ytilde
    have : AlgebraicGeometry.IsClosedImmersion ι_NY.left := hCl_NY
    change AlgebraicGeometry.IsClosedImmersion (ι_Ytilde.left ≫ ι_NY.left)
    infer_instance

  have hProp_P₁ : AlgebraicGeometry.IsProper P₁.hom := by
    dsimp [P₁, weilProjectiveSpaceOver]
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k) :=
      MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k 0)
        (MvPolynomial (Fin (1 + 1)) k) :=
      ⟨fun x y z => smul_mul_assoc x y.1 z⟩
    have : Algebra.FiniteType ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k 0)
        (MvPolynomial (Fin (1 + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k
        ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k 0) (MvPolynomial (Fin (1 + 1)) k)
    have hBij : Function.Bijective
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k 0)) := by
      refine ⟨?_, ?_⟩
      · intro c₁ c₂ hc
        have hc' : (algebraMap k (MvPolynomial (Fin (1 + 1)) k) c₁) =
            algebraMap k (MvPolynomial (Fin (1 + 1)) k) c₂ := congrArg Subtype.val hc
        exact (RingHom.injective (MvPolynomial.C : k →+* MvPolynomial (Fin (1 + 1)) k)) hc'
      · rintro ⟨p, hp⟩
        rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hp
        rcases hp with ⟨c, hc⟩
        exact ⟨c, Subtype.ext hc⟩
    have : CategoryTheory.IsIso
        (CommRingCat.ofHom (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k 0))) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective
        (CommRingCat.ofHom (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k 0)))).mpr
        hBij
    have : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k 0)))) :=
      inferInstance
    infer_instance

  have hProp_Ztilde : AlgebraicGeometry.IsProper Z_tilde.hom := by
    have : AlgebraicGeometry.IsProper f₀.left := hProp_f₀
    have : AlgebraicGeometry.IsProper P₁.hom := hProp_P₁
    change AlgebraicGeometry.IsProper (f₀.left ≫ P₁.hom)
    infer_instance

  have hProp_π₀ : AlgebraicGeometry.IsProper π₀.left := by
    have : AlgebraicGeometry.IsProper Z_tilde.hom := hProp_Ztilde
    have hcomp : AlgebraicGeometry.IsProper (π₀.left ≫ Z_bar.hom) := by
      rwa [CategoryTheory.Over.w π₀]
    exact AlgebraicGeometry.IsProper.of_comp π₀.left Z_bar.hom

  let u₀_sec : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P₁.left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom u_val)) ≫ j_aff
  let Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f₀.left u₀_sec)
  let ι_Zu₀ : Z_u₀.left ⟶ Z_tilde.left :=
    CategoryTheory.Limits.pullback.fst f₀.left u₀_sec

  have hPb_Zu₀ : CategoryTheory.IsPullback ι_Zu₀ Z_u₀.hom f₀.left u₀_sec :=
    CategoryTheory.IsPullback.of_hasPullback f₀.left u₀_sec
  have hProp_Zu₀ : AlgebraicGeometry.IsProper Z_u₀.hom := by
    have : AlgebraicGeometry.IsProper f₀.left := hProp_f₀
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Zu₀ hProp_f₀

  have hU_axis_set : (U_axis : Set Z_bar.left) =
      ({ z : Z_bar.left |
        ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 0) ∧
        ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 1) })ᶜ := by
    rw [hU_axis_eq, hRange_B₀]

  obtain ⟨hcomm_Z, hCl_ZQ₁, hKer_ZQ₁, hIso_π₀, h_w_Zu₀, hCl_Zu₀_Z, hRange_Zu₀_Z, hKer_Zu₀_Z⟩ :=
    weil_pencil_line_pullback_local_eq_and_open_iso k M Z_bar ι_bar hCl_ι L hL_homog
      j_aff s_inf ι_line u_val hCoord_line hLine_plane U_axis hU_axis_set Y₂ π_Y g₂ hNet_inc

  let ι_Zu₀_Zbar : Z_u₀ ⟶ Z_bar := CategoryTheory.Over.homMk (ι_Zu₀ ≫ π₀.left) h_w_Zu₀
  let ι_Zu₀_M : Z_u₀ ⟶ weilProjectiveSpaceOver k M := ι_Zu₀_Zbar ≫ ι_bar
  have hCl_Zu₀_M : AlgebraicGeometry.IsClosedImmersion ι_Zu₀_M.left := by
    have : AlgebraicGeometry.IsClosedImmersion (ι_Zu₀ ≫ π₀.left) := hCl_Zu₀_Z
    have : AlgebraicGeometry.IsClosedImmersion ι_bar.left := hCl_ι
    change AlgebraicGeometry.IsClosedImmersion ((ι_Zu₀ ≫ π₀.left) ≫ ι_bar.left)
    infer_instance
  have hProj_Zu₀ : IsProjectiveOverField k Z_u₀ := ⟨M, ι_Zu₀_M, hCl_Zu₀_M⟩

  have hSurj_π₀ : AlgebraicGeometry.Surjective π₀.left := by
    refine ⟨fun z => ?_⟩
    have : CategoryTheory.IsIso (π₀.left ∣_ U_axis) := hIso_π₀
    have : AlgebraicGeometry.IsProper π₀.left := hProp_π₀
    have : AlgebraicGeometry.IsIntegral Z_bar.left := hInt
    have hSub_range : (U_axis : Set Z_bar.left) ⊆ Set.range π₀.left.base := by
      intro x hx
      let u_pt : ↥U_axis.toScheme := ⟨x, hx⟩
      let w_pt := (CategoryTheory.inv (π₀.left ∣_ U_axis)).base u_pt
      refine ⟨(π₀.left ⁻¹ᵁ U_axis).ι.base w_pt, ?_⟩
      change ((CategoryTheory.inv (π₀.left ∣_ U_axis) ≫ (π₀.left ⁻¹ᵁ U_axis).ι) ≫ π₀.left).base u_pt = x
      rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι,
        ← CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
        CategoryTheory.Category.id_comp]
      rfl
    have hDense_U : Dense (U_axis : Set Z_bar.left) :=
      U_axis.2.dense ⟨hU_axis_ne.some.1, hU_axis_ne.some.2⟩
    have hClosed_range : IsClosed (Set.range π₀.left.base) :=
      π₀.left.isClosedMap.isClosed_range
    have hz_cl : z ∈ closure (Set.range π₀.left.base) :=
      closure_mono hSub_range (hDense_U z)
    rwa [hClosed_range.closure_eq] at hz_cl

  have hSmPkg := weil_pencil_blowup_and_slice_transversal_smooth k M (2 * m) Z_bar ι_bar hCl_ι
  have hSm_Ztilde : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom :=
    hSmPkg.1 ![L 0, L 1] hTrans_axis U_axis hU_axis_set Z_tilde.left
      (CategoryTheory.Limits.pullback.lift π₀.left f₀.left hcomm_Z) π₀.left Z_tilde.hom
      hCl_ZQ₁ (CategoryTheory.Limits.pullback.lift_fst _ _ _) (CategoryTheory.Over.w π₀)
      hIso_π₀ hKer_ZQ₁

  have hLu₀_homog : L 0 + MvPolynomial.C u_val * L 1 ∈
      MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1 := by
    have hC : MvPolynomial.C u_val ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 0 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_C _ _
    have hMul : MvPolynomial.C u_val * L 1 ∈
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k (0 + 1) :=
      SetLike.GradedMul.mul_mem hC (hL_homog 1)
    rw [Nat.zero_add] at hMul
    exact Submodule.add_mem _ (hL_homog 0) hMul

  have hSm_Zu₀ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_u₀.hom :=
    hSmPkg.2 (2 * m + 1) (L 0 + MvPolynomial.C u_val * L 1) hLu₀_homog hTrans_u₀
      Z_u₀.left (ι_Zu₀ ≫ π₀.left) Z_u₀.hom hCl_Zu₀_Z h_w_Zu₀ hRange_Zu₀_Z
      (fun α hXα U_Z hAffUZ hUZ => hKer_Zu₀_Z α hXα hLu₀_homog U_Z hAffUZ hUZ)

  have hInt_Ztilde : AlgebraicGeometry.IsIntegral Z_tilde.left := by
    have : AlgebraicGeometry.IsProper Z_tilde.hom := hProp_Ztilde
    have : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom := hSm_Ztilde
    exact weil_algClosed_smooth_blowup_isIntegral_of_codim_two_center k (2 * m) Z_bar hInt
      B₀ ι_B hCl_B U_axis hU_axis_eq hU_axis_ne Z_tilde π₀ f₀ hCl_ZQ₁ hIso_π₀

  have hNonempty_Z : Nonempty Z_bar.left := ⟨hU_axis_ne.some.1⟩
  have hF_homog : ∀ a : Fin 2, ![L 0, L 1] a ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1 := by
    intro a
    fin_cases a <;> simpa using hL_homog _
  have hF_linIndep : ∀ c : Fin 2 → k, c ≠ 0 →
      MvPolynomial.C (c 0) * (![L 0, L 1] : Fin 2 → MvPolynomial (Fin (M + 1)) k) 0 +
        MvPolynomial.C (c 1) * (![L 0, L 1] : Fin 2 → MvPolynomial (Fin (M + 1)) k) 1 ≠ 0 := by
    intro c hc
    let c₃ : Fin 3 → k := ![c 0, c 1, 0]
    have hc₃ : c₃ ≠ 0 := by
      intro h0
      apply hc
      ext a
      fin_cases a
      · exact congrFun h0 0
      · exact congrFun h0 1
    have hSum : (∑ r : Fin 3, MvPolynomial.C (c₃ r) * L r) =
        MvPolynomial.C (c 0) * L 0 + MvPolynomial.C (c 1) * L 1 := by
      simp [Fin.sum_univ_three, c₃]
    simpa [← hSum] using hL_linIndep c₃ hc₃

  have hFib_id : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ P₁.left),
      ∃ (W_Ω : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        (_ : AlgebraicGeometry.IsProper W_Ω.hom)
        (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) W_Ω.hom)
        (ι_WΩ : W_Ω ⟶ weilProjectiveSpaceOver Ω M)
        (L_s : MvPolynomial (Fin (M + 1)) Ω)
        (ι_fib : CategoryTheory.Limits.pullback f₀.left s ⟶ W_Ω.left),
        AlgebraicGeometry.IsIntegral W_Ω.left ∧
        AlgebraicGeometry.IsClosedImmersion ι_WΩ.left ∧
        L_s ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω 1 ∧
        L_s ≠ 0 ∧
        (∃ w : W_Ω.left, ι_WΩ.left.base w ∉ weilProjHyperplaneSet Ω M L_s) ∧
        AlgebraicGeometry.IsClosedImmersion ι_fib ∧
        Set.range ι_fib.base =
          { w : W_Ω.left | ι_WΩ.left.base w ∈ weilProjHyperplaneSet Ω M L_s } :=
    fun Ω _ _ s =>
      weil_algClosed_pencil_geom_fiber_hyperplane_section k (2 * m + 2) M Z_bar hInt
        hNonempty_Z ι_bar hCl_ι hNondeg ![L 0, L 1] hF_homog hF_linIndep
        Z_tilde.left (CategoryTheory.Limits.pullback.lift π₀.left f₀.left hcomm_Z) f₀.left
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) hCl_ZQ₁ hKer_ZQ₁ Ω s

  have hSurj_f₀ : AlgebraicGeometry.Surjective f₀.left := by
    refine ⟨fun p => ?_⟩
    let κ : Type u := ↑(P₁.left.residueField p)
    let Ω : Type u := AlgebraicClosure κ
    let s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ P₁.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ Ω)) ≫
        P₁.left.fromSpecResidueField p
    obtain ⟨W_Ω, hProp_WΩ, hSm_WΩ, ι_WΩ, L_s, ι_fib,
        hInt_WΩ, hCl_WΩ, hLs_hom, hLs_ne, _, _, hRange_fib⟩ := hFib_id Ω s
    have : AlgebraicGeometry.IsProper W_Ω.hom := hProp_WΩ
    have : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) W_Ω.hom := hSm_WΩ
    have : AlgebraicGeometry.IsClosedImmersion ι_WΩ.left := hCl_WΩ
    have hDim_W : topologicalKrullDim W_Ω.left = ((2 * m + 2 : ℕ) : WithBot ℕ∞) :=
      weil_smooth_integral_krullDim_over_field Ω (2 * m + 2) W_Ω hInt_WΩ
    have hClEmb_W : Topology.IsClosedEmbedding ι_WΩ.left.base :=
      ι_WΩ.left.isClosedEmbedding
    let Y_Ω : Set (weilProjectiveSpaceOver Ω M).left := Set.range ι_WΩ.left.base
    have hDim_Y : topologicalKrullDim ↥Y_Ω = ((2 * m + 2 : ℕ) : WithBot ℕ∞) :=
      (hClEmb_W.isEmbedding.toHomeomorph.isHomeomorph.topologicalKrullDim_eq).symm.trans hDim_W
    have hDim_ge : ((1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥Y_Ω := by
      rw [hDim_Y]
      exact WithBot.coe_le_coe.mpr (Nat.cast_le.mpr (by omega))
    obtain ⟨⟨y_pt, ⟨⟨w, rfl⟩, hw_hyp⟩⟩, -⟩ :=
      (weil_algClosed_proj_hyperplane_krullDim_bounds_and_ratPoint Ω M).1
        Y_Ω hClEmb_W.isClosed_range 1 (le_refl 1) hDim_ge L_s hLs_hom hLs_ne
    have hw_fib : w ∈ Set.range ι_fib.base := by
      rw [hRange_fib]
      exact hw_hyp
    rcases hw_fib with ⟨q, rfl⟩
    refine ⟨(CategoryTheory.Limits.pullback.fst f₀.left s).base q, ?_⟩
    have hcond : (CategoryTheory.Limits.pullback.fst f₀.left s ≫ f₀.left).base q =
        (CategoryTheory.Limits.pullback.snd f₀.left s ≫ s).base q := by
      rw [CategoryTheory.Limits.pullback.condition]
    change (CategoryTheory.Limits.pullback.fst f₀.left s ≫ f₀.left).base q = p
    rw [hcond]
    exact P₁.left.fromSpecResidueField_apply p _

  exact ⟨Z_tilde, π₀, f₀, ι_Ytilde, Z_u₀, ι_Zu₀, ι_Zu₀_M,
    hPb_line, rfl, hInt_Ztilde, hProp_Ztilde, hSm_Ztilde, hProj_Ztilde,
    hProp_π₀, hSurj_π₀, hIso_π₀, hFlat_f₀, hProp_f₀, hSurj_f₀,
    hPb_Zu₀, hProp_Zu₀, hSm_Zu₀, hProj_Zu₀, hCl_Zu₀_M, hFib_id⟩

