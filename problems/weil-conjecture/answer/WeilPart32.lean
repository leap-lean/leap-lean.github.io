        (π.appLE (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin 3) k) (MvPolynomial.X 2)) U₂ hW_eq.ge).hom
          ((AlgebraicGeometry.Proj.awayToSection
            (MvPolynomial.homogeneousSubmodule (Fin 3) k) (MvPolynomial.X 2)).hom
            (HomogeneousLocalization.Away.mk
              (MvPolynomial.homogeneousSubmodule (Fin 3) k) hY2 1
              (MvPolynomial.X ((![0, 1] : Fin 2 → Fin 3) i))
              (MvPolynomial.isHomogeneous_X k ((![0, 1] : Fin 2 → Fin 3) i))))) = ![u₀, u₁] := by
      ext i
      fin_cases i
      · exact hsec0
      · exact hsec1
    rw [hw_eq] at hFin_w
    exact hFin_w
  · 
    intro Y _ W₀ W_inf hAff₀ hAff_inf hCov T S hBasicT hBasicS hInv φ_0 φ_inf
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
      MvPolynomial.gradedAlgebra
    obtain ⟨g, hg_hom, ⟨hg_1, hg_0⟩, hg_sec⟩ :=
      hs3 Y W₀ W_inf hAff₀ hAff_inf hCov T S hBasicT hBasicS hInv
    have hPreAff_g : ∀ b : Fin 2,
        AlgebraicGeometry.IsAffineOpen
          ((TopologicalSpace.Opens.map g.base).obj
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin 2) k) (MvPolynomial.X b))) := by
      intro b
      rcases Fin.exists_fin_two.mp ⟨b, rfl⟩ with rfl | rfl
      · exact hg_0.symm ▸ hAff_inf
      · exact hg_1.symm ▸ hAff₀
    have hX1 : (MvPolynomial.X 1 : MvPolynomial (Fin 2) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) k 1 :=
      MvPolynomial.isHomogeneous_X k 1
    have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) k 1 :=
      MvPolynomial.isHomogeneous_X k 0
    obtain ⟨hsecT, hsecS⟩ := hg_sec hX1 hX0 hg_1.ge hg_0.ge
    refine ⟨?_, ?_, hs4 Y W₀ W_inf hAff₀ hAff_inf T S hBasicT hBasicS hInv⟩
    · 
      let _ : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W₀)) := φ_0.toAlgebra
      have hι0_cov : ∀ b : Fin 2, b = 1 ∨ ∃ i : Fin 1, (![0] : Fin 1 → Fin 2) i = b := by
        intro b
        fin_cases b
        · exact Or.inr ⟨0, rfl⟩
        · exact Or.inl rfl
      have hFin0 := (hs1 1 Y g hg_hom hPreAff_g).2 1 hX1 W₀ hg_1 hg_1.ge ![0] hι0_cov
      have hw0_eq : (fun i : Fin 1 =>
          (g.appLE (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin 2) k) (MvPolynomial.X 1)) W₀ hg_1.ge).hom
            ((AlgebraicGeometry.Proj.awayToSection
              (MvPolynomial.homogeneousSubmodule (Fin 2) k) (MvPolynomial.X 1)).hom
              (HomogeneousLocalization.Away.mk
                (MvPolynomial.homogeneousSubmodule (Fin 2) k) hX1 1
                (MvPolynomial.X ((![0] : Fin 1 → Fin 2) i))
                (MvPolynomial.isHomogeneous_X k ((![0] : Fin 1 → Fin 2) i))))) = ![T] := by
        ext i
        fin_cases i
        exact hsecT
      rw [hw0_eq] at hFin0
      have haeval0 : (MvPolynomial.eval₂Hom φ_0 ![T]).comp θ₁ =
          (Polynomial.aeval (R := k) T).toRingHom := by
        apply Polynomial.ringHom_ext'
        · ext c
          simp [θ₁]
          rfl
        · simp [θ₁]
      have hFin_aeval0 : ((Polynomial.aeval (R := k) T).toRingHom).Finite := by
        rw [← haeval0]
        exact RingHom.Finite.comp hFin0 hθ₁_fin
      exact hFin_aeval0
    · 
      let _ : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W_inf)) := φ_inf.toAlgebra
      have hι1_cov : ∀ b : Fin 2, b = 0 ∨ ∃ i : Fin 1, (![1] : Fin 1 → Fin 2) i = b := by
        intro b
        fin_cases b
        · exact Or.inl rfl
        · exact Or.inr ⟨0, rfl⟩
      have hFin_inf := (hs1 1 Y g hg_hom hPreAff_g).2 0 hX0 W_inf hg_0 hg_0.ge ![1] hι1_cov
      have hw_inf_eq : (fun i : Fin 1 =>
          (g.appLE (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin 2) k) (MvPolynomial.X 0)) W_inf hg_0.ge).hom
            ((AlgebraicGeometry.Proj.awayToSection
              (MvPolynomial.homogeneousSubmodule (Fin 2) k) (MvPolynomial.X 0)).hom
              (HomogeneousLocalization.Away.mk
                (MvPolynomial.homogeneousSubmodule (Fin 2) k) hX0 1
                (MvPolynomial.X ((![1] : Fin 1 → Fin 2) i))
                (MvPolynomial.isHomogeneous_X k ((![1] : Fin 1 → Fin 2) i))))) = ![S] := by
        ext i
        fin_cases i
        exact hsecS
      rw [hw_inf_eq] at hFin_inf
      have haeval_inf : (MvPolynomial.eval₂Hom φ_inf ![S]).comp θ₁ =
          (Polynomial.aeval (R := k) S).toRingHom := by
        apply Polynomial.ringHom_ext'
        · ext c
          simp [θ₁]
          rfl
        · simp [θ₁]
      have hFin_aeval_inf : ((Polynomial.aeval (R := k) S).toRingHom).Finite := by
        rw [← haeval_inf]
        exact RingHom.Finite.comp hFin_inf hθ₁_fin
      exact hFin_aeval_inf

theorem weil_algClosed_smooth_curve_components_and_torsionFree_quotient (k : Type u) [Field k] [IsAlgClosed k] :
    ((∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
        AlgebraicGeometry.IsIntegral Y.left →
        ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 Y.hom],
        topologicalKrullDim Y.left = ((1 : ℕ) : WithBot ℕ∞)) →
      ∀ (N : ℕ)
        (Γ₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 Γ₀.hom]
        (ι_ΓP : Γ₀ ⟶ weilProjectiveSpaceOver k N),
      AlgebraicGeometry.IsClosedImmersion ι_ΓP.left →
      ∃ (m_comp : ℕ) (K_comp : Fin m_comp → Set Γ₀.left),
        ((∀ l : Fin m_comp,
            IsClosed (K_comp l) ∧
            IsOpen (K_comp l) ∧
            IsIrreducible (K_comp l) ∧
            topologicalKrullDim ↥(K_comp l) = ((1 : ℕ) : WithBot ℕ∞)) ∧
          (⋃ l : Fin m_comp, K_comp l) = Set.univ) ∧
        (∀ (W : Γ₀.left.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W)
            (t : ↑(Γ₀.left.presheaf.obj (Opposite.op W))),
          let φ_W : k →+* ↑(Γ₀.left.presheaf.obj (Opposite.op W)) :=
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              Γ₀.hom.appLE ⊤ W le_top).hom
          ((∀ l : Fin m_comp, (W.1 ∩ K_comp l).Nonempty →
              ∃ (z : Γ₀.left) (hz : z ∈ W),
                z ∈ K_comp l ∧ t ∉ (hAffW.primeIdealOf ⟨z, hz⟩).asIdeal) →
            t ∈ nonZeroDivisors ↑(Γ₀.left.presheaf.obj (Opposite.op W))) ∧
          ((∀ l : Fin m_comp, (W.1 ∩ K_comp l).Nonempty →
              (∃ (y : Γ₀.left) (hy : y ∈ W),
                y ∈ K_comp l ∧ t ∈ (hAffW.primeIdealOf ⟨y, hy⟩).asIdeal) ∧
              (∃ (z : Γ₀.left) (hz : z ∈ W),
                z ∈ K_comp l ∧ t ∉ (hAffW.primeIdealOf ⟨z, hz⟩).asIdeal)) →
            letI : Algebra k ↑(Γ₀.left.presheaf.obj (Opposite.op W)) := φ_W.toAlgebra
            letI : Algebra (Polynomial k) ↑(Γ₀.left.presheaf.obj (Opposite.op W)) :=
              (Polynomial.aeval t).toRingHom.toAlgebra
            Module.IsTorsionFree (Polynomial k) ↑(Γ₀.left.presheaf.obj (Opposite.op W))))) ∧
    (∀ (B₀ B_inf : Type u) [CommRing B₀] [CommRing B_inf] [Algebra k B₀] [Algebra k B_inf]
        (T : B₀) (S : B_inf),
      T ∈ nonZeroDivisors B₀ →
      (letI : Algebra (Polynomial k) B_inf := (Polynomial.aeval S).toRingHom.toAlgebra
       Module.IsTorsionFree (Polynomial k) B_inf) →
      (∃ e : Localization.Away T ≃ₐ[k] Localization.Away S,
        e (algebraMap B₀ (Localization.Away T) T) *
          algebraMap B_inf (Localization.Away S) S = 1) →
      (letI : Algebra (Polynomial k) B₀ := (Polynomial.aeval T).toRingHom.toAlgebra
       Module.IsTorsionFree (Polynomial k) B₀)) ∧
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (W_A W_B : Y.left.Opens),
      AlgebraicGeometry.IsAffineOpen W_A →
      AlgebraicGeometry.IsAffineOpen W_B →
      ∀ (a s_A : ↑(Y.left.presheaf.obj (Opposite.op W_A)))
        (b s_B : ↑(Y.left.presheaf.obj (Opposite.op W_B))),
      Y.left.basicOpen s_A = W_A ⊓ W_B →
      Y.left.basicOpen s_B = W_A ⊓ W_B →
      W_A ≤ Y.left.basicOpen a ⊔ W_B →
      W_B ≤ Y.left.basicOpen b ⊔ W_A →
      Ideal.span {(Y.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_A ⊓ W_B ≤ W_A)).op).hom a} =
        Ideal.span {(Y.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W_A ⊓ W_B ≤ W_B)).op).hom b} →
      let φ_A : k →+* ↑(Y.left.presheaf.obj (Opposite.op W_A)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Y.hom.appLE ⊤ W_A le_top).hom
      let φ_B : k →+* ↑(Y.left.presheaf.obj (Opposite.op W_B)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Y.hom.appLE ⊤ W_B le_top).hom
      (letI : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W_A)) := φ_A.toAlgebra
       letI : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W_B)) := φ_B.toAlgebra
       Nonempty ((↑(Y.left.presheaf.obj (Opposite.op W_A)) ⧸ Ideal.span {a}) ≃ₗ[k]
         (↑(Y.left.presheaf.obj (Opposite.op W_B)) ⧸ Ideal.span {b})))) ∧
    (∀ (A : Type u) [CommRing A] [Algebra k A] [Algebra.FiniteType k A]
        (p : Ideal A) [p.IsMaximal] (u : A),
      ∃ t₀ : k, u - algebraMap k A t₀ ∈ p) :=
by
  classical
  refine ⟨?_, ?_, ?_, ?_⟩
  · 
    intro hDim1 N Γ₀ _ ι_ΓP hCl
    have hNoeth_k : IsNoetherianRing k :=
      (isNoetherianRing_iff_ideal_fg k).mpr fun I => by
        rcases Ideal.eq_bot_or_top I with rfl | rfl
        · exact Submodule.fg_bot
        · exact ⟨{1}, by simp⟩
    
    have hEtalePolyAwayDomain :
        ∀ (C : Type u) [CommRing C] [Algebra (Polynomial k) C] [Algebra.Etale (Polynomial k) C]
          (q : Ideal C) [q.IsPrime],
          ∃ f : C, f ∉ q ∧ IsDomain (Localization.Away f) := by
      intro C _ _ _ q _
      let B := Polynomial k
      have : Module.Flat B C := inferInstance
      have hFlatTF : ∀ {b : B} {c : C}, b ≠ 0 → b • c = 0 → c = 0 := by
        intro b c hb hbc
        let μ_b : B →ₗ[B] B := LinearMap.lsmul B B b
        have hμ_inj : Function.Injective μ_b := fun x y hxy => by
          have hmul : b * x = b * y := hxy
          exact mul_left_cancel₀ hb hmul
        have hlT_inj := Module.Flat.lTensor_preserves_injective_linearMap (M := C) μ_b hμ_inj
        have hzero : LinearMap.lTensor C μ_b (c ⊗ₜ[B] (1 : B)) = 0 := by
          apply (TensorProduct.rid B C).injective
          rw [LinearMap.lTensor_tmul, map_zero]
          change (b * 1) • c = 0
          rwa [mul_one]
        have htmul : c ⊗ₜ[B] (1 : B) = 0 :=
          hlT_inj (hzero.trans (LinearMap.map_zero _).symm)
        have hc := congrArg (TensorProduct.rid B C) htmul
        simpa using hc
      have hQuadDivDeg :
          ∀ (n : ℕ) (b₀ : B), b₀.natDegree = n → b₀ ≠ 0 →
            ∀ (c₀ : C), c₀ * c₀ = b₀ • c₀ → ∃ d : C, c₀ = b₀ • d := by
        intro n
        induction n with
        | zero =>
          intro b₀ hdeg hb₀ c₀ _
          let a₀ : k := b₀.coeff 0
          have hb_eq : b₀ = Polynomial.C a₀ :=
            Polynomial.eq_C_of_natDegree_eq_zero hdeg
          have ha0 : a₀ ≠ 0 := by
            intro h0
            apply hb₀
            rw [hb_eq, h0, map_zero]
          have hmul_one : b₀ * Polynomial.C a₀⁻¹ = 1 := by
            rw [hb_eq, ← Polynomial.C_mul, mul_inv_cancel₀ ha0, Polynomial.C_1]
          refine ⟨Polynomial.C a₀⁻¹ • c₀, ?_⟩
          rw [← mul_smul, hmul_one, one_smul]
        | succ m ih =>
          intro b₀ hdeg hb₀ c₀ hc₀
          have hdeg_ne : b₀.degree ≠ 0 := by
            rw [Polynomial.degree_eq_natDegree hb₀]
            exact mod_cast (by omega : b₀.natDegree ≠ 0)
          obtain ⟨a, ha_root⟩ := IsAlgClosed.exists_root b₀ hdeg_ne
          obtain ⟨b₁, hb₁_eq⟩ := Polynomial.dvd_iff_isRoot.mpr ha_root
          let p_lin : B := Polynomial.X - Polynomial.C a
          have hp_ne : p_lin ≠ 0 := Polynomial.X_sub_C_ne_zero a
          have hb₁_ne : b₁ ≠ 0 := by
            intro h0
            apply hb₀
            rw [hb₁_eq, h0, mul_zero]
          have hb₁_deg : b₁.natDegree = m := by
            have hmul_deg := Polynomial.natDegree_mul hp_ne hb₁_ne
            change (p_lin * b₁).natDegree = p_lin.natDegree + b₁.natDegree at hmul_deg
            rw [← hb₁_eq, hdeg, Polynomial.natDegree_X_sub_C a] at hmul_deg
            omega
          let I_a : Ideal B := Ideal.span {p_lin}
          have : I_a.IsMaximal :=
            PrincipalIdealRing.isMaximal_of_irreducible (Polynomial.irreducible_X_sub_C a)
          let K_a := B ⧸ I_a
          let : Field K_a := Ideal.Quotient.field I_a
          have : Algebra.Etale K_a (TensorProduct B K_a C) :=
            Algebra.Etale.baseChange B C K_a
          obtain ⟨J, _, Aj, hFieldAj, _, Ψ_a, _⟩ :=
            (Algebra.Etale.iff_exists_algEquiv_prod K_a (TensorProduct B K_a C)).mp inferInstance
          let : ∀ j : J, Field (Aj j) := hFieldAj
          let u : TensorProduct B K_a C := (1 : K_a) ⊗ₜ[B] c₀
          have hb₀_mem : b₀ ∈ I_a := by
            rw [hb₁_eq]
            exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self p_lin)
          have hu_sq : u * u = 0 := by
            dsimp only [u]
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, hc₀, ← TensorProduct.smul_tmul]
            have hq0 : b₀ • (1 : K_a) = 0 := by
              change Ideal.Quotient.mk I_a b₀ * 1 = 0
              rw [mul_one, Ideal.Quotient.eq_zero_iff_mem.mpr hb₀_mem]
            rw [hq0, TensorProduct.zero_tmul]
          have hu_zero : u = 0 := by
            apply Ψ_a.injective
            rw [map_zero]
            ext j
            have hj_sq : (Ψ_a u j) * (Ψ_a u j) = 0 := by
              change (Ψ_a u * Ψ_a u) j = 0
              rw [← map_mul, hu_sq, map_zero]
              rfl
            exact mul_self_eq_zero.mp hj_sq
          have hcomm_zero : (c₀ ⊗ₜ[B] (Ideal.Quotient.mk I_a 1)) = 0 := by
            simpa [u] using congrArg (TensorProduct.comm B K_a C) hu_zero
          have hquot_zero := congrArg (TensorProduct.tensorQuotEquivQuotSMul C I_a) hcomm_zero
          rw [(TensorProduct.tensorQuotEquivQuotSMul C I_a).map_zero,
            TensorProduct.tensorQuotEquivQuotSMul_tmul_mk, one_smul,
            Submodule.Quotient.mk_eq_zero] at hquot_zero
          have hle_range : I_a • (⊤ : Submodule B C) ≤ LinearMap.range (LinearMap.lsmul B C p_lin) := by
            rw [Submodule.smul_le]
            intro r hr y _
            obtain ⟨s, rfl⟩ := Ideal.mem_span_singleton.mp hr
            exact ⟨s • y, (mul_smul p_lin s y).symm⟩
          obtain ⟨c₁, hc₁⟩ := hle_range hquot_zero
          change p_lin • c₁ = c₀ at hc₁
          have hc₁_sq : c₁ * c₁ = b₁ • c₁ := by
            have hpp_ne : p_lin * p_lin ≠ 0 := mul_ne_zero hp_ne hp_ne
            have hdiff : (p_lin * p_lin) • (c₁ * c₁ - b₁ • c₁) = 0 := by
              rw [smul_sub]
              have hL : (p_lin * p_lin) • (c₁ * c₁) = c₀ * c₀ := by
                rw [← hc₁, smul_mul_smul_comm]
              have hR : (p_lin * p_lin) • (b₁ • c₁) = b₀ • c₀ := by
                rw [← hc₁, ← mul_smul, ← mul_smul, hb₁_eq]
                congr 1
                ring
              rw [hL, hR, hc₀, sub_self]
            exact sub_eq_zero.mp (hFlatTF hpp_ne hdiff)
          obtain ⟨d, hd⟩ := ih b₁ hb₁_deg hb₁_ne c₁ hc₁_sq
          refine ⟨d, ?_⟩
          rw [← hc₁, hd, ← mul_smul, ← hb₁_eq]
      let E := FractionRing B
      let A_E := TensorProduct B E C
      let ι : C →ₐ[B] A_E := Algebra.TensorProduct.includeRight
      have hInj_ι : Function.Injective ι := by
        intro c₁ c₂ hc₁₂
        have hmk : TensorProduct.mk B E C 1 c₁ = TensorProduct.mk B E C 1 c₂ := hc₁₂
        obtain ⟨s, hs⟩ := IsLocalizedModule.exists_of_eq (S := nonZeroDivisors B) hmk
        have hs_ne : (s : B) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
        have hsub : (s : B) • (c₁ - c₂) = 0 := by
          rw [smul_sub]
          exact sub_eq_zero.mpr hs
        exact sub_eq_zero.mp (hFlatTF hs_ne hsub)
      have : Algebra.Etale E A_E := Algebra.Etale.baseChange B C E
      obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, Φ, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod E A_E).mp inferInstance
      have : Finite I := hFinI
      let : Fintype I := Fintype.ofFinite I
      let : ∀ i : I, Field (Ai i) := hFieldAi
      let : ∀ i : I, Algebra E (Ai i) := hAlgAi
      let v : I → ∀ j : I, Ai j := fun i => Pi.single i 1
      have hv_idem : ∀ i : I, v i * v i = v i := by
        intro i
        ext j
        change v i j * v i j = v i j
        dsimp [v]
        by_cases hij : j = i
        · subst hij; simp
        · simp [Pi.single_eq_of_ne hij]
      have hLift : ∀ i : I, ∃ e_i : C, Φ (ι e_i) = v i := by
        intro i
        let e_tilde : A_E := Φ.symm (v i)
        have het_idem : e_tilde * e_tilde = e_tilde := by
          dsimp [e_tilde]
          rw [← map_mul, hv_idem]
        obtain ⟨⟨c_i, s_i⟩, hcs⟩ :=
          IsLocalizedModule.surj (nonZeroDivisors B) (TensorProduct.mk B E C 1) e_tilde
        dsimp only at hcs
        let b_i : B := s_i.1
        have hb_i : b_i ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s_i.2
        have hcs' : b_i • e_tilde = ι c_i := hcs
        have hci_sq : c_i * c_i = b_i • c_i := by
          refine hInj_ι ?_
          rw [map_mul, ← hcs', smul_mul_smul_comm, het_idem, map_smul, ← hcs', mul_smul]
        obtain ⟨e_i, hei⟩ := hQuadDivDeg b_i.natDegree b_i rfl hb_i c_i hci_sq
        refine ⟨e_i, ?_⟩
        have hbE_ne : algebraMap B E b_i ≠ 0 :=
          fun h => hb_i (IsFractionRing.injective B E (h.trans (map_zero _).symm))
        have h_eq_et : ι e_i = e_tilde := by
          have hsmul_eq : b_i • ι e_i = b_i • e_tilde := by
            rw [← map_smul, ← hei, hcs']
          rw [← IsScalarTower.algebraMap_smul E b_i, ← IsScalarTower.algebraMap_smul E b_i] at hsmul_eq
          calc
            ι e_i = (1 : E) • ι e_i := (one_smul _ _).symm
            _ = ((algebraMap B E b_i)⁻¹ * algebraMap B E b_i) • ι e_i := by
              rw [inv_mul_cancel₀ hbE_ne]
            _ = (algebraMap B E b_i)⁻¹ • (algebraMap B E b_i • ι e_i) := mul_smul _ _ _
            _ = (algebraMap B E b_i)⁻¹ • (algebraMap B E b_i • e_tilde) := by rw [hsmul_eq]
            _ = ((algebraMap B E b_i)⁻¹ * algebraMap B E b_i) • e_tilde := (mul_smul _ _ _).symm
            _ = e_tilde := by rw [inv_mul_cancel₀ hbE_ne, one_smul]
        rw [h_eq_et]
        exact Φ.apply_symm_apply (v i)
      let e_id : I → C := fun i => (hLift i).choose
      have he_spec : ∀ i : I, Φ (ι (e_id i)) = v i := fun i => (hLift i).choose_spec
      have hsum_one : ∑ i : I, e_id i = 1 := by
        refine hInj_ι (Φ.injective ?_)
        rw [map_sum, map_sum, map_one, map_one]
        ext j
        rw [Finset.sum_apply]
        simp only [he_spec, v]
        change ∑ i : I, Pi.single i ((fun k₀ : I => (1 : Ai k₀)) i) j = 1
        exact Fintype.sum_pi_single j (fun _ => 1)
      have hex_not_q : ∃ i₀ : I, e_id i₀ ∉ q := by
        by_contra h_all
        have h_all_mem : ∀ i : I, e_id i ∈ q := fun i => by
          by_contra hi
          exact h_all ⟨i, hi⟩
        have h1_mem : (1 : C) ∈ q := by
          rw [← hsum_one]
          exact Ideal.sum_mem q (fun i _ => h_all_mem i)
        exact Ideal.IsPrime.ne_top ‹q.IsPrime› (q.eq_top_iff_one.mpr h1_mem)
      obtain ⟨i₀, hi₀_q⟩ := hex_not_q
      let f : C := e_id i₀
      refine ⟨f, hi₀_q, ?_⟩
      let ψ : C →+* Ai i₀ := (Pi.evalRingHom Ai i₀).comp (Φ.toRingHom.comp ι.toRingHom)
      have hψ_f : ψ f = 1 := by
        change Φ (ι (e_id i₀)) i₀ = 1
        rw [he_spec i₀]
        exact Pi.single_eq_same i₀ (1 : Ai i₀)
      have hu_f : IsUnit (ψ f) := hψ_f.symm ▸ isUnit_one
      let ψ_hat : Localization.Away f →+* Ai i₀ := IsLocalization.Away.lift f hu_f
      have hInj_ψhat : Function.Injective ψ_hat := by
        rw [injective_iff_map_eq_zero]
        intro w hw
        obtain ⟨n, c, hwc⟩ := IsLocalization.Away.surj f w
        have hψ_c : ψ c = 0 := by
          have h1 := congrArg ψ_hat hwc
          rw [map_mul, map_pow, IsLocalization.Away.lift_eq f hu_f,
            IsLocalization.Away.lift_eq f hu_f, hw, zero_mul] at h1
          exact h1.symm
        have hfc_zero : f * c = 0 := by
          refine hInj_ι (Φ.injective ?_)
          rw [map_zero, map_zero, map_mul, map_mul, he_spec i₀]
          ext j
          change v i₀ j * Φ (ι c) j = 0
          rcases eq_or_ne j i₀ with rfl | hj
          · change v j j * ψ c = 0
            rw [hψ_c, mul_zero]
          · dsimp [v]
            rw [Pi.single_eq_of_ne hj, zero_mul]
        have hw_pow : w * (algebraMap C (Localization.Away f) f) ^ (n + 1) = 0 := by
          calc
            w * (algebraMap C (Localization.Away f) f) ^ (n + 1)
                = (w * (algebraMap C (Localization.Away f) f) ^ n) *
                    algebraMap C (Localization.Away f) f := by rw [pow_succ, mul_assoc]
            _ = algebraMap C (Localization.Away f) c * algebraMap C (Localization.Away f) f := by
              rw [hwc]
            _ = algebraMap C (Localization.Away f) (f * c) := by rw [← map_mul, mul_comm]
            _ = 0 := by rw [hfc_zero, map_zero]
        have hunit_pow : IsUnit ((algebraMap C (Localization.Away f) f) ^ (n + 1)) :=
          (IsLocalization.Away.algebraMap_isUnit f).pow (n + 1)
        exact (hunit_pow.mul_left_eq_zero).mp hw_pow
      exact Function.Injective.isDomain ψ_hat hInj_ψhat

    
    have hSubSpec : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := by
      refine ⟨fun p₁ p₂ => PrimeSpectrum.ext ?_⟩
      have hp₁ : p₁.asIdeal = ⊥ := by
        rcases Ideal.eq_bot_or_top p₁.asIdeal with h | h
        · exact h
        · exact False.elim (p₁.isPrime.ne_top h)
      have hp₂ : p₂.asIdeal = ⊥ := by
        rcases Ideal.eq_bot_or_top p₂.asIdeal with h | h
        · exact h
        · exact False.elim (p₂.isPrime.ne_top h)
      rw [hp₁, hp₂]
    let e_poly_mv : Polynomial k ≃+* MvPolynomial (Fin 1) k :=
      ((MvPolynomial.finSuccEquiv k 0).trans
        (Polynomial.mapAlgEquiv (MvPolynomial.isEmptyAlgEquiv k (Fin 0)))).symm.toRingEquiv
    have hLocDom : ∀ x : Γ₀.left, ∃ U : Γ₀.left.Opens,
        AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U ∧
        IsDomain ↑(Γ₀.left.presheaf.obj (Opposite.op U)) := by
      intro x
      obtain ⟨U_k, _, V, hAffV, hxV, hle, hStdSm⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 Γ₀.hom).mp inferInstance x
      have hUk_top : U_k = ⊤ := top_unique fun y _ => by
        rw [Subsingleton.elim y (Γ₀.hom.base x)]
        exact hle hxV
      subst hUk_top
      let e_k : k ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤)) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv
      have hStdSm_k : RingHom.IsStandardSmoothOfRelativeDimension 1
          (((Γ₀.hom.appLE ⊤ V hle).hom).comp e_k.toRingHom) :=
        (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).right
          (Γ₀.hom.appLE ⊤ V hle).hom e_k hStdSm
      obtain ⟨g_mv, _, hg_et⟩ := hStdSm_k.exists_etale_mvPolynomial
      let C_V := ↑(Γ₀.left.presheaf.obj (Opposite.op V))
      let g_poly : Polynomial k →+* C_V := g_mv.comp e_poly_mv.toRingHom
      have hg_poly_et : g_poly.Etale :=
        RingHom.Etale.respectsIso.right g_mv e_poly_mv hg_et
      let : Algebra (Polynomial k) C_V := g_poly.toAlgebra
      have : Algebra.Etale (Polynomial k) C_V :=
        RingHom.etale_algebraMap.mp hg_poly_et
      let q_x : Ideal C_V := (hAffV.primeIdealOf ⟨x, hxV⟩).asIdeal
      have : q_x.IsPrime := (hAffV.primeIdealOf ⟨x, hxV⟩).isPrime
      obtain ⟨f, hf_not_q, hDomAway⟩ := hEtalePolyAwayDomain C_V q_x
      refine ⟨Γ₀.left.basicOpen f, hAffV.basicOpen f, ?_, ?_⟩
      · have hpt : hAffV.fromSpec (hAffV.primeIdealOf ⟨x, hxV⟩) = x :=
          hAffV.fromSpec_primeIdealOf ⟨x, hxV⟩
        have hmem : hAffV.fromSpec (hAffV.primeIdealOf ⟨x, hxV⟩) ∈ Γ₀.left.basicOpen f := by
          change hAffV.primeIdealOf ⟨x, hxV⟩ ∈ hAffV.fromSpec ⁻¹ᵁ Γ₀.left.basicOpen f
          rw [hAffV.fromSpec_preimage_basicOpen f]
          exact hf_not_q
        rwa [hpt] at hmem
      · have : IsLocalization.Away f ↑(Γ₀.left.presheaf.obj (Opposite.op (Γ₀.left.basicOpen f))) :=
          hAffV.isLocalization_basicOpen f
        exact (IsLocalization.algEquiv (Submonoid.powers f) (Localization.Away f)
          ↑(Γ₀.left.presheaf.obj (Opposite.op (Γ₀.left.basicOpen f)))).toMulEquiv.symm.isDomain

    
    let R_proj := MvPolynomial (Fin (N + 1)) k
    let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
    have : IsNoetherianRing k := hNoeth_k
    have : IsNoetherianRing R_proj := MvPolynomial.isNoetherianRing
    let e_cl : TopologicalSpace.Closeds (ProjectiveSpectrum 𝒜_N) ↪o (Ideal R_proj)ᵒᵈ :=
      OrderEmbedding.ofMapLEIff
        (fun Z => OrderDual.toDual (ProjectiveSpectrum.vanishingIdeal (Z : Set (ProjectiveSpectrum 𝒜_N))).toIdeal)
        (fun Z₁ Z₂ => by
          rw [OrderDual.toDual_le_toDual]
          constructor
          · intro hle
            have hle_set :
                ((ProjectiveSpectrum.vanishingIdeal (Z₂ : Set (ProjectiveSpectrum 𝒜_N)) :
                    HomogeneousIdeal 𝒜_N) : Set R_proj) ⊆
                  ((ProjectiveSpectrum.vanishingIdeal (Z₁ : Set (ProjectiveSpectrum 𝒜_N)) :
                    HomogeneousIdeal 𝒜_N) : Set R_proj) := hle
            have hanti := ProjectiveSpectrum.zeroLocus_anti_mono 𝒜_N hle_set
            rw [ProjectiveSpectrum.zeroLocus_vanishingIdeal_eq_closure,
              ProjectiveSpectrum.zeroLocus_vanishingIdeal_eq_closure,
              Z₁.isClosed.closure_eq, Z₂.isClosed.closure_eq] at hanti
            exact hanti
          · intro hle
            exact ProjectiveSpectrum.vanishingIdeal_anti_mono 𝒜_N hle)
    have hWF_proj : WellFoundedLT (TopologicalSpace.Closeds (ProjectiveSpectrum 𝒜_N)) :=
      e_cl.wellFoundedLT
    have hNoeth_proj : TopologicalSpace.NoetherianSpace (ProjectiveSpectrum 𝒜_N) :=
      ((TopologicalSpace.noetherianSpace_TFAE (ProjectiveSpectrum 𝒜_N)).out 2 1).mp hWF_proj
    have hNoeth_PN : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k N).left :=
      hNoeth_proj
    have hInd_ΓP : Topology.IsInducing ι_ΓP.left.base :=
      (@AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding _ _ ι_ΓP.left hCl).isEmbedding.isInducing
    have hAllCompact_PN : ∀ s : Set ↥(weilProjectiveSpaceOver k N).left, IsCompact s :=
      ((TopologicalSpace.noetherianSpace_TFAE ↥(weilProjectiveSpaceOver k N).left).out 1 3).mp hNoeth_PN
    have hNoeth_Γ : TopologicalSpace.NoetherianSpace ↥Γ₀.left :=
      ((TopologicalSpace.noetherianSpace_TFAE ↥Γ₀.left).out 3 1).mp fun s =>
        hInd_ΓP.isCompact_iff.mpr (hAllCompact_PN (ι_ΓP.left.base '' s))

    
    have hRed_Γ : AlgebraicGeometry.IsReduced Γ₀.left := by
      refine @AlgebraicGeometry.isReduced_of_isReduced_stalk Γ₀.left fun x => ?_
      obtain ⟨U, hAffU, hxU, hDomU⟩ := hLocDom x
      let : IsDomain ↑(Γ₀.left.presheaf.obj (Opposite.op U)) := hDomU
      let x_U : ↥U := ⟨x, hxU⟩
      let p_x := hAffU.primeIdealOf x_U
      have : p_x.asIdeal.IsPrime := p_x.isPrime
      have : IsDomain (Localization.AtPrime p_x.asIdeal) :=
        IsLocalization.isDomain_of_local_atPrime p_x.isPrime
      let : Algebra ↑(Γ₀.left.presheaf.obj (Opposite.op U)) ↑(Γ₀.left.presheaf.stalk x) :=
        (Γ₀.left.presheaf.germ U x hxU).hom.toAlgebra
      have : IsLocalization.AtPrime ↑(Γ₀.left.presheaf.stalk (x_U : ↥Γ₀.left)) p_x.asIdeal :=
        hAffU.isLocalization_stalk x_U
      have : IsDomain ↑(Γ₀.left.presheaf.stalk (x_U : ↥Γ₀.left)) :=
        (IsLocalization.algEquiv p_x.asIdeal.primeCompl (Localization.AtPrime p_x.asIdeal)
          ↑(Γ₀.left.presheaf.stalk (x_U : ↥Γ₀.left))).toMulEquiv.symm.isDomain
      change _root_.IsReduced ↑(Γ₀.left.presheaf.stalk (x_U : ↥Γ₀.left))
      infer_instance
    have hOpen_irredComp : ∀ K ∈ irreducibleComponents ↥Γ₀.left,
        IsClosed K ∧ IsOpen K ∧ IsIrreducible K := by
      intro K hK
      have hK_max := hK
      rw [irreducibleComponents_eq_maximals_closed] at hK_max
      have hK_cl : IsClosed K := hK_max.1.1
      have hK_irr : IsIrreducible K := hK_max.1.2
      refine ⟨hK_cl, isOpen_iff_forall_mem_open.mpr fun x hxK => ?_, hK_irr⟩
      obtain ⟨U, hAffU, hxU, hDomU⟩ := hLocDom x
      let : IsDomain ↑(Γ₀.left.presheaf.obj (Opposite.op U)) := hDomU
      have : IrreducibleSpace ↥(AlgebraicGeometry.Spec (Γ₀.left.presheaf.obj (Opposite.op U))) :=
        PrimeSpectrum.irreducibleSpace
      have hU_range : (U : Set ↥Γ₀.left) = hAffU.fromSpec '' Set.univ := by
        rw [Set.image_univ, hAffU.range_fromSpec]
      have hU_irr : IsIrreducible (U : Set ↥Γ₀.left) := by
        rw [hU_range]
        exact (IrreducibleSpace.isIrreducible_univ _).image hAffU.fromSpec
          hAffU.fromSpec.continuous.continuousOn
      have hK_sub_union : K ⊆ closure (U : Set ↥Γ₀.left) ∪ (U : Set ↥Γ₀.left)ᶜ := by
        intro y _
        by_cases hy : y ∈ (U : Set ↥Γ₀.left)
        · exact Or.inl (subset_closure hy)
        · exact Or.inr hy
      rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hK_irr.isPreirreducible)
          (closure (U : Set ↥Γ₀.left)) ((U : Set ↥Γ₀.left)ᶜ)
          isClosed_closure U.isOpen.isClosed_compl hK_sub_union with hsub_cl | hsub_compl
      · have hcl_sub : closure (U : Set ↥Γ₀.left) ⊆ K :=
          hK_max.2 ⟨isClosed_closure, hU_irr.closure⟩ hsub_cl
        exact ⟨(U : Set ↥Γ₀.left), subset_closure.trans hcl_sub, U.isOpen, hxU⟩
      · exact False.elim (hsub_compl hxK hxU)
    have hFin_comp : (irreducibleComponents ↥Γ₀.left).Finite :=
      @TopologicalSpace.NoetherianSpace.finite_irreducibleComponents ↥Γ₀.left _ hNoeth_Γ
    let F_comp := hFin_comp.toFinset
    let m_comp := Fintype.card ↥F_comp
    let e_comp : Fin m_comp ≃ ↥F_comp := (Fintype.equivFin ↥F_comp).symm
    let K_comp : Fin m_comp → Set Γ₀.left := fun l => (e_comp l).1
    have hK_mem : ∀ l : Fin m_comp, K_comp l ∈ irreducibleComponents ↥Γ₀.left :=
      fun l => hFin_comp.mem_toFinset.mp (e_comp l).2
    have hK_clopen_irr : ∀ l : Fin m_comp,
        IsClosed (K_comp l) ∧ IsOpen (K_comp l) ∧ IsIrreducible (K_comp l) :=
      fun l => hOpen_irredComp (K_comp l) (hK_mem l)
    have hK_union : (⋃ l : Fin m_comp, K_comp l) = Set.univ := by
      ext x
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      have hx_mem_ic : irreducibleComponent x ∈ F_comp :=
        hFin_comp.mem_toFinset.mpr (irreducibleComponent_mem_irreducibleComponents x)
      refine ⟨e_comp.symm ⟨irreducibleComponent x, hx_mem_ic⟩, ?_⟩
      change x ∈ (e_comp (e_comp.symm ⟨irreducibleComponent x, hx_mem_ic⟩)).1
      rw [e_comp.apply_symm_apply]
      exact mem_irreducibleComponent
    have hK_dim : ∀ l : Fin m_comp,
        topologicalKrullDim ↥(K_comp l) = ((1 : ℕ) : WithBot ℕ∞) := by
      intro l
      let U_l : Γ₀.left.Opens := ⟨K_comp l, (hK_clopen_irr l).2.1⟩
      let Y_l : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (U_l.ι ≫ Γ₀.hom)
      have : AlgebraicGeometry.IsReduced Y_l.left :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion U_l.ι
      have : IrreducibleSpace ↥Y_l.left :=
        isIrreducible_iff_irreducibleSpace.mp (hK_clopen_irr l).2.2
      have hInt_Yl : AlgebraicGeometry.IsIntegral Y_l.left :=
        AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Y_l.left
      have : AlgebraicGeometry.SmoothOfRelativeDimension 1 Y_l.hom := by
        change AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_l.ι ≫ Γ₀.hom)
        simpa only [zero_add] using
          (inferInstance : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (U_l.ι ≫ Γ₀.hom))
      exact hDim1 Y_l hInt_Yl
    refine ⟨m_comp, K_comp, ⟨fun l => ⟨(hK_clopen_irr l).1, (hK_clopen_irr l).2.1,
      (hK_clopen_irr l).2.2, hK_dim l⟩, hK_union⟩, ?_⟩

    
    intro W hAffW t φ_W
    let B_W := ↑(Γ₀.left.presheaf.obj (Opposite.op W))
    have : _root_.IsReduced B_W := AlgebraicGeometry.IsReduced.component_reduced W
    have hBasic_iff : ∀ (s : B_W) (u : Γ₀.left) (hu : u ∈ W),
        u ∈ Γ₀.left.basicOpen s ↔ s ∉ (hAffW.primeIdealOf ⟨u, hu⟩).asIdeal := by
      intro s u hu
      have hpt : hAffW.fromSpec (hAffW.primeIdealOf ⟨u, hu⟩) = u :=
        hAffW.fromSpec_primeIdealOf ⟨u, hu⟩
      have hiff : hAffW.fromSpec (hAffW.primeIdealOf ⟨u, hu⟩) ∈ Γ₀.left.basicOpen s ↔
          s ∉ (hAffW.primeIdealOf ⟨u, hu⟩).asIdeal := by
        change hAffW.primeIdealOf ⟨u, hu⟩ ∈ hAffW.fromSpec ⁻¹ᵁ Γ₀.left.basicOpen s ↔ _
        rw [hAffW.fromSpec_preimage_basicOpen s]
        exact PrimeSpectrum.mem_basicOpen s (hAffW.primeIdealOf ⟨u, hu⟩)
      rwa [hpt] at hiff
    have hExistsCompOfNeZero : ∀ (b : B_W), b ≠ 0 →
        ∃ (l : Fin m_comp) (w₀ : Γ₀.left),
          w₀ ∈ W ∧ w₀ ∈ K_comp l ∧ w₀ ∈ Γ₀.left.basicOpen b := by
      intro b hb
      have hex_prime : ∃ J : Ideal B_W, J.IsPrime ∧ b ∉ J := by
        by_contra hall
        have hall' : ∀ J : Ideal B_W, J.IsPrime → b ∈ J := fun J hJ => by
          by_contra hnot
          exact hall ⟨J, hJ, hnot⟩
        have hb_inf : b ∈ sInf { J : Ideal B_W | J.IsPrime } :=
          Ideal.mem_sInf.mpr fun J hJ => hall' J hJ
        rw [← nilradical_eq_sInf B_W, nilradical_eq_zero B_W,
          Ideal.zero_eq_bot, Ideal.mem_bot] at hb_inf
        exact hb hb_inf
      obtain ⟨J, hJ_prime, hb_not_J⟩ := hex_prime
      let p_J : PrimeSpectrum B_W := ⟨J, hJ_prime⟩
      let w₀ : Γ₀.left := hAffW.fromSpec p_J
      have hw₀_b : w₀ ∈ Γ₀.left.basicOpen b := by
        change p_J ∈ hAffW.fromSpec ⁻¹ᵁ Γ₀.left.basicOpen b
        rw [hAffW.fromSpec_preimage_basicOpen b]
        exact hb_not_J
      have hw₀_W : w₀ ∈ W := Γ₀.left.basicOpen_le b hw₀_b
      have hw₀_univ : w₀ ∈ (⋃ l : Fin m_comp, K_comp l) := by
        rw [hK_union]; exact Set.mem_univ w₀
      obtain ⟨l, hw₀_K⟩ := Set.mem_iUnion.mp hw₀_univ
      exact ⟨l, w₀, hw₀_W, hw₀_K, hw₀_b⟩
    refine ⟨?_, ?_⟩
    · intro h_nzd_hyp
      rw [mem_nonZeroDivisors_iff_right]
      intro b hbt
      by_contra hb
      obtain ⟨l, w₀, hw₀_W, hw₀_K, hw₀_b⟩ := hExistsCompOfNeZero b hb
      obtain ⟨z, hz_W, hz_K, ht_not_qz⟩ := h_nzd_hyp l ⟨w₀, hw₀_W, hw₀_K⟩
      have hz_t : z ∈ Γ₀.left.basicOpen t := (hBasic_iff t z hz_W).mpr ht_not_qz
      obtain ⟨u, _, hu_b, hu_t⟩ :=
        (hK_clopen_irr l).2.2.isPreirreducible
          (Γ₀.left.basicOpen b : Set Γ₀.left) (Γ₀.left.basicOpen t : Set Γ₀.left)
          (Γ₀.left.basicOpen b).isOpen (Γ₀.left.basicOpen t).isOpen
          ⟨w₀, hw₀_K, hw₀_b⟩ ⟨z, hz_K, hz_t⟩
      have hu_bt : u ∈ (Γ₀.left.basicOpen b ⊓ Γ₀.left.basicOpen t : Γ₀.left.Opens) := ⟨hu_b, hu_t⟩
      rw [← Γ₀.left.basicOpen_mul b t, hbt, Γ₀.left.basicOpen_zero W] at hu_bt
      exact hu_bt
    · intro h_tf_hyp
      let : Algebra k B_W := φ_W.toAlgebra
      let : Algebra (Polynomial k) B_W := (Polynomial.aeval t).toRingHom.toAlgebra
      rw [Module.isTorsionFree_iff_smul_eq_zero]
      intro P b hPb
      rw [or_iff_not_imp_left]
      intro hP_ne
      by_contra hb_ne
      obtain ⟨l, w₀, hw₀_W, hw₀_K, hw₀_b⟩ := hExistsCompOfNeZero b hb_ne
      have hDisj_P : ¬ (K_comp l ∩ (Γ₀.left.basicOpen (Polynomial.aeval t P) : Set Γ₀.left)).Nonempty := by
        rintro ⟨v, hv_K, hv_P⟩
        obtain ⟨u, _, hu_P, hu_b⟩ :=
          (hK_clopen_irr l).2.2.isPreirreducible
            (Γ₀.left.basicOpen (Polynomial.aeval t P) : Set Γ₀.left)
            (Γ₀.left.basicOpen b : Set Γ₀.left)
            (Γ₀.left.basicOpen (Polynomial.aeval t P)).isOpen
            (Γ₀.left.basicOpen b).isOpen
            ⟨v, hv_K, hv_P⟩ ⟨w₀, hw₀_K, hw₀_b⟩
        have hu_Pb : u ∈ (Γ₀.left.basicOpen (Polynomial.aeval t P) ⊓ Γ₀.left.basicOpen b : Γ₀.left.Opens) :=
          ⟨hu_P, hu_b⟩
        have hmul0 : Polynomial.aeval t P * b = 0 := hPb
        rw [← Γ₀.left.basicOpen_mul, hmul0, Γ₀.left.basicOpen_zero W] at hu_Pb
        exact hu_Pb
      let L : List k := P.roots.toList
      have hP_fac : P = Polynomial.C P.leadingCoeff *
          (L.map (fun a : k => Polynomial.X - Polynomial.C a)).prod := by
        have hsp := Polynomial.Splits.eq_prod_roots (IsAlgClosed.splits P)
        rw [← Multiset.coe_toList P.roots] at hsp
        simpa [L] using hsp
      have haeval_fac : Polynomial.aeval t P =
          φ_W P.leadingCoeff * (L.map (fun a : k => t - φ_W a)).prod := by
        conv_lhs => rw [hP_fac]
        rw [map_mul, Polynomial.aeval_C, map_list_prod, List.map_map]
        congr 2
        refine List.map_congr_left fun a _ => ?_
        change Polynomial.aeval t (Polynomial.X - Polynomial.C a) = t - φ_W a
        rw [map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
        rfl
