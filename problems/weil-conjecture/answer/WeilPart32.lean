    have hrange_O : Set.range (O_sch.ι ≫ U_axis.ι).base = Set.range (V_p p).ι.base := by
      rw [Scheme.Opens.range_ι]
      ext z
      constructor
      · rintro ⟨v, rfl⟩
        exact v.2
      · intro hz
        exact ⟨⟨⟨z, hVp_le_U hz⟩, hz⟩, rfl⟩
