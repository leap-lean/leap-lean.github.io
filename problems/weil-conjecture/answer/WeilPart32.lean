      let e₂ : P_aux ≃+* MvPolynomial (Fin d) k := e₁.symm.trans τ_shift.toRingEquiv
      have h1 : (ψ_V.comp e₂.toRingHom).Etale := by
        let _ : Algebra P_aux (MvPolynomial (Fin d) k) := e₂.toRingHom.toAlgebra
