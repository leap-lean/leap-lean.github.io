      AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE π_Y.left Z_bar.hom ⊤ U_Z V_Y le_top inf_le_left
    have h1 := congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ·) happ.symm
    have h2 := congrArg (fun f : CommRingCat.of k ⟶ Y₂.left.presheaf.obj (Opposite.op V_Y) =>
