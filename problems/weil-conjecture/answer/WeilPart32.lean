      let away_β : AlgebraicGeometry.Spec
          (CommRingCat.of (HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β))) ⟶ X_2 :=
        AlgebraicGeometry.Proj.awayι 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one
      have : AlgebraicGeometry.IsOpenImmersion away_β := by
