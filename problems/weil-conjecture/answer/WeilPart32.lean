  have hV1 : ∀ z₀ : Z_bar.left, IsClosed ({z₀} : Set Z_bar.left) →
      ∃ L : MvPolynomial (Fin (M + 1)) k, L ∈ 𝒜_M 1 ∧ L ≠ 0 ∧
