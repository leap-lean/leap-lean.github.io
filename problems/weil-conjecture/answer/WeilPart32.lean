        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_pow]
        have hval_lhs : (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) a).val =
            Localization.mk a.1 1 := rfl
        have hmk_pow : ∀ (k_pow : ℕ), (Localization.mk a.1 (1 : Submonoid.powers f)) ^ k_pow =
            Localization.mk (a.1 ^ k_pow) 1 := by
