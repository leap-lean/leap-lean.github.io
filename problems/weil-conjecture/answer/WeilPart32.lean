    have hDerE : ∀ (E : Type u) [Field E] (σ : A →+* E),
        letI : Algebra k E := (σ.comp (algebraMap k A)).toAlgebra
        ∀ (D : Derivation k E E) (a : A),
          D (σ a) = ∑ i : Fin d, σ (D_V i a) * D (σ (ψ_V (MvPolynomial.X i))) := by
      intro E _ σ
      let _ : Algebra k E := (σ.comp (algebraMap k A)).toAlgebra
      intro D a
      have hChain : ∀ G : MvPolynomial (Fin (s + d)) k,
          D (σ (φ G)) =
            ∑ β : Fin (s + d), σ (φ (MvPolynomial.pderiv β G)) * D (σ (φ (MvPolynomial.X β))) := by
        intro G
        induction G using MvPolynomial.induction_on with
        | C r =>
          have hc : σ (φ (MvPolynomial.C r)) = algebraMap k E r := rfl
          rw [hc, D.map_algebraMap]
          simp
        | add G₁ G₂ ih₁ ih₂ =>
          simp only [map_add, ih₁, ih₂, add_mul, Finset.sum_add_distrib]
        | mul_X G₁ β₀ ih =>
          rw [map_mul, map_mul, D.leibniz, smul_eq_mul, smul_eq_mul, ih, Finset.mul_sum]
          simp only [MvPolynomial.pderiv_mul, map_add, map_mul, add_mul, Finset.sum_add_distrib]
          have h_single : (∑ β : Fin (s + d),
              σ (φ G₁) * σ (φ (MvPolynomial.pderiv β (MvPolynomial.X β₀))) *
                D (σ (φ (MvPolynomial.X β)))) =
              σ (φ G₁) * D (σ (φ (MvPolynomial.X β₀))) := by
            rw [Finset.sum_eq_single β₀]
            · simp
            · intro β _ hβ
              have hp0 : MvPolynomial.pderiv β
                  (MvPolynomial.X β₀ : MvPolynomial (Fin (s + d)) k) = 0 := by
                rw [MvPolynomial.pderiv_X, Pi.single_eq_of_ne hβ.symm]
              rw [hp0, map_zero, map_zero, mul_zero, zero_mul]
            · intro habs; exact absurd (Finset.mem_univ _) habs
          rw [h_single, add_comm]
          congr 1
          refine Finset.sum_congr rfl fun β _ => by ring
      let y_E : Fin s → E := fun b => D (σ (φ (MvPolynomial.X (Fin.castAdd d b))))
      let t_E : Fin d → E := fun i => D (σ (ψ_V (MvPolynomial.X i)))
      have ht_E_eq : ∀ i : Fin d, t_E i = D (σ (φ (MvPolynomial.X (Fin.natAdd s i)))) := fun i => by
        change D (σ (φ (MvPolynomial.rename (Fin.natAdd s) (MvPolynomial.X i)))) = _
        rw [MvPolynomial.rename_X]
      have hq_rel_E : ∀ a_idx : Fin s,
          (∑ b : Fin s, σ (M₀ a_idx b) * y_E b) +
            (∑ i : Fin d, σ (M₁ a_idx i) * t_E i) = 0 := by
        intro a_idx
        have hφq : φ (q a_idx) = 0 := by
          rw [← RingHom.mem_ker, hKer]
          exact Ideal.subset_span ⟨a_idx, rfl⟩
        have h0 := hChain (q a_idx)
        rw [hφq, map_zero, map_zero, Fin.sum_univ_add] at h0
        simp_rw [ht_E_eq]
        exact h0.symm
      have hy_solve : ∀ b₀ : Fin s, y_E b₀ = ∑ i : Fin d, σ (W b₀ i) * t_E i := by
        intro b₀
        have hsum0 : ∑ a_idx : Fin s, σ (M₀⁻¹ b₀ a_idx) *
            ((∑ b : Fin s, σ (M₀ a_idx b) * y_E b) +
              (∑ i : Fin d, σ (M₁ a_idx i) * t_E i)) = 0 :=
          Finset.sum_eq_zero fun a_idx _ => by rw [hq_rel_E a_idx, mul_zero]
        have h_lhs1 : (∑ a_idx : Fin s, σ (M₀⁻¹ b₀ a_idx) *
            (∑ b : Fin s, σ (M₀ a_idx b) * y_E b)) = y_E b₀ := by
          simp_rw [Finset.mul_sum, ← mul_assoc, ← map_mul]
          rw [Finset.sum_comm]
          have h_mat : ∀ b : Fin s,
              (∑ a_idx : Fin s, σ (M₀⁻¹ b₀ a_idx * M₀ a_idx b) * y_E b) =
              σ ((M₀⁻¹ * M₀) b₀ b) * y_E b := fun b => by
            rw [← Finset.sum_mul, ← map_sum, Matrix.mul_apply]
          simp_rw [h_mat, hM₀_inv_mul, Matrix.one_apply]
          simp [apply_ite σ]
        have h_lhs2 : (∑ a_idx : Fin s, σ (M₀⁻¹ b₀ a_idx) *
            (∑ i : Fin d, σ (M₁ a_idx i) * t_E i)) =
            ∑ i : Fin d, σ ((M₀⁻¹ * M₁) b₀ i) * t_E i := by
          simp_rw [Finset.mul_sum, ← mul_assoc, ← map_mul]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [← Finset.sum_mul, ← map_sum, Matrix.mul_apply]
        simp_rw [mul_add, Finset.sum_add_distrib] at hsum0
        rw [h_lhs1, h_lhs2] at hsum0
        rw [eq_neg_of_add_eq_zero_left hsum0, ← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        dsimp only [W]
        rw [Matrix.neg_apply, map_neg, neg_mul]
      let F_a := Function.surjInv hSurj a
      have hφFa : φ F_a = a := Function.surjInv_eq hSurj a
      rw [← hφFa, hChain F_a, Fin.sum_univ_add]
      have h_part1 : (∑ b : Fin s,
          σ (φ (MvPolynomial.pderiv (Fin.castAdd d b) F_a)) *
            D (σ (φ (MvPolynomial.X (Fin.castAdd d b))))) =
          ∑ i : Fin d,
            (∑ b : Fin s, σ (φ (MvPolynomial.pderiv (Fin.castAdd d b) F_a) * W b i)) * t_E i := by
        trans ∑ b : Fin s, σ (φ (MvPolynomial.pderiv (Fin.castAdd d b) F_a)) *
            (∑ i : Fin d, σ (W b i) * t_E i)
        · refine Finset.sum_congr rfl fun b _ => ?_
          change _ * y_E b = _
          rw [hy_solve b]
        · simp_rw [Finset.mul_sum, ← mul_assoc, ← map_mul]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun i _ => by rw [Finset.sum_mul]
      have h_part2 : (∑ j : Fin d,
          σ (φ (MvPolynomial.pderiv (Fin.natAdd s j) F_a)) *
            D (σ (φ (MvPolynomial.X (Fin.natAdd s j))))) =
          ∑ i : Fin d,
            (∑ j : Fin d,
              σ (φ (MvPolynomial.pderiv (Fin.natAdd s j) F_a) * (if j = i then 1 else 0))) *
              t_E i := by
        refine Finset.sum_congr rfl fun i _ => ?_
        have h_in : (∑ j : Fin d,
            σ (φ (MvPolynomial.pderiv (Fin.natAdd s j) F_a) * (if j = i then 1 else 0))) =
            σ (φ (MvPolynomial.pderiv (Fin.natAdd s i) F_a)) := by
          rw [← map_sum]
          congr 1
          simp [mul_ite]
        rw [h_in, ht_E_eq i]
      rw [h_part1, h_part2, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← add_mul, ← map_sum, ← map_sum, ← map_add]
      congr 2
      rw [hDV_φ i F_a]
      dsimp only [D_tilde]
      rw [Fin.sum_univ_add]
      simp only [T_mat, Fin.addCases_left, Fin.addCases_right]
    exact ⟨ψ_V, D_V, hψV_C, hEt_and_Trdeg.1, hFT, hEt_and_Trdeg.2, hDV_X, hv_eq, hDerE⟩

  have weil_formallyEtale_local_jet2_odp_calculus :
      ∀ (k : Type u) [Field k] (d : ℕ)
        (A : Type u) [CommRing A] [Algebra k A]
        (ψ_V : MvPolynomial (Fin d) k →+* A)
        (D_V : Fin d → Derivation k A A)
        (ev_z : A →ₐ[k] k)
        (p_z : Ideal A) [p_z.IsPrime]
        (hψV_alg : ψ_V.comp MvPolynomial.C = algebraMap k A)
        (hψV_et : ψ_V.Etale)
        (hDV_X : ∀ i j : Fin d, D_V i (ψ_V (MvPolynomial.X j)) = if i = j then 1 else 0)
        (hKer_evz : RingHom.ker ev_z.toRingHom = p_z),
        ∃ ψ_z : MvPolynomial (Fin d) k →+* A,
          (ψ_z.comp MvPolynomial.C = algebraMap k A ∧
            ψ_z.Etale ∧
            (∀ i : Fin d, ψ_z (MvPolynomial.X i) ∈ p_z)) ∧
          (∀ (f : A) (c₀ : k) (w : Fin d → k),
            algebraMap A (Localization.AtPrime p_z)
              (f - ψ_z (MvPolynomial.C c₀ +
                ∑ i : Fin d, MvPolynomial.C (w i) * MvPolynomial.X i)) ∈
              (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 2 ↔
              (ev_z f = c₀ ∧ ∀ i : Fin d, ev_z (D_V i f) = w i)) ∧
          (∀ (f : A), ev_z f = 0 → (∀ i : Fin d, ev_z (D_V i f) = 0) →
            ∃ Q : MvPolynomial (Fin d) k,
              Q ∈ MvPolynomial.homogeneousSubmodule (Fin d) k 2 ∧
              (∀ i j : Fin d,
                MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q)) =
                  ev_z (D_V j (D_V i f))) ∧
              algebraMap A (Localization.AtPrime p_z) (f - ψ_z Q) ∈
                (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 3) ∧
          (∀ (ψ'_loc : MvPolynomial (Fin d) k →+* Localization.AtPrime p_z)
              (u : Localization.AtPrime p_z)
              (Q' : MvPolynomial (Fin d) k)
              (f : A),
            ψ'_loc.comp MvPolynomial.C = algebraMap k (Localization.AtPrime p_z) →
            @Algebra.FormallyEtale (MvPolynomial (Fin d) k) (Localization.AtPrime p_z) _ _
              ψ'_loc.toAlgebra →
            (∀ i : Fin d, ψ'_loc (MvPolynomial.X i) ∈
              IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) →
            IsUnit u →
            Q' ∈ MvPolynomial.homogeneousSubmodule (Fin d) k 2 →
            Matrix.det (Matrix.of fun i j : Fin d =>
              MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q'))) ≠ 0 →
            algebraMap A (Localization.AtPrime p_z) f - u * ψ'_loc Q' ∈
              (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 3 →
            (ev_z f = 0 ∧ ∀ i : Fin d, ev_z (D_V i f) = 0) ∧
              Matrix.det (Matrix.of fun i j : Fin d => ev_z (D_V j (D_V i f))) ≠ 0) := by
    have h_triv : True := trivial
    clear * - h_triv
    clear h_triv
    intro k _ d A _ _ ψ_V D_V ev_z p_z _ hψV_alg hψV_et hDV_X hKer_evz
    classical
    have hMulMono : ∀ {R : Type u} [CommSemiring R] {I₁ I₂ J₁ J₂ : Ideal R},
        I₁ ≤ J₁ → I₂ ≤ J₂ → I₁ * I₂ ≤ J₁ * J₂ :=
      fun h1 h2 => Submodule.mul_le.mpr fun _ ha _ hb => Ideal.mul_mem_mul (h1 ha) (h2 hb)
    have hIdealPowMono : ∀ {R : Type u} [CommSemiring R] {I J : Ideal R},
        I ≤ J → ∀ n : ℕ, I ^ n ≤ J ^ n := by
      intro R _ I J hIJ n
      induction n with
      | zero => rw [pow_zero, pow_zero]
      | succ n ih =>
        rw [pow_succ, pow_succ]
        exact hMulMono ih hIJ
    have hDeg0 : ∀ {s : Fin d →₀ ℕ}, Finsupp.degree s = 0 → s = 0 := by
      intro s hs
      ext j
      simp only [Finsupp.coe_zero, Pi.zero_apply]
      have hle : s j ≤ Finsupp.degree s := by
        rw [Finsupp.degree_apply]
        by_cases hj : j ∈ s.support
        · exact Finset.single_le_sum (fun _ _ => Nat.zero_le _) hj
        · rw [Finsupp.notMem_support_iff.mp hj]; exact Nat.zero_le _
      omega
    let a₀ : Fin d → k := fun i => ev_z (ψ_V (MvPolynomial.X i))
    let τ_fwd : MvPolynomial (Fin d) k →ₐ[k] MvPolynomial (Fin d) k :=
      MvPolynomial.aeval (fun i => MvPolynomial.X i - MvPolynomial.C (a₀ i))
    let τ_inv : MvPolynomial (Fin d) k →ₐ[k] MvPolynomial (Fin d) k :=
