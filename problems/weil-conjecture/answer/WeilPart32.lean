        Classical.not_not.mp hr₀
      let U_open : Z_bar.left.Opens :=
        C_Z α ⊓
          (TopologicalSpace.Opens.map ι_bar.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_M (L r₀))
      obtain ⟨g₁, hg₁_le, hz_g₁⟩ :=
        hAffUsm.exists_basicOpen_le (V := U_open) ⟨z, hz_α, hr₀'⟩ hz_sm
      let U_Z : Z_bar.left.Opens := Z_bar.left.basicOpen g₁
      have hAffUZ : AlgebraicGeometry.IsAffineOpen U_Z := hAffUsm.basicOpen g₁
      have hUZ_sm : U_Z ≤ U_sm := Z_bar.left.basicOpen_le g₁
      have hUZ_α : U_Z ≤ C_Z α := hg₁_le.trans inf_le_left
      have hUZ_Lr₀ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M (L r₀)) :=
        hg₁_le.trans inf_le_right
