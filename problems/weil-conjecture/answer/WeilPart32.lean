        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp hb
        have hu₁_zero : π₁ (Ideal.Quotient.mk (Ideal.span {u₀}) u₁) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr hu₁_q
        rw [map_mul, hu₁_zero, zero_mul]
    have _ : Nontrivial (↑(Z_bar.left.presheaf.obj (Opposite.op U₂_c)) ⧸ 𝔮) :=
      Ideal.Quotient.nontrivial_iff.mpr h𝔮_prime.ne_top
    exact π₂.domain_nontrivial

  
  have hQuot_T_τ12 :
      letI : Algebra k ↑B_Γ0 := φ_Γ0.toAlgebra
      letI : Algebra k ↑(Γ₀.left.presheaf.obj (Opposite.op W₂)) := φ_W₂.toAlgebra
      Nonempty ((↑B_Γ0 ⧸ Ideal.span {T_Γ}) ≃ₗ[k]
        (↑(Γ₀.left.presheaf.obj (Opposite.op W₂)) ⧸ Ideal.span {τ₁₂})) := by
    apply (weil_algClosed_smooth_curve_components_and_torsionFree_quotient k).2.2.1
      Γ₀ W₁ W₂ hAff_W₁ hAff_W₂ T_Γ h₁₂ τ₁₂ u₁₂
      hBasic_h12 (hBasic_u12.trans (inf_comm _ _))
    · intro y hy₁
      rw [TopologicalSpace.Opens.mem_sup, hBasic_T]
      by_cases hy₂ : y ∈ W₂
      · exact Or.inr hy₂
      · refine Or.inl ⟨hy₁, ?_⟩
        change ι_ΓP.left.base y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N F_L
        by_contra hnot
        exact hΓ_disj_FL_H₂ y ⟨hnot, hy₂⟩
    · intro y hy₂
      rw [TopologicalSpace.Opens.mem_sup, hBasic_τ12]
      by_cases hy₁ : y ∈ W₁
      · exact Or.inr hy₁
      · refine Or.inl ⟨hy₂, ?_⟩
        change ι_ΓP.left.base y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N F_L
