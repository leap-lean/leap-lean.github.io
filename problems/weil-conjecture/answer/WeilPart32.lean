              (p₁_P.appLE (D₁ b) W_b inf_le_right).hom (t_sec b a)} := by
        intro b W_b
        rw [hKer_ZQ₁ p.1 (MvPolynomial.isHomogeneous_X k p.1) hF_axis b
          (MvPolynomial.isHomogeneous_X k b) V (hAff_Vp p) hV_le (D₁ b) (hAff_D₁ b) le_rfl
