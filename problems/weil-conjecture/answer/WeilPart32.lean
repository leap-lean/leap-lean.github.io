              (CommRingCat.ofHom m₂ ≫ AlgebraicGeometry.Proj.awayToSection 𝒜 x_prod ≫
                f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 x_prod) W hW_prod).hom (z_F α' j)
            rw [hm₂_sec]
          rw [hlhs, hrhs, hz_eq, map_mul]
        rw [hℓ_eq]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
      intro α α' W hWα hWα'
      exact le_antisymm (hJ_le α α' W hWα hWα') (hJ_le α' α W hWα' hWα)
    let ideal_fn : ∀ (U : X₀.affineOpens), Ideal ↑(X₀.presheaf.obj (Opposite.op U.1)) :=
      fun U => ⨅ (α : Fin (N + 1))
        (g : ↑(X₀.presheaf.obj (Opposite.op U.1)))
        (hg : X₀.basicOpen g ≤ C_open α),
        Ideal.comap (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g)).op).hom
          (J_id α (X₀.basicOpen g) hg)
    have hideal_on_chart : ∀ (U : X₀.affineOpens) (α₀ : Fin (N + 1)) (hUα₀ : U.1 ≤ C_open α₀),
        ideal_fn U = J_id α₀ U.1 hUα₀ := by
      intro U α₀ hUα₀
      apply le_antisymm
      · intro r hr
        simp only [ideal_fn, Ideal.mem_iInf, Ideal.mem_comap] at hr
        have h1_eq : X₀.basicOpen (1 : ↑(X₀.presheaf.obj (Opposite.op U.1))) = U.1 :=
          X₀.basicOpen_of_isUnit isUnit_one
        have hg1 : X₀.basicOpen (1 : ↑(X₀.presheaf.obj (Opposite.op U.1))) ≤ C_open α₀ := by
          rw [h1_eq]; exact hUα₀
        have hr1 := hr α₀ 1 hg1
        have hle_back : U.1 ≤ X₀.basicOpen (1 : ↑(X₀.presheaf.obj (Opposite.op U.1))) :=
          le_of_eq h1_eq.symm
        have hmem := Ideal.mem_map_of_mem
          (X₀.presheaf.map (CategoryTheory.homOfLE hle_back).op).hom hr1
        rw [hJ_res α₀ (X₀.basicOpen (1 : ↑(X₀.presheaf.obj (Opposite.op U.1)))) U.1 hg1 hle_back] at hmem
        have hid_comp :
            (X₀.presheaf.map (CategoryTheory.homOfLE hle_back).op).hom
              ((X₀.presheaf.map (CategoryTheory.homOfLE
                (X₀.basicOpen_le (1 : ↑(X₀.presheaf.obj (Opposite.op U.1))))).op).hom r) = r := by
          change (X₀.presheaf.map _ ≫ X₀.presheaf.map _).hom r = r
          rw [← X₀.presheaf.map_comp]
          have : (CategoryTheory.homOfLE (X₀.basicOpen_le _)).op ≫
              (CategoryTheory.homOfLE hle_back).op = 𝟙 (Opposite.op U.1) :=
            Subsingleton.elim _ _
          rw [this, X₀.presheaf.map_id]
          rfl
        rwa [hid_comp] at hmem
      · simp only [ideal_fn, le_iInf_iff]
        intro α g hg r hr
        rw [Ideal.mem_comap]
        have hmem := Ideal.mem_map_of_mem
          (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g)).op).hom hr
        rw [hJ_res α₀ U.1 (X₀.basicOpen g) hUα₀ (X₀.basicOpen_le g),
          hJ_overlap α₀ α (X₀.basicOpen g) ((X₀.basicOpen_le g).trans hUα₀) hg] at hmem
        exact hmem
    have hex_pt_chart : ∀ (U : X₀.affineOpens) (x : X₀), x ∈ U.1 →
        ∃ (α₀ : Fin (N + 1)) (g₀ : ↑(X₀.presheaf.obj (Opposite.op U.1))),
          x ∈ X₀.basicOpen g₀ ∧ X₀.basicOpen g₀ ≤ C_open α₀ := by
      intro U x hxU
      have hAffU : AlgebraicGeometry.IsAffineOpen U.1 := U.2
      obtain ⟨q, rfl⟩ : x ∈ Set.range hAffU.fromSpec.base := by
        rw [hAffU.range_fromSpec]
        exact hxU
      have hfx_top : f_X.base (hAffU.fromSpec.base q) ∈ (⊤ : P.Opens) := trivial
      rw [← hD_top, TopologicalSpace.Opens.mem_iSup] at hfx_top
      obtain ⟨α₀, hxα₀⟩ := hfx_top
      have hq_mem : q ∈ (TopologicalSpace.Opens.map hAffU.fromSpec.base).obj (C_open α₀) := hxα₀
      obtain ⟨V_b, ⟨g₀, rfl⟩, hq_in, hVb_sub⟩ :=
        (TopologicalSpace.IsTopologicalBasis.mem_nhds_iff
          (PrimeSpectrum.isTopologicalBasis_basic_opens
            (R := ↑(X₀.presheaf.obj (Opposite.op U.1))))).mp
          (((TopologicalSpace.Opens.map hAffU.fromSpec.base).obj (C_open α₀)).2.mem_nhds hq_mem)
      refine ⟨α₀, g₀, ?_, ?_⟩
      · rw [← hAffU.fromSpec_image_basicOpen]
        exact ⟨q, hq_in, rfl⟩
      · intro y hy
        rw [← hAffU.fromSpec_image_basicOpen] at hy
        obtain ⟨q', hq', rfl⟩ := hy
        exact hVb_sub hq'
    have hex_fin_cov : ∀ (U : X₀.affineOpens),
        ∃ (m : ℕ) (α_cov : Fin m → Fin (N + 1))
          (g_cov : Fin m → ↑(X₀.presheaf.obj (Opposite.op U.1))),
          (∀ i : Fin m, X₀.basicOpen (g_cov i) ≤ C_open (α_cov i)) ∧
          Ideal.span (Set.range g_cov) = ⊤ := by
      intro U
      have hAffU : AlgebraicGeometry.IsAffineOpen U.1 := U.2
      let S_pair : Set (Fin (N + 1) × ↑(X₀.presheaf.obj (Opposite.op U.1))) :=
        { p | X₀.basicOpen p.2 ≤ C_open p.1 }
      have htop_spec : (⨆ p : ↥S_pair, PrimeSpectrum.basicOpen p.1.2) = ⊤ := by
        rw [eq_top_iff]
        intro q _
        rw [TopologicalSpace.Opens.mem_iSup]
        let q_sp : ↥(AlgebraicGeometry.Spec (X₀.presheaf.obj (Opposite.op U.1))) := q
        have hxU : hAffU.fromSpec.base q_sp ∈ U.1 := by
          have hmem_range : hAffU.fromSpec.base q_sp ∈ Set.range hAffU.fromSpec.base := ⟨q_sp, rfl⟩
          rwa [hAffU.range_fromSpec] at hmem_range
        obtain ⟨α₀, g₀, hxg₀, hg₀_le⟩ := hex_pt_chart U (hAffU.fromSpec.base q_sp) hxU
        have hq_g₀ : q_sp ∈ (TopologicalSpace.Opens.map hAffU.fromSpec.base).obj (X₀.basicOpen g₀) :=
          hxg₀
        rw [hAffU.fromSpec_preimage_basicOpen] at hq_g₀
        exact ⟨⟨(α₀, g₀), hg₀_le⟩, hq_g₀⟩
      rw [PrimeSpectrum.iSup_basicOpen_eq_top_iff] at htop_spec
      have h1_in : (1 : ↑(X₀.presheaf.obj (Opposite.op U.1))) ∈
          Ideal.span (Set.range fun p : ↥S_pair => p.1.2) := by
        rw [htop_spec]; trivial
      have h_fin : ∀ r ∈ Ideal.span (Set.range fun p : ↥S_pair => p.1.2),
          ∃ s_fin : Finset ↥S_pair, r ∈ Ideal.span ((fun p : ↥S_pair => p.1.2) '' ↑s_fin) := by
        intro r hr
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hr
        · rintro _ ⟨p, rfl⟩
          exact ⟨{p}, Ideal.subset_span ⟨p, Finset.mem_coe.mpr (Finset.mem_singleton_self p), rfl⟩⟩
        · exact ⟨∅, Ideal.zero_mem _⟩
        · rintro x y _ _ ⟨s₁, hs₁⟩ ⟨s₂, hs₂⟩
          refine ⟨s₁ ∪ s₂, Ideal.add_mem _ (Ideal.span_mono ?_ hs₁) (Ideal.span_mono ?_ hs₂)⟩
          · exact Set.image_mono (Finset.coe_subset.mpr Finset.subset_union_left)
          · exact Set.image_mono (Finset.coe_subset.mpr Finset.subset_union_right)
        · rintro c x _ ⟨s₁, hs₁⟩
          exact ⟨s₁, Submodule.smul_mem _ c hs₁⟩
      obtain ⟨s_fin, hs_fin⟩ := h_fin 1 h1_in
      let e_fin := s_fin.equivFin.symm
      refine ⟨s_fin.card, fun i => (e_fin i).1.1.1, fun i => (e_fin i).1.1.2,
        fun i => (e_fin i).1.2, ?_⟩
      rw [Ideal.eq_top_iff_one]
      refine Ideal.span_mono ?_ hs_fin
      rintro _ ⟨p, hp, rfl⟩
      exact ⟨s_fin.equivFin ⟨p, hp⟩, by simp [e_fin]⟩
    have hmem_of_cov : ∀ (U : X₀.affineOpens) (m : ℕ)
        (α_cov : Fin m → Fin (N + 1))
        (g_cov : Fin m → ↑(X₀.presheaf.obj (Opposite.op U.1)))
        (hg_cov : ∀ i : Fin m, X₀.basicOpen (g_cov i) ≤ C_open (α_cov i))
        (hspan_top : Ideal.span (Set.range g_cov) = ⊤)
        (r : ↑(X₀.presheaf.obj (Opposite.op U.1))),
        (∀ i : Fin m,
          (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le (g_cov i))).op).hom r ∈
            J_id (α_cov i) (X₀.basicOpen (g_cov i)) (hg_cov i)) →
        r ∈ ideal_fn U := by
      intro U m α_cov g_cov hg_cov hspan_top r hr_cov
      simp only [ideal_fn, Ideal.mem_iInf, Ideal.mem_comap]
      intro α h hh
      let U_h : X₀.Opens := X₀.basicOpen h
      have hAff_h : AlgebraicGeometry.IsAffineOpen U_h := U.2.basicOpen h
      let res_h := (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le h)).op).hom
      let g_h : Fin m → ↑(X₀.presheaf.obj (Opposite.op U_h)) := fun i => res_h (g_cov i)
      have hpow_in : ∀ i : Fin m, ∃ n_i : ℕ, (g_h i) ^ n_i * res_h r ∈ J_id α U_h hh := by
        intro i
        let W_i : X₀.Opens := X₀.basicOpen (g_h i)
        have hWi_eq : W_i = U_h ⊓ X₀.basicOpen (g_cov i) :=
          X₀.basicOpen_res (g_cov i) (CategoryTheory.homOfLE (X₀.basicOpen_le h)).op
        have hWi_le_g : W_i ≤ X₀.basicOpen (g_cov i) := hWi_eq.le.trans inf_le_right
        have hWi_le_h : W_i ≤ U_h := X₀.basicOpen_le (g_h i)
        have hmem_Wi := Ideal.mem_map_of_mem
          (X₀.presheaf.map (CategoryTheory.homOfLE hWi_le_g).op).hom (hr_cov i)
        rw [hJ_res (α_cov i) (X₀.basicOpen (g_cov i)) W_i (hg_cov i) hWi_le_g,
          hJ_overlap (α_cov i) α W_i (hWi_le_g.trans (hg_cov i)) (hWi_le_h.trans hh),
          ← hJ_res α U_h W_i hh hWi_le_h] at hmem_Wi
        have hcomp_r :
            (X₀.presheaf.map (CategoryTheory.homOfLE hWi_le_g).op).hom
              ((X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le (g_cov i))).op).hom r) =
            (X₀.presheaf.map (CategoryTheory.homOfLE hWi_le_h).op).hom (res_h r) := by
          change (X₀.presheaf.map _ ≫ X₀.presheaf.map _).hom r =
            (X₀.presheaf.map _ ≫ X₀.presheaf.map _).hom r
          rw [← X₀.presheaf.map_comp, ← X₀.presheaf.map_comp]
          rfl
        rw [hcomp_r] at hmem_Wi
        have : IsLocalization.Away (g_h i) ↑(X₀.presheaf.obj (Opposite.op W_i)) :=
          hAff_h.isLocalization_basicOpen (g_h i)
        have hmem_loc : (algebraMap ↑(X₀.presheaf.obj (Opposite.op U_h))
            ↑(X₀.presheaf.obj (Opposite.op W_i))) (res_h r) ∈
            Ideal.map (algebraMap ↑(X₀.presheaf.obj (Opposite.op U_h))
              ↑(X₀.presheaf.obj (Opposite.op W_i))) (J_id α U_h hh) := hmem_Wi
        rw [IsLocalization.mem_map_algebraMap_iff (Submonoid.powers (g_h i))] at hmem_loc
        obtain ⟨⟨⟨y₀, hy₀⟩, ⟨_, k_i, rfl⟩⟩, heq_loc⟩ := hmem_loc
        simp only [← map_mul] at heq_loc
        obtain ⟨⟨_, e_i, rfl⟩, heq_R⟩ :=
          (IsLocalization.eq_iff_exists (Submonoid.powers (g_h i)) _).mp heq_loc
        refine ⟨e_i + k_i, ?_⟩
        have hmul_eq : (g_h i) ^ (e_i + k_i) * res_h r = (g_h i) ^ e_i * y₀ := by
          calc (g_h i) ^ (e_i + k_i) * res_h r
              = (g_h i) ^ e_i * (res_h r * (g_h i) ^ k_i) := by ring
            _ = (g_h i) ^ e_i * y₀ := heq_R
        rw [hmul_eq]
        exact Ideal.mul_mem_left _ _ hy₀
      let n_fn : Fin m → ℕ := fun i => Classical.choose (hpow_in i)
      let K_max : ℕ := Finset.univ.sup n_fn
      have hgh_top : Ideal.span (Set.range g_h) = ⊤ := by
        have h1 : Ideal.map res_h (Ideal.span (Set.range g_cov)) = ⊤ := by
          rw [hspan_top, Ideal.map_top]
        rw [Ideal.map_span] at h1
        convert h1 using 2
        ext y
        simp [g_h]
      have hpow_top : Ideal.span ((fun x => x ^ K_max) '' Set.range g_h) = ⊤ :=
        Ideal.span_pow_eq_top _ hgh_top K_max
      have h1_mem : (1 : ↑(X₀.presheaf.obj (Opposite.op U_h))) ∈
          Ideal.span ((fun x => x ^ K_max) '' Set.range g_h) := by
        rw [hpow_top]; trivial
      have hmul_mem : ∀ u ∈ Ideal.span ((fun x => x ^ K_max) '' Set.range g_h),
          u * res_h r ∈ J_id α U_h hh := by
        intro u hu
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hu
        · rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
          have hle_K : n_fn i ≤ K_max := Finset.le_sup (Finset.mem_univ i)
          have hsub : K_max = (K_max - n_fn i) + n_fn i := (Nat.sub_add_cancel hle_K).symm
          dsimp only
          rw [hsub, pow_add, mul_assoc]
          exact Ideal.mul_mem_left _ _ (Classical.choose_spec (hpow_in i))
        · simp
        · intro x y _ _ hx hy
          rw [add_mul]
          exact Ideal.add_mem _ hx hy
        · intro c x _ hx
          rw [smul_eq_mul, mul_assoc]
          exact Ideal.mul_mem_left _ c hx
      simpa using hmul_mem 1 h1_mem
    have hmap_basicOpen : ∀ (U : X₀.affineOpens) (f : ↑(X₀.presheaf.obj (Opposite.op U.1))),
        Ideal.map (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le f)).op).hom (ideal_fn U) =
          ideal_fn (X₀.affineBasicOpen f) := by
      intro U f
      have hAffU : AlgebraicGeometry.IsAffineOpen U.1 := U.2
      let res_f : ↑(X₀.presheaf.obj (Opposite.op U.1)) →+*
          ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen f))) :=
        (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le f)).op).hom
      have : IsLocalization.Away f ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen f))) :=
        hAffU.isLocalization_basicOpen f
      change Ideal.map res_f (ideal_fn U) = ideal_fn ⟨X₀.basicOpen f, U.2.basicOpen f⟩
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro r hr
        rw [Ideal.mem_comap]
        simp only [ideal_fn, Ideal.mem_iInf, Ideal.mem_comap]
        intro α w hw
        obtain ⟨⟨h₀, ⟨_, e, rfl⟩⟩, hw_eq⟩ :=
          IsLocalization.surj (Submonoid.powers f) w
        dsimp only at hw_eq
        change w * res_f (f ^ e) = res_f h₀ at hw_eq
        have hw_open : X₀.basicOpen w = X₀.basicOpen (f * h₀) := by
          have h1 : X₀.basicOpen (res_f h₀) ≤ X₀.basicOpen w := by
            have heq : res_f h₀ = w * res_f (f ^ e) := hw_eq.symm
            rw [heq, X₀.basicOpen_mul]
            exact inf_le_left
          obtain ⟨u_inv, hu_inv⟩ :=
            ((IsLocalization.Away.algebraMap_isUnit
              (S := ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen f)))) f).pow e).exists_right_inv
          have hw_inv : w = res_f h₀ * u_inv := by
            calc w = w * 1 := (mul_one w).symm
              _ = w * ((res_f f) ^ e * u_inv) := by rw [← hu_inv]; rfl
              _ = (w * res_f (f ^ e)) * u_inv := by rw [map_pow]; ring
              _ = res_f h₀ * u_inv := by rw [hw_eq]
          have h2 : X₀.basicOpen w ≤ X₀.basicOpen (res_f h₀) := by
            conv_lhs => rw [hw_inv]
            rw [X₀.basicOpen_mul]
            exact inf_le_left
          have h3 : X₀.basicOpen w = X₀.basicOpen (res_f h₀) := le_antisymm h2 h1
          rw [h3, X₀.basicOpen_res h₀ (CategoryTheory.homOfLE (X₀.basicOpen_le f)).op,
            ← X₀.basicOpen_mul]
        have hfh₀_le : X₀.basicOpen (f * h₀) ≤ C_open α := hw_open ▸ hw
        simp only [ideal_fn, Ideal.mem_iInf, Ideal.mem_comap] at hr
        have hr_fh₀ := hr α (f * h₀) hfh₀_le
        have hle_eq : X₀.basicOpen w ≤ X₀.basicOpen (f * h₀) := le_of_eq hw_open
        have hmem := Ideal.mem_map_of_mem
          (X₀.presheaf.map (CategoryTheory.homOfLE hle_eq).op).hom hr_fh₀
        rw [hJ_res α (X₀.basicOpen (f * h₀)) (X₀.basicOpen w) hfh₀_le hle_eq] at hmem
        have hcomp_eq :
            (X₀.presheaf.map (CategoryTheory.homOfLE hle_eq).op).hom
              ((X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le (f * h₀))).op).hom r) =
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le w)).op).hom (res_f r) := by
          change (X₀.presheaf.map _ ≫ X₀.presheaf.map _).hom r =
            (X₀.presheaf.map _ ≫ X₀.presheaf.map _).hom r
          rw [← X₀.presheaf.map_comp, ← X₀.presheaf.map_comp]
          rfl
        rwa [hcomp_eq] at hmem
      · intro z hz
        obtain ⟨m, α_cov, g_cov, hg_cov, hspan_top⟩ := hex_fin_cov U
        obtain ⟨⟨r₀, ⟨_, e₀, rfl⟩⟩, hz_eq⟩ :=
          IsLocalization.surj (Submonoid.powers f) z
        dsimp only at hz_eq
        change z * res_f (f ^ e₀) = res_f r₀ at hz_eq
        have hr₀_uf : res_f r₀ ∈ ideal_fn ⟨X₀.basicOpen f, U.2.basicOpen f⟩ := by
          have hz_mul : res_f r₀ = res_f (f ^ e₀) * z := by rw [← hz_eq, mul_comm]
          rw [hz_mul]
          exact Ideal.mul_mem_left _ _ hz
        have hpow_f : ∀ i : Fin m, ∃ k_i : ℕ,
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le (g_cov i))).op).hom
              (f ^ k_i * r₀) ∈ J_id (α_cov i) (X₀.basicOpen (g_cov i)) (hg_cov i) := by
          intro i
          let w_i : ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen f))) := res_f (g_cov i)
          let res_gi := (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le (g_cov i))).op).hom
          let f_gi := res_gi f
          have hw_open : X₀.basicOpen w_i = X₀.basicOpen f_gi := by
            rw [X₀.basicOpen_res (g_cov i) (CategoryTheory.homOfLE (X₀.basicOpen_le f)).op,
              X₀.basicOpen_res f (CategoryTheory.homOfLE (X₀.basicOpen_le (g_cov i))).op,
              inf_comm]
          have hw_le_α : X₀.basicOpen w_i ≤ C_open (α_cov i) := by
            rw [hw_open]
            exact (X₀.basicOpen_le f_gi).trans (hg_cov i)
          have hr₀_wi : (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le w_i)).op).hom
              (res_f r₀) ∈ J_id (α_cov i) (X₀.basicOpen w_i) hw_le_α := by
            have hmem_iInf : res_f r₀ ∈ ideal_fn ⟨X₀.basicOpen f, U.2.basicOpen f⟩ := hr₀_uf
            simp only [ideal_fn, Ideal.mem_iInf, Ideal.mem_comap] at hmem_iInf
            exact hmem_iInf (α_cov i) w_i hw_le_α
          have hle_fgi : X₀.basicOpen f_gi ≤ X₀.basicOpen w_i := le_of_eq hw_open.symm
          have hmem_fgi := Ideal.mem_map_of_mem
            (X₀.presheaf.map (CategoryTheory.homOfLE hle_fgi).op).hom hr₀_wi
          rw [hJ_res (α_cov i) (X₀.basicOpen w_i) (X₀.basicOpen f_gi) hw_le_α hle_fgi,
            ← hJ_res (α_cov i) (X₀.basicOpen (g_cov i)) (X₀.basicOpen f_gi)
              (hg_cov i) (X₀.basicOpen_le f_gi)] at hmem_fgi
          have hcomp_r₀ :
              (X₀.presheaf.map (CategoryTheory.homOfLE hle_fgi).op).hom
                ((X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le w_i)).op).hom
                  (res_f r₀)) =
              (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le f_gi)).op).hom
                (res_gi r₀) := by
            change ((X₀.presheaf.map _ ≫ X₀.presheaf.map _) ≫ X₀.presheaf.map _).hom r₀ =
              (X₀.presheaf.map _ ≫ X₀.presheaf.map _).hom r₀
            rw [← X₀.presheaf.map_comp, ← X₀.presheaf.map_comp, ← X₀.presheaf.map_comp]
            rfl
          rw [hcomp_r₀] at hmem_fgi
          have hAff_gi : AlgebraicGeometry.IsAffineOpen (X₀.basicOpen (g_cov i)) :=
            hAffU.basicOpen (g_cov i)
          have : IsLocalization.Away f_gi ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen f_gi))) :=
            hAff_gi.isLocalization_basicOpen f_gi
          have hmem_loc : (algebraMap ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen (g_cov i))))
              ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen f_gi)))) (res_gi r₀) ∈
              Ideal.map (algebraMap ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen (g_cov i))))
                ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen f_gi))))
                (J_id (α_cov i) (X₀.basicOpen (g_cov i)) (hg_cov i)) := hmem_fgi
          rw [IsLocalization.mem_map_algebraMap_iff (Submonoid.powers f_gi)] at hmem_loc
          obtain ⟨⟨⟨y₀, hy₀⟩, ⟨_, k_i, rfl⟩⟩, heq_loc⟩ := hmem_loc
          simp only [← map_mul] at heq_loc
          obtain ⟨⟨_, e_i, rfl⟩, heq_R⟩ :=
            (IsLocalization.eq_iff_exists (Submonoid.powers f_gi) _).mp heq_loc
          refine ⟨e_i + k_i, ?_⟩
          have hmul_eq : res_gi (f ^ (e_i + k_i) * r₀) = f_gi ^ e_i * y₀ := by
            calc res_gi (f ^ (e_i + k_i) * r₀)
                = f_gi ^ (e_i + k_i) * res_gi r₀ := by
                  rw [map_mul, map_pow]
              _ = f_gi ^ e_i * (res_gi r₀ * f_gi ^ k_i) := by ring
              _ = f_gi ^ e_i * y₀ := heq_R
          rw [hmul_eq]
          exact Ideal.mul_mem_left _ _ hy₀
        let k_fn : Fin m → ℕ := fun i => Classical.choose (hpow_f i)
        let K_max : ℕ := Finset.univ.sup k_fn
        have hfK_mem : f ^ K_max * r₀ ∈ ideal_fn U := by
          refine hmem_of_cov U m α_cov g_cov hg_cov hspan_top (f ^ K_max * r₀) fun i => ?_
          have hle_K : k_fn i ≤ K_max := Finset.le_sup (Finset.mem_univ i)
          have hsub : K_max = (K_max - k_fn i) + k_fn i := (Nat.sub_add_cancel hle_K).symm
          have hsplit : f ^ K_max * r₀ = f ^ (K_max - k_fn i) * (f ^ k_fn i * r₀) := by
            conv_lhs => rw [hsub]
            rw [pow_add, mul_assoc]
          rw [hsplit, map_mul]
          exact Ideal.mul_mem_left _ _ (Classical.choose_spec (hpow_f i))
        obtain ⟨u_inv, hu_inv⟩ :=
          ((IsLocalization.Away.algebraMap_isUnit
            (S := ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen f)))) f).pow (e₀ + K_max)).exists_right_inv
        have hz_rep : z = u_inv * res_f (f ^ K_max * r₀) := by
          calc z = z * 1 := (mul_one z).symm
            _ = z * ((res_f f) ^ (e₀ + K_max) * u_inv) := by rw [← hu_inv]; rfl
            _ = u_inv * ((z * res_f (f ^ e₀)) * res_f (f ^ K_max)) := by
              rw [pow_add, map_pow, map_pow]
              ring
            _ = u_inv * res_f (f ^ K_max * r₀) := by
              rw [hz_eq, ← map_mul, mul_comm r₀]
        rw [hz_rep]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem res_f hfK_mem)
    let supportSet : Set X₀ :=
      { x : X₀ | ∀ j : Fin ν, f_X.base x ∈ weilProjHyperplaneSet k N (F j) }
    have hsupport_iff : ∀ (U : X₀.affineOpens) (x : X₀), x ∈ U.1 →
        (x ∈ supportSet ↔
          x ∈ @AlgebraicGeometry.Scheme.zeroLocus X₀ U.1
            (ideal_fn U : Set ↑(X₀.presheaf.obj (Opposite.op U.1)))) := by
      intro U x hxU
      obtain ⟨α₀, g₀, hxg₀, hg₀_le⟩ := hex_pt_chart U x hxU
      let res_g₀ : ↑(X₀.presheaf.obj (Opposite.op U.1)) →+*
          ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen g₀))) :=
        (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g₀)).op).hom
      have hzl_eq : x ∈ @AlgebraicGeometry.Scheme.zeroLocus X₀ U.1
            (ideal_fn U : Set ↑(X₀.presheaf.obj (Opposite.op U.1))) ↔
          x ∈ @AlgebraicGeometry.Scheme.zeroLocus X₀ (X₀.basicOpen g₀)
            (ideal_fn ⟨X₀.basicOpen g₀, U.2.basicOpen g₀⟩ :
              Set ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen g₀)))) := by
        have hmap_g₀ : ideal_fn ⟨X₀.basicOpen g₀, U.2.basicOpen g₀⟩ =
            Ideal.map res_g₀ (ideal_fn U) :=
          (hmap_basicOpen U g₀).symm
        rw [hmap_g₀]
        have hmap_eq : Ideal.map res_g₀ (ideal_fn U) =
            Ideal.span (res_g₀ '' (ideal_fn U : Set ↑(X₀.presheaf.obj (Opposite.op U.1)))) := rfl
        rw [hmap_eq, X₀.zeroLocus_span, X₀.mem_zeroLocus_iff, X₀.mem_zeroLocus_iff]
        constructor
        · rintro hall _ ⟨s, hs, rfl⟩
          rw [X₀.basicOpen_res]
          exact fun ⟨_, hxs⟩ => hall s hs hxs
        · intro hall s hs hxs
          apply hall (res_g₀ s) ⟨s, hs, rfl⟩
          rw [X₀.basicOpen_res]
          exact ⟨hxg₀, hxs⟩
      rw [hzl_eq, hideal_on_chart ⟨X₀.basicOpen g₀, U.2.basicOpen g₀⟩ α₀ hg₀_le]
      dsimp [J_id]
      rw [X₀.zeroLocus_span, X₀.mem_zeroLocus_iff]
      have hpt_iff : ∀ j : Fin ν,
          x ∈ X₀.basicOpen (ℓ_sec α₀ (X₀.basicOpen g₀) hg₀_le j) ↔
            f_X.base x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (F j) := by
        intro j
        dsimp [ℓ_sec]
        let s_P := (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X α₀)).hom (z_F α₀ j)
        have hbo_X : X₀.basicOpen ((f_X.appLE (D α₀) (X₀.basicOpen g₀) hg₀_le).hom s_P) =
            X₀.basicOpen g₀ ⊓ (TopologicalSpace.Opens.map f_X.base).obj (P.basicOpen s_P) :=
          AlgebraicGeometry.Scheme.basicOpen_appLE f_X (X₀.basicOpen g₀) (D α₀) hg₀_le s_P
        have hxD : f_X.base x ∈ D α₀ := hg₀_le hxg₀
        have hbo_P : f_X.base x ∈ P.basicOpen s_P ↔
            f_X.base x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (F j) := by
          let yD : ↥(D α₀).toScheme := ⟨f_X.base x, hxD⟩
          change yD ∈ (TopologicalSpace.Opens.map (D α₀).ι.base).obj (P.basicOpen s_P) ↔ _
          rw [← AlgebraicGeometry.Scheme.Opens.toSpecΓ_preimage_basicOpen (D α₀) s_P]
          change ((D α₀).toSpecΓ.base yD ∈ PrimeSpectrum.basicOpen s_P) ↔ _
          have hspec_pre :
              ((D α₀).toSpecΓ.base yD ∈ PrimeSpectrum.basicOpen s_P) ↔
              (((D α₀).toSpecΓ ≫ AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X α₀))).base
                  yD ∈ PrimeSpectrum.basicOpen (z_F α₀ j)) := Iff.rfl
          rw [hspec_pre]
          have htoSpec := AlgebraicGeometry.ProjectiveSpectrum.Proj.toSpec_preimage_basicOpen 𝒜
            ⟨1, ⟨F j, hF j⟩, ⟨MvPolynomial.X α₀, hX_deg α₀⟩, ⟨1, pow_one _⟩⟩
          exact Set.ext_iff.mp (TopologicalSpace.Opens.ext_iff.mp htoSpec) ⟨f_X.base x, hxD⟩
        change x ∈ X₀.basicOpen ((f_X.appLE (D α₀) (X₀.basicOpen g₀) hg₀_le).hom s_P) ↔ _
        rw [hbo_X]
        exact ⟨fun ⟨_, h2⟩ => hbo_P.mp h2, fun h => ⟨hxg₀, hbo_P.mpr h⟩⟩
      constructor
      · rintro h _ ⟨j, rfl⟩
        rw [hpt_iff j]
        exact h j
      · intro h j
        show f_X.base x ∉ AlgebraicGeometry.Proj.basicOpen 𝒜 (F j)
        rw [← hpt_iff j]
        exact h _ ⟨j, rfl⟩
    let I_F : X₀.IdealSheafData :=
      AlgebraicGeometry.Scheme.IdealSheafData.mkOfMemSupportIff
        ideal_fn hmap_basicOpen supportSet hsupport_iff
    let S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (I_F.subschemeι ≫ X.hom)
    let ι_S : S ⟶ X := CategoryTheory.Over.homMk I_F.subschemeι rfl
    have hCl_S : AlgebraicGeometry.IsClosedImmersion ι_S.left := by
      change AlgebraicGeometry.IsClosedImmersion I_F.subschemeι
      infer_instance
    have hProp_S : AlgebraicGeometry.IsProper S.hom := by
      dsimp [S]
      infer_instance
    have hProj_S : IsProjectiveOverField k S := by
      refine ⟨N, ι_S ≫ ι_X, ?_⟩
      change AlgebraicGeometry.IsClosedImmersion (I_F.subschemeι ≫ ι_X.left)
      infer_instance
    have hRange_S : Set.range ι_S.left.base = supportSet := by
      change Set.range I_F.subschemeι.base = supportSet
      rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
        AlgebraicGeometry.Scheme.IdealSheafData.coe_support_mkOfMemSupportIff]
    refine ⟨S, ι_S, hCl_S, hProp_S, hProj_S, hRange_S, ?_, ?_, ?_⟩
    · intro α₀ V hAffV hVα hXα hpos
      refine ⟨AlgebraicGeometry.Scheme.Hom.app_surjective ι_S.left V hAffV, ?_⟩
      have hker1 : RingHom.ker (I_F.subschemeι.app V).hom = I_F.ideal ⟨V, hAffV⟩ := by
        rw [← AlgebraicGeometry.Scheme.Hom.ker_apply I_F.subschemeι ⟨V, hAffV⟩,
          AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι]
      change RingHom.ker (I_F.subschemeι.app V).hom = _
      rw [hker1, AlgebraicGeometry.Scheme.IdealSheafData.mkOfMemSupportIff_ideal,
        hideal_on_chart ⟨V, hAffV⟩ α₀ hVα]
      dsimp [J_id, ℓ_sec, z_F]
      congr 1
    · intro hν1 hF_ne
      subst hν1
      have : AlgebraicGeometry.IsClosedImmersion f_X := hClX
      let U_P : P.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 (F 0)
      have hAff_UP : AlgebraicGeometry.IsAffineOpen U_P :=
        AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (F 0) (hF 0) zero_lt_one
      let U_aff : X₀.Opens := (TopologicalSpace.Opens.map f_X.base).obj U_P
      have hAff_U : AlgebraicGeometry.IsAffineOpen U_aff := hAff_UP.preimage f_X
      refine ⟨U_aff, ?_, hAff_U⟩
      rw [hRange_S]
      ext x
      simp only [SetLike.mem_coe, Set.mem_compl_iff, supportSet,
        Fin.forall_fin_one, weilProjHyperplaneSet]
      change f_X.base x ∈ U_P ↔ ¬ (f_X.base x ∉ U_P)
      exact not_not.symm
    · rintro _ ⟨j₀, x₀, hx₀⟩
      let U_c : X₀.Opens := ⟨(Set.range ι_S.left.base)ᶜ,
        ι_S.left.isClosedEmbedding.isClosed_range.isOpen_compl⟩
      refine ⟨U_c, rfl, ⟨⟨x₀, ?_⟩⟩⟩
      change x₀ ∉ Set.range ι_S.left.base
      rw [hRange_S]
      intro hall
      exact hx₀ (hall j₀)

  have helper_mvPolyReg :
      ∀ (d : ℕ) (a : Fin d → k),
        RingTheory.Sequence.IsWeaklyRegular (MvPolynomial (Fin d) k)
          ((List.finRange d).map (fun i : Fin d => MvPolynomial.X i - MvPolynomial.C (a i))) := by
    intro d
    induction d with
    | zero =>
      intro a
      rw [List.finRange_zero, List.map_nil, RingTheory.Sequence.isWeaklyRegular_iff]
      intro i hi
      simp at hi
    | succ d ih =>
      intro a
      rw [List.finRange_succ, List.map_cons, List.map_map]
      let t₀ : MvPolynomial (Fin (d + 1)) k := MvPolynomial.X 0 - MvPolynomial.C (a 0)
      change RingTheory.Sequence.IsWeaklyRegular (MvPolynomial (Fin (d + 1)) k)
        (t₀ :: (List.finRange d).map (fun i : Fin d => MvPolynomial.X i.succ - MvPolynomial.C (a i.succ)))
      rw [RingTheory.Sequence.isWeaklyRegular_cons_iff']
      have ht₀_ne : t₀ ≠ 0 := by
        intro h0
        have hev := congrArg (MvPolynomial.eval (fun _ : Fin (d + 1) => a 0 + 1)) h0
        simp [t₀] at hev
      have ht₀_reg : IsSMulRegular (MvPolynomial (Fin (d + 1)) k) t₀ :=
        fun x y hxy => mul_left_cancel₀ ht₀_ne hxy
      refine ⟨ht₀_reg, ?_⟩
      let I₀ : Ideal (MvPolynomial (Fin (d + 1)) k) := Ideal.span {t₀}
      let Φ : MvPolynomial (Fin (d + 1)) k →+* MvPolynomial (Fin d) k :=
        MvPolynomial.eval₂Hom MvPolynomial.C (Fin.cons (MvPolynomial.C (a 0)) MvPolynomial.X)
      have hI₀_le : I₀ ≤ RingHom.ker Φ := by
        rw [Ideal.span_le]
        rintro _ ⟨rfl⟩
        simp [RingHom.mem_ker, Φ, t₀]
      let Φ_bar : (MvPolynomial (Fin (d + 1)) k ⧸ I₀) →+* MvPolynomial (Fin d) k :=
        Ideal.Quotient.lift I₀ Φ (fun _ hx => hI₀_le hx)
      let Ψ_bar : MvPolynomial (Fin d) k →+* (MvPolynomial (Fin (d + 1)) k ⧸ I₀) :=
        (Ideal.Quotient.mk I₀).comp (MvPolynomial.rename Fin.succ).toRingHom
      have hΦΨ : Φ_bar.comp Ψ_bar = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext'
        · ext c
          simp [Φ_bar, Ψ_bar, Φ]
        · intro i
          simp [Φ_bar, Ψ_bar, Φ]
      have hΨΦ : Ψ_bar.comp Φ_bar = RingHom.id _ := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext'
        · ext c
          simp [Φ_bar, Ψ_bar, Φ]
        · intro i
          refine Fin.cases ?_ (fun j => ?_) i
          · have hmem : t₀ ∈ I₀ := Ideal.subset_span rfl
            have hq0 : Ideal.Quotient.mk I₀ t₀ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
            dsimp [t₀] at hq0
            rw [map_sub] at hq0
            have hX0 : Ideal.Quotient.mk I₀ (MvPolynomial.X 0) =
                Ideal.Quotient.mk I₀ (MvPolynomial.C (a 0)) := sub_eq_zero.mp hq0
            change Ψ_bar (Φ_bar (Ideal.Quotient.mk I₀ (MvPolynomial.X 0))) =
              Ideal.Quotient.mk I₀ (MvPolynomial.X 0)
            rw [hX0]
            simp [Ψ_bar, Φ_bar, Φ]
          · simp [Φ_bar, Ψ_bar, Φ]
      let e_ring : (MvPolynomial (Fin (d + 1)) k ⧸ I₀) ≃+* MvPolynomial (Fin d) k :=
        { toFun := Φ_bar
          invFun := Ψ_bar
          left_inv := RingHom.congr_fun hΨΦ
          right_inv := RingHom.congr_fun hΦΨ
          map_mul' := map_mul Φ_bar
          map_add' := map_add Φ_bar }
      let e_quot0 : QuotSMulTop t₀ (MvPolynomial (Fin (d + 1)) k) ≃+
          (MvPolynomial (Fin (d + 1)) k ⧸ I₀) :=
        (Submodule.quotEquivOfEq _ I₀ (by
          rw [← Submodule.ideal_span_singleton_smul]
          exact Ideal.mul_top I₀)).toAddEquiv
      let e_mod : QuotSMulTop t₀ (MvPolynomial (Fin (d + 1)) k) ≃+ MvPolynomial (Fin d) k :=
        e_quot0.trans e_ring.toAddEquiv
      have h_ih := ih (fun i => a i.succ)
      refine (AddEquiv.isWeaklyRegular_congr (e := e_mod) ?_).mpr h_ih
      rw [List.map_map, List.forall₂_map_left_iff, List.forall₂_map_right_iff]
      refine List.forall₂_iff_get.mpr ⟨rfl, fun idx h1 _ => ?_⟩
      intro m
      obtain ⟨p_m, rfl⟩ := Submodule.Quotient.mk_surjective _ m
      simp only [List.get_eq_getElem]
      let j : Fin d := (List.finRange d)[idx]
      let r_j : MvPolynomial (Fin (d + 1)) k := MvPolynomial.X j.succ - MvPolynomial.C (a j.succ)
      have he_r : Φ_bar (Ideal.Quotient.mk I₀ r_j) = MvPolynomial.X j - MvPolynomial.C (a j.succ) := by
        simp [r_j, Φ_bar, Φ]
      change e_mod (Ideal.Quotient.mk I₀ r_j • Submodule.Quotient.mk p_m) =
        (MvPolynomial.X j - MvPolynomial.C (a j.succ)) • e_mod (Submodule.Quotient.mk p_m)
      dsimp only [e_mod]
      rw [AddEquiv.trans_apply, AddEquiv.trans_apply]
      have hq1 : e_quot0 (Ideal.Quotient.mk I₀ r_j • Submodule.Quotient.mk p_m) =
          Ideal.Quotient.mk I₀ (r_j * p_m) := rfl
      have hq2 : e_quot0 (Submodule.Quotient.mk p_m) = Ideal.Quotient.mk I₀ p_m := rfl
      rw [hq1, hq2, smul_eq_mul]
      change Φ_bar (Ideal.Quotient.mk I₀ (r_j * p_m)) =
        (MvPolynomial.X j - MvPolynomial.C (a j.succ)) * Φ_bar (Ideal.Quotient.mk I₀ p_m)
      rw [map_mul, map_mul, he_r]

  have helper_localRegDomain :
      ∀ (n : ℕ) (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
        (L : List R),
        L.length = n →
        RingTheory.Sequence.IsWeaklyRegular R L →
        Ideal.ofList L = IsLocalRing.maximalIdeal R →
        IsDomain R := by
    intro n
    induction n with
    | zero =>
      intro R _ _ _ L hlen _ hmax
      have hnil : L = [] := List.eq_nil_of_length_eq_zero hlen
      subst hnil
      have hbot : IsLocalRing.maximalIdeal R = ⊥ := by simpa using hmax.symm
      let : Field R := (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hbot).toField
      infer_instance
    | succ n ih =>
      intro R _ _ _ L hlen hreg hmax
      rcases L with _ | ⟨t, ts⟩
      · simp at hlen
      simp only [List.length_cons, Nat.succ.injEq] at hlen
      rw [RingTheory.Sequence.isWeaklyRegular_cons_iff'] at hreg
      obtain ⟨ht_reg, hts_reg⟩ := hreg
      let I : Ideal R := Ideal.span {t}
      have ht_max : t ∈ IsLocalRing.maximalIdeal R := by
        rw [← hmax, Ideal.ofList_cons]
        exact Ideal.mem_sup_left (Ideal.subset_span rfl)
      have hI_le_max : I ≤ IsLocalRing.maximalIdeal R := by
        rw [Ideal.span_le]
        rintro _ ⟨rfl⟩
        exact ht_max
      have hI_ne_top : I ≠ ⊤ := by
        intro htop
        apply (IsLocalRing.maximalIdeal.isMaximal R).ne_top
        exact top_unique (htop ▸ hI_le_max)
      have : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI_ne_top
      have : IsLocalRing (R ⧸ I) :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
      let e_quot : QuotSMulTop t R ≃+ (R ⧸ I) :=
        (Submodule.quotEquivOfEq _ I (by
          rw [← Submodule.ideal_span_singleton_smul]
          exact Ideal.mul_top I)).toAddEquiv
      have hts_reg' : RingTheory.Sequence.IsWeaklyRegular (R ⧸ I)
          (ts.map (Ideal.Quotient.mk I)) := by
        refine (AddEquiv.isWeaklyRegular_congr (e := e_quot) ?_).mp hts_reg
        refine List.forall₂_iff_get.mpr ⟨rfl, fun idx _ _ m => ?_⟩
        obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ m
        simp only [List.get_eq_getElem, List.getElem_map]
        rfl
      have hmax_quot : Ideal.ofList (ts.map (Ideal.Quotient.mk I)) =
          IsLocalRing.maximalIdeal (R ⧸ I) := by
        have hmap_max : Ideal.map (Ideal.Quotient.mk I) (IsLocalRing.maximalIdeal R) =
            IsLocalRing.maximalIdeal (R ⧸ I) := by
          apply le_antisymm
          · rw [Ideal.map_le_iff_le_comap]
            intro x hx
            rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
            intro hu
            obtain ⟨y_bar, hy_bar⟩ := hu.exists_right_inv
            obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y_bar
            have h1 : x * y - 1 ∈ I := by
              apply Ideal.Quotient.eq_zero_iff_mem.mp
              rw [map_sub, map_mul, map_one, hy_bar, sub_self]
            have hxy_mem : x * y ∈ IsLocalRing.maximalIdeal R :=
              Ideal.mul_mem_right y _ hx
            have hneg1_mem : (-1 : R) ∈ IsLocalRing.maximalIdeal R := by
              have hsub := (IsLocalRing.maximalIdeal R).sub_mem (hI_le_max h1) hxy_mem
              rwa [sub_sub_cancel_left] at hsub
            exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
              ((Ideal.eq_top_iff_one _).mpr
                (by simpa using (IsLocalRing.maximalIdeal R).neg_mem hneg1_mem))
          · intro z hz
            obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
            refine Ideal.mem_map_of_mem _ ?_
            rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
            intro hux
            exact ((IsLocalRing.mem_maximalIdeal _).mp hz) (hux.map (Ideal.Quotient.mk I))
        rw [← hmap_max, ← hmax, Ideal.ofList_cons, Ideal.map_sup]
        have hmap_I : Ideal.map (Ideal.Quotient.mk I) I = ⊥ := by
          rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
        have hmap_list : ∀ (L₀ : List R),
            Ideal.map (Ideal.Quotient.mk I) (Ideal.ofList L₀) =
              Ideal.ofList (L₀.map (Ideal.Quotient.mk I)) := by
          intro L₀
          induction L₀ with
          | nil => simp
          | cons a as ihas =>
            rw [List.map_cons, Ideal.ofList_cons, Ideal.ofList_cons, Ideal.map_sup,
              Ideal.map_span, Set.image_singleton, ihas]
        rw [hmap_I, bot_sup_eq, hmap_list]
      have hDom_quot : IsDomain (R ⧸ I) :=
        ih (R ⧸ I) (ts.map (Ideal.Quotient.mk I)) (by rw [List.length_map, hlen]) hts_reg' hmax_quot
      have hI_prime : I.IsPrime := (Ideal.Quotient.isDomain_iff_prime I).mp hDom_quot
      have hkrull := Ideal.iInf_pow_eq_bot_of_isLocalRing I hI_ne_top
      have hex_ord : ∀ x : R, x ≠ 0 → ∃ m : ℕ, x ∈ I ^ m ∧ x ∉ I ^ (m + 1) := by
        intro x hx
        have hnot_iInf : x ∉ (⨅ i : ℕ, I ^ i) := by
          rw [hkrull, Submodule.mem_bot]
          exact hx
        rw [Ideal.mem_iInf] at hnot_iInf
        have hex_not : ∃ i : ℕ, x ∉ I ^ i := by
          by_contra hall
          exact hnot_iInf fun i => of_not_not fun hni => hall ⟨i, hni⟩
        let k₀ := Nat.find hex_not
        have hk₀_spec : x ∉ I ^ k₀ := Nat.find_spec hex_not
        have hk₀_pos : 1 ≤ k₀ := by
          rcases Nat.eq_zero_or_pos k₀ with h0 | hpos
          · exfalso
            apply hk₀_spec
            rw [h0, pow_zero, Ideal.one_eq_top]
            trivial
          · exact hpos
        refine ⟨k₀ - 1, ?_, ?_⟩
        · exact of_not_not (Nat.find_min hex_not (by omega))
        · rwa [Nat.sub_add_cancel hk₀_pos]
      refine @NoZeroDivisors.to_isDomain R _ _ ⟨fun {x y} hxy => ?_⟩
      by_contra hnot
      have hx_ne : x ≠ 0 := fun hx0 => hnot (Or.inl hx0)
      have hy_ne : y ≠ 0 := fun hy0 => hnot (Or.inr hy0)
      obtain ⟨a, hxa, hxa1⟩ := hex_ord x hx_ne
      obtain ⟨b, hyb, hyb1⟩ := hex_ord y hy_ne
      rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hxa hyb
      obtain ⟨x', rfl⟩ := hxa
      obtain ⟨y', rfl⟩ := hyb
      have hx'_not : x' ∉ I := by
        intro hx'I
        rw [Ideal.mem_span_singleton] at hx'I
        obtain ⟨z, rfl⟩ := hx'I
        apply hxa1
        rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        exact ⟨z, by ring⟩
      have hy'_not : y' ∉ I := by
        intro hy'I
        rw [Ideal.mem_span_singleton] at hy'I
        obtain ⟨z, rfl⟩ := hy'I
        apply hyb1
        rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        exact ⟨z, by ring⟩
      have hxy'_not : x' * y' ∉ I := fun hmem =>
        (hI_prime.mem_or_mem hmem).elim hx'_not hy'_not
      have hxy'_ne : x' * y' ≠ 0 := by
        intro h0
        apply hxy'_not
        rw [h0]
        exact I.zero_mem
      have hreg_pow : IsSMulRegular R (t ^ (a + b)) := ht_reg.pow (a + b)
      have hprod0 : t ^ (a + b) • (x' * y') = t ^ (a + b) • (0 : R) := by
        simp only [smul_eq_mul, mul_zero]
        calc t ^ (a + b) * (x' * y') = (t ^ a * x') * (t ^ b * y') := by ring
          _ = 0 := hxy
      exact hxy'_ne (hreg_pow hprod0)

  have helper_stdSmoothLocal :
      ∀ (d : ℕ) (S : Type u) [CommRing S] (f : k →+* S),
        RingHom.IsStandardSmoothOfRelativeDimension d f →
        (∀ 𝔮 : PrimeSpectrum S, IsDomain (Localization.AtPrime 𝔮.asIdeal)) ∧
        (∀ 𝔮 : PrimeSpectrum S, ∃ U_spec : Set (PrimeSpectrum S),
          IsOpen U_spec ∧ 𝔮 ∈ U_spec ∧ IsIrreducible U_spec) ∧
        (Nontrivial S → ringKrullDim S = (d : WithBot ℕ∞)) := by
    intro d S _ f hf
    obtain ⟨g, hg_comp, hg_et⟩ := hf.exists_etale_mvPolynomial
    let : Algebra k S := f.toAlgebra
    let : Algebra (MvPolynomial (Fin d) k) S := g.toAlgebra
    have : IsScalarTower k (MvPolynomial (Fin d) k) S :=
      IsScalarTower.of_algebraMap_eq fun c => (RingHom.congr_fun hg_comp c).symm
    have : Algebra.Etale (MvPolynomial (Fin d) k) S :=
      RingHom.etale_algebraMap.mp hg_et
    have : Algebra.FiniteType k S :=
      Algebra.FiniteType.trans
        (inferInstance : Algebra.FiniteType k (MvPolynomial (Fin d) k))
        inferInstance
    have : IsNoetherianRing k :=
      (isNoetherianRing_iff_ideal_fg k).mpr fun I => by
        rcases Ideal.eq_bot_or_top I with rfl | rfl
        · exact Submodule.fg_bot
        · exact ⟨{1}, by rw [Finset.coe_singleton]; exact Ideal.span_singleton_one⟩
    have : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing k S
    have hMaximalLocal : ∀ (𝔪 : Ideal S) [h𝔪 : 𝔪.IsMaximal],
        IsDomain (Localization.AtPrime 𝔪) ∧
        ringKrullDim (Localization.AtPrime 𝔪) = (d : WithBot ℕ∞) := by
      intro 𝔪 h𝔪
      let : Field (S ⧸ 𝔪) := Ideal.Quotient.field 𝔪
      obtain ⟨s_fin, hs_top⟩ := (‹Algebra.FiniteType k S›).out
      let ψ : MvPolynomial ↥s_fin k →ₐ[k] S := MvPolynomial.aeval Subtype.val
      have hψ_surj : Function.Surjective ψ := by
        rw [← AlgHom.range_eq_top, MvPolynomial.aeval_range, Subtype.range_coe]
        exact hs_top
      let π_ψ : MvPolynomial ↥s_fin k →ₐ[k] (S ⧸ 𝔪) :=
        (Ideal.Quotient.mkₐ k 𝔪).comp ψ
      have hπψ_surj : Function.Surjective π_ψ :=
        Ideal.Quotient.mk_surjective.comp hψ_surj
      have hker_max : (RingHom.ker π_ψ.toRingHom).IsMaximal := by
        rw [Ideal.Quotient.maximal_ideal_iff_isField_quotient]
        exact (RingHom.quotientKerEquivOfSurjective (f := π_ψ.toRingHom) hπψ_surj).toMulEquiv.isField
          (Field.toIsField (S ⧸ 𝔪))
      obtain ⟨b_pt, hb_pt⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (K := k)).mp hker_max
      have hk_surj : Function.Surjective (algebraMap k (S ⧸ 𝔪)) := by
        intro z
        obtain ⟨Q, rfl⟩ := hπψ_surj z
        refine ⟨MvPolynomial.eval b_pt Q, ?_⟩
        have hdiff_mem : Q - MvPolynomial.C (MvPolynomial.eval b_pt Q) ∈
            RingHom.ker π_ψ.toRingHom := by
          rw [hb_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
          simp [MvPolynomial.aeval_def]
        rw [RingHom.mem_ker] at hdiff_mem
        have hsub0 : π_ψ Q - π_ψ (MvPolynomial.C (MvPolynomial.eval b_pt Q)) = 0 := by
          simpa [map_sub] using hdiff_mem
        have heq_π : π_ψ (MvPolynomial.C (MvPolynomial.eval b_pt Q)) = π_ψ Q :=
          (sub_eq_zero.mp hsub0).symm
        have hcomm : π_ψ (MvPolynomial.C (MvPolynomial.eval b_pt Q)) =
            algebraMap k (S ⧸ 𝔪) (MvPolynomial.eval b_pt Q) :=
          π_ψ.commutes (MvPolynomial.eval b_pt Q)
        exact hcomm.symm.trans heq_π
      let 𝔭 : Ideal (MvPolynomial (Fin d) k) := Ideal.comap g 𝔪
      have : 𝔭.IsPrime := Ideal.comap_isPrime g 𝔪
      have hex_a : ∀ i : Fin d, ∃ c : k, MvPolynomial.X i - MvPolynomial.C c ∈ 𝔭 := by
        intro i
        obtain ⟨c, hc⟩ := hk_surj (Ideal.Quotient.mk 𝔪 (g (MvPolynomial.X i)))
        refine ⟨c, ?_⟩
        rw [Ideal.mem_comap, map_sub, ← Ideal.Quotient.eq_zero_iff_mem, map_sub]
        have hc' : Ideal.Quotient.mk 𝔪 (g (MvPolynomial.C c)) = Ideal.Quotient.mk 𝔪 (f c) := by
          congr 1
          exact RingHom.congr_fun hg_comp c
        rw [hc']
        exact sub_eq_zero.mpr hc.symm
      let a : Fin d → k := fun i => Classical.choose (hex_a i)
      have ha_mem : ∀ i : Fin d, MvPolynomial.X i - MvPolynomial.C (a i) ∈ 𝔭 :=
        fun i => Classical.choose_spec (hex_a i)
      let L_P : List (MvPolynomial (Fin d) k) :=
        (List.finRange d).map (fun i : Fin d => MvPolynomial.X i - MvPolynomial.C (a i))
      have h𝔭_eq : 𝔭 = Ideal.ofList L_P := by
        have hofList_eq : Ideal.ofList L_P =
            Ideal.span (Set.range fun i : Fin d => MvPolynomial.X i - MvPolynomial.C (a i)) := by
          have haux : ∀ (xs : List (MvPolynomial (Fin d) k)),
              Ideal.ofList xs = Ideal.span { x | x ∈ xs } := by
            intro xs
            induction xs with
            | nil => simp
            | cons x xs ih =>
              rw [Ideal.ofList_cons, ih, ← Ideal.span_union]
              congr 1
              ext y
              simp
          rw [haux]
          congr 1
          ext y
          simp [L_P]
        rw [hofList_eq]
        apply le_antisymm
        · intro Q hQ
          have hdiff : Q - MvPolynomial.C (MvPolynomial.eval a Q) ∈
              Ideal.span (Set.range fun i : Fin d => MvPolynomial.X i - MvPolynomial.C (a i)) := by
            refine MvPolynomial.induction_on
              (motive := fun Q => Q - MvPolynomial.C (MvPolynomial.eval a Q) ∈
                Ideal.span (Set.range fun i : Fin d => MvPolynomial.X i - MvPolynomial.C (a i)))
              Q ?_ ?_ ?_
            · intro c
              simp
            · intro p₁ p₂ hp₁ hp₂
              have h1 : (p₁ + p₂) - MvPolynomial.C (MvPolynomial.eval a (p₁ + p₂)) =
                  (p₁ - MvPolynomial.C (MvPolynomial.eval a p₁)) +
                  (p₂ - MvPolynomial.C (MvPolynomial.eval a p₂)) := by
                simp only [map_add]
                ring
              rw [h1]
              exact Ideal.add_mem _ hp₁ hp₂
            · intro p₁ i hp₁
              have h1 : p₁ * MvPolynomial.X i - MvPolynomial.C (MvPolynomial.eval a (p₁ * MvPolynomial.X i)) =
                  p₁ * (MvPolynomial.X i - MvPolynomial.C (a i)) +
                  (p₁ - MvPolynomial.C (MvPolynomial.eval a p₁)) * MvPolynomial.C (a i) := by
                simp only [map_mul, MvPolynomial.eval_X]
                ring
              rw [h1]
              exact Ideal.add_mem _
                (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))
                (Ideal.mul_mem_right _ _ hp₁)
          have hsub_𝔭 : Ideal.span (Set.range fun i : Fin d =>
              MvPolynomial.X i - MvPolynomial.C (a i)) ≤ 𝔭 := by
            rw [Ideal.span_le]
            rintro _ ⟨i, rfl⟩
            exact ha_mem i
          have hC_mem : MvPolynomial.C (MvPolynomial.eval a Q) ∈ 𝔭 := by
            have := 𝔭.sub_mem hQ (hsub_𝔭 hdiff)
            simpa using this
          have heval0 : MvPolynomial.eval a Q = 0 := by
            by_contra hne
            have h1_mem : (1 : MvPolynomial (Fin d) k) ∈ 𝔭 := by
              have := 𝔭.mul_mem_left (MvPolynomial.C (MvPolynomial.eval a Q)⁻¹) hC_mem
              rwa [← map_mul, inv_mul_cancel₀ hne, map_one] at this
            exact ‹𝔭.IsPrime›.ne_top ((Ideal.eq_top_iff_one _).mpr h1_mem)
          simpa [heval0] using hdiff
        · rw [Ideal.span_le]
          rintro _ ⟨i, rfl⟩
          exact ha_mem i
      let g_loc : Localization.AtPrime 𝔭 →+* Localization.AtPrime 𝔪 :=
        Localization.localRingHom 𝔭 𝔪 g rfl
      let : Algebra (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔪) := g_loc.toAlgebra
      have : IsScalarTower (MvPolynomial (Fin d) k) (Localization.AtPrime 𝔭)
          (Localization.AtPrime 𝔪) :=
        { smul_assoc := fun x y z => by
            rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def,
              map_mul, mul_assoc]
            congr 1
            have h1 : (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔪))
                ((algebraMap (MvPolynomial (Fin d) k) (Localization.AtPrime 𝔭)) x) =
                (algebraMap S (Localization.AtPrime 𝔪)) (g x) :=
              Localization.localRingHom_to_map 𝔭 𝔪 g rfl x
            rw [h1]
            rfl }
      have : IsLocalHom (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔪)) :=
        Localization.isLocalHom_localRingHom 𝔭 𝔪 g rfl
      have : Algebra.FormallyUnramified S (Localization.AtPrime 𝔪) :=
        Algebra.FormallyUnramified.of_isLocalization 𝔪.primeCompl
      have : Algebra.FormallyUnramified (MvPolynomial (Fin d) k) (Localization.AtPrime 𝔪) :=
        Algebra.FormallyUnramified.comp (MvPolynomial (Fin d) k) S (Localization.AtPrime 𝔪)
      have : Algebra.FormallyUnramified (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔪) :=
        Algebra.FormallyUnramified.localization_base 𝔭.primeCompl
      have : Algebra.EssFiniteType S (Localization.AtPrime 𝔪) :=
        Algebra.EssFiniteType.of_isLocalization (Localization.AtPrime 𝔪) 𝔪.primeCompl
      have : Algebra.EssFiniteType (MvPolynomial (Fin d) k) (Localization.AtPrime 𝔪) :=
        Algebra.EssFiniteType.comp (MvPolynomial (Fin d) k) S (Localization.AtPrime 𝔪)
      have : Algebra.EssFiniteType (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔪) :=
        Algebra.EssFiniteType.of_comp (MvPolynomial (Fin d) k)
          (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔪)
      have : Module.Flat S (Localization.AtPrime 𝔪) :=
        IsLocalization.flat (Localization.AtPrime 𝔪) 𝔪.primeCompl
      have : Module.Flat (MvPolynomial (Fin d) k) (Localization.AtPrime 𝔪) :=
        Module.Flat.trans (MvPolynomial (Fin d) k) S (Localization.AtPrime 𝔪)
      have : IsNoetherianRing (Localization.AtPrime 𝔪) :=
        IsLocalization.isNoetherianRing 𝔪.primeCompl (Localization.AtPrime 𝔪) inferInstance
      let L_R : List (Localization.AtPrime 𝔪) :=
        L_P.map (algebraMap (MvPolynomial (Fin d) k) (Localization.AtPrime 𝔪))
      have hReg_tens : RingTheory.Sequence.IsWeaklyRegular
          (TensorProduct (MvPolynomial (Fin d) k) (Localization.AtPrime 𝔪) (MvPolynomial (Fin d) k))
          L_R :=
        RingTheory.Sequence.IsWeaklyRegular.of_flat_of_isBaseChange
          (TensorProduct.isBaseChange (MvPolynomial (Fin d) k)
            (MvPolynomial (Fin d) k) (Localization.AtPrime 𝔪))
          (helper_mvPolyReg d a)
      have hReg_R : RingTheory.Sequence.IsWeaklyRegular (Localization.AtPrime 𝔪) L_R :=
        (TensorProduct.AlgebraTensorModule.rid (MvPolynomial (Fin d) k)
          (Localization.AtPrime 𝔪) (Localization.AtPrime 𝔪)).isWeaklyRegular_congr L_R |>.mp
          hReg_tens
      have hmap_ofList : ∀ (xs : List (MvPolynomial (Fin d) k)),
          Ideal.map (algebraMap (MvPolynomial (Fin d) k) (Localization.AtPrime 𝔪))
            (Ideal.ofList xs) =
          Ideal.ofList (xs.map (algebraMap (MvPolynomial (Fin d) k) (Localization.AtPrime 𝔪))) := by
        intro xs
        induction xs with
        | nil => simp
        | cons x xs ih =>
          rw [List.map_cons, Ideal.ofList_cons, Ideal.ofList_cons, Ideal.map_sup,
            Ideal.map_span, Set.image_singleton, ih]
      have hmax_R : Ideal.ofList L_R = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪) := by
        have hunram := Algebra.FormallyUnramified.map_maximalIdeal
          (R := Localization.AtPrime 𝔭) (S := Localization.AtPrime 𝔪)
        have hmax_𝔭 : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) =
            Ideal.map (algebraMap (MvPolynomial (Fin d) k) (Localization.AtPrime 𝔭)) 𝔭 :=
          (IsLocalization.AtPrime.map_eq_maximalIdeal 𝔭 (Localization.AtPrime 𝔭)).symm
        rw [hmax_𝔭, Ideal.map_map, ← IsScalarTower.algebraMap_eq
          (MvPolynomial (Fin d) k) (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔪),
          h𝔭_eq, hmap_ofList] at hunram
        exact hunram
      have hlen_R : L_R.length = d := by
        simp [L_R, L_P]
      have hDom_R : IsDomain (Localization.AtPrime 𝔪) :=
        helper_localRegDomain d (Localization.AtPrime 𝔪) L_R hlen_R hReg_R hmax_R
      have hsub_max : ∀ r ∈ L_R, r ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪) := by
        rw [← hmax_R]
        have hmem_ofList : ∀ (xs : List (Localization.AtPrime 𝔪)),
            ∀ r ∈ xs, r ∈ Ideal.ofList xs := by
          intro xs
          induction xs with
          | nil => intro r hr; simp at hr
          | cons x xs ih =>
            intro r hr
            rw [Ideal.ofList_cons]
            rcases List.mem_cons.mp hr with rfl | hrs
            · exact Ideal.mem_sup_left (Ideal.subset_span rfl)
            · exact Ideal.mem_sup_right (ih r hrs)
        exact hmem_ofList L_R
      have hIsReg_R : RingTheory.Sequence.IsRegular (Localization.AtPrime 𝔪) L_R :=
        (IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal hsub_max).mpr hReg_R
      have hdim_R : ringKrullDim (Localization.AtPrime 𝔪) = (d : WithBot ℕ∞) := by
        have hadd := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular L_R hIsReg_R
        rw [hmax_R, hlen_R] at hadd
        let : Field (Localization.AtPrime 𝔪 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) :=
          Ideal.Quotient.field _
        rw [ringKrullDim_eq_zero_of_field, zero_add] at hadd
        exact hadd.symm
      exact ⟨hDom_R, hdim_R⟩
    have hAtPrimeDom : ∀ 𝔮 : PrimeSpectrum S, IsDomain (Localization.AtPrime 𝔮.asIdeal) := by
      intro 𝔮
      obtain ⟨𝔪, h𝔪_max, h𝔮_le⟩ := Ideal.exists_le_maximal 𝔮.asIdeal 𝔮.isPrime.ne_top
      have : 𝔪.IsMaximal := h𝔪_max
      have : IsDomain (Localization.AtPrime 𝔪) := (hMaximalLocal 𝔪).1
      let Q_pair := (IsLocalization.AtPrime.orderIsoOfPrime (Localization.AtPrime 𝔪) 𝔪).symm
        ⟨𝔮.asIdeal, 𝔮.isPrime, h𝔮_le⟩
      let Q : Ideal (Localization.AtPrime 𝔪) := Q_pair.1
      have : Q.IsPrime := Q_pair.2
      have hQ_comap : Ideal.comap (algebraMap S (Localization.AtPrime 𝔪)) Q = 𝔮.asIdeal := by
        have h1 := (IsLocalization.AtPrime.orderIsoOfPrime (Localization.AtPrime 𝔪) 𝔪).apply_symm_apply
          ⟨𝔮.asIdeal, 𝔮.isPrime, h𝔮_le⟩
        exact congrArg Subtype.val h1
      have : IsDomain (Localization.AtPrime Q) :=
        IsLocalization.isDomain_of_local_atPrime ‹Q.IsPrime›
      have : IsLocalization.AtPrime (Localization.AtPrime Q)
          (Ideal.comap (algebraMap S (Localization.AtPrime 𝔪)) Q) :=
        IsLocalization.isLocalization_atPrime_localization_atPrime 𝔪.primeCompl Q
      let e_loc : Localization.AtPrime (Ideal.comap (algebraMap S (Localization.AtPrime 𝔪)) Q) ≃ₐ[S]
          Localization.AtPrime Q :=
        IsLocalization.algEquiv
          (Ideal.comap (algebraMap S (Localization.AtPrime 𝔪)) Q).primeCompl _ _
      have hDom_comap : IsDomain
          (Localization.AtPrime (Ideal.comap (algebraMap S (Localization.AtPrime 𝔪)) Q)) :=
        e_loc.toMulEquiv.isDomain (Localization.AtPrime Q)
      have hDom_eq : ∀ (I₁ I₂ : Ideal S) [I₁.IsPrime] [I₂.IsPrime],
          I₁ = I₂ → IsDomain (Localization.AtPrime I₁) → IsDomain (Localization.AtPrime I₂) := by
        intro I₁ I₂ h₁ h₂ heq hD
        subst heq
        convert hD
      exact hDom_eq _ 𝔮.asIdeal hQ_comap hDom_comap
    have hOpenIrred : ∀ 𝔮 : PrimeSpectrum S, ∃ U_spec : Set (PrimeSpectrum S),
        IsOpen U_spec ∧ 𝔮 ∈ U_spec ∧ IsIrreducible U_spec := by
      intro 𝔮
      have huniq_min : ∀ (𝔮' : PrimeSpectrum S) (p₁ p₂ : Ideal S),
          p₁ ∈ minimalPrimes S → p₂ ∈ minimalPrimes S →
          p₁ ≤ 𝔮'.asIdeal → p₂ ≤ 𝔮'.asIdeal → p₁ = p₂ := by
        intro 𝔮' p₁ p₂ hp₁ hp₂ hp₁_le hp₂_le
        have : IsDomain (Localization.AtPrime 𝔮'.asIdeal) := hAtPrimeDom 𝔮'
        have hp₁_pr : p₁.IsPrime := hp₁.1.1
        have hp₂_pr : p₂.IsPrime := hp₂.1.1
        let iso_𝔮' := IsLocalization.AtPrime.orderIsoOfPrime (Localization.AtPrime 𝔮'.asIdeal) 𝔮'.asIdeal
        let P₁ := iso_𝔮'.symm ⟨p₁, hp₁_pr, hp₁_le⟩
        let P₂ := iso_𝔮'.symm ⟨p₂, hp₂_pr, hp₂_le⟩
        have hP₁_bot : P₁.1 = ⊥ := by
          have hbot_pr : (⊥ : Ideal (Localization.AtPrime 𝔮'.asIdeal)).IsPrime := inferInstance
          let B₀ := iso_𝔮' ⟨⊥, hbot_pr⟩
          have hB₀_le : B₀.1 ≤ p₁ := by
            have hle_symm : (⟨⊥, hbot_pr⟩ : { p : Ideal (Localization.AtPrime 𝔮'.asIdeal) // p.IsPrime }) ≤ P₁ :=
              Subtype.mk_le_mk.mpr bot_le
            have hm := iso_𝔮'.monotone hle_symm
            dsimp [P₁] at hm
            rw [iso_𝔮'.apply_symm_apply] at hm
            exact Subtype.mk_le_mk.mp hm
          have hB₀_eq : B₀.1 = p₁ := le_antisymm hB₀_le (hp₁.2 ⟨B₀.2.1, bot_le⟩ hB₀_le)
          have hsub_eq : B₀ = ⟨p₁, hp₁_pr, hp₁_le⟩ := Subtype.ext hB₀_eq
          have hsym := (congrArg iso_𝔮'.symm hsub_eq).symm
          rw [iso_𝔮'.symm_apply_apply] at hsym
          exact congrArg Subtype.val hsym
        have hP₂_bot : P₂.1 = ⊥ := by
          have hbot_pr : (⊥ : Ideal (Localization.AtPrime 𝔮'.asIdeal)).IsPrime := inferInstance
          let B₀ := iso_𝔮' ⟨⊥, hbot_pr⟩
          have hB₀_le : B₀.1 ≤ p₂ := by
            have hle_symm : (⟨⊥, hbot_pr⟩ : { p : Ideal (Localization.AtPrime 𝔮'.asIdeal) // p.IsPrime }) ≤ P₂ :=
              Subtype.mk_le_mk.mpr bot_le
            have hm := iso_𝔮'.monotone hle_symm
            dsimp [P₂] at hm
            rw [iso_𝔮'.apply_symm_apply] at hm
            exact Subtype.mk_le_mk.mp hm
          have hB₀_eq : B₀.1 = p₂ := le_antisymm hB₀_le (hp₂.2 ⟨B₀.2.1, bot_le⟩ hB₀_le)
          have hsub_eq : B₀ = ⟨p₂, hp₂_pr, hp₂_le⟩ := Subtype.ext hB₀_eq
          have hsym := (congrArg iso_𝔮'.symm hsub_eq).symm
          rw [iso_𝔮'.symm_apply_apply] at hsym
          exact congrArg Subtype.val hsym
        have hP_eq : P₁ = P₂ := Subtype.ext (hP₁_bot.trans hP₂_bot.symm)
        have := congrArg iso_𝔮' hP_eq
        simpa [P₁, P₂] using congrArg Subtype.val this
      obtain ⟨p₀, hp₀_min, hp₀_le⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ 𝔮.asIdeal)
      have hp₀_pr : p₀.IsPrime := hp₀_min.1.1
      let U_spec : Set (PrimeSpectrum S) := PrimeSpectrum.zeroLocus (p₀ : Set S)
      have hFin_other : (minimalPrimes S \ {p₀}).Finite :=
        (minimalPrimes.finite_of_isNoetherianRing S).sdiff
      have hU_compl : U_spec =
          (⋃ p' ∈ minimalPrimes S \ {p₀}, PrimeSpectrum.zeroLocus (p' : Set S))ᶜ := by
        ext 𝔮'
        simp only [U_spec, PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, Set.mem_compl_iff,
          Set.mem_iUnion, exists_prop, not_exists, not_and]
        constructor
        · intro hp₀_q' p' hp'_diff hp'_q'
          exact hp'_diff.2 (huniq_min 𝔮' p' p₀ hp'_diff.1 hp₀_min hp'_q' hp₀_q')
        · intro hall
          obtain ⟨p', hp'_min, hp'_q'⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ 𝔮'.asIdeal)
          by_cases hp'0 : p' = p₀
          · rwa [← hp'0]
          · exfalso
            exact hall p' ⟨hp'_min, hp'0⟩ hp'_q'
      have hOpen : IsOpen U_spec := by
        rw [hU_compl, isOpen_compl_iff]
        exact hFin_other.isClosed_biUnion fun p' _ => PrimeSpectrum.isClosed_zeroLocus _
      have hmem : 𝔮 ∈ U_spec := by
        simpa [U_spec, PrimeSpectrum.mem_zeroLocus] using hp₀_le
      have hIrred : IsIrreducible U_spec :=
        (PrimeSpectrum.isIrreducible_zeroLocus_iff_of_radical p₀ hp₀_pr.isRadical).mpr hp₀_pr
      exact ⟨U_spec, hOpen, hmem, hIrred⟩
    refine ⟨hAtPrimeDom, hOpenIrred, fun hNontriv => ?_⟩
    let : Nontrivial S := hNontriv
    obtain ⟨𝔪₀, h𝔪₀⟩ := Ideal.exists_maximal S
    have : 𝔪₀.IsMaximal := h𝔪₀
    apply le_antisymm
    · rw [show ringKrullDim S = Order.krullDim (PrimeSpectrum S) from rfl]
      have : Nonempty (PrimeSpectrum S) := ⟨⟨𝔪₀, h𝔪₀.isPrime⟩⟩
      rw [Order.krullDim_eq_iSup_length]
      exact WithBot.coe_le_coe.mpr (iSup_le fun p_ser => by
        obtain ⟨𝔪, h𝔪_max, hlast_le⟩ :=
          Ideal.exists_le_maximal (p_ser (Fin.last p_ser.length)).asIdeal
            (p_ser (Fin.last p_ser.length)).isPrime.ne_top
        have : 𝔪.IsMaximal := h𝔪_max
        let iso_𝔪 := IsLocalization.AtPrime.orderIsoOfPrime (Localization.AtPrime 𝔪) 𝔪
        have hp_le : ∀ i : Fin (p_ser.length + 1), (p_ser i).asIdeal ≤ 𝔪 := by
          intro i
          have hmono : (p_ser i).asIdeal ≤ (p_ser (Fin.last p_ser.length)).asIdeal :=
            p_ser.monotone (Fin.le_last i)
          exact hmono.trans hlast_le
        let q_ser : LTSeries (PrimeSpectrum (Localization.AtPrime 𝔪)) :=
          { length := p_ser.length
            toFun := fun i =>
              let P_i := iso_𝔪.symm ⟨(p_ser i).asIdeal, (p_ser i).isPrime, hp_le i⟩
              ⟨P_i.1, P_i.2⟩
            step := fun i => by
              have hlt : (⟨(p_ser (Fin.castSucc i)).asIdeal, (p_ser (Fin.castSucc i)).isPrime,
                  hp_le (Fin.castSucc i)⟩ : { p : Ideal S // p.IsPrime ∧ p ≤ 𝔪 }) <
                ⟨(p_ser i.succ).asIdeal, (p_ser i.succ).isPrime, hp_le i.succ⟩ :=
                p_ser.step i
              exact iso_𝔪.symm.strictMono hlt }
        have hlen_le : (q_ser.length : WithBot ℕ∞) ≤ ringKrullDim (Localization.AtPrime 𝔪) :=
          Order.LTSeries.length_le_krullDim q_ser
        rw [(hMaximalLocal 𝔪).2] at hlen_le
        exact WithBot.coe_le_coe.mp hlen_le)
    · rw [← (hMaximalLocal 𝔪₀).2]
      let iso_𝔪₀ := IsLocalization.AtPrime.orderIsoOfPrime (Localization.AtPrime 𝔪₀) 𝔪₀
      exact Order.krullDim_le_of_strictMono
        (fun Q : PrimeSpectrum (Localization.AtPrime 𝔪₀) =>
          ⟨(iso_𝔪₀ ⟨Q.asIdeal, Q.isPrime⟩).1, (iso_𝔪₀ ⟨Q.asIdeal, Q.isPrime⟩).2.1⟩)
        (fun Q₁ Q₂ hlt => iso_𝔪₀.strictMono hlt)

  have helper_partB :
      ∀ (d : ℕ)
        (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.SmoothOfRelativeDimension d W.hom],
      ConnectedSpace ↥W.left →
      AlgebraicGeometry.IsIntegral W.left ∧
      topologicalKrullDim W.left = (d : WithBot ℕ∞) := by
    intro d W hSmW hConn
    have hSpec_sub : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := by
      change Subsingleton (PrimeSpectrum k)
      exact ⟨fun p₁ p₂ => PrimeSpectrum.ext (by
        have h1 : p₁.asIdeal = ⊥ := (Ideal.eq_bot_or_top p₁.asIdeal).resolve_right p₁.isPrime.ne_top
        have h2 : p₂.asIdeal = ⊥ := (Ideal.eq_bot_or_top p₂.asIdeal).resolve_right p₂.isPrime.ne_top
        exact h1.trans h2.symm)⟩
    have hChartPkg : ∀ x : W.left,
        ∃ (V : W.left.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V) (hxV : x ∈ V)
          (f_V : k →+* ↑(W.left.presheaf.obj (Opposite.op V))),
          RingHom.IsStandardSmoothOfRelativeDimension d f_V := by
      intro x
      obtain ⟨U, _, V, hAffV, hxV, hle, hStd⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff d W.hom).mp hSmW x
      have hU_top : U = ⊤ := by
        ext p
        simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        have hp_eq : p = W.hom.base x := hSpec_sub.elim p (W.hom.base x)
        rw [hp_eq]
        exact hle hxV
      subst hU_top
      let iso_k : CommRingCat.of k ≅ (AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm
      let f_V : k →+* ↑(W.left.presheaf.obj (Opposite.op V)) :=
        (iso_k.hom ≫ W.hom.appLE ⊤ V hle).hom
      have hStd_fV : RingHom.IsStandardSmoothOfRelativeDimension d f_V :=
        (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso d).right
          (W.hom.appLE ⊤ V hle).hom iso_k.commRingCatIsoToRingEquiv hStd
      exact ⟨V, hAffV, hxV, f_V, hStd_fV⟩
    have hRed : AlgebraicGeometry.IsReduced W.left := by
      refine @AlgebraicGeometry.isReduced_of_isReduced_stalk W.left fun x => ?_
      obtain ⟨V, hAffV, hxV, f_V, hStd_fV⟩ := hChartPkg x
      obtain ⟨hDom_stalk, _, _⟩ := helper_stdSmoothLocal d _ f_V hStd_fV
      let xV : ↥V := ⟨x, hxV⟩
      let p_x : PrimeSpectrum ↑(W.left.presheaf.obj (Opposite.op V)) := hAffV.primeIdealOf xV
      have : IsDomain (Localization.AtPrime p_x.asIdeal) := hDom_stalk p_x
      let : Algebra ↑(W.left.presheaf.obj (Opposite.op V)) ↑(W.left.presheaf.stalk x) :=
        TopCat.Presheaf.algebra_section_stalk W.left.presheaf xV
      have : IsLocalization.AtPrime ↑(W.left.presheaf.stalk x) p_x.asIdeal :=
        hAffV.isLocalization_stalk xV
      let e_stalk : Localization.AtPrime p_x.asIdeal ≃ₐ[↑(W.left.presheaf.obj (Opposite.op V))]
          ↑(W.left.presheaf.stalk x) :=
        IsLocalization.algEquiv p_x.asIdeal.primeCompl _ _
      have : IsDomain ↑(W.left.presheaf.stalk x) :=
        e_stalk.toMulEquiv.symm.isDomain (Localization.AtPrime p_x.asIdeal)
      infer_instance
    have hOpenIrredNhds : ∀ x : W.left, ∃ U_x : Set W.left,
        IsOpen U_x ∧ x ∈ U_x ∧ IsIrreducible U_x := by
      intro x
      obtain ⟨V, hAffV, hxV, f_V, hStd_fV⟩ := hChartPkg x
      obtain ⟨_, hOpenIrred_V, _⟩ := helper_stdSmoothLocal d _ f_V hStd_fV
      let xV : ↥V := ⟨x, hxV⟩
      obtain ⟨U_spec, hOpen_spec, hx_spec, hIrred_spec⟩ :=
        hOpenIrred_V (hAffV.primeIdealOf xV)
      have hx_from : hAffV.fromSpec.base (hAffV.primeIdealOf xV) = x := by
        exact hAffV.fromSpec_primeIdealOf xV
      refine ⟨hAffV.fromSpec.base '' U_spec,
        hAffV.fromSpec.isOpenEmbedding.isOpenMap U_spec hOpen_spec,
        ⟨hAffV.primeIdealOf xV, hx_spec, hx_from⟩,
        hIrred_spec.image _ hAffV.fromSpec.continuous.continuousOn⟩
    obtain ⟨x₀⟩ : Nonempty ↥W.left := hConn.toNonempty
    let C₀ : Set ↥W.left := irreducibleComponent x₀
    have hC₀_open : IsOpen C₀ := by
      rw [isOpen_iff_forall_mem_open]
      intro y hy
      obtain ⟨U_y, hUy_open, hy_Uy, hUy_irred⟩ := hOpenIrredNhds y
      refine ⟨U_y, ?_, hUy_open, hy_Uy⟩
      have hPre_C₀ : IsPreirreducible C₀ := (irreducibleComponent_property x₀).1
      have hsub_union : C₀ ⊆ closure U_y ∪ U_yᶜ := by
        intro z _
        by_cases hz : z ∈ U_y
        · exact Or.inl (subset_closure hz)
        · exact Or.inr hz
      rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hPre_C₀)
          (closure U_y) U_yᶜ isClosed_closure hUy_open.isClosed_compl hsub_union with hsub_cl | hsub_compl
      · have hcl_eq : closure U_y = C₀ :=
          (irreducibleComponent_property x₀).2.2 (closure U_y)
            hUy_irred.closure.isPreirreducible hsub_cl
        exact subset_closure.trans hcl_eq.le
      · exfalso
        exact (hsub_compl hy) hy_Uy
    have hC₀_clopen : IsClopen C₀ := ⟨isClosed_irreducibleComponent, hC₀_open⟩
    have hC₀_univ : C₀ = Set.univ := by
      rcases isClopen_iff.mp hC₀_clopen with h_emp | h_univ
      · exfalso
        have hx₀_C₀ : x₀ ∈ C₀ := mem_irreducibleComponent
        rw [h_emp] at hx₀_C₀
        exact hx₀_C₀
      · exact h_univ
    have : IrreducibleSpace ↥W.left :=
      { isPreirreducible_univ := hC₀_univ ▸ (irreducibleComponent_property x₀).1
        toNonempty := ⟨x₀⟩ }
    have hIntW : AlgebraicGeometry.IsIntegral W.left :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced W.left
    refine ⟨hIntW, ?_⟩
    have hChartDim : ∀ x : W.left, ∃ V : W.left.Opens,
        x ∈ V ∧ topologicalKrullDim ↥V = (d : WithBot ℕ∞) := by
      intro x
      obtain ⟨V, hAffV, hxV, f_V, hStd_fV⟩ := hChartPkg x
      obtain ⟨_, _, hDim_S⟩ := helper_stdSmoothLocal d _ f_V hStd_fV
      have hNontriv_V : Nontrivial ↑(W.left.presheaf.obj (Opposite.op V)) :=
        PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨hAffV.primeIdealOf ⟨x, hxV⟩⟩
      let e_homeo : ↥V.toScheme ≃ₜ PrimeSpectrum ↑(W.left.presheaf.obj (Opposite.op V)) :=
        { toFun := hAffV.isoSpec.hom.base
          invFun := hAffV.isoSpec.inv.base
          left_inv := fun y => by
            show (hAffV.isoSpec.hom ≫ hAffV.isoSpec.inv).base y = y
            rw [hAffV.isoSpec.hom_inv_id]
            rfl
          right_inv := fun q => by
            show (hAffV.isoSpec.inv ≫ hAffV.isoSpec.hom).base q = q
            rw [hAffV.isoSpec.inv_hom_id]
            rfl
          continuous_toFun := hAffV.isoSpec.hom.continuous
          continuous_invFun := hAffV.isoSpec.inv.continuous }
      refine ⟨V, hxV, ?_⟩
      change topologicalKrullDim ↥V.toScheme = (d : WithBot ℕ∞)
      rw [e_homeo.isHomeomorph.topologicalKrullDim_eq,
        PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim, hDim_S hNontriv_V]
    apply le_antisymm
    · change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥W.left) ≤ (d : WithBot ℕ∞)
      have : Nonempty (TopologicalSpace.IrreducibleCloseds ↥W.left) :=
        ⟨⟨closure {x₀}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
      rw [Order.krullDim_eq_iSup_length]
      exact WithBot.coe_le_coe.mpr (iSup_le fun p_ser => by
        obtain ⟨y₀, hy₀_mem⟩ := (p_ser 0).isIrreducible'.1
        obtain ⟨V, hy₀V, hV_dim⟩ := hChartDim y₀
        let q_ser : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V) :=
          { length := p_ser.length
            toFun := fun i =>
              { carrier := (Subtype.val : ↥V → ↥W.left) ⁻¹' (p_ser i).carrier
                isIrreducible' := ⟨⟨⟨y₀, hy₀V⟩, (p_ser.monotone (Fin.zero_le i)) hy₀_mem⟩,
                  (p_ser i).isIrreducible'.2.preimage V.isOpen.isOpenEmbedding_subtypeVal⟩
                isClosed' := (p_ser i).isClosed'.preimage continuous_subtype_val }
            step := fun i => by
