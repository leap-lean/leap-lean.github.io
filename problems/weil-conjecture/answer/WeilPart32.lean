  classical
  let _ : AlgebraicGeometry.IsIntegral Z_bar.left := hInt
  let A := ↑(Z_bar.left.presheaf.obj (Opposite.op V))
  let _ : Algebra k A := (φ.comp MvPolynomial.C).toAlgebra
  let X_full : Fin (M + 1) → A := α₀.insertNth 1 x_coord
  let d : ℕ := 2 * m + 2

  have hDomA : IsDomain A := AlgebraicGeometry.IsIntegral.component_integral V
  let _ : IsDomain A := hDomA

  obtain ⟨ψ_V, D_V, hψV_C, hψV_et, hFT, hTrdeg, hDV_X, hv_eq, hDerE⟩ :=
    weil_smooth_chart_etale_derivations_and_trdeg k M s d A α₀ φ q x_coord Ψ v
      hSurj hKer hDet0 hΨ hSchur

  let J_V : Matrix (Fin (d + 1)) (Fin (M + 1)) A :=
    Matrix.of (Fin.cases X_full (fun i μ => D_V i (X_full μ)))

  have hEtaleSpecV : ∀ (ψ : MvPolynomial (Fin d) k →+* A),
      ψ.Etale → ψ.comp MvPolynomial.C = φ.comp MvPolynomial.C →
      AlgebraicGeometry.Etale (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
      (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V.ι ≫ Z_bar.hom) := by
    intro ψ hψ_et hψ_C
    refine ⟨?_, ?_⟩
    · have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ_et
      have : CategoryTheory.IsIso V.toSpecΓ := by
        rw [← hAffV.isoSpec_hom]; infer_instance
      have : AlgebraicGeometry.Etale V.toSpecΓ := inferInstance
      infer_instance
    · rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ_C,
        CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
      exact hSpec

  have hLocalEquivPow : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂]
      [IsLocalRing R₁] [IsLocalRing R₂] (e : R₁ ≃+* R₂) (n : ℕ) (x : R₁),
      e x ∈ (IsLocalRing.maximalIdeal R₂) ^ n ↔ x ∈ (IsLocalRing.maximalIdeal R₁) ^ n := by
    have h_dir : ∀ {S₁ S₂ : Type u} [CommRing S₁] [CommRing S₂]
        [IsLocalRing S₁] [IsLocalRing S₂] (g : S₁ ≃+* S₂) (n : ℕ) (x : S₁),
        x ∈ (IsLocalRing.maximalIdeal S₁) ^ n → g x ∈ (IsLocalRing.maximalIdeal S₂) ^ n := by
      intro S₁ S₂ _ _ _ _ g n x hx
      have hmap_max : Ideal.map g.toRingHom (IsLocalRing.maximalIdeal S₁) ≤
          IsLocalRing.maximalIdeal S₂ := by
        rw [Ideal.map_le_iff_le_comap]
        intro y hy
        rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal]
        rw [IsLocalRing.mem_maximalIdeal] at hy
        intro hu
        apply hy
        have hu' := hu.map g.symm.toRingHom
        simpa using hu'
      have hpow_mono : ∀ m_pow : ℕ,
          (Ideal.map g.toRingHom (IsLocalRing.maximalIdeal S₁)) ^ m_pow ≤
            (IsLocalRing.maximalIdeal S₂) ^ m_pow := by
        intro m_pow
        induction m_pow with
        | zero => rw [pow_zero, pow_zero]
        | succ m_pow ih =>
          rw [pow_succ, pow_succ]
          exact Submodule.mul_le.mpr fun _ ha _ hb => Ideal.mul_mem_mul (ih ha) (hmap_max hb)
      have hmem := Ideal.mem_map_of_mem g.toRingHom hx
      rw [Ideal.map_pow] at hmem
      exact hpow_mono n hmem
    intro R₁ R₂ _ _ _ _ e n x
    exact ⟨fun h => by simpa using h_dir e.symm n (e x) h, h_dir e n x⟩

  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have hX_homog : ∀ μ : Fin (M + 1),
      (MvPolynomial.X μ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜 1 :=
    fun μ => MvPolynomial.isHomogeneous_X k μ
  have hLin_homog : ∀ c : Fin (M + 1) → k,
      (∑ μ : Fin (M + 1), MvPolynomial.C (c μ) * MvPolynomial.X μ) ∈ 𝒜 1 := by
    intro c
    refine Submodule.sum_mem (𝒜 1) fun μ _ => ?_
    rw [← MvPolynomial.smul_eq_C_mul]
    exact Submodule.smul_mem (𝒜 1) (c μ) (hX_homog μ)

  have hLinEq : ∀ (c : Fin (M + 1) → k)
      (hFc : (∑ μ : Fin (M + 1), MvPolynomial.C (c μ) * MvPolynomial.X μ) ∈ 𝒜 1)
      (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜 1),
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X α₀) hXα zero_lt_one).hom ≫
        ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α₀)) V hVα).hom
        (HomogeneousLocalization.mk ⟨1, ⟨_, hFc⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩) =
        ∑ μ : Fin (M + 1), algebraMap k A (c μ) * X_full μ := by
    intro c hFc hXα
    rw [hLinForm c hFc hXα zero_lt_one, Fin.sum_univ_succAbove _ α₀]
    dsimp only [X_full]
    simp only [Fin.insertNth_apply_same, Fin.insertNth_apply_succAbove, mul_one]
    rfl

  have hEv_JV_0 : ∀ (ev_z : A →ₐ[k] k) (c : Fin (M + 1) → k),
      ev_z (∑ μ : Fin (M + 1), algebraMap k A (c μ) * X_full μ) =
        ∑ μ : Fin (M + 1), ev_z (J_V 0 μ) * c μ := by
    intro ev_z c
    rw [map_sum]
    refine Finset.sum_congr rfl fun μ _ => ?_
    rw [map_mul, ev_z.commutes, mul_comm]
    rfl
  have hEv_JV_succ : ∀ (ev_z : A →ₐ[k] k) (c : Fin (M + 1) → k) (i : Fin d),
      ev_z (D_V i (∑ μ : Fin (M + 1), algebraMap k A (c μ) * X_full μ)) =
        ∑ μ : Fin (M + 1), ev_z (J_V i.succ μ) * c μ := by
    intro ev_z c i
    rw [map_sum, map_sum]
    refine Finset.sum_congr rfl fun μ _ => ?_
    have hsmul : algebraMap k A (c μ) * X_full μ = c μ • X_full μ :=
      (Algebra.smul_def (c μ) (X_full μ)).symm
    rw [hsmul, (D_V i).map_smul, map_smul, smul_eq_mul, mul_comm]
    rfl
  have hEv_Hess : ∀ (ev_z : A →ₐ[k] k) (c : Fin (M + 1) → k) (i j : Fin d),
      ev_z (D_V j (D_V i (∑ μ : Fin (M + 1), algebraMap k A (c μ) * X_full μ))) =
        ∑ μ : Fin (M + 1), c μ * ev_z (D_V j (D_V i (X_full μ))) := by
    intro ev_z c i j
    rw [map_sum, map_sum, map_sum]
    refine Finset.sum_congr rfl fun μ _ => ?_
    have hsmul : algebraMap k A (c μ) * X_full μ = c μ • X_full μ :=
      (Algebra.smul_def (c μ) (X_full μ)).symm
    rw [hsmul, (D_V i).map_smul, (D_V j).map_smul, map_smul, smul_eq_mul]

  obtain ⟨hHyp_raw, hClosedDict, hStalkOverlap⟩ :=
    weil_algClosed_proj_chart_closedPoints_and_stalk_overlap k M (s + 0 + d) Z_bar ι_bar α₀ V
      hAffV hVα φ hSurj hSpec

  obtain ⟨hEt_ψV, hSpec_ψV⟩ := hEtaleSpecV ψ_V hψV_et hψV_C

  refine ⟨ψ_V, D_V, hDomA, hFT, hTrdeg, hEt_ψV, hSpec_ψV, hDV_X, hv_eq, hDerE,
    ?_, hClosedDict, ?_, ?_⟩

  · intro x c
    rw [hHyp_raw x _ (hLin_homog c) (hX_homog α₀), hLinEq c (hLin_homog c) (hX_homog α₀)]

  · intro z hz hCl_z ev_z hKer_z
    let p_z := (hAffV.primeIdealOf ⟨z, hz⟩).asIdeal
    obtain ⟨ψ_z, ⟨hψz_C, hψz_et, hψz_mem⟩, hJet1, _, _⟩ :=
      weil_formallyEtale_local_jet2_odp_calculus k d A ψ_V D_V ev_z p_z
        hψV_C hψV_et hDV_X hKer_z
    obtain ⟨hEt_ψz, hSpec_ψz⟩ := hEtaleSpecV ψ_z hψz_et hψz_C
    have h11a_jet : ∀ (c : Fin (M + 1) → k)
        (hLc : (∑ μ : Fin (M + 1), MvPolynomial.C (c μ) * MvPolynomial.X μ) ∈ 𝒜 1)
        (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜 1)
        (c₀ : k) (w : Fin d → k),
        algebraMap A (Localization.AtPrime p_z)
          (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X α₀) hXα zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α₀)) V hVα).hom
            (HomogeneousLocalization.mk ⟨1, ⟨_, hLc⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩) -
            ψ_z (MvPolynomial.C c₀ + ∑ i : Fin d, MvPolynomial.C (w i) * MvPolynomial.X i)) ∈
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 2 ↔
          (∑ μ : Fin (M + 1), ev_z (J_V 0 μ) * c μ = c₀ ∧
            ∀ i : Fin d, ∑ μ : Fin (M + 1), ev_z (J_V i.succ μ) * c μ = w i) := by
      intro c hLc hXα c₀ w
      rw [hLinEq c hLc hXα, hJet1 _ c₀ w, hEv_JV_0 ev_z c]
      simp_rw [hEv_JV_succ ev_z c]
    refine ⟨⟨ψ_z, hEt_ψz, hSpec_ψz, hψz_mem, h11a_jet⟩, ?_⟩
    intro c hLc
    constructor
    · intro hCrit α' hXα' W hAffW hzW hWα'
      have hCrit_0 : ∑ μ : Fin (M + 1), ev_z (J_V 0 μ) * c μ = 0 ∧
          ∀ i : Fin d, ∑ μ : Fin (M + 1), ev_z (J_V i.succ μ) * c μ = 0 :=
        ⟨hCrit 0, fun i => hCrit i.succ⟩
      have hV_m2 := (h11a_jet c hLc (hX_homog α₀) 0 (fun _ => 0)).mpr hCrit_0
      simp only [map_zero, zero_mul, Finset.sum_const_zero, add_zero, sub_zero] at hV_m2
      obtain ⟨τ, u, hu_unit, hRatio, _⟩ :=
        hStalkOverlap z hz α' (hX_homog α₀) hXα' W hAffW hzW hWα'
      have hV_m2_eq := (hRatio _ hLc) ▸ hV_m2
      let A_W_cur := ↑(Z_bar.left.presheaf.obj (Opposite.op W))
      let p_W_cur := (hAffW.primeIdealOf ⟨z, hzW⟩).asIdeal
      let ℓ_W_cur : A_W_cur :=
        ((AlgebraicGeometry.Proj.basicOpenIsoAway
          (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
          (MvPolynomial.X α') hXα' zero_lt_one).hom ≫
          ι_bar.left.appLE
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α'))
            W hWα').hom
          (HomogeneousLocalization.mk ⟨1, ⟨_, hLc⟩, ⟨MvPolynomial.X α', hXα'⟩, ⟨1, pow_one _⟩⟩)
      have hτ_m2 : τ (algebraMap A_W_cur (Localization.AtPrime p_W_cur) ℓ_W_cur) ∈
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 2 := by
        have hmul := Ideal.mul_mem_left _ (↑(hu_unit.unit⁻¹) : Localization.AtPrime p_z) hV_m2_eq
        have hcancel : (↑(hu_unit.unit⁻¹) : Localization.AtPrime p_z) *
            (u * τ (algebraMap A_W_cur (Localization.AtPrime p_W_cur) ℓ_W_cur)) =
            τ (algebraMap A_W_cur (Localization.AtPrime p_W_cur) ℓ_W_cur) := by
          rw [← mul_assoc, IsUnit.val_inv_mul, one_mul]
        rwa [hcancel] at hmul
      exact (hLocalEquivPow τ 2 (algebraMap A_W_cur (Localization.AtPrime p_W_cur) ℓ_W_cur)).mp hτ_m2
    · intro hAllW
      have hV_m2 := hAllW α₀ (hX_homog α₀) V hAffV hz hVα
      have hV_m2' : algebraMap A (Localization.AtPrime p_z)
          (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X α₀) (hX_homog α₀)
            zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α₀)) V hVα).hom
            (HomogeneousLocalization.mk ⟨1, ⟨_, hLc⟩, ⟨MvPolynomial.X α₀, hX_homog α₀⟩,
              ⟨1, pow_one _⟩⟩) -
            ψ_z (MvPolynomial.C 0 + ∑ i : Fin d, MvPolynomial.C (0 : k) * MvPolynomial.X i)) ∈
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 2 := by
        simpa using hV_m2
      obtain ⟨h0, hsucc⟩ := (h11a_jet c hLc (hX_homog α₀) 0 0).mp hV_m2'
      exact Fin.cases h0 hsucc

  · intro z hz hCl_z ev_z hKer_z c
    let p_z := (hAffV.primeIdealOf ⟨z, hz⟩).asIdeal
    let L_c := ∑ μ : Fin (M + 1), MvPolynomial.C (c μ) * MvPolynomial.X μ
    obtain ⟨ψ_z, ⟨hψz_C, hψz_et, hψz_mem⟩, _, hJet2, hOdpInv⟩ :=
      weil_formallyEtale_local_jet2_odp_calculus k d A ψ_V D_V ev_z p_z
        hψV_C hψV_et hDV_X hKer_z
    obtain ⟨hEt_ψz, hSpec_ψz⟩ := hEtaleSpecV ψ_z hψz_et hψz_C
    constructor
    · rintro ⟨hLc, α', hXα', W, hAffW, hzW, hWα', ψ_W, Q',
        hEt_W, hSpec_W, hMem_W, hQ'_hom, hQ'_det, hMod3_W⟩
      let A_W := ↑(Z_bar.left.presheaf.obj (Opposite.op W))
      let p_W := (hAffW.primeIdealOf ⟨z, hzW⟩).asIdeal
      have hψW_et : ψ_W.Etale := by
        have h_iso_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W) =
            hAffW.isoSpec.inv ≫ (W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W)) := by
          rw [← hAffW.isoSpec_hom, CategoryTheory.Iso.inv_hom_id_assoc]
        have : AlgebraicGeometry.Etale hAffW.isoSpec.inv := inferInstance
        have : AlgebraicGeometry.Etale
            (W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W)) := hEt_W
        have hEt_map : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W)) := by
          rw [h_iso_eq]
          infer_instance
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.Etale)).mp hEt_map
      obtain ⟨τ, u, hu_unit, hRatio, hScalarAlign⟩ :=
        hStalkOverlap z hz α' (hX_homog α₀) hXα' W hAffW hzW hWα'
      let ψ'_loc : MvPolynomial (Fin d) k →+* Localization.AtPrime p_z :=
        τ.toRingHom.comp ((algebraMap A_W (Localization.AtPrime p_W)).comp ψ_W)
      have hSpec_κW : W.toSpecΓ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_W.comp MvPolynomial.C)) =
          W.ι ≫ Z_bar.hom := by
        have hc : CommRingCat.ofHom (ψ_W.comp MvPolynomial.C) =
            CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom ψ_W := rfl
        rw [hc, AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc]
        simpa only [CategoryTheory.Category.assoc] using hSpec_W
      have hψ'_alg : ψ'_loc.comp MvPolynomial.C = algebraMap k (Localization.AtPrime p_z) := by
        ext r
        change τ (algebraMap A_W (Localization.AtPrime p_W) ((ψ_W.comp MvPolynomial.C) r)) =
          algebraMap k (Localization.AtPrime p_z) r
        rw [hScalarAlign (ψ_W.comp MvPolynomial.C) hSpec_κW r,
          ← IsScalarTower.algebraMap_apply k A (Localization.AtPrime p_z)]
      have hψ'_fe : @Algebra.FormallyEtale (MvPolynomial (Fin d) k) (Localization.AtPrime p_z) _ _
          ψ'_loc.toAlgebra := by
        let _ : Algebra (MvPolynomial (Fin d) k) A_W := ψ_W.toAlgebra
        have : Algebra.Etale (MvPolynomial (Fin d) k) A_W := RingHom.etale_algebraMap.mp hψW_et
        have : Algebra.FormallyEtale (MvPolynomial (Fin d) k) A_W := inferInstance
        have : Algebra.FormallyEtale A_W (Localization.AtPrime p_W) :=
          Algebra.FormallyEtale.of_isLocalization p_W.primeCompl
        have hfe_RW : Algebra.FormallyEtale (MvPolynomial (Fin d) k) (Localization.AtPrime p_W) :=
          Algebra.FormallyEtale.comp (MvPolynomial (Fin d) k) A_W (Localization.AtPrime p_W)
        have hEquivFE : ∀ {R B₁ B₂ : Type u} [CommRing R] [CommRing B₁] [CommRing B₂]
            (alg₁ : Algebra R B₁) (alg₂ : Algebra R B₂),
            @Algebra.FormallyEtale R B₁ _ _ alg₁ →
            ∀ (e : B₁ ≃+* B₂),
              (∀ r : R, e (@algebraMap R B₁ _ _ alg₁ r) = @algebraMap R B₂ _ _ alg₂ r) →
              True ∧ @Algebra.FormallyEtale R B₂ _ _ alg₂ := by
          intro R B₁ B₂ _ _ _ alg₁ alg₂ hfe e hcomm
          let _ : Algebra R B₁ := alg₁
          let _ : Algebra R B₂ := alg₂
          have : Algebra.FormallyEtale R B₁ := hfe
          let e_alg : B₁ ≃ₐ[R] B₂ := { e with commutes' := hcomm }
          exact ⟨trivial, Algebra.FormallyEtale.of_equiv e_alg⟩
        exact (hEquivFE inferInstance ψ'_loc.toAlgebra hfe_RW τ (fun P => by
          change τ (algebraMap (MvPolynomial (Fin d) k) (Localization.AtPrime p_W) P) = ψ'_loc P
          rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin d) k) A_W
            (Localization.AtPrime p_W) P]
          rfl)).2
      have hψ'_mem : ∀ i : Fin d,
          ψ'_loc (MvPolynomial.X i) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime p_z) := by
        intro i
        have hm_W : algebraMap A_W (Localization.AtPrime p_W) (ψ_W (MvPolynomial.X i)) ∈
            IsLocalRing.maximalIdeal (Localization.AtPrime p_W) := by
          rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p_W (Localization.AtPrime p_W)]
          exact Ideal.mem_map_of_mem _ (hMem_W i)
        have hm_V := (hLocalEquivPow τ 1
          (algebraMap A_W (Localization.AtPrime p_W) (ψ_W (MvPolynomial.X i)))).mpr
          (by simpa only [pow_one] using hm_W)
        change τ (algebraMap A_W (Localization.AtPrime p_W) (ψ_W (MvPolynomial.X i))) ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime p_z)
        simpa only [pow_one] using hm_V
      have hMod3_V : algebraMap A (Localization.AtPrime p_z)
          (∑ μ : Fin (M + 1), algebraMap k A (c μ) * X_full μ) - u * ψ'_loc Q' ∈
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 3 := by
        have h_eq_fc := (congrArg (algebraMap A (Localization.AtPrime p_z))
          (hLinEq c hLc (hX_homog α₀)).symm).trans (hRatio L_c hLc)
        rw [h_eq_fc]
        change u * τ _ -
            u * τ (algebraMap A_W (Localization.AtPrime p_W) (ψ_W Q')) ∈
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 3
        rw [← mul_sub, ← map_sub, ← map_sub]
        exact Ideal.mul_mem_left _ u ((hLocalEquivPow τ 3 _).mpr hMod3_W)
      obtain ⟨⟨hfc_0, hfc_1⟩, hHess_ne⟩ :=
        hOdpInv ψ'_loc u Q' (∑ μ : Fin (M + 1), algebraMap k A (c μ) * X_full μ)
          hψ'_alg hψ'_fe hψ'_mem hu_unit hQ'_hom hQ'_det hMod3_V
      rw [hEv_JV_0 ev_z c] at hfc_0
      have hfc_1' : ∀ i : Fin (2 * m + 2), ∑ μ : Fin (M + 1), ev_z (J_V i.succ μ) * c μ = 0 :=
        fun i => (hEv_JV_succ ev_z c i).symm.trans (hfc_1 i)
      refine ⟨Fin.cases hfc_0 hfc_1', ?_⟩
      simpa only [hEv_Hess ev_z c] using hHess_ne
    · rintro ⟨hCrit, hHess_ne⟩
      have hfc_0 : ev_z (∑ μ : Fin (M + 1), algebraMap k A (c μ) * X_full μ) = 0 := by
        rw [hEv_JV_0 ev_z c]
        exact hCrit 0
      have hfc_1 : ∀ i : Fin d,
          ev_z (D_V i (∑ μ : Fin (M + 1), algebraMap k A (c μ) * X_full μ)) = 0 := fun i => by
        rw [hEv_JV_succ ev_z c i]
        exact hCrit i.succ
      obtain ⟨Q, hQ_hom, hQ_hess, hQ_mod3⟩ :=
        hJet2 (∑ μ : Fin (M + 1), algebraMap k A (c μ) * X_full μ) hfc_0 hfc_1
      have hQ_det : Matrix.det (Matrix.of fun i j : Fin d =>
          MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q))) ≠ 0 := by
        simpa only [hQ_hess, hEv_Hess ev_z c] using hHess_ne
      refine ⟨hLin_homog c, α₀, hX_homog α₀, V, hAffV, hz, hVα, ψ_z, Q,
        hEt_ψz, hSpec_ψz, hψz_mem, hQ_hom, hQ_det, ?_⟩
      rwa [hLinEq c (hLin_homog c) (hX_homog α₀)]

theorem weil_algClosed_conormal_ufd_dual_poly_and_eliminant (k : Type u) [Field k] [IsAlgClosed k] (d M : ℕ) (hd : 1 ≤ d) (hdM : d + 1 ≤ M)
    (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [Algebra k B₀] [Algebra.FiniteType k B₀]
    (hTrB₀ : Algebra.trdeg k B₀ ≤ (d : Cardinal.{u}))
    (D₀ : Fin d → Derivation k B₀ B₀)
    (X₀ : Fin (M + 1) → B₀)
    (e_col : Fin (d + 1) ⊕ Fin (M - d) ≃ Fin (M + 1))
    (ev₀ : B₀ →ₐ[k] k)
    (c₀ : Fin (M + 1) → k) :
    let J₀ : Matrix (Fin (d + 1)) (Fin (M + 1)) B₀ :=
      Matrix.of (Fin.cases X₀ (fun i μ => D₀ i (X₀ μ)))
    let M_piv : Matrix (Fin (d + 1)) (Fin (d + 1)) B₀ :=
      Matrix.of fun r s => J₀ r (e_col (Sum.inl s))
    let J_free : Matrix (Fin (d + 1)) (Fin (M - d)) B₀ :=
      Matrix.of fun r a => J₀ r (e_col (Sum.inr a))
    IsUnit M_piv.det →
    (∀ r : Fin (d + 1), ∑ μ : Fin (M + 1), ev₀ (J₀ r μ) * c₀ μ = 0) →
    Matrix.det (Matrix.of fun i j : Fin d =>
      ∑ μ : Fin (M + 1), c₀ μ * ev₀ (D₀ j (D₀ i (X₀ μ)))) ≠ 0 →
    let Φ₀ : MvPolynomial (Fin (M + 1)) k →ₐ[k] MvPolynomial (Fin (M - d)) B₀ :=
      MvPolynomial.aeval (fun μ =>
        Sum.elim
          (fun s => - ∑ a : Fin (M - d),
            MvPolynomial.C (((Ring.inverse M_piv.det • M_piv.adjugate) * J_free) s a) *
              MvPolynomial.X a)
          MvPolynomial.X (e_col.symm μ))
    ∃ (D_amb : ℕ) (P_amb : MvPolynomial (Fin (M + 1)) k)
      (E₀ : ℕ) (Q₀ : MvPolynomial (Fin (M + 1)) k),
      1 ≤ D_amb ∧
      P_amb ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k D_amb ∧
      Irreducible P_amb ∧
      RingHom.ker Φ₀.toRingHom = Ideal.span {P_amb} ∧
      Q₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k E₀ ∧
      ¬ (P_amb ∣ Q₀) ∧
      (∀ c : Fin (M + 1) → k, c ≠ 0 → MvPolynomial.eval c P_amb = 0 →
        MvPolynomial.eval c Q₀ ≠ 0 →
        ∃ ev_c : B₀ →ₐ[k] k,
          (∀ r : Fin (d + 1), ∑ μ : Fin (M + 1), ev_c (J₀ r μ) * c μ = 0) ∧
          Matrix.det (Matrix.of fun i j : Fin d =>
            ∑ μ : Fin (M + 1), c μ * ev_c (D₀ j (D₀ i (X₀ μ)))) ≠ 0) ∧
      (∀ (B_α : Type u) [CommRing B_α] [IsDomain B_α] [Algebra k B_α] (n_free : ℕ),
        Algebra.trdeg k B_α + (n_free : Cardinal.{u}) ≤ ((M - 1 : ℕ) : Cardinal.{u}) →
        ∀ (Ψ : MvPolynomial (Fin (M + 1)) k →ₐ[k] MvPolynomial (Fin n_free) B_α),
          (∀ μ : Fin (M + 1),
            Ψ (MvPolynomial.X μ) ∈ MvPolynomial.homogeneousSubmodule (Fin n_free) B_α 1) →
          ∃ (E_α : ℕ) (Q_α : MvPolynomial (Fin (M + 1)) k),
            1 ≤ E_α ∧
            Q_α ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k E_α ∧
            ¬ (P_amb ∣ Q_α) ∧
            Ψ Q_α = 0) :=
by
  classical
  intro J₀ M_piv J_free hUnit hCrit₀ hHess₀ Φ₀
  have hM1 : 1 ≤ M := by omega
  have hd_add : d + (M - d) = M := by omega

  
  have hHomComp : ∀ {B : Type u} [CommRing B] [Algebra k B] {n : ℕ}
      (Ψ : MvPolynomial (Fin (M + 1)) k →ₐ[k] MvPolynomial (Fin n) B),
      (∀ μ : Fin (M + 1),
        Ψ (MvPolynomial.X μ) ∈ MvPolynomial.homogeneousSubmodule (Fin n) B 1) →
      (∀ (e : ℕ) (G : MvPolynomial (Fin (M + 1)) k),
        G ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k e →
        Ψ G ∈ MvPolynomial.homogeneousSubmodule (Fin n) B e) ∧
      (∀ (e : ℕ) (F : MvPolynomial (Fin (M + 1)) k),
        MvPolynomial.homogeneousComponent e (Ψ F) = Ψ (MvPolynomial.homogeneousComponent e F)) := by
    intro B _ _ n Ψ hΨX
    have hΨ_eq : ∀ G : MvPolynomial (Fin (M + 1)) k,
        Ψ G = MvPolynomial.eval₂ (algebraMap k (MvPolynomial (Fin n) B))
          (fun μ => Ψ (MvPolynomial.X μ)) G := by
      intro G
      have h1 : Ψ = MvPolynomial.aeval (fun μ => Ψ (MvPolynomial.X μ)) := by
        ext μ; simp only [MvPolynomial.aeval_X]
      conv_lhs => rw [h1]
      rw [MvPolynomial.aeval_def]
    have hPres : ∀ (e : ℕ) (G : MvPolynomial (Fin (M + 1)) k),
        G ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k e →
        Ψ G ∈ MvPolynomial.homogeneousSubmodule (Fin n) B e := by
      intro e G hG
      rw [MvPolynomial.mem_homogeneousSubmodule] at hG ⊢
      rw [hΨ_eq G, ← one_mul e]
      refine hG.eval₂ _ _ (fun r => ?_) (fun μ => (MvPolynomial.mem_homogeneousSubmodule _ _).mp (hΨX μ))
      rw [IsScalarTower.algebraMap_apply k B (MvPolynomial (Fin n) B) r, MvPolynomial.algebraMap_eq]
      exact MvPolynomial.isHomogeneous_C _ _
    refine ⟨hPres, fun e F => ?_⟩
    conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent F]
    rw [map_sum, map_sum]
    have hterm : ∀ i ∈ Finset.range (F.totalDegree + 1),
        MvPolynomial.homogeneousComponent e (Ψ (MvPolynomial.homogeneousComponent i F)) =
          if e = i then Ψ (MvPolynomial.homogeneousComponent i F) else 0 := fun i _ =>
      MvPolynomial.homogeneousComponent_of_mem
        (hPres i _ (MvPolynomial.homogeneousComponent_isHomogeneous i F))
    rw [Finset.sum_congr rfl hterm]
    by_cases he : e < F.totalDegree + 1
    · rw [Finset.sum_ite_eq (Finset.range (F.totalDegree + 1)) e]
      simp only [Finset.mem_range, he, ↓reduceIte]
    · have he_gt : F.totalDegree < e := by omega
      rw [MvPolynomial.homogeneousComponent_eq_zero e F he_gt, map_zero]
      refine Finset.sum_eq_zero fun i hi => ?_
      rw [Finset.mem_range] at hi
      have hne : e ≠ i := by omega
      simp only [hne, ↓reduceIte]

  
  have hEqC_of_deg0 : ∀ {σ : Type} (P : MvPolynomial σ k),
      P.totalDegree = 0 → P = MvPolynomial.C (P.coeff 0) := by
    intro σ P hdeg0
    have hall0 := (MvPolynomial.totalDegree_eq_zero_iff σ P).mp hdeg0
    ext m
    rw [MvPolynomial.coeff_C]
    by_cases hm0 : m = 0
    · subst hm0; simp only [↓reduceIte]
    · simp only [Ne.symm hm0, ↓reduceIte]
      by_contra hne
      apply hm0
      ext x
      exact hall0 m (MvPolynomial.mem_support_iff.mpr hne) x

  have hEqC_of_hom0 : ∀ {σ : Type} (P : MvPolynomial σ k),
      P ∈ MvPolynomial.homogeneousSubmodule σ k 0 → P = MvPolynomial.C (P.coeff 0) := by
    intro σ P hP
    exact hEqC_of_deg0 P (Nat.eq_zero_of_le_zero
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mp hP).totalDegree_le)

  
  have hProdHomog₀ : ∀ {α : Type} {σ : Type} {R : Type u} [CommRing R]
      (s : Finset α) (deg : α → ℕ) (f : α → MvPolynomial σ R),
      (∀ a ∈ s, f a ∈ MvPolynomial.homogeneousSubmodule σ R (deg a)) →
      (∏ a ∈ s, f a) ∈ MvPolynomial.homogeneousSubmodule σ R (∑ a ∈ s, deg a) := by
    intro α σ R _ s deg f hf
    induction s using Finset.induction_on with
    | empty =>
      simp only [Finset.prod_empty, Finset.sum_empty]
      exact MvPolynomial.isHomogeneous_one _ _
    | insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.sum_insert ha, MvPolynomial.mem_homogeneousSubmodule]
      exact ((MvPolynomial.mem_homogeneousSubmodule _ _).mp
        (hf a (Finset.mem_insert_self a s))).mul
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mp
          (ih (fun b hb => hf b (Finset.mem_insert_of_mem hb))))

  have hProdHomog_u : ∀ {α : Type u} {σ : Type} {R : Type u} [CommRing R]
      (s : Finset α) (deg : α → ℕ) (f : α → MvPolynomial σ R),
      (∀ a ∈ s, f a ∈ MvPolynomial.homogeneousSubmodule σ R (deg a)) →
      (∏ a ∈ s, f a) ∈ MvPolynomial.homogeneousSubmodule σ R (∑ a ∈ s, deg a) := by
    intro α σ R _ s deg f hf
    induction s using Finset.induction_on with
    | empty =>
      simp only [Finset.prod_empty, Finset.sum_empty]
      exact MvPolynomial.isHomogeneous_one _ _
    | insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.sum_insert ha, MvPolynomial.mem_homogeneousSubmodule]
      exact ((MvPolynomial.mem_homogeneousSubmodule _ _).mp
        (hf a (Finset.mem_insert_self a s))).mul
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mp
          (ih (fun b hb => hf b (Finset.mem_insert_of_mem hb))))

  
  
  
  let R_con := MvPolynomial (Fin (M - d)) B₀
  let w₀ : Fin (M + 1) → R_con := fun μ => Φ₀ (MvPolynomial.X μ)
  let M_inv : Matrix (Fin (d + 1)) (Fin (d + 1)) B₀ := Ring.inverse M_piv.det • M_piv.adjugate

  have hMpiv_mul_inv : M_piv * M_inv = 1 := by
    dsimp only [M_inv]
    rw [Matrix.mul_smul, Matrix.mul_adjugate, smul_smul, Ring.inverse_mul_cancel _ hUnit, one_smul]
  have hMinv_mul_piv : M_inv * M_piv = 1 := by
    dsimp only [M_inv]
    rw [Matrix.smul_mul, Matrix.adjugate_mul, smul_smul, Ring.inverse_mul_cancel _ hUnit, one_smul]

  have hw₀_inl : ∀ s : Fin (d + 1),
      w₀ (e_col (Sum.inl s)) =
        - ∑ a : Fin (M - d), MvPolynomial.C ((M_inv * J_free) s a) * MvPolynomial.X a := by
    intro s
    dsimp only [w₀, Φ₀, M_inv]
    rw [MvPolynomial.aeval_X, e_col.symm_apply_apply, Sum.elim_inl]
  have hw₀_inr : ∀ a : Fin (M - d), w₀ (e_col (Sum.inr a)) = MvPolynomial.X a := by
    intro a
    dsimp only [w₀, Φ₀]
    rw [MvPolynomial.aeval_X, e_col.symm_apply_apply, Sum.elim_inr]

  have hΦ₀_hom : ∀ μ : Fin (M + 1),
      Φ₀ (MvPolynomial.X μ) ∈ MvPolynomial.homogeneousSubmodule (Fin (M - d)) B₀ 1 := by
    intro μ
    rw [← e_col.apply_symm_apply μ]
    rcases e_col.symm μ with s | a
    · change w₀ (e_col (Sum.inl s)) ∈ _
      rw [hw₀_inl]
      refine Submodule.neg_mem _ (Submodule.sum_mem _ fun a _ => ?_)
      rw [← MvPolynomial.smul_eq_C_mul]
      exact Submodule.smul_mem _ _ (MvPolynomial.isHomogeneous_X B₀ a)
    · change w₀ (e_col (Sum.inr a)) ∈ _
      rw [hw₀_inr]
      exact MvPolynomial.isHomogeneous_X B₀ a

  have hΦ₀_ann : ∀ r : Fin (d + 1),
      ∑ μ : Fin (M + 1), MvPolynomial.C (J₀ r μ) * w₀ μ = 0 := by
    intro r
    rw [← e_col.sum_comp, Fintype.sum_sum_type]
    have hlhs : (∑ s : Fin (d + 1), MvPolynomial.C (J₀ r (e_col (Sum.inl s))) * w₀ (e_col (Sum.inl s))) =
        - ∑ a : Fin (M - d), MvPolynomial.C (J₀ r (e_col (Sum.inr a))) * MvPolynomial.X a := by
      simp_rw [hw₀_inl, mul_neg, Finset.sum_neg_distrib]
      congr 1
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun a _ => ?_
      simp_rw [← mul_assoc, ← MvPolynomial.C_mul, ← Finset.sum_mul, ← map_sum]
      congr 2
      change (M_piv * (M_inv * J_free)) r a = J_free r a
      rw [← Matrix.mul_assoc, hMpiv_mul_inv, Matrix.one_mul]
    rw [hlhs]
    simp_rw [hw₀_inr]
    exact neg_add_cancel _

  let ev_hat : R_con →+* k :=
    MvPolynomial.eval₂Hom ev₀.toRingHom (fun a => c₀ (e_col (Sum.inr a)))
  have hev_hat_C : ∀ b : B₀, ev_hat (MvPolynomial.C b) = ev₀ b :=
    fun b => MvPolynomial.eval₂Hom_C _ _ b
  have hev_hat_X : ∀ a : Fin (M - d), ev_hat (MvPolynomial.X a) = c₀ (e_col (Sum.inr a)) :=
    fun a => MvPolynomial.eval₂Hom_X' _ _ a

  have hev_hat_w₀ : ∀ μ : Fin (M + 1), ev_hat (w₀ μ) = c₀ μ := by
    have hCrit_split : ∀ r : Fin (d + 1),
        ∑ s : Fin (d + 1), ev₀ (M_piv r s) * c₀ (e_col (Sum.inl s)) =
          - ∑ a : Fin (M - d), ev₀ (J_free r a) * c₀ (e_col (Sum.inr a)) := by
      intro r
      have hr := hCrit₀ r
      rw [← e_col.sum_comp, Fintype.sum_sum_type] at hr
      exact eq_neg_of_add_eq_zero_left hr
    have hinl : ∀ s₀ : Fin (d + 1), ev_hat (w₀ (e_col (Sum.inl s₀))) = c₀ (e_col (Sum.inl s₀)) := by
      intro s₀
      have hmul : ∑ r : Fin (d + 1), ev₀ (M_inv s₀ r) *
          (∑ s : Fin (d + 1), ev₀ (M_piv r s) * c₀ (e_col (Sum.inl s))) =
          c₀ (e_col (Sum.inl s₀)) := by
        simp_rw [Finset.mul_sum]
        rw [Finset.sum_comm]
        have hs : ∀ s : Fin (d + 1),
            (∑ r : Fin (d + 1), ev₀ (M_inv s₀ r) * (ev₀ (M_piv r s) * c₀ (e_col (Sum.inl s)))) =
              ev₀ ((M_inv * M_piv) s₀ s) * c₀ (e_col (Sum.inl s)) := by
          intro s
          simp_rw [← mul_assoc, ← map_mul, ← Finset.sum_mul, ← map_sum, Matrix.mul_apply]
        simp_rw [hs, hMinv_mul_piv, Matrix.one_apply]
        simp only [apply_ite ev₀, map_one, map_zero, ite_mul, one_mul, zero_mul,
          Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]
      rw [← hmul]
      simp_rw [hCrit_split, mul_neg, Finset.sum_neg_distrib, Finset.mul_sum]
      rw [Finset.sum_comm, hw₀_inl, map_neg, map_sum]
      congr 1
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [map_mul, hev_hat_C, hev_hat_X]
      simp_rw [← mul_assoc, ← map_mul, ← Finset.sum_mul, ← map_sum, Matrix.mul_apply]
    intro μ
    rw [← e_col.apply_symm_apply μ]
    rcases e_col.symm μ with s | a
    · exact hinl s
    · rw [hw₀_inr, hev_hat_X]

  let H₀ : R_con := Matrix.det (Matrix.of fun i j : Fin d =>
    ∑ μ : Fin (M + 1), w₀ μ * MvPolynomial.C (D₀ j (D₀ i (X₀ μ))))

  have hH₀_hom : H₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (M - d)) B₀ d := by
    let M_H : Matrix (Fin d) (Fin d) R_con := Matrix.of fun i j : Fin d =>
      ∑ μ : Fin (M + 1), w₀ μ * MvPolynomial.C (D₀ j (D₀ i (X₀ μ)))
    change M_H.det ∈ _
    rw [Matrix.det_apply]
    refine Submodule.sum_mem _ fun σ _ => ?_
    rw [Units.smul_def]
    have hcard : (∑ _i : Fin d, 1) = d := by
      simp only [Finset.sum_const, Finset.card_fin, smul_eq_mul, mul_one]
    have hprod : (∏ i : Fin d, M_H (σ i) i) ∈
        MvPolynomial.homogeneousSubmodule (Fin (M - d)) B₀ (∑ _i : Fin d, 1) := by
      refine hProdHomog₀ Finset.univ (fun _ => 1) (fun i => M_H (σ i) i) fun i _ => ?_
      dsimp only [M_H, Matrix.of_apply]
      refine Submodule.sum_mem _ fun μ _ => ?_
      rw [mul_comm, ← MvPolynomial.smul_eq_C_mul]
      exact Submodule.smul_mem _ _ (hΦ₀_hom μ)
    rw [hcard] at hprod
    exact (MvPolynomial.homogeneousSubmodule (Fin (M - d)) B₀ d).toAddSubgroup.zsmul_mem hprod _

  have hev_hat_H₀ : ev_hat H₀ ≠ 0 := by
    dsimp only [H₀]
    rw [RingHom.map_det]
    have hmat : ev_hat.mapMatrix (Matrix.of fun i j : Fin d =>
        ∑ μ : Fin (M + 1), w₀ μ * MvPolynomial.C (D₀ j (D₀ i (X₀ μ)))) =
      Matrix.of fun i j : Fin d =>
        ∑ μ : Fin (M + 1), c₀ μ * ev₀ (D₀ j (D₀ i (X₀ μ))) := by
      ext i j
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, map_sum, map_mul,
        hev_hat_w₀, hev_hat_C]
    rw [hmat]
    exact hHess₀

  have hH₀_ne : H₀ ≠ 0 := fun h0 => hev_hat_H₀ (by rw [h0, map_zero])

  
  let d_base_fn : Fin d → R_con → R_con := fun j P =>
    ∑ s ∈ P.support, MvPolynomial.monomial s (D₀ j (P.coeff s))
  have hd_base_coeff : ∀ (j : Fin d) (P : R_con) (m : Fin (M - d) →₀ ℕ),
      (d_base_fn j P).coeff m = D₀ j (P.coeff m) := by
    intro j P m
    dsimp only [d_base_fn]
    rw [MvPolynomial.coeff_sum]
    simp_rw [MvPolynomial.coeff_monomial]
    by_cases hm : m ∈ P.support
    · rw [Finset.sum_ite_eq' P.support m]
      simp only [hm, ↓reduceIte]
    · rw [MvPolynomial.notMem_support_iff.mp hm, map_zero]
      refine Finset.sum_eq_zero fun s hs => ?_
      have hne : s ≠ m := fun h => hm (h ▸ hs)
      simp only [hne, ↓reduceIte]

  have hd_base_monomial : ∀ (j : Fin d) (s : Fin (M - d) →₀ ℕ) (b : B₀),
      d_base_fn j (MvPolynomial.monomial s b) = MvPolynomial.monomial s (D₀ j b) := by
    intro j s b
    ext m
    rw [hd_base_coeff, MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial]
    split_ifs <;> simp only [map_zero]

  have hd_base_add : ∀ (j : Fin d) (P Q : R_con),
      d_base_fn j (P + Q) = d_base_fn j P + d_base_fn j Q := by
    intro j P Q
    ext m
    have h1 : (P + Q).coeff m = P.coeff m + Q.coeff m :=
      map_add (MvPolynomial.lcoeff B₀ m) P Q
    have h2 : (d_base_fn j P + d_base_fn j Q).coeff m =
        (d_base_fn j P).coeff m + (d_base_fn j Q).coeff m :=
      map_add (MvPolynomial.lcoeff B₀ m) (d_base_fn j P) (d_base_fn j Q)
    rw [hd_base_coeff, h1, map_add, h2, hd_base_coeff, hd_base_coeff]

  have hd_base_smul : ∀ (j : Fin d) (a : k) (P : R_con),
      d_base_fn j (a • P) = a • d_base_fn j P := by
    intro j a P
    ext m
    rw [hd_base_coeff, MvPolynomial.coeff_smul, (D₀ j).map_smul,
      MvPolynomial.coeff_smul, hd_base_coeff]

  have hd_base_C : ∀ (j : Fin d) (b : B₀),
      d_base_fn j (MvPolynomial.C b) = MvPolynomial.C (D₀ j b) := by
    intro j b
    ext m
    rw [hd_base_coeff, MvPolynomial.coeff_C, MvPolynomial.coeff_C]
    split_ifs <;> simp only [map_zero]

  have hd_base_one : ∀ j : Fin d, d_base_fn j 1 = 0 := by
    intro j
    rw [← map_one MvPolynomial.C, hd_base_C, Derivation.map_one_eq_zero, map_zero]

  have hd_base_X : ∀ (j : Fin d) (a : Fin (M - d)),
      d_base_fn j (MvPolynomial.X a) = 0 := by
    intro j a
    rw [← pow_one (MvPolynomial.X a), MvPolynomial.X_pow_eq_monomial, hd_base_monomial,
      Derivation.map_one_eq_zero, map_zero]

  have hd_base_leibniz : ∀ (j : Fin d) (P Q : R_con),
      d_base_fn j (P * Q) = P * d_base_fn j Q + Q * d_base_fn j P := by
    intro j P
    induction P using MvPolynomial.induction_on' with
    | monomial s₁ b₁ =>
      intro Q
      induction Q using MvPolynomial.induction_on' with
      | monomial s₂ b₂ =>
        rw [MvPolynomial.monomial_mul_monomial, hd_base_monomial, hd_base_monomial, hd_base_monomial,
          (D₀ j).leibniz, map_add, MvPolynomial.monomial_mul_monomial,
          MvPolynomial.monomial_mul_monomial]
        simp only [smul_eq_mul, add_comm s₂ s₁]
      | add Q₁ Q₂ ih₁ ih₂ =>
        rw [mul_add, hd_base_add, ih₁, ih₂, hd_base_add, mul_add, add_mul]
        abel
    | add P₁ P₂ ih₁ ih₂ =>
      intro Q
      rw [add_mul, hd_base_add, ih₁, ih₂, hd_base_add, add_mul, mul_add]
      abel

  let D_base : Fin d → Derivation k R_con R_con := fun j =>
    { toFun := d_base_fn j
      map_add' := hd_base_add j
      map_smul' := hd_base_smul j
      map_one_eq_zero' := hd_base_one j
      leibniz' := hd_base_leibniz j }

  have hD_base_C : ∀ (j : Fin d) (b : B₀),
      D_base j (MvPolynomial.C b) = MvPolynomial.C (D₀ j b) := hd_base_C
  have hD_base_X : ∀ (j : Fin d) (a : Fin (M - d)),
      D_base j (MvPolynomial.X a) = 0 := hd_base_X

  let D_free : Fin (M - d) → Derivation k R_con R_con := fun a =>
    (MvPolynomial.pderiv a).restrictScalars k

  
  let M_bar : Matrix (Fin (d + 1)) (Fin (d + 1)) k := ev₀.toRingHom.mapMatrix M_piv
  let M_inv_bar : Matrix (Fin (d + 1)) (Fin (d + 1)) k := ev₀.toRingHom.mapMatrix M_inv
  have hMbar_mul_inv : M_bar * M_inv_bar = 1 := by
    ext r s
    change (M_piv.map ev₀.toRingHom * M_inv.map ev₀.toRingHom) r s =
      (1 : Matrix (Fin (d + 1)) (Fin (d + 1)) k) r s
    rw [Matrix.mul_apply, Matrix.one_apply]
    simp_rw [Matrix.map_apply, ← map_mul]
    rw [← map_sum, ← Matrix.mul_apply, hMpiv_mul_inv, Matrix.one_apply]
    split_ifs <;> simp only [map_one, map_zero]

  let A_piv : Matrix (Fin (d + 1)) (Fin d) k :=
    Matrix.of fun s j => ev_hat (D_base j (w₀ (e_col (Sum.inl s))))
  let B_Hess : Matrix (Fin d) (Fin d) k :=
    Matrix.of fun i j => ∑ μ : Fin (M + 1), c₀ μ * ev₀ (D₀ j (D₀ i (X₀ μ)))

  have hDiff_ann : ∀ (r : Fin (d + 1)) (j : Fin d),
      (M_bar * A_piv) r j + ∑ μ : Fin (M + 1), c₀ μ * ev₀ (D₀ j (J₀ r μ)) = 0 := by
    intro r j
    have h0 := congrArg (D_base j) (hΦ₀_ann r)
    rw [map_zero, map_sum] at h0
    have hleib : ∀ μ : Fin (M + 1),
        D_base j (MvPolynomial.C (J₀ r μ) * w₀ μ) =
          MvPolynomial.C (J₀ r μ) * D_base j (w₀ μ) +
            w₀ μ * MvPolynomial.C (D₀ j (J₀ r μ)) := by
      intro μ
      rw [(D_base j).leibniz, hD_base_C]
      rfl
    simp_rw [hleib] at h0
    rw [Finset.sum_add_distrib] at h0
    have hsplit : (∑ μ : Fin (M + 1), MvPolynomial.C (J₀ r μ) * D_base j (w₀ μ)) =
        ∑ s : Fin (d + 1), MvPolynomial.C (M_piv r s) * D_base j (w₀ (e_col (Sum.inl s))) := by
      rw [← e_col.sum_comp, Fintype.sum_sum_type]
      have hfree0 : (∑ a : Fin (M - d),
          MvPolynomial.C (J₀ r (e_col (Sum.inr a))) * D_base j (w₀ (e_col (Sum.inr a)))) = 0 := by
        refine Finset.sum_eq_zero fun a _ => ?_
        rw [hw₀_inr, hD_base_X, mul_zero]
      rw [hfree0, add_zero]
      rfl
    rw [hsplit] at h0
    have hev0 := congrArg ev_hat h0
    rw [map_zero, map_add, map_sum, map_sum] at hev0
    refine Eq.trans ?_ hev0
    congr 1
    · rw [Matrix.mul_apply]
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [map_mul, hev_hat_C]
      rfl
    · refine Finset.sum_congr rfl fun μ _ => ?_
      rw [map_mul, hev_hat_w₀, hev_hat_C]

  have hMA_succ : ∀ i j : Fin d, (M_bar * A_piv) i.succ j = - B_Hess i j := by
    intro i j
    have h0 := hDiff_ann i.succ j
    have hsum : (∑ μ : Fin (M + 1), c₀ μ * ev₀ (D₀ j (J₀ i.succ μ))) = B_Hess i j := by
      dsimp only [B_Hess, J₀, Matrix.of_apply]
      simp_rw [Fin.cases_succ]
    rw [hsum] at h0
    exact eq_neg_of_add_eq_zero_left h0

  
  let C_mat : Matrix (Fin (d + 1)) (Fin (d + 1)) k :=
    Matrix.of fun s c => Fin.cases (M_inv_bar s 0) (fun j => A_piv s j) c

  have hMC_col0 : ∀ r : Fin (d + 1), (M_bar * C_mat) r 0 = if r = 0 then 1 else 0 := by
    intro r
    have h1 : (M_bar * C_mat) r 0 = (M_bar * M_inv_bar) r 0 := by
      simp only [Matrix.mul_apply, C_mat, Matrix.of_apply, Fin.cases_zero]
    rw [h1, hMbar_mul_inv, Matrix.one_apply]

  have hMC_det_ne : (M_bar * C_mat).det ≠ 0 := by
    rw [Matrix.det_succ_column_zero, Fin.sum_univ_succ]
    have htail : (∑ i : Fin d, (-1 : k) ^ (i.succ : ℕ) * (M_bar * C_mat) i.succ 0 *
        ((M_bar * C_mat).submatrix i.succ.succAbove Fin.succ).det) = 0 := by
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [hMC_col0 i.succ]
      simp only [Fin.succ_ne_zero, ↓reduceIte, mul_zero, zero_mul]
    rw [htail, add_zero, hMC_col0 0]
    simp only [↓reduceIte, Fin.val_zero, pow_zero, mul_one, one_mul]
    have hsub : (M_bar * C_mat).submatrix (0 : Fin (d + 1)).succAbove Fin.succ = - B_Hess := by
      ext i j
      simp only [Matrix.submatrix_apply, Fin.succAbove_zero, Matrix.neg_apply]
      have h2 : (M_bar * C_mat) i.succ j.succ = (M_bar * A_piv) i.succ j := by
        simp only [Matrix.mul_apply, C_mat, Matrix.of_apply, Fin.cases_succ]
      rw [h2, hMA_succ]
    rw [hsub, Matrix.det_neg, Fintype.card_fin]
    exact mul_ne_zero (pow_ne_zero d (neg_ne_zero.mpr one_ne_zero)) hHess₀

  have hC_det_ne : C_mat.det ≠ 0 := by
    intro h0
    apply hMC_det_ne
    rw [Matrix.det_mul, h0, mul_zero]

  have hex_s_star : ∃ s_star : Fin (d + 1),
      (Matrix.of fun r j : Fin d => A_piv (s_star.succAbove r) j).det ≠ 0 := by
    by_contra h_all
    rw [not_exists] at h_all
    apply hC_det_ne
    rw [Matrix.det_succ_column_zero]
    refine Finset.sum_eq_zero fun s_star _ => ?_
    have hsub_eq : C_mat.submatrix s_star.succAbove Fin.succ =
        Matrix.of fun r j : Fin d => A_piv (s_star.succAbove r) j := by
      ext r j
      simp only [Matrix.submatrix_apply, C_mat, Matrix.of_apply, Fin.cases_succ]
    rw [hsub_eq, not_not.mp (h_all s_star), mul_zero]

  obtain ⟨s_star, hs_star⟩ := hex_s_star
  let μ_star : Fin (M + 1) := e_col (Sum.inl s_star)
  let ι_M : Fin M → Fin (M + 1) := fun i => (Equiv.swap 0 μ_star) i.succ
  let ι_rem : Fin d ⊕ Fin (M - d) → Fin (M + 1) :=
    Sum.elim (fun r => e_col (Sum.inl (s_star.succAbove r))) (fun a => e_col (Sum.inr a))

  
  have hι_M_ne : ∀ i : Fin M, ι_M i ≠ μ_star := by
    intro i h
    dsimp only [ι_M] at h
    have h1 := Equiv.swap_apply_eq_iff.mp h
    rw [Equiv.swap_apply_right] at h1
    exact Fin.succ_ne_zero i h1

  have hι_rem_ne : ∀ x : Fin d ⊕ Fin (M - d), ι_rem x ≠ μ_star := by
    rintro (r | a) h
    · dsimp only [ι_rem, μ_star, Sum.elim_inl] at h
      exact Fin.succAbove_ne s_star r (Sum.inl.inj (e_col.injective h))
    · dsimp only [ι_rem, μ_star, Sum.elim_inr] at h
      exact Sum.inr_ne_inl (e_col.injective h)

  let e_sub₁ : Fin M ≃ { μ : Fin (M + 1) // μ ≠ μ_star } :=
    Equiv.ofBijective (fun i => ⟨ι_M i, hι_M_ne i⟩) ⟨by
      intro i₁ i₂ h
      exact Fin.succ_injective _ ((Equiv.swap 0 μ_star).injective (Subtype.ext_iff.mp h)),
      by
        rintro ⟨μ, hμ⟩
        have hν : (Equiv.swap 0 μ_star) μ ≠ 0 := by
          intro h0
          apply hμ
          have h1 := congrArg (Equiv.swap 0 μ_star) h0
          rw [Equiv.swap_apply_self, Equiv.swap_apply_left] at h1
          exact h1
        obtain ⟨i, hi⟩ := Fin.eq_succ_of_ne_zero hν
        refine ⟨i, Subtype.ext ?_⟩
        dsimp only [ι_M]
        rw [← hi, Equiv.swap_apply_self]⟩

  let e_sub₂ : Fin d ⊕ Fin (M - d) ≃ { μ : Fin (M + 1) // μ ≠ μ_star } :=
    Equiv.ofBijective (fun x => ⟨ι_rem x, hι_rem_ne x⟩) ⟨by
      rintro (r₁ | a₁) (r₂ | a₂) h
      · have h1 := Sum.inl.inj (e_col.injective (Subtype.ext_iff.mp h))
        exact congrArg Sum.inl (s_star.succAbove_right_injective h1)
      · exact absurd (e_col.injective (Subtype.ext_iff.mp h)) Sum.inl_ne_inr
      · exact absurd (e_col.injective (Subtype.ext_iff.mp h)) Sum.inr_ne_inl
      · exact congrArg Sum.inr (Sum.inr.inj (e_col.injective (Subtype.ext_iff.mp h))),
      by
        rintro ⟨μ, hμ⟩
        rcases hsymm : e_col.symm μ with s | a
        · have hs_ne : s ≠ s_star := by
            intro hs_eq
            apply hμ
            rw [← e_col.apply_symm_apply μ, hsymm, hs_eq]
          obtain ⟨r, hr⟩ := Fin.exists_succAbove_eq hs_ne
          refine ⟨Sum.inl r, Subtype.ext ?_⟩
          dsimp only [ι_rem, Sum.elim_inl]
          rw [hr, ← hsymm, e_col.apply_symm_apply]
        · refine ⟨Sum.inr a, Subtype.ext ?_⟩
          dsimp only [ι_rem, Sum.elim_inr]
          rw [← hsymm, e_col.apply_symm_apply]⟩

  let e_M : Fin M ≃ Fin d ⊕ Fin (M - d) := e_sub₁.trans e_sub₂.symm
  have he_M_comp : ∀ i : Fin M, ι_rem (e_M i) = ι_M i := by
    intro i
    exact congrArg Subtype.val (e_sub₂.apply_symm_apply (e_sub₁ i))

  let D_sum : Fin d ⊕ Fin (M - d) → Derivation k R_con R_con := Sum.elim D_base D_free
  let D_con : Fin M → Derivation k R_con R_con := fun j => D_sum (e_M j)
  let J_sum : Matrix (Fin d ⊕ Fin (M - d)) (Fin d ⊕ Fin (M - d)) R_con :=
    Matrix.of fun α β => D_sum β (w₀ (ι_rem α))

  have hJac_sum_ne : J_sum.det ≠ 0 := by
    intro h0
    have hev_det : ev_hat J_sum.det = 0 := by rw [h0, map_zero]
    rw [RingHom.map_det] at hev_det
    let A_sub : Matrix (Fin d) (Fin d) k := Matrix.of fun r j => A_piv (s_star.succAbove r) j
    let B₁₂ : Matrix (Fin d) (Fin (M - d)) k :=
      Matrix.of fun r b => ev_hat (D_free b (w₀ (e_col (Sum.inl (s_star.succAbove r)))))
    have hblocks : ev_hat.mapMatrix J_sum = Matrix.fromBlocks A_sub B₁₂ 0 1 := by
      ext (r | a) (j | b)
      · rfl
      · rfl
      · simp only [RingHom.mapMatrix_apply, Matrix.map_apply, J_sum, Matrix.of_apply,
          D_sum, Sum.elim_inl, ι_rem, Sum.elim_inr, hw₀_inr, hD_base_X, map_zero,
          Matrix.fromBlocks_apply₂₁, Matrix.zero_apply]
      · change ev_hat ((MvPolynomial.pderiv b) (w₀ (e_col (Sum.inr a)))) =
          (1 : Matrix (Fin (M - d)) (Fin (M - d)) k) a b
        rw [hw₀_inr, Matrix.one_apply]
        by_cases hab : a = b
        · subst hab
          rw [MvPolynomial.pderiv_X_self, map_one]
          simp only [↓reduceIte]
        · rw [MvPolynomial.pderiv_X, Pi.single_eq_of_ne hab, map_zero]
          simp only [hab, ↓reduceIte]
    rw [hblocks, Matrix.det_fromBlocks_zero₂₁, Matrix.det_one, mul_one] at hev_det
    exact hs_star hev_det

  have hJac : Matrix.det (Matrix.of fun i j : Fin M => D_con j (w₀ (ι_M i))) ≠ 0 := by
    have hsub : (Matrix.of fun i j : Fin M => D_con j (w₀ (ι_M i))) =
        J_sum.submatrix e_M e_M := by
      ext i j
      simp only [Matrix.of_apply, Matrix.submatrix_apply, J_sum, D_con, he_M_comp]
    rw [hsub, Matrix.det_submatrix_equiv_self]
    exact hJac_sum_ne

  
  
  
  let y_M : Fin M → R_con := fun i => w₀ (ι_M i)
  have hChain : ∀ (δ : Derivation k R_con R_con) (F : MvPolynomial (Fin M) k),
      δ (MvPolynomial.aeval y_M F) =
        ∑ i : Fin M, MvPolynomial.aeval y_M (MvPolynomial.pderiv i F) * δ (y_M i) := by
    intro δ F
    induction F using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.aeval_C, δ.map_algebraMap]
      refine (Finset.sum_eq_zero fun i _ => ?_).symm
      rw [← MvPolynomial.algebraMap_eq, Derivation.map_algebraMap, map_zero, zero_mul]
    | add p q ihp ihq =>
      simp_rw [map_add, ihp, ihq, add_mul, Finset.sum_add_distrib]
    | mul_X p j ihp =>
      rw [map_mul, MvPolynomial.aeval_X, δ.leibniz, smul_eq_mul, smul_eq_mul, ihp, Finset.mul_sum]
      have hrhs : ∀ i : Fin M,
          MvPolynomial.aeval y_M (MvPolynomial.pderiv i (p * MvPolynomial.X j)) * δ (y_M i) =
            MvPolynomial.aeval y_M p * MvPolynomial.aeval y_M ((MvPolynomial.pderiv i) (MvPolynomial.X j : MvPolynomial (Fin M) k)) * δ (y_M i) +
              y_M j * (MvPolynomial.aeval y_M (MvPolynomial.pderiv i p) * δ (y_M i)) := by
        intro i
        rw [(MvPolynomial.pderiv i).leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul,
          MvPolynomial.aeval_X]
        ring
      simp_rw [hrhs, Finset.sum_add_distrib]
      congr 1
      have hsingle : ∀ i : Fin M,
          MvPolynomial.aeval y_M p * MvPolynomial.aeval y_M ((MvPolynomial.pderiv i) (MvPolynomial.X j : MvPolynomial (Fin M) k)) * δ (y_M i) =
            if i = j then MvPolynomial.aeval y_M p * δ (y_M j) else 0 := by
        intro i
        by_cases hij : i = j
        · subst hij
          rw [MvPolynomial.pderiv_X_self, map_one, mul_one]
          simp only [↓reduceIte]
        · rw [MvPolynomial.pderiv_X, Pi.single_eq_of_ne' hij, map_zero, mul_zero, zero_mul]
          simp only [hij, ↓reduceIte]
      simp_rw [hsingle]
      rw [Finset.sum_ite_eq' Finset.univ j]
      simp only [Finset.mem_univ, ↓reduceIte]

  have hpderiv_coeff : ∀ (i : Fin M) (F : MvPolynomial (Fin M) k) (m : Fin M →₀ ℕ),
      (MvPolynomial.pderiv i F).coeff m = F.coeff (m + Finsupp.single i 1) * ((m i + 1 : ℕ) : k) := by
    intro i F m
    conv_lhs => rw [F.as_sum]
    rw [map_sum, MvPolynomial.coeff_sum]
    simp_rw [MvPolynomial.pderiv_monomial, MvPolynomial.coeff_monomial]
    have hterm : ∀ s ∈ F.support,
        (if s - Finsupp.single i 1 = m then F.coeff s * ((s i : ℕ) : k) else 0) =
          if s = m + Finsupp.single i 1 then F.coeff s * ((s i : ℕ) : k) else 0 := by
      intro s _
      by_cases hsi : s i = 0
      · have hne : s ≠ m + Finsupp.single i 1 := by
          intro heq
          have h1 := congrArg (fun f : Fin M →₀ ℕ => f i) heq
          simp only [Finsupp.add_apply, Finsupp.single_eq_same] at h1
          omega
        simp only [hsi, Nat.cast_zero, mul_zero, ite_self, hne, ↓reduceIte]
      · have heqv : s - Finsupp.single i 1 = m ↔ s = m + Finsupp.single i 1 := by
          refine ⟨fun h => ?_, fun h => ?_⟩
          · ext j
            have hj := congrArg (fun f : Fin M →₀ ℕ => f j) h
            simp only [Finsupp.tsub_apply, Finsupp.add_apply] at hj ⊢
            by_cases hji : j = i
            · subst hji; simp only [Finsupp.single_eq_same] at hj ⊢; omega
            · simp only [Finsupp.single_eq_of_ne' (Ne.symm hji)] at hj ⊢; omega
          · subst h
            ext j
            simp only [Finsupp.tsub_apply, Finsupp.add_apply]
            by_cases hji : j = i
            · subst hji; simp only [Finsupp.single_eq_same]; omega
            · simp only [Finsupp.single_eq_of_ne' (Ne.symm hji)]; omega
        by_cases hm_eq : s = m + Finsupp.single i 1
        · have hs_sub : s - Finsupp.single i 1 = m := heqv.mpr hm_eq
          simp only [hs_sub, ↓reduceIte]
          simp only [hm_eq, ↓reduceIte]
        · have hnot : ¬ (s - Finsupp.single i 1 = m) := fun h => hm_eq (heqv.mp h)
          simp only [hnot, hm_eq, ↓reduceIte]
    rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq' F.support (m + Finsupp.single i 1)]
    by_cases hmem : m + Finsupp.single i 1 ∈ F.support
    · simp only [hmem, ↓reduceIte, Finsupp.add_apply, Finsupp.single_eq_same]
    · simp only [hmem, ↓reduceIte, MvPolynomial.notMem_support_iff.mp hmem, zero_mul]

  have hInj_aeval : Function.Injective (MvPolynomial.aeval (R := k) y_M) := by
    by_contra h_not
    unfold Function.Injective at h_not
    push_neg at h_not
    obtain ⟨G_a, G_b, hGab_eq, hGab_ne⟩ := h_not
    let G_init := G_a - G_b
    have hG_ne : G_init ≠ 0 := sub_ne_zero.mpr hGab_ne
    have hG_ker : MvPolynomial.aeval y_M G_init = 0 := by
      dsimp only [G_init]; rw [map_sub, hGab_eq, sub_self]
    have hex_deg : ∃ n : ℕ, ∃ G : MvPolynomial (Fin M) k,
        G ≠ 0 ∧ MvPolynomial.aeval y_M G = 0 ∧ G.totalDegree = n :=
      ⟨G_init.totalDegree, G_init, hG_ne, hG_ker, rfl⟩
    let n₀ := Nat.find hex_deg
    obtain ⟨G₀, hG₀_ne, hG₀_eval, hG₀_deg⟩ := Nat.find_spec hex_deg
    have hG₀_min : ∀ H : MvPolynomial (Fin M) k, H ≠ 0 → MvPolynomial.aeval y_M H = 0 →
        n₀ ≤ H.totalDegree := fun H hH1 hH2 => Nat.find_min' hex_deg ⟨H, hH1, hH2, rfl⟩

    have hn₀_pos : 1 ≤ n₀ := by
      by_contra h0
      have hn0 : n₀ = 0 := by omega
      have hGC := hEqC_of_deg0 G₀ (hG₀_deg.trans hn0)
      have hc_ne : G₀.coeff 0 ≠ 0 := by
        intro hc0; rw [hc0, map_zero] at hGC; exact hG₀_ne hGC
      rw [hGC, MvPolynomial.aeval_C] at hG₀_eval
      exact hc_ne ((RingHom.injective (algebraMap k R_con)) (hG₀_eval.trans (map_zero _).symm))

    
    let u_vec : Fin M → R_con := fun i => MvPolynomial.aeval y_M (MvPolynomial.pderiv i G₀)
    let J_M : Matrix (Fin M) (Fin M) R_con := Matrix.of fun i j => D_con j (y_M i)
    have hvec0 : Matrix.vecMul u_vec J_M = 0 := by
      ext j
      simp only [Matrix.vecMul, dotProduct, J_M, Matrix.of_apply, Pi.zero_apply]
      rw [← hChain (D_con j) G₀, hG₀_eval, map_zero]
    have hu_zero : ∀ i : Fin M, u_vec i = 0 := by
      intro i
      have hadj0 : Matrix.vecMul (0 : Fin M → R_con) J_M.adjugate i = 0 := by
        simp only [Matrix.vecMul, dotProduct, Pi.zero_apply, zero_mul, Finset.sum_const_zero]
      have hadj := (congrFun (congrArg (fun v => Matrix.vecMul v J_M.adjugate) hvec0) i).trans hadj0
      rw [Matrix.vecMul_vecMul, Matrix.mul_adjugate] at hadj
      simp only [Matrix.vecMul, dotProduct, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul,
        mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte] at hadj
      exact (mul_eq_zero.mp hadj).resolve_right hJac

    
    have hpderiv_zero : ∀ i : Fin M, MvPolynomial.pderiv i G₀ = 0 := by
      intro i
      by_contra hp_ne
      have hdeg_le : (MvPolynomial.pderiv i G₀).totalDegree ≤ n₀ - 1 := by
        rw [MvPolynomial.totalDegree]
        refine Finset.sup_le fun m hm => ?_
        have hcoeff_ne : (MvPolynomial.pderiv i G₀).coeff m ≠ 0 :=
          MvPolynomial.mem_support_iff.mp hm
        rw [hpderiv_coeff] at hcoeff_ne
        have hm1_mem : m + Finsupp.single i 1 ∈ G₀.support :=
          MvPolynomial.mem_support_iff.mpr (left_ne_zero_of_mul hcoeff_ne)
        have hle := MvPolynomial.le_totalDegree hm1_mem
        rw [hG₀_deg, Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
          Finsupp.sum_single_index rfl] at hle
        omega
      have hmin := hG₀_min (MvPolynomial.pderiv i G₀) hp_ne (hu_zero i)
      omega

    
    have hcast_zero : ∀ s ∈ G₀.support, ∀ i : Fin M, ((s i : ℕ) : k) = 0 := by
      intro s hs i
      by_cases hsi : s i = 0
      · rw [hsi, Nat.cast_zero]
      · let m : Fin M →₀ ℕ := s - Finsupp.single i 1
        have hms : m + Finsupp.single i 1 = s := by
          ext j
          simp only [m, Finsupp.add_apply, Finsupp.tsub_apply]
          by_cases hji : j = i
          · subst hji; simp only [Finsupp.single_eq_same]; omega
          · simp only [Finsupp.single_eq_of_ne' (Ne.symm hji)]; omega
        have hmi : m i + 1 = s i := by
          have h1 := congrArg (fun f : Fin M →₀ ℕ => f i) hms
          simpa only [Finsupp.add_apply, Finsupp.single_eq_same] using h1
        have hp0 : (MvPolynomial.pderiv i G₀).coeff m = 0 := by
          rw [hpderiv_zero i, ← MvPolynomial.lcoeff_apply k m, map_zero]
        rw [hpderiv_coeff, hms, hmi] at hp0
        exact (mul_eq_zero.mp hp0).resolve_left (MvPolynomial.mem_support_iff.mp hs)

    rcases CharP.exists' k with hCharZero | ⟨p, hp_fact, hp_char⟩
    · 
      letI : CharZero k := hCharZero
      have hall0 : G₀.totalDegree = 0 := by
        rw [MvPolynomial.totalDegree_eq_zero_iff]
        intro s hs i
        exact Nat.cast_eq_zero.mp (hcast_zero s hs i)
      omega
    · 
      haveI : Fact p.Prime := hp_fact
      haveI : CharP k p := hp_char
      have hp_prime : p.Prime := hp_fact.out
      haveI : CharP (MvPolynomial (Fin M) k) p :=
        (RingHom.charP_iff_charP (MvPolynomial.C : k →+* MvPolynomial (Fin M) k) p).mp hp_char
      haveI : ExpChar (MvPolynomial (Fin M) k) p := ExpChar.prime hp_prime
      have hdvd : ∀ s ∈ G₀.support, ∀ i : Fin M, p ∣ s i := fun s hs i =>
        (CharP.cast_eq_zero_iff k p (s i)).mp (hcast_zero s hs i)
      have hex_root : ∀ c : k, ∃ r : k, r ^ p = c := by
        intro c
        have hdeg : (Polynomial.X ^ p - Polynomial.C c).degree ≠ 0 := by
          rw [Polynomial.degree_X_pow_sub_C hp_prime.pos c]
          exact Nat.cast_ne_zero.mpr hp_prime.ne_zero
        obtain ⟨r, hr⟩ := IsAlgClosed.exists_root _ hdeg
        rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow,
          Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hr
        exact ⟨r, hr⟩
      choose rp hrp using hex_root
      let G₁ : MvPolynomial (Fin M) k :=
        ∑ s ∈ G₀.support, MvPolynomial.monomial
          (s.mapRange (· / p) (Nat.zero_div p)) (rp (G₀.coeff s))
      have hG₁_pow : G₁ ^ p = G₀ := by
        dsimp only [G₁]
        rw [sum_pow_char p]
        conv_rhs => rw [G₀.as_sum]
        refine Finset.sum_congr rfl fun s hs => ?_
        rw [MvPolynomial.monomial_pow, hrp]
        have hm_eq_s : p • s.mapRange (· / p) (Nat.zero_div p) = s := by
          ext i
          simp only [Finsupp.smul_apply, Finsupp.mapRange_apply, smul_eq_mul]
          exact Nat.mul_div_cancel' (hdvd s hs i)
        rw [hm_eq_s]
      have hG₁_ne : G₁ ≠ 0 := by
        intro h0
        rw [h0, zero_pow hp_prime.ne_zero] at hG₁_pow
        exact hG₀_ne hG₁_pow.symm
      have hG₁_eval : MvPolynomial.aeval y_M G₁ = 0 := by
        have hpow0 : (MvPolynomial.aeval y_M G₁) ^ p = 0 := by
          rw [← map_pow, hG₁_pow, hG₀_eval]
        exact (pow_eq_zero_iff hp_prime.ne_zero).mp hpow0
      have hpow_deg : ∀ n : ℕ, (G₁ ^ n).totalDegree = n * G₁.totalDegree := by
        intro n
        induction n with
        | zero => simp only [pow_zero, MvPolynomial.totalDegree_one, zero_mul]
        | succ n ih =>
          rw [pow_succ, MvPolynomial.totalDegree_mul_of_isDomain (pow_ne_zero n hG₁_ne) hG₁_ne,
            ih, Nat.succ_mul]
      have hn₀_eq : n₀ = p * G₁.totalDegree := by
        change Nat.find hex_deg = p * G₁.totalDegree
        rw [← hG₀_deg, ← hG₁_pow, hpow_deg p]
      have hmin₁ := hG₀_min G₁ hG₁_ne hG₁_eval
      have hp2 : 2 ≤ p := hp_prime.two_le
      nlinarith

  have hInjM : Function.Injective (Φ₀.comp (MvPolynomial.rename ι_M)) := by
    have hcomp : Φ₀.comp (MvPolynomial.rename ι_M) = MvPolynomial.aeval y_M := by
      ext i; simp only [AlgHom.comp_apply, MvPolynomial.rename_X, MvPolynomial.aeval_X, y_M, w₀]
    rw [hcomp]
    exact hInj_aeval

  
  haveI : FaithfulSMul k B₀ :=
    (faithfulSMul_iff_algebraMap_injective k B₀).mpr (RingHom.injective _)
  haveI : FaithfulSMul B₀ R_con :=
    (faithfulSMul_iff_algebraMap_injective B₀ R_con).mpr (MvPolynomial.C_injective (Fin (M - d)) B₀)
  have hTr_Rcon : Algebra.trdeg k R_con ≤ (M : Cardinal.{u}) := by
    rw [← trdeg_add_eq k B₀ (A := R_con), MvPolynomial.trdeg_of_isDomain,
      Cardinal.mk_fintype, Fintype.card_fin, Cardinal.lift_natCast]
    calc Algebra.trdeg k B₀ + ((M - d : ℕ) : Cardinal.{u})
        ≤ (d : Cardinal.{u}) + ((M - d : ℕ) : Cardinal.{u}) := add_le_add hTrB₀ le_rfl
      _ = ((d + (M - d) : ℕ) : Cardinal.{u}) := (Nat.cast_add d (M - d)).symm
      _ = (M : Cardinal.{u}) := by rw [hd_add]

  
  have hex_ker : ∃ F : MvPolynomial (Fin (M + 1)) k, F ≠ 0 ∧ Φ₀ F = 0 := by
    have hnot_inj_Φ : ¬ Function.Injective Φ₀ := by
      intro hinj
      have hle := trdeg_le_of_injective Φ₀ hinj
      rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Fintype.card_fin,
        Cardinal.lift_natCast] at hle
      have hle' : M + 1 ≤ M := Nat.cast_le.mp (hle.trans hTr_Rcon)
      omega
    unfold Function.Injective at hnot_inj_Φ
    push_neg at hnot_inj_Φ
    obtain ⟨F₁, F₂, h12, hne12⟩ := hnot_inj_Φ
    exact ⟨F₁ - F₂, sub_ne_zero.mpr hne12, by rw [map_sub, h12, sub_self]⟩

  obtain ⟨F_ker, hF_ker_ne, hF_ker0⟩ := hex_ker
  have hex_hom_ker : ∃ e_ker : ℕ, MvPolynomial.homogeneousComponent e_ker F_ker ≠ 0 := by
    by_contra hall0
    push_neg at hall0
    apply hF_ker_ne
    rw [← MvPolynomial.sum_homogeneousComponent F_ker]
    exact Finset.sum_eq_zero fun i _ => hall0 i

  obtain ⟨e_ker, hG_hom_ne⟩ := hex_hom_ker
  let G_hom := MvPolynomial.homogeneousComponent e_ker F_ker
  have hG_hom_mem : G_hom ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k e_ker :=
    MvPolynomial.homogeneousComponent_isHomogeneous e_ker F_ker
  have hΦ₀_Ghom : Φ₀ G_hom = 0 := by
    rw [← (hHomComp Φ₀ hΦ₀_hom).2 e_ker F_ker, hF_ker0, map_zero]

  have hG_not_unit : ¬ IsUnit G_hom :=
    fun hu => (hu.map Φ₀.toRingHom.toMonoidHom).ne_zero hΦ₀_Ghom
  obtain ⟨f_fac, hf_irr, hf_prod, _⟩ :=
    (WfDvdMonoid.not_unit_iff_exists_factors_eq G_hom hG_hom_ne).mp hG_not_unit
  have hf_prod0 : Φ₀ f_fac.prod = 0 := by rw [hf_prod, hΦ₀_Ghom]
  rw [map_multiset_prod, Multiset.prod_eq_zero_iff, Multiset.mem_map] at hf_prod0
  obtain ⟨P_amb, hP_in_f, hΦ₀_Pamb⟩ := hf_prod0
  have hP_irr : Irreducible P_amb := hf_irr P_amb hP_in_f
  have hP_dvd_Ghom : P_amb ∣ G_hom := hf_prod ▸ Multiset.dvd_prod hP_in_f

  
  obtain ⟨Q_cof, hG_eq_PQ⟩ := hP_dvd_Ghom
  have hP_ne : P_amb ≠ 0 := hP_irr.ne_zero
  have hQcof_ne : Q_cof ≠ 0 := by
    intro h0; rw [h0, mul_zero] at hG_eq_PQ; exact hG_hom_ne hG_eq_PQ
  let S_P : Finset ℕ :=
    (Finset.range (P_amb.totalDegree + 1)).filter (fun i => MvPolynomial.homogeneousComponent i P_amb ≠ 0)
  let S_Q : Finset ℕ :=
    (Finset.range (Q_cof.totalDegree + 1)).filter (fun j => MvPolynomial.homogeneousComponent j Q_cof ≠ 0)
  have hSP_ne : S_P.Nonempty := by
    by_contra hemp
    rw [Finset.not_nonempty_iff_eq_empty] at hemp
    apply hP_ne
    rw [← MvPolynomial.sum_homogeneousComponent P_amb]
    refine Finset.sum_eq_zero fun i hi => ?_
    by_contra hni
    have hmem : i ∈ S_P := Finset.mem_filter.mpr ⟨hi, hni⟩
    rw [hemp] at hmem; exact Finset.notMem_empty i hmem
  have hSQ_ne : S_Q.Nonempty := by
    by_contra hemp
    rw [Finset.not_nonempty_iff_eq_empty] at hemp
    apply hQcof_ne
    rw [← MvPolynomial.sum_homogeneousComponent Q_cof]
    refine Finset.sum_eq_zero fun j hj => ?_
    by_contra hnj
    have hmem : j ∈ S_Q := Finset.mem_filter.mpr ⟨hj, hnj⟩
    rw [hemp] at hmem; exact Finset.notMem_empty j hmem

  have hP_sum_SP : ∑ i ∈ S_P, MvPolynomial.homogeneousComponent i P_amb = P_amb := by
    conv_rhs => rw [← MvPolynomial.sum_homogeneousComponent P_amb]
    exact Finset.sum_filter_ne_zero _
  have hQ_sum_SQ : ∑ j ∈ S_Q, MvPolynomial.homogeneousComponent j Q_cof = Q_cof := by
    conv_rhs => rw [← MvPolynomial.sum_homogeneousComponent Q_cof]
    exact Finset.sum_filter_ne_zero _

  have hComp_PQ : ∀ m : ℕ, MvPolynomial.homogeneousComponent m G_hom =
      ∑ i ∈ S_P, ∑ j ∈ S_Q,
        if m = i + j then
          MvPolynomial.homogeneousComponent i P_amb * MvPolynomial.homogeneousComponent j Q_cof
        else 0 := by
    intro m
    conv_lhs => rw [hG_eq_PQ, ← hP_sum_SP, ← hQ_sum_SQ]
    rw [Finset.sum_mul, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    exact MvPolynomial.homogeneousComponent_of_mem
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr
        ((MvPolynomial.homogeneousComponent_isHomogeneous i P_amb).mul
          (MvPolynomial.homogeneousComponent_isHomogeneous j Q_cof)))

  let D_amb : ℕ := S_P.min' hSP_ne
  have hMin_sum : D_amb + S_Q.min' hSQ_ne = e_ker := by
    have hcomp_ne : MvPolynomial.homogeneousComponent (D_amb + S_Q.min' hSQ_ne) G_hom ≠ 0 := by
      rw [hComp_PQ]
      have h1 : ∀ i ∈ S_P, (∑ j ∈ S_Q,
          if D_amb + S_Q.min' hSQ_ne = i + j then
            MvPolynomial.homogeneousComponent i P_amb * MvPolynomial.homogeneousComponent j Q_cof
          else 0) =
          if i = D_amb then
            MvPolynomial.homogeneousComponent D_amb P_amb *
              MvPolynomial.homogeneousComponent (S_Q.min' hSQ_ne) Q_cof
          else 0 := by
        intro i hi
        have hi_ge : D_amb ≤ i := S_P.min'_le i hi
        by_cases hid : i = D_amb
        · subst hid
          simp only [↓reduceIte]
          have hj_eq : ∀ j ∈ S_Q, (if D_amb + S_Q.min' hSQ_ne = D_amb + j then
              MvPolynomial.homogeneousComponent D_amb P_amb * MvPolynomial.homogeneousComponent j Q_cof
            else 0) = if j = S_Q.min' hSQ_ne then
              MvPolynomial.homogeneousComponent D_amb P_amb * MvPolynomial.homogeneousComponent j Q_cof
            else 0 := fun j _ => by congr 1; exact propext ⟨fun h => by omega, fun h => by omega⟩
          rw [Finset.sum_congr rfl hj_eq, Finset.sum_ite_eq' S_Q (S_Q.min' hSQ_ne)]
          simp only [S_Q.min'_mem hSQ_ne, ↓reduceIte]
        · simp only [hid, ↓reduceIte]
          refine Finset.sum_eq_zero fun j hj => ?_
          have hj_ge : S_Q.min' hSQ_ne ≤ j := S_Q.min'_le j hj
          have hne : D_amb + S_Q.min' hSQ_ne ≠ i + j := by omega
          simp only [hne, ↓reduceIte]
      rw [Finset.sum_congr rfl h1, Finset.sum_ite_eq' S_P D_amb]
      simp only [D_amb, S_P.min'_mem hSP_ne, ↓reduceIte]
      exact mul_ne_zero (Finset.mem_filter.mp (S_P.min'_mem hSP_ne)).2
        (Finset.mem_filter.mp (S_Q.min'_mem hSQ_ne)).2
    rw [MvPolynomial.homogeneousComponent_of_mem hG_hom_mem] at hcomp_ne
    by_contra hne; simp only [hne, ↓reduceIte, ne_eq, not_true_eq_false] at hcomp_ne

  have hMax_sum : S_P.max' hSP_ne + S_Q.max' hSQ_ne = e_ker := by
    have hcomp_ne : MvPolynomial.homogeneousComponent (S_P.max' hSP_ne + S_Q.max' hSQ_ne) G_hom ≠ 0 := by
      rw [hComp_PQ]
      have h1 : ∀ i ∈ S_P, (∑ j ∈ S_Q,
          if S_P.max' hSP_ne + S_Q.max' hSQ_ne = i + j then
            MvPolynomial.homogeneousComponent i P_amb * MvPolynomial.homogeneousComponent j Q_cof
          else 0) =
          if i = S_P.max' hSP_ne then
            MvPolynomial.homogeneousComponent (S_P.max' hSP_ne) P_amb *
              MvPolynomial.homogeneousComponent (S_Q.max' hSQ_ne) Q_cof
          else 0 := by
        intro i hi
        have hi_le : i ≤ S_P.max' hSP_ne := S_P.le_max' i hi
        by_cases hid : i = S_P.max' hSP_ne
        · subst hid
          simp only [↓reduceIte]
          have hj_eq : ∀ j ∈ S_Q, (if S_P.max' hSP_ne + S_Q.max' hSQ_ne = S_P.max' hSP_ne + j then
              MvPolynomial.homogeneousComponent (S_P.max' hSP_ne) P_amb *
                MvPolynomial.homogeneousComponent j Q_cof
            else 0) = if j = S_Q.max' hSQ_ne then
              MvPolynomial.homogeneousComponent (S_P.max' hSP_ne) P_amb *
                MvPolynomial.homogeneousComponent j Q_cof
            else 0 := fun j _ => by congr 1; exact propext ⟨fun h => by omega, fun h => by omega⟩
          rw [Finset.sum_congr rfl hj_eq, Finset.sum_ite_eq' S_Q (S_Q.max' hSQ_ne)]
          simp only [S_Q.max'_mem hSQ_ne, ↓reduceIte]
        · simp only [hid, ↓reduceIte]
          refine Finset.sum_eq_zero fun j hj => ?_
          have hj_le : j ≤ S_Q.max' hSQ_ne := S_Q.le_max' j hj
          have hne : S_P.max' hSP_ne + S_Q.max' hSQ_ne ≠ i + j := by omega
          simp only [hne, ↓reduceIte]
      rw [Finset.sum_congr rfl h1, Finset.sum_ite_eq' S_P (S_P.max' hSP_ne)]
      simp only [S_P.max'_mem hSP_ne, ↓reduceIte]
      exact mul_ne_zero (Finset.mem_filter.mp (S_P.max'_mem hSP_ne)).2
        (Finset.mem_filter.mp (S_Q.max'_mem hSQ_ne)).2
    rw [MvPolynomial.homogeneousComponent_of_mem hG_hom_mem] at hcomp_ne
    by_contra hne; simp only [hne, ↓reduceIte, ne_eq, not_true_eq_false] at hcomp_ne

  have hP_hom : P_amb ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k D_amb := by
    have hP_le : D_amb ≤ S_P.max' hSP_ne := S_P.min'_le _ (S_P.max'_mem hSP_ne)
    have hQ_le : S_Q.min' hSQ_ne ≤ S_Q.max' hSQ_ne := S_Q.min'_le _ (S_Q.max'_mem hSQ_ne)
    have hD_eq_max : S_P.max' hSP_ne = D_amb := by omega
    have hSP_eq : S_P = {D_amb} := by
      ext i
      refine ⟨fun hi => Finset.mem_singleton.mpr ?_, fun hi => ?_⟩
      · have h1 : D_amb ≤ i := S_P.min'_le i hi
        have h2 : i ≤ S_P.max' hSP_ne := S_P.le_max' i hi
        omega
      · rw [Finset.mem_singleton.mp hi]; exact S_P.min'_mem hSP_ne
    rw [← hP_sum_SP, hSP_eq, Finset.sum_singleton]
    exact MvPolynomial.homogeneousComponent_isHomogeneous D_amb P_amb

  have hD_amb : 1 ≤ D_amb := by
    by_contra h0
    have hD0 : D_amb = 0 := by omega
    rw [hD0] at hP_hom
    have hPC := hEqC_of_hom0 P_amb hP_hom
    have hc_ne : P_amb.coeff 0 ≠ 0 := by
      intro hc0; rw [hc0, map_zero] at hPC; exact hP_ne hPC
    rw [hPC] at hP_irr
    exact hP_irr.not_isUnit ((IsUnit.mk0 _ hc_ne).map MvPolynomial.C)

  
  let R₀ := MvPolynomial (Fin M) k
  let K₀ := FractionRing R₀
  let E_poly : MvPolynomial (Fin (M + 1)) k ≃ₐ[k] Polynomial R₀ :=
    (MvPolynomial.renameEquiv k (Equiv.swap 0 μ_star)).trans (MvPolynomial.finSuccEquiv k M)

  have hE_symm_C : ∀ r : R₀, E_poly.symm (Polynomial.C r) = MvPolynomial.rename ι_M r := by
    have hring : E_poly.symm.toRingHom.comp Polynomial.C = (MvPolynomial.rename ι_M).toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro a
        change E_poly.symm (Polynomial.C (MvPolynomial.C a)) =
          (MvPolynomial.rename ι_M) (MvPolynomial.C a)
        dsimp only [E_poly]
        rw [AlgEquiv.symm_trans_apply, MvPolynomial.rename_C]
        have h1 : (MvPolynomial.finSuccEquiv k M).symm (Polynomial.C (MvPolynomial.C a)) =
            MvPolynomial.C a :=
          RingHom.congr_fun (MvPolynomial.finSuccEquiv_comp_C_eq_C M) a
        rw [h1, MvPolynomial.renameEquiv_symm, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_C]
      · intro j
        change E_poly.symm (Polynomial.C (MvPolynomial.X j)) =
          (MvPolynomial.rename ι_M) (MvPolynomial.X j)
        dsimp only [E_poly]
        rw [AlgEquiv.symm_trans_apply, MvPolynomial.rename_X, ← MvPolynomial.finSuccEquiv_X_succ,
          AlgEquiv.symm_apply_apply, MvPolynomial.renameEquiv_symm, MvPolynomial.renameEquiv_apply,
          Equiv.symm_swap, MvPolynomial.rename_X]
    exact fun r => RingHom.congr_fun hring r

  let ψ_poly : Polynomial R₀ →+* R_con := Φ₀.toRingHom.comp E_poly.symm.toRingHom
  have hψ_C_inj : ∀ r : R₀, ψ_poly (Polynomial.C r) = 0 → r = 0 := by
    intro r hr
    change Φ₀ (E_poly.symm (Polynomial.C r)) = 0 at hr
    rw [hE_symm_C] at hr
    exact hInjM (hr.trans (map_zero _).symm)

  let p₀ : Polynomial R₀ := E_poly P_amb
  have hp₀_irr : Irreducible p₀ := by
    exact (MulEquiv.irreducible_iff E_poly.toRingEquiv.toMulEquiv).mpr hP_irr
  have hψ_p₀ : ψ_poly p₀ = 0 := by
    change Φ₀ (E_poly.symm (E_poly P_amb)) = 0
    rw [E_poly.symm_apply_apply, hΦ₀_Pamb]
  have hp₀_deg : 1 ≤ p₀.natDegree := by
    by_contra h0
    have hd0 : p₀.natDegree = 0 := by omega
    have hpC := Polynomial.eq_C_of_natDegree_eq_zero hd0
    have hc0 : p₀.coeff 0 = 0 := hψ_C_inj _ (hpC ▸ hψ_p₀)
    rw [hc0, map_zero] at hpC
    exact hp₀_irr.ne_zero hpC
  have hp₀_prim : p₀.IsPrimitive := by
    rw [Polynomial.isPrimitive_iff_isUnit_of_C_dvd]
    intro r ⟨q, hq⟩
    rcases hp₀_irr.isUnit_or_isUnit hq with huC | huq
    · exact Polynomial.isUnit_C.mp huC
    · exfalso
      have hdeg0 : p₀.natDegree = 0 := by
        have hle := Polynomial.natDegree_mul_le (p := Polynomial.C r) (q := q)
        rw [← hq, Polynomial.natDegree_C, Polynomial.natDegree_eq_zero_of_isUnit huq, add_zero] at hle
        omega
      omega

  let p_K : Polynomial K₀ := p₀.map (algebraMap R₀ K₀)
  have hp_K_irr : Irreducible p_K := by
    exact (Polynomial.IsPrimitive.irreducible_iff_irreducible_map_fraction_map (K := K₀) hp₀_prim).mp hp₀_irr

  have hClearDenom : ∀ p : Polynomial K₀, ∃ (d₀ : R₀) (p' : Polynomial R₀),
      d₀ ≠ 0 ∧ p'.map (algebraMap R₀ K₀) = Polynomial.C (algebraMap R₀ K₀ d₀) * p := by
    intro p
    obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors R₀) p.support p.coeff
    choose c hc using fun i (hi : i ∈ p.support) => hb i hi
    refine ⟨b.1, ∑ i ∈ p.support,
        Polynomial.C (if hi : i ∈ p.support then c i hi else 0) * Polynomial.X ^ i,
      mem_nonZeroDivisors_iff_ne_zero.mp b.2, ?_⟩
    conv_rhs => rw [p.as_sum_support_C_mul_X_pow]
    rw [Finset.mul_sum, Polynomial.map_sum]
    refine Finset.sum_congr rfl fun i hi => ?_
    simp only [dif_pos hi, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow,
      Polynomial.map_X, hc i hi, Algebra.smul_def, ← mul_assoc, ← Polynomial.C_mul]

  have hKer_Φ₀ : RingHom.ker Φ₀.toRingHom = Ideal.span {P_amb} := by
    ext F
    rw [RingHom.mem_ker, Ideal.mem_span_singleton]
    refine ⟨fun hF => ?_, fun ⟨Q, hQ⟩ => ?_⟩
    · let f : Polynomial R₀ := E_poly F
      have hψ_f : ψ_poly f = 0 := by
        change Φ₀ (E_poly.symm (E_poly F)) = 0
        rw [E_poly.symm_apply_apply]; exact hF
      let f_K : Polynomial K₀ := f.map (algebraMap R₀ K₀)
      have hpK_dvd : p_K ∣ f_K := by
        by_contra hndvd
        obtain ⟨u_K, v_K, huv⟩ := hp_K_irr.coprime_iff_not_dvd.mpr hndvd
        obtain ⟨d₁, u', hd₁, hu'⟩ := hClearDenom u_K
        obtain ⟨d₂, v', hd₂, hv'⟩ := hClearDenom v_K
        have hmap_eq : (((Polynomial.C d₂ * u') * p₀ + (Polynomial.C d₁ * v') * f)).map
            (algebraMap R₀ K₀) = (Polynomial.C (d₁ * d₂)).map (algebraMap R₀ K₀) := by
          simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, hu', hv']
          change (Polynomial.C (algebraMap R₀ K₀ d₂) *
              (Polynomial.C (algebraMap R₀ K₀ d₁) * u_K)) * p_K +
            (Polynomial.C (algebraMap R₀ K₀ d₁) *
              (Polynomial.C (algebraMap R₀ K₀ d₂) * v_K)) * f_K =
            Polynomial.C (algebraMap R₀ K₀ (d₁ * d₂))
          rw [map_mul, Polynomial.C_mul]
          calc (Polynomial.C (algebraMap R₀ K₀ d₂) *
                (Polynomial.C (algebraMap R₀ K₀ d₁) * u_K)) * p_K +
              (Polynomial.C (algebraMap R₀ K₀ d₁) *
                (Polynomial.C (algebraMap R₀ K₀ d₂) * v_K)) * f_K
              = (Polynomial.C (algebraMap R₀ K₀ d₁) * Polynomial.C (algebraMap R₀ K₀ d₂)) *
                  (u_K * p_K + v_K * f_K) := by ring
            _ = Polynomial.C (algebraMap R₀ K₀ d₁) * Polynomial.C (algebraMap R₀ K₀ d₂) := by
                rw [huv, mul_one]
        have heq_R₀ := Polynomial.map_injective _ (IsFractionRing.injective R₀ K₀) hmap_eq
        have hψ_rhs : ψ_poly (Polynomial.C (d₁ * d₂)) = 0 := by
          rw [← heq_R₀]
          simp only [map_add, map_mul, hψ_p₀, hψ_f, mul_zero, add_zero]
        exact mul_ne_zero hd₁ hd₂ (hψ_C_inj _ hψ_rhs)
      obtain ⟨q_K, hq_K⟩ := hpK_dvd
      obtain ⟨d₀, q', hd₀, hq'⟩ := hClearDenom q_K
      have hmap_eq2 : (Polynomial.C d₀ * f).map (algebraMap R₀ K₀) =
          (p₀ * q').map (algebraMap R₀ K₀) := by
        simp only [Polynomial.map_mul, Polynomial.map_C, hq']
        change Polynomial.C (algebraMap R₀ K₀ d₀) * f_K =
          p_K * (Polynomial.C (algebraMap R₀ K₀ d₀) * q_K)
        rw [hq_K]
        ring
      have heq2 := Polynomial.map_injective _ (IsFractionRing.injective R₀ K₀) hmap_eq2
      have hp₀_prime : Prime p₀ := UniqueFactorizationMonoid.irreducible_iff_prime.mp hp₀_irr
      have hdvd_prod : p₀ ∣ Polynomial.C d₀ * f := ⟨q', heq2⟩
      rcases hp₀_prime.dvd_or_dvd hdvd_prod with hdvd_C | ⟨q₀, hq₀⟩
      · exfalso
        obtain ⟨h_cof, hh_cof⟩ := hdvd_C
        have hC_ne : (Polynomial.C d₀ : Polynomial R₀) ≠ 0 := Polynomial.C_ne_zero.mpr hd₀
        have hh_ne : h_cof ≠ 0 := fun h0 => hC_ne (by rw [hh_cof, h0, mul_zero])
        have hdeg_C := congrArg Polynomial.natDegree hh_cof
        rw [Polynomial.natDegree_C, Polynomial.natDegree_mul hp₀_irr.ne_zero hh_ne] at hdeg_C
        omega
      · refine ⟨E_poly.symm q₀, ?_⟩
        have h1 := congrArg E_poly.symm hq₀
        simpa only [map_mul, E_poly.symm_apply_apply, f, p₀] using h1
    · change Φ₀ F = 0
      rw [hQ, map_mul, hΦ₀_Pamb, zero_mul]

  
  
  
  let S_im : Subalgebra k R_con := Φ₀.range
  let α_M : R₀ →+* R_con := (Φ₀.comp (MvPolynomial.rename ι_M)).toRingHom

  have hAlgDep : ∀ z : R_con, ∃ p : Polynomial R₀, p ≠ 0 ∧ Polynomial.eval₂ α_M z p = 0 := by
    intro z
    let θ_z : MvPolynomial (Option (Fin M)) k →ₐ[k] R_con :=
      MvPolynomial.aeval (fun o => match o with | none => z | some i => y_M i)
    have hnot_inj : ¬ Function.Injective θ_z := by
      intro hinj
      have hle := trdeg_le_of_injective θ_z hinj
      rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Fintype.card_option,
        Fintype.card_fin, Cardinal.lift_natCast] at hle
      have hle' : M + 1 ≤ M := Nat.cast_le.mp (hle.trans hTr_Rcon)
      omega
    unfold Function.Injective at hnot_inj
    push_neg at hnot_inj
    obtain ⟨F₁, F₂, h12, hne12⟩ := hnot_inj
    let F := F₁ - F₂
    have hF_ne : F ≠ 0 := sub_ne_zero.mpr hne12
    have hF_ker : θ_z F = 0 := by dsimp only [F]; rw [map_sub, h12, sub_self]
    let p : Polynomial R₀ := MvPolynomial.optionEquivLeft k (Fin M) F
    have hp_ne : p ≠ 0 := by
      exact (MvPolynomial.optionEquivLeft k (Fin M)).injective.ne_iff.mpr
        (by simpa only [map_zero] using hF_ne)
    refine ⟨p, hp_ne, ?_⟩
    have hcomp_z : (Polynomial.eval₂RingHom α_M z).comp
        (MvPolynomial.optionEquivLeft k (Fin M)).toRingHom = θ_z.toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro a
        change Polynomial.eval₂ α_M z ((MvPolynomial.optionEquivLeft k (Fin M)) (MvPolynomial.C a)) =
          θ_z (MvPolynomial.C a)
        rw [MvPolynomial.optionEquivLeft_C, Polynomial.eval₂_C]
        change (Φ₀.comp (MvPolynomial.rename ι_M)) (MvPolynomial.C a) = θ_z (MvPolynomial.C a)
        rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, ← MvPolynomial.algebraMap_eq,
          AlgHom.commutes]
      · rintro (_ | i)
        · change Polynomial.eval₂ α_M z
            ((MvPolynomial.optionEquivLeft k (Fin M)) (MvPolynomial.X none)) =
              θ_z (MvPolynomial.X none)
          rw [MvPolynomial.optionEquivLeft_X_none, Polynomial.eval₂_X]
          dsimp only [θ_z]
          rw [MvPolynomial.aeval_X]
        · change Polynomial.eval₂ α_M z
            ((MvPolynomial.optionEquivLeft k (Fin M)) (MvPolynomial.X (some i))) =
              θ_z (MvPolynomial.X (some i))
          rw [MvPolynomial.optionEquivLeft_X_some, Polynomial.eval₂_C]
          change (Φ₀.comp (MvPolynomial.rename ι_M)) (MvPolynomial.X i) =
            θ_z (MvPolynomial.X (some i))
          rw [AlgHom.comp_apply, MvPolynomial.rename_X]
          change y_M i = θ_z (MvPolynomial.X (some i))
          dsimp only [θ_z]
          rw [MvPolynomial.aeval_X]
    exact (RingHom.congr_fun hcomp_z F).trans hF_ker

  
  obtain ⟨s_gen, hs_gen⟩ := Algebra.FiniteType.out (R := k) (A := B₀)
  have hGenInt : ∀ b : B₀, ∃ (e_b : ℕ) (Q_b : MvPolynomial (Fin (M + 1)) k),
      Q_b ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k e_b ∧
      Φ₀ Q_b ≠ 0 ∧
      _root_.IsIntegral ↥S_im (Φ₀ Q_b * MvPolynomial.C b) := by
    intro b
    obtain ⟨p, hp_ne, hp_eval⟩ := hAlgDep (MvPolynomial.C b)
    let r := p.natDegree
    have hpr_ne : p.coeff r ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hp_ne
    let A : ℕ → MvPolynomial (Fin (M + 1)) k := fun j => MvPolynomial.rename ι_M (p.coeff j)
    have hΦ_Ar_ne : Φ₀ (A r) ≠ 0 :=
      fun h0 => hpr_ne (hInjM (h0.trans (map_zero _).symm))
    have hex_eb : ∃ e_b : ℕ, MvPolynomial.homogeneousComponent e_b (Φ₀ (A r)) ≠ 0 := by
      by_contra hall0; push_neg at hall0; apply hΦ_Ar_ne
      rw [← MvPolynomial.sum_homogeneousComponent (Φ₀ (A r))]
      exact Finset.sum_eq_zero fun i _ => hall0 i
    obtain ⟨e_b, heb_ne⟩ := hex_eb
    let B_hom : ℕ → MvPolynomial (Fin (M + 1)) k :=
      fun j => MvPolynomial.homogeneousComponent e_b (A j)
    let Q_b := B_hom r
    have hQb_hom : Q_b ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k e_b :=
      MvPolynomial.homogeneousComponent_isHomogeneous e_b (A r)
    have hΦ_Qb_ne : Φ₀ Q_b ≠ 0 := by
      dsimp only [Q_b, B_hom]
      rwa [← (hHomComp Φ₀ hΦ₀_hom).2 e_b (A r)]
    have hsum0 : ∑ j ∈ Finset.range (r + 1), Φ₀ (B_hom j) * (MvPolynomial.C b) ^ j = 0 := by
      rw [Polynomial.eval₂_eq_sum_range] at hp_eval
      have hc := congrArg (MvPolynomial.homogeneousComponent e_b) hp_eval
      rw [map_zero, map_sum] at hc
      refine Eq.trans ?_ hc
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← map_pow, mul_comm (Φ₀ (B_hom j)), ← MvPolynomial.smul_eq_C_mul,
        mul_comm (α_M (p.coeff j)), ← MvPolynomial.smul_eq_C_mul, LinearMap.map_smul]
      change b ^ j • Φ₀ (B_hom j) = b ^ j • (MvPolynomial.homogeneousComponent e_b) (Φ₀ (A j))
      rw [(hHomComp Φ₀ hΦ₀_hom).2 e_b (A j)]
    let q_im : Polynomial ↥S_im :=
      ∑ j ∈ Finset.range (r + 1),
        Polynomial.C (Φ₀.rangeRestrict (B_hom j)) * Polynomial.X ^ j
    have hq_coeff : ∀ j : ℕ, q_im.coeff j =
        if j < r + 1 then Φ₀.rangeRestrict (B_hom j) else 0 := by
      intro j
      dsimp only [q_im]
      rw [Polynomial.finsetSum_coeff]
      simp_rw [Polynomial.coeff_C_mul_X_pow]
      by_cases hj : j < r + 1
      · rw [Finset.sum_ite_eq (Finset.range (r + 1)) j]
        simp only [Finset.mem_range, hj, ↓reduceIte]
      · simp only [hj, ↓reduceIte]
        refine Finset.sum_eq_zero fun i hi => ?_
        rw [Finset.mem_range] at hi
        have hne : j ≠ i := by omega
        simp only [hne, ↓reduceIte]
    have hq_deg : q_im.natDegree = r := by
      refine Polynomial.natDegree_eq_of_le_of_coeff_ne_zero ?_ ?_
      · rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
        intro n hn
        rw [hq_coeff n]
        have hnot : ¬ (n < r + 1) := by omega
        simp only [hnot, ↓reduceIte]
      · rw [hq_coeff r]
        simp only [Nat.lt_succ_self, ↓reduceIte]
        intro h0
        exact hΦ_Qb_ne (congrArg Subtype.val h0)
    have hq_ne : q_im ≠ 0 := by
      intro h0
      have hc0 := congrArg (fun f => f.coeff r) h0
      rw [Polynomial.coeff_zero, hq_coeff r] at hc0
      simp only [Nat.lt_succ_self, ↓reduceIte] at hc0
      exact hΦ_Qb_ne (congrArg Subtype.val hc0)
    have hq_lc : (algebraMap ↥S_im R_con) q_im.leadingCoeff = Φ₀ Q_b := by
      rw [Polynomial.leadingCoeff, hq_deg, hq_coeff r]
      simp only [Nat.lt_succ_self, ↓reduceIte]; rfl
    have hq_aeval : Polynomial.aeval (MvPolynomial.C b : R_con) q_im = 0 := by
      dsimp only [q_im]
      rw [map_sum]
      refine Eq.trans ?_ hsum0
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]; rfl
    have hnorm0 := Polynomial.integralNormalization_aeval_eq_zero hq_aeval
      (fun x hx => Subtype.ext hx)
    rw [hq_lc] at hnorm0
    exact ⟨e_b, Q_b, hQb_hom, hΦ_Qb_ne,
      ⟨q_im.integralNormalization, Polynomial.monic_integralNormalization hq_ne, hnorm0⟩⟩

  choose e_gen Q_gen hQ_gen_hom hΦ_Qgen_ne hInt_Qgen using fun b : ↥s_gen => hGenInt b.1
  let E_dom : ℕ := ∑ b : ↥s_gen, e_gen b
  let Q_dom : MvPolynomial (Fin (M + 1)) k := ∏ b : ↥s_gen, Q_gen b
  have hQ_dom_hom : Q_dom ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k E_dom := by
    exact hProdHomog_u Finset.univ e_gen Q_gen (fun b _ => hQ_gen_hom b)
  have hΦ_Qdom_ne : Φ₀ Q_dom ≠ 0 := by
    dsimp only [Q_dom]
    rw [map_prod, Finset.prod_ne_zero_iff]
    exact fun b _ => hΦ_Qgen_ne b

  
  have hex_H : ∃ n : ℕ, ∃ p : Polynomial R₀,
      p ≠ 0 ∧ Polynomial.eval₂ α_M H₀ p = 0 ∧ p.natDegree = n := by
    obtain ⟨p, hp1, hp2⟩ := hAlgDep H₀
    exact ⟨p.natDegree, p, hp1, hp2, rfl⟩
  let n_H := Nat.find hex_H
  obtain ⟨p_H, hp_H_ne, hp_H_eval, hp_H_deg⟩ := Nat.find_spec hex_H
  have hp_H0_ne : p_H.coeff 0 ≠ 0 := by
    intro hc0
    obtain ⟨q_H, hq_H⟩ := Polynomial.X_dvd_iff.mpr hc0
    have hq_ne : q_H ≠ 0 := fun h0 => hp_H_ne (by rw [hq_H, h0, mul_zero])
    have hq_eval : Polynomial.eval₂ α_M H₀ q_H = 0 := by
      rw [hq_H, Polynomial.eval₂_mul, Polynomial.eval₂_X] at hp_H_eval
      exact (mul_eq_zero.mp hp_H_eval).resolve_left hH₀_ne
    have hdeg_eq : p_H.natDegree = 1 + q_H.natDegree := by
      rw [hq_H, Polynomial.natDegree_mul Polynomial.X_ne_zero hq_ne, Polynomial.natDegree_X]
    have hmin := Nat.find_min' hex_H ⟨q_H, hq_ne, hq_eval, rfl⟩
    omega

  let C₀ := MvPolynomial.rename ι_M (p_H.coeff 0)
  have hΦ_C₀_ne : Φ₀ C₀ ≠ 0 :=
    fun h0 => hp_H0_ne (hInjM (h0.trans (map_zero _).symm))
  have hC₀_dvd : ∃ Y : R_con, Φ₀ C₀ = H₀ * Y := by
    rw [Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ'] at hp_H_eval
    simp only [pow_zero, mul_one] at hp_H_eval
    refine ⟨- ∑ k_idx ∈ Finset.range p_H.natDegree, α_M (p_H.coeff (k_idx + 1)) * H₀ ^ k_idx, ?_⟩
    have h1 : Φ₀ C₀ = - ∑ k_idx ∈ Finset.range p_H.natDegree,
        α_M (p_H.coeff (k_idx + 1)) * H₀ ^ (k_idx + 1) :=
      eq_neg_of_add_eq_zero_right hp_H_eval
    rw [h1, mul_neg, Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun k_idx _ => ?_
    rw [pow_succ]; ring
  obtain ⟨Y_H, hC₀_HY⟩ := hC₀_dvd
  have hex_eodp : ∃ e_odp : ℕ, MvPolynomial.homogeneousComponent e_odp (Φ₀ C₀) ≠ 0 := by
    by_contra hall0; push_neg at hall0; apply hΦ_C₀_ne
    rw [← MvPolynomial.sum_homogeneousComponent (Φ₀ C₀)]
    exact Finset.sum_eq_zero fun i _ => hall0 i
  obtain ⟨e_odp, he_odp_ne⟩ := hex_eodp
  let Q_odp := MvPolynomial.homogeneousComponent e_odp C₀
  have hQ_odp_hom : Q_odp ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k e_odp :=
    MvPolynomial.homogeneousComponent_isHomogeneous e_odp C₀
  have hΦ_Qodp_ne : Φ₀ Q_odp ≠ 0 := by
    dsimp only [Q_odp]
    rwa [← (hHomComp Φ₀ hΦ₀_hom).2 e_odp C₀]
  have hH₀_dvd_Qodp : H₀ ∣ Φ₀ Q_odp := by
    dsimp only [Q_odp]
    rw [← (hHomComp Φ₀ hΦ₀_hom).2 e_odp C₀, hC₀_HY,
      ← MvPolynomial.sum_homogeneousComponent Y_H, Finset.mul_sum, map_sum]
    refine Finset.dvd_sum fun m _ => ?_
    have hhm : H₀ * MvPolynomial.homogeneousComponent m Y_H ∈
        MvPolynomial.homogeneousSubmodule (Fin (M - d)) B₀ (d + m) :=
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mp hH₀_hom).mul
        (MvPolynomial.homogeneousComponent_isHomogeneous m Y_H)
    rw [MvPolynomial.homogeneousComponent_of_mem hhm]
    split_ifs
    · exact dvd_mul_right H₀ _
    · exact dvd_zero H₀

  let E₀ : ℕ := E_dom + e_odp
  let Q₀ : MvPolynomial (Fin (M + 1)) k := Q_dom * Q_odp
  have hQ₀_hom : Q₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k E₀ :=
    ((MvPolynomial.mem_homogeneousSubmodule _ _).mp hQ_dom_hom).mul
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mp hQ_odp_hom)
  have hQ₀_ndvd : ¬ (P_amb ∣ Q₀) := by
    intro hdvd
    have hmem : Q₀ ∈ RingHom.ker Φ₀.toRingHom := by
      rw [hKer_Φ₀, Ideal.mem_span_singleton]; exact hdvd
    rw [RingHom.mem_ker] at hmem
    change Φ₀ (Q_dom * Q_odp) = 0 at hmem
    rw [map_mul] at hmem
    exact mul_ne_zero hΦ_Qdom_ne hΦ_Qodp_ne hmem

  
  let q_dom : ↥S_im := ⟨Φ₀ Q_dom, ⟨Q_dom, rfl⟩⟩
  let A_base := Localization.Away q_dom
  let A_top := Localization.Away (Φ₀ Q_dom)
  let f_to_top : ↥S_im →ₐ[k] A_top :=
    (IsScalarTower.toAlgHom k R_con A_top).comp S_im.val
  have hf_qdom_unit : ∀ y : Submonoid.powers q_dom, IsUnit (f_to_top y.1) := by
    rintro ⟨_, n, rfl⟩
    rw [map_pow]
    exact (IsLocalization.Away.algebraMap_isUnit (S := A_top) (Φ₀ Q_dom)).pow n
  let ι_loc : A_base →ₐ[k] A_top :=
    IsLocalization.liftAlgHom (M := Submonoid.powers q_dom) (S := A_base)
      (f := f_to_top) hf_qdom_unit
  letI : Algebra A_base A_top := ι_loc.toRingHom.toAlgebra
  have hι_loc_alg : ∀ x : ↥S_im,
      algebraMap A_base A_top (algebraMap ↥S_im A_base x) = algebraMap R_con A_top x.1 :=
    fun x => IsLocalization.lift_eq (M := Submonoid.powers q_dom) _ x

  have hKer_ι_bot : RingHom.ker (algebraMap A_base A_top) = ⊥ := by
    rw [Submodule.eq_bot_iff]
    intro y hy
    let n := (IsLocalization.Away.sec q_dom y).2
    have hsec := IsLocalization.Away.sec_spec q_dom y
    have h1 := congrArg (algebraMap A_base A_top) hsec
    rw [map_mul, hy, zero_mul, hι_loc_alg] at h1
    have ha_top : algebraMap R_con A_top ((IsLocalization.Away.sec q_dom y).1).1 = 0 := h1.symm
    have h_inj_top : Function.Injective (algebraMap R_con A_top) :=
      IsLocalization.injective A_top (Submonoid.powers_le.mpr
        (mem_nonZeroDivisors_iff_ne_zero.mpr hΦ_Qdom_ne))
    have ha0 : (IsLocalization.Away.sec q_dom y).1 = 0 :=
      Subtype.ext (h_inj_top (ha_top.trans (map_zero _).symm))
    rw [ha0, map_zero, map_pow] at hsec
    exact ((IsLocalization.Away.algebraMap_isUnit (S := A_base) q_dom).pow n).mul_left_eq_zero.mp hsec

  have hInt_ext : Algebra.IsIntegral A_base A_top := by
    rw [Algebra.isIntegral_def]
    let IC : Subalgebra A_base A_top := integralClosure A_base A_top
    let g_B : B₀ →ₐ[k] A_top :=
      (IsScalarTower.toAlgHom k R_con A_top).comp (IsScalarTower.toAlgHom k B₀ R_con)
    have hB_in_IC : ∀ b : B₀, g_B b ∈ IC := by
      let S_pull : Subalgebra k B₀ := (IC.restrictScalars k).comap g_B
      have hle : (⊤ : Subalgebra k B₀) ≤ S_pull := by
        rw [← hs_gen, Algebra.adjoin_le_iff]
        intro b hb
        change g_B b ∈ IC
        let b_sub : ↥s_gen := ⟨b, hb⟩
        have hcomp_sq : (algebraMap A_base A_top).comp (algebraMap ↥S_im A_base) =
            (algebraMap R_con A_top).comp (algebraMap ↥S_im R_con) := by
          ext x; exact hι_loc_alg x
        have hint1 : _root_.IsIntegral A_base (algebraMap R_con A_top (Φ₀ (Q_gen b_sub) * MvPolynomial.C b)) :=
          _root_.IsIntegral.map_of_comp_eq (algebraMap ↥S_im A_base) (algebraMap R_con A_top)
            hcomp_sq (hInt_Qgen b_sub)
        obtain ⟨R_cof, hQdom_fac⟩ := Finset.dvd_prod_of_mem Q_gen (Finset.mem_univ b_sub)
        let q_b : ↥S_im := ⟨Φ₀ (Q_gen b_sub), ⟨Q_gen b_sub, rfl⟩⟩
        let r_cof : ↥S_im := ⟨Φ₀ R_cof, ⟨R_cof, rfl⟩⟩
        have hqb_mul : q_b * r_cof = q_dom := by
          apply Subtype.ext
          change Φ₀ (Q_gen b_sub) * Φ₀ R_cof = Φ₀ Q_dom
          rw [← map_mul, ← hQdom_fac]
        have hu_qdom : IsUnit (algebraMap ↥S_im A_base q_dom) :=
          IsLocalization.Away.algebraMap_isUnit q_dom
        have hmap_prod : algebraMap ↥S_im A_base (q_b * r_cof) =
            algebraMap ↥S_im A_base q_dom := congrArg (algebraMap ↥S_im A_base) hqb_mul
        rw [← hmap_prod, map_mul] at hu_qdom
        obtain ⟨u_qb, hu_qb⟩ := isUnit_of_mul_isUnit_left hu_qdom
        have hinv_eq : algebraMap A_base A_top (↑u_qb⁻¹ : A_base) *
            algebraMap R_con A_top (Φ₀ (Q_gen b_sub) * MvPolynomial.C b) = g_B b := by
          rw [map_mul, ← mul_assoc, ← hι_loc_alg q_b, ← hu_qb, ← map_mul,
            Units.inv_mul, map_one, one_mul]
          rfl
        rw [← hinv_eq]
        exact IC.mul_mem (IC.algebraMap_mem _) hint1
      exact fun b => hle Algebra.mem_top
    have hR_in_IC : ∀ P : R_con, algebraMap R_con A_top P ∈ IC := by
      intro P
      induction P using MvPolynomial.induction_on with
      | C b => exact hB_in_IC b
      | add P₁ P₂ ih₁ ih₂ => rw [map_add]; exact IC.add_mem ih₁ ih₂
      | mul_X P₁ a ih₁ =>
        rw [map_mul]
        refine IC.mul_mem ih₁ ?_
        let x_a : ↥S_im := ⟨MvPolynomial.X a, ⟨MvPolynomial.X (e_col (Sum.inr a)), hw₀_inr a⟩⟩
        have hxa : algebraMap R_con A_top (MvPolynomial.X a) =
            algebraMap A_base A_top (algebraMap ↥S_im A_base x_a) := (hι_loc_alg x_a).symm
        rw [hxa]
        exact IC.algebraMap_mem _
    intro y
    let n := (IsLocalization.Away.sec (Φ₀ Q_dom) y).2
    have hsec := IsLocalization.Away.sec_spec (Φ₀ Q_dom) y
    let u_dom : A_baseˣ := (IsLocalization.Away.algebraMap_isUnit (S := A_base) q_dom).unit
    have hu_map : algebraMap A_base A_top (u_dom : A_base) = algebraMap R_con A_top (Φ₀ Q_dom) :=
      hι_loc_alg q_dom
    have hy_eq : y = algebraMap R_con A_top (IsLocalization.Away.sec (Φ₀ Q_dom) y).1 *
        algebraMap A_base A_top (↑(u_dom⁻¹ ^ n) : A_base) := by
      calc y = y * (algebraMap A_base A_top (u_dom : A_base) ^ n *
              algebraMap A_base A_top (↑(u_dom⁻¹ ^ n) : A_base)) := by
              rw [← map_pow, ← map_mul, ← Units.val_pow_eq_pow_val,
                ← Units.val_mul, ← mul_pow, mul_inv_cancel, one_pow, Units.val_one, map_one, mul_one]
        _ = (y * (algebraMap R_con A_top (Φ₀ Q_dom)) ^ n) *
              algebraMap A_base A_top (↑(u_dom⁻¹ ^ n) : A_base) := by
              rw [hu_map, mul_assoc]
        _ = algebraMap R_con A_top (IsLocalization.Away.sec (Φ₀ Q_dom) y).1 *
              algebraMap A_base A_top (↑(u_dom⁻¹ ^ n) : A_base) := by
              rw [← map_pow, hsec]
    rw [hy_eq]
    exact IC.mul_mem (hR_in_IC _) (IC.algebraMap_mem _)

  have hFT_Rcon : Algebra.FiniteType k R_con := by
    exact Algebra.FiniteType.trans (S := B₀) inferInstance inferInstance
  have hFT_Atop : Algebra.FiniteType k A_top := by
    exact Algebra.FiniteType.trans (S := R_con) hFT_Rcon inferInstance
  haveI : Algebra.FiniteType k A_top := hFT_Atop

  
  have hGoingUpNull : ∀ (A₁ A₂ : Type u) [CommRing A₁] [CommRing A₂]
      [Algebra k A₁] [Algebra k A₂] [Algebra.FiniteType k A₂]
      (ι₁₂ : A₁ →ₐ[k] A₂),
      RingHom.ker ι₁₂.toRingHom = ⊥ →
      (letI : Algebra A₁ A₂ := ι₁₂.toRingHom.toAlgebra
       Algebra.IsIntegral A₁ A₂) →
      ∀ (χ₁ : A₁ →ₐ[k] k),
        ∃ (ev₂ : A₂ →ₐ[k] k), ∀ x : A₁, ev₂ (ι₁₂ x) = χ₁ x := by
    intro A₁ A₂ _ _ _ _ _ ι₁₂ hker_bot hInt₁₂ χ₁
    letI : Algebra A₁ A₂ := ι₁₂.toRingHom.toAlgebra
    haveI : Algebra.IsIntegral A₁ A₂ := hInt₁₂
    have hχ₁_surj : Function.Surjective χ₁.toRingHom :=
      fun a => ⟨algebraMap k A₁ a, χ₁.commutes a⟩
    let 𝔪₁ : Ideal A₁ := RingHom.ker χ₁.toRingHom
    haveI : 𝔪₁.IsMaximal := RingHom.ker_isMaximal_of_surjective χ₁.toRingHom hχ₁_surj
    have hker_le : RingHom.ker (algebraMap A₁ A₂) ≤ 𝔪₁ := by
      change RingHom.ker ι₁₂.toRingHom ≤ 𝔪₁
      rw [hker_bot]; exact bot_le
    obtain ⟨𝔐, h𝔐_max, h𝔐_over⟩ :=
      Ideal.exists_ideal_over_maximal_of_isIntegral (S := A₂) 𝔪₁ hker_le
    obtain ⟨t_gen, ht_gen⟩ := Algebra.FiniteType.out (R := k) (A := A₂)
    let φ_top : MvPolynomial ↥t_gen k →ₐ[k] A₂ := MvPolynomial.aeval Subtype.val
    have hφ_surj : Function.Surjective φ_top := by
      intro y
      have htop : (⊤ : Subalgebra k A₂) ≤ φ_top.range := by
        rw [← ht_gen, Algebra.adjoin_le_iff]
        intro t ht
        exact ⟨MvPolynomial.X ⟨t, ht⟩, MvPolynomial.aeval_X _ _⟩
      exact htop Algebra.mem_top
    have h𝔪_poly_max : (Ideal.comap φ_top.toRingHom 𝔐).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective φ_top.toRingHom hφ_surj
    obtain ⟨x_top, hx_top⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (K := k)).mp h𝔪_poly_max
    have hmem_𝔐_iff : ∀ P : MvPolynomial ↥t_gen k,
        φ_top P ∈ 𝔐 ↔ MvPolynomial.aeval x_top P = 0 := by
      intro P
      change P ∈ Ideal.comap φ_top.toRingHom 𝔐 ↔ _
      rw [hx_top, MvPolynomial.mem_vanishingIdeal_singleton_iff]
    have hev_top_wd : ∀ P₁ P₂ : MvPolynomial ↥t_gen k,
        φ_top P₁ = φ_top P₂ → MvPolynomial.aeval x_top P₁ = MvPolynomial.aeval x_top P₂ := by
      intro P₁ P₂ h12
      have h0 : φ_top (P₁ - P₂) ∈ 𝔐 := by
        rw [map_sub, h12, sub_self]; exact 𝔐.zero_mem
      rw [hmem_𝔐_iff, map_sub, sub_eq_zero] at h0
      exact h0
    let ev₂ : A₂ →ₐ[k] k :=
      { toFun := fun y => MvPolynomial.aeval x_top (Classical.choose (hφ_surj y))
        map_one' := (hev_top_wd _ 1 ((Classical.choose_spec (hφ_surj 1)).trans (map_one φ_top).symm)).trans (map_one _)
        map_mul' := fun y₁ y₂ => (hev_top_wd _ (Classical.choose (hφ_surj y₁) * Classical.choose (hφ_surj y₂))
          ((Classical.choose_spec (hφ_surj (y₁ * y₂))).trans ((map_mul φ_top _ _).trans
            (congrArg₂ (· * ·) (Classical.choose_spec (hφ_surj y₁)) (Classical.choose_spec (hφ_surj y₂)))).symm)).trans
          (map_mul _ _ _)
        map_zero' := (hev_top_wd _ 0 ((Classical.choose_spec (hφ_surj 0)).trans (map_zero φ_top).symm)).trans (map_zero _)
        map_add' := fun y₁ y₂ => (hev_top_wd _ (Classical.choose (hφ_surj y₁) + Classical.choose (hφ_surj y₂))
          ((Classical.choose_spec (hφ_surj (y₁ + y₂))).trans ((map_add φ_top _ _).trans
            (congrArg₂ (· + ·) (Classical.choose_spec (hφ_surj y₁)) (Classical.choose_spec (hφ_surj y₂)))).symm)).trans
          (map_add _ _ _)
        commutes' := fun a => (hev_top_wd _ (MvPolynomial.C a)
          ((Classical.choose_spec (hφ_surj (algebraMap k A₂ a))).trans (φ_top.commutes a).symm)).trans
          (MvPolynomial.aeval_C x_top a) }
    have hev₂_zero_iff : ∀ y : A₂, ev₂ y = 0 ↔ y ∈ 𝔐 := by
      intro y
      have hspec := Classical.choose_spec (hφ_surj y)
      conv_rhs => rw [← hspec]
      exact (hmem_𝔐_iff _).symm
    refine ⟨ev₂, fun x => ?_⟩
    have hmem : x - algebraMap k A₁ (χ₁ x) ∈ 𝔪₁ := by
      rw [RingHom.mem_ker]; change χ₁ (x - algebraMap k A₁ (χ₁ x)) = 0
      rw [map_sub, χ₁.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
    rw [← h𝔐_over, Ideal.mem_comap] at hmem
    change ι₁₂ (x - algebraMap k A₁ (χ₁ x)) ∈ 𝔐 at hmem
    rw [map_sub, ι₁₂.commutes, ← hev₂_zero_iff, map_sub, ev₂.commutes,
      Algebra.algebraMap_self, RingHom.id_apply, sub_eq_zero] at hmem
    exact hmem

  
  
  
  refine ⟨D_amb, P_amb, E₀, Q₀, hD_amb, hP_hom, hP_irr, hKer_Φ₀, hQ₀_hom, hQ₀_ndvd, ?_, ?_⟩
  · 
    intro c _ hc_P hc_Q₀
    dsimp only [Q₀] at hc_Q₀
    rw [map_mul] at hc_Q₀
    have hc_Qdom : MvPolynomial.eval c Q_dom ≠ 0 := left_ne_zero_of_mul hc_Q₀
    have hc_Qodp : MvPolynomial.eval c Q_odp ≠ 0 := right_ne_zero_of_mul hc_Q₀

    
    have hχ_wd : ∀ (F₁ F₂ : MvPolynomial (Fin (M + 1)) k),
        Φ₀ F₁ = Φ₀ F₂ → MvPolynomial.eval c F₁ = MvPolynomial.eval c F₂ := by
      intro F₁ F₂ h12
      have hmem : F₁ - F₂ ∈ RingHom.ker Φ₀.toRingHom := by
        rw [RingHom.mem_ker]; change Φ₀ (F₁ - F₂) = 0; rw [map_sub, h12, sub_self]
      rw [hKer_Φ₀, Ideal.mem_span_singleton] at hmem
      obtain ⟨H, hH⟩ := hmem
      have hev := congrArg (MvPolynomial.eval c) hH
      rw [map_sub, map_mul, hc_P, zero_mul, sub_eq_zero] at hev
      exact hev

    let χ_c : ↥S_im →ₐ[k] k :=
      { toFun := fun x => MvPolynomial.eval c (Classical.choose x.2)
        map_one' := by
          have h := hχ_wd (Classical.choose (S_im.one_mem)) 1
            ((Classical.choose_spec S_im.one_mem).trans (map_one Φ₀).symm)
          exact h.trans (map_one _)
        map_mul' := fun x y => by
          have h := hχ_wd (Classical.choose (S_im.mul_mem x.2 y.2))
            (Classical.choose x.2 * Classical.choose y.2)
            ((Classical.choose_spec (S_im.mul_mem x.2 y.2)).trans
              ((map_mul Φ₀ _ _).trans (congrArg₂ (· * ·)
                (Classical.choose_spec x.2) (Classical.choose_spec y.2))).symm)
          exact h.trans (map_mul _ _ _)
        map_zero' := by
          have h := hχ_wd (Classical.choose (S_im.zero_mem)) 0
            ((Classical.choose_spec S_im.zero_mem).trans (map_zero Φ₀).symm)
          exact h.trans (map_zero _)
        map_add' := fun x y => by
          have h := hχ_wd (Classical.choose (S_im.add_mem x.2 y.2))
            (Classical.choose x.2 + Classical.choose y.2)
            ((Classical.choose_spec (S_im.add_mem x.2 y.2)).trans
              ((map_add Φ₀ _ _).trans (congrArg₂ (· + ·)
                (Classical.choose_spec x.2) (Classical.choose_spec y.2))).symm)
          exact h.trans (map_add _ _ _)
        commutes' := fun a => by
          have h := hχ_wd (Classical.choose ((algebraMap k ↥S_im a).2)) (MvPolynomial.C a)
            ((Classical.choose_spec (algebraMap k ↥S_im a).2).trans (Φ₀.commutes a).symm)
          exact h.trans (MvPolynomial.eval_C a) }

    have hχ_c_apply : ∀ F : MvPolynomial (Fin (M + 1)) k,
        χ_c ⟨Φ₀ F, ⟨F, rfl⟩⟩ = MvPolynomial.eval c F := by
      intro F
      let x_F : ↥S_im := ⟨Φ₀ F, ⟨F, rfl⟩⟩
      exact hχ_wd (Classical.choose x_F.2) F (Classical.choose_spec x_F.2)

    let χ_loc : A_base →ₐ[k] k :=
      IsLocalization.liftAlgHom (M := Submonoid.powers q_dom) (S := A_base) (f := χ_c)
        (by
          rintro ⟨_, n, rfl⟩
          rw [map_pow, hχ_c_apply Q_dom]
          exact (IsUnit.mk0 _ hc_Qdom).pow n)

    obtain ⟨ev_top, hev_top_comp_base⟩ :=
      hGoingUpNull A_base A_top ι_loc hKer_ι_bot hInt_ext χ_loc

    let ev_R : R_con →ₐ[k] k := ev_top.comp (IsScalarTower.toAlgHom k R_con A_top)
    have hev_R_Φ₀ : ∀ F : MvPolynomial (Fin (M + 1)) k,
        ev_R (Φ₀ F) = MvPolynomial.eval c F := by
      intro F
      let x_F : ↥S_im := ⟨Φ₀ F, ⟨F, rfl⟩⟩
      change ev_top (algebraMap R_con A_top x_F.1) = _
      rw [← hι_loc_alg x_F]
      exact (hev_top_comp_base (algebraMap ↥S_im A_base x_F)).trans
        ((IsLocalization.lift_eq (M := Submonoid.powers q_dom) _ x_F).trans (hχ_c_apply F))

    have hev_R_H₀ : ev_R H₀ ≠ 0 := by
      obtain ⟨Z_H, hZ_H⟩ := hH₀_dvd_Qodp
      intro h0
      apply hc_Qodp
      rw [← hev_R_Φ₀ Q_odp, hZ_H, map_mul, h0, zero_mul]

    let ev_c : B₀ →ₐ[k] k := ev_R.comp (IsScalarTower.toAlgHom k B₀ R_con)
    have hev_c_C : ∀ b : B₀, ev_R (MvPolynomial.C b) = ev_c b := fun _ => rfl

    refine ⟨ev_c, ?_, ?_⟩
    · intro r
      have hr := congrArg ev_R (hΦ₀_ann r)
      rw [map_zero, map_sum] at hr
      refine Eq.trans ?_ hr
      refine Finset.sum_congr rfl fun μ _ => ?_
      rw [map_mul, hev_c_C, hev_R_Φ₀ (MvPolynomial.X μ), MvPolynomial.eval_X]
    · have hmat : ev_R.toRingHom.mapMatrix (Matrix.of fun i j : Fin d =>
          ∑ μ : Fin (M + 1), w₀ μ * MvPolynomial.C (D₀ j (D₀ i (X₀ μ)))) =
        Matrix.of fun i j : Fin d =>
          ∑ μ : Fin (M + 1), c μ * ev_c (D₀ j (D₀ i (X₀ μ))) := by
        ext i j
        simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, map_sum, map_mul]
        refine Finset.sum_congr rfl fun μ _ => ?_
        change ev_R (Φ₀ (MvPolynomial.X μ)) * ev_R (MvPolynomial.C ((D₀ j) ((D₀ i) (X₀ μ)))) =
          c μ * ev_c ((D₀ j) ((D₀ i) (X₀ μ)))
        rw [hev_R_Φ₀ (MvPolynomial.X μ), MvPolynomial.eval_X, hev_c_C]
      rw [← hmat, ← RingHom.map_det]
      exact hev_R_H₀

  · 
    intro B_α _ _ _ n_free hTr_α Ψ hΨ_hom
    let R_α := MvPolynomial (Fin n_free) B_α
    haveI : FaithfulSMul k B_α :=
      (faithfulSMul_iff_algebraMap_injective k B_α).mpr (RingHom.injective _)
    haveI : FaithfulSMul B_α R_α :=
      (faithfulSMul_iff_algebraMap_injective B_α R_α).mpr (MvPolynomial.C_injective (Fin n_free) B_α)
    have hTr_Rα : Algebra.trdeg k R_α ≤ ((M - 1 : ℕ) : Cardinal.{u}) := by
      rw [← trdeg_add_eq k B_α (A := R_α), MvPolynomial.trdeg_of_isDomain,
        Cardinal.mk_fintype, Fintype.card_fin, Cardinal.lift_natCast]
      exact hTr_α
    have hnot_inj_α : ¬ Function.Injective (Ψ.comp (MvPolynomial.rename ι_M)) := by
      intro hinj
      have hle := trdeg_le_of_injective (Ψ.comp (MvPolynomial.rename ι_M)) hinj
      rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Fintype.card_fin,
        Cardinal.lift_natCast] at hle
      have hle' : M ≤ M - 1 := Nat.cast_le.mp (hle.trans hTr_Rα)
      omega
    unfold Function.Injective at hnot_inj_α
    push_neg at hnot_inj_α
    obtain ⟨g₁, g₂, hg12, hg_ne12⟩ := hnot_inj_α
    let g_α := g₁ - g₂
    have hg_ne : g_α ≠ 0 := sub_ne_zero.mpr hg_ne12
    have hg_ker : (Ψ.comp (MvPolynomial.rename ι_M)) g_α = 0 := by
      dsimp only [g_α]; rw [map_sub, hg12, sub_self]
    let F_α := MvPolynomial.rename ι_M g_α
    have hΨ_Fα : Ψ F_α = 0 := hg_ker
    have hndvd_Fα : ¬ (P_amb ∣ F_α) := by
      intro hdvd
      have hmem : F_α ∈ RingHom.ker Φ₀.toRingHom := by
        rw [hKer_Φ₀, Ideal.mem_span_singleton]; exact hdvd
      rw [RingHom.mem_ker] at hmem
      exact hg_ne (hInjM (hmem.trans (map_zero _).symm))
    have hex_Eα : ∃ E_α : ℕ, ¬ (P_amb ∣ MvPolynomial.homogeneousComponent E_α F_α) := by
      by_contra hall_dvd
      push_neg at hall_dvd
      apply hndvd_Fα
      rw [← MvPolynomial.sum_homogeneousComponent F_α]
      exact Finset.dvd_sum fun e _ => hall_dvd e
    obtain ⟨E_α, hndvd_Qα⟩ := hex_Eα
    let Q_α := MvPolynomial.homogeneousComponent E_α F_α
    have hQα_hom : Q_α ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k E_α :=
      MvPolynomial.homogeneousComponent_isHomogeneous E_α F_α
    have hΨ_Qα : Ψ Q_α = 0 := by
      dsimp only [Q_α]
      rw [← (hHomComp Ψ hΨ_hom).2 E_α F_α, hΨ_Fα, map_zero]
    have hQα_ne : Q_α ≠ 0 := by
      intro h0
      apply hndvd_Qα
      change P_amb ∣ Q_α
      rw [h0]
      exact dvd_zero P_amb
    have hEα_pos : 1 ≤ E_α := by
      by_contra h0
      have hE0 : E_α = 0 := by omega
      rw [hE0] at hQα_hom
      have hQC := hEqC_of_hom0 Q_α hQα_hom
      have hc_ne : Q_α.coeff 0 ≠ 0 := by
        intro hc0; rw [hc0, map_zero] at hQC; exact hQα_ne hQC
      rw [hQC, ← MvPolynomial.algebraMap_eq, Ψ.commutes] at hΨ_Qα
      exact hc_ne ((RingHom.injective (algebraMap k R_α)) (hΨ_Qα.trans (map_zero _).symm))
    exact ⟨E_α, Q_α, hEα_pos, hQα_hom, hndvd_Qα, hΨ_Qα⟩

theorem weil_algClosed_functionField_conormal_invariance (k : Type u) [Field k] (d M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (α₁ α₂ : Fin (M + 1))
    (V₁ V₂ : Z_bar.left.Opens)
    (hAff₁ : AlgebraicGeometry.IsAffineOpen V₁)
    (hAff₂ : AlgebraicGeometry.IsAffineOpen V₂)
    [Nonempty V₁] [Nonempty V₂]
    (hV₁ : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
        MvPolynomial.gradedAlgebra
      V₁ ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α₁)))
    (hV₂ : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
        MvPolynomial.gradedAlgebra
      V₂ ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α₂)))
    (κ₁ : k →+* ↑(Z_bar.left.presheaf.obj (Opposite.op V₁)))
    (κ₂ : k →+* ↑(Z_bar.left.presheaf.obj (Opposite.op V₂)))
    (ψ₁ : MvPolynomial (Fin d) k →+* ↑(Z_bar.left.presheaf.obj (Opposite.op V₁)))
    (X₁ : Fin (M + 1) → ↑(Z_bar.left.presheaf.obj (Opposite.op V₁)))
    (X₂ : Fin (M + 1) → ↑(Z_bar.left.presheaf.obj (Opposite.op V₂)))
    (D₁ : letI : Algebra k ↑(Z_bar.left.presheaf.obj (Opposite.op V₁)) := κ₁.toAlgebra
      Fin d → Derivation k ↑(Z_bar.left.presheaf.obj (Opposite.op V₁))
        ↑(Z_bar.left.presheaf.obj (Opposite.op V₁)))
    (D₂ : letI : Algebra k ↑(Z_bar.left.presheaf.obj (Opposite.op V₂)) := κ₂.toAlgebra
      Fin d → Derivation k ↑(Z_bar.left.presheaf.obj (Opposite.op V₂))
        ↑(Z_bar.left.presheaf.obj (Opposite.op V₂))) :
    (V₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₁) = V₁.ι ≫ Z_bar.hom) →
    (V₂.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₂) = V₂.ι ≫ Z_bar.hom) →
    (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
      MvPolynomial.gradedAlgebra
     ∀ (μ : Fin (M + 1))
      (hXμ : (MvPolynomial.X μ : MvPolynomial (Fin (M + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
      (hXα₁ : (MvPolynomial.X α₁ : MvPolynomial (Fin (M + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
      (hXα₂ : (MvPolynomial.X α₂ : MvPolynomial (Fin (M + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1),
      X₁ μ = ((AlgebraicGeometry.Proj.basicOpenIsoAway
        (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
        (MvPolynomial.X α₁) hXα₁ zero_lt_one).hom ≫
        ι_bar.left.appLE
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α₁))
          V₁ hV₁).hom
        (HomogeneousLocalization.mk ⟨1, ⟨MvPolynomial.X μ, hXμ⟩, ⟨MvPolynomial.X α₁, hXα₁⟩, ⟨1, pow_one _⟩⟩) ∧
      X₂ μ = ((AlgebraicGeometry.Proj.basicOpenIsoAway
        (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
        (MvPolynomial.X α₂) hXα₂ zero_lt_one).hom ≫
        ι_bar.left.appLE
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X α₂))
          V₂ hV₂).hom
        (HomogeneousLocalization.mk ⟨1, ⟨MvPolynomial.X μ, hXμ⟩, ⟨MvPolynomial.X α₂, hXα₂⟩, ⟨1, pow_one _⟩⟩)) →
    (letI : Algebra k ↑(Z_bar.left.presheaf.obj (Opposite.op V₁)) := κ₁.toAlgebra
     ∀ (E : Type u) [Field E] (σ : ↑(Z_bar.left.presheaf.obj (Opposite.op V₁)) →+* E),
      letI : Algebra k E := (σ.comp κ₁).toAlgebra
      ∀ (D : Derivation k E E) (a : ↑(Z_bar.left.presheaf.obj (Opposite.op V₁))),
        D (σ a) = ∑ i : Fin d, σ (D₁ i a) * D (σ (ψ₁ (MvPolynomial.X i)))) →
    letI : AlgebraicGeometry.IsIntegral Z_bar.left := hInt
    let F_Z := ↑Z_bar.left.functionField
    let σ₁ := (Z_bar.left.germToFunctionField V₁).hom
    let σ₂ := (Z_bar.left.germToFunctionField V₂).hom
    let J₁ : Matrix (Fin (d + 1)) (Fin (M + 1)) ↑(Z_bar.left.presheaf.obj (Opposite.op V₁)) :=
      Matrix.of (Fin.cases X₁ (fun i μ => D₁ i (X₁ μ)))
    let J₂ : Matrix (Fin (d + 1)) (Fin (M + 1)) ↑(Z_bar.left.presheaf.obj (Opposite.op V₂)) :=
      Matrix.of (Fin.cases X₂ (fun i μ => D₂ i (X₂ μ)))
    σ₁.comp κ₁ = σ₂.comp κ₂ ∧
    ∃ T : Matrix (Fin (d + 1)) (Fin (d + 1)) F_Z,
      J₂.map σ₂ = T * J₁.map σ₁ :=
by
  classical
  intro hSpec₁ hSpec₂ hCoords hChain₁
  let _ : AlgebraicGeometry.IsIntegral Z_bar.left := hInt
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let Z := Z_bar.left
  let A₁ : Type u := ↑(Z.presheaf.obj (Opposite.op V₁))
  let A₂ : Type u := ↑(Z.presheaf.obj (Opposite.op V₂))
  let F_Z : Type u := ↑Z.functionField
  let σ₁ : A₁ →+* F_Z := (Z.germToFunctionField V₁).hom
  let σ₂ : A₂ →+* F_Z := (Z.germToFunctionField V₂).hom
  let J₁ : Matrix (Fin (d + 1)) (Fin (M + 1)) A₁ :=
    Matrix.of (Fin.cases X₁ (fun i μ => D₁ i (X₁ μ)))
  let J₂ : Matrix (Fin (d + 1)) (Fin (M + 1)) A₂ :=
    Matrix.of (Fin.cases X₂ (fun i μ => D₂ i (X₂ μ)))
  change σ₁.comp κ₁ = σ₂.comp κ₂ ∧
    ∃ T : Matrix (Fin (d + 1)) (Fin (d + 1)) F_Z,
      J₂.map σ₂ = T * J₁.map σ₁

  
  have : IrreducibleSpace ↥Z := AlgebraicGeometry.irreducibleSpace_of_isIntegral Z
  obtain ⟨⟨y₁, hy₁⟩⟩ := (inferInstance : Nonempty V₁)
  obtain ⟨⟨y₂, hy₂⟩⟩ := (inferInstance : Nonempty V₂)
  obtain ⟨y, hyV₁, hyV₂⟩ :=
    nonempty_preirreducible_inter V₁.isOpen V₂.isOpen ⟨y₁, hy₁⟩ ⟨y₂, hy₂⟩
  obtain ⟨r₀, hW₂, hyW⟩ := hAff₁.exists_basicOpen_le (V := V₂) ⟨y, hyV₂⟩ hyV₁
  let W : Z.Opens := Z.basicOpen r₀
  have hW₁ : W ≤ V₁ := Z.basicOpen_le r₀
  have hAffW : AlgebraicGeometry.IsAffineOpen W := hAff₁.basicOpen r₀
  let _ : Nonempty W := ⟨⟨y, hyW⟩⟩

  
  let ρ₁ : Z.presheaf.obj (Opposite.op V₁) ⟶ Z.presheaf.obj (Opposite.op W) :=
    Z.presheaf.map (CategoryTheory.homOfLE hW₁).op
  let ρ₂ : Z.presheaf.obj (Opposite.op V₂) ⟶ Z.presheaf.obj (Opposite.op W) :=
    Z.presheaf.map (CategoryTheory.homOfLE hW₂).op
  let σ_W : ↑(Z.presheaf.obj (Opposite.op W)) →+* F_Z := (Z.germToFunctionField W).hom
  have hηW : genericPoint ↥Z ∈ W :=
    ((genericPoint_spec ↥Z).mem_open_set_iff W.isOpen).mpr ⟨y, trivial, hyW⟩
  have hρ₁_germ : ρ₁ ≫ Z.germToFunctionField W = Z.germToFunctionField V₁ :=
    TopCat.Presheaf.germ_res Z.presheaf (CategoryTheory.homOfLE hW₁) (genericPoint ↥Z) hηW
  have hρ₂_germ : ρ₂ ≫ Z.germToFunctionField W = Z.germToFunctionField V₂ :=
    TopCat.Presheaf.germ_res Z.presheaf (CategoryTheory.homOfLE hW₂) (genericPoint ↥Z) hηW
  have hσW₁ : σ_W.comp ρ₁.hom = σ₁ := congrArg CommRingCat.Hom.hom hρ₁_germ
  have hσW₂ : σ_W.comp ρ₂.hom = σ₂ := congrArg CommRingCat.Hom.hom hρ₂_germ

  
  have hSpecW₁ :
      W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ρ₁.hom.comp κ₁)) =
        W.ι ≫ Z_bar.hom := by
    have hc : CommRingCat.ofHom (ρ₁.hom.comp κ₁) = CommRingCat.ofHom κ₁ ≫ ρ₁ := rfl
    rw [hc, AlgebraicGeometry.Spec.map_comp,
      AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_assoc,
      hSpec₁, ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
  have hSpecW₂ :
      W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ρ₂.hom.comp κ₂)) =
        W.ι ≫ Z_bar.hom := by
    have hc : CommRingCat.ofHom (ρ₂.hom.comp κ₂) = CommRingCat.ofHom κ₂ ≫ ρ₂ := rfl
    rw [hc, AlgebraicGeometry.Spec.map_comp,
      AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_assoc,
      hSpec₂, ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
  have : CategoryTheory.IsIso W.toSpecΓ := by
    rw [← hAffW.isoSpec_hom]
    infer_instance
  have hEqSpec :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ρ₁.hom.comp κ₁)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ρ₂.hom.comp κ₂)) :=
    (CategoryTheory.cancel_epi W.toSpecΓ).mp (hSpecW₁.trans hSpecW₂.symm)
  have hρκ : ρ₁.hom.comp κ₁ = ρ₂.hom.comp κ₂ :=
    congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hEqSpec)
  have hκ : σ₁.comp κ₁ = σ₂.comp κ₂ := by
    rw [← hσW₁, ← hσW₂, RingHom.comp_assoc, hρκ, ← RingHom.comp_assoc]
  have hκ_apply : ∀ c : k, σ₁ (κ₁ c) = σ₂ (κ₂ c) := fun c => RingHom.congr_fun hκ c

  
  let f_Z : Z ⟶ AlgebraicGeometry.Proj 𝒜 := ι_bar.left
  have hX : ∀ ν : Fin (M + 1), (MvPolynomial.X ν : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜 1 :=
    fun ν => MvPolynomial.isHomogeneous_X k ν
  let x₁ : MvPolynomial (Fin (M + 1)) k := MvPolynomial.X α₁
  let x₂ : MvPolynomial (Fin (M + 1)) k := MvPolynomial.X α₂
  let x₁₂ : MvPolynomial (Fin (M + 1)) k := x₁ * x₂
  let D_p1 : (AlgebraicGeometry.Proj 𝒜).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 x₁
  let D_p2 : (AlgebraicGeometry.Proj 𝒜).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 x₂
  let D_p12 : (AlgebraicGeometry.Proj 𝒜).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 x₁₂
  have hD12_eq : D_p12 = D_p1 ⊓ D_p2 := AlgebraicGeometry.Proj.basicOpen_mul 𝒜 x₁ x₂
  have hD12_le1 : D_p12 ≤ D_p1 := hD12_eq.trans_le inf_le_left
  have hD12_le2 : D_p12 ≤ D_p2 := hD12_eq.trans_le inf_le_right
  have hV₁' : V₁ ≤ (TopologicalSpace.Opens.map f_Z.base).obj D_p1 := hV₁
  have hV₂' : V₂ ≤ (TopologicalSpace.Opens.map f_Z.base).obj D_p2 := hV₂
  have hW_12 : W ≤ (TopologicalSpace.Opens.map f_Z.base).obj D_p12 := fun z hz => by
    change f_Z.base z ∈ D_p12
    rw [hD12_eq]
    exact ⟨hV₁' (hW₁ hz), hV₂' (hW₂ hz)⟩
  let m₁ : HomogeneousLocalization.Away 𝒜 x₁ →+* HomogeneousLocalization.Away 𝒜 x₁₂ :=
    HomogeneousLocalization.awayMap 𝒜 (hX α₂) rfl
  let m₂ : HomogeneousLocalization.Away 𝒜 x₂ →+* HomogeneousLocalization.Away 𝒜 x₁₂ :=
    HomogeneousLocalization.awayMap 𝒜 (hX α₁) (mul_comm x₁ x₂)
  let ψ₁₂ : HomogeneousLocalization.Away 𝒜 x₁₂ →+* ↑(Z.presheaf.obj (Opposite.op W)) :=
    (AlgebraicGeometry.Proj.awayToSection 𝒜 x₁₂ ≫ f_Z.appLE D_p12 W hW_12).hom
  have hFactor₁ :
      CommRingCat.ofHom m₁ ≫ AlgebraicGeometry.Proj.awayToSection 𝒜 x₁₂ ≫
          f_Z.appLE D_p12 W hW_12 =
        AlgebraicGeometry.Proj.awayToSection 𝒜 x₁ ≫ f_Z.appLE D_p1 V₁ hV₁' ≫ ρ₁ := by
    rw [AlgebraicGeometry.Proj.awayMap_awayToSection_assoc,
      AlgebraicGeometry.Scheme.Hom.map_appLE,
      AlgebraicGeometry.Scheme.Hom.appLE_map]
  have hFactor₂ :
      CommRingCat.ofHom m₂ ≫ AlgebraicGeometry.Proj.awayToSection 𝒜 x₁₂ ≫
          f_Z.appLE D_p12 W hW_12 =
        AlgebraicGeometry.Proj.awayToSection 𝒜 x₂ ≫ f_Z.appLE D_p2 V₂ hV₂' ≫ ρ₂ := by
    rw [AlgebraicGeometry.Proj.awayMap_awayToSection_assoc,
      AlgebraicGeometry.Scheme.Hom.map_appLE,
      AlgebraicGeometry.Scheme.Hom.appLE_map]

  
  let a_frac : Fin (M + 1) → HomogeneousLocalization.Away 𝒜 x₁ := fun μ =>
    HomogeneousLocalization.mk ⟨1, ⟨MvPolynomial.X μ, hX μ⟩, ⟨x₁, hX α₁⟩, ⟨1, pow_one x₁⟩⟩
  let b_frac : Fin (M + 1) → HomogeneousLocalization.Away 𝒜 x₂ := fun μ =>
    HomogeneousLocalization.mk ⟨1, ⟨MvPolynomial.X μ, hX μ⟩, ⟨x₂, hX α₂⟩, ⟨1, pow_one x₂⟩⟩
  have hX₁_W : ∀ μ : Fin (M + 1), ρ₁.hom (X₁ μ) = ψ₁₂ (m₁ (a_frac μ)) := by
    intro μ
    have h1 := (hCoords μ (hX μ) (hX α₁) (hX α₂)).1
    have hIso₁ :
        (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 x₁ (hX α₁) zero_lt_one).hom ≫
            f_Z.appLE D_p1 V₁ hV₁' =
          AlgebraicGeometry.Proj.awayToSection 𝒜 x₁ ≫ f_Z.appLE D_p1 V₁ hV₁' := by
      rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
    have h1' : X₁ μ =
        (AlgebraicGeometry.Proj.awayToSection 𝒜 x₁ ≫ f_Z.appLE D_p1 V₁ hV₁').hom (a_frac μ) := by
      rw [← hIso₁]
      exact h1
    rw [h1']
    exact (RingHom.congr_fun (congrArg CommRingCat.Hom.hom hFactor₁) (a_frac μ)).symm
  have hX₂_W : ∀ μ : Fin (M + 1), ρ₂.hom (X₂ μ) = ψ₁₂ (m₂ (b_frac μ)) := by
    intro μ
    have h2 := (hCoords μ (hX μ) (hX α₁) (hX α₂)).2
    have hIso₂ :
        (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 x₂ (hX α₂) zero_lt_one).hom ≫
            f_Z.appLE D_p2 V₂ hV₂' =
          AlgebraicGeometry.Proj.awayToSection 𝒜 x₂ ≫ f_Z.appLE D_p2 V₂ hV₂' := by
      rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
    have h2' : X₂ μ =
        (AlgebraicGeometry.Proj.awayToSection 𝒜 x₂ ≫ f_Z.appLE D_p2 V₂ hV₂').hom (b_frac μ) := by
      rw [← hIso₂]
      exact h2
    rw [h2']
    exact (RingHom.congr_fun (congrArg CommRingCat.Hom.hom hFactor₂) (b_frac μ)).symm
  have hNormDen : ∀ (f : MvPolynomial (Fin (M + 1)) k) (hf : f ∈ 𝒜 1) (p : ↥(𝒜 1)),
      (HomogeneousLocalization.mk ⟨1, p, ⟨f, hf⟩, ⟨1, pow_one f⟩⟩ :
        HomogeneousLocalization.Away 𝒜 f) =
      HomogeneousLocalization.mk
        { deg := 1
          num := p
          den := ⟨f ^ 1, by rwa [pow_one]⟩
          den_mem := (Submonoid.powers f).pow_mem (Submonoid.mem_powers f) 1 } := by
    intro f hf p
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
    dsimp only []
    congr 1
    exact Subtype.ext (pow_one f).symm
  have hAwayId : ∀ μ : Fin (M + 1), m₂ (b_frac α₁) * m₁ (a_frac μ) = m₂ (b_frac μ) := by
    intro μ
    dsimp only [a_frac, b_frac]
    rw [hNormDen x₂ (hX α₂) ⟨MvPolynomial.X α₁, hX α₁⟩,
      hNormDen x₁ (hX α₁) ⟨MvPolynomial.X μ, hX μ⟩,
      hNormDen x₂ (hX α₂) ⟨MvPolynomial.X μ, hX μ⟩]
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul]
    dsimp only [m₁, m₂]
    rw [HomogeneousLocalization.val_awayMap_mk,
      HomogeneousLocalization.val_awayMap_mk,
      HomogeneousLocalization.val_awayMap_mk,
      Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    dsimp only [x₁₂, x₁, x₂]
    simp only [Submonoid.coe_one, Submonoid.coe_mul, pow_one]
    ring
  let u : F_Z := σ₂ (X₂ α₁)
  have hRatio : ∀ μ : Fin (M + 1), σ₂ (X₂ μ) = u * σ₁ (X₁ μ) := by
    intro μ
    have hmul := congrArg (σ_W.comp ψ₁₂) (hAwayId μ)
    rw [map_mul] at hmul
    simp only [RingHom.comp_apply, ← hX₁_W, ← hX₂_W] at hmul
    have h1 : σ_W (ρ₁.hom (X₁ μ)) = σ₁ (X₁ μ) := RingHom.congr_fun hσW₁ (X₁ μ)
    have h2 : σ_W (ρ₂.hom (X₂ μ)) = σ₂ (X₂ μ) := RingHom.congr_fun hσW₂ (X₂ μ)
    have hα : σ_W (ρ₂.hom (X₂ α₁)) = u := RingHom.congr_fun hσW₂ (X₂ α₁)
    rw [hα, h1, h2] at hmul
    exact hmul.symm

  
  have hFrac₂ : @IsFractionRing A₂ _ F_Z _ σ₂.toAlgebra :=
    AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Z V₂ hAff₂
  have hσ₂_inj : Function.Injective σ₂ :=
    @IsFractionRing.injective A₂ _ F_Z _ σ₂.toAlgebra hFrac₂
  have hFrac_surj : ∀ z : F_Z, ∃ a b : A₂, σ₂ b ≠ 0 ∧ σ₂ a / σ₂ b = z := by
    let _ : Algebra A₂ F_Z := σ₂.toAlgebra
    have : IsFractionRing A₂ F_Z := hFrac₂
    intro z
    obtain ⟨a, b, hb, hdiv⟩ := IsFractionRing.div_surjective (A := A₂) z
    refine ⟨a, b, ?_, hdiv⟩
    intro hb0
    have hb_eq : b = 0 := hσ₂_inj (hb0.trans (map_zero σ₂).symm)
    have h10 : (1 : A₂) = 0 := (mem_nonZeroDivisors_iff.mp hb).1 1 (by rw [hb_eq, zero_mul])
    exact one_ne_zero (α := F_Z) ((map_one σ₂).symm.trans ((congrArg σ₂ h10).trans (map_zero σ₂)))

  
  let _ : Algebra k A₁ := κ₁.toAlgebra
  let _ : Algebra k A₂ := κ₂.toAlgebra
  let _ : Algebra k F_Z := (σ₁.comp κ₁).toAlgebra
  have hD₂_ext_exists : ∀ i : Fin d,
      ∃ D_ext : Derivation k F_Z F_Z, ∀ a : A₂, D_ext (σ₂ a) = σ₂ (D₂ i a) := by
    intro i
    let qform : A₂ → A₂ → F_Z := fun a b =>
      (σ₂ (D₂ i a) * σ₂ b - σ₂ a * σ₂ (D₂ i b)) / (σ₂ b) ^ 2
    have hq_eq : ∀ (z : F_Z) (a₁ b₁ a₂ b₂ : A₂),
        σ₂ b₁ ≠ 0 → σ₂ b₂ ≠ 0 →
        σ₂ a₁ / σ₂ b₁ = z → σ₂ a₂ / σ₂ b₂ = z →
        qform a₁ b₁ = qform a₂ b₂ := by
      intro z a₁ b₁ a₂ b₂ hb₁ hb₂ hz₁ hz₂
      have hcross_F : σ₂ a₁ * σ₂ b₂ = σ₂ a₂ * σ₂ b₁ :=
        (div_eq_div_iff hb₁ hb₂).mp (hz₁.trans hz₂.symm)
      have hcross_A : a₁ * b₂ = a₂ * b₁ := hσ₂_inj (by rw [map_mul, map_mul, hcross_F])
      have hD_A := congrArg (fun t => σ₂ (D₂ i t)) hcross_A
      simp only [(D₂ i).leibniz, smul_eq_mul, map_add, map_mul] at hD_A
      dsimp only [qform]
      rw [div_eq_div_iff (pow_ne_zero 2 hb₁) (pow_ne_zero 2 hb₂)]
      linear_combination
        σ₂ b₁ * σ₂ b₂ * hD_A - (σ₂ b₁ * σ₂ (D₂ i b₂) + σ₂ b₂ * σ₂ (D₂ i b₁)) * hcross_F
    let a_rep : F_Z → A₂ := fun z => Classical.choose (hFrac_surj z)
    let b_rep : F_Z → A₂ := fun z => Classical.choose (Classical.choose_spec (hFrac_surj z))
    have hb_rep : ∀ z : F_Z, σ₂ (b_rep z) ≠ 0 :=
      fun z => (Classical.choose_spec (Classical.choose_spec (hFrac_surj z))).1
    have hdiv_rep : ∀ z : F_Z, σ₂ (a_rep z) / σ₂ (b_rep z) = z :=
      fun z => (Classical.choose_spec (Classical.choose_spec (hFrac_surj z))).2
    let dFun : F_Z → F_Z := fun z => qform (a_rep z) (b_rep z)
    have hdFun_spec : ∀ (z : F_Z) (a b : A₂),
        σ₂ b ≠ 0 → σ₂ a / σ₂ b = z → dFun z = qform a b :=
      fun z a b hb hz => hq_eq z (a_rep z) (b_rep z) a b (hb_rep z) hb (hdiv_rep z) hz
    have hdFun_alg : ∀ a : A₂, dFun (σ₂ a) = σ₂ (D₂ i a) := by
      intro a
      have h1_ne : σ₂ 1 ≠ 0 := by rw [map_one]; exact one_ne_zero
      have ha1 : σ₂ a / σ₂ 1 = σ₂ a := by rw [map_one, div_one]
      rw [hdFun_spec (σ₂ a) a 1 h1_ne ha1]
      dsimp only [qform]
      simp [Derivation.map_one_eq_zero]
    refine ⟨{
      toFun := dFun
      map_add' := fun x y => by
        obtain ⟨a₁, b₁, hb₁, rfl⟩ := hFrac_surj x
        obtain ⟨a₂, b₂, hb₂, rfl⟩ := hFrac_surj y
        have hb₁₂ : σ₂ (b₁ * b₂) ≠ 0 := by rw [map_mul]; exact mul_ne_zero hb₁ hb₂
        have hsum : σ₂ (a₁ * b₂ + b₁ * a₂) / σ₂ (b₁ * b₂) =
            σ₂ a₁ / σ₂ b₁ + σ₂ a₂ / σ₂ b₂ := by
          rw [map_add, map_mul, map_mul, map_mul, div_add_div _ _ hb₁ hb₂]
        rw [hdFun_spec _ _ _ hb₁₂ hsum,
          hdFun_spec _ a₁ b₁ hb₁ rfl,
          hdFun_spec _ a₂ b₂ hb₂ rfl]
        dsimp only [qform]
        simp only [map_add, (D₂ i).leibniz, smul_eq_mul, map_mul]
        have hb₁_sq : σ₂ b₁ ^ 2 ≠ 0 := pow_ne_zero 2 hb₁
        have hb₂_sq : σ₂ b₂ ^ 2 ≠ 0 := pow_ne_zero 2 hb₂
        have hb₁₂_sq : (σ₂ b₁ * σ₂ b₂) ^ 2 ≠ 0 := pow_ne_zero 2 (mul_ne_zero hb₁ hb₂)
        rw [div_add_div _ _ hb₁_sq hb₂_sq, div_eq_div_iff hb₁₂_sq (mul_ne_zero hb₁_sq hb₂_sq)]
        ring
      map_smul' := fun c x => by
        obtain ⟨a, b, hb, rfl⟩ := hFrac_surj x
        change dFun (c • (σ₂ a / σ₂ b)) = c • dFun (σ₂ a / σ₂ b)
        have hsmul_F : ∀ z : F_Z, c • z = σ₂ (κ₂ c) * z := fun z => by
          change (σ₁.comp κ₁) c * z = σ₂ (κ₂ c) * z
          rw [RingHom.comp_apply, hκ_apply c]
        rw [hsmul_F, hsmul_F]
        have hca : σ₂ (κ₂ c * a) / σ₂ b = σ₂ (κ₂ c) * (σ₂ a / σ₂ b) := by
          rw [map_mul, mul_div_assoc']
        rw [hdFun_spec _ (κ₂ c * a) b hb hca, hdFun_spec _ a b hb rfl]
        have hD_ca : D₂ i (κ₂ c * a) = κ₂ c * D₂ i a := by
          change D₂ i (c • a) = c • D₂ i a
          exact (D₂ i).map_smul c a
        dsimp only [qform]
        rw [hD_ca, map_mul, map_mul, mul_div_assoc']
        congr 1
        ring
      map_one_eq_zero' := by
        change dFun 1 = 0
        simpa only [map_one, Derivation.map_one_eq_zero, map_zero] using hdFun_alg 1
      leibniz' := fun x y => by
        obtain ⟨a₁, b₁, hb₁, rfl⟩ := hFrac_surj x
        obtain ⟨a₂, b₂, hb₂, rfl⟩ := hFrac_surj y
        change dFun ((σ₂ a₁ / σ₂ b₁) * (σ₂ a₂ / σ₂ b₂)) =
          (σ₂ a₁ / σ₂ b₁) * dFun (σ₂ a₂ / σ₂ b₂) +
            (σ₂ a₂ / σ₂ b₂) * dFun (σ₂ a₁ / σ₂ b₁)
        have hb₁₂ : σ₂ (b₁ * b₂) ≠ 0 := by rw [map_mul]; exact mul_ne_zero hb₁ hb₂
        have hprod : σ₂ (a₁ * a₂) / σ₂ (b₁ * b₂) =
            (σ₂ a₁ / σ₂ b₁) * (σ₂ a₂ / σ₂ b₂) := by
          rw [map_mul, map_mul, div_mul_div_comm]
        rw [hdFun_spec _ _ _ hb₁₂ hprod,
          hdFun_spec _ a₁ b₁ hb₁ rfl,
          hdFun_spec _ a₂ b₂ hb₂ rfl]
        dsimp only [qform]
        simp only [(D₂ i).leibniz, smul_eq_mul, map_add, map_mul]
        have hb₁_sq : σ₂ b₁ ^ 2 ≠ 0 := pow_ne_zero 2 hb₁
        have hb₂_sq : σ₂ b₂ ^ 2 ≠ 0 := pow_ne_zero 2 hb₂
        have hb₁₂_sq : (σ₂ b₁ * σ₂ b₂) ^ 2 ≠ 0 := pow_ne_zero 2 (mul_ne_zero hb₁ hb₂)
        rw [div_mul_div_comm, div_mul_div_comm,
          div_add_div _ _ (mul_ne_zero hb₁ hb₂_sq) (mul_ne_zero hb₂ hb₁_sq),
          div_eq_div_iff hb₁₂_sq
            (mul_ne_zero (mul_ne_zero hb₁ hb₂_sq) (mul_ne_zero hb₂ hb₁_sq))]
        ring
    }, hdFun_alg⟩
  choose D₂_ext hD₂_ext_alg using hD₂_ext_exists

  
  let T : Matrix (Fin (d + 1)) (Fin (d + 1)) F_Z :=
    Matrix.of
      (Fin.cases
        (Fin.cases u (fun _ => 0))
        (fun i => Fin.cases (D₂_ext i u)
          (fun γ => u * D₂_ext i (σ₁ (ψ₁ (MvPolynomial.X γ))))))
  refine ⟨hκ, ⟨T, ?_⟩⟩
  ext r μ
  rw [Matrix.map_apply, Matrix.mul_apply, Fin.sum_univ_succ]
  simp only [Matrix.map_apply, J₁, J₂, T, Matrix.of_apply, Fin.cases_zero, Fin.cases_succ]
  refine Fin.cases ?_ (fun i => ?_) r
  · simp only [Fin.cases_zero, Fin.cases_succ, zero_mul, Finset.sum_const_zero, add_zero]
    exact hRatio μ
  · simp only [Fin.cases_zero, Fin.cases_succ]
    rw [← hD₂_ext_alg i (X₂ μ), hRatio μ, (D₂_ext i).leibniz, smul_eq_mul, smul_eq_mul,
      hChain₁ F_Z σ₁ (D₂_ext i) (X₁ μ), Finset.mul_sum]
    have hsum_eq :
        (∑ x : Fin d, u * (σ₁ (D₁ x (X₁ μ)) * D₂_ext i (σ₁ (ψ₁ (MvPolynomial.X x))))) =
          ∑ x : Fin d, u * D₂_ext i (σ₁ (ψ₁ (MvPolynomial.X x))) * σ₁ (D₁ x (X₁ μ)) :=
      Finset.sum_congr rfl fun _ _ => by ring
    rw [hsum_eq]
    ring

theorem weil_algClosed_proj_hypersurface_codim_two_bad_locus (k : Type u) [Field k] [IsAlgClosed k] (M D_amb E_tot : ℕ)
    (hM : 1 ≤ M) (hD : 1 ≤ D_amb)
    (P_amb Q_tot : MvPolynomial (Fin (M + 1)) k)
    (hP_hom : P_amb ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k D_amb)
    (hP_irr : Irreducible P_amb)
    (hQ_hom : Q_tot ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k E_tot)
    (hndvd : ¬ (P_amb ∣ Q_tot))
    (hIntP : AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k M).left)
    (hDimP : topologicalKrullDim (weilProjectiveSpaceOver k M).left = (M : WithBot ℕ∞)) :
    let F_bad : Set (weilProjectiveSpaceOver k M).left :=
      weilProjHyperplaneSet k M P_amb ∩ weilProjHyperplaneSet k M Q_tot
    IsClosed F_bad ∧
    topologicalKrullDim ↥F_bad + 2 ≤ (M : WithBot ℕ∞) ∧
    (∀ c : Fin (M + 1) → k, c ≠ 0 → MvPolynomial.eval c P_amb = 0 →
      (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
        MvPolynomial.gradedAlgebra
       ∀ q : (weilProjectiveSpaceOver k M).left,
        (∀ (G : MvPolynomial (Fin (M + 1)) k) (e : ℕ),
          G ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k e →
          (G ∈ ProjectiveSpectrum.asHomogeneousIdeal q ↔ MvPolynomial.eval c G = 0)) →
        q ∉ F_bad) →
      MvPolynomial.eval c Q_tot ≠ 0) :=
by
  classical
  have _ := hD
  have hOneStepDrop : ∀ (T : Type u) [TopologicalSpace T] [IrreducibleSpace T]
      (Z : Set T), IsClosed Z → (∃ t : T, t ∉ Z) →
      topologicalKrullDim ↥Z + 1 ≤ topologicalKrullDim T := by
    intro T _ _ Z hClZ ⟨t₀, ht₀⟩
    dsimp only [topologicalKrullDim]
    by_cases hEmpty : IsEmpty (TopologicalSpace.IrreducibleCloseds ↥Z)
    · have hbot : Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥Z) = ⊥ :=
        Order.krullDim_eq_bot
      rw [hbot]
      exact bot_le
    · have hNeZ : Nonempty (TopologicalSpace.IrreducibleCloseds ↥Z) :=
        not_isEmpty_iff.mp hEmpty
      let top_T : TopologicalSpace.IrreducibleCloseds T :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ T, isClosed_univ⟩
      have hNeT : Nonempty (TopologicalSpace.IrreducibleCloseds T) := ⟨top_T⟩
      let pushZ : TopologicalSpace.IrreducibleCloseds ↥Z →
          TopologicalSpace.IrreducibleCloseds T :=
        fun C => ⟨Subtype.val '' (C : Set ↥Z),
          C.isIrreducible.image Subtype.val continuous_subtype_val.continuousOn,
          hClZ.isClosedEmbedding_subtypeVal.isClosedMap _ C.isClosed⟩
      have hStrict : StrictMono pushZ := by
        intro C₁ C₂ hlt
        rw [lt_iff_le_not_ge] at hlt ⊢
        refine ⟨Set.image_mono hlt.1, fun hge => hlt.2 ?_⟩
        exact (Set.image_subset_image_iff Subtype.val_injective).mp hge
      have hLtTop : ∀ C : TopologicalSpace.IrreducibleCloseds ↥Z, pushZ C < top_T := by
        intro C
        rw [lt_iff_le_not_ge]
        refine ⟨Set.subset_univ _, fun hge => ?_⟩
        obtain ⟨z, _, hz_eq⟩ := hge (Set.mem_univ t₀)
        exact ht₀ (hz_eq ▸ z.2)
      have ⟨C₀⟩ := hNeZ
      have : Nonempty (LTSeries (TopologicalSpace.IrreducibleCloseds ↥Z)) :=
        ⟨RelSeries.singleton _ C₀⟩
      rw [Order.krullDim_eq_iSup_length, Order.krullDim_eq_iSup_length,
        ← WithBot.coe_one, ← WithBot.coe_add, ENat.iSup_add, WithBot.coe_le_coe]
      refine iSup_le fun p => ?_
      let p' : LTSeries (TopologicalSpace.IrreducibleCloseds T) :=
        { length := p.length
          toFun := fun i => pushZ (p.toFun i)
          step := fun i => hStrict (p.step i) }
      let q : LTSeries (TopologicalSpace.IrreducibleCloseds T) :=
        p'.snoc top_T (hLtTop p.last)
      have hlen : ((p.length : ℕ∞) + 1) = (q.length : ℕ∞) := by
        have hq : q.length = p.length + 1 := RelSeries.snoc_length _ _ _
        exact_mod_cast hq.symm
      rw [hlen]
      exact le_iSup (fun q' : LTSeries (TopologicalSpace.IrreducibleCloseds T) =>
        (q'.length : ℕ∞)) q

  have hTwoStepDrop : ∀ (X : Type u) [TopologicalSpace X] [IrreducibleSpace X]
      (Y F : Set X), IsClosed Y → IsClosed F → IsIrreducible Y → F ⊆ Y →
      (∃ x : X, x ∉ Y) → (∃ y ∈ Y, y ∉ F) →
      topologicalKrullDim ↥F + 2 ≤ topologicalKrullDim X := by
    intro X _ _ Y F hClY hClF hIrrY hFY hx ⟨y₀, hy₀Y, hy₀F⟩
    have h1 : topologicalKrullDim ↥Y + 1 ≤ topologicalKrullDim X :=
      hOneStepDrop X Y hClY hx
    let _ : IrreducibleSpace ↥Y := Subtype.irreducibleSpace hIrrY
    let F_Y : Set ↥Y := (Subtype.val : ↥Y → X) ⁻¹' F
    have hCl_FY : IsClosed F_Y := hClF.preimage continuous_subtype_val
    have h2_FY : topologicalKrullDim ↥F_Y + 1 ≤ topologicalKrullDim ↥Y :=
      hOneStepDrop ↥Y F_Y hCl_FY ⟨⟨y₀, hy₀Y⟩, hy₀F⟩
    let e_F : ↥F ≃ₜ ↥F_Y :=
      { toFun := fun x => ⟨⟨x.1, hFY x.2⟩, x.2⟩
        invFun := fun y => ⟨y.1.1, y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        continuous_toFun := Continuous.subtype_mk
          (Continuous.subtype_mk continuous_subtype_val (fun x => hFY x.2)) (fun x => x.2)
        continuous_invFun := Continuous.subtype_mk
          (continuous_subtype_val.comp continuous_subtype_val) (fun y => y.2) }
    have hDim_eq : topologicalKrullDim ↥F = topologicalKrullDim ↥F_Y :=
      e_F.isHomeomorph.topologicalKrullDim_eq
    rw [← hDim_eq] at h2_FY
    have hAdd : (topologicalKrullDim ↥F + 1) + 1 ≤ topologicalKrullDim X :=
      (add_le_add h2_FY le_rfl).trans h1
    have hAssoc : ∀ d : WithBot ℕ∞, (d + 1) + 1 = d + 2 := by
      rintro (_ | a)
      · rfl
      · change (((a + 1 + 1 : ℕ∞) : WithBot ℕ∞)) = (((a + 2 : ℕ∞) : WithBot ℕ∞))
        rw [add_assoc, one_add_one_eq_two]
    rwa [hAssoc] at hAdd

  intro F_bad
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let _ : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
  let H_P : Set (weilProjectiveSpaceOver k M).left := weilProjHyperplaneSet k M P_amb
  let H_Q : Set (weilProjectiveSpaceOver k M).left := weilProjHyperplaneSet k M Q_tot

  have hClosedHyp : ∀ G : MvPolynomial (Fin (M + 1)) k,
      IsClosed (weilProjHyperplaneSet k M G) := fun G =>
    (AlgebraicGeometry.Proj.basicOpen 𝒜_M G).2.isClosed_compl

  have hMemHyp : ∀ (G : MvPolynomial (Fin (M + 1)) k) (p : (weilProjectiveSpaceOver k M).left),
      p ∈ weilProjHyperplaneSet k M G ↔ G ∈ ProjectiveSpectrum.asHomogeneousIdeal p := by
    intro G p
    let p' : AlgebraicGeometry.Proj 𝒜_M := p
    change p' ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_M G ↔
      G ∈ ProjectiveSpectrum.asHomogeneousIdeal p
    rw [AlgebraicGeometry.Proj.mem_basicOpen, not_not]

  have hClosedP : IsClosed H_P := hClosedHyp P_amb
  have hClosedQ : IsClosed H_Q := hClosedHyp Q_tot
  have hClosedBad : IsClosed F_bad := hClosedP.inter hClosedQ

  have hNotIrrel_bot : ¬ HomogeneousIdeal.irrelevant 𝒜_M ≤ (⊥ : HomogeneousIdeal 𝒜_M) := by
    intro hirr
    have hX0_irrel : (MvPolynomial.X (0 : Fin (M + 1)) : MvPolynomial (Fin (M + 1)) k) ∈
        HomogeneousIdeal.irrelevant 𝒜_M :=
      HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_M zero_lt_one (MvPolynomial.isHomogeneous_X k 0)
    have hX0_bot : (MvPolynomial.X (0 : Fin (M + 1)) : MvPolynomial (Fin (M + 1)) k) = 0 :=
      hirr hX0_irrel
    have hev := congrArg (MvPolynomial.eval (fun _ : Fin (M + 1) => (1 : k))) hX0_bot
    simp only [MvPolynomial.eval_X, map_zero] at hev
    exact one_ne_zero hev

  let η_bot : (weilProjectiveSpaceOver k M).left :=
    (⟨⊥, Ideal.isPrime_bot, hNotIrrel_bot⟩ : ProjectiveSpectrum 𝒜_M)
  have hη_bot_out : η_bot ∉ H_P := by
    rw [hMemHyp]
    exact hP_irr.ne_zero

  have hSpanP_homog : Ideal.IsHomogeneous 𝒜_M (Ideal.span {P_amb}) :=
    Ideal.homogeneous_span 𝒜_M {P_amb} (by rintro _ rfl; exact ⟨D_amb, hP_hom⟩)
  let I_P : HomogeneousIdeal 𝒜_M := ⟨Ideal.span {P_amb}, hSpanP_homog⟩
  have hPrime_P : I_P.toIdeal.IsPrime :=
    (Ideal.span_singleton_prime hP_irr.ne_zero).mpr
      (UniqueFactorizationMonoid.irreducible_iff_prime.mp hP_irr)
  have hNotIrrel_P : ¬ HomogeneousIdeal.irrelevant 𝒜_M ≤ I_P := by
    intro hirr
    let i₀ : Fin (M + 1) := ⟨0, by omega⟩
    let i₁ : Fin (M + 1) := ⟨1, by omega⟩
    have hi₀₁ : i₀ ≠ i₁ := by
      intro h
      have hv : (0 : ℕ) = 1 := congrArg Fin.val h
      omega
    have hX0_mem : (MvPolynomial.X i₀ : MvPolynomial (Fin (M + 1)) k) ∈ Ideal.span {P_amb} :=
      hirr (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_M zero_lt_one
        (MvPolynomial.isHomogeneous_X k i₀))
    have hX1_mem : (MvPolynomial.X i₁ : MvPolynomial (Fin (M + 1)) k) ∈ Ideal.span {P_amb} :=
      hirr (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_M zero_lt_one
        (MvPolynomial.isHomogeneous_X k i₁))
    obtain ⟨A₀, hA₀⟩ := Ideal.mem_span_singleton.mp hX0_mem
    obtain ⟨A₁, hA₁⟩ := Ideal.mem_span_singleton.mp hX1_mem
    have hX0_irr : Irreducible (MvPolynomial.X i₀ : MvPolynomial (Fin (M + 1)) k) :=
      MvPolynomial.X_prime.irreducible
    have hu : IsUnit A₀ := (hX0_irr.isUnit_or_isUnit hA₀).resolve_left hP_irr.not_isUnit
    let u₀ := hu.unit
    have hP_eq : MvPolynomial.X i₀ * (↑(u₀⁻¹) : MvPolynomial (Fin (M + 1)) k) = P_amb := by
      rw [hA₀, mul_assoc]
      change P_amb * (↑u₀ * ↑(u₀⁻¹)) = P_amb
      rw [Units.mul_inv, mul_one]
    rw [← hP_eq, mul_assoc] at hA₁
    have hev := congrArg
      (MvPolynomial.eval (fun j : Fin (M + 1) => if j = i₁ then (1 : k) else 0)) hA₁
    simp only [map_mul, MvPolynomial.eval_X, ↓reduceIte, hi₀₁, zero_mul] at hev
    exact one_ne_zero hev

  let η_P₀ : ProjectiveSpectrum 𝒜_M := ⟨I_P, hPrime_P, hNotIrrel_P⟩
  let η_P : (weilProjectiveSpaceOver k M).left := η_P₀
  have hη_P_in : η_P ∈ H_P := by
    rw [hMemHyp]
    exact Ideal.subset_span rfl
  have hHP_eq_closure : H_P = closure ({η_P} : Set (weilProjectiveSpaceOver k M).left) := by
    apply Set.Subset.antisymm
    · obtain ⟨s, hs_eq⟩ := (ProjectiveSpectrum.isClosed_iff_zeroLocus 𝒜_M
        (closure ({η_P₀} : Set (ProjectiveSpectrum 𝒜_M)))).mp isClosed_closure
      have hη_cl : η_P₀ ∈ ProjectiveSpectrum.zeroLocus 𝒜_M s := by
        rw [← hs_eq]
        exact subset_closure (Set.mem_singleton η_P₀)
      rw [ProjectiveSpectrum.mem_zeroLocus] at hη_cl
      intro p hp
      have hP_in_p : P_amb ∈ (ProjectiveSpectrum.asHomogeneousIdeal p).toIdeal :=
        (hMemHyp P_amb p).mp hp
      have hspan_le : Ideal.span {P_amb} ≤ (ProjectiveSpectrum.asHomogeneousIdeal p).toIdeal :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hP_in_p)
      let p₀ : ProjectiveSpectrum 𝒜_M := p
      have hp₀_zl : p₀ ∈ ProjectiveSpectrum.zeroLocus 𝒜_M s := by
        rw [ProjectiveSpectrum.mem_zeroLocus]
        exact Set.Subset.trans hη_cl hspan_le
      have hp₀_cl : p₀ ∈ closure ({η_P₀} : Set (ProjectiveSpectrum 𝒜_M)) := by
        rwa [hs_eq]
      exact hp₀_cl
    · exact hClosedP.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hη_P_in)

  have hIrredP : IsIrreducible H_P := by
    rw [hHP_eq_closure]
    exact isIrreducible_singleton.closure

  have hη_P_not_bad : η_P ∉ F_bad := by
    intro hbad
    have hQ_in : Q_tot ∈ Ideal.span {P_amb} := (hMemHyp Q_tot η_P).mp hbad.2
    exact hndvd (Ideal.mem_span_singleton.mp hQ_in)

  refine ⟨hClosedBad, ?_, ?_⟩
  · let _ : AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k M).left := hIntP
    let _ : IrreducibleSpace ↥(weilProjectiveSpaceOver k M).left :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral (weilProjectiveSpaceOver k M).left
    rw [← hDimP]
    exact hTwoStepDrop ↥(weilProjectiveSpaceOver k M).left H_P F_bad
      hClosedP hClosedBad hIrredP Set.inter_subset_left
      ⟨η_bot, hη_bot_out⟩ ⟨η_P, hη_P_in, hη_P_not_bad⟩
  · intro c hc_ne hc_evalP hq_avoid
    let ψ_c : MvPolynomial (Fin (M + 1)) k →+* Polynomial k :=
      MvPolynomial.eval₂Hom Polynomial.C (fun μ => Polynomial.C (c μ) * Polynomial.X)
    have hψ_homog : ∀ (e : ℕ) (G : MvPolynomial (Fin (M + 1)) k),
        G ∈ 𝒜_M e →
        ψ_c G = Polynomial.C (MvPolynomial.eval c G) * Polynomial.X ^ e := by
      intro e G hGe
      have hG : G.IsHomogeneous e := (MvPolynomial.mem_homogeneousSubmodule e G).mp hGe
      conv_lhs => rw [G.as_sum]
      rw [map_sum, MvPolynomial.eval_eq, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun s hs => ?_
      have hs_deg : (∑ μ ∈ s.support, s μ) = e := by
        have h1 : Finsupp.degree s = e := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp hs) (hG.coeff_eq_zero hne)
        rwa [Finsupp.degree_apply] at h1
      dsimp only [ψ_c]
      rw [MvPolynomial.eval₂Hom_monomial]
      change Polynomial.C (G.coeff s) *
          (∏ μ ∈ s.support, (Polynomial.C (c μ) * Polynomial.X) ^ s μ) =
        Polynomial.C (G.coeff s * ∏ μ ∈ s.support, c μ ^ s μ) * Polynomial.X ^ e
      have hprod : (∏ μ ∈ s.support, (Polynomial.C (c μ) * Polynomial.X) ^ s μ) =
          Polynomial.C (∏ μ ∈ s.support, c μ ^ s μ) * Polynomial.X ^ e := by
        calc (∏ μ ∈ s.support, (Polynomial.C (c μ) * Polynomial.X) ^ s μ)
            = ∏ μ ∈ s.support, (Polynomial.C (c μ ^ s μ) * Polynomial.X ^ s μ) :=
              Finset.prod_congr rfl fun μ _ => by rw [mul_pow, map_pow]
          _ = (∏ μ ∈ s.support, Polynomial.C (c μ ^ s μ)) *
                (∏ μ ∈ s.support, (Polynomial.X : Polynomial k) ^ s μ) :=
              Finset.prod_mul_distrib
          _ = Polynomial.C (∏ μ ∈ s.support, c μ ^ s μ) *
                Polynomial.X ^ (∑ μ ∈ s.support, s μ) := by
              rw [← map_prod, Finset.prod_pow_eq_pow_sum]
          _ = Polynomial.C (∏ μ ∈ s.support, c μ ^ s μ) * Polynomial.X ^ e := by
              rw [hs_deg]
      rw [hprod, ← mul_assoc, ← map_mul]
    have hψ_ker_iff : ∀ (G : MvPolynomial (Fin (M + 1)) k) (e : ℕ),
        G ∈ 𝒜_M e → (G ∈ RingHom.ker ψ_c ↔ MvPolynomial.eval c G = 0) := by
      intro G e hGe
      rw [RingHom.mem_ker, hψ_homog e G hGe]
      constructor
      · intro h0
        have hc_coeff := congrArg (fun p : Polynomial k => p.coeff e) h0
        simpa [Polynomial.coeff_C_mul_X_pow] using hc_coeff
      · intro hev
        rw [hev, map_zero, zero_mul]
    have hKer_homog : Ideal.IsHomogeneous 𝒜_M (RingHom.ker ψ_c) := by
      intro i F hF
      rw [RingHom.mem_ker] at hF
      by_cases hi : i ∈ (DirectSum.decompose 𝒜_M F).support
      · have hsum := congrArg ψ_c (DirectSum.sum_support_decompose 𝒜_M F).symm
        rw [hF, map_sum] at hsum
        have hsum_eq :
            (∑ j ∈ (DirectSum.decompose 𝒜_M F).support,
              ψ_c (DirectSum.decompose 𝒜_M F j : MvPolynomial (Fin (M + 1)) k)) =
            ∑ j ∈ (DirectSum.decompose 𝒜_M F).support,
              Polynomial.C (MvPolynomial.eval c
                (DirectSum.decompose 𝒜_M F j : MvPolynomial (Fin (M + 1)) k)) *
                Polynomial.X ^ j :=
          Finset.sum_congr rfl fun j _ => hψ_homog j _ (Subtype.prop _)
        rw [hsum_eq] at hsum
        have hcoeff := congrArg (fun p : Polynomial k => p.coeff i) hsum.symm
        rw [Polynomial.finsetSum_coeff, Polynomial.coeff_zero] at hcoeff
        have hsingle :
            (∑ j ∈ (DirectSum.decompose 𝒜_M F).support,
              (Polynomial.C (MvPolynomial.eval c
                (DirectSum.decompose 𝒜_M F j : MvPolynomial (Fin (M + 1)) k)) *
                Polynomial.X ^ j).coeff i) =
            MvPolynomial.eval c
              (DirectSum.decompose 𝒜_M F i : MvPolynomial (Fin (M + 1)) k) := by
          rw [Finset.sum_eq_single i]
          · simp
          · intro j _ hji
            simp [Ne.symm hji]
          · intro hi_not
            exact absurd hi hi_not
        rw [hsingle] at hcoeff
        exact (hψ_ker_iff _ i (Subtype.prop _)).mpr hcoeff
      · have hzero : DirectSum.decompose 𝒜_M F i = 0 := DFinsupp.notMem_support_iff.mp hi
        rw [hzero, Submodule.coe_zero]
        exact Ideal.zero_mem _
    let I_c : HomogeneousIdeal 𝒜_M := ⟨RingHom.ker ψ_c, hKer_homog⟩
    have hNotIrrel_c : ¬ HomogeneousIdeal.irrelevant 𝒜_M ≤ I_c := by
      intro hirr
      have hex_γ : ∃ γ : Fin (M + 1), c γ ≠ 0 := by
        by_contra hall
        rw [not_exists] at hall
        apply hc_ne
        ext γ
        exact not_not.mp (hall γ)
      obtain ⟨γ, hγ⟩ := hex_γ
      have hXγ_mem : (MvPolynomial.X γ : MvPolynomial (Fin (M + 1)) k) ∈ RingHom.ker ψ_c :=
        hirr (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_M zero_lt_one
          (MvPolynomial.isHomogeneous_X k γ))
      have hev0 : MvPolynomial.eval c (MvPolynomial.X γ) = 0 :=
        (hψ_ker_iff (MvPolynomial.X γ) 1 (MvPolynomial.isHomogeneous_X k γ)).mp hXγ_mem
      rw [MvPolynomial.eval_X] at hev0
      exact hγ hev0
    let q_c : (weilProjectiveSpaceOver k M).left :=
      (⟨I_c, RingHom.ker_isPrime ψ_c, hNotIrrel_c⟩ : ProjectiveSpectrum 𝒜_M)
    have hq_not_bad : q_c ∉ F_bad := hq_avoid q_c hψ_ker_iff
    have hq_in_P : q_c ∈ H_P :=
      (hMemHyp P_amb q_c).mpr ((hψ_ker_iff P_amb D_amb hP_hom).mpr hc_evalP)
    intro hQ0
    have hq_in_Q : q_c ∈ H_Q :=
      (hMemHyp Q_tot q_c).mpr ((hψ_ker_iff Q_tot E_tot hQ_hom).mpr hQ0)
    exact hq_not_bad ⟨hq_in_P, hq_in_Q⟩

theorem weil_algClosed_dual_hypersurface_and_odp_bad_locus (k : Type u) [Field k] [IsAlgClosed k] (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hVer : IsCubicVeroneseEmbeddedOver k m M Z_bar ι_bar) :
    ∃ (D_amb : ℕ) (P_amb : MvPolynomial (Fin (M + 1)) k)
      (F_bad : Set (weilProjectiveSpaceOver k M).left),
      1 ≤ D_amb ∧
      P_amb ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k D_amb ∧
      Irreducible P_amb ∧
      IsClosed F_bad ∧
      topologicalKrullDim ↥F_bad + 2 ≤ (M : WithBot ℕ∞) ∧
      (∀ c : Fin (M + 1) → k, c ≠ 0 → MvPolynomial.eval c P_amb ≠ 0 →
        IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m + 1) 1
          ![∑ μ : Fin (M + 1), MvPolynomial.C (c μ) * MvPolynomial.X μ]) ∧
      (∀ c : Fin (M + 1) → k, c ≠ 0 → MvPolynomial.eval c P_amb = 0 →
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
          MvPolynomial.gradedAlgebra
         ∀ q : (weilProjectiveSpaceOver k M).left,
          (∀ (G : MvPolynomial (Fin (M + 1)) k) (e : ℕ),
            G ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k e →
            (G ∈ ProjectiveSpectrum.asHomogeneousIdeal q ↔ MvPolynomial.eval c G = 0)) →
          q ∉ F_bad) →
        ∃ (z_c : Z_bar.left) (hClosed_zc : IsClosed ({z_c} : Set Z_bar.left)),
          IsEtaleLocalOdpHypersurfaceAt k m M Z_bar ι_bar
            (∑ μ : Fin (M + 1), MvPolynomial.C (c μ) * MvPolynomial.X μ) z_c ∧
          IsTransversalLinearSlice k M Z_bar ι_bar
            ⟨{z_c}ᶜ, hClosed_zc.isOpen_compl⟩ (2 * m + 1) 1
            ![∑ μ : Fin (M + 1), MvPolynomial.C (c μ) * MvPolynomial.X μ]) :=
by
  classical
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  letI : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
  letI : AlgebraicGeometry.IsIntegral Z_bar.left := hInt
  let d : ℕ := 2 * m + 2
  have hd : 1 ≤ d := by omega
  have hM3 : 3 ≤ M := hVer.1
  have hM1 : 1 ≤ M := by omega
  have hCl_ι : AlgebraicGeometry.IsClosedImmersion ι_bar.left := hVer.2.1
  have hOdp_wit := hVer.2.2.2.1
  have hTwoPt_jet1 := hVer.2.2.2.2.1

  
  let L_lin : (Fin (M + 1) → k) → MvPolynomial (Fin (M + 1)) k :=
    fun c => ∑ μ : Fin (M + 1), MvPolynomial.C (c μ) * MvPolynomial.X μ
  have hL_lin_homog : ∀ c : Fin (M + 1) → k, L_lin c ∈ 𝒜_M 1 := by
    intro c
    refine Submodule.sum_mem (𝒜_M 1) fun μ _ => ?_
    rw [← MvPolynomial.smul_eq_C_mul]
    exact Submodule.smul_mem (𝒜_M 1) (c μ) (MvPolynomial.isHomogeneous_X k μ)
  have hX_homog : ∀ μ : Fin (M + 1), (MvPolynomial.X μ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1 :=
    fun μ => MvPolynomial.isHomogeneous_X k μ

  have hL_mem_1_eq : ∀ (L : MvPolynomial (Fin (M + 1)) k), L ∈ 𝒜_M 1 →
      ∃ c : Fin (M + 1) → k, L = L_lin c := by
    intro L hL
    refine ⟨fun μ => L.coeff (Finsupp.single μ 1), ?_⟩
    have hHom : L.IsHomogeneous 1 := (MvPolynomial.mem_homogeneousSubmodule 1 L).mp hL
    ext s
    dsimp only [L_lin]
    rw [MvPolynomial.coeff_sum]
    have hRHS : (∑ μ : Fin (M + 1), (MvPolynomial.C (L.coeff (Finsupp.single μ 1)) *
        MvPolynomial.X μ).coeff s) =
        ∑ μ : Fin (M + 1), if Finsupp.single μ 1 = s then L.coeff (Finsupp.single μ 1) else 0 := by
      refine Finset.sum_congr rfl fun μ _ => ?_
      rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X]
      split_ifs with h
      · rw [h, mul_one]
      · rw [mul_zero]
    rw [hRHS]
    by_cases hs : ∃ μ : Fin (M + 1), s = Finsupp.single μ 1
    · obtain ⟨μ₀, rfl⟩ := hs
      rw [Finset.sum_eq_single μ₀]
      · simp
      · intro μ _ hne
        have hne' : Finsupp.single μ 1 ≠ Finsupp.single μ₀ 1 := fun h =>
          hne (Finsupp.single_left_injective one_ne_zero h)
        simp [hne']
      · intro habs; exact absurd (Finset.mem_univ μ₀) habs
    · rw [not_exists] at hs
      rw [Finset.sum_eq_zero (fun μ _ => if_neg (fun h => hs μ h.symm))]
      by_contra hne0
      have hw : (Finsupp.weight 1) s = 1 := hHom hne0
      have hsum : ∑ μ : Fin (M + 1), s μ = 1 := by
        simpa [Finsupp.weight_apply, Finsupp.linearCombination_apply, Finsupp.sum_fintype] using hw
      have hex : ∃ μ₀ : Fin (M + 1), s μ₀ ≠ 0 := by
        by_contra hall
        rw [not_exists] at hall
        have : ∑ μ : Fin (M + 1), s μ = 0 := Finset.sum_eq_zero (fun μ _ => not_not.mp (hall μ))
        omega
      obtain ⟨μ₀, hμ₀⟩ := hex
      have hsplit := Finset.add_sum_erase Finset.univ (fun μ => s μ) (Finset.mem_univ μ₀)
      have hrest : ∑ μ ∈ Finset.univ.erase μ₀, s μ = 0 := by omega
      have hs_μ₀ : s μ₀ = 1 := by omega
      have hs_other : ∀ μ : Fin (M + 1), μ ≠ μ₀ → s μ = 0 := by
        intro μ hne
        exact (Finset.sum_eq_zero_iff_of_nonneg (fun _ _ => Nat.zero_le _)).mp hrest μ
          (Finset.mem_erase.mpr ⟨hne, Finset.mem_univ μ⟩)
      apply hs μ₀
      ext μ
      by_cases h : μ = μ₀
      · subst h; simp [hs_μ₀]
      · rw [hs_other μ h, Finsupp.single_apply, if_neg (Ne.symm h)]

  have hPivotMinor : ∀ (n_r n_c : ℕ) (A : Matrix (Fin n_r) (Fin n_c) k),
      Function.Surjective A.mulVecLin →
      ∃ S : Finset (Fin n_c), S.card = n_r ∧
        ∀ e : Fin n_r ≃ ↥S, (Matrix.of fun r s : Fin n_r => A r (e s).1).det ≠ 0 := by
    intro n_r
    induction n_r with
    | zero =>
      intro n_c A _
      refine ⟨∅, Finset.card_empty, fun _ => ?_⟩
      simp
    | succ n_r ih =>
      intro n_c A hSurj
      obtain ⟨v₀, hv₀⟩ := hSurj (Pi.single 0 1)
      have hv₀_0 : ∑ j : Fin n_c, A 0 j * v₀ j = 1 := by
        simpa [Matrix.mulVec, dotProduct] using congrFun hv₀ 0
      have hex_col : ∃ j₀ : Fin n_c, A 0 j₀ ≠ 0 := by
        by_contra hall
        rw [not_exists] at hall
        have : (∑ j : Fin n_c, A 0 j * v₀ j) = 0 :=
          Finset.sum_eq_zero fun j _ => by rw [not_not.mp (hall j), zero_mul]
        exact one_ne_zero (hv₀_0.symm.trans this)
      obtain ⟨j₀, hj₀⟩ := hex_col
      have hn_pos : 1 ≤ n_c := Nat.pos_of_ne_zero (fun h0 => by subst h0; exact Fin.elim0 j₀)
      let e_nc : Fin ((n_c - 1) + 1) ≃ Fin n_c := finCongr (Nat.sub_add_cancel hn_pos)
      let p₀ : Fin ((n_c - 1) + 1) := e_nc.symm j₀
      have hp₀ : e_nc p₀ = j₀ := e_nc.apply_symm_apply j₀
      let col_rest : Fin (n_c - 1) → Fin n_c := fun j => e_nc (p₀.succAbove j)
      let A' : Matrix (Fin n_r) (Fin (n_c - 1)) k :=
        Matrix.of fun r j =>
          A r.succ (col_rest j) - A r.succ j₀ * (A 0 j₀)⁻¹ * A 0 (col_rest j)
      have hSurj' : Function.Surjective A'.mulVecLin := by
        intro w
        obtain ⟨u, hu⟩ := hSurj (Fin.cons 0 w)
        have hu0 : A 0 j₀ * u j₀ + ∑ j : Fin (n_c - 1), A 0 (col_rest j) * u (col_rest j) = 0 := by
          have h1 : ∑ j : Fin n_c, A 0 j * u j = 0 := by
            simpa [Matrix.mulVec, dotProduct] using congrFun hu 0
          rw [← Equiv.sum_comp e_nc (fun j => A 0 j * u j),
            Fin.sum_univ_succAbove _ p₀, hp₀] at h1
          exact h1
        have huj₀ : u j₀ = - (A 0 j₀)⁻¹ * ∑ j : Fin (n_c - 1), A 0 (col_rest j) * u (col_rest j) := by
          have h2 := eq_neg_of_add_eq_zero_left hu0
          calc u j₀ = (A 0 j₀)⁻¹ * (A 0 j₀ * u j₀) := by
                rw [← mul_assoc, inv_mul_cancel₀ hj₀, one_mul]
            _ = - (A 0 j₀)⁻¹ * ∑ j : Fin (n_c - 1), A 0 (col_rest j) * u (col_rest j) := by
                rw [h2]; ring
        refine ⟨fun j => u (col_rest j), ?_⟩
        ext r
        have hur : A r.succ j₀ * u j₀ +
            ∑ j : Fin (n_c - 1), A r.succ (col_rest j) * u (col_rest j) = w r := by
          have h1 : ∑ j : Fin n_c, A r.succ j * u j = w r := by
            simpa [Matrix.mulVec, dotProduct] using congrFun hu r.succ
          rw [← Equiv.sum_comp e_nc (fun j => A r.succ j * u j),
            Fin.sum_univ_succAbove _ p₀, hp₀] at h1
          exact h1
        rw [huj₀] at hur
        change ∑ j : Fin (n_c - 1), A' r j * u (col_rest j) = w r
        rw [← hur]
        simp only [A', Matrix.of_apply]
        have hsplit : ∀ j : Fin (n_c - 1),
            (A r.succ (col_rest j) - A r.succ j₀ * (A 0 j₀)⁻¹ * A 0 (col_rest j)) * u (col_rest j) =
            -(A r.succ j₀ * (A 0 j₀)⁻¹ * (A 0 (col_rest j) * u (col_rest j))) +
              A r.succ (col_rest j) * u (col_rest j) := fun _ => by ring
        simp_rw [hsplit, Finset.sum_add_distrib, Finset.sum_neg_distrib, ← Finset.mul_sum]
        ring
      obtain ⟨S', hS'_card, hS'_det⟩ := ih (n_c - 1) A' hSurj'
      have hcol_inj : Function.Injective col_rest := e_nc.injective.comp Fin.succAbove_right_injective
      let emb_rest : Fin (n_c - 1) ↪ Fin n_c := ⟨col_rest, hcol_inj⟩
      let S : Finset (Fin n_c) := insert j₀ (S'.map emb_rest)
      have hj₀_notMem : j₀ ∉ S'.map emb_rest := by
        rw [Finset.mem_map]
        rintro ⟨j, _, hj_eq⟩
        have : e_nc (p₀.succAbove j) = e_nc p₀ := hj_eq.trans hp₀.symm
        exact Fin.succAbove_ne p₀ j (e_nc.injective this)
      have hS_card : S.card = n_r + 1 := by
        rw [Finset.card_insert_of_notMem hj₀_notMem, Finset.card_map, hS'_card]
      refine ⟨S, hS_card, fun e => ?_⟩
      let s₀ : Fin (n_r + 1) := e.symm ⟨j₀, Finset.mem_insert_self _ _⟩
      have hs₀_val : (e s₀).1 = j₀ := congrArg Subtype.val (e.apply_symm_apply _)
      have hrest_mem : ∀ s : Fin n_r, ∃ j ∈ S', col_rest j = (e (s₀.succAbove s)).1 := by
        intro s
        have hmem : (e (s₀.succAbove s)).1 ∈ S := (e (s₀.succAbove s)).2
        rw [Finset.mem_insert] at hmem
        rcases hmem with h_eq | h_map
        · exfalso
          have : e (s₀.succAbove s) = e s₀ := Subtype.ext (h_eq.trans hs₀_val.symm)
          exact Fin.succAbove_ne s₀ s (e.injective this)
        · obtain ⟨j, hjS', hj_eq⟩ := Finset.mem_map.mp h_map
          exact ⟨j, hjS', hj_eq⟩
      let g_fun : Fin n_r → ↥S' := fun s =>
        ⟨Classical.choose (hrest_mem s), (Classical.choose_spec (hrest_mem s)).1⟩
      have hg_spec : ∀ s : Fin n_r, col_rest (g_fun s).1 = (e (s₀.succAbove s)).1 :=
        fun s => (Classical.choose_spec (hrest_mem s)).2
      have hg_inj : Function.Injective g_fun := by
        intro s₁ s₂ h12
        have hval : (g_fun s₁).1 = (g_fun s₂).1 := congrArg Subtype.val h12
        have he_eq : e (s₀.succAbove s₁) = e (s₀.succAbove s₂) :=
          Subtype.ext ((hg_spec s₁).symm.trans ((congrArg col_rest hval).trans (hg_spec s₂)))
        exact Fin.succAbove_right_injective (e.injective he_eq)
      let _ : Fintype ↥S' := Finset.fintypeCoeSort S'
      have hcard_eq : Fintype.card (Fin n_r) = Fintype.card ↥S' := by
        rw [Fintype.card_fin, Fintype.card_coe, hS'_card]
      let e' : Fin n_r ≃ ↥S' := Equiv.ofBijective g_fun
        ((Fintype.bijective_iff_injective_and_card g_fun).mpr ⟨hg_inj, hcard_eq⟩)
      let M_sub : Matrix (Fin (n_r + 1)) (Fin (n_r + 1)) k :=
        Matrix.of fun r s => A r (e s).1
      let perm_col : Fin (n_r + 1) → Fin (n_r + 1) := Fin.cons s₀ s₀.succAbove
      let P_perm : Matrix (Fin (n_r + 1)) (Fin (n_r + 1)) k :=
        Matrix.of fun t s => (1 : Matrix (Fin (n_r + 1)) (Fin (n_r + 1)) k) t (perm_col s)
      let M_ord : Matrix (Fin (n_r + 1)) (Fin (n_r + 1)) k := M_sub * P_perm
      have hM_ord_apply : ∀ r s : Fin (n_r + 1), M_ord r s = A r (e (perm_col s)).1 := by
        intro r s
        simp [M_ord, Matrix.mul_apply, M_sub, P_perm, Matrix.one_apply]
      let e_blk : Unit ⊕ Fin n_r ≃ Fin (n_r + 1) :=
        { toFun := Sum.elim (fun _ => 0) Fin.succ
          invFun := Fin.cases (Sum.inl ()) Sum.inr
          left_inv := by rintro (⟨⟩ | s) <;> simp
          right_inv := by refine Fin.cases ?_ (fun s => ?_) <;> simp }
      let A₁₁ : Matrix Unit Unit k := Matrix.of fun _ _ => A 0 j₀
      let B₁₂ : Matrix Unit (Fin n_r) k := Matrix.of fun _ s => A 0 (col_rest (e' s).1)
      let C₂₁ : Matrix (Fin n_r) Unit k := Matrix.of fun r _ => A r.succ j₀
      let D₂₂ : Matrix (Fin n_r) (Fin n_r) k := Matrix.of fun r s => A r.succ (col_rest (e' s).1)
      have hBlk : Matrix.reindex e_blk.symm e_blk.symm M_ord =
          Matrix.fromBlocks A₁₁ B₁₂ C₂₁ D₂₂ := by
        ext (⟨⟩ | r) (⟨⟩ | s)
        · simp [Matrix.reindex_apply, Matrix.submatrix_apply, e_blk, hM_ord_apply, perm_col,
            hs₀_val, A₁₁]
        · simp [Matrix.reindex_apply, Matrix.submatrix_apply, e_blk, hM_ord_apply, perm_col,
            B₁₂, e', hg_spec]
        · simp [Matrix.reindex_apply, Matrix.submatrix_apply, e_blk, hM_ord_apply, perm_col,
            hs₀_val, C₂₁]
        · simp [Matrix.reindex_apply, Matrix.submatrix_apply, e_blk, hM_ord_apply, perm_col,
            D₂₂, e', hg_spec]
      let _ : Invertible A₁₁ :=
        { invOf := Matrix.of fun _ _ => (A 0 j₀)⁻¹
          invOf_mul_self := by ext ⟨⟩ ⟨⟩; simp [A₁₁, Matrix.mul_apply, inv_mul_cancel₀ hj₀]
          mul_invOf_self := by ext ⟨⟩ ⟨⟩; simp [A₁₁, Matrix.mul_apply, mul_inv_cancel₀ hj₀] }
      have hSchur_eq : D₂₂ - C₂₁ * ⅟A₁₁ * B₁₂ = Matrix.of (fun r s => A' r (e' s).1) := by
        ext r s
        simp only [Matrix.sub_apply, Matrix.mul_apply, Fintype.univ_punit, Finset.sum_singleton,
          D₂₂, C₂₁, B₁₂, A', Matrix.of_apply]
        rfl
      have hDet_ord : M_ord.det ≠ 0 := by
        rw [← Matrix.det_reindex_self e_blk.symm M_ord, hBlk,
          Matrix.det_fromBlocks₁₁ A₁₁ B₁₂ C₂₁ D₂₂, Matrix.det_unique A₁₁, hSchur_eq]
        exact mul_ne_zero hj₀ (hS'_det e')
      rw [Matrix.det_mul] at hDet_ord
      exact left_ne_zero_of_mul hDet_ord

  have hFinsetSplit : ∀ {n_r n_free n_c : ℕ} (hn : n_r + n_free = n_c)
      (S : Finset (Fin n_c)) (hS : S.card = n_r),
      ∃ (e_S : Fin n_r ⊕ Fin n_free ≃ Fin n_c) (e_sub : Fin n_r ≃ ↥S),
        ∀ s : Fin n_r, e_S (Sum.inl s) = (e_sub s).1 := by
    intro n_r n_free n_c hn S hS
    let e₁ : Fin n_r ≃ ↥S := (Finset.equivFinOfCardEq hS).symm
    have hSc : (Sᶜ : Finset (Fin n_c)).card = n_free := by
      rw [Finset.card_compl, Fintype.card_fin, hS]
      omega
    let e₂ : Fin n_free ≃ ↥(Sᶜ : Finset (Fin n_c)) := (Finset.equivFinOfCardEq hSc).symm
    let f_S : Fin n_r ⊕ Fin n_free → Fin n_c := Sum.elim (fun s => (e₁ s).1) (fun a => (e₂ a).1)
    have hf_inj : Function.Injective f_S := by
      rintro (s₁ | a₁) (s₂ | a₂) h
      · exact congrArg Sum.inl (e₁.injective (Subtype.ext h))
      · exfalso
        change (e₁ s₁).1 = (e₂ a₂).1 at h
        have h1 : (e₁ s₁).1 ∈ S := (e₁ s₁).2
        have h2 : (e₂ a₂).1 ∉ S := Finset.mem_compl.mp (e₂ a₂).2
        exact h2 (h ▸ h1)
      · exfalso
        change (e₂ a₁).1 = (e₁ s₂).1 at h
        have h1 : (e₁ s₂).1 ∈ S := (e₁ s₂).2
        have h2 : (e₂ a₁).1 ∉ S := Finset.mem_compl.mp (e₂ a₁).2
        exact h2 (h.symm ▸ h1)
      · exact congrArg Sum.inr (e₂.injective (Subtype.ext h))
    have hcard_sum : Fintype.card (Fin n_r ⊕ Fin n_free) = Fintype.card (Fin n_c) := by
      rw [Fintype.card_sum, Fintype.card_fin, Fintype.card_fin, Fintype.card_fin, hn]
    exact ⟨Equiv.ofBijective f_S
      ((Fintype.bijective_iff_injective_and_card f_S).mpr ⟨hf_inj, hcard_sum⟩),
      e₁, fun _ => rfl⟩

  have hAwayDomTrdeg : ∀ {R : Type u} [CommRing R] [IsDomain R] [Algebra k R] {d_tr : ℕ},
      Algebra.trdeg k R ≤ (d_tr : Cardinal.{u}) →
      ∀ (δ : R) (hδ : δ ≠ 0),
        ∃ (_ : IsDomain (Localization.Away δ)),
          Algebra.trdeg k (Localization.Away δ) ≤ (d_tr : Cardinal.{u}) := by
    intro R _ _ _ d_tr hTr δ hδ
    let S := Localization.Away δ
    have hSub : Submonoid.powers δ ≤ nonZeroDivisors R :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hδ)
    have hDomS : IsDomain S := IsLocalization.isDomain_localization hSub
    let _ : IsDomain S := hDomS
    have hinj : Function.Injective (algebraMap R S) := IsLocalization.injective S hSub
    have : FaithfulSMul k R := (faithfulSMul_iff_algebraMap_injective k R).mpr (RingHom.injective _)
    have : FaithfulSMul R S := (faithfulSMul_iff_algebraMap_injective R S).mpr hinj
    have : Algebra.IsAlgebraic R S := ⟨fun x => by
      let a := (IsLocalization.Away.sec δ x).1
      let n := (IsLocalization.Away.sec δ x).2
      refine ⟨Polynomial.C (δ ^ n) * Polynomial.X - Polynomial.C a, ?_, ?_⟩
      · intro h0
        have h1 := congrArg (fun p => p.coeff 1) h0
        simp only [Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_one,
          mul_one, Polynomial.coeff_C_succ, sub_zero, Polynomial.coeff_zero] at h1
        exact pow_ne_zero n hδ h1
      · simp only [Polynomial.aeval_def, Polynomial.eval₂_sub, Polynomial.eval₂_mul,
          Polynomial.eval₂_C, Polynomial.eval₂_X]
        dsimp only [a, n]
        rw [mul_comm, IsLocalization.Away.sec_spec δ x, sub_self]⟩
    refine ⟨hDomS, ?_⟩
    have htr := trdeg_add_eq k R (A := S)
    rw [trdeg_eq_zero (R := R) (A := S), add_zero] at htr
    rwa [← htr]

  have hExistsDerivAway : ∀ {R : Type u} [CommRing R] [IsDomain R] [Algebra k R]
      (δ : R) (hδ : δ ≠ 0) (D : Derivation k R R),
      ∃ D_S : Derivation k (Localization.Away δ) (Localization.Away δ),
        ∀ r : R, D_S (algebraMap R (Localization.Away δ) r) =
          algebraMap R (Localization.Away δ) (D r) := by
    intro R _ _ _ δ hδ D
    let S := Localization.Away δ
    let u : Sˣ := (IsLocalization.Away.algebraMap_isUnit (S := S) δ).unit
    have hu_val : (u : S) = algebraMap R S δ := rfl
    have hSub : Submonoid.powers δ ≤ nonZeroDivisors R :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hδ)
    have hinj : Function.Injective (algebraMap R S) := IsLocalization.injective S hSub
    have hD_pow : ∀ m : ℕ, D (δ ^ m) * δ = (m : R) * δ ^ m * D δ := by
      intro m
      induction m with
      | zero => simp
      | succ m ihm =>
        calc D (δ ^ (m + 1)) * δ
            = (δ ^ m * D δ + δ * D (δ ^ m)) * δ := by rw [pow_succ, D.leibniz]; ring
          _ = δ ^ (m + 1) * D δ + δ * (D (δ ^ m) * δ) := by rw [pow_succ]; ring
          _ = δ ^ (m + 1) * D δ + δ * ((m : R) * δ ^ m * D δ) := by rw [ihm]
          _ = ((m + 1 : ℕ) : R) * δ ^ (m + 1) * D δ := by push_cast; ring
    let num : R → ℕ → R := fun a n => δ * D a - (n : R) * a * D δ
    let form : R → ℕ → S := fun a n => algebraMap R S (num a n) * ↑((u ^ (n + 1))⁻¹)
    have hnum_eq : ∀ (a b : R) (n m : ℕ), a * δ ^ m = b * δ ^ n →
        num a n * δ ^ (m + 1) = num b m * δ ^ (n + 1) := by
      intro a b n m hab
      have hDab : D (a * δ ^ m) * δ = D (b * δ ^ n) * δ := congrArg (· * δ) (congrArg D hab)
      have hExp : ∀ (c : R) (r : ℕ), D (c * δ ^ r) * δ =
          c * ((r : R) * δ ^ r * D δ) + δ ^ (r + 1) * D c := by
        intro c r
        calc D (c * δ ^ r) * δ
            = (c * D (δ ^ r) + δ ^ r * D c) * δ := by
                rw [D.leibniz, smul_eq_mul, smul_eq_mul]
          _ = c * (D (δ ^ r) * δ) + δ ^ (r + 1) * D c := by rw [pow_succ]; ring
          _ = c * ((r : R) * δ ^ r * D δ) + δ ^ (r + 1) * D c := by rw [hD_pow r]
      rw [hExp a m, hExp b n] at hDab
      dsimp only [num]
      have hab_d : (a * δ ^ m) * D δ = (b * δ ^ n) * D δ := congrArg (· * D δ) hab
      calc (δ * D a - (n : R) * a * D δ) * δ ^ (m + 1)
          = δ * (δ ^ (m + 1) * D a) - (n : R) * δ * ((a * δ ^ m) * D δ) := by
              rw [pow_succ]; ring
        _ = δ * (δ ^ (m + 1) * D a) - (n : R) * δ * ((b * δ ^ n) * D δ) := by rw [hab_d]
        _ = δ * (δ ^ (n + 1) * D b + b * ((n : R) * δ ^ n * D δ) -
              a * ((m : R) * δ ^ m * D δ)) - (n : R) * δ * ((b * δ ^ n) * D δ) := by
              linear_combination δ * hDab
        _ = δ * (δ ^ (n + 1) * D b) - (m : R) * δ * ((a * δ ^ m) * D δ) := by ring
        _ = δ * (δ ^ (n + 1) * D b) - (m : R) * δ * ((b * δ ^ n) * D δ) := by rw [hab_d]
        _ = (δ * D b - (m : R) * b * D δ) * δ ^ (n + 1) := by rw [pow_succ]; ring
    have hform_eq : ∀ (x : S) (a b : R) (n m : ℕ),
        x * algebraMap R S (δ ^ n) = algebraMap R S a →
        x * algebraMap R S (δ ^ m) = algebraMap R S b →
        form a n = form b m := by
      intro x a b n m ha hb
      have hab : a * δ ^ m = b * δ ^ n := hinj (by
        rw [map_mul, map_mul, ← ha, ← hb, map_pow, map_pow]; ring)
      have hnum_S := congrArg (algebraMap R S) (hnum_eq a b n m hab)
      rw [map_mul, map_mul, map_pow, map_pow, ← hu_val] at hnum_S
      apply ((u.isUnit).pow ((n + 1) + (m + 1))).mul_right_cancel
      dsimp only [form]
      have h1 : (u : S) ^ (n + 1) * ↑((u ^ (n + 1))⁻¹) = 1 := Units.mul_inv (u ^ (n + 1))
      have h2 : (u : S) ^ (m + 1) * ↑((u ^ (m + 1))⁻¹) = 1 := Units.mul_inv (u ^ (m + 1))
      calc algebraMap R S (num a n) * ↑((u ^ (n + 1))⁻¹) * (u : S) ^ ((n + 1) + (m + 1))
          = algebraMap R S (num a n) * ((u : S) ^ (n + 1) * ↑((u ^ (n + 1))⁻¹)) *
              (u : S) ^ (m + 1) := by rw [pow_add]; ring
        _ = algebraMap R S (num a n) * (u : S) ^ (m + 1) := by rw [h1, mul_one]
        _ = algebraMap R S (num b m) * (u : S) ^ (n + 1) := hnum_S
        _ = algebraMap R S (num b m) * ((u : S) ^ (m + 1) * ↑((u ^ (m + 1))⁻¹)) *
              (u : S) ^ (n + 1) := by rw [h2, mul_one]
        _ = algebraMap R S (num b m) * ↑((u ^ (m + 1))⁻¹) * (u : S) ^ ((n + 1) + (m + 1)) := by
              rw [pow_add]; ring
    let dFun : S → S := fun x =>
      form (IsLocalization.Away.sec δ x).1 (IsLocalization.Away.sec δ x).2
    have hdFun_spec : ∀ (x : S) (a : R) (n : ℕ),
        x * algebraMap R S (δ ^ n) = algebraMap R S a → dFun x = form a n :=
      fun x a n h => hform_eq x _ a _ n (IsLocalization.Away.sec_spec δ x) h
    have hdFun_alg : ∀ r : R, dFun (algebraMap R S r) = algebraMap R S (D r) := by
      intro r
      rw [hdFun_spec (algebraMap R S r) r 0 (by simp)]
      dsimp only [form, num]
      simp only [Nat.cast_zero, zero_mul, sub_zero, map_mul, Nat.zero_add, pow_one, ← hu_val]
      rw [mul_comm (u : S), mul_assoc, Units.mul_inv, mul_one]
    exact ⟨{
      toFun := dFun
      map_add' := fun x y => by
        let a := (IsLocalization.Away.sec δ x).1
        let n := (IsLocalization.Away.sec δ x).2
        let b := (IsLocalization.Away.sec δ y).1
        let m := (IsLocalization.Away.sec δ y).2
        have hx : x * algebraMap R S (δ ^ n) = algebraMap R S a := IsLocalization.Away.sec_spec δ x
        have hy : y * algebraMap R S (δ ^ m) = algebraMap R S b := IsLocalization.Away.sec_spec δ y
        have hxy : (x + y) * algebraMap R S (δ ^ (n + m)) =
            algebraMap R S (a * δ ^ m + b * δ ^ n) := by
          rw [pow_add, map_mul, map_add, map_mul, map_mul]
          linear_combination algebraMap R S (δ ^ m) * hx + algebraMap R S (δ ^ n) * hy
        rw [hdFun_spec (x + y) _ (n + m) hxy, hdFun_spec x a n hx, hdFun_spec y b m hy]
        have hnum_add : num (a * δ ^ m + b * δ ^ n) (n + m) =
            num a n * δ ^ m + num b m * δ ^ n := by
          dsimp only [num]
          rw [map_add, D.leibniz, D.leibniz, smul_eq_mul, smul_eq_mul, smul_eq_mul, smul_eq_mul,
            Nat.cast_add]
          linear_combination a * hD_pow m + b * hD_pow n
        dsimp only [form]
        rw [hnum_add, map_add, map_mul, map_mul, map_pow, map_pow, ← hu_val]
        apply ((u.isUnit).pow (n + m + 2)).mul_right_cancel
        have h1 : (u : S) ^ (n + m + 1) * ↑((u ^ (n + m + 1))⁻¹) = 1 :=
          Units.mul_inv (u ^ (n + m + 1))
        have h2 : (u : S) ^ (n + 1) * ↑((u ^ (n + 1))⁻¹) = 1 := Units.mul_inv (u ^ (n + 1))
        have h3 : (u : S) ^ (m + 1) * ↑((u ^ (m + 1))⁻¹) = 1 := Units.mul_inv (u ^ (m + 1))
        calc (algebraMap R S (num a n) * (u : S) ^ m + algebraMap R S (num b m) * (u : S) ^ n) *
              ↑((u ^ (n + m + 1))⁻¹) * (u : S) ^ (n + m + 2)
            = (algebraMap R S (num a n) * (u : S) ^ m + algebraMap R S (num b m) * (u : S) ^ n) *
                ((u : S) ^ (n + m + 1) * ↑((u ^ (n + m + 1))⁻¹)) * (u : S) := by
                rw [show n + m + 2 = (n + m + 1) + 1 from rfl, pow_succ]; ring
          _ = algebraMap R S (num a n) * (u : S) ^ (m + 1) +
                algebraMap R S (num b m) * (u : S) ^ (n + 1) := by
                rw [h1, pow_succ, pow_succ]; ring
          _ = algebraMap R S (num a n) * ↑((u ^ (n + 1))⁻¹) * ((u : S) ^ (n + 1) * (u : S) ^ (m + 1)) +
                algebraMap R S (num b m) * ↑((u ^ (m + 1))⁻¹) * ((u : S) ^ (m + 1) * (u : S) ^ (n + 1)) := by
                linear_combination
                  - algebraMap R S (num a n) * (u : S) ^ (m + 1) * h2 -
                    algebraMap R S (num b m) * (u : S) ^ (n + 1) * h3
          _ = (algebraMap R S (num a n) * ↑((u ^ (n + 1))⁻¹) +
                algebraMap R S (num b m) * ↑((u ^ (m + 1))⁻¹)) * (u : S) ^ (n + m + 2) := by
                have hp1 : (u : S) ^ (n + 1) * (u : S) ^ (m + 1) = (u : S) ^ (n + m + 2) := by
                  rw [← pow_add]; congr 1; omega
                have hp2 : (u : S) ^ (m + 1) * (u : S) ^ (n + 1) = (u : S) ^ (n + m + 2) := by
                  rw [← pow_add]; congr 1; omega
                rw [hp1, hp2]; ring
      map_smul' := fun c x => by
        change dFun (c • x) = c • dFun x
        rw [Algebra.smul_def, Algebra.smul_def]
        let a := (IsLocalization.Away.sec δ x).1
        let n := (IsLocalization.Away.sec δ x).2
        have hx : x * algebraMap R S (δ ^ n) = algebraMap R S a := IsLocalization.Away.sec_spec δ x
        have hcx : (algebraMap k S c * x) * algebraMap R S (δ ^ n) =
            algebraMap R S (algebraMap k R c * a) := by
          rw [IsScalarTower.algebraMap_apply k R S c, mul_assoc, hx, map_mul]
        rw [hdFun_spec _ _ n hcx, hdFun_spec x a n hx]
        dsimp only [form, num]
        rw [← Algebra.smul_def c a, D.map_smul, Algebra.smul_def, Algebra.smul_def,
          IsScalarTower.algebraMap_apply k R S c]
        push_cast
        ring
      map_one_eq_zero' := by
        change dFun 1 = 0
        simpa using hdFun_alg 1
      leibniz' := fun x y => by
        change dFun (x * y) = x * dFun y + y * dFun x
        let a := (IsLocalization.Away.sec δ x).1
        let n := (IsLocalization.Away.sec δ x).2
        let b := (IsLocalization.Away.sec δ y).1
        let m := (IsLocalization.Away.sec δ y).2
        have hx : x * algebraMap R S (δ ^ n) = algebraMap R S a := IsLocalization.Away.sec_spec δ x
        have hy : y * algebraMap R S (δ ^ m) = algebraMap R S b := IsLocalization.Away.sec_spec δ y
        have hxy : (x * y) * algebraMap R S (δ ^ (n + m)) = algebraMap R S (a * b) := by
          rw [pow_add, map_mul, map_mul]
          linear_combination (x * algebraMap R S (δ ^ n)) * hy + algebraMap R S b * hx
        rw [hdFun_spec (x * y) (a * b) (n + m) hxy, hdFun_spec x a n hx, hdFun_spec y b m hy]
        have hnum_mul : num (a * b) (n + m) = a * num b m + b * num a n := by
          dsimp only [num]
          rw [D.leibniz, smul_eq_mul, smul_eq_mul, Nat.cast_add]
          ring
        dsimp only [form]
        rw [hnum_mul, map_add, map_mul, map_mul]
        have ha' : algebraMap R S a = x * (u : S) ^ n := by rw [← hx, map_pow, hu_val]
        have hb' : algebraMap R S b = y * (u : S) ^ m := by rw [← hy, map_pow, hu_val]
        rw [ha', hb']
        apply ((u.isUnit).pow (n + m + 1)).mul_right_cancel
        have h1 : (u : S) ^ (n + m + 1) * ↑((u ^ (n + m + 1))⁻¹) = 1 :=
          Units.mul_inv (u ^ (n + m + 1))
        have h2 : (u : S) ^ (m + 1) * ↑((u ^ (m + 1))⁻¹) = 1 := Units.mul_inv (u ^ (m + 1))
        have h3 : (u : S) ^ (n + 1) * ↑((u ^ (n + 1))⁻¹) = 1 := Units.mul_inv (u ^ (n + 1))
        calc (x * (u : S) ^ n * algebraMap R S (num b m) +
                y * (u : S) ^ m * algebraMap R S (num a n)) *
              ↑((u ^ (n + m + 1))⁻¹) * (u : S) ^ (n + m + 1)
            = (x * (u : S) ^ n * algebraMap R S (num b m) +
                y * (u : S) ^ m * algebraMap R S (num a n)) *
                ((u : S) ^ (n + m + 1) * ↑((u ^ (n + m + 1))⁻¹)) := by ring
          _ = x * (u : S) ^ n * algebraMap R S (num b m) +
                y * (u : S) ^ m * algebraMap R S (num a n) := by rw [h1, mul_one]
          _ = x * (algebraMap R S (num b m) * ↑((u ^ (m + 1))⁻¹)) * ((u : S) ^ n * (u : S) ^ (m + 1)) +
                y * (algebraMap R S (num a n) * ↑((u ^ (n + 1))⁻¹)) * ((u : S) ^ m * (u : S) ^ (n + 1)) := by
                linear_combination
                  - x * (u : S) ^ n * algebraMap R S (num b m) * h2 -
                    y * (u : S) ^ m * algebraMap R S (num a n) * h3
          _ = (x * (algebraMap R S (num b m) * ↑((u ^ (m + 1))⁻¹)) +
                y * (algebraMap R S (num a n) * ↑((u ^ (n + 1))⁻¹))) * (u : S) ^ (n + m + 1) := by
                have hp1 : (u : S) ^ n * (u : S) ^ (m + 1) = (u : S) ^ (n + m + 1) := by
                  rw [← pow_add]; congr 1
                have hp2 : (u : S) ^ m * (u : S) ^ (n + 1) = (u : S) ^ (n + m + 1) := by
                  rw [← pow_add]; congr 1; omega
                rw [hp1, hp2]; ring
    }, hdFun_alg⟩

  have hTensorDomTrdeg : ∀ (A₁ A₂ : Type u) [CommRing A₁] [IsDomain A₁] [Algebra k A₁]
      [Algebra.FiniteType k A₁] [CommRing A₂] [IsDomain A₂] [Algebra k A₂]
      [Algebra.FiniteType k A₂],
      Algebra.trdeg k A₁ ≤ (d : Cardinal.{u}) →
      Algebra.trdeg k A₂ ≤ (d : Cardinal.{u}) →
      ∃ (_ : IsDomain (TensorProduct k A₁ A₂)),
        Algebra.trdeg k (TensorProduct k A₁ A₂) ≤ ((2 * d : ℕ) : Cardinal.{u}) := by
    intro A₁ A₂ _ _ _ _ _ _ _ _ hTr₁ hTr₂
    let E₂ := FractionRing A₂
    have hDomE : IsDomain (TensorProduct k A₁ E₂) :=
      ((weil_algClosed_domain_tensor_and_minimalPrime_krullDim_ge_two k).1 E₂ A₁).1
    let f_E₂ : A₂ →ₐ[k] E₂ := IsScalarTower.toAlgHom k A₂ E₂
    have hf_E₂_inj : Function.Injective f_E₂ := IsFractionRing.injective A₂ E₂
    let ι₁₂ : TensorProduct k A₁ A₂ →ₐ[k] TensorProduct k A₁ E₂ :=
      Algebra.TensorProduct.map (AlgHom.id k A₁) f_E₂
    have hι_lin : (ι₁₂ : TensorProduct k A₁ A₂ → TensorProduct k A₁ E₂) =
        ⇑(LinearMap.lTensor A₁ f_E₂.toLinearMap) := by
      ext x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul a₁ a₂ => rfl
      | add x y ihx ihy => simp [map_add, ihx, ihy]
    have hι_inj : Function.Injective ι₁₂ := by
      rw [hι_lin]
      exact Module.Flat.lTensor_preserves_injective_linearMap f_E₂.toLinearMap hf_E₂_inj
    have hDomC : IsDomain (TensorProduct k A₁ A₂) :=
      @Function.Injective.isDomain _ _ _ hDomE _ _ _ _ ι₁₂.toRingHom hι_inj
    let _ : IsDomain (TensorProduct k A₁ A₂) := hDomC
    refine ⟨hDomC, ?_⟩
    obtain ⟨r₁, g₁, hg₁_inj, hg₁_int⟩ := exists_integral_inj_algHom_of_fg k A₁
    obtain ⟨r₂, g₂, hg₂_inj, hg₂_int⟩ := exists_integral_inj_algHom_of_fg k A₂
    have hr₁_le : (r₁ : Cardinal.{u}) ≤ (d : Cardinal.{u}) := by
      have h1 := trdeg_le_of_injective g₁ hg₁_inj
      rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Fintype.card_fin,
        Cardinal.lift_natCast] at h1
      exact h1.trans hTr₁
    have hr₂_le : (r₂ : Cardinal.{u}) ≤ (d : Cardinal.{u}) := by
      have h2 := trdeg_le_of_injective g₂ hg₂_inj
      rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Fintype.card_fin,
        Cardinal.lift_natCast] at h2
      exact h2.trans hTr₂
    let C₁₂ := TensorProduct k A₁ A₂
    let inlC : A₁ →ₐ[k] C₁₂ := Algebra.TensorProduct.includeLeft
    let inrC : A₂ →ₐ[k] C₁₂ := Algebra.TensorProduct.includeRight
    let g₁₂ : MvPolynomial (Fin r₁ ⊕ Fin r₂) k →ₐ[k] C₁₂ :=
      MvPolynomial.aeval (Sum.elim
        (fun i => inlC (g₁ (MvPolynomial.X i)))
        (fun j => inrC (g₂ (MvPolynomial.X j))))
    let S_sub : Subalgebra k C₁₂ := g₁₂.range
    have hInt_C₁₂ : Algebra.IsIntegral ↥S_sub C₁₂ := by
      constructor
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact isIntegral_zero
      | tmul a₁ a₂ =>
        have ha₁ : IsIntegral ↥S_sub (inlC a₁) := by
          obtain ⟨p, hp_mon, hp_eval⟩ := hg₁_int a₁
          let φ₁ : MvPolynomial (Fin r₁) k →+* ↥S_sub :=
            { toFun := fun P => ⟨inlC (g₁ P),
                ⟨MvPolynomial.rename Sum.inl P, by
                  have h_comp : g₁₂.comp (MvPolynomial.rename Sum.inl) = inlC.comp g₁ := by
                    apply MvPolynomial.algHom_ext; intro i; simp [g₁₂]
                  exact DFunLike.congr_fun h_comp P⟩⟩
              map_one' := Subtype.ext (by simp)
              map_mul' := fun x y => Subtype.ext (by simp)
              map_zero' := Subtype.ext (by simp)
              map_add' := fun x y => Subtype.ext (by simp) }
          refine ⟨p.map φ₁, hp_mon.map φ₁, ?_⟩
          rw [Polynomial.eval₂_map]
          change Polynomial.eval₂ (inlC.toRingHom.comp g₁.toRingHom) (inlC.toRingHom a₁) p = 0
          rw [← Polynomial.hom_eval₂, hp_eval, map_zero]
        have ha₂ : IsIntegral ↥S_sub (inrC a₂) := by
          obtain ⟨p, hp_mon, hp_eval⟩ := hg₂_int a₂
          let φ₂ : MvPolynomial (Fin r₂) k →+* ↥S_sub :=
            { toFun := fun P => ⟨inrC (g₂ P),
                ⟨MvPolynomial.rename Sum.inr P, by
                  have h_comp : g₁₂.comp (MvPolynomial.rename Sum.inr) = inrC.comp g₂ := by
                    apply MvPolynomial.algHom_ext; intro j; simp [g₁₂]
                  exact DFunLike.congr_fun h_comp P⟩⟩
              map_one' := Subtype.ext (by simp)
              map_mul' := fun x y => Subtype.ext (by simp)
              map_zero' := Subtype.ext (by simp)
              map_add' := fun x y => Subtype.ext (by simp) }
          refine ⟨p.map φ₂, hp_mon.map φ₂, ?_⟩
          rw [Polynomial.eval₂_map]
          change Polynomial.eval₂ (inrC.toRingHom.comp g₂.toRingHom) (inrC.toRingHom a₂) p = 0
          rw [← Polynomial.hom_eval₂, hp_eval, map_zero]
        have hmul : (a₁ ⊗ₜ[k] a₂ : C₁₂) = inlC a₁ * inrC a₂ := by
          change (a₁ ⊗ₜ[k] a₂ : C₁₂) = (a₁ ⊗ₜ[k] (1 : A₂)) * ((1 : A₁) ⊗ₜ[k] a₂)
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hmul]
        exact ha₁.mul ha₂
      | add _ _ ihx ihy => exact ihx.add ihy
    have : Algebra.IsAlgebraic ↥S_sub C₁₂ := hInt_C₁₂.isAlgebraic
    have : FaithfulSMul k ↥S_sub :=
      (faithfulSMul_iff_algebraMap_injective k ↥S_sub).mpr (RingHom.injective _)
    have : FaithfulSMul ↥S_sub C₁₂ :=
      (faithfulSMul_iff_algebraMap_injective ↥S_sub C₁₂).mpr Subtype.val_injective
    have htr_eq : Algebra.trdeg k ↥S_sub + Algebra.trdeg ↥S_sub C₁₂ = Algebra.trdeg k C₁₂ :=
      trdeg_add_eq k ↥S_sub
    rw [trdeg_eq_zero (R := ↥S_sub) (A := C₁₂), add_zero] at htr_eq
    have htr_sub : Algebra.trdeg k ↥S_sub ≤ ((r₁ + r₂ : ℕ) : Cardinal.{u}) := by
      have hsurj : Function.Surjective g₁₂.rangeRestrict := g₁₂.rangeRestrict_surjective
      have hle := trdeg_le_of_surjective g₁₂.rangeRestrict hsurj
      rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Fintype.card_sum,
        Fintype.card_fin, Fintype.card_fin, Cardinal.lift_natCast] at hle
      exact hle
    rw [← htr_eq]
    calc Algebra.trdeg k ↥S_sub
        ≤ ((r₁ + r₂ : ℕ) : Cardinal.{u}) := htr_sub
      _ = (r₁ : Cardinal.{u}) + (r₂ : Cardinal.{u}) := by push_cast; rfl
      _ ≤ (d : Cardinal.{u}) + (d : Cardinal.{u}) := add_le_add hr₁_le hr₂_le
      _ = ((2 * d : ℕ) : Cardinal.{u}) := by push_cast; ring

  have hCramer : ∀ {n_r n_free n_c : ℕ} {B : Type u} [CommRing B] [Algebra k B]
      (J : Matrix (Fin n_r) (Fin n_c) B)
      (e_col : Fin n_r ⊕ Fin n_free ≃ Fin n_c),
      IsUnit (Matrix.of fun r s => J r (e_col (Sum.inl s))).det →
      let M_piv : Matrix (Fin n_r) (Fin n_r) B := Matrix.of fun r s => J r (e_col (Sum.inl s))
      let J_free : Matrix (Fin n_r) (Fin n_free) B := Matrix.of fun r a => J r (e_col (Sum.inr a))
      let Φ : MvPolynomial (Fin n_c) k →ₐ[k] MvPolynomial (Fin n_free) B :=
        MvPolynomial.aeval (fun μ =>
          Sum.elim
            (fun s => - ∑ a : Fin n_free,
              MvPolynomial.C (((Ring.inverse M_piv.det • M_piv.adjugate) * J_free) s a) *
                MvPolynomial.X a)
            MvPolynomial.X (e_col.symm μ))
      (∀ μ : Fin n_c, Φ (MvPolynomial.X μ) ∈ MvPolynomial.homogeneousSubmodule (Fin n_free) B 1) ∧
      (∀ r : Fin n_r, ∑ μ : Fin n_c, MvPolynomial.C (J r μ) * Φ (MvPolynomial.X μ) = 0) ∧
      (∀ {S : Type u} [CommRing S] (ρ : B →+* S) (w : Fin n_c → S),
        (∀ r : Fin n_r, ∑ μ : Fin n_c, ρ (J r μ) * w μ = 0) →
        ∀ μ : Fin n_c,
          MvPolynomial.eval₂ ρ (fun a => w (e_col (Sum.inr a))) (Φ (MvPolynomial.X μ)) = w μ) := by
    intro n_r n_free n_c B _ _ J e_col hPiv M_piv J_free Φ
    let M_inv : Matrix (Fin n_r) (Fin n_r) B := Ring.inverse M_piv.det • M_piv.adjugate
    have hM_mul_inv : M_piv * M_inv = 1 := by
      dsimp only [M_inv]
      rw [Matrix.mul_smul, Matrix.mul_adjugate, smul_smul, Ring.inverse_mul_cancel _ hPiv, one_smul]
    have hInv_mul_M : M_inv * M_piv = 1 := by
      dsimp only [M_inv]
      rw [Matrix.smul_mul, Matrix.adjugate_mul, smul_smul, Ring.inverse_mul_cancel _ hPiv, one_smul]
    have hAnn : ∀ r : Fin n_r, ∑ μ : Fin n_c, MvPolynomial.C (J r μ) * Φ (MvPolynomial.X μ) = 0 := by
      intro r
      rw [← Equiv.sum_comp e_col, Fintype.sum_sum_type]
      have hInl : ∀ s : Fin n_r, Φ (MvPolynomial.X (e_col (Sum.inl s))) =
          - ∑ a : Fin n_free, MvPolynomial.C ((M_inv * J_free) s a) * MvPolynomial.X a := by
        intro s
        dsimp only [Φ, M_inv]
        rw [MvPolynomial.aeval_X, e_col.symm_apply_apply, Sum.elim_inl]
      have hInr : ∀ a : Fin n_free, Φ (MvPolynomial.X (e_col (Sum.inr a))) = MvPolynomial.X a := by
        intro a
        dsimp only [Φ]
        rw [MvPolynomial.aeval_X, e_col.symm_apply_apply, Sum.elim_inr]
      simp_rw [hInl, hInr, mul_neg, Finset.sum_neg_distrib, Finset.mul_sum]
      rw [Finset.sum_comm]
      have h_eq_sum : (∑ x : Fin n_free, ∑ y : Fin n_r,
          MvPolynomial.C (J r (e_col (Sum.inl y))) *
            (MvPolynomial.C ((M_inv * J_free) y x) * MvPolynomial.X x)) =
          ∑ x : Fin n_free, MvPolynomial.C (J r (e_col (Sum.inr x))) * MvPolynomial.X x := by
        refine Finset.sum_congr rfl fun a _ => ?_
        have hM_a : (∑ s : Fin n_r, M_piv r s * (M_inv * J_free) s a) = J_free r a := by
          change (M_piv * (M_inv * J_free)) r a = J_free r a
          rw [← Matrix.mul_assoc, hM_mul_inv, Matrix.one_mul]
        calc (∑ y : Fin n_r, MvPolynomial.C (J r (e_col (Sum.inl y))) *
                (MvPolynomial.C ((M_inv * J_free) y a) * MvPolynomial.X a))
            = (∑ y : Fin n_r, MvPolynomial.C (M_piv r y * (M_inv * J_free) y a)) *
                MvPolynomial.X a := by
                rw [Finset.sum_mul]; refine Finset.sum_congr rfl fun y _ => by
                  rw [← mul_assoc, ← map_mul]; rfl
          _ = MvPolynomial.C (J r (e_col (Sum.inr a))) * MvPolynomial.X a := by
                rw [← map_sum, hM_a]; rfl
      rw [h_eq_sum, neg_add_cancel]
    refine ⟨?_, hAnn, ?_⟩
    · intro μ
      dsimp only [Φ]
      rw [MvPolynomial.aeval_X]
      cases e_col.symm μ with
      | inl s =>
        simp only [Sum.elim_inl]
        refine Submodule.neg_mem _ (Submodule.sum_mem _ fun a _ => ?_)
        rw [← MvPolynomial.smul_eq_C_mul]
        exact Submodule.smul_mem _ _ (MvPolynomial.isHomogeneous_X B a)
      | inr a =>
        simp only [Sum.elim_inr]
        exact MvPolynomial.isHomogeneous_X B a
    · intro S _ ρ w hw μ
      have hDiff_zero : ∀ s : Fin n_r,
          MvPolynomial.eval₂ ρ (fun a => w (e_col (Sum.inr a)))
            (Φ (MvPolynomial.X (e_col (Sum.inl s)))) = w (e_col (Sum.inl s)) := by
        let d_vec : Fin n_r → S := fun s =>
          MvPolynomial.eval₂ ρ (fun a => w (e_col (Sum.inr a)))
            (Φ (MvPolynomial.X (e_col (Sum.inl s)))) - w (e_col (Sum.inl s))
        have hd_eq : ∀ r : Fin n_r, ∑ s : Fin n_r, ρ (M_piv r s) * d_vec s = 0 := by
          intro r
          have h1 : ∑ μ : Fin n_c,
              ρ (J r μ) * MvPolynomial.eval₂ ρ (fun a => w (e_col (Sum.inr a)))
                (Φ (MvPolynomial.X μ)) = 0 := by
            have hev := congrArg (MvPolynomial.eval₂ ρ (fun a => w (e_col (Sum.inr a)))) (hAnn r)
            simpa only [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C,
              MvPolynomial.eval₂_zero] using hev
          have hsub := sub_eq_zero.mpr (h1.trans (hw r).symm)
          rw [← Finset.sum_sub_distrib, ← Equiv.sum_comp e_col, Fintype.sum_sum_type] at hsub
          have hInr0 : ∑ a : Fin n_free,
              (ρ (J r (e_col (Sum.inr a))) *
                MvPolynomial.eval₂ ρ (fun a' => w (e_col (Sum.inr a')))
                  (Φ (MvPolynomial.X (e_col (Sum.inr a)))) -
                ρ (J r (e_col (Sum.inr a))) * w (e_col (Sum.inr a))) = 0 := by
            refine Finset.sum_eq_zero fun a _ => ?_
            dsimp only [Φ]
            rw [MvPolynomial.aeval_X, e_col.symm_apply_apply, Sum.elim_inr, MvPolynomial.eval₂_X, sub_self]
          rw [hInr0, add_zero] at hsub
          simpa only [d_vec, mul_sub, M_piv, Matrix.of_apply] using hsub
        intro s₀
        have h0 : d_vec s₀ = 0 := by
          have hmul0 : ∑ r : Fin n_r, ρ (M_inv s₀ r) * (∑ s : Fin n_r, ρ (M_piv r s) * d_vec s) = 0 :=
            Finset.sum_eq_zero fun r _ => by rw [hd_eq r, mul_zero]
          have h_assoc : (∑ r : Fin n_r, ρ (M_inv s₀ r) * (∑ s : Fin n_r, ρ (M_piv r s) * d_vec s)) =
              ∑ s : Fin n_r, ρ ((M_inv * M_piv) s₀ s) * d_vec s := by
            simp_rw [Finset.mul_sum, ← mul_assoc, ← map_mul]
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun s _ => ?_
            rw [← Finset.sum_mul, ← map_sum, Matrix.mul_apply]
          rw [h_assoc, hInv_mul_M] at hmul0
          simpa [Matrix.one_apply] using hmul0
        exact sub_eq_zero.mp h0
      obtain ⟨u_sum, rfl⟩ : ∃ u_sum, e_col u_sum = μ := ⟨e_col.symm μ, e_col.apply_symm_apply μ⟩
      cases u_sum with
      | inl s => exact hDiff_zero s
      | inr a =>
        dsimp only [Φ]
        rw [MvPolynomial.aeval_X, e_col.symm_apply_apply, Sum.elim_inr, MvPolynomial.eval₂_X]

  have hXFullEqAway : ∀ {A : Type u} [CommRing A]
      (α_w : Fin (M + 1)) (x_w : Fin M → A) (κ_w : k →+* A)
      (ψ_away : HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α_w) →+* A),
      (∀ (c : Fin (M + 1) → k) (hFc : L_lin c ∈ 𝒜_M 1)
        (hXα : (MvPolynomial.X α_w : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1) (hpos : 0 < 1),
        ψ_away (HomogeneousLocalization.mk
          ⟨1, ⟨L_lin c, hFc⟩, ⟨MvPolynomial.X α_w, hXα⟩, ⟨1, pow_one _⟩⟩) =
          κ_w (c α_w) + ∑ m' : Fin M, κ_w (c (α_w.succAbove m')) * x_w m') →
      ∀ (μ : Fin (M + 1)) (hXμ : (MvPolynomial.X μ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
        (hXα : (MvPolynomial.X α_w : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1),
        (α_w.insertNth (α := fun _ => A) 1 x_w) μ =
          ψ_away (HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X μ, hXμ⟩, ⟨MvPolynomial.X α_w, hXα⟩, ⟨1, pow_one _⟩⟩) := by
    intro A _ α_w x_w κ_w ψ_away hLin μ hXμ hXα
    let c : Fin (M + 1) → k := Pi.single μ 1
    have hsum_eq : L_lin c = MvPolynomial.X μ := by
      dsimp only [L_lin]
      rw [Finset.sum_eq_single μ]
      · simp [c]
      · intro a _ ha; simp [c, Pi.single_eq_of_ne ha]
      · intro habs; exact absurd (Finset.mem_univ μ) habs
    have hFc : L_lin c ∈ 𝒜_M 1 := by rwa [hsum_eq]
    have hmk_eq : HomogeneousLocalization.mk
        (𝒜 := 𝒜_M) (x := Submonoid.powers (MvPolynomial.X α_w))
        ⟨1, ⟨L_lin c, hFc⟩, ⟨MvPolynomial.X α_w, hXα⟩, ⟨1, pow_one _⟩⟩ =
        HomogeneousLocalization.mk
          (𝒜 := 𝒜_M) (x := Submonoid.powers (MvPolynomial.X α_w))
          ⟨1, ⟨MvPolynomial.X μ, hXμ⟩, ⟨MvPolynomial.X α_w, hXα⟩, ⟨1, pow_one _⟩⟩ := by
      congr 2
      exact Subtype.ext hsum_eq
    rw [← hmk_eq, hLin c hFc hXα zero_lt_one]
    dsimp only [c]
    refine α_w.succAboveCases ?_ (fun m₀ => ?_) μ
    · simp [Fin.succAbove_ne]
    · simp only [Fin.insertNth_apply_succAbove]
      have hc0 : Pi.single (M := fun _ : Fin (M + 1) => k) (α_w.succAbove m₀) 1 α_w = 0 :=
        Pi.single_eq_of_ne (Fin.succAbove_ne α_w m₀).symm 1
      rw [hc0, map_zero, zero_add, Finset.sum_eq_single m₀]
      · simp only [Pi.single_eq_same, map_one, one_mul]
      · intro m' _ hne
        have hcm' : Pi.single (M := fun _ : Fin (M + 1) => k)
            (α_w.succAbove m₀) 1 (α_w.succAbove m') = 0 :=
          Pi.single_eq_of_ne (fun h => hne (Fin.succAbove_right_injective h)) 1
        rw [hcm', map_zero, zero_mul]
      · intro habs; exact absurd (Finset.mem_univ m₀) habs

  
  have hSm_top : AlgebraicGeometry.SmoothOfRelativeDimension d
      ((⊤ : Z_bar.left.Opens).ι ≫ Z_bar.hom) := by
    simpa only [Nat.zero_add] using
      (inferInstance : AlgebraicGeometry.SmoothOfRelativeDimension (0 + d)
        ((⊤ : Z_bar.left.Opens).ι ≫ Z_bar.hom))
  have hSlice0_top : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ d 0 Fin.elim0 :=
    weil_bertini_transversalLinearSlice_init_zero k M Z_bar ι_bar hCl_ι ⊤ d hSm_top
  obtain ⟨m_charts, α₀, V, hAffV, _, hVα, s, φ, q, f_lift₀, x_coord, P_h, hCov_top, hCharts_top⟩ :=
    (weil_bertini_scheme_chart_cover_and_advance k M Z_bar ι_bar hCl_ι ⊤ d 0 Fin.elim0 hSlice0_top).1

  have hSchur_all : ∀ i : Fin m_charts,
      ∃ (Ψ_i : Fin M → MvPolynomial (Fin (s i + 0 + d)) k)
        (v_i : Matrix (Fin M) (Fin d) ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))),
        (∀ m' : Fin M, (φ i) (Ψ_i m') = x_coord i m') ∧
        ∀ (c : Fin (M + 1) → k) (γ₀ : Fin d),
          Matrix.det (Matrix.of fun a b : Fin (s i + 0 + 1) =>
            (φ i) (MvPolynomial.pderiv
              (Fin.snoc (α := fun _ => Fin (s i + 0 + d))
                (Fin.castAdd d) (Fin.natAdd (s i + 0) γ₀) b)
              (Fin.snoc (α := fun _ => MvPolynomial (Fin (s i + 0 + d)) k)
                (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s i + 0 + d)) k)
                  (q i) Fin.elim0)
                (MvPolynomial.C (c (α₀ i)) +
                  ∑ m' : Fin M, MvPolynomial.C (c ((α₀ i).succAbove m')) * Ψ_i m') a))) =
            Matrix.det (Matrix.of fun a b : Fin (s i + 0) =>
              (φ i) (MvPolynomial.pderiv (Fin.castAdd d b) (Fin.addCases (q i) Fin.elim0 a))) *
              ∑ m' : Fin M, (φ i) (MvPolynomial.C (c ((α₀ i).succAbove m'))) * v_i m' γ₀ := by
    intro i
    obtain ⟨hSurj, _, hKer, _, _, hDet0', hUnitPh, hLocPh, _, _⟩ := hCharts_top i
    have hf0 : f_lift₀ i = Fin.elim0 := Subsingleton.elim _ _
    rw [hf0] at hDet0'
    obtain ⟨Ψ_i, v_i, _, hΨ_i, _, hSch_i⟩ :=
      weil_bertini_tangent_frame_and_schur_det k M (s i) 0 d _ (φ i) hSurj (q i) hKer Fin.elim0
        hDet0' (α₀ i) (x_coord i) (P_h i) hUnitPh hLocPh
    exact ⟨Ψ_i, v_i, hΨ_i, hSch_i⟩
  choose Ψ v hΨ hSchur using hSchur_all

  
  have hCritSpecialize : ∀ (α_w : Fin (M + 1)) (W_open : Z_bar.left.Opens)
      (hAffW : AlgebraicGeometry.IsAffineOpen W_open)
      (hWα : W_open ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α_w)))
      (s_w : ℕ)
      (φ_w : MvPolynomial (Fin (s_w + 0 + d)) k →+* ↑(Z_bar.left.presheaf.obj (Opposite.op W_open)))
      (q_w : Fin s_w → MvPolynomial (Fin (s_w + 0 + d)) k)
      (x_w : Fin M → ↑(Z_bar.left.presheaf.obj (Opposite.op W_open)))
      (Ψ_w : Fin M → MvPolynomial (Fin (s_w + 0 + d)) k)
      (v_w : Matrix (Fin M) (Fin d) ↑(Z_bar.left.presheaf.obj (Opposite.op W_open)))
      (hSurj_w : Function.Surjective φ_w)
      (hSpec_w : W_open.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_w) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = W_open.ι ≫ Z_bar.hom)
      (hKer_w : RingHom.ker φ_w = Ideal.span (Set.range q_w))
      (hDet0_w : IsUnit (Matrix.det (Matrix.of fun a b : Fin s_w =>
        φ_w (MvPolynomial.pderiv (Fin.castAdd d (Fin.castAdd 0 b)) (q_w a)))))
      (hDet00_w : IsUnit (Matrix.det (Matrix.of fun a b : Fin (s_w + 0) =>
        φ_w (MvPolynomial.pderiv (Fin.castAdd d b) (Fin.addCases q_w Fin.elim0 a)))))
      (hLin_w : ∀ (c : Fin (M + 1) → k) (hFc : L_lin c ∈ 𝒜_M 1)
        (hXα : (MvPolynomial.X α_w : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1) (hpos : 0 < 1),
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α_w) hXα hpos).hom ≫
          ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α_w))
            W_open hWα).hom
          (HomogeneousLocalization.mk ⟨1, ⟨L_lin c, hFc⟩, ⟨MvPolynomial.X α_w, hXα⟩, ⟨1, pow_one _⟩⟩) =
          φ_w (MvPolynomial.C (c α_w)) +
            ∑ m' : Fin M, φ_w (MvPolynomial.C (c (α_w.succAbove m'))) * x_w m')
      (hΨ_w : ∀ m' : Fin M, φ_w (Ψ_w m') = x_w m')
      (hSch_w : ∀ (c : Fin (M + 1) → k) (γ₀ : Fin d),
        Matrix.det (Matrix.of fun a b : Fin (s_w + 0 + 1) =>
          φ_w (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin (s_w + 0 + d))
              (Fin.castAdd d) (Fin.natAdd (s_w + 0) γ₀) b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin (s_w + 0 + d)) k)
              (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s_w + 0 + d)) k) q_w Fin.elim0)
              (MvPolynomial.C (c α_w) +
                ∑ m' : Fin M, MvPolynomial.C (c (α_w.succAbove m')) * Ψ_w m') a))) =
          Matrix.det (Matrix.of fun a b : Fin (s_w + 0) =>
            φ_w (MvPolynomial.pderiv (Fin.castAdd d b) (Fin.addCases q_w Fin.elim0 a))) *
            ∑ m' : Fin M, φ_w (MvPolynomial.C (c (α_w.succAbove m'))) * v_w m' γ₀)
      (x : Z_bar.left) (hxW : x ∈ W_open) (c : Fin (M + 1) → k),
      ι_bar.left.base x ∈ weilProjHyperplaneSet k M (L_lin c) →
      (∀ γ₀ : Fin d,
        Matrix.det (Matrix.of fun a b : Fin (s_w + 0 + 1) =>
          φ_w (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin (s_w + 0 + d))
              (Fin.castAdd d) (Fin.natAdd (s_w + 0) γ₀) b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin (s_w + 0 + d)) k)
              (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s_w + 0 + d)) k) q_w Fin.elim0)
              (MvPolynomial.C (c α_w) +
                ∑ m' : Fin M, MvPolynomial.C (c (α_w.succAbove m')) * Ψ_w m') a))) ∈
          (hAffW.primeIdealOf ⟨x, hxW⟩).asIdeal) →
      let A_w := ↑(Z_bar.left.presheaf.obj (Opposite.op W_open))
      letI : Algebra k A_w := (φ_w.comp MvPolynomial.C).toAlgebra
      let X_w : Fin (M + 1) → A_w := α_w.insertNth 1 x_w
      ∃ (z : Z_bar.left) (hzW : z ∈ W_open) (_ : IsClosed ({z} : Set Z_bar.left))
        (ev_z : A_w →ₐ[k] k) (D_w : Fin d → Derivation k A_w A_w),
        RingHom.ker ev_z.toRingHom = (hAffW.primeIdealOf ⟨z, hzW⟩).asIdeal ∧
        (∀ r : Fin (d + 1),
          ∑ μ : Fin (M + 1),
            ev_z (Matrix.of (Fin.cases X_w (fun i μ => D_w i (X_w μ))) r μ) * c μ = 0) ∧
        (∀ (α' : Fin (M + 1)) (hXα' : (MvPolynomial.X α' : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
          (W' : Z_bar.left.Opens) (hAffW' : AlgebraicGeometry.IsAffineOpen W') (hzW' : z ∈ W')
          (hWα' : W' ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α'))),
          algebraMap _ (Localization.AtPrime (hAffW'.primeIdealOf ⟨z, hzW'⟩).asIdeal)
            (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α') hXα' zero_lt_one).hom ≫
              ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α'))
                W' hWα').hom
              (HomogeneousLocalization.mk ⟨1, ⟨L_lin c, hL_lin_homog c⟩,
                ⟨MvPolynomial.X α', hXα'⟩, ⟨1, pow_one _⟩⟩)) ∈
            (IsLocalRing.maximalIdeal
              (Localization.AtPrime (hAffW'.primeIdealOf ⟨z, hzW'⟩).asIdeal)) ^ 2) := by
    intro α_w W_open hAffW hWα s_w φ_w q_w x_w Ψ_w v_w hSurj_w hSpec_w hKer_w hDet0_w hDet00_w
      hLin_w hΨ_w hSch_w x hxW c hxHyp hAllDet
    letI : Nonempty W_open := ⟨⟨x, hxW⟩⟩
    let A_w := ↑(Z_bar.left.presheaf.obj (Opposite.op W_open))
    letI : Algebra k A_w := (φ_w.comp MvPolynomial.C).toAlgebra
    let X_w : Fin (M + 1) → A_w := α_w.insertNth 1 x_w
    obtain ⟨ψ_w, D_w, _, _, _, _, _, _, hv_eq_D, _, hHyp_w, hMax_w, hJet_w, _⟩ :=
      weil_algClosed_smooth_chart_jet1_and_etale_odp_bridge k m M s_w Z_bar hInt ι_bar
        α_w W_open hAffW hWα φ_w q_w x_w Ψ_w v_w hSurj_w hSpec_w hKer_w hDet0_w hLin_w hΨ_w hSch_w
    let 𝔭_x := (hAffW.primeIdealOf ⟨x, hxW⟩).asIdeal
    obtain ⟨𝔪_z, h𝔪_z, hle_𝔪⟩ :=
      Ideal.exists_le_maximal 𝔭_x (hAffW.primeIdealOf ⟨x, hxW⟩).isPrime.ne_top
    obtain ⟨ev_z, hKer_evz, hzW, hCl_z, hpz_eq⟩ := hMax_w.1 𝔪_z h𝔪_z
    let z := hAffW.fromSpec.base ⟨𝔪_z, h𝔪_z.isPrime⟩
    have hKer_pz : RingHom.ker ev_z.toRingHom = (hAffW.primeIdealOf ⟨z, hzW⟩).asIdeal :=
      hKer_evz.trans (hpz_eq hzW).symm
    have hCrit : ∀ r : Fin (d + 1),
        ∑ μ : Fin (M + 1),
          ev_z (Matrix.of (Fin.cases X_w (fun i μ => D_w i (X_w μ))) r μ) * c μ = 0 := by
      refine Fin.cases ?_ (fun γ₀ => ?_)
      · have h_in_px : (∑ μ : Fin (M + 1), algebraMap k A_w (c μ) * X_w μ) ∈ 𝔭_x :=
          (hHyp_w ⟨x, hxW⟩ c).mp hxHyp
        have h_in_ker : (∑ μ : Fin (M + 1), algebraMap k A_w (c μ) * X_w μ) ∈ RingHom.ker ev_z.toRingHom := by
          rw [hKer_evz]; exact hle_𝔪 h_in_px
        have hev0 : ev_z (∑ μ : Fin (M + 1), algebraMap k A_w (c μ) * X_w μ) = 0 := h_in_ker
        rw [map_sum] at hev0
        refine Eq.trans ?_ hev0
        refine Finset.sum_congr rfl fun μ _ => ?_
        simp only [Matrix.of_apply, Fin.cases_zero, map_mul]
        have hcomm : ev_z (algebraMap k A_w (c μ)) = c μ := ev_z.commutes (c μ)
        rw [hcomm, mul_comm]
      · have hdet_ker : Matrix.det (Matrix.of fun a b : Fin (s_w + 0 + 1) =>
            φ_w (MvPolynomial.pderiv
              (Fin.snoc (α := fun _ => Fin (s_w + 0 + d))
                (Fin.castAdd d) (Fin.natAdd (s_w + 0) γ₀) b)
              (Fin.snoc (α := fun _ => MvPolynomial (Fin (s_w + 0 + d)) k)
                (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s_w + 0 + d)) k) q_w Fin.elim0)
                (MvPolynomial.C (c α_w) +
                  ∑ m' : Fin M, MvPolynomial.C (c (α_w.succAbove m')) * Ψ_w m') a))) ∈
            RingHom.ker ev_z.toRingHom := by
          rw [hKer_evz]; exact hle_𝔪 (hAllDet γ₀)
        have hev_det : ev_z _ = 0 := hdet_ker
        rw [hSch_w c γ₀, map_mul] at hev_det
        have hdet0_unit : IsUnit (ev_z.toRingHom (Matrix.det (Matrix.of fun a b : Fin (s_w + 0) =>
            φ_w (MvPolynomial.pderiv (Fin.castAdd d b) (Fin.addCases q_w Fin.elim0 a))))) :=
          hDet00_w.map ev_z.toRingHom
        have hsum_v : ev_z (∑ m' : Fin M, φ_w (MvPolynomial.C (c (α_w.succAbove m'))) * v_w m' γ₀) = 0 :=
          (mul_eq_zero.mp hev_det).resolve_left hdet0_unit.ne_zero
        rw [map_sum] at hsum_v
        rw [Fin.sum_univ_succAbove _ α_w]
        simp only [Matrix.of_apply, Fin.cases_succ]
        have hXw_0 : X_w α_w = 1 := by simp [X_w]
        have hXw_succ : ∀ m' : Fin M, X_w (α_w.succAbove m') = x_w m' := fun m' => by simp [X_w]
        rw [hXw_0, Derivation.map_one_eq_zero, map_zero, zero_mul, zero_add]
        have h_eq : (∑ m' : Fin M, ev_z (D_w γ₀ (X_w (α_w.succAbove m'))) * c (α_w.succAbove m')) =
            ∑ m' : Fin M, ev_z (φ_w (MvPolynomial.C (c (α_w.succAbove m'))) * v_w m' γ₀) := by
          refine Finset.sum_congr rfl fun m' _ => ?_
          rw [hXw_succ m', ← hv_eq_D m' γ₀, map_mul]
          have hφC : ev_z (φ_w (MvPolynomial.C (c (α_w.succAbove m')))) = c (α_w.succAbove m') :=
            ev_z.commutes (c (α_w.succAbove m'))
          rw [hφC, mul_comm]
        rw [h_eq, hsum_v]
    have hIntr := ((hJet_w z hzW hCl_z ev_z hKer_pz).2 c (hL_lin_homog c)).mp hCrit
    exact ⟨z, hzW, hCl_z, ev_z, D_w, hKer_pz, hCrit, hIntr⟩

  
  have hGlobalBridge : ∀ (i : Fin m_charts) [Nonempty (V i)],
      let A_i := ↑(Z_bar.left.presheaf.obj (Opposite.op (V i)))
      letI : Algebra k A_i := ((φ i).comp MvPolynomial.C).toAlgebra
      let X_i : Fin (M + 1) → A_i := (α₀ i).insertNth 1 (x_coord i)
      ∃ (ψ_V : MvPolynomial (Fin d) k →+* A_i)
        (D_V : Fin d → Derivation k A_i A_i),
        let J_V : Matrix (Fin (d + 1)) (Fin (M + 1)) A_i :=
          Matrix.of (Fin.cases X_i (fun r μ => D_V r (X_i μ)))
        IsDomain A_i ∧
        Algebra.FiniteType k A_i ∧
        Algebra.trdeg k A_i ≤ (d : Cardinal.{u}) ∧
        (∀ (E : Type u) [Field E] (σ : A_i →+* E),
          letI : Algebra k E := (σ.comp (algebraMap k A_i)).toAlgebra
          ∀ (D : Derivation k E E) (a : A_i),
            D (σ a) = ∑ r : Fin d, σ (D_V r a) * D (σ (ψ_V (MvPolynomial.X r)))) ∧
        (∀ (x : ↥(V i)) (c : Fin (M + 1) → k),
          ι_bar.left.base x.1 ∈ weilProjHyperplaneSet k M (L_lin c) ↔
            (∑ μ : Fin (M + 1), algebraMap k A_i (c μ) * X_i μ) ∈
              ((hAffV i).primeIdealOf x).asIdeal) ∧
        ((∀ (𝔪 : Ideal A_i) (h𝔪 : 𝔪.IsMaximal),
            ∃ ev_𝔪 : A_i →ₐ[k] k,
              RingHom.ker ev_𝔪.toRingHom = 𝔪 ∧
              (hAffV i).fromSpec.base ⟨𝔪, h𝔪.isPrime⟩ ∈ V i ∧
              IsClosed ({(hAffV i).fromSpec.base ⟨𝔪, h𝔪.isPrime⟩} : Set Z_bar.left) ∧
              ∀ hz : (hAffV i).fromSpec.base ⟨𝔪, h𝔪.isPrime⟩ ∈ V i,
                ((hAffV i).primeIdealOf ⟨(hAffV i).fromSpec.base ⟨𝔪, h𝔪.isPrime⟩, hz⟩).asIdeal = 𝔪) ∧
          (∀ (z : Z_bar.left) (hz : z ∈ V i), IsClosed ({z} : Set Z_bar.left) →
            (((hAffV i).primeIdealOf ⟨z, hz⟩).asIdeal).IsMaximal ∧
            (hAffV i).fromSpec.base ((hAffV i).primeIdealOf ⟨z, hz⟩) = z)) ∧
        (∀ (z : Z_bar.left) (hz : z ∈ V i), IsClosed ({z} : Set Z_bar.left) →
          ∀ (ev_z : A_i →ₐ[k] k),
            RingHom.ker ev_z.toRingHom = ((hAffV i).primeIdealOf ⟨z, hz⟩).asIdeal →
            (∃ ψ_z : MvPolynomial (Fin d) k →+* A_i,
              AlgebraicGeometry.Etale ((V i).toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z)) ∧
              ((V i).toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = (V i).ι ≫ Z_bar.hom) ∧
              (∀ r : Fin d, ψ_z (MvPolynomial.X r) ∈ ((hAffV i).primeIdealOf ⟨z, hz⟩).asIdeal) ∧
              (∀ (c : Fin (M + 1) → k) (hLc : L_lin c ∈ 𝒜_M 1)
                (hXα : (MvPolynomial.X (α₀ i) : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
                (c₀ : k) (w : Fin d → k),
                let p_z := ((hAffV i).primeIdealOf ⟨z, hz⟩).asIdeal
                let ℓ_z := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M
                  (MvPolynomial.X (α₀ i)) hXα zero_lt_one).hom ≫
                  ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X (α₀ i)))
                    (V i) (hVα i)).hom
                  (HomogeneousLocalization.mk ⟨1, ⟨L_lin c, hLc⟩,
                    ⟨MvPolynomial.X (α₀ i), hXα⟩, ⟨1, pow_one _⟩⟩)
                algebraMap A_i (Localization.AtPrime p_z)
                  (ℓ_z - ψ_z (MvPolynomial.C c₀ +
                    ∑ r : Fin d, MvPolynomial.C (w r) * MvPolynomial.X r)) ∈
                  (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 2 ↔
                  (∑ μ : Fin (M + 1), ev_z (J_V 0 μ) * c μ = c₀ ∧
                    ∀ r : Fin d, ∑ μ : Fin (M + 1), ev_z (J_V r.succ μ) * c μ = w r))) ∧
            (∀ (c : Fin (M + 1) → k) (hLc : L_lin c ∈ 𝒜_M 1),
              (∀ r : Fin (d + 1), ∑ μ : Fin (M + 1), ev_z (J_V r μ) * c μ = 0) ↔
              ∀ (α' : Fin (M + 1))
                (hXα' : (MvPolynomial.X α' : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
                (W : Z_bar.left.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W) (hzW : z ∈ W)
                (hWα' : W ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
                  (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α'))),
                algebraMap _ (Localization.AtPrime (hAffW.primeIdealOf ⟨z, hzW⟩).asIdeal)
                  (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M
                    (MvPolynomial.X α') hXα' zero_lt_one).hom ≫
                    ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α'))
                      W hWα').hom
                    (HomogeneousLocalization.mk ⟨1, ⟨L_lin c, hLc⟩,
                      ⟨MvPolynomial.X α', hXα'⟩, ⟨1, pow_one _⟩⟩)) ∈
                  (IsLocalRing.maximalIdeal
                    (Localization.AtPrime (hAffW.primeIdealOf ⟨z, hzW⟩).asIdeal)) ^ 2)) ∧
        (∀ (z : Z_bar.left) (hz : z ∈ V i), IsClosed ({z} : Set Z_bar.left) →
          ∀ (ev_z : A_i →ₐ[k] k),
            RingHom.ker ev_z.toRingHom = ((hAffV i).primeIdealOf ⟨z, hz⟩).asIdeal →
            ∀ (c : Fin (M + 1) → k),
