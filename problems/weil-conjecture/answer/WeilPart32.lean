    have hD_tilde_add : ∀ i F G, D_tilde i (F + G) = D_tilde i F + D_tilde i G := by
      intro i F G
      simp only [D_tilde, map_add, add_mul, Finset.sum_add_distrib]
    have hD_tilde_sub : ∀ i F G, D_tilde i (F - G) = D_tilde i F - D_tilde i G := by
      intro i F G
      simp only [D_tilde, map_sub, sub_mul, Finset.sum_sub_distrib]
