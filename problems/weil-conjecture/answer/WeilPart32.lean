            (AlgebraicGeometry.Proj.basicOpen 𝒜_N H_a))
          (hWb : W ≤ (TopologicalSpace.Opens.map f_X.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_N H_b)),
        Ideal.span {(f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H_a) W hWa).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H_a).hom
