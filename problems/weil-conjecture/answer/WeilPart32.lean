    change φ_M ((P_M.left.presheaf.map (CategoryTheory.homOfLE _).op).hom (s_M α r)) *
        φ_2 ((P_2.left.presheaf.map (CategoryTheory.homOfLE _).op).hom (w_tilde β r)) =
