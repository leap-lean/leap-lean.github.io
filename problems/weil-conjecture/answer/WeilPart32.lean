    rw [hSumSimp, Fin.sum_univ_succAbove _ β, Fin.sum_univ_two]
    have hw_β : w_tilde β β = 1 := hw_self
    have hw_i : ∀ i : Fin 2, w_tilde β (β.succAbove i) = e_P (MvPolynomial.X i) :=
      fun i => (heP_X i).symm
    rw [hw_β, hw_i 0, hw_i 1, map_one, mul_one,
      hp₁_Q (ℓ_r β), hp₁_Q (ℓ_r (β.succAbove 0)), hp₁_Q (ℓ_r (β.succAbove 1)),
      hp₂_Q (MvPolynomial.X 0), hp₂_Q (MvPolynomial.X 1),
      MvPolynomial.map_X, MvPolynomial.map_X]
    dsimp [G_inc]
    simp only [map_add, map_mul, add_assoc]
  have hJW_eq : J_W = Ideal.map e_Q.toRingHom I_inc := by
    dsimp [J_W, I_inc]
    rw [Ideal.map_span, Set.image_singleton, hPhi_W]
    rfl
  let e_Y : (MvPolynomial (Fin 2) A ⧸ I_inc) ≃+* ↑(Y₂.left.presheaf.obj (Opposite.op V_Y)) :=
    (Ideal.quotientEquiv I_inc J_W e_Q hJW_eq).trans e_V
  have heY_mk : ∀ P : MvPolynomial (Fin 2) A,
      e_Y (Ideal.Quotient.mk I_inc P) = (ι_Y₂.appLE W V_Y hVY_eq.le).hom (e_Q P) := by
    intro P
    exact (hι_appLE (e_Q P)).symm

  have hDehomZ := hDehom_PM Z_bar ι_bar α hXα U_Z hAffZ hUZ

  have hπ_app : ∀ a : A,
      (π_Y.left.appLE U_Z V_Y inf_le_left).hom a =
        e_Y (Ideal.Quotient.mk I_inc (MvPolynomial.C a)) := by
    intro a
    have happ : p₁.appLE U_Z W inf_le_left ≫ ι_Y₂.appLE W V_Y hVY_eq.le =
        π_Y.left.appLE U_Z V_Y inf_le_left :=
      AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_Y₂ p₁ U_Z W V_Y inf_le_left hVY_eq.le
    have h1 := congrArg (fun f : Z_bar.left.presheaf.obj (Opposite.op U_Z) ⟶
      Y₂.left.presheaf.obj (Opposite.op V_Y) => f.hom a) happ.symm
    change (π_Y.left.appLE U_Z V_Y inf_le_left).hom a =
      (ι_Y₂.appLE W V_Y hVY_eq.le).hom ((p₁.appLE U_Z W inf_le_left).hom a) at h1
    rw [h1, hp₁_Q a, heY_mk]

  have hg_app : ∀ P : MvPolynomial (Fin 2) k,
      (g₂.left.appLE D_β V_Y inf_le_right).hom (e_P P) =
        e_Y (Ideal.Quotient.mk I_inc (MvPolynomial.map κ_Z P)) := by
    intro P
    have happ : p₂.appLE D_β W inf_le_right ≫ ι_Y₂.appLE W V_Y hVY_eq.le =
        g₂.left.appLE D_β V_Y inf_le_right :=
      AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_Y₂ p₂ D_β W V_Y inf_le_right hVY_eq.le
    have h1 := congrArg (fun f : P_2.left.presheaf.obj (Opposite.op D_β) ⟶
      Y₂.left.presheaf.obj (Opposite.op V_Y) => f.hom (e_P P)) happ.symm
    change (g₂.left.appLE D_β V_Y inf_le_right).hom (e_P P) =
      (ι_Y₂.appLE W V_Y hVY_eq.le).hom ((p₂.appLE D_β W inf_le_right).hom (e_P P)) at h1
    rw [h1, hp₂_Q P, heY_mk]

  refine ⟨hAffVY, e_Y, ?_, ?_, hπ_app, hg_app, ?_, ?_⟩
  · intro z r
    exact (hDehomZ.1 (L r) (hL_homog r)).2 z
  · intro z c
    have hFc_hom : (∑ r : Fin 3, MvPolynomial.C (c r) * L r) ∈ 𝒜_M 1 :=
      Submodule.sum_mem _ fun r _ => (hL_homog r).C_mul (c r)
    rw [(hDehomZ.1 _ hFc_hom).2 z, hDehomZ.2 3 c L hL_homog hFc_hom]
  · intro c
    have happ : Z_bar.hom.appLE ⊤ U_Z le_top ≫ π_Y.left.appLE U_Z V_Y inf_le_left =
