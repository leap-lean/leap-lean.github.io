        h_isoW_fst.trans
          (AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE fst_Z U_Z W_pb inf_le_left).symm
      have h_top1 := congrArg AlgebraicGeometry.Scheme.Hom.appTop h_eq1
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality] at h_top1
      have h_nat_C := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
        (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A))
      have h_lhs_C : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).hom ≫
          CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A) ≫ e_cat.hom =
