  let τ₁₂ : ↑(Γ₀.left.presheaf.obj (Opposite.op W₂)) :=
    (ι_ΓP.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N H₂) W₂ le_rfl).hom
      ((AlgebraicGeometry.Proj.awayToSection 𝒜_N H₂).hom
        (HomogeneousLocalization.Away.mk 𝒜_N hH₂ 3 F_L hFL))
  let h_F2 : ↑(Γ₀.left.presheaf.obj (Opposite.op W_F)) :=
    (ι_ΓP.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N F_L) W_F le_rfl).hom
      ((AlgebraicGeometry.Proj.awayToSection 𝒜_N F_L).hom
        (HomogeneousLocalization.Away.mk 𝒜_N hFL 1 (H₂ ^ 3) hH2_3))

  obtain ⟨⟨hPow_H1_Γ, hPow_H2_Γ⟩, hInv_T_S, ⟨hInv_h12_u12, hRel_T1⟩, ⟨hInv_hF2_τ12, hRel_SF⟩⟩ :=
    hCurve_Γ H₁ H₂ F_L hH₁ hH₂ hFL hH1_3 hH2_3
  obtain ⟨hBasic_T, hPrime_T⟩ :=
    hBasic_Γ 1 3 zero_lt_one (by decide) H₁ hH₁ F_L hFL W₁ le_rfl rfl
  obtain ⟨hBasic_h12, _⟩ :=
    hBasic_Γ 1 1 zero_lt_one zero_lt_one H₁ hH₁ H₂ hH₂ W₁ le_rfl rfl
  obtain ⟨hBasic_u12, hPrime_u12⟩ :=
    hBasic_Γ 1 1 zero_lt_one zero_lt_one H₂ hH₂ H₁ hH₁ W₂ le_rfl rfl
  obtain ⟨hBasic_τ12, _⟩ :=
