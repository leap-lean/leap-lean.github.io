  refine ⟨Y₂, π_Y, g₂, hIncFam, hProps, ⟨ι_Y₂, hCl_Y₂, rfl, rfl⟩, ⟨hCov_Z, hCov_P⟩, ?_⟩
  intro β
  refine ⟨hAff_P2 β, ?_⟩
  obtain ⟨e_P, heP_C0, heP_X, hw_self⟩ := hPart2 β
  have heP_C : ∀ c : k,
      e_P (MvPolynomial.C c) =
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          P_2.hom.appLE ⊤ (D_P β) le_top).hom c := by
    intro c
    rw [heP_C0 c, ← hConst_P2 β (MvPolynomial.isHomogeneous_X k β) c]
  refine ⟨e_P, ?_⟩
  intro α hXα U_Z hAffZ hUZ D_β V_Y A κ_Z ℓ_r I_inc
  obtain ⟨hAffW, e_Q, hp₁_Q, hp₂_Q⟩ :=
    hPart4 2 Z_bar.left P_2.left Z_bar.hom P_2.hom U_Z hAffZ D_β (hAff_P2 β) e_P heP_C
  let W : Q₂.Opens :=
    (TopologicalSpace.Opens.map p₁.base).obj U_Z ⊓
