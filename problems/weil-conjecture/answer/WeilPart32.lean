        ext i
        simp only [Finsupp.coe_zero, Pi.zero_apply]
        by_contra hi
        have hmem : i ∈ m.support := Finsupp.mem_support_iff.mpr hi
        have hle : m i ≤ ∑ j ∈ m.support, m j :=
          Finset.single_le_sum (fun _ _ => Nat.zero_le _) hmem
        omega
    let W_elim : Set (PrimeSpectrum R) := (PrimeSpectrum.comap inv₀) ⁻¹' (π₀.base '' V_proj)
    have hClosed_W : IsClosed W_elim := hClosed_img.preimage (PrimeSpectrum.continuous_comap inv₀)
    obtain ⟨S_elim, hW_eq⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus W_elim).mp hClosed_W
    have hProjIdeal : ∀ (x : ↥(AlgebraicGeometry.Proj 𝒜)) (a : ↥(𝒜 0)),
        a ∈ (π₀.base x).asIdeal ↔ a.1 ∈ (x : ProjectiveSpectrum 𝒜).asHomogeneousIdeal.toIdeal := by
      intro x a
      have hEx : ∃ m > 0, ∃ f ∈ 𝒜 m, f ∉ (x : ProjectiveSpectrum 𝒜).asHomogeneousIdeal := by
        by_contra hall
        push_neg at hall
        exact (x : ProjectiveSpectrum 𝒜).not_irrelevant_le
          ((HomogeneousIdeal.irrelevant_le 𝒜).mpr fun m hm f hf => hall m hm f hf)
      rcases hEx with ⟨m, hm, f, hf, hf_not⟩
      have hx_bo : x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 f :=
        (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 f x).mpr hf_not
      have hRange : x ∈ (AlgebraicGeometry.Proj.awayι 𝒜 f hf hm).opensRange := by
        rwa [AlgebraicGeometry.Proj.opensRange_awayι 𝒜 f hf hm]
      rcases hRange with ⟨q, hq_eq⟩
      have hπ_eq : π₀.base x =
          PrimeSpectrum.comap (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f)) q := by
        rw [← hq_eq, ← AlgebraicGeometry.Scheme.Hom.comp_apply,
          AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜 f hf hm, AlgebraicGeometry.Spec.map_apply]
        rfl
      have h1 : a ∈ (π₀.base x).asIdeal ↔
          HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) a ∈
            (q : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 f)).asIdeal := by
        rw [hπ_eq]
        rfl
      let g : A := a.1 * f
      have hg : g ∈ 𝒜 m := by
        have hmul : a.1 * f ∈ 𝒜 (0 + m) := SetLike.mul_mem_graded a.2 hf
        rwa [zero_add] at hmul
      have hPowEq : (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) a) ^ m =
