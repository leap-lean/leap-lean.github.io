                congrArg (· ≫ T_V.hom) CategoryTheory.Limits.pullback.condition.symm
              _ = fst₁₂ ≫ (u₁.left ≫ T_V.hom) := Category.assoc _ _ _
              _ = fst₁₂ ≫ W₁.hom := congrArg (fst₁₂ ≫ ·) u₁.w
