                let p₂ : Z_et ⟶ W₁ := MorphismProperty.Over.homMk pr₂ (by
                  change pr₂ ≫ W₁.hom = pr₁ ≫ U'₂.hom
                  rw [← MorphismProperty.Over.w g₁, ← MorphismProperty.Over.w v,
