        (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
        CategoryTheory.Mono (((pt W Ω w).sheafFiber (A := AddCommGrpCat.{u})).map α)) →
      CategoryTheory.Mono α := by
    intro W G₁ G₂ α hM
    rw [CategoryTheory.Preadditive.mono_iff_isZero_kernel]
