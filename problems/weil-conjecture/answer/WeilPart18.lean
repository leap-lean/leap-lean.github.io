        @AlgebraicGeometry.Scheme.Cover.Over.mk W P_et _ _ E.left _
          { toPreZeroHypercover := 𝒰₀, mem₀ := hmem₀ }
          (fun j => PEmpty.elim j) (fun j => PEmpty.elim j),
        fun j => PEmpty.elim j, ?_⟩
      rintro _ _ ⟨i⟩
      exact PEmpty.elim i
    exact (CategoryTheory.Sheaf.isTerminalOfBotCover K E hBot).isZero
  
