        CategoryTheory.Limits.pullback.fst E.hom (𝟙 S) ≫ E.hom =
          CategoryTheory.Limits.pullback.snd E.hom (𝟙 S) :=
      fun E => (CategoryTheory.Limits.pullback.condition (f := E.hom) (g := 𝟙 S)).trans
        (CategoryTheory.Category.comp_id _)
    let iso_E : ∀ E : S.Etale, B.obj E ≅ E := fun E =>
      { hom := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.fst E.hom (𝟙 S)) (h_fst E)
        inv := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift (𝟙 E.left) E.hom (by simp))
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        hom_inv_id := by
          apply (AlgebraicGeometry.Scheme.Etale.forget S).map_injective
          refine CategoryTheory.Over.OverMorphism.ext ?_
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact (CategoryTheory.Category.assoc
                (CategoryTheory.Limits.pullback.fst E.hom (𝟙 S))
                (CategoryTheory.Limits.pullback.lift (𝟙 E.left) E.hom _)
                (CategoryTheory.Limits.pullback.fst E.hom (𝟙 S))).trans
              ((congrArg (CategoryTheory.Limits.pullback.fst E.hom (𝟙 S) ≫ ·)
                  (CategoryTheory.Limits.pullback.lift_fst (𝟙 E.left) E.hom _)).trans
                ((CategoryTheory.Category.comp_id _).trans
                  (CategoryTheory.Category.id_comp _).symm))
          · exact (CategoryTheory.Category.assoc
                (CategoryTheory.Limits.pullback.fst E.hom (𝟙 S))
                (CategoryTheory.Limits.pullback.lift (𝟙 E.left) E.hom _)
                (CategoryTheory.Limits.pullback.snd E.hom (𝟙 S))).trans
              ((congrArg (CategoryTheory.Limits.pullback.fst E.hom (𝟙 S) ≫ ·)
                  (CategoryTheory.Limits.pullback.lift_snd (𝟙 E.left) E.hom _)).trans
                ((h_fst E).trans
                  (CategoryTheory.Category.id_comp _).symm))
        inv_hom_id := by
          apply (AlgebraicGeometry.Scheme.Etale.forget S).map_injective
          refine CategoryTheory.Over.OverMorphism.ext ?_
          exact CategoryTheory.Limits.pullback.lift_fst _ _ _ }
    let e_B : B ≅ 𝟭 S.Etale := CategoryTheory.NatIso.ofComponents iso_E (by
      intro E₁ E₂ u
      apply (AlgebraicGeometry.Scheme.Etale.forget S).map_injective
      refine CategoryTheory.Over.OverMorphism.ext ?_
      have hmap := CategoryTheory.MorphismProperty.Over.pullback_map_left P ⊤ (𝟙 S) u
      exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst E₂.hom (𝟙 S)) hmap).trans
        (CategoryTheory.Limits.pullback.lift_fst _ _ _))
    let e_pf := @CategoryTheory.Functor.sheafPushforwardContinuousIso _ _ _ _ B (𝟭 S.Etale)
      e_B AddCommGrpCat.{u} _ S.smallEtaleTopology S.smallEtaleTopology (hc_of (𝟙 S)) inferInstance
    exact ⟨(e_dir0 (𝟙 S) G).symm ≪≫ e_pf.app G⟩
  
  have hLiftClosedPt : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (D : TopologicalSpace.Closeds ↥Z)
      (Ω : Type u) [Field Ω]
      (z : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z),
      Set.range z.base ⊆ (D : Set ↥Z) →
      ∃ w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subscheme,
        w ≫ (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subschemeι = z ∧
        CategoryTheory.IsPullback w (𝟙 _)
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subschemeι z := by
    intro Z D Ω _ z hz
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let I_D := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D
    let i_D := I_D.subschemeι
    have _ : AlgebraicGeometry.QuasiCompact z :=
      AlgebraicGeometry.QuasiCompact.mk (fun _ _ _ => (Set.toFinite _).isCompact)
    have _ : AlgebraicGeometry.IsReduced S_Ω :=
      (AlgebraicGeometry.affine_isReduced_iff (CommRingCat.of Ω)).mpr inferInstance
    have hRad : z.ker.radical = z.ker := by
      ext U x
      rw [AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal]
      refine ⟨fun ⟨n, hn⟩ => ?_, fun hx => ⟨1, by simpa using hx⟩⟩
      rw [AlgebraicGeometry.Scheme.Hom.ker_apply] at hn ⊢
      rw [RingHom.mem_ker] at hn ⊢
      have _ : IsReduced ↑(S_Ω.presheaf.obj (Opposite.op (z ⁻¹ᵁ U.1))) :=
