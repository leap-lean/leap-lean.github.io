          have hnat₂ : η_C.app (Opposite.op Z₁₂) (a_of u₂ hu₂) =
              (C_V.obj A₂).obj.map p₂.op (η_C.app (Opposite.op W₂) (a_of u₂ hu₂)) :=
            congrArg (fun f : A₂ ⟶ (C_V.obj A₂).obj.obj (Opposite.op Z₁₂) => f (a_of u₂ hu₂))
