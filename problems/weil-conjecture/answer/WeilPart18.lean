theorem weil_etale_one_dim_curve_normalization_cohomology_iso (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Y₀ : AlgebraicGeometry.Scheme.{u})
    (p_Y₀ : Y₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
    [AlgebraicGeometry.LocallyOfFiniteType p_Y₀]
    (r : ℕ)
    (C : Fin r → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z : Fin r → AlgebraicGeometry.Scheme.{u})
    (ι_Z : ∀ c : Fin r, Z c ⟶ Y₀)
    (ν : ∀ c : Fin r, (C c).left ⟶ Z c)
    (V_comp : Fin r → Y₀.Opens)
    (hComp : ∀ c : Fin r,
      AlgebraicGeometry.IsClosedImmersion (ι_Z c) ∧
      AlgebraicGeometry.IsFinite (ν c) ∧
      (ν c ≫ ι_Z c) ≫ p_Y₀ = (C c).hom ∧
      AlgebraicGeometry.Surjective ((ι_Z c) ∣_ (V_comp c)) ∧
      CategoryTheory.IsIso ((ν c) ∣_
        ((TopologicalSpace.Opens.map (ι_Z c).base).obj (V_comp c))))
    (hDisj : ∀ c₁ c₂ : Fin r, c₁ ≠ c₂ →
      Disjoint (Set.range (ι_Z c₁).base) (V_comp c₂ : Set Y₀))
    (hBadFin : ((⋃ c : Fin r, (V_comp c : Set Y₀))ᶜ).Finite)
    (hBadCl : ∀ y ∈ ((⋃ c : Fin r, (V_comp c : Set Y₀))ᶜ), IsClosed ({y} : Set Y₀))
    (q : ℕ) (hq : 2 ≤ q)
    (φ : ∀ c : Fin r, weilEtaleTorsionH Y₀ ℓ q →+ weilEtaleTorsionH (C c).left ℓ q)
    (hφ : ∀ c : Fin r, WeilTopDegTorsionPullback (ν c ≫ ι_Z c) ℓ q (φ c)) :
    Function.Bijective (fun (x : weilEtaleTorsionH Y₀ ℓ q) (c : Fin r) => φ c x) :=
by
  classical
  
  let V_good : Y₀.Opens := ⨆ c : Fin r, V_comp c
  let g : ∀ c : Fin r, (C c).left ⟶ Y₀ := fun c => ν c ≫ ι_Z c
