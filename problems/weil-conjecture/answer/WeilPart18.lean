        · rw [not_nontrivial_iff_subsingleton] at hNontriv
          haveI : Subsingleton D_h := hNontriv
          intro x
          exact ⟨0, Subsingleton.elim _ _⟩
      exact ⟨h, hh_ne, I, inferInstance, P, hP_monic_sep, σ, N, hInj_σ, hPow_σ⟩
