  have hBij_lift : Function.Bijective (postY (CategoryTheory.Limits.Pi.lift ψ)) := by
    have : CategoryTheory.IsIso (CategoryTheory.Limits.Pi.lift ψ) := hIso_prod
    refine Function.bijective_iff_has_inverse.mpr
