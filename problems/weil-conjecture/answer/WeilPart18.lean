    let z₀ : Fin n → k := Fin.addCases (fun _ : Fin a => 0) (fun j : Fin b => G₀.coeff j.1)
    let ev₀ : R_Z →+* k := MvPolynomial.eval₂Hom τ_hom z₀
    have hFZ_ev₀ : F_Z.map ev₀ = Polynomial.X ^ a := by
      dsimp [F_Z]
      rw [Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum]
      have hsum0 : (∑ i : Fin a, (Polynomial.C (MvPolynomial.X (Fin.castAdd b i)) *
          Polynomial.X ^ i.1).map ev₀) = 0 := by
        apply Finset.sum_eq_zero
        intro i _
        rw [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X]
        have hz : ev₀ (MvPolynomial.X (Fin.castAdd b i)) = 0 := by
          dsimp [ev₀, z₀]
          rw [MvPolynomial.eval₂Hom_X']
          simp
        rw [hz, map_zero, zero_mul]
      rw [hsum0, add_zero]
    have hGZ_ev₀ : G_Z.map ev₀ = G₀ := by
      dsimp [G_Z]
      rw [Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum]
      have hsum : (∑ j : Fin b, (Polynomial.C (MvPolynomial.X (Fin.natAdd a j)) *
          Polynomial.X ^ j.1).map ev₀) =
          ∑ j ∈ Finset.range b, Polynomial.C (G₀.coeff j) * Polynomial.X ^ j := by
        rw [← Fin.sum_univ_eq_sum_range]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X]
        have hz : ev₀ (MvPolynomial.X (Fin.natAdd a j)) = G₀.coeff j.1 := by
          dsimp [ev₀, z₀]
          rw [MvPolynomial.eval₂Hom_X']
          simp
        rw [hz]
      rw [hsum, add_comm]
      conv_rhs => rw [Polynomial.as_sum_range' G₀ (b + 1) (Nat.lt_succ_self b)]
      rw [Finset.sum_range_succ]
      have hlead : G₀.coeff b = 1 := hG₀_monic.coeff_natDegree
      rw [hlead, Polynomial.monomial_one_right_eq_X_pow]
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      exact Polynomial.C_mul_X_pow_eq_monomial
    have hPZ_ev₀ : P_Z.map ev₀ = P_bar := by
      dsimp [P_Z, P_bar]
      rw [Polynomial.map_map]
      congr 1
      ext c
      dsimp [ev₀]
      exact MvPolynomial.eval₂Hom_C τ_hom z₀ c
    have hH_ev₀ : ∀ m : Fin n, ev₀ (H m) = 0 := by
      intro m
      dsimp [H]
      rw [← Polynomial.coeff_map, Polynomial.map_sub, Polynomial.map_mul,
        hFZ_ev₀, hGZ_ev₀, hPZ_ev₀, hP_bar_fac, sub_self, Polynomial.coeff_zero]
    let I_H : Ideal R_Z := Ideal.span (Set.range H)
    have hIH_ker : ∀ z ∈ I_H, ev₀ z = 0 := by
      have hle : I_H ≤ RingHom.ker ev₀ := by
        rw [Ideal.span_le]
        rintro _ ⟨m, rfl⟩
        exact hH_ev₀ m
      exact fun z hz => hle hz
    let C₀ := R_Z ⧸ I_H
    let τ₀ : C₀ →+* k := Ideal.Quotient.lift I_H ev₀ hIH_ker
    let P₀ : Algebra.PreSubmersivePresentation A C₀ (Fin n) (Fin n) :=
      Algebra.PreSubmersivePresentation.naive (v := H) id Function.injective_id
    let δ : C₀ := P₀.jacobian
    have hpderiv_PZ : ∀ r : Fin n, polyPderiv r P_Z = 0 := by
      intro r
      apply Polynomial.ext
      intro k_idx
      rw [coeff_polyPderiv, Polynomial.coeff_zero]
      dsimp [P_Z]
      rw [Polynomial.coeff_map, MvPolynomial.pderiv_C]
    have hpderiv_FZ_left : ∀ i : Fin a,
        polyPderiv (Fin.castAdd b i) F_Z = Polynomial.X ^ i.1 := by
      intro i
      apply Polynomial.ext
      intro k_idx
      rw [coeff_polyPderiv]
      dsimp [F_Z]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.finsetSum_coeff, map_add]
      have h1 : MvPolynomial.pderiv (Fin.castAdd b i) (if k_idx = a then (1 : R_Z) else 0) = 0 := by
        split_ifs <;> simp
      rw [h1, zero_add]
      simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero,
        map_sum]
      rw [Finset.sum_eq_single i]
      · split_ifs with hk
        · subst hk; simp
        · simp
      · intro i' _ hi'
        split_ifs with hk
        · have hne : Fin.castAdd b i' ≠ Fin.castAdd b i :=
            fun h => hi' (Fin.castAdd_injective a b h)
          simp [MvPolynomial.pderiv_X, Pi.single_eq_of_ne hne]
        · simp
      · intro hi; exact absurd (Finset.mem_univ i) hi
    have hpderiv_FZ_right : ∀ j : Fin b,
        polyPderiv (Fin.natAdd a j) F_Z = 0 := by
      intro j
      apply Polynomial.ext
      intro k_idx
      rw [coeff_polyPderiv, Polynomial.coeff_zero]
      dsimp [F_Z]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.finsetSum_coeff, map_add]
      have h1 : MvPolynomial.pderiv (Fin.natAdd a j) (if k_idx = a then (1 : R_Z) else 0) = 0 := by
        split_ifs <;> simp
      rw [h1, zero_add, map_sum]
      apply Finset.sum_eq_zero
      intro i _
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      split_ifs
      · have hne : Fin.castAdd b i ≠ Fin.natAdd a j := by
          intro h
          have hval := congrArg Fin.val h
          simp at hval
          omega
        simp [MvPolynomial.pderiv_X, Pi.single_eq_of_ne hne]
      · simp
    have hpderiv_GZ_left : ∀ i : Fin a,
        polyPderiv (Fin.castAdd b i) G_Z = 0 := by
      intro i
      apply Polynomial.ext
      intro k_idx
      rw [coeff_polyPderiv, Polynomial.coeff_zero]
      dsimp [G_Z]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.finsetSum_coeff, map_add]
      have h1 : MvPolynomial.pderiv (Fin.castAdd b i) (if k_idx = b then (1 : R_Z) else 0) = 0 := by
        split_ifs <;> simp
      rw [h1, zero_add, map_sum]
      apply Finset.sum_eq_zero
      intro j _
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      split_ifs
      · have hne : Fin.natAdd a j ≠ Fin.castAdd b i := by
          intro h
          have hval := congrArg Fin.val h
          simp at hval
          omega
        simp [MvPolynomial.pderiv_X, Pi.single_eq_of_ne hne]
      · simp
    have hpderiv_GZ_right : ∀ j : Fin b,
        polyPderiv (Fin.natAdd a j) G_Z = Polynomial.X ^ j.1 := by
      intro j
      apply Polynomial.ext
      intro k_idx
      rw [coeff_polyPderiv]
      dsimp [G_Z]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.finsetSum_coeff, map_add]
      have h1 : MvPolynomial.pderiv (Fin.natAdd a j) (if k_idx = b then (1 : R_Z) else 0) = 0 := by
        split_ifs <;> simp
      rw [h1, zero_add]
      simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero,
        map_sum]
      rw [Finset.sum_eq_single j]
      · split_ifs with hk
        · subst hk; simp
        · simp
      · intro j' _ hj'
        split_ifs with hk
        · have hne : Fin.natAdd a j' ≠ Fin.natAdd a j :=
            fun h => hj' (Fin.natAdd_injective b a h)
          simp [MvPolynomial.pderiv_X, Pi.single_eq_of_ne hne]
        · simp
      · intro hj; exact absurd (Finset.mem_univ j) hj
    let M_res : Matrix (Fin n) (Fin n) k := P₀.jacobiMatrix.map ev₀
    have hM_entry : ∀ r m : Fin n,
        M_res r m =
          ((polyPderiv r F_Z * G_Z + F_Z * polyPderiv r G_Z).map ev₀).coeff m.1 := by
      intro r m
      change ev₀ (P₀.jacobiMatrix r m) = _
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_naive]
      dsimp [H]
      rw [Polynomial.coeff_sub, map_sub, poly_pderiv_coeff_mul]
      have hp0 : MvPolynomial.pderiv r (P_Z.coeff m.1) = 0 := by
        rw [← coeff_polyPderiv, hpderiv_PZ r, Polynomial.coeff_zero]
      rw [hp0, sub_zero, Polynomial.coeff_map]
    have hM_upper : M_res.BlockTriangular id := by
      intro r m
      refine Fin.addCases (fun i => ?_) (fun j => ?_) r
      · intro hlt
        change m < Fin.castAdd b i at hlt
        rw [hM_entry, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, hFZ_ev₀, hGZ_ev₀,
          hpderiv_FZ_left i, hpderiv_GZ_left i, Polynomial.map_pow, Polynomial.map_X,
          Polynomial.map_zero, mul_zero, add_zero]
        have hm_lt : m.1 < i.1 := hlt
        rw [Polynomial.coeff_X_pow_mul']
        simp [hm_lt]
      · intro hlt
        change m < Fin.natAdd a j at hlt
        rw [hM_entry, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, hFZ_ev₀, hGZ_ev₀,
          hpderiv_FZ_right j, hpderiv_GZ_right j, Polynomial.map_zero, zero_mul, zero_add,
          Polynomial.map_pow, Polynomial.map_X, ← pow_add, Polynomial.coeff_X_pow]
        have hm_ne : m.1 ≠ a + j.1 := Nat.ne_of_lt hlt
        simp [hm_ne]
    have hM_det : M_res.det = (G₀.eval 0) ^ a := by
      rw [Matrix.det_of_isUpperTriangular hM_upper, Fin.prod_univ_add]
      have hprod_a : (∏ i : Fin a, M_res (Fin.castAdd b i) (Fin.castAdd b i)) =
          (G₀.eval 0) ^ a := by
        have hdiag : ∀ i : Fin a, M_res (Fin.castAdd b i) (Fin.castAdd b i) = G₀.eval 0 := by
          intro i
          rw [hM_entry, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul,
            hFZ_ev₀, hGZ_ev₀, hpderiv_FZ_left i, hpderiv_GZ_left i,
            Polynomial.map_pow, Polynomial.map_X, Polynomial.map_zero, mul_zero, add_zero]
          have h0i : (Polynomial.X ^ i.1 * G₀).coeff (Fin.castAdd b i).1 =
              (Polynomial.X ^ i.1 * G₀).coeff (0 + i.1) := by
            rw [Fin.val_castAdd, zero_add]
          rw [h0i, Polynomial.coeff_X_pow_mul, Polynomial.coeff_zero_eq_eval_zero]
        simp [hdiag]
      have hprod_b : (∏ j : Fin b, M_res (Fin.natAdd a j) (Fin.natAdd a j)) = 1 := by
        apply Finset.prod_eq_one
        intro j _
        rw [hM_entry, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul,
          hFZ_ev₀, hGZ_ev₀, hpderiv_FZ_right j, hpderiv_GZ_right j,
          Polynomial.map_zero, zero_mul, zero_add, Polynomial.map_pow, Polynomial.map_X,
          ← pow_add]
        change (Polynomial.X ^ (a + j.1) : Polynomial k).coeff (a + j.1) = 1
        rw [Polynomial.coeff_X_pow_self]
      rw [hprod_a, hprod_b, mul_one]
    have hτ₀_δ : τ₀ δ ≠ 0 := by
      dsimp [δ, τ₀]
      rw [P₀.jacobian_eq_jacobiMatrix_det]
      change ev₀ P₀.jacobiMatrix.det ≠ 0
      rw [ev₀.map_det]
      change M_res.det ≠ 0
      rw [hM_det]
      exact pow_ne_zero a hG₀_eval0
    let C := Localization.Away δ
    let Q_loc : Algebra.PreSubmersivePresentation C₀ C Unit Unit :=
      Algebra.PreSubmersivePresentation.localizationAway C δ
    let P_comp := Q_loc.comp P₀
    have hUnit_comp_jac : IsUnit P_comp.jacobian := by
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
      exact (IsLocalization.Away.algebraMap_isUnit δ).mul (IsLocalization.Away.algebraMap_isUnit δ)
    let P_sub : Algebra.SubmersivePresentation A C (Unit ⊕ Fin n) (Unit ⊕ Fin n) :=
      ⟨P_comp, hUnit_comp_jac⟩
    have hdim0 : P_sub.dimension = 0 := Nat.sub_self _
    have _ : Algebra.IsStandardSmoothOfRelativeDimension 0 A C :=
      P_sub.isStandardSmoothOfRelativeDimension hdim0
    have _ : Algebra.Etale A C := inferInstance
    have hUnit_τ₀_δ : IsUnit (τ₀ δ) := IsUnit.mk0 (τ₀ δ) hτ₀_δ
    let τ_C : C →+* k := IsLocalization.Away.lift δ hUnit_τ₀_δ
    have hτ_C_comm : ∀ a₀ : A, τ_C (algebraMap A C a₀) = τ_A a₀ := by
      intro a₀
      rw [IsScalarTower.algebraMap_apply A C₀ C, IsLocalization.Away.lift_eq]
      dsimp [τ₀]
      change Ideal.Quotient.lift I_H ev₀ hIH_ker
        (Ideal.Quotient.mk I_H (MvPolynomial.C a₀)) = τ_A a₀
      rw [Ideal.Quotient.lift_mk]
      exact MvPolynomial.eval₂Hom_C τ_hom z₀ a₀
    obtain ⟨σ_C, hσ_C⟩ := hEtaleLift C τ_C hτ_C_comm
    let q_IH : R_Z →ₐ[A] C₀ := Ideal.Quotient.mkₐ A I_H
    let ι_C : C₀ →ₐ[A] C := IsScalarTower.toAlgHom A C₀ C
    let ψ : R_Z →ₐ[A] A := σ_C.comp (ι_C.comp q_IH)
    let ψ_hom : R_Z →+* A := ψ.toRingHom
    have hψ_H : ∀ m : Fin n, ψ_hom (H m) = 0 := by
      intro m
      dsimp [ψ_hom, ψ, q_IH]
      have hm_mem : H m ∈ I_H := Ideal.subset_span ⟨m, rfl⟩
      rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem.mpr hm_mem, map_zero, map_zero]
    have hτ_ψ : τ_hom.comp ψ_hom = ev₀ := by
      ext r_var
      · change τ_A (ψ (algebraMap A R_Z r_var)) = ev₀ (MvPolynomial.C r_var)
        rw [ψ.commutes]
        exact (MvPolynomial.eval₂Hom_C τ_hom z₀ r_var).symm
      · change τ_A (ψ (MvPolynomial.X r_var)) = ev₀ (MvPolynomial.X r_var)
        dsimp [ψ, ι_C, q_IH]
        rw [hσ_C, IsLocalization.Away.lift_eq]
        rfl
    let F : Polynomial A := F_Z.map ψ_hom
    let G : Polynomial A := G_Z.map ψ_hom
    have hF_monic : F.Monic ∧ F.natDegree = a := by
      have hdeg_sum : (∑ i : Fin a, Polynomial.C (ψ_hom (MvPolynomial.X (Fin.castAdd b i))) *
          Polynomial.X ^ i.1).degree < (Polynomial.X ^ a : Polynomial A).degree := by
        rw [Polynomial.degree_X_pow]
        refine (Polynomial.degree_sum_le _ _).trans_lt ?_
        apply (Finset.sup_lt_iff (WithBot.bot_lt_coe a)).mpr
        intro i _
        refine (Polynomial.degree_C_mul_X_pow_le _ _).trans_lt ?_
        exact WithBot.coe_lt_coe.mpr i.2
      have hF_eq : F = Polynomial.X ^ a +
          ∑ i : Fin a,
            Polynomial.C (ψ_hom (MvPolynomial.X (Fin.castAdd b i))) * Polynomial.X ^ i.1 := by
        dsimp [F, F_Z]
        simp [Polynomial.map_sum]
      rw [hF_eq]
      exact ⟨(Polynomial.monic_X_pow a).add_of_left hdeg_sum,
        (Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_sum).trans
          (Polynomial.natDegree_X_pow a)⟩
    have hG_monic : G.Monic ∧ G.natDegree = b := by
      have hdeg_sum : (∑ j : Fin b, Polynomial.C (ψ_hom (MvPolynomial.X (Fin.natAdd a j))) *
          Polynomial.X ^ j.1).degree < (Polynomial.X ^ b : Polynomial A).degree := by
        rw [Polynomial.degree_X_pow]
        refine (Polynomial.degree_sum_le _ _).trans_lt ?_
        apply (Finset.sup_lt_iff (WithBot.bot_lt_coe b)).mpr
        intro j _
        refine (Polynomial.degree_C_mul_X_pow_le _ _).trans_lt ?_
        exact WithBot.coe_lt_coe.mpr j.2
      have hG_eq : G = Polynomial.X ^ b +
          ∑ j : Fin b,
            Polynomial.C (ψ_hom (MvPolynomial.X (Fin.natAdd a j))) * Polynomial.X ^ j.1 := by
        dsimp [G, G_Z]
        simp [Polynomial.map_sum]
      rw [hG_eq]
      exact ⟨(Polynomial.monic_X_pow b).add_of_left hdeg_sum,
        (Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_sum).trans
          (Polynomial.natDegree_X_pow b)⟩
    have hFG_eq_P : F * G = P := by
      have hFG_monic : (F * G).Monic := hF_monic.1.mul hG_monic.1
      have hFG_deg : (F * G).natDegree = n := by
        rw [hF_monic.1.natDegree_mul hG_monic.1, hF_monic.2, hG_monic.2]
      have hPZ_map : P_Z.map ψ_hom = P := by
        dsimp [P_Z]
        rw [Polynomial.map_map]
        have hcomp_C : ψ_hom.comp MvPolynomial.C = RingHom.id A := by
          ext c
          exact ψ.commutes c
        rw [hcomp_C, Polynomial.map_id]
      apply Polynomial.ext
      intro m
      by_cases hm : m < n
      · have hsub : (F * G - P).coeff m = 0 := by
          rw [← hPZ_map, ← Polynomial.map_mul, ← Polynomial.map_sub, Polynomial.coeff_map]
          exact hψ_H ⟨m, hm⟩
        rw [Polynomial.coeff_sub] at hsub
        exact sub_eq_zero.mp hsub
      · push Not at hm
        rcases eq_or_lt_of_le hm with rfl | hgt
        · rw [← hFG_deg, hFG_monic.coeff_natDegree, hFG_deg]
          dsimp [n]
          rw [hab_deg, hP_monic.coeff_natDegree]
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (hFG_deg ▸ hgt),
            Polynomial.coeff_eq_zero_of_natDegree_lt (hab_deg ▸ hgt)]
    have hF_res : F.map τ_hom = Polynomial.X ^ a := by
      dsimp [F]
      rw [Polynomial.map_map, hτ_ψ, hFZ_ev₀]
    have hG_res : G.map τ_hom = G₀ := by
      dsimp [G]
      rw [Polynomial.map_map, hτ_ψ, hGZ_ev₀]
    have hG₀_coeff0 : G₀.coeff 0 ≠ 0 := by
      rwa [Polynomial.coeff_zero_eq_eval_zero]
    have hcop_X : IsCoprime (Polynomial.X : Polynomial k) G₀ := by
      refine ⟨-Polynomial.C (G₀.coeff 0)⁻¹ * G₀.divX, Polynomial.C (G₀.coeff 0)⁻¹, ?_⟩
      have hdiv : G₀ - Polynomial.X * G₀.divX = Polynomial.C (G₀.coeff 0) := by
        have h := Polynomial.X_mul_divX_add G₀
        linear_combination -h
      calc (-Polynomial.C (G₀.coeff 0)⁻¹ * G₀.divX) * Polynomial.X +
            Polynomial.C (G₀.coeff 0)⁻¹ * G₀
          = Polynomial.C (G₀.coeff 0)⁻¹ * (G₀ - Polynomial.X * G₀.divX) := by ring
        _ = Polynomial.C (G₀.coeff 0)⁻¹ * Polynomial.C (G₀.coeff 0) := by rw [hdiv]
        _ = Polynomial.C ((G₀.coeff 0)⁻¹ * G₀.coeff 0) := by rw [← Polynomial.C_mul]
        _ = 1 := by rw [inv_mul_cancel₀ hG₀_coeff0, map_one]
    obtain ⟨u_bar, v_bar, hbez_k⟩ := (hcop_X.pow_left : IsCoprime (Polynomial.X ^ a) G₀)
    let u₀ : Polynomial A := u_bar.map (algebraMap k A)
    let v₀ : Polynomial A := v_bar.map (algebraMap k A)
    let Δ : Polynomial A := u₀ * F + v₀ * G - 1
    have hcomp_id : τ_hom.comp (algebraMap k A) = RingHom.id k :=
      RingHom.ext τ_A.commutes
    have hΔ_res : Δ.map τ_hom = 0 := by
      change (u₀ * F + v₀ * G - 1).map τ_hom = 0
      rw [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul,
        Polynomial.map_one, hF_res, hG_res]
      dsimp [u₀, v₀]
      rw [Polynomial.map_map, Polynomial.map_map, hcomp_id, Polynomial.map_id, Polynomial.map_id,
        hbez_k, sub_self]
    let r_R : R := Polynomial.aeval x Δ
    have hr_R_mem : r_R ∈ Ideal.map (algebraMap A R) (RingHom.ker τ_A.toRingHom) := by
      dsimp [r_R]
      rw [Polynomial.aeval_eq_sum_range]
      apply Ideal.sum_mem
      intro idx _
      rw [Algebra.smul_def]
      apply Ideal.mul_mem_right
      apply Ideal.mem_map_of_mem (algebraMap A R)
      change τ_hom (Δ.coeff idx) = 0
      have := congrArg (fun q => q.coeff idx) hΔ_res
      simpa [Polynomial.coeff_map] using this
    have hUnit_sum : IsUnit (1 + r_R) := hUnit_one_add r_R hr_R_mem
    obtain ⟨w_unit, hw_unit⟩ := hUnit_sum
    let w : R := ↑w_unit⁻¹
    have hw_mul : w * (1 + r_R) = 1 := by
      dsimp [w]
      rw [← hw_unit]
      exact Units.inv_mul w_unit
    have h1_add_r : 1 + r_R = Polynomial.aeval x (u₀ * F) + Polynomial.aeval x (v₀ * G) := by
      dsimp [r_R, Δ]
      rw [map_sub, map_add, map_one]
      ring
    have hq_w : q_R w = 1 := by
      have hqr : q_R r_R = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hr_R_mem
      have h1 := congrArg q_R hw_mul
      rw [map_mul, map_add, map_one, hqr, add_zero, mul_one] at h1
      exact h1
    let e : R := w * Polynomial.aeval x (u₀ * F)
    have h1_sub_e : 1 - e = w * Polynomial.aeval x (v₀ * G) := by
      dsimp [e]
      calc 1 - w * Polynomial.aeval x (u₀ * F)
          = w * (1 + r_R) - w * Polynomial.aeval x (u₀ * F) := by rw [hw_mul]
        _ = w * Polynomial.aeval x (v₀ * G) := by rw [h1_add_r]; ring
    have he_idem : IsIdempotentElem e := by
      change e * e = e
      have hprod0 : e * (1 - e) = 0 := by
        rw [h1_sub_e]
        dsimp [e]
        calc (w * Polynomial.aeval x (u₀ * F)) * (w * Polynomial.aeval x (v₀ * G))
