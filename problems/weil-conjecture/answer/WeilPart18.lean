      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      have hZ_pb : CategoryTheory.Limits.IsZero ((pb z).obj G) :=
        hPullZero Ω z ((pb z).obj G) hz (hPullSelf z G)
      let Φ₀ := (pt S_Ω Ω (𝟙 S_Ω)).sheafFiber (A := AddCommGrpCat.{u})
      have hZ₁ : CategoryTheory.Limits.IsZero
          (((pt Z Ω (𝟙 S_Ω ≫ z)).sheafFiber (A := AddCommGrpCat.{u})).obj G) :=
        CategoryTheory.Limits.IsZero.of_iso (Φ₀.map_isZero hZ_pb) ((e_fib z Ω (𝟙 S_Ω)).app G).symm
      rwa [CategoryTheory.Category.id_comp] at hZ₁
  have hConstStalk : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W)
      (A : AddCommGrpCat.{u}),
      Nonempty ((((pt W Ω w).sheafFiber (A := AddCommGrpCat.{u})).obj
