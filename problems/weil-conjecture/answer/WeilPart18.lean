import WeilPart17
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_projLine_special_fiber_curve_normalization (k : Type u) [Field k] [IsAlgClosed k]
    (Y₀ : AlgebraicGeometry.Scheme.{u})
    (p_Y₀ : Y₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
    (π₀ : Y₀ ⟶ (weilProjectiveSpaceOver k 1).left)
    [AlgebraicGeometry.IsFinite π₀]
    (hπ₀ : π₀ ≫ (weilProjectiveSpaceOver k 1).hom = p_Y₀) :
    ∃ (r : ℕ)
      (C : Fin r → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (Z : Fin r → AlgebraicGeometry.Scheme.{u})
      (ι_Z : ∀ c : Fin r, Z c ⟶ Y₀)
      (ν : ∀ c : Fin r, (C c).left ⟶ Z c)
      (V_comp : Fin r → Y₀.Opens),
      (∀ c : Fin r,
        AlgebraicGeometry.IsIntegral (C c).left ∧
        IsProjectiveOverField k (C c) ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (C c).hom ∧
        AlgebraicGeometry.IsIntegral (Z c) ∧
        AlgebraicGeometry.IsClosedImmersion (ι_Z c) ∧
        AlgebraicGeometry.IsFinite (ν c) ∧
        AlgebraicGeometry.Surjective (ν c) ∧
        (ν c ≫ ι_Z c) ≫ p_Y₀ = (C c).hom ∧
        Nonempty (V_comp c) ∧
        AlgebraicGeometry.Surjective ((ι_Z c) ∣_ (V_comp c)) ∧
        CategoryTheory.IsIso ((ν c) ∣_
          ((TopologicalSpace.Opens.map (ι_Z c).base).obj (V_comp c)))) ∧
      (∀ c₁ c₂ : Fin r, c₁ ≠ c₂ →
        Disjoint (V_comp c₁ : Set Y₀) (V_comp c₂ : Set Y₀) ∧
        Disjoint (Set.range (ι_Z c₁).base) (V_comp c₂ : Set Y₀)) ∧
      ((⋃ c : Fin r, (V_comp c : Set Y₀))ᶜ).Finite ∧
      (∀ y ∈ ((⋃ c : Fin r, (V_comp c : Set Y₀))ᶜ), IsClosed ({y} : Set Y₀)) :=
by
  classical
  let P₁ := weilProjectiveSpaceOver k 1
  
  have hNoeth_of_fin : ∀ {X W_tgt : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ W_tgt)
      [AlgebraicGeometry.IsNoetherian W_tgt]
      [AlgebraicGeometry.LocallyOfFiniteType f]
      [AlgebraicGeometry.QuasiCompact f],
      AlgebraicGeometry.IsNoetherian X := by
    intro X W_tgt f _ _ _
    have : AlgebraicGeometry.IsLocallyNoetherian X :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian f
    have : CompactSpace ↥X :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace f
    exact {}

  
  have h_s7 : AlgebraicGeometry.IsNoetherian P₁.left ∧
      AlgebraicGeometry.IsNoetherian Y₀ ∧
      ∃ (n : ℕ)
        (W : Fin n → AlgebraicGeometry.Scheme.{u})
        (ι_W : ∀ i : Fin n, W i ⟶ Y₀),
        (∀ i : Fin n,
          AlgebraicGeometry.IsIntegral (W i) ∧
          AlgebraicGeometry.IsNoetherian (W i) ∧
          AlgebraicGeometry.IsClosedImmersion (ι_W i)) ∧
        (⋃ i : Fin n, Set.range (ι_W i).base) = Set.univ ∧
        (∀ i j : Fin n, i ≠ j → ¬ (Set.range (ι_W i).base ⊆ Set.range (ι_W j).base)) := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hSurj₀ : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro p
      have hp1 : p.1 ∈ (1 : Submodule k (MvPolynomial (Fin 2) k)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero]
        exact p.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp1
      exact ⟨c, Subtype.ext hc⟩
    have hFT₀ : (algebraMap k ↥(𝒜 0)).FiniteType :=
      RingHom.FiniteType.of_surjective _ hSurj₀
    have : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT₀
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin 2) k) :=
      @IsScalarTower.of_algebraMap_eq k ↥(𝒜 0) (MvPolynomial (Fin 2) k) _ _ _ _ _ _
        (fun _ => rfl)
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin 2) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin 2) k)
    have hLFT_P₁ : AlgebraicGeometry.LocallyOfFiniteType P₁.hom := by
      dsimp [P₁, weilProjectiveSpaceOver]
      infer_instance
    have : AlgebraicGeometry.IsLocallyNoetherian P₁.left :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian P₁.hom
    let f_X : Fin 2 → MvPolynomial (Fin 2) k := MvPolynomial.X
    have hf_hom : ∀ a : Fin 2, ∃ d : ℕ, f_X a ∈ 𝒜 d :=
      fun a => ⟨1, MvPolynomial.isHomogeneous_X k a⟩
    have hf_adj : Algebra.adjoin (↥(𝒜 0)) (Set.range f_X) = ⊤ := by
      rw [eq_top_iff]
      intro p _
      have hp_k : p ∈ Algebra.adjoin k (Set.range f_X) := by
        rw [MvPolynomial.adjoin_range_X]
        trivial
      have h_le : Algebra.adjoin k (Set.range f_X) ≤
          (Algebra.adjoin (↥(𝒜 0)) (Set.range f_X)).restrictScalars k :=
        Algebra.adjoin_le_iff.mpr Algebra.subset_adjoin
      exact h_le hp_k
    have h_cov_P₁ : (⨆ a : Fin 2, AlgebraicGeometry.Proj.basicOpen 𝒜 (f_X a)) = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 f_X hf_hom hf_adj
    have : CompactSpace ↥P₁.left := by
      change CompactSpace ↥(AlgebraicGeometry.Proj 𝒜)
      rw [← isCompact_univ_iff]
      have huniv : (Set.univ : Set ↥(AlgebraicGeometry.Proj 𝒜)) =
          ⋃ a : Fin 2, (AlgebraicGeometry.Proj.basicOpen 𝒜 (f_X a) :
            Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
        rw [← TopologicalSpace.Opens.coe_top, ← h_cov_P₁, TopologicalSpace.Opens.coe_iSup]
      rw [huniv]
      exact isCompact_iUnion (fun a =>
        (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (f_X a)
          (MvPolynomial.isHomogeneous_X k a) Nat.one_pos).isCompact)
    have hNoethP₁ : AlgebraicGeometry.IsNoetherian P₁.left := {}
    have hNoethY₀ : AlgebraicGeometry.IsNoetherian Y₀ := hNoeth_of_fin π₀
    let ℰ : Set (Set ↥Y₀) := irreducibleComponents ↥Y₀
    have hℰ_fin : ℰ.Finite :=
      AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian (X := Y₀)
    let : Fintype ↥ℰ := hℰ_fin.fintype
    let n : ℕ := Fintype.card ↥ℰ
    let e_n : Fin n ≃ ↥ℰ := (Fintype.equivFin ↥ℰ).symm
    have hE_max : ∀ i : Fin n, Maximal (fun s : Set ↥Y₀ => IsClosed s ∧ IsIrreducible s) (e_n i).1 := by
      intro i
      let s : Set ↥Y₀ := (e_n i).1
      have hi : s ∈ irreducibleComponents ↥Y₀ := (e_n i).2
      rwa [irreducibleComponents_eq_maximals_closed] at hi
    let I_W : Fin n → Y₀.IdealSheafData :=
      fun i => AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨(e_n i).1, (hE_max i).prop.1⟩
    let W : Fin n → AlgebraicGeometry.Scheme.{u} := fun i => (I_W i).subscheme
    let ι_W : ∀ i : Fin n, W i ⟶ Y₀ := fun i => (I_W i).subschemeι
    have h_range_W : ∀ i : Fin n, Set.range (ι_W i).base = (e_n i).1 := by
      intro i
      dsimp [ι_W, I_W]
      rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
        AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    refine ⟨hNoethP₁, hNoethY₀, n, W, ι_W, ?_, ?_, ?_⟩
    · intro i
      have hCl_i : AlgebraicGeometry.IsClosedImmersion (ι_W i) := by
        dsimp [ι_W]; infer_instance
      have hNoeth_i : AlgebraicGeometry.IsNoetherian (W i) := hNoeth_of_fin (ι_W i)
      have h_rad_eq : (I_W i).radical = I_W i := by
        rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support]
        rfl
      have hRed_i : AlgebraicGeometry.IsReduced (W i) := by
        have hRed_charts : ∀ U : Y₀.affineOpens,
            AlgebraicGeometry.IsReduced (((I_W i).subschemeCover.openCover).X U) := by
          intro U
          have h_rad_U : ((I_W i).ideal U).IsRadical := by
            rw [← Ideal.radical_eq_iff, ← AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal,
              h_rad_eq]
          have : IsReduced (↑(Y₀.presheaf.obj (Opposite.op U.1)) ⧸ (I_W i).ideal U) := by
            refine ⟨fun q hq => ?_⟩
            obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
            rcases hq with ⟨m, hm⟩
            rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem] at hm
            rw [Ideal.Quotient.eq_zero_iff_mem]
            exact h_rad_U ⟨m, hm⟩
          change AlgebraicGeometry.IsReduced
            (AlgebraicGeometry.Spec (CommRingCat.of
              (↑(Y₀.presheaf.obj (Opposite.op U.1)) ⧸ (I_W i).ideal U)))
          infer_instance
        exact @AlgebraicGeometry.IsReduced.of_openCover (W i)
          ((I_W i).subschemeCover).openCover hRed_charts
      have hIrr_i : IrreducibleSpace ↥(W i) := by
        have hEi_irr : IsIrreducible (e_n i).1 := (hE_max i).prop.2
        obtain ⟨y₀, hy₀⟩ := hEi_irr.nonempty
        rw [← h_range_W i] at hy₀
        obtain ⟨w₀, _⟩ := hy₀
        refine { isPreirreducible_univ := ?_, toNonempty := ⟨w₀⟩ }
        rw [isPreirreducible_iff_isClosed_union_isClosed]
        intro z₁ z₂ hz₁ hz₂ huniv
        have hz₁' : IsClosed ((ι_W i).base '' z₁) := (ι_W i).isClosedMap z₁ hz₁
        have hz₂' : IsClosed ((ι_W i).base '' z₂) := (ι_W i).isClosedMap z₂ hz₂
        have h_sub_E : (e_n i).1 ⊆ ((ι_W i).base '' z₁) ∪ ((ι_W i).base '' z₂) := by
          rw [← h_range_W i, ← Set.image_univ, ← Set.image_union]
          exact Set.image_mono huniv
        have hinj : Function.Injective (ι_W i).base := (ι_W i).isClosedEmbedding.injective
        rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hEi_irr.isPreirreducible)
            _ _ hz₁' hz₂' h_sub_E with h1 | h2
        · left
          intro w _
          have hw : (ι_W i).base w ∈ (ι_W i).base '' z₁ := h1 (h_range_W i ▸ ⟨w, rfl⟩)
          rwa [hinj.mem_set_image] at hw
        · right
          intro w _
          have hw : (ι_W i).base w ∈ (ι_W i).base '' z₂ := h2 (h_range_W i ▸ ⟨w, rfl⟩)
          rwa [hinj.mem_set_image] at hw
      exact ⟨AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced (W i), hNoeth_i, hCl_i⟩
    · ext y
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      let E_y : ↥ℰ := ⟨irreducibleComponent y, irreducibleComponent_mem_irreducibleComponents y⟩
      refine ⟨e_n.symm E_y, ?_⟩
      rw [h_range_W (e_n.symm E_y), e_n.apply_symm_apply]
      exact mem_irreducibleComponent
    · intro i j hij hsub
      rw [h_range_W i, h_range_W j] at hsub
      have h_ge : (e_n j).1 ⊆ (e_n i).1 :=
        (hE_max i).le_of_ge ⟨(hE_max j).prop.1, (hE_max j).prop.2⟩ hsub
      have h_eq : e_n i = e_n j := Subtype.ext (Set.Subset.antisymm hsub h_ge)
      exact hij (e_n.injective h_eq)

  
  have h_s8 :
      (∀ (X : Type u) [TopologicalSpace X] [T0Space X] [QuasiSober X]
          [TopologicalSpace.NoetherianSpace X] [IrreducibleSpace X],
        topologicalKrullDim X = (1 : WithBot ℕ∞) →
        ∀ (S : Set X), IsClosed S → S ≠ Set.univ →
          S.Finite ∧ ∀ x ∈ S, IsClosed ({x} : Set X)) ∧
      (∀ {Y X : AlgebraicGeometry.Scheme.{u}}
          [AlgebraicGeometry.IsNoetherian X] [AlgebraicGeometry.IsIntegral X]
          (f : Y ⟶ X) [AlgebraicGeometry.IsFinite f],
        topologicalKrullDim X = (1 : WithBot ℕ∞) →
        ∀ (S : Set ↥X), IsClosed S → S ≠ Set.univ →
          (f.base ⁻¹' S).Finite ∧ ∀ y ∈ f.base ⁻¹' S, IsClosed ({y} : Set ↥Y)) := by
    have hPart1 : ∀ (X : Type u) [TopologicalSpace X] [T0Space X] [QuasiSober X]
        [TopologicalSpace.NoetherianSpace X] [IrreducibleSpace X],
        topologicalKrullDim X = (1 : WithBot ℕ∞) →
        ∀ (S : Set X), IsClosed S → S ≠ Set.univ →
          S.Finite ∧ ∀ x ∈ S, IsClosed ({x} : Set X) := by
      intro X _ _ _ _ _ hDim S hS_cl hS_ne
      have h_pts : ∀ x ∈ S, IsClosed ({x} : Set X) := by
        intro x hx
        have hcx_sub : closure ({x} : Set X) ⊆ S :=
          closure_minimal (Set.singleton_subset_iff.mpr hx) hS_cl
        have hcx_ne : closure ({x} : Set X) ≠ Set.univ := by
          intro heq
          apply hS_ne
          exact Set.eq_univ_of_univ_subset (heq ▸ hcx_sub)
        rw [← closure_subset_iff_isClosed]
        intro y hy
        rw [Set.mem_singleton_iff]
        by_contra hyx
        have hx_not_cy : x ∉ closure ({y} : Set X) := by
          intro hxy
          have hcy_sub : closure ({y} : Set X) ⊆ closure ({x} : Set X) :=
            closure_minimal (Set.singleton_subset_iff.mpr hy) isClosed_closure
          have hcx_sub_y : closure ({x} : Set X) ⊆ closure ({y} : Set X) :=
            closure_minimal (Set.singleton_subset_iff.mpr hxy) isClosed_closure
          have heq_cl : closure ({y} : Set X) = closure ({x} : Set X) :=
            Set.Subset.antisymm hcy_sub hcx_sub_y
          exact hyx (inseparable_iff_closure_eq.mpr heq_cl).eq
        let K₀ : TopologicalSpace.IrreducibleCloseds X :=
          ⟨closure ({y} : Set X), isIrreducible_singleton.closure, isClosed_closure⟩
        let K₁ : TopologicalSpace.IrreducibleCloseds X :=
          ⟨closure ({x} : Set X), isIrreducible_singleton.closure, isClosed_closure⟩
        let K₂ : TopologicalSpace.IrreducibleCloseds X :=
          ⟨Set.univ, IrreducibleSpace.isIrreducible_univ X, isClosed_univ⟩
        have hK₀₁ : K₀ < K₁ := by
          refine lt_of_le_not_ge ?_ ?_
          · exact closure_minimal (Set.singleton_subset_iff.mpr hy) isClosed_closure
          · intro hge
            exact hx_not_cy (hge (subset_closure (Set.mem_singleton x)))
        have hK₁₂ : K₁ < K₂ := by
          refine lt_of_le_not_ge (Set.subset_univ _) ?_
          · intro hge
            exact hcx_ne (Set.eq_univ_of_univ_subset hge)
        let p₀ : LTSeries (TopologicalSpace.IrreducibleCloseds X) :=
          RelSeries.singleton _ K₂
        let p₁ : LTSeries (TopologicalSpace.IrreducibleCloseds X) :=
          RelSeries.cons p₀ K₁ hK₁₂
        let p₂ : LTSeries (TopologicalSpace.IrreducibleCloseds X) :=
          RelSeries.cons p₁ K₀ hK₀₁
        have h_len : (p₂.length : WithBot ℕ∞) ≤ topologicalKrullDim X :=
          Order.LTSeries.length_le_krullDim p₂
        have hp₂_len : p₂.length = 2 := rfl
        rw [hp₂_len, hDim] at h_len
        exact absurd (WithBot.coe_le_coe.mp h_len) (by decide)
      refine ⟨?_, h_pts⟩
      obtain ⟨T, hT_fin, hT_irr, hS_sup⟩ :=
        TopologicalSpace.NoetherianSpace.exists_finite_set_closeds_irreducible
          (⟨S, hS_cl⟩ : TopologicalSpace.Closeds X)
      have hU_cl : IsClosed (⋃ t ∈ T, (t : Set X)) :=
        hT_fin.isClosed_biUnion (fun t _ => t.isClosed)
      have hS_sub : S ⊆ ⋃ t ∈ T, (t : Set X) := by
        have h_le : (⟨S, hS_cl⟩ : TopologicalSpace.Closeds X) ≤ ⟨⋃ t ∈ T, (t : Set X), hU_cl⟩ := by
          rw [hS_sup]
          exact sSup_le (fun t ht => Set.subset_biUnion_of_mem (u := fun u : TopologicalSpace.Closeds X => (u : Set X)) ht)
        exact h_le
      refine Set.Finite.subset (hT_fin.biUnion ?_) hS_sub
      intro t ht
      have ht_sub : (t : Set X) ⊆ S := by
        have h_le : t ≤ (⟨S, hS_cl⟩ : TopologicalSpace.Closeds X) := by
          rw [hS_sup]
          exact le_sSup ht
        exact h_le
      obtain ⟨x_t, hx_gen⟩ := QuasiSober.sober (hT_irr t ht) t.isClosed
      have hx_mem : x_t ∈ S := ht_sub (hx_gen.def ▸ subset_closure (Set.mem_singleton x_t))
      have hx_cl : IsClosed ({x_t} : Set X) := h_pts x_t hx_mem
      have ht_eq : (t : Set X) = {x_t} := by
        rw [← hx_gen.def, hx_cl.closure_eq]
      rw [ht_eq]
      exact Set.finite_singleton x_t
    refine ⟨hPart1, ?_⟩
    intro Y X _ _ f _ hDim S hS_cl hS_ne
    have : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
    obtain ⟨hS_fin, hS_pts⟩ := hPart1 ↥X hDim S hS_cl hS_ne
    refine ⟨f.finite_preimage hS_fin, ?_⟩
    intro y hy
    let x : ↥X := f.base y
    have hx_cl : IsClosed ({x} : Set ↥X) := hS_pts x hy
    have hFx_cl : IsClosed (f.base ⁻¹' ({x} : Set ↥X)) :=
      hx_cl.preimage f.continuous
    let : DiscreteTopology ↑(f.base ⁻¹' ({x} : Set ↥X)) :=
      (f.fiberHomeo x).discreteTopology
    have hy_disc : IsClosed ({(⟨y, rfl⟩ : ↑(f.base ⁻¹' ({x} : Set ↥X)))} :
        Set ↑(f.base ⁻¹' ({x} : Set ↥X))) :=
      isClosed_discrete _
    have h_img : IsClosed ((Subtype.val : ↑(f.base ⁻¹' ({x} : Set ↥X)) → ↥Y) ''
        {(⟨y, rfl⟩ : ↑(f.base ⁻¹' ({x} : Set ↥X)))}) :=
      hFx_cl.isClosedEmbedding_subtypeVal.isClosedMap _ hy_disc
    simpa only [Set.image_singleton] using h_img

  
  obtain ⟨hIntP₁, hProjP₁, hDimP₁_raw, _⟩ :=
    weil_projectiveSpace_integral_krullDim_and_dim_zero_iso k 1
  have hDimP₁ : topologicalKrullDim P₁.left = (1 : WithBot ℕ∞) := by
    simpa using hDimP₁_raw
  obtain ⟨hNoethP₁, hNoethY₀, n, W, ι_W, hW, hCovW, hIncompW⟩ := h_s7
  have : AlgebraicGeometry.IsNoetherian P₁.left := hNoethP₁
  have : AlgebraicGeometry.IsIntegral P₁.left := hIntP₁
  let S₁ := { i : Fin n // AlgebraicGeometry.Surjective (ι_W i ≫ π₀) }
  let r : ℕ := Fintype.card S₁
  let e_r : Fin r ≃ S₁ := (Fintype.equivFin S₁).symm
  let Z : Fin r → AlgebraicGeometry.Scheme.{u} := fun c => W (e_r c).1
  let ι_Z : ∀ c : Fin r, Z c ⟶ Y₀ := fun c => ι_W (e_r c).1
  have hIntZ : ∀ c : Fin r, AlgebraicGeometry.IsIntegral (Z c) := fun c => (hW (e_r c).1).1
  have hNoethZ : ∀ c : Fin r, AlgebraicGeometry.IsNoetherian (Z c) := fun c => (hW (e_r c).1).2.1
  have hClZ : ∀ c : Fin r, AlgebraicGeometry.IsClosedImmersion (ι_Z c) := fun c => (hW (e_r c).1).2.2
  let Z_over : Fin r → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    fun c => CategoryTheory.Over.mk (ι_Z c ≫ p_Y₀)
  have hZ_proj_dim : ∀ c : Fin r,
      IsProjectiveOverField k (Z_over c) ∧
      topologicalKrullDim (Z c) = (1 : WithBot ℕ∞) := by
    intro c
    have : AlgebraicGeometry.IsClosedImmersion (ι_Z c) := hClZ c
    let g_Z : Z_over c ⟶ P₁ :=
      CategoryTheory.Over.homMk (ι_Z c ≫ π₀) (by
        dsimp [Z_over, P₁]
        rw [CategoryTheory.Category.assoc, hπ₀])
    have hFin_gZ : AlgebraicGeometry.IsFinite g_Z.left := by
      change AlgebraicGeometry.IsFinite (ι_Z c ≫ π₀)
      infer_instance
    obtain ⟨hProjZ, hDimEq⟩ :=
      weil_isFinite_projective_and_krullDim_over_field k g_Z (hIntZ c) hIntP₁ hProjP₁
        hFin_gZ (e_r c).2
    exact ⟨hProjZ, hDimEq.trans hDimP₁⟩
  have hC_ex : ∀ c : Fin r,
      ∃ (C_c : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ν_c : C_c.left ⟶ Z c)
        (U_c : (Z c).Opens),
        AlgebraicGeometry.IsIntegral C_c.left ∧
        IsProjectiveOverField k C_c ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 C_c.hom ∧
        AlgebraicGeometry.IsFinite ν_c ∧
        AlgebraicGeometry.Surjective ν_c ∧
        (ν_c ≫ ι_Z c) ≫ p_Y₀ = C_c.hom ∧
        Nonempty U_c ∧
        CategoryTheory.IsIso (ν_c ∣_ U_c) := by
    intro c
    obtain ⟨C_c, ν_over, U_c, hIntC, hFinν, _, hSurjν, hUc_ne, hIsoUc, hNormCov⟩ :=
      weil_algClosed_scheme_normalization_finite_birational k (Z_over c) (hIntZ c)
        (hZ_proj_dim c).1
        (fun A _ _ _ _ K _ _ _ => weil_algClosed_finiteType_domain_integralClosure_finite k A K)
    obtain ⟨hProjC, hDimCEq⟩ :=
      weil_isFinite_projective_and_krullDim_over_field k ν_over hIntC (hIntZ c)
        (hZ_proj_dim c).1 hFinν hSurjν
    have hDimC : topologicalKrullDim C_c.left = ((0 + 1 : ℕ) : WithBot ℕ∞) := by
      simpa using hDimCEq.trans (hZ_proj_dim c).2
    obtain ⟨W_reg, hSmW, hDimSing⟩ :=
      weil_affineNormal_scheme_codim2_smooth_open k 0 C_c hIntC hProjC hDimC hNormCov
        (fun d A _ _ _ _ _ hDimA p _ hp =>
          weil_algClosed_integrallyClosed_domain_smooth_away_of_height_le_one k d A hDimA p hp)
    have hW_top : W_reg = ⊤ := by
      rw [eq_top_iff]
      intro x _
      by_contra hx
      let z₀ : ↥((W_reg : Set ↥C_c.left)ᶜ) := ⟨x, hx⟩
      let K₀ : TopologicalSpace.IrreducibleCloseds ↥((W_reg : Set ↥C_c.left)ᶜ) :=
        ⟨closure ({z₀} : Set _), isIrreducible_singleton.closure, isClosed_closure⟩
      let p₀ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥((W_reg : Set ↥C_c.left)ᶜ)) :=
        RelSeries.singleton _ K₀
      have h0_le : (0 : WithBot ℕ∞) ≤ topologicalKrullDim ↥((W_reg : Set ↥C_c.left)ᶜ) :=
        Order.LTSeries.length_le_krullDim p₀
      cases hd : topologicalKrullDim ↥((W_reg : Set ↥C_c.left)ᶜ) with
      | bot =>
        rw [hd] at h0_le
        exact absurd h0_le (by decide)
      | coe a =>
        rw [hd] at hDimSing
        change ((a + 2 : ℕ∞) : WithBot ℕ∞) ≤ (1 : WithBot ℕ∞) at hDimSing
        have ha_le : a + 2 ≤ 1 := WithBot.coe_le_coe.mp hDimSing
        have h2_le : (2 : ℕ∞) ≤ 1 := le_trans le_add_self ha_le
        exact absurd h2_le (by decide)
    rw [hW_top] at hSmW
    have hSmC : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_c.hom := by
      let e_top := C_c.left.topIso
      have h_sq : CategoryTheory.CommSq C_c.hom e_top.inv
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
          ((⊤ : C_c.left.Opens).ι ≫ C_c.hom) := by
        refine ⟨?_⟩
        rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Scheme.topIso_hom, e_top.inv_hom_id,
          CategoryTheory.Category.id_comp]
      have h_pb : CategoryTheory.IsPullback C_c.hom e_top.inv
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
          ((⊤ : C_c.left.Opens).ι ≫ C_c.hom) :=
        CategoryTheory.IsPullback.of_vert_isIso h_sq
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback h_pb.flip hSmW
    have hHom_c : (ν_over.left ≫ ι_Z c) ≫ p_Y₀ = C_c.hom := by
      rw [CategoryTheory.Category.assoc]
      exact CategoryTheory.Over.w ν_over
    exact ⟨C_c, ν_over.left, U_c, hIntC, hProjC, hSmC, hFinν, hSurjν, hHom_c, hUc_ne, hIsoUc⟩
  choose C ν U_c hIntC hProjC hSmC hFinν hSurjν hHomC hUc_ne hIsoUc using hC_ex

  
  let K_other : Fin r → Set ↥Y₀ := fun c =>
    (⋃ j : { j : Fin n // j ≠ (e_r c).1 }, Set.range (ι_W j.1).base) ∪
      (ι_Z c).base '' ((U_c c : Set ↥(Z c))ᶜ)
  have hK_cl : ∀ c : Fin r, IsClosed (K_other c) := by
    intro c
    refine IsClosed.union ?_ ?_
    · refine isClosed_iUnion_of_finite (fun j => ?_)
      have : AlgebraicGeometry.IsClosedImmersion (ι_W j.1) := (hW j.1).2.2
      exact (ι_W j.1).isClosedMap.isClosed_range
    · have : AlgebraicGeometry.IsClosedImmersion (ι_Z c) := hClZ c
      exact (ι_Z c).isClosedMap _ (U_c c).isOpen.isClosed_compl
  let V_comp : Fin r → Y₀.Opens := fun c => ⟨(K_other c)ᶜ, (hK_cl c).isOpen_compl⟩
  let W_open : ∀ c : Fin r, (Z c).Opens :=
    fun c => (TopologicalSpace.Opens.map (ι_Z c).base).obj (V_comp c)

  
  have hW_ne : ∀ c : Fin r, Nonempty ↥(W_open c) := by
    intro c
    by_contra h_empty
    rw [not_nonempty_iff] at h_empty
    have : AlgebraicGeometry.IsIntegral (Z c) := hIntZ c
    have : IrreducibleSpace ↥(Z c) := AlgebraicGeometry.irreducibleSpace_of_isIntegral (Z c)
    have : AlgebraicGeometry.IsClosedImmersion (ι_Z c) := hClZ c
    have hinj : Function.Injective (ι_Z c).base := (ι_Z c).isClosedEmbedding.injective
    let J_c := { j : Fin n // j ≠ (e_r c).1 }
    let A_j : J_c → Set ↥(Z c) := fun j => (ι_Z c).base ⁻¹' Set.range (ι_W j.1).base
    have hAj_cl : ∀ j : J_c, IsClosed (A_j j) := by
      intro j
      have : AlgebraicGeometry.IsClosedImmersion (ι_W j.1) := (hW j.1).2.2
      exact (ι_W j.1).isClosedMap.isClosed_range.preimage (ι_Z c).continuous
    have huniv_sub : (Set.univ : Set ↥(Z c)) ⊆
        (⋃ j ∈ (Finset.univ : Finset J_c), A_j j) ∪ ((U_c c : Set ↥(Z c))ᶜ) := by
      intro z _
      have hz_in_K : (ι_Z c).base z ∈ K_other c := by
        by_contra hz_not_K
        exact h_empty.false ⟨z, hz_not_K⟩
      rcases hz_in_K with h_union | h_img
      · left
        obtain ⟨j, hj⟩ := Set.mem_iUnion.mp h_union
        exact Set.mem_biUnion (Finset.mem_univ j) hj
      · right
        rwa [hinj.mem_set_image] at h_img
    have hU_union_cl : IsClosed (⋃ j ∈ (Finset.univ : Finset J_c), A_j j) :=
      Finset.univ.finite_toSet.isClosed_biUnion (fun j _ => hAj_cl j)
    have h_irr_univ : IsIrreducible (Set.univ : Set ↥(Z c)) :=
      IrreducibleSpace.isIrreducible_univ ↥(Z c)
    rcases (isPreirreducible_iff_isClosed_union_isClosed.mp h_irr_univ.isPreirreducible)
        _ _ hU_union_cl (U_c c).isOpen.isClosed_compl huniv_sub with h_in_J | h_in_Uc
    · have h_fin_ind : ∀ (s : Finset J_c),
          (Set.univ : Set ↥(Z c)) ⊆ (⋃ j ∈ s, A_j j) →
          ∃ j ∈ s, (Set.univ : Set ↥(Z c)) ⊆ A_j j := by
        intro s
        refine Finset.induction_on s ?_ ?_
        · intro h_emp
          obtain ⟨z₀⟩ := (inferInstance : Nonempty ↥(Z c))
          simpa using h_emp (Set.mem_univ z₀)
        · intro j₀ s hj₀ ih hs_sub
          have hs_cl : IsClosed (⋃ j ∈ s, A_j j) :=
            s.finite_toSet.isClosed_biUnion (fun j _ => hAj_cl j)
          have hs_rw : (⋃ j ∈ insert j₀ s, A_j j) = A_j j₀ ∪ (⋃ j ∈ s, A_j j) := by
            ext z; simp
          rw [hs_rw] at hs_sub
          rcases (isPreirreducible_iff_isClosed_union_isClosed.mp h_irr_univ.isPreirreducible)
              _ _ (hAj_cl j₀) hs_cl hs_sub with h1 | h2
          · exact ⟨j₀, Finset.mem_insert_self j₀ s, h1⟩
          · obtain ⟨j, hj_mem, hj_sub⟩ := ih h2
            exact ⟨j, Finset.mem_insert_of_mem hj_mem, hj_sub⟩
      obtain ⟨j, _, hj_sub⟩ := h_fin_ind Finset.univ h_in_J
      apply hIncompW (e_r c).1 j.1 j.2.symm
      rintro y ⟨z, rfl⟩
      exact hj_sub (Set.mem_univ z)
    · obtain ⟨⟨z₀, hz₀⟩⟩ := hUc_ne c
      exact h_in_Uc (Set.mem_univ z₀) hz₀

  
  have hV_sub_range : ∀ c : Fin r, (V_comp c : Set ↥Y₀) ⊆ Set.range (ι_Z c).base := by
    intro c y hy
    have hy_cov : y ∈ ⋃ i : Fin n, Set.range (ι_W i).base := by
      rw [hCovW]; trivial
    obtain ⟨i, hi_mem⟩ := Set.mem_iUnion.mp hy_cov
    by_cases hi : i = (e_r c).1
    · subst hi
      exact hi_mem
    · exfalso
      apply hy
      left
      exact Set.mem_iUnion.mpr ⟨⟨i, hi⟩, hi_mem⟩

  refine ⟨r, C, Z, ι_Z, ν, V_comp, ?_, ?_, ?_⟩
  · 
    intro c
    have : AlgebraicGeometry.IsFinite (ν c) := hFinν c
    refine ⟨hIntC c, hProjC c, hSmC c, hIntZ c, hClZ c, hFinν c, hSurjν c, hHomC c,
      ?_, ?_, ?_⟩
    · obtain ⟨⟨z₀, hz₀⟩⟩ := hW_ne c
      exact ⟨⟨(ι_Z c).base z₀, hz₀⟩⟩
    · rw [AlgebraicGeometry.surjective_iff]
      rintro ⟨y, hy⟩
      obtain ⟨z, rfl⟩ := hV_sub_range c hy
      refine ⟨⟨z, hy⟩, Subtype.ext ?_⟩
      exact AlgebraicGeometry.morphismRestrict_base_coe (ι_Z c) (V_comp c) ⟨z, hy⟩
    · have h_le : W_open c ≤ U_c c := by
        intro z hz
        by_contra hz_not
        apply hz
        right
        exact ⟨z, hz_not, rfl⟩
      let V_sub : (U_c c).toScheme.Opens :=
        (TopologicalSpace.Opens.map (U_c c).ι.base).obj (W_open c)
      have : CategoryTheory.IsIso (ν c ∣_ U_c c) := hIsoUc c
      have : CategoryTheory.IsIso ((ν c ∣_ U_c c) ∣_ V_sub) := inferInstance
      have h_opens_eq : (AlgebraicGeometry.Scheme.Hom.opensFunctor (U_c c).ι).obj V_sub = W_open c := by
        ext z
        change z ∈ (U_c c).ι.base '' ((U_c c).ι.base ⁻¹' (W_open c : Set ↥(Z c))) ↔ z ∈ W_open c
        constructor
        · rintro ⟨⟨w, _⟩, hw_mem, rfl⟩
          exact hw_mem
        · intro hz
          exact ⟨⟨z, h_le hz⟩, hz, rfl⟩
      let e_arr : CategoryTheory.Arrow.mk ((ν c ∣_ U_c c) ∣_ V_sub) ≅
          CategoryTheory.Arrow.mk (ν c ∣_ W_open c) :=
        (AlgebraicGeometry.morphismRestrictRestrict (ν c) (U_c c) V_sub).trans
          (AlgebraicGeometry.morphismRestrictEq (ν c) h_opens_eq)
      have : CategoryTheory.IsIso e_arr.inv.left :=
        (CategoryTheory.Arrow.leftFunc.mapIso e_arr.symm).isIso_hom
      have : CategoryTheory.IsIso e_arr.hom.right :=
        (CategoryTheory.Arrow.rightFunc.mapIso e_arr).isIso_hom
      have h_fac : ν c ∣_ W_open c =
          e_arr.inv.left ≫ ((ν c ∣_ U_c c) ∣_ V_sub) ≫ e_arr.hom.right := by
        have hw := e_arr.inv.w
        dsimp at hw
        calc ν c ∣_ W_open c
            = (ν c ∣_ W_open c) ≫ 𝟙 _ := (CategoryTheory.Category.comp_id _).symm
          _ = (ν c ∣_ W_open c) ≫ (e_arr.inv ≫ e_arr.hom).right := by
              rw [e_arr.inv_hom_id]; rfl
          _ = ((ν c ∣_ W_open c) ≫ e_arr.inv.right) ≫ e_arr.hom.right := by
              rw [CategoryTheory.Arrow.comp_right, CategoryTheory.Category.assoc]
          _ = (e_arr.inv.left ≫ ((ν c ∣_ U_c c) ∣_ V_sub)) ≫ e_arr.hom.right := by
              rw [← hw]
          _ = e_arr.inv.left ≫ ((ν c ∣_ U_c c) ∣_ V_sub) ≫ e_arr.hom.right :=
              CategoryTheory.Category.assoc _ _ _
      rw [h_fac]
      infer_instance
  · 
    intro c₁ c₂ hne
    have h_idx : (e_r c₁).1 ≠ (e_r c₂).1 := by
      intro heq
      exact hne (e_r.injective (Subtype.ext heq))
    have h_disj_range : Disjoint (Set.range (ι_Z c₁).base) (V_comp c₂ : Set ↥Y₀) := by
      rw [Set.disjoint_left]
      intro y hy_range hy_Vc₂
      apply hy_Vc₂
      left
      exact Set.mem_iUnion.mpr ⟨⟨(e_r c₁).1, h_idx⟩, hy_range⟩
    exact ⟨h_disj_range.mono_left (hV_sub_range c₁), h_disj_range⟩
  · 
    let S_bad : Set ↥Y₀ := (⋃ c : Fin r, (V_comp c : Set ↥Y₀))ᶜ
    have hB_each : ∀ i : Fin n,
        (Set.range (ι_W i).base ∩ S_bad).Finite ∧
        ∀ y ∈ Set.range (ι_W i).base ∩ S_bad, IsClosed ({y} : Set ↥Y₀) := by
      intro i
      have : AlgebraicGeometry.IsClosedImmersion (ι_W i) := (hW i).2.2
      by_cases hi : AlgebraicGeometry.Surjective (ι_W i ≫ π₀)
      · let c : Fin r := e_r.symm ⟨i, hi⟩
        have hc_eq : (e_r c).1 = i := by
          dsimp [c]
          rw [e_r.apply_symm_apply]
        have h_range_eq : Set.range (ι_Z c).base = Set.range (ι_W i).base :=
          congrArg (fun j : Fin n => Set.range (ι_W j).base) hc_eq
        let S_c : Set ↥(Z c) := (W_open c : Set ↥(Z c))ᶜ
        have hSc_cl : IsClosed S_c := (W_open c).isOpen.isClosed_compl
        have hSc_ne : S_c ≠ Set.univ := by
          obtain ⟨⟨z₀, hz₀⟩⟩ := hW_ne c
          intro heq
          have : z₀ ∈ S_c := heq ▸ Set.mem_univ z₀
          exact this hz₀
        have : AlgebraicGeometry.IsNoetherian (Z c) := hNoethZ c
        have : AlgebraicGeometry.IsIntegral (Z c) := hIntZ c
        have : IrreducibleSpace ↥(Z c) := AlgebraicGeometry.irreducibleSpace_of_isIntegral (Z c)
        have : AlgebraicGeometry.IsClosedImmersion (ι_Z c) := hClZ c
        obtain ⟨hSc_fin, hSc_pts⟩ := h_s8.1 ↥(Z c) (hZ_proj_dim c).2 S_c hSc_cl hSc_ne
        have hB_sub : Set.range (ι_W i).base ∩ S_bad ⊆ (ι_Z c).base '' S_c := by
          rintro y ⟨hy_r, hy_bad⟩
          rw [← h_range_eq] at hy_r
          obtain ⟨z, rfl⟩ := hy_r
          refine ⟨z, ?_, rfl⟩
          intro hz_W
          apply hy_bad
          exact Set.mem_iUnion.mpr ⟨c, hz_W⟩
        refine ⟨(hSc_fin.image (ι_Z c).base).subset hB_sub, ?_⟩
        intro y hy
        obtain ⟨z, hz, rfl⟩ := hB_sub hy
        have hz_cl : IsClosed ((ι_Z c).base '' ({z} : Set ↥(Z c))) :=
          (ι_Z c).isClosedMap _ (hSc_pts z hz)
        simpa only [Set.image_singleton] using hz_cl
      · let K_i : Set ↥P₁.left := Set.range (ι_W i ≫ π₀).base
        have hKi_cl : IsClosed K_i := (ι_W i ≫ π₀).isClosedMap.isClosed_range
        have hKi_ne : K_i ≠ Set.univ := by
          intro heq
          apply hi
          rw [AlgebraicGeometry.surjective_iff, ← Set.range_eq_univ]
          exact heq
        obtain ⟨hPre_fin, hPre_pts⟩ := h_s8.2 π₀ hDimP₁ K_i hKi_cl hKi_ne
        have hB_sub : Set.range (ι_W i).base ∩ S_bad ⊆ π₀.base ⁻¹' K_i := by
          rintro y ⟨⟨w, rfl⟩, _⟩
          exact ⟨w, (AlgebraicGeometry.Scheme.Hom.comp_apply (ι_W i) π₀ w).symm⟩
        exact ⟨hPre_fin.subset hB_sub, fun y hy => hPre_pts y (hB_sub hy)⟩
    have hS_bad_eq : S_bad = ⋃ i : Fin n, (Set.range (ι_W i).base ∩ S_bad) := by
      ext y
      constructor
      · intro hy
        have hy_cov : y ∈ ⋃ i : Fin n, Set.range (ι_W i).base := by
          rw [hCovW]; trivial
        obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hy_cov
        exact Set.mem_iUnion.mpr ⟨i, hi, hy⟩
      · intro hy
        obtain ⟨i, _, hy_bad⟩ := Set.mem_iUnion.mp hy
        exact hy_bad
    refine ⟨?_, ?_⟩
    · change S_bad.Finite
      rw [hS_bad_eq]
      exact Set.finite_iUnion (fun i => (hB_each i).1)
    · intro y hy
      change y ∈ S_bad at hy
      rw [hS_bad_eq] at hy
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hy
      exact (hB_each i).2 y hi

theorem weil_alt_zero_bdry_excision_and_sheet_trace : (∀ (S : AlgebraicGeometry.Scheme.{u}) (V : S.Opens) (n : ℕ),
      ∃ (K : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (ι : Quiver.Hom K (weilEtaleTorsionSheaf S n)),
        WeilAltIsZeroBdryExact S V n K ι) ∧
    (∀ {Y₀ X₀ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Y₀ X₀)
      [AlgebraicGeometry.IsProper f]
      (V : X₀.Opens) (δ n q : ℕ)
      (K_X : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})
      (ι_X : Quiver.Hom K_X (weilEtaleTorsionSheaf X₀ n))
      (K_Y : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u})
      (ι_Y : Quiver.Hom K_Y (weilEtaleTorsionSheaf Y₀ n))
      (p_q : weilEtaleTorsionH X₀ n q →+ weilEtaleTorsionH Y₀ n q),
      WeilAltIsEtaleSheetSplit δ (f ∣_ V) →
      WeilAltIsZeroBdryExact X₀ V n K_X ι_X →
      WeilAltIsZeroBdryExact Y₀ ((TopologicalSpace.Opens.map f.base).obj V) n K_Y ι_Y →
      WeilAltZeroBdryLerayInjective f q K_Y →
      (IsEmpty ↥(weilAltClosedComplIdeal X₀ V).subscheme ∨
        Subsingleton (weilEtaleTorsionH (weilAltClosedComplIdeal X₀ V).subscheme n q)) →
      (IsEmpty ↥(weilAltClosedComplIdeal Y₀ ((TopologicalSpace.Opens.map f.base).obj V)).subscheme ∨
        ∃ q₀ : ℕ, q₀ + 1 = q ∧
          Subsingleton (weilEtaleTorsionH
            (weilAltClosedComplIdeal Y₀ ((TopologicalSpace.Opens.map f.base).obj V)).subscheme
            n q₀)) →
      WeilIsTorsionEtalePullback f n q p_q →
      ∀ w : weilEtaleTorsionH X₀ n q, p_q w = 0 → δ • w = 0) :=
by
  
  
  
  have hPart2 : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂),
      ∃ (hCont : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology),
        let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback h) AddCommGrpCat.{u} _
          S₂.smallEtaleTopology S₁.smallEtaleTopology hCont
        (∀ (I : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Injective I → CategoryTheory.Injective (P_push.obj I)) ∧
        (∀ (T₂ : S₂.Etale), CategoryTheory.Limits.IsTerminal T₂ →
          Nonempty (CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback h).obj T₂))) := by
    intro S₁ S₂ h
    let P_et : MorphismProperty Scheme.{u} := @Etale
    let B := weilEtaleSitePullback h
    let J₁ := S₁.smallEtaleTopology
    let J₂ := S₂.smallEtaleTopology
    let Fgt₁ := Scheme.Etale.forget S₁
    let Fgt₂ := Scheme.Etale.forget S₂
    have : Limits.PreservesLimits (CategoryTheory.Over.pullback h) :=
      (CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits
    have : Limits.PreservesFiniteLimits (B ⋙ Fgt₁) := by
      change Limits.PreservesFiniteLimits (Fgt₂ ⋙ CategoryTheory.Over.pullback h)
      infer_instance
    have hLimB : Limits.PreservesFiniteLimits B :=
      Limits.preservesFiniteLimits_of_reflects_of_preserves B Fgt₁
    have hFlatB : RepresentablyFlat B := flat_of_preservesFiniteLimits B
    have hContB : B.IsContinuous J₂ J₁ := by
      apply Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat J₁ B)
      refine ⟨fun {V} {R} hR => ?_⟩
      have hJ₂ := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S₂ (le_refl P_et)
      have hJ₁ := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S₁ (le_refl P_et)
      have hR' : R ∈ (Scheme.smallPretopology P_et P_et).toGrothendieck V := by
        change R ∈ Scheme.smallGrothendieckTopology P_et S₂ V at hR
        rwa [hJ₂] at hR
      have hR'' := (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) V R).mp hR'
      suffices hgoal : R.functorPushforward B ∈
          (Scheme.smallPretopology P_et P_et).toGrothendieck (B.obj V) by
        change R.functorPushforward B ∈ Scheme.smallGrothendieckTopology P_et S₁ (B.obj V)
        rwa [hJ₁]
      refine (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et)
        (B.obj V) (R.functorPushforward B)).mpr fun x => ?_
      let v_hom : (Fgt₂.obj V).left ⟶ S₂ := (Fgt₂.obj V).hom
      let fst_V : Limits.pullback v_hom h ⟶ (Fgt₂.obj V).left := Limits.pullback.fst v_hom h
      let snd_V : Limits.pullback v_hom h ⟶ S₁ := Limits.pullback.snd v_hom h
      obtain ⟨Y, f, w, hRf, hf_et, hw⟩ := hR'' (fst_V x)
      let y_hom : (Fgt₂.obj Y).left ⟶ S₂ := (Fgt₂.obj Y).hom
      let f_sch : (Fgt₂.obj Y).left ⟶ (Fgt₂.obj V).left := (Fgt₂.map f).left
