    have hEq : π_push ⋙ I_X = I_Y ⋙ W_π := rfl
    have _ : Limits.PreservesFiniteLimits (π_push ⋙ I_X) := hEq ▸ hComp
    exact Limits.preservesFiniteLimits_of_reflects_of_preserves π_push I_X
  have hSE_push : ∀ (SC : ShortComplex (Sheaf Y.smallEtaleTopology A)),
      SC.ShortExact → (SC.map π_push).ShortExact := by
    intro SC hSE
    have _ : Mono SC.f := hSE.mono_f
    have _ : Epi SC.g := hSE.epi_g
    have hk : Limits.IsLimit (Limits.KernelFork.ofι SC.f SC.zero) := hSE.exact.fIsKernel
    have hk' : Limits.IsLimit (Limits.KernelFork.ofι (SC.map π_push).f (SC.map π_push).zero) :=
