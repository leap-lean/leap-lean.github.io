  have hShortExactOfStalks : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (S : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})),
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
        (S.map ((pt W Ω w).sheafFiber (A := AddCommGrpCat.{u}))).ShortExact) →
      S.ShortExact := by
    intro W S hSE
    have _ : CategoryTheory.Mono S.f := hMonoOfStalks W S.f (fun Ω _ _ w => (hSE Ω w).mono_f)
    have _ : CategoryTheory.Epi S.g := hEpiOfStalks W S.g (fun Ω _ _ w => (hSE Ω w).epi_g)
    let u : S.X₁ ⟶ CategoryTheory.Limits.kernel S.g :=
      CategoryTheory.Limits.kernel.lift S.g S.f S.zero
    have _ : CategoryTheory.IsIso u := by
      apply hIsIsoOfStalks W u
      intro Ω _ _ w
      let Φ := (pt W Ω w).sheafFiber (A := AddCommGrpCat.{u})
      have hSE_w := hSE Ω w
      have _ : CategoryTheory.Mono (Φ.map S.f) := hSE_w.mono_f
      let hc₁ := hSE_w.fIsKernel
      let hom_k : (S.map Φ).X₁ ⟶ CategoryTheory.Limits.kernel (Φ.map S.g) :=
        CategoryTheory.Limits.kernel.lift (Φ.map S.g) (Φ.map S.f)
          (by rw [← Φ.map_comp, S.zero, Φ.map_zero])
      let inv_k : CategoryTheory.Limits.kernel (Φ.map S.g) ⟶ (S.map Φ).X₁ :=
        hc₁.lift (CategoryTheory.Limits.KernelFork.ofι
          (CategoryTheory.Limits.kernel.ι (Φ.map S.g))
          (CategoryTheory.Limits.kernel.condition (Φ.map S.g)))
      have h_inv_fac : inv_k ≫ Φ.map S.f = CategoryTheory.Limits.kernel.ι (Φ.map S.g) :=
        hc₁.fac _ CategoryTheory.Limits.WalkingParallelPair.zero
      let e_lim : (S.map Φ).X₁ ≅ CategoryTheory.Limits.kernel (Φ.map S.g) :=
        { hom := hom_k
          inv := inv_k
          hom_inv_id := (CategoryTheory.cancel_mono (Φ.map S.f)).mp <| by
            rw [CategoryTheory.Category.assoc, h_inv_fac, CategoryTheory.Category.id_comp]
            exact CategoryTheory.Limits.kernel.lift_ι _ _ _
          inv_hom_id :=
            (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι (Φ.map S.g))).mp <| by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι, h_inv_fac,
                CategoryTheory.Category.id_comp] }
      let e_pk : Φ.obj (CategoryTheory.Limits.kernel S.g) ≅
          CategoryTheory.Limits.kernel (Φ.map S.g) :=
        CategoryTheory.asIso (CategoryTheory.Limits.kernelComparison S.g Φ)
      have h_eq : Φ.map u ≫ e_pk.hom = e_lim.hom :=
        (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι (Φ.map S.g))).mp <| by
          dsimp [e_pk]
          rw [CategoryTheory.Category.assoc,
            CategoryTheory.Limits.kernelComparison_comp_ι S.g Φ,
            ← Φ.map_comp, CategoryTheory.Limits.kernel.lift_ι]
          exact (CategoryTheory.Limits.kernel.lift_ι _ _ _).symm
      have h_u : Φ.map u = (e_lim ≪≫ e_pk.symm).hom := by
        dsimp
        rw [← h_eq, CategoryTheory.Category.assoc, e_pk.hom_inv_id, CategoryTheory.Category.comp_id]
      rw [h_u]
      exact (e_lim ≪≫ e_pk.symm).isIso_hom
    have hKer : CategoryTheory.Limits.IsLimit (CategoryTheory.Limits.KernelFork.ofι S.f S.zero) :=
      CategoryTheory.Limits.IsLimit.ofIsoLimit (CategoryTheory.Limits.kernelIsKernel S.g)
        (CategoryTheory.Limits.Fork.ext (CategoryTheory.asIso u).symm
          ((CategoryTheory.IsIso.inv_comp_eq u).mpr
            (CategoryTheory.Limits.kernel.lift_ι S.g S.f S.zero).symm))
    exact { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel S hKer }
  have hZeroStalkToPull : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (K_set : Set ↥Z)
      (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (z : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z),
        Set.range z.base ⊆ K_set →
        CategoryTheory.Limits.IsZero (((pt Z Ω z).sheafFiber (A := AddCommGrpCat.{u})).obj G)) ↔
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (z : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z)
        (G₀ : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
