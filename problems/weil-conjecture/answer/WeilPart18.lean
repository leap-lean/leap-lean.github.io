  choose Φ_X Ψ_X hΦ_X_unit hΨ_X_comm using hModel_X_all

  let L_Y_sh : Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u} :=
    ⟨weilAltLocConstPresheaf Y₀ n, hShL_gen Y₀⟩
  let L0_Y_sh : Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u} :=
    ⟨weilAltZeroBdrySubpresheaf Y₀ V_good n, hSh0_gen Y₀ V_good⟩
  let L_X_sh : ∀ c : Fin r, Sheaf (X c).smallEtaleTopology AddCommGrpCat.{u} :=
