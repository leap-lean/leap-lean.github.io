      have hc_D : Limits.IsLimit c_D := Limits.isLimitOfReflects G hc_G
      exact ⟨c_D, ⟨hc_D⟩, ⟨hc_G⟩⟩
    have _ : ∀ {d₁ d₂ d₃ : D} {u₁ : d₁ ⟶ d₃} {u₂ : d₂ ⟶ d₃},
        Limits.HasLimit (Limits.cospan u₁ u₂) := by
