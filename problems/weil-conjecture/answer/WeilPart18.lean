      @AlgebraicGeometry.Etale
    obtain ⟨𝒰, hCovOver, hEt_j, hle⟩ :=
      (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology (P := P_et) E R).mp hR
    let _ := hCovOver
    obtain ⟨hSurj_𝒰, hEt_f⟩ :=
      (AlgebraicGeometry.Scheme.presieve₀_mem_precoverage_iff 𝒰.toPreZeroHypercover).mp 𝒰.mem₀
    obtain ⟨j, y₀, hy₀⟩ := hSurj_𝒰 (e.1.base default)
    let Y : W.Etale := (𝒰.X j).asOverProp W (hEt_j j)
    let u : Y ⟶ E :=
      AlgebraicGeometry.Scheme.Hom.asOverProp (𝒰.f j) W (hX := hEt_j j) (hY := E.prop)
    have hInPresieve : (𝒰.toPresieveOverProp hEt_j) u :=
      CategoryTheory.Presieve.ofArrows.mk j
    have hRu : R.arrows u := hle Y u hInPresieve
    let uL : Y.left ⟶ E.left := 𝒰.f j
    let eL : S_Ω ⟶ E.left := e.1
    have : AlgebraicGeometry.Etale uL := hEt_f j
    let P := CategoryTheory.Limits.pullback uL eL
    let q : P ⟶ S_Ω := CategoryTheory.Limits.pullback.snd uL eL
    have : AlgebraicGeometry.Surjective q := ⟨fun pt₀ => by
      have hpt : pt₀ = default := Unique.eq_default pt₀
      subst hpt
      obtain ⟨z, -, hz₂⟩ :=
        @AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback _ _ _ uL eL y₀ default hy₀
      exact ⟨z, hz₂⟩⟩
    obtain ⟨σ, hσ⟩ := hLiftEt q Ω (𝟙 S_Ω)
    let eY : S_Ω ⟶ Y.left := σ ≫ CategoryTheory.Limits.pullback.fst uL eL
    have heY_u : eY ≫ u.left = eL := by
      change eY ≫ uL = eL
      dsimp [eY]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, hσ, CategoryTheory.Category.id_comp]
    have heY_w : eY ≫ Y.hom = w :=
      ((congrArg (eY ≫ ·) (CategoryTheory.MorphismProperty.Over.w u).symm).trans
        (CategoryTheory.Category.assoc eY u.left E.hom).symm).trans
        ((congrArg (· ≫ E.hom) heY_u).trans e.2)
    exact ⟨Y, u, hRu, ⟨eY, heY_w⟩, Subtype.ext heY_u⟩
  have hPtCof : ∀ (W : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
      CategoryTheory.IsCofiltered ((fibOf W Ω w).Elements) := by
    intro W Ω _ _ w
    have : CategoryTheory.IsCofilteredOrEmpty ((fibOf W Ω w).Elements) :=
      { cone_objs := fun X₁ X₂ => by
          let E₁ := X₁.1
          let e₁ := X₁.2.1
          have he₁ := X₁.2.2
          let E₂ := X₂.1
          let e₂ := X₂.2.1
          have he₂ := X₂.2.2
          let hE₁ : E₁.left ⟶ W := E₁.hom
          let hE₂ : E₂.left ⟶ W := E₂.hom
          have : AlgebraicGeometry.Etale hE₁ := E₁.prop
          have : AlgebraicGeometry.Etale hE₂ := E₂.prop
          let P := CategoryTheory.Limits.pullback hE₁ hE₂
          let p₁ : P ⟶ E₁.left := CategoryTheory.Limits.pullback.fst hE₁ hE₂
          let p₂ : P ⟶ E₂.left := CategoryTheory.Limits.pullback.snd hE₁ hE₂
          have : AlgebraicGeometry.Etale p₁ := inferInstance
          let E₃ : W.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ hE₁)
            (inferInstance : AlgebraicGeometry.Etale (p₁ ≫ hE₁))
          let u₁ : E₃ ⟶ E₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl
          let u₂ : E₃ ⟶ E₂ := CategoryTheory.MorphismProperty.Over.homMk p₂
            (CategoryTheory.Limits.pullback.condition (f := hE₁) (g := hE₂)).symm
          let e₃ := CategoryTheory.Limits.pullback.lift e₁ e₂ (he₁.trans he₂.symm)
          have he₃ : e₃ ≫ E₃.hom = w := by
            change e₃ ≫ (p₁ ≫ hE₁) = w
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
            exact he₁
          let X₃ : (fibOf W Ω w).Elements := (fibOf W Ω w).elementsMk E₃ ⟨e₃, he₃⟩
          have hu₁ : (fibOf W Ω w).map u₁ X₃.2 = X₁.2 :=
            Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          have hu₂ : (fibOf W Ω w).map u₂ X₃.2 = X₂.2 :=
            Subtype.ext (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          exact ⟨X₃, ⟨u₁, hu₁⟩, ⟨u₂, hu₂⟩, trivial⟩
        cone_maps := fun {X₁ X₂} f₁ f₂ => by
          let E₁ := X₁.1
          let e₁ := X₁.2.1
          have he₁ := X₁.2.2
          let E₂ := X₂.1
          let e₂ := X₂.2.1
          let hE₁ : E₁.left ⟶ W := E₁.hom
          let hE₂ : E₂.left ⟶ W := E₂.hom
          let g₁ : E₁.left ⟶ E₂.left := f₁.1.left
          let g₂ : E₁.left ⟶ E₂.left := f₂.1.left
          have : AlgebraicGeometry.Etale hE₁ := E₁.prop
          have : AlgebraicGeometry.Etale hE₂ := E₂.prop
          let Δ : E₂.left ⟶ CategoryTheory.Limits.pullback hE₂ hE₂ :=
            CategoryTheory.Limits.pullback.diagonal hE₂
          have : AlgebraicGeometry.IsOpenImmersion Δ :=
            AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal hE₂
          have : AlgebraicGeometry.Etale Δ := inferInstance
          have hg_w : g₁ ≫ hE₂ = g₂ ≫ hE₂ :=
            (CategoryTheory.MorphismProperty.Over.w f₁.1).trans
              (CategoryTheory.MorphismProperty.Over.w f₂.1).symm
          let φ : E₁.left ⟶ CategoryTheory.Limits.pullback hE₂ hE₂ :=
            CategoryTheory.Limits.pullback.lift g₁ g₂ hg_w
          let P := CategoryTheory.Limits.pullback φ Δ
          let p : P ⟶ E₁.left := CategoryTheory.Limits.pullback.fst φ Δ
          have : AlgebraicGeometry.Etale p := inferInstance
          let E' : W.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (p ≫ hE₁)
            (inferInstance : AlgebraicGeometry.Etale (p ≫ hE₁))
          let u : E' ⟶ E₁ := CategoryTheory.MorphismProperty.Over.homMk p rfl
          have he_comm : e₁ ≫ φ = e₂ ≫ Δ := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
                CategoryTheory.Category.comp_id]
              exact congrArg Subtype.val f₁.2
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
                CategoryTheory.Category.comp_id]
              exact congrArg Subtype.val f₂.2
          let e' := CategoryTheory.Limits.pullback.lift e₁ e₂ he_comm
          have he' : e' ≫ E'.hom = w := by
            change e' ≫ (p ≫ hE₁) = w
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
            exact he₁
          let X' : (fibOf W Ω w).Elements := (fibOf W Ω w).elementsMk E' ⟨e', he'⟩
          have hu : (fibOf W Ω w).map u X'.2 = X₁.2 :=
            Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          refine ⟨X', ⟨u, hu⟩, ?_⟩
          ext
          apply hEtHomExt
          change p ≫ g₁ = p ≫ g₂
          have hq₁ : p ≫ g₁ = CategoryTheory.Limits.pullback.snd φ Δ := by
            calc
              p ≫ g₁ = p ≫ (φ ≫ CategoryTheory.Limits.pullback.fst hE₂ hE₂) := by
                rw [CategoryTheory.Limits.pullback.lift_fst]
              _ = (p ≫ φ) ≫ CategoryTheory.Limits.pullback.fst hE₂ hE₂ := by
                rw [CategoryTheory.Category.assoc]
              _ = (CategoryTheory.Limits.pullback.snd φ Δ ≫ Δ) ≫
                  CategoryTheory.Limits.pullback.fst hE₂ hE₂ := by
                rw [CategoryTheory.Limits.pullback.condition]
              _ = CategoryTheory.Limits.pullback.snd φ Δ := by
                rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
                  CategoryTheory.Category.comp_id]
          have hq₂ : p ≫ g₂ = CategoryTheory.Limits.pullback.snd φ Δ := by
            calc
              p ≫ g₂ = p ≫ (φ ≫ CategoryTheory.Limits.pullback.snd hE₂ hE₂) := by
                rw [CategoryTheory.Limits.pullback.lift_snd]
              _ = (p ≫ φ) ≫ CategoryTheory.Limits.pullback.snd hE₂ hE₂ := by
                rw [CategoryTheory.Category.assoc]
              _ = (CategoryTheory.Limits.pullback.snd φ Δ ≫ Δ) ≫
                  CategoryTheory.Limits.pullback.snd hE₂ hE₂ := by
                rw [CategoryTheory.Limits.pullback.condition]
              _ = CategoryTheory.Limits.pullback.snd φ Δ := by
                rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
                  CategoryTheory.Category.comp_id]
          exact hq₁.trans hq₂.symm }
    exact { toIsCofilteredOrEmpty := inferInstance
            nonempty := ⟨(fibOf W Ω w).elementsMk (AlgebraicGeometry.Scheme.Etale.mk (𝟙 W))
              ⟨w, CategoryTheory.Category.comp_id w⟩⟩ }
  have hPtSmall : ∀ (W : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
      CategoryTheory.InitiallySmall.{u} ((fibOf W Ω w).Elements) := by
    intro W Ω _ _ w
    have := hPtCof W Ω w
    let ι_aff : W.AffineEtale ⥤ W.Etale := AlgebraicGeometry.Scheme.AffineEtale.Spec W
    let e_sm := CategoryTheory.equivSmallModel.{u} W.AffineEtale
    let Idx : Type u :=
      Σ (M : CategoryTheory.SmallModel.{u} W.AffineEtale),
        (fibOf W Ω w).obj (ι_aff.obj (e_sm.inverse.obj M))
    let emb : Idx → (fibOf W Ω w).Elements :=
      fun p => (fibOf W Ω w).elementsMk (ι_aff.obj (e_sm.inverse.obj p.1)) p.2
    have : Small.{u} ↑(Set.range emb) := small_range emb
    refine CategoryTheory.initiallySmall_of_small_weakly_initial_set (Set.range emb) ?_
    intro X_el
    let E := X_el.1
    let e := X_el.2
    have hcov : CategoryTheory.Sieve.coverByImage ι_aff E ∈ W.smallEtaleTopology E :=
      CategoryTheory.Functor.IsCoverDense.is_cover (G := ι_aff) (K := W.smallEtaleTopology) E
    obtain ⟨Y, u, hu_cov, eY, heY⟩ := hPtJoint W Ω w _ hcov e
    rcases hu_cov with ⟨U_aff, f₁, f₂, rfl⟩
    let M : CategoryTheory.SmallModel.{u} W.AffineEtale := e_sm.functor.obj U_aff
    let isoM : ι_aff.obj (e_sm.inverse.obj M) ≅ ι_aff.obj U_aff :=
      ι_aff.mapIso (e_sm.unitIso.symm.app U_aff)
    let eM : (fibOf W Ω w).obj (ι_aff.obj (e_sm.inverse.obj M)) :=
      (fibOf W Ω w).map isoM.inv ((fibOf W Ω w).map f₁ eY)
    refine ⟨emb ⟨M, eM⟩, ⟨⟨M, eM⟩, rfl⟩, ⟨⟨isoM.hom ≫ f₂, ?_⟩⟩⟩
    change ((fibOf W Ω w).map (isoM.hom ≫ f₂)) eM = e
    have hcomp1 : ((fibOf W Ω w).map (isoM.hom ≫ f₂)) eM =
        ((fibOf W Ω w).map f₂) (((fibOf W Ω w).map isoM.hom)
          (((fibOf W Ω w).map isoM.inv) (((fibOf W Ω w).map f₁) eY))) := by
      rw [CategoryTheory.Functor.map_comp]
      rfl
    rw [hcomp1]
    have hcomp2 : ((fibOf W Ω w).map isoM.hom)
        (((fibOf W Ω w).map isoM.inv) (((fibOf W Ω w).map f₁) eY)) =
        ((fibOf W Ω w).map f₁) eY := by
      change (((fibOf W Ω w).map isoM.inv ≫ (fibOf W Ω w).map isoM.hom))
        (((fibOf W Ω w).map f₁) eY) = _
      rw [← CategoryTheory.Functor.map_comp, isoM.inv_hom_id, CategoryTheory.Functor.map_id]
      rfl
    rw [hcomp2]
    change (((fibOf W Ω w).map f₁ ≫ (fibOf W Ω w).map f₂)) eY = e
    rw [← CategoryTheory.Functor.map_comp]
    exact heY
  let pt : ∀ (W : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W) →
        CategoryTheory.GrothendieckTopology.Point.{u} W.smallEtaleTopology :=
    fun W Ω _ _ w =>
      CategoryTheory.GrothendieckTopology.Point.mk (fibOf W Ω w)
        (hPtCof W Ω w) (hPtSmall W Ω w) (fun R hR e => hPtJoint W Ω w R hR e)
  
  have hVanIff : ∀ (W : AlgebraicGeometry.Scheme.{u}) (D : TopologicalSpace.Closeds ↥W)
      (G : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (V : AlgebraicGeometry.Scheme.{u}) (v : V ⟶ W) [AlgebraicGeometry.Etale v],
        Set.range v.base ⊆ (D : Set ↥W)ᶜ →
        Subsingleton ↥(G.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk v)))) ↔
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
        (∀ pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
          w.base pt₀ ∉ (D : Set ↥W)) →
        CategoryTheory.Limits.IsZero
          (((pt W Ω w).sheafFiber :
            CategoryTheory.Functor
              (CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
              AddCommGrpCat.{u}).obj G)) := by
    intro W D G
    constructor
    · intro hSub Ω _ _ w hw
      let Φ := pt W Ω w
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      change CategoryTheory.CategoryStruct.id (Φ.presheafFiber.obj G.obj) = 0
      apply Φ.presheafFiber_hom_ext
      intro E e
      rw [CategoryTheory.Category.comp_id, CategoryTheory.Limits.comp_zero]
      let U_D : W.Opens := ⟨(D : Set ↥W)ᶜ, D.isClosed.isOpen_compl⟩
      have hw_range : Set.range w.base ⊆ Set.range U_D.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨pt₀, rfl⟩
        exact hw pt₀
      let w_U := AlgebraicGeometry.IsOpenImmersion.lift U_D.ι w hw_range
      let E_D : W.Etale := AlgebraicGeometry.Scheme.Etale.mk U_D.ι
      let e_D : Φ.fiber.obj E_D := ⟨w_U, AlgebraicGeometry.IsOpenImmersion.lift_fac U_D.ι w hw_range⟩
      have : CategoryTheory.IsCofiltered Φ.fiber.Elements := hPtCof W Ω w
      obtain ⟨X', u₁, u₂, -⟩ :=
        CategoryTheory.IsCofilteredOrEmpty.cone_objs (Φ.fiber.elementsMk E e)
          (Φ.fiber.elementsMk E_D e_D)
      let V' : AlgebraicGeometry.Scheme.{u} := X'.1.left
      let v' : V' ⟶ W := X'.1.hom
      have hv' : AlgebraicGeometry.Etale v' := X'.1.prop
      let E'_mk : W.Etale := @AlgebraicGeometry.Scheme.Etale.mk W V' v' hv'
      let homMkE : E'_mk ⟶ X'.1 :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 V') (CategoryTheory.Category.id_comp v')
      let u'₁ : E'_mk ⟶ E := homMkE ≫ u₁.1
      let e'_mk : Φ.fiber.obj E'_mk := X'.2
      have he_eq : (Φ.fiber.map u'₁) e'_mk = e := by
        apply Subtype.ext
        have hu₁_val : X'.2.1 ≫ u₁.1.left = e.1 := congrArg Subtype.val u₁.2
        change X'.2.1 ≫ (𝟙 V' ≫ u₁.1.left) = e.1
        rw [CategoryTheory.Category.id_comp]
        exact hu₁_val
      rw [← he_eq, ← Φ.toPresheafFiber_w u'₁ e'_mk G.obj]
      let u₂L : V' ⟶ (U_D : AlgebraicGeometry.Scheme.{u}) := u₂.1.left
      have hv'_range : Set.range v'.base ⊆ (D : Set ↥W)ᶜ := by
        rintro _ ⟨z, rfl⟩
        have hz_eq : v'.base z = U_D.ι.base (u₂L.base z) := by
          have hw_u₂ : u₂L ≫ U_D.ι = v' := CategoryTheory.MorphismProperty.Over.w u₂.1
          exact (congrArg (fun k : V' ⟶ W => k.base z) hw_u₂).symm
        rw [hz_eq]
        exact (u₂L.base z).2
      have hSubV' : Subsingleton ↥(G.obj.obj (Opposite.op E'_mk)) :=
        @hSub V' v' hv' hv'_range
      have hToZero : Φ.toPresheafFiber E'_mk e'_mk G.obj = 0 := by
        ext z
        have hz0 : z = 0 := @Subsingleton.elim _ hSubV' z 0
        rw [hz0, map_zero]
        rfl
      rw [hToZero, CategoryTheory.Limits.comp_zero]
    · intro hStalkZero V v hvE hv_range
      let E : W.Etale := AlgebraicGeometry.Scheme.Etale.mk v
      refine subsingleton_of_forall_eq 0 (fun s => ?_)
      let R_s : CategoryTheory.Sieve E :=
        { arrows := fun Y u => (G.obj.map u.op) s = 0
          downward_closed := fun {Y Z} u hu f => by
            dsimp at hu ⊢
            rw [CategoryTheory.Functor.map_comp]
            change (G.obj.map f.op) ((G.obj.map u.op) s) = 0
            rw [hu, map_zero] }
      have hPointCover : ∀ (x : ↥V),
          ∃ (Y : W.Etale) (u : Y ⟶ E), R_s.arrows u ∧ x ∈ Set.range u.left.base := by
        intro x
        let κ_x := V.residueField x
        let Ω_x : Type u := AlgebraicClosure ↥κ_x
        let xbar_V : AlgebraicGeometry.Spec (CommRingCat.of Ω_x) ⟶ V :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥κ_x Ω_x)) ≫
            V.fromSpecResidueField x
        have hxbar_pt : ∀ pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω_x)),
            xbar_V.base pt₀ = x := by
          intro pt₀
          dsimp [xbar_V]
          exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply x _
        have hxbar_out : ∀ pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω_x)),
            (xbar_V ≫ v).base pt₀ ∉ (D : Set ↥W) := by
          intro pt₀
          change v.base (xbar_V.base pt₀) ∉ (D : Set ↥W)
          exact hv_range ⟨xbar_V.base pt₀, rfl⟩
        let Φ_x := pt W Ω_x (xbar_V ≫ v)
        have hZero_x := hStalkZero Ω_x (xbar_V ≫ v) hxbar_out
        have hSub_x : Subsingleton ↥(Φ_x.presheafFiber.obj G.obj) := hSubOfZero hZero_x
        let e_x : Φ_x.fiber.obj E := ⟨xbar_V, rfl⟩
        have hEqStalk : (Φ_x.toPresheafFiber E e_x G.obj) s =
            (Φ_x.toPresheafFiber E e_x G.obj) 0 :=
          @Subsingleton.elim _ hSub_x _ _
        obtain ⟨Y, u, eY, heY, hmap_eq⟩ :=
          (Φ_x.toPresheafFiber_eq_iff' E e_x s 0).mp hEqStalk
        rw [map_zero] at hmap_eq
        refine ⟨Y, u, hmap_eq, eY.1.base default, ?_⟩
        have hcomp_eq : eY.1 ≫ u.left = xbar_V := congrArg Subtype.val heY
        exact (congrArg (fun k : AlgebraicGeometry.Spec (CommRingCat.of Ω_x) ⟶ V =>
          k.base default) hcomp_eq).trans (hxbar_pt default)
      choose Y_x u_x hRs_x hMem_x using hPointCover
      let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Etale
      have hEt_ux : ∀ x : ↥V, AlgebraicGeometry.Etale (u_x x).left := fun x =>
        CategoryTheory.MorphismProperty.of_postcomp P_et (u_x x).left v hvE
          ((congrArg (fun k : (Y_x x).left ⟶ W => P_et k)
            (CategoryTheory.MorphismProperty.Over.w (u_x x))).mpr (Y_x x).prop)
      let 𝒰₀ : CategoryTheory.PreZeroHypercover.{u} E.left :=
        { I₀ := ↥V
          X := fun x => (Y_x x).left
          f := fun x => (u_x x).left }
      have hmem₀ : 𝒰₀.presieve₀ ∈ (AlgebraicGeometry.Scheme.precoverage P_et).coverings E.left :=
        (AlgebraicGeometry.Scheme.presieve₀_mem_precoverage_iff 𝒰₀).mpr
          ⟨fun x => by
            obtain ⟨y, hy⟩ := hMem_x x
            exact ⟨x, y, hy⟩,
           fun x => hEt_ux x⟩
      have hRs_mem : R_s ∈ W.smallEtaleTopology E := by
        refine (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology (P := P_et) E R_s).mpr ?_
        let covOv := @AlgebraicGeometry.Scheme.Cover.Over.mk W P_et _ _ E.left _
          { toPreZeroHypercover := 𝒰₀, mem₀ := hmem₀ }
          (fun j => ⟨(Y_x j).hom⟩)
          (fun j => ⟨CategoryTheory.MorphismProperty.Over.w (u_x j)⟩)
        refine ⟨{ toPreZeroHypercover := 𝒰₀, mem₀ := hmem₀ }, covOv,
          fun j => (Y_x j).prop, ?_⟩
        intro Z g hg
        rcases hg with ⟨x⟩
        refine Eq.mp (congrArg (@CategoryTheory.Sieve.arrows _ _ _ R_s (Y_x x)) ?_) (hRs_x x)
        exact hEtHomExt rfl
      exact CategoryTheory.Sheaf.isSeparated G E R_s hRs_mem s 0 (fun Y u hu => by
        rw [map_zero]
        exact hu)
  have hCons : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (G : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
        CategoryTheory.Limits.IsZero
          (((pt W Ω w).sheafFiber :
            CategoryTheory.Functor
              (CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
              AddCommGrpCat.{u}).obj G)) →
      CategoryTheory.Limits.IsZero G := by
    intro W G hAll
    have hSubAll := (hVanIff W ⊥ G).mpr (fun Ω _ _ w _ => hAll Ω w)
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply CategoryTheory.Sheaf.hom_ext
    ext E : 2
    rcases E with ⟨⟨⟨V, ⟨⟨⟩⟩, v⟩, hv⟩⟩
    have hSubV : Subsingleton ↥(G.obj.obj
        (Opposite.op (@AlgebraicGeometry.Scheme.Etale.mk W V v hv))) :=
      @hSubAll V v hv (by simp)
    ext x
    exact @Subsingleton.elim _ hSubV _ _
  
  have hPiReindex : ∀ (I₁ I₂ : Type u) (e : I₁ ≃ I₂) (M : AddCommGrpCat.{u}),
      ∃ iso : (∏ᶜ fun _ : I₁ => M) ≅ (∏ᶜ fun _ : I₂ => M),
        (∀ i₂ : I₂, iso.hom ≫ CategoryTheory.Limits.Pi.π (fun _ : I₂ => M) i₂ =
          CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (e.symm i₂)) ∧
        (∀ i₁ : I₁, iso.inv ≫ CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) i₁ =
          CategoryTheory.Limits.Pi.π (fun _ : I₂ => M) (e i₁)) := by
    intro I₁ I₂ e M
    refine ⟨{ hom := CategoryTheory.Limits.Pi.lift (fun i₂ =>
                CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (e.symm i₂))
              inv := CategoryTheory.Limits.Pi.lift (fun i₁ =>
                CategoryTheory.Limits.Pi.π (fun _ : I₂ => M) (e i₁))
              hom_inv_id := CategoryTheory.Limits.Pi.hom_ext _ _ (fun i₁ => by
                simp [e.symm_apply_apply])
              inv_hom_id := CategoryTheory.Limits.Pi.hom_ext _ _ (fun i₂ => by
                simp [e.apply_symm_apply]) },
      fun i₂ => by simp,
      fun i₁ => by simp⟩
  have hFibPb : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (hc : (weilCompEtaleSitePullback h).IsContinuous
