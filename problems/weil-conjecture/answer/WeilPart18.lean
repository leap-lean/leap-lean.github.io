      have hδ₅_nil : ∀ g : B, lam0_K (δ₅ g) ∈ nilradical B_K := by
        intro g; apply nil_of_π_zero
        dsimp [δ₅]
        split_ifs with hg
        · funext k
          rw [map_sub, map_pow, map_sum, Pi.sub_apply, Pi.pow_apply, Finset.sum_apply, Pi.zero_apply]
          have hg_k : π_L ((1 : R₀) ⊗ₜ[R] g) k = g_coord k g := by
            have h1 : lam0_K ((1 : R₀) ⊗ₜ[R] g) = (1 : K) ⊗ₜ[R] g := by
              rw [Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply]
