          Polynomial.eval₂ e_kκ.symm.toRingHom r₀ p_κ := by
        change e_kκ.symm.toRingHom (Polynomial.eval₂ (RingHom.id κ) (e_kκ r₀) p_κ) = _
        rw [Polynomial.hom_eval₂]
        simp
