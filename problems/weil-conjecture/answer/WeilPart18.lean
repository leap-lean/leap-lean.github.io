      let δ₁ : I → B₀ := fun i => w₀ i * w₀ i - w₀ i
      have hδ₁_nil : ∀ i : I, lam0_K (δ₁ i) ∈ nilradical B_K := by
        intro i; apply nil_of_π_zero
        funext k
        simp only [δ₁, map_sub, map_mul, Pi.sub_apply, Pi.mul_apply, Pi.zero_apply, hπ_w i]
        by_cases hk : k = i
        · subst hk; simp
        · simp [Pi.single_eq_of_ne hk]
      let δ₂ : I → I → B₀ := fun i j => if i = j then 0 else w₀ i * w₀ j
      have hδ₂_nil : ∀ i j : I, lam0_K (δ₂ i j) ∈ nilradical B_K := by
        intro i j; apply nil_of_π_zero
        dsimp [δ₂]
        split_ifs with hij
        · exact map_zero _
        · funext k
          simp only [map_mul, Pi.mul_apply, Pi.zero_apply, hπ_w i, hπ_w j]
          by_cases hk : k = i
          · subst hk; simp [Pi.single_eq_of_ne hij]
          · simp [Pi.single_eq_of_ne hk]
      let δ₃ : B₀ := 1 - ∑ i : I, w₀ i
      have hδ₃_nil : lam0_K δ₃ ∈ nilradical B_K := by
        apply nil_of_π_zero
        funext k
        simp only [δ₃, map_sub, map_one, map_sum, Pi.sub_apply, Pi.one_apply,
          Finset.sum_apply, Pi.zero_apply, hπ_w]
        rw [Finset.sum_eq_single k]
        · simp
        · intro j _ hjk; simp [Pi.single_eq_of_ne (Ne.symm hjk)]
        · intro hk_abs; exact absurd (Finset.mem_univ k) hk_abs
      let δ₄ : I → B₀ := fun i => w₀ i * Polynomial.aeval (a₀ i) (P₀ i)
      have hδ₄_nil : ∀ i : I, lam0_K (δ₄ i) ∈ nilradical B_K := by
        intro i; apply nil_of_π_zero
        funext k
        by_cases hki : k = i
        · subst hki
          rw [hπ_aeval_same k (P₀ k), hP₀ k, hPK_aeval k, Pi.zero_apply]
        · rw [hπ_aeval_ne i k (P₀ i) hki, Pi.zero_apply]
