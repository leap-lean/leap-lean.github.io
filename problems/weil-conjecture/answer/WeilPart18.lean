      let ρ : R₀ →+* R_h := IsLocalization.Away.lift (S := R₀)
        (g := algebraMap R R_h) h₀ hUnit_h₀_Rh
      have hρ_comp : ρ.comp (algebraMap R R₀) = algebraMap R R_h := by
        ext r
        exact IsLocalization.Away.lift_eq (S := R₀) (g := algebraMap R R_h)
          (x := h₀) hUnit_h₀_Rh r
      let ρ_alg : R₀ →ₐ[R] R_h := { ρ with commutes' := RingHom.congr_fun hρ_comp }
      let μ_h : B₀ →ₐ[R] B_h := Algebra.TensorProduct.map ρ_alg (AlgHom.id R B)
      let q_h : B_h →ₐ[R_h] D_h := Ideal.Quotient.mkₐ R_h (nilradical B_h)
      let ν_h : B₀ →+* D_h := q_h.toRingHom.comp μ_h.toRingHom
      have hν_zero_of_nil : ∀ z : B₀, μ_h z ∈ nilradical B_h → ν_h z = 0 :=
        fun _ hz => Ideal.Quotient.eq_zero_iff_mem.mpr hz
      have hdvd_t₃ : t₃ ∣ h := ⟨h₀ * (∏ i : I, (t₁ i * t₄ i)) * (∏ p : I × I, t₂ p) * (∏ g ∈ G, t₅ g),
        by dsimp [h]; ring⟩
      have hdvd_t₁ : ∀ i : I, t₁ i ∣ h := fun i =>
        dvd_trans (dvd_mul_right (t₁ i) (t₄ i))
          (dvd_trans (Finset.dvd_prod_of_mem (fun k => t₁ k * t₄ k) (Finset.mem_univ i))
            ⟨h₀ * t₃ * (∏ p : I × I, t₂ p) * (∏ g ∈ G, t₅ g), by dsimp [h]; ring⟩)
      have hdvd_t₄ : ∀ i : I, t₄ i ∣ h := fun i =>
        dvd_trans (dvd_mul_left (t₄ i) (t₁ i))
          (dvd_trans (Finset.dvd_prod_of_mem (fun k => t₁ k * t₄ k) (Finset.mem_univ i))
            ⟨h₀ * t₃ * (∏ p : I × I, t₂ p) * (∏ g ∈ G, t₅ g), by dsimp [h]; ring⟩)
      have hdvd_t₂ : ∀ i j : I, t₂ (i, j) ∣ h := fun i j =>
        dvd_trans (Finset.dvd_prod_of_mem t₂ (Finset.mem_univ (i, j)))
          ⟨h₀ * t₃ * (∏ k : I, (t₁ k * t₄ k)) * (∏ g ∈ G, t₅ g), by dsimp [h]; ring⟩
      have hdvd_t₅ : ∀ g ∈ G, t₅ g ∣ h := fun g hg =>
        dvd_trans (Finset.dvd_prod_of_mem t₅ hg)
          ⟨h₀ * t₃ * (∏ k : I, (t₁ k * t₄ k)) * (∏ p : I × I, t₂ p), by dsimp [h]; ring⟩
      let w_bar : I → D_h := fun i => ν_h (w₀ i)
      let a_bar : I → D_h := fun i => ν_h (a₀ i)
      let P : I → Polynomial R_h := fun i => (P₀ i).map ρ
      let Q_h : I → B → Polynomial R_h := fun i g => (Q₀ i g).map ρ
      have hP_monic_sep : ∀ i : I, (P i).Monic ∧ (P i).Separable := by
        intro i
        refine ⟨(hP₀_monic i).map ρ, ?_⟩
        rw [Polynomial.separable_def]
        refine ⟨(u₀ i).map ρ, (v₀ i).map ρ, ?_⟩
        have hmap := congrArg (Polynomial.map ρ) (hBezout₀ i)
        simpa [P, Polynomial.map_add, Polynomial.map_mul, Polynomial.derivative_map,
          Polynomial.map_one] using hmap
