      CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf C.left.smallEtaleTopology Q_div.obj
        (CategoryTheory.forget AddCommGrpCat.{u}) Q_div.property

    let yHom : ∀ (Y : C.left.Etale), (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ C.left :=
      fun Y => Y.hom

    have hOpen_W₁ : AlgebraicGeometry.IsOpenImmersion W₁.ι := inferInstance
    have hOpen_W₁₂ : AlgebraicGeometry.IsOpenImmersion W₁₂.ι := inferInstance

    let liftW₁ : ∀ (Y : C.left.Etale),
        Set.range (yHom Y).base ⊆ Set.range W₁.ι.base → (Y ⟶ V₁) :=
      fun Y hY₁ =>
        let l : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ (W₁ : AlgebraicGeometry.Scheme.{u}) :=
          @AlgebraicGeometry.IsOpenImmersion.lift _ _ _ W₁.ι (yHom Y) hOpen_W₁ hY₁
        have hl : l ≫ W₁.ι = yHom Y :=
          @AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _ W₁.ι (yHom Y) hOpen_W₁ hY₁
        CategoryTheory.MorphismProperty.Over.homMk l hl

    have hliftW₁_fac : ∀ (Y : C.left.Etale)
        (hY₁ : Set.range (yHom Y).base ⊆ Set.range W₁.ι.base),
        ((liftW₁ Y hY₁).left :
          (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ (W₁ : AlgebraicGeometry.Scheme.{u})) ≫
          W₁.ι = yHom Y :=
      fun Y hY₁ =>
        @AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _ W₁.ι (yHom Y) hOpen_W₁ hY₁

    let x_el : CategoryTheory.Presieve.FamilyOfElements
        (Q_div.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) R_cov.arrows :=
      fun Y _ _ =>
        if hY₁ : Set.range (yHom Y).base ⊆ Set.range W₁.ι.base then
          (Q_div.obj.map (liftW₁ Y hY₁).op).hom q₁_sec
        else 0

    have hx_W₂ : ∀ (Y : C.left.Etale) (f : Y ⟶ T_X) (hf : R_cov.arrows f),
        Set.range (yHom Y).base ⊆ Set.range W₂.ι.base → x_el f hf = 0 := by
      intro Y f hf hY₂
      dsimp only [x_el]
      split_ifs with hY₁
      · have hY₁₂ : Set.range (yHom Y).base ⊆ Set.range W₁₂.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hY₁ hY₂ ⊢
          exact Set.subset_inter hY₁ hY₂
        let l_μ : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ (W₁₂ : AlgebraicGeometry.Scheme.{u}) :=
          @AlgebraicGeometry.IsOpenImmersion.lift _ _ _ W₁₂.ι (yHom Y) hOpen_W₁₂ hY₁₂
        have hl_μ : l_μ ≫ W₁₂.ι = yHom Y :=
          @AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _ W₁₂.ι (yHom Y) hOpen_W₁₂ hY₁₂
        let μ : Y ⟶ V₁₂ := CategoryTheory.MorphismProperty.Over.homMk l_μ hl_μ
        have hmu_lam : μ ≫ j₁₂_₁ = liftW₁ Y hY₁ := by
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
          apply (cancel_mono W₁.ι).mp
          have h_lhs : (l_μ ≫ C.left.homOfLE inf_le_left) ≫ W₁.ι = yHom Y :=
            (CategoryTheory.Category.assoc l_μ (C.left.homOfLE inf_le_left) W₁.ι).trans
              ((congrArg (l_μ ≫ ·) (C.left.homOfLE_ι inf_le_left)).trans hl_μ)
          exact h_lhs.trans (hliftW₁_fac Y hY₁).symm
        have hmap_eq : (Q_div.obj.map (liftW₁ Y hY₁).op).hom q₁_sec =
            (Q_div.obj.map μ.op).hom ((Q_div.obj.map j₁₂_₁.op).hom q₁_sec) :=
          ConcreteCategory.congr_hom
            ((congrArg (fun k => Q_div.obj.map k.op) hmu_lam.symm).trans
              (Q_div.obj.map_comp j₁₂_₁.op μ.op)) q₁_sec
        exact hmap_eq.trans ((congrArg (Q_div.obj.map μ.op).hom hq₁_ov).trans (map_zero _))
      · rfl

    have hnot_W₁_imp_W₂ : ∀ (Y : C.left.Etale) (f : Y ⟶ T_X) (hf : R_cov.arrows f),
        ¬ Set.range (yHom Y).base ⊆ Set.range W₁.ι.base →
          Set.range (yHom Y).base ⊆ Set.range W₂.ι.base := by
      intro Y f hf hnot₁
      rcases hf with ⟨W_arr, h_YW, g_arr, hg_arr, h_eq⟩
      revert Y f hnot₁ h_YW h_eq
      rcases hg_arr with ⟨b⟩
      rintro (Y : C.left.Etale) (f : Y ⟶ T_X)
        (hnot₁ : ¬ Set.range (yHom Y).base ⊆ Set.range W₁.ι.base) h_YW h_eq
      have hy_hom : yHom Y = (f.left : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ C.left) := by
        have hw : (f.left : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ C.left) ≫ 𝟙 C.left =
            yHom Y := CategoryTheory.MorphismProperty.Over.w f
        exact hw.symm.trans (CategoryTheory.Category.comp_id _)
      cases b
      · 
        have hf_left : (yHom Y : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ C.left) =
            (h_YW.left : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ W₂) ≫ W₂.ι :=
          hy_hom.trans (congrArg (fun k : Y ⟶ T_X => k.left) h_eq.symm)
        rintro _ ⟨y, rfl⟩
        have hy_app : (yHom Y).base y = W₂.ι.base (h_YW.left.base y) :=
          (congrArg (fun m : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ C.left => m.base y)
            hf_left).trans
            (AlgebraicGeometry.Scheme.Hom.comp_apply
              (h_YW.left : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ W₂) W₂.ι y)
        exact ⟨h_YW.left.base y, hy_app.symm⟩
      · 
        exfalso
        apply hnot₁
        have hf_left : (yHom Y : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ C.left) =
            (h_YW.left : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ W₁) ≫ W₁.ι :=
          hy_hom.trans (congrArg (fun k : Y ⟶ T_X => k.left) h_eq.symm)
        rintro _ ⟨y, rfl⟩
        have hy_app : (yHom Y).base y = W₁.ι.base (h_YW.left.base y) :=
          (congrArg (fun m : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ C.left => m.base y)
            hf_left).trans
            (AlgebraicGeometry.Scheme.Hom.comp_apply
              (h_YW.left : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ W₁) W₁.ι y)
        exact ⟨h_YW.left.base y, hy_app.symm⟩

    have hx_pull : ∀ (Y Z : C.left.Etale) (g : Z ⟶ Y) (f : Y ⟶ T_X) (hf : R_cov.arrows f),
        (Q_div.obj.map g.op).hom (x_el f hf) = x_el (g ≫ f) (R_cov.downward_closed hf g) := by
      intro Y Z g f hf
      let g_left : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ Y.left := g.left
      have hgw : g_left ≫ yHom Y = yHom Z := CategoryTheory.MorphismProperty.Over.w g
      by_cases hY₁ : Set.range (yHom Y).base ⊆ Set.range W₁.ι.base
      · have hZ₁ : Set.range (yHom Z).base ⊆ Set.range W₁.ι.base := by
          rintro _ ⟨z, rfl⟩
          have hz : (yHom Z).base z = (yHom Y).base (g_left.base z) :=
            (congrArg (fun m : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ C.left => m.base z)
              hgw.symm).trans (AlgebraicGeometry.Scheme.Hom.comp_apply g_left (yHom Y) z)
          exact hz ▸ hY₁ ⟨g_left.base z, rfl⟩
        have hxY : x_el f hf = (Q_div.obj.map (liftW₁ Y hY₁).op).hom q₁_sec := by
          simp only [x_el, hY₁, ↓reduceDIte]
        have hxZ : x_el (g ≫ f) (R_cov.downward_closed hf g) =
            (Q_div.obj.map (liftW₁ Z hZ₁).op).hom q₁_sec := by
          simp only [x_el, hZ₁, ↓reduceDIte]
        have hglam : g ≫ liftW₁ Y hY₁ = liftW₁ Z hZ₁ := by
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
          apply (cancel_mono W₁.ι).mp
          have h_lhs : (g_left ≫ ((liftW₁ Y hY₁).left :
              (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ W₁)) ≫ W₁.ι = yHom Z :=
            (CategoryTheory.Category.assoc g_left _ W₁.ι).trans
              ((congrArg (g_left ≫ ·) (hliftW₁_fac Y hY₁)).trans hgw)
          exact h_lhs.trans (hliftW₁_fac Z hZ₁).symm
        exact (congrArg (Q_div.obj.map g.op).hom hxY).trans
          ((ConcreteCategory.congr_hom
            ((Q_div.obj.map_comp (liftW₁ Y hY₁).op g.op).symm.trans
              (congrArg (fun k => Q_div.obj.map k.op) hglam)) q₁_sec).trans hxZ.symm)
      · have hY₂ : Set.range (yHom Y).base ⊆ Set.range W₂.ι.base := hnot_W₁_imp_W₂ Y f hf hY₁
        have hZ₂ : Set.range (yHom Z).base ⊆ Set.range W₂.ι.base := by
          rintro _ ⟨z, rfl⟩
          have hz : (yHom Z).base z = (yHom Y).base (g_left.base z) :=
            (congrArg (fun m : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ C.left => m.base z)
              hgw.symm).trans (AlgebraicGeometry.Scheme.Hom.comp_apply g_left (yHom Y) z)
          exact hz ▸ hY₂ ⟨g_left.base z, rfl⟩
        exact ((congrArg (Q_div.obj.map g.op).hom (hx_W₂ Y f hf hY₂)).trans (map_zero _)).trans
          (hx_W₂ Z (g ≫ f) (R_cov.downward_closed hf g) hZ₂).symm

    have hx_compat : x_el.Compatible := by
      intro Y₁ Y₂ Z g₁' g₂' f₁ f₂ hf₁ hf₂ _
      exact (hx_pull Y₁ Z g₁' f₁ hf₁).trans (hx_pull Y₂ Z g₂' f₂ hf₂).symm

    let hShFor := hQ_type.isSheafFor R_cov hR_cov
    let q₀ : ↥(Q_div.obj.obj (Opposite.op T_X)) := hShFor.amalgamate x_el hx_compat
    have hq₀_1 : (Q_div.obj.map g₁.op).hom q₀ = q₁_sec := by
      have hv : (Q_div.obj.map g₁.op).hom q₀ =
          x_el g₁ (CategoryTheory.Sieve.ofArrows_mk Fam Arr true) :=
        hShFor.valid_glue hx_compat g₁ (CategoryTheory.Sieve.ofArrows_mk Fam Arr true)
      have hV₁_sub : Set.range (yHom V₁).base ⊆ Set.range W₁.ι.base := subset_rfl
      have hx₁ : x_el g₁ (CategoryTheory.Sieve.ofArrows_mk Fam Arr true) =
          (Q_div.obj.map (liftW₁ V₁ hV₁_sub).op).hom q₁_sec := by
        simp only [x_el, hV₁_sub, ↓reduceDIte]
      have hlam_id : liftW₁ V₁ hV₁_sub = 𝟙 V₁ := by
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
        apply (cancel_mono W₁.ι).mp
        exact (hliftW₁_fac V₁ hV₁_sub).trans (CategoryTheory.Category.id_comp W₁.ι).symm
      exact hv.trans (hx₁.trans
        (ConcreteCategory.congr_hom
          ((congrArg (fun k => Q_div.obj.map k.op) hlam_id).trans (Q_div.obj.map_id _)) q₁_sec))
    have hq₀_2 : (Q_div.obj.map g₂.op).hom q₀ = 0 := by
      have hv : (Q_div.obj.map g₂.op).hom q₀ =
          x_el g₂ (CategoryTheory.Sieve.ofArrows_mk Fam Arr false) :=
        hShFor.valid_glue hx_compat g₂ (CategoryTheory.Sieve.ofArrows_mk Fam Arr false)
      exact hv.trans (hx_W₂ V₂ g₂ (CategoryTheory.Sieve.ofArrows_mk Fam Arr false) subset_rfl)

    let adj_X := CategoryTheory.constantSheafAdj
      C.left.smallEtaleTopology AddCommGrpCat.{u} hT_X
    let q_hom : Aℤ ⟶ Q_div.obj.obj (Opposite.op T_X) :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • q₀
          map_zero' := zero_zsmul q₀
          map_add' := fun a b => add_zsmul q₀ a.down b.down }
    let f_q : Fℤ_C' ⟶ Q_div := (adj_X.homEquiv Aℤ Q_div).symm q_hom

    have hfq_eval : ∀ (V : C.left.Etale) (v_hom : V ⟶ T_X),
        (f_q.hom.app (Opposite.op V)).hom (u₁_Fℤ V) = (Q_div.obj.map v_hom.op).hom q₀ := by
      intro V v_hom
      have hfq_TX : (f_q.hom.app (Opposite.op T_X)).hom (u₁_Fℤ T_X) = q₀ := by
        have h1 : (adj_X.homEquiv Aℤ Q_div) f_q = q_hom :=
          (adj_X.homEquiv Aℤ Q_div).apply_symm_apply q_hom
        have h2 : (adj_X.homEquiv Aℤ Q_div) f_q =
            adj_X.unit.app Aℤ ≫ f_q.hom.app (Opposite.op T_X) :=
          CategoryTheory.Adjunction.homEquiv_unit adj_X Aℤ Q_div f_q
        have hadj_u : adj_X.unit.app Aℤ = (shAdj.unit.app Pℤ).app (Opposite.op T_X) :=
          CategoryTheory.Category.id_comp _
        have h3 := ConcreteCategory.congr_hom (h2.symm.trans h1) (ULift.up (1 : ℤ))
        rw [hadj_u] at h3
        change (f_q.hom.app (Opposite.op T_X)).hom (u₁_Fℤ T_X) = (1 : ℤ) • q₀ at h3
        rwa [one_zsmul] at h3
      have hu_nat : (Fℤ_C'.obj.map v_hom.op).hom (u₁_Fℤ T_X) = u₁_Fℤ V := by
        have h := ConcreteCategory.congr_hom
          ((shAdj.unit.app Pℤ).naturality v_hom.op) (ULift.up (1 : ℤ))
        exact h.symm
      have hfq_nat := ConcreteCategory.congr_hom (f_q.hom.naturality v_hom.op) (u₁_Fℤ T_X)
      change (f_q.hom.app (Opposite.op V)).hom ((Fℤ_C'.obj.map v_hom.op).hom (u₁_Fℤ T_X)) =
        (Q_div.obj.map v_hom.op).hom ((f_q.hom.app (Opposite.op T_X)).hom (u₁_Fℤ T_X)) at hfq_nat
      rw [hu_nat, hfq_TX] at hfq_nat
      exact hfq_nat

    refine ⟨s₁, f_q, hs₁_ov, (hfq_eval V₁ g₁).trans hq₀_1, (hfq_eval V₂ g₂).trans hq₀_2, ?_⟩

    
    have hmk_fq : CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ f_q) = f_q := by
      apply (CategoryTheory.Abelian.Ext.mk₀_bijective Fℤ_C Q_div).1
      exact CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply _
    have hfq_TX : (f_q.hom.app (Opposite.op T_X)).hom (u₁_C T_X) = q₀ := by
      have := hfq_eval T_X (𝟙 T_X)
      rwa [op_id, Q_div.obj.map_id, AddCommGrpCat.id_apply] at this
    have hev_fq : ev_H0 (CategoryTheory.Abelian.Ext.mk₀ f_q) =
        (val_bar.hom.app (Opposite.op T_X)).hom q₀ := by
      change (val_bar.hom.app (Opposite.op T_X)).hom
        (((CategoryTheory.Abelian.Ext.addEquiv₀
          (CategoryTheory.Abelian.Ext.mk₀ f_q)).hom.app (Opposite.op T_X)).hom (u₁_C T_X)) = _
      rw [hmk_fq, hfq_TX]
    let d₀ : ↥(Div_sh.obj.obj (Opposite.op T_X)) := (val_bar.hom.app (Opposite.op T_X)).hom q₀
    have hd₀_g₁ : (Div_sh.obj.map g₁.op).hom d₀ = (val_pre.app (Opposite.op V₁)).hom s₁_pre := by
      have hnat := ConcreteCategory.congr_hom (val_bar.hom.naturality g₁.op) q₀
      change (val_bar.hom.app (Opposite.op V₁)).hom ((Q_div.obj.map g₁.op).hom q₀) =
        (Div_sh.obj.map g₁.op).hom d₀ at hnat
      rw [← hnat, hq₀_1]
      change ((π_div ≫ val_bar).hom.app (Opposite.op V₁)).hom s₁ = _
      rw [hπ_val]
      change ((shAdj.unit.app (weilEtaleKPresheaf C.left) ≫ val_sh.hom).app (Opposite.op V₁)).hom
        s₁_pre = _
      rw [hunit_val]
    have hd₀_g₂ : (Div_sh.obj.map g₂.op).hom d₀ = 0 := by
      have hnat := ConcreteCategory.congr_hom (val_bar.hom.naturality g₂.op) q₀
      change (val_bar.hom.app (Opposite.op V₂)).hom ((Q_div.obj.map g₂.op).hom q₀) =
        (Div_sh.obj.map g₂.op).hom d₀ at hnat
      rw [← hnat, hq₀_2, map_zero]
    apply Finsupp.ext
    intro x
    have hlhs : (div_H0 (CategoryTheory.Abelian.Ext.mk₀ f_q)) x = valDiv T_X d₀ x :=
      congrArg (fun e => valDiv T_X e x) hev_fq
    refine hlhs.trans ?_
    by_cases hx : x = ⟨P, hP_cl⟩
    · subst hx
      let y₁ : { y : ↥V₁.left // IsClosed ({V₁.hom.base y} : Set ↥C.left) } := ⟨⟨P, hP_mem⟩, hP_cl⟩
      have hnat : valDiv V₁ ((Div_sh.obj.map g₁.op).hom d₀) y₁ = valDiv T_X d₀ ⟨P, hP_cl⟩ :=
        hValNat g₁ d₀ y₁
      exact hnat.symm.trans
        ((congrArg (fun e => valDiv V₁ e y₁) hd₀_g₁).trans
          ((congrFun (hval_pre_spec V₁ s₁_pre) y₁).trans
            (hs₁_pre_val.trans
              (Finsupp.single_eq_same (a := (⟨P, hP_cl⟩ : Pt)) (b := (1 : ℤ))).symm)))
    · have hx_val : x.1 ≠ P := fun h => hx (Subtype.ext h)
      have hx₂ : x.1 ∈ W₂ := by
        change x.1 ∈ (W₂ : Set ↥C.left)
        rw [hW₂]
        exact hx_val
      let y₂ : { y : ↥V₂.left // IsClosed ({V₂.hom.base y} : Set ↥C.left) } := ⟨⟨x.1, hx₂⟩, x.2⟩
      have hnat : valDiv V₂ ((Div_sh.obj.map g₂.op).hom d₀) y₂ = valDiv T_X d₀ x :=
        hValNat g₂ d₀ y₂
      have hzero_y₂ : valDiv V₂ 0 y₂ = 0 :=
        congrFun (valDiv V₂).map_zero y₂
      exact hnat.symm.trans
        ((congrArg (fun e => valDiv V₂ e y₂) hd₀_g₂).trans
          (hzero_y₂.trans (Finsupp.single_eq_of_ne hx).symm))

theorem weil_etale_two_open_unit_kummer_class_and_curve_point_nonvanishing (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (Y : AlgebraicGeometry.Scheme.{u})
    (f_Y_k : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
    (U₁ U₂ : Y.Opens) (hcov : U₁ ⊔ U₂ = ⊤)
    (u₁₂ : Units ↑(Y.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))) :
    ∃ α : weilEtaleTorsionH Y ℓ 2,
      (∀ (W : AlgebraicGeometry.Scheme.{u})
         (f_W_k : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
         (h' : W ⟶ Y),
        h' ≫ f_Y_k = f_W_k →
        ∀ (φ' : weilEtaleTorsionH Y ℓ 2 →+ weilEtaleTorsionH W ℓ 2),
          WeilTopDegTorsionPullback h' ℓ 2 φ' →
          (TopologicalSpace.Opens.map h'.base).obj U₂ = ⊤ →
          φ' α = 0) ∧
      (∀ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
        AlgebraicGeometry.IsIntegral C.left →
        IsProjectiveOverField k C →
        ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
          (h : C.left ⟶ Y),
          h ≫ f_Y_k = C.hom →
          ∀ (φ : weilEtaleTorsionH Y ℓ 2 →+ weilEtaleTorsionH C.left ℓ 2),
            WeilTopDegTorsionPullback h ℓ 2 φ →
            ∀ (P : ↥C.left),
              IsClosed ({P} : Set ↥C.left) →
              ∀ (hP_mem : P ∈ (TopologicalSpace.Opens.map h.base).obj U₁)
                (g_sec : ↑(Y.presheaf.obj (Opposite.op U₁))),
                (Y.presheaf.map
                  (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g_sec =
                  (u₁₂ : ↑(Y.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))) →
                ((TopologicalSpace.Opens.map h.base).obj U₂ : Set ↥C.left) =
                  ({P} : Set ↥C.left)ᶜ →
                Ideal.span {(C.left.presheaf.germ
                    ((TopologicalSpace.Opens.map h.base).obj U₁) P hP_mem).hom
                  ((h.app U₁).hom g_sec)} =
                  IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk P) →
                φ α ≠ 0) :=
by
  have hGm : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilEtaleGmPresheaf Z) :=
    weil_etale_gm_isSheaf_and_proj_H0_divisible.{u}.1
  have hKumY :
      ∃ (ι_kum : weilEtaleTorsionSheaf Y ℓ ⟶ weilEtaleGmSheaf Y)
        (p_kum : weilEtaleGmSheaf Y ⟶ weilEtaleGmSheaf Y)
        (h0 : ι_kum ≫ p_kum = 0),
        p_kum = ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf Y) ∧
        (CategoryTheory.ShortComplex.mk ι_kum p_kum h0).ShortExact :=
    (weil_etale_kummer_mod_prime_short_exact k (CategoryTheory.Over.mk f_Y_k) ℓ hℓ).2
