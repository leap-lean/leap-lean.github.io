            map_one' := by
              simp only [Pi.one_apply, hμ_one]
              exact h_sum
            map_mul' := fun u₁ u₂ => by
              simp only [Pi.mul_apply]
              rw [Finset.sum_mul_sum]
              symm
              apply Finset.sum_congr rfl
              intro i _
              rw [Finset.sum_eq_single i]
              · exact hμ_mul i _ _
              · intro j _ hji
                exact hμ_diff i j (Ne.symm hji) _ _
              · intro hi_abs
                exact absurd (Finset.mem_univ i) hi_abs
            map_zero' := by simp
            map_add' := fun u₁ u₂ => by
              simp only [Pi.add_apply, map_add]
              exact Finset.sum_add_distrib
            commutes' := fun r => by
              have hr : ∀ i : I, μ_i i (algebraMap R_h (AdjoinRoot (P i)) r) = r • wb i := by
                intro i
                rw [Algebra.algebraMap_eq_smul_one, map_smul, hμ_one i]
              change (∑ i : I, μ_i i (algebraMap R_h ((j : I) → AdjoinRoot (P j)) r i)) =
                algebraMap R_h D r
              simp only [Pi.algebraMap_apply, hr]
              rw [← Finset.smul_sum, h_sum, Algebra.algebraMap_eq_smul_one] }
        refine ⟨σ, fun u f hf => ?_⟩
        change ∑ i : I, μ_i i (u i) = _
        apply Finset.sum_congr rfl
        intro i _
        rw [hf i, hμ_mk i (f i)]
      obtain ⟨σ, hσ_mk⟩ := build_σ D_h w_bar a_bar hw_idem hw_orth hw_sum hw_P
      have hUnit_h_K : IsUnit (algebraMap R K h) :=
        IsUnit.mk0 _ (fun hc => hh_ne (hRK_inj (hc.trans (map_zero _).symm)))
      let ι_hK : R_h →+* K := IsLocalization.Away.lift (S := R_h)
        (g := algebraMap R K) h hUnit_h_K
      have hι_hK_comp : ι_hK.comp (algebraMap R R_h) = algebraMap R K := by
        ext r
        exact IsLocalization.Away.lift_eq (S := R_h) (g := algebraMap R K)
          (x := h) hUnit_h_K r
      have hι_hK_apply : ∀ r : R, ι_hK (algebraMap R R_h r) = algebraMap R K r :=
        fun r => RingHom.congr_fun hι_hK_comp r
      have hι_hK_inj : Function.Injective ι_hK := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        let sec := IsLocalization.Away.sec h x
        have hsec : x * algebraMap R R_h h ^ sec.2 = algebraMap R R_h sec.1 := by
          simpa [mul_comm] using (IsLocalization.Away.sec_spec (x := h) x)
        have h0 : algebraMap R K sec.1 = 0 := by
          rw [← hι_hK_apply, ← hsec, map_mul, hx, zero_mul]
        have hr0 : sec.1 = 0 := hRK_inj (h0.trans (map_zero _).symm)
        have hmul0 : x * algebraMap R R_h h ^ sec.2 = 0 := by rw [hsec, hr0, map_zero]
