    let eB : B_id ≅ CategoryTheory.Functor.id V.Etale :=
      CategoryTheory.NatIso.ofComponents eE (fun {E₁ E₂} u => hEtHomExt (by
        change (B_id.map u).left ≫ (eE E₂).hom.left = (eE E₁).hom.left ≫ u.left
        rw [heE E₁, heE E₂]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _))
    let P_push := B_id.sheafPushforwardContinuous AddCommGrpCat.{u}
      V.smallEtaleTopology V.smallEtaleTopology
    refine ⟨CategoryTheory.NatIso.ofComponents
      (fun M =>
        let eM : (P_push.obj M).obj ≅ M.obj :=
          CategoryTheory.NatIso.ofComponents
            (fun E => M.obj.mapIso ((eB.app E.unop).symm.op))
            (fun {E₁ E₂} u => by
