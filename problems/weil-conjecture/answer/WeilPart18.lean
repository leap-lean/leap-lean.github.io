        (CategoryTheory.Adjunction.homEquiv_unit adj_W A₃ (j_w.obj M) σ).symm.trans
          ((adj_W.homEquiv A₃ (j_w.obj M)).apply_symm_apply σ₀)
      change (adj_W.unit.app A₃ ≫ (σ.hom.app (Opposite.op T_W) ≫ g_app)) = η_rhs
      have hassoc : adj_W.unit.app A₃ ≫ (σ.hom.app (Opposite.op T_W) ≫ g_app) =
          (adj_W.unit.app A₃ ≫ σ.hom.app (Opposite.op T_W)) ≫ g_app :=
        (Category.assoc _ _ _).symm
      rw [hassoc, hσ_unit]
      apply AddCommGrpCat.ext
      intro a
      exact hσ_hom a
    let split_W : SC_W.Splitting :=
      CategoryTheory.ShortComplex.Splitting.ofExactOfSection SC_W hSE_W.exact σ hσg hSE_W.mono_f
    haveI : C_W.Additive := by dsimp [C_W, CategoryTheory.constantSheaf]; infer_instance
    haveI : CategoryTheory.Limits.PreservesBinaryBiproduct A₁ A₃ C_W :=
      CategoryTheory.Limits.preservesBinaryBiproduct_of_preservesBinaryCoproduct C_W
    let A₂ : AddCommGrpCat.{u} := A₁ ⊞ A₃
    let e_M : j_w.obj M ≅ C_W.obj A₂ :=
      split_W.isoBinaryBiproduct ≪≫ (CategoryTheory.Functor.mapBiprod C_W A₁ A₃).symm
    have hFin₂ : Finite A₂ := by
      haveI : Finite ↥A₁ := hFin₁
      haveI : Finite ↥A₃ := hFin₃
      let fst₁ : A₂ ⟶ A₁ := CategoryTheory.Limits.biprod.fst
      let snd₃ : A₂ ⟶ A₃ := CategoryTheory.Limits.biprod.snd
      let inl₁ : A₁ ⟶ A₂ := CategoryTheory.Limits.biprod.inl
      let inr₃ : A₃ ⟶ A₂ := CategoryTheory.Limits.biprod.inr
      let toProd : ↥A₂ → ↥A₁ × ↥A₃ := fun x => (fst₁ x, snd₃ x)
      have hInj : Function.Injective toProd := by
        intro x y hxy
        have hx1 : fst₁ x = fst₁ y := congrArg Prod.fst hxy
        have hx2 : snd₃ x = snd₃ y := congrArg Prod.snd hxy
        have htot : fst₁ ≫ inl₁ + snd₃ ≫ inr₃ = 𝟙 A₂ := CategoryTheory.Limits.biprod.total
        have htot_x := congrArg (fun φ : A₂ ⟶ A₂ => φ x) htot
        have htot_y := congrArg (fun φ : A₂ ⟶ A₂ => φ y) htot
        change inl₁ (fst₁ x) + inr₃ (snd₃ x) = x at htot_x
        change inl₁ (fst₁ y) + inr₃ (snd₃ y) = y at htot_y
        rw [← htot_x, ← htot_y, hx1, hx2]
      exact Finite.of_injective toProd hInj
    have hℓ₂ : ℓ • CategoryTheory.CategoryStruct.id A₂ = 0 := by
      calc
        ℓ • (𝟙 A₂) = ℓ • (CategoryTheory.Limits.biprod.fst ≫ CategoryTheory.Limits.biprod.inl +
            CategoryTheory.Limits.biprod.snd ≫ CategoryTheory.Limits.biprod.inr) := by
          rw [CategoryTheory.Limits.biprod.total]
        _ = ℓ • (CategoryTheory.Limits.biprod.fst ≫ 𝟙 A₁ ≫ CategoryTheory.Limits.biprod.inl) +
            ℓ • (CategoryTheory.Limits.biprod.snd ≫ 𝟙 A₃ ≫ CategoryTheory.Limits.biprod.inr) := by
          rw [nsmul_add, Category.id_comp, Category.id_comp]
        _ = CategoryTheory.Limits.biprod.fst ≫ (ℓ • 𝟙 A₁) ≫ CategoryTheory.Limits.biprod.inl +
            CategoryTheory.Limits.biprod.snd ≫ (ℓ • 𝟙 A₃) ≫ CategoryTheory.Limits.biprod.inr := by
          rw [← CategoryTheory.Preadditive.comp_nsmul, ← CategoryTheory.Preadditive.nsmul_comp,
            ← CategoryTheory.Preadditive.comp_nsmul, ← CategoryTheory.Preadditive.nsmul_comp]
        _ = 0 := by
          rw [hℓ₁, hℓ₃]
          simp
    exact ⟨W, inferInstance, hNeW, w, A₂, hEt_w, hFin₂, hℓ₂, (hIff_w M (C_W.obj A₂)).mpr ⟨e_M⟩⟩

  
  
  have hQ_zero : ∀ G, CategoryTheory.Limits.IsZero G → Q G := by
    intro G hZeroG
    have hid0 : 𝟙 G = 0 := hZeroG.eq_of_src (𝟙 G) 0
    have hℓG : ℓ • CategoryTheory.CategoryStruct.id G = 0 := by
      change ℓ • 𝟙 G = 0; rw [hid0, smul_zero]
    let U : Z.Opens := ⊤
    have : Nonempty ↥Z := AlgebraicGeometry.IsIntegral.nonempty
    have hU : Nonempty U := ⟨⟨Classical.arbitrary ↥Z, trivial⟩⟩
    let V : AlgebraicGeometry.Scheme.{u} := (U : AlgebraicGeometry.Scheme.{u})
    let p : V ⟶ (U : AlgebraicGeometry.Scheme.{u}) := 𝟙 V
    let A : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} (ZMod 1))
    have hZeroA : CategoryTheory.Limits.IsZero A := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply AddCommGrpCat.ext
      rintro ⟨x⟩
      exact ULift.ext _ _ (Subsingleton.elim _ _)
    have hℓA : ℓ • CategoryTheory.CategoryStruct.id A = 0 := by
      change ℓ • 𝟙 A = 0
      rw [hZeroA.eq_of_src (𝟙 A) 0, smul_zero]
    let q : V ⟶ Z := p ≫ U.ι
    have hEt_q : AlgebraicGeometry.Etale q := inferInstance
    let Φ_q : CategoryTheory.Functor V.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.map ⊤ hEt_q
    haveI : Φ_q.IsContinuous V.smallEtaleTopology Z.smallEtaleTopology := hContMap q hEt_q
    let j_q := Φ_q.sheafPushforwardContinuous
      AddCommGrpCat.{u} V.smallEtaleTopology Z.smallEtaleTopology
    obtain ⟨_, _, hAdd_q, hIff_q, -⟩ := hEtPullPkg q hEt_q
    haveI := hAdd_q
    let C_V := CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}
    haveI : C_V.Additive := by dsimp [C_V, CategoryTheory.constantSheaf]; infer_instance
    have hZero_jG : CategoryTheory.Limits.IsZero (j_q.obj G) := j_q.map_isZero hZeroG
    have hZero_CA : CategoryTheory.Limits.IsZero (C_V.obj A) := C_V.map_isZero hZeroA
    exact ⟨hℓG, U, hU, V, p, A, inferInstance, inferInstance, inferInstance, inferInstance,
      hℓA, (hIff_q G (C_V.obj A)).mpr ⟨hZero_jG.iso hZero_CA⟩⟩

  
  have hQ_ker_coker : ∀ G₁ G₂ (ψ : G₁ ⟶ G₂), Q G₁ → Q G₂ →
      Q (CategoryTheory.Limits.kernel ψ) ∧ Q (CategoryTheory.Limits.cokernel ψ) := by
    intro G₁ G₂ ψ hG₁ hG₂
    rcases hG₁ with ⟨hℓG₁, U₁, hU₁, V₁, p₁, A₁, hFin_p₁, hEt_p₁, hSurj_p₁, hFinA₁, hℓA₁, hPull₁⟩
    rcases hG₂ with ⟨hℓG₂, U₂, hU₂, V₂, p₂, A₂, hFin_p₂, hEt_p₂, hSurj_p₂, hFinA₂, hℓA₂, hPull₂⟩
    have hℓ_ker : ℓ • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.kernel ψ) = 0 := by
      apply (cancel_mono (CategoryTheory.Limits.kernel.ι ψ)).mp
      calc
        (ℓ • 𝟙 (CategoryTheory.Limits.kernel ψ)) ≫ CategoryTheory.Limits.kernel.ι ψ =
            ℓ • (𝟙 _ ≫ CategoryTheory.Limits.kernel.ι ψ) :=
          CategoryTheory.Preadditive.nsmul_comp _ _ _
        _ = ℓ • (CategoryTheory.Limits.kernel.ι ψ ≫ 𝟙 G₁) := by
          rw [Category.id_comp, Category.comp_id]
        _ = CategoryTheory.Limits.kernel.ι ψ ≫ (ℓ • 𝟙 G₁) :=
          (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
        _ = 0 ≫ CategoryTheory.Limits.kernel.ι ψ := by
          rw [hℓG₁, CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.zero_comp]
    have hℓ_coker :
        ℓ • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.cokernel ψ) = 0 := by
      apply (cancel_epi (CategoryTheory.Limits.cokernel.π ψ)).mp
      calc
        CategoryTheory.Limits.cokernel.π ψ ≫ (ℓ • 𝟙 (CategoryTheory.Limits.cokernel ψ)) =
            ℓ • (CategoryTheory.Limits.cokernel.π ψ ≫ 𝟙 _) :=
          CategoryTheory.Preadditive.comp_nsmul _ _ _
        _ = ℓ • (𝟙 G₂ ≫ CategoryTheory.Limits.cokernel.π ψ) := by
          rw [Category.comp_id, Category.id_comp]
        _ = (ℓ • 𝟙 G₂) ≫ CategoryTheory.Limits.cokernel.π ψ :=
          (CategoryTheory.Preadditive.nsmul_comp _ _ _).symm
        _ = CategoryTheory.Limits.cokernel.π ψ ≫ 0 := by
          rw [hℓG₂, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    obtain ⟨U, hU, V, p, q₁, q₂, hIntV, hFin_p, hEt_p, hSurj_p, hEt_q₁, hEt_q₂, hComm₁, hComm₂⟩ :=
      s1 U₁ hU₁ V₁ p₁ hFin_p₁ hEt_p₁ hSurj_p₁ U₂ hU₂ V₂ p₂ hFin_p₂ hEt_p₂ hSurj_p₂
    haveI : IrreducibleSpace ↥V :=
      ((AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced V).mp hIntV).1
    haveI : ConnectedSpace ↥V := inferInstance
    haveI := hEt_p; haveI := hEt_p₁; haveI := hEt_p₂
    let q : V ⟶ Z := p ≫ U.ι
    have hEt_q : AlgebraicGeometry.Etale q := inferInstance
    have hPullV₁ : WeilIsEtaleSheafPullback q G₁
        ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A₁) := by
      have hP := hPullComp q₁ (p₁ ≫ U₁.ι) hEt_q₁ inferInstance G₁ _ _
        hPull₁ (hPullConst q₁ hEt_q₁ A₁)
      rwa [hComm₁] at hP
    have hPullV₂ : WeilIsEtaleSheafPullback q G₂
        ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A₂) := by
      have hP := hPullComp q₂ (p₂ ≫ U₂.ι) hEt_q₂ inferInstance G₂ _ _
        hPull₂ (hPullConst q₂ hEt_q₂ A₂)
      rwa [hComm₂] at hP
    let Φ_q : CategoryTheory.Functor V.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.map ⊤ hEt_q
    haveI : Φ_q.IsContinuous V.smallEtaleTopology Z.smallEtaleTopology := hContMap q hEt_q
    let R := Φ_q.sheafPushforwardContinuous
      AddCommGrpCat.{u} V.smallEtaleTopology Z.smallEtaleTopology
    obtain ⟨hLim_R, hColim_R, hAdd_R, hIff_R, -⟩ := hEtPullPkg q hEt_q
    haveI := hLim_R; haveI := hColim_R; haveI := hAdd_R
    let C_V := CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}
    haveI : CategoryTheory.Limits.PreservesFiniteLimits C_V :=
      CategoryTheory.Limits.comp_preservesFiniteLimits
        (CategoryTheory.Functor.const (Opposite V.Etale))
        (CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u})
    haveI : CategoryTheory.Limits.PreservesFiniteColimits C_V := inferInstance
    haveI : C_V.Additive := by dsimp [C_V, CategoryTheory.constantSheaf]; infer_instance
    obtain ⟨e₁⟩ := (hIff_R G₁ (C_V.obj A₁)).mp hPullV₁
    obtain ⟨e₂⟩ := (hIff_R G₂ (C_V.obj A₂)).mp hPullV₂
    let φ : C_V.obj A₁ ⟶ C_V.obj A₂ := e₁.inv ≫ R.map ψ ≫ e₂.hom
    obtain ⟨φ₀, hφ₀⟩ := s3 V A₁ A₂ φ
    have hComm_φ : R.map ψ ≫ e₂.hom = e₁.hom ≫ C_V.map φ₀ := by
      rw [← hφ₀]
      dsimp [φ]
      rw [← Category.assoc, e₁.hom_inv_id, Category.id_comp]
    let e_ker : R.obj (CategoryTheory.Limits.kernel ψ) ≅
        C_V.obj (CategoryTheory.Limits.kernel φ₀) :=
      CategoryTheory.Limits.PreservesKernel.iso R ψ ≪≫
        CategoryTheory.Limits.kernel.mapIso (R.map ψ) (C_V.map φ₀) e₁ e₂ hComm_φ ≪≫
        (CategoryTheory.Limits.PreservesKernel.iso C_V φ₀).symm
    let e_coker : R.obj (CategoryTheory.Limits.cokernel ψ) ≅
        C_V.obj (CategoryTheory.Limits.cokernel φ₀) :=
      CategoryTheory.Limits.PreservesCokernel.iso R ψ ≪≫
        CategoryTheory.Limits.cokernel.mapIso (R.map ψ) (C_V.map φ₀) e₁ e₂ hComm_φ ≪≫
        (CategoryTheory.Limits.PreservesCokernel.iso C_V φ₀).symm
    have hFin_ker : Finite ↥(CategoryTheory.Limits.kernel φ₀) := by
      haveI : Finite ↥A₁ := hFinA₁
      have hInj : Function.Injective (CategoryTheory.Limits.kernel.ι φ₀) :=
        (AddCommGrpCat.mono_iff_injective (CategoryTheory.Limits.kernel.ι φ₀)).mp inferInstance
      exact Finite.of_injective _ hInj
    have hℓ_kerA : ℓ • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.kernel φ₀) = 0 := by
      apply (cancel_mono (CategoryTheory.Limits.kernel.ι φ₀)).mp
      calc
        (ℓ • 𝟙 (CategoryTheory.Limits.kernel φ₀)) ≫ CategoryTheory.Limits.kernel.ι φ₀ =
            ℓ • (𝟙 _ ≫ CategoryTheory.Limits.kernel.ι φ₀) :=
          CategoryTheory.Preadditive.nsmul_comp _ _ _
        _ = ℓ • (CategoryTheory.Limits.kernel.ι φ₀ ≫ 𝟙 A₁) := by
          rw [Category.id_comp, Category.comp_id]
        _ = CategoryTheory.Limits.kernel.ι φ₀ ≫ (ℓ • 𝟙 A₁) :=
          (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
        _ = 0 ≫ CategoryTheory.Limits.kernel.ι φ₀ := by
          rw [hℓA₁, CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.zero_comp]
    have hFin_coker : Finite ↥(CategoryTheory.Limits.cokernel φ₀) := by
      haveI : Finite ↥A₂ := hFinA₂
      have hSurj : Function.Surjective (CategoryTheory.Limits.cokernel.π φ₀) :=
        (AddCommGrpCat.epi_iff_surjective (CategoryTheory.Limits.cokernel.π φ₀)).mp inferInstance
      exact Finite.of_surjective _ hSurj
    have hℓ_cokerA :
        ℓ • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.cokernel φ₀) = 0 := by
      apply (cancel_epi (CategoryTheory.Limits.cokernel.π φ₀)).mp
      calc
        CategoryTheory.Limits.cokernel.π φ₀ ≫ (ℓ • 𝟙 (CategoryTheory.Limits.cokernel φ₀)) =
            ℓ • (CategoryTheory.Limits.cokernel.π φ₀ ≫ 𝟙 _) :=
          CategoryTheory.Preadditive.comp_nsmul _ _ _
        _ = ℓ • (𝟙 A₂ ≫ CategoryTheory.Limits.cokernel.π φ₀) := by
          rw [Category.comp_id, Category.id_comp]
        _ = (ℓ • 𝟙 A₂) ≫ CategoryTheory.Limits.cokernel.π φ₀ :=
          (CategoryTheory.Preadditive.nsmul_comp _ _ _).symm
        _ = CategoryTheory.Limits.cokernel.π φ₀ ≫ 0 := by
          rw [hℓA₂, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    exact ⟨⟨hℓ_ker, U, hU, V, p, CategoryTheory.Limits.kernel φ₀,
        hFin_p, hEt_p, hSurj_p, hFin_ker, hℓ_kerA,
        (hIff_R (CategoryTheory.Limits.kernel ψ) _).mpr ⟨e_ker⟩⟩,
