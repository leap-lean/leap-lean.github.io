          hom_inv_id := CategoryTheory.Sheaf.hom_ext eM.hom_inv_id
          inv_hom_id := CategoryTheory.Sheaf.hom_ext eM.inv_hom_id })
      (fun {M₁ M₂} φ => by
        apply CategoryTheory.Sheaf.hom_ext
        ext E : 2
        exact (φ.hom.naturality ((eB.inv.app E.unop).op)).symm)⟩
