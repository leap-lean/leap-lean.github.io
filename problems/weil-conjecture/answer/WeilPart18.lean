    intro c c' hne
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    cases U with | op V_et =>
    apply AddCommGrpCat.ext
    intro t
    let t_sub : ↥(weilAltZeroBdrySubgroup (X c) (W_comp c) n ((B c).obj V_et)) := t
    apply Subtype.ext
    apply LocallyConstant.ext
    intro p'
    let pr₁' := Limits.pullback.fst ((Scheme.Etale.forget Y₀).obj V_et).hom (g c')
    let pr₂' := Limits.pullback.snd ((Scheme.Etale.forget Y₀).obj V_et).hom (g c')
    have hx_not_Vc : ((Scheme.Etale.forget Y₀).obj V_et).hom.base (pr₁'.base p') ∉
        (V_comp c : Set ↥Y₀) := by
      have hcond : ((Scheme.Etale.forget Y₀).obj V_et).hom.base (pr₁'.base p') =
          (g c').base (pr₂'.base p') :=
        congrArg (fun k : Limits.pullback ((Scheme.Etale.forget Y₀).obj V_et).hom (g c') ⟶ Y₀ =>
          k.base p')
          (Limits.pullback.condition
            (f := ((Scheme.Etale.forget Y₀).obj V_et).hom) (g := g c'))
      have hy_Zc' : ((Scheme.Etale.forget Y₀).obj V_et).hom.base (pr₁'.base p') ∈
          Set.range (ι_Z c').base := by
        rw [hcond]
        exact ⟨(ν c').base (pr₂'.base p'),
