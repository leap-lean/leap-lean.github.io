        ((δ_end u hu B₂).hom.app (Opposite.op T_U'') :
          (C_U''.obj B₂).obj.obj (Opposite.op T_U'') ⟶
            (C_U''.obj B₂).obj.obj (Opposite.op ((F_end u hu).obj T_U''))) =
        f ≫ adj''.unit.app B₂ ≫ (C_U''.obj B₂).obj.map g_T :=
      (congrArg (· ≫ _) h₃).trans
        ((CategoryTheory.Category.assoc _ _ _).trans (congrArg (f ≫ ·) h₄))
    have hR : (adj''.unit.app B₁ ≫
        ((δ_end u hu B₁).hom.app (Opposite.op T_U'') :
          (C_U''.obj B₁).obj.obj (Opposite.op T_U'') ⟶
            (C_U''.obj B₁).obj.obj (Opposite.op ((F_end u hu).obj T_U'')))) ≫
        (C_U''.map f).hom.app (Opposite.op ((F_end u hu).obj T_U'')) =
        f ≫ adj''.unit.app B₂ ≫ (C_U''.obj B₂).obj.map g_T :=
      (congrArg (· ≫ _) h₁).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (adj''.unit.app B₁ ≫ ·) h₂).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ (C_U''.obj B₂).obj.map g_T) h₃).trans
                (CategoryTheory.Category.assoc _ _ _)))))
    exact hL₀.trans (hL.trans (hR.symm.trans hR₀.symm))

  let iso_L_comp_of_eq : ∀ (u₁ u₂ w : U'' ⟶ U'') (hu₁ : AlgebraicGeometry.Etale u₁)
      (hu₂ : AlgebraicGeometry.Etale u₂) (hw : AlgebraicGeometry.Etale w)
      (_ : w = u₁ ≫ u₂)
      (𝒢 : CategoryTheory.Sheaf U''.smallEtaleTopology AddCommGrpCat.{u}),
      (L_end u₁ hu₁).obj ((L_end u₂ hu₂).obj 𝒢) ≅ (L_end w hw).obj 𝒢 :=
    fun u₁ u₂ w hu₁ hu₂ hw h_eq 𝒢 =>
      let e_hom : ∀ W'' : U''.Etale,
          (F_end w hw).obj W'' ⟶ (F_end u₂ hu₂).obj ((F_end u₁ hu₁).obj W'') :=
        fun W'' =>
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.CategoryStruct.id W''.left)
            ((CategoryTheory.Category.id_comp ((W''.hom ≫ u₁) ≫ u₂)).trans
              ((CategoryTheory.Category.assoc W''.hom u₁ u₂).trans
                (congrArg (W''.hom ≫ ·) h_eq.symm)))
      let e_inv : ∀ W'' : U''.Etale,
          (F_end u₂ hu₂).obj ((F_end u₁ hu₁).obj W'') ⟶ (F_end w hw).obj W'' :=
        fun W'' =>
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.CategoryStruct.id W''.left)
            ((CategoryTheory.Category.id_comp (W''.hom ≫ w)).trans
              ((congrArg (W''.hom ≫ ·) h_eq).trans
                (CategoryTheory.Category.assoc W''.hom u₁ u₂).symm))
      { hom :=
          { hom :=
              { app := fun W'' => 𝒢.obj.map (e_hom W''.unop).op
                naturality := fun {W''₁ W''₂} f => by
                  change 𝒢.obj.map ((F_end u₂ hu₂).map ((F_end u₁ hu₁).map f.unop)).op ≫
                      𝒢.obj.map (e_hom W''₂.unop).op =
                    𝒢.obj.map (e_hom W''₁.unop).op ≫ 𝒢.obj.map ((F_end w hw).map f.unop).op
                  rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← op_comp, ← op_comp]
                  refine congrArg 𝒢.obj.map (congrArg Opposite.op ?_)
                  apply CategoryTheory.MorphismProperty.Over.Hom.ext
                  exact (CategoryTheory.Category.id_comp f.unop.left).trans
                    (CategoryTheory.Category.comp_id f.unop.left).symm } }
        inv :=
          { hom :=
              { app := fun W'' => 𝒢.obj.map (e_inv W''.unop).op
                naturality := fun {W''₁ W''₂} f => by
                  change 𝒢.obj.map ((F_end w hw).map f.unop).op ≫
                      𝒢.obj.map (e_inv W''₂.unop).op =
                    𝒢.obj.map (e_inv W''₁.unop).op ≫
                      𝒢.obj.map ((F_end u₂ hu₂).map ((F_end u₁ hu₁).map f.unop)).op
                  rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← op_comp, ← op_comp]
                  refine congrArg 𝒢.obj.map (congrArg Opposite.op ?_)
                  apply CategoryTheory.MorphismProperty.Over.Hom.ext
                  exact (CategoryTheory.Category.id_comp f.unop.left).trans
                    (CategoryTheory.Category.comp_id f.unop.left).symm } }
        hom_inv_id := by
          apply CategoryTheory.Sheaf.hom_ext
          ext W'' : 2
          change 𝒢.obj.map (e_hom W''.unop).op ≫ 𝒢.obj.map (e_inv W''.unop).op =
            𝟙 (𝒢.obj.obj (Opposite.op ((F_end u₂ hu₂).obj ((F_end u₁ hu₁).obj W''.unop))))
          rw [← 𝒢.obj.map_comp, ← op_comp]
          have hid : e_inv W''.unop ≫ e_hom W''.unop = 𝟙 _ :=
            CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
          rw [hid]
          exact 𝒢.obj.map_id _
        inv_hom_id := by
          apply CategoryTheory.Sheaf.hom_ext
          ext W'' : 2
          change 𝒢.obj.map (e_inv W''.unop).op ≫ 𝒢.obj.map (e_hom W''.unop).op =
            𝟙 (𝒢.obj.obj (Opposite.op ((F_end w hw).obj W''.unop)))
          rw [← 𝒢.obj.map_comp, ← op_comp]
          have hid : e_hom W''.unop ≫ e_inv W''.unop = 𝟙 _ :=
            CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
          rw [hid]
          exact 𝒢.obj.map_id _ }

  have h_iso_comp_nat : ∀ (u₁ u₂ w : U'' ⟶ U'') (hu₁ : AlgebraicGeometry.Etale u₁)
      (hu₂ : AlgebraicGeometry.Etale u₂) (hw : AlgebraicGeometry.Etale w) (h_eq : w = u₁ ≫ u₂)
      {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf U''.smallEtaleTopology AddCommGrpCat.{u}} (φ : 𝒢₁ ⟶ 𝒢₂),
      (L_end u₁ hu₁).map ((L_end u₂ hu₂).map φ) ≫
        (iso_L_comp_of_eq u₁ u₂ w hu₁ hu₂ hw h_eq 𝒢₂).hom =
      (iso_L_comp_of_eq u₁ u₂ w hu₁ hu₂ hw h_eq 𝒢₁).hom ≫ (L_end w hw).map φ := by
    intro u₁ u₂ w hu₁ hu₂ hw h_eq 𝒢₁ 𝒢₂ φ
    apply CategoryTheory.Sheaf.hom_ext
    ext W'' : 2
    exact (φ.hom.naturality _).symm

  let iso_L_id_of_eq : ∀ (u : U'' ⟶ U'') (hu : AlgebraicGeometry.Etale u)
      (_ : u = CategoryTheory.CategoryStruct.id U'')
      (𝒢 : CategoryTheory.Sheaf U''.smallEtaleTopology AddCommGrpCat.{u}),
      (L_end u hu).obj 𝒢 ≅ 𝒢 :=
    fun u hu h_eq 𝒢 =>
      let e_hom : ∀ W'' : U''.Etale, W'' ⟶ (F_end u hu).obj W'' :=
        fun W'' =>
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.CategoryStruct.id W''.left)
            ((CategoryTheory.Category.id_comp (W''.hom ≫ u)).trans
              ((congrArg (W''.hom ≫ ·) h_eq).trans
                (CategoryTheory.Category.comp_id (X := W''.left) (Y := U'') W''.hom)))
      let e_inv : ∀ W'' : U''.Etale, (F_end u hu).obj W'' ⟶ W'' :=
        fun W'' =>
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.CategoryStruct.id W''.left)
            ((CategoryTheory.Category.id_comp W''.hom).trans
              ((CategoryTheory.Category.comp_id (X := W''.left) (Y := U'') W''.hom).symm.trans
                (congrArg (W''.hom ≫ ·) h_eq.symm)))
      { hom :=
          { hom :=
              { app := fun W'' => 𝒢.obj.map (e_hom W''.unop).op
                naturality := fun {W''₁ W''₂} f => by
                  change 𝒢.obj.map ((F_end u hu).map f.unop).op ≫ 𝒢.obj.map (e_hom W''₂.unop).op =
                    𝒢.obj.map (e_hom W''₁.unop).op ≫ 𝒢.obj.map f
                  rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← op_comp]
                  have hop : (e_hom W''₁.unop).op ≫ f = (f.unop ≫ e_hom W''₁.unop).op := rfl
                  rw [hop]
                  refine congrArg 𝒢.obj.map (congrArg Opposite.op ?_)
                  apply CategoryTheory.MorphismProperty.Over.Hom.ext
                  exact (CategoryTheory.Category.id_comp f.unop.left).trans
                    (CategoryTheory.Category.comp_id f.unop.left).symm } }
        inv :=
          { hom :=
              { app := fun W'' => 𝒢.obj.map (e_inv W''.unop).op
                naturality := fun {W''₁ W''₂} f => by
                  change 𝒢.obj.map f ≫ 𝒢.obj.map (e_inv W''₂.unop).op =
                    𝒢.obj.map (e_inv W''₁.unop).op ≫ 𝒢.obj.map ((F_end u hu).map f.unop).op
                  rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← op_comp]
                  have hop : f ≫ (e_inv W''₂.unop).op = (e_inv W''₂.unop ≫ f.unop).op := rfl
                  rw [hop]
                  refine congrArg 𝒢.obj.map (congrArg Opposite.op ?_)
                  apply CategoryTheory.MorphismProperty.Over.Hom.ext
                  exact (CategoryTheory.Category.id_comp f.unop.left).trans
                    (CategoryTheory.Category.comp_id f.unop.left).symm } }
        hom_inv_id := by
          apply CategoryTheory.Sheaf.hom_ext
          ext W'' : 2
          change 𝒢.obj.map (e_hom W''.unop).op ≫ 𝒢.obj.map (e_inv W''.unop).op =
            𝟙 (𝒢.obj.obj (Opposite.op ((F_end u hu).obj W''.unop)))
          rw [← 𝒢.obj.map_comp, ← op_comp]
          have hid : e_inv W''.unop ≫ e_hom W''.unop = 𝟙 _ :=
            CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
          rw [hid]
          exact 𝒢.obj.map_id _
        inv_hom_id := by
          apply CategoryTheory.Sheaf.hom_ext
          ext W'' : 2
          change 𝒢.obj.map (e_inv W''.unop).op ≫ 𝒢.obj.map (e_hom W''.unop).op =
            𝟙 (𝒢.obj.obj (Opposite.op W''.unop))
          rw [← 𝒢.obj.map_comp, ← op_comp]
          have hid : e_hom W''.unop ≫ e_inv W''.unop = 𝟙 _ :=
            CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
          rw [hid]
          exact 𝒢.obj.map_id _ }

  have h_iso_id_nat : ∀ (u : U'' ⟶ U'') (hu : AlgebraicGeometry.Etale u)
      (h_eq : u = CategoryTheory.CategoryStruct.id U'')
      {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf U''.smallEtaleTopology AddCommGrpCat.{u}} (φ : 𝒢₁ ⟶ 𝒢₂),
      (L_end u hu).map φ ≫ (iso_L_id_of_eq u hu h_eq 𝒢₂).hom =
        (iso_L_id_of_eq u hu h_eq 𝒢₁).hom ≫ φ := by
    intro u hu h_eq 𝒢₁ 𝒢₂ φ
    apply CategoryTheory.Sheaf.hom_ext
    ext W'' : 2
    exact (φ.hom.naturality _).symm

  have hδ_comp_of_eq : ∀ (u₁ u₂ w : U'' ⟶ U'') (hu₁ : AlgebraicGeometry.Etale u₁)
      (hu₂ : AlgebraicGeometry.Etale u₂) (hw : AlgebraicGeometry.Etale w)
      (h_eq : w = u₁ ≫ u₂) (B : AddCommGrpCat.{u}),
      δ_end u₁ hu₁ B ≫ (L_end u₁ hu₁).map (δ_end u₂ hu₂ B) ≫
        (iso_L_comp_of_eq u₁ u₂ w hu₁ hu₂ hw h_eq (C_U''.obj B)).hom =
        δ_end w hw B := by
    intro u₁ u₂ w hu₁ hu₂ hw h_eq B
    apply (adj''.homEquiv B ((L_end w hw).obj (C_U''.obj B))).injective
    rw [adj''.homEquiv_unit, adj''.homEquiv_unit]
    let g₁ := (hT_U''.from ((F_end u₁ hu₁).obj T_U'')).op
    let g₂ := (hT_U''.from ((F_end u₂ hu₂).obj T_U'')).op
    let gw := (hT_U''.from ((F_end w hw).obj T_U'')).op
    let e_c : (F_end w hw).obj T_U'' ⟶ (F_end u₂ hu₂).obj ((F_end u₁ hu₁).obj T_U'') :=
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.CategoryStruct.id T_U''.left)
        ((CategoryTheory.Category.id_comp ((T_U''.hom ≫ u₁) ≫ u₂)).trans
          ((CategoryTheory.Category.assoc T_U''.hom u₁ u₂).trans
            (congrArg (T_U''.hom ≫ ·) h_eq.symm)))
    have h₀ : adj''.unit.app B ≫
        ((CategoryTheory.sheafSections U''.smallEtaleTopology AddCommGrpCat.{u}).obj
          (Opposite.op T_U'')).map
          (δ_end u₁ hu₁ B ≫ (L_end u₁ hu₁).map (δ_end u₂ hu₂ B) ≫
            (iso_L_comp_of_eq u₁ u₂ w hu₁ hu₂ hw h_eq (C_U''.obj B)).hom) =
        (adj''.unit.app B ≫
          ((δ_end u₁ hu₁ B).hom.app (Opposite.op T_U'') :
            (C_U''.obj B).obj.obj (Opposite.op T_U'') ⟶
              (C_U''.obj B).obj.obj (Opposite.op ((F_end u₁ hu₁).obj T_U'')))) ≫
          (((δ_end u₂ hu₂ B).hom.app (Opposite.op ((F_end u₁ hu₁).obj T_U'')) :
              (C_U''.obj B).obj.obj (Opposite.op ((F_end u₁ hu₁).obj T_U'')) ⟶
                (C_U''.obj B).obj.obj
                  (Opposite.op ((F_end u₂ hu₂).obj ((F_end u₁ hu₁).obj T_U'')))) ≫
            (C_U''.obj B).obj.map e_c.op) := rfl
    have h₁ : adj''.unit.app B ≫
        ((δ_end u₁ hu₁ B).hom.app (Opposite.op T_U'') :
          (C_U''.obj B).obj.obj (Opposite.op T_U'') ⟶
            (C_U''.obj B).obj.obj (Opposite.op ((F_end u₁ hu₁).obj T_U''))) =
        adj''.unit.app B ≫ (C_U''.obj B).obj.map g₁ := hδ_unit u₁ hu₁ B
    have hnat : (C_U''.obj B).obj.map g₁ ≫
        ((δ_end u₂ hu₂ B).hom.app (Opposite.op ((F_end u₁ hu₁).obj T_U'')) :
          (C_U''.obj B).obj.obj (Opposite.op ((F_end u₁ hu₁).obj T_U'')) ⟶
            (C_U''.obj B).obj.obj
              (Opposite.op ((F_end u₂ hu₂).obj ((F_end u₁ hu₁).obj T_U'')))) =
        ((δ_end u₂ hu₂ B).hom.app (Opposite.op T_U'') :
          (C_U''.obj B).obj.obj (Opposite.op T_U'') ⟶
            (C_U''.obj B).obj.obj (Opposite.op ((F_end u₂ hu₂).obj T_U''))) ≫
          (C_U''.obj B).obj.map ((F_end u₂ hu₂).map (hT_U''.from ((F_end u₁ hu₁).obj T_U''))).op :=
      (δ_end u₂ hu₂ B).hom.naturality g₁
    have h₂ : adj''.unit.app B ≫
        ((δ_end u₂ hu₂ B).hom.app (Opposite.op T_U'') :
          (C_U''.obj B).obj.obj (Opposite.op T_U'') ⟶
            (C_U''.obj B).obj.obj (Opposite.op ((F_end u₂ hu₂).obj T_U''))) =
        adj''.unit.app B ≫ (C_U''.obj B).obj.map g₂ := hδ_unit u₂ hu₂ B
    have h_maps : (C_U''.obj B).obj.map g₂ ≫
        ((C_U''.obj B).obj.map ((F_end u₂ hu₂).map (hT_U''.from ((F_end u₁ hu₁).obj T_U''))).op ≫
          (C_U''.obj B).obj.map e_c.op) =
        (C_U''.obj B).obj.map gw := by
      rw [← (C_U''.obj B).obj.map_comp, ← (C_U''.obj B).obj.map_comp, ← op_comp, ← op_comp]
      exact congrArg (C_U''.obj B).obj.map (congrArg Opposite.op (hT_U''.hom_ext _ _))
    exact h₀.trans
      ((congrArg (· ≫ _) h₁).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (adj''.unit.app B ≫ ·)
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ (C_U''.obj B).obj.map e_c.op) hnat).trans
                  (CategoryTheory.Category.assoc _ _ _)))).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ _) h₂).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (adj''.unit.app B ≫ ·) h_maps).trans
                    (hδ_unit w hw B).symm)))))))

  have hδ_id_of_eq : ∀ (u : U'' ⟶ U'') (hu : AlgebraicGeometry.Etale u)
      (h_eq : u = CategoryTheory.CategoryStruct.id U'') (B : AddCommGrpCat.{u}),
      δ_end u hu B ≫ (iso_L_id_of_eq u hu h_eq (C_U''.obj B)).hom = 𝟙 (C_U''.obj B) := by
    intro u hu h_eq B
    apply (adj''.homEquiv B (C_U''.obj B)).injective
    rw [adj''.homEquiv_unit, adj''.homEquiv_unit]
    let e_id : T_U'' ⟶ (F_end u hu).obj T_U'' :=
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.CategoryStruct.id T_U''.left)
        ((CategoryTheory.Category.id_comp (T_U''.hom ≫ u)).trans
          ((congrArg (T_U''.hom ≫ ·) h_eq).trans
            (CategoryTheory.Category.comp_id (X := T_U''.left) (Y := U'') T_U''.hom)))
    have h₀ : adj''.unit.app B ≫
        ((CategoryTheory.sheafSections U''.smallEtaleTopology AddCommGrpCat.{u}).obj
          (Opposite.op T_U'')).map
          (δ_end u hu B ≫ (iso_L_id_of_eq u hu h_eq (C_U''.obj B)).hom) =
        (adj''.unit.app B ≫
          ((δ_end u hu B).hom.app (Opposite.op T_U'') :
            (C_U''.obj B).obj.obj (Opposite.op T_U'') ⟶
              (C_U''.obj B).obj.obj (Opposite.op ((F_end u hu).obj T_U'')))) ≫
          (C_U''.obj B).obj.map e_id.op := rfl
    have h₁ : adj''.unit.app B ≫
        ((δ_end u hu B).hom.app (Opposite.op T_U'') :
          (C_U''.obj B).obj.obj (Opposite.op T_U'') ⟶
            (C_U''.obj B).obj.obj (Opposite.op ((F_end u hu).obj T_U''))) =
        adj''.unit.app B ≫ (C_U''.obj B).obj.map (hT_U''.from ((F_end u hu).obj T_U'')).op :=
      hδ_unit u hu B
    have h_maps : (C_U''.obj B).obj.map (hT_U''.from ((F_end u hu).obj T_U'')).op ≫
        (C_U''.obj B).obj.map e_id.op = 𝟙 ((C_U''.obj B).obj.obj (Opposite.op T_U'')) := by
      rw [← (C_U''.obj B).obj.map_comp, ← op_comp]
      have h_end_id : e_id ≫ hT_U''.from ((F_end u hu).obj T_U'') = 𝟙 T_U'' :=
        hT_U''.hom_ext _ _
      rw [h_end_id]
      exact (C_U''.obj B).obj.map_id _
    exact h₀.trans
      ((congrArg (· ≫ _) h₁).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (adj''.unit.app B ≫ ·) h_maps).trans
            ((CategoryTheory.Category.comp_id _).trans
              (CategoryTheory.Category.comp_id _).symm))))

  have hα_id_of_eq : ∀ (u : U'' ⟶ U'') (hu : AlgebraicGeometry.Etale u) (hπ : u ≫ π' = π')
      (h_eq : u = CategoryTheory.CategoryStruct.id U'')
      (ℱ : CategoryTheory.Sheaf U'.smallEtaleTopology AddCommGrpCat.{u}),
      α_end u hu hπ ℱ ≫ (iso_L_id_of_eq u hu h_eq (L_π'.obj ℱ)).hom = 𝟙 (L_π'.obj ℱ) := by
    intro u hu hπ h_eq ℱ
    apply CategoryTheory.Sheaf.hom_ext
    ext W'' : 2
    let e_w : W''.unop ⟶ (F_end u hu).obj W''.unop :=
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.CategoryStruct.id W''.unop.left)
        ((CategoryTheory.Category.id_comp (W''.unop.hom ≫ u)).trans
          ((congrArg (W''.unop.hom ≫ ·) h_eq).trans
            (CategoryTheory.Category.comp_id (X := W''.unop.left) (Y := U'') W''.unop.hom)))
    change ℱ.obj.map (e_u_obj u hu hπ W''.unop).op ≫ ℱ.obj.map (F_π'.map e_w).op =
      𝟙 (ℱ.obj.obj (Opposite.op (F_π'.obj W''.unop)))
    rw [← ℱ.obj.map_comp, ← op_comp]
    have hid : F_π'.map e_w ≫ e_u_obj u hu hπ W''.unop = 𝟙 _ :=
      CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
    rw [hid]
    exact ℱ.obj.map_id _

  have hα_comp_of_eq : ∀ (u₁ u₂ w : U'' ⟶ U'') (hu₁ : AlgebraicGeometry.Etale u₁)
      (hu₂ : AlgebraicGeometry.Etale u₂) (hw : AlgebraicGeometry.Etale w)
      (hπ₁ : u₁ ≫ π' = π') (hπ₂ : u₂ ≫ π' = π') (hπw : w ≫ π' = π')
      (h_eq : w = u₁ ≫ u₂)
      (ℱ : CategoryTheory.Sheaf U'.smallEtaleTopology AddCommGrpCat.{u}),
      α_end u₁ hu₁ hπ₁ ℱ ≫ (L_end u₁ hu₁).map (α_end u₂ hu₂ hπ₂ ℱ) ≫
        (iso_L_comp_of_eq u₁ u₂ w hu₁ hu₂ hw h_eq (L_π'.obj ℱ)).hom =
        α_end w hw hπw ℱ := by
    intro u₁ u₂ w hu₁ hu₂ hw hπ₁ hπ₂ hπw h_eq ℱ
    apply CategoryTheory.Sheaf.hom_ext
    ext W'' : 2
    let e_cw : (F_end w hw).obj W''.unop ⟶ (F_end u₂ hu₂).obj ((F_end u₁ hu₁).obj W''.unop) :=
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.CategoryStruct.id W''.unop.left)
        ((CategoryTheory.Category.id_comp ((W''.unop.hom ≫ u₁) ≫ u₂)).trans
          ((CategoryTheory.Category.assoc W''.unop.hom u₁ u₂).trans
            (congrArg (W''.unop.hom ≫ ·) h_eq.symm)))
    change ℱ.obj.map (e_u_obj u₁ hu₁ hπ₁ W''.unop).op ≫
        (ℱ.obj.map (e_u_obj u₂ hu₂ hπ₂ ((F_end u₁ hu₁).obj W''.unop)).op ≫
          ℱ.obj.map (F_π'.map e_cw).op) =
      ℱ.obj.map (e_u_obj w hw hπw W''.unop).op
    rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp, ← op_comp, ← op_comp]
    refine congrArg ℱ.obj.map (congrArg Opposite.op ?_)
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    change (𝟙 W''.unop.left ≫ 𝟙 W''.unop.left) ≫ 𝟙 W''.unop.left = 𝟙 W''.unop.left
    rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp]

  have hδ_isIso : ∀ (τ : H) (B : AddCommGrpCat.{u}),
      CategoryTheory.IsIso (δ_end (actH τ) (hEt_actH τ) B) := by
    intro τ B
    let u₁ := actH τ
    let u₂ := actH τ⁻¹
    have hu₁ := hEt_actH τ
    have hu₂ := hEt_actH τ⁻¹
    have h₁₂ : CategoryTheory.CategoryStruct.id U'' = u₁ ≫ u₂ := by
      dsimp [u₁, u₂]; rw [← hActH_mul, mul_inv_cancel, hActH_one]
    have h₂₁ : CategoryTheory.CategoryStruct.id U'' = u₂ ≫ u₁ := by
      dsimp [u₁, u₂]; rw [← hActH_mul, inv_mul_cancel, hActH_one]
    have hid_et : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id U'') := inferInstance
    let e₁₂ : ∀ 𝒢, (L_end u₁ hu₁).obj ((L_end u₂ hu₂).obj 𝒢) ≅ 𝒢 :=
      fun 𝒢 => iso_L_comp_of_eq u₁ u₂ _ hu₁ hu₂ hid_et h₁₂ 𝒢 ≪≫ iso_L_id_of_eq _ hid_et rfl 𝒢
    let e₂₁ : ∀ 𝒢, (L_end u₂ hu₂).obj ((L_end u₁ hu₁).obj 𝒢) ≅ 𝒢 :=
      fun 𝒢 => iso_L_comp_of_eq u₂ u₁ _ hu₂ hu₁ hid_et h₂₁ 𝒢 ≪≫ iso_L_id_of_eq _ hid_et rfl 𝒢
    let inv_δ : (L_end u₁ hu₁).obj (C_U''.obj B) ⟶ C_U''.obj B :=
      (L_end u₁ hu₁).map (δ_end u₂ hu₂ B) ≫ (e₁₂ (C_U''.obj B)).hom
    refine ⟨⟨inv_δ, ?_, ?_⟩⟩
    · calc
        δ_end u₁ hu₁ B ≫ inv_δ
          = (δ_end u₁ hu₁ B ≫ (L_end u₁ hu₁).map (δ_end u₂ hu₂ B) ≫
              (iso_L_comp_of_eq u₁ u₂ _ hu₁ hu₂ hid_et h₁₂ (C_U''.obj B)).hom) ≫
              (iso_L_id_of_eq _ hid_et rfl (C_U''.obj B)).hom := by
            simp only [inv_δ, e₁₂, CategoryTheory.Iso.trans_hom, CategoryTheory.Category.assoc]
        _ = δ_end _ hid_et B ≫ (iso_L_id_of_eq _ hid_et rfl (C_U''.obj B)).hom := by
            rw [hδ_comp_of_eq u₁ u₂ _ hu₁ hu₂ hid_et h₁₂ B]
        _ = 𝟙 (C_U''.obj B) := hδ_id_of_eq _ hid_et rfl B
    · have he_nat : (e₁₂ (C_U''.obj B)).hom ≫ δ_end u₁ hu₁ B =
          (L_end u₁ hu₁).map ((L_end u₂ hu₂).map (δ_end u₁ hu₁ B)) ≫
            (e₁₂ ((L_end u₁ hu₁).obj (C_U''.obj B))).hom := by
        dsimp [e₁₂]
        rw [CategoryTheory.Category.assoc, ← h_iso_id_nat _ hid_et rfl (δ_end u₁ hu₁ B),
          ← CategoryTheory.Category.assoc,
          ← h_iso_comp_nat u₁ u₂ _ hu₁ hu₂ hid_et h₁₂ (δ_end u₁ hu₁ B),
          CategoryTheory.Category.assoc]
      have he_whisker : (e₁₂ ((L_end u₁ hu₁).obj (C_U''.obj B))).hom =
          (L_end u₁ hu₁).map (e₂₁ (C_U''.obj B)).hom := by
        apply CategoryTheory.Sheaf.hom_ext
        ext W'' : 2
        let W₁'' := (F_end u₁ hu₁).obj W''.unop
        let m₁a : (F_end _ hid_et).obj W''.unop ⟶ (F_end u₂ hu₂).obj W₁'' :=
          CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id W''.unop.left)
            ((CategoryTheory.Category.id_comp ((W''.unop.hom ≫ u₁) ≫ u₂)).trans
              ((CategoryTheory.Category.assoc W''.unop.hom u₁ u₂).trans
                (congrArg (W''.unop.hom ≫ ·) h₁₂.symm)))
        let m₁b : W''.unop ⟶ (F_end _ hid_et).obj W''.unop :=
          CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id W''.unop.left)
            ((CategoryTheory.Category.id_comp (W''.unop.hom ≫ _)).trans
              (CategoryTheory.Category.comp_id (X := W''.unop.left) (Y := U'') W''.unop.hom))
        let m₂a : (F_end _ hid_et).obj W₁'' ⟶ (F_end u₁ hu₁).obj ((F_end u₂ hu₂).obj W₁'') :=
          CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id W₁''.left)
            ((CategoryTheory.Category.id_comp ((W₁''.hom ≫ u₂) ≫ u₁)).trans
              ((CategoryTheory.Category.assoc W₁''.hom u₂ u₁).trans
                (congrArg (W₁''.hom ≫ ·) h₂₁.symm)))
        let m₂b : W₁'' ⟶ (F_end _ hid_et).obj W₁'' :=
          CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id W₁''.left)
            ((CategoryTheory.Category.id_comp (W₁''.hom ≫ _)).trans
              (CategoryTheory.Category.comp_id (X := W₁''.left) (Y := U'') W₁''.hom))
        change (C_U''.obj B).obj.map ((F_end u₁ hu₁).map m₁a).op ≫
            (C_U''.obj B).obj.map ((F_end u₁ hu₁).map m₁b).op =
          (C_U''.obj B).obj.map m₂a.op ≫ (C_U''.obj B).obj.map m₂b.op
        rw [← (C_U''.obj B).obj.map_comp, ← (C_U''.obj B).obj.map_comp, ← op_comp, ← op_comp]
        refine congrArg (C_U''.obj B).obj.map (congrArg Opposite.op ?_)
        exact CategoryTheory.MorphismProperty.Over.Hom.ext rfl
      dsimp [inv_δ]
      rw [CategoryTheory.Category.assoc, he_nat, he_whisker,
        ← CategoryTheory.Category.assoc, ← (L_end u₁ hu₁).map_comp,
        ← (L_end u₁ hu₁).map_comp]
      have h₂₁_id : δ_end u₂ hu₂ B ≫ (L_end u₂ hu₂).map (δ_end u₁ hu₁ B) ≫
          (e₂₁ (C_U''.obj B)).hom = 𝟙 (C_U''.obj B) := by
        calc
          δ_end u₂ hu₂ B ≫ (L_end u₂ hu₂).map (δ_end u₁ hu₁ B) ≫ (e₂₁ (C_U''.obj B)).hom
            = (δ_end u₂ hu₂ B ≫ (L_end u₂ hu₂).map (δ_end u₁ hu₁ B) ≫
                (iso_L_comp_of_eq u₂ u₁ _ hu₂ hu₁ hid_et h₂₁ (C_U''.obj B)).hom) ≫
                (iso_L_id_of_eq _ hid_et rfl (C_U''.obj B)).hom := by
              simp only [e₂₁, CategoryTheory.Iso.trans_hom, CategoryTheory.Category.assoc]
          _ = δ_end _ hid_et B ≫ (iso_L_id_of_eq _ hid_et rfl (C_U''.obj B)).hom := by
              rw [hδ_comp_of_eq u₂ u₁ _ hu₂ hu₁ hid_et h₂₁ B]
          _ = 𝟙 (C_U''.obj B) := hδ_id_of_eq _ hid_et rfl B
      rw [CategoryTheory.Category.assoc (δ_end u₂ hu₂ B), h₂₁_id, (L_end u₁ hu₁).map_id]

  let Φ_H : H → (C_U''.obj A ⟶ C_U''.obj A) := fun τ =>
    let u := actH τ⁻¹
    let hu := hEt_actH τ⁻¹
    letI := hδ_isIso τ⁻¹ A
    e_triv.inv ≫ α_end u hu (hActH_hom τ⁻¹) ℳ ≫
      (L_end u hu).map e_triv.hom ≫ CategoryTheory.inv (δ_end u hu A)

  let ρ : H → (A ⟶ A) := fun τ => (Function.surjInv hFF_U''.2) (Φ_H τ)
  have hρ_spec : ∀ τ : H, C_U''.map (ρ τ) = Φ_H τ :=
    fun τ => Function.surjInv_eq hFF_U''.2 (Φ_H τ)

  have hΦ_δ : ∀ τ : H,
      C_U''.map (ρ τ) ≫ δ_end (actH τ⁻¹) (hEt_actH τ⁻¹) A =
        e_triv.inv ≫ α_end (actH τ⁻¹) (hEt_actH τ⁻¹) (hActH_hom τ⁻¹) ℳ ≫
          (L_end (actH τ⁻¹) (hEt_actH τ⁻¹)).map e_triv.hom := by
    intro τ
    rw [hρ_spec τ]
    letI := hδ_isIso τ⁻¹ A
    dsimp [Φ_H]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
      CategoryTheory.Category.comp_id]

  have hρ_one : ρ 1 = CategoryTheory.CategoryStruct.id A := by
    apply hFF_U''.1
    have h_u1 : actH (1 : H)⁻¹ = CategoryTheory.CategoryStruct.id U'' := by
      rw [inv_one, hActH_one]
    let e_1 := iso_L_id_of_eq (actH 1⁻¹) (hEt_actH 1⁻¹) h_u1 (C_U''.obj A)
    letI := hδ_isIso 1⁻¹ A
    apply (CategoryTheory.cancel_mono (δ_end (actH 1⁻¹) (hEt_actH 1⁻¹) A)).mp
    suffices h_eq1 : (C_U''.map (ρ 1) ≫ δ_end (actH 1⁻¹) (hEt_actH 1⁻¹) A) ≫ e_1.hom =
        (C_U''.map (CategoryTheory.CategoryStruct.id A) ≫
          δ_end (actH 1⁻¹) (hEt_actH 1⁻¹) A) ≫ e_1.hom by
      have h_eq2 := congrArg (· ≫ e_1.inv) h_eq1
      simpa only [CategoryTheory.Category.assoc, e_1.hom_inv_id,
        CategoryTheory.Category.comp_id] using h_eq2
    rw [hΦ_δ 1, C_U''.map_id,
      CategoryTheory.Category.id_comp, hδ_id_of_eq _ _ h_u1 A]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      h_iso_id_nat _ _ h_u1 e_triv.hom,
      ← CategoryTheory.Category.assoc (α_end _ _ (hActH_hom 1⁻¹) ℳ),
      hα_id_of_eq _ _ (hActH_hom 1⁻¹) h_u1 ℳ,
      CategoryTheory.Category.id_comp, e_triv.inv_hom_id]

  have hρ_mul : ∀ τ₁ τ₂ : H, ρ (τ₁ * τ₂) = ρ τ₂ ≫ ρ τ₁ := by
    intro τ₁ τ₂
    apply hFF_U''.1
    let u₁ := actH τ₂⁻¹
    let u₂ := actH τ₁⁻¹
    let w := actH (τ₁ * τ₂)⁻¹
    have hu₁ := hEt_actH τ₂⁻¹
    have hu₂ := hEt_actH τ₁⁻¹
    have hw := hEt_actH (τ₁ * τ₂)⁻¹
    have h_w_eq : w = u₁ ≫ u₂ := by
      dsimp [w, u₁, u₂]
      rw [mul_inv_rev, hActH_mul]
    letI := hδ_isIso (τ₁ * τ₂)⁻¹ A
    apply (CategoryTheory.cancel_mono (δ_end w hw A)).mp
    calc
      C_U''.map (ρ (τ₁ * τ₂)) ≫ δ_end w hw A
        = e_triv.inv ≫ α_end w hw (hActH_hom (τ₁ * τ₂)⁻¹) ℳ ≫
            (L_end w hw).map e_triv.hom := hΦ_δ (τ₁ * τ₂)
      _ = e_triv.inv ≫
            (α_end u₁ hu₁ (hActH_hom τ₂⁻¹) ℳ ≫
              (L_end u₁ hu₁).map (α_end u₂ hu₂ (hActH_hom τ₁⁻¹) ℳ) ≫
              (iso_L_comp_of_eq u₁ u₂ w hu₁ hu₂ hw h_w_eq (L_π'.obj ℳ)).hom) ≫
            (L_end w hw).map e_triv.hom := by
          rw [← hα_comp_of_eq u₁ u₂ w hu₁ hu₂ hw (hActH_hom τ₂⁻¹) (hActH_hom τ₁⁻¹)
            (hActH_hom (τ₁ * τ₂)⁻¹) h_w_eq ℳ]
      _ = e_triv.inv ≫ α_end u₁ hu₁ (hActH_hom τ₂⁻¹) ℳ ≫
            (L_end u₁ hu₁).map (α_end u₂ hu₂ (hActH_hom τ₁⁻¹) ℳ ≫
              (L_end u₂ hu₂).map e_triv.hom) ≫
            (iso_L_comp_of_eq u₁ u₂ w hu₁ hu₂ hw h_w_eq (C_U''.obj A)).hom := by
          simp only [CategoryTheory.Functor.map_comp, CategoryTheory.Category.assoc]
          rw [← h_iso_comp_nat u₁ u₂ w hu₁ hu₂ hw h_w_eq e_triv.hom]
      _ = (e_triv.inv ≫ α_end u₁ hu₁ (hActH_hom τ₂⁻¹) ℳ ≫
            (L_end u₁ hu₁).map e_triv.hom) ≫
            (L_end u₁ hu₁).map (e_triv.inv ≫ α_end u₂ hu₂ (hActH_hom τ₁⁻¹) ℳ ≫
              (L_end u₂ hu₂).map e_triv.hom) ≫
            (iso_L_comp_of_eq u₁ u₂ w hu₁ hu₂ hw h_w_eq (C_U''.obj A)).hom := by
          simp only [CategoryTheory.Functor.map_comp, CategoryTheory.Category.assoc]
          rw [← CategoryTheory.Category.assoc ((L_end u₁ hu₁).map e_triv.hom)
            ((L_end u₁ hu₁).map e_triv.inv),
            ← (L_end u₁ hu₁).map_comp, e_triv.hom_inv_id, (L_end u₁ hu₁).map_id,
            CategoryTheory.Category.id_comp]
      _ = (C_U''.map (ρ τ₂) ≫ δ_end u₁ hu₁ A) ≫
            (L_end u₁ hu₁).map (C_U''.map (ρ τ₁) ≫ δ_end u₂ hu₂ A) ≫
            (iso_L_comp_of_eq u₁ u₂ w hu₁ hu₂ hw h_w_eq (C_U''.obj A)).hom := by
          rw [← hΦ_δ τ₂, ← hΦ_δ τ₁]
      _ = C_U''.map (ρ τ₂) ≫ C_U''.map (ρ τ₁) ≫
            (δ_end u₁ hu₁ A ≫ (L_end u₁ hu₁).map (δ_end u₂ hu₂ A) ≫
              (iso_L_comp_of_eq u₁ u₂ w hu₁ hu₂ hw h_w_eq (C_U''.obj A)).hom) := by
          simp only [(L_end u₁ hu₁).map_comp, CategoryTheory.Category.assoc]
          rw [← CategoryTheory.Category.assoc (δ_end u₁ hu₁ A)
              ((L_end u₁ hu₁).map (C_U''.map (ρ τ₁))),
            ← hδ_nat u₁ hu₁ (ρ τ₁)]
          simp only [CategoryTheory.Category.assoc]
      _ = C_U''.map (ρ τ₂ ≫ ρ τ₁) ≫ δ_end w hw A := by
          rw [hδ_comp_of_eq u₁ u₂ w hu₁ hu₂ hw h_w_eq A, C_U''.map_comp,
            CategoryTheory.Category.assoc]

  
  have hTorA_elem : ∀ x : ↥A, ℓ • x = 0 := by
    intro x
    exact ConcreteCategory.congr_hom hTorA x
  have hMod_nsmul : ∀ (n : ℕ) (x : ↥A), (n % ℓ) • x = n • x := by
    intro n x
    conv_rhs => rw [← Nat.div_add_mod n ℓ]
    rw [add_nsmul, mul_nsmul, hTorA_elem x, nsmul_zero, zero_add]

  letI instModA : Module (ZMod ℓ) ↥A :=
    { smul := fun c x => c.val • x
      one_smul := fun x => by
        change (1 : ZMod ℓ).val • x = x
        rw [ZMod.val_one, one_nsmul]
      mul_smul := fun c₁ c₂ x => by
        change (c₁ * c₂).val • x = c₁.val • (c₂.val • x)
        rw [ZMod.val_mul, hMod_nsmul, mul_nsmul']
      smul_zero := fun c => nsmul_zero c.val
      smul_add := fun c x y => nsmul_add x y c.val
      add_smul := fun c₁ c₂ x => by
        change (c₁ + c₂).val • x = c₁.val • x + c₂.val • x
        rw [ZMod.val_add, hMod_nsmul, add_nsmul]
      zero_smul := fun x => by
        change (0 : ZMod ℓ).val • x = 0
        rw [ZMod.val_zero, zero_nsmul] }
  haveI : Finite ↥A := hFinA
  haveI : Module.Finite (ZMod ℓ) ↥A := Module.Finite.of_finite

  let m_len : ℕ := Module.finrank (ZMod ℓ) ↥A
  let InvSub := { W : Submodule (ZMod ℓ) ↥A // ∀ (τ : H) (x : ↥A), x ∈ W → (ρ τ) x ∈ W }

  have h_flag_step : ∀ (W : InvSub), W.1 ≠ ⊤ →
      ∃ (W' : InvSub) (v : ↥A),
        W.1 ≤ W'.1 ∧
        Module.finrank (ZMod ℓ) ↥W'.1 = Module.finrank (ZMod ℓ) ↥W.1 + 1 ∧
        v ∈ W'.1 ∧
        (∀ τ : H, (ρ τ) v - v ∈ W.1) ∧
        (∀ x ∈ W'.1, ∃! c : ZMod ℓ, x - c.val • v ∈ W.1) := by
    intro W hW_ne
    let Q := ↥A ⧸ W.1
    letI : MulAction H Q :=
      { smul := fun τ q => Quotient.liftOn' q (fun x => Submodule.Quotient.mk ((ρ τ) x))
          (fun x y hxy => by
            have hmk : (Submodule.Quotient.mk x : Q) = Submodule.Quotient.mk y :=
              Quotient.sound' hxy
            have hsub : x - y ∈ W.1 := (Submodule.Quotient.eq W.1).mp hmk
            apply (Submodule.Quotient.eq W.1).mpr
            have hmap : (ρ τ) x - (ρ τ) y = (ρ τ) (x - y) := (map_sub (ρ τ).hom x y).symm
            rw [hmap]
            exact W.2 τ (x - y) hsub)
        one_smul := fun q => by
          induction q using Quotient.inductionOn' with
          | h x =>
            change Submodule.Quotient.mk ((ρ 1) x) = Submodule.Quotient.mk x
            rw [hρ_one]
            rfl
        mul_smul := fun τ₁ τ₂ q => by
          induction q using Quotient.inductionOn' with
          | h x =>
            change Submodule.Quotient.mk ((ρ (τ₁ * τ₂)) x) =
              Submodule.Quotient.mk ((ρ τ₁) ((ρ τ₂) x))
            rw [hρ_mul]
            rfl }
    haveI : Finite Q := Finite.of_surjective _ (Submodule.Quotient.mk_surjective W.1)
    haveI : Finite ↥(MulAction.fixedPoints H Q) := Subtype.finite
    letI : Fintype ↥(MulAction.fixedPoints H Q) := Fintype.ofFinite _
    haveI : Nontrivial Q := by
      by_contra h_not
      rw [not_nontrivial_iff_subsingleton] at h_not
      apply hW_ne
      rw [eq_top_iff]
      intro x _
      have hx0 : (Submodule.Quotient.mk x : Q) = 0 := Subsingleton.elim _ _
      exact (Submodule.Quotient.mk_eq_zero W.1).mp hx0
    have h_dimQ_pos : 0 < Module.finrank (ZMod ℓ) Q := Module.finrank_pos
    have h_cardQ : Nat.card Q = ℓ ^ Module.finrank (ZMod ℓ) Q := by
      rw [Module.natCard_eq_pow_finrank (K := ZMod ℓ) (V := Q), Nat.card_zmod]
    have h_dvdQ : ℓ ∣ Nat.card Q := by
      rw [h_cardQ]
      exact dvd_pow_self ℓ (by omega)
    have h_modEq : Nat.card Q ≡ Nat.card ↥(MulAction.fixedPoints H Q) [MOD ℓ] :=
      IsPGroup.card_modEq_card_fixedPoints hPGrp Q
    have h_dvd_fix : ℓ ∣ Nat.card ↥(MulAction.fixedPoints H Q) :=
      (Nat.ModEq.dvd_iff h_modEq dvd_rfl).mp h_dvdQ
    have h0_fix : (0 : Q) ∈ MulAction.fixedPoints H Q := by
      intro τ
      change Submodule.Quotient.mk ((ρ τ) 0) = 0
      rw [map_zero, Submodule.Quotient.mk_zero]
    haveI : Nonempty ↥(MulAction.fixedPoints H Q) := ⟨⟨0, h0_fix⟩⟩
    have h_card_fix_pos : 0 < Nat.card ↥(MulAction.fixedPoints H Q) := Nat.card_pos
    have h_card_fix_ge : ℓ ≤ Nat.card ↥(MulAction.fixedPoints H Q) :=
      Nat.le_of_dvd h_card_fix_pos h_dvd_fix
    have h_exists_nz : ∃ q₀ : Q, q₀ ∈ MulAction.fixedPoints H Q ∧ q₀ ≠ 0 := by
      by_contra hall
      have hall' : ∀ q : Q, q ∈ MulAction.fixedPoints H Q → q = 0 :=
        fun q hq => by_contra fun hne => hall ⟨q, hq, hne⟩
      haveI : Subsingleton ↥(MulAction.fixedPoints H Q) :=
        ⟨fun a b => Subtype.ext ((hall' a.1 a.2).trans (hall' b.1 b.2).symm)⟩
      have h_le1 : Nat.card ↥(MulAction.fixedPoints H Q) ≤ 1 := by
        rw [Nat.card_eq_fintype_card]
        exact Fintype.card_le_one_iff_subsingleton.mpr inferInstance
      omega
    obtain ⟨q₀, hq₀_fix, hq₀_ne⟩ := h_exists_nz
    obtain ⟨v₀, hv₀_mk⟩ := Submodule.Quotient.mk_surjective W.1 q₀
    have hv₀_ne : v₀ ≠ 0 := by
      rintro rfl
      exact hq₀_ne (hv₀_mk.symm.trans (Submodule.Quotient.mk_zero W.1))
    let W'_sub : Submodule (ZMod ℓ) ↥A :=
      W.1 ⊔ Submodule.span (ZMod ℓ) ({v₀} : Set ↥A)
    have hv₀_fix : ∀ τ : H, (ρ τ) v₀ - v₀ ∈ W.1 := by
      intro τ
      apply (Submodule.Quotient.eq W.1).mp
      have hτ := hq₀_fix τ
      rw [← hv₀_mk] at hτ
      exact hτ
    have h_unique_c : ∀ x ∈ W'_sub, ∃! c : ZMod ℓ, x - c.val • v₀ ∈ W.1 := by
      intro x hx
      rw [Submodule.mem_sup] at hx
      obtain ⟨w, hw, z, hz, rfl⟩ := hx
      rw [Submodule.mem_span_singleton] at hz
      obtain ⟨c₀, rfl⟩ := hz
      refine ⟨c₀, ?_, ?_⟩
      · change (w + c₀ • v₀) - c₀ • v₀ ∈ W.1
        rwa [add_sub_cancel_right]
      · intro c₁ hc₁
        change (w + c₀ • v₀) - c₁ • v₀ ∈ W.1 at hc₁
        have hdiff : (c₀ - c₁) • v₀ ∈ W.1 := by
          have heq : (w + c₀ • v₀) - c₁ • v₀ - w = (c₀ - c₁) • v₀ := by
            rw [sub_smul]; abel
          rw [← heq]
          exact W.1.sub_mem hc₁ hw
        have hq_zero : (c₀ - c₁) • q₀ = 0 := by
          rw [← hv₀_mk, ← Submodule.Quotient.mk_smul]
          exact (Submodule.Quotient.mk_eq_zero W.1).mpr hdiff
        rcases smul_eq_zero.mp hq_zero with hc_eq | hq_eq
        · exact (sub_eq_zero.mp hc_eq).symm
        · exact False.elim (hq₀_ne hq_eq)
    have hW'_inv : ∀ (τ : H) (x : ↥A), x ∈ W'_sub → (ρ τ) x ∈ W'_sub := by
      intro τ x hx
      obtain ⟨c, hc, -⟩ := h_unique_c x hx
      have h₁ : (ρ τ) (x - c.val • v₀) ∈ W.1 := W.2 τ _ hc
      have h₂ : c • ((ρ τ) v₀ - v₀) ∈ W.1 := W.1.smul_mem c (hv₀_fix τ)
      have h₃ : (ρ τ) x - c • v₀ ∈ W.1 := by
        have heq : (ρ τ) (x - c.val • v₀) + c • ((ρ τ) v₀ - v₀) = (ρ τ) x - c • v₀ := by
          change (ρ τ).hom (x - c.val • v₀) + c.val • ((ρ τ) v₀ - v₀) = (ρ τ) x - c.val • v₀
          rw [map_sub, map_nsmul, nsmul_sub]
          abel
        rw [← heq]
        exact W.1.add_mem h₁ h₂
      have hx' : (ρ τ) x = ((ρ τ) x - c • v₀) + c • v₀ := (sub_add_cancel _ _).symm
      rw [hx']
      exact Submodule.add_mem_sup h₃ (Submodule.mem_span_singleton.mpr ⟨c, rfl⟩)
    have h_inf_bot : W.1 ⊓ Submodule.span (ZMod ℓ) ({v₀} : Set ↥A) = ⊥ := by
      rw [eq_bot_iff]
      intro y hy
      rcases hy with ⟨hyW, hyS⟩
      change y ∈ Submodule.span (ZMod ℓ) ({v₀} : Set ↥A) at hyS
      rw [Submodule.mem_span_singleton] at hyS
      obtain ⟨c, rfl⟩ := hyS
      have hq_zero : c • q₀ = 0 := by
        rw [← hv₀_mk, ← Submodule.Quotient.mk_smul]
        exact (Submodule.Quotient.mk_eq_zero W.1).mpr hyW
      rcases smul_eq_zero.mp hq_zero with rfl | hq_eq
      · simp
      · exact False.elim (hq₀_ne hq_eq)
    have h_dim_W' : Module.finrank (ZMod ℓ) ↥W'_sub = Module.finrank (ZMod ℓ) ↥W.1 + 1 := by
      have hsup := Submodule.finrank_sup_add_finrank_inf_eq W.1
        (Submodule.span (ZMod ℓ) ({v₀} : Set ↥A))
      rw [h_inf_bot, finrank_bot, add_zero, finrank_span_singleton hv₀_ne] at hsup
      exact hsup
    refine ⟨⟨W'_sub, hW'_inv⟩, v₀, le_sup_left, h_dim_W', ?_, hv₀_fix, h_unique_c⟩
    exact Submodule.mem_sup_right (Submodule.mem_span_singleton_self v₀)

  let flag_seq : ℕ → InvSub :=
    Nat.rec ⟨⊥, fun τ x hx => by rw [Submodule.mem_bot] at hx; subst hx; simp⟩
      (fun _ prev =>
        if h : prev.1 = ⊤ then prev else (h_flag_step prev h).choose)

  have h_flag_dim : ∀ k : ℕ, k ≤ m_len →
      Module.finrank (ZMod ℓ) ↥(flag_seq k).1 = k := by
    intro k
    induction k with
    | zero =>
      intro _
      exact finrank_bot (ZMod ℓ) ↥A
    | succ k ih =>
      intro hk
      have hk_lt : k < m_len := by omega
      have h_prev_dim : Module.finrank (ZMod ℓ) ↥(flag_seq k).1 = k := ih (by omega)
      have h_ne_top : (flag_seq k).1 ≠ ⊤ := by
        intro htop
        rw [htop, finrank_top] at h_prev_dim
        dsimp [m_len] at hk_lt
        omega
      have h_succ_eq : flag_seq (k + 1) = (h_flag_step (flag_seq k) h_ne_top).choose := by
        change (if h : (flag_seq k).1 = ⊤ then flag_seq k
          else (h_flag_step (flag_seq k) h).choose) = _
        split_ifs with h_top
        · exact False.elim (h_ne_top h_top)
        · rfl
      rw [h_succ_eq, (h_flag_step (flag_seq k) h_ne_top).choose_spec.choose_spec.2.1, h_prev_dim]

  let A_sub : Fin (m_len + 1) → AddSubgroup ↥A :=
    fun k => (flag_seq k.val).1.toAddSubgroup

  have hA_sub_zero : A_sub 0 = ⊥ := rfl
  have hA_sub_last : A_sub (Fin.last m_len) = ⊤ := by
    have htop_sub : (flag_seq m_len).1 = ⊤ :=
      Submodule.eq_top_of_finrank_eq (h_flag_dim m_len (le_refl m_len))
    change (flag_seq m_len).1.toAddSubgroup = ⊤
    rw [htop_sub]
    rfl
  have hA_sub_inv : ∀ (k : Fin (m_len + 1)) (τ : H) (x : ↥A),
      x ∈ A_sub k → (ρ τ) x ∈ A_sub k :=
    fun k τ x hx => (flag_seq k.val).2 τ x hx
  have hA_sub_step : ∀ r : Fin m_len,
      A_sub r.castSucc ≤ A_sub r.succ ∧
        ∃ v_r : ↥A, v_r ∈ A_sub r.succ ∧
          (∀ τ : H, (ρ τ) v_r - v_r ∈ A_sub r.castSucc) ∧
          (∀ x ∈ A_sub r.succ, ∃! c : ZMod ℓ, x - c.val • v_r ∈ A_sub r.castSucc) := by
    intro r
    have hr_dim : Module.finrank (ZMod ℓ) ↥(flag_seq r.val).1 = r.val :=
      h_flag_dim r.val (Nat.le_of_lt r.isLt)
    have h_ne_top : (flag_seq r.val).1 ≠ ⊤ := by
      intro htop
      rw [htop, finrank_top] at hr_dim
      exact Nat.ne_of_lt r.isLt hr_dim.symm
    have h_succ_eq : flag_seq r.succ.val = (h_flag_step (flag_seq r.val) h_ne_top).choose := by
      change (if h : (flag_seq r.val).1 = ⊤ then flag_seq r.val
        else (h_flag_step (flag_seq r.val) h).choose) = _
      split_ifs with h_top
      · exact False.elim (h_ne_top h_top)
      · rfl
    let spec := (h_flag_step (flag_seq r.val) h_ne_top).choose_spec
    refine ⟨?_, spec.choose, ?_, spec.choose_spec.2.2.2.1, ?_⟩
    · intro x hx
      change x ∈ (flag_seq r.succ.val).1
      rw [h_succ_eq]
      exact spec.choose_spec.1 hx
    · change spec.choose ∈ (flag_seq r.succ.val).1
      rw [h_succ_eq]
      exact spec.choose_spec.2.2.1
    · intro x hx
      change x ∈ (flag_seq r.succ.val).1 at hx
      rw [h_succ_eq] at hx
      exact spec.choose_spec.2.2.2.2 x hx


  
  
  
