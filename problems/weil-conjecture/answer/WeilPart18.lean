               change (CategoryTheory.Abelian.Ext.mk₀
                 ((adj_sh'.homEquiv (P_free E) ℳ₀).symm (psh_from_sec E (s₁ + s₂))) :
                 CategoryTheory.Abelian.Ext (S_free E) ℳ₀ 0) =
                 CategoryTheory.Abelian.Ext.mk₀ g₁ + CategoryTheory.Abelian.Ext.mk₀ g₂
