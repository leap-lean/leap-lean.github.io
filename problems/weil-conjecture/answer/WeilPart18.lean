      rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support]
      exact AlgebraicGeometry.Scheme.IdealSheafData.le_support_iff_le_vanishingIdeal.mp hSuppLe
    have hRadLe : g.ker.radical ≤ g.ker := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.le_def]
      intro U r hr
      rw [AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal] at hr
      obtain ⟨n, hn⟩ := hr
