      have hψ₀_app : adj₂.unit.app A ≫ ψ₀_T₂ =
          adj₁.unit.app A ≫ (C₁.obj A).obj.map v₂₁.op :=
        (CategoryTheory.Adjunction.homEquiv_unit adj₂ A (P_push.obj (C₁.obj A)) ψ₀).symm.trans
          hψ₀_adj
      have hψ_T₁ : ψ_T₁ =
          ψ₀_ΦT₁ ≫ (C₁.obj A).obj.map (adj_site.unit.app T₁).op := by
        have h1 : ψ = j_pull.map ψ₀ ≫ adj_sh.counit.app (C₁.obj A) :=
          adj_sh.homEquiv_counit _ _ ψ₀
        change ψ.hom.app (Opposite.op T₁) = _
        rw [h1]
        change ψ₀_ΦT₁ ≫ (adj_sh.counit.app (C₁.obj A)).hom.app (Opposite.op T₁) = _
        congr 1
      have hθψ : θ ≫ ψ = 𝟙 (C₁.obj A) := by
        apply (adj₁.homEquiv A (C₁.obj A)).injective
        rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
        change adj₁.unit.app A ≫ (θ_T₁ ≫ ψ_T₁) = adj₁.unit.app A ≫ 𝟙 _
        have hnat : (C₂.obj A).obj.map u₁₂.op ≫ ψ₀_ΦT₁ =
            ψ₀_T₂ ≫ (C₁.obj A).obj.map (B_h.map u₁₂).op :=
          ψ₀.hom.naturality u₁₂.op
        have hTermEq : adj_site.unit.app T₁ ≫ B_h.map u₁₂ ≫ v₂₁ = 𝟙 T₁ :=
          hT₁.hom_ext _ _
        calc
          adj₁.unit.app A ≫ (θ_T₁ ≫ ψ_T₁) = (adj₁.unit.app A ≫ θ_T₁) ≫ ψ_T₁ :=
            (Category.assoc _ _ _).symm
          _ = (adj₂.unit.app A ≫ (C₂.obj A).obj.map u₁₂.op) ≫
                (ψ₀_ΦT₁ ≫ (C₁.obj A).obj.map (adj_site.unit.app T₁).op) := by
            rw [hθ_app, hψ_T₁]
          _ = adj₂.unit.app A ≫ (((C₂.obj A).obj.map u₁₂.op ≫ ψ₀_ΦT₁) ≫
                (C₁.obj A).obj.map (adj_site.unit.app T₁).op) := by
            simp only [Category.assoc]
          _ = (adj₂.unit.app A ≫ ψ₀_T₂) ≫
                ((C₁.obj A).obj.map (B_h.map u₁₂).op ≫
                  (C₁.obj A).obj.map (adj_site.unit.app T₁).op) := by
            rw [hnat]; simp only [Category.assoc]
          _ = adj₁.unit.app A ≫ ((C₁.obj A).obj.map v₂₁.op ≫
                (C₁.obj A).obj.map (B_h.map u₁₂).op ≫
                (C₁.obj A).obj.map (adj_site.unit.app T₁).op) := by
            rw [hψ₀_app]; simp only [Category.assoc]
          _ = adj₁.unit.app A ≫
                (C₁.obj A).obj.map (adj_site.unit.app T₁ ≫ B_h.map u₁₂ ≫ v₂₁).op := by
            rw [← (C₁.obj A).obj.map_comp, ← (C₁.obj A).obj.map_comp, ← op_comp, ← op_comp,
              Category.assoc]
          _ = adj₁.unit.app A ≫ 𝟙 _ := by
            rw [hTermEq]
            exact congrArg (adj₁.unit.app A ≫ ·) ((C₁.obj A).obj.map_id (Opposite.op T₁))
      have hψθ : ψ ≫ θ = 𝟙 (j_pull.obj (C₂.obj A)) := by
        apply (adj_sh.homEquiv (C₂.obj A) (j_pull.obj (C₂.obj A))).injective
        apply (adj₂.homEquiv A (P_push.obj (j_pull.obj (C₂.obj A)))).injective
        have hL : adj_sh.homEquiv _ _ (ψ ≫ θ) = ψ₀ ≫ P_push.map θ := by
          rw [CategoryTheory.Adjunction.homEquiv_unit,
            CategoryTheory.Functor.map_comp, ← Category.assoc]
