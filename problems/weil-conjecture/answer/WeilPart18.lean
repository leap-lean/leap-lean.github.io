    AlgebraicGeometry.IsOpenImmersion.lift U₀.ι U_aff.ι h_range_Uaff
  have hj_aff_fac : j_aff ≫ U₀.ι = U_aff.ι :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U₀.ι U_aff.ι h_range_Uaff
  haveI : AlgebraicGeometry.IsOpenImmersion (j_aff ≫ U₀.ι) := by
    rw [hj_aff_fac]; infer_instance
  haveI : AlgebraicGeometry.IsOpenImmersion j_aff :=
    AlgebraicGeometry.IsOpenImmersion.of_comp j_aff U₀.ι
  let W₀ : U₀.toScheme.Opens := j_aff.opensRange
  have hW₀_aff : AlgebraicGeometry.IsAffineOpen W₀ :=
    AlgebraicGeometry.isAffineOpen_opensRange j_aff
  let V_aff : V₀.Opens := p₀ ⁻¹ᵁ W₀
  have hV_aff : AlgebraicGeometry.IsAffineOpen V_aff := hW₀_aff.preimage p₀
  let R₀_obj := Y₀.presheaf.obj (Opposite.op U_aff)
  let S₀_obj := V₀.presheaf.obj (Opposite.op V_aff)
  let R₀ : Type u := ↑R₀_obj
  let S₀ : Type u := ↑S₀_obj
  let v_aff : AlgebraicGeometry.Spec S₀_obj ⟶ V₀ := hV_aff.fromSpec
  let m_aff : AlgebraicGeometry.Spec S₀_obj ⟶ AlgebraicGeometry.Spec R₀_obj :=
    hV_aff.isoSpec.inv ≫ (p₀ ∣_ W₀) ≫ j_aff.isoOpensRange.inv ≫ hU_aff.isoSpec.hom
  let φ₀_hom : R₀_obj ⟶ S₀_obj := AlgebraicGeometry.Spec.preimage m_aff
  have hSpec_φ₀ : AlgebraicGeometry.Spec.map φ₀_hom = m_aff :=
    AlgebraicGeometry.Spec.map_preimage m_aff
  let φ₀ : R₀ →+* S₀ := φ₀_hom.hom
  have hComm_aff : AlgebraicGeometry.Spec.map φ₀_hom ≫ hU_aff.fromSpec = v_aff ≫ p₀ ≫ U₀.ι := by
    have h_u : hU_aff.isoSpec.hom ≫ hU_aff.fromSpec = U_aff.ι := by
      rw [← hU_aff.isoSpec_inv_ι, Iso.hom_inv_id_assoc]
    have h_j : j_aff.isoOpensRange.inv ≫ U_aff.ι = W₀.ι ≫ U₀.ι := by
      calc j_aff.isoOpensRange.inv ≫ U_aff.ι
        _ = j_aff.isoOpensRange.inv ≫ (j_aff ≫ U₀.ι) :=
            congrArg (j_aff.isoOpensRange.inv ≫ ·) hj_aff_fac.symm
        _ = (j_aff.isoOpensRange.inv ≫ j_aff) ≫ U₀.ι := (Category.assoc _ _ _).symm
        _ = (j_aff.isoOpensRange.inv ≫ (j_aff.isoOpensRange.hom ≫ W₀.ι)) ≫ U₀.ι :=
            congrArg (fun g => (j_aff.isoOpensRange.inv ≫ g) ≫ U₀.ι)
              j_aff.isoOpensRange_hom_ι.symm
        _ = W₀.ι ≫ U₀.ι := by rw [Iso.inv_hom_id_assoc]
    calc AlgebraicGeometry.Spec.map φ₀_hom ≫ hU_aff.fromSpec
      _ = (hV_aff.isoSpec.inv ≫ (p₀ ∣_ W₀) ≫ j_aff.isoOpensRange.inv ≫ hU_aff.isoSpec.hom) ≫
            hU_aff.fromSpec := congrArg (· ≫ hU_aff.fromSpec) hSpec_φ₀
      _ = hV_aff.isoSpec.inv ≫ (p₀ ∣_ W₀) ≫ j_aff.isoOpensRange.inv ≫
            (hU_aff.isoSpec.hom ≫ hU_aff.fromSpec) := by simp only [Category.assoc]
      _ = hV_aff.isoSpec.inv ≫ (p₀ ∣_ W₀) ≫ (j_aff.isoOpensRange.inv ≫ U_aff.ι) := by rw [h_u]
      _ = hV_aff.isoSpec.inv ≫ ((p₀ ∣_ W₀) ≫ W₀.ι) ≫ U₀.ι := by
