        subst hy'_eq
        exact i_Y.isClosedEmbedding.injective (hψP.symm.trans hΦ_eq.symm)
      · rintro rfl
        have hyc_K : i_Y.base y_c ∈ K := hy_mem_preK
        rw [← hψ_range] at hyc_K
        obtain ⟨P, hP_eq⟩ := hyc_K
        refine ⟨P, ?_, hP_eq⟩
        have hJ_le : J_W ≤ P.asIdeal := (hψ_fiber P).mp ⟨y_c, hP_eq.symm⟩
        obtain ⟨Q, rfl⟩ := hLift_prime P hJ_le
        have hQ_Sc0 : Q ∈ S_c0 := ⟨y_c, rfl, hP_eq.symm⟩
        rw [hSc0_zero] at hQ_Sc0
        have he_bar_mem : e_bar ∈ Q.asIdeal := hQ_Sc0 (Set.mem_singleton e_bar)
        rw [← hq_e] at he_bar_mem
        exact Set.singleton_subset_iff.mpr he_bar_mem
    have hyc_not_Fother : i_Y.base y_c ∉ F_other := by
      intro hmem
      have hyc_Fc : i_Y.base y_c ∈ F_c := by
        have : y_c ∈ i_Y.base ⁻¹' F_c := by rw [hpre_Fc]; rfl
        exact this
      exact Set.disjoint_left.mp hF_disj hyc_Fc hmem
    have hFc_sub_U₀ : F_c ⊆ (U₀ : Set ↥Y) := by
      have hE_cl : IsClosed (F_c \ (U₀ : Set ↥Y)) := hFc_cl.sdiff U₀.isOpen
      have hE_disj : Disjoint (F_c \ (U₀ : Set ↥Y)) (Set.range i_Y.base) := by
        rw [Set.disjoint_left]
        rintro x ⟨hxFc, hxNotU₀⟩ ⟨y, rfl⟩
        have hy_eq : y = y_c := by
          have : y ∈ i_Y.base ⁻¹' F_c := hxFc
          rwa [hpre_Fc, Set.mem_singleton_iff] at this
        subst hy_eq
        exact hxNotU₀ hy_U₀
      exact Set.sdiff_eq_empty.mp (hClosed_empty _ hE_cl hE_disj)
    let U₁ : Y.Opens := U₀ ⊓ ⟨F_otherᶜ, hFother_cl.isOpen_compl⟩
    let U₂ : Y.Opens := ⟨F_cᶜ, hFc_cl.isOpen_compl⟩
    refine ⟨U₁, U₂, inf_le_left, ⟨hy_U₀, hyc_not_Fother⟩, ?_, ?_, ?_⟩
    · ext x
      simp only [TopologicalSpace.Opens.coe_sup, Set.mem_union, SetLike.mem_coe,
        TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      by_cases hx : x ∈ F_c
      · left
        exact ⟨hFc_sub_U₀ hx, fun hoth => Set.disjoint_left.mp hF_disj hx hoth⟩
      · right
        exact hx
    · rintro x ⟨⟨hxU₀, hxNotOth⟩, hxNotFc⟩
      by_contra hxNotBasic
      have hxZ₁ : x ∈ Z₁ := ⟨hxU₀, hxNotBasic⟩
      have hxK : x ∈ K := subset_closure hxZ₁
      rw [← hF_union] at hxK
      rcases hxK with h1 | h2
      · exact hxNotFc h1
      · exact hxNotOth h2
    · change i_Y.base ⁻¹' (F_cᶜ) = ({y_c} : Set ↥Y₀)ᶜ
      rw [Set.preimage_compl, hpre_Fc]
  rcases hIsolation with ⟨U₁, U₂, hU₁_le, hy_U₁, hcov_12, hinter_le, hU₂_Y₀⟩
  
  let g_sec : ↑(Y.presheaf.obj (Opposite.op U₁)) :=
    (Y.presheaf.map (CategoryTheory.homOfLE hU₁_le).op).hom g₀
  have hP_mem : P_c ∈ (TopologicalSpace.Opens.map ((ν_c ≫ ι_c) ≫ i_Y).base).obj U₁ := hy_U₁
  refine ⟨P_c, U₁, U₂, g_sec, hP_mem, hP_cl, hP_Vc, hcov_12, ?_, hU₂_Y₀, ?_, ?_⟩
  · have hmap_eq : Y.presheaf.map (CategoryTheory.homOfLE hU₁_le).op ≫
        Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op =
        Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le g₀)).op ≫
          Y.presheaf.map (CategoryTheory.homOfLE hinter_le).op := by
      rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp]
      congr 1
    have hres_eq : (Y.presheaf.map
        (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g_sec =
        (Y.presheaf.map (CategoryTheory.homOfLE hinter_le).op).hom
          ((Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le g₀)).op).hom g₀) :=
      congrArg (fun h => h.hom g₀) hmap_eq
    rw [hres_eq]
    exact (Y.toRingedSpace.isUnit_res_basicOpen g₀).map _
  · change (ν_c ≫ ι_c).base ⁻¹' ((TopologicalSpace.Opens.map i_Y.base).obj U₂ : Set ↥Y₀) =
      ({P_c} : Set ↥C_c.left)ᶜ
    rw [hU₂_Y₀, Set.preimage_compl, hPre_Pc]
  · have hgerm_eq : (C_c.left.presheaf.germ
          ((TopologicalSpace.Opens.map ((ν_c ≫ ι_c) ≫ i_Y).base).obj U₁) P_c hP_mem).hom
        ((((ν_c ≫ ι_c) ≫ i_Y).app U₁).hom g_sec) =
        (C_c.left.presheaf.germ
          ((TopologicalSpace.Opens.map (ν_c ≫ ι_c).base).obj U₀_k) P_c hP_U₀).hom
        (((ν_c ≫ ι_c).app U₀_k).hom ((i_Y.app U₀).hom g₀)) := by
      dsimp only [g_sec]
      have hle_C : (TopologicalSpace.Opens.map ((ν_c ≫ ι_c) ≫ i_Y).base).obj U₁ ≤
          (TopologicalSpace.Opens.map ((ν_c ≫ ι_c) ≫ i_Y).base).obj U₀ :=
        fun _ hx => hU₁_le hx
      have hnat : (((ν_c ≫ ι_c) ≫ i_Y).app U₁).hom
          ((Y.presheaf.map (CategoryTheory.homOfLE hU₁_le).op).hom g₀) =
          (C_c.left.presheaf.map (CategoryTheory.homOfLE hle_C).op).hom
            ((((ν_c ≫ ι_c) ≫ i_Y).app U₀).hom g₀) :=
        congrArg (fun h => h.hom g₀)
          (((ν_c ≫ ι_c) ≫ i_Y).naturality (CategoryTheory.homOfLE hU₁_le).op)
      rw [hnat]
      have h1 : (C_c.left.presheaf.germ
            ((TopologicalSpace.Opens.map ((ν_c ≫ ι_c) ≫ i_Y).base).obj U₁) P_c hP_mem).hom
          ((C_c.left.presheaf.map (CategoryTheory.homOfLE hle_C).op).hom
            ((((ν_c ≫ ι_c) ≫ i_Y).app U₀).hom g₀)) =
          (C_c.left.presheaf.germ
            ((TopologicalSpace.Opens.map ((ν_c ≫ ι_c) ≫ i_Y).base).obj U₀) P_c hP_U₀).hom
          ((((ν_c ≫ ι_c) ≫ i_Y).app U₀).hom g₀) :=
        TopCat.Presheaf.germ_res_apply C_c.left.presheaf (CategoryTheory.homOfLE hle_C)
          P_c hP_mem ((((ν_c ≫ ι_c) ≫ i_Y).app U₀).hom g₀)
      refine h1.trans ?_
      rw [AlgebraicGeometry.Scheme.Hom.comp_app]
      rfl
    rw [hgerm_eq]
    exact hSpan_g₀

theorem weil_etale_two_open_mayer_vietoris_pullback_and_kummer_vanishing (Y : AlgebraicGeometry.Scheme.{u})
    (U₁ U₂ : Y.Opens) (hcov : U₁ ⊔ U₂ = ⊤)
    (u₁₂ : Units ↑(Y.presheaf.obj (Opposite.op (U₁ ⊓ U₂))))
    (hGm : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilEtaleGmPresheaf Z)) :
    ∃ ξ_Y : (weilEtaleGmSheaf Y).H 1,
      (∀ (W : AlgebraicGeometry.Scheme.{u}) (h' : W ⟶ Y) (m : ℕ)
         (ι_kum : weilEtaleTorsionSheaf Y m ⟶ weilEtaleGmSheaf Y)
         (p_kum : weilEtaleGmSheaf Y ⟶ weilEtaleGmSheaf Y)
         (h0 : ι_kum ≫ p_kum = 0)
         (hSE : (CategoryTheory.ShortComplex.mk ι_kum p_kum h0).ShortExact)
         (φ' : weilEtaleTorsionH Y m 2 →+ weilEtaleTorsionH W m 2),
        WeilTopDegTorsionPullback h' m 2 φ' →
        (TopologicalSpace.Opens.map h'.base).obj U₂ = ⊤ →
        φ' (ξ_Y.comp hSE.extClass (rfl : 1 + 1 = 2)) = 0) ∧
      (∀ (X : AlgebraicGeometry.Scheme.{u}) (h : X ⟶ Y) (m : ℕ)
         (ι_kum : weilEtaleTorsionSheaf Y m ⟶ weilEtaleGmSheaf Y)
         (p_kum : weilEtaleGmSheaf Y ⟶ weilEtaleGmSheaf Y),
        p_kum = m • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf Y) →
        ∀ (h0 : ι_kum ≫ p_kum = 0)
          (hSE : (CategoryTheory.ShortComplex.mk ι_kum p_kum h0).ShortExact)
          (φ : weilEtaleTorsionH Y m 2 →+ weilEtaleTorsionH X m 2),
          WeilTopDegTorsionPullback h m 2 φ →
          φ (ξ_Y.comp hSE.extClass (rfl : 1 + 1 = 2)) = 0 →
          ∃ ξ_X : (weilEtaleGmSheaf X).H 1,
            (∃ η_X : (weilEtaleGmSheaf X).H 1, m • η_X = ξ_X) ∧
            ∀ (K_sh Q_sh : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
              (ι_0 : weilEtaleGmSheaf X ⟶ K_sh)
              (π_0 : K_sh ⟶ Q_sh)
              (h0_0 : ι_0 ≫ π_0 = 0)
              (hSE_0 : (CategoryTheory.ShortComplex.mk ι_0 π_0 h0_0).ShortExact),
              let W₁ : X.Opens := (TopologicalSpace.Opens.map h.base).obj U₁
              let W₂ : X.Opens := (TopologicalSpace.Opens.map h.base).obj U₂
              let W₁₂ : X.Opens := W₁ ⊓ W₂
              let V₁ : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁.ι
                (inferInstance : AlgebraicGeometry.Etale W₁.ι)
              let V₂ : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₂.ι
                (inferInstance : AlgebraicGeometry.Etale W₂.ι)
              let V₁₂ : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁₂.ι
                (inferInstance : AlgebraicGeometry.Etale W₁₂.ι)
              let j₁₂_₁ : V₁₂ ⟶ V₁ :=
                CategoryTheory.MorphismProperty.Over.homMk
                  (X.homOfLE inf_le_left) (X.homOfLE_ι inf_le_left)
              let shAdj_X := CategoryTheory.sheafificationAdjunction
                X.smallEtaleTopology AddCommGrpCat.{u}
              let Fℤ_X := (CategoryTheory.constantSheaf
                X.smallEtaleTopology AddCommGrpCat.{u}).obj
                (AddCommGrpCat.of (ULift.{u} ℤ))
              let u₁_Fℤ := fun (V : X.Etale) =>
                (((shAdj_X.unit.app
                  ((CategoryTheory.Functor.const (Opposite X.Etale)).obj
                    (AddCommGrpCat.of (ULift.{u} ℤ)))).app
                  (Opposite.op V)).hom (ULift.up (1 : ℤ)))
              let u_X_zar : Units ↑(X.presheaf.obj (Opposite.op W₁₂)) :=
                Units.map ((X.presheaf.map
                  (CategoryTheory.eqToHom
                    (rfl : W₁₂ = (TopologicalSpace.Opens.map h.base).obj (U₁ ⊓ U₂))).op).hom.comp
                  (h.app (U₁ ⊓ U₂)).hom).toMonoidHom u₁₂
              let u_X_sh : ↥((weilEtaleGmSheaf X).obj.obj (Opposite.op V₁₂)) :=
                (((shAdj_X.unit.app (weilEtaleGmPresheaf X)).app (Opposite.op V₁₂)).hom
                  (Additive.ofMul (Units.map W₁₂.topIso.inv.hom.toMonoidHom u_X_zar)))
              ∀ (s₁ : ↥(K_sh.obj.obj (Opposite.op V₁)))
                (f_q : Fℤ_X ⟶ Q_sh),
                (K_sh.obj.map j₁₂_₁.op).hom s₁ = (ι_0.hom.app (Opposite.op V₁₂)).hom u_X_sh →
                (f_q.hom.app (Opposite.op V₁)).hom (u₁_Fℤ V₁) =
                  (π_0.hom.app (Opposite.op V₁)).hom s₁ →
                (f_q.hom.app (Opposite.op V₂)).hom (u₁_Fℤ V₂) = 0 →
                ξ_X = (CategoryTheory.Abelian.Ext.mk₀ f_q).comp hSE_0.extClass (Nat.zero_add 1)) :=
by
  have step1_mv : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (O₁ O₂ : Z.Opens) (_ : O₁ ⊔ O₂ = ⊤),
      let J := Z.smallEtaleTopology
      let O₁₂ : Z.Opens := O₁ ⊓ O₂
      let V₁ : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ O₁.ι
        (inferInstance : AlgebraicGeometry.Etale O₁.ι)
      let V₂ : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ O₂.ι
        (inferInstance : AlgebraicGeometry.Etale O₂.ι)
      let V₁₂ : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ O₁₂.ι
        (inferInstance : AlgebraicGeometry.Etale O₁₂.ι)
      let j₁₂_₁ : V₁₂ ⟶ V₁ :=
        CategoryTheory.MorphismProperty.Over.homMk (Z.homOfLE inf_le_left) (Z.homOfLE_ι inf_le_left)
      let j₁₂_₂ : V₁₂ ⟶ V₂ :=
        CategoryTheory.MorphismProperty.Over.homMk (Z.homOfLE inf_le_right) (Z.homOfLE_ι inf_le_right)
      let L : Z.Etale → CategoryTheory.Sheaf J AddCommGrpCat.{u} := fun V =>
        (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
          ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free)
      let L_map : ∀ {V' V : Z.Etale}, (V' ⟶ V) → (L V' ⟶ L V) := fun g =>
        (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map
          (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map g) AddCommGrpCat.free)
      let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
      let Fℤ : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
        (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))
      let u₁_Fℤ : ∀ (V : Z.Etale), ↥(Fℤ.obj.obj (Opposite.op V)) := fun V =>
        (((shAdj.unit.app ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)))).app (Opposite.op V)).hom (ULift.up (1 : ℤ)))
      let evalEquiv : ∀ (V : Z.Etale) (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
          (L V ⟶ F) ≃ ↥(F.obj.obj (Opposite.op V)) := fun V F =>
        ((shAdj.homEquiv ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free) F).trans
          (((CategoryTheory.Adjunction.whiskerRight (Opposite Z.Etale) AddCommGrpCat.adj).homEquiv
            (CategoryTheory.yoneda.obj V) F.obj).trans CategoryTheory.yonedaEquiv))
      let ι_MV : L V₁₂ ⟶ CategoryTheory.Limits.biprod (L V₁) (L V₂) :=
        CategoryTheory.Limits.biprod.lift (L_map j₁₂_₁) (- L_map j₁₂_₂)
      let π_MV : CategoryTheory.Limits.biprod (L V₁) (L V₂) ⟶ Fℤ :=
        CategoryTheory.Limits.biprod.desc ((evalEquiv V₁ Fℤ).symm (u₁_Fℤ V₁))
          ((evalEquiv V₂ Fℤ).symm (u₁_Fℤ V₂))
      ∃ (h0_MV : ι_MV ≫ π_MV = 0)
        (hMV : (CategoryTheory.ShortComplex.mk ι_MV π_MV h0_MV).ShortExact),
        (O₂ = ⊤ → hMV.extClass = 0) ∧
        (∀ (G K_sh Q_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u})
           (ι_0 : G ⟶ K_sh) (π_0 : K_sh ⟶ Q_sh) (h0_0 : ι_0 ≫ π_0 = 0)
           (hSE_0 : (CategoryTheory.ShortComplex.mk ι_0 π_0 h0_0).ShortExact)
           (u : ↥(G.obj.obj (Opposite.op V₁₂)))
           (s₁ : ↥(K_sh.obj.obj (Opposite.op V₁)))
           (f_q : Fℤ ⟶ Q_sh),
          (K_sh.obj.map j₁₂_₁.op).hom s₁ = (ι_0.hom.app (Opposite.op V₁₂)).hom u →
          (f_q.hom.app (Opposite.op V₁)).hom (u₁_Fℤ V₁) = (π_0.hom.app (Opposite.op V₁)).hom s₁ →
          (f_q.hom.app (Opposite.op V₂)).hom (u₁_Fℤ V₂) = 0 →
          hMV.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ ((evalEquiv V₁₂ G).symm u))
            (Nat.add_zero 1) =
            (CategoryTheory.Abelian.Ext.mk₀ f_q).comp hSE_0.extClass (Nat.zero_add 1)) := by
    clear Y U₁ U₂ hcov u₁₂ hGm
    intro Z O₁ O₂ hcov J O₁₂ V₁ V₂ V₁₂ j₁₂_₁ j₁₂_₂ L L_map shAdj Fℤ u₁_Fℤ evalEquiv ι_MV π_MV
    letI : CategoryTheory.Abelian (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance
    letI : CategoryTheory.HasExt (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance
    have eval_post : ∀ (V : Z.Etale) {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (ψ : L V ⟶ F) (α : F ⟶ G),
        evalEquiv V G (ψ ≫ α) = (α.hom.app (Opposite.op V)).hom (evalEquiv V F ψ) := by
      intro V F G ψ α
      dsimp only [evalEquiv, Equiv.trans_apply]
      rw [shAdj.homEquiv_naturality_right ψ α,
        (CategoryTheory.Adjunction.whiskerRight (Opposite Z.Etale)
          AddCommGrpCat.adj).homEquiv_naturality_right _ _,
        CategoryTheory.yonedaEquiv_comp]
      rfl
    have eval_zero : ∀ (V : Z.Etale) (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        evalEquiv V F 0 = 0 := by
      intro V F
      rw [show (0 : L V ⟶ F) = 𝟙 (L V) ≫ 0 by simp, eval_post]
      rfl
    have eval_pre : ∀ {V' V : Z.Etale} (g : V' ⟶ V)
        {F : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (ψ : L V ⟶ F),
        evalEquiv V' F (L_map g ≫ ψ) = (F.obj.map g.op).hom (evalEquiv V F ψ) := by
      intro V' V g F ψ
      dsimp only [evalEquiv, L_map, Equiv.trans_apply]
      rw [shAdj.homEquiv_naturality_left _ ψ]
      change CategoryTheory.yonedaEquiv
          (((CategoryTheory.Adjunction.whiskerRight (Opposite Z.Etale)
            AddCommGrpCat.adj).homEquiv (CategoryTheory.yoneda.obj V') F.obj)
            (((CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale) (Type u)
                AddCommGrpCat.{u}).obj AddCommGrpCat.free).map (CategoryTheory.yoneda.map g) ≫
              (shAdj.homEquiv ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free) F) ψ)) = _
      rw [(CategoryTheory.Adjunction.whiskerRight (Opposite Z.Etale)
          AddCommGrpCat.adj).homEquiv_naturality_left (CategoryTheory.yoneda.map g) _,
        ← CategoryTheory.yonedaEquiv_naturality]
      rfl
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Pℤ := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj Aℤ
    have u₁_map : ∀ {V' V : Z.Etale} (g : V' ⟶ V),
        (Fℤ.obj.map g.op).hom (u₁_Fℤ V) = u₁_Fℤ V' := by
      intro V' V g
      have hnat := (shAdj.unit.app Pℤ).naturality g.op
      have happ := ConcreteCategory.congr_hom hnat (ULift.up (1 : ℤ))
      exact happ.symm
    have termIso : ∀ (T : Z.Etale) (hT : CategoryTheory.Limits.IsTerminal T),
        ∃ e : L T ≅ Fℤ, e.hom = (evalEquiv T Fℤ).symm (u₁_Fℤ T) := by
      intro T hT
      let adjT := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
      let ιT : ↥((L T).obj.obj (Opposite.op T)) := evalEquiv T (L T) (𝟙 (L T))
      let homT : L T ⟶ Fℤ := (evalEquiv T Fℤ).symm (u₁_Fℤ T)
      let gT : Aℤ ⟶ (L T).obj.obj (Opposite.op T) :=
        AddCommGrpCat.ofHom
          { toFun := fun n => n.down • ιT
            map_zero' := zero_zsmul _
            map_add' := fun a b => add_zsmul _ a.down b.down }
      let invT : Fℤ ⟶ L T := (adjT.homEquiv Aℤ (L T)).symm gT
      have hadj_u : adjT.unit.app Aℤ = (shAdj.unit.app Pℤ).app (Opposite.op T) :=
        CategoryTheory.Category.id_comp _
      have hinv_u₁ : (invT.hom.app (Opposite.op T)).hom (u₁_Fℤ T) = ιT := by
        have h1 : adjT.homEquiv Aℤ (L T) invT = gT :=
          (adjT.homEquiv Aℤ (L T)).apply_symm_apply gT
        have h2 : adjT.homEquiv Aℤ (L T) invT =
            adjT.unit.app Aℤ ≫ invT.hom.app (Opposite.op T) :=
          CategoryTheory.Adjunction.homEquiv_unit adjT Aℤ (L T) invT
        have h3 : (adjT.unit.app Aℤ ≫ invT.hom.app (Opposite.op T)).hom (ULift.up (1 : ℤ)) =
            gT.hom (ULift.up (1 : ℤ)) :=
          ConcreteCategory.congr_hom (h2.symm.trans h1) (ULift.up (1 : ℤ))
        rw [hadj_u] at h3
        exact h3.trans (one_zsmul ιT)
      have h_hom_inv : homT ≫ invT = 𝟙 (L T) := by
        apply (evalEquiv T (L T)).injective
        rw [eval_post, Equiv.apply_symm_apply, hinv_u₁]
      have h_inv_hom : invT ≫ homT = 𝟙 Fℤ := by
        apply (adjT.homEquiv Aℤ Fℤ).injective
