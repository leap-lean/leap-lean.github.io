          (Finset.mem_image_of_mem j_b (Finset.mem_univ b)))).hom
        (q_b b)
    have hG_map : ∀ b : Fin m, MvPolynomial.map (c.ι.app j₀).hom (G b) = F_sys b := by
      intro b
      dsimp [G]
      rw [MvPolynomial.map_map]
      have hc_b : (c.ι.app j₀).hom.comp
          (F.map (CategoryTheory.IsFiltered.toSup O_G H_G
            (Finset.mem_image_of_mem j_b (Finset.mem_univ b)))).hom =
          (c.ι.app (j_b b)).hom :=
        RingHom.ext fun y => hc_w _ y
      rw [hc_b, hq_b b]
    let ω : Fin m → Ω := fun k => φ_bar (a₀ k)
    have h_eval_compat : ∀ P : MvPolynomial (Fin m) (F.obj j₀),
        MvPolynomial.eval₂ (φOf j₀) ω P =
          φ_bar (MvPolynomial.eval a₀ (MvPolynomial.map (c.ι.app j₀).hom P)) := by
      intro P
      rw [MvPolynomial.eval_map, MvPolynomial.hom_eval₂, hφ_bar_comp j₀]
    have hG_zero : ∀ b : Fin m, MvPolynomial.eval₂ (φOf j₀) ω (G b) = 0 := by
      intro b
      rw [h_eval_compat (G b), hG_map b]
      have hm := h_mem b
      rwa [hMax_eq, RingHom.mem_ker] at hm
    have hG_det : MvPolynomial.eval₂ (φOf j₀) ω
        ((Matrix.of (fun a b : Fin m => MvPolynomial.pderiv a (G b))).det) ≠ 0 := by
      let M₀ : Matrix (Fin m) (Fin m) (MvPolynomial (Fin m) (F.obj j₀)) :=
        Matrix.of (fun a b => MvPolynomial.pderiv a (G b))
      let M_A : Matrix (Fin m) (Fin m) c.pt :=
        Matrix.of (fun a b => MvPolynomial.eval a₀ (MvPolynomial.pderiv a (F_sys b)))
      change (MvPolynomial.eval₂Hom (φOf j₀) ω) M₀.det ≠ 0
      rw [RingHom.map_det]
      have hmat_eq : (MvPolynomial.eval₂Hom (φOf j₀) ω).mapMatrix M₀ = φ_bar.mapMatrix M_A := by
        ext a b
        change MvPolynomial.eval₂ (φOf j₀) ω (MvPolynomial.pderiv a (G b)) =
          φ_bar (MvPolynomial.eval a₀ (MvPolynomial.pderiv a (F_sys b)))
        rw [h_eval_compat, ← MvPolynomial.pderiv_map, hG_map b]
      rw [hmat_eq, ← RingHom.map_det]
      exact (h_unit.map φ_bar).ne_zero
    obtain ⟨j₁, u, x, hx_zero, hx_ω⟩ := hRoot j₀ m G ω hG_zero hG_det
    let a : Fin m → c.pt := fun k => (c.ι.app j₁).hom (x k)
    refine ⟨a, ?_, ?_⟩
    · intro b
      have h_comp_ι : (c.ι.app j₀).hom = (c.ι.app j₁).hom.comp (F.map u).hom :=
        RingHom.ext fun y => (hc_w u y).symm
      rw [← hG_map b, MvPolynomial.eval_map, h_comp_ι]
      change MvPolynomial.eval₂ ((c.ι.app j₁).hom.comp (F.map u).hom)
        (fun k => (c.ι.app j₁).hom (x k)) (G b) = 0
      rw [← MvPolynomial.hom_eval₂, hx_zero b, map_zero]
    · intro k
      rw [hMax_eq, RingHom.mem_ker, map_sub]
      change φ_bar ((c.ι.app j₁).hom (x k)) - ω k = 0
      rw [hφ_bar_app j₁ (x k), hx_ω k, sub_self]
  exact ⟨J, instCatJ, hFiltJ, F, instAlgF, hEtF, c, algRA, locA,
    hF_alg, hι_alg, ⟨hc⟩, hpA, hSepA, hJacA⟩

theorem weil_jacobian_local_ring_finite_alg_split (A D : Type u) [CommRing A] [IsLocalRing A] [CommRing D] [Algebra A D] [Module.Finite A D]
    (hJac : ∀ (m : ℕ) (F_sys : Fin m → MvPolynomial (Fin m) A) (a₀ : Fin m → A),
      (∀ b : Fin m, MvPolynomial.eval a₀ (F_sys b) ∈ IsLocalRing.maximalIdeal A) →
      IsUnit ((Matrix.of (fun a b : Fin m =>
        MvPolynomial.eval a₀ (MvPolynomial.pderiv a (F_sys b)))).det) →
      ∃ a : Fin m → A,
        (∀ b : Fin m, MvPolynomial.eval a (F_sys b) = 0) ∧
        (∀ a_idx : Fin m, a a_idx - a₀ a_idx ∈ IsLocalRing.maximalIdeal A)) :
    ∃ (r : ℕ) (e : Fin r → D),
      CompleteOrthogonalIdempotents e ∧
      ∀ m : Fin r, IsLocalRing (Localization.Away (e m)) :=
by
  classical
  let m_A : Ideal A := IsLocalRing.maximalIdeal A
  have : m_A.IsMaximal := IsLocalRing.maximalIdeal.isMaximal A
  let I_D : Ideal D := Ideal.map (algebraMap A D) m_A
  let q_D : D →+* (D ⧸ I_D) := Ideal.Quotient.mk I_D
  have : Algebra.IsIntegral A D := Algebra.IsIntegral.of_finite A D
  have poly_coeff_sum : ∀ (s : Finset ℕ) (f : ℕ → Polynomial A) (k : ℕ),
      (∑ i ∈ s, f i).coeff k = ∑ i ∈ s, (f i).coeff k := by
    intro s f k
    induction s using Finset.induction_on with
    | empty => simp
    | insert a s ha ih => simp [Finset.sum_insert ha, ih]
  have monic_expand : ∀ (p : Polynomial A), p.Monic →
      p = Polynomial.X ^ p.natDegree +
        ∑ i ∈ Finset.range p.natDegree, Polynomial.C (p.coeff i) * Polynomial.X ^ i := by
    intro p hp
    ext k
    rw [Polynomial.coeff_add, Polynomial.coeff_X_pow,
      poly_coeff_sum (Finset.range p.natDegree)
        (fun i => Polynomial.C (p.coeff i) * Polynomial.X ^ i) k]
    simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero,
      Finset.sum_ite_eq, Finset.mem_range]
    rcases lt_trichotomy k p.natDegree with hlt | rfl | hgt
    · simp [hlt, ne_of_lt hlt]
    · simp [show p.coeff p.natDegree = 1 from hp.leadingCoeff]
    · have hne : ¬ (k = p.natDegree) := ne_of_gt hgt
      have hnotlt : ¬ (k < p.natDegree) := not_lt.mpr (le_of_lt hgt)
      simp [hne, hnotlt, Polynomial.coeff_eq_zero_of_natDegree_lt hgt]
  
  have idem_eq_zero : ∀ (w : D), IsIdempotentElem w → w ∈ I_D → w = 0 := by
    intro w hw_idem hw_mem
    obtain ⟨Q₀, hQ₀_monic, hQ₀_eval, hQ₀_coeff⟩ :=
      Polynomial.exists_monic_aeval_eq_zero_forall_mem_of_mem_map hw_mem
    let d₀ : ℕ := Q₀.natDegree
    have hw_pow : ∀ k : ℕ, w ^ k * w = w := by
      intro k
      induction k with
      | zero => simp
      | succ k ih => rw [pow_succ, mul_assoc, hw_idem.eq, ih]
    have h_eval_mul : (Polynomial.aeval w Q₀) * w =
        algebraMap A D (1 + ∑ i ∈ Finset.range d₀, Q₀.coeff i) * w := by
      conv_lhs => rw [monic_expand Q₀ hQ₀_monic]
      rw [map_add, map_pow, Polynomial.aeval_X, map_sum]
      simp only [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X]
      rw [add_mul, hw_pow d₀, Finset.sum_mul]
      have h_terms : ∑ i ∈ Finset.range d₀,
          (algebraMap A D (Q₀.coeff i) * w ^ i) * w =
          ∑ i ∈ Finset.range d₀, algebraMap A D (Q₀.coeff i) * w := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [mul_assoc, hw_pow i]
      rw [h_terms, map_add, map_one, map_sum, add_mul, one_mul, Finset.sum_mul]
    rw [hQ₀_eval, zero_mul] at h_eval_mul
    let s₀ : A := ∑ i ∈ Finset.range d₀, Q₀.coeff i
    have hs₀_mem : s₀ ∈ m_A :=
      Ideal.sum_mem m_A fun i hi => hQ₀_coeff i (ne_of_lt (Finset.mem_range.mp hi))
    have h_not_mem : 1 + s₀ ∉ m_A := by
      intro hmem
      have h1 : (1 : A) ∈ m_A := by
        have hsub := m_A.sub_mem hmem hs₀_mem
        rwa [add_sub_cancel_right] at hsub
      exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one m_A).mpr h1)
    have hu : IsUnit (1 + s₀) := IsLocalRing.notMem_maximalIdeal.mp h_not_mem
    rcases hu.map (algebraMap A D) with ⟨u, hu_eq⟩
    have hu_mul : (u : D) * w = 0 := by
      rw [hu_eq]
      exact h_eval_mul.symm
    calc
      w = 1 * w := (one_mul w).symm
      _ = (↑u⁻¹ * ↑u) * w := by rw [Units.inv_mul]
      _ = ↑u⁻¹ * (↑u * w) := by rw [mul_assoc]
      _ = 0 := by rw [hu_mul, mul_zero]
  
  have lift_single : ∀ (ē : D ⧸ I_D), IsIdempotentElem ē →
      ∃ e : D, IsIdempotentElem e ∧ q_D e = ē := by
    intro ē hē
    obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective ē
    let y : D := x ^ 2 - x
    have hy_mem : y ∈ I_D := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      change q_D (x ^ 2 - x) = 0
      rw [map_sub, map_pow, hx, sq, hē.eq, sub_self]
    obtain ⟨Q₀, hQ₀_monic, hQ₀_eval, hQ₀_coeff⟩ :=
      Polynomial.exists_monic_aeval_eq_zero_forall_mem_of_mem_map hy_mem
    let Q : Polynomial A := Q₀ * Polynomial.X
    let n : ℕ := Q₀.natDegree + 1
    have hQ_monic : Q.Monic := hQ₀_monic.mul Polynomial.monic_X
    have hQ_deg : Q.natDegree = n := Polynomial.natDegree_mul_X hQ₀_monic.ne_zero
    have hQ_eval : Polynomial.aeval y Q = 0 := by
      dsimp [Q]
      rw [map_mul, hQ₀_eval, zero_mul]
    have hQ_coeff : ∀ i < n, Q.coeff i ∈ m_A := by
      intro i hi
      cases i with
      | zero =>
        dsimp [Q]
        rw [Polynomial.coeff_mul_X_zero]
        exact m_A.zero_mem
      | succ j =>
        dsimp [Q]
        rw [Polynomial.coeff_mul_X]
        have hj : j < Q₀.natDegree := Nat.lt_of_succ_lt_succ hi
        exact hQ₀_coeff j (ne_of_lt hj)
    let g₀ : Polynomial A := Polynomial.X ^ 2 - Polynomial.X
    have hg₀_coeff2 : g₀.coeff 2 = 1 := by
      dsimp [g₀]
      rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_X]
      simp
    have hg₀_coeff_gt : ∀ k : ℕ, 2 < k → g₀.coeff k = 0 := by
      intro k hk
      dsimp [g₀]
      rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_X]
      have hne2 : ¬ (k = 2) := by omega
      have hne1 : ¬ (1 = k) := by omega
      simp [hne2, hne1]
    have hg₀_deg : g₀.natDegree = 2 := by
      apply le_antisymm
      · exact Polynomial.natDegree_le_iff_coeff_eq_zero.mpr hg₀_coeff_gt
      · apply Polynomial.le_natDegree_of_ne_zero
        rw [hg₀_coeff2]
        exact one_ne_zero
    have hg₀_monic : g₀.Monic := by
      rw [Polynomial.Monic, Polynomial.leadingCoeff, hg₀_deg, hg₀_coeff2]
    have hg₀_deg_ne : g₀.natDegree ≠ 0 := by
      rw [hg₀_deg]
      decide
    let P : Polynomial A := Q.comp g₀
    have hP_monic : P.Monic := hQ_monic.comp hg₀_monic hg₀_deg_ne
    have hxP_aeval : Polynomial.aeval x P = 0 := by
      dsimp [P, g₀]
      rw [Polynomial.aeval_comp, map_sub, map_pow, Polynomial.aeval_X]
      exact hQ_eval
    have hxP : Polynomial.eval₂ (↑(Algebra.ofId A D)) x P = 0 := hxP_aeval
    let D₀ := AdjoinRoot P
    let t : D₀ := AdjoinRoot.root P
    let m : ℕ := P.natDegree
    let b : Module.Basis (Fin m) A D₀ := AdjoinRoot.powerBasisAux' hP_monic
    let ψ : D₀ →ₐ[A] D := AdjoinRoot.liftAlgHom P (Algebra.ofId A D) x hxP
    have hψ_t : ψ t = x := AdjoinRoot.liftAlgHom_root P (Algebra.ofId A D) x hxP
    let z₀ : D₀ := 1 - (1 - t ^ n) ^ n
    have hq_z₀ : q_D (ψ z₀) = ē := by
      have hē_n : ē ^ n = ē := hē.pow_succ_eq Q₀.natDegree
      have h1ē_idem : IsIdempotentElem (1 - ē) := IsIdempotentElem.one_sub_iff.mpr hē
      have h1ē_n : (1 - ē) ^ n = 1 - ē := h1ē_idem.pow_succ_eq Q₀.natDegree
      have hψ_z₀ : ψ z₀ = 1 - (1 - x ^ n) ^ n := by
        dsimp [z₀]
        rw [map_sub, map_one, map_pow, map_sub, map_one, map_pow, hψ_t]
      rw [hψ_z₀, map_sub, map_one, map_pow, map_sub, map_one, map_pow, hx, hē_n, h1ē_n]
      ring
    let I_D₀ : Ideal D₀ := Ideal.map (algebraMap A D₀) m_A
    have ht_Q : Polynomial.aeval (t ^ 2 - t) Q = 0 := by
      have hPt : Polynomial.aeval t P = 0 := by
        rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
      dsimp [P, g₀] at hPt
      rwa [Polynomial.aeval_comp, map_sub, map_pow, Polynomial.aeval_X] at hPt
    have ht_pow_mem : (t ^ 2 - t) ^ n ∈ I_D₀ := by
      have h_exp := congrArg (Polynomial.aeval (t ^ 2 - t)) (monic_expand Q hQ_monic)
      rw [ht_Q, hQ_deg, map_add, map_pow, Polynomial.aeval_X, map_sum] at h_exp
      simp only [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X] at h_exp
      have h_eq : (t ^ 2 - t) ^ n =
          - ∑ i ∈ Finset.range n, algebraMap A D₀ (Q.coeff i) * (t ^ 2 - t) ^ i := by
        exact eq_neg_of_add_eq_zero_left h_exp.symm
      rw [h_eq]
      apply I_D₀.neg_mem
      refine Ideal.sum_mem I_D₀ fun i hi => ?_
      exact I_D₀.mul_mem_right _
        (Ideal.mem_map_of_mem (algebraMap A D₀) (hQ_coeff i (Finset.mem_range.mp hi)))
    have hz₀_idem_mod : z₀ * z₀ - z₀ ∈ I_D₀ := by
      let π₀ : D₀ →+* (D₀ ⧸ I_D₀) := Ideal.Quotient.mk I_D₀
      have h_nil : (π₀ t - π₀ t ^ 2) ^ n = 0 := by
        have h1 : (π₀ t ^ 2 - π₀ t) ^ n = 0 := by
          rw [← map_pow π₀, ← map_sub π₀, ← map_pow π₀]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr ht_pow_mem
        have h_neg : π₀ t - π₀ t ^ 2 = (-1) * (π₀ t ^ 2 - π₀ t) := by ring
        rw [h_neg, mul_pow, h1, mul_zero]
      have h_idem_bar : IsIdempotentElem (1 - (1 - π₀ t ^ n) ^ n) :=
        isIdempotentElem_one_sub_one_sub_pow_pow (π₀ t) n h_nil
      have hπ_z₀ : π₀ z₀ = 1 - (1 - π₀ t ^ n) ^ n := by
        dsimp [z₀]
        rw [map_sub, map_one, map_pow, map_sub, map_one, map_pow]
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      change π₀ (z₀ * z₀ - z₀) = 0
      rw [map_sub, map_mul, hπ_z₀, h_idem_bar.eq, sub_self]
    have lin_mem_mA : ∀ (w : D₀), w ∈ I_D₀ → ∀ (f : D₀ →ₗ[A] A), f w ∈ m_A := by
      intro w hw
      change w ∈ Submodule.span D₀ (algebraMap A D₀ '' (m_A : Set A)) at hw
      induction hw using Submodule.span_induction with
      | mem u hu =>
        rcases hu with ⟨c, hc, rfl⟩
        intro f
        have h_smul : algebraMap A D₀ c = c • (1 : D₀) := by
          rw [Algebra.smul_def, mul_one]
        rw [h_smul, f.map_smul, smul_eq_mul, mul_comm]
        exact m_A.mul_mem_left (f 1) hc
      | zero =>
        intro f
        rw [map_zero]
        exact m_A.zero_mem
      | add u₁ u₂ _ _ ih₁ ih₂ =>
        intro f
        rw [map_add]
        exact m_A.add_mem (ih₁ f) (ih₂ f)
      | smul s u _ ih =>
        intro f
        change f ((LinearMap.mulLeft A s) u) ∈ m_A
        exact ih (f.comp (LinearMap.mulLeft A s))
    have repr_mem_mA : ∀ (w : D₀), w ∈ I_D₀ → ∀ (k : Fin m), b.repr w k ∈ m_A :=
      fun w hw k => lin_mem_mA w hw (b.coord k)
    let a₀ : Fin m → A := fun i => b.repr z₀ i
    let γ : Fin m → Fin m → Fin m → A := fun i j k => b.repr (b i * b j) k
    have hγ_symm : ∀ i j k : Fin m, γ i j k = γ j i k := by
      intro i j k
      dsimp [γ]
      rw [mul_comm]
    let F_sys : Fin m → MvPolynomial (Fin m) A := fun k =>
      (∑ i : Fin m, ∑ j : Fin m,
        MvPolynomial.C (γ i j k) * (MvPolynomial.X i * MvPolynomial.X j)) -
      MvPolynomial.X k
    let z_of : (Fin m → A) → D₀ := fun u => ∑ i : Fin m, u i • b i
    have hz_eq_symm : ∀ u : Fin m → A, z_of u = b.equivFun.symm u :=
      fun u => (b.equivFun_symm_apply u).symm
    have hz_repr : ∀ (u : Fin m → A) (k : Fin m), b.repr (z_of u) k = u k := by
      intro u k
      rw [hz_eq_symm u, ← b.equivFun_apply, b.equivFun.apply_symm_apply]
    have hz_a₀ : z_of a₀ = z₀ := by
      rw [hz_eq_symm a₀]
      have ha₀_eq : a₀ = b.equivFun z₀ := by
        ext i
        rw [b.equivFun_apply]
      rw [ha₀_eq, b.equivFun.symm_apply_apply]
    have heval_F : ∀ (u : Fin m → A) (k : Fin m),
        MvPolynomial.eval u (F_sys k) = b.repr (z_of u * z_of u - z_of u) k := by
      intro u k
      have hmul : z_of u * z_of u =
          ∑ i : Fin m, ∑ j : Fin m, (u i * u j) • (b i * b j) := by
        dsimp [z_of]
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        exact smul_mul_smul_comm (u i) (b i) (u j) (b j)
      have h_rhs : b.repr (z_of u * z_of u - z_of u) k =
          (∑ i : Fin m, ∑ j : Fin m, (u i * u j) * γ i j k) - u k := by
        change (b.coord k) (z_of u * z_of u - z_of u) = _
        rw [LinearMap.map_sub, b.coord_apply k (z_of u), hz_repr u k, hmul, map_sum]
        congr 1
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [LinearMap.map_smul, smul_eq_mul, b.coord_apply]
      rw [h_rhs]
      dsimp [F_sys]
      rw [map_sub, MvPolynomial.eval_X, map_sum]
      congr 1
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
      ring
    have hF_mod : ∀ k : Fin m, MvPolynomial.eval a₀ (F_sys k) ∈ m_A := by
      intro k
      rw [heval_F a₀ k, hz_a₀]
      exact repr_mem_mA (z₀ * z₀ - z₀) hz₀_idem_mod k
    let L : D₀ →ₗ[A] D₀ := LinearMap.mulLeft A (2 * z₀ - 1)
    let J_L : Matrix (Fin m) (Fin m) A := LinearMap.toMatrix b b L
    have heval_single : ∀ x y : Fin m,
        MvPolynomial.eval a₀ ((Pi.single x 1 : Fin m → MvPolynomial (Fin m) A) y) =
          if y = x then 1 else 0 := by
      intro x y
      by_cases h : y = x <;> simp [h]
    have hJac_eq : Matrix.of (fun a k : Fin m =>
        MvPolynomial.eval a₀ (MvPolynomial.pderiv a (F_sys k))) = J_L.transpose := by
      ext a k
      rw [Matrix.of_apply, Matrix.transpose_apply]
      dsimp [J_L]
      rw [LinearMap.toMatrix_apply]
      dsimp [F_sys, L]
      rw [map_sub, MvPolynomial.pderiv_X, map_sum]
      have hpderiv_inner : ∀ i j : Fin m,
          (MvPolynomial.pderiv a) (MvPolynomial.C (γ i j k) * (MvPolynomial.X i * MvPolynomial.X j)) =
          MvPolynomial.C (γ i j k) *
            ((Pi.single a 1 : Fin m → MvPolynomial (Fin m) A) i * MvPolynomial.X j +
              MvPolynomial.X i * (Pi.single a 1 : Fin m → MvPolynomial (Fin m) A) j) := by
        intro i j
        rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C, zero_mul, zero_add,
          MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, MvPolynomial.pderiv_X]
      have h_lhs : MvPolynomial.eval a₀
          (∑ x : Fin m, (MvPolynomial.pderiv a)
            (∑ j : Fin m, MvPolynomial.C (γ x j k) * (MvPolynomial.X x * MvPolynomial.X j)) -
          (Pi.single a 1 : Fin m → MvPolynomial (Fin m) A) k) =
          (∑ j : Fin m, 2 * a₀ j * γ a j k) - (if k = a then 1 else 0) := by
        rw [map_sub, heval_single a k, map_sum]
        congr 1
        have h_each : ∀ i : Fin m,
            MvPolynomial.eval a₀ ((MvPolynomial.pderiv a)
              (∑ j : Fin m, MvPolynomial.C (γ i j k) * (MvPolynomial.X i * MvPolynomial.X j))) =
            (if i = a then ∑ j : Fin m, γ a j k * a₀ j else 0) + γ i a k * a₀ i := by
          intro i
          rw [map_sum, map_sum]
          simp only [hpderiv_inner, map_mul, map_add, MvPolynomial.eval_C, MvPolynomial.eval_X,
            heval_single, mul_add]
          rw [Finset.sum_add_distrib]
          congr 1
          · by_cases hia : i = a
            · subst hia
              simp only [↓reduceIte, one_mul]
            · simp only [hia, ↓reduceIte, zero_mul, mul_zero, Finset.sum_const_zero]
          · have h_ite : ∀ j : Fin m,
                γ i j k * (a₀ i * if j = a then 1 else 0) =
                if j = a then γ i a k * a₀ i else 0 := by
              intro j
              by_cases hja : j = a
              · subst hja; simp
              · simp [hja]
            simp only [h_ite, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
        simp only [h_each, Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [hγ_symm j a k]
        ring
      rw [h_lhs]
      change _ = (b.coord k) ((2 * z₀ - 1) * b a)
      have h_mul_ba : (2 * z₀ - 1) * b a =
          (∑ j : Fin m, (2 * a₀ j) • (b a * b j)) - b a := by
        have h1 : (2 * z₀ - 1) * b a = (2 : D₀) * (b a * z₀) - b a := by ring
        rw [h1, ← hz_a₀]
        dsimp [z_of]
        rw [Finset.mul_sum, Finset.mul_sum]
        congr 1
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [mul_smul_comm, Algebra.smul_def, Algebra.smul_def, map_mul, map_ofNat]
        ring
      rw [h_mul_ba, LinearMap.map_sub, map_sum]
      have hcoord_ba : (b.coord k) (b a) = if k = a then 1 else 0 := by
        rw [b.coord_apply, b.repr_self, Finsupp.single_apply]
        by_cases hka : a = k
        · subst hka; simp
        · have hka' : k ≠ a := Ne.symm hka
          simp [hka, hka']
      rw [hcoord_ba]
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [LinearMap.map_smul, smul_eq_mul, b.coord_apply]
    have hdet_unit : IsUnit ((Matrix.of (fun a k : Fin m =>
        MvPolynomial.eval a₀ (MvPolynomial.pderiv a (F_sys k)))).det) := by
      rw [hJac_eq, Matrix.det_transpose]
      let π_A : A →+* (A ⧸ m_A) := Ideal.Quotient.mk m_A
      let _ : Field (A ⧸ m_A) := Ideal.Quotient.field m_A
      have hJL_sq_mod : ∀ k a : Fin m, (J_L * J_L - 1) k a ∈ m_A := by
        intro k a
        let L_diff : D₀ →ₗ[A] D₀ := L ∘ₗ L - LinearMap.id
        have h_mat : J_L * J_L - 1 = LinearMap.toMatrix b b L_diff := by
          dsimp [L_diff, J_L]
          rw [map_sub, LinearMap.toMatrix_comp b b b L L, LinearMap.toMatrix_id b]
        rw [h_mat, LinearMap.toMatrix_apply]
        have h_act : L_diff (b a) = 4 * (z₀ * z₀ - z₀) * b a := by
          change (2 * z₀ - 1) * ((2 * z₀ - 1) * b a) - b a = _
          ring
        rw [h_act]
        have hw_mem : 4 * (z₀ * z₀ - z₀) * b a ∈ I_D₀ :=
          I_D₀.mul_mem_right (b a) (I_D₀.mul_mem_left 4 hz₀_idem_mod)
        exact repr_mem_mA _ hw_mem k
      have hmap_sq : (π_A.mapMatrix J_L) * (π_A.mapMatrix J_L) = 1 := by
        rw [← map_mul π_A.mapMatrix, ← map_one π_A.mapMatrix]
        ext k a
        simp only [RingHom.mapMatrix_apply, Matrix.map_apply]
        apply Ideal.Quotient.eq.mpr
        have hmem := hJL_sq_mod k a
        rwa [Matrix.sub_apply] at hmem
      have hdet_sq : π_A J_L.det * π_A J_L.det = 1 := by
        rw [RingHom.map_det, ← Matrix.det_mul, hmap_sq, Matrix.det_one]
      have hdet_not_mem : J_L.det ∉ m_A := by
        intro hmem
        have h0 : π_A J_L.det = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
        rw [h0, mul_zero] at hdet_sq
        exact zero_ne_one hdet_sq
      exact IsLocalRing.notMem_maximalIdeal.mp hdet_not_mem
    obtain ⟨a, ha_zero, ha_mod⟩ := hJac m F_sys a₀ hF_mod hdet_unit
    let ε : D₀ := z_of a
    have hε_idem : ε * ε = ε := by
      apply sub_eq_zero.mp
      apply b.repr.injective
      ext k
      rw [map_zero, Finsupp.zero_apply, ← heval_F a k, ha_zero k]
    let e : D := ψ ε
    have he_idem : IsIdempotentElem e := by
      change ψ ε * ψ ε = ψ ε
      rw [← map_mul, hε_idem]
    have he_diff_mem : e - ψ z₀ ∈ I_D := by
      have hε_sub : ε - z₀ = ∑ i : Fin m, (a i - a₀ i) • b i := by
        rw [← hz_a₀]
        dsimp [ε, z_of]
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [sub_smul]
      have he_sub : e - ψ z₀ =
          ∑ i : Fin m, algebraMap A D (a i - a₀ i) * ψ (b i) := by
        dsimp [e]
        rw [← map_sub, hε_sub, map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_smul, Algebra.smul_def]
      rw [he_sub]
      refine Ideal.sum_mem I_D fun i _ => ?_
      exact I_D.mul_mem_right (ψ (b i))
        (Ideal.mem_map_of_mem (algebraMap A D) (ha_mod i))
    have hq_e : q_D e = ē := by
      have h0 : q_D (e - ψ z₀) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr he_diff_mem
      rw [map_sub] at h0
      rw [sub_eq_zero.mp h0, hq_z₀]
    exact ⟨e, he_idem, hq_e⟩
  
  let κ_A := A ⧸ m_A
  let _ : Field κ_A := Ideal.Quotient.field m_A
  let D_bar := D ⧸ I_D
  let f_semi : D →ₛₗ[Ideal.Quotient.mk m_A] D_bar :=
    { toFun := q_D
      map_add' := map_add q_D
      map_smul' := fun a d => by
        dsimp [q_D]
        rw [Algebra.smul_def, map_mul, Algebra.smul_def,
          Ideal.Quotient.algebraMap_quotient_map_quotient] }
  have : Module.Finite κ_A D_bar :=
    Module.Finite.of_surjective f_semi Ideal.Quotient.mk_surjective
  have : IsArtinianRing D_bar := IsArtinianRing.of_finite κ_A D_bar
  have : Finite (MaximalSpectrum D_bar) := IsArtinianRing.instFiniteMaximalSpectrum D_bar
  let _ : Fintype (MaximalSpectrum D_bar) := Fintype.ofFinite (MaximalSpectrum D_bar)
  let r : ℕ := Fintype.card (MaximalSpectrum D_bar)
  let α : Fin r ≃ MaximalSpectrum D_bar := (Fintype.equivFin (MaximalSpectrum D_bar)).symm
  let Φ := IsArtinianRing.quotNilradicalEquivPi D_bar
  let u_raw : MaximalSpectrum D_bar → (∀ I : MaximalSpectrum D_bar, D_bar ⧸ I.asIdeal) :=
    fun J => Pi.single J 1
  have h_single_coi : CompleteOrthogonalIdempotents u_raw :=
    CompleteOrthogonalIdempotents.single (fun I : MaximalSpectrum D_bar => D_bar ⧸ I.asIdeal)
  let u : Fin r → (∀ I : MaximalSpectrum D_bar, D_bar ⧸ I.asIdeal) :=
    fun m => u_raw (α m)
  have hu_coi : CompleteOrthogonalIdempotents u := by
    refine ⟨⟨fun m => h_single_coi.idem (α m), ?_⟩, ?_⟩
    · intro m₁ m₂ hm
      exact h_single_coi.ortho (α.injective.ne hm)
    · exact (Equiv.sum_comp α u_raw).trans h_single_coi.complete
  let u' : Fin r → (D_bar ⧸ nilradical D_bar) := ⇑Φ.symm.toRingHom ∘ u
  have hu'_coi : CompleteOrthogonalIdempotents u' :=
    CompleteOrthogonalIdempotents.map Φ.symm.toRingHom hu_coi
  let π_nil : D_bar →+* (D_bar ⧸ nilradical D_bar) := Ideal.Quotient.mk (nilradical D_bar)
  have hker_nil : ∀ z ∈ RingHom.ker π_nil, IsNilpotent z := by
    intro z hz
    rw [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem] at hz
    exact mem_nilradical.mp hz
  have hu'_range : ∀ m : Fin r, u' m ∈ π_nil.range :=
    fun m => Ideal.Quotient.mk_surjective (u' m)
  obtain ⟨ē, hē_coi, hē_lift⟩ :=
    CompleteOrthogonalIdempotents.lift_of_isNilpotent_ker π_nil hker_nil hu'_coi hu'_range
  have hē_eval : ∀ (m : Fin r) (I : MaximalSpectrum D_bar),
      Ideal.Quotient.mk I.asIdeal (ē m) = u m I := by
    intro m I
    have hcomm := congrFun (Φ.commutes (ē m)) I
    have hlift_m : π_nil (ē m) = Φ.symm (u m) := congrFun hē_lift m
    change (algebraMap D_bar (∀ J : MaximalSpectrum D_bar, D_bar ⧸ J.asIdeal) (ē m)) I = _
    rw [← hcomm]
    change Φ (π_nil (ē m)) I = _
    rw [hlift_m, Φ.apply_symm_apply]
  have hē_ne : ∀ m : Fin r, ē m ≠ 0 := by
    intro m hm0
    have : (α m).asIdeal.IsMaximal := (α m).isMaximal
    let _ : Field (D_bar ⧸ (α m).asIdeal) := Ideal.Quotient.field (α m).asIdeal
    have hev := hē_eval m (α m)
    dsimp [u, u_raw] at hev
    rw [hm0, map_zero, Pi.single_eq_same] at hev
    exact zero_ne_one hev
  have hē_uniq : ∀ (m : Fin r) (M₁ M₂ : Ideal D_bar),
      M₁.IsMaximal → M₂.IsMaximal → ē m ∉ M₁ → ē m ∉ M₂ → M₁ = M₂ := by
    intro m M₁ M₂ hM₁ hM₂ hn₁ hn₂
    have eq_alpha : ∀ (M : Ideal D_bar) (hM : M.IsMaximal), ē m ∉ M → M = (α m).asIdeal := by
      intro M hM hnot
      let pt : MaximalSpectrum D_bar := ⟨M, hM⟩
      have hne0 : Ideal.Quotient.mk pt.asIdeal (ē m) ≠ 0 :=
        fun h0 => hnot (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      rw [hē_eval m pt] at hne0
      dsimp [u, u_raw] at hne0
      have hpt_eq : pt = α m := by
        by_contra hne_pt
        exact hne0 (Pi.single_eq_of_ne hne_pt 1)
      exact congrArg MaximalSpectrum.asIdeal hpt_eq
    rw [eq_alpha M₁ hM₁ hn₁, eq_alpha M₂ hM₂ hn₂]
  
  have h_ex_e : ∀ m : Fin r, ∃ e_m : D, IsIdempotentElem e_m ∧ q_D e_m = ē m :=
    fun m => lift_single (ē m) (hē_coi.idem m)
  choose e he_idem he_mk using h_ex_e
  have he_orth : OrthogonalIdempotents e := by
    refine ⟨he_idem, ?_⟩
    intro m₁ m₂ hm
    have hw_idem : IsIdempotentElem (e m₁ * e m₂) := by
      change (e m₁ * e m₂) * (e m₁ * e m₂) = e m₁ * e m₂
      rw [mul_mul_mul_comm, (he_idem m₁).eq, (he_idem m₂).eq]
    have hw_mem : e m₁ * e m₂ ∈ I_D := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      change q_D (e m₁ * e m₂) = 0
      rw [map_mul, he_mk m₁, he_mk m₂]
      exact hē_coi.ortho hm
    exact idem_eq_zero (e m₁ * e m₂) hw_idem hw_mem
  have he_coi : CompleteOrthogonalIdempotents e := by
    refine ⟨he_orth, ?_⟩
    let s_e : D := ∑ m : Fin r, e m
    have hs_idem : IsIdempotentElem s_e := he_orth.isIdempotentElem_sum
    have h1s_idem : IsIdempotentElem (1 - s_e) := IsIdempotentElem.one_sub_iff.mpr hs_idem
    have h1s_mem : 1 - s_e ∈ I_D := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      change q_D (1 - s_e) = 0
      dsimp [s_e]
      rw [map_sub, map_one, map_sum]
      simp only [he_mk]
      rw [hē_coi.complete, sub_self]
    have h1s_zero : 1 - s_e = 0 := idem_eq_zero (1 - s_e) h1s_idem h1s_mem
    exact (sub_eq_zero.mp h1s_zero).symm
  refine ⟨r, e, he_coi, ?_⟩
  intro m
  let J_m : Ideal D := Ideal.span {1 - e m}
  let Q_m := D ⧸ J_m
  let p_m : D →+* Q_m := Ideal.Quotient.mk J_m
  have : IsLocalization.Away (e m) Q_m :=
    IsLocalization.Away.quotient_of_isIdempotentElem (he_idem m)
  let θ_m : Localization.Away (e m) ≃ₐ[D] Q_m :=
    IsLocalization.algEquiv (Submonoid.powers (e m)) (Localization.Away (e m)) Q_m
  have : Nontrivial Q_m := by
    refine ⟨⟨0, 1, ?_⟩⟩
    intro h01
    have h1_mem : (1 : D) ∈ J_m :=
      Ideal.Quotient.eq_zero_iff_mem.mp h01.symm
    rw [Ideal.mem_span_singleton] at h1_mem
    rcases h1_mem with ⟨c, hc⟩
    have hem_zero : e m = 0 := by
      calc
        e m = e m * 1 := (mul_one (e m)).symm
        _ = e m * ((1 - e m) * c) := by rw [← hc]
        _ = (e m - e m * e m) * c := by ring
        _ = 0 := by rw [(he_idem m).eq, sub_self, zero_mul]
    apply hē_ne m
    rw [← he_mk m, hem_zero, map_zero]
  have hInt_AD : (algebraMap A D).IsIntegral := Algebra.isIntegral_def.mp inferInstance
  have hQ_max_uniq : ∀ (M₁ M₂ : Ideal Q_m), M₁.IsMaximal → M₂.IsMaximal → M₁ = M₂ := by
    intro M₁ M₂ hM₁ hM₂
    have proj_max : ∀ (M : Ideal Q_m), M.IsMaximal →
        let P : Ideal D := Ideal.comap p_m M
        let M_bar : Ideal D_bar := Ideal.map q_D P
        M_bar.IsMaximal ∧ Ideal.comap q_D M_bar = P ∧ ē m ∉ M_bar := by
      intro M hM
      have : M.IsMaximal := hM
      let P : Ideal D := Ideal.comap p_m M
      have hP_max : P.IsMaximal :=
        Ideal.comap_isMaximal_of_surjective p_m Ideal.Quotient.mk_surjective
      have h1e_mem_P : 1 - e m ∈ P := by
        change p_m (1 - e m) ∈ M
        have h0 : p_m (1 - e m) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [h0]
        exact M.zero_mem
      have hem_not_P : e m ∉ P := by
        intro hemP
        have h1P : (1 : D) ∈ P := by
          have h := P.add_mem hemP h1e_mem_P
          rwa [add_sub_cancel] at h
        exact hP_max.ne_top ((Ideal.eq_top_iff_one P).mpr h1P)
      have hcomap_A_max : (Ideal.comap (algebraMap A D) P).IsMaximal :=
        Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap A D) hInt_AD P
      have hcomap_A_eq : Ideal.comap (algebraMap A D) P = m_A :=
        IsLocalRing.eq_maximalIdeal hcomap_A_max
      have hID_le_P : I_D ≤ P := Ideal.map_le_iff_le_comap.mpr (le_of_eq hcomap_A_eq.symm)
      have hker_le_P : RingHom.ker q_D ≤ P := by
        rwa [Ideal.mk_ker]
      let M_bar : Ideal D_bar := Ideal.map q_D P
      have hMbar_max : M_bar.IsMaximal :=
        Ideal.IsMaximal.map_of_surjective_of_ker_le Ideal.Quotient.mk_surjective hker_le_P
      have hcomap_Mbar : Ideal.comap q_D M_bar = P := by
        rw [Ideal.comap_map_of_surjective' q_D Ideal.Quotient.mk_surjective P]
        exact sup_eq_left.mpr hker_le_P
      have hē_not_Mbar : ē m ∉ M_bar := by
        rw [← he_mk m]
        intro hmem
        have hmem_comap : e m ∈ Ideal.comap q_D M_bar := hmem
        rw [hcomap_Mbar] at hmem_comap
        exact hem_not_P hmem_comap
      exact ⟨hMbar_max, hcomap_Mbar, hē_not_Mbar⟩
    obtain ⟨hMb₁_max, hMb₁_comap, hMb₁_not⟩ := proj_max M₁ hM₁
    obtain ⟨hMb₂_max, hMb₂_comap, hMb₂_not⟩ := proj_max M₂ hM₂
    have hMb_eq := hē_uniq m _ _ hMb₁_max hMb₂_max hMb₁_not hMb₂_not
    have hP_eq : Ideal.comap p_m M₁ = Ideal.comap p_m M₂ := by
      rw [← hMb₁_comap, ← hMb₂_comap, hMb_eq]
    calc
      M₁ = Ideal.map p_m (Ideal.comap p_m M₁) :=
        (Ideal.map_comap_of_surjective p_m Ideal.Quotient.mk_surjective M₁).symm
      _ = Ideal.map p_m (Ideal.comap p_m M₂) := by rw [hP_eq]
      _ = M₂ := Ideal.map_comap_of_surjective p_m Ideal.Quotient.mk_surjective M₂
  have : IsLocalRing Q_m := by
    apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
    intro z
    by_contra h_not
    have hz : ¬ IsUnit z := fun h => h_not (Or.inl h)
    have h1z : ¬ IsUnit (1 - z) := fun h => h_not (Or.inr h)
    have hz_ne_top : Ideal.span ({z} : Set Q_m) ≠ ⊤ :=
      fun htop => hz (Ideal.span_singleton_eq_top.mp htop)
    have h1z_ne_top : Ideal.span ({1 - z} : Set Q_m) ≠ ⊤ :=
      fun htop => h1z (Ideal.span_singleton_eq_top.mp htop)
    obtain ⟨M₁, hM₁_max, hz_le⟩ := Ideal.exists_le_maximal _ hz_ne_top
    obtain ⟨M₂, hM₂_max, h1z_le⟩ := Ideal.exists_le_maximal _ h1z_ne_top
    have hM_eq : M₁ = M₂ := hQ_max_uniq M₁ M₂ hM₁_max hM₂_max
    have hz_mem : z ∈ M₁ := hz_le (Ideal.subset_span rfl)
    have h1z_mem : 1 - z ∈ M₁ := by
      rw [hM_eq]
      exact h1z_le (Ideal.subset_span rfl)
    have h1_mem : (1 : Q_m) ∈ M₁ := by
      have h := M₁.add_mem hz_mem h1z_mem
      rwa [add_sub_cancel] at h
    exact hM₁_max.ne_top ((Ideal.eq_top_iff_one M₁).mpr h1_mem)
  exact RingEquiv.isLocalRing θ_m.symm.toRingEquiv

theorem weil_sepClosed_local_etale_section_of_finite_split (A B C₀ B_m : Type u) [CommRing A] [IsLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    [CommRing B] [CommRing C₀] [Algebra B C₀] [Algebra.Etale B C₀]
    [CommRing B_m] [Algebra A B_m] [Module.Finite A B_m] [IsLocalRing B_m]
    (hFinSplit : ∀ (D : Type u) [CommRing D] [Algebra A D] [Module.Finite A D],
      ∃ (r : ℕ) (e : Fin r → D),
        CompleteOrthogonalIdempotents e ∧
        ∀ m : Fin r, IsLocalRing (Localization.Away (e m)))
    (ι_B : B →+* B_m) (q' : PrimeSpectrum C₀)
    (hq' : PrimeSpectrum.comap (algebraMap B C₀) q' =
      PrimeSpectrum.comap ι_B (IsLocalRing.closedPoint B_m)) :
    ∃ σ_m : C₀ →+* B_m, σ_m.comp (algebraMap B C₀) = ι_B :=
by
  classical
  let _ : Algebra B B_m := ι_B.toAlgebra
  let C_m : Type u := TensorProduct B B_m C₀
  have _ : Algebra.Etale B_m C_m := Algebra.Etale.baseChange B C₀ B_m
  
  have hInt_ABm : (algebraMap A B_m).IsIntegral := by
    have _ : Algebra.IsIntegral A B_m := Algebra.IsIntegral.of_finite A B_m
    exact Algebra.isIntegral_def.mp inferInstance
  have hMax_ABm : Ideal.comap (algebraMap A B_m) (IsLocalRing.maximalIdeal B_m) =
      IsLocalRing.maximalIdeal A :=
    IsLocalRing.eq_maximalIdeal
      (Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap A B_m) hInt_ABm
        (IsLocalRing.maximalIdeal B_m))
  have _ : IsLocalHom (algebraMap A B_m) := ⟨fun {a} ha => by
    have ha_not : algebraMap A B_m a ∉ IsLocalRing.maximalIdeal B_m :=
      IsLocalRing.notMem_maximalIdeal.mpr ha
    have ha_A : a ∉ IsLocalRing.maximalIdeal A := by
      rw [← hMax_ABm]
      exact ha_not
    exact IsLocalRing.notMem_maximalIdeal.mp ha_A⟩
  have _ : Module.Finite (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B_m) :=
    Module.Finite.of_restrictScalars_finite A
      (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B_m)
  have _ : Algebra.IsAlgebraic (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B_m) :=
    Algebra.IsAlgebraic.of_finite (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B_m)
  have _ : IsSepClosed (IsLocalRing.ResidueField B_m) :=
    Algebra.IsAlgebraic.isSepClosed (F := IsLocalRing.ResidueField A)
      (E := IsLocalRing.ResidueField B_m)
  
  let q_m : PrimeSpectrum B :=
    PrimeSpectrum.comap (algebraMap B B_m) (IsLocalRing.closedPoint B_m)
  have hq'_ideal : q_m.asIdeal = Ideal.comap (algebraMap B C₀) q'.asIdeal :=
    congrArg PrimeSpectrum.asIdeal hq'.symm
  let k₀ : Type u := q_m.asIdeal.ResidueField
  let k₁ : Type u := (IsLocalRing.maximalIdeal B_m).ResidueField
  let k₂ : Type u := q'.asIdeal.ResidueField
  let α₁ : k₀ →+* k₁ :=
    Ideal.ResidueField.map q_m.asIdeal (IsLocalRing.maximalIdeal B_m) (algebraMap B B_m) rfl
  let α₂ : k₀ →+* k₂ :=
    Ideal.ResidueField.map q_m.asIdeal q'.asIdeal (algebraMap B C₀) hq'_ideal
  let _ : Algebra k₀ k₁ := α₁.toAlgebra
  let _ : Algebra k₀ k₂ := α₂.toAlgebra
  let T_res : Type u := TensorProduct k₀ k₁ k₂
  have _ : Nontrivial T_res := inferInstance
  let ψ₁ : B_m →+* T_res :=
    Algebra.TensorProduct.includeLeftRingHom.comp (algebraMap B_m k₁)
  let ψ₂ : C₀ →+* T_res :=
    (Algebra.TensorProduct.includeRight (R := k₀) (A := k₁) (B := k₂)).toRingHom.comp
      (algebraMap C₀ k₂)
  let g₁ : B_m →ₐ[B] T_res := ⟨ψ₁, fun b => by
    change algebraMap B_m k₁ (algebraMap B B_m b) ⊗ₜ[k₀] (1 : k₂) =
      algebraMap B k₁ b ⊗ₜ[k₀] (1 : k₂)
    rw [IsScalarTower.algebraMap_apply B B_m k₁ b]⟩
  let g₂ : C₀ →ₐ[B] T_res := ⟨ψ₂, fun b => by
    change (1 : k₁) ⊗ₜ[k₀] algebraMap C₀ k₂ (algebraMap B C₀ b) =
      algebraMap B k₁ b ⊗ₜ[k₀] (1 : k₂)
    rw [IsScalarTower.algebraMap_apply B B_m k₁ b,
      ← Ideal.ResidueField.map_algebraMap q_m.asIdeal q'.asIdeal (algebraMap B C₀) hq'_ideal b,
      ← Ideal.ResidueField.map_algebraMap q_m.asIdeal (IsLocalRing.maximalIdeal B_m)
        (algebraMap B B_m) rfl b]
    change (1 : k₁) ⊗ₜ[k₀] (algebraMap k₀ k₂ (algebraMap B k₀ b)) =
      (algebraMap k₀ k₁ (algebraMap B k₀ b)) ⊗ₜ[k₀] (1 : k₂)
    rw [Algebra.algebraMap_eq_smul_one (A := k₂), Algebra.algebraMap_eq_smul_one (A := k₁),
      TensorProduct.tmul_smul, TensorProduct.smul_tmul']⟩
  let Φ : C_m →ₐ[B] T_res :=
    Algebra.TensorProduct.lift g₁ g₂ (fun _ _ => Commute.all _ _)
  obtain ⟨M_max, hM_max⟩ := Ideal.exists_maximal T_res
  have _ : M_max.IsMaximal := hM_max
  have _ : M_max.IsPrime := hM_max.isPrime
  let _ : Field (T_res ⧸ M_max) := Ideal.Quotient.field M_max
  let P_m : PrimeSpectrum C_m :=
    ⟨Ideal.comap Φ.toRingHom M_max, Ideal.comap_isPrime Φ.toRingHom M_max⟩
  have hPm : PrimeSpectrum.comap (algebraMap B_m C_m) P_m = IsLocalRing.closedPoint B_m := by
    ext x
    let θ : k₁ →+* T_res ⧸ M_max :=
      (Ideal.Quotient.mk M_max).comp Algebra.TensorProduct.includeLeftRingHom
    have hθ_inj : Function.Injective θ := RingHom.injective θ
    change Φ (x ⊗ₜ[B] 1) ∈ M_max ↔ x ∈ IsLocalRing.maximalIdeal B_m
    have hΦx : Φ (x ⊗ₜ[B] 1) = Algebra.TensorProduct.includeLeftRingHom (algebraMap B_m k₁ x) := by
      dsimp only [Φ]
      rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      rfl
    rw [hΦx, ← Ideal.Quotient.eq_zero_iff_mem]
    change θ (algebraMap B_m k₁ x) = 0 ↔ x ∈ IsLocalRing.maximalIdeal B_m
    rw [map_eq_zero_iff θ hθ_inj]
    let _ : Field (B_m ⧸ IsLocalRing.maximalIdeal B_m) := Ideal.Quotient.field _
    have h_emb_inj : Function.Injective (algebraMap (B_m ⧸ IsLocalRing.maximalIdeal B_m) k₁) :=
      RingHom.injective _
    rw [IsScalarTower.algebraMap_apply B_m (B_m ⧸ IsLocalRing.maximalIdeal B_m) k₁ x,
      map_eq_zero_iff _ h_emb_inj]
    exact Ideal.Quotient.eq_zero_iff_mem
  
  have hStep3 : ∃ (S₁ : Type u) (_ : CommRing S₁) (_ : IsLocalRing S₁)
      (_ : Algebra B_m S₁) (_ : Module.Finite B_m S₁) (_ : Algebra.Etale B_m S₁),
      Nonempty (C_m →ₐ[B_m] S₁) := by
    have _ : P_m.asIdeal.IsPrime := P_m.isPrime
    obtain ⟨S', hS'_fg, s', hs'_notMem, hs'_bij⟩ :=
      Algebra.QuasiFiniteAt.exists_fg_and_exists_notMem_and_awayMap_bijective
        (R := B_m) (S := C_m) P_m.asIdeal
    have _ : Module.Finite B_m ↥S' := Module.Finite.of_fg hS'_fg
    let L_S' : Type u := Localization.Away s'
    let L_C : Type u := Localization.Away (S'.val.toRingHom s')
    let φ_zmt_alg : L_S' →ₐ[B_m] L_C :=
      { Localization.awayMap S'.val.toRingHom s' with
        commutes' := fun b => by
          change Localization.awayMap S'.val.toRingHom s'
            (algebraMap ↥S' L_S' (algebraMap B_m ↥S' b)) =
            algebraMap C_m L_C (algebraMap B_m C_m b)
          dsimp only [Localization.awayMap, IsLocalization.Away.map]
          rw [IsLocalization.map_eq]
          exact congrArg (algebraMap C_m L_C) (S'.val.commutes b) }
    let e_zmt : L_S' ≃ₐ[B_m] L_C := AlgEquiv.ofBijective φ_zmt_alg hs'_bij
    let _ : Algebra A ↥S' := ((algebraMap B_m ↥S').comp (algebraMap A B_m)).toAlgebra
    have _ : IsScalarTower A B_m ↥S' := IsScalarTower.of_algebraMap_eq' rfl
    have _ : Module.Finite A ↥S' := Module.Finite.trans B_m ↥S'
    obtain ⟨t, f, hf, hLoc_f⟩ := hFinSplit ↥S'
    let Q' : Ideal ↥S' := Ideal.comap S'.val.toRingHom P_m.asIdeal
    have hQ'_prime : Q'.IsPrime := Ideal.comap_isPrime S'.val.toRingHom P_m.asIdeal
    have hex_k₀ : ∃ k₀ : Fin t, f k₀ ∉ Q' := by
      by_contra h_none
      have h_all : ∀ k : Fin t, f k ∈ Q' := fun k =>
        Decidable.byContradiction fun hk => h_none ⟨k, hk⟩
      have h1_mem : (1 : ↥S') ∈ Q' := by
        rw [← hf.2]
        exact Ideal.sum_mem Q' fun k _ => h_all k
      exact hQ'_prime.ne_top ((Ideal.eq_top_iff_one Q').mpr h1_mem)
    obtain ⟨k₀, hfk₀_notMem⟩ := hex_k₀
    let e₀ : ↥S' := f k₀
    let S₀ : Type u := Localization.Away e₀
    have _ : IsLocalRing S₀ := hLoc_f k₀
    have he₀_idem : e₀ * e₀ = e₀ := hf.1.1 k₀
    have hu_e₀ : IsUnit (algebraMap ↥S' S₀ e₀) :=
      IsLocalization.map_units S₀ ⟨e₀, Submonoid.mem_powers e₀⟩
    have he₀_one : algebraMap ↥S' S₀ e₀ = 1 := by
      apply hu_e₀.mul_left_cancel
      rw [mul_one, ← map_mul, he₀_idem]
    have hSurj_S₀ : Function.Surjective (algebraMap ↥S' S₀) := by
      intro z
      obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj e₀ z
      refine ⟨a, ?_⟩
      rw [he₀_one, one_pow, mul_one] at hna
      exact hna.symm
    have _ : Module.Finite B_m S₀ :=
      Module.Finite.of_surjective (IsScalarTower.toAlgHom B_m ↥S' S₀).toLinearMap hSurj_S₀
    have hQ'_comap : Ideal.comap (algebraMap B_m ↥S') Q' = IsLocalRing.maximalIdeal B_m := by
      have hPm_ideal : Ideal.comap (algebraMap B_m C_m) P_m.asIdeal =
          IsLocalRing.maximalIdeal B_m :=
        congrArg PrimeSpectrum.asIdeal hPm
      ext b
      change S'.val (algebraMap B_m ↥S' b) ∈ P_m.asIdeal ↔ b ∈ IsLocalRing.maximalIdeal B_m
      rw [S'.val.commutes b, ← hPm_ideal]
      rfl
    have hInt_BmS' : (algebraMap B_m ↥S').IsIntegral := by
      have _ : Algebra.IsIntegral B_m ↥S' := Algebra.IsIntegral.of_finite B_m ↥S'
      exact Algebra.isIntegral_def.mp inferInstance
    have hQ'_max : Q'.IsMaximal :=
      Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap B_m ↥S') hInt_BmS' Q'
        (by rw [hQ'_comap]; exact IsLocalRing.maximalIdeal.isMaximal B_m)
    have hker_le_Q' : RingHom.ker (algebraMap ↥S' S₀) ≤ Q' := by
      intro x hx
      rw [RingHom.mem_ker, IsLocalization.map_eq_zero_iff (Submonoid.powers e₀) S₀] at hx
      obtain ⟨⟨m_val, n, rfl⟩, hmx⟩ := hx
      have hmem : e₀ ^ n * x ∈ Q' := by
        change (⟨e₀ ^ n, _⟩ : Submonoid.powers e₀).1 * x = 0 at hmx
        rw [hmx]
        exact Q'.zero_mem
      rcases hQ'_prime.mem_or_mem hmem with hpow | hxQ
      · exact False.elim (hfk₀_notMem (hQ'_prime.mem_of_pow_mem n hpow))
      · exact hxQ
    have hmap_Q'_ne_top : Ideal.map (algebraMap ↥S' S₀) Q' ≠ ⊤ := by
      intro htop
      have h1 : (1 : S₀) ∈ Ideal.map (algebraMap ↥S' S₀) Q' := by
        rw [htop]; trivial
      rw [Ideal.mem_map_iff_of_surjective (algebraMap ↥S' S₀) hSurj_S₀] at h1
      obtain ⟨y, hyQ, hy1⟩ := h1
      have hy_sub : y - 1 ∈ RingHom.ker (algebraMap ↥S' S₀) := by
        rw [RingHom.mem_ker, map_sub, hy1, map_one, sub_self]
      have h1Q : (1 : ↥S') ∈ Q' := by
        have hsubQ : y - 1 ∈ Q' := hker_le_Q' hy_sub
        have hdiff := Q'.sub_mem hyQ hsubQ
        simpa using hdiff
      exact hQ'_max.ne_top ((Ideal.eq_top_iff_one Q').mpr h1Q)
    have hQ'_eq_comap_max :
        Q' = Ideal.comap (algebraMap ↥S' S₀) (IsLocalRing.maximalIdeal S₀) := by
      have hle : Q' ≤ Ideal.comap (algebraMap ↥S' S₀) (IsLocalRing.maximalIdeal S₀) :=
        Ideal.map_le_iff_le_comap.mp (IsLocalRing.le_maximalIdeal hmap_Q'_ne_top)
      have hne_top : Ideal.comap (algebraMap ↥S' S₀) (IsLocalRing.maximalIdeal S₀) ≠ ⊤ := by
        intro htop
        have h1 : (1 : ↥S') ∈ Ideal.comap (algebraMap ↥S' S₀) (IsLocalRing.maximalIdeal S₀) := by
          rw [htop]; trivial
        change algebraMap ↥S' S₀ 1 ∈ IsLocalRing.maximalIdeal S₀ at h1
        rw [map_one] at h1
        exact (IsLocalRing.maximalIdeal.isMaximal S₀).ne_top
          ((Ideal.eq_top_iff_one _).mpr h1)
      exact hQ'_max.eq_of_le hne_top hle
    have hs'_unit : IsUnit (algebraMap ↥S' S₀ s') := by
      apply IsLocalRing.notMem_maximalIdeal.mp
      intro hmem
      have hs'_Q' : s' ∈ Q' := by
        rw [hQ'_eq_comap_max]
        exact hmem
      exact hs'_notMem hs'_Q'
    let q_k₀ : L_S' →+* S₀ := IsLocalization.Away.lift s' hs'_unit
    let _ : Algebra L_S' S₀ := q_k₀.toAlgebra
    have _ : IsScalarTower ↥S' L_S' S₀ := ⟨fun x y z => by
      rw [Algebra.smul_def (x • y) z, Algebra.smul_def y z]
      erw [Algebra.smul_def x y, Algebra.smul_def x (algebraMap L_S' S₀ y * z)]
      rw [map_mul, mul_assoc]
      change q_k₀ (algebraMap ↥S' L_S' x) * (algebraMap L_S' S₀ y * z) = _
      rw [IsLocalization.Away.lift_eq s' hs'_unit x]⟩
    have _ : IsScalarTower B_m L_S' S₀ := ⟨fun b y z => by
      rw [Algebra.smul_def (b • y) z, Algebra.smul_def y z]
      erw [Algebra.smul_def b y, Algebra.smul_def b (algebraMap L_S' S₀ y * z)]
      rw [map_mul, mul_assoc, IsScalarTower.algebraMap_apply B_m ↥S' L_S' b]
      change q_k₀ (algebraMap ↥S' L_S' (algebraMap B_m ↥S' b)) * (algebraMap L_S' S₀ y * z) = _
      rw [IsLocalization.Away.lift_eq s' hs'_unit (algebraMap B_m ↥S' b),
        ← IsScalarTower.algebraMap_apply B_m ↥S' S₀ b]⟩
    have _ : IsLocalization.Away (algebraMap ↥S' S₀ s') S₀ :=
      IsLocalization.away_of_isUnit_of_bijective (R := S₀) S₀ hs'_unit Function.bijective_id
    have _ : IsLocalization.Away (algebraMap ↥S' L_S' e₀) S₀ :=
      IsLocalization.Away.commutes (R := ↥S') L_S' S₀ S₀ s' e₀
    have _ : Algebra.Etale L_S' S₀ :=
      Algebra.Etale.of_isLocalizationAway (algebraMap ↥S' L_S' e₀)
    have _ : Algebra.Etale C_m L_C :=
      Algebra.Etale.of_isLocalizationAway (S'.val.toRingHom s')
    have _ : Algebra.Etale B_m L_C := Algebra.Etale.comp B_m C_m L_C
    have _ : Algebra.Etale B_m L_S' := Algebra.Etale.of_equiv e_zmt.symm
    have _ : Algebra.Etale B_m S₀ := Algebra.Etale.comp B_m L_S' S₀
    let ρ₀ : C_m →ₐ[B_m] S₀ :=
      (IsScalarTower.toAlgHom B_m L_S' S₀).comp
        (e_zmt.symm.toAlgHom.comp (IsScalarTower.toAlgHom B_m C_m L_C))
    exact ⟨S₀, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, ⟨ρ₀⟩⟩
  obtain ⟨S₀, hCRS₀, hLocS₀, hAlgS₀, hFinS₀, hEtS₀, ⟨ρ⟩⟩ := hStep3
  let _ : CommRing S₀ := hCRS₀
  have _ : IsLocalRing S₀ := hLocS₀
  let _ : Algebra B_m S₀ := hAlgS₀
  have _ : Module.Finite B_m S₀ := hFinS₀
  have _ : Algebra.Etale B_m S₀ := hEtS₀
  
  have hInt_BmS₀ : (algebraMap B_m S₀).IsIntegral := by
    have _ : Algebra.IsIntegral B_m S₀ := Algebra.IsIntegral.of_finite B_m S₀
    exact Algebra.isIntegral_def.mp inferInstance
  have hMax_BmS₀ : Ideal.comap (algebraMap B_m S₀) (IsLocalRing.maximalIdeal S₀) =
      IsLocalRing.maximalIdeal B_m :=
    IsLocalRing.eq_maximalIdeal
      (Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap B_m S₀) hInt_BmS₀
        (IsLocalRing.maximalIdeal S₀))
  have _ : IsLocalHom (algebraMap B_m S₀) := ⟨fun {b} hb => by
    have hb_not : algebraMap B_m S₀ b ∉ IsLocalRing.maximalIdeal S₀ :=
      IsLocalRing.notMem_maximalIdeal.mpr hb
    have hb_Bm : b ∉ IsLocalRing.maximalIdeal B_m := by
      rw [← hMax_BmS₀]
      exact hb_not
    exact IsLocalRing.notMem_maximalIdeal.mp hb_Bm⟩
  have _ : Module.FaithfullyFlat B_m S₀ := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hInj_S₀ : Function.Injective (algebraMap B_m S₀) :=
    (faithfulSMul_iff_algebraMap_injective B_m S₀).mp inferInstance
  obtain ⟨hSep_S₀, hMaxEq⟩ :=
    (Algebra.FormallyUnramified.iff_map_maximalIdeal_eq (R := B_m) (S := S₀)).mp inferInstance
  have _ : Algebra.IsSeparable (IsLocalRing.ResidueField B_m) (IsLocalRing.ResidueField S₀) :=
    hSep_S₀
  have hRes_surj : Function.Surjective
      (algebraMap (IsLocalRing.ResidueField B_m) (IsLocalRing.ResidueField S₀)) :=
    IsSepClosed.algebraMap_surjective
      (IsLocalRing.ResidueField B_m) (IsLocalRing.ResidueField S₀)
  let J : Ideal S₀ := Ideal.map (algebraMap B_m S₀) (IsLocalRing.maximalIdeal B_m)
  have hSpan1 : Submodule.span B_m ({(1 : S₀)} : Set S₀) = ⊤ := by
    apply (IsLocalRing.quotient_span_eq_top_iff_span_eq_top
      (R := B_m) (S := S₀) ({(1 : S₀)} : Set S₀)).mp
    rw [eq_top_iff]
    intro ybar _
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective ybar
    obtain ⟨r_res, hr_res⟩ := hRes_surj (IsLocalRing.residue S₀ y)
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective r_res
    have h_alg_res : algebraMap (IsLocalRing.ResidueField B_m) (IsLocalRing.ResidueField S₀)
        (IsLocalRing.residue B_m b) = IsLocalRing.residue S₀ (algebraMap B_m S₀ b) :=
      IsLocalRing.ResidueField.map_residue (algebraMap B_m S₀) b
    rw [h_alg_res] at hr_res
    have hy_sub : y - algebraMap B_m S₀ b ∈ J := by
      change y - algebraMap B_m S₀ b ∈ Ideal.map (algebraMap B_m S₀) (IsLocalRing.maximalIdeal B_m)
      rw [hMaxEq, ← IsLocalRing.residue_eq_zero_iff, map_sub, hr_res, sub_self]
    have hy_mk : Ideal.Quotient.mk J y = Ideal.Quotient.mk J (algebraMap B_m S₀ b) := by
      rw [Ideal.Quotient.eq]
      exact hy_sub
    rw [hy_mk]
    have h_smul : Ideal.Quotient.mk J (algebraMap B_m S₀ b) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal B_m) b • Ideal.Quotient.mk J (1 : S₀) := by
      rw [Algebra.algebraMap_eq_smul_one]
      rfl
    rw [h_smul]
    exact Submodule.smul_mem _ _
      (Submodule.subset_span ⟨(1 : S₀), Set.mem_singleton _, rfl⟩)
  have hSurj_BmS₀ : Function.Surjective (algebraMap B_m S₀) := by
    intro y
    have hy : y ∈ Submodule.span B_m ({(1 : S₀)} : Set S₀) := by
      rw [hSpan1]; trivial
    rw [Submodule.mem_span_singleton] at hy
    obtain ⟨b, hb⟩ := hy
    refine ⟨b, ?_⟩
    simpa [Algebra.smul_def] using hb
  let e_iso : B_m ≃+* S₀ := RingEquiv.ofBijective (algebraMap B_m S₀) ⟨hInj_S₀, hSurj_BmS₀⟩
  let σ_m : C₀ →+* B_m :=
    e_iso.symm.toRingHom.comp
      (ρ.toRingHom.comp
        (Algebra.TensorProduct.includeRight (R := B) (A := B_m) (B := C₀)).toRingHom)
  refine ⟨σ_m, ?_⟩
  ext b
  have h_inc : (Algebra.TensorProduct.includeRight (R := B) (A := B_m) (B := C₀))
      (algebraMap B C₀ b) = algebraMap B_m C_m (ι_B b) := by
    change (1 : B_m) ⊗ₜ[B] (algebraMap B C₀ b) = (ι_B b) ⊗ₜ[B] (1 : C₀)
    rw [Algebra.algebraMap_eq_smul_one, TensorProduct.tmul_smul, TensorProduct.smul_tmul',
      ← Algebra.algebraMap_eq_smul_one]
    rfl
  change e_iso.symm (ρ ((Algebra.TensorProduct.includeRight (R := B) (A := B_m) (B := C₀))
    (algebraMap B C₀ b))) = ι_B b
  rw [h_inc, ρ.commutes (ι_B b)]
  exact e_iso.symm_apply_apply (ι_B b)

theorem weil_filtered_colimit_etale_section_descent (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    (I : Type u) (C : I → Type u)
    [∀ i, CommRing (C i)] [∀ i, Algebra B (C i)] [∀ i, Algebra.Etale B (C i)]
    (J : Type u) [CategoryTheory.SmallCategory J] [CategoryTheory.IsFiltered J]
    (F : CategoryTheory.Functor J CommRingCat.{u})
    [∀ j : J, Algebra R (F.obj j)]
    (hF_alg : ∀ (j₁ j₂ : J) (u : Quiver.Hom j₁ j₂) (r₀ : R),
      (F.map u).hom (algebraMap R (F.obj j₁) r₀) = algebraMap R (F.obj j₂) r₀)
    (c : CategoryTheory.Limits.Cocone F)
    [Algebra R c.pt]
    (hι_alg : ∀ (j : J) (r₀ : R), (c.ι.app j).hom (algebraMap R (F.obj j) r₀) = algebraMap R c.pt r₀)
    (hc : Nonempty (CategoryTheory.Limits.IsColimit c))
    (r : ℕ) (e_A : Fin r → TensorProduct R B c.pt)
    (he_A : CompleteOrthogonalIdempotents e_A)
    (idx : Fin r → I)
    (σ_A : ∀ m : Fin r, C (idx m) →+* Localization.Away (e_A m))
    (hσ_A : ∀ m : Fin r, (σ_A m).comp (algebraMap B (C (idx m))) =
      (algebraMap (TensorProduct R B c.pt) (Localization.Away (e_A m))).comp
        Algebra.TensorProduct.includeLeftRingHom) :
    ∃ (j_star : J)
      (e : Fin r → TensorProduct R B (F.obj j_star))
      (σ : ∀ m : Fin r, C (idx m) →+* Localization.Away (e m)),
      CompleteOrthogonalIdempotents e ∧
      (∀ m : Fin r, (σ m).comp (algebraMap B (C (idx m))) =
        (algebraMap (TensorProduct R B (F.obj j_star)) (Localization.Away (e m))).comp
          Algebra.TensorProduct.includeLeftRingHom) :=
by
  classical
  have cr_ext : ∀ {X Y : CommRingCat.{u}} {f g : X ⟶ Y}, f.hom = g.hom → f = g :=
    fun h => CommRingCat.Hom.ext h
  obtain ⟨hc₀⟩ := hc
  let φ_map : ∀ (j₁ j₂ : J) (u : j₁ ⟶ j₂), F.obj j₁ →ₐ[R] F.obj j₂ :=
    fun j₁ j₂ u => { (F.map u).hom with commutes' := hF_alg j₁ j₂ u }
  let φ_ι : ∀ (j : J), F.obj j →ₐ[R] c.pt :=
    fun j => { (c.ι.app j).hom with commutes' := hι_alg j }
  let F_D : J ⥤ CommRingCat.{u} :=
    { obj := fun j => CommRingCat.of (TensorProduct R B (F.obj j))
      map := fun {j₁ j₂} u =>
        CommRingCat.ofHom (Algebra.TensorProduct.map (AlgHom.id R B) (φ_map j₁ j₂ u)).toRingHom
