      (hHasCo W).has_colimit (CategoryTheory.Limits.parallelPair α 0)
    rw [CategoryTheory.Preadditive.epi_iff_isZero_cokernel]
    apply hCons W
    intro Ω _ _ w
    let Φ := (pt W Ω w).sheafFiber (A := AddCommGrpCat.{u})
    have _ : Φ.IsLeftAdjoint :=
