        have hα_eq : adj_Z.homEquiv Aℤ 𝒢 α = g_S ≫ 𝒢.obj.map τ_iso.inv.op :=
          (adj_Z.homEquiv Aℤ 𝒢).apply_symm_apply _
        rw [hα_eq, Category.assoc, ← CategoryTheory.Functor.map_comp, ← op_comp,
          τ_iso.hom_inv_id, op_id, CategoryTheory.Functor.map_id, Category.comp_id]
      dsimp [Θ]
      rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, hcomp_eq]
      exact Abelian.Ext.mk₀_homEquiv₀_apply y
    | succ m ih =>
      intro 𝒢 z
      let I := Injective.under 𝒢
      let ι_I : 𝒢 ⟶ I := Injective.ι 𝒢
      let Q := Limits.cokernel ι_I
      let π_I : I ⟶ Q := Limits.cokernel.π ι_I
      have hS₀ : (ShortComplex.mk ι_I π_I (Limits.cokernel.condition ι_I)).ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι_I) inferInstance inferInstance
      have hS₁ : ((ShortComplex.mk ι_I π_I (Limits.cokernel.condition ι_I)).map P_push_Z).ShortExact :=
        hS₀.map_of_exact P_push_Z
      haveI : Injective (P_push_Z.obj I) := hInj I inferInstance
      have hzI : z.comp (Abelian.Ext.mk₀ ((ShortComplex.mk ι_I π_I (Limits.cokernel.condition ι_I)).map P_push_Z).f)
          (Nat.add_zero (m + 1)) = 0 := by
        change z.comp (Abelian.Ext.mk₀ (P_push_Z.map ι_I)) (Nat.add_zero (m + 1)) = 0
        exact Abelian.Ext.eq_zero_of_injective _
      obtain ⟨y₁, hy₁⟩ :=
        Abelian.Ext.covariant_sequence_exact₁ Fℤ_S hS₁ z hzI (n₀ := m) rfl
      obtain ⟨y₀, hy₀⟩ := ih Q y₁
      refine ⟨y₀.comp hS₀.extClass rfl, ?_⟩
      dsimp [Θ] at hy₀ ⊢
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass P_push_Z hS₀,
        ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ρℤ) (Abelian.Ext.mapExactFunctor P_push_Z y₀)
          hS₁.extClass (Nat.zero_add m) rfl (Nat.zero_add (m + 1)),
        hy₀, hy₁]

  
  let m_deg : ℕ := q - 1
  have hm1 : 1 ≤ m_deg := by omega
  have hq1 : 1 ≤ q := by omega
  have hmq : m_deg + 1 = q := by omega
  have hSub_Z_m : Subsingleton ((weilEtaleTorsionSheaf Z n).H m_deg) :=
    hDiscVanish (weilEtaleTorsionSheaf Z n) m_deg hm1
  have hSub_Z_q : Subsingleton ((weilEtaleTorsionSheaf Z n).H q) :=
    hDiscVanish (weilEtaleTorsionSheaf Z n) q hq1
  have hSub_push_m : Subsingleton ((P_push_Z.obj (weilEtaleTorsionSheaf Z n)).H m_deg) :=
    @Function.Surjective.subsingleton _ _ (Θ m_deg (weilEtaleTorsionSheaf Z n))
      hSub_Z_m (hSurj_Θ m_deg (weilEtaleTorsionSheaf Z n))
  have hSub_push_q : Subsingleton ((P_push_Z.obj (weilEtaleTorsionSheaf Z n)).H q) :=
    @Function.Surjective.subsingleton _ _ (Θ q (weilEtaleTorsionSheaf Z n))
      hSub_Z_q (hSurj_Θ q (weilEtaleTorsionSheaf Z n))
  let ι_post := (CategoryTheory.Abelian.Ext.mk₀ ι).postcomp Fℤ_S (Nat.add_zero q)
  refine ⟨?_, ?_⟩
  · intro a₁ a₂ ha
    have hdiff0 : (a₁ - a₂).comp (Abelian.Ext.mk₀ ι) (Nat.add_zero q) = 0 := by
      change ι_post (a₁ - a₂) = 0
      rw [map_sub, ha, sub_self]
    obtain ⟨c, hc⟩ :=
      Abelian.Ext.covariant_sequence_exact₁ Fℤ_S hSE (a₁ - a₂) hdiff0 (n₀ := m_deg) hmq
    have hc0 : c = 0 := @Subsingleton.elim _ hSub_push_m c 0
    rw [hc0, Abelian.Ext.zero_comp] at hc
    exact sub_eq_zero.mp hc.symm
  · intro b
    have hb0 : b.comp (Abelian.Ext.mk₀ (ShortComplex.mk ι _ h0).g) (Nat.add_zero q) = 0 :=
      @Subsingleton.elim _ hSub_push_q _ 0
    exact Abelian.Ext.covariant_sequence_exact₂ Fℤ_S hSE b hb0

theorem weil_etale_zero_bdry_disjoint_birational_product_iso (Y₀ : AlgebraicGeometry.Scheme.{u}) (r n : ℕ)
    (X Z : Fin r → AlgebraicGeometry.Scheme.{u})
    (ι_Z : ∀ c : Fin r, Z c ⟶ Y₀)
    (ν : ∀ c : Fin r, X c ⟶ Z c)
    (V_comp : Fin r → Y₀.Opens)
    (hComp : ∀ c : Fin r,
      AlgebraicGeometry.IsClosedImmersion (ι_Z c) ∧
      AlgebraicGeometry.IsFinite (ν c) ∧
      AlgebraicGeometry.Surjective ((ι_Z c) ∣_ (V_comp c)) ∧
      CategoryTheory.IsIso ((ν c) ∣_
        ((TopologicalSpace.Opens.map (ι_Z c).base).obj (V_comp c))))
    (hDisj : ∀ c₁ c₂ : Fin r, c₁ ≠ c₂ →
      Disjoint (Set.range (ι_Z c₁).base) (V_comp c₂ : Set Y₀))
    (K_Y : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u})
    (ι_Y : K_Y ⟶ weilEtaleTorsionSheaf Y₀ n)
    (hEx_Y : WeilAltIsZeroBdryExact Y₀ (⨆ c : Fin r, V_comp c) n K_Y ι_Y)
    (K_X : ∀ c : Fin r, CategoryTheory.Sheaf (X c).smallEtaleTopology AddCommGrpCat.{u})
    (ι_X : ∀ c : Fin r, K_X c ⟶ weilEtaleTorsionSheaf (X c) n)
    (hEx_X : ∀ c : Fin r,
      WeilAltIsZeroBdryExact (X c)
        ((TopologicalSpace.Opens.map (ν c ≫ ι_Z c).base).obj (V_comp c)) n (K_X c) (ι_X c))
    [∀ c : Fin r,
      (weilEtaleSitePullback (ν c ≫ ι_Z c)).IsContinuous
        Y₀.smallEtaleTopology (X c).smallEtaleTopology]
    (T_X : ∀ c : Fin r, (X c).Etale)
    (hT_X : ∀ c : Fin r, CategoryTheory.Limits.IsTerminal (T_X c))
    (T_Y : ∀ c : Fin r, Y₀.Etale)
    (hT_Y : ∀ c : Fin r, CategoryTheory.Limits.IsTerminal (T_Y c)) :
    let P_push := fun c : Fin r =>
      (weilEtaleSitePullback (ν c ≫ ι_Z c)).sheafPushforwardContinuous
        AddCommGrpCat.{u} Y₀.smallEtaleTopology (X c).smallEtaleTopology
    let η_M := fun c : Fin r =>
      ((CategoryTheory.constantSheafAdj Y₀.smallEtaleTopology AddCommGrpCat.{u} (hT_Y c)).homEquiv
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n)))
        ((P_push c).obj (weilEtaleTorsionSheaf (X c) n))).symm
        (CategoryTheory.CategoryStruct.comp
          ((CategoryTheory.constantSheafAdj (X c).smallEtaleTopology AddCommGrpCat.{u} (hT_X c)).unit.app _)
          ((weilEtaleTorsionSheaf (X c) n).obj.map
            (Opposite.op ((hT_X c).from ((weilEtaleSitePullback (ν c ≫ ι_Z c)).obj (T_Y c))))))
    ∃ ψ : ∀ c : Fin r, K_Y ⟶ (P_push c).obj (K_X c),
      CategoryTheory.IsIso (CategoryTheory.Limits.Pi.lift ψ) ∧
      ∀ c : Fin r,
        CategoryTheory.CategoryStruct.comp (ψ c) ((P_push c).map (ι_X c)) =
          CategoryTheory.CategoryStruct.comp ι_Y (η_M c) :=
by
  classical
  intro P_push η_M
  let AM : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))

  
  
  
  have hMemEtale : ∀ (W : Scheme.{u}) (U : W.Etale) (R : Sieve U),
      R ∈ W.smallEtaleTopology U ↔
        ∀ x : ↥U.left, ∃ (Y : W.Etale) (f : Y ⟶ U) (y : ↥Y.left),
          R.arrows f ∧ Etale f.left ∧ f.left y = x := by
    intro W U R
    have : MorphismProperty.IsMultiplicative (@AlgebraicGeometry.Etale.{u}) :=
      AlgebraicGeometry.Etale.instIsMultiplicativeScheme.{u}
    have : MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have : MorphismProperty.IsStableUnderBaseChange (@AlgebraicGeometry.Etale.{u}) :=
      AlgebraicGeometry.Etale.etale_isStableUnderBaseChange.{u}
    have : MorphismProperty.HasOfPostcompProperty (@AlgebraicGeometry.Etale.{u})
        (@AlgebraicGeometry.Etale.{u}) :=
      AlgebraicGeometry.Etale.instHasOfPostcompPropertyScheme.{u}
    have hJ : W.smallEtaleTopology = W.smallEtalePretopology.toGrothendieck :=
      @Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (@AlgebraicGeometry.Etale.{u}) (@AlgebraicGeometry.Etale.{u}) W _ _ _ _ _ (le_refl _)
    rw [hJ]
    exact @Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale.{u}) (@AlgebraicGeometry.Etale.{u}) W _ _ _ _ _ U R

  have hEtHomExt : ∀ {W : Scheme.{u}} {A B : W.Etale} (f g : A ⟶ B),
      f.left = g.left → f = g :=
    fun {_ _ _} f g h => (Scheme.Etale.forget _).map_injective (Over.OverMorphism.ext h)

  have hShForArrows : ∀ {W : Scheme.{u}}
      (ℱ : Sheaf W.smallEtaleTopology AddCommGrpCat.{u}) {U : W.Etale}
      {I : Type u} (Y : I → W.Etale) (π : ∀ i : I, Y i ⟶ U),
      Sieve.ofArrows Y π ∈ W.smallEtaleTopology U →
      ∀ (sec : ∀ i : I, ↥(ℱ.obj.obj (Opposite.op (Y i)))),
        (∀ (i j : I) (Z₀ : W.Etale) (g₁ : Z₀ ⟶ Y i) (g₂ : Z₀ ⟶ Y j),
          g₁ ≫ π i = g₂ ≫ π j →
          (ℱ.obj.map g₁.op) (sec i) = (ℱ.obj.map g₂.op) (sec j)) →
        ∃! t : ↥(ℱ.obj.obj (Opposite.op U)),
          ∀ i : I, (ℱ.obj.map (π i).op) t = sec i := by
    intro W ℱ U I Y π hcov sec hcomp
    have h1 : Presheaf.IsSheaf W.smallEtaleTopology (ℱ.obj ⋙ forget AddCommGrpCat.{u}) :=
      Presheaf.isSheaf_comp_of_isSheaf W.smallEtaleTopology ℱ.obj
        (forget AddCommGrpCat.{u}) ℱ.property
    have h2 : Presieve.IsSheafFor (ℱ.obj ⋙ forget AddCommGrpCat.{u}) (Presieve.ofArrows Y π) :=
      ((isSheaf_iff_isSheaf_of_type W.smallEtaleTopology _).mp h1).isSheafFor
        (Presieve.ofArrows Y π) hcov
    exact (Presieve.isSheafFor_arrows_iff (ℱ.obj ⋙ forget AddCommGrpCat.{u}) π).mp h2 sec
      (fun i j Z₀ g₁ g₂ hcomm => hcomp i j Z₀ g₁ g₂ hcomm)

  have hEmptySub : ∀ (W : Scheme.{u})
      (ℱ : Sheaf W.smallEtaleTopology AddCommGrpCat.{u}) (Z₀ : W.Etale),
      IsEmpty ↥Z₀.left → Subsingleton ↥(ℱ.obj.obj (Opposite.op Z₀)) := by
    intro W ℱ Z₀ hEmp
    let Y_emp : ↥Z₀.left → W.Etale := fun z => IsEmpty.elim hEmp z
    let π_emp : ∀ z : ↥Z₀.left, Y_emp z ⟶ Z₀ := fun z => IsEmpty.elim hEmp z
    have hcov : Sieve.ofArrows Y_emp π_emp ∈ W.smallEtaleTopology Z₀ :=
      (hMemEtale W Z₀ _).mpr (fun z => IsEmpty.elim hEmp z)
    obtain ⟨t₀, -, huniq⟩ := hShForArrows ℱ Y_emp π_emp hcov
      (fun z => IsEmpty.elim hEmp z)
      (fun z _ _ _ _ _ => IsEmpty.elim hEmp z)
    exact ⟨fun a b => (huniq a (fun z => IsEmpty.elim hEmp z)).trans
      (huniq b (fun z => IsEmpty.elim hEmp z)).symm⟩

  have hShL_gen : ∀ (W : Scheme.{u}),
      Presheaf.IsSheaf W.smallEtaleTopology (weilAltLocConstPresheaf W n) := by
    intro W
    apply Presheaf.isSheaf_of_isSheaf_comp W.smallEtaleTopology
      (weilAltLocConstPresheaf W n) (forget AddCommGrpCat.{u})
    rw [isSheaf_iff_isSheaf_of_type]
    intro U R hR sec hcompat
    have hcov := (hMemEtale W U R).mp hR
    choose Yx fx yx hfx_mem hfx_et hfx_pt using hcov
    let secL : ∀ {Y : W.Etale} (f : Y ⟶ U),
        R.arrows f → LocallyConstant ↥Y.left (ULift.{u} (ZMod n)) :=
      fun f hf => sec f hf
    let t_fun : ↥U.left → ULift.{u} (ZMod n) :=
      fun x => (secL (fx x) (hfx_mem x)) (yx x)
    have h_eval : ∀ (Y : W.Etale) (f : Y ⟶ U) (hf : R.arrows f) (y : ↥Y.left),
        (secL f hf) y = t_fun (f.left y) := by
      intro Y f hf y
      let x : ↥U.left := f.left y
      let P_sch := Limits.pullback f.left (fx x).left
      let pr₁ : P_sch ⟶ Y.left := Limits.pullback.fst f.left (fx x).left
      let pr₂ : P_sch ⟶ (Yx x).left := Limits.pullback.snd f.left (fx x).left
      have hpr₁_et : Etale pr₁ :=
        MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (IsPullback.of_hasPullback f.left (fx x).left).flip (hfx_et x)
      have hZ_et : Etale (pr₁ ≫ Y.hom) := by
        have := Y.prop
        infer_instance
      let Z_et : W.Etale := MorphismProperty.Over.mk ⊤ (pr₁ ≫ Y.hom) hZ_et
      let q₁ : Z_et ⟶ Y := MorphismProperty.Over.homMk pr₁ rfl
      let q₂ : Z_et ⟶ Yx x := MorphismProperty.Over.homMk pr₂ (by
        change pr₂ ≫ (Yx x).hom = pr₁ ≫ Y.hom
        rw [← MorphismProperty.Over.w (fx x), ← MorphismProperty.Over.w f,
          ← Category.assoc, ← Category.assoc, Limits.pullback.condition])
      have hq_comm : q₁ ≫ f = q₂ ≫ fx x :=
        hEtHomExt _ _ Limits.pullback.condition
      obtain ⟨z, hz₁, hz₂⟩ :=
        Scheme.Pullback.exists_preimage_pullback y (yx x) (hfx_pt x).symm
      have hc := hcompat q₁ q₂ hf (hfx_mem x) hq_comm
      have hc_z : (secL f hf) (pr₁ z) = (secL (fx x) (hfx_mem x)) (pr₂ z) :=
        congrArg (fun g : LocallyConstant ↥P_sch (ULift.{u} (ZMod n)) => g z) hc
      rwa [hz₁, hz₂] at hc_z
    have ht_lc : IsLocallyConstant t_fun := by
      intro E
      rw [isOpen_iff_forall_mem_open]
      intro x hx
      let O_x : Set ↥(Yx x).left := (secL (fx x) (hfx_mem x)) ⁻¹' E
      have hOx_open : IsOpen O_x := (secL (fx x) (hfx_mem x)).isLocallyConstant E
      have : Etale (fx x).left := hfx_et x
      refine ⟨(fx x).left '' O_x, ?_, (fx x).left.isOpenMap O_x hOx_open,
        ⟨yx x, hx, hfx_pt x⟩⟩
      rintro _ ⟨y', hy', rfl⟩
      change t_fun ((fx x).left y') ∈ E
      rw [← h_eval (Yx x) (fx x) (hfx_mem x) y']
      exact hy'
    let t_loc : LocallyConstant ↥U.left (ULift.{u} (ZMod n)) := ⟨t_fun, ht_lc⟩
    refine ⟨t_loc, ?_, ?_⟩
    · intro Y f hf
      exact LocallyConstant.ext (fun y => (h_eval Y f hf y).symm)
    · intro t' ht'
      let t'_L : LocallyConstant ↥U.left (ULift.{u} (ZMod n)) := t'
      apply LocallyConstant.ext
      intro x
      calc t'_L x
          = t'_L ((fx x).left (yx x)) := congrArg t'_L (hfx_pt x).symm
        _ = (secL (fx x) (hfx_mem x)) (yx x) :=
            congrArg (fun g : LocallyConstant ↥(Yx x).left (ULift.{u} (ZMod n)) => g (yx x))
              (ht' (fx x) (hfx_mem x))
        _ = t_loc x := rfl

  have hSh0_gen : ∀ (S₀ : Scheme.{u}) (V₀ : S₀.Opens),
      Presheaf.IsSheaf S₀.smallEtaleTopology (weilAltZeroBdrySubpresheaf S₀ V₀ n) := by
    intro S₀ V₀
    apply Presheaf.isSheaf_of_isSheaf_comp S₀.smallEtaleTopology
      (weilAltZeroBdrySubpresheaf S₀ V₀ n) (forget AddCommGrpCat.{u})
    rw [isSheaf_iff_isSheaf_of_type]
    intro U R hR sec hcompat
    have hL : Presieve.IsSheaf S₀.smallEtaleTopology
        (weilAltLocConstPresheaf S₀ n ⋙ forget AddCommGrpCat.{u}) :=
      (isSheaf_iff_isSheaf_of_type S₀.smallEtaleTopology _).mp
        (Presheaf.isSheaf_comp_of_isSheaf S₀.smallEtaleTopology
          (weilAltLocConstPresheaf S₀ n) (forget AddCommGrpCat.{u}) (hShL_gen S₀))
    let sec_L : Presieve.FamilyOfElements
        (weilAltLocConstPresheaf S₀ n ⋙ forget AddCommGrpCat.{u}) (R : Presieve U) :=
      fun Y f hf => (sec f hf).1
    have hcompat_L : sec_L.Compatible := by
      intro Y₁ Y₂ Z₀ g₁ g₂ f₁ f₂ h₁ h₂ hcomm
      exact congrArg Subtype.val (hcompat g₁ g₂ h₁ h₂ hcomm)
    obtain ⟨t_L, ht_amal, ht_uniq⟩ := hL R hR sec_L hcompat_L
    let t_Lc : LocallyConstant ↥U.left (ULift.{u} (ZMod n)) := t_L
    have ht_mem : t_Lc ∈ weilAltZeroBdrySubgroup S₀ V₀ n U := by
      intro x hx
      obtain ⟨Y, f, y, hf_mem, -, hf_pt⟩ := ((hMemEtale S₀ U R).mp hR) x
      have hy_not_V : Y.hom y ∉ (V₀ : Set ↥S₀) := by
        intro hy_in
        apply hx
        have hw : f.left ≫ U.hom = Y.hom := MorphismProperty.Over.w f
        have hpt : U.hom x = Y.hom y := by
          rw [← hf_pt, ← Scheme.Hom.comp_apply, hw]
        change U.hom x ∈ (V₀ : Set ↥S₀)
        rwa [hpt]
      have h_res := congrArg (fun g : LocallyConstant ↥Y.left (ULift.{u} (ZMod n)) => g y)
        (ht_amal f hf_mem)
      change t_Lc (f.left y) = (sec f hf_mem).1 y at h_res
      exact (congrArg t_Lc hf_pt.symm).trans (h_res.trans ((sec f hf_mem).2 y hy_not_V))
    refine ⟨⟨t_Lc, ht_mem⟩, ?_, ?_⟩
    · intro Y f hf
      exact Subtype.ext (ht_amal f hf)
    · intro t' ht'
      exact Subtype.ext (ht_uniq t'.1 (fun Y f hf => congrArg Subtype.val (ht' f hf)))

  have hPhi_gen : ∀ (W : Scheme.{u}),
      ∃ (Φ : weilEtaleTorsionSheaf W n ≅ ⟨weilAltLocConstPresheaf W n, hShL_gen W⟩),
        ∀ (T_W : W.Etale) (hT_W : Limits.IsTerminal T_W),
          (constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT_W).unit.app AM ≫
            Φ.hom.hom.app (Opposite.op T_W) =
            weilAltLocConstConstHom W T_W n := by
    intro W
    let T₀ : W.Etale := MorphismProperty.Over.mk ⊤ (𝟙 W) inferInstance
    have hT₀ : Limits.IsTerminal T₀ :=
      Limits.IsTerminal.ofUniqueHom
        (fun U => MorphismProperty.Over.homMk U.hom (Category.comp_id U.hom))
        (fun U m => hEtHomExt _ _ ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
    let FM := weilEtaleTorsionSheaf W n
    let L_sh : Sheaf W.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltLocConstPresheaf W n, hShL_gen W⟩
    let adj₀ := constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT₀
    let Φ_hom : FM ⟶ L_sh := (adj₀.homEquiv AM L_sh).symm (weilAltLocConstConstHom W T₀ n)
    have hΦ_T₀ : adj₀.unit.app AM ≫ Φ_hom.hom.app (Opposite.op T₀) =
        weilAltLocConstConstHom W T₀ n := by
      have h1 := (adj₀.homEquiv AM L_sh).apply_symm_apply (weilAltLocConstConstHom W T₀ n)
      have h2 := Adjunction.homEquiv_unit adj₀ AM L_sh Φ_hom
      exact h2.symm.trans h1
    let O_lvl : ∀ (U : W.Etale),
        LocallyConstant ↥U.left (ULift.{u} (ZMod n)) → ↥U.left → U.left.Opens :=
      fun U s x => ⟨s ⁻¹' {s x}, s.isLocallyConstant {s x}⟩
    let W_lvl : ∀ (U : W.Etale),
        LocallyConstant ↥U.left (ULift.{u} (ZMod n)) → ↥U.left → W.Etale :=
      fun U s x => MorphismProperty.Over.mk ⊤ ((O_lvl U s x).ι ≫ U.hom)
        (by have := U.prop; infer_instance)
    let j_lvl : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod n)))
        (x : ↥U.left), W_lvl U s x ⟶ U :=
      fun U s x => MorphismProperty.Over.homMk (O_lvl U s x).ι rfl
    have hj_cov : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod n))),
        Sieve.ofArrows (W_lvl U s) (j_lvl U s) ∈ W.smallEtaleTopology U := by
      intro U s
      rw [hMemEtale]
      intro x
      exact ⟨W_lvl U s x, j_lvl U s x, ⟨x, rfl⟩,
        Sieve.ofArrows_mk (W_lvl U s) (j_lvl U s) x, inferInstance, rfl⟩
    have hψ_ex : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod n))),
        ∃! t : ↥(FM.obj.obj (Opposite.op U)),
          ∀ x : ↥U.left,
            (FM.obj.map (j_lvl U s x).op) t =
              (FM.obj.map (hT₀.from (W_lvl U s x)).op) ((adj₀.unit.app AM) (s x)) := by
      intro U s
      refine hShForArrows FM (W_lvl U s) (j_lvl U s) (hj_cov U s)
        (fun x => (FM.obj.map (hT₀.from (W_lvl U s x)).op) ((adj₀.unit.app AM) (s x))) ?_
      intro x₁ x₂ Z₀ g₁ g₂ hcomm
      by_cases hne : Nonempty ↥Z₀.left
      · obtain ⟨z₀⟩ := hne
        have hleft : g₁.left ≫ (O_lvl U s x₁).ι = g₂.left ≫ (O_lvl U s x₂).ι :=
          congrArg (fun k : Z₀ ⟶ U => k.left) hcomm
        have hpt : (g₁.left ≫ (O_lvl U s x₁).ι) z₀ = (g₂.left ≫ (O_lvl U s x₂).ι) z₀ :=
          congrArg (fun k : Z₀.left ⟶ U.left => k z₀) hleft
        have hs₁ : s ((g₁.left ≫ (O_lvl U s x₁).ι) z₀) = s x₁ := (g₁.left z₀).2
        have hs₂ : s ((g₂.left ≫ (O_lvl U s x₂).ι) z₀) = s x₂ := (g₂.left z₀).2
        have hs_eq : s x₁ = s x₂ := hs₁.symm.trans ((congrArg s hpt).trans hs₂)
        have hterm_eq : g₁ ≫ hT₀.from (W_lvl U s x₁) = g₂ ≫ hT₀.from (W_lvl U s x₂) :=
          hT₀.hom_ext _ _
        calc (FM.obj.map g₁.op)
              ((FM.obj.map (hT₀.from (W_lvl U s x₁)).op) ((adj₀.unit.app AM) (s x₁)))
            = (FM.obj.map (g₁ ≫ hT₀.from (W_lvl U s x₁)).op) ((adj₀.unit.app AM) (s x₁)) := by
              rw [op_comp, FM.obj.map_comp]; rfl
          _ = (FM.obj.map (g₂ ≫ hT₀.from (W_lvl U s x₂)).op) ((adj₀.unit.app AM) (s x₂)) := by
              rw [hterm_eq, hs_eq]
          _ = (FM.obj.map g₂.op)
              ((FM.obj.map (hT₀.from (W_lvl U s x₂)).op) ((adj₀.unit.app AM) (s x₂))) := by
              rw [op_comp, FM.obj.map_comp]; rfl
      · have : Subsingleton ↥(FM.obj.obj (Opposite.op Z₀)) :=
          hEmptySub W FM Z₀ (not_nonempty_iff.mp hne)
        exact Subsingleton.elim _ _
    let ψ_fun : ∀ (U : W.Etale),
        LocallyConstant ↥U.left (ULift.{u} (ZMod n)) → ↥(FM.obj.obj (Opposite.op U)) :=
      fun U s => Classical.choose (hψ_ex U s)
    have hψ_spec : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod n)))
        (x : ↥U.left),
        (FM.obj.map (j_lvl U s x).op) (ψ_fun U s) =
          (FM.obj.map (hT₀.from (W_lvl U s x)).op) ((adj₀.unit.app AM) (s x)) :=
      fun U s => (Classical.choose_spec (hψ_ex U s)).1
    have hψ_uniq : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod n)))
        (t : ↥(FM.obj.obj (Opposite.op U))),
        (∀ x : ↥U.left,
          (FM.obj.map (j_lvl U s x).op) t =
            (FM.obj.map (hT₀.from (W_lvl U s x)).op) ((adj₀.unit.app AM) (s x))) →
        t = ψ_fun U s :=
      fun U s t ht => (Classical.choose_spec (hψ_ex U s)).2 t ht
    have hψ_zero : ∀ U : W.Etale, ψ_fun U 0 = 0 := by
      intro U
      symm
      apply hψ_uniq U 0 0
      intro x
      change (FM.obj.map (j_lvl U 0 x).op) 0 =
        (FM.obj.map (hT₀.from (W_lvl U 0 x)).op) ((adj₀.unit.app AM) 0)
      rw [map_zero, map_zero, map_zero]
    have hψ_add : ∀ (U : W.Etale)
        (s₁ s₂ : LocallyConstant ↥U.left (ULift.{u} (ZMod n))),
        ψ_fun U (s₁ + s₂) = ψ_fun U s₁ + ψ_fun U s₂ := by
      intro U s₁ s₂
      let O₁₂ : ↥U.left → U.left.Opens := fun x => O_lvl U s₁ x ⊓ O_lvl U s₂ x
      let W₁₂ : ↥U.left → W.Etale := fun x =>
        MorphismProperty.Over.mk ⊤ ((O₁₂ x).ι ≫ U.hom) (by have := U.prop; infer_instance)
      let j₁₂ : ∀ x : ↥U.left, W₁₂ x ⟶ U :=
        fun x => MorphismProperty.Over.homMk (O₁₂ x).ι rfl
      have hcov₁₂ : Sieve.ofArrows W₁₂ j₁₂ ∈ W.smallEtaleTopology U := by
        rw [hMemEtale]
        intro x
        exact ⟨W₁₂ x, j₁₂ x, ⟨x, ⟨rfl, rfl⟩⟩,
          Sieve.ofArrows_mk W₁₂ j₁₂ x, inferInstance, rfl⟩
      let c₁₂ : ∀ x : ↥U.left, ↥(FM.obj.obj (Opposite.op (W₁₂ x))) :=
        fun x => (FM.obj.map (hT₀.from (W₁₂ x)).op) ((adj₀.unit.app AM) (s₁ x + s₂ x))
      have h_res_sum : ∀ x : ↥U.left,
          (FM.obj.map (j₁₂ x).op) (ψ_fun U (s₁ + s₂)) = c₁₂ x := by
        intro x
        have hle : O₁₂ x ≤ O_lvl U (s₁ + s₂) x := by
          intro y hy
          change s₁ y + s₂ y = s₁ x + s₂ x
          rw [hy.1, hy.2]
        let u_x : W₁₂ x ⟶ W_lvl U (s₁ + s₂) x :=
          MorphismProperty.Over.homMk (U.left.homOfLE hle)
            ((Category.assoc (U.left.homOfLE hle) (O_lvl U (s₁ + s₂) x).ι U.hom).symm.trans
              (congrArg (· ≫ U.hom) (U.left.homOfLE_ι hle)))
        have hu_j : u_x ≫ j_lvl U (s₁ + s₂) x = j₁₂ x :=
          hEtHomExt _ _ (U.left.homOfLE_ι hle)
        have h_term : u_x ≫ hT₀.from (W_lvl U (s₁ + s₂) x) = hT₀.from (W₁₂ x) :=
          hT₀.hom_ext _ _
        rw [← hu_j, op_comp, FM.obj.map_comp]
        change (FM.obj.map u_x.op)
          ((FM.obj.map (j_lvl U (s₁ + s₂) x).op) (ψ_fun U (s₁ + s₂))) = c₁₂ x
        rw [hψ_spec U (s₁ + s₂) x]
        have hmap_comp : (FM.obj.map u_x.op)
            ((FM.obj.map (hT₀.from (W_lvl U (s₁ + s₂) x)).op)
              ((adj₀.unit.app AM) ((s₁ + s₂) x))) =
            (FM.obj.map (u_x ≫ hT₀.from (W_lvl U (s₁ + s₂) x)).op)
              ((adj₀.unit.app AM) ((s₁ + s₂) x)) := by
          rw [op_comp, FM.obj.map_comp]; rfl
        rw [hmap_comp, h_term]
        rfl
      have h_res_parts : ∀ x : ↥U.left,
          (FM.obj.map (j₁₂ x).op) (ψ_fun U s₁ + ψ_fun U s₂) = c₁₂ x := by
        intro x
        let u₁ : W₁₂ x ⟶ W_lvl U s₁ x :=
          MorphismProperty.Over.homMk (U.left.homOfLE inf_le_left)
            ((Category.assoc (U.left.homOfLE inf_le_left) (O_lvl U s₁ x).ι U.hom).symm.trans
              (congrArg (· ≫ U.hom) (U.left.homOfLE_ι inf_le_left)))
        let u₂ : W₁₂ x ⟶ W_lvl U s₂ x :=
          MorphismProperty.Over.homMk (U.left.homOfLE inf_le_right)
            ((Category.assoc (U.left.homOfLE inf_le_right) (O_lvl U s₂ x).ι U.hom).symm.trans
              (congrArg (· ≫ U.hom) (U.left.homOfLE_ι inf_le_right)))
        have hu₁_j : u₁ ≫ j_lvl U s₁ x = j₁₂ x :=
          hEtHomExt _ _ (U.left.homOfLE_ι inf_le_left)
        have hu₂_j : u₂ ≫ j_lvl U s₂ x = j₁₂ x :=
          hEtHomExt _ _ (U.left.homOfLE_ι inf_le_right)
        rw [map_add]
        have hp₁ : (FM.obj.map (j₁₂ x).op) (ψ_fun U s₁) =
            (FM.obj.map (hT₀.from (W₁₂ x)).op) ((adj₀.unit.app AM) (s₁ x)) := by
          calc (FM.obj.map (j₁₂ x).op) (ψ_fun U s₁)
              = (FM.obj.map u₁.op) ((FM.obj.map (j_lvl U s₁ x).op) (ψ_fun U s₁)) := by
                rw [← hu₁_j, op_comp, FM.obj.map_comp]; rfl
            _ = (FM.obj.map u₁.op)
                  ((FM.obj.map (hT₀.from (W_lvl U s₁ x)).op) ((adj₀.unit.app AM) (s₁ x))) := by
                rw [hψ_spec U s₁ x]
            _ = (FM.obj.map (u₁ ≫ hT₀.from (W_lvl U s₁ x)).op)
                  ((adj₀.unit.app AM) (s₁ x)) := by
                rw [op_comp, FM.obj.map_comp]; rfl
            _ = (FM.obj.map (hT₀.from (W₁₂ x)).op) ((adj₀.unit.app AM) (s₁ x)) := by
                rw [hT₀.hom_ext (u₁ ≫ hT₀.from (W_lvl U s₁ x)) (hT₀.from (W₁₂ x))]
        have hp₂ : (FM.obj.map (j₁₂ x).op) (ψ_fun U s₂) =
            (FM.obj.map (hT₀.from (W₁₂ x)).op) ((adj₀.unit.app AM) (s₂ x)) := by
          calc (FM.obj.map (j₁₂ x).op) (ψ_fun U s₂)
              = (FM.obj.map u₂.op) ((FM.obj.map (j_lvl U s₂ x).op) (ψ_fun U s₂)) := by
                rw [← hu₂_j, op_comp, FM.obj.map_comp]; rfl
            _ = (FM.obj.map u₂.op)
                  ((FM.obj.map (hT₀.from (W_lvl U s₂ x)).op) ((adj₀.unit.app AM) (s₂ x))) := by
                rw [hψ_spec U s₂ x]
            _ = (FM.obj.map (u₂ ≫ hT₀.from (W_lvl U s₂ x)).op)
                  ((adj₀.unit.app AM) (s₂ x)) := by
                rw [op_comp, FM.obj.map_comp]; rfl
            _ = (FM.obj.map (hT₀.from (W₁₂ x)).op) ((adj₀.unit.app AM) (s₂ x)) := by
                rw [hT₀.hom_ext (u₂ ≫ hT₀.from (W_lvl U s₂ x)) (hT₀.from (W₁₂ x))]
        rw [hp₁, hp₂]
        exact ((FM.obj.map (hT₀.from (W₁₂ x)).op).hom.map_add _ _).symm.trans
          (congrArg (FM.obj.map (hT₀.from (W₁₂ x)).op)
            ((adj₀.unit.app AM).hom.map_add (s₁ x) (s₂ x)).symm)
      obtain ⟨_, -, huniq₁₂⟩ := hShForArrows FM W₁₂ j₁₂ hcov₁₂ c₁₂ (by
        intro x₁ x₂ Z₀ g₁ g₂ hcomm
        rw [← h_res_sum x₁, ← h_res_sum x₂]
        calc (FM.obj.map g₁.op) ((FM.obj.map (j₁₂ x₁).op) (ψ_fun U (s₁ + s₂)))
            = (FM.obj.map (g₁ ≫ j₁₂ x₁).op) (ψ_fun U (s₁ + s₂)) := by
              rw [op_comp, FM.obj.map_comp]; rfl
          _ = (FM.obj.map (g₂ ≫ j₁₂ x₂).op) (ψ_fun U (s₁ + s₂)) := by rw [hcomm]
          _ = (FM.obj.map g₂.op) ((FM.obj.map (j₁₂ x₂).op) (ψ_fun U (s₁ + s₂))) := by
              rw [op_comp, FM.obj.map_comp]; rfl)
      exact (huniq₁₂ _ h_res_sum).trans (huniq₁₂ _ h_res_parts).symm
    let ψ_nat : weilAltLocConstPresheaf W n ⟶ FM.obj :=
      { app := fun U => AddCommGrpCat.ofHom
          { toFun := ψ_fun (Opposite.unop U)
            map_zero' := hψ_zero (Opposite.unop U)
            map_add' := hψ_add (Opposite.unop U) }
        naturality := fun {U₁ U₂} f => by
          cases U₁ with | op V₁ =>
          cases U₂ with | op V₂ =>
          apply AddCommGrpCat.ext
          intro s
          let s_L : LocallyConstant ↥V₁.left (ULift.{u} (ZMod n)) := s
          let u : V₂ ⟶ V₁ := f.unop
          let s' : LocallyConstant ↥V₂.left (ULift.{u} (ZMod n)) :=
            ((weilAltLocConstPresheaf W n).map f) s
          symm
          apply hψ_uniq V₂ s' ((FM.obj.map f) (ψ_fun V₁ s_L))
          intro y
          let x : ↥V₁.left := u.left y
          let u_res : (W_lvl V₂ s' y).left ⟶ (W_lvl V₁ s_L x).left :=
            u.left ∣_ (O_lvl V₁ s_L x)
          have hu_res_ι : u_res ≫ (O_lvl V₁ s_L x).ι = (O_lvl V₂ s' y).ι ≫ u.left :=
            AlgebraicGeometry.morphismRestrict_ι u.left (O_lvl V₁ s_L x)
          let u_et : W_lvl V₂ s' y ⟶ W_lvl V₁ s_L x :=
            MorphismProperty.Over.homMk u_res
              ((Category.assoc u_res (O_lvl V₁ s_L x).ι V₁.hom).symm.trans
                ((congrArg (· ≫ V₁.hom) hu_res_ι).trans
                  ((Category.assoc (O_lvl V₂ s' y).ι u.left V₁.hom).trans
                    (congrArg ((O_lvl V₂ s' y).ι ≫ ·) (MorphismProperty.Over.w u)))))
          have hu_comm : j_lvl V₂ s' y ≫ u = u_et ≫ j_lvl V₁ s_L x :=
            hEtHomExt _ _ hu_res_ι.symm
          have hf_eq : f = Opposite.op u := rfl
          rw [hf_eq]
          calc (FM.obj.map (j_lvl V₂ s' y).op) ((FM.obj.map u.op) (ψ_fun V₁ s_L))
              = (FM.obj.map (j_lvl V₂ s' y ≫ u).op) (ψ_fun V₁ s_L) := by
                rw [op_comp, FM.obj.map_comp]; rfl
            _ = (FM.obj.map (u_et ≫ j_lvl V₁ s_L x).op) (ψ_fun V₁ s_L) := by rw [hu_comm]
            _ = (FM.obj.map u_et.op) ((FM.obj.map (j_lvl V₁ s_L x).op) (ψ_fun V₁ s_L)) := by
                rw [op_comp, FM.obj.map_comp]; rfl
            _ = (FM.obj.map u_et.op)
                  ((FM.obj.map (hT₀.from (W_lvl V₁ s_L x)).op) ((adj₀.unit.app AM) (s_L x))) := by
                rw [hψ_spec V₁ s_L x]
            _ = (FM.obj.map (u_et ≫ hT₀.from (W_lvl V₁ s_L x)).op)
                  ((adj₀.unit.app AM) (s_L x)) := by
                rw [op_comp, FM.obj.map_comp]; rfl
            _ = (FM.obj.map (hT₀.from (W_lvl V₂ s' y)).op) ((adj₀.unit.app AM) (s' y)) := by
                rw [hT₀.hom_ext (u_et ≫ hT₀.from (W_lvl V₁ s_L x)) (hT₀.from (W_lvl V₂ s' y))]
                rfl }
    let Φ_inv : L_sh ⟶ FM := ObjectProperty.homMk ψ_nat
    have h_hom_inv : Φ_hom ≫ Φ_inv = 𝟙 FM := by
      apply (adj₀.homEquiv AM FM).injective
      rw [Adjunction.homEquiv_naturality_right]
      have h_id : (adj₀.homEquiv AM FM) (𝟙 FM) = adj₀.unit.app AM :=
        (Adjunction.homEquiv_unit adj₀ AM FM (𝟙 FM)).trans
          ((congrArg (adj₀.unit.app AM ≫ ·) (CategoryTheory.Functor.map_id _ FM)).trans
            (Category.comp_id _))
      have h1 : (adj₀.homEquiv AM L_sh) Φ_hom = weilAltLocConstConstHom W T₀ n :=
        (adj₀.homEquiv AM L_sh).apply_symm_apply _
      rw [h_id, h1]
      apply AddCommGrpCat.ext
      intro a
      let s₀ : LocallyConstant ↥T₀.left (ULift.{u} (ZMod n)) :=
        LocallyConstant.const ↥T₀.left a
      change ψ_fun T₀ s₀ = (adj₀.unit.app AM) a
      symm
      apply hψ_uniq T₀ s₀ ((adj₀.unit.app AM) a)
      intro x
      rw [hT₀.hom_ext (j_lvl T₀ s₀ x) (hT₀.from (W_lvl T₀ s₀ x))]
      rfl
    have h_inv_hom : Φ_inv ≫ Φ_hom = 𝟙 L_sh := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      cases U with | op V =>
      apply AddCommGrpCat.ext
      intro s
      let s_L : LocallyConstant ↥V.left (ULift.{u} (ZMod n)) := s
      change (Φ_hom.hom.app (Opposite.op V)) (ψ_fun V s_L) = s_L
      apply LocallyConstant.ext
      intro x
      let pt : ↥(W_lvl V s_L x).left := ⟨x, rfl⟩
      have hnat₁₀ := congrArg (fun k => k (ψ_fun V s_L))
        (Φ_hom.hom.naturality (j_lvl V s_L x).op)
      have hnat₁ := congrArg
        (fun g : LocallyConstant ↥(W_lvl V s_L x).left (ULift.{u} (ZMod n)) => g pt) hnat₁₀
      have hnat₂₀ := congrArg (fun k => k ((adj₀.unit.app AM) (s_L x)))
        (Φ_hom.hom.naturality (hT₀.from (W_lvl V s_L x)).op)
      have hnat₂ := congrArg
        (fun g : LocallyConstant ↥(W_lvl V s_L x).left (ULift.{u} (ZMod n)) => g pt) hnat₂₀
      have hunit_eval : ((Φ_hom.hom.app (Opposite.op T₀)) ((adj₀.unit.app AM) (s_L x))) =
          LocallyConstant.const ↥T₀.left (s_L x) :=
        congrArg (fun k => k (s_L x)) hΦ_T₀
      have hspec_app := congrArg
        (fun g : LocallyConstant ↥(W_lvl V s_L x).left (ULift.{u} (ZMod n)) => g pt)
        (congrArg (Φ_hom.hom.app (Opposite.op (W_lvl V s_L x))) (hψ_spec V s_L x))
      have hunit_pt := congrArg
        (fun g : LocallyConstant ↥T₀.left (ULift.{u} (ZMod n)) =>
          g ((hT₀.from (W_lvl V s_L x)).left pt)) hunit_eval
      exact hnat₁.symm.trans (hspec_app.trans (hnat₂.trans hunit_pt))
    refine ⟨{ hom := Φ_hom, inv := Φ_inv, hom_inv_id := h_hom_inv, inv_hom_id := h_inv_hom }, ?_⟩
    intro T_W hT_W
    let α : T_W ⟶ T₀ := hT₀.from T_W
    let shAdj := sheafificationAdjunction W.smallEtaleTopology AddCommGrpCat.{u}
    let P_AM := (Functor.const (Opposite W.Etale)).obj AM
    have hadj_W : (constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT_W).unit.app AM =
        (shAdj.unit.app P_AM).app (Opposite.op T_W) :=
      Category.id_comp _
    have hadj_0 : adj₀.unit.app AM = (shAdj.unit.app P_AM).app (Opposite.op T₀) :=
      Category.id_comp _
    have h_sh_nat : (shAdj.unit.app P_AM).app (Opposite.op T_W) =
        (shAdj.unit.app P_AM).app (Opposite.op T₀) ≫ FM.obj.map α.op :=
      (Category.id_comp _).symm.trans ((shAdj.unit.app P_AM).naturality α.op)
    have h_step1 : (constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT_W).unit.app AM =
        adj₀.unit.app AM ≫ FM.obj.map α.op :=
      hadj_W.trans (h_sh_nat.trans (congrArg (· ≫ FM.obj.map α.op) hadj_0.symm))
    calc (constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT_W).unit.app AM ≫
          Φ_hom.hom.app (Opposite.op T_W)
        = (adj₀.unit.app AM ≫ FM.obj.map α.op) ≫ Φ_hom.hom.app (Opposite.op T_W) :=
          congrArg (· ≫ Φ_hom.hom.app (Opposite.op T_W)) h_step1
      _ = adj₀.unit.app AM ≫ (FM.obj.map α.op ≫ Φ_hom.hom.app (Opposite.op T_W)) :=
          Category.assoc _ _ _
      _ = adj₀.unit.app AM ≫
          (Φ_hom.hom.app (Opposite.op T₀) ≫ (weilAltLocConstPresheaf W n).map α.op) := by
          rw [Φ_hom.hom.naturality α.op]
      _ = (adj₀.unit.app AM ≫ Φ_hom.hom.app (Opposite.op T₀)) ≫
          (weilAltLocConstPresheaf W n).map α.op :=
          (Category.assoc _ _ _).symm
      _ = weilAltLocConstConstHom W T₀ n ≫ (weilAltLocConstPresheaf W n).map α.op := by
          rw [hΦ_T₀]
      _ = weilAltLocConstConstHom W T_W n :=
          AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl))

  have hModel : ∀ (S₀ : Scheme.{u}) (V₀ : S₀.Opens)
      (K₀ : Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u})
      (ι₀ : K₀ ⟶ weilEtaleTorsionSheaf S₀ n),
      WeilAltIsZeroBdryExact S₀ V₀ n K₀ ι₀ →
      ∃ (Φ : weilEtaleTorsionSheaf S₀ n ≅ ⟨weilAltLocConstPresheaf S₀ n, hShL_gen S₀⟩)
        (Ψ : K₀ ≅ ⟨weilAltZeroBdrySubpresheaf S₀ V₀ n, hSh0_gen S₀ V₀⟩),
        (∀ (T_S : S₀.Etale) (hT_S : Limits.IsTerminal T_S),
          (constantSheafAdj S₀.smallEtaleTopology AddCommGrpCat.{u} hT_S).unit.app AM ≫
            Φ.hom.hom.app (Opposite.op T_S) =
            weilAltLocConstConstHom S₀ T_S n) ∧
        Ψ.hom ≫ ObjectProperty.homMk (weilAltZeroBdrySubpresheafι S₀ V₀ n) = ι₀ ≫ Φ.hom := by
    intro S₀ V₀ K₀ ι₀ hEx
    let I_Z : S₀.IdealSheafData := weilAltClosedComplIdeal S₀ V₀
    let Z₀ : Scheme.{u} := I_Z.subscheme
    let i_Z : Z₀ ⟶ S₀ := I_Z.subschemeι
    let B_Z := weilEtaleSitePullback i_Z
    rcases hEx with ⟨hCont_Z, T'_S, hT'_S, T'_Z, hT'_Z, h0, hSC⟩
    have : B_Z.IsContinuous S₀.smallEtaleTopology Z₀.smallEtaleTopology := hCont_Z
    let P_push_Z := B_Z.sheafPushforwardContinuous
      AddCommGrpCat.{u} S₀.smallEtaleTopology Z₀.smallEtaleTopology
    let adj'_S := constantSheafAdj S₀.smallEtaleTopology AddCommGrpCat.{u} hT'_S
    let adj'_Z := constantSheafAdj Z₀.smallEtaleTopology AddCommGrpCat.{u} hT'_Z
    let τ_Z : B_Z.obj T'_S ⟶ T'_Z := hT'_Z.from (B_Z.obj T'_S)
    let ρ_Z : weilEtaleTorsionSheaf S₀ n ⟶ P_push_Z.obj (weilEtaleTorsionSheaf Z₀ n) :=
      (adj'_S.homEquiv AM (P_push_Z.obj (weilEtaleTorsionSheaf Z₀ n))).symm
        (adj'_Z.unit.app AM ≫ (weilEtaleTorsionSheaf Z₀ n).obj.map (Opposite.op τ_Z))
    obtain ⟨Φ_S, hΦ_S⟩ := hPhi_gen S₀
    obtain ⟨Φ_Z, hΦ_Z⟩ := hPhi_gen Z₀
    let L_S_sh : Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltLocConstPresheaf S₀ n, hShL_gen S₀⟩
    let L0_S_sh : Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltZeroBdrySubpresheaf S₀ V₀ n, hSh0_gen S₀ V₀⟩
    let L_Z_sh : Sheaf Z₀.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltLocConstPresheaf Z₀ n, hShL_gen Z₀⟩
    let ι0_sh : L0_S_sh ⟶ L_S_sh :=
      ObjectProperty.homMk (weilAltZeroBdrySubpresheafι S₀ V₀ n)
    let ρ_loc : L_S_sh ⟶ P_push_Z.obj L_Z_sh :=
      ObjectProperty.homMk (weilAltLocConstPullbackNat i_Z n)
    have hρ_comm : ρ_Z ≫ P_push_Z.map Φ_Z.hom = Φ_S.hom ≫ ρ_loc := by
      apply (adj'_S.homEquiv AM (P_push_Z.obj L_Z_sh)).injective
      rw [Adjunction.homEquiv_naturality_right,
        (adj'_S.homEquiv AM _).apply_symm_apply,
        Adjunction.homEquiv_unit]
      change (adj'_Z.unit.app AM ≫ (weilEtaleTorsionSheaf Z₀ n).obj.map τ_Z.op) ≫
          Φ_Z.hom.hom.app (Opposite.op (B_Z.obj T'_S)) =
        adj'_S.unit.app AM ≫
          (Φ_S.hom.hom.app (Opposite.op T'_S) ≫
            (weilAltLocConstPullbackNat i_Z n).app (Opposite.op T'_S))
      rw [Category.assoc, Φ_Z.hom.hom.naturality τ_Z.op, ← Category.assoc,
        hΦ_Z T'_Z hT'_Z, ← Category.assoc, hΦ_S T'_S hT'_S]
      exact AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl))
    have hRange_iZ : Set.range i_Z.base = (V₀ : Set ↥S₀)ᶜ :=
      (Scheme.IdealSheafData.range_subschemeι I_Z).trans
        (Scheme.IdealSheafData.coe_support_vanishingIdeal
          ⟨(V₀ : Set ↥S₀)ᶜ, V₀.isOpen.isClosed_compl⟩)
    have h0_loc : ι0_sh ≫ ρ_loc = 0 := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      cases U with | op V_et =>
      apply AddCommGrpCat.ext
      intro s
      let s_sub : ↥(weilAltZeroBdrySubgroup S₀ V₀ n V_et) := s
      change ((weilAltLocConstPullbackNat i_Z n).app (Opposite.op V_et)) s_sub.1 = 0
      apply LocallyConstant.ext
      intro p
      let pr₁ := Limits.pullback.fst V_et.hom i_Z
      let pr₂ := Limits.pullback.snd V_et.hom i_Z
      have hx_not_V : V_et.hom (pr₁ p) ∉ (V₀ : Set ↥S₀) := by
        have hmem : V_et.hom (pr₁ p) ∈ Set.range i_Z.base := by
          refine ⟨pr₂ p, ?_⟩
          have hw := congrArg (fun k : Limits.pullback V_et.hom i_Z ⟶ S₀ => k p)
            (Limits.pullback.condition (f := V_et.hom) (g := i_Z))
          exact hw.symm
        rwa [hRange_iZ] at hmem
      exact s_sub.2 (pr₁ p) hx_not_V
    have hMono_ι0 : Mono ι0_sh :=
      ⟨fun {W_sh} g₁ g₂ hg => by
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.ext
        intro w
        apply Subtype.ext
        exact congrArg (fun k : W_sh ⟶ L_S_sh => (k.hom.app U) w) hg⟩
    have hLim_loc : Limits.IsLimit (Limits.KernelFork.ofι ι0_sh h0_loc) :=
      Limits.KernelFork.IsLimit.ofι ι0_sh h0_loc
        (fun {W_sh} k hk =>
          ObjectProperty.homMk
            { app := fun U =>
                let V_et := Opposite.unop U
                AddCommGrpCat.ofHom
                  { toFun := fun w =>
                      let kw : LocallyConstant ↥V_et.left (ULift.{u} (ZMod n)) :=
                        (k.hom.app U) w
                      ⟨kw, by
                        intro x hx
                        have hx_compl : V_et.hom x ∈ (V₀ : Set ↥S₀)ᶜ := hx
                        rw [← hRange_iZ] at hx_compl
                        obtain ⟨z, hz⟩ := hx_compl
                        obtain ⟨p, hp₁, -⟩ :=
                          Scheme.Pullback.exists_preimage_pullback x z hz.symm
                        have hk0 : ((weilAltLocConstPullbackNat i_Z n).app U) kw = 0 :=
                          congrArg (fun (m : W_sh ⟶ P_push_Z.obj L_Z_sh) => (m.hom.app U) w) hk
                        have hk_eval := congrArg (fun g : LocallyConstant _ _ => g p) hk0
                        change kw ((Limits.pullback.fst V_et.hom i_Z) p) = 0 at hk_eval
                        exact (congrArg kw hp₁.symm).trans hk_eval⟩
                    map_zero' := Subtype.ext (map_zero (k.hom.app U).hom)
                    map_add' := fun a b => Subtype.ext (map_add (k.hom.app U).hom a b) }
              naturality := fun {U₁ U₂} f => by
                apply AddCommGrpCat.ext
                intro w
                apply Subtype.ext
                exact congrArg (fun m => m w) (k.hom.naturality f) })
        (fun {_} _ _ => Sheaf.hom_ext (NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl)))
        (fun {_} _ _ _ hm => (cancel_mono ι0_sh).mp hm)
    have hLim_K : Limits.IsLimit (Limits.KernelFork.ofι ι₀ h0) := hSC.fIsKernel
    have hMono_ι : Mono ι₀ := hSC.mono_f
    have hk₁ : (ι₀ ≫ Φ_S.hom) ≫ ρ_loc = 0 := by
      rw [Category.assoc, ← hρ_comm, ← Category.assoc, h0, Limits.zero_comp]
    obtain ⟨Ψ_hom, hΨ_hom⟩ := Limits.KernelFork.IsLimit.lift' hLim_loc (ι₀ ≫ Φ_S.hom) hk₁
    have hk₂ : (ι0_sh ≫ Φ_S.inv) ≫ ρ_Z = 0 := by
      apply (cancel_mono (P_push_Z.map Φ_Z.hom)).mp
      rw [Limits.zero_comp, Category.assoc, hρ_comm, ← Category.assoc,
        Category.assoc ι0_sh, Φ_S.inv_hom_id, Category.comp_id, h0_loc]
    obtain ⟨Ψ_inv, hΨ_inv⟩ := Limits.KernelFork.IsLimit.lift' hLim_K (ι0_sh ≫ Φ_S.inv) hk₂
    have hΨ_hom_eq : Ψ_hom ≫ ι0_sh = ι₀ ≫ Φ_S.hom := hΨ_hom
    have hΨ_inv_eq : Ψ_inv ≫ ι₀ = ι0_sh ≫ Φ_S.inv := hΨ_inv
    have hΨ_1 : Ψ_hom ≫ Ψ_inv = 𝟙 K₀ := by
      apply (cancel_mono ι₀).mp
      rw [Category.id_comp, Category.assoc, hΨ_inv_eq, ← Category.assoc,
        hΨ_hom_eq, Category.assoc, Φ_S.hom_inv_id, Category.comp_id]
    have hΨ_2 : Ψ_inv ≫ Ψ_hom = 𝟙 L0_S_sh := by
      apply (cancel_mono ι0_sh).mp
      rw [Category.id_comp, Category.assoc, hΨ_hom_eq, ← Category.assoc,
        hΨ_inv_eq, Category.assoc, Φ_S.inv_hom_id, Category.comp_id]
    exact ⟨Φ_S,
      { hom := Ψ_hom, inv := Ψ_inv, hom_inv_id := hΨ_1, inv_hom_id := hΨ_2 },
      hΦ_S, hΨ_hom_eq⟩

  
  
  
  have hBaseChange : ∀ (X₀ Z₀ Y U : Scheme.{u})
      (ιZ : Z₀ ⟶ Y) (ν₀ : X₀ ⟶ Z₀) (V : Y.Opens) (u : U ⟶ Y),
      IsClosedImmersion ιZ →
      IsFinite ν₀ →
      Surjective (ιZ ∣_ V) →
      IsIso (ν₀ ∣_ ((TopologicalSpace.Opens.map ιZ.base).obj V)) →
      IsClosedMap (Limits.pullback.fst u (ν₀ ≫ ιZ)).base ∧
      ∀ x : ↥U, u.base x ∈ (V : Set ↥Y) →
        ∃! p : ↥(Limits.pullback u (ν₀ ≫ ιZ)),
          (Limits.pullback.fst u (ν₀ ≫ ιZ)).base p = x := by
    intro X₀ Z₀ Y U ιZ ν₀ V u hCl hFin hSurj hIso
    have : IsClosedImmersion ιZ := hCl
    have : IsFinite ν₀ := hFin
    let g₀ : X₀ ⟶ Y := ν₀ ≫ ιZ
    let P := Limits.pullback u g₀
    let pr₁ : P ⟶ U := Limits.pullback.fst u g₀
    let pr₂ : P ⟶ X₀ := Limits.pullback.snd u g₀
    have : IsFinite g₀ := inferInstance
    have : UniversallyClosed pr₁ :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (IsPullback.of_hasPullback u g₀).flip inferInstance
    refine ⟨pr₁.isClosedMap, ?_⟩
    let Z_V : Z₀.Opens := (TopologicalSpace.Opens.map ιZ.base).obj V
    let W_V : X₀.Opens := (TopologicalSpace.Opens.map ν₀.base).obj Z_V
    let f_V : W_V.toScheme ⟶ V.toScheme := (ν₀ ∣_ Z_V) ≫ (ιZ ∣_ V)
    have : IsIso (ν₀ ∣_ Z_V) := hIso
    have : Surjective (ιZ ∣_ V) := hSurj
    have : IsClosedImmersion (ν₀ ∣_ Z_V) := inferInstance
    have : Surjective (ν₀ ∣_ Z_V) := inferInstance
    have : IsClosedImmersion (ιZ ∣_ V) :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (AlgebraicGeometry.isPullback_morphismRestrict ιZ V).flip hCl
    have : IsClosedImmersion f_V := inferInstance
    have : Surjective f_V := inferInstance
    have hpb_fV : IsPullback f_V W_V.ι V.ι g₀ :=
      (AlgebraicGeometry.isPullback_morphismRestrict ν₀ Z_V).paste_horiz
        (AlgebraicGeometry.isPullback_morphismRestrict ιZ V)
    let O : U.Opens := (TopologicalSpace.Opens.map u.base).obj V
    let Q : P.Opens := (TopologicalSpace.Opens.map pr₁.base).obj O
    have hpb_vert : IsPullback (pr₁ ∣_ O) (Q.ι ≫ pr₂) (O.ι ≫ u) g₀ :=
      (AlgebraicGeometry.isPullback_morphismRestrict pr₁ O).paste_vert
        (IsPullback.of_hasPullback u g₀)
    have hu_res : O.ι ≫ u = (u ∣_ V) ≫ V.ι :=
      (AlgebraicGeometry.morphismRestrict_ι u V).symm
    have hpb_outer : IsPullback (pr₁ ∣_ O) (Q.ι ≫ pr₂) ((u ∣_ V) ≫ V.ι) g₀ := by
      rwa [← hu_res]
    have hw_lift : ((pr₁ ∣_ O) ≫ (u ∣_ V)) ≫ V.ι = (Q.ι ≫ pr₂) ≫ g₀ := by
      rw [Category.assoc]
      exact hpb_outer.w
    let q_W : Q.toScheme ⟶ W_V.toScheme :=
      hpb_fV.lift ((pr₁ ∣_ O) ≫ (u ∣_ V)) (Q.ι ≫ pr₂) hw_lift
    have hq_fst : q_W ≫ f_V = (pr₁ ∣_ O) ≫ (u ∣_ V) :=
      hpb_fV.lift_fst _ _ hw_lift
    have hq_snd : q_W ≫ W_V.ι = Q.ι ≫ pr₂ :=
      hpb_fV.lift_snd _ _ hw_lift
    have hpb_top : IsPullback (pr₁ ∣_ O) q_W (u ∣_ V) f_V := by
      refine IsPullback.of_bot ?_ hq_fst.symm hpb_fV
      rwa [hq_snd]
    have : IsClosedImmersion (pr₁ ∣_ O) :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_top.flip inferInstance
    have : Surjective (pr₁ ∣_ O) :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_top.flip inferInstance
    have hInj_O : Function.Injective (pr₁ ∣_ O).base :=
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding (pr₁ ∣_ O)).injective
    have hSurj_O : Function.Surjective (pr₁ ∣_ O).base :=
      AlgebraicGeometry.Scheme.Hom.surjective (pr₁ ∣_ O)
    have h_res_pt : ∀ q : ↥Q, ((pr₁ ∣_ O).base q).1 = pr₁.base q.1 := by
      intro q
      exact congrArg (fun k : Q.toScheme ⟶ U => k.base q)
        (AlgebraicGeometry.morphismRestrict_ι pr₁ O)
    intro x hx
    obtain ⟨q₀, hq₀⟩ := hSurj_O ⟨x, hx⟩
    refine ⟨q₀.1, (h_res_pt q₀).symm.trans (congrArg Subtype.val hq₀), ?_⟩
    intro p hp
    have hp_Q : p ∈ Q := by
      change u.base (pr₁.base p) ∈ (V : Set ↥Y)
      rwa [hp]
    have hq_eq : ⟨p, hp_Q⟩ = q₀ := by
      apply hInj_O
      apply Subtype.ext
      rw [h_res_pt ⟨p, hp_Q⟩, hq₀]
      exact hp
    exact congrArg Subtype.val hq_eq

  
  
  
  have hSingleRetract : ∀ (X₀ Y : Scheme.{u}) (g₀ : X₀ ⟶ Y) (V V_big : Y.Opens),
      V ≤ V_big →
      Set.range g₀.base ∩ (V_big : Set ↥Y) ⊆ (V : Set ↥Y) →
      (∀ U : Y.Etale,
        IsClosedMap
          (Limits.pullback.fst ((Scheme.Etale.forget Y).obj U).hom g₀).base) →
      (∀ (U : Y.Etale) (x : ↥((Scheme.Etale.forget Y).obj U).left),
        ((Scheme.Etale.forget Y).obj U).hom.base x ∈ (V : Set ↥Y) →
        ∃! p : ↥(Limits.pullback ((Scheme.Etale.forget Y).obj U).hom g₀),
          (Limits.pullback.fst ((Scheme.Etale.forget Y).obj U).hom g₀).base p = x) →
      let W₀ : X₀.Opens := (TopologicalSpace.Opens.map g₀.base).obj V
      let B₀ := weilEtaleSitePullback g₀
      ∃ (ψ₀ : weilAltZeroBdrySubpresheaf Y V_big n ⟶
            B₀.op ⋙ weilAltZeroBdrySubpresheaf X₀ W₀ n)
        (θ₀ : B₀.op ⋙ weilAltZeroBdrySubpresheaf X₀ W₀ n ⟶
            weilAltZeroBdrySubpresheaf Y V_big n),
        ψ₀ ≫ Functor.whiskerLeft B₀.op (weilAltZeroBdrySubpresheafι X₀ W₀ n) =
          weilAltZeroBdrySubpresheafι Y V_big n ≫ weilAltLocConstPullbackNat g₀ n ∧
        θ₀ ≫ ψ₀ = 𝟙 (B₀.op ⋙ weilAltZeroBdrySubpresheaf X₀ W₀ n) ∧
        (∀ (U : Y.Etale)
            (t : ↥(weilAltZeroBdrySubgroup X₀ W₀ n (B₀.obj U)))
            (x : ↥((Scheme.Etale.forget Y).obj U).left),
          ((Scheme.Etale.forget Y).obj U).hom.base x ∉ (V : Set ↥Y) →
          ((θ₀.app (Opposite.op U)) t).1 x = 0) ∧
        (∀ (U : Y.Etale)
            (s : ↥(weilAltZeroBdrySubgroup Y V_big n U))
            (x : ↥((Scheme.Etale.forget Y).obj U).left),
          ((Scheme.Etale.forget Y).obj U).hom.base x ∈ (V : Set ↥Y) →
          (((ψ₀ ≫ θ₀).app (Opposite.op U)) s).1 x = s.1 x) := by
    intro X₀ Y g₀ V V_big hV_le hRange hClosed hUniquePre
    let FgtY := Scheme.Etale.forget Y
    let FgtX := Scheme.Etale.forget X₀
    let W₀ : X₀.Opens := (TopologicalSpace.Opens.map g₀.base).obj V
    let B₀ := weilEtaleSitePullback g₀
    let ψ₀ : weilAltZeroBdrySubpresheaf Y V_big n ⟶
        B₀.op ⋙ weilAltZeroBdrySubpresheaf X₀ W₀ n :=
      { app := fun U =>
          let V_et := Opposite.unop U
          let pr₁ : (FgtX.obj (B₀.obj V_et)).left ⟶ (FgtY.obj V_et).left :=
            Limits.pullback.fst (FgtY.obj V_et).hom g₀
          let pr₂ : (FgtX.obj (B₀.obj V_et)).left ⟶ X₀ :=
            Limits.pullback.snd (FgtY.obj V_et).hom g₀
          AddCommGrpCat.ofHom
            { toFun := fun s =>
                ⟨{ toFun := fun p => s.1 (pr₁ p)
                   isLocallyConstant := fun t =>
                     pr₁.continuous.isOpen_preimage _ (s.1.isLocallyConstant t) },
                 by
                   intro p hp_not_W
                   have hcond : (FgtY.obj V_et).hom (pr₁ p) = g₀ (pr₂ p) :=
                     congrArg (fun k : Limits.pullback (FgtY.obj V_et).hom g₀ ⟶ Y => k p)
                       (Limits.pullback.condition (f := (FgtY.obj V_et).hom) (g := g₀))
                   have hy_range : (FgtY.obj V_et).hom (pr₁ p) ∈ Set.range g₀.base :=
                     ⟨pr₂ p, hcond.symm⟩
                   have hy_not_Vbig : (FgtY.obj V_et).hom (pr₁ p) ∉ (V_big : Set ↥Y) := by
                     intro hy_big
                     have hy_V : (FgtY.obj V_et).hom (pr₁ p) ∈ (V : Set ↥Y) :=
                       hRange ⟨hy_range, hy_big⟩
                     rw [hcond] at hy_V
                     exact hp_not_W hy_V
                   exact s.2 (pr₁ p) hy_not_Vbig⟩
              map_zero' := Subtype.ext (LocallyConstant.ext (fun _ => rfl))
              map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext (fun _ => rfl)) }
        naturality := fun {U₁ U₂} u =>
          AddCommGrpCat.ext (fun s => Subtype.ext (LocallyConstant.ext (fun p =>
            congrArg s.1
              ((Scheme.Hom.comp_apply
                (FgtX.map (B₀.map u.unop)).left
                (Limits.pullback.fst (FgtY.obj (Opposite.unop U₁)).hom g₀) p).symm.trans
              ((congrArg (fun k : (FgtX.obj (B₀.obj (Opposite.unop U₂))).left ⟶
                  (FgtY.obj (Opposite.unop U₁)).left => k p)
                (Limits.pullback.lift_fst _ _ _)).trans
              (Scheme.Hom.comp_apply
                (Limits.pullback.fst (FgtY.obj (Opposite.unop U₂)).hom g₀)
                (FgtY.map u.unop).left p))).symm))) }
    let θ_raw : ∀ (U : Y.Etale),
        ↥(weilAltZeroBdrySubgroup X₀ W₀ n (B₀.obj U)) →
        ↥(FgtY.obj U).left → ULift.{u} (ZMod n) :=
      fun U t x =>
        if hx : (FgtY.obj U).hom.base x ∈ (V : Set ↥Y) then
          t.1 (Classical.choose (hUniquePre U x hx))
        else 0
    have hθ_pos : ∀ (U : Y.Etale)
        (t : ↥(weilAltZeroBdrySubgroup X₀ W₀ n (B₀.obj U)))
        (x : ↥(FgtY.obj U).left)
        (hx : (FgtY.obj U).hom.base x ∈ (V : Set ↥Y)),
        θ_raw U t x = t.1 (Classical.choose (hUniquePre U x hx)) :=
      fun U t x hx => dite_cond_eq_true (eq_true hx)
    have hθ_neg : ∀ (U : Y.Etale)
        (t : ↥(weilAltZeroBdrySubgroup X₀ W₀ n (B₀.obj U)))
        (x : ↥(FgtY.obj U).left)
        (hx : (FgtY.obj U).hom.base x ∉ (V : Set ↥Y)),
        θ_raw U t x = 0 :=
      fun U t x hx => dite_cond_eq_false (eq_false hx)
    have hθ_eval : ∀ (U : Y.Etale)
        (t : ↥(weilAltZeroBdrySubgroup X₀ W₀ n (B₀.obj U)))
        (x : ↥(FgtY.obj U).left)
        (hx : (FgtY.obj U).hom.base x ∈ (V : Set ↥Y))
        (p : ↥(Limits.pullback (FgtY.obj U).hom g₀)),
        (Limits.pullback.fst (FgtY.obj U).hom g₀).base p = x →
        θ_raw U t x = t.1 p := by
      intro U t x hx p hp
      have hp_eq : p = Classical.choose (hUniquePre U x hx) :=
        (Classical.choose_spec (hUniquePre U x hx)).2 p hp
      exact (hθ_pos U t x hx).trans (congrArg t.1 hp_eq.symm)
    have hθ_lc : ∀ (U : Y.Etale)
        (t : ↥(weilAltZeroBdrySubgroup X₀ W₀ n (B₀.obj U))),
        IsLocallyConstant (θ_raw U t) := by
      intro U t S_set
      let pr₁ := Limits.pullback.fst (FgtY.obj U).hom g₀
      let pr₂ := Limits.pullback.snd (FgtY.obj U).hom g₀
      let E_compl : Set ↥(Limits.pullback (FgtY.obj U).hom g₀) := (t.1 ⁻¹' S_set)ᶜ
      have hE_cl : IsClosed E_compl := (t.1.isLocallyConstant S_set).isClosed_compl
      let F_img : Set ↥(FgtY.obj U).left := pr₁.base '' E_compl
      have hF_cl : IsClosed F_img := hClosed U E_compl hE_cl
      let O_set : Set ↥(FgtY.obj U).left := (FgtY.obj U).hom.base ⁻¹' (V : Set ↥Y)
      have hO_open : IsOpen O_set := (FgtY.obj U).hom.continuous.isOpen_preimage _ V.isOpen
      by_cases h0S : (0 : ULift.{u} (ZMod n)) ∈ S_set
      · have h_eq : θ_raw U t ⁻¹' S_set = F_imgᶜ := by
          ext x
          constructor
          · intro hxS hxF
            rcases hxF with ⟨p, hp_not_S, hp_eq⟩
            have htp_ne : t.1 p ≠ 0 := by
              intro h0
              apply hp_not_S
              change t.1 p ∈ S_set
              rw [h0]
              exact h0S
            have hx_V : (FgtY.obj U).hom.base x ∈ (V : Set ↥Y) := by
              by_contra hx_not_V
              apply htp_ne
              apply t.2 p
              intro hp_W
              apply hx_not_V
              have hcond : (FgtY.obj U).hom.base (pr₁.base p) = g₀.base (pr₂.base p) :=
                congrArg (fun k : Limits.pullback (FgtY.obj U).hom g₀ ⟶ Y => k.base p)
                  (Limits.pullback.condition (f := (FgtY.obj U).hom) (g := g₀))
              rw [← hp_eq, hcond]
              exact hp_W
            have hev := hθ_eval U t x hx_V p hp_eq
            apply hp_not_S
            change t.1 p ∈ S_set
            rw [← hev]
            exact hxS
          · intro hx_not_F
            by_cases hx_V : (FgtY.obj U).hom.base x ∈ (V : Set ↥Y)
            · let p := Classical.choose (hUniquePre U x hx_V)
              have hp_eq : pr₁.base p = x := (Classical.choose_spec (hUniquePre U x hx_V)).1
              have hev : θ_raw U t x = t.1 p := hθ_pos U t x hx_V
              change θ_raw U t x ∈ S_set
              rw [hev]
              by_contra hp_not_S
              exact hx_not_F ⟨p, hp_not_S, hp_eq⟩
            · change θ_raw U t x ∈ S_set
              rw [hθ_neg U t x hx_V]
              exact h0S
        rw [h_eq]
        exact hF_cl.isOpen_compl
      · have h_eq : θ_raw U t ⁻¹' S_set = O_set ∩ F_imgᶜ := by
          ext x
          constructor
          · intro hxS
            have hx_V : (FgtY.obj U).hom.base x ∈ (V : Set ↥Y) := by
              by_contra hx_not_V
              have h0_eq : θ_raw U t x = 0 := hθ_neg U t x hx_not_V
              change θ_raw U t x ∈ S_set at hxS
              rw [h0_eq] at hxS
              exact h0S hxS
            refine ⟨hx_V, ?_⟩
            rintro ⟨p, hp_not_S, hp_eq⟩
            have hev := hθ_eval U t x hx_V p hp_eq
            apply hp_not_S
            change t.1 p ∈ S_set
            rw [← hev]
            exact hxS
          · rintro ⟨hx_V, hx_not_F⟩
            have hx_V' : (FgtY.obj U).hom.base x ∈ (V : Set ↥Y) := hx_V
            let p := Classical.choose (hUniquePre U x hx_V')
            have hp_eq : pr₁.base p = x := (Classical.choose_spec (hUniquePre U x hx_V')).1
            have hev : θ_raw U t x = t.1 p := hθ_pos U t x hx_V'
            change θ_raw U t x ∈ S_set
            rw [hev]
            by_contra hp_not_S
            exact hx_not_F ⟨p, hp_not_S, hp_eq⟩
        rw [h_eq]
        exact hO_open.inter hF_cl.isOpen_compl
    let θ₀ : B₀.op ⋙ weilAltZeroBdrySubpresheaf X₀ W₀ n ⟶
        weilAltZeroBdrySubpresheaf Y V_big n :=
      { app := fun U =>
          let V_et := Opposite.unop U
          AddCommGrpCat.ofHom
            { toFun := fun t =>
                ⟨⟨θ_raw V_et t, hθ_lc V_et t⟩, by
                  intro x hx_not_big
                  have hx_not_V : (FgtY.obj V_et).hom.base x ∉ (V : Set ↥Y) :=
                    fun hx_V => hx_not_big (hV_le hx_V)
                  exact hθ_neg V_et t x hx_not_V⟩
              map_zero' := by
                apply Subtype.ext
                apply LocallyConstant.ext
                intro x
                change θ_raw V_et 0 x = 0
                by_cases hx : (FgtY.obj V_et).hom.base x ∈ (V : Set ↥Y)
                · exact hθ_pos V_et 0 x hx
                · exact hθ_neg V_et 0 x hx
              map_add' := fun t₁ t₂ => by
                apply Subtype.ext
                apply LocallyConstant.ext
                intro x
                change θ_raw V_et (t₁ + t₂) x = θ_raw V_et t₁ x + θ_raw V_et t₂ x
                by_cases hx : (FgtY.obj V_et).hom.base x ∈ (V : Set ↥Y)
                · exact (hθ_pos V_et (t₁ + t₂) x hx).trans
                    (congrArg₂ (· + ·) (hθ_pos V_et t₁ x hx).symm
                      (hθ_pos V_et t₂ x hx).symm)
                · exact (hθ_neg V_et (t₁ + t₂) x hx).trans
                    ((add_zero (0 : ULift.{u} (ZMod n))).symm.trans
                      (congrArg₂ (· + ·) (hθ_neg V_et t₁ x hx).symm
                        (hθ_neg V_et t₂ x hx).symm)) }
        naturality := fun {U₁ U₂} f => by
          apply AddCommGrpCat.ext
          intro t
          apply Subtype.ext
          apply LocallyConstant.ext
          intro x₂
          let V₁ := Opposite.unop U₁
          let V₂ := Opposite.unop U₂
          let h : V₂ ⟶ V₁ := f.unop
          let x₁ : ↥(FgtY.obj V₁).left := (FgtY.map h).left x₂
          have hx_iff : (FgtY.obj V₁).hom.base x₁ ∈ (V : Set ↥Y) ↔
              (FgtY.obj V₂).hom.base x₂ ∈ (V : Set ↥Y) := by
            have hw : (FgtY.obj V₁).hom.base x₁ = (FgtY.obj V₂).hom.base x₂ :=
              (Scheme.Hom.comp_apply (FgtY.map h).left (FgtY.obj V₁).hom x₂).symm.trans
                (congrArg (fun k : (FgtY.obj V₂).left ⟶ Y => k.base x₂) (FgtY.map h).w)
            rw [hw]
          change θ_raw V₂ (((B₀.op ⋙ weilAltZeroBdrySubpresheaf X₀ W₀ n).map f) t) x₂ =
            θ_raw V₁ t x₁
          by_cases hx₂ : (FgtY.obj V₂).hom.base x₂ ∈ (V : Set ↥Y)
          · have hx₁ : (FgtY.obj V₁).hom.base x₁ ∈ (V : Set ↥Y) := hx_iff.mpr hx₂
            let p₂ := Classical.choose (hUniquePre V₂ x₂ hx₂)
            have hp₂_eq : (Limits.pullback.fst (FgtY.obj V₂).hom g₀).base p₂ = x₂ :=
              (Classical.choose_spec (hUniquePre V₂ x₂ hx₂)).1
            let q₁ : ↥(Limits.pullback (FgtY.obj V₁).hom g₀) :=
              (FgtX.map (B₀.map h)).left p₂
            have hq₁_eq : (Limits.pullback.fst (FgtY.obj V₁).hom g₀).base q₁ = x₁ := by
              calc (Limits.pullback.fst (FgtY.obj V₁).hom g₀).base q₁
                  = ((FgtX.map (B₀.map h)).left ≫
                      Limits.pullback.fst (FgtY.obj V₁).hom g₀).base p₂ :=
                    (Scheme.Hom.comp_apply _ _ p₂).symm
                _ = (Limits.pullback.fst (FgtY.obj V₂).hom g₀ ≫
                      (FgtY.map h).left).base p₂ :=
                    congrArg (fun k : Limits.pullback (FgtY.obj V₂).hom g₀ ⟶
                        (FgtY.obj V₁).left => k.base p₂)
                      (Limits.pullback.lift_fst _ _ _)
                _ = (FgtY.map h).left.base
                      ((Limits.pullback.fst (FgtY.obj V₂).hom g₀).base p₂) :=
                    Scheme.Hom.comp_apply _ _ p₂
                _ = x₁ := congrArg (FgtY.map h).left.base hp₂_eq
            exact (hθ_pos V₂ _ x₂ hx₂).trans (hθ_eval V₁ t x₁ hx₁ q₁ hq₁_eq).symm
          · have hx₁ : (FgtY.obj V₁).hom.base x₁ ∉ (V : Set ↥Y) :=
              fun h₁ => hx₂ (hx_iff.mp h₁)
            exact (hθ_neg V₂ _ x₂ hx₂).trans (hθ_neg V₁ t x₁ hx₁).symm }
    refine ⟨ψ₀, θ₀, ?_, ?_, ?_, ?_⟩
    · exact NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl)
    · apply NatTrans.ext
      funext U
      cases U with | op V_et =>
      apply AddCommGrpCat.ext
      intro t
      let t_sub : ↥(weilAltZeroBdrySubgroup X₀ W₀ n (B₀.obj V_et)) := t
      apply Subtype.ext
      apply LocallyConstant.ext
      intro p
      let pr₁ := Limits.pullback.fst (FgtY.obj V_et).hom g₀
      let pr₂ := Limits.pullback.snd (FgtY.obj V_et).hom g₀
      let x := pr₁.base p
      change θ_raw V_et t_sub x = t_sub.1 p
      by_cases hx : (FgtY.obj V_et).hom.base x ∈ (V : Set ↥Y)
      · exact hθ_eval V_et t_sub x hx p rfl
      · refine (hθ_neg V_et t_sub x hx).trans ?_
        symm
        apply t_sub.2 p
        intro hp_W
        apply hx
        have hcond : (FgtY.obj V_et).hom.base (pr₁.base p) = g₀.base (pr₂.base p) :=
          congrArg (fun k : Limits.pullback (FgtY.obj V_et).hom g₀ ⟶ Y => k.base p)
            (Limits.pullback.condition (f := (FgtY.obj V_et).hom) (g := g₀))
        rw [hcond]
        exact hp_W
    · intro U t x hx_not_V
      exact hθ_neg U t x hx_not_V
    · intro U s x hx_V
      let p := Classical.choose (hUniquePre U x hx_V)
      have hp_eq : (Limits.pullback.fst (FgtY.obj U).hom g₀).base p = x :=
        (Classical.choose_spec (hUniquePre U x hx_V)).1
      change θ_raw U ((ψ₀.app (Opposite.op U)) s) x = s.1 x
      exact (hθ_eval U ((ψ₀.app (Opposite.op U)) s) x hx_V p hp_eq).trans
        (congrArg s.1 hp_eq)

  
  
  
  let V_good : Y₀.Opens := ⨆ c : Fin r, V_comp c
  let g : ∀ c : Fin r, X c ⟶ Y₀ := fun c => ν c ≫ ι_Z c
  let W_comp : ∀ c : Fin r, (X c).Opens :=
    fun c => (TopologicalSpace.Opens.map (g c).base).obj (V_comp c)
  let B : ∀ c : Fin r, Y₀.Etale ⥤ (X c).Etale := fun c => weilEtaleSitePullback (g c)

  obtain ⟨Φ_Y, Ψ_Y, hΦ_Y_unit, hΨ_Y_comm⟩ := hModel Y₀ V_good K_Y ι_Y hEx_Y
  have hModel_X_all : ∀ c : Fin r,
