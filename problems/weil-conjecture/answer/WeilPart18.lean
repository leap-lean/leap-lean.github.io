    have hη_spec : Specializes η_Y y₀ := genericPoint_specializes y₀
    have hpη_spec : Specializes
        (Z₀.left.isoSpec.hom.base (f_Y.base η_Y))
        (Z₀.left.isoSpec.hom.base (f_Y.base y₀)) :=
      hη_spec.map (f_Y ≫ Z₀.left.isoSpec.hom).continuous
    have hpη_le : (Z₀.left.isoSpec.hom.base (f_Y.base η_Y)).asIdeal ≤
        (Z₀.left.isoSpec.hom.base (f_Y.base y₀)).asIdeal :=
      (PrimeSpectrum.le_iff_specializes
        (Z₀.left.isoSpec.hom.base (f_Y.base η_Y) : PrimeSpectrum R₀)
        (Z₀.left.isoSpec.hom.base (f_Y.base y₀) : PrimeSpectrum R₀)).mpr hpη_spec
    have hpη_bot : (Z₀.left.isoSpec.hom.base (f_Y.base η_Y)).asIdeal = ⊥ := by
      have hp0_eq : (Z₀.left.isoSpec.hom.base (f_Y.base y₀)).asIdeal = ⊥ := by
        rw [hy₀]
        exact hp0_bot
      exact le_antisymm (hp0_eq ▸ hpη_le) bot_le
    have hη_eq : f_Y.base η_Y = ξ₀.base x_K := by
      have hspec_eq : Z₀.left.isoSpec.hom.base (f_Y.base η_Y) =
          Z₀.left.isoSpec.hom.base (ξ₀.base x_K) :=
        PrimeSpectrum.ext (hpη_bot.trans hp0_bot.symm)
      calc f_Y.base η_Y
          = (Z₀.left.isoSpec.hom ≫ Z₀.left.isoSpec.inv).base (f_Y.base η_Y) := by
              rw [Z₀.left.isoSpec.hom_inv_id]; rfl
        _ = Z₀.left.isoSpec.inv.base (Z₀.left.isoSpec.hom.base (f_Y.base η_Y)) := rfl
        _ = Z₀.left.isoSpec.inv.base (Z₀.left.isoSpec.hom.base (ξ₀.base x_K)) := by
              rw [hspec_eq]
        _ = (Z₀.left.isoSpec.hom ≫ Z₀.left.isoSpec.inv).base (ξ₀.base x_K) := rfl
        _ = ξ₀.base x_K := by rw [Z₀.left.isoSpec.hom_inv_id]; rfl
    obtain ⟨η_tilde, hη_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback η_Y x_K hη_eq
    refine ⟨?_, ?_⟩
    · intro V hAffV hNeV
      have _ : AlgebraicGeometry.IsAffine (V : AlgebraicGeometry.Scheme.{u}) := hAffV
      have hIntV : AlgebraicGeometry.IsIntegral (V : AlgebraicGeometry.Scheme.{u}) :=
        @AlgebraicGeometry.isIntegral_of_isOpenImmersion (V : AlgebraicGeometry.Scheme.{u}) Y
          V.ι inferInstance hIntY hNeV
      have _ : AlgebraicGeometry.IsIntegral (V : AlgebraicGeometry.Scheme.{u}) := hIntV
      let B : Type u := ↑((V : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤))
      have _ : IsDomain B := inferInstance
      let g_V : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
        (V : AlgebraicGeometry.Scheme.{u}).isoSpec.inv ≫ V.ι ≫ f_Y ≫ Z₀.left.isoSpec.hom
      let ψ : R₀ →+* B := CommRingCat.Hom.hom (AlgebraicGeometry.Spec.preimage g_V)
      have hg_V : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) = g_V :=
        AlgebraicGeometry.Spec.map_preimage g_V
      have hηV : η_Y ∈ V := hη_in_open V hNeV
      let v_η : ↥(V : AlgebraicGeometry.Scheme.{u}) := ⟨η_Y, hηV⟩
      let P_η : ↥(AlgebraicGeometry.Spec (CommRingCat.of B)) :=
        (V : AlgebraicGeometry.Scheme.{u}).isoSpec.hom.base v_η
      have hPη_comap : Ideal.comap ψ P_η.asIdeal = ⊥ := by
        have hmap_eq : ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base P_η).asIdeal =
            Ideal.comap ψ P_η.asIdeal := by
          rw [AlgebraicGeometry.Spec.map_apply]
          rfl
        rw [← hmap_eq, hg_V]
        have hbase_eq : g_V.base P_η = Z₀.left.isoSpec.hom.base (f_Y.base η_Y) := by
          dsimp [g_V, P_η]
          have hinv : (V : AlgebraicGeometry.Scheme.{u}).isoSpec.inv.base
              ((V : AlgebraicGeometry.Scheme.{u}).isoSpec.hom.base v_η) = v_η := by
            change ((V : AlgebraicGeometry.Scheme.{u}).isoSpec.hom ≫
              (V : AlgebraicGeometry.Scheme.{u}).isoSpec.inv).base v_η = v_η
            rw [(V : AlgebraicGeometry.Scheme.{u}).isoSpec.hom_inv_id]
            rfl
          change Z₀.left.isoSpec.hom.base (f_Y.base (V.ι.base
            ((V : AlgebraicGeometry.Scheme.{u}).isoSpec.inv.base
              ((V : AlgebraicGeometry.Scheme.{u}).isoSpec.hom.base v_η)))) = _
          rw [hinv]
          rfl
        rw [hbase_eq]
        exact hpη_bot
      have hInj_ψ : Function.Injective ψ := by
        rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
        intro r hr
        have hr_mem : r ∈ Ideal.comap ψ P_η.asIdeal := by
          rw [Ideal.mem_comap, RingHom.mem_ker.mp hr]
          exact Ideal.zero_mem P_η.asIdeal
        rwa [hPη_comap] at hr_mem
      let M₀ : Submonoid R₀ := nonZeroDivisors R₀
      let M : Submonoid B := M₀.map ψ
      have hM_le : M ≤ nonZeroDivisors B := by
        rintro b ⟨m, hm, rfl⟩
        have hm0 : m ≠ 0 := nonZeroDivisors.ne_zero hm
        have hb0 : ψ m ≠ 0 := fun h0 => hm0 (hInj_ψ (h0.trans (map_zero ψ).symm))
        exact mem_nonZeroDivisors_of_ne_zero hb0
      have hDomLoc : IsDomain (Localization M) :=
        @IsLocalization.isDomain_localization B _ _ M hM_le
      let j_B : B →+* Localization M := algebraMap B (Localization M)
      have h_units_M₀ : ∀ y : M₀, IsUnit ((j_B.comp ψ) y.1) := by
        intro y
        exact IsLocalization.map_units (Localization M) (⟨ψ y.1, ⟨y.1, y.2, rfl⟩⟩ : M)
      let ψ_tilde : K₀ →+* Localization M :=
        IsLocalization.lift (M := M₀) (S := K₀) h_units_M₀
      have hψ_tilde_comp : ψ_tilde.comp ι₀ = j_B.comp ψ :=
        IsLocalization.lift_comp (M := M₀) (S := K₀) h_units_M₀
      have hcomm_loc :
          CommRingCat.ofHom ψ ≫ CommRingCat.ofHom j_B =
            CommRingCat.ofHom ι₀ ≫ CommRingCat.ofHom ψ_tilde := by
        apply CommRingCat.hom_ext
        exact hψ_tilde_comp.symm
      have hPushLoc : CategoryTheory.IsPushout
          (CommRingCat.ofHom ψ) (CommRingCat.ofHom ι₀)
          (CommRingCat.ofHom j_B) (CommRingCat.ofHom ψ_tilde) := by
        have h_sc_u : ∀ sc : CategoryTheory.Limits.PushoutCocone
            (CommRingCat.ofHom ψ) (CommRingCat.ofHom ι₀),
            ∀ y : M, IsUnit (sc.inl.hom y.1) := by
          rintro sc ⟨_, ⟨m, hm, rfl⟩⟩
          have hsc_eq : sc.inl.hom (ψ m) = sc.inr.hom (ι₀ m) :=
            congrArg (fun h => h.hom m) sc.condition
          rw [hsc_eq]
          exact (IsLocalization.map_units K₀ ⟨m, hm⟩).map sc.inr.hom
        refine CategoryTheory.IsPushout.of_isColimit
          (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_loc
            (fun sc => CommRingCat.ofHom
              (IsLocalization.lift (S := Localization M) (h_sc_u sc)))
            (fun sc => CommRingCat.hom_ext
              (IsLocalization.lift_comp (S := Localization M) (h_sc_u sc)))
            (fun sc => by
              apply CommRingCat.hom_ext
              apply IsLocalization.ringHom_ext M₀
              change ((IsLocalization.lift (S := Localization M) (h_sc_u sc)).comp ψ_tilde).comp ι₀ =
                sc.inr.hom.comp ι₀
              rw [RingHom.comp_assoc, hψ_tilde_comp, ← RingHom.comp_assoc,
                IsLocalization.lift_comp (S := Localization M) (h_sc_u sc)]
              ext r
              exact congrArg (fun h => h.hom r) sc.condition)
            (fun sc u hu₁ _ => by
              apply CommRingCat.hom_ext
              apply IsLocalization.ringHom_ext M
              have hu_eq : u.hom.comp (algebraMap B (Localization M)) = sc.inl.hom := by
                ext b
                exact congrArg (fun h => h.hom b) hu₁
              exact hu_eq.trans
                (IsLocalization.lift_comp (S := Localization M) (h_sc_u sc)).symm))
      have hSpecPB_loc : CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_B))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_tilde))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)) :=
        AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPushLoc
      have hPB_loc : CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_B) ≫
            (V : AlgebraicGeometry.Scheme.{u}).isoSpec.inv)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_tilde))
          (V.ι ≫ f_Y) ξ₀ := by
        refine hSpecPB_loc.of_iso (CategoryTheory.Iso.refl _)
          (V : AlgebraicGeometry.Scheme.{u}).isoSpec.symm
          (CategoryTheory.Iso.refl _) Z₀.left.isoSpec.symm ?_ ?_ ?_ ?_
        · simp
        · simp
        · rw [hg_V]
          dsimp [g_V]
          simp only [CategoryTheory.Category.assoc]
          have hcomp_id : Z₀.left.isoSpec.hom ≫ Z₀.left.isoSpec.inv =
              CategoryTheory.CategoryStruct.id Z₀.left := Z₀.left.isoSpec.hom_inv_id
          rw [hcomp_id, CategoryTheory.Category.comp_id]
        · dsimp [ξ₀]
          simp
      have hPB_res : CategoryTheory.IsPullback
          (r_Y ∣_ V) ((r_Y ⁻¹ᵁ V).ι ≫ CategoryTheory.Limits.pullback.snd f_Y ξ₀)
          (V.ι ≫ f_Y) ξ₀ :=
        (AlgebraicGeometry.isPullback_morphismRestrict r_Y V).paste_vert
          (CategoryTheory.IsPullback.of_hasPullback f_Y ξ₀)
      let e_loc : AlgebraicGeometry.Spec (CommRingCat.of (Localization M)) ≅
          (r_Y ⁻¹ᵁ V : AlgebraicGeometry.Scheme.{u}) :=
        CategoryTheory.IsPullback.isoIsPullback _ _ hPB_loc hPB_res
      have hIntSpecLoc :
          AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (CommRingCat.of (Localization M))) :=
        (AlgebraicGeometry.affine_isIntegral_iff _).mpr hDomLoc
      have hNe_rV : Nonempty ↥(r_Y ⁻¹ᵁ V) := ⟨⟨η_tilde, by
        change r_Y.base η_tilde ∈ V
        rw [hη_fst]
        exact hηV⟩⟩
      exact @AlgebraicGeometry.isIntegral_of_isOpenImmersion
        (r_Y ⁻¹ᵁ V : AlgebraicGeometry.Scheme.{u})
        (AlgebraicGeometry.Spec (CommRingCat.of (Localization M)))
        e_loc.inv inferInstance hIntSpecLoc hNe_rV
    · intro V₀ V₁ hNe0 hNe1
      refine ⟨⟨η_tilde, ⟨?_, ?_⟩⟩⟩
      · change r_Y.base η_tilde ∈ V₀
        rw [hη_fst]
        exact hη_in_open V₀ hNe0
      · change r_Y.base η_tilde ∈ V₁
        rw [hη_fst]
        exact hη_in_open V₁ hNe1

  
  
  
  have hFlatSurj : ∀ (K₀ : Type u) [Field K₀]
      {W P : AlgebraicGeometry.Scheme.{u}}
      (ϖ : W ⟶ P) [AlgebraicGeometry.IsFinite ϖ]
      (U : Fin 2 → P.Opens)
      (hCov : U 0 ⊔ U 1 = ⊤)
      (hChart : ∀ a : Fin 2,
        Nonempty ((U a : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K₀))))
      (hIntV : ∀ a : Fin 2,
        AlgebraicGeometry.IsIntegral ((ϖ ⁻¹ᵁ U a : AlgebraicGeometry.Scheme.{u})))
      (hInter : Nonempty ↥(ϖ ⁻¹ᵁ U 0 ⊓ ϖ ⁻¹ᵁ U 1))
      (hHitCompl : ∀ a : Fin 2, ∃ w : ↥W, ϖ.base w ∉ U a),
      AlgebraicGeometry.Flat ϖ ∧ AlgebraicGeometry.Surjective ϖ := by
    intro K₀ _ W P ϖ _ U hCov hChart hIntV hInter hHitCompl
    let V : Fin 2 → W.Opens := fun a => ϖ ⁻¹ᵁ U a
    have hCovU_iSup : iSup U = ⊤ := by
      apply le_antisymm le_top
      rw [← hCov]
      exact sup_le (le_iSup U 0) (le_iSup U 1)
    have hCovU_mem : ∀ p : ↥P, p ∈ U 0 ∨ p ∈ U 1 := by
      intro p
      have hp : p ∈ (⊤ : P.Opens) := trivial
      rw [← hCov] at hp
      exact hp
    have hCovV_mem : ∀ w : ↥W, w ∈ V 0 ∨ w ∈ V 1 := fun w => hCovU_mem (ϖ.base w)
    have hPreV : ∀ a : Fin 2, IsPreirreducible (V a : Set ↥W) := by
      intro a
      have _ : AlgebraicGeometry.IsIntegral (V a : AlgebraicGeometry.Scheme.{u}) := hIntV a
      have _ : IrreducibleSpace ↥(V a) :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral (V a : AlgebraicGeometry.Scheme.{u})
      have hRange : (V a : Set ↥W) = Subtype.val '' (Set.univ : Set ↥(V a)) := by
        ext w
        simp
      rw [hRange]
      exact PreirreducibleSpace.isPreirreducible_univ.image
        Subtype.val continuous_subtype_val.continuousOn
    rcases hInter with ⟨⟨w_int, hw_int0, hw_int1⟩⟩
    have hMeetV0 : ∀ O : Set ↥W, IsOpen O → (Set.univ ∩ O).Nonempty →
        ((V 0 : Set ↥W) ∩ O).Nonempty := by
      intro O hO ⟨w, _, hwO⟩
      rcases hCovV_mem w with hw0 | hw1
      · exact ⟨w, hw0, hwO⟩
      · obtain ⟨z, _, hzO, hz0⟩ :=
          hPreV 1 O (V 0 : Set ↥W) hO (V 0).isOpen ⟨w, hw1, hwO⟩ ⟨w_int, hw_int1, hw_int0⟩
        exact ⟨z, hz0, hzO⟩
    have hPreW : IsPreirreducible (Set.univ : Set ↥W) := by
      intro u v hu hv hnu hnv
      obtain ⟨z, _, hzu, hzv⟩ :=
        hPreV 0 u v hu hv (hMeetV0 u hu hnu) (hMeetV0 v hv hnv)
      exact ⟨z, trivial, hzu, hzv⟩
    let C : Set ↥P := Set.range ϖ.base
    have hPreC : IsPreirreducible C := by
      have hC_img : C = ϖ.base '' (Set.univ : Set ↥W) := Set.image_univ.symm
      rw [hC_img]
      exact hPreW.image ϖ.base ϖ.continuous.continuousOn
    have hChartLocal : ∀ a : Fin 2,
        AlgebraicGeometry.Flat (ϖ ∣_ U a) ∧ AlgebraicGeometry.Surjective (ϖ ∣_ U a) := by
      intro a
      let a' : Fin 2 := Fin.rev a
      have hCov_aa' : ∀ p : ↥P, p ∈ U a ∨ p ∈ U a' := by
        intro p
        rcases hCovU_mem p with hp0 | hp1
        · fin_cases a
          · exact Or.inl hp0
          · exact Or.inr hp0
        · fin_cases a
          · exact Or.inr hp1
          · exact Or.inl hp1
      obtain ⟨iso_U⟩ := hChart a
      have hAffUa : AlgebraicGeometry.IsAffineOpen (U a) :=
        AlgebraicGeometry.IsAffine.of_isIso iso_U.hom
      have hAffVa : AlgebraicGeometry.IsAffineOpen (V a) :=
        hAffUa.preimage ϖ
      have _ : AlgebraicGeometry.IsAffine (V a : AlgebraicGeometry.Scheme.{u}) := hAffVa
      have _ : AlgebraicGeometry.IsIntegral (V a : AlgebraicGeometry.Scheme.{u}) := hIntV a
      let D_a : Type u := ↑((V a : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤))
      have _ : IsDomain D_a := inferInstance
      let g_a : AlgebraicGeometry.Spec (CommRingCat.of D_a) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K₀)) :=
        (V a : AlgebraicGeometry.Scheme.{u}).isoSpec.inv ≫ (ϖ ∣_ U a) ≫ iso_U.hom
      let θ_a : Polynomial K₀ →+* D_a :=
        CommRingCat.Hom.hom (AlgebraicGeometry.Spec.preimage g_a)
      have hg_a : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_a) = g_a :=
        AlgebraicGeometry.Spec.map_preimage g_a
      have hfac_res :
          (V a : AlgebraicGeometry.Scheme.{u}).isoSpec.hom ≫ g_a ≫ iso_U.inv = ϖ ∣_ U a := by
        dsimp [g_a]
        simp only [CategoryTheory.Category.assoc, iso_U.hom_inv_id,
          CategoryTheory.Category.comp_id]
        rw [← CategoryTheory.Category.assoc,
          (V a : AlgebraicGeometry.Scheme.{u}).isoSpec.hom_inv_id,
          CategoryTheory.Category.id_comp]
      have hker_bot : RingHom.ker θ_a = ⊥ := by
        by_contra hker_ne
        have hker_prime : (RingHom.ker θ_a).IsPrime := by
          rw [RingHom.ker_eq_comap_bot]
          exact Ideal.IsPrime.comap θ_a
        have hker_max : (RingHom.ker θ_a).IsMaximal :=
          @IsPrime.to_maximal_ideal (Polynomial K₀) _ _ _ (RingHom.ker θ_a) hker_prime hker_ne
        have hg_const : ∀ q₁ q₂ : ↥(AlgebraicGeometry.Spec (CommRingCat.of D_a)),
            g_a.base q₁ = g_a.base q₂ := by
          have h_eq_ker : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of D_a)),
              (g_a.base q).asIdeal = RingHom.ker θ_a := by
            intro q
            have hle : RingHom.ker θ_a ≤ (g_a.base q).asIdeal := by
              rw [← hg_a, AlgebraicGeometry.Spec.map_apply, RingHom.ker_eq_comap_bot]
              exact Ideal.comap_mono bot_le
            exact (hker_max.eq_of_le (g_a.base q).isPrime.ne_top hle).symm
          intro q₁ q₂
          exact PrimeSpectrum.ext ((h_eq_ker q₁).trans (h_eq_ker q₂).symm)
        have hres_const : ∀ v₁ v₂ : ↥(V a : AlgebraicGeometry.Scheme.{u}),
            (ϖ ∣_ U a).base v₁ = (ϖ ∣_ U a).base v₂ := by
          intro v₁ v₂
          rw [← hfac_res]
          change iso_U.inv.base (g_a.base ((V a : AlgebraicGeometry.Scheme.{u}).isoSpec.hom.base v₁)) =
            iso_U.inv.base (g_a.base ((V a : AlgebraicGeometry.Scheme.{u}).isoSpec.hom.base v₂))
          rw [hg_const]
        obtain ⟨w_a, hwa_not⟩ := hHitCompl a
        have hwa_in_a' : ϖ.base w_a ∈ U a' :=
          (hCov_aa' (ϖ.base w_a)).resolve_left hwa_not
        obtain ⟨w', hw'_not⟩ := hHitCompl a'
        have hw'_in_a : ϖ.base w' ∈ U a :=
          (hCov_aa' (ϖ.base w')).resolve_right hw'_not
        obtain ⟨z, ⟨w_z, rfl⟩, hz_a', hz_a⟩ :=
          hPreC (U a' : Set ↥P) (U a : Set ↥P) (U a').isOpen (U a).isOpen
            ⟨ϖ.base w_a, ⟨w_a, rfl⟩, hwa_in_a'⟩ ⟨ϖ.base w', ⟨w', rfl⟩, hw'_in_a⟩
        have hval_res : ∀ (w : ↥W) (hw : w ∈ V a),
            ((ϖ ∣_ U a).base ⟨w, hw⟩).1 = ϖ.base w := by
          intro w hw
          change ((ϖ ∣_ U a) ≫ (U a).ι).base ⟨w, hw⟩ = ϖ.base w
          rw [AlgebraicGeometry.morphismRestrict_ι]
          rfl
        have hz_eq_x : ϖ.base w_z = ϖ.base w' := by
          rw [← hval_res w_z hz_a, ← hval_res w' hw'_in_a,
            hres_const ⟨w_z, hz_a⟩ ⟨w', hw'_in_a⟩]
        rw [hz_eq_x] at hz_a'
        exact hw'_not hz_a'
      have hInj_θ : Function.Injective θ_a :=
        (RingHom.injective_iff_ker_eq_bot θ_a).mpr hker_bot
      
      have hFlat_ga : AlgebraicGeometry.Flat g_a := by
        rw [← hg_a, AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)]
        let _ : Algebra (Polynomial K₀) D_a := θ_a.toAlgebra
        change (algebraMap (Polynomial K₀) D_a).Flat
        rw [RingHom.flat_algebraMap_iff]
        have hTF : Module.IsTorsionFree (Polynomial K₀) D_a := by
          rw [Module.isTorsionFree_iff_smul_eq_zero]
          intro r d hrd
          change θ_a r * d = 0 at hrd
          rcases mul_eq_zero.mp hrd with hr0 | hd0
          · exact Or.inl (hInj_θ (hr0.trans (map_zero θ_a).symm))
          · exact Or.inr hd0
        exact @Module.Flat.instOfIsDedekindDomainOfIsTorsionFree
          (Polynomial K₀) D_a _ _ _ _ hTF
      have hFlat_res : AlgebraicGeometry.Flat (ϖ ∣_ U a) := by
        rw [← hfac_res]
        have _ : AlgebraicGeometry.Flat g_a := hFlat_ga
        infer_instance
      
      have hSurj_ga : AlgebraicGeometry.Surjective g_a := by
        have hClosedRange : IsClosed (Set.range g_a.base) := by
          rw [← Set.image_univ]
          exact g_a.isClosedMap _ isClosed_univ
        let q_bot : ↥(AlgebraicGeometry.Spec (CommRingCat.of D_a)) := ⟨⊥, inferInstance⟩
        have hqbot_img : (g_a.base q_bot).asIdeal = ⊥ := by
          rw [← hg_a, AlgebraicGeometry.Spec.map_apply]
          exact hker_bot
        refine ⟨fun p => ?_⟩
        have hle : (g_a.base q_bot).asIdeal ≤ p.asIdeal := by
          rw [hqbot_img]
          exact bot_le
        have hspec : Specializes (g_a.base q_bot) p :=
          (PrimeSpectrum.le_iff_specializes
            (g_a.base q_bot : PrimeSpectrum (Polynomial K₀))
            (p : PrimeSpectrum (Polynomial K₀))).mp hle
        exact hspec.mem_closed hClosedRange ⟨q_bot, rfl⟩
      have hSurj_res : AlgebraicGeometry.Surjective (ϖ ∣_ U a) := by
        rw [← hfac_res]
        have _ : AlgebraicGeometry.Surjective g_a := hSurj_ga
        infer_instance
      exact ⟨hFlat_res, hSurj_res⟩
    have _ : AlgebraicGeometry.IsZariskiLocalAtTarget @AlgebraicGeometry.Flat :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtTarget @AlgebraicGeometry.Flat
    refine ⟨?_, ?_⟩
    · exact (AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := @AlgebraicGeometry.Flat) U hCovU_iSup).mpr (fun a => (hChartLocal a).1)
