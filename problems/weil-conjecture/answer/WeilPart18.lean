          have hw : g_left ≫ 𝟙 Z = Y_z.hom := MorphismProperty.Over.w f_z
          rw [← hw, ← Category.assoc, hσ_fz, Category.comp_id]
        let σ_hat : U_hat z ⟶ Y_z := MorphismProperty.Over.homMk σ_left hσ_over trivial
        have hσ_u : σ_hat ≫ f_z = u_z z :=
          MorphismProperty.Comma.Hom.ext hσ_fz (Subsingleton.elim _ _)
        refine ⟨𝒢₁.obj.map σ_hat.op s_z, ?_⟩
        have hnat := NatTrans.naturality_apply φ.hom σ_hat.op s_z
        rw [hnat]
        change 𝒢₂.obj.map σ_hat.op (φ.hom.app (Opposite.op Y_z) s_z) = 𝒢₂.obj.map (u_z z).op t
        rw [hs_z]
        change 𝒢₂.obj.map σ_hat.op (𝒢₂.obj.map f_z.op t) = 𝒢₂.obj.map (u_z z).op t
        rw [← Functor.map_comp_apply, ← op_comp, hσ_u]
      choose s'_fam hs'_fam using hLift_pt
      have hArrow_ex : ∀ {W : Z.Etale} (f : W ⟶ T_Z), R_cov f →
          ∃ (z : ↥Z) (hW : U_hat z = W), eqToHom hW.symm ≫ u_z z = f := by
        intro W f hf
        rcases hf with ⟨z⟩
        exact ⟨z, rfl, Category.id_comp _⟩
      have hArrow_uniq : ∀ {W : Z.Etale} (f : W ⟶ T_Z) (z₁ z₂ : ↥Z)
          (hW₁ : U_hat z₁ = W) (hW₂ : U_hat z₂ = W),
          eqToHom hW₁.symm ≫ u_z z₁ = f →
          eqToHom hW₂.symm ≫ u_z z₂ = f →
          z₁ = z₂ := by
        intro W f z₁ z₂ hW₁ hW₂ hf₁ hf₂
        let pt₁ : ↥(U_hat z₁).left := ⟨z₁, rfl⟩
        let w : ↥W.left := (eqToHom hW₁).left.base pt₁
        have hw₁ : (eqToHom hW₁.symm).left.base w = pt₁ := by
          dsimp [w]
          have hcomp : (eqToHom hW₁ ≫ eqToHom hW₁.symm).left.base pt₁ = pt₁ := by
            rw [eqToHom_trans, eqToHom_refl]; rfl
          exact hcomp
        have hval₁ : f.left.base w = z₁ := by
          rw [← hf₁]
          change (u_z z₁).left.base ((eqToHom hW₁.symm).left.base w) = z₁
          rw [hw₁]
          rfl
        let pt₂ : ↥(U_hat z₂).left := (eqToHom hW₂.symm).left.base w
        have hval₂ : f.left.base w = z₂ := by
          rw [← hf₂]
          change (u_z z₂).left.base pt₂ = z₂
          exact pt₂.2
        exact hval₁.symm.trans hval₂
      let x_fam : Presieve.FamilyOfElements (𝒢₁.obj ⋙ forget AddCommGrpCat.{u}) R_cov :=
        fun W f hf =>
          let z := Classical.choose (hArrow_ex f hf)
          let hW := Classical.choose (Classical.choose_spec (hArrow_ex f hf))
          𝒢₁.obj.map (eqToHom hW.symm).op (s'_fam z)
      have hx_apply : ∀ z : ↥Z, x_fam (u_z z) (Presieve.ofArrows.mk z) = s'_fam z := by
        intro z
        suffices ∀ (z₀ : ↥Z) (h : ∃ hW : U_hat z₀ = U_hat z, eqToHom hW.symm ≫ u_z z₀ = u_z z),
            𝒢₁.obj.map (eqToHom (Classical.choose h).symm).op (s'_fam z₀) = s'_fam z from
          this _ (Classical.choose_spec (hArrow_ex (u_z z) (Presieve.ofArrows.mk z)))
        intro z₀ h
        have hz_eq : z₀ = z :=
          hArrow_uniq (u_z z) z₀ z (Classical.choose h) rfl (Classical.choose_spec h) (Category.id_comp _)
        subst hz_eq
        have hh : Classical.choose h = rfl := Subsingleton.elim _ _
        rw [hh, eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
        rfl
      have hx_comp : x_fam.Compatible := by
        intro Y₁ Y₂ W g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
        rcases hf₁ with ⟨z₁⟩
        rcases hf₂ with ⟨z₂⟩
        change 𝒢₁.obj.map g₁.op (x_fam (u_z z₁) (Presieve.ofArrows.mk z₁)) =
          𝒢₁.obj.map g₂.op (x_fam (u_z z₂) (Presieve.ofArrows.mk z₂))
        rw [hx_apply z₁, hx_apply z₂]
        by_cases hz : z₁ = z₂
        · subst hz
          have hleft_comm : g₁.left ≫ (U_z z₁).ι = g₂.left ≫ (U_z z₁).ι :=
            congrArg (fun k : W ⟶ T_Z => k.left) hcomm
          have hg_left : g₁.left = g₂.left := (cancel_mono (U_z z₁).ι).mp hleft_comm
          have hg_eq : g₁ = g₂ := MorphismProperty.Comma.Hom.ext hg_left (Subsingleton.elim _ _)
          rw [hg_eq]
        · have hEmpW : IsEmpty ↥W.left := by
            refine ⟨fun w => hz ?_⟩
            have hc : (g₁ ≫ u_z z₁).left.base w = (g₂ ≫ u_z z₂).left.base w :=
              congrArg (fun k : W ⟶ T_Z => k.left.base w) hcomm
            have h1 : (g₁ ≫ u_z z₁).left.base w = z₁ := (g₁.left.base w).2
            have h2 : (g₂ ≫ u_z z₂).left.base w = z₂ := (g₂.left.base w).2
            exact h1.symm.trans (hc.trans h2)
          have _ := hEmptySub_Z 𝒢₁ W hEmpW
          exact Subsingleton.elim _ _
      have hSF₁ : Presieve.IsSheafFor (𝒢₁.obj ⋙ forget AddCommGrpCat.{u}) R_cov :=
        (hIsSheafType_Z 𝒢₁).isSheafFor R_cov hCov_mem
      have hSF₂ : Presieve.IsSheafFor (𝒢₂.obj ⋙ forget AddCommGrpCat.{u}) R_cov :=
        (hIsSheafType_Z 𝒢₂).isSheafFor R_cov hCov_mem
      let s : 𝒢₁.obj.obj (Opposite.op T_Z) := hSF₁.amalgamate x_fam hx_comp
      refine ⟨s, ?_⟩
      let y_fam : Presieve.FamilyOfElements (𝒢₂.obj ⋙ forget AddCommGrpCat.{u}) R_cov :=
        fun W f _ => 𝒢₂.obj.map f.op t
      refine hSF₂.isSeparatedFor y_fam (φ.hom.app (Opposite.op T_Z) s) t ?_ (fun _ _ _ => rfl)
      intro W f hf
      rcases hf with ⟨z⟩
      have hglue := hSF₁.valid_glue hx_comp (u_z z) (Presieve.ofArrows.mk z)
      change 𝒢₁.obj.map (u_z z).op s = x_fam (u_z z) (Presieve.ofArrows.mk z) at hglue
      rw [hx_apply z] at hglue
      have hnat := NatTrans.naturality_apply φ.hom (u_z z).op s
      change 𝒢₂.obj.map (u_z z).op (φ.hom.app (Opposite.op T_Z) s) = 𝒢₂.obj.map (u_z z).op t
      rw [← hnat]
      change φ.hom.app (Opposite.op (U_hat z)) (𝒢₁.obj.map (u_z z).op s) = 𝒢₂.obj.map (u_z z).op t
      rw [hglue, hs'_fam z]
    have hSurj_H0 : ∀ {𝒢₁ 𝒢₂ : Sheaf J_Z AddCommGrpCat.{u}} (φ : 𝒢₁ ⟶ 𝒢₂) [Epi φ],
        Function.Surjective ((Abelian.Ext.mk₀ φ).postcomp Fℤ_Z (Nat.add_zero 0)) := by
      intro 𝒢₁ 𝒢₂ φ _ y
      let g₂ : Fℤ_Z ⟶ 𝒢₂ := Abelian.Ext.homEquiv₀ y
      let h₂ : Aℤ ⟶ 𝒢₂.obj.obj (Opposite.op T_Z) := adj_Z.homEquiv Aℤ 𝒢₂ g₂
      obtain ⟨m₁, hm₁⟩ := hSurj_app φ (h₂ (ULift.up 1))
      let h₁ : Aℤ ⟶ 𝒢₁.obj.obj (Opposite.op T_Z) :=
        AddCommGrpCat.ofHom
          { toFun := fun z => z.down • m₁
            map_zero' := zero_zsmul m₁
            map_add' := fun a b => add_zsmul m₁ a.down b.down }
      have hh₁₂ : h₁ ≫ φ.hom.app (Opposite.op T_Z) = h₂ := by
        ext ⟨z⟩
        change φ.hom.app (Opposite.op T_Z) (z • m₁) = h₂ (ULift.up z)
        have hz_eq : (ULift.up z : ULift.{u} ℤ) = z • ULift.up 1 := by
          ext; simp
        rw [map_zsmul, hm₁, hz_eq, map_zsmul]
      let g₁ : Fℤ_Z ⟶ 𝒢₁ := (adj_Z.homEquiv Aℤ 𝒢₁).symm h₁
      have hg₁₂ : g₁ ≫ φ = g₂ := by
        apply (adj_Z.homEquiv Aℤ 𝒢₂).injective
        have hnat := Adjunction.homEquiv_naturality_right adj_Z g₁ φ
        change adj_Z.homEquiv Aℤ 𝒢₂ (g₁ ≫ φ) =
          adj_Z.homEquiv Aℤ 𝒢₁ g₁ ≫ φ.hom.app (Opposite.op T_Z) at hnat
        rw [hnat, Equiv.apply_symm_apply]
        exact hh₁₂
      refine ⟨Abelian.Ext.mk₀ g₁, ?_⟩
      change (Abelian.Ext.mk₀ g₁).comp (Abelian.Ext.mk₀ φ) (Nat.add_zero 0) = y
      rw [Abelian.Ext.mk₀_comp_mk₀, hg₁₂]
      exact Abelian.Ext.mk₀_homEquiv₀_apply y
    have hSub_succ : ∀ (m : ℕ) (𝒢' : Sheaf J_Z AddCommGrpCat.{u}), Subsingleton (𝒢'.H (m + 1)) := by
      intro m
      induction m with
      | zero =>
        intro 𝒢'
        let I := Injective.under 𝒢'
        let ι_I : 𝒢' ⟶ I := Injective.ι 𝒢'
        let Q := Limits.cokernel ι_I
        let π_I : I ⟶ Q := Limits.cokernel.π ι_I
        have hS_I : (ShortComplex.mk ι_I π_I (Limits.cokernel.condition ι_I)).ShortExact :=
          ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι_I) inferInstance inferInstance
        have hzero : ∀ x : 𝒢'.H (0 + 1), x = 0 := by
          intro x
          have hxI : x.comp (Abelian.Ext.mk₀ ι_I) (Nat.add_zero 1) = 0 :=
            Abelian.Ext.eq_zero_of_injective _
          obtain ⟨y, hy⟩ :=
            Abelian.Ext.covariant_sequence_exact₁ Fℤ_Z hS_I x hxI (n₀ := 0) rfl
          obtain ⟨u, hu⟩ := hSurj_H0 π_I y
          change u.comp (Abelian.Ext.mk₀ π_I) (Nat.add_zero 0) = y at hu
          rw [← hy, ← hu, Abelian.Ext.comp_assoc u (Abelian.Ext.mk₀ π_I) hS_I.extClass
            (Nat.add_zero 0) (Nat.zero_add 1) (Nat.add_zero 1),
            hS_I.comp_extClass, Abelian.Ext.comp_zero]
        exact ⟨fun a b => sub_eq_zero.mp (hzero (a - b))⟩
      | succ k_idx ih =>
        intro 𝒢'
        let I := Injective.under 𝒢'
        let ι_I : 𝒢' ⟶ I := Injective.ι 𝒢'
        let Q := Limits.cokernel ι_I
        let π_I : I ⟶ Q := Limits.cokernel.π ι_I
        have hS_I : (ShortComplex.mk ι_I π_I (Limits.cokernel.condition ι_I)).ShortExact :=
          ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι_I) inferInstance inferInstance
        have instSubQ : Subsingleton (Q.H (k_idx + 1)) := ih Q
        have hzero : ∀ x : 𝒢'.H (k_idx + 1 + 1), x = 0 := by
          intro x
          have hxI : x.comp (Abelian.Ext.mk₀ ι_I) (Nat.add_zero (k_idx + 1 + 1)) = 0 :=
            Abelian.Ext.eq_zero_of_injective _
          obtain ⟨y, hy⟩ :=
            Abelian.Ext.covariant_sequence_exact₁ Fℤ_Z hS_I x hxI (n₀ := k_idx + 1) rfl
          have hy0 : y = 0 := Subsingleton.elim y 0
          rw [← hy, hy0, Abelian.Ext.zero_comp]
        exact ⟨fun a b => sub_eq_zero.mp (hzero (a - b))⟩
    have hp_eq : p = (p - 1) + 1 := (Nat.sub_add_cancel hp).symm
    rw [hp_eq]
    exact hSub_succ (p - 1) 𝒢

  
  have hAffineLift : ∀ {A A_Z B_Z : Type u} [CommRing A] [CommRing A_Z] [CommRing B_Z]
      (π : A →+* A_Z) (_ : Function.Surjective π)
      (f_Z : A_Z →+* B_Z) (_ : f_Z.Etale),
      ∃ (B_A : Type u) (_ : CommRing B_A) (f_A : A →+* B_A) (π_B : B_A →+* B_Z),
        f_A.Etale ∧
        IsPushout (CommRingCat.ofHom π) (CommRingCat.ofHom f_A)
          (CommRingCat.ofHom f_Z) (CommRingCat.ofHom π_B) := by
    intro A A_Z B_Z _ _ _ π hπ f_Z hf_Z
    letI : Algebra A_Z B_Z := f_Z.toAlgebra
    haveI : Algebra.Etale A_Z B_Z := RingHom.etale_algebraMap.mp hf_Z
    have hStd_Z : Algebra.IsStandardSmoothOfRelativeDimension 0 A_Z B_Z :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
    obtain ⟨ι, σ, hFin_σ, hFin_ι, P_Z, hdim_Z⟩ := hStd_Z.out
    letI : Finite σ := hFin_σ
    letI : Finite ι := hFin_ι
    letI : Fintype σ := Fintype.ofFinite σ
    have hcard_le : Nat.card σ ≤ Nat.card ι := Nat.card_le_card_of_injective P_Z.map P_Z.map_inj
    have hcard_eq : Nat.card ι = Nat.card σ := by
      change Nat.card ι - Nat.card σ = 0 at hdim_Z
      omega
    have hmap_surj : Function.Surjective (MvPolynomial.map π : MvPolynomial ι A →+* MvPolynomial ι A_Z) :=
      MvPolynomial.map_surjective π hπ
    choose rel_A hrel_A using fun (c : σ) => hmap_surj (P_Z.relation c)
    let I_A : Ideal (MvPolynomial ι A) := Ideal.span (Set.range rel_A)
    let Q_A : Type u := MvPolynomial ι A ⧸ I_A
    let P_Q : Algebra.PreSubmersivePresentation A Q_A ι σ :=
      Algebra.PreSubmersivePresentation.naive P_Z.map P_Z.map_inj (v := rel_A)
    let j_Q : Q_A := P_Q.jacobian
    let B_A : Type u := Localization.Away j_Q
    let Q_loc : Algebra.PreSubmersivePresentation Q_A B_A Unit Unit :=
      Algebra.PreSubmersivePresentation.localizationAway B_A j_Q
    let P_comp : Algebra.PreSubmersivePresentation A B_A (Unit ⊕ ι) (Unit ⊕ σ) :=
      Q_loc.comp P_Q
    have hJac_comp : P_comp.jacobian = algebraMap Q_A B_A j_Q * algebraMap Q_A B_A j_Q := by
      dsimp [P_comp]
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
    have hJac_unit : IsUnit P_comp.jacobian := by
      rw [hJac_comp]
      exact (IsLocalization.Away.algebraMap_isUnit j_Q).mul
        (IsLocalization.Away.algebraMap_isUnit j_Q)
    have hdim_comp : P_comp.dimension = 0 := by
      change Nat.card (Unit ⊕ ι) - Nat.card (Unit ⊕ σ) = 0
      rw [Nat.card_sum, Nat.card_sum, Nat.card_unique, hcard_eq]
      omega
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 A B_A :=
      ⟨⟨Unit ⊕ ι, Unit ⊕ σ, inferInstance, inferInstance, ⟨P_comp, hJac_unit⟩, hdim_comp⟩⟩
    haveI : Algebra.Etale A B_A :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr inferInstance
    let f_A : A →+* B_A := algebraMap A B_A
    have hf_A : f_A.Etale := RingHom.etale_algebraMap.mpr inferInstance
    let ev_Z : MvPolynomial ι A_Z →+* B_Z := (MvPolynomial.aeval P_Z.val).toRingHom
    have hev_σ : ∀ b : B_Z, ev_Z (P_Z.σ' b) = b := P_Z.aeval_val_σ'
    have hev_alg : ∀ x : MvPolynomial ι A_Z, ev_Z x = algebraMap P_Z.Ring B_Z x :=
      fun x => (P_Z.algebraMap_apply x).symm
    have hIA_ker : I_A ≤ RingHom.ker (ev_Z.comp (MvPolynomial.map π)) := by
      rw [Ideal.span_le]
      rintro _ ⟨c, rfl⟩
      change ev_Z ((MvPolynomial.map π) (rel_A c)) = 0
      rw [hrel_A c, hev_alg]
      have hmem_ker : P_Z.relation c ∈ P_Z.ker := by
        rw [← P_Z.span_range_relation_eq_ker]
        exact Ideal.subset_span ⟨c, rfl⟩
      exact hmem_ker
    let q₀ : Q_A →+* B_Z := Ideal.Quotient.lift I_A (ev_Z.comp (MvPolynomial.map π)) hIA_ker
    have halg_PQ : ∀ x : MvPolynomial ι A, algebraMap P_Q.Ring Q_A x = Ideal.Quotient.mk I_A x := by
      intro x
      rw [P_Q.algebraMap_apply]
      have hhom : (MvPolynomial.aeval P_Q.val).toRingHom = Ideal.Quotient.mk I_A := by
        apply MvPolynomial.ringHom_ext'
        · ext a
          exact (MvPolynomial.aeval P_Q.val).commutes a
        · intro i
          change (MvPolynomial.aeval P_Q.val) (MvPolynomial.X i) = Ideal.Quotient.mk I_A (MvPolynomial.X i)
          rw [MvPolynomial.aeval_X]
          rfl
      exact RingHom.congr_fun hhom x
    have hq₀_jac : q₀ j_Q = P_Z.jacobian := by
      dsimp [j_Q]
      rw [P_Q.jacobian_eq_jacobiMatrix_det, halg_PQ, P_Z.jacobian_eq_jacobiMatrix_det]
      change ev_Z ((MvPolynomial.map π) P_Q.jacobiMatrix.det) = algebraMap P_Z.Ring B_Z P_Z.jacobiMatrix.det
      rw [← hev_alg]
      congr 1
      rw [RingHom.map_det]
      congr 1
      refine Matrix.ext (fun i j => ?_)
      change (MvPolynomial.map π) (P_Q.jacobiMatrix i j) = P_Z.jacobiMatrix i j
      rw [P_Q.jacobiMatrix_apply, P_Z.jacobiMatrix_apply]
      change (MvPolynomial.map π) ((MvPolynomial.pderiv (P_Z.map i)) (rel_A j)) =
        (MvPolynomial.pderiv (P_Z.map i)) (P_Z.relation j)
      rw [← MvPolynomial.pderiv_map, hrel_A j]
    have hUnit_q₀ : IsUnit (q₀ j_Q) := by
      rw [hq₀_jac]
      exact P_Z.jacobian_isUnit
    let π_B : B_A →+* B_Z := IsLocalization.Away.lift j_Q hUnit_q₀
    have hπB_alg : π_B.comp (algebraMap Q_A B_A) = q₀ :=
      RingHom.ext (IsLocalization.Away.lift_eq j_Q hUnit_q₀)
    have hπB_surj : Function.Surjective π_B := by
      intro b
      obtain ⟨P₀, hP₀⟩ := hmap_surj (P_Z.σ' b)
      refine ⟨algebraMap Q_A B_A (Ideal.Quotient.mk I_A P₀), ?_⟩
      change (π_B.comp (algebraMap Q_A B_A)) (Ideal.Quotient.mk I_A P₀) = b
      rw [hπB_alg]
      change ev_Z ((MvPolynomial.map π) P₀) = b
      rw [hP₀]
      exact hev_σ b
    have hsq_comm : CommRingCat.ofHom π ≫ CommRingCat.ofHom f_Z =
        CommRingCat.ofHom f_A ≫ CommRingCat.ofHom π_B := by
      ext a
      change f_Z (π a) = π_B (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.C a)))
      have h1 : π_B (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.C a))) =
          q₀ (Ideal.Quotient.mk I_A (MvPolynomial.C a)) :=
        IsLocalization.Away.lift_eq j_Q hUnit_q₀ _
      rw [h1]
      change f_Z (π a) = ev_Z ((MvPolynomial.map π) (MvPolynomial.C a))
      rw [MvPolynomial.map_C]
      exact ((MvPolynomial.aeval P_Z.val).commutes (π a)).symm
    refine ⟨B_A, inferInstance, f_A, π_B, hf_A, ?_⟩
    refine IsPushout.of_isColimit' ⟨hsq_comm⟩ ?_
    refine Limits.PushoutCocone.isColimitAux' _ (fun s => ?_)
    let g₁ : A_Z →+* ↑s.pt := s.inl.hom
    let g₂ : B_A →+* ↑s.pt := s.inr.hom
    have hg_comm : ∀ a : A, g₁ (π a) = g₂ (f_A a) :=
      fun a => congrArg (fun k_hom : CommRingCat.of A ⟶ s.pt => k_hom.hom a) s.condition
    let h_poly : MvPolynomial ι A_Z →+* ↑s.pt :=
      MvPolynomial.eval₂Hom g₁ (fun i => g₂ (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.X i))))
    have h_poly_map : h_poly.comp (MvPolynomial.map π) =
        g₂.comp ((algebraMap Q_A B_A).comp (Ideal.Quotient.mk I_A)) := by
      apply MvPolynomial.ringHom_ext'
      · ext a
        dsimp [h_poly]
        rw [MvPolynomial.map_C, MvPolynomial.eval₂_C]
        exact hg_comm a
      · intro i
        change h_poly ((MvPolynomial.map π) (MvPolynomial.X i)) = _
        rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
        rfl
    have hker_le : RingHom.ker ev_Z ≤ RingHom.ker h_poly := by
      have hker_eq : RingHom.ker ev_Z = Ideal.span (Set.range P_Z.relation) := by
        rw [P_Z.span_range_relation_eq_ker]
        ext x
        exact Iff.of_eq (congrArg (· = 0) (hev_alg x))
      rw [hker_eq, Ideal.span_le]
      rintro _ ⟨c, rfl⟩
      change h_poly (P_Z.relation c) = 0
      rw [← hrel_A c]
      change (h_poly.comp (MvPolynomial.map π)) (rel_A c) = 0
      rw [h_poly_map]
      change g₂ (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (rel_A c))) = 0
