    have hy' : (y' ≫ g₀) ≫ q = 𝟙 S_Ω := by
      rw [CategoryTheory.Category.assoc]
      exact hy_eq
    refine ⟨(y' ≫ g₀) ≫ CategoryTheory.Limits.pullback.fst p u, ?_⟩
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
      ← CategoryTheory.Category.assoc, hy', CategoryTheory.Category.id_comp]
  let fibOf : ∀ (W : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W) →
        CategoryTheory.Functor W.Etale (Type u) :=
    fun W Ω _ _ w =>
      { obj := fun E => { e : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E.left // e ≫ E.hom = w }
        map := fun f => TypeCat.ofHom (fun e =>
          ⟨e.1 ≫ f.left,
            (CategoryTheory.Category.assoc e.1 f.left _).trans
              ((congrArg (e.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w f)).trans e.2)⟩)
        map_id := fun E => by
          ext e
          change e.1 ≫ 𝟙 E.left = e.1
          exact CategoryTheory.Category.comp_id e.1
        map_comp := fun f g => by
          ext e
          change e.1 ≫ (f.left ≫ g.left) = (e.1 ≫ f.left) ≫ g.left
          exact (CategoryTheory.Category.assoc e.1 f.left g.left).symm }
  have hPtJoint : ∀ (W : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W)
      {E : W.Etale} (R : CategoryTheory.Sieve E),
      R ∈ W.smallEtaleTopology E →
      ∀ (e : (fibOf W Ω w).obj E),
        ∃ (Y : W.Etale) (u : Y ⟶ E) (_ : R.arrows u) (e' : (fibOf W Ω w).obj Y),
