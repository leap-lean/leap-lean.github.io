                ((CategoryTheory.Category.assoc (u_g g) p₂.left
                    (F_f.map (t_Wι W (σ_perm ι))).left).trans
                  (congrArg (fun k => u_g g ≫ (p₂.left ≫ k))
                    (CategoryTheory.Category.id_comp
                      (F_f.map (t_Wι W (σ_perm ι))).left).symm)))))
      dsimp only [tr_tilde]
      rw [map_sum, map_sum, map_sum, map_sum]
      have h_lhs : ∀ ι : S_idx,
          ℒ.obj.map (u_et_g g).op (ℒ.obj.map p₁.op (ℒ.obj.map (s_Wι W ι).op y)) =
            ℒ.obj.map (u_et_g g ≫ p₂ ≫ s_Wι W (σ_perm ι)).op y := by
        intro ι
        have hm : ℒ.obj.map (s_Wι W ι).op ≫ ℒ.obj.map p₁.op ≫ ℒ.obj.map (u_et_g g).op =
            ℒ.obj.map (u_et_g g ≫ p₁ ≫ s_Wι W ι).op := by
          rw [← ℒ.obj.map_comp, ← ℒ.obj.map_comp, ← op_comp, ← op_comp,
            CategoryTheory.Category.assoc]
        rw [← hs_perm ι]
        exact congrArg (fun φ => φ y) hm
      have h_rhs : ∀ ι : S_idx,
          ℒ.obj.map (u_et_g g).op (ℒ.obj.map p₂.op (ℒ.obj.map (s_Wι W ι).op y)) =
            ℒ.obj.map (u_et_g g ≫ p₂ ≫ s_Wι W ι).op y := by
        intro ι
        have hm : ℒ.obj.map (s_Wι W ι).op ≫ ℒ.obj.map p₂.op ≫ ℒ.obj.map (u_et_g g).op =
            ℒ.obj.map (u_et_g g ≫ p₂ ≫ s_Wι W ι).op := by
          rw [← ℒ.obj.map_comp, ← ℒ.obj.map_comp, ← op_comp, ← op_comp,
            CategoryTheory.Category.assoc]
        exact congrArg (fun φ => φ y) hm
      simp_rw [h_lhs, h_rhs]
      exact Equiv.sum_comp σ_perm (fun ι => ℒ.obj.map (u_et_g g ≫ p₂ ≫ s_Wι W ι).op y)

    have h_tr_ex : ∀ (W : U₂.Etale) (y : ↥((R_f.obj ℳ).obj.obj (Opposite.op W))),
        ∃! z : ↥(ℒ.obj.obj (Opposite.op W)), ℒ.obj.map (q_et W).op z = tr_tilde W y :=
      fun W y => h_singleton_descent ℒ (q_et W) (hSurj_qW W) (tr_tilde W y) (h_tr_eq W y)
    let tr_fun : ∀ (W : U₂.Etale),
        ↥((R_f.obj ℳ).obj.obj (Opposite.op W)) → ↥(ℒ.obj.obj (Opposite.op W)) :=
      fun W y => (h_tr_ex W y).choose
    have h_tr_spec : ∀ (W : U₂.Etale) (y : ↥((R_f.obj ℳ).obj.obj (Opposite.op W))),
        ℒ.obj.map (q_et W).op (tr_fun W y) = tr_tilde W y :=
      fun W y => (h_tr_ex W y).choose_spec.1

    let tr₀ : R_f.obj ℳ ⟶ ℒ :=
      { hom :=
          { app := fun W => AddCommGrpCat.ofHom
              ({ toFun := tr_fun W.unop
                 map_zero' := by
                   apply (h_tr_ex W.unop 0).unique (h_tr_spec W.unop 0)
                   dsimp only [tr_tilde]
                   rw [map_zero]
                   exact (Finset.sum_eq_zero fun ι _ => map_zero _).symm
                 map_add' := fun y₁ y₂ => by
                   apply (h_tr_ex W.unop (y₁ + y₂)).unique (h_tr_spec W.unop (y₁ + y₂))
                   rw [map_add, h_tr_spec W.unop y₁, h_tr_spec W.unop y₂]
                   dsimp only [tr_tilde]
                   rw [← Finset.sum_add_distrib]
                   exact Finset.sum_congr rfl fun ι _ => (map_add _ y₁ y₂).symm } :
                ↥((R_f.obj ℳ).obj.obj (Opposite.op W.unop)) →+ ↥(ℒ.obj.obj (Opposite.op W.unop)))
            naturality := fun {W₂_op W₁_op} f => by
              ext y
              let v : W₁_op.unop ⟶ W₂_op.unop := f.unop
              let W₁ := W₁_op.unop
              let W₂ := W₂_op.unop
              apply (h_tr_ex W₁ ((R_f.obj ℳ).obj.map f y)).unique
                (h_tr_spec W₁ ((R_f.obj ℳ).obj.map f y))
              have hv_comm : (q_W W₁ ≫ v.left) ≫ W₂.hom = r_W W₁ ≫ π'' :=
                (CategoryTheory.Category.assoc (q_W W₁) v.left W₂.hom).trans
                  ((congrArg (q_W W₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w v)).trans
                    CategoryTheory.Limits.pullback.condition)
              let v'' : W''_left W₁ ⟶ W''_left W₂ :=
                CategoryTheory.Limits.pullback.lift (q_W W₁ ≫ v.left) (r_W W₁) hv_comm
              have hv''_hom : v'' ≫ (W''_et W₂).hom = (W''_et W₁).hom :=
                (CategoryTheory.Category.assoc v'' (q_W W₂) W₂.hom).symm.trans
                  ((congrArg (· ≫ W₂.hom)
                      (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                    ((CategoryTheory.Category.assoc (q_W W₁) v.left W₂.hom).trans
                      (congrArg (q_W W₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w v))))
              let v_et'' : W''_et W₁ ⟶ W''_et W₂ :=
                CategoryTheory.MorphismProperty.Over.homMk v'' hv''_hom
              have hv_q : v_et'' ≫ q_et W₂ = q_et W₁ ≫ v :=
                CategoryTheory.MorphismProperty.Over.Hom.ext
                  (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              have hv_s : ∀ ι : S_idx,
                  v_et'' ≫ s_Wι W₂ ι = s_Wι W₁ ι ≫ F_f.map (B_f.map v) := by
                intro ι
                have hv'_hom : v'' ≫ (X'_W W₂ ι).hom = (X'_W W₁ ι).hom :=
                  (CategoryTheory.Category.assoc v'' (r_W W₂) (secS ι)).symm.trans
                    (congrArg (· ≫ secS ι)
                      (CategoryTheory.Limits.pullback.lift_snd _ _ _))
                let v'_ι : X'_W W₁ ι ⟶ X'_W W₂ ι :=
                  CategoryTheory.MorphismProperty.Over.homMk v'' hv'_hom
                have ht_nat : v'_ι ≫ t_Wι W₂ ι = t_Wι W₁ ι ≫ B_f.map v := by
                  apply (adj_f0.homEquiv (X'_W W₁ ι) W₂).symm.injective
                  rw [CategoryTheory.Adjunction.homEquiv_counit,
                    CategoryTheory.Adjunction.homEquiv_counit, F_f.map_comp, F_f.map_comp,
                    CategoryTheory.Category.assoc]
                  have hc₂ := (adj_f0.homEquiv (X'_W W₂ ι) W₂).symm_apply_apply
                    (e_Wι_inv W₂ ι ≫ q_et W₂)
                  have hc₁ := (adj_f0.homEquiv (X'_W W₁ ι) W₁).symm_apply_apply
                    (e_Wι_inv W₁ ι ≫ q_et W₁)
                  rw [CategoryTheory.Adjunction.homEquiv_counit] at hc₁ hc₂
                  rw [hc₂]
                  have hcounit_nat : F_f.map (B_f.map v) ≫ adj_f0.counit.app W₂ =
                      adj_f0.counit.app W₁ ≫ v := adj_f0.counit.naturality v
                  rw [CategoryTheory.Category.assoc, hcounit_nat,
                    ← CategoryTheory.Category.assoc (F_f.map (t_Wι W₁ ι)), hc₁]
                  exact CategoryTheory.MorphismProperty.Over.Hom.ext
                    ((congrArg (v'' ≫ ·) (CategoryTheory.Category.id_comp (q_W W₂))).trans
                      ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                        (congrArg (· ≫ v.left)
                          (CategoryTheory.Category.id_comp (q_W W₁)).symm)))
                have hleft : v'' ≫ (F_f.map (t_Wι W₂ ι)).left =
                    (F_f.map (t_Wι W₁ ι)).left ≫ (F_f.map (B_f.map v)).left :=
                  congrArg (fun m => (F_f.map m).left) ht_nat
                exact CategoryTheory.MorphismProperty.Over.Hom.ext
                  ((congrArg (v'' ≫ ·)
                      (CategoryTheory.Category.id_comp (F_f.map (t_Wι W₂ ι)).left)).trans
                    (hleft.trans
                      (congrArg (· ≫ (F_f.map (B_f.map v)).left)
                        (CategoryTheory.Category.id_comp (F_f.map (t_Wι W₁ ι)).left).symm)))
              have hmap_lhs : ℒ.obj.map v.op ≫ ℒ.obj.map (q_et W₁).op =
                  ℒ.obj.map (q_et W₂).op ≫ ℒ.obj.map v_et''.op := by
                rw [← ℒ.obj.map_comp, ← ℒ.obj.map_comp, ← op_comp, ← op_comp, hv_q]
              change ℒ.obj.map (q_et W₁).op (ℒ.obj.map v.op (tr_fun W₂ y)) =
                tr_tilde W₁ ((R_f.obj ℳ).obj.map f y)
              have hlhs := congrArg (fun φ => φ (tr_fun W₂ y)) hmap_lhs
              change ℒ.obj.map (q_et W₁).op (ℒ.obj.map v.op (tr_fun W₂ y)) =
                ℒ.obj.map v_et''.op (ℒ.obj.map (q_et W₂).op (tr_fun W₂ y)) at hlhs
              rw [hlhs, h_tr_spec W₂ y]
              dsimp [tr_tilde]
              rw [map_sum]
              refine Finset.sum_congr rfl fun ι _ => ?_
              have hm : ℒ.obj.map (s_Wι W₂ ι).op ≫ ℒ.obj.map v_et''.op =
                  ℒ.obj.map (F_f.map (B_f.map v)).op ≫ ℒ.obj.map (s_Wι W₁ ι).op := by
                rw [← ℒ.obj.map_comp, ← ℒ.obj.map_comp, ← op_comp, ← op_comp, hv_s ι]
              exact congrArg (fun φ => φ y) hm } }

    let d₀ : ℕ := Fintype.card S_idx
    have h_unit_tr : adj_f.unit.app ℒ ≫ tr₀ = d₀ • 𝟙 ℒ := by
      apply CategoryTheory.Sheaf.hom_ext
      ext W_op x
      let W := W_op.unop
      apply (h_tr_ex W ((adj_f.unit.app ℒ).hom.app (Opposite.op W) x)).unique
        (h_tr_spec W _)
      change ℒ.obj.map (q_et W).op (d₀ • x) =
        ∑ ι : S_idx, ℒ.obj.map (s_Wι W ι).op (ℒ.obj.map (adj_f0.counit.app W).op x)
      rw [map_nsmul]
      have hterm : ∀ ι : S_idx,
          ℒ.obj.map (s_Wι W ι).op (ℒ.obj.map (adj_f0.counit.app W).op x) =
            ℒ.obj.map (q_et W).op x := by
        intro ι
        have hm : ℒ.obj.map (adj_f0.counit.app W).op ≫ ℒ.obj.map (s_Wι W ι).op =
            ℒ.obj.map (q_et W).op := by
          rw [← ℒ.obj.map_comp, ← op_comp, hs_counit W ι]
        exact congrArg (fun φ => φ x) hm
      simp_rw [hterm, Finset.sum_const, Finset.card_univ]
      rfl

    
    have hd₀_ne : (d₀ : ZMod ℓ) ≠ 0 := by
      intro h0
      exact hCoprime ((ZMod.natCast_eq_zero_iff d₀ ℓ).mp h0)
    let a_inv : ℕ := ((d₀ : ZMod ℓ)⁻¹).val
    have ha_mul_cast : ((a_inv * d₀ : ℕ) : ZMod ℓ) = 1 := by
      rw [Nat.cast_mul, ZMod.natCast_zmod_val]
      exact inv_mul_cancel₀ hd₀_ne
    have ha_pos : 1 ≤ a_inv * d₀ := by
      by_contra h0
      have hzero : a_inv * d₀ = 0 := by omega
      rw [hzero, Nat.cast_zero] at ha_mul_cast
      exact zero_ne_one ha_mul_cast
    have ha_sub_zero : ((a_inv * d₀ - 1 : ℕ) : ZMod ℓ) = 0 := by
      rw [Nat.cast_sub ha_pos, ha_mul_cast, Nat.cast_one, sub_self]
    obtain ⟨q_div, hq_div⟩ := (ZMod.natCast_eq_zero_iff (a_inv * d₀ - 1) ℓ).mp ha_sub_zero
    have ha_eq : a_inv * d₀ = ℓ * q_div + 1 := by omega
    let i_L : ℒ ⟶ weilEtaleHigherDirectImage f_U 0 ℳ := adj_f.unit.app ℒ ≫ e_H0.inv
    let r_L : weilEtaleHigherDirectImage f_U 0 ℳ ⟶ ℒ := e_H0.hom ≫ (a_inv • tr₀)
    refine ⟨i_L, r_L, ?_⟩
    dsimp [i_L, r_L]
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_H0.inv,
      e_H0.inv_hom_id, CategoryTheory.Category.id_comp, CategoryTheory.Preadditive.comp_nsmul,
      h_unit_tr, ← mul_nsmul, mul_comm d₀ a_inv, ha_eq, add_nsmul, mul_nsmul, hTorL,
      nsmul_zero, zero_add, one_nsmul]

  
  
  
  have hFF_U'' : Function.Bijective
      (@CategoryTheory.Functor.map _ _ _ _ C_U'' A A) := by
    let J'' := U''.smallEtaleTopology
    let T_U'' : U''.Etale :=
      AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id U'')
    have hT_U'' : CategoryTheory.Limits.IsTerminal T_U'' := h_etale_term U''
    let adj'' := CategoryTheory.constantSheafAdj J'' AddCommGrpCat.{u} hT_U''
    have hUnitIso : ∀ B : AddCommGrpCat.{u}, CategoryTheory.IsIso (adj''.unit.app B) := by
      intro B
      let L_pre : (U''.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
        { obj := fun U => AddCommGrpCat.of (LocallyConstant ↥U.unop.left ↥B)
          map := fun u => AddCommGrpCat.ofHom
            (LocallyConstant.comapAddMonoidHom ⟨⇑u.unop.left.base, u.unop.left.continuous⟩)
          map_id := fun _ => by ext s x; rfl
          map_comp := fun _ _ => by ext s x; rfl }
      have hL_sheaf : CategoryTheory.Presheaf.IsSheaf J'' L_pre := by
        apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J'' L_pre
          (CategoryTheory.forget AddCommGrpCat.{u})
        rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
        intro U R hR
        have hsurj := (h_mem_etale U'' U R).mp hR
        intro fam hcompat
        let fam' : ∀ {V : U''.Etale} (g : V ⟶ U), R.arrows g → LocallyConstant ↥V.left ↥B :=
          fun g hg => fam g hg
        have hagree : ∀ {V₁ V₂ : U''.Etale} (g₁ : V₁ ⟶ U) (hg₁ : R.arrows g₁)
            (g₂ : V₂ ⟶ U) (hg₂ : R.arrows g₂) (y₁ : ↥V₁.left) (y₂ : ↥V₂.left),
            g₁.left.base y₁ = g₂.left.base y₂ → fam' g₁ hg₁ y₁ = fam' g₂ hg₂ y₂ := by
          intro V₁ V₂ g₁ hg₁ g₂ hg₂ y₁ y₂ h_eq
          haveI : AlgebraicGeometry.Etale g₁.left := h_etale_hom g₁
          haveI : AlgebraicGeometry.Etale g₂.left := h_etale_hom g₂
          let fst_W := CategoryTheory.Limits.pullback.fst g₁.left g₂.left
          let snd_W := CategoryTheory.Limits.pullback.snd g₁.left g₂.left
          have hEt_fst : AlgebraicGeometry.Etale fst_W :=
            CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
              (CategoryTheory.IsPullback.of_hasPullback g₁.left g₂.left).flip inferInstance
          let W_et : U''.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (fst_W ≫ V₁.hom)
            (CategoryTheory.MorphismProperty.comp_mem P_et fst_W V₁.hom hEt_fst V₁.prop)
          let π₁ : W_et ⟶ V₁ := CategoryTheory.MorphismProperty.Over.homMk fst_W rfl
          have h_snd_w : snd_W ≫ V₂.hom = fst_W ≫ V₁.hom :=
            (congrArg (snd_W ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₂).symm).trans
              ((CategoryTheory.Category.assoc snd_W g₂.left U.hom).symm.trans
                ((congrArg (· ≫ U.hom) CategoryTheory.Limits.pullback.condition.symm).trans
                  ((CategoryTheory.Category.assoc fst_W g₁.left U.hom).trans
                    (congrArg (fst_W ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₁)))))
          let π₂ : W_et ⟶ V₂ := CategoryTheory.MorphismProperty.Over.homMk snd_W h_snd_w
          have hπ_eq : π₁ ≫ g₁ = π₂ ≫ g₂ :=
            CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
          obtain ⟨z, hz₁, hz₂⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ h_eq
          have hc := hcompat π₁ π₂ hg₁ hg₂ hπ_eq
          have hcz : (L_pre.map π₁.op (fam' g₁ hg₁)) z = (L_pre.map π₂.op (fam' g₂ hg₂)) z :=
            congrArg (fun (q : LocallyConstant ↥W_et.left ↥B) => q z) hc
          change fam' g₁ hg₁ (fst_W.base z) = fam' g₂ hg₂ (snd_W.base z) at hcz
          rwa [hz₁, hz₂] at hcz
        let s₀_fun : ↥U.left → ↥B := fun x =>
          fam' (hsurj x).choose_spec.choose (hsurj x).choose_spec.choose_spec.choose_spec.1
            (hsurj x).choose_spec.choose_spec.choose
        have hs₀_spec : ∀ {V : U''.Etale} (g : V ⟶ U) (hg : R.arrows g) (y : ↥V.left),
            s₀_fun (g.left.base y) = fam' g hg y := by
          intro V g hg y
          exact hagree _ _ g hg _ y
            (hsurj (g.left.base y)).choose_spec.choose_spec.choose_spec.2.2
        have hs₀_lc : IsLocallyConstant s₀_fun := by
          intro E
          rw [isOpen_iff_forall_mem_open]
          intro x hx
          obtain ⟨V, g, y, hg, hgEt, rfl⟩ := hsurj x
          haveI : AlgebraicGeometry.Etale g.left := hgEt
          have hyE : y ∈ (fam' g hg) ⁻¹' E := by
            change fam' g hg y ∈ E
            rw [← hs₀_spec g hg y]
            exact hx
          refine ⟨⇑g.left.base '' ((fam' g hg) ⁻¹' E), ?_,
            g.left.isOpenMap _ ((fam' g hg).isLocallyConstant E), ⟨y, hyE, rfl⟩⟩
          rintro _ ⟨y', hy', rfl⟩
          change s₀_fun (g.left.base y') ∈ E
          rw [hs₀_spec g hg y']
          exact hy'
        refine ⟨⟨s₀_fun, hs₀_lc⟩, fun {V} g hg => ?_, fun t ht => ?_⟩
        · apply LocallyConstant.ext
          intro y
          exact hs₀_spec g hg y
        · apply LocallyConstant.ext
          intro x
          obtain ⟨V, g, y, hg, -, rfl⟩ := hsurj x
          let t' : LocallyConstant ↥U.left ↥B := t
          have hti : fam' g hg y = t' (g.left.base y) :=
            (congrArg (fun (q : LocallyConstant ↥V.left ↥B) => q y) (ht g hg)).symm
          exact hti.symm.trans (hs₀_spec g hg y).symm
      let L_sh : CategoryTheory.Sheaf J'' AddCommGrpCat.{u} := ⟨L_pre, hL_sheaf⟩
      let FB : CategoryTheory.Sheaf J'' AddCommGrpCat.{u} := C_U''.obj B
      let ι_B : B ⟶ L_pre.obj (Opposite.op T_U'') :=
        AddCommGrpCat.ofHom LocallyConstant.constAddMonoidHom
      let η_B : B ⟶ FB.obj.obj (Opposite.op T_U'') := adj''.unit.app B
      let Φ_hom : FB ⟶ L_sh := (adj''.homEquiv B L_sh).symm ι_B
      have hΦ_unit : η_B ≫ Φ_hom.hom.app (Opposite.op T_U'') = ι_B :=
        (adj''.homEquiv_unit B L_sh Φ_hom).symm.trans
          ((adj''.homEquiv B L_sh).apply_symm_apply ι_B)
      have hFB_empty : ∀ (Z : U''.Etale),
          IsEmpty ↥Z.left → Subsingleton ↥(FB.obj.obj (Opposite.op Z)) := by
        intro Z hEmpty
        have hsh := (CategoryTheory.Presieve.isSheafFor_arrows_iff _ _).mp
          (h_arrows_sheafFor FB Z (fun _ : ↥Z.left => Z) (fun _ => 𝟙 Z)
            (fun x => hEmpty.elim x))
        refine ⟨fun a₁ a₂ => ?_⟩
        obtain ⟨_, _, huniq⟩ := hsh (fun z => hEmpty.elim z) (fun z => hEmpty.elim z)
        exact (huniq a₁ (fun z => hEmpty.elim z)).trans (huniq a₂ (fun z => hEmpty.elim z)).symm
      let W_open : ∀ (U : U''.Etale), LocallyConstant ↥U.left ↥B → ↥U.left → U.left.Opens :=
        fun U s x => ⟨s ⁻¹' {s x}, s.isLocallyConstant {s x}⟩
      let W_et : ∀ (U : U''.Etale), LocallyConstant ↥U.left ↥B → ↥U.left → U''.Etale :=
        fun U s x => CategoryTheory.MorphismProperty.Over.mk ⊤ ((W_open U s x).ι ≫ U.hom)
          (CategoryTheory.MorphismProperty.comp_mem P_et (W_open U s x).ι U.hom
            inferInstance U.prop)
      let j_et : ∀ (U : U''.Etale) (s : LocallyConstant ↥U.left ↥B) (x : ↥U.left),
          W_et U s x ⟶ U :=
        fun U s x => CategoryTheory.MorphismProperty.Over.homMk (W_open U s x).ι rfl
      have hj_surj : ∀ (U : U''.Etale) (s : LocallyConstant ↥U.left ↥B) (x : ↥U.left),
          ∃ (i : ↥U.left) (y : ↥(W_et U s i).left), (j_et U s i).left.base y = x :=
        fun U s x => ⟨x, ⟨x, rfl⟩, rfl⟩
      let σ_loc : ∀ (U : U''.Etale) (s : LocallyConstant ↥U.left ↥B) (x : ↥U.left),
          ↥(FB.obj.obj (Opposite.op (W_et U s x))) :=
        fun U s x => FB.obj.map (hT_U''.from (W_et U s x)).op (η_B (s x))
      have hψ_ex : ∀ (U : U''.Etale) (s : LocallyConstant ↥U.left ↥B),
          ∃! t : ↥(FB.obj.obj (Opposite.op U)),
            ∀ x : ↥U.left, FB.obj.map (j_et U s x).op t = σ_loc U s x := by
        intro U s
        refine ((CategoryTheory.Presieve.isSheafFor_arrows_iff _ _).mp
          (h_arrows_sheafFor FB U (W_et U s) (j_et U s) (hj_surj U s))) (σ_loc U s) ?_
        intro x₁ x₂ Z g₁ g₂ hgg
        by_cases hne : Nonempty ↥Z.left
        · obtain ⟨z₀⟩ := hne
          have hs₁ : s ((g₁ ≫ j_et U s x₁).left.base z₀) = s x₁ := (g₁.left.base z₀).2
          have hs₂ : s ((g₂ ≫ j_et U s x₂).left.base z₀) = s x₂ := (g₂.left.base z₀).2
          rw [hgg] at hs₁
          have hsx : s x₁ = s x₂ := hs₁.symm.trans hs₂
          have hterm : g₁ ≫ hT_U''.from (W_et U s x₁) = g₂ ≫ hT_U''.from (W_et U s x₂) :=
            hT_U''.hom_ext _ _
          have hmap : FB.obj.map (hT_U''.from (W_et U s x₁)).op ≫ FB.obj.map g₁.op =
              FB.obj.map (hT_U''.from (W_et U s x₂)).op ≫ FB.obj.map g₂.op := by
            rw [← FB.obj.map_comp, ← FB.obj.map_comp, ← op_comp, ← op_comp, hterm]
          dsimp only [σ_loc]
          rw [hsx]
          exact congrArg (fun φ => φ (η_B (s x₂))) hmap
        · haveI := hFB_empty Z (not_nonempty_iff.mp hne)
          exact Subsingleton.elim _ _
      let ψ_fun : ∀ (U : U''.Etale), LocallyConstant ↥U.left ↥B → ↥(FB.obj.obj (Opposite.op U)) :=
        fun U s => (hψ_ex U s).choose
      have hψ_spec : ∀ (U : U''.Etale) (s : LocallyConstant ↥U.left ↥B) (x : ↥U.left),
          FB.obj.map (j_et U s x).op (ψ_fun U s) = σ_loc U s x :=
        fun U s => (hψ_ex U s).choose_spec.1
      have hψ_const : ∀ {V U : U''.Etale} (g : V ⟶ U) (s : LocallyConstant ↥U.left ↥B) (b : ↥B),
          (∀ y : ↥V.left, s (g.left.base y) = b) →
          FB.obj.map g.op (ψ_fun U s) = FB.obj.map (hT_U''.from V).op (η_B b) := by
        intro V U g s b hconst
        by_cases hne : Nonempty ↥V.left
        · obtain ⟨y₀⟩ := hne
          let x₀ : ↥U.left := g.left.base y₀
          have hb₀ : s x₀ = b := hconst y₀
          have hrange : Set.range ⇑g.left.base ⊆ Set.range ⇑(W_open U s x₀).ι.base := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨y, rfl⟩
            change s (g.left.base y) = s x₀
            rw [hconst y, hb₀]
          let l₀ : V.left ⟶ (W_open U s x₀ : AlgebraicGeometry.Scheme.{u}) :=
            AlgebraicGeometry.IsOpenImmersion.lift (W_open U s x₀).ι g.left hrange
          have hl₀_fac : l₀ ≫ (W_open U s x₀).ι = g.left :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac (W_open U s x₀).ι g.left hrange
          have hl₀_w : l₀ ≫ (W_et U s x₀).hom = V.hom :=
            (CategoryTheory.Category.assoc l₀ (W_open U s x₀).ι U.hom).symm.trans
              ((congrArg (· ≫ U.hom) hl₀_fac).trans
                (CategoryTheory.MorphismProperty.Over.w g))
          let l_et : V ⟶ W_et U s x₀ := CategoryTheory.MorphismProperty.Over.homMk l₀ hl₀_w
          have hl_eq : l_et ≫ j_et U s x₀ = g :=
            CategoryTheory.MorphismProperty.Over.Hom.ext hl₀_fac
          have hterm : l_et ≫ hT_U''.from (W_et U s x₀) = hT_U''.from V := hT_U''.hom_ext _ _
          have hmap₁ : FB.obj.map g.op = FB.obj.map (j_et U s x₀).op ≫ FB.obj.map l_et.op := by
            rw [← hl_eq, op_comp, FB.obj.map_comp]
          have hmap₂ : FB.obj.map (hT_U''.from (W_et U s x₀)).op ≫ FB.obj.map l_et.op =
              FB.obj.map (hT_U''.from V).op := by
            rw [← FB.obj.map_comp, ← op_comp, hterm]
          calc
            FB.obj.map g.op (ψ_fun U s)
              = FB.obj.map l_et.op (FB.obj.map (j_et U s x₀).op (ψ_fun U s)) :=
                congrArg (fun φ => φ (ψ_fun U s)) hmap₁
            _ = FB.obj.map l_et.op (FB.obj.map (hT_U''.from (W_et U s x₀)).op (η_B b)) := by
                rw [hψ_spec U s x₀]
                dsimp [σ_loc]
                rw [hb₀]
            _ = FB.obj.map (hT_U''.from V).op (η_B b) :=
                congrArg (fun φ => φ (η_B b)) hmap₂
        · haveI := hFB_empty V (not_nonempty_iff.mp hne)
          exact Subsingleton.elim _ _
      let Ψ_hom : L_sh ⟶ FB :=
        { hom :=
            { app := fun U => AddCommGrpCat.ofHom
                { toFun := ψ_fun U.unop
                  map_zero' := by
                    have h1 := hψ_const (𝟙 U.unop) 0 0 (fun _ => rfl)
                    simpa only [op_id, FB.obj.map_id, AddCommGrpCat.id_apply, map_zero] using h1
                  map_add' := fun s₁ s₂ => by
                    let W₁₂ : ↥U.unop.left → U.unop.left.Opens :=
                      fun x => W_open U.unop s₁ x ⊓ W_open U.unop s₂ x
                    let W₁₂_et : ↥U.unop.left → U''.Etale := fun x =>
                      CategoryTheory.MorphismProperty.Over.mk ⊤ ((W₁₂ x).ι ≫ U.unop.hom)
                        (CategoryTheory.MorphismProperty.comp_mem P_et (W₁₂ x).ι U.unop.hom
                          inferInstance U.unop.prop)
                    let j₁₂ : ∀ x : ↥U.unop.left, W₁₂_et x ⟶ U.unop :=
                      fun x => CategoryTheory.MorphismProperty.Over.homMk (W₁₂ x).ι rfl
                    refine h_arrows_sep FB U.unop W₁₂_et j₁₂
                      (fun x => ⟨x, ⟨x, rfl, rfl⟩, rfl⟩) _ _ fun x => ?_
                    rw [map_add,
                      hψ_const (j₁₂ x) (s₁ + s₂) (s₁ x + s₂ x)
                        (fun y => congrArg₂ (· + ·) y.2.1 y.2.2),
                      hψ_const (j₁₂ x) s₁ (s₁ x) (fun y => y.2.1),
                      hψ_const (j₁₂ x) s₂ (s₂ x) (fun y => y.2.2),
                      ← map_add, ← map_add] }
              naturality := fun {U V} u => by
                ext s
                apply (hψ_ex V.unop (L_pre.map u s)).unique (hψ_spec V.unop (L_pre.map u s))
                intro y
                have hmap : FB.obj.map u ≫ FB.obj.map (j_et V.unop (L_pre.map u s) y).op =
                    FB.obj.map (j_et V.unop (L_pre.map u s) y ≫ u.unop).op := by
                  rw [op_comp, FB.obj.map_comp]
                  rfl
                exact (congrArg (fun φ => φ (ψ_fun U.unop s)) hmap).trans
                  (hψ_const (j_et V.unop (L_pre.map u s) y ≫ u.unop) s
                    (s (u.unop.left.base y)) (fun z => z.2)) } }
      have hιΨ : ι_B ≫ Ψ_hom.hom.app (Opposite.op T_U'') = η_B := by
        ext b
        change ψ_fun T_U'' (LocallyConstant.const ↥T_U''.left b) = η_B.hom b
        have h1 := hψ_const (𝟙 T_U'') (LocallyConstant.const ↥T_U''.left b) b (fun _ => rfl)
        have h_id : hT_U''.from T_U'' = 𝟙 T_U'' := hT_U''.hom_ext _ _
        rw [h_id] at h1
        simpa only [op_id, FB.obj.map_id, AddCommGrpCat.id_apply] using h1
      have hΦΨ : Φ_hom ≫ Ψ_hom = 𝟙 FB := by
        apply (adj''.homEquiv B FB).injective
        rw [adj''.homEquiv_unit, adj''.homEquiv_unit]
        change η_B ≫ (Φ_hom.hom.app (Opposite.op T_U'') ≫ Ψ_hom.hom.app (Opposite.op T_U'')) =
          η_B ≫ 𝟙 _
        rw [← CategoryTheory.Category.assoc, hΦ_unit, hιΨ, CategoryTheory.Category.comp_id]
      haveI : AlgebraicGeometry.IsIntegral U'' := hInt_U''
      haveI : IrreducibleSpace ↥U'' := AlgebraicGeometry.irreducibleSpace_of_isIntegral U''
      haveI : ConnectedSpace ↥U'' := IrreducibleSpace.connectedSpace ↥U''
      let s_pt : ↥U'' := Nonempty.some inferInstance
      let ev_pt : L_pre.obj (Opposite.op T_U'') ⟶ B :=
        AddCommGrpCat.ofHom
          { toFun := fun f => f s_pt
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
      have h_ι_ev : ι_B ≫ ev_pt = 𝟙 B := by
        ext b
        rfl
      have h_ev_ι : ev_pt ≫ ι_B = 𝟙 (L_pre.obj (Opposite.op T_U'')) := by
        ext f x
        haveI : PreconnectedSpace ↥(Opposite.unop (Opposite.op T_U'')).left := by
          change PreconnectedSpace ↥U''
          infer_instance
        exact LocallyConstant.apply_eq_of_preconnectedSpace f s_pt x
      let inv_unit : FB.obj.obj (Opposite.op T_U'') ⟶ B :=
        Φ_hom.hom.app (Opposite.op T_U'') ≫ ev_pt
      refine ⟨⟨inv_unit, ?_, ?_⟩⟩
      · dsimp [inv_unit]
        rw [← CategoryTheory.Category.assoc, hΦ_unit, h_ι_ev]
      · change (Φ_hom.hom.app (Opposite.op T_U'') ≫ ev_pt) ≫ η_B = 𝟙 _
        rw [CategoryTheory.Category.assoc, ← hιΨ, ← CategoryTheory.Category.assoc ev_pt,
          h_ev_ι, CategoryTheory.Category.id_comp]
        exact congrArg (fun (α : FB ⟶ FB) => α.hom.app (Opposite.op T_U'')) hΦΨ
    haveI : CategoryTheory.IsIso adj''.unit :=
      CategoryTheory.NatIso.isIso_of_isIso_app adj''.unit
    exact (adj''.fullyFaithfulLOfIsIsoUnit).map_bijective A A


  
  
  
