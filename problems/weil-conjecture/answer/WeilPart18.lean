    by_cases hx₁ : xbar.base default ∈ (C₁ : Set ↥X.left)
    · have : CategoryTheory.IsIso (𝒮_x.map η) := hStalkC₁ Ω xbar hx₁
      have hι0 : 𝒮_x.map (CategoryTheory.Limits.kernel.ι η) = 0 := by
        apply (CategoryTheory.cancel_mono (𝒮_x.map η)).mp
