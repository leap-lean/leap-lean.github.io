    let W_f := (CategoryTheory.Functor.whiskeringLeft
      (Opposite W₂.Etale) (Opposite W₁.Etale) AddCommGrpCat.{u}).obj B_f.op
    let L₂ := CategoryTheory.presheafToSheaf J₂ AddCommGrpCat.{u}
    haveI : CategoryTheory.IsIso (CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).counit :=
      CategoryTheory.sheafification_reflective
    let ε₂ : S₂_pre.comp L₂ ≅ CategoryTheory.Functor.id _ :=
      CategoryTheory.asIso (CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).counit
    obtain ⟨e_W₁⟩ := hIso0 W₁
    exact ⟨(CategoryTheory.Functor.rightUnitor (P_push f)).symm ≪≫
      (CategoryTheory.Functor.isoWhiskerLeft (P_push f) ε₂).symm ≪≫
      (CategoryTheory.Functor.associator (P_push f) S₂_pre L₂).symm ≪≫
      CategoryTheory.Functor.isoWhiskerRight
        (CategoryTheory.Functor.sheafPushforwardContinuousCompSheafToPresheafIso
          B_f AddCommGrpCat.{u} J₂ J₁) L₂ ≪≫
      CategoryTheory.Functor.associator S₁_pre W_f L₂ ≪≫
      CategoryTheory.Functor.isoWhiskerRight e_W₁ (W_f.comp L₂)⟩
  have hR0_zero : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (f : W₁ ⟶ W₂),
      (R0_push f).PreservesZeroMorphisms := by
    intro W₁ W₂ f
    letI : (P_push f).Additive := (hPushProps f).1
    obtain ⟨Θ⟩ := hΘ f
    refine ⟨fun X Y => ?_⟩
    apply ((CategoryTheory.Iso.cancel_iso_hom_left (Θ.app X)) _ _).mp
    calc
      (Θ.app X).hom ≫ (R0_push f).map (0 : X ⟶ Y)
          = (P_push f).map (0 : X ⟶ Y) ≫ (Θ.app Y).hom :=
        (Θ.hom.naturality (0 : X ⟶ Y)).symm
      _ = 0 := by
        rw [CategoryTheory.Functor.map_zero, CategoryTheory.Limits.zero_comp]
      _ = (Θ.app X).hom ≫ 0 :=
        CategoryTheory.Limits.comp_zero.symm
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro Y₁ Y₂ h hEmp
    let F := weilEtaleTorsionSheaf Y₁ ℓ
    have hZeroObj : ∀ E : Y₁.Etale,
        CategoryTheory.Limits.IsZero (F.obj.obj (Opposite.op E)) := by
      intro E
      have hEmptyE : IsEmpty ↥E.left := ⟨fun z => hEmp.elim (E.hom.base z)⟩
      have hBot : (⊥ : CategoryTheory.Sieve E) ∈ Y₁.smallEtaleTopology E :=
        (hMemEtale E ⊥).mpr fun x => hEmptyE.elim x
      exact (CategoryTheory.Sheaf.isTerminalOfBotCover F E hBot).isZero
    have hZeroF : CategoryTheory.Limits.IsZero F := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply (CategoryTheory.sheafToPresheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}).map_injective
      rw [CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_zero]
      apply CategoryTheory.NatTrans.ext
      funext W
      exact CategoryTheory.Limits.IsZero.eq_of_src (hZeroObj W.unop) _ _
    letI : (P_push h).Additive := (hPushProps h).1
    obtain ⟨Θ⟩ := hΘ h
    exact (Θ.app F).isZero_iff.mp ((P_push h).map_isZero hZeroF)
  · intro Y
    let C_Y := CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
    let A_ℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    have hA : ℓ • CategoryTheory.CategoryStruct.id A_ℓ = 0 := by
      apply AddCommGrpCat.ext
      rintro ⟨x⟩
      apply ULift.ext
      let evA : (A_ℓ ⟶ A_ℓ) →+ ZMod ℓ :=
        { toFun := fun m => ((CategoryTheory.ConcreteCategory.hom m) ⟨x⟩).down
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      change evA (ℓ • CategoryTheory.CategoryStruct.id A_ℓ) = 0
      rw [evA.map_nsmul]
      change ℓ • x = 0
      rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
    change ℓ • CategoryTheory.CategoryStruct.id (C_Y.obj A_ℓ) = 0
    rw [← C_Y.map_id, ← C_Y.map_nsmul, hA, C_Y.map_zero]
  · intro Y₁ Y₂ h q G hG
    let P_q := G.cohomologyPresheaf q
    have hPre : ℓ • CategoryTheory.CategoryStruct.id P_q = 0 := by
      ext W α
      let F_W := (CategoryTheory.presheafToSheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}).obj
        ((CategoryTheory.yoneda.obj W.unop).comp AddCommGrpCat.free)
      let α' : CategoryTheory.Abelian.Ext F_W G q := α
      let ψ_α := CategoryTheory.Abelian.Ext.bilinearComp F_W G G q 0 q (Nat.add_zero q) α'
      have h_id : ψ_α (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id G)) = α' := by
        dsimp only [ψ_α]
        rw [CategoryTheory.Abelian.Ext.bilinearComp_apply_apply]
        exact CategoryTheory.Abelian.Ext.comp_mk₀_id α'
      have h_smul0 : ℓ • CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id G) = 0 := by
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, ← map_nsmul, hG, map_zero]
      let evW : (P_q ⟶ P_q) →+ CategoryTheory.Abelian.Ext F_W G q :=
        { toFun := fun η => (AddCommGrpCat.Hom.hom (η.app W)) α
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      change evW (ℓ • CategoryTheory.CategoryStruct.id P_q) = 0
      rw [evW.map_nsmul]
      change ℓ • α' = 0
      rw [← h_id, ← map_nsmul, h_smul0, map_zero]
    let B_h : CategoryTheory.Functor Y₂.Etale Y₁.Etale := weilCompEtaleSitePullback h
    let W_h := (CategoryTheory.Functor.whiskeringLeft
      (Opposite Y₂.Etale) (Opposite Y₁.Etale) AddCommGrpCat.{u}).obj B_h.op
    let L₂ := CategoryTheory.presheafToSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}
    change ℓ • CategoryTheory.CategoryStruct.id (L₂.obj (W_h.obj P_q)) = 0
    rw [← L₂.map_id, ← W_h.map_id, ← L₂.map_nsmul, ← W_h.map_nsmul,
      hPre, W_h.map_zero, L₂.map_zero]
  · intro Y₁ Y₂ h G₁ G₂ ⟨e⟩
    exact ⟨(R0_push h).mapIso e⟩
  · intro Y₁ Y₂ h G₁ G₂
    letI : (P_push h).Additive := (hPushProps h).1
    letI : CategoryTheory.Limits.PreservesFiniteLimits (P_push h) := (hPushProps h).2
    letI : CategoryTheory.Limits.PreservesBinaryBiproducts (P_push h) :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryProducts (P_push h)
    obtain ⟨Θ⟩ := hΘ h
    exact ⟨(Θ.app (CategoryTheory.Limits.biprod G₁ G₂)).symm ≪≫
      (P_push h).mapBiprod G₁ G₂ ≪≫
      CategoryTheory.Limits.biprod.mapIso (Θ.app G₁) (Θ.app G₂)⟩
  · intro Y₀ Y₁ Y₂ u h G₀
    obtain ⟨Θ_u⟩ := hΘ u
    obtain ⟨Θ_h⟩ := hΘ h
    obtain ⟨Θ_uh⟩ := hΘ (u ≫ h)
    obtain ⟨e_comp⟩ := hPushComp u h
    exact ⟨(Θ_h.app ((R0_push u).obj G₀)).symm ≪≫
      (P_push h).mapIso (Θ_u.app G₀).symm ≪≫
      (e_comp.app G₀).symm ≪≫
      Θ_uh.app G₀⟩
  · intro Y₁ Y₂ h S₀ hSE hZeroR1
    let J₁ := Y₁.smallEtaleTopology
    let J₂ := Y₂.smallEtaleTopology
    letI : (P_push h).Additive := (hPushProps h).1
    letI : CategoryTheory.Limits.PreservesFiniteLimits (P_push h) := (hPushProps h).2
    letI : (R0_push h).PreservesZeroMorphisms := hR0_zero h
    obtain ⟨Θ_h⟩ := hΘ h
    let S₁ := S₀.map (R0_push h)
    have hLeftP : (S₀.map (P_push h)).Exact ∧ CategoryTheory.Mono ((P_push h).map S₀.f) :=
      (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono (P_push h)).mp
        inferInstance S₀ hSE
    have hLeftR0 : S₁.Exact ∧ CategoryTheory.Mono S₁.f :=
      (CategoryTheory.ShortComplex.exact_and_mono_f_iff_of_iso (S₀.mapNatIso Θ_h)).mp hLeftP
    let L₁ := CategoryTheory.presheafToSheaf J₁ AddCommGrpCat.{u}
    let F_E : Y₁.Etale → CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} :=
      fun E => L₁.obj ((CategoryTheory.yoneda.obj E).comp AddCommGrpCat.free)
    let Q₂ := S₀.X₂.cohomologyPresheaf 0
    let Q₃ := S₀.X₃.cohomologyPresheaf 0
    let R₁ := S₀.X₁.cohomologyPresheaf 1
    let f_pre : Q₂ ⟶ Q₃ := (CategoryTheory.Sheaf.cohomologyPresheafFunctor J₁ 0).map S₀.g
    let δ₀ : Q₃ ⟶ R₁ :=
      { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (F_E W.unop) (Nat.zero_add 1))
        naturality := fun {W₁ W₂} v => by
          apply AddCommGrpCat.ext
          intro x₃
          let x₃' : CategoryTheory.Abelian.Ext (F_E W₁.unop) S₀.X₃ 0 := x₃
          let φ_v : F_E W₂.unop ⟶ F_E W₁.unop :=
            L₁.map (CategoryTheory.Functor.whiskerRight
              (CategoryTheory.yoneda.map v.unop) AddCommGrpCat.free)
          exact CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
            (CategoryTheory.Abelian.Ext.mk₀ φ_v) x₃' hSE.extClass (Nat.zero_add 1) }
    have h0 : f_pre ≫ δ₀ = 0 := by
      ext W x₂
      let x₂' : CategoryTheory.Abelian.Ext (F_E W.unop) S₀.X₂ 0 := x₂
      change (x₂'.comp (CategoryTheory.Abelian.Ext.mk₀ S₀.g) (Nat.add_zero 0)).comp
        hSE.extClass (Nat.zero_add 1) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
        x₂' (CategoryTheory.Abelian.Ext.mk₀ S₀.g) hSE.extClass (Nat.zero_add 1),
        hSE.comp_extClass]
      exact CategoryTheory.Abelian.Ext.comp_zero x₂' S₀.X₁ 1 1 (Nat.zero_add 1)
    let SC₀ := CategoryTheory.ShortComplex.mk f_pre δ₀ h0
    have hEx₀ : SC₀.Exact := by
      rw [CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero]
      ext W z
      let x₃_Q : ↥(SC₀.X₂.obj W) :=
        (AddCommGrpCat.Hom.hom ((CategoryTheory.Limits.kernel.ι SC₀.g).app W)) z
      let x₃ : CategoryTheory.Abelian.Ext (F_E W.unop) S₀.X₃ 0 := x₃_Q
      have hx₃ : x₃.comp hSE.extClass (Nat.zero_add 1) = 0 :=
        congrArg (fun η => (AddCommGrpCat.Hom.hom (η.app W)) z)
          (CategoryTheory.Limits.kernel.condition SC₀.g)
      obtain ⟨x₂, hx₂⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
          (F_E W.unop) hSE x₃ (Nat.zero_add 1) hx₃
      let x₂_Q : ↥(SC₀.X₁.obj W) := x₂
      have hx₂_Q : (AddCommGrpCat.Hom.hom (SC₀.f.app W)) x₂_Q = x₃_Q := hx₂
      change (AddCommGrpCat.Hom.hom ((CategoryTheory.Limits.kernel.ι SC₀.g ≫
          CategoryTheory.Limits.cokernel.π SC₀.f).app W)) z = 0
      calc
        (AddCommGrpCat.Hom.hom ((CategoryTheory.Limits.kernel.ι SC₀.g ≫
            CategoryTheory.Limits.cokernel.π SC₀.f).app W)) z
            = (AddCommGrpCat.Hom.hom ((CategoryTheory.Limits.cokernel.π SC₀.f).app W)) x₃_Q := rfl
        _ = (AddCommGrpCat.Hom.hom ((CategoryTheory.Limits.cokernel.π SC₀.f).app W))
              ((AddCommGrpCat.Hom.hom (SC₀.f.app W)) x₂_Q) :=
            congrArg (AddCommGrpCat.Hom.hom ((CategoryTheory.Limits.cokernel.π SC₀.f).app W))
              hx₂_Q.symm
        _ = (AddCommGrpCat.Hom.hom ((SC₀.f ≫
              CategoryTheory.Limits.cokernel.π SC₀.f).app W)) x₂_Q := rfl
        _ = (AddCommGrpCat.Hom.hom ((0 : SC₀.X₁ ⟶
              CategoryTheory.Limits.cokernel SC₀.f).app W)) x₂_Q :=
            congrArg (fun η => (AddCommGrpCat.Hom.hom (η.app W)) x₂_Q)
              (CategoryTheory.Limits.cokernel.condition SC₀.f)
        _ = 0 := rfl
    let B_h : CategoryTheory.Functor Y₂.Etale Y₁.Etale := weilCompEtaleSitePullback h
    let W_h := (CategoryTheory.Functor.whiskeringLeft
      (Opposite Y₂.Etale) (Opposite Y₁.Etale) AddCommGrpCat.{u}).obj B_h.op
    let L₂ := CategoryTheory.presheafToSheaf J₂ AddCommGrpCat.{u}
    let SC_sh := (SC₀.map W_h).map L₂
    have hEx_sh : SC_sh.Exact := (hEx₀.map W_h).map L₂
    have hZero_g : SC_sh.g = 0 :=
      CategoryTheory.Limits.IsZero.eq_of_tgt hZeroR1 _ _
    have hEpi_g : CategoryTheory.Epi S₁.g :=
      (CategoryTheory.ShortComplex.Exact.epi_f_iff hEx_sh).mpr hZero_g
    exact ⟨S₁, CategoryTheory.ShortComplex.ShortExact.mk' hLeftR0.1 hLeftR0.2 hEpi_g,
      rfl, rfl, rfl⟩

theorem weil_etale_geometric_point_stalk_conservativity (S : AlgebraicGeometry.Scheme.{u})
    (H : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
    (hStalk : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (x : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
      ∃ (G₀ : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback x H G₀ ∧ CategoryTheory.Limits.IsZero G₀) :
    CategoryTheory.Limits.IsZero H :=
by
  
  
  let fibOf : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (_w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
      CategoryTheory.Functor W.Etale (Type u) :=
    fun W Ω _ _ w =>
      { obj := fun E =>
          { e : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E.left // e ≫ E.hom = w }
        map := fun {_ _} u =>
          TypeCat.ofHom fun e =>
            ⟨e.1 ≫ u.left,
              ((CategoryTheory.Category.assoc e.1 u.left _).trans
                (congrArg (e.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w u))).trans e.2⟩
        map_id := fun E => by
          ext ⟨e, he⟩
          exact CategoryTheory.Category.comp_id e
        map_comp := fun u v => by
          ext ⟨e, he⟩
          exact (CategoryTheory.Category.assoc e u.left v.left).symm }
  let pt : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (_w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
      CategoryTheory.GrothendieckTopology.Point.{u} W.smallEtaleTopology :=
    fun W Ω _ _ w => by
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      letI : Unique ↥S_Ω := PrimeSpectrum.instUnique
      have : IsSepClosed Ω := inferInstance
      let fib_w := fibOf W Ω w
      have hJoint : ∀ {E : W.Etale}, ∀ R ∈ W.smallEtaleTopology E,
          ∀ (e : fib_w.obj E),
            ∃ (Y : W.Etale) (u : Y ⟶ E) (_ : R.arrows u) (e' : fib_w.obj Y),
              fib_w.map u e' = e := by
        intro E R hR e
        let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme :=
          @AlgebraicGeometry.Etale
        have hR' : R ∈ (AlgebraicGeometry.Scheme.smallPretopology P P).toGrothendieck E := by
          rwa [← AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
            (P := P) (Q := P) W (le_refl P)]
        obtain ⟨Y, u, y₀, huR, huP, hy₀⟩ :=
          (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
            (P := P) (Q := P) (S := W) E R).mp hR' (e.1 default)
        have : AlgebraicGeometry.Etale u.left := huP
        let Z₀ := CategoryTheory.Limits.pullback u.left e.1
        let p : Z₀ ⟶ Y.left := CategoryTheory.Limits.pullback.fst u.left e.1
        let q : Z₀ ⟶ S_Ω := CategoryTheory.Limits.pullback.snd u.left e.1
        have hq_surj : Function.Surjective ⇑q := by
          intro s
          have hs : e.1 s = e.1 default := congrArg (⇑e.1) (Subsingleton.elim s default)
          obtain ⟨z, -, hz⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₀ s (hy₀.trans hs.symm)
          exact ⟨z, hz⟩
        have hsing_mem : CategoryTheory.Presieve.singleton q ∈
            (AlgebraicGeometry.Scheme.precoverage P).coverings S_Ω :=
          (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff P q).mpr ⟨hq_surj, inferInstance⟩
        have hcov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q) ∈
            AlgebraicGeometry.Scheme.etaleTopology S_Ω :=
          CategoryTheory.Precoverage.generate_mem_toGrothendieck hsing_mem
        obtain ⟨Z, f_Z, hf_Z, z_Z, hz_Z⟩ :=
          (AlgebraicGeometry.Scheme.geometricFiber Ω).jointly_surjective _ hcov (𝟙 S_Ω)
        obtain ⟨Z', g_Z, q', hq'_sing, hfac⟩ := hf_Z
        cases hq'_sing
        change z_Z ≫ f_Z = 𝟙 S_Ω at hz_Z
        let σ : S_Ω ⟶ Z₀ := z_Z ≫ g_Z
        have hσ_q : σ ≫ q = 𝟙 S_Ω := by
          calc
            σ ≫ q = z_Z ≫ (g_Z ≫ q) := CategoryTheory.Category.assoc z_Z g_Z q
            _ = z_Z ≫ f_Z := by rw [hfac]
            _ = 𝟙 S_Ω := hz_Z
        let e'_mor : S_Ω ⟶ Y.left := σ ≫ p
        have he'_u : e'_mor ≫ u.left = e.1 := by
          calc
            e'_mor ≫ u.left = σ ≫ (p ≫ u.left) := CategoryTheory.Category.assoc σ p u.left
            _ = σ ≫ (q ≫ e.1) := by rw [CategoryTheory.Limits.pullback.condition]
            _ = (σ ≫ q) ≫ e.1 := (CategoryTheory.Category.assoc σ q e.1).symm
            _ = 𝟙 S_Ω ≫ e.1 := by rw [hσ_q]
            _ = e.1 := CategoryTheory.Category.id_comp e.1
        have he'_w : e'_mor ≫ Y.hom = w :=
          ((congrArg (e'_mor ≫ ·) (CategoryTheory.MorphismProperty.Over.w u).symm).trans
            ((CategoryTheory.Category.assoc e'_mor u.left E.hom).symm.trans
              (congrArg (· ≫ E.hom) he'_u))).trans e.2
        exact ⟨Y, u, huR, ⟨e'_mor, he'_w⟩, Subtype.ext he'_u⟩
      have hcof_or_empty : CategoryTheory.IsCofilteredOrEmpty fib_w.Elements := by
        refine CategoryTheory.IsCofilteredOrEmpty.mk ?_ ?_
        · intro X Y
          have : AlgebraicGeometry.Etale X.1.hom := X.1.prop
          have : AlgebraicGeometry.Etale Y.1.hom := Y.1.prop
          let fst : CategoryTheory.Limits.pullback X.1.hom Y.1.hom ⟶ X.1.left :=
            CategoryTheory.Limits.pullback.fst X.1.hom Y.1.hom
          let snd : CategoryTheory.Limits.pullback X.1.hom Y.1.hom ⟶ Y.1.left :=
            CategoryTheory.Limits.pullback.snd X.1.hom Y.1.hom
          let E₁₂ : W.Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ (fst ≫ X.1.hom) inferInstance
          let l : S_Ω ⟶ E₁₂.left :=
            CategoryTheory.Limits.pullback.lift X.2.1 Y.2.1 (X.2.2.trans Y.2.2.symm)
          have hl : l ≫ E₁₂.hom = w :=
            ((CategoryTheory.Category.assoc l fst X.1.hom).symm.trans
              (congrArg (· ≫ X.1.hom)
                (CategoryTheory.Limits.pullback.lift_fst X.2.1 Y.2.1 _))).trans X.2.2
          let Z : fib_w.Elements := CategoryTheory.Functor.elementsMk fib_w E₁₂ ⟨l, hl⟩
          let pX : E₁₂ ⟶ X.1 := CategoryTheory.MorphismProperty.Over.homMk fst rfl
          let pY : E₁₂ ⟶ Y.1 :=
            CategoryTheory.MorphismProperty.Over.homMk snd
              CategoryTheory.Limits.pullback.condition.symm
          have hpX : fib_w.map pX Z.2 = X.2 :=
            Subtype.ext (CategoryTheory.Limits.pullback.lift_fst X.2.1 Y.2.1 _)
          have hpY : fib_w.map pY Z.2 = Y.2 :=
            Subtype.ext (CategoryTheory.Limits.pullback.lift_snd X.2.1 Y.2.1 _)
          exact ⟨Z, ⟨pX, hpX⟩, ⟨pY, hpY⟩, trivial⟩
        · intro X Y u v
          have : AlgebraicGeometry.Etale X.1.hom := X.1.prop
          have : AlgebraicGeometry.Etale Y.1.hom := Y.1.prop
          let Δ := CategoryTheory.Limits.pullback.diagonal Y.1.hom
          have : AlgebraicGeometry.IsOpenImmersion Δ :=
            AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal Y.1.hom
          have huv_w : u.1.left ≫ Y.1.hom = v.1.left ≫ Y.1.hom :=
            (CategoryTheory.MorphismProperty.Over.w u.1).trans
              (CategoryTheory.MorphismProperty.Over.w v.1).symm
          let uv := CategoryTheory.Limits.pullback.lift u.1.left v.1.left huv_w
          let p₁ := CategoryTheory.Limits.pullback.fst Δ uv
          let j₀ : CategoryTheory.Limits.pullback Δ uv ⟶ X.1.left :=
            CategoryTheory.Limits.pullback.snd Δ uv
          let E₀ : W.Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ (j₀ ≫ X.1.hom) inferInstance
          have hu_pt : X.2.1 ≫ u.1.left = Y.2.1 := congrArg Subtype.val u.2
          have hv_pt : X.2.1 ≫ v.1.left = Y.2.1 := congrArg Subtype.val v.2
          let y_pt : S_Ω ⟶ Y.1.left := Y.2.1
          let x_pt : S_Ω ⟶ X.1.left := X.2.1
          have hpt_eq : y_pt ≫ Δ = x_pt ≫ uv := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact ((CategoryTheory.Category.assoc y_pt Δ _).trans
                ((congrArg (y_pt ≫ ·) (CategoryTheory.Limits.pullback.diagonal_fst Y.1.hom)).trans
                  (CategoryTheory.Category.comp_id y_pt))).trans
                (((CategoryTheory.Category.assoc x_pt uv _).trans
                  (congrArg (x_pt ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
                  hu_pt).symm
            · exact ((CategoryTheory.Category.assoc y_pt Δ _).trans
                ((congrArg (y_pt ≫ ·) (CategoryTheory.Limits.pullback.diagonal_snd Y.1.hom)).trans
                  (CategoryTheory.Category.comp_id y_pt))).trans
                (((CategoryTheory.Category.assoc x_pt uv _).trans
                  (congrArg (x_pt ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _))).trans
                  hv_pt).symm
          let l₀ : S_Ω ⟶ E₀.left := CategoryTheory.Limits.pullback.lift y_pt x_pt hpt_eq
          have hl₀ : l₀ ≫ E₀.hom = w :=
            ((CategoryTheory.Category.assoc l₀ j₀ X.1.hom).symm.trans
              (congrArg (· ≫ X.1.hom)
                (CategoryTheory.Limits.pullback.lift_snd y_pt x_pt hpt_eq))).trans X.2.2
          let Z₀ : fib_w.Elements := CategoryTheory.Functor.elementsMk fib_w E₀ ⟨l₀, hl₀⟩
          let h_mor : E₀ ⟶ X.1 := CategoryTheory.MorphismProperty.Over.homMk j₀ rfl
          have hh_pt : fib_w.map h_mor Z₀.2 = X.2 :=
            Subtype.ext (CategoryTheory.Limits.pullback.lift_snd y_pt x_pt hpt_eq)
          let h_el : Z₀ ⟶ X := ⟨h_mor, hh_pt⟩
          refine ⟨Z₀, h_el, ?_⟩
          apply CategoryTheory.Functor.Elements.hom_ext
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          change j₀ ≫ u.1.left = j₀ ≫ v.1.left
          have hcond := CategoryTheory.Limits.pullback.condition (f := Δ) (g := uv)
          have h1 : p₁ = j₀ ≫ u.1.left :=
            ((CategoryTheory.Category.comp_id p₁).symm.trans
              (congrArg (p₁ ≫ ·) (CategoryTheory.Limits.pullback.diagonal_fst Y.1.hom).symm)).trans
              (((CategoryTheory.Category.assoc p₁ Δ _).symm.trans
                (congrArg (· ≫ _) hcond)).trans
                ((CategoryTheory.Category.assoc j₀ uv _).trans
                  (congrArg (j₀ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _))))
          have h2 : p₁ = j₀ ≫ v.1.left :=
            ((CategoryTheory.Category.comp_id p₁).symm.trans
              (congrArg (p₁ ≫ ·) (CategoryTheory.Limits.pullback.diagonal_snd Y.1.hom).symm)).trans
              (((CategoryTheory.Category.assoc p₁ Δ _).symm.trans
                (congrArg (· ≫ _) hcond)).trans
                ((CategoryTheory.Category.assoc j₀ uv _).trans
                  (congrArg (j₀ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _))))
          exact h1.symm.trans h2
      have hne : Nonempty fib_w.Elements :=
        ⟨CategoryTheory.Functor.elementsMk fib_w
          (AlgebraicGeometry.Scheme.Etale.mk (𝟙 W)) ⟨w, CategoryTheory.Category.comp_id w⟩⟩
      have hcof : CategoryTheory.IsCofiltered fib_w.Elements :=
        @CategoryTheory.IsCofiltered.mk _ _ hcof_or_empty hne
      have hism : CategoryTheory.InitiallySmall.{u} fib_w.Elements := by
        let ι_aff : CategoryTheory.Functor W.AffineEtale W.Etale :=
          AlgebraicGeometry.Scheme.AffineEtale.Spec W
        let M : Type u := CategoryTheory.SmallModel.{u} W.AffineEtale
        let e_M := CategoryTheory.equivSmallModel.{u} W.AffineEtale
        let Idx : Type u := Sigma fun (m : M) => fib_w.obj (ι_aff.obj (e_M.inverse.obj m))
        let φ : Idx → fib_w.Elements := fun p =>
          CategoryTheory.Functor.elementsMk fib_w (ι_aff.obj (e_M.inverse.obj p.1)) p.2
        have : Small.{u} ↑(Set.range φ) := small_range φ
        refine @CategoryTheory.initiallySmall_of_small_weakly_initial_set _ _ hcof_or_empty
          (Set.range φ) _ ?_
        intro X
        have hcov_aff : CategoryTheory.Sieve.coverByImage ι_aff X.1 ∈ W.smallEtaleTopology X.1 :=
          CategoryTheory.Functor.is_cover_of_isCoverDense ι_aff W.smallEtaleTopology X.1
        obtain ⟨Y, u, hu_cov, e_Y, he_Y⟩ := hJoint _ hcov_aff X.2
        obtain ⟨A, f₁, f₂, hf₁₂⟩ := hu_cov
        let e_A : fib_w.obj (ι_aff.obj A) := fib_w.map f₁ e_Y
        have he_A : fib_w.map f₂ e_A = X.2 := by
          dsimp [e_A]
          have hmap_comp := congrArg (fun k => k e_Y) (fib_w.map_comp f₁ f₂)
          dsimp at hmap_comp
          rw [← hmap_comp, hf₁₂, he_Y]
        let m : M := e_M.functor.obj A
        let θ : ι_aff.obj (e_M.inverse.obj m) ≅ ι_aff.obj A :=
          ι_aff.mapIso (e_M.unitIso.app A).symm
        let e_m : fib_w.obj (ι_aff.obj (e_M.inverse.obj m)) := fib_w.map θ.inv e_A
        have he_m : fib_w.map (θ.hom ≫ f₂) e_m = X.2 := by
          dsimp [e_m]
          have h1 := congrArg (fun k => k e_A) (fib_w.map_comp θ.inv (θ.hom ≫ f₂))
          dsimp at h1
          rw [← h1, ← CategoryTheory.Category.assoc, θ.inv_hom_id,
            CategoryTheory.Category.id_comp, he_A]
        exact ⟨φ ⟨m, e_m⟩, ⟨⟨m, e_m⟩, rfl⟩, ⟨⟨θ.hom ≫ f₂, he_m⟩⟩⟩
      exact CategoryTheory.GrothendieckTopology.Point.mk fib_w hcof hism hJoint

  
  have hPi_id : ∀ (M : AddCommGrpCat.{u}) (I₁ I₂ : Type u) (f : I₂ → I₁) (g : I₁ → I₂),
      (∀ i : I₁, f (g i) = i) →
      CategoryTheory.Limits.Pi.lift (fun s : I₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (f s)) ≫
        CategoryTheory.Limits.Pi.lift (fun t : I₁ => CategoryTheory.Limits.Pi.π (fun _ : I₂ => M) (g t)) =
        𝟙 (∏ᶜ fun _ : I₁ => M) := by
    intro M I₁ I₂ f g hfg
    apply CategoryTheory.Limits.Pi.hom_ext
    intro t
    simp [hfg t]
  have hPi_map' : ∀ (M : AddCommGrpCat.{u}) (I₁ I₂ J₁ J₂ : Type u)
      (a₁ : J₁ → I₁) (a₂ : J₂ → I₂) (b₁ : I₂ → I₁) (b₂ : J₂ → J₁),
      (∀ s : J₂, a₁ (b₂ s) = b₁ (a₂ s)) →
      CategoryTheory.Limits.Pi.lift (fun s : J₁ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (a₁ s)) ≫
        CategoryTheory.Limits.Pi.map' b₂ (fun _ => 𝟙 M) =
      CategoryTheory.Limits.Pi.map' b₁ (fun _ => 𝟙 M) ≫
        CategoryTheory.Limits.Pi.lift (fun s : J₂ => CategoryTheory.Limits.Pi.π (fun _ : I₂ => M) (a₂ s)) := by
    intro M I₁ I₂ J₁ J₂ a₁ a₂ b₁ b₂ hcomm
    apply CategoryTheory.Limits.Pi.hom_ext
    intro s
    simp [hcomm s]
  have hPi_map : ∀ {M M' : AddCommGrpCat.{u}} (φ : M ⟶ M') (I₁ I₂ : Type u) (a : I₂ → I₁),
      CategoryTheory.Limits.Pi.lift (fun s : I₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (a s)) ≫
        CategoryTheory.Limits.Pi.map (fun _ : I₂ => φ) =
      CategoryTheory.Limits.Pi.map (fun _ : I₁ => φ) ≫
        CategoryTheory.Limits.Pi.lift (fun s : I₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M') (a s)) := by
    intro M M' φ I₁ I₂ a
    apply CategoryTheory.Limits.Pi.hom_ext
    intro s
    simp

  have hStalkZero : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (x : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
      CategoryTheory.Limits.IsZero ((pt S Ω x).sheafFiber.obj H) := by
    intro Ω _ _ x
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let Φ₀ := pt S_Ω Ω (𝟙 S_Ω)
    let Φ_x := pt S Ω x
    let B := weilEtaleSitePullback x
    let α : ∀ (E₂ : S.Etale), Φ₀.fiber.obj (B.obj E₂) ≃ Φ_x.fiber.obj E₂ := fun E₂ =>
      let fst_E₂ : CategoryTheory.Limits.pullback E₂.hom x ⟶ E₂.left :=
        CategoryTheory.Limits.pullback.fst E₂.hom x
      let snd_E₂ : CategoryTheory.Limits.pullback E₂.hom x ⟶ S_Ω :=
        CategoryTheory.Limits.pullback.snd E₂.hom x
      { toFun := fun t =>
          let t_mor : S_Ω ⟶ CategoryTheory.Limits.pullback E₂.hom x := t.1
          let ht_mor : t_mor ≫ snd_E₂ = 𝟙 S_Ω := t.2
          ⟨t_mor ≫ fst_E₂,
            ((CategoryTheory.Category.assoc t_mor fst_E₂ E₂.hom).trans
              (congrArg (t_mor ≫ ·)
                (CategoryTheory.Limits.pullback.condition (f := E₂.hom) (g := x)))).trans
              (((CategoryTheory.Category.assoc t_mor snd_E₂ x).symm.trans
                (congrArg (· ≫ x) ht_mor)).trans
                (CategoryTheory.Category.id_comp x))⟩
        invFun := fun s =>
          ⟨CategoryTheory.Limits.pullback.lift s.1 (𝟙 S_Ω)
            (s.2.trans (CategoryTheory.Category.id_comp x).symm),
           CategoryTheory.Limits.pullback.lift_snd _ _ _⟩
        left_inv := fun t => by
          apply Subtype.ext
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
          · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans t.2.symm
        right_inv := fun s => by
          apply Subtype.ext
          exact CategoryTheory.Limits.pullback.lift_fst _ _ _ }
    have hα_symm : ∀ {E₂ E₂' : S.Etale} (u : E₂ ⟶ E₂') (s : Φ_x.fiber.obj E₂),
        Φ₀.fiber.map (B.map u) ((α E₂).symm s) = (α E₂').symm (Φ_x.fiber.map u s) := by
      intro E₂ E₂' u s
      apply Subtype.ext
      let fst₁ : CategoryTheory.Limits.pullback E₂.hom x ⟶ E₂.left :=
        CategoryTheory.Limits.pullback.fst E₂.hom x
      let snd₁ : CategoryTheory.Limits.pullback E₂.hom x ⟶ S_Ω :=
        CategoryTheory.Limits.pullback.snd E₂.hom x
      let fst₂ : CategoryTheory.Limits.pullback E₂'.hom x ⟶ E₂'.left :=
        CategoryTheory.Limits.pullback.fst E₂'.hom x
      let snd₂ : CategoryTheory.Limits.pullback E₂'.hom x ⟶ S_Ω :=
        CategoryTheory.Limits.pullback.snd E₂'.hom x
      let l₁ : S_Ω ⟶ CategoryTheory.Limits.pullback E₂.hom x :=
        CategoryTheory.Limits.pullback.lift s.1 (𝟙 S_Ω)
          (s.2.trans (CategoryTheory.Category.id_comp x).symm)
      let l₂ : S_Ω ⟶ CategoryTheory.Limits.pullback E₂'.hom x :=
        CategoryTheory.Limits.pullback.lift (s.1 ≫ u.left) (𝟙 S_Ω)
          (((CategoryTheory.Category.assoc s.1 u.left E₂'.hom).trans
            (congrArg (s.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w u))).trans
            (s.2.trans (CategoryTheory.Category.id_comp x).symm))
      let b_map : CategoryTheory.Limits.pullback E₂.hom x ⟶
          CategoryTheory.Limits.pullback E₂'.hom x :=
        (B.map u).left
      have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) x :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) x :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      have hB_map : b_map = CategoryTheory.Limits.pullback.lift
          (fst₁ ≫ u.left) snd₁
          (((CategoryTheory.Category.assoc fst₁ u.left E₂'.hom).trans
            (congrArg (fst₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u))).trans
            (CategoryTheory.Limits.pullback.condition (f := E₂.hom) (g := x))) :=
        CategoryTheory.MorphismProperty.Over.pullback_map_left (@AlgebraicGeometry.Etale) ⊤ x u
      change l₁ ≫ b_map = l₂
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact ((CategoryTheory.Category.assoc l₁ b_map fst₂).trans
          (congrArg (l₁ ≫ ·)
            ((congrArg (· ≫ fst₂) hB_map).trans
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)))).trans
          (((CategoryTheory.Category.assoc l₁ fst₁ u.left).symm.trans
            (congrArg (· ≫ u.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)
      · exact ((CategoryTheory.Category.assoc l₁ b_map snd₂).trans
          (congrArg (l₁ ≫ ·)
            ((congrArg (· ≫ snd₂) hB_map).trans
              (CategoryTheory.Limits.pullback.lift_snd _ _ _)))).trans
          ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm)
    obtain ⟨G₀, hPull, hZeroG₀⟩ := hStalk Ω x
    obtain ⟨hc, hr, ⟨e₀⟩⟩ := hPull
    let pf := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B AddCommGrpCat.{u} _
      S.smallEtaleTopology S_Ω.smallEtaleTopology hc
    let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _ B AddCommGrpCat.{u} _
      S.smallEtaleTopology S_Ω.smallEtaleTopology hc hr
    let adj := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _ B AddCommGrpCat.{u} _
      S.smallEtaleTopology S_Ω.smallEtaleTopology hc hr
    let e_sky : (Φ₀.skyscraperSheafFunctor (A := AddCommGrpCat.{u})) ⋙ pf ≅
        (Φ_x.skyscraperSheafFunctor (A := AddCommGrpCat.{u})) := by
      refine CategoryTheory.NatIso.ofComponents (fun M => ?_) (fun {M M'} φ => ?_)
      · refine
          { hom :=
              { hom :=
                  { app := fun j =>
                      CategoryTheory.Limits.Pi.lift fun (s : Φ_x.fiber.obj j.unop) =>
                        CategoryTheory.Limits.Pi.π
                          (fun _ : Φ₀.fiber.obj (B.obj j.unop) => M) ((α j.unop).symm s)
                    naturality := fun {j₁ j₂} f => by
                      change (Φ₀.skyscraperPresheafFunctor.obj M).map (B.op.map f) ≫ _ =
                        _ ≫ (Φ_x.skyscraperPresheafFunctor.obj M).map f
                      rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map,
                        CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map]
                      exact (hPi_map' M
                        (Φ₀.fiber.obj (B.obj j₁.unop)) (Φ₀.fiber.obj (B.obj j₂.unop))
                        (Φ_x.fiber.obj j₁.unop) (Φ_x.fiber.obj j₂.unop)
                        (α j₁.unop).symm (α j₂.unop).symm
                        (Φ₀.fiber.map (B.map f.unop)) (Φ_x.fiber.map f.unop)
                        (fun s => (hα_symm f.unop s).symm)).symm } }
            inv :=
              { hom :=
                  { app := fun j =>
                      CategoryTheory.Limits.Pi.lift fun (t : Φ₀.fiber.obj (B.obj j.unop)) =>
                        CategoryTheory.Limits.Pi.π
                          (fun _ : Φ_x.fiber.obj j.unop => M) (α j.unop t)
                    naturality := fun {j₁ j₂} f => by
                      change (Φ_x.skyscraperPresheafFunctor.obj M).map f ≫ _ =
                        _ ≫ (Φ₀.skyscraperPresheafFunctor.obj M).map (B.op.map f)
                      rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map,
                        CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map]
                      refine (hPi_map' M
                        (Φ_x.fiber.obj j₁.unop) (Φ_x.fiber.obj j₂.unop)
                        (Φ₀.fiber.obj (B.obj j₁.unop)) (Φ₀.fiber.obj (B.obj j₂.unop))
                        (α j₁.unop) (α j₂.unop)
                        (Φ_x.fiber.map f.unop) (Φ₀.fiber.map (B.map f.unop))
                        (fun t => ?_)).symm
                      apply (α j₁.unop).symm.injective
                      rw [(α j₁.unop).symm_apply_apply]
                      exact (congrArg (Φ₀.fiber.map (B.map f.unop))
                        ((α j₂.unop).symm_apply_apply t)).symm.trans
                        (hα_symm f.unop (α j₂.unop t)) } }
            hom_inv_id := by
              apply CategoryTheory.Sheaf.hom_ext
              ext j : 2
              exact hPi_id M (Φ₀.fiber.obj (B.obj j.unop)) (Φ_x.fiber.obj j.unop)
                (α j.unop).symm (α j.unop) (α j.unop).symm_apply_apply
            inv_hom_id := by
              apply CategoryTheory.Sheaf.hom_ext
              ext j : 2
              exact hPi_id M (Φ_x.fiber.obj j.unop) (Φ₀.fiber.obj (B.obj j.unop))
                (α j.unop) (α j.unop).symm (α j.unop).apply_symm_apply }
      · apply CategoryTheory.Sheaf.hom_ext
        ext j : 2
        change ((Φ₀.skyscraperPresheafFunctor.map φ).app (B.op.obj j)) ≫ _ =
          _ ≫ ((Φ_x.skyscraperPresheafFunctor.map φ).app j)
        rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app,
          CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app]
        exact (hPi_map φ (Φ₀.fiber.obj (B.obj j.unop)) (Φ_x.fiber.obj j.unop)
          (α j.unop).symm).symm
    let adj_comp := (adj.comp (Φ₀.skyscraperSheafAdjunction (A := AddCommGrpCat.{u}))).ofNatIsoRight e_sky
    let e_stalk : pb ⋙ (Φ₀.sheafFiber (A := AddCommGrpCat.{u})) ≅
        (Φ_x.sheafFiber (A := AddCommGrpCat.{u})) :=
      adj_comp.leftAdjointUniq (Φ_x.skyscraperSheafAdjunction (A := AddCommGrpCat.{u}))
    let iso_H : Φ_x.sheafFiber.obj H ≅ Φ₀.sheafFiber.obj G₀ :=
      (e_stalk.app H).symm ≪≫ (Φ₀.sheafFiber (A := AddCommGrpCat.{u})).mapIso e₀
    exact CategoryTheory.Limits.IsZero.of_iso
      ((Φ₀.sheafFiber (A := AddCommGrpCat.{u})).map_isZero hZeroG₀) iso_H

  
  rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
  apply CategoryTheory.Sheaf.hom_ext
  ext E_op s
  let E : S.Etale := E_op.unop
  change s = (0 : H.obj.obj (Opposite.op E))
  let R_s : CategoryTheory.Sieve E :=
    { arrows := fun _ u => H.obj.map u.op s = 0
      downward_closed := fun {Y Z u} hu g => by
        change (H.obj.map (u.op ≫ g.op)) s = 0
        rw [H.obj.map_comp]
        change (H.obj.map g.op) ((H.obj.map u.op) s) = 0
        rw [hu, map_zero] }
  have hRs : R_s ∈ S.smallEtaleTopology E := by
    let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme := @AlgebraicGeometry.Etale
    have hEqTop : S.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P P).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P) (Q := P) S (le_refl P)
    rw [hEqTop]
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := P) (Q := P) (S := S) E R_s).mpr ?_
    intro z
    let Ω_z : Type u := AlgebraicClosure (E.left.residueField z)
    let S_Ωz := AlgebraicGeometry.Spec (CommRingCat.of Ω_z)
    let : Unique ↥S_Ωz := PrimeSpectrum.instUnique
    let z_bar : S_Ωz ⟶ E.left :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (E.left.residueField z) Ω_z)) ≫
        E.left.fromSpecResidueField z
    let x_z : S_Ωz ⟶ S := z_bar ≫ E.hom
    let Φ_z := pt S Ω_z x_z
    have hZero_z : CategoryTheory.Limits.IsZero (Φ_z.sheafFiber.obj H) := hStalkZero Ω_z x_z
    let pt_E : Φ_z.fiber.obj E := ⟨z_bar, rfl⟩
    have hto0 : Φ_z.toPresheafFiber E pt_E H.obj = 0 := hZero_z.eq_of_tgt _ 0
    have hrep_eq : (Φ_z.toPresheafFiber E pt_E H.obj) s =
        (Φ_z.toPresheafFiber E pt_E H.obj) 0 := by
      rw [hto0]
      rfl
    obtain ⟨E', u_z, pt_E', hu_pt, hu_sec⟩ :=
      (Φ_z.toPresheafFiber_eq_iff' E pt_E s (0 : H.obj.obj (Opposite.op E))).mp hrep_eq
    have hu_Rs : R_s.arrows u_z := by
      change H.obj.map u_z.op s = 0
      exact hu_sec.trans (map_zero _)
    have : AlgebraicGeometry.Etale E'.hom := E'.prop
    have : AlgebraicGeometry.Etale E.hom := E.prop
    have hu_P : P u_z.left := by
      refine CategoryTheory.MorphismProperty.of_postcomp P u_z.left E.hom E.prop ?_
      rw [CategoryTheory.MorphismProperty.Over.w u_z]
      exact E'.prop
    have hu_mor : pt_E'.1 ≫ u_z.left = z_bar := congrArg Subtype.val hu_pt
    let y₀ : ↥E'.left := pt_E'.1 default
    have hy₀ : u_z.left y₀ = z := by
      have h1 : u_z.left y₀ = z_bar default :=
        (AlgebraicGeometry.Scheme.Hom.comp_apply pt_E'.1 u_z.left default).symm.trans
          (congrArg (fun k : S_Ωz ⟶ E.left => k default) hu_mor)
      have h2 : z_bar default ∈ Set.range ⇑(E.left.fromSpecResidueField z) :=
        ⟨_, (AlgebraicGeometry.Scheme.Hom.comp_apply _ (E.left.fromSpecResidueField z) default).symm⟩
      rw [AlgebraicGeometry.Scheme.range_fromSpecResidueField z, Set.mem_singleton_iff] at h2
      exact h1.trans h2
    exact ⟨E', u_z, y₀, hu_Rs, hu_P, hy₀⟩
  refine H.isSeparated E R_s hRs s 0 ?_
  intro Y u hu
  change H.obj.map u.op s = H.obj.map u.op 0
  rw [map_zero]
  exact hu

theorem weil_etale_finite_geometric_fiber_h1_isZero (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType X.hom]
    (W : AlgebraicGeometry.Scheme.{u}) (g : W ⟶ X.left)
    (hg : AlgebraicGeometry.IsFinite g)
    (G : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
    (hTor : ℓ • CategoryTheory.CategoryStruct.id G = 0)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (x : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X.left) :
    ∃ (G₀ : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback x (weilEtaleHigherDirectImage g 1 G) G₀ ∧
      CategoryTheory.Limits.IsZero G₀ :=
by
  classical
  
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  have : AlgebraicGeometry.IsFinite g := hg
  have hProp_g : AlgebraicGeometry.IsProper g := inferInstance
  let W_x : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g x
  let g' : W_x ⟶ W := CategoryTheory.Limits.pullback.fst g x
  let f' : W_x ⟶ S_Ω := CategoryTheory.Limits.pullback.snd g x
  have hf' : AlgebraicGeometry.IsFinite f' := inferInstance
  let W_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (g ≫ X.hom)
  let S'_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (x ≫ X.hom)
  let X'_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (f' ≫ S'_ov.hom)
  let f_ov : W_ov ⟶ X := CategoryTheory.Over.homMk g rfl
  let g_ov : S'_ov ⟶ X := CategoryTheory.Over.homMk x rfl
  let f'_ov : X'_ov ⟶ S'_ov := CategoryTheory.Over.homMk f' rfl
  let g'_ov : X'_ov ⟶ W_ov := CategoryTheory.Over.homMk g' (by
    dsimp [X'_ov, S'_ov, W_ov]
    rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
      CategoryTheory.Category.assoc])
  
  have hMemEtale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) (R : CategoryTheory.Sieve U),
      R ∈ S.smallEtaleTopology U ↔
        ∀ (pt : ↥U.left), ∃ (V : S.Etale) (u : V ⟶ U) (v : ↥V.left),
          R.arrows u ∧ AlgebraicGeometry.Etale u.left ∧ u.left.base v = pt := by
    intro S U R
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have : P_et.IsStableUnderComposition :=
      ⟨fun _ _ hf₁ hf₂ => CategoryTheory.MorphismProperty.comp_mem P_et _ _ hf₁ hf₂⟩
    have hEq : S.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S
        (le_refl P_et)
    exact (iff_of_eq (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J U) hEq)).trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U R)
  
  have hPullEx : ∃ (G' : CategoryTheory.Sheaf W_x.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback g' G G' := by
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g' :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) g' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor W.Etale W_x.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g'
    have hCompat : CategoryTheory.CompatiblePreserving W_x.smallEtaleTopology B := by
      refine CategoryTheory.CompatiblePreserving.mk (fun ℱ {Z} {T} {x_fam} hx {Y₁ Y₂ X₀}
          f₁ f₂ {g₁ g₂} hg₁ hg₂ hf => ?_)
      let z_h : Z.left ⟶ W := Z.hom
      let y₁_h : Y₁.left ⟶ W := Y₁.hom
      let y₂_h : Y₂.left ⟶ W := Y₂.hom
      let x₀_h : X₀.left ⟶ W_x := X₀.hom
      have hEtZ : AlgebraicGeometry.Etale z_h := Z.prop
      have hEtY₁ : AlgebraicGeometry.Etale y₁_h := Y₁.prop
      have hEtY₂ : AlgebraicGeometry.Etale y₂_h := Y₂.prop
      let g₁_l : Y₁.left ⟶ Z.left := g₁.left
      let g₂_l : Y₂.left ⟶ Z.left := g₂.left
      have hg₁_w : g₁_l ≫ z_h = y₁_h := g₁.w
      have hg₂_w : g₂_l ≫ z_h = y₂_h := g₂.w
      have : AlgebraicGeometry.Etale g₂_l := by
        refine CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          g₂_l z_h hEtZ ?_
        rw [hg₂_w]
        exact hEtY₂
      let P_sch := CategoryTheory.Limits.pullback g₁_l g₂_l
      let pr₁ : P_sch ⟶ Y₁.left := CategoryTheory.Limits.pullback.fst g₁_l g₂_l
      let pr₂ : P_sch ⟶ Y₂.left := CategoryTheory.Limits.pullback.snd g₁_l g₂_l
      have : AlgebraicGeometry.Etale pr₁ := inferInstance
      have : AlgebraicGeometry.Etale y₁_h := hEtY₁
      have : AlgebraicGeometry.Etale (pr₁ ≫ y₁_h) := inferInstance
      let P_et : W.Etale := AlgebraicGeometry.Scheme.Etale.mk (pr₁ ≫ y₁_h)
      let p₁ : P_et ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk pr₁ rfl
      have hp₂_over : pr₂ ≫ Y₂.hom = P_et.hom := by
        change pr₂ ≫ y₂_h = pr₁ ≫ y₁_h
        rw [← hg₁_w, ← hg₂_w, ← CategoryTheory.Category.assoc,
          ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
      let p₂ : P_et ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk pr₂ hp₂_over
      have hp_comm : p₁ ≫ g₁ = p₂ ≫ g₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
      let f₁_l : X₀.left ⟶ CategoryTheory.Limits.pullback y₁_h g' := f₁.left
      let f₂_l : X₀.left ⟶ CategoryTheory.Limits.pullback y₂_h g' := f₂.left
      let bg₁_l : CategoryTheory.Limits.pullback y₁_h g' ⟶
          CategoryTheory.Limits.pullback z_h g' := (B.map g₁).left
      let bg₂_l : CategoryTheory.Limits.pullback y₂_h g' ⟶
          CategoryTheory.Limits.pullback z_h g' := (B.map g₂).left
      have hf₁_w : f₁_l ≫ CategoryTheory.Limits.pullback.snd y₁_h g' = x₀_h := f₁.w
      have hf₂_w : f₂_l ≫ CategoryTheory.Limits.pullback.snd y₂_h g' = x₀_h := f₂.w
      have hf_left : f₁_l ≫ bg₁_l = f₂_l ≫ bg₂_l :=
        congrArg (fun k : X₀ ⟶ B.obj Z => k.left) hf
      let a₁ : X₀.left ⟶ Y₁.left := f₁_l ≫ CategoryTheory.Limits.pullback.fst y₁_h g'
      let a₂ : X₀.left ⟶ Y₂.left := f₂_l ≫ CategoryTheory.Limits.pullback.fst y₂_h g'
      have ha_comm : a₁ ≫ g₁_l = a₂ ≫ g₂_l := by
        have hm₁ : bg₁_l ≫ CategoryTheory.Limits.pullback.fst z_h g' =
            CategoryTheory.Limits.pullback.fst y₁_h g' ≫ g₁_l :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hm₂ : bg₂_l ≫ CategoryTheory.Limits.pullback.fst z_h g' =
            CategoryTheory.Limits.pullback.fst y₂_h g' ≫ g₂_l :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        dsimp [a₁, a₂]
        rw [CategoryTheory.Category.assoc, ← hm₁, ← CategoryTheory.Category.assoc, hf_left,
          CategoryTheory.Category.assoc, hm₂, CategoryTheory.Category.assoc]
      let u_P : X₀.left ⟶ P_sch := CategoryTheory.Limits.pullback.lift a₁ a₂ ha_comm
      have hu_over : u_P ≫ (pr₁ ≫ y₁_h) = x₀_h ≫ g' := by
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
        dsimp [a₁]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          ← CategoryTheory.Category.assoc, hf₁_w]
      let ℓ_left : X₀.left ⟶ CategoryTheory.Limits.pullback (pr₁ ≫ y₁_h) g' :=
        CategoryTheory.Limits.pullback.lift u_P x₀_h hu_over
      have hℓ_over : ℓ_left ≫ (B.obj P_et).hom = X₀.hom :=
        CategoryTheory.Limits.pullback.lift_snd u_P x₀_h hu_over
      let ℓ_et : X₀ ⟶ B.obj P_et := CategoryTheory.MorphismProperty.Over.homMk ℓ_left hℓ_over
      let bp₁_l : CategoryTheory.Limits.pullback (pr₁ ≫ y₁_h) g' ⟶
          CategoryTheory.Limits.pullback y₁_h g' := (B.map p₁).left
      let bp₂_l : CategoryTheory.Limits.pullback (pr₁ ≫ y₁_h) g' ⟶
          CategoryTheory.Limits.pullback y₂_h g' := (B.map p₂).left
      have hℓ₁ : ℓ_et ≫ B.map p₁ = f₁ := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        change ℓ_left ≫ bp₁_l = f₁_l
        apply CategoryTheory.Limits.pullback.hom_ext
        · have hm : bp₁_l ≫ CategoryTheory.Limits.pullback.fst y₁_h g' =
              CategoryTheory.Limits.pullback.fst (pr₁ ≫ y₁_h) g' ≫ pr₁ :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          rw [CategoryTheory.Category.assoc, hm, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
        · have hm : bp₁_l ≫ CategoryTheory.Limits.pullback.snd y₁_h g' =
              CategoryTheory.Limits.pullback.snd (pr₁ ≫ y₁_h) g' :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          rw [CategoryTheory.Category.assoc, hm, CategoryTheory.Limits.pullback.lift_snd, hf₁_w]
      have hℓ₂ : ℓ_et ≫ B.map p₂ = f₂ := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        change ℓ_left ≫ bp₂_l = f₂_l
        apply CategoryTheory.Limits.pullback.hom_ext
        · have hm : bp₂_l ≫ CategoryTheory.Limits.pullback.fst y₂_h g' =
              CategoryTheory.Limits.pullback.fst (pr₁ ≫ y₁_h) g' ≫ pr₂ :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          rw [CategoryTheory.Category.assoc, hm, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_snd]
        · have hm : bp₂_l ≫ CategoryTheory.Limits.pullback.snd y₂_h g' =
              CategoryTheory.Limits.pullback.snd (pr₁ ≫ y₁_h) g' :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          rw [CategoryTheory.Category.assoc, hm, CategoryTheory.Limits.pullback.lift_snd, hf₂_w]
      have hx_eq := hx p₁ p₂ hg₁ hg₂ hp_comm
      dsimp at hx_eq
      rw [← hℓ₁, ← hℓ₂, CategoryTheory.op_comp, CategoryTheory.op_comp,
        ℱ.obj.map_comp, ℱ.obj.map_comp]
      exact congrArg (ℱ.obj.map ℓ_et.op) hx_eq
    have hCovPres : CategoryTheory.CoverPreserving W.smallEtaleTopology W_x.smallEtaleTopology B := by
      refine ⟨fun {U} {R} hR => ?_⟩
      rw [hMemEtale]
      intro pt
      let u_h : U.left ⟶ W := U.hom
      let fst_U : CategoryTheory.Limits.pullback u_h g' ⟶ U.left :=
        CategoryTheory.Limits.pullback.fst u_h g'
      let snd_U : CategoryTheory.Limits.pullback u_h g' ⟶ W_x :=
        CategoryTheory.Limits.pullback.snd u_h g'
      obtain ⟨V, u, v, huR, hEtu, hv⟩ := (hMemEtale W U R).mp hR (fst_U.base pt)
      let v_h : V.left ⟶ W := V.hom
      let u_l : V.left ⟶ U.left := u.left
      let fst_V : CategoryTheory.Limits.pullback v_h g' ⟶ V.left :=
        CategoryTheory.Limits.pullback.fst v_h g'
      let snd_V : CategoryTheory.Limits.pullback v_h g' ⟶ W_x :=
        CategoryTheory.Limits.pullback.snd v_h g'
      let bu_l : CategoryTheory.Limits.pullback v_h g' ⟶
          CategoryTheory.Limits.pullback u_h g' := (B.map u).left
      have hbu_fst : bu_l ≫ fst_U = fst_V ≫ u_l :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hbu_snd : bu_l ≫ snd_U = snd_V :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hu_w : u_l ≫ u_h = v_h := u.w
      have hPb_big : CategoryTheory.IsPullback (bu_l ≫ snd_U) fst_V g' (u_l ≫ u_h) := by
        rw [hbu_snd, hu_w]
        exact (CategoryTheory.IsPullback.of_hasPullback v_h g').flip
      have hPb_right : CategoryTheory.IsPullback snd_U fst_U g' u_h :=
        (CategoryTheory.IsPullback.of_hasPullback u_h g').flip
      have hPb_left : CategoryTheory.IsPullback bu_l fst_V fst_U u_l :=
        CategoryTheory.IsPullback.of_right hPb_big hbu_fst hPb_right
      have : AlgebraicGeometry.Etale u_l := hEtu
      have hEt_bu : AlgebraicGeometry.Etale bu_l :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_left.flip hEtu
      obtain ⟨z, hz, -⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_left pt v hv.symm
      exact ⟨B.obj V, B.map u, z,
        CategoryTheory.Sieve.image_mem_functorPushforward B R huR, hEt_bu, hz⟩
    have hCont : B.IsContinuous W.smallEtaleTopology W_x.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCovPres
    let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology W
    let ι_W : CategoryTheory.Functor W.AffineEtale W.Etale :=
      AlgebraicGeometry.Scheme.AffineEtale.Spec W
    let M_W := CategoryTheory.SmallModel.{u} W.AffineEtale
    let e_M : W.AffineEtale ≌ M_W := CategoryTheory.equivSmallModel W.AffineEtale
    let J_M : CategoryTheory.GrothendieckTopology M_W :=
      e_M.inverse.inducedTopology J_aff
    have : e_M.inverse.IsContinuous J_M J_aff := inferInstance
    have : (e_M.inverse.sheafPushforwardContinuous AddCommGrpCat.{u} J_M J_aff).IsEquivalence :=
      inferInstance
    have : ((e_M.inverse ⋙ ι_W).IsContinuous J_M W.smallEtaleTopology) :=
      CategoryTheory.Functor.isContinuous_comp e_M.inverse ι_W J_M J_aff W.smallEtaleTopology
    let F_eq := (e_M.inverse.sheafPushforwardContinuous AddCommGrpCat.{u} J_M J_aff)
    let G_eq := (ι_W.sheafPushforwardContinuous AddCommGrpCat.{u} J_aff W.smallEtaleTopology)
    let K_fun : M_W ⥤ W_x.Etale := (e_M.inverse ⋙ ι_W) ⋙ B
    have : K_fun.IsContinuous J_M W_x.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp (e_M.inverse ⋙ ι_W) B
        J_M W.smallEtaleTopology W_x.smallEtaleTopology
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u}
      W.smallEtaleTopology W_x.smallEtaleTopology
    let K_push := K_fun.sheafPushforwardContinuous AddCommGrpCat.{u}
      J_M W_x.smallEtaleTopology
    have : K_push.IsRightAdjoint := inferInstance
    let e_comp1 := CategoryTheory.Functor.sheafPushforwardContinuousComp
      e_M.inverse ι_W AddCommGrpCat.{u} J_M J_aff W.smallEtaleTopology
    let e_comp2 := CategoryTheory.Functor.sheafPushforwardContinuousComp
      (e_M.inverse ⋙ ι_W) B AddCommGrpCat.{u} J_M W.smallEtaleTopology W_x.smallEtaleTopology
    let Eq_aff : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u} ⥤
        CategoryTheory.Sheaf J_M AddCommGrpCat.{u} :=
      ((e_M.inverse ⋙ ι_W).sheafPushforwardContinuous AddCommGrpCat.{u} J_M W.smallEtaleTopology)
    have hEq_aff : Eq_aff.IsEquivalence := by
      have : (G_eq ⋙ F_eq).IsEquivalence := inferInstance
      exact CategoryTheory.Functor.isEquivalence_of_iso e_comp1
    let eqv := Eq_aff.asEquivalence
    have : eqv.inverse.IsRightAdjoint := inferInstance
    have : (K_push ⋙ eqv.inverse).IsRightAdjoint := inferInstance
    let e_iso : K_push ⋙ eqv.inverse ≅ P_push :=
      (CategoryTheory.Functor.isoWhiskerRight e_comp2.symm eqv.inverse).trans
        ((CategoryTheory.Functor.associator P_push eqv.functor eqv.inverse).trans
          ((CategoryTheory.Functor.isoWhiskerLeft P_push eqv.unitIso.symm).trans
            (CategoryTheory.Functor.rightUnitor P_push)))
    have hAdj : P_push.IsRightAdjoint :=
      CategoryTheory.Functor.isRightAdjoint_of_iso e_iso
    let G' := (B.sheafPullback AddCommGrpCat.{u}
      W.smallEtaleTopology W_x.smallEtaleTopology).obj G
    exact ⟨G', hCont, hAdj, ⟨CategoryTheory.Iso.refl G'⟩⟩
  obtain ⟨G', hPull_g'⟩ := hPullEx
  let G₀ := weilEtaleHigherDirectImage f' 1 G'
  have hPull_x : WeilIsEtaleSheafPullback x (weilEtaleHigherDirectImage g 1 G) G₀ :=
    hPBC W_ov X S'_ov X'_ov f_ov g_ov f'_ov g'_ov hProp_g
      (CategoryTheory.IsPullback.of_hasPullback g x) G G' hTor hPull_g' 1
  refine ⟨G₀, hPull_x, ?_⟩
  
  have hMkIdTerm : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (AlgebraicGeometry.Scheme.Etale.mk (𝟙 S)) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun V => CategoryTheory.MorphismProperty.Over.homMk V.hom
        (CategoryTheory.Category.comp_id V.hom)) ?_
    intro V m
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    let m_l : V.left ⟶ S := m.left
    let v_h : V.left ⟶ S := V.hom
    have hw : m_l ≫ 𝟙 S = v_h := m.w
    exact (CategoryTheory.Category.comp_id m_l).symm.trans hw
  
  have hSecΩ : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (p : Z ⟶ S_Ω),
      AlgebraicGeometry.Etale p → AlgebraicGeometry.Surjective p →
      ∃ σ : S_Ω ⟶ Z, σ ≫ p = 𝟙 S_Ω := by
    intro Z p hEtp hSurjp
    have : AlgebraicGeometry.Etale p := hEtp
    have : AlgebraicGeometry.Surjective p := hSurjp
    have hSing : CategoryTheory.Presieve.singleton p ∈
        (AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Etale)).coverings S_Ω :=
      (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff (@AlgebraicGeometry.Etale) p).mpr
        ⟨p.surjective, hEtp⟩
    have hCovP : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton p) ∈
        AlgebraicGeometry.Scheme.etaleTopology S_Ω :=
      CategoryTheory.Precoverage.generate_mem_toGrothendieck hSing
    let ptΩ := AlgebraicGeometry.Scheme.geometricFiber Ω
    obtain ⟨W₀, q, hq, y, hy⟩ := ptΩ.jointly_surjective _ hCovP (𝟙 S_Ω)
    rcases hq with ⟨Z', h, p', hp', rfl⟩
    cases hp'
    let y' : S_Ω ⟶ W₀ := y
    have hy' : y' ≫ (h ≫ p) = 𝟙 S_Ω := hy
    rw [← CategoryTheory.Category.assoc] at hy'
    exact ⟨y' ≫ h, hy'⟩
  
  have hTopPrinciple : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U₀ : S.Etale),
      (∀ R : CategoryTheory.Sieve U₀, R ∈ S.smallEtaleTopology U₀ → R = ⊤) →
      (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : ℱ₁ ⟶ ℱ₂) [CategoryTheory.Epi φ],
        Function.Surjective (φ.hom.app (Opposite.op U₀))) ∧
      (∀ (P : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}),
        Subsingleton ↥(P.obj (Opposite.op U₀)) →
        Subsingleton ↥(((CategoryTheory.presheafToSheaf S.smallEtaleTopology
