        (adj₂.homEquiv A (P_push.obj (C₁.obj A))).symm
          (adj₁.unit.app A ≫ (C₁.obj A).obj.map v₂₁.op)
      let ψ : j_pull.obj (C₂.obj A) ⟶ C₁.obj A :=
        (adj_sh.homEquiv (C₂.obj A) (C₁.obj A)).symm ψ₀
      have hθ_adj : adj₁.homEquiv A (j_pull.obj (C₂.obj A)) θ =
          adj₂.unit.app A ≫ (C₂.obj A).obj.map u₁₂.op :=
        (adj₁.homEquiv A (j_pull.obj (C₂.obj A))).apply_symm_apply _
      have hψ₀_adj : adj₂.homEquiv A (P_push.obj (C₁.obj A)) ψ₀ =
          adj₁.unit.app A ≫ (C₁.obj A).obj.map v₂₁.op :=
        (adj₂.homEquiv A (P_push.obj (C₁.obj A))).apply_symm_apply _
      let θ_T₁ : (C₁.obj A).obj.obj (Opposite.op T₁) ⟶
          (C₂.obj A).obj.obj (Opposite.op (Φ_h.obj T₁)) :=
        θ.hom.app (Opposite.op T₁)
      let ψ_T₁ : (C₂.obj A).obj.obj (Opposite.op (Φ_h.obj T₁)) ⟶
          (C₁.obj A).obj.obj (Opposite.op T₁) :=
        ψ.hom.app (Opposite.op T₁)
      let ψ₀_T₂ : (C₂.obj A).obj.obj (Opposite.op T₂) ⟶
          (C₁.obj A).obj.obj (Opposite.op (B_h.obj T₂)) :=
        ψ₀.hom.app (Opposite.op T₂)
      let θ_BT₂ : (C₁.obj A).obj.obj (Opposite.op (B_h.obj T₂)) ⟶
          (C₂.obj A).obj.obj (Opposite.op (Φ_h.obj (B_h.obj T₂))) :=
        θ.hom.app (Opposite.op (B_h.obj T₂))
      let ψ₀_ΦT₁ : (C₂.obj A).obj.obj (Opposite.op (Φ_h.obj T₁)) ⟶
          (C₁.obj A).obj.obj (Opposite.op (B_h.obj (Φ_h.obj T₁))) :=
