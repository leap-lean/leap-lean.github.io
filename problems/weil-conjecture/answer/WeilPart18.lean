    have hSurj₀ : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro p
      have hp1 : p.1 ∈ (1 : Submodule k (MvPolynomial (Fin 2) k)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero]
        exact p.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp1
      exact ⟨c, Subtype.ext hc⟩
    have hFT₀ : (algebraMap k ↥(𝒜 0)).FiniteType :=
      RingHom.FiniteType.of_surjective _ hSurj₀
    have : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT₀
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin 2) k) :=
      @IsScalarTower.of_algebraMap_eq k ↥(𝒜 0) (MvPolynomial (Fin 2) k) _ _ _ _ _ _
        (fun _ => rfl)
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin 2) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin 2) k)
    infer_instance
  have hLFT_pY₀ : AlgebraicGeometry.LocallyOfFiniteType p_Y₀ := by
    rw [← hπ₀_hom]
    infer_instance
  have : AlgebraicGeometry.LocallyOfFiniteType p_Y₀ := hLFT_pY₀

  
  obtain ⟨hPullEx, _, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  have hCompPull : ∀ {W₁ W₂ W₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : W₁ ⟶ W₂) (h₂ : W₂ ⟶ W₃) (m i : ℕ)
      (p₁ : weilEtaleTorsionH W₂ m i →+ weilEtaleTorsionH W₁ m i)
      (p₂ : weilEtaleTorsionH W₃ m i →+ weilEtaleTorsionH W₂ m i),
      WeilIsTorsionEtalePullback h₁ m i p₁ →
      WeilIsTorsionEtalePullback h₂ m i p₂ →
      WeilIsTorsionEtalePullback (h₁ ≫ h₂) m i (p₁.comp p₂) := by
    intro W₁ W₂ W₃ h₁ h₂ m i p₁ p₂ hp₁ hp₂
    obtain ⟨p₁₂, hp₁₂⟩ := hPullEx (h₁ ≫ h₂) m i
    have heq := hPullComp h₁ h₂ m i p₁ p₂ p₁₂ hp₁ hp₂ hp₁₂
    rwa [heq] at hp₁₂
  have hToTopDeg : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : W₁ ⟶ W₂) (m i : ℕ)
      (p : weilEtaleTorsionH W₂ m i →+ weilEtaleTorsionH W₁ m i),
      WeilIsTorsionEtalePullback h m i p → WeilTopDegTorsionPullback h m i p := by
    intro W₁ W₂ h m i p hp
    rcases hp with ⟨hCont, hAdj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, h1, h2, hEq⟩
    exact ⟨hCont, _, _, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, h1, h2, hEq⟩
  have hTorAnn : ∀ (W : AlgebraicGeometry.Scheme.{u}) (m i : ℕ)
      (x : weilEtaleTorsionH W m i), m • x = 0 := by
    intro W m i x
    let J := W.smallEtaleTopology
    let C_sh := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let Fℤ := C_sh.obj Aℤ
    let FM := C_sh.obj AM
    have : C_sh.Additive := inferInstance
    have hm_AM : m • (𝟙 AM) = 0 := by
      ext ⟨z⟩
      apply ULift.ext
      change m • z = 0
      simp
    have hm_FM : m • (𝟙 FM) = 0 := by
      rw [← C_sh.map_id, ← CategoryTheory.Functor.map_nsmul, hm_AM, C_sh.map_zero]
    have hmk₀_eq : ∀ f : FM ⟶ FM,
        CategoryTheory.Abelian.Ext.mk₀ f = CategoryTheory.Abelian.Ext.addEquiv₀.symm f := by
      intro f
      apply CategoryTheory.Abelian.Ext.addEquiv₀.injective
      rw [AddEquiv.apply_symm_apply]
      exact CategoryTheory.Abelian.Ext.addEquiv₀.right_inv f
    let post : (FM ⟶ FM) →+ (weilEtaleTorsionH W m i →+ weilEtaleTorsionH W m i) :=
      { toFun := fun f => (CategoryTheory.Abelian.Ext.mk₀ f).postcomp Fℤ (Nat.add_zero i)
        map_zero' := by
          ext y
          change y.comp (CategoryTheory.Abelian.Ext.mk₀ 0) (Nat.add_zero i) = 0
          rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
        map_add' := fun f g => by
          ext y
          change y.comp (CategoryTheory.Abelian.Ext.mk₀ (f + g)) (Nat.add_zero i) =
            y.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero i) +
            y.comp (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero i)
          rw [hmk₀_eq (f + g), hmk₀_eq f, hmk₀_eq g, map_add,
            CategoryTheory.Abelian.Ext.comp_add] }
    have hid : post (𝟙 FM) x = x := CategoryTheory.Abelian.Ext.comp_mk₀_id x
    calc m • x
        = m • (post (𝟙 FM) x) := by rw [hid]
      _ = (m • post (𝟙 FM)) x := rfl
      _ = post (m • 𝟙 FM) x := by rw [← map_nsmul post]
      _ = post 0 x := by rw [hm_FM]
      _ = 0 := by rw [map_zero]; rfl
  have hSurjBridge : ∀ {W₀ W : AlgebraicGeometry.Scheme.{u}} (h : W₀ ⟶ W) (m i : ℕ)
      (p : weilEtaleTorsionH W m i →+ weilEtaleTorsionH W₀ m i),
      WeilIsTorsionEtalePullback h m i p →
      Function.Surjective p →
      WeilEtaleCohomologyPullbackSurjective h (weilEtaleTorsionSheaf W m) i := by
    intro W₀ W h m i p hp hsurj
    let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp' hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp' hg)
    let B_h : CategoryTheory.Functor W.Etale W₀.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    let J₀ := W₀.smallEtaleTopology
    let J := W.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let C₀ := CategoryTheory.constantSheaf J₀ AddCommGrpCat.{u}
    let C_W := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Fℤ_W := C_W.obj Aℤ
    let Fℤ_W₀ := C₀.obj Aℤ
    let FM_W := C_W.obj AM
    let FM_W₀ := C₀.obj AM
    rcases hp with ⟨hCont, hAdj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπℤ, hπιℤ, hp_eq⟩
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J J₀
    let pb_h := B_h.sheafPullback AddCommGrpCat.{u} J J₀
    let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} J J₀
    refine ⟨hCont, hAdj, hAdd, hLim, hColim, ?_⟩
    let Pℤ_W := (CategoryTheory.Functor.const (Opposite W.Etale)).obj Aℤ
    let Pℤ_W₀ := (CategoryTheory.Functor.const (Opposite W₀.Etale)).obj Aℤ
    let shAdj₀ := CategoryTheory.sheafificationAdjunction J₀ AddCommGrpCat.{u}
    let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let η₀ := CategoryTheory.Functor.whiskerLeft B_h.op (shAdj₀.unit.app Pℤ_W₀)
    let e_sh : (Fℤ_W ⟶ pf_h.obj Fℤ_W₀) ≃
        (Pℤ_W ⟶ (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).obj (pf_h.obj Fℤ_W₀)) :=
      shAdj.homEquiv Pℤ_W (pf_h.obj Fℤ_W₀)
    let uℤ : Fℤ_W ⟶ pf_h.obj Fℤ_W₀ := e_sh.symm η₀
    let cℤ := (adj_h.homEquiv Fℤ_W Fℤ_W₀).symm uℤ
    let adj₁ := CategoryTheory.constantSheafAdj J₀ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₂
    let τ : B_h.obj T₂ ⟶ T₁ := hT₁.from (B_h.obj T₂)
    let g₀ : Aℤ ⟶ ((CategoryTheory.sheafSections J AddCommGrpCat.{u}).obj
        (Opposite.op T₂)).obj (pf_h.obj Fℤ_W₀) :=
      CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ) (Fℤ_W₀.obj.map τ.op)
    let wℤ : Fℤ_W ⟶ pf_h.obj Fℤ_W₀ := (adj₂.homEquiv Aℤ (pf_h.obj Fℤ_W₀)).symm g₀
    let πℤ : pb_h.obj Fℤ_W ⟶ Fℤ_W₀ := (adj_h.homEquiv Fℤ_W Fℤ_W₀).symm wℤ
    let πM : pb_h.obj FM_W ⟶ FM_W₀ :=
      (adj_h.homEquiv FM_W FM_W₀).symm
        ((adj₂.homEquiv AM (pf_h.obj FM_W₀)).symm
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM) (FM_W₀.obj.map τ.op)))
    have hu_eq_w : uℤ = wℤ := by
      refine e_sh.injective ((e_sh.apply_symm_apply η₀).trans ?_)
      have hsh_w : e_sh wℤ =
          shAdj.unit.app Pℤ_W ≫ (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map wℤ :=
        CategoryTheory.Adjunction.homEquiv_unit shAdj Pℤ_W (pf_h.obj Fℤ_W₀) wℤ
      refine hsh_w.symm ▸ ?_
      have hw_eval : (shAdj.unit.app Pℤ_W).app (Opposite.op T₂) ≫ wℤ.hom.app (Opposite.op T₂) =
          (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) ≫ Fℤ_W₀.obj.map τ.op := by
        have hw0 : (adj₂.homEquiv Aℤ (pf_h.obj Fℤ_W₀)) wℤ = g₀ :=
          (adj₂.homEquiv Aℤ (pf_h.obj Fℤ_W₀)).apply_symm_apply g₀
        have hw1 : (adj₂.homEquiv Aℤ (pf_h.obj Fℤ_W₀)) wℤ =
            adj₂.unit.app Aℤ ≫ wℤ.hom.app (Opposite.op T₂) :=
          CategoryTheory.Adjunction.homEquiv_unit adj₂ Aℤ (pf_h.obj Fℤ_W₀) wℤ
        have hadj₂_u : adj₂.unit.app Aℤ = (shAdj.unit.app Pℤ_W).app (Opposite.op T₂) :=
          CategoryTheory.Category.id_comp _
        have hadj₁_u : adj₁.unit.app Aℤ = (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) :=
          CategoryTheory.Category.id_comp _
        have hg0 : g₀ = (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) ≫ Fℤ_W₀.obj.map τ.op := by
          dsimp only [g₀]
          rw [hadj₁_u]
          rfl
        exact (congrArg (· ≫ wℤ.hom.app (Opposite.op T₂)) hadj₂_u.symm).trans
          (hw1.symm.trans (hw0.trans hg0))
      apply CategoryTheory.NatTrans.ext
      funext V
      let v_hom : V.unop ⟶ T₂ := hT₂.from V.unop
      have hA_step : (shAdj.unit.app Pℤ_W).app V =
          (shAdj.unit.app Pℤ_W).app (Opposite.op T₂) ≫ Fℤ_W.obj.map v_hom.op :=
        (CategoryTheory.Category.id_comp _).symm.trans
          ((shAdj.unit.app Pℤ_W).naturality v_hom.op)
      have hB_step : Fℤ_W.obj.map v_hom.op ≫ wℤ.hom.app V =
          wℤ.hom.app (Opposite.op T₂) ≫ Fℤ_W₀.obj.map (B_h.map v_hom).op :=
        wℤ.hom.naturality v_hom.op
      have hE_step : (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op (B_h.obj V.unop)) =
          (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) ≫
            Fℤ_W₀.obj.map (B_h.map v_hom ≫ τ).op :=
        (CategoryTheory.Category.id_comp _).symm.trans
          ((shAdj₀.unit.app Pℤ_W₀).naturality (B_h.map v_hom ≫ τ).op)
      let M_hom := Aℤ ⟶ Fℤ_W₀.obj.obj (Opposite.op (B_h.obj V.unop))
      let m₀ : M_hom := (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op (B_h.obj V.unop))
      let m₁ : M_hom := (shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) ≫
        Fℤ_W₀.obj.map (B_h.map v_hom ≫ τ).op
      let m₂ : M_hom := ((shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) ≫ Fℤ_W₀.obj.map τ.op) ≫
        Fℤ_W₀.obj.map (B_h.map v_hom).op
      let m₃ : M_hom := ((shAdj.unit.app Pℤ_W).app (Opposite.op T₂) ≫
        wℤ.hom.app (Opposite.op T₂)) ≫ Fℤ_W₀.obj.map (B_h.map v_hom).op
      let m₄ : M_hom := (shAdj.unit.app Pℤ_W).app (Opposite.op T₂) ≫
        (Fℤ_W.obj.map v_hom.op ≫ wℤ.hom.app V)
      let m₅ : M_hom := (shAdj.unit.app Pℤ_W).app V ≫ wℤ.hom.app V
      have hm₀₁ : m₀ = m₁ := hE_step
      have hm₁₂ : m₁ = m₂ :=
        (congrArg ((shAdj₀.unit.app Pℤ_W₀).app (Opposite.op T₁) ≫ ·)
          ((congrArg Fℤ_W₀.obj.map
              (op_comp : (B_h.map v_hom ≫ τ).op = τ.op ≫ (B_h.map v_hom).op)).trans
            (Fℤ_W₀.obj.map_comp τ.op (B_h.map v_hom).op))).trans
          (CategoryTheory.Category.assoc _ _ _).symm
      have hm₂₃ : m₂ = m₃ :=
        congrArg (fun f : Aℤ ⟶ Fℤ_W₀.obj.obj (Opposite.op (B_h.obj T₂)) =>
          f ≫ Fℤ_W₀.obj.map (B_h.map v_hom).op) hw_eval.symm
      have hm₃₄ : m₃ = m₄ :=
        (CategoryTheory.Category.assoc _ _ _).trans
          (congrArg ((shAdj.unit.app Pℤ_W).app (Opposite.op T₂) ≫ ·) hB_step.symm)
      have hm₄₅ : m₄ = m₅ :=
        (CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ wℤ.hom.app V) hA_step.symm)
      exact hm₀₁.trans (hm₁₂.trans (hm₂₃.trans (hm₃₄.trans hm₄₅)))
    have hcℤ_eq : cℤ = πℤ := congrArg (adj_h.homEquiv Fℤ_W Fℤ_W₀).symm hu_eq_w
    have hcℤ : CategoryTheory.IsIso cℤ := by
      rw [hcℤ_eq]
      exact ⟨⟨ιℤ, hπιℤ, hιπℤ⟩⟩
    refine ⟨hcℤ, ?_⟩
    have hinv_cℤ : @CategoryTheory.inv _ _ _ _ cℤ hcℤ = ιℤ :=
      (@CategoryTheory.IsIso.eq_inv_of_hom_inv_id _ _ _ _ cℤ hcℤ ιℤ
        (by rw [hcℤ_eq]; exact hπιℤ)).symm
    let Fgt₀ := AlgebraicGeometry.Scheme.Etale.forget W₀
    have : CategoryTheory.Limits.PreservesLimits (CategoryTheory.Over.pullback h) :=
      (CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits
    have : CategoryTheory.Limits.PreservesFiniteLimits (B_h ⋙ Fgt₀) := by
      change CategoryTheory.Limits.PreservesFiniteLimits
        (AlgebraicGeometry.Scheme.Etale.forget W ⋙ CategoryTheory.Over.pullback h)
      infer_instance
    have : CategoryTheory.Limits.PreservesFiniteLimits B_h :=
      CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves B_h Fgt₀
    have hBT₂ : CategoryTheory.Limits.IsTerminal (B_h.obj T₂) :=
      CategoryTheory.Limits.IsTerminal.isTerminalObj B_h T₂ hT₂
    let τ_iso : B_h.obj T₂ ≅ T₁ :=
      { hom := τ
        inv := hBT₂.from T₁
        hom_inv_id := hBT₂.hom_ext _ _
        inv_hom_id := hT₁.hom_ext _ _ }
    let θ_τ : (CategoryTheory.sheafSections J₀ AddCommGrpCat.{u}).obj (Opposite.op T₁) ≅
        pf_h ⋙ (CategoryTheory.sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T₂) :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ =>
          { hom := ℱ.obj.map τ_iso.hom.op
            inv := ℱ.obj.map τ_iso.inv.op
            hom_inv_id := by
              change ℱ.obj.map τ_iso.hom.op ≫ ℱ.obj.map τ_iso.inv.op = 𝟙 _
              rw [← CategoryTheory.Functor.map_comp, ← op_comp, τ_iso.inv_hom_id, op_id,
                CategoryTheory.Functor.map_id]
            inv_hom_id := by
              change ℱ.obj.map τ_iso.inv.op ≫ ℱ.obj.map τ_iso.hom.op = 𝟙 _
              rw [← CategoryTheory.Functor.map_comp, ← op_comp, τ_iso.hom_inv_id, op_id,
                CategoryTheory.Functor.map_id] })
        (fun u => (u.hom.naturality τ_iso.hom.op).symm)
    let adj_comp := adj₂.comp adj_h
    let α_iso : C_W ⋙ pb_h ≅ C₀ :=
      adj_comp.leftAdjointUniq (adj₁.ofNatIsoRight θ_τ)
    have hπM_eq : πM = α_iso.hom.app AM := by
      apply (adj_comp.homEquiv AM FM_W₀).injective
      rw [CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app]
      have hpi : πM = (adj_comp.homEquiv AM FM_W₀).symm
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM) (FM_W₀.obj.map τ_iso.hom.op)) := by
        dsimp only [πM, adj_comp, τ_iso]
        rw [CategoryTheory.Adjunction.comp_homEquiv]
        rfl
      rw [hpi, Equiv.apply_symm_apply]
      rfl
    let ιM : FM_W₀ ⟶ pb_h.obj FM_W := α_iso.inv.app AM
    have hπιM : πM ≫ ιM = 𝟙 (pb_h.obj FM_W) := by
      rw [hπM_eq]
      exact α_iso.hom_inv_id_app AM
    change Function.Surjective (fun (x : weilEtaleTorsionH W m i) =>
      (CategoryTheory.Abelian.Ext.mk₀ (@CategoryTheory.inv _ _ _ _ cℤ hcℤ)).precomp
        (pb_h.obj FM_W) (Nat.zero_add i)
        ((pb_h.mapExtAddHom Fℤ_W FM_W i) x))
    intro y
    obtain ⟨x, hx⟩ := hsurj ((CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ_W₀ (Nat.add_zero i) y)
    refine ⟨x, ?_⟩
    let lhs := (CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp (pb_h.obj FM_W) (Nat.zero_add i)
      ((pb_h.mapExtAddHom Fℤ_W FM_W i) x)
    have hgoal_eq :
        (CategoryTheory.Abelian.Ext.mk₀ (@CategoryTheory.inv _ _ _ _ cℤ hcℤ)).precomp
          (pb_h.obj FM_W) (Nat.zero_add i)
          ((pb_h.mapExtAddHom Fℤ_W FM_W i) x) = lhs :=
      congrArg (fun f =>
        (CategoryTheory.Abelian.Ext.mk₀ f).precomp (pb_h.obj FM_W) (Nat.zero_add i)
          ((pb_h.mapExtAddHom Fℤ_W FM_W i) x)) hinv_cℤ
    have hp_lhs : p x = (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ_W₀ (Nat.add_zero i) lhs :=
      hp_eq x
    have hx' :
        (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ_W₀ (Nat.add_zero i) lhs =
          (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ_W₀ (Nat.add_zero i) y :=
      hp_lhs.symm.trans hx
    have hcancel : ∀ z : CategoryTheory.Abelian.Ext Fℤ_W₀ (pb_h.obj FM_W) i,
        (CategoryTheory.Abelian.Ext.mk₀ ιM).postcomp Fℤ_W₀ (Nat.add_zero i)
          ((CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ_W₀ (Nat.add_zero i) z) = z := by
      intro z
      change (z.comp (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero i)).comp
        (CategoryTheory.Abelian.Ext.mk₀ ιM) (Nat.add_zero i) = z
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ rfl,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hπιM,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
    exact hgoal_eq.trans ((hcancel lhs).symm.trans
      ((congrArg ((CategoryTheory.Abelian.Ext.mk₀ ιM).postcomp Fℤ_W₀ (Nat.add_zero i)) hx').trans
        (hcancel y)))

  
  obtain ⟨p_iY, hp_iY⟩ := hPullEx i_Y ℓ q
  refine hSurjBridge i_Y ℓ q p_iY hp_iY ?_
  obtain ⟨r, C, Z, ι_Z, ν, V_comp, hComp, hDisj, hBadFin, hBadCl⟩ :=
    weil_projLine_special_fiber_curve_normalization k Y₀ p_Y₀ π₀ hπ₀_hom
  have hφ_ex : ∀ c : Fin r,
      ∃ φ_c : weilEtaleTorsionH Y₀ ℓ q →+ weilEtaleTorsionH (C c).left ℓ q,
        WeilIsTorsionEtalePullback (ν c ≫ ι_Z c) ℓ q φ_c :=
    fun c => hPullEx (ν c ≫ ι_Z c) ℓ q
  choose φ hφ_et using hφ_ex
  have hφ_top : ∀ c : Fin r, WeilTopDegTorsionPullback (ν c ≫ ι_Z c) ℓ q (φ c) :=
    fun c => hToTopDeg (ν c ≫ ι_Z c) ℓ q (φ c) (hφ_et c)
  have hΦ_bij : Function.Bijective (fun (x : weilEtaleTorsionH Y₀ ℓ q) (c : Fin r) => φ c x) :=
    weil_etale_one_dim_curve_normalization_cohomology_iso k ℓ Y₀ p_Y₀ r C Z ι_Z ν V_comp
      (fun c => by
        rcases hComp c with
          ⟨_, _, _, _, hClZ, hFinν, _, hHomC, _, hSurjι, hIsoν⟩
        exact ⟨hClZ, hFinν, hHomC, hSurjι, hIsoν⟩)
      (fun c₁ c₂ hne => (hDisj c₁ c₂ hne).2)
      hBadFin hBadCl q hq φ hφ_top

  
  by_cases hq2 : q = 2
  · subst hq2
    intro y₀
    have hZModBasis : ∀ {H : Type u} [AddCommGroup H] [Finite H],
        Nat.card H = ℓ →
        (∀ w : H, ℓ • w = 0) →
        ∀ (v : H), v ≠ 0 → ∀ (w₀ : H), ∃ a : ZMod ℓ, a.val • v = w₀ := by
      intro H _ _ hcard hTor v hv w₀
      have hPrime : Nat.Prime ℓ := Fact.out
      have : Fact (1 < ℓ) := ⟨hPrime.one_lt⟩
      have hmod : ∀ n : ℕ, (n % ℓ) • v = n • v := by
        intro n
        conv_rhs => rw [← Nat.div_add_mod n ℓ]
        rw [add_nsmul, mul_comm, mul_nsmul', hTor v, smul_zero, zero_add]
      let μ : ZMod ℓ → H := fun a => a.val • v
      have hμ_inj : Function.Injective μ := by
        intro a b hab
        by_contra hne
        let d : ZMod ℓ := a - b
        have hd_ne : d ≠ 0 := sub_ne_zero.mpr hne
        have ha_eq : a = d + b := (sub_add_cancel a b).symm
        have hval_a : a.val = (d.val + b.val) % ℓ := by
          rw [ha_eq, ZMod.val_add]
        have hd_zero : d.val • v = 0 := by
          have h1 : d.val • v + b.val • v = 0 + b.val • v := by
            rw [zero_add, ← add_nsmul, ← hmod, ← hval_a]
            exact hab
          exact add_right_cancel h1
        have hinv_mul : d⁻¹ * d = 1 := inv_mul_cancel₀ hd_ne
        have hval_one : (d⁻¹.val * d.val) % ℓ = 1 := by
          rw [← ZMod.val_mul, hinv_mul, ZMod.val_one]
        have hv0 : v = 0 := by
          calc v = 1 • v := (one_nsmul v).symm
            _ = ((d⁻¹.val * d.val) % ℓ) • v := by rw [hval_one]
            _ = (d⁻¹.val * d.val) • v := hmod _
            _ = d⁻¹.val • (d.val • v) := mul_nsmul' v d⁻¹.val d.val
            _ = d⁻¹.val • 0 := by rw [hd_zero]
            _ = 0 := smul_zero _
        exact hv hv0
      letI : Fintype H := Fintype.ofFinite H
      have : NeZero ℓ := ⟨hPrime.ne_zero⟩
      have hcard_fin : Fintype.card (ZMod ℓ) = Fintype.card H := by
        rw [ZMod.card ℓ, ← Nat.card_eq_fintype_card, hcard]
      exact ((Fintype.bijective_iff_injective_and_card μ).mpr ⟨hμ_inj, hcard_fin⟩).2 w₀
    have hComp_et : ∀ c' : Fin r,
        WeilTopDegTorsionPullback ((ν c' ≫ ι_Z c') ≫ i_Y) ℓ 2 ((φ c').comp p_iY) :=
      fun c' => hToTopDeg _ ℓ 2 _
        (hCompPull (ν c' ≫ ι_Z c') i_Y ℓ 2 (φ c') p_iY (hφ_et c') hp_iY)
    have hOver_k : ∀ c' : Fin r, ((ν c' ≫ ι_Z c') ≫ i_Y) ≫ f_Y_k = (C c').hom := by
      intro c'
      rcases hComp c' with ⟨_, _, _, _, _, _, _, hHomC', _⟩
      rw [CategoryTheory.Category.assoc, hiY_fk, hHomC']
    have hBasis : ∀ c : Fin r,
        ∃ (α_c : weilEtaleTorsionH Y ℓ 2) (n_c : ℕ),
          n_c • φ c (p_iY α_c) = φ c y₀ ∧
          ∀ c' : Fin r, c' ≠ c → φ c' (p_iY α_c) = 0 := by
      intro c
      rcases hComp c with
        ⟨hIntC, hProjC, hSmC, hIntZ, hClZ, hFinν, hSurjν, hHomC, hVne, hSurjι, hIsoν⟩
      haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 (C c).hom := hSmC
      haveI : AlgebraicGeometry.IsFinite (ν c) := hFinν
      obtain ⟨P_c, U₁, U₂, g_sec, hP_mem, hP_cl, hy_mem, hcov, hu_sec, hU₂_Y₀, hU₂_Cc, hSpan⟩ :=
        weil_projLine_henselian_smooth_point_two_open_lift k A τ_A hA Y π
          (C c) hIntC hProjC (Z c) hIntZ (ι_Z c) hClZ (ν c) hSurjν hHomC
          (V_comp c) hVne hSurjι hIsoν
      let u₁₂ : Units ↑(Y.presheaf.obj (Opposite.op (U₁ ⊓ U₂))) := IsUnit.unit hu_sec
      have hu₁₂_coe :
          (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g_sec =
            (u₁₂ : ↑(Y.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))) :=
        (IsUnit.unit_spec hu_sec).symm
      obtain ⟨α_c, hVan, hNonvan⟩ :=
        weil_etale_two_open_unit_kummer_class_and_curve_point_nonvanishing
          k ℓ hℓ Y f_Y_k U₁ U₂ hcov u₁₂
      have hNonzero_c : φ c (p_iY α_c) ≠ 0 := by
        change ((φ c).comp p_iY) α_c ≠ 0
        exact hNonvan (C c) hIntC hProjC ((ν c ≫ ι_Z c) ≫ i_Y) (hOver_k c)
          ((φ c).comp p_iY) (hComp_et c) P_c hP_cl hP_mem g_sec hu₁₂_coe hU₂_Cc hSpan
      have hZero_other : ∀ c' : Fin r, c' ≠ c → φ c' (p_iY α_c) = 0 := by
        intro c' hc'
        change ((φ c').comp p_iY) α_c = 0
        apply hVan (C c').left (C c').hom ((ν c' ≫ ι_Z c') ≫ i_Y) (hOver_k c')
          ((φ c').comp p_iY) (hComp_et c')
        rw [TopologicalSpace.Opens.ext_iff]
        ext z
        simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        have hz_mem_range : ((ν c' ≫ ι_Z c').base z : ↥Y₀) ∈ Set.range (ι_Z c').base :=
          ⟨(ν c').base z, (AlgebraicGeometry.Scheme.Hom.comp_apply _ _ z).symm⟩
        have hz_not_Vc : ((ν c' ≫ ι_Z c').base z : ↥Y₀) ∉ (V_comp c : Set ↥Y₀) :=
          Set.disjoint_left.mp (hDisj c' c hc').2 hz_mem_range
        have hz_ne_yc : (ν c' ≫ ι_Z c').base z ≠ (ν c ≫ ι_Z c).base P_c := by
          intro h_eq
          apply hz_not_Vc
          rw [h_eq]
          exact hy_mem
        have hz_in_U₂Y₀ :
            (ν c' ≫ ι_Z c').base z ∈ ((TopologicalSpace.Opens.map i_Y.base).obj U₂ : Set ↥Y₀) := by
          rw [hU₂_Y₀]
          exact hz_ne_yc
        change (((ν c' ≫ ι_Z c') ≫ i_Y).base z) ∈ U₂
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
        exact hz_in_U₂Y₀
      obtain ⟨hFinH, _, _, hCard2⟩ :=
        weil_etale_smooth_proj_curve_mod_prime_cohomology k (C c) hIntC hProjC ℓ hℓ
      haveI : Finite (weilEtaleTorsionH (C c).left ℓ 2) := hFinH 2
      obtain ⟨a_c, ha_c⟩ :=
        hZModBasis hCard2 (hTorAnn (C c).left ℓ 2) (φ c (p_iY α_c)) hNonzero_c (φ c y₀)
      exact ⟨α_c, a_c.val, ha_c, hZero_other⟩
    choose α_vec n_vec hn_diag hn_off using hBasis
    refine ⟨∑ c : Fin r, n_vec c • α_vec c, hΦ_bij.1 ?_⟩
    funext c₀
    change φ c₀ (p_iY (∑ c : Fin r, n_vec c • α_vec c)) = φ c₀ y₀
    rw [map_sum, map_sum, Finset.sum_eq_single c₀]
    · rw [map_nsmul, map_nsmul, hn_diag c₀]
    · intro c _ hc_ne
      rw [map_nsmul, map_nsmul, hn_off c c₀ hc_ne.symm, smul_zero]
    · intro hc₀
      exact absurd (Finset.mem_univ c₀) hc₀
  · have hq3 : 3 ≤ q := by omega
    intro y₀
    refine ⟨0, hΦ_bij.1 ?_⟩
    funext c
    rcases hComp c with ⟨hIntC, hProjC, hSmC, _⟩
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 (C c).hom := hSmC
    haveI : Subsingleton (weilEtaleTorsionH (C c).left ℓ q) :=
      (weil_etale_smooth_proj_curve_mod_prime_cohomology k (C c) hIntC hProjC ℓ hℓ).2.1 q hq3
    exact Subsingleton.elim _ _

theorem weil_pbc_projLine_over_affine_finiteType (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType B.hom]
    [AlgebraicGeometry.IsAffine B.left] :
    WeilCanonicalModPrimePBC ℓ
      (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 1).hom) :=
by
  apply weil_pbc_projLine_strict_local_stalk_reduction k ℓ B
  intro A _ _ τ_A hA F q hF_tor
  refine weil_pbc_projLine_constructible_finite_cover_devissage k ℓ A τ_A hA ?_ F q hF_tor
  intro Y π _
  refine ⟨weil_pbc_projLine_finite_cover_deg_zero_bijective k ℓ A τ_A hA Y π, ?_⟩
  intro q₀ hq₀
  by_cases h1 : q₀ = 1
  · subst h1
    exact weil_pbc_projLine_finite_cover_deg_one_surjective k ℓ hℓ A τ_A hA Y π
  · have h2 : 2 ≤ q₀ := by omega
    exact weil_pbc_projLine_finite_cover_deg_ge_two_surjective k ℓ hℓ A τ_A hA Y π q₀ h2

theorem weil_etale_proper_base_change_mod_prime (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0) :
    WeilProperModPrimeBaseChangeHolds k ℓ :=
by
  obtain ⟨hExtract, hComp, hCancel, hAffineLoc, hArrowIso⟩ :=
    weil_pbc_canonical_calculus_and_extraction.{u} ℓ
  obtain ⟨hIsoP0, hVieta⟩ := weil_vieta_binary_form_cover_projSpace k
  have hLFT_Proj : ∀ (N : ℕ),
      AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
    intro N
    dsimp [weilProjectiveSpaceOver]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hSurj₀ : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro p
      have hp1 : p.1 ∈ (1 : Submodule k (MvPolynomial (Fin (N + 1)) k)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero]
        exact p.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp1
      exact ⟨c, Subtype.ext hc⟩
    have hFT₀ : (algebraMap k ↥(𝒜 0)).FiniteType :=
      RingHom.FiniteType.of_surjective _ hSurj₀
    have hSpec₀ : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT₀
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      @IsScalarTower.of_algebraMap_eq k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) _ _ _ _ _ _
        (fun _ => rfl)
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hProj₀ : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      inferInstance
    exact inferInstance
  have hProjSpace : ∀ (N : ℕ)
      (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType B.hom],
      WeilCanonicalModPrimePBC ℓ
        (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k N).hom) := by
    intro N
    induction N with
    | zero =>
      intro B _
      have : CategoryTheory.IsIso (weilProjectiveSpaceOver k 0).hom := hIsoP0
      let p₀ := CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 0).hom
      have : CategoryTheory.IsIso p₀ := inferInstance
      have : AlgebraicGeometry.IsFinite p₀ := inferInstance
      exact weil_pbc_finite_morphism ℓ p₀
    | succ m ih =>
      intro B _
      let P_m := weilProjectiveSpaceOver k m
      let P_1 := weilProjectiveSpaceOver k 1
      let P_succ := weilProjectiveSpaceOver k (m + 1)
      let p_mB := CategoryTheory.Limits.pullback.fst B.hom P_m.hom
      have : AlgebraicGeometry.LocallyOfFiniteType P_m.hom := hLFT_Proj m
      have : AlgebraicGeometry.LocallyOfFiniteType p_mB := inferInstance
      let B_m : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (p_mB ≫ B.hom)
      have : AlgebraicGeometry.LocallyOfFiniteType B_m.hom := by
        dsimp [B_m]
        infer_instance
      let p_1Bm := CategoryTheory.Limits.pullback.fst B_m.hom P_1.hom
      have hPBC_1Bm : WeilCanonicalModPrimePBC ℓ p_1Bm := by
        apply hAffineLoc
        intro U hU
        let B_U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
          CategoryTheory.Over.mk (U.ι ≫ B_m.hom)
        have : AlgebraicGeometry.IsAffine B_U.left := hU
        have : AlgebraicGeometry.LocallyOfFiniteType B_U.hom := by
          dsimp [B_U]
          infer_instance
        have hBU : WeilCanonicalModPrimePBC ℓ
            (CategoryTheory.Limits.pullback.fst B_U.hom P_1.hom) :=
          weil_pbc_projLine_over_affine_finiteType k ℓ hℓ B_U
        have hpb_res : CategoryTheory.IsPullback
            (p_1Bm ∣_ U)
            ((p_1Bm ⁻¹ᵁ U).ι ≫ CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom)
            B_U.hom P_1.hom :=
          (AlgebraicGeometry.isPullback_morphismRestrict p_1Bm U).paste_vert
            (CategoryTheory.IsPullback.of_hasPullback B_m.hom P_1.hom)
        refine hArrowIso (p_1Bm ∣_ U)
          (CategoryTheory.Limits.pullback.fst B_U.hom P_1.hom)
          hpb_res.isoPullback (CategoryTheory.Iso.refl _) ?_ hBU
        rw [hpb_res.isoPullback_hom_fst, CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
      have hPBC_mB : WeilCanonicalModPrimePBC ℓ p_mB := ih B
      have hPBC_tower : WeilCanonicalModPrimePBC ℓ (p_1Bm ≫ p_mB) :=
        hComp p_1Bm p_mB hPBC_1Bm hPBC_mB
      obtain ⟨μ, hFin_μ, hSurj_μ, hw_μ⟩ := hVieta m
      let P_m1_hom := CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom ≫ P_m.hom
      let μ_B : CategoryTheory.Limits.pullback B.hom P_m1_hom ⟶
          CategoryTheory.Limits.pullback B.hom P_succ.hom :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst B.hom P_m1_hom)
          (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom ≫ μ)
          (by rw [CategoryTheory.Category.assoc, hw_μ, CategoryTheory.Limits.pullback.condition])
      have hμ_fst : μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom =
          CategoryTheory.Limits.pullback.fst B.hom P_m1_hom :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hμ_snd : μ_B ≫ CategoryTheory.Limits.pullback.snd B.hom P_succ.hom =
          CategoryTheory.Limits.pullback.snd B.hom P_m1_hom ≫ μ :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hpb_μB : CategoryTheory.IsPullback
          μ_B
          (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom)
          (CategoryTheory.Limits.pullback.snd B.hom P_succ.hom)
          μ := by
        refine CategoryTheory.IsPullback.of_right ?_ hμ_snd
          (CategoryTheory.IsPullback.of_hasPullback B.hom P_succ.hom)
        rw [hμ_fst]
        have h_outer : CategoryTheory.IsPullback
            (CategoryTheory.Limits.pullback.fst B.hom P_m1_hom)
            (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom)
            B.hom (μ ≫ P_succ.hom) := by
          rw [hw_μ]
          exact CategoryTheory.IsPullback.of_hasPullback B.hom P_m1_hom
        exact h_outer
      have : AlgebraicGeometry.IsFinite μ_B :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_μB.flip hFin_μ
      have hSurj_μB : AlgebraicGeometry.Surjective μ_B :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_μB.flip hSurj_μ
      have hPBC_μB : WeilCanonicalModPrimePBC ℓ μ_B :=
        weil_pbc_finite_morphism ℓ μ_B
      let α : CategoryTheory.Limits.pullback B_m.hom P_1.hom ⟶
          CategoryTheory.Limits.pullback P_m.hom P_1.hom :=
        CategoryTheory.Limits.pullback.lift
          (p_1Bm ≫ CategoryTheory.Limits.pullback.snd B.hom P_m.hom)
          (CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom)
          (by
            rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition]
            exact CategoryTheory.Limits.pullback.condition)
      have hpb_left : CategoryTheory.IsPullback
          p_1Bm α
          (CategoryTheory.Limits.pullback.snd B.hom P_m.hom)
          (CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom) := by
        refine CategoryTheory.IsPullback.of_bot ?_
          (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
          (CategoryTheory.IsPullback.of_hasPullback P_m.hom P_1.hom)
        rw [CategoryTheory.Limits.pullback.lift_snd]
        have h_eq : CategoryTheory.Limits.pullback.snd B.hom P_m.hom ≫ P_m.hom = B_m.hom :=
          (CategoryTheory.Limits.pullback.condition (f := B.hom) (g := P_m.hom)).symm
        rw [h_eq]
        exact CategoryTheory.IsPullback.of_hasPullback B_m.hom P_1.hom
      have hpb_assoc : CategoryTheory.IsPullback
          (p_1Bm ≫ p_mB) α B.hom P_m1_hom :=
        hpb_left.paste_horiz (CategoryTheory.IsPullback.of_hasPullback B.hom P_m.hom)
      have hPBC_comp_μB : WeilCanonicalModPrimePBC ℓ
          (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom) := by
        refine hArrowIso
          (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
          (p_1Bm ≫ p_mB)
          hpb_assoc.isoPullback.symm (CategoryTheory.Iso.refl B.left) ?_ hPBC_tower
        rw [CategoryTheory.Iso.symm_hom, hpb_assoc.isoPullback_inv_fst, hμ_fst,
          CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
      exact hCancel μ_B (CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
        hSurj_μB hPBC_μB hPBC_comp_μB
  intro X S S' X' _ f g f' g' hf hpb F F' hF_tor hF_pb q
  have hPBC_f : WeilCanonicalModPrimePBC ℓ f.left := by
    apply hAffineLoc
    intro U hU
    let S_U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (U.ι ≫ S.hom)
    let X_U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk ((f.left ⁻¹ᵁ U).ι ≫ X.hom)
    let f_U : X_U ⟶ S_U :=
      CategoryTheory.Over.homMk (f.left ∣_ U) (by
        dsimp [X_U, S_U]
        rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          CategoryTheory.Category.assoc, CategoryTheory.Over.w f])
    have : AlgebraicGeometry.IsAffine S_U.left := hU
    have : AlgebraicGeometry.LocallyOfFiniteType S_U.hom := by
      dsimp [S_U]
      infer_instance
    have : AlgebraicGeometry.IsProper f.left := hf
    have : AlgebraicGeometry.IsProper f_U.left := by
      dsimp [f_U]
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (AlgebraicGeometry.isPullback_morphismRestrict f.left U).flip hf
    have : AlgebraicGeometry.LocallyOfFiniteType f_U.left := inferInstance
    have : AlgebraicGeometry.LocallyOfFiniteType X_U.hom := by
      have hw : f_U.left ≫ S_U.hom = X_U.hom := CategoryTheory.Over.w f_U
      rw [← hw]
      infer_instance
    obtain ⟨N, X_tilde, ι_X, ι_S, hFin_X, hFin_S, hSurj_π, hComm⟩ :=
      weil_relative_chow_projective_factorization k X_U S_U f_U
    have : AlgebraicGeometry.IsFinite ι_X := hFin_X
    have : AlgebraicGeometry.IsFinite ι_S := hFin_S
    let p_NX := CategoryTheory.Limits.pullback.fst X_U.hom (weilProjectiveSpaceOver k N).hom
    let p_NS := CategoryTheory.Limits.pullback.fst S_U.hom (weilProjectiveSpaceOver k N).hom
    let π := ι_X ≫ p_NX
    have hPBC_π : WeilCanonicalModPrimePBC ℓ π :=
      hComp ι_X p_NX (weil_pbc_finite_morphism ℓ ι_X) (hProjSpace N X_U)
    have hPBC_ιS : WeilCanonicalModPrimePBC ℓ (ι_S ≫ p_NS) :=
      hComp ι_S p_NS (weil_pbc_finite_morphism ℓ ι_S) (hProjSpace N S_U)
    have hPBC_πf : WeilCanonicalModPrimePBC ℓ (π ≫ f_U.left) := by
      dsimp [π]
      rwa [hComm]
    exact hCancel π f_U.left hSurj_π hPBC_π hPBC_πf
  exact hExtract f.left g.left f'.left g'.left hPBC_f hpb F F' hF_tor hF_pb q

theorem weil_p1_baseChange_reduction_to_affine_integral (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hAffInt : ∀ (Z₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsAffine Z₀.left]
        [AlgebraicGeometry.LocallyOfFiniteType Z₀.hom],
        AlgebraicGeometry.IsIntegral Z₀.left →
        ∀ (F₀ : CategoryTheory.Sheaf
            (CategoryTheory.Limits.pullback Z₀.hom (weilProjectiveSpaceOver k 1).hom).smallEtaleTopology
            AddCommGrpCat.{u}) (q : ℕ),
          WeilIsConstructibleModPrimeSheaf ℓ
            (CategoryTheory.Limits.pullback Z₀.hom (weilProjectiveSpaceOver k 1).hom) F₀ →
          WeilIsGenFiniteEtaleConstantModPrime ℓ Z₀.left
            (weilEtaleHigherDirectImage
              (CategoryTheory.Limits.pullback.fst Z₀.hom (weilProjectiveSpaceOver k 1).hom) q F₀)) :
    WeilP1ConstructiblePushforwardHolds k ℓ :=
by
  classical
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have h_has_pb : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have h_stable_pb : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  
  
  
  let pb_id_left : ∀ {Y S : AlgebraicGeometry.Scheme.{u}} (f : Y ⟶ S),
      CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.id S) f ≅ Y :=
    fun {Y S} f =>
      { hom := CategoryTheory.Limits.pullback.snd (CategoryTheory.CategoryStruct.id S) f
        inv := CategoryTheory.Limits.pullback.lift f (CategoryTheory.CategoryStruct.id Y) (by simp)
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        inv_hom_id := CategoryTheory.Limits.pullback.lift_snd _ _ _ }

  have h_etale_term : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom) trivial) ?_
    intro U m
    apply (AlgebraicGeometry.Scheme.Etale.forget S).map_injective
    apply CategoryTheory.Over.OverMorphism.ext
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)

  have h_mem_etale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  have h_pull_base : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      let B_h : CategoryTheory.Functor Y₂.Etale Y₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
      ∃ (hc : B_h.IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology),
        letI := hc
        (B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology).IsRightAdjoint := by
    intro Y₁ Y₂ h
    let B_h : CategoryTheory.Functor Y₂.Etale Y₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    have hT₂ : CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y₂)) :=
      h_etale_term Y₂
    have : CategoryTheory.Limits.HasTerminal Y₂.Etale := hT₂.hasTerminal
    have : CategoryTheory.Limits.HasPullbacks Y₂.Etale :=
      CategoryTheory.MorphismProperty.Over.hasPullbacks (@AlgebraicGeometry.Etale) Y₂
    have : CategoryTheory.Limits.HasFiniteLimits Y₂.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : CategoryTheory.Limits.PreservesFiniteLimits B_h :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
        (@AlgebraicGeometry.Etale) h
    have : CategoryTheory.RepresentablyFlat B_h :=
      CategoryTheory.flat_of_preservesFiniteLimits B_h
    have hCompat : CategoryTheory.CompatiblePreserving Y₁.smallEtaleTopology B_h :=
      CategoryTheory.compatiblePreservingOfFlat Y₁.smallEtaleTopology B_h
    have hCover : CategoryTheory.CoverPreserving Y₂.smallEtaleTopology Y₁.smallEtaleTopology B_h := by
      constructor
      intro U S hS
      have hS' := (h_mem_etale Y₂ U S).mp hS
      refine (h_mem_etale Y₁ (B_h.obj U) _).mpr ?_
      intro z
      let fst_U : (B_h.obj U).left ⟶ U.left := CategoryTheory.Limits.pullback.fst U.hom h
      obtain ⟨Y, f, y, hfS, hfEt, hy⟩ := hS' (fst_U.base z)
      have h_outer : CategoryTheory.IsPullback
          ((B_h.map f).left ≫ CategoryTheory.Limits.pullback.snd U.hom h)
          (CategoryTheory.Limits.pullback.fst Y.hom h) h (f.left ≫ U.hom) := by
        have hw₁ : (B_h.map f).left ≫ CategoryTheory.Limits.pullback.snd U.hom h =
            CategoryTheory.Limits.pullback.snd Y.hom h :=
          CategoryTheory.MorphismProperty.Over.w (B_h.map f)
        have hw₂ : f.left ≫ U.hom = Y.hom := CategoryTheory.MorphismProperty.Over.w f
        rw [hw₁, hw₂]
        exact (CategoryTheory.IsPullback.of_hasPullback Y.hom h).flip
      have h_comm_left : (B_h.map f).left ≫ fst_U =
          CategoryTheory.Limits.pullback.fst Y.hom h ≫ f.left := by
        dsimp [B_h, fst_U, CategoryTheory.MorphismProperty.Over.pullback]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h_right : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd U.hom h) fst_U h U.hom :=
        (CategoryTheory.IsPullback.of_hasPullback U.hom h).flip
      have hp_left : CategoryTheory.IsPullback
          (B_h.map f).left (CategoryTheory.Limits.pullback.fst Y.hom h) fst_U f.left :=
        CategoryTheory.IsPullback.of_right h_outer h_comm_left h_right
      let e_pb := hp_left.isoPullback
      obtain ⟨p, hp_fst, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
      refine ⟨B_h.obj Y, B_h.map f, e_pb.inv.base p, ?_, ?_, ?_⟩
      · exact ⟨Y, f, 𝟙 (B_h.obj Y), hfS, (CategoryTheory.Category.id_comp _).symm⟩
      · exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hp_left.flip hfEt
      · have heq : e_pb.inv ≫ (B_h.map f).left =
            CategoryTheory.Limits.pullback.fst fst_U f.left := by
          rw [Iso.inv_comp_eq]
          exact (CategoryTheory.IsPullback.isoPullback_hom_fst hp_left).symm
        calc
          (B_h.map f).left.base (e_pb.inv.base p) = (e_pb.inv ≫ (B_h.map f).left).base p := rfl
          _ = (CategoryTheory.Limits.pullback.fst fst_U f.left).base p := by rw [heq]
          _ = z := hp_fst
    have hCont : B_h.IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCover
    let ι₂ : CategoryTheory.Functor Y₂.AffineEtale Y₂.Etale :=
      AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂
    let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology Y₂
    have : ι₂.IsContinuous J_aff Y₂.smallEtaleTopology := by
      dsimp [ι₂]
      infer_instance
    let P_ι := ι₂.sheafPushforwardContinuous AddCommGrpCat.{u} J_aff Y₂.smallEtaleTopology
    have : P_ι.IsEquivalence := by
      dsimp [P_ι, ι₂, J_aff]
      infer_instance
    let M₂ : Type u := CategoryTheory.SmallModel.{u} Y₂.AffineEtale
    let e_sm : Y₂.AffineEtale ≌ M₂ := CategoryTheory.equivSmallModel.{u} Y₂.AffineEtale
    let J_M : CategoryTheory.GrothendieckTopology M₂ := e_sm.inverse.inducedTopology J_aff
    let P_sm := e_sm.inverse.sheafPushforwardContinuous AddCommGrpCat.{u} J_M J_aff
    have : P_sm.IsEquivalence := by
      dsimp [P_sm, J_M]
      infer_instance
    let K : CategoryTheory.Functor M₂ Y₁.Etale := (e_sm.inverse.comp ι₂).comp B_h
    have : (e_sm.inverse.comp ι₂).IsContinuous J_M Y₂.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp e_sm.inverse ι₂ J_M J_aff Y₂.smallEtaleTopology
    have : K.IsContinuous J_M Y₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp (e_sm.inverse.comp ι₂) B_h J_M
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let P_push := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let P_K := K.sheafPushforwardContinuous AddCommGrpCat.{u} J_M Y₁.smallEtaleTopology
    let e_tot : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u} ≌
        CategoryTheory.Sheaf J_M AddCommGrpCat.{u} :=
      P_ι.asEquivalence.trans P_sm.asEquivalence
    have hPK : P_push.comp e_tot.functor ≅ P_K :=
      (CategoryTheory.Functor.associator P_push P_ι P_sm).symm ≪≫
        CategoryTheory.Functor.isoWhiskerLeft P_push
          (CategoryTheory.Functor.sheafPushforwardContinuousComp e_sm.inverse ι₂ AddCommGrpCat.{u}
            J_M J_aff Y₂.smallEtaleTopology).symm ≪≫
        CategoryTheory.Functor.sheafPushforwardContinuousComp (e_sm.inverse.comp ι₂) B_h
          AddCommGrpCat.{u} J_M Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    have hIso : P_K.comp e_tot.inverse ≅ P_push :=
      (CategoryTheory.Functor.isoWhiskerRight hPK.symm e_tot.inverse) ≪≫
        CategoryTheory.Functor.associator P_push e_tot.functor e_tot.inverse ≪≫
        CategoryTheory.Functor.isoWhiskerLeft P_push e_tot.unitIso.symm ≪≫
        CategoryTheory.Functor.rightUnitor P_push
    let adj_K := K.sheafAdjunctionContinuous AddCommGrpCat.{u} J_M Y₁.smallEtaleTopology
    exact ⟨hCont, (CategoryTheory.Adjunction.ofNatIsoRight (e_tot.toAdjunction.comp adj_K) hIso).isRightAdjoint⟩

  have hPullEx : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
      (F₂ : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}),
      ∃ (F₁ : CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback h F₂ F₁ ∧
        ∀ (m : ℕ), m • CategoryTheory.CategoryStruct.id F₂ = 0 →
          m • CategoryTheory.CategoryStruct.id F₁ = 0 := by
    intro Y₁ Y₂ h F₂
    obtain ⟨hc, hr⟩ := h_pull_base h
    let B_h : CategoryTheory.Functor Y₂.Etale Y₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    let P_push := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let L_h := B_h.sheafPullback AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    have : P_push.Additive := { map_add := by intros; ext1; rfl }
    have : L_h.Additive := CategoryTheory.Adjunction.left_adjoint_additive adj_h
    refine ⟨L_h.obj F₂, ⟨hc, hr, ⟨CategoryTheory.Iso.refl _⟩⟩, ?_⟩
    intro m hm
    rw [← L_h.map_id, ← Functor.map_nsmul, hm, Functor.map_zero]

  have hPullConst : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
      (A : AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h
        ((CategoryTheory.constantSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}).obj A)
        ((CategoryTheory.constantSheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
    intro Y₁ Y₂ h A
    obtain ⟨hc, hr⟩ := h_pull_base h
    let B_h : CategoryTheory.Functor Y₂.Etale Y₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    let P_push := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let T₁ := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y₁)
    let T₂ := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y₂)
    have hT₁ : CategoryTheory.Limits.IsTerminal T₁ := h_etale_term Y₁
    have hT₂ : CategoryTheory.Limits.IsTerminal T₂ := h_etale_term Y₂
    let e_T : B_h.obj T₂ ≅ T₁ :=
      CategoryTheory.MorphismProperty.Over.isoMk (pb_id_left h)
        (CategoryTheory.Category.comp_id _)
    let adj₁ := CategoryTheory.constantSheafAdj Y₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
    let adj₂ := (CategoryTheory.constantSheafAdj Y₂.smallEtaleTopology AddCommGrpCat.{u} hT₂).comp
      (B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology)
    let Γ₁ := (CategoryTheory.sheafSections Y₁.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₁)
    let Γ₂ := (CategoryTheory.sheafSections Y₂.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₂)
    have hΓ_iso : P_push.comp Γ₂ ≅ Γ₁ :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ => ℱ.obj.mapIso e_T.op.symm)
        (fun {ℱ₁ ℱ₂} φ => by
          dsimp [P_push, Γ₁, Γ₂, CategoryTheory.sheafSections]
          exact (φ.hom.naturality e_T.inv.op).symm)
    let adj₂' := CategoryTheory.Adjunction.ofNatIsoRight adj₂ hΓ_iso
    let e_const := CategoryTheory.Adjunction.leftAdjointUniq adj₂' adj₁
    exact ⟨hc, hr, ⟨e_const.app A⟩⟩

  have hPullComp : ∀ {Y₁ Y₂ Y₃ : AlgebraicGeometry.Scheme.{u}} (h₁ : Y₁ ⟶ Y₂) (h₂ : Y₂ ⟶ Y₃)
      (F₃ : CategoryTheory.Sheaf Y₃.smallEtaleTopology AddCommGrpCat.{u})
      (F₂ : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u})
      (F₁ : CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h₂ F₃ F₂ →
      WeilIsEtaleSheafPullback h₁ F₂ F₁ →
      WeilIsEtaleSheafPullback (h₁ ≫ h₂) F₃ F₁ := by
    intro Y₁ Y₂ Y₃ h₁ h₂ F₃ F₂ F₁ ⟨hc₂, hr₂, ⟨e₂⟩⟩ ⟨hc₁, hr₁, ⟨e₁⟩⟩
    obtain ⟨hc₁₂, hr₁₂⟩ := h_pull_base (h₁ ≫ h₂)
    let B₁ : CategoryTheory.Functor Y₂.Etale Y₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h₁
    let B₂ : CategoryTheory.Functor Y₃.Etale Y₂.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h₂
    let B₁₂ : CategoryTheory.Functor Y₃.Etale Y₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ (h₁ ≫ h₂)
    have α : B₁₂ ≅ B₂.comp B₁ :=
      CategoryTheory.MorphismProperty.Over.pullbackComp h₁ h₂
    have : (B₂.comp B₁).IsContinuous Y₃.smallEtaleTopology Y₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp B₂ B₁
        Y₃.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let P₁ := B₁.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let P₂ := B₂.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₃.smallEtaleTopology Y₂.smallEtaleTopology
    let P₁₂ := B₁₂.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₃.smallEtaleTopology Y₁.smallEtaleTopology
    have hP_comp : P₁.comp P₂ ≅ P₁₂ :=
      (CategoryTheory.Functor.sheafPushforwardContinuousComp B₂ B₁ AddCommGrpCat.{u}
        Y₃.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology) ≪≫
        (CategoryTheory.Functor.sheafPushforwardContinuousIso α.symm AddCommGrpCat.{u}
          Y₃.smallEtaleTopology Y₁.smallEtaleTopology)
    let L₁ := B₁.sheafPullback AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let adj₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let adj₂ := B₂.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₃.smallEtaleTopology Y₂.smallEtaleTopology
    let adj₁₂ := B₁₂.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₃.smallEtaleTopology Y₁.smallEtaleTopology
    let β := CategoryTheory.Adjunction.leftAdjointUniq
      (CategoryTheory.Adjunction.ofNatIsoRight (adj₂.comp adj₁) hP_comp) adj₁₂
    exact ⟨hc₁₂, hr₁₂, ⟨(β.symm.app F₃) ≪≫ (L₁.mapIso e₂) ≪≫ e₁⟩⟩

  have hPullCancel : ∀ {Y₁ Y₂ Y₃ : AlgebraicGeometry.Scheme.{u}} (h₁ : Y₁ ⟶ Y₂) (h₂ : Y₂ ⟶ Y₃)
      (F₃ : CategoryTheory.Sheaf Y₃.smallEtaleTopology AddCommGrpCat.{u})
      (F₂ : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u})
      (G : CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h₂ F₃ F₂ →
      WeilIsEtaleSheafPullback (h₁ ≫ h₂) F₃ G →
      WeilIsEtaleSheafPullback h₁ F₂ G := by
    intro Y₁ Y₂ Y₃ h₁ h₂ F₃ F₂ G hPull₂ hPull₁₂
    obtain ⟨G', hPull₁, -⟩ := hPullEx h₁ F₂
    have hPull₁₂' := hPullComp h₁ h₂ F₃ F₂ G' hPull₂ hPull₁
    obtain ⟨hc_a, hr_a, ⟨e_a⟩⟩ := hPull₁₂
    obtain ⟨hc_b, hr_b, ⟨e_b⟩⟩ := hPull₁₂'
    cases Subsingleton.elim hc_a hc_b
    cases Subsingleton.elim hr_a hr_b
    obtain ⟨hc₁, hr₁, ⟨e₁⟩⟩ := hPull₁
    exact ⟨hc₁, hr₁, ⟨e₁ ≪≫ e_b.symm ≪≫ e_a⟩⟩

  
  
  
  have hImgFac : ∀ {W Y : AlgebraicGeometry.Scheme.{u}} (f : W ⟶ Y),
      AlgebraicGeometry.IsIntegral W →
      ∃ (W₂ : AlgebraicGeometry.Scheme.{u}) (iW₂ : W₂ ⟶ Y) (h_tilde : W ⟶ W₂),
        AlgebraicGeometry.IsClosedImmersion iW₂ ∧
        AlgebraicGeometry.IsIntegral W₂ ∧
        h_tilde ≫ iW₂ = f ∧
        ∀ (U₂ : W₂.Opens), Nonempty U₂ →
          Nonempty ((TopologicalSpace.Opens.map h_tilde.base).obj U₂) := by
    intro W Y f hIntW
    have : AlgebraicGeometry.IsIntegral W := hIntW
    let W₂ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Scheme.Hom.image f
    let iW₂ : W₂ ⟶ Y := AlgebraicGeometry.Scheme.Hom.imageι f
    let h_tilde : W ⟶ W₂ := AlgebraicGeometry.Scheme.Hom.toImage f
    have hfac : h_tilde ≫ iW₂ = f := AlgebraicGeometry.Scheme.Hom.toImage_imageι f
    let C_W : TopologicalSpace.Closeds ↥Y :=
      TopologicalSpace.Closeds.closure (⇑f.base '' (↑(⊤ : TopologicalSpace.Closeds ↥W) : Set ↥W))
    have hker : f.ker = AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_W := by
      calc
        f.ker = (⊥ : W.IdealSheafData).map f :=
          (AlgebraicGeometry.Scheme.IdealSheafData.map_bot f).symm
        _ = W.nilradical.map f := by rw [AlgebraicGeometry.Scheme.nilradical_eq_bot]
        _ = (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal
              (⊤ : TopologicalSpace.Closeds ↥W)).map f := by
          rw [AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_top]
        _ = AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_W :=
          AlgebraicGeometry.Scheme.IdealSheafData.map_vanishingIdeal _ _
    have hCW_set : (C_W : Set ↥Y) = closure (Set.range ⇑f.base) := by
      change closure (⇑f.base '' (Set.univ : Set ↥W)) = closure (Set.range ⇑f.base)
      rw [Set.image_univ]
    have hRedW₂ : AlgebraicGeometry.IsReduced W₂ := by
      obtain ⟨hAffHom, hSurjApp⟩ :=
        (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom (f := iW₂)).mp inferInstance
      have : AlgebraicGeometry.IsAffineHom iW₂ := hAffHom
      let V_fam : Y.affineOpens → W₂.Opens :=
        fun U => (TopologicalSpace.Opens.map iW₂.base).obj U.1
      have hiSup_Y : (⨆ U : Y.affineOpens, (U : Y.Opens)) = ⊤ := by
        rw [eq_top_iff]
        intro y _
        obtain ⟨U, hU, hy, -⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨U, hU⟩, hy⟩
      have hcov : TopologicalSpace.IsOpenCover V_fam :=
        AlgebraicGeometry.Scheme.Hom.iSup_preimage_eq_top iW₂ hiSup_Y
      let 𝒰 := W₂.openCoverOfIsOpenCover V_fam hcov
      have hRed_chart : ∀ U : Y.affineOpens, AlgebraicGeometry.IsReduced (𝒰.X U) := by
        intro U
        change AlgebraicGeometry.IsReduced ((V_fam U : W₂.Opens) : AlgebraicGeometry.Scheme.{u})
        have : AlgebraicGeometry.IsAffine ((V_fam U : W₂.Opens) : AlgebraicGeometry.Scheme.{u}) :=
          AlgebraicGeometry.IsAffineOpen.preimage U.2 iW₂
        have hsurj : Function.Surjective (iW₂.app U.1).hom := hSurjApp U.1 U.2
        have hrad : (RingHom.ker (iW₂.app U.1).hom).IsRadical := by
          have hk : RingHom.ker (iW₂.app U.1).hom = f.ker.ideal U :=
            AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι_app f.ker U
          rw [hk, hker, AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal]
          exact PrimeSpectrum.isRadical_vanishingIdeal _
        have : IsReduced ↑(W₂.presheaf.obj (Opposite.op (V_fam U))) := by
          rw [isReduced_iff]
          intro s ⟨n, hn⟩
          obtain ⟨r, rfl⟩ := hsurj s
          rw [← map_pow] at hn
          have hr_ker : r ∈ RingHom.ker (iW₂.app U.1).hom := hrad ⟨n, hn⟩
          exact hr_ker
        let e_top := (V_fam U).topIso.commRingCatIsoToRingEquiv
        have : IsReduced ↑(((V_fam U : W₂.Opens) : AlgebraicGeometry.Scheme.{u}).presheaf.obj
            (Opposite.op ⊤)) := by
          rw [isReduced_iff]
          intro s ⟨n, hn⟩
          apply e_top.injective
          rw [map_zero]
          have hsn : (e_top s) ^ n = 0 := by rw [← map_pow, hn, map_zero]
          exact IsNilpotent.eq_zero ⟨n, hsn⟩
        exact AlgebraicGeometry.isReduced_of_isAffine_isReduced _
      exact @AlgebraicGeometry.IsReduced.of_openCover W₂ 𝒰 hRed_chart
    have hRange_iW₂ : Set.range ⇑iW₂.base = closure (Set.range ⇑f.base) := by
      calc
        Set.range ⇑iW₂.base = (f.ker.support : Set ↥Y) :=
          AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι f.ker
        _ = ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_W).support : Set ↥Y) := by
          rw [hker]
        _ = (C_W : Set ↥Y) :=
          AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal C_W
        _ = closure (Set.range ⇑f.base) := hCW_set
    have hInd : Topology.IsInducing ⇑iW₂.base :=
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding iW₂).isInducing
    have hOpenHit : ∀ (O : Set ↥W₂), IsOpen O → O.Nonempty →
        ∃ w : ↥W, h_tilde.base w ∈ O := by
      intro O hO ⟨y₀, hy₀⟩
      obtain ⟨T, hT_open, rfl⟩ := hInd.isOpen_iff.mp hO
      have hy₀_cl : iW₂.base y₀ ∈ closure (Set.range ⇑f.base) := by
        rw [← hRange_iW₂]
        exact ⟨y₀, rfl⟩
      obtain ⟨_, ⟨hT_mem, ⟨w, hw⟩⟩⟩ := mem_closure_iff.mp hy₀_cl T hT_open hy₀
      refine ⟨w, ?_⟩
      have hfw : iW₂.base (h_tilde.base w) = f.base w := by
        rw [← hfac]
        rfl
      change iW₂.base (h_tilde.base w) ∈ T
      rw [hfw, hw]
      exact hT_mem
    have hDense : closure (Set.range ⇑h_tilde.base) = (Set.univ : Set ↥W₂) := by
      ext y₀
      simp only [Set.mem_univ, iff_true, mem_closure_iff]
      intro O hO hy₀
      obtain ⟨w, hw⟩ := hOpenHit O hO ⟨y₀, hy₀⟩
      exact ⟨h_tilde.base w, hw, ⟨w, rfl⟩⟩
    have hIrr_univ : IsIrreducible (Set.univ : Set ↥W₂) := by
      rw [← hDense, ← Set.image_univ]
      exact ((IrreducibleSpace.isIrreducible_univ (X := ↥W)).image
        h_tilde.base h_tilde.base.hom.continuous.continuousOn).closure
    have : PreirreducibleSpace ↥W₂ := ⟨hIrr_univ.isPreirreducible⟩
    have : Nonempty ↥W₂ := ⟨h_tilde.base (Classical.arbitrary ↥W)⟩
    have : IrreducibleSpace ↥W₂ := { toNonempty := inferInstance }
    have : AlgebraicGeometry.IsReduced W₂ := hRedW₂
    have hIntW₂ : AlgebraicGeometry.IsIntegral W₂ :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced W₂
    refine ⟨W₂, iW₂, h_tilde, inferInstance, hIntW₂, hfac, ?_⟩
    intro U₂ ⟨u₀⟩
    obtain ⟨w, hw⟩ := hOpenHit (U₂ : Set ↥W₂) U₂.isOpen ⟨u₀.1, u₀.2⟩
    exact ⟨⟨w, hw⟩⟩

  
  
  
  let P₁ := weilProjectiveSpaceOver k 1
  have hPropP₁ : AlgebraicGeometry.IsProper P₁.hom := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k) :=
      IsScalarTower.of_algebraMap_eq (R := k) (S := ↥(𝒜 0)) (A := MvPolynomial (Fin (1 + 1)) k)
        (fun _ => rfl)
    let : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k)
    let φ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
    have hφ_bij : Function.Bijective φ := by
      constructor
      · intro a b hab
        exact MvPolynomial.C_injective (Fin (1 + 1)) k (congrArg Subtype.val hab)
      · intro x
        have hx : x.1 ∈ (1 : Submodule k (MvPolynomial (Fin (1 + 1)) k)) := by
          rw [← MvPolynomial.homogeneousSubmodule_zero]
          exact x.2
        rw [Submodule.mem_one] at hx
        obtain ⟨r, hr⟩ := hx
        exact ⟨r, Subtype.ext hr⟩
    have : CategoryTheory.IsIso (CommRingCat.ofHom φ) :=
      (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom φ)).mpr hφ_bij
    dsimp [P₁, weilProjectiveSpaceOver]
    infer_instance

  have hTorsR : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) (q : ℕ)
      (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage f q F) = 0 := by
    intro X S f q F hℓF
    let B_f : CategoryTheory.Functor S.Etale X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let P_F : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Sheaf.cohomologyPresheaf F q
    let Sh : CategoryTheory.Functor (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u})
        (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    have : Sh.Additive := inferInstance
    have hβ : ℓ • CategoryTheory.Abelian.Ext.mk₀ (𝟙 F) = 0 := by
      apply CategoryTheory.Abelian.Ext.addEquiv₀.injective
      rw [map_nsmul, map_zero]
      have hid : CategoryTheory.Abelian.Ext.addEquiv₀
          (CategoryTheory.Abelian.Ext.mk₀ (𝟙 F)) = 𝟙 F :=
        CategoryTheory.Abelian.Ext.homEquiv₀.apply_symm_apply _
      rw [hid, hℓF]
    have hBP : ℓ • (𝟙 (B_f.op ⋙ P_F)) = 0 := by
      apply NatTrans.ext
      funext U
      ext x
      change ℓ • x = 0
      let E := (CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
        (yoneda.obj (B_f.obj (Opposite.unop U)) ⋙ AddCommGrpCat.free)
      let bc := (CategoryTheory.Abelian.Ext.bilinearComp E F F q 0 q (Nat.add_zero q)) x
      have hx : bc (CategoryTheory.Abelian.Ext.mk₀ (𝟙 F)) = x :=
        CategoryTheory.Abelian.Ext.comp_mk₀_id x
      have hbc : bc (ℓ • CategoryTheory.Abelian.Ext.mk₀ (𝟙 F)) = ℓ • x := by
        rw [map_nsmul, hx]
        rfl
      rw [hβ, map_zero] at hbc
      exact hbc.symm
    change ℓ • (𝟙 (Sh.obj (B_f.op ⋙ P_F))) = 0
    rw [← Sh.map_id, ← Functor.map_nsmul, hBP, Functor.map_zero]

  
  
  
  have hConstPull : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
      (F₂ : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsConstructibleModPrimeSheaf ℓ Y₂ F₂ →
      ∃ (F₁ : CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback h F₂ F₁ ∧
        WeilIsConstructibleModPrimeSheaf ℓ Y₁ F₁ := by
    intro Y₁ Y₂ h F₂ hF₂
    obtain ⟨F₁, hPull_h, hTors₁⟩ := hPullEx h F₂
    refine ⟨F₁, hPull_h, hTors₁ ℓ hF₂.1, ?_⟩
    intro W iW hClW hIntW
    obtain ⟨W₂, iW₂, h_tilde, hClW₂, hIntW₂, hfac, hDenseOpen⟩ := hImgFac (iW ≫ h) hIntW
    obtain ⟨U₂, hU₂, V₂, p₂, A, hFin₂, hEt₂, hSurj₂, hFinA, hTorsA, hPull₂⟩ :=
      hF₂.2 W₂ iW₂ hClW₂ hIntW₂
    have := hFin₂
    have := hEt₂
    have := hSurj₂
    let U₁ : W.Opens := (TopologicalSpace.Opens.map h_tilde.base).obj U₂
    have hU₁ : Nonempty U₁ := hDenseOpen U₂ hU₂
    let g_U : (U₁ : AlgebraicGeometry.Scheme.{u}) ⟶ (U₂ : AlgebraicGeometry.Scheme.{u}) :=
      h_tilde ∣_ U₂
    let V₁ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback p₂ g_U
    let p'₁ : V₁ ⟶ (U₁ : AlgebraicGeometry.Scheme.{u}) := CategoryTheory.Limits.pullback.snd p₂ g_U
    let q_V : V₁ ⟶ V₂ := CategoryTheory.Limits.pullback.fst p₂ g_U
    have hcomm_tot : q_V ≫ (p₂ ≫ (U₂.ι ≫ iW₂)) = (p'₁ ≫ (U₁.ι ≫ iW)) ≫ h := by
      calc
        q_V ≫ (p₂ ≫ (U₂.ι ≫ iW₂)) = (q_V ≫ p₂) ≫ U₂.ι ≫ iW₂ := by
          simp only [CategoryTheory.Category.assoc]
        _ = (p'₁ ≫ g_U) ≫ U₂.ι ≫ iW₂ := by rw [CategoryTheory.Limits.pullback.condition]
        _ = p'₁ ≫ (g_U ≫ U₂.ι) ≫ iW₂ := by simp only [CategoryTheory.Category.assoc]
        _ = p'₁ ≫ (U₁.ι ≫ h_tilde) ≫ iW₂ := by
          rw [AlgebraicGeometry.morphismRestrict_ι h_tilde U₂]
        _ = p'₁ ≫ U₁.ι ≫ (h_tilde ≫ iW₂) := by simp only [CategoryTheory.Category.assoc]
        _ = p'₁ ≫ U₁.ι ≫ (iW ≫ h) := by rw [hfac]
        _ = (p'₁ ≫ (U₁.ι ≫ iW)) ≫ h := by simp only [CategoryTheory.Category.assoc]
    have hPull_comp := hPullComp q_V (p₂ ≫ (U₂.ι ≫ iW₂)) _ _ _ hPull₂ (hPullConst q_V A)
    rw [hcomm_tot] at hPull_comp
    have hPull_V₁ := hPullCancel (p'₁ ≫ (U₁.ι ≫ iW)) h F₂ F₁ _ hPull_h hPull_comp
    exact ⟨U₁, hU₁, V₁, p'₁, A, inferInstance, inferInstance, inferInstance, hFinA, hTorsA, hPull_V₁⟩

  
  
  
  intro B _ _ _ P₁' p₁ F q hF
  change WeilIsConstructibleModPrimeSheaf ℓ B.left
    (weilEtaleHigherDirectImage (CategoryTheory.Limits.pullback.fst B.hom P₁.hom) q F)
  let p₁_B := CategoryTheory.Limits.pullback.fst B.hom P₁.hom
  have hProp_p₁B : AlgebraicGeometry.IsProper p₁_B := inferInstance
  refine ⟨hTorsR p₁_B q F hF.1, ?_⟩
  intro Z iZ hCliZ hIntZ
  have := hCliZ
  have := hIntZ
  obtain ⟨z₀⟩ : Nonempty ↥Z := inferInstance
  obtain ⟨U_aff, hAff, hz₀, -⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z₀) (U := ⊤) trivial
  let j₀ : (U_aff : AlgebraicGeometry.Scheme.{u}) ⟶ B.left := U_aff.ι ≫ iZ
  let Z₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (j₀ ≫ B.hom)
  have : AlgebraicGeometry.IsAffine Z₀.left := hAff
  have : AlgebraicGeometry.LocallyOfFiniteType Z₀.hom := by
    dsimp [Z₀, j₀]
    infer_instance
  have : Nonempty ↥Z₀.left := ⟨⟨z₀, hz₀⟩⟩
  have hIntZ₀ : AlgebraicGeometry.IsIntegral Z₀.left :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion U_aff.ι
  let p₁₀ := CategoryTheory.Limits.pullback.fst Z₀.hom P₁.hom
  let g'₀ : CategoryTheory.Limits.pullback Z₀.hom P₁.hom ⟶
      CategoryTheory.Limits.pullback B.hom P₁.hom :=
    CategoryTheory.Limits.pullback.lift (p₁₀ ≫ j₀)
      (CategoryTheory.Limits.pullback.snd Z₀.hom P₁.hom)
      ((CategoryTheory.Category.assoc p₁₀ j₀ B.hom).trans
        CategoryTheory.Limits.pullback.condition)
  have hg'₀_hom : g'₀ ≫ (p₁_B ≫ B.hom) = p₁₀ ≫ Z₀.hom :=
    (CategoryTheory.Category.assoc g'₀ p₁_B B.hom).symm.trans
      ((congrArg (· ≫ B.hom) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
        (CategoryTheory.Category.assoc p₁₀ j₀ B.hom))
  have hPb : CategoryTheory.IsPullback g'₀ p₁₀ p₁_B j₀ := by
    have h_outer : CategoryTheory.IsPullback
        (g'₀ ≫ CategoryTheory.Limits.pullback.snd B.hom P₁.hom)
        p₁₀ P₁.hom (j₀ ≫ B.hom) := by
      rw [CategoryTheory.Limits.pullback.lift_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback Z₀.hom P₁.hom).flip
    have h_comm : g'₀ ≫ p₁_B = p₁₀ ≫ j₀ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have h_right : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd B.hom P₁.hom) p₁_B P₁.hom B.hom :=
      (CategoryTheory.IsPullback.of_hasPullback B.hom P₁.hom).flip
    exact CategoryTheory.IsPullback.of_right h_outer h_comm h_right
  obtain ⟨F₀, hPull₀, hF₀⟩ := hConstPull g'₀ F hF
  have hPullBase : WeilIsEtaleSheafPullback j₀
      (weilEtaleHigherDirectImage p₁_B q F)
      (weilEtaleHigherDirectImage p₁₀ q F₀) :=
    hPBC (CategoryTheory.Over.mk (p₁_B ≫ B.hom)) B Z₀ (CategoryTheory.Over.mk (p₁₀ ≫ Z₀.hom))
      (CategoryTheory.Over.homMk p₁_B rfl)
      (CategoryTheory.Over.homMk j₀ rfl)
      (CategoryTheory.Over.homMk p₁₀ rfl)
      (CategoryTheory.Over.homMk g'₀ hg'₀_hom)
      hProp_p₁B hPb F F₀ hF.1 hPull₀ q
  obtain ⟨U₀, hU₀, V₀, p₀, A, hFin₀, hEt₀, hSurj₀, hFinA, hTorsA, hPullAff⟩ :=
    (hAffInt Z₀ hIntZ₀ F₀ q hF₀).2
  have := hFin₀
  have := hEt₀
  have := hSurj₀
  let U_Z : Z.Opens := (AlgebraicGeometry.Scheme.Hom.opensFunctor U_aff.ι).obj U₀
  let e_img : (U₀ : AlgebraicGeometry.Scheme.{u}) ≅ (U_Z : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.Scheme.Hom.isoImage U_aff.ι U₀
  have hUZ : Nonempty U_Z := ⟨e_img.hom.base hU₀.some⟩
  let p_Z : V₀ ⟶ (U_Z : AlgebraicGeometry.Scheme.{u}) := p₀ ≫ e_img.hom
  have hpZ_eq : (p₀ ≫ U₀.ι) ≫ j₀ = p_Z ≫ (U_Z.ι ≫ iZ) := by
    dsimp [j₀, p_Z]
    calc
      (p₀ ≫ U₀.ι) ≫ U_aff.ι ≫ iZ = p₀ ≫ (U₀.ι ≫ U_aff.ι) ≫ iZ := by
        simp only [CategoryTheory.Category.assoc]
      _ = p₀ ≫ (e_img.hom ≫ U_Z.ι) ≫ iZ := by
        rw [← AlgebraicGeometry.Scheme.Hom.isoImage_hom_ι U_aff.ι U₀]
      _ = (p₀ ≫ e_img.hom) ≫ U_Z.ι ≫ iZ := by
        simp only [CategoryTheory.Category.assoc]
  have hPullTot := hPullComp (p₀ ≫ U₀.ι) j₀ _ _ _ hPullBase hPullAff
  rw [hpZ_eq] at hPullTot
  exact ⟨U_Z, hUZ, V₀, p_Z, A, inferInstance, inferInstance, inferInstance, hFinA, hTorsA, hPullTot⟩

theorem weil_genFLC_abelian_and_extension_closure (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Z : AlgebraicGeometry.Scheme.{u})
    (hIntZ : AlgebraicGeometry.IsIntegral Z)
    (hCoverInt : ∀ (U : Z.Opens) (_ : Nonempty U)
        (V : AlgebraicGeometry.Scheme.{u})
        (p : V ⟶ (U : AlgebraicGeometry.Scheme.{u})),
      AlgebraicGeometry.IsFinite p →
      AlgebraicGeometry.Etale p →
      AlgebraicGeometry.Surjective p →
      ∃ (U₁ : Z.Opens) (_ : Nonempty U₁)
        (V₁ : AlgebraicGeometry.Scheme.{u})
        (p₁ : V₁ ⟶ (U₁ : AlgebraicGeometry.Scheme.{u}))
        (ι₁ : V₁ ⟶ V),
        AlgebraicGeometry.IsIntegral V₁ ∧
        AlgebraicGeometry.IsFinite p₁ ∧
        AlgebraicGeometry.Etale p₁ ∧
        AlgebraicGeometry.Surjective p₁ ∧
        AlgebraicGeometry.Etale ι₁ ∧
        ι₁ ≫ p ≫ U.ι = p₁ ≫ U₁.ι)
    (hAffEtShrink : ∀ (U₀ : Z.Opens) (_ : Nonempty U₀)
        (W : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsAffine W]
        (_ : Nonempty W)
        (w : W ⟶ (U₀ : AlgebraicGeometry.Scheme.{u})),
      AlgebraicGeometry.Etale w →
      ∃ (U₁ : Z.Opens) (_ : Nonempty U₁)
        (W₁ : AlgebraicGeometry.Scheme.{u})
        (jW : W₁ ⟶ W)
        (p₁ : W₁ ⟶ (U₁ : AlgebraicGeometry.Scheme.{u})),
        AlgebraicGeometry.IsOpenImmersion jW ∧
        AlgebraicGeometry.IsFinite p₁ ∧
        AlgebraicGeometry.Etale p₁ ∧
        AlgebraicGeometry.Surjective p₁ ∧
        jW ≫ w ≫ U₀.ι = p₁ ≫ U₁.ι) :
    let Q : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} → Prop :=
      WeilIsGenFiniteEtaleConstantModPrime ℓ Z
    (∀ G, CategoryTheory.Limits.IsZero G → Q G) ∧
    (∀ G₁ G₂ (i : G₁ ⟶ G₂) (r : G₂ ⟶ G₁), i ≫ r = 𝟙 G₁ → Q G₂ → Q G₁) ∧
    (∀ G₁ G₂ (ψ : G₁ ⟶ G₂), Q G₁ → Q G₂ →
      Q (CategoryTheory.Limits.kernel ψ) ∧ Q (CategoryTheory.Limits.cokernel ψ)) ∧
    (∀ (T : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})),
      T.ShortExact → ℓ • 𝟙 T.X₂ = 0 → Q T.X₁ → Q T.X₃ → Q T.X₂) :=
by
  classical
  intro Q

  
  haveI hEtComp : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsStableUnderComposition.mk
      (fun _ _ hf hg => by haveI := hf; haveI := hg; exact inferInstance)
  haveI hEtMult : CategoryTheory.MorphismProperty.IsMultiplicative (@AlgebraicGeometry.Etale) :=
    { id_mem := fun _ => inferInstance }
  haveI hEtBC : CategoryTheory.MorphismProperty.IsStableUnderBaseChange
      (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  haveI hEtPost : CategoryTheory.MorphismProperty.HasOfPostcompProperty
      (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.HasOfPostcompProperty.mk
      (fun f g hg hfg => by haveI := hg; haveI := hfg; exact AlgebraicGeometry.Etale.of_comp f g)
  letI hEtPullAlong : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI hEtBCAlong : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  have hMemEtale : ∀ {S : AlgebraicGeometry.Scheme.{u}} (X : S.Etale) (R : CategoryTheory.Sieve X),
      R ∈ S.smallEtaleTopology X ↔
        ∀ (x : ↥X.left), ∃ (Y : S.Etale) (f : Y ⟶ X) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x := by
    intro S X R
    have hEqJ : S.smallEtaleTopology =
        @Pretopology.toGrothendieck S.Etale inferInstance inferInstance
          (@AlgebraicGeometry.Scheme.smallPretopology (@AlgebraicGeometry.Etale)
            (@AlgebraicGeometry.Etale) S hEtComp hEtBC hEtMult hEtBC hEtPost) :=
      @AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) S
        hEtComp hEtBC hEtMult hEtBC hEtPost (le_refl _)
    exact (Eq.to_iff (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J X)
      hEqJ)).trans (@AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) S
        hEtComp hEtBC hEtMult hEtBC hEtPost X R)

  let mkTermEt : ∀ (S : AlgebraicGeometry.Scheme.{u}), S.Etale := fun S =>
    CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S)
      (inferInstance : AlgebraicGeometry.Etale (𝟙 S))
  let isTermEt : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (mkTermEt S) := fun S =>
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom)
      (fun U m => CategoryTheory.MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans m.w))

  
  have hSheafSep : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      (F : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      {W : S.Etale} (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W →
      ∀ (s₁ s₂ : F.obj.obj (Opposite.op W)),
        (∀ ⦃Y : S.Etale⦄ (u : Y ⟶ W), R.arrows u →
          F.obj.map u.op s₁ = F.obj.map u.op s₂) →
        s₁ = s₂ := by
    intro S F W R hR s₁ s₂ hEq
    let E : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let zHom : F.obj.obj (Opposite.op W) → (E ⟶ F.obj.obj (Opposite.op W)) := fun s =>
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • s
          map_zero' := zero_zsmul s
          map_add' := fun a b => add_zsmul s a.down b.down }
    have hSheafE : CategoryTheory.Presieve.IsSheafFor
        (F.obj.comp (CategoryTheory.coyoneda.obj (Opposite.op E))) R.arrows :=
      F.property E R hR
    have hZEq : zHom s₁ = zHom s₂ := by
      apply hSheafE.isSeparatedFor.ext
      intro Y u hu
      change zHom s₁ ≫ F.obj.map u.op = zHom s₂ ≫ F.obj.map u.op
      apply AddCommGrpCat.ext
      rintro ⟨n⟩
      change (F.obj.map u.op) (n • s₁) = (F.obj.map u.op) (n • s₂)
      rw [map_zsmul, map_zsmul, hEq u hu]
    have hEval := congrArg (fun φ : E ⟶ F.obj.obj (Opposite.op W) => φ (ULift.up 1)) hZEq
    simpa [zHom, one_zsmul] using hEval

  
  have s1 : ∀ (U₁ : Z.Opens) (_ : Nonempty U₁)
      (V₁ : AlgebraicGeometry.Scheme.{u}) (p₁ : V₁ ⟶ (U₁ : AlgebraicGeometry.Scheme.{u})),
      AlgebraicGeometry.IsFinite p₁ → AlgebraicGeometry.Etale p₁ →
      AlgebraicGeometry.Surjective p₁ →
      ∀ (U₂ : Z.Opens) (_ : Nonempty U₂)
      (V₂ : AlgebraicGeometry.Scheme.{u}) (p₂ : V₂ ⟶ (U₂ : AlgebraicGeometry.Scheme.{u})),
      AlgebraicGeometry.IsFinite p₂ → AlgebraicGeometry.Etale p₂ →
      AlgebraicGeometry.Surjective p₂ →
      ∃ (U : Z.Opens) (_ : Nonempty U)
        (V : AlgebraicGeometry.Scheme.{u})
        (p : V ⟶ (U : AlgebraicGeometry.Scheme.{u}))
        (q₁ : V ⟶ V₁) (q₂ : V ⟶ V₂),
        AlgebraicGeometry.IsIntegral V ∧
        AlgebraicGeometry.IsFinite p ∧
        AlgebraicGeometry.Etale p ∧
        AlgebraicGeometry.Surjective p ∧
        AlgebraicGeometry.Etale q₁ ∧
        AlgebraicGeometry.Etale q₂ ∧
        q₁ ≫ p₁ ≫ U₁.ι = p ≫ U.ι ∧
        q₂ ≫ p₂ ≫ U₂.ι = p ≫ U.ι := by
    intro U₁ hU₁ V₁ p₁ hFin₁ hEt₁ hSurj₁ U₂ hU₂ V₂ p₂ hFin₂ hEt₂ hSurj₂
    haveI : IrreducibleSpace ↥Z :=
      ((AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced Z).mp hIntZ).1
    let U₁₂ : Z.Opens := U₁ ⊓ U₂
    have hU₁_ne : (Set.univ ∩ (U₁ : Set ↥Z)).Nonempty := by
      rcases hU₁ with ⟨x⟩; exact ⟨x.1, trivial, x.2⟩
    have hU₂_ne : (Set.univ ∩ (U₂ : Set ↥Z)).Nonempty := by
      rcases hU₂ with ⟨x⟩; exact ⟨x.1, trivial, x.2⟩
    have hU₁₂_set : (Set.univ ∩ ((U₁ : Set ↥Z) ∩ (U₂ : Set ↥Z))).Nonempty :=
      PreirreducibleSpace.isPreirreducible_univ U₁.1 U₂.1 U₁.2 U₂.2 hU₁_ne hU₂_ne
    have hU₁₂ : Nonempty U₁₂ := by
      rcases hU₁₂_set with ⟨x, -, hx₁, hx₂⟩; exact ⟨⟨x, hx₁, hx₂⟩⟩
    let inc₁ : (U₁₂ : AlgebraicGeometry.Scheme.{u}) ⟶ (U₁ : AlgebraicGeometry.Scheme.{u}) :=
      Z.homOfLE inf_le_left
    let inc₂ : (U₁₂ : AlgebraicGeometry.Scheme.{u}) ⟶ (U₂ : AlgebraicGeometry.Scheme.{u}) :=
      Z.homOfLE inf_le_right
    haveI := hFin₁; haveI := hEt₁; haveI := hSurj₁
    haveI := hFin₂; haveI := hEt₂; haveI := hSurj₂
    let W₁ := CategoryTheory.Limits.pullback p₁ inc₁
    let j₁ : W₁ ⟶ V₁ := CategoryTheory.Limits.pullback.fst p₁ inc₁
    let π₁ : W₁ ⟶ (U₁₂ : AlgebraicGeometry.Scheme.{u}) := CategoryTheory.Limits.pullback.snd p₁ inc₁
    let W₂ := CategoryTheory.Limits.pullback p₂ inc₂
    let j₂ : W₂ ⟶ V₂ := CategoryTheory.Limits.pullback.fst p₂ inc₂
    let π₂ : W₂ ⟶ (U₁₂ : AlgebraicGeometry.Scheme.{u}) := CategoryTheory.Limits.pullback.snd p₂ inc₂
    let W₁₂ := CategoryTheory.Limits.pullback π₁ π₂
    let p₁₂ : W₁₂ ⟶ (U₁₂ : AlgebraicGeometry.Scheme.{u}) :=
      CategoryTheory.Limits.pullback.fst π₁ π₂ ≫ π₁
    let k₁ : W₁₂ ⟶ V₁ := CategoryTheory.Limits.pullback.fst π₁ π₂ ≫ j₁
    let k₂ : W₁₂ ⟶ V₂ := CategoryTheory.Limits.pullback.snd π₁ π₂ ≫ j₂
    have hk₁ : k₁ ≫ p₁ ≫ U₁.ι = p₁₂ ≫ U₁₂.ι := by
      dsimp [k₁, p₁₂, j₁, π₁]
      rw [Category.assoc, CategoryTheory.Limits.pullback.condition_assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, Category.assoc]
    have hk₂ : k₂ ≫ p₂ ≫ U₂.ι = p₁₂ ≫ U₁₂.ι := by
      dsimp [k₂, p₁₂, j₂, π₂]
      rw [Category.assoc, CategoryTheory.Limits.pullback.condition_assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, ← CategoryTheory.Limits.pullback.condition_assoc,
        Category.assoc]
    obtain ⟨U, hU, V, p, ι₁, hIntV, hFin_p, hEt_p, hSurj_p, hEt_ι₁, hComm⟩ :=
      hCoverInt U₁₂ hU₁₂ W₁₂ p₁₂ inferInstance inferInstance inferInstance
    haveI := hEt_ι₁
    refine ⟨U, hU, V, p, ι₁ ≫ k₁, ι₁ ≫ k₂, hIntV, hFin_p, hEt_p, hSurj_p,
      inferInstance, inferInstance, ?_, ?_⟩
    · rw [Category.assoc, hk₁, hComm]
    · rw [Category.assoc, hk₂, hComm]

  
  have hContMap : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (hEt : AlgebraicGeometry.Etale h),
      (show CategoryTheory.Functor X₁.Etale X₂.Etale from
        CategoryTheory.MorphismProperty.Over.map ⊤ hEt).IsContinuous
        X₁.smallEtaleTopology X₂.smallEtaleTopology := by
    intro X₁ X₂ h hEt
    let Φ_h : CategoryTheory.Functor X₁.Etale X₂.Etale :=
      CategoryTheory.MorphismProperty.Over.map ⊤ hEt
    have hCompat : CategoryTheory.CompatiblePreserving X₂.smallEtaleTopology Φ_h := by
      refine CategoryTheory.CompatiblePreserving.mk ?_
      intro ℱ Z₀ T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
      have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun u => u.left) hcomm
      have hf₁_comp : (f₁.left ≫ Y₁.hom) ≫ h = X.hom :=
        (Category.assoc f₁.left Y₁.hom h).trans f₁.w
      have hEt_lift : AlgebraicGeometry.Etale (f₁.left ≫ Y₁.hom) := by
        haveI : AlgebraicGeometry.Etale ((f₁.left ≫ Y₁.hom) ≫ h) := hf₁_comp.symm ▸ X.prop
        haveI := hEt
        exact AlgebraicGeometry.Etale.of_comp (f₁.left ≫ Y₁.hom) h
      let X_lift : X₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) hEt_lift
      let f₁' : X_lift ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk f₁.left rfl
      have hf₂_w : f₂.left ≫ Y₂.hom = X_lift.hom := by
        change f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom
        calc
          f₂.left ≫ Y₂.hom = f₂.left ≫ (g₂.left ≫ Z₀.hom) :=
            congrArg (f₂.left ≫ ·) g₂.w.symm
          _ = (f₂.left ≫ g₂.left) ≫ Z₀.hom := (Category.assoc _ _ _).symm
          _ = (f₁.left ≫ g₁.left) ≫ Z₀.hom := congrArg (· ≫ Z₀.hom) hleft.symm
          _ = f₁.left ≫ (g₁.left ≫ Z₀.hom) := Category.assoc _ _ _
          _ = f₁.left ≫ Y₁.hom := congrArg (f₁.left ≫ ·) g₁.w
      let f₂' : X_lift ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk f₂.left hf₂_w
      have hcomm' : f₁' ≫ g₁ = f₂' ≫ g₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hleft
      let e_X : X ⟶ Φ_h.obj X_lift :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 X.left)
          ((Category.id_comp ((f₁.left ≫ Y₁.hom) ≫ h)).trans hf₁_comp)
      have he₁ : e_X ≫ Φ_h.map f₁' = f₁ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext (Category.id_comp _)
      have he₂ : e_X ≫ Φ_h.map f₂' = f₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext (Category.id_comp _)
      have hx' := hx f₁' f₂' hg₁ hg₂ hcomm'
      calc
        (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map f₁.op)) (x g₁ hg₁) =
            (CategoryTheory.ConcreteCategory.hom
              (ℱ.obj.map (Φ_h.map f₁').op ≫ ℱ.obj.map e_X.op)) (x g₁ hg₁) := by
          rw [← ℱ.obj.map_comp, ← op_comp, he₁]
        _ = (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map e_X.op))
              ((CategoryTheory.ConcreteCategory.hom (ℱ.obj.map (Φ_h.map f₁').op)) (x g₁ hg₁)) :=
          CategoryTheory.ConcreteCategory.comp_apply _ _ _
        _ = (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map e_X.op))
              ((CategoryTheory.ConcreteCategory.hom (ℱ.obj.map (Φ_h.map f₂').op)) (x g₂ hg₂)) :=
          congrArg _ hx'
        _ = (CategoryTheory.ConcreteCategory.hom
              (ℱ.obj.map (Φ_h.map f₂').op ≫ ℱ.obj.map e_X.op)) (x g₂ hg₂) :=
          (CategoryTheory.ConcreteCategory.comp_apply _ _ _).symm
        _ = (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map f₂.op)) (x g₂ hg₂) := by
          rw [← ℱ.obj.map_comp, ← op_comp, he₂]
    have hCover : CategoryTheory.CoverPreserving
        X₁.smallEtaleTopology X₂.smallEtaleTopology Φ_h := by
      refine CategoryTheory.CoverPreserving.mk ?_
      intro U S hS
      rw [hMemEtale] at hS ⊢
      intro x
      obtain ⟨V, v, y, hvS, hvEt, hvy⟩ := hS x
      exact ⟨Φ_h.obj V, Φ_h.map v, y, ⟨V, v, 𝟙 _, hvS, (Category.id_comp _).symm⟩, hvEt, hvy⟩
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCover

  
  have hContPull : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (_ : AlgebraicGeometry.Etale h),
      (show CategoryTheory.Functor X₂.Etale X₁.Etale from
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h).IsContinuous
        X₂.smallEtaleTopology X₁.smallEtaleTopology := by
    intro X₁ X₂ h hEt
    let Φ_h : CategoryTheory.Functor X₁.Etale X₂.Etale :=
      CategoryTheory.MorphismProperty.Over.map ⊤ hEt
    let B_h : CategoryTheory.Functor X₂.Etale X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    let adj_site : Φ_h ⊣ B_h :=
      CategoryTheory.MorphismProperty.Over.mapPullbackAdj
        (@AlgebraicGeometry.Etale) ⊤ h hEt trivial
    haveI : CategoryTheory.Limits.HasTerminal X₂.Etale := (isTermEt X₂).hasTerminal
    haveI : CategoryTheory.Limits.HasFiniteLimits X₂.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    haveI : CategoryTheory.Limits.PreservesLimitsOfSize.{0, 0} B_h :=
      adj_site.rightAdjoint_preservesLimits
    haveI : CategoryTheory.Limits.PreservesFiniteLimits B_h := inferInstance
    haveI : CategoryTheory.RepresentablyFlat B_h :=
      CategoryTheory.flat_of_preservesFiniteLimits B_h
    have hCompat : CategoryTheory.CompatiblePreserving X₁.smallEtaleTopology B_h :=
      CategoryTheory.compatiblePreservingOfFlat X₁.smallEtaleTopology B_h
    have hCover : CategoryTheory.CoverPreserving
        X₂.smallEtaleTopology X₁.smallEtaleTopology B_h := by
      refine CategoryTheory.CoverPreserving.mk ?_
      intro U S hS
      rw [hMemEtale] at hS ⊢
      intro w
      let fstU : CategoryTheory.Limits.pullback U.hom h ⟶ U.left :=
        CategoryTheory.Limits.pullback.fst U.hom h
      let sndU : CategoryTheory.Limits.pullback U.hom h ⟶ X₁ :=
        CategoryTheory.Limits.pullback.snd U.hom h
      obtain ⟨V, v, z, hvS, hvEt, hvz⟩ := hS (fstU w)
      let fstV : CategoryTheory.Limits.pullback V.hom h ⟶ V.left :=
        CategoryTheory.Limits.pullback.fst V.hom h
      let sndV : CategoryTheory.Limits.pullback V.hom h ⟶ X₁ :=
        CategoryTheory.Limits.pullback.snd V.hom h
      have hvw : v.left ≫ U.hom = V.hom := v.w
      have hpbU : CategoryTheory.IsPullback fstU sndU U.hom h :=
        CategoryTheory.IsPullback.of_hasPullback U.hom h
      have h_map_fst : (B_h.map v).left ≫ fstU = fstV ≫ v.left := by
        dsimp [B_h, fstU, fstV]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h_map_snd : (B_h.map v).left ≫ sndU = sndV := by
        dsimp [B_h, sndU, sndV]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hpbV_flip : CategoryTheory.IsPullback sndV fstV h V.hom :=
        (CategoryTheory.IsPullback.of_hasPullback V.hom h).flip
      have hpbOuter : CategoryTheory.IsPullback ((B_h.map v).left ≫ sndU) fstV
          h (v.left ≫ U.hom) :=
        h_map_snd.symm ▸ (hvw.symm ▸ hpbV_flip)
      have hpbLeft : CategoryTheory.IsPullback fstV (B_h.map v).left v.left fstU :=
        (CategoryTheory.IsPullback.of_right hpbOuter h_map_fst hpbU.flip).flip
      obtain ⟨q, -, hqw⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z w hvz
      let e_pb := hpbLeft.isoPullback
      have he_snd : e_pb.inv ≫ (B_h.map v).left =
          CategoryTheory.Limits.pullback.snd v.left fstU :=
        hpbLeft.isoPullback_inv_snd
      haveI := hvEt
      have hEt_Bv : AlgebraicGeometry.Etale (B_h.map v).left :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hpbLeft hvEt
      refine ⟨B_h.obj V, B_h.map v, e_pb.inv q,
        ⟨V, v, 𝟙 _, hvS, (Category.id_comp _).symm⟩, hEt_Bv, ?_⟩
      have hEval := congrArg
        (fun φ : CategoryTheory.Limits.pullback v.left fstU ⟶
            CategoryTheory.Limits.pullback U.hom h => φ q)
        he_snd
      exact (AlgebraicGeometry.Scheme.Hom.comp_apply e_pb.inv (B_h.map v).left q).symm.trans
        (hEval.trans hqw)
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCover

  
  have hEtPullPkg : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (hEt : AlgebraicGeometry.Etale h),
      let Φ_h : CategoryTheory.Functor X₁.Etale X₂.Etale :=
        CategoryTheory.MorphismProperty.Over.map ⊤ hEt
      letI : Φ_h.IsContinuous X₁.smallEtaleTopology X₂.smallEtaleTopology := hContMap h hEt
      let j_pull := Φ_h.sheafPushforwardContinuous
        AddCommGrpCat.{u} X₁.smallEtaleTopology X₂.smallEtaleTopology
      ∃ (_ : CategoryTheory.Limits.PreservesFiniteLimits j_pull)
        (_ : CategoryTheory.Limits.PreservesFiniteColimits j_pull)
        (_ : j_pull.Additive),
        (∀ G F, WeilIsEtaleSheafPullback h G F ↔ Nonempty (j_pull.obj G ≅ F)) ∧
        (∀ (A : AddCommGrpCat.{u}),
          let C₁ := CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}
          let C₂ := CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}
          let adj₁ := CategoryTheory.constantSheafAdj X₁.smallEtaleTopology
            AddCommGrpCat.{u} (isTermEt X₁)
          let adj₂ := CategoryTheory.constantSheafAdj X₂.smallEtaleTopology
            AddCommGrpCat.{u} (isTermEt X₂)
          let u₁₂ : Φ_h.obj (mkTermEt X₁) ⟶ mkTermEt X₂ :=
            (isTermEt X₂).from (Φ_h.obj (mkTermEt X₁))
          ∃ (e_const : C₁.obj A ≅ j_pull.obj (C₂.obj A)),
            adj₁.homEquiv A (j_pull.obj (C₂.obj A)) e_const.hom =
              adj₂.unit.app A ≫ (C₂.obj A).obj.map u₁₂.op) := by
    intro X₁ X₂ h hEt
    let Φ_h : CategoryTheory.Functor X₁.Etale X₂.Etale :=
      CategoryTheory.MorphismProperty.Over.map ⊤ hEt
    let B_h : CategoryTheory.Functor X₂.Etale X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    haveI : Φ_h.IsContinuous X₁.smallEtaleTopology X₂.smallEtaleTopology := hContMap h hEt
    haveI : B_h.IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology := hContPull h hEt
    let j_pull := Φ_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₁.smallEtaleTopology X₂.smallEtaleTopology
    let P_push := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let adj_site : Φ_h ⊣ B_h :=
      CategoryTheory.MorphismProperty.Over.mapPullbackAdj
        (@AlgebraicGeometry.Etale) ⊤ h hEt trivial
    let adj_sh : j_pull ⊣ P_push :=
      (adj_site.op.whiskerLeft AddCommGrpCat.{u}).restrictFullyFaithful
        (CategoryTheory.fullyFaithfulSheafToPresheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.fullyFaithfulSheafToPresheaf X₁.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
