  have hEmptyBotZero : ∀ (W : AlgebraicGeometry.Scheme.{u}) (E : W.Etale),
      IsEmpty ↥E.left →
      ∀ (K : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
