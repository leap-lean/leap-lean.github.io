        change ν_h (Polynomial.eval₂ (algebraMap R₀ B₀) (a₀ i) f) = _
        rw [Polynomial.hom_eval₂, hν_alg, Polynomial.aeval_def, Polynomial.eval₂_map]
      have hw_P : ∀ i : I, w_bar i * Polynomial.aeval (a_bar i) (P i) = 0 := by
        intro i
        have h0 : ν_h (δ₄ i) = 0 :=
