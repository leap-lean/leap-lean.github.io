    obtain ⟨e₀⟩ := hR0_iso i₁ F_C₁
    let θ_iso : P_push₁.obj (P_pull₁.obj F) ≅ F₃ := (P_push₁.mapIso e_C₁).trans e₀
    let η : F ⟶ F₃ := adj₁.unit.app F ≫ θ_iso.hom
    let α : P_pull₁.obj F ⟶ P_pull₁.obj F₃ := P_pull₁.map η
