    have _ : Limits.PreservesLimitsOfShape Limits.WalkingCospan G :=
      ⟨fun {K} => Limits.preservesLimit_of_iso_diagram G (Limits.diagramIsoCospan K).symm⟩
    have _ : Limits.PreservesFiniteLimits G :=
      Limits.preservesFiniteLimits_of_preservesTerminal_and_pullbacks G
    have _ : G.IsCoverDense X.smallEtaleTopology := by
      refine Functor.IsCoverDense.mk ?_
      intro U
      refine X.smallEtaleTopology.superset_covering ?_
        (@Functor.IsCoverDense.is_cover _ _ _ _ ι_aff X.smallEtaleTopology _ U)
      intro V f hf
      rcases hf with ⟨⟨A₀, w, h, hEq⟩⟩
      let d₀ : D := ⟨0, Sum.inr (e₀.functor.obj A₀)⟩
      let θ : ι_aff.obj A₀ ≅ G.obj d₀ := ι_aff.mapIso (e₀.unitIso.app A₀)
      exact ⟨⟨d₀, w ≫ θ.hom, θ.inv ≫ h, by rw [Category.assoc, Iso.hom_inv_id_assoc, hEq]⟩⟩
    let K_D := G.inducedTopology X.smallEtaleTopology
    let F₀ : D ⥤ Y.Etale := G ⋙ B_π
    have _ := hc
    have _ : F₀.IsContinuous K_D Y.smallEtaleTopology :=
      Functor.isContinuous_comp G B_π K_D X.smallEtaleTopology Y.smallEtaleTopology
    have _ : Limits.PreservesFiniteLimits F₀ := Limits.comp_preservesFiniteLimits G B_π
    have _ : RepresentablyFlat F₀ := flat_of_preservesFiniteLimits F₀
    have _ : Limits.PreservesFiniteLimits (F₀.op.lan : (Dᵒᵖ ⥤ A) ⥤ ((Y.Etale)ᵒᵖ ⥤ A)) := by
      apply CategoryTheory.preservesFiniteLimits_of_evaluation
      intro W
      let V : Y.Etale := W.unop
      have _ : IsFiltered (CostructuredArrow F₀.op W) :=
        IsFiltered.of_equivalence (structuredArrowOpEquivalence F₀ V)
      let Colim_W : (Dᵒᵖ ⥤ A) ⥤ A :=
        (Functor.whiskeringLeft (CostructuredArrow F₀.op W) Dᵒᵖ A).obj
          (CostructuredArrow.proj F₀.op W) ⋙ Limits.colim
      have _ : Limits.PreservesFiniteLimits Colim_W := inferInstance
      let eEval : Colim_W ≅ F₀.op.lan ⋙ (evaluation (Y.Etale)ᵒᵖ A).obj W :=
        NatIso.ofComponents
          (fun P => (F₀.op.leftKanExtensionObjIsoColimit P W).symm)
          (fun {P₁ P₂} φ => by
            apply Limits.colimit.hom_ext
            intro g
            let α_φ := Functor.whiskerLeft (CostructuredArrow.proj F₀.op W) φ
            have step1 : Limits.colimit.ι (CostructuredArrow.proj F₀.op W ⋙ P₁) g ≫
                Limits.colimMap α_φ =
                φ.app g.left ≫ Limits.colimit.ι (CostructuredArrow.proj F₀.op W ⋙ P₂) g :=
              Limits.ι_colimMap α_φ g
            have step2 : Limits.colimit.ι (CostructuredArrow.proj F₀.op W ⋙ P₂) g ≫
                (F₀.op.leftKanExtensionObjIsoColimit P₂ W).inv =
                (F₀.op.leftKanExtensionUnit P₂).app g.left ≫
                  (F₀.op.leftKanExtension P₂).map g.hom :=
              Functor.ι_leftKanExtensionObjIsoColimit_inv F₀.op P₂ W g
            have step3 : φ.app g.left ≫ (F₀.op.leftKanExtensionUnit P₂).app g.left =
                (F₀.op.leftKanExtensionUnit P₁).app g.left ≫
                  (F₀.op.lan.map φ).app (F₀.op.obj g.left) :=
              NatTrans.congr_app (F₀.op.lanUnit.naturality φ) g.left
            have step4 : (F₀.op.lan.map φ).app (F₀.op.obj g.left) ≫
                (F₀.op.leftKanExtension P₂).map g.hom =
                (F₀.op.leftKanExtension P₁).map g.hom ≫ (F₀.op.lan.map φ).app W :=
              ((F₀.op.lan.map φ).naturality g.hom).symm
            have step5 : Limits.colimit.ι (CostructuredArrow.proj F₀.op W ⋙ P₁) g ≫
                (F₀.op.leftKanExtensionObjIsoColimit P₁ W).inv =
                (F₀.op.leftKanExtensionUnit P₁).app g.left ≫
                  (F₀.op.leftKanExtension P₁).map g.hom :=
              Functor.ι_leftKanExtensionObjIsoColimit_inv F₀.op P₁ W g
            exact (Category.assoc _ (Colim_W.map φ) _).symm.trans
              (((congrArg (· ≫ (F₀.op.leftKanExtensionObjIsoColimit P₂ W).inv) step1).trans
                ((Category.assoc (φ.app g.left) _ _).trans
                  ((congrArg (φ.app g.left ≫ ·) step2).trans
                    ((Category.assoc _ _ _).symm.trans
                      ((congrArg (· ≫ (F₀.op.leftKanExtension P₂).map g.hom) step3).trans
                        ((Category.assoc _ _ _).trans
                          ((congrArg ((F₀.op.leftKanExtensionUnit P₁).app g.left ≫ ·) step4).trans
                            ((Category.assoc _ _ _).symm.trans
                              (congrArg (· ≫ (F₀.op.lan.map φ).app W) step5.symm))))))))).trans
                (Category.assoc _ _ _)))
      exact Limits.preservesFiniteLimits_of_natIso eEval
    have _ : Limits.PreservesFiniteLimits (F₀.sheafPullback A K_D Y.smallEtaleTopology) :=
      inferInstance
    have hInj_F0 : CategoryTheory.Injective
        ((F₀.sheafPushforwardContinuous A K_D Y.smallEtaleTopology).obj I) :=
      (F₀.sheafAdjunctionContinuous A K_D Y.smallEtaleTopology).map_injective I hI
    let G_push := G.sheafPushforwardContinuous A K_D X.smallEtaleTopology
    let E_X := G_push.asEquivalence
    have hInj_inv : CategoryTheory.Injective
        (E_X.inverse.obj ((F₀.sheafPushforwardContinuous A K_D Y.smallEtaleTopology).obj I)) :=
      E_X.toAdjunction.map_injective _ hInj_F0
    let eComp := Functor.sheafPushforwardContinuousComp G B_π A K_D
      X.smallEtaleTopology Y.smallEtaleTopology
    let e_inj : E_X.inverse.obj ((F₀.sheafPushforwardContinuous A K_D Y.smallEtaleTopology).obj I) ≅
        π_push.obj I :=
      E_X.inverse.mapIso (eComp.symm.app I) ≪≫ (E_X.unitIso.app (π_push.obj I)).symm
    exact Injective.of_iso e_inj hInj_inv

  
  have hHasCo : Limits.HasColimitsOfShape Limits.WalkingParallelPair
      (Sheaf S.smallEtaleTopology A) := inferInstance
  have hPresheafExactToSheaf : ∀ {P₁ P₂ P₃ : (S.Etale)ᵒᵖ ⥤ A} (α : P₁ ⟶ P₂) (β : P₂ ⟶ P₃)
      (h0 : α ≫ β = 0),
      (∀ V : (S.Etale)ᵒᵖ, (ShortComplex.mk (α.app V) (β.app V)
        (NatTrans.congr_app h0 V)).Exact) →
      (ShortComplex.mk (Sh_S.map α) (Sh_S.map β)
        (by rw [← Sh_S.map_comp, h0, Sh_S.map_zero])).Exact := by
    intro P₁ P₂ P₃ α β h0 hObj
    let SC_pre := ShortComplex.mk α β h0
    have hEx_pre : SC_pre.Exact := by
      rw [ShortComplex.exact_iff_of_forks SC_pre (Limits.kernelIsKernel β)
        (Limits.cokernelIsCokernel α)]
      apply NatTrans.ext
      funext V
      let ev := (evaluation (S.Etale)ᵒᵖ A).obj V
      have hV : Limits.kernel.ι (β.app V) ≫ Limits.cokernel.π (α.app V) = 0 :=
        (ShortComplex.exact_iff_of_forks
          (ShortComplex.mk (α.app V) (β.app V) (NatTrans.congr_app h0 V))
          (Limits.kernelIsKernel (β.app V)) (Limits.cokernelIsCokernel (α.app V))).mp (hObj V)
      have hV' : Limits.kernel.ι (ev.map β) ≫ Limits.cokernel.π (ev.map α) = 0 := hV
      change ev.map (Limits.kernel.ι β) ≫ ev.map (Limits.cokernel.π α) = 0
      rw [← Limits.kernelComparison_comp_ι β ev, ← Limits.π_comp_cokernelComparison α ev,
        Category.assoc, ← Category.assoc (Limits.kernel.ι (ev.map β)), hV',
        Limits.zero_comp, Limits.comp_zero]
    exact hEx_pre.map Sh_S

  have hInjZero : ∀ {T : Scheme.{u}} (B_g : S.Etale ⥤ T.Etale)
      (J_inj : Sheaf T.smallEtaleTopology A) [CategoryTheory.Injective J_inj] (m : ℕ),
      Limits.IsZero (Sh_S.obj (B_g.op ⋙ J_inj.cohomologyPresheaf (m + 1))) := by
    intro T B_g J_inj _ m
    have hId0 : 𝟙 (B_g.op ⋙ J_inj.cohomologyPresheaf (m + 1)) = 0 := by
      apply NatTrans.ext
      funext V
      ext x
      exact @Subsingleton.elim _ (Abelian.Ext.subsingleton_of_injective _ J_inj m) x _
    rw [Limits.IsZero.iff_id_eq_zero, ← Sh_S.map_id, hId0, Sh_S.map_zero]

  have hLES_pair : ∀ {T : Scheme.{u}} (B_g : S.Etale ⥤ T.Etale)
      (SC : ShortComplex (Sheaf T.smallEtaleTopology A)) (hSE : SC.ShortExact) (n : ℕ),
      let R_g : ℕ → (Sheaf T.smallEtaleTopology A ⥤ Sheaf S.smallEtaleTopology A) :=
        fun k => Sheaf.cohomologyPresheafFunctor T.smallEtaleTopology k ⋙
          ((Functor.whiskeringLeft (S.Etale)ᵒᵖ (T.Etale)ᵒᵖ A).obj B_g.op ⋙ Sh_S)
      ∃ (δ : (R_g n).obj SC.X₃ ⟶ (R_g (n + 1)).obj SC.X₁)
        (h1 : (R_g n).map SC.g ≫ δ = 0)
        (h2 : δ ≫ (R_g (n + 1)).map SC.f = 0),
        (ShortComplex.mk ((R_g n).map SC.g) δ h1).Exact ∧
        (ShortComplex.mk δ ((R_g (n + 1)).map SC.f) h2).Exact := by
    intro T B_g SC hSE n R_g
    let L_T : T.Etale ⥤ Sheaf T.smallEtaleTopology A :=
      yoneda ⋙ (Functor.whiskeringRight (T.Etale)ᵒᵖ (Type u) A).obj AddCommGrpCat.free ⋙
        presheafToSheaf T.smallEtaleTopology A
    let δ_pre : SC.X₃.cohomologyPresheaf n ⟶ SC.X₁.cohomologyPresheaf (n + 1) :=
      { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (L_T.obj W.unop) rfl)
        naturality := fun {W₁ W₂} w => by
          ext x
          exact Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (L_T.map w.unop)) x hSE.extClass
            (Nat.zero_add n) rfl (Nat.zero_add (n + 1)) }
    let g_pre : SC.X₂.cohomologyPresheaf n ⟶ SC.X₃.cohomologyPresheaf n :=
      (Sheaf.cohomologyPresheafFunctor T.smallEtaleTopology n).map SC.g
    let f_pre : SC.X₁.cohomologyPresheaf (n + 1) ⟶ SC.X₂.cohomologyPresheaf (n + 1) :=
      (Sheaf.cohomologyPresheafFunctor T.smallEtaleTopology (n + 1)).map SC.f
    let α₁ := Functor.whiskerLeft B_g.op g_pre
    let β₁ := Functor.whiskerLeft B_g.op δ_pre
    let γ₁ := Functor.whiskerLeft B_g.op f_pre
    have h0_1 : α₁ ≫ β₁ = 0 := by
      ext V : 2
      exact (fun {S₀ : ShortComplex A} (_ : S₀.Exact) => S₀.zero)
        (Abelian.Ext.covariant_sequence_exact₃' (L_T.obj (B_g.obj V.unop)) hSE n (n + 1) rfl)
    have h0_2 : β₁ ≫ γ₁ = 0 := by
      ext V : 2
      exact (fun {S₀ : ShortComplex A} (_ : S₀.Exact) => S₀.zero)
        (Abelian.Ext.covariant_sequence_exact₁' (L_T.obj (B_g.obj V.unop)) hSE n (n + 1) rfl)
    refine ⟨Sh_S.map β₁,
      by dsimp [R_g, α₁]; rw [← Sh_S.map_comp, h0_1, Sh_S.map_zero],
      by dsimp [R_g, γ₁]; rw [← Sh_S.map_comp, h0_2, Sh_S.map_zero],
      hPresheafExactToSheaf α₁ β₁ h0_1 (fun V =>
        Abelian.Ext.covariant_sequence_exact₃' (L_T.obj (B_g.obj V.unop)) hSE n (n + 1) rfl),
      hPresheafExactToSheaf β₁ γ₁ h0_2 (fun V =>
        Abelian.Ext.covariant_sequence_exact₁' (L_T.obj (B_g.obj V.unop)) hSE n (n + 1) rfl)⟩

  have hCokernelIso : ∀ {M₁ M₂ M₃ M₄ : Sheaf S.smallEtaleTopology A}
      (u : M₁ ⟶ M₂) (v : M₂ ⟶ M₃) (w : M₃ ⟶ M₄)
      (huv : u ≫ v = 0) (hvw : v ≫ w = 0),
      (ShortComplex.mk u v huv).Exact →
      (ShortComplex.mk v w hvw).Exact →
      Limits.IsZero M₄ →
      Nonempty (Limits.cokernel u ≅ M₃) := by
    intro M₁ M₂ M₃ M₄ u v w huv hvw hex_uv hex_vw hZ₄
    have hw0 : w = 0 := hZ₄.eq_of_tgt w 0
    have _ : Epi v := hex_vw.epi_f hw0
    have hcok : Limits.IsColimit (Limits.CokernelCofork.ofπ v huv) := hex_uv.gIsCokernel
    exact ⟨Limits.IsColimit.coconePointUniqueUpToIso (Limits.cokernelIsCokernel u) hcok⟩

  have hMidIso : ∀ {M₁ M₂ M₃ M₄ : Sheaf S.smallEtaleTopology A}
      (u : M₁ ⟶ M₂) (v : M₂ ⟶ M₃) (w : M₃ ⟶ M₄)
      (huv : u ≫ v = 0) (hvw : v ≫ w = 0),
      (ShortComplex.mk u v huv).Exact →
      (ShortComplex.mk v w hvw).Exact →
      Limits.IsZero M₁ →
      Limits.IsZero M₄ →
      Nonempty (M₂ ≅ M₃) := by
    intro M₁ M₂ M₃ M₄ u v w huv hvw hex_uv hex_vw hZ₁ hZ₄
    have hu0 : u = 0 := hZ₁.eq_of_src u 0
    have hw0 : w = 0 := hZ₄.eq_of_tgt w 0
    have _ : Mono v := hex_uv.mono_g hu0
    have _ : Epi v := hex_vw.epi_f hw0
    have _ : IsIso v := isIso_of_mono_of_epi v
    exact ⟨asIso v⟩

  
  obtain ⟨β₀⟩ := hβ₀
  have hDimShift : ∀ (q' : ℕ) (G : Sheaf Y.smallEtaleTopology A),
      Nonempty ((R_p q').obj (π_push.obj G) ≅ (R_πp q').obj G) := by
    intro q'
    induction q' with
    | zero =>
      intro G
      exact ⟨β₀.app G⟩
    | succ n ih =>
      intro G
      let pres := (EnoughInjectives.presentation G).some
      let I : Sheaf Y.smallEtaleTopology A := pres.J
      have _ : CategoryTheory.Injective I := pres.injective
      let ι : G ⟶ I := pres.f
      have _ : Mono ι := pres.mono
      let Q : Sheaf Y.smallEtaleTopology A := Limits.cokernel ι
      let π_Q : I ⟶ Q := Limits.cokernel.π ι
      let SC_Y : ShortComplex (Sheaf Y.smallEtaleTopology A) :=
        ShortComplex.mk ι π_Q (Limits.cokernel.condition ι)
      have hSE_Y : SC_Y.ShortExact := { exact := ShortComplex.exact_cokernel ι }
      let SC_X := SC_Y.map π_push
      have hSE_X : SC_X.ShortExact := hSE_push SC_Y hSE_Y
      have _ : CategoryTheory.Injective (π_push.obj I) := hInj_push I inferInstance
      cases n with
      | zero =>
        obtain ⟨δ_X, h1_X, h2_X, hex3_X, hex1_X⟩ := hLES_pair B_p SC_X hSE_X 0
        obtain ⟨δ_Y, h1_Y, h2_Y, hex3_Y, hex1_Y⟩ := hLES_pair B_πp SC_Y hSE_Y 0
        have hZ_X : Limits.IsZero ((R_p 1).obj (π_push.obj I)) :=
          hInjZero B_p (π_push.obj I) 0
        have hZ_Y : Limits.IsZero ((R_πp 1).obj I) := hInjZero B_πp I 0
        obtain ⟨e_L⟩ := hCokernelIso ((R_p 0).map (π_push.map π_Q)) δ_X
          ((R_p 1).map (π_push.map ι)) h1_X h2_X hex3_X hex1_X hZ_X
        obtain ⟨e_R⟩ := hCokernelIso ((R_πp 0).map π_Q) δ_Y
          ((R_πp 1).map ι) h1_Y h2_Y hex3_Y hex1_Y hZ_Y
        have hSq : (R_p 0).map (π_push.map π_Q) ≫ β₀.hom.app Q =
            β₀.hom.app I ≫ (R_πp 0).map π_Q :=
          β₀.hom.naturality π_Q
        have _ : Limits.HasCokernel ((R_p 0).map (π_push.map π_Q)) := hHasCo.has_colimit _
        have _ : Limits.HasCokernel ((R_πp 0).map π_Q) := hHasCo.has_colimit _
        let e_cok : Limits.cokernel ((R_p 0).map (π_push.map π_Q)) ≅
            Limits.cokernel ((R_πp 0).map π_Q) :=
          Limits.cokernel.mapIso _ _ (β₀.app I) (β₀.app Q) hSq
        exact ⟨e_L.symm ≪≫ e_cok ≪≫ e_R⟩
      | succ m =>
        obtain ⟨δ_X, h1_X, h2_X, hex3_X, hex1_X⟩ := hLES_pair B_p SC_X hSE_X (m + 1)
        obtain ⟨δ_Y, h1_Y, h2_Y, hex3_Y, hex1_Y⟩ := hLES_pair B_πp SC_Y hSE_Y (m + 1)
        have hZ1_X : Limits.IsZero ((R_p (m + 1)).obj (π_push.obj I)) :=
          hInjZero B_p (π_push.obj I) m
        have hZ2_X : Limits.IsZero ((R_p (m + 2)).obj (π_push.obj I)) :=
          hInjZero B_p (π_push.obj I) (m + 1)
        have hZ1_Y : Limits.IsZero ((R_πp (m + 1)).obj I) := hInjZero B_πp I m
        have hZ2_Y : Limits.IsZero ((R_πp (m + 2)).obj I) := hInjZero B_πp I (m + 1)
        obtain ⟨e_δX⟩ := hMidIso ((R_p (m + 1)).map (π_push.map π_Q)) δ_X
          ((R_p (m + 2)).map (π_push.map ι)) h1_X h2_X hex3_X hex1_X hZ1_X hZ2_X
        obtain ⟨e_δY⟩ := hMidIso ((R_πp (m + 1)).map π_Q) δ_Y
          ((R_πp (m + 2)).map ι) h1_Y h2_Y hex3_Y hex1_Y hZ1_Y hZ2_Y
        obtain ⟨e_IH⟩ := ih Q
        exact ⟨e_δX.symm ≪≫ e_IH ≪≫ e_δY⟩

  
  let e_π : weilEtaleHigherDirectImage π 0 F ≅ π_push.obj F := α_π.app F
  let e_map : weilEtaleHigherDirectImage p q (weilEtaleHigherDirectImage π 0 F) ≅
      (R_p q).obj (π_push.obj F) :=
    (R_p q).mapIso e_π
  obtain ⟨e_comp⟩ := hDimShift q F
  exact ⟨e_map.trans e_comp⟩

theorem weil_etale_surj_closed_iso_and_conductor_excision (hFinEpi : ∀ {Y X : AlgebraicGeometry.Scheme.{u}} (π : Y ⟶ X) [AlgebraicGeometry.IsFinite π],
      let B_π : CategoryTheory.Functor X.Etale Y.Etale :=
        (let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) π :=
           CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
         let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
            (@AlgebraicGeometry.Etale) π :=
           CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
             (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
         CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ π);
      ∃ (hc : CategoryTheory.Functor.IsContinuous B_π X.smallEtaleTopology Y.smallEtaleTopology),
        ∀ {F₁ F₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
          (v : F₁ ⟶ F₂) [CategoryTheory.Epi v],
          CategoryTheory.Epi
            ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B_π AddCommGrpCat.{u} _
              X.smallEtaleTopology Y.smallEtaleTopology hc).map v)) :
    (∀ (Y₀ Y : AlgebraicGeometry.Scheme.{u}) (i : Y₀ ⟶ Y)
        [AlgebraicGeometry.IsClosedImmersion i] [AlgebraicGeometry.Surjective i] (m : ℕ),
      Nonempty (weilEtaleHigherDirectImage i 0 (weilEtaleTorsionSheaf Y₀ m) ≅
        weilEtaleTorsionSheaf Y m)) ∧
    (∀ (ℓ : ℕ) (Y₀ W : AlgebraicGeometry.Scheme.{u}) (i_W : W ⟶ Y₀)
        [AlgebraicGeometry.IsClosedImmersion i_W]
        (s : ℕ) (C : Fin s → AlgebraicGeometry.Scheme.{u})
        (μ : ∀ j : Fin s, C j ⟶ Y₀)
        (_ : ∀ j : Fin s, AlgebraicGeometry.IsFinite (μ j))
        (U_comp : Fin s → Y₀.Opens),
      (⋃ j : Fin s, Set.range (μ j).base) = Set.univ →
      (∀ j : Fin s, (U_comp j : Set Y₀) ⊆ (Set.range i_W.base)ᶜ) →
      ((Set.range i_W.base)ᶜ : Set Y₀) ⊆ (⋃ j : Fin s, (U_comp j : Set Y₀)) →
      (∀ i j : Fin s, i ≠ j → Disjoint (U_comp i) (U_comp j)) →
      (∀ i j : Fin s, i ≠ j → ((μ j).base) ⁻¹' (U_comp i : Set Y₀) = ∅) →
      (∀ j : Fin s, CategoryTheory.IsIso ((μ j) ∣_ (U_comp j))) →
      ∀ (P : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u} → Prop),
        (∀ F, CategoryTheory.Limits.IsZero F → P F) →
        (∀ F₁ F₂ (i : F₁ ⟶ F₂) (r : F₂ ⟶ F₁), i ≫ r = 𝟙 F₁ → P F₂ → P F₁) →
        (∀ (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u})),
            SC.ShortExact → ℓ • 𝟙 SC.X₂ = 0 →
            ((P SC.X₁ ∧ P SC.X₃ → P SC.X₂) ∧ (P SC.X₂ ∧ P SC.X₃ → P SC.X₁))) →
        P (weilEtaleHigherDirectImage i_W 0 (weilEtaleTorsionSheaf W ℓ)) →
        (∀ j : Fin s, P (weilEtaleHigherDirectImage (μ j) 0 (weilEtaleTorsionSheaf (C j) ℓ))) →
        (∀ j : Fin s, P (weilEtaleHigherDirectImage
          (CategoryTheory.Limits.pullback.fst (μ j) i_W ≫ μ j) 0
          (weilEtaleTorsionSheaf (CategoryTheory.Limits.pullback (μ j) i_W) ℓ))) →
        P (weilEtaleTorsionSheaf Y₀ ℓ)) :=
by
  classical
  let P_et : MorphismProperty Scheme.{u} := @Etale
  
  let locConstPresheaf : ∀ (T : Scheme.{u}) (A : AddCommGrpCat.{u}),
      (T.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := fun T A =>
    { obj := fun U => AddCommGrpCat.of (LocallyConstant ↥(Opposite.unop U).left ↥A)
      map := fun f => AddCommGrpCat.ofHom
        (LocallyConstant.comapAddMonoidHom
          (((Scheme.Etale.forget T).map f.unop).left.base.hom))
      map_id := fun _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl
      map_comp := fun _ _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }
  let closedComplSubgroup : ∀ (T Z : Scheme.{u}) (k_Z : Z ⟶ T)
      (A : AddCommGrpCat.{u}) (U : T.Etale),
      AddSubgroup (LocallyConstant ↥U.left ↥A) := fun T Z k_Z A U =>
    { carrier := { f : LocallyConstant ↥U.left ↥A |
        ∀ u : ↥U.left, U.hom.base u ∈ Set.range k_Z.base → f u = 0 }
      zero_mem' := fun _ _ => rfl
      add_mem' := fun {a b} ha hb u hu =>
        (congrArg₂ (· + ·) (ha u hu) (hb u hu)).trans (add_zero 0)
      neg_mem' := fun {a} ha u hu =>
        (congrArg Neg.neg (ha u hu)).trans neg_zero }
  let closedComplPresheaf : ∀ (T Z : Scheme.{u}) (k_Z : Z ⟶ T) (A : AddCommGrpCat.{u}),
      (T.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := fun T Z k_Z A =>
    { obj := fun U => AddCommGrpCat.of ↥(closedComplSubgroup T Z k_Z A (Opposite.unop U))
      map := fun {U V} f => AddCommGrpCat.ofHom
        { toFun := fun g =>
            ⟨LocallyConstant.comapAddMonoidHom
               (((Scheme.Etale.forget T).map f.unop).left.base.hom) g.1,
             fun v hv => g.2 (((Scheme.Etale.forget T).map f.unop).left.base v)
               (by
                 have hw := MorphismProperty.Over.w f.unop
                 have hpt : (((Scheme.Etale.forget T).map f.unop).left ≫
                     (Opposite.unop U).hom).base v = (Opposite.unop V).hom.base v :=
                   congrArg (fun m => m.base v) hw
                 exact hpt.symm ▸ hv)⟩
          map_zero' := Subtype.ext (LocallyConstant.ext fun _ => rfl)
          map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
      map_id := fun _ => AddCommGrpCat.ext fun _ => Subtype.ext (LocallyConstant.ext fun _ => rfl)
      map_comp := fun _ _ => AddCommGrpCat.ext fun _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }

  
  have mem_smallEtaleTopology_iff : ∀ {T : Scheme.{u}} (U : T.Etale) (S : Sieve U),
      S ∈ T.smallEtaleTopology U ↔
        ∀ x : ↥U.left, ∃ (V : T.Etale) (f : V ⟶ U) (y : ↥V.left),
          S.arrows f ∧ Etale f.left ∧ f.left.base y = x := by
    intro T U S
    have h_gen : ∀ (U₀ : P_et.Over ⊤ T) (S₀ : Sieve U₀),
        S₀ ∈ (Scheme.smallGrothendieckTopology (S := T) P_et) U₀ ↔
          ∀ x : ↥U₀.left, ∃ (Y₀ : P_et.Over ⊤ T) (f : Y₀ ⟶ U₀) (y : ↥Y₀.left),
            S₀.arrows f ∧ P_et f.left ∧ f.left.base y = x := by
      intro U₀ S₀
      rw [Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology (P := P_et) (S := T)]
      · exact Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U₀ S₀
      · exact le_refl P_et
    exact h_gen U S

  have etale_of_etaleHom : ∀ {T : Scheme.{u}} {V U : T.Etale} (f : V ⟶ U),
      Etale (((Scheme.Etale.forget T).map f).left) := by
    intro T V U f
    exact MorphismProperty.of_postcomp P_et (((Scheme.Etale.forget T).map f).left) U.hom U.prop
      ((MorphismProperty.Over.w f).symm ▸ V.prop)

  have subsingleton_of_empty : ∀ {T : Scheme.{u}}
      (G : Sheaf T.smallEtaleTopology AddCommGrpCat.{u}) (W₀ : T.Etale),
      IsEmpty ↥W₀.left → Subsingleton ↥(G.obj.obj (Opposite.op W₀)) := by
    intro T G W₀ hEmpty
    let G_type := (sheafCompose T.smallEtaleTopology (forget AddCommGrpCat.{u})).obj G
    have hSh : Presieve.IsSheaf T.smallEtaleTopology G_type.obj :=
      (isSheaf_iff_isSheaf_of_type T.smallEtaleTopology G_type.obj).mp G_type.property
    have hBot : Sieve.generate (⊥ : Presieve W₀) ∈ T.smallEtaleTopology W₀ := by
      rw [mem_smallEtaleTopology_iff]
      intro x
      exact IsEmpty.elim hEmpty x
    have hFor : Presieve.IsSheafFor G_type.obj (⊥ : Presieve W₀) := hSh.isSheafFor ⊥ hBot
    exact ⟨fun s₁ s₂ => hFor.isSeparatedFor.ext fun _ _ hf => False.elim hf⟩

  
  have locConst_isSheaf : ∀ (T : Scheme.{u}) (A : AddCommGrpCat.{u}),
      Presheaf.IsSheaf T.smallEtaleTopology (locConstPresheaf T A) := by
    intro T A
    apply Presheaf.isSheaf_of_isSheaf_comp T.smallEtaleTopology (locConstPresheaf T A)
      (forget AddCommGrpCat.{u})
    rw [isSheaf_iff_isSheaf_of_type]
    intro U S hS
    have hcov : ∀ u : ↥U.left, ∃ (V : T.Etale) (f : V ⟶ U) (v : ↥V.left),
        S.arrows f ∧ (((Scheme.Etale.forget T).map f).left).base v = u := by
      intro u
      obtain ⟨V, f, v, hfS, _, hfv⟩ := (mem_smallEtaleTopology_iff U S).mp hS u
      exact ⟨V, f, v, hfS, hfv⟩
    intro fam hcompat
    let fam_lc : ∀ {V : T.Etale} (f : V ⟶ U), S.arrows f → LocallyConstant ↥V.left ↥A :=
      fun f hf => fam f hf
    have hoverlap : ∀ {V₁ V₂ : T.Etale} {f₁ : V₁ ⟶ U} {f₂ : V₂ ⟶ U}
        (hf₁ : S.arrows f₁) (hf₂ : S.arrows f₂) (v₁ : ↥V₁.left) (v₂ : ↥V₂.left),
        (((Scheme.Etale.forget T).map f₁).left).base v₁ =
          (((Scheme.Etale.forget T).map f₂).left).base v₂ →
        fam_lc f₁ hf₁ v₁ = fam_lc f₂ hf₂ v₂ := by
      intro V₁ V₂ f₁ f₂ hf₁ hf₂ v₁ v₂ hv
      let U_s : Scheme.{u} := U.left
      let V₁_s : Scheme.{u} := V₁.left
      let V₂_s : Scheme.{u} := V₂.left
      let v₁_hom : V₁_s ⟶ T := V₁.hom
      let f₁_s : V₁_s ⟶ U_s := ((Scheme.Etale.forget T).map f₁).left
      let f₂_s : V₂_s ⟶ U_s := ((Scheme.Etale.forget T).map f₂).left
      have _ : Etale v₁_hom := V₁.prop
      have _ : Etale f₂_s := etale_of_etaleHom f₂
      have hEt_P : P_et (Limits.pullback.fst f₁_s f₂_s ≫ v₁_hom) := by
        change Etale (Limits.pullback.fst f₁_s f₂_s ≫ v₁_hom)
        infer_instance
      let P₁₂ : T.Etale := MorphismProperty.Over.mk (P := P_et) ⊤
        (Limits.pullback.fst f₁_s f₂_s ≫ v₁_hom) hEt_P
      let p₁ : P₁₂ ⟶ V₁ := MorphismProperty.Over.homMk (Limits.pullback.fst f₁_s f₂_s) rfl trivial
      let p₂ : P₁₂ ⟶ V₂ := MorphismProperty.Over.homMk (Limits.pullback.snd f₁_s f₂_s)
        ((congrArg (Limits.pullback.snd f₁_s f₂_s ≫ ·) (MorphismProperty.Over.w f₂).symm).trans
          ((Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ U.hom) (Limits.pullback.condition (f := f₁_s) (g := f₂_s)).symm).trans
              ((Category.assoc _ _ _).trans
                (congrArg (Limits.pullback.fst f₁_s f₂_s ≫ ·) (MorphismProperty.Over.w f₁))))))
        trivial
      have hp_eq : p₁ ≫ f₁ = p₂ ≫ f₂ :=
        MorphismProperty.Over.Hom.ext (Limits.pullback.condition (f := f₁_s) (g := f₂_s))
      obtain ⟨z, hz₁, hz₂⟩ :=
        Scheme.Pullback.exists_preimage_pullback (f := f₁_s) (g := f₂_s) v₁ v₂ hv
      have hc := hcompat p₁ p₂ hf₁ hf₂ hp_eq
      have hc_z : fam_lc f₁ hf₁ ((Limits.pullback.fst f₁_s f₂_s).base z) =
          fam_lc f₂ hf₂ ((Limits.pullback.snd f₁_s f₂_s).base z) :=
        congrArg (fun g : LocallyConstant ↥P₁₂.left ↥A => g z) hc
      exact (congrArg (fam_lc f₁ hf₁) hz₁.symm).trans
        (hc_z.trans (congrArg (fam_lc f₂ hf₂) hz₂))
    let t_fun : ↥U.left → ↥A := fun u =>
      fam_lc (hcov u).choose_spec.choose (hcov u).choose_spec.choose_spec.choose_spec.1
        (hcov u).choose_spec.choose_spec.choose
    have ht_pull : ∀ {V : T.Etale} (f : V ⟶ U) (hf : S.arrows f) (v : ↥V.left),
        t_fun ((((Scheme.Etale.forget T).map f).left).base v) = fam_lc f hf v := by
      intro V f hf v
      let u := (((Scheme.Etale.forget T).map f).left).base v
      exact hoverlap (hcov u).choose_spec.choose_spec.choose_spec.1 hf
        (hcov u).choose_spec.choose_spec.choose v
        (hcov u).choose_spec.choose_spec.choose_spec.2
    have ht_lc : IsLocallyConstant t_fun := by
      intro M₀
      rw [isOpen_iff_forall_mem_open]
      intro u hu
      let V := (hcov u).choose
      let f := (hcov u).choose_spec.choose
      let v := (hcov u).choose_spec.choose_spec.choose
      let hf := (hcov u).choose_spec.choose_spec.choose_spec.1
      have hfv : (((Scheme.Etale.forget T).map f).left).base v = u :=
        (hcov u).choose_spec.choose_spec.choose_spec.2
      let f_s := ((Scheme.Etale.forget T).map f).left
      have _ : Etale f_s := etale_of_etaleHom f
      have _ : UniversallyOpen f_s := inferInstance
      let g_f : LocallyConstant ↥V.left ↥A := fam_lc f hf
      have hv_mem : v ∈ g_f ⁻¹' M₀ := hu
      have hO_open : IsOpen (g_f ⁻¹' M₀) := g_f.isLocallyConstant M₀
      refine ⟨f_s.base '' (g_f ⁻¹' M₀), ?_, f_s.isOpenMap _ hO_open, ⟨v, hv_mem, hfv⟩⟩
      rintro u' ⟨v', hv', rfl⟩
      change t_fun (f_s.base v') ∈ M₀
      rw [ht_pull f hf v']
      exact hv'
    let t_sec : LocallyConstant ↥U.left ↥A := ⟨t_fun, ht_lc⟩
    refine ⟨t_sec, ?_, ?_⟩
    · intro V f hf
      exact LocallyConstant.ext fun v => ht_pull f hf v
    · intro y hy
      let y_lc : LocallyConstant ↥U.left ↥A := y
      apply LocallyConstant.ext
      intro u
      let V := (hcov u).choose
      let f := (hcov u).choose_spec.choose
      let v := (hcov u).choose_spec.choose_spec.choose
      let hf := (hcov u).choose_spec.choose_spec.choose_spec.1
      have hfv : (((Scheme.Etale.forget T).map f).left).base v = u :=
        (hcov u).choose_spec.choose_spec.choose_spec.2
      have hy_f : y_lc ((((Scheme.Etale.forget T).map f).left).base v) = fam_lc f hf v :=
        congrArg (fun g : LocallyConstant ↥V.left ↥A => g v) (hy f hf)
      rwa [hfv] at hy_f

  have closedCompl_isSheaf : ∀ (T Z : Scheme.{u}) (k_Z : Z ⟶ T) (A : AddCommGrpCat.{u}),
      Presheaf.IsSheaf T.smallEtaleTopology (closedComplPresheaf T Z k_Z A) := by
    intro T Z k_Z A
    apply Presheaf.isSheaf_of_isSheaf_comp T.smallEtaleTopology
      (closedComplPresheaf T Z k_Z A) (forget AddCommGrpCat.{u})
    rw [isSheaf_iff_isSheaf_of_type]
    have hShL : Presieve.IsSheaf T.smallEtaleTopology
        (locConstPresheaf T A ⋙ forget AddCommGrpCat.{u}) :=
      (isSheaf_iff_isSheaf_of_type T.smallEtaleTopology _).mp
        (Presheaf.isSheaf_comp_of_isSheaf T.smallEtaleTopology (locConstPresheaf T A)
          (forget AddCommGrpCat.{u}) (locConst_isSheaf T A))
    intro U S hS fam hcompat
    have hGenS : Sieve.generate S.arrows ∈ T.smallEtaleTopology U := by
      rw [Sieve.generate_sieve]
      exact hS
    let famL : Presieve.FamilyOfElements
        (locConstPresheaf T A ⋙ forget AddCommGrpCat.{u}) S.arrows :=
      fun W f hf => (fam f hf : ↥(closedComplSubgroup T Z k_Z A W)).1
    have hcompatL : famL.Compatible := by
      intro Y₁ Y₂ Z₀ g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      exact congrArg Subtype.val (hcompat g₁ g₂ hf₁ hf₂ hcomm)
    obtain ⟨tL, htL_res, htL_uniq⟩ := hShL.isSheafFor S.arrows hGenS famL hcompatL
    let tL_lc : LocallyConstant ↥U.left ↥A := tL
    have htL_mem : tL_lc ∈ closedComplSubgroup T Z k_Z A U := by
      intro u hu
      obtain ⟨V, f, v, hfS, _, hfv⟩ := (mem_smallEtaleTopology_iff U S).mp hS u
      let fam_v : ↥(closedComplSubgroup T Z k_Z A V) := fam f hfS
      have hres_v : tL_lc ((((Scheme.Etale.forget T).map f).left).base v) = fam_v.1 v :=
        congrArg (fun g : LocallyConstant ↥V.left ↥A => g v) (htL_res f hfS)
      have hres_u : tL_lc u = fam_v.1 v :=
        (congrArg tL_lc hfv.symm).trans hres_v
      rw [hres_u]
      apply fam_v.2 v
      have hw_f : V.hom.base v = U.hom.base (f.left.base v) :=
        (congrArg (fun m : V.left ⟶ T => m.base v) (MorphismProperty.Over.w f)).symm
      exact (hw_f.trans (congrArg U.hom.base hfv)).symm ▸ hu
    refine ⟨(⟨tL_lc, htL_mem⟩ : ↥(closedComplSubgroup T Z k_Z A U)), ?_, ?_⟩
    · intro V f hf
      exact Subtype.ext (htL_res f hf)
    · intro y hy
      let y_sub : ↥(closedComplSubgroup T Z k_Z A U) := y
      apply Subtype.ext
      apply htL_uniq y_sub.1
      intro V f hf
      exact congrArg Subtype.val (hy f hf)

  
  have constSheaf_iso_locConst : ∀ (T : Scheme.{u}) (A : AddCommGrpCat.{u}),
      Nonempty (((constantSheaf T.smallEtaleTopology AddCommGrpCat.{u}).obj A) ≅
        ⟨locConstPresheaf T A, locConst_isSheaf T A⟩) := by
    intro T A
    let J := T.smallEtaleTopology
    let L_A : Sheaf J AddCommGrpCat.{u} := ⟨locConstPresheaf T A, locConst_isSheaf T A⟩
    let C_pre : (T.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := (Functor.const (T.Etale)ᵒᵖ).obj A
    let C_A : Sheaf J AddCommGrpCat.{u} := (constantSheaf J AddCommGrpCat.{u}).obj A
    let adj_sh := sheafificationAdjunction J AddCommGrpCat.{u}
    let ν : C_pre ⟶ L_A.obj :=
      { app := fun U => AddCommGrpCat.ofHom LocallyConstant.constAddMonoidHom
        naturality := fun _ _ _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }
    have hUniv : ∀ (G : Sheaf J AddCommGrpCat.{u}) (ψ : C_pre ⟶ G.obj),
        ∃! (Φ : L_A ⟶ G), ν ≫ Φ.hom = ψ := by
      intro G ψ
      let G_type := (sheafCompose J (forget AddCommGrpCat.{u})).obj G
      have hShG : Presieve.IsSheaf J G_type.obj :=
        (isSheaf_iff_isSheaf_of_type J G_type.obj).mp G_type.property
      let O_f : ∀ (U : T.Etale) (f : LocallyConstant ↥U.left ↥A) (a : ↥A),
          (U.left : Scheme.{u}).Opens :=
        fun U f a => ⟨f ⁻¹' {a}, f.isLocallyConstant {a}⟩
      have hEt_Vf : ∀ (U : T.Etale) (f : LocallyConstant ↥U.left ↥A) (a : ↥A),
          P_et ((O_f U f a).ι ≫ U.hom) := by
        intro U f a
        let U_s : Scheme.{u} := U.left
        let u_hom : U_s ⟶ T := U.hom
        have _ : Etale u_hom := U.prop
        let O_a : U_s.Opens := O_f U f a
        change Etale (O_a.ι ≫ u_hom)
        infer_instance
      let V_f : ∀ (U : T.Etale) (f : LocallyConstant ↥U.left ↥A) (a : ↥A), T.Etale :=
        fun U f a => MorphismProperty.Over.mk (P := P_et) ⊤ ((O_f U f a).ι ≫ U.hom) (hEt_Vf U f a)
      let j_f : ∀ (U : T.Etale) (f : LocallyConstant ↥U.left ↥A) (a : ↥A), V_f U f a ⟶ U :=
        fun U f a => MorphismProperty.Over.homMk (O_f U f a).ι rfl trivial
      have hMono_jf : ∀ (U : T.Etale) (f : LocallyConstant ↥U.left ↥A) (a : ↥A),
          Mono (j_f U f a) := by
        intro U f a
        let U_s : Scheme.{u} := U.left
        let O_a : U_s.Opens := O_f U f a
        have _ : Mono O_a.ι := inferInstance
        exact ⟨fun u₁ u₂ hu => MorphismProperty.Over.Hom.ext
          ((cancel_mono O_a.ι).mp
            (congrArg (fun k => ((Scheme.Etale.forget T).map k).left) hu))⟩
      let S_f : ∀ (U : T.Etale) (f : LocallyConstant ↥U.left ↥A), Sieve U :=
        fun U f => Sieve.ofArrows (V_f U f) (j_f U f)
      have hSf_mem : ∀ (U : T.Etale) (f : LocallyConstant ↥U.left ↥A), S_f U f ∈ J U := by
        intro U f
        rw [mem_smallEtaleTopology_iff]
        intro u
        let U_s : Scheme.{u} := U.left
        let a := f u
        let O_a : U_s.Opens := O_f U f a
        have hu_mem : u ∈ O_a := rfl
        have hEt_j : Etale (j_f U f a).left := by
          change Etale O_a.ι
          infer_instance
        exact ⟨V_f U f a, j_f U f a, ⟨u, hu_mem⟩,
          Sieve.ofArrows_mk (V_f U f) (j_f U f) a, hEt_j, rfl⟩
      have hGen_Sf : ∀ (U : T.Etale) (f : LocallyConstant ↥U.left ↥A),
          Sieve.generate (S_f U f).arrows ∈ J U := by
        intro U f
        rw [Sieve.generate_sieve]
        exact hSf_mem U f
      have hArrow_Sf : ∀ {U W₀ : T.Etale} {f : LocallyConstant ↥U.left ↥A} {u : W₀ ⟶ U},
          (S_f U f).arrows u → ∃ (a : ↥A) (h : W₀ ⟶ V_f U f a), h ≫ j_f U f a = u := by
        intro U W₀ f u hu
        rcases hu with ⟨W₁, h, g, hg, hcomp⟩
        rcases hg with ⟨a⟩
        exact ⟨a, h, hcomp⟩
      have hIndep_Sf : ∀ {U W₀ : T.Etale} (f : LocallyConstant ↥U.left ↥A)
          (a₁ a₂ : ↥A) (h₁ : W₀ ⟶ V_f U f a₁) (h₂ : W₀ ⟶ V_f U f a₂),
          h₁ ≫ j_f U f a₁ = h₂ ≫ j_f U f a₂ →
          G.obj.map h₁.op (ψ.app (Opposite.op (V_f U f a₁)) a₁) =
            G.obj.map h₂.op (ψ.app (Opposite.op (V_f U f a₂)) a₂) := by
        intro U W₀ f a₁ a₂ h₁ h₂ hh
        by_cases ha : a₁ = a₂
        · subst ha
          have _ : Mono (j_f U f a₁) := hMono_jf U f a₁
          have h12 : h₁ = h₂ := (cancel_mono (j_f U f a₁)).mp hh
          rw [h12]
        · have hEmp : IsEmpty ↥W₀.left := by
            refine ⟨fun w => ha ?_⟩
            have hpt : (((Scheme.Etale.forget T).map (h₁ ≫ j_f U f a₁)).left).base w =
                (((Scheme.Etale.forget T).map (h₂ ≫ j_f U f a₂)).left).base w :=
              congrArg (fun k => (((Scheme.Etale.forget T).map k).left).base w) hh
            have hv₁ : f ((((Scheme.Etale.forget T).map (h₁ ≫ j_f U f a₁)).left).base w) = a₁ :=
              (((Scheme.Etale.forget T).map h₁).left.base w).2
            have hv₂ : f ((((Scheme.Etale.forget T).map (h₂ ≫ j_f U f a₂)).left).base w) = a₂ :=
              (((Scheme.Etale.forget T).map h₂).left.base w).2
            exact hv₁.symm.trans ((congrArg f hpt).trans hv₂)
          have _ := subsingleton_of_empty G W₀ hEmp
          exact Subsingleton.elim _ _
      let fam_Sf : ∀ (U : T.Etale) (f : LocallyConstant ↥U.left ↥A),
          Presieve.FamilyOfElements G_type.obj (S_f U f).arrows :=
        fun U f W₀ u hu =>
          let a := (hArrow_Sf hu).choose
          let h := (hArrow_Sf hu).choose_spec.choose
          G.obj.map h.op (ψ.app (Opposite.op (V_f U f a)) a)
      have hcomp_Sf : ∀ (U : T.Etale) (f : LocallyConstant ↥U.left ↥A),
          (fam_Sf U f).Compatible := by
        intro U f Y₁ Y₂ Z₀ g₁ g₂ u₁ u₂ hu₁ hu₂ heq
        let a₁ := (hArrow_Sf hu₁).choose
        let h₁ := (hArrow_Sf hu₁).choose_spec.choose
        have hh₁ : h₁ ≫ j_f U f a₁ = u₁ := (hArrow_Sf hu₁).choose_spec.choose_spec
        let a₂ := (hArrow_Sf hu₂).choose
        let h₂ := (hArrow_Sf hu₂).choose_spec.choose
        have hh₂ : h₂ ≫ j_f U f a₂ = u₂ := (hArrow_Sf hu₂).choose_spec.choose_spec
        change G.obj.map g₁.op (G.obj.map h₁.op (ψ.app _ a₁)) =
          G.obj.map g₂.op (G.obj.map h₂.op (ψ.app _ a₂))
        have hm₁ : G.obj.map g₁.op (G.obj.map h₁.op (ψ.app _ a₁)) =
            G.obj.map (g₁ ≫ h₁).op (ψ.app _ a₁) := by
          simp only [op_comp, G.obj.map_comp]; rfl
        have hm₂ : G.obj.map g₂.op (G.obj.map h₂.op (ψ.app _ a₂)) =
            G.obj.map (g₂ ≫ h₂).op (ψ.app _ a₂) := by
          simp only [op_comp, G.obj.map_comp]; rfl
        rw [hm₁, hm₂]
        apply hIndep_Sf f a₁ a₂ (g₁ ≫ h₁) (g₂ ≫ h₂)
        rw [Category.assoc, hh₁, Category.assoc, hh₂, heq]
      let Φ_fun : ∀ (U : T.Etale) (f : LocallyConstant ↥U.left ↥A),
          ↥(G.obj.obj (Opposite.op U)) := fun U f =>
        (hShG.isSheafFor (S_f U f).arrows (hGen_Sf U f)).amalgamate
          (fam_Sf U f) (hcomp_Sf U f)
      have hΦ_spec : ∀ (U : T.Etale) (f : LocallyConstant ↥U.left ↥A) (a : ↥A),
          G.obj.map (j_f U f a).op (Φ_fun U f) = ψ.app (Opposite.op (V_f U f a)) a := by
        intro U f a
        let hFor := hShG.isSheafFor (S_f U f).arrows (hGen_Sf U f)
        have hj_arr : (S_f U f).arrows (j_f U f a) := Sieve.ofArrows_mk (V_f U f) (j_f U f) a
        have h_val := hFor.valid_glue (hcomp_Sf U f) (j_f U f a) hj_arr
        let a₀ := (hArrow_Sf hj_arr).choose
        let h₀ := (hArrow_Sf hj_arr).choose_spec.choose
        have hh₀ : h₀ ≫ j_f U f a₀ = j_f U f a := (hArrow_Sf hj_arr).choose_spec.choose_spec
        have hid : G.obj.map (𝟙 (V_f U f a)).op (ψ.app (Opposite.op (V_f U f a)) a) =
            ψ.app (Opposite.op (V_f U f a)) a := by simp
        exact h_val.trans
          ((hIndep_Sf f a₀ a h₀ (𝟙 _) (hh₀.trans (Category.id_comp _).symm)).trans hid)
      have hΦ_zero : ∀ (U : T.Etale), Φ_fun U 0 = 0 := by
        intro U
        let hFor := hShG.isSheafFor (S_f U 0).arrows (hGen_Sf U 0)
        apply hFor.isSeparatedFor.ext
        intro W₀ u hu
        obtain ⟨a, h, rfl⟩ := hArrow_Sf hu
        change G.obj.map (h ≫ j_f U 0 a).op (Φ_fun U 0) = G.obj.map (h ≫ j_f U 0 a).op 0
        rw [map_zero]
        have hm : G.obj.map (h ≫ j_f U 0 a).op (Φ_fun U 0) =
            G.obj.map h.op (G.obj.map (j_f U 0 a).op (Φ_fun U 0)) := by
          simp only [op_comp, G.obj.map_comp]; rfl
        rw [hm, hΦ_spec U 0 a]
        by_cases ha : a = 0
        · subst ha
          rw [map_zero, map_zero]
        · have hEmp : IsEmpty ↥(V_f U 0 a).left := ⟨fun x => ha x.2.symm⟩
          have _ := subsingleton_of_empty G (V_f U 0 a) hEmp
          rw [Subsingleton.elim (ψ.app (Opposite.op (V_f U 0 a)) a) 0, map_zero]
      have hΦ_add : ∀ (U : T.Etale) (f₁ f₂ : LocallyConstant ↥U.left ↥A),
          Φ_fun U (f₁ + f₂) = Φ_fun U f₁ + Φ_fun U f₂ := by
        intro U f₁ f₂
        let U_s : Scheme.{u} := U.left
        let u_hom : U_s ⟶ T := U.hom
        let O₂ : (↥A × ↥A) → U_s.Opens := fun p => O_f U f₁ p.1 ⊓ O_f U f₂ p.2
        have hEt₂ : ∀ p : ↥A × ↥A, P_et ((O₂ p).ι ≫ u_hom) := by
          intro p
          have _ : Etale u_hom := U.prop
          change Etale ((O₂ p).ι ≫ u_hom)
          infer_instance
        let V₂ : (↥A × ↥A) → T.Etale := fun p =>
          MorphismProperty.Over.mk (P := P_et) ⊤ ((O₂ p).ι ≫ u_hom) (hEt₂ p)
        let j₂ : ∀ p : ↥A × ↥A, V₂ p ⟶ U := fun p =>
          MorphismProperty.Over.homMk (O₂ p).ι rfl trivial
        let S₂ : Sieve U := Sieve.ofArrows V₂ j₂
        have hS₂_mem : S₂ ∈ J U := by
          rw [mem_smallEtaleTopology_iff]
          intro u
          let p : ↥A × ↥A := (f₁ u, f₂ u)
          have hu_mem : u ∈ O₂ p := ⟨rfl, rfl⟩
          have hEt_j : Etale (j₂ p).left := by
            change Etale (O₂ p).ι
            infer_instance
          exact ⟨V₂ p, j₂ p, ⟨u, hu_mem⟩, Sieve.ofArrows_mk V₂ j₂ p, hEt_j, rfl⟩
        have hGen₂ : Sieve.generate S₂.arrows ∈ J U := by
          rw [Sieve.generate_sieve]
          exact hS₂_mem
        let hFor₂ := hShG.isSheafFor S₂.arrows hGen₂
        apply hFor₂.isSeparatedFor.ext
        intro W₀ u hu
        rcases hu with ⟨W₁, h, g, hg, rfl⟩
        rcases hg with ⟨⟨a₁, a₂⟩⟩
        change G.obj.map (h ≫ j₂ (a₁, a₂)).op (Φ_fun U (f₁ + f₂)) =
          G.obj.map (h ≫ j₂ (a₁, a₂)).op (Φ_fun U f₁ + Φ_fun U f₂)
        simp only [op_comp, G.obj.map_comp]
        change G.obj.map h.op (G.obj.map (j₂ (a₁, a₂)).op (Φ_fun U (f₁ + f₂))) =
          G.obj.map h.op (G.obj.map (j₂ (a₁, a₂)).op (Φ_fun U f₁ + Φ_fun U f₂))
        congr 1
        let ι₁ : V₂ (a₁, a₂) ⟶ V_f U f₁ a₁ :=
          MorphismProperty.Over.homMk (U_s.homOfLE inf_le_left)
            ((Category.assoc (U_s.homOfLE inf_le_left) (O_f U f₁ a₁).ι u_hom).symm.trans
              (congrArg (· ≫ u_hom) (U_s.homOfLE_ι inf_le_left)))
            trivial
        let ι₂ : V₂ (a₁, a₂) ⟶ V_f U f₂ a₂ :=
          MorphismProperty.Over.homMk (U_s.homOfLE inf_le_right)
            ((Category.assoc (U_s.homOfLE inf_le_right) (O_f U f₂ a₂).ι u_hom).symm.trans
              (congrArg (· ≫ u_hom) (U_s.homOfLE_ι inf_le_right)))
            trivial
        have hle₁₂ : O₂ (a₁, a₂) ≤ O_f U (f₁ + f₂) (a₁ + a₂) := by
          intro x ⟨hx₁, hx₂⟩
          change f₁ x + f₂ x = a₁ + a₂
          rw [hx₁, hx₂]
        let ι₁₂ : V₂ (a₁, a₂) ⟶ V_f U (f₁ + f₂) (a₁ + a₂) :=
          MorphismProperty.Over.homMk (U_s.homOfLE hle₁₂)
            ((Category.assoc (U_s.homOfLE hle₁₂) (O_f U (f₁ + f₂) (a₁ + a₂)).ι u_hom).symm.trans
              (congrArg (· ≫ u_hom) (U_s.homOfLE_ι hle₁₂)))
            trivial
        have hj₁ : ι₁ ≫ j_f U f₁ a₁ = j₂ (a₁, a₂) :=
          MorphismProperty.Over.Hom.ext (U_s.homOfLE_ι inf_le_left)
        have hj₂ : ι₂ ≫ j_f U f₂ a₂ = j₂ (a₁, a₂) :=
          MorphismProperty.Over.Hom.ext (U_s.homOfLE_ι inf_le_right)
        have hj₁₂ : ι₁₂ ≫ j_f U (f₁ + f₂) (a₁ + a₂) = j₂ (a₁, a₂) :=
          MorphismProperty.Over.Hom.ext (U_s.homOfLE_ι hle₁₂)
        have hnat₁ := ConcreteCategory.congr_hom (ψ.naturality ι₁.op) a₁
        change ψ.app (Opposite.op (V₂ (a₁, a₂))) a₁ =
          G.obj.map ι₁.op (ψ.app (Opposite.op (V_f U f₁ a₁)) a₁) at hnat₁
        have hnat₂ := ConcreteCategory.congr_hom (ψ.naturality ι₂.op) a₂
        change ψ.app (Opposite.op (V₂ (a₁, a₂))) a₂ =
          G.obj.map ι₂.op (ψ.app (Opposite.op (V_f U f₂ a₂)) a₂) at hnat₂
        have hnat₁₂ := ConcreteCategory.congr_hom (ψ.naturality ι₁₂.op) (a₁ + a₂)
        change ψ.app (Opposite.op (V₂ (a₁, a₂))) (a₁ + a₂) =
          G.obj.map ι₁₂.op (ψ.app (Opposite.op (V_f U (f₁ + f₂) (a₁ + a₂))) (a₁ + a₂)) at hnat₁₂
        rw [map_add]
        have hlhs : G.obj.map (j₂ (a₁, a₂)).op (Φ_fun U (f₁ + f₂)) =
            G.obj.map ι₁₂.op (G.obj.map (j_f U (f₁ + f₂) (a₁ + a₂)).op (Φ_fun U (f₁ + f₂))) := by
          rw [← hj₁₂, op_comp, G.obj.map_comp]; rfl
        have hrhs₁ : G.obj.map (j₂ (a₁, a₂)).op (Φ_fun U f₁) =
            G.obj.map ι₁.op (G.obj.map (j_f U f₁ a₁).op (Φ_fun U f₁)) := by
          rw [← hj₁, op_comp, G.obj.map_comp]; rfl
        have hrhs₂ : G.obj.map (j₂ (a₁, a₂)).op (Φ_fun U f₂) =
            G.obj.map ι₂.op (G.obj.map (j_f U f₂ a₂).op (Φ_fun U f₂)) := by
          rw [← hj₂, op_comp, G.obj.map_comp]; rfl
        rw [hlhs, hrhs₁, hrhs₂, hΦ_spec, hΦ_spec, hΦ_spec, ← hnat₁₂, ← hnat₁, ← hnat₂, map_add]
      have hΦ_nat : ∀ {U' U : T.Etale} (k : U' ⟶ U) (f : LocallyConstant ↥U.left ↥A),
          Φ_fun U' ((L_A.obj.map k.op) f) = G.obj.map k.op (Φ_fun U f) := by
        intro U' U k f
        let f' : LocallyConstant ↥U'.left ↥A := (L_A.obj.map k.op) f
        let hFor' := hShG.isSheafFor (S_f U' f').arrows (hGen_Sf U' f')
        apply hFor'.isSeparatedFor.ext
        intro W₀ u hu
        obtain ⟨a, h, rfl⟩ := hArrow_Sf hu
        change G.obj.map (h ≫ j_f U' f' a).op (Φ_fun U' f') =
          G.obj.map (h ≫ j_f U' f' a).op (G.obj.map k.op (Φ_fun U f))
        simp only [op_comp, G.obj.map_comp]
        change G.obj.map h.op (G.obj.map (j_f U' f' a).op (Φ_fun U' f')) =
          G.obj.map h.op (G.obj.map (j_f U' f' a).op (G.obj.map k.op (Φ_fun U f)))
        congr 1
        let U_s : Scheme.{u} := U.left
        let U'_s : Scheme.{u} := U'.left
        let k_s : U'_s ⟶ U_s := ((Scheme.Etale.forget T).map k).left
        let O_U : U_s.Opens := O_f U f a
        let O_U' : U'_s.Opens := O_f U' f' a
        have _ : IsOpenImmersion O_U.ι := inferInstance
        have hrange : Set.range (O_U'.ι ≫ k_s).base ⊆ Set.range O_U.ι.base := by
          rintro _ ⟨x, rfl⟩
          exact ⟨⟨k_s.base x.1, x.2⟩, rfl⟩
        let q_s : (O_U' : Scheme.{u}) ⟶ (O_U : Scheme.{u}) :=
          IsOpenImmersion.lift O_U.ι (O_U'.ι ≫ k_s) hrange
        have hq_fac : q_s ≫ O_U.ι = O_U'.ι ≫ k_s :=
          IsOpenImmersion.lift_fac O_U.ι (O_U'.ι ≫ k_s) hrange
        let q_et : V_f U' f' a ⟶ V_f U f a :=
          MorphismProperty.Over.homMk q_s
            ((Category.assoc q_s O_U.ι U.hom).symm.trans
              ((congrArg (· ≫ U.hom) hq_fac).trans
                ((Category.assoc O_U'.ι k_s U.hom).trans
                  (congrArg (O_U'.ι ≫ ·) (MorphismProperty.Over.w k)))))
            trivial
        have hq_comm : q_et ≫ j_f U f a = j_f U' f' a ≫ k :=
          MorphismProperty.Over.Hom.ext hq_fac
        have hnat_q := ConcreteCategory.congr_hom (ψ.naturality q_et.op) a
        change ψ.app (Opposite.op (V_f U' f' a)) a =
          G.obj.map q_et.op (ψ.app (Opposite.op (V_f U f a)) a) at hnat_q
        have hrhs : G.obj.map (j_f U' f' a).op (G.obj.map k.op (Φ_fun U f)) =
            G.obj.map q_et.op (G.obj.map (j_f U f a).op (Φ_fun U f)) := by
          change (G.obj.map k.op ≫ G.obj.map (j_f U' f' a).op) (Φ_fun U f) = _
          rw [← G.obj.map_comp, ← op_comp, ← hq_comm, op_comp, G.obj.map_comp]
          rfl
        rw [hΦ_spec, hrhs, hΦ_spec, ← hnat_q]
      let Φ_pre : L_A.obj ⟶ G.obj :=
        { app := fun U => AddCommGrpCat.ofHom
            { toFun := Φ_fun (Opposite.unop U)
              map_zero' := hΦ_zero (Opposite.unop U)
              map_add' := hΦ_add (Opposite.unop U) }
          naturality := fun {U₁ U₂} k =>
            AddCommGrpCat.ext fun f => hΦ_nat k.unop f }
      let Φ : L_A ⟶ G := ObjectProperty.homMk Φ_pre
      refine ⟨Φ, ?_, ?_⟩
      · ext U a₀
        let U₀ := Opposite.unop U
        let c₀ : LocallyConstant ↥U₀.left ↥A := LocallyConstant.const ↥U₀.left a₀
        change Φ_fun U₀ c₀ = ψ.app (Opposite.op U₀) a₀
        let hFor₀ := hShG.isSheafFor (S_f U₀ c₀).arrows (hGen_Sf U₀ c₀)
        apply hFor₀.isSeparatedFor.ext
        intro W₀ u hu
        obtain ⟨a, h, rfl⟩ := hArrow_Sf hu
        change G.obj.map (h ≫ j_f U₀ c₀ a).op (Φ_fun U₀ c₀) =
          G.obj.map (h ≫ j_f U₀ c₀ a).op (ψ.app (Opposite.op U₀) a₀)
        simp only [op_comp, G.obj.map_comp]
        change G.obj.map h.op (G.obj.map (j_f U₀ c₀ a).op (Φ_fun U₀ c₀)) =
          G.obj.map h.op (G.obj.map (j_f U₀ c₀ a).op (ψ.app (Opposite.op U₀) a₀))
        congr 1
        rw [hΦ_spec]
        by_cases ha : a = a₀
        · subst ha
          exact ConcreteCategory.congr_hom (ψ.naturality (j_f U₀ c₀ a).op) a
        · have hEmp : IsEmpty ↥(V_f U₀ c₀ a).left := ⟨fun x => ha x.2.symm⟩
          have _ := subsingleton_of_empty G (V_f U₀ c₀ a) hEmp
          exact Subsingleton.elim _ _
      · intro Φ' hΦ'
        apply (sheafToPresheaf J AddCommGrpCat.{u}).map_injective
        ext U f
        let U₀ := Opposite.unop U
        change Φ'.hom.app (Opposite.op U₀) f = Φ_fun U₀ f
        let hFor := hShG.isSheafFor (S_f U₀ f).arrows (hGen_Sf U₀ f)
        apply hFor.isSeparatedFor.ext
        intro W₀ u hu
        obtain ⟨a, h, rfl⟩ := hArrow_Sf hu
        change G.obj.map (h ≫ j_f U₀ f a).op (Φ'.hom.app (Opposite.op U₀) f) =
          G.obj.map (h ≫ j_f U₀ f a).op (Φ_fun U₀ f)
        simp only [op_comp, G.obj.map_comp]
        change G.obj.map h.op (G.obj.map (j_f U₀ f a).op (Φ'.hom.app (Opposite.op U₀) f)) =
          G.obj.map h.op (G.obj.map (j_f U₀ f a).op (Φ_fun U₀ f))
        congr 1
        rw [hΦ_spec]
        have hnat' := ConcreteCategory.congr_hom (Φ'.hom.naturality (j_f U₀ f a).op) f
        change Φ'.hom.app (Opposite.op (V_f U₀ f a)) ((L_A.obj.map (j_f U₀ f a).op) f) =
          G.obj.map (j_f U₀ f a).op (Φ'.hom.app (Opposite.op U₀) f) at hnat'
        rw [← hnat']
        have hf_res : (L_A.obj.map (j_f U₀ f a).op) f = ν.app (Opposite.op (V_f U₀ f a)) a :=
          LocallyConstant.ext fun x => x.2
        rw [hf_res]
        exact ConcreteCategory.congr_hom (congrArg (fun η => η.app (Opposite.op (V_f U₀ f a))) hΦ') a
    let α : C_A ⟶ L_A := (adj_sh.homEquiv C_pre L_A).symm ν
    let η_unit : C_pre ⟶ C_A.obj := adj_sh.unit.app C_pre
    obtain ⟨β, hβ, _⟩ := hUniv C_A η_unit
    have hα_unit : η_unit ≫ α.hom = ν := by
      change adj_sh.homEquiv C_pre L_A α = ν
      exact Equiv.apply_symm_apply _ ν
    have hβα : β ≫ α = 𝟙 L_A := by
      apply (hUniv L_A ν).unique
      · change ν ≫ β.hom ≫ α.hom = ν
        rw [← Category.assoc, hβ, hα_unit]
      · exact Category.comp_id ν
    have hαβ : α ≫ β = 𝟙 C_A := by
      apply (adj_sh.homEquiv C_pre C_A).injective
      change η_unit ≫ (α.hom ≫ β.hom) = η_unit ≫ 𝟙 C_A.obj
      rw [← Category.assoc, hα_unit, hβ, Category.comp_id]
    exact ⟨{ hom := α, inv := β, hom_inv_id := hαβ, inv_hom_id := hβα }⟩

  
  have etaleOverPullback_isContinuous : ∀ {Y X : Scheme.{u}} (π : Y ⟶ X),
      let B_π : X.Etale ⥤ Y.Etale :=
        (let _ : MorphismProperty.HasPullbacksAlong (@Etale) π :=
          MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
         let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) π :=
          MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
         MorphismProperty.Over.pullback (@Etale) ⊤ π)
      B_π.IsContinuous X.smallEtaleTopology Y.smallEtaleTopology := by
    intro Y X π
    let _ : MorphismProperty.HasPullbacksAlong P_et π :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong P_et π :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : X.Etale ⥤ Y.Etale := MorphismProperty.Over.pullback P_et ⊤ π
    change B.IsContinuous X.smallEtaleTopology Y.smallEtaleTopology
    apply Functor.isContinuous_of_coverPreserving
    · refine CompatiblePreserving.mk ?_
      intro ℱ Z T x hx Y₁ Y₂ W f₁ f₂ g₁ g₂ hg₁ hg₂ hEq
      have _ : Etale Y₁.hom := Y₁.prop
      have _ : Etale Y₂.hom := Y₂.prop
      have _ : Etale Z.hom := Z.prop
      have _ : Etale g₂.left := etale_of_etaleHom g₂
      have hEt_P : P_et (Limits.pullback.fst g₁.left g₂.left ≫ Y₁.hom) := by
        change Etale (Limits.pullback.fst g₁.left g₂.left ≫ Y₁.hom)
        infer_instance
      let P : X.Etale :=
        MorphismProperty.Over.mk (P := P_et) ⊤ (Limits.pullback.fst g₁.left g₂.left ≫ Y₁.hom) hEt_P
      let p₁ : P ⟶ Y₁ :=
        MorphismProperty.Over.homMk (Limits.pullback.fst g₁.left g₂.left) rfl trivial
      let p₂ : P ⟶ Y₂ :=
        MorphismProperty.Over.homMk (Limits.pullback.snd g₁.left g₂.left)
          ((congrArg (Limits.pullback.snd g₁.left g₂.left ≫ ·) (MorphismProperty.Over.w g₂).symm).trans
            ((Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ Z.hom) Limits.pullback.condition.symm).trans
                ((Category.assoc _ _ _).trans
                  (congrArg (Limits.pullback.fst g₁.left g₂.left ≫ ·) (MorphismProperty.Over.w g₁))))))
          trivial
      have hp_cond : p₁ ≫ g₁ = p₂ ≫ g₂ :=
        MorphismProperty.Over.Hom.ext Limits.pullback.condition
      have hB_fst : ∀ {A B₀ : X.Etale} (u : A ⟶ B₀),
          (B.map u).left ≫ Limits.pullback.fst B₀.hom π =
            Limits.pullback.fst A.hom π ≫ u.left := fun u =>
        Limits.pullback.lift_fst _ _ _
      have h_w_z : (f₁.left ≫ Limits.pullback.fst Y₁.hom π) ≫ g₁.left =
          (f₂.left ≫ Limits.pullback.fst Y₂.hom π) ≫ g₂.left := by
        have h1 : (f₁ ≫ B.map g₁).left ≫ Limits.pullback.fst Z.hom π =
            (f₂ ≫ B.map g₂).left ≫ Limits.pullback.fst Z.hom π :=
          congrArg (fun k => ((Scheme.Etale.forget Y).map k).left ≫ Limits.pullback.fst Z.hom π) hEq
        have h2 : ∀ {A : X.Etale} (f : W ⟶ B.obj A) (g : A ⟶ Z),
            (f ≫ B.map g).left ≫ Limits.pullback.fst Z.hom π =
              (f.left ≫ Limits.pullback.fst A.hom π) ≫ g.left := fun f g =>
          (Category.assoc f.left (B.map g).left _).trans
            ((congrArg (f.left ≫ ·) (hB_fst g)).trans (Category.assoc _ _ _).symm)
        exact (h2 f₁ g₁).symm.trans (h1.trans (h2 f₂ g₂))
      let uP_scheme : W.left ⟶ P.left :=
        Limits.pullback.lift (f₁.left ≫ Limits.pullback.fst Y₁.hom π)
          (f₂.left ≫ Limits.pullback.fst Y₂.hom π) h_w_z
      have huP_π : uP_scheme ≫ P.hom = W.hom ≫ π :=
        (Limits.pullback.lift_fst_assoc _ _ _ Y₁.hom).trans
          ((Category.assoc _ _ _).trans
            ((congrArg (f₁.left ≫ ·) Limits.pullback.condition).trans
              ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ π) (MorphismProperty.Over.w f₁)))))
      let ell : W ⟶ B.obj P :=
        MorphismProperty.Over.homMk
          (Limits.pullback.lift uP_scheme W.hom huP_π)
          (Limits.pullback.lift_snd uP_scheme W.hom huP_π)
          trivial
      have hw₁ : (ell.left ≫ (B.map p₁).left) ≫ (B.obj Y₁).hom = f₁.left ≫ (B.obj Y₁).hom :=
        (Category.assoc ell.left (B.map p₁).left _).trans
          ((congrArg (ell.left ≫ ·) (MorphismProperty.Over.w (B.map p₁))).trans
            ((MorphismProperty.Over.w ell).trans (MorphismProperty.Over.w f₁).symm))
      have hw₂ : (ell.left ≫ (B.map p₂).left) ≫ (B.obj Y₂).hom = f₂.left ≫ (B.obj Y₂).hom :=
        (Category.assoc ell.left (B.map p₂).left _).trans
          ((congrArg (ell.left ≫ ·) (MorphismProperty.Over.w (B.map p₂))).trans
            ((MorphismProperty.Over.w ell).trans (MorphismProperty.Over.w f₂).symm))
      have hell₁ : ell ≫ B.map p₁ = f₁ := by
        apply MorphismProperty.Over.Hom.ext
        apply Limits.pullback.hom_ext
        · exact (Category.assoc ell.left (B.map p₁).left _).trans
            ((congrArg (ell.left ≫ ·) (hB_fst p₁)).trans
              ((Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ p₁.left) (Limits.pullback.lift_fst uP_scheme W.hom huP_π)).trans
                  (Limits.pullback.lift_fst _ _ h_w_z))))
        · exact hw₁
      have hell₂ : ell ≫ B.map p₂ = f₂ := by
        apply MorphismProperty.Over.Hom.ext
        apply Limits.pullback.hom_ext
        · exact (Category.assoc ell.left (B.map p₂).left _).trans
            ((congrArg (ell.left ≫ ·) (hB_fst p₂)).trans
              ((Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ p₂.left) (Limits.pullback.lift_fst uP_scheme W.hom huP_π)).trans
                  (Limits.pullback.lift_snd _ _ h_w_z))))
        · exact hw₂
      have hcompX := hx p₁ p₂ hg₁ hg₂ hp_cond
      dsimp at hcompX
      rw [← hell₁, ← hell₂, op_comp, ℱ.obj.map_comp, op_comp, ℱ.obj.map_comp]
      exact congrArg (ℱ.obj.map ell.op) hcompX
    · refine CoverPreserving.mk ?_
      intro U S hS
      rw [mem_smallEtaleTopology_iff] at hS ⊢
      intro y'
      let u₀ : ↥U.left := (Limits.pullback.fst U.hom π).base y'
      obtain ⟨V, g, v₀, hgS, _, hv₀⟩ := hS u₀
      have hpb_g : IsPullback (B.map g).left (Limits.pullback.fst V.hom π)
          (Limits.pullback.fst U.hom π) g.left := by
        have htop : IsPullback (B.obj V).hom (Limits.pullback.fst V.hom π) π V.hom :=
          (IsPullback.of_hasPullback V.hom π).flip
        have hbot : IsPullback (B.obj U).hom (Limits.pullback.fst U.hom π) π U.hom :=
          (IsPullback.of_hasPullback U.hom π).flip
        refine IsPullback.of_right ?_ ?_ hbot
        · have hV : (B.map g).left ≫ (B.obj U).hom = (B.obj V).hom :=
            MorphismProperty.Over.w (B.map g)
          have hg_w : g.left ≫ U.hom = V.hom := MorphismProperty.Over.w g
          exact (hV.symm ▸ hg_w.symm ▸ htop)
        · exact Limits.pullback.lift_fst _ _ _
      obtain ⟨z₀, hz₀, _⟩ := Scheme.Pullback.exists_preimage_pullback y' v₀ hv₀.symm
      let z' : ↥(B.obj V).left := hpb_g.isoPullback.inv.base z₀
      have hEt_Bg : Etale (B.map g).left :=
        MorphismProperty.of_postcomp P_et (B.map g).left (B.obj U).hom (B.obj U).prop
          ((MorphismProperty.Over.w (B.map g)).symm ▸ (B.obj V).prop)
      refine ⟨B.obj V, B.map g, z', ⟨V, g, 𝟙 (B.obj V), hgS, (Category.id_comp _).symm⟩,
        hEt_Bg, ?_⟩
      change (hpb_g.isoPullback.inv ≫ (B.map g).left).base z₀ = y'
      rw [hpb_g.isoPullback_inv_fst]
      exact hz₀

  have cohomologyPresheaf_zero_iso : ∀ {X : Scheme.{u}}
      (F : Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      Nonempty (F.cohomologyPresheaf 0 ≅ F.obj) := by
    intro X F
    let J := X.smallEtaleTopology
    let L_fun : ((X.Etale)ᵒᵖ ⥤ Type u) ⥤ Sheaf J AddCommGrpCat.{u} :=
      (Functor.whiskeringRight (X.Etale)ᵒᵖ (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free ⋙
        presheafToSheaf J AddCommGrpCat.{u}
    let adj_free :=
      (AddCommGrpCat.adj.whiskerRight (X.Etale)ᵒᵖ).comp
        (sheafificationAdjunction J AddCommGrpCat.{u})
    let L_V : ∀ (V : (X.Etale)ᵒᵖ), Sheaf J AddCommGrpCat.{u} :=
      fun V => L_fun.obj (yoneda.obj (Opposite.unop V))
    let ev_obj : ∀ (V : (X.Etale)ᵒᵖ),
        Abelian.Ext (L_V V) F 0 → ↥(F.obj.obj V) :=
      fun V α =>
        yonedaEquiv ((adj_free.homEquiv (yoneda.obj (Opposite.unop V)) F)
          (Abelian.Ext.addEquiv₀ α))
    have hev_zero : ∀ (V : (X.Etale)ᵒᵖ), ev_obj V 0 = 0 := by
      intro V
      dsimp [ev_obj]
      rw [map_zero]
      let ξ_V : ↥((L_V V).obj.obj V) :=
        (adj_free.unit.app (yoneda.obj (Opposite.unop V))).app
          (Opposite.op (Opposite.unop V)) (𝟙 (Opposite.unop V))
      change ((0 : L_V V ⟶ F).hom.app V) ξ_V = 0
      rfl
    have hev_add : ∀ (V : (X.Etale)ᵒᵖ) (α β : Abelian.Ext (L_V V) F 0),
        ev_obj V (α + β) = ev_obj V α + ev_obj V β := by
      intro V α β
      dsimp [ev_obj]
      rw [map_add]
      let u := Abelian.Ext.addEquiv₀ α
      let v := Abelian.Ext.addEquiv₀ β
      let ξ_V : ↥((L_V V).obj.obj V) :=
        (adj_free.unit.app (yoneda.obj (Opposite.unop V))).app
          (Opposite.op (Opposite.unop V)) (𝟙 (Opposite.unop V))
      change ((u + v).hom.app V) ξ_V = (u.hom.app V) ξ_V + (v.hom.app V) ξ_V
      rfl
    have hev_bij : ∀ (V : (X.Etale)ᵒᵖ), Function.Bijective (ev_obj V) := by
      intro V
      exact yonedaEquiv.bijective.comp
        ((adj_free.homEquiv (yoneda.obj (Opposite.unop V)) F).bijective.comp
          Abelian.Ext.addEquiv₀.bijective)
    have hev_nat : ∀ {V₂ V₁ : (X.Etale)ᵒᵖ} (f : V₂ ⟶ V₁)
        (α : Abelian.Ext (L_V V₂) F 0),
        ev_obj V₁ (((F.cohomologyPresheaf 0).map f) α) =
          (F.obj.map f) (ev_obj V₂ α) := by
      intro V₂ V₁ f α
      obtain ⟨u, rfl⟩ := (Abelian.Ext.mk₀_bijective (L_V V₂) F).2 α
      have hmap : ((F.cohomologyPresheaf 0).map f) (Abelian.Ext.mk₀ u) =
          Abelian.Ext.mk₀ (L_fun.map (yoneda.map f.unop) ≫ u) := by
        change (Abelian.Ext.mk₀ (L_fun.map (yoneda.map f.unop))).comp
          (Abelian.Ext.mk₀ u) (zero_add 0) = _
        exact Abelian.Ext.mk₀_comp_mk₀ _ _
      rw [hmap]
      dsimp [ev_obj]
      have hmk : ∀ {L : Sheaf J AddCommGrpCat.{u}} (w : L ⟶ F),
          Abelian.Ext.addEquiv₀ (Abelian.Ext.mk₀ w) = w := by
        intro L w
        rw [← Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
      rw [hmk, hmk, adj_free.homEquiv_naturality_left, ← yonedaEquiv_naturality']
      rfl
    let τ : F.cohomologyPresheaf 0 ⟶ F.obj :=
      { app := fun V => AddCommGrpCat.ofHom
          { toFun := ev_obj V
            map_zero' := hev_zero V
            map_add' := hev_add V }
        naturality := fun {V₂ V₁} f =>
          AddCommGrpCat.ext fun α => hev_nat f α }
    have hIso_app : ∀ V : (X.Etale)ᵒᵖ, IsIso (τ.app V) := fun V =>
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective (τ.app V)).mpr (hev_bij V)
    have _ : IsIso τ := NatIso.isIso_of_isIso_app τ
    exact ⟨asIso τ⟩

  have higherDirectImage_zero_iso_pushforward : ∀ {X S : Scheme.{u}} (g : X ⟶ S),
      let B_g : S.Etale ⥤ X.Etale :=
        (let _ : MorphismProperty.HasPullbacksAlong (@Etale) g :=
          MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
         let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) g :=
          MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
         MorphismProperty.Over.pullback (@Etale) ⊤ g)
      ∀ (hc : B_g.IsContinuous S.smallEtaleTopology X.smallEtaleTopology)
        (F : Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
        Nonempty (weilEtaleHigherDirectImage g 0 F ≅
          ((@Functor.sheafPushforwardContinuous _ _ _ _ B_g AddCommGrpCat.{u} _
            S.smallEtaleTopology X.smallEtaleTopology hc).obj F)) := by
    intro X S g B_g hc F
    obtain ⟨e_coh⟩ := cohomologyPresheaf_zero_iso F
    let g_push := @Functor.sheafPushforwardContinuous _ _ _ _ B_g AddCommGrpCat.{u} _
      S.smallEtaleTopology X.smallEtaleTopology hc
    let e_wh : B_g.op ⋙ F.cohomologyPresheaf 0 ≅ (g_push.obj F).obj :=
      Functor.isoWhiskerLeft B_g.op e_coh
    let e₁ : weilEtaleHigherDirectImage g 0 F ≅
        (presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj (g_push.obj F).obj :=
      (presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).mapIso e_wh
    let e₂ : (presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj (g_push.obj F).obj ≅
        g_push.obj F :=
      asIso ((sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).counit.app
        (g_push.obj F))
    exact ⟨e₁ ≪≫ e₂⟩

  have pushforward_comp_iso : ∀ {X Y S : Scheme.{u}} (g₁ : X ⟶ Y) (g₂ : Y ⟶ S),
      let B₁ : Y.Etale ⥤ X.Etale :=
        (let _ : MorphismProperty.HasPullbacksAlong (@Etale) g₁ :=
          MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
         let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) g₁ :=
          MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
         MorphismProperty.Over.pullback (@Etale) ⊤ g₁)
      let B₂ : S.Etale ⥤ Y.Etale :=
        (let _ : MorphismProperty.HasPullbacksAlong (@Etale) g₂ :=
          MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
         let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) g₂ :=
          MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
         MorphismProperty.Over.pullback (@Etale) ⊤ g₂)
      let B₁₂ : S.Etale ⥤ X.Etale :=
        (let _ : MorphismProperty.HasPullbacksAlong (@Etale) (g₁ ≫ g₂) :=
          MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
         let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) (g₁ ≫ g₂) :=
          MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
         MorphismProperty.Over.pullback (@Etale) ⊤ (g₁ ≫ g₂))
      ∀ (hc₁ : B₁.IsContinuous Y.smallEtaleTopology X.smallEtaleTopology)
        (hc₂ : B₂.IsContinuous S.smallEtaleTopology Y.smallEtaleTopology)
        (hc₁₂ : B₁₂.IsContinuous S.smallEtaleTopology X.smallEtaleTopology)
        (F : Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
        Nonempty (
          ((@Functor.sheafPushforwardContinuous _ _ _ _ B₁₂ AddCommGrpCat.{u} _
            S.smallEtaleTopology X.smallEtaleTopology hc₁₂).obj F) ≅
          ((@Functor.sheafPushforwardContinuous _ _ _ _ B₂ AddCommGrpCat.{u} _
            S.smallEtaleTopology Y.smallEtaleTopology hc₂).obj
            ((@Functor.sheafPushforwardContinuous _ _ _ _ B₁ AddCommGrpCat.{u} _
              Y.smallEtaleTopology X.smallEtaleTopology hc₁).obj F))) := by
    intro X Y S g₁ g₂ B₁ B₂ B₁₂ hc₁ hc₂ hc₁₂ F
    let _ : MorphismProperty.HasPullbacksAlong (@Etale) g₁ :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) g₁ :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let _ : MorphismProperty.HasPullbacksAlong (@Etale) g₂ :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) g₂ :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let _ : MorphismProperty.HasPullbacksAlong (@Etale) (g₁ ≫ g₂) :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) (g₁ ≫ g₂) :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let e_pb : B₁₂ ≅ B₂ ⋙ B₁ := MorphismProperty.Over.pullbackComp g₁ g₂
    let e_pre : B₁₂.op ⋙ F.obj ≅ B₂.op ⋙ (B₁.op ⋙ F.obj) :=
      Functor.isoWhiskerRight (NatIso.op e_pb).symm F.obj
    exact ⟨(fullyFaithfulSheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).preimageIso e_pre⟩

  
  have closedImmersion_restriction_exact : ∀ (T Z : Scheme.{u}) (k_Z : Z ⟶ T)
      [IsClosedImmersion k_Z] (A : AddCommGrpCat.{u}),
      let B_Z : T.Etale ⥤ Z.Etale :=
        (let _ : MorphismProperty.HasPullbacksAlong (@Etale) k_Z :=
          MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
         let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) k_Z :=
          MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
         MorphismProperty.Over.pullback (@Etale) ⊤ k_Z)
      ∃ (ι : closedComplPresheaf T Z k_Z A ⟶ locConstPresheaf T A)
        (η : locConstPresheaf T A ⟶ B_Z.op ⋙ locConstPresheaf Z A)
        (h0 : ι ≫ η = 0),
        Nonempty (Limits.IsLimit (Limits.KernelFork.ofι ι h0)) ∧
        Presheaf.IsLocallySurjective T.smallEtaleTopology η := by
    intro T Z k_Z _ A B_Z
    let ι : closedComplPresheaf T Z k_Z A ⟶ locConstPresheaf T A :=
      { app := fun U => AddCommGrpCat.ofHom
          (closedComplSubgroup T Z k_Z A (Opposite.unop U)).subtype
        naturality := fun _ _ _ => AddCommGrpCat.ext fun _ => rfl }
    let η : locConstPresheaf T A ⟶ B_Z.op ⋙ locConstPresheaf Z A :=
      { app := fun U =>
          let p_U := Limits.pullback.fst (Opposite.unop U).hom k_Z
          AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom p_U.base.hom)
        naturality := fun {U₁ U₂} f => by
          apply AddCommGrpCat.ext
          intro g
          apply LocallyConstant.ext
          intro z
          have h_fst : ((Scheme.Etale.forget Z).map (B_Z.map f.unop)).left ≫
              Limits.pullback.fst (Opposite.unop U₁).hom k_Z =
              Limits.pullback.fst (Opposite.unop U₂).hom k_Z ≫
                ((Scheme.Etale.forget T).map f.unop).left :=
            Limits.pullback.lift_fst _ _ _
          exact congrArg g (congrArg (fun m : _ ⟶ (Opposite.unop U₁).left => m.base z) h_fst).symm }
    have h0 : ι ≫ η = 0 := by
      ext U f
      apply LocallyConstant.ext
      intro z
      let U₀ := Opposite.unop U
      let u₀_hom : (U₀.left : Scheme.{u}) ⟶ T := U₀.hom
      have hcond : (Limits.pullback.fst u₀_hom k_Z ≫ u₀_hom).base z =
          (Limits.pullback.snd u₀_hom k_Z ≫ k_Z).base z :=
        congrArg (fun m : Limits.pullback u₀_hom k_Z ⟶ T => m.base z) Limits.pullback.condition
      apply f.2 ((Limits.pullback.fst u₀_hom k_Z).base z)
      exact ⟨(Limits.pullback.snd u₀_hom k_Z).base z, hcond.symm⟩
    have hLim : Limits.IsLimit (Limits.KernelFork.ofι ι h0) := by
      refine Limits.KernelFork.IsLimit.ofι ι h0
        (fun {Q} γ hγ =>
          { app := fun U => AddCommGrpCat.ofHom
              { toFun := fun q =>
                  ⟨γ.app U q, fun u hu => by
                    obtain ⟨z₀, hz₀⟩ := hu
                    let U_s : Scheme.{u} := (Opposite.unop U).left
                    let u_hom : U_s ⟶ T := (Opposite.unop U).hom
                    obtain ⟨z, hz_u, _⟩ :=
                      Scheme.Pullback.exists_preimage_pullback u z₀ hz₀.symm
                    have hq0 := ConcreteCategory.congr_hom
                      (congrArg (fun ν => ν.app U) hγ) q
                    have hz0 : (γ.app U q : LocallyConstant ↥U_s ↥A)
                        ((Limits.pullback.fst u_hom k_Z).base z) = 0 :=
                      congrArg (fun g : LocallyConstant ↥(Limits.pullback u_hom k_Z) ↥A => g z) hq0
                    rwa [hz_u] at hz0⟩
                map_zero' := Subtype.ext (map_zero (γ.app U).hom)
                map_add' := fun q₁ q₂ => Subtype.ext (map_add (γ.app U).hom q₁ q₂) }
            naturality := fun {U₁ U₂} f => by
              apply AddCommGrpCat.ext
              intro q
              apply Subtype.ext
              exact ConcreteCategory.congr_hom (γ.naturality f) q })
        (fun {Q} γ hγ => by
          ext U q
          rfl)
        (fun {Q} γ hγ m hm => by
          apply NatTrans.ext
          funext U
          apply AddCommGrpCat.ext
          intro q
          apply Subtype.ext
          exact ConcreteCategory.congr_hom (congrArg (fun ν => ν.app U) hm) q)
    have hLS : Presheaf.IsLocallySurjective T.smallEtaleTopology η := by
      refine Presheaf.IsLocallySurjective.mk ?_
      intro U g
      rw [mem_smallEtaleTopology_iff]
      intro u₀
      let U_s : Scheme.{u} := U.left
      let u_hom : U_s ⟶ T := U.hom
      have _ : Etale u_hom := U.prop
      let p_U := Limits.pullback.fst u_hom k_Z
      have _ : IsClosedImmersion p_U := inferInstance
      let g_lc : LocallyConstant ↥(Limits.pullback u_hom k_Z) ↥A := g
      by_cases hu₀ : u₀ ∈ Set.range p_U.base
      · obtain ⟨z₀, hz₀⟩ := hu₀
        let a₀ : ↥A := g_lc z₀
        have hOpen_Z : IsOpen (g_lc ⁻¹' {a₀}) := g_lc.isLocallyConstant {a₀}
        obtain ⟨W₀_set, hW₀_open, hW₀_pre⟩ :=
          p_U.isClosedEmbedding.isInducing.isOpen_iff.mp hOpen_Z
        let W₀ : U_s.Opens := ⟨W₀_set, hW₀_open⟩
        have hu₀_mem : u₀ ∈ W₀ := by
          have hz₀_in : z₀ ∈ p_U.base ⁻¹' W₀_set := by
            rw [hW₀_pre]
            exact rfl
          change u₀ ∈ W₀_set
          rwa [← hz₀]
        have hEt_VW : P_et (W₀.ι ≫ u_hom) := by
          change Etale (W₀.ι ≫ u_hom)
          infer_instance
        let V_W : T.Etale := MorphismProperty.Over.mk (P := P_et) ⊤ (W₀.ι ≫ u_hom) hEt_VW
        let j_W : V_W ⟶ U := MorphismProperty.Over.homMk W₀.ι rfl trivial
        have hEt_jW : Etale j_W.left := by
          change Etale W₀.ι
          infer_instance
        refine ⟨V_W, j_W, ⟨u₀, hu₀_mem⟩, ?_, hEt_jW, rfl⟩
        refine ⟨LocallyConstant.const ↥V_W.left a₀, ?_⟩
        apply LocallyConstant.ext
        intro z'
        have h_fst : ((Scheme.Etale.forget Z).map (B_Z.map j_W)).left ≫ p_U =
            Limits.pullback.fst V_W.hom k_Z ≫ W₀.ι :=
          Limits.pullback.lift_fst _ _ _
        have hp_in : p_U.base (((Scheme.Etale.forget Z).map (B_Z.map j_W)).left.base z') ∈ W₀_set := by
          have hpt := congrArg (fun m => m.base z') h_fst
          change p_U.base (((Scheme.Etale.forget Z).map (B_Z.map j_W)).left.base z') =
            W₀.ι.base ((Limits.pullback.fst V_W.hom k_Z).base z') at hpt
          rw [hpt]
          exact ((Limits.pullback.fst V_W.hom k_Z).base z').2
        have hz'_mem : ((Scheme.Etale.forget Z).map (B_Z.map j_W)).left.base z' ∈ g_lc ⁻¹' {a₀} := by
          rwa [← hW₀_pre]
        exact hz'_mem.symm
      · let O_c : U_s.Opens := ⟨(Set.range p_U.base)ᶜ, p_U.isClosedEmbedding.isClosed_range.isOpen_compl⟩
        have hu₀_mem : u₀ ∈ O_c := hu₀
        have hEt_VO : P_et (O_c.ι ≫ u_hom) := by
          change Etale (O_c.ι ≫ u_hom)
          infer_instance
        let V_O : T.Etale := MorphismProperty.Over.mk (P := P_et) ⊤ (O_c.ι ≫ u_hom) hEt_VO
        let j_O : V_O ⟶ U := MorphismProperty.Over.homMk O_c.ι rfl trivial
        have hEt_jO : Etale j_O.left := by
          change Etale O_c.ι
          infer_instance
        refine ⟨V_O, j_O, ⟨u₀, hu₀_mem⟩, ?_, hEt_jO, rfl⟩
        refine ⟨0, ?_⟩
        apply LocallyConstant.ext
        intro z'
        exfalso
        have h_fst : ((Scheme.Etale.forget Z).map (B_Z.map j_O)).left ≫ p_U =
            Limits.pullback.fst V_O.hom k_Z ≫ O_c.ι :=
          Limits.pullback.lift_fst _ _ _
        have hpt := congrArg (fun m => m.base z') h_fst
        change p_U.base (((Scheme.Etale.forget Z).map (B_Z.map j_O)).left.base z') =
          O_c.ι.base ((Limits.pullback.fst V_O.hom k_Z).base z') at hpt
        exact ((Limits.pullback.fst V_O.hom k_Z).base z').2
          ⟨((Scheme.Etale.forget Z).map (B_Z.map j_O)).left.base z', hpt⟩
    exact ⟨ι, η, h0, ⟨hLim⟩, hLS⟩

  
  have conductor_excision_biproduct_decomp : ∀ (Y₀ W : Scheme.{u}) (i_W : W ⟶ Y₀)
      [IsClosedImmersion i_W]
      (s : ℕ) (C : Fin s → Scheme.{u})
      (μ : ∀ j : Fin s, C j ⟶ Y₀)
      (_ : ∀ j : Fin s, IsFinite (μ j))
      (U_comp : Fin s → Y₀.Opens),
      (⋃ j : Fin s, Set.range (μ j).base) = Set.univ →
      (∀ j : Fin s, (U_comp j : Set Y₀) ⊆ (Set.range i_W.base)ᶜ) →
      ((Set.range i_W.base)ᶜ : Set Y₀) ⊆ (⋃ j : Fin s, (U_comp j : Set Y₀)) →
      (∀ i j : Fin s, i ≠ j → Disjoint (U_comp i) (U_comp j)) →
      (∀ i j : Fin s, i ≠ j → ((μ j).base) ⁻¹' (U_comp i : Set Y₀) = ∅) →
      (∀ j : Fin s, IsIso ((μ j) ∣_ (U_comp j))) →
      ∀ (A : AddCommGrpCat.{u}),
        let K_W := closedComplPresheaf Y₀ W i_W A
        let K_E : Fin s → ((Y₀.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) := fun j =>
          let B_j : Y₀.Etale ⥤ (C j).Etale :=
            (let _ : MorphismProperty.HasPullbacksAlong (@Etale) (μ j) :=
              MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
             let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) (μ j) :=
              MorphismProperty.IsStableUnderBaseChangeAlong.mk
                (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
             MorphismProperty.Over.pullback (@Etale) ⊤ (μ j))
          B_j.op ⋙ closedComplPresheaf (C j) (Limits.pullback (μ j) i_W)
            (Limits.pullback.fst (μ j) i_W) A
        ∃ (proj : ∀ j : Fin s, K_W ⟶ K_E j)
          (incl : ∀ j : Fin s, K_E j ⟶ K_W),
          (∀ j : Fin s, incl j ≫ proj j = 𝟙 (K_E j)) ∧
          (∀ i j : Fin s, i ≠ j → incl i ≫ proj j = 0) ∧
          (Finset.univ.sum fun j : Fin s => proj j ≫ incl j) = 𝟙 K_W := by
    intro Y₀ W i_W _ s C μ hFin U_comp hUniv hU_sub hCompl_sub hDisj hEmpty_pre hIso A K_W K_E
    let B_comp : ∀ j : Fin s, Y₀.Etale ⥤ (C j).Etale := fun j =>
      let _ : MorphismProperty.HasPullbacksAlong (@Etale) (μ j) :=
        MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) (μ j) :=
        MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      MorphismProperty.Over.pullback (@Etale) ⊤ (μ j)
    have hRange_E : ∀ (j : Fin s) (c : ↥(C j)),
        c ∈ Set.range (Limits.pullback.fst (μ j) i_W).base ↔
          (μ j).base c ∈ Set.range i_W.base := by
      intro j c
      constructor
      · rintro ⟨e, rfl⟩
        refine ⟨(Limits.pullback.snd (μ j) i_W).base e, ?_⟩
        exact (congrArg (fun m : Limits.pullback (μ j) i_W ⟶ Y₀ => m.base e)
          Limits.pullback.condition).symm
      · rintro ⟨w, hw⟩
        obtain ⟨e, he, _⟩ := Scheme.Pullback.exists_preimage_pullback c w hw.symm
        exact ⟨e, he⟩
    
    let proj : ∀ j : Fin s, K_W ⟶ K_E j := fun j =>
      { app := fun U =>
          let U₀ := Opposite.unop U
          let u₀_hom : (U₀.left : Scheme.{u}) ⟶ Y₀ := U₀.hom
          let π_U := Limits.pullback.fst u₀_hom (μ j)
          AddCommGrpCat.ofHom
            { toFun := fun f =>
                ⟨LocallyConstant.comapAddMonoidHom π_U.base.hom f.1,
                 fun c' hc' => by
                   have hcond : (π_U ≫ u₀_hom).base c' =
                       (Limits.pullback.snd u₀_hom (μ j) ≫ μ j).base c' :=
                     congrArg (fun m : Limits.pullback u₀_hom (μ j) ⟶ Y₀ => m.base c')
                       Limits.pullback.condition
                   apply f.2 (π_U.base c')
                   change (π_U ≫ u₀_hom).base c' ∈ Set.range i_W.base
                   rw [hcond]
                   exact (hRange_E j ((B_comp j |>.obj U₀).hom.base c')).mp hc'⟩
              map_zero' := Subtype.ext (LocallyConstant.ext fun _ => rfl)
              map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
        naturality := fun {U₁ U₂} f => by
          apply AddCommGrpCat.ext
          intro g
          apply Subtype.ext
          apply LocallyConstant.ext
          intro c'
          have h_fst : ((Scheme.Etale.forget (C j)).map ((B_comp j).map f.unop)).left ≫
              Limits.pullback.fst (Opposite.unop U₁).hom (μ j) =
              Limits.pullback.fst (Opposite.unop U₂).hom (μ j) ≫
                ((Scheme.Etale.forget Y₀).map f.unop).left :=
            Limits.pullback.lift_fst _ _ _
          exact congrArg g.1
            (congrArg (fun m : _ ⟶ (Opposite.unop U₁).left => m.base c') h_fst).symm }
    
    let V_open : ∀ (U : Y₀.Etale) (j : Fin s), (U.left : Scheme.{u}).Opens :=
      fun U j => (TopologicalSpace.Opens.map U.hom.base).obj (U_comp j)
    let M_open : ∀ (j : Fin s), (C j).Opens :=
      fun j => (TopologicalSpace.Opens.map (μ j).base).obj (U_comp j)
    let τ_mor : ∀ (U : Y₀.Etale) (j : Fin s), ((V_open U j : (U.left : Scheme.{u}).Opens) : Scheme.{u}) ⟶ C j :=
      fun U j =>
        let _ : IsIso ((μ j) ∣_ (U_comp j)) := hIso j
        let u_hom : (U.left : Scheme.{u}) ⟶ Y₀ := U.hom
        (u_hom ∣_ (U_comp j)) ≫ inv ((μ j) ∣_ (U_comp j)) ≫ (M_open j).ι
    have hτ_comm : ∀ (U : Y₀.Etale) (j : Fin s),
        (V_open U j).ι ≫ (U.hom : (U.left : Scheme.{u}) ⟶ Y₀) = τ_mor U j ≫ μ j := by
      intro U j
      let _ : IsIso ((μ j) ∣_ (U_comp j)) := hIso j
      let u_hom : (U.left : Scheme.{u}) ⟶ Y₀ := U.hom
      calc
        (V_open U j).ι ≫ u_hom = (u_hom ∣_ (U_comp j)) ≫ (U_comp j).ι :=
          (morphismRestrict_ι u_hom (U_comp j)).symm
        _ = (u_hom ∣_ (U_comp j)) ≫ inv ((μ j) ∣_ (U_comp j)) ≫
              ((μ j) ∣_ (U_comp j)) ≫ (U_comp j).ι := by
          rw [IsIso.inv_hom_id_assoc]
        _ = (u_hom ∣_ (U_comp j)) ≫ inv ((μ j) ∣_ (U_comp j)) ≫ (M_open j).ι ≫ μ j := by
          rw [morphismRestrict_ι (μ j) (U_comp j)]
        _ = τ_mor U j ≫ μ j := by
          dsimp only [τ_mor, u_hom]
          simp only [Category.assoc]
    let σ_mor : ∀ (U : Y₀.Etale) (j : Fin s),
        ((V_open U j : (U.left : Scheme.{u}).Opens) : Scheme.{u}) ⟶
          Limits.pullback (U.hom : (U.left : Scheme.{u}) ⟶ Y₀) (μ j) :=
      fun U j => Limits.pullback.lift (V_open U j).ι (τ_mor U j) (hτ_comm U j)
    have hσ_sec : ∀ (U : Y₀.Etale) (j : Fin s)
        (c' : ↥(Limits.pullback (U.hom : (U.left : Scheme.{u}) ⟶ Y₀) (μ j)))
        (hc' : (Limits.pullback.fst (U.hom : (U.left : Scheme.{u}) ⟶ Y₀) (μ j)).base c' ∈ V_open U j),
        (σ_mor U j).base
          ⟨(Limits.pullback.fst (U.hom : (U.left : Scheme.{u}) ⟶ Y₀) (μ j)).base c', hc'⟩ = c' := by
      intro U j c' hc'
      let _ : IsIso ((μ j) ∣_ (U_comp j)) := hIso j
      let U_s : Scheme.{u} := U.left
      let u_hom : U_s ⟶ Y₀ := U.hom
      let π_U := Limits.pullback.fst u_hom (μ j)
      let q_U := Limits.pullback.snd u_hom (μ j)
      let V_j : U_s.Opens := V_open U j
      let W'_j : (Limits.pullback u_hom (μ j)).Opens :=
        (TopologicalSpace.Opens.map π_U.base).obj V_j
      have hsec_mor : (π_U ∣_ V_j) ≫ σ_mor U j = W'_j.ι := by
        apply Limits.pullback.hom_ext
        · calc
            ((π_U ∣_ V_j) ≫ σ_mor U j) ≫ π_U = (π_U ∣_ V_j) ≫ (σ_mor U j ≫ π_U) :=
              Category.assoc _ _ _
            _ = (π_U ∣_ V_j) ≫ V_j.ι := by rw [Limits.pullback.lift_fst]
            _ = W'_j.ι ≫ π_U := morphismRestrict_ι π_U V_j
        · have hrange_q : Set.range (W'_j.ι ≫ q_U).base ⊆ Set.range (M_open j).ι.base := by
            rintro _ ⟨z, rfl⟩
            have hcond : (π_U ≫ u_hom).base z.1 = (q_U ≫ μ j).base z.1 :=
              congrArg (fun m : Limits.pullback u_hom (μ j) ⟶ Y₀ => m.base z.1)
                Limits.pullback.condition
            have hz_in : (μ j).base (q_U.base z.1) ∈ U_comp j := by
              change (q_U ≫ μ j).base z.1 ∈ U_comp j
              rw [← hcond]
              exact z.2
            exact ⟨⟨q_U.base z.1, hz_in⟩, rfl⟩
          let q_lift := IsOpenImmersion.lift (M_open j).ι (W'_j.ι ≫ q_U) hrange_q
          have hq_fac : q_lift ≫ (M_open j).ι = W'_j.ι ≫ q_U :=
            IsOpenImmersion.lift_fac (M_open j).ι (W'_j.ι ≫ q_U) hrange_q
          calc
            ((π_U ∣_ V_j) ≫ σ_mor U j) ≫ q_U = (π_U ∣_ V_j) ≫ (σ_mor U j ≫ q_U) :=
              Category.assoc _ _ _
            _ = (π_U ∣_ V_j) ≫ τ_mor U j := by rw [Limits.pullback.lift_snd]
            _ = ((π_U ∣_ V_j) ≫ (u_hom ∣_ (U_comp j)) ≫ inv ((μ j) ∣_ (U_comp j))) ≫ (M_open j).ι := by
              dsimp only [τ_mor, u_hom]
              simp only [Category.assoc]
            _ = q_lift ≫ (M_open j).ι := by
              congr 1
              apply (cancel_mono ((μ j) ∣_ (U_comp j))).mp
              apply (cancel_mono (U_comp j).ι).mp
              calc
                (((π_U ∣_ V_j) ≫ (u_hom ∣_ (U_comp j)) ≫ inv ((μ j) ∣_ (U_comp j))) ≫
                    ((μ j) ∣_ (U_comp j))) ≫ (U_comp j).ι =
                  (π_U ∣_ V_j) ≫ ((u_hom ∣_ (U_comp j)) ≫ (U_comp j).ι) := by
                  simp only [Category.assoc, IsIso.inv_hom_id_assoc]
                _ = (π_U ∣_ V_j) ≫ V_j.ι ≫ u_hom := by
                  rw [morphismRestrict_ι u_hom (U_comp j)]
                _ = W'_j.ι ≫ π_U ≫ u_hom := by
                  rw [← Category.assoc, morphismRestrict_ι π_U V_j, Category.assoc]
                _ = W'_j.ι ≫ q_U ≫ μ j := by rw [Limits.pullback.condition]
                _ = q_lift ≫ (M_open j).ι ≫ μ j := by
                  rw [← Category.assoc, ← hq_fac, Category.assoc]
                _ = (q_lift ≫ ((μ j) ∣_ (U_comp j))) ≫ (U_comp j).ι := by
                  rw [← morphismRestrict_ι (μ j) (U_comp j), Category.assoc]
            _ = W'_j.ι ≫ q_U := hq_fac
      have hv_eq : (π_U ∣_ V_j).base ⟨c', hc'⟩ = ⟨π_U.base c', hc'⟩ := by
        apply Subtype.ext
        have hpt := congrArg (fun m => m.base ⟨c', hc'⟩) (morphismRestrict_ι π_U V_j)
        exact hpt
      have hsec_pt := congrArg (fun m => m.base ⟨c', hc'⟩) hsec_mor
      change (σ_mor U j).base ((π_U ∣_ V_j).base ⟨c', hc'⟩) = c' at hsec_pt
      rwa [hv_eq] at hsec_pt
    
    let incl_raw : ∀ (U : Y₀.Etale) (j : Fin s)
        (f_j : ↥((K_E j).obj (Opposite.op U))) (u : ↥U.left), ↥A :=
      fun U j f_j u =>
        if hu : u ∈ V_open U j then f_j.1 ((σ_mor U j).base ⟨u, hu⟩) else 0
    have hincl_pos : ∀ (U : Y₀.Etale) (j : Fin s)
        (f_j : ↥((K_E j).obj (Opposite.op U))) {u : ↥U.left} (hu : u ∈ V_open U j),
        incl_raw U j f_j u = f_j.1 ((σ_mor U j).base ⟨u, hu⟩) := by
      intro U j f_j u hu
      dsimp [incl_raw]
      split_ifs
      rfl
    have hincl_neg : ∀ (U : Y₀.Etale) (j : Fin s)
        (f_j : ↥((K_E j).obj (Opposite.op U))) {u : ↥U.left},
        u ∉ V_open U j → incl_raw U j f_j u = 0 := by
      intro U j f_j u hu
      dsimp [incl_raw]
      split_ifs
      rfl
    have hincl_same : ∀ (U : Y₀.Etale) (j : Fin s)
        (f_j : ↥((K_E j).obj (Opposite.op U)))
        (c' : ↥(Limits.pullback (U.hom : (U.left : Scheme.{u}) ⟶ Y₀) (μ j))),
        incl_raw U j f_j
          ((Limits.pullback.fst (U.hom : (U.left : Scheme.{u}) ⟶ Y₀) (μ j)).base c') =
          f_j.1 c' := by
      intro U j f_j c'
      let U_s : Scheme.{u} := U.left
      let u_hom : U_s ⟶ Y₀ := U.hom
      let π_U := Limits.pullback.fst u_hom (μ j)
      let q_U := Limits.pullback.snd u_hom (μ j)
      let u := π_U.base c'
      have hcond : u_hom.base u = (μ j).base (q_U.base c') :=
        congrArg (fun m : Limits.pullback u_hom (μ j) ⟶ Y₀ => m.base c')
          Limits.pullback.condition
      by_cases hy : u_hom.base u ∈ Set.range i_W.base
      · have hu_not : u ∉ V_open U j := fun hu_in => hU_sub j hu_in hy
        have hg0 : incl_raw U j f_j u = 0 := hincl_neg U j f_j hu_not
        have hf0 : f_j.1 c' = 0 := by
          apply f_j.2 c'
          rw [hRange_E j]
          change (μ j).base (q_U.base c') ∈ Set.range i_W.base
          rwa [← hcond]
        exact hg0.trans hf0.symm
      · have hy_union := hCompl_sub hy
        rw [Set.mem_iUnion] at hy_union
        obtain ⟨k, hk⟩ := hy_union
        have hkj : k = j := by
          by_contra hne
          have hmem_pre : q_U.base c' ∈ ((μ j).base) ⁻¹' (U_comp k : Set Y₀) := by
            change (μ j).base (q_U.base c') ∈ U_comp k
            rwa [← hcond]
          rw [hEmpty_pre k j hne] at hmem_pre
          exact hmem_pre
        subst hkj
        have hu_in : u ∈ V_open U k := hk
        rw [hincl_pos U k f_j hu_in]
        exact congrArg f_j.1 (hσ_sec U k c' hu_in)
    have hincl_diff : ∀ (U : Y₀.Etale) (i j : Fin s), i ≠ j →
        ∀ (f_i : ↥((K_E i).obj (Opposite.op U)))
          (c'' : ↥(Limits.pullback (U.hom : (U.left : Scheme.{u}) ⟶ Y₀) (μ j))),
          incl_raw U i f_i
            ((Limits.pullback.fst (U.hom : (U.left : Scheme.{u}) ⟶ Y₀) (μ j)).base c'') = 0 := by
      intro U i j hij f_i c''
      let U_s : Scheme.{u} := U.left
      let u_hom : U_s ⟶ Y₀ := U.hom
      let π_Uj := Limits.pullback.fst u_hom (μ j)
      let q_Uj := Limits.pullback.snd u_hom (μ j)
      have hu_not : π_Uj.base c'' ∉ V_open U i := by
        intro hu_in
        have hcond : u_hom.base (π_Uj.base c'') = (μ j).base (q_Uj.base c'') :=
          congrArg (fun m : Limits.pullback u_hom (μ j) ⟶ Y₀ => m.base c'')
            Limits.pullback.condition
        have hmem_pre : q_Uj.base c'' ∈ ((μ j).base) ⁻¹' (U_comp i : Set Y₀) := by
          change (μ j).base (q_Uj.base c'') ∈ U_comp i
          rwa [← hcond]
        rw [hEmpty_pre i j hij] at hmem_pre
        exact hmem_pre
      exact hincl_neg U i f_i hu_not
    have hincl_lc : ∀ (U : Y₀.Etale) (j : Fin s) (f_j : ↥((K_E j).obj (Opposite.op U))),
        IsLocallyConstant (incl_raw U j f_j) := by
      intro U j f_j S₀
      let _ : IsFinite (μ j) := hFin j
      let U_s : Scheme.{u} := U.left
      let u_hom : U_s ⟶ Y₀ := U.hom
      let π_U := Limits.pullback.fst u_hom (μ j)
      have _ : IsFinite π_U := inferInstance
      have _ : UniversallyClosed π_U := inferInstance
      let V_j : U_s.Opens := V_open U j
      by_cases h0S : (0 : ↥A) ∈ S₀
      · let T₀ : Set ↥A := S₀ᶜ
        have h0T : (0 : ↥A) ∉ T₀ := fun h => h h0S
        have hEq_T : incl_raw U j f_j ⁻¹' T₀ = π_U.base '' (f_j.1 ⁻¹' T₀) := by
          ext u
          constructor
          · intro huT
            have hu_in : u ∈ V_j := by
              by_contra hu_not
              have hg0 : incl_raw U j f_j u = 0 := hincl_neg U j f_j hu_not
              exact h0T (hg0 ▸ huT)
            let c' := (σ_mor U j).base ⟨u, hu_in⟩
            have hc'_T : f_j.1 c' ∈ T₀ := by
              have hg_eq : incl_raw U j f_j u = f_j.1 c' := hincl_pos U j f_j hu_in
              exact hg_eq ▸ huT
            have hπ_c' : π_U.base c' = u :=
              congrArg (fun m : (V_j : Scheme.{u}) ⟶ U_s => m.base ⟨u, hu_in⟩)
                (Limits.pullback.lift_fst (V_open U j).ι (τ_mor U j) (hτ_comm U j))
            exact ⟨c', hc'_T, hπ_c'⟩
          · rintro ⟨c', hc'T, rfl⟩
            change incl_raw U j f_j (π_U.base c') ∈ T₀
            rw [hincl_same U j f_j c']
            exact hc'T
        have hClosed_pre : IsClosed (f_j.1 ⁻¹' T₀) :=
          (f_j.1.isLocallyConstant S₀).isClosed_compl
        have hClosed_img : IsClosed (incl_raw U j f_j ⁻¹' T₀) := by
          rw [hEq_T]
          exact π_U.isClosedMap _ hClosed_pre
        have hCompl : incl_raw U j f_j ⁻¹' S₀ = (incl_raw U j f_j ⁻¹' T₀)ᶜ := by
          ext u
          simp [T₀]
        rw [hCompl]
        exact hClosed_img.isOpen_compl
      · have hEq_S : incl_raw U j f_j ⁻¹' S₀ =
            V_j.ι.base '' ((σ_mor U j).base ⁻¹' (f_j.1 ⁻¹' S₀)) := by
          ext u
          constructor
          · intro huS
            have hu_in : u ∈ V_j := by
              by_contra hu_not
              have hg0 : incl_raw U j f_j u = 0 := hincl_neg U j f_j hu_not
              exact h0S (hg0 ▸ huS)
            refine ⟨⟨u, hu_in⟩, ?_, rfl⟩
            have hg_eq : incl_raw U j f_j u = f_j.1 ((σ_mor U j).base ⟨u, hu_in⟩) :=
              hincl_pos U j f_j hu_in
            change f_j.1 ((σ_mor U j).base ⟨u, hu_in⟩) ∈ S₀
            rwa [← hg_eq]
          · rintro ⟨⟨u, hu_in⟩, hvS, rfl⟩
            have hg_eq : incl_raw U j f_j u = f_j.1 ((σ_mor U j).base ⟨u, hu_in⟩) :=
              hincl_pos U j f_j hu_in
            change incl_raw U j f_j u ∈ S₀
            rw [hg_eq]
            exact hvS
        rw [hEq_S]
        exact V_j.ι.isOpenEmbedding.isOpenMap _
          ((σ_mor U j).base.hom.continuous.isOpen_preimage _ (f_j.1.isLocallyConstant S₀))
    let incl : ∀ j : Fin s, K_E j ⟶ K_W := fun j =>
      { app := fun U =>
          let U₀ := Opposite.unop U
          AddCommGrpCat.ofHom
            { toFun := fun f_j =>
                ⟨⟨incl_raw U₀ j f_j, hincl_lc U₀ j f_j⟩,
                 fun u huW => hincl_neg U₀ j f_j (fun huV => hU_sub j huV huW)⟩
              map_zero' := Subtype.ext (LocallyConstant.ext fun u => by
                change incl_raw U₀ j 0 u = 0
                dsimp [incl_raw]
                split_ifs <;> rfl)
              map_add' := fun f₁ f₂ => Subtype.ext (LocallyConstant.ext fun u => by
                change incl_raw U₀ j (f₁ + f₂) u = incl_raw U₀ j f₁ u + incl_raw U₀ j f₂ u
                dsimp [incl_raw]
                split_ifs with hu
                · rfl
                · exact (add_zero 0).symm) }
        naturality := fun {U₁ U₂} h => by
          apply AddCommGrpCat.ext
          intro f_j
          apply Subtype.ext
          apply LocallyConstant.ext
          intro u'
          let _ : IsIso ((μ j) ∣_ (U_comp j)) := hIso j
          let U₁_s : Scheme.{u} := (Opposite.unop U₁).left
          let U₂_s : Scheme.{u} := (Opposite.unop U₂).left
          let u₁_hom : U₁_s ⟶ Y₀ := (Opposite.unop U₁).hom
          let u₂_hom : U₂_s ⟶ Y₀ := (Opposite.unop U₂).hom
          let h_s : U₂_s ⟶ U₁_s := ((Scheme.Etale.forget Y₀).map h.unop).left
          have hw_mor : h_s ≫ u₁_hom = u₂_hom := MorphismProperty.Over.w h.unop
          have hmem_iff : ∀ x : ↥U₂_s,
              x ∈ V_open (Opposite.unop U₂) j ↔
                h_s.base x ∈ V_open (Opposite.unop U₁) j := by
            intro x
            have hwx : (h_s ≫ u₁_hom).base x = u₂_hom.base x :=
              congrArg (fun m : U₂_s ⟶ Y₀ => m.base x) hw_mor
            change u₂_hom.base x ∈ U_comp j ↔ u₁_hom.base (h_s.base x) ∈ U_comp j
            rw [← hwx]
            rfl
          change incl_raw (Opposite.unop U₂) j (((K_E j).map h) f_j) u' =
            incl_raw (Opposite.unop U₁) j f_j (h_s.base u')
          by_cases hu' : u' ∈ V_open (Opposite.unop U₂) j
          · have hu : h_s.base u' ∈ V_open (Opposite.unop U₁) j := (hmem_iff u').mp hu'
            rw [hincl_pos (Opposite.unop U₂) j (((K_E j).map h) f_j) hu',
              hincl_pos (Opposite.unop U₁) j f_j hu]
            let V₁_j : U₁_s.Opens := V_open (Opposite.unop U₁) j
            let V₂_j : U₂_s.Opens := V_open (Opposite.unop U₂) j
            have hrange_h : Set.range (V₂_j.ι ≫ h_s).base ⊆ Set.range V₁_j.ι.base := by
              rintro _ ⟨v, rfl⟩
              exact ⟨⟨h_s.base v.1, (hmem_iff v.1).mp v.2⟩, rfl⟩
