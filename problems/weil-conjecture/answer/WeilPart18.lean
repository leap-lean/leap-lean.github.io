  have hBij_ψ : Function.Bijective
      (fun (a : CategoryTheory.Abelian.Ext Fℤ_Y K_Y q) (c : Fin r) => postY (ψ c) a) := by
    have hcomp_eq : (fun (a : CategoryTheory.Abelian.Ext Fℤ_Y K_Y q) (c : Fin r) =>
          postY (ψ c) a) =
        (fun (z : CategoryTheory.Abelian.Ext Fℤ_Y P_prod q) (c : Fin r) => postY (π_c c) z) ∘
          postY (CategoryTheory.Limits.Pi.lift ψ) := by
      funext a c
      change postY (ψ c) a = postY (π_c c) (postY (CategoryTheory.Limits.Pi.lift ψ) a)
      rw [← hpostY_comp, hPi_lift_π ψ c]
    rw [hcomp_eq]
    exact hBij_pi.comp hBij_lift

  have hDiag : ∀ (c : Fin r) (a : CategoryTheory.Abelian.Ext Fℤ_Y K_Y q),
      φ c (((CategoryTheory.Abelian.Ext.mk₀ ι_Y).postcomp Fℤ_Y (Nat.add_zero q)) a) =
        ((CategoryTheory.Abelian.Ext.mk₀ (ι_C c)).postcomp (Fℤ_C c) (Nat.add_zero q))
          (leray c (postY (ψ c) a)) := by
    intro c a
    let FM_Y := weilEtaleTorsionSheaf Y₀ ℓ
    let FM_C := weilEtaleTorsionSheaf (C c).left ℓ
    let πM : (P_pull c).obj FM_Y ⟶ FM_C :=
      ((adj_pull c).homEquiv FM_Y FM_C).symm (η_M c)
    have hπM_eq : πM = (P_pull c).map (η_M c) ≫ (adj_pull c).counit.app FM_C :=
      CategoryTheory.Adjunction.homEquiv_counit (adj_pull c) FM_Y FM_C (η_M c)
    have hComm_c : ψ c ≫ (P_push c).map (ι_C c) = ι_Y ≫ η_M c := hComm_ψ c
    have h_hom_sq : (P_pull c).map ι_Y ≫ πM =
        (P_pull c).map (ψ c) ≫ (adj_pull c).counit.app (K_C c) ≫ ι_C c := by
      have hs1 : (P_pull c).map ι_Y ≫ πM =
          ((P_pull c).map ι_Y ≫ (P_pull c).map (η_M c)) ≫ (adj_pull c).counit.app FM_C :=
        (congrArg ((P_pull c).map ι_Y ≫ ·) hπM_eq).trans
          (CategoryTheory.Category.assoc _ _ _).symm
      have hs2 : ((P_pull c).map ι_Y ≫ (P_pull c).map (η_M c)) ≫ (adj_pull c).counit.app FM_C =
          (P_pull c).map (ψ c ≫ (P_push c).map (ι_C c)) ≫ (adj_pull c).counit.app FM_C :=
        congrArg (· ≫ (adj_pull c).counit.app FM_C)
          (((P_pull c).map_comp ι_Y (η_M c)).symm.trans
            (congrArg (P_pull c).map hComm_c.symm))
      have hs3 : (P_pull c).map (ψ c ≫ (P_push c).map (ι_C c)) ≫ (adj_pull c).counit.app FM_C =
          (P_pull c).map (ψ c) ≫
            (((P_push c ⋙ P_pull c).map (ι_C c)) ≫ (adj_pull c).counit.app FM_C) :=
        (congrArg (· ≫ (adj_pull c).counit.app FM_C)
          ((P_pull c).map_comp (ψ c) ((P_push c).map (ι_C c)))).trans
          (CategoryTheory.Category.assoc _ _ _)
      have hs4 : (P_pull c).map (ψ c) ≫
            (((P_push c ⋙ P_pull c).map (ι_C c)) ≫ (adj_pull c).counit.app FM_C) =
          (P_pull c).map (ψ c) ≫ (adj_pull c).counit.app (K_C c) ≫ ι_C c :=
        congrArg ((P_pull c).map (ψ c) ≫ ·) ((adj_pull c).counit.naturality (ι_C c))
      exact hs1.trans (hs2.trans (hs3.trans hs4))
    let e_a : CategoryTheory.Abelian.Ext (Fℤ_C c) ((P_pull c).obj K_Y) q :=
      (CategoryTheory.Abelian.Ext.mk₀ (ιℤ c)).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor (P_pull c) a) (Nat.zero_add q)
    have hLHS : φ c (((CategoryTheory.Abelian.Ext.mk₀ ι_Y).postcomp Fℤ_Y (Nat.add_zero q)) a) =
        e_a.comp (CategoryTheory.Abelian.Ext.mk₀ ((P_pull c).map ι_Y ≫ πM)) (Nat.add_zero q) := by
      rw [hφ_eq c]
      change (((CategoryTheory.Abelian.Ext.mk₀ (ιℤ c)).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor (P_pull c)
            (a.comp (CategoryTheory.Abelian.Ext.mk₀ ι_Y) (Nat.add_zero q)))
          (Nat.zero_add q)).comp (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero q)) = _
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (ιℤ c))
          (CategoryTheory.Abelian.Ext.mapExactFunctor (P_pull c) a)
          (CategoryTheory.Abelian.Ext.mk₀ ((P_pull c).map ι_Y))
          (Nat.zero_add q) (Nat.add_zero q) (by omega),
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero e_a _ _ (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    have hRHS : ((CategoryTheory.Abelian.Ext.mk₀ (ι_C c)).postcomp (Fℤ_C c) (Nat.add_zero q))
          (leray c (postY (ψ c) a)) =
        e_a.comp (CategoryTheory.Abelian.Ext.mk₀
          ((P_pull c).map (ψ c) ≫ (adj_pull c).counit.app (K_C c) ≫ ι_C c))
          (Nat.add_zero q) := by
      change ((((CategoryTheory.Abelian.Ext.mk₀ (ιℤ c)).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor (P_pull c)
            (a.comp (CategoryTheory.Abelian.Ext.mk₀ (ψ c)) (Nat.add_zero q)))
          (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ ((adj_pull c).counit.app (K_C c)))
            (Nat.add_zero q)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (ι_C c)) (Nat.add_zero q)) = _
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (ιℤ c))
          (CategoryTheory.Abelian.Ext.mapExactFunctor (P_pull c) a)
          (CategoryTheory.Abelian.Ext.mk₀ ((P_pull c).map (ψ c)))
          (Nat.zero_add q) (Nat.add_zero q) (by omega),
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero e_a _ _ (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    rw [hLHS, hRHS, h_hom_sq]

  let Φ : weilEtaleTorsionH Y₀ ℓ q → (∀ c : Fin r, weilEtaleTorsionH (C c).left ℓ q) :=
    fun x c => φ c x
  let ιY_fn := (CategoryTheory.Abelian.Ext.mk₀ ι_Y).postcomp Fℤ_Y (Nat.add_zero q)
  have hBij_comp : Function.Bijective (Φ ∘ ιY_fn) := by
    have hcomp_eq : Φ ∘ ιY_fn =
        (fun (w : ∀ c : Fin r, CategoryTheory.Abelian.Ext (Fℤ_C c) (K_C c) q) (c : Fin r) =>
          ((CategoryTheory.Abelian.Ext.mk₀ (ι_C c)).postcomp (Fℤ_C c) (Nat.add_zero q)) (w c)) ∘
        (fun (u : ∀ c : Fin r, CategoryTheory.Abelian.Ext Fℤ_Y ((P_push c).obj (K_C c)) q)
            (c : Fin r) => leray c (u c)) ∘
        (fun (a : CategoryTheory.Abelian.Ext Fℤ_Y K_Y q) (c : Fin r) => postY (ψ c) a) := by
      funext a c
      exact hDiag c a
    have hBij_step2 : Function.Bijective
        (fun (u : ∀ c : Fin r, CategoryTheory.Abelian.Ext Fℤ_Y ((P_push c).obj (K_C c)) q)
            (c : Fin r) => leray c (u c)) :=
      ⟨fun u₁ u₂ hu => funext (fun c => (hBij_leray c).1 (congrFun hu c)),
       fun w => ⟨fun c => Classical.choose ((hBij_leray c).2 (w c)),
         funext (fun c => Classical.choose_spec ((hBij_leray c).2 (w c)))⟩⟩
    have hBij_step3 : Function.Bijective
        (fun (w : ∀ c : Fin r, CategoryTheory.Abelian.Ext (Fℤ_C c) (K_C c) q) (c : Fin r) =>
          ((CategoryTheory.Abelian.Ext.mk₀ (ι_C c)).postcomp (Fℤ_C c) (Nat.add_zero q)) (w c)) :=
      ⟨fun w₁ w₂ hw => funext (fun c => (hBij_ιC c).1 (congrFun hw c)),
       fun v => ⟨fun c => Classical.choose ((hBij_ιC c).2 (v c)),
         funext (fun c => Classical.choose_spec ((hBij_ιC c).2 (v c)))⟩⟩
    rw [hcomp_eq]
    exact hBij_step3.comp (hBij_step2.comp hBij_ψ)
  exact ⟨fun x₁ x₂ hx => by
      obtain ⟨a₁, rfl⟩ := hBij_ιY.2 x₁
      obtain ⟨a₂, rfl⟩ := hBij_ιY.2 x₂
      exact congrArg ιY_fn (hBij_comp.1 hx),
    fun v => by
      obtain ⟨a, ha⟩ := hBij_comp.2 v
      exact ⟨ιY_fn a, ha⟩⟩

theorem weil_projLine_henselian_smooth_point_two_open_lift (k : Type u) [Field k] [IsAlgClosed k]
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (hA : WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A)
    (Y : AlgebraicGeometry.Scheme.{u})
    (π : Y ⟶ CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
      (weilProjectiveSpaceOver k 1).hom)
    [AlgebraicGeometry.IsFinite π]
    (C_c : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntC : AlgebraicGeometry.IsIntegral C_c.left)
    (hProjC : IsProjectiveOverField k C_c)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_c.hom]
    (Z_c : AlgebraicGeometry.Scheme.{u})
    (hIntZ : AlgebraicGeometry.IsIntegral Z_c)
    (ι_c : Z_c ⟶ CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
      (π ≫ CategoryTheory.Limits.pullback.fst
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
        (weilProjectiveSpaceOver k 1).hom))
    (hCl_c : AlgebraicGeometry.IsClosedImmersion ι_c)
    (ν_c : C_c.left ⟶ Z_c)
    [AlgebraicGeometry.IsFinite ν_c]
    (hSurj_ν : AlgebraicGeometry.Surjective ν_c)
    (hν_hom : (ν_c ≫ ι_c) ≫ CategoryTheory.Limits.pullback.fst
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
      (π ≫ CategoryTheory.Limits.pullback.fst
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
        (weilProjectiveSpaceOver k 1).hom) = C_c.hom)
    (V_c : (CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
      (π ≫ CategoryTheory.Limits.pullback.fst
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
        (weilProjectiveSpaceOver k 1).hom)).Opens)
    (hVc_ne : Nonempty V_c)
    (hSurj_ι : AlgebraicGeometry.Surjective (ι_c ∣_ V_c))
    (hIso_ν : CategoryTheory.IsIso (ν_c ∣_
      ((TopologicalSpace.Opens.map ι_c.base).obj V_c))) :
    let Y₀ := CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
      (π ≫ CategoryTheory.Limits.pullback.fst
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
        (weilProjectiveSpaceOver k 1).hom)
    let i_Y := CategoryTheory.Limits.pullback.snd
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
      (π ≫ CategoryTheory.Limits.pullback.fst
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
        (weilProjectiveSpaceOver k 1).hom)
    ∃ (P_c : ↥C_c.left)
      (U₁ U₂ : Y.Opens)
      (g_sec : ↑(Y.presheaf.obj (Opposite.op U₁)))
      (hP_mem : P_c ∈ (TopologicalSpace.Opens.map ((ν_c ≫ ι_c) ≫ i_Y).base).obj U₁),
      IsClosed ({P_c} : Set ↥C_c.left) ∧
      (ν_c ≫ ι_c).base P_c ∈ V_c ∧
      U₁ ⊔ U₂ = ⊤ ∧
      IsUnit ((Y.presheaf.map
        (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g_sec) ∧
      ((TopologicalSpace.Opens.map i_Y.base).obj U₂ : Set ↥Y₀) =
        ({(ν_c ≫ ι_c).base P_c} : Set ↥Y₀)ᶜ ∧
      ((TopologicalSpace.Opens.map ((ν_c ≫ ι_c) ≫ i_Y).base).obj U₂ : Set ↥C_c.left) =
        ({P_c} : Set ↥C_c.left)ᶜ ∧
      Ideal.span {(C_c.left.presheaf.germ
          ((TopologicalSpace.Opens.map ((ν_c ≫ ι_c) ≫ i_Y).base).obj U₁) P_c hP_mem).hom
        ((((ν_c ≫ ι_c) ≫ i_Y).app U₁).hom g_sec)} =
        IsLocalRing.maximalIdeal ↑(C_c.left.presheaf.stalk P_c) :=
by
  classical
  have _ : _ ∧ _ := ⟨hProjC, hIntZ⟩
  
  have isDomain_section_of_isIntegral : ∀ (X : AlgebraicGeometry.Scheme.{u})
      [AlgebraicGeometry.IsIntegral X] (V : X.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
      (x₀ : ↥X), x₀ ∈ V → IsDomain ↑(X.presheaf.obj (Opposite.op V)) := by
    intro X _ V hV x₀ hx₀
    let R : Type u := ↑(X.presheaf.obj (Opposite.op V))
    have : AlgebraicGeometry.IsReduced X := isReduced_of_isIntegral X
    have hRed_R : IsReduced R := inferInstance
    have hIrred_X : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
    have hSpec_ne : Nonempty (PrimeSpectrum R) := ⟨hV.primeIdealOf ⟨x₀, hx₀⟩⟩
    have hNontriv_R : Nontrivial R := PrimeSpectrum.nonempty_iff_nontrivial.mp hSpec_ne
    have hNoZero : NoZeroDivisors R := ⟨fun {a b} hab => by
      by_contra hnot
      push Not at hnot
      rcases hnot with ⟨ha, hb⟩
      have ha_not_nil : ¬ IsNilpotent a := fun hnil => ha (IsReduced.eq_zero a hnil)
      have hb_not_nil : ¬ IsNilpotent b := fun hnil => hb (IsReduced.eq_zero b hnil)
      have hBa_ne : PrimeSpectrum.basicOpen a ≠ ⊥ :=
        fun hbot => ha_not_nil ((PrimeSpectrum.basicOpen_eq_bot_iff a).mp hbot)
      have hBb_ne : PrimeSpectrum.basicOpen b ≠ ⊥ :=
        fun hbot => hb_not_nil ((PrimeSpectrum.basicOpen_eq_bot_iff b).mp hbot)
      obtain ⟨pa, hpa⟩ := Set.nonempty_iff_ne_empty.mpr
        (fun hemp => hBa_ne (TopologicalSpace.Opens.ext hemp))
      obtain ⟨pb, hpb⟩ := Set.nonempty_iff_ne_empty.mpr
        (fun hemp => hBb_ne (TopologicalSpace.Opens.ext hemp))
      have hpre_a := hV.fromSpec_preimage_basicOpen a
      have hpre_b := hV.fromSpec_preimage_basicOpen b
      have hXa_ne : (X.basicOpen a : Set ↥X).Nonempty := by
        refine ⟨hV.fromSpec.base pa, ?_⟩
        change pa ∈ (TopologicalSpace.Opens.map hV.fromSpec.base).obj (X.basicOpen a)
        rwa [hpre_a]
      have hXb_ne : (X.basicOpen b : Set ↥X).Nonempty := by
        refine ⟨hV.fromSpec.base pb, ?_⟩
        change pb ∈ (TopologicalSpace.Opens.map hV.fromSpec.base).obj (X.basicOpen b)
        rwa [hpre_b]
      have hInter := hIrred_X.isIrreducible_univ.isPreirreducible
        (X.basicOpen a : Set ↥X) (X.basicOpen b : Set ↥X)
        (X.basicOpen a).isOpen (X.basicOpen b).isOpen
        (by simpa using hXa_ne) (by simpa using hXb_ne)
      obtain ⟨z, _, hz_ab⟩ := hInter
      have hz_V : z ∈ V := X.basicOpen_le a hz_ab.1
      let pz : PrimeSpectrum R := hV.primeIdealOf ⟨z, hz_V⟩
      have hpz_eq : hV.fromSpec.base pz = z := hV.fromSpec_primeIdealOf ⟨z, hz_V⟩
      have hpz_a : pz ∈ PrimeSpectrum.basicOpen a := by
        rw [← hpre_a]
        change hV.fromSpec.base pz ∈ X.basicOpen a
        rw [hpz_eq]
        exact hz_ab.1
      have hpz_b : pz ∈ PrimeSpectrum.basicOpen b := by
        rw [← hpre_b]
        change hV.fromSpec.base pz ∈ X.basicOpen b
        rw [hpz_eq]
        exact hz_ab.2
      have hpz_ab : a * b ∉ pz.asIdeal := pz.isPrime.mul_notMem hpz_a hpz_b
      rw [hab] at hpz_ab
      exact hpz_ab pz.asIdeal.zero_mem⟩
    exact @NoZeroDivisors.to_isDomain R _ hNontriv_R hNoZero
  
  have not_surjective_of_stdSmooth_one : ∀ {R₀ S₀ : Type u} [CommRing R₀] [CommRing S₀]
      [Nontrivial S₀] (f : R₀ →+* S₀),
      RingHom.IsStandardSmoothOfRelativeDimension 1 f → ¬ Function.Surjective f := by
    intro R₀ S₀ _ _ _ f hf hsurj
    let _ : Algebra R₀ S₀ := f.toAlgebra
    have _ : Algebra.IsStandardSmoothOfRelativeDimension 1 R₀ S₀ := hf
    have hrank1 : Module.rank S₀ Ω[S₀⁄R₀] = 1 := by
      simpa using Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
        (R := R₀) (S := S₀) 1
    have htop_bot : (⊤ : Submodule S₀ Ω[S₀⁄R₀]) = ⊥ := by
      rw [← KaehlerDifferential.span_range_derivation R₀ S₀, Submodule.span_eq_bot]
      rintro _ ⟨s, rfl⟩
      obtain ⟨r, rfl⟩ := hsurj s
      exact (KaehlerDifferential.D R₀ S₀).map_algebraMap r
    have _ : Subsingleton Ω[S₀⁄R₀] := ⟨fun a b => by
      have ha : a ∈ (⊥ : Submodule S₀ Ω[S₀⁄R₀]) := htop_bot ▸ trivial
      have hb : b ∈ (⊥ : Submodule S₀ Ω[S₀⁄R₀]) := htop_bot ▸ trivial
      rw [Submodule.mem_bot] at ha hb
      exact ha.trans hb.symm⟩
    have hrank0 : Module.rank S₀ Ω[S₀⁄R₀] = 0 := rank_subsingleton' S₀ Ω[S₀⁄R₀]
    exact zero_ne_one (hrank0.symm.trans hrank1)
  
  have exists_algClosed_eval_of_isMaximal : ∀ {R : Type u} [CommRing R] [Algebra k R]
      [Algebra.FiniteType k R] (𝔪 : Ideal R) [𝔪.IsMaximal],
      ∃ τ : R →ₐ[k] k, RingHom.ker τ.toRingHom = 𝔪 := by
    intro R _ _ _ 𝔪 _
    let _ : Field (R ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    have _ : Module.Finite k (R ⧸ 𝔪) := finite_of_finite_type_of_isJacobsonRing k (R ⧸ 𝔪)
    have hbij : Function.Bijective (algebraMap k (R ⧸ 𝔪)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e_k : k ≃ₐ[k] (R ⧸ 𝔪) := AlgEquiv.ofBijective (Algebra.ofId k (R ⧸ 𝔪)) hbij
    let τ : R →ₐ[k] k := e_k.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k 𝔪)
    refine ⟨τ, ?_⟩
    ext r
    change e_k.symm (Ideal.Quotient.mk 𝔪 r) = 0 ↔ r ∈ 𝔪
    rw [← map_zero e_k.symm, e_k.symm.injective.eq_iff, Ideal.Quotient.eq_zero_iff_mem]
  
  have isClosed_fromSpec_of_isMaximal : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (p : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of k)) [AlgebraicGeometry.IsProper p]
      (W : X.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
      (P : ↥(AlgebraicGeometry.Spec Γ(X, W))),
      P.asIdeal.IsMaximal → IsClosed ({hW.fromSpec.base P} : Set ↥X) := by
    intro X p _ W hW P hMax
    let R_cat : CommRingCat.{u} := Γ(X, W)
    let R : Type u := ↑R_cat
    let g_W : AlgebraicGeometry.Spec R_cat ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      hW.fromSpec ≫ p
    let φ_kR : CommRingCat.of k ⟶ R_cat := AlgebraicGeometry.Spec.preimage g_W
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_kR = g_W :=
      AlgebraicGeometry.Spec.map_preimage g_W
    have hLFT_map : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map φ_kR) := by
      rw [hSpec_φ]
      infer_instance
    have hFT : φ_kR.hom.FiniteType :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_map
    let _ : Algebra k R := φ_kR.hom.toAlgebra
    have _ : Algebra.FiniteType k R := hFT
    have _ : P.asIdeal.IsMaximal := hMax
    obtain ⟨τ, hker_τ⟩ := exists_algClosed_eval_of_isMaximal P.asIdeal
    let s_x : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.toRingHom) ≫ hW.fromSpec
    have hs_sec : s_x ≫ p = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.toRingHom) ≫ hW.fromSpec ≫ p = _
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.toRingHom) ≫ g_W = _
      rw [← hSpec_φ, ← AlgebraicGeometry.Spec.map_comp]
      have h_id : φ_kR ≫ CommRingCat.ofHom τ.toRingHom = 𝟙 (CommRingCat.of k) := by
        ext c
        exact τ.commutes c
      rw [h_id, AlgebraicGeometry.Spec.map_id]
    have hSub_Sk : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := by
      refine ⟨fun z₁ z₂ => PrimeSpectrum.ext ?_⟩
      have hz1 : z₁.asIdeal.IsPrime := z₁.isPrime
      have hz2 : z₂.asIdeal.IsPrime := z₂.isPrime
