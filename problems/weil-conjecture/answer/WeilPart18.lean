        exact Normal.splits (IsGalois.to_normal (F := K) (E := L_gal)) (algebraMap E₀ L_gal x)
      have h_card_eq : Fintype.card (E₀ →ₐ[K] L_gal) = P_syl.toSubgroup.index := by
