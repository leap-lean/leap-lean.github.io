        haveI hEt_fres : AlgebraicGeometry.Etale f_res := inferInstance
        letI hNe_fres : Nonempty ↥(AlgebraicGeometry.Scheme.Opens.toScheme (g_left ⁻¹ᵁ U_z z)) :=
