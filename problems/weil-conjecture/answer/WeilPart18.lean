      let e_paste : CategoryTheory.Limits.pullback
          (CategoryTheory.Limits.pullback.snd g (Z.basicOpen h).ι) s ≅
          CategoryTheory.Limits.pullback g s_Z :=
        ((CategoryTheory.IsPullback.of_hasPullback
            (CategoryTheory.Limits.pullback.snd g (Z.basicOpen h).ι) s).paste_horiz
          (CategoryTheory.IsPullback.of_hasPullback g (Z.basicOpen h).ι)).isoPullback
      have hg_fac : g = W.isoSpec.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B)) ≫ Z.isoSpec.inv := by
        have hcat : CommRingCat.ofHom (algebraMap R B) = g.appTop :=
          CommRingCat.Hom.ext hAlgB
        rw [hcat, AlgebraicGeometry.Scheme.isoSpec_inv_naturality g,
          ← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
          CategoryTheory.Category.id_comp]
      have hs_fac' : s_Z =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k₀)) ≫ Z.isoSpec.inv := by
        have hcat : CommRingCat.ofHom (algebraMap R k₀) = ψ_cat := rfl
        rw [hcat]
        exact hs_fac
      let f₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B))
      let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k₀))
      let e_pb_iso : CategoryTheory.Limits.pullback g s_Z ≅
          CategoryTheory.Limits.pullback f₁ f₂ :=
        { hom := CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst g s_Z ≫ W.isoSpec.hom)
            (CategoryTheory.Limits.pullback.snd g s_Z)
            (by
              calc
                (CategoryTheory.Limits.pullback.fst g s_Z ≫ W.isoSpec.hom) ≫ f₁
                  = (CategoryTheory.Limits.pullback.fst g s_Z ≫
                      (W.isoSpec.hom ≫ f₁ ≫ Z.isoSpec.inv)) ≫ Z.isoSpec.hom := by
                    simp [CategoryTheory.Category.assoc]
                _ = (CategoryTheory.Limits.pullback.fst g s_Z ≫ g) ≫ Z.isoSpec.hom := by
                    rw [← hg_fac]
                _ = (CategoryTheory.Limits.pullback.snd g s_Z ≫ s_Z) ≫ Z.isoSpec.hom := by
                    rw [CategoryTheory.Limits.pullback.condition]
                _ = (CategoryTheory.Limits.pullback.snd g s_Z ≫ (f₂ ≫ Z.isoSpec.inv)) ≫
                      Z.isoSpec.hom := by
                    rw [← hs_fac']
                _ = CategoryTheory.Limits.pullback.snd g s_Z ≫ f₂ := by
                    simp [CategoryTheory.Category.assoc])
          inv := CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst f₁ f₂ ≫ W.isoSpec.inv)
            (CategoryTheory.Limits.pullback.snd f₁ f₂)
            (by
              rw [hg_fac, hs_fac']
              simp only [CategoryTheory.Category.assoc]
              rw [← CategoryTheory.Category.assoc W.isoSpec.inv W.isoSpec.hom,
                CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp,
                ← CategoryTheory.Category.assoc _ f₁,
                CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc])
          hom_inv_id := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
            · simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                CategoryTheory.Category.id_comp]
          inv_hom_id := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
            · simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                CategoryTheory.Category.id_comp] }
      let e_tot := e_paste ≪≫ e_pb_iso ≪≫ AlgebraicGeometry.pullbackSpecIso R B k₀
      exact Nat.card_congr (AlgebraicGeometry.Scheme.homeoOfIso e_tot).toEquiv
    · intro k _ Z₀ Z₁ _ _ _ hIntZ₀ hIntZ₁ g U₁ hNe_U₁
      have : AlgebraicGeometry.IsIntegral Z₀.left := hIntZ₀
      have : AlgebraicGeometry.IsIntegral Z₁.left := hIntZ₁
      let R₀ : Type u := ↑(Z₀.left.presheaf.obj (Opposite.op ⊤))
      let R₁ : Type u := ↑(Z₁.left.presheaf.obj (Opposite.op ⊤))
      have hFT : (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)).FiniteType := by
        let α₀_cat := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ Z₀.hom.appTop
        let α₁_cat := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ Z₁.hom.appTop
        have hSpec₁ : AlgebraicGeometry.Spec.map α₁_cat = Z₁.left.isoSpec.inv ≫ Z₁.hom := by
          rw [← AlgebraicGeometry.Scheme.isoSpec_inv_naturality Z₁.hom]
          dsimp [α₁_cat]
          rw [AlgebraicGeometry.Spec.map_comp]
          congr 1
          calc
            AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
              = AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                  ((AlgebraicGeometry.Spec (CommRingCat.of k)).isoSpec.hom ≫
                    (AlgebraicGeometry.Spec (CommRingCat.of k)).isoSpec.inv) := by
                rw [CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.comp_id]
            _ = (AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                  AlgebraicGeometry.Spec.map
                    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom) ≫
                  (AlgebraicGeometry.Spec (CommRingCat.of k)).isoSpec.inv := by
                rw [AlgebraicGeometry.Scheme.isoSpec_Spec_hom, CategoryTheory.Category.assoc]
            _ = (AlgebraicGeometry.Spec (CommRingCat.of k)).isoSpec.inv := by
                rw [← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.hom_inv_id,
                  AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp]
        have hLFT : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map α₁_cat) := by
          rw [hSpec₁]
          infer_instance
        have hFT_α₁ : α₁_cat.hom.FiniteType :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff
            (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT
        have hcomp_cat : α₀_cat ≫ g.left.appTop = α₁_cat := by
          dsimp [α₀_cat, α₁_cat]
          rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Hom.comp_appTop,
            CategoryTheory.Over.w g]
        have hcomp_hom : (g.left.appTop.hom).comp α₀_cat.hom = α₁_cat.hom :=
          congrArg CommRingCat.Hom.hom hcomp_cat
        rw [← hcomp_hom] at hFT_α₁
        exact RingHom.FiniteType.of_comp_finiteType hFT_α₁
      obtain ⟨x₁, hx₁⟩ := hNe_U₁
      obtain ⟨V, ⟨b, rfl⟩, hx₁_b, hb_le⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd).mp
          (AlgebraicGeometry.isBasis_basicOpen Z₁.left) hx₁
      have hb_ne : b ≠ 0 := by
        intro hb0
        rw [hb0, (AlgebraicGeometry.basicOpen_eq_bot_iff (0 : R₁)).mpr rfl] at hx₁_b
        exact hx₁_b
      refine ⟨hFT, b, hb_ne, ?_⟩
      intro h₁ hh₁
      obtain ⟨hAff_U'₀, hNe_U'₀, hSec₀⟩ := basicOpen_props Z₀.left hIntZ₀ h₁ hh₁
      refine ⟨hAff_U'₀, hNe_U'₀, ?_⟩
      intro k₀ _ s₀
      obtain ⟨hψ₀_ne, hs₀_fac⟩ := hSec₀ k₀ s₀
      let s_Z₀ := s₀ ≫ (Z₀.left.basicOpen h₁).ι
      let ψ₀_cat := s_Z₀.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom
      refine ⟨ψ₀_cat.hom, hψ₀_ne, ?_⟩
      intro ψ₁ hψ₁_comp hψ₁_b
      let ψ₁_cat : Z₁.left.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of k₀ :=
        CommRingCat.ofHom ψ₁
      let s₁ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Z₁.left :=
        AlgebraicGeometry.Spec.map ψ₁_cat ≫ Z₁.left.isoSpec.inv
      refine ⟨s₁, ?_, ?_⟩
      · have h_app_s₁ : s₁.appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom =
            Z₁.left.isoSpec.inv.appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (Z₁.left.presheaf.obj (Opposite.op ⊤))).hom ≫
              ψ₁_cat := by
          change (AlgebraicGeometry.Spec.map ψ₁_cat ≫ Z₁.left.isoSpec.inv).appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom = _
          rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc,
            AlgebraicGeometry.Scheme.ΓSpecIso_naturality]
        have h_inv_top : Z₁.left.isoSpec.inv.appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (Z₁.left.presheaf.obj (Opposite.op ⊤))).hom = 𝟙 _ := by
          have hhom : Z₁.left.isoSpec.hom.appTop =
              (AlgebraicGeometry.Scheme.ΓSpecIso (Z₁.left.presheaf.obj (Opposite.op ⊤))).hom :=
            AlgebraicGeometry.Scheme.toSpecΓ_appTop Z₁.left
          rw [← hhom, ← AlgebraicGeometry.Scheme.Hom.comp_appTop,
            CategoryTheory.Iso.hom_inv_id, AlgebraicGeometry.Scheme.Hom.id_appTop]
        have h_s₁_top : (s₁.appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom).hom b = ψ₁ b := by
          rw [h_app_s₁, ← CategoryTheory.Category.assoc, h_inv_top,
            CategoryTheory.Category.id_comp]
          rfl
        have h_unit_k₀ : IsUnit (ψ₁ b) := IsUnit.mk0 (ψ₁ b) hψ₁_b
        have h_unit_spec : IsUnit (s₁.appTop.hom b) := by
          let e_ring : ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k₀), ⊤) ≃+* k₀ :=
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).commRingCatIsoToRingEquiv
          have he : e_ring (s₁.appTop.hom b) = ψ₁ b := h_s₁_top
          have hu : IsUnit (e_ring.symm (ψ₁ b)) := h_unit_k₀.map e_ring.symm.toMonoidHom
          rwa [← he, e_ring.symm_apply_apply] at hu
        have h_pre_top : (TopologicalSpace.Opens.map s₁.base).obj (Z₁.left.basicOpen b) = ⊤ := by
          rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen]
          exact AlgebraicGeometry.RingedSpace.basicOpen_of_isUnit _ h_unit_spec
        rintro _ ⟨pt, rfl⟩
        apply hb_le
        have hpt : pt ∈ (TopologicalSpace.Opens.map s₁.base).obj (Z₁.left.basicOpen b) := by
          rw [h_pre_top]
          trivial
        exact hpt
      · change AlgebraicGeometry.Spec.map ψ₁_cat ≫
          (Z₁.left.isoSpec.inv ≫ g.left) = _
        rw [← AlgebraicGeometry.Scheme.isoSpec_inv_naturality g.left,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        have hcat_eq : g.left.appTop ≫ ψ₁_cat = ψ₀_cat :=
          CommRingCat.Hom.ext hψ₁_comp
        rw [hcat_eq]
        exact hs₀_fac.symm

  refine ⟨?_, ?_⟩
  · intro Z _ hIntZ W g _
    haveI : AlgebraicGeometry.IsIntegral Z := hIntZ
    haveI : AlgebraicGeometry.IsAffine W := AlgebraicGeometry.isAffine_of_isAffineHom g
    let R : Type u := ↑(Z.presheaf.obj (Opposite.op ⊤))
    let B : Type u := ↑(W.presheaf.obj (Opposite.op ⊤))
    letI : Algebra R B := (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g)).toAlgebra
    have hFinHom : (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g)).Finite :=
      ((AlgebraicGeometry.isFinite_iff g).mp inferInstance).2 ⊤
        (AlgebraicGeometry.isAffineOpen_top Z)
    haveI : Module.Finite R B := hFinHom
    obtain ⟨h, hh_ne, I, _, P, hP, σ, N, hInj, hPow⟩ := h_spread R B
    obtain ⟨hAff_U₀, hNe_U₀, hBridge₁⟩ := h_bridge.1 Z hIntZ W g h hh_ne
    refine ⟨Z.basicOpen h, hAff_U₀, hNe_U₀, ∑ i : I, (P i).natDegree, ?_⟩
    intro k₀ _ _ s
    obtain ⟨_, hh_k₀, hCard_eq⟩ := hBridge₁ k₀ s
    exact (hCard_eq rfl).trans (h_card R B h I P hP σ N hInj hPow k₀ hh_k₀)
  · intro k _ Z₀ Z₁ _ _ _ _ hIntZ₀ hIntZ₁ g hInj_g hAlg_g U₁ hNe_U₁
    haveI : AlgebraicGeometry.IsIntegral Z₀.left := hIntZ₀
    haveI : AlgebraicGeometry.IsIntegral Z₁.left := hIntZ₁
    let R₀ : Type u := ↑(Z₀.left.presheaf.obj (Opposite.op ⊤))
    let R₁ : Type u := ↑(Z₁.left.presheaf.obj (Opposite.op ⊤))
    obtain ⟨hFT, b, hb_ne, hBridge₂⟩ := h_bridge.2 k Z₀ Z₁ hIntZ₀ hIntZ₁ g U₁ hNe_U₁
    letI : Algebra R₀ R₁ :=
      (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)).toAlgebra
    haveI : Algebra.FiniteType R₀ R₁ := hFT
    have hAlg_aeval : ∀ x : R₁, ∃ p : Polynomial R₀, p ≠ 0 ∧ Polynomial.aeval x p = 0 := by
      intro x
      obtain ⟨p, hp_ne, hp_ev⟩ := hAlg_g x
      exact ⟨p, hp_ne, hp_ev⟩
    obtain ⟨h₁, hh₁_ne, hLift⟩ := h_genAlg R₀ R₁ hInj_g hAlg_aeval b hb_ne
    obtain ⟨hAff_U'₀, hNe_U'₀, hSec⟩ := hBridge₂ h₁ hh₁_ne
    refine ⟨Z₀.left.basicOpen h₁, hAff_U'₀, hNe_U'₀, ?_⟩
    intro k₀ _ _ s₀
    obtain ⟨ψ₀, hψ₀_ne, hRealize⟩ := hSec k₀ s₀
    obtain ⟨ψ₁, hψ₁_comp, hψ₁_b⟩ := hLift k₀ ψ₀ hψ₀_ne
    exact hRealize ψ₁ hψ₁_comp hψ₁_b

theorem weil_etale_finite_over_base_and_genFinite_descent (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ) :
    (∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsAffine Z.left]
        [AlgebraicGeometry.LocallyOfFiniteType Z.hom],
        AlgebraicGeometry.IsIntegral Z.left →
        ∀ (W : AlgebraicGeometry.Scheme.{u}) (g : W ⟶ Z.left)
          [AlgebraicGeometry.IsFinite g] (q : ℕ),
          WeilIsGenFiniteEtaleConstantModPrime ℓ Z.left
            (weilEtaleHigherDirectImage g q (weilEtaleTorsionSheaf W ℓ))) ∧
    (∀ (Z₀ Z₁ V₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsAffine Z₀.left]
        [AlgebraicGeometry.LocallyOfFiniteType Z₀.hom]
        [AlgebraicGeometry.IsAffine Z₁.left]
        [AlgebraicGeometry.LocallyOfFiniteType Z₁.hom],
        AlgebraicGeometry.IsIntegral Z₀.left →
        AlgebraicGeometry.IsIntegral Z₁.left →
        ∀ (f₀ : V₀ ⟶ Z₀), AlgebraicGeometry.IsProper f₀.left →
        ∀ (g : Z₁ ⟶ Z₀),
          Function.Injective
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) →
          (∀ x : ↑(Z₁.left.presheaf.obj (Opposite.op ⊤)),
            ∃ p : Polynomial ↑(Z₀.left.presheaf.obj (Opposite.op ⊤)),
              p ≠ 0 ∧
              Polynomial.eval₂
                (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) x p = 0) →
          (∀ q : ℕ, WeilIsGenFiniteEtaleConstantModPrime ℓ Z₁.left
            (weilEtaleHigherDirectImage
              (CategoryTheory.Limits.pullback.snd f₀.left g.left) q
              (weilEtaleTorsionSheaf (CategoryTheory.Limits.pullback f₀.left g.left) ℓ))) →
          ∀ q : ℕ, WeilIsGenFiniteEtaleConstantModPrime ℓ Z₀.left
            (weilEtaleHigherDirectImage f₀.left q (weilEtaleTorsionSheaf V₀.left ℓ))) :=
by
  classical
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let isoToAddEquiv : ∀ {M N : AddCommGrpCat.{u}}, (M ≅ N) → ((M : Type u) ≃+ (N : Type u)) :=
    fun e =>
      { toFun := e.hom.hom
        invFun := e.inv.hom
        left_inv := fun x => ConcreteCategory.congr_hom e.hom_inv_id x
        right_inv := fun y => ConcreteCategory.congr_hom e.inv_hom_id y
        map_add' := map_add e.hom.hom }
  let pb_id_left : ∀ {Y S : AlgebraicGeometry.Scheme.{u}} (f : Y ⟶ S),
      CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.id S) f ≅ Y :=
    fun {Y S} f =>
      { hom := CategoryTheory.Limits.pullback.snd (CategoryTheory.CategoryStruct.id S) f
        inv := CategoryTheory.Limits.pullback.lift f (CategoryTheory.CategoryStruct.id Y) (by simp)
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        inv_hom_id := CategoryTheory.Limits.pullback.lift_snd _ _ _ }

  
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have : NeZero ℓ := ⟨hℓ_prime.ne_zero⟩
  let A_ℓ : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  have hTors_Aℓ : ℓ • CategoryTheory.CategoryStruct.id A_ℓ = 0 := by
    ext ⟨x⟩
    apply ULift.ext
    change ℓ • x = 0
    rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
  have hTors_F : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Y ℓ) = 0 := by
    intro Y
    let C_Y := CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
    have : C_Y.Additive := by
      dsimp [C_Y, CategoryTheory.constantSheaf]
      infer_instance
    change ℓ • CategoryTheory.CategoryStruct.id (C_Y.obj A_ℓ) = 0
    rw [← C_Y.map_id, ← C_Y.map_nsmul, hTors_Aℓ, C_Y.map_zero]
  have hTors_R : ∀ (X S : AlgebraicGeometry.Scheme.{u}) (f : X ⟶ S) (q : ℕ),
      ℓ • CategoryTheory.CategoryStruct.id
        (weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf X ℓ)) = 0 := by
    intro X S f q
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor S.Etale X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let F := weilEtaleTorsionSheaf X ℓ
    let P : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B.op (CategoryTheory.Sheaf.cohomologyPresheaf F q)
    have hExt_tors : ∀ (E : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
        (α : CategoryTheory.Abelian.Ext E F q), ℓ • α = 0 := by
      intro E α
      let μ_F : (F ⟶ F) →+ CategoryTheory.Abelian.Ext F F 0 :=
        { toFun := CategoryTheory.Abelian.Ext.mk₀
          map_zero' := CategoryTheory.Abelian.Ext.mk₀_zero F F
          map_add' := fun a b => CategoryTheory.Abelian.Ext.mk₀_add a b }
      let Φ : (F ⟶ F) →+ CategoryTheory.Abelian.Ext E F q :=
        (CategoryTheory.Abelian.Ext.bilinearComp E F F q 0 q (Nat.add_zero q) α).comp μ_F
      have hΦ_id : Φ (CategoryTheory.CategoryStruct.id F) = α := by
        dsimp [Φ, μ_F]
        rw [CategoryTheory.Abelian.Ext.bilinearComp_apply_apply]
        exact CategoryTheory.Abelian.Ext.comp_mk₀_id α
      calc
        ℓ • α = ℓ • Φ (CategoryTheory.CategoryStruct.id F) := by rw [hΦ_id]
        _ = Φ (ℓ • CategoryTheory.CategoryStruct.id F) := (map_nsmul Φ _ _).symm
        _ = Φ 0 := by rw [hTors_F X]
        _ = 0 := map_zero Φ
    have hP_nsmul : ∀ (m : ℕ) (W : Opposite S.Etale) (x : P.obj W),
        ((m • CategoryTheory.CategoryStruct.id P).app W) x = m • x := by
      intro m W x
      induction m with
      | zero =>
        rw [zero_nsmul, zero_nsmul]
        rfl
      | succ m ih =>
        rw [succ_nsmul, succ_nsmul]
        change ((m • CategoryTheory.CategoryStruct.id P).app W +
          (CategoryTheory.CategoryStruct.id P).app W) x = m • x + x
        change ((m • CategoryTheory.CategoryStruct.id P).app W) x + x = m • x + x
        rw [ih]
    have hP_tors : ℓ • CategoryTheory.CategoryStruct.id P = 0 := by
      ext W x
      rw [hP_nsmul ℓ W x]
      let x' : CategoryTheory.Abelian.Ext
        ((CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
          ((CategoryTheory.yoneda.obj (B.obj (Opposite.unop W))).comp AddCommGrpCat.free)) F q := x
      exact hExt_tors _ x'
    let L_sh := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    change ℓ • CategoryTheory.CategoryStruct.id (L_sh.obj P) = 0
    rw [← L_sh.map_id, ← L_sh.map_nsmul, hP_tors, L_sh.map_zero]

  
  have h_etale_term : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom) trivial) ?_
    intro U m
    apply (AlgebraicGeometry.Scheme.Etale.forget S).map_injective
    apply CategoryTheory.Over.OverMorphism.ext
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)

  have h_mem_etale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  have h_pb_const : ∀ (X₁ X₂ : AlgebraicGeometry.Scheme.{u}) (h : X₁ ⟶ X₂)
      (A : AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h
        ((CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj A)
        ((CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
    intro X₁ X₂ h A
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_h : CategoryTheory.Functor X₂.Etale X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    have hT₂ : CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id X₂)) :=
      h_etale_term X₂
    have : CategoryTheory.Limits.HasTerminal X₂.Etale := hT₂.hasTerminal
    have : CategoryTheory.Limits.HasPullbacks X₂.Etale :=
      CategoryTheory.MorphismProperty.Over.hasPullbacks (@AlgebraicGeometry.Etale) X₂
    have : CategoryTheory.Limits.HasFiniteLimits X₂.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : CategoryTheory.Limits.PreservesFiniteLimits B_h :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
        (@AlgebraicGeometry.Etale) h
    have : CategoryTheory.RepresentablyFlat B_h :=
      CategoryTheory.flat_of_preservesFiniteLimits B_h
    have hCompat : CategoryTheory.CompatiblePreserving X₁.smallEtaleTopology B_h :=
      CategoryTheory.compatiblePreservingOfFlat X₁.smallEtaleTopology B_h
    have hCover : CategoryTheory.CoverPreserving X₂.smallEtaleTopology X₁.smallEtaleTopology B_h := by
      constructor
      intro U S hS
      have hS' := (h_mem_etale X₂ U S).mp hS
      refine (h_mem_etale X₁ (B_h.obj U) _).mpr ?_
      intro z
      let fst_U : (B_h.obj U).left ⟶ U.left := CategoryTheory.Limits.pullback.fst U.hom h
      obtain ⟨Y, f, y, hfS, hfEt, hy⟩ := hS' (fst_U.base z)
      have h_outer : CategoryTheory.IsPullback
          ((B_h.map f).left ≫ CategoryTheory.Limits.pullback.snd U.hom h)
          (CategoryTheory.Limits.pullback.fst Y.hom h) h (f.left ≫ U.hom) := by
        have hw₁ : (B_h.map f).left ≫ CategoryTheory.Limits.pullback.snd U.hom h =
            CategoryTheory.Limits.pullback.snd Y.hom h :=
          CategoryTheory.MorphismProperty.Over.w (B_h.map f)
        have hw₂ : f.left ≫ U.hom = Y.hom := CategoryTheory.MorphismProperty.Over.w f
        rw [hw₁, hw₂]
        exact (CategoryTheory.IsPullback.of_hasPullback Y.hom h).flip
      have h_comm_left : (B_h.map f).left ≫ fst_U =
          CategoryTheory.Limits.pullback.fst Y.hom h ≫ f.left := by
        dsimp [B_h, fst_U, CategoryTheory.MorphismProperty.Over.pullback]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h_right : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd U.hom h) fst_U h U.hom :=
        (CategoryTheory.IsPullback.of_hasPullback U.hom h).flip
      have hp_left : CategoryTheory.IsPullback
          (B_h.map f).left (CategoryTheory.Limits.pullback.fst Y.hom h) fst_U f.left :=
        CategoryTheory.IsPullback.of_right h_outer h_comm_left h_right
      let e_pb := hp_left.isoPullback
      obtain ⟨p, hp_fst, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
      refine ⟨B_h.obj Y, B_h.map f, e_pb.inv.base p, ?_, ?_, ?_⟩
      · exact ⟨Y, f, 𝟙 (B_h.obj Y), hfS, (CategoryTheory.Category.id_comp _).symm⟩
      · exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hp_left.flip hfEt
      · have heq : e_pb.inv ≫ (B_h.map f).left =
            CategoryTheory.Limits.pullback.fst fst_U f.left := by
          rw [CategoryTheory.Iso.inv_comp_eq]
          exact (CategoryTheory.IsPullback.isoPullback_hom_fst hp_left).symm
        calc
          (B_h.map f).left.base (e_pb.inv.base p) = (e_pb.inv ≫ (B_h.map f).left).base p := rfl
          _ = (CategoryTheory.Limits.pullback.fst fst_U f.left).base p := by rw [heq]
          _ = z := hp_fst
    have hCont : B_h.IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCover
    let ι₂ : CategoryTheory.Functor X₂.AffineEtale X₂.Etale :=
      AlgebraicGeometry.Scheme.AffineEtale.Spec X₂
    let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology X₂
    have : ι₂.IsContinuous J_aff X₂.smallEtaleTopology := by
      dsimp [ι₂]
      infer_instance
    let P_ι := ι₂.sheafPushforwardContinuous AddCommGrpCat.{u} J_aff X₂.smallEtaleTopology
    have : P_ι.IsEquivalence := by
      dsimp [P_ι, ι₂, J_aff]
      infer_instance
    let M₂ : Type u := CategoryTheory.SmallModel.{u} X₂.AffineEtale
    let e_sm : X₂.AffineEtale ≌ M₂ := CategoryTheory.equivSmallModel.{u} X₂.AffineEtale
    let J_M : CategoryTheory.GrothendieckTopology M₂ := e_sm.inverse.inducedTopology J_aff
    let P_sm := e_sm.inverse.sheafPushforwardContinuous AddCommGrpCat.{u} J_M J_aff
    have : P_sm.IsEquivalence := by
      dsimp [P_sm, J_M]
      infer_instance
    let K : CategoryTheory.Functor M₂ X₁.Etale := (e_sm.inverse.comp ι₂).comp B_h
    have : (e_sm.inverse.comp ι₂).IsContinuous J_M X₂.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp e_sm.inverse ι₂ J_M J_aff X₂.smallEtaleTopology
    have : K.IsContinuous J_M X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp (e_sm.inverse.comp ι₂) B_h J_M
        X₂.smallEtaleTopology X₁.smallEtaleTopology
    let P_push := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let P_K := K.sheafPushforwardContinuous AddCommGrpCat.{u} J_M X₁.smallEtaleTopology
    let e_tot : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u} ≌
        CategoryTheory.Sheaf J_M AddCommGrpCat.{u} :=
      P_ι.asEquivalence.trans P_sm.asEquivalence
    have hPK : P_push.comp e_tot.functor ≅ P_K :=
      (CategoryTheory.Functor.associator P_push P_ι P_sm).symm ≪≫
        CategoryTheory.Functor.isoWhiskerLeft P_push
          (CategoryTheory.Functor.sheafPushforwardContinuousComp e_sm.inverse ι₂ AddCommGrpCat.{u}
            J_M J_aff X₂.smallEtaleTopology).symm ≪≫
        CategoryTheory.Functor.sheafPushforwardContinuousComp (e_sm.inverse.comp ι₂) B_h
          AddCommGrpCat.{u} J_M X₂.smallEtaleTopology X₁.smallEtaleTopology
    have hIso : P_K.comp e_tot.inverse ≅ P_push :=
      (CategoryTheory.Functor.isoWhiskerRight hPK.symm e_tot.inverse) ≪≫
        CategoryTheory.Functor.associator P_push e_tot.functor e_tot.inverse ≪≫
        CategoryTheory.Functor.isoWhiskerLeft P_push e_tot.unitIso.symm ≪≫
        CategoryTheory.Functor.rightUnitor P_push
    let adj_K := K.sheafAdjunctionContinuous AddCommGrpCat.{u} J_M X₁.smallEtaleTopology
    have hRA : P_push.IsRightAdjoint :=
      (CategoryTheory.Adjunction.ofNatIsoRight (e_tot.toAdjunction.comp adj_K) hIso).isRightAdjoint
    let T₁ := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id X₁)
    let T₂ := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id X₂)
    have hT₁ : CategoryTheory.Limits.IsTerminal T₁ := h_etale_term X₁
    let e_T : B_h.obj T₂ ≅ T₁ :=
      CategoryTheory.MorphismProperty.Over.isoMk (pb_id_left h)
        (CategoryTheory.Category.comp_id _)
    let adj₁ := CategoryTheory.constantSheafAdj X₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
    let adj₂ := (CategoryTheory.constantSheafAdj X₂.smallEtaleTopology AddCommGrpCat.{u} hT₂).comp
      (B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology)
    let Γ₁ := (CategoryTheory.sheafSections X₁.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₁)
    let Γ₂ := (CategoryTheory.sheafSections X₂.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₂)
    have hΓ_iso : P_push.comp Γ₂ ≅ Γ₁ :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ => ℱ.obj.mapIso e_T.op.symm)
        (fun {ℱ₁ ℱ₂} φ => by
          dsimp [P_push, Γ₁, Γ₂, CategoryTheory.sheafSections]
          exact (φ.hom.naturality e_T.inv.op).symm)
    let adj₂' := CategoryTheory.Adjunction.ofNatIsoRight adj₂ hΓ_iso
    let e_const := CategoryTheory.Adjunction.leftAdjointUniq adj₂' adj₁
    exact ⟨hCont, hRA, ⟨e_const.app A⟩⟩

  have h_pb_comp : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}} (h₁ : X₁ ⟶ X₂) (h₂ : X₂ ⟶ X₃)
      (F₃ : CategoryTheory.Sheaf X₃.smallEtaleTopology AddCommGrpCat.{u})
      (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
      (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h₂ F₃ F₂ →
      WeilIsEtaleSheafPullback h₁ F₂ F₁ →
      WeilIsEtaleSheafPullback (h₁ ≫ h₂) F₃ F₁ := by
    intro X₁ X₂ X₃ h₁ h₂ F₃ F₂ F₁ hq₂ hq₁
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h₁ :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h₂ :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h₂ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) (h₁ ≫ h₂) :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale)
        (h₁ ≫ h₂) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    obtain ⟨hc₂, hr₂, ⟨e₂⟩⟩ := hq₂
    obtain ⟨hc₁, hr₁, ⟨e₁⟩⟩ := hq₁
    obtain ⟨hc₁₂, hr₁₂, -⟩ := h_pb_const X₁ X₃ (h₁ ≫ h₂) A_ℓ
    let B₁ : CategoryTheory.Functor X₂.Etale X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h₁
    let B₂ : CategoryTheory.Functor X₃.Etale X₂.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h₂
    let B₁₂ : CategoryTheory.Functor X₃.Etale X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ (h₁ ≫ h₂)
    have α : B₂.comp B₁ ≅ B₁₂ :=
      (CategoryTheory.MorphismProperty.Over.pullbackComp h₁ h₂).symm
    have : (B₂.comp B₁).IsContinuous X₃.smallEtaleTopology X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp B₂ B₁
        X₃.smallEtaleTopology X₂.smallEtaleTopology X₁.smallEtaleTopology
    let P₁ := B₁.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let P₂ := B₂.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₃.smallEtaleTopology X₂.smallEtaleTopology
    let P₁₂ := B₁₂.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₃.smallEtaleTopology X₁.smallEtaleTopology
    have hP_comp : P₁.comp P₂ ≅ P₁₂ :=
      (CategoryTheory.Functor.sheafPushforwardContinuousComp B₂ B₁ AddCommGrpCat.{u}
        X₃.smallEtaleTopology X₂.smallEtaleTopology X₁.smallEtaleTopology) ≪≫
        (CategoryTheory.Functor.sheafPushforwardContinuousIso α AddCommGrpCat.{u}
          X₃.smallEtaleTopology X₁.smallEtaleTopology)
    let L₁ := B₁.sheafPullback AddCommGrpCat.{u} X₂.smallEtaleTopology X₁.smallEtaleTopology
    let adj₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let adj₂ := B₂.sheafAdjunctionContinuous AddCommGrpCat.{u}
      X₃.smallEtaleTopology X₂.smallEtaleTopology
    let adj₁₂ := B₁₂.sheafAdjunctionContinuous AddCommGrpCat.{u}
      X₃.smallEtaleTopology X₁.smallEtaleTopology
    let adj_comp := CategoryTheory.Adjunction.ofNatIsoRight (adj₂.comp adj₁) hP_comp
    let β := CategoryTheory.Adjunction.leftAdjointUniq adj_comp adj₁₂
    exact ⟨hc₁₂, hr₁₂, ⟨(β.symm.app F₃) ≪≫ (L₁.mapIso e₂) ≪≫ e₁⟩⟩

  
  have h_top_stalk : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
      (T : C) (hTop : ∀ R ∈ J T, R = ⊤)
      (P : CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u}),
      Nonempty (CategoryTheory.Iso (P.obj (Opposite.op T))
        (((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P).obj.obj (Opposite.op T))) := by
    intro C _ J _ T hTop P
    let R_pre : AddCommGrpCat.{u} → CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u} :=
      fun M =>
        { obj := fun W => ∏ᶜ (fun _ : (T ⟶ Opposite.unop W) => M)
          map := fun {W₁ W₂} f =>
            CategoryTheory.Limits.Pi.lift (fun τ : (T ⟶ Opposite.unop W₂) =>
              CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ Opposite.unop W₁) => M) (τ ≫ f.unop))
          map_id := fun W => by
            apply CategoryTheory.Limits.Pi.hom_ext
            intro τ
            simp
          map_comp := fun {W₁ W₂ W₃} f g => by
            apply CategoryTheory.Limits.Pi.hom_ext
            intro τ
            simp }
    have hR_sheaf : ∀ M : AddCommGrpCat.{u}, CategoryTheory.Presheaf.IsSheaf J (R_pre M) := by
      intro M
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro U S hS
      have hτ_mem : ∀ τ : (T ⟶ U), S.arrows τ := by
        intro τ
        have hpb : S.pullback τ = ⊤ := hTop (S.pullback τ) (J.pullback_stable τ hS)
        have hid : (S.pullback τ).arrows (𝟙 T) := by rw [hpb]; trivial
        simpa [CategoryTheory.Sieve.pullback_apply] using hid
      let mkObj : ∀ τ : (T ⟶ U), S.arrows.category :=
        fun τ => ⟨CategoryTheory.Over.mk τ, hτ_mem τ⟩
      refine ⟨{
        lift := fun s => CategoryTheory.Limits.Pi.lift (fun τ : (T ⟶ S.arrows.cocone.pt) =>
          s.π.app (Opposite.op (mkObj τ)) ≫
            CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ T) => M) (𝟙 T))
        fac := fun s j => by
          apply CategoryTheory.Limits.Pi.hom_ext
          intro ρ
          let mor : mkObj (ρ ≫ j.unop.obj.hom) ⟶ j.unop :=
            CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk ρ rfl)
          have hw := s.w mor.op
          have hcomp := congrArg
            (fun k => k ≫ CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ T) => M) (𝟙 T)) hw
          dsimp [R_pre, mkObj, mor] at hcomp ⊢
          simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.limit.lift_π,
            CategoryTheory.Limits.Fan.mk_pt, CategoryTheory.Limits.Fan.mk_π_app,
            CategoryTheory.Category.id_comp] at hcomp ⊢
          exact hcomp.symm
        uniq := fun s m hm => by
          apply CategoryTheory.Limits.Pi.hom_ext
          intro τ
          have hmτ := congrArg
            (fun k => k ≫ CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ T) => M) (𝟙 T))
            (hm (Opposite.op (mkObj τ)))
          change m ≫ ((CategoryTheory.Limits.Pi.lift fun τ₁ : T ⟶ T =>
              CategoryTheory.Limits.Pi.π (fun _ : T ⟶ S.arrows.cocone.pt => M) (τ₁ ≫ τ)) ≫
              CategoryTheory.Limits.Pi.π (fun _ : T ⟶ T => M) (𝟙 T)) =
            s.π.app (Opposite.op (mkObj τ)) ≫
              CategoryTheory.Limits.Pi.π (fun _ : T ⟶ T => M) (𝟙 T) at hmτ
          simp only [CategoryTheory.Limits.limit.lift_π, CategoryTheory.Limits.Fan.mk_pt,
            CategoryTheory.Limits.Fan.mk_π_app, CategoryTheory.Category.id_comp] at hmτ ⊢
          exact hmτ
      }⟩
    let evLift : ∀ (Q : CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u})
        (M : AddCommGrpCat.{u}) (φ : Q.obj (Opposite.op T) ⟶ M), Q ⟶ R_pre M :=
      fun Q M φ =>
        { app := fun W => CategoryTheory.Limits.Pi.lift
            (fun τ : (T ⟶ Opposite.unop W) => Q.map τ.op ≫ φ)
          naturality := fun {W₁ W₂} f => by
            apply CategoryTheory.Limits.Pi.hom_ext
            intro τ
            dsimp [R_pre]
            simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.limit.lift_π,
              CategoryTheory.Limits.Fan.mk_pt, CategoryTheory.Limits.Fan.mk_π_app]
            change Q.map f ≫ Q.map τ.op ≫ φ = Q.map (f ≫ τ.op) ≫ φ
            rw [Q.map_comp, CategoryTheory.Category.assoc] }
    have hev_comp : ∀ {Q₁ Q₂ : CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u}}
        {M : AddCommGrpCat.{u}} (α : Q₁ ⟶ Q₂) (φ : Q₂.obj (Opposite.op T) ⟶ M),
        α ≫ evLift Q₂ M φ = evLift Q₁ M (α.app (Opposite.op T) ≫ φ) := by
      intro Q₁ Q₂ M α φ
      ext W : 2
      apply CategoryTheory.Limits.Pi.hom_ext
      intro τ
      dsimp [evLift]
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.limit.lift_π,
        CategoryTheory.Limits.Fan.mk_pt, CategoryTheory.Limits.Fan.mk_π_app]
      rw [← CategoryTheory.Category.assoc (α.app W), ← α.naturality τ.op,
        CategoryTheory.Category.assoc]
    have hev_eval : ∀ (Q : CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u})
        (M : AddCommGrpCat.{u}) (φ : Q.obj (Opposite.op T) ⟶ M),
        (evLift Q M φ).app (Opposite.op T) ≫
          CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ T) => M) (𝟙 T) = φ := by
      intro Q M φ
      dsimp [evLift]
      simp
    let adj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let P_sh := (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P
    let η_nat : P ⟶ P_sh.obj := adj.unit.app P
    let η : P.obj (Opposite.op T) ⟶ P_sh.obj.obj (Opposite.op T) := η_nat.app (Opposite.op T)
    let M₁ := P.obj (Opposite.op T)
    let R_sh₁ : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨R_pre M₁, hR_sheaf M₁⟩
    let r_sh : P_sh ⟶ R_sh₁ := (adj.homEquiv P R_sh₁).symm (evLift P M₁ (𝟙 M₁))
    have hr_unit : η_nat ≫ r_sh.hom = evLift P M₁ (𝟙 M₁) := by
      have h1 := (adj.homEquiv P R_sh₁).apply_symm_apply (evLift P M₁ (𝟙 M₁))
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact h1
    let r : P_sh.obj.obj (Opposite.op T) ⟶ P.obj (Opposite.op T) :=
      r_sh.hom.app (Opposite.op T) ≫ CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ T) => M₁) (𝟙 T)
    have h_ηr : η ≫ r = 𝟙 M₁ := by
      dsimp [η, r]
      rw [← CategoryTheory.Category.assoc]
      change (η_nat ≫ r_sh.hom).app (Opposite.op T) ≫ _ = 𝟙 M₁
      rw [hr_unit]
      exact hev_eval P M₁ (𝟙 M₁)
    let M₂ := P_sh.obj.obj (Opposite.op T)
    let R_sh₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨R_pre M₂, hR_sheaf M₂⟩
    let g₁ : P_sh ⟶ R_sh₂ := CategoryTheory.ObjectProperty.homMk (evLift P_sh.obj M₂ (r ≫ η))
    let g₂ : P_sh ⟶ R_sh₂ := CategoryTheory.ObjectProperty.homMk (evLift P_sh.obj M₂ (𝟙 M₂))
    have hg_eq : g₁ = g₂ := by
      apply (adj.homEquiv P R_sh₂).injective
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
      change η_nat ≫ evLift P_sh.obj M₂ (r ≫ η) = η_nat ≫ evLift P_sh.obj M₂ (𝟙 M₂)
      rw [hev_comp, hev_comp, ← CategoryTheory.Category.assoc η r η, h_ηr,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    have h_rη : r ≫ η = 𝟙 M₂ := by
      have hg_hom : g₁.hom = g₂.hom := congrArg (fun k => k.hom) hg_eq
      have hg_ev := congrArg
        (fun k : P_sh.obj ⟶ R_pre M₂ =>
          k.app (Opposite.op T) ≫ CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ T) => M₂) (𝟙 T))
        hg_hom
      dsimp [g₁, g₂] at hg_ev
      rw [hev_eval, hev_eval] at hg_ev
      exact hg_ev
    exact ⟨{ hom := η, inv := r, hom_inv_id := h_ηr, inv_hom_id := h_rη }⟩

  have h_cohom_term : ∀ (Y S : AlgebraicGeometry.Scheme.{u}) (f : Y ⟶ S) (q : ℕ)
      (ℱ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
      let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) f :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B : CategoryTheory.Functor S.Etale Y.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
      let T_S : S.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)
      Nonempty ((((B.op.comp (ℱ.cohomologyPresheaf q)).obj (Opposite.op T_S)) : Type u) ≃+ ℱ.H q) := by
    intro Y S f q ℱ
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor S.Etale Y.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let T_S : S.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)
    let T_Y : Y.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y)
    have hT_Y : CategoryTheory.Limits.IsTerminal T_Y := h_etale_term Y
    let e_B : B.obj T_S ≅ T_Y :=
      CategoryTheory.MorphismProperty.Over.isoMk (pb_id_left f)
        (CategoryTheory.Category.comp_id _)
    let e₁ : (((B.op.comp (ℱ.cohomologyPresheaf q)).obj (Opposite.op T_S)) : Type u) ≃+
        (((ℱ.cohomologyPresheaf q).obj (Opposite.op T_Y)) : Type u) :=
      isoToAddEquiv ((ℱ.cohomologyPresheaf q).mapIso e_B.op.symm)
    let e_yon : ∀ (W : Opposite Y.Etale), (CategoryTheory.yoneda.obj T_Y).obj W ≅ PUnit.{u + 1} :=
      fun W => Equiv.toIso
        { toFun := fun _ => PUnit.unit
          invFun := fun _ => hT_Y.from (Opposite.unop W)
          left_inv := fun g => hT_Y.hom_ext (hT_Y.from (Opposite.unop W)) g
          right_inv := fun ⟨⟩ => rfl }
    let Z_ulift : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let u_hom : AddCommGrpCat.free.obj PUnit.{u + 1} ⟶ Z_ulift :=
      (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} Z_ulift).symm
        (TypeCat.ofHom (fun _ : PUnit.{u + 1} => ULift.up.{u} (1 : ℤ)))
    let gen₀ : AddCommGrpCat.free.obj PUnit.{u + 1} :=
      AddCommGrpCat.adj.unit.app PUnit.{u + 1} PUnit.unit
    let u_inv : Z_ulift ⟶ AddCommGrpCat.free.obj PUnit.{u + 1} :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • gen₀
          map_zero' := zero_zsmul gen₀
          map_add' := fun a b => add_zsmul gen₀ a.down b.down }
    have hu_gen : u_hom gen₀ = ULift.up.{u} (1 : ℤ) := by
      have h1 := (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} Z_ulift).apply_symm_apply
        (TypeCat.ofHom (fun _ : PUnit.{u + 1} => ULift.up.{u} (1 : ℤ)))
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact ConcreteCategory.congr_hom h1 PUnit.unit
    have hu_inv_hom : u_inv ≫ u_hom = 𝟙 Z_ulift := by
      ext ⟨n⟩
      change (u_hom (n • gen₀)).down = n
      rw [map_zsmul, hu_gen]
      change (n • ULift.up.{u} (1 : ℤ)).down = n
      simp
    have hu_hom_inv : u_hom ≫ u_inv = 𝟙 (AddCommGrpCat.free.obj PUnit.{u + 1}) := by
      apply (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} (AddCommGrpCat.free.obj PUnit.{u + 1})).injective
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
      ext ⟨⟩
      change u_inv (u_hom gen₀) = gen₀
      rw [hu_gen]
      exact one_zsmul gen₀
    let e_ℤ : AddCommGrpCat.free.obj PUnit.{u + 1} ≅ Z_ulift :=
      { hom := u_hom, inv := u_inv, hom_inv_id := hu_hom_inv, inv_hom_id := hu_inv_hom }
    let φ_pre : (CategoryTheory.yoneda.obj T_Y).comp AddCommGrpCat.free ≅
        (CategoryTheory.Functor.const (Opposite Y.Etale)).obj Z_ulift :=
      CategoryTheory.NatIso.ofComponents
        (fun W => (AddCommGrpCat.free.mapIso (e_yon W)) ≪≫ e_ℤ)
        (fun {W₁ W₂} φ => by
          have hmap : (CategoryTheory.yoneda.obj T_Y).map φ ≫ (e_yon W₂).hom = (e_yon W₁).hom := by
            ext
          simp only [CategoryTheory.Functor.comp_map, CategoryTheory.Functor.const_obj_map,
            CategoryTheory.Iso.trans_hom, CategoryTheory.Functor.mapIso_hom]
          rw [← CategoryTheory.Category.assoc, ← AddCommGrpCat.free.map_comp, hmap]
          exact (CategoryTheory.Category.comp_id _).symm)
    let φ_ℤ := (CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).mapIso φ_pre
    let to_H : (((ℱ.cohomologyPresheaf q).obj (Opposite.op T_Y)) : Type u) →+ ℱ.H q :=
      (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.inv).precomp ℱ (Nat.zero_add q)
    let inv_H : ℱ.H q →+ (((ℱ.cohomologyPresheaf q).obj (Opposite.op T_Y)) : Type u) :=
      (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.hom).precomp ℱ (Nat.zero_add q)
    have h_left : ∀ x, inv_H (to_H x) = x := by
      intro x
      let x' : CategoryTheory.Abelian.Ext
        ((CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
          ((CategoryTheory.yoneda.obj T_Y).comp AddCommGrpCat.free)) ℱ q := x
      exact (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc φ_ℤ.hom φ_ℤ.inv x').trans
        ((congrArg (fun g => (CategoryTheory.Abelian.Ext.mk₀ g).comp x' (Nat.zero_add q))
          φ_ℤ.hom_inv_id).trans (CategoryTheory.Abelian.Ext.mk₀_id_comp x'))
    have h_right : ∀ y, to_H (inv_H y) = y := by
      intro y
      let y' : CategoryTheory.Abelian.Ext
        ((CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
          ((CategoryTheory.Functor.const (Opposite Y.Etale)).obj Z_ulift)) ℱ q := y
      exact (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc φ_ℤ.inv φ_ℤ.hom y').trans
        ((congrArg (fun g => (CategoryTheory.Abelian.Ext.mk₀ g).comp y' (Nat.zero_add q))
          φ_ℤ.inv_hom_id).trans (CategoryTheory.Abelian.Ext.mk₀_id_comp y'))
    let e₂ : (((ℱ.cohomologyPresheaf q).obj (Opposite.op T_Y)) : Type u) ≃+ ℱ.H q :=
      { toFun := to_H
        invFun := inv_H
        left_inv := h_left
        right_inv := h_right
        map_add' := map_add to_H }
    exact ⟨e₁.trans e₂⟩

  
  have hOpenUp : ∀ (Z₀ V₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType Z₀.hom]
      (f₀ : V₀ ⟶ Z₀), AlgebraicGeometry.IsProper f₀.left →
      ∀ (U'₀ : Z₀.left.Opens) (q : ℕ),
        WeilIsGenFiniteEtaleConstantModPrime ℓ (U'₀ : AlgebraicGeometry.Scheme.{u})
          (weilEtaleHigherDirectImage
            (CategoryTheory.Limits.pullback.snd f₀.left U'₀.ι) q
            (weilEtaleTorsionSheaf (CategoryTheory.Limits.pullback f₀.left U'₀.ι) ℓ)) →
        WeilIsGenFiniteEtaleConstantModPrime ℓ Z₀.left
          (weilEtaleHigherDirectImage f₀.left q (weilEtaleTorsionSheaf V₀.left ℓ)) := by
    intro Z₀ V₀ _ f₀ hProp_f₀ U'₀ q hG'₀
    let G₀ := weilEtaleHigherDirectImage f₀.left q (weilEtaleTorsionSheaf V₀.left ℓ)
    let X'_sch := CategoryTheory.Limits.pullback f₀.left U'₀.ι
    let f'_hom := CategoryTheory.Limits.pullback.snd f₀.left U'₀.ι
    let g'_hom := CategoryTheory.Limits.pullback.fst f₀.left U'₀.ι
    let G'₀ := weilEtaleHigherDirectImage f'_hom q (weilEtaleTorsionSheaf X'_sch ℓ)
    let S' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (U'₀.ι ≫ Z₀.hom)
    let g_S' : S' ⟶ Z₀ := CategoryTheory.Over.homMk U'₀.ι rfl
    let X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (f'_hom ≫ S'.hom)
    let f'_over : X' ⟶ S' := CategoryTheory.Over.homMk f'_hom rfl
    have hg'_w : g'_hom ≫ V₀.hom = X'.hom := by
      dsimp [X', S', g'_hom, f'_hom]
      rw [← CategoryTheory.Over.w f₀, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
    let g'_over : X' ⟶ V₀ := CategoryTheory.Over.homMk g'_hom hg'_w
    have hPB_open : WeilIsEtaleSheafPullback U'₀.ι G₀ G'₀ :=
      hPBC V₀ Z₀ S' X' f₀ g_S' f'_over g'_over hProp_f₀
        (CategoryTheory.IsPullback.of_hasPullback f₀.left U'₀.ι)
        (weilEtaleTorsionSheaf V₀.left ℓ) (weilEtaleTorsionSheaf X'_sch ℓ)
        (hTors_F V₀.left) (h_pb_const X'_sch V₀.left g'_hom A_ℓ) q
    obtain ⟨_, U₂, hNe_U₂, W, p, A, hFin_p, hEt_p, hSurj_p, hFin_A, hTor_A, hPB_p⟩ := hG'₀
    letI : AlgebraicGeometry.IsFinite p := hFin_p
    letI : AlgebraicGeometry.Etale p := hEt_p
    letI : AlgebraicGeometry.Surjective p := hSurj_p
    let U_out : Z₀.left.Opens := U'₀.ι ''ᵁ U₂
    let e_U : (U₂ : AlgebraicGeometry.Scheme.{u}) ≅ (U_out : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.Scheme.Hom.isoImage U'₀.ι U₂
    obtain ⟨x₂⟩ := hNe_U₂
    have hNe_Uout : Nonempty U_out := ⟨e_U.hom.base x₂⟩
    let p_out : W ⟶ (U_out : AlgebraicGeometry.Scheme.{u}) := p ≫ e_U.hom
    have hFin_out : AlgebraicGeometry.IsFinite p_out := inferInstance
    have hEt_out : AlgebraicGeometry.Etale p_out := inferInstance
    have hSurj_out : AlgebraicGeometry.Surjective p_out := inferInstance
    have hComp_eq : p_out ≫ U_out.ι = (p ≫ U₂.ι) ≫ U'₀.ι := by
      dsimp [p_out, e_U, U_out]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.isoImage_hom_ι,
        CategoryTheory.Category.assoc]
    have hPB_tot : WeilIsEtaleSheafPullback ((p ≫ U₂.ι) ≫ U'₀.ι) G₀
        ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A) :=
      h_pb_comp (p ≫ U₂.ι) U'₀.ι G₀ G'₀ _ hPB_open hPB_p
    refine ⟨hTors_R V₀.left Z₀.left f₀.left q, U_out, hNe_Uout, W, p_out, A,
      hFin_out, hEt_out, hSurj_out, hFin_A, hTor_A, ?_⟩
    rw [hComp_eq]
    exact hPB_tot

  have hGoodOpenCard : ∀ (Z₁ V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType Z₁.hom]
      (f₁ : V₁ ⟶ Z₁), AlgebraicGeometry.IsProper f₁.left →
      ∀ (q : ℕ),
        WeilIsGenFiniteEtaleConstantModPrime ℓ Z₁.left
          (weilEtaleHigherDirectImage f₁.left q (weilEtaleTorsionSheaf V₁.left ℓ)) →
        ∃ (U₁ : Z₁.left.Opens) (_ : Nonempty U₁) (M : ℕ),
          ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
            (s₁ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Z₁.left),
            Set.range s₁.base ⊆ (U₁ : Set Z₁.left) →
            Finite (weilEtaleTorsionH (CategoryTheory.Limits.pullback f₁.left s₁) ℓ q) ∧
            Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f₁.left s₁) ℓ q) = M := by
    intro Z₁ V₁ _ f₁ hProp_f₁ q hG₁
    let G₁ := weilEtaleHigherDirectImage f₁.left q (weilEtaleTorsionSheaf V₁.left ℓ)
    obtain ⟨_, U₁, hNe_U₁, W₁, p₁, A, _, hEt_p₁, hSurj_p₁, hFin_A, _, hPB_p₁⟩ := hG₁
    letI : AlgebraicGeometry.Etale p₁ := hEt_p₁
    letI : AlgebraicGeometry.Surjective p₁ := hSurj_p₁
    refine ⟨U₁, hNe_U₁, Nat.card A, ?_⟩
    intro k₀ _ _ s₁ hs₁_range
    let S₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k₀)
    let T₀ : S₀.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S₀)
    have hSec_S₀ : ∀ (V : AlgebraicGeometry.Scheme.{u}) (u : V ⟶ S₀)
        [AlgebraicGeometry.Etale u] [AlgebraicGeometry.Surjective u],
        ∃ σ : S₀ ⟶ V, σ ≫ u = CategoryTheory.CategoryStruct.id S₀ := by
      intro V u _ _
      let P_pt := AlgebraicGeometry.Scheme.geometricFiber k₀
      let R_u := CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton u)
      have hR_mem : R_u ∈ AlgebraicGeometry.Scheme.etaleTopology S₀ :=
        CategoryTheory.Precoverage.generate_mem_toGrothendieck
          ((AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff (@AlgebraicGeometry.Etale) u).mpr
            ⟨u.surjective, inferInstance⟩)
      obtain ⟨Y, f, hf, y, hy⟩ :=
        P_pt.jointly_surjective R_u hR_mem (CategoryTheory.CategoryStruct.id S₀)
      obtain ⟨Z, g, h, hh, rfl⟩ := hf
      cases hh
      let y' : S₀ ⟶ Y := y
      refine ⟨y' ≫ g, ?_⟩
      rw [CategoryTheory.Category.assoc]
      exact hy
    have hTop_T₀ : ∀ R ∈ S₀.smallEtaleTopology T₀, R = ⊤ := by
      intro R hR
      obtain ⟨W, u, w₀, huR, huEt, -⟩ := (h_mem_etale S₀ T₀ R).mp hR (default : ↥S₀)
      let u₀ : W.left ⟶ S₀ := u.left
      have : AlgebraicGeometry.Etale u₀ := huEt
      have : AlgebraicGeometry.Surjective u₀ := ⟨fun x => ⟨w₀, Subsingleton.elim _ _⟩⟩
      obtain ⟨s, hs⟩ := hSec_S₀ W.left u₀
      have hs_hom : s ≫ W.hom = T₀.hom := by
        have hw : u₀ ≫ CategoryTheory.CategoryStruct.id S₀ = W.hom :=
          CategoryTheory.MorphismProperty.Over.w u
        have hu_eq : u₀ = W.hom := (CategoryTheory.Category.comp_id u₀).symm.trans hw
        exact (congrArg (s ≫ ·) hu_eq.symm).trans hs
      let s_et : T₀ ⟶ W := CategoryTheory.MorphismProperty.Over.homMk s hs_hom trivial
      have hs_id : s_et ≫ u = CategoryTheory.CategoryStruct.id T₀ := by
        apply (AlgebraicGeometry.Scheme.Etale.forget S₀).map_injective
        apply CategoryTheory.Over.OverMorphism.ext
        exact hs
      have hid : R.arrows (CategoryTheory.CategoryStruct.id T₀) := by
        rw [← hs_id]
        exact R.downward_closed huR s_et
      exact CategoryTheory.Sieve.id_mem_iff_eq_top.mp hid
    have hs₁_sub : Set.range ⇑s₁.base ⊆ Set.range ⇑U₁.ι.base := by
      rwa [U₁.range_ι]
    let s_U₁ : S₀ ⟶ (U₁ : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.IsOpenImmersion.lift U₁.ι s₁ hs₁_sub
    have hs_U₁_fac : s_U₁ ≫ U₁.ι = s₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U₁.ι s₁ hs₁_sub
    let W_fib := CategoryTheory.Limits.pullback p₁ s_U₁
    let q_fib : W_fib ⟶ S₀ := CategoryTheory.Limits.pullback.snd p₁ s_U₁
    have : AlgebraicGeometry.Etale q_fib := inferInstance
    have : AlgebraicGeometry.Surjective q_fib := inferInstance
    obtain ⟨σ₀, hσ₀⟩ := hSec_S₀ W_fib q_fib
    let s_tilde : S₀ ⟶ W₁ := σ₀ ≫ CategoryTheory.Limits.pullback.fst p₁ s_U₁
    have hs_tilde_fac : s_tilde ≫ (p₁ ≫ U₁.ι) = s₁ := by
      dsimp [s_tilde]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc _ p₁,
        CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, hs_U₁_fac,
        ← CategoryTheory.Category.assoc, hσ₀, CategoryTheory.Category.id_comp]
    have hPB_const : WeilIsEtaleSheafPullback s₁ G₁
        ((CategoryTheory.constantSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
      rw [← hs_tilde_fac]
      exact h_pb_comp s_tilde (p₁ ≫ U₁.ι) G₁ _ _ hPB_p₁ (h_pb_const S₀ W₁ s_tilde A)
    let X_s₁ := CategoryTheory.Limits.pullback f₁.left s₁
    let f_s₁ := CategoryTheory.Limits.pullback.snd f₁.left s₁
    let g_s₁ := CategoryTheory.Limits.pullback.fst f₁.left s₁
    let S'_k₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (s₁ ≫ Z₁.hom)
    let s₁_over : S'_k₀ ⟶ Z₁ := CategoryTheory.Over.homMk s₁ rfl
    let X'_k₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (f_s₁ ≫ S'_k₀.hom)
    let f_s₁_over : X'_k₀ ⟶ S'_k₀ := CategoryTheory.Over.homMk f_s₁ rfl
    have hg_s₁_w : g_s₁ ≫ V₁.hom = X'_k₀.hom := by
      dsimp [X'_k₀, S'_k₀, g_s₁, f_s₁]
      rw [← CategoryTheory.Over.w f₁, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
    let g_s₁_over : X'_k₀ ⟶ V₁ := CategoryTheory.Over.homMk g_s₁ hg_s₁_w
    have hPB_pbc : WeilIsEtaleSheafPullback s₁ G₁
        (weilEtaleHigherDirectImage f_s₁ q (weilEtaleTorsionSheaf X_s₁ ℓ)) :=
      hPBC V₁ Z₁ S'_k₀ X'_k₀ f₁ s₁_over f_s₁_over g_s₁_over hProp_f₁
        (CategoryTheory.IsPullback.of_hasPullback f₁.left s₁)
        (weilEtaleTorsionSheaf V₁.left ℓ) (weilEtaleTorsionSheaf X_s₁ ℓ)
        (hTors_F V₁.left) (h_pb_const X_s₁ V₁.left g_s₁ A_ℓ) q
    obtain ⟨hc_a, hr_a, ⟨e_const_sh⟩⟩ := hPB_const
    obtain ⟨hc_b, hr_b, ⟨e_pbc_sh⟩⟩ := hPB_pbc
    have hhc : hc_a = hc_b := Subsingleton.elim _ _
    subst hhc
    have hhr : hr_a = hr_b := Subsingleton.elim _ _
    subst hhr
    let G_fib := weilEtaleHigherDirectImage f_s₁ q (weilEtaleTorsionSheaf X_s₁ ℓ)
    let e_sheaf : G_fib ≅
        (CategoryTheory.constantSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}).obj A :=
      e_pbc_sh.symm.trans e_const_sh
    let e_GT₀ : G_fib.obj.obj (Opposite.op T₀) ≅
        (((CategoryTheory.constantSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj.obj
          (Opposite.op T₀)) :=
      ((CategoryTheory.sheafSections S₀.smallEtaleTopology AddCommGrpCat.{u}).obj
        (Opposite.op T₀)).mapIso e_sheaf
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f_s₁ :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) f_s₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_fib : CategoryTheory.Functor S₀.Etale X_s₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f_s₁
    let P_fib : CategoryTheory.Functor (Opposite S₀.Etale) AddCommGrpCat.{u} :=
      B_fib.op.comp ((weilEtaleTorsionSheaf X_s₁ ℓ).cohomologyPresheaf q)
    obtain ⟨e_P⟩ := h_top_stalk S₀.smallEtaleTopology T₀ hTop_T₀ P_fib
    obtain ⟨e_A⟩ := h_top_stalk S₀.smallEtaleTopology T₀ hTop_T₀
      ((CategoryTheory.Functor.const (Opposite S₀.Etale)).obj A)
    obtain ⟨e_H⟩ := h_cohom_term X_s₁ S₀ f_s₁ q (weilEtaleTorsionSheaf X_s₁ ℓ)
    let e_mid : (P_fib.obj (Opposite.op T₀) : Type u) ≃+ (A : Type u) :=
      isoToAddEquiv (e_P.trans (e_GT₀.trans e_A.symm))
    let e_tot : weilEtaleTorsionH X_s₁ ℓ q ≃ (A : Type u) :=
      e_H.symm.toEquiv.trans e_mid.toEquiv
    exact ⟨Finite.of_equiv (A : Type u) e_tot.symm, Nat.card_congr e_tot⟩

  
  have exists_dense_algClosed_point : ∀ (X : AlgebraicGeometry.Scheme.{u})
      [AlgebraicGeometry.IsAffine X],
      AlgebraicGeometry.IsIntegral X →
      ∃ (Ω₀ : Type u) (_ : Field Ω₀) (_ : IsAlgClosed Ω₀)
        (η : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ X),
        DenseRange η.base := by
    intro X _ hIntX
    letI : AlgebraicGeometry.IsIntegral X := hIntX
    let R : Type u := ↑(X.presheaf.obj (Opposite.op ⊤))
    have : IsDomain R := by
      dsimp [R]
      infer_instance
    let K : Type u := FractionRing R
    let Ω₀ : Type u := AlgebraicClosure K
    let ψ : R →+* Ω₀ := (algebraMap K Ω₀).comp (algebraMap R K)
    have hψ_inj : Function.Injective ψ :=
      (RingHom.injective (algebraMap K Ω₀)).comp (IsFractionRing.injective R K)
    let e_X : X ≅ AlgebraicGeometry.Spec (CommRingCat.of R) := X.isoSpec
    let η_spec : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)
    let η : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ X := η_spec ≫ e_X.inv
    have hDense_spec : DenseRange η_spec.base := by
      intro y
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω₀)) := (⊥ : PrimeSpectrum Ω₀)
      have hmem_range : η_spec.base pt₀ ∈ Set.range η_spec.base := ⟨pt₀, rfl⟩
      apply closure_mono (Set.singleton_subset_iff.mpr hmem_range)
      change y ∈ closure ({PrimeSpectrum.comap ψ (⊥ : PrimeSpectrum Ω₀)} : Set (PrimeSpectrum R))
      rw [PrimeSpectrum.closure_singleton]
      have hker : (PrimeSpectrum.comap ψ (⊥ : PrimeSpectrum Ω₀)).asIdeal = ⊥ := by
        rw [Submodule.eq_bot_iff]
        intro r hr
        have hr0 : ψ r = 0 := Ideal.mem_bot.mp hr
        exact hψ_inj (hr0.trans (map_zero ψ).symm)
      rw [hker]
      intro r hr
      rw [SetLike.mem_coe, Ideal.mem_bot] at hr
      rw [hr]
      exact Ideal.zero_mem y.asIdeal
    have hDense : DenseRange η.base :=
      (AlgebraicGeometry.Scheme.homeoOfIso e_X.symm).surjective.denseRange.comp
        hDense_spec (AlgebraicGeometry.Scheme.homeoOfIso e_X.symm).continuous
    exact ⟨Ω₀, inferInstance, inferInstance, η, hDense⟩

  obtain ⟨hIsoH, -, hGenCrit⟩ :=
    weil_etale_pbc_henselian_card_and_genFLC_criterion k ℓ hPBC
  obtain ⟨hFinCardShrink, hGenAlgShrink⟩ :=
    weil_affine_integral_finite_fiber_card_and_genAlg_shrinking

  refine ⟨?_, ?_⟩
  · 
    intro Z _ _ hIntZ W g _ q
    let W_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (g ≫ Z.hom)
    let g_over : W_over ⟶ Z := CategoryTheory.Over.homMk g rfl
    have hProp_g : AlgebraicGeometry.IsProper g_over.left := by
      change AlgebraicGeometry.IsProper g
      infer_instance
    match q with
    | n + 1 =>
      obtain ⟨Ω₀, hFieldΩ₀, hAlgΩ₀, η, hDense_η⟩ := exists_dense_algClosed_point Z.left hIntZ
      let _ : Field Ω₀ := hFieldΩ₀
      let _ : IsAlgClosed Ω₀ := hAlgΩ₀
      apply hGenCrit Z W_over hIntZ g_over hProp_g Ω₀ η hDense_η (n + 1)
      intro k₀ _ _ s
      have : AlgebraicGeometry.IsFinite (CategoryTheory.Limits.pullback.snd g_over.left s) := by
        change AlgebraicGeometry.IsFinite (CategoryTheory.Limits.pullback.snd g s)
        infer_instance
      have : AlgebraicGeometry.IsFinite (CategoryTheory.Limits.pullback.snd g_over.left η) := by
        change AlgebraicGeometry.IsFinite (CategoryTheory.Limits.pullback.snd g η)
        infer_instance
      have hSub_s : Subsingleton
          (weilEtaleTorsionH (CategoryTheory.Limits.pullback g_over.left s) ℓ (n + 1)) :=
        (weil_etale_finite_over_algClosed_cohomology_card k₀
          (CategoryTheory.Limits.pullback g_over.left s)
          (CategoryTheory.Limits.pullback.snd g_over.left s) ℓ).2 n
      have hSub_η : Subsingleton
          (weilEtaleTorsionH (CategoryTheory.Limits.pullback g_over.left η) ℓ (n + 1)) :=
        (weil_etale_finite_over_algClosed_cohomology_card Ω₀
          (CategoryTheory.Limits.pullback g_over.left η)
          (CategoryTheory.Limits.pullback.snd g_over.left η) ℓ).2 n
      refine ⟨@Finite.of_subsingleton _ hSub_s, ?_⟩
      rw [@Nat.card_unique _ ⟨0⟩ hSub_s, @Nat.card_unique _ ⟨0⟩ hSub_η]
    | 0 =>
      obtain ⟨U₀, hAff_U₀, hNe_U₀, r₀, hCard_r₀⟩ := hFinCardShrink Z.left hIntZ W g
      apply hOpenUp Z W_over g_over hProp_g U₀ 0
      let Z' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (U₀.ι ≫ Z.hom)
      have : AlgebraicGeometry.IsAffine Z'.left := hAff_U₀
      have : AlgebraicGeometry.LocallyOfFiniteType Z'.hom := by
        dsimp [Z']
        infer_instance
      have hIntZ' : AlgebraicGeometry.IsIntegral Z'.left := by
        change AlgebraicGeometry.IsIntegral (U₀ : AlgebraicGeometry.Scheme.{u})
        have : AlgebraicGeometry.IsIntegral Z.left := hIntZ
        have : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}) := hNe_U₀
        exact AlgebraicGeometry.isIntegral_of_isOpenImmersion U₀.ι
      let g'_hom := CategoryTheory.Limits.pullback.snd g U₀.ι
      have : AlgebraicGeometry.IsFinite g'_hom := inferInstance
      let W' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (g'_hom ≫ Z'.hom)
      let g'_over : W' ⟶ Z' := CategoryTheory.Over.homMk g'_hom rfl
      have hProp_g' : AlgebraicGeometry.IsProper g'_over.left := by
        change AlgebraicGeometry.IsProper g'_hom
        infer_instance
      obtain ⟨Ω₀, hFieldΩ₀, hAlgΩ₀, η, hDense_η⟩ := exists_dense_algClosed_point Z'.left hIntZ'
      let _ : Field Ω₀ := hFieldΩ₀
      let _ : IsAlgClosed Ω₀ := hAlgΩ₀
      apply hGenCrit Z' W' hIntZ' g'_over hProp_g' Ω₀ η hDense_η 0
      intro k₀ _ _ s
      have : AlgebraicGeometry.IsFinite (CategoryTheory.Limits.pullback.snd g'_hom s) :=
        inferInstance
      have : AlgebraicGeometry.IsFinite (CategoryTheory.Limits.pullback.snd g'_hom η) :=
        inferInstance
      obtain ⟨hFin_s, hCard0_s⟩ :=
        (weil_etale_finite_over_algClosed_cohomology_card k₀
          (CategoryTheory.Limits.pullback g'_hom s)
          (CategoryTheory.Limits.pullback.snd g'_hom s) ℓ).1
      obtain ⟨_, hCard0_η⟩ :=
        (weil_etale_finite_over_algClosed_cohomology_card Ω₀
          (CategoryTheory.Limits.pullback g'_hom η)
          (CategoryTheory.Limits.pullback.snd g'_hom η) ℓ).1
      refine ⟨hFin_s, ?_⟩
      change Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback g'_hom s) ℓ 0) ≤
        Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback g'_hom η) ℓ 0)
      rw [hCard0_s, hCard0_η, hCard_r₀ k₀ s, hCard_r₀ Ω₀ η]

  · 
    intro Z₀ Z₁ V₀ _ _ _ _ hIntZ₀ hIntZ₁ f₀ hProp_f₀ g hInj_g hAlg_g hZ₁_genFLC q
    have : AlgebraicGeometry.IsProper f₀.left := hProp_f₀
    let f₁_hom := CategoryTheory.Limits.pullback.snd f₀.left g.left
    have hProp_f₁ : AlgebraicGeometry.IsProper f₁_hom := inferInstance
    let V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (f₁_hom ≫ Z₁.hom)
    let f₁ : V₁ ⟶ Z₁ := CategoryTheory.Over.homMk f₁_hom rfl
    obtain ⟨U₁, hNe_U₁, M, hCard_U₁⟩ :=
      hGoodOpenCard Z₁ V₁ f₁ hProp_f₁ q (hZ₁_genFLC q)
    obtain ⟨U'₀, hAff_U'₀, hNe_U'₀, hLift⟩ :=
      hGenAlgShrink k Z₀ Z₁ hIntZ₀ hIntZ₁ g hInj_g hAlg_g U₁ hNe_U₁
    apply hOpenUp Z₀ V₀ f₀ hProp_f₀ U'₀ q
    let Z'₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (U'₀.ι ≫ Z₀.hom)
    have : AlgebraicGeometry.IsAffine Z'₀.left := hAff_U'₀
    have : AlgebraicGeometry.LocallyOfFiniteType Z'₀.hom := by
      dsimp [Z'₀]
      infer_instance
    have hIntZ'₀ : AlgebraicGeometry.IsIntegral Z'₀.left := by
      change AlgebraicGeometry.IsIntegral (U'₀ : AlgebraicGeometry.Scheme.{u})
      have : AlgebraicGeometry.IsIntegral Z₀.left := hIntZ₀
      have : Nonempty ↥(U'₀ : AlgebraicGeometry.Scheme.{u}) := hNe_U'₀
      exact AlgebraicGeometry.isIntegral_of_isOpenImmersion U'₀.ι
    let f'₀_hom := CategoryTheory.Limits.pullback.snd f₀.left U'₀.ι
    have hProp_f'₀ : AlgebraicGeometry.IsProper f'₀_hom := inferInstance
    let V'₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (f'₀_hom ≫ Z'₀.hom)
    let f'₀ : V'₀ ⟶ Z'₀ := CategoryTheory.Over.homMk f'₀_hom rfl
    have hCard_Z'₀ : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
        (s₀ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Z'₀.left),
        Finite (weilEtaleTorsionH (CategoryTheory.Limits.pullback f'₀.left s₀) ℓ q) ∧
        Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f'₀.left s₀) ℓ q) = M := by
      intro k₀ _ _ s₀
      obtain ⟨s₁, hs₁_mem, hs₁_eq⟩ := hLift k₀ s₀
      let e_left : CategoryTheory.Limits.pullback f'₀.left s₀ ≅
          CategoryTheory.Limits.pullback f₀.left (s₀ ≫ U'₀.ι) :=
        ((CategoryTheory.IsPullback.of_hasPullback f'₀.left s₀).paste_horiz
          (CategoryTheory.IsPullback.of_hasPullback f₀.left U'₀.ι)).isoPullback
      let e_mid : CategoryTheory.Limits.pullback f₀.left (s₀ ≫ U'₀.ι) ≅
          CategoryTheory.Limits.pullback f₀.left (s₁ ≫ g.left) :=
        CategoryTheory.Limits.pullback.congrHom rfl hs₁_eq.symm
      let e_right : CategoryTheory.Limits.pullback f₁.left s₁ ≅
          CategoryTheory.Limits.pullback f₀.left (s₁ ≫ g.left) :=
        ((CategoryTheory.IsPullback.of_hasPullback f₁.left s₁).paste_horiz
          (CategoryTheory.IsPullback.of_hasPullback f₀.left g.left)).isoPullback
      let e_s : CategoryTheory.Limits.pullback f'₀.left s₀ ≅
          CategoryTheory.Limits.pullback f₁.left s₁ :=
        e_left ≪≫ e_mid ≪≫ e_right.symm
      obtain ⟨e_add⟩ := hIsoH e_s q
      obtain ⟨hFin_s₁, hCard_s₁⟩ := hCard_U₁ k₀ s₁ hs₁_mem
      exact ⟨Finite.of_equiv _ e_add.symm.toEquiv,
        (Nat.card_congr e_add.toEquiv).trans hCard_s₁⟩
    obtain ⟨Ω₀, hFieldΩ₀, hAlgΩ₀, η, hDense_η⟩ := exists_dense_algClosed_point Z'₀.left hIntZ'₀
    let _ : Field Ω₀ := hFieldΩ₀
    let _ : IsAlgClosed Ω₀ := hAlgΩ₀
    apply hGenCrit Z'₀ V'₀ hIntZ'₀ f'₀ hProp_f'₀ Ω₀ η hDense_η q
    intro k₀ _ _ s₀
    obtain ⟨hFin_s₀, hEq_s₀⟩ := hCard_Z'₀ k₀ s₀
    obtain ⟨_, hEq_η⟩ := hCard_Z'₀ Ω₀ η
    refine ⟨hFin_s₀, ?_⟩
    rw [hEq_s₀, hEq_η]

theorem weil_p1_finite_cover_branch1_or_flat_generic_fiber (k : Type u) [Field k]
    (Z₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsAffine Z₀.left]
    [AlgebraicGeometry.LocallyOfFiniteType Z₀.hom]
    (hIntZ₀ : AlgebraicGeometry.IsIntegral Z₀.left)
    (Y : AlgebraicGeometry.Scheme.{u})
    (π : Y ⟶ CategoryTheory.Limits.pullback Z₀.hom (weilProjectiveSpaceOver k 1).hom)
    (hIntY : AlgebraicGeometry.IsIntegral Y)
    (hFinπ : AlgebraicGeometry.IsFinite π) :
    let p₁₀ := CategoryTheory.Limits.pullback.fst Z₀.hom (weilProjectiveSpaceOver k 1).hom
    let f_Y := π ≫ p₁₀
    (∃ (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (_ : AlgebraicGeometry.IsAffine Z₁.left)
        (_ : AlgebraicGeometry.LocallyOfFiniteType Z₁.hom)
        (_ : AlgebraicGeometry.IsIntegral Z₁.left)
        (g : Z₁ ⟶ Z₀),
      Function.Injective
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) ∧
      (∀ x : ↑(Z₁.left.presheaf.obj (Opposite.op ⊤)),
        ∃ p : Polynomial ↑(Z₀.left.presheaf.obj (Opposite.op ⊤)),
          p ≠ 0 ∧
          Polynomial.eval₂
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) x p = 0) ∧
      AlgebraicGeometry.IsFinite (CategoryTheory.Limits.pullback.snd f_Y g.left)) ∨
    (∃ (K₀ : Type u) (_ : Field K₀)
        (ι₀ : ↑(Z₀.left.presheaf.obj (Opposite.op ⊤)) →+* K₀),
      @IsFractionRing ↑(Z₀.left.presheaf.obj (Opposite.op ⊤)) _ K₀ _ ι₀.toAlgebra ∧
      let ξ₀ : AlgebraicGeometry.Spec (CommRingCat.of K₀) ⟶ Z₀.left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀) ≫ Z₀.left.isoSpec.inv
      let Y_K₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₀)) :=
        CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f_Y ξ₀)
      ∃ (π_K₀ : Y_K₀ ⟶ weilProjectiveSpaceOver K₀ 1),
        AlgebraicGeometry.IsFinite π_K₀.left ∧
        AlgebraicGeometry.Flat π_K₀.left ∧
        AlgebraicGeometry.Surjective π_K₀.left) :=
by
  
  
  
  have hBranch1 : ∀ (f_Y : Y ⟶ Z₀.left) [AlgebraicGeometry.IsProper f_Y]
      (V : Y.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V)
      (r₀ : ↑(Z₀.left.presheaf.obj (Opposite.op ⊤)))
      (hNonempty : Nonempty ↥(Z₀.left.basicOpen r₀))
      (hSub : (Z₀.left.basicOpen r₀ : Set ↥Z₀.left) ⊆ (f_Y.base '' ((V : Set ↥Y)ᶜ))ᶜ),
      ∃ (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (_ : AlgebraicGeometry.IsAffine Z₁.left)
        (_ : AlgebraicGeometry.LocallyOfFiniteType Z₁.hom)
        (_ : AlgebraicGeometry.IsIntegral Z₁.left)
        (g : Z₁ ⟶ Z₀),
        Function.Injective
          (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) ∧
        (∀ x : ↑(Z₁.left.presheaf.obj (Opposite.op ⊤)),
          ∃ p : Polynomial ↑(Z₀.left.presheaf.obj (Opposite.op ⊤)),
            p ≠ 0 ∧
            Polynomial.eval₂
              (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) x p = 0) ∧
        AlgebraicGeometry.IsFinite (CategoryTheory.Limits.pullback.snd f_Y g.left) := by
    intro f_Y _ V hAffV r₀ hNonempty hSub
    have _ : AlgebraicGeometry.IsIntegral Z₀.left := hIntZ₀
    let R₀ : Type u := ↑(Z₀.left.presheaf.obj (Opposite.op ⊤))
    have _ : IsDomain R₀ := inferInstance
    let W₀ : Z₀.left.Opens := Z₀.left.basicOpen r₀
    let Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (W₀.ι ≫ Z₀.hom)
    let g : Z₁ ⟶ Z₀ := CategoryTheory.Over.homMk W₀.ι rfl
    have hAffZ₁ : AlgebraicGeometry.IsAffine Z₁.left := by
      dsimp [Z₁, W₀]
      infer_instance
    have hLftZ₁ : AlgebraicGeometry.LocallyOfFiniteType Z₁.hom := by
      dsimp [Z₁]
      infer_instance
    have hIntZ₁ : AlgebraicGeometry.IsIntegral Z₁.left :=
      @AlgebraicGeometry.isIntegral_of_isOpenImmersion (W₀ : AlgebraicGeometry.Scheme.{u}) Z₀.left
        W₀.ι inferInstance hIntZ₀ hNonempty
    have hr₀ : r₀ ≠ 0 := by
      intro h0
      rcases hNonempty with ⟨⟨z, hz⟩⟩
      change z ∈ Z₀.left.basicOpen r₀ at hz
      rw [h0, AlgebraicGeometry.Scheme.basicOpen_zero] at hz
      exact False.elim hz
    have hpow_le : Submonoid.powers r₀ ≤ nonZeroDivisors R₀ :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hr₀)
    have halg_eq :
        algebraMap R₀ ↑((W₀ : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) =
          CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop W₀.ι) := rfl
    have hInj : Function.Injective
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) := by
      change Function.Injective (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop W₀.ι))
      rw [← halg_eq]
      exact IsLocalization.injective
        ↑((W₀ : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) hpow_le
    have hAlg : ∀ x : ↑(Z₁.left.presheaf.obj (Opposite.op ⊤)),
        ∃ p : Polynomial R₀,
          p ≠ 0 ∧
          Polynomial.eval₂
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) x p = 0 := by
      intro x
      let x' : ↑((W₀ : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) := x
      obtain ⟨⟨a, s⟩, hs_eq⟩ := IsLocalization.surj (Submonoid.powers r₀) x'
      dsimp only at hs_eq
      have hs_ne : (s : R₀) ≠ 0 := nonZeroDivisors.ne_zero (hpow_le s.2)
      refine ⟨Polynomial.C (s : R₀) * Polynomial.X - Polynomial.C a, ?_, ?_⟩
      · intro hp0
        have hc1 : (Polynomial.C (s : R₀) * Polynomial.X - Polynomial.C a).coeff 1 = (s : R₀) := by
          simp
        rw [hp0, Polynomial.coeff_zero] at hc1
