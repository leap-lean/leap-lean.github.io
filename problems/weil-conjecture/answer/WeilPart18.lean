  have hSingletonSec : ∀ (U : AlgebraicGeometry.Scheme.{u})
      [AlgebraicGeometry.IsAffine U] [Unique ↥U]
      (p_U : U ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      [AlgebraicGeometry.LocallyOfFiniteType p_U]
      (Y : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥Y]
