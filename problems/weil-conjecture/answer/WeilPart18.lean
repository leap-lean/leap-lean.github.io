  have hLiftEt : ∀ {U V : AlgebraicGeometry.Scheme.{u}} (p : V ⟶ U)
      [AlgebraicGeometry.Etale p] [AlgebraicGeometry.Surjective p]
      (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (u : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ U),
