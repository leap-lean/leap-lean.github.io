  have hRedLift : ∀ {S Y : AlgebraicGeometry.Scheme.{u}}
      (D : TopologicalSpace.Closeds ↥S) (g : Y ⟶ S)
      [AlgebraicGeometry.QuasiCompact g] [AlgebraicGeometry.IsReduced Y],
      Set.range g.base ⊆ (D : Set ↥S) →
      ∃ g' : Y ⟶ (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subscheme,
        g' ≫ (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subschemeι = g ∧
        (AlgebraicGeometry.IsClosedImmersion g → AlgebraicGeometry.IsClosedImmersion g') := by
    intro S Y D g _ _ hRange
    let I_D := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D
    let i_D := I_D.subschemeι
    have hSuppLe : g.ker.support ≤ I_D.support := by
      intro x hx
      change x ∈ (I_D.support : Set ↥S)
      rw [AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
      change x ∈ (g.ker.support : Set ↥S) at hx
      rw [AlgebraicGeometry.Scheme.Hom.support_ker] at hx
      exact (D.isClosed.closure_subset_iff.mpr hRange) hx
