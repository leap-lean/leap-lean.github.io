        refine ⟨y.comp hS₀.extClass rfl, ?_⟩
        have hmap_comp : (P_push_Z.mapExtAddHom (C_Z.obj Aℤ) ℱ (m + 1)) (y.comp hS₀.extClass rfl) =
            ((P_push_Z.mapExtAddHom (C_Z.obj Aℤ) Q m) y).comp hS'₀.extClass rfl := by
          rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
            Abelian.Ext.mapExactFunctor_comp]
          congr 1
          exact Abelian.Ext.mapExactFunctor_extClass P_push_Z hS₀
        dsimp only [Θ]
        rw [hmap_comp,
          ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ρ_ℤ) _ _ (Nat.zero_add m) rfl (Nat.zero_add (m + 1))]
        exact hy'
    exact (hΘ_surj r (weilEtaleTorsionSheaf Z n)).subsingleton

  
  
  
  have hPart4 : ∀ {Y₀ X₀ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Y₀ X₀)
      [AlgebraicGeometry.IsProper f] (V : X₀.Opens) (δ n : ℕ),
      WeilAltIsEtaleSheetSplit δ (f ∣_ V) →
      let U_Y : Y₀.Opens := (TopologicalSpace.Opens.map f.base).obj V
      let B := weilEtaleSitePullback f
      ∃ (η₀ : weilAltZeroBdrySubpresheaf X₀ V n ⟶ B.op ⋙ weilAltZeroBdrySubpresheaf Y₀ U_Y n)
        (τ₀ : B.op ⋙ weilAltZeroBdrySubpresheaf Y₀ U_Y n ⟶ weilAltZeroBdrySubpresheaf X₀ V n),
        CategoryStruct.comp η₀
          (Functor.whiskerLeft B.op (weilAltZeroBdrySubpresheafι Y₀ U_Y n)) =
          CategoryStruct.comp (weilAltZeroBdrySubpresheafι X₀ V n)
            (weilAltLocConstPullbackNat f n) ∧
        CategoryStruct.comp η₀ τ₀ =
          δ • CategoryStruct.id (weilAltZeroBdrySubpresheaf X₀ V n) := by
    clear * -
    intro Y₀ X₀ f _ V δ n hSplit
    classical
    let P_et : MorphismProperty Scheme.{u} := @Etale
    let U_Y : Y₀.Opens := (TopologicalSpace.Opens.map f.base).obj V
    let B := weilEtaleSitePullback f
    let FgtX := Scheme.Etale.forget X₀
    let FgtY := Scheme.Etale.forget Y₀
    let η₀ : weilAltZeroBdrySubpresheaf X₀ V n ⟶ B.op ⋙ weilAltZeroBdrySubpresheaf Y₀ U_Y n :=
      { app := fun U =>
          let U₀ := Opposite.unop U
          let pr₁ : (FgtY.obj (B.obj U₀)).left ⟶ (FgtX.obj U₀).left :=
            Limits.pullback.fst (FgtX.obj U₀).hom f
          AddCommGrpCat.ofHom
            { toFun := fun g =>
                ⟨{ toFun := fun y => g.1 (pr₁ y)
                   isLocallyConstant := fun t =>
                     pr₁.continuous.isOpen_preimage _ (g.1.isLocallyConstant t) },
                 fun y hy => g.2 (pr₁ y) (fun hmem => hy (by
                   change f ((FgtY.obj (B.obj U₀)).hom y) ∈ (V : Set ↥X₀)
                   have hcomm : (FgtX.obj U₀).hom (pr₁ y) = f ((FgtY.obj (B.obj U₀)).hom y) := by
                     rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply]
                     exact congrArg (fun k => k y) (Limits.pullback.condition (f := (FgtX.obj U₀).hom) (g := f))
                   rwa [← hcomm]))⟩
              map_zero' := Subtype.ext (LocallyConstant.ext (fun _ => rfl))
              map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext (fun _ => rfl)) }
        naturality := fun {U₁ U₂} u =>
          AddCommGrpCat.ext (fun (g : ↥(weilAltZeroBdrySubgroup X₀ V n (Opposite.unop U₁))) =>
            Subtype.ext (LocallyConstant.ext (fun y =>
              congrArg g.1
                ((Scheme.Hom.comp_apply
                  (FgtY.map (B.map u.unop)).left
                  (Limits.pullback.fst (FgtX.obj (Opposite.unop U₁)).hom f) y).symm.trans
                ((congrArg (fun k : (FgtY.obj (B.obj (Opposite.unop U₂))).left ⟶
                    (FgtX.obj (Opposite.unop U₁)).left => k y)
                  (Limits.pullback.lift_fst _ _ _)).trans
                (Scheme.Hom.comp_apply
                  (Limits.pullback.fst (FgtX.obj (Opposite.unop U₂)).hom f)
                  (FgtX.map u.unop).left y))).symm))) }
    have hη₀_comm : η₀ ≫ Functor.whiskerLeft B.op (weilAltZeroBdrySubpresheafι Y₀ U_Y n) =
        weilAltZeroBdrySubpresheafι X₀ V n ≫ weilAltLocConstPullbackNat f n :=
      NatTrans.ext (funext fun _ => AddCommGrpCat.ext (fun _ => rfl))
    let IsSheetTuple (W : X₀.Etale) (σ : Fin δ → (W.left ⟶ (B.obj W).left)) : Prop :=
      (∀ j : Fin δ, σ j ≫ Limits.pullback.fst W.hom f = 𝟙 W.left) ∧
      (∀ i j : Fin δ, i ≠ j → Disjoint (Set.range (σ i)) (Set.range (σ j))) ∧
      (⋃ j : Fin δ, Set.range (σ j)) = Set.univ
    have hPullSheetTuple : ∀ {W₁ W₂ : X₀.Etale} (g : W₁ ⟶ W₂)
        (σ : Fin δ → (W₂.left ⟶ (B.obj W₂).left)),
        IsSheetTuple W₂ σ →
        ∃ τ : Fin δ → (W₁.left ⟶ (B.obj W₁).left),
          IsSheetTuple W₁ τ ∧
          ∀ j : Fin δ, τ j ≫ (B.map g).left = g.left ≫ σ j := by
      intro W₁ W₂ g σ ⟨hSec, hDisj, hUniv⟩
      let pr₁_1 : (B.obj W₁).left ⟶ W₁.left := Limits.pullback.fst W₁.hom f
      let pr₁_2 : (B.obj W₂).left ⟶ W₂.left := Limits.pullback.fst W₂.hom f
      let bg : (B.obj W₁).left ⟶ (B.obj W₂).left := (B.map g).left
      have hbg_fst : bg ≫ pr₁_2 = pr₁_1 ≫ g.left := Limits.pullback.lift_fst _ _ _
      have hbg_snd : bg ≫ Limits.pullback.snd W₂.hom f = Limits.pullback.snd W₁.hom f :=
        Limits.pullback.lift_snd _ _ _
      have h_outer : IsPullback (bg ≫ Limits.pullback.snd W₂.hom f) pr₁_1 f (g.left ≫ W₂.hom) := by
        rw [hbg_snd, MorphismProperty.Over.w g]
        exact (IsPullback.of_hasPullback W₁.hom f).flip
      have hpb_B : IsPullback bg pr₁_1 pr₁_2 g.left :=
        IsPullback.of_right h_outer hbg_fst (IsPullback.of_hasPullback W₂.hom f).flip
      let τ : Fin δ → (W₁.left ⟶ (B.obj W₁).left) := fun j =>
        hpb_B.lift (g.left ≫ σ j) (𝟙 W₁.left) (by
          rw [Category.assoc, hSec j, Category.comp_id, Category.id_comp])
      have hτ_bg : ∀ j : Fin δ, τ j ≫ bg = g.left ≫ σ j :=
        fun j => hpb_B.lift_fst _ _ _
      have hτ_sec : ∀ j : Fin δ, τ j ≫ pr₁_1 = 𝟙 W₁.left :=
        fun j => hpb_B.lift_snd _ _ _
      have hRange_τ : ∀ j : Fin δ, Set.range (τ j) = bg ⁻¹' Set.range (σ j) := by
        intro j
        ext q
        constructor
        · rintro ⟨w₁, rfl⟩
          change (τ j ≫ bg) w₁ ∈ Set.range (σ j)
          rw [hτ_bg j]
          exact ⟨g.left w₁, rfl⟩
        · rintro ⟨w₂, hw₂⟩
          have hpb_sec : IsPullback (τ j) g.left bg (σ j) := by
            have h_out : IsPullback (τ j ≫ pr₁_1) g.left g.left (σ j ≫ pr₁_2) := by
              rw [hτ_sec j, hSec j]
              exact IsPullback.of_id_fst
            exact IsPullback.of_right h_out (hτ_bg j) hpb_B.flip
          obtain ⟨z, hz₁, -⟩ := Scheme.Pullback.exists_preimage_pullback q w₂ hw₂.symm
          refine ⟨hpb_sec.isoPullback.inv z, ?_⟩
          have hinv : hpb_sec.isoPullback.inv ≫ τ j = Limits.pullback.fst bg (σ j) :=
            hpb_sec.isoPullback_inv_fst
          change (hpb_sec.isoPullback.inv ≫ τ j) z = q
          rw [hinv]
          exact hz₁
      refine ⟨τ, ⟨hτ_sec, ?_, ?_⟩, hτ_bg⟩
      · intro i j hij
        rw [hRange_τ i, hRange_τ j]
        exact (hDisj i j hij).preimage _
      · ext q
        simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
        have hmem : bg q ∈ ⋃ j : Fin δ, Set.range (σ j) := by
          rw [hUniv]; trivial
        rcases Set.mem_iUnion.mp hmem with ⟨j, hj⟩
        exact ⟨j, by rw [hRange_τ j]; exact hj⟩
    have hLocalChart : ∀ (U' : X₀.Etale) (x : ↥U'.left) (_hx : U'.hom x ∈ V),
        ∃ (W : X₀.Etale) (g : W ⟶ U') (a₀ : ↥W.left) (σ : Fin δ → (W.left ⟶ (B.obj W).left)),
          Etale g.left ∧ g.left a₀ = x ∧ (∀ w : ↥W.left, U'.hom (g.left w) ∈ V) ∧
          IsSheetTuple W σ := by
      intro U' x hx
      let u_pt : ↥V.toScheme := ⟨U'.hom x, hx⟩
      obtain ⟨V_u, v_u, σ_u, hv_et, ⟨z_u, hz_u⟩, hσ_sec, _, hσ_disj, hσ_univ⟩ := hSplit u_pt
      have hvV_et : P_et (v_u ≫ V.ι) := MorphismProperty.comp_mem P_et v_u V.ι hv_et inferInstance
      let V'_sch := Limits.pullback U'.hom (v_u ≫ V.ι)
      let p_U' : V'_sch ⟶ U'.left := Limits.pullback.fst U'.hom (v_u ≫ V.ι)
      let p_Vu : V'_sch ⟶ V_u := Limits.pullback.snd U'.hom (v_u ≫ V.ι)
      have hp_et : P_et p_U' :=
        MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (IsPullback.of_hasPullback U'.hom (v_u ≫ V.ι)).flip hvV_et
      let W : X₀.Etale := MorphismProperty.Over.mk ⊤ (p_U' ≫ U'.hom)
        (MorphismProperty.comp_mem P_et p_U' U'.hom hp_et U'.prop)
      let g : W ⟶ U' := MorphismProperty.Over.homMk p_U' rfl
      have hpt_eq : U'.hom x = (v_u ≫ V.ι) z_u := by
        change U'.hom x = V.ι (v_u z_u)
        rw [hz_u]
        rfl
      obtain ⟨a₀, ha₀, -⟩ := Scheme.Pullback.exists_preimage_pullback x z_u hpt_eq
      have hw_in_V : ∀ w : ↥W.left, U'.hom (g.left w) ∈ V := by
        intro w
        have hc : (p_U' ≫ U'.hom) w = (p_Vu ≫ (v_u ≫ V.ι)) w :=
          congrArg (fun k => k w) (Limits.pullback.condition (f := U'.hom) (g := v_u ≫ V.ι))
        change (p_U' ≫ U'.hom) w ∈ V
        rw [hc]
        exact (v_u (p_Vu w)).2
      let P_u := Limits.pullback (f ∣_ V) v_u
      let fst_u : P_u ⟶ U_Y.toScheme := Limits.pullback.fst (f ∣_ V) v_u
      let snd_u : P_u ⟶ V_u := Limits.pullback.snd (f ∣_ V) v_u
      have hpb_res : IsPullback (f ∣_ V) U_Y.ι V.ι f := isPullback_morphismRestrict f V
      have hpb_u : IsPullback fst_u snd_u (f ∣_ V) v_u := IsPullback.of_hasPullback (f ∣_ V) v_u
      have hpb_rect : IsPullback snd_u (fst_u ≫ U_Y.ι) (v_u ≫ V.ι) f :=
        hpb_u.flip.paste_vert hpb_res
      let pr₁_W : (B.obj W).left ⟶ W.left := Limits.pullback.fst W.hom f
      let snd_W : (B.obj W).left ⟶ Y₀ := Limits.pullback.snd W.hom f
      have hc_Whom : W.hom = p_Vu ≫ (v_u ≫ V.ι) := Limits.pullback.condition
      have hW_cond : (pr₁_W ≫ p_Vu) ≫ (v_u ≫ V.ι) = snd_W ≫ f :=
        (Category.assoc pr₁_W p_Vu (v_u ≫ V.ι)).trans
          ((congrArg (pr₁_W ≫ ·) hc_Whom.symm).trans Limits.pullback.condition)
      let q_Pu : (B.obj W).left ⟶ P_u := hpb_rect.lift (pr₁_W ≫ p_Vu) snd_W hW_cond
      have hq_snd : q_Pu ≫ snd_u = pr₁_W ≫ p_Vu := hpb_rect.lift_fst _ _ _
      have hq_fst : q_Pu ≫ (fst_u ≫ U_Y.ι) = snd_W := hpb_rect.lift_snd _ _ _
      have h_outer : IsPullback pr₁_W (q_Pu ≫ (fst_u ≫ U_Y.ι)) (p_Vu ≫ (v_u ≫ V.ι)) f :=
        hq_fst.symm ▸ hc_Whom ▸ IsPullback.of_hasPullback W.hom f
      have hpb_q : IsPullback pr₁_W q_Pu p_Vu snd_u :=
        IsPullback.of_bot h_outer hq_snd.symm hpb_rect
      let σ : Fin δ → (W.left ⟶ (B.obj W).left) := fun j =>
        hpb_q.lift (𝟙 V'_sch) (p_Vu ≫ σ_u j)
          ((Category.id_comp p_Vu).trans
            (((Category.assoc p_Vu (σ_u j) snd_u).trans
              ((congrArg (p_Vu ≫ ·) (hσ_sec j)).trans (Category.comp_id p_Vu))).symm))
      have hσW_sec : ∀ j : Fin δ, σ j ≫ pr₁_W = 𝟙 W.left := fun j => hpb_q.lift_fst _ _ _
      have hσW_q : ∀ j : Fin δ, σ j ≫ q_Pu = p_Vu ≫ σ_u j := fun j => hpb_q.lift_snd _ _ _
      have hRange_σ : ∀ j : Fin δ, Set.range (σ j) = q_Pu ⁻¹' Set.range (σ_u j) := by
        intro j
        ext q
        constructor
        · rintro ⟨w, rfl⟩
          change (σ j ≫ q_Pu) w ∈ Set.range (σ_u j)
          rw [hσW_q j]
          exact ⟨p_Vu w, rfl⟩
        · rintro ⟨b, hb⟩
          have hpb_sec : IsPullback (σ j) p_Vu q_Pu (σ_u j) := by
            have h_out : IsPullback (σ j ≫ pr₁_W) p_Vu p_Vu (σ_u j ≫ snd_u) := by
              rw [hσW_sec j, hσ_sec j]
              exact IsPullback.of_id_fst
            exact IsPullback.of_right h_out (hσW_q j) hpb_q
          obtain ⟨z, hz₁, -⟩ := Scheme.Pullback.exists_preimage_pullback q b hb.symm
          refine ⟨hpb_sec.isoPullback.inv z, ?_⟩
          have hinv : hpb_sec.isoPullback.inv ≫ σ j = Limits.pullback.fst q_Pu (σ_u j) :=
            hpb_sec.isoPullback_inv_fst
          change (hpb_sec.isoPullback.inv ≫ σ j) z = q
          rw [hinv]
          exact hz₁
      refine ⟨W, g, a₀, σ, hp_et, ha₀, hw_in_V, hσW_sec, ?_, ?_⟩
      · intro i j hij
        rw [hRange_σ i, hRange_σ j]
        exact (hσ_disj i j hij).preimage _
      · ext q
        simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
        have hmem : q_Pu q ∈ ⋃ j : Fin δ, Set.range (σ_u j) := by
          rw [hσ_univ]; trivial
        rcases Set.mem_iUnion.mp hmem with ⟨j, hj⟩
        exact ⟨j, by rw [hRange_σ j]; exact hj⟩
    have hSheetSumEq : ∀ {U' W₁ W₂ : X₀.Etale}
        (g₁ : W₁ ⟶ U') (g₂ : W₂ ⟶ U')
        (σ₁ : Fin δ → (W₁.left ⟶ (B.obj W₁).left))
        (σ₂ : Fin δ → (W₂.left ⟶ (B.obj W₂).left))
        (_hS₁ : IsSheetTuple W₁ σ₁) (_hS₂ : IsSheetTuple W₂ σ₂)
        (_hEt₂ : Etale g₂.left)
        (s : LocallyConstant ↥(B.obj U').left (ULift.{u} (ZMod n)))
        (w₁ : ↥W₁.left) (w₂ : ↥W₂.left) (_hw : g₁.left w₁ = g₂.left w₂),
        (∑ i : Fin δ, s (((B.map g₁).left) ((σ₁ i) w₁))) =
          (∑ j : Fin δ, s (((B.map g₂).left) ((σ₂ j) w₂))) := by
      intro U' W₁ W₂ g₁ g₂ σ₁ σ₂ hS₁ hS₂ hEt₂ s w₁ w₂ hw
      let P_sch := Limits.pullback g₁.left g₂.left
      let pr₁ : P_sch ⟶ W₁.left := Limits.pullback.fst g₁.left g₂.left
      let pr₂ : P_sch ⟶ W₂.left := Limits.pullback.snd g₁.left g₂.left
      have hpr₁_et : P_et pr₁ :=
        MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (IsPullback.of_hasPullback g₁.left g₂.left).flip hEt₂
      let Z_et : X₀.Etale := MorphismProperty.Over.mk ⊤ (pr₁ ≫ W₁.hom)
        (MorphismProperty.comp_mem P_et pr₁ W₁.hom hpr₁_et W₁.prop)
      let p₁ : Z_et ⟶ W₁ := MorphismProperty.Over.homMk pr₁ rfl
      let p₂ : Z_et ⟶ W₂ := MorphismProperty.Over.homMk pr₂ (by
        change pr₂ ≫ W₂.hom = pr₁ ≫ W₁.hom
        rw [← MorphismProperty.Over.w g₁, ← MorphismProperty.Over.w g₂,
          ← Category.assoc, ← Category.assoc, Limits.pullback.condition])
      have hp_comm : p₁ ≫ g₁ = p₂ ≫ g₂ := MorphismProperty.Over.Hom.ext Limits.pullback.condition
      obtain ⟨z, hz₁, hz₂⟩ := Scheme.Pullback.exists_preimage_pullback w₁ w₂ hw
      obtain ⟨τ₁, ⟨hτ₁_sec, hτ₁_disj, _⟩, hτ₁_comm⟩ := hPullSheetTuple p₁ σ₁ hS₁
      obtain ⟨τ₂, ⟨hτ₂_sec, hτ₂_disj, hτ₂_univ⟩, hτ₂_comm⟩ := hPullSheetTuple p₂ σ₂ hS₂
      let prZ : (B.obj Z_et).left ⟶ Z_et.left := Limits.pullback.fst Z_et.hom f
      have hFib₂ : ∀ i : Fin δ, ∃ j : Fin δ, (τ₂ j) z = (τ₁ i) z := by
        intro i
        have hmem : (τ₁ i) z ∈ ⋃ j : Fin δ, Set.range (τ₂ j) := by
          rw [hτ₂_univ]; trivial
        rcases Set.mem_iUnion.mp hmem with ⟨j, z', hz'⟩
        have hz'_eq : z' = z := by
          have h1 : prZ ((τ₂ j) z') = prZ ((τ₁ i) z) := congrArg prZ hz'
          have h2 : prZ ((τ₂ j) z') = z' := by
            change (τ₂ j ≫ prZ) z' = z'
            rw [hτ₂_sec j]; rfl
          have h3 : prZ ((τ₁ i) z) = z := by
            change (τ₁ i ≫ prZ) z = z
            rw [hτ₁_sec i]; rfl
          exact h2.symm.trans (h1.trans h3)
        exact ⟨j, hz' ▸ congrArg (τ₂ j) hz'_eq.symm⟩
      let π_fn : Fin δ → Fin δ := fun i => Classical.choose (hFib₂ i)
      have hπ_spec : ∀ i : Fin δ, (τ₂ (π_fn i)) z = (τ₁ i) z :=
        fun i => Classical.choose_spec (hFib₂ i)
      have hπ_inj : Function.Injective π_fn := by
        intro i₁ i₂ h_eq
        by_contra hne
        have h_pt : (τ₁ i₁) z = (τ₁ i₂) z := by
          rw [← hπ_spec i₁, ← hπ_spec i₂, h_eq]
        exact Set.disjoint_left.mp (hτ₁_disj i₁ i₂ hne) ⟨z, rfl⟩ ⟨z, h_pt.symm⟩
      let e_perm : Equiv.Perm (Fin δ) :=
        Equiv.ofBijective π_fn ⟨hπ_inj, Finite.injective_iff_surjective.mp hπ_inj⟩
      have hlhs : ∀ i : Fin δ,
          s (((B.map g₁).left) ((σ₁ i) w₁)) = s (((B.map (p₁ ≫ g₁)).left) ((τ₁ i) z)) := by
        intro i
        congr 1
        rw [B.map_comp]
        change ((B.map g₁).left) ((σ₁ i) w₁) = ((B.map g₁).left) (((B.map p₁).left) ((τ₁ i) z))
        congr 1
        have hc := congrArg (fun k => k z) (hτ₁_comm i)
        change ((B.map p₁).left) ((τ₁ i) z) = (σ₁ i) (pr₁ z) at hc
        rw [hc, hz₁]
      have hrhs : ∀ j : Fin δ,
          s (((B.map g₂).left) ((σ₂ j) w₂)) = s (((B.map (p₁ ≫ g₁)).left) ((τ₂ j) z)) := by
        intro j
        congr 1
        rw [hp_comm, B.map_comp]
        change ((B.map g₂).left) ((σ₂ j) w₂) = ((B.map g₂).left) (((B.map p₂).left) ((τ₂ j) z))
        congr 1
        have hc := congrArg (fun k => k z) (hτ₂_comm j)
        change ((B.map p₂).left) ((τ₂ j) z) = (σ₂ j) (pr₂ z) at hc
        rw [hc, hz₂]
      calc
        (∑ i : Fin δ, s (((B.map g₁).left) ((σ₁ i) w₁)))
          = ∑ i : Fin δ, s (((B.map (p₁ ≫ g₁)).left) ((τ₁ i) z)) :=
              Finset.sum_congr rfl (fun i _ => hlhs i)
        _ = ∑ i : Fin δ, s (((B.map (p₁ ≫ g₁)).left) ((τ₂ (e_perm i)) z)) :=
              Finset.sum_congr rfl (fun i _ => by
                change _ = s (((B.map (p₁ ≫ g₁)).left) ((τ₂ (π_fn i)) z))
                rw [hπ_spec i])
        _ = ∑ j : Fin δ, s (((B.map (p₁ ≫ g₁)).left) ((τ₂ j) z)) :=
              Equiv.sum_comp e_perm (fun j => s (((B.map (p₁ ≫ g₁)).left) ((τ₂ j) z)))
        _ = ∑ j : Fin δ, s (((B.map g₂).left) ((σ₂ j) w₂)) :=
              Finset.sum_congr rfl (fun j _ => (hrhs j).symm)
    let W_ch (U' : X₀.Etale) (x : ↥U'.left) (hx : U'.hom x ∈ V) : X₀.Etale :=
      Classical.choose (hLocalChart U' x hx)
    let g_ch (U' : X₀.Etale) (x : ↥U'.left) (hx : U'.hom x ∈ V) : W_ch U' x hx ⟶ U' :=
