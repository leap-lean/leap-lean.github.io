      exact CategoryTheory.Limits.IsZero.of_iso (Φ₂.map_isZero hKerZero) (iso₁ ≪≫ iso₂ ≪≫ iso₃)
    have hLim : CategoryTheory.Limits.PreservesFiniteLimits (pb h) := by
      rw [CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono]
      intro S hS
      have _ : CategoryTheory.Mono S.f := hS.mono_f
      exact ⟨((CategoryTheory.Functor.preservesFiniteColimits_iff_forall_exact_map_and_epi
        (pb h)).mp hColim S hS).1, hMono S.f⟩
    exact ⟨hAdd, hColim, hLim⟩
  have hMonoOfStalks : ∀ (W : AlgebraicGeometry.Scheme.{u})
      {G₁ G₂ : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}} (α : G₁ ⟶ G₂),
