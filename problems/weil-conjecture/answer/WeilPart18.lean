        have hEqCard : Nat.card M₁ = Nat.card M := Nat.card_congr e_CA.toEquiv
        rw [hEqCard]
        exact hLe_s
      choose E_rep _ z_rep hz_rep s_rep hs_rep using fun m₁ : M₁ => hSurj₁ m₁
      let Φ_z : M₁ → M₂ :=
        fun m₁ => ev₂ (E_rep m₁) (z_rep m₁) (hz_rep m₁)
          ((Φ.hom.app (Opposite.op (E_rep m₁))) (s_rep m₁))
      have hΦ_z_eval : ∀ (E : V.Etale)
          (z_E : AlgebraicGeometry.Spec (CommRingCat.of k_x) ⟶ E.left)
          (hz_E : z_E ≫ E.hom = z)
          (s₁ : ↥((C_V.obj A).obj.obj (Opposite.op E))),
          Φ_z (ev₁ E z_E hz_E s₁) =
            ev₂ E z_E hz_E ((Φ.hom.app (Opposite.op E)) s₁) := by
        intro E z_E hz_E s₁
        set m₁ := ev₁ E z_E hz_E s₁
        haveI : AlgebraicGeometry.Etale (E_rep m₁).hom := (E_rep m₁).prop
        haveI : AlgebraicGeometry.Etale E.hom := E.prop
        let fst := CategoryTheory.Limits.pullback.fst (E_rep m₁).hom E.hom
        let snd := CategoryTheory.Limits.pullback.snd (E_rep m₁).hom E.hom
        let P_E : V.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (fst ≫ (E_rep m₁).hom) inferInstance
        let z_P : AlgebraicGeometry.Spec (CommRingCat.of k_x) ⟶ P_E.left :=
          CategoryTheory.Limits.pullback.lift (z_rep m₁) z_E
            ((hz_rep m₁).trans hz_E.symm)
        have hz_P : z_P ≫ P_E.hom = z := by
          change z_P ≫ fst ≫ (E_rep m₁).hom = z
          erw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hz_rep m₁]
        let π₁ : P_E ⟶ E_rep m₁ := CategoryTheory.MorphismProperty.Over.homMk fst rfl
        let π₂ : P_E ⟶ E := CategoryTheory.MorphismProperty.Over.homMk snd
          CategoryTheory.Limits.pullback.condition.symm
        let d₁ := ((C_V.obj A).obj.map π₁.op) (s_rep m₁) - ((C_V.obj A).obj.map π₂.op) s₁
        have hd₁_ev : ev₁ P_E z_P hz_P d₁ = 0 := by
          dsimp [d₁]
          rw [map_sub,
            hComp₁ P_E (E_rep m₁) π₁ z_P (z_rep m₁) hz_P (hz_rep m₁)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _) (s_rep m₁),
            hComp₁ P_E E π₂ z_P z_E hz_P hz_E
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) s₁,
            hs_rep m₁, sub_self]
        obtain ⟨E', _, g, z', hz', hz'_g, hd₁_zero⟩ := hZero₁ P_E z_P hz_P d₁ hd₁_ev
        dsimp [d₁] at hd₁_zero
        rw [map_sub, sub_eq_zero] at hd₁_zero
        have hsec_eq : ((C_V.obj A).obj.map (g ≫ π₁).op) (s_rep m₁) =
            ((C_V.obj A).obj.map (g ≫ π₂).op) s₁ := by
          erw [((C_V.obj A).obj).map_comp, ((C_V.obj A).obj).map_comp]
          exact hd₁_zero
        have hΦ_eq : (G_V.obj.map (g ≫ π₁).op)
              ((Φ.hom.app (Opposite.op (E_rep m₁))) (s_rep m₁)) =
            (G_V.obj.map (g ≫ π₂).op) ((Φ.hom.app (Opposite.op E)) s₁) := by
          have hn₁ := congrArg (fun k => k (s_rep m₁)) (Φ.hom.naturality (g ≫ π₁).op)
          have hn₂ := congrArg (fun k => k s₁) (Φ.hom.naturality (g ≫ π₂).op)
          erw [← hn₁, ← hn₂]
          exact congrArg (Φ.hom.app (Opposite.op E')) hsec_eq
        have hz'_1 : z' ≫ (g ≫ π₁).left = z_rep m₁ := by
          change z' ≫ (g.left ≫ fst) = z_rep m₁
          erw [← Category.assoc, hz'_g, CategoryTheory.Limits.pullback.lift_fst]
        have hz'_2 : z' ≫ (g ≫ π₂).left = z_E := by
          change z' ≫ (g.left ≫ snd) = z_E
          erw [← Category.assoc, hz'_g, CategoryTheory.Limits.pullback.lift_snd]
        calc
          Φ_z m₁ = ev₂ E' z' hz' ((G_V.obj.map (g ≫ π₁).op)
              ((Φ.hom.app (Opposite.op (E_rep m₁))) (s_rep m₁))) :=
            (hComp₂ E' (E_rep m₁) (g ≫ π₁) z' (z_rep m₁) hz' (hz_rep m₁) hz'_1 _).symm
          _ = ev₂ E' z' hz' ((G_V.obj.map (g ≫ π₂).op) ((Φ.hom.app (Opposite.op E)) s₁)) := by
            rw [hΦ_eq]
          _ = ev₂ E z_E hz_E ((Φ.hom.app (Opposite.op E)) s₁) :=
            hComp₂ E' E (g ≫ π₂) z' z_E hz' hz_E hz'_2 _
      have hΦ_z_inj : Function.Injective Φ_z := by
        intro m_a m_b hm_eq
        haveI : AlgebraicGeometry.Etale (E_rep m_a).hom := (E_rep m_a).prop
        haveI : AlgebraicGeometry.Etale (E_rep m_b).hom := (E_rep m_b).prop
        let fst := CategoryTheory.Limits.pullback.fst (E_rep m_a).hom (E_rep m_b).hom
        let snd := CategoryTheory.Limits.pullback.snd (E_rep m_a).hom (E_rep m_b).hom
        let P_ab : V.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (fst ≫ (E_rep m_a).hom) inferInstance
        let z_P : AlgebraicGeometry.Spec (CommRingCat.of k_x) ⟶ P_ab.left :=
          CategoryTheory.Limits.pullback.lift (z_rep m_a) (z_rep m_b)
            ((hz_rep m_a).trans (hz_rep m_b).symm)
        have hz_P : z_P ≫ P_ab.hom = z := by
          change z_P ≫ fst ≫ (E_rep m_a).hom = z
          erw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hz_rep m_a]
        let π₁ : P_ab ⟶ E_rep m_a := CategoryTheory.MorphismProperty.Over.homMk fst rfl
        let π₂ : P_ab ⟶ E_rep m_b := CategoryTheory.MorphismProperty.Over.homMk snd
          CategoryTheory.Limits.pullback.condition.symm
        let d := ((C_V.obj A).obj.map π₁.op) (s_rep m_a) -
          ((C_V.obj A).obj.map π₂.op) (s_rep m_b)
        have hd_ev₁ : ev₁ P_ab z_P hz_P d = m_a - m_b := by
          dsimp [d]
          rw [map_sub,
            hComp₁ P_ab (E_rep m_a) π₁ z_P (z_rep m_a) hz_P (hz_rep m_a)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _) (s_rep m_a),
            hComp₁ P_ab (E_rep m_b) π₂ z_P (z_rep m_b) hz_P (hz_rep m_b)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) (s_rep m_b),
            hs_rep m_a, hs_rep m_b]
        have hd_ev₂ : ev₂ P_ab z_P hz_P ((Φ.hom.app (Opposite.op P_ab)) d) = 0 := by
          dsimp [d]
          rw [map_sub, map_sub]
          have hn₁ := congrArg (fun k => k (s_rep m_a)) (Φ.hom.naturality π₁.op)
          have hn₂ := congrArg (fun k => k (s_rep m_b)) (Φ.hom.naturality π₂.op)
          dsimp at hn₁ hn₂
          rw [hn₁, hn₂,
            hComp₂ P_ab (E_rep m_a) π₁ z_P (z_rep m_a) hz_P (hz_rep m_a)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _) _,
            hComp₂ P_ab (E_rep m_b) π₂ z_P (z_rep m_b) hz_P (hz_rep m_b)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) _]
          exact sub_eq_zero.mpr hm_eq
        obtain ⟨E', _, g, z', hz', hz'_g, hd_G0⟩ :=
          hZero₂ P_ab z_P hz_P ((Φ.hom.app (Opposite.op P_ab)) d) hd_ev₂
        have hΦ_d0 : (Φ.hom.app (Opposite.op E')) (((C_V.obj A).obj.map g.op) d) = 0 := by
          have hn := congrArg (fun k => k d) (Φ.hom.naturality g.op)
          dsimp at hn
          rw [hn]
          exact hd_G0
        have hd_0 : ((C_V.obj A).obj.map g.op) d = 0 :=
          hInj_Φ E' (hΦ_d0.trans (map_zero _).symm)
        have hdiff0 : m_a - m_b = 0 := by
          rw [← hd_ev₁, ← hComp₁ E' P_ab g z' z_P hz' hz_P hz'_g d, hd_0, map_zero]
        exact sub_eq_zero.mp hdiff0
      have hΦ_z_surj : Function.Surjective Φ_z :=
        (hΦ_z_inj.bijective_of_nat_card_le hCard_M₂_le_M₁).2
      obtain ⟨m₁, hm₁⟩ := hΦ_z_surj (ev₂ W₁ z_W rfl t)
      obtain ⟨E_x, _, z_Ex, hz_Ex, s_x, rfl⟩ := hSurj₁ m₁
      rw [hΦ_z_eval E_x z_Ex hz_Ex s_x] at hm₁
      haveI : AlgebraicGeometry.Etale W₁.hom := W₁.prop
      haveI : AlgebraicGeometry.Etale E_x.hom := E_x.prop
      let fst_x := CategoryTheory.Limits.pullback.fst W₁.hom E_x.hom
      let snd_x := CategoryTheory.Limits.pullback.snd W₁.hom E_x.hom
      let P_x : V.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (fst_x ≫ W₁.hom) inferInstance
      let z_Px : AlgebraicGeometry.Spec (CommRingCat.of k_x) ⟶ P_x.left :=
        CategoryTheory.Limits.pullback.lift z_W z_Ex hz_Ex.symm
      have hz_Px : z_Px ≫ P_x.hom = z := by
        change z_Px ≫ fst_x ≫ W₁.hom = z
        erw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      let π₁_x : P_x ⟶ W₁ := CategoryTheory.MorphismProperty.Over.homMk fst_x rfl
      let π₂_x : P_x ⟶ E_x := CategoryTheory.MorphismProperty.Over.homMk snd_x
        CategoryTheory.Limits.pullback.condition.symm
      let d_t := (G_V.obj.map π₁_x.op) t -
        (G_V.obj.map π₂_x.op) ((Φ.hom.app (Opposite.op E_x)) s_x)
      have hdt_ev₂ : ev₂ P_x z_Px hz_Px d_t = 0 := by
        dsimp [d_t]
        rw [map_sub,
          hComp₂ P_x W₁ π₁_x z_Px z_W hz_Px rfl
            (CategoryTheory.Limits.pullback.lift_fst _ _ _) t,
          hComp₂ P_x E_x π₂_x z_Px z_Ex hz_Px hz_Ex
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) _,
          hm₁, sub_self]
      obtain ⟨E'_x, _, g_x, z'_x, _, hz'_gx, hdt_zero⟩ := hZero₂ P_x z_Px hz_Px d_t hdt_ev₂
      dsimp [d_t] at hdt_zero
      rw [map_sub, sub_eq_zero] at hdt_zero
      let f_x : E'_x ⟶ W₁ := g_x ≫ π₁_x
      let s_tilde_x := ((C_V.obj A).obj.map (g_x ≫ π₂_x).op) s_x
      refine ⟨E'_x, f_x, ?_, z'_x.base pt_kx, ?_⟩
      · refine ⟨s_tilde_x, ?_⟩
        have hn := congrArg (fun k => k s_x) (Φ.hom.naturality (g_x ≫ π₂_x).op)
        dsimp [s_tilde_x, f_x] at hn ⊢
        erw [hn, G_V.obj.map_comp, G_V.obj.map_comp]
        exact hdt_zero.symm
      · have h_pt_eq : z'_x ≫ f_x.left = z_W := by
          change z'_x ≫ (g_x.left ≫ fst_x) = z_W
          erw [← Category.assoc, hz'_gx, CategoryTheory.Limits.pullback.lift_fst]
        exact (congrArg (fun m => m.base pt_kx) h_pt_eq).trans hz_W_pt
    choose E'_cov f_cov hf_img y_cov hy_cov using hPt
    exact (hMemEtale V W₁ (CategoryTheory.Presheaf.imageSieve Φ.hom t)).mpr
      ⟨↥W₁.left, E'_cov, f_cov, hf_img, fun x => ⟨x, y_cov x, hy_cov x⟩⟩
  haveI : CategoryTheory.Epi Φ :=
    (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} Φ).mp hLocSurj_Φ
  haveI : CategoryTheory.IsIso Φ := CategoryTheory.isIso_of_mono_of_epi Φ
  refine ⟨hTors, U, hU_ne, V, p, A, hp_fin, hp_et, hp_surj, hFin_A, hTors_A, ?_⟩
  exact ⟨hCont_Bq, hRA_Bq, ⟨e_PB_GV.trans (CategoryTheory.asIso Φ).symm⟩⟩

theorem weil_etale_pbc_henselian_card_and_genFLC_criterion (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ) :
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (e : X₁ ≅ X₂) (q : ℕ),
      Nonempty (weilEtaleTorsionH X₁ ℓ q ≃+ weilEtaleTorsionH X₂ ℓ q)) ∧
    (∀ (Z₁ C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.LocallyOfFiniteType Z₁.hom]
        (f : C ⟶ Z₁), AlgebraicGeometry.IsProper f.left →
        ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
          [IsSepClosed (IsLocalRing.ResidueField A)]
          (g_A : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Z₁.left)
          (k₁ : Type u) [Field k₁] [IsAlgClosed k₁]
          (u_A : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of A)),
          (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₁)),
            u_A.base pt = IsLocalRing.closedPoint A) →
          ∀ (q : ℕ),
            Nat.card (weilEtaleTorsionH
                (CategoryTheory.Limits.pullback f.left (u_A ≫ g_A)) ℓ q) =
              Nat.card (weilEtaleTorsionH
                (CategoryTheory.Limits.pullback f.left g_A) ℓ q)) ∧
    (∀ (Z₁ C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsAffine Z₁.left]
        [AlgebraicGeometry.LocallyOfFiniteType Z₁.hom],
        AlgebraicGeometry.IsIntegral Z₁.left →
        ∀ (f : C ⟶ Z₁), AlgebraicGeometry.IsProper f.left →
        ∀ (Ω₀ : Type u) [Field Ω₀] [IsAlgClosed Ω₀]
          (η : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ Z₁.left),
          DenseRange η.base →
          ∀ (q : ℕ),
            (∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
                (s : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Z₁.left),
              Finite (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left s) ℓ q) ∧
              Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left s) ℓ q) ≤
                Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left η) ℓ q)) →
            WeilIsGenFiniteEtaleConstantModPrime ℓ Z₁.left
              (weilEtaleHigherDirectImage f.left q (weilEtaleTorsionSheaf C.left ℓ))) :=
by
  classical
  obtain ⟨hIsoH, hConstPB, hExPB, hCompPB, hTorsSh, hTorsR⟩ :=
    weil_etale_pullback_functoriality_and_iso_torsionH.{u} ℓ
  have hSepRes : ∀ (F : Type u) [Field F] [IsSepClosed F],
      IsSepClosed (IsLocalRing.ResidueField F) := by
    intro F _ _
    let e : F ≃+* IsLocalRing.ResidueField F :=
      RingEquiv.ofBijective (IsLocalRing.residue F)
        ⟨RingHom.injective (IsLocalRing.residue F), IsLocalRing.residue_surjective⟩
    refine ⟨fun p hp => ?_⟩
    have hp' : (p.map e.symm.toRingHom).Separable := hp.map
    have hsp' : (p.map e.symm.toRingHom).Splits :=
      IsSepClosed.splits_of_separable (p.map e.symm.toRingHom) hp'
    have hmap : (p.map e.symm.toRingHom).map e.toRingHom = p := by
      rw [Polynomial.map_map, RingEquiv.toRingHom_comp_symm_toRingHom, Polynomial.map_id]
    rw [← hmap]
    exact hsp'.map e.toRingHom
  have hPBC_at : ∀ (Z₁ C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType Z₁.hom]
      (f : C ⟶ Z₁), AlgebraicGeometry.IsProper f.left →
      ∀ {Y : AlgebraicGeometry.Scheme.{u}} (h : Y ⟶ Z₁.left) (q : ℕ),
        WeilIsEtaleSheafPullback h
          (weilEtaleHigherDirectImage f.left q (weilEtaleTorsionSheaf C.left ℓ))
          (weilEtaleHigherDirectImage (CategoryTheory.Limits.pullback.snd f.left h) q
            (weilEtaleTorsionSheaf (CategoryTheory.Limits.pullback f.left h) ℓ)) := by
    intro Z₁ C _ f hf_prop Y h q
    let S' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (h ≫ Z₁.hom)
    let X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk
        (CategoryTheory.Limits.pullback.snd f.left h ≫ (h ≫ Z₁.hom))
    let g_ov : S' ⟶ Z₁ := CategoryTheory.Over.homMk h rfl
    let f'_ov : X' ⟶ S' :=
      CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.snd f.left h) rfl
    let g'_ov : X' ⟶ C :=
      CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.fst f.left h) (by
        dsimp [X']
        rw [← f.w, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc])
    exact hPBC C Z₁ S' X' f g_ov f'_ov g'_ov hf_prop
      (CategoryTheory.IsPullback.of_hasPullback f.left h)
      (weilEtaleTorsionSheaf C.left ℓ)
      (weilEtaleTorsionSheaf (CategoryTheory.Limits.pullback f.left h) ℓ)
      (hTorsSh C.left)
      (hConstPB (CategoryTheory.Limits.pullback.fst f.left h)
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))))
      q
  refine ⟨hIsoH, ?_, ?_⟩
  · intro Z₁ C _ f hf_prop A _ _ _ g_A k₁ _ _ u_A hu_A q
    let G := weilEtaleHigherDirectImage f.left q (weilEtaleTorsionSheaf C.left ℓ)
    let G_A := weilEtaleHigherDirectImage (CategoryTheory.Limits.pullback.snd f.left g_A) q
      (weilEtaleTorsionSheaf (CategoryTheory.Limits.pullback f.left g_A) ℓ)
    let G_k₁ := weilEtaleHigherDirectImage
      (CategoryTheory.Limits.pullback.snd f.left (u_A ≫ g_A)) q
      (weilEtaleTorsionSheaf (CategoryTheory.Limits.pullback f.left (u_A ≫ g_A)) ℓ)
    have hPB_A : WeilIsEtaleSheafPullback g_A G G_A :=
      hPBC_at Z₁ C f hf_prop g_A q
    have hPB_k₁ : WeilIsEtaleSheafPullback (u_A ≫ g_A) G G_k₁ :=
      hPBC_at Z₁ C f hf_prop (u_A ≫ g_A) q
    have hPB_u : WeilIsEtaleSheafPullback u_A G_A G_k₁ :=
      (hCompPB u_A g_A G G_A G_k₁ hPB_A).mpr hPB_k₁
    obtain ⟨hEval_A, hPull_A⟩ :=
      weil_strictly_henselian_spec_etale_eval_and_pullback A
    have : HenselianLocalRing k₁ := Field.henselian k₁
    have : IsSepClosed (IsLocalRing.ResidueField k₁) := hSepRes k₁
    obtain ⟨hEval_k₁, _⟩ :=
      weil_strictly_henselian_spec_etale_eval_and_pullback k₁
    obtain ⟨e_mid⟩ := hPull_A k₁ u_A hu_A G_A G_k₁ hPB_u
    obtain ⟨e_A⟩ := hEval_A (CategoryTheory.Limits.pullback f.left g_A)
      (CategoryTheory.Limits.pullback.snd f.left g_A) q
      (weilEtaleTorsionSheaf (CategoryTheory.Limits.pullback f.left g_A) ℓ)
    obtain ⟨e_k₁⟩ := hEval_k₁ (CategoryTheory.Limits.pullback f.left (u_A ≫ g_A))
      (CategoryTheory.Limits.pullback.snd f.left (u_A ≫ g_A)) q
      (weilEtaleTorsionSheaf (CategoryTheory.Limits.pullback f.left (u_A ≫ g_A)) ℓ)
    exact Nat.card_congr (e_k₁.symm.trans (e_mid.trans e_A)).toEquiv
  · intro Z₁ C _ _ hIntZ₁ f hf_prop Ω₀ _ _ η hDense q hBound
    
    obtain ⟨_, hAffEtShrink⟩ :=
      weil_affine_integral_etale_shrinking_and_domain_cover Z₁.left hIntZ₁
    have hShrink : ∀ (Ω₁ : Type u) [Field Ω₁] [IsAlgClosed Ω₁]
        (η_Z : AlgebraicGeometry.Spec (CommRingCat.of Ω₁) ⟶ Z₁.left),
        DenseRange η_Z.base →
        ∀ (W₀ : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W₀]
          (w₀ : W₀ ⟶ Z₁.left), AlgebraicGeometry.Etale w₀ →
          ∀ (η₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω₁) ⟶ W₀),
            η₀ ≫ w₀ = η_Z →
            ∃ (U : Z₁.left.Opens) (_ : Nonempty U)
              (V : AlgebraicGeometry.Scheme.{u})
              (p : V ⟶ (U : AlgebraicGeometry.Scheme.{u}))
              (ι_V : V ⟶ W₀)
              (η_V : AlgebraicGeometry.Spec (CommRingCat.of Ω₁) ⟶ V),
              AlgebraicGeometry.IsIntegral V ∧
              AlgebraicGeometry.IsFinite p ∧
              AlgebraicGeometry.Etale p ∧
              AlgebraicGeometry.Surjective p ∧
              AlgebraicGeometry.Etale ι_V ∧
              ι_V ≫ w₀ = p ≫ U.ι ∧
              η_V ≫ ι_V = η₀ ∧
              DenseRange η_V.base := by
      intro Ω₁ _ _ η_Z hDense_Z W₀ _ w₀ hw₀ η₀ hη₀
      let R : Type u := ↑(Z₁.left.presheaf.obj (Opposite.op ⊤))
      have : IsDomain R := by
        dsimp [R]
        infer_instance
      let e_Z : Z₁.left ≅ AlgebraicGeometry.Spec (CommRingCat.of R) := Z₁.left.isoSpec
      let S : Type u := ↑(W₀.presheaf.obj (Opposite.op ⊤))
      let e_W : W₀ ≅ AlgebraicGeometry.Spec (CommRingCat.of S) := W₀.isoSpec
      let w_spec : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R) :=
        e_W.inv ≫ w₀ ≫ e_Z.hom
      have hw_spec : AlgebraicGeometry.Etale w_spec := by
        dsimp [w_spec]
        infer_instance
      let f_RS : R →+* S := (AlgebraicGeometry.Spec.preimage w_spec).hom
      have hf_RS_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_RS) = w_spec :=
        AlgebraicGeometry.Spec.map_preimage w_spec
      letI : Algebra R S := f_RS.toAlgebra
      have : Algebra.Etale R S := by
        rw [← RingHom.etale_algebraMap]
        change f_RS.Etale
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hf_RS_map.symm ▸ hw_spec)
      have : Module.Flat R S := inferInstance
      let η' : AlgebraicGeometry.Spec (CommRingCat.of Ω₁) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R) := η_Z ≫ e_Z.hom
      let φ_η : R →+* Ω₁ := (AlgebraicGeometry.Spec.preimage η').hom
      have hφ_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_η) = η' :=
        AlgebraicGeometry.Spec.map_preimage η'
      have hDense' : DenseRange η'.base :=
        (AlgebraicGeometry.Scheme.homeoOfIso e_Z).surjective.denseRange.comp
          hDense_Z (AlgebraicGeometry.Scheme.homeoOfIso e_Z).continuous
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω₁)) := (⊥ : PrimeSpectrum Ω₁)
      have hRange_pt : Set.range ⇑η'.base = {η'.base pt₀} := by
        ext y
        simp only [Set.mem_range, Set.mem_singleton_iff]
        exact ⟨fun ⟨z, hz⟩ => hz ▸ congrArg η'.base (Subsingleton.elim z pt₀),
          fun hy => ⟨pt₀, hy.symm⟩⟩
      have hBotMem : (⊥ : PrimeSpectrum R) ∈
          closure ({η'.base pt₀} : Set (PrimeSpectrum R)) := by
        change (⊥ : PrimeSpectrum R) ∈
          closure ({η'.base pt₀} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R)))
        rw [← hRange_pt, hDense'.closure_eq]
        trivial
      erw [PrimeSpectrum.closure_singleton] at hBotMem
      have hIdealBot : (η'.base pt₀).asIdeal = ⊥ := le_bot_iff.mp hBotMem
      have hKer : RingHom.ker φ_η = ⊥ := by
        have hcomap : PrimeSpectrum.comap φ_η pt₀ = η'.base pt₀ := by
          rw [← hφ_map]; rfl
        have hker_eq : (PrimeSpectrum.comap φ_η pt₀).asIdeal = RingHom.ker φ_η := rfl
        rw [← hker_eq, hcomap, hIdealBot]
      have hφ_inj : Function.Injective φ_η := by
        intro a b hab
        have hmem : a - b ∈ RingHom.ker φ_η := by
          rw [RingHom.mem_ker, map_sub, hab, sub_self]
        rw [hKer, Ideal.mem_bot] at hmem
        exact sub_eq_zero.mp hmem
      let η₀' : AlgebraicGeometry.Spec (CommRingCat.of Ω₁) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of S) := η₀ ≫ e_W.hom
      let ψ₀ : S →+* Ω₁ := (AlgebraicGeometry.Spec.preimage η₀').hom
      have hψ₀_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) = η₀' :=
        AlgebraicGeometry.Spec.map_preimage η₀'
      have hψ₀_comp : ψ₀.comp (algebraMap R S) = φ_η := by
        have hspec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀.comp f_RS)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_η) := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
            hψ₀_map, hf_RS_map, hφ_map]
          dsimp [η₀', w_spec, η']
          rw [CategoryTheory.Category.assoc, e_W.hom_inv_id_assoc,
            ← CategoryTheory.Category.assoc, hη₀]
        exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hspec)
      let K : Type u := FractionRing R
      let φ_K : K →+* Ω₁ := IsFractionRing.lift hφ_inj
      have hφ_K_comp : φ_K.comp (algebraMap R K) = φ_η := by
        ext r
        exact IsFractionRing.lift_algebraMap hφ_inj r
      let S_K : Type u := TensorProduct R K S
      have : Algebra.Etale K S_K := inferInstance
      have hInc_inj : Function.Injective (Algebra.TensorProduct.includeRight : S →ₐ[R] S_K) := by
        have hinj_RK : Function.Injective (IsScalarTower.toAlgHom R R K).toLinearMap :=
          IsFractionRing.injective R K
        have hflat := Module.Flat.rTensor_preserves_injective_linearMap (M := S)
          (IsScalarTower.toAlgHom R R K).toLinearMap hinj_RK
        intro s₁ s₂ hs
        have h1 : LinearMap.rTensor S (IsScalarTower.toAlgHom R R K).toLinearMap
            ((TensorProduct.lid R S).symm s₁) =
          LinearMap.rTensor S (IsScalarTower.toAlgHom R R K).toLinearMap
            ((TensorProduct.lid R S).symm s₂) := by
          simpa using hs
        exact (TensorProduct.lid R S).symm.injective (hflat h1)
      obtain ⟨I, hFinI, L, hFieldL, hAlgKL, Θ, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K S_K).mp inferInstance
      letI : Finite I := hFinI
      letI : Fintype I := Fintype.ofFinite I
      letI : ∀ i, Field (L i) := hFieldL
      letI : ∀ i, Algebra K (L i) := hAlgKL
      letI : Algebra R Ω₁ := φ_η.toAlgebra
      let φ_K_alg : K →ₐ[R] Ω₁ :=
        { φ_K with commutes' := fun r => congrFun (congrArg DFunLike.coe hφ_K_comp) r }
      let ψ₀_alg : S →ₐ[R] Ω₁ :=
        { ψ₀ with commutes' := fun r => congrFun (congrArg DFunLike.coe hψ₀_comp) r }
      let Ψ_K : S_K →ₐ[R] Ω₁ :=
        Algebra.TensorProduct.lift φ_K_alg ψ₀_alg (fun _ _ => Commute.all _ _)
      let χ : (∀ i : I, L i) →+* Ω₁ := Ψ_K.toRingHom.comp Θ.symm.toRingHom
      have hex_i₀ : ∃ i₀ : I, χ (Pi.single i₀ 1) ≠ 0 := by
        by_contra! hall
        have h1 : (1 : ∀ i : I, L i) = ∑ i : I, Pi.single i (1 : L i) := by
          ext j
          simp [Finset.sum_apply]
        have h0 : (1 : Ω₁) = 0 := by
          calc
            (1 : Ω₁) = χ 1 := (map_one χ).symm
            _ = ∑ i : I, χ (Pi.single i 1) := by rw [h1, map_sum]
            _ = 0 := Finset.sum_eq_zero (fun i _ => hall i)
        exact one_ne_zero h0
      obtain ⟨i₀, hi₀_ne⟩ := hex_i₀
      have hi₀_one : χ (Pi.single i₀ 1) = 1 := by
        have hidem : χ (Pi.single i₀ 1) * χ (Pi.single i₀ 1) = χ (Pi.single i₀ 1) := by
          rw [← map_mul]
          congr 1
          ext j
          by_cases hj : j = i₀
          · subst hj; simp
          · simp [Pi.single_eq_of_ne hj]
        exact mul_left_cancel₀ hi₀_ne (hidem.trans (mul_one _).symm)
      have hχ_kill : ∀ v : (∀ i : I, L i), v i₀ = 0 → χ v = 0 := by
        intro v hv
        have hprod : Pi.single i₀ (1 : L i₀) * v = 0 := by
          ext j
          by_cases hj : j = i₀
          · subst hj; simp [hv]
          · simp [Pi.single_eq_of_ne hj]
        calc
          χ v = 1 * χ v := (one_mul _).symm
          _ = χ (Pi.single i₀ 1) * χ v := by rw [hi₀_one]
          _ = χ (Pi.single i₀ 1 * v) := (map_mul χ _ _).symm
          _ = 0 := by rw [hprod, map_zero]
      let lam : L i₀ →+* Ω₁ :=
        { toFun := fun x => χ (Pi.single i₀ x)
          map_one' := hi₀_one
          map_mul' := fun x y => by
            rw [← map_mul]
            congr 1
            ext j
            by_cases hj : j = i₀
            · subst hj; simp
            · simp [Pi.single_eq_of_ne hj]
          map_zero' := by rw [Pi.single_zero, map_zero]
          map_add' := fun x y => by rw [Pi.single_add, map_add] }
      have hχ_eq : ∀ v : (∀ i : I, L i), χ v = lam (v i₀) := by
        intro v
        have hdiff : χ (v - Pi.single i₀ (v i₀)) = 0 := by
          apply hχ_kill
          simp
        exact sub_eq_zero.mp ((map_sub χ v _).symm.trans hdiff)
      have hRK_ne : ∀ d : R, d ≠ 0 → algebraMap R K d ≠ 0 :=
        fun d hd h0 => hd (IsFractionRing.injective R K (h0.trans (map_zero _).symm))
      have hTensorDenom : ∀ z : S_K, ∃ (d : R) (u : S),
          d ≠ 0 ∧ z = TensorProduct.tmul R (algebraMap R K d)⁻¹ u := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero =>
          exact ⟨1, 0, one_ne_zero, by simp⟩
        | tmul k s =>
          obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors R) k
          have hb_ne : (b : R) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b.2
          have hb_K : algebraMap R K (b : R) ≠ 0 := hRK_ne b hb_ne
          have hk_eq : k = a • (algebraMap R K (b : R))⁻¹ := by
            rw [Algebra.smul_def, eq_mul_inv_iff_mul_eq₀ hb_K]
            exact hab
          refine ⟨b, a • s, hb_ne, ?_⟩
          rw [hk_eq, TensorProduct.smul_tmul]
        | add z₁ z₂ ih₁ ih₂ =>
          obtain ⟨d₁, u₁, hd₁, rfl⟩ := ih₁
          obtain ⟨d₂, u₂, hd₂, rfl⟩ := ih₂
          have hd12 : d₁ * d₂ ≠ 0 := mul_ne_zero hd₁ hd₂
          have hd₁_K : algebraMap R K d₁ ≠ 0 := hRK_ne d₁ hd₁
          have hd₂_K : algebraMap R K d₂ ≠ 0 := hRK_ne d₂ hd₂
          have hd12_K : algebraMap R K (d₁ * d₂) ≠ 0 := hRK_ne (d₁ * d₂) hd12
          refine ⟨d₁ * d₂, d₂ • u₁ + d₁ • u₂, hd12, ?_⟩
          have hinv1 : (algebraMap R K d₁)⁻¹ = d₂ • (algebraMap R K (d₁ * d₂))⁻¹ := by
            apply mul_right_cancel₀ hd12_K
            rw [Algebra.smul_def, mul_assoc, inv_mul_cancel₀ hd12_K, mul_one,
              map_mul, ← mul_assoc, inv_mul_cancel₀ hd₁_K, one_mul]
          have hinv2 : (algebraMap R K d₂)⁻¹ = d₁ • (algebraMap R K (d₁ * d₂))⁻¹ := by
            apply mul_right_cancel₀ hd12_K
            rw [Algebra.smul_def, mul_assoc, inv_mul_cancel₀ hd12_K, mul_one,
              map_mul, mul_comm (algebraMap R K d₁), ← mul_assoc, inv_mul_cancel₀ hd₂_K, one_mul]
          rw [TensorProduct.tmul_add, ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul,
            ← hinv1, ← hinv2]
      let e_K : S_K := Θ.symm (Pi.single i₀ 1)
      obtain ⟨d_e, u_e, hd_e_ne, he_K⟩ := hTensorDenom e_K
      have hd_e_K : algebraMap R K d_e ≠ 0 := hRK_ne d_e hd_e_ne
      have hu_e_eq : TensorProduct.tmul R (1 : K) u_e = d_e • e_K := by
        rw [he_K, TensorProduct.smul_tmul', Algebra.smul_def, mul_inv_cancel₀ hd_e_K]
      let g : S := algebraMap R S d_e * u_e
      let π_i₀ : S →+* L i₀ :=
        (Pi.evalRingHom L i₀).comp
          (Θ.toRingHom.comp (Algebra.TensorProduct.includeRight : S →ₐ[R] S_K).toRingHom)
      have hψ₀_fac : lam.comp π_i₀ = ψ₀ := by
        ext s
        change lam ((Θ (Algebra.TensorProduct.includeRight s)) i₀) = ψ₀ s
        rw [← hχ_eq]
        change Ψ_K (Θ.symm (Θ (TensorProduct.tmul R 1 s))) = ψ₀ s
        rw [AlgEquiv.symm_apply_apply]
        erw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      have hπ_de : π_i₀ (algebraMap R S d_e) = algebraMap K (L i₀) (algebraMap R K d_e) := by
        change (Θ (TensorProduct.tmul R 1 (algebraMap R S d_e))) i₀ = _
        have htmul : TensorProduct.tmul R (1 : K) (algebraMap R S d_e) =
            algebraMap K S_K (algebraMap R K d_e) := by
          calc
            TensorProduct.tmul R (1 : K) (algebraMap R S d_e)
              = TensorProduct.tmul R (1 : K) (d_e • (1 : S)) := by rw [Algebra.smul_def, mul_one]
            _ = TensorProduct.tmul R (d_e • (1 : K)) (1 : S) := by
                rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul']
            _ = algebraMap K S_K (algebraMap R K d_e) := by
                rw [Algebra.smul_def, mul_one]; rfl
        rw [htmul, Θ.commutes]
        rfl
      have hπ_de_ne : π_i₀ (algebraMap R S d_e) ≠ 0 := by
        rw [hπ_de]
        exact fun h0 =>
          hd_e_K ((RingHom.injective (algebraMap K (L i₀))) (h0.trans (map_zero _).symm))
      have hπ_ue : π_i₀ u_e = π_i₀ (algebraMap R S d_e) := by
        change (Θ (TensorProduct.tmul R 1 u_e)) i₀ = _
        rw [hu_e_eq]
        have hsmul : d_e • e_K = algebraMap K S_K (algebraMap R K d_e) * e_K := by
          rw [← Algebra.smul_def]
          exact (IsScalarTower.algebraMap_smul K d_e e_K).symm
        rw [hsmul, map_mul, Θ.commutes, AlgEquiv.apply_symm_apply]
        simp [hπ_de]
      have hπ_g_ne : π_i₀ g ≠ 0 := by
        dsimp [g]
        rw [map_mul, hπ_ue]
        exact mul_ne_zero hπ_de_ne hπ_de_ne
      let S_g : Type u := Localization.Away g
      let π_loc : S_g →+* L i₀ := IsLocalization.Away.lift g (IsUnit.mk0 (π_i₀ g) hπ_g_ne)
      have hπ_loc_inj : Function.Injective π_loc := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        obtain ⟨⟨s, _, ⟨n, rfl⟩⟩, hs⟩ := IsLocalization.surj (Submonoid.powers g) z
        have hgn_unit : IsUnit (algebraMap S S_g (g ^ n)) := by
          rw [map_pow]
          exact (IsLocalization.Away.algebraMap_isUnit g).pow n
        have hs_π : π_i₀ s = 0 := by
          have h1 : π_loc (z * algebraMap S S_g (g ^ n)) = π_loc (algebraMap S S_g s) :=
            congrArg π_loc hs
          rw [map_mul, hz, zero_mul, IsLocalization.Away.lift_eq] at h1
          exact h1.symm
        have heK_s : e_K * TensorProduct.tmul R (1 : K) s = 0 := by
          apply Θ.injective
          rw [map_mul, map_zero]
          ext j
          change (Θ e_K * Θ (TensorProduct.tmul R 1 s)) j = 0
          rw [Pi.mul_apply]
          dsimp [e_K]
          rw [AlgEquiv.apply_symm_apply]
          by_cases hj : j = i₀
          · subst hj
            rw [Pi.single_eq_same, one_mul]
            exact hs_π
          · rw [Pi.single_eq_of_ne hj, zero_mul]
        have hgs_tmul : TensorProduct.tmul R (1 : K) (g * s) = 0 := by
          have h2 : TensorProduct.tmul R (1 : K) (g * s) =
              (d_e * d_e) • (e_K * TensorProduct.tmul R (1 : K) s) := by
            calc
              TensorProduct.tmul R (1 : K) (g * s)
                = d_e • (TensorProduct.tmul R (1 : K) u_e * TensorProduct.tmul R (1 : K) s) := by
                  dsimp [g]
                  rw [mul_assoc, ← Algebra.smul_def, TensorProduct.tmul_smul]
                  exact congrArg (fun x : K => d_e • TensorProduct.tmul R x (u_e * s))
                    (one_mul (1 : K)).symm
              _ = d_e • ((d_e • e_K) * TensorProduct.tmul R (1 : K) s) := by rw [hu_e_eq]
              _ = (d_e * d_e) • (e_K * TensorProduct.tmul R (1 : K) s) := by
                  rw [smul_mul_assoc, mul_smul]
          rw [h2, heK_s, smul_zero]
        have hgs : g * s = 0 :=
          hInc_inj (hgs_tmul.trans (map_zero Algebra.TensorProduct.includeRight).symm)
        have hsg_zero : algebraMap S S_g s = 0 := by
          have hunit_g := IsLocalization.Away.algebraMap_isUnit (S := S_g) g
          apply hunit_g.mul_left_cancel
          rw [← map_mul, hgs, map_zero, mul_zero]
        apply hgn_unit.mul_right_cancel
        rw [hs, hsg_zero, zero_mul]
      have : IsDomain S_g := hπ_loc_inj.isDomain π_loc
      let W₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of S_g)
      have : AlgebraicGeometry.IsIntegral W₁ := inferInstance
      let j_loc : W₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of S) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S S_g))
      have : AlgebraicGeometry.IsOpenImmersion j_loc :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization g
      let j_g : W₁ ⟶ W₀ := j_loc ≫ e_W.inv
      have : AlgebraicGeometry.IsOpenImmersion j_g := inferInstance
      let ψ₁ : S_g →+* Ω₁ := lam.comp π_loc
      have hψ₁_inj : Function.Injective ψ₁ := lam.injective.comp hπ_loc_inj
      let η₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω₁) ⟶ W₁ :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)
      have hη₁_fac : η₁ ≫ j_g = η₀ := by
        have hring : ψ₁.comp (algebraMap S S_g) = ψ₀ := by
          dsimp [ψ₁, π_loc]
          rw [RingHom.comp_assoc, IsLocalization.Away.lift_comp, hψ₀_fac]
        dsimp [η₁, j_g, j_loc]
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hring, hψ₀_map]
        dsimp [η₀']
        rw [CategoryTheory.Category.assoc, e_W.hom_inv_id, CategoryTheory.Category.comp_id]
      have hDense₁ : DenseRange η₁.base := by
        rw [denseRange_iff_closure_range]
        let bot_Sg : ↥W₁ := (⊥ : PrimeSpectrum S_g)
        have hpt_bot : η₁.base pt₀ = bot_Sg := by
          apply PrimeSpectrum.ext
          change RingHom.ker ψ₁ = (⊥ : Ideal S_g)
          ext x
          simp only [RingHom.mem_ker, Ideal.mem_bot]
          exact ⟨fun hx => hψ₁_inj (hx.trans (map_zero ψ₁).symm), fun hx => hx ▸ map_zero ψ₁⟩
        have hRange₁ : Set.range ⇑η₁.base = {bot_Sg} := by
          ext p
          simp only [Set.mem_range, Set.mem_singleton_iff]
          exact ⟨fun ⟨z, hz⟩ => hz ▸ (congrArg η₁.base (Subsingleton.elim z pt₀)).trans hpt_bot,
            fun hp => ⟨pt₀, hpt_bot.trans hp.symm⟩⟩
        rw [hRange₁]
        change closure ({(⊥ : PrimeSpectrum S_g)} : Set (PrimeSpectrum S_g)) =
          (Set.univ : Set (PrimeSpectrum S_g))
        rw [PrimeSpectrum.closure_singleton]
        ext p
        simp
      have hne_Z : Nonempty ↥Z₁.left := inferInstance
      have hne_top : Nonempty ↥(⊤ : Z₁.left.Opens) := ⟨⟨hne_Z.some, trivial⟩⟩
      have hne_W₁ : Nonempty ↥W₁ := ⟨η₁.base pt₀⟩
      let e_top : ((⊤ : Z₁.left.Opens) : AlgebraicGeometry.Scheme.{u}) ≅ Z₁.left := Z₁.left.topIso
      have he_top_hom : e_top.hom = (⊤ : Z₁.left.Opens).ι := Z₁.left.topIso_hom
      let w_top : W₁ ⟶ ((⊤ : Z₁.left.Opens) : AlgebraicGeometry.Scheme.{u}) :=
        (j_g ≫ w₀) ≫ e_top.inv
      have hw_top_et : AlgebraicGeometry.Etale w_top := by
        dsimp [w_top]
        infer_instance
      obtain ⟨U₁, hU₁_ne, V, jW, p₁, hjW_open, hp₁_fin, hp₁_et, hp₁_surj, hcomm₁⟩ :=
        hAffEtShrink ⊤ hne_top W₁ hne_W₁ w_top hw_top_et
      have : AlgebraicGeometry.IsOpenImmersion jW := hjW_open
      have hcomm_W₁ : jW ≫ j_g ≫ w₀ = p₁ ≫ U₁.ι := by
        have htop : w_top ≫ (⊤ : Z₁.left.Opens).ι = j_g ≫ w₀ := by
          dsimp [w_top]
          rw [← he_top_hom, CategoryTheory.Category.assoc, e_top.inv_hom_id,
            CategoryTheory.Category.comp_id]
        calc
          jW ≫ j_g ≫ w₀ = jW ≫ w_top ≫ (⊤ : Z₁.left.Opens).ι := by rw [htop]
          _ = p₁ ≫ U₁.ι := hcomm₁
      have hne_V : Nonempty ↥V := by
        obtain ⟨u⟩ := hU₁_ne
        obtain ⟨v, _⟩ := hp₁_surj.surj u
        exact ⟨v⟩
      have : Nonempty ↥V := hne_V
      have hIntV : AlgebraicGeometry.IsIntegral V :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion jW
      have hOpen_jW : IsOpen (Set.range ⇑jW.base) := jW.isOpenEmbedding.isOpen_range
      have hNonempty_jW : (Set.range ⇑jW.base).Nonempty := Set.range_nonempty _
      obtain ⟨_, hy_open, ⟨pt, hpt_eq⟩⟩ :=
        hDense₁.inter_open_nonempty (Set.range ⇑jW.base) hOpen_jW hNonempty_jW
      have hRange_sub : Set.range ⇑η₁.base ⊆ Set.range ⇑jW.base := by
        rintro _ ⟨z, rfl⟩
        rw [Subsingleton.elim z pt, hpt_eq]
        exact hy_open
      let η_V : AlgebraicGeometry.Spec (CommRingCat.of Ω₁) ⟶ V :=
        AlgebraicGeometry.IsOpenImmersion.lift jW η₁ hRange_sub
      have hη_V_fac : η_V ≫ jW = η₁ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac jW η₁ hRange_sub
      have hDense_V : DenseRange η_V.base := by
        intro v
        rw [mem_closure_iff]
        intro O hO_open hv_O
        have hImg_open : IsOpen (jW.base '' O) := jW.isOpenEmbedding.isOpenMap O hO_open
        have hImg_ne : (jW.base '' O).Nonempty := ⟨jW.base v, v, hv_O, rfl⟩
        obtain ⟨_, ⟨v', hv'_O, rfl⟩, ⟨z, hz_eq⟩⟩ :=
          hDense₁.inter_open_nonempty (jW.base '' O) hImg_open hImg_ne
        have hz_eq' : jW.base (η_V.base z) = jW.base v' := by
          rw [← hη_V_fac] at hz_eq
          exact hz_eq
        have hv_eq : η_V.base z = v' := jW.isOpenEmbedding.injective hz_eq'
        exact ⟨v', hv'_O, ⟨z, hv_eq⟩⟩
      refine ⟨U₁, hU₁_ne, V, p₁, jW ≫ j_g, η_V, hIntV, hp₁_fin, hp₁_et, hp₁_surj,
        inferInstance, hcomm_W₁, ?_, hDense_V⟩
      rw [← CategoryTheory.Category.assoc, hη_V_fac, hη₁_fac]
    let G := weilEtaleHigherDirectImage f.left q (weilEtaleTorsionSheaf C.left ℓ)
    have hTorsG : ℓ • CategoryTheory.CategoryStruct.id G = 0 :=
      hTorsR f.left q (weilEtaleTorsionSheaf C.left ℓ) (hTorsSh C.left)
    have hStalkEquiv : ∀ (K₀ : Type u) [Field K₀] [IsAlgClosed K₀]
        (s : AlgebraicGeometry.Spec (CommRingCat.of K₀) ⟶ Z₁.left)
        (H_s : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K₀)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback s G H_s →
        Nonempty (H_s.H 0 ≃+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left s) ℓ q) := by
      intro K₀ _ _ s H_s hs
      let G_s := weilEtaleHigherDirectImage (CategoryTheory.Limits.pullback.snd f.left s) q
        (weilEtaleTorsionSheaf (CategoryTheory.Limits.pullback f.left s) ℓ)
      have hPB_s : WeilIsEtaleSheafPullback s G G_s :=
        hPBC_at Z₁ C f hf_prop s q
      have hs_id : WeilIsEtaleSheafPullback
          (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of K₀)) ≫ s)
          G H_s := by
        rwa [CategoryTheory.Category.id_comp]
      have hPB_id : WeilIsEtaleSheafPullback
          (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of K₀)))
          G_s H_s :=
        (hCompPB _ s G G_s H_s hPB_s).mpr hs_id
      have : HenselianLocalRing K₀ := Field.henselian K₀
      have : IsSepClosed (IsLocalRing.ResidueField K₀) := hSepRes K₀
      obtain ⟨hEval_K₀, hPull_K₀⟩ :=
        weil_strictly_henselian_spec_etale_eval_and_pullback K₀
      obtain ⟨e_id⟩ := hPull_K₀ K₀
        (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of K₀)))
        (fun pt => Subsingleton.elim _ (IsLocalRing.closedPoint K₀))
        G_s H_s hPB_id
      obtain ⟨e_ev⟩ := hEval_K₀ (CategoryTheory.Limits.pullback f.left s)
        (CategoryTheory.Limits.pullback.snd f.left s) q
        (weilEtaleTorsionSheaf (CategoryTheory.Limits.pullback f.left s) ℓ)
      exact ⟨e_id.trans e_ev⟩
    apply weil_genFLC_of_geom_stalk_nat_card_le_generic ℓ Z₁.left hIntZ₁
      (@hConstPB) (@hExPB) (@hCompPB) hShrink Ω₀ η hDense G hTorsG
    intro k₀ _ _ s H_s H_η hs hη
    obtain ⟨e_s⟩ := hStalkEquiv k₀ s H_s hs
    obtain ⟨e_η⟩ := hStalkEquiv Ω₀ η H_η hη
    obtain ⟨hFin_s, hLe_s⟩ := hBound k₀ s
    refine ⟨Finite.of_equiv _ e_s.symm.toEquiv, ?_⟩
    rwa [Nat.card_congr e_s.toEquiv, Nat.card_congr e_η.toEquiv]

theorem weil_etale_finite_over_algClosed_cohomology_card (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (X₀ : AlgebraicGeometry.Scheme.{u})
    (π₀ : X₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    [AlgebraicGeometry.IsFinite π₀]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (Finite (weilEtaleTorsionH X₀ ℓ 0) ∧
      Nat.card (weilEtaleTorsionH X₀ ℓ 0) = ℓ ^ Nat.card ↥X₀) ∧
    (∀ n : ℕ, Subsingleton (weilEtaleTorsionH X₀ ℓ (n + 1))) :=
by
  classical
  haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have h_etale_term : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom) trivial) ?_
    intro U m
    apply (AlgebraicGeometry.Scheme.Etale.forget S).map_injective
    apply CategoryTheory.Over.OverMorphism.ext
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)

  have h_mem_etale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  have h_top_stalk : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
      (T : C) (hTop : ∀ R ∈ J T, R = ⊤)
      (P : CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u}),
      Nonempty (CategoryTheory.Iso (P.obj (Opposite.op T))
        (((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P).obj.obj (Opposite.op T))) := by
    intro C _ J _ T hTop P
    let R_pre : AddCommGrpCat.{u} → CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u} :=
      fun M =>
        { obj := fun W => ∏ᶜ (fun _ : (T ⟶ Opposite.unop W) => M)
          map := fun {W₁ W₂} f =>
            CategoryTheory.Limits.Pi.lift (fun τ : (T ⟶ Opposite.unop W₂) =>
              CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ Opposite.unop W₁) => M) (τ ≫ f.unop))
          map_id := fun W => by
            apply CategoryTheory.Limits.Pi.hom_ext
            intro τ
            simp
          map_comp := fun {W₁ W₂ W₃} f g => by
            apply CategoryTheory.Limits.Pi.hom_ext
            intro τ
            simp }
    have hR_sheaf : ∀ M : AddCommGrpCat.{u}, CategoryTheory.Presheaf.IsSheaf J (R_pre M) := by
      intro M
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro U S hS
      have hτ_mem : ∀ τ : (T ⟶ U), S.arrows τ := by
        intro τ
        have hpb : S.pullback τ = ⊤ := hTop (S.pullback τ) (J.pullback_stable τ hS)
        have hid : (S.pullback τ).arrows (𝟙 T) := by rw [hpb]; trivial
        simpa [CategoryTheory.Sieve.pullback_apply] using hid
      let mkObj : ∀ τ : (T ⟶ U), S.arrows.category :=
        fun τ => ⟨CategoryTheory.Over.mk τ, hτ_mem τ⟩
      refine ⟨{
        lift := fun s => CategoryTheory.Limits.Pi.lift (fun τ : (T ⟶ S.arrows.cocone.pt) =>
          s.π.app (Opposite.op (mkObj τ)) ≫
            CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ T) => M) (𝟙 T))
        fac := fun s j => by
          apply CategoryTheory.Limits.Pi.hom_ext
          intro ρ
          let mor : mkObj (ρ ≫ j.unop.obj.hom) ⟶ j.unop :=
            CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk ρ rfl)
          have hw := s.w mor.op
          have hcomp := congrArg
            (fun k => k ≫ CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ T) => M) (𝟙 T)) hw
          dsimp [R_pre, mkObj, mor] at hcomp ⊢
          simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.limit.lift_π,
            CategoryTheory.Limits.Fan.mk_pt, CategoryTheory.Limits.Fan.mk_π_app,
            CategoryTheory.Category.id_comp] at hcomp ⊢
          exact hcomp.symm
        uniq := fun s m hm => by
          apply CategoryTheory.Limits.Pi.hom_ext
          intro τ
          have hmτ := congrArg
            (fun k => k ≫ CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ T) => M) (𝟙 T))
            (hm (Opposite.op (mkObj τ)))
          change m ≫ ((CategoryTheory.Limits.Pi.lift fun τ₁ : T ⟶ T =>
              CategoryTheory.Limits.Pi.π (fun _ : T ⟶ S.arrows.cocone.pt => M) (τ₁ ≫ τ)) ≫
              CategoryTheory.Limits.Pi.π (fun _ : T ⟶ T => M) (𝟙 T)) =
            s.π.app (Opposite.op (mkObj τ)) ≫
              CategoryTheory.Limits.Pi.π (fun _ : T ⟶ T => M) (𝟙 T) at hmτ
          simp only [CategoryTheory.Limits.limit.lift_π, CategoryTheory.Limits.Fan.mk_pt,
            CategoryTheory.Limits.Fan.mk_π_app, CategoryTheory.Category.id_comp] at hmτ ⊢
          exact hmτ
      }⟩
    let evLift : ∀ (Q : CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u})
        (M : AddCommGrpCat.{u}) (φ : Q.obj (Opposite.op T) ⟶ M), Q ⟶ R_pre M :=
      fun Q M φ =>
        { app := fun W => CategoryTheory.Limits.Pi.lift
            (fun τ : (T ⟶ Opposite.unop W) => Q.map τ.op ≫ φ)
          naturality := fun {W₁ W₂} f => by
            apply CategoryTheory.Limits.Pi.hom_ext
            intro τ
            dsimp [R_pre]
            simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.limit.lift_π,
              CategoryTheory.Limits.Fan.mk_pt, CategoryTheory.Limits.Fan.mk_π_app]
            change Q.map f ≫ Q.map τ.op ≫ φ = Q.map (f ≫ τ.op) ≫ φ
            rw [Q.map_comp, CategoryTheory.Category.assoc] }
    have hev_comp : ∀ {Q₁ Q₂ : CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u}}
        {M : AddCommGrpCat.{u}} (α : Q₁ ⟶ Q₂) (φ : Q₂.obj (Opposite.op T) ⟶ M),
        α ≫ evLift Q₂ M φ = evLift Q₁ M (α.app (Opposite.op T) ≫ φ) := by
      intro Q₁ Q₂ M α φ
      ext W : 2
      apply CategoryTheory.Limits.Pi.hom_ext
      intro τ
      dsimp [evLift]
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.limit.lift_π,
        CategoryTheory.Limits.Fan.mk_pt, CategoryTheory.Limits.Fan.mk_π_app]
      rw [← CategoryTheory.Category.assoc (α.app W), ← α.naturality τ.op,
        CategoryTheory.Category.assoc]
    have hev_eval : ∀ (Q : CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u})
        (M : AddCommGrpCat.{u}) (φ : Q.obj (Opposite.op T) ⟶ M),
        (evLift Q M φ).app (Opposite.op T) ≫
          CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ T) => M) (𝟙 T) = φ := by
      intro Q M φ
      dsimp [evLift]
      simp
    let adj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let P_sh := (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P
    let η_nat : P ⟶ P_sh.obj := adj.unit.app P
    let η : P.obj (Opposite.op T) ⟶ P_sh.obj.obj (Opposite.op T) := η_nat.app (Opposite.op T)
    let M₁ := P.obj (Opposite.op T)
    let R_sh₁ : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨R_pre M₁, hR_sheaf M₁⟩
    let r_sh : P_sh ⟶ R_sh₁ := (adj.homEquiv P R_sh₁).symm (evLift P M₁ (𝟙 M₁))
    have hr_unit : η_nat ≫ r_sh.hom = evLift P M₁ (𝟙 M₁) := by
      have h1 := (adj.homEquiv P R_sh₁).apply_symm_apply (evLift P M₁ (𝟙 M₁))
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact h1
    let r : P_sh.obj.obj (Opposite.op T) ⟶ P.obj (Opposite.op T) :=
      r_sh.hom.app (Opposite.op T) ≫ CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ T) => M₁) (𝟙 T)
    have h_ηr : η ≫ r = 𝟙 M₁ := by
      dsimp [η, r]
      rw [← CategoryTheory.Category.assoc]
      change (η_nat ≫ r_sh.hom).app (Opposite.op T) ≫ _ = 𝟙 M₁
      rw [hr_unit]
      exact hev_eval P M₁ (𝟙 M₁)
    let M₂ := P_sh.obj.obj (Opposite.op T)
    let R_sh₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨R_pre M₂, hR_sheaf M₂⟩
    let g₁ : P_sh ⟶ R_sh₂ := CategoryTheory.ObjectProperty.homMk (evLift P_sh.obj M₂ (r ≫ η))
    let g₂ : P_sh ⟶ R_sh₂ := CategoryTheory.ObjectProperty.homMk (evLift P_sh.obj M₂ (𝟙 M₂))
    have hg_eq : g₁ = g₂ := by
      apply (adj.homEquiv P R_sh₂).injective
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
      change η_nat ≫ evLift P_sh.obj M₂ (r ≫ η) = η_nat ≫ evLift P_sh.obj M₂ (𝟙 M₂)
      rw [hev_comp, hev_comp, ← CategoryTheory.Category.assoc η r η, h_ηr,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    have h_rη : r ≫ η = 𝟙 M₂ := by
      have hg_hom : g₁.hom = g₂.hom := congrArg (fun k => k.hom) hg_eq
      have hg_ev := congrArg
        (fun k : P_sh.obj ⟶ R_pre M₂ =>
          k.app (Opposite.op T) ≫ CategoryTheory.Limits.Pi.π (fun _ : (T ⟶ T) => M₂) (𝟙 T))
        hg_hom
      dsimp [g₁, g₂] at hg_ev
      rw [hev_eval, hev_eval] at hg_ev
      exact hg_ev
    exact ⟨{ hom := η, inv := r, hom_inv_id := h_ηr, inv_hom_id := h_rη }⟩

  
  haveI : AlgebraicGeometry.IsAffine X₀ := AlgebraicGeometry.isAffine_of_isAffineHom π₀
  let B₀ : Type u := ↑(X₀.presheaf.obj (Opposite.op ⊤))
  let e_X₀ : X₀ ≅ AlgebraicGeometry.Spec (CommRingCat.of B₀) := X₀.isoSpec
  have he_left : ∀ y : ↥X₀, e_X₀.inv.base (e_X₀.hom.base y) = y := by
    intro y
    change (e_X₀.hom ≫ e_X₀.inv).base y = (CategoryTheory.CategoryStruct.id X₀).base y
    rw [e_X₀.hom_inv_id]
  have he_right : ∀ P : PrimeSpectrum B₀, e_X₀.hom.base (e_X₀.inv.base P) = P := by
    intro P
    change (e_X₀.inv ≫ e_X₀.hom).base P =
      (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of B₀))).base P
    rw [e_X₀.inv_hom_id]
  let e_bij : ↥X₀ ≃ PrimeSpectrum B₀ :=
    { toFun := e_X₀.hom.base
      invFun := e_X₀.inv.base
      left_inv := he_left
      right_inv := he_right }
  let π_spec : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of k₀) :=
    e_X₀.inv ≫ π₀
  have : AlgebraicGeometry.IsFinite π_spec := inferInstance
  let α₀_mor : CommRingCat.of k₀ ⟶ CommRingCat.of B₀ :=
    AlgebraicGeometry.Spec.preimage π_spec
  let α₀ : k₀ →+* B₀ := α₀_mor.hom
  have hα₀_fin : α₀.Finite := by
    apply (AlgebraicGeometry.IsFinite.SpecMap_iff α₀_mor).mp
    rw [AlgebraicGeometry.Spec.map_preimage]
    infer_instance
  letI : Algebra k₀ B₀ := α₀.toAlgebra
  haveI : Module.Finite k₀ B₀ := hα₀_fin
  haveI : IsArtinianRing B₀ := IsArtinianRing.of_finite k₀ B₀
  haveI : Finite ↥X₀ := Finite.of_equiv (PrimeSpectrum B₀) e_bij.symm
  letI : Fintype (PrimeSpectrum B₀) := Fintype.ofFinite (PrimeSpectrum B₀)

  have h_sep : ∀ (P Q : PrimeSpectrum B₀), Q ≠ P →
      ∃ b : B₀, b ∈ Q.asIdeal ∧ b ∉ P.asIdeal := by
    intro P Q hQP
    by_contra hno
    have hle : Q.asIdeal ≤ P.asIdeal :=
      fun b hbQ => Classical.byContradiction fun hbP => hno ⟨b, hbQ, hbP⟩
    have hMaxQ : Q.asIdeal.IsMaximal :=
      (IsArtinianRing.primeSpectrumEquivMaximalSpectrum Q).isMaximal
    have heq : Q.asIdeal = P.asIdeal := hMaxQ.eq_of_le P.isPrime.ne_top hle
    exact hQP (PrimeSpectrum.ext heq)

  let sepFun : PrimeSpectrum B₀ → PrimeSpectrum B₀ → B₀ :=
    fun P Q => if h : Q = P then 1 else (h_sep P Q h).choose
  let f_elem : ↥X₀ → B₀ :=
    fun x => ∏ Q : PrimeSpectrum B₀, sepFun (e_X₀.hom.base x) Q
  have hf_basic : ∀ (x : ↥X₀) (Q : PrimeSpectrum B₀),
      Q ∈ PrimeSpectrum.basicOpen (f_elem x) ↔ Q = e_X₀.hom.base x := by
    intro x Q
    rw [PrimeSpectrum.mem_basicOpen]
    constructor
    · intro hnotMem
      by_contra hQP
      apply hnotMem
      obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem
        (fun Q' => sepFun (e_X₀.hom.base x) Q') (Finset.mem_univ Q)
      dsimp only [f_elem]
      rw [hc]
      have hb_mem : sepFun (e_X₀.hom.base x) Q ∈ Q.asIdeal := by
        dsimp only [sepFun]
        split_ifs with hEq
        · exact False.elim (hQP hEq)
        · exact (h_sep (e_X₀.hom.base x) Q hQP).choose_spec.1
      exact Q.asIdeal.mul_mem_right c hb_mem
    · rintro rfl
      intro hmem
      have : (e_X₀.hom.base x).asIdeal.IsPrime := (e_X₀.hom.base x).isPrime
      obtain ⟨Q', _, hQ'⟩ := Ideal.IsPrime.prod_mem_iff.mp hmem
      dsimp only [sepFun] at hQ'
      split_ifs at hQ' with hEq
      · exact (e_X₀.hom.base x).isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem _ hQ' isUnit_one)
      · exact (h_sep (e_X₀.hom.base x) Q' hEq).choose_spec.2 hQ'

  let V : ↥X₀ → X₀.Opens := fun x => X₀.basicOpen (f_elem x)
  have hV_eq : ∀ x : ↥X₀, (V x : Set ↥X₀) = {x} := by
    intro x
    ext y
    rw [Set.mem_singleton_iff]
    have hmap := AlgebraicGeometry.Scheme.map_PrimeSpectrum_basicOpen_of_affine X₀ (f_elem x)
    have hy_iff : y ∈ V x ↔
        (e_X₀.hom.base y : PrimeSpectrum B₀) ∈ PrimeSpectrum.basicOpen (f_elem x) := by
      dsimp only [V]
      rw [← hmap]
      rfl
    exact hy_iff.trans
      ((hf_basic x (e_X₀.hom.base y : PrimeSpectrum B₀)).trans e_bij.injective.eq_iff)

  have hV_aug : ∀ x : ↥X₀,
      ∃ q_x : ↑(((V x) : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) →+* k₀,
        Function.Surjective q_x ∧ IsNilpotent (RingHom.ker q_x) := by
    intro x
    let P_x : PrimeSpectrum B₀ := e_X₀.hom.base x
    let A_x : Type u := ↑(((X₀.basicOpen (f_elem x)) : AlgebraicGeometry.Scheme.{u}).presheaf.obj
      (Opposite.op ⊤))
    have hArt_Ax : IsArtinianRing A_x :=
      IsArtinianRing.localization_artinian (Submonoid.powers (f_elem x)) A_x
    have hMaxPx : P_x.asIdeal.IsMaximal :=
      (IsArtinianRing.primeSpectrumEquivMaximalSpectrum P_x).isMaximal
    letI : Field (B₀ ⧸ P_x.asIdeal) := Ideal.Quotient.field P_x.asIdeal
    haveI : Module.Finite k₀ (B₀ ⧸ P_x.asIdeal) := Module.Finite.quotient k₀ P_x.asIdeal
    haveI : Algebra.IsIntegral k₀ (B₀ ⧸ P_x.asIdeal) :=
      Algebra.IsIntegral.of_finite k₀ (B₀ ⧸ P_x.asIdeal)
    have hbij_Lx : Function.Bijective (algebraMap k₀ (B₀ ⧸ P_x.asIdeal)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e_Lx : (B₀ ⧸ P_x.asIdeal) ≃+* k₀ :=
      (RingEquiv.ofBijective (algebraMap k₀ (B₀ ⧸ P_x.asIdeal)) hbij_Lx).symm
    let π_x : B₀ →+* k₀ := e_Lx.toRingHom.comp (Ideal.Quotient.mk P_x.asIdeal)
    have hfx_notMem : f_elem x ∉ P_x.asIdeal :=
      (PrimeSpectrum.mem_basicOpen (f_elem x) P_x).mp ((hf_basic x P_x).mpr rfl)
    have hπ_fx_ne : π_x (f_elem x) ≠ 0 := by
      intro h0
      apply hfx_notMem
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      exact e_Lx.injective (h0.trans (map_zero e_Lx).symm)
    have hUnit_fx : IsUnit (π_x (f_elem x)) := IsUnit.mk0 _ hπ_fx_ne
    let q_x : A_x →+* k₀ := IsLocalization.Away.lift (S := A_x) (f_elem x) hUnit_fx
    have hq_surj : Function.Surjective q_x := by
      intro c
      refine ⟨algebraMap B₀ A_x (α₀ c), ?_⟩
      dsimp only [q_x]
      rw [IsLocalization.Away.lift_eq]
      change e_Lx (algebraMap k₀ (B₀ ⧸ P_x.asIdeal) c) = c
      exact (RingEquiv.ofBijective (algebraMap k₀ (B₀ ⧸ P_x.asIdeal)) hbij_Lx).symm_apply_apply c
    let Q₀ : PrimeSpectrum A_x := ⟨RingHom.ker q_x, RingHom.ker_isPrime q_x⟩
    have hQ_eq : ∀ Q : PrimeSpectrum A_x, Q = Q₀ := by
      have hcomap_Px : ∀ Q : PrimeSpectrum A_x,
          PrimeSpectrum.comap (algebraMap B₀ A_x) Q = P_x := by
        intro Q
        have hmem : PrimeSpectrum.comap (algebraMap B₀ A_x) Q ∈
            Set.range (PrimeSpectrum.comap (algebraMap B₀ A_x)) := ⟨Q, rfl⟩
        rw [PrimeSpectrum.localization_away_comap_range A_x (f_elem x)] at hmem
        exact (hf_basic x _).mp hmem
      intro Q
      exact (PrimeSpectrum.localization_away_isOpenEmbedding A_x (f_elem x)).injective
        ((hcomap_Px Q).trans (hcomap_Px Q₀).symm)
    have hker_eq_nil : RingHom.ker q_x = nilradical A_x := by
      apply le_antisymm
      · rw [PrimeSpectrum.nilradical_eq_iInf]
        exact le_iInf fun Q => by rw [hQ_eq Q]
      · rw [PrimeSpectrum.nilradical_eq_iInf]
        exact iInf_le PrimeSpectrum.asIdeal Q₀
    refine ⟨q_x, hq_surj, ?_⟩
    rw [hker_eq_nil]
    exact @IsArtinianRing.isNilpotent_nilradical A_x _ hArt_Ax

  
  let S₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k₀)
  have hSec_S₀ : ∀ (W_sch : AlgebraicGeometry.Scheme.{u}) (u : W_sch ⟶ S₀)
      [AlgebraicGeometry.Etale u] [AlgebraicGeometry.Surjective u],
      ∃ σ : S₀ ⟶ W_sch, σ ≫ u = CategoryTheory.CategoryStruct.id S₀ := by
    intro W_sch u _ _
    let P_pt := AlgebraicGeometry.Scheme.geometricFiber k₀
    let R_u := CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton u)
    have hR_mem : R_u ∈ AlgebraicGeometry.Scheme.etaleTopology S₀ :=
      CategoryTheory.Precoverage.generate_mem_toGrothendieck
        ((AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff (@AlgebraicGeometry.Etale) u).mpr
          ⟨u.surjective, inferInstance⟩)
    obtain ⟨Y, f, hf, y, hy⟩ :=
      P_pt.jointly_surjective R_u hR_mem (CategoryTheory.CategoryStruct.id S₀)
    obtain ⟨Z, g, h, hh, rfl⟩ := hf
    cases hh
    let y' : S₀ ⟶ Y := y
    refine ⟨y' ≫ g, ?_⟩
    rw [CategoryTheory.Category.assoc]
    exact hy

  let J := X₀.smallEtaleTopology
  let T₀ : X₀.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id X₀)
  let E : ↥X₀ → X₀.Etale := fun x => AlgebraicGeometry.Scheme.Etale.mk (V x).ι
  let j : ∀ x : ↥X₀, E x ⟶ T₀ := fun x =>
    CategoryTheory.MorphismProperty.Over.homMk (V x).ι (CategoryTheory.Category.comp_id (V x).ι)
      trivial

  have hTop : ∀ (x : ↥X₀), ∀ R ∈ J (E x), R = ⊤ := by
    intro x R hR
    obtain ⟨q_x, hq_surj, hq_nil⟩ := hV_aug x
    let S : AlgebraicGeometry.Scheme.{u} := ((V x) : AlgebraicGeometry.Scheme.{u})
    haveI : AlgebraicGeometry.IsAffine S := by
      dsimp [S, V]
      infer_instance
    have hx_mem : x ∈ V x := (Set.ext_iff.mp (hV_eq x) x).mpr rfl
    let s_pt : ↥S := ⟨x, hx_mem⟩
    have hs_uniq : ∀ z : ↥S, z = s_pt :=
      fun z => Subtype.ext ((Set.ext_iff.mp (hV_eq x) z.1).mp z.2)
    obtain ⟨W, u, w₀, huR, huEt, hw₀⟩ := (h_mem_etale X₀ (E x) R).mp hR s_pt
    let u₀ : W.left ⟶ S := u.left
    letI : AlgebraicGeometry.Etale u₀ := huEt
    haveI : AlgebraicGeometry.Surjective u₀ := ⟨fun z => ⟨w₀, hw₀.trans (hs_uniq z).symm⟩⟩
    let A : Type u := ↑(S.presheaf.obj (Opposite.op ⊤))
    let e_S : S ≅ AlgebraicGeometry.Spec (CommRingCat.of A) := S.isoSpec
    let i_q : S₀ ⟶ S := AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_x) ≫ e_S.inv
    let W₀ := CategoryTheory.Limits.pullback u₀ i_q
    let p₁ : W₀ ⟶ W.left := CategoryTheory.Limits.pullback.fst u₀ i_q
    let p₂ : W₀ ⟶ S₀ := CategoryTheory.Limits.pullback.snd u₀ i_q
    haveI : AlgebraicGeometry.Etale p₂ := inferInstance
    haveI : AlgebraicGeometry.Surjective p₂ := inferInstance
    obtain ⟨σ₀, hσ₀⟩ := hSec_S₀ W₀ p₂
    let τ₀ : S₀ ⟶ W.left := σ₀ ≫ p₁
    have hτ₀_u₀ : τ₀ ≫ u₀ = i_q := by
      dsimp [τ₀, p₁, p₂]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, hσ₀, CategoryTheory.Category.id_comp]
    let pt₀ : ↥S₀ := (⊥ : PrimeSpectrum k₀)
    obtain ⟨W_aff, hW_aff, hpt_mem, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (TopologicalSpace.Opens.mem_top (τ₀.base pt₀))
    have hτ₀_sub : Set.range ⇑τ₀.base ⊆ Set.range ⇑W_aff.ι.base := by
      rw [W_aff.range_ι]
      rintro _ ⟨z, rfl⟩
      rw [Subsingleton.elim z pt₀]
      exact hpt_mem
    let T_aff : AlgebraicGeometry.Scheme.{u} := (W_aff : AlgebraicGeometry.Scheme.{u})
    haveI : AlgebraicGeometry.IsAffine T_aff := hW_aff
    let τ_aff : S₀ ⟶ T_aff := AlgebraicGeometry.IsOpenImmersion.lift W_aff.ι τ₀ hτ₀_sub
    have hτ_aff_fac : τ_aff ≫ W_aff.ι = τ₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W_aff.ι τ₀ hτ₀_sub
    let C : Type u := ↑(T_aff.presheaf.obj (Opposite.op ⊤))
    let e_T : T_aff ≅ AlgebraicGeometry.Spec (CommRingCat.of C) := T_aff.isoSpec
    let v_spec : AlgebraicGeometry.Spec (CommRingCat.of C) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A) :=
      e_T.inv ≫ W_aff.ι ≫ u₀ ≫ e_S.hom
    haveI : AlgebraicGeometry.Etale v_spec := inferInstance
    let ψ'_mor : CommRingCat.of A ⟶ CommRingCat.of C := AlgebraicGeometry.Spec.preimage v_spec
    let ψ' : A →+* C := ψ'_mor.hom
    have hψ'_map : AlgebraicGeometry.Spec.map ψ'_mor = v_spec :=
      AlgebraicGeometry.Spec.map_preimage v_spec
    have hψ'_et : RingHom.Etale ψ' := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      rw [hψ'_map]
      infer_instance
    let r₀_mor : CommRingCat.of C ⟶ CommRingCat.of k₀ :=
      AlgebraicGeometry.Spec.preimage (τ_aff ≫ e_T.hom)
    let r₀ : C →+* k₀ := r₀_mor.hom
    have hr₀_map : AlgebraicGeometry.Spec.map r₀_mor = τ_aff ≫ e_T.hom :=
      AlgebraicGeometry.Spec.map_preimage (τ_aff ≫ e_T.hom)
    have h_r₀_ψ' : r₀.comp ψ' = q_x := by
      have h_mor : ψ'_mor ≫ r₀_mor = CommRingCat.ofHom q_x := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, hr₀_map, hψ'_map]
        have h1 : (τ_aff ≫ e_T.hom) ≫ v_spec =
            ((τ_aff ≫ (e_T.hom ≫ e_T.inv)) ≫ W_aff.ι) ≫ u₀ ≫ e_S.hom := by
          dsimp only [v_spec]
          simp only [CategoryTheory.Category.assoc]
        have h2 : τ_aff ≫ (e_T.hom ≫ e_T.inv) = τ_aff := by
          rw [e_T.hom_inv_id, CategoryTheory.Category.comp_id]
        have h3 : (τ_aff ≫ W_aff.ι) ≫ u₀ ≫ e_S.hom = (τ₀ ≫ u₀) ≫ e_S.hom :=
          (congrArg (· ≫ (u₀ ≫ e_S.hom)) hτ_aff_fac).trans
            (CategoryTheory.Category.assoc τ₀ u₀ e_S.hom).symm
        have h4 : i_q ≫ e_S.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_x) := by
          dsimp only [i_q]
          rw [CategoryTheory.Category.assoc, e_S.inv_hom_id, CategoryTheory.Category.comp_id]
        exact h1.trans
          ((congrArg (fun k => (k ≫ W_aff.ι) ≫ u₀ ≫ e_S.hom) h2).trans
            (h3.trans ((congrArg (· ≫ e_S.hom) hτ₀_u₀).trans h4)))
      exact congrArg CommRingCat.Hom.hom h_mor
    letI : Algebra A C := ψ'.toAlgebra
    haveI : Algebra.Etale A C := RingHom.Etale.toAlgebra hψ'_et
    letI : Algebra A k₀ := q_x.toAlgebra
    let f_alg : C →ₐ[A] k₀ :=
      { r₀ with
        commutes' := fun a => RingHom.congr_fun h_r₀_ψ' a }
    let g_alg : A →ₐ[A] k₀ := Algebra.ofId A k₀
    have hg_surj : Function.Surjective ⇑g_alg := hq_surj
    have hg_nil : IsNilpotent (RingHom.ker g_alg) := hq_nil
    let ℓ_alg : C →ₐ[A] A :=
      Algebra.FormallySmooth.liftOfSurjective f_alg g_alg hg_surj hg_nil
    have hℓ_comp : ψ'_mor ≫ CommRingCat.ofHom ℓ_alg.toRingHom = 𝟙 (CommRingCat.of A) := by
      ext a
      exact ℓ_alg.commutes a
    let ℓ_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ℓ_alg.toRingHom)
    let σ : S ⟶ W.left := e_S.hom ≫ ℓ_spec ≫ e_T.inv ≫ W_aff.ι
    have hσ_u₀ : σ ≫ u₀ = CategoryTheory.CategoryStruct.id S := by
      have hℓ_v : ℓ_spec ≫ AlgebraicGeometry.Spec.map ψ'_mor =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of A)) := by
        dsimp only [ℓ_spec]
        rw [← AlgebraicGeometry.Spec.map_comp, hℓ_comp, AlgebraicGeometry.Spec.map_id]
      have h_rhs : (σ ≫ u₀) ≫ e_S.hom = e_S.hom := by
        have ha : (σ ≫ u₀) ≫ e_S.hom = e_S.hom ≫ (ℓ_spec ≫ v_spec) := by
          dsimp only [σ, v_spec]
          simp only [CategoryTheory.Category.assoc]
        exact ha.trans
          ((congrArg (fun k => e_S.hom ≫ (ℓ_spec ≫ k)) hψ'_map.symm).trans
            ((congrArg (e_S.hom ≫ ·) hℓ_v).trans (CategoryTheory.Category.comp_id e_S.hom)))
      have h_id : σ ≫ u₀ = ((σ ≫ u₀) ≫ e_S.hom) ≫ e_S.inv :=
        (CategoryTheory.Category.comp_id (σ ≫ u₀)).symm.trans
          ((congrArg ((σ ≫ u₀) ≫ ·) e_S.hom_inv_id.symm).trans
            (CategoryTheory.Category.assoc (σ ≫ u₀) e_S.hom e_S.inv).symm)
      exact h_id.trans ((congrArg (· ≫ e_S.inv) h_rhs).trans e_S.hom_inv_id)
    have hσ_hom : σ ≫ W.hom = (E x).hom := by
      have hw : u₀ ≫ (E x).hom = W.hom := CategoryTheory.MorphismProperty.Over.w u
      exact (congrArg (σ ≫ ·) hw.symm).trans
        ((CategoryTheory.Category.assoc σ u₀ (E x).hom).symm.trans
          ((congrArg (· ≫ (E x).hom) hσ_u₀).trans
            (CategoryTheory.Category.id_comp (E x).hom)))
    let s_et : E x ⟶ W :=
      CategoryTheory.MorphismProperty.Over.homMk σ hσ_hom trivial
    have hs_et_u : s_et ≫ u = CategoryTheory.CategoryStruct.id (E x) := by
      apply (AlgebraicGeometry.Scheme.Etale.forget X₀).map_injective
      apply CategoryTheory.Over.OverMorphism.ext
      exact hσ_u₀
    have hid_mem : R.arrows (CategoryTheory.CategoryStruct.id (E x)) := by
      rw [← hs_et_u]
      exact R.downward_closed huR s_et
    exact CategoryTheory.Sieve.id_mem_iff_eq_top.mp hid_mem

  
  have hEmpty_zero : ∀ (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (Z : X₀.Etale),
      IsEmpty ↥Z.left →
      ∀ {M : AddCommGrpCat.{u}} (g₁ g₂ : M ⟶ F.obj.obj (Opposite.op Z)), g₁ = g₂ := by
    intro F Z hEmpty M g₁ g₂
    have hbot : (⊥ : CategoryTheory.Sieve Z) ∈ J Z := by
      rw [h_mem_etale X₀ Z ⊥]
      intro z
      exact IsEmpty.elim hEmpty z
    obtain ⟨hc⟩ := (CategoryTheory.Presheaf.isSheaf_iff_isLimit J F.obj).mp F.property ⊥ hbot
    exact hc.hom_ext (fun w => False.elim w.unop.property)

  let S_cov : CategoryTheory.Sieve T₀ :=
    { arrows := fun Y f => ∃ (x : ↥X₀) (h : Y ⟶ E x), h ≫ j x = f
      downward_closed := by
        rintro Y Z f ⟨x, h, rfl⟩ g
        exact ⟨x, g ≫ h, CategoryTheory.Category.assoc g h (j x)⟩ }
  have hS_cov_mem : S_cov ∈ J T₀ := by
    rw [h_mem_etale X₀ T₀ S_cov]
    intro x
    have hx_range : x ∈ Set.range ⇑(V x).ι.base := by
      rw [(V x).range_ι, hV_eq x]
      exact Set.mem_singleton x
    obtain ⟨y_x, hy_x⟩ := hx_range
    refine ⟨E x, j x, y_x, ⟨x, CategoryTheory.CategoryStruct.id (E x),
      CategoryTheory.Category.id_comp (j x)⟩, ?_, hy_x⟩
    change AlgebraicGeometry.Etale (V x).ι
    infer_instance

  have hBijSec : ∀ (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      Function.Bijective
        (fun (s : ↑(F.obj.obj (Opposite.op T₀))) (x : ↥X₀) =>
          F.obj.map (j x).op s) := by
    intro F
    obtain ⟨hc₀⟩ :=
      (CategoryTheory.Presheaf.isSheaf_iff_isLimit J F.obj).mp F.property S_cov hS_cov_mem
    let P_F : AddCommGrpCat.{u} :=
      AddCommGrpCat.of (∀ x : ↥X₀, ↑(F.obj.obj (Opposite.op (E x))))
    let π_proj : ∀ x : ↥X₀, P_F ⟶ F.obj.obj (Opposite.op (E x)) :=
      fun x => AddCommGrpCat.ofHom
        (Pi.evalAddMonoidHom (fun x' => ↑(F.obj.obj (Opposite.op (E x')))) x)
    let ρ_hom : F.obj.obj (Opposite.op T₀) ⟶ P_F :=
      AddCommGrpCat.ofHom
        (AddMonoidHom.pi fun x => (F.obj.map (j x).op).hom)
    let α_mor : ∀ (W : X₀.Etale) (f : W ⟶ T₀), S_cov.arrows f →
        (P_F ⟶ F.obj.obj (Opposite.op W)) :=
      fun W f hf => π_proj hf.choose ≫ F.obj.map hf.choose_spec.choose.op
    have hα_eq : ∀ (W : X₀.Etale) (f : W ⟶ T₀) (hf : S_cov.arrows f)
        (x : ↥X₀) (h : W ⟶ E x),
        h ≫ j x = f → α_mor W f hf = π_proj x ≫ F.obj.map h.op := by
      intro W f hf x h hh
      let x₀ := hf.choose
      let h₀ := hf.choose_spec.choose
      have hh₀ : h₀ ≫ j x₀ = f := hf.choose_spec.choose_spec
      change π_proj x₀ ≫ F.obj.map h₀.op = π_proj x ≫ F.obj.map h.op
      by_cases hx : x₀ = x
      · subst hx
        have hleft_comp : h₀.left ≫ (V x₀).ι = h.left ≫ (V x₀).ι :=
          congrArg (fun m : W ⟶ T₀ => m.left) (hh₀.trans hh.symm)
        have hleft : h₀.left = h.left := (cancel_mono (V x₀).ι).mp hleft_comp
        have heq_h : h₀ = h := by
          apply (AlgebraicGeometry.Scheme.Etale.forget X₀).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact hleft
        rw [heq_h]
      · apply hEmpty_zero F W
        refine ⟨fun w => hx ?_⟩
        let z : ↥X₀ := f.left.base w
        have hw₀ : z ∈ (V x₀ : Set ↥X₀) := by
          dsimp only [z]
          rw [← hh₀, ← (V x₀).range_ι]
          exact ⟨h₀.left.base w, rfl⟩
        have hw₁ : z ∈ (V x : Set ↥X₀) := by
          dsimp only [z]
          rw [← hh, ← (V x).range_ι]
          exact ⟨h.left.base w, rfl⟩
        rw [hV_eq x₀, Set.mem_singleton_iff] at hw₀
        rw [hV_eq x, Set.mem_singleton_iff] at hw₁
        exact hw₀.symm.trans hw₁
    let cone_P : CategoryTheory.Limits.Cone (S_cov.arrows.diagram.op.comp F.obj) :=
      { pt := P_F
        π :=
          { app := fun w => α_mor w.unop.obj.left w.unop.obj.hom w.unop.property
            naturality := fun {w₁ w₂} m => by
              dsimp only [CategoryTheory.Functor.const_obj_obj,
                CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.id_comp,
                CategoryTheory.Functor.comp_obj, CategoryTheory.Functor.comp_map,
                CategoryTheory.Functor.op_obj, CategoryTheory.Functor.op_map,
                CategoryTheory.Presieve.diagram]
              let x₁ := w₁.unop.property.choose
              let h₁ := w₁.unop.property.choose_spec.choose
              have hh₁ : h₁ ≫ j x₁ = w₁.unop.obj.hom :=
                w₁.unop.property.choose_spec.choose_spec
              have hm_w : m.unop.hom.left ≫ w₁.unop.obj.hom = w₂.unop.obj.hom :=
                CategoryTheory.Over.w m.unop.hom
              have hh₂ : (m.unop.hom.left ≫ h₁) ≫ j x₁ = w₂.unop.obj.hom := by
                rw [CategoryTheory.Category.assoc, hh₁, hm_w]
              rw [hα_eq w₂.unop.obj.left w₂.unop.obj.hom w₂.unop.property x₁
                (m.unop.hom.left ≫ h₁) hh₂]
              rw [hα_eq w₁.unop.obj.left w₁.unop.obj.hom w₁.unop.property x₁ h₁ hh₁]
              rw [op_comp, F.obj.map_comp, CategoryTheory.Category.assoc]
              rfl } }
    let lam_hom : P_F ⟶ F.obj.obj (Opposite.op T₀) := hc₀.lift cone_P
    have h_right_inv : ∀ t : P_F, ρ_hom (lam_hom t) = t := by
      intro t
      change (ρ_hom (lam_hom t) : ∀ x : ↥X₀, _) = (t : ∀ x : ↥X₀, _)
      funext x
      let mk_x : S_cov.arrows.category :=
        ⟨CategoryTheory.Over.mk (j x),
          ⟨x, CategoryTheory.CategoryStruct.id (E x), CategoryTheory.Category.id_comp (j x)⟩⟩
      have hfac := hc₀.fac cone_P (Opposite.op mk_x)
      have hα_x : cone_P.π.app (Opposite.op mk_x) = π_proj x := by
        dsimp only [cone_P]
        rw [hα_eq (E x) (j x) mk_x.property x (CategoryTheory.CategoryStruct.id (E x))
          (CategoryTheory.Category.id_comp (j x))]
        rw [op_id, F.obj.map_id, CategoryTheory.Category.comp_id]
      have hcomp : lam_hom ≫ F.obj.map (j x).op = π_proj x := hfac.trans hα_x
      exact ConcreteCategory.congr_hom hcomp t
    have h_left_inv : ∀ s : F.obj.obj (Opposite.op T₀), lam_hom (ρ_hom s) = s := by
      have hcomp_id : ρ_hom ≫ lam_hom =
          CategoryTheory.CategoryStruct.id (F.obj.obj (Opposite.op T₀)) := by
        apply hc₀.hom_ext
        intro w
        have hfac : lam_hom ≫ F.obj.map w.unop.obj.hom.op = cone_P.π.app w :=
          hc₀.fac cone_P w
        change ρ_hom ≫ lam_hom ≫ F.obj.map w.unop.obj.hom.op =
          CategoryTheory.CategoryStruct.id _ ≫ F.obj.map w.unop.obj.hom.op
        rw [CategoryTheory.Category.id_comp, hfac]
        let x₁ := w.unop.property.choose
        let h₁ := w.unop.property.choose_spec.choose
        have hh₁ : h₁ ≫ j x₁ = w.unop.obj.hom :=
          w.unop.property.choose_spec.choose_spec
        dsimp only [cone_P]
        rw [hα_eq w.unop.obj.left w.unop.obj.hom w.unop.property x₁ h₁ hh₁]
        have hρ_π : ρ_hom ≫ π_proj x₁ = F.obj.map (j x₁).op := by
          ext s'
          rfl
        rw [← CategoryTheory.Category.assoc, hρ_π, ← F.obj.map_comp, ← op_comp]
        exact congrArg (fun k => F.obj.map k.op) hh₁
      intro s
      exact ConcreteCategory.congr_hom hcomp_id s
    exact ⟨Function.LeftInverse.injective h_left_inv,
      Function.RightInverse.surjective h_right_inv⟩

  
  let isoToEquiv : ∀ {M N : AddCommGrpCat.{u}}, (M ≅ N) → ((M : Type u) ≃ (N : Type u)) :=
    fun e =>
      { toFun := e.hom.hom
        invFun := e.inv.hom
        left_inv := fun m => ConcreteCategory.congr_hom e.hom_inv_id m
        right_inv := fun n => ConcreteCategory.congr_hom e.inv_hom_id n }
  let A_ℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let F_ℤ : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
    (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj A_ℤ
  have hT₀ : CategoryTheory.Limits.IsTerminal T₀ := h_etale_term X₀
  let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₀
  let homFromAZEquiv : ∀ (M : AddCommGrpCat.{u}), (A_ℤ ⟶ M) ≃ (M : Type u) :=
    fun M =>
      { toFun := fun φ => φ (ULift.up.{u} (1 : ℤ))
        invFun := fun m => AddCommGrpCat.ofHom
          { toFun := fun z => z.down • m
            map_zero' := zero_zsmul m
            map_add' := fun a b => add_zsmul m a.down b.down }
        left_inv := fun φ => by
          ext ⟨z⟩
          change z • φ (ULift.up.{u} (1 : ℤ)) = φ (ULift.up.{u} z)
          rw [← map_zsmul φ.hom]
          congr 1
          apply ULift.ext
          change z • (1 : ℤ) = z
          simp
        right_inv := fun m => one_zsmul m }

  let A_ℓ : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let F_ℓ : CategoryTheory.Sheaf J AddCommGrpCat.{u} := weilEtaleTorsionSheaf X₀ ℓ

  refine ⟨?_, ?_⟩
  · 
    let e_ext₀ : weilEtaleTorsionH X₀ ℓ 0 ≃ (F_ℤ ⟶ F_ℓ) :=
      CategoryTheory.Abelian.Ext.homEquiv₀
    let e_adj₀ : (F_ℤ ⟶ F_ℓ) ≃ (A_ℤ ⟶ F_ℓ.obj.obj (Opposite.op T₀)) :=
      adj.homEquiv A_ℤ F_ℓ
    let e₀ : weilEtaleTorsionH X₀ ℓ 0 ≃ ↑(F_ℓ.obj.obj (Opposite.op T₀)) :=
      e_ext₀.trans (e_adj₀.trans (homFromAZEquiv _))
    let e₁ : ↑(F_ℓ.obj.obj (Opposite.op T₀)) ≃
        (∀ x : ↥X₀, ↑(F_ℓ.obj.obj (Opposite.op (E x)))) :=
      Equiv.ofBijective _ (hBijSec F_ℓ)
    let e_loc : ∀ x : ↥X₀, ↑(F_ℓ.obj.obj (Opposite.op (E x))) ≃ ZMod ℓ := fun x =>
      let iso_x := Classical.choice (h_top_stalk J (E x) (hTop x)
        ((CategoryTheory.Functor.const (Opposite X₀.Etale)).obj A_ℓ))
      (isoToEquiv iso_x.symm).trans Equiv.ulift
    let e_tot : weilEtaleTorsionH X₀ ℓ 0 ≃ (↥X₀ → ZMod ℓ) :=
      e₀.trans (e₁.trans (Equiv.piCongrRight e_loc))
    have hℓ_prime : Nat.Prime ℓ := Fact.out
    haveI : NeZero ℓ := ⟨hℓ_prime.ne_zero⟩
    refine ⟨Finite.of_equiv (↥X₀ → ZMod ℓ) e_tot.symm, ?_⟩
    rw [Nat.card_congr e_tot, Nat.card_fun, Nat.card_zmod]
  · 
    haveI : CategoryTheory.Projective F_ℤ := by
      refine CategoryTheory.Projective.mk (fun {E_sh G_sh} f e _ => ?_)
      let g_hom : A_ℤ ⟶ G_sh.obj.obj (Opposite.op T₀) := (adj.homEquiv A_ℤ G_sh) f
      let g₀ : ↑(G_sh.obj.obj (Opposite.op T₀)) := g_hom (ULift.up.{u} (1 : ℤ))
      haveI : CategoryTheory.Presheaf.IsLocallySurjective J e.hom :=
        (CategoryTheory.Sheaf.isLocallySurjective_sheafToPresheaf_map_iff e).mpr
          ((CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} e).mpr
            inferInstance)
      have h_loc_lift : ∀ x : ↥X₀, ∃ t_x : ↑(E_sh.obj.obj (Opposite.op (E x))),
          e.hom.app (Opposite.op (E x)) t_x = G_sh.obj.map (j x).op g₀ := by
        intro x
        let g_x : ↑(G_sh.obj.obj (Opposite.op (E x))) := G_sh.obj.map (j x).op g₀
        have himg_mem : CategoryTheory.Presheaf.imageSieve e.hom g_x ∈ J (E x) :=
          CategoryTheory.Presheaf.imageSieve_mem J e.hom g_x
        have himg_top : CategoryTheory.Presheaf.imageSieve e.hom g_x = ⊤ :=
          hTop x _ himg_mem
        have hid_in : (CategoryTheory.Presheaf.imageSieve e.hom g_x).arrows
            (CategoryTheory.CategoryStruct.id (E x)) := by
          rw [himg_top]
          trivial
        obtain ⟨t_x, ht_x⟩ := hid_in
        refine ⟨t_x, ?_⟩
        rw [op_id, G_sh.obj.map_id] at ht_x
        exact ht_x
      obtain ⟨t₀, ht₀⟩ := (hBijSec E_sh).surjective (fun x => (h_loc_lift x).choose)
      have he_t₀ : e.hom.app (Opposite.op T₀) t₀ = g₀ := by
        apply (hBijSec G_sh).injective
        funext x
        have hnat := ConcreteCategory.congr_hom (e.hom.naturality (j x).op) t₀
        have ht₀_x : E_sh.obj.map (j x).op t₀ = (h_loc_lift x).choose := congrFun ht₀ x
        calc
          G_sh.obj.map (j x).op (e.hom.app (Opposite.op T₀) t₀)
              = e.hom.app (Opposite.op (E x)) (E_sh.obj.map (j x).op t₀) := hnat.symm
          _ = e.hom.app (Opposite.op (E x)) (h_loc_lift x).choose := by rw [ht₀_x]
          _ = G_sh.obj.map (j x).op g₀ := (h_loc_lift x).choose_spec
      let f_tilde₀ : A_ℤ ⟶ E_sh.obj.obj (Opposite.op T₀) := (homFromAZEquiv _).symm t₀
      let f' : F_ℤ ⟶ E_sh := (adj.homEquiv A_ℤ E_sh).symm f_tilde₀
      refine ⟨f', ?_⟩
      apply (adj.homEquiv A_ℤ G_sh).injective
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
        (adj.homEquiv A_ℤ E_sh).apply_symm_apply]
      apply (homFromAZEquiv _).injective
      change e.hom.app (Opposite.op T₀) (f_tilde₀ (ULift.up.{u} (1 : ℤ))) = g₀
      have hf_t₀ : f_tilde₀ (ULift.up.{u} (1 : ℤ)) = t₀ :=
        (homFromAZEquiv _).apply_symm_apply t₀
      rw [hf_t₀, he_t₀]
    intro n
    exact CategoryTheory.HasProjectiveDimensionLT.subsingleton
      F_ℤ 1 (n + 1) (Nat.le_add_left 1 n) F_ℓ

theorem weil_affine_integral_finite_fiber_card_and_genAlg_shrinking : (∀ (Z : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsAffine Z],
        AlgebraicGeometry.IsIntegral Z →
        ∀ (W : AlgebraicGeometry.Scheme.{u})
          (g : W ⟶ Z)
          [AlgebraicGeometry.IsFinite g],
          ∃ (U₀ : Z.Opens)
            (_ : AlgebraicGeometry.IsAffine (U₀ : AlgebraicGeometry.Scheme.{u}))
            (_ : Nonempty U₀)
            (r₀ : ℕ),
            ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
              (s : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶
                (U₀ : AlgebraicGeometry.Scheme.{u})),
              Nat.card ↥(CategoryTheory.Limits.pullback
                (CategoryTheory.Limits.pullback.snd g U₀.ι) s) = r₀) ∧
    (∀ (k : Type u) [Field k]
        (Z₀ Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsAffine Z₀.left]
        [AlgebraicGeometry.LocallyOfFiniteType Z₀.hom]
        [AlgebraicGeometry.IsAffine Z₁.left]
        [AlgebraicGeometry.LocallyOfFiniteType Z₁.hom],
        AlgebraicGeometry.IsIntegral Z₀.left →
        AlgebraicGeometry.IsIntegral Z₁.left →
        ∀ (g : Z₁ ⟶ Z₀),
          Function.Injective
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) →
          (∀ x : ↑(Z₁.left.presheaf.obj (Opposite.op ⊤)),
            ∃ p : Polynomial ↑(Z₀.left.presheaf.obj (Opposite.op ⊤)),
              p ≠ 0 ∧
              Polynomial.eval₂
                (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) x p = 0) →
          ∀ (U₁ : Z₁.left.Opens), Nonempty U₁ →
            ∃ (U'₀ : Z₀.left.Opens)
              (_ : AlgebraicGeometry.IsAffine (U'₀ : AlgebraicGeometry.Scheme.{u}))
              (_ : Nonempty U'₀),
              ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
                (s₀ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶
                  (U'₀ : AlgebraicGeometry.Scheme.{u})),
                ∃ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Z₁.left),
                  Set.range s₁.base ⊆ (U₁ : Set Z₁.left) ∧
                  s₁ ≫ g.left = s₀ ≫ U'₀.ι) :=
by
  have h_spread : ∀ (R B : Type u) [CommRing R] [IsDomain R] [CommRing B] [Algebra R B]
      [Module.Finite R B],
      ∃ (h : R) (_ : h ≠ 0)
        (I : Type u) (_ : Fintype I)
        (P : I → Polynomial (Localization.Away h)),
        (∀ i : I, (P i).Monic ∧ (P i).Separable) ∧
        ∃ (σ : ((i : I) → AdjoinRoot (P i)) →ₐ[Localization.Away h]
            (TensorProduct R (Localization.Away h) B ⧸
              nilradical (TensorProduct R (Localization.Away h) B)))
          (N : ℕ),
          Function.Injective σ ∧
          ∀ (x : TensorProduct R (Localization.Away h) B ⧸
              nilradical (TensorProduct R (Localization.Away h) B)),
            x ^ (ringExpChar R ^ N) ∈ Set.range σ := by
    intro R B _ _ _ _ _
    classical
    have hex_K : ∃ (K : Type u) (_ : Field K) (_ : Algebra R K), IsFractionRing R K :=
      ⟨FractionRing R, inferInstance, inferInstance, inferInstance⟩
    obtain ⟨K, _, _, _⟩ := hex_K
    have hRK_inj : Function.Injective (algebraMap R K) := IsFractionRing.injective R K
    let B_K : Type u := TensorProduct R K B
    haveI : Module.Finite K B_K := Module.Finite.base_change R K B
    haveI : IsArtinianRing B_K := IsArtinianRing.of_finite K B_K
    let f_B : B →ₗ[R] B_K := TensorProduct.mk R K B 1
    haveI : IsLocalizedModule (nonZeroDivisors R) f_B :=
      IsLocalization.tensorProduct_isLocalizedModule (nonZeroDivisors R) K
    let I₀ : Type u := MaximalSpectrum B_K
    have hFin_I₀ : Finite I₀ :=
      Finite.of_injective MaximalSpectrum.toPrimeSpectrum MaximalSpectrum.toPrimeSpectrum_injective
    letI : Fintype I₀ := Fintype.ofFinite I₀
    letI : DecidableEq I₀ := Classical.decEq I₀
    let L : I₀ → Type u := fun i => B_K ⧸ i.asIdeal
    letI : ∀ i : I₀, Field (L i) := fun i => @Ideal.Quotient.field B_K _ i.asIdeal i.isMaximal
    let Φ_K_alg : (B_K ⧸ nilradical B_K) ≃ₐ[K] ((i : I₀) → L i) :=
      (IsArtinianRing.quotNilradicalEquivPi B_K).restrictScalars K
    let Φ_K : (B_K ⧸ nilradical B_K) ≃+* ((i : I₀) → L i) := Φ_K_alg.toRingEquiv
    by_cases hEmpty : IsEmpty I₀
    · haveI : IsEmpty I₀ := hEmpty
      have hSub_pi : Subsingleton ((i : I₀) → L i) := inferInstance
      have hSub_quot : Subsingleton (B_K ⧸ nilradical B_K) := Φ_K.toEquiv.subsingleton
      have h1_zero_quot : Ideal.Quotient.mk (nilradical B_K) (1 : B_K) = 0 :=
        Subsingleton.elim _ _
      have h1_nil : (1 : B_K) ∈ nilradical B_K := Ideal.Quotient.eq_zero_iff_mem.mp h1_zero_quot
      obtain ⟨m, hm⟩ := mem_nilradical.mp h1_nil
      have h1_BK : f_B 1 = 0 := by
        change (1 : B_K) = 0
        simpa using hm
      obtain ⟨s, hs⟩ := (IsLocalizedModule.eq_zero_iff (nonZeroDivisors R) f_B).mp h1_BK
      have hh_ne : (s : R) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      let h : R := s
      let R_h := Localization.Away h
      let B_h := TensorProduct R R_h B
      let D_h := B_h ⧸ nilradical B_h
      have h1_Bh : (1 : B_h) = 0 := by
        have hinv : algebraMap R R_h h * IsLocalization.Away.invSelf (S := R_h) h = 1 :=
          IsLocalization.Away.mul_invSelf h
        calc
          (1 : B_h) = (1 : R_h) ⊗ₜ[R] (1 : B) := rfl
          _ = (IsLocalization.Away.invSelf (S := R_h) h * algebraMap R R_h h) ⊗ₜ[R] (1 : B) := by
            rw [mul_comm, hinv]
          _ = (h • IsLocalization.Away.invSelf (S := R_h) h) ⊗ₜ[R] (1 : B) := by
            rw [Algebra.smul_def, mul_comm]
          _ = IsLocalization.Away.invSelf (S := R_h) h ⊗ₜ[R] (h • (1 : B)) :=
            TensorProduct.smul_tmul _ _ _
          _ = IsLocalization.Away.invSelf (S := R_h) h ⊗ₜ[R] (0 : B) := by
            have hs' : h • (1 : B) = 0 := hs
            rw [hs']
          _ = 0 := TensorProduct.tmul_zero _ _
      have hSub_Bh : Subsingleton B_h := subsingleton_of_zero_eq_one h1_Bh.symm
      have hSub_Dh : Subsingleton D_h := by
        apply subsingleton_of_zero_eq_one
        rw [← map_zero (Ideal.Quotient.mk (nilradical B_h)),
          ← map_one (Ideal.Quotient.mk (nilradical B_h)), h1_Bh]
      let P_empty : PEmpty.{u + 1} → Polynomial R_h := PEmpty.elim
      let σ_empty : ((i : PEmpty.{u + 1}) → AdjoinRoot (P_empty i)) →ₐ[R_h] D_h :=
        { toFun := fun _ => 0
          map_one' := Subsingleton.elim _ _
          map_mul' := fun _ _ => Subsingleton.elim _ _
          map_zero' := rfl
          map_add' := fun _ _ => Subsingleton.elim _ _
          commutes' := fun _ => Subsingleton.elim _ _ }
      refine ⟨h, hh_ne, PEmpty.{u + 1}, inferInstance, P_empty, fun i => PEmpty.elim i,
        σ_empty, 0, ?_, ?_⟩
      · intro u₁ u₂ _
        funext i
        exact PEmpty.elim i
      · intro x
        exact ⟨0, Subsingleton.elim _ _⟩
    · let I := I₀
      have expChar_of_inj : ∀ (F : Type u) [Field F] [Algebra R F],
          Function.Injective (algebraMap R F) →
          ∀ (q : ℕ) [ExpChar R q], ExpChar F q := by
        intro F _ _ hinjF q hExpR
        cases hExpR with
        | zero =>
          have hcz : CharZero F := by
            constructor
            intro a b hab
            apply CharZero.cast_injective (R := R)
            apply hinjF
            simpa using hab
          exact ExpChar.zero
        | prime hq_prime =>
          have hqF : (q : F) = 0 := by
            rw [← map_natCast (algebraMap R F), CharP.cast_eq_zero, map_zero]
          have hcharF : CharP F q := by
            have hdvd : ringChar F ∣ q := (ringChar.spec F q).mp hqF
            rcases CharP.char_is_prime_or_zero F (ringChar F) with hp | hp0
            · have heq_p : ringChar F = q :=
                ((Nat.Prime.dvd_iff_eq hq_prime hp.ne_one).mp hdvd).symm
              rw [← heq_p]
              exact ringChar.charP F
            · rw [hp0, zero_dvd_iff] at hdvd
              exact absurd hdvd hq_prime.ne_zero
          exact ExpChar.prime hq_prime
      haveI : ExpChar K (ringExpChar R) := expChar_of_inj K hRK_inj (ringExpChar R)
      haveI : Module.Finite K (B_K ⧸ nilradical B_K) :=
        Module.Finite.of_surjective (Ideal.Quotient.mkₐ K (nilradical B_K)).toLinearMap
          Ideal.Quotient.mk_surjective
      haveI : Module.Finite K ((i : I) → L i) :=
        Module.Finite.equiv Φ_K_alg.toLinearEquiv
      haveI : ∀ i : I, FiniteDimensional K (L i) := fun i =>
        Module.Finite.of_surjective (Pi.evalAlgHom K L i).toLinearMap (fun y =>
          ⟨Pi.single (M := L) i y, Pi.single_eq_same i y⟩)
      let E : ∀ i : I, IntermediateField K (L i) := fun i => separableClosure K (L i)
      haveI : ∀ i : I, Algebra.IsSeparable K ↥(E i) := fun i => separableClosure.isSeparable K (L i)
      haveI : ∀ i : I, FiniteDimensional K ↥(E i) := fun i => inferInstance
      choose α₀ hα₀_prim using fun i : I => Field.exists_primitive_element K ↥(E i)
      let α : ∀ i : I, L i := fun i => (α₀ i : L i)
      let P_K : I → Polynomial K := fun i => minpoly K (α₀ i)
      have hInt_α₀ : ∀ i : I, IsIntegral K (α₀ i) := fun i => Algebra.IsIntegral.isIntegral (α₀ i)
      have hPK_monic : ∀ i : I, (P_K i).Monic := fun i => minpoly.monic (hInt_α₀ i)
      have hPK_pos : ∀ i : I, 0 < (P_K i).natDegree := fun i => minpoly.natDegree_pos (hInt_α₀ i)
      have hPK_irred : ∀ i : I, Irreducible (P_K i) := fun i => minpoly.irreducible (hInt_α₀ i)
      have hPK_sep : ∀ i : I, (P_K i).Separable := fun i => Algebra.IsSeparable.isSeparable K (α₀ i)
      have hPK_min_α : ∀ i : I, minpoly K (α i) = P_K i := fun i =>
        minpoly.algHom_eq (E i).val (E i).val.injective (α₀ i)
      have hPK_aeval : ∀ i : I, Polynomial.aeval (α i) (P_K i) = 0 := by
        intro i
        rw [← hPK_min_α i]
        exact minpoly.aeval K (α i)
      have hE_aeval : ∀ (i : I) (y : ↥(E i)), ∃ Q : Polynomial K,
          (y : L i) = Polynomial.aeval (α i) Q := by
        intro i y
        haveI : Fact (Irreducible (P_K i)) := ⟨hPK_irred i⟩
        let φ_E : AdjoinRoot (P_K i) →ₐ[K] ↥(E i) :=
          AdjoinRoot.liftAlgHom (P_K i) (Algebra.ofId K ↥(E i)) (α₀ i) (minpoly.aeval K (α₀ i))
        have hα_mem : α₀ i ∈ φ_E.fieldRange :=
          ⟨AdjoinRoot.root (P_K i),
            AdjoinRoot.liftAlgHom_root (P_K i) (Algebra.ofId K ↥(E i)) (α₀ i)
              (minpoly.aeval K (α₀ i))⟩
        have htop_le : (⊤ : IntermediateField K ↥(E i)) ≤ φ_E.fieldRange := by
          rw [← hα₀_prim i, IntermediateField.adjoin_le_iff]
          exact Set.singleton_subset_iff.mpr hα_mem
        obtain ⟨z, hz⟩ := htop_le (by trivial : y ∈ (⊤ : IntermediateField K ↥(E i)))
        obtain ⟨Q, rfl⟩ := AdjoinRoot.mk_surjective z
        refine ⟨Q, ?_⟩
        have hz_val : ((φ_E (AdjoinRoot.mk (P_K i) Q) : ↥(E i)) : L i) = (y : L i) :=
          congrArg Subtype.val hz
        rw [← hz_val]
        change (E i).val (Polynomial.aeval (α₀ i) Q) = Polynomial.aeval ((E i).val (α₀ i)) Q
        exact (Polynomial.aeval_algHom_apply (E i).val (α₀ i) Q).symm
      choose u_K v_K huv_K using fun i : I =>
        (Polynomial.separable_def (P_K i)).mp (hPK_sep i)
      obtain ⟨G, hG_span⟩ := Module.Finite.fg_top (R := R) (M := B)
      let q := ringExpChar R
      letI : ∀ i : I, Algebra R ↥(E i) :=
        fun i => RingHom.toAlgebra ((algebraMap K ↥(E i)).comp (algebraMap R K))
      have hRE_inj : ∀ i : I, Function.Injective (algebraMap R ↥(E i)) :=
        fun i => (RingHom.injective (algebraMap K ↥(E i))).comp hRK_inj
      haveI : ∀ i : I, ExpChar ↥(E i) q := fun i => expChar_of_inj ↥(E i) (hRE_inj i) q
      haveI : ∀ i : I, IsPurelyInseparable ↥(E i) (L i) :=
        fun i => separableClosure.isPurelyInseparable K (L i)
      let g_coord : ∀ (i : I), B → L i :=
        fun i g => Φ_K_alg (Ideal.Quotient.mk (nilradical B_K) ((1 : K) ⊗ₜ[R] g)) i
      have hex_n : ∀ (i : I) (g : B), ∃ n : ℕ, (g_coord i g) ^ (q ^ n) ∈ E i := by
        intro i g
        obtain ⟨n, y, hy⟩ :=
          (isPurelyInseparable_iff_pow_mem ↥(E i) q).mp inferInstance (g_coord i g)
        refine ⟨n, ?_⟩
        rw [← hy]
        exact y.2
      choose n_exp hn_exp using hex_n
      have hex_N : ∃ N : ℕ, ∀ (i : I), ∀ g ∈ G, n_exp i g ≤ N :=
        ⟨(Finset.univ ×ˢ G).sup (fun p : I × B => n_exp p.1 p.2), fun i g hg =>
          Finset.le_sup (s := Finset.univ ×ˢ G) (f := fun p : I × B => n_exp p.1 p.2)
            (b := (i, g)) (Finset.mem_product.mpr ⟨Finset.mem_univ i, hg⟩)⟩
      obtain ⟨N, hN_ge⟩ := hex_N
      have hPow_mem_E : ∀ (i : I), ∀ g ∈ G, (g_coord i g) ^ (q ^ N) ∈ E i := by
        intro i g hg
        have hle : n_exp i g ≤ N := hN_ge i g hg
        have hpow_split : (g_coord i g) ^ (q ^ N) =
            ((g_coord i g) ^ (q ^ n_exp i g)) ^ (q ^ (N - n_exp i g)) := by
          rw [← pow_mul, ← pow_add, Nat.add_sub_of_le hle]
        rw [hpow_split]
        exact Subsemiring.pow_mem (E i).toSubsemiring (hn_exp i g) (q ^ (N - n_exp i g))
