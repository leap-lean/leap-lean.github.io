      change iY₀.base u.1 ∈ (C_bad : Set ↥X.left) at hmem
      rw [hC_bad_eq] at hmem
      obtain ⟨y, hy_compl, hy_eq⟩ := hmem
      exact hy_compl (hEmb_Y₀.toIsEmbedding.injective hy_eq ▸ u.2)
    let j_good := AlgebraicGeometry.IsOpenImmersion.lift O_good.ι (U₂.ι ≫ iY₀) hU₂_in_good
    have hj_good : j_good ≫ O_good.ι = U₂.ι ≫ iY₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O_good.ι (U₂.ι ≫ iY₀) hU₂_in_good
    have hDisj_good : Disjoint (O_good : Set ↥X.left) (Set.range iC_bad.base) := by
      rw [hRange_bad]
      exact Set.disjoint_left.mpr (fun _ hnx hx => hnx hx)
    have hZero_good : CategoryTheory.Limits.IsZero
        ((pb O_good.ι).obj (weilEtaleHigherDirectImage iC_bad 0 F_bad₀)) :=
      CategoryTheory.Limits.IsZero.of_iso
        (hDisjOpenPullbackZero iC_bad O_good hDisj_good F_bad₀)
        ((pb O_good.ι).mapIso (e_dir0 iC_bad F_bad₀)).symm
    have _ := (hPbExact j_good).1
    have hPull_zero_comp :=
      (hPullComp j_good O_good.ι (weilEtaleHigherDirectImage iC_bad 0 F_bad₀)
        ((pb O_good.ι).obj (weilEtaleHigherDirectImage iC_bad 0 F_bad₀))
        ((pb j_good).obj ((pb O_good.ι).obj (weilEtaleHigherDirectImage iC_bad 0 F_bad₀)))).1
        (hPullSelf O_good.ι _) (hPullSelf j_good _)
    rw [hj_good] at hPull_zero_comp
    obtain ⟨e_z_comp⟩ := hPullIsoOf (U₂.ι ≫ iY₀) hPull_zero_comp
    have hZero_U₂_bad : CategoryTheory.Limits.IsZero
        ((pb (U₂.ι ≫ iY₀)).obj (weilEtaleHigherDirectImage iC_bad 0 F_bad₀)) :=
      CategoryTheory.Limits.IsZero.of_iso
        ((pb j_good).map_isZero hZero_good) e_z_comp
    have _ : CategoryTheory.IsIso
        (CategoryTheory.Limits.kernel.ι ((pb (U₂.ι ≫ iY₀)).map η_bad)) :=
      hZeroKernelι _ hZero_U₂_bad
    let e_K_F_U₂ : (pb (U₂.ι ≫ iY₀)).obj K ≅ (pb (U₂.ι ≫ iY₀)).obj F :=
      CategoryTheory.Limits.PreservesKernel.iso (pb (U₂.ι ≫ iY₀)) η_bad ≪≫
        CategoryTheory.asIso (CategoryTheory.Limits.kernel.ι ((pb (U₂.ι ≫ iY₀)).map η_bad))
    obtain ⟨e_F_L⟩ := hPullIsoOf (U₂.ι ≫ iY₀) hPull_L
    have hPull_K_L : WeilIsEtaleSheafPullback (U₂.ι ≫ iY₀) K ℒ :=
      ⟨hc_of (U₂.ι ≫ iY₀), hr_of (U₂.ι ≫ iY₀), ⟨e_K_F_U₂ ≪≫ e_F_L⟩⟩
    have hPull_KY₀_L : WeilIsEtaleSheafPullback U₂.ι K_Y₀ ℒ :=
      (hPullComp U₂.ι iY₀ K K_Y₀ ℒ).2 (hPullSelf iY₀ K) hPull_K_L
    obtain ⟨e_KY₀_TU₂⟩ := h𝒯_reconstruct U₂ K_Y₀ ℒ hPull_KY₀_L (by
      intro Ω _ _ y hy
      have hy_bad : Set.range (y ≫ iY₀).base ⊆ (C_bad : Set ↥X.left) := by
        rw [hC_bad_eq]
        rintro _ ⟨q, rfl⟩
        exact ⟨y.base q, hy ⟨q, rfl⟩, rfl⟩
      exact CategoryTheory.Limits.IsZero.of_iso
        ((hKer_bad Ω (y ≫ iY₀) hy_bad).2)
        ((e_fib iY₀ Ω y).app K))
    let e_K_push : K ≅ weilEtaleHigherDirectImage iY₀ 0 ((𝒯 U₂).obj ℒ) :=
      CategoryTheory.asIso η_C ≪≫ (e_dir0 iY₀ K_Y₀).symm ≪≫
        (pf iY₀).mapIso e_KY₀_TU₂ ≪≫ e_dir0 iY₀ ((𝒯 U₂).obj ℒ)
    let S_exc : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.ShortComplex.mk (CategoryTheory.Limits.kernel.ι η_bad) η_bad
        (CategoryTheory.Limits.kernel.condition η_bad)
    have hSE_exc : S_exc.ShortExact :=
      { exact := CategoryTheory.ShortComplex.exact_kernel η_bad }
    let S_F : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.ShortComplex.mk (e_K_push.inv ≫ S_exc.f) S_exc.g
        (by rw [CategoryTheory.Category.assoc, S_exc.zero, CategoryTheory.Limits.comp_zero])
    let iso_SF : S_exc ≅ S_F :=
      CategoryTheory.ShortComplex.isoMk e_K_push (CategoryTheory.Iso.refl _)
        (CategoryTheory.Iso.refl _) (by dsimp [S_F]; simp) (by dsimp [S_F]; simp)
    exact ⟨S_F, CategoryTheory.ShortComplex.shortExact_of_iso iso_SF hSE_exc, rfl, rfl, rfl⟩

theorem weil_etale_constructible_excision_and_trace_bridge (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType X.hom]
    [AlgebraicGeometry.QuasiCompact X.hom]
    [AlgebraicGeometry.IsSeparated X.hom] :
    (∀ (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ X.left) [AlgebraicGeometry.Etale w],
        Set.range w.base ⊆ ((⊥ : TopologicalSpace.Closeds ↥X.left) : Set ↥X.left)ᶜ →
        Subsingleton ↥(F.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk w)))) →
      CategoryTheory.Limits.IsZero F) ∧
    (∀ (C C₁ C₂ : TopologicalSpace.Closeds ↥X.left)
      (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
      C = C₁ ⊔ C₂ →
      WeilIsConstructibleModPrimeSheaf ℓ X.left F →
      (∀ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ X.left) [AlgebraicGeometry.Etale w],
        Set.range w.base ⊆ (C : Set ↥X.left)ᶜ →
        Subsingleton ↥(F.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk w)))) →
      ∃ (F₁ F₃ : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})
        (S : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})),
        S.ShortExact ∧ S.X₁ = F₁ ∧ S.X₂ = F ∧ S.X₃ = F₃ ∧
        WeilIsConstructibleModPrimeSheaf ℓ X.left F₁ ∧
        (∀ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ X.left) [AlgebraicGeometry.Etale w],
          Set.range w.base ⊆ (C₂ : Set ↥X.left)ᶜ →
          Subsingleton ↥(F₁.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk w)))) ∧
        WeilIsConstructibleModPrimeSheaf ℓ X.left F₃ ∧
        (∀ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ X.left) [AlgebraicGeometry.Etale w],
          Set.range w.base ⊆ (C₁ : Set ↥X.left)ᶜ →
          Subsingleton ↥(F₃.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk w))))) ∧
    (∀ (C : TopologicalSpace.Closeds ↥X.left)
      (U₀ U₂ : (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subscheme.Opens)
      (V₀ U'' : AlgebraicGeometry.Scheme.{u})
      (p₀ : V₀ ⟶ U₀.toScheme) (π'' : U'' ⟶ U₂.toScheme) (q₀ : U'' ⟶ V₀)
      (A : AddCommGrpCat.{u})
      (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
      π'' ≫ U₂.ι = q₀ ≫ p₀ ≫ U₀.ι →
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      WeilIsEtaleSheafPullback
        (p₀ ≫ U₀.ι ≫ (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subschemeι) F
        ((CategoryTheory.constantSheaf V₀.smallEtaleTopology AddCommGrpCat.{u}).obj A) →
      ∃ (ℒ : CategoryTheory.Sheaf U₂.toScheme.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id ℒ = 0 ∧
        WeilIsEtaleSheafPullback
          (U₂.ι ≫ (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subschemeι) F ℒ ∧
        WeilIsEtaleSheafPullback π'' ℒ
          ((CategoryTheory.constantSheaf U''.smallEtaleTopology AddCommGrpCat.{u}).obj A)) ∧
    (∀ (P : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u} → Prop),
      (∀ F, CategoryTheory.Limits.IsZero F → P F) →
      (∀ F₁ F₂ (i : F₁ ⟶ F₂) (r : F₂ ⟶ F₁), i ≫ r = 𝟙 F₁ → P F₂ → P F₁) →
      (∀ (S : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})),
          S.ShortExact → ℓ • 𝟙 S.X₂ = 0 →
          ((P S.X₁ ∧ P S.X₃ → P S.X₂) ∧ (P S.X₂ ∧ P S.X₃ → P S.X₁))) →
      (∀ (W : AlgebraicGeometry.Scheme.{u}) (g : W ⟶ X.left),
        AlgebraicGeometry.IsFinite g →
        P (weilEtaleHigherDirectImage g 0 (weilEtaleTorsionSheaf W ℓ))) →
      ∀ (C : TopologicalSpace.Closeds ↥X.left)
        (U₂ : (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subscheme.Opens)
        (_ : Nonempty U₂)
        (Y' : AlgebraicGeometry.Scheme.{u})
        (ν : Y' ⟶ (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subscheme)
        (_ : AlgebraicGeometry.IsFinite ν)
        (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsConstructibleModPrimeSheaf ℓ X.left F →
        (∀ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ X.left) [AlgebraicGeometry.Etale w],
          Set.range w.base ⊆ (C : Set ↥X.left)ᶜ →
          Subsingleton ↥(F.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk w)))) →
        ∃ (C_bad : TopologicalSpace.Closeds ↥X.left)
          (F_bad : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
          C_bad < C ∧
          WeilIsConstructibleModPrimeSheaf ℓ X.left F_bad ∧
          (∀ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ X.left) [AlgebraicGeometry.Etale w],
            Set.range w.base ⊆ (C_bad : Set ↥X.left)ᶜ →
            Subsingleton ↥(F_bad.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk w)))) ∧
          (P F_bad →
            ∀ (ℒ : CategoryTheory.Sheaf U₂.toScheme.smallEtaleTopology AddCommGrpCat.{u})
              (ℳ : CategoryTheory.Sheaf (ν ⁻¹ᵁ U₂).toScheme.smallEtaleTopology AddCommGrpCat.{u})
              (m : ℕ)
              (𝒩 : Fin (m + 1) →
                CategoryTheory.Sheaf (ν ⁻¹ᵁ U₂).toScheme.smallEtaleTopology AddCommGrpCat.{u}),
              ℓ • CategoryTheory.CategoryStruct.id ℒ = 0 →
              WeilIsEtaleSheafPullback
                (U₂.ι ≫ (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subschemeι) F ℒ →
              WeilIsEtaleSheafPullback (ν ∣_ U₂) ℒ ℳ →
              (∃ (i_L : ℒ ⟶ weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ)
                 (r_L : weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ ⟶ ℒ),
                i_L ≫ r_L = 𝟙 ℒ) →
              CategoryTheory.Limits.IsZero (𝒩 0) →
              Nonempty (CategoryTheory.Iso (𝒩 (Fin.last m)) ℳ) →
              (∀ r : Fin m, ∃ (S_r : CategoryTheory.ShortComplex
                  (CategoryTheory.Sheaf (ν ⁻¹ᵁ U₂).toScheme.smallEtaleTopology AddCommGrpCat.{u})),
                S_r.ShortExact ∧ S_r.X₁ = 𝒩 r.castSucc ∧ S_r.X₂ = 𝒩 r.succ ∧
                S_r.X₃ = weilEtaleTorsionSheaf (ν ⁻¹ᵁ U₂).toScheme ℓ) →
              P F)) :=
by
  obtain ⟨hPullEx, hPullIso, hPullComp, hPullConst, hPullKer, -⟩ :=
    weil_etale_pullback_exact_and_pseudofunctor.{u} ℓ
  obtain ⟨hClosedPull, hKerConst⟩ :=
    weil_etale_constructible_closed_pullback_and_kernel k ℓ X
      (@hPullIso) (@hPullComp) (@hPullConst) (@hPullKer)
  obtain ⟨hClosedPush, hUnitExc⟩ :=
    weil_etale_closed_subscheme_unit_excision k ℓ hPBC X
  obtain ⟨hDir0, hDirComp, hFinExact⟩ :=
    weil_etale_finite_directImage_zero_exact_and_comp k ℓ hPBC X
  have hTorIso : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}},
      Nonempty (G₁ ≅ G₂) →
      ℓ • CategoryTheory.CategoryStruct.id G₁ = 0 →
      ℓ • CategoryTheory.CategoryStruct.id G₂ = 0 := by
    rintro Z G₁ G₂ ⟨e⟩ hG₁
    calc
      ℓ • CategoryTheory.CategoryStruct.id G₂ =
          ℓ • (e.inv ≫ (CategoryTheory.CategoryStruct.id G₁ ≫ e.hom)) := by simp
      _ = e.inv ≫ (ℓ • (CategoryTheory.CategoryStruct.id G₁ ≫ e.hom)) :=
          (CategoryTheory.Preadditive.comp_nsmul e.inv _ ℓ).symm
      _ = e.inv ≫ ((ℓ • CategoryTheory.CategoryStruct.id G₁) ≫ e.hom) := by
          rw [← CategoryTheory.Preadditive.nsmul_comp]
      _ = 0 := by rw [hG₁]; simp
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro F hVan
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply CategoryTheory.Sheaf.hom_ext
    ext E : 2
    rcases E with ⟨⟨⟨W, ⟨⟨⟩⟩, w⟩, hw⟩⟩
    have hSub : Subsingleton ↥(F.obj.obj
        (Opposite.op (@AlgebraicGeometry.Scheme.Etale.mk X.left W w hw))) :=
      @hVan W w hw (by simp)
    ext x
    exact @Subsingleton.elim _ hSub _ _
  · intro C C₁ C₂ F hEq hF hVan
    let iC₁ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C₁).subschemeι
    obtain ⟨F_C₁, hPull_C₁, -, -⟩ := hPullEx iC₁ F
    have hConst_FC₁ : WeilIsConstructibleModPrimeSheaf ℓ _ F_C₁ :=
      hClosedPull _ iC₁ inferInstance F F_C₁ hF hPull_C₁
    obtain ⟨hConst_F₃, hVan_F₃⟩ := hClosedPush C₁ F_C₁ hConst_FC₁
    obtain ⟨η, S, hSE, hX₁, hX₂, hX₃, hVan_F₁⟩ :=
      hUnitExc C C₁ C₂ F F_C₁ hEq hF hPull_C₁ hVan
    have hConst_F₁ : WeilIsConstructibleModPrimeSheaf ℓ X.left (CategoryTheory.Limits.kernel η) :=
      hKerConst F _ η hF hConst_F₃
    exact ⟨CategoryTheory.Limits.kernel η,
      weilEtaleHigherDirectImage iC₁ 0 F_C₁,
      S, hSE, hX₁, hX₂, hX₃, hConst_F₁, hVan_F₁, hConst_F₃, hVan_F₃⟩
  · intro C U₀ U₂ V₀ U'' p₀ π'' q₀ A F hComm hTorF hPull₀
    let iC := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subschemeι
    obtain ⟨ℒ, hPullL, hTorL_imp, -⟩ := hPullEx (U₂.ι ≫ iC) F
    have hTorL : ℓ • CategoryTheory.CategoryStruct.id ℒ = 0 := hTorL_imp hTorF
    have hPull_qA := hPullConst q₀ A
    have hPull_comp := (hPullComp q₀ (p₀ ≫ U₀.ι ≫ iC) F _ _).1 hPull₀ hPull_qA
    have hHomEq : q₀ ≫ (p₀ ≫ U₀.ι ≫ iC) = π'' ≫ (U₂.ι ≫ iC) := by
      calc
        q₀ ≫ (p₀ ≫ U₀.ι ≫ iC) = (q₀ ≫ p₀ ≫ U₀.ι) ≫ iC := by
          simp only [CategoryTheory.Category.assoc]
        _ = (π'' ≫ U₂.ι) ≫ iC := by rw [← hComm]
        _ = π'' ≫ (U₂.ι ≫ iC) := by simp only [CategoryTheory.Category.assoc]
    rw [hHomEq] at hPull_comp
    exact ⟨ℒ, hTorL, hPullL, (hPullComp π'' (U₂.ι ≫ iC) F ℒ _).2 hPullL hPull_comp⟩
  · intro P hZero hRetract hExact hFinAll C U₂ hU₂ Y' ν hFin_ν F hF hVan
    have hP_iso : ∀ {G₁ G₂ : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}},
        Nonempty (G₁ ≅ G₂) → P G₂ → P G₁ :=
      fun ⟨e⟩ hG₂ => hRetract _ _ e.hom e.inv e.hom_inv_id hG₂
    let I_C := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C
    let Y₀ := I_C.subscheme
    let iY₀ := I_C.subschemeι
    have hSupp : I_C.support = C :=
      SetLike.ext' (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal C)
    have hCl_Y₀ : AlgebraicGeometry.IsClosedImmersion iY₀ := inferInstance
    have hEmb : Topology.IsClosedEmbedding ⇑iY₀.base :=
      ((AlgebraicGeometry.isClosedImmersion_iff iY₀).mp hCl_Y₀).2
    have hRange : Set.range ⇑iY₀.base = (C : Set ↥X.left) := by
      dsimp [iY₀]
      rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι, hSupp]
    let C_bad : TopologicalSpace.Closeds ↥X.left :=
      ⟨⇑iY₀.base '' ((U₂ : Set ↥Y₀)ᶜ), hEmb.isClosedMap _ U₂.isOpen.isClosed_compl⟩
    have hLt_bad : C_bad < C := by
      refine lt_of_le_not_ge ?_ ?_
      · rintro _ ⟨y, -, rfl⟩
        change iY₀.base y ∈ (C : Set ↥X.left)
        rw [← hRange]
        exact ⟨y, rfl⟩
      · intro hle
        obtain ⟨⟨u₀, hu₀⟩⟩ := hU₂
        have huC : iY₀.base u₀ ∈ (C : Set ↥X.left) := by
          rw [← hRange]
          exact ⟨u₀, rfl⟩
        obtain ⟨y, hy_compl, hy_eq⟩ := hle huC
        have hyu : y = u₀ := hEmb.toIsEmbedding.injective hy_eq
        exact hy_compl (hyu ▸ hu₀)
    let iC_bad := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_bad).subschemeι
    obtain ⟨F_bad₀, hPull_bad₀, -, -⟩ := hPullEx iC_bad F
    let F_bad := weilEtaleHigherDirectImage iC_bad 0 F_bad₀
    have hConst_bad₀ : WeilIsConstructibleModPrimeSheaf ℓ _ F_bad₀ :=
      hClosedPull _ iC_bad inferInstance F F_bad₀ hF hPull_bad₀
    obtain ⟨hConst_bad, hVan_bad⟩ := hClosedPush C_bad F_bad₀ hConst_bad₀
    refine ⟨C_bad, F_bad, hLt_bad, hConst_bad, hVan_bad, ?_⟩
    intro hPF_bad ℒ ℳ m 𝒩 hTorL hPullL hPullM hRetL hZero0 hIsoLast hFilt
    obtain ⟨T_U', T_U₂, hTU'_prop, hTU'_ex, hTU₂_ret,
        ⟨W', iW', S₀, hCl_W', hSE₀, hS₀_1, hS₀_2, hS₀_3⟩, hBC_ν, hExc_F⟩ :=
      weil_etale_open_extensionByZero_and_finite_baseChange
        k ℓ hPBC X C U₂ Y' ν hFin_ν C_bad rfl
    have hTorM : ℓ • CategoryTheory.CategoryStruct.id ℳ = 0 := by
      obtain ⟨ℳ₀, hPullM₀, hTorM₀_imp, -⟩ := hPullEx (ν ∣_ U₂) ℒ
      have hTorM₀ : ℓ • CategoryTheory.CategoryStruct.id ℳ₀ = 0 := hTorM₀_imp hTorL
      rcases hPullM₀ with ⟨hc₀, ha₀, ⟨e₀⟩⟩
      rcases hPullM with ⟨hc₁, ha₁, ⟨e₁⟩⟩
      cases Subsingleton.elim hc₀ hc₁
      cases Subsingleton.elim ha₀ ha₁
      exact hTorIso ⟨e₀.symm.trans e₁⟩ hTorM₀
    have hTorLast : ℓ • CategoryTheory.CategoryStruct.id (𝒩 (Fin.last m)) = 0 := by
      rcases hIsoLast with ⟨eLast⟩
      exact hTorIso ⟨eLast.symm⟩ hTorM
    have hTorAdd : ∀ (d : ℕ) (k_idx : Fin (m + 1)),
        k_idx.1 + d = m → ℓ • CategoryTheory.CategoryStruct.id (𝒩 k_idx) = 0 := by
      intro d
      induction d with
      | zero =>
        intro k_idx hk
        have hk_eq : k_idx = Fin.last m := Fin.ext (by dsimp [Fin.last]; omega)
        rwa [hk_eq]
      | succ d ih =>
        intro k_idx hk
        let r : Fin m := ⟨k_idx.1, by omega⟩
        have hr_cast : r.castSucc = k_idx := Fin.ext rfl
        have hr_succ : ℓ • CategoryTheory.CategoryStruct.id (𝒩 r.succ) = 0 :=
          ih r.succ (by dsimp [r]; omega)
        obtain ⟨S_r, hSE_r, hSr1, hSr2, -⟩ := hFilt r
        have : CategoryTheory.Mono S_r.f := hSE_r.mono_f
        have hTorX₂ : ℓ • CategoryTheory.CategoryStruct.id S_r.X₂ = 0 := by
          rwa [hSr2]
        have hTorX₁ : ℓ • CategoryTheory.CategoryStruct.id S_r.X₁ = 0 := by
          apply (CategoryTheory.cancel_mono S_r.f).mp
          calc
            (ℓ • CategoryTheory.CategoryStruct.id S_r.X₁) ≫ S_r.f = ℓ • S_r.f := by
              rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp]
            _ = S_r.f ≫ (ℓ • CategoryTheory.CategoryStruct.id S_r.X₂) := by
              rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
            _ = 0 := by rw [hTorX₂, CategoryTheory.Limits.comp_zero]
            _ = 0 ≫ S_r.f := (CategoryTheory.Limits.zero_comp).symm
        rwa [hSr1, hr_cast] at hTorX₁
    have hTorN : ∀ k_idx : Fin (m + 1),
        ℓ • CategoryTheory.CategoryStruct.id (𝒩 k_idx) = 0 := by
      intro k_idx
      obtain ⟨d, hd⟩ := Nat.le.dest (Nat.le_of_lt_succ k_idx.2)
      exact hTorAdd d k_idx hd
    have : AlgebraicGeometry.IsFinite ν := hFin_ν
    have : AlgebraicGeometry.IsClosedImmersion iW' := hCl_W'
    let π : Y' ⟶ X.left := ν ≫ iY₀
    have hFin_π : AlgebraicGeometry.IsFinite π := inferInstance
    have hFin_W'π : AlgebraicGeometry.IsFinite (iW' ≫ π) := inferInstance
    have hTor_Fℓ : ℓ • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Y' ℓ) = 0 := by
      let C_sh := CategoryTheory.constantSheaf Y'.smallEtaleTopology AddCommGrpCat.{u}
      let A_ℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
      have : C_sh.Additive := by dsimp [C_sh]; infer_instance
      have hTorA : ℓ • CategoryTheory.CategoryStruct.id A_ℓ = 0 := by
        ext ⟨x⟩
        apply ULift.ext
        change ℓ • x = 0
        rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
      change ℓ • CategoryTheory.CategoryStruct.id (C_sh.obj A_ℓ) = 0
      rw [← C_sh.map_id, ← C_sh.map_nsmul, hTorA, C_sh.map_zero]
    have hTor_S₀₂ : ℓ • CategoryTheory.CategoryStruct.id S₀.X₂ = 0 := by
      rw [hS₀_2]
      exact hTor_Fℓ
    obtain ⟨S'₀, hSE'₀, hS'₀_1, hS'₀_2, hS'₀_3⟩ :=
      hFinExact Y' π hFin_π S₀ hSE₀ hTor_S₀₂
    have hTor_S'₀₂ : ℓ • CategoryTheory.CategoryStruct.id S'₀.X₂ = 0 := by
      rw [hS'₀_2]
      exact (hDir0 π S₀.X₂ S₀.X₂).2.1 hTor_S₀₂
    have hPS'₀_2 : P S'₀.X₂ := by
      rw [hS'₀_2, hS₀_2]
      exact hFinAll Y' π hFin_π
    have hPS'₀_3 : P S'₀.X₃ := by
      rw [hS'₀_3, hS₀_3]
      obtain ⟨eComp⟩ := hDirComp iW' π (weilEtaleTorsionSheaf W' ℓ)
      exact hP_iso ⟨eComp.symm⟩ (hFinAll W' (iW' ≫ π) hFin_W'π)
    have hStepA : P (weilEtaleHigherDirectImage π 0
        (T_U' (weilEtaleTorsionSheaf (ν ⁻¹ᵁ U₂).toScheme ℓ))) := by
      have hX₁ := (hExact S'₀ hSE'₀ hTor_S'₀₂).2 ⟨hPS'₀_2, hPS'₀_3⟩
      rwa [hS'₀_1, hS₀_1] at hX₁
    have hStepB_ind : ∀ (n : ℕ) (hn : n < m + 1),
        P (weilEtaleHigherDirectImage π 0 (T_U' (𝒩 ⟨n, hn⟩))) := by
      intro n
      induction n with
      | zero =>
        intro hn
        have h0_eq : (⟨0, hn⟩ : Fin (m + 1)) = 0 := Fin.ext rfl
        rw [h0_eq]
        exact hZero _ ((hDir0 π (T_U' (𝒩 0)) (T_U' (𝒩 0))).1
          ((hTU'_prop (𝒩 0) (𝒩 0)).1 hZero0))
      | succ n ih =>
        intro hn
        let r : Fin m := ⟨n, Nat.lt_of_succ_lt_succ hn⟩
        have hr_succ : (⟨n + 1, hn⟩ : Fin (m + 1)) = r.succ := Fin.ext rfl
        rw [hr_succ]
        obtain ⟨S_r, hSE_r, hSr1, hSr2, hSr3⟩ := hFilt r
        obtain ⟨S'_r, hSE'_r, hS'_r1, hS'_r2, hS'_r3⟩ := hTU'_ex S_r hSE_r
        have hTor_Sr2 : ℓ • CategoryTheory.CategoryStruct.id S_r.X₂ = 0 := by
          rw [hSr2]
          exact hTorN r.succ
        have hTor_S'r2 : ℓ • CategoryTheory.CategoryStruct.id S'_r.X₂ = 0 := by
          rw [hS'_r2]
          exact (hTU'_prop S_r.X₂ S_r.X₂).2.1 hTor_Sr2
        obtain ⟨S''_r, hSE''_r, hS''_r1, hS''_r2, hS''_r3⟩ :=
          hFinExact Y' π hFin_π S'_r hSE'_r hTor_S'r2
        have hTor_S''r2 : ℓ • CategoryTheory.CategoryStruct.id S''_r.X₂ = 0 := by
          rw [hS''_r2]
          exact (hDir0 π S'_r.X₂ S'_r.X₂).2.1 hTor_S'r2
        have hPS''_1 : P S''_r.X₁ := by
          rw [hS''_r1, hS'_r1, hSr1]
          exact ih (Nat.lt_trans r.2 (Nat.lt_succ_self m))
        have hPS''_3 : P S''_r.X₃ := by
          rw [hS''_r3, hS'_r3, hSr3]
          exact hStepA
        have hPS''_2 := (hExact S''_r hSE''_r hTor_S''r2).1 ⟨hPS''_1, hPS''_3⟩
        rwa [hS''_r2, hS'_r2, hSr2] at hPS''_2
    have hStepB : P (weilEtaleHigherDirectImage π 0 (T_U' ℳ)) := by
      have hLast : P (weilEtaleHigherDirectImage π 0 (T_U' (𝒩 (Fin.last m)))) :=
        hStepB_ind m (Nat.lt_succ_self m)
      rcases hIsoLast with ⟨eLast⟩
      obtain ⟨eTU'⟩ := (hTU'_prop (𝒩 (Fin.last m)) ℳ).2.2 ⟨eLast⟩
      obtain ⟨eDir⟩ := (hDir0 π _ _).2.2.1 ⟨eTU'⟩
      exact hP_iso ⟨eDir.symm⟩ hLast
    have hStepC₁ : P (weilEtaleHigherDirectImage iY₀ 0
        (weilEtaleHigherDirectImage ν 0 (T_U' ℳ))) := by
      obtain ⟨eComp⟩ := hDirComp ν iY₀ (T_U' ℳ)
      exact hP_iso ⟨eComp.symm⟩ hStepB
    have hStepC₂ : P (weilEtaleHigherDirectImage iY₀ 0
        (T_U₂ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ))) := by
      obtain ⟨eBC⟩ := hBC_ν ℳ hTorM
      obtain ⟨eDir⟩ := (hDir0 iY₀ _ _).2.2.1 ⟨eBC⟩
      exact hP_iso ⟨eDir.symm⟩ hStepC₁
    have hStepC : P (weilEtaleHigherDirectImage iY₀ 0 (T_U₂ ℒ)) := by
      obtain ⟨i₀, r₀, hir₀⟩ :=
        hTU₂_ret ℒ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ) hRetL
      obtain ⟨i₁, r₁, hir₁⟩ :=
        (hDir0 iY₀ (T_U₂ ℒ) (T_U₂ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ))).2.2.2
          ⟨i₀, r₀, hir₀⟩
      exact hRetract _ _ i₁ r₁ hir₁ hStepC₂
    obtain ⟨S_F, hSE_F, hSF_1, hSF_2, hSF_3⟩ :=
      hExc_F F F_bad₀ ℒ hF hVan hPull_bad₀ hPullL
    have hTor_SF2 : ℓ • CategoryTheory.CategoryStruct.id S_F.X₂ = 0 := by
      rw [hSF_2]
      exact hF.1
    have hPSF_1 : P S_F.X₁ := by
      rw [hSF_1]
      exact hStepC
    have hPSF_3 : P S_F.X₃ := by
      rw [hSF_3]
      exact hPF_bad
    have hPSF_2 := (hExact S_F hSE_F hTor_SF2).1 ⟨hPSF_1, hPSF_3⟩
    rwa [hSF_2] at hPSF_2

theorem weil_etale_galois_sylow_cover_and_normalization (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType X.hom]
    [AlgebraicGeometry.IsSeparated X.hom]
    (Y₀ : AlgebraicGeometry.Scheme.{u}) (iY₀ : Y₀ ⟶ X.left)
    (hClY₀ : AlgebraicGeometry.IsClosedImmersion iY₀)
    (hIntY₀ : AlgebraicGeometry.IsIntegral Y₀)
    (U₀ : Y₀.Opens) (hU₀ : Nonempty U₀)
    (V₀ : AlgebraicGeometry.Scheme.{u}) (p₀ : V₀ ⟶ U₀.toScheme)
    (hFin₀ : AlgebraicGeometry.IsFinite p₀)
    (hEt₀ : AlgebraicGeometry.Etale p₀)
    (hSurj₀ : AlgebraicGeometry.Surjective p₀) :
    ∃ (U₂ : Y₀.Opens) (_ : Nonempty U₂)
      (Y' U'' : AlgebraicGeometry.Scheme.{u})
      (ν : Y' ⟶ Y₀)
      (π' : U'' ⟶ (ν ⁻¹ᵁ U₂).toScheme)
      (q₀ : U'' ⟶ V₀)
      (I_G S_idx H : Type u)
      (_ : Fintype I_G) (_ : Fintype S_idx) (_ : Group H) (_ : Fintype H)
      (actG : I_G → (U'' ⟶ U''))
      (secS : S_idx → (U'' ⟶ (ν ⁻¹ᵁ U₂).toScheme))
      (γ_G : I_G → (U'' ⟶ CategoryTheory.Limits.pullback (π' ≫ (ν ∣_ U₂)) (π' ≫ (ν ∣_ U₂))))
      (actH : H → (U'' ⟶ U''))
      (γ_H : H → (U'' ⟶ CategoryTheory.Limits.pullback π' π')),
      AlgebraicGeometry.IsIntegral Y' ∧
      AlgebraicGeometry.IsFinite ν ∧
      AlgebraicGeometry.IsFinite (ν ∣_ U₂) ∧
      AlgebraicGeometry.Etale (ν ∣_ U₂) ∧
      AlgebraicGeometry.Surjective (ν ∣_ U₂) ∧
      AlgebraicGeometry.IsIntegral U'' ∧
      AlgebraicGeometry.Etale π' ∧
      AlgebraicGeometry.Surjective π' ∧
      ((π' ≫ (ν ∣_ U₂)) ≫ U₂.ι = q₀ ≫ p₀ ≫ U₀.ι) ∧
      ¬ (ℓ ∣ Fintype.card S_idx) ∧
      IsPGroup ℓ H ∧
      (∀ ι : S_idx, secS ι ≫ (ν ∣_ U₂) = π' ≫ (ν ∣_ U₂)) ∧
      (∀ g : I_G, ∃ σ_perm : Equiv.Perm S_idx, ∀ ι : S_idx, actG g ≫ secS ι = secS (σ_perm ι)) ∧
      (∀ g : I_G,
        γ_G g ≫ CategoryTheory.Limits.pullback.fst (π' ≫ (ν ∣_ U₂)) (π' ≫ (ν ∣_ U₂)) = actG g ∧
        γ_G g ≫ CategoryTheory.Limits.pullback.snd (π' ≫ (ν ∣_ U₂)) (π' ≫ (ν ∣_ U₂)) =
          CategoryTheory.CategoryStruct.id U'') ∧
      (⋃ g : I_G, Set.range (γ_G g).base) = Set.univ ∧
      (∀ τ : H, actH τ ≫ π' = π') ∧
      actH 1 = CategoryTheory.CategoryStruct.id U'' ∧
      (∀ τ₁ τ₂ : H, actH (τ₁ * τ₂) = actH τ₁ ≫ actH τ₂) ∧
      (∀ τ : H,
        γ_H τ ≫ CategoryTheory.Limits.pullback.fst π' π' = actH τ ∧
        γ_H τ ≫ CategoryTheory.Limits.pullback.snd π' π' =
          CategoryTheory.CategoryStruct.id U'') ∧
      (⋃ τ : H, Set.range (γ_H τ).base) = Set.univ :=
by
  classical
  letI : AlgebraicGeometry.IsIntegral Y₀ := hIntY₀
  letI : AlgebraicGeometry.IsClosedImmersion iY₀ := hClY₀
  letI : AlgebraicGeometry.IsFinite p₀ := hFin₀
  letI : AlgebraicGeometry.Etale p₀ := hEt₀
  letI : AlgebraicGeometry.Surjective p₀ := hSurj₀

  
  
  
  have hFinIntClosure :
      ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
        (K₀ : Type u) [Field K₀] [Algebra A K₀] [IsFractionRing A K₀],
        Module.Finite A ↥(integralClosure A K₀) ∧
        IsIntegrallyClosed ↥(integralClosure A K₀) := by
    intro A _ _ _ _ K₀ _ _ _
    refine ⟨?_, integralClosure.isIntegrallyClosedOfFiniteExtension K₀⟩
    have hFrobSpan : ∀ (s p e : ℕ) [ExpChar k p],
        ∃ (m : ℕ) (u : Fin m → MvPolynomial (Fin s) k),
          ∀ f : MvPolynomial (Fin s) k,
            ∃ q : Fin m → MvPolynomial (Fin s) k,
              f = ∑ j : Fin m, (q j) ^ (p ^ e) * u j := by
      intro s p e _
      let Q : ℕ := p ^ e
      have hQ : 0 < Q := pow_pos (expChar_pos k p) e
      have : ExpChar (MvPolynomial (Fin s) k) p :=
        expChar_of_injective_algebraMap (MvPolynomial.C_injective (Fin s) k) p
      have : PerfectField k := IsAlgClosed.perfectField k
      have : PerfectRing k p := PerfectField.toPerfectRing p
      let φ_k : k ≃+* k := iterateFrobeniusEquiv k p e
      let u₀ : (Fin s → Fin Q) → MvPolynomial (Fin s) k :=
        fun r => ∏ i : Fin s, MvPolynomial.X i ^ (r i).1
      have h_ind : ∀ f : MvPolynomial (Fin s) k,
          ∃ q₀ : (Fin s → Fin Q) → MvPolynomial (Fin s) k,
            f = ∑ r : Fin s → Fin Q, (q₀ r) ^ Q * u₀ r := by
        intro f
        refine MvPolynomial.induction_on' f ?_ ?_
        · intro d c
          let r_d : Fin s → Fin Q := fun i => ⟨d i % Q, Nat.mod_lt (d i) hQ⟩
          let c₀ : k := φ_k.symm c
          have hc₀ : c₀ ^ Q = c := by
            have h1 : φ_k c₀ = c := φ_k.apply_symm_apply c
            rwa [iterateFrobeniusEquiv_def] at h1
          let g_d : MvPolynomial (Fin s) k :=
            MvPolynomial.C c₀ * ∏ i : Fin s, MvPolynomial.X i ^ (d i / Q)
          refine ⟨fun r => if r = r_d then g_d else 0, ?_⟩
          rw [Finset.sum_eq_single r_d]
          · simp only [↓reduceIte]
            have h_mon : (MvPolynomial.monomial d c : MvPolynomial (Fin s) k) =
                MvPolynomial.C c * ∏ i : Fin s, (MvPolynomial.X i : MvPolynomial (Fin s) k) ^ d i := by
              rw [MvPolynomial.monomial_eq,
                Finsupp.prod_fintype d (fun i n => (MvPolynomial.X i : MvPolynomial (Fin s) k) ^ n)
                  (fun _ => pow_zero _)]
            rw [h_mon]
            have hg_pow : g_d ^ Q =
                MvPolynomial.C c *
                  ∏ i : Fin s, (MvPolynomial.X i : MvPolynomial (Fin s) k) ^ (Q * (d i / Q)) := by
              dsimp [g_d]
              rw [mul_pow, ← map_pow MvPolynomial.C, hc₀, ← Finset.prod_pow]
              congr 1
              refine Finset.prod_congr rfl (fun i _ => ?_)
              rw [← pow_mul, mul_comm]
            rw [hg_pow, mul_assoc]
            congr 1
            rw [← Finset.prod_mul_distrib]
            refine Finset.prod_congr rfl (fun i _ => ?_)
            dsimp [r_d]
            rw [← pow_add, Nat.div_add_mod (d i) Q]
          · intro r _ hr
            simp [hr, zero_pow hQ.ne']
          · intro h_abs
            exact absurd (Finset.mem_univ r_d) h_abs
        · intro f₁ f₂ ⟨q₁, hq₁⟩ ⟨q₂, hq₂⟩
          refine ⟨fun r => q₁ r + q₂ r, ?_⟩
          rw [hq₁, hq₂, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun r _ => ?_)
          have h_add_pow : (q₁ r + q₂ r) ^ Q = q₁ r ^ Q + q₂ r ^ Q := by
            have hm := map_add (iterateFrobenius (MvPolynomial (Fin s) k) p e) (q₁ r) (q₂ r)
            simpa only [iterateFrobenius_def, Q] using hm
          rw [h_add_pow, right_distrib]
      let m := Fintype.card (Fin s → Fin Q)
      let e_fin : (Fin s → Fin Q) ≃ Fin m := Fintype.equivFin (Fin s → Fin Q)
      refine ⟨m, fun j => u₀ (e_fin.symm j), fun f => ?_⟩
      obtain ⟨q₀, hq₀⟩ := h_ind f
      refine ⟨fun j => q₀ (e_fin.symm j), ?_⟩
      rw [hq₀]
      exact (Equiv.sum_comp e_fin.symm (fun r => q₀ r ^ Q * u₀ r)).symm
    have hFrobFinite : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
        [IsNoetherianRing R] (F : Type u) [Field F] [Algebra R F] [IsFractionRing R F]
        (L : Type u) [Field L] [Algebra R L] [Algebra F L] [IsScalarTower R F L]
        [FiniteDimensional F L] (p : ℕ) [ExpChar R p],
        (∀ e : ℕ, ∃ (m : ℕ) (u : Fin m → R),
          ∀ r : R, ∃ q : Fin m → R, r = ∑ j : Fin m, (q j) ^ (p ^ e) * u j) →
        Module.Finite R ↥(integralClosure R L) := by
      intro R _ _ _ _ F _ _ _ L _ _ _ _ _ p _ hSpan
      let M : IntermediateField F L := separableClosure F L
      have hFinM : Module.Finite R ↥(integralClosure R ↥M) :=
        IsIntegralClosure.finite R F ↥M ↥(integralClosure R ↥M)
      obtain ⟨n, f_surj, hf_surj⟩ :=
        @Module.Finite.exists_fin' R ↥(integralClosure R ↥M) _ _ _ hFinM
      have hRM_inj : Function.Injective (algebraMap R ↥M) := by
        rw [IsScalarTower.algebraMap_eq R F ↥M]
        exact (RingHom.injective (algebraMap F ↥M)).comp (IsFractionRing.injective R F)
      have hRL_inj : Function.Injective (algebraMap R L) := by
        rw [IsScalarTower.algebraMap_eq R F L]
        exact (RingHom.injective (algebraMap F L)).comp (IsFractionRing.injective R F)
      have : ExpChar ↥M p := expChar_of_injective_algebraMap hRM_inj p
      have : ExpChar L p := expChar_of_injective_algebraMap hRL_inj p
      have hTowerRML : IsScalarTower R ↥M L := by
        refine IsScalarTower.of_algebraMap_eq (fun r => ?_)
        rw [IsScalarTower.algebraMap_apply R F L r,
          IsScalarTower.algebraMap_apply F ↥M L (algebraMap R F r),
          ← IsScalarTower.algebraMap_apply R F ↥M r]
      let e : ℕ := IsPurelyInseparable.exponent ↥M L
      let Φ_R : R →+* R := iterateFrobenius R p e
      let Φ_LM : L →+* ↥M := IsPurelyInseparable.iterateFrobenius ↥M L p (le_refl e)
      have h_comm : (algebraMap R ↥M).comp Φ_R = Φ_LM.comp (algebraMap R L) := by
        ext r
        simp only [RingHom.comp_apply]
        rw [@IsScalarTower.algebraMap_apply R ↥M L _ _ _ _ _ _ hTowerRML r,
          IsPurelyInseparable.iterateFrobenius_algebraMap L p (le_refl e) (algebraMap R ↥M r),
          ← map_pow, iterateFrobenius_def]
      obtain ⟨m, u, hu⟩ := hSpan e
      have h_f_smul : ∀ (s : R) (c : Fin n → R), f_surj (s • c) = s • f_surj c :=
        f_surj.map_smul
      let instTw : Module R ↥(integralClosure R ↥M) :=
        Module.compHom ↥(integralClosure R ↥M) Φ_R
      let F_span :=
        @LinearMap.mk R R _ _ (RingHom.id R) (Fin m × Fin n → R) ↥(integralClosure R ↥M) _ _ _ instTw
          { toFun := fun α => f_surj (fun l => ∑ j : Fin m, Φ_R (α (j, l)) * u j)
            map_add' := fun α₁ α₂ => by
              have h_eq : (fun l => ∑ j : Fin m, Φ_R ((α₁ + α₂) (j, l)) * u j) =
                  (fun l => ∑ j : Fin m, Φ_R (α₁ (j, l)) * u j) +
                  (fun l => ∑ j : Fin m, Φ_R (α₂ (j, l)) * u j) := by
                ext l
                simp only [Pi.add_apply, map_add, right_distrib, Finset.sum_add_distrib]
              rw [h_eq, map_add] }
          (fun r α => by
            have h_eq : (fun l => ∑ j : Fin m, Φ_R ((r • α) (j, l)) * u j) =
                Φ_R r • (fun l => ∑ j : Fin m, Φ_R (α (j, l)) * u j) := by
              ext l
              simp only [Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc, Finset.mul_sum]
            exact (congrArg f_surj h_eq).trans
              (h_f_smul (Φ_R r) (fun l => ∑ j : Fin m, Φ_R (α (j, l)) * u j)))
      have hF_surj : Function.Surjective F_span := by
        intro w
        obtain ⟨c, rfl⟩ := hf_surj w
        choose q hq using fun l => hu (c l)
        refine ⟨fun idx => q idx.2 idx.1, ?_⟩
        change f_surj (fun l => ∑ j : Fin m, Φ_R (q l j) * u j) = f_surj c
        congr 1
        ext l
        simpa only [Φ_R, iterateFrobenius_def] using (hq l).symm
      have hFinTw : @Module.Finite R ↥(integralClosure R ↥M) _ _ instTw :=
        @Module.Finite.of_surjective R (Fin m × Fin n → R) _ _ _ R ↥(integralClosure R ↥M) _ _ instTw
          (RingHom.id R) inferInstance F_span hF_surj
      have hNoethTw : @IsNoetherian R ↥(integralClosure R ↥M) _ _ instTw :=
        @isNoetherian_of_isNoetherianRing_of_finite R ↥(integralClosure R ↥M) _ _ instTw _ hFinTw
      let ψ :=
        @LinearMap.mk R R _ _ (RingHom.id R) ↥(integralClosure R L) ↥(integralClosure R ↥M) _ _ _ instTw
          { toFun := fun z => ⟨Φ_LM z.1, _root_.IsIntegral.map_of_comp_eq Φ_R Φ_LM h_comm z.2⟩
            map_add' := fun z₁ z₂ => Subtype.ext (map_add Φ_LM z₁.1 z₂.1) }
          (fun r z => Subtype.ext (by
            change Φ_LM ((r • z : ↥(integralClosure R L)).1) =
              (Φ_R r • (⟨Φ_LM z.1, _⟩ : ↥(integralClosure R ↥M))).1
            have h1 : (r • z : ↥(integralClosure R L)).1 = algebraMap R L r * z.1 :=
              Algebra.smul_def r z.1
