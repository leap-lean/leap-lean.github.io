          (ℒ : CategoryTheory.Sheaf U₂.toScheme.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsConstructibleModPrimeSheaf ℓ X.left F →
        (∀ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ X.left) [AlgebraicGeometry.Etale w],
          Set.range w.base ⊆ (C : Set ↥X.left)ᶜ →
          Subsingleton ↥(F.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk w)))) →
        WeilIsEtaleSheafPullback iC_bad F F_bad₀ →
