                  (α₀.naturality v.op)
                dsimp [C_pre] at hnat
                have hv_w₁ : g₂.unop.obj.hom =
                    (v ≫ w₁) ≫ mkOpenEtaleHom E (O_a (sec_a g₁.unop)) := by
                  rw [← hv_comm, hw₁, CategoryTheory.Category.assoc]
                exact (hnat.symm.trans (hIndep (v ≫ w₁) w₂ hv_w₁ hw₂)).symm } }
      refine ⟨(hc.lift c_f) (ULift.up 1), fun a => ?_⟩
      have hj_a : S_f.arrows (mkOpenEtaleHom E (O_a a)) :=
        ⟨a, 𝟙 _, (CategoryTheory.Category.id_comp _).symm⟩
      let g_a := S_f.arrows.categoryMk (mkOpenEtaleHom E (O_a a)) hj_a
      have hfac_a := congrArg
        (fun (k : Z_grp ⟶ ℱ₀.obj.obj (Opposite.op (mkOpenEtale E (O_a a)))) => k (ULift.up 1))
        (hc.fac c_f (Opposite.op g_a))
      dsimp [c_f, g_a] at hfac_a
      rw [one_zsmul] at hfac_a
      obtain ⟨w_ga, hw_ga⟩ := hsec_w g_a
      exact hfac_a.trans (hIndep w_ga (𝟙 _) hw_ga (CategoryTheory.Category.id_comp _).symm)
    let ψ_fn : ∀ (E : Y.Etale),
        LocallyConstant ↥((Fgt Y).obj E).left ↥A_ℓ → ↥(ℱ₀.obj.obj (Opposite.op E)) :=
      fun E f => (hAmalg E f).choose
    have hψ_spec : ∀ (E : Y.Etale) (f : LocallyConstant ↥((Fgt Y).obj E).left ↥A_ℓ) (a : ↥A_ℓ),
        ℱ₀.obj.map (mkOpenEtaleHom E (fiberOpen E f a)).op (ψ_fn E f) =
          α₀.app (Opposite.op (mkOpenEtale E (fiberOpen E f a))) a :=
      fun E f a => (hAmalg E f).choose_spec a
    have hψ_const : ∀ (E : Y.Etale) (a₀ : ↥A_ℓ),
        ψ_fn E (LocallyConstant.const ↥((Fgt Y).obj E).left a₀) = α₀.app (Opposite.op E) a₀ := by
      intro E a₀
      let f₀ := LocallyConstant.const ↥((Fgt Y).obj E).left a₀
      refine hOpenCoverExt ℱ₀ E (fun _ : PUnit.{u + 1} => fiberOpen E f₀ a₀)
        (fun _ => ⟨PUnit.unit, rfl⟩) _ _ (fun _ => ?_)
      rw [hψ_spec E f₀ a₀]
      exact congrArg (fun (k : C_pre.obj (Opposite.op E) ⟶
        ℱ₀.obj.obj (Opposite.op (mkOpenEtale E (fiberOpen E f₀ a₀)))) => k a₀)
        (α₀.naturality (mkOpenEtaleHom E (fiberOpen E f₀ a₀)).op)
    have hψ_zero : ∀ (E : Y.Etale), ψ_fn E 0 = 0 := by
      intro E
      have h0 : (0 : LocallyConstant ↥((Fgt Y).obj E).left ↥A_ℓ) =
        LocallyConstant.const ↥((Fgt Y).obj E).left 0 := rfl
      rw [h0, hψ_const, map_zero]
    have hψ_add : ∀ (E : Y.Etale) (f₁ f₂ : LocallyConstant ↥((Fgt Y).obj E).left ↥A_ℓ),
        ψ_fn E (f₁ + f₂) = ψ_fn E f₁ + ψ_fn E f₂ := by
      intro E f₁ f₂
      let O_ab : ↥A_ℓ × ↥A_ℓ → ((Fgt Y).obj E).left.Opens :=
        fun p => fiberOpen E f₁ p.1 ⊓ fiberOpen E f₂ p.2
      refine hOpenCoverExt ℱ₀ E O_ab (fun z => ⟨(f₁ z, f₂ z), rfl, rfl⟩) _ _ (fun p => ?_)
      let E_ab := mkOpenEtale E (O_ab p)
      let j_ab := mkOpenEtaleHom E (O_ab p)
      let hom_le₁ : (O_ab p).toScheme ⟶ (fiberOpen E f₁ p.1).toScheme :=
        ((Fgt Y).obj E).left.homOfLE (inf_le_left : O_ab p ≤ fiberOpen E f₁ p.1)
      let hom_le₂ : (O_ab p).toScheme ⟶ (fiberOpen E f₂ p.2).toScheme :=
        ((Fgt Y).obj E).left.homOfLE (inf_le_right : O_ab p ≤ fiberOpen E f₂ p.2)
      have hle_sum : O_ab p ≤ fiberOpen E (f₁ + f₂) (p.1 + p.2) := by
        rintro z ⟨hz₁, hz₂⟩
        change f₁ z + f₂ z = p.1 + p.2
        rw [hz₁, hz₂]
      let hom_le₁₂ : (O_ab p).toScheme ⟶ (fiberOpen E (f₁ + f₂) (p.1 + p.2)).toScheme :=
        ((Fgt Y).obj E).left.homOfLE hle_sum
      let w₁ : E_ab ⟶ mkOpenEtale E (fiberOpen E f₁ p.1) :=
        mkEtaleHom hom_le₁
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            (congrArg (· ≫ ((Fgt Y).obj E).hom)
              (AlgebraicGeometry.Scheme.homOfLE_ι ((Fgt Y).obj E).left
                (inf_le_left : O_ab p ≤ fiberOpen E f₁ p.1))))
      let w₂ : E_ab ⟶ mkOpenEtale E (fiberOpen E f₂ p.2) :=
        mkEtaleHom hom_le₂
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            (congrArg (· ≫ ((Fgt Y).obj E).hom)
              (AlgebraicGeometry.Scheme.homOfLE_ι ((Fgt Y).obj E).left
                (inf_le_right : O_ab p ≤ fiberOpen E f₂ p.2))))
      let w₁₂ : E_ab ⟶ mkOpenEtale E (fiberOpen E (f₁ + f₂) (p.1 + p.2)) :=
        mkEtaleHom hom_le₁₂
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            (congrArg (· ≫ ((Fgt Y).obj E).hom)
              (AlgebraicGeometry.Scheme.homOfLE_ι ((Fgt Y).obj E).left hle_sum)))
      have hj₁ : j_ab = w₁ ≫ mkOpenEtaleHom E (fiberOpen E f₁ p.1) :=
        hEtaleExt _ _ (AlgebraicGeometry.Scheme.homOfLE_ι ((Fgt Y).obj E).left
          (inf_le_left : O_ab p ≤ fiberOpen E f₁ p.1)).symm
      have hj₂ : j_ab = w₂ ≫ mkOpenEtaleHom E (fiberOpen E f₂ p.2) :=
        hEtaleExt _ _ (AlgebraicGeometry.Scheme.homOfLE_ι ((Fgt Y).obj E).left
          (inf_le_right : O_ab p ≤ fiberOpen E f₂ p.2)).symm
      have hj₁₂ : j_ab = w₁₂ ≫ mkOpenEtaleHom E (fiberOpen E (f₁ + f₂) (p.1 + p.2)) :=
        hEtaleExt _ _ (AlgebraicGeometry.Scheme.homOfLE_ι ((Fgt Y).obj E).left hle_sum).symm
      have hr₁ : ℱ₀.obj.map j_ab.op (ψ_fn E f₁) = α₀.app (Opposite.op E_ab) p.1 := by
        rw [hj₁, op_comp, CategoryTheory.Functor.map_comp_apply, hψ_spec]
        exact (congrArg (fun (k : C_pre.obj _ ⟶ ℱ₀.obj.obj (Opposite.op E_ab)) => k p.1)
          (α₀.naturality w₁.op)).symm
      have hr₂ : ℱ₀.obj.map j_ab.op (ψ_fn E f₂) = α₀.app (Opposite.op E_ab) p.2 := by
        rw [hj₂, op_comp, CategoryTheory.Functor.map_comp_apply, hψ_spec]
        exact (congrArg (fun (k : C_pre.obj _ ⟶ ℱ₀.obj.obj (Opposite.op E_ab)) => k p.2)
          (α₀.naturality w₂.op)).symm
      have hr₁₂ : ℱ₀.obj.map j_ab.op (ψ_fn E (f₁ + f₂)) =
          α₀.app (Opposite.op E_ab) (p.1 + p.2) := by
        rw [hj₁₂, op_comp, CategoryTheory.Functor.map_comp_apply, hψ_spec]
        exact (congrArg (fun (k : C_pre.obj _ ⟶ ℱ₀.obj.obj (Opposite.op E_ab)) => k (p.1 + p.2))
          (α₀.naturality w₁₂.op)).symm
      rw [map_add, hr₁, hr₂, hr₁₂, map_add]
    let ψ_pre : P ⟶ ℱ₀.obj :=
      { app := fun E => AddCommGrpCat.ofHom
          { toFun := ψ_fn (Opposite.unop E)
            map_zero' := hψ_zero (Opposite.unop E)
            map_add' := hψ_add (Opposite.unop E) }
        naturality := fun {E₂ E₁} u => by
          ext f
          let u' : Opposite.unop E₁ ⟶ Opposite.unop E₂ := Opposite.unop u
          let f₁ : LocallyConstant ↥((Fgt Y).obj E₁.unop).left ↥A_ℓ := P.map u f
          change ψ_fn E₁.unop f₁ = ℱ₀.obj.map u'.op (ψ_fn E₂.unop f)
          refine hOpenCoverExt ℱ₀ E₁.unop (fiberOpen E₁.unop f₁)
            (fun z => ⟨f₁ z, rfl⟩) _ _ (fun a => ?_)
          rw [hψ_spec]
          let O₁ := fiberOpen E₁.unop f₁ a
          let O₂ := fiberOpen E₂.unop f a
          have hle_u : O₁ ≤ (TopologicalSpace.Opens.map (((Fgt Y).map u').left.base)).obj O₂ :=
            fun z hz => hz
          let w_a : mkOpenEtale E₁.unop O₁ ⟶ mkOpenEtale E₂.unop O₂ :=
            mkEtaleHom ((((Fgt Y).map u').left).resLE O₂ O₁ hle_u)
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ ((Fgt Y).obj E₂.unop).hom)
                  (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι _ hle_u)).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (O₁.ι ≫ ·) ((Fgt Y).map u').w))))
          have hj_comm : mkOpenEtaleHom E₁.unop O₁ ≫ u' = w_a ≫ mkOpenEtaleHom E₂.unop O₂ :=
            hEtaleExt _ _ (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι _ hle_u).symm
          rw [← CategoryTheory.Functor.map_comp_apply, ← op_comp, hj_comm, op_comp,
            CategoryTheory.Functor.map_comp_apply, hψ_spec]
          exact congrArg (fun (k : C_pre.obj _ ⟶ ℱ₀.obj.obj _) => k a) (α₀.naturality w_a.op) }
    let ψ : ℒ ⟶ ℱ₀ := CategoryTheory.ObjectProperty.homMk ψ_pre
    have hηψ : η₀ ≫ ψ.hom = α₀ := by
      ext E a₀
      exact hψ_const E.unop a₀
    have hφψ : φ ≫ ψ = 𝟙 ℱ₀ := by
      apply (adj_Y.homEquiv C_pre ℱ₀).injective
      rw [CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_id]
      refine Eq.trans ?_ (CategoryTheory.Category.comp_id α₀).symm
      change α₀ ≫ (φ.hom ≫ ψ.hom) = α₀
      rw [← CategoryTheory.Category.assoc, hαφ, hηψ]
    have hψφ : ψ ≫ φ = 𝟙 ℒ := by
      apply CategoryTheory.Sheaf.hom_ext
      refine CategoryTheory.NatTrans.ext (funext fun E =>
        AddCommGrpCat.ext fun f => LocallyConstant.ext fun z => ?_)
      let f' : LocallyConstant ↥((Fgt Y).obj E.unop).left ↥A_ℓ := f
      let a := f' z
      let O_a := fiberOpen E.unop f' a
      have hz : z ∈ Set.range ⇑O_a.ι := by
        rw [O_a.range_ι]
        exact rfl
      obtain ⟨x, hx⟩ := hz
      have hnat : (φ.hom.app (Opposite.op (mkOpenEtale E.unop O_a))
          (ℱ₀.obj.map (mkOpenEtaleHom E.unop O_a).op (ψ_fn E.unop f')) :
          LocallyConstant ↥((Fgt Y).obj (mkOpenEtale E.unop O_a)).left ↥A_ℓ) x =
          (φ.hom.app E (ψ_fn E.unop f') :
          LocallyConstant ↥((Fgt Y).obj E.unop).left ↥A_ℓ) (O_a.ι x) :=
        congrArg
          (fun (k : ℱ₀.obj.obj E ⟶ P.obj (Opposite.op (mkOpenEtale E.unop O_a))) =>
            (k (ψ_fn E.unop f') :
              LocallyConstant ↥((Fgt Y).obj (mkOpenEtale E.unop O_a)).left ↥A_ℓ) x)
          (φ.hom.naturality (mkOpenEtaleHom E.unop O_a).op)
      rw [hx] at hnat
      change (φ.hom.app E (ψ_fn E.unop f') :
        LocallyConstant ↥((Fgt Y).obj E.unop).left ↥A_ℓ) z = a
      rw [← hnat, hψ_spec]
      exact congrArg
        (fun (k : C_pre ⟶ P) =>
          (k.app (Opposite.op (mkOpenEtale E.unop O_a)) a :
            LocallyConstant ↥((Fgt Y).obj (mkOpenEtale E.unop O_a)).left ↥A_ℓ) x) hαφ
    exact ⟨{ hom := φ, inv := ψ, hom_inv_id := hφψ, inv_hom_id := hψφ }⟩

  
  have hSuppRange : ∀ (E : TopologicalSpace.Closeds ↥Z),
      let I_E := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal E
      I_E.support = E ∧ Set.range ⇑I_E.subschemeι = (E : Set ↥Z) := by
    intro E
    let I_E := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal E
    have hSupp : I_E.support = E :=
      SetLike.ext' (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal E)
    refine ⟨hSupp, ?_⟩
    rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι, hSupp]

  have hLiftLE : ∀ {E₁ E₂ : TopologicalSpace.Closeds ↥Z}, E₁ ≤ E₂ →
      let I₁ := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal E₁
      let I₂ := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal E₂
      ∃ (u : I₁.subscheme ⟶ I₂.subscheme), u ≫ I₂.subschemeι = I₁.subschemeι := by
    intro E₁ E₂ hLE
    let I₁ := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal E₁
    let I₂ := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal E₂
    have hI : I₂ ≤ I₁ := by
      rw [← AlgebraicGeometry.Scheme.IdealSheafData.le_support_iff_le_vanishingIdeal,
        (hSuppRange E₂).1]
      exact hLE
    have hKer : I₂.subschemeι.ker ≤ I₁.subschemeι.ker := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι,
        AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι]
      exact hI
    exact ⟨AlgebraicGeometry.IsClosedImmersion.lift I₂.subschemeι I₁.subschemeι hKer,
      AlgebraicGeometry.IsClosedImmersion.lift_fac I₂.subschemeι I₁.subschemeι hKer⟩

  have hPullbackClosedRange : ∀ {W' W : AlgebraicGeometry.Scheme.{u}} (u : W' ⟶ W)
      [AlgebraicGeometry.IsClosedImmersion u] (E : W.Etale),
      let p_u : ((Fgt W').obj ((weilCompEtaleSitePullback u).obj E)).left ⟶ ((Fgt W).obj E).left :=
        CategoryTheory.Limits.pullback.fst ((Fgt W).obj E).hom u
      Topology.IsClosedEmbedding ⇑p_u ∧
      Set.range ⇑p_u = ⇑((Fgt W).obj E).hom ⁻¹' (Set.range ⇑u) := by
    intro W' W u _ E
    let p_u : CategoryTheory.Limits.pullback ((Fgt W).obj E).hom u ⟶ ((Fgt W).obj E).left :=
      CategoryTheory.Limits.pullback.fst ((Fgt W).obj E).hom u
    have : AlgebraicGeometry.IsClosedImmersion p_u := inferInstance
    refine ⟨AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding p_u, ?_⟩
    ext y
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨w, rfl⟩
      have hcond : (p_u ≫ ((Fgt W).obj E).hom) w =
          (CategoryTheory.Limits.pullback.snd ((Fgt W).obj E).hom u ≫ u) w :=
        congrArg (fun (k : _ ⟶ W) => k w) CategoryTheory.Limits.pullback.condition
      exact ⟨(CategoryTheory.Limits.pullback.snd ((Fgt W).obj E).hom u) w, hcond.symm⟩
    · rintro ⟨x, hx⟩
      obtain ⟨w, hw, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y x hx.symm
      exact ⟨w, hw⟩

  refine ⟨?_, ?_⟩
  · 
    let I_top := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal
      (⊤ : TopologicalSpace.Closeds ↥Z)
    let W_top := I_top.subscheme
    let i_top := I_top.subschemeι
    have : (weilCompEtaleSitePullback i_top).IsContinuous Z.smallEtaleTopology W_top.smallEtaleTopology :=
      hc_all i_top
    let pf_top := (weilCompEtaleSitePullback i_top).sheafPushforwardContinuous
      AddCommGrpCat.{u} Z.smallEtaleTopology W_top.smallEtaleTopology
    obtain ⟨hSh_Z, ⟨e_Z⟩⟩ := hLocConstSheaf Z
    obtain ⟨hSh_top, ⟨e_top⟩⟩ := hLocConstSheaf W_top
    obtain ⟨e_R0_top⟩ := hR0Iso i_top (weilEtaleTorsionSheaf W_top ℓ)
    let ℒ_Z : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨locPresheaf Z, hSh_Z⟩
    let ℒ_top : CategoryTheory.Sheaf W_top.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨locPresheaf W_top, hSh_top⟩
    have hRange_top : Set.range ⇑i_top = Set.univ := (hSuppRange ⊤).2
    let τ_pre : locPresheaf Z ⟶ (pf_top.obj ℒ_top).obj :=
      { app := fun E =>
          let p_E : ((Fgt W_top).obj ((weilCompEtaleSitePullback i_top).obj E.unop)).left ⟶
              ((Fgt Z).obj E.unop).left :=
            CategoryTheory.Limits.pullback.fst ((Fgt Z).obj E.unop).hom i_top
          AddCommGrpCat.ofHom
            (LocallyConstant.comapAddMonoidHom ⟨⇑p_E, p_E.continuous⟩)
        naturality := fun {E₁ E₂} g =>
          AddCommGrpCat.ext fun f => LocallyConstant.ext fun w =>
            congrArg f (congrArg
              (fun (k : _ ⟶ ((Fgt Z).obj E₁.unop).left) => k w)
              (hB_fst i_top g.unop)).symm }
    have : ∀ E : Opposite Z.Etale, CategoryTheory.IsIso (τ_pre.app E) := by
      intro E
      let p_E : ((Fgt W_top).obj ((weilCompEtaleSitePullback i_top).obj E.unop)).left ⟶
          ((Fgt Z).obj E.unop).left :=
        CategoryTheory.Limits.pullback.fst ((Fgt Z).obj E.unop).hom i_top
      obtain ⟨hEmb, hRng⟩ := hPullbackClosedRange i_top E.unop
      rw [hRange_top, Set.preimage_univ] at hRng
      have hBij : Function.Bijective ⇑p_E :=
        ⟨hEmb.toIsEmbedding.injective, Set.range_eq_univ.mp hRng⟩
      let eqv := Equiv.ofBijective ⇑p_E hBij
      have hContSymm : Continuous eqv.symm := by
        rw [continuous_iff_isClosed]
        intro K hK
        have hEqSet : eqv.symm ⁻¹' K = ⇑p_E '' K := by
          ext y
          simp only [Set.mem_preimage, Set.mem_image]
          constructor
          · intro hy
            exact ⟨eqv.symm y, hy, eqv.apply_symm_apply y⟩
          · rintro ⟨w, hw, rfl⟩
            change eqv.symm (eqv w) ∈ K
            rwa [eqv.symm_apply_apply]
        rw [hEqSet]
        exact hEmb.isClosedMap K hK
      let inv_app : (pf_top.obj ℒ_top).obj.obj E ⟶ (locPresheaf Z).obj E :=
        AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom ⟨eqv.symm, hContSymm⟩)
      refine ⟨⟨inv_app, ?_, ?_⟩⟩
      · exact AddCommGrpCat.ext fun f => LocallyConstant.ext fun y =>
          congrArg f (eqv.apply_symm_apply y)
      · refine AddCommGrpCat.ext fun g => LocallyConstant.ext fun w => ?_
        let g' : LocallyConstant
            ↥((Fgt W_top).obj ((weilCompEtaleSitePullback i_top).obj E.unop)).left ↥A_ℓ := g
        change g' (eqv.symm (eqv w)) = g' w
        exact congrArg g' (eqv.symm_apply_apply w)
    have hIso_pre : CategoryTheory.IsIso τ_pre :=
      CategoryTheory.NatIso.isIso_of_isIso_app τ_pre
    let τ_sh : ℒ_Z ⟶ pf_top.obj ℒ_top := CategoryTheory.ObjectProperty.homMk τ_pre
    have : CategoryTheory.IsIso
        ((CategoryTheory.sheafToPresheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map τ_sh) :=
      hIso_pre
    have : CategoryTheory.IsIso τ_sh :=
      CategoryTheory.isIso_of_reflects_iso τ_sh
        (CategoryTheory.sheafToPresheaf Z.smallEtaleTopology AddCommGrpCat.{u})
    exact ⟨e_Z ≪≫ CategoryTheory.asIso τ_sh ≪≫ pf_top.mapIso e_top.symm ≪≫ e_R0_top.symm⟩

  · 
    intro D D₁ D₂ hEq W_D i_D W₁ i₁ W₂ i₂ W₁₂ i₁₂
    obtain ⟨u₁, hu₁⟩ := hLiftLE (hEq ▸ le_sup_left : D₁ ≤ D)
    obtain ⟨u₂, hu₂⟩ := hLiftLE (hEq ▸ le_sup_right : D₂ ≤ D)
    obtain ⟨v₁, hv₁'⟩ := hLiftLE (inf_le_left : D₁ ⊓ D₂ ≤ D₁)
    obtain ⟨v₂, hv₂'⟩ := hLiftLE (inf_le_right : D₁ ⊓ D₂ ≤ D₂)
