    obtain ⟨y₀⟩ := ‹Nonempty ↥Y›
    obtain ⟨W, hW, hy₀, -⟩ := exists_isAffineOpen_mem_and_subset (TopologicalSpace.Opens.mem_top y₀)
    let B_cat : CommRingCat.{u} := Y.presheaf.obj (Opposite.op W)
    let B : Type u := ↑B_cat
    have hle_W : W ≤ (TopologicalSpace.Opens.map f.base).obj ⊤ := fun _ _ => trivial
