  have hVgood_coe : (V_good : Set ↥Y₀) = ⋃ c : Fin r, (V_comp c : Set ↥Y₀) :=
    TopologicalSpace.Opens.coe_iSup V_comp

  have hRange_c : ∀ c : Fin r,
      Set.range (g c).base ∩ (V_good : Set ↥Y₀) ⊆ (V_comp c : Set ↥Y₀) := by
    intro c y ⟨⟨x₀, hx₀⟩, hy_good⟩
    rw [hVgood_coe, Set.mem_iUnion] at hy_good
    rcases hy_good with ⟨c', hc'⟩
    by_cases h_eq : c = c'
    · subst h_eq; exact hc'
    · exfalso
      have hy_Z : y ∈ Set.range (ι_Z c).base :=
        ⟨(ν c).base x₀, ((Scheme.Hom.comp_apply (ν c) (ι_Z c) x₀).symm).trans hx₀⟩
      exact Set.disjoint_left.mp (hDisj c c' h_eq) hy_Z hc'

  have hV_disj : ∀ c₁ c₂ : Fin r, c₁ ≠ c₂ →
      Disjoint (V_comp c₁ : Set ↥Y₀) (V_comp c₂ : Set ↥Y₀) := by
    intro c₁ c₂ hne
    rw [Set.disjoint_left]
    intro y hy₁
    have : Surjective ((ι_Z c₁) ∣_ (V_comp c₁)) := (hComp c₁).2.2.1
    obtain ⟨z₁, hz₁⟩ := AlgebraicGeometry.Scheme.Hom.surjective
      ((ι_Z c₁) ∣_ (V_comp c₁)) ⟨y, hy₁⟩
    have hy_Z₁ : y ∈ Set.range (ι_Z c₁).base := by
      refine ⟨z₁.1, ?_⟩
      have hι := congrArg (fun k => k.base z₁)
        (AlgebraicGeometry.morphismRestrict_ι (ι_Z c₁) (V_comp c₁))
      exact hι.symm.trans (congrArg Subtype.val hz₁)
    exact Set.disjoint_left.mp (hDisj c₁ c₂ hne) hy_Z₁

  have hBC_c : ∀ (c : Fin r) (U : Y₀.Etale),
