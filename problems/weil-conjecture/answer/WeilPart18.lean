          CategoryTheory.Adjunction.homEquiv_unit]
        let u_T₂ : (C₂.obj A).obj.obj (Opposite.op T₂) ⟶
            (C₂.obj A).obj.obj (Opposite.op (Φ_h.obj (B_h.obj T₂))) :=
          (adj_sh.unit.app (C₂.obj A)).hom.app (Opposite.op T₂)
        change adj₂.unit.app A ≫ (ψ₀_T₂ ≫ θ_BT₂) = adj₂.unit.app A ≫ u_T₂
        have hnatθ : (C₁.obj A).obj.map v₂₁.op ≫ θ_BT₂ =
            θ_T₁ ≫ (C₂.obj A).obj.map (Φ_h.map v₂₁).op :=
          θ.hom.naturality v₂₁.op
        have hUnitApp : u_T₂ = (C₂.obj A).obj.map (adj_site.counit.app T₂).op := rfl
        have hTermEq₂ : Φ_h.map v₂₁ ≫ u₁₂ = adj_site.counit.app T₂ :=
          hT₂.hom_ext _ _
