              (↑(S.presheaf.obj (Opposite.op U.1)) ⧸ I₀.ideal U))) := by
        intro U
        have hRadU : (I₀.ideal U).IsRadical := by
          intro a ha
          have ha' : a ∈ I₀.radical.ideal U := by
            rwa [AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal]
          rwa [hRadEq] at ha'
        rw [AlgebraicGeometry.affine_isReduced_iff]
        exact (Ideal.isRadical_iff_quotient_reduced (I₀.ideal U)).mp hRadU
      have : ∀ (idx : I₀.subschemeCover.openCover.I₀),
          AlgebraicGeometry.IsReduced (I₀.subschemeCover.openCover.X idx) :=
        fun U => hRedChart U
      have : AlgebraicGeometry.IsReduced Z₀ :=
        AlgebraicGeometry.IsReduced.of_openCover Z₀ I₀.subschemeCover.openCover
      exact (AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced Z₀).mpr
        ⟨inferInstance, inferInstance⟩
    refine ⟨hIntZ₀, fun U₀ ⟨⟨u, hu⟩⟩ z₀ hz₀ => ?_⟩
    by_contra hz_not
    let K : Set ↥S := ⇑i₀.base '' ((U₀ : Set ↥Z₀)ᶜ)
    have hK_closed : IsClosed K := hEmb.isClosedMap _ U₀.isOpen.isClosed_compl
    have hx₀K : x₀ ∈ K := ⟨z₀, hz_not, hz₀⟩
    have hClosSub : (D₀ : Set ↥S) ⊆ K :=
      closure_minimal (Set.singleton_subset_iff.mpr hx₀K) hK_closed
    have huD : i₀.base u ∈ (D₀ : Set ↥S) := hRange ▸ ⟨u, rfl⟩
    obtain ⟨y, hy_compl, hy_eq⟩ := hClosSub huD
    exact hy_compl (hEmb.toIsEmbedding.injective hy_eq ▸ hu)
