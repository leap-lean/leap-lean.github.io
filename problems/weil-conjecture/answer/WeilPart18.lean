        dsimp [δ₅, w_bar, Q_h] at h0 ⊢
        rw [if_pos hg, map_sub, map_pow, map_sum] at h0
        have h1 : ν_h ((1 : R₀) ⊗ₜ[R] g) = q_h ((1 : R_h) ⊗ₜ[R] g) := by
          change q_h (μ_h ((1 : R₀) ⊗ₜ[R] g)) = _
          rw [Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply]
        rw [h1] at h0
        have hsum_eq : ∑ i : I, ν_h (w₀ i * Polynomial.aeval (a₀ i) (Q₀ i g)) =
