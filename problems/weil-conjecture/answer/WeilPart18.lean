      isClosed_fromSpec_of_isMaximal C_c.left C_c.hom W_aff hW_aff_is P₁_pt h𝔪₁_max
    have hy_cl : IsClosed ({g_c.base P_c} : Set ↥Y₀) := by
      have := g_c.isClosedMap ({P_c} : Set ↥C_c.left) hP_cl
      rwa [Set.image_singleton] at this
    have hPre_Pc : g_c.base ⁻¹' {g_c.base P_c} = {P_c} := by
      ext Q
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hQ
        let W_Zc : Z_c.Opens := (TopologicalSpace.Opens.map ι_c.base).obj V_c
        have hν_eq : ν_c.base Q = ν_c.base P_c := ι_c.isClosedEmbedding.injective hQ
        have hPc_WZc : ν_c.base P_c ∈ W_Zc := hP_Vc
        have hQ_WZc : ν_c.base Q ∈ W_Zc := hν_eq.symm ▸ hPc_WZc
        let f_res := ν_c ∣_ W_Zc
        have _ : CategoryTheory.IsIso f_res := hIso_ν
        have hf_eq : f_res.base ⟨Q, hQ_WZc⟩ = f_res.base ⟨P_c, hPc_WZc⟩ := by
          apply Subtype.ext
          change (f_res ≫ W_Zc.ι).base ⟨Q, hQ_WZc⟩ = (f_res ≫ W_Zc.ι).base ⟨P_c, hPc_WZc⟩
          rw [AlgebraicGeometry.morphismRestrict_ι]
          exact hν_eq
        have hQP' : (⟨Q, hQ_WZc⟩ : ↥(ν_c ⁻¹ᵁ W_Zc).toScheme) = ⟨P_c, hPc_WZc⟩ := by
          have h1 : (CategoryTheory.inv f_res).base (f_res.base ⟨Q, hQ_WZc⟩) =
              (CategoryTheory.inv f_res).base (f_res.base ⟨P_c, hPc_WZc⟩) :=
            congrArg (CategoryTheory.inv f_res).base hf_eq
          change (f_res ≫ CategoryTheory.inv f_res).base ⟨Q, hQ_WZc⟩ =
            (f_res ≫ CategoryTheory.inv f_res).base ⟨P_c, hPc_WZc⟩ at h1
          rwa [CategoryTheory.IsIso.hom_inv_id] at h1
        exact congrArg Subtype.val hQP'
      · rintro rfl; rfl
    obtain ⟨U_k, _, V, hV_aff, hP_V, hV_le, hStd_V⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 C_c.hom).mp inferInstance P_c
    let R₀_cat : CommRingCat.{u} :=
      (AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U_k)
    let R₀ : Type u := ↑R₀_cat
    let R_cat : CommRingCat.{u} := C_c.left.presheaf.obj (Opposite.op V)
    let R : Type u := ↑R_cat
    have _ : IsDomain R := isDomain_section_of_isIntegral C_c.left V hV_aff P_c hP_V
    let f_V : R₀ →+* R := (C_c.hom.appLE U_k V hV_le).hom
    let P₁_R₀ : Type u := MvPolynomial (Fin 1) R₀
    obtain ⟨ψ_et : P₁_R₀ →+* R, hψ_C, hψ_etale⟩ := hStd_V.exists_etale_mvPolynomial
    let _ : Algebra P₁_R₀ R := ψ_et.toAlgebra
    have _ : Algebra.Etale P₁_R₀ R := hψ_etale
    have _ : Subsingleton Ω[R⁄P₁_R₀] :=
      Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
    have hUk_top : U_k = ⊤ := by
      ext z
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      have hz1 : z.asIdeal.IsPrime := z.isPrime
      have hz2 : (C_c.hom.base P_c).asIdeal.IsPrime := (C_c.hom.base P_c).isPrime
      have hz_eq : z = C_c.hom.base P_c :=
        PrimeSpectrum.ext ((Ideal.eq_bot_of_prime z.asIdeal).trans
          (Ideal.eq_bot_of_prime (C_c.hom.base P_c).asIdeal).symm)
      rw [hz_eq]
      exact hV_le hP_V
    let e_k₀ : CommRingCat.of k ≅ R₀_cat :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm ≪≫
        (AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.mapIso
          (eqToIso (by rw [hUk_top])).op
    let φ_kV : k →+* R := f_V.comp e_k₀.hom.hom
    have he_surj : Function.Surjective e_k₀.hom.hom := by
      intro r₀
      refine ⟨e_k₀.inv.hom r₀, ?_⟩
      change (e_k₀.inv ≫ e_k₀.hom).hom r₀ = r₀
      rw [e_k₀.inv_hom_id]
      rfl
    have hψ_FT : ψ_et.FiniteType := (inferInstance : Algebra.FiniteType P₁_R₀ R)
    have hC_FT : (MvPolynomial.C : R₀ →+* P₁_R₀).FiniteType := by
      have hAlg : (MvPolynomial.C : R₀ →+* P₁_R₀).toAlgebra =
          (inferInstance : Algebra R₀ P₁_R₀) :=
        Algebra.algebra_ext _ _ fun _ => rfl
      change @Algebra.FiniteType R₀ P₁_R₀ _ _ (MvPolynomial.C : R₀ →+* P₁_R₀).toAlgebra
      rw [hAlg]
      infer_instance
    have hfV_FT : f_V.FiniteType := by
      have hcomp_eq : ψ_et.comp MvPolynomial.C = f_V := hψ_C
      rw [← hcomp_eq]
      exact hψ_FT.comp hC_FT
    have hφ_FT : φ_kV.FiniteType := hfV_FT.comp (RingHom.FiniteType.of_surjective _ he_surj)
    let _ : Algebra k R := φ_kV.toAlgebra
    have _ : Algebra.FiniteType k R := hφ_FT
    have _ : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing k R
    let p_Pc : ↥(AlgebraicGeometry.Spec Γ(C_c.left, V)) := hV_aff.primeIdealOf ⟨P_c, hP_V⟩
    let 𝔪 : Ideal R := p_Pc.asIdeal
    have _ : 𝔪.IsMaximal := by
      rw [← PrimeSpectrum.isClosed_singleton_iff_isMaximal (p_Pc : PrimeSpectrum R)]
      have hpre_singleton : hV_aff.fromSpec.base ⁻¹' ({P_c} : Set ↥C_c.left) = {p_Pc} := by
        ext q
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro hq
          have hp_eq : hV_aff.fromSpec.base p_Pc = P_c :=
            hV_aff.fromSpec_primeIdealOf ⟨P_c, hP_V⟩
          exact hV_aff.fromSpec.isOpenEmbedding.injective (hq.trans hp_eq.symm)
        · rintro rfl
          exact hV_aff.fromSpec_primeIdealOf ⟨P_c, hP_V⟩
      change IsClosed ({p_Pc} : Set ↥(AlgebraicGeometry.Spec Γ(C_c.left, V)))
      rw [← hpre_singleton]
      exact hP_cl.preimage hV_aff.fromSpec.base.hom.continuous
    obtain ⟨τ_V, hker_τV⟩ := exists_algClosed_eval_of_isMaximal 𝔪
    let π_R : R →+* R := φ_kV.comp τ_V.toRingHom
    have h_sub_mem : ∀ r : R, r - π_R r ∈ 𝔪 := by
      intro r
      rw [← hker_τV]
      change τ_V (r - algebraMap k R (τ_V r)) = 0
      rw [map_sub, τ_V.commutes]
      simp
    have hπ_fV : ∀ r₀ : R₀, π_R (f_V r₀) = f_V r₀ := by
      intro r₀
      have hr₀ : e_k₀.hom.hom (e_k₀.inv.hom r₀) = r₀ := by
        change (e_k₀.inv ≫ e_k₀.hom).hom r₀ = r₀
        rw [e_k₀.inv_hom_id]
        rfl
      have hf_eq : f_V r₀ = φ_kV (e_k₀.inv.hom r₀) := by
        change f_V r₀ = f_V (e_k₀.hom.hom (e_k₀.inv.hom r₀))
        rw [hr₀]
      rw [hf_eq]
      change φ_kV (τ_V (algebraMap k R (e_k₀.inv.hom r₀))) = _
      rw [τ_V.commutes]
      simp
    let t : R := ψ_et (MvPolynomial.X 0) - π_R (ψ_et (MvPolynomial.X 0))
    have ht_mem : t ∈ 𝔪 := h_sub_mem (ψ_et (MvPolynomial.X 0))
    let M_cot := 𝔪.Cotangent
    let t_bar : M_cot := 𝔪.toCotangent ⟨t, ht_mem⟩
    let S_t : Submodule R M_cot := Submodule.span R {t_bar}
    let N_cot : Type u := M_cot ⧸ S_t
    let _ : Module P₁_R₀ N_cot := Module.compHom N_cot ψ_et
    have hST_cot : IsScalarTower P₁_R₀ R N_cot :=
      IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    let δ₀ : R → M_cot := fun r => 𝔪.toCotangent ⟨r - π_R r, h_sub_mem r⟩
    have hδ₀_add : ∀ r₁ r₂ : R, δ₀ (r₁ + r₂) = δ₀ r₁ + δ₀ r₂ := by
      intro r₁ r₂
      dsimp [δ₀]
      rw [← map_add]
      congr 1
      apply Subtype.ext
      change (r₁ + r₂) - π_R (r₁ + r₂) = (r₁ - π_R r₁) + (r₂ - π_R r₂)
      rw [map_add]
      ring
    have h_smul_cot : ∀ (a : R) (b : R) (hb : b ∈ 𝔪),
        a • 𝔪.toCotangent ⟨b, hb⟩ = 𝔪.toCotangent ⟨π_R a * b, 𝔪.mul_mem_left _ hb⟩ := by
      intro a b hb
      have hdiff : a • 𝔪.toCotangent ⟨b, hb⟩ -
          𝔪.toCotangent ⟨π_R a * b, 𝔪.mul_mem_left _ hb⟩ = 0 := by
        rw [← map_smul, ← map_sub, Ideal.toCotangent_eq_zero]
        change a * b - π_R a * b ∈ 𝔪 ^ 2
        have heq : a * b - π_R a * b = (a - π_R a) * b := by ring
        rw [heq, sq]
        exact Ideal.mul_mem_mul (h_sub_mem a) hb
      exact sub_eq_zero.mp hdiff
    have hδ₀_mul : ∀ r₁ r₂ : R, δ₀ (r₁ * r₂) = r₁ • δ₀ r₂ + r₂ • δ₀ r₁ := by
      intro r₁ r₂
      dsimp [δ₀]
      rw [h_smul_cot r₁ _ _, h_smul_cot r₂ _ _, ← map_add]
      apply sub_eq_zero.mp
      rw [← map_sub, Ideal.toCotangent_eq_zero]
      change (r₁ * r₂ - π_R (r₁ * r₂)) -
          (π_R r₁ * (r₂ - π_R r₂) + π_R r₂ * (r₁ - π_R r₁)) ∈ 𝔪 ^ 2
      have heq : (r₁ * r₂ - π_R (r₁ * r₂)) -
          (π_R r₁ * (r₂ - π_R r₂) + π_R r₂ * (r₁ - π_R r₁)) =
          (r₁ - π_R r₁) * (r₂ - π_R r₂) := by
        rw [map_mul]
        ring
      rw [heq, sq]
      exact Ideal.mul_mem_mul (h_sub_mem r₁) (h_sub_mem r₂)
    let d_fun : R → N_cot := fun r => Submodule.Quotient.mk (δ₀ r)
    have hd_add : ∀ r₁ r₂ : R, d_fun (r₁ + r₂) = d_fun r₁ + d_fun r₂ := by
      intro r₁ r₂
      dsimp [d_fun]
      rw [hδ₀_add, Submodule.Quotient.mk_add]
    have hd_mul : ∀ r₁ r₂ : R, d_fun (r₁ * r₂) = r₁ • d_fun r₂ + r₂ • d_fun r₁ := by
      intro r₁ r₂
      dsimp [d_fun]
      rw [hδ₀_mul, Submodule.Quotient.mk_add, Submodule.Quotient.mk_smul,
        Submodule.Quotient.mk_smul]
    have hd_P₁ : ∀ P : P₁_R₀, d_fun (ψ_et P) = 0 := by
      intro P
      induction P using MvPolynomial.induction_on with
      | C r₀ =>
        have hC : ψ_et (MvPolynomial.C r₀) = f_V r₀ :=
          congrArg (fun g : R₀ →+* R => g r₀) hψ_C
        rw [hC]
        dsimp [d_fun, δ₀]
        have h0 : (⟨f_V r₀ - π_R (f_V r₀), h_sub_mem (f_V r₀)⟩ : ↥𝔪) = 0 := by
          apply Subtype.ext
          change f_V r₀ - π_R (f_V r₀) = 0
          rw [hπ_fV, sub_self]
        rw [h0, map_zero, Submodule.Quotient.mk_zero]
      | add p q hp hq =>
        rw [map_add, hd_add, hp, hq, add_zero]
      | mul_X p i hp =>
        have hi : i = 0 := Fin.eq_zero i
        subst hi
        rw [map_mul, hd_mul, hp, smul_zero, add_zero]
        have hX0 : d_fun (ψ_et (MvPolynomial.X 0)) = 0 := by
          dsimp [d_fun, δ₀]
          exact (Submodule.Quotient.mk_eq_zero S_t).mpr (Submodule.subset_span rfl)
        rw [hX0, smul_zero]
    let d_der : Derivation P₁_R₀ R N_cot :=
      { toFun := d_fun
        map_add' := hd_add
        map_smul' := fun p r => by
          change d_fun (ψ_et p * r) = ψ_et p • d_fun r
          rw [hd_mul, hd_P₁ p, smul_zero, add_zero]
        map_one_eq_zero' := by
          simpa using hd_P₁ 1
        leibniz' := fun a b => hd_mul a b }
    have hd_zero : ∀ r : R, d_der r = 0 := by
      intro r
      have h_lift : d_der r =
          (@Derivation.liftKaehlerDifferential P₁_R₀ R _ _ _ N_cot _ _ _ hST_cot d_der)
            (KaehlerDifferential.D P₁_R₀ R r) :=
        congrArg (fun D : Derivation P₁_R₀ R N_cot => D r)
          (@Derivation.liftKaehlerDifferential_comp P₁_R₀ R _ _ _ N_cot _ _ _ hST_cot d_der).symm
      rw [h_lift, Subsingleton.elim (KaehlerDifferential.D P₁_R₀ R r) 0, map_zero]
    have h𝔪_span_mod_sq : 𝔪 ≤ Ideal.span {t} ⊔ 𝔪 ^ 2 := by
      intro x hx
      have hx_ker : τ_V x = 0 := by
        change x ∈ RingHom.ker τ_V.toRingHom
        rwa [hker_τV]
      have hπ_x : π_R x = 0 := by
        dsimp [π_R]
        rw [RingHom.comp_apply]
        change φ_kV (τ_V x) = 0
        rw [hx_ker, map_zero]
      have hd_x : d_fun x = 0 := hd_zero x
      have hmk_eq : δ₀ x = 𝔪.toCotangent ⟨x, hx⟩ := by
        dsimp [δ₀]
        congr 1
        apply Subtype.ext
        change x - π_R x = x
        rw [hπ_x, sub_zero]
      have hmem_St : 𝔪.toCotangent ⟨x, hx⟩ ∈ S_t := by
        rw [← hmk_eq]
        exact (Submodule.Quotient.mk_eq_zero S_t).mp hd_x
      obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hmem_St
      have hr_sub : 𝔪.toCotangent ⟨x, hx⟩ - r • t_bar = 0 := sub_eq_zero.mpr hr.symm
      rw [← map_smul, ← map_sub, Ideal.toCotangent_eq_zero] at hr_sub
      change x - r * t ∈ 𝔪 ^ 2 at hr_sub
      have hx_eq : x = r * t + (x - r * t) := by ring
      rw [hx_eq]
      exact Ideal.add_mem _
        (Ideal.mem_sup_left (Ideal.mem_span_singleton.mpr ⟨r, mul_comm r t⟩))
        (Ideal.mem_sup_right hr_sub)
    let S : Type u := ↑(C_c.left.presheaf.stalk P_c)
    let _ : Algebra R S := (C_c.left.presheaf.germ V P_c hP_V).hom.toAlgebra
    have _ : IsLocalization.AtPrime S 𝔪 := hV_aff.isLocalization_stalk ⟨P_c, hP_V⟩
    have _ : IsNoetherianRing S := IsLocalization.isNoetherianRing 𝔪.primeCompl S inferInstance
    let 𝔪_S : Ideal S := IsLocalRing.maximalIdeal S
    have hmap_𝔪 : Ideal.map (algebraMap R S) 𝔪 = 𝔪_S :=
      IsLocalization.AtPrime.map_eq_maximalIdeal 𝔪 S
    let t_S : S := algebraMap R S t
    have ht_S_mem : t_S ∈ 𝔪_S := by
      rw [← hmap_𝔪]
      exact Ideal.mem_map_of_mem _ ht_mem
    have h𝔪S_le : 𝔪_S ≤ Ideal.span {t_S} ⊔ 𝔪_S ^ 2 := by
      rw [← hmap_𝔪]
      refine (Ideal.map_mono h𝔪_span_mod_sq).trans ?_
      rw [Ideal.map_sup, Ideal.map_span, Set.image_singleton, Ideal.map_pow]
    have h𝔪S_jac : 𝔪_S ≤ (⊥ : Ideal S).jacobson := by
      rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
    have h𝔪S_eq_span : 𝔪_S = Ideal.span {t_S} := by
      apply le_antisymm
      · let I_t : Ideal S := Ideal.span {t_S}
        let Q_t := S ⧸ I_t
        let N_Q : Submodule S Q_t := Submodule.map I_t.mkQ 𝔪_S
        have hFG_NQ : N_Q.FG := IsNoetherian.noetherian N_Q
        have hle_NQ : N_Q ≤ 𝔪_S • N_Q := by
          rintro _ ⟨z, hz, rfl⟩
          have hz2 : z ∈ I_t ⊔ 𝔪_S • 𝔪_S := by
            rw [smul_eq_mul, ← sq]
            exact h𝔪S_le hz
          rw [Submodule.mem_sup] at hz2
          obtain ⟨u_t, hu_t, v_m, hv_m, rfl⟩ := hz2
          rw [map_add, Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero I_t).mpr hu_t, zero_add]
          have hmap_smul : Submodule.map I_t.mkQ (𝔪_S • 𝔪_S) = 𝔪_S • N_Q :=
            Submodule.map_smul'' 𝔪_S 𝔪_S I_t.mkQ
          rw [← hmap_smul]
          exact ⟨v_m, hv_m, rfl⟩
        have hNQ_bot : N_Q = ⊥ :=
          Submodule.eq_bot_of_le_smul_of_le_jacobson_bot 𝔪_S N_Q hFG_NQ hle_NQ h𝔪S_jac
        intro z hz
        have hmk0 : I_t.mkQ z = 0 := by
          have : I_t.mkQ z ∈ N_Q := ⟨z, hz, rfl⟩
          rwa [hNQ_bot, Submodule.mem_bot] at this
        rw [Submodule.mkQ_apply] at hmk0
        exact (Submodule.Quotient.mk_eq_zero I_t).mp hmk0
      · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ht_S_mem)
    have ht_S_not_sq : t_S ∉ 𝔪_S ^ 2 := by
      intro hsq
      have hle_self : 𝔪_S ≤ 𝔪_S • 𝔪_S := by
        nth_rw 1 [h𝔪S_eq_span]
        rw [smul_eq_mul, ← sq, Ideal.span_le, Set.singleton_subset_iff]
        exact hsq
      have hFG_mS : (𝔪_S : Submodule S S).FG := IsNoetherian.noetherian 𝔪_S
      have hmS_bot : 𝔪_S = ⊥ :=
        Submodule.eq_bot_of_le_smul_of_le_jacobson_bot 𝔪_S 𝔪_S hFG_mS hle_self h𝔪S_jac
      have h𝔪_bot : 𝔪 = ⊥ := by
        ext x
        simp only [Ideal.mem_bot]
        constructor
        · intro hx
          have hloc0 : algebraMap R S x = 0 := by
            have : algebraMap R S x ∈ 𝔪_S := hmap_𝔪 ▸ Ideal.mem_map_of_mem _ hx
            rwa [hmS_bot, Ideal.mem_bot] at this
          obtain ⟨⟨u, hu_not_m⟩, hux⟩ :=
            (IsLocalization.map_eq_zero_iff 𝔪.primeCompl S x).mp hloc0
          have hu_ne : u ≠ 0 := fun h0 => hu_not_m (h0 ▸ 𝔪.zero_mem)
          exact (mul_eq_zero.mp hux).resolve_left hu_ne
        · rintro rfl; exact 𝔪.zero_mem
      have hfV_surj : Function.Surjective f_V := by
        intro r
        have hr_sub : r - π_R r = 0 := by
          have := h_sub_mem r
          rwa [h𝔪_bot, Ideal.mem_bot] at this
        have hr_eq : r = f_V (e_k₀.hom.hom (τ_V r)) :=
          sub_eq_zero.mp hr_sub
        exact ⟨e_k₀.hom.hom (τ_V r), hr_eq.symm⟩
      exact not_surjective_of_stdSmooth_one f_V hStd_V hfV_surj
    have hUniformizer : ∀ s : S, s ∈ 𝔪_S → s ∉ 𝔪_S ^ 2 → Ideal.span {s} = 𝔪_S := by
      intro s hs hs_not_sq
      rw [h𝔪S_eq_span] at hs ⊢
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp hs
      have hc_unit : IsUnit c := by
        by_contra hc_not_unit
        have hc_mem : c ∈ 𝔪_S := by
          by_contra hc_not
          exact hc_not_unit (IsLocalRing.notMem_maximalIdeal.mp hc_not)
        rw [h𝔪S_eq_span] at hc_mem
        obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton.mp hc_mem
        apply hs_not_sq
        have heq : t_S * (t_S * d) = (t_S * t_S) * d := by ring
        rw [heq, sq]
        exact Ideal.mul_mem_right d (𝔪_S * 𝔪_S) (Ideal.mul_mem_mul ht_S_mem ht_S_mem)
      apply le_antisymm
      · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr
          (Ideal.mem_span_singleton.mpr ⟨c, rfl⟩))
      · refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
        obtain ⟨u_c, rfl⟩ := hc_unit
        refine Ideal.mem_span_singleton.mpr ⟨↑u_c⁻¹, ?_⟩
        rw [mul_assoc, Units.mul_inv, mul_one]
