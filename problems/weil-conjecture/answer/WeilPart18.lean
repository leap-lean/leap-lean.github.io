              (C_U''.obj A).obj.obj (Opposite.op Z_et)) ≫
          (C_U''.obj A).obj.map (ψ_H τ).op =
          ℳ.obj.map (F_π'.map (ψ_H τ)).op ≫
            (e_triv.hom.hom.app (Opposite.op ((F_end u hu).obj W'')) :
              ℳ.obj.obj (Opposite.op (F_π'.obj ((F_end u hu).obj W''))) ⟶
                (C_U''.obj A).obj.obj (Opposite.op ((F_end u hu).obj W''))) :=
        (e_triv.hom.hom.naturality (ψ_H τ).op).symm
      have h₃ : ℳ.obj.map (adj_π'0.counit.app (F_π'.obj W'')).op ≫
          ℳ.obj.map (F_π'.map (ψ_H τ)).op =
          ℳ.obj.map (e_u_obj u hu (hActH_hom τ⁻¹) W'').op := by
        rw [← ℳ.obj.map_comp, ← op_comp, hψ_counit τ]
      have h₄ : ℳ.obj.map (e_u_obj u hu (hActH_hom τ⁻¹) W'').op ≫
          ((e_triv.hom.hom.app (Opposite.op ((F_end u hu).obj W'')) :
              ℳ.obj.obj (Opposite.op (F_π'.obj ((F_end u hu).obj W''))) ⟶
                (C_U''.obj A).obj.obj (Opposite.op ((F_end u hu).obj W''))) ≫
            (C_U''.map (q_sub k)).hom.app (Opposite.op ((F_end u hu).obj W''))) =
          (α_end u hu (hActH_hom τ⁻¹) ℳ ≫ (L_end u hu).map e_triv.hom ≫
            (L_end u hu).map (C_U''.map (q_sub k))).hom.app (Opposite.op W'') := rfl
      exact h₀.trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (ℳ.obj.map (adj_π'0.counit.app (F_π'.obj W'')).op ≫ ·)
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (_ ≫ ·) h₁).trans
                  ((CategoryTheory.Category.assoc _ _ _).symm.trans
                    ((congrArg (· ≫ _) h₂).trans
                      (CategoryTheory.Category.assoc _ _ _)))))).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ _) h₃).trans h₄))))
    have h_inv_zero : i_sub k ≫ ρ τ ≫ q_sub k = 0 := by
      ext ⟨y, hy⟩
      exact (QuotientAddGroup.eq_zero_iff _).mpr (hA_sub_inv k τ y hy)
    have h_sh_zero : C_U''.map (i_sub k) ≫ e_triv.inv ≫
        (α_end u hu (hActH_hom τ⁻¹) ℳ ≫ (L_end u hu).map e_triv.hom ≫
          (L_end u hu).map (C_U''.map (q_sub k))) = 0 := by
      calc
        C_U''.map (i_sub k) ≫ e_triv.inv ≫
            (α_end u hu (hActH_hom τ⁻¹) ℳ ≫ (L_end u hu).map e_triv.hom ≫
              (L_end u hu).map (C_U''.map (q_sub k)))
          = C_U''.map (i_sub k) ≫
              (e_triv.inv ≫ α_end u hu (hActH_hom τ⁻¹) ℳ ≫ (L_end u hu).map e_triv.hom) ≫
              (L_end u hu).map (C_U''.map (q_sub k)) := by
            simp only [CategoryTheory.Category.assoc]
        _ = C_U''.map (i_sub k) ≫ (C_U''.map (ρ τ) ≫ δ_end u hu A) ≫
              (L_end u hu).map (C_U''.map (q_sub k)) := by
            rw [← hΦ_δ τ]
        _ = C_U''.map (i_sub k ≫ ρ τ ≫ q_sub k) ≫ δ_end u hu (B_obj k) := by
            rw [CategoryTheory.Category.assoc (C_U''.map (ρ τ)),
              ← hδ_nat u hu (q_sub k)]
            simp only [← CategoryTheory.Category.assoc, ← C_U''.map_comp]
        _ = 0 := by
            rw [h_inv_zero, C_U''.map_zero, CategoryTheory.Limits.zero_comp]
    have h_eval₁ : ((C_U''.obj (B_obj k)).obj.map (ψ_H τ).op)
        ((((C_U''.map (i_sub k) ≫ e_triv.inv) ≫ L_π'.map (θ k)).hom.app W''_op) x) =
        ((C_U''.map (i_sub k) ≫ e_triv.inv ≫
            (α_end u hu (hActH_hom τ⁻¹) ℳ ≫ (L_end u hu).map e_triv.hom ≫
              (L_end u hu).map (C_U''.map (q_sub k)))).hom.app (Opposite.op W'')) x :=
      ConcreteCategory.congr_hom h_app
        (((C_U''.map (i_sub k) ≫ e_triv.inv).hom.app (Opposite.op W'')) x)
    have h_eval₂ : ((C_U''.map (i_sub k) ≫ e_triv.inv ≫
        (α_end u hu (hActH_hom τ⁻¹) ℳ ≫ (L_end u hu).map e_triv.hom ≫
          (L_end u hu).map (C_U''.map (q_sub k)))).hom.app (Opposite.op W'')) x = 0 :=
      ConcreteCategory.congr_hom
        (congrArg (fun φ => φ.hom.app (Opposite.op W'')) h_sh_zero) x
    exact h_eval₁.trans h_eval₂

  
  have hω_pkg : ∀ k : Fin (m_len + 1),
      ∃ (ω : L_π'.obj (𝒩 k) ≅ C_U''.obj (A_obj k)),
        ω.hom ≫ C_U''.map (i_sub k) =
          L_π'.map (CategoryTheory.Limits.kernel.ι (θ k)) ≫ e_triv.hom := by
    intro k
    have hKer_A := (hSE_sub k).fIsKernel
    have h_fwd_zero : (L_π'.map (CategoryTheory.Limits.kernel.ι (θ k)) ≫ e_triv.hom) ≫
        C_U''.map (q_sub k) = 0 := by
      rw [CategoryTheory.Category.assoc, ← hθ_counit k,
        ← CategoryTheory.Category.assoc, ← L_π'.map_comp,
        CategoryTheory.Limits.kernel.condition, L_π'.map_zero,
        CategoryTheory.Limits.zero_comp]
    obtain ⟨f_k, hf_k⟩ := CategoryTheory.Limits.KernelFork.IsLimit.lift' hKer_A
      (L_π'.map (CategoryTheory.Limits.kernel.ι (θ k)) ≫ e_triv.hom) h_fwd_zero
    have hKer_L : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι
          (L_π'.map (CategoryTheory.Limits.kernel.ι (θ k)))
          (by rw [← L_π'.map_comp, CategoryTheory.Limits.kernel.condition, L_π'.map_zero])) :=
      CategoryTheory.Limits.isLimitForkMapOfIsLimit' L_π'
        (CategoryTheory.Limits.kernel.condition (θ k))
        (CategoryTheory.Limits.kernelIsKernel (θ k))
    obtain ⟨g_k, hg_k⟩ := CategoryTheory.Limits.KernelFork.IsLimit.lift' hKer_L
      (C_U''.map (i_sub k) ≫ e_triv.inv) (h_back_zero k)
    dsimp at hf_k hg_k
    have hfg : f_k ≫ g_k = 𝟙 _ := by
      haveI : CategoryTheory.Mono (L_π'.map (CategoryTheory.Limits.kernel.ι (θ k))) :=
        L_π'.map_mono (CategoryTheory.Limits.kernel.ι (θ k))
      apply (CategoryTheory.cancel_mono (L_π'.map (CategoryTheory.Limits.kernel.ι (θ k)))).mp
      rw [CategoryTheory.Category.assoc, hg_k, ← CategoryTheory.Category.assoc, hf_k,
        CategoryTheory.Category.assoc, e_triv.hom_inv_id, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]
    have hgf : g_k ≫ f_k = 𝟙 _ := by
      haveI : CategoryTheory.Mono (C_U''.map (i_sub k)) := (hSE_sub k).mono_f
      apply (CategoryTheory.cancel_mono (C_U''.map (i_sub k))).mp
      rw [CategoryTheory.Category.assoc, hf_k, ← CategoryTheory.Category.assoc, hg_k,
        CategoryTheory.Category.assoc, e_triv.inv_hom_id, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]
    exact ⟨{ hom := f_k, inv := g_k, hom_inv_id := hfg, inv_hom_id := hgf }, hf_k⟩

  let ω_iso : ∀ k : Fin (m_len + 1), L_π'.obj (𝒩 k) ≅ C_U''.obj (A_obj k) :=
    fun k => (hω_pkg k).choose
  have hω_comm : ∀ k : Fin (m_len + 1),
      (ω_iso k).hom ≫ C_U''.map (i_sub k) =
        L_π'.map (CategoryTheory.Limits.kernel.ι (θ k)) ≫ e_triv.hom :=
    fun k => (hω_pkg k).choose_spec

  
  have hZero_N0 : CategoryTheory.Limits.IsZero (𝒩 0) := by
    have hZero_A0 : CategoryTheory.Limits.IsZero (A_obj 0) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext ⟨x, hx⟩
      rw [hA_sub_zero, AddSubgroup.mem_bot] at hx
      exact hx
    have hZero_CA0 : CategoryTheory.Limits.IsZero (C_U''.obj (A_obj 0)) :=
      C_U''.map_isZero hZero_A0
    have hZero_LN0 : CategoryTheory.Limits.IsZero (L_π'.obj (𝒩 0)) :=
      hZero_CA0.of_iso (ω_iso 0)
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply L_π'.map_injective
    rw [L_π'.map_id, L_π'.map_zero]
    exact (CategoryTheory.Limits.IsZero.iff_id_eq_zero _).mp hZero_LN0

  have hIso_Nlast : Nonempty (CategoryTheory.Iso (𝒩 (Fin.last m_len)) ℳ) := by
    have hZero_Blast : CategoryTheory.Limits.IsZero (B_obj (Fin.last m_len)) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext x
      exact (QuotientAddGroup.eq_zero_iff x).mpr (by rw [hA_sub_last]; trivial)
    haveI : R_π'.Additive :=
      { map_add := fun {_ _ f g} => by
          apply CategoryTheory.Sheaf.hom_ext
          ext W x
          rfl }
    have hZero_RB : CategoryTheory.Limits.IsZero
        (R_π'.obj (C_U''.obj (B_obj (Fin.last m_len)))) :=
      R_π'.map_isZero (C_U''.map_isZero hZero_Blast)
    have hθ_zero : θ (Fin.last m_len) = 0 := hZero_RB.eq_of_tgt _ _
    have h_lift_id : CategoryTheory.Limits.kernel.lift (θ (Fin.last m_len)) (𝟙 ℳ)
        (by rw [hθ_zero, CategoryTheory.Limits.comp_zero]) ≫
        CategoryTheory.Limits.kernel.ι (θ (Fin.last m_len)) = 𝟙 ℳ :=
      CategoryTheory.Limits.kernel.lift_ι _ _ _
    have h_id_lift : CategoryTheory.Limits.kernel.ι (θ (Fin.last m_len)) ≫
        CategoryTheory.Limits.kernel.lift (θ (Fin.last m_len)) (𝟙 ℳ)
          (by rw [hθ_zero, CategoryTheory.Limits.comp_zero]) = 𝟙 (𝒩 (Fin.last m_len)) := by
      apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι (θ (Fin.last m_len)))).mp
      rw [CategoryTheory.Category.assoc, h_lift_id, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.comp_id]
    exact ⟨{ hom := CategoryTheory.Limits.kernel.ι (θ (Fin.last m_len))
             inv := CategoryTheory.Limits.kernel.lift _ (𝟙 ℳ) _
             hom_inv_id := h_id_lift
             inv_hom_id := h_lift_id }⟩

  
  let A_ℓ : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))

  have hFilt : ∀ r : Fin m_len, ∃ (S_r : CategoryTheory.ShortComplex
      (CategoryTheory.Sheaf U'.smallEtaleTopology AddCommGrpCat.{u})),
      S_r.ShortExact ∧ S_r.X₁ = 𝒩 r.castSucc ∧ S_r.X₂ = 𝒩 r.succ ∧
        S_r.X₃ = weilEtaleTorsionSheaf U' ℓ := by
    intro r
    obtain ⟨h_le_r, v_r, hv_mem, hv_fix, hv_span⟩ := hA_sub_step r
    let q_proj : B_obj r.castSucc ⟶ B_obj r.succ :=
      AddCommGrpCat.ofHom (QuotientAddGroup.map (A_sub r.castSucc) (A_sub r.succ)
        (AddMonoidHom.id ↥A) h_le_r)
    have hq_comp : q_sub r.castSucc ≫ q_proj = q_sub r.succ := by
      ext x
      rfl
    have hθ_step : θ r.castSucc ≫ R_π'.map (C_U''.map q_proj) = θ r.succ := by
      dsimp only [θ]
      rw [adj_π'.homEquiv_unit, adj_π'.homEquiv_unit, CategoryTheory.Category.assoc,
        ← R_π'.map_comp, CategoryTheory.Category.assoc, ← C_U''.map_comp, hq_comp]
    have h_ι_cond : CategoryTheory.Limits.kernel.ι (θ r.castSucc) ≫ θ r.succ = 0 := by
      rw [← hθ_step, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
    let ι_r : 𝒩 r.castSucc ⟶ 𝒩 r.succ :=
      CategoryTheory.Limits.kernel.lift (θ r.succ)
        (CategoryTheory.Limits.kernel.ι (θ r.castSucc)) h_ι_cond
    have hι_fac : ι_r ≫ CategoryTheory.Limits.kernel.ι (θ r.succ) =
        CategoryTheory.Limits.kernel.ι (θ r.castSucc) :=
      CategoryTheory.Limits.kernel.lift_ι _ _ _
    haveI : CategoryTheory.Mono ι_r :=
      @CategoryTheory.mono_of_mono _ _ _ _ _ ι_r (CategoryTheory.Limits.kernel.ι (θ r.succ))
        (by rw [hι_fac]; infer_instance)
    let 𝒬_r := CategoryTheory.Limits.cokernel ι_r
    let p_r : 𝒩 r.succ ⟶ 𝒬_r := CategoryTheory.Limits.cokernel.π ι_r

    
    let j_r : A_obj r.castSucc ⟶ A_obj r.succ :=
      AddCommGrpCat.ofHom
        { toFun := fun x => ⟨x.1, h_le_r x.2⟩
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
    have hj_i : j_r ≫ i_sub r.succ = i_sub r.castSucc := rfl

    let c_of : ↥(A_obj r.succ) → ZMod ℓ := fun x => (hv_span x.1 x.2).choose
    have hc_spec : ∀ x : ↥(A_obj r.succ), x.1 - (c_of x).val • v_r ∈ A_sub r.castSucc :=
      fun x => (hv_span x.1 x.2).choose_spec.1
    have hc_uniq : ∀ (x : ↥(A_obj r.succ)) (c : ZMod ℓ),
        x.1 - c.val • v_r ∈ A_sub r.castSucc → c = c_of x :=
      fun x c hc => (hv_span x.1 x.2).choose_spec.2 c hc

    let q_step : A_obj r.succ ⟶ A_ℓ :=
      AddCommGrpCat.ofHom
        { toFun := fun x => ULift.up (c_of x)
          map_zero' := by
            apply congrArg ULift.up
            symm
            apply hc_uniq 0 0
            change (0 : ↥A) - (0 : ZMod ℓ).val • v_r ∈ A_sub r.castSucc
            rw [ZMod.val_zero, zero_nsmul, sub_zero]
            exact (A_sub r.castSucc).zero_mem
          map_add' := fun x y => by
            apply congrArg ULift.up
            symm
            apply hc_uniq (x + y) (c_of x + c_of y)
            have hsmul : (c_of x + c_of y).val • v_r =
                (c_of x).val • v_r + (c_of y).val • v_r := by
              rw [ZMod.val_add, hMod_nsmul, add_nsmul]
            have heq : (x.1 + y.1) - (c_of x + c_of y).val • v_r =
                (x.1 - (c_of x).val • v_r) + (y.1 - (c_of y).val • v_r) := by
              rw [hsmul]; abel
            change (x.1 + y.1) - (c_of x + c_of y).val • v_r ∈ A_sub r.castSucc
            rw [heq]
            exact (A_sub r.castSucc).add_mem (hc_spec x) (hc_spec y) }

    have hjq_zero : j_r ≫ q_step = 0 := by
      ext x
      apply congrArg ULift.up
      symm
      apply hc_uniq (j_r x) 0
      change x.1 - (0 : ZMod ℓ).val • v_r ∈ A_sub r.castSucc
      rw [ZMod.val_zero, zero_nsmul, sub_zero]
      exact x.2

    have hSE_step_sh : (CategoryTheory.ShortComplex.mk (C_U''.map j_r) (C_U''.map q_step)
        (by rw [← C_U''.map_comp, hjq_zero, C_U''.map_zero])).ShortExact := by
      let SC_step := CategoryTheory.ShortComplex.mk j_r q_step hjq_zero
      have hm : CategoryTheory.Mono SC_step.f := by
        rw [AddCommGrpCat.mono_iff_injective]
        intro a b hab
        exact Subtype.ext (congrArg (fun z : ↥(A_sub r.succ) => z.1) hab)
      have he : CategoryTheory.Epi SC_step.g := by
        rw [AddCommGrpCat.epi_iff_surjective]
        intro ⟨c⟩
        let x : ↥(A_obj r.succ) := ⟨c.val • v_r, (A_sub r.succ).nsmul_mem hv_mem c.val⟩
        refine ⟨x, congrArg ULift.up ?_⟩
        symm
        apply hc_uniq x c
        change c.val • v_r - c.val • v_r ∈ A_sub r.castSucc
        rw [sub_self]
        exact (A_sub r.castSucc).zero_mem
      have hex : SC_step.Exact := by
        rw [CategoryTheory.ShortComplex.ab_exact_iff]
        intro x hx
        have hc0 : c_of x = 0 := congrArg ULift.down hx
        have hx_mem : x.1 ∈ A_sub r.castSucc := by
          have h1 := hc_spec x
          rwa [hc0, ZMod.val_zero, zero_nsmul, sub_zero] at h1
        exact ⟨⟨x.1, hx_mem⟩, rfl⟩
      exact (CategoryTheory.ShortComplex.ShortExact.mk' hex hm he).map_of_exact C_U''

    let ρ_succ : H → (A_obj r.succ ⟶ A_obj r.succ) := fun τ =>
      AddCommGrpCat.ofHom
        { toFun := fun x => ⟨(ρ τ) x.1, hA_sub_inv r.succ τ x.1 x.2⟩
          map_zero' := Subtype.ext (map_zero (ρ τ).hom)
          map_add' := fun a b => Subtype.ext (map_add (ρ τ).hom a.1 b.1) }
    have hρ_succ_i : ∀ τ : H, ρ_succ τ ≫ i_sub r.succ = i_sub r.succ ≫ ρ τ := fun _ => rfl
    have hρ_succ_q : ∀ τ : H, ρ_succ τ ≫ q_step = q_step := by
      intro τ
      ext x
      apply congrArg ULift.up
      symm
      apply hc_uniq (ρ_succ τ x) (c_of x)
      have h1 : (ρ τ) (x.1 - (c_of x).val • v_r) ∈ A_sub r.castSucc :=
        hA_sub_inv r.castSucc τ _ (hc_spec x)
      have h2 : (c_of x).val • ((ρ τ) v_r - v_r) ∈ A_sub r.castSucc :=
        (A_sub r.castSucc).nsmul_mem (hv_fix τ) (c_of x).val
      have heq : (ρ τ).hom (x.1 - (c_of x).val • v_r) + (c_of x).val • ((ρ τ) v_r - v_r) =
          (ρ τ) x.1 - (c_of x).val • v_r := by
        rw [map_sub, map_nsmul, nsmul_sub]; abel
      change (ρ τ) x.1 - (c_of x).val • v_r ∈ A_sub r.castSucc
      rw [← heq]
      exact (A_sub r.castSucc).add_mem h1 h2

    
    have hω_step : L_π'.map ι_r ≫ (ω_iso r.succ).hom =
        (ω_iso r.castSucc).hom ≫ C_U''.map j_r := by
      haveI : CategoryTheory.Mono (C_U''.map (i_sub r.succ)) := (hSE_sub r.succ).mono_f
      apply (CategoryTheory.cancel_mono (C_U''.map (i_sub r.succ))).mp
      rw [CategoryTheory.Category.assoc, hω_comm r.succ, ← CategoryTheory.Category.assoc,
        ← L_π'.map_comp, hι_fac, ← hω_comm r.castSucc, CategoryTheory.Category.assoc,
        ← C_U''.map_comp, hj_i]

    have hCoker_L : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.CokernelCofork.ofπ (L_π'.map p_r)
          (by rw [← L_π'.map_comp, CategoryTheory.Limits.cokernel.condition, L_π'.map_zero])) :=
      CategoryTheory.Limits.isColimitCoforkMapOfIsColimit' L_π'
        (CategoryTheory.Limits.cokernel.condition ι_r)
        (CategoryTheory.Limits.cokernelIsCokernel ι_r)
    have hCoker_C := hSE_step_sh.gIsCokernel

    have h_bar_fwd_zero : L_π'.map ι_r ≫ ((ω_iso r.succ).hom ≫ C_U''.map q_step) = 0 := by
      rw [← CategoryTheory.Category.assoc, hω_step, CategoryTheory.Category.assoc,
        ← C_U''.map_comp, hjq_zero, C_U''.map_zero, CategoryTheory.Limits.comp_zero]
    obtain ⟨f_bar₀, hf_bar⟩ := CategoryTheory.Limits.CokernelCofork.IsColimit.desc' hCoker_L
      ((ω_iso r.succ).hom ≫ C_U''.map q_step) h_bar_fwd_zero
    have h_bar_bwd_zero : C_U''.map j_r ≫ ((ω_iso r.succ).inv ≫ L_π'.map p_r) = 0 := by
      have hω_inv : C_U''.map j_r ≫ (ω_iso r.succ).inv =
          (ω_iso r.castSucc).inv ≫ L_π'.map ι_r := by
        rw [CategoryTheory.Iso.comp_inv_eq, CategoryTheory.Category.assoc, hω_step,
          CategoryTheory.Iso.inv_hom_id_assoc]
      rw [← CategoryTheory.Category.assoc, hω_inv, CategoryTheory.Category.assoc,
        ← L_π'.map_comp, CategoryTheory.Limits.cokernel.condition, L_π'.map_zero,
        CategoryTheory.Limits.comp_zero]
    obtain ⟨g_bar₀, hg_bar⟩ := CategoryTheory.Limits.CokernelCofork.IsColimit.desc' hCoker_C
      ((ω_iso r.succ).inv ≫ L_π'.map p_r) h_bar_bwd_zero
    let f_bar : L_π'.obj 𝒬_r ⟶ C_U''.obj A_ℓ := f_bar₀
    let g_bar : C_U''.obj A_ℓ ⟶ L_π'.obj 𝒬_r := g_bar₀
    change L_π'.map p_r ≫ f_bar = (ω_iso r.succ).hom ≫ C_U''.map q_step at hf_bar
    change C_U''.map q_step ≫ g_bar = (ω_iso r.succ).inv ≫ L_π'.map p_r at hg_bar
    have hfg_bar : f_bar ≫ g_bar = 𝟙 (L_π'.obj 𝒬_r) := by
      haveI : CategoryTheory.Epi (L_π'.map p_r) := inferInstance
      apply (CategoryTheory.cancel_epi (L_π'.map p_r)).mp
      rw [← CategoryTheory.Category.assoc, hf_bar, CategoryTheory.Category.assoc, hg_bar,
        ← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    have hgf_bar : g_bar ≫ f_bar = 𝟙 (C_U''.obj A_ℓ) := by
      haveI : CategoryTheory.Epi (C_U''.map q_step) := hSE_step_sh.epi_g
      apply (CategoryTheory.cancel_epi (C_U''.map q_step)).mp
      rw [← CategoryTheory.Category.assoc, hg_bar, CategoryTheory.Category.assoc, hf_bar,
        ← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    let ω_bar : L_π'.obj 𝒬_r ≅ C_U''.obj A_ℓ :=
      { hom := f_bar, inv := g_bar, hom_inv_id := hfg_bar, inv_hom_id := hgf_bar }

    
    have hω_bar_inv : ∀ τ : H,
        let u := actH τ⁻¹
        let hu := hEt_actH τ⁻¹
        ω_bar.inv ≫ α_end u hu (hActH_hom τ⁻¹) 𝒬_r =
          δ_end u hu A_ℓ ≫ (L_end u hu).map ω_bar.inv := by
      intro τ
      let u := actH τ⁻¹
      have hu := hEt_actH τ⁻¹
      have hΦ_τ : C_U''.map (ρ τ) ≫ δ_end u hu A =
          e_triv.inv ≫ α_end u hu (hActH_hom τ⁻¹) ℳ ≫ (L_end u hu).map e_triv.hom :=
        hΦ_δ τ
      have hα_nat_k : L_π'.map (CategoryTheory.Limits.kernel.ι (θ r.succ)) ≫
          α_end u hu (hActH_hom τ⁻¹) ℳ =
          α_end u hu (hActH_hom τ⁻¹) (𝒩 r.succ) ≫
            (L_end u hu).map (L_π'.map (CategoryTheory.Limits.kernel.ι (θ r.succ))) := by
        apply CategoryTheory.Sheaf.hom_ext
        ext W'' : 2
        exact ((CategoryTheory.Limits.kernel.ι (θ r.succ)).hom.naturality _).symm
      have hα_nat_p : L_π'.map p_r ≫ α_end u hu (hActH_hom τ⁻¹) 𝒬_r =
          α_end u hu (hActH_hom τ⁻¹) (𝒩 r.succ) ≫ (L_end u hu).map (L_π'.map p_r) := by
        apply CategoryTheory.Sheaf.hom_ext
        ext W'' : 2
        exact (p_r.hom.naturality _).symm
      have h_Lu_mono : CategoryTheory.Mono ((L_end u hu).map (C_U''.map (i_sub r.succ))) := by
        haveI : CategoryTheory.Limits.PreservesFiniteLimits (L_end u hu) := by
          haveI : CategoryTheory.Limits.PreservesFiniteLimits
              (L_end u hu ⋙
                CategoryTheory.sheafToPresheaf U''.smallEtaleTopology AddCommGrpCat.{u}) := by
            change CategoryTheory.Limits.PreservesFiniteLimits
              (CategoryTheory.sheafToPresheaf U''.smallEtaleTopology AddCommGrpCat.{u} ⋙
                (CategoryTheory.Functor.whiskeringLeft (U''.Etale)ᵒᵖ (U''.Etale)ᵒᵖ
                  AddCommGrpCat.{u}).obj (F_end u hu).op)
            infer_instance
          exact CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves
            (L_end u hu) (CategoryTheory.sheafToPresheaf U''.smallEtaleTopology AddCommGrpCat.{u})
        haveI : CategoryTheory.Mono (C_U''.map (i_sub r.succ)) := (hSE_sub r.succ).mono_f
        exact (L_end u hu).map_mono _
      have hω_Nsucc : α_end u hu (hActH_hom τ⁻¹) (𝒩 r.succ) ≫
          (L_end u hu).map (ω_iso r.succ).hom =
          (ω_iso r.succ).hom ≫ C_U''.map (ρ_succ τ) ≫ δ_end u hu (A_obj r.succ) := by
        apply (@CategoryTheory.cancel_mono _ _ _ _ _
          ((L_end u hu).map (C_U''.map (i_sub r.succ))) h_Lu_mono).mp
        rw [CategoryTheory.Category.assoc, ← (L_end u hu).map_comp, hω_comm r.succ,
          (L_end u hu).map_comp, ← CategoryTheory.Category.assoc, ← hα_nat_k,
          CategoryTheory.Category.assoc]
        have h_et : α_end u hu (hActH_hom τ⁻¹) ℳ ≫ (L_end u hu).map e_triv.hom =
            e_triv.hom ≫ C_U''.map (ρ τ) ≫ δ_end u hu A := by
          have h1 := congrArg (fun k => e_triv.hom ≫ k) hΦ_τ.symm
          rwa [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            e_triv.hom_inv_id, CategoryTheory.Category.id_comp] at h1
        rw [h_et, ← CategoryTheory.Category.assoc (L_π'.map _), ← hω_comm r.succ,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc (C_U''.map (i_sub r.succ)),
          ← C_U''.map_comp, ← hρ_succ_i τ, C_U''.map_comp,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          hδ_nat u hu (i_sub r.succ)]
      have h_hom_eq : α_end u hu (hActH_hom τ⁻¹) 𝒬_r ≫ (L_end u hu).map ω_bar.hom =
          ω_bar.hom ≫ δ_end u hu A_ℓ := by
        haveI : CategoryTheory.Epi (L_π'.map p_r) := inferInstance
        apply (CategoryTheory.cancel_epi (L_π'.map p_r)).mp
        have hf_eq : L_π'.map p_r ≫ ω_bar.hom = (ω_iso r.succ).hom ≫ C_U''.map q_step := hf_bar
        rw [← CategoryTheory.Category.assoc, hα_nat_p, CategoryTheory.Category.assoc,
          ← (L_end u hu).map_comp, hf_eq, (L_end u hu).map_comp,
          ← CategoryTheory.Category.assoc, hω_Nsucc, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, ← hδ_nat u hu q_step,
          ← CategoryTheory.Category.assoc (C_U''.map (ρ_succ τ)),
          ← C_U''.map_comp, hρ_succ_q τ, ← CategoryTheory.Category.assoc, ← hf_eq,
          CategoryTheory.Category.assoc]
      have h1 := congrArg (fun k => ω_bar.inv ≫ k ≫ (L_end u hu).map ω_bar.inv) h_hom_eq
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← (L_end u hu).map_comp, ω_bar.hom_inv_id, (L_end u hu).map_id,
        CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc ω_bar.inv,
        ω_bar.inv_hom_id, CategoryTheory.Category.id_comp] at h1
      exact h1

    
    let pi_et' : F_π'.obj T_U'' ⟶ T_U' :=
      CategoryTheory.MorphismProperty.Over.homMk π'
        ((CategoryTheory.Category.comp_id π').trans
          (CategoryTheory.Category.id_comp π').symm)
    let f_gen : A_ℓ ⟶ 𝒬_r.obj.obj (Opposite.op (F_π'.obj T_U'')) :=
      adj''.unit.app A_ℓ ≫ ω_bar.inv.hom.app (Opposite.op T_U'')

    have hf_gen_eq : ∀ (a : ↥A_ℓ) {Z : U'.Etale} (p₁ p₂ : Z ⟶ F_π'.obj T_U''),
        p₁ ≫ pi_et' = p₂ ≫ pi_et' →
        𝒬_r.obj.map p₁.op (f_gen a) = 𝒬_r.obj.map p₂.op (f_gen a) := by
      intro a Z p₁ p₂ hp
      have hp_π' : p₁.left ≫ π' = p₂.left ≫ π' := congrArg (fun m => m.left) hp
      let μ_Z : Z.left ⟶ CategoryTheory.Limits.pullback π' π' :=
        CategoryTheory.Limits.pullback.lift p₁.left p₂.left hp_π'
      let Z_τ : H → AlgebraicGeometry.Scheme.{u} :=
        fun τ => CategoryTheory.Limits.pullback μ_Z (γ_H τ⁻¹)
      let u_τ : ∀ τ : H, Z_τ τ ⟶ Z.left :=
        fun τ => CategoryTheory.Limits.pullback.fst μ_Z (γ_H τ⁻¹)
      let v_τ : ∀ τ : H, Z_τ τ ⟶ U'' :=
        fun τ => CategoryTheory.Limits.pullback.snd μ_Z (γ_H τ⁻¹)
      have hEt_uτ : ∀ τ : H, AlgebraicGeometry.Etale (u_τ τ) := fun τ =>
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback μ_Z (γ_H τ⁻¹)).flip (hEt_γH τ⁻¹)
      let Z_et_τ : H → U'.Etale := fun τ =>
        CategoryTheory.MorphismProperty.Over.mk ⊤ (u_τ τ ≫ Z.hom)
          (CategoryTheory.MorphismProperty.comp_mem P_et (u_τ τ) Z.hom (hEt_uτ τ) Z.prop)
      let u_et_τ : ∀ τ : H, Z_et_τ τ ⟶ Z :=
        fun τ => CategoryTheory.MorphismProperty.Over.homMk (u_τ τ) rfl
      have h_uτ_surj : ∀ z : ↥Z.left, ∃ (τ : H) (zt : ↥(Z_et_τ τ).left),
          (u_et_τ τ).left.base zt = z := by
        intro z
        have hmem : μ_Z.base z ∈ (⋃ τ₀ : H, Set.range (γ_H τ₀).base) := by
          rw [hCovH]; trivial
        rw [Set.mem_iUnion] at hmem
        obtain ⟨τ₀, u₀, hu₀⟩ := hmem
        let τ : H := τ₀⁻¹
        have hu₀' : (γ_H τ⁻¹).base u₀ = μ_Z.base z := by
          dsimp [τ]
          rw [inv_inv]
          exact hu₀
        obtain ⟨zt, hzt, -⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z u₀ hu₀'.symm
        exact ⟨τ, zt, hzt⟩
      refine h_arrows_sep 𝒬_r Z Z_et_τ u_et_τ h_uτ_surj _ _ fun τ => ?_
      have hv_eq : u_τ τ ≫ p₂.left = v_τ τ :=
        (congrArg (u_τ τ ≫ ·)
            (CategoryTheory.Limits.pullback.lift_snd p₁.left p₂.left hp_π').symm).trans
          ((CategoryTheory.Category.assoc (u_τ τ) μ_Z
              (CategoryTheory.Limits.pullback.snd π' π')).symm.trans
            ((congrArg (· ≫ CategoryTheory.Limits.pullback.snd π' π')
                (CategoryTheory.Limits.pullback.condition (f := μ_Z) (g := γ_H τ⁻¹))).trans
              ((CategoryTheory.Category.assoc (v_τ τ) (γ_H τ⁻¹)
                  (CategoryTheory.Limits.pullback.snd π' π')).trans
                ((congrArg (v_τ τ ≫ ·) (hγH τ⁻¹).2).trans
                  (CategoryTheory.Category.comp_id (v_τ τ))))))
      have hp₁_eq : u_τ τ ≫ p₁.left = (u_τ τ ≫ p₂.left) ≫ actH τ⁻¹ :=
        (congrArg (u_τ τ ≫ ·)
            (CategoryTheory.Limits.pullback.lift_fst p₁.left p₂.left hp_π').symm).trans
          ((CategoryTheory.Category.assoc (u_τ τ) μ_Z
              (CategoryTheory.Limits.pullback.fst π' π')).symm.trans
            ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst π' π')
                (CategoryTheory.Limits.pullback.condition (f := μ_Z) (g := γ_H τ⁻¹))).trans
              ((CategoryTheory.Category.assoc (v_τ τ) (γ_H τ⁻¹)
                  (CategoryTheory.Limits.pullback.fst π' π')).trans
                ((congrArg (v_τ τ ≫ ·) (hγH τ⁻¹).1).trans
                  (congrArg (· ≫ actH τ⁻¹) hv_eq.symm)))))
      let w'' : Z_τ τ ⟶ U'' := u_τ τ ≫ p₂.left
      have hw''_π' : w'' ≫ π' = (Z_et_τ τ).hom :=
        (CategoryTheory.Category.assoc (u_τ τ) p₂.left π').trans
          (congrArg (u_τ τ ≫ ·)
            ((congrArg (p₂.left ≫ ·) (CategoryTheory.Category.id_comp π').symm).trans
              (CategoryTheory.MorphismProperty.Over.w p₂)))
      have hEt_w'' : AlgebraicGeometry.Etale w'' :=
        CategoryTheory.MorphismProperty.of_postcomp P_et w'' π' hEt_π'
          (hw''_π'.symm ▸ (Z_et_τ τ).prop)
      let W''_τ : U''.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w'' hEt_w''
      let e_Z_W : Z_et_τ τ ⟶ F_π'.obj W''_τ :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.CategoryStruct.id (Z_τ τ))
          ((CategoryTheory.Category.id_comp (w'' ≫ π')).trans hw''_π')
      let u := actH τ⁻¹
      have hu := hEt_actH τ⁻¹
      let e_Z_FuW : Z_et_τ τ ⟶ F_π'.obj ((F_end u hu).obj W''_τ) :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.CategoryStruct.id (Z_τ τ))
          ((CategoryTheory.Category.id_comp ((w'' ≫ actH τ⁻¹) ≫ π')).trans
            ((CategoryTheory.Category.assoc w'' (actH τ⁻¹) π').trans
              ((congrArg (w'' ≫ ·) (hActH_hom τ⁻¹)).trans hw''_π')))
      have hm₁_left : (hT_U''.from W''_τ).left = w'' :=
        (CategoryTheory.Category.comp_id (Y := U'') (hT_U''.from W''_τ).left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w (hT_U''.from W''_τ))
      have h_p₂_fac : u_et_τ τ ≫ p₂ = e_Z_W ≫ F_π'.map (hT_U''.from W''_τ) :=
        CategoryTheory.MorphismProperty.Over.Hom.ext
          (hm₁_left.symm.trans (CategoryTheory.Category.id_comp _).symm)
      have hm₂_left : (hT_U''.from ((F_end u hu).obj W''_τ)).left = w'' ≫ u :=
        (CategoryTheory.Category.comp_id (Y := U'')
          (hT_U''.from ((F_end u hu).obj W''_τ)).left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w
            (hT_U''.from ((F_end u hu).obj W''_τ)))
      have h_p₁_fac : u_et_τ τ ≫ p₁ =
          e_Z_FuW ≫ F_π'.map (hT_U''.from ((F_end u hu).obj W''_τ)) :=
        CategoryTheory.MorphismProperty.Over.Hom.ext
          (hp₁_eq.trans (hm₂_left.symm.trans (CategoryTheory.Category.id_comp _).symm))
      have h_e_rel : e_Z_FuW ≫ e_u_obj u hu (hActH_hom τ⁻¹) W''_τ = e_Z_W :=
        CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
      
      let x₀ := (C_U''.obj A_ℓ).obj.map (hT_U''.from W''_τ).op (adj''.unit.app A_ℓ a)
      have h_inv_app := ConcreteCategory.congr_hom
        (congrArg (fun φ => φ.hom.app (Opposite.op W''_τ)) (hω_bar_inv τ)) x₀
      have h_lhs_val : (ω_bar.inv ≫ α_end u hu (hActH_hom τ⁻¹) 𝒬_r).hom.app (Opposite.op W''_τ) x₀ =
          𝒬_r.obj.map (e_u_obj u hu (hActH_hom τ⁻¹) W''_τ).op
            (𝒬_r.obj.map (F_π'.map (hT_U''.from W''_τ)).op (f_gen a)) := by
        have hnat : ω_bar.inv.hom.app (Opposite.op W''_τ) x₀ =
            𝒬_r.obj.map (F_π'.map (hT_U''.from W''_τ)).op (f_gen a) :=
          ConcreteCategory.congr_hom
            (ω_bar.inv.hom.naturality (hT_U''.from W''_τ).op) (adj''.unit.app A_ℓ a)
        exact congrArg (𝒬_r.obj.map (e_u_obj u hu (hActH_hom τ⁻¹) W''_τ).op) hnat
      have h_δ_val : (δ_end u hu A_ℓ).hom.app (Opposite.op W''_τ) x₀ =
          (C_U''.obj A_ℓ).obj.map (hT_U''.from ((F_end u hu).obj W''_τ)).op
            (adj''.unit.app A_ℓ a) := by
        have hnat : (δ_end u hu A_ℓ).hom.app (Opposite.op W''_τ) x₀ =
            (C_U''.obj A_ℓ).obj.map ((F_end u hu).map (hT_U''.from W''_τ)).op
              ((adj''.unit.app A_ℓ ≫ (δ_end u hu A_ℓ).hom.app (Opposite.op T_U'')) a) :=
          ConcreteCategory.congr_hom
            ((δ_end u hu A_ℓ).hom.naturality (hT_U''.from W''_τ).op) (adj''.unit.app A_ℓ a)
        have hu_app := ConcreteCategory.congr_hom (hδ_unit u hu A_ℓ) a
        have hm : (C_U''.obj A_ℓ).obj.map (hT_U''.from ((F_end u hu).obj T_U'')).op ≫
            (C_U''.obj A_ℓ).obj.map ((F_end u hu).map (hT_U''.from W''_τ)).op =
            (C_U''.obj A_ℓ).obj.map (hT_U''.from ((F_end u hu).obj W''_τ)).op := by
          rw [← (C_U''.obj A_ℓ).obj.map_comp, ← op_comp]
          exact congrArg (C_U''.obj A_ℓ).obj.map
            (congrArg Opposite.op (hT_U''.hom_ext _ _))
        exact hnat.trans
          ((congrArg ((C_U''.obj A_ℓ).obj.map ((F_end u hu).map (hT_U''.from W''_τ)).op) hu_app).trans
            (congrArg (fun φ => φ (adj''.unit.app A_ℓ a)) hm))
      have h_rhs_val : (δ_end u hu A_ℓ ≫ (L_end u hu).map ω_bar.inv).hom.app
          (Opposite.op W''_τ) x₀ =
          𝒬_r.obj.map (F_π'.map (hT_U''.from ((F_end u hu).obj W''_τ))).op (f_gen a) := by
        change (ω_bar.inv.hom.app (Opposite.op ((F_end u hu).obj W''_τ)))
          ((δ_end u hu A_ℓ).hom.app (Opposite.op W''_τ) x₀) = _
        rw [h_δ_val]
        have hnat := ConcreteCategory.congr_hom
          (ω_bar.inv.hom.naturality (hT_U''.from ((F_end u hu).obj W''_τ)).op)
          (adj''.unit.app A_ℓ a)
        exact hnat
      rw [h_lhs_val, h_rhs_val] at h_inv_app
      have h_apply_e := congrArg (𝒬_r.obj.map e_Z_FuW.op) h_inv_app
      have hm₁ : 𝒬_r.obj.map (F_π'.map (hT_U''.from W''_τ)).op ≫
          𝒬_r.obj.map (e_u_obj u hu (hActH_hom τ⁻¹) W''_τ).op ≫
          𝒬_r.obj.map e_Z_FuW.op =
          𝒬_r.obj.map p₂.op ≫ 𝒬_r.obj.map (u_et_τ τ).op := by
        rw [← 𝒬_r.obj.map_comp, ← 𝒬_r.obj.map_comp, ← 𝒬_r.obj.map_comp,
          ← op_comp, ← op_comp, ← op_comp,
          h_e_rel, ← h_p₂_fac]
      have hm₂ : 𝒬_r.obj.map (F_π'.map (hT_U''.from ((F_end u hu).obj W''_τ))).op ≫
          𝒬_r.obj.map e_Z_FuW.op =
          𝒬_r.obj.map p₁.op ≫ 𝒬_r.obj.map (u_et_τ τ).op := by
        rw [← 𝒬_r.obj.map_comp, ← 𝒬_r.obj.map_comp, ← op_comp, ← op_comp, ← h_p₁_fac]
      exact (congrArg (fun φ => φ (f_gen a)) hm₂).symm.trans
        (h_apply_e.symm.trans (congrArg (fun φ => φ (f_gen a)) hm₁))

    have hg_ex : ∀ a : ↥A_ℓ,
        ∃! y : ↥(𝒬_r.obj.obj (Opposite.op T_U')), 𝒬_r.obj.map pi_et'.op y = f_gen a :=
      fun a => h_singleton_descent 𝒬_r pi_et' hSurj_π' (f_gen a) (hf_gen_eq a)
    let g_gen : A_ℓ ⟶ 𝒬_r.obj.obj (Opposite.op T_U') :=
      AddCommGrpCat.ofHom
        ({ toFun := fun a => (hg_ex a).choose
           map_zero' := by
             apply (hg_ex 0).unique (hg_ex 0).choose_spec.1
             rw [map_zero, map_zero]
           map_add' := fun a₁ a₂ => by
             apply (hg_ex (a₁ + a₂)).unique (hg_ex (a₁ + a₂)).choose_spec.1
             rw [map_add, (hg_ex a₁).choose_spec.1, (hg_ex a₂).choose_spec.1, ← map_add] } :
          ↥A_ℓ →+ ↥(𝒬_r.obj.obj (Opposite.op T_U')))
    have hg_gen_spec : g_gen ≫ 𝒬_r.obj.map pi_et'.op = f_gen := by
      ext a
      exact (hg_ex a).choose_spec.1

    let ψ_r : weilEtaleTorsionSheaf U' ℓ ⟶ 𝒬_r :=
      (adj'.homEquiv A_ℓ 𝒬_r).symm g_gen
    have hψ_unit : adj'.unit.app A_ℓ ≫ ψ_r.hom.app (Opposite.op T_U') = g_gen :=
      (adj'.homEquiv_unit A_ℓ 𝒬_r ψ_r).symm.trans
        ((adj'.homEquiv A_ℓ 𝒬_r).apply_symm_apply g_gen)

    
    let γ_inv_ℓ : C_U''.obj A_ℓ ⟶ L_π'.obj (C_U'.obj A_ℓ) :=
      (adj''.homEquiv A_ℓ (L_π'.obj (C_U'.obj A_ℓ))).symm
        (adj'.unit.app A_ℓ ≫ (C_U'.obj A_ℓ).obj.map pi_et'.op)
    have hγ_inv_unit : adj''.unit.app A_ℓ ≫ γ_inv_ℓ.hom.app (Opposite.op T_U'') =
        adj'.unit.app A_ℓ ≫ (C_U'.obj A_ℓ).obj.map pi_et'.op :=
      (adj''.homEquiv_unit A_ℓ _ γ_inv_ℓ).symm.trans
        ((adj''.homEquiv A_ℓ _).apply_symm_apply _)

    let u_hom_ℓ : C_U'.obj A_ℓ ⟶ R_π'.obj (C_U''.obj A_ℓ) :=
      (adj'.homEquiv A_ℓ (R_π'.obj (C_U''.obj A_ℓ))).symm
        (adj''.unit.app A_ℓ ≫ (C_U''.obj A_ℓ).obj.map (hT_U''.from (B_π'.obj T_U')).op)
    have hu_hom_unit : adj'.unit.app A_ℓ ≫ u_hom_ℓ.hom.app (Opposite.op T_U') =
        adj''.unit.app A_ℓ ≫ (C_U''.obj A_ℓ).obj.map (hT_U''.from (B_π'.obj T_U')).op :=
      (adj'.homEquiv_unit A_ℓ _ u_hom_ℓ).symm.trans
        ((adj'.homEquiv A_ℓ _).apply_symm_apply _)
    let γ_hom_ℓ : L_π'.obj (C_U'.obj A_ℓ) ⟶ C_U''.obj A_ℓ :=
      (adj_π'.homEquiv (C_U'.obj A_ℓ) (C_U''.obj A_ℓ)).symm u_hom_ℓ
    have hγ_hom_eq : γ_hom_ℓ = L_π'.map u_hom_ℓ ≫ adj_π'.counit.app (C_U''.obj A_ℓ) :=
      adj_π'.homEquiv_counit _ _ _

    have hγ_inv_hom : γ_inv_ℓ ≫ γ_hom_ℓ = 𝟙 (C_U''.obj A_ℓ) := by
      apply (adj''.homEquiv A_ℓ (C_U''.obj A_ℓ)).injective
      rw [adj''.homEquiv_unit, adj''.homEquiv_unit]
      have h₀ : adj''.unit.app A_ℓ ≫
          ((CategoryTheory.sheafSections U''.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op T_U'')).map (γ_inv_ℓ ≫ γ_hom_ℓ) =
          (adj''.unit.app A_ℓ ≫ γ_inv_ℓ.hom.app (Opposite.op T_U'')) ≫
            ((u_hom_ℓ.hom.app (Opposite.op (F_π'.obj T_U'')) :
                (C_U'.obj A_ℓ).obj.obj (Opposite.op (F_π'.obj T_U'')) ⟶
                  (C_U''.obj A_ℓ).obj.obj (Opposite.op (B_π'.obj (F_π'.obj T_U'')))) ≫
              (C_U''.obj A_ℓ).obj.map (adj_π'0.unit.app T_U'').op) := by
        rw [hγ_hom_eq]
        rfl
      have h₁ : (C_U'.obj A_ℓ).obj.map pi_et'.op ≫
          (u_hom_ℓ.hom.app (Opposite.op (F_π'.obj T_U'')) :
            (C_U'.obj A_ℓ).obj.obj (Opposite.op (F_π'.obj T_U'')) ⟶
              (C_U''.obj A_ℓ).obj.obj (Opposite.op (B_π'.obj (F_π'.obj T_U'')))) =
          u_hom_ℓ.hom.app (Opposite.op T_U') ≫ (C_U''.obj A_ℓ).obj.map (B_π'.map pi_et').op :=
        u_hom_ℓ.hom.naturality pi_et'.op
      have h_maps : (C_U''.obj A_ℓ).obj.map (hT_U''.from (B_π'.obj T_U')).op ≫
          ((C_U''.obj A_ℓ).obj.map (B_π'.map pi_et').op ≫
            (C_U''.obj A_ℓ).obj.map (adj_π'0.unit.app T_U'').op) =
          𝟙 ((C_U''.obj A_ℓ).obj.obj (Opposite.op T_U'')) := by
        rw [← (C_U''.obj A_ℓ).obj.map_comp, ← (C_U''.obj A_ℓ).obj.map_comp,
          ← op_comp, ← op_comp]
        have h_id_T'' : (adj_π'0.unit.app T_U'' ≫ B_π'.map pi_et') ≫
            hT_U''.from (B_π'.obj T_U') = 𝟙 T_U'' :=
          hT_U''.hom_ext _ _
        rw [h_id_T'']
        exact (C_U''.obj A_ℓ).obj.map_id _
      exact h₀.trans
        ((congrArg (· ≫ _) hγ_inv_unit).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (adj'.unit.app A_ℓ ≫ ·)
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ (C_U''.obj A_ℓ).obj.map (adj_π'0.unit.app T_U'').op) h₁).trans
                    (CategoryTheory.Category.assoc _ _ _)))).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ _) hu_hom_unit).trans
                  ((CategoryTheory.Category.assoc _ _ _).trans
                    ((congrArg (adj''.unit.app A_ℓ ≫ ·) h_maps).trans
                      ((CategoryTheory.Category.comp_id _).trans
                        (CategoryTheory.Category.comp_id _).symm))))))))

    have hγ_hom_inv : γ_hom_ℓ ≫ γ_inv_ℓ = 𝟙 (L_π'.obj (C_U'.obj A_ℓ)) := by
      apply (adj_π'.homEquiv (C_U'.obj A_ℓ) (L_π'.obj (C_U'.obj A_ℓ))).injective
      have h_rhs_id : adj_π'.homEquiv (C_U'.obj A_ℓ) (L_π'.obj (C_U'.obj A_ℓ))
          (𝟙 (L_π'.obj (C_U'.obj A_ℓ))) = adj_π'.unit.app (C_U'.obj A_ℓ) := by
        rw [adj_π'.homEquiv_unit, R_π'.map_id]
        exact CategoryTheory.Category.comp_id (adj_π'.unit.app (C_U'.obj A_ℓ))
      have h_lhs_comp : adj_π'.homEquiv (C_U'.obj A_ℓ) (L_π'.obj (C_U'.obj A_ℓ))
          (γ_hom_ℓ ≫ γ_inv_ℓ) = u_hom_ℓ ≫ R_π'.map γ_inv_ℓ := by
        rw [adj_π'.homEquiv_unit, R_π'.map_comp, ← CategoryTheory.Category.assoc]
        exact congrArg (· ≫ R_π'.map γ_inv_ℓ)
          ((adj_π'.homEquiv_unit _ _ γ_hom_ℓ).symm.trans
            ((adj_π'.homEquiv _ _).apply_symm_apply u_hom_ℓ))
      rw [h_lhs_comp, h_rhs_id]
      apply (adj'.homEquiv A_ℓ (R_π'.obj (L_π'.obj (C_U'.obj A_ℓ)))).injective
      rw [adj'.homEquiv_unit, adj'.homEquiv_unit]
      let g_B := (hT_U''.from (B_π'.obj T_U')).op
      have h₁ : adj'.unit.app A_ℓ ≫ u_hom_ℓ.hom.app (Opposite.op T_U') =
          adj''.unit.app A_ℓ ≫ (C_U''.obj A_ℓ).obj.map g_B := hu_hom_unit
      have h₂ : (C_U''.obj A_ℓ).obj.map g_B ≫ γ_inv_ℓ.hom.app (Opposite.op (B_π'.obj T_U')) =
          γ_inv_ℓ.hom.app (Opposite.op T_U'') ≫
            (C_U'.obj A_ℓ).obj.map (F_π'.map (hT_U''.from (B_π'.obj T_U'))).op :=
        γ_inv_ℓ.hom.naturality g_B
      have h₃ : adj''.unit.app A_ℓ ≫ γ_inv_ℓ.hom.app (Opposite.op T_U'') =
          adj'.unit.app A_ℓ ≫ (C_U'.obj A_ℓ).obj.map pi_et'.op := hγ_inv_unit
      have h₄ : (C_U'.obj A_ℓ).obj.map pi_et'.op ≫
          (C_U'.obj A_ℓ).obj.map (F_π'.map (hT_U''.from (B_π'.obj T_U'))).op =
          (C_U'.obj A_ℓ).obj.map (adj_π'0.counit.app T_U').op := by
        rw [← (C_U'.obj A_ℓ).obj.map_comp, ← op_comp]
        exact congrArg (C_U'.obj A_ℓ).obj.map (congrArg Opposite.op (hT_U'.hom_ext _ _))
      have h_step₀ : adj'.unit.app A_ℓ ≫
          ((CategoryTheory.sheafSections U'.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op T_U')).map (u_hom_ℓ ≫ R_π'.map γ_inv_ℓ) =
          (adj'.unit.app A_ℓ ≫ u_hom_ℓ.hom.app (Opposite.op T_U')) ≫
            (γ_inv_ℓ.hom.app (Opposite.op (B_π'.obj T_U')) :
              (C_U''.obj A_ℓ).obj.obj (Opposite.op (B_π'.obj T_U')) ⟶
                (C_U'.obj A_ℓ).obj.obj (Opposite.op (F_π'.obj (B_π'.obj T_U')))) := rfl
      exact h_step₀.trans
        ((congrArg (· ≫ _) h₁).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (adj''.unit.app A_ℓ ≫ ·) h₂).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ _) h₃).trans
                  ((CategoryTheory.Category.assoc _ _ _).trans
                    (congrArg (adj'.unit.app A_ℓ ≫ ·) h₄)))))))

    haveI : CategoryTheory.IsIso γ_inv_ℓ := ⟨⟨γ_hom_ℓ, hγ_inv_hom, hγ_hom_inv⟩⟩

    have h_γ_ψ : γ_inv_ℓ ≫ L_π'.map ψ_r = ω_bar.inv := by
      apply (adj''.homEquiv A_ℓ (L_π'.obj 𝒬_r)).injective
      rw [adj''.homEquiv_unit, adj''.homEquiv_unit]
      have h_step₀ : adj''.unit.app A_ℓ ≫
          ((CategoryTheory.sheafSections U''.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op T_U'')).map (γ_inv_ℓ ≫ L_π'.map ψ_r) =
          (adj''.unit.app A_ℓ ≫ γ_inv_ℓ.hom.app (Opposite.op T_U'')) ≫
            (ψ_r.hom.app (Opposite.op (F_π'.obj T_U'')) :
              (C_U'.obj A_ℓ).obj.obj (Opposite.op (F_π'.obj T_U'')) ⟶
                𝒬_r.obj.obj (Opposite.op (F_π'.obj T_U''))) := rfl
      have h₂ : (C_U'.obj A_ℓ).obj.map pi_et'.op ≫
          ψ_r.hom.app (Opposite.op (F_π'.obj T_U'')) =
          ψ_r.hom.app (Opposite.op T_U') ≫ 𝒬_r.obj.map pi_et'.op :=
        ψ_r.hom.naturality pi_et'.op
      exact h_step₀.trans
        ((congrArg (· ≫ _) hγ_inv_unit).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (adj'.unit.app A_ℓ ≫ ·) h₂).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ 𝒬_r.obj.map pi_et'.op) hψ_unit).trans hg_gen_spec)))))

    have h_Lψ_iso : CategoryTheory.IsIso (L_π'.map ψ_r) := by
      have h_eq : L_π'.map ψ_r = γ_hom_ℓ ≫ ω_bar.inv := by
        rw [← h_γ_ψ, ← CategoryTheory.Category.assoc, hγ_hom_inv,
          CategoryTheory.Category.id_comp]
      rw [h_eq]
      refine ⟨⟨ω_bar.hom ≫ γ_inv_ℓ, ?_, ?_⟩⟩
      · rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc ω_bar.inv,
          ω_bar.inv_hom_id, CategoryTheory.Category.id_comp, hγ_hom_inv]
      · rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc γ_inv_ℓ,
          hγ_inv_hom, CategoryTheory.Category.id_comp, ω_bar.hom_inv_id]
    haveI : CategoryTheory.IsIso ψ_r :=
      CategoryTheory.isIso_of_reflects_iso ψ_r L_π'

    let g_step : 𝒩 r.succ ⟶ weilEtaleTorsionSheaf U' ℓ :=
      p_r ≫ CategoryTheory.inv ψ_r
    have h_comp_zero : ι_r ≫ g_step = 0 := by
      dsimp [g_step, p_r]
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.condition,
        CategoryTheory.Limits.zero_comp]
    let S_r := CategoryTheory.ShortComplex.mk ι_r g_step h_comp_zero
    have h_desc_eq : CategoryTheory.Limits.cokernel.desc ι_r g_step h_comp_zero =
        CategoryTheory.inv ψ_r := by
      apply (CategoryTheory.cancel_epi p_r).mp
      exact CategoryTheory.Limits.cokernel.π_desc ι_r g_step h_comp_zero
    have h_exact_Sr : S_r.Exact := by
      rw [CategoryTheory.ShortComplex.exact_iff_mono_cokernel_desc]
      dsimp [S_r]
      rw [h_desc_eq]
      infer_instance
    have h_epi_g : CategoryTheory.Epi S_r.g := by
      dsimp [S_r, g_step]
      exact CategoryTheory.epi_comp p_r (CategoryTheory.inv ψ_r)
    have h_mono_f : CategoryTheory.Mono S_r.f := by
      dsimp [S_r]
      infer_instance
    exact ⟨S_r, CategoryTheory.ShortComplex.ShortExact.mk' h_exact_Sr h_mono_f h_epi_g,
      rfl, rfl, rfl⟩

  exact ⟨ℳ, m_len, 𝒩, hPullM, hRetractL, hZero_N0, hIso_Nlast, hFilt⟩

theorem weil_etale_sylow_trace_constructible_devissage (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType X.hom]
    [AlgebraicGeometry.QuasiCompact X.hom]
    [AlgebraicGeometry.IsSeparated X.hom]
    (P : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u} → Prop)
    (hZero : ∀ F, CategoryTheory.Limits.IsZero F → P F)
    (hRetract : ∀ F₁ F₂ (i : F₁ ⟶ F₂) (r : F₂ ⟶ F₁), i ≫ r = 𝟙 F₁ → P F₂ → P F₁)
    (hExact : ∀ (S : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})),
        S.ShortExact → ℓ • 𝟙 S.X₂ = 0 →
        ((P S.X₁ ∧ P S.X₃ → P S.X₂) ∧ (P S.X₂ ∧ P S.X₃ → P S.X₁)))
    (hFinGen : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (π : Y ⟶ X.left),
        AlgebraicGeometry.IsIntegral Y →
        AlgebraicGeometry.IsFinite π →
        P (weilEtaleHigherDirectImage π 0 (weilEtaleTorsionSheaf Y ℓ))) :
    ∀ (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsConstructibleModPrimeSheaf ℓ X.left F → P F :=
by
  have hFinAll :=
    weil_etale_finite_pushforward_torsion_prop k ℓ hPBC X P hZero hRetract hExact hFinGen
  obtain ⟨hBase, hRed, hPullRestr, hBridge⟩ :=
    weil_etale_constructible_excision_and_trace_bridge k ℓ hPBC X
  have : IsNoetherianRing k := inferInstance
  have : IsNoetherianRing ↑(CommRingCat.of k) := inferInstance
  have : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    inferInstance
  have : AlgebraicGeometry.IsLocallyNoetherian X.left :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian X.hom
  have : CompactSpace ↥X.left :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace X.hom
  have : AlgebraicGeometry.IsNoetherian X.left := AlgebraicGeometry.IsNoetherian.mk
  have hInd : ∀ (C : TopologicalSpace.Closeds ↥X.left)
      (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsConstructibleModPrimeSheaf ℓ X.left F →
      (∀ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ X.left) [AlgebraicGeometry.Etale w],
        Set.range w.base ⊆ (C : Set ↥X.left)ᶜ →
        Subsingleton ↥(F.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk w)))) →
      P F := by
    intro C₀
    refine @WellFoundedLT.induction (TopologicalSpace.Closeds ↥X.left) _ _
      (fun C => ∀ (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsConstructibleModPrimeSheaf ℓ X.left F →
        (∀ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ X.left) [AlgebraicGeometry.Etale w],
          Set.range w.base ⊆ (C : Set ↥X.left)ᶜ →
          Subsingleton ↥(F.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk w)))) →
        P F) C₀ ?_
    intro C ih F hF hVan
    by_cases hEmpty : (C : Set ↥X.left) = ∅
    · have hC_bot : C = ⊥ := SetLike.ext' hEmpty
      subst hC_bot
      exact hZero F (hBase F hVan)
    · have hNonempty : (C : Set ↥X.left).Nonempty := Set.nonempty_iff_ne_empty.mpr hEmpty
      by_cases hPre : IsPreirreducible (C : Set ↥X.left)
      · have hIrr : IsIrreducible (C : Set ↥X.left) := ⟨hNonempty, hPre⟩
        let I_C := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C
        have hSupp : I_C.support = C :=
          SetLike.ext' (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal C)
        have hRadEq : I_C.radical = I_C := by
          rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support, hSupp]
        have hCl : AlgebraicGeometry.IsClosedImmersion I_C.subschemeι := inferInstance
        have hEmb : Topology.IsClosedEmbedding ⇑I_C.subschemeι.base :=
          ((AlgebraicGeometry.isClosedImmersion_iff I_C.subschemeι).mp hCl).2
        have hRange : Set.range ⇑I_C.subschemeι.base = (C : Set ↥X.left) := by
          rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι, hSupp]
        have hIntY₀ : AlgebraicGeometry.IsIntegral I_C.subscheme := by
          have : Nonempty ↥I_C.subscheme := by
            obtain ⟨x, hxC⟩ := hIrr.1
            rw [← hRange] at hxC
            obtain ⟨y, -⟩ := hxC
            exact ⟨y⟩
          have : PreirreducibleSpace ↥I_C.subscheme := by
            refine ⟨fun u v hu hv ⟨y₁, _, hy₁⟩ ⟨y₂, _, hy₂⟩ => ?_⟩
            rw [hEmb.toIsEmbedding.isOpen_iff] at hu hv
            obtain ⟨U', hU', rfl⟩ := hu
            obtain ⟨V', hV', rfl⟩ := hv
            have h₁ : ((C : Set ↥X.left) ∩ U').Nonempty :=
              ⟨I_C.subschemeι.base y₁, hRange ▸ ⟨y₁, rfl⟩, hy₁⟩
            have h₂ : ((C : Set ↥X.left) ∩ V').Nonempty :=
              ⟨I_C.subschemeι.base y₂, hRange ▸ ⟨y₂, rfl⟩, hy₂⟩
            obtain ⟨z, hzC, hzU, hzV⟩ := hIrr.2 U' V' hU' hV' h₁ h₂
            rw [← hRange] at hzC
            obtain ⟨y₃, rfl⟩ := hzC
            exact ⟨y₃, trivial, hzU, hzV⟩
          have : IrreducibleSpace ↥I_C.subscheme :=
            { toPreirreducibleSpace := inferInstance, toNonempty := inferInstance }
          have hRedChart : ∀ (U : ↑X.left.affineOpens),
              AlgebraicGeometry.IsReduced
                (AlgebraicGeometry.Spec (CommRingCat.of
                  (↑(X.left.presheaf.obj (Opposite.op U.1)) ⧸ I_C.ideal U))) := by
            intro U
            have hRadU : (I_C.ideal U).IsRadical := by
              intro x hx
              have hx' : x ∈ I_C.radical.ideal U := by
                rwa [AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal]
              rwa [hRadEq] at hx'
            rw [AlgebraicGeometry.affine_isReduced_iff]
            exact (Ideal.isRadical_iff_quotient_reduced (I_C.ideal U)).mp hRadU
          have : ∀ (i : I_C.subschemeCover.openCover.I₀),
              AlgebraicGeometry.IsReduced (I_C.subschemeCover.openCover.X i) :=
            fun U => hRedChart U
          have : AlgebraicGeometry.IsReduced I_C.subscheme :=
            AlgebraicGeometry.IsReduced.of_openCover I_C.subscheme I_C.subschemeCover.openCover
          exact (AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced I_C.subscheme).mpr
            ⟨inferInstance, inferInstance⟩
        obtain ⟨U₀, hU₀, V₀, p₀, A, hFin₀, hEt₀, hSurj₀, hFinA, hTorA, hPull₀⟩ :=
          hF.2 I_C.subscheme I_C.subschemeι hCl hIntY₀
        obtain ⟨U₂, hU₂, Y', U'', ν, π', q₀, I_G, S_idx, H,
            hFinIG, hFinS, hGrpH, hFinH,
            actG, secS, γ_G, actH, γ_H,
            hIntY', hFin_ν, hFin_f, hEt_f, hSurj_f, hInt_U'', hEt_π', hSurj_π',
            hComm, hCoprime, hPGrp, hSec, hPerm, hγG, hCovG,
            hActH_hom, hActH_one, hActH_mul, hγH, hCovH⟩ :=
          weil_etale_galois_sylow_cover_and_normalization k ℓ X I_C.subscheme I_C.subschemeι
            hCl hIntY₀ U₀ hU₀ V₀ p₀ hFin₀ hEt₀ hSurj₀
        let : Fintype I_G := hFinIG
        let : Fintype S_idx := hFinS
        let : Group H := hGrpH
        let : Fintype H := hFinH
        obtain ⟨ℒ, hTorL, hPullL, hTriv⟩ :=
          hPullRestr C U₀ U₂ V₀ U'' p₀ (π' ≫ (ν ∣_ U₂)) q₀ A F hComm hF.1 hPull₀
        obtain ⟨ℳ, m, 𝒩, hPullM, hRetL, hZero0, hIsoLast, hFilt⟩ :=
          weil_etale_sylow_trace_retract_and_pgroup_filtration ℓ
            U₂.toScheme (ν ⁻¹ᵁ U₂).toScheme U'' (ν ∣_ U₂) π'
            hEt_f hSurj_f hInt_U'' hEt_π' hSurj_π'
            I_G S_idx H hCoprime hPGrp actG secS γ_G hSec hPerm hγG hCovG
            actH γ_H hActH_hom hActH_one hActH_mul hγH hCovH
            A hFinA hTorA ℒ hTorL hTriv
        obtain ⟨C_bad, F_bad, hLt_bad, hConst_bad, hVan_bad, hClose⟩ :=
          hBridge P hZero hRetract hExact hFinAll C U₂ hU₂ Y' ν hFin_ν F hF hVan
        exact hClose (ih C_bad hLt_bad F_bad hConst_bad hVan_bad)
          ℒ ℳ m 𝒩 hTorL hPullL hPullM hRetL hZero0 hIsoLast hFilt
      · unfold IsPreirreducible at hPre
        push Not at hPre
        obtain ⟨u, v, hu, hv, hsu, hsv, hsuv⟩ := hPre
        let C₁ : TopologicalSpace.Closeds ↥X.left :=
          ⟨(C : Set ↥X.left) \ u, C.isClosed.sdiff hu⟩
        let C₂ : TopologicalSpace.Closeds ↥X.left :=
          ⟨(C : Set ↥X.left) \ v, C.isClosed.sdiff hv⟩
        have hC₁_lt : C₁ < C := by
          refine lt_of_le_not_ge (fun _ hx => hx.1) ?_
          intro hle
          obtain ⟨x, hxC, hxu⟩ := hsu
          exact (hle hxC).2 hxu
        have hC₂_lt : C₂ < C := by
          refine lt_of_le_not_ge (fun _ hx => hx.1) ?_
          intro hle
          obtain ⟨y, hyC, hyv⟩ := hsv
          exact (hle hyC).2 hyv
        have hEq : C = C₁ ⊔ C₂ := by
          apply SetLike.ext'
          ext z
          change z ∈ (C : Set ↥X.left) ↔
            z ∈ ((C : Set ↥X.left) \ u) ∪ ((C : Set ↥X.left) \ v)
          constructor
          · intro hzC
            by_cases hzu : z ∈ u
            · right
              refine ⟨hzC, fun hzv => ?_⟩
              exact Set.not_nonempty_iff_eq_empty.mpr hsuv ⟨z, hzC, hzu, hzv⟩
            · left
              exact ⟨hzC, hzu⟩
          · rintro (⟨hzC, -⟩ | ⟨hzC, -⟩) <;> exact hzC
        obtain ⟨F₁, F₃, S, hSE, hX₁, hX₂, hX₃, hConst₁, hVan₁, hConst₃, hVan₃⟩ :=
          hRed C C₁ C₂ F hEq hF hVan
        have hPF₁ : P S.X₁ := hX₁.symm ▸ ih C₂ hC₂_lt F₁ hConst₁ hVan₁
        have hPF₃ : P S.X₃ := hX₃.symm ▸ ih C₁ hC₁_lt F₃ hConst₃ hVan₃
        have hTorS₂ : ℓ • 𝟙 S.X₂ = 0 := by
          rw [hX₂]
          exact hF.1
        have hPS₂ : P S.X₂ := (hExact S hSE hTorS₂).1 ⟨hPF₁, hPF₃⟩
        rwa [hX₂] at hPS₂
  intro F hF
  refine hInd ⊤ F hF ?_
  intro W w _ hw
  let E : X.left.Etale := AlgebraicGeometry.Scheme.Etale.mk w
  have hEmptyW : IsEmpty ↥E.left :=
    ⟨fun x => hw (by exact ⟨x, rfl⟩) trivial⟩
  have hBot : (⊥ : CategoryTheory.Sieve E) ∈ X.left.smallEtaleTopology E := by
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let 𝒰₀ : CategoryTheory.PreZeroHypercover E.left :=
      { I₀ := PEmpty.{u + 1}
        X := fun i => PEmpty.elim i
        f := fun i => PEmpty.elim i }
    have hmem₀ : 𝒰₀.presieve₀ ∈ (AlgebraicGeometry.Scheme.precoverage P_et).coverings E.left :=
      (AlgebraicGeometry.Scheme.presieve₀_mem_precoverage_iff 𝒰₀).mpr
        ⟨fun x => hEmptyW.elim x, fun i => PEmpty.elim i⟩
    refine (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology (P := P_et) E ⊥).mpr ?_
    refine ⟨{ toPreZeroHypercover := 𝒰₀, mem₀ := hmem₀ },
      @AlgebraicGeometry.Scheme.Cover.Over.mk X.left P_et _ _ E.left _
        { toPreZeroHypercover := 𝒰₀, mem₀ := hmem₀ }
        (fun j => PEmpty.elim j) (fun j => PEmpty.elim j),
      fun j => PEmpty.elim j, ?_⟩
    rintro _ _ ⟨i⟩
    exact PEmpty.elim i
  have hZeroE : CategoryTheory.Limits.IsZero (F.obj.obj (Opposite.op E)) :=
    (CategoryTheory.Sheaf.isTerminalOfBotCover F E hBot).isZero
  refine ⟨fun a b => ?_⟩
  have hid : CategoryTheory.CategoryStruct.id (F.obj.obj (Opposite.op E)) = 0 :=
    CategoryTheory.Limits.IsZero.eq_of_src hZeroE _ _
  calc
    a = (CategoryTheory.CategoryStruct.id (F.obj.obj (Opposite.op E))) a := rfl
    _ = (0 : F.obj.obj (Opposite.op E) ⟶ F.obj.obj (Opposite.op E)) a := by rw [hid]
    _ = 0 := rfl
    _ = (0 : F.obj.obj (Opposite.op E) ⟶ F.obj.obj (Opposite.op E)) b := rfl
    _ = (CategoryTheory.CategoryStruct.id (F.obj.obj (Opposite.op E))) b := by rw [hid]
    _ = b := rfl

theorem weil_strict_local_etale_filtered_colimit (R : Type u) [CommRing R] (p : PrimeSpectrum R) :
    ∃ (J : Type u) (_ : CategoryTheory.SmallCategory J) (_ : CategoryTheory.IsFiltered J)
      (F : CategoryTheory.Functor J CommRingCat.{u})
      (_ : ∀ j : J, Algebra R (F.obj j))
      (_ : ∀ j : J, Algebra.Etale R (F.obj j))
      (c : CategoryTheory.Limits.Cocone F)
      (_ : Algebra R c.pt) (_ : IsLocalRing c.pt),
      (∀ (j₁ j₂ : J) (u : Quiver.Hom j₁ j₂) (r₀ : R),
        (F.map u).hom (algebraMap R (F.obj j₁) r₀) = algebraMap R (F.obj j₂) r₀) ∧
      (∀ (j : J) (r₀ : R), (c.ι.app j).hom (algebraMap R (F.obj j) r₀) = algebraMap R c.pt r₀) ∧
      Nonempty (CategoryTheory.Limits.IsColimit c) ∧
      PrimeSpectrum.comap (algebraMap R c.pt) (IsLocalRing.closedPoint c.pt) = p ∧
      IsSepClosed (IsLocalRing.ResidueField c.pt) ∧
      (∀ (m : ℕ) (F_sys : Fin m → MvPolynomial (Fin m) c.pt) (a₀ : Fin m → c.pt),
        (∀ b : Fin m, MvPolynomial.eval a₀ (F_sys b) ∈ IsLocalRing.maximalIdeal c.pt) →
        IsUnit ((Matrix.of (fun a b : Fin m =>
          MvPolynomial.eval a₀ (MvPolynomial.pderiv a (F_sys b)))).det) →
        ∃ a : Fin m → c.pt,
          (∀ b : Fin m, MvPolynomial.eval a (F_sys b) = 0) ∧
          (∀ a_idx : Fin m, a a_idx - a₀ a_idx ∈ IsLocalRing.maximalIdeal c.pt)) :=
by
  classical
  have : p.asIdeal.IsPrime := p.isPrime
  let κ : Type u := p.asIdeal.ResidueField
  let Ω : Type u := AlgebraicClosure κ
  let φ₀ : R →+* Ω := (algebraMap κ Ω).comp (algebraMap R κ)
  have hker₀ : RingHom.ker φ₀ = p.asIdeal := by
    have hker_κ : RingHom.ker (algebraMap R κ) = p.asIdeal :=
      Ideal.ker_algebraMap_residueField p.asIdeal
    ext r₀
    have h1 : r₀ ∈ RingHom.ker φ₀ ↔ r₀ ∈ RingHom.ker (algebraMap R κ) :=
      map_eq_zero_iff (algebraMap κ Ω) (algebraMap κ Ω).injective
    exact h1.trans (SetLike.ext_iff.mp hker_κ r₀)
  
  have hStage1 :
      ∃ (J : Type u) (_ : CategoryTheory.SmallCategory J) (_ : CategoryTheory.IsFiltered J)
        (F : CategoryTheory.Functor J CommRingCat.{u})
        (_ : ∀ j : J, Algebra R (F.obj j))
        (_ : ∀ j : J, Algebra.Etale R (F.obj j))
        (φ : ∀ j : J, F.obj j →+* Ω),
        (∀ (j₁ j₂ : J) (u : Quiver.Hom j₁ j₂) (r₀ : R),
          (F.map u).hom (algebraMap R (F.obj j₁) r₀) = algebraMap R (F.obj j₂) r₀) ∧
        (∀ (j₁ j₂ : J) (u : Quiver.Hom j₁ j₂), (φ j₂).comp (F.map u).hom = φ j₁) ∧
        (∀ (j : J) (r₀ : R), φ j (algebraMap R (F.obj j) r₀) = φ₀ r₀) ∧
        (∀ (j₀ : J) (S : Type u) [CommRing S] [Algebra (F.obj j₀) S] [Algebra.Etale (F.obj j₀) S]
            (ψ_S : S →+* Ω),
          ψ_S.comp (algebraMap (F.obj j₀) S) = φ j₀ →
          ∃ (j₁ : J) (u : Quiver.Hom j₀ j₁) (σ : S →+* F.obj j₁),
            (φ j₁).comp σ = ψ_S ∧
            σ.comp (algebraMap (F.obj j₀) S) = (F.map u).hom) := by
    let J : Type u :=
      Σ (n : ℕ) (I_rel : Ideal (MvPolynomial (Fin n) R)),
        { φ : (MvPolynomial (Fin n) R ⧸ I_rel) →+* Ω //
          Algebra.Etale R (MvPolynomial (Fin n) R ⧸ I_rel) ∧
          φ.comp (algebraMap R (MvPolynomial (Fin n) R ⧸ I_rel)) = φ₀ }
    let RingOf : J → Type u := fun j => MvPolynomial (Fin j.1) R ⧸ j.2.1
    let φOf : ∀ j : J, RingOf j →+* Ω := fun j => j.2.2.1
    let instCatJ : CategoryTheory.SmallCategory J :=
      { Hom := fun j₁ j₂ =>
          { f : RingOf j₁ →ₐ[R] RingOf j₂ // (φOf j₂).comp f.toRingHom = φOf j₁ }
        id := fun j => ⟨AlgHom.id R (RingOf j), RingHom.comp_id (φOf j)⟩
        comp := fun f g =>
          ⟨g.1.comp f.1, RingHom.ext fun x => by
            have hg := RingHom.congr_fun g.2 (f.1 x)
            have hf := RingHom.congr_fun f.2 x
            exact hg.trans hf⟩
        id_comp := fun f => Subtype.ext (AlgHom.id_comp f.1)
        comp_id := fun f => Subtype.ext (AlgHom.comp_id f.1)
        assoc := fun f g h => Subtype.ext (AlgHom.comp_assoc h.1 g.1 f.1).symm }
    let _ : CategoryTheory.SmallCategory J := instCatJ
    let F : CategoryTheory.Functor J CommRingCat.{u} :=
      { obj := fun j => CommRingCat.of (RingOf j)
        map := fun f => CommRingCat.ofHom f.1.toRingHom
        map_id := fun _ => CommRingCat.ofHom_id
        map_comp := fun f g => (CommRingCat.ofHom_comp f.1.toRingHom g.1.toRingHom).symm }
    let instAlgF : ∀ j : J, Algebra R (F.obj j) := fun j =>
      (inferInstance : Algebra R (RingOf j))
    let _ : ∀ j : J, Algebra R (F.obj j) := instAlgF
    have hEtF : ∀ j : J, Algebra.Etale R (F.obj j) := fun j => j.2.2.2.1
    have encodeEtale : ∀ (S : Type u) [CommRing S] [Algebra R S] [Algebra.Etale R S]
        (ψ : S →+* Ω),
        ψ.comp (algebraMap R S) = φ₀ →
        ∃ (j : J) (e : RingOf j ≃ₐ[R] S),
          (φOf j).comp e.symm.toRingHom = ψ := by
      intro S _ _ _ ψ hψ
      have hFT : Algebra.FiniteType R S := inferInstance
      obtain ⟨s, hs⟩ := hFT.out
      let n : ℕ := Fintype.card ↥s
      let e_fin : Fin n ≃ ↥s := (Fintype.equivFin ↥s).symm
      let gen : Fin n → S := fun i => (e_fin i).1
      let ev : MvPolynomial (Fin n) R →ₐ[R] S := MvPolynomial.aeval gen
      have h_surj : Function.Surjective ev := by
        intro y
        have hy_top : y ∈ (⊤ : Subalgebra R S) := Algebra.mem_top
        rw [← hs] at hy_top
        have h_le : Algebra.adjoin R (s : Set S) ≤ ev.range := by
          apply Algebra.adjoin_le
          intro z hz
          refine ⟨MvPolynomial.X (e_fin.symm ⟨z, hz⟩), ?_⟩
          simp [ev, gen]
        exact h_le hy_top
      let e_S := Ideal.quotientKerAlgEquivOfSurjective h_surj
      let I_S : Ideal (MvPolynomial (Fin n) R) := RingHom.ker ev
      have hEt_quot : Algebra.Etale R (MvPolynomial (Fin n) R ⧸ I_S) :=
        Algebra.Etale.of_equiv e_S.symm
      let φ_S : (MvPolynomial (Fin n) R ⧸ I_S) →+* Ω := ψ.comp e_S.toRingHom
      have hφ_S : φ_S.comp (algebraMap R (MvPolynomial (Fin n) R ⧸ I_S)) = φ₀ :=
        RingHom.ext fun r₀ => by
          change ψ (e_S (algebraMap R _ r₀)) = φ₀ r₀
          rw [e_S.commutes, ← RingHom.comp_apply, hψ]
      refine ⟨⟨n, I_S, ⟨φ_S, hEt_quot, hφ_S⟩⟩, e_S, RingHom.ext fun y => ?_⟩
      change ψ (e_S (e_S.symm y)) = ψ y
      rw [e_S.apply_symm_apply]
    have hFiltOrEmpty : CategoryTheory.IsFilteredOrEmpty J :=
      { cocone_objs := fun j₁ j₂ => by
          let A₁ : Type u := RingOf j₁
          let A₂ : Type u := RingOf j₂
          have : Algebra.Etale R A₁ := j₁.2.2.2.1
          have : Algebra.Etale R A₂ := j₂.2.2.2.1
          let T : Type u := TensorProduct R A₁ A₂
          have : Algebra.Etale A₁ T := Algebra.Etale.baseChange R A₂ A₁
          have : Algebra.Etale R T := Algebra.Etale.comp R A₁ T
          let _ : Algebra R Ω := φ₀.toAlgebra
          let α₁ : A₁ →ₐ[R] Ω :=
            { φOf j₁ with commutes' := fun r₀ => RingHom.congr_fun j₁.2.2.2.2 r₀ }
          let α₂ : A₂ →ₐ[R] Ω :=
            { φOf j₂ with commutes' := fun r₀ => RingHom.congr_fun j₂.2.2.2.2 r₀ }
          let ψ_alg : T →ₐ[R] Ω :=
            Algebra.TensorProduct.lift α₁ α₂ (fun _ _ => Commute.all _ _)
          have hψ_T : ψ_alg.toRingHom.comp (algebraMap R T) = φ₀ :=
            RingHom.ext fun r₀ => ψ_alg.commutes r₀
          obtain ⟨j₃, e_T, he_T⟩ := encodeEtale T ψ_alg.toRingHom hψ_T
          let u₁ : Quiver.Hom j₁ j₃ :=
            ⟨e_T.symm.toAlgHom.comp Algebra.TensorProduct.includeLeft,
              RingHom.ext fun x => by
                have h1 : φOf j₃ (e_T.symm (x ⊗ₜ[R] (1 : A₂))) = ψ_alg (x ⊗ₜ[R] (1 : A₂)) :=
                  RingHom.congr_fun he_T (x ⊗ₜ[R] (1 : A₂))
                change φOf j₃ (e_T.symm (x ⊗ₜ[R] (1 : A₂))) = φOf j₁ x
                rw [h1]
                dsimp only [ψ_alg]
                rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
                rfl⟩
          let u₂ : Quiver.Hom j₂ j₃ :=
            ⟨e_T.symm.toAlgHom.comp
                (Algebra.TensorProduct.includeRight (R := R) (A := A₁) (B := A₂)),
              RingHom.ext fun y => by
                have h2 : φOf j₃ (e_T.symm ((1 : A₁) ⊗ₜ[R] y)) = ψ_alg ((1 : A₁) ⊗ₜ[R] y) :=
                  RingHom.congr_fun he_T ((1 : A₁) ⊗ₜ[R] y)
                change φOf j₃ (e_T.symm ((1 : A₁) ⊗ₜ[R] y)) = φOf j₂ y
                rw [h2]
                dsimp only [ψ_alg]
                rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
                rfl⟩
          exact ⟨j₃, u₁, u₂, trivial⟩
        cocone_maps := fun {j₁ j₂} f₁ f₂ => by
          let A₁ : Type u := RingOf j₁
          let A₂ : Type u := RingOf j₂
          have : Algebra.Etale R A₁ := j₁.2.2.2.1
          have : Algebra.Etale R A₂ := j₂.2.2.2.1
          let t : TensorProduct R A₁ A₁ := Algebra.FormallyUnramified.elem R A₁
          let ψ₁₂ : TensorProduct R A₁ A₁ →ₐ[R] A₂ :=
            Algebra.TensorProduct.lift f₁.1 f₂.1 (fun _ _ => Commute.all _ _)
          let g : A₂ := ψ₁₂ t
          have hg_one : φOf j₂ g = 1 := by
            let _ : Algebra R Ω := φ₀.toAlgebra
            let α₁ : A₁ →ₐ[R] Ω :=
              { φOf j₁ with commutes' := fun r₀ => RingHom.congr_fun j₁.2.2.2.2 r₀ }
            let α₂ : A₂ →ₐ[R] Ω :=
              { φOf j₂ with commutes' := fun r₀ => RingHom.congr_fun j₂.2.2.2.2 r₀ }
            have h_eq_alg : α₂.comp ψ₁₂ = α₁.comp (Algebra.TensorProduct.lmul' R (S := A₁)) := by
              apply Algebra.TensorProduct.ext'
              intro x y
              change φOf j₂ (f₁.1 x * f₂.1 y) = φOf j₁ (x * y)
              rw [map_mul, map_mul]
              have hx : φOf j₂ (f₁.1 x) = φOf j₁ x := RingHom.congr_fun f₁.2 x
              have hy : φOf j₂ (f₂.1 y) = φOf j₁ y := RingHom.congr_fun f₂.2 y
              rw [hx, hy]
            have h_eval := AlgHom.congr_fun h_eq_alg t
            change φOf j₂ g = φOf j₁ (Algebra.TensorProduct.lmul' R t) at h_eval
            rw [Algebra.FormallyUnramified.lmul_elem, map_one] at h_eval
            exact h_eval
          have hg_eq : ∀ s : A₁, f₂.1 s * g = f₁.1 s * g := by
            intro s
            have hm := congrArg ψ₁₂ (Algebra.FormallyUnramified.one_tmul_mul_elem (R := R) s)
            rw [map_mul, map_mul] at hm
            change ψ₁₂ (1 ⊗ₜ[R] s) * g = ψ₁₂ (s ⊗ₜ[R] 1) * g at hm
            dsimp only [ψ₁₂] at hm
            rw [Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul,
              map_one, one_mul, map_one, mul_one] at hm
            exact hm
          let L : Type u := Localization.Away g
          have : Algebra.Etale A₂ L := Algebra.Etale.of_isLocalizationAway g
          have : Algebra.Etale R L := Algebra.Etale.comp R A₂ L
          have hg_unit : IsUnit (φOf j₂ g) := by
            rw [hg_one]
            exact isUnit_one
          let ψ_L : L →+* Ω := IsLocalization.Away.lift (S := L) g hg_unit
          have hψ_L_A₂ : ψ_L.comp (algebraMap A₂ L) = φOf j₂ :=
            RingHom.ext fun y => IsLocalization.Away.lift_eq (S := L) g hg_unit y
          have hψ_L_R : ψ_L.comp (algebraMap R L) = φ₀ := by
            rw [IsScalarTower.algebraMap_eq R A₂ L, ← RingHom.comp_assoc, hψ_L_A₂]
            exact j₂.2.2.2.2
          obtain ⟨j₃, e_L, he_L⟩ := encodeEtale L ψ_L hψ_L_R
          let w : Quiver.Hom j₂ j₃ :=
            ⟨e_L.symm.toAlgHom.comp (IsScalarTower.toAlgHom R A₂ L),
              RingHom.ext fun y => by
                have hy := RingHom.congr_fun he_L (algebraMap A₂ L y)
                exact hy.trans (IsLocalization.Away.lift_eq (S := L) g hg_unit y)⟩
          refine ⟨j₃, w, ?_⟩
          apply Subtype.ext
          apply AlgHom.ext
          intro s
          change e_L.symm (algebraMap A₂ L (f₁.1 s)) = e_L.symm (algebraMap A₂ L (f₂.1 s))
          congr 1
          apply (IsLocalization.Away.algebraMap_isUnit (S := L) g).mul_right_cancel
          rw [← map_mul, ← map_mul, hg_eq s] }
    have hNonemptyJ : Nonempty J := by
      obtain ⟨j₀, _, _⟩ := encodeEtale R φ₀ (RingHom.comp_id φ₀)
      exact ⟨j₀⟩
    have hFiltJ : CategoryTheory.IsFiltered J :=
      { toIsFilteredOrEmpty := hFiltOrEmpty
        nonempty := hNonemptyJ }
    refine ⟨J, instCatJ, hFiltJ, F, instAlgF, hEtF, φOf,
      fun _ _ u r₀ => u.1.commutes r₀,
      fun _ _ u => u.2,
      fun j r₀ => RingHom.congr_fun j.2.2.2.2 r₀, ?_⟩
    intro j₀ S _ _ _ ψ_S hψ_S
    have : Algebra.Etale R (F.obj j₀) := hEtF j₀
    let _ : Algebra R S := ((algebraMap (F.obj j₀) S).comp (algebraMap R (F.obj j₀))).toAlgebra
    have : IsScalarTower R (F.obj j₀) S :=
      ⟨fun x y z => by
        rw [Algebra.smul_def x y, Algebra.smul_def, Algebra.smul_def y z,
          map_mul, mul_assoc]
        rfl⟩
    have : Algebra.Etale R S := Algebra.Etale.comp R (F.obj j₀) S
    have hψ_R : ψ_S.comp (algebraMap R S) = φ₀ := by
      rw [IsScalarTower.algebraMap_eq R (F.obj j₀) S, ← RingHom.comp_assoc, hψ_S]
      exact j₀.2.2.2.2
    obtain ⟨j₁, e_S, he_S⟩ := encodeEtale S ψ_S hψ_R
    let σ : S →+* F.obj j₁ := e_S.symm.toRingHom
    let u_alg : RingOf j₀ →ₐ[R] RingOf j₁ :=
      e_S.symm.toAlgHom.comp (IsScalarTower.toAlgHom R (F.obj j₀) S)
    have hu_φ : (φOf j₁).comp u_alg.toRingHom = φOf j₀ := by
      change ((φOf j₁).comp σ).comp (algebraMap (F.obj j₀) S) = φOf j₀
      rw [he_S, hψ_S]
    exact ⟨j₁, ⟨u_alg, hu_φ⟩, σ, he_S, rfl⟩
  
  have hJacExt :
      ∀ (R₀ : Type u) [CommRing R₀] (φ_R₀ : R₀ →+* Ω)
        (m : ℕ) (G : Fin m → MvPolynomial (Fin m) R₀) (ω : Fin m → Ω),
        (∀ b : Fin m, MvPolynomial.eval₂ φ_R₀ ω (G b) = 0) →
        MvPolynomial.eval₂ φ_R₀ ω
          ((Matrix.of (fun a b : Fin m => MvPolynomial.pderiv a (G b))).det) ≠ 0 →
        ∃ (S : Type u) (_ : CommRing S) (_ : Algebra R₀ S) (_ : Algebra.Etale R₀ S)
          (ψ_S : S →+* Ω) (x_S : Fin m → S),
          ψ_S.comp (algebraMap R₀ S) = φ_R₀ ∧
          (∀ b : Fin m, MvPolynomial.aeval x_S (G b) = 0) ∧
          (∀ a : Fin m, ψ_S (x_S a) = ω a) := by
    intro R₀ _ φ_R₀ m G ω hZero hDet
    let I_G : Ideal (MvPolynomial (Fin m) R₀) := Ideal.span (Set.range G)
    let Q : Type u := MvPolynomial (Fin m) R₀ ⧸ I_G
    let ev₀ : MvPolynomial (Fin m) R₀ →+* Ω := MvPolynomial.eval₂Hom φ_R₀ ω
    have hI_le : ∀ a ∈ I_G, ev₀ a = 0 := by
      have h_le : I_G ≤ RingHom.ker ev₀ := by
        rw [Ideal.span_le]
        rintro _ ⟨b, rfl⟩
        exact hZero b
      intro a ha
      exact h_le ha
    let ψ_Q : Q →+* Ω := Ideal.Quotient.lift I_G ev₀ hI_le
    have hψ_Q_R₀ : ψ_Q.comp (algebraMap R₀ Q) = φ_R₀ :=
      RingHom.ext fun r₀ => by
        change Ideal.Quotient.lift I_G ev₀ hI_le (Ideal.Quotient.mk I_G (MvPolynomial.C r₀)) =
          φ_R₀ r₀
        rw [Ideal.Quotient.lift_mk]
        simp [ev₀]
    have h_exists_jQ : ∃ j_Q : Q, ψ_Q j_Q ≠ 0 ∧ Algebra.Etale R₀ (Localization.Away j_Q) := by
      let P₀ : Algebra.PreSubmersivePresentation R₀ Q (Fin m) (Fin m) :=
        Algebra.PreSubmersivePresentation.naive (v := G) id Function.injective_id
      have hψ_jac_ne : ψ_Q P₀.jacobian ≠ 0 := by
        rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
        have hmat : (P₀.jacobiMatrix : Matrix (Fin m) (Fin m) (MvPolynomial (Fin m) R₀)) =
            Matrix.of (fun a b : Fin m => MvPolynomial.pderiv a (G b)) := by
          apply Matrix.ext
          intro a b
          exact P₀.jacobiMatrix_apply a b
        change Ideal.Quotient.lift I_G ev₀ hI_le (Ideal.Quotient.mk I_G (P₀.jacobiMatrix :
          Matrix (Fin m) (Fin m) (MvPolynomial (Fin m) R₀)).det) ≠ 0
        rw [hmat, Ideal.Quotient.lift_mk]
        exact hDet
      let S₀ : Type u := Localization.Away P₀.jacobian
      let P₁_sub : Algebra.SubmersivePresentation Q S₀ Unit Unit :=
        Algebra.SubmersivePresentation.localizationAway S₀ P₀.jacobian
      let P₁ : Algebra.PreSubmersivePresentation Q S₀ Unit Unit :=
        P₁_sub.toPreSubmersivePresentation
      let P_comp := P₁.comp P₀
      have h_jac_unit : IsUnit P_comp.jacobian := by
        dsimp [P_comp]
        rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
          Algebra.smul_def]
        exact (IsLocalization.Away.algebraMap_isUnit (S := S₀) P₀.jacobian).mul
          P₁_sub.jacobian_isUnit
      let P_sub : Algebra.SubmersivePresentation R₀ S₀ _ _ :=
