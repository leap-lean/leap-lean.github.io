      AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_q) ≫ hUv.fromSpec
    have hτ_over : τ_left ≫ V.hom = T_Ω.hom := by
      dsimp [τ_left, f_aff, T_Ω] at hSpec_π_f ⊢
      rw [CategoryTheory.Category.assoc]
      exact hSpec_π_f
    have hEt_τ : AlgebraicGeometry.Etale τ_left := by
      refine CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        τ_left V.hom hEt_V ?_
      rw [hτ_over]
      change AlgebraicGeometry.Etale (𝟙 S_Ω)
      infer_instance
    let τ_v : T_Ω ⟶ V := CategoryTheory.MorphismProperty.Over.homMk τ_left hτ_over
    refine ⟨τ_v, hEt_τ, ?_⟩
    change hUv.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_q)).base pt_Ω) = v
    rw [hBase_π, hq_pt]
  let τ_fam : ↥V.left → (T_Ω ⟶ V) := fun v => Classical.choose (hTau_ex v)
  have hτ_spec : ∀ v : ↥V.left,
      AlgebraicGeometry.Etale (τ_fam v).left ∧ (τ_fam v).left.base pt_Ω = v :=
    fun v => Classical.choose_spec (hTau_ex v)
  have hCovV : CategoryTheory.Sieve.ofArrows (fun _ : ↥V.left => T_Ω) τ_fam ∈
      S_Ω.smallEtaleTopology V := by
    rw [hMemEtale]
    intro v
    exact ⟨T_Ω, τ_fam v, pt_Ω,
      CategoryTheory.Sieve.ofArrows_mk (fun _ : ↥V.left => T_Ω) τ_fam v,
      (hτ_spec v).1, (hτ_spec v).2⟩
  refine G₀.2.hom_ext_ofArrows τ_fam hCovV (fun v => ?_)
  ext z
  exact @Subsingleton.elim _ hSub_G0_TΩ _ _

theorem weil_etale_closed_cover_torsion_mayer_vietoris (Z : AlgebraicGeometry.Scheme.{u})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    Nonempty (CategoryTheory.Iso
      (weilEtaleTorsionSheaf Z ℓ)
      (weilEtaleHigherDirectImage
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal
          (⊤ : TopologicalSpace.Closeds ↥Z)).subschemeι 0
        (weilEtaleTorsionSheaf
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal
            (⊤ : TopologicalSpace.Closeds ↥Z)).subscheme ℓ))) ∧
    (∀ (D D₁ D₂ : TopologicalSpace.Closeds ↥Z),
      D = D₁ ⊔ D₂ →
      let W_D := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subscheme
      let i_D := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subschemeι
      let W₁ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D₁).subscheme
      let i₁ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D₁).subschemeι
      let W₂ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D₂).subscheme
      let i₂ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D₂).subschemeι
      let W₁₂ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal (D₁ ⊓ D₂)).subscheme
      let i₁₂ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal (D₁ ⊓ D₂)).subschemeι
      ∃ (u₁ : W₁ ⟶ W_D) (u₂ : W₂ ⟶ W_D) (u₁₂ : W₁₂ ⟶ W_D)
        (S_MV : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf W_D.smallEtaleTopology AddCommGrpCat.{u})),
        u₁ ≫ i_D = i₁ ∧
        u₂ ≫ i_D = i₂ ∧
        u₁₂ ≫ i_D = i₁₂ ∧
        S_MV.ShortExact ∧
        S_MV.X₁ = weilEtaleTorsionSheaf W_D ℓ ∧
        S_MV.X₂ = CategoryTheory.Limits.biprod
          (weilEtaleHigherDirectImage u₁ 0 (weilEtaleTorsionSheaf W₁ ℓ))
          (weilEtaleHigherDirectImage u₂ 0 (weilEtaleTorsionSheaf W₂ ℓ)) ∧
        S_MV.X₃ = weilEtaleHigherDirectImage u₁₂ 0 (weilEtaleTorsionSheaf W₁₂ ℓ)) :=
by
  classical
  let A_ℓ : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let Fgt : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Functor Y.Etale (CategoryTheory.Over Y) :=
    fun Y => AlgebraicGeometry.Scheme.Etale.forget Y
  let locPresheaf : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} := fun Y =>
    { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥((Fgt Y).obj (Opposite.unop E)).left ↥A_ℓ)
      map := fun u => AddCommGrpCat.ofHom
        (LocallyConstant.comapAddMonoidHom
          ⟨⇑((Fgt Y).map (Opposite.unop u)).left, ((Fgt Y).map (Opposite.unop u)).left.continuous⟩)
      map_id := fun _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl
      map_comp := fun _ _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }

  
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale

  have hEtaleExt : ∀ {Y : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : Y.Etale} (f₁ f₂ : U₁ ⟶ U₂),
      ((Fgt Y).map f₁).left = ((Fgt Y).map f₂).left → f₁ = f₂ :=
    fun _ _ h => (Fgt _).map_injective (CategoryTheory.Over.OverMorphism.ext h)

  let mkEtaleHom : ∀ {Y : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : Y.Etale}
      (f : ((Fgt Y).obj U₁).left ⟶ ((Fgt Y).obj U₂).left),
      f ≫ ((Fgt Y).obj U₂).hom = ((Fgt Y).obj U₁).hom → (U₁ ⟶ U₂) :=
    fun f hf => CategoryTheory.MorphismProperty.Over.homMk (P := P_et) f hf

  have hMemEtale : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (E : Y.Etale)
      (R : CategoryTheory.Sieve E),
      R ∈ Y.smallEtaleTopology E ↔
        ∀ (x : ↥((Fgt Y).obj E).left),
          ∃ (W : Y.Etale) (f : W ⟶ E) (y : ↥((Fgt Y).obj W).left),
            R.arrows f ∧ AlgebraicGeometry.Etale ((Fgt Y).map f).left ∧
            ((Fgt Y).map f).left y = x := by
    intro Y E R
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      inferInstanceAs (CategoryTheory.MorphismProperty.IsStableUnderComposition P_et)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChange (@AlgebraicGeometry.Etale) :=
      inferInstanceAs (CategoryTheory.MorphismProperty.IsStableUnderBaseChange P_et)
    have : CategoryTheory.MorphismProperty.IsMultiplicative (@AlgebraicGeometry.Etale) :=
      inferInstanceAs (CategoryTheory.MorphismProperty.IsMultiplicative P_et)
    have : CategoryTheory.MorphismProperty.RespectsIso (@AlgebraicGeometry.Etale) :=
      inferInstanceAs (CategoryTheory.MorphismProperty.RespectsIso P_et)
    have : CategoryTheory.MorphismProperty.HasOfPostcompProperty
        (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) :=
      inferInstanceAs (CategoryTheory.MorphismProperty.HasOfPostcompProperty P_et P_et)
    have hEq : Y.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) Y (le_rfl : P_et ≤ P_et)
    exact (iff_of_eq (congrArg (fun J : CategoryTheory.GrothendieckTopology Y.Etale =>
      R ∈ J E) hEq)).trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := Y) E R)

  have hB_fst : ∀ {W' W : AlgebraicGeometry.Scheme.{u}} (u : W' ⟶ W)
      {U₂ U₁ : W.Etale} (h : U₂ ⟶ U₁),
      ((Fgt W').map ((weilCompEtaleSitePullback u).map h)).left ≫
        CategoryTheory.Limits.pullback.fst ((Fgt W).obj U₁).hom u =
      CategoryTheory.Limits.pullback.fst ((Fgt W).obj U₂).hom u ≫ ((Fgt W).map h).left := by
    intro W' W u U₂ U₁ h
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _

  have hB_snd : ∀ {W' W : AlgebraicGeometry.Scheme.{u}} (u : W' ⟶ W)
      {U₂ U₁ : W.Etale} (h : U₂ ⟶ U₁),
      ((Fgt W').map ((weilCompEtaleSitePullback u).map h)).left ≫
        CategoryTheory.Limits.pullback.snd ((Fgt W).obj U₁).hom u =
      CategoryTheory.Limits.pullback.snd ((Fgt W).obj U₂).hom u := by
    intro W' W u U₂ U₁ h
    exact CategoryTheory.Limits.pullback.lift_snd _ _ _

  
  have hc_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      (weilCompEtaleSitePullback h).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology := by
    intro X₁ X₂ h
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      inferInstanceAs (CategoryTheory.MorphismProperty.IsStableUnderComposition P_et)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChange (@AlgebraicGeometry.Etale) :=
      inferInstanceAs (CategoryTheory.MorphismProperty.IsStableUnderBaseChange P_et)
    have : CategoryTheory.MorphismProperty.ContainsIdentities (@AlgebraicGeometry.Etale) :=
      inferInstanceAs (CategoryTheory.MorphismProperty.ContainsIdentities P_et)
    have : CategoryTheory.MorphismProperty.HasOfPostcompProperty
        (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) :=
      inferInstanceAs (CategoryTheory.MorphismProperty.HasOfPostcompProperty P_et P_et)
    let T₂ : X₂.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 X₂)
    have : CategoryTheory.Limits.HasTerminal X₂.Etale :=
      @CategoryTheory.Limits.hasTerminal_of_unique X₂.Etale _ T₂
        (fun U => ⟨mkEtaleHom ((Fgt X₂).obj U).hom (CategoryTheory.Category.comp_id _)⟩)
        (fun U => ⟨fun m₁ m₂ => hEtaleExt _ _
          ((CategoryTheory.Category.comp_id _).symm.trans
            (((Fgt X₂).map m₁).w.trans
              (((Fgt X₂).map m₂).w.symm.trans (CategoryTheory.Category.comp_id _))))⟩)
    have : CategoryTheory.Limits.HasPullbacks X₂.Etale :=
      CategoryTheory.MorphismProperty.Over.hasPullbacks (@AlgebraicGeometry.Etale) X₂
    have : CategoryTheory.Limits.HasFiniteLimits X₂.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    let B : CategoryTheory.Functor X₂.Etale X₁.Etale := weilCompEtaleSitePullback h
    have : CategoryTheory.Limits.PreservesFiniteLimits B :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
        (@AlgebraicGeometry.Etale) h
    have : CategoryTheory.RepresentablyFlat B :=
      CategoryTheory.flat_of_preservesFiniteLimits B
    refine CategoryTheory.Functor.isContinuous_of_coverPreserving
      (CategoryTheory.compatiblePreservingOfFlat X₁.smallEtaleTopology B) ⟨?_⟩
    intro U S hS
    rw [hMemEtale]
    intro w
    let u_hom := ((Fgt X₂).obj U).hom
    let fst_U : CategoryTheory.Limits.pullback u_hom h ⟶ ((Fgt X₂).obj U).left :=
      CategoryTheory.Limits.pullback.fst u_hom h
    let snd_U : CategoryTheory.Limits.pullback u_hom h ⟶ X₁ :=
      CategoryTheory.Limits.pullback.snd u_hom h
    obtain ⟨V, f, y, hf_S, _, hy⟩ := (hMemEtale X₂ U S).mp hS (fst_U w)
    let v_hom := ((Fgt X₂).obj V).hom
    let f_l := ((Fgt X₂).map f).left
    let m_B : CategoryTheory.Limits.pullback v_hom h ⟶ CategoryTheory.Limits.pullback u_hom h :=
      ((Fgt X₁).map (B.map f)).left
    have hEt_BU : P_et ((Fgt X₁).obj (B.obj U)).hom := (B.obj U).prop
    have hEt_comp : P_et (((Fgt X₁).map (B.map f)).left ≫ ((Fgt X₁).obj (B.obj U)).hom) := by
      have hw_B : ((Fgt X₁).map (B.map f)).left ≫ ((Fgt X₁).obj (B.obj U)).hom =
          ((Fgt X₁).obj (B.obj V)).hom := ((Fgt X₁).map (B.map f)).w
      rw [hw_B]
      exact (B.obj V).prop
    have hEt_mB : AlgebraicGeometry.Etale ((Fgt X₁).map (B.map f)).left :=
      CategoryTheory.MorphismProperty.of_postcomp P_et
        ((Fgt X₁).map (B.map f)).left ((Fgt X₁).obj (B.obj U)).hom hEt_BU hEt_comp
    obtain ⟨q₀, hq₁, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w y hy.symm
    let q_1 := CategoryTheory.Limits.pullback.fst fst_U f_l
    let q_2 := CategoryTheory.Limits.pullback.snd fst_U f_l
    let φ_lift : CategoryTheory.Limits.pullback fst_U f_l ⟶
        CategoryTheory.Limits.pullback v_hom h :=
      CategoryTheory.Limits.pullback.lift q_2 (q_1 ≫ snd_U)
        ((congrArg (q_2 ≫ ·) ((Fgt X₂).map f).w.symm).trans
          ((CategoryTheory.Category.assoc q_2 f_l u_hom).symm.trans
          ((congrArg (· ≫ u_hom) CategoryTheory.Limits.pullback.condition.symm).trans
          ((CategoryTheory.Category.assoc q_1 fst_U u_hom).trans
          ((congrArg (q_1 ≫ ·) CategoryTheory.Limits.pullback.condition).trans
            (CategoryTheory.Category.assoc q_1 snd_U h).symm)))))
    have hφ_m : φ_lift ≫ m_B = q_1 :=
      CategoryTheory.Limits.pullback.hom_ext
        ((CategoryTheory.Category.assoc φ_lift m_B fst_U).trans
          ((congrArg (φ_lift ≫ ·) (hB_fst h f)).trans
          ((CategoryTheory.Category.assoc φ_lift _ f_l).symm.trans
          ((congrArg (· ≫ f_l) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            CategoryTheory.Limits.pullback.condition.symm))))
        ((CategoryTheory.Category.assoc φ_lift m_B snd_U).trans
          ((congrArg (φ_lift ≫ ·) (hB_snd h f)).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)))
    exact ⟨B.obj V, B.map f, φ_lift q₀,
      CategoryTheory.Sieve.image_mem_functorPushforward B S hf_S,
      hEt_mB,
      (congrArg (fun k => k q₀) hφ_m).trans hq₁⟩

  
  have hR0Iso : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S)
      (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      have : (weilCompEtaleSitePullback f).IsContinuous S.smallEtaleTopology X.smallEtaleTopology :=
        hc_all f
      Nonempty (CategoryTheory.Iso
        (weilEtaleHigherDirectImage f 0 F)
        (((weilCompEtaleSitePullback f).sheafPushforwardContinuous
          AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology).obj F)) := by
    intro X S f F
    have : (weilCompEtaleSitePullback f).IsContinuous S.smallEtaleTopology X.smallEtaleTopology :=
      hc_all f
    let B : CategoryTheory.Functor S.Etale X.Etale := weilCompEtaleSitePullback f
    let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology X.smallEtaleTopology
    let L_free := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale) (Type u)
      AddCommGrpCat.{u}).obj AddCommGrpCat.free
    let L_sh := CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}
    let adj1 := AddCommGrpCat.adj.whiskerRight (Opposite X.Etale)
    let adj2 := CategoryTheory.sheafificationAdjunction X.smallEtaleTopology AddCommGrpCat.{u}
    let adj_tot := adj1.comp adj2
    let Φ : CategoryTheory.Functor X.Etale
        (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.yoneda ⋙ (L_free ⋙ L_sh)
    have h_addEquiv_mk₀ : ∀ {M N : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        (h : M ⟶ N), CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ h) = h := by
      intro M N h
      have hα := CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply
        (CategoryTheory.Abelian.Ext.addEquiv₀.symm h)
      rw [AddEquiv.apply_symm_apply] at hα
      rw [hα, AddEquiv.apply_symm_apply]
    let e_raw : ∀ (E : X.Etale), (Φ.obj E ⟶ F) ≃ ↥(F.obj.obj (Opposite.op E)) :=
      fun E => (adj_tot.homEquiv (CategoryTheory.yoneda.obj E) F).trans CategoryTheory.yonedaEquiv
    let e_hom : ∀ (E : X.Etale), (Φ.obj E ⟶ F) ≃+ ↥(F.obj.obj (Opposite.op E)) := fun E =>
      AddEquiv.mk' (e_raw E) (fun f₁ f₂ => by
        have hadj2 : adj2.homEquiv (L_free.obj (CategoryTheory.yoneda.obj E)) F (f₁ + f₂) =
            adj2.homEquiv (L_free.obj (CategoryTheory.yoneda.obj E)) F f₁ +
            adj2.homEquiv (L_free.obj (CategoryTheory.yoneda.obj E)) F f₂ := by
          rw [CategoryTheory.Adjunction.homEquiv_unit,
            CategoryTheory.Adjunction.homEquiv_unit,
            CategoryTheory.Adjunction.homEquiv_unit,
            CategoryTheory.Functor.map_add, CategoryTheory.Preadditive.comp_add]
        let u₀ := (AddCommGrpCat.adj.unit.app (E ⟶ E)) (𝟙 E)
        change ((adj2.homEquiv (L_free.obj (CategoryTheory.yoneda.obj E)) F (f₁ + f₂)).app
            (Opposite.op E)) u₀ =
          ((adj2.homEquiv (L_free.obj (CategoryTheory.yoneda.obj E)) F f₁).app
            (Opposite.op E)) u₀ +
          ((adj2.homEquiv (L_free.obj (CategoryTheory.yoneda.obj E)) F f₂).app
            (Opposite.op E)) u₀
        rw [hadj2]
        rfl)
    let θ : ∀ (E : X.Etale),
        ↥((F.cohomologyPresheaf 0).obj (Opposite.op E)) ≃+ ↥(F.obj.obj (Opposite.op E)) :=
      fun E => CategoryTheory.Abelian.Ext.addEquiv₀.trans (e_hom E)
    let e_pre : F.cohomologyPresheaf 0 ≅ F.obj :=
      CategoryTheory.NatIso.ofComponents
        (fun E => (θ (Opposite.unop E)).toAddCommGrpIso)
        (fun {E₂ E₁} g => by
          ext x
          let g' : Opposite.unop E₁ ⟶ Opposite.unop E₂ := Opposite.unop g
          have hg_eq : g = Opposite.op g' := rfl
          rw [hg_eq]
          let x' : CategoryTheory.Abelian.Ext (Φ.obj E₂.unop) F 0 := x
          have hmap : (((F.cohomologyPresheaf 0).map g'.op) x :
              CategoryTheory.Abelian.Ext (Φ.obj E₁.unop) F 0) =
              (CategoryTheory.Abelian.Ext.mk₀ (Φ.map g')).comp x' (Nat.zero_add 0) := by
            change (((CategoryTheory.Abelian.extFunctor 0).map (Φ.map g').op).app F) x' = _
            rw [CategoryTheory.Abelian.extFunctor_map_app]
            rfl
          have hcomp : CategoryTheory.Abelian.Ext.addEquiv₀
              ((CategoryTheory.Abelian.Ext.mk₀ (Φ.map g')).comp x' (Nat.zero_add 0)) =
              Φ.map g' ≫ CategoryTheory.Abelian.Ext.addEquiv₀ x' := by
            conv_lhs =>
              rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x',
                CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
            exact h_addEquiv_mk₀ _
          change e_hom E₁.unop
              (CategoryTheory.Abelian.Ext.addEquiv₀
                (((F.cohomologyPresheaf 0).map g'.op) x :
                  CategoryTheory.Abelian.Ext (Φ.obj E₁.unop) F 0)) =
            F.obj.map g'.op (e_hom E₂.unop (CategoryTheory.Abelian.Ext.addEquiv₀ x'))
          rw [hmap, hcomp]
          change CategoryTheory.yonedaEquiv
              (adj_tot.homEquiv (CategoryTheory.yoneda.obj E₁.unop) F
                ((L_free ⋙ L_sh).map (CategoryTheory.yoneda.map g') ≫
                  CategoryTheory.Abelian.Ext.addEquiv₀ x')) =
            F.obj.map g'.op
              (CategoryTheory.yonedaEquiv
                (adj_tot.homEquiv (CategoryTheory.yoneda.obj E₂.unop) F
                  (CategoryTheory.Abelian.Ext.addEquiv₀ x')))
          rw [adj_tot.homEquiv_naturality_left]
          exact (CategoryTheory.yonedaEquiv_naturality
            (adj_tot.homEquiv (CategoryTheory.yoneda.obj E₂.unop) F
              (CategoryTheory.Abelian.Ext.addEquiv₀ x')) g').symm)
    let e_whisk : B.op ⋙ F.cohomologyPresheaf 0 ≅ (pf.obj F).obj :=
      CategoryTheory.Functor.isoWhiskerLeft B.op e_pre
    let adj_S := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
    exact ⟨((CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).mapIso
      e_whisk).trans (CategoryTheory.asIso (adj_S.counit.app (pf.obj F)))⟩

  let mkOpenEtale : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (E : Y.Etale)
      (O : ((Fgt Y).obj E).left.Opens), Y.Etale := fun E O =>
    have : AlgebraicGeometry.Etale ((Fgt _).obj E).hom := E.prop
    AlgebraicGeometry.Scheme.Etale.mk (O.ι ≫ ((Fgt _).obj E).hom)

  let mkOpenEtaleHom : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (E : Y.Etale)
      (O : ((Fgt Y).obj E).left.Opens), mkOpenEtale E O ⟶ E := fun E O =>
    mkEtaleHom O.ι rfl

  have hEtOpenHom : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (E : Y.Etale)
      (O : ((Fgt Y).obj E).left.Opens),
      AlgebraicGeometry.Etale ((Fgt Y).map (mkOpenEtaleHom E O)).left :=
    fun _ O => (inferInstance : AlgebraicGeometry.Etale O.ι)

  have hOpenCoverExt : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      (𝒢 : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
      (E : Y.Etale) {ι : Type u} (O : ι → ((Fgt Y).obj E).left.Opens)
      (hCovO : ∀ z : ↥((Fgt Y).obj E).left, ∃ i : ι, z ∈ O i)
      (s₁ s₂ : ↥(𝒢.obj.obj (Opposite.op E))),
      (∀ i : ι, 𝒢.obj.map (mkOpenEtaleHom E (O i)).op s₁ =
        𝒢.obj.map (mkOpenEtaleHom E (O i)).op s₂) →
      s₁ = s₂ := by
    intro Y 𝒢 E ι O hCovO s₁ s₂ hAgree
