    have _ : Limits.HasPullbacks D := Limits.hasPullbacks_of_hasLimit_cospan D
    have _ : Limits.HasFiniteLimits D := Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have _ : ∀ {d₁ d₂ d₃ : D} (u₁ : d₁ ⟶ d₃) (u₂ : d₂ ⟶ d₃),
        Limits.PreservesLimit (Limits.cospan u₁ u₂) G := by
      intro d₁ d₂ d₃ u₁ u₂
      obtain ⟨c, ⟨hc_D⟩, ⟨hc_G⟩⟩ := hCospan u₁ u₂
