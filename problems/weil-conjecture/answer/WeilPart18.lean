    rw [h_u]
    slice_lhs 3 4 => rw [ef.hom_inv_id_app]
    dsimp
    rw [CategoryTheory.Category.id_comp]
    slice_lhs 2 3 => rw [htri]
    rw [CategoryTheory.Category.id_comp, ef.inv_hom_id_app]
  
