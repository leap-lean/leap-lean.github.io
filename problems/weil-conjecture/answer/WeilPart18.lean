      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.pullback.fst E.hom j)
        (CategoryTheory.Limits.pullback.condition (f := E.hom) (g := j))
    have hπ_map : ∀ E : Z.Etale, B_j.map (π_E E) = hom_W (B_j.obj E) := by
      intro E
      apply (AlgebraicGeometry.Scheme.Etale.forget U.toScheme).map_injective
      refine CategoryTheory.Over.OverMorphism.ext ?_
      have hmap := CategoryTheory.MorphismProperty.Over.pullback_map_left P ⊤ j (π_E E)
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst E.hom j) hmap).trans
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      · have hw1 : (B_j.map (π_E E)).left ≫ (B_j.obj E).hom =
            (B_j.obj (M_j.obj (B_j.obj E))).hom :=
          CategoryTheory.MorphismProperty.Over.w (B_j.map (π_E E))
        exact hw1.trans (h_fst_w (B_j.obj E)).symm
    have _ : (pf j).Faithful :=
      { map_injective := fun {N₁ N₂} {f₁ f₂} h => by
          apply CategoryTheory.Sheaf.hom_ext
          ext W_op : 2
          rcases W_op with ⟨W⟩
          have happ : f₁.hom.app (Opposite.op ((M_j ⋙ B_j).obj W)) =
              f₂.hom.app (Opposite.op ((M_j ⋙ B_j).obj W)) :=
            congrArg (fun φ => φ.hom.app (Opposite.op (M_j.obj W))) h
          have hnat₁ := f₁.hom.naturality (iso_W W).inv.op
          have hnat₂ := f₂.hom.naturality (iso_W W).inv.op
          have hid₁ : N₁.obj.map (iso_W W).hom.op ≫ N₁.obj.map (iso_W W).inv.op = 𝟙 _ := by
            rw [← N₁.obj.map_comp, ← op_comp, (iso_W W).inv_hom_id, op_id, N₁.obj.map_id]
          calc
            f₁.hom.app (Opposite.op W)
              = (N₁.obj.map (iso_W W).hom.op ≫ N₁.obj.map (iso_W W).inv.op) ≫
                  f₁.hom.app (Opposite.op W) := by rw [hid₁, CategoryTheory.Category.id_comp]
            _ = N₁.obj.map (iso_W W).hom.op ≫
                  (N₁.obj.map (iso_W W).inv.op ≫ f₁.hom.app (Opposite.op W)) :=
                CategoryTheory.Category.assoc _ _ _
            _ = N₁.obj.map (iso_W W).hom.op ≫
                  (f₁.hom.app (Opposite.op ((M_j ⋙ B_j).obj W)) ≫
                    N₂.obj.map (iso_W W).inv.op) := by rw [hnat₁]
            _ = N₁.obj.map (iso_W W).hom.op ≫
                  (f₂.hom.app (Opposite.op ((M_j ⋙ B_j).obj W)) ≫
                    N₂.obj.map (iso_W W).inv.op) := by rw [happ]
            _ = N₁.obj.map (iso_W W).hom.op ≫
                  (N₁.obj.map (iso_W W).inv.op ≫ f₂.hom.app (Opposite.op W)) := by rw [← hnat₂]
            _ = (N₁.obj.map (iso_W W).hom.op ≫ N₁.obj.map (iso_W W).inv.op) ≫
                  f₂.hom.app (Opposite.op W) := (CategoryTheory.Category.assoc _ _ _).symm
            _ = f₂.hom.app (Opposite.op W) := by rw [hid₁, CategoryTheory.Category.id_comp] }
    have _ : (pf j).Full :=
      { map_surjective := fun {N₁ N₂} α => by
          let β_app : ∀ W_op : (U.toScheme.Etale)ᵒᵖ,
              N₁.obj.obj W_op ⟶ N₂.obj.obj W_op := fun W_op =>
            N₁.obj.map (iso_W W_op.unop).hom.op ≫
              α.hom.app (Opposite.op (M_j.obj W_op.unop)) ≫
              N₂.obj.map (iso_W W_op.unop).inv.op
          refine ⟨⟨{ app := β_app, naturality := ?_ }⟩, ?_⟩
          · intro W₁_op W₂_op u_op
            rcases W₁_op with ⟨W₁⟩
            rcases W₂_op with ⟨W₂⟩
            rcases u_op with ⟨u⟩
            have h1 : u ≫ (iso_W W₁).inv = (iso_W W₂).inv ≫ (M_j ⋙ B_j).map u :=
              (CategoryTheory.Iso.comp_inv_eq (iso_W W₁)).mpr
                (((CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg ((iso_W W₂).inv ≫ ·) (he_nat u)).trans
                    (CategoryTheory.Iso.inv_hom_id_assoc (iso_W W₂) u))).symm)
            have hα_nat : N₁.obj.map ((M_j ⋙ B_j).map u).op ≫
                  α.hom.app (Opposite.op (M_j.obj W₂)) =
                α.hom.app (Opposite.op (M_j.obj W₁)) ≫
                  N₂.obj.map ((M_j ⋙ B_j).map u).op :=
              α.hom.naturality (M_j.map u).op
            have hL : N₁.obj.map u.op ≫ N₁.obj.map (iso_W W₂).hom.op =
                N₁.obj.map (iso_W W₁).hom.op ≫ N₁.obj.map ((M_j ⋙ B_j).map u).op := by
              rw [← N₁.obj.map_comp, ← N₁.obj.map_comp, ← op_comp, ← op_comp, he_nat u]
            have hR : N₂.obj.map (iso_W W₁).inv.op ≫ N₂.obj.map u.op =
                N₂.obj.map ((M_j ⋙ B_j).map u).op ≫ N₂.obj.map (iso_W W₂).inv.op := by
              rw [← N₂.obj.map_comp, ← N₂.obj.map_comp, ← op_comp, ← op_comp, h1]
            change N₁.obj.map u.op ≫ N₁.obj.map (iso_W W₂).hom.op ≫
                α.hom.app (Opposite.op (M_j.obj W₂)) ≫ N₂.obj.map (iso_W W₂).inv.op =
              N₁.obj.map (iso_W W₁).hom.op ≫ α.hom.app (Opposite.op (M_j.obj W₁)) ≫
                N₂.obj.map (iso_W W₁).inv.op ≫ N₂.obj.map u.op
            exact (CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ _) hL).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (N₁.obj.map (iso_W W₁).hom.op ≫ ·)
                      ((CategoryTheory.Category.assoc _ _ _).symm.trans
                        ((congrArg (· ≫ _) hα_nat).trans
                          ((CategoryTheory.Category.assoc _ _ _).trans
                            (congrArg (α.hom.app (Opposite.op (M_j.obj W₁)) ≫ ·) hR.symm))))).trans
                    rfl)))
          · apply CategoryTheory.Sheaf.hom_ext
            ext E_op : 2
            rcases E_op with ⟨E⟩
            have hα : N₁.obj.map (B_j.map (π_E E)).op ≫
                  α.hom.app (Opposite.op (M_j.obj (B_j.obj E))) =
                α.hom.app (Opposite.op E) ≫ N₂.obj.map (B_j.map (π_E E)).op :=
              α.hom.naturality (π_E E).op
            rw [hπ_map E] at hα
            have hid₂ : N₂.obj.map (hom_W (B_j.obj E)).op ≫
                N₂.obj.map (iso_W (B_j.obj E)).inv.op = 𝟙 _ := by
              rw [← N₂.obj.map_comp, ← op_comp, (iso_W (B_j.obj E)).inv_hom_id, op_id,
                N₂.obj.map_id]
            change N₁.obj.map (hom_W (B_j.obj E)).op ≫
                α.hom.app (Opposite.op (M_j.obj (B_j.obj E))) ≫
                N₂.obj.map (iso_W (B_j.obj E)).inv.op =
              α.hom.app (Opposite.op E)
            exact (CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ _) hα).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (α.hom.app (Opposite.op E) ≫ ·) hid₂).trans
                    (CategoryTheory.Category.comp_id _)))) }
    exact CategoryTheory.Adjunction.counit_isIso_of_R_fully_faithful (adj j)
  have hDisjOpenPullbackZero : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (i : Z₁ ⟶ Z₂)
      (O : Z₂.Opens),
      Disjoint (O : Set ↥Z₂) (Set.range i.base) →
      ∀ (K : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Limits.IsZero ((pb O.ι).obj ((pf i).obj K)) := by
    intro Z₁ Z₂ i O hDisj K
    apply hCons O.toScheme
    intro Ω _ _ v
    refine CategoryTheory.Limits.IsZero.of_iso ?_ ((e_fib O.ι Ω v).app ((pf i).obj K))
    let E₀ : Z₂.Etale := AlgebraicGeometry.Scheme.Etale.mk O.ι
    let pt₀ : (pt Z₂ Ω (v ≫ O.ι)).fiber.obj E₀ := ⟨v, rfl⟩
    apply hStalkZeroAtFilter Z₂ ((pf i).obj K) Ω (v ≫ O.ι) E₀ pt₀
    intro E u
    let B_i := weilEtaleSitePullback i
    have hEmp : IsEmpty ↥(B_i.obj E).left := by
      refine ⟨fun p => ?_⟩
      let q : ↥(CategoryTheory.Limits.pullback E.hom i) := p
      have hcond : CategoryTheory.Limits.pullback.fst E.hom i ≫ E.hom =
          CategoryTheory.Limits.pullback.snd E.hom i ≫ i :=
        CategoryTheory.Limits.pullback.condition
      have hu_w : u.left ≫ O.ι = E.hom := CategoryTheory.MorphismProperty.Over.w u
      have h1 : (CategoryTheory.Limits.pullback.fst E.hom i ≫ E.hom).base q =
          i.base ((CategoryTheory.Limits.pullback.snd E.hom i).base q) :=
        congrArg (fun f : CategoryTheory.Limits.pullback E.hom i ⟶ Z₂ => f.base q) hcond
      have h2 : (CategoryTheory.Limits.pullback.fst E.hom i ≫ E.hom).base q =
          O.ι.base (u.left.base ((CategoryTheory.Limits.pullback.fst E.hom i).base q)) :=
        congrArg (fun f : E.left ⟶ Z₂ =>
          f.base ((CategoryTheory.Limits.pullback.fst E.hom i).base q)) hu_w.symm
      have hx_O : (CategoryTheory.Limits.pullback.fst E.hom i ≫ E.hom).base q ∈ (O : Set ↥Z₂) :=
        h2 ▸ (u.left.base ((CategoryTheory.Limits.pullback.fst E.hom i).base q)).2
      have hx_i : (CategoryTheory.Limits.pullback.fst E.hom i ≫ E.hom).base q ∈
          Set.range i.base :=
        h1 ▸ ⟨(CategoryTheory.Limits.pullback.snd E.hom i).base q, rfl⟩
      exact Set.disjoint_left.mp hDisj hx_O hx_i
    exact hEmptyBotZero Z₁ (B_i.obj E) hEmp K
  have hZeroKernelι : ∀ {W : AlgebraicGeometry.Scheme.{u}}
      {A B : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}} (g : A ⟶ B),
      CategoryTheory.Limits.IsZero B →
      CategoryTheory.IsIso (CategoryTheory.Limits.kernel.ι g) := by
    intro W A B g hB
    have hg0 : g = 0 := hB.eq_of_tgt g 0
    let l : A ⟶ CategoryTheory.Limits.kernel g :=
      CategoryTheory.Limits.kernel.lift g (𝟙 A) (by rw [hg0, CategoryTheory.Limits.comp_zero])
    exact
      { out := ⟨l,
          (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι g)).mp <| by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp],
          CategoryTheory.Limits.kernel.lift_ι _ _ _⟩ }
  
  have hDir0Iso : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Z₁ ⟶ Z₂)
      (G : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}),
      Nonempty ((pf f).obj G ≅ weilEtaleHigherDirectImage f 0 G) := by
    intro Z₁ Z₂ f G
    let J₁ := Z₁.smallEtaleTopology
    let J₂ := Z₂.smallEtaleTopology
    let W_free := (CategoryTheory.Functor.whiskeringRight (Z₁.Etale)ᵒᵖ (Type u) AddCommGrpCat.{u}).obj
      AddCommGrpCat.free
    let W_fgt := (CategoryTheory.Functor.whiskeringRight (Z₁.Etale)ᵒᵖ AddCommGrpCat.{u} (Type u)).obj
      (CategoryTheory.forget AddCommGrpCat.{u})
    let adj_free : W_free ⊣ W_fgt := AddCommGrpCat.adj.whiskerRight (Z₁.Etale)ᵒᵖ
    let adj_sh := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
    let adj_tot := adj_free.comp adj_sh
    let L₁ : Z₁.Etale ⥤ CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} :=
      CategoryTheory.yoneda.comp (W_free.comp (CategoryTheory.presheafToSheaf J₁ AddCommGrpCat.{u}))
    have hmk0_inj : ∀ {A : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}} {g₁ g₂ : A ⟶ G},
        CategoryTheory.Abelian.Ext.mk₀ g₁ = CategoryTheory.Abelian.Ext.mk₀ g₂ → g₁ = g₂ :=
      fun h => CategoryTheory.Abelian.Ext.homEquiv₀.symm.injective h
    let evalEquiv : ∀ E : Z₁.Etale, (L₁.obj E ⟶ G) ≃ ↥(G.obj.obj (Opposite.op E)) :=
      fun E => (adj_tot.homEquiv (CategoryTheory.yoneda.obj E) G).trans CategoryTheory.yonedaEquiv
    have h_add_hom : ∀ (E : Z₁.Etale) (g₁ g₂ : L₁.obj E ⟶ G),
        evalEquiv E (g₁ + g₂) = evalEquiv E g₁ + evalEquiv E g₂ := by
      intro E g₁ g₂
      dsimp [evalEquiv]
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.yonedaEquiv_comp,
        CategoryTheory.yonedaEquiv_comp, CategoryTheory.yonedaEquiv_comp]
      rfl
    let α_E : ∀ E : Z₁.Etale,
        (G.cohomologyPresheaf 0).obj (Opposite.op E) ≅ G.obj.obj (Opposite.op E) := fun E =>
      (AddEquiv.mk' (CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans (evalEquiv E))
        (fun x y => by
          dsimp
          rw [map_add]
          exact h_add_hom E _ _)).toAddCommGrpIso
    let ψ_G : G.cohomologyPresheaf 0 ≅ G.obj :=
      CategoryTheory.NatIso.ofComponents (fun E_op => α_E E_op.unop) (by
        intro E₂_op E₁_op u_op
        rcases E₁_op with ⟨E₁⟩
        rcases E₂_op with ⟨E₂⟩
        rcases u_op with ⟨u⟩
        dsimp at u ⊢
        ext x
        have hx : CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.addEquiv₀ x) = x :=
          CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x
        have hcomp :=
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (L₁.map u) (CategoryTheory.Abelian.Ext.addEquiv₀ x)
        let y : CategoryTheory.Abelian.Ext (L₁.obj E₁) G 0 := ((G.cohomologyPresheaf 0).map u.op) x
        have hmap_x : y =
            CategoryTheory.Abelian.Ext.mk₀ (L₁.map u ≫ CategoryTheory.Abelian.Ext.addEquiv₀ x) := by
          change (CategoryTheory.Abelian.Ext.mk₀ (L₁.map u)).comp x (Nat.zero_add 0) = _
          rw [← hcomp, hx]
        have hadd_map :
            CategoryTheory.Abelian.Ext.addEquiv₀ y =
              L₁.map u ≫ CategoryTheory.Abelian.Ext.addEquiv₀ x :=
          hmk0_inj ((CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply y).trans hmap_x)
        change evalEquiv E₁ (CategoryTheory.Abelian.Ext.addEquiv₀ y) =
          (G.obj.map u.op) (evalEquiv E₂ (CategoryTheory.Abelian.Ext.addEquiv₀ x))
        rw [hadd_map]
        dsimp [evalEquiv]
        have hL : L₁.map u =
            (W_free.comp (CategoryTheory.presheafToSheaf J₁ AddCommGrpCat.{u})).map
              (CategoryTheory.yoneda.map u) := rfl
        rw [hL, CategoryTheory.Adjunction.homEquiv_naturality_left]
        exact (CategoryTheory.yonedaEquiv_naturality _ u).symm)
    let B := weilEtaleSitePullback f
    let adj_S := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
    have _ : CategoryTheory.IsIso adj_S.counit :=
      CategoryTheory.Adjunction.counit_isIso_of_R_fully_faithful adj_S
    let e_counit :
        (CategoryTheory.presheafToSheaf J₂ AddCommGrpCat.{u}).obj ((pf f).obj G).obj ≅
          (pf f).obj G :=
      (CategoryTheory.asIso adj_S.counit).app ((pf f).obj G)
    let e_whisker : B.op ⋙ G.cohomologyPresheaf 0 ≅ ((pf f).obj G).obj :=
      CategoryTheory.Functor.isoWhiskerLeft B.op ψ_G
    exact ⟨e_counit.symm ≪≫
      (CategoryTheory.presheafToSheaf J₂ AddCommGrpCat.{u}).mapIso e_whisker.symm⟩
  let e_dir0 : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Z₁ ⟶ Z₂)
      (G : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}),
      (pf f).obj G ≅ weilEtaleHigherDirectImage f 0 G :=
    fun f G => (hDir0Iso f G).some
  have hDir0Id : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      Nonempty (weilEtaleHigherDirectImage (𝟙 S) 0 G ≅ G) := by
    intro S G
    let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme := @AlgebraicGeometry.Etale
    have _ : CategoryTheory.MorphismProperty.HasPullbacksAlong P (𝟙 S) :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P (𝟙 S) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : S.Etale ⥤ S.Etale := weilEtaleSitePullback (𝟙 S)
