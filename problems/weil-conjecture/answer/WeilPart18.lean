    let Fℤ_X := (CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let post_θ : CategoryTheory.Abelian.Ext Fℤ_X (P_pull.obj (weilEtaleGmSheaf Y)) 1 →+
        (weilEtaleGmSheaf X).H 1 :=
      (CategoryTheory.Abelian.Ext.mk₀ θ_h).postcomp Fℤ_X (Nat.add_zero 1)
    refine ⟨ξ_X, ⟨post_θ η_pull, ?_⟩, ?_⟩
    · rw [← map_nsmul post_θ m η_pull, hη_pull]
      exact hθ_X
    · intro K_sh Q_sh ι_0 π_0 h0_0 hSE_0 W₁' W₂' W₁₂' V₁ V₂ V₁₂ j₁₂_₁ shAdj_X' Fℤ_X'
        u₁_Fℤ u_X_zar' u_X_sh' s₁ f_q hs₁ hfq₁ hfq₂
      exact hGlue_X (weilEtaleGmSheaf X) K_sh Q_sh ι_0 π_0 h0_0 hSE_0 u_X_sh s₁ f_q
        hs₁ hfq₁ hfq₂

theorem weil_smooth_curve_generic_gm_divisor_valuation_package (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    [CompactSpace ↥C.left]
    [C.left.IsSeparated]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (hDim : topologicalKrullDim C.left = (1 : WithBot ℕ∞))
    (hGm : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilEtaleGmPresheaf Z)) :
    ∃ (Q_div : CategoryTheory.Sheaf C.left.smallEtaleTopology AddCommGrpCat.{u})
      (ι_gm : weilEtaleGmSheaf C.left ⟶ weilEtaleKSheaf C.left)
      (π_div : weilEtaleKSheaf C.left ⟶ Q_div)
      (h0_div : ι_gm ≫ π_div = 0)
      (div_H0 : Q_div.H 0 →+ ({ x : ↥C.left // IsClosed ({x} : Set ↥C.left) } →₀ ℤ)),
      (CategoryTheory.ShortComplex.mk ι_gm π_div h0_div).ShortExact ∧
      (∀ k₀ : (weilEtaleKSheaf C.left).H 0,
        div_H0 (k₀.comp (CategoryTheory.Abelian.Ext.mk₀ π_div) (Nat.add_zero 0)) ∈
          weilCurvePrincipalSubgroup C.left) ∧
      (∀ (W₁ W₂ : C.left.Opens),
        W₁ ⊔ W₂ = ⊤ →
        ∀ (P : ↥C.left) (hP_cl : IsClosed ({P} : Set ↥C.left)) (hP_mem : P ∈ W₁),
          (W₂ : Set ↥C.left) = ({P} : Set ↥C.left)ᶜ →
          ∀ (f_sec : ↑(C.left.presheaf.obj (Opposite.op W₁)))
            (u_W : Units ↑(C.left.presheaf.obj (Opposite.op (W₁ ⊓ W₂)))),
            (C.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op).hom f_sec =
              (u_W : ↑(C.left.presheaf.obj (Opposite.op (W₁ ⊓ W₂)))) →
            Ideal.span {(C.left.presheaf.germ W₁ P hP_mem).hom f_sec} =
              IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk P) →
            let W₁₂ : C.left.Opens := W₁ ⊓ W₂
            let V₁ : C.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁.ι
              (inferInstance : AlgebraicGeometry.Etale W₁.ι)
            let V₂ : C.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₂.ι
              (inferInstance : AlgebraicGeometry.Etale W₂.ι)
            let V₁₂ : C.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁₂.ι
              (inferInstance : AlgebraicGeometry.Etale W₁₂.ι)
            let j₁₂_₁ : V₁₂ ⟶ V₁ :=
              CategoryTheory.MorphismProperty.Over.homMk
                (C.left.homOfLE inf_le_left) (C.left.homOfLE_ι inf_le_left)
            let shAdj_C := CategoryTheory.sheafificationAdjunction
              C.left.smallEtaleTopology AddCommGrpCat.{u}
            let Fℤ_C := (CategoryTheory.constantSheaf
              C.left.smallEtaleTopology AddCommGrpCat.{u}).obj
              (AddCommGrpCat.of (ULift.{u} ℤ))
            let u₁_Fℤ := fun (V : C.left.Etale) =>
              (((shAdj_C.unit.app
                ((CategoryTheory.Functor.const (Opposite C.left.Etale)).obj
                  (AddCommGrpCat.of (ULift.{u} ℤ)))).app
                (Opposite.op V)).hom (ULift.up (1 : ℤ)))
            let u_C_sh : ↥((weilEtaleGmSheaf C.left).obj.obj (Opposite.op V₁₂)) :=
              (((shAdj_C.unit.app (weilEtaleGmPresheaf C.left)).app (Opposite.op V₁₂)).hom
                (Additive.ofMul (Units.map W₁₂.topIso.inv.hom.toMonoidHom u_W)))
            ∃ (s₁ : ↥((weilEtaleKSheaf C.left).obj.obj (Opposite.op V₁)))
              (f_q : Fℤ_C ⟶ Q_div),
              ((weilEtaleKSheaf C.left).obj.map j₁₂_₁.op).hom s₁ =
                (ι_gm.hom.app (Opposite.op V₁₂)).hom u_C_sh ∧
              (f_q.hom.app (Opposite.op V₁)).hom (u₁_Fℤ V₁) =
                (π_div.hom.app (Opposite.op V₁)).hom s₁ ∧
              (f_q.hom.app (Opposite.op V₂)).hom (u₁_Fℤ V₂) = 0 ∧
              div_H0 (CategoryTheory.Abelian.Ext.mk₀ f_q) =
                Finsupp.single ⟨P, hP_cl⟩ (1 : ℤ)) :=
by
  classical
  
  have : AlgebraicGeometry.LocallyOfFiniteType C.hom := by
    have hcov := (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 C.hom).mp inferInstance
    choose U_x _ V_x hV_x hx_mem e_x h_x using hcov
    let V_aff : ↥C.left → C.left.affineOpens := fun x => ⟨V_x x, hV_x x⟩
    have hV_top : (⨆ x : ↥C.left, (V_aff x).1) = ⊤ :=
      eq_top_iff.mpr fun x _ => le_iSup (fun y : ↥C.left => (V_aff y).1) x (hx_mem x)
    refine AlgebraicGeometry.HasRingHomProperty.of_iSup_eq_top
      (P := @AlgebraicGeometry.LocallyOfFiniteType) V_aff hV_top fun x => ?_
    have hU_top : U_x x = ⊤ := by
      ext u
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      rw [Subsingleton.elim u (C.hom.base x)]
      exact e_x x (hx_mem x)
    exact (AlgebraicGeometry.Scheme.Hom.appLE_congr C.hom (e_x x) hU_top rfl
      (fun φ => φ.hom.FiniteType)).mp
      (RingHom.FiniteType.of_finitePresentation
        (RingHom.smooth_def.mp (h_x x).isStandardSmooth.smooth).2)

  
  have : IrreducibleSpace ↥C.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left
  let η := genericPoint ↥C.left
  let K : Type u := ↑C.left.functionField
  let S_K := AlgebraicGeometry.Spec (C.left.presheaf.stalk η)
  let η_X : S_K ⟶ C.left := C.left.fromSpecStalk η
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have hMemEt : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (U : Z.Etale) (R : CategoryTheory.Sieve U),
      R ∈ Z.smallEtaleTopology U ↔ ∀ x : ↥U.left, ∃ (Y : Z.Etale) (f : Y ⟶ U) (y : ↥Y.left),
        R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro Z U R
    have hJ_eq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) Z le_rfl
    exact (Eq.to_iff
      (congrArg (fun G : CategoryTheory.GrothendieckTopology (P_et.Over ⊤ Z) => R ∈ G U) hJ_eq)).trans
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U R)
  have hK_sh : CategoryTheory.Presheaf.IsSheaf C.left.smallEtaleTopology
      (weilEtaleKPresheaf C.left) := by
    let B_η := CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ η_X
    have hCompat : CategoryTheory.CompatiblePreserving S_K.smallEtaleTopology B_η :=
      @CategoryTheory.compatiblePreservingOfFlat _ _ _ _ S_K.smallEtaleTopology B_η
        (CategoryTheory.flat_of_preservesFiniteLimits B_η)
    have hCov : CategoryTheory.CoverPreserving
        C.left.smallEtaleTopology S_K.smallEtaleTopology B_η := by
      refine ⟨fun {U} {R} hR => ?_⟩
      refine (hMemEt (B_η.obj U) (CategoryTheory.Sieve.functorPushforward B_η R)).mpr ?_
      intro z
      obtain ⟨Y, f, y, hfR, hfEt, hfy⟩ :=
        (hMemEt U R).mp hR ((CategoryTheory.Limits.pullback.fst U.hom η_X).base z)
      have hmap_left : (B_η.map f).left =
          CategoryTheory.Limits.pullback.map Y.hom η_X U.hom η_X
            f.left (𝟙 S_K) (𝟙 C.left)
            ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.MorphismProperty.Over.w f).symm)
            (by simp) :=
        CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ η_X f
      have h_snd : (B_η.map f).left ≫ CategoryTheory.Limits.pullback.snd U.hom η_X =
          CategoryTheory.Limits.pullback.snd Y.hom η_X :=
        (congrArg (· ≫ CategoryTheory.Limits.pullback.snd U.hom η_X) hmap_left).trans
          ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
            (CategoryTheory.Category.comp_id _))
      have h_fst : (B_η.map f).left ≫ CategoryTheory.Limits.pullback.fst U.hom η_X =
          CategoryTheory.Limits.pullback.fst Y.hom η_X ≫ f.left :=
        (congrArg (· ≫ CategoryTheory.Limits.pullback.fst U.hom η_X) hmap_left).trans
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      have hpb : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst Y.hom η_X)
          (B_η.map f).left
          f.left
          (CategoryTheory.Limits.pullback.fst U.hom η_X) := by
        refine CategoryTheory.IsPullback.of_bot ?_ h_fst.symm
          (CategoryTheory.IsPullback.of_hasPullback U.hom η_X)
        exact h_snd.symm ▸ (CategoryTheory.MorphismProperty.Over.w f).symm ▸
          CategoryTheory.IsPullback.of_hasPullback Y.hom η_X
      have hEt_map : AlgebraicGeometry.Etale (B_η.map f).left :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb hfEt
      obtain ⟨w, _, hw⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb y z hfy
      exact ⟨B_η.obj Y, B_η.map f, w,
        CategoryTheory.Sieve.image_mem_functorPushforward B_η R hfR, hEt_map, hw⟩
    have hCont : B_η.IsContinuous C.left.smallEtaleTopology S_K.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov
    have hPush : CategoryTheory.Presheaf.IsSheaf C.left.smallEtaleTopology
        (B_η.op ⋙ weilEtaleGmPresheaf S_K) :=
      @CategoryTheory.Functor.op_comp_isSheaf _ _ _ _ B_η _ _
        C.left.smallEtaleTopology S_K.smallEtaleTopology hCont
        ⟨weilEtaleGmPresheaf S_K, hGm S_K⟩
    have hIsoPre : B_η.op ⋙ weilEtaleGmPresheaf S_K ≅ weilEtaleKPresheaf C.left := by
      refine CategoryTheory.NatIso.ofComponents (fun _ => CategoryTheory.Iso.refl _) ?_
      intro U₁ U₂ g
      have hmap : ((AlgebraicGeometry.Scheme.Etale.forget S_K).map (B_η.map g.unop)).left =
          ((CategoryTheory.Over.pullback η_X).map
            ((AlgebraicGeometry.Scheme.Etale.forget C.left).map g.unop)).left := rfl
      exact AddCommGrpCat.ext fun u =>
        congrArg (fun f : CategoryTheory.Limits.pullback U₂.unop.hom η_X ⟶
            CategoryTheory.Limits.pullback U₁.unop.hom η_X =>
          Additive.ofMul (Units.map f.appTop.hom.toMonoidHom (Additive.toMul u))) hmap
    exact (CategoryTheory.Presheaf.isSheaf_of_iso_iff hIsoPre).mp hPush

  
  have hDVR_pkg : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R],
      ∃ ord : Additive (Units (FractionRing R)) →+ ℤ,
        (∀ (u : Units (FractionRing R)) (a b : R) (na nb : ℕ),
          a ≠ 0 → b ≠ 0 →
          algebraMap R (FractionRing R) a = (u : FractionRing R) * algebraMap R (FractionRing R) b →
          Ideal.span ({a} : Set R) = IsLocalRing.maximalIdeal R ^ na →
          Ideal.span ({b} : Set R) = IsLocalRing.maximalIdeal R ^ nb →
          ord (Additive.ofMul u) = (na : ℤ) - (nb : ℤ)) := by
    intro R _ _ _
    let m := IsLocalRing.maximalIdeal R
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have hϖ_ne : ϖ ≠ 0 := hϖ.ne_zero
    have hϖ_nu : ¬ IsUnit ϖ := hϖ.not_isUnit
    have hm_eq : m = Ideal.span ({ϖ} : Set R) := hϖ.maximalIdeal_eq
    have hpow_span : ∀ n : ℕ, m ^ n = Ideal.span ({ϖ ^ n} : Set R) := by
      intro n; rw [hm_eq, Ideal.span_singleton_pow]
    have hpow_inj : Function.Injective (fun n : ℕ => m ^ n) := by
      have hlt : ∀ {n₁ n₂ : ℕ}, n₁ < n₂ → m ^ n₁ ≠ m ^ n₂ := by
        intro n₁ n₂ hlt h_eq
        rw [hpow_span n₁, hpow_span n₂] at h_eq
        have hmem : ϖ ^ n₁ ∈ Ideal.span ({ϖ ^ n₂} : Set R) := by
          rw [← h_eq]; exact Ideal.subset_span rfl
        obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp hmem
        obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_lt hlt
        have hmul : ϖ ^ n₁ * (ϖ * (ϖ ^ k * r)) = ϖ ^ n₁ * 1 := by
          calc ϖ ^ n₁ * (ϖ * (ϖ ^ k * r))
              = ϖ ^ (n₁ + k + 1) * r := by ring
            _ = ϖ ^ n₂ * r := by rw [hk]
            _ = ϖ ^ n₁ := hr.symm
            _ = ϖ ^ n₁ * 1 := (mul_one _).symm
        have h1 : ϖ * (ϖ ^ k * r) = 1 := mul_left_cancel₀ (pow_ne_zero n₁ hϖ_ne) hmul
        exact hϖ_nu (isUnit_iff_exists_inv.mpr ⟨ϖ ^ k * r, h1⟩)
      intro n₁ n₂ h_eq
      rcases lt_trichotomy n₁ n₂ with h | h | h
      · exact False.elim (hlt h h_eq)
      · exact h
      · exact False.elim (hlt h h_eq.symm)
    have hex_pow : ∀ a : R, a ≠ 0 → ∃ n : ℕ, Ideal.span ({a} : Set R) = m ^ n := by
      intro a ha
      obtain ⟨n, hn⟩ := IsDiscreteValuationRing.associated_pow_irreducible ha hϖ
      exact ⟨n, (Ideal.span_singleton_eq_span_singleton.mpr hn).trans (hpow_span n).symm⟩
    have hex_frac : ∀ u : Units (FractionRing R),
        ∃ (a b : R) (na nb : ℕ),
          a ≠ 0 ∧ b ≠ 0 ∧
          algebraMap R (FractionRing R) a =
            (u : FractionRing R) * algebraMap R (FractionRing R) b ∧
          Ideal.span ({a} : Set R) = m ^ na ∧
          Ideal.span ({b} : Set R) = m ^ nb := by
      intro u
      obtain ⟨a, b, hb_mem, hab_div⟩ := IsFractionRing.div_surjective (A := R) (u : FractionRing R)
      have hb : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_mem
      have hb_map : algebraMap R (FractionRing R) b ≠ 0 :=
        fun h0 => hb (IsFractionRing.injective R (FractionRing R) (h0.trans (map_zero _).symm))
      have hab : algebraMap R (FractionRing R) a =
          (u : FractionRing R) * algebraMap R (FractionRing R) b :=
        (div_eq_iff hb_map).mp hab_div
      have ha : a ≠ 0 := by
        intro ha0
        rw [ha0, map_zero] at hab
        exact mul_ne_zero u.ne_zero hb_map hab.symm
      obtain ⟨na, hna⟩ := hex_pow a ha
      obtain ⟨nb, hnb⟩ := hex_pow b hb
      exact ⟨a, b, na, nb, ha, hb, hab, hna, hnb⟩
    let ord_fun : Units (FractionRing R) → ℤ := fun u =>
      let na := (hex_frac u).choose_spec.choose_spec.choose
      let nb := (hex_frac u).choose_spec.choose_spec.choose_spec.choose
      (na : ℤ) - (nb : ℤ)
    have hord_spec : ∀ (u : Units (FractionRing R)) (a b : R) (na nb : ℕ),
        a ≠ 0 → b ≠ 0 →
        algebraMap R (FractionRing R) a = (u : FractionRing R) * algebraMap R (FractionRing R) b →
        Ideal.span ({a} : Set R) = m ^ na →
        Ideal.span ({b} : Set R) = m ^ nb →
        ord_fun u = (na : ℤ) - (nb : ℤ) := by
      intro u a b na nb _ _ hab hna hnb
      let a₀ := (hex_frac u).choose
      let b₀ := (hex_frac u).choose_spec.choose
      let na₀ := (hex_frac u).choose_spec.choose_spec.choose
      let nb₀ := (hex_frac u).choose_spec.choose_spec.choose_spec.choose
      rcases (hex_frac u).choose_spec.choose_spec.choose_spec.choose_spec with
        ⟨_, _, hab₀, hna₀, hnb₀⟩
      have hmul_F : algebraMap R (FractionRing R) (a * b₀) =
          algebraMap R (FractionRing R) (a₀ * b) := by
        rw [map_mul, map_mul, hab, hab₀]
        ring
      have hmul_R : a * b₀ = a₀ * b := IsFractionRing.injective R (FractionRing R) hmul_F
      have hpow_eq : m ^ (na + nb₀) = m ^ (na₀ + nb) := by
        rw [pow_add, pow_add, ← hna, ← hnb₀, ← hna₀, ← hnb,
          Ideal.span_singleton_mul_span_singleton, Ideal.span_singleton_mul_span_singleton, hmul_R]
      have hnat : na + nb₀ = na₀ + nb := hpow_inj hpow_eq
      change (na₀ : ℤ) - (nb₀ : ℤ) = (na : ℤ) - (nb : ℤ)
      omega
    refine ⟨{
      toFun := fun x => ord_fun (Additive.toMul x)
      map_zero' := by
        change ord_fun 1 = 0
        have h1 : Ideal.span ({(1 : R)} : Set R) = m ^ 0 := by
          rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_one]
        rw [hord_spec 1 1 1 0 0 one_ne_zero one_ne_zero (by simp) h1 h1]
        rfl
      map_add' := fun x₁ x₂ => by
        let u₁ := Additive.toMul x₁
        let u₂ := Additive.toMul x₂
        obtain ⟨a₁, b₁, na₁, nb₁, ha₁, hb₁, hab₁, hna₁, hnb₁⟩ := hex_frac u₁
        obtain ⟨a₂, b₂, na₂, nb₂, ha₂, hb₂, hab₂, hna₂, hnb₂⟩ := hex_frac u₂
        change ord_fun (u₁ * u₂) = ord_fun u₁ + ord_fun u₂
        rw [hord_spec u₁ a₁ b₁ na₁ nb₁ ha₁ hb₁ hab₁ hna₁ hnb₁,
          hord_spec u₂ a₂ b₂ na₂ nb₂ ha₂ hb₂ hab₂ hna₂ hnb₂,
          hord_spec (u₁ * u₂) (a₁ * a₂) (b₁ * b₂) (na₁ + na₂) (nb₁ + nb₂)
            (mul_ne_zero ha₁ ha₂) (mul_ne_zero hb₁ hb₂)
            (by rw [map_mul, map_mul, hab₁, hab₂, Units.val_mul]; ring)
            (by rw [← Ideal.span_singleton_mul_span_singleton, hna₁, hna₂, pow_add])
            (by rw [← Ideal.span_singleton_mul_span_singleton, hnb₁, hnb₂, pow_add])]
        push_cast; ring }, fun u a b na nb ha hb hab hna hnb =>
          hord_spec u a b na nb ha hb hab hna hnb⟩

  let ordDVR := fun (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] =>
    (hDVR_pkg R).choose
  have hordDVR : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      (u : Units (FractionRing R)) (a b : R) (na nb : ℕ),
      a ≠ 0 → b ≠ 0 →
      algebraMap R (FractionRing R) a = (u : FractionRing R) * algebraMap R (FractionRing R) b →
      Ideal.span ({a} : Set R) = IsLocalRing.maximalIdeal R ^ na →
      Ideal.span ({b} : Set R) = IsLocalRing.maximalIdeal R ^ nb →
      ordDVR R (Additive.ofMul u) = (na : ℤ) - (nb : ℤ) :=
    fun R _ _ _ => (hDVR_pkg R).choose_spec

  have hordDVR_unit : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      (v : Units R),
      ordDVR R (Additive.ofMul (Units.map (algebraMap R (FractionRing R)).toMonoidHom v)) = 0 := by
    intro R _ _ _ v
    have h1 : Ideal.span ({(1 : R)} : Set R) = IsLocalRing.maximalIdeal R ^ 0 := by
      rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_one]
    have hv : Ideal.span ({(v : R)} : Set R) = IsLocalRing.maximalIdeal R ^ 0 := by
      rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_eq_top.mpr v.isUnit]
    exact hordDVR R _ (v : R) 1 0 0 v.ne_zero one_ne_zero (by simp) hv h1

  have hordDVR_ext : ∀ (R₁ R₂ : Type u) [CommRing R₁] [IsDomain R₁] [IsDiscreteValuationRing R₁]
      [CommRing R₂] [IsDomain R₂] [IsDiscreteValuationRing R₂]
      (ψ : R₂ →+* R₁) (ψ_tilde : FractionRing R₂ →+* FractionRing R₁),
      Function.Injective ψ →
      (∀ n : ℕ, Ideal.map ψ (IsLocalRing.maximalIdeal R₂ ^ n) = IsLocalRing.maximalIdeal R₁ ^ n) →
      (∀ r : R₂, ψ_tilde (algebraMap R₂ (FractionRing R₂) r) =
        algebraMap R₁ (FractionRing R₁) (ψ r)) →
      ∀ u : Units (FractionRing R₂),
        ordDVR R₁ (Additive.ofMul (Units.map ψ_tilde.toMonoidHom u)) =
          ordDVR R₂ (Additive.ofMul u) := by
    intro R₁ R₂ _ _ _ _ _ _ ψ ψ_tilde hψ_inj hψ_pow hψ_alg u
    obtain ⟨a, b, hb_mem, hab_div⟩ := IsFractionRing.div_surjective (A := R₂) (u : FractionRing R₂)
    have hb : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_mem
    have hb_map : algebraMap R₂ (FractionRing R₂) b ≠ 0 :=
      fun h0 => hb (IsFractionRing.injective R₂ (FractionRing R₂) (h0.trans (map_zero _).symm))
    have hab : algebraMap R₂ (FractionRing R₂) a =
        (u : FractionRing R₂) * algebraMap R₂ (FractionRing R₂) b :=
      (div_eq_iff hb_map).mp hab_div
    have ha : a ≠ 0 := fun ha0 => by
      rw [ha0, map_zero] at hab; exact mul_ne_zero u.ne_zero hb_map hab.symm
    obtain ⟨ϖ₂, hϖ₂⟩ := IsDiscreteValuationRing.exists_irreducible R₂
    obtain ⟨na, hna_assoc⟩ := IsDiscreteValuationRing.associated_pow_irreducible ha hϖ₂
    obtain ⟨nb, hnb_assoc⟩ := IsDiscreteValuationRing.associated_pow_irreducible hb hϖ₂
    have hna : Ideal.span ({a} : Set R₂) = IsLocalRing.maximalIdeal R₂ ^ na := by
      rw [hϖ₂.maximalIdeal_eq, Ideal.span_singleton_pow]
      exact Ideal.span_singleton_eq_span_singleton.mpr hna_assoc
    have hnb : Ideal.span ({b} : Set R₂) = IsLocalRing.maximalIdeal R₂ ^ nb := by
      rw [hϖ₂.maximalIdeal_eq, Ideal.span_singleton_pow]
      exact Ideal.span_singleton_eq_span_singleton.mpr hnb_assoc
    have hψa : ψ a ≠ 0 := fun h0 => ha (hψ_inj (h0.trans (map_zero ψ).symm))
    have hψb : ψ b ≠ 0 := fun h0 => hb (hψ_inj (h0.trans (map_zero ψ).symm))
    have hab₁ : algebraMap R₁ (FractionRing R₁) (ψ a) =
        (Units.map ψ_tilde.toMonoidHom u : FractionRing R₁) *
          algebraMap R₁ (FractionRing R₁) (ψ b) := by
      rw [← hψ_alg a, ← hψ_alg b]
      change ψ_tilde (algebraMap R₂ (FractionRing R₂) a) =
        ψ_tilde (u : FractionRing R₂) * ψ_tilde (algebraMap R₂ (FractionRing R₂) b)
      rw [← map_mul ψ_tilde, hab]
    have hna₁ : Ideal.span ({ψ a} : Set R₁) = IsLocalRing.maximalIdeal R₁ ^ na := by
      rw [← hψ_pow na, ← hna, Ideal.map_span, Set.image_singleton]
    have hnb₁ : Ideal.span ({ψ b} : Set R₁) = IsLocalRing.maximalIdeal R₁ ^ nb := by
      rw [← hψ_pow nb, ← hnb, Ideal.map_span, Set.image_singleton]
    rw [hordDVR R₁ _ (ψ a) (ψ b) na nb hψa hψb hab₁ hna₁ hnb₁,
      hordDVR R₂ u a b na nb ha hb hab hna hnb]

  have hordDVR_nonzero_mem : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      (u : Units (FractionRing R)) (c d : R),
      c ≠ 0 → d ≠ 0 →
      (u : FractionRing R) * algebraMap R (FractionRing R) d = algebraMap R (FractionRing R) c →
      ordDVR R (Additive.ofMul u) ≠ 0 →
      c * d ∈ IsLocalRing.maximalIdeal R := by
    intro R _ _ _ u c d hc hd hcd hne
    by_contra hnot
    have hunit_cd : IsUnit (c * d) := IsLocalRing.notMem_maximalIdeal.mp hnot
    have hc_u : IsUnit c := isUnit_of_mul_isUnit_left hunit_cd
    have hd_u : IsUnit d := isUnit_of_mul_isUnit_right hunit_cd
    have hspan_c : Ideal.span ({c} : Set R) = IsLocalRing.maximalIdeal R ^ 0 := by
      rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_eq_top.mpr hc_u]
    have hspan_d : Ideal.span ({d} : Set R) = IsLocalRing.maximalIdeal R ^ 0 := by
      rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_eq_top.mpr hd_u]
    exact hne (hordDVR R u c d 0 0 hc hd hcd.symm hspan_c hspan_d)

  
  obtain ⟨Div_sh, valDiv, hValInj, hValRangeLoc, hValRangeComp, hValNat⟩ :=
    weil_etale_separated_locFinite_closedFiber_sheaf k C
  obtain ⟨hStrict_C, hDVR_et, hUnram, hChart⟩ :=
    weil_smooth_curve_etale_stalk_dvr_and_domain_chart k C hDim

  
  let T_X : C.left.Etale := weilEtaleIdTerminal C.left
  let hT_X : CategoryTheory.Limits.IsTerminal T_X := weilEtaleIdTerminalIsTerminal C.left

  
  let toGmUnit : ∀ (U : C.left.Etale),
      ↥((weilEtaleGmPresheaf C.left).obj (Opposite.op U)) →
        Units ↑(((AlgebraicGeometry.Scheme.Etale.forget C.left).obj U).left.presheaf.obj
          (Opposite.op ⊤)) :=
    fun U u => @Additive.toMul
      (Units ↑(((AlgebraicGeometry.Scheme.Etale.forget C.left).obj U).left.presheaf.obj
        (Opposite.op ⊤))) u
  let toKUnit : ∀ (U : C.left.Etale),
      ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U)) →
        Units ↑((CategoryTheory.Limits.pullback
          (((AlgebraicGeometry.Scheme.Etale.forget C.left).obj U).hom) η_X).presheaf.obj
          (Opposite.op ⊤)) :=
    fun U s => @Additive.toMul
      (Units ↑((CategoryTheory.Limits.pullback
        (((AlgebraicGeometry.Scheme.Etale.forget C.left).obj U).hom) η_X).presheaf.obj
        (Opposite.op ⊤))) s

  let ι_pre : weilEtaleGmPresheaf C.left ⟶ weilEtaleKPresheaf C.left :=
    { app := fun U =>
        AddCommGrpCat.ofHom (MonoidHom.toAdditive
          (Units.map (CategoryTheory.Limits.pullback.fst U.unop.hom η_X).appTop.hom.toMonoidHom))
      naturality := fun U₂ U₁ f => by
        let g : U₁.unop ⟶ U₂.unop := f.unop
        let m_g : CategoryTheory.Limits.pullback U₁.unop.hom η_X ⟶
            CategoryTheory.Limits.pullback U₂.unop.hom η_X :=
          ((CategoryTheory.Over.pullback η_X).map
            ((AlgebraicGeometry.Scheme.Etale.forget C.left).map g)).left
        have hfst : m_g ≫ CategoryTheory.Limits.pullback.fst U₂.unop.hom η_X =
            CategoryTheory.Limits.pullback.fst U₁.unop.hom η_X ≫ g.left := by
          have hm : m_g = CategoryTheory.Limits.pullback.map U₁.unop.hom η_X U₂.unop.hom η_X
              g.left (𝟙 S_K) (𝟙 C.left)
              ((CategoryTheory.Category.comp_id _).trans
                (CategoryTheory.MorphismProperty.Over.w g).symm)
              (by simp) :=
            CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ η_X g
          exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst U₂.unop.hom η_X) hm).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        have happ : (CategoryTheory.Limits.pullback.fst U₂.unop.hom η_X).appTop ≫ m_g.appTop =
            g.left.appTop ≫ (CategoryTheory.Limits.pullback.fst U₁.unop.hom η_X).appTop :=
          (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _).symm.trans
            ((congrArg AlgebraicGeometry.Scheme.Hom.appTop hfst).trans
              (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _))
        apply AddCommGrpCat.ext
        intro u
        apply Additive.toMul.injective
        apply Units.ext
        exact (ConcreteCategory.congr_hom happ (toGmUnit U₂.unop u).val).symm }

  have hDom_base : ∀ x : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) },
      IsDomain ↑(C.left.presheaf.stalk x.1) :=
    fun x => (hDVR_et T_X ⟨x.1, x.2⟩).choose

  let φ_tilde : ∀ (U : C.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) }),
      K →+* FractionRing ↑(U.left.presheaf.stalk y.1) := fun U y =>
    let x : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) } := ⟨U.hom.base y.1, y.2⟩
    let Rx := ↑(C.left.presheaf.stalk x.1)
    let Ry := ↑(U.left.presheaf.stalk y.1)
    let _ : IsDomain Rx := hDom_base x
    let _ : IsDomain Ry := (hDVR_et U y).choose
    let t_U : U ⟶ T_X :=
      CategoryTheory.MorphismProperty.Over.homMk U.hom (CategoryTheory.Category.comp_id U.hom)
    let ψ_y : Rx →+* FractionRing Ry :=
      (algebraMap Ry (FractionRing Ry)).comp (U.hom.stalkMap y.1).hom
    have hψ_inj : Function.Injective ψ_y :=
      (IsFractionRing.injective Ry (FractionRing Ry)).comp (hUnram t_U y).1
    IsFractionRing.lift hψ_inj

  have hφ_tilde_alg : ∀ (U : C.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) })
      (r : ↑(C.left.presheaf.stalk (U.hom.base y.1))),
      φ_tilde U y (algebraMap ↑(C.left.presheaf.stalk (U.hom.base y.1)) K r) =
        algebraMap ↑(U.left.presheaf.stalk y.1) _ ((U.hom.stalkMap y.1).hom r) := by
    intro U y r
    let _ : IsDomain ↑(C.left.presheaf.stalk (U.hom.base y.1)) := hDom_base ⟨U.hom.base y.1, y.2⟩
    let _ : IsDomain ↑(U.left.presheaf.stalk y.1) := (hDVR_et U y).choose
    exact IsFractionRing.lift_algebraMap _ r

  have hcomm_γ : ∀ (U : C.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) }),
      (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↑(U.left.presheaf.stalk y.1)
            (FractionRing ↑(U.left.presheaf.stalk y.1)))) ≫
          U.left.fromSpecStalk y.1) ≫ U.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde U y)) ≫ η_X := by
    intro U y
    let U_sch : AlgebraicGeometry.Scheme.{u} := U.left
    let u_hom : U_sch ⟶ C.left := U.hom
    let x : ↥C.left := u_hom.base y.1
    let Ry := ↑(U_sch.presheaf.stalk y.1)
    have h1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ry (FractionRing Ry))) ≫
          U_sch.fromSpecStalk y.1) ≫ u_hom =
        AlgebraicGeometry.Spec.map
          (u_hom.stalkMap y.1 ≫ CommRingCat.ofHom (algebraMap Ry (FractionRing Ry))) ≫
          C.left.fromSpecStalk x := by
      rw [CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Scheme.SpecMap_stalkMap_fromSpecStalk u_hom,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have h2 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde U y)) ≫ η_X =
        AlgebraicGeometry.Spec.map
          (C.left.presheaf.stalkSpecializes (genericPoint_specializes x) ≫
            CommRingCat.ofHom (φ_tilde U y)) ≫ C.left.fromSpecStalk x := by
      dsimp [η_X]
      rw [← AlgebraicGeometry.Scheme.SpecMap_stalkSpecializes_fromSpecStalk
          (genericPoint_specializes x),
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have hring : u_hom.stalkMap y.1 ≫ CommRingCat.ofHom (algebraMap Ry (FractionRing Ry)) =
        C.left.presheaf.stalkSpecializes (genericPoint_specializes x) ≫
          CommRingCat.ofHom (φ_tilde U y) := by
      ext r
      change algebraMap Ry (FractionRing Ry) ((u_hom.stalkMap y.1).hom r) =
        φ_tilde U y (algebraMap _ K r)
      exact (hφ_tilde_alg U y r).symm
    exact h1.trans
      ((congrArg (fun φ => AlgebraicGeometry.Spec.map φ ≫ C.left.fromSpecStalk x) hring).trans
        h2.symm)

  let γ_Uy : ∀ (U : C.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) }),
      AlgebraicGeometry.Spec (CommRingCat.of (FractionRing ↑(U.left.presheaf.stalk y.1))) ⟶
        CategoryTheory.Limits.pullback U.hom η_X := fun U y =>
    CategoryTheory.Limits.pullback.lift
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↑(U.left.presheaf.stalk y.1)
          (FractionRing ↑(U.left.presheaf.stalk y.1)))) ≫ U.left.fromSpecStalk y.1)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde U y)))
      (hcomm_γ U y)

  let ev_Uy : ∀ (U : C.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) }),
      ↑((CategoryTheory.Limits.pullback U.hom η_X).presheaf.obj (Opposite.op ⊤)) →+*
        FractionRing ↑(U.left.presheaf.stalk y.1) := fun U y =>
    ((γ_Uy U y).appTop ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso
        (CommRingCat.of (FractionRing ↑(U.left.presheaf.stalk y.1)))).hom).hom

  have hev_fst : ∀ (U : C.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) })
      (r : ↑(U.left.presheaf.obj (Opposite.op ⊤))),
      ev_Uy U y ((CategoryTheory.Limits.pullback.fst U.hom η_X).appTop.hom r) =
        algebraMap ↑(U.left.presheaf.stalk y.1) _
          ((U.left.presheaf.germ ⊤ y.1 trivial).hom r) := by
    intro U y r
    let U_sch : AlgebraicGeometry.Scheme.{u} := U.left
    let u_hom : U_sch ⟶ C.left := U.hom
    let Ry := ↑(U_sch.presheaf.stalk y.1)
    have hfst : γ_Uy U y ≫ CategoryTheory.Limits.pullback.fst u_hom η_X =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ry (FractionRing Ry))) ≫
          U_sch.fromSpecStalk y.1 :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have happ : (CategoryTheory.Limits.pullback.fst u_hom η_X).appTop ≫ (γ_Uy U y).appTop ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (FractionRing Ry))).hom =
        U_sch.presheaf.germ ⊤ y.1 trivial ≫
          CommRingCat.ofHom (algebraMap Ry (FractionRing Ry)) := by
      have hcomp_top : (CategoryTheory.Limits.pullback.fst u_hom η_X).appTop ≫ (γ_Uy U y).appTop =
          (U_sch.fromSpecStalk y.1).appTop ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ry (FractionRing Ry)))).appTop :=
        (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _).symm.trans
          ((congrArg AlgebraicGeometry.Scheme.Hom.appTop hfst).trans
            (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _))
      rw [← CategoryTheory.Category.assoc, hcomp_top, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality]
      have hfs := U_sch.fromSpecStalk_app (U := ⊤) (x := y.1) trivial
      have hhom_id : (CategoryTheory.homOfLE
          (le_rfl : (⊤ : (AlgebraicGeometry.Spec (U_sch.presheaf.stalk y.1)).Opens) ≤ ⊤)) =
          𝟙 ⊤ := Subsingleton.elim _ _
      have hmap_id : (AlgebraicGeometry.Spec (U_sch.presheaf.stalk y.1)).presheaf.map
          (CategoryTheory.homOfLE
            (le_rfl : (⊤ : (AlgebraicGeometry.Spec (U_sch.presheaf.stalk y.1)).Opens) ≤ ⊤)).op =
          𝟙 _ :=
        (congrArg
          (fun f => (AlgebraicGeometry.Spec (U_sch.presheaf.stalk y.1)).presheaf.map f.op)
          hhom_id).trans
          ((AlgebraicGeometry.Spec (U_sch.presheaf.stalk y.1)).presheaf.map_id (Opposite.op ⊤))
      have hfs' : (U_sch.fromSpecStalk y.1).appTop =
          U_sch.presheaf.germ ⊤ y.1 trivial ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (U_sch.presheaf.stalk y.1)).inv :=
        hfs.trans (congrArg (U_sch.presheaf.germ ⊤ y.1 trivial ≫ ·)
          ((congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (U_sch.presheaf.stalk y.1)).inv ≫ ·)
            hmap_id).trans (CategoryTheory.Category.comp_id _)))
      rw [hfs', CategoryTheory.Category.assoc]
      exact congrArg (U_sch.presheaf.germ ⊤ y.1 trivial ≫ ·)
        ((AlgebraicGeometry.Scheme.ΓSpecIso (U_sch.presheaf.stalk y.1)).inv_hom_id_assoc _)
    exact ConcreteCategory.congr_hom happ r

  let div_val : ∀ U : C.left.Etale,
      ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U)) →+
        ({ y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) } → ℤ) := fun U =>
    AddMonoidHom.pi fun y =>
      let _ : IsDomain ↑(U.left.presheaf.stalk y.1) := (hDVR_et U y).choose
      let _ : IsDiscreteValuationRing ↑(U.left.presheaf.stalk y.1) := (hDVR_et U y).choose_spec
      { toFun := fun s =>
          ordDVR ↑(U.left.presheaf.stalk y.1)
            (Additive.ofMul (Units.map (ev_Uy U y).toMonoidHom (toKUnit U s)))
        map_zero' :=
          (congrArg (fun v => ordDVR _ (Additive.ofMul v))
            ((Units.map (ev_Uy U y).toMonoidHom).map_one)).trans
            ((ordDVR _).map_zero)
        map_add' := fun s₁ s₂ =>
          (congrArg (fun v => ordDVR _ (Additive.ofMul v))
            ((Units.map (ev_Uy U y).toMonoidHom).map_mul (toKUnit U s₁) (toKUnit U s₂))).trans
            ((ordDVR _).map_add _ _) }

  
  have hDivNat : ∀ {U₁ U₂ : C.left.Etale} (g : U₁ ⟶ U₂)
      (s : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U₂)))
      (y₁ : { y : ↥U₁.left // IsClosed ({U₁.hom.base y} : Set ↥C.left) }),
      div_val U₁ (((weilEtaleKPresheaf C.left).map g.op).hom s) y₁ =
        div_val U₂ s ⟨g.left.base y₁.1, by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w g]
          exact y₁.2⟩ := by
    intro U₁ U₂ g s y₁
    let U₁_sch : AlgebraicGeometry.Scheme.{u} := U₁.left
    let U₂_sch : AlgebraicGeometry.Scheme.{u} := U₂.left
    let u₁_hom : U₁_sch ⟶ C.left := U₁.hom
    let u₂_hom : U₂_sch ⟶ C.left := U₂.hom
    let g_left : U₁_sch ⟶ U₂_sch := g.left
    let y₂ : { y : ↥U₂.left // IsClosed ({U₂.hom.base y} : Set ↥C.left) } :=
      ⟨g_left.base y₁.1, by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w g]
        exact y₁.2⟩
    let Ry₁ := ↑(U₁_sch.presheaf.stalk y₁.1)
    let Ry₂ := ↑(U₂_sch.presheaf.stalk y₂.1)
    let _ : IsDomain Ry₁ := (hDVR_et U₁ y₁).choose
    let _ : IsDiscreteValuationRing Ry₁ := (hDVR_et U₁ y₁).choose_spec
    let _ : IsDomain Ry₂ := (hDVR_et U₂ y₂).choose
    let _ : IsDiscreteValuationRing Ry₂ := (hDVR_et U₂ y₂).choose_spec
    rcases hUnram g y₁ with ⟨hInj_g, hPow_g⟩
    let ψ_g : Ry₂ →+* FractionRing Ry₁ :=
      (algebraMap Ry₁ (FractionRing Ry₁)).comp (g_left.stalkMap y₁.1).hom
    have hψg_inj : Function.Injective ψ_g :=
      (IsFractionRing.injective Ry₁ (FractionRing Ry₁)).comp hInj_g
    let ψ_tilde : FractionRing Ry₂ →+* FractionRing Ry₁ := IsFractionRing.lift hψg_inj
    have hψ_alg : ∀ r : Ry₂, ψ_tilde (algebraMap Ry₂ (FractionRing Ry₂) r) =
        algebraMap Ry₁ (FractionRing Ry₁) ((g_left.stalkMap y₁.1).hom r) :=
      fun r => IsFractionRing.lift_algebraMap hψg_inj r
    have hcomp_K : ψ_tilde.comp (φ_tilde U₂ y₂) = φ_tilde U₁ y₁ := by
      let Rx₂ := ↑(C.left.presheaf.stalk (u₂_hom.base y₂.1))
      have : IsDomain Rx₂ := hDom_base ⟨u₂_hom.base y₂.1, y₂.2⟩
      apply IsLocalization.ringHom_ext (nonZeroDivisors Rx₂)
      ext r
      change ψ_tilde (φ_tilde U₂ y₂ (algebraMap Rx₂ K r)) =
        φ_tilde U₁ y₁ (algebraMap Rx₂ K r)
      rw [hφ_tilde_alg U₂ y₂ r, hψ_alg]
      have hw : g_left ≫ u₂_hom = u₁_hom := CategoryTheory.MorphismProperty.Over.w g
      have hp : u₂_hom.base y₂.1 = u₁_hom.base y₁.1 := by
        change u₂_hom.base (g_left.base y₁.1) = u₁_hom.base y₁.1
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hw]
      have hins : Inseparable (u₁_hom.base y₁.1) (u₂_hom.base y₂.1) :=
        Inseparable.of_eq hp.symm
      let e_sc := C.left.presheaf.stalkCongr hins
      have hst : u₁_hom.stalkMap y₁.1 =
          e_sc.hom ≫ u₂_hom.stalkMap y₂.1 ≫ g_left.stalkMap y₁.1 :=
        (AlgebraicGeometry.Scheme.Hom.stalkMap_congr_hom u₁_hom (g_left ≫ u₂_hom) hw.symm y₁.1).trans
          (congrArg (e_sc.hom ≫ ·) (AlgebraicGeometry.Scheme.Hom.stalkMap_comp g_left u₂_hom y₁.1))
      let r₁ : ↑(C.left.presheaf.stalk (u₁_hom.base y₁.1)) := e_sc.inv.hom r
      have hhom_sp : e_sc.hom ≫
            C.left.presheaf.stalkSpecializes (genericPoint_specializes (u₂_hom.base y₂.1)) =
          C.left.presheaf.stalkSpecializes (genericPoint_specializes (u₁_hom.base y₁.1)) :=
        (congrArg (· ≫ C.left.presheaf.stalkSpecializes (genericPoint_specializes (u₂_hom.base y₂.1)))
          (TopCat.Presheaf.stalkCongr_hom C.left.presheaf hins)).trans
          (C.left.presheaf.stalkSpecializes_comp (genericPoint_specializes (u₂_hom.base y₂.1)) _)
      have hinv_sp : e_sc.inv ≫
            C.left.presheaf.stalkSpecializes (genericPoint_specializes (u₁_hom.base y₁.1)) =
          C.left.presheaf.stalkSpecializes (genericPoint_specializes (u₂_hom.base y₂.1)) :=
        (congrArg (e_sc.inv ≫ ·) hhom_sp.symm).trans
          (e_sc.inv_hom_id_assoc
            (C.left.presheaf.stalkSpecializes (genericPoint_specializes (u₂_hom.base y₂.1))))
      have halg_eq : algebraMap ↑(C.left.presheaf.stalk (u₁_hom.base y₁.1)) K r₁ =
          algebraMap Rx₂ K r :=
        ConcreteCategory.congr_hom hinv_sp r
      rw [← halg_eq, hφ_tilde_alg U₁ y₁ r₁]
      have hst_r := ConcreteCategory.congr_hom hst r₁
      change _ = algebraMap Ry₁ (FractionRing Ry₁) ((u₁_hom.stalkMap y₁.1).hom r₁)
      rw [hst_r]
      have hinv_hom_r : e_sc.hom.hom r₁ = r :=
        ConcreteCategory.congr_hom e_sc.inv_hom_id r
      exact congrArg (fun z => algebraMap Ry₁ (FractionRing Ry₁)
        ((g_left.stalkMap y₁.1).hom ((u₂_hom.stalkMap y₂.1).hom z))) hinv_hom_r.symm
    let m_g : CategoryTheory.Limits.pullback u₁_hom η_X ⟶
        CategoryTheory.Limits.pullback u₂_hom η_X :=
      ((CategoryTheory.Over.pullback η_X).map
        ((AlgebraicGeometry.Scheme.Etale.forget C.left).map g)).left
    have hm_g_eq : m_g = CategoryTheory.Limits.pullback.map u₁_hom η_X u₂_hom η_X
        g_left (𝟙 S_K) (𝟙 C.left)
        ((CategoryTheory.Category.comp_id _).trans
          (CategoryTheory.MorphismProperty.Over.w g).symm)
        (by simp) :=
      CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ η_X g
    have hγ_mg : γ_Uy U₁ y₁ ≫ m_g =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_tilde) ≫ γ_Uy U₂ y₂ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · have hm_fst : m_g ≫ CategoryTheory.Limits.pullback.fst u₂_hom η_X =
            CategoryTheory.Limits.pullback.fst u₁_hom η_X ≫ g_left :=
          (congrArg (· ≫ CategoryTheory.Limits.pullback.fst u₂_hom η_X) hm_g_eq).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        have hγ₁_fst : γ_Uy U₁ y₁ ≫ CategoryTheory.Limits.pullback.fst u₁_hom η_X =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ry₁ (FractionRing Ry₁))) ≫
              U₁_sch.fromSpecStalk y₁.1 :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hγ₂_fst : γ_Uy U₂ y₂ ≫ CategoryTheory.Limits.pullback.fst u₂_hom η_X =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ry₂ (FractionRing Ry₂))) ≫
              U₂_sch.fromSpecStalk y₂.1 :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        rw [CategoryTheory.Category.assoc, hm_fst, ← CategoryTheory.Category.assoc,
          hγ₁_fst, CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_tilde)),
          hγ₂_fst, CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Scheme.SpecMap_stalkMap_fromSpecStalk g_left,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        congr 2
        ext r
        change algebraMap Ry₁ (FractionRing Ry₁) ((g_left.stalkMap y₁.1).hom r) =
          ψ_tilde (algebraMap Ry₂ (FractionRing Ry₂) r)
        exact (hψ_alg r).symm
      · have hm_snd : m_g ≫ CategoryTheory.Limits.pullback.snd u₂_hom η_X =
            CategoryTheory.Limits.pullback.snd u₁_hom η_X :=
          (congrArg (· ≫ CategoryTheory.Limits.pullback.snd u₂_hom η_X) hm_g_eq).trans
            ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
              (CategoryTheory.Category.comp_id _))
        have hγ₁_snd : γ_Uy U₁ y₁ ≫ CategoryTheory.Limits.pullback.snd u₁_hom η_X =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde U₁ y₁)) :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hγ₂_snd : γ_Uy U₂ y₂ ≫ CategoryTheory.Limits.pullback.snd u₂_hom η_X =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde U₂ y₂)) :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        rw [CategoryTheory.Category.assoc, hm_snd, hγ₁_snd,
          CategoryTheory.Category.assoc, hγ₂_snd,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp_K]
    have hev_mg : ∀ z, ev_Uy U₁ y₁ (m_g.appTop.hom z) = ψ_tilde (ev_Uy U₂ y₂ z) := by
      intro z
      have happ : m_g.appTop ≫ (γ_Uy U₁ y₁).appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (FractionRing Ry₁))).hom =
          ((γ_Uy U₂ y₂).appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (FractionRing Ry₂))).hom) ≫
            CommRingCat.ofHom ψ_tilde := by
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Hom.comp_appTop,
          hγ_mg, AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.ΓSpecIso_naturality, CategoryTheory.Category.assoc]
      exact ConcreteCategory.congr_hom happ z
    have hunit_eq : Units.map (ev_Uy U₁ y₁).toMonoidHom
          (Units.map m_g.appTop.hom.toMonoidHom (toKUnit U₂ s)) =
        Units.map ψ_tilde.toMonoidHom
          (Units.map (ev_Uy U₂ y₂).toMonoidHom (toKUnit U₂ s)) := by
      ext; exact hev_mg (toKUnit U₂ s).val
    change ordDVR Ry₁ (Additive.ofMul (Units.map (ev_Uy U₁ y₁).toMonoidHom
        (Units.map m_g.appTop.hom.toMonoidHom (toKUnit U₂ s)))) =
      ordDVR Ry₂ (Additive.ofMul (Units.map (ev_Uy U₂ y₂).toMonoidHom (toKUnit U₂ s)))
    rw [hunit_eq]
    exact hordDVR_ext Ry₁ Ry₂ (g_left.stalkMap y₁.1).hom ψ_tilde hInj_g hPow_g hψ_alg _

  
  have hDivZero : ∀ (U : C.left.Etale)
      (u : ↥((weilEtaleGmPresheaf C.left).obj (Opposite.op U))),
      div_val U ((ι_pre.app (Opposite.op U)).hom u) = 0 := by
    intro U u
    ext y
    let Ry := ↑(U.left.presheaf.stalk y.1)
    let _ : IsDomain Ry := (hDVR_et U y).choose
    let _ : IsDiscreteValuationRing Ry := (hDVR_et U y).choose_spec
    let v : Units Ry := Units.map (U.left.presheaf.germ ⊤ y.1 trivial).hom.toMonoidHom
      (toGmUnit U u)
    have hu_eq : Units.map (ev_Uy U y).toMonoidHom
          (Units.map (CategoryTheory.Limits.pullback.fst U.hom η_X).appTop.hom.toMonoidHom
            (toGmUnit U u)) =
        Units.map (algebraMap Ry (FractionRing Ry)).toMonoidHom v := by
      ext; exact hev_fst U y (toGmUnit U u).val
    change ordDVR Ry (Additive.ofMul (Units.map (ev_Uy U y).toMonoidHom
      (Units.map (CategoryTheory.Limits.pullback.fst U.hom η_X).appTop.hom.toMonoidHom
        (toGmUnit U u)))) = 0
    rw [hu_eq]
    exact hordDVR_unit Ry v

  
  have hTensor_aux : ∀ (R₀ D₀ K₀ : Type u) [CommRing R₀] [CommRing D₀] [IsDomain D₀]
      [Field K₀] [Algebra R₀ D₀] [Algebra R₀ K₀] [IsFractionRing R₀ K₀],
      Function.Injective (algebraMap R₀ D₀) →
      Function.Injective
        (Algebra.TensorProduct.includeLeftRingHom : D₀ →+* TensorProduct R₀ D₀ K₀) ∧
      (∀ u_T : Units (TensorProduct R₀ D₀ K₀), ∃ c d : D₀, c ≠ 0 ∧ d ≠ 0 ∧
        (u_T : TensorProduct R₀ D₀ K₀) *
          (Algebra.TensorProduct.includeLeftRingHom : D₀ →+* TensorProduct R₀ D₀ K₀) d =
          (Algebra.TensorProduct.includeLeftRingHom : D₀ →+* TensorProduct R₀ D₀ K₀) c) := by
    intro R₀ D₀ K₀ _ _ _ _ _ _ _ hInj₀
    have : Nontrivial R₀ :=
      ⟨⟨0, 1, fun h => zero_ne_one
        ((map_zero (algebraMap R₀ D₀)).symm.trans
          ((congrArg (algebraMap R₀ D₀) h).trans (map_one (algebraMap R₀ D₀))))⟩⟩
    have : NoZeroDivisors R₀ :=
      ⟨fun {a b} hab => by
        have h0 : algebraMap R₀ D₀ a * algebraMap R₀ D₀ b = 0 := by
          rw [← map_mul, hab, map_zero]
        exact (mul_eq_zero.mp h0).imp
          (fun ha => hInj₀ (ha.trans (map_zero _).symm))
          (fun hb => hInj₀ (hb.trans (map_zero _).symm))⟩
    have : IsDomain R₀ := {}
    let L₀ := FractionRing D₀
    let ψ_A : R₀ →+* L₀ := (algebraMap D₀ L₀).comp (algebraMap R₀ D₀)
    have hψA_inj : Function.Injective ψ_A :=
      (IsFractionRing.injective D₀ L₀).comp hInj₀
    let ψ_K : K₀ →+* L₀ := IsFractionRing.lift hψA_inj
    let ι_D₀ : D₀ →+* TensorProduct R₀ D₀ K₀ := Algebra.TensorProduct.includeLeftRingHom
    let ι_K₀ : K₀ →+* TensorProduct R₀ D₀ K₀ := Algebra.TensorProduct.includeRight.toRingHom
    let bilin : D₀ →ₗ[R₀] K₀ →ₗ[R₀] L₀ :=
      { toFun := fun d =>
          { toFun := fun κ => algebraMap D₀ L₀ d * ψ_K κ
            map_add' := fun x y => by rw [map_add, mul_add]
            map_smul' := fun a x => by
              rw [RingHom.id_apply, Algebra.smul_def a x, map_mul,
                IsFractionRing.lift_algebraMap hψA_inj a,
                ← IsScalarTower.algebraMap_smul D₀ a _, Algebra.smul_def]
              dsimp only [ψ_A, RingHom.comp_apply]
              ring }
        map_add' := fun d₁ d₂ => LinearMap.ext fun κ => by
          change algebraMap D₀ L₀ (d₁ + d₂) * ψ_K κ =
            algebraMap D₀ L₀ d₁ * ψ_K κ + algebraMap D₀ L₀ d₂ * ψ_K κ
          rw [map_add, add_mul]
        map_smul' := fun a d => LinearMap.ext fun κ => by
          rw [RingHom.id_apply, LinearMap.smul_apply, Algebra.smul_def a d,
            ← IsScalarTower.algebraMap_smul D₀ a _, Algebra.smul_def]
          change algebraMap D₀ L₀ (algebraMap R₀ D₀ a * d) * ψ_K κ =
            algebraMap D₀ L₀ (algebraMap R₀ D₀ a) * (algebraMap D₀ L₀ d * ψ_K κ)
          rw [map_mul]
          exact mul_assoc (algebraMap D₀ L₀ (algebraMap R₀ D₀ a)) (algebraMap D₀ L₀ d) (ψ_K κ) }
    have hInj_ιD₀ : Function.Injective ι_D₀ := by
      intro d₁ d₂ hd_eq
      have heval : ∀ d : D₀, TensorProduct.lift bilin (ι_D₀ d) = algebraMap D₀ L₀ d := fun d => by
        change TensorProduct.lift bilin (d ⊗ₜ[R₀] (1 : K₀)) = algebraMap D₀ L₀ d
        rw [TensorProduct.lift.tmul]
        change algebraMap D₀ L₀ d * ψ_K 1 = algebraMap D₀ L₀ d
        rw [map_one, mul_one]
      apply IsFractionRing.injective D₀ L₀
      exact (heval d₁).symm.trans ((congrArg (TensorProduct.lift bilin) hd_eq).trans (heval d₂))
    have hclear : ∀ z : TensorProduct R₀ D₀ K₀,
        ∃ (c : D₀) (a : nonZeroDivisors R₀), z * ι_D₀ (algebraMap R₀ D₀ a.1) = ι_D₀ c := by
      intro z
      refine TensorProduct.induction_on
        (motive := fun z =>
          ∃ (c : D₀) (a : nonZeroDivisors R₀), z * ι_D₀ (algebraMap R₀ D₀ a.1) = ι_D₀ c)
        z ?_ ?_ ?_
      · exact ⟨0, 1, by rw [zero_mul, map_zero]⟩
      · intro d κ
        obtain ⟨p, q, hq_mem, hpq⟩ := IsFractionRing.div_surjective (A := R₀) κ
        have hq_K : algebraMap R₀ K₀ q ≠ 0 :=
          (IsLocalization.map_units K₀ ⟨q, hq_mem⟩).ne_zero
        have hκq : algebraMap R₀ K₀ p = κ * algebraMap R₀ K₀ q := (div_eq_iff hq_K).mp hpq
        refine ⟨d * algebraMap R₀ D₀ p, ⟨q, hq_mem⟩, ?_⟩
        have hcomm_q : ι_D₀ (algebraMap R₀ D₀ q) = ι_K₀ (algebraMap R₀ K₀ q) :=
          congrFun (congrArg DFunLike.coe Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap) q
        rw [hcomm_q]
        change (d ⊗ₜ[R₀] κ) * ((1 : D₀) ⊗ₜ[R₀] algebraMap R₀ K₀ q) =
          (d * algebraMap R₀ D₀ p) ⊗ₜ[R₀] (1 : K₀)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← hκq]
        have hp_D : d * algebraMap R₀ D₀ p = p • d := by
          rw [Algebra.smul_def]; exact mul_comm d (algebraMap R₀ D₀ p)
        have hp_K : algebraMap R₀ K₀ p = p • (1 : K₀) := by
          rw [Algebra.smul_def, mul_one]
        rw [hp_D, hp_K, TensorProduct.smul_tmul]
      · rintro x y ⟨c₁, a₁, hx₁⟩ ⟨c₂, a₂, hy₂⟩
        refine ⟨c₁ * algebraMap R₀ D₀ a₂.1 + c₂ * algebraMap R₀ D₀ a₁.1, a₁ * a₂, ?_⟩
        change (x + y) * ι_D₀ (algebraMap R₀ D₀ (a₁.1 * a₂.1)) =
          ι_D₀ (c₁ * algebraMap R₀ D₀ a₂.1 + c₂ * algebraMap R₀ D₀ a₁.1)
        have hmul₁ : x * (ι_D₀ (algebraMap R₀ D₀ a₁.1) * ι_D₀ (algebraMap R₀ D₀ a₂.1)) =
            ι_D₀ c₁ * ι_D₀ (algebraMap R₀ D₀ a₂.1) := by
          rw [← mul_assoc, hx₁]
        have hmul₂ : y * (ι_D₀ (algebraMap R₀ D₀ a₁.1) * ι_D₀ (algebraMap R₀ D₀ a₂.1)) =
            ι_D₀ c₂ * ι_D₀ (algebraMap R₀ D₀ a₁.1) := by
          rw [mul_comm (ι_D₀ (algebraMap R₀ D₀ a₁.1)) (ι_D₀ (algebraMap R₀ D₀ a₂.1)),
            ← mul_assoc, hy₂]
        rw [map_mul (algebraMap R₀ D₀), map_mul ι_D₀, add_mul, hmul₁, hmul₂,
          ← map_mul, ← map_mul, ← map_add]
    refine ⟨hInj_ιD₀, fun u_T => ?_⟩
    obtain ⟨c, a, hca⟩ := hclear (u_T : TensorProduct R₀ D₀ K₀)
    have ha_ne : a.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp a.2
    have hd : algebraMap R₀ D₀ a.1 ≠ 0 :=
      fun h0 => ha_ne (hInj₀ (h0.trans (map_zero _).symm))
    have hc : c ≠ 0 := by
      intro hc0
      rw [hc0, map_zero] at hca
      have h0 : ι_D₀ (algebraMap R₀ D₀ a.1) = 0 := by
        calc ι_D₀ (algebraMap R₀ D₀ a.1)
            = ↑u_T⁻¹ * ((u_T : TensorProduct R₀ D₀ K₀) * ι_D₀ (algebraMap R₀ D₀ a.1)) :=
              (Units.inv_mul_cancel_left u_T (ι_D₀ (algebraMap R₀ D₀ a.1))).symm
          _ = ↑u_T⁻¹ * 0 := congrArg (↑u_T⁻¹ * ·) hca
          _ = 0 := mul_zero _
      exact hd (hInj_ιD₀ (h0.trans (map_zero ι_D₀).symm))
    exact ⟨c, algebraMap R₀ D₀ a.1, hc, hd, hca⟩

  have hOpens_top_app : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (V : Y.Opens),
      V.ι.appTop = Y.presheaf.map (CategoryTheory.homOfLE (le_top : V ≤ ⊤)).op ≫ V.topIso.inv := by
    intro Y V
    exact (congrArg Y.presheaf.map (Subsingleton.elim _ _)).trans
      ((Y.presheaf.map_comp _ _).trans
        (congrArg (Y.presheaf.map (CategoryTheory.homOfLE (le_top : V ≤ ⊤)).op ≫ ·)
          (AlgebraicGeometry.Scheme.Opens.topIso_inv V).symm))

  have hOpens_homOfLE_top : ∀ {Y : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : Y.Opens} (hle : U₁ ≤ U₂),
      U₂.topIso.inv ≫ (Y.homOfLE hle).appTop =
        Y.presheaf.map (CategoryTheory.homOfLE hle).op ≫ U₁.topIso.inv := by
    intro Y U₁ U₂ hle
    rw [AlgebraicGeometry.Scheme.homOfLE_appTop,
      AlgebraicGeometry.Scheme.Opens.topIso_inv,
      AlgebraicGeometry.Scheme.Opens.topIso_inv]
    exact (Y.presheaf.map_comp _ _).symm.trans
      ((congrArg Y.presheaf.map (Subsingleton.elim _ _)).trans (Y.presheaf.map_comp _ _))

  have hAffine_topIso_cancel : ∀ {Y : AlgebraicGeometry.Scheme.{u}} {W : Y.Opens}
      (hW : AlgebraicGeometry.IsAffineOpen W),
      W.topIso.inv ≫ hW.isoSpec.inv.appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W))).hom = 𝟙 _ := by
    intro Y W hW
    have htop : (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W))).inv ≫
        hW.isoSpec.hom.appTop = W.topIso.inv :=
      (congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W))).inv ≫ ·)
        ((congrArg AlgebraicGeometry.Scheme.Hom.appTop hW.isoSpec_hom).trans
          ((AlgebraicGeometry.Scheme.Hom.comp_appTop
            (W : AlgebraicGeometry.Scheme.{u}).toSpecΓ
            (AlgebraicGeometry.Spec.map W.topIso.inv)).trans
            ((congrArg ((AlgebraicGeometry.Spec.map W.topIso.inv).appTop ≫ ·)
              (AlgebraicGeometry.Scheme.toSpecΓ_appTop (W : AlgebraicGeometry.Scheme.{u}))).trans
              (AlgebraicGeometry.Scheme.ΓSpecIso_naturality W.topIso.inv))))).trans
        ((AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W))).inv_hom_id_assoc
          W.topIso.inv)
    have hhom_inv_top : hW.isoSpec.hom.appTop ≫ hW.isoSpec.inv.appTop = 𝟙 _ :=
      (AlgebraicGeometry.Scheme.Hom.comp_appTop hW.isoSpec.inv hW.isoSpec.hom).symm.trans
        ((congrArg AlgebraicGeometry.Scheme.Hom.appTop hW.isoSpec.inv_hom_id).trans
          AlgebraicGeometry.Scheme.Hom.id_appTop)
    exact (congrArg (· ≫ (hW.isoSpec.inv.appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W))).hom)) htop.symm).trans
      ((CategoryTheory.Category.assoc _ hW.isoSpec.hom.appTop _).trans
        ((congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W))).inv ≫ ·)
          ((CategoryTheory.Category.assoc hW.isoSpec.hom.appTop hW.isoSpec.inv.appTop _).symm.trans
            ((congrArg (· ≫ _) hhom_inv_top).trans
              (CategoryTheory.Category.id_comp _)))).trans
          (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W))).inv_hom_id))

  have hOpens_germ_topIso : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (V : Y.Opens)
      (pt : ↥Y) (hpt : pt ∈ V) (r : ↑(Y.presheaf.obj (Opposite.op V))),
      (V.stalkIso ⟨pt, hpt⟩).commRingCatIsoToRingEquiv
        (((V : AlgebraicGeometry.Scheme.{u}).presheaf.germ ⊤ ⟨pt, hpt⟩ trivial).hom
          (V.topIso.inv.hom r)) =
        (Y.presheaf.germ V pt hpt).hom r := by
    intro Y V pt hpt r
    let e_iso := (V.stalkIso ⟨pt, hpt⟩).commRingCatIsoToRingEquiv
    apply e_iso.symm.injective
    rw [e_iso.symm_apply_apply]
    have h1 := AlgebraicGeometry.Scheme.Opens.germ_stalkIso_inv V ⊤ ⟨pt, hpt⟩ trivial
    have h2 := ConcreteCategory.congr_hom h1.symm (V.topIso.inv.hom r)
    refine h2.trans ?_
    change (V.stalkIso ⟨pt, hpt⟩).inv.hom
        ((Y.presheaf.germ (V.ι ''ᵁ ⊤) pt _).hom (V.topIso.inv.hom r)) =
      (V.stalkIso ⟨pt, hpt⟩).inv.hom ((Y.presheaf.germ V pt hpt).hom r)
    congr 1
    rw [AlgebraicGeometry.Scheme.Opens.topIso_inv]
    exact ConcreteCategory.congr_hom (TopCat.Presheaf.germ_res Y.presheaf _ pt _) r

  have hChart_pullback : ∀ (U : C.left.Etale) (W₀ : C.left.Opens)
      (hW₀ : AlgebraicGeometry.IsAffineOpen W₀)
      (V₀ : U.left.Opens) (hV₀ : AlgebraicGeometry.IsAffineOpen V₀) (u₀ : ↥U.left)
      (hu₀ : u₀ ∈ V₀) (e : V₀ ≤ (TopologicalSpace.Opens.map U.hom.base).obj W₀),
      IsDomain ↑(U.left.presheaf.obj (Opposite.op V₀)) →
      Function.Injective (U.hom.appLE W₀ V₀ e).hom →
      let A₀ := ↑(C.left.presheaf.obj (Opposite.op W₀))
      let D := ↑(U.left.presheaf.obj (Opposite.op V₀))
      letI : Algebra A₀ D := (U.hom.appLE W₀ V₀ e).hom.toAlgebra
      letI : Nonempty ↥(W₀ : AlgebraicGeometry.Scheme.{u}) := ⟨⟨U.hom.base u₀, e hu₀⟩⟩
      let T := TensorProduct A₀ D K
      ∃ r_hom : ↑((CategoryTheory.Limits.pullback (V₀.ι ≫ U.hom) η_X).presheaf.obj
            (Opposite.op ⊤)) →+* T,
        Function.Bijective r_hom ∧
        Function.Injective (Algebra.TensorProduct.includeLeftRingHom : D →+* T) ∧
        (∀ r : D,
          r_hom ((CategoryTheory.Limits.pullback.fst (V₀.ι ≫ U.hom) η_X).appTop.hom
            (V₀.topIso.inv.hom r)) =
            (Algebra.TensorProduct.includeLeftRingHom : D →+* T) r) ∧
        (∀ u_T : Units T, ∃ c d : D, c ≠ 0 ∧ d ≠ 0 ∧
          (u_T : T) * (Algebra.TensorProduct.includeLeftRingHom : D →+* T) d =
            (Algebra.TensorProduct.includeLeftRingHom : D →+* T) c) := by
    intro U W₀ hW₀ V₀ hV₀ u₀ hu₀ e hDomD hInjφ
    let U_sch : AlgebraicGeometry.Scheme.{u} := U.left
    let u_hom : U_sch ⟶ C.left := U.hom
    let A₀ := ↑(C.left.presheaf.obj (Opposite.op W₀))
    let D := ↑(U_sch.presheaf.obj (Opposite.op V₀))
    let φ : A₀ →+* D := (u_hom.appLE W₀ V₀ e).hom
    let _ : Algebra A₀ D := φ.toAlgebra
    have hx₀ : u_hom.base u₀ ∈ W₀ := e hu₀
    let _ : Nonempty ↥(W₀ : AlgebraicGeometry.Scheme.{u}) := ⟨⟨u_hom.base u₀, hx₀⟩⟩
    have hη_W₀ : η ∈ W₀ := (genericPoint_specializes (u_hom.base u₀)).mem_open W₀.isOpen hx₀
    have : IsFractionRing A₀ K :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen C.left W₀ hW₀
    let T := TensorProduct A₀ D K
    let ι_D : D →+* T := Algebra.TensorProduct.includeLeftRingHom
    let ι_K : K →+* T := Algebra.TensorProduct.includeRight.toRingHom
    let Z_η := CategoryTheory.Limits.pullback (V₀.ι ≫ u_hom) η_X
    let p₁_T : AlgebraicGeometry.Spec (CommRingCat.of T) ⟶ (V₀ : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_D) ≫ hV₀.isoSpec.inv
    let p₂_T : AlgebraicGeometry.Spec (CommRingCat.of T) ⟶ S_K :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_K)
    have hη_fac : η_X =
        AlgebraicGeometry.Spec.map (C.left.presheaf.germ W₀ η hη_W₀) ≫ hW₀.fromSpec := by
      dsimp [η_X]
      rw [← hW₀.fromSpecStalk_eq_fromSpecStalk hη_W₀,
        AlgebraicGeometry.IsAffineOpen.fromSpecStalk.eq_1 hW₀ hη_W₀]
    have hV_fac : V₀.ι ≫ u_hom =
        hV₀.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (u_hom.appLE W₀ V₀ e) ≫ hW₀.fromSpec := by
      have hiso_fr : hV₀.isoSpec.hom ≫ hV₀.fromSpec = V₀.ι := by
        rw [← hV₀.isoSpec_inv_ι, CategoryTheory.Iso.hom_inv_id_assoc]
      rw [← hiso_fr, CategoryTheory.Category.assoc,
        hW₀.SpecMap_appLE_fromSpec u_hom hV₀ e]
    have hcomm_T : p₁_T ≫ (V₀.ι ≫ u_hom) = p₂_T ≫ η_X := by
      have hlhs : p₁_T ≫ (V₀.ι ≫ u_hom) =
          AlgebraicGeometry.Spec.map (u_hom.appLE W₀ V₀ e ≫ CommRingCat.ofHom ι_D) ≫
            hW₀.fromSpec := by
        dsimp [p₁_T]
        rw [hV_fac, CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      have hrhs : p₂_T ≫ η_X =
          AlgebraicGeometry.Spec.map
            (C.left.presheaf.germ W₀ η hη_W₀ ≫ CommRingCat.ofHom ι_K) ≫ hW₀.fromSpec :=
        (congrArg (p₂_T ≫ ·) hη_fac).trans
          ((CategoryTheory.Category.assoc p₂_T _ hW₀.fromSpec).symm.trans
            (congrArg (· ≫ hW₀.fromSpec)
              (AlgebraicGeometry.Spec.map_comp
                (C.left.presheaf.germ W₀ η hη_W₀) (CommRingCat.ofHom ι_K)).symm))
      have hring : u_hom.appLE W₀ V₀ e ≫ CommRingCat.ofHom ι_D =
          C.left.presheaf.germ W₀ η hη_W₀ ≫ CommRingCat.ofHom ι_K := by
        ext a
        change ι_D (φ a) = ι_K (algebraMap A₀ K a)
        exact congrFun (congrArg DFunLike.coe Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap) a
      exact hlhs.trans
        ((congrArg (fun f => AlgebraicGeometry.Spec.map f ≫ hW₀.fromSpec) hring).trans hrhs.symm)
    let hom_Z : AlgebraicGeometry.Spec (CommRingCat.of T) ⟶ Z_η :=
      CategoryTheory.Limits.pullback.lift p₁_T p₂_T hcomm_T
    have : CategoryTheory.Mono hW₀.fromSpec := AlgebraicGeometry.IsOpenImmersion.mono hW₀.fromSpec
    have hcomm_inv : (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X ≫ hV₀.isoSpec.hom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ D)) =
        CategoryTheory.Limits.pullback.snd (V₀.ι ≫ u_hom) η_X ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ K)) := by
      apply (cancel_mono hW₀.fromSpec).mp
      change ((CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X ≫ hV₀.isoSpec.hom) ≫
          AlgebraicGeometry.Spec.map (u_hom.appLE W₀ V₀ e)) ≫ hW₀.fromSpec =
        (CategoryTheory.Limits.pullback.snd (V₀.ι ≫ u_hom) η_X ≫
          AlgebraicGeometry.Spec.map (C.left.presheaf.germ W₀ η hη_W₀)) ≫ hW₀.fromSpec
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, ← hV_fac, ← hη_fac]
      exact CategoryTheory.Limits.pullback.condition
    let L_inv : Z_η ⟶ CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ D)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ K))) :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X ≫ hV₀.isoSpec.hom)
        (CategoryTheory.Limits.pullback.snd (V₀.ι ≫ u_hom) η_X)
        hcomm_inv
    let inv_Z : Z_η ⟶ AlgebraicGeometry.Spec (CommRingCat.of T) :=
      L_inv ≫ (AlgebraicGeometry.pullbackSpecIso A₀ D K).hom
    have h_hom_L : hom_Z ≫ L_inv = (AlgebraicGeometry.pullbackSpecIso A₀ D K).inv := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc hom_Z L_inv _).trans
          ((congrArg (hom_Z ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            ((CategoryTheory.Category.assoc hom_Z _ hV₀.isoSpec.hom).symm.trans
              ((congrArg (· ≫ hV₀.isoSpec.hom) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                ((CategoryTheory.Category.assoc _ hV₀.isoSpec.inv hV₀.isoSpec.hom).trans
                  ((congrArg (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_D) ≫ ·)
                    hV₀.isoSpec.inv_hom_id).trans
                    ((CategoryTheory.Category.comp_id _).trans
                      (AlgebraicGeometry.pullbackSpecIso_inv_fst A₀ D K).symm))))))
      · exact (CategoryTheory.Category.assoc hom_Z L_inv _).trans
          ((congrArg (hom_Z ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
            ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
              (AlgebraicGeometry.pullbackSpecIso_inv_snd A₀ D K).symm))
    have h_hom_inv : hom_Z ≫ inv_Z = 𝟙 _ :=
      (CategoryTheory.Category.assoc hom_Z L_inv _).symm.trans
        ((congrArg (· ≫ (AlgebraicGeometry.pullbackSpecIso A₀ D K).hom) h_hom_L).trans
          (AlgebraicGeometry.pullbackSpecIso A₀ D K).inv_hom_id)
    have h_inv_hom : inv_Z ≫ hom_Z = 𝟙 _ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · have h_p1 : inv_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_D) =
            CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X ≫ hV₀.isoSpec.hom :=
          (congrArg (inv_Z ≫ ·) (AlgebraicGeometry.pullbackSpecIso_inv_fst A₀ D K).symm).trans
            ((CategoryTheory.Category.assoc L_inv _ _).trans
              ((congrArg (L_inv ≫ ·)
                ((AlgebraicGeometry.pullbackSpecIso A₀ D K).hom_inv_id_assoc _)).trans
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)))
        exact (CategoryTheory.Category.assoc inv_Z hom_Z _).trans
          ((congrArg (inv_Z ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            ((CategoryTheory.Category.assoc inv_Z _ hV₀.isoSpec.inv).symm.trans
              ((congrArg (· ≫ hV₀.isoSpec.inv) h_p1).trans
                ((CategoryTheory.Category.assoc _ hV₀.isoSpec.hom hV₀.isoSpec.inv).trans
                  ((congrArg (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X ≫ ·)
                    hV₀.isoSpec.hom_inv_id).trans
                    ((CategoryTheory.Category.comp_id _).trans
                      (CategoryTheory.Category.id_comp _).symm))))))
      · have h_p2 : inv_Z ≫ p₂_T =
            CategoryTheory.Limits.pullback.snd (V₀.ι ≫ u_hom) η_X :=
          (congrArg (inv_Z ≫ ·) (AlgebraicGeometry.pullbackSpecIso_inv_snd A₀ D K).symm).trans
            ((CategoryTheory.Category.assoc L_inv _ _).trans
              ((congrArg (L_inv ≫ ·)
                ((AlgebraicGeometry.pullbackSpecIso A₀ D K).hom_inv_id_assoc _)).trans
                (CategoryTheory.Limits.pullback.lift_snd _ _ _)))
        exact (CategoryTheory.Category.assoc inv_Z hom_Z _).trans
          ((congrArg (inv_Z ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
            (h_p2.trans (CategoryTheory.Category.id_comp _).symm))
    let f_to_T : Z_η.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of T :=
      hom_Z.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of T)).hom
    let f_from_T : CommRingCat.of T ⟶ Z_η.presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of T)).inv ≫ inv_Z.appTop
    have hf_lr : f_to_T ≫ f_from_T = 𝟙 _ := by
      dsimp [f_to_T, f_from_T]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop, h_inv_hom,
        AlgebraicGeometry.Scheme.Hom.id_appTop]
    have hf_rl : f_from_T ≫ f_to_T = 𝟙 _ := by
      dsimp [f_to_T, f_from_T]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc inv_Z.appTop,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop, h_hom_inv,
        AlgebraicGeometry.Scheme.Hom.id_appTop, CategoryTheory.Category.id_comp,
        CategoryTheory.Iso.inv_hom_id]
    have hbij : Function.Bijective f_to_T.hom :=
      ⟨fun x y hxy => by
          have h1 := ConcreteCategory.congr_hom hf_lr x
          have h2 := ConcreteCategory.congr_hom hf_lr y
          exact h1.symm.trans ((congrArg f_from_T.hom hxy).trans h2),
       fun t => ⟨f_from_T.hom t, ConcreteCategory.congr_hom hf_rl t⟩⟩
    let _ : IsDomain D := hDomD
    rcases hTensor_aux A₀ D K hInjφ with ⟨hInj_ιD, hsurj_T⟩
    have hr_fst : ∀ r : D,
        f_to_T.hom ((CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop.hom
          (V₀.topIso.inv.hom r)) = ι_D r := by
      intro r
      have hfst_app : (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop ≫
            hom_Z.appTop =
          hV₀.isoSpec.inv.appTop ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_D)).appTop :=
        (AlgebraicGeometry.Scheme.Hom.comp_appTop hom_Z
          (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X)).symm.trans
          ((congrArg AlgebraicGeometry.Scheme.Hom.appTop
            (CategoryTheory.Limits.pullback.lift_fst p₁_T p₂_T hcomm_T)).trans
            (AlgebraicGeometry.Scheme.Hom.comp_appTop
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_D)) hV₀.isoSpec.inv))
      have step1 : (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop ≫ f_to_T =
          (hV₀.isoSpec.inv.appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso
              (U_sch.presheaf.obj (Opposite.op V₀))).hom) ≫ CommRingCat.ofHom ι_D :=
        (CategoryTheory.Category.assoc _ hom_Z.appTop _).symm.trans
          ((congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of T)).hom)
            hfst_app).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (hV₀.isoSpec.inv.appTop ≫ ·)
                (AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom ι_D))).trans
                (CategoryTheory.Category.assoc _ _ _).symm)))
      have h1 : V₀.topIso.inv ≫
            ((CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop ≫ f_to_T) =
          CommRingCat.ofHom ι_D :=
        (congrArg (V₀.topIso.inv ≫ ·) step1).trans
          ((CategoryTheory.Category.assoc V₀.topIso.inv _ (CommRingCat.ofHom ι_D)).symm.trans
            ((congrArg (· ≫ CommRingCat.ofHom ι_D) (hAffine_topIso_cancel hV₀)).trans
              (CategoryTheory.Category.id_comp _)))
      exact ConcreteCategory.congr_hom h1 r
    exact ⟨f_to_T.hom, hbij, hInj_ιD, hr_fst, hsurj_T⟩

  
  have hInj_ι : ∀ U : C.left.Etale, Function.Injective (ι_pre.app (Opposite.op U)).hom := by
    intro U u₁ u₂ hu_eq
    apply Additive.toMul.injective
    apply Units.ext
    have htop_eq : (CategoryTheory.Limits.pullback.fst U.hom η_X).appTop.hom
          (toGmUnit U u₁).val =
        (CategoryTheory.Limits.pullback.fst U.hom η_X).appTop.hom
          (toGmUnit U u₂).val :=
      congrArg (fun x => (toKUnit U x).val) hu_eq
    apply TopCat.Presheaf.section_ext U.left.sheaf ⊤
    intro u₀ hu₀_top
    obtain ⟨W₀, hW₀, V₀, hV₀, hu₀, e, hDomD, hInjφ, _⟩ := hChart U u₀
    obtain ⟨r_hom, _, hInj_ιD, hr_fst, _⟩ :=
      hChart_pullback U W₀ hW₀ V₀ hV₀ u₀ hu₀ e hDomD hInjφ
    let U_sch : AlgebraicGeometry.Scheme.{u} := U.left
    let u_hom : U_sch ⟶ C.left := U.hom
    let m_V₀ : CategoryTheory.Limits.pullback (V₀.ι ≫ u_hom) η_X ⟶
        CategoryTheory.Limits.pullback u_hom η_X :=
      CategoryTheory.Limits.pullback.map (V₀.ι ≫ u_hom) η_X u_hom η_X
        V₀.ι (𝟙 S_K) (𝟙 C.left) (CategoryTheory.Category.comp_id _) (by simp)
    have hm_fst : m_V₀ ≫ CategoryTheory.Limits.pullback.fst u_hom η_X =
        CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X ≫ V₀.ι :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hres_eq : ∀ s : ↑(U_sch.presheaf.obj (Opposite.op ⊤)),
        r_hom (m_V₀.appTop.hom ((CategoryTheory.Limits.pullback.fst u_hom η_X).appTop.hom s)) =
          (letI : Algebra ↑(C.left.presheaf.obj (Opposite.op W₀))
              ↑(U_sch.presheaf.obj (Opposite.op V₀)) := (u_hom.appLE W₀ V₀ e).hom.toAlgebra
           letI : Nonempty ↥(W₀ : AlgebraicGeometry.Scheme.{u}) := ⟨⟨u_hom.base u₀, e hu₀⟩⟩
           (Algebra.TensorProduct.includeLeftRingHom :
              ↑(U_sch.presheaf.obj (Opposite.op V₀)) →+* _)
              ((U_sch.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op).hom s)) := by
      intro s
      have h1 : m_V₀.appTop.hom ((CategoryTheory.Limits.pullback.fst u_hom η_X).appTop.hom s) =
          (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop.hom
            (V₀.ι.appTop.hom s) := by
        have hm_app : (CategoryTheory.Limits.pullback.fst u_hom η_X).appTop ≫ m_V₀.appTop =
            V₀.ι.appTop ≫ (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop :=
          (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _).symm.trans
            ((congrArg AlgebraicGeometry.Scheme.Hom.appTop hm_fst).trans
              (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _))
        exact ConcreteCategory.congr_hom hm_app s
      have h2 : V₀.ι.appTop.hom s =
          V₀.topIso.inv.hom
            ((U_sch.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op).hom s) :=
        ConcreteCategory.congr_hom (hOpens_top_app V₀) s
      exact (congrArg r_hom h1).trans
        ((congrArg (fun z => r_hom
          ((CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop.hom z)) h2).trans
          (hr_fst _))
    have hV₀_eq : (U_sch.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op).hom
          (toGmUnit U u₁).val =
        (U_sch.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op).hom
          (toGmUnit U u₂).val := by
      apply hInj_ιD
      have h_eq₁ := hres_eq (toGmUnit U u₁).val
      have h_eq₂ := hres_eq (toGmUnit U u₂).val
      exact h_eq₁.symm.trans ((congrArg (fun z => r_hom (m_V₀.appTop.hom z)) htop_eq).trans h_eq₂)
    have hgerm : ∀ s : ↑(U_sch.presheaf.obj (Opposite.op ⊤)),
        (U_sch.presheaf.germ ⊤ u₀ hu₀_top).hom s =
          (U_sch.presheaf.germ V₀ u₀ hu₀).hom
            ((U_sch.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op).hom s) :=
      fun s => (ConcreteCategory.congr_hom
        (TopCat.Presheaf.germ_res U_sch.presheaf (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)) u₀ hu₀)
        s).symm
    exact (hgerm (toGmUnit U u₁).val).trans
      ((congrArg (U_sch.presheaf.germ V₀ u₀ hu₀).hom hV₀_eq).trans
        (hgerm (toGmUnit U u₂).val).symm)

  
  have hDivLoc : ∀ (U : C.left.Etale)
      (s : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U)))
      (u₀ : ↥U.left),
      ∃ V : U.left.Opens, u₀ ∈ V ∧
        { y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) } |
          y.1 ∈ V ∧ div_val U s y ≠ 0 }.Finite := by
    intro U s u₀
    obtain ⟨W₀, hW₀, V₀, hV₀, hu₀, e, hDomD, hInjφ, _, _, _, hFinZero⟩ := hChart U u₀
    refine ⟨V₀, hu₀, ?_⟩
    obtain ⟨r_hom, hbij_r, _, hr_fst, hsurj_T⟩ :=
      hChart_pullback U W₀ hW₀ V₀ hV₀ u₀ hu₀ e hDomD hInjφ
    let U_sch : AlgebraicGeometry.Scheme.{u} := U.left
    let D := ↑(U_sch.presheaf.obj (Opposite.op V₀))
    let W_V₀ : C.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (V₀.ι ≫ U.hom)
      (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)
    let j_V₀ : W_V₀ ⟶ U := CategoryTheory.MorphismProperty.Over.homMk V₀.ι rfl
    let s₀ := ((weilEtaleKPresheaf C.left).map j_V₀.op).hom s
    let e_T := RingEquiv.ofBijective r_hom hbij_r
    let u_T : Units _ := Units.map e_T.toRingHom.toMonoidHom (toKUnit W_V₀ s₀)
    obtain ⟨c, d, hc, hd, hcd_T⟩ := hsurj_T u_T
    let R_Z := ↑((CategoryTheory.Limits.pullback (V₀.ι ≫ U.hom) η_X).presheaf.obj (Opposite.op ⊤))
    let z_s₀ : R_Z := (toKUnit W_V₀ s₀).val
    let fst_Z : ↑((V₀ : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) →+* R_Z :=
      (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ U.hom) η_X).appTop.hom
    have hcd_Z : z_s₀ * fst_Z (V₀.topIso.inv.hom d) = fst_Z (V₀.topIso.inv.hom c) := by
      apply hbij_r.1
      exact (r_hom.map_mul z_s₀ _).trans
        ((congrArg (r_hom z_s₀ * ·) (hr_fst d)).trans (hcd_T.trans (hr_fst c).symm))
    refine (hFinZero (c * d) (mul_ne_zero hc hd)).subset ?_
    rintro y ⟨hy, hne⟩
    refine ⟨hy, ?_⟩
    let y' : { y' : ↥W_V₀.left // IsClosed ({W_V₀.hom.base y'} : Set ↥C.left) } :=
      ⟨⟨y.1, hy⟩, y.2⟩
    have hne' : div_val W_V₀ s₀ y' ≠ 0 := by
      have hnat := hDivNat j_V₀ s y'
      rwa [hnat]
    let Ry' := ↑(W_V₀.left.presheaf.stalk y'.1)
    let _ : IsDomain Ry' := (hDVR_et W_V₀ y').choose
    let _ : IsDiscreteValuationRing Ry' := (hDVR_et W_V₀ y').choose_spec
    let _ : IsDomain ↑(U_sch.presheaf.stalk y.1) := (hDVR_et U y).choose
    have : IsLocalization.AtPrime ↑(U_sch.presheaf.stalk (⟨y.1, hy⟩ : ↥V₀).1)
        (hV₀.primeIdealOf ⟨y.1, hy⟩).asIdeal :=
      hV₀.isLocalization_stalk ⟨y.1, hy⟩
    have hle_nzd : (hV₀.primeIdealOf ⟨y.1, hy⟩).asIdeal.primeCompl ≤ nonZeroDivisors D :=
      le_nonZeroDivisors_of_noZeroDivisors
        (fun h0 => h0 (hV₀.primeIdealOf ⟨y.1, hy⟩).asIdeal.zero_mem)
    have hInj_germ : Function.Injective (U_sch.presheaf.germ V₀ y.1 hy).hom :=
      IsLocalization.injective ↑(U_sch.presheaf.stalk (⟨y.1, hy⟩ : ↥V₀).1) hle_nzd
    let e_st : Ry' ≃+* ↑(U_sch.presheaf.stalk y.1) :=
      (V₀.stalkIso ⟨y.1, hy⟩).commRingCatIsoToRingEquiv
    have hgerm_rel : ∀ r : D,
        e_st ((W_V₀.left.presheaf.germ ⊤ y'.1 trivial).hom (V₀.topIso.inv.hom r)) =
          (U_sch.presheaf.germ V₀ y.1 hy).hom r :=
      fun r => hOpens_germ_topIso V₀ y.1 hy r
    let c' : Ry' := (W_V₀.left.presheaf.germ ⊤ y'.1 trivial).hom (V₀.topIso.inv.hom c)
    let d' : Ry' := (W_V₀.left.presheaf.germ ⊤ y'.1 trivial).hom (V₀.topIso.inv.hom d)
    have hc'_ne : c' ≠ 0 := fun h0 => hc (hInj_germ
      (((hgerm_rel c).symm.trans ((congrArg e_st h0).trans (map_zero e_st))).trans
        (map_zero (U_sch.presheaf.germ V₀ y.1 hy).hom).symm))
    have hd'_ne : d' ≠ 0 := fun h0 => hd (hInj_germ
      (((hgerm_rel d).symm.trans ((congrArg e_st h0).trans (map_zero e_st))).trans
        (map_zero (U_sch.presheaf.germ V₀ y.1 hy).hom).symm))
    have hev_cd : (Units.map (ev_Uy W_V₀ y').toMonoidHom (toKUnit W_V₀ s₀)).val *
          algebraMap Ry' (FractionRing Ry') d' =
        algebraMap Ry' (FractionRing Ry') c' := by
      have h := congrArg (ev_Uy W_V₀ y') hcd_Z
      exact ((congrArg ((ev_Uy W_V₀ y') z_s₀ * ·) (hev_fst W_V₀ y' (V₀.topIso.inv.hom d))).symm.trans
        (((ev_Uy W_V₀ y').map_mul z_s₀ _).symm.trans
          (h.trans (hev_fst W_V₀ y' (V₀.topIso.inv.hom c)))))
    have hmem' : c' * d' ∈ IsLocalRing.maximalIdeal Ry' :=
      hordDVR_nonzero_mem Ry' _ c' d' hc'_ne hd'_ne hev_cd hne'
    have hnu' : ¬ IsUnit (c' * d') :=
      fun hu => IsLocalRing.notMem_maximalIdeal.mpr hu hmem'
    have hnu : ¬ IsUnit ((U_sch.presheaf.germ V₀ y.1 hy).hom (c * d)) := by
      intro hu_cd
      apply hnu'
      have heq : e_st (c' * d') = (U_sch.presheaf.germ V₀ y.1 hy).hom (c * d) :=
        (e_st.map_mul c' d').trans
          ((congrArg₂ (· * ·) (hgerm_rel c) (hgerm_rel d)).trans
            ((U_sch.presheaf.germ V₀ y.1 hy).hom.map_mul c d).symm)
      have hu_map : IsUnit (e_st.symm ((U_sch.presheaf.germ V₀ y.1 hy).hom (c * d))) :=
        e_st.symm.toRingHom.isUnit_map hu_cd
      have hsymm_eq : e_st.symm ((U_sch.presheaf.germ V₀ y.1 hy).hom (c * d)) = c' * d' :=
        (congrArg e_st.symm heq.symm).trans (e_st.symm_apply_apply (c' * d'))
      exact hsymm_eq ▸ hu_map
    exact Classical.byContradiction fun hnot => hnu (IsLocalRing.notMem_maximalIdeal.mp hnot)

  
  let q_TX := CategoryTheory.Limits.pullback.snd T_X.hom η_X
  have : CategoryTheory.IsIso T_X.hom := by
    change CategoryTheory.IsIso (𝟙 C.left); infer_instance
  have : CategoryTheory.IsIso q_TX :=
    CategoryTheory.Limits.pullback_snd_iso_of_left_iso T_X.hom η_X
  let iso_qTX := CategoryTheory.asIso q_TX
  let f_TX_to_K : (CategoryTheory.Limits.pullback T_X.hom η_X).presheaf.obj (Opposite.op ⊤) ⟶
      C.left.presheaf.stalk η :=
    iso_qTX.inv.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (C.left.presheaf.stalk η)).hom
  let f_K_to_TX : C.left.presheaf.stalk η ⟶
      (CategoryTheory.Limits.pullback T_X.hom η_X).presheaf.obj (Opposite.op ⊤) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (C.left.presheaf.stalk η)).inv ≫ iso_qTX.hom.appTop
  have hf_TX_lr : f_TX_to_K ≫ f_K_to_TX = 𝟙 _ := by
    dsimp [f_TX_to_K, f_K_to_TX]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc,
      ← AlgebraicGeometry.Scheme.Hom.comp_appTop, iso_qTX.hom_inv_id,
      AlgebraicGeometry.Scheme.Hom.id_appTop]
  have hf_TX_rl : f_K_to_TX ≫ f_TX_to_K = 𝟙 _ := by
    dsimp [f_TX_to_K, f_K_to_TX]
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc iso_qTX.hom.appTop,
      ← AlgebraicGeometry.Scheme.Hom.comp_appTop, iso_qTX.inv_hom_id,
      AlgebraicGeometry.Scheme.Hom.id_appTop, CategoryTheory.Category.id_comp,
      CategoryTheory.Iso.inv_hom_id]
  let ψ_TX : ↑((CategoryTheory.Limits.pullback T_X.hom η_X).presheaf.obj (Opposite.op ⊤)) ≃+* K :=
    RingEquiv.ofBijective f_TX_to_K.hom
      ⟨fun x y hxy => by
          have h1 := ConcreteCategory.congr_hom hf_TX_lr x
          have h2 := ConcreteCategory.congr_hom hf_TX_lr y
          exact h1.symm.trans ((congrArg f_K_to_TX.hom hxy).trans h2),
       fun t => ⟨f_K_to_TX.hom t, ConcreteCategory.congr_hom hf_TX_rl t⟩⟩

  have hev_TX : ∀ (x : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) })
      (z : ↑((CategoryTheory.Limits.pullback T_X.hom η_X).presheaf.obj (Opposite.op ⊤))),
      ev_Uy T_X ⟨x.1, x.2⟩ z = φ_tilde T_X ⟨x.1, x.2⟩ (ψ_TX z) := by
    intro x z
    have hγ_q : γ_Uy T_X ⟨x.1, x.2⟩ ≫ q_TX =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde T_X ⟨x.1, x.2⟩)) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hγ_inv : γ_Uy T_X ⟨x.1, x.2⟩ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde T_X ⟨x.1, x.2⟩)) ≫ iso_qTX.inv := by
      rw [← hγ_q]
      change γ_Uy T_X ⟨x.1, x.2⟩ = (γ_Uy T_X ⟨x.1, x.2⟩ ≫ iso_qTX.hom) ≫ iso_qTX.inv
      rw [CategoryTheory.Category.assoc, iso_qTX.hom_inv_id, CategoryTheory.Category.comp_id]
    have happ : (γ_Uy T_X ⟨x.1, x.2⟩).appTop ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso _).hom =
        f_TX_to_K ≫ CommRingCat.ofHom (φ_tilde T_X ⟨x.1, x.2⟩) := by
      rw [hγ_inv, AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality]
      rfl
    exact ConcreteCategory.congr_hom happ z

  have hφ_TX_alg : ∀ (x : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) })
      (r : ↑(C.left.presheaf.stalk x.1)),
      φ_tilde T_X ⟨x.1, x.2⟩ (algebraMap ↑(C.left.presheaf.stalk x.1) K r) =
        algebraMap ↑(C.left.presheaf.stalk x.1) (FractionRing ↑(C.left.presheaf.stalk x.1)) r := by
    intro x r
    have h := hφ_tilde_alg T_X ⟨x.1, x.2⟩ r
    change φ_tilde T_X ⟨x.1, x.2⟩ (algebraMap _ K r) = _ at h
    rw [h]
    have hid : T_X.hom.stalkMap x.1 = 𝟙 (C.left.presheaf.stalk x.1) :=
      AlgebraicGeometry.Scheme.Hom.stalkMap_id C.left x.1
    rw [hid]
    rfl

  have hTX_prin : ∀ s : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op T_X)),
      ∃ f : Units K,
        ∀ x : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) },
          let Rx := ↑(C.left.presheaf.stalk x.1)
          let mx := IsLocalRing.maximalIdeal Rx
          ∃ (a b : Rx) (na nb : ℕ),
            a ≠ 0 ∧ b ≠ 0 ∧
            algebraMap Rx K a = (f : K) * algebraMap Rx K b ∧
            Ideal.span ({a} : Set Rx) = mx ^ na ∧
            Ideal.span ({b} : Set Rx) = mx ^ nb ∧
            div_val T_X s ⟨x.1, x.2⟩ = (na : ℤ) - (nb : ℤ) := by
    intro s
    let f : Units K := Units.map ψ_TX.toRingHom.toMonoidHom (toKUnit T_X s)
    refine ⟨f, fun x => ?_⟩
    let Rx := ↑(C.left.presheaf.stalk x.1)
    let _ : IsDomain Rx := hDom_base x
    let _ : IsDiscreteValuationRing Rx := (hDVR_et T_X ⟨x.1, x.2⟩).choose_spec
    obtain ⟨a, b, hb_mem, hab_div⟩ := IsFractionRing.div_surjective (A := Rx) (f : K)
    have hb : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_mem
    have hb_map : algebraMap Rx K b ≠ 0 :=
      fun h0 => hb (IsFractionRing.injective Rx K (h0.trans (map_zero _).symm))
    have hab : algebraMap Rx K a = (f : K) * algebraMap Rx K b :=
      (div_eq_iff hb_map).mp hab_div
    have ha : a ≠ 0 := fun ha0 => by
      rw [ha0, map_zero] at hab; exact mul_ne_zero f.ne_zero hb_map hab.symm
    obtain ⟨ϖ_x, hϖ_x⟩ := IsDiscreteValuationRing.exists_irreducible Rx
    obtain ⟨na, hna_a⟩ := IsDiscreteValuationRing.associated_pow_irreducible ha hϖ_x
    obtain ⟨nb, hnb_b⟩ := IsDiscreteValuationRing.associated_pow_irreducible hb hϖ_x
    have hna : Ideal.span ({a} : Set Rx) = IsLocalRing.maximalIdeal Rx ^ na := by
      rw [hϖ_x.maximalIdeal_eq, Ideal.span_singleton_pow]
      exact Ideal.span_singleton_eq_span_singleton.mpr hna_a
    have hnb : Ideal.span ({b} : Set Rx) = IsLocalRing.maximalIdeal Rx ^ nb := by
      rw [hϖ_x.maximalIdeal_eq, Ideal.span_singleton_pow]
      exact Ideal.span_singleton_eq_span_singleton.mpr hnb_b
    refine ⟨a, b, na, nb, ha, hb, hab, hna, hnb, ?_⟩
    let u_ev : Units (FractionRing Rx) :=
      Units.map (ev_Uy T_X ⟨x.1, x.2⟩).toMonoidHom (toKUnit T_X s)
    have hab_frac : algebraMap Rx (FractionRing Rx) a =
        u_ev.val * algebraMap Rx (FractionRing Rx) b := by
      have h := congrArg (φ_tilde T_X ⟨x.1, x.2⟩) hab
      have h_lhs : φ_tilde T_X ⟨x.1, x.2⟩ (algebraMap Rx K a) =
          algebraMap Rx (FractionRing Rx) a := hφ_TX_alg x a
      have h_rhs : φ_tilde T_X ⟨x.1, x.2⟩ ((f : K) * algebraMap Rx K b) =
          u_ev.val * algebraMap Rx (FractionRing Rx) b :=
        ((φ_tilde T_X ⟨x.1, x.2⟩).map_mul (f : K) (algebraMap Rx K b)).trans
          (congrArg₂ (· * ·) (hev_TX x (toKUnit T_X s).val).symm (hφ_TX_alg x b))
      exact h_lhs.symm.trans (h.trans h_rhs)
    exact hordDVR Rx u_ev a b na nb ha hb hab_frac hna hnb

  
  have hmem_div : ∀ (U : C.left.Etale)
      (s : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U))),
      div_val U s ∈ Set.range (valDiv U) := by
    intro U s
    rw [hValRangeLoc U]
    exact hDivLoc U s
  let val_pre_fun : ∀ U : C.left.Etale,
      ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U)) → ↥(Div_sh.obj.obj (Opposite.op U)) :=
    fun U s => (hmem_div U s).choose
  have hval_pre_spec : ∀ (U : C.left.Etale)
      (s : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U))),
      valDiv U (val_pre_fun U s) = div_val U s :=
    fun U s => (hmem_div U s).choose_spec
  let val_pre : weilEtaleKPresheaf C.left ⟶ Div_sh.obj :=
    { app := fun U => AddCommGrpCat.ofHom
        { toFun := val_pre_fun U.unop
          map_zero' := hValInj U.unop
            ((hval_pre_spec U.unop 0).trans
              ((div_val U.unop).map_zero.trans (valDiv U.unop).map_zero.symm))
          map_add' := fun s₁ s₂ => hValInj U.unop
            ((hval_pre_spec U.unop (s₁ + s₂)).trans
              (((div_val U.unop).map_add s₁ s₂).trans
                ((congrArg₂ (· + ·) (hval_pre_spec U.unop s₁).symm
                  (hval_pre_spec U.unop s₂).symm).trans
                  ((valDiv U.unop).map_add _ _).symm))) }
      naturality := fun U₂ U₁ f => by
        apply AddCommGrpCat.ext
        intro s
        apply hValInj U₁.unop
        ext y₁
        change valDiv U₁.unop
            (val_pre_fun U₁.unop (((weilEtaleKPresheaf C.left).map f.unop.op).hom s)) y₁ =
          valDiv U₁.unop
            ((Div_sh.obj.map f.unop.op).hom (val_pre_fun U₂.unop s)) y₁
        rw [hval_pre_spec, hDivNat f.unop s y₁,
          hValNat f.unop (val_pre_fun U₂.unop s) y₁, hval_pre_spec] }
  have hι_val_zero : ι_pre ≫ val_pre = 0 := by
    ext U : 2
    apply AddCommGrpCat.ext
    intro u
    apply hValInj U.unop
    change valDiv U.unop (val_pre_fun U.unop ((ι_pre.app (Opposite.op U.unop)).hom u)) =
      valDiv U.unop 0
    rw [hval_pre_spec, hDivZero U.unop u, map_zero]

  let sh := CategoryTheory.presheafToSheaf C.left.smallEtaleTopology AddCommGrpCat.{u}
  let shAdj := CategoryTheory.sheafificationAdjunction C.left.smallEtaleTopology AddCommGrpCat.{u}
  let ι_gm : weilEtaleGmSheaf C.left ⟶ weilEtaleKSheaf C.left := sh.map ι_pre
  have : ∀ U : Opposite C.left.Etale, CategoryTheory.Mono (ι_pre.app U) := fun U => by
    rw [AddCommGrpCat.mono_iff_injective]
    exact hInj_ι U.unop
  have : CategoryTheory.Mono ι_pre :=
    (CategoryTheory.NatTrans.mono_iff_mono_app ι_pre).mpr inferInstance
  have : CategoryTheory.Mono ι_gm := CategoryTheory.Functor.map_mono sh ι_pre

  let Q_div : CategoryTheory.Sheaf C.left.smallEtaleTopology AddCommGrpCat.{u} :=
    CategoryTheory.Limits.cokernel ι_gm
  let π_div : weilEtaleKSheaf C.left ⟶ Q_div := CategoryTheory.Limits.cokernel.π ι_gm
  have h0_div : ι_gm ≫ π_div = 0 := CategoryTheory.Limits.cokernel.condition ι_gm
  have hSE_div : (CategoryTheory.ShortComplex.mk ι_gm π_div h0_div).ShortExact :=
    { exact := CategoryTheory.ShortComplex.exact_cokernel ι_gm }

  let val_sh : weilEtaleKSheaf C.left ⟶ Div_sh :=
    (shAdj.homEquiv (weilEtaleKPresheaf C.left) Div_sh).symm val_pre
  have hunit_val : shAdj.unit.app (weilEtaleKPresheaf C.left) ≫ val_sh.hom = val_pre := by
    have h1 := (shAdj.homEquiv (weilEtaleKPresheaf C.left) Div_sh).apply_symm_apply val_pre
    have h2 := CategoryTheory.Adjunction.homEquiv_unit shAdj
      (weilEtaleKPresheaf C.left) Div_sh val_sh
    exact h2.symm.trans h1
  have h0_val_sh : ι_gm ≫ val_sh = 0 := by
    apply (shAdj.homEquiv (weilEtaleGmPresheaf C.left) Div_sh).injective
    have h1 := CategoryTheory.Adjunction.homEquiv_unit shAdj
      (weilEtaleGmPresheaf C.left) Div_sh (ι_gm ≫ val_sh)
    have h2 := CategoryTheory.Adjunction.homEquiv_unit shAdj
      (weilEtaleGmPresheaf C.left) Div_sh 0
    have hmid : shAdj.unit.app (weilEtaleGmPresheaf C.left) ≫ (sh.map ι_pre).hom ≫ val_sh.hom =
        shAdj.unit.app (weilEtaleGmPresheaf C.left) ≫ 0 :=
      (CategoryTheory.Category.assoc _ (sh.map ι_pre).hom val_sh.hom).symm.trans
        ((congrArg (· ≫ val_sh.hom) (shAdj.unit.naturality ι_pre).symm).trans
          ((CategoryTheory.Category.assoc ι_pre _ val_sh.hom).trans
            ((congrArg (ι_pre ≫ ·) hunit_val).trans
              (hι_val_zero.trans CategoryTheory.Limits.comp_zero.symm))))
    exact (h1.trans hmid).trans h2.symm
  let val_bar : Q_div ⟶ Div_sh := CategoryTheory.Limits.cokernel.desc ι_gm val_sh h0_val_sh
  have hπ_val : π_div ≫ val_bar = val_sh :=
    CategoryTheory.Limits.cokernel.π_desc ι_gm val_sh h0_val_sh

  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Pℤ := (CategoryTheory.Functor.const (Opposite C.left.Etale)).obj Aℤ
  let Fℤ_C := (CategoryTheory.constantSheaf C.left.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let u₁_C := fun (V : C.left.Etale) =>
    ((shAdj.unit.app Pℤ).app (Opposite.op V)).hom (ULift.up (1 : ℤ))
  let ev_H0 : Q_div.H 0 →+ ↥(Div_sh.obj.obj (Opposite.op T_X)) :=
    { toFun := fun q =>
        (val_bar.hom.app (Opposite.op T_X)).hom
          (((CategoryTheory.Abelian.Ext.addEquiv₀ q).hom.app (Opposite.op T_X)).hom (u₁_C T_X))
      map_zero' := by
        rw [map_zero]
        change (val_bar.hom.app (Opposite.op T_X)).hom 0 = 0
        exact map_zero _
      map_add' := fun q₁ q₂ => by
        rw [map_add]
        change (val_bar.hom.app (Opposite.op T_X)).hom
          ((((CategoryTheory.Abelian.Ext.addEquiv₀ q₁).hom.app (Opposite.op T_X)).hom (u₁_C T_X)) +
           (((CategoryTheory.Abelian.Ext.addEquiv₀ q₂).hom.app (Opposite.op T_X)).hom (u₁_C T_X))) = _
        exact map_add _ _ _ }

  let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
  have hRange_TX : Set.range (valDiv T_X) = { D : Pt → ℤ | { x | D x ≠ 0 }.Finite } :=
    hValRangeComp T_X (inferInstance : CompactSpace ↥C.left)
  have hd_fin : ∀ d : ↥(Div_sh.obj.obj (Opposite.op T_X)),
      { x : Pt | valDiv T_X d x ≠ 0 }.Finite := by
    intro d
    have hmem : valDiv T_X d ∈ Set.range (valDiv T_X) := ⟨d, rfl⟩
    rwa [hRange_TX] at hmem
  let toFinsupp : ↥(Div_sh.obj.obj (Opposite.op T_X)) →+ (Pt →₀ ℤ) :=
    { toFun := fun d => Finsupp.ofSupportFinite (valDiv T_X d) (hd_fin d)
      map_zero' := Finsupp.ext fun x => by
        change valDiv T_X 0 x = 0
        rw [map_zero]; rfl
      map_add' := fun d₁ d₂ => Finsupp.ext fun x => by
        change valDiv T_X (d₁ + d₂) x = valDiv T_X d₁ x + valDiv T_X d₂ x
        rw [map_add]; rfl }
  let div_H0 : Q_div.H 0 →+ (Pt →₀ ℤ) := toFinsupp.comp ev_H0

  refine ⟨Q_div, ι_gm, π_div, h0_div, div_H0, hSE_div, ?_, ?_⟩

  
  · intro k₀
    let fk : Fℤ_C ⟶ weilEtaleKSheaf C.left := CategoryTheory.Abelian.Ext.addEquiv₀ k₀
    have hcomp_eq : CategoryTheory.Abelian.Ext.addEquiv₀
        (k₀.comp (CategoryTheory.Abelian.Ext.mk₀ π_div) (Nat.add_zero 0)) = fk ≫ π_div := by
      apply (CategoryTheory.Abelian.Ext.mk₀_bijective Fℤ_C Q_div).1
      rw [CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]
    let K_sh₀ : CategoryTheory.Sheaf C.left.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilEtaleKPresheaf C.left, hK_sh⟩
    let e_K : K_sh₀ ≅ weilEtaleKSheaf C.left := CategoryTheory.sheafificationIso K_sh₀
    let s₀ : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op T_X)) :=
      (e_K.inv.hom.app (Opposite.op T_X)).hom ((fk.hom.app (Opposite.op T_X)).hom (u₁_C T_X))
    have hs₀_unit : ((shAdj.unit.app (weilEtaleKPresheaf C.left)).app (Opposite.op T_X)).hom s₀ =
        (fk.hom.app (Opposite.op T_X)).hom (u₁_C T_X) := by
      have hinv_hom : e_K.inv ≫ e_K.hom = 𝟙 (weilEtaleKSheaf C.left) := e_K.inv_hom_id
      exact congrArg (fun φ : weilEtaleKSheaf C.left ⟶ weilEtaleKSheaf C.left =>
        (φ.hom.app (Opposite.op T_X)).hom ((fk.hom.app (Opposite.op T_X)).hom (u₁_C T_X))) hinv_hom
    have hev_k₀ : ev_H0 (k₀.comp (CategoryTheory.Abelian.Ext.mk₀ π_div) (Nat.add_zero 0)) =
