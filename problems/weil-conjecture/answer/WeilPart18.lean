  have hPi_lift_π : ∀ {𝒬 : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}}
      (p : ∀ b : Fin r, 𝒬 ⟶ ℱ b) (b : Fin r),
