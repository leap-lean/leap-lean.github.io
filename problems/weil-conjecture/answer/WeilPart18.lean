    exact ⟨(adj_comp.leftAdjointUniq CategoryTheory.Adjunction.id).app A⟩
  have hStalkZeroAtFilter : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (ℱ : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
