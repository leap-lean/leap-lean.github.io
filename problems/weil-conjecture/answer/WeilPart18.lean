  haveI : L_π'.Faithful :=
    { map_injective := fun {𝒢₁ 𝒢₂} α β hαβ => by
        apply CategoryTheory.Sheaf.hom_ext
        ext V_op x
        let V := V_op.unop
        let V''_left := CategoryTheory.Limits.pullback V.hom π'
        let p_V : V''_left ⟶ V.left := CategoryTheory.Limits.pullback.fst V.hom π'
        let q_V : V''_left ⟶ U'' := CategoryTheory.Limits.pullback.snd V.hom π'
        have hEt_qV : AlgebraicGeometry.Etale q_V :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback V.hom π') V.prop
        have hSurj_pV : AlgebraicGeometry.Surjective p_V := by
          haveI := hSurj_π'
          dsimp [p_V]
          infer_instance
        let V''_et : U''.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ q_V hEt_qV
        let p_et_V : F_π'.obj V''_et ⟶ V :=
          CategoryTheory.MorphismProperty.Over.homMk p_V
            CategoryTheory.Limits.pullback.condition
        have h_inj : ∀ a b : ↥(𝒢₂.obj.obj (Opposite.op V)),
            𝒢₂.obj.map p_et_V.op a = 𝒢₂.obj.map p_et_V.op b → a = b := by
          intro a b hab
          obtain ⟨_, _, huniq⟩ := h_singleton_descent 𝒢₂ p_et_V hSurj_pV
            (𝒢₂.obj.map p_et_V.op a)
            (fun p₁ p₂ hp => by
              have hm : 𝒢₂.obj.map p_et_V.op ≫ 𝒢₂.obj.map p₁.op =
                  𝒢₂.obj.map p_et_V.op ≫ 𝒢₂.obj.map p₂.op := by
                rw [← 𝒢₂.obj.map_comp, ← 𝒢₂.obj.map_comp, ← op_comp, ← op_comp, hp]
              exact congrArg (fun φ => φ a) hm)
          exact (huniq a rfl).trans (huniq b hab.symm).symm
        apply h_inj
        have hnat_α := ConcreteCategory.congr_hom (α.hom.naturality p_et_V.op) x
        have hnat_β := ConcreteCategory.congr_hom (β.hom.naturality p_et_V.op) x
        have h_eq_V'' : (L_π'.map α).hom.app (Opposite.op V''_et) (𝒢₁.obj.map p_et_V.op x) =
            (L_π'.map β).hom.app (Opposite.op V''_et) (𝒢₁.obj.map p_et_V.op x) := by
          rw [hαβ]
        exact hnat_α.symm.trans (h_eq_V''.trans hnat_β) }

