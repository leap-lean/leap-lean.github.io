      apply CategoryTheory.Limits.Pi.hom_ext
      intro i
      simp [hi i]
    let iso_M : ∀ M : AddCommGrpCat.{u},
        (Φ.skyscraperSheafFunctor (A := AddCommGrpCat.{u}) ⋙ Γ_W).obj M ≅ M := fun M =>
      { hom := CategoryTheory.Limits.Pi.π (fun _ : Φ.fiber.obj T_W => M) t₀
        inv := CategoryTheory.Limits.Pi.lift (fun _ : Φ.fiber.obj T_W => 𝟙 M)
        hom_inv_id := (hPi_const t₀ ht₀ M).1
        inv_hom_id := (hPi_const t₀ ht₀ M).2 }
    let e_sky_Γ : Φ.skyscraperSheafFunctor (A := AddCommGrpCat.{u}) ⋙ Γ_W ≅ 𝟭 AddCommGrpCat.{u} :=
      CategoryTheory.NatIso.ofComponents iso_M (by
        intro M₁ M₂ g
        have hg := CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app
          Φ g (Opposite.op T_W)
        change ((Φ.skyscraperSheafFunctor.map g).hom.app (Opposite.op T_W)) ≫
            CategoryTheory.Limits.Pi.π (fun _ => M₂) t₀ =
          CategoryTheory.Limits.Pi.π (fun _ => M₁) t₀ ≫ g
