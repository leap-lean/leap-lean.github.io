        Algebra.PreSubmersivePresentation.localizationAway B_A j_Q
      let P_tot : Algebra.PreSubmersivePresentation A B_A (Unit ⊕ Fin n_v) (Unit ⊕ Fin n_r) :=
        Q_loc.comp P_Q
