            _ = (C_V.obj A₂).obj.map (p₂ ≫ u₂).op σ := by rw [hp_comm]
            _ = (C_V.obj A₂).obj.map p₂.op ((C_V.obj A₂).obj.map u₂.op σ) := by
              rw [op_comp, (C_V.obj A₂).obj.map_comp]; rfl
        let f_val : ↥T_V.left → ↥A₂ := fun x => a_of (u_x x) (hu_x x)
