        exact hθ_off c V_et (((ψ₀ c).app (Opposite.op V_et)) s_sub) x hx_not_c
      · intro hc₀_abs
        exact absurd (Finset.mem_univ c₀) hc₀_abs
    · have hex' : ∀ c₀ : Fin r, ((Scheme.Etale.forget Y₀).obj V_et).hom.base x ∉
          (V_comp c₀ : Set ↥Y₀) := fun c₀ hc₀ => hex ⟨c₀, hc₀⟩
      rw [Finset.sum_eq_zero]
      · symm
        apply s_sub.2 x
        rw [hVgood_coe, Set.mem_iUnion]
        rintro ⟨c, hc⟩
        exact hex' c hc
      · intro c _
        exact hθ_off c V_et (((ψ₀ c).app (Opposite.op V_et)) s_sub) x (hex' c)

  let ℱ : Fin r → Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u} :=
    fun c => (P_push c).obj (K_X c)
  let ψ : ∀ c : Fin r, K_Y ⟶ ℱ c :=
    fun c => Ψ_Y.hom ≫ ψ₀_sh c ≫ (P_push c).map (Ψ_X c).inv
  let θ : ∀ c : Fin r, ℱ c ⟶ K_Y :=
    fun c => (P_push c).map (Ψ_X c).hom ≫ θ₀_sh c ≫ Ψ_Y.inv

  have h_diag : ∀ c : Fin r, θ c ≫ ψ c = 𝟙 (ℱ c) := by
    intro c
    dsimp [θ, ψ]
    calc (P_push c).map (Ψ_X c).hom ≫ θ₀_sh c ≫ Ψ_Y.inv ≫ Ψ_Y.hom ≫
          ψ₀_sh c ≫ (P_push c).map (Ψ_X c).inv
        = (P_push c).map (Ψ_X c).hom ≫ θ₀_sh c ≫ (Ψ_Y.inv ≫ Ψ_Y.hom) ≫
            ψ₀_sh c ≫ (P_push c).map (Ψ_X c).inv := by simp only [Category.assoc]
      _ = (P_push c).map (Ψ_X c).hom ≫ (θ₀_sh c ≫ ψ₀_sh c) ≫
            (P_push c).map (Ψ_X c).inv := by
          rw [Ψ_Y.inv_hom_id, Category.id_comp, Category.assoc]
      _ = (P_push c).map (Ψ_X c).hom ≫ (P_push c).map (Ψ_X c).inv := by
          rw [h₀_diag c, Category.id_comp]
      _ = (P_push c).map ((Ψ_X c).hom ≫ (Ψ_X c).inv) :=
          ((P_push c).map_comp _ _).symm
      _ = 𝟙 (ℱ c) := by rw [(Ψ_X c).hom_inv_id, (P_push c).map_id]

  have h_off : ∀ c c' : Fin r, c ≠ c' → θ c ≫ ψ c' = 0 := by
    intro c c' hne
    dsimp [θ, ψ]
    have h1 : θ₀_sh c ≫ Ψ_Y.inv ≫ Ψ_Y.hom ≫ ψ₀_sh c' = 0 := by
      rw [← Category.assoc Ψ_Y.inv, Ψ_Y.inv_hom_id, Category.id_comp]
      exact h₀_off c c' hne
    calc (P_push c).map (Ψ_X c).hom ≫ θ₀_sh c ≫ Ψ_Y.inv ≫ Ψ_Y.hom ≫
          ψ₀_sh c' ≫ (P_push c').map (Ψ_X c').inv
        = (P_push c).map (Ψ_X c).hom ≫
            (θ₀_sh c ≫ Ψ_Y.inv ≫ Ψ_Y.hom ≫ ψ₀_sh c') ≫
            (P_push c').map (Ψ_X c').inv := by simp only [Category.assoc]
      _ = 0 := by rw [h1, Limits.zero_comp, Limits.comp_zero]

  have h_sum : (∑ c : Fin r, ψ c ≫ θ c) = 𝟙 K_Y := by
    have h_term : ∀ c : Fin r, ψ c ≫ θ c = Ψ_Y.hom ≫ (ψ₀_sh c ≫ θ₀_sh c) ≫ Ψ_Y.inv := by
      intro c
      dsimp [ψ, θ]
      have hX : (P_push c).map (Ψ_X c).inv ≫ (P_push c).map (Ψ_X c).hom = 𝟙 _ := by
        rw [← (P_push c).map_comp, (Ψ_X c).inv_hom_id, (P_push c).map_id]
      calc Ψ_Y.hom ≫ ψ₀_sh c ≫ (P_push c).map (Ψ_X c).inv ≫
            (P_push c).map (Ψ_X c).hom ≫ θ₀_sh c ≫ Ψ_Y.inv
          = Ψ_Y.hom ≫ ψ₀_sh c ≫
              ((P_push c).map (Ψ_X c).inv ≫ (P_push c).map (Ψ_X c).hom) ≫
              θ₀_sh c ≫ Ψ_Y.inv := by simp only [Category.assoc]
        _ = Ψ_Y.hom ≫ (ψ₀_sh c ≫ θ₀_sh c) ≫ Ψ_Y.inv := by
            rw [hX, Category.id_comp, Category.assoc]
    calc (∑ c : Fin r, ψ c ≫ θ c)
        = ∑ c : Fin r, Ψ_Y.hom ≫ (ψ₀_sh c ≫ θ₀_sh c) ≫ Ψ_Y.inv :=
          Finset.sum_congr rfl (fun c _ => h_term c)
      _ = Ψ_Y.hom ≫ (∑ c : Fin r, (ψ₀_sh c ≫ θ₀_sh c) ≫ Ψ_Y.inv) :=
          (Preadditive.comp_sum _ _ _).symm
      _ = Ψ_Y.hom ≫ (∑ c : Fin r, ψ₀_sh c ≫ θ₀_sh c) ≫ Ψ_Y.inv := by
          rw [← Preadditive.sum_comp]
      _ = Ψ_Y.hom ≫ Ψ_Y.inv := by rw [h₀_sum, Category.id_comp]
      _ = 𝟙 K_Y := Ψ_Y.hom_inv_id

  have hPi_lift_π : ∀ {𝒬 : Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}}
      (p : ∀ b : Fin r, 𝒬 ⟶ ℱ b) (b : Fin r),
      Limits.Pi.lift p ≫ Limits.Pi.π ℱ b = p b :=
    fun p b => (Limits.limit.lift_π (Limits.Fan.mk _ p) ⟨b⟩).trans
      (Limits.Fan.mk_π_app _ p ⟨b⟩)

  let Pi_inv : Limits.piObj ℱ ⟶ K_Y := ∑ c : Fin r, Limits.Pi.π ℱ c ≫ θ c

  have hIso_lift : IsIso (Limits.Pi.lift ψ) := by
    refine ⟨⟨Pi_inv, ?_, ?_⟩⟩
    · dsimp [Pi_inv]
      rw [Preadditive.comp_sum]
      calc (∑ c : Fin r, Limits.Pi.lift ψ ≫ Limits.Pi.π ℱ c ≫ θ c)
          = ∑ c : Fin r, ψ c ≫ θ c := by
            refine Finset.sum_congr rfl (fun c _ => ?_)
            rw [← Category.assoc, hPi_lift_π ψ c]
        _ = 𝟙 K_Y := h_sum
    · apply Limits.Pi.hom_ext
      intro c'
      rw [Category.assoc, hPi_lift_π ψ c', Category.id_comp]
      dsimp [Pi_inv]
      rw [Preadditive.sum_comp, Finset.sum_eq_single c']
      · rw [Category.assoc, h_diag c', Category.comp_id]
      · intro c _ hc_ne
        rw [Category.assoc, h_off c c' hc_ne, Limits.comp_zero]
      · intro hc'_abs
        exact absurd (Finset.mem_univ c') hc'_abs

  refine ⟨ψ, hIso_lift, ?_⟩
  intro c
  let ι0_Y_sh : L0_Y_sh ⟶ L_Y_sh :=
    ObjectProperty.homMk (weilAltZeroBdrySubpresheafι Y₀ V_good n)
  let ι0_X_sh : L0_X_sh c ⟶ L_X_sh c :=
    ObjectProperty.homMk (weilAltZeroBdrySubpresheafι (X c) (W_comp c) n)
  let ρ_c_sh : L_Y_sh ⟶ (P_push c).obj (L_X_sh c) :=
    ObjectProperty.homMk (weilAltLocConstPullbackNat (g c) n)
  have hη_comm : η_M c ≫ (P_push c).map (Φ_X c).hom = Φ_Y.hom ≫ ρ_c_sh := by
    let adj_Yc := constantSheafAdj Y₀.smallEtaleTopology AddCommGrpCat.{u} (hT_Y c)
    let adj_Xc := constantSheafAdj (X c).smallEtaleTopology AddCommGrpCat.{u} (hT_X c)
    let τ_c : (B c).obj (T_Y c) ⟶ T_X c := (hT_X c).from ((B c).obj (T_Y c))
    apply (adj_Yc.homEquiv AM ((P_push c).obj (L_X_sh c))).injective
    rw [Adjunction.homEquiv_naturality_right,
      (adj_Yc.homEquiv AM _).apply_symm_apply,
      Adjunction.homEquiv_unit]
    change (adj_Xc.unit.app AM ≫ (weilEtaleTorsionSheaf (X c) n).obj.map τ_c.op) ≫
        (Φ_X c).hom.hom.app (Opposite.op ((B c).obj (T_Y c))) =
      adj_Yc.unit.app AM ≫
        (Φ_Y.hom.hom.app (Opposite.op (T_Y c)) ≫
          (weilAltLocConstPullbackNat (g c) n).app (Opposite.op (T_Y c)))
    rw [Category.assoc, (Φ_X c).hom.hom.naturality τ_c.op, ← Category.assoc,
      hΦ_X_unit c (T_X c) (hT_X c), ← Category.assoc, hΦ_Y_unit (T_Y c) (hT_Y c)]
    exact AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl))

  apply (cancel_mono ((P_push c).map (Φ_X c).hom)).mp
  have hΨX_inv_comm : (Ψ_X c).inv ≫ ι_X c ≫ (Φ_X c).hom = ι0_X_sh := by
    rw [← hΨ_X_comm c, ← Category.assoc, (Ψ_X c).inv_hom_id, Category.id_comp]
  have hψ₀_sh_comm : ψ₀_sh c ≫ (P_push c).map ι0_X_sh = ι0_Y_sh ≫ ρ_c_sh :=
    Sheaf.hom_ext (hψ₀_comm c)
  calc (ψ c ≫ (P_push c).map (ι_X c)) ≫ (P_push c).map (Φ_X c).hom
      = Ψ_Y.hom ≫ ψ₀_sh c ≫
          ((P_push c).map (Ψ_X c).inv ≫ (P_push c).map (ι_X c) ≫ (P_push c).map (Φ_X c).hom) := by
        dsimp [ψ]; simp only [Category.assoc]
    _ = Ψ_Y.hom ≫ ψ₀_sh c ≫ (P_push c).map ((Ψ_X c).inv ≫ ι_X c ≫ (Φ_X c).hom) := by
        rw [← (P_push c).map_comp, ← (P_push c).map_comp]
    _ = Ψ_Y.hom ≫ (ψ₀_sh c ≫ (P_push c).map ι0_X_sh) := by
        rw [hΨX_inv_comm]
    _ = (Ψ_Y.hom ≫ ι0_Y_sh) ≫ ρ_c_sh := by
        rw [hψ₀_sh_comm, Category.assoc]
    _ = (ι_Y ≫ Φ_Y.hom) ≫ ρ_c_sh := by
        rw [hΨ_Y_comm]
    _ = ι_Y ≫ (Φ_Y.hom ≫ ρ_c_sh) :=
        Category.assoc _ _ _
    _ = ι_Y ≫ (η_M c ≫ (P_push c).map (Φ_X c).hom) := by rw [← hη_comm]
    _ = (ι_Y ≫ η_M c) ≫ (P_push c).map (Φ_X c).hom := (Category.assoc _ _ _).symm

theorem weil_etale_finite_leray_counit_bijective {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) [AlgebraicGeometry.IsFinite f]
    [(weilEtaleSitePullback f).IsContinuous S.smallEtaleTopology X.smallEtaleTopology]
    (P_pull : CategoryTheory.Functor
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
    (adj_pull : CategoryTheory.Adjunction P_pull
      ((weilEtaleSitePullback f).sheafPushforwardContinuous
        AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology))
    [P_pull.Additive]
    [CategoryTheory.Limits.PreservesFiniteLimits P_pull]
    [CategoryTheory.Limits.PreservesFiniteColimits P_pull]
    (T₁ : X.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
    (T₂ : S.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
    (ιℤ : ((CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))) ⟶
      P_pull.obj ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))))
    (hιπ : CategoryTheory.CategoryStruct.comp ιℤ
      ((adj_pull.homEquiv _ _).symm
        (((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT₂).homEquiv _ _).symm
          (CategoryTheory.CategoryStruct.comp
            ((CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hT₁).unit.app _)
            (((CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
              (AddCommGrpCat.of (ULift.{u} ℤ))).obj.map
              (Opposite.op (hT₁.from ((weilEtaleSitePullback f).obj T₂))))))) =
      CategoryTheory.CategoryStruct.id _)
    (hπι : CategoryTheory.CategoryStruct.comp
      ((adj_pull.homEquiv _ _).symm
        (((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT₂).homEquiv _ _).symm
          (CategoryTheory.CategoryStruct.comp
            ((CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hT₁).unit.app _)
            (((CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
              (AddCommGrpCat.of (ULift.{u} ℤ))).obj.map
              (Opposite.op (hT₁.from ((weilEtaleSitePullback f).obj T₂)))))))
      ιℤ = CategoryTheory.CategoryStruct.id _)
    (𝒢 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ) :
    Function.Bijective
      (fun z : CategoryTheory.Abelian.Ext
          ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ)))
          (((weilEtaleSitePullback f).sheafPushforwardContinuous
            AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology).obj 𝒢) q =>
        (CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app 𝒢)).postcomp
          ((CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            ((P_pull.mapExtAddHom
              ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
                (AddCommGrpCat.of (ULift.{u} ℤ)))
              (((weilEtaleSitePullback f).sheafPushforwardContinuous
                AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology).obj 𝒢)
              q) z) (Nat.zero_add q))) :=
by
  let _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    AlgebraicGeometry.Etale.instIsMultiplicativeScheme.toIsStableUnderComposition
  let B_f : CategoryTheory.Functor S.Etale X.Etale := weilEtaleSitePullback f
  let P_push := B_f.sheafPushforwardContinuous AddCommGrpCat.{u}
    S.smallEtaleTopology X.smallEtaleTopology
  
  have hClopenBij : ∀ (V : X.Etale)
      (D : Type u) [CommRing D]
      (e_V : V.left ≅ AlgebraicGeometry.Spec (CommRingCat.of D))
      (r : ℕ) (D_f : Fin r → Type u) [∀ m, CommRing (D_f m)]
      (e_D : D ≃+* (∀ m : Fin r, D_f m)),
      ∃ (hEt : ∀ m : Fin r,
          AlgebraicGeometry.Etale
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Pi.evalRingHom D_f m).comp e_D.toRingHom)))
              (CategoryTheory.CategoryStruct.comp e_V.inv V.hom))),
        ∀ (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
          Function.Bijective
            (fun (s : ↥(F.obj.obj (Opposite.op V))) (m : Fin r) =>
              let V_m : X.Etale :=
                @AlgebraicGeometry.Scheme.Etale.mk X
                  (AlgebraicGeometry.Spec (CommRingCat.of (D_f m)))
                  (CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Spec.map
                      (CommRingCat.ofHom ((Pi.evalRingHom D_f m).comp e_D.toRingHom)))
                    (CategoryTheory.CategoryStruct.comp e_V.inv V.hom))
                  (hEt m)
              let v_m : V_m ⟶ V :=
                CategoryTheory.MorphismProperty.Over.homMk
                  (CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Spec.map
                      (CommRingCat.ofHom ((Pi.evalRingHom D_f m).comp e_D.toRingHom)))
                    e_V.inv)
                  (CategoryTheory.Category.assoc _ _ _)
                  trivial
              (F.obj.map (Opposite.op v_m)) s) := by
    intro V D _ e_V r D_f _ e_D
    let π_m : ∀ m : Fin r, D →+* D_f m := fun m => (Pi.evalRingHom D_f m).comp e_D.toRingHom
    let r_m : Fin r → D := fun m => e_D.symm (Pi.single m 1)
    have hπ_r_diag : ∀ m : Fin r, π_m m (r_m m) = 1 := by
      intro m
      change (e_D (e_D.symm (Pi.single m 1))) m = 1
      rw [e_D.apply_symm_apply, Pi.single_eq_same]
    have hπ_r_off : ∀ (m₁ m₂ : Fin r), m₁ ≠ m₂ → π_m m₂ (r_m m₁) = 0 := by
      intro m₁ m₂ hne
      change (e_D (e_D.symm (Pi.single m₁ 1))) m₂ = 0
      rw [e_D.apply_symm_apply, Pi.single_eq_of_ne hne.symm]
    have hπ_surj : ∀ m : Fin r, Function.Surjective (π_m m) := by
      intro m y
      refine ⟨e_D.symm (Pi.single m y), ?_⟩
      change (e_D (e_D.symm (Pi.single m y))) m = y
      rw [e_D.apply_symm_apply, Pi.single_eq_same]
    have h_ann : ∀ (m : Fin r) (a b : D), π_m m a = π_m m b → r_m m * a = r_m m * b := by
      intro m a b hab
      apply e_D.injective
      funext k
      rw [map_mul, map_mul]
      change (e_D (e_D.symm (Pi.single m 1))) k * (e_D a) k =
        (e_D (e_D.symm (Pi.single m 1))) k * (e_D b) k
      rw [e_D.apply_symm_apply]
      by_cases hk : k = m
      · subst hk
        rw [Pi.single_eq_same, one_mul, one_mul]
        exact hab
      · rw [Pi.single_eq_of_ne hk, zero_mul, zero_mul]
    have hEt_spec : ∀ m : Fin r,
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_m m))) := by
      intro m
      let _ : Algebra D (D_f m) := (π_m m).toAlgebra
      have _ : IsLocalization.Away (r_m m) (D_f m) := by
        apply IsLocalization.Away.mk
        · change IsUnit (π_m m (r_m m))
          rw [hπ_r_diag m]
          exact isUnit_one
        · intro y
          obtain ⟨a, ha⟩ := hπ_surj m y
          refine ⟨0, a, ?_⟩
          change y * (π_m m (r_m m)) ^ 0 = π_m m a
          rw [pow_zero, mul_one, ha]
        · intro a b hab
          refine ⟨1, ?_⟩
          rw [pow_one]
          exact h_ann m a b hab
      have hAlgEt : Algebra.Etale D (D_f m) := Algebra.Etale.of_isLocalizationAway (r_m m)
      have hRhEt : (CommRingCat.ofHom (π_m m)).hom.Etale := hAlgEt
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale)).mpr hRhEt
    have hEt : ∀ m : Fin r,
        AlgebraicGeometry.Etale
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_m m)))
            (CategoryTheory.CategoryStruct.comp e_V.inv V.hom)) := by
      intro m
      have _ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_m m))) :=
        hEt_spec m
      have _ : AlgebraicGeometry.Etale V.hom := V.prop
      have _ : AlgebraicGeometry.Etale (e_V.inv ≫ V.hom) := inferInstance
      exact inferInstance
    refine ⟨hEt, fun F => ?_⟩
    let Z₁ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let P_set := F.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Z₁)
    let toHom : ∀ {A : AddCommGrpCat.{u}}, ↥A ≃ (Z₁ ⟶ A) := fun {A} =>
      { toFun := fun a => AddCommGrpCat.ofHom ((zmultiplesHom A a).comp
          { toFun := ULift.down, map_zero' := rfl, map_add' := fun _ _ => rfl })
        invFun := fun φ => φ (ULift.up 1)
        left_inv := fun a => one_zsmul a
        right_inv := fun φ => by
          ext ⟨n⟩
          change n • φ (ULift.up 1) = φ (ULift.up n)
          have hn : (ULift.up n : Z₁) = n • (ULift.up 1 : Z₁) :=
            ULift.ext _ _ (zsmul_one n).symm
          rw [hn, map_zsmul] }
    have htoHom_map : ∀ {A B : AddCommGrpCat.{u}} (ψ : A ⟶ B) (a : ↥A),
        toHom a ≫ ψ = toHom (ψ a) := by
      intro A B ψ a
      apply toHom.symm.injective
      rw [Equiv.symm_apply_apply]
      change ψ ((1 : ℤ) • a) = ψ a
      rw [one_zsmul]
    let V_m : Fin r → X.Etale := fun m =>
      @AlgebraicGeometry.Scheme.Etale.mk X
        (AlgebraicGeometry.Spec (CommRingCat.of (D_f m)))
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_m m)))
          (CategoryTheory.CategoryStruct.comp e_V.inv V.hom))
        (hEt m)
    let v_m : ∀ m : Fin r, V_m m ⟶ V := fun m =>
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_m m)))
          e_V.inv)
        (CategoryTheory.Category.assoc _ _ _)
        trivial
    have hMono_v : ∀ m : Fin r, CategoryTheory.Mono (v_m m) := by
      intro m
      have _ : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_m m))) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
          (CommRingCat.ofHom (π_m m)) (hπ_surj m)
      refine ⟨fun {Z} g₁ g₂ hg => ?_⟩
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      have hg_left : g₁.left ≫ (v_m m).left = g₂.left ≫ (v_m m).left :=
        congrArg (fun u : Z ⟶ V => u.left) hg
      have hg_spec : (g₁.left ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_m m))) ≫ e_V.inv =
          (g₂.left ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_m m))) ≫ e_V.inv :=
        (CategoryTheory.Category.assoc g₁.left _ e_V.inv).trans
          (hg_left.trans (CategoryTheory.Category.assoc g₂.left _ e_V.inv).symm)
      have hg_spec' : g₁.left ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_m m)) =
          g₂.left ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_m m)) :=
        (CategoryTheory.cancel_mono e_V.inv).mp hg_spec
      exact (CategoryTheory.cancel_mono
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_m m)))).mp hg_spec'
    have hEmpty_isZero : ∀ (W : X.Etale), IsEmpty ↥W.left →
        Subsingleton ↥(F.obj.obj (Opposite.op W)) := by
      intro W hEmp
