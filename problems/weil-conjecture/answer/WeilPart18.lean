          let mul_w : D →ₗ[R_h] D := LinearMap.mulLeft R_h (wb i)
          have hker : J.restrictScalars R_h ≤ LinearMap.ker mul_w := by
            intro x hx
            change x ∈ Ideal.span {1 - wb i} at hx
            rw [Ideal.mem_span_singleton] at hx
            obtain ⟨d, rfl⟩ := hx
            rw [LinearMap.mem_ker]
            change wb i * ((1 - wb i) * d) = 0
            calc
              wb i * ((1 - wb i) * d) = (wb i - wb i * wb i) * d := by ring
              _ = 0 := by rw [h_idem i, sub_self, zero_mul]
          let lam_i : (D ⧸ J) →ₗ[R_h] D := Submodule.liftQ (J.restrictScalars R_h) mul_w hker
          have hlam_mk : ∀ x : D, lam_i (πJ x) = wb i * x :=
            fun x => Submodule.liftQ_apply _ _ x
          refine ⟨lam_i.comp ν_i.toLinearMap, ?_, ?_, ?_⟩
          · change lam_i (ν_i 1) = wb i
            rw [map_one, ← map_one πJ, hlam_mk, mul_one]
          · intro z₁ z₂
