      {G₁ G₂ : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}} (α : G₁ ⟶ G₂),
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
        CategoryTheory.IsIso (((pt W Ω w).sheafFiber (A := AddCommGrpCat.{u})).map α)) →
