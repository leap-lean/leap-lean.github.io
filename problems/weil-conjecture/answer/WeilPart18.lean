      rw [map_sum, Finset.sum_eq_single c₀]
      · rw [← hpostY_comp (σ_c c₀) (π_c c₀), hσπ_diag c₀, hpostY_id]
      · intro c _ hc_ne
        rw [← hpostY_comp (σ_c c) (π_c c₀), hσπ_off c c₀ hc_ne.symm,
