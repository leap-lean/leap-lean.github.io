          cr_ext ((h_desc_L s).choose_spec.2 m_hom.hom
            (fun w => congrArg CommRingCat.Hom.hom (hm w))) }
    let α : (Functor.const J₁).obj (CommRingCat.of B) ⟶ L :=
      { app := fun w =>
          CommRingCat.ofHom ((algebraMap (F_D.obj w.right) (A_w w)).comp
            Algebra.TensorProduct.includeLeftRingHom)
        naturality := fun {w₁ w₂} φ => by
          apply cr_ext
          apply RingHom.ext
          intro b
          change algebraMap (F_D.obj w₂.right) (A_w w₂) (b ⊗ₜ[R] 1) =
            IsLocalization.Away.lift (x_w w₁) (hu_φ φ)
              (algebraMap (F_D.obj w₁.right) (A_w w₁) (b ⊗ₜ[R] 1))
          rw [IsLocalization.Away.lift_eq, RingHom.comp_apply]
          change algebraMap (F_D.obj w₂.right) (A_w w₂) (b ⊗ₜ[R] 1) =
            algebraMap (F_D.obj w₂.right) (A_w w₂) (b ⊗ₜ[R] (F.map φ.right).hom 1)
          rw [map_one] }
    let f_B : CommRingCat.of B ⟶ CommRingCat.of (C (idx m)) :=
      CommRingCat.ofHom (algebraMap B (C (idx m)))
    have hf_B : f_B.hom.FinitePresentation :=
      RingHom.finitePresentation_algebraMap.mpr inferInstance
    let g_pt : CommRingCat.of (C (idx m)) ⟶ c_L.pt := CommRingCat.ofHom (σ_A m)
    have hg_pt : ∀ w : J₁, f_B ≫ g_pt = α.app w ≫ c_L.ι.app w := by
      intro w
      apply cr_ext
      apply RingHom.ext
      intro b
      have hb := RingHom.congr_fun (hσ_A m) b
      change (σ_A m) (algebraMap B (C (idx m)) b) =
        IsLocalization.Away.lift (x_w w) (hu_ι w)
          (algebraMap (F_D.obj w.right) (A_w w) (b ⊗ₜ[R] 1))
      rw [IsLocalization.Away.lift_eq, RingHom.comp_apply]
      change (σ_A m) (algebraMap B (C (idx m)) b) =
        algebraMap (TensorProduct R B c.pt) (Localization.Away x_pt)
          (b ⊗ₜ[R] (c.ι.app w.right).hom 1)
      rw [map_one]
      exact hb
    obtain ⟨w_m, g', hfg', -⟩ :=
      RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
        (CommRingCat.of B) L α f_B c_L hc_L hf_B g_pt hg_pt
    exact ⟨w_m.right, w_m.hom, g'.hom, congrArg CommRingCat.Hom.hom hfg'⟩
  
  choose j₂ u σ₂ hσ₂ using h_sec_desc
  obtain ⟨j_star, u_star, v, huv⟩ := IsFiltered.wideSpan u
  let e : Fin r → TensorProduct R B (F.obj j_star) := ⇑(F_D.map u_star).hom ∘ e₁
  have he : CompleteOrthogonalIdempotents e := he₁.map (F_D.map u_star).hom
  have h_push_eq : ∀ m : Fin r,
      (F_D.map (v m)).hom ((F_D.map (u m)).hom (e₁ m)) = e m := by
    intro m
    dsimp [e]
    have hcomp : F_D.map (u m) ≫ F_D.map (v m) = F_D.map u_star := by
      rw [← F_D.map_comp, huv m]
    exact congrArg (fun k : F_D.obj j₁ ⟶ F_D.obj j_star => k.hom (e₁ m)) hcomp
  have hu_v : ∀ m : Fin r,
      IsUnit (((algebraMap (TensorProduct R B (F.obj j_star)) (Localization.Away (e m))).comp
        (F_D.map (v m)).hom) ((F_D.map (u m)).hom (e₁ m))) := by
    intro m
    rw [RingHom.comp_apply, h_push_eq m]
    exact IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (e m)) (e m)
  let push_v : ∀ m : Fin r,
      Localization.Away ((F_D.map (u m)).hom (e₁ m)) →+* Localization.Away (e m) :=
    fun m => IsLocalization.Away.lift ((F_D.map (u m)).hom (e₁ m)) (hu_v m)
  let σ : ∀ m : Fin r, C (idx m) →+* Localization.Away (e m) :=
    fun m => (push_v m).comp (σ₂ m)
  refine ⟨j_star, e, σ, he, ?_⟩
  intro m
  dsimp [σ, push_v]
  rw [RingHom.comp_assoc, hσ₂ m, ← RingHom.comp_assoc, IsLocalization.Away.lift_comp,
    RingHom.comp_assoc]
  congr 1
  apply RingHom.ext
  intro b
  change b ⊗ₜ[R] (F.map (v m)).hom 1 = b ⊗ₜ[R] 1
  rw [map_one]

theorem weil_finite_ring_etale_cover_section_lifting (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] [Module.Finite R B]
    (p : PrimeSpectrum R) (I : Type u) (C : I → Type u)
    [∀ i, CommRing (C i)] [∀ i, Algebra B (C i)] [∀ i, Algebra.Etale B (C i)]
    (hCover : ∀ q : PrimeSpectrum B, PrimeSpectrum.comap (algebraMap R B) q = p →
      ∃ (i : I) (q' : PrimeSpectrum (C i)), PrimeSpectrum.comap (algebraMap B (C i)) q' = q) :
    ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R') (_ : Algebra.Etale R R')
      (p' : PrimeSpectrum R')
      (r : ℕ) (e : Fin r → TensorProduct R B R')
      (idx : Fin r → I)
      (σ : ∀ m : Fin r, C (idx m) →+* Localization.Away (e m)),
      PrimeSpectrum.comap (algebraMap R R') p' = p ∧
      CompleteOrthogonalIdempotents e ∧
      (∀ m : Fin r, (σ m).comp (algebraMap B (C (idx m))) =
        (algebraMap (TensorProduct R B R') (Localization.Away (e m))).comp
          Algebra.TensorProduct.includeLeftRingHom) :=
by
  classical
  obtain ⟨J, hCatJ, hFiltJ, F, hAlgF, hEtF, c, hAlgA, hLocA,
      hF_alg, hι_alg, hc, hpA, hSepA, hJacA⟩ :=
    weil_strict_local_etale_filtered_colimit R p
  let _ : CategoryTheory.SmallCategory J := hCatJ
  have _ : CategoryTheory.IsFiltered J := hFiltJ
  let _ : ∀ j : J, Algebra R (F.obj j) := hAlgF
  have _ : ∀ j : J, Algebra.Etale R (F.obj j) := hEtF
  let _ : Algebra R c.pt := hAlgA
  have _ : IsLocalRing c.pt := hLocA
  have _ : IsSepClosed (IsLocalRing.ResidueField c.pt) := hSepA
  have hFinSplit : ∀ (D : Type u) [CommRing D] [Algebra c.pt D] [Module.Finite c.pt D],
      ∃ (r : ℕ) (e : Fin r → D),
        CompleteOrthogonalIdempotents e ∧
        ∀ m : Fin r, IsLocalRing (Localization.Away (e m)) :=
    fun D _ _ _ => weil_jacobian_local_ring_finite_alg_split c.pt D hJacA
  let D_A : Type u := TensorProduct R B c.pt
  let _ : Algebra c.pt D_A := Algebra.TensorProduct.rightAlgebra
  have hFin_AB : Module.Finite c.pt (TensorProduct R c.pt B) :=
    Module.Finite.base_change R c.pt B
  let e_comm : TensorProduct R c.pt B ≃ₗ[c.pt] D_A :=
    { (Algebra.TensorProduct.comm R c.pt B).toAddEquiv with
      map_smul' := fun a x => by
        change (Algebra.TensorProduct.comm R c.pt B) (a • x) =
          (1 : B) ⊗ₜ[R] a * (Algebra.TensorProduct.comm R c.pt B) x
        rw [Algebra.smul_def, map_mul]
        rfl }
  have _ : Module.Finite c.pt D_A := Module.Finite.equiv e_comm
  obtain ⟨r, e_A, he_A, hLoc_m⟩ := hFinSplit D_A
  let ι_B : ∀ m : Fin r, B →+* Localization.Away (e_A m) := fun m =>
    (algebraMap D_A (Localization.Away (e_A m))).comp
      Algebra.TensorProduct.includeLeftRingHom
  have hSec_m : ∀ m : Fin r,
      ∃ (i : I) (σ_m : C i →+* Localization.Away (e_A m)),
        σ_m.comp (algebraMap B (C i)) = ι_B m := by
    intro m
    let B_m : Type u := Localization.Away (e_A m)
    have _ : IsLocalRing B_m := hLoc_m m
    have h_em_one : algebraMap D_A B_m (e_A m) = 1 := by
      have hu : IsUnit (algebraMap D_A B_m (e_A m)) :=
        IsLocalization.map_units B_m ⟨e_A m, Submonoid.mem_powers (e_A m)⟩
      have hidem : IsIdempotentElem (e_A m) := he_A.1.1 m
      apply hu.mul_left_cancel
      rw [mul_one, ← map_mul, hidem.eq]
    let f_lin : D_A →ₗ[c.pt] B_m := (IsScalarTower.toAlgHom c.pt D_A B_m).toLinearMap
    have hf_surj : Function.Surjective f_lin := by
      intro z
      obtain ⟨n, d, hd⟩ := IsLocalization.Away.surj (e_A m) z
      refine ⟨d, ?_⟩
      change algebraMap D_A B_m d = z
      rw [← hd, h_em_one, one_pow, mul_one]
    have _ : Module.Finite c.pt B_m := Module.Finite.of_surjective f_lin hf_surj
    have hInt_Bm : (algebraMap c.pt B_m).IsIntegral :=
      Algebra.isIntegral_def.mp (Algebra.IsIntegral.of_finite c.pt B_m)
    have hMax_comap : (Ideal.comap (algebraMap c.pt B_m)
        (IsLocalRing.maximalIdeal B_m)).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap c.pt B_m) hInt_Bm
        (IsLocalRing.maximalIdeal B_m)
    have hComap_A : PrimeSpectrum.comap (algebraMap c.pt B_m) (IsLocalRing.closedPoint B_m) =
        IsLocalRing.closedPoint c.pt := by
      ext1
      exact IsLocalRing.eq_maximalIdeal hMax_comap
    let q_m : PrimeSpectrum B := PrimeSpectrum.comap (ι_B m) (IsLocalRing.closedPoint B_m)
    have h_comp_R : (ι_B m).comp (algebraMap R B) =
        (algebraMap c.pt B_m).comp (algebraMap R c.pt) := by
      ext r₀
      change algebraMap D_A B_m (algebraMap R B r₀ ⊗ₜ[R] (1 : c.pt)) =
        algebraMap c.pt B_m (algebraMap R c.pt r₀)
      rw [Algebra.TensorProduct.tmul_one_eq_one_tmul,
        IsScalarTower.algebraMap_apply c.pt D_A B_m]
      rfl
    have hq_m : PrimeSpectrum.comap (algebraMap R B) q_m = p := by
      have h1 : PrimeSpectrum.comap (algebraMap R B) q_m =
          PrimeSpectrum.comap ((ι_B m).comp (algebraMap R B)) (IsLocalRing.closedPoint B_m) := by
        ext1; rfl
      have h2 : PrimeSpectrum.comap ((algebraMap c.pt B_m).comp (algebraMap R c.pt))
          (IsLocalRing.closedPoint B_m) =
          PrimeSpectrum.comap (algebraMap R c.pt)
            (PrimeSpectrum.comap (algebraMap c.pt B_m) (IsLocalRing.closedPoint B_m)) := by
        ext1; rfl
      rw [h1, h_comp_R, h2, hComap_A, hpA]
    obtain ⟨i, q', hq'⟩ := hCover q_m hq_m
    obtain ⟨σ_m, hσ_m⟩ :=
      weil_sepClosed_local_etale_section_of_finite_split c.pt B (C i) B_m
        hFinSplit (ι_B m) q' hq'
    exact ⟨i, σ_m, hσ_m⟩
  choose idx σ_A hσ_A using hSec_m
  obtain ⟨j_star, e, σ, he, hσ⟩ :=
    weil_filtered_colimit_etale_section_descent R B I C J F hF_alg c hι_alg hc
      r e_A he_A idx σ_A hσ_A
  let R' : Type u := F.obj j_star
  let p' : PrimeSpectrum R' :=
    PrimeSpectrum.comap (c.ι.app j_star).hom (IsLocalRing.closedPoint c.pt)
  have hp' : PrimeSpectrum.comap (algebraMap R R') p' = p := by
    have hcomp_j : (c.ι.app j_star).hom.comp (algebraMap R R') = algebraMap R c.pt := by
      ext r₀
      exact hι_alg j_star r₀
    have h1 : PrimeSpectrum.comap (algebraMap R R') p' =
        PrimeSpectrum.comap ((c.ι.app j_star).hom.comp (algebraMap R R'))
          (IsLocalRing.closedPoint c.pt) := by
      ext1; rfl
    rw [h1, hcomp_j, hpA]
  exact ⟨R', inferInstance, hAlgF j_star, hEtF j_star, p', r, e, idx, σ, hp', he, hσ⟩

theorem weil_etale_higherDirectImage_comp_of_pushforward_epi {Y X S : AlgebraicGeometry.Scheme.{u}} (π : Y ⟶ X) (p : X ⟶ S) :
    let B_π : CategoryTheory.Functor X.Etale Y.Etale :=
      (let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) π :=
         CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
       let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) π :=
         CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
           (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
       CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ π);
    ∀ (hc : CategoryTheory.Functor.IsContinuous B_π X.smallEtaleTopology Y.smallEtaleTopology),
      (∀ {F₁ F₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
        (v : F₁ ⟶ F₂) [CategoryTheory.Epi v],
        CategoryTheory.Epi
          ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B_π AddCommGrpCat.{u} _
            X.smallEtaleTopology Y.smallEtaleTopology hc).map v)) →
      ∀ (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        Nonempty (weilEtaleHigherDirectImage p q (weilEtaleHigherDirectImage π 0 F) ≅
          weilEtaleHigherDirectImage (π ≫ p) q F) :=
by
  classical
  let A := AddCommGrpCat.{u}
  let P_et : MorphismProperty Scheme.{u} := @AlgebraicGeometry.Etale
  
  have mem_smallEtaleTopology_iff : ∀ {T : Scheme.{u}} (U : T.Etale) (S₀ : Sieve U),
      S₀ ∈ T.smallEtaleTopology U ↔
        ∀ x : ↥U.left, ∃ (V : T.Etale) (f : V ⟶ U) (y : ↥V.left),
          S₀.arrows f ∧ Etale f.left ∧ f.left.base y = x := by
    intro T U S₀
    have h_gen : ∀ (U₀ : P_et.Over ⊤ T) (S₁ : Sieve U₀),
        S₁ ∈ (Scheme.smallGrothendieckTopology (S := T) P_et) U₀ ↔
          ∀ x : ↥U₀.left, ∃ (Y₀ : P_et.Over ⊤ T) (f : Y₀ ⟶ U₀) (y : ↥Y₀.left),
            S₁.arrows f ∧ P_et f.left ∧ f.left.base y = x := by
      intro U₀ S₁
      rw [Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology (P := P_et) (S := T)]
      · exact Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U₀ S₁
      · exact le_refl P_et
    exact h_gen U S₀
  have hSitePullback : ∀ {Z₁ Z₂ : Scheme.{u}} (g : Z₁ ⟶ Z₂),
      let B_g : Z₂.Etale ⥤ Z₁.Etale :=
        (let _ : MorphismProperty.HasPullbacksAlong (@Etale) g :=
           MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
         let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) g :=
           MorphismProperty.IsStableUnderBaseChangeAlong.mk
             (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
         MorphismProperty.Over.pullback (@Etale) ⊤ g)
      Limits.PreservesFiniteLimits B_g ∧
        B_g.IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := by
    intro Z₁ Z₂ g
    let _ : MorphismProperty.HasPullbacksAlong P_et g :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong P_et g :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : Z₂.Etale ⥤ Z₁.Etale := MorphismProperty.Over.pullback P_et ⊤ g
    have hLim : Limits.PreservesFiniteLimits B := by
      let Fgt₁ := Scheme.Etale.forget Z₁
      let Fgt₂ := Scheme.Etale.forget Z₂
      have _ : Limits.PreservesLimits (CategoryTheory.Over.pullback g) :=
        (CategoryTheory.Over.mapPullbackAdj g).rightAdjoint_preservesLimits
      have hCompLim : Limits.PreservesFiniteLimits (Fgt₂ ⋙ CategoryTheory.Over.pullback g) :=
        Limits.comp_preservesFiniteLimits Fgt₂ (CategoryTheory.Over.pullback g)
      have hEq : B ⋙ Fgt₁ = Fgt₂ ⋙ CategoryTheory.Over.pullback g := rfl
      have _ : Limits.PreservesFiniteLimits (B ⋙ Fgt₁) := hEq ▸ hCompLim
      exact Limits.preservesFiniteLimits_of_reflects_of_preserves B Fgt₁
    refine ⟨hLim, ?_⟩
    change B.IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    have _ : RepresentablyFlat B := flat_of_preservesFiniteLimits B
    have hCompat : CompatiblePreserving Z₁.smallEtaleTopology B :=
      compatiblePreservingOfFlat Z₁.smallEtaleTopology B
    have hCov : CoverPreserving Z₂.smallEtaleTopology Z₁.smallEtaleTopology B := by
      refine CoverPreserving.mk ?_
      intro U S₀ hS₀
      rw [mem_smallEtaleTopology_iff] at hS₀ ⊢
      intro y'
      let u₀ : ↥U.left := (Limits.pullback.fst U.hom g).base y'
      obtain ⟨V, f, v₀, hfS, _, hv₀⟩ := hS₀ u₀
      have hpb_f : IsPullback (B.map f).left (Limits.pullback.fst V.hom g)
          (Limits.pullback.fst U.hom g) f.left := by
        have htop : IsPullback (B.obj V).hom (Limits.pullback.fst V.hom g) g V.hom :=
          (IsPullback.of_hasPullback V.hom g).flip
        have hbot : IsPullback (B.obj U).hom (Limits.pullback.fst U.hom g) g U.hom :=
          (IsPullback.of_hasPullback U.hom g).flip
        refine IsPullback.of_right ?_ ?_ hbot
        · have hV : (B.map f).left ≫ (B.obj U).hom = (B.obj V).hom :=
            MorphismProperty.Over.w (B.map f)
          have hf_w : f.left ≫ U.hom = V.hom := MorphismProperty.Over.w f
          exact (hV.symm ▸ hf_w.symm ▸ htop)
        · dsimp [B]
          exact Limits.pullback.lift_fst _ _ _
      obtain ⟨z₀, hz₀, _⟩ := Scheme.Pullback.exists_preimage_pullback y' v₀ hv₀.symm
      let z' : ↥(B.obj V).left := hpb_f.isoPullback.inv.base z₀
      have hEt_Bf : Etale (B.map f).left :=
        MorphismProperty.of_postcomp P_et (B.map f).left (B.obj U).hom (B.obj U).prop
          ((MorphismProperty.Over.w (B.map f)).symm ▸ (B.obj V).prop)
      refine ⟨B.obj V, B.map f, z', ⟨V, f, 𝟙 (B.obj V), hfS, (Category.id_comp _).symm⟩,
        hEt_Bf, ?_⟩
      change (hpb_f.isoPullback.inv ≫ (B.map f).left).base z₀ = y'
      rw [hpb_f.isoPullback_inv_fst]
      exact hz₀
    exact Functor.isContinuous_of_coverPreserving hCompat hCov

  
  have eCoh₀_exists : ∀ (T : Scheme.{u}),
      Nonempty (Sheaf.cohomologyPresheafFunctor T.smallEtaleTopology 0 ≅
        sheafToPresheaf T.smallEtaleTopology A) := by
    intro T
    let J := T.smallEtaleTopology
    let Sh_T := presheafToSheaf J A
    let I_T := sheafToPresheaf J A
    let adj_sh := sheafificationAdjunction J A
    let adj_free := (AddCommGrpCat.adj.whiskerRight (T.Etale)ᵒᵖ).comp adj_sh
    let P_free : T.Etale ⥤ ((T.Etale)ᵒᵖ ⥤ A) :=
      yoneda ⋙ (Functor.whiskeringRight (T.Etale)ᵒᵖ (Type u) A).obj AddCommGrpCat.free
    let L_free : T.Etale ⥤ Sheaf J A := P_free ⋙ Sh_T
    let η_id : ∀ U : T.Etale, ↥((P_free.obj U).obj (Opposite.op U)) :=
      fun U => (AddCommGrpCat.adj.unit.app (U ⟶ U)) (𝟙 U)
    let ξ : ∀ U : T.Etale, ↥((L_free.obj U).obj.obj (Opposite.op U)) :=
      fun U => ((adj_sh.unit.app (P_free.obj U)).app (Opposite.op U)) (η_id U)
    let eqv : ∀ (G : Sheaf J A) (U : T.Etale),
        Abelian.Ext (L_free.obj U) G 0 ≃ ↥(G.obj.obj (Opposite.op U)) :=
      fun G U =>
        Abelian.Ext.addEquiv₀.toEquiv.trans
          ((adj_free.homEquiv (yoneda.obj U) G).trans yonedaEquiv)
    let Φ : ∀ (G : Sheaf J A) (U : T.Etale),
        Abelian.Ext (L_free.obj U) G 0 →+ ↥(G.obj.obj (Opposite.op U)) :=
      fun G U =>
        { toFun := fun x => ((Abelian.Ext.addEquiv₀ x).hom.app (Opposite.op U)) (ξ U)
          map_zero' := by
            rw [map_zero]
            exact AddCommGrpCat.zero_apply _ _ _
          map_add' := fun x y => by
            rw [map_add]
            rfl }
    have hΦ_eq : ∀ (G : Sheaf J A) (U : T.Etale) (x : Abelian.Ext (L_free.obj U) G 0),
        Φ G U x = eqv G U x := by
      intro G U x
      dsimp [Φ, eqv, adj_free, Adjunction.comp, Adjunction.whiskerRight, yonedaEquiv, ξ, η_id]
      rfl
    have hΦ_bij : ∀ (G : Sheaf J A) (U : T.Etale), Function.Bijective (Φ G U) := by
      intro G U
      have hEq : (⇑(Φ G U) : Abelian.Ext (L_free.obj U) G 0 → ↥(G.obj.obj (Opposite.op U))) =
          ⇑(eqv G U) := funext (hΦ_eq G U)
      rw [hEq]
      exact (eqv G U).bijective
    let τ_app : ∀ (G : Sheaf J A), G.cohomologyPresheaf 0 ⟶ G.obj :=
      fun G =>
        { app := fun W => AddCommGrpCat.ofHom (Φ G W.unop)
          naturality := fun {W₁ W₂} w => by
            ext x
            obtain ⟨f, rfl⟩ := Abelian.Ext.homEquiv₀.symm.surjective x
            have hmk : Abelian.Ext.homEquiv₀.symm f = Abelian.Ext.mk₀ f := rfl
            rw [hmk]
            have hmap : ((G.cohomologyPresheaf 0).map w) (Abelian.Ext.mk₀ f) =
                Abelian.Ext.mk₀ (L_free.map w.unop ≫ f) := by
              change ((Abelian.Ext.mk₀ (L_free.map w.unop)).precomp G (Nat.zero_add 0))
                (Abelian.Ext.mk₀ f) = _
              exact Abelian.Ext.mk₀_comp_mk₀ (L_free.map w.unop) f
            have h_eqv_mk₀ : ∀ {U₀ : T.Etale} (h : L_free.obj U₀ ⟶ G),
                eqv G U₀ (Abelian.Ext.mk₀ h) =
                  yonedaEquiv ((adj_free.homEquiv (yoneda.obj U₀) G) h) :=
              fun h => congrArg (fun k => yonedaEquiv ((adj_free.homEquiv (yoneda.obj _) G) k))
                (Abelian.Ext.homEquiv₀.apply_symm_apply h)
            change Φ G W₂.unop (((G.cohomologyPresheaf 0).map w) (Abelian.Ext.mk₀ f)) =
              G.obj.map w (Φ G W₁.unop (Abelian.Ext.mk₀ f))
            rw [hmap, hΦ_eq, hΦ_eq, h_eqv_mk₀, h_eqv_mk₀]
            have hNatL : (adj_free.homEquiv (yoneda.obj W₂.unop) G) (L_free.map w.unop ≫ f) =
                yoneda.map w.unop ≫ (adj_free.homEquiv (yoneda.obj W₁.unop) G) f :=
              adj_free.homEquiv_naturality_left (yoneda.map w.unop) f
            exact (congrArg yonedaEquiv hNatL).trans
              (yonedaEquiv_naturality' ((adj_free.homEquiv (yoneda.obj W₁.unop) G) f) w).symm }
    let τ : Sheaf.cohomologyPresheafFunctor J 0 ⟶ I_T :=
      { app := τ_app
        naturality := fun {G₁ G₂} φ => by
          ext W x
          obtain ⟨f, rfl⟩ := Abelian.Ext.homEquiv₀.symm.surjective x
          have hmk : Abelian.Ext.homEquiv₀.symm f = Abelian.Ext.mk₀ f := rfl
          rw [hmk]
          have hmap : (((Sheaf.cohomologyPresheafFunctor J 0).map φ).app W) (Abelian.Ext.mk₀ f) =
              Abelian.Ext.mk₀ (f ≫ φ) := by
            change ((Abelian.Ext.mk₀ φ).postcomp (L_free.obj W.unop) (Nat.add_zero 0))
              (Abelian.Ext.mk₀ f) = _
            exact Abelian.Ext.mk₀_comp_mk₀ f φ
          change Φ G₂ W.unop ((((Sheaf.cohomologyPresheafFunctor J 0).map φ).app W)
              (Abelian.Ext.mk₀ f)) =
            (φ.hom.app W) (Φ G₁ W.unop (Abelian.Ext.mk₀ f))
          rw [hmap]
          have hf₀ : ∀ {H : Sheaf J A} (h : L_free.obj W.unop ⟶ H),
              Abelian.Ext.addEquiv₀ (Abelian.Ext.mk₀ h) = h :=
            fun h => Abelian.Ext.homEquiv₀.apply_symm_apply h
          dsimp [Φ]
          rw [hf₀, hf₀]
          rfl }
    have _ : ∀ (G : Sheaf J A), IsIso (τ.app G) := by
      intro G
      have _ : ∀ (W : (T.Etale)ᵒᵖ), IsIso ((τ.app G).app W) := fun W =>
        (CategoryTheory.ConcreteCategory.isIso_iff_bijective ((τ.app G).app W)).mpr (hΦ_bij G W.unop)
      exact NatIso.isIso_of_isIso_app (τ.app G)
    have _ : IsIso τ := NatIso.isIso_of_isIso_app τ
    exact ⟨asIso τ⟩

  have hR0IsoPush : ∀ {Z₁ Z₂ : Scheme.{u}} (g : Z₁ ⟶ Z₂),
      let B_g : Z₂.Etale ⥤ Z₁.Etale :=
        (let _ : MorphismProperty.HasPullbacksAlong (@Etale) g :=
           MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
         let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) g :=
           MorphismProperty.IsStableUnderBaseChangeAlong.mk
             (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
         MorphismProperty.Over.pullback (@Etale) ⊤ g)
      let R0_g : Sheaf Z₁.smallEtaleTopology A ⥤ Sheaf Z₂.smallEtaleTopology A :=
        Sheaf.cohomologyPresheafFunctor Z₁.smallEtaleTopology 0 ⋙
          ((Functor.whiskeringLeft (Z₂.Etale)ᵒᵖ (Z₁.Etale)ᵒᵖ A).obj B_g.op ⋙
            presheafToSheaf Z₂.smallEtaleTopology A)
      ∀ (hc_g : B_g.IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology),
        let g_push := @Functor.sheafPushforwardContinuous _ _ _ _ B_g A _
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology hc_g
        Nonempty (R0_g ≅ g_push) := by
    intro Z₁ Z₂ g B_g R0_g hc_g g_push
    obtain ⟨eCoh₁⟩ := eCoh₀_exists Z₁
    let W_g := (Functor.whiskeringLeft (Z₂.Etale)ᵒᵖ (Z₁.Etale)ᵒᵖ A).obj B_g.op
    let Sh₂ := presheafToSheaf Z₂.smallEtaleTopology A
    let I₁ := sheafToPresheaf Z₁.smallEtaleTopology A
    let I₂ := sheafToPresheaf Z₂.smallEtaleTopology A
    have hInter : I₁ ⋙ W_g = g_push ⋙ I₂ := rfl
    let e₁ : R0_g ≅ I₁ ⋙ (W_g ⋙ Sh₂) := Functor.isoWhiskerRight eCoh₁ (W_g ⋙ Sh₂)
    let e₂ : I₁ ⋙ (W_g ⋙ Sh₂) ≅ (I₁ ⋙ W_g) ⋙ Sh₂ := (Functor.associator I₁ W_g Sh₂).symm
    let e₃ : (I₁ ⋙ W_g) ⋙ Sh₂ ≅ (g_push ⋙ I₂) ⋙ Sh₂ :=
      eqToIso (congrArg (· ⋙ Sh₂) hInter)
    let e₄ : (g_push ⋙ I₂) ⋙ Sh₂ ≅ g_push ⋙ (I₂ ⋙ Sh₂) := Functor.associator g_push I₂ Sh₂
    let eCounit : I₂ ⋙ Sh₂ ≅ 𝟭 (Sheaf Z₂.smallEtaleTopology A) :=
      asIso (sheafificationAdjunction Z₂.smallEtaleTopology A).counit
    let e₅ : g_push ⋙ (I₂ ⋙ Sh₂) ≅ g_push ⋙ 𝟭 _ := Functor.isoWhiskerLeft g_push eCounit
    let e₆ : g_push ⋙ 𝟭 _ ≅ g_push := Functor.rightUnitor g_push
    exact ⟨e₁ ≪≫ e₂ ≪≫ e₃ ≪≫ e₄ ≪≫ e₅ ≪≫ e₆⟩

  
  intro B_π hc hEpi F q
  let π_push := @Functor.sheafPushforwardContinuous _ _ _ _ B_π A _
    X.smallEtaleTopology Y.smallEtaleTopology hc
  let B_p : S.Etale ⥤ X.Etale :=
    (let _ : MorphismProperty.HasPullbacksAlong (@Etale) p :=
       MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
     let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) p :=
       MorphismProperty.IsStableUnderBaseChangeAlong.mk
         (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
     MorphismProperty.Over.pullback (@Etale) ⊤ p)
  let B_πp : S.Etale ⥤ Y.Etale :=
    (let _ : MorphismProperty.HasPullbacksAlong (@Etale) (π ≫ p) :=
       MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
     let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) (π ≫ p) :=
       MorphismProperty.IsStableUnderBaseChangeAlong.mk
         (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
     MorphismProperty.Over.pullback (@Etale) ⊤ (π ≫ p))

  
  let Sh_S := presheafToSheaf S.smallEtaleTopology A
  let R_p : ℕ → (Sheaf X.smallEtaleTopology A ⥤ Sheaf S.smallEtaleTopology A) :=
    fun n => Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology n ⋙
      ((Functor.whiskeringLeft (S.Etale)ᵒᵖ (X.Etale)ᵒᵖ A).obj B_p.op ⋙ Sh_S)
  let R_πp : ℕ → (Sheaf Y.smallEtaleTopology A ⥤ Sheaf S.smallEtaleTopology A) :=
    fun n => Sheaf.cohomologyPresheafFunctor Y.smallEtaleTopology n ⋙
      ((Functor.whiskeringLeft (S.Etale)ᵒᵖ (Y.Etale)ᵒᵖ A).obj B_πp.op ⋙ Sh_S)

  
  obtain ⟨α_π⟩ := hR0IsoPush π hc
  have hc_p : B_p.IsContinuous S.smallEtaleTopology X.smallEtaleTopology := (hSitePullback p).2
  have hc_πp : B_πp.IsContinuous S.smallEtaleTopology Y.smallEtaleTopology :=
    (hSitePullback (π ≫ p)).2
  obtain ⟨α_p⟩ := hR0IsoPush p hc_p
  obtain ⟨α_πp⟩ := hR0IsoPush (π ≫ p) hc_πp
  let p_push := @Functor.sheafPushforwardContinuous _ _ _ _ B_p A _
    S.smallEtaleTopology X.smallEtaleTopology hc_p
  let πp_push := @Functor.sheafPushforwardContinuous _ _ _ _ B_πp A _
    S.smallEtaleTopology Y.smallEtaleTopology hc_πp
  have hβ₀ : Nonempty (π_push ⋙ R_p 0 ≅ R_πp 0) := by
    have _ : MorphismProperty.HasPullbacksAlong (@Etale) π :=
