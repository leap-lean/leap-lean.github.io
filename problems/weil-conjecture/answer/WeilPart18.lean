    have : AlgebraicGeometry.IsClosedImmersion u₂ := by
      have : AlgebraicGeometry.IsClosedImmersion (u₂ ≫ i_D) := by
        rw [hu₂]; infer_instance
      exact AlgebraicGeometry.IsClosedImmersion.of_comp_isClosedImmersion u₂ i_D
    have : AlgebraicGeometry.IsClosedImmersion u₁₂ := by
      have : AlgebraicGeometry.IsClosedImmersion (u₁₂ ≫ i_D) := by
        rw [hu₁₂]; infer_instance
      exact AlgebraicGeometry.IsClosedImmersion.of_comp_isClosedImmersion u₁₂ i_D
    have hInj_iD : Function.Injective ⇑i_D :=
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding i_D).toIsEmbedding.injective
    have hRangeLift : ∀ {W_E : AlgebraicGeometry.Scheme.{u}} (u_E : W_E ⟶ W_D)
        (i_E : W_E ⟶ Z) (E : TopologicalSpace.Closeds ↥Z),
