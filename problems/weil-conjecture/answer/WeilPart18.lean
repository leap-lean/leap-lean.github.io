    let C_V := CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}
    let T_V : V.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 V)
        (inferInstance : AlgebraicGeometry.Etale (𝟙 V))
