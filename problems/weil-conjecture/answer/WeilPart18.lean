        let ρ_l : S_k₁ ⟶ CategoryTheory.Limits.pullback w_hom u_A := ρ.left
        have hρw : ρ_l ≫ CategoryTheory.Limits.pullback.snd w_hom u_A = 𝟙 S_k₁ := ρ.w
        let τ₀ : S_k₁ ⟶ W.left := ρ_l ≫ CategoryTheory.Limits.pullback.fst w_hom u_A
        have hτ₀_hom : τ₀ ≫ w_hom = u_A := by
          dsimp [τ₀]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
            ← CategoryTheory.Category.assoc, hρw, CategoryTheory.Category.id_comp]
        let w₀ : ↥W.left := τ₀.base pt₀
        obtain ⟨U, hU, hw₀U, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
            (X := W.left) (x := w₀) (U := ⊤) trivial
        have hr_τ : Set.range ⇑τ₀ ⊆ Set.range ⇑hU.fromSpec := by
          rw [hU.range_fromSpec]
          rintro _ ⟨z, rfl⟩
          have hz : z = pt₀ := Subsingleton.elim z pt₀
          rw [hz]
          exact hw₀U
        let B_ring : Type u := ↑(W.left.presheaf.obj (Opposite.op U))
        let τ_U : S_k₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_ring) :=
          AlgebraicGeometry.IsOpenImmersion.lift hU.fromSpec τ₀ hr_τ
        have hfac_τ : τ_U ≫ hU.fromSpec = τ₀ :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec τ₀ hr_τ
        let w_B : AlgebraicGeometry.Spec (CommRingCat.of B_ring) ⟶ S_A :=
          hU.fromSpec ≫ w_hom
        have hw_B_et : AlgebraicGeometry.Etale w_B := by
          have : AlgebraicGeometry.Etale w_hom := W.prop
          dsimp [w_B]
          infer_instance
        let f_AB : A →+* B_ring := (AlgebraicGeometry.Spec.preimage w_B).hom
        have hf_AB_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_AB) = w_B :=
          AlgebraicGeometry.Spec.map_preimage w_B
        let _ : Algebra A B_ring := f_AB.toAlgebra
        have : Algebra.Etale A B_ring := by
          rw [← RingHom.etale_algebraMap]
          change f_AB.Etale
          exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
            (hf_AB_map.symm ▸ hw_B_et)
        let φ : B_ring →+* k₁ := (AlgebraicGeometry.Spec.preimage τ_U).hom
        have hφ_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) = τ_U :=
          AlgebraicGeometry.Spec.map_preimage τ_U
        have hφ_comp : φ.comp (algebraMap A B_ring) = α_u := by
          have hspec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp f_AB)) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_u) := by
            rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
              hφ_map, hf_AB_map, hα_map]
            change τ_U ≫ hU.fromSpec ≫ w_hom = u_A
            rw [← CategoryTheory.Category.assoc, hfac_τ, hτ₀_hom]
          exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hspec)
        obtain ⟨ψ, hψ_comp, _⟩ := hLift A B_ring k₁ α_u hker_u φ hφ_comp
        let σ₀ : S_A ⟶ W.left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ hU.fromSpec
        have hσ₀_hom : σ₀ ≫ w_hom = 𝟙 S_A := by
          dsimp [σ₀]
          rw [CategoryTheory.Category.assoc]
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ w_B = 𝟙 S_A
          rw [← hf_AB_map, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : ψ.toRingHom.comp f_AB = RingHom.id A := RingHom.ext ψ.commutes
          rw [hid]
          exact AlgebraicGeometry.Spec.map_id (CommRingCat.of A)
        let σ : T_A ⟶ W := CategoryTheory.MorphismProperty.Over.homMk σ₀ hσ₀_hom trivial
        have hu_U : u_A ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom) = τ_U := by
          rw [← hα_map, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            hψ_comp, hφ_map]
        have hu_σ₀ : u_A ≫ σ₀ = τ₀ :=
          (CategoryTheory.Category.assoc u_A _ hU.fromSpec).symm.trans
            ((congrArg (· ≫ hU.fromSpec) hu_U).trans hfac_τ)
        refine ⟨σ, ?_⟩
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext
        · apply CategoryTheory.Limits.pullback.hom_ext
          · exact (h_fst_eq σ).trans hu_σ₀
          · exact (ι₀ ≫ B_u.map σ).w.trans hρw.symm
        · exact Subsingleton.elim _ _
    
    obtain ⟨hCont, hRightAdj, ⟨e_PB⟩⟩ := hPB
    let _ : B_u.IsContinuous S_A.smallEtaleTopology S_k₁.smallEtaleTopology := hCont
    let P_push := B_u.sheafPushforwardContinuous AddCommGrpCat.{u}
      S_A.smallEtaleTopology S_k₁.smallEtaleTopology
    let _ : P_push.IsRightAdjoint := hRightAdj
    let P_pull := B_u.sheafPullback AddCommGrpCat.{u}
      S_A.smallEtaleTopology S_k₁.smallEtaleTopology
    let adj_u : P_pull ⊣ P_push :=
      B_u.sheafAdjunctionContinuous AddCommGrpCat.{u}
        S_A.smallEtaleTopology S_k₁.smallEtaleTopology
    let e_hom : ∀ W : S_A.Etale, (T_A ⟶ W) ≃ (T_k₁ ⟶ B_u.obj W) :=
      fun W => Equiv.ofBijective (fun σ => ι₀ ≫ B_u.map σ) (hBij W)
    let iso_R : (prodSh S_k₁ T_k₁ hTop_k₁ ⋙ P_push) ≅ prodSh S_A T_A hTop_A :=
      CategoryTheory.NatIso.ofComponents
        (fun D =>
          { hom :=
              { hom :=
                  { app := fun W =>
                      AddCommGrpCat.ofHom
                        { toFun := fun φ σ => φ (e_hom W.unop σ)
                          map_zero' := rfl
                          map_add' := fun _ _ => rfl }
                    naturality := fun {W₁ W₂} g => by
                      apply AddCommGrpCat.ext
                      intro φ
                      funext τ
                      change φ (e_hom W₂.unop τ ≫ B_u.map g.unop) =
                        φ (e_hom W₁.unop (τ ≫ g.unop))
                      have heq : e_hom W₁.unop (τ ≫ g.unop) =
                          e_hom W₂.unop τ ≫ B_u.map g.unop := by
                        change ι₀ ≫ B_u.map (τ ≫ g.unop) = (ι₀ ≫ B_u.map τ) ≫ B_u.map g.unop
                        rw [B_u.map_comp, CategoryTheory.Category.assoc]
                      rw [heq] } }
            inv :=
              { hom :=
                  { app := fun W =>
                      AddCommGrpCat.ofHom
                        { toFun := fun ψ ρ => ψ ((e_hom W.unop).symm ρ)
                          map_zero' := rfl
                          map_add' := fun _ _ => rfl }
                    naturality := fun {W₁ W₂} g => by
                      apply AddCommGrpCat.ext
                      intro ψ
                      funext ρ
                      change ψ ((e_hom W₂.unop).symm ρ ≫ g.unop) =
                        ψ ((e_hom W₁.unop).symm (ρ ≫ B_u.map g.unop))
                      have heq : (e_hom W₁.unop).symm (ρ ≫ B_u.map g.unop) =
                          (e_hom W₂.unop).symm ρ ≫ g.unop := by
                        apply (e_hom W₁.unop).injective
                        rw [(e_hom W₁.unop).apply_symm_apply]
                        change ρ ≫ B_u.map g.unop =
                          ι₀ ≫ B_u.map ((e_hom W₂.unop).symm ρ ≫ g.unop)
                        rw [B_u.map_comp, ← CategoryTheory.Category.assoc]
                        change ρ ≫ B_u.map g.unop =
                          (e_hom W₂.unop ((e_hom W₂.unop).symm ρ)) ≫ B_u.map g.unop
                        rw [(e_hom W₂.unop).apply_symm_apply]
                      rw [heq] } }
            hom_inv_id := by
              ext W φ
              funext ρ
              change φ (e_hom W.unop ((e_hom W.unop).symm ρ)) = φ ρ
              rw [(e_hom W.unop).apply_symm_apply]
            inv_hom_id := by
              ext W ψ σ
              change ψ ((e_hom W.unop).symm (e_hom W.unop σ)) = ψ σ
              rw [(e_hom W.unop).symm_apply_apply] })
        (fun _ => by
          ext W φ
          rfl)
    let adj_pull_ev : (P_pull ⋙ evSh S_k₁ T_k₁) ⊣ prodSh S_A T_A hTop_A :=
      (adj_u.comp (adjSh S_k₁ T_k₁ hTop_k₁)).ofNatIsoRight iso_R
    let iso_ev :=
      CategoryTheory.Adjunction.leftAdjointUniq adj_pull_ev (adjSh S_A T_A hTop_A)
    let iso_sec : H_k₁.obj.obj (Opposite.op T_k₁) ≅ H_A.obj.obj (Opposite.op T_A) :=
      ((evSh S_k₁ T_k₁).mapIso e_PB).symm ≪≫ iso_ev.app H_A
    exact ⟨(CategoryTheory.Sheaf.H.equiv₀ H_k₁ hT_k₁).trans
      ((addEquivOfIso iso_sec).trans
        (CategoryTheory.Sheaf.H.equiv₀ H_A hT_A).symm)⟩

theorem weil_genFLC_of_geom_stalk_nat_card_le_generic (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Z : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine Z]
    (hIntZ : AlgebraicGeometry.IsIntegral Z)
    (hConstPB : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂) (A : AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h
        ((CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj A)
        ((CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj A))
    (hExPB : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
        (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}),
      ∃ F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u},
        WeilIsEtaleSheafPullback h F₂ F₁)
    (hCompPB : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}} (h₁ : X₁ ⟶ X₂) (h₂ : X₂ ⟶ X₃)
        (F₃ : CategoryTheory.Sheaf X₃.smallEtaleTopology AddCommGrpCat.{u})
        (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h₂ F₃ F₂ →
      (WeilIsEtaleSheafPullback h₁ F₂ F₁ ↔ WeilIsEtaleSheafPullback (h₁ ≫ h₂) F₃ F₁))
    (hShrink : ∀ (Ω₀ : Type u) [Field Ω₀] [IsAlgClosed Ω₀]
        (η : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ Z),
        DenseRange η.base →
        ∀ (W₀ : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W₀]
          (w₀ : W₀ ⟶ Z), AlgebraicGeometry.Etale w₀ →
          ∀ (η₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ W₀),
            η₀ ≫ w₀ = η →
            ∃ (U : Z.Opens) (_ : Nonempty U)
              (V : AlgebraicGeometry.Scheme.{u})
              (p : V ⟶ (U : AlgebraicGeometry.Scheme.{u}))
              (ι_V : V ⟶ W₀)
              (η_V : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ V),
              AlgebraicGeometry.IsIntegral V ∧
              AlgebraicGeometry.IsFinite p ∧
              AlgebraicGeometry.Etale p ∧
              AlgebraicGeometry.Surjective p ∧
              AlgebraicGeometry.Etale ι_V ∧
              ι_V ≫ w₀ = p ≫ U.ι ∧
              η_V ≫ ι_V = η₀ ∧
              DenseRange η_V.base)
    (Ω₀ : Type u) [Field Ω₀] [IsAlgClosed Ω₀]
    (η : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ Z)
    (hDense : DenseRange η.base)
    (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
    (hTors : ℓ • CategoryTheory.CategoryStruct.id G = 0)
    (hCard : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
        (s : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Z)
        (H_s : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of k₀)).smallEtaleTopology AddCommGrpCat.{u})
        (H_η : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)).smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback s G H_s →
      WeilIsEtaleSheafPullback η G H_η →
      Finite (H_s.H 0) ∧ Nat.card (H_s.H 0) ≤ Nat.card (H_η.H 0)) :
    WeilIsGenFiniteEtaleConstantModPrime ℓ Z G :=
by
  classical
  let _ := hIntZ
  
  have hMemEtale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (X : S.Etale) (R : CategoryTheory.Sieve X),
      R ∈ S.smallEtaleTopology X ↔
        ∃ (J : Type u) (E : J → S.Etale) (f : ∀ j : J, E j ⟶ X),
          (∀ j : J, R.arrows (f j)) ∧
          (∀ x : ↥X.left, ∃ (j : J) (y : ↥(E j).left), (f j).left.base y = x) := by
    intro S X R
    letI : Category.{u, u + 1} (CategoryTheory.MorphismProperty.Over (@AlgebraicGeometry.Etale) ⊤ S) :=
      inferInstanceAs (Category S.Etale)
    unfold AlgebraicGeometry.Scheme.smallEtaleTopology
    unfold AlgebraicGeometry.Scheme.Etale at X R ⊢
    haveI : AlgebraicGeometry.Scheme.IsJointlySurjectivePreserving (@AlgebraicGeometry.Etale) :=
      AlgebraicGeometry.Scheme.isJointlySurjectivePreserving (@AlgebraicGeometry.Etale)
    haveI : AlgebraicGeometry.Scheme.JointlySurjective
        (AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Etale)) :=
      AlgebraicGeometry.Scheme.instJointlySurjectivePrecoverage
    erw [AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology]
    constructor
    · rintro ⟨𝒰, hOver, hProp, hle⟩
      letI : AlgebraicGeometry.Scheme.Cover.Over S 𝒰 := hOver
      letI : X.left.Over S := ⟨X.hom⟩
      letI : ∀ j : 𝒰.I₀, (𝒰.X j).Over S := hOver.over
      letI : ∀ j : 𝒰.I₀, (𝒰.f j).IsOver S := hOver.isOver_map
      refine ⟨𝒰.I₀,
        fun j => (𝒰.X j).asOverProp S (hProp j),
        fun j => (𝒰.f j).asOverProp S (hX := hProp j) (hY := X.prop),
        fun j => @hle _ _ (CategoryTheory.Presieve.ofArrows.mk j), ?_⟩
      intro x
      obtain ⟨y, hy⟩ := 𝒰.covers x
      exact ⟨𝒰.idx x, y, hy⟩
    · rintro ⟨J, E, f, hfR, hcov⟩
      have hf_et : ∀ j : J, AlgebraicGeometry.Etale (f j).left := fun j =>
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          (f j).left X.hom X.prop
          ((CategoryTheory.MorphismProperty.Over.w (f j)).symm ▸ (E j).prop)
      letI : X.left.Over S := ⟨X.hom⟩
      let 𝒰 : AlgebraicGeometry.Scheme.Cover
          (AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Etale)) X.left :=
        AlgebraicGeometry.Scheme.Cover.mkOfCovers J (fun j => (E j).left)
          (fun j => (f j).left) hcov hf_et
      letI : ∀ j : 𝒰.I₀, (𝒰.X j).Over S := fun j => ⟨(E j).hom⟩
      letI : ∀ j : 𝒰.I₀, (𝒰.f j).IsOver S :=
        fun j => ⟨CategoryTheory.MorphismProperty.Over.w (f j)⟩
      let hOver : AlgebraicGeometry.Scheme.Cover.Over S 𝒰 :=
        { «over» := inferInstance, isOver_map := inferInstance }
      letI : AlgebraicGeometry.Scheme.Cover.Over S 𝒰 := hOver
      have hProp : ∀ j : 𝒰.I₀, AlgebraicGeometry.Etale (𝒰.X j ↘ S) := fun j => (E j).prop
      refine ⟨𝒰, hOver, hProp, ?_⟩
      rintro W g ⟨j⟩
      let iso_hom : (𝒰.X j).asOverProp S (hProp j) ⟶ E j :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 (E j).left) (Category.id_comp (E j).hom)
      have h_fac : iso_hom ≫ f j =
          (𝒰.f j).asOverProp S (hX := hProp j) (hY := X.prop) := by
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext
        · exact Category.id_comp (f j).left
        · exact Subsingleton.elim _ _
      rw [← h_fac]
      exact R.downward_closed (hfR j) iso_hom

  
  have hEtaleSec : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (W : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥W]
      (w : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)),
      AlgebraicGeometry.Etale w →
      ∃ σ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ W,
        σ ≫ w = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) := by
    intro K _ _ W hneW w hw
    obtain ⟨w₀⟩ := hneW
    obtain ⟨V_aff, hAffV, hw₀_V, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := w₀) (U := (⊤ : W.Opens)) trivial
    let R_V : CommRingCat.{u} := W.presheaf.obj (Opposite.op V_aff)
    let j_B : AlgebraicGeometry.Spec R_V ⟶ W := hAffV.isoSpec.inv ≫ V_aff.ι
    haveI : AlgebraicGeometry.Etale w := hw
    have hw_spec : AlgebraicGeometry.Etale (j_B ≫ w) := by
      dsimp [j_B]
      infer_instance
    let p₀ : PrimeSpectrum ↥R_V := hAffV.isoSpec.hom.base ⟨w₀, hw₀_V⟩
    haveI : Nontrivial ↥R_V :=
      nontrivial_of_ne (0 : ↥R_V) 1 (fun h01 =>
        p₀.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr (h01 ▸ p₀.asIdeal.zero_mem)))
    let φ_hom : CommRingCat.of K ⟶ R_V := AlgebraicGeometry.Spec.preimage (j_B ≫ w)
    have hφ_map : AlgebraicGeometry.Spec.map φ_hom = j_B ≫ w :=
      AlgebraicGeometry.Spec.map_preimage (j_B ≫ w)
    letI : Algebra K ↥R_V := φ_hom.hom.toAlgebra
    haveI : Algebra.Etale K ↥R_V := by
      rw [← RingHom.etale_algebraMap]
      change φ_hom.hom.Etale
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hφ_map.symm ▸ hw_spec)
    obtain ⟨I, hFinI, L, hFieldL, hAlgKL, Θ, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K ↥R_V).mp inferInstance
    letI : Finite I := hFinI
    letI : ∀ i, Field (L i) := hFieldL
    letI : ∀ i, Algebra K (L i) := hAlgKL
    haveI : Nontrivial (∀ i : I, L i) :=
      ⟨Θ 0, Θ 1, fun h => zero_ne_one (Θ.injective h)⟩
    have hneI : Nonempty I := by
      by_contra! hEmpty
      exact false_of_nontrivial_of_subsingleton (∀ i : I, L i)
    obtain ⟨i₀⟩ := hneI
    haveI : Algebra.IsSeparable K (L i₀) := (hFinSep i₀).2
    let e_L : K ≃+* L i₀ :=
      RingEquiv.ofBijective (algebraMap K (L i₀))
        ⟨RingHom.injective _, IsSepClosed.algebraMap_surjective K (L i₀)⟩
    let χ : R_V ⟶ CommRingCat.of K :=
      CommRingCat.ofHom (e_L.symm.toRingHom.comp ((Pi.evalRingHom L i₀).comp Θ.toRingHom))
    have hφχ : φ_hom ≫ χ = 𝟙 (CommRingCat.of K) := by
      ext c
      change e_L.symm ((Θ (algebraMap K ↥R_V c)) i₀) = c
      rw [Θ.commutes]
      exact e_L.symm_apply_apply c
    refine ⟨AlgebraicGeometry.Spec.map χ ≫ j_B, ?_⟩
    rw [Category.assoc, ← hφ_map, ← AlgebraicGeometry.Spec.map_comp, hφχ,
      AlgebraicGeometry.Spec.map_id]

  
  have hSheafZero : ∀ {C : Type (u + 1)} [Category.{u} C]
      (J : CategoryTheory.GrothendieckTopology C)
      (ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u})
      (W₁ : C) (S : CategoryTheory.Sieve W₁),
      S ∈ J W₁ →
      ∀ (s : ↥(ℱ.obj.obj (Opposite.op W₁))),
        (∀ {Y₁ : C} (f : Y₁ ⟶ W₁), S.arrows f → (ℱ.obj.map f.op) s = 0) →
        s = 0 := by
    intro C _ J ℱ W₁ S hS s hf0
    let Eℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let g₁ : Eℤ ⟶ ℱ.obj.obj (Opposite.op W₁) :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • s
          map_zero' := zero_zsmul s
          map_add' := fun a b => add_zsmul s a.down b.down }
    let g₂ : Eℤ ⟶ ℱ.obj.obj (Opposite.op W₁) := 0
    let fam : CategoryTheory.Presieve.FamilyOfElements
        (ℱ.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Eℤ)) S.arrows :=
      fun Y₁ _ _ => (0 : Eℤ ⟶ ℱ.obj.obj (Opposite.op Y₁))
    have hg₁ : fam.IsAmalgamation g₁ := by
      intro Y₁ f hf
      dsimp [fam]
      ext ⟨z⟩
      change (ℱ.obj.map f.op) (z • s) = 0
      rw [map_zsmul, hf0 f hf, zsmul_zero]
    have hg₂ : fam.IsAmalgamation g₂ := by
      intro Y₁ f _
      dsimp [fam, g₂]
      exact Limits.zero_comp
    have hEq : g₁ = g₂ := (ℱ.property Eℤ S hS).isSeparatedFor fam g₁ g₂ hg₁ hg₂
    simpa [g₁, g₂] using congrArg (fun m : Eℤ ⟶ _ => m (ULift.up (1 : ℤ))) hEq

  
  have hGermPres : ∀ (Y : AlgebraicGeometry.Scheme.{u})
      (K : Type u) [Field K] [IsAlgClosed K]
      (u : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ Y),
      (∀ (A : AddCommGrpCat.{u}),
        Nonempty ((((CategoryTheory.constantSheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology
