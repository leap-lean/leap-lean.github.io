        Limits.isLimitForkMapOfIsLimit' W_j h0_j_pre hLim_j_pre
      have hLim_push_sh :
          Limits.IsLimit (Limits.KernelFork.ofι ((μ_push j).map ι_j_sh) h0_push_sh) :=
        sheafKernelForkIsLimit ((μ_push j).map ι_j_sh) ((μ_push j).map η_j_sh)
          h0_push_sh h0_push_pre hLim_push_pre
      let SC_j : ShortComplex (Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}) :=
        ShortComplex.mk ((μ_push j).map ι_j_sh) ((μ_push j).map η_j_sh) h0_push_sh
      have hSE_j : SC_j.ShortExact := by
        have _ : Mono SC_j.f := Limits.mono_of_isLimit_fork hLim_push_sh
        have _ : Epi SC_j.g := inferInstance
        exact { exact := ShortComplex.exact_of_f_is_kernel SC_j hLim_push_sh }
      have hTor_mid_j : ℓ • 𝟙 SC_j.X₂ = 0 := by
        apply (sheafToPresheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}).map_injective
        rw [sheaf_map_nsmul_id]
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.ext
        intro g
        let g_lc : LocallyConstant ↥((B_μ j).obj (Opposite.unop U)).left ↥A_ℓ := g
        apply LocallyConstant.ext
        intro c'
        change ℓ • g_lc c' = 0
        exact hA_tor (g_lc c')
      have hP_mid_j : P SC_j.X₂ := by
        obtain ⟨e_R0C⟩ :=
          higherDirectImage_zero_iso_pushforward (μ j) (hc_μ j) (weilEtaleTorsionSheaf (C j) ℓ)
        obtain ⟨e_torC⟩ := constSheaf_iso_locConst (C j) A_ℓ
        exact P_of_iso (((μ_push j).mapIso e_torC.symm).trans e_R0C.symm) (hPC j)
      have hP_right_j : P SC_j.X₃ := by
        let hc_comp := etaleOverPullback_isContinuous (i_E j ≫ μ j)
        obtain ⟨e_R0E⟩ :=
          higherDirectImage_zero_iso_pushforward (i_E j ≫ μ j) hc_comp
            (weilEtaleTorsionSheaf (E_sch j) ℓ)
        obtain ⟨e_comp⟩ :=
          pushforward_comp_iso (i_E j) (μ j) hc_Ej (hc_μ j) hc_comp
            (weilEtaleTorsionSheaf (E_sch j) ℓ)
        obtain ⟨e_torE⟩ := constSheaf_iso_locConst (E_sch j) A_ℓ
        exact P_of_iso
          (((μ_push j).mapIso (iEj_push.mapIso e_torE.symm)).trans
            (e_comp.symm.trans e_R0E.symm))
          (hPE j)
      exact (hExact SC_j hSE_j hTor_mid_j).2 ⟨hP_mid_j, hP_right_j⟩
    
    let _ : Limits.HasFiniteBiproducts (Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}) :=
      Abelian.hasFiniteBiproducts
    have hBiprod_prop : ∀ (n : ℕ)
        (G : Fin n → Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ j : Fin n, ℓ • 𝟙 (G j) = 0) →
        (∀ j : Fin n, P (G j)) →
        (ℓ • 𝟙 (⨁ G) = 0) ∧ P (⨁ G) := by
      intro n
      induction n with
      | zero =>
        intro G _ _
        have hid0 : 𝟙 (⨁ G) = 0 := by
          rw [← Limits.biproduct.total]
          simp
        have hZ : Limits.IsZero (⨁ G) := by
          rw [Limits.IsZero.iff_id_eq_zero]
          exact hid0
        refine ⟨?_, hZero (⨁ G) hZ⟩
        rw [hid0, smul_zero]
      | succ n ih =>
        intro G hTorG hPG
        let G' : Fin n → Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u} := fun k => G k.succ
        obtain ⟨hTorG', hPG'⟩ := ih G' (fun k => hTorG k.succ) (fun k => hPG k.succ)
        let B_bin := G 0 ⊞ (⨁ G')
        have hTor_bin : ℓ • 𝟙 B_bin = 0 := by
          rw [← Limits.biprod.total, smul_add,
            ← Preadditive.nsmul_comp, ← Preadditive.nsmul_comp]
          have h1 : ℓ • (Limits.biprod.fst : B_bin ⟶ G 0) =
              Limits.biprod.fst ≫ (ℓ • 𝟙 (G 0)) := by
            rw [Preadditive.comp_nsmul, Category.comp_id]
          have h2 : ℓ • (Limits.biprod.snd : B_bin ⟶ ⨁ G') =
              Limits.biprod.snd ≫ (ℓ • 𝟙 (⨁ G')) := by
            rw [Preadditive.comp_nsmul, Category.comp_id]
          rw [h1, h2, hTorG 0, hTorG', Limits.comp_zero, Limits.comp_zero,
            Limits.zero_comp, Limits.zero_comp, add_zero]
        have hSE_bin : (ShortComplex.mk
            (Limits.biprod.inl : G 0 ⟶ B_bin)
            (Limits.biprod.snd : B_bin ⟶ ⨁ G')
            Limits.biprod.inl_snd).ShortExact :=
          (ShortComplex.Splitting.ofHasBinaryBiproduct (G 0) (⨁ G')).shortExact
        have hP_bin : P B_bin :=
          (hExact _ hSE_bin hTor_bin).1 ⟨hPG 0, hPG'⟩
        let φ_hom : (⨁ G) ⟶ B_bin :=
          Limits.biprod.lift (Limits.biproduct.π G 0)
            (Limits.biproduct.lift fun k : Fin n => Limits.biproduct.π G k.succ)
        let φ_inv : B_bin ⟶ (⨁ G) :=
          Limits.biprod.desc (Limits.biproduct.ι G 0)
            (Limits.biproduct.desc fun k : Fin n => Limits.biproduct.ι G k.succ)
        have hφ_hom_inv : φ_hom ≫ φ_inv = 𝟙 (⨁ G) := by
          dsimp [φ_hom, φ_inv]
          rw [Limits.biprod.lift_desc, Limits.biproduct.lift_desc,
            ← Limits.biproduct.total, Fin.sum_univ_succ]
        have hφ_inv_hom : φ_inv ≫ φ_hom = 𝟙 B_bin := by
          apply Limits.biprod.hom_ext'
          · apply Limits.biprod.hom_ext
            · dsimp [φ_hom, φ_inv, B_bin]
              simp only [Category.assoc]
              rw [Limits.biprod.inl_desc_assoc, Limits.biprod.lift_fst,
                Limits.biproduct.ι_π_self, Category.id_comp, Limits.biprod.inl_fst]
            · apply Limits.biproduct.hom_ext
              intro k
              dsimp [φ_hom, φ_inv, B_bin]
              simp only [Category.assoc]
              rw [Limits.biprod.inl_desc_assoc,
                Limits.biprod.lift_snd_assoc, Limits.biproduct.lift_π,
                Category.id_comp, Limits.biprod.inl_snd_assoc, Limits.zero_comp]
              exact Limits.biproduct.ι_π_ne G (Fin.succ_ne_zero k).symm
          · apply Limits.biprod.hom_ext
            · apply Limits.biproduct.hom_ext'
              intro k
              dsimp [φ_hom, φ_inv, B_bin]
              simp only [Category.assoc]
              rw [Limits.biprod.inr_desc_assoc, Limits.biproduct.ι_desc_assoc,
                Limits.biprod.lift_fst, Category.id_comp, Limits.biprod.inr_fst, Limits.comp_zero]
              exact Limits.biproduct.ι_π_ne G (Fin.succ_ne_zero k)
            · apply Limits.biproduct.hom_ext'
              intro k₁
              apply Limits.biproduct.hom_ext
              intro k₂
              dsimp [φ_hom, φ_inv, B_bin]
              simp only [Category.assoc]
              rw [Limits.biprod.inr_desc_assoc,
                Limits.biproduct.ι_desc_assoc, Limits.biprod.lift_snd_assoc,
                Limits.biproduct.lift_π, Category.id_comp, Limits.biprod.inr_snd_assoc]
              by_cases hk : k₁ = k₂
              · subst hk
                rw [Limits.biproduct.ι_π_self, Limits.biproduct.ι_π_self]
              · rw [Limits.biproduct.ι_π_ne G (Fin.succ_inj.ne.mpr hk),
                  Limits.biproduct.ι_π_ne G' hk]
        let e_split : (⨁ G) ≅ B_bin :=
          { hom := φ_hom, inv := φ_inv, hom_inv_id := hφ_hom_inv, inv_hom_id := hφ_inv_hom }
        refine ⟨?_, P_of_iso e_split hP_bin⟩
        calc
          ℓ • 𝟙 (⨁ G) = ℓ • (e_split.hom ≫ 𝟙 B_bin ≫ e_split.inv) := by
            rw [Category.id_comp, e_split.hom_inv_id]
          _ = e_split.hom ≫ (ℓ • 𝟙 B_bin) ≫ e_split.inv := by
            rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul]
          _ = 0 := by rw [hTor_bin, Limits.zero_comp, Limits.comp_zero]
    
    obtain ⟨proj_pre, incl_pre, h_id_pre, h_orth_pre, h_sum_pre⟩ :=
      conductor_excision_biproduct_decomp Y₀ W i_W s C μ hFin_μ U_comp
        hUniv hU_sub hCompl_sub hDisj hEmpty_pre hIso A_ℓ
    let G_comp : Fin s → Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u} :=
      fun j => (μ_push j).obj (K_Cj j)
    let proj_sh : ∀ j : Fin s, K_Y₀W ⟶ G_comp j := fun j => ObjectProperty.homMk (proj_pre j)
    let incl_sh : ∀ j : Fin s, G_comp j ⟶ K_Y₀W := fun j => ObjectProperty.homMk (incl_pre j)
    let ψ_hom : K_Y₀W ⟶ ⨁ G_comp := Limits.biproduct.lift proj_sh
    let ψ_inv : (⨁ G_comp) ⟶ K_Y₀W := Limits.biproduct.desc incl_sh
    have hψ_hom_inv : ψ_hom ≫ ψ_inv = 𝟙 K_Y₀W := by
      dsimp [ψ_hom, ψ_inv]
      rw [Limits.biproduct.lift_desc]
      apply (sheafToPresheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}).map_injective
      have h_map_sum : ∀ (M : Finset (Fin s)),
          (sheafToPresheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}).map
            (M.sum fun j => proj_sh j ≫ incl_sh j) =
            M.sum (fun j => proj_pre j ≫ incl_pre j) := by
        intro M
        induction M using Finset.cons_induction with
        | empty => rfl
        | cons a M ha ih =>
          rw [Finset.sum_cons, Finset.sum_cons]
          exact congrArg ((proj_pre a ≫ incl_pre a) + ·) ih
      rw [h_map_sum Finset.univ]
      exact h_sum_pre
    have hψ_inv_hom : ψ_inv ≫ ψ_hom = 𝟙 (⨁ G_comp) := by
      apply Limits.biproduct.hom_ext'
      intro i
      apply Limits.biproduct.hom_ext
      intro j
      dsimp [ψ_hom, ψ_inv]
      simp only [Category.assoc]
      rw [Limits.biproduct.ι_desc_assoc, Limits.biproduct.lift_π, Category.id_comp]
      by_cases hij : i = j
      · subst hij
        rw [Limits.biproduct.ι_π_self]
        apply (sheafToPresheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}).map_injective
        exact h_id_pre i
      · rw [Limits.biproduct.ι_π_ne G_comp hij]
        apply (sheafToPresheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}).map_injective
        exact h_orth_pre i j hij
    let e_K : K_Y₀W ≅ ⨁ G_comp :=
      { hom := ψ_hom, inv := ψ_inv, hom_inv_id := hψ_hom_inv, inv_hom_id := hψ_inv_hom }
    have hP_KY₀W : P K_Y₀W :=
      P_of_iso e_K ((hBiprod_prop s G_comp hTor_pushK hP_pushK).2)
    have hP_LY₀ : P L_Y₀ :=
      (hExact SC_W hSE_W hTor_LY₀).1 ⟨hP_KY₀W, hP_iWLW⟩
    obtain ⟨e_torY₀⟩ := constSheaf_iso_locConst Y₀ A_ℓ
    exact P_of_iso e_torY₀ hP_LY₀

theorem weil_etale_finite_pushforward_comp_and_conductor_excision : (∀ (Y X S : AlgebraicGeometry.Scheme.{u}) (π : Y ⟶ X)
        [AlgebraicGeometry.IsFinite π] (p : X ⟶ S)
        (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      Nonempty (weilEtaleHigherDirectImage p q (weilEtaleHigherDirectImage π 0 F) ≅
        weilEtaleHigherDirectImage (π ≫ p) q F)) ∧
    (∀ (Y₀ Y : AlgebraicGeometry.Scheme.{u}) (i : Y₀ ⟶ Y)
        [AlgebraicGeometry.IsClosedImmersion i] [AlgebraicGeometry.Surjective i] (m : ℕ),
      Nonempty (weilEtaleHigherDirectImage i 0 (weilEtaleTorsionSheaf Y₀ m) ≅
        weilEtaleTorsionSheaf Y m)) ∧
    (∀ (ℓ : ℕ) (Y₀ W : AlgebraicGeometry.Scheme.{u}) (i_W : W ⟶ Y₀)
        [AlgebraicGeometry.IsClosedImmersion i_W]
        (s : ℕ) (C : Fin s → AlgebraicGeometry.Scheme.{u})
        (μ : ∀ j : Fin s, C j ⟶ Y₀)
        (_ : ∀ j : Fin s, AlgebraicGeometry.IsFinite (μ j))
        (U_comp : Fin s → Y₀.Opens),
      (⋃ j : Fin s, Set.range (μ j).base) = Set.univ →
      (∀ j : Fin s, (U_comp j : Set Y₀) ⊆ (Set.range i_W.base)ᶜ) →
      ((Set.range i_W.base)ᶜ : Set Y₀) ⊆ (⋃ j : Fin s, (U_comp j : Set Y₀)) →
      (∀ i j : Fin s, i ≠ j → Disjoint (U_comp i) (U_comp j)) →
      (∀ i j : Fin s, i ≠ j → ((μ j).base) ⁻¹' (U_comp i : Set Y₀) = ∅) →
      (∀ j : Fin s, CategoryTheory.IsIso ((μ j) ∣_ (U_comp j))) →
      ∀ (P : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u} → Prop),
        (∀ F, CategoryTheory.Limits.IsZero F → P F) →
        (∀ F₁ F₂ (i : F₁ ⟶ F₂) (r : F₂ ⟶ F₁), i ≫ r = 𝟙 F₁ → P F₂ → P F₁) →
        (∀ (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u})),
            SC.ShortExact → ℓ • 𝟙 SC.X₂ = 0 →
            ((P SC.X₁ ∧ P SC.X₃ → P SC.X₂) ∧ (P SC.X₂ ∧ P SC.X₃ → P SC.X₁))) →
        P (weilEtaleHigherDirectImage i_W 0 (weilEtaleTorsionSheaf W ℓ)) →
        (∀ j : Fin s, P (weilEtaleHigherDirectImage (μ j) 0 (weilEtaleTorsionSheaf (C j) ℓ))) →
        (∀ j : Fin s, P (weilEtaleHigherDirectImage
          (CategoryTheory.Limits.pullback.fst (μ j) i_W ≫ μ j) 0
          (weilEtaleTorsionSheaf (CategoryTheory.Limits.pullback (μ j) i_W) ℓ))) →
        P (weilEtaleTorsionSheaf Y₀ ℓ)) :=
by
  classical
  have mem_smallEtaleTopology_iff : ∀ {T : Scheme.{u}} (U : T.Etale) (S : Sieve U),
      S ∈ T.smallEtaleTopology U ↔
        ∀ x : ↥U.left, ∃ (V : T.Etale) (f : V ⟶ U) (y : ↥V.left),
          S.arrows f ∧ Etale f.left ∧ f.left.base y = x := by
    intro T U S
    let P_et : MorphismProperty Scheme.{u} := @Etale
    have h_gen : ∀ (U₀ : P_et.Over ⊤ T) (S₀ : Sieve U₀),
        S₀ ∈ (Scheme.smallGrothendieckTopology (S := T) P_et) U₀ ↔
          ∀ x : ↥U₀.left, ∃ (Y₀ : P_et.Over ⊤ T) (f : Y₀ ⟶ U₀) (y : ↥Y₀.left),
            S₀.arrows f ∧ P_et f.left ∧ f.left.base y = x := by
      intro U₀ S₀
      rw [Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology (P := P_et) (S := T)]
      · exact Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U₀ S₀
      · exact le_refl P_et
    exact h_gen U S
  have etaleOverPullback_isContinuous : ∀ {Y X : Scheme.{u}} (π : Y ⟶ X),
      let B_π : X.Etale ⥤ Y.Etale :=
        (let _ : MorphismProperty.HasPullbacksAlong (@Etale) π :=
          MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
         let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) π :=
          MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
         MorphismProperty.Over.pullback (@Etale) ⊤ π)
      B_π.IsContinuous X.smallEtaleTopology Y.smallEtaleTopology := by
    intro Y X π
    let P_et : MorphismProperty Scheme.{u} := @Etale
    let _ : MorphismProperty.HasPullbacksAlong P_et π :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong P_et π :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : X.Etale ⥤ Y.Etale := MorphismProperty.Over.pullback P_et ⊤ π
    change B.IsContinuous X.smallEtaleTopology Y.smallEtaleTopology
    apply Functor.isContinuous_of_coverPreserving
    · refine CompatiblePreserving.mk ?_
      intro ℱ Z T x hx Y₁ Y₂ W f₁ f₂ g₁ g₂ hg₁ hg₂ hEq
      have _ : Etale Y₁.hom := Y₁.prop
      have _ : Etale Y₂.hom := Y₂.prop
      have _ : Etale Z.hom := Z.prop
      have _ : Etale g₂.left :=
        MorphismProperty.of_postcomp P_et g₂.left Z.hom Z.prop
          ((MorphismProperty.Over.w g₂).symm ▸ Y₂.prop)
      have hEt_P : P_et (Limits.pullback.fst g₁.left g₂.left ≫ Y₁.hom) := by
        change Etale (Limits.pullback.fst g₁.left g₂.left ≫ Y₁.hom)
        infer_instance
      let P : X.Etale :=
        MorphismProperty.Over.mk (P := P_et) ⊤ (Limits.pullback.fst g₁.left g₂.left ≫ Y₁.hom) hEt_P
      let p₁ : P ⟶ Y₁ :=
        MorphismProperty.Over.homMk (Limits.pullback.fst g₁.left g₂.left) rfl trivial
      let p₂ : P ⟶ Y₂ :=
        MorphismProperty.Over.homMk (Limits.pullback.snd g₁.left g₂.left)
          ((congrArg (Limits.pullback.snd g₁.left g₂.left ≫ ·) (MorphismProperty.Over.w g₂).symm).trans
            ((Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ Z.hom) Limits.pullback.condition.symm).trans
                ((Category.assoc _ _ _).trans
                  (congrArg (Limits.pullback.fst g₁.left g₂.left ≫ ·) (MorphismProperty.Over.w g₁))))))
          trivial
      have hp_cond : p₁ ≫ g₁ = p₂ ≫ g₂ :=
        MorphismProperty.Over.Hom.ext Limits.pullback.condition
      have hB_fst : ∀ {A B₀ : X.Etale} (u : A ⟶ B₀),
          (B.map u).left ≫ Limits.pullback.fst B₀.hom π =
            Limits.pullback.fst A.hom π ≫ u.left := by
        intro A B₀ u
        dsimp [B]
        exact Limits.pullback.lift_fst _ _ _
      have h_w_z : (f₁.left ≫ Limits.pullback.fst Y₁.hom π) ≫ g₁.left =
          (f₂.left ≫ Limits.pullback.fst Y₂.hom π) ≫ g₂.left := by
        have h1 : (f₁ ≫ B.map g₁).left ≫ Limits.pullback.fst Z.hom π =
            (f₂ ≫ B.map g₂).left ≫ Limits.pullback.fst Z.hom π :=
          congrArg (fun k => ((Scheme.Etale.forget Y).map k).left ≫ Limits.pullback.fst Z.hom π) hEq
        have h2 : ∀ {A : X.Etale} (f : W ⟶ B.obj A) (g : A ⟶ Z),
