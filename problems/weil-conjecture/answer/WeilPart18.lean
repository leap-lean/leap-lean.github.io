        change q_h (μ_h (r ⊗ₜ[R] (1 : B))) = algebraMap R_h D_h (ρ r)
        have h1 : μ_h (r ⊗ₜ[R] (1 : B)) = (ρ r) ⊗ₜ[R] (1 : B) := by
