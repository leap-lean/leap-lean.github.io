        have hf₁₂ : ∀ w, f₁ (q₁_map E w) = f₂ (q₂_map E w) :=
          fun w => congrArg
            (fun (m : 𝒢 ⟶ ℱ₁₂) => toLC₁₂ E (m.hom.app (Opposite.op E) x) w) hk_eq
        let fn : ↥((Fgt W_D).obj E).left → ↥A_ℓ := fun y =>
          if h : y ∈ Set.range ⇑(p₁_of E) then f₁ h.choose
          else f₂ ((hCov_E E y).resolve_left h).choose
        have hfn₁ : ∀ x₁, fn (p₁_of E x₁) = f₁ x₁ := by
          intro x₁
          have h : p₁_of E x₁ ∈ Set.range ⇑(p₁_of E) := ⟨x₁, rfl⟩
          dsimp [fn]
          simp only [h, ↓reduceDIte]
          exact congrArg f₁ (hEmb₁.toIsEmbedding.injective h.choose_spec)
        have hfn₂ : ∀ x₂, fn (p₂_of E x₂) = f₂ x₂ := by
          intro x₂
          dsimp [fn]
          split_ifs with h
          · have hmem : p₂_of E x₂ ∈ Set.range ⇑(p₁_of E) ∩ Set.range ⇑(p₂_of E) :=
              ⟨h, ⟨x₂, rfl⟩⟩
            rw [hInter_E E] at hmem
            obtain ⟨w, hw⟩ := hmem
            have hq₁ : p₁_of E (q₁_map E w) = p₂_of E x₂ := by
              have hfst : (q₁_map E ≫ p₁_of E) w = p₁₂_of E w :=
                congrArg (fun (m : _ ⟶ ((Fgt W_D).obj E).left) => m w)
                  (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              exact hfst.trans hw
            have hq₂ : p₂_of E (q₂_map E w) = p₂_of E x₂ := by
              have hfst : (q₂_map E ≫ p₂_of E) w = p₁₂_of E w :=
                congrArg (fun (m : _ ⟶ ((Fgt W_D).obj E).left) => m w)
                  (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              exact hfst.trans hw
            have hc₁ : h.choose = q₁_map E w :=
              hEmb₁.toIsEmbedding.injective (h.choose_spec.trans hq₁.symm)
            have hc₂ : q₂_map E w = x₂ :=
              hEmb₂.toIsEmbedding.injective hq₂
            rw [hc₁, hf₁₂ w, hc₂]
          · have h' := (hCov_E E (p₂_of E x₂)).resolve_left h
            exact congrArg f₂ (hEmb₂.toIsEmbedding.injective h'.choose_spec)
        have hLC : IsLocallyConstant fn := by
          rw [IsLocallyConstant.iff_isOpen_fiber]
          intro a
          rw [← compl_compl (fn ⁻¹' {a}), isOpen_compl_iff]
          have hCompl : (fn ⁻¹' {a})ᶜ =
              ⇑(p₁_of E) '' (f₁ ⁻¹' {a})ᶜ ∪ ⇑(p₂_of E) '' (f₂ ⁻¹' {a})ᶜ := by
            ext y
            simp only [Set.mem_compl_iff, Set.mem_preimage, Set.mem_singleton_iff,
              Set.mem_union, Set.mem_image]
            constructor
            · intro hna
              rcases hCov_E E y with ⟨x₁, rfl⟩ | ⟨x₂, rfl⟩
              · left
                refine ⟨x₁, ?_, rfl⟩
                rwa [← hfn₁ x₁]
              · right
                refine ⟨x₂, ?_, rfl⟩
                rwa [← hfn₂ x₂]
            · rintro (⟨x₁, hx₁, rfl⟩ | ⟨x₂, hx₂, rfl⟩)
              · rwa [hfn₁ x₁]
              · rwa [hfn₂ x₂]
          rw [hCompl]
          exact (hEmb₁.isClosedMap _ (f₁.isLocallyConstant.isOpen_fiber a).isClosed_compl).union
            (hEmb₂.isClosedMap _ (f₂.isLocallyConstant.isOpen_fiber a).isClosed_compl)
        exact ⟨⟨fn, hLC⟩, hfn₁, hfn₂⟩
      let l_fn : ∀ (E : W_D.Etale), ↥(𝒢.obj.obj (Opposite.op E)) →
          LocallyConstant ↥((Fgt W_D).obj E).left ↥A_ℓ :=
        fun E x => (hPaste E x).choose
      have hl₁ : ∀ (E : W_D.Etale) (x : ↥(𝒢.obj.obj (Opposite.op E))) (x₁),
          (l_fn E x) (p₁_of E x₁) = toLC₁ E (k₁.hom.app (Opposite.op E) x) x₁ :=
        fun E x => (hPaste E x).choose_spec.1
      have hl₂ : ∀ (E : W_D.Etale) (x : ↥(𝒢.obj.obj (Opposite.op E))) (x₂),
          (l_fn E x) (p₂_of E x₂) = toLC₂ E (k₂.hom.app (Opposite.op E) x) x₂ :=
        fun E x => (hPaste E x).choose_spec.2
      let l_pre : 𝒢.obj ⟶ (locPresheaf W_D) :=
        { app := fun E => AddCommGrpCat.ofHom
            { toFun := l_fn E.unop
              map_zero' := LocallyConstant.ext fun y => by
                rcases hCov_E E.unop y with ⟨x₁, rfl⟩ | ⟨x₂, rfl⟩
                · rw [hl₁, map_zero]; rfl
                · rw [hl₂, map_zero]; rfl
              map_add' := fun x x' => LocallyConstant.ext fun y => by
                rcases hCov_E E.unop y with ⟨x₁, rfl⟩ | ⟨x₂, rfl⟩
                · change l_fn E.unop (x + x') _ = l_fn E.unop x _ + l_fn E.unop x' _
                  rw [hl₁, hl₁, hl₁, map_add]; rfl
                · change l_fn E.unop (x + x') _ = l_fn E.unop x _ + l_fn E.unop x' _
                  rw [hl₂, hl₂, hl₂, map_add]; rfl }
          naturality := fun {E₁ E₂} g =>
            AddCommGrpCat.ext fun x => LocallyConstant.ext fun y => by
              dsimp [locPresheaf]
              rcases hCov_E E₂.unop y with ⟨x₁, rfl⟩ | ⟨x₂, rfl⟩
              · rw [hl₁]
                have hnat₁ : toLC₁ E₂.unop (k₁.hom.app E₂ (𝒢.obj.map g x)) x₁ =
                    toLC₁ E₁.unop (k₁.hom.app E₁ x)
                      (((Fgt W₁).map ((weilCompEtaleSitePullback u₁).map g.unop)).left x₁) :=
                  congrArg
                    (fun (m : 𝒢.obj.obj E₁ ⟶ ℱ₁.obj.obj E₂) => toLC₁ E₂.unop (m x) x₁)
                    (k₁.hom.naturality g)
                rw [hnat₁]
                have hfst : (p₁_of E₂.unop ≫ ((Fgt W_D).map g.unop).left) x₁ =
                    p₁_of E₁.unop
                      (((Fgt W₁).map ((weilCompEtaleSitePullback u₁).map g.unop)).left x₁) :=
                  congrArg (fun (m : _ ⟶ ((Fgt W_D).obj E₁.unop).left) => m x₁)
                    (hB_fst u₁ g.unop).symm
                exact (hl₁ E₁.unop x
                  (((Fgt W₁).map ((weilCompEtaleSitePullback u₁).map g.unop)).left x₁)).symm.trans
                  (congrArg (l_fn E₁.unop x) hfst.symm)
              · rw [hl₂]
                have hnat₂ : toLC₂ E₂.unop (k₂.hom.app E₂ (𝒢.obj.map g x)) x₂ =
                    toLC₂ E₁.unop (k₂.hom.app E₁ x)
                      (((Fgt W₂).map ((weilCompEtaleSitePullback u₂).map g.unop)).left x₂) :=
                  congrArg
                    (fun (m : 𝒢.obj.obj E₁ ⟶ ℱ₂.obj.obj E₂) => toLC₂ E₂.unop (m x) x₂)
                    (k₂.hom.naturality g)
                rw [hnat₂]
                have hfst : (p₂_of E₂.unop ≫ ((Fgt W_D).map g.unop).left) x₂ =
                    p₂_of E₁.unop
                      (((Fgt W₂).map ((weilCompEtaleSitePullback u₂).map g.unop)).left x₂) :=
                  congrArg (fun (m : _ ⟶ ((Fgt W_D).obj E₁.unop).left) => m x₂)
                    (hB_fst u₂ g.unop).symm
                exact (hl₂ E₁.unop x
                  (((Fgt W₂).map ((weilCompEtaleSitePullback u₂).map g.unop)).left x₂)).symm.trans
                  (congrArg (l_fn E₁.unop x) hfst.symm) }
      let l : 𝒢 ⟶ ℒ_D := CategoryTheory.ObjectProperty.homMk l_pre
      refine ⟨l, ?_⟩
      apply CategoryTheory.Limits.biprod.hom_ext
      · change (l ≫ α) ≫ CategoryTheory.Limits.biprod.fst = k₁
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.lift_fst]
        apply CategoryTheory.Sheaf.hom_ext
        refine CategoryTheory.NatTrans.ext (funext fun E =>
          AddCommGrpCat.ext fun x => LocallyConstant.ext fun x₁ => hl₁ E.unop x x₁)
      · change (l ≫ α) ≫ CategoryTheory.Limits.biprod.snd = k₂
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.lift_snd]
        apply CategoryTheory.Sheaf.hom_ext
        refine CategoryTheory.NatTrans.ext (funext fun E =>
          AddCommGrpCat.ext fun x => LocallyConstant.ext fun x₂ => hl₂ E.unop x x₂)
    have hExact_loc : S_loc.Exact :=
      CategoryTheory.ShortComplex.exact_of_f_is_kernel S_loc hLim_α

    
    have hEpi_β : CategoryTheory.Epi β := by
      refine ⟨fun {𝒢} γ₁ γ₂ hβ => ?_⟩
      have hσ₁ : σ₁ ≫ γ₁ = σ₁ ≫ γ₂ := by
        have h := congrArg (CategoryTheory.Limits.biprod.inl ≫ ·) hβ
        simpa [β, CategoryTheory.Category.assoc] using h
      apply CategoryTheory.Sheaf.hom_ext
      ext E s
      let s' := toLC₁₂ E.unop s
      let p₁₂ := p₁₂_of E.unop
      obtain ⟨hEmb₁₂, _⟩ := hPullbackClosedRange u₁₂ E.unop
      let a_pt : ↥((Fgt W_D).obj E.unop).left → ↥A_ℓ := fun y =>
        if h : y ∈ Set.range ⇑p₁₂ then s' h.choose else 0
      let O_pt : ↥((Fgt W_D).obj E.unop).left → ((Fgt W_D).obj E.unop).left.Opens := fun y =>
        ⟨(⇑p₁₂ '' (⇑s' ⁻¹' {a_pt y})ᶜ)ᶜ,
          (hEmb₁₂.isClosedMap _ (s'.isLocallyConstant.isOpen_fiber (a_pt y)).isClosed_compl).isOpen_compl⟩
      have hy_mem : ∀ y : ↥((Fgt W_D).obj E.unop).left, y ∈ O_pt y := by
        intro y
        change y ∉ ⇑p₁₂ '' (⇑s' ⁻¹' {a_pt y})ᶜ
        rintro ⟨w, hw_ne, hw_eq⟩
        change s' w ≠ a_pt y at hw_ne
        have h : y ∈ Set.range ⇑p₁₂ := ⟨w, hw_eq⟩
        have ha : a_pt y = s' h.choose := by
          dsimp [a_pt]
          simp only [h, ↓reduceDIte]
        have hw_ch : h.choose = w :=
          hEmb₁₂.toIsEmbedding.injective (h.choose_spec.trans hw_eq.symm)
        exact hw_ne (ha.trans (congrArg s' hw_ch)).symm
      refine hOpenCoverExt 𝒢 E.unop O_pt (fun y => ⟨y, hy_mem y⟩)
        (γ₁.hom.app E s) (γ₂.hom.app E s) (fun y => ?_)
      let j_y := mkOpenEtaleHom E.unop (O_pt y)
      let E_y := mkOpenEtale E.unop (O_pt y)
      have hs_res : ℱ₁₂.obj.map j_y.op s =
          σ₁.hom.app (Opposite.op E_y) (LocallyConstant.const _ (a_pt y)) := by
        apply LocallyConstant.ext
        intro z
        change s' (((Fgt W₁₂).map ((weilCompEtaleSitePullback u₁₂).map j_y)).left z) = a_pt y
        let w := ((Fgt W₁₂).map ((weilCompEtaleSitePullback u₁₂).map j_y)).left z
        have hw_in : p₁₂ w ∈ O_pt y := by
          have hfst : p₁₂ w = (O_pt y).ι (p₁₂_of E_y z) :=
            congrArg (fun (m : _ ⟶ ((Fgt W_D).obj E.unop).left) => m z)
              (hB_fst u₁₂ j_y)
          rw [hfst, ← SetLike.mem_coe, ← (O_pt y).range_ι]
          exact ⟨_, rfl⟩
        by_contra hne
        exact hw_in ⟨w, hne, rfl⟩
      have hnat₁ := congrArg
        (fun (m : ℱ₁₂.obj.obj E ⟶ 𝒢.obj.obj (Opposite.op E_y)) => m s)
        (γ₁.hom.naturality j_y.op)
      have hnat₂ := congrArg
        (fun (m : ℱ₁₂.obj.obj E ⟶ 𝒢.obj.obj (Opposite.op E_y)) => m s)
        (γ₂.hom.naturality j_y.op)
      dsimp at hnat₁ hnat₂
      rw [← hnat₁, ← hnat₂, hs_res]
      exact congrArg
        (fun (m : ℱ₁ ⟶ 𝒢) => m.hom.app (Opposite.op E_y) (LocallyConstant.const _ (a_pt y)))
        hσ₁

    have hSE_loc : S_loc.ShortExact :=
      { exact := hExact_loc, mono_f := hMono_α, epi_g := hEpi_β }

    
    let T₁ := weilEtaleTorsionSheaf W_D ℓ
    let T₂ := CategoryTheory.Limits.biprod
      (weilEtaleHigherDirectImage u₁ 0 (weilEtaleTorsionSheaf W₁ ℓ))
      (weilEtaleHigherDirectImage u₂ 0 (weilEtaleTorsionSheaf W₂ ℓ))
    let T₃ := weilEtaleHigherDirectImage u₁₂ 0 (weilEtaleTorsionSheaf W₁₂ ℓ)
    let iso₁ : S_loc.X₁ ≅ T₁ := e_D.symm
    let iso₂ : S_loc.X₂ ≅ T₂ :=
      CategoryTheory.Limits.biprod.mapIso
        (pf₁.mapIso e_1.symm ≪≫ e_R0_1.symm)
        (pf₂.mapIso e_2.symm ≪≫ e_R0_2.symm)
    let iso₃ : S_loc.X₃ ≅ T₃ :=
      pf₁₂.mapIso e_12.symm ≪≫ e_R0_12.symm
    let f_MV : T₁ ⟶ T₂ := iso₁.inv ≫ S_loc.f ≫ iso₂.hom
    let g_MV : T₂ ⟶ T₃ := iso₂.inv ≫ S_loc.g ≫ iso₃.hom
    have h0_MV : f_MV ≫ g_MV = 0 := by
      dsimp [f_MV, g_MV]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Iso.hom_inv_id_assoc, S_loc.zero_assoc,
        CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    let S_MV := CategoryTheory.ShortComplex.mk f_MV g_MV h0_MV
    let e_SC : S_loc ≅ S_MV :=
      CategoryTheory.ShortComplex.isoMk iso₁ iso₂ iso₃
        (by dsimp [S_MV, f_MV]; rw [CategoryTheory.Iso.hom_inv_id_assoc])
        (by dsimp [S_MV, g_MV]; rw [CategoryTheory.Iso.hom_inv_id_assoc])
    exact ⟨u₁, u₂, u₁₂, S_MV, hu₁, hu₂, hu₁₂,
      CategoryTheory.ShortComplex.shortExact_of_iso e_SC hSE_loc, rfl, rfl, rfl⟩

theorem weil_etale_finite_pushforward_torsion_prop (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType X.hom]
    [AlgebraicGeometry.QuasiCompact X.hom]
    [AlgebraicGeometry.IsSeparated X.hom]
    (P : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u} → Prop)
    (hZero : ∀ F, CategoryTheory.Limits.IsZero F → P F)
    (hRetract : ∀ F₁ F₂ (i : F₁ ⟶ F₂) (r : F₂ ⟶ F₁), i ≫ r = 𝟙 F₁ → P F₂ → P F₁)
    (hExact : ∀ (S : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})),
        S.ShortExact → ℓ • 𝟙 S.X₂ = 0 →
        ((P S.X₁ ∧ P S.X₃ → P S.X₂) ∧ (P S.X₂ ∧ P S.X₃ → P S.X₁)))
    (hFinGen : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (π : Y ⟶ X.left),
        AlgebraicGeometry.IsIntegral Y →
        AlgebraicGeometry.IsFinite π →
        P (weilEtaleHigherDirectImage π 0 (weilEtaleTorsionSheaf Y ℓ))) :
    ∀ (W : AlgebraicGeometry.Scheme.{u}) (g : W ⟶ X.left),
      AlgebraicGeometry.IsFinite g →
      P (weilEtaleHigherDirectImage g 0 (weilEtaleTorsionSheaf W ℓ)) :=
by
  obtain ⟨hEmpty, hTorSh, hTorPush, hMapIso, hBiprod, hComp, hPushSE⟩ :=
    weil_etale_degree_zero_pushforward_exact_and_comp.{u} ℓ
  have hPIso : ∀ {F₁ F₂ : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}},
      Nonempty (CategoryTheory.Iso F₁ F₂) → P F₂ → P F₁ := by
    intro F₁ F₂ ⟨e⟩ hP₂
    exact hRetract F₁ F₂ e.hom e.inv e.hom_inv_id hP₂
  have hTorIso : ∀ {F₁ F₂ : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}},
      Nonempty (CategoryTheory.Iso F₁ F₂) →
      ℓ • 𝟙 F₂ = 0 →
      ℓ • 𝟙 F₁ = 0 := by
    intro F₁ F₂ ⟨e⟩ hT₂
    calc
      ℓ • 𝟙 F₁ = ℓ • (e.hom ≫ 𝟙 F₂ ≫ e.inv) := by
        rw [CategoryTheory.Category.id_comp, e.hom_inv_id]
      _ = e.hom ≫ (ℓ • 𝟙 F₂) ≫ e.inv := by
        rw [← CategoryTheory.Preadditive.comp_nsmul, ← CategoryTheory.Preadditive.nsmul_comp]
      _ = 0 := by
        rw [hT₂, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
  have hBiprodAux : ∀ (A B : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • 𝟙 A = 0 →
      ℓ • 𝟙 B = 0 →
      let S_bi := CategoryTheory.ShortComplex.mk
        (CategoryTheory.Limits.biprod.inl : A ⟶ CategoryTheory.Limits.biprod A B)
        CategoryTheory.Limits.biprod.snd
        CategoryTheory.Limits.biprod.inl_snd
      S_bi.ShortExact ∧ ℓ • 𝟙 S_bi.X₂ = 0 := by
    intro A B hTA hTB S_bi
    let fst_AB : CategoryTheory.Limits.biprod A B ⟶ A := CategoryTheory.Limits.biprod.fst
    let snd_AB : CategoryTheory.Limits.biprod A B ⟶ B := CategoryTheory.Limits.biprod.snd
    let inl_AB : A ⟶ CategoryTheory.Limits.biprod A B := CategoryTheory.Limits.biprod.inl
    let inr_AB : B ⟶ CategoryTheory.Limits.biprod A B := CategoryTheory.Limits.biprod.inr
    have htot : fst_AB ≫ inl_AB + snd_AB ≫ inr_AB = 𝟙 (CategoryTheory.Limits.biprod A B) :=
      CategoryTheory.Limits.biprod.total
    have hSplit : S_bi.Splitting :=
      { r := fst_AB
        s := inr_AB
        f_r := CategoryTheory.Limits.biprod.inl_fst
        s_g := CategoryTheory.Limits.biprod.inr_snd
        id := htot }
    refine ⟨hSplit.shortExact, ?_⟩
    change ℓ • 𝟙 (CategoryTheory.Limits.biprod A B) = 0
    have h1 : ℓ • (fst_AB ≫ inl_AB) = 0 := by
      calc
        ℓ • (fst_AB ≫ inl_AB) = ℓ • (fst_AB ≫ 𝟙 A ≫ inl_AB) := by
          rw [CategoryTheory.Category.id_comp]
        _ = fst_AB ≫ (ℓ • 𝟙 A) ≫ inl_AB := by
          rw [← CategoryTheory.Preadditive.comp_nsmul, ← CategoryTheory.Preadditive.nsmul_comp]
        _ = 0 := by
          rw [hTA, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    have h2 : ℓ • (snd_AB ≫ inr_AB) = 0 := by
      calc
        ℓ • (snd_AB ≫ inr_AB) = ℓ • (snd_AB ≫ 𝟙 B ≫ inr_AB) := by
          rw [CategoryTheory.Category.id_comp]
        _ = snd_AB ≫ (ℓ • 𝟙 B) ≫ inr_AB := by
          rw [← CategoryTheory.Preadditive.comp_nsmul, ← CategoryTheory.Preadditive.nsmul_comp]
        _ = 0 := by
          rw [hTB, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    rw [← htot, smul_add, h1, h2, add_zero]
  have : IsNoetherianRing k := inferInstance
  have : IsNoetherianRing ↑(CommRingCat.of k) := inferInstance
  have : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    inferInstance
  intro W g hg
  letI : AlgebraicGeometry.IsFinite g := hg
  obtain ⟨hRedTop, hMV⟩ := weil_etale_closed_cover_torsion_mayer_vietoris W ℓ
  have : AlgebraicGeometry.IsProper g := inferInstance
  have : AlgebraicGeometry.QuasiCompact g := inferInstance
  have : AlgebraicGeometry.LocallyOfFiniteType g := inferInstance
  have : AlgebraicGeometry.LocallyOfFiniteType (g ≫ X.hom) := inferInstance
  have : AlgebraicGeometry.QuasiCompact (g ≫ X.hom) := inferInstance
  have : AlgebraicGeometry.IsLocallyNoetherian W :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian (g ≫ X.hom)
  have : CompactSpace ↥W :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace (g ≫ X.hom)
  have : AlgebraicGeometry.IsNoetherian W := AlgebraicGeometry.IsNoetherian.mk
  have hInd : ∀ (D : TopologicalSpace.Closeds ↥W),
      P (weilEtaleHigherDirectImage
        ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subschemeι ≫ g) 0
        (weilEtaleTorsionSheaf
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subscheme ℓ)) := by
    intro D₀
    refine @WellFoundedLT.induction (TopologicalSpace.Closeds ↥W) _ _
      (fun D => P (weilEtaleHigherDirectImage
        ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subschemeι ≫ g) 0
        (weilEtaleTorsionSheaf
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subscheme ℓ))) D₀ ?_
    intro D ih
    let I_D := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D
    let W_D := I_D.subscheme
    let i_D := I_D.subschemeι
    let g_D := i_D ≫ g
    have hSupp : I_D.support = D :=
      SetLike.ext' (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal D)
    have hRange : Set.range ⇑i_D.base = (D : Set ↥W) := by
      dsimp [i_D]
      rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι, hSupp]
    have hFin_gD : AlgebraicGeometry.IsFinite g_D := inferInstance
    by_cases hEmptyD : (D : Set ↥W) = ∅
    · have hEmptyWD : IsEmpty ↥W_D := by
        refine ⟨fun y => ?_⟩
        have hy : i_D.base y ∈ Set.range ⇑i_D.base := ⟨y, rfl⟩
        rw [hRange, hEmptyD] at hy
