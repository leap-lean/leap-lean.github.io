          · intro hk_abs; exact absurd (Finset.mem_univ k) hk_abs
        · exact map_zero _
      choose t₁ ht₁_ne ht₁_spec using fun i : I => clear_nil (δ₁ i) (hδ₁_nil i)
      choose t₂ ht₂_ne ht₂_spec using fun (p : I × I) => clear_nil (δ₂ p.1 p.2) (hδ₂_nil p.1 p.2)
      obtain ⟨t₃, ht₃_ne, ht₃_spec⟩ := clear_nil δ₃ hδ₃_nil
      choose t₄ ht₄_ne ht₄_spec using fun i : I => clear_nil (δ₄ i) (hδ₄_nil i)
      choose t₅ ht₅_ne ht₅_spec using fun g : B => clear_nil (δ₅ g) (hδ₅_nil g)
      let h : R := h₀ * t₃ * (∏ i : I, (t₁ i * t₄ i)) *
        (∏ p : I × I, t₂ p) * (∏ g ∈ G, t₅ g)
      have hh_ne : h ≠ 0 := by
        refine mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero hh₀_ne ht₃_ne) ?_) ?_) ?_
        · rw [Finset.prod_ne_zero_iff]; intro i _; exact mul_ne_zero (ht₁_ne i) (ht₄_ne i)
        · rw [Finset.prod_ne_zero_iff]; intro p _; exact ht₂_ne p
        · rw [Finset.prod_ne_zero_iff]; intro g _; exact ht₅_ne g
      let R_h := Localization.Away h
      have hSub_h : Submonoid.powers h ≤ nonZeroDivisors R := by
        rintro _ ⟨n, rfl⟩
        exact Submonoid.pow_mem _ (mem_nonZeroDivisors_of_ne_zero hh_ne) n
      haveI : IsDomain R_h := IsLocalization.isDomain_localization hSub_h
      let B_h := TensorProduct R R_h B
      let D_h := B_h ⧸ nilradical B_h
      have unit_of_dvd_h : ∀ r : R, r ∣ h → IsUnit (algebraMap R R_h r) :=
        fun r hr => isUnit_of_dvd_unit (map_dvd (algebraMap R R_h) hr)
          (IsLocalization.Away.algebraMap_isUnit h)
      have hUnit_h₀_Rh : IsUnit (algebraMap R R_h h₀) :=
        unit_of_dvd_h h₀ ⟨t₃ * (∏ i : I, (t₁ i * t₄ i)) * (∏ p : I × I, t₂ p) * (∏ g ∈ G, t₅ g),
