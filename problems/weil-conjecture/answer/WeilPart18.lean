    let t_tilde : ∀ m : Fin r, ↥(F₁.obj.obj (Opposite.op (O_m m))) := fun m =>
      F₁.obj.map (τ_m m).op (t_i (idx m))
    let S_cov : Sieve (B.obj U_R') := Sieve.ofArrows O_m ell_m
    have hS_cov_mem : S_cov ∈ Y.smallEtaleTopology (B.obj U_R') := by
      rw [mem_smallEtaleTopology_iff]
      intro z
      let q_D : PrimeSpectrum D := θ.inv.base z
      have hsum1 : ∑ m : Fin r, e m = 1 := he.2
      have hex_m : ∃ m : Fin r, e m ∉ q_D.asIdeal := by
        by_contra h_all
        have h_all' : ∀ m : Fin r, e m ∈ q_D.asIdeal := fun m =>
          Decidable.byContradiction fun hm => h_all ⟨m, hm⟩
        have h1_mem : (1 : D) ∈ q_D.asIdeal := by
          rw [← hsum1]
          exact Ideal.sum_mem q_D.asIdeal fun m _ => h_all' m
        exact q_D.isPrime.ne_top ((Ideal.eq_top_iff_one q_D.asIdeal).mpr h1_mem)
      obtain ⟨m, hm⟩ := hex_m
      have hmem_basic : q_D ∈ (PrimeSpectrum.basicOpen (e m) : Set (PrimeSpectrum D)) := hm
      rw [← PrimeSpectrum.localization_away_comap_range (L_m m) (e m)] at hmem_basic
      obtain ⟨q_L, hq_L⟩ := hmem_basic
      have hEt_ell : Etale (ell_m m).left := by
        have _ := hOpen_lam m
        change Etale (lam_m m ≫ θ.hom)
        infer_instance
      refine ⟨O_m m, ell_m m, q_L, Sieve.ofArrows_mk O_m ell_m m, hEt_ell, ?_⟩
      change θ.hom.base ((lam_m m).base q_L) = z
      have hlam_q : (lam_m m).base q_L = q_D := hq_L
      rw [hlam_q]
      change (θ.inv ≫ θ.hom).base z = z
      rw [θ.inv_hom_id]
      rfl
    have h_indep : ∀ {W₀ : Y.Etale} (m₁ m₂ : Fin r) (a₁ : W₀ ⟶ O_m m₁) (a₂ : W₀ ⟶ O_m m₂),
        a₁ ≫ ell_m m₁ = a₂ ≫ ell_m m₂ →
        F₁.obj.map a₁.op (t_tilde m₁) = F₁.obj.map a₂.op (t_tilde m₂) := by
      intro W₀ m₁ m₂ a₁ a₂ ha_eq
      by_cases hm : m₁ = m₂
      · subst hm
        have _ : Mono (ell_m m₁) := hMono_ell m₁
        have ha : a₁ = a₂ := (cancel_mono (ell_m m₁)).mp ha_eq
        rw [ha]
      · have hEmpty : IsEmpty ↥W₀.left := by
          refine ⟨fun w => ?_⟩
          let q_D : PrimeSpectrum D := θ.inv.base ((a₁ ≫ ell_m m₁).left.base w)
          have hq₁ : q_D = (lam_m m₁).base (a₁.left.base w) := by
            have hcan : (θ.hom ≫ θ.inv).base ((lam_m m₁).base (a₁.left.base w)) =
                (lam_m m₁).base (a₁.left.base w) := by
              rw [θ.hom_inv_id]; rfl
            exact hcan
          have hq₂ : q_D = (lam_m m₂).base (a₂.left.base w) := by
            have hw₂ : (a₁ ≫ ell_m m₁).left.base w = (a₂ ≫ ell_m m₂).left.base w :=
              congrArg (fun k => ((Scheme.Etale.forget Y).map k).left.base w) ha_eq
            change θ.inv.base ((a₁ ≫ ell_m m₁).left.base w) = _
            rw [hw₂]
            have hcan : (θ.hom ≫ θ.inv).base ((lam_m m₂).base (a₂.left.base w)) =
                (lam_m m₂).base (a₂.left.base w) := by
              rw [θ.hom_inv_id]; rfl
            exact hcan
          have hm₁_not : e m₁ ∉ q_D.asIdeal := by
            have hr₁ : q_D ∈ Set.range (PrimeSpectrum.comap (algebraMap D (L_m m₁))) :=
              ⟨a₁.left.base w, hq₁.symm⟩
            rwa [PrimeSpectrum.localization_away_comap_range (L_m m₁) (e m₁)] at hr₁
          have hm₂_not : e m₂ ∉ q_D.asIdeal := by
            have hr₂ : q_D ∈ Set.range (PrimeSpectrum.comap (algebraMap D (L_m m₂))) :=
              ⟨a₂.left.base w, hq₂.symm⟩
            rwa [PrimeSpectrum.localization_away_comap_range (L_m m₂) (e m₂)] at hr₂
          have hmul_zero : e m₁ * e m₂ = 0 := he.1.2 hm
          have hmul_mem : e m₁ * e m₂ ∈ q_D.asIdeal := by
            rw [hmul_zero]
            exact q_D.asIdeal.zero_mem
          rcases q_D.isPrime.mem_or_mem hmul_mem with h1 | h2
          · exact hm₁_not h1
          · exact hm₂_not h2
        have _ : Subsingleton ↥(F₁.obj.obj (Opposite.op W₀)) := hSub_of_empty F₁ W₀ hEmpty
        exact Subsingleton.elim _ _
    let F₁_type := (sheafCompose Y.smallEtaleTopology (forget AddCommGrpCat.{u})).obj F₁
    let F₂_type := (sheafCompose Y.smallEtaleTopology (forget AddCommGrpCat.{u})).obj F₂
    have hSh₁ : Presieve.IsSheaf Y.smallEtaleTopology F₁_type.obj :=
      (isSheaf_iff_isSheaf_of_type Y.smallEtaleTopology F₁_type.obj).mp F₁_type.property
    have hSh₂ : Presieve.IsSheaf Y.smallEtaleTopology F₂_type.obj :=
      (isSheaf_iff_isSheaf_of_type Y.smallEtaleTopology F₂_type.obj).mp F₂_type.property
    have hGen_mem : Sieve.generate S_cov.arrows ∈ Y.smallEtaleTopology (B.obj U_R') := by
      rwa [Sieve.generate_sieve]
    have hFor₁ : Presieve.IsSheafFor F₁_type.obj S_cov.arrows := hSh₁.isSheafFor _ hGen_mem
    have hFor₂ : Presieve.IsSheafFor F₂_type.obj S_cov.arrows := hSh₂.isSheafFor _ hGen_mem
    have hArrow_ex : ∀ {W₀ : Y.Etale} {u : W₀ ⟶ B.obj U_R'}, S_cov.arrows u →
        ∃ (m : Fin r) (a : W₀ ⟶ O_m m), a ≫ ell_m m = u := by
      intro W₀ u hu
      rcases hu with ⟨W₁, a, f_arr, hf_arr, hcomp⟩
      rcases hf_arr with ⟨m⟩
      exact ⟨m, a, hcomp⟩
    let fam : Presieve.FamilyOfElements F₁_type.obj S_cov.arrows :=
      fun W₀ u hu =>
        let m := (hArrow_ex hu).choose
        let a := (hArrow_ex hu).choose_spec.choose
        F₁.obj.map a.op (t_tilde m)
    have hfam_comp : fam.Compatible := by
      intro W₁ W₂ Z₀ f₁ f₂ u₁ u₂ hu₁ hu₂ hcomm
      let m₁ := (hArrow_ex hu₁).choose
      let a₁ := (hArrow_ex hu₁).choose_spec.choose
      have ha₁ : a₁ ≫ ell_m m₁ = u₁ := (hArrow_ex hu₁).choose_spec.choose_spec
      let m₂ := (hArrow_ex hu₂).choose
      let a₂ := (hArrow_ex hu₂).choose_spec.choose
      have ha₂ : a₂ ≫ ell_m m₂ = u₂ := (hArrow_ex hu₂).choose_spec.choose_spec
      change F₁.obj.map f₁.op (F₁.obj.map a₁.op (t_tilde m₁)) =
        F₁.obj.map f₂.op (F₁.obj.map a₂.op (t_tilde m₂))
      have hmap₁ : F₁.obj.map f₁.op (F₁.obj.map a₁.op (t_tilde m₁)) =
          F₁.obj.map (f₁ ≫ a₁).op (t_tilde m₁) := by
        simp only [op_comp, F₁.obj.map_comp]
        rfl
      have hmap₂ : F₁.obj.map f₂.op (F₁.obj.map a₂.op (t_tilde m₂)) =
          F₁.obj.map (f₂ ≫ a₂).op (t_tilde m₂) := by
        simp only [op_comp, F₁.obj.map_comp]
        rfl
      rw [hmap₁, hmap₂]
      apply h_indep m₁ m₂ (f₁ ≫ a₁) (f₂ ≫ a₂)
      rw [Category.assoc, ha₁, Category.assoc, ha₂, hcomm]
    let t_amalg : ↥(F₁.obj.obj (Opposite.op (B.obj U_R'))) := hFor₁.amalgamate fam hfam_comp
    have ht_amalg_res : ∀ m : Fin r,
        F₁.obj.map (ell_m m).op t_amalg = t_tilde m := by
      intro m
      have hm_arr : S_cov.arrows (ell_m m) := Sieve.ofArrows_mk O_m ell_m m
      have h_am : F₁.obj.map (ell_m m).op t_amalg = fam (ell_m m) hm_arr :=
        hFor₁.valid_glue hfam_comp (ell_m m) hm_arr
      let m₀ := (hArrow_ex hm_arr).choose
      let a₀ := (hArrow_ex hm_arr).choose_spec.choose
      have ha₀ : a₀ ≫ ell_m m₀ = ell_m m := (hArrow_ex hm_arr).choose_spec.choose_spec
      have hid : F₁.obj.map (𝟙 (O_m m)).op (t_tilde m) = t_tilde m := by
        simp
      exact h_am.trans
        ((h_indep m₀ m a₀ (𝟙 (O_m m)) (ha₀.trans (Category.id_comp _).symm)).trans hid)
    have hv_amalg : v.hom.app (Opposite.op (B.obj U_R')) t_amalg =
        ((π_push.obj F₂).obj.map g.op) s := by
      apply hFor₂.isSeparatedFor.ext
      intro W₀ u hu
      obtain ⟨m, a, rfl⟩ := hArrow_ex hu
      change F₂.obj.map (a ≫ ell_m m).op (v.hom.app (Opposite.op (B.obj U_R')) t_amalg) =
        F₂.obj.map (a ≫ ell_m m).op (F₂.obj.map (B.map g).op s_U)
      simp only [op_comp, F₂.obj.map_comp]
      change F₂.obj.map a.op (F₂.obj.map (ell_m m).op (v.hom.app _ t_amalg)) =
        F₂.obj.map a.op (F₂.obj.map (ell_m m).op (F₂.obj.map (B.map g).op s_U))
      congr 1
      have hnat := ConcreteCategory.congr_hom (v.hom.naturality (ell_m m).op) t_amalg
      change v.hom.app (Opposite.op (O_m m)) (F₁.obj.map (ell_m m).op t_amalg) =
        F₂.obj.map (ell_m m).op (v.hom.app (Opposite.op (B.obj U_R')) t_amalg) at hnat
      rw [← hnat, ht_amalg_res m]
      dsimp [t_tilde]
      have hnat₂ := ConcreteCategory.congr_hom (v.hom.naturality (τ_m m).op) (t_i (idx m))
      change v.hom.app (Opposite.op (O_m m)) (F₁.obj.map (τ_m m).op (t_i (idx m))) =
        F₂.obj.map (τ_m m).op (v.hom.app (Opposite.op (Z_i (idx m))) (t_i (idx m))) at hnat₂
      rw [hnat₂, ht_i (idx m)]
      change (F₂.obj.map (k_i (idx m)).op ≫ F₂.obj.map (τ_m m).op) s_R = _
      rw [← F₂.obj.map_comp, ← op_comp, hτ_k m]
      dsimp [s_R, g]
      rw [B.map_comp]
      simp only [op_comp, F₂.obj.map_comp]
      rfl
    refine ⟨U_R', g, p', ?_, hg_et, hg_pt⟩
    exact ⟨t_amalg, hv_amalg⟩
  obtain ⟨hConj2, hConj3⟩ := weil_etale_surj_closed_iso_and_conductor_excision @hFinEpi
  refine ⟨fun Y X S π _ p F q => ?_, hConj2, hConj3⟩
  obtain ⟨hc, hEpi⟩ := hFinEpi π
  exact weil_etale_higherDirectImage_comp_of_pushforward_epi π p hc hEpi F q

theorem weil_etale_pullback_functoriality_and_iso_torsionH (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (e : X₁ ≅ X₂) (q : ℕ),
      Nonempty (weilEtaleTorsionH X₁ ℓ q ≃+ weilEtaleTorsionH X₂ ℓ q)) ∧
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂) (A : AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h
        ((CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj A)
        ((CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj A)) ∧
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
        (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}),
      ∃ F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u},
        WeilIsEtaleSheafPullback h F₂ F₁) ∧
    (∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}} (h₁ : X₁ ⟶ X₂) (h₂ : X₂ ⟶ X₃)
        (F₃ : CategoryTheory.Sheaf X₃.smallEtaleTopology AddCommGrpCat.{u})
        (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h₂ F₃ F₂ →
      (WeilIsEtaleSheafPullback h₁ F₂ F₁ ↔ WeilIsEtaleSheafPullback (h₁ ≫ h₂) F₃ F₁)) ∧
    (∀ (X : AlgebraicGeometry.Scheme.{u}),
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf X ℓ) = 0) ∧
    (∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) (q : ℕ)
        (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage f q F) = 0) :=
by
  let _ := (inferInstance : Fact (Nat.Prime ℓ))
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  let pb_id_left : ∀ {Y S : AlgebraicGeometry.Scheme.{u}} (f : Y ⟶ S),
      CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.id S) f ≅ Y :=
    fun {Y S} f =>
      { hom := CategoryTheory.Limits.pullback.snd (CategoryTheory.CategoryStruct.id S) f
        inv := CategoryTheory.Limits.pullback.lift f (CategoryTheory.CategoryStruct.id Y) (by simp)
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        inv_hom_id := CategoryTheory.Limits.pullback.lift_snd _ _ _ }

  have h_etale_term : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom) trivial) ?_
    intro U m
    apply (AlgebraicGeometry.Scheme.Etale.forget S).map_injective
    apply CategoryTheory.Over.OverMorphism.ext
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)

  have h_mem_etale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  have hExtEqv : ∀ {C D : Type (u + 1)}
      [CategoryTheory.SmallCategory C] [CategoryTheory.Abelian C]
      [CategoryTheory.HasExt.{u} C] [CategoryTheory.EnoughInjectives C]
      [CategoryTheory.SmallCategory D] [CategoryTheory.Abelian D]
      [CategoryTheory.HasExt.{u} D]
      (E : C ≌ D)
      (X₁ Y₁ : C) (X₂ Y₂ : D)
      (eX : E.functor.obj X₁ ≅ X₂)
      (eY : E.functor.obj Y₁ ≅ Y₂)
      (q : ℕ),
      Nonempty (CategoryTheory.Abelian.Ext.{u} X₁ Y₁ q ≃+
        CategoryTheory.Abelian.Ext.{u} X₂ Y₂ q) := by
    intro C D _ _ _ _ _ _ _ E X₁ Y₁ X₂ Y₂ eX eY q
    let F := E.functor
    have : F.IsLeftAdjoint := E.toAdjunction.isLeftAdjoint
    have : F.PreservesZeroMorphisms :=
      CategoryTheory.Functor.preservesZeroMorphisms_of_isLeftAdjoint F
    have : F.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products F
    have hInjObj : ∀ (I : C) [CategoryTheory.Injective I], CategoryTheory.Injective (F.obj I) := by
      intro I _
      exact CategoryTheory.Adjunction.map_injective E.symm.toAdjunction I inferInstance
    have hBij : ∀ (n : ℕ) (X Y : C), Function.Bijective (F.mapExtAddHom X Y n) := by
      intro n
      induction n with
      | zero =>
        intro X Y
        constructor
        · rw [injective_iff_map_eq_zero]
          intro α hα
          obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective X Y).2 α
          rw [CategoryTheory.Functor.mapExtAddHom_apply,
            CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
            ← CategoryTheory.Abelian.Ext.mk₀_zero] at hα
          have hf0 : F.map f = 0 :=
            (CategoryTheory.Abelian.Ext.mk₀_bijective (F.obj X) (F.obj Y)).1 hα
          have hf : f = 0 := F.map_injective (hf0.trans (F.map_zero X Y).symm)
          rw [hf, CategoryTheory.Abelian.Ext.mk₀_zero]
        · intro β
          obtain ⟨g, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective (F.obj X) (F.obj Y)).2 β
          obtain ⟨f, rfl⟩ := F.map_surjective g
          refine ⟨CategoryTheory.Abelian.Ext.mk₀ f, ?_⟩
          rw [CategoryTheory.Functor.mapExtAddHom_apply,
            CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      | succ n ih =>
        intro X Y
        let I : C := CategoryTheory.Injective.under Y
        let ι_Y : Y ⟶ I := CategoryTheory.Injective.ι Y
        have : CategoryTheory.Injective (F.obj I) := hInjObj I
        let Q : C := CategoryTheory.Limits.cokernel ι_Y
        let π_Q : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι_Y
        let S : CategoryTheory.ShortComplex C :=
          CategoryTheory.ShortComplex.mk ι_Y π_Q (CategoryTheory.Limits.cokernel.condition ι_Y)
        have : CategoryTheory.Mono S.f := by dsimp [S]; infer_instance
        have : CategoryTheory.Epi S.g := by dsimp [S, π_Q]; infer_instance
        have hS : S.ShortExact :=
          { exact := CategoryTheory.ShortComplex.exact_cokernel ι_Y }
        have hFS : (S.map F).ShortExact := hS.map_of_exact F
        have : CategoryTheory.Injective (S.map F).X₂ := by
          dsimp [S]
          infer_instance
        have hδ_comm : ∀ z : CategoryTheory.Abelian.Ext X S.X₃ n,
            (F.mapExtAddHom X S.X₁ (n + 1)) (z.comp hS.extClass rfl) =
              ((F.mapExtAddHom X S.X₃ n) z).comp hFS.extClass rfl := by
          intro z
          rw [CategoryTheory.Functor.mapExtAddHom_apply,
            CategoryTheory.Functor.mapExtAddHom_apply,
            CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
            CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
        have hπ_comm : ∀ w : CategoryTheory.Abelian.Ext X S.X₂ n,
            (F.mapExtAddHom X S.X₃ n)
                (w.comp (CategoryTheory.Abelian.Ext.mk₀ S.g) (Nat.add_zero n)) =
              ((F.mapExtAddHom X S.X₂ n) w).comp
                (CategoryTheory.Abelian.Ext.mk₀ (S.map F).g) (Nat.add_zero n) := by
          intro w
          rw [CategoryTheory.Functor.mapExtAddHom_apply,
            CategoryTheory.Functor.mapExtAddHom_apply,
            CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
            CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
          rfl
        constructor
        · rw [injective_iff_map_eq_zero]
          intro y hy
          have hyI : y.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (n + 1)) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨z, hz⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS y hyI rfl
          have hz' : ((F.mapExtAddHom X S.X₃ n) z).comp hFS.extClass rfl = 0 := by
            rw [← hδ_comm z, hz, hy]
          obtain ⟨w', hw'⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ (F.obj X) hFS
            ((F.mapExtAddHom X S.X₃ n) z) rfl hz'
          obtain ⟨w, rfl⟩ := (ih X S.X₂).2 w'
          have hwz : w.comp (CategoryTheory.Abelian.Ext.mk₀ S.g) (Nat.add_zero n) = z :=
            (ih X S.X₃).1 ((hπ_comm w).trans hw')
          rw [← hz, ← hwz,
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero n) (Nat.zero_add 1) rfl,
            hS.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
        · intro y'
          have hy'I :
              y'.comp (CategoryTheory.Abelian.Ext.mk₀ (S.map F).f) (Nat.add_zero (n + 1)) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨z', hz'⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (F.obj X) hFS y' hy'I rfl
          obtain ⟨z, rfl⟩ := (ih X S.X₃).2 z'
          exact ⟨z.comp hS.extClass rfl, (hδ_comm z).trans hz'⟩
    let e₀ : CategoryTheory.Abelian.Ext.{u} X₁ Y₁ q ≃+
        CategoryTheory.Abelian.Ext.{u} (F.obj X₁) (F.obj Y₁) q :=
      AddEquiv.ofBijective (F.mapExtAddHom X₁ Y₁ q) (hBij q X₁ Y₁)
    let pre_hom := (CategoryTheory.Abelian.Ext.mk₀ eX.inv).precomp (F.obj Y₁) (Nat.zero_add q)
    let pre_inv := (CategoryTheory.Abelian.Ext.mk₀ eX.hom).precomp (F.obj Y₁) (Nat.zero_add q)
    let e₁ : CategoryTheory.Abelian.Ext.{u} (F.obj X₁) (F.obj Y₁) q ≃+
        CategoryTheory.Abelian.Ext.{u} X₂ (F.obj Y₁) q :=
      { toFun := pre_hom
        invFun := pre_inv
        left_inv := fun α => by
          dsimp [pre_hom, pre_inv]
          change (CategoryTheory.Abelian.Ext.mk₀ eX.hom).comp
            ((CategoryTheory.Abelian.Ext.mk₀ eX.inv).comp α (Nat.zero_add q)) (Nat.zero_add q) = α
          rw [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 0) (Nat.zero_add q)
              (Nat.zero_add q),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, eX.hom_inv_id,
            CategoryTheory.Abelian.Ext.mk₀_id_comp]
        right_inv := fun β => by
          dsimp [pre_hom, pre_inv]
          change (CategoryTheory.Abelian.Ext.mk₀ eX.inv).comp
            ((CategoryTheory.Abelian.Ext.mk₀ eX.hom).comp β (Nat.zero_add q)) (Nat.zero_add q) = β
          rw [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 0) (Nat.zero_add q)
              (Nat.zero_add q),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, eX.inv_hom_id,
            CategoryTheory.Abelian.Ext.mk₀_id_comp]
        map_add' := pre_hom.map_add }
    let post_hom := (CategoryTheory.Abelian.Ext.mk₀ eY.hom).postcomp X₂ (Nat.add_zero q)
    let post_inv := (CategoryTheory.Abelian.Ext.mk₀ eY.inv).postcomp X₂ (Nat.add_zero q)
    let e₂ : CategoryTheory.Abelian.Ext.{u} X₂ (F.obj Y₁) q ≃+
        CategoryTheory.Abelian.Ext.{u} X₂ Y₂ q :=
      { toFun := post_hom
        invFun := post_inv
        left_inv := fun α => by
          dsimp [post_hom, post_inv]
          change (α.comp (CategoryTheory.Abelian.Ext.mk₀ eY.hom) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ eY.inv) (Nat.add_zero q) = α
          rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0)
              (Nat.add_zero q),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, eY.hom_inv_id,
            CategoryTheory.Abelian.Ext.comp_mk₀_id]
        right_inv := fun β => by
          dsimp [post_hom, post_inv]
          change (β.comp (CategoryTheory.Abelian.Ext.mk₀ eY.inv) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ eY.hom) (Nat.add_zero q) = β
          rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0)
              (Nat.add_zero q),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, eY.inv_hom_id,
            CategoryTheory.Abelian.Ext.comp_mk₀_id]
        map_add' := post_hom.map_add }
    exact ⟨e₀.trans (e₁.trans e₂)⟩

  have hCover_map : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} {g : S₁ ⟶ S₂}
      (hg : AlgebraicGeometry.Etale g),
      let M_g : CategoryTheory.Functor S₁.Etale S₂.Etale :=
        CategoryTheory.MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤ hg
      CategoryTheory.CoverPreserving S₁.smallEtaleTopology S₂.smallEtaleTopology M_g := by
    intro S₁ S₂ g hg M_g
    constructor
    intro W R hR
    have hR' := (h_mem_etale S₁ W R).mp hR
    refine (h_mem_etale S₂ (M_g.obj W) _).mpr ?_
    intro x
    obtain ⟨Y, f, y, hfR, hfEt, hy⟩ := hR' x
    exact ⟨M_g.obj Y, M_g.map f, y,
      ⟨Y, f, 𝟙 (M_g.obj Y), hfR, (CategoryTheory.Category.id_comp _).symm⟩, hfEt, hy⟩

  have hSheafEqv : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (e : X₁ ≅ X₂),
      ∃ (E : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u} ≌
          CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}),
        ∀ (A : AddCommGrpCat.{u}),
          Nonempty (E.functor.obj
            ((CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj A) ≅
            (CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
    intro X₁ X₂ e
    have hEt_hom : AlgebraicGeometry.Etale e.hom := inferInstance
    have hEt_inv : AlgebraicGeometry.Etale e.inv := inferInstance
    let M_hom : CategoryTheory.Functor X₁.Etale X₂.Etale :=
      CategoryTheory.MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤ hEt_hom
    let M_inv : CategoryTheory.Functor X₂.Etale X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤ hEt_inv
    have hEt_id₁ : AlgebraicGeometry.Etale (e.hom ≫ e.inv) := inferInstance
    have hEt_id₂ : AlgebraicGeometry.Etale (e.inv ≫ e.hom) := inferInstance
    let α₁ : M_hom.comp M_inv ≅ CategoryTheory.Functor.id X₁.Etale :=
      (CategoryTheory.MorphismProperty.Over.mapComp (P := @AlgebraicGeometry.Etale) ⊤
          hEt_hom hEt_inv).symm ≪≫
        CategoryTheory.MorphismProperty.Over.mapCongr (P := @AlgebraicGeometry.Etale) ⊤
          e.hom_inv_id hEt_id₁ ≪≫
        CategoryTheory.MorphismProperty.Over.mapId (P := @AlgebraicGeometry.Etale) ⊤ X₁
    let α₂ : M_inv.comp M_hom ≅ CategoryTheory.Functor.id X₂.Etale :=
      (CategoryTheory.MorphismProperty.Over.mapComp (P := @AlgebraicGeometry.Etale) ⊤
          hEt_inv hEt_hom).symm ≪≫
        CategoryTheory.MorphismProperty.Over.mapCongr (P := @AlgebraicGeometry.Etale) ⊤
          e.inv_hom_id hEt_id₂ ≪≫
        CategoryTheory.MorphismProperty.Over.mapId (P := @AlgebraicGeometry.Etale) ⊤ X₂
    let eqv_et : X₁.Etale ≌ X₂.Etale :=
      CategoryTheory.Equivalence.mk M_hom M_inv α₁.symm α₂
    have : CategoryTheory.Limits.HasTerminal X₁.Etale := (h_etale_term X₁).hasTerminal
    have : CategoryTheory.Limits.HasPullbacks X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.hasPullbacks (@AlgebraicGeometry.Etale) X₁
    have : CategoryTheory.Limits.HasFiniteLimits X₁.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : CategoryTheory.Limits.HasTerminal X₂.Etale := (h_etale_term X₂).hasTerminal
    have : CategoryTheory.Limits.HasPullbacks X₂.Etale :=
      CategoryTheory.MorphismProperty.Over.hasPullbacks (@AlgebraicGeometry.Etale) X₂
    have : CategoryTheory.Limits.HasFiniteLimits X₂.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : CategoryTheory.Limits.PreservesFiniteLimits M_hom := by
      change CategoryTheory.Limits.PreservesFiniteLimits eqv_et.functor
      infer_instance
    have : CategoryTheory.Limits.PreservesFiniteLimits M_inv := by
      change CategoryTheory.Limits.PreservesFiniteLimits eqv_et.inverse
      infer_instance
    have : CategoryTheory.RepresentablyFlat M_hom :=
      CategoryTheory.flat_of_preservesFiniteLimits M_hom
    have : CategoryTheory.RepresentablyFlat M_inv :=
      CategoryTheory.flat_of_preservesFiniteLimits M_inv
    have hCompat_hom : CategoryTheory.CompatiblePreserving X₂.smallEtaleTopology M_hom :=
      CategoryTheory.compatiblePreservingOfFlat X₂.smallEtaleTopology M_hom
    have hCompat_inv : CategoryTheory.CompatiblePreserving X₁.smallEtaleTopology M_inv :=
      CategoryTheory.compatiblePreservingOfFlat X₁.smallEtaleTopology M_inv
    have : M_hom.IsContinuous X₁.smallEtaleTopology X₂.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat_hom (hCover_map hEt_hom)
    have : M_inv.IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat_inv (hCover_map hEt_inv)
    have : (M_hom.comp M_inv).IsContinuous X₁.smallEtaleTopology X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp M_hom M_inv
        X₁.smallEtaleTopology X₂.smallEtaleTopology X₁.smallEtaleTopology
    have : (M_inv.comp M_hom).IsContinuous X₂.smallEtaleTopology X₂.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp M_inv M_hom
        X₂.smallEtaleTopology X₁.smallEtaleTopology X₂.smallEtaleTopology
    let E₁₂ := M_inv.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let E₂₁ := M_hom.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₁.smallEtaleTopology X₂.smallEtaleTopology
    let η_sh : CategoryTheory.Functor.id _ ≅ E₁₂.comp E₂₁ :=
      (CategoryTheory.Functor.sheafPushforwardContinuousId' α₁ AddCommGrpCat.{u}
          X₁.smallEtaleTopology).symm ≪≫
        (CategoryTheory.Functor.sheafPushforwardContinuousComp M_hom M_inv AddCommGrpCat.{u}
          X₁.smallEtaleTopology X₂.smallEtaleTopology X₁.smallEtaleTopology).symm
    let ε_sh : E₂₁.comp E₁₂ ≅ CategoryTheory.Functor.id _ :=
      CategoryTheory.Functor.sheafPushforwardContinuousComp M_inv M_hom AddCommGrpCat.{u}
          X₂.smallEtaleTopology X₁.smallEtaleTopology X₂.smallEtaleTopology ≪≫
        CategoryTheory.Functor.sheafPushforwardContinuousId' α₂ AddCommGrpCat.{u}
          X₂.smallEtaleTopology
    let E : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u} ≌
        CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u} :=
      CategoryTheory.Equivalence.mk E₁₂ E₂₁ η_sh ε_sh
    refine ⟨E, fun A => ?_⟩
    let T₁ := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id X₁)
    let T₂ := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id X₂)
    have hT₁ : CategoryTheory.Limits.IsTerminal T₁ := h_etale_term X₁
    have hT₂ : CategoryTheory.Limits.IsTerminal T₂ := h_etale_term X₂
    let e_T : M_hom.obj T₁ ≅ T₂ :=
      CategoryTheory.MorphismProperty.Over.isoMk e
        ((CategoryTheory.Category.comp_id e.hom).trans
          (CategoryTheory.Category.id_comp e.hom).symm)
    let Γ₁ := (CategoryTheory.sheafSections X₁.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₁)
    let Γ₂ := (CategoryTheory.sheafSections X₂.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₂)
    have hΓ : E.inverse.comp Γ₁ ≅ Γ₂ :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ => ℱ.obj.mapIso e_T.op.symm)
        (fun {ℱ₁ ℱ₂} φ => by
          dsimp [E, E₂₁, Γ₁, Γ₂, CategoryTheory.sheafSections]
          exact (φ.hom.naturality e_T.inv.op).symm)
    let adj₁ := CategoryTheory.constantSheafAdj X₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj X₂.smallEtaleTopology AddCommGrpCat.{u} hT₂
    let e_const := CategoryTheory.Adjunction.leftAdjointUniq
      (CategoryTheory.Adjunction.ofNatIsoRight (adj₁.comp E.toAdjunction) hΓ) adj₂
    exact ⟨e_const.app A⟩

  have hConj1 : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (e : X₁ ≅ X₂) (q : ℕ),
      Nonempty (weilEtaleTorsionH X₁ ℓ q ≃+ weilEtaleTorsionH X₂ ℓ q) := by
    intro X₁ X₂ e q
    obtain ⟨E, hConst⟩ := hSheafEqv e
    obtain ⟨eℤ⟩ := hConst (AddCommGrpCat.of (ULift.{u} ℤ))
    obtain ⟨eM⟩ := hConst
      (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ)))
    exact hExtEqv E
      ((CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ)))
      (weilEtaleTorsionSheaf X₁ ℓ)
      ((CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ)))
      (weilEtaleTorsionSheaf X₂ ℓ)
      eℤ eM q

  have h_pull_base : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      let B_h : CategoryTheory.Functor Y₂.Etale Y₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
      ∃ (hc : B_h.IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology),
        letI := hc
        (B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology).IsRightAdjoint := by
    intro Y₁ Y₂ h
    let B_h : CategoryTheory.Functor Y₂.Etale Y₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    have hT₂ : CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y₂)) :=
      h_etale_term Y₂
    have : CategoryTheory.Limits.HasTerminal Y₂.Etale := hT₂.hasTerminal
    have : CategoryTheory.Limits.HasPullbacks Y₂.Etale :=
      CategoryTheory.MorphismProperty.Over.hasPullbacks (@AlgebraicGeometry.Etale) Y₂
    have : CategoryTheory.Limits.HasFiniteLimits Y₂.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : CategoryTheory.Limits.PreservesFiniteLimits B_h :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
        (@AlgebraicGeometry.Etale) h
    have : CategoryTheory.RepresentablyFlat B_h :=
      CategoryTheory.flat_of_preservesFiniteLimits B_h
    have hCompat : CategoryTheory.CompatiblePreserving Y₁.smallEtaleTopology B_h :=
      CategoryTheory.compatiblePreservingOfFlat Y₁.smallEtaleTopology B_h
    have hCover : CategoryTheory.CoverPreserving Y₂.smallEtaleTopology Y₁.smallEtaleTopology B_h := by
      constructor
      intro U S hS
      have hS' := (h_mem_etale Y₂ U S).mp hS
      refine (h_mem_etale Y₁ (B_h.obj U) _).mpr ?_
      intro z
      let fst_U : (B_h.obj U).left ⟶ U.left := CategoryTheory.Limits.pullback.fst U.hom h
      obtain ⟨Y, f, y, hfS, hfEt, hy⟩ := hS' (fst_U.base z)
      have h_outer : CategoryTheory.IsPullback
          ((B_h.map f).left ≫ CategoryTheory.Limits.pullback.snd U.hom h)
          (CategoryTheory.Limits.pullback.fst Y.hom h) h (f.left ≫ U.hom) := by
        have hw₁ : (B_h.map f).left ≫ CategoryTheory.Limits.pullback.snd U.hom h =
            CategoryTheory.Limits.pullback.snd Y.hom h :=
          CategoryTheory.MorphismProperty.Over.w (B_h.map f)
        have hw₂ : f.left ≫ U.hom = Y.hom := CategoryTheory.MorphismProperty.Over.w f
        rw [hw₁, hw₂]
        exact (CategoryTheory.IsPullback.of_hasPullback Y.hom h).flip
      have h_comm_left : (B_h.map f).left ≫ fst_U =
          CategoryTheory.Limits.pullback.fst Y.hom h ≫ f.left := by
        dsimp [B_h, fst_U, CategoryTheory.MorphismProperty.Over.pullback]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h_right : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd U.hom h) fst_U h U.hom :=
        (CategoryTheory.IsPullback.of_hasPullback U.hom h).flip
      have hp_left : CategoryTheory.IsPullback
          (B_h.map f).left (CategoryTheory.Limits.pullback.fst Y.hom h) fst_U f.left :=
        CategoryTheory.IsPullback.of_right h_outer h_comm_left h_right
      let e_pb := hp_left.isoPullback
      obtain ⟨p, hp_fst, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
      refine ⟨B_h.obj Y, B_h.map f, e_pb.inv.base p, ?_, ?_, ?_⟩
      · exact ⟨Y, f, 𝟙 (B_h.obj Y), hfS, (CategoryTheory.Category.id_comp _).symm⟩
      · exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hp_left.flip hfEt
      · have heq : e_pb.inv ≫ (B_h.map f).left =
            CategoryTheory.Limits.pullback.fst fst_U f.left := by
          rw [Iso.inv_comp_eq]
          exact (CategoryTheory.IsPullback.isoPullback_hom_fst hp_left).symm
        calc
          (B_h.map f).left.base (e_pb.inv.base p) = (e_pb.inv ≫ (B_h.map f).left).base p := rfl
          _ = (CategoryTheory.Limits.pullback.fst fst_U f.left).base p := by rw [heq]
          _ = z := hp_fst
    have hCont : B_h.IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCover
    let ι₂ : CategoryTheory.Functor Y₂.AffineEtale Y₂.Etale :=
      AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂
    let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology Y₂
    have : ι₂.IsContinuous J_aff Y₂.smallEtaleTopology := by
      dsimp [ι₂]
      infer_instance
    let P_ι := ι₂.sheafPushforwardContinuous AddCommGrpCat.{u} J_aff Y₂.smallEtaleTopology
    have : P_ι.IsEquivalence := by
      dsimp [P_ι, ι₂, J_aff]
      infer_instance
    let M₂ : Type u := CategoryTheory.SmallModel.{u} Y₂.AffineEtale
    let e_sm : Y₂.AffineEtale ≌ M₂ := CategoryTheory.equivSmallModel.{u} Y₂.AffineEtale
    let J_M : CategoryTheory.GrothendieckTopology M₂ := e_sm.inverse.inducedTopology J_aff
    let P_sm := e_sm.inverse.sheafPushforwardContinuous AddCommGrpCat.{u} J_M J_aff
    have : P_sm.IsEquivalence := by
      dsimp [P_sm, J_M]
      infer_instance
    let K : CategoryTheory.Functor M₂ Y₁.Etale := (e_sm.inverse.comp ι₂).comp B_h
    have : (e_sm.inverse.comp ι₂).IsContinuous J_M Y₂.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp e_sm.inverse ι₂ J_M J_aff Y₂.smallEtaleTopology
    have : K.IsContinuous J_M Y₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp (e_sm.inverse.comp ι₂) B_h J_M
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let P_push := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let P_K := K.sheafPushforwardContinuous AddCommGrpCat.{u} J_M Y₁.smallEtaleTopology
    let e_tot : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u} ≌
        CategoryTheory.Sheaf J_M AddCommGrpCat.{u} :=
      P_ι.asEquivalence.trans P_sm.asEquivalence
    have hPK : P_push.comp e_tot.functor ≅ P_K :=
      (CategoryTheory.Functor.associator P_push P_ι P_sm).symm ≪≫
        CategoryTheory.Functor.isoWhiskerLeft P_push
          (CategoryTheory.Functor.sheafPushforwardContinuousComp e_sm.inverse ι₂ AddCommGrpCat.{u}
            J_M J_aff Y₂.smallEtaleTopology).symm ≪≫
        CategoryTheory.Functor.sheafPushforwardContinuousComp (e_sm.inverse.comp ι₂) B_h
          AddCommGrpCat.{u} J_M Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    have hIso : P_K.comp e_tot.inverse ≅ P_push :=
      (CategoryTheory.Functor.isoWhiskerRight hPK.symm e_tot.inverse) ≪≫
        CategoryTheory.Functor.associator P_push e_tot.functor e_tot.inverse ≪≫
        CategoryTheory.Functor.isoWhiskerLeft P_push e_tot.unitIso.symm ≪≫
        CategoryTheory.Functor.rightUnitor P_push
    let adj_K := K.sheafAdjunctionContinuous AddCommGrpCat.{u} J_M Y₁.smallEtaleTopology
    exact ⟨hCont, (CategoryTheory.Adjunction.ofNatIsoRight (e_tot.toAdjunction.comp adj_K) hIso).isRightAdjoint⟩

  have hPullEx : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}),
      ∃ F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u},
        WeilIsEtaleSheafPullback h F₂ F₁ := by
    intro X₁ X₂ h F₂
    obtain ⟨hc, hr⟩ := h_pull_base h
    let B_h : CategoryTheory.Functor X₂.Etale X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    exact ⟨(B_h.sheafPullback AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology).obj F₂,
      ⟨hc, hr, ⟨CategoryTheory.Iso.refl _⟩⟩⟩

  have hPullConst : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (A : AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h
        ((CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj A)
        ((CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
    intro Y₁ Y₂ h A
    obtain ⟨hc, hr⟩ := h_pull_base h
    let B_h : CategoryTheory.Functor Y₂.Etale Y₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    let P_push := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let T₁ := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y₁)
    let T₂ := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y₂)
    have hT₁ : CategoryTheory.Limits.IsTerminal T₁ := h_etale_term Y₁
    have hT₂ : CategoryTheory.Limits.IsTerminal T₂ := h_etale_term Y₂
    let e_T : B_h.obj T₂ ≅ T₁ :=
      CategoryTheory.MorphismProperty.Over.isoMk (pb_id_left h)
        (CategoryTheory.Category.comp_id _)
    let adj₁ := CategoryTheory.constantSheafAdj Y₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
    let adj₂ := (CategoryTheory.constantSheafAdj Y₂.smallEtaleTopology AddCommGrpCat.{u} hT₂).comp
      (B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology)
    let Γ₁ := (CategoryTheory.sheafSections Y₁.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₁)
    let Γ₂ := (CategoryTheory.sheafSections Y₂.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₂)
    have hΓ_iso : P_push.comp Γ₂ ≅ Γ₁ :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ => ℱ.obj.mapIso e_T.op.symm)
        (fun {ℱ₁ ℱ₂} φ => by
          dsimp [P_push, Γ₁, Γ₂, CategoryTheory.sheafSections]
          exact (φ.hom.naturality e_T.inv.op).symm)
    let adj₂' := CategoryTheory.Adjunction.ofNatIsoRight adj₂ hΓ_iso
    let e_const := CategoryTheory.Adjunction.leftAdjointUniq adj₂' adj₁
    exact ⟨hc, hr, ⟨e_const.app A⟩⟩

  have hPullComp : ∀ {Y₁ Y₂ Y₃ : AlgebraicGeometry.Scheme.{u}} (h₁ : Y₁ ⟶ Y₂) (h₂ : Y₂ ⟶ Y₃)
      (F₃ : CategoryTheory.Sheaf Y₃.smallEtaleTopology AddCommGrpCat.{u})
      (F₂ : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u})
      (F₁ : CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h₂ F₃ F₂ →
      WeilIsEtaleSheafPullback h₁ F₂ F₁ →
      WeilIsEtaleSheafPullback (h₁ ≫ h₂) F₃ F₁ := by
    intro Y₁ Y₂ Y₃ h₁ h₂ F₃ F₂ F₁ ⟨hc₂, hr₂, ⟨e₂⟩⟩ ⟨hc₁, hr₁, ⟨e₁⟩⟩
    obtain ⟨hc₁₂, hr₁₂⟩ := h_pull_base (h₁ ≫ h₂)
    let B₁ : CategoryTheory.Functor Y₂.Etale Y₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h₁
    let B₂ : CategoryTheory.Functor Y₃.Etale Y₂.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h₂
    let B₁₂ : CategoryTheory.Functor Y₃.Etale Y₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ (h₁ ≫ h₂)
    have α : B₁₂ ≅ B₂.comp B₁ :=
      CategoryTheory.MorphismProperty.Over.pullbackComp h₁ h₂
    have : (B₂.comp B₁).IsContinuous Y₃.smallEtaleTopology Y₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp B₂ B₁
        Y₃.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let P₁ := B₁.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let P₂ := B₂.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₃.smallEtaleTopology Y₂.smallEtaleTopology
    let P₁₂ := B₁₂.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₃.smallEtaleTopology Y₁.smallEtaleTopology
    have hP_comp : P₁.comp P₂ ≅ P₁₂ :=
      (CategoryTheory.Functor.sheafPushforwardContinuousComp B₂ B₁ AddCommGrpCat.{u}
        Y₃.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology) ≪≫
        (CategoryTheory.Functor.sheafPushforwardContinuousIso α.symm AddCommGrpCat.{u}
          Y₃.smallEtaleTopology Y₁.smallEtaleTopology)
    let L₁ := B₁.sheafPullback AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let adj₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let adj₂ := B₂.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₃.smallEtaleTopology Y₂.smallEtaleTopology
    let adj₁₂ := B₁₂.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₃.smallEtaleTopology Y₁.smallEtaleTopology
    let β := CategoryTheory.Adjunction.leftAdjointUniq
      (CategoryTheory.Adjunction.ofNatIsoRight (adj₂.comp adj₁) hP_comp) adj₁₂
    exact ⟨hc₁₂, hr₁₂, ⟨(β.symm.app F₃) ≪≫ (L₁.mapIso e₂) ≪≫ e₁⟩⟩

  have hPullCancel : ∀ {Y₁ Y₂ Y₃ : AlgebraicGeometry.Scheme.{u}} (h₁ : Y₁ ⟶ Y₂) (h₂ : Y₂ ⟶ Y₃)
      (F₃ : CategoryTheory.Sheaf Y₃.smallEtaleTopology AddCommGrpCat.{u})
      (F₂ : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u})
      (G : CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h₂ F₃ F₂ →
      WeilIsEtaleSheafPullback (h₁ ≫ h₂) F₃ G →
      WeilIsEtaleSheafPullback h₁ F₂ G := by
    intro Y₁ Y₂ Y₃ h₁ h₂ F₃ F₂ G hPull₂ hPull₁₂
    obtain ⟨G', hPull₁⟩ := hPullEx h₁ F₂
    have hPull₁₂' := hPullComp h₁ h₂ F₃ F₂ G' hPull₂ hPull₁
    obtain ⟨hc_a, hr_a, ⟨e_a⟩⟩ := hPull₁₂
    obtain ⟨hc_b, hr_b, ⟨e_b⟩⟩ := hPull₁₂'
    cases Subsingleton.elim hc_a hc_b
    cases Subsingleton.elim hr_a hr_b
    obtain ⟨hc₁, hr₁, ⟨e₁⟩⟩ := hPull₁
    exact ⟨hc₁, hr₁, ⟨e₁ ≪≫ e_b.symm ≪≫ e_a⟩⟩

  have hConj4 : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}} (h₁ : X₁ ⟶ X₂) (h₂ : X₂ ⟶ X₃)
      (F₃ : CategoryTheory.Sheaf X₃.smallEtaleTopology AddCommGrpCat.{u})
      (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
      (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h₂ F₃ F₂ →
      (WeilIsEtaleSheafPullback h₁ F₂ F₁ ↔ WeilIsEtaleSheafPullback (h₁ ≫ h₂) F₃ F₁) := by
    intro X₁ X₂ X₃ h₁ h₂ F₃ F₂ F₁ h₂₃
    exact ⟨hPullComp h₁ h₂ F₃ F₂ F₁ h₂₃, hPullCancel h₁ h₂ F₃ F₂ F₁ h₂₃⟩

  have hTorsSh : ∀ (X : AlgebraicGeometry.Scheme.{u}),
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf X ℓ) = 0 := by
    intro X
    let C := CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}
    have : C.Additive := inferInstance
    let A_ℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    have hA : ℓ • CategoryTheory.CategoryStruct.id A_ℓ = 0 := by
      ext ⟨x⟩
      apply ULift.ext
      change ℓ • x = 0
      rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
    change ℓ • CategoryTheory.CategoryStruct.id (C.obj A_ℓ) = 0
    rw [← C.map_id, ← CategoryTheory.Functor.map_nsmul, hA, CategoryTheory.Functor.map_zero]

  have hTorsR : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) (q : ℕ)
      (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage f q F) = 0 := by
    intro X S f q F hℓF
    let B_f : CategoryTheory.Functor S.Etale X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let P_F : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Sheaf.cohomologyPresheaf F q
    let Sh : CategoryTheory.Functor (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u})
        (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    have : Sh.Additive := inferInstance
    have hβ : ℓ • CategoryTheory.Abelian.Ext.mk₀ (𝟙 F) = 0 := by
      apply CategoryTheory.Abelian.Ext.addEquiv₀.injective
      rw [map_nsmul, map_zero]
      have hid : CategoryTheory.Abelian.Ext.addEquiv₀
          (CategoryTheory.Abelian.Ext.mk₀ (𝟙 F)) = 𝟙 F :=
        CategoryTheory.Abelian.Ext.homEquiv₀.apply_symm_apply _
      rw [hid, hℓF]
    have hBP : ℓ • (𝟙 (B_f.op ⋙ P_F)) = 0 := by
      apply NatTrans.ext
      funext U
      ext x
      change ℓ • x = 0
      let E := (CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
        (yoneda.obj (B_f.obj (Opposite.unop U)) ⋙ AddCommGrpCat.free)
      let bc := (CategoryTheory.Abelian.Ext.bilinearComp E F F q 0 q (Nat.add_zero q)) x
      have hx : bc (CategoryTheory.Abelian.Ext.mk₀ (𝟙 F)) = x :=
        CategoryTheory.Abelian.Ext.comp_mk₀_id x
      have hbc : bc (ℓ • CategoryTheory.Abelian.Ext.mk₀ (𝟙 F)) = ℓ • x := by
        rw [map_nsmul, hx]
        rfl
      rw [hβ, map_zero] at hbc
      exact hbc.symm
    change ℓ • (𝟙 (Sh.obj (B_f.op ⋙ P_F))) = 0
    rw [← Sh.map_id, ← Functor.map_nsmul, hBP, Functor.map_zero]

  exact ⟨hConj1, hPullConst, hPullEx, hConj4, hTorsSh, hTorsR⟩

theorem weil_strictly_henselian_spec_etale_eval_and_pullback (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] :
    (∀ (X_A : AlgebraicGeometry.Scheme.{u})
        (f_A : X_A ⟶ AlgebraicGeometry.Spec (CommRingCat.of A)) (q : ℕ)
        (F_A : CategoryTheory.Sheaf X_A.smallEtaleTopology AddCommGrpCat.{u}),
      Nonempty ((weilEtaleHigherDirectImage f_A q F_A).H 0 ≃+ F_A.H q)) ∧
    (∀ (k₁ : Type u) [Field k₁] [IsAlgClosed k₁]
        (u_A : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of A)),
      (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₁)),
        u_A.base pt = IsLocalRing.closedPoint A) →
      ∀ (H_A : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of A)).smallEtaleTopology AddCommGrpCat.{u})
        (H_k₁ : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of k₁)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback u_A H_A H_k₁ →
        Nonempty (H_k₁.H 0 ≃+ H_A.H 0)) :=
by
  classical
  let addEquivOfIso : ∀ {G₁ G₂ : AddCommGrpCat.{u}}, (G₁ ≅ G₂) → (↥G₁ ≃+ ↥G₂) :=
    fun e =>
      { toFun := e.hom.hom
        invFun := e.inv.hom
        left_inv := fun x => by
          change (e.hom ≫ e.inv).hom x = x
          rw [e.hom_inv_id]; rfl
        right_inv := fun y => by
          change (e.inv ≫ e.hom).hom y = y
          rw [e.inv_hom_id]; rfl
        map_add' := map_add e.hom.hom }
  
  have hLift : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R]
      [IsSepClosed (IsLocalRing.ResidueField R)]
      (B : Type u) [CommRing B] [Algebra R B] [Algebra.Etale R B]
      (K : Type u) [Field K]
      (α_u : R →+* K),
      RingHom.ker α_u = IsLocalRing.maximalIdeal R →
      ∀ (φ : B →+* K), φ.comp (algebraMap R B) = α_u →
        ∃! ψ : B →ₐ[R] R, α_u.comp ψ.toRingHom = φ := by
    intro R _ _ _ B _ _ _ K _ α_u hker φ hφ
    let κ_R : Type u := IsLocalRing.ResidueField R
    let res_R : R →+* κ_R := IsLocalRing.residue R
    have hle_ker : ∀ r ∈ IsLocalRing.maximalIdeal R, α_u r = 0 :=
      fun r hr => RingHom.mem_ker.mp (hker.symm ▸ hr)
    let ι_κ : κ_R →+* K := Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) α_u hle_ker
    have hι_res : ι_κ.comp res_R = α_u := by
      ext r
      exact Ideal.Quotient.lift_mk (IsLocalRing.maximalIdeal R) α_u hle_ker
    
    let B_κ : Type u := TensorProduct R κ_R B
    have : Algebra.Etale κ_R B_κ := inferInstance
    obtain ⟨I, hFinI, L, hFieldL, hAlgL, Θ, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod κ_R B_κ).mp inferInstance
    let _ : Finite I := hFinI
    let _ : Fintype I := Fintype.ofFinite I
    let _ : ∀ i, Field (L i) := hFieldL
    let _ : ∀ i, Algebra κ_R (L i) := hAlgL
    have hSurjL : ∀ i : I, Function.Surjective (algebraMap κ_R (L i)) := by
      intro i y
      have : Algebra.IsSeparable κ_R (L i) := (hFinSep i).2
      have hy_int : IsIntegral κ_R y := Algebra.IsSeparable.isIntegral κ_R y
      let p : Polynomial κ_R := minpoly κ_R y
      have hp_monic : p.Monic := minpoly.monic hy_int
      have hp_irr : Irreducible p := minpoly.irreducible hy_int
      have hp_deg_pos : 0 < p.degree := Irreducible.degree_pos hp_irr
      have hp_sep : p.Separable := Algebra.IsSeparable.isSeparable κ_R y
      have hp_sp : p.Splits := IsSepClosed.splits_of_separable p hp_sep
      obtain ⟨c, hc⟩ := hp_sp.exists_eval_eq_zero (ne_of_gt hp_deg_pos)
      obtain ⟨q, hq⟩ := Polynomial.dvd_iff_isRoot.mpr hc
      have hq_unit : IsUnit q :=
        (hp_irr.isUnit_or_isUnit hq).resolve_left (Polynomial.not_isUnit_X_sub_C c)
      have hq_monic : q.Monic :=
        Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C c) (hq ▸ hp_monic)
      have hq_deg : q.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hq_unit
      have hq_eq : q = 1 := by
        have hlead : q.coeff 0 = 1 := by
          rw [← hq_deg]
          exact hq_monic.leadingCoeff
        rw [Polynomial.eq_C_of_natDegree_eq_zero hq_deg, hlead, map_one]
      have hp_eq : p = Polynomial.X - Polynomial.C c := by
        rw [hq, hq_eq, mul_one]
      have haeval : Polynomial.aeval y p = 0 := minpoly.aeval κ_R y
      rw [hp_eq, map_sub, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at haeval
      exact ⟨c, haeval.symm⟩
    let _ : Algebra R K := α_u.toAlgebra
    let ι_κ_alg : κ_R →ₐ[R] K :=
      { ι_κ with commutes' := fun r => congrFun (congrArg DFunLike.coe hι_res) r }
    let φ_alg : B →ₐ[R] K :=
      { φ with commutes' := fun r => congrFun (congrArg DFunLike.coe hφ) r }
    let Ψ_κ : B_κ →ₐ[R] K :=
      Algebra.TensorProduct.lift ι_κ_alg φ_alg (fun _ _ => Commute.all _ _)
    let χ : (∀ i : I, L i) →+* K := Ψ_κ.toRingHom.comp Θ.symm.toRingHom
    have hex_i₀ : ∃ i₀ : I, χ (Pi.single i₀ 1) ≠ 0 := by
      by_contra! hall
      have h1 : (1 : ∀ i : I, L i) = ∑ i : I, Pi.single i (1 : L i) := by
        ext j; simp [Finset.sum_apply]
      have h0 : (1 : K) = 0 := by
        calc
          (1 : K) = χ 1 := (map_one χ).symm
          _ = ∑ i : I, χ (Pi.single i 1) := by rw [h1, map_sum]
          _ = 0 := Finset.sum_eq_zero (fun i _ => hall i)
      exact one_ne_zero h0
    obtain ⟨i₀, hi₀_ne⟩ := hex_i₀
    have hi₀_one : χ (Pi.single i₀ 1) = 1 := by
      have hidem : χ (Pi.single i₀ 1) * χ (Pi.single i₀ 1) = χ (Pi.single i₀ 1) := by
        rw [← map_mul]
        congr 1
        ext j
        by_cases hj : j = i₀
        · subst hj; simp
        · simp [Pi.single_eq_of_ne hj]
      exact mul_left_cancel₀ hi₀_ne (hidem.trans (mul_one _).symm)
    have hχ_kill : ∀ v : (∀ i : I, L i), v i₀ = 0 → χ v = 0 := by
      intro v hv
      have hprod : Pi.single i₀ (1 : L i₀) * v = 0 := by
        ext j
        by_cases hj : j = i₀
        · subst hj; simp [hv]
        · simp [Pi.single_eq_of_ne hj]
      calc
        χ v = 1 * χ v := (one_mul _).symm
        _ = χ (Pi.single i₀ 1) * χ v := by rw [hi₀_one]
        _ = χ (Pi.single i₀ 1 * v) := (map_mul χ _ _).symm
        _ = 0 := by rw [hprod, map_zero]
    let lam : L i₀ →+* K :=
      { toFun := fun x => χ (Pi.single i₀ x)
        map_one' := hi₀_one
        map_mul' := fun x y => by
          rw [← map_mul]
          congr 1
          ext j
          by_cases hj : j = i₀
          · subst hj; simp
          · simp [Pi.single_eq_of_ne hj]
        map_zero' := by rw [Pi.single_zero, map_zero]
        map_add' := fun x y => by rw [Pi.single_add, map_add] }
    have hχ_eq : ∀ v : (∀ i : I, L i), χ v = lam (v i₀) := by
      intro v
      have hdiff : χ (v - Pi.single i₀ (v i₀)) = 0 := by
        apply hχ_kill; simp
      exact sub_eq_zero.mp ((map_sub χ v _).symm.trans hdiff)
    let e_i₀ : κ_R ≃+* L i₀ :=
      RingEquiv.ofBijective (algebraMap κ_R (L i₀)) ⟨RingHom.injective _, hSurjL i₀⟩
    have hlam_e : ∀ c : κ_R, lam (e_i₀ c) = ι_κ c := by
      intro c
      have hcoord : (algebraMap κ_R (∀ i : I, L i) c) i₀ = e_i₀ c := rfl
      rw [← hcoord, ← hχ_eq]
      change Ψ_κ (Θ.symm (algebraMap κ_R (∀ i : I, L i) c)) = ι_κ c
      rw [Θ.symm.commutes]
      change Ψ_κ (TensorProduct.tmul R c 1) = ι_κ c
      erw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      rfl
    let π_B : B →+* L i₀ :=
      (Pi.evalRingHom L i₀).comp
        (Θ.toRingHom.comp (Algebra.TensorProduct.includeRight : B →ₐ[R] B_κ).toRingHom)
    let ψ₀ : B →ₐ[R] κ_R :=
      { (e_i₀.symm.toRingHom.comp π_B) with
        commutes' := fun r => by
          change e_i₀.symm ((Θ (TensorProduct.tmul R (1 : κ_R) (algebraMap R B r))) i₀) =
            algebraMap R κ_R r
          have htmul : TensorProduct.tmul R (1 : κ_R) (algebraMap R B r) =
              algebraMap κ_R B_κ (algebraMap R κ_R r) := by
            calc
              TensorProduct.tmul R (1 : κ_R) (algebraMap R B r)
                = TensorProduct.tmul R (1 : κ_R) (r • (1 : B)) := by
                    rw [Algebra.smul_def, mul_one]
              _ = TensorProduct.tmul R (r • (1 : κ_R)) (1 : B) := by
                    rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul']
              _ = algebraMap κ_R B_κ (algebraMap R κ_R r) := by
                    rw [Algebra.smul_def, mul_one]; rfl
          rw [htmul, Θ.commutes]
          exact e_i₀.symm_apply_apply (algebraMap R κ_R r) }
    have hψ₀_fac : ∀ b : B, ι_κ (ψ₀ b) = φ b := by
      intro b
      change ι_κ (e_i₀.symm (π_B b)) = φ b
      rw [← hlam_e, e_i₀.apply_symm_apply]
      change lam ((Θ (TensorProduct.tmul R 1 b)) i₀) = φ b
      rw [← hχ_eq]
      change Ψ_κ (Θ.symm (Θ (TensorProduct.tmul R 1 b))) = φ b
      rw [AlgEquiv.symm_apply_apply]
      erw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    
    let Q : Ideal B := RingHom.ker ψ₀.toRingHom
    have : Q.IsPrime := RingHom.ker_isPrime ψ₀.toRingHom
