      have h1 : q_R e = q_R w * (q_R (Polynomial.aeval x u₀) * q_R (Polynomial.aeval x F)) :=
        (q_R.map_mul w _).trans (congrArg (q_R w * ·)
          ((congrArg q_R (map_mul (Polynomial.aeval x) u₀ F)).trans (q_R.map_mul _ _)))
      have h2 : q_R (Polynomial.aeval x u₀) = Polynomial.eval₂ ι_k e_bar u_bar := by
        refine (hq_aeval_map u₀).trans ?_
        dsimp [u₀]
        rw [Polynomial.map_map, hcomp_id, Polynomial.map_id]
      have h3 : q_R (Polynomial.aeval x F) = e_bar := by
        refine (hq_aeval_map F).trans ?_
        rw [hF_res, Polynomial.eval₂_X_pow, he_bar_pow a ha_pos]
