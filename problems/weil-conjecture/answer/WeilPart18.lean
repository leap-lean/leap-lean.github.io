      have := hAffU'.isLocalization_basicOpen b
      obtain ⟨φ₁, hFinΦ₁, hCommΦ₁⟩ := hLift ↑(Z.presheaf.obj (Opposite.op U))
      let S'₁ := Localization.Away (algebraMap R₀ S₀ b)
      let S₁ := Localization.Away e
      have : IsDomain S₁ := hDomS₁
      let ψ_S : S₀ →+* S₁ := (algebraMap S'₁ S₁).comp (algebraMap S₀ S'₁)
      have hOpenΨ : AlgebraicGeometry.IsOpenImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S)) := by
        have hcomp_hom : CommRingCat.ofHom ψ_S =
            CommRingCat.ofHom (algebraMap S₀ S'₁) ≫ CommRingCat.ofHom (algebraMap S'₁ S₁) :=
          CommRingCat.ofHom_comp (algebraMap S₀ S'₁) (algebraMap S'₁ S₁)
        rw [hcomp_hom, AlgebraicGeometry.Spec.map_comp]
        have : AlgebraicGeometry.IsOpenImmersion
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₀ S'₁))) :=
          AlgebraicGeometry.IsOpenImmersion.of_isLocalization (algebraMap R₀ S₀ b)
        have : AlgebraicGeometry.IsOpenImmersion
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S'₁ S₁))) :=
          AlgebraicGeometry.IsOpenImmersion.of_isLocalization e
        infer_instance
      have hNontrivR₁ : Nontrivial ↑(Z.presheaf.obj (Opposite.op U)) := by
        refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
        have h01' :
            algebraMap R₀ ↑(Z.presheaf.obj (Opposite.op U)) 0 =
              algebraMap R₀ ↑(Z.presheaf.obj (Opposite.op U)) 1 := by
          rw [map_zero, map_one]; exact h01
        obtain ⟨⟨_, n, rfl⟩, hbn⟩ :=
          (IsLocalization.eq_iff_exists (Submonoid.powers b)
            ↑(Z.presheaf.obj (Opposite.op U))).mp h01'
        simp only [mul_zero, mul_one] at hbn
        exact pow_ne_zero n hb hbn.symm
      obtain ⟨z_spec⟩ :=
        (@PrimeSpectrum.instNonemptyOfNontrivial _ _ hNontrivR₁ :
          Nonempty ↥(AlgebraicGeometry.Spec (Z.presheaf.obj (Opposite.op U))))
      have hNeU : Nonempty U := ⟨hAffU.isoSpec.inv.base z_spec⟩
      have : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) := hNeU
      have hIntU : AlgebraicGeometry.IsIntegral (U : AlgebraicGeometry.Scheme.{u}) :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion U.ι
      have : IrreducibleSpace ↥(U : AlgebraicGeometry.Scheme.{u}) :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral (U : AlgebraicGeometry.Scheme.{u})
      let V : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of S₁)
      have : IsDomain ↑(CommRingCat.of S₁) := hDomS₁
      have : IrreducibleSpace ↥V := inferInstance
      have : ConnectedSpace ↥V := inferInstance
      let jY : V ⟶ Y := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S) ≫ Y.isoSpec.inv
      have : AlgebraicGeometry.IsOpenImmersion jY := inferInstance
      have : AlgebraicGeometry.IsFinite (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)) :=
        (AlgebraicGeometry.IsFinite.SpecMap_iff (CommRingCat.ofHom φ₁)).mpr hFinΦ₁
      let p : V ⟶ (U : AlgebraicGeometry.Scheme.{u}) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ hAffU.isoSpec.inv
      have hFin_p : AlgebraicGeometry.IsFinite p := inferInstance
      have hSub₁ : U ≤ U' := Z.basicOpen_le b
      let ρ_b := Z.presheaf.map (CategoryTheory.homOfLE hSub₁).op
      have hRingComm : ρ_b ≫ CommRingCat.ofHom φ₁ = φ₀ ≫ CommRingCat.ofHom ψ_S := by
        ext x
        exact RingHom.congr_fun hCommΦ₁ x
      have hSpecComm :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ AlgebraicGeometry.Spec.map ρ_b =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S) ≫ AlgebraicGeometry.Spec.map φ₀ := by
        rw [← AlgebraicGeometry.Spec.map_comp, hRingComm, AlgebraicGeometry.Spec.map_comp]
      have hOpenNat :
          hAffU.isoSpec.hom ≫ AlgebraicGeometry.Spec.map ρ_b =
            Z.homOfLE hSub₁ ≫ hAffU'.isoSpec.hom := by
        rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom, AlgebraicGeometry.IsAffineOpen.isoSpec_hom]
        exact AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map U U' hSub₁
      have hSqU' : p ≫ Z.homOfLE hSub₁ = jY ≫ q := by
        apply (cancel_mono hAffU'.isoSpec.hom).mp
        calc
          (p ≫ Z.homOfLE hSub₁) ≫ hAffU'.isoSpec.hom
              = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ hAffU.isoSpec.inv ≫
                  (Z.homOfLE hSub₁ ≫ hAffU'.isoSpec.hom) := by
                simp only [p, Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ hAffU.isoSpec.inv ≫
                hAffU.isoSpec.hom ≫ AlgebraicGeometry.Spec.map ρ_b := by
                rw [← hOpenNat]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫
                AlgebraicGeometry.Spec.map ρ_b := by
                rw [Iso.inv_hom_id_assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S) ≫
                AlgebraicGeometry.Spec.map φ₀ := hSpecComm
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S) ≫ Y.isoSpec.inv ≫
                (Y.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ₀) := by
                rw [Iso.inv_hom_id_assoc]
          _ = (jY ≫ q) ≫ hAffU'.isoSpec.hom := by
                rw [hφ₀]; simp only [jY, Category.assoc]
      have hCommU' : p ≫ U.ι = jY ≫ q ≫ U'.ι := by
        calc
          p ≫ U.ι = p ≫ (Z.homOfLE hSub₁ ≫ U'.ι) := by rw [Z.homOfLE_ι hSub₁]
          _ = (p ≫ Z.homOfLE hSub₁) ≫ U'.ι := (Category.assoc _ _ _).symm
          _ = (jY ≫ q) ≫ U'.ι := by rw [hSqU']
          _ = jY ≫ q ≫ U'.ι := Category.assoc _ _ _
      have hEt_comp : AlgebraicGeometry.Etale (p ≫ U.ι) := by
        rw [hCommU']; infer_instance
      have hEt_p : AlgebraicGeometry.Etale p :=
        CategoryTheory.MorphismProperty.of_postcomp
          (@AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
          p U.ι inferInstance hEt_comp
      have := hEt_p
      have hClopen : IsClopen (Set.range p.base) :=
        ⟨p.isClosedMap.isClosed_range, p.isOpenMap.isOpen_range⟩
      have hSurj_p : AlgebraicGeometry.Surjective p :=
        AlgebraicGeometry.Surjective.mk
          (Set.range_eq_univ.mp (hClopen.eq_univ (Set.range_nonempty p.base)))
      let g₁ : V ⟶ V₁ := jY ≫ π₁ ≫ u₁
      let g₂ : V ⟶ V₂ := jY ≫ π₂ ≫ u₂
      have hq₁_comm : q₁' ≫ U'.ι = u₁ ≫ p₁ ≫ U₁.ι := by
        rw [← Z.homOfLE_ι (le_trans hU'_le inf_le_left)]
        change CategoryTheory.Limits.pullback.snd p₁ inc₁ ≫ inc₁ ≫ U₁.ι =
          CategoryTheory.Limits.pullback.fst p₁ inc₁ ≫ p₁ ≫ U₁.ι
        rw [CategoryTheory.Limits.pullback.condition_assoc]
      have hq₂_comm : q₂' ≫ U'.ι = u₂ ≫ p₂ ≫ U₂.ι := by
        rw [← Z.homOfLE_ι (le_trans hU'_le inf_le_right)]
        change CategoryTheory.Limits.pullback.snd p₂ inc₂ ≫ inc₂ ≫ U₂.ι =
          CategoryTheory.Limits.pullback.fst p₂ inc₂ ≫ p₂ ≫ U₂.ι
        rw [CategoryTheory.Limits.pullback.condition_assoc]
      have hg₁ : p ≫ (U.ι ≫ iZ) = g₁ ≫ (p₁ ≫ (U₁.ι ≫ iZ)) := by
        rw [← Category.assoc p U.ι iZ, hCommU']
        dsimp only [q, g₁]
        simp only [Category.assoc, hq₁_comm]
      have hg₂ : p ≫ (U.ι ≫ iZ) = g₂ ≫ (p₂ ≫ (U₂.ι ≫ iZ)) := by
        have hπ_comm : π₁ ≫ q₁' = π₂ ≫ q₂' := CategoryTheory.Limits.pullback.condition
        rw [← Category.assoc p U.ι iZ, hCommU']
        dsimp only [q, g₂]
        rw [hπ_comm]
        simp only [Category.assoc, hq₂_comm]
      let C_V := CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}
      let q_X : V ⟶ X.left := p ≫ (U.ι ≫ iZ)
      have hPullV₁ : WeilIsEtaleSheafPullback q_X G₁ (C_V.obj A₁) := by
        have hP := (hPullComp g₁ (p₁ ≫ (U₁.ι ≫ iZ)) G₁ _ _).1 hPull₁ (hPullConst g₁ A₁)
        rwa [← hg₁] at hP
      have hPullV₂ : WeilIsEtaleSheafPullback q_X G₂ (C_V.obj A₂) := by
        have hP := (hPullComp g₂ (p₂ ≫ (U₂.ι ≫ iZ)) G₂ _ _).1 hPull₂ (hPullConst g₂ A₂)
        rwa [← hg₂] at hP
      obtain ⟨ψ, hPull_ker, -⟩ := hPullKer q_X G₁ G₂ φ (C_V.obj A₁) (C_V.obj A₂) hPullV₁ hPullV₂
      obtain ⟨α, hα⟩ := hConstFull V A₁ A₂ ψ
      let A : AddCommGrpCat.{u} := CategoryTheory.Limits.kernel α
      have hFinA : Finite A := by
        have : Finite ↥A₁ := hFinA₁
        have hInj : Function.Injective (CategoryTheory.Limits.kernel.ι α) :=
          (AddCommGrpCat.mono_iff_injective (CategoryTheory.Limits.kernel.ι α)).mp inferInstance
        exact Finite.of_injective _ hInj
      have hTorA : ℓ • CategoryTheory.CategoryStruct.id A = 0 := by
        apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι α)).mp
        calc
          (ℓ • CategoryTheory.CategoryStruct.id A) ≫ CategoryTheory.Limits.kernel.ι α =
              ℓ • (𝟙 _ ≫ CategoryTheory.Limits.kernel.ι α) :=
            CategoryTheory.Preadditive.nsmul_comp _ _ _
          _ = ℓ • (CategoryTheory.Limits.kernel.ι α ≫ 𝟙 A₁) := by
            rw [Category.id_comp, Category.comp_id]
          _ = CategoryTheory.Limits.kernel.ι α ≫ (ℓ • CategoryTheory.CategoryStruct.id A₁) :=
            (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
          _ = 0 ≫ CategoryTheory.Limits.kernel.ι α := by
            rw [hTorA₁, CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.zero_comp]
      have : CategoryTheory.Limits.PreservesFiniteLimits C_V :=
        CategoryTheory.Limits.comp_preservesFiniteLimits
          (CategoryTheory.Functor.const (Opposite V.Etale))
          (CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u})
      let e_ker : CategoryTheory.Limits.kernel ψ ≅ C_V.obj A :=
        CategoryTheory.Limits.kernel.mapIso ψ (C_V.map α)
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (by simp [hα, C_V]) ≪≫
          (CategoryTheory.Limits.PreservesKernel.iso C_V α).symm
      exact ⟨U, hNeU, V, p, A, hFin_p, hEt_p, hSurj_p, hFinA, hTorA,
        hPullIso q_X (CategoryTheory.Limits.kernel φ) (CategoryTheory.Limits.kernel φ)
          (CategoryTheory.Limits.kernel ψ) (C_V.obj A) hPull_ker
          ⟨CategoryTheory.Iso.refl _⟩ ⟨e_ker⟩⟩

theorem weil_etale_closed_subscheme_unit_excision (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType X.hom]
    [AlgebraicGeometry.IsSeparated X.hom] :
    (∀ (D : TopologicalSpace.Closeds ↥X.left)
        (G_D : CategoryTheory.Sheaf
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subscheme.smallEtaleTopology
          AddCommGrpCat.{u}),
      WeilIsConstructibleModPrimeSheaf ℓ
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subscheme G_D →
      WeilIsConstructibleModPrimeSheaf ℓ X.left
        (weilEtaleHigherDirectImage
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subschemeι 0 G_D) ∧
      (∀ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ X.left) [AlgebraicGeometry.Etale w],
        Set.range w.base ⊆ (D : Set ↥X.left)ᶜ →
        Subsingleton ↥((weilEtaleHigherDirectImage
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D).subschemeι 0 G_D).obj.obj
          (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk w))))) ∧
    (∀ (C C₁ C₂ : TopologicalSpace.Closeds ↥X.left)
        (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})
        (F_C₁ : CategoryTheory.Sheaf
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C₁).subscheme.smallEtaleTopology
          AddCommGrpCat.{u}),
      C = C₁ ⊔ C₂ →
      WeilIsConstructibleModPrimeSheaf ℓ X.left F →
      WeilIsEtaleSheafPullback
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C₁).subschemeι F F_C₁ →
      (∀ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ X.left) [AlgebraicGeometry.Etale w],
        Set.range w.base ⊆ (C : Set ↥X.left)ᶜ →
        Subsingleton ↥(F.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk w)))) →
      ∃ (η : F ⟶ weilEtaleHigherDirectImage
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C₁).subschemeι 0 F_C₁)
        (S : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})),
        S.ShortExact ∧
        S.X₁ = CategoryTheory.Limits.kernel η ∧
        S.X₂ = F ∧
        S.X₃ = weilEtaleHigherDirectImage
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C₁).subschemeι 0 F_C₁ ∧
        (∀ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ X.left) [AlgebraicGeometry.Etale w],
          Set.range w.base ⊆ (C₂ : Set ↥X.left)ᶜ →
          Subsingleton ↥((CategoryTheory.Limits.kernel η).obj.obj
            (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk w))))) :=
by
  classical
  
  have hCont : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : W₁ ⟶ W₂),
      (weilCompEtaleSitePullback h).IsContinuous
        W₂.smallEtaleTopology W₁.smallEtaleTopology := by
    intro W₁ W₂ h
    let B_h := weilCompEtaleSitePullback h
    have : (CategoryTheory.Over.pullback h).IsRightAdjoint :=
      (CategoryTheory.Over.mapPullbackAdj h).isRightAdjoint
    have : CategoryTheory.Limits.PreservesFiniteLimits
        (B_h.comp (AlgebraicGeometry.Scheme.Etale.forget W₁)) := by
      change CategoryTheory.Limits.PreservesFiniteLimits
        ((AlgebraicGeometry.Scheme.Etale.forget W₂).comp (CategoryTheory.Over.pullback h))
      infer_instance
    have : CategoryTheory.Limits.PreservesFiniteLimits B_h :=
      CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves B_h
        (AlgebraicGeometry.Scheme.Etale.forget W₁)
    have : CategoryTheory.RepresentablyFlat B_h :=
      CategoryTheory.flat_of_preservesFiniteLimits B_h
    apply CategoryTheory.Functor.isContinuous_of_coverPreserving
      (CategoryTheory.compatiblePreservingOfFlat W₁.smallEtaleTopology B_h)
    refine ⟨fun {E₂} S hS => ?_⟩
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    obtain ⟨𝒰, covOv, hEt_j, hle⟩ :=
      (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology (P := P_et) E₂ S).mp hS
    let _ := covOv
    obtain ⟨hSurj_𝒰, hEt_f⟩ :=
      (AlgebraicGeometry.Scheme.presieve₀_mem_precoverage_iff 𝒰.toPreZeroHypercover).mp 𝒰.mem₀
    let Y_j : ∀ j : 𝒰.I₀, W₂.Etale := fun j => (𝒰.X j).asOverProp W₂ (hEt_j j)
    let u_j : ∀ j : 𝒰.I₀, Y_j j ⟶ E₂ := fun j =>
      AlgebraicGeometry.Scheme.Hom.asOverProp (𝒰.f j) W₂ (hX := hEt_j j) (hY := E₂.prop)
    let hE₂ : E₂.left ⟶ W₂ := E₂.hom
    let hYj : ∀ j : 𝒰.I₀, 𝒰.X j ⟶ W₂ := fun j => (Y_j j).hom
    let fj : ∀ j : 𝒰.I₀, 𝒰.X j ⟶ E₂.left := fun j => 𝒰.f j
    let 𝒰' : CategoryTheory.PreZeroHypercover.{u} (B_h.obj E₂).left :=
      { I₀ := 𝒰.I₀
        X := fun j => (B_h.obj (Y_j j)).left
        f := fun j => (B_h.map (u_j j)).left }
    have hPbLeft : ∀ j : 𝒰.I₀,
        CategoryTheory.IsPullback (𝒰'.f j)
          (CategoryTheory.Limits.pullback.fst (hYj j) h)
          (CategoryTheory.Limits.pullback.fst hE₂ h)
          (fj j) := by
      intro j
      let mapj : CategoryTheory.Limits.pullback (hYj j) h ⟶
          CategoryTheory.Limits.pullback hE₂ h :=
        (B_h.map (u_j j)).left
      have h_u_w : fj j ≫ hE₂ = hYj j := CategoryTheory.MorphismProperty.Over.w (u_j j)
      have s_sq : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd (hYj j) h)
          (CategoryTheory.Limits.pullback.fst (hYj j) h)
          h (fj j ≫ hE₂) := by
        rw [h_u_w]
        exact (CategoryTheory.IsPullback.of_hasPullback (hYj j) h).flip
      have t_sq : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd hE₂ h)
          (CategoryTheory.Limits.pullback.fst hE₂ h)
          h hE₂ :=
        (CategoryTheory.IsPullback.of_hasPullback hE₂ h).flip
      have h_pb := CategoryTheory.IsPullback.of_right' s_sq t_sq
      have h_lift_eq : t_sq.lift (CategoryTheory.Limits.pullback.snd (hYj j) h)
          (CategoryTheory.Limits.pullback.fst (hYj j) h ≫ fj j) s_sq.w = mapj := by
        apply t_sq.hom_ext
        · exact (t_sq.lift_fst _ _ _).trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
        · exact (t_sq.lift_snd _ _ _).trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      exact Eq.mp (congrArg (fun k => CategoryTheory.IsPullback k
        (CategoryTheory.Limits.pullback.fst (hYj j) h)
        (CategoryTheory.Limits.pullback.fst hE₂ h) (fj j)) h_lift_eq) h_pb
    have hmem' : 𝒰'.presieve₀ ∈
        (AlgebraicGeometry.Scheme.precoverage P_et).coverings (B_h.obj E₂).left := by
      refine (AlgebraicGeometry.Scheme.presieve₀_mem_precoverage_iff 𝒰').mpr ⟨?_, ?_⟩
      · intro z
        obtain ⟨j, y_j, hy_j⟩ :=
          hSurj_𝒰 ((CategoryTheory.Limits.pullback.fst hE₂ h).base z)
        obtain ⟨w_pb, hw_pb₁, -⟩ :=
          @AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback _ _ _
            (CategoryTheory.Limits.pullback.fst hE₂ h) (fj j) z y_j hy_j.symm
        let isoPb := (hPbLeft j).isoPullback
        refine ⟨j, isoPb.inv.base w_pb, ?_⟩
        have h_inv_fst : isoPb.inv ≫ 𝒰'.f j =
            CategoryTheory.Limits.pullback.fst
              (CategoryTheory.Limits.pullback.fst hE₂ h) (fj j) :=
          CategoryTheory.IsPullback.isoPullback_inv_fst (hPbLeft j)
        exact (congrArg (fun k => k.base w_pb) h_inv_fst).trans hw_pb₁
      · intro j
        exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := P_et) (hPbLeft j).flip (hEt_f j)
    refine (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology
      (P := P_et) (B_h.obj E₂) (CategoryTheory.Sieve.functorPushforward B_h S)).mpr ?_
    let covOv' := @AlgebraicGeometry.Scheme.Cover.Over.mk W₁ P_et _ _ (B_h.obj E₂).left _
      { toPreZeroHypercover := 𝒰', mem₀ := hmem' }
      (fun j => ⟨(B_h.obj (Y_j j)).hom⟩)
      (fun j => ⟨CategoryTheory.MorphismProperty.Over.w (B_h.map (u_j j))⟩)
    refine ⟨{ toPreZeroHypercover := 𝒰', mem₀ := hmem' }, covOv',
      fun j => (B_h.obj (Y_j j)).prop, ?_⟩
    intro Z g hg
    rcases hg with ⟨j⟩
    have h_img : (CategoryTheory.Sieve.functorPushforward B_h S).arrows (B_h.map (u_j j)) :=
      CategoryTheory.Sieve.image_mem_functorPushforward B_h S
        (hle (Y_j j) (u_j j) (CategoryTheory.Presieve.ofArrows.mk j))
    refine Eq.mp (congrArg
      (@CategoryTheory.Sieve.arrows _ _ _ (CategoryTheory.Sieve.functorPushforward B_h S)
        (B_h.obj (Y_j j))) ?_) h_img
    exact (AlgebraicGeometry.Scheme.Etale.forget W₁).map_injective
      (CategoryTheory.Over.OverMorphism.ext rfl)
  have hPushAdd : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : W₁ ⟶ W₂)
      [(weilCompEtaleSitePullback h).IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology],
      ((weilCompEtaleSitePullback h).sheafPushforwardContinuous
        AddCommGrpCat.{u} W₂.smallEtaleTopology W₁.smallEtaleTopology).Additive := by
    intro W₁ W₂ h _
    exact { map_add := CategoryTheory.Sheaf.hom_ext rfl }
  have hPullEx : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}),
      ∃ (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback h F₂ F₁ ∧
        (ℓ • CategoryTheory.CategoryStruct.id F₂ = 0 →
          ℓ • CategoryTheory.CategoryStruct.id F₁ = 0) ∧
