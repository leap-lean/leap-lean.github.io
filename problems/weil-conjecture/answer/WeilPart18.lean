        rw [map_sub, map_mul] at h0
        exact sub_eq_zero.mp h0
      have hw_orth : ∀ i j : I, i ≠ j → w_bar i * w_bar j = 0 := by
        intro i j hij
        have h0 : ν_h (δ₂ i j) = 0 :=
          hν_zero_of_nil _ (ht₂_spec (i, j) R_h ρ hρ_comp hUnit_h₀_Rh (unit_of_dvd_h _ (hdvd_t₂ i j)))
        dsimp [δ₂, w_bar] at h0 ⊢
        rw [if_neg hij, map_mul] at h0
        exact h0
