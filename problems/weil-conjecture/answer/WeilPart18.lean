        rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
          Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
          P_Z.algebraMap_apply]
        change φ_poly P_Q.jacobiMatrix.det = aeval_Z P_Z.jacobiMatrix.det
        change aeval_Z ((MvPolynomial.map π) P_Q.jacobiMatrix.det) = aeval_Z P_Z.jacobiMatrix.det
