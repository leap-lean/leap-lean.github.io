  have hIdPushNatIso : ∀ (V : AlgebraicGeometry.Scheme.{u})
      [(weilCompEtaleSitePullback (𝟙 V)).IsContinuous V.smallEtaleTopology V.smallEtaleTopology],
      Nonempty
        (((weilCompEtaleSitePullback (𝟙 V)).sheafPushforwardContinuous
            AddCommGrpCat.{u} V.smallEtaleTopology V.smallEtaleTopology) ≅
          CategoryTheory.Functor.id
            (CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u})) := by
    intro V _
    let B_id := weilCompEtaleSitePullback (𝟙 V)
    have hCompId : ∀ (E : V.Etale),
        ∃ eE : B_id.obj E ≅ E,
          eE.hom.left = CategoryTheory.Limits.pullback.fst E.hom (𝟙 V) := by
      intro E
      let hE : E.left ⟶ V := E.hom
      let fstE : CategoryTheory.Limits.pullback hE (𝟙 V) ⟶ E.left :=
        CategoryTheory.Limits.pullback.fst hE (𝟙 V)
      let sndE : CategoryTheory.Limits.pullback hE (𝟙 V) ⟶ V :=
        CategoryTheory.Limits.pullback.snd hE (𝟙 V)
      let invFst : E.left ⟶ CategoryTheory.Limits.pullback hE (𝟙 V) :=
        CategoryTheory.Limits.pullback.lift (𝟙 E.left) hE
          (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
      have h_fst_inv : fstE ≫ invFst = 𝟙 (CategoryTheory.Limits.pullback hE (𝟙 V)) := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp [fstE, invFst]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · dsimp [fstE, invFst]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.id_comp]
      have h_inv_fst : invFst ≫ fstE = 𝟙 E.left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      let homE : B_id.obj E ⟶ E :=
        CategoryTheory.MorphismProperty.Over.homMk fstE
          (by
            change fstE ≫ hE = sndE
            rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id])
      let invE : E ⟶ B_id.obj E :=
        CategoryTheory.MorphismProperty.Over.homMk invFst
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
