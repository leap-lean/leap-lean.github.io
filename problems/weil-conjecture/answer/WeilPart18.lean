      ∃ σ : U ⟶ Y, σ ≫ f = 𝟙 U ∧ AlgebraicGeometry.Etale σ := by
    intro U _ _ p_U _ Y _ f _
    have hU_top : IsAffineOpen (⊤ : U.Opens) := isAffineOpen_top U
    let R_cat : CommRingCat.{u} := U.presheaf.obj (Opposite.op ⊤)
    let R : Type u := ↑R_cat
    have hFromSpec_eq : hU_top.fromSpec = U.isoSpec.inv := IsAffineOpen.fromSpec_top
    have hIso_from : IsIso hU_top.fromSpec := by
      rw [hFromSpec_eq]
      infer_instance
    let inv_from : U ⟶ Spec R_cat := @CategoryTheory.inv _ _ _ _ hU_top.fromSpec hIso_from
    have h_inv_hom : inv_from ≫ hU_top.fromSpec = 𝟙 U :=
      @IsIso.inv_hom_id _ _ _ _ hU_top.fromSpec hIso_from
    have h_hom_inv : hU_top.fromSpec ≫ inv_from = 𝟙 (Spec R_cat) :=
      @IsIso.hom_inv_id _ _ _ _ hU_top.fromSpec hIso_from
    let p₀ : PrimeSpectrum R := inv_from.base default
    have hUniq_spec : ∀ pt : PrimeSpectrum R, pt = p₀ := by
      intro pt
      have h1 : hU_top.fromSpec.base pt = default := Subsingleton.elim _ _
      have h2 : inv_from.base (hU_top.fromSpec.base pt) = p₀ := congrArg inv_from.base h1
      rw [← Scheme.Hom.comp_apply hU_top.fromSpec inv_from pt, h_hom_inv] at h2
