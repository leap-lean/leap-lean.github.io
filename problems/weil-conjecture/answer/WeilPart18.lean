        (hIff_R (CategoryTheory.Limits.cokernel ψ) _).mpr ⟨e_coker⟩⟩⟩

  
  have hQ_retract : ∀ G₁ G₂ (i : G₁ ⟶ G₂) (r : G₂ ⟶ G₁),
      i ≫ r = 𝟙 G₁ → Q G₂ → Q G₁ := by
    intro G₁ G₂ i r hir hG₂
    let ε : G₂ ⟶ G₂ := 𝟙 G₂ - r ≫ i
    have hiε : i ≫ ε = 0 := by
      dsimp [ε]
      rw [CategoryTheory.Preadditive.comp_sub, Category.comp_id, ← Category.assoc, hir,
        Category.id_comp, sub_self]
    let kf := CategoryTheory.Limits.KernelFork.ofι i hiε
    let hkf : CategoryTheory.Limits.IsLimit kf :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι i hiε
        (fun g' _ => g' ≫ r)
        (fun g' hg' => by
          have hsub : g' - (g' ≫ r) ≫ i = 0 := by
            simpa [ε, CategoryTheory.Preadditive.comp_sub, Category.assoc] using hg'
          exact (sub_eq_zero.mp hsub).symm)
        (fun g' _ m hm => by
          calc
            m = m ≫ 𝟙 G₁ := (Category.comp_id m).symm
            _ = m ≫ (i ≫ r) := by rw [hir]
            _ = (m ≫ i) ≫ r := (Category.assoc m i r).symm
            _ = g' ≫ r := by rw [hm])
    let e_ret : G₁ ≅ CategoryTheory.Limits.kernel ε :=
      CategoryTheory.Limits.IsLimit.conePointUniqueUpToIso hkf
        (CategoryTheory.Limits.limit.isLimit _)
    rcases (hQ_ker_coker G₂ G₂ ε hG₂ hG₂).1 with
      ⟨hℓK, U, hU, V, p, A, hFin_p, hEt_p, hSurj_p, hFinA, hℓA, hPullK⟩
    have hℓG₁ : ℓ • CategoryTheory.CategoryStruct.id G₁ = 0 := by
      calc
        ℓ • 𝟙 G₁ = ℓ • (e_ret.hom ≫ 𝟙 (CategoryTheory.Limits.kernel ε) ≫ e_ret.inv) := by
          rw [Category.id_comp, e_ret.hom_inv_id]
        _ = e_ret.hom ≫ (ℓ • 𝟙 (CategoryTheory.Limits.kernel ε)) ≫ e_ret.inv := by
          rw [← CategoryTheory.Preadditive.comp_nsmul, ← CategoryTheory.Preadditive.nsmul_comp]
        _ = 0 := by
          rw [hℓK, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    haveI := hEt_p
    exact ⟨hℓG₁, U, hU, V, p, A, hFin_p, hEt_p, hSurj_p, hFinA, hℓA,
      hPullIso (p ≫ U.ι) inferInstance _ G₁ _ _ e_ret hPullK (CategoryTheory.Iso.refl _)⟩

  
  have hQ_ext : ∀ (T : CategoryTheory.ShortComplex
      (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})),
      T.ShortExact → ℓ • 𝟙 T.X₂ = 0 → Q T.X₁ → Q T.X₃ → Q T.X₂ := by
    intro T hSE hℓ₂ hQX₁ hQX₃
    rcases hQX₁ with ⟨_, U₁, hU₁, V₁, p₁, A₁, hFin_p₁, hEt_p₁, hSurj_p₁, hFinA₁, hℓA₁, hPull₁⟩
    rcases hQX₃ with ⟨_, U₃, hU₃, V₃, p₃, A₃, hFin_p₃, hEt_p₃, hSurj_p₃, hFinA₃, hℓA₃, hPull₃⟩
    obtain ⟨U₀, hU₀, V, p₀, q₁, q₃, hIntV, _, hEt_p₀, _, hEt_q₁, hEt_q₃, hComm₁, hComm₃⟩ :=
      s1 U₁ hU₁ V₁ p₁ hFin_p₁ hEt_p₁ hSurj_p₁ U₃ hU₃ V₃ p₃ hFin_p₃ hEt_p₃ hSurj_p₃
    haveI : Nonempty ↥V := @AlgebraicGeometry.IsIntegral.nonempty V hIntV
    haveI := hEt_p₀; haveI := hEt_p₁; haveI := hEt_p₃
    let q₀ : V ⟶ Z := p₀ ≫ U₀.ι
    have hEt_q₀ : AlgebraicGeometry.Etale q₀ := inferInstance
    let C_V := CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}
    have hPullV₁ : WeilIsEtaleSheafPullback q₀ T.X₁ (C_V.obj A₁) := by
      have hP := hPullComp q₁ (p₁ ≫ U₁.ι) hEt_q₁ inferInstance T.X₁ _ _
        hPull₁ (hPullConst q₁ hEt_q₁ A₁)
      rwa [hComm₁] at hP
    have hPullV₃ : WeilIsEtaleSheafPullback q₀ T.X₃ (C_V.obj A₃) := by
      have hP := hPullComp q₃ (p₃ ≫ U₃.ι) hEt_q₃ inferInstance T.X₃ _ _
        hPull₃ (hPullConst q₃ hEt_q₃ A₃)
      rwa [hComm₃] at hP
    let Φ_q₀ : CategoryTheory.Functor V.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.map ⊤ hEt_q₀
    haveI : Φ_q₀.IsContinuous V.smallEtaleTopology Z.smallEtaleTopology := hContMap q₀ hEt_q₀
    let R₀ := Φ_q₀.sheafPushforwardContinuous
      AddCommGrpCat.{u} V.smallEtaleTopology Z.smallEtaleTopology
    obtain ⟨hLim_R₀, hColim_R₀, hAdd_R₀, hIff_R₀, -⟩ := hEtPullPkg q₀ hEt_q₀
    haveI := hLim_R₀; haveI := hColim_R₀; haveI := hAdd_R₀
    obtain ⟨e₁⟩ := (hIff_R₀ T.X₁ (C_V.obj A₁)).mp hPullV₁
    obtain ⟨e₃⟩ := (hIff_R₀ T.X₃ (C_V.obj A₃)).mp hPullV₃
    have hSE_R₀ : (T.map R₀).ShortExact := hSE.map_of_exact R₀
    let f' : C_V.obj A₁ ⟶ R₀.obj T.X₂ := e₁.inv ≫ R₀.map T.f
    let g' : R₀.obj T.X₂ ⟶ C_V.obj A₃ := R₀.map T.g ≫ e₃.hom
    have hf'g' : f' ≫ g' = 0 := by
      dsimp [f', g']
      rw [Category.assoc, ← Category.assoc (R₀.map T.f), ← R₀.map_comp, T.zero, R₀.map_zero,
        CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    let SC_V := CategoryTheory.ShortComplex.mk f' g' hf'g'
    let iso_V : T.map R₀ ≅ SC_V :=
      CategoryTheory.ShortComplex.isoMk e₁ (CategoryTheory.Iso.refl (R₀.obj T.X₂)) e₃
        (by simp [SC_V, f'])
        (by simp [SC_V, g'])
    have hSE_V : SC_V.ShortExact :=
      (CategoryTheory.ShortComplex.shortExact_iff_of_iso iso_V).mp hSE_R₀
    have hℓ_R₀ : ℓ • CategoryTheory.CategoryStruct.id (R₀.obj T.X₂) = 0 := by
      change ℓ • 𝟙 (R₀.obj T.X₂) = 0
      rw [← R₀.map_id, ← CategoryTheory.Functor.map_nsmul, hℓ₂, R₀.map_zero]
    obtain ⟨W, hAffW, hNeW, w, A₂, hEt_w, hFinA₂, hℓA₂, hPull_w⟩ :=
      s4 V A₁ A₃ hFinA₁ hℓA₁ hFinA₃ hℓA₃ (R₀.obj T.X₂) f' g' hf'g' hSE_V hℓ_R₀
    haveI := hAffW
    haveI := hEt_w
    have hEt_wp₀ : AlgebraicGeometry.Etale (w ≫ p₀) := inferInstance
    obtain ⟨U_fin, hU_fin, W₁, jW, p_fin, hjW_open, hFin_pfin, hEt_pfin, hSurj_pfin, hComm_fin⟩ :=
      hAffEtShrink U₀ hU₀ W hNeW (w ≫ p₀) hEt_wp₀
    haveI := hjW_open
    have hEt_jW : AlgebraicGeometry.Etale jW := inferInstance
    have hPull_q₀ : WeilIsEtaleSheafPullback q₀ T.X₂ (R₀.obj T.X₂) :=
      (hIff_R₀ T.X₂ (R₀.obj T.X₂)).mpr ⟨CategoryTheory.Iso.refl _⟩
    have hPull_wq₀ : WeilIsEtaleSheafPullback (w ≫ q₀) T.X₂
        ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₂) :=
      hPullComp w q₀ hEt_w hEt_q₀ T.X₂ (R₀.obj T.X₂) _ hPull_q₀ hPull_w
    have hPull_jW : WeilIsEtaleSheafPullback (jW ≫ (w ≫ q₀)) T.X₂
        ((CategoryTheory.constantSheaf W₁.smallEtaleTopology AddCommGrpCat.{u}).obj A₂) :=
      hPullComp jW (w ≫ q₀) hEt_jW inferInstance T.X₂ _ _
        hPull_wq₀ (hPullConst jW hEt_jW A₂)
    have hEqHom : jW ≫ (w ≫ q₀) = p_fin ≫ U_fin.ι := by
      dsimp [q₀]
      simpa only [Category.assoc] using hComm_fin
    rw [hEqHom] at hPull_jW
    exact ⟨hℓ₂, U_fin, hU_fin, W₁, p_fin, A₂,
      hFin_pfin, hEt_pfin, hSurj_pfin, hFinA₂, hℓA₂, hPull_jW⟩

  exact ⟨hQ_zero, hQ_retract, hQ_ker_coker, hQ_ext⟩

theorem weil_etale_p1_baseChange_and_genFLC_exact_closure (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ) :
    ((∀ (Z₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsAffine Z₀.left]
        [AlgebraicGeometry.LocallyOfFiniteType Z₀.hom],
        AlgebraicGeometry.IsIntegral Z₀.left →
        ∀ (F₀ : CategoryTheory.Sheaf
            (CategoryTheory.Limits.pullback Z₀.hom (weilProjectiveSpaceOver k 1).hom).smallEtaleTopology
            AddCommGrpCat.{u}) (q : ℕ),
          WeilIsConstructibleModPrimeSheaf ℓ
            (CategoryTheory.Limits.pullback Z₀.hom (weilProjectiveSpaceOver k 1).hom) F₀ →
          WeilIsGenFiniteEtaleConstantModPrime ℓ Z₀.left
            (weilEtaleHigherDirectImage
              (CategoryTheory.Limits.pullback.fst Z₀.hom (weilProjectiveSpaceOver k 1).hom) q F₀)) →
      WeilP1ConstructiblePushforwardHolds k ℓ) ∧
    (∀ (Z₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsAffine Z₀.left]
        [AlgebraicGeometry.LocallyOfFiniteType Z₀.hom],
        AlgebraicGeometry.IsIntegral Z₀.left →
        ∀ (X₀ : AlgebraicGeometry.Scheme.{u}) (p₁₀ : X₀ ⟶ Z₀.left),
          let P : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u} → Prop :=
            fun F₀ => ∀ q : ℕ, WeilIsGenFiniteEtaleConstantModPrime ℓ Z₀.left
              (weilEtaleHigherDirectImage p₁₀ q F₀)
          (∀ F₀, CategoryTheory.Limits.IsZero F₀ → P F₀) ∧
          (∀ F₁ F₂ (i : F₁ ⟶ F₂) (r : F₂ ⟶ F₁), i ≫ r = 𝟙 F₁ → P F₂ → P F₁) ∧
          (∀ (S : CategoryTheory.ShortComplex
              (CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})),
              S.ShortExact → ℓ • 𝟙 S.X₂ = 0 →
              ((P S.X₁ ∧ P S.X₃ → P S.X₂) ∧ (P S.X₂ ∧ P S.X₃ → P S.X₁)))) :=
by
  refine ⟨weil_p1_baseChange_reduction_to_affine_integral k ℓ hPBC, ?_⟩
  intro Z₀ _ _ hIntZ₀ X₀ p₁₀ P
  let Z : AlgebraicGeometry.Scheme.{u} := Z₀.left
  let Q : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} → Prop :=
    WeilIsGenFiniteEtaleConstantModPrime ℓ Z
  obtain ⟨hCoverInt, hAffEtShrink⟩ :=
    weil_affine_integral_etale_shrinking_and_domain_cover Z hIntZ₀
  obtain ⟨hQ_zero, hQ_retract, hQ_ker_coker, hQ_ext⟩ :=
    weil_genFLC_abelian_and_extension_closure ℓ Z hIntZ₀ hCoverInt hAffEtShrink
  have hQ_iso : ∀ {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}},
      (G₁ ≅ G₂) → Q G₂ → Q G₁ :=
    fun e hG₂ => hQ_retract _ _ e.hom e.inv e.hom_inv_id hG₂
  let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) p₁₀ :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) p₁₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor Z.Etale X₀.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ p₁₀
  let W_B : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite X₀.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite Z.Etale) AddCommGrpCat.{u}) :=
    (CategoryTheory.Functor.whiskeringLeft (Opposite Z.Etale) (Opposite X₀.Etale)
      AddCommGrpCat.{u}).obj B.op
  let Sh : CategoryTheory.Functor (CategoryTheory.Functor (Opposite Z.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) :=
    CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}
  let R_q : ∀ q : ℕ,
      CategoryTheory.Functor
        (CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun q =>
      (CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology q).comp
        (W_B.comp Sh)
  have hR_obj : ∀ (q : ℕ) (F₀ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
      (R_q q).obj F₀ = weilEtaleHigherDirectImage p₁₀ q F₀ := fun _ _ => rfl
  have h_nsmul_zero : ∀ (m q : ℕ)
      (F : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
      m • (𝟙 F) = 0 → m • (𝟙 ((R_q q).obj F)) = 0 := by
    intro m q F hmF
    let P_F : CategoryTheory.Functor (Opposite X₀.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Sheaf.cohomologyPresheaf F q
    have hβ : m • CategoryTheory.Abelian.Ext.mk₀ (𝟙 F) = 0 := by
      apply CategoryTheory.Abelian.Ext.addEquiv₀.injective
      rw [map_nsmul, map_zero]
      have hid : CategoryTheory.Abelian.Ext.addEquiv₀
          (CategoryTheory.Abelian.Ext.mk₀ (𝟙 F)) = 𝟙 F :=
        CategoryTheory.Abelian.Ext.homEquiv₀.apply_symm_apply _
      rw [hid, hmF]
    have hBP : m • (𝟙 (B.op ⋙ P_F)) = 0 := by
      apply NatTrans.ext
      funext U
      ext x
      change m • x = 0
      let E := (CategoryTheory.presheafToSheaf X₀.smallEtaleTopology AddCommGrpCat.{u}).obj
        (yoneda.obj (B.obj (Opposite.unop U)) ⋙ AddCommGrpCat.free)
      let bc := (CategoryTheory.Abelian.Ext.bilinearComp E F F q 0 q (Nat.add_zero q)) x
      have hx : bc (CategoryTheory.Abelian.Ext.mk₀ (𝟙 F)) = x :=
        CategoryTheory.Abelian.Ext.comp_mk₀_id x
      have hbc : bc (m • CategoryTheory.Abelian.Ext.mk₀ (𝟙 F)) = m • x := by
        rw [map_nsmul, hx]
        rfl
      rw [hβ, map_zero] at hbc
      exact hbc.symm
    change m • (𝟙 (Sh.obj (B.op ⋙ P_F))) = 0
    rw [← Sh.map_id, ← Functor.map_nsmul, hBP, Functor.map_zero]
  refine ⟨?_, ?_, ?_⟩
  · intro F₀ hZero q
    change Q (weilEtaleHigherDirectImage p₁₀ q F₀)
    rw [← hR_obj]
    apply hQ_zero
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero] at hZero ⊢
    simpa only [one_smul] using h_nsmul_zero 1 q F₀ (by rw [one_smul]; exact hZero)
  · intro F₁ F₂ i r hir hP₂ q
    change Q (weilEtaleHigherDirectImage p₁₀ q F₁)
    rw [← hR_obj]
    exact hQ_retract _ _ ((R_q q).map i) ((R_q q).map r)
      (by rw [← (R_q q).map_comp, hir, (R_q q).map_id]) (hP₂ q)
  · intro S hSE hℓ₂
    have : CategoryTheory.Mono S.f := hSE.mono_f
    have hℓ₁ : ℓ • (𝟙 S.X₁) = 0 := by
      apply (cancel_mono S.f).mp
      calc
        (ℓ • 𝟙 S.X₁) ≫ S.f = ℓ • (𝟙 S.X₁ ≫ S.f) := Preadditive.nsmul_comp _ _ _
        _ = ℓ • (S.f ≫ 𝟙 S.X₂) := by rw [Category.id_comp, Category.comp_id]
        _ = S.f ≫ (ℓ • 𝟙 S.X₂) := (Preadditive.comp_nsmul _ _ _).symm
        _ = S.f ≫ 0 := by rw [hℓ₂]
        _ = 0 ≫ S.f := by rw [CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.zero_comp]
    have : CategoryTheory.Limits.PreservesFiniteLimits Sh := inferInstance
    have : CategoryTheory.Limits.PreservesFiniteColimits Sh := inferInstance
    have : Sh.Additive := inferInstance
    have hExact_sheaf : ∀ {P₁ P₂ P₃ : CategoryTheory.Functor (Opposite Z.Etale) AddCommGrpCat.{u}}
        (α : P₁ ⟶ P₂) (β : P₂ ⟶ P₃) (hαβ : α ≫ β = 0),
        (∀ V : Opposite Z.Etale,
          (CategoryTheory.ShortComplex.mk (α.app V) (β.app V)
            (by rw [← NatTrans.comp_app, hαβ]; rfl)).Exact) →
        ∃ hSh : Sh.map α ≫ Sh.map β = 0,
          (CategoryTheory.ShortComplex.mk (Sh.map α) (Sh.map β) hSh).Exact := by
      intro P₁ P₂ P₃ α β hαβ happ
      let SC_pre := CategoryTheory.ShortComplex.mk α β hαβ
      have hSC_pre : SC_pre.Exact := by
        let cg := CategoryTheory.Limits.KernelFork.ofι
          (CategoryTheory.Limits.kernel.ι SC_pre.g)
          (CategoryTheory.Limits.kernel.condition SC_pre.g)
        let hg := CategoryTheory.Limits.kernelIsKernel SC_pre.g
        let cf := CategoryTheory.Limits.CokernelCofork.ofπ
          (CategoryTheory.Limits.cokernel.π SC_pre.f)
          (CategoryTheory.Limits.cokernel.condition SC_pre.f)
        let hf := CategoryTheory.Limits.cokernelIsCokernel SC_pre.f
        rw [CategoryTheory.ShortComplex.exact_iff_of_forks SC_pre hg hf]
        apply NatTrans.ext
        funext V
        change cg.ι.app V ≫ cf.π.app V = 0
        let ev := (CategoryTheory.evaluation (Opposite Z.Etale) AddCommGrpCat.{u}).obj V
        let hgV := CategoryTheory.Limits.isLimitForkMapOfIsLimit ev _ hg
        let hfV := CategoryTheory.Limits.isColimitCoforkMapOfIsColimit ev _ hf
        exact (CategoryTheory.ShortComplex.exact_iff_of_forks _ hgV hfV).mp (happ V)
      refine ⟨by rw [← Sh.map_comp, hαβ, Sh.map_zero], ?_⟩
      exact hSC_pre.map Sh
    have hFiveTerm : ∀ {M₁ M₂ M₃ M₄ M₅ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        (u : M₁ ⟶ M₂) (v : M₂ ⟶ M₃) (w : M₃ ⟶ M₄) (z : M₄ ⟶ M₅)
        (huv : u ≫ v = 0) (hvw : v ≫ w = 0) (hwz : w ≫ z = 0),
        (CategoryTheory.ShortComplex.mk u v huv).Exact →
        (CategoryTheory.ShortComplex.mk v w hvw).Exact →
        (CategoryTheory.ShortComplex.mk w z hwz).Exact →
        ℓ • (𝟙 M₃) = 0 →
        Q (CategoryTheory.Limits.cokernel u) →
        Q (CategoryTheory.Limits.kernel z) →
        Q M₃ := by
      intro M₁ M₂ M₃ M₄ M₅ u v w z huv hvw hwz hex_uv hex_vw hex_wz hℓM₃ hQcoker hQker
      let v_bar : CategoryTheory.Limits.cokernel u ⟶ M₃ :=
        CategoryTheory.Limits.cokernel.desc u v huv
      let w_tilde : M₃ ⟶ CategoryTheory.Limits.kernel z :=
        CategoryTheory.Limits.kernel.lift z w hwz
      have : CategoryTheory.Mono v_bar :=
        (CategoryTheory.ShortComplex.exact_iff_mono_cokernel_desc
          (CategoryTheory.ShortComplex.mk u v huv)).mp hex_uv
      have : CategoryTheory.Epi w_tilde := hex_wz.epi_kernelLift
      have hvw_tilde : v ≫ w_tilde = 0 := by
        rw [← cancel_mono (CategoryTheory.Limits.kernel.ι z), Category.assoc,
          CategoryTheory.Limits.kernel.lift_ι, CategoryTheory.Limits.zero_comp, hvw]
      have h_bar_tilde : v_bar ≫ w_tilde = 0 := by
        rw [← cancel_epi (CategoryTheory.Limits.cokernel.π u), ← Category.assoc,
          CategoryTheory.Limits.cokernel.π_desc, CategoryTheory.Limits.comp_zero, hvw_tilde]
      let S_mid := CategoryTheory.ShortComplex.mk v w_tilde hvw_tilde
      let S_orig := CategoryTheory.ShortComplex.mk v w hvw
      let φ_right : S_mid ⟶ S_orig :=
        { τ₁ := 𝟙 M₂
          τ₂ := 𝟙 M₃
          τ₃ := CategoryTheory.Limits.kernel.ι z
          comm₁₂ := by simp [S_mid, S_orig]
          comm₂₃ := by simp [S_mid, S_orig, w_tilde] }
      have hex_mid : S_mid.Exact :=
        (CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ_right).mpr hex_vw
      let S_short := CategoryTheory.ShortComplex.mk v_bar w_tilde h_bar_tilde
      let φ_left : S_mid ⟶ S_short :=
        { τ₁ := CategoryTheory.Limits.cokernel.π u
          τ₂ := 𝟙 M₃
          τ₃ := 𝟙 (CategoryTheory.Limits.kernel z)
          comm₁₂ := by simp [S_mid, S_short, v_bar]
          comm₂₃ := by simp [S_mid, S_short] }
      have hex_short : S_short.Exact :=
        (CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ_left).mp hex_mid
      have hSE_short : S_short.ShortExact := { exact := hex_short }
      exact hQ_ext S_short hSE_short hℓM₃ hQcoker hQker
    let L_free : CategoryTheory.Functor X₀.Etale
        (CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.yoneda.comp
        (((CategoryTheory.Functor.whiskeringRight (Opposite X₀.Etale) (Type u)
          AddCommGrpCat.{u}).obj AddCommGrpCat.free).comp
          (CategoryTheory.presheafToSheaf X₀.smallEtaleTopology AddCommGrpCat.{u}))
    let δ_pre : ∀ q : ℕ,
        CategoryTheory.Sheaf.cohomologyPresheaf S.X₃ q ⟶
          CategoryTheory.Sheaf.cohomologyPresheaf S.X₁ (q + 1) :=
      fun q =>
        { app := fun W =>
            AddCommGrpCat.ofHom
              (hSE.extClass.postcomp (L_free.obj (Opposite.unop W)) (rfl : q + 1 = q + 1))
          naturality := fun W₁ W₂ u => by
            ext x
            exact CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (L_free.map u.unop)) x hSE.extClass
              (Nat.zero_add q) (rfl : q + 1 = q + 1) (Nat.zero_add (q + 1)) }
    let G₁ : ℕ → CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
      fun q => (R_q q).obj S.X₁
    let G₂ : ℕ → CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
      fun q => (R_q q).obj S.X₂
    let G₃ : ℕ → CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
      fun q => (R_q q).obj S.X₃
    let f_map : ∀ q : ℕ, G₁ q ⟶ G₂ q := fun q => (R_q q).map S.f
    let g_map : ∀ q : ℕ, G₂ q ⟶ G₃ q := fun q => (R_q q).map S.g
    let δ_map : ∀ q : ℕ, G₃ q ⟶ G₁ (q + 1) := fun q => Sh.map (W_B.map (δ_pre q))
    have hMono_f0 : CategoryTheory.Mono (f_map 0) := by
      let f0_pre := W_B.map
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology 0).map S.f)
      have : ∀ V : Opposite Z.Etale, CategoryTheory.Mono (f0_pre.app V) := fun V =>
        CategoryTheory.Abelian.Ext.mono_postcomp_mk₀_of_mono
          (L_free.obj (B.obj (Opposite.unop V))) S.f
      have : CategoryTheory.Mono f0_pre := CategoryTheory.NatTrans.mono_of_mono_app f0_pre
      exact Sh.map_mono f0_pre
    have hZeroOfExact : ∀ {S' : CategoryTheory.ShortComplex AddCommGrpCat.{u}},
        S'.Exact → S'.f ≫ S'.g = 0 := fun {S'} _ => S'.zero
    have hEx_fg : ∀ q : ℕ, ∃ h0 : f_map q ≫ g_map q = 0,
        (CategoryTheory.ShortComplex.mk (f_map q) (g_map q) h0).Exact := by
      intro q
      refine hExact_sheaf
        (W_B.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology q).map S.f))
        (W_B.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology q).map S.g))
        ?_ ?_
      · apply NatTrans.ext
        funext V
        exact hZeroOfExact (CategoryTheory.Abelian.Ext.covariant_sequence_exact₂'
          (L_free.obj (B.obj (Opposite.unop V))) hSE q)
      · intro V
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂'
          (L_free.obj (B.obj (Opposite.unop V))) hSE q
    have hEx_gδ : ∀ q : ℕ, ∃ h0 : g_map q ≫ δ_map q = 0,
        (CategoryTheory.ShortComplex.mk (g_map q) (δ_map q) h0).Exact := by
      intro q
      refine hExact_sheaf
        (W_B.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology q).map S.g))
        (W_B.map (δ_pre q))
        ?_ ?_
      · apply NatTrans.ext
        funext V
        exact hZeroOfExact (CategoryTheory.Abelian.Ext.covariant_sequence_exact₃'
          (L_free.obj (B.obj (Opposite.unop V))) hSE q (q + 1) rfl)
      · intro V
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃'
          (L_free.obj (B.obj (Opposite.unop V))) hSE q (q + 1) rfl
    have hEx_δf : ∀ q : ℕ, ∃ h0 : δ_map q ≫ f_map (q + 1) = 0,
        (CategoryTheory.ShortComplex.mk (δ_map q) (f_map (q + 1)) h0).Exact := by
      intro q
      refine hExact_sheaf
        (W_B.map (δ_pre q))
        (W_B.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology (q + 1)).map S.f))
        ?_ ?_
      · apply NatTrans.ext
        funext V
        exact hZeroOfExact (CategoryTheory.Abelian.Ext.covariant_sequence_exact₁'
          (L_free.obj (B.obj (Opposite.unop V))) hSE q (q + 1) rfl)
      · intro V
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁'
          (L_free.obj (B.obj (Opposite.unop V))) hSE q (q + 1) rfl
    constructor
    · rintro ⟨hP₁, hP₃⟩ q
      change Q (weilEtaleHigherDirectImage p₁₀ q S.X₂)
      rw [← hR_obj]
      cases q with
      | zero =>
        obtain ⟨hfg0, hex_fg0⟩ := hEx_fg 0
        obtain ⟨hgδ0, hex_gδ0⟩ := hEx_gδ 0
        let g0_tilde : G₂ 0 ⟶ CategoryTheory.Limits.kernel (δ_map 0) :=
          CategoryTheory.Limits.kernel.lift (δ_map 0) (g_map 0) hgδ0
        have : CategoryTheory.Epi g0_tilde := hex_gδ0.epi_kernelLift
        have hfg0_tilde : f_map 0 ≫ g0_tilde = 0 := by
          rw [← cancel_mono (CategoryTheory.Limits.kernel.ι (δ_map 0)), Category.assoc,
            CategoryTheory.Limits.kernel.lift_ι, CategoryTheory.Limits.zero_comp, hfg0]
        let S0_short := CategoryTheory.ShortComplex.mk (f_map 0) g0_tilde hfg0_tilde
        let S0_orig := CategoryTheory.ShortComplex.mk (f_map 0) (g_map 0) hfg0
        let φ0 : S0_short ⟶ S0_orig :=
          { τ₁ := 𝟙 (G₁ 0)
