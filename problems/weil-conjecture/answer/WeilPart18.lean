      let uP_scheme : W.left ⟶ P.left :=
        Limits.pullback.lift (f₁.left ≫ Limits.pullback.fst Y₁.hom π)
          (f₂.left ≫ Limits.pullback.fst Y₂.hom π) h_w_z
      have huP_π : uP_scheme ≫ P.hom = W.hom ≫ π := by
        have h_lhs : uP_scheme ≫ P.hom = (f₁.left ≫ Limits.pullback.fst Y₁.hom π) ≫ Y₁.hom :=
          Limits.pullback.lift_fst_assoc _ _ _ Y₁.hom
        exact h_lhs.trans
          ((Category.assoc _ _ _).trans
            ((congrArg (f₁.left ≫ ·) Limits.pullback.condition).trans
              ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ π) (MorphismProperty.Over.w f₁)))))
      let ell : W ⟶ B.obj P :=
        MorphismProperty.Over.homMk
          (Limits.pullback.lift uP_scheme W.hom huP_π)
          (Limits.pullback.lift_snd uP_scheme W.hom huP_π)
          trivial
      have hw₁ : (ell.left ≫ (B.map p₁).left) ≫ (B.obj Y₁).hom = f₁.left ≫ (B.obj Y₁).hom :=
        (Category.assoc ell.left (B.map p₁).left _).trans
          ((congrArg (ell.left ≫ ·) (MorphismProperty.Over.w (B.map p₁))).trans
            ((MorphismProperty.Over.w ell).trans (MorphismProperty.Over.w f₁).symm))
      have hw₂ : (ell.left ≫ (B.map p₂).left) ≫ (B.obj Y₂).hom = f₂.left ≫ (B.obj Y₂).hom :=
        (Category.assoc ell.left (B.map p₂).left _).trans
          ((congrArg (ell.left ≫ ·) (MorphismProperty.Over.w (B.map p₂))).trans
            ((MorphismProperty.Over.w ell).trans (MorphismProperty.Over.w f₂).symm))
      have hell₁ : ell ≫ B.map p₁ = f₁ := by
        apply MorphismProperty.Over.Hom.ext
        apply Limits.pullback.hom_ext
        · exact (Category.assoc ell.left (B.map p₁).left _).trans
            ((congrArg (ell.left ≫ ·) (hB_fst p₁)).trans
              ((Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ p₁.left) (Limits.pullback.lift_fst uP_scheme W.hom huP_π)).trans
                  (Limits.pullback.lift_fst _ _ h_w_z))))
        · exact hw₁
      have hell₂ : ell ≫ B.map p₂ = f₂ := by
