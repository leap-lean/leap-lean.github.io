      (hComp c).1 (hComp c).2.1 (hComp c).2.2.1 (hComp c).2.2.2

  have hRet_all : ∀ c : Fin r,
      ∃ (ψ₀ : weilAltZeroBdrySubpresheaf Y₀ V_good n ⟶
            (B c).op ⋙ weilAltZeroBdrySubpresheaf (X c) (W_comp c) n)
        (θ₀ : (B c).op ⋙ weilAltZeroBdrySubpresheaf (X c) (W_comp c) n ⟶
