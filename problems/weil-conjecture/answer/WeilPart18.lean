            (Category.assoc _ _ _).symm
          _ = adj₁.unit.app A ≫ ((C₁.obj A).obj.map v₂₁.op ≫ θ_BT₂) := by
            rw [hψ₀_app, Category.assoc]
          _ = (adj₁.unit.app A ≫ θ_T₁) ≫ (C₂.obj A).obj.map (Φ_h.map v₂₁).op := by
            rw [hnatθ, Category.assoc]
          _ = adj₂.unit.app A ≫
                ((C₂.obj A).obj.map u₁₂.op ≫ (C₂.obj A).obj.map (Φ_h.map v₂₁).op) := by
            rw [hθ_app, Category.assoc]
          _ = adj₂.unit.app A ≫ (C₂.obj A).obj.map (Φ_h.map v₂₁ ≫ u₁₂).op := by
            rw [← (C₂.obj A).obj.map_comp, ← op_comp]
          _ = adj₂.unit.app A ≫ u_T₂ := by
            rw [hTermEq₂, hUnitApp]
      exact ⟨{ hom := θ, inv := ψ, hom_inv_id := hθψ, inv_hom_id := hψθ }, hθ_adj⟩

  have hPullConst : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      AlgebraicGeometry.Etale h →
      ∀ (A : AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback h
          ((CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj A)
          ((CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
    intro X₁ X₂ h hEt A
    obtain ⟨_, _, _, hIff, hConst⟩ := hEtPullPkg h hEt
    obtain ⟨e_const, -⟩ := hConst A
    exact (hIff _ _).mpr ⟨e_const.symm⟩

  have hPullIso : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      AlgebraicGeometry.Etale h →
      ∀ (G G' : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (F F' : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
        (G' ≅ G) → WeilIsEtaleSheafPullback h G F → (F ≅ F') →
        WeilIsEtaleSheafPullback h G' F' := by
    intro X₁ X₂ h hEt G G' F F' eG hPull eF
    let Φ_h : CategoryTheory.Functor X₁.Etale X₂.Etale :=
      CategoryTheory.MorphismProperty.Over.map ⊤ hEt
    haveI : Φ_h.IsContinuous X₁.smallEtaleTopology X₂.smallEtaleTopology := hContMap h hEt
    obtain ⟨_, _, _, hIff, -⟩ := hEtPullPkg h hEt
    obtain ⟨e⟩ := (hIff G F).mp hPull
    exact (hIff G' F').mpr ⟨(Φ_h.sheafPushforwardContinuous
      AddCommGrpCat.{u} X₁.smallEtaleTopology X₂.smallEtaleTopology).mapIso eG ≪≫ e ≪≫ eF⟩

  have hPullComp : ∀ {X₀ X₁ X₂ : AlgebraicGeometry.Scheme.{u}}
      (h₀ : X₀ ⟶ X₁) (h : X₁ ⟶ X₂),
      AlgebraicGeometry.Etale h₀ → AlgebraicGeometry.Etale h →
      ∀ (G₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (G₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u})
        (G₀ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback h G₂ G₁ →
        WeilIsEtaleSheafPullback h₀ G₁ G₀ →
        WeilIsEtaleSheafPullback (h₀ ≫ h) G₂ G₀ := by
    intro X₀ X₁ X₂ h₀ h hEt₀ hEt G₂ G₁ G₀ hP₁ hP₀
    have hEtComp₀ : AlgebraicGeometry.Etale (h₀ ≫ h) := by
      haveI := hEt₀; haveI := hEt; exact inferInstance
    let Φ₀ : CategoryTheory.Functor X₀.Etale X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.map ⊤ hEt₀
    let Φ₁ : CategoryTheory.Functor X₁.Etale X₂.Etale :=
      CategoryTheory.MorphismProperty.Over.map ⊤ hEt
    let Φ₀₁ : CategoryTheory.Functor X₀.Etale X₂.Etale :=
      CategoryTheory.MorphismProperty.Over.map ⊤ hEtComp₀
    haveI : Φ₀.IsContinuous X₀.smallEtaleTopology X₁.smallEtaleTopology := hContMap h₀ hEt₀
    haveI : Φ₁.IsContinuous X₁.smallEtaleTopology X₂.smallEtaleTopology := hContMap h hEt
    haveI : Φ₀₁.IsContinuous X₀.smallEtaleTopology X₂.smallEtaleTopology :=
      hContMap (h₀ ≫ h) hEtComp₀
    obtain ⟨_, _, _, hIff₁, -⟩ := hEtPullPkg h hEt
    obtain ⟨_, _, _, hIff₀, -⟩ := hEtPullPkg h₀ hEt₀
    obtain ⟨_, _, _, hIff₀₁, -⟩ := hEtPullPkg (h₀ ≫ h) hEtComp₀
    obtain ⟨e₁⟩ := (hIff₁ G₂ G₁).mp hP₁
    obtain ⟨e₀⟩ := (hIff₀ G₁ G₀).mp hP₀
    let e_map : Φ₀ ⋙ Φ₁ ≅ Φ₀₁ :=
      (CategoryTheory.MorphismProperty.Over.mapComp ⊤ hEt₀ hEt).symm
    let e_sh := CategoryTheory.Functor.sheafPushforwardContinuousComp' e_map AddCommGrpCat.{u}
      X₀.smallEtaleTopology X₁.smallEtaleTopology X₂.smallEtaleTopology
    let j₀ := Φ₀.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₀.smallEtaleTopology X₁.smallEtaleTopology
    exact (hIff₀₁ G₂ G₀).mpr ⟨(e_sh.app G₂).symm ≪≫ j₀.mapIso e₁ ≪≫ e₀⟩

  
  have s3 : ∀ (V : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥V]
      (A₁ A₂ : AddCommGrpCat.{u})
      (φ : (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A₁ ⟶
           (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A₂),
      ∃ (φ₀ : A₁ ⟶ A₂),
        φ = (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).map φ₀ := by
    intro V _ A₁ A₂ φ
    let C_V := CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}
    let T_V := mkTermEt V
    let hT := isTermEt V
    let adj := CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u} hT
    let P₂ := (CategoryTheory.Functor.const (Opposite V.Etale)).obj A₂
    let η_sh := CategoryTheory.toSheafify V.smallEtaleTopology P₂
    let η_C : P₂ ⟶ (C_V.obj A₂).obj := η_sh
    have hEqOnNonempty : ∀ (Z₀ : V.Etale) [Nonempty ↥Z₀.left] (a b : A₂),
        η_sh.app (Opposite.op Z₀) a = η_sh.app (Opposite.op Z₀) b → a = b := by
      intro Z₀ hNe a b heq
      have hmem := CategoryTheory.Presheaf.equalizerSieve_mem V.smallEtaleTopology η_sh a b heq
      rw [hMemEtale] at hmem
      obtain ⟨z₀⟩ := hNe
      obtain ⟨Y, u, _, hu, -, -⟩ := hmem z₀
      exact hu
    have hSubOnEmpty : ∀ (W : V.Etale), IsEmpty ↥W.left →
        Subsingleton ((C_V.obj A₂).obj.obj (Opposite.op W)) := by
      intro W hEmp
      refine ⟨fun s₁ s₂ => ?_⟩
      have hBot : (⊥ : CategoryTheory.Sieve W) ∈ V.smallEtaleTopology W := by
        rw [hMemEtale]
        intro x
        exact IsEmpty.elim hEmp x
      exact hSheafSep (C_V.obj A₂) ⊥ hBot s₁ s₂ (fun _ _ hu => False.elim hu)
    have hUnitEq : adj.unit.app A₂ = η_sh.app (Opposite.op T_V) := rfl
    have hNeTV : Nonempty ↥T_V.left := by
      change Nonempty ↥V; infer_instance
    haveI hPreTV : PreconnectedSpace ↥T_V.left := by
      change PreconnectedSpace ↥V; infer_instance
    have hBij : Function.Bijective (adj.unit.app A₂) := by
      rw [hUnitEq]
      constructor
      · intro a b hab
        exact @hEqOnNonempty T_V hNeTV a b hab
      · intro σ
        have hImg : CategoryTheory.Presheaf.imageSieve η_sh σ ∈ V.smallEtaleTopology T_V :=
          CategoryTheory.Presheaf.imageSieve_mem V.smallEtaleTopology η_sh σ
        have hImgCov := (hMemEtale T_V _).mp hImg
        choose W_x u_x w_x hu_x _ hw_x using hImgCov
        have hVal : ∀ {W : V.Etale} (u : W ⟶ T_V),
            (CategoryTheory.Presheaf.imageSieve η_sh σ).arrows u →
            ∃ a : A₂, η_sh.app (Opposite.op W) a = (C_V.obj A₂).obj.map u.op σ :=
          fun _ hu => hu
        choose a_of ha_of using @hVal
        have hAgree : ∀ {W₁ W₂ : V.Etale} (u₁ : W₁ ⟶ T_V) (u₂ : W₂ ⟶ T_V)
            (hu₁ : (CategoryTheory.Presheaf.imageSieve η_sh σ).arrows u₁)
            (hu₂ : (CategoryTheory.Presheaf.imageSieve η_sh σ).arrows u₂)
            (y₁ : ↥W₁.left) (y₂ : ↥W₂.left),
            u₁.left y₁ = u₂.left y₂ →
            a_of u₁ hu₁ = a_of u₂ hu₂ := by
          intro W₁ W₂ u₁ u₂ hu₁ hu₂ y₁ y₂ hy
          obtain ⟨z, -, -⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy
          haveI hEt_u₁ : AlgebraicGeometry.Etale u₁.left := by
            haveI h1 : AlgebraicGeometry.Etale (u₁.left ≫ T_V.hom) := u₁.w.symm ▸ W₁.prop
            exact AlgebraicGeometry.Etale.of_comp u₁.left T_V.hom
          haveI hEt_u₂ : AlgebraicGeometry.Etale u₂.left := by
            haveI h2 : AlgebraicGeometry.Etale (u₂.left ≫ T_V.hom) := u₂.w.symm ▸ W₂.prop
            exact AlgebraicGeometry.Etale.of_comp u₂.left T_V.hom
          haveI := W₁.prop
          let fst₁₂ := CategoryTheory.Limits.pullback.fst u₁.left u₂.left
          let snd₁₂ := CategoryTheory.Limits.pullback.snd u₁.left u₂.left
          let Z₁₂ : V.Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ (fst₁₂ ≫ W₁.hom) inferInstance
          let p₁ : Z₁₂ ⟶ W₁ := CategoryTheory.MorphismProperty.Over.homMk fst₁₂ rfl
          have hp₂_w : snd₁₂ ≫ W₂.hom = Z₁₂.hom := by
            change snd₁₂ ≫ W₂.hom = fst₁₂ ≫ W₁.hom
            calc
              snd₁₂ ≫ W₂.hom = snd₁₂ ≫ (u₂.left ≫ T_V.hom) :=
                congrArg (snd₁₂ ≫ ·) u₂.w.symm
              _ = (snd₁₂ ≫ u₂.left) ≫ T_V.hom := (Category.assoc _ _ _).symm
              _ = (fst₁₂ ≫ u₁.left) ≫ T_V.hom :=
                congrArg (· ≫ T_V.hom) CategoryTheory.Limits.pullback.condition.symm
