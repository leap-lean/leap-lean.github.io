theorem weil_etale_finite_directImage_zero_exact_and_comp (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType X.hom] :
    (∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Z₁ ⟶ Z₂)
        (G G' : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}),
      (CategoryTheory.Limits.IsZero G →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h 0 G)) ∧
      (ℓ • CategoryTheory.CategoryStruct.id G = 0 →
        ℓ • CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage h 0 G) = 0) ∧
      (Nonempty (G ≅ G') →
        Nonempty (weilEtaleHigherDirectImage h 0 G ≅ weilEtaleHigherDirectImage h 0 G')) ∧
      ((∃ (i : G ⟶ G') (r : G' ⟶ G), i ≫ r = 𝟙 G) →
        ∃ (i₀ : weilEtaleHigherDirectImage h 0 G ⟶ weilEtaleHigherDirectImage h 0 G')
          (r₀ : weilEtaleHigherDirectImage h 0 G' ⟶ weilEtaleHigherDirectImage h 0 G),
          i₀ ≫ r₀ = 𝟙 (weilEtaleHigherDirectImage h 0 G))) ∧
    (∀ {Z₁ Z₂ Z₃ : AlgebraicGeometry.Scheme.{u}} (h₁ : Z₁ ⟶ Z₂) (h₂ : Z₂ ⟶ Z₃)
        (G : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}),
      Nonempty (weilEtaleHigherDirectImage (h₁ ≫ h₂) 0 G ≅
        weilEtaleHigherDirectImage h₂ 0 (weilEtaleHigherDirectImage h₁ 0 G))) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (g : W ⟶ X.left),
      AlgebraicGeometry.IsFinite g →
      ∀ (S : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})),
        S.ShortExact →
        ℓ • CategoryTheory.CategoryStruct.id S.X₂ = 0 →
        ∃ (S' : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})),
          S'.ShortExact ∧
          S'.X₁ = weilEtaleHigherDirectImage g 0 S.X₁ ∧
          S'.X₂ = weilEtaleHigherDirectImage g 0 S.X₂ ∧
          S'.X₃ = weilEtaleHigherDirectImage g 0 S.X₃) :=
by
  have hContAndAdj : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : W₁ ⟶ W₂),
      ∃ (hc : (weilCompEtaleSitePullback h).IsContinuous
          W₂.smallEtaleTopology W₁.smallEtaleTopology),
        (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilCompEtaleSitePullback h) AddCommGrpCat.{u} _
          W₂.smallEtaleTopology W₁.smallEtaleTopology hc).IsRightAdjoint := by
    intro W₁ W₂ h
    let B := weilCompEtaleSitePullback h
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have hMem_etale : ∀ (Y : AlgebraicGeometry.Scheme.{u}) {V : Y.Etale}
        {S : CategoryTheory.Sieve V},
        S ∈ Y.smallEtaleTopology V ↔
          ∀ w : ↥V.left, ∃ (Z : Y.Etale) (u : Z ⟶ V) (y : ↥Z.left),
            S.arrows u ∧ P_et u.left ∧ u.left.base y = w := by
      intro Y V S
      have hEq : (S ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Y V) =
          (S ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := Y)).toGrothendieck V) :=
        congrArg (fun J => S ∈ J V)
          (AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
            Y (le_refl P_et))
      exact (Iff.of_eq hEq).trans
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) V S)
    have hIntertwine : B ⋙ AlgebraicGeometry.Scheme.Etale.forget W₁ =
        AlgebraicGeometry.Scheme.Etale.forget W₂ ⋙ CategoryTheory.Over.pullback h := rfl
    have : CategoryTheory.Limits.PreservesFiniteLimits (CategoryTheory.Over.pullback h) := by
      have : (CategoryTheory.Over.pullback h).IsRightAdjoint :=
        ⟨_, ⟨CategoryTheory.Over.mapPullbackAdj h⟩⟩
      infer_instance
    have hPresComp : CategoryTheory.Limits.PreservesFiniteLimits
        (B ⋙ AlgebraicGeometry.Scheme.Etale.forget W₁) := by
      rw [hIntertwine]
      infer_instance
    have : CategoryTheory.Limits.PreservesFiniteLimits B :=
      CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves
        B (AlgebraicGeometry.Scheme.Etale.forget W₁)
    have : CategoryTheory.RepresentablyFlat B := CategoryTheory.flat_of_preservesFiniteLimits B
    have hCompat : CategoryTheory.CompatiblePreserving W₁.smallEtaleTopology B :=
      CategoryTheory.compatiblePreservingOfFlat W₁.smallEtaleTopology B
    have hCovPres : CategoryTheory.CoverPreserving
        W₂.smallEtaleTopology W₁.smallEtaleTopology B := by
      refine ⟨fun {U} S hS => (hMem_etale W₁).mpr (fun z => ?_)⟩
      let x : ↥U.left := (CategoryTheory.Limits.pullback.fst U.hom h).base z
      obtain ⟨Y, f, y, hfS, hfEt, hfy⟩ := (hMem_etale W₂).mp hS x
      have hf_push : (S.functorPushforward B).arrows (B.map f) :=
        ⟨Y, f, 𝟙 (B.obj Y), hfS, (CategoryTheory.Category.id_comp _).symm⟩
      have hEt_BU : AlgebraicGeometry.Etale (B.obj U).hom := (B.obj U).prop
      have hEt_BY : AlgebraicGeometry.Etale (B.obj Y).hom := (B.obj Y).prop
      have hEt_Bf : AlgebraicGeometry.Etale (B.map f).left := by
        have hw : (B.map f).left ≫ (B.obj U).hom = (B.obj Y).hom :=
          CategoryTheory.MorphismProperty.Over.w (B.map f)
        have : AlgebraicGeometry.Etale ((B.map f).left ≫ (B.obj U).hom) := hw.symm ▸ hEt_BY
        exact AlgebraicGeometry.Etale.of_comp (B.map f).left (B.obj U).hom
      have hpb_right : CategoryTheory.IsPullback
          (B.obj U).hom (CategoryTheory.Limits.pullback.fst U.hom h) h U.hom :=
        (CategoryTheory.IsPullback.of_hasPullback U.hom h).flip
      have hpb_outer : CategoryTheory.IsPullback
          (B.obj Y).hom (CategoryTheory.Limits.pullback.fst Y.hom h) h (f.left ≫ U.hom) := by
