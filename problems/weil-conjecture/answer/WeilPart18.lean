      exact hZero _ (hEmpty W_D X.left g_D hEmptyWD)
    · have hNonempty : (D : Set ↥W).Nonempty := Set.nonempty_iff_ne_empty.mpr hEmptyD
      by_cases hPre : IsPreirreducible (D : Set ↥W)
      · have hIrr : IsIrreducible (D : Set ↥W) := ⟨hNonempty, hPre⟩
        have hRadEq : I_D.radical = I_D := by
          dsimp [I_D]
          rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support, hSupp]
        have hCl : AlgebraicGeometry.IsClosedImmersion i_D := inferInstance
        have hEmb : Topology.IsClosedEmbedding ⇑i_D.base :=
          ((AlgebraicGeometry.isClosedImmersion_iff i_D).mp hCl).2
        have hIntWD : AlgebraicGeometry.IsIntegral W_D := by
          have : Nonempty ↥W_D := by
            obtain ⟨x, hxD⟩ := hIrr.1
            rw [← hRange] at hxD
            obtain ⟨y, -⟩ := hxD
            exact ⟨y⟩
          have : PreirreducibleSpace ↥W_D := by
            refine ⟨fun u v hu hv ⟨y₁, _, hy₁⟩ ⟨y₂, _, hy₂⟩ => ?_⟩
            rw [hEmb.toIsEmbedding.isOpen_iff] at hu hv
            obtain ⟨U', hU', rfl⟩ := hu
            obtain ⟨V', hV', rfl⟩ := hv
            have h₁ : ((D : Set ↥W) ∩ U').Nonempty :=
              ⟨i_D.base y₁, hRange ▸ ⟨y₁, rfl⟩, hy₁⟩
            have h₂ : ((D : Set ↥W) ∩ V').Nonempty :=
              ⟨i_D.base y₂, hRange ▸ ⟨y₂, rfl⟩, hy₂⟩
            obtain ⟨z, hzD, hzU, hzV⟩ := hIrr.2 U' V' hU' hV' h₁ h₂
            rw [← hRange] at hzD
            obtain ⟨y₃, rfl⟩ := hzD
            exact ⟨y₃, trivial, hzU, hzV⟩
          have : IrreducibleSpace ↥W_D :=
            { toPreirreducibleSpace := inferInstance, toNonempty := inferInstance }
          have hRedChart : ∀ (U : ↑W.affineOpens),
              AlgebraicGeometry.IsReduced
                (AlgebraicGeometry.Spec (CommRingCat.of
                  (↑(W.presheaf.obj (Opposite.op U.1)) ⧸ I_D.ideal U))) := by
            intro U
            have hRadU : (I_D.ideal U).IsRadical := by
              intro x hx
              have hx' : x ∈ I_D.radical.ideal U := by
                rwa [AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal]
              rwa [hRadEq] at hx'
            rw [AlgebraicGeometry.affine_isReduced_iff]
            exact (Ideal.isRadical_iff_quotient_reduced (I_D.ideal U)).mp hRadU
          have : ∀ (i : I_D.subschemeCover.openCover.I₀),
              AlgebraicGeometry.IsReduced (I_D.subschemeCover.openCover.X i) :=
            fun U => hRedChart U
          have : AlgebraicGeometry.IsReduced W_D :=
            AlgebraicGeometry.IsReduced.of_openCover W_D I_D.subschemeCover.openCover
          exact (AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced W_D).mpr
            ⟨inferInstance, inferInstance⟩
        exact hFinGen W_D g_D hIntWD hFin_gD
      · unfold IsPreirreducible at hPre
        push Not at hPre
        obtain ⟨u, v, hu, hv, hsu, hsv, hsuv⟩ := hPre
        let D₁ : TopologicalSpace.Closeds ↥W :=
          ⟨(D : Set ↥W) \ u, D.isClosed.sdiff hu⟩
        let D₂ : TopologicalSpace.Closeds ↥W :=
          ⟨(D : Set ↥W) \ v, D.isClosed.sdiff hv⟩
        have hD₁_lt : D₁ < D := by
          refine lt_of_le_not_ge (fun _ hx => hx.1) ?_
          intro hle
          obtain ⟨x, hxD, hxu⟩ := hsu
          exact (hle hxD).2 hxu
        have hD₂_lt : D₂ < D := by
          refine lt_of_le_not_ge (fun _ hx => hx.1) ?_
          intro hle
          obtain ⟨y, hyD, hyv⟩ := hsv
          exact (hle hyD).2 hyv
        have hD₁₂_lt : D₁ ⊓ D₂ < D := lt_of_le_of_lt inf_le_left hD₁_lt
        have hEq : D = D₁ ⊔ D₂ := by
          apply SetLike.ext'
          ext z
          change z ∈ (D : Set ↥W) ↔
            z ∈ ((D : Set ↥W) \ u) ∪ ((D : Set ↥W) \ v)
          constructor
          · intro hzD
            by_cases hzu : z ∈ u
            · right
              refine ⟨hzD, fun hzv => ?_⟩
              exact Set.not_nonempty_iff_eq_empty.mpr hsuv ⟨z, hzD, hzu, hzv⟩
            · left
              exact ⟨hzD, hzu⟩
          · rintro (⟨hzD, -⟩ | ⟨hzD, -⟩) <;> exact hzD
        let W₁ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D₁).subscheme
        let i₁ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D₁).subschemeι
        let g₁ := i₁ ≫ g
        let W₂ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D₂).subscheme
        let i₂ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal D₂).subschemeι
        let g₂ := i₂ ≫ g
        let W₁₂ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal (D₁ ⊓ D₂)).subscheme
        let i₁₂ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal (D₁ ⊓ D₂)).subschemeι
        let g₁₂ := i₁₂ ≫ g
        let F_D := weilEtaleHigherDirectImage g_D 0 (weilEtaleTorsionSheaf W_D ℓ)
        let F₁ := weilEtaleHigherDirectImage g₁ 0 (weilEtaleTorsionSheaf W₁ ℓ)
        let F₂ := weilEtaleHigherDirectImage g₂ 0 (weilEtaleTorsionSheaf W₂ ℓ)
        let F₁₂ := weilEtaleHigherDirectImage g₁₂ 0 (weilEtaleTorsionSheaf W₁₂ ℓ)
        obtain ⟨u₁, u₂, u₁₂, S_MV, hu₁, hu₂, hu₁₂, hSE_MV, hX₁_MV, hX₂_MV, hX₃_MV⟩ :=
          hMV D D₁ D₂ hEq
        have hTor_MV₁ : ℓ • 𝟙 S_MV.X₁ = 0 := by
          rw [hX₁_MV]
          exact hTorSh W_D
        have hZero_R1 : CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage g_D 1 S_MV.X₁) := by
          refine weil_etale_geometric_point_stalk_conservativity X.left
            (weilEtaleHigherDirectImage g_D 1 S_MV.X₁) ?_
          intro Ω _ _ x
          exact weil_etale_finite_geometric_fiber_h1_isZero k ℓ hPBC X
            W_D g_D hFin_gD S_MV.X₁ hTor_MV₁ Ω x
        obtain ⟨S₁, hSE₁, hS₁X₁, hS₁X₂, hS₁X₃⟩ :=
          hPushSE W_D X.left g_D S_MV hSE_MV hZero_R1
        have hg₁_eq : u₁ ≫ g_D = g₁ := by
          dsimp [g_D, g₁]
          rw [← CategoryTheory.Category.assoc, hu₁]
        have hg₂_eq : u₂ ≫ g_D = g₂ := by
          dsimp [g_D, g₂]
          rw [← CategoryTheory.Category.assoc, hu₂]
        have hg₁₂_eq : u₁₂ ≫ g_D = g₁₂ := by
          dsimp [g_D, g₁₂]
          rw [← CategoryTheory.Category.assoc, hu₁₂]
        obtain ⟨e_bi⟩ := hBiprod W_D X.left g_D
          (weilEtaleHigherDirectImage u₁ 0 (weilEtaleTorsionSheaf W₁ ℓ))
          (weilEtaleHigherDirectImage u₂ 0 (weilEtaleTorsionSheaf W₂ ℓ))
        obtain ⟨e_c1⟩ := hComp W₁ W_D X.left u₁ g_D (weilEtaleTorsionSheaf W₁ ℓ)
        obtain ⟨e_c2⟩ := hComp W₂ W_D X.left u₂ g_D (weilEtaleTorsionSheaf W₂ ℓ)
        obtain ⟨e_c12⟩ := hComp W₁₂ W_D X.left u₁₂ g_D (weilEtaleTorsionSheaf W₁₂ ℓ)
        have hIso_X₂ : Nonempty (CategoryTheory.Iso S₁.X₂ (CategoryTheory.Limits.biprod F₁ F₂)) := by
          refine ⟨(CategoryTheory.eqToIso ?_).trans
            (e_bi.trans (CategoryTheory.Limits.biprod.mapIso
              (e_c1.trans (CategoryTheory.eqToIso ?_))
              (e_c2.trans (CategoryTheory.eqToIso ?_))))⟩
          · rw [hS₁X₂, hX₂_MV]
          · dsimp [F₁]; rw [hg₁_eq]
          · dsimp [F₂]; rw [hg₂_eq]
        have hIso_X₃ : Nonempty (CategoryTheory.Iso S₁.X₃ F₁₂) := by
          refine ⟨(CategoryTheory.eqToIso ?_).trans
            (e_c12.trans (CategoryTheory.eqToIso ?_))⟩
          · rw [hS₁X₃, hX₃_MV]
          · dsimp [F₁₂]; rw [hg₁₂_eq]
        have hTF₁ : ℓ • 𝟙 F₁ = 0 := hTorPush W₁ X.left g₁ 0 _ (hTorSh W₁)
        have hTF₂ : ℓ • 𝟙 F₂ = 0 := hTorPush W₂ X.left g₂ 0 _ (hTorSh W₂)
        obtain ⟨hSE_bi, hTor_bi⟩ := hBiprodAux F₁ F₂ hTF₁ hTF₂
        have hPF₁ : P F₁ := ih D₁ hD₁_lt
        have hPF₂ : P F₂ := ih D₂ hD₂_lt
        have hPF₁₂ : P F₁₂ := ih (D₁ ⊓ D₂) hD₁₂_lt
        have hP_bi : P (CategoryTheory.Limits.biprod F₁ F₂) :=
          (hExact _ hSE_bi hTor_bi).1 ⟨hPF₁, hPF₂⟩
        have hPS₁X₂ : P S₁.X₂ := hPIso hIso_X₂ hP_bi
        have hPS₁X₃ : P S₁.X₃ := hPIso hIso_X₃ hPF₁₂
        have hTor_S₁X₂ : ℓ • 𝟙 S₁.X₂ = 0 := hTorIso hIso_X₂ hTor_bi
        have hPS₁X₁ : P S₁.X₁ := (hExact S₁ hSE₁ hTor_S₁X₂).2 ⟨hPS₁X₂, hPS₁X₃⟩
        have hS₁X₁_eq : S₁.X₁ = F_D := by
          dsimp [F_D]
          rw [hS₁X₁, hX₁_MV]
        rwa [hS₁X₁_eq] at hPS₁X₁
  have hP_top := hInd ⊤
  let I_top := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal
    (⊤ : TopologicalSpace.Closeds ↥W)
  obtain ⟨e_map⟩ := hMapIso W X.left g hRedTop
  obtain ⟨e_comp⟩ := hComp I_top.subscheme W X.left I_top.subschemeι g
    (weilEtaleTorsionSheaf I_top.subscheme ℓ)
  exact hPIso ⟨e_map.trans e_comp⟩ hP_top

theorem weil_etale_pullback_exact_and_pseudofunctor (ℓ : ℕ) :
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
        (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}),
      ∃ (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback h F₂ F₁ ∧
        (ℓ • CategoryTheory.CategoryStruct.id F₂ = 0 →
          ℓ • CategoryTheory.CategoryStruct.id F₁ = 0) ∧
        (CategoryTheory.Limits.IsZero F₂ → CategoryTheory.Limits.IsZero F₁)) ∧
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
        (F₂ F₂' : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (F₁ F₁' : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h F₂ F₁ →
      Nonempty (F₂ ≅ F₂') →
      Nonempty (F₁ ≅ F₁') →
      WeilIsEtaleSheafPullback h F₂' F₁') ∧
    (∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}} (h₁ : X₁ ⟶ X₂) (h₂ : X₂ ⟶ X₃)
        (F₃ : CategoryTheory.Sheaf X₃.smallEtaleTopology AddCommGrpCat.{u})
        (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      (WeilIsEtaleSheafPullback h₂ F₃ F₂ →
        WeilIsEtaleSheafPullback h₁ F₂ F₁ →
        WeilIsEtaleSheafPullback (h₁ ≫ h₂) F₃ F₁) ∧
      (WeilIsEtaleSheafPullback h₂ F₃ F₂ →
        WeilIsEtaleSheafPullback (h₁ ≫ h₂) F₃ F₁ →
        WeilIsEtaleSheafPullback h₁ F₂ F₁)) ∧
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂) (A : AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h
        ((CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj A)
        ((CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj A)) ∧
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
        (F₁ F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (φ : F₁ ⟶ F₂)
        (G₁ G₂ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h F₁ G₁ →
      WeilIsEtaleSheafPullback h F₂ G₂ →
      ∃ (ψ : G₁ ⟶ G₂),
        WeilIsEtaleSheafPullback h
          (CategoryTheory.Limits.kernel φ) (CategoryTheory.Limits.kernel ψ) ∧
        WeilIsEtaleSheafPullback h
          (CategoryTheory.Limits.cokernel φ) (CategoryTheory.Limits.cokernel ψ)) ∧
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
        (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}))
        (G₁ G₃ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      SC.ShortExact →
      WeilIsEtaleSheafPullback h SC.X₁ G₁ →
      WeilIsEtaleSheafPullback h SC.X₃ G₃ →
      ∃ (SC' : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u})),
        SC'.ShortExact ∧
        SC'.X₁ = G₁ ∧
        SC'.X₃ = G₃ ∧
        WeilIsEtaleSheafPullback h SC.X₂ SC'.X₂ ∧
        (ℓ • CategoryTheory.CategoryStruct.id SC.X₂ = 0 →
          ℓ • CategoryTheory.CategoryStruct.id SC'.X₂ = 0)) :=
by
  have hHasCo : ∀ (W : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.HasColimitsOfShape CategoryTheory.Limits.WalkingParallelPair
        (CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun _ => inferInstance
  let hTerm : ∀ (W : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (AlgebraicGeometry.Scheme.Etale.mk (𝟙 W)) := by
    intro W
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom (CategoryTheory.Category.comp_id E.hom)) ?_
    intro E m
    apply (AlgebraicGeometry.Scheme.Etale.forget W).map_injective
    exact CategoryTheory.Over.OverMorphism.ext
      ((CategoryTheory.Category.comp_id m.left).symm.trans
        (CategoryTheory.MorphismProperty.Over.w m))
  
  have hSite : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
