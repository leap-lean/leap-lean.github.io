              ((Nat.Prime.dvd_iff_eq hq_prime hp.ne_one).mp hdvd).symm
            rw [← heq_p]
            exact ringChar.charP k₀
          · rw [hp0, zero_dvd_iff] at hdvd
            exact absurd hdvd hq_prime.ne_zero
        haveI : ExpChar k₀ q := ExpChar.prime hq_prime
        have hsub0 : (a - b) ^ (q ^ N) = 0 := by
          rw [sub_pow_expChar_pow, hpow_eq, sub_self]
        exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero hsub0)
    have h_preσ_bij : Function.Bijective preσ := by
      constructor
      · intro φ₁ φ₂ heq
        apply AlgHom.ext
        intro x
        obtain ⟨y, hy⟩ := hPow x
        have hpow_eq : (φ₁ x) ^ (ringExpChar R ^ N) = (φ₂ x) ^ (ringExpChar R ^ N) := by
          rw [← map_pow, ← map_pow, ← hy]
          exact AlgHom.congr_fun heq y
        exact h_exp_cancel (ringExpChar R) (φ₁ x) (φ₂ x) hpow_eq
      · intro χ
        let p_id : Ideal S_h := RingHom.ker χ.toRingHom
        haveI : p_id.IsPrime := RingHom.ker_isPrime χ.toRingHom
        haveI : Module.Finite R_h B_h := Module.Finite.base_change R R_h B
        haveI : Module.Finite R_h D_h :=
          Module.Finite.of_surjective (Ideal.Quotient.mkₐ R_h (nilradical B_h)).toLinearMap
            Ideal.Quotient.mk_surjective
        have hInt_Rh : Algebra.IsIntegral R_h D_h := Algebra.IsIntegral.of_finite R_h D_h
        letI : Algebra S_h D_h := RingHom.toAlgebra (R := S_h) (S := D_h) σ.toRingHom
        haveI : Algebra.IsIntegral S_h D_h := by
          constructor
          intro d
          obtain ⟨f, hf_monic, hf_ev⟩ := hInt_Rh.isIntegral d
          refine ⟨f.map (algebraMap R_h S_h), hf_monic.map _, ?_⟩
          rw [Polynomial.eval₂_map]
          have hcomp_eq : (algebraMap S_h D_h).comp (algebraMap R_h S_h) = algebraMap R_h D_h := by
            ext r
            exact σ.commutes r
          rw [hcomp_eq]
          exact hf_ev
        have hbot_le : Ideal.under S_h (⊥ : Ideal D_h) ≤ p_id := by
          intro s hs
          change σ s ∈ (⊥ : Ideal D_h) at hs
          rw [Ideal.mem_bot] at hs
          rw [hInj (hs.trans (map_zero σ).symm)]
          exact Ideal.zero_mem _
        have lift_domain_hom : ∀ (A B_dom : Type u) [CommRing A] [IsDomain A]
            [CommRing B_dom] [IsDomain B_dom] (j : A →+* B_dom) (ψA : A →+* k₀),
            Function.Injective j → Function.Injective ψA →
            (∀ d : B_dom, ∃ f : Polynomial A, f.Monic ∧ Polynomial.eval₂ j d f = 0) →
            ∃ ψB : B_dom →+* k₀, ψB.comp j = ψA := by
          intro A B_dom _ _ _ _ j ψA hj hψA hIntB
          letI : Algebra A B_dom := j.toAlgebra
          letI : Algebra A k₀ := ψA.toAlgebra
          haveI : Algebra.IsIntegral A B_dom := ⟨hIntB⟩
          haveI : Algebra.IsAlgebraic A B_dom := Algebra.IsIntegral.isAlgebraic
          haveI : Module.IsTorsionFree A B_dom :=
            (Module.isTorsionFree_iff_algebraMap_injective).mpr hj
          haveI : Module.IsTorsionFree A k₀ :=
            (Module.isTorsionFree_iff_algebraMap_injective).mpr hψA
          let lift_alg : B_dom →ₐ[A] k₀ := IsAlgClosed.lift
          exact ⟨lift_alg.toRingHom, RingHom.ext lift_alg.commutes⟩
        obtain ⟨q_id, _, hq_prime, hq_over⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral (S := D_h) p_id (⊥ : Ideal D_h) hbot_le
        let j_hom : (S_h ⧸ p_id) →+* (D_h ⧸ q_id) :=
          Ideal.quotientMap q_id σ.toRingHom (le_of_eq hq_over.symm)
        have hj_inj : Function.Injective j_hom :=
          Ideal.quotientMap_injective' (le_of_eq hq_over)
        let χ_bar : (S_h ⧸ p_id) →+* k₀ := RingHom.kerLift χ.toRingHom
        have hχ_bar_inj : Function.Injective χ_bar := RingHom.kerLift_injective χ.toRingHom
        have hInt_Sh : Algebra.IsIntegral S_h D_h := inferInstance
        have hInt_quot : ∀ z : D_h ⧸ q_id,
            ∃ f : Polynomial (S_h ⧸ p_id), f.Monic ∧ Polynomial.eval₂ j_hom z f = 0 := by
          intro z
          obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
          obtain ⟨f, hf_monic, hf_ev⟩ := hInt_Sh.isIntegral y
          refine ⟨f.map (Ideal.Quotient.mk p_id), hf_monic.map _, ?_⟩
          rw [Polynomial.eval₂_map]
          have hcomp_mk : j_hom.comp (Ideal.Quotient.mk p_id) =
              (Ideal.Quotient.mk q_id).comp σ.toRingHom := by
            apply RingHom.ext
            intro x
            exact Ideal.quotientMap_mk (I := q_id) (J := p_id) (f := σ.toRingHom)
              (H := le_of_eq hq_over.symm) (x := x)
          rw [hcomp_mk, ← Polynomial.hom_eval₂]
          change Ideal.Quotient.mk q_id (Polynomial.eval₂ (algebraMap S_h D_h) y f) = 0
          rw [hf_ev, map_zero]
        obtain ⟨φ_bar, hφ_bar_comp⟩ :=
          lift_domain_hom (S_h ⧸ p_id) (D_h ⧸ q_id) j_hom χ_bar hj_inj hχ_bar_inj hInt_quot
        let φ_ring : D_h →+* k₀ := φ_bar.comp (Ideal.Quotient.mk q_id)
        have hφ_σ : ∀ s : S_h, φ_ring (σ s) = χ s := by
          intro s
          change φ_bar (Ideal.Quotient.mk q_id (σ s)) = χ s
          have hmk : Ideal.Quotient.mk q_id (σ s) = j_hom (Ideal.Quotient.mk p_id s) :=
            (Ideal.quotientMap_mk (I := q_id) (J := p_id) (f := σ.toRingHom)
              (H := le_of_eq hq_over.symm) (x := s)).symm
          rw [hmk, ← RingHom.comp_apply, hφ_bar_comp]
          exact RingHom.kerLift_mk χ.toRingHom s
        let φ_alg : D_h →ₐ[R_h] k₀ :=
          { φ_ring with
            commutes' := fun r => by
              change φ_ring (algebraMap R_h D_h r) = ψ_h r
              rw [← σ.commutes, hφ_σ, χ.commutes]
              rfl }
        refine ⟨φ_alg, ?_⟩
        apply AlgHom.ext
        intro s
        exact hφ_σ s
    let e₅ : (D_h →ₐ[R_h] k₀) ≃ (S_h →ₐ[R_h] k₀) := Equiv.ofBijective preσ h_preσ_bij
    let RootType : I → Type u := fun i => { α : k₀ // ((P i).map ψ_h).IsRoot α }
    let mkHom : (Σ i : I, RootType i) → (S_h →ₐ[R_h] k₀) :=
      fun ⟨i, ⟨α, hα⟩⟩ =>
        have hev : Polynomial.eval₂ (Algebra.ofId R_h k₀).toRingHom α (P i) = 0 := by
          change Polynomial.eval₂ ψ_h α (P i) = 0
          simpa [Polynomial.IsRoot.def, Polynomial.eval_map] using hα
        (AdjoinRoot.liftAlgHom (P i) (Algebra.ofId R_h k₀) α hev).comp
          (Pi.evalAlgHom R_h Fam i)
    have h_mkHom_bij : Function.Bijective mkHom := by
      constructor
      · rintro ⟨i₁, ⟨α₁, hα₁⟩⟩ ⟨i₂, ⟨α₂, hα₂⟩⟩ heq
        have h_eval_single_one : ∀ (i j : I) (r : RootType i),
            mkHom ⟨i, r⟩ (Pi.single (M := Fam) j (1 : Fam j)) = if j = i then 1 else 0 := by
          rintro i j ⟨α, hα⟩
          dsimp only [mkHom, AlgHom.comp_apply]
          change (AdjoinRoot.liftAlgHom (P i) (Algebra.ofId R_h k₀) α _)
            (Pi.single (M := Fam) j (1 : Fam j) i) = _
          by_cases hji : j = i
          · subst hji; rw [if_pos rfl, Pi.single_eq_same, map_one]
          · rw [if_neg hji, Pi.single_eq_of_ne (Ne.symm hji), map_zero]
        have hi : i₁ = i₂ := by
          by_contra hne
          have hval := AlgHom.congr_fun heq (Pi.single (M := Fam) i₁ (1 : Fam i₁))
          rw [h_eval_single_one i₁ i₁ ⟨α₁, hα₁⟩, h_eval_single_one i₂ i₁ ⟨α₂, hα₂⟩,
            if_pos rfl, if_neg hne] at hval
          exact one_ne_zero hval
        subst hi
        have h_eval_root : ∀ (i : I) (r : RootType i),
            mkHom ⟨i, r⟩ (Pi.single (M := Fam) i (AdjoinRoot.root (P i))) = r.1 := by
          rintro i ⟨α, hα⟩
          dsimp only [mkHom, AlgHom.comp_apply]
          change (AdjoinRoot.liftAlgHom (P i) (Algebra.ofId R_h k₀) α _)
            (Pi.single (M := Fam) i (AdjoinRoot.root (P i)) i) = α
          rw [Pi.single_eq_same]
          exact AdjoinRoot.liftAlgHom_root (P i) (Algebra.ofId R_h k₀) α _
        have hroot := AlgHom.congr_fun heq (Pi.single (M := Fam) i₁ (AdjoinRoot.root (P i₁)))
        rw [h_eval_root i₁ ⟨α₁, hα₁⟩, h_eval_root i₁ ⟨α₂, hα₂⟩] at hroot
        exact Sigma.ext rfl (heq_of_eq (Subtype.ext hroot))
      · intro χ
        let e_id : I → S_h := fun j => Pi.single (M := Fam) j 1
        have hsum_e : ∑ j : I, e_id j = 1 := by
          funext j
          rw [Finset.sum_apply, Pi.one_apply, Finset.sum_eq_single j]
          · simp [e_id]
          · intro b _ hbj
            simp [e_id, Pi.single_eq_of_ne (Ne.symm hbj)]
          · intro hj_abs
            exact absurd (Finset.mem_univ j) hj_abs
        have hex_i : ∃ i : I, χ (e_id i) ≠ 0 := by
          by_contra! hall
          have h1 : (1 : k₀) = 0 := by
            calc
              (1 : k₀) = χ 1 := (map_one χ).symm
              _ = χ (∑ j : I, e_id j) := by rw [hsum_e]
              _ = ∑ j : I, χ (e_id j) := map_sum χ _ _
              _ = 0 := Finset.sum_eq_zero (fun j _ => hall j)
          exact one_ne_zero h1
        obtain ⟨i, hi_ne⟩ := hex_i
        have hi_one : χ (e_id i) = 1 := by
          have hidem : e_id i * e_id i = e_id i := by
            funext j
            rw [Pi.mul_apply]
            by_cases hj : j = i
            · subst hj; simp [e_id]
            · simp [e_id, Pi.single_eq_of_ne hj]
          have hmul : χ (e_id i) * (χ (e_id i) - 1) = 0 := by
            rw [mul_sub, mul_one, ← map_mul, hidem, sub_self]
          exact sub_eq_zero.mp ((mul_eq_zero.mp hmul).resolve_left hi_ne)
        have hj_zero : ∀ j : I, j ≠ i → χ (e_id j) = 0 := by
          intro j hji
          have horth : e_id j * e_id i = 0 := by
            funext k
            rw [Pi.mul_apply, Pi.zero_apply]
            by_cases hk : k = i
            · subst hk; simp [e_id, Pi.single_eq_of_ne (Ne.symm hji)]
            · simp [e_id, Pi.single_eq_of_ne hk]
          have h0 : χ (e_id j) * χ (e_id i) = 0 := by rw [← map_mul, horth, map_zero]
          simpa [hi_one] using h0
        let χ_i : AdjoinRoot (P i) →ₐ[R_h] k₀ :=
          { toFun := fun a => χ (Pi.single (M := Fam) i a)
            map_one' := hi_one
            map_mul' := fun a b => by
              have hmul_s : Pi.single (M := Fam) i (a * b) =
                  Pi.single (M := Fam) i a * Pi.single (M := Fam) i b := by
                funext k
                rw [Pi.mul_apply]
                by_cases hk : k = i
                · subst hk; simp
                · simp [Pi.single_eq_of_ne hk]
              rw [hmul_s, map_mul]
            map_zero' := by rw [Pi.single_zero, map_zero]
            map_add' := fun a b => by
              have hadd_s : Pi.single (M := Fam) i (a + b) =
                  Pi.single (M := Fam) i a + Pi.single (M := Fam) i b := by
                funext k
                rw [Pi.add_apply]
                by_cases hk : k = i
                · subst hk; simp
                · simp [Pi.single_eq_of_ne hk]
              rw [hadd_s, map_add]
            commutes' := fun r => by
              have hsingle : Pi.single (M := Fam) i (algebraMap R_h (Fam i) r) =
                  r • e_id i := by
                funext k
                rw [Pi.smul_apply]
                by_cases hk : k = i
                · subst hk; simp [e_id, Algebra.algebraMap_eq_smul_one]
                · simp [e_id, Pi.single_eq_of_ne hk]
              rw [hsingle, AlgHom.map_smul_of_tower, hi_one, Algebra.smul_def, mul_one] }
        let α : k₀ := χ_i (AdjoinRoot.root (P i))
        have hα_ev : Polynomial.eval₂ ψ_h α (P i) = 0 := by
          have haev : Polynomial.eval₂ (algebraMap R_h (AdjoinRoot (P i)))
              (AdjoinRoot.root (P i)) (P i) = 0 := by
            rw [← Polynomial.aeval_def, AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
          have hhom := Polynomial.hom_eval₂ (P i) (algebraMap R_h (AdjoinRoot (P i)))
            χ_i.toRingHom (AdjoinRoot.root (P i))
          have hcomp : χ_i.toRingHom.comp (algebraMap R_h (AdjoinRoot (P i))) = ψ_h := by
            ext r
            exact χ_i.commutes r
          rw [hcomp] at hhom
          change Polynomial.eval₂ ψ_h (χ_i.toRingHom (AdjoinRoot.root (P i))) (P i) = 0
          rw [← hhom, haev, map_zero]
        have hα_root : ((P i).map ψ_h).IsRoot α := by
          rw [Polynomial.IsRoot.def, Polynomial.eval_map]
          exact hα_ev
        refine ⟨⟨i, ⟨α, hα_root⟩⟩, ?_⟩
        have hχ_i_eq : AdjoinRoot.liftAlgHom (P i) (Algebra.ofId R_h k₀) α hα_ev = χ_i := by
          apply AdjoinRoot.algHom_ext
          exact AdjoinRoot.liftAlgHom_root (P i) (Algebra.ofId R_h k₀) α hα_ev
        apply AlgHom.ext
        intro u
        change (AdjoinRoot.liftAlgHom (P i) (Algebra.ofId R_h k₀) α hα_ev) (u i) = χ u
        rw [hχ_i_eq]
        have hu_sum : u = ∑ j : I, Pi.single (M := Fam) j (u j) := by
          funext k
          rw [Finset.sum_apply, Finset.sum_eq_single k]
          · simp
          · intro b _ hbk
            simp [Pi.single_eq_of_ne (Ne.symm hbk)]
          · intro hk_abs
            exact absurd (Finset.mem_univ k) hk_abs
        conv_rhs => rw [hu_sum, map_sum]
        symm
        apply Finset.sum_eq_single i
        · intro j _ hji
          have hmul_e : Pi.single (M := Fam) j (u j) = Pi.single (M := Fam) j (u j) * e_id j := by
            funext k
            rw [Pi.mul_apply]
            by_cases hk : k = j
            · subst hk; simp [e_id]
            · simp [e_id, Pi.single_eq_of_ne hk]
          rw [hmul_e, map_mul, hj_zero j hji, mul_zero]
        · intro hi_abs
          exact absurd (Finset.mem_univ i) hi_abs
    let e₆ : (S_h →ₐ[R_h] k₀) ≃ (Σ i : I, RootType i) :=
      (Equiv.ofBijective mkHom h_mkHom_bij).symm
    let e_all : PrimeSpectrum (TensorProduct R B k₀) ≃ (Σ i : I, RootType i) :=
      e₁.trans (e₂.trans (e₃.trans (e₄_loc.symm.trans (e₄_nil.symm.trans (e₅.trans e₆)))))
    let e_roots : ∀ i : I, RootType i ≃ ↥(((P i).map ψ_h).roots.toFinset) := fun i =>
      let q_i : Polynomial k₀ := (P i).map ψ_h
      have hq_ne : q_i ≠ 0 := ((hP i).1.map ψ_h).ne_zero
      { toFun := fun ⟨α, hα⟩ => ⟨α, Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hq_ne).mpr hα)⟩
        invFun := fun ⟨α, hα⟩ => ⟨α, (Polynomial.mem_roots hq_ne).mp (Multiset.mem_toFinset.mp hα)⟩
        left_inv := fun ⟨_, _⟩ => rfl
        right_inv := fun ⟨_, _⟩ => rfl }
    haveI : ∀ i : I, Finite (RootType i) := fun i => Finite.of_equiv _ (e_roots i).symm
    rw [Nat.card_congr e_all, Nat.card_sigma]
    change ∑ i : I, Nat.card (RootType i) = ∑ i : I, (P i).natDegree
    apply Finset.sum_congr rfl
    intro i _
    let q_i : Polynomial k₀ := (P i).map ψ_h
    have hq_monic : q_i.Monic := (hP i).1.map ψ_h
    have hq_deg : q_i.natDegree = (P i).natDegree := (hP i).1.natDegree_map ψ_h
    have hq_sep : q_i.Separable := by
      rw [Polynomial.separable_def]
      have hcop := ((Polynomial.separable_def (P i)).mp (hP i).2).map (Polynomial.mapRingHom ψ_h)
      simpa [q_i, Polynomial.derivative_map] using hcop
    have hq_nodup : q_i.roots.Nodup := Polynomial.nodup_roots hq_sep
    have hq_splits : q_i.Splits := IsAlgClosed.splits q_i
    rw [Nat.card_congr (e_roots i), Nat.card_eq_fintype_card, Fintype.card_coe,
      Multiset.toFinset_card_of_nodup hq_nodup, ← hq_splits.natDegree_eq_card_roots, hq_deg]

  have h_genAlg : ∀ (R₀ R₁ : Type u) [CommRing R₀] [IsDomain R₀] [CommRing R₁] [IsDomain R₁]
      [Algebra R₀ R₁] [Algebra.FiniteType R₀ R₁],
      Function.Injective (algebraMap R₀ R₁) →
      (∀ x : R₁, ∃ p : Polynomial R₀, p ≠ 0 ∧ Polynomial.aeval x p = 0) →
      ∀ (b : R₁), b ≠ 0 →
        ∃ (h₁ : R₀), h₁ ≠ 0 ∧
          ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
            (ψ₀ : R₀ →+* k₀),
            ψ₀ h₁ ≠ 0 →
            ∃ (ψ₁ : R₁ →+* k₀),
              ψ₁.comp (algebraMap R₀ R₁) = ψ₀ ∧ ψ₁ b ≠ 0 := by
    intro R₀ R₁ _ _ _ _ _ _ hInj hAlg b hb
    classical
    let φ : R₀ →+* R₁ := algebraMap R₀ R₁
    obtain ⟨G, hG⟩ := Algebra.FiniteType.out (R := R₀) (A := R₁)
    choose p_gen hp_ne hp_ev using hAlg
    let h₀ : R₀ := ∏ y ∈ G, (p_gen y).leadingCoeff
    have hh₀_ne : h₀ ≠ 0 := by
      rw [Finset.prod_ne_zero_iff]
      intro y _
      exact Polynomial.leadingCoeff_ne_zero.mpr (hp_ne y)
    have hφh₀_ne : φ h₀ ≠ 0 := fun h0 => hh₀_ne (hInj (h0.trans (map_zero φ).symm))
    have hSub₀ : Submonoid.powers h₀ ≤ nonZeroDivisors R₀ := by
      rintro _ ⟨n, rfl⟩
      exact Submonoid.pow_mem _ (mem_nonZeroDivisors_of_ne_zero hh₀_ne) n
    have hSub₁ : Submonoid.powers (φ h₀) ≤ nonZeroDivisors R₁ := by
      rintro _ ⟨n, rfl⟩
      exact Submonoid.pow_mem _ (mem_nonZeroDivisors_of_ne_zero hφh₀_ne) n
    have hex_loc : ∃ (R'₀ R'₁ : Type u) (_ : CommRing R'₀) (_ : IsDomain R'₀)
        (_ : CommRing R'₁) (_ : IsDomain R'₁)
        (_ : Algebra R₀ R'₀) (_ : IsLocalization.Away h₀ R'₀)
        (_ : Algebra R₁ R'₁) (_ : IsLocalization.Away (φ h₀) R'₁)
        (φ' : R'₀ →+* R'₁),
        φ'.comp (algebraMap R₀ R'₀) = (algebraMap R₁ R'₁).comp φ := by
      refine ⟨Localization.Away h₀, Localization.Away (φ h₀),
        inferInstance, IsLocalization.isDomain_localization hSub₀,
        inferInstance, IsLocalization.isDomain_localization hSub₁,
        inferInstance, inferInstance, inferInstance, inferInstance, ?_⟩
      have hUnit : IsUnit (((algebraMap R₁ (Localization.Away (φ h₀))).comp φ) h₀) :=
        IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (φ h₀)) (φ h₀)
      refine ⟨IsLocalization.Away.lift (S := Localization.Away h₀)
          (g := (algebraMap R₁ (Localization.Away (φ h₀))).comp φ) h₀ hUnit, ?_⟩
      ext r
      exact IsLocalization.Away.lift_eq (S := Localization.Away h₀)
        (g := (algebraMap R₁ (Localization.Away (φ h₀))).comp φ) (x := h₀) hUnit r
    obtain ⟨R'₀, R'₁, _, _, _, _, _, _, _, _, φ', hφ'_comp⟩ := hex_loc
    let ι₀ : R₀ →+* R'₀ := algebraMap R₀ R'₀
    let ι₁ : R₁ →+* R'₁ := algebraMap R₁ R'₁
    have hι₀_inj : Function.Injective ι₀ := IsLocalization.injective R'₀ hSub₀
    have hι₁_inj : Function.Injective ι₁ := IsLocalization.injective R'₁ hSub₁
    have hφ'_apply : ∀ r : R₀, φ' (ι₀ r) = ι₁ (φ r) :=
      fun r => RingHom.congr_fun hφ'_comp r
    have hφ'_inj : Function.Injective φ' := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      let sec := IsLocalization.Away.sec h₀ x
      have hsec : x * ι₀ h₀ ^ sec.2 = ι₀ sec.1 := by
        simpa [ι₀, mul_comm] using (IsLocalization.Away.sec_spec (x := h₀) x)
      have h0 : ι₁ (φ sec.1) = 0 := by
        rw [← hφ'_apply, ← hsec, map_mul, hx, zero_mul]
      have hr0 : sec.1 = 0 := hInj (hι₁_inj (h0.trans (by simp)))
      have hx_mul : x * ι₀ h₀ ^ sec.2 = 0 := by rw [hsec, hr0, map_zero]
      have hpow_ne : ι₀ h₀ ^ sec.2 ≠ 0 :=
