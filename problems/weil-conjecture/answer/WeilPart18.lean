          S_F.X₁ = weilEtaleHigherDirectImage iY₀ 0 (T_U₂ ℒ) ∧
          S_F.X₂ = F ∧
          S_F.X₃ = weilEtaleHigherDirectImage iC_bad 0 F_bad₀) :=
