theorem weil_etale_open_extensionByZero_and_finite_baseChange (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType X.hom]
    [AlgebraicGeometry.IsSeparated X.hom]
    (C : TopologicalSpace.Closeds ↥X.left)
    (U₂ : (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subscheme.Opens)
    (Y' : AlgebraicGeometry.Scheme.{u})
    (ν : Y' ⟶ (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subscheme)
    (hFin_ν : AlgebraicGeometry.IsFinite ν)
    (C_bad : TopologicalSpace.Closeds ↥X.left)
    (hC_bad_eq : (C_bad : Set ↥X.left) =
      ⇑(AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subschemeι.base ''
        ((U₂ : Set ↥(AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subscheme)ᶜ)) :
    let Y₀ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subscheme
    let iY₀ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subschemeι
    let U' := ν ⁻¹ᵁ U₂
    let iC_bad := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_bad).subschemeι
    ∃ (T_U' : CategoryTheory.Sheaf U'.toScheme.smallEtaleTopology AddCommGrpCat.{u} →
          CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u})
      (T_U₂ : CategoryTheory.Sheaf U₂.toScheme.smallEtaleTopology AddCommGrpCat.{u} →
          CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (N N' : CategoryTheory.Sheaf U'.toScheme.smallEtaleTopology AddCommGrpCat.{u}),
        (CategoryTheory.Limits.IsZero N → CategoryTheory.Limits.IsZero (T_U' N)) ∧
        (ℓ • CategoryTheory.CategoryStruct.id N = 0 →
          ℓ • CategoryTheory.CategoryStruct.id (T_U' N) = 0) ∧
        (Nonempty (N ≅ N') → Nonempty (T_U' N ≅ T_U' N'))) ∧
      (∀ (S : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf U'.toScheme.smallEtaleTopology AddCommGrpCat.{u})),
        S.ShortExact →
        ∃ (S' : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u})),
          S'.ShortExact ∧ S'.X₁ = T_U' S.X₁ ∧ S'.X₂ = T_U' S.X₂ ∧ S'.X₃ = T_U' S.X₃) ∧
      (∀ (L₁ L₂ : CategoryTheory.Sheaf U₂.toScheme.smallEtaleTopology AddCommGrpCat.{u}),
        (∃ (i : L₁ ⟶ L₂) (r : L₂ ⟶ L₁), i ≫ r = 𝟙 L₁) →
        ∃ (i₀ : T_U₂ L₁ ⟶ T_U₂ L₂) (r₀ : T_U₂ L₂ ⟶ T_U₂ L₁), i₀ ≫ r₀ = 𝟙 (T_U₂ L₁)) ∧
      (∃ (W' : AlgebraicGeometry.Scheme.{u}) (iW' : W' ⟶ Y')
         (S₀ : CategoryTheory.ShortComplex
           (CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u})),
        AlgebraicGeometry.IsClosedImmersion iW' ∧
        S₀.ShortExact ∧
        S₀.X₁ = T_U' (weilEtaleTorsionSheaf U'.toScheme ℓ) ∧
        S₀.X₂ = weilEtaleTorsionSheaf Y' ℓ ∧
        S₀.X₃ = weilEtaleHigherDirectImage iW' 0 (weilEtaleTorsionSheaf W' ℓ)) ∧
      (∀ (ℳ : CategoryTheory.Sheaf U'.toScheme.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id ℳ = 0 →
        Nonempty (weilEtaleHigherDirectImage ν 0 (T_U' ℳ) ≅
          T_U₂ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ))) ∧
      (∀ (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})
          (F_bad₀ : CategoryTheory.Sheaf
            (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_bad).subscheme.smallEtaleTopology
