      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply (CategoryTheory.cancel_epi (𝒮_x.map (CategoryTheory.Limits.cokernel.π η))).mp
      rw [CategoryTheory.Category.comp_id, CategoryTheory.Limits.comp_zero]
      by_cases hx₁ : xbar.base default ∈ (C₁ : Set ↥X.left)
