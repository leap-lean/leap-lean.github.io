    exact Module.Finite.of_restrictScalars_finite (MvPolynomial (Fin s) k) A ↥(integralClosure A K₀)

  
  
  
  obtain ⟨⟨x₀, hx₀⟩⟩ := hU₀
  obtain ⟨U_aff, hU_aff, hx₀_aff, hU_aff_le⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := Y₀) (x := x₀) (U := U₀) hx₀
  haveI hU_aff_ne : Nonempty U_aff := ⟨⟨x₀, hx₀_aff⟩⟩
  haveI : AlgebraicGeometry.IsAffine U_aff.toScheme := hU_aff
  have h_range_Uaff : Set.range U_aff.ι.base ⊆ Set.range U₀.ι.base := by
