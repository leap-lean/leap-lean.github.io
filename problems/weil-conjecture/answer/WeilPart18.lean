      exact Set.disjoint_left.mp (hDisj c' c hne.symm) hy_Zc'
    have h_eq : ((((θ₀ c ≫ ψ₀ c').app (Opposite.op V_et)) t_sub)).1 p' =
        (((θ₀ c).app (Opposite.op V_et)) t_sub).1 (pr₁'.base p') := by
      have hψ_eval : ∀ (u₀ : ↥(weilAltZeroBdrySubgroup Y₀ V_good n V_et)),
          (((ψ₀ c').app (Opposite.op V_et)) u₀).1 p' = u₀.1 (pr₁'.base p') := by
        intro u₀
        have h1 := congrArg (fun α => (α.app (Opposite.op V_et)) u₀) (hψ₀_comm c')
        exact congrArg (fun g : LocallyConstant _ _ => g p') h1
      exact hψ_eval (((θ₀ c).app (Opposite.op V_et)) t_sub)
    exact h_eq.trans (hθ_off c V_et t_sub (pr₁'.base p') hx_not_Vc)

  have h₀_sum : (∑ c : Fin r, ψ₀_sh c ≫ θ₀_sh c) = 𝟙 L0_Y_sh := by
    have hsum_eval : ∀ (S_fin : Finset (Fin r)) (V_et : Y₀.Etale)
        (s : ↥(weilAltZeroBdrySubgroup Y₀ V_good n V_et))
        (x : ↥((Scheme.Etale.forget Y₀).obj V_et).left),
        ((((∑ c ∈ S_fin, (ψ₀_sh c ≫ θ₀_sh c)).hom.app (Opposite.op V_et)) s)).1 x =
          ∑ c ∈ S_fin, ((((ψ₀ c ≫ θ₀ c).app (Opposite.op V_et)) s)).1 x := by
      intro S_fin V_et s x
      induction S_fin using Finset.induction_on with
      | empty => rfl
      | @insert a S' ha ih =>
        rw [Finset.sum_insert ha, Finset.sum_insert ha]
        change ((((ψ₀ a ≫ θ₀ a).app (Opposite.op V_et)) s)).1 x +
          ((((∑ c ∈ S', (ψ₀_sh c ≫ θ₀_sh c)).hom.app (Opposite.op V_et)) s)).1 x = _
        rw [ih]
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    cases U with | op V_et =>
    apply AddCommGrpCat.ext
    intro s
    let s_sub : ↥(weilAltZeroBdrySubgroup Y₀ V_good n V_et) := s
    apply Subtype.ext
    apply LocallyConstant.ext
    intro x
    change ((((∑ c : Fin r, (ψ₀_sh c ≫ θ₀_sh c)).hom.app (Opposite.op V_et)) s_sub)).1 x =
      s_sub.1 x
    rw [hsum_eval Finset.univ V_et s_sub x]
    by_cases hex : ∃ c₀ : Fin r, ((Scheme.Etale.forget Y₀).obj V_et).hom.base x ∈
        (V_comp c₀ : Set ↥Y₀)
    · obtain ⟨c₀, hc₀⟩ := hex
      rw [Finset.sum_eq_single c₀]
      · exact hψθ_on c₀ V_et s_sub x hc₀
      · intro c _ hc_ne
        have hx_not_c : ((Scheme.Etale.forget Y₀).obj V_et).hom.base x ∉
