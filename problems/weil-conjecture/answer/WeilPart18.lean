    · rcases hKY with ⟨hContZY, TY, hTY, TZY, hTZY, h0Y, hSY⟩
      let I_ZY := weilAltClosedComplIdeal Y₀ U_Y
      obtain ⟨hContZY', hInjZY', hTermZY⟩ := hPart2 I_ZY.subschemeι
      have hInjZY : ∀ (I : Sheaf I_ZY.subscheme.smallEtaleTopology AddCommGrpCat.{u}),
          Injective I →
          Injective
            ((@Functor.sheafPushforwardContinuous _ _ _ _
              (weilEtaleSitePullback I_ZY.subschemeι) AddCommGrpCat.{u} _
              J₁ I_ZY.subscheme.smallEtaleTopology hContZY).obj I) := by
        have hc : hContZY' = hContZY := Subsingleton.elim _ _
        rwa [← hc]
      have hSubPush := hPart3 I_ZY.subschemeι hContZY hInjZY hTermZY n q₀ hSubZY
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ (C₁.obj Aℤ) hSY u_c hu_c hq₀
      rw [← hx₃, @Subsingleton.elim _ hSubPush x₃ 0, Abelian.Ext.zero_comp]
  obtain ⟨Φ_X, Ψ_X, hΦX_unit, hΨX_comm⟩ := (hIsoX K_X ι_X hKX).2 T₂ hT₂
  obtain ⟨Φ_Y, Ψ_Y, hΦY_unit, hΨY_comm⟩ := (hIsoY K_Y ι_Y hKY).2 T₁ hT₁
  obtain ⟨η₀, τ₀, hη₀_comm, h_tr₀⟩ := hPart4 f V δ n hSplit
  let LX_sh : Sheaf J₂ AddCommGrpCat.{u} := ⟨weilAltLocConstPresheaf X₀ n, hShLX⟩
  let LY_sh : Sheaf J₁ AddCommGrpCat.{u} := ⟨weilAltLocConstPresheaf Y₀ n, hShLY⟩
  let L0X_sh : Sheaf J₂ AddCommGrpCat.{u} := ⟨weilAltZeroBdrySubpresheaf X₀ V n, hSh0X⟩
  let L0Y_sh : Sheaf J₁ AddCommGrpCat.{u} := ⟨weilAltZeroBdrySubpresheaf Y₀ U_Y n, hSh0Y⟩
  let ι0X_sh : L0X_sh ⟶ LX_sh := ObjectProperty.homMk (weilAltZeroBdrySubpresheafι X₀ V n)
  let ι0Y_sh : L0Y_sh ⟶ LY_sh := ObjectProperty.homMk (weilAltZeroBdrySubpresheafι Y₀ U_Y n)
  let η₀_sh : L0X_sh ⟶ P_push.obj L0Y_sh := ObjectProperty.homMk η₀
  let τ₀_sh : P_push.obj L0Y_sh ⟶ L0X_sh := ObjectProperty.homMk τ₀
  let pull_sh : LX_sh ⟶ P_push.obj LY_sh := ObjectProperty.homMk (weilAltLocConstPullbackNat f n)
  let adj₁ := constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
  let adj₂ := constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
  let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
  let η_const : C₂.obj AM ⟶ P_push.obj (C₁.obj AM) :=
    (adj₂.homEquiv AM (P_push.obj (C₁.obj AM))).symm
      (adj₁.unit.app AM ≫ (C₁.obj AM).obj.map τ.op)
  let πM : P_pull.obj (C₂.obj AM) ⟶ C₁.obj AM :=
    (adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM)).symm η_const
  have hπM_counit : πM = P_pull.map η_const ≫ adj_pull.counit.app (C₁.obj AM) := by
    dsimp only [πM]
    exact Adjunction.homEquiv_counit _ _ _ _
  have h_η_const_Φ : η_const ≫ P_push.map Φ_Y.hom = Φ_X.hom ≫ pull_sh := by
    apply (adj₂.homEquiv AM (P_push.obj LY_sh)).injective
    rw [Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply, Adjunction.homEquiv_unit]
    change (adj₁.unit.app AM ≫ (C₁.obj AM).obj.map τ.op) ≫
        Φ_Y.hom.hom.app (Opposite.op (B.obj T₂)) =
      adj₂.unit.app AM ≫ (Φ_X.hom.hom.app (Opposite.op T₂) ≫ pull_sh.hom.app (Opposite.op T₂))
    rw [Category.assoc (adj₁.unit.app AM), Φ_Y.hom.hom.naturality τ.op,
      ← Category.assoc (adj₁.unit.app AM), hΦY_unit,
      ← Category.assoc (adj₂.unit.app AM), hΦX_unit]
    exact AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl))
  have hη₀_sh_comm : η₀_sh ≫ P_push.map ι0Y_sh = ι0X_sh ≫ pull_sh := by
    apply ObjectProperty.hom_ext
    exact hη₀_comm
  have h_tr₀_sh : η₀_sh ≫ τ₀_sh = δ • 𝟙 L0X_sh := by
    apply ObjectProperty.hom_ext
    change η₀ ≫ τ₀ = (δ • 𝟙 L0X_sh).hom
    have hsmul_hom : (δ • 𝟙 L0X_sh).hom = δ • 𝟙 (weilAltZeroBdrySubpresheaf X₀ V n) := by
      clear * -
      induction δ with
      | zero =>
        rw [zero_smul, zero_smul]
        rfl
      | succ d ih =>
        rw [succ_nsmul, succ_nsmul]
        exact congrArg (· + 𝟙 _) ih
    rw [hsmul_hom]
    exact h_tr₀
  let η_f : K_X ⟶ P_push.obj K_Y := Ψ_X.hom ≫ η₀_sh ≫ P_push.map Ψ_Y.inv
  let τ_f : P_push.obj K_Y ⟶ K_X := P_push.map Ψ_Y.hom ≫ τ₀_sh ≫ Ψ_X.inv
  have hΨY_inv_comm : Ψ_Y.inv ≫ ι_Y = ι0Y_sh ≫ Φ_Y.inv := by
    rw [← cancel_mono Φ_Y.hom, ← cancel_epi Ψ_Y.hom,
      Category.assoc, Category.assoc, Φ_Y.inv_hom_id, Category.comp_id,
      ← Category.assoc Ψ_Y.hom, Ψ_Y.hom_inv_id, Category.id_comp]
    exact hΨY_comm.symm
  have h_η_sq : η_f ≫ P_push.map ι_Y = ι_X ≫ η_const := by
    dsimp only [η_f]
    have h_const_inv : Φ_X.hom ≫ pull_sh ≫ P_push.map Φ_Y.inv = η_const := by
      rw [← Category.assoc, ← h_η_const_Φ, Category.assoc, ← P_push.map_comp,
        Φ_Y.hom_inv_id, P_push.map_id, Category.comp_id]
    calc
      (Ψ_X.hom ≫ η₀_sh ≫ P_push.map Ψ_Y.inv) ≫ P_push.map ι_Y
        = Ψ_X.hom ≫ η₀_sh ≫ P_push.map (Ψ_Y.inv ≫ ι_Y) := by
            rw [Category.assoc, Category.assoc, ← P_push.map_comp]
      _ = Ψ_X.hom ≫ (η₀_sh ≫ P_push.map ι0Y_sh) ≫ P_push.map Φ_Y.inv := by
            rw [hΨY_inv_comm, P_push.map_comp, ← Category.assoc η₀_sh]
      _ = (Ψ_X.hom ≫ ι0X_sh) ≫ pull_sh ≫ P_push.map Φ_Y.inv := by
            rw [hη₀_sh_comm, Category.assoc, ← Category.assoc Ψ_X.hom]
      _ = ι_X ≫ (Φ_X.hom ≫ pull_sh ≫ P_push.map Φ_Y.inv) := by
            rw [show Ψ_X.hom ≫ ι0X_sh = ι_X ≫ Φ_X.hom from hΨX_comm, Category.assoc]
      _ = ι_X ≫ η_const := by rw [h_const_inv]
  have h_ητ : η_f ≫ τ_f = δ • 𝟙 K_X := by
    dsimp only [η_f, τ_f]
    calc
      (Ψ_X.hom ≫ η₀_sh ≫ P_push.map Ψ_Y.inv) ≫ (P_push.map Ψ_Y.hom ≫ τ₀_sh ≫ Ψ_X.inv)
        = Ψ_X.hom ≫ η₀_sh ≫ (P_push.map Ψ_Y.inv ≫ P_push.map Ψ_Y.hom) ≫ τ₀_sh ≫ Ψ_X.inv := by
            simp only [Category.assoc]
      _ = Ψ_X.hom ≫ (η₀_sh ≫ τ₀_sh) ≫ Ψ_X.inv := by
            rw [← P_push.map_comp, Ψ_Y.inv_hom_id, P_push.map_id, Category.id_comp, Category.assoc]
      _ = Ψ_X.hom ≫ (δ • 𝟙 L0X_sh) ≫ Ψ_X.inv := by rw [h_tr₀_sh]
      _ = δ • (Ψ_X.hom ≫ 𝟙 L0X_sh ≫ Ψ_X.inv) := by
            rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul]
      _ = δ • 𝟙 K_X := by rw [Category.id_comp, Ψ_X.hom_inv_id]
  obtain ⟨w_c, hw_c⟩ := hLiftX
  let z : Abelian.Ext (C₂.obj Aℤ) (P_push.obj K_Y) q :=
    w_c.comp (Abelian.Ext.mk₀ η_f) (Nat.add_zero q)
  let u_c : Abelian.Ext (C₁.obj Aℤ) K_Y q :=
    (Abelian.Ext.mk₀ (adj_pull.counit.app K_Y)).postcomp (C₁.obj Aℤ) (Nat.add_zero q)
      ((Abelian.Ext.mk₀ ιℤ).comp
        ((P_pull.mapExtAddHom (C₂.obj Aℤ) (P_push.obj K_Y) q) z) (Nat.zero_add q))
  have h_mor_eq : P_pull.map η_f ≫ adj_pull.counit.app K_Y ≫ ι_Y = P_pull.map ι_X ≫ πM := by
    have hcounit_nat : adj_pull.counit.app K_Y ≫ ι_Y =
        P_pull.map (P_push.map ι_Y) ≫ adj_pull.counit.app (C₁.obj AM) :=
      (adj_pull.counit.naturality ι_Y).symm
    rw [hcounit_nat, ← Category.assoc, ← P_pull.map_comp, h_η_sq, P_pull.map_comp,
      Category.assoc, ← hπM_counit]
  have hpost_eq : ∀ {X Y W : Sheaf J₁ AddCommGrpCat.{u}}
      (a : Abelian.Ext X Y q) (g : Y ⟶ W),
      (Abelian.Ext.mk₀ g).postcomp X (Nat.add_zero q) a =
        a.comp (Abelian.Ext.mk₀ g) (Nat.add_zero q) := by
    intro X Y W a g
    rfl
  have hu_c_ιY : u_c.comp (Abelian.Ext.mk₀ ι_Y) (Nat.add_zero q) = p_q w := by
    dsimp only [u_c]
    rw [hpost_eq, hp_eq w, hpost_eq]
    have hz_map : (P_pull.mapExtAddHom (C₂.obj Aℤ) (P_push.obj K_Y) q) z =
        ((P_pull.mapExtAddHom (C₂.obj Aℤ) K_X q) w_c).comp
          (Abelian.Ext.mk₀ (P_pull.map η_f)) (Nat.add_zero q) := by
      dsimp only [z]
      rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
        Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    have hw_map : (P_pull.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) q) w =
        ((P_pull.mapExtAddHom (C₂.obj Aℤ) K_X q) w_c).comp
          (Abelian.Ext.mk₀ (P_pull.map ι_X)) (Nat.add_zero q) := by
      rw [← hw_c, Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
        Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    rw [hz_map, hw_map,
      Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q),
      Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ιℤ) _ _ (Nat.zero_add q) (Nat.add_zero q) (by omega),
      Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q),
      Abelian.Ext.mk₀_comp_mk₀, h_mor_eq, ← Abelian.Ext.mk₀_comp_mk₀,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q),
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ιℤ) _ _ (Nat.zero_add q) (Nat.add_zero q) (by omega)]
  have hu_c_zero : u_c = 0 := hInjY u_c (hu_c_ιY.trans hw)
  have hz_zero : z = 0 :=
    hLeray hCont hRA hAdd hPFL hPFC T₁ hT₁ T₂ hT₂ ιℤ h_ιπ h_πι z hu_c_zero
  have hmk₀_smul : Abelian.Ext.mk₀ (δ • 𝟙 K_X) = δ • Abelian.Ext.mk₀ (𝟙 K_X) :=
    map_nsmul Abelian.Ext.addEquiv₀.symm δ (𝟙 K_X)
  have hδ_wc : δ • w_c = 0 := by
    calc
      δ • w_c
        = δ • (w_c.comp (Abelian.Ext.mk₀ (𝟙 K_X)) (Nat.add_zero q)) := by
            rw [Abelian.Ext.comp_mk₀_id]
      _ = w_c.comp (δ • Abelian.Ext.mk₀ (𝟙 K_X)) (Nat.add_zero q) :=
            (map_nsmul (Abelian.Ext.bilinearComp (C₂.obj Aℤ) K_X K_X q 0 q (Nat.add_zero q) w_c)
              δ (Abelian.Ext.mk₀ (𝟙 K_X))).symm
      _ = w_c.comp (Abelian.Ext.mk₀ (η_f ≫ τ_f)) (Nat.add_zero q) := by
            rw [← hmk₀_smul, ← h_ητ]
      _ = z.comp (Abelian.Ext.mk₀ τ_f) (Nat.add_zero q) := by
            dsimp only [z]
            rw [← Abelian.Ext.mk₀_comp_mk₀,
              Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q)]
      _ = 0 := by rw [hz_zero, Abelian.Ext.zero_comp]
  have hw_post : w = (Abelian.Ext.mk₀ ι_X).postcomp (C₂.obj Aℤ) (Nat.add_zero q) w_c :=
    hw_c.symm
  rw [hw_post, ← map_nsmul, hδ_wc, map_zero]

theorem weil_etale_zero_dim_closed_bdry_excision_bijective (k : Type u) [Field k] [IsAlgClosed k]
    (S : AlgebraicGeometry.Scheme.{u})
    (p_S : S ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
    [AlgebraicGeometry.LocallyOfFiniteType p_S]
    (V : S.Opens)
    (hFin : ((V : Set S)ᶜ).Finite)
    (hCl : ∀ y ∈ ((V : Set S)ᶜ), IsClosed ({y} : Set S))
    (n q : ℕ) (hq : 2 ≤ q)
    (K : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
    (ι : K ⟶ weilEtaleTorsionSheaf S n)
    (hEx : WeilAltIsZeroBdryExact S V n K ι) :
    Function.Bijective
      ((CategoryTheory.Abelian.Ext.mk₀ ι).postcomp
        ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)))
        (Nat.add_zero q)) :=
by
  classical
  
  let I_Z : S.IdealSheafData := weilAltClosedComplIdeal S V
  let Z : AlgebraicGeometry.Scheme.{u} := I_Z.subscheme
  let i_Z : Z ⟶ S := I_Z.subschemeι
  rcases hEx with ⟨hCont_ex, T_S_ex, hTS_ex, T_Z_ex, hTZ_ex, h0, hSE⟩
  letI : (weilEtaleSitePullback i_Z).IsContinuous S.smallEtaleTopology Z.smallEtaleTopology :=
    hCont_ex
  have hSiteAdj :
      ∃ (hRightAdj : (((weilEtaleSitePullback i_Z).sheafPushforwardContinuous
          AddCommGrpCat.{u} S.smallEtaleTopology Z.smallEtaleTopology)).IsRightAdjoint),
        letI := hRightAdj
        Limits.PreservesFiniteLimits
          (((weilEtaleSitePullback i_Z).sheafPullback
            AddCommGrpCat.{u} S.smallEtaleTopology Z.smallEtaleTopology)) := by
    have exists_affine_spec_point : ∀ (U : S.Etale)
        (y : ((Scheme.Etale.forget S).obj U).left),
        ∃ (R : CommRingCat.{u}) (f : Spec R ⟶ ((Scheme.Etale.forget S).obj U).left) (z₀ : Spec R),
          AlgebraicGeometry.Etale f ∧ f.base z₀ = y := by
      intro U y
      let X := ((Scheme.Etale.forget S).obj U).left
      obtain ⟨V_aff, hV_aff, hyV, -⟩ :=
        exists_isAffineOpen_mem_and_subset (TopologicalSpace.Opens.mem_top y)
      refine ⟨X.presheaf.obj (Opposite.op V_aff), hV_aff.fromSpec,
        hV_aff.primeIdealOf ⟨y, hyV⟩, inferInstance, ?_⟩
      exact hV_aff.fromSpec_primeIdealOf ⟨y, hyV⟩
    have exists_structuredOpEquiv : ∀ {D : Type u} [SmallCategory D]
        {E : Type (u + 1)} [Category.{u, u + 1} E] (F : D ⥤ E) (U : E),
        Nonempty ((StructuredArrow U F)ᵒᵖ ≌ CostructuredArrow F.op (Opposite.op U)) := by
      intro D _ E _ F U
      exact ⟨{
        functor :=
          { obj := fun X => CostructuredArrow.mk (Y := Opposite.op (Opposite.unop X).right)
              (Opposite.unop X).hom.op
            map := fun {X₁ X₂} f =>
              CostructuredArrow.homMk f.unop.right.op (by
                dsimp
                rw [← op_comp, StructuredArrow.w f.unop]) }
        inverse :=
          { obj := fun Y => Opposite.op (StructuredArrow.mk (Y := Opposite.unop Y.left) Y.hom.unop)
            map := fun {Y₁ Y₂} g =>
              (StructuredArrow.homMk g.left.unop (by
                dsimp
                exact Quiver.Hom.op_inj (CostructuredArrow.w g))).op }
        unitIso :=
          NatIso.ofComponents
            (fun X => Iso.op (StructuredArrow.isoMk (Iso.refl _) (by dsimp; simp)))
            (fun {X₁ X₂} f => Quiver.Hom.unop_inj (by ext; simp))
        counitIso :=
          NatIso.ofComponents
            (fun Y => CostructuredArrow.isoMk (Iso.refl _) (by dsimp; simp))
            (fun {Y₁ Y₂} g => by ext; simp)
        functor_unitIso_comp := fun X => by ext; simp }⟩
    have exists_lanEvalNatIso : ∀ {D : Type u} [SmallCategory D]
        {E : Type (u + 1)} [Category.{u, u + 1} E] (L : Dᵒᵖ ⥤ Eᵒᵖ) (Y : Eᵒᵖ),
        Nonempty (L.lan ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u}).obj Y ≅
          (Functor.whiskeringLeft (CostructuredArrow L Y) Dᵒᵖ AddCommGrpCat.{u}).obj
            (CostructuredArrow.proj L Y) ⋙ Limits.colim) := by
      intro D _ E _ L Y
      let isoP : ∀ P : Dᵒᵖ ⥤ AddCommGrpCat.{u},
          (L.lan ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u}).obj Y).obj P ≅
            ((Functor.whiskeringLeft (CostructuredArrow L Y) Dᵒᵖ AddCommGrpCat.{u}).obj
              (CostructuredArrow.proj L Y) ⋙ Limits.colim).obj P :=
        fun P => L.leftKanExtensionObjIsoColimit P Y
      exact ⟨NatIso.ofComponents isoP
        (fun {P₁ P₂} α => by
          apply (Iso.cancel_iso_inv_left (isoP P₁) _ _).mp
          rw [Iso.inv_hom_id_assoc]
          apply Limits.colimit.hom_ext
          intro j
          let f_lan : ∀ W : Eᵒᵖ, (L.leftKanExtension P₁).obj W ⟶ (L.leftKanExtension P₂).obj W :=
            fun W => (L.lan.map α).app W
          have hf_nat : ∀ {W₁ W₂ : Eᵒᵖ} (u : W₁ ⟶ W₂),
              (L.leftKanExtension P₁).map u ≫ f_lan W₂ = f_lan W₁ ≫ (L.leftKanExtension P₂).map u :=
            fun u => (L.lan.map α).naturality u
          have hunit : α.app j.left ≫ (L.leftKanExtensionUnit P₂).app j.left =
              (L.leftKanExtensionUnit P₁).app j.left ≫ f_lan (L.obj j.left) :=
            NatTrans.congr_app (L.lanUnit.naturality α) j.left
          change Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ P₁) j ≫
              ((L.leftKanExtensionObjIsoColimit P₁ Y).inv ≫
                (f_lan Y ≫ (L.leftKanExtensionObjIsoColimit P₂ Y).hom)) =
            Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ P₁) j ≫
              Limits.colim.map (Functor.whiskerLeft (CostructuredArrow.proj L Y) α)
          rw [Limits.colimit.ι_map, ← Category.assoc, L.ι_leftKanExtensionObjIsoColimit_inv P₁ Y j,
            Category.assoc ((L.leftKanExtensionUnit P₁).app j.left),
            ← Category.assoc ((L.leftKanExtension P₁).map j.hom), hf_nat j.hom,
            Category.assoc (f_lan (L.obj j.left)),
            ← Category.assoc ((L.leftKanExtensionUnit P₁).app j.left),
            ← hunit, Category.assoc (α.app j.left),
            L.leftKanExtensionUnit_leftKanExtension_map_leftKanExtensionObjIsoColimit_hom P₂ Y j]
          rfl)⟩
    have preservesFiniteLimits_lan_of_flat : ∀ {D : Type u} [SmallCategory D]
        {E : Type (u + 1)} [Category.{u, u + 1} E] (F₀ : D ⥤ E) [RepresentablyFlat F₀],
        Limits.PreservesFiniteLimits
          (F₀.op.lan : (Dᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ (Eᵒᵖ ⥤ AddCommGrpCat.{u})) := by
      intro D _ E _ F₀ _
      refine ⟨fun J _ _ => ?_⟩
      apply Limits.preservesLimitsOfShape_of_evaluation
      intro Y
      let U : E := Opposite.unop Y
      have hCof : IsCofiltered (StructuredArrow U F₀) := RepresentablyFlat.cofiltered U
      have hFil_op : IsFiltered (StructuredArrow U F₀)ᵒᵖ := isFiltered_op_of_isCofiltered _
      obtain ⟨e_arrow⟩ := exists_structuredOpEquiv F₀ U
      have hFil : IsFiltered (CostructuredArrow F₀.op Y) := IsFiltered.of_equivalence e_arrow
      have hColimLim : Limits.PreservesLimitsOfShape J
          (Limits.colim (J := CostructuredArrow F₀.op Y) (C := AddCommGrpCat.{u})) :=
        Limits.filtered_colim_preservesFiniteLimits
      have hComp : Limits.PreservesLimitsOfShape J
          ((Functor.whiskeringLeft (CostructuredArrow F₀.op Y) Dᵒᵖ AddCommGrpCat.{u}).obj
            (CostructuredArrow.proj F₀.op Y) ⋙ Limits.colim) :=
        Limits.comp_preservesLimitsOfShape _ _
      obtain ⟨iso_lan⟩ := exists_lanEvalNatIso F₀.op Y
      exact Limits.preservesLimitsOfShape_of_natIso iso_lan.symm
    let B := weilEtaleSitePullback i_Z
    let J₁ := Z.smallEtaleTopology
    let J₂ := S.smallEtaleTopology
    let Fgt₁ := Scheme.Etale.forget Z
    let Fgt₂ := Scheme.Etale.forget S
    haveI : Limits.PreservesLimits (CategoryTheory.Over.pullback i_Z) :=
      (CategoryTheory.Over.mapPullbackAdj i_Z).rightAdjoint_preservesLimits
    haveI : Limits.PreservesFiniteLimits (B ⋙ Fgt₁) := by
