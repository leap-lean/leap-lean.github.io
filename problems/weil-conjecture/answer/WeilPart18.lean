                have ha₁ : g₁.left a₁ = x₁ := (h_ch_spec U'₁ x₁ hx₁).2.1
                have hS₁ : IsSheetTuple W₁ σ₁ := (h_ch_spec U'₁ x₁ hx₁).2.2.2
