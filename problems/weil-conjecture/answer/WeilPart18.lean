        obtain ⟨V', hV', rfl⟩ := hv
        have h₁ : ((D₀ : Set ↥S) ∩ U').Nonempty := ⟨i₀.base y₁, hRange ▸ ⟨y₁, rfl⟩, hy₁⟩
        have h₂ : ((D₀ : Set ↥S) ∩ V').Nonempty := ⟨i₀.base y₂, hRange ▸ ⟨y₂, rfl⟩, hy₂⟩
        obtain ⟨w, hwD, hwU, hwV⟩ := hIrr.2 U' V' hU' hV' h₁ h₂
