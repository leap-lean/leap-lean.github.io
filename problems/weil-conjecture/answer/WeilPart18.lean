        rw [hC₀_pre, Set.mem_singleton_iff] at hz_sub
        exact congrArg Subtype.val hz_sub
      · intro hzx
        rw [hzx]
        have hx_sub : (⟨x, hx_mem⟩ : ↥W_y) ∈ (Subtype.val : ↥W_y → (C c).left) ⁻¹' C₀ := by
