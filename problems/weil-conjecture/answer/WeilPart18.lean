    let e_pull : B_h.sheafPullback AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology ≅ j_pull :=
      CategoryTheory.Adjunction.leftAdjointUniq
        (B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
          X₂.smallEtaleTopology X₁.smallEtaleTopology)
        adj_sh
    haveI : CategoryTheory.Limits.PreservesColimitsOfSize.{0, 0} j_pull :=
      adj_sh.leftAdjoint_preservesColimits
    haveI hColim : CategoryTheory.Limits.PreservesFiniteColimits j_pull := inferInstance
    haveI hAdd : j_pull.Additive :=
      { map_add := fun {_ _ _ _} =>
          (CategoryTheory.fullyFaithfulSheafToPresheaf X₁.smallEtaleTopology
            AddCommGrpCat.{u}).map_injective (NatTrans.ext (funext fun _ => rfl)) }
    haveI hCompLim : CategoryTheory.Limits.PreservesFiniteLimits
        (j_pull ⋙ CategoryTheory.sheafToPresheaf X₁.smallEtaleTopology AddCommGrpCat.{u}) := by
      change CategoryTheory.Limits.PreservesFiniteLimits
        (CategoryTheory.sheafToPresheaf X₂.smallEtaleTopology AddCommGrpCat.{u} ⋙
          (CategoryTheory.Functor.whiskeringLeft _ _ AddCommGrpCat.{u}).obj Φ_h.op)
      infer_instance
    haveI hLim : CategoryTheory.Limits.PreservesFiniteLimits j_pull :=
      CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves
        j_pull (CategoryTheory.sheafToPresheaf X₁.smallEtaleTopology AddCommGrpCat.{u})
    refine ⟨hLim, hColim, hAdd, ?_, ?_⟩
    · intro G F
      constructor
      · rintro ⟨_, _, ⟨e⟩⟩
        exact ⟨(e_pull.app G).symm ≪≫ e⟩
      · rintro ⟨e⟩
        exact ⟨‹_›, ‹_›, ⟨e_pull.app G ≪≫ e⟩⟩
    · intro A
      let C₁ := CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}
      let T₁ := mkTermEt X₁
      let T₂ := mkTermEt X₂
      let hT₁ := isTermEt X₁
      let hT₂ := isTermEt X₂
      let adj₁ := CategoryTheory.constantSheafAdj X₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj X₂.smallEtaleTopology AddCommGrpCat.{u} hT₂
      let u₁₂ : Φ_h.obj T₁ ⟶ T₂ := hT₂.from (Φ_h.obj T₁)
      let v₂₁ : B_h.obj T₂ ⟶ T₁ := hT₁.from (B_h.obj T₂)
      let θ : C₁.obj A ⟶ j_pull.obj (C₂.obj A) :=
        (adj₁.homEquiv A (j_pull.obj (C₂.obj A))).symm
