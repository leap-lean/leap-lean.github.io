    fun Y T_Y =>
      { obj := fun D =>
          { obj := fun W => AddCommGrpCat.of ((T_Y ⟶ W.unop) → ↥D)
            map := fun {W₁ W₂} g =>
              AddCommGrpCat.ofHom
                { toFun := fun φ τ => φ (τ ≫ g.unop)
                  map_zero' := rfl
                  map_add' := fun _ _ => rfl }
            map_id := fun W => by
              ext φ τ
              change φ (τ ≫ 𝟙 W.unop) = φ τ
              rw [CategoryTheory.Category.comp_id]
            map_comp := fun f g => by
              ext φ τ
              change φ (τ ≫ (g.unop ≫ f.unop)) = φ ((τ ≫ g.unop) ≫ f.unop)
              rw [CategoryTheory.Category.assoc] }
        map := fun {D₁ D₂} d =>
          { app := fun W =>
              AddCommGrpCat.ofHom
