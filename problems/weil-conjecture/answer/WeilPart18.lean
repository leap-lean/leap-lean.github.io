    have hw_eq : Φ.toPresheafFiber X₀ x₀ ℱ.obj =
        ℱ.obj.map π₁.1.op ≫ Φ.toPresheafFiber Z.1 Z.2 ℱ.obj := by
      have hw := Φ.toPresheafFiber_w π₁.1 Z.2 ℱ.obj
      have hx : Φ.fiber.map π₁.1 Z.2 = x₀ := π₁.2
      rw [hx] at hw
      exact hw.symm
    change Φ.toPresheafFiber X₀ x₀ ℱ.obj ≫ 𝟙 (Φ.presheafFiber.obj ℱ.obj) =
      Φ.toPresheafFiber X₀ x₀ ℱ.obj ≫ 0
    rw [hw_eq, hZ0, CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.zero_comp,
