  letI : Algebra E L_gal := instAlgELgal
  haveI : IsScalarTower K E L_gal := instTowerKELgal
  haveI : FiniteDimensional K E := hFD_KE
  haveI : Algebra.IsSeparable K E := hSep_KE
  haveI : IsGalois E L_gal := hGal_ELgal
  let S_idx : Type u := (E →ₐ[K] L_gal)
  letI : Fintype S_idx := instFinSidx
  let H : Type u := (L_gal ≃ₐ[E] L_gal)

  
  
  
  let g_Y₀ : Y₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) := iY₀ ≫ X.hom
  haveI : AlgebraicGeometry.LocallyOfFiniteType g_Y₀ := by
    dsimp [g_Y₀]; infer_instance
  haveI : AlgebraicGeometry.IsSeparated g_Y₀ := by
    dsimp [g_Y₀]; infer_instance
  let φ_kR₀ : k →+* R₀ :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
      g_Y₀.appLE ⊤ U_aff le_top).hom
  letI : Algebra k R₀ := φ_kR₀.toAlgebra
  haveI : Algebra.FiniteType k R₀ := by
    rw [← RingHom.finiteType_algebraMap]
    have h_comp : φ_kR₀ = (g_Y₀.appLE ⊤ U_aff le_top).hom.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom :=
      CommRingCat.hom_comp _ _
    change φ_kR₀.FiniteType
    rw [h_comp]
    exact RingHom.FiniteType.comp
      (g_Y₀.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top _) hU_aff le_top)
      (RingHom.FiniteType.of_surjective _
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv.surjective)
  haveI : IsNoetherianRing R₀ := Algebra.FiniteType.isNoetherianRing k R₀

  let C₀ := ↥(integralClosure R₀ K)
  obtain ⟨hFin_C₀, hIC_C₀⟩ := hFinIntClosure R₀ K
  haveI : Module.Finite R₀ C₀ := hFin_C₀
  haveI : IsIntegrallyClosed C₀ := hIC_C₀
  haveI : IsNoetherianRing C₀ :=
    Algebra.FiniteType.isNoetherianRing R₀ C₀
  haveI : IsFractionRing C₀ K :=
    IsIntegralClosure.isFractionRing_of_finite_extension R₀ K K C₀

  letI : Algebra R₀ E := ((algebraMap K E).comp (algebraMap R₀ K)).toAlgebra
  letI : Algebra R₀ L_gal := ((algebraMap K L_gal).comp (algebraMap R₀ K)).toAlgebra
  haveI : IsScalarTower R₀ K E := IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower R₀ K L_gal := IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower R₀ E L_gal := IsScalarTower.of_algebraMap_eq (fun r => by
    change algebraMap K L_gal (algebraMap R₀ K r) =
      algebraMap E L_gal (algebraMap K E (algebraMap R₀ K r))
    rw [← IsScalarTower.algebraMap_apply K E L_gal])

  have hFinSepClosure : ∀ (F : Type u) [Field F] [Algebra R₀ F] [Algebra K F]
      [IsScalarTower R₀ K F] [FiniteDimensional K F] [Algebra.IsSeparable K F],
      Module.Finite R₀ ↥(integralClosure R₀ F) ∧
      ∃ a_F : R₀, a_F ≠ 0 ∧
        Algebra.Etale R₀ (Localization.Away (algebraMap R₀ ↥(integralClosure R₀ F) a_F)) := by
    intro F _ _ _ _ _ _
    haveI : IsScalarTower R₀ C₀ F :=
      ⟨fun r c x => by
        change (r • c : C₀).1 • x = r • (c.1 • x)
        rw [Subalgebra.coe_smul, smul_assoc]⟩
    haveI : Module.Finite C₀ ↥(integralClosure C₀ F) :=
      IsIntegralClosure.finite C₀ K F ↥(integralClosure C₀ F)
    have h_mem_eq : ∀ x : F, x ∈ integralClosure C₀ F ↔ x ∈ integralClosure R₀ F :=
      fun x => ⟨fun hx => isIntegral_trans x hx, fun hx => _root_.IsIntegral.tower_top hx⟩
    let e_C₀R₀ : ↥(integralClosure C₀ F) ≃ₗ[R₀] ↥(integralClosure R₀ F) :=
      { toFun := fun z => ⟨z.1, (h_mem_eq z.1).mp z.2⟩
        invFun := fun z => ⟨z.1, (h_mem_eq z.1).mpr z.2⟩
        left_inv := fun _ => Subtype.ext rfl
        right_inv := fun _ => Subtype.ext rfl
        map_add' := fun _ _ => Subtype.ext rfl
        map_smul' := fun r z => Subtype.ext (by
          change (r • z : ↥(integralClosure C₀ F)).1 = (r • (⟨z.1, _⟩ : ↥(integralClosure R₀ F))).1
          rw [Subalgebra.coe_smul, Subalgebra.coe_smul]) }
    haveI : Module.Finite C₀ ↥(integralClosure C₀ F) := inferInstance
    have hFin_C0_R0 : Module.Finite R₀ ↥(integralClosure C₀ F) :=
      Module.Finite.trans C₀ ↥(integralClosure C₀ F)
    let C_F := ↥(integralClosure R₀ F)
    haveI hFin_CF : Module.Finite R₀ C_F := Module.Finite.equiv e_C₀R₀
    refine ⟨hFin_CF, ?_⟩
    haveI : Algebra.FiniteType R₀ C_F := (Algebra.finite_iff_isIntegral_and_finiteType.mp hFin_CF).2
    haveI : Algebra.FinitePresentation R₀ C_F :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance
    have hInj_CF : Function.Injective (algebraMap C_F F) := Subtype.val_injective
    haveI : IsDomain C_F := Function.Injective.isDomain (algebraMap C_F F) hInj_CF
    haveI : Algebra.FormallyEtale R₀ K :=
      Algebra.FormallyEtale.of_isLocalization (nonZeroDivisors R₀)
    haveI : Algebra.FormallyEtale K F := Algebra.FormallyEtale.of_isSeparable K F
    have hFE_RF : Algebra.FormallyEtale R₀ F := Algebra.FormallyEtale.comp R₀ K F
    haveI : Algebra.IsAlgebraic K F := Algebra.IsAlgebraic.of_finite K F
    have hLoc_CF : IsLocalization (⊥ : Ideal C_F).primeCompl F :=
      ⟨⟨fun ⟨c, hc⟩ => by
          rw [Ideal.mem_primeCompl_iff, Ideal.mem_bot] at hc
          exact isUnit_iff_ne_zero.mpr (fun h0 => hc (hInj_CF (h0.trans (map_zero _).symm))),
        fun y => by
          have hLocA : IsLocalization (Algebra.algebraMapSubmonoid C_F (nonZeroDivisors R₀)) F :=
            IsIntegralClosure.isLocalization R₀ K F C_F
          obtain ⟨⟨c, ⟨_, ⟨s_a, hs_mem, rfl⟩⟩⟩, hy⟩ :=
            @IsLocalization.surj _ _ (Algebra.algebraMapSubmonoid C_F (nonZeroDivisors R₀)) F _ _ hLocA y
          have hs_ne : (algebraMap R₀ C_F s_a) ≠ 0 := by
            intro h0
            have h_inj_RC : Function.Injective (algebraMap R₀ C_F) := by
              intro a₁ a₂ heq
              apply IsFractionRing.injective R₀ K
              apply (algebraMap K F).injective
              rw [← IsScalarTower.algebraMap_apply R₀ K F, ← IsScalarTower.algebraMap_apply R₀ K F]
              exact congrArg Subtype.val heq
            exact mem_nonZeroDivisors_iff_ne_zero.mp hs_mem (h_inj_RC (h0.trans (map_zero _).symm))
          exact ⟨⟨c, ⟨algebraMap R₀ C_F s_a, by rwa [Ideal.mem_primeCompl_iff, Ideal.mem_bot]⟩⟩, hy⟩,
        fun {c₁ c₂} h_eq => ⟨1, by simpa using hInj_CF h_eq⟩⟩⟩
    let e_atBot : Localization.AtPrime (⊥ : Ideal C_F) ≃ₐ[C_F] F :=
      @IsLocalization.algEquiv C_F _ (⊥ : Ideal C_F).primeCompl
        (Localization.AtPrime (⊥ : Ideal C_F)) _ _ _ F _ _ hLoc_CF
    let e_atBot_R₀ : Localization.AtPrime (⊥ : Ideal C_F) ≃ₐ[R₀] F :=
      e_atBot.restrictScalars R₀
    haveI : Algebra.IsEtaleAt R₀ (⊥ : Ideal C_F) :=
      @Algebra.FormallyEtale.of_equiv R₀ F (Localization.AtPrime (⊥ : Ideal C_F))
        _ _ _ _ _ hFE_RF e_atBot_R₀.symm
    obtain ⟨g_F, hg_not_bot, hEt_g⟩ := Algebra.exists_etale_of_isEtaleAt (R := R₀) (⊥ : Ideal C_F)
    have hg_ne : g_F ≠ 0 := by rwa [Ideal.mem_bot] at hg_not_bot
    obtain ⟨q₀, hq₀_monic, hq₀_eval⟩ := integralClosure.isIntegral g_F
    have h_div_aux : ∀ (d : ℕ) (q : Polynomial R₀),
        q.natDegree ≤ d → q ≠ 0 → Polynomial.aeval g_F q = 0 →
        ∃ a₀ : R₀, a₀ ≠ 0 ∧ g_F ∣ algebraMap R₀ C_F a₀ := by
      intro d
      induction d with
      | zero =>
        intro q hdeg hq_ne hq_ev
        have hd0 : q.natDegree = 0 := Nat.eq_zero_of_le_zero hdeg
        rw [Polynomial.eq_C_of_natDegree_eq_zero hd0] at hq_ne hq_ev
        refine ⟨q.coeff 0, fun h0 => hq_ne (by rw [h0, map_zero]), 0, ?_⟩
        rw [mul_zero]
        simpa using hq_ev
      | succ d ih =>
        intro q hdeg hq_ne hq_ev
        by_cases hc0 : q.coeff 0 = 0
        · have hq_fac : Polynomial.X * q.divX = q := by
            simpa [hc0] using Polynomial.X_mul_divX_add q
          have hdiv_ne : q.divX ≠ 0 := fun h0 => hq_ne (by rw [← hq_fac, h0, mul_zero])
          have h_ev_div : Polynomial.aeval g_F q.divX = 0 := by
            have h_mul : g_F * Polynomial.aeval g_F q.divX = 0 := by
              calc g_F * Polynomial.aeval g_F q.divX
                _ = Polynomial.aeval g_F (Polynomial.X * q.divX) := by simp
                _ = Polynomial.aeval g_F q := by rw [hq_fac]
                _ = 0 := hq_ev
            exact (mul_eq_zero.mp h_mul).resolve_left hg_ne
          have hdeg_pos : 0 < q.natDegree := by
            by_contra hle
            have hd0 : q.natDegree = 0 := Nat.eq_zero_of_not_pos hle
            exact hq_ne (by rw [Polynomial.eq_C_of_natDegree_eq_zero hd0, hc0, map_zero])
          have hdeg_div : q.divX.natDegree ≤ d := by
            rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one]; omega
          exact ih q.divX hdeg_div hdiv_ne h_ev_div
        · refine ⟨q.coeff 0, hc0, -(Polynomial.aeval g_F q.divX), ?_⟩
          have h_sum : g_F * Polynomial.aeval g_F q.divX + algebraMap R₀ C_F (q.coeff 0) = 0 := by
            have h_ev2 := congrArg (Polynomial.aeval g_F) (Polynomial.X_mul_divX_add q).symm
            rw [hq_ev, map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at h_ev2
            exact h_ev2.symm
          linear_combination h_sum
    obtain ⟨a_F, ha_F_ne, c_mul, hc_mul⟩ :=
      h_div_aux q₀.natDegree q₀ le_rfl hq₀_monic.ne_zero hq₀_eval
    have hSub_g : (PrimeSpectrum.basicOpen g_F : Set (PrimeSpectrum C_F)) ⊆ Algebra.etaleLocus R₀ C_F :=
      Algebra.basicOpen_subset_etaleLocus_iff_etale.mpr hEt_g
    have hSub_a : (PrimeSpectrum.basicOpen (algebraMap R₀ C_F a_F) : Set (PrimeSpectrum C_F)) ⊆
        Algebra.etaleLocus R₀ C_F := by
      intro p_c hp
      apply hSub_g
      change g_F ∉ p_c.asIdeal
      intro hgp
      exact hp (hc_mul ▸ p_c.asIdeal.mul_mem_right c_mul hgp)
    exact ⟨a_F, ha_F_ne, Algebra.basicOpen_subset_etaleLocus_iff_etale.mp hSub_a⟩

  let C' := ↥(integralClosure R₀ E)
  let C'' := ↥(integralClosure R₀ L_gal)
  obtain ⟨hFin_C', a_E, ha_E_ne, hEt_aE⟩ := hFinSepClosure E
  obtain ⟨hFin_C'', a_L, ha_L_ne, hEt_aL⟩ := hFinSepClosure L_gal
  haveI : Module.Finite R₀ C' := hFin_C'
  haveI : Module.Finite R₀ C'' := hFin_C''

  
  obtain ⟨s_C₀, hs_C₀⟩ := hFin_C₀.fg_top
  obtain ⟨d_cond_sub, hd_cond_int⟩ :=
    IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors R₀) (s_C₀.image Subtype.val)
  let δ_cond : R₀ := d_cond_sub.1
  have hδ_cond_ne : δ_cond ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp d_cond_sub.2
  have h_cond_clear : ∀ c : C₀, ∃ r : R₀, δ_cond • c = algebraMap R₀ C₀ r := by
    let M_cond : Submodule R₀ C₀ :=
      { carrier := {c : C₀ | ∃ r : R₀, δ_cond • c = algebraMap R₀ C₀ r}
        zero_mem' := ⟨0, by simp⟩
        add_mem' := by rintro c₁ c₂ ⟨r₁, hr₁⟩ ⟨r₂, hr₂⟩; exact ⟨r₁ + r₂, by rw [smul_add, hr₁, hr₂, map_add]⟩
        smul_mem' := by
          rintro a c ⟨r, hr⟩
          exact ⟨a * r, by rw [smul_comm δ_cond a c, hr, map_mul, Algebra.smul_def]⟩ }
    have hs_sub : (s_C₀ : Set C₀) ⊆ (M_cond : Set C₀) := by
      intro w hw
      obtain ⟨r_w, hr_w⟩ := hd_cond_int w.1 (Finset.mem_image_of_mem Subtype.val hw)
      refine ⟨r_w, Subtype.ext ?_⟩
      change (δ_cond • w.1) = algebraMap R₀ K r_w
      exact hr_w.symm
    have hM_top : M_cond = ⊤ := top_unique (hs_C₀ ▸ Submodule.span_le.mpr hs_sub)
    intro c
    have hc_mem : c ∈ M_cond := by rw [hM_top]; exact Submodule.mem_top
    exact hc_mem

  
  obtain ⟨α₀, hα₀_top⟩ := Field.exists_primitive_element K L_gal
  haveI : Algebra.IsAlgebraic K L_gal := Algebra.IsAlgebraic.of_finite K L_gal
  have hLoc_C'' : IsLocalization (Algebra.algebraMapSubmonoid C'' (nonZeroDivisors R₀)) L_gal :=
    IsIntegralClosure.isLocalization R₀ K L_gal C''
  obtain ⟨⟨α, ⟨_, ⟨s_α, hs_α_mem, rfl⟩⟩⟩, hα_eq⟩ :=
    @IsLocalization.surj _ _ (Algebra.algebraMapSubmonoid C'' (nonZeroDivisors R₀)) L_gal _ _ hLoc_C'' α₀
  have hs_α_ne : s_α ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hs_α_mem
  have hs_α_K_ne : algebraMap R₀ K s_α ≠ 0 :=
    fun h0 => hs_α_ne ((IsFractionRing.injective R₀ K) (h0.trans (map_zero _).symm))
  have hα_prim_int : IntermediateField.adjoin K ({α.1} : Set L_gal) = ⊤ := by
    apply top_unique
    rw [← hα₀_top, IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
    have h_mul : α₀ * algebraMap K L_gal (algebraMap R₀ K s_α) = α.1 := by
      have h1 : α₀ * algebraMap R₀ L_gal s_α = α.1 := hα_eq
      rwa [IsScalarTower.algebraMap_apply R₀ K L_gal] at h1
    have hs_L_ne : algebraMap K L_gal (algebraMap R₀ K s_α) ≠ 0 :=
      fun h0 => hs_α_K_ne ((algebraMap K L_gal).injective (h0.trans (map_zero _).symm))
    have hα₀_val : α₀ = (algebraMap R₀ K s_α)⁻¹ • α.1 := by
      rw [Algebra.smul_def, map_inv₀, ← h_mul, mul_comm α₀ _, inv_mul_cancel_left₀ hs_L_ne]
    rw [hα₀_val]
    exact Subalgebra.smul_mem (IntermediateField.adjoin K ({α.1} : Set L_gal)).toSubalgebra
      (IntermediateField.mem_adjoin_simple_self K α.1) _
  have hα_alg_top : Algebra.adjoin K ({α.1} : Set L_gal) = ⊤ := by
    rw [← IntermediateField.adjoin_toSubalgebra, hα_prim_int]
    rfl
  obtain ⟨s_C'', hs_C''⟩ := hFin_C''.fg_top
  have h_gen_den : ∀ w : C'', ∃ d_w : R₀, d_w ≠ 0 ∧ d_w • w ∈ Algebra.adjoin R₀ ({α} : Set C'') := by
    intro w
    have hw_range : w.1 ∈ (Polynomial.aeval α.1 : Polynomial K →ₐ[K] L_gal).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval, hα_alg_top]
      trivial
    obtain ⟨Q_w, hQ_w⟩ := hw_range
    have hQ_w' : Polynomial.aeval α.1 Q_w = w.1 := hQ_w
    obtain ⟨d_sub, hd_int⟩ := IsLocalization.exist_integer_multiples_of_finite (nonZeroDivisors R₀)
      (fun i : Fin (Q_w.natDegree + 1) => Q_w.coeff i.1)
    choose r_coeff hr_coeff using hd_int
    refine ⟨d_sub.1, mem_nonZeroDivisors_iff_ne_zero.mp d_sub.2, ?_⟩
    have h_eq_sum : d_sub.1 • w = ∑ i : Fin (Q_w.natDegree + 1), r_coeff i • (α ^ i.1) := by
      apply Subtype.ext
      change d_sub.1 • w.1 = (∑ i : Fin (Q_w.natDegree + 1), r_coeff i • (α ^ i.1)).1
      rw [Algebra.smul_def, ← hQ_w', Polynomial.aeval_def, Polynomial.eval₂_eq_sum_range,
        ← Fin.sum_univ_eq_sum_range, Finset.mul_sum, AddSubmonoidClass.coe_finset_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      change algebraMap R₀ L_gal d_sub.1 * (algebraMap K L_gal (Q_w.coeff i.1) * α.1 ^ i.1) =
        (r_coeff i • (α ^ i.1)).1
      have h_rc : algebraMap R₀ K (r_coeff i) = d_sub.1 • Q_w.coeff i.1 := hr_coeff i
      rw [Subalgebra.coe_smul, SubmonoidClass.coe_pow, Algebra.smul_def,
        IsScalarTower.algebraMap_apply R₀ K L_gal (r_coeff i), h_rc,
        Algebra.smul_def, map_mul, mul_assoc, ← IsScalarTower.algebraMap_apply R₀ K L_gal]
    rw [h_eq_sum]
    refine Subalgebra.sum_mem _ (fun i _ => Subalgebra.smul_mem _ ?_ _)
    exact pow_mem (Algebra.subset_adjoin (Set.mem_singleton α)) i.1
  choose d_gen_fn hd_gen_ne hd_gen_mem using h_gen_den
  let δ_gen : R₀ := ∏ w ∈ s_C'', d_gen_fn w
  have hδ_gen_ne : δ_gen ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun w _ => hd_gen_ne w)
  have h_gen_clear : ∀ c : C'', δ_gen • c ∈ Algebra.adjoin R₀ ({α} : Set C'') := by
    let M_gen : Submodule R₀ C'' :=
      { carrier := {c : C'' | δ_gen • c ∈ Algebra.adjoin R₀ ({α} : Set C'')}
        zero_mem' := by simp
        add_mem' := fun {x y} hx hy => by
          show δ_gen • (x + y) ∈ Algebra.adjoin R₀ ({α} : Set C'')
          rw [smul_add]; exact add_mem hx hy
        smul_mem' := fun r {x} hx => by
          show δ_gen • (r • x) ∈ Algebra.adjoin R₀ ({α} : Set C'')
          rw [smul_comm δ_gen r x]
          exact Subalgebra.smul_mem _ hx r }
    have hs_sub : (s_C'' : Set C'') ⊆ (M_gen : Set C'') := by
      intro w hw
      obtain ⟨q_w, hq_w⟩ := Finset.dvd_prod_of_mem d_gen_fn hw
      change (∏ i ∈ s_C'', d_gen_fn i) • w ∈ Algebra.adjoin R₀ ({α} : Set C'')
      rw [hq_w, mul_comm (d_gen_fn w) q_w, mul_smul]
      exact Subalgebra.smul_mem _ (hd_gen_mem w) q_w
    have hM_top : M_gen = ⊤ := top_unique (hs_C'' ▸ Submodule.span_le.mpr hs_sub)
    intro c
    have hc_mem : c ∈ M_gen := by rw [hM_top]; exact Submodule.mem_top
    exact hc_mem

  let f : R₀ := δ_cond * a_E * a_L * δ_gen
  have hf_ne : f ≠ 0 :=
    mul_ne_zero (mul_ne_zero (mul_ne_zero hδ_cond_ne ha_E_ne) ha_L_ne) hδ_gen_ne

  
  let U₂ : Y₀.Opens := Y₀.basicOpen f
  have hU₂_aff : AlgebraicGeometry.IsAffineOpen U₂ := hU_aff.basicOpen f
  have hU₂_ne_bot : U₂ ≠ ⊥ := (AlgebraicGeometry.basicOpen_eq_bot_iff f).not.mpr hf_ne
  obtain ⟨y₂, hy₂⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U₂).mp hU₂_ne_bot
  haveI hU₂_ne : Nonempty U₂ := ⟨⟨y₂, hy₂⟩⟩
  let R₂_obj := Y₀.presheaf.obj (Opposite.op U₂)
  let R₂ : Type u := ↑R₂_obj
  haveI : IsDomain R₂ := inferInstanceAs (IsDomain ↑(Y₀.presheaf.obj (Opposite.op U₂)))
  haveI : IsFractionRing R₂ K :=
    AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Y₀ U₂ hU₂_aff
  letI : Algebra R₀ R₂ := (Y₀.presheaf.map (homOfLE (Y₀.basicOpen_le f)).op).hom.toAlgebra
  haveI : IsLocalization.Away f R₂ := hU_aff.isLocalization_basicOpen f
  haveI : IsScalarTower R₀ R₂ K := by
    refine IsScalarTower.of_algebraMap_eq (fun r => ?_)
    have hη_U₂ : genericPoint ↥Y₀ ∈ U₂ :=
      (genericPoint_specializes y₂).mem_open U₂.isOpen hy₂
    have hη_Uaff : genericPoint ↥Y₀ ∈ U_aff := Y₀.basicOpen_le f hη_U₂
    have h_res := Y₀.presheaf.germ_res (homOfLE (Y₀.basicOpen_le f)) (genericPoint ↥Y₀) hη_U₂
    exact (ConcreteCategory.congr_hom h_res r).symm
  letI : Algebra R₂ E := ((algebraMap K E).comp (algebraMap R₂ K)).toAlgebra
  letI : Algebra R₂ L_gal := ((algebraMap K L_gal).comp (algebraMap R₂ K)).toAlgebra
  haveI : IsScalarTower R₂ K E := IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower R₂ K L_gal := IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower R₂ E L_gal := IsScalarTower.of_algebraMap_eq (fun r => by
    change algebraMap K L_gal (algebraMap R₂ K r) =
      algebraMap E L_gal (algebraMap K E (algebraMap R₂ K r))
    rw [← IsScalarTower.algebraMap_apply K E L_gal])
  haveI : IsScalarTower R₀ R₂ E := IsScalarTower.of_algebraMap_eq (fun r => by
    change algebraMap K E (algebraMap R₀ K r) = algebraMap K E (algebraMap R₂ K (algebraMap R₀ R₂ r))
    rw [← IsScalarTower.algebraMap_apply R₀ R₂ K])
  haveI : IsScalarTower R₀ R₂ L_gal := IsScalarTower.of_algebraMap_eq (fun r => by
    change algebraMap K L_gal (algebraMap R₀ K r) =
      algebraMap K L_gal (algebraMap R₂ K (algebraMap R₀ R₂ r))
    rw [← IsScalarTower.algebraMap_apply R₀ R₂ K])

  have hUnit_div_f : ∀ d : R₀, d ∣ f → IsUnit (algebraMap R₀ R₂ d) := by
    rintro d ⟨q, hq⟩
    obtain ⟨u_f, hu_f⟩ := IsLocalization.Away.algebraMap_isUnit (S := R₂) f
    refine ⟨⟨algebraMap R₀ R₂ d, algebraMap R₀ R₂ q * ↑u_f⁻¹, ?_, ?_⟩, rfl⟩
    · rw [← mul_assoc, ← map_mul, ← hq, ← hu_f, Units.mul_inv]
    · rw [mul_comm, ← mul_assoc, ← map_mul, ← hq, ← hu_f, Units.mul_inv]

  
  let ι_int : ∀ (F : Type u) [Field F] [Algebra R₀ F] [Algebra R₂ F] [IsScalarTower R₀ R₂ F],
      ↥(integralClosure R₀ F) →+* ↥(integralClosure R₂ F) :=
    fun F _ _ _ _ =>
      { toFun := fun c => ⟨c.1, _root_.IsIntegral.tower_top (R := R₀) (A := R₂) c.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
  have hLocIntClosure : ∀ (F : Type u) [Field F] [Algebra R₀ F] [Algebra R₂ F]
      [IsScalarTower R₀ R₂ F],
      @IsLocalization.Away ↥(integralClosure R₀ F) _
        (algebraMap R₀ ↥(integralClosure R₀ F) f) ↥(integralClosure R₂ F) _
        (ι_int F).toAlgebra := by
    intro F _ _ _ _
    let C_F := ↥(integralClosure R₀ F)
    let R_F := ↥(integralClosure R₂ F)
    letI : Algebra C_F R_F := (ι_int F).toAlgebra
    refine ⟨⟨?_, ?_, ?_⟩⟩
    · rintro ⟨_, ⟨n, rfl⟩⟩
      change IsUnit ((ι_int F) ((algebraMap R₀ C_F f) ^ n))
      rw [map_pow]
      refine IsUnit.pow n ?_
      have h_eq : (ι_int F) (algebraMap R₀ C_F f) = algebraMap R₂ R_F (algebraMap R₀ R₂ f) :=
        Subtype.ext (IsScalarTower.algebraMap_apply R₀ R₂ F f)
      rw [h_eq]
      exact (IsLocalization.Away.algebraMap_isUnit (S := R₂) f).map (algebraMap R₂ R_F)
    · intro y
      obtain ⟨⟨m, n, hn⟩, hm_int⟩ :=
        IsIntegral.exists_multiple_integral_of_isLocalization (Submonoid.powers f) y.1 y.2
      subst hn
      refine ⟨⟨⟨(f ^ n) • y.1, hm_int⟩, ⟨(algebraMap R₀ C_F f) ^ n, n, rfl⟩⟩, Subtype.ext ?_⟩
      change y.1 * ((algebraMap R₀ F f) ^ n) = (f ^ n) • y.1
      rw [Algebra.smul_def, map_pow, mul_comm]
    · intro c₁ c₂ h_eq
      have h_val : c₁.1 = c₂.1 := congrArg (Subtype.val : R_F → F) h_eq
      have hc_eq : c₁ = c₂ := Subtype.ext h_val
      exact ⟨1, by rw [hc_eq]⟩

  have : IsIntegrallyClosed R₂ :=
    (isIntegrallyClosed_iff K).mpr fun {x} hx => by
      obtain ⟨⟨m, n, hn⟩, hm_int⟩ :=
        IsIntegral.exists_multiple_integral_of_isLocalization (Submonoid.powers f) x hx
      subst hn
      obtain ⟨r, hr⟩ := h_cond_clear ⟨(f ^ n) • x, hm_int⟩
      have hd_unit : IsUnit (algebraMap R₀ R₂ (δ_cond * f ^ n)) := by
        rw [map_mul, map_pow]
        exact IsUnit.mul
          (hUnit_div_f δ_cond ⟨a_E * a_L * δ_gen, by dsimp [f]; ring⟩)
          ((IsLocalization.Away.algebraMap_isUnit (S := R₂) f).pow n)
      obtain ⟨u_d, hu_d⟩ := hd_unit
      refine ⟨algebraMap R₀ R₂ r * ↑u_d⁻¹, ?_⟩
      have hr' : algebraMap R₂ K (algebraMap R₀ R₂ (δ_cond * f ^ n)) * x =
          algebraMap R₂ K (algebraMap R₀ R₂ r) := by
        have h1 : (δ_cond • (⟨(f ^ n) • x, hm_int⟩ : C₀)).1 = (algebraMap R₀ C₀ r).1 :=
          congrArg Subtype.val hr
        change algebraMap R₀ K δ_cond * (algebraMap R₀ K (f ^ n) * x) = algebraMap R₀ K r at h1
        rw [← mul_assoc, ← map_mul, IsScalarTower.algebraMap_apply R₀ R₂ K,
          IsScalarTower.algebraMap_apply R₀ R₂ K] at h1
        exact h1
      rw [map_mul, ← hr', ← hu_d]
      have hu_K : algebraMap R₂ K ↑u_d * algebraMap R₂ K ↑u_d⁻¹ = 1 := by
        rw [← map_mul, Units.mul_inv, map_one]
      calc (algebraMap R₂ K ↑u_d * x) * algebraMap R₂ K ↑u_d⁻¹
        _ = x * (algebraMap R₂ K ↑u_d * algebraMap R₂ K ↑u_d⁻¹) := by ring
        _ = x := by rw [hu_K, mul_one]

  let R' := ↥(integralClosure R₂ E)
  let R'' := ↥(integralClosure R₂ L_gal)
  haveI : IsDomain R' := Function.Injective.isDomain (algebraMap R' E) Subtype.val_injective
  haveI : IsDomain R'' := Function.Injective.isDomain (algebraMap R'' L_gal) Subtype.val_injective
  haveI : IsIntegrallyClosed R' := integralClosure.isIntegrallyClosedOfFiniteExtension K
  haveI : IsFractionRing R' E :=
    IsIntegralClosure.isFractionRing_of_finite_extension R₂ K E R'

  have hEtFinAway : ∀ (F : Type u) [Field F] [Algebra R₀ F] [Algebra R₂ F]
      [IsScalarTower R₀ R₂ F] [Module.Finite R₀ ↥(integralClosure R₀ F)]
      (a_F : R₀) (_ : a_F ∣ f)
      (_ : Algebra.Etale R₀ (Localization.Away (algebraMap R₀ ↥(integralClosure R₀ F) a_F))),
      Module.Finite R₂ ↥(integralClosure R₂ F) ∧
      Algebra.Etale R₀ ↥(integralClosure R₂ F) ∧
      Algebra.Etale R₂ ↥(integralClosure R₂ F) := by
    intro F _ _ _ _ hFin0 a_F ha_dvd hEt_aF
    let C_F := ↥(integralClosure R₀ F)
    let R_F := ↥(integralClosure R₂ F)
    let ι_CF : C_F →+* R_F := ι_int F
    have hLoc_RF : @IsLocalization.Away C_F _ (algebraMap R₀ C_F f) R_F _ ι_CF.toAlgebra :=
      hLocIntClosure F
    letI : Algebra C_F R_F := ι_CF.toAlgebra
    letI : IsLocalization.Away (algebraMap R₀ C_F f) R_F := hLoc_RF
    haveI : IsScalarTower R₀ C_F R_F := IsScalarTower.of_algebraMap_eq (fun r => by
      apply Subtype.ext
      rw [IsScalarTower.algebraMap_apply R₀ R₂ R_F r]
      change algebraMap R_F F (algebraMap R₂ R_F (algebraMap R₀ R₂ r)) =
        algebraMap C_F F (algebraMap R₀ C_F r)
      rw [← IsScalarTower.algebraMap_apply R₂ R_F F, ← IsScalarTower.algebraMap_apply R₀ C_F F,
        IsScalarTower.algebraMap_apply R₀ R₂ F])
    have hFin_RF : Module.Finite R₂ R_F := by
      obtain ⟨s₀, hs₀⟩ := hFin0.fg_top
      refine Module.finite_def.mpr ⟨s₀.image ι_CF, le_antisymm le_top ?_⟩
      intro y _
      obtain ⟨⟨c, ⟨_, ⟨n, rfl⟩⟩⟩, hy⟩ :=
        @IsLocalization.surj C_F _ (Submonoid.powers (algebraMap R₀ C_F f)) R_F _ _ hLoc_RF y
      obtain ⟨u_f, hu_f⟩ := IsLocalization.Away.algebraMap_isUnit (S := R₂) f
      have hc_span : ι_CF c ∈ Submodule.span R₂ (↑(s₀.image ι_CF) : Set R_F) := by
        have hc0 : c ∈ Submodule.span R₀ (s₀ : Set C_F) := hs₀ ▸ Submodule.mem_top
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hc0
        · intro x hx
          exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem ι_CF hx))
        · simp
        · intro x₁ x₂ _ _ h₁ h₂; rw [map_add]; exact add_mem h₁ h₂
        · intro r x _ hx
          have h_sm : ι_CF (r • x) = (algebraMap R₀ R₂ r) • ι_CF x := by
            apply Subtype.ext
            change (r • x).1 = ((algebraMap R₀ R₂ r) • ι_CF x).1
            rw [Subalgebra.coe_smul, Subalgebra.coe_smul, Algebra.smul_def, Algebra.smul_def,
              IsScalarTower.algebraMap_apply R₀ R₂ F r]
            rfl
          rw [h_sm]
          exact Submodule.smul_mem _ _ hx
      have hy_eq : y = (↑(u_f ^ n)⁻¹ : R₂) • ι_CF c := by
        apply Subtype.ext
        have hy_val : y.1 * (algebraMap R₀ F f) ^ n = c.1 := by
          have h1 : (y * (algebraMap C_F R_F (algebraMap R₀ C_F f)) ^ n).1 =
              (algebraMap C_F R_F c).1 := by
            rw [← map_pow]
            exact congrArg Subtype.val hy
          rw [MulMemClass.coe_mul, SubmonoidClass.coe_pow] at h1
          exact h1
        have hu_inv : algebraMap R₂ F ↑(u_f ^ n)⁻¹ * (algebraMap R₀ F f) ^ n = 1 := by
          have h_uf : algebraMap R₂ F ↑(u_f ^ n) = (algebraMap R₀ F f) ^ n := by
            rw [Units.val_pow_eq_pow_val, map_pow, hu_f, IsScalarTower.algebraMap_apply R₀ R₂ F]
          rw [← h_uf, ← map_mul, Units.inv_mul, map_one]
        change y.1 = ((↑(u_f ^ n)⁻¹ : R₂) • ι_CF c).1
        rw [Subalgebra.coe_smul, Algebra.smul_def]
        change y.1 = algebraMap R₂ F ↑(u_f ^ n)⁻¹ * c.1
        rw [← hy_val]
        calc y.1 = y.1 * (algebraMap R₂ F ↑(u_f ^ n)⁻¹ * (algebraMap R₀ F f) ^ n) := by
              rw [hu_inv, mul_one]
          _ = algebraMap R₂ F ↑(u_f ^ n)⁻¹ * (y.1 * (algebraMap R₀ F f) ^ n) := by ring
      rw [hy_eq]
      exact Submodule.smul_mem _ _ hc_span
    have hInj_CF : Function.Injective (algebraMap C_F F) := Subtype.val_injective
    haveI : IsDomain C_F := Function.Injective.isDomain (algebraMap C_F F) hInj_CF
    haveI : Algebra.FiniteType R₀ C_F := (Algebra.finite_iff_isIntegral_and_finiteType.mp hFin0).2
    haveI : Algebra.FinitePresentation R₀ C_F :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance
    obtain ⟨q_a, hq_a⟩ := ha_dvd
    have hSub_a : (PrimeSpectrum.basicOpen (algebraMap R₀ C_F a_F) : Set (PrimeSpectrum C_F)) ⊆
        Algebra.etaleLocus R₀ C_F :=
      Algebra.basicOpen_subset_etaleLocus_iff_etale.mpr hEt_aF
    have hSub_f : (PrimeSpectrum.basicOpen (algebraMap R₀ C_F f) : Set (PrimeSpectrum C_F)) ⊆
        Algebra.etaleLocus R₀ C_F := by
      intro p_c hp
      apply hSub_a
      change algebraMap R₀ C_F a_F ∉ p_c.asIdeal
      intro hap
      apply hp
      rw [hq_a, map_mul]
      exact p_c.asIdeal.mul_mem_right _ hap
    have hEt_loc : Algebra.Etale R₀ (Localization.Away (algebraMap R₀ C_F f)) :=
      Algebra.basicOpen_subset_etaleLocus_iff_etale.mp hSub_f
    let e_loc_CF : Localization.Away (algebraMap R₀ C_F f) ≃ₐ[C_F] R_F :=
      IsLocalization.algEquiv (Submonoid.powers (algebraMap R₀ C_F f))
        (Localization.Away (algebraMap R₀ C_F f)) R_F
    let e_loc_R₀ : Localization.Away (algebraMap R₀ C_F f) ≃ₐ[R₀] R_F :=
      e_loc_CF.restrictScalars R₀
    have hEt_R₀_RF : Algebra.Etale R₀ R_F := by
      rw [← RingHom.etale_algebraMap]
      refine (@AlgebraicGeometry.HasRingHomProperty.Spec_iff @AlgebraicGeometry.Etale _ _ _ _
        (CommRingCat.ofHom (algebraMap R₀ R_F))).mp ?_
      have h_fac : CommRingCat.ofHom (algebraMap R₀ R_F) =
          CommRingCat.ofHom (algebraMap R₀ (Localization.Away (algebraMap R₀ C_F f))) ≫
          CommRingCat.ofHom e_loc_R₀.toRingHom :=
        CommRingCat.Hom.ext (RingHom.ext fun r => (e_loc_R₀.commutes r).symm)
      rw [h_fac, AlgebraicGeometry.Spec.map_comp]
      haveI : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_loc_R₀.toRingHom)) :=
        ⟨⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_loc_R₀.symm.toRingHom),
          by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
             have : e_loc_R₀.toRingHom.comp e_loc_R₀.symm.toRingHom = RingHom.id _ :=
               RingHom.ext e_loc_R₀.apply_symm_apply
             rw [this]; simp,
          by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
             have : e_loc_R₀.symm.toRingHom.comp e_loc_R₀.toRingHom = RingHom.id _ :=
               RingHom.ext e_loc_R₀.symm_apply_apply
             rw [this]; simp⟩⟩
      haveI : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R₀ (Localization.Away (algebraMap R₀ C_F f))))) :=
        (@AlgebraicGeometry.HasRingHomProperty.Spec_iff @AlgebraicGeometry.Etale _ _ _ _
          (CommRingCat.ofHom (algebraMap R₀ (Localization.Away (algebraMap R₀ C_F f))))).mpr
          (RingHom.etale_algebraMap.mpr hEt_loc)
      infer_instance
    haveI : Algebra.Etale R₀ R₂ := Algebra.Etale.of_isLocalizationAway f
    haveI : Algebra.Etale R₀ R_F := hEt_R₀_RF
    exact ⟨hFin_RF, hEt_R₀_RF, Algebra.Etale.of_restrictScalars R₀ R₂ R_F⟩

  obtain ⟨hFin_R', hEt_R₀R', hEt_R₂R'⟩ :=
    hEtFinAway E a_E ⟨δ_cond * a_L * δ_gen, by dsimp [f]; ring⟩ hEt_aE
  obtain ⟨_, hEt_R₀R'', hEt_R₂R''⟩ :=
    hEtFinAway L_gal a_L ⟨δ_cond * a_E * δ_gen, by dsimp [f]; ring⟩ hEt_aL
  haveI : Module.Finite R₂ R' := hFin_R'
  haveI : Algebra.Etale R₀ R' := hEt_R₀R'
  haveI : Algebra.Etale R₂ R' := hEt_R₂R'
  haveI : Algebra.Etale R₀ R'' := hEt_R₀R''
  haveI : Algebra.Etale R₂ R'' := hEt_R₂R''

  
  let ι_C'' : C'' →+* R'' := ι_int L_gal
  letI : Algebra C'' R'' := ι_C''.toAlgebra
  have hLoc_R'' : IsLocalization.Away (algebraMap R₀ C'' f) R'' := hLocIntClosure L_gal
  let α_R'' : R'' := ι_C'' α
  have hα_R''_top : Algebra.adjoin R₂ ({α_R''} : Set R'') = ⊤ := by
    apply top_unique
    intro y _
    obtain ⟨⟨c, ⟨_, ⟨n, rfl⟩⟩⟩, hy⟩ :=
      @IsLocalization.surj C'' _ (Submonoid.powers (algebraMap R₀ C'' f)) R'' _ _ hLoc_R'' y
    have hc_adj : ι_C'' (δ_gen • c) ∈ Algebra.adjoin R₂ ({α_R''} : Set R'') := by
      have hc0 := h_gen_clear c
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hc0
      · intro x hx
        rw [Set.mem_singleton_iff] at hx
        subst hx
        exact Algebra.subset_adjoin (Set.mem_singleton α_R'')
      · intro r
        have hr_eq : ι_C'' (algebraMap R₀ C'' r) = algebraMap R₂ R'' (algebraMap R₀ R₂ r) :=
          Subtype.ext (IsScalarTower.algebraMap_apply R₀ R₂ L_gal r)
        rw [hr_eq]
        exact Subalgebra.algebraMap_mem _ _
      · intro x₁ x₂ _ _ h₁ h₂; rw [map_add]; exact add_mem h₁ h₂
      · intro x₁ x₂ _ _ h₁ h₂; rw [map_mul]; exact mul_mem h₁ h₂
    have hd_unit : IsUnit (algebraMap R₀ R₂ (δ_gen * f ^ n)) := by
      rw [map_mul, map_pow]
      exact IsUnit.mul
        (hUnit_div_f δ_gen ⟨δ_cond * a_E * a_L, by dsimp [f]; ring⟩)
        ((IsLocalization.Away.algebraMap_isUnit (S := R₂) f).pow n)
    obtain ⟨u_d, hu_d⟩ := hd_unit
    have hy_eq : y = (↑u_d⁻¹ : R₂) • ι_C'' (δ_gen • c) := by
      apply Subtype.ext
      have hy_val : y.1 * (algebraMap R₀ L_gal f) ^ n = c.1 := by
        have h1 : (y * (algebraMap C'' R'' (algebraMap R₀ C'' f)) ^ n).1 =
            (algebraMap C'' R'' c).1 := by
          rw [← map_pow]
          exact congrArg Subtype.val hy
        rw [MulMemClass.coe_mul, SubmonoidClass.coe_pow] at h1
        exact h1
      have hu_inv : algebraMap R₂ L_gal ↑u_d⁻¹ * algebraMap R₀ L_gal (δ_gen * f ^ n) = 1 := by
        have h_ud : algebraMap R₂ L_gal ↑u_d = algebraMap R₀ L_gal (δ_gen * f ^ n) := by
          rw [hu_d, IsScalarTower.algebraMap_apply R₀ R₂ L_gal]
        rw [← h_ud, ← map_mul, Units.inv_mul, map_one]
      change y.1 = algebraMap R₂ L_gal ↑u_d⁻¹ * (algebraMap R₀ L_gal δ_gen * c.1)
      rw [← hy_val]
      calc y.1 = y.1 * (algebraMap R₂ L_gal ↑u_d⁻¹ * algebraMap R₀ L_gal (δ_gen * f ^ n)) := by
            rw [hu_inv, mul_one]
        _ = algebraMap R₂ L_gal ↑u_d⁻¹ *
              (algebraMap R₀ L_gal δ_gen * (y.1 * (algebraMap R₀ L_gal f) ^ n)) := by
            rw [map_mul, map_pow]; ring
    rw [hy_eq]
    exact Subalgebra.smul_mem _ hc_adj _

  
  let ι_R'R'' : R' →ₐ[R₂] R'' := (IsScalarTower.toAlgHom R₂ E L_gal).mapIntegralClosure
  letI : Algebra R' R'' := ι_R'R''.toRingHom.toAlgebra
  haveI : IsScalarTower R₂ R' E := ⟨fun r c x => by
    change (r • c : R').1 • x = r • (c.1 • x)
    rw [Subalgebra.coe_smul, smul_assoc]⟩
  haveI : IsScalarTower R₂ R' L_gal := ⟨fun r c x => by
    change (r • c : R').1 • x = r • (c.1 • x)
    rw [Subalgebra.coe_smul, smul_assoc]⟩
  haveI : IsScalarTower R₂ R' R'' := IsScalarTower.of_algebraMap_eq (fun r => ι_R'R''.commutes r |>.symm)
  haveI : IsScalarTower R₀ R' R'' := IsScalarTower.of_algebraMap_eq (fun r => by
    rw [IsScalarTower.algebraMap_apply R₀ R₂ R'', IsScalarTower.algebraMap_apply R₂ R' R'',
      ← IsScalarTower.algebraMap_apply R₀ R₂ R'])
  haveI : IsScalarTower R' R'' L_gal := ⟨fun c y x => by
    change (ι_R'R'' c * y).1 * x = c.1 • (y.1 * x)
    rw [MulMemClass.coe_mul, Algebra.smul_def]
    exact mul_assoc (algebraMap E L_gal c.1) y.1 x⟩
  haveI : Algebra.Etale R' R'' := Algebra.Etale.of_restrictScalars R₀ R' R''
  haveI : Algebra.IsIntegral R₂ R' := ⟨fun x => integralClosure.isIntegral x⟩
  haveI : Algebra.IsIntegral R₂ R'' := ⟨fun x => integralClosure.isIntegral x⟩
  haveI : Algebra.IsIntegral R' R'' :=
    ⟨fun x => _root_.IsIntegral.tower_top (R := R₂) (A := R') (integralClosure.isIntegral x)⟩

  let S₂ := AlgebraicGeometry.Spec (CommRingCat.of R₂)
  let S' := AlgebraicGeometry.Spec (CommRingCat.of R')
  let S'' := AlgebraicGeometry.Spec (CommRingCat.of R'')
  let f_aff : S' ⟶ S₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₂ R'))
  let π_aff : S'' ⟶ S' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R' R''))

  have hInt_S'' : AlgebraicGeometry.IsIntegral S'' := inferInstance
  have hFin_faff : AlgebraicGeometry.IsFinite f_aff :=
    (AlgebraicGeometry.IsFinite.SpecMap_iff (CommRingCat.ofHom (algebraMap R₂ R'))).mpr
      (RingHom.finite_algebraMap.mpr hFin_R')
  have hEt_faff : AlgebraicGeometry.Etale f_aff :=
    (@AlgebraicGeometry.HasRingHomProperty.Spec_iff @AlgebraicGeometry.Etale _ _ _ _
      (CommRingCat.ofHom (algebraMap R₂ R'))).mpr (RingHom.etale_algebraMap.mpr hEt_R₂R')
  have hEt_πaff : AlgebraicGeometry.Etale π_aff :=
    (@AlgebraicGeometry.HasRingHomProperty.Spec_iff @AlgebraicGeometry.Etale _ _ _ _
      (CommRingCat.ofHom (algebraMap R' R''))).mpr (RingHom.etale_algebraMap.mpr inferInstance)

  have hSurjSpecOfIntegral : ∀ {A B : Type u} [CommRing A] [CommRing B] [IsDomain B]
      [Algebra A B] [Algebra.IsIntegral A B],
      Function.Injective (algebraMap A B) →
      AlgebraicGeometry.Surjective
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B))) := by
    intro A B _ _ _ _ _ h_inj
    rw [AlgebraicGeometry.surjective_iff]
    intro P
    let P_spec : PrimeSpectrum A := P
    letI : P_spec.asIdeal.IsPrime := P_spec.isPrime
    have h_ker : RingHom.ker (algebraMap A B) ≤ P_spec.asIdeal := by
      intro a ha
      have ha0 : a = 0 := h_inj (ha.trans (map_zero _).symm)
      rw [ha0]
      exact P_spec.asIdeal.zero_mem
    obtain ⟨Q, hQ_prime, hQ_under⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain P_spec.asIdeal h_ker
    exact ⟨(⟨Q, hQ_prime⟩ : PrimeSpectrum B), PrimeSpectrum.ext hQ_under⟩

  have hInj_R₂R' : Function.Injective (algebraMap R₂ R') := by
    intro a₁ a₂ h_eq
    apply IsFractionRing.injective R₂ K
    apply (algebraMap K E).injective
    exact congrArg Subtype.val h_eq
  have hInj_R'R'' : Function.Injective (algebraMap R' R'') := by
    intro a₁ a₂ h_eq
    apply Subtype.ext
    exact (algebraMap E L_gal).injective (congrArg Subtype.val h_eq)
  have hSurj_faff : AlgebraicGeometry.Surjective f_aff := hSurjSpecOfIntegral hInj_R₂R'
  have hSurj_πaff : AlgebraicGeometry.Surjective π_aff := hSurjSpecOfIntegral hInj_R'R''
  have h_πf_aff : π_aff ≫ f_aff =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₂ R'')) := by
    dsimp only [π_aff, f_aff]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg (fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom r))
      (RingHom.ext fun x => (IsScalarTower.algebraMap_apply R₂ R' R'' x).symm)

  
  let actG_aff : I_G → (S'' ⟶ S'') := fun g =>
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((g.restrictScalars R₂).mapIntegralClosure).toRingHom)
  let secS_aff : S_idx → (S'' ⟶ S') := fun ι =>
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((ι.restrictScalars R₂).mapIntegralClosure).toRingHom)
  let actH_aff : H → (S'' ⟶ S'') := fun τ =>
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((τ.restrictScalars R₂).mapIntegralClosure).toRingHom)

  have hSec_aff : ∀ ι : S_idx, secS_aff ι ≫ f_aff = π_aff ≫ f_aff := by
    intro ι
    rw [h_πf_aff]
    dsimp only [secS_aff, f_aff]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg (fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom r))
      (RingHom.ext fun x => ((ι.restrictScalars R₂).mapIntegralClosure).commutes x)
  have hPerm_aff : ∀ g : I_G, ∃ σ_perm : Equiv.Perm S_idx,
      ∀ ι : S_idx, actG_aff g ≫ secS_aff ι = secS_aff (σ_perm ι) := by
    intro g
    refine ⟨{ toFun := fun ι => g.toAlgHom.comp ι
              invFun := fun ι => g.symm.toAlgHom.comp ι
              left_inv := fun ι => AlgHom.ext (fun x => g.symm_apply_apply (ι x))
              right_inv := fun ι => AlgHom.ext (fun x => g.apply_symm_apply (ι x)) }, fun ι => ?_⟩
    dsimp only [actG_aff, secS_aff, Equiv.coe_fn_mk]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg (fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom r))
      (RingHom.ext fun x => Subtype.ext rfl)
  have hActG_comp : ∀ g : I_G, actG_aff g ≫ (π_aff ≫ f_aff) = π_aff ≫ f_aff := by
    intro g
    rw [h_πf_aff]
    dsimp only [actG_aff]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg (fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom r))
      (RingHom.ext fun x => ((g.restrictScalars R₂).mapIntegralClosure).commutes x)
  have hActH_hom_aff : ∀ τ : H, actH_aff τ ≫ π_aff = π_aff := by
    intro τ
    dsimp only [actH_aff, π_aff]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg (fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom r))
      (RingHom.ext fun x => Subtype.ext (τ.commutes x.1))
  have hActH_one : actH_aff 1 = CategoryTheory.CategoryStruct.id S'' := by
    dsimp only [actH_aff]
    have h_id : (((1 : H).restrictScalars R₂).mapIntegralClosure).toRingHom = RingHom.id R'' :=
      RingHom.ext (fun _ => Subtype.ext rfl)
    rw [h_id]
    exact AlgebraicGeometry.Spec.map_id (CommRingCat.of R'')
  have hActH_mul : ∀ τ₁ τ₂ : H, actH_aff (τ₁ * τ₂) = actH_aff τ₁ ≫ actH_aff τ₂ := by
    intro τ₁ τ₂
    dsimp only [actH_aff]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg (fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom r))
      (RingHom.ext fun _ => Subtype.ext rfl)

  let γ_G_aff : I_G → (S'' ⟶ CategoryTheory.Limits.pullback (π_aff ≫ f_aff) (π_aff ≫ f_aff)) :=
    fun g => CategoryTheory.Limits.pullback.lift (actG_aff g) (CategoryTheory.CategoryStruct.id S'')
      (by rw [Category.id_comp, hActG_comp g])
  let γ_H_aff : H → (S'' ⟶ CategoryTheory.Limits.pullback π_aff π_aff) :=
    fun τ => CategoryTheory.Limits.pullback.lift (actH_aff τ) (CategoryTheory.CategoryStruct.id S'')
      (by rw [Category.id_comp, hActH_hom_aff τ])

  
  have hGaloisGraphCover :
      ∀ (B F : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B]
        [Field F] [Algebra B F] [IsFractionRing B F]
        [Algebra R₂ B] [Algebra R₂ F] [IsScalarTower R₂ B F]
        [Algebra F L_gal] [Algebra B L_gal]
        [IsScalarTower R₂ B L_gal] [IsScalarTower R₂ F L_gal] [IsScalarTower B F L_gal]
        [FiniteDimensional F L_gal] [IsGalois F L_gal]
        [Algebra B R''] [IsScalarTower R₂ B R''] [IsScalarTower B R'' L_gal]
        (p_B : S'' ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
        (_ : p_B = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B R'')))
        (actF : (L_gal ≃ₐ[F] L_gal) → (S'' ⟶ S''))
        (_ : ∀ σ : L_gal ≃ₐ[F] L_gal,
          actF σ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((σ.restrictScalars R₂).mapIntegralClosure).toRingHom))
        (γ_F : (L_gal ≃ₐ[F] L_gal) → (S'' ⟶ CategoryTheory.Limits.pullback p_B p_B))
        (_ : ∀ σ, γ_F σ ≫ CategoryTheory.Limits.pullback.fst p_B p_B = actF σ)
        (_ : ∀ σ, γ_F σ ≫ CategoryTheory.Limits.pullback.snd p_B p_B =
          CategoryTheory.CategoryStruct.id S''),
        (⋃ σ : L_gal ≃ₐ[F] L_gal, Set.range (γ_F σ).base) = Set.univ := by
    intro B F _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ p_B hp_B actF hactF γ_F hγ_fst hγ_snd
    let σ_hat : (L_gal ≃ₐ[F] L_gal) → (R'' ≃ₐ[R₂] R'') :=
      fun σ => (σ.restrictScalars R₂).mapIntegralClosure
    have hσ_val : ∀ (σ : L_gal ≃ₐ[F] L_gal) (x : R''), (σ_hat σ x).1 = σ x.1 :=
      fun _ _ => rfl
    let P_orb : Polynomial R'' :=
      ∏ σ : L_gal ≃ₐ[F] L_gal, (Polynomial.X - Polynomial.C (σ_hat σ α_R''))
    let P_L : Polynomial L_gal := P_orb.map (algebraMap R'' L_gal)
    have hPL_eq : P_L = ∏ σ : L_gal ≃ₐ[F] L_gal, (Polynomial.X - Polynomial.C (σ α_R''.1)) := by
      dsimp only [P_L, P_orb]
      rw [Polynomial.map_prod]
      refine Finset.prod_congr rfl (fun σ _ => ?_)
      rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
      rfl
    have hPL_inv : ∀ τ : L_gal ≃ₐ[F] L_gal, P_L.map τ.toRingHom = P_L := by
      intro τ
      rw [hPL_eq, Polynomial.map_prod]
      have h_step : (∏ σ : L_gal ≃ₐ[F] L_gal,
          (Polynomial.X - Polynomial.C (σ α_R''.1)).map τ.toRingHom) =
          ∏ σ : L_gal ≃ₐ[F] L_gal, (Polynomial.X - Polynomial.C ((τ * σ) α_R''.1)) := by
        refine Finset.prod_congr rfl (fun σ _ => ?_)
        rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, AlgEquiv.mul_apply]
        rfl
      rw [h_step]
      exact Equiv.prod_comp (Equiv.mulLeft τ) (fun ρ => Polynomial.X - Polynomial.C (ρ α_R''.1))
    have h_coeff_B : ∀ n : ℕ, ∃ b_n : B, P_orb.coeff n = algebraMap B R'' b_n := by
      intro n
      have h_mem_fix : P_L.coeff n ∈
          IntermediateField.fixedField (⊤ : Subgroup (L_gal ≃ₐ[F] L_gal)) := by
        intro ⟨τ, _⟩
        change τ.toRingHom (P_L.coeff n) = P_L.coeff n
        rw [← Polynomial.coeff_map, hPL_inv τ]
      have h_top_bot : IntermediateField.fixedField (⊤ : Subgroup (L_gal ≃ₐ[F] L_gal)) =
          (⊥ : IntermediateField F L_gal) := by
        rw [← IntermediateField.fixingSubgroup_bot (F := F) (E := L_gal),
          IsGalois.fixedField_fixingSubgroup (⊥ : IntermediateField F L_gal)]
      rw [h_top_bot, IntermediateField.mem_bot] at h_mem_fix
      obtain ⟨c_n, hc_n⟩ := h_mem_fix
      have hc_val : algebraMap F L_gal c_n = (P_orb.coeff n).1 := by
        rw [hc_n]
        dsimp only [P_L]
        rw [Polynomial.coeff_map]
        rfl
      have hc_int_B : _root_.IsIntegral B c_n := by
        have h1 : _root_.IsIntegral B (algebraMap F L_gal c_n) := by
          rw [hc_val]
          exact _root_.IsIntegral.tower_top (R := R₂) (A := B) (P_orb.coeff n).2
        exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom B F L_gal)
          (algebraMap F L_gal).injective).mp h1
      obtain ⟨b_n, hb_n⟩ := (IsIntegrallyClosed.isIntegral_iff (R := B) (K := F)).mp hc_int_B
      refine ⟨b_n, Subtype.ext ?_⟩
      have h_tower_b : (algebraMap B R'' b_n).1 = algebraMap F L_gal (algebraMap B F b_n) := by
        change algebraMap R'' L_gal (algebraMap B R'' b_n) = _
        rw [← IsScalarTower.algebraMap_apply B R'' L_gal, IsScalarTower.algebraMap_apply B F L_gal]
      rw [h_tower_b, hb_n, hc_val]
    ext z
    refine ⟨fun _ => Set.mem_univ z, fun _ => ?_⟩
    let P_sch := CategoryTheory.Limits.pullback p_B p_B
    let κ_obj := P_sch.residueField z
    let κ : Type u := ↑κ_obj
    let ξ_z : AlgebraicGeometry.Spec κ_obj ⟶ P_sch := P_sch.fromSpecResidueField z
    let u₁ : AlgebraicGeometry.Spec κ_obj ⟶ S'' :=
      ξ_z ≫ CategoryTheory.Limits.pullback.fst p_B p_B
    let u₂ : AlgebraicGeometry.Spec κ_obj ⟶ S'' :=
      ξ_z ≫ CategoryTheory.Limits.pullback.snd p_B p_B
    let ψ₁_hom : CommRingCat.of R'' ⟶ κ_obj := AlgebraicGeometry.Spec.preimage u₁
    let ψ₂_hom : CommRingCat.of R'' ⟶ κ_obj := AlgebraicGeometry.Spec.preimage u₂
    let ψ₁ : R'' →+* κ := ψ₁_hom.hom
    let ψ₂ : R'' →+* κ := ψ₂_hom.hom
    have hψ_agree_B : ∀ b : B, ψ₁ (algebraMap B R'' b) = ψ₂ (algebraMap B R'' b) := by
      have h_eq_pB : u₁ ≫ p_B = u₂ ≫ p_B := by
        dsimp only [u₁, u₂]
        rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition]
      rw [hp_B, ← AlgebraicGeometry.Spec.map_preimage u₁, ← AlgebraicGeometry.Spec.map_preimage u₂,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp] at h_eq_pB
      have h_hom_eq := AlgebraicGeometry.Spec.map_injective h_eq_pB
      intro b
      exact ConcreteCategory.congr_hom h_hom_eq b
    have hPorb_map_eq : P_orb.map ψ₁ = P_orb.map ψ₂ := by
      ext n
      obtain ⟨b_n, hb_n⟩ := h_coeff_B n
      rw [Polynomial.coeff_map, Polynomial.coeff_map, hb_n, hψ_agree_B b_n]
    have h_ev1 : (P_orb.map ψ₁).eval (ψ₁ α_R'') = 0 := by
      dsimp only [P_orb]
      rw [Polynomial.map_prod, Polynomial.eval_prod]
      refine Finset.prod_eq_zero (Finset.mem_univ (1 : L_gal ≃ₐ[F] L_gal)) ?_
      rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, Polynomial.eval_sub,
        Polynomial.eval_X, Polynomial.eval_C]
      have h_one : σ_hat 1 α_R'' = α_R'' := Subtype.ext rfl
      rw [h_one, sub_self]
    have h_ev2 : (P_orb.map ψ₂).eval (ψ₁ α_R'') =
        ∏ σ : L_gal ≃ₐ[F] L_gal, (ψ₁ α_R'' - ψ₂ (σ_hat σ α_R'')) := by
      dsimp only [P_orb]
      rw [Polynomial.map_prod, Polynomial.eval_prod]
      refine Finset.prod_congr rfl (fun σ _ => ?_)
      rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, Polynomial.eval_sub,
        Polynomial.eval_X, Polynomial.eval_C]
    have h_prod_zero : (∏ σ : L_gal ≃ₐ[F] L_gal, (ψ₁ α_R'' - ψ₂ (σ_hat σ α_R''))) = 0 := by
      rw [← h_ev2, ← hPorb_map_eq, h_ev1]
    obtain ⟨σ, _, hσ_eq0⟩ := Finset.prod_eq_zero_iff.mp h_prod_zero
    have hσ_α : ψ₁ α_R'' = ψ₂ (σ_hat σ α_R'') := sub_eq_zero.mp hσ_eq0
    have hψ_all : ∀ x : R'', ψ₁ x = ψ₂ (σ_hat σ x) := by
      intro x
      have hx_top : x ∈ Algebra.adjoin R₂ ({α_R''} : Set R'') := by
        rw [hα_R''_top]; trivial
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx_top
      · intro y hy
        rw [Set.mem_singleton_iff] at hy; subst hy; exact hσ_α
      · intro r
        rw [(σ_hat σ).commutes r, IsScalarTower.algebraMap_apply R₂ B R'' r]
        exact hψ_agree_B (algebraMap R₂ B r)
      · intro x₁ x₂ _ _ h₁ h₂; rw [map_add, map_add, map_add, h₁, h₂]
      · intro x₁ x₂ _ _ h₁ h₂; rw [map_mul, map_mul, map_mul, h₁, h₂]
    have h_u1_eq : u₁ = u₂ ≫ actF σ := by
      rw [hactF σ, ← AlgebraicGeometry.Spec.map_preimage u₁,
        ← AlgebraicGeometry.Spec.map_preimage u₂, ← AlgebraicGeometry.Spec.map_comp]
      exact congrArg AlgebraicGeometry.Spec.map (CommRingCat.Hom.ext (RingHom.ext hψ_all))
    have h_lift_ξ : u₂ ≫ γ_F σ = ξ_z := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, hγ_fst σ, ← h_u1_eq]
      · rw [Category.assoc, hγ_snd σ, Category.comp_id]
    let pt_κ : ↥(AlgebraicGeometry.Spec κ_obj) := IsLocalRing.closedPoint κ
    have hξ_pt : ξ_z.base pt_κ = z := P_sch.fromSpecResidueField_apply z pt_κ
    refine Set.mem_iUnion.mpr ⟨σ, u₂.base pt_κ, ?_⟩
    calc (γ_F σ).base (u₂.base pt_κ)
      _ = (u₂ ≫ γ_F σ).base pt_κ := rfl
      _ = ξ_z.base pt_κ := by rw [h_lift_ξ]
      _ = z := hξ_pt

  haveI : FiniteDimensional E L_gal := Module.Finite.of_restrictScalars_finite K E L_gal
  have hCovG_aff : (⋃ g : I_G, Set.range (γ_G_aff g).base) = Set.univ :=
    hGaloisGraphCover R₂ K (π_aff ≫ f_aff) h_πf_aff actG_aff (fun _ => rfl) γ_G_aff
      (fun g => CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (fun g => CategoryTheory.Limits.pullback.lift_snd _ _ _)
  have hCovH_aff : (⋃ τ : H, Set.range (γ_H_aff τ).base) = Set.univ :=
    hGaloisGraphCover R' E π_aff rfl actH_aff (fun _ => rfl) γ_H_aff
      (fun τ => CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (fun τ => CategoryTheory.Limits.pullback.lift_snd _ _ _)

  
  
  
  let ξ₀ : AlgebraicGeometry.Spec Y₀.functionField ⟶ Y₀ :=
    Y₀.fromSpecStalk (genericPoint ↥Y₀)
  let π_E : AlgebraicGeometry.Spec (CommRingCat.of E) ⟶ AlgebraicGeometry.Spec Y₀.functionField :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E))
  let ξ_E : AlgebraicGeometry.Spec (CommRingCat.of E) ⟶ Y₀ := π_E ≫ ξ₀
  haveI : AlgebraicGeometry.QuasiCompact (ξ_E ≫ g_Y₀) := inferInstance
  haveI : AlgebraicGeometry.QuasiSeparated (ξ_E ≫ g_Y₀) := inferInstance
  haveI : AlgebraicGeometry.QuasiCompact ξ_E :=
    AlgebraicGeometry.QuasiCompact.of_comp ξ_E g_Y₀
  haveI : AlgebraicGeometry.QuasiSeparated ξ_E :=
    AlgebraicGeometry.QuasiSeparated.of_comp ξ_E g_Y₀

  let Y' : AlgebraicGeometry.Scheme.{u} := ξ_E.normalization
  let ν : Y' ⟶ Y₀ := ξ_E.fromNormalization
  have hInt_Y' : AlgebraicGeometry.IsIntegral Y' := inferInstance
  haveI : AlgebraicGeometry.IsIntegralHom ν := by dsimp [ν]; infer_instance
  haveI : AlgebraicGeometry.IsAffineHom ν := inferInstance

  let pt_E : ↥(AlgebraicGeometry.Spec (CommRingCat.of E)) := IsLocalRing.closedPoint E
  have hSub_E : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of E)) := by
    constructor
    intro p₁ p₂
    change PrimeSpectrum E at p₁ p₂
    refine PrimeSpectrum.ext ?_
    rw [(Ideal.eq_bot_or_top p₁.asIdeal).resolve_right p₁.isPrime.ne_top,
        (Ideal.eq_bot_or_top p₂.asIdeal).resolve_right p₂.isPrime.ne_top]
  have hSub_K : Subsingleton ↥(AlgebraicGeometry.Spec Y₀.functionField) := by
    constructor
    intro p₁ p₂
    change PrimeSpectrum K at p₁ p₂
    refine PrimeSpectrum.ext ?_
    rw [(Ideal.eq_bot_or_top p₁.asIdeal).resolve_right p₁.isPrime.ne_top,
        (Ideal.eq_bot_or_top p₂.asIdeal).resolve_right p₂.isPrime.ne_top]
  have hξE_pt : ξ_E.base pt_E = genericPoint ↥Y₀ := by
    change ξ₀.base (π_E.base pt_E) = genericPoint ↥Y₀
    rw [hSub_K.elim (π_E.base pt_E) (IsLocalRing.closedPoint K)]
    exact AlgebraicGeometry.Scheme.fromSpecStalk_closedPoint

  
  have hNormChart : ∀ (W : Y₀.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) [Nonempty W]
      [Algebra ↑(Y₀.presheaf.obj (Opposite.op W)) E],
      (∀ a : ↑(Y₀.presheaf.obj (Opposite.op W)),
        algebraMap ↑(Y₀.presheaf.obj (Opposite.op W)) E a =
          algebraMap K E (algebraMap ↑(Y₀.presheaf.obj (Opposite.op W)) K a)) →
      ∃ (iso_Γ : Y'.presheaf.obj (Opposite.op (ν ⁻¹ᵁ W)) ≅
          CommRingCat.of ↥(integralClosure ↑(Y₀.presheaf.obj (Opposite.op W)) E)),
        ν.app W ≫ iso_Γ.hom =
          CommRingCat.ofHom (algebraMap ↑(Y₀.presheaf.obj (Opposite.op W))
            ↥(integralClosure ↑(Y₀.presheaf.obj (Opposite.op W)) E)) := by
    intro W hW _ _ hAlgW
    obtain ⟨⟨w₀, hw₀⟩⟩ := ‹Nonempty W›
    have hη_W : genericPoint ↥Y₀ ∈ W :=
      (genericPoint_specializes w₀).mem_open W.isOpen hw₀
    have hpre_top : ξ_E ⁻¹ᵁ W = ⊤ := by
      ext q
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      rw [hSub_E.elim q pt_E]
      change ξ_E.base pt_E ∈ W
      exact hξE_pt.symm ▸ hη_W
    let A_W := ↑(Y₀.presheaf.obj (Opposite.op W))
    let R_W := ↑((AlgebraicGeometry.Spec (CommRingCat.of E)).presheaf.obj
      (Opposite.op (ξ_E ⁻¹ᵁ W)))
    letI : Algebra A_W R_W := (ξ_E.app W).hom.toAlgebra
    let iso_R : (AlgebraicGeometry.Spec (CommRingCat.of E)).presheaf.obj
        (Opposite.op (ξ_E ⁻¹ᵁ W)) ≅ CommRingCat.of E :=
      (AlgebraicGeometry.Spec (CommRingCat.of E)).presheaf.mapIso (eqToIso hpre_top.symm).op ≪≫
        AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)
    have h_comp_cat : ξ_E.app W ≫ iso_R.hom =
        Y₀.germToFunctionField W ≫ CommRingCat.ofHom (algebraMap K E) := by
      have h_app_eq : ξ_E.app W = ξ₀.app W ≫ π_E.app (ξ₀ ⁻¹ᵁ W) :=
        AlgebraicGeometry.Scheme.Hom.comp_app π_E ξ₀ W
      have hpre_top' : π_E ⁻¹ᵁ (ξ₀ ⁻¹ᵁ W) = ⊤ := hpre_top
      rw [h_app_eq, AlgebraicGeometry.Scheme.fromSpecStalk_app hη_W]
      change Y₀.germToFunctionField W ≫
          ((AlgebraicGeometry.Scheme.ΓSpecIso Y₀.functionField).inv ≫
            (AlgebraicGeometry.Spec Y₀.functionField).presheaf.map
              (homOfLE (le_top : ξ₀ ⁻¹ᵁ W ≤ ⊤)).op ≫
            π_E.app (ξ₀ ⁻¹ᵁ W) ≫
            (AlgebraicGeometry.Spec (CommRingCat.of E)).presheaf.map
              (eqToIso hpre_top'.symm).op.hom ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)).hom) =
        Y₀.germToFunctionField W ≫ CommRingCat.ofHom (algebraMap K E)
      refine congrArg (Y₀.germToFunctionField W ≫ ·) ?_
      have h_nat :
          (AlgebraicGeometry.Spec Y₀.functionField).presheaf.map
              (homOfLE (le_top : ξ₀ ⁻¹ᵁ W ≤ ⊤)).op ≫
            π_E.app (ξ₀ ⁻¹ᵁ W) =
          π_E.appTop ≫
            (AlgebraicGeometry.Spec (CommRingCat.of E)).presheaf.map
              (homOfLE (le_top : π_E ⁻¹ᵁ (ξ₀ ⁻¹ᵁ W) ≤ ⊤)).op :=
        (π_E.naturality (homOfLE le_top).op).symm
      rw [← Category.assoc ((AlgebraicGeometry.Spec Y₀.functionField).presheaf.map _),
        h_nat, Category.assoc]
      have h_top_id :
          (AlgebraicGeometry.Spec (CommRingCat.of E)).presheaf.map
              (homOfLE (le_top : π_E ⁻¹ᵁ (ξ₀ ⁻¹ᵁ W) ≤ ⊤)).op ≫
            (AlgebraicGeometry.Spec (CommRingCat.of E)).presheaf.map (eqToIso hpre_top'.symm).op.hom =
          𝟙 _ := by
        rw [← Functor.map_comp]
        have h_op_eq :
            ((homOfLE (le_top : π_E ⁻¹ᵁ (ξ₀ ⁻¹ᵁ W) ≤ ⊤)).op ≫
              (eqToIso hpre_top'.symm).op.hom) = 𝟙 (Opposite.op ⊤) :=
          Subsingleton.elim _ _
        rw [h_op_eq, CategoryTheory.Functor.map_id]
      rw [← Category.assoc ((AlgebraicGeometry.Spec (CommRingCat.of E)).presheaf.map _),
        h_top_id, Category.id_comp]
      change (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E))).appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)).hom) =
        CommRingCat.ofHom (algebraMap K E)
      rw [← Category.assoc, ← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap K E)), Category.assoc, Iso.inv_hom_id, Category.comp_id]
    let e_alg : R_W ≃ₐ[A_W] E :=
      AlgEquiv.ofRingEquiv (f := iso_R.commRingCatIsoToRingEquiv) (fun a =>
        (ConcreteCategory.congr_hom h_comp_cat a).trans (hAlgW a).symm)
    let e_int : ↥(integralClosure A_W R_W) ≃ₐ[A_W] ↥(integralClosure A_W E) :=
      AlgEquiv.mapIntegralClosure e_alg
    let iso_int : CommRingCat.of ↥(integralClosure A_W R_W) ≅
        CommRingCat.of ↥(integralClosure A_W E) :=
      { hom := CommRingCat.ofHom e_int.toRingHom
        inv := CommRingCat.ofHom e_int.symm.toRingHom
        hom_inv_id := CommRingCat.Hom.ext (RingHom.ext e_int.symm_apply_apply)
        inv_hom_id := CommRingCat.Hom.ext (RingHom.ext e_int.apply_symm_apply) }
    let iso_Γ := ξ_E.normalizationObjIso hW ≪≫ iso_int
    refine ⟨iso_Γ, ?_⟩
    dsimp only [ν, iso_Γ, Iso.trans_hom]
    rw [AlgebraicGeometry.Scheme.Hom.fromNormalization_app ξ_E hW, Category.assoc,
      Iso.inv_hom_id_assoc]
    exact CommRingCat.Hom.ext (RingHom.ext fun a => e_int.commutes a)

  have hFin_ν : AlgebraicGeometry.IsFinite ν := by
    rw [AlgebraicGeometry.isFinite_iff]
    refine ⟨inferInstance, fun W hW => ?_⟩
    by_cases hW_ne : Nonempty W
    · haveI : Nonempty W := hW_ne
      let A_W := ↑(Y₀.presheaf.obj (Opposite.op W))
      haveI : IsDomain A_W := inferInstanceAs (IsDomain ↑(Y₀.presheaf.obj (Opposite.op W)))
      haveI : IsFractionRing A_W K :=
        AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Y₀ W hW
      let φ_kW : k →+* A_W :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          g_Y₀.appLE ⊤ W le_top).hom
      letI : Algebra k A_W := φ_kW.toAlgebra
      haveI : Algebra.FiniteType k A_W := by
        rw [← RingHom.finiteType_algebraMap]
        have h_comp : φ_kW = (g_Y₀.appLE ⊤ W le_top).hom.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom :=
          CommRingCat.hom_comp _ _
        change φ_kW.FiniteType
        rw [h_comp]
        exact RingHom.FiniteType.comp
          (g_Y₀.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top _) hW le_top)
          (RingHom.FiniteType.of_surjective _
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv.surjective)
      let C_W := ↥(integralClosure A_W K)
      obtain ⟨hFin_CW, hIC_CW⟩ := hFinIntClosure A_W K
      haveI : Module.Finite A_W C_W := hFin_CW
      haveI : IsIntegrallyClosed C_W := hIC_CW
      haveI : IsNoetherianRing A_W := Algebra.FiniteType.isNoetherianRing k A_W
      haveI : IsNoetherianRing C_W := Algebra.FiniteType.isNoetherianRing A_W C_W
      haveI : IsFractionRing C_W K :=
        IsIntegralClosure.isFractionRing_of_finite_extension A_W K K C_W
      letI : Algebra A_W E := ((algebraMap K E).comp (algebraMap A_W K)).toAlgebra
      haveI : IsScalarTower A_W K E := IsScalarTower.of_algebraMap_eq' rfl
      haveI : IsScalarTower A_W C_W E :=
        ⟨fun a c x => by
          change (a • c : C_W).1 • x = a • (c.1 • x)
          rw [Subalgebra.coe_smul, smul_assoc]⟩
      haveI : Module.Finite C_W ↥(integralClosure C_W E) :=
        IsIntegralClosure.finite C_W K E ↥(integralClosure C_W E)
      have hFin_CWE : Module.Finite A_W ↥(integralClosure C_W E) :=
        Module.Finite.trans C_W ↥(integralClosure C_W E)
      have h_mem_W : ∀ x : E, x ∈ integralClosure C_W E ↔ x ∈ integralClosure A_W E :=
        fun x => ⟨fun hx => isIntegral_trans x hx, fun hx => _root_.IsIntegral.tower_top hx⟩
      let e_CWAW : ↥(integralClosure C_W E) ≃ₗ[A_W] ↥(integralClosure A_W E) :=
        { toFun := fun z => ⟨z.1, (h_mem_W z.1).mp z.2⟩
          invFun := fun z => ⟨z.1, (h_mem_W z.1).mpr z.2⟩
          left_inv := fun _ => Subtype.ext rfl
          right_inv := fun _ => Subtype.ext rfl
          map_add' := fun _ _ => Subtype.ext rfl
          map_smul' := fun a z => Subtype.ext (by
            change (a • z : ↥(integralClosure C_W E)).1 = (a • (⟨z.1, _⟩ : ↥(integralClosure A_W E))).1
            rw [Subalgebra.coe_smul, Subalgebra.coe_smul]) }
      have hFin_AWE : Module.Finite A_W ↥(integralClosure A_W E) := Module.Finite.equiv e_CWAW
      obtain ⟨iso_ΓW, hiso_ΓW⟩ := hNormChart W hW (fun _ => rfl)
      have h_app_eq : ν.app W =
          CommRingCat.ofHom (algebraMap A_W ↥(integralClosure A_W E)) ≫ iso_ΓW.inv := by
        rw [← hiso_ΓW, Category.assoc, Iso.hom_inv_id, Category.comp_id]
      have h_hom_eq : (ν.app W).hom =
          iso_ΓW.inv.hom.comp (algebraMap A_W ↥(integralClosure A_W E)) := by
        rw [h_app_eq]; rfl
      rw [h_hom_eq]
      exact RingHom.Finite.comp
        (RingHom.Finite.of_surjective _ iso_ΓW.symm.commRingCatIsoToRingEquiv.surjective)
        (RingHom.finite_algebraMap.mpr hFin_AWE)
    · have hW_bot : W = ⊥ := by
        ext z
        exact ⟨fun hz => False.elim (hW_ne ⟨⟨z, hz⟩⟩), False.elim⟩
      subst hW_bot
      haveI : Subsingleton ↑(Y'.presheaf.obj (Opposite.op (ν ⁻¹ᵁ (⊥ : Y₀.Opens)))) := by
        change Subsingleton ↑(Y'.presheaf.obj (Opposite.op (⊥ : Y'.Opens)))
        infer_instance
      exact RingHom.Finite.of_surjective _ (fun y => ⟨0, Subsingleton.elim _ _⟩)

  
  obtain ⟨iso_ΓU₂, hiso_ΓU₂⟩ := hNormChart U₂ hU₂_aff (fun _ => rfl)
  have hU'_aff : AlgebraicGeometry.IsAffineOpen (ν ⁻¹ᵁ U₂) := hU₂_aff.preimage ν
  let iso_Spec_Γ : S' ≅ AlgebraicGeometry.Spec (Y'.presheaf.obj (Opposite.op (ν ⁻¹ᵁ U₂))) :=
    { hom := AlgebraicGeometry.Spec.map iso_ΓU₂.hom
      inv := AlgebraicGeometry.Spec.map iso_ΓU₂.inv
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, iso_ΓU₂.inv_hom_id]
        exact AlgebraicGeometry.Spec.map_id _
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, iso_ΓU₂.hom_inv_id]
        exact AlgebraicGeometry.Spec.map_id _ }
  let e_U'₂ : S' ≅ (ν ⁻¹ᵁ U₂).toScheme := iso_Spec_Γ ≪≫ hU'_aff.isoSpec.symm
  have he_U' : e_U'₂.hom ≫ (ν ∣_ U₂) = f_aff ≫ hU₂_aff.isoSpec.inv := by
    apply (cancel_mono U₂.ι).mp
    rw [Category.assoc, Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
      hU₂_aff.isoSpec_inv_ι]
    dsimp only [e_U'₂, iso_Spec_Γ, Iso.trans_hom, Iso.symm_hom]
    rw [Category.assoc, ← Category.assoc hU'_aff.isoSpec.inv, hU'_aff.isoSpec_inv_ι]
    have h_fromSpec : hU'_aff.fromSpec ≫ ν =
        AlgebraicGeometry.Spec.map (ν.app U₂) ≫ hU₂_aff.fromSpec := by
      have h1 := (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ν hU₂_aff hU'_aff le_rfl).symm
      rwa [AlgebraicGeometry.Scheme.Hom.appLE_eq_app ν] at h1
    rw [h_fromSpec, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hiso_ΓU₂]

  
  
  
  let U'' : AlgebraicGeometry.Scheme.{u} := S''
  let π' : U'' ⟶ (ν ⁻¹ᵁ U₂).toScheme := π_aff ≫ e_U'₂.hom
  let actG : I_G → (U'' ⟶ U'') := actG_aff
  let secS : S_idx → (U'' ⟶ (ν ⁻¹ᵁ U₂).toScheme) := fun ι => secS_aff ι ≫ e_U'₂.hom
  let actH : H → (U'' ⟶ U'') := actH_aff

  have hν_res_eq : ν ∣_ U₂ = e_U'₂.inv ≫ f_aff ≫ hU₂_aff.isoSpec.inv := by
    rw [← he_U', Iso.inv_hom_id_assoc]
  have hFin_νU₂ : AlgebraicGeometry.IsFinite (ν ∣_ U₂) := by
    rw [hν_res_eq]
    haveI : AlgebraicGeometry.IsFinite f_aff := hFin_faff
    infer_instance
  have hEt_νU₂ : AlgebraicGeometry.Etale (ν ∣_ U₂) := by
    rw [hν_res_eq]
    haveI : AlgebraicGeometry.Etale f_aff := hEt_faff
    infer_instance
  have hSurj_νU₂ : AlgebraicGeometry.Surjective (ν ∣_ U₂) := by
    rw [hν_res_eq]
    haveI : AlgebraicGeometry.Surjective f_aff := hSurj_faff
    infer_instance
  have hEt_π' : AlgebraicGeometry.Etale π' := by
    dsimp only [π']
    haveI : AlgebraicGeometry.Etale π_aff := hEt_πaff
    infer_instance
  have hSurj_π' : AlgebraicGeometry.Surjective π' := by
    dsimp only [π']
    haveI : AlgebraicGeometry.Surjective π_aff := hSurj_πaff
    infer_instance
  have hπ'_ν_eq : π' ≫ (ν ∣_ U₂) = (π_aff ≫ f_aff) ≫ hU₂_aff.isoSpec.inv := by
    dsimp only [π']
    rw [Category.assoc, he_U', Category.assoc]

  have hSec : ∀ ι : S_idx, secS ι ≫ (ν ∣_ U₂) = π' ≫ (ν ∣_ U₂) := by
    intro ι
    dsimp only [secS]
    rw [Category.assoc, he_U', ← Category.assoc, hSec_aff ι, hπ'_ν_eq]
  have hPerm : ∀ g : I_G, ∃ σ_perm : Equiv.Perm S_idx,
      ∀ ι : S_idx, actG g ≫ secS ι = secS (σ_perm ι) := by
    intro g
    obtain ⟨σ_perm, hσ⟩ := hPerm_aff g
    exact ⟨σ_perm, fun ι => by dsimp only [actG, secS]; rw [← Category.assoc, hσ ι]⟩
  have hActH_hom : ∀ τ : H, actH τ ≫ π' = π' := by
    intro τ
    dsimp only [actH, π']
    rw [← Category.assoc, hActH_hom_aff τ]

  
  have hPullbackTransport :
      ∀ {I_idx : Type u} {B B' : AlgebraicGeometry.Scheme.{u}}
        (p : U'' ⟶ B) (p' : U'' ⟶ B') (e : B ≅ B')
        (_ : p ≫ e.hom = p')
        (a : I_idx → (U'' ⟶ U''))
        (γ₀ : I_idx → (U'' ⟶ CategoryTheory.Limits.pullback p p))
        (_ : ∀ i, γ₀ i ≫ CategoryTheory.Limits.pullback.fst p p = a i)
        (_ : ∀ i, γ₀ i ≫ CategoryTheory.Limits.pullback.snd p p =
          CategoryTheory.CategoryStruct.id U'')
        (_ : (⋃ i : I_idx, Set.range (γ₀ i).base) = Set.univ),
        ∃ (γ : I_idx → (U'' ⟶ CategoryTheory.Limits.pullback p' p')),
          (∀ i,
            γ i ≫ CategoryTheory.Limits.pullback.fst p' p' = a i ∧
            γ i ≫ CategoryTheory.Limits.pullback.snd p' p' =
              CategoryTheory.CategoryStruct.id U'') ∧
          (⋃ i : I_idx, Set.range (γ i).base) = Set.univ := by
    intro I_idx B B' p p' e hp' a γ₀ h_fst h_snd h_cov
    have hp_inv : p' ≫ e.inv = p := by rw [← hp', Category.assoc, e.hom_inv_id, Category.comp_id]
    let Φ : CategoryTheory.Limits.pullback p p ⟶ CategoryTheory.Limits.pullback p' p' :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst p p)
        (CategoryTheory.Limits.pullback.snd p p)
        (by
          have hc := congrArg (· ≫ e.hom) (CategoryTheory.Limits.pullback.condition (f := p) (g := p))
          simpa only [Category.assoc, hp'] using hc)
    let Ψ : CategoryTheory.Limits.pullback p' p' ⟶ CategoryTheory.Limits.pullback p p :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst p' p')
        (CategoryTheory.Limits.pullback.snd p' p')
        (by
          have hc := congrArg (· ≫ e.inv) (CategoryTheory.Limits.pullback.condition (f := p') (g := p'))
          simpa only [Category.assoc, hp_inv] using hc)
    have hΨΦ : Ψ ≫ Φ = 𝟙 (CategoryTheory.Limits.pullback p' p') := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst, Category.id_comp]
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd, Category.id_comp]
    refine ⟨fun i => γ₀ i ≫ Φ, ⟨fun i => ⟨?_, ?_⟩, ?_⟩⟩
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, h_fst i]
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, h_snd i]
    · ext w
      refine ⟨fun _ => Set.mem_univ w, fun _ => ?_⟩
      have hw_mem : Ψ.base w ∈ ⋃ i : I_idx, Set.range (γ₀ i).base := by
        rw [h_cov]; exact Set.mem_univ _
      obtain ⟨i, u, hu⟩ := Set.mem_iUnion.mp hw_mem
      refine Set.mem_iUnion.mpr ⟨i, u, ?_⟩
      calc (γ₀ i ≫ Φ).base u
        _ = Φ.base ((γ₀ i).base u) := rfl
        _ = Φ.base (Ψ.base w) := by rw [hu]
        _ = (Ψ ≫ Φ).base w := rfl
        _ = w := by rw [hΨΦ]; rfl

  obtain ⟨γ_G, hγG, hCovG⟩ := hPullbackTransport (π_aff ≫ f_aff) (π' ≫ (ν ∣_ U₂))
    hU₂_aff.isoSpec.symm hπ'_ν_eq.symm actG γ_G_aff
    (fun g => CategoryTheory.Limits.pullback.lift_fst _ _ _)
    (fun g => CategoryTheory.Limits.pullback.lift_snd _ _ _)
    hCovG_aff
  obtain ⟨γ_H, hγH, hCovH⟩ := hPullbackTransport π_aff π'
    e_U'₂ rfl actH γ_H_aff
    (fun τ => CategoryTheory.Limits.pullback.lift_fst _ _ _)
    (fun τ => CategoryTheory.Limits.pullback.lift_snd _ _ _)
    hCovH_aff

  
  have hρ₀_int : ∀ s : S₀, _root_.IsIntegral R₂ (ρ₀ s) := by
    intro s
    have hs_R₀ : _root_.IsIntegral R₀ s := Algebra.IsIntegral.isIntegral s
    have h_comm_ρ : (algebraMap R₀ L_gal) = ρ₀.comp (algebraMap R₀ S₀) :=
      RingHom.ext (fun r => (hρ₀_comm r).symm)
    have hs_L_R₀ : _root_.IsIntegral R₀ (ρ₀ s) :=
      _root_.IsIntegral.map_of_comp_eq (RingHom.id R₀) ρ₀
        (by rw [RingHom.comp_id]; exact h_comm_ρ) hs_R₀
    exact _root_.IsIntegral.tower_top (R := R₀) (A := R₂) hs_L_R₀
  let ρ_tilde : S₀ →+* R'' :=
    { toFun := fun s => ⟨ρ₀ s, hρ₀_int s⟩
      map_one' := Subtype.ext (map_one ρ₀)
      map_mul' := fun x y => Subtype.ext (map_mul ρ₀ x y)
      map_zero' := Subtype.ext (map_zero ρ₀)
      map_add' := fun x y => Subtype.ext (map_add ρ₀ x y) }
  have hρ_tilde_comm : φ₀_hom ≫ CommRingCat.ofHom ρ_tilde =
      Y₀.presheaf.map (homOfLE (Y₀.basicOpen_le f)).op ≫
        CommRingCat.ofHom (algebraMap R₂ R'') := by
    apply CommRingCat.Hom.ext
    ext r
    change ρ₀ (φ₀ r) = algebraMap R'' L_gal (algebraMap R₂ R'' (algebraMap R₀ R₂ r))
    rw [← IsScalarTower.algebraMap_apply R₂ R'' L_gal, hρ₀_comm r,
      IsScalarTower.algebraMap_apply R₀ R₂ K r]
    rfl
  let q₀ : U'' ⟶ V₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_tilde) ≫ v_aff
  have hComm : (π' ≫ (ν ∣_ U₂)) ≫ U₂.ι = q₀ ≫ p₀ ≫ U₀.ι := by
    rw [hπ'_ν_eq, Category.assoc, hU₂_aff.isoSpec_inv_ι, h_πf_aff,
      ← hU_aff.map_fromSpec hU₂_aff (homOfLE (Y₀.basicOpen_le f)).op,
      ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← hρ_tilde_comm,
      AlgebraicGeometry.Spec.map_comp, Category.assoc, hComm_aff]
    dsimp only [q₀]
    rw [Category.assoc]

  exact ⟨U₂, hU₂_ne, Y', U'', ν, π', q₀, I_G, S_idx, H,
    inferInstance, inferInstance, inferInstance, inferInstance,
    actG, secS, γ_G, actH, γ_H,
    hInt_Y', hFin_ν, hFin_νU₂, hEt_νU₂, hSurj_νU₂, hInt_S'', hEt_π', hSurj_π',
    hComm, hCoprime, hPGrp, hSec, hPerm, hγG, hCovG,
    hActH_hom, hActH_one, hActH_mul, hγH, hCovH⟩

theorem weil_etale_sylow_trace_retract_and_pgroup_filtration (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (U₂ U' U'' : AlgebraicGeometry.Scheme.{u})
    (f_U : U' ⟶ U₂) (π' : U'' ⟶ U')
    (hEt_f : AlgebraicGeometry.Etale f_U)
    (hSurj_f : AlgebraicGeometry.Surjective f_U)
    (hInt_U'' : AlgebraicGeometry.IsIntegral U'')
    (hEt_π' : AlgebraicGeometry.Etale π')
    (hSurj_π' : AlgebraicGeometry.Surjective π')
    (I_G S_idx H : Type u)
    [Fintype I_G] [Fintype S_idx] [Group H] [Fintype H]
    (hCoprime : ¬ (ℓ ∣ Fintype.card S_idx))
    (hPGrp : IsPGroup ℓ H)
    (actG : I_G → (U'' ⟶ U''))
    (secS : S_idx → (U'' ⟶ U'))
    (γ_G : I_G → (U'' ⟶ CategoryTheory.Limits.pullback (π' ≫ f_U) (π' ≫ f_U)))
    (hSec : ∀ ι : S_idx, secS ι ≫ f_U = π' ≫ f_U)
    (hPerm : ∀ g : I_G, ∃ σ_perm : Equiv.Perm S_idx, ∀ ι : S_idx, actG g ≫ secS ι = secS (σ_perm ι))
    (hγG : ∀ g : I_G,
      γ_G g ≫ CategoryTheory.Limits.pullback.fst (π' ≫ f_U) (π' ≫ f_U) = actG g ∧
      γ_G g ≫ CategoryTheory.Limits.pullback.snd (π' ≫ f_U) (π' ≫ f_U) =
        CategoryTheory.CategoryStruct.id U'')
    (hCovG : (⋃ g : I_G, Set.range (γ_G g).base) = Set.univ)
    (actH : H → (U'' ⟶ U''))
    (γ_H : H → (U'' ⟶ CategoryTheory.Limits.pullback π' π'))
    (hActH_hom : ∀ τ : H, actH τ ≫ π' = π')
    (hActH_one : actH 1 = CategoryTheory.CategoryStruct.id U'')
    (hActH_mul : ∀ τ₁ τ₂ : H, actH (τ₁ * τ₂) = actH τ₁ ≫ actH τ₂)
    (hγH : ∀ τ : H,
      γ_H τ ≫ CategoryTheory.Limits.pullback.fst π' π' = actH τ ∧
      γ_H τ ≫ CategoryTheory.Limits.pullback.snd π' π' =
        CategoryTheory.CategoryStruct.id U'')
    (hCovH : (⋃ τ : H, Set.range (γ_H τ).base) = Set.univ)
    (A : AddCommGrpCat.{u}) (hFinA : Finite A)
    (hTorA : ℓ • CategoryTheory.CategoryStruct.id A = 0)
    (ℒ : CategoryTheory.Sheaf U₂.smallEtaleTopology AddCommGrpCat.{u})
    (hTorL : ℓ • CategoryTheory.CategoryStruct.id ℒ = 0)
    (hTriv : WeilIsEtaleSheafPullback (π' ≫ f_U) ℒ
      ((CategoryTheory.constantSheaf U''.smallEtaleTopology AddCommGrpCat.{u}).obj A)) :
    ∃ (ℳ : CategoryTheory.Sheaf U'.smallEtaleTopology AddCommGrpCat.{u})
      (m : ℕ)
      (𝒩 : Fin (m + 1) → CategoryTheory.Sheaf U'.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback f_U ℒ ℳ ∧
      (∃ (i_L : ℒ ⟶ weilEtaleHigherDirectImage f_U 0 ℳ)
         (r_L : weilEtaleHigherDirectImage f_U 0 ℳ ⟶ ℒ),
        i_L ≫ r_L = 𝟙 ℒ) ∧
      CategoryTheory.Limits.IsZero (𝒩 0) ∧
      Nonempty (CategoryTheory.Iso (𝒩 (Fin.last m)) ℳ) ∧
      (∀ r : Fin m, ∃ (S_r : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf U'.smallEtaleTopology AddCommGrpCat.{u})),
        S_r.ShortExact ∧ S_r.X₁ = 𝒩 r.castSucc ∧ S_r.X₂ = 𝒩 r.succ ∧
        S_r.X₃ = weilEtaleTorsionSheaf U' ℓ) :=
by
  classical
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_two : 2 ≤ ℓ := hPrime.two_le
  have hℓ_one : 1 < ℓ := hPrime.one_lt
  haveI : Fact (1 < ℓ) := ⟨hℓ_one⟩

  
  
  
  have h_etale_hom : ∀ {S : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : S.Etale} (f : U₁ ⟶ U₂),
      AlgebraicGeometry.Etale f.left := by
    intro S U₁ U₂ f
    have hfw : f.left ≫ U₂.hom = U₁.hom := CategoryTheory.MorphismProperty.Over.w f
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      f.left U₂.hom U₂.prop (hfw.symm ▸ U₁.prop)

  have h_etale_term : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom) trivial) ?_
    intro U m
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)

  have h_mem_etale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl P_et)
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      P_et P_et S CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  have h_sheaf_type : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Presieve.IsSheaf S.smallEtaleTopology
        (ℱ.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) := by
    intro S ℱ
    exact (CategoryTheory.isSheaf_iff_isSheaf_of_type S.smallEtaleTopology _).mp
      (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf S.smallEtaleTopology ℱ.obj
        (CategoryTheory.forget AddCommGrpCat.{u}) ℱ.property)

  have h_arrows_sheafFor : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (W : S.Etale) {ι : Type u} (Y : ι → S.Etale) (f : ∀ i, Y i ⟶ W),
      (∀ x : ↥W.left, ∃ (i : ι) (y : ↥(Y i).left), (f i).left.base y = x) →
      CategoryTheory.Presieve.IsSheafFor
        (ℱ.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
        (CategoryTheory.Presieve.ofArrows Y f) := by
    intro S ℱ W ι Y f hsurj
    have hcov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Y f) ∈
        S.smallEtaleTopology W := by
      refine (h_mem_etale S W _).mpr fun x => ?_
      obtain ⟨i, y, hy⟩ := hsurj x
      exact ⟨Y i, f i, y,
        ⟨Y i, 𝟙 (Y i), f i, CategoryTheory.Presieve.ofArrows.mk i,
          CategoryTheory.Category.id_comp _⟩,
        h_etale_hom (f i), hy⟩
    exact (CategoryTheory.Presieve.isSheafFor_iff_generate _).mpr
      (h_sheaf_type ℱ _ hcov)

  have h_arrows_sep : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (W : S.Etale) {ι : Type u} (Y : ι → S.Etale) (f : ∀ i, Y i ⟶ W),
      (∀ x : ↥W.left, ∃ (i : ι) (y : ↥(Y i).left), (f i).left.base y = x) →
      ∀ (a b : ↥(ℱ.obj.obj (Opposite.op W))),
        (∀ i : ι, ℱ.obj.map (f i).op a = ℱ.obj.map (f i).op b) → a = b := by
    intro S ℱ W ι Y f hsurj a b heq
    have hsh := (CategoryTheory.Presieve.isSheafFor_arrows_iff _ _).mp
      (h_arrows_sheafFor ℱ W Y f hsurj)
    obtain ⟨_, _, huniq⟩ := hsh (fun i => ℱ.obj.map (f i).op a)
      (fun i₁ i₂ Z g₁ g₂ hgg => by
        have hm : ℱ.obj.map (f i₁).op ≫ ℱ.obj.map g₁.op =
            ℱ.obj.map (f i₂).op ≫ ℱ.obj.map g₂.op := by
          rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp, ← op_comp, ← op_comp, hgg]
        exact congrArg (fun φ => φ a) hm)
    exact (huniq a (fun _ => rfl)).trans (huniq b (fun i => (heq i).symm)).symm

  have h_singleton_descent : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      {Y W : S.Etale} (f : Y ⟶ W),
      AlgebraicGeometry.Surjective f.left →
      ∀ (x : ↥(ℱ.obj.obj (Opposite.op Y))),
        (∀ {Z : S.Etale} (p₁ p₂ : Z ⟶ Y),
          p₁ ≫ f = p₂ ≫ f → ℱ.obj.map p₁.op x = ℱ.obj.map p₂.op x) →
        ∃! y : ↥(ℱ.obj.obj (Opposite.op W)), ℱ.obj.map f.op y = x := by
    intro S ℱ Y W f hSurj x hEq
    have hcov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton f) ∈
        S.smallEtaleTopology W := by
      refine (h_mem_etale S W _).mpr fun w => ?_
      obtain ⟨y, hy⟩ := f.left.surjective w
      exact ⟨Y, f, y,
        ⟨Y, 𝟙 Y, f, CategoryTheory.Presieve.singleton.mk, CategoryTheory.Category.id_comp f⟩,
        h_etale_hom f, hy⟩
    have hsh : CategoryTheory.Presieve.IsSheafFor
        (ℱ.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
        (CategoryTheory.Presieve.singleton f) :=
      (CategoryTheory.Presieve.isSheafFor_iff_generate _).mpr (h_sheaf_type ℱ _ hcov)
    exact (CategoryTheory.Presieve.isSheafFor_singleton.mp hsh) x hEq

  
  
  
  have hF_cont : ∀ {Y S : AlgebraicGeometry.Scheme.{u}} {j : Y ⟶ S}
      (hj : AlgebraicGeometry.Etale j),
      let F_j : CategoryTheory.Functor Y.Etale S.Etale :=
        CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hj
      F_j.IsContinuous Y.smallEtaleTopology S.smallEtaleTopology := by
    intro Y S j hj
    let F_j : CategoryTheory.Functor Y.Etale S.Etale :=
      CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hj
    have hCompat : CategoryTheory.CompatiblePreserving S.smallEtaleTopology F_j := by
      refine ⟨fun ℱ {Z} {T} {x} hx {Y₁ Y₂} {W} g₁ g₂ {f₁ f₂} hf₁ hf₂ h => ?_⟩
      have hg₁_w : g₁.left ≫ (Y₁.hom ≫ j) = W.hom := CategoryTheory.MorphismProperty.Over.w g₁
      have hg₂_w : g₂.left ≫ (Y₂.hom ≫ j) = W.hom := CategoryTheory.MorphismProperty.Over.w g₂
      have hf₁_w : f₁.left ≫ Z.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w f₁
      have hf₂_w : f₂.left ≫ Z.hom = Y₂.hom := CategoryTheory.MorphismProperty.Over.w f₂
      have h_left : g₁.left ≫ f₁.left = g₂.left ≫ f₂.left :=
        congrArg (fun m => m.left) h
      have hEt_Y₁j : AlgebraicGeometry.Etale (Y₁.hom ≫ j) :=
        CategoryTheory.MorphismProperty.comp_mem P_et Y₁.hom j Y₁.prop hj
      have hEt_g₁ : AlgebraicGeometry.Etale g₁.left :=
        CategoryTheory.MorphismProperty.of_postcomp P_et g₁.left (Y₁.hom ≫ j) hEt_Y₁j
          (hg₁_w.symm ▸ W.prop)
      have hEt_Wtilde : AlgebraicGeometry.Etale (g₁.left ≫ Y₁.hom) :=
        CategoryTheory.MorphismProperty.comp_mem P_et g₁.left Y₁.hom hEt_g₁ Y₁.prop
      let W_tilde : Y.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (g₁.left ≫ Y₁.hom) hEt_Wtilde
      have hg₂_Y₂ : g₂.left ≫ Y₂.hom = W_tilde.hom :=
        (congrArg (g₂.left ≫ ·) hf₂_w.symm).trans
          ((CategoryTheory.Category.assoc g₂.left f₂.left Z.hom).symm.trans
            ((congrArg (· ≫ Z.hom) h_left.symm).trans
              ((CategoryTheory.Category.assoc g₁.left f₁.left Z.hom).trans
                (congrArg (g₁.left ≫ ·) hf₁_w))))
      let g1_et : W_tilde ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk g₁.left rfl
      let g2_et : W_tilde ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk g₂.left hg₂_Y₂
      have h_tilde : g1_et ≫ f₁ = g2_et ≫ f₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext h_left
      have he_w : CategoryTheory.CategoryStruct.id W.left ≫ (F_j.obj W_tilde).hom = W.hom :=
        (CategoryTheory.Category.id_comp ((g₁.left ≫ Y₁.hom) ≫ j)).trans
          ((CategoryTheory.Category.assoc g₁.left Y₁.hom j).trans hg₁_w)
      let e_W : W ⟶ F_j.obj W_tilde :=
        CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id W.left) he_w
      have he₁ : e_W ≫ F_j.map g1_et = g₁ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp g₁.left)
      have he₂ : e_W ≫ F_j.map g2_et = g₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp g₂.left)
      have hx_eq := hx g1_et g2_et hf₁ hf₂ h_tilde
      have hmap₁ : ℱ.obj.map g₁.op = ℱ.obj.map (F_j.map g1_et).op ≫ ℱ.obj.map e_W.op := by
        rw [← he₁, op_comp, ℱ.obj.map_comp]
      have hmap₂ : ℱ.obj.map g₂.op = ℱ.obj.map (F_j.map g2_et).op ≫ ℱ.obj.map e_W.op := by
        rw [← he₂, op_comp, ℱ.obj.map_comp]
      change ℱ.obj.map g₁.op (x f₁ hf₁) = ℱ.obj.map g₂.op (x f₂ hf₂)
      rw [hmap₁, hmap₂]
      exact congrArg (ℱ.obj.map e_W.op) hx_eq
    have hCover : CategoryTheory.CoverPreserving
        Y.smallEtaleTopology S.smallEtaleTopology F_j := by
      constructor
      intro Z R hR
      have hR' := (h_mem_etale Y Z R).mp hR
      refine (h_mem_etale S (F_j.obj Z) _).mpr fun x => ?_
      obtain ⟨Z', u, z', huR, huEt, hz'⟩ := hR' x
      refine ⟨F_j.obj Z', F_j.map u, z', ?_, huEt, hz'⟩
      exact ⟨Z', u, 𝟙 (F_j.obj Z'), huR, (CategoryTheory.Category.id_comp _).symm⟩
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCover

  have hSiteCont : ∀ {Y S : AlgebraicGeometry.Scheme.{u}} (j : Y ⟶ S)
      (_ : AlgebraicGeometry.Etale j),
      let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) j :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) j :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_j : CategoryTheory.Functor S.Etale Y.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ j
      B_j.IsContinuous S.smallEtaleTopology Y.smallEtaleTopology := by
    intro Y S j hj
    let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) j :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) j :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let F_j : CategoryTheory.Functor Y.Etale S.Etale :=
      CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hj
    let B_j : CategoryTheory.Functor S.Etale Y.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ j
    let adj₀ : F_j ⊣ B_j :=
      CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_et ⊤ j hj trivial
    have hCompat : CategoryTheory.CompatiblePreserving Y.smallEtaleTopology B_j := by
      refine ⟨fun ℱ {Z} {T} {x} hx {Y₁ Y₂} {W} g₁ g₂ {f₁ f₂} hf₁ hf₂ h => ?_⟩
      let g₁' : F_j.obj W ⟶ Y₁ := (adj₀.homEquiv W Y₁).symm g₁
      let g₂' : F_j.obj W ⟶ Y₂ := (adj₀.homEquiv W Y₂).symm g₂
      have hg₁' : adj₀.unit.app W ≫ B_j.map g₁' = g₁ :=
        (adj₀.homEquiv_unit W Y₁ g₁').symm.trans ((adj₀.homEquiv W Y₁).apply_symm_apply g₁)
      have hg₂' : adj₀.unit.app W ≫ B_j.map g₂' = g₂ :=
        (adj₀.homEquiv_unit W Y₂ g₂').symm.trans ((adj₀.homEquiv W Y₂).apply_symm_apply g₂)
      have h_eq' : g₁' ≫ f₁ = g₂' ≫ f₂ := by
        apply (adj₀.homEquiv W Z).injective
        rw [adj₀.homEquiv_unit, adj₀.homEquiv_unit, B_j.map_comp, B_j.map_comp,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hg₁', hg₂', h]
      have hx_eq := hx g₁' g₂' hf₁ hf₂ h_eq'
      have hmap₁ : ℱ.obj.map g₁.op =
          ℱ.obj.map (B_j.map g₁').op ≫ ℱ.obj.map (adj₀.unit.app W).op := by
        rw [← hg₁', op_comp, ℱ.obj.map_comp]
      have hmap₂ : ℱ.obj.map g₂.op =
          ℱ.obj.map (B_j.map g₂').op ≫ ℱ.obj.map (adj₀.unit.app W).op := by
        rw [← hg₂', op_comp, ℱ.obj.map_comp]
      change ℱ.obj.map g₁.op (x f₁ hf₁) = ℱ.obj.map g₂.op (x f₂ hf₂)
      rw [hmap₁, hmap₂]
      exact congrArg (ℱ.obj.map (adj₀.unit.app W).op) hx_eq
    have hCover : CategoryTheory.CoverPreserving
        S.smallEtaleTopology Y.smallEtaleTopology B_j := by
      constructor
      intro Z R hR
      have hR' := (h_mem_etale S Z R).mp hR
      refine (h_mem_etale Y (B_j.obj Z) _).mpr fun x => ?_
      let fst_Z : (B_j.obj Z).left ⟶ Z.left := CategoryTheory.Limits.pullback.fst Z.hom j
      obtain ⟨V, f, v, hfR, hfEt, hfv⟩ := hR' (fst_Z.base x)
      let fst_V : (B_j.obj V).left ⟶ V.left := CategoryTheory.Limits.pullback.fst V.hom j
      have h_bot : CategoryTheory.IsPullback (B_j.obj Z).hom fst_Z j Z.hom :=
        (CategoryTheory.IsPullback.of_hasPullback Z.hom j).flip
      have h_tot : CategoryTheory.IsPullback (B_j.obj V).hom fst_V j V.hom :=
        (CategoryTheory.IsPullback.of_hasPullback V.hom j).flip
      have h_sq_w : (B_j.map f).left ≫ fst_Z = fst_V ≫ f.left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h_paste : CategoryTheory.IsPullback (B_j.map f).left fst_V fst_Z f.left := by
        refine CategoryTheory.IsPullback.of_right ?_ h_sq_w h_bot
        have h_hom : (B_j.map f).left ≫ (B_j.obj Z).hom = (B_j.obj V).hom :=
          CategoryTheory.MorphismProperty.Over.w (B_j.map f)
        have h_fw : f.left ≫ Z.hom = V.hom :=
          CategoryTheory.MorphismProperty.Over.w f
        simpa only [h_hom, h_fw] using h_tot
      let e_pb := h_paste.isoPullback
      obtain ⟨p, hp₁, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x v hfv.symm
      have heq_fst : e_pb.inv ≫ (B_j.map f).left =
          CategoryTheory.Limits.pullback.fst fst_Z f.left := by
        rw [CategoryTheory.Iso.inv_comp_eq]
        exact (CategoryTheory.IsPullback.isoPullback_hom_fst h_paste).symm
      have hEt_map : AlgebraicGeometry.Etale (B_j.map f).left :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback h_paste.flip hfEt
      refine ⟨B_j.obj V, B_j.map f, e_pb.inv.base p, ?_, hEt_map, ?_⟩
      · exact ⟨V, f, 𝟙 (B_j.obj V), hfR, (CategoryTheory.Category.id_comp _).symm⟩
      · calc
          (B_j.map f).left.base (e_pb.inv.base p) = (e_pb.inv ≫ (B_j.map f).left).base p := rfl
          _ = (CategoryTheory.Limits.pullback.fst fst_Z f.left).base p := by rw [heq_fst]
          _ = x := hp₁
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCover

  
  let mkEtaleSheafAdj : ∀ {Y S : AlgebraicGeometry.Scheme.{u}} (j : Y ⟶ S)
      (hj : AlgebraicGeometry.Etale j),
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) j :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) j :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let F_j : CategoryTheory.Functor Y.Etale S.Etale :=
        CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hj
      let B_j : CategoryTheory.Functor S.Etale Y.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ j
      letI : F_j.IsContinuous Y.smallEtaleTopology S.smallEtaleTopology := hF_cont hj
      letI : B_j.IsContinuous S.smallEtaleTopology Y.smallEtaleTopology := hSiteCont j hj
      (F_j.sheafPushforwardContinuous AddCommGrpCat.{u} Y.smallEtaleTopology S.smallEtaleTopology) ⊣
        (B_j.sheafPushforwardContinuous AddCommGrpCat.{u}
          S.smallEtaleTopology Y.smallEtaleTopology) := by
    intro Y S j hj
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) j :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) j :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let F_j : CategoryTheory.Functor Y.Etale S.Etale :=
      CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hj
    let B_j : CategoryTheory.Functor S.Etale Y.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ j
    letI : F_j.IsContinuous Y.smallEtaleTopology S.smallEtaleTopology := hF_cont hj
    letI : B_j.IsContinuous S.smallEtaleTopology Y.smallEtaleTopology := hSiteCont j hj
    let adj₀ : F_j ⊣ B_j :=
      CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_et ⊤ j hj trivial
    let L_j := F_j.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y.smallEtaleTopology S.smallEtaleTopology
    let R_j := B_j.sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology Y.smallEtaleTopology
    let η_sh : CategoryTheory.Functor.id _ ⟶ L_j ⋙ R_j :=
      { app := fun ℱ =>
          { hom :=
              { app := fun W => ℱ.obj.map (adj₀.counit.app W.unop).op
                naturality := fun {W₁ W₂} f => by
                  dsimp [L_j, R_j, CategoryTheory.Functor.sheafPushforwardContinuous]
                  rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
                  exact congrArg ℱ.obj.map
                    (congrArg Opposite.op (adj₀.counit.naturality f.unop)).symm } }
        naturality := fun {ℱ₁ ℱ₂} φ => by
          apply CategoryTheory.Sheaf.hom_ext
          ext W : 2
          exact (φ.hom.naturality (adj₀.counit.app W.unop).op).symm }
    let ε_sh : R_j ⋙ L_j ⟶ CategoryTheory.Functor.id _ :=
      { app := fun 𝒢 =>
          { hom :=
              { app := fun W' => 𝒢.obj.map (adj₀.unit.app W'.unop).op
                naturality := fun {W'₁ W'₂} f => by
                  dsimp [L_j, R_j, CategoryTheory.Functor.sheafPushforwardContinuous]
                  rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp]
                  exact congrArg 𝒢.obj.map
                    (congrArg Opposite.op (adj₀.unit.naturality f.unop)).symm } }
        naturality := fun {𝒢₁ 𝒢₂} ψ => by
