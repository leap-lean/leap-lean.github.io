            ((congrArg q_R (map_mul (Polynomial.aeval x) v₀ G)).trans (q_R.map_mul _ _))))
      have h2 : q_R (Polynomial.aeval x v₀) = Polynomial.eval₂ ι_k e_bar v_bar := by
        refine (hq_aeval_map v₀).trans ?_
        dsimp [v₀]
        rw [Polynomial.map_map, hcomp_id, Polynomial.map_id]
      have h3 : q_R (Polynomial.aeval x G) = Polynomial.eval₂ ι_k e_bar G₀ := by
        refine (hq_aeval_map G).trans ?_
        rw [hG_res]
