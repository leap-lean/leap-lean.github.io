    have _ : Mono (SC.map π_push).f := Limits.mono_of_isLimit_fork hk'
    have _ : Epi (SC.map π_push).g := hEpi SC.g
    exact { exact := ShortComplex.exact_of_f_is_kernel (SC.map π_push) hk' }

  have hInj_push : ∀ (I : Sheaf Y.smallEtaleTopology A),
      CategoryTheory.Injective I → CategoryTheory.Injective (π_push.obj I) := by
    intro I hI
    have _ : Limits.PreservesFiniteLimits B_π := (hSitePullback π).1
    let T_X : X.Etale := MorphismProperty.Over.mk ⊤ (𝟙 X) (MorphismProperty.id_mem P_et X)
    have hTerm_TX : Limits.IsTerminal T_X :=
      Limits.IsTerminal.ofUniqueHom
        (fun U => MorphismProperty.Over.homMk U.hom (Category.comp_id U.hom) trivial)
        (fun U m => MorphismProperty.Over.Hom.ext
          ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
    let I₀ : Type u := SmallModel.{u} X.AffineEtale
    let e₀ := equivSmallModel.{u} X.AffineEtale
    let ι_aff := Scheme.AffineEtale.Spec X
    let StagePkg : ℕ → Σ (S₀ : Type u), S₀ → X.Etale :=
      Nat.rec
        ⟨ULift.{u} Unit ⊕ I₀,
          Sum.elim (fun _ => T_X) (fun i => ι_aff.obj (e₀.inverse.obj i))⟩
        (fun _ prev =>
          ⟨prev.1 ⊕ (Σ (a b c : prev.1) (_ : prev.2 a ⟶ prev.2 c), (prev.2 b ⟶ prev.2 c)),
            Sum.elim prev.2 (fun p => Limits.pullback p.2.2.2.1 p.2.2.2.2)⟩)
    have hLift : ∀ {m n : ℕ}, m ≤ n → ∀ s : (StagePkg m).1,
        ∃ s' : (StagePkg n).1, (StagePkg n).2 s' = (StagePkg m).2 s := by
      intro m n hmn s
      induction n with
      | zero =>
        obtain rfl : m = 0 := Nat.eq_zero_of_le_zero hmn
        exact ⟨s, rfl⟩
      | succ n' ih =>
        rcases Nat.eq_or_lt_of_le hmn with rfl | hLt
        · exact ⟨s, rfl⟩
        · obtain ⟨s', hs'⟩ := ih (Nat.lt_succ_iff.mp hLt)
          exact ⟨Sum.inl s', hs'⟩
    let D₀ : Type u := Σ n : ℕ, (StagePkg n).1
    let eval : D₀ → X.Etale := fun d => (StagePkg d.1).2 d.2
    let D : Type u := InducedCategory X.Etale eval
    let G : D ⥤ X.Etale := inducedFunctor eval
    let t₀ : D := ⟨0, Sum.inl ⟨()⟩⟩
    have hTerm_t0 : Limits.IsTerminal t₀ :=
      Limits.IsTerminal.ofUniqueHom
        (fun d => InducedCategory.homMk (hTerm_TX.from (G.obj d)))
        (fun d m => InducedCategory.hom_ext (hTerm_TX.hom_ext _ _))
    have _ : Limits.HasTerminal D := hTerm_t0.hasTerminal
    have _ : Limits.PreservesLimit (Functor.empty D) G :=
      Limits.preservesTerminal_of_iso G
        (G.mapIso (Limits.terminalIsoIsTerminal hTerm_t0) ≪≫
          (Limits.terminalIsoIsTerminal hTerm_TX).symm)
    have _ : Limits.PreservesLimitsOfShape (Discrete PEmpty.{1}) G :=
      Limits.preservesLimitsOfShape_pempty_of_preservesTerminal G
    have hCospan : ∀ {d₁ d₂ d₃ : D} (u₁ : d₁ ⟶ d₃) (u₂ : d₂ ⟶ d₃),
        ∃ (c : Limits.PullbackCone u₁ u₂),
          Nonempty (Limits.IsLimit c) ∧ Nonempty (Limits.IsLimit (G.mapCone c)) := by
      intro d₁ d₂ d₃ u₁ u₂
      let N : ℕ := max d₁.1 (max d₂.1 d₃.1)
      have h1 : d₁.1 ≤ N := le_max_left _ _
      have h2 : d₂.1 ≤ N := le_trans (le_max_left _ _) (le_max_right _ _)
      have h3 : d₃.1 ≤ N := le_trans (le_max_right _ _) (le_max_right _ _)
      obtain ⟨s₁, hs₁⟩ := hLift h1 d₁.2
      obtain ⟨s₂, hs₂⟩ := hLift h2 d₂.2
      obtain ⟨s₃, hs₃⟩ := hLift h3 d₃.2
      let e₁ : (StagePkg N).2 s₁ ≅ G.obj d₁ := eqToIso hs₁
      let e₂ : (StagePkg N).2 s₂ ≅ G.obj d₂ := eqToIso hs₂
      let e₃ : (StagePkg N).2 s₃ ≅ G.obj d₃ := eqToIso hs₃
      let f₁ : (StagePkg N).2 s₁ ⟶ (StagePkg N).2 s₃ := e₁.hom ≫ G.map u₁ ≫ e₃.inv
      let f₂ : (StagePkg N).2 s₂ ⟶ (StagePkg N).2 s₃ := e₂.hom ≫ G.map u₂ ≫ e₃.inv
      let p_pb : D := ⟨N + 1, Sum.inr ⟨s₁, s₂, s₃, f₁, f₂⟩⟩
      let fst_D : p_pb ⟶ d₁ := InducedCategory.homMk (Limits.pullback.fst f₁ f₂ ≫ e₁.hom)
      let snd_D : p_pb ⟶ d₂ := InducedCategory.homMk (Limits.pullback.snd f₁ f₂ ≫ e₂.hom)
      have hcomm_G : G.map fst_D ≫ G.map u₁ = G.map snd_D ≫ G.map u₂ := by
        change (Limits.pullback.fst f₁ f₂ ≫ e₁.hom) ≫ G.map u₁ =
          (Limits.pullback.snd f₁ f₂ ≫ e₂.hom) ≫ G.map u₂
        have hf₁ : e₁.hom ≫ G.map u₁ = f₁ ≫ e₃.hom := by simp [f₁]
        have hf₂ : e₂.hom ≫ G.map u₂ = f₂ ≫ e₃.hom := by simp [f₂]
        rw [Category.assoc, hf₁, ← Category.assoc, Limits.pullback.condition, Category.assoc, ← hf₂,
          Category.assoc]
      have hcomm_D : fst_D ≫ u₁ = snd_D ≫ u₂ := InducedCategory.hom_ext hcomm_G
      let c_D : Limits.PullbackCone u₁ u₂ := Limits.PullbackCone.mk fst_D snd_D hcomm_D
      have hPb_G : IsPullback (G.map fst_D) (G.map snd_D) (G.map u₁) (G.map u₂) := by
