            rw [map_mul]
            obtain ⟨x₁, hx₁⟩ := Ideal.Quotient.mk_surjective (ν_i z₁)
            obtain ⟨x₂, hx₂⟩ := Ideal.Quotient.mk_surjective (ν_i z₂)
            change Ideal.Quotient.mk J x₁ = ν_i z₁ at hx₁
            change Ideal.Quotient.mk J x₂ = ν_i z₂ at hx₂
            rw [← hx₁, ← hx₂]
            change lam_i (πJ x₁) * lam_i (πJ x₂) = lam_i (πJ (x₁ * x₂))
            rw [hlam_mk, hlam_mk, hlam_mk]
            calc
              (wb i * x₁) * (wb i * x₂) = (wb i * wb i) * (x₁ * x₂) := by ring
              _ = wb i * (x₁ * x₂) := by rw [h_idem i]
          · intro f
            change lam_i (ν_i (AdjoinRoot.mk (P i) f)) = wb i * Polynomial.aeval (ab i) f
            have hν_mk : ν_i (AdjoinRoot.mk (P i) f) = πJ (Polynomial.aeval (ab i) f) := by
              dsimp [ν_i]
              change Polynomial.aeval (πJ (ab i)) f = _
              exact Polynomial.aeval_algHom_apply πJ (ab i) f
            rw [hν_mk, hlam_mk]
        choose μ_i hμ_one hμ_mul hμ_mk using hex_comp
        have hμ_diff : ∀ i j : I, i ≠ j → ∀ (z₁ : AdjoinRoot (P i)) (z₂ : AdjoinRoot (P j)),
            μ_i i z₁ * μ_i j z₂ = 0 := by
          intro i j hij z₁ z₂
          obtain ⟨f₁, rfl⟩ := AdjoinRoot.mk_surjective z₁
          obtain ⟨f₂, rfl⟩ := AdjoinRoot.mk_surjective z₂
          rw [hμ_mk i f₁, hμ_mk j f₂]
          calc
            (wb i * Polynomial.aeval (ab i) f₁) * (wb j * Polynomial.aeval (ab j) f₂)
              = (wb i * wb j) * (Polynomial.aeval (ab i) f₁ * Polynomial.aeval (ab j) f₂) := by ring
            _ = 0 := by rw [h_orth i j hij, zero_mul]
        let σ : ((i : I) → AdjoinRoot (P i)) →ₐ[R_h] D :=
