      obtain ⟨e₀⟩ := hPullIsoOf z hPull₀
      refine CategoryTheory.Limits.IsZero.of_iso ?_ e₀.symm
      apply hCons (AlgebraicGeometry.Spec (CommRingCat.of Ω))
      intro Ω' _ _ w
      have hwz : Set.range (w ≫ z).base ⊆ K_set := by
        rintro _ ⟨q, rfl⟩
        exact hz ⟨w.base q, rfl⟩
      exact CategoryTheory.Limits.IsZero.of_iso
        (hSt Ω' (w ≫ z) hwz) ((e_fib z Ω' w).app G)
