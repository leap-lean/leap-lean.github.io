          _ = ψ (φ a) := rfl
          _ = ψ (φ b) := by rw [hab]
          _ = (φ ≫ ψ) b := rfl
          _ = b := by rw [hφψ]; rfl
      have hφ_bij : Function.Bijective φ := ⟨hφ_inj, Finite.surjective_of_injective hφ_inj⟩
      have : CategoryTheory.IsIso φ := (ConcreteCategory.isIso_iff_bijective φ).mpr hφ_bij
      have hα_eq : 𝒮_y.map α = φ ≫ (𝒮_y.mapIso β_pbc).inv := by
        change 𝒮_y.map α = 𝒮_y.map (α ≫ β_pbc.hom) ≫ 𝒮_y.map β_pbc.inv
        rw [← 𝒮_y.map_comp, CategoryTheory.Category.assoc,
          β_pbc.hom_inv_id, CategoryTheory.Category.comp_id]
      have : CategoryTheory.IsIso (𝒮_y.map α) := by
        rw [hα_eq]
        infer_instance
      have hnat_η : 𝒮_x.map η = (e_fib₁.app F).inv ≫ 𝒮_y.map α ≫ (e_fib₁.app F₃).hom := by
        have hn := e_fib₁.hom.naturality η
        change 𝒮_y.map α ≫ (e_fib₁.app F₃).hom = (e_fib₁.app F).hom ≫ 𝒮_x.map η at hn
        rw [hn, ← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
