def WeilGysinIsClopenPullbackOnLocalH {W₀ P₀ : AlgebraicGeometry.Scheme.{u}}
    (π : Quiver.Hom W₀ P₀)
    (U_W : W₀.Etale) (U_P : P₀.Etale)
    (e : CategoryTheory.Iso
      ((AlgebraicGeometry.Scheme.Etale.forget W₀).obj U_W).left
      ((AlgebraicGeometry.Scheme.Etale.forget P₀).obj U_P).left)
    (m q : ℕ)
    (z_P : weilGysinLocalTorsionH P₀ m U_P q)
    (z_W : weilGysinLocalTorsionH W₀ m U_W q) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) π :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) π :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget W₀
  let Fgt_P := AlgebraicGeometry.Scheme.Etale.forget P₀
  let B_π : CategoryTheory.Functor P₀.Etale W₀.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ π
  let J_W := W₀.smallEtaleTopology
  let J_P := P₀.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_W := (CategoryTheory.constantSheaf J_W AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_P := (CategoryTheory.constantSheaf J_P AddCommGrpCat.{u}).obj Aℤ
  let L_P := weilGysinLocalTorsionSheaf P₀ m U_P
  let L_W := weilGysinLocalTorsionSheaf W₀ m U_W
  CategoryTheory.CategoryStruct.comp ((Fgt_W.obj U_W).hom) π =
    CategoryTheory.CategoryStruct.comp e.hom ((Fgt_P.obj U_P).hom) ∧
  ∃ (hCont : B_π.IsContinuous J_P J_W),
    letI := hCont
    let pf_π := B_π.sheafPushforwardContinuous AddCommGrpCat.{u} J_P J_W
    ∃ (P_pull : CategoryTheory.Functor
        (CategoryTheory.Sheaf J_P AddCommGrpCat.{u})
        (CategoryTheory.Sheaf J_W AddCommGrpCat.{u}))
      (adj_π : CategoryTheory.Adjunction P_pull pf_π)
      (hAdd : P_pull.Additive)
      (hLim : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
      (hColim : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
      (T_W : W₀.Etale) (hT_W : CategoryTheory.Limits.IsTerminal T_W)
      (T_P : P₀.Etale) (hT_P : CategoryTheory.Limits.IsTerminal T_P)
      (ιℤ : Quiver.Hom Fℤ_W (P_pull.obj Fℤ_P))
      (σ_e : Quiver.Hom U_W (B_π.obj U_P))
      (α_π : Quiver.Hom L_P (pf_π.obj L_W)),
      letI := hAdd
      letI := hLim
      letI := hColim
      let adj_W := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT_W
      let adj_P := CategoryTheory.constantSheafAdj J_P AddCommGrpCat.{u} hT_P
      let τ_π : Quiver.Hom (B_π.obj T_P) T_W := hT_W.from (B_π.obj T_P)
      let πℤ : Quiver.Hom (P_pull.obj Fℤ_P) Fℤ_W :=
        (adj_π.homEquiv Fℤ_P Fℤ_W).symm
          ((adj_P.homEquiv Aℤ (pf_π.obj Fℤ_W)).symm
            (CategoryTheory.CategoryStruct.comp (adj_W.unit.app Aℤ)
              (Fℤ_W.obj.map (Opposite.op τ_π))))
      let p_fst : Quiver.Hom ((Fgt_W.obj (B_π.obj U_P)).left) ((Fgt_P.obj U_P).left) :=
        CategoryTheory.Limits.pullback.fst ((Fgt_P.obj U_P).hom) π
      let ξ := CategoryTheory.Sheaf.freeYonedaHomEquiv α_π
      CategoryTheory.CategoryStruct.comp ιℤ πℤ = CategoryTheory.CategoryStruct.id Fℤ_W ∧
      CategoryTheory.CategoryStruct.comp πℤ ιℤ = CategoryTheory.CategoryStruct.id (P_pull.obj Fℤ_P) ∧
      CategoryTheory.CategoryStruct.comp ((Fgt_W.map σ_e).left) p_fst = e.hom ∧
      CategoryTheory.CategoryStruct.comp ξ (L_W.obj.map (Opposite.op σ_e)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_W) ∧
      (∀ (V : W₀.Etale) (w : Quiver.Hom V (B_π.obj U_P)),
        Disjoint (Set.range ((Fgt_W.map w).left).base) (Set.range ((Fgt_W.map σ_e).left).base) →
        CategoryTheory.CategoryStruct.comp ξ (L_W.obj.map (Opposite.op w)) = 0) ∧
      z_W = (CategoryTheory.Abelian.Ext.mk₀ ((adj_π.homEquiv L_P L_W).symm α_π)).postcomp
        Fℤ_W (Nat.add_zero q)
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull _ _ _ _ _ Fℤ_P L_P q) z_P)
          (Nat.zero_add q))

def WeilGysinIsPolyP1Compactification (k : Type u) [Field k]
    (ι_P1 : ∀ (Ω : Type u) [Field Ω],
      Quiver.Hom (weilGysinAffineSpace Ω 1) (weilProjectiveSpaceOver Ω 1).left)
    (s_inf : ∀ (Ω : Type u) [Field Ω],
      Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (weilProjectiveSpaceOver Ω 1).left)
    (V_zero_compl : ∀ (Ω : Type u) [Field Ω], (weilProjectiveSpaceOver Ω 1).left.Opens)
    (ι_aff : ∀ δ : ℕ,
      Quiver.Hom (weilGysinAffineSpace k δ) (weilGysinPolyP1Over k δ).left) : Prop :=
  (∀ (Ω : Type u) [Field Ω],
    AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver Ω 1).left ∧
    AlgebraicGeometry.IsProper (weilProjectiveSpaceOver Ω 1).hom ∧
    AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver Ω 1).hom ∧
    AlgebraicGeometry.IsOpenImmersion (ι_P1 Ω) ∧
    CategoryTheory.CategoryStruct.comp (ι_P1 Ω) (weilProjectiveSpaceOver Ω 1).hom =
      weilGysinAffineStruct Ω 1 ∧
    CategoryTheory.CategoryStruct.comp (s_inf Ω) (weilProjectiveSpaceOver Ω 1).hom =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ∧
    (Set.range (ι_P1 Ω).base)ᶜ = Set.range (s_inf Ω).base ∧
    (V_zero_compl Ω : Set ↥(weilProjectiveSpaceOver Ω 1).left) =
      (Set.range (CategoryTheory.CategoryStruct.comp
        (weilGysinAffineOrigin Ω 1) (ι_P1 Ω)).base)ᶜ ∧
    AlgebraicGeometry.IsAffineOpen (V_zero_compl Ω) ∧
    ∃ e_compl : CategoryTheory.Iso (V_zero_compl Ω).toScheme (weilGysinAffineSpace Ω 1),
      CategoryTheory.CategoryStruct.comp e_compl.hom (weilGysinAffineStruct Ω 1) =
        CategoryTheory.CategoryStruct.comp (V_zero_compl Ω).ι
          (weilProjectiveSpaceOver Ω 1).hom) ∧
  (∀ δ : ℕ,
    AlgebraicGeometry.IsIntegral (weilGysinPolyP1Over k δ).left ∧
    AlgebraicGeometry.IsProper (weilGysinPolyP1Over k δ).hom ∧
    AlgebraicGeometry.SmoothOfRelativeDimension δ (weilGysinPolyP1Over k δ).hom ∧
    AlgebraicGeometry.IsOpenImmersion (ι_aff δ) ∧
    CategoryTheory.CategoryStruct.comp (ι_aff δ) (weilGysinPolyP1Over k δ).hom =
      weilGysinAffineStruct k δ) ∧
  (∀ δ : ℕ,
    CategoryTheory.CategoryStruct.comp (ι_aff (δ + 1))
      (CategoryTheory.Limits.pullback.fst (weilGysinPolyP1Over k δ).hom
        (weilProjectiveSpaceOver k 1).hom) =
      CategoryTheory.CategoryStruct.comp
        (weilGysinAffineProjLeft k δ 1 (δ + 1) rfl) (ι_aff δ) ∧
    CategoryTheory.CategoryStruct.comp (ι_aff (δ + 1))
      (CategoryTheory.Limits.pullback.snd (weilGysinPolyP1Over k δ).hom
        (weilProjectiveSpaceOver k 1).hom) =
      CategoryTheory.CategoryStruct.comp
        (weilGysinAffineProjRight k δ 1 (δ + 1) rfl) (ι_P1 k))

