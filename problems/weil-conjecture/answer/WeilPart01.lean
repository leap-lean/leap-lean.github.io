    (𝒦 : ℕ → CategoryTheory.Sheaf
      (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology AddCommGrpCat.{u})
    (τ_𝒦 : ∀ m : ℕ, Quiver.Hom (𝒦 (m + 1)) (𝒦 m))
    (B₂ : ℕ)
    (b_V : (B₀ ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B₀) →
      Fin 3 → ℕ)
    (M_lat_V : ∀ (σ : B₀ ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B₀)
      (i : Fin 3), Matrix (Fin (b_V σ i)) (Fin (b_V σ i)) (PadicInt ℓ)) : Prop :=
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  let D_ov := weilProjectiveSpaceOver F 1
  let D_bar := weilGeomScheme F D_ov
  let V_ov := weilCurveTrGeomCoverOver F B₀
  let V_bar := weilGeomScheme F V_ov
  let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
  let pr_D : Quiver.Hom D_bar D_ov.left := CategoryTheory.Limits.pullback.fst D_ov.hom f₂
  let U_bar : D_bar.Opens := (TopologicalSpace.Opens.map pr_D.base).obj U₀
  let π₀ : Quiver.Hom V_ov.left U₀.toScheme := CategoryTheory.CategoryStruct.comp
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀))) e_U.hom
  let ι₀ : Quiver.Hom V_ov.left D_ov.left := CategoryTheory.CategoryStruct.comp π₀ U₀.ι
  ∃ (ι_bar : Quiver.Hom V_bar D_bar)
    (triv_K : ∀ (m : ℕ) (W : D_bar.Etale),
      let W_V := CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget D_bar).obj W).hom ι_bar
      ↑((𝒦 m).obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_V (ZMod (ℓ ^ (m + 1)))),
    CategoryTheory.CategoryStruct.comp ι_bar pr_D =
      CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst V_ov.hom f₂) ι₀ ∧
    CategoryTheory.CategoryStruct.comp ι_bar (CategoryTheory.Limits.pullback.snd D_ov.hom f₂) =
      CategoryTheory.Limits.pullback.snd V_ov.hom f₂ ∧
    (∀ m : ℕ,
      (∀ {W₁ W₂ : D_bar.Etale} (u : Quiver.Hom W₁ W₂),
        let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget D_bar).obj W₁).hom
        let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget D_bar).obj W₂).hom
        let W₁_V := CategoryTheory.Limits.pullback h₁ ι_bar
        let W₂_V := CategoryTheory.Limits.pullback h₂ ι_bar
        ∀ (u_V : Quiver.Hom W₁_V W₂_V),
          CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.fst h₂ ι_bar) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst h₁ ι_bar)
              ((AlgebraicGeometry.Scheme.Etale.forget D_bar).map u).left →
          CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.snd h₂ ι_bar) =
            CategoryTheory.Limits.pullback.snd h₁ ι_bar →
          ∀ (sec : ↑((𝒦 m).obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_V),
            triv_K m W₁ (((𝒦 m).obj.map (Opposite.op u)) sec) y₁ =
