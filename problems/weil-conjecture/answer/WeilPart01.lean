                CategoryTheory.CategoryStruct.id Fℤ_Γ →
              CategoryTheory.CategoryStruct.comp
                  (@weilEtaleConstPullbackHom _ _ π_P hCont hAdj _ hT_Γ _ hT_P Aℤ) ιℤ =
                CategoryTheory.CategoryStruct.id (pb_π.obj Fℤ_P) →
