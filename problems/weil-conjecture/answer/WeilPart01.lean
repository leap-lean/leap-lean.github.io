noncomputable def weilPolyP1Over (k : Type u) [CommRing k] :
    ℕ → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))
  | 0 => CategoryTheory.Over.mk
      (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
  | d + 1 => CategoryTheory.Over.mk
      (CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k d).hom
          (weilProjectiveSpaceOver k 1).hom)
        (weilPolyP1Over k d).hom)

def WeilIsAffineRoofIso (k : Type u) [CommRing k]
    (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₁ : Y₁.left.Etale) (U₂ : Y₂.left.Etale)
    (e : CategoryTheory.Iso
      ((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U₁).left
      ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U₂).left) : Prop :=
  let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget Y₁.left
  let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget Y₂.left
  AlgebraicGeometry.IsProper Y₁.hom ∧
  AlgebraicGeometry.IsProper Y₂.hom ∧
  AlgebraicGeometry.IsAffine (Fgt₁.obj U₁).left ∧
  CategoryTheory.CategoryStruct.comp e.hom
    (CategoryTheory.CategoryStruct.comp (Fgt₂.obj U₂).hom Y₂.hom) =
    CategoryTheory.CategoryStruct.comp (Fgt₁.obj U₁).hom Y₁.hom

abbrev WeilRoofTransferSystem (k : Type u) [CommRing k] (ℓ : ℕ) : Type (u + 1) :=
  ∀ (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₁ : Y₁.left.Etale) (U₂ : Y₂.left.Etale)
    (e : CategoryTheory.Iso
      ((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U₁).left
      ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U₂).left),
    WeilIsAffineRoofIso k Y₁ Y₂ U₁ U₂ e →
    ∀ (r q : ℕ),
      weilEtaleLocalTorsionH Y₁.left (ℓ ^ r) U₁ q ≃+
        weilEtaleLocalTorsionH Y₂.left (ℓ ^ r) U₂ q

def WeilIsValidRoofTransfer (k : Type u) [CommRing k] (ℓ : ℕ)
    (Ψ : WeilRoofTransferSystem k ℓ) : Prop :=
  (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U : Y.left.Etale)
      (h : WeilIsAffineRoofIso k Y Y U U
        (CategoryTheory.Iso.refl ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U).left))
      (r q : ℕ),
    Ψ Y Y U U (CategoryTheory.Iso.refl _) h r q = AddEquiv.refl _) ∧
  (∀ (Y₁ Y₂ Y₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U₁ : Y₁.left.Etale) (U₂ : Y₂.left.Etale) (U₃ : Y₃.left.Etale)
      (e₁₂ : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U₁).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U₂).left)
      (e₂₃ : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U₂).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y₃.left).obj U₃).left)
      (h₁₂ : WeilIsAffineRoofIso k Y₁ Y₂ U₁ U₂ e₁₂)
      (h₂₃ : WeilIsAffineRoofIso k Y₂ Y₃ U₂ U₃ e₂₃)
      (h₁₃ : WeilIsAffineRoofIso k Y₁ Y₃ U₁ U₃ (CategoryTheory.Iso.trans e₁₂ e₂₃))
      (r q : ℕ),
    AddEquiv.trans (Ψ Y₁ Y₂ U₁ U₂ e₁₂ h₁₂ r q) (Ψ Y₂ Y₃ U₂ U₃ e₂₃ h₂₃ r q) =
      Ψ Y₁ Y₃ U₁ U₃ (CategoryTheory.Iso.trans e₁₂ e₂₃) h₁₃ r q) ∧
  (∀ (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U'₁ U₁ : Y₁.left.Etale) (U'₂ U₂ : Y₂.left.Etale)
      (v₁ : Quiver.Hom U'₁ U₁) (v₂ : Quiver.Hom U'₂ U₂)
      (e' : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U'₁).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U'₂).left)
      (e : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U₁).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U₂).left)
      (h' : WeilIsAffineRoofIso k Y₁ Y₂ U'₁ U'₂ e')
      (h : WeilIsAffineRoofIso k Y₁ Y₂ U₁ U₂ e),
    CategoryTheory.CategoryStruct.comp e'.hom
      (((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).map v₂).left) =
      CategoryTheory.CategoryStruct.comp
        (((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).map v₁).left) e.hom →
    ∀ (r q : ℕ) (z : weilEtaleLocalTorsionH Y₁.left (ℓ ^ r) U'₁ q),
      Ψ Y₁ Y₂ U₁ U₂ e h r q (weilEtaleLocalTorsionMapH Y₁.left (ℓ ^ r) v₁ q z) =
        weilEtaleLocalTorsionMapH Y₂.left (ℓ ^ r) v₂ q (Ψ Y₁ Y₂ U'₁ U'₂ e' h' r q z)) ∧
  (∀ (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U₁ : Y₁.left.Etale) (U₂ : Y₂.left.Etale)
      (e : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U₁).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U₂).left)
      (h : WeilIsAffineRoofIso k Y₁ Y₂ U₁ U₂ e)
      (r q : ℕ) (z : weilEtaleLocalTorsionH Y₁.left (ℓ ^ (r + 1)) U₁ q),
    weilEtaleLocalTorsionTransition Y₂.left ℓ r U₂ q (Ψ Y₁ Y₂ U₁ U₂ e h (r + 1) q z) =
      Ψ Y₁ Y₂ U₁ U₂ e h r q (weilEtaleLocalTorsionTransition Y₁.left ℓ r U₁ q z)) ∧
  (∀ (W_bar Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π : Quiver.Hom W_bar.left Y.left)
      (U_W : W_bar.left.Etale) (U_Y : Y.left.Etale)
      (e : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).left)
      (h : WeilIsAffineRoofIso k W_bar Y U_W U_Y e),
    CategoryTheory.CategoryStruct.comp π Y.hom = W_bar.hom →
    CategoryTheory.CategoryStruct.comp
        (((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).hom) π =
      CategoryTheory.CategoryStruct.comp e.hom
        (((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).hom) →
    let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget W_bar.left
    let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget Y.left
    let B_π := weilEtaleSitePullback π
    let J_W := W_bar.left.smallEtaleTopology
    let J_Y := Y.left.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ_W := (CategoryTheory.constantSheaf J_W AddCommGrpCat.{u}).obj Aℤ
    let Fℤ_Y := (CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}).obj Aℤ
    ∀ (_hCont : B_π.IsContinuous J_Y J_W)
      (_hAdj : (B_π.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_W).IsRightAdjoint),
      let pf_π := B_π.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_W
      let pb_π := B_π.sheafPullback AddCommGrpCat.{u} J_Y J_W
      let adj_π := B_π.sheafAdjunctionContinuous AddCommGrpCat.{u} J_Y J_W
      ∀ (_hAdd : pb_π.Additive)
        (_hLim : CategoryTheory.Limits.PreservesFiniteLimits pb_π)
        (_hColim : CategoryTheory.Limits.PreservesFiniteColimits pb_π)
        (T_W : W_bar.left.Etale) (hT_W : CategoryTheory.Limits.IsTerminal T_W)
        (T_Y : Y.left.Etale) (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
        (ιℤ : Quiver.Hom Fℤ_W (pb_π.obj Fℤ_Y))
        (p_fst : Quiver.Hom ((Fgt_W.obj (B_π.obj U_Y)).left) ((Fgt_Y.obj U_Y).left))
        (σ_e : Quiver.Hom U_W (B_π.obj U_Y))
        (r : ℕ)
        (α_π : Quiver.Hom (weilEtaleLocalTorsionSheaf Y.left (ℓ ^ r) U_Y)
          (pf_π.obj (weilEtaleLocalTorsionSheaf W_bar.left (ℓ ^ r) U_W))),
        let πℤ := weilEtaleConstPullbackHom π hT_W hT_Y Aℤ
        let L_Y := weilEtaleLocalTorsionSheaf Y.left (ℓ ^ r) U_Y
        let L_W := weilEtaleLocalTorsionSheaf W_bar.left (ℓ ^ r) U_W
        let ξ := CategoryTheory.Sheaf.freeYonedaHomEquiv α_π
        CategoryTheory.CategoryStruct.comp ιℤ πℤ = CategoryTheory.CategoryStruct.id Fℤ_W →
        CategoryTheory.CategoryStruct.comp πℤ ιℤ = CategoryTheory.CategoryStruct.id (pb_π.obj Fℤ_Y) →
        CategoryTheory.IsPullback p_fst ((Fgt_W.obj (B_π.obj U_Y)).hom) ((Fgt_Y.obj U_Y).hom) π →
        CategoryTheory.CategoryStruct.comp ((Fgt_W.map σ_e).left) p_fst = e.hom →
        CategoryTheory.CategoryStruct.comp ξ (L_W.obj.map (Opposite.op σ_e)) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_W) →
        (∀ (V : W_bar.left.Etale) (w : Quiver.Hom V (B_π.obj U_Y)),
          Disjoint (Set.range ((Fgt_W.map w).left).base) (Set.range ((Fgt_W.map σ_e).left).base) →
          CategoryTheory.CategoryStruct.comp ξ (L_W.obj.map (Opposite.op w)) = 0) →
        ∀ (q : ℕ) (z : weilEtaleLocalTorsionH Y.left (ℓ ^ r) U_Y q),
          (Ψ W_bar Y U_W U_Y e h r q).symm z =
            (CategoryTheory.Abelian.Ext.mk₀ ((adj_π.homEquiv L_Y L_W).symm α_π)).postcomp
              Fℤ_W (Nat.add_zero q)
              ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_π _ _ _ _ _ Fℤ_Y L_Y q) z)
                (Nat.zero_add q)))

def WeilIsPolyP1ModelTracePkg (k : Type u) [CommRing k] (ℓ : ℕ)
    (Ψ : WeilRoofTransferSystem k ℓ)
    (ι_aff : ∀ δ : ℕ, Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
    (tr_Pd : ∀ (δ r : ℕ),
      weilEtaleTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) (2 * δ) →+ ZMod (ℓ ^ r)) : Prop :=
  (∀ δ : ℕ,
    AlgebraicGeometry.IsProper (weilPolyP1Over k δ).hom ∧
    AlgebraicGeometry.IsOpenImmersion (ι_aff δ) ∧
    CategoryTheory.CategoryStruct.comp (ι_aff δ) (weilPolyP1Over k δ).hom =
      (weilAffineSpaceOver k δ).hom) ∧
  (∀ r : ℕ, Function.Bijective (tr_Pd 0 r)) ∧
  (∀ (δ r : ℕ) (w : weilEtaleTorsionH (weilPolyP1Over k δ).left (ℓ ^ (r + 1)) (2 * δ)),
    ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr_Pd δ (r + 1) w) =
      tr_Pd δ r (weilEtaleTorsionTransition (weilPolyP1Over k δ).left ℓ r (2 * δ) w)) ∧
  (∀ (δ r q : ℕ) (U : (weilPolyP1Over k δ).left.Etale),
    AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U).left →
    2 * δ < q →
    Subsingleton (weilEtaleLocalTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) U q)) ∧
  (∀ (δ : ℕ) (j : Fin δ) (U₁ U₂ : (weilPolyP1Over k δ).left.Etale)
      (u₁ : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₁).left
        (weilAffineSpaceOver k δ).left)
      (u₂ : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₂).left
        (weilAffineSpaceOver k δ).left)
      (e : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₁).left
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₂).left)
      (h : WeilIsAffineRoofIso k (weilPolyP1Over k δ) (weilPolyP1Over k δ) U₁ U₂ e),
    AlgebraicGeometry.Etale u₁ →
    AlgebraicGeometry.Etale u₂ →
    CategoryTheory.CategoryStruct.comp u₁ (ι_aff δ) =
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₁).hom →
    CategoryTheory.CategoryStruct.comp u₂ (ι_aff δ) =
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₂).hom →
    (∀ (i : Fin δ), i ≠ j →
      let pr_i : Quiver.Hom (weilAffineSpaceOver k δ).left
          (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Polynomial.aeval (MvPolynomial.X i : MvPolynomial (Fin δ) k)).toRingHom)
      CategoryTheory.CategoryStruct.comp u₁ pr_i =
        CategoryTheory.CategoryStruct.comp e.hom
          (CategoryTheory.CategoryStruct.comp u₂ pr_i)) →
    ∀ (r : ℕ) (z : weilEtaleLocalTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) U₁ (2 * δ)),
      tr_Pd δ r (weilEtaleLocalTorsionCounitH (weilPolyP1Over k δ).left (ℓ ^ r) U₁ (2 * δ) z) =
        tr_Pd δ r (weilEtaleLocalTorsionCounitH (weilPolyP1Over k δ).left (ℓ ^ r) U₂ (2 * δ)
          (Ψ (weilPolyP1Over k δ) (weilPolyP1Over k δ) U₁ U₂ e h r (2 * δ) z))) ∧
  (∀ (δ r : ℕ)
      (V : (weilPolyP1Over k δ).left.Etale)
      (U : (weilPolyP1Over k (δ + 1)).left.Etale)
      (u_V : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj V).left
        (weilAffineSpaceOver k δ).left)
      (u_U : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (δ + 1)).left).obj U).left
        (weilAffineSpaceOver k (δ + 1)).left)
      (h_UV : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (δ + 1)).left).obj U).left
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj V).left)
      (t_U : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (δ + 1)).left).obj U).left
        (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))),
    AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj V).left →
    AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (δ + 1)).left).obj U).left →
    AlgebraicGeometry.Etale u_V →
    AlgebraicGeometry.Etale u_U →
    CategoryTheory.CategoryStruct.comp u_V (ι_aff δ) =
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj V).hom →
    CategoryTheory.CategoryStruct.comp u_U (ι_aff (δ + 1)) =
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (δ + 1)).left).obj U).hom →
    CategoryTheory.CategoryStruct.comp u_U
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (MvPolynomial.rename Fin.castSucc :
          MvPolynomial (Fin δ) k →ₐ[k] MvPolynomial (Fin (δ + 1)) k).toRingHom)) =
      CategoryTheory.CategoryStruct.comp h_UV u_V →
    CategoryTheory.CategoryStruct.comp u_U
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Polynomial.aeval (MvPolynomial.X (Fin.last δ) : MvPolynomial (Fin (δ + 1)) k)).toRingHom)) =
      t_U →
    AlgebraicGeometry.SmoothOfRelativeDimension 1 h_UV →
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω))
          ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj V).left),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback h_UV s)) →
    Function.Bijective (fun z : weilEtaleLocalTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) V (2 * δ) =>
      tr_Pd δ r (weilEtaleLocalTorsionCounitH (weilPolyP1Over k δ).left (ℓ ^ r) V (2 * δ) z)) →
    Function.Bijective (fun z : weilEtaleLocalTorsionH (weilPolyP1Over k (δ + 1)).left (ℓ ^ r) U (2 * (δ + 1)) =>
      tr_Pd (δ + 1) r (weilEtaleLocalTorsionCounitH (weilPolyP1Over k (δ + 1)).left (ℓ ^ r) U (2 * (δ + 1)) z)))

def WeilChartTraceIndependent (k : Type u) [CommRing k] (ℓ : ℕ)
    (Ψ : WeilRoofTransferSystem k ℓ)
    (ι_aff : ∀ δ : ℕ, Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
    (tr_Pd : ∀ (δ r : ℕ),
      weilEtaleTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) (2 * δ) →+ ZMod (ℓ ^ r)) : Prop :=
  ∀ (δ : ℕ) (U₁ U₂ : (weilPolyP1Over k δ).left.Etale)
      (u₁ : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₁).left
        (weilAffineSpaceOver k δ).left)
      (u₂ : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₂).left
        (weilAffineSpaceOver k δ).left)
      (e : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₁).left
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₂).left)
      (h : WeilIsAffineRoofIso k (weilPolyP1Over k δ) (weilPolyP1Over k δ) U₁ U₂ e),
    AlgebraicGeometry.Etale u₁ →
    AlgebraicGeometry.Etale u₂ →
    CategoryTheory.CategoryStruct.comp u₁ (ι_aff δ) =
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₁).hom →
    CategoryTheory.CategoryStruct.comp u₂ (ι_aff δ) =
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₂).hom →
    ∀ (r : ℕ) (z : weilEtaleLocalTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) U₁ (2 * δ)),
      tr_Pd δ r (weilEtaleLocalTorsionCounitH (weilPolyP1Over k δ).left (ℓ ^ r) U₁ (2 * δ) z) =
        tr_Pd δ r (weilEtaleLocalTorsionCounitH (weilPolyP1Over k δ).left (ℓ ^ r) U₂ (2 * δ)
          (Ψ (weilPolyP1Over k δ) (weilPolyP1Over k δ) U₁ U₂ e h r (2 * δ) z))
noncomputable def weilSmoothCenterAwayToFrac {R' B : Type u} [CommRing R'] [IsDomain R']
    [CommRing B] [Algebra R' B]
    (ιB : B →ₐ[R'] FractionRing R') (u : B) (hu : ιB u ≠ 0) :
    Localization.Away u →ₐ[R'] FractionRing R' :=
  let hUnit : IsUnit (ιB.toRingHom u) := IsUnit.mk0 (ιB u) hu
  let f_hom : Localization.Away u →+* FractionRing R' := IsLocalization.Away.lift u hUnit
  { f_hom with
    commutes' := fun r => by
      change f_hom (algebraMap B (Localization.Away u) (algebraMap R' B r)) = _
      rw [IsLocalization.Away.lift_eq]
      exact ιB.commutes r }

noncomputable def weilSmoothCenterAlgHomOfExists {R' D₁ D₂ K' : Type u} [CommRing R']
    [CommRing D₁] [Algebra R' D₁] [CommRing D₂] [Algebra R' D₂] [CommRing K'] [Algebra R' K']
    (f₁ : D₁ →ₐ[R'] K') (f₂ : D₂ →ₐ[R'] K') (hf₂ : Function.Injective f₂)
    (hEx : ∀ x : D₁, ∃ y : D₂, f₂ y = f₁ x) : D₁ →ₐ[R'] D₂ where
  toFun x := Classical.choose (hEx x)
  map_one' := hf₂ (by rw [Classical.choose_spec (hEx 1), map_one, map_one])
  map_mul' x y := hf₂ (by
    rw [Classical.choose_spec (hEx (x * y)), map_mul, map_mul,
      Classical.choose_spec (hEx x), Classical.choose_spec (hEx y)])
  map_zero' := hf₂ (by rw [Classical.choose_spec (hEx 0), map_zero, map_zero])
  map_add' x y := hf₂ (by
    rw [Classical.choose_spec (hEx (x + y)), map_add, map_add,
      Classical.choose_spec (hEx x), Classical.choose_spec (hEx y)])
  commutes' r := hf₂ (by
    rw [Classical.choose_spec (hEx (algebraMap R' D₁ r)), f₁.commutes, f₂.commutes])
def WeilIsPointedEtaleStrictlyLocalEnvelope
    (R₀ Ω A : Type u) [CommRing R₀] [Field Ω] [Algebra R₀ Ω]
    [CommRing A] [Algebra R₀ A] [Algebra A Ω] [IsScalarTower R₀ A Ω] : Prop :=
  (∃ (_ : IsLocalRing A),
    IsLocalRing.maximalIdeal A = RingHom.ker (algebraMap A Ω) ∧
    IsSepClosed (IsLocalRing.ResidueField A)) ∧
  (∀ (d : ℕ) (g : Fin d → MvPolynomial (Fin d) A) (z₀ : Fin d → A),
    (∀ k : Fin d, MvPolynomial.eval z₀ (g k) ∈ RingHom.ker (algebraMap A Ω)) →
    MvPolynomial.eval z₀
      (Matrix.det (Matrix.of fun k l : Fin d => MvPolynomial.pderiv l (g k))) ∉
        RingHom.ker (algebraMap A Ω) →
    ∃ z : Fin d → A,
      (∀ k : Fin d, MvPolynomial.eval z (g k) = 0) ∧
      (∀ l : Fin d, z l - z₀ l ∈ RingHom.ker (algebraMap A Ω))) ∧
  (∀ (B₀ : Type u) [CommRing B₀] [Algebra R₀ B₀] (r : ℕ)
    (e_A : Fin r → TensorProduct R₀ A B₀),
    CompleteOrthogonalIdempotents e_A →
    ∃ (R₁ : Type u) (_ : CommRing R₁) (_ : Algebra R₀ R₁) (_ : Algebra.Etale R₀ R₁)
      (_ : Algebra R₁ A) (_ : IsScalarTower R₀ R₁ A)
      (_ : Algebra R₁ Ω) (_ : IsScalarTower R₁ A Ω) (_ : IsScalarTower R₀ R₁ Ω)
      (e₁ : Fin r → TensorProduct R₀ R₁ B₀),
      CompleteOrthogonalIdempotents e₁ ∧
      ∀ m : Fin r,
        Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₀ R₁ A) (AlgHom.id R₀ B₀) (e₁ m) = e_A m) ∧
  (∀ (R₁ : Type u) [CommRing R₁] [Algebra R₀ R₁] [Algebra.Etale R₀ R₁]
    [Algebra R₁ A] [IsScalarTower R₀ R₁ A]
    [Algebra R₁ Ω] [IsScalarTower R₁ A Ω] [IsScalarTower R₀ R₁ Ω]
    (R₂ : Type u) [CommRing R₂] [Algebra R₁ R₂] [Algebra.Etale R₁ R₂]
    [Algebra R₂ Ω] [IsScalarTower R₁ R₂ Ω]
    (M : Type u) [CommRing M] [Algebra R₁ M]
    (B₀ W₀ : Type u) [CommRing B₀] [CommRing W₀] [Algebra B₀ W₀]
    [Algebra.FinitePresentation B₀ W₀]
    (b_hom : B₀ →+* M)
    (α_A : W₀ →+* TensorProduct R₁ A M),
    α_A.comp (algebraMap B₀ W₀) =
      (Algebra.TensorProduct.includeRight : M →ₐ[R₁] TensorProduct R₁ A M).toRingHom.comp b_hom →
    ∃ (R₃ : Type u) (_ : CommRing R₃) (_ : Algebra R₁ R₃) (_ : Algebra R₂ R₃)
      (_ : IsScalarTower R₁ R₂ R₃) (_ : Algebra.Etale R₂ R₃)
      (_ : Algebra R₃ A) (_ : IsScalarTower R₁ R₃ A)
      (_ : Algebra R₃ Ω) (_ : IsScalarTower R₃ A Ω)
      (_ : IsScalarTower R₂ R₃ Ω) (_ : IsScalarTower R₁ R₃ Ω)
      (α_tilde : W₀ →+* TensorProduct R₁ R₃ M),
      α_tilde.comp (algebraMap B₀ W₀) =
        (Algebra.TensorProduct.includeRight : M →ₐ[R₁] TensorProduct R₁ R₃ M).toRingHom.comp b_hom ∧
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₃ A) (AlgHom.id R₁ M)).toRingHom.comp α_tilde = α_A) ∧
  (∀ (R₁ : Type u) [CommRing R₁] [Algebra R₀ R₁] [Algebra.Etale R₀ R₁]
    [Algebra R₁ A] [IsScalarTower R₀ R₁ A]
    [Algebra R₁ Ω] [IsScalarTower R₁ A Ω] [IsScalarTower R₀ R₁ Ω]
    (R₂ : Type u) [CommRing R₂] [Algebra R₁ R₂] [Algebra.Etale R₁ R₂]
    [Algebra R₂ Ω] [IsScalarTower R₁ R₂ Ω]
    (M : Type u) [CommRing M] [Algebra R₁ M],
    ∃ (φ₂ : R₂ →ₐ[R₁] A),
      (algebraMap A Ω).comp φ₂.toRingHom = algebraMap R₂ Ω ∧
      ∀ (x : TensorProduct R₁ R₂ M),
        Algebra.TensorProduct.map φ₂ (AlgHom.id R₁ M) x = 0 →
        ∃ (R₃ : Type u) (_ : CommRing R₃) (_ : Algebra R₁ R₃) (_ : Algebra R₂ R₃)
          (_ : IsScalarTower R₁ R₂ R₃) (_ : Algebra.Etale R₂ R₃)
          (_ : Algebra R₃ Ω) (_ : IsScalarTower R₂ R₃ Ω) (_ : IsScalarTower R₁ R₃ Ω),
          Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₂ R₃) (AlgHom.id R₁ M) x = 0)
noncomputable def weilFreeYonedaZ.{u} (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale) :
    CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
  CategoryTheory.Sheaf.freeYoneda Z.smallEtaleTopology V
    (AddCommGrpCat.of (ULift.{u} ℤ))

noncomputable def weilFreeYonedaMap.{u} {Z : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : Z.Etale}
    (u : Quiver.Hom V₁ V₂) :
    Quiver.Hom (weilFreeYonedaZ.{u} Z V₁) (weilFreeYonedaZ.{u} Z V₂) :=
  (CategoryTheory.Sheaf.freeYonedaHomEquiv).symm
    (CategoryTheory.CategoryStruct.comp
      ((CategoryTheory.Sheaf.freeYonedaHomEquiv)
        (CategoryTheory.CategoryStruct.id (weilFreeYonedaZ.{u} Z V₂)))
      ((weilFreeYonedaZ.{u} Z V₂).obj.map (Opposite.op u)))

def WeilHasAffineEtaleResolution.{u} (B₀ : CommRingCat.{u})
    (A₀ : CategoryTheory.Sheaf (AlgebraicGeometry.Spec B₀).smallEtaleTopology AddCommGrpCat.{u}) :
    Prop :=
  let Z₀ := AlgebraicGeometry.Spec B₀
  ∃ (K : ℕ → CategoryTheory.Sheaf Z₀.smallEtaleTopology AddCommGrpCat.{u})
    (C : ℕ → Z₀.Etale)
    (ι : ∀ m : ℕ, Quiver.Hom (K (m + 1)) (weilFreeYonedaZ.{u} Z₀ (C m)))
    (π : ∀ m : ℕ, Quiver.Hom (weilFreeYonedaZ.{u} Z₀ (C m)) (K m))
    (h₀ : ∀ m : ℕ, CategoryTheory.CategoryStruct.comp (ι m) (π m) = 0),
    K 0 = A₀ ∧
    (∀ m : ℕ, (CategoryTheory.ShortComplex.mk (ι m) (π m) (h₀ m)).ShortExact) ∧
    (∀ m : ℕ,
      let c_hom : Quiver.Hom (C m).left Z₀ := (C m).hom
      ∃ (E_m : CommRingCat.{u}) (f_m : Quiver.Hom B₀ E_m)
        (e_m : CategoryTheory.Iso (AlgebraicGeometry.Spec E_m) (C m).left),
        CategoryTheory.CategoryStruct.comp e_m.hom c_hom = AlgebraicGeometry.Spec.map f_m)

noncomputable def weilEtaleBasePullExt.{u}
    (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ f)).IsRightAdjoint)
    (hSite : WeilEtaleSiteExactAndSliceInjHolds.{u} (@hc_all) (@hr_all))
    {Y₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
    (π₁ : Quiver.Hom Y₁ Y₀) (π₂ : Quiver.Hom Y₂ Y₀) (h : Quiver.Hom Y₁ Y₂)
    (h_eq : CategoryTheory.CategoryStruct.comp h π₂ = π₁)
    (A₀ G₀ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ) :
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
    CategoryTheory.Abelian.Ext
        (((weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u}
          Y₀.smallEtaleTopology Y₂.smallEtaleTopology).obj A₀)
        (((weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u}
          Y₀.smallEtaleTopology Y₂.smallEtaleTopology).obj G₀) q →+
      CategoryTheory.Abelian.Ext
        (((weilEtaleSitePullback π₁).sheafPullback AddCommGrpCat.{u}
          Y₀.smallEtaleTopology Y₁.smallEtaleTopology).obj A₀)
        (((weilEtaleSitePullback π₁).sheafPullback AddCommGrpCat.{u}
          Y₀.smallEtaleTopology Y₁.smallEtaleTopology).obj G₀) q :=
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
  let B₁ := weilEtaleSitePullback π₁
  let B₂ := weilEtaleSitePullback π₂
  let B_h := weilEtaleSitePullback h
  let pf₂ := B₂.sheafPushforwardContinuous AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₂.smallEtaleTopology
  let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
  let pb₁ := B₁.sheafPullback AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₁.smallEtaleTopology
  let pb₂ := B₂.sheafPullback AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₂.smallEtaleTopology
  let pb_h := B_h.sheafPullback AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
  let adj₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₁.smallEtaleTopology
  let adj₂ := B₂.sheafAdjunctionContinuous AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₂.smallEtaleTopology
  let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
  letI : pb_h.Additive := (hSite.1 h).1
  letI : CategoryTheory.Limits.PreservesFiniteLimits pb_h := (hSite.1 h).2.1
  letI : CategoryTheory.Limits.PreservesFiniteColimits pb_h := (hSite.1 h).2.2.1
  let e_B : CategoryTheory.Iso B₁ (CategoryTheory.Functor.comp B₂ B_h) :=
    CategoryTheory.Iso.trans
      (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm)
      (CategoryTheory.MorphismProperty.Over.pullbackComp h π₂)
  letI : (CategoryTheory.Functor.comp B₂ B_h).IsContinuous Y₀.smallEtaleTopology Y₁.smallEtaleTopology :=
    CategoryTheory.Functor.isContinuous_comp B₂ B_h
      Y₀.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology
  let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_B
    AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₁.smallEtaleTopology
  let β_G : Quiver.Hom (pb_h.obj (pb₂.obj G₀)) (pb₁.obj G₀) :=
    (adj_h.homEquiv (pb₂.obj G₀) (pb₁.obj G₀)).symm
      ((adj₂.homEquiv G₀ (pf_h.obj (pb₁.obj G₀))).symm
        (CategoryTheory.CategoryStruct.comp
          (adj₁.unit.app G₀)
          (e_pf.hom.app (pb₁.obj G₀))))
  let α_A : Quiver.Hom (pb₁.obj A₀) (pb_h.obj (pb₂.obj A₀)) :=
    (adj₁.homEquiv A₀ (pb_h.obj (pb₂.obj A₀))).symm
      (CategoryTheory.CategoryStruct.comp
        (adj₂.unit.app A₀)
        (CategoryTheory.CategoryStruct.comp
          (pf₂.map (adj_h.unit.app (pb₂.obj A₀)))
          (e_pf.inv.app (pb_h.obj (pb₂.obj A₀)))))
  ((CategoryTheory.Abelian.Ext.mk₀ β_G).postcomp (pb₁.obj A₀) (Nat.add_zero q)).comp
    (((CategoryTheory.Abelian.Ext.mk₀ α_A).precomp (pb_h.obj (pb₂.obj G₀)) (Nat.zero_add q)).comp
      (pb_h.mapExtAddHom (pb₂.obj A₀) (pb₂.obj G₀) q))

def WeilAffineBaseExtColimitHolds.{u}
    (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ f)).IsRightAdjoint)
    (hSite : WeilEtaleSiteExactAndSliceInjHolds.{u} (@hc_all) (@hr_all))
    (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
    (B₀ : CommRingCat.{u})
    (B : CategoryTheory.Functor ℐ CommRingCat.{u})
    (α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj B₀) B)
    (c : CategoryTheory.Limits.Cocone B)
    (f_inf : Quiver.Hom B₀ c.pt)
    (q : ℕ)
    (A₀ G₀ : CategoryTheory.Sheaf (AlgebraicGeometry.Spec B₀).smallEtaleTopology AddCommGrpCat.{u}) :
    Prop :=
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
  let Z₀ := AlgebraicGeometry.Spec B₀
  let p_i : ∀ i : ℐ, Quiver.Hom (AlgebraicGeometry.Spec (B.obj i)) Z₀ :=
    fun i => AlgebraicGeometry.Spec.map (α.app i)
  let p_inf : Quiver.Hom (AlgebraicGeometry.Spec c.pt) Z₀ :=
    AlgebraicGeometry.Spec.map f_inf
  let u_i : ∀ i : ℐ, Quiver.Hom (AlgebraicGeometry.Spec c.pt) (AlgebraicGeometry.Spec (B.obj i)) :=
    fun i => AlgebraicGeometry.Spec.map (c.ι.app i)
  (∀ (x_inf : CategoryTheory.Abelian.Ext
        (((weilEtaleSitePullback p_inf).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology (AlgebraicGeometry.Spec c.pt).smallEtaleTopology).obj A₀)
        (((weilEtaleSitePullback p_inf).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology (AlgebraicGeometry.Spec c.pt).smallEtaleTopology).obj G₀) q),
    ∃ (i : ℐ) (hu : CategoryTheory.CategoryStruct.comp (u_i i) (p_i i) = p_inf)
      (x_i : CategoryTheory.Abelian.Ext
        (((weilEtaleSitePullback (p_i i)).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology (AlgebraicGeometry.Spec (B.obj i)).smallEtaleTopology).obj A₀)
        (((weilEtaleSitePullback (p_i i)).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology (AlgebraicGeometry.Spec (B.obj i)).smallEtaleTopology).obj G₀) q),
      weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite p_inf (p_i i) (u_i i) hu A₀ G₀ q x_i = x_inf) ∧
  (∀ (i : ℐ) (hu : CategoryTheory.CategoryStruct.comp (u_i i) (p_i i) = p_inf)
    (x_i : CategoryTheory.Abelian.Ext
        (((weilEtaleSitePullback (p_i i)).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology (AlgebraicGeometry.Spec (B.obj i)).smallEtaleTopology).obj A₀)
        (((weilEtaleSitePullback (p_i i)).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology (AlgebraicGeometry.Spec (B.obj i)).smallEtaleTopology).obj G₀) q),
    weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite p_inf (p_i i) (u_i i) hu A₀ G₀ q x_i = 0 →
    ∃ (j : ℐ) (θ : Quiver.Hom i j)
      (hθ : CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Spec.map (B.map θ)) (p_i i) = p_i j),
      weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite (p_i j) (p_i i)
        (AlgebraicGeometry.Spec.map (B.map θ)) hθ A₀ G₀ q x_i = 0)

def WeilEtaleCechSyzygyPackageHolds.{u} : Prop :=
  ∀ (R : CommRingCat.{u}),
    let Z := AlgebraicGeometry.Spec R
    (∃ (T_Z : Z.Etale), Nonempty (CategoryTheory.Limits.IsTerminal T_Z)) ∧
    ∀ (T_Z : Z.Etale) (hT_Z : CategoryTheory.Limits.IsTerminal T_Z),
      WeilHasAffineEtaleResolution.{u} R (weilFreeYonedaZ.{u} Z T_Z) ∧
      ∀ (E : CommRingCat.{u}) (f : Quiver.Hom R E),
        (CommRingCat.Hom.hom f).Etale →
        AlgebraicGeometry.Surjective (AlgebraicGeometry.Spec.map f) →
        ∃ (U : Z.Etale)
          (eU : CategoryTheory.Iso (AlgebraicGeometry.Spec E) U.left)
          (K₁ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
          (ι₀ : Quiver.Hom K₁ (weilFreeYonedaZ.{u} Z U))
          (h₀ : CategoryTheory.CategoryStruct.comp ι₀ (weilFreeYonedaMap.{u} (hT_Z.from U)) = 0),
          (let u_hom : Quiver.Hom U.left Z := U.hom
           CategoryTheory.CategoryStruct.comp eU.hom u_hom = AlgebraicGeometry.Spec.map f) ∧
          (CategoryTheory.ShortComplex.mk ι₀ (weilFreeYonedaMap.{u} (hT_Z.from U)) h₀).ShortExact ∧
          WeilHasAffineEtaleResolution.{u} R K₁

def WeilEtaleAffineProductExtVanishingHolds.{u} : Prop :=
  ∀ (R : CommRingCat.{u}),
    let Z := AlgebraicGeometry.Spec R
    ∀ (T_Z : Z.Etale) (hT_Z : CategoryTheory.Limits.IsTerminal T_Z)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (q : ℕ),
      1 ≤ q →
      ∀ (ζ : CategoryTheory.Abelian.Ext (weilFreeYonedaZ.{u} Z T_Z) F q),
        ∃ (E : CommRingCat.{u}) (f : Quiver.Hom R E),
          (CommRingCat.Hom.hom f).Etale ∧
          AlgebraicGeometry.Surjective (AlgebraicGeometry.Spec.map f) ∧
          ∀ (U : Z.Etale) (eU : CategoryTheory.Iso (AlgebraicGeometry.Spec E) U.left),
            (let u_hom : Quiver.Hom U.left Z := U.hom
             CategoryTheory.CategoryStruct.comp eU.hom u_hom = AlgebraicGeometry.Spec.map f) →
            (CategoryTheory.Abelian.Ext.mk₀ (weilFreeYonedaMap.{u} (hT_Z.from U))).comp ζ
              (Nat.zero_add q) = 0

def WeilEtaleBaseExtAndSliceColimitHolds.{u}
    (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ f)).IsRightAdjoint)
    (hSite : WeilEtaleSiteExactAndSliceInjHolds.{u} (@hc_all) (@hr_all)) : Prop :=
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
  (∀ {Y₀ Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom Y Y₀)
      (A₀ G₀ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
    weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite π π
      (CategoryTheory.CategoryStruct.id Y) (CategoryTheory.Category.id_comp π) A₀ G₀ q =
      AddMonoidHom.id _) ∧
  (∀ {Y₀ Y₁ Y₂ Y₃ : AlgebraicGeometry.Scheme.{u}}
      (π₁ : Quiver.Hom Y₁ Y₀) (π₂ : Quiver.Hom Y₂ Y₀) (π₃ : Quiver.Hom Y₃ Y₀)
      (h : Quiver.Hom Y₁ Y₂) (h' : Quiver.Hom Y₃ Y₁)
      (h₁₂ : CategoryTheory.CategoryStruct.comp h π₂ = π₁)
      (h₃₁ : CategoryTheory.CategoryStruct.comp h' π₁ = π₃)
      (h₃₂ : CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp h' h) π₂ = π₃)
      (A₀ G₀ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
    weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite π₃ π₂
      (CategoryTheory.CategoryStruct.comp h' h) h₃₂ A₀ G₀ q =
      (weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite π₃ π₁ h' h₃₁ A₀ G₀ q).comp
        (weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite π₁ π₂ h h₁₂ A₀ G₀ q)) ∧
  (∀ {Y₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (π₁ : Quiver.Hom Y₁ Y₀) (π₂ : Quiver.Hom Y₂ Y₀) (h : Quiver.Hom Y₁ Y₂)
      (h_eq : CategoryTheory.CategoryStruct.comp h π₂ = π₁)
      {A₀' A₀ G₀ G₀' : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}}
      (u : Quiver.Hom A₀' A₀) (v : Quiver.Hom G₀ G₀') (q : ℕ),
    let pb₁ := (weilEtaleSitePullback π₁).sheafPullback AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₁.smallEtaleTopology
    let pb₂ := (weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₂.smallEtaleTopology
    (∀ x : CategoryTheory.Abelian.Ext (pb₂.obj A₀) (pb₂.obj G₀) q,
      weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite π₁ π₂ h h_eq A₀' G₀ q
        ((CategoryTheory.Abelian.Ext.mk₀ (pb₂.map u)).comp x (Nat.zero_add q)) =
      (CategoryTheory.Abelian.Ext.mk₀ (pb₁.map u)).comp
        (weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite π₁ π₂ h h_eq A₀ G₀ q x) (Nat.zero_add q)) ∧
    (∀ x : CategoryTheory.Abelian.Ext (pb₂.obj A₀) (pb₂.obj G₀) q,
      weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite π₁ π₂ h h_eq A₀ G₀' q
