    (CategoryTheory.Sheaf.cohomologyPresheaf SC.X₁ (q + 1))
  let η_S := (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit
  ∀ W : S.Etale,
    CategoryTheory.CategoryStruct.comp ((η_S.app P₃).app (Opposite.op W))
      (δ.hom.app (Opposite.op W)) =
      CategoryTheory.CategoryStruct.comp
        (AddCommGrpCat.ofHom (hSE.extClass.postcomp
          (weilPolyP1CohomologyRepSheaf X (B_f.obj W)) (rfl : q + 1 = q + 1)))
        ((η_S.app P₁).app (Opposite.op W))
