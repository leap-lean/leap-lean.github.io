        ∃ (i : ℐ) (hu : CategoryTheory.CategoryStruct.comp (u_i i) (p_i i) = p_inf)
          (s_i : (((weilEtaleSitePullback (p_i i)).sheafPullback AddCommGrpCat.{u}
            Z₀.smallEtaleTopology (AlgebraicGeometry.Spec (B.obj i)).smallEtaleTopology).obj G).H q),
          WeilEtaleTrianglePullbackMapsTo p_inf (p_i i) (u_i i) hu G q s_i s_inf) ∧
      (∀ (i : ℐ) (hu : CategoryTheory.CategoryStruct.comp (u_i i) (p_i i) = p_inf)
        (s_i : (((weilEtaleSitePullback (p_i i)).sheafPullback AddCommGrpCat.{u}
            Z₀.smallEtaleTopology (AlgebraicGeometry.Spec (B.obj i)).smallEtaleTopology).obj G).H q),
        WeilEtaleTrianglePullbackMapsTo p_inf (p_i i) (u_i i) hu G q s_i 0 →
        ∃ (j : ℐ) (θ : Quiver.Hom i j)
          (hθ : CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Spec.map (B.map θ)) (p_i i) = p_i j),
          WeilEtaleTrianglePullbackMapsTo (p_i j) (p_i i) (AlgebraicGeometry.Spec.map (B.map θ)) hθ G q s_i 0)
noncomputable abbrev weilEtaleLocalTorsionSheaf (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    (U : S.Etale) :
    CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
  CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology U
    (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))

noncomputable def weilEtaleLocalTorsionCounit (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    (U : S.Etale) :
    Quiver.Hom (weilEtaleLocalTorsionSheaf S m U) (weilEtaleTorsionSheaf S m) :=
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let J := S.smallEtaleTopology
  CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
    (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
      ((CategoryTheory.Functor.const (Opposite S.Etale)).obj AM)).app
      (Opposite.op U))

noncomputable def weilEtaleLocalTorsionMap (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    {U₁ U₂ : S.Etale} (u : Quiver.Hom U₁ U₂) :
    Quiver.Hom (weilEtaleLocalTorsionSheaf S m U₁) (weilEtaleLocalTorsionSheaf S m U₂) :=
  CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
    (CategoryTheory.CategoryStruct.comp
      (CategoryTheory.Sheaf.freeYonedaHomEquiv
        (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m U₂)))
      ((weilEtaleLocalTorsionSheaf S m U₂).obj.map (Opposite.op u)))

noncomputable abbrev weilEtaleLocalTorsionH (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    (U : S.Etale) (q : ℕ) : Type u :=
  (weilEtaleLocalTorsionSheaf S m U).H q

noncomputable def weilEtaleLocalTorsionMapH (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    {U₁ U₂ : S.Etale} (u : Quiver.Hom U₁ U₂) (q : ℕ) :
    weilEtaleLocalTorsionH S m U₁ q →+ weilEtaleLocalTorsionH S m U₂ q :=
  (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S m u)).postcomp
    ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero q)

noncomputable def weilEtaleLocalTorsionCounitH (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    (U : S.Etale) (q : ℕ) :
    weilEtaleLocalTorsionH S m U q →+ weilEtaleTorsionH S m q :=
  (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionCounit S m U)).postcomp
    ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero q)

noncomputable def weilEtaleLocalTorsionTransition (S : AlgebraicGeometry.Scheme.{u})
    (ℓ r : ℕ) (U : S.Etale) (q : ℕ) :
    weilEtaleLocalTorsionH S (ℓ ^ (r + 1)) U q →+ weilEtaleLocalTorsionH S (ℓ ^ r) U q :=
  let J := S.smallEtaleTopology
  let c := AddCommGrpCat.uliftFunctor.{u, 0}.map
    (AddCommGrpCat.ofHom
      (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom)
  let φ : Quiver.Hom (weilEtaleLocalTorsionSheaf S (ℓ ^ (r + 1)) U)
      (weilEtaleLocalTorsionSheaf S (ℓ ^ r) U) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
      (CategoryTheory.CategoryStruct.comp c
        (CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S (ℓ ^ r) U))))
  (CategoryTheory.Abelian.Ext.mk₀ φ).postcomp
    ((CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero q)

def WeilHasTorsionLocalEffacement (S : AlgebraicGeometry.Scheme.{u}) (d m : ℕ)
    (tr_m : weilEtaleTorsionH S m (2 * d) →+ ZMod m) : Prop :=
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  ∀ (x : ↥S),
    let κ := S.residueField x
    let Ω := AlgebraicClosure ↥κ
    let gx : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
        (S.fromSpecResidueField x)
    ∀ (U : S.Etale) (γ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (Fgt.obj U).left),
      CategoryTheory.CategoryStruct.comp γ (Fgt.obj U).hom = gx →
      ∃ (U' : S.Etale) (v : Quiver.Hom U' U)
        (γ' : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (Fgt.obj U').left),
        CategoryTheory.CategoryStruct.comp γ' (Fgt.obj U').hom = gx ∧
        CategoryTheory.CategoryStruct.comp γ' (Fgt.map v).left = γ ∧
        (∀ (q : ℕ), q < 2 * d → ∀ z : weilEtaleLocalTorsionH S m U' q,
          weilEtaleLocalTorsionMapH S m v q z = 0) ∧
        Function.Bijective (fun z : weilEtaleLocalTorsionH S m U' (2 * d) =>
          tr_m (weilEtaleLocalTorsionCounitH S m U' (2 * d) z))

noncomputable def weilAffineSpaceOver (k : Type u) [CommRing k] (d : ℕ) :
