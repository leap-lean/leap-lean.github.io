        CategoryTheory.MorphismProperty.Over.homMk T_W.hom rfl trivial
      let η_L : Quiver.Hom FM_W (h_res.obj L_S) :=
        (adj_W.homEquiv AM (h_res.obj L_S)).symm
          (CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_S))
            (L_S.obj.map (Opposite.op u_TW)))
      adj_sh.homEquiv FM_W L_S e_L.hom = η_L ∧
      CategoryTheory.CategoryStruct.comp q_sW
        (adj_sh.homEquiv (sW_push.obj Fℤ_Z) (sS_push.obj Fℤ_Z) e_supp.hom) =
        CategoryTheory.CategoryStruct.comp ιℤ_h (h_res.map q_sS) ∧
      z_S = (CategoryTheory.Abelian.Ext.mk₀ e_L.hom).postcomp Fℤ_S (Nat.add_zero q)
        ((CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.CategoryStruct.comp q_sS e_supp.inv)).comp
          ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ L_sh _ _ _ _ _
            (sW_push.obj Fℤ_Z) FM_W q) α_W.val)
          (Nat.zero_add q))
structure WeilFilteredAbelianSystem.{u} (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] where
  obj : ℐ → AddCommGrpCat.{u}
  pt : AddCommGrpCat.{u}
  map : ∀ {i j : ℐ}, Quiver.Hom i j → (↥(obj i) →+ ↥(obj j))
  leg : ∀ i : ℐ, ↥(obj i) →+ ↥pt
  map_comp : ∀ {i j l : ℐ} (θ : Quiver.Hom i j) (θ' : Quiver.Hom j l) (x : ↥(obj i)),
    map (CategoryTheory.CategoryStruct.comp θ θ') x = map θ' (map θ x)
  leg_map : ∀ {i j : ℐ} (θ : Quiver.Hom i j) (x : ↥(obj i)),
    leg j (map θ x) = leg i x

def WeilFilteredAbelianColimSurj.{u} {ℐ : Type u} [CategoryTheory.SmallCategory ℐ]
    (S : WeilFilteredAbelianSystem.{u} ℐ) : Prop :=
  ∀ x_inf : ↥S.pt, ∃ (i : ℐ) (x_i : ↥(S.obj i)), S.leg i x_i = x_inf

def WeilFilteredAbelianColimInj.{u} {ℐ : Type u} [CategoryTheory.SmallCategory ℐ]
    (S : WeilFilteredAbelianSystem.{u} ℐ) : Prop :=
  ∀ (i : ℐ) (x_i : ↥(S.obj i)), S.leg i x_i = 0 →
    ∃ (j : ℐ) (θ : Quiver.Hom i j), S.map θ x_i = 0
def WeilTopDegKummerIsChartGraphRoof (k : Type u) [Field k] (d : ℕ)
    (P_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
