  covPres : CategoryTheory.CoverPreserving (weilGysinAxisRecollTop Y) (weilGysinAxisRecollTop X) functor
  isContinuous : functor.IsContinuous (weilGysinAxisRecollTop Y) (weilGysinAxisRecollTop X)
  flat : CategoryTheory.RepresentablyFlat functor
  hContLarge :
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) g :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_g : CategoryTheory.Functor Y.Etale X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
    B_g.IsContinuous Y.smallEtaleTopology X.smallEtaleTopology
  isoSpec :
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) g :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_g : CategoryTheory.Functor Y.Etale X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
    CategoryTheory.Iso
      (CategoryTheory.Functor.comp functor (weilGysinAxisRecollAffSpec X))
      (CategoryTheory.Functor.comp (weilGysinAxisRecollAffSpec Y) B_g)

def WeilGysinAxisRecollPred {Z Y : AlgebraicGeometry.Scheme.{u}}
    (i : Quiver.Hom Z Y) (W : weilGysinAxisRecollSite Y) : Prop :=
  Set.range ((weilGysinAxisRecollAffSpec Y).obj W).hom.base ⊆ (Set.range i.base)ᶜ

def WeilGysinAxisRecollSiteCoverData {C_Y C_Z : Type u}
    [CategoryTheory.SmallCategory C_Y] [CategoryTheory.SmallCategory C_Z]
    (J_Y : CategoryTheory.GrothendieckTopology C_Y)
    (J_Z : CategoryTheory.GrothendieckTopology C_Z)
    (b : CategoryTheory.Functor C_Y C_Z)
    (P : C_Y → Prop) : Prop :=
  (∀ {W' W : C_Y}, Quiver.Hom W' W → P W → P W') ∧
  (∀ W : C_Y, P W → (⊥ : CategoryTheory.Sieve (b.obj W)) ∈ J_Z (b.obj W)) ∧
  (∀ (V : C_Y) (S_Z : CategoryTheory.Sieve (b.obj V))
      (R_good : ∀ ⦃W : C_Y⦄, Quiver.Hom W V → Prop),
    S_Z ∈ J_Z (b.obj V) →
    (∀ ⦃W' W : C_Y⦄ (h : Quiver.Hom W' W) (g : Quiver.Hom W V),
      R_good g → R_good (CategoryTheory.CategoryStruct.comp h g)) →
    (∀ ⦃W : C_Y⦄ (f : Quiver.Hom W V), P W → R_good f) →
    (∀ ⦃U : C_Z⦄ (u : Quiver.Hom U (b.obj V)),
      S_Z.arrows u →
      ∃ (W_u : C_Y) (g_u : Quiver.Hom W_u V) (α_u : Quiver.Hom U (b.obj W_u)),
        CategoryTheory.CategoryStruct.comp α_u (b.map g_u) = u ∧ R_good g_u) →
    ∃ S_Y ∈ J_Y V, ∀ ⦃W : C_Y⦄ (f : Quiver.Hom W V), S_Y.arrows f → R_good f) ∧
  (∀ (W₂ : C_Y) (U : C_Z) (β : Quiver.Hom U (b.obj W₂)),
    ∃ (Idx : Type u) (W_fam : Idx → C_Y)
      (ψ_fam : ∀ γ : Idx, Quiver.Hom (W_fam γ) W₂)
      (θ_fam : ∀ γ : Idx, Quiver.Hom (b.obj (W_fam γ)) U),
      (∀ γ : Idx, CategoryTheory.CategoryStruct.comp (θ_fam γ) β = b.map (ψ_fam γ)) ∧
      CategoryTheory.Sieve.generate
        (CategoryTheory.Presieve.ofArrows (fun γ => b.obj (W_fam γ)) θ_fam) ∈ J_Z U)

noncomputable def weilGysinAxisRecollPushIso
    {C₁ : Type u₁} [CategoryTheory.Category.{v₁, u₁} C₁]
    {C₂ : Type u₂} [CategoryTheory.Category.{v₂, u₂} C₂]
    (J₁ : CategoryTheory.GrothendieckTopology C₁)
    (J₂ : CategoryTheory.GrothendieckTopology C₂)
    (R : Type u) [CommRing R]
    {F₁ F₂ : CategoryTheory.Functor C₁ C₂}
    [F₁.IsContinuous J₁ J₂] [F₂.IsContinuous J₁ J₂]
    (e : CategoryTheory.Iso F₁ F₂) :
    CategoryTheory.Iso
      (F₁.sheafPushforwardContinuous (ModuleCat.{u, u} R) J₁ J₂)
      (F₂.sheafPushforwardContinuous (ModuleCat.{u, u} R) J₁ J₂) :=
  let ModR := ModuleCat.{u, u} R
  CategoryTheory.NatIso.ofComponents
    (fun 𝒢 =>
      { hom := CategoryTheory.ObjectProperty.homMk
          ({ app := fun V => 𝒢.obj.map (e.inv.app (Opposite.unop V)).op
             naturality := fun {_ _} f =>
               (((𝒢.obj.map_comp _ _).symm.trans
                 (congrArg 𝒢.obj.map (CategoryTheory.op_comp.symm.trans
                   (congrArg Quiver.Hom.op (e.inv.naturality f.unop))))).trans
                 ((congrArg 𝒢.obj.map CategoryTheory.op_comp).trans (𝒢.obj.map_comp _ _))).symm } :
            CategoryTheory.NatTrans
              ((F₁.sheafPushforwardContinuous ModR J₁ J₂).obj 𝒢).obj
              ((F₂.sheafPushforwardContinuous ModR J₁ J₂).obj 𝒢).obj)
        inv := CategoryTheory.ObjectProperty.homMk
          ({ app := fun V => 𝒢.obj.map (e.hom.app (Opposite.unop V)).op
             naturality := fun {_ _} f =>
               (((𝒢.obj.map_comp _ _).symm.trans
                 (congrArg 𝒢.obj.map (CategoryTheory.op_comp.symm.trans
                   (congrArg Quiver.Hom.op (e.hom.naturality f.unop))))).trans
                 ((congrArg 𝒢.obj.map CategoryTheory.op_comp).trans (𝒢.obj.map_comp _ _))).symm } :
            CategoryTheory.NatTrans
              ((F₂.sheafPushforwardContinuous ModR J₁ J₂).obj 𝒢).obj
              ((F₁.sheafPushforwardContinuous ModR J₁ J₂).obj 𝒢).obj)
        hom_inv_id := CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun V =>
          (𝒢.obj.map_comp _ _).symm.trans
            ((congrArg 𝒢.obj.map (CategoryTheory.op_comp.symm.trans
              (congrArg Quiver.Hom.op (e.hom_inv_id_app (Opposite.unop V))))).trans
              (𝒢.obj.map_id _))))
        inv_hom_id := CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun V =>
          (𝒢.obj.map_comp _ _).symm.trans
            ((congrArg 𝒢.obj.map (CategoryTheory.op_comp.symm.trans
              (congrArg Quiver.Hom.op (e.inv_hom_id_app (Opposite.unop V))))).trans
              (𝒢.obj.map_id _)))) })
    (fun {_ _} φ => CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun V =>
      (φ.hom.naturality (e.inv.app (Opposite.unop V)).op).symm)))

