             CategoryTheory.Sheaf.cohomologyPresheaf G 2
           let P₁ : CategoryTheory.Functor (Opposite (Pd δ).Etale) AddCommGrpCat.{u} :=
             CategoryTheory.Functor.comp (weilEtaleSitePullback f).op Q₁
           let P₂ : CategoryTheory.Functor (Opposite (Pd δ).Etale) AddCommGrpCat.{u} :=
             CategoryTheory.Functor.comp (weilEtaleSitePullback h_Wf).op Q₂
           let η₁ := (CategoryTheory.sheafificationAdjunction (Pd δ).smallEtaleTopology
             AddCommGrpCat.{u}).unit.app P₁
           let η₂ := (CategoryTheory.sheafificationAdjunction (Pd δ).smallEtaleTopology
             AddCommGrpCat.{u}).unit.app P₂
           let e_B : CategoryTheory.Iso (weilEtaleSitePullback h_Wf)
               (CategoryTheory.Functor.comp (weilEtaleSitePullback f) (weilEtaleSitePullback g)) :=
             CategoryTheory.Iso.trans
               (CategoryTheory.MorphismProperty.Over.pullbackCongr hg.symm)
               (CategoryTheory.MorphismProperty.Over.pullbackComp g f)
           ∀ (V : (Pd δ).Etale)
             (s : ↑(Q₁.obj (Opposite.op ((weilEtaleSitePullback f).obj V)))),
             let s' : ↑(Q₂.obj (Opposite.op ((weilEtaleSitePullback h_Wf).obj V))) :=
               (CategoryTheory.Abelian.Ext.mk₀ (adj_g.counit.app G)).postcomp
                 (weilPolyP1CohomologyRepSheaf W_top ((weilEtaleSitePullback h_Wf).obj V)) (Nat.add_zero 2)
                 ((CategoryTheory.Abelian.Ext.mk₀
                     (weilPolyP1CohomologyRepPullHom g
                       ((weilEtaleSitePullback f).obj V)
                       ((weilEtaleSitePullback h_Wf).obj V)
                       (e_B.hom.app V))).comp
                   ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_g _ _ _ _ _
                     (weilPolyP1CohomologyRepSheaf Y ((weilEtaleSitePullback f).obj V))
                     (pf_g.obj G) 2) s)
                   (Nat.zero_add 2))
             (e_R2.hom.hom.app (Opposite.op V)) ((η₁.app (Opposite.op V)) s) =
               (η₂.app (Opposite.op V)) s') ∧
          (∀ (F_base : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
              (α : Quiver.Hom (pf_g.obj G) F_base)
              (y : (pf_g.obj G).H (2 * (δ + 1))),
            let y_W : G.H (2 * (δ + 1)) :=
              (CategoryTheory.Abelian.Ext.mk₀ (adj_g.counit.app G)).postcomp Fℤ_W
                (Nat.add_zero (2 * (δ + 1)))
                ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_g).comp
                  ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_g _ _ _ _ _
                    Fℤ_Y (pf_g.obj G) (2 * (δ + 1))) y)
                  (Nat.zero_add (2 * (δ + 1))))
            (CategoryTheory.Abelian.Ext.mk₀
                (CategoryTheory.CategoryStruct.comp e_R2.inv
                  (weilPolyP1HigherDirectImageMap f 2 α))).postcomp
              ((CategoryTheory.constantSheaf (Pd δ).smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
              (Nat.add_zero (2 * δ))
              (E_edge W_top h_Wf G hG_tor hz_gf y_W) =
            (CategoryTheory.Abelian.Ext.mk₀ (weilPolyP1HigherDirectImageMap f 2 α)).postcomp
              ((CategoryTheory.constantSheaf (Pd δ).smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
              (Nat.add_zero (2 * δ))
              (E_edge Y f (pf_g.obj G) hpf_tor hz_f y))

def WeilIsLerayEdgeAutoEquivariant (Pd : ℕ → AlgebraicGeometry.Scheme.{u}) (ℓ : ℕ)
    (E_edge : WeilLerayEdgeSystem Pd ℓ) : Prop :=
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  ∀ (δ r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Y (Pd δ))
      (β_S : CategoryTheory.Iso (Pd δ) (Pd δ))
      (β_Y : CategoryTheory.Iso Y Y),
    CategoryTheory.CategoryStruct.comp β_Y.hom f =
      CategoryTheory.CategoryStruct.comp f β_S.hom →
    ∀ (c_Y : weilEtaleTorsionH Y (ℓ ^ r) 2)
      (p_c : weilEtaleTorsionH Y (ℓ ^ r) 2 →+ weilEtaleTorsionH Y (ℓ ^ r) 2)
      (p_S : weilEtaleTorsionH (Pd δ) (ℓ ^ r) (2 * δ) →+
        weilEtaleTorsionH (Pd δ) (ℓ ^ r) (2 * δ))
      (p_Y : weilEtaleTorsionH Y (ℓ ^ r) (2 * (δ + 1)) →+
        weilEtaleTorsionH Y (ℓ ^ r) (2 * (δ + 1)))
      (γ : Quiver.Hom
        (weilEtaleTorsionSheaf (Pd δ) (ℓ ^ r))
        (weilEtaleHigherDirectImage f 2 (weilEtaleTorsionSheaf Y (ℓ ^ r))))
      (Tr : Quiver.Hom
        (weilEtaleHigherDirectImage f 2 (weilEtaleTorsionSheaf Y (ℓ ^ r)))
        (weilEtaleTorsionSheaf (Pd δ) (ℓ ^ r)))
      (hTor_Y : (ℓ ^ r) • CategoryTheory.CategoryStruct.id
        (weilEtaleTorsionSheaf Y (ℓ ^ r)) = 0)
      (hz_Y : ∀ b : ℕ, 3 ≤ b → CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f b (weilEtaleTorsionSheaf Y (ℓ ^ r)))),
      WeilIsTorsionEtalePullback β_Y.hom (ℓ ^ r) 2 p_c →
      p_c c_Y = c_Y →
      WeilIsTorsionEtalePullback β_S.hom (ℓ ^ r) (2 * δ) p_S →
      WeilIsTorsionEtalePullback β_Y.hom (ℓ ^ r) (2 * (δ + 1)) p_Y →
      CategoryTheory.CategoryStruct.comp γ Tr =
        CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf (Pd δ) (ℓ ^ r)) →
      CategoryTheory.CategoryStruct.comp Tr γ =
        CategoryTheory.CategoryStruct.id
          (weilEtaleHigherDirectImage f 2 (weilEtaleTorsionSheaf Y (ℓ ^ r))) →
      (∀ (T_S : (Pd δ).Etale) (hT_S : CategoryTheory.Limits.IsTerminal T_S)
         (hT_top : CategoryTheory.Limits.IsTerminal
           ((weilEtaleSitePullback f).obj T_S)),
        let Q_rel : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
          CategoryTheory.Sheaf.cohomologyPresheaf
            (weilEtaleTorsionSheaf Y (ℓ ^ r)) 2
        let P_rel : CategoryTheory.Functor (Opposite (Pd δ).Etale) AddCommGrpCat.{u} :=
          CategoryTheory.Functor.comp (weilEtaleSitePullback f).op Q_rel
        ((CategoryTheory.constantSheafAdj (Pd δ).smallEtaleTopology AddCommGrpCat.{u} hT_S).homEquiv
          (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ r))))
          (weilEtaleHigherDirectImage f 2 (weilEtaleTorsionSheaf Y (ℓ ^ r)))
          γ) (ULift.up 1) =
        (((CategoryTheory.sheafificationAdjunction (Pd δ).smallEtaleTopology
          AddCommGrpCat.{u}).unit.app P_rel).app
          (Opposite.op T_S))
          (weilPolyP1CohomologyTermToPresheaf Y
            ((weilEtaleSitePullback f).obj T_S) hT_top
            (weilEtaleTorsionSheaf Y (ℓ ^ r)) 2 c_Y)) →
      let tr_E : weilEtaleTorsionH Y (ℓ ^ r) (2 * (δ + 1)) →
          weilEtaleTorsionH (Pd δ) (ℓ ^ r) (2 * δ) :=
        fun u =>
          (CategoryTheory.Abelian.Ext.mk₀ Tr).postcomp
            ((CategoryTheory.constantSheaf (Pd δ).smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
            (Nat.add_zero (2 * δ))
            (E_edge δ r Y f (weilEtaleTorsionSheaf Y (ℓ ^ r)) hTor_Y hz_Y u)
      ∀ w : weilEtaleTorsionH Y (ℓ ^ r) (2 * (δ + 1)),
        tr_E (p_Y w) = p_S (tr_E w)

def WeilIsLerayEdgePkg (Pd : ℕ → AlgebraicGeometry.Scheme.{u}) (ℓ : ℕ)
    (E_edge : WeilLerayEdgeSystem Pd ℓ) : Prop :=
  WeilIsLerayEdgeNatural Pd ℓ E_edge ∧
  (∀ (δ r : ℕ), WeilIsLerayEdgePushforwardAt Pd ℓ δ r (E_edge δ r)) ∧
  WeilIsLerayEdgeAutoEquivariant Pd ℓ E_edge

noncomputable def weilPolyP1TraceStepHom (k : Type u) [CommRing k] (ℓ : ℕ)
    (Tr_rel : WeilRelTraceFamily k ℓ)
    (E_edge : WeilLerayEdgeSystem (fun δ : ℕ => (weilPolyP1Over k δ).left) ℓ)
    (hTor_std : ∀ (δ r : ℕ),
      (ℓ ^ r) • CategoryTheory.CategoryStruct.id
        (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left (ℓ ^ r)) = 0)
    (hz_std : ∀ (δ r b : ℕ), 3 ≤ b →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage
          (CategoryTheory.Limits.pullback.fst
            (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom) b
          (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left (ℓ ^ r))))
    (δ r : ℕ) :
    weilEtaleTorsionH (weilPolyP1Over k (δ + 1)).left (ℓ ^ r) (2 * (δ + 1)) →+
      weilEtaleTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) (2 * δ) :=
  let Pd := fun d : ℕ => (weilPolyP1Over k d).left
  let π_fst := fun d : ℕ => CategoryTheory.Limits.pullback.fst
    (weilPolyP1Over k d).hom (weilProjectiveSpaceOver k 1).hom
  (weilPolyP1RelTraceMapH k ℓ Tr_rel δ r).comp
    (E_edge δ r (Pd (δ + 1)) (π_fst δ)
      (weilEtaleTorsionSheaf (Pd (δ + 1)) (ℓ ^ r))
      (hTor_std δ r) (hz_std δ r)).toAddMonoidHom

noncomputable def weilPolyP1TraceTowerRec (k : Type u) [CommRing k] (ℓ : ℕ)
    (tr₀ : ∀ r : ℕ, weilEtaleTorsionH (weilPolyP1Over k 0).left (ℓ ^ r) (2 * 0) →+ ZMod (ℓ ^ r))
    (step : ∀ (δ r : ℕ),
      weilEtaleTorsionH (weilPolyP1Over k (δ + 1)).left (ℓ ^ r) (2 * (δ + 1)) →+
        weilEtaleTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) (2 * δ)) :
    ∀ (δ r : ℕ), weilEtaleTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) (2 * δ) →+ ZMod (ℓ ^ r)
  | 0, r => tr₀ r
  | δ + 1, r => (weilPolyP1TraceTowerRec k ℓ tr₀ step δ r).comp (step δ r)
def WeilCurveRepTower.{u} (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)))
      (weilProjectiveSpaceOver F 1).left)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (u₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F))
      (weilProjectiveSpaceOver F 1).left)
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)]
    (H_geom : Subgroup ((Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ))
    (A_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (A_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin N) (Fin N) (PadicInt ℓ)) : Prop :=
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  ∃ (a₀ : F) (_ : a₀ ∉ S_aff)
    (B L_fld : ℕ → Type u)
    (_ : ∀ r, CommRing (B r)) (_ : ∀ r, IsDomain (B r)) (_ : ∀ r, Field (L_fld r))
    (_ : ∀ r, Algebra F (B r)) (_ : ∀ r, Algebra (Polynomial F) (B r)) (_ : ∀ r, Algebra R₀ (B r))
    (_ : ∀ r, Algebra F (L_fld r)) (_ : ∀ r, Algebra (Polynomial F) (L_fld r))
    (_ : ∀ r, Algebra (RatFunc F) (L_fld r))
    (_ : ∀ r, Algebra (B r) (L_fld r)) (_ : ∀ r, Algebra R₀ (L_fld r))
    (_ : ∀ r, IsScalarTower F (Polynomial F) (B r)) (_ : ∀ r, IsScalarTower (Polynomial F) R₀ (B r))
    (_ : ∀ r, IsScalarTower F (RatFunc F) (L_fld r))
    (_ : ∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_fld r))
    (_ : ∀ r, IsScalarTower (Polynomial F) (B r) (L_fld r))
    (_ : ∀ r, IsScalarTower R₀ (B r) (L_fld r))
    (_ : ∀ r, Module.Finite R₀ (B r)) (_ : ∀ r, Algebra.Etale R₀ (B r))
    (_ : ∀ r, IsFractionRing (B r) (L_fld r)) (_ : ∀ r, IsIntegralClosure (B r) R₀ (L_fld r))
    (_ : ∀ r, FiniteDimensional (RatFunc F) (L_fld r)) (_ : ∀ r, IsGalois (RatFunc F) (L_fld r))
    (τ_rep : ∀ r : ℕ, (B r ≃ₐ[R₀] B r) →* (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))))ˣ)
    (ι_B : ∀ r : ℕ, B r →ₐ[R₀] B (r + 1))
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme),
    u₀ = CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a₀))) j_aff ∧
    CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀))) j_aff ∧
    (∀ (r : ℕ) (h : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ), h ∈ H_geom →
      ∃ σ : B r ≃ₐ[R₀] B r,
        (∀ x : B r, IsIntegral F x → σ x = x) ∧
        (τ_rep r σ).val = (h.val).map (PadicInt.toZModPow (r + 1))) ∧
    (∀ (r : ℕ) (σ : B r ≃ₐ[R₀] B r),
      (∀ x : B r, IsIntegral F x → σ x = x) →
      ∃ h ∈ H_geom, (τ_rep r σ).val = (h.val).map (PadicInt.toZModPow (r + 1))) ∧
    (∀ r : ℕ, Function.Injective (ι_B r) ∧
      ∀ τ : B (r + 1) ≃ₐ[R₀] B (r + 1),
        ∃ σ : B r ≃ₐ[R₀] B r,
          (∀ b : B r, τ (ι_B r b) = ι_B r (σ b)) ∧
          ((τ_rep (r + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) _) =
            (τ_rep r σ).val) ∧
    (∃ Q_u : ∀ r : ℕ, Ideal (B r),
      (∀ r : ℕ, (Q_u r).IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_u r) =
          Ideal.span {Polynomial.X - Polynomial.C a₀} ∧
        Ideal.comap (ι_B r).toRingHom (Q_u (r + 1)) = Q_u r ∧
        ∃ σ_u : B r ≃ₐ[R₀] B r,
          (∀ b : B r, σ_u.symm b - b ^ Nat.card F ∈ Q_u r) ∧
          (τ_rep r σ_u).val = (A_u.val).map (PadicInt.toZModPow (r + 1)))) ∧
    (∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
      ∃ Q_P : ∀ r : ℕ, Ideal (B r),
        ∀ r : ℕ, (Q_P r).IsMaximal ∧
          Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_P r) = Ideal.span {P} ∧
          Ideal.comap (ι_B r).toRingHom (Q_P (r + 1)) = Q_P r ∧
          ∃ σ : B r ≃ₐ[R₀] B r,
            (∀ b : B r, σ.symm b - b ^ (Nat.card F ^ d) ∈ Q_P r) ∧
            (τ_rep r σ).val = (A_mat d P hP).map (PadicInt.toZModPow (r + 1)))

