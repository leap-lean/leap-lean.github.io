    (B : CategoryTheory.Functor ℐ CommRingCat.{u})
    (α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj B₀) B)
    (c : CategoryTheory.Limits.Cocone B) (_ : CategoryTheory.Limits.IsColimit c)
    (f_inf : Quiver.Hom B₀ c.pt),
    (∀ i : ℐ, CategoryTheory.CategoryStruct.comp (α.app i) (c.ι.app i) = f_inf) →
    let Z₀ := AlgebraicGeometry.Spec B₀
