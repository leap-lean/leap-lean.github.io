          CategoryTheory.CategoryStruct.comp π₁ (weilProjectiveSpaceOver Ω 1).hom = C_bar.hom →
          CategoryTheory.CategoryStruct.comp π₂ (weilProjectiveSpaceOver Ω 1).hom = C_bar.hom →
          ∀ (v₁ v₂ : Quiver.Hom C_open.toScheme (weilGysinAffineSpace Ω 1)),
            AlgebraicGeometry.Etale v₁ →
            AlgebraicGeometry.Etale v₂ →
            CategoryTheory.CategoryStruct.comp v₁ (weilGysinAffineStruct Ω 1) =
              CategoryTheory.CategoryStruct.comp C_open.ι C_bar.hom →
            CategoryTheory.CategoryStruct.comp v₂ (weilGysinAffineStruct Ω 1) =
              CategoryTheory.CategoryStruct.comp C_open.ι C_bar.hom →
            CategoryTheory.CategoryStruct.comp C_open.ι π₁ =
              CategoryTheory.CategoryStruct.comp v₁ ι_P1 →
            CategoryTheory.CategoryStruct.comp C_open.ι π₂ =
              CategoryTheory.CategoryStruct.comp v₂ ι_P1 →
            ∀ (hv₁_P1 : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp v₁ ι_P1))
              (hv₂_P1 : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp v₂ ι_P1))
              (r : ℕ)
              (z_C : weilGysinLocalTorsionH C_bar.left (ℓ ^ r)
                (weilGysinEtaleObj C_open.ι inferInstance) 2)
              (z₁ : weilGysinLocalTorsionH (weilProjectiveSpaceOver Ω 1).left (ℓ ^ r)
                (weilGysinEtaleObj (CategoryTheory.CategoryStruct.comp v₁ ι_P1) hv₁_P1) 2)
              (z₂ : weilGysinLocalTorsionH (weilProjectiveSpaceOver Ω 1).left (ℓ ^ r)
                (weilGysinEtaleObj (CategoryTheory.CategoryStruct.comp v₂ ι_P1) hv₂_P1) 2),
              WeilGysinIsClopenPullbackOnLocalH π₁
                (weilGysinEtaleObj C_open.ι inferInstance)
                (weilGysinEtaleObj (CategoryTheory.CategoryStruct.comp v₁ ι_P1) hv₁_P1)
                (CategoryTheory.Iso.refl C_open.toScheme) (ℓ ^ r) 2 z₁ z_C →
              WeilGysinIsClopenPullbackOnLocalH π₂
                (weilGysinEtaleObj C_open.ι inferInstance)
                (weilGysinEtaleObj (CategoryTheory.CategoryStruct.comp v₂ ι_P1) hv₂_P1)
                (CategoryTheory.Iso.refl C_open.toScheme) (ℓ ^ r) 2 z₂ z_C →
              weilGysinLocalTorsionCounitH (weilProjectiveSpaceOver Ω 1).left (ℓ ^ r)
                (weilGysinEtaleObj (CategoryTheory.CategoryStruct.comp v₁ ι_P1) hv₁_P1) 2 z₁ =
              weilGysinLocalTorsionCounitH (weilProjectiveSpaceOver Ω 1).left (ℓ ^ r)
