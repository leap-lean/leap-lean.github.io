def WeilTransvTriCurveSymplecticTower.{u} (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)))
      (weilProjectiveSpaceOver F 1).left)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (u₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F))
      (weilProjectiveSpaceOver F 1).left)
    (ℓ M : ℕ) [Fact (Nat.Prime ℓ)]
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
    (F_u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ)
    (F_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin M) (Fin M) (PadicInt ℓ))
    (ℒ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
    (τ_ℒ : ∀ r : ℕ, Quiver.Hom (ℒ₀ (r + 1)) (ℒ₀ r)) : Prop :=
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  ∃ (a₀ : F) (_ : a₀ ∉ S_aff)
    (B L_fld : ℕ → Type u)
    (_ : ∀ r, CommRing (B r)) (_ : ∀ r, IsDomain (B r)) (_ : ∀ r, Field (L_fld r))
    (_ : ∀ r, Algebra F (B r)) (_ : ∀ r, Algebra (Polynomial F) (B r)) (_ : ∀ r, Algebra R₀ (B r))
    (_ : ∀ r, Algebra F (L_fld r)) (_ : ∀ r, Algebra (Polynomial F) (L_fld r))
    (_ : ∀ r, Algebra (RatFunc F) (L_fld r))
    (_ : ∀ r, Algebra (B r) (L_fld r)) (_ : ∀ r, Algebra R₀ (L_fld r))
    (_ : ∀ r, IsScalarTower F (Polynomial F) (B r)) (_ : ∀ r, IsScalarTower (Polynomial F) R₀ (B r))
    (_ : ∀ r, IsScalarTower F (RatFunc F) (L_fld r))
    (_ : ∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_fld r))
    (_ : ∀ r, IsScalarTower (Polynomial F) (B r) (L_fld r))
    (_ : ∀ r, IsScalarTower R₀ (B r) (L_fld r))
    (_ : ∀ r, Module.Finite R₀ (B r)) (_ : ∀ r, Algebra.Etale R₀ (B r))
    (_ : ∀ r, IsFractionRing (B r) (L_fld r)) (_ : ∀ r, IsIntegralClosure (B r) R₀ (L_fld r))
    (_ : ∀ r, FiniteDimensional (RatFunc F) (L_fld r)) (_ : ∀ r, IsGalois (RatFunc F) (L_fld r))
    (ρ : ∀ r : ℕ, (B r ≃ₐ[R₀] B r) →* (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ)
    (ι_B : ∀ r : ℕ, B r →ₐ[R₀] B (r + 1))
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme),
    u₀ = CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a₀))) j_aff ∧
    CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀))) j_aff ∧
    (∀ r : ℕ, Function.Injective (ρ r)) ∧
    (∀ (r : ℕ) (g : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ), g ∈ G_geom →
      ∃ σ : B r ≃ₐ[R₀] B r,
        (∀ x : B r, IsIntegral F x → σ x = x) ∧
        (ρ r σ).val = (g.val).map (PadicInt.toZModPow (r + 1))) ∧
    (∀ (r : ℕ) (σ : B r ≃ₐ[R₀] B r),
      (∀ x : B r, IsIntegral F x → σ x = x) →
      ∃ g ∈ G_geom, (ρ r σ).val = (g.val).map (PadicInt.toZModPow (r + 1))) ∧
    (∀ r : ℕ, Function.Injective (ι_B r) ∧
      ∀ τ : B (r + 1) ≃ₐ[R₀] B (r + 1),
        ∃ σ : B r ≃ₐ[R₀] B r,
          (∀ b : B r, τ (ι_B r b) = ι_B r (σ b)) ∧
          ((ρ (r + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) _) =
            (ρ r σ).val) ∧
    (∃ Q_u : ∀ r : ℕ, Ideal (B r),
      (∀ r : ℕ, (Q_u r).IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_u r) =
          Ideal.span {Polynomial.X - Polynomial.C a₀} ∧
        Ideal.comap (ι_B r).toRingHom (Q_u (r + 1)) = Q_u r ∧
        ∃ σ_u : B r ≃ₐ[R₀] B r,
          (∀ b : B r, σ_u.symm b - b ^ Nat.card F ∈ Q_u r) ∧
          (ρ r σ_u).val = (F_u.val).map (PadicInt.toZModPow (r + 1)))) ∧
    (∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
      ∃ Q_P : ∀ r : ℕ, Ideal (B r),
        ∀ r : ℕ, (Q_P r).IsMaximal ∧
          Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_P r) = Ideal.span {P} ∧
          Ideal.comap (ι_B r).toRingHom (Q_P (r + 1)) = Q_P r ∧
          ∃ σ : B r ≃ₐ[R₀] B r,
            (∀ b : B r, σ.symm b - b ^ (Nat.card F ^ d) ∈ Q_P r) ∧
            (ρ r σ).val = (F_mat d P hP).map (PadicInt.toZModPow (r + 1))) ∧
    (∃ triv : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) e_U.hom
        let W_r := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_r
        ↑((ℒ₀ r).obj.obj (Opposite.op W)) →+
          (LocallyConstant ↥W_r (Fin M → ZMod (ℓ ^ (r + 1)))),
      ∀ r : ℕ,
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) e_U.hom
        let π_succ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (B (r + 1)))) U₀.toScheme :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B (r + 1))))) e_U.hom
        let A_r : AddCommGrpCat.{u} :=
          AddCommGrpCat.uliftFunctor.{u, 0}.obj
            (AddCommGrpCat.of (Fin M → ZMod (ℓ ^ (r + 1))))
        WeilIsEtaleSheafPullback π_r (ℒ₀ r)
          ((CategoryTheory.constantSheaf V_r.smallEtaleTopology AddCommGrpCat.{u}).obj A_r) ∧
        (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
          let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
          let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
          ∀ (u_r : Quiver.Hom W₁_r W₂_r),
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst h₁ π_r)
                ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
              CategoryTheory.Limits.pullback.snd h₁ π_r →
            ∀ (s : ↑((ℒ₀ r).obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
              triv r W₁ (((ℒ₀ r).obj.map (Opposite.op u)) s) y₁ =
                triv r W₂ s (u_r.base y₁)) ∧
        ∀ (W : U₀.toScheme.Etale),
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_r := CategoryTheory.Limits.pullback h_W π_r
          let W_succ := CategoryTheory.Limits.pullback h_W π_succ
          Function.Injective (triv r W) ∧
          Set.range (triv r W) =
            { f | ∀ (σ : B r ≃ₐ[R₀] B r) (m_σ : Quiver.Hom W_r W_r),
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π_r) =
