def WeilGysinSuppCalcHasExactPullbacks.{u} : Prop :=
  ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂),
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor W₂.Etale W₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    ∃ (hc : B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology),
      letI := hc
      let pf_ab := B.sheafPushforwardContinuous AddCommGrpCat.{u}
        W₂.smallEtaleTopology W₁.smallEtaleTopology
      ∃ (pb_ab : CategoryTheory.Functor
            (CategoryTheory.Sheaf W₂.smallEtaleTopology AddCommGrpCat.{u})
            (CategoryTheory.Sheaf W₁.smallEtaleTopology AddCommGrpCat.{u}))
        (adj_ab : CategoryTheory.Adjunction pb_ab pf_ab),
        pb_ab.Additive ∧
        CategoryTheory.Limits.PreservesFiniteLimits pb_ab ∧
        CategoryTheory.Limits.PreservesFiniteColimits pb_ab ∧
        (∀ (A : AddCommGrpCat.{u})
          (T₁ : W₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
          (T₂ : W₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
          let C₁ := CategoryTheory.constantSheaf W₁.smallEtaleTopology AddCommGrpCat.{u}
          let C₂ := CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}
          let adj₁ := CategoryTheory.constantSheafAdj W₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
          let adj₂ := CategoryTheory.constantSheafAdj W₂.smallEtaleTopology AddCommGrpCat.{u} hT₂
          let τ_h : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
          let π_A : Quiver.Hom (pb_ab.obj (C₂.obj A)) (C₁.obj A) :=
            (adj_ab.homEquiv (C₂.obj A) (C₁.obj A)).symm
              ((adj₂.homEquiv A (pf_ab.obj (C₁.obj A))).symm
                (CategoryTheory.CategoryStruct.comp (adj₁.unit.app A) ((C₁.obj A).obj.map τ_h.op)))
          ∃ ι_A : Quiver.Hom (C₁.obj A) (pb_ab.obj (C₂.obj A)),
            CategoryTheory.CategoryStruct.comp ι_A π_A = CategoryTheory.CategoryStruct.id (C₁.obj A) ∧
            CategoryTheory.CategoryStruct.comp π_A ι_A =
              CategoryTheory.CategoryStruct.id (pb_ab.obj (C₂.obj A))) ∧
        (∀ (m : ℕ), 1 ≤ m →
          let R := ULift.{u, 0} (ZMod m)
          let R_mod := ModuleCat.of R R
          let pf_mod := B.sheafPushforwardContinuous (ModuleCat.{u, u} R)
            W₂.smallEtaleTopology W₁.smallEtaleTopology
          ∃ (pb_mod : CategoryTheory.Functor
                (CategoryTheory.Sheaf W₂.smallEtaleTopology (ModuleCat.{u, u} R))
                (CategoryTheory.Sheaf W₁.smallEtaleTopology (ModuleCat.{u, u} R)))
            (adj_mod : CategoryTheory.Adjunction pb_mod pf_mod),
            pb_mod.Additive ∧
            CategoryTheory.Limits.PreservesFiniteLimits pb_mod ∧
            CategoryTheory.Limits.PreservesFiniteColimits pb_mod ∧
            ∀ (T₁ : W₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
              (T₂ : W₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
              let One₁ := (CategoryTheory.constantSheaf W₁.smallEtaleTopology (ModuleCat.{u, u} R)).obj R_mod
              let One₂ := (CategoryTheory.constantSheaf W₂.smallEtaleTopology (ModuleCat.{u, u} R)).obj R_mod
              let adj₁ := CategoryTheory.constantSheafAdj W₁.smallEtaleTopology (ModuleCat.{u, u} R) hT₁
              let adj₂ := CategoryTheory.constantSheafAdj W₂.smallEtaleTopology (ModuleCat.{u, u} R) hT₂
              let τ_h : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
              let π_mod : Quiver.Hom (pb_mod.obj One₂) One₁ :=
                (adj_mod.homEquiv One₂ One₁).symm
                  ((adj₂.homEquiv R_mod (pf_mod.obj One₁)).symm
                    (CategoryTheory.CategoryStruct.comp (adj₁.unit.app R_mod) (One₁.obj.map τ_h.op)))
              ∃ ι_mod : Quiver.Hom One₁ (pb_mod.obj One₂),
                CategoryTheory.CategoryStruct.comp ι_mod π_mod = CategoryTheory.CategoryStruct.id One₁ ∧
                CategoryTheory.CategoryStruct.comp π_mod ι_mod =
                  CategoryTheory.CategoryStruct.id (pb_mod.obj One₂))

def WeilGysinSuppCalcIsIsoUnit.{u} (ℓ : ℕ)
    (τ_iso : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
      [CategoryTheory.IsIso i] (r : ℕ), WeilGysinSupportClass Z Y i (ℓ ^ r) 0) : Prop :=
  ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y) [CategoryTheory.IsIso i] (r : ℕ)
    (T_Y : Y.Etale) (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
    (T_Z : Z.Etale) (hT_Z : CategoryTheory.Limits.IsTerminal T_Z),
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let R := ULift.{u, 0} (ZMod (ℓ ^ r))
    let R_mod := ModuleCat.of R R
    let B : CategoryTheory.Functor Y.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
    letI := (τ_iso i r).hCont
    let i_push := B.sheafPushforwardContinuous (ModuleCat.{u, u} R)
      Y.smallEtaleTopology Z.smallEtaleTopology
    let One_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)).obj R_mod
    let One_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)).obj R_mod
    let adj_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology (ModuleCat.{u, u} R) hT_Y
    let adj_Z := CategoryTheory.constantSheafAdj Z.smallEtaleTopology (ModuleCat.{u, u} R) hT_Z
    let τ_i : Quiver.Hom (B.obj T_Y) T_Z := hT_Z.from (B.obj T_Y)
    let q_i : Quiver.Hom One_Y (i_push.obj One_Z) :=
      (adj_Y.homEquiv R_mod (i_push.obj One_Z)).symm
        (CategoryTheory.CategoryStruct.comp (adj_Z.unit.app R_mod) (One_Z.obj.map τ_i.op))
    ∃ p_i : Quiver.Hom (i_push.obj One_Z) One_Y,
      CategoryTheory.CategoryStruct.comp q_i p_i = CategoryTheory.CategoryStruct.id One_Y ∧
      CategoryTheory.CategoryStruct.comp p_i q_i =
        CategoryTheory.CategoryStruct.id (i_push.obj One_Z) ∧
      (τ_iso i r).val = CategoryTheory.Abelian.Ext.mk₀ p_i

def WeilGysinSuppCalcClosedExactAb.{u} : Prop :=
  ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
    AlgebraicGeometry.IsClosedImmersion i →
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor Y.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
    ∀ (hc : B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology),
      letI := hc
      let i_push_ab := B.sheafPushforwardContinuous AddCommGrpCat.{u}
        Y.smallEtaleTopology Z.smallEtaleTopology
      CategoryTheory.Limits.PreservesFiniteColimits i_push_ab ∧
      ∀ (T_Y : Y.Etale) (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
        (T_Z : Z.Etale) (hT_Z : CategoryTheory.Limits.IsTerminal T_Z),
        let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
        let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
        let Fℤ_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
        let adj_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT_Y
        let adj_Z := CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z
        let τ_i : Quiver.Hom (B.obj T_Y) T_Z := hT_Z.from (B.obj T_Y)
        let q_i_ab : Quiver.Hom Fℤ_Y (i_push_ab.obj Fℤ_Z) :=
          (adj_Y.homEquiv Aℤ (i_push_ab.obj Fℤ_Z)).symm
            (CategoryTheory.CategoryStruct.comp (adj_Z.unit.app Aℤ) (Fℤ_Z.obj.map τ_i.op))
        CategoryTheory.Epi q_i_ab
abbrev weilTwoChartOv₀ {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
    (T₀ : Type u) [CommRing T₀] [Algebra D.R₀ T₀] : Type u :=
  TensorProduct D.R₀ D.R₀₁ T₀

abbrev weilTwoChartOv₁ {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
    (T₁ : Type u) [CommRing T₁] [Algebra D.R₁ T₁] : Type u :=
  TensorProduct D.R₁ D.R₀₁ T₁

structure WeilTwoChartUnitQuad {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
    (T₀ T₁ : Type u) [CommRing T₀] [CommRing T₁] [Algebra D.R₀ T₀] [Algebra D.R₁ T₁] : Type u where
  g₀₀ : Units (TensorProduct D.R₀ T₀ T₀)
  g₀₁ : Units (TensorProduct D.R₀₁ (weilTwoChartOv₀ D T₀) (weilTwoChartOv₁ D T₁))
  g₁₀ : Units (TensorProduct D.R₀₁ (weilTwoChartOv₁ D T₁) (weilTwoChartOv₀ D T₀))
  g₁₁ : Units (TensorProduct D.R₁ T₁ T₁)

noncomputable def weilTwoChartQuadOne {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
    (T₀ T₁ : Type u) [CommRing T₀] [CommRing T₁] [Algebra D.R₀ T₀] [Algebra D.R₁ T₁] :
    WeilTwoChartUnitQuad D T₀ T₁ :=
  letI : CommRing (weilTwoChartOv₀ D T₀) := inferInstance
  letI : Algebra D.R₀₁ (weilTwoChartOv₀ D T₀) := inferInstance
  letI : CommRing (weilTwoChartOv₁ D T₁) := inferInstance
  letI : Algebra D.R₀₁ (weilTwoChartOv₁ D T₁) := inferInstance
  ⟨1, 1, 1, 1⟩

noncomputable def weilTwoChartQuadMul {B : Type u} [CommRing B] {D : WeilTwoChartRingDatum B}
    {T₀ T₁ : Type u} [CommRing T₀] [CommRing T₁] [Algebra D.R₀ T₀] [Algebra D.R₁ T₁]
    (q₁ q₂ : WeilTwoChartUnitQuad D T₀ T₁) : WeilTwoChartUnitQuad D T₀ T₁ :=
  letI : CommRing (weilTwoChartOv₀ D T₀) := inferInstance
  letI : Algebra D.R₀₁ (weilTwoChartOv₀ D T₀) := inferInstance
  letI : CommRing (weilTwoChartOv₁ D T₁) := inferInstance
  letI : Algebra D.R₀₁ (weilTwoChartOv₁ D T₁) := inferInstance
  ⟨q₁.g₀₀ * q₂.g₀₀, q₁.g₀₁ * q₂.g₀₁, q₁.g₁₀ * q₂.g₁₀, q₁.g₁₁ * q₂.g₁₁⟩

noncomputable def weilTwoChartQuadPow {B : Type u} [CommRing B] {D : WeilTwoChartRingDatum B}
    {T₀ T₁ : Type u} [CommRing T₀] [CommRing T₁] [Algebra D.R₀ T₀] [Algebra D.R₁ T₁]
    (q : WeilTwoChartUnitQuad D T₀ T₁) : ℕ → WeilTwoChartUnitQuad D T₀ T₁
  | 0 => weilTwoChartQuadOne D T₀ T₁
  | n + 1 => weilTwoChartQuadMul q (weilTwoChartQuadPow q n)

noncomputable def weilTwoChartCoboundary {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
    {T₀ T₁ : Type u} [CommRing T₀] [CommRing T₁] [Algebra D.R₀ T₀] [Algebra D.R₁ T₁]
    (u₀ : Units T₀) (u₁ : Units T₁) : WeilTwoChartUnitQuad D T₀ T₁ :=
  let T₀_ov := weilTwoChartOv₀ D T₀
  let T₁_ov := weilTwoChartOv₁ D T₁
  letI : CommRing T₀_ov := inferInstance
  letI : Algebra D.R₀₁ T₀_ov := inferInstance
  letI : CommRing T₁_ov := inferInstance
  letI : Algebra D.R₀₁ T₁_ov := inferInstance
  let A₀₁ := TensorProduct D.R₀₁ T₀_ov T₁_ov
  let A₁₀ := TensorProduct D.R₀₁ T₁_ov T₀_ov
  letI : CommRing A₀₁ := inferInstance
  letI : CommRing A₁₀ := inferInstance
  let ι₀₁_L : T₀ →+* A₀₁ :=
    (Algebra.TensorProduct.includeLeftRingHom (R := D.R₀₁) (A := T₀_ov) (B := T₁_ov)).comp
      (Algebra.TensorProduct.includeRight (R := D.R₀) (A := D.R₀₁) (B := T₀)).toRingHom
  let ι₀₁_R : T₁ →+* A₀₁ :=
    (Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := T₀_ov) (B := T₁_ov)).toRingHom.comp
      (Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := T₁)).toRingHom
  let ι₁₀_L : T₁ →+* A₁₀ :=
    (Algebra.TensorProduct.includeLeftRingHom (R := D.R₀₁) (A := T₁_ov) (B := T₀_ov)).comp
      (Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := T₁)).toRingHom
  let ι₁₀_R : T₀ →+* A₁₀ :=
    (Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := T₁_ov) (B := T₀_ov)).toRingHom.comp
      (Algebra.TensorProduct.includeRight (R := D.R₀) (A := D.R₀₁) (B := T₀)).toRingHom
  { g₀₀ := Units.map
        (Algebra.TensorProduct.includeRight (R := D.R₀) (A := T₀) (B := T₀)).toRingHom.toMonoidHom u₀ *
      (Units.map
        (Algebra.TensorProduct.includeLeftRingHom (R := D.R₀) (A := T₀) (B := T₀)).toMonoidHom u₀)⁻¹
    g₀₁ := Units.map ι₀₁_R.toMonoidHom u₁ * (Units.map ι₀₁_L.toMonoidHom u₀)⁻¹
    g₁₀ := Units.map ι₁₀_R.toMonoidHom u₀ * (Units.map ι₁₀_L.toMonoidHom u₁)⁻¹
    g₁₁ := Units.map
        (Algebra.TensorProduct.includeRight (R := D.R₁) (A := T₁) (B := T₁)).toRingHom.toMonoidHom u₁ *
      (Units.map
        (Algebra.TensorProduct.includeLeftRingHom (R := D.R₁) (A := T₁) (B := T₁)).toMonoidHom u₁)⁻¹ }

noncomputable def weilTwoChartQuadPull {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
    {T₀ T₁ T₀' T₁' : Type u} [CommRing T₀] [CommRing T₁] [CommRing T₀'] [CommRing T₁']
    [Algebra D.R₀ T₀] [Algebra D.R₁ T₁] [Algebra D.R₀ T₀'] [Algebra D.R₁ T₁']
    (ψ₀ : T₀ →ₐ[D.R₀] T₀') (ψ₁ : T₁ →ₐ[D.R₁] T₁')
    (q : WeilTwoChartUnitQuad D T₀ T₁) : WeilTwoChartUnitQuad D T₀' T₁' :=
  let T₀_ov := weilTwoChartOv₀ D T₀
  let T₁_ov := weilTwoChartOv₁ D T₁
  let T₀'_ov := weilTwoChartOv₀ D T₀'
  let T₁'_ov := weilTwoChartOv₁ D T₁'
  letI : CommRing T₀_ov := inferInstance
  letI : Algebra D.R₀₁ T₀_ov := inferInstance
  letI : CommRing T₁_ov := inferInstance
  letI : Algebra D.R₀₁ T₁_ov := inferInstance
  letI : CommRing T₀'_ov := inferInstance
  letI : Algebra D.R₀₁ T₀'_ov := inferInstance
  letI : CommRing T₁'_ov := inferInstance
  letI : Algebra D.R₀₁ T₁'_ov := inferInstance
  let ψ₀_ov : T₀_ov →ₐ[D.R₀₁] T₀'_ov :=
    Algebra.TensorProduct.map (AlgHom.id D.R₀₁ D.R₀₁) ψ₀
  let ψ₁_ov : T₁_ov →ₐ[D.R₀₁] T₁'_ov :=
    Algebra.TensorProduct.map (AlgHom.id D.R₀₁ D.R₀₁) ψ₁
  { g₀₀ := Units.map (Algebra.TensorProduct.map ψ₀ ψ₀).toRingHom.toMonoidHom q.g₀₀
    g₀₁ := Units.map (Algebra.TensorProduct.map ψ₀_ov ψ₁_ov).toRingHom.toMonoidHom q.g₀₁
    g₁₀ := Units.map (Algebra.TensorProduct.map ψ₁_ov ψ₀_ov).toRingHom.toMonoidHom q.g₁₀
    g₁₁ := Units.map (Algebra.TensorProduct.map ψ₁ ψ₁).toRingHom.toMonoidHom q.g₁₁ }

noncomputable def weilTwoChartQuadBaseChange {k A : Type u} [Field k] [CommRing A]
    {D : WeilTwoChartRingDatum A} {D₀ : WeilTwoChartRingDatum k}
    (red : WeilTwoChartCurveReduction D D₀)
    {T₀ T₁ : Type u} [CommRing T₀] [CommRing T₁] [Algebra D.R₀ T₀] [Algebra D.R₁ T₁]
    (q : WeilTwoChartUnitQuad D T₀ T₁) :
    letI : Algebra D.R₀ D₀.R₀ := red.algR₀
    letI : Algebra D.R₁ D₀.R₁ := red.algR₁
    WeilTwoChartUnitQuad D₀ (TensorProduct D.R₀ D₀.R₀ T₀) (TensorProduct D.R₁ D₀.R₁ T₁) :=
  letI : Algebra D.R₀ D₀.R₀ := red.algR₀
  letI : Algebra D.R₁ D₀.R₁ := red.algR₁
  letI : Algebra D.R₀₁ D₀.R₀₁ := red.algR₀₁
  letI : Algebra D.R₀ D₀.R₀₁ := red.algR₀_₀₁
  letI : Algebra D.R₁ D₀.R₀₁ := red.algR₁_₀₁
  letI : IsScalarTower D.R₀ D₀.R₀ D₀.R₀₁ := red.tower₀_bar
  letI : IsScalarTower D.R₀ D.R₀₁ D₀.R₀₁ := red.tower₀_loc
  letI : IsScalarTower D.R₁ D₀.R₁ D₀.R₀₁ := red.tower₁_bar
  letI : IsScalarTower D.R₁ D.R₀₁ D₀.R₀₁ := red.tower₁_loc
  let T₀_bar := TensorProduct D.R₀ D₀.R₀ T₀
  let T₁_bar := TensorProduct D.R₁ D₀.R₁ T₁
  letI : CommRing T₀_bar := inferInstance
  letI : Algebra D₀.R₀ T₀_bar := inferInstance
  letI : Algebra D.R₀ T₀_bar := inferInstance
  letI : IsScalarTower D.R₀ D₀.R₀ T₀_bar := inferInstance
  letI : CommRing T₁_bar := inferInstance
  letI : Algebra D₀.R₁ T₁_bar := inferInstance
  letI : Algebra D.R₁ T₁_bar := inferInstance
  letI : IsScalarTower D.R₁ D₀.R₁ T₁_bar := inferInstance
  let U₀ := weilTwoChartOv₀ D T₀
  let U₁ := weilTwoChartOv₁ D T₁
  letI : CommRing U₀ := inferInstance
  letI : Algebra D.R₀₁ U₀ := inferInstance
  letI : CommRing U₁ := inferInstance
  letI : Algebra D.R₀₁ U₁ := inferInstance
  let U₀_bc := TensorProduct D.R₀₁ D₀.R₀₁ U₀
  let U₁_bc := TensorProduct D.R₀₁ D₀.R₀₁ U₁
  letI : CommRing U₀_bc := inferInstance
  letI : Algebra D₀.R₀₁ U₀_bc := inferInstance
  letI : Algebra D.R₀₁ U₀_bc := inferInstance
  letI : IsScalarTower D.R₀₁ D₀.R₀₁ U₀_bc := inferInstance
  letI : CommRing U₁_bc := inferInstance
  letI : Algebra D₀.R₀₁ U₁_bc := inferInstance
  letI : Algebra D.R₀₁ U₁_bc := inferInstance
  letI : IsScalarTower D.R₀₁ D₀.R₀₁ U₁_bc := inferInstance
  let U₀_bar := weilTwoChartOv₀ D₀ T₀_bar
  let U₁_bar := weilTwoChartOv₁ D₀ T₁_bar
  letI : CommRing U₀_bar := inferInstance
  letI : Algebra D₀.R₀₁ U₀_bar := inferInstance
  letI : CommRing U₁_bar := inferInstance
  letI : Algebra D₀.R₀₁ U₁_bar := inferInstance
  let bc₀₀ : TensorProduct D.R₀ T₀ T₀ →+* TensorProduct D₀.R₀ T₀_bar T₀_bar :=
    (Algebra.TensorProduct.cancelBaseChange D.R₀ D₀.R₀ D₀.R₀ T₀_bar T₀).symm.toAlgHom.toRingHom.comp
      (((Algebra.TensorProduct.assoc D.R₀ D.R₀ D.R₀ D₀.R₀ T₀ T₀).symm.toAlgHom.toRingHom).comp
        (Algebra.TensorProduct.includeRight (R := D.R₀) (A := D₀.R₀) (B := TensorProduct D.R₀ T₀ T₀)).toRingHom)
  let bc₁₁ : TensorProduct D.R₁ T₁ T₁ →+* TensorProduct D₀.R₁ T₁_bar T₁_bar :=
    (Algebra.TensorProduct.cancelBaseChange D.R₁ D₀.R₁ D₀.R₁ T₁_bar T₁).symm.toAlgHom.toRingHom.comp
      (((Algebra.TensorProduct.assoc D.R₁ D.R₁ D.R₁ D₀.R₁ T₁ T₁).symm.toAlgHom.toRingHom).comp
        (Algebra.TensorProduct.includeRight (R := D.R₁) (A := D₀.R₁) (B := TensorProduct D.R₁ T₁ T₁)).toRingHom)
  let e_U₀ : U₀_bc ≃ₐ[D₀.R₀₁] U₀_bar :=
    (Algebra.TensorProduct.cancelBaseChange D.R₀ D.R₀₁ D₀.R₀₁ D₀.R₀₁ T₀).trans
      (Algebra.TensorProduct.cancelBaseChange D.R₀ D₀.R₀ D₀.R₀₁ D₀.R₀₁ T₀).symm
  let e_U₁ : U₁_bc ≃ₐ[D₀.R₀₁] U₁_bar :=
    (Algebra.TensorProduct.cancelBaseChange D.R₁ D.R₀₁ D₀.R₀₁ D₀.R₀₁ T₁).trans
      (Algebra.TensorProduct.cancelBaseChange D.R₁ D₀.R₁ D₀.R₀₁ D₀.R₀₁ T₁).symm
  let step₀₁ : TensorProduct D.R₀₁ U₀ U₁ →+* TensorProduct D₀.R₀₁ U₀_bc U₁_bc :=
    (Algebra.TensorProduct.cancelBaseChange D.R₀₁ D₀.R₀₁ D₀.R₀₁ U₀_bc U₁).symm.toAlgHom.toRingHom.comp
      (((Algebra.TensorProduct.assoc D.R₀₁ D.R₀₁ D.R₀₁ D₀.R₀₁ U₀ U₁).symm.toAlgHom.toRingHom).comp
        (Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := D₀.R₀₁) (B := TensorProduct D.R₀₁ U₀ U₁)).toRingHom)
  let step₁₀ : TensorProduct D.R₀₁ U₁ U₀ →+* TensorProduct D₀.R₀₁ U₁_bc U₀_bc :=
    (Algebra.TensorProduct.cancelBaseChange D.R₀₁ D₀.R₀₁ D₀.R₀₁ U₁_bc U₀).symm.toAlgHom.toRingHom.comp
      (((Algebra.TensorProduct.assoc D.R₀₁ D.R₀₁ D.R₀₁ D₀.R₀₁ U₁ U₀).symm.toAlgHom.toRingHom).comp
        (Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := D₀.R₀₁) (B := TensorProduct D.R₀₁ U₁ U₀)).toRingHom)
  { g₀₀ := Units.map bc₀₀.toMonoidHom q.g₀₀
    g₀₁ := Units.map ((Algebra.TensorProduct.congr e_U₀ e_U₁).toAlgHom.toRingHom.comp step₀₁).toMonoidHom q.g₀₁
    g₁₀ := Units.map ((Algebra.TensorProduct.congr e_U₁ e_U₀).toAlgHom.toRingHom.comp step₁₀).toMonoidHom q.g₁₀
    g₁₁ := Units.map bc₁₁.toMonoidHom q.g₁₁ }

def WeilIsTwoChartAlgCocycle {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
    {T₀ T₁ : Type u} [CommRing T₀] [CommRing T₁] [Algebra D.R₀ T₀] [Algebra D.R₁ T₁]
    (q : WeilTwoChartUnitQuad D T₀ T₁) : Prop :=
  let T₀_ov := weilTwoChartOv₀ D T₀
  let T₁_ov := weilTwoChartOv₁ D T₁
  letI : CommRing T₀_ov := inferInstance
  letI : Algebra D.R₀₁ T₀_ov := inferInstance
  letI : Algebra D.R₀ T₀_ov := inferInstance
  letI : IsScalarTower D.R₀ D.R₀₁ T₀_ov := inferInstance
  letI : CommRing T₁_ov := inferInstance
  letI : Algebra D.R₀₁ T₁_ov := inferInstance
  letI : Algebra D.R₁ T₁_ov := inferInstance
  letI : IsScalarTower D.R₁ D.R₀₁ T₁_ov := inferInstance
  let A₀₀ := TensorProduct D.R₀ T₀ T₀
  let A₁₁ := TensorProduct D.R₁ T₁ T₁
  letI : CommRing A₀₀ := inferInstance
  letI : Algebra D.R₀ A₀₀ := inferInstance
  letI : CommRing A₁₁ := inferInstance
  letI : Algebra D.R₁ A₁₁ := inferInstance
  let A₀₀_ov := TensorProduct D.R₀₁ T₀_ov T₀_ov
  let A₀₁ := TensorProduct D.R₀₁ T₀_ov T₁_ov
  let A₁₀ := TensorProduct D.R₀₁ T₁_ov T₀_ov
  let A₁₁_ov := TensorProduct D.R₀₁ T₁_ov T₁_ov
  letI : CommRing A₀₀_ov := inferInstance
  letI : Algebra D.R₀₁ A₀₀_ov := inferInstance
  letI : CommRing A₀₁ := inferInstance
  letI : Algebra D.R₀₁ A₀₁ := inferInstance
  letI : CommRing A₁₀ := inferInstance
  letI : Algebra D.R₀₁ A₁₀ := inferInstance
  letI : CommRing A₁₁_ov := inferInstance
  letI : Algebra D.R₀₁ A₁₁_ov := inferInstance
  let p₀_₁₂ : A₀₀ →ₐ[D.R₀] TensorProduct D.R₀ A₀₀ T₀ :=
    Algebra.TensorProduct.includeLeft
  let p₀_₁₃ : A₀₀ →ₐ[D.R₀] TensorProduct D.R₀ A₀₀ T₀ :=
    Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft (R := D.R₀)).comp (Algebra.TensorProduct.includeLeft (R := D.R₀)))
      (Algebra.TensorProduct.includeRight (R := D.R₀)) (fun _ _ => Commute.all _ _)
  let p₀_₂₃ : A₀₀ →ₐ[D.R₀] TensorProduct D.R₀ A₀₀ T₀ :=
    Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft (R := D.R₀)).comp (Algebra.TensorProduct.includeRight (R := D.R₀)))
      (Algebra.TensorProduct.includeRight (R := D.R₀)) (fun _ _ => Commute.all _ _)
  let p₁_₁₂ : A₁₁ →ₐ[D.R₁] TensorProduct D.R₁ A₁₁ T₁ :=
    Algebra.TensorProduct.includeLeft
  let p₁_₁₃ : A₁₁ →ₐ[D.R₁] TensorProduct D.R₁ A₁₁ T₁ :=
    Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft (R := D.R₁)).comp (Algebra.TensorProduct.includeLeft (R := D.R₁)))
      (Algebra.TensorProduct.includeRight (R := D.R₁)) (fun _ _ => Commute.all _ _)
  let p₁_₂₃ : A₁₁ →ₐ[D.R₁] TensorProduct D.R₁ A₁₁ T₁ :=
    Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft (R := D.R₁)).comp (Algebra.TensorProduct.includeRight (R := D.R₁)))
      (Algebra.TensorProduct.includeRight (R := D.R₁)) (fun _ _ => Commute.all _ _)
  let map₀₀ : A₀₀ →+* A₀₀_ov :=
    (Algebra.TensorProduct.cancelBaseChange D.R₀ D.R₀₁ D.R₀₁ T₀_ov T₀).symm.toAlgHom.toRingHom.comp
      (((Algebra.TensorProduct.assoc D.R₀ D.R₀ D.R₀ D.R₀₁ T₀ T₀).symm.toAlgHom.toRingHom).comp
        (Algebra.TensorProduct.includeRight (R := D.R₀) (A := D.R₀₁) (B := A₀₀)).toRingHom)
  let map₁₁ : A₁₁ →+* A₁₁_ov :=
    (Algebra.TensorProduct.cancelBaseChange D.R₁ D.R₀₁ D.R₀₁ T₁_ov T₁).symm.toAlgHom.toRingHom.comp
      (((Algebra.TensorProduct.assoc D.R₁ D.R₁ D.R₁ D.R₀₁ T₁ T₁).symm.toAlgHom.toRingHom).comp
        (Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := A₁₁)).toRingHom)
  let q₀₀₁_₁₂ : A₀₀_ov →ₐ[D.R₀₁] TensorProduct D.R₀₁ A₀₀_ov T₁_ov :=
    Algebra.TensorProduct.includeLeft
  let q₀₀₁_₁₃ : A₀₁ →ₐ[D.R₀₁] TensorProduct D.R₀₁ A₀₀_ov T₁_ov :=
    Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft (R := D.R₀₁)).comp (Algebra.TensorProduct.includeLeft (R := D.R₀₁)))
      (Algebra.TensorProduct.includeRight (R := D.R₀₁)) (fun _ _ => Commute.all _ _)
  let q₀₀₁_₂₃ : A₀₁ →ₐ[D.R₀₁] TensorProduct D.R₀₁ A₀₀_ov T₁_ov :=
    Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft (R := D.R₀₁)).comp (Algebra.TensorProduct.includeRight (R := D.R₀₁)))
      (Algebra.TensorProduct.includeRight (R := D.R₀₁)) (fun _ _ => Commute.all _ _)
  let q₀₁₁_₁₂ : A₀₁ →ₐ[D.R₀₁] TensorProduct D.R₀₁ A₀₁ T₁_ov :=
    Algebra.TensorProduct.includeLeft
  let q₀₁₁_₁₃ : A₀₁ →ₐ[D.R₀₁] TensorProduct D.R₀₁ A₀₁ T₁_ov :=
    Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft (R := D.R₀₁)).comp (Algebra.TensorProduct.includeLeft (R := D.R₀₁)))
      (Algebra.TensorProduct.includeRight (R := D.R₀₁)) (fun _ _ => Commute.all _ _)
  let q₀₁₁_₂₃ : A₁₁_ov →ₐ[D.R₀₁] TensorProduct D.R₀₁ A₀₁ T₁_ov :=
    Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft (R := D.R₀₁)).comp (Algebra.TensorProduct.includeRight (R := D.R₀₁)))
      (Algebra.TensorProduct.includeRight (R := D.R₀₁)) (fun _ _ => Commute.all _ _)
  (q.g₁₀ : A₁₀) =
    Algebra.TensorProduct.comm D.R₀₁ T₀_ov T₁_ov ((q.g₀₁⁻¹ : Units A₀₁) : A₀₁) ∧
  p₀_₁₃ (q.g₀₀ : A₀₀) = p₀_₁₂ (q.g₀₀ : A₀₀) * p₀_₂₃ (q.g₀₀ : A₀₀) ∧
  p₁_₁₃ (q.g₁₁ : A₁₁) = p₁_₁₂ (q.g₁₁ : A₁₁) * p₁_₂₃ (q.g₁₁ : A₁₁) ∧
  q₀₀₁_₁₃ (q.g₀₁ : A₀₁) = q₀₀₁_₁₂ (map₀₀ (q.g₀₀ : A₀₀)) * q₀₀₁_₂₃ (q.g₀₁ : A₀₁) ∧
  q₀₁₁_₁₃ (q.g₀₁ : A₀₁) = q₀₁₁_₁₂ (q.g₀₁ : A₀₁) * q₀₁₁_₂₃ (map₁₁ (q.g₁₁ : A₁₁))

def WeilIsTwoChartBundleCocycle {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
    (E : WeilTwoChartLineBundle D)
    (T₀ T₁ : Type u) [CommRing T₀] [CommRing T₁] [Algebra D.R₀ T₀] [Algebra D.R₁ T₁]
    (e₀ : TensorProduct D.R₀ T₀ E.L₀ ≃ₗ[T₀] T₀)
    (e₁ : TensorProduct D.R₁ T₁ E.L₁ ≃ₗ[T₁] T₁)
    (q : WeilTwoChartUnitQuad D T₀ T₁) : Prop :=
  let T₀_ov := weilTwoChartOv₀ D T₀
  let T₁_ov := weilTwoChartOv₁ D T₁
  letI : CommRing T₀_ov := inferInstance
  letI : Algebra D.R₀₁ T₀_ov := inferInstance
  letI : CommRing T₁_ov := inferInstance
  letI : Algebra D.R₀₁ T₁_ov := inferInstance
  let A₀₁ := TensorProduct D.R₀₁ T₀_ov T₁_ov
  let A₁₀ := TensorProduct D.R₀₁ T₁_ov T₀_ov
  letI : CommRing A₀₁ := inferInstance
  letI : CommRing A₁₀ := inferInstance
  let σ₀ : E.L₀ →ₗ[D.R₀] T₀ :=
    e₀.toLinearMap.restrictScalars D.R₀ ∘ₗ TensorProduct.mk D.R₀ T₀ E.L₀ 1
  let σ₁ : E.L₁ →ₗ[D.R₁] T₁ :=
    e₁.toLinearMap.restrictScalars D.R₁ ∘ₗ TensorProduct.mk D.R₁ T₁ E.L₁ 1
  (∀ x : E.L₀,
    ((1 : T₀) ⊗ₜ[D.R₀] σ₀ x : TensorProduct D.R₀ T₀ T₀) =
      (q.g₀₀ : TensorProduct D.R₀ T₀ T₀) * (σ₀ x ⊗ₜ[D.R₀] (1 : T₀))) ∧
  (∀ y : E.L₁,
    ((1 : T₁) ⊗ₜ[D.R₁] σ₁ y : TensorProduct D.R₁ T₁ T₁) =
      (q.g₁₁ : TensorProduct D.R₁ T₁ T₁) * (σ₁ y ⊗ₜ[D.R₁] (1 : T₁))) ∧
  (∀ x : E.L₀,
    ((1 : T₀_ov) ⊗ₜ[D.R₀₁] (LinearMap.lTensor D.R₀₁ σ₁ (E.θ ((1 : D.R₀₁) ⊗ₜ[D.R₀] x))) : A₀₁) =
      (q.g₀₁ : A₀₁) * (((1 : D.R₀₁) ⊗ₜ[D.R₀] σ₀ x) ⊗ₜ[D.R₀₁] (1 : T₁_ov))) ∧
  (q.g₁₀ : A₁₀) =
    Algebra.TensorProduct.comm D.R₀₁ T₀_ov T₁_ov ((q.g₀₁⁻¹ : Units A₀₁) : A₀₁)

def WeilMatchesTwoChartQuad (Z : AlgebraicGeometry.Scheme.{u})
    {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
    (T₀ T₁ : Type u) [CommRing T₀] [CommRing T₁] [Algebra D.R₀ T₀] [Algebra D.R₁ T₁]
    (W : Z.Etale)
    (hW : W.left = CategoryTheory.Limits.coprod
      (AlgebraicGeometry.Spec (CommRingCat.of T₀))
      (AlgebraicGeometry.Spec (CommRingCat.of T₁)))
    (w : W ⟶ weilEtaleIdTerminal.{u} Z)
    (c : ↑((weilEtaleGmPresheaf Z).obj (Opposite.op (weilEtaleCechObj w 1))))
    (q : WeilTwoChartUnitQuad D T₀ T₁) : Prop :=
  let T₀_ov := weilTwoChartOv₀ D T₀
  let T₁_ov := weilTwoChartOv₁ D T₁
  letI : CommRing T₀_ov := inferInstance
  letI : Algebra D.R₀₁ T₀_ov := inferInstance
  letI : CommRing T₁_ov := inferInstance
  letI : Algebra D.R₀₁ T₁_ov := inferInstance
  let A₀₁ := TensorProduct D.R₀₁ T₀_ov T₁_ov
  let A₁₀ := TensorProduct D.R₀₁ T₁_ov T₀_ov
  letI : CommRing A₀₁ := inferInstance
  letI : CommRing A₁₀ := inferInstance
  let inl_W : AlgebraicGeometry.Spec (CommRingCat.of T₀) ⟶ W.left :=
    CategoryTheory.Limits.coprod.inl ≫ CategoryTheory.eqToHom hW.symm
  let inr_W : AlgebraicGeometry.Spec (CommRingCat.of T₁) ⟶ W.left :=
    CategoryTheory.Limits.coprod.inr ≫ CategoryTheory.eqToHom hW.symm
  let u_c : Units ↑(((weilEtaleCechObj w 1).left).presheaf.obj (Opposite.op ⊤)) :=
    Additive.toMul c
  (∀ m₀₀ : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct D.R₀ T₀ T₀)) ⟶
      (weilEtaleCechObj w 1).left,
    m₀₀ ≫ (weilEtaleCechProj w 1 0).left =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := D.R₀) (A := T₀) (B := T₀))) ≫
        inl_W →
    m₀₀ ≫ (weilEtaleCechProj w 1 1).left =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := D.R₀) (A := T₀) (B := T₀)).toRingHom) ≫
        inl_W →
    Units.map (m₀₀.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso _).hom).hom.toMonoidHom u_c = q.g₀₀) ∧
  (∀ m₀₁ : AlgebraicGeometry.Spec (CommRingCat.of A₀₁) ⟶
      (weilEtaleCechObj w 1).left,
    m₀₁ ≫ (weilEtaleCechProj w 1 0).left =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((Algebra.TensorProduct.includeLeftRingHom (R := D.R₀₁) (A := T₀_ov) (B := T₁_ov)).comp
          (Algebra.TensorProduct.includeRight (R := D.R₀) (A := D.R₀₁) (B := T₀)).toRingHom)) ≫ inl_W →
    m₀₁ ≫ (weilEtaleCechProj w 1 1).left =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := T₀_ov) (B := T₁_ov)).toRingHom.comp
          (Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := T₁)).toRingHom)) ≫ inr_W →
    Units.map (m₀₁.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso _).hom).hom.toMonoidHom u_c = q.g₀₁) ∧
  (∀ m₁₀ : AlgebraicGeometry.Spec (CommRingCat.of A₁₀) ⟶
      (weilEtaleCechObj w 1).left,
    m₁₀ ≫ (weilEtaleCechProj w 1 0).left =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((Algebra.TensorProduct.includeLeftRingHom (R := D.R₀₁) (A := T₁_ov) (B := T₀_ov)).comp
          (Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := T₁)).toRingHom)) ≫ inr_W →
    m₁₀ ≫ (weilEtaleCechProj w 1 1).left =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := T₁_ov) (B := T₀_ov)).toRingHom.comp
          (Algebra.TensorProduct.includeRight (R := D.R₀) (A := D.R₀₁) (B := T₀)).toRingHom)) ≫ inl_W →
    Units.map (m₁₀.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso _).hom).hom.toMonoidHom u_c = q.g₁₀) ∧
  (∀ m₁₁ : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct D.R₁ T₁ T₁)) ⟶
      (weilEtaleCechObj w 1).left,
    m₁₁ ≫ (weilEtaleCechProj w 1 0).left =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := D.R₁) (A := T₁) (B := T₁))) ≫
        inr_W →
    m₁₁ ≫ (weilEtaleCechProj w 1 1).left =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := D.R₁) (A := T₁) (B := T₁)).toRingHom) ≫
        inr_W →
    Units.map (m₁₁.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso _).hom).hom.toMonoidHom u_c = q.g₁₁)
noncomputable def weilGysinAbOpenMapSite {Y : AlgebraicGeometry.Scheme.{u}} (V : Y.Opens) :
    CategoryTheory.Functor V.toScheme.Etale Y.Etale :=
  let FgtV := AlgebraicGeometry.Scheme.Etale.forget V.toScheme
  { obj := fun W =>
      letI : AlgebraicGeometry.Etale (FgtV.obj W).hom := W.prop
      CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.comp (FgtV.obj W).hom V.ι)
        (inferInstance : AlgebraicGeometry.Etale
          (CategoryTheory.CategoryStruct.comp (FgtV.obj W).hom V.ι))
    map := fun {_ _} f =>
      CategoryTheory.MorphismProperty.Over.homMk (FgtV.map f).left
        ((CategoryTheory.Category.assoc (FgtV.map f).left _ V.ι).symm.trans
          (congrArg (fun k => CategoryTheory.CategoryStruct.comp k V.ι)
            (CategoryTheory.MorphismProperty.Over.w f)))
    map_id := fun _ => CategoryTheory.MorphismProperty.Over.Hom.ext rfl
    map_comp := fun _ _ => CategoryTheory.MorphismProperty.Over.Hom.ext rfl }

noncomputable def weilGysinAbSupportQuotHom {Z Y : AlgebraicGeometry.Scheme.{u}}
    (i : Quiver.Hom Z Y)
    (hc : (weilEtaleSitePullback i).IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology) :
    letI := hc
    Quiver.Hom
      ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ)))
      (((weilEtaleSitePullback i).sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology Z.smallEtaleTopology).obj
        ((CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)))) :=
  letI := hc
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let B_i := weilEtaleSitePullback i
  let T_Y := weilEtaleIdTerminal.{u} Y
  let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
  let T_Z := weilEtaleIdTerminal.{u} Z
  let hT_Z := weilEtaleIdTerminalIsTerminal.{u} Z
  let i_push := B_i.sheafPushforwardContinuous AddCommGrpCat.{u}
    Y.smallEtaleTopology Z.smallEtaleTopology
  let Fℤ_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let adj_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT_Y
  let adj_Z := CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z
  let τ_i : Quiver.Hom (B_i.obj T_Y) T_Z := hT_Z.from (B_i.obj T_Y)
  (adj_Y.homEquiv Aℤ (i_push.obj Fℤ_Z)).symm
    (CategoryTheory.CategoryStruct.comp (adj_Z.unit.app Aℤ) (Fℤ_Z.obj.map (Opposite.op τ_i)))

noncomputable def weilGysinAbOpenConstHom {Y : AlgebraicGeometry.Scheme.{u}} (V : Y.Opens)
    (hc : (weilGysinAbOpenMapSite V).IsContinuous
      V.toScheme.smallEtaleTopology Y.smallEtaleTopology)
    (A : AddCommGrpCat.{u}) :
    letI := hc
    Quiver.Hom
      ((CategoryTheory.constantSheaf V.toScheme.smallEtaleTopology AddCommGrpCat.{u}).obj A)
      (((weilGysinAbOpenMapSite V).sheafPushforwardContinuous AddCommGrpCat.{u}
          V.toScheme.smallEtaleTopology Y.smallEtaleTopology).obj
        ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj A)) :=
  letI := hc
  let M_V := weilGysinAbOpenMapSite V
  let T_V := weilEtaleIdTerminal.{u} V.toScheme
  let hT_V := weilEtaleIdTerminalIsTerminal.{u} V.toScheme
  let T_Y := weilEtaleIdTerminal.{u} Y
  let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
  let C_Y := CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
  let j_star := M_V.sheafPushforwardContinuous AddCommGrpCat.{u}
    V.toScheme.smallEtaleTopology Y.smallEtaleTopology
