            let K_Γ : CategoryTheory.Sheaf Γ.left.smallEtaleTopology AddCommGrpCat.{u} :=
              ⟨weilAltZeroBdrySubpresheaf Γ.left V_Γ n, hSh_0Γ⟩
            let K_P : CategoryTheory.Sheaf P_ov.left.smallEtaleTopology AddCommGrpCat.{u} :=
