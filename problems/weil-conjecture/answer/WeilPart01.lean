def WeilTopDegAffineFiniteFreePushforward (k : Type u) [Field k] (n δ q : ℕ) (ζ : kˣ)
    (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f : Quiver.Hom Y₁.left Y₂.left)
    (f_shriek : weilEtaleTorsionH Y₁.left n q →+ weilEtaleTorsionH Y₂.left n q) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor Y₂.left.Etale Y₁.left.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
  let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget Y₁.left
  let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget Y₂.left
  let J₁ := Y₁.left.smallEtaleTopology
  let J₂ := Y₂.left.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  ∃ (_ : B.IsContinuous J₂ J₁),
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    ∃ (P_pull : CategoryTheory.Functor
          (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u})
          (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}))
      (adj_pull : CategoryTheory.Adjunction P_pull P_push)
      (_ : P_pull.Additive)
      (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
      (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
      (T₁ : Y₁.left.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (T₂ : Y₂.left.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (ιℤ : Quiver.Hom (C₁.obj Aℤ) (P_pull.obj (C₂.obj Aℤ))),
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
      let πℤ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
        (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
          ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
            (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
              ((C₁.obj Aℤ).obj.map (Opposite.op τ))))
      let εM : Quiver.Hom (P_pull.obj (P_push.obj (C₁.obj AM))) (C₁.obj AM) :=
        adj_pull.counit.app (C₁.obj AM)
      let leray : CategoryTheory.Abelian.Ext (C₂.obj Aℤ) (P_push.obj (C₁.obj AM)) q →
          weilEtaleTorsionH Y₁.left n q :=
        fun α => (CategoryTheory.Abelian.Ext.mk₀ εM).postcomp (C₁.obj Aℤ) (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull _ _ _ _ _
              (C₂.obj Aℤ) (P_push.obj (C₁.obj AM)) q) α)
            (Nat.zero_add q))
      let kMap₁ : ∀ U : Y₁.left.Etale,
          k →+* ↑(((Fgt₁.obj U).left).presheaf.obj (Opposite.op ⊤)) :=
        fun U => CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appTop
              (CategoryTheory.CategoryStruct.comp (Fgt₁.obj U).hom Y₁.hom)))
      let kMap₂ : ∀ U : Y₂.left.Etale,
          k →+* ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) :=
        fun U => CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appTop
              (CategoryTheory.CategoryStruct.comp (Fgt₂.obj U).hom Y₂.hom)))
      CategoryTheory.CategoryStruct.comp ιℤ πℤ =
        CategoryTheory.CategoryStruct.id (C₁.obj Aℤ) ∧
      CategoryTheory.CategoryStruct.comp πℤ ιℤ =
        CategoryTheory.CategoryStruct.id (P_pull.obj (C₂.obj Aℤ)) ∧
      Function.Bijective leray ∧
      ∃ (ι₁ : ∀ U : Y₁.left.Etale,
            ↑((C₁.obj AM).obj.obj (Opposite.op U)) →
              ↑(((Fgt₁.obj U).left).presheaf.obj (Opposite.op ⊤)))
        (ι₂ : ∀ U : Y₂.left.Etale,
            ↑((C₂.obj AM).obj.obj (Opposite.op U)) →
              ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)))
        (τM : Quiver.Hom (P_push.obj (C₁.obj AM)) (C₂.obj AM)),
        (∀ U : Y₁.left.Etale, Function.Injective (ι₁ U)) ∧
        (∀ U : Y₂.left.Etale, Function.Injective (ι₂ U)) ∧
        (∀ {U' U : Y₁.left.Etale} (u : Quiver.Hom U' U)
            (s : ↑((C₁.obj AM).obj.obj (Opposite.op U))),
          ι₁ U' (((C₁.obj AM).obj.map (Opposite.op u)) s) =
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt₁.map u).left))
              (ι₁ U s)) ∧
        (∀ {U' U : Y₂.left.Etale} (u : Quiver.Hom U' U)
            (s : ↑((C₂.obj AM).obj.obj (Opposite.op U))),
          ι₂ U' (((C₂.obj AM).obj.map (Opposite.op u)) s) =
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt₂.map u).left))
              (ι₂ U s)) ∧
        (∀ a : ZMod n,
          ι₁ T₁ ((adj₁.unit.app AM) (ULift.up a)) = (kMap₁ T₁ ((ζ : kˣ) : k)) ^ a.val) ∧
        (∀ a : ZMod n,
          ι₂ T₂ ((adj₂.unit.app AM) (ULift.up a)) = (kMap₂ T₂ ((ζ : kˣ) : k)) ^ a.val) ∧
        (∀ (U : Y₂.left.Etale)
            (_ : AlgebraicGeometry.IsAffine (Fgt₂.obj U).left)
            (M : Type u) (_ : AddCommGroup M)
            (_ : Module ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
            (bM : Module.Basis (Fin δ)
              ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
            (e : M ≃+ ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))),
          (∀ (r₀ : ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))) (m : M),
            e (r₀ • m) =
              @Mul.mul ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)) _
                (CommRingCat.Hom.hom
                  (AlgebraicGeometry.Scheme.Hom.appTop
                    (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f)) r₀)
                (e m)) →
          ∀ (σ : ↑((C₁.obj AM).obj.obj (Opposite.op (B.obj U))))
            (L : M →ₗ[↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))] M),
            (∀ m : M, e (L m) = ι₁ (B.obj U) σ * e m) →
            ι₂ U ((τM.hom.app (Opposite.op U)) σ) =
              ((LinearMap.toMatrix bM bM) L).det) ∧
        (∀ (u : weilEtaleTorsionH Y₁.left n q)
            (α : CategoryTheory.Abelian.Ext (C₂.obj Aℤ) (P_push.obj (C₁.obj AM)) q),
          leray α = u →
          f_shriek u = (CategoryTheory.Abelian.Ext.mk₀ τM).postcomp (C₂.obj Aℤ) (Nat.add_zero q) α)
noncomputable def weilAltCdSpecEtaleObj (K : Type u) [Field K]
    (A : Type u) [CommRing A] [Algebra K A] [Algebra.Etale K A] :
    (AlgebraicGeometry.Spec (CommRingCat.of K)).Etale :=
  CategoryTheory.MorphismProperty.Over.mk ⊤
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K A)))
    ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr inferInstance))

noncomputable def weilAltCdSpecEtaleMap (K : Type u) [Field K]
    {A B : Type u} [CommRing A] [CommRing B] [Algebra K A] [Algebra K B]
    [Algebra.Etale K A] [Algebra.Etale K B] (f : A →ₐ[K] B) :
    Quiver.Hom (weilAltCdSpecEtaleObj K B) (weilAltCdSpecEtaleObj K A) :=
  @CategoryTheory.MorphismProperty.Over.homMk _ _ (@AlgebraicGeometry.Etale) ⊤
    (AlgebraicGeometry.Spec (CommRingCat.of K)) _
    (weilAltCdSpecEtaleObj K B) (weilAltCdSpecEtaleObj K A)
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f.toRingHom))
    (Eq.trans
      (AlgebraicGeometry.Spec.map_comp (CommRingCat.ofHom (algebraMap K A))
        (CommRingCat.ofHom f.toRingHom)).symm
      (congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext f.comp_algebraMap)))
    trivial
noncomputable abbrev weilAltCdSitePullback {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom S₁ S₂) : CategoryTheory.Functor S₂.Etale S₁.Etale :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
structure WeilTwoChartRingDatum (B : Type u) [CommRing B] : Type (u + 1) where
  r : ℕ
  w : Fin r → ℕ
  R₀ : Type u
  R₁ : Type u
  R₀₁ : Type u
  [ring₀ : CommRing R₀]
  [ring₁ : CommRing R₁]
  [ring₀₁ : CommRing R₀₁]
  [algPoly₀ : Algebra (Polynomial B) R₀]
  [algPoly₁ : Algebra (Polynomial B) R₁]
  [alg₀ : Algebra R₀ R₀₁]
  [alg₁ : Algebra R₁ R₀₁]
  b₀ : Fin r → R₀
  b₁ : Fin r → R₁

instance instCommRingWeilTwoChartRingDatumR₀ {B : Type u} [CommRing B]
    (D : WeilTwoChartRingDatum B) : CommRing D.R₀ :=
  D.ring₀

instance instCommRingWeilTwoChartRingDatumR₁ {B : Type u} [CommRing B]
    (D : WeilTwoChartRingDatum B) : CommRing D.R₁ :=
  D.ring₁

instance instCommRingWeilTwoChartRingDatumR₀₁ {B : Type u} [CommRing B]
    (D : WeilTwoChartRingDatum B) : CommRing D.R₀₁ :=
  D.ring₀₁

instance instAlgebraPolyWeilTwoChartRingDatumR₀ {B : Type u} [CommRing B]
    (D : WeilTwoChartRingDatum B) : Algebra (Polynomial B) D.R₀ :=
  D.algPoly₀

instance instAlgebraPolyWeilTwoChartRingDatumR₁ {B : Type u} [CommRing B]
    (D : WeilTwoChartRingDatum B) : Algebra (Polynomial B) D.R₁ :=
  D.algPoly₁

instance instAlgebraWeilTwoChartRingDatumR₀R₀₁ {B : Type u} [CommRing B]
    (D : WeilTwoChartRingDatum B) : Algebra D.R₀ D.R₀₁ :=
  D.alg₀

instance instAlgebraWeilTwoChartRingDatumR₁R₀₁ {B : Type u} [CommRing B]
    (D : WeilTwoChartRingDatum B) : Algebra D.R₁ D.R₀₁ :=
  D.alg₁

def WeilIsValidTwoChartRingDatum {B : Type u} [CommRing B]
    (D : WeilTwoChartRingDatum B) : Prop :=
  1 ≤ D.r ∧
  Function.Bijective (fun f : Fin D.r → Polynomial B =>
    Finset.univ.sum fun j => algebraMap (Polynomial B) D.R₀ (f j) * D.b₀ j) ∧
  Function.Bijective (fun f : Fin D.r → Polynomial B =>
    Finset.univ.sum fun j => algebraMap (Polynomial B) D.R₁ (f j) * D.b₁ j) ∧
  IsLocalization.Away (algebraMap (Polynomial B) D.R₀ Polynomial.X) D.R₀₁ ∧
  IsLocalization.Away (algebraMap (Polynomial B) D.R₁ Polynomial.X) D.R₀₁ ∧
  algebraMap D.R₀ D.R₀₁ (algebraMap (Polynomial B) D.R₀ Polynomial.X) *
    algebraMap D.R₁ D.R₀₁ (algebraMap (Polynomial B) D.R₁ Polynomial.X) = 1 ∧
  (∀ a : B,
    algebraMap D.R₀ D.R₀₁ (algebraMap (Polynomial B) D.R₀ (Polynomial.C a)) =
      algebraMap D.R₁ D.R₀₁ (algebraMap (Polynomial B) D.R₁ (Polynomial.C a))) ∧
  (∀ j : Fin D.r,
    algebraMap D.R₁ D.R₀₁ (D.b₁ j) =
      (algebraMap D.R₁ D.R₀₁ (algebraMap (Polynomial B) D.R₁ Polynomial.X)) ^ (D.w j) *
        algebraMap D.R₀ D.R₀₁ (D.b₀ j))

structure WeilTwoChartCurveReduction {k A : Type u} [Field k] [CommRing A]
    (D : WeilTwoChartRingDatum A) (D₀ : WeilTwoChartRingDatum k) : Type u where
  [algR₀ : Algebra D.R₀ D₀.R₀]
  [algR₁ : Algebra D.R₁ D₀.R₁]
  [algR₀₁ : Algebra D.R₀₁ D₀.R₀₁]
  [algR₀_₀₁ : Algebra D.R₀ D₀.R₀₁]
  [algR₁_₀₁ : Algebra D.R₁ D₀.R₀₁]
  [tower₀_bar : IsScalarTower D.R₀ D₀.R₀ D₀.R₀₁]
  [tower₀_loc : IsScalarTower D.R₀ D.R₀₁ D₀.R₀₁]
  [tower₁_bar : IsScalarTower D.R₁ D₀.R₁ D₀.R₀₁]
  [tower₁_loc : IsScalarTower D.R₁ D.R₀₁ D₀.R₀₁]

def WeilIsValidTwoChartCurveReduction {k A : Type u} [Field k] [CommRing A] [Algebra k A]
    (τ_A : A →ₐ[k] k) (D : WeilTwoChartRingDatum A) (D₀ : WeilTwoChartRingDatum k)
    (red : WeilTwoChartCurveReduction D D₀) : Prop :=
  letI : Algebra D.R₀ D₀.R₀ := red.algR₀
  letI : Algebra D.R₁ D₀.R₁ := red.algR₁
  WeilIsValidTwoChartRingDatum D ∧
  WeilIsValidTwoChartRingDatum D₀ ∧
  (∃ hr : D.r = D₀.r,
    (∀ j : Fin D.r, D.w j = D₀.w (Fin.cast hr j)) ∧
    (∀ j : Fin D.r, algebraMap D.R₀ D₀.R₀ (D.b₀ j) = D₀.b₀ (Fin.cast hr j)) ∧
    (∀ j : Fin D.r, algebraMap D.R₁ D₀.R₁ (D.b₁ j) = D₀.b₁ (Fin.cast hr j))) ∧
  (∀ p : Polynomial A,
    algebraMap D.R₀ D₀.R₀ (algebraMap (Polynomial A) D.R₀ p) =
      algebraMap (Polynomial k) D₀.R₀ (Polynomial.map τ_A.toRingHom p)) ∧
  (∀ p : Polynomial A,
    algebraMap D.R₁ D₀.R₁ (algebraMap (Polynomial A) D.R₁ p) =
      algebraMap (Polynomial k) D₀.R₁ (Polynomial.map τ_A.toRingHom p)) ∧
  Function.Surjective (algebraMap D.R₀ D₀.R₀) ∧
  RingHom.ker (algebraMap D.R₀ D₀.R₀) =
    Ideal.map ((algebraMap (Polynomial A) D.R₀).comp Polynomial.C) (RingHom.ker τ_A.toRingHom) ∧
  Function.Surjective (algebraMap D.R₁ D₀.R₁) ∧
  RingHom.ker (algebraMap D.R₁ D₀.R₁) =
    Ideal.map ((algebraMap (Polynomial A) D.R₁).comp Polynomial.C) (RingHom.ker τ_A.toRingHom)

def WeilCurveTwoChartBridge {k A : Type u} [Field k] [CommRing A] [Algebra k A]
    (τ_A : A →ₐ[k] k) (C : AlgebraicGeometry.Scheme.{u})
    (f_C : Quiver.Hom C (AlgebraicGeometry.Spec (CommRingCat.of A)))
    (D : WeilTwoChartRingDatum A) (D₀ : WeilTwoChartRingDatum k)
    (red : WeilTwoChartCurveReduction D D₀) : Prop :=
  letI : Algebra D.R₀ D₀.R₀ := red.algR₀
  letI : Algebra D.R₁ D₀.R₁ := red.algR₁
  let ι_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom)
  let C₀ := CategoryTheory.Limits.pullback ι_A f_C
  let p₀_C := CategoryTheory.Limits.pullback.fst ι_A f_C
  let i_C := CategoryTheory.Limits.pullback.snd ι_A f_C
  ∃ (j₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of D.R₀)) C)
    (j₁ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of D.R₁)) C)
    (j₀_bar : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of D₀.R₀)) C₀)
    (j₁_bar : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of D₀.R₁)) C₀),
    AlgebraicGeometry.IsOpenImmersion j₀ ∧
    AlgebraicGeometry.IsOpenImmersion j₁ ∧
    Set.range j₀.base ∪ Set.range j₁.base = Set.univ ∧
    CategoryTheory.CategoryStruct.comp j₀ f_C =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap (Polynomial A) D.R₀).comp Polynomial.C)) ∧
    CategoryTheory.CategoryStruct.comp j₁ f_C =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap (Polynomial A) D.R₁).comp Polynomial.C)) ∧
    CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ D.R₀₁)))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ D.R₀₁)))
      j₀ j₁ ∧
    AlgebraicGeometry.IsOpenImmersion j₀_bar ∧
    AlgebraicGeometry.IsOpenImmersion j₁_bar ∧
    Set.range j₀_bar.base ∪ Set.range j₁_bar.base = Set.univ ∧
    CategoryTheory.CategoryStruct.comp j₀_bar p₀_C =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap (Polynomial k) D₀.R₀).comp Polynomial.C)) ∧
    CategoryTheory.CategoryStruct.comp j₁_bar p₀_C =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap (Polynomial k) D₀.R₁).comp Polynomial.C)) ∧
    CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀.R₀ D₀.R₀₁)))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀.R₁ D₀.R₀₁)))
      j₀_bar j₁_bar ∧
    CategoryTheory.CategoryStruct.comp j₀_bar i_C =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ D₀.R₀))) j₀ ∧
    CategoryTheory.CategoryStruct.comp j₁_bar i_C =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ D₀.R₁))) j₁

structure WeilTwoChartLineBundle {B : Type u} [CommRing B]
    (D : WeilTwoChartRingDatum B) : Type (u + 1) where
  L₀ : Type u
  L₁ : Type u
  [grp₀ : AddCommGroup L₀]
  [mod₀ : Module D.R₀ L₀]
  [inv₀ : Module.Invertible D.R₀ L₀]
  [grp₁ : AddCommGroup L₁]
  [mod₁ : Module D.R₁ L₁]
  [inv₁ : Module.Invertible D.R₁ L₁]
  θ : LinearEquiv (RingHom.id D.R₀₁)
        (TensorProduct D.R₀ D.R₀₁ L₀)
        (TensorProduct D.R₁ D.R₀₁ L₁)

instance instAddCommGroupWeilTwoChartLineBundleL₀ {B : Type u} [CommRing B]
    {D : WeilTwoChartRingDatum B} (E : WeilTwoChartLineBundle D) : AddCommGroup E.L₀ :=
  E.grp₀

instance instModuleWeilTwoChartLineBundleL₀ {B : Type u} [CommRing B]
    {D : WeilTwoChartRingDatum B} (E : WeilTwoChartLineBundle D) : Module D.R₀ E.L₀ :=
  E.mod₀

instance instInvertibleWeilTwoChartLineBundleL₀ {B : Type u} [CommRing B]
    {D : WeilTwoChartRingDatum B} (E : WeilTwoChartLineBundle D) : Module.Invertible D.R₀ E.L₀ :=
  E.inv₀

instance instAddCommGroupWeilTwoChartLineBundleL₁ {B : Type u} [CommRing B]
    {D : WeilTwoChartRingDatum B} (E : WeilTwoChartLineBundle D) : AddCommGroup E.L₁ :=
  E.grp₁

instance instModuleWeilTwoChartLineBundleL₁ {B : Type u} [CommRing B]
    {D : WeilTwoChartRingDatum B} (E : WeilTwoChartLineBundle D) : Module D.R₁ E.L₁ :=
  E.mod₁

instance instInvertibleWeilTwoChartLineBundleL₁ {B : Type u} [CommRing B]
    {D : WeilTwoChartRingDatum B} (E : WeilTwoChartLineBundle D) : Module.Invertible D.R₁ E.L₁ :=
  E.inv₁

noncomputable def WeilTwoChartTrivial {B : Type u} [CommRing B]
    (D : WeilTwoChartRingDatum B) : WeilTwoChartLineBundle D where
  L₀ := D.R₀
  L₁ := D.R₁
  θ := (TensorProduct.AlgebraTensorModule.rid D.R₀ D.R₀₁ D.R₀₁).trans
         (TensorProduct.AlgebraTensorModule.rid D.R₁ D.R₀₁ D.R₀₁).symm

noncomputable def WeilTwoChartMul {B : Type u} [CommRing B]
    (D : WeilTwoChartRingDatum B)
    (E F : WeilTwoChartLineBundle D) : WeilTwoChartLineBundle D where
  L₀ := TensorProduct D.R₀ E.L₀ F.L₀
  L₁ := TensorProduct D.R₁ E.L₁ F.L₁
  θ := (TensorProduct.AlgebraTensorModule.distribBaseChange D.R₀ D.R₀₁ E.L₀ F.L₀).trans
         ((TensorProduct.AlgebraTensorModule.congr E.θ F.θ).trans
           (TensorProduct.AlgebraTensorModule.distribBaseChange D.R₁ D.R₀₁ E.L₁ F.L₁).symm)

noncomputable def WeilTwoChartPow {B : Type u} [CommRing B]
    (D : WeilTwoChartRingDatum B)
    (E : WeilTwoChartLineBundle D) : ℕ → WeilTwoChartLineBundle D
  | 0 => WeilTwoChartTrivial D
  | n + 1 => WeilTwoChartMul D E (WeilTwoChartPow D E n)

noncomputable def WeilTwoChartBaseChange {k A : Type u} [Field k] [CommRing A]
    {D : WeilTwoChartRingDatum A} {D₀ : WeilTwoChartRingDatum k}
    (red : WeilTwoChartCurveReduction D D₀)
    (E : WeilTwoChartLineBundle D) : WeilTwoChartLineBundle D₀ :=
  letI : Algebra D.R₀ D₀.R₀ := red.algR₀
  letI : Algebra D.R₁ D₀.R₁ := red.algR₁
  letI : Algebra D.R₀₁ D₀.R₀₁ := red.algR₀₁
  letI : Algebra D.R₀ D₀.R₀₁ := red.algR₀_₀₁
  letI : Algebra D.R₁ D₀.R₀₁ := red.algR₁_₀₁
  letI : IsScalarTower D.R₀ D₀.R₀ D₀.R₀₁ := red.tower₀_bar
  letI : IsScalarTower D.R₀ D.R₀₁ D₀.R₀₁ := red.tower₀_loc
  letI : IsScalarTower D.R₁ D₀.R₁ D₀.R₀₁ := red.tower₁_bar
  letI : IsScalarTower D.R₁ D.R₀₁ D₀.R₀₁ := red.tower₁_loc
  { L₀ := TensorProduct D.R₀ D₀.R₀ E.L₀
    L₁ := TensorProduct D.R₁ D₀.R₁ E.L₁
    θ := ((TensorProduct.AlgebraTensorModule.cancelBaseChange D.R₀ D₀.R₀ D₀.R₀₁ D₀.R₀₁ E.L₀).trans
            (TensorProduct.AlgebraTensorModule.cancelBaseChange D.R₀ D.R₀₁ D₀.R₀₁ D₀.R₀₁ E.L₀).symm).trans
           ((LinearEquiv.baseChange D.R₀₁ D₀.R₀₁ _ _ E.θ).trans
             ((TensorProduct.AlgebraTensorModule.cancelBaseChange D.R₁ D₀.R₁ D₀.R₀₁ D₀.R₀₁ E.L₁).trans
               (TensorProduct.AlgebraTensorModule.cancelBaseChange D.R₁ D.R₀₁ D₀.R₀₁ D₀.R₀₁ E.L₁).symm).symm) }

def WeilTwoChartIso {B : Type u} [CommRing B]
    (D : WeilTwoChartRingDatum B)
    (E F : WeilTwoChartLineBundle D) : Prop :=
  ∃ (e₀ : LinearEquiv (RingHom.id D.R₀) E.L₀ F.L₀)
    (e₁ : LinearEquiv (RingHom.id D.R₁) E.L₁ F.L₁),
    (LinearEquiv.baseChange D.R₀ D.R₀₁ E.L₀ F.L₀ e₀).trans F.θ =
      E.θ.trans (LinearEquiv.baseChange D.R₁ D.R₀₁ E.L₁ F.L₁ e₁)
def WeilIsPinnedRoofTransfer (k : Type u) [CommRing k] (ℓ : ℕ)
    (Ψ : WeilRoofTransferSystem k ℓ) : Prop :=
  (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U : Y.left.Etale)
      (h : WeilIsAffineRoofIso k Y Y U U
        (CategoryTheory.Iso.refl ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U).left))
      (r q : ℕ),
    Ψ Y Y U U (CategoryTheory.Iso.refl _) h r q = AddEquiv.refl _) ∧
  (∀ (Y₁ Y₂ Y₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U₁ : Y₁.left.Etale) (U₂ : Y₂.left.Etale) (U₃ : Y₃.left.Etale)
      (e₁₂ : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U₁).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U₂).left)
      (e₂₃ : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U₂).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y₃.left).obj U₃).left)
      (h₁₂ : WeilIsAffineRoofIso k Y₁ Y₂ U₁ U₂ e₁₂)
      (h₂₃ : WeilIsAffineRoofIso k Y₂ Y₃ U₂ U₃ e₂₃)
      (h₁₃ : WeilIsAffineRoofIso k Y₁ Y₃ U₁ U₃ (CategoryTheory.Iso.trans e₁₂ e₂₃))
      (r q : ℕ),
    AddEquiv.trans (Ψ Y₁ Y₂ U₁ U₂ e₁₂ h₁₂ r q) (Ψ Y₂ Y₃ U₂ U₃ e₂₃ h₂₃ r q) =
      Ψ Y₁ Y₃ U₁ U₃ (CategoryTheory.Iso.trans e₁₂ e₂₃) h₁₃ r q) ∧
  (∀ (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U'₁ U₁ : Y₁.left.Etale) (U'₂ U₂ : Y₂.left.Etale)
      (v₁ : Quiver.Hom U'₁ U₁) (v₂ : Quiver.Hom U'₂ U₂)
      (e' : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U'₁).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U'₂).left)
      (e : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U₁).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U₂).left)
      (h' : WeilIsAffineRoofIso k Y₁ Y₂ U'₁ U'₂ e')
      (h : WeilIsAffineRoofIso k Y₁ Y₂ U₁ U₂ e),
    CategoryTheory.CategoryStruct.comp e'.hom
      (((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).map v₂).left) =
      CategoryTheory.CategoryStruct.comp
        (((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).map v₁).left) e.hom →
    ∀ (r q : ℕ) (z : weilEtaleLocalTorsionH Y₁.left (ℓ ^ r) U'₁ q),
      Ψ Y₁ Y₂ U₁ U₂ e h r q (weilEtaleLocalTorsionMapH Y₁.left (ℓ ^ r) v₁ q z) =
        weilEtaleLocalTorsionMapH Y₂.left (ℓ ^ r) v₂ q (Ψ Y₁ Y₂ U'₁ U'₂ e' h' r q z)) ∧
  (∀ (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U₁ : Y₁.left.Etale) (U₂ : Y₂.left.Etale)
      (e : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U₁).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U₂).left)
      (h : WeilIsAffineRoofIso k Y₁ Y₂ U₁ U₂ e)
      (r q : ℕ) (z : weilEtaleLocalTorsionH Y₁.left (ℓ ^ (r + 1)) U₁ q),
    weilEtaleLocalTorsionTransition Y₂.left ℓ r U₂ q (Ψ Y₁ Y₂ U₁ U₂ e h (r + 1) q z) =
      Ψ Y₁ Y₂ U₁ U₂ e h r q (weilEtaleLocalTorsionTransition Y₁.left ℓ r U₁ q z)) ∧
  (∀ (W_bar Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π : Quiver.Hom W_bar.left Y.left)
      (U_W : W_bar.left.Etale) (U_Y : Y.left.Etale)
      (e : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).left)
      (h : WeilIsAffineRoofIso k W_bar Y U_W U_Y e),
    CategoryTheory.CategoryStruct.comp π Y.hom = W_bar.hom →
    CategoryTheory.CategoryStruct.comp
        (((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).hom) π =
      CategoryTheory.CategoryStruct.comp e.hom
        (((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).hom) →
    let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget W_bar.left
    let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget Y.left
    let B_π := weilEtaleSitePullback π
    let J_W := W_bar.left.smallEtaleTopology
    let J_Y := Y.left.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ_W := (CategoryTheory.constantSheaf J_W AddCommGrpCat.{u}).obj Aℤ
    let Fℤ_Y := (CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}).obj Aℤ
    ∀ (_hCont : B_π.IsContinuous J_Y J_W)
      (_hAdj : (B_π.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_W).IsRightAdjoint),
      let pf_π := B_π.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_W
      let pb_π := B_π.sheafPullback AddCommGrpCat.{u} J_Y J_W
      let adj_π := B_π.sheafAdjunctionContinuous AddCommGrpCat.{u} J_Y J_W
      ∀ (_hAdd : pb_π.Additive)
        (_hLim : CategoryTheory.Limits.PreservesFiniteLimits pb_π)
        (_hColim : CategoryTheory.Limits.PreservesFiniteColimits pb_π)
        (T_W : W_bar.left.Etale) (hT_W : CategoryTheory.Limits.IsTerminal T_W)
        (T_Y : Y.left.Etale) (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
        (ιℤ : Quiver.Hom Fℤ_W (pb_π.obj Fℤ_Y))
        (σ_e : Quiver.Hom U_W (B_π.obj U_Y))
        (r : ℕ)
        (α_π : Quiver.Hom (weilEtaleLocalTorsionSheaf Y.left (ℓ ^ r) U_Y)
          (pf_π.obj (weilEtaleLocalTorsionSheaf W_bar.left (ℓ ^ r) U_W))),
        let p_fst : Quiver.Hom ((Fgt_W.obj (B_π.obj U_Y)).left) ((Fgt_Y.obj U_Y).left) :=
          CategoryTheory.Limits.pullback.fst ((Fgt_Y.obj U_Y).hom) π
        let πℤ := weilEtaleConstPullbackHom π hT_W hT_Y Aℤ
        let L_Y := weilEtaleLocalTorsionSheaf Y.left (ℓ ^ r) U_Y
        let L_W := weilEtaleLocalTorsionSheaf W_bar.left (ℓ ^ r) U_W
        let ξ := CategoryTheory.Sheaf.freeYonedaHomEquiv α_π
        CategoryTheory.CategoryStruct.comp ιℤ πℤ = CategoryTheory.CategoryStruct.id Fℤ_W →
        CategoryTheory.CategoryStruct.comp πℤ ιℤ = CategoryTheory.CategoryStruct.id (pb_π.obj Fℤ_Y) →
        CategoryTheory.CategoryStruct.comp ((Fgt_W.map σ_e).left) p_fst = e.hom →
        CategoryTheory.CategoryStruct.comp ξ (L_W.obj.map (Opposite.op σ_e)) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_W) →
        (∀ (V : W_bar.left.Etale) (w : Quiver.Hom V (B_π.obj U_Y)),
          Disjoint (Set.range ((Fgt_W.map w).left).base) (Set.range ((Fgt_W.map σ_e).left).base) →
          CategoryTheory.CategoryStruct.comp ξ (L_W.obj.map (Opposite.op w)) = 0) →
        ∀ (q : ℕ) (z : weilEtaleLocalTorsionH Y.left (ℓ ^ r) U_Y q),
          (Ψ W_bar Y U_W U_Y e h r q).symm z =
            (CategoryTheory.Abelian.Ext.mk₀ ((adj_π.homEquiv L_Y L_W).symm α_π)).postcomp
              Fℤ_W (Nat.add_zero q)
              ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_π _ _ _ _ _ Fℤ_Y L_Y q) z)
                (Nat.zero_add q)))
structure WeilAffColim0TotalCat.{u} {ℐ : Type u} [CategoryTheory.SmallCategory ℐ]
    (B : CategoryTheory.Functor ℐ CommRingCat.{u}) : Type u where
  stage : ℐ
  pres : WeilAffColim0PresIdx (B.obj stage)

structure WeilAffColim0TotalHom.{u} {ℐ : Type u} [CategoryTheory.SmallCategory ℐ]
    {B : CategoryTheory.Functor ℐ CommRingCat.{u}}
    (X Y : WeilAffColim0TotalCat.{u} B) : Type u where
  idxHom : Quiver.Hom X.stage Y.stage
  ringHom : Quiver.Hom (weilAffColim0PresRing X.pres) (weilAffColim0PresRing Y.pres)
  comm : CategoryTheory.CategoryStruct.comp (B.map idxHom) (weilAffColim0PresHom Y.pres) =
    CategoryTheory.CategoryStruct.comp (weilAffColim0PresHom X.pres) ringHom

noncomputable instance instSmallCategoryWeilAffColim0TotalCat.{u} {ℐ : Type u} [CategoryTheory.SmallCategory ℐ]
    (B : CategoryTheory.Functor ℐ CommRingCat.{u}) :
    CategoryTheory.SmallCategory (WeilAffColim0TotalCat.{u} B) where
  Hom X Y := WeilAffColim0TotalHom.{u} X Y
  id X :=
    { idxHom := CategoryTheory.CategoryStruct.id X.stage
      ringHom := CategoryTheory.CategoryStruct.id (weilAffColim0PresRing X.pres)
      comm := (congrArg (· ≫ weilAffColim0PresHom X.pres) (B.map_id X.stage)).trans
        ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm) }
  comp {X Y Z} f g :=
    { idxHom := CategoryTheory.CategoryStruct.comp f.idxHom g.idxHom
      ringHom := CategoryTheory.CategoryStruct.comp f.ringHom g.ringHom
      comm := (congrArg (· ≫ weilAffColim0PresHom Z.pres) (B.map_comp f.idxHom g.idxHom)).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (B.map f.idxHom ≫ ·) g.comm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ g.ringHom) f.comm).trans (CategoryTheory.Category.assoc _ _ _))))) }
  id_comp {X Y} f := by
    cases f
    dsimp
    congr 1
    exact CategoryTheory.Category.id_comp _
  comp_id {X Y} f := by
    cases f
    dsimp
    congr 1
    exact CategoryTheory.Category.comp_id _
  assoc {W X Y Z} f g h := by
    cases f; cases g; cases h
    dsimp
    congr 1
    exact CategoryTheory.Category.assoc _ _ _

noncomputable def weilAffColim0InSlice.{u} {ℐ : Type u} [CategoryTheory.SmallCategory ℐ]
    (B : CategoryTheory.Functor ℐ CommRingCat.{u}) (i : ℐ) :
    CategoryTheory.Functor (Opposite (WeilAffColim0PresSite (B.obj i))) (WeilAffColim0TotalCat.{u} B) where
  obj U := ⟨i, Opposite.unop U⟩
  map {U₁ U₂} w :=
    let u_et := (weilAffColim0PresInclusion (B.obj i)).map w.unop
    let φ : Quiver.Hom (weilAffColim0PresRing U₁.unop) (weilAffColim0PresRing U₂.unop) :=
      AlgebraicGeometry.Spec.preimage u_et.left
    { idxHom := CategoryTheory.CategoryStruct.id i
      ringHom := φ
      comm :=
        have hpre : CategoryTheory.CategoryStruct.comp (weilAffColim0PresHom U₁.unop) φ =
            weilAffColim0PresHom U₂.unop :=
          AlgebraicGeometry.Spec.map_injective
            ((AlgebraicGeometry.Spec.map_comp (weilAffColim0PresHom U₁.unop) φ).trans
              ((congrArg (· ≫ AlgebraicGeometry.Spec.map (weilAffColim0PresHom U₁.unop))
                (AlgebraicGeometry.Spec.map_preimage u_et.left)).trans
                (CategoryTheory.MorphismProperty.Over.w u_et)))
        (congrArg (· ≫ weilAffColim0PresHom U₂.unop) (B.map_id i)).trans
          ((CategoryTheory.Category.id_comp _).trans hpre.symm) }
  map_id U := by
    dsimp
    congr 1
    exact AlgebraicGeometry.Spec.map_injective
      ((AlgebraicGeometry.Spec.map_preimage _).trans (AlgebraicGeometry.Spec.map_id _).symm)
  map_comp {U₁ U₂ U₃} w₁ w₂ := by
    dsimp
    congr 1
    · exact (CategoryTheory.Category.id_comp _).symm
    · exact AlgebraicGeometry.Spec.map_injective
        ((AlgebraicGeometry.Spec.map_preimage _).trans
          ((congrArg₂ CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map_preimage _).symm
            (AlgebraicGeometry.Spec.map_preimage _).symm).trans
            (AlgebraicGeometry.Spec.map_comp _ _).symm))

noncomputable def weilAffColim0ProjInf.{u} {ℐ : Type u} [CategoryTheory.SmallCategory ℐ]
    (B : CategoryTheory.Functor ℐ CommRingCat.{u})
    (c : CategoryTheory.Limits.Cocone B)
    (bcIdx : ∀ {R₁ R₂ : CommRingCat.{u}}, Quiver.Hom R₁ R₂ → WeilAffColim0PresIdx R₁ → WeilAffColim0PresIdx R₂)
    (bcHom : ∀ {R₁ R₂ : CommRingCat.{u}} (φ : Quiver.Hom R₁ R₂) (p : WeilAffColim0PresIdx R₁),
      Quiver.Hom (weilAffColim0PresRing p) (weilAffColim0PresRing (bcIdx φ p)))
    (hBcPush : ∀ {R₁ R₂ : CommRingCat.{u}} (φ : Quiver.Hom R₁ R₂) (p : WeilAffColim0PresIdx R₁),
      CategoryTheory.IsPushout φ (weilAffColim0PresHom p)
        (weilAffColim0PresHom (bcIdx φ p)) (bcHom φ p)) :
    CategoryTheory.Functor (WeilAffColim0TotalCat.{u} B) (Opposite (WeilAffColim0PresSite c.pt)) where
  obj X := Opposite.op (bcIdx (c.ι.app X.stage) X.pres)
  map {X Y} f :=
    let hp := hBcPush (c.ι.app X.stage) X.pres
    let hq := hBcPush (c.ι.app Y.stage) Y.pres
    let φ_inf : Quiver.Hom (weilAffColim0PresRing (bcIdx (c.ι.app X.stage) X.pres))
