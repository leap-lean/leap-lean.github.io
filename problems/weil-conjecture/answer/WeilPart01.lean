              CategoryTheory.CategoryStruct.comp
                ((CategoryTheory.constantSheafAdj Γ.left.smallEtaleTopology AddCommGrpCat.{u} hT_Γ).unit.app AM)
                (Φ_Γ.hom.hom.app (Opposite.op T_Γ)) = weilAltLocConstConstHom Γ.left T_Γ n →
              CategoryTheory.CategoryStruct.comp
                ((CategoryTheory.constantSheafAdj P_ov.left.smallEtaleTopology AddCommGrpCat.{u} hT_P).unit.app AM)
