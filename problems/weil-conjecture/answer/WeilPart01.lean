      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ r)))
      let u_sec := (CategoryTheory.CategoryStruct.comp
        (adj_X.unit.app AM)
        ((ι_kum r).hom.app (Opposite.op T_X))) (ULift.up a)
      let η_gm := (CategoryTheory.sheafificationAdjunction X.left.smallEtaleTopology
        AddCommGrpCat.{u}).unit.app (weilEtaleGmPresheaf X.left)
      ∃ u_pre : ↑((weilEtaleGmPresheaf X.left).obj (Opposite.op T_X)),
        (η_gm.app (Opposite.op T_X)) u_pre = u_sec ∧
        ((Additive.toMul u_pre : Units _) :
          ↑(((AlgebraicGeometry.Scheme.Etale.forget X.left).obj T_X).left.presheaf.obj (Opposite.op ⊤))) =
          (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appTop
              (CategoryTheory.CategoryStruct.comp
                ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj T_X).hom
                X.hom))) ((ζ r : kˣ) : k)) ^ a.val) ∧
