def WeilFilteredColimitEtaleDescentHolds.{u} : Prop :=
  (∀ (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
      (B : CategoryTheory.Functor ℐ CommRingCat.{u})
      (c : CategoryTheory.Limits.Cocone B) (_ : CategoryTheory.Limits.IsColimit c),
    (∀ (E_inf : CommRingCat.{u}) (f_E : Quiver.Hom c.pt E_inf),
      (CommRingCat.Hom.hom f_E).Etale →
      ∃ (i₀ : ℐ) (n : ℕ) (J₀ : Ideal (MvPolynomial (Fin n) ↑(B.obj i₀)))
        (g₀ : Quiver.Hom (CommRingCat.of (MvPolynomial (Fin n) ↑(B.obj i₀) ⧸ J₀)) E_inf),
        (CommRingCat.Hom.hom
          (CommRingCat.ofHom ((Ideal.Quotient.mk J₀).comp MvPolynomial.C))).Etale ∧
        CategoryTheory.IsPushout (c.ι.app i₀)
          (CommRingCat.ofHom ((Ideal.Quotient.mk J₀).comp MvPolynomial.C)) f_E g₀) ∧
    (∀ (i₁ : ℐ) (E₁ E_inf : CommRingCat.{u})
        (f₁ : Quiver.Hom (B.obj i₁) E₁)
        (f_inf : Quiver.Hom c.pt E_inf)
        (g_inf : Quiver.Hom E₁ E_inf),
      (CommRingCat.Hom.hom f₁).Etale →
      CategoryTheory.IsPushout (c.ι.app i₁) f₁ f_inf g_inf →
      AlgebraicGeometry.Surjective (AlgebraicGeometry.Spec.map f_inf) →
      ∃ (i₂ : ℐ) (θ : Quiver.Hom i₁ i₂),
        AlgebraicGeometry.Surjective
          (AlgebraicGeometry.Spec.map (CategoryTheory.Limits.pushout.inl (B.map θ) f₁)))) ∧
  (∀ (R : CommRingCat.{u}) (m : ℕ) (E : Fin m → CommRingCat.{u})
      (f : ∀ s : Fin m, Quiver.Hom R (E s)),
    (∀ s : Fin m, (CommRingCat.Hom.hom (f s)).Etale) →
    (∀ x : ↥(AlgebraicGeometry.Spec R),
      ∃ (s : Fin m) (y : ↥(AlgebraicGeometry.Spec (E s))),
        (AlgebraicGeometry.Spec.map (f s)).base y = x) →
    ∃ (E_prod : CommRingCat.{u}) (f_prod : Quiver.Hom R E_prod)
      (π_comp : ∀ s : Fin m, Quiver.Hom E_prod (E s)),
      (∀ s : Fin m, CategoryTheory.CategoryStruct.comp f_prod (π_comp s) = f s) ∧
      (CommRingCat.Hom.hom f_prod).Etale ∧
      AlgebraicGeometry.Surjective (AlgebraicGeometry.Spec.map f_prod) ∧
      (∀ s : Fin m, AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (π_comp s))) ∧
      (∀ z : ↥(AlgebraicGeometry.Spec E_prod),
        ∃ (s : Fin m) (y : ↥(AlgebraicGeometry.Spec (E s))),
          (AlgebraicGeometry.Spec.map (π_comp s)).base y = z) ∧
      (∀ (s t : Fin m), s ≠ t →
        IsEmpty ↥(CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map (π_comp s))
          (AlgebraicGeometry.Spec.map (π_comp t)))))

