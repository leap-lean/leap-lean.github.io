def WeilHasGeneralEtalePullH.{u} {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom S₁ S₂)
    [_hCont : (weilAltCdSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
    [_hAdj : ((weilAltCdSitePullback h).sheafPushforwardContinuous
      AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint]
    (ℱ : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ)
    (p_ℱ : ℱ.H q →+
      (((weilAltCdSitePullback h).sheafPullback
        AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology).obj ℱ).H q) : Prop :=
  let B := weilAltCdSitePullback h
  let J₁ := S₁.smallEtaleTopology
  let J₂ := S₂.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
  let P_pull := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
  let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
  ∃ (_ : P_pull.Additive)
    (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
    (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
    (T₁ : S₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
    (T₂ : S₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
    let πℤ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
      (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
        ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
            ((C₁.obj Aℤ).obj.map τ.op)))
    ∃ (ιℤ : Quiver.Hom (C₁.obj Aℤ) (P_pull.obj (C₂.obj Aℤ))),
      CategoryTheory.CategoryStruct.comp ιℤ πℤ = CategoryTheory.CategoryStruct.id (C₁.obj Aℤ) ∧
      CategoryTheory.CategoryStruct.comp πℤ ιℤ = CategoryTheory.CategoryStruct.id (P_pull.obj (C₂.obj Aℤ)) ∧
      ∀ x : ℱ.H q,
        p_ℱ x = (CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull _ _ _ _ _ (C₂.obj Aℤ) ℱ q) x)
          (Nat.zero_add q)

def WeilIsCompPullbackNatIso.{u} {S₁ S₂ S₃ : AlgebraicGeometry.Scheme.{u}}
    (h₁ : Quiver.Hom S₁ S₂) (h₂ : Quiver.Hom S₂ S₃) (h₁₂ : Quiver.Hom S₁ S₃)
    [_hCont₁ : (weilAltCdSitePullback h₁).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
    [_hAdj₁ : ((weilAltCdSitePullback h₁).sheafPushforwardContinuous
      AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint]
    [_hCont₂ : (weilAltCdSitePullback h₂).IsContinuous S₃.smallEtaleTopology S₂.smallEtaleTopology]
    [_hAdj₂ : ((weilAltCdSitePullback h₂).sheafPushforwardContinuous
      AddCommGrpCat.{u} S₃.smallEtaleTopology S₂.smallEtaleTopology).IsRightAdjoint]
    [_hCont₁₂ : (weilAltCdSitePullback h₁₂).IsContinuous S₃.smallEtaleTopology S₁.smallEtaleTopology]
    [_hAdj₁₂ : ((weilAltCdSitePullback h₁₂).sheafPushforwardContinuous
      AddCommGrpCat.{u} S₃.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint]
    (η : (((weilAltCdSitePullback h₂).sheafPullback
        AddCommGrpCat.{u} S₃.smallEtaleTopology S₂.smallEtaleTopology).comp
      ((weilAltCdSitePullback h₁).sheafPullback
        AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology)) ≅
      ((weilAltCdSitePullback h₁₂).sheafPullback
        AddCommGrpCat.{u} S₃.smallEtaleTopology S₁.smallEtaleTopology)) : Prop :=
  let J₁ := S₁.smallEtaleTopology
  let J₂ := S₂.smallEtaleTopology
  let J₃ := S₃.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  let C₃ := CategoryTheory.constantSheaf J₃ AddCommGrpCat.{u}
  let B₁ := weilAltCdSitePullback h₁
  let B₂ := weilAltCdSitePullback h₂
  let B₁₂ := weilAltCdSitePullback h₁₂
  let P₁ := B₁.sheafPullback AddCommGrpCat.{u} J₂ J₁
  let P₂ := B₂.sheafPullback AddCommGrpCat.{u} J₃ J₂
  let P₁₂ := B₁₂.sheafPullback AddCommGrpCat.{u} J₃ J₁
  let adj_p₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
  let adj_p₂ := B₂.sheafAdjunctionContinuous AddCommGrpCat.{u} J₃ J₂
  let adj_p₁₂ := B₁₂.sheafAdjunctionContinuous AddCommGrpCat.{u} J₃ J₁
  ∀ {T₁ : S₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
    {T₂ : S₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
    {T₃ : S₃.Etale} (hT₃ : CategoryTheory.Limits.IsTerminal T₃),
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let adj₃ := CategoryTheory.constantSheafAdj J₃ AddCommGrpCat.{u} hT₃
    let πℤ₁ : Quiver.Hom (P₁.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
      (adj_p₁.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
        ((adj₂.homEquiv Aℤ _).symm
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
            ((C₁.obj Aℤ).obj.map (hT₁.from (B₁.obj T₂)).op)))
    let πℤ₂ : Quiver.Hom (P₂.obj (C₃.obj Aℤ)) (C₂.obj Aℤ) :=
      (adj_p₂.homEquiv (C₃.obj Aℤ) (C₂.obj Aℤ)).symm
        ((adj₃.homEquiv Aℤ _).symm
          (CategoryTheory.CategoryStruct.comp (adj₂.unit.app Aℤ)
            ((C₂.obj Aℤ).obj.map (hT₂.from (B₂.obj T₃)).op)))
    let πℤ₁₂ : Quiver.Hom (P₁₂.obj (C₃.obj Aℤ)) (C₁.obj Aℤ) :=
      (adj_p₁₂.homEquiv (C₃.obj Aℤ) (C₁.obj Aℤ)).symm
        ((adj₃.homEquiv Aℤ _).symm
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
            ((C₁.obj Aℤ).obj.map (hT₁.from (B₁₂.obj T₃)).op)))
    CategoryTheory.CategoryStruct.comp (η.inv.app (C₃.obj Aℤ))
      (CategoryTheory.CategoryStruct.comp (P₁.map πℤ₂) πℤ₁) = πℤ₁₂

def WeilSubfieldSheafColimitAt.{u} (q : ℕ) : Prop :=
