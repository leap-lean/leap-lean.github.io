                  (_ : AlgebraicGeometry.IsAffine
                    ((AlgebraicGeometry.Scheme.Etale.forget P_ov.left).obj U).left),
                Set.range (((AlgebraicGeometry.Scheme.Etale.forget P_ov.left).obj U).hom).base ⊆
                  (U_g : Set ↥P_ov.left) →
                ∀ (M_U : Type u) (_ : AddCommGroup M_U)
                  (_ : Module ↑((((AlgebraicGeometry.Scheme.Etale.forget P_ov.left).obj U).left).presheaf.obj (Opposite.op ⊤)) M_U)
                  (b_U : Module.Basis (Fin m_w)
                    ↑((((AlgebraicGeometry.Scheme.Etale.forget P_ov.left).obj U).left).presheaf.obj (Opposite.op ⊤)) M_U)
                  (e_U : M_U ≃+ ↑((((AlgebraicGeometry.Scheme.Etale.forget Γ.left).obj (B_π.obj U)).left).presheaf.obj (Opposite.op ⊤))),
                  (∀ (r₀ : ↑((((AlgebraicGeometry.Scheme.Etale.forget P_ov.left).obj U).left).presheaf.obj (Opposite.op ⊤))) (m : M_U),
