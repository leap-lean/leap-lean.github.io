    (m q : ℕ)
    (α_W : WeilGysinAbSupportClass Z W₀ s_W m q)
    (z_S : weilGysinLocalTorsionH S m (weilGysinEtaleObj h hh) q) : Prop :=
  letI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) s_W :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.Etale) s_W :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) s_S :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.Etale) s_S :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  letI := α_W.hCont
  let U_h : S.Etale := weilGysinEtaleObj h hh
  let M_h : CategoryTheory.Functor W₀.Etale S.Etale :=
    CategoryTheory.MorphismProperty.Over.map ⊤ hh
  let J_Z := Z.smallEtaleTopology
  let J_W := W₀.smallEtaleTopology
  let J_S := S.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let Fℤ_Z := (CategoryTheory.constantSheaf J_Z AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_W := (CategoryTheory.constantSheaf J_W AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_S := (CategoryTheory.constantSheaf J_S AddCommGrpCat.{u}).obj Aℤ
  let FM_W := weilEtaleTorsionSheaf W₀ m
  let L_S := weilGysinLocalTorsionSheaf S m U_h
