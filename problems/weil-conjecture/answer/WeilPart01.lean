def WeilIsLocalTorsionPullback {X₁ X₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom X₁ X₂)
    (U₁ : X₁.Etale) (U₂ : X₂.Etale)
    (τ_U : Quiver.Hom ((weilEtaleSitePullback h).obj U₂) U₁)
    (m q : ℕ)
    (p : weilEtaleLocalTorsionH X₂ m U₂ q →+ weilEtaleLocalTorsionH X₁ m U₁ q) : Prop :=
  let B := weilEtaleSitePullback h
  let J₁ := X₁.smallEtaleTopology
  let J₂ := X₂.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  let L₂ := weilEtaleLocalTorsionSheaf X₂ m U₂
  let L_BU := weilEtaleLocalTorsionSheaf X₁ m (B.obj U₂)
  let L₁ := weilEtaleLocalTorsionSheaf X₁ m U₁
  ∃ (_ : B.IsContinuous J₂ J₁),
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    ∃ (P_pull : CategoryTheory.Functor
          (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u})
          (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}))
      (adj_pull : CategoryTheory.Adjunction P_pull P_push)
      (_ : P_pull.Additive)
      (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
      (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
      (T₁ : X₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (T₂ : X₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
      let πℤ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
        (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
          ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
            (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
              ((C₁.obj Aℤ).obj.map (Opposite.op τ))))
      let ι_BU : Quiver.Hom AM (L_BU.obj.obj (Opposite.op (B.obj U₂))) :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_BU)
      let π_BU : Quiver.Hom (P_pull.obj L₂) L_BU :=
        (adj_pull.homEquiv L₂ L_BU).symm
          (CategoryTheory.Sheaf.freeYonedaHomEquiv.symm ι_BU)
      let π_loc : Quiver.Hom (P_pull.obj L₂) L₁ :=
        CategoryTheory.CategoryStruct.comp π_BU (weilEtaleLocalTorsionMap X₁ m τ_U)
      ∃ (ιℤ : Quiver.Hom (C₁.obj Aℤ) (P_pull.obj (C₂.obj Aℤ))),
        CategoryTheory.CategoryStruct.comp ιℤ πℤ =
          CategoryTheory.CategoryStruct.id (C₁.obj Aℤ) ∧
        CategoryTheory.CategoryStruct.comp πℤ ιℤ =
          CategoryTheory.CategoryStruct.id (P_pull.obj (C₂.obj Aℤ)) ∧
        ∀ x : weilEtaleLocalTorsionH X₂ m U₂ q,
          p x = (CategoryTheory.Abelian.Ext.mk₀ π_loc).postcomp (C₁.obj Aℤ) (Nat.add_zero q)
            ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull _ _ _ _ _
                (C₂.obj Aℤ) L₂ q) x)
              (Nat.zero_add q))
