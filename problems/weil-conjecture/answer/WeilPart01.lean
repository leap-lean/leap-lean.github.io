                        hAdd hLim hColim _ _ Fℤ_P (pf_π.obj K_Γ) (2 * d)) β)
                      (Nat.zero_add (2 * d)))
                HEq ((CategoryTheory.Abelian.Ext.mk₀ ι_Γ_mor).postcomp Fℤ_Γ (Nat.add_zero (2 * d)) α_c)
