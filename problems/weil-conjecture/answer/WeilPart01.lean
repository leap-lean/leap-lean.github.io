noncomputable def weilEtalePostcomp {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom Y₁ Y₂) (hh : AlgebraicGeometry.Etale h) :
    CategoryTheory.Functor Y₁.Etale Y₂.Etale :=
  { obj := fun Z =>
      CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.comp Z.hom h)
        (by
          have : AlgebraicGeometry.Etale Z.hom := Z.prop
          have : AlgebraicGeometry.Etale h := hh
          infer_instance)
    map := fun {X Y} u =>
      CategoryTheory.MorphismProperty.Over.homMk u.left
        ((CategoryTheory.Category.assoc u.left Y.hom h).symm.trans
          (congrArg (fun m => CategoryTheory.CategoryStruct.comp m h)
            (CategoryTheory.MorphismProperty.Over.w u)))
        trivial
    map_id := fun _ => CategoryTheory.MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)
    map_comp := fun _ _ => CategoryTheory.MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _) }

def WeilIsEtaleModRestriction {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom Y₁ Y₂) (hh : AlgebraicGeometry.Etale h) (m q : ℕ)
    (r_q : weilCupPDModH Y₂ m q →+ weilCupPDModH Y₁ m q) : Prop :=
  let R := ULift.{u, 0} (ZMod m)
  let R_mod := ModuleCat.of R R
  let J₁ := Y₁.smallEtaleTopology
  let J₂ := Y₂.smallEtaleTopology
  let Sigma_h := weilEtalePostcomp h hh
  let one₁ := weilCupPDModUnit Y₁ m
  let one₂ := weilCupPDModUnit Y₂ m
  let T₁ := weilEtaleIdTerminal.{u} Y₁
  let hT₁ := weilEtaleIdTerminalIsTerminal.{u} Y₁
  let hT₂ := weilEtaleIdTerminalIsTerminal.{u} Y₂
  let adj₁ := CategoryTheory.constantSheafAdj J₁ (ModuleCat.{u, u} R) hT₁
  let adj₂ := CategoryTheory.constantSheafAdj J₂ (ModuleCat.{u, u} R) hT₂
  ∃ (hc : Sigma_h.IsContinuous J₁ J₂),
    letI := hc
    let R_sh := Sigma_h.sheafPushforwardContinuous (ModuleCat.{u, u} R) J₁ J₂
    ∃ (hAdd : R_sh.Additive) (hLim : CategoryTheory.Limits.PreservesFiniteLimits R_sh)
      (hColim : CategoryTheory.Limits.PreservesFiniteColimits R_sh),
      let α_h : Quiver.Hom one₁ (R_sh.obj one₂) :=
        (adj₁.homEquiv R_mod (R_sh.obj one₂)).symm
          (CategoryTheory.CategoryStruct.comp (adj₂.unit.app R_mod)
            (one₂.obj.map (Opposite.op (hT₂.from (Sigma_h.obj T₁)))))
      ∃ (β_h : Quiver.Hom (R_sh.obj one₂) one₁),
        CategoryTheory.CategoryStruct.comp α_h β_h = CategoryTheory.CategoryStruct.id one₁ ∧
        CategoryTheory.CategoryStruct.comp β_h α_h = CategoryTheory.CategoryStruct.id (R_sh.obj one₂) ∧
        ∀ x : weilCupPDModH Y₂ m q,
          r_q x = (CategoryTheory.Abelian.Ext.mk₀ β_h).postcomp one₁ (Nat.add_zero q)
            ((CategoryTheory.Abelian.Ext.mk₀ α_h).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ R_sh
                hAdd hLim hColim _ _ one₂ one₂ q) x)
              (Nat.zero_add q))
