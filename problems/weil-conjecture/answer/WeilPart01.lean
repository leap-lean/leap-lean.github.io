            (∀ x, q_i x = 0 → (ℓ ^ B₂ : ℕ) • x = 0) ∧
            (∀ y : (𝒦 m).H i.1, ∃ x, q_i x = (ℓ ^ B₂ : ℕ) • y)
noncomputable def weilOuterTrFibEdgeHom {X S : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom X S) (T_S : S.Etale)
    (hT_top : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f).obj T_S))
    (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ) :
    F.H q →+
