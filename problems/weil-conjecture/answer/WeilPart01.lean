def WeilTransvectionCurveSymplecticSystem.{u} (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F) (ℓ n : ℕ) [Fact (Nat.Prime ℓ)]
    (γ' : AlgebraicClosure (Padic ℓ)) : Prop :=
  γ' ≠ 0 ∧
  ∃ (M : ℕ) (_ : 1 ≤ M)
    (J : Matrix (Fin M) (Fin M) (Padic ℓ))
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
    (F_u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ)
    (F_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin M) (Fin M) (PadicInt ℓ)),
    J.transpose = -J ∧
    J.det ≠ 0 ∧
    (∀ g ∈ G_geom,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J) ∧
    (∃ Δ : Set (Fin M → Padic ℓ),
      Δ.Nonempty ∧ (∀ v ∈ Δ, v ≠ 0) ∧
      (∀ g ∈ G_geom, ∀ v ∈ Δ,
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec v ∈ Δ) ∧
      (∀ U_sub : Submodule (Padic ℓ) (Fin M → Padic ℓ),
        (∀ v ∈ Δ, ∀ u ∈ U_sub, (dotProduct u (J.mulVec v)) • v ∈ U_sub) →
        U_sub = ⊥ ∨ U_sub = ⊤) ∧
      (∀ v ∈ Δ, ∀ t : PadicInt ℓ,
        ∃ g ∈ G_geom,
          ∀ x : Fin M → Padic ℓ,
            ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
              x + ((t : Padic ℓ) * dotProduct x (J.mulVec v)) • v)) ∧
    (∀ g ∈ G_geom, F_u * g * F_u⁻¹ ∈ G_geom) ∧
    (((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
      ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) =
        ((Nat.card F : Padic ℓ) ^ n) • J) ∧
    (∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
      ((F_mat d P hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
        ((F_mat d P hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))) =
          ((Nat.card F : Padic ℓ) ^ (n * d)) • J) ∧
    (∀ k : ℕ, 1 ≤ k → WeilGaloisModEllPowCover.{u} F S_aff ℓ M k G_geom F_mat) ∧
    (∃ (α_num β_den : List (AlgebraicClosure (Padic ℓ))),
      (∀ α ∈ α_num, α ≠ 0) ∧ (∀ β ∈ β_den, β ≠ 0) ∧
      ∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
        1 ≤ d →
          ∃ A_Q B_Q : Polynomial ℚ,
            A_Q.coeff 0 = 1 ∧ B_Q.coeff 0 = 1 ∧
            (A_Q.map (algebraMap ℚ (AlgebraicClosure (Padic ℓ)))) *
              (β_den.map (fun β => 1 - Polynomial.C (β ^ d) * Polynomial.X)).prod =
            (B_Q.map (algebraMap ℚ (AlgebraicClosure (Padic ℓ)))) *
              (α_num.map (fun α => 1 - Polynomial.C (α ^ d) * Polynomial.X)).prod *
              (((F_mat d P hP).map
                (algebraMap (PadicInt ℓ) (AlgebraicClosure (Padic ℓ)))).charpolyRev)) ∧
    (∃ (V₁ : Type u) (_ : AddCommGroup V₁) (_ : Module (Padic ℓ) V₁)
        (_ : Module.Finite (Padic ℓ) V₁) (Φ₁ : V₁ →ₗ[Padic ℓ] V₁),
      γ' ∈ (Φ₁.charpoly).aroots (AlgebraicClosure (Padic ℓ)) ∧
      ((Nat.card F : AlgebraicClosure (Padic ℓ)) ^ (n + 1)) / γ' ∈
        (Φ₁.charpoly).aroots (AlgebraicClosure (Padic ℓ)) ∧
      ∀ (r : ℕ) (e : ∀ d : ℕ,
          Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }) ≃
            { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
        1 ≤ r →
          (WeilSymplecticLinInvDual ℓ M G_geom = ⊥ →
            ∑ d ∈ Nat.divisors r,
              ∑ j : Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
                (d : Padic ℓ) *
                  Matrix.trace (((F_mat d (e d j).1 (e d j).2).map
                    (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ (r / d)) =
              - LinearMap.trace (Padic ℓ) V₁ (Φ₁ ^ r))) ∧
    (∀ k : ℕ, 1 ≤ k →
      ∃ (V₂ₖ : Type u) (_ : AddCommGroup V₂ₖ) (_ : Module (Padic ℓ) V₂ₖ)
          (_ : Module.Finite (Padic ℓ) V₂ₖ) (Φ₂ₖ : V₂ₖ →ₗ[Padic ℓ] V₂ₖ),
        ∀ (r : ℕ) (e : ∀ d : ℕ,
            Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }) ≃
              { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
          1 ≤ r →
            ((∀ φ ∈ WeilSymplecticTensorInvDual ℓ M k G_geom,
                φ.comp (PiTensorProduct.map (fun _ : Fin (2 * k) =>
                  ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin)) =
                  ((Nat.card F : Padic ℓ) ^ (k * n)) • φ) →
              ∑ d ∈ Nat.divisors r,
                ∑ j : Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
                  (d : Padic ℓ) *
                    (Matrix.trace (((F_mat d (e d j).1 (e d j).2).map
                      (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ (r / d))) ^ (2 * k) =
                (Module.finrank (Padic ℓ) ↥(WeilSymplecticTensorInvDual ℓ M k G_geom) : Padic ℓ) *
                  ((Nat.card F : Padic ℓ) ^ (k * n + 1)) ^ r -
                  LinearMap.trace (Padic ℓ) V₂ₖ (Φ₂ₖ ^ r)))
