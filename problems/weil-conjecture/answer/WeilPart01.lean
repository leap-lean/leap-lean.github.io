noncomputable abbrev weilCodimTwoComplOpen (k : Type u) [Field k] (m : ℕ) :
    (weilProjectiveSpaceOver k (m + 2)).left.Opens :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 3)) k) :=
    MvPolynomial.gradedAlgebra
  AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 3)) k)
      (MvPolynomial.X 0) ⊔
    AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 3)) k)
      (MvPolynomial.X 1)

def WeilIsCodimTwoLineProjection (k : Type u) [Field k] (m : ℕ)
    (pr_k : ((weilCodimTwoComplOpen k m :
      (weilProjectiveSpaceOver k (m + 2)).left.Opens) : AlgebraicGeometry.Scheme.{u}) ⟶
      (weilProjectiveSpaceOver k 1).left) : Prop :=
  let P_amb := weilProjectiveSpaceOver k (m + 2)
  let P_1 := weilProjectiveSpaceOver k 1
  let U_k := weilCodimTwoComplOpen k m
  let 𝒜_amb := MvPolynomial.homogeneousSubmodule (Fin (m + 3)) k
  let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
  letI : GradedAlgebra 𝒜_amb := MvPolynomial.gradedAlgebra
  letI : GradedAlgebra 𝒜_1 := MvPolynomial.gradedAlgebra
  let ι₂ : Fin 2 → Fin (m + 3) := Fin.cases 0 (fun _ => 1)
  (CategoryTheory.CategoryStruct.comp U_k.ι P_amb.hom =
    CategoryTheory.CategoryStruct.comp pr_k P_1.hom) ∧
  ∀ c : Fin 2,
    let W_c : P_1.left.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X c)
    let D_c : P_amb.left.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_amb (MvPolynomial.X (ι₂ c))
    ((TopologicalSpace.Opens.map pr_k.base).obj W_c =
      (TopologicalSpace.Opens.map U_k.ι.base).obj D_c) ∧
    ∃ (h_le : D_c ≤ U_k)
      (g_hom : 𝒜_1 →+*ᵍ 𝒜_amb)
      (hsub : Submonoid.powers (MvPolynomial.X c) ≤ Submonoid.comap g_hom
        (Submonoid.powers (MvPolynomial.X (ι₂ c))))
      (hX_amb : MvPolynomial.X (ι₂ c) ∈ 𝒜_amb 1)
      (hX_1 : MvPolynomial.X c ∈ 𝒜_1 1),
      g_hom.toRingHom = (MvPolynomial.rename ι₂).toRingHom ∧
      CategoryTheory.CategoryStruct.comp (P_amb.left.homOfLE h_le) pr_k =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_amb (MvPolynomial.X (ι₂ c)) hX_amb Nat.one_pos).hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map g_hom hsub)))
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_1 (MvPolynomial.X c) hX_1 Nat.one_pos).inv
              W_c.ι))
noncomputable def weilCompEtaleSitePullback {W₁ W₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom W₁ W₂) :
    CategoryTheory.Functor W₂.Etale W₁.Etale :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
