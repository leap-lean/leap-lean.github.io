    (∀ r : ℕ, p_kum r = (ℓ ^ r) • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf X.left)) ∧
    (∀ (r : ℕ) (a : ZMod (ℓ ^ r)),
