      let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_raw r)))) e_U.hom
      let π_succ : Quiver.Hom
          (AlgebraicGeometry.Spec (CommRingCat.of (B_raw (r + 1)))) U₀.toScheme :=
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_raw (r + 1))))) e_U.hom
      let ℛ_r := weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * m + 1) r
      let ℛ_succ := weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * m + 1) (r + 1)
      let π_ℛ := weilMidDevOpenHigherDirectImageMap F f₀ U₀ ℓ (2 * m + 1) r
      (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
        let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
        let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
        let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
        let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
        ∀ (u_r : Quiver.Hom W₁_r W₂_r),
          CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst h₁ π_r)
              ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
          CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
            CategoryTheory.Limits.pullback.snd h₁ π_r →
          ∀ (s : ↑(ℛ_r.obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
            triv_R r W₁ ((ℛ_r.obj.map (Opposite.op u)) s) y₁ =
              triv_R r W₂ s (u_r.base y₁)) ∧
      ∀ (W : U₀.toScheme.Etale),
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
        let W_r := CategoryTheory.Limits.pullback h_W π_r
        let W_succ := CategoryTheory.Limits.pullback h_W π_succ
        Function.Injective (triv_R r W) ∧
        Set.range (triv_R r W) =
          { f | ∀ (σ : B_raw r ≃ₐ[R₀] B_raw r) (m_σ : Quiver.Hom W_r W_r),
            CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π_r) =
              CategoryTheory.Limits.pullback.fst h_W π_r →
            CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W π_r)
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
            ∀ y : ↥W_r, f (m_σ.base y) = (ρ_raw r σ).val (f y) } ∧
        ∀ (s_up : ↑(ℛ_succ.obj.obj (Opposite.op W)))
          (m_ι : Quiver.Hom W_succ W_r),
          CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.fst h_W π_r) =
            CategoryTheory.Limits.pullback.fst h_W π_succ →
          CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.snd h_W π_r) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.snd h_W π_succ)
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_Braw r).toRingHom)) →
          ∀ (y_up : ↥W_succ),
            triv_R r W ((π_ℛ.hom.app (Opposite.op W)) s_up) (m_ι.base y_up) =
              weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ (r + 1) (2 * m + 1)
                (triv_R (r + 1) W s_up y_up)
  hQ_u_raw : ∃ (Q_u : ∀ r : ℕ, letI := hCR r; Ideal (B_raw r))
      (σ_u : ∀ r : ℕ, letI := hCR r; letI := hAR_B r
        B_raw r ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))]
          B_raw r),
    ∀ r : ℕ,
      letI := hCR r; letI := hCR (r + 1); letI := hAP_B r; letI := hAR_B r; letI := hAR_B (r + 1)
      (Q_u r).IsMaximal ∧
      Ideal.comap (algebraMap (Polynomial F) (B_raw r)) (Q_u r) =
        Ideal.span {Polynomial.X - Polynomial.C a₀} ∧
      Ideal.comap (ι_Braw r).toRingHom (Q_u (r + 1)) = Q_u r ∧
      (∀ b : B_raw r, σ_u (r + 1) (ι_Braw r b) = ι_Braw r (σ_u r b)) ∧
      (∀ b : B_raw r, (σ_u r).symm b - b ^ Nat.card F ∈ Q_u r) ∧
      ∀ (f_u : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1) →+
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1)),
        WeilIsTorsionGeomFrobAction F Z_u₀ (ℓ ^ (r + 1)) (2 * m + 1) f_u →
        ∀ v, (ρ_raw r (σ_u r)).val v = f_u v
  hQ_P_raw : ∀ (d : ℕ) (P_poly : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
    ∃ (Q_P : ∀ r : ℕ, letI := hCR r; Ideal (B_raw r))
      (σ_P : ∀ r : ℕ, letI := hCR r; letI := hAR_B r
        B_raw r ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))]
          B_raw r),
      (∀ r : ℕ,
        letI := hCR r; letI := hCR (r + 1); letI := hAP_B r; letI := hAR_B r; letI := hAR_B (r + 1)
        (Q_P r).IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) (B_raw r)) (Q_P r) = Ideal.span {P_poly} ∧
        Ideal.comap (ι_Braw r).toRingHom (Q_P (r + 1)) = Q_P r ∧
        (∀ b : B_raw r, σ_P (r + 1) (ι_Braw r b) = ι_Braw r (σ_P r b)) ∧
        (∀ b : B_raw r, (σ_P r).symm b - b ^ (Nat.card F ^ d) ∈ Q_P r)) ∧
      (1 ≤ d →
        let _ : Fact (Irreducible P_poly) := ⟨hP.2.1⟩
        ∀ (hFin_P : Finite (AdjoinRoot P_poly)),
          let _ : Finite (AdjoinRoot P_poly) := hFin_P
          ∃ ψ_P : ∀ r : ℕ,
              weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1) ≃+
                weilEtaleTorsionH
                  (weilGeomScheme (AdjoinRoot P_poly)
                    (weilTransvTriClosedPointFiber F f₀ j_aff P_poly))
                  (ℓ ^ (r + 1)) (2 * m + 1),
            (∀ (r : ℕ)
              (v : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 2)) (2 * m + 1)),
              weilEtaleTorsionTransition
                (weilGeomScheme (AdjoinRoot P_poly)
                  (weilTransvTriClosedPointFiber F f₀ j_aff P_poly))
                ℓ (r + 1) (2 * m + 1) (ψ_P (r + 1) v) =
              ψ_P r
                (weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ (r + 1) (2 * m + 1) v)) ∧
            (∀ (r : ℕ)
              (f_P : weilEtaleTorsionH
                  (weilGeomScheme (AdjoinRoot P_poly)
                    (weilTransvTriClosedPointFiber F f₀ j_aff P_poly))
                  (ℓ ^ (r + 1)) (2 * m + 1) →+
                weilEtaleTorsionH
                  (weilGeomScheme (AdjoinRoot P_poly)
                    (weilTransvTriClosedPointFiber F f₀ j_aff P_poly))
                  (ℓ ^ (r + 1)) (2 * m + 1)),
              WeilIsTorsionGeomFrobAction (AdjoinRoot P_poly)
                (weilTransvTriClosedPointFiber F f₀ j_aff P_poly) (ℓ ^ (r + 1)) (2 * m + 1) f_P →
              ∀ v, ψ_P r ((ρ_raw r (σ_P r)).val v) = f_P (ψ_P r v)))
  hCup_geom : ∀ (r : ℕ),
    letI := hCR r; letI := hAF_B r; letI := hAR_B r
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∀ σ : B_raw r ≃ₐ[R₀] B_raw r,
      (∀ x : B_raw r, IsIntegral F x → σ x = x) →
      ∀ (θ_mid : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1) →+
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1))
        (θ_top : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * (2 * m + 1)) →+
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * (2 * m + 1))),
        WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1) θ_mid →
        WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1))
          (2 * (2 * m + 1)) θ_top →
        ∀ (a b a' b' : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1)),
          (ρ_raw r σ).val (θ_mid a) = θ_mid a' →
          (ρ_raw r σ).val (θ_mid b) = θ_mid b' →
          θ_top (CategoryTheory.Abelian.Ext.comp a' b' (Nat.two_mul (2 * m + 1)).symm) =
            θ_top (CategoryTheory.Abelian.Ext.comp a b (Nat.two_mul (2 * m + 1)).symm)
def WeilCurveMidExtIsGeomGaloisCover.{u}
    (S : AlgebraicGeometry.Scheme.{u}) (U : S.Opens)
    (Γ : Type u) [Group Γ]
    (V : AlgebraicGeometry.Scheme.{u})
    (π : Quiver.Hom V U.toScheme)
    (act : Γ → Quiver.Hom V V) : Prop :=
  AlgebraicGeometry.IsFinite π ∧
  AlgebraicGeometry.Etale π ∧
  AlgebraicGeometry.Surjective π ∧
  act 1 = CategoryTheory.CategoryStruct.id V ∧
  (∀ g₁ g₂ : Γ, act (g₁ * g₂) = CategoryTheory.CategoryStruct.comp (act g₂) (act g₁)) ∧
  ∃ h_over : ∀ g : Γ, CategoryTheory.CategoryStruct.comp (act g) π = π,
    (∀ g : Γ,
      AlgebraicGeometry.IsOpenImmersion
        (CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id V) (act g)
          ((CategoryTheory.Category.id_comp π).trans (h_over g).symm))) ∧
    (_root_.Pairwise fun g₁ g₂ : Γ =>
      Disjoint
        (Set.range (CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id V)
          (act g₁) ((CategoryTheory.Category.id_comp π).trans (h_over g₁).symm)).base)
        (Set.range (CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id V)
          (act g₂) ((CategoryTheory.Category.id_comp π).trans (h_over g₂).symm)).base)) ∧
    (⋃ g : Γ,
      Set.range (CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id V)
        (act g) ((CategoryTheory.Category.id_comp π).trans (h_over g).symm)).base) = Set.univ

def WeilCurveMidExtIsSheafPair.{u}
    (S : AlgebraicGeometry.Scheme.{u}) (U : S.Opens) (m M : ℕ)
    (Γ : Type u) [Group Γ]
    (V : AlgebraicGeometry.Scheme.{u})
    (π : Quiver.Hom V U.toScheme)
    (act : Γ → Quiver.Hom V V)
    (τ_rep : Γ →* (Matrix (Fin M) (Fin M) (ZMod m))ˣ)
    (𝒥 ℳ : CategoryTheory.Sheaf S.smallEtaleTopology
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))))
    (ι_ext : Quiver.Hom 𝒥 ℳ)
    (triv : ∀ W : S.Etale,
      let ι_V : Quiver.Hom V S := CategoryTheory.CategoryStruct.comp π U.ι
      let W_V := CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom ι_V
      ↑(ℳ.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_V (Fin M → ZMod m)) : Prop :=
  let ι_V : Quiver.Hom V S := CategoryTheory.CategoryStruct.comp π U.ι
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  (∀ {W₁ W₂ : S.Etale} (u : Quiver.Hom W₁ W₂),
    let h₁ := (Fgt.obj W₁).hom
    let h₂ := (Fgt.obj W₂).hom
    let W₁_V := CategoryTheory.Limits.pullback h₁ ι_V
    let W₂_V := CategoryTheory.Limits.pullback h₂ ι_V
    ∀ (u_V : Quiver.Hom W₁_V W₂_V),
      CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.fst h₂ ι_V) =
        CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst h₁ ι_V)
          (Fgt.map u).left →
      CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.snd h₂ ι_V) =
        CategoryTheory.Limits.pullback.snd h₁ ι_V →
      ∀ (s : ↑(ℳ.obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_V),
        triv W₁ ((ℳ.obj.map (Opposite.op u)).hom s) y₁ = triv W₂ s (u_V.base y₁)) ∧
  ∀ W : S.Etale,
    let h_W := (Fgt.obj W).hom
    let W_V := CategoryTheory.Limits.pullback h_W ι_V
    Function.Injective (triv W) ∧
    Function.Injective (ι_ext.hom.app (Opposite.op W)).hom ∧
    Set.range (triv W) =
      { f | ∀ (g : Γ) (m_g : Quiver.Hom W_V W_V),
        CategoryTheory.CategoryStruct.comp m_g (CategoryTheory.Limits.pullback.fst h_W ι_V) =
          CategoryTheory.Limits.pullback.fst h_W ι_V →
        CategoryTheory.CategoryStruct.comp m_g (CategoryTheory.Limits.pullback.snd h_W ι_V) =
          CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd h_W ι_V)
            (act g) →
        ∀ y : ↥W_V, f (m_g.base y) = ((τ_rep g).val).mulVec (f y) } ∧
    Set.range ((triv W).comp (ι_ext.hom.app (Opposite.op W)).hom.toAddMonoidHom) =
      { f |
        (∃ W₀ : (Fgt.obj W).left.Opens,
          ((TopologicalSpace.Opens.map h_W.base).obj U) ⊔ W₀ = ⊤ ∧
          ∀ y : ↥W_V, (CategoryTheory.Limits.pullback.fst h_W ι_V).base y ∈ W₀ → f y = 0) ∧
        (∀ (g : Γ) (m_g : Quiver.Hom W_V W_V),
          CategoryTheory.CategoryStruct.comp m_g (CategoryTheory.Limits.pullback.fst h_W ι_V) =
            CategoryTheory.Limits.pullback.fst h_W ι_V →
          CategoryTheory.CategoryStruct.comp m_g (CategoryTheory.Limits.pullback.snd h_W ι_V) =
            CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd h_W ι_V)
              (act g) →
          ∀ y : ↥W_V, f (m_g.base y) = ((τ_rep g).val).mulVec (f y)) }

structure WeilCurveMidExtLevelWitness.{u}
    (S : AlgebraicGeometry.Scheme.{u}) (U : S.Opens) (m M : ℕ) : Type (u + 1) where
  Γ : Type u
  [hGrp : Group Γ]
  [hFin : Finite Γ]
  V : AlgebraicGeometry.Scheme.{u}
  π : Quiver.Hom V U.toScheme
  act : Γ → Quiver.Hom V V
  hGal : WeilCurveMidExtIsGeomGaloisCover S U Γ V π act
  τ_rep : Γ →* (Matrix (Fin M) (Fin M) (ZMod m))ˣ
  τ_dual : Γ →* (Matrix (Fin M) (Fin M) (ZMod m))ˣ
  h_dual : ∀ g : Γ, (τ_dual g).val = (((τ_rep g)⁻¹).val).transpose
  𝒥 : CategoryTheory.Sheaf S.smallEtaleTopology
    (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))
  ℳ : CategoryTheory.Sheaf S.smallEtaleTopology
    (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))
  𝒥_dual : CategoryTheory.Sheaf S.smallEtaleTopology
    (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))
  ℳ_dual : CategoryTheory.Sheaf S.smallEtaleTopology
    (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))
  ι_ext : Quiver.Hom 𝒥 ℳ
  triv : ∀ W : S.Etale,
    let ι_V : Quiver.Hom V S := CategoryTheory.CategoryStruct.comp π U.ι
    let W_V := CategoryTheory.Limits.pullback
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom ι_V
    ↑(ℳ.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_V (Fin M → ZMod m)
  ι_dual : Quiver.Hom 𝒥_dual ℳ_dual
  triv_dual : ∀ W : S.Etale,
    let ι_V : Quiver.Hom V S := CategoryTheory.CategoryStruct.comp π U.ι
    let W_V := CategoryTheory.Limits.pullback
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom ι_V
    ↑(ℳ_dual.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_V (Fin M → ZMod m)
  hPair : WeilCurveMidExtIsSheafPair S U m M Γ V π act τ_rep 𝒥 ℳ ι_ext triv
  hPair_dual : WeilCurveMidExtIsSheafPair S U m M Γ V π act τ_dual 𝒥_dual ℳ_dual ι_dual triv_dual

instance instGroupWeilCurveMidExtLevelWitnessΓ
