                    ((AlgebraicGeometry.Scheme.Etale.forget Γ.left).map u).left)) (ι_ζΓ U s)) →
              (∀ {U' U : P_ov.left.Etale} (u : Quiver.Hom U' U) (s),
                ι_ζP U' (((weilAltLocConstPresheaf P_ov.left n).map (Opposite.op u)) s) =
                  (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop
                    ((AlgebraicGeometry.Scheme.Etale.forget P_ov.left).map u).left)) (ι_ζP U s)) →
              (∀ (U : Γ.left.Etale) (a : ZMod n),
                ι_ζΓ U (LocallyConstant.const _ (ULift.up a)) =
                  (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
                    (AlgebraicGeometry.Scheme.Hom.appTop
                      (CategoryTheory.CategoryStruct.comp
                        ((AlgebraicGeometry.Scheme.Etale.forget Γ.left).obj U).hom Γ.hom)))
                    ((ζ : kˣ) : k)) ^ a.val) →
