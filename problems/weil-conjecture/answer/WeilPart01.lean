    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ s_W
  let B_sS : CategoryTheory.Functor S.Etale Z.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ s_S
  let sW_push := B_sW.sheafPushforwardContinuous AddCommGrpCat.{u} J_W J_Z
