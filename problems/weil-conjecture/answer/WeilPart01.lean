  (∀ (δ r b : ℕ), 3 ≤ b →
    CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage (π_fst δ) b (weilEtaleTorsionSheaf (Pd (δ + 1)) (ℓ ^ r)))) ∧
  (∀ (δ r : ℕ) (T_δ : (Pd δ).Etale) (hT_δ : CategoryTheory.Limits.IsTerminal T_δ)
     (hT_top : CategoryTheory.Limits.IsTerminal
