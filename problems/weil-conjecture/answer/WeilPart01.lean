        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_bar).obj W).hom
        let W_V := CategoryTheory.Limits.pullback h_W ι_bar
        Function.Injective (triv_K m W) ∧
        Set.range (triv_K m W) =
          { f | ∃ W₀ : ((AlgebraicGeometry.Scheme.Etale.forget D_bar).obj W).left.Opens,
            ((TopologicalSpace.Opens.map h_W.base).obj U_bar) ⊔ W₀ = ⊤ ∧
            ∀ y : ↥W_V, (CategoryTheory.Limits.pullback.fst h_W ι_bar).base y ∈ W₀ → f y = 0 } ∧
        ∀ (sec_up : ↑((𝒦 (m + 1)).obj.obj (Opposite.op W))) (y : ↥W_V),
          triv_K m W (((τ_𝒦 m).hom.app (Opposite.op W)) sec_up) y =
            ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
              (triv_K (m + 1) W sec_up y)) ∧
    ∀ (σ : B₀ ≃ₐ[R₀] B₀),
      let α_σ : Quiver.Hom V_bar V_bar :=
        CategoryTheory.CategoryStruct.comp
          (weilSchemeEndPow (weilGeomFrobHom F V_ov) r)
          (weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹)
      let g_D_r : Quiver.Hom D_bar D_bar := weilSchemeEndPow (weilGeomFrobHom F D_ov) r
      ∃ (α_H : ∀ (m i : ℕ), (𝒦 m).H i →+ (𝒦 m).H i),
        (∃ (G_Dr : CategoryTheory.Functor D_bar.Etale D_bar.Etale)
          (hCont_Dr : G_Dr.IsContinuous D_bar.smallEtaleTopology D_bar.smallEtaleTopology),
          letI := hCont_Dr
          let P_Dr := G_Dr.sheafPushforwardContinuous AddCommGrpCat.{u}
            D_bar.smallEtaleTopology D_bar.smallEtaleTopology
          let Fgt := AlgebraicGeometry.Scheme.Etale.forget D_bar
          (∀ U : D_bar.Etale, (Fgt.obj (G_Dr.obj U)).left = (Fgt.obj U).left ∧
            HEq (Fgt.obj (G_Dr.obj U)).hom
              (CategoryTheory.CategoryStruct.comp (Fgt.obj U).hom g_D_r)) ∧
          (∀ {U₁ U₂ : D_bar.Etale} (u : Quiver.Hom U₁ U₂),
            HEq (Fgt.map (G_Dr.map u)).left (Fgt.map u).left) ∧
          ∃ (hAdd_P : P_Dr.Additive)
            (hLim_P : CategoryTheory.Limits.PreservesFiniteLimits P_Dr)
            (hColim_P : CategoryTheory.Limits.PreservesFiniteColimits P_Dr)
            (T_D : D_bar.Etale) (hT_D : CategoryTheory.Limits.IsTerminal T_D)
            (μ_D : Quiver.Hom (G_Dr.obj T_D) T_D),
            (Fgt.obj T_D).left = D_bar ∧
            HEq (Fgt.obj T_D).hom (CategoryTheory.CategoryStruct.id D_bar) ∧
            HEq (Fgt.map μ_D).left g_D_r ∧
            let C_D := CategoryTheory.constantSheaf D_bar.smallEtaleTopology AddCommGrpCat.{u}
            let Fℤ := C_D.obj (AddCommGrpCat.of (ULift.{u} ℤ))
            let adj_D := CategoryTheory.constantSheafAdj D_bar.smallEtaleTopology AddCommGrpCat.{u} hT_D
            let αℤ : Quiver.Hom Fℤ (P_Dr.obj Fℤ) :=
              (adj_D.homEquiv (AddCommGrpCat.of (ULift.{u} ℤ)) (P_Dr.obj Fℤ)).symm
                (CategoryTheory.CategoryStruct.comp
                  (adj_D.unit.app (AddCommGrpCat.of (ULift.{u} ℤ)))
                  (Fℤ.obj.map (Opposite.op μ_D)))
            ∀ m : ℕ,
              ∃ (β_m : Quiver.Hom (P_Dr.obj (𝒦 m)) (𝒦 m)),
                (∀ (W : D_bar.Etale)
                  (sec : ↑((P_Dr.obj (𝒦 m)).obj.obj (Opposite.op W)))
                  (w_V : Quiver.Hom
                    (CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar)
                    (CategoryTheory.Limits.pullback (Fgt.obj (G_Dr.obj W)).hom ι_bar)),
                  HEq (CategoryTheory.CategoryStruct.comp w_V
                    (CategoryTheory.Limits.pullback.fst (Fgt.obj (G_Dr.obj W)).hom ι_bar))
                    (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar) →
                  CategoryTheory.CategoryStruct.comp w_V
                    (CategoryTheory.Limits.pullback.snd (Fgt.obj (G_Dr.obj W)).hom ι_bar) =
                    CategoryTheory.CategoryStruct.comp
                      (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_bar) α_σ →
                  ∀ y : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar),
                    triv_K m W ((β_m.hom.app (Opposite.op W)) sec) y =
                      triv_K m (G_Dr.obj W) sec (w_V.base y)) ∧
