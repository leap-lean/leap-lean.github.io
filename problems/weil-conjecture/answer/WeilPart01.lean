noncomputable def weilOuterBCFunIso {X S S' X' : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom X S) (g : Quiver.Hom S' S)
    (f' : Quiver.Hom X' S') (g' : Quiver.Hom X' X)
    (hgf : CategoryTheory.CategoryStruct.comp g' f = CategoryTheory.CategoryStruct.comp f' g) :
    CategoryTheory.Iso
      (CategoryTheory.Functor.comp (weilEtaleSitePullback f) (weilEtaleSitePullback g'))
      (CategoryTheory.Functor.comp (weilEtaleSitePullback g) (weilEtaleSitePullback f')) :=
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  CategoryTheory.Iso.trans
    (CategoryTheory.Iso.symm (CategoryTheory.MorphismProperty.Over.pullbackComp g' f))
    (CategoryTheory.Iso.trans
      (CategoryTheory.MorphismProperty.Over.pullbackCongr hgf)
      (CategoryTheory.MorphismProperty.Over.pullbackComp f' g))

noncomputable def weilOuterBCApp {X S S' X' : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom X S) (g : Quiver.Hom S' S)
    (f' : Quiver.Hom X' S') (g' : Quiver.Hom X' X)
    [_hc_g : (weilEtaleSitePullback g).IsContinuous S.smallEtaleTopology S'.smallEtaleTopology]
    [_hc_g' : (weilEtaleSitePullback g').IsContinuous X.smallEtaleTopology X'.smallEtaleTopology]
    [_hr_g' : ((weilEtaleSitePullback g').sheafPushforwardContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology).IsRightAdjoint]
    [_hAdd_g' : ((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology).Additive]
    [_hLim_g' : CategoryTheory.Limits.PreservesFiniteLimits
      ((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
        X.smallEtaleTopology X'.smallEtaleTopology)]
    [_hColim_g' : CategoryTheory.Limits.PreservesFiniteColimits
      ((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
        X.smallEtaleTopology X'.smallEtaleTopology)]
    (hgf : CategoryTheory.CategoryStruct.comp g' f = CategoryTheory.CategoryStruct.comp f' g)
    (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ)
    (W : S.Etale) :
    Quiver.Hom
      ((CategoryTheory.Functor.comp (weilEtaleSitePullback f).op
        (CategoryTheory.Sheaf.cohomologyPresheaf F q)).obj (Opposite.op W))
      ((((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
        S.smallEtaleTopology S'.smallEtaleTopology).obj
          (weilEtaleHigherDirectImage f' q
            (((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
              X.smallEtaleTopology X'.smallEtaleTopology).obj F))).obj.obj (Opposite.op W)) :=
  let B_f := weilEtaleSitePullback f
  let B_g := weilEtaleSitePullback g
  let B_f' := weilEtaleSitePullback f'
  let pb_g' := (weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
    X.smallEtaleTopology X'.smallEtaleTopology
  let e_fun := weilOuterBCFunIso f g f' g' hgf
  let ρ_W := weilPolyP1CohomologyRepPullHom g' (B_f.obj W) (B_f'.obj (B_g.obj W))
    (e_fun.inv.app W)
  let map_ext :
      ↑((CategoryTheory.Sheaf.cohomologyPresheaf F q).obj (Opposite.op (B_f.obj W))) →+
      ↑((CategoryTheory.Sheaf.cohomologyPresheaf (pb_g'.obj F) q).obj
        (Opposite.op (B_f'.obj (B_g.obj W)))) :=
    ((CategoryTheory.Abelian.Ext.mk₀ ρ_W).precomp (pb_g'.obj F) (Nat.zero_add q)).comp
      (pb_g'.mapExtAddHom (weilPolyP1CohomologyRepSheaf X (B_f.obj W)) F q)
  CategoryTheory.CategoryStruct.comp
    (AddCommGrpCat.ofHom map_ext)
    (((CategoryTheory.sheafificationAdjunction S'.smallEtaleTopology AddCommGrpCat.{u}).unit.app
      (CategoryTheory.Functor.comp B_f'.op
        (CategoryTheory.Sheaf.cohomologyPresheaf (pb_g'.obj F) q))).app
      (Opposite.op (B_g.obj W)))

