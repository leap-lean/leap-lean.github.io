    (hCont_M : M_h.IsContinuous J_W J_S),
    letI := hCont_sS
    letI := hCont_M
    let sS_push := B_sS.sheafPushforwardContinuous AddCommGrpCat.{u} J_S J_Z
    let h_res := M_h.sheafPushforwardContinuous AddCommGrpCat.{u} J_W J_S
    ∃ (L_sh : CategoryTheory.Functor
        (CategoryTheory.Sheaf J_W AddCommGrpCat.{u})
        (CategoryTheory.Sheaf J_S AddCommGrpCat.{u}))
      (adj_sh : L_sh ⊣ h_res)
      (hAdd : L_sh.Additive)
      (hLim : CategoryTheory.Limits.PreservesFiniteLimits L_sh)
      (hColim : CategoryTheory.Limits.PreservesFiniteColimits L_sh)
      (T_Z : Z.Etale) (hT_Z : CategoryTheory.Limits.IsTerminal T_Z)
      (T_W : W₀.Etale) (hT_W : CategoryTheory.Limits.IsTerminal T_W)
      (T_S : S.Etale) (hT_S : CategoryTheory.Limits.IsTerminal T_S)
      (e_L : CategoryTheory.Iso (L_sh.obj FM_W) L_S)
      (e_supp : CategoryTheory.Iso (L_sh.obj (sW_push.obj Fℤ_Z)) (sS_push.obj Fℤ_Z)),
      letI := hAdd
      letI := hLim
      letI := hColim
      let adj_Z := CategoryTheory.constantSheafAdj J_Z AddCommGrpCat.{u} hT_Z
      let adj_W := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT_W
      let adj_S := CategoryTheory.constantSheafAdj J_S AddCommGrpCat.{u} hT_S
      let τ_sW : Quiver.Hom (B_sW.obj T_W) T_Z := hT_Z.from (B_sW.obj T_W)
      let τ_sS : Quiver.Hom (B_sS.obj T_S) T_Z := hT_Z.from (B_sS.obj T_S)
      let τ_Mh : Quiver.Hom (M_h.obj T_W) T_S := hT_S.from (M_h.obj T_W)
      let q_sW : Quiver.Hom Fℤ_W (sW_push.obj Fℤ_Z) :=
        (adj_W.homEquiv Aℤ (sW_push.obj Fℤ_Z)).symm
          (CategoryTheory.CategoryStruct.comp (adj_Z.unit.app Aℤ)
            (Fℤ_Z.obj.map (Opposite.op τ_sW)))
      let q_sS : Quiver.Hom Fℤ_S (sS_push.obj Fℤ_Z) :=
        (adj_S.homEquiv Aℤ (sS_push.obj Fℤ_Z)).symm
          (CategoryTheory.CategoryStruct.comp (adj_Z.unit.app Aℤ)
            (Fℤ_Z.obj.map (Opposite.op τ_sS)))
