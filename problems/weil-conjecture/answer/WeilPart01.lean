abbrev WeilTopDegKummerChartPushFn (k : Type u) [Field k] (d n : ℕ) : Type (u + 1) :=
  ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
    AlgebraicGeometry.IsIntegral Y.left →
    [AlgebraicGeometry.IsProper Y.hom] →
    topologicalKrullDim Y.left = (d : WithBot ℕ∞) →
    ∀ (W : Y.left.Opens),
      AlgebraicGeometry.IsAffineOpen W →
      Nonempty ↥W →
      let kAlgY : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W)) :=
        RingHom.toAlgebra (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))
      ∀ (w : Fin d → ↑(Y.left.presheaf.obj (Opposite.op W))),
        @IsTranscendenceBasis (Fin d) k ↑(Y.left.presheaf.obj (Opposite.op W)) _ _ kAlgY w →
        (weilEtaleTorsionH Y.left n (2 * d) →+
          weilEtaleTorsionH (weilPolyP1Over k d).left n (2 * d))

