def WeilIsOuterConnHom {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S)
    {SC : CategoryTheory.ShortComplex
      (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})}
    (hSE : SC.ShortExact) (q : ℕ)
    (δ : Quiver.Hom (weilEtaleHigherDirectImage f q SC.X₃)
      (weilEtaleHigherDirectImage f (q + 1) SC.X₁)) : Prop :=
