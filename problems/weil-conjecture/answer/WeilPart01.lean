def weilPunctCurveSkyscraperPresheaf {S₀ X : AlgebraicGeometry.Scheme.{u}} {m : ℕ}
    (σ : Fin m → Quiver.Hom S₀ X) (M : AddCommGrpCat.{u}) :
    CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u} where
  obj opW := AddCommGrpCat.of
    (∀ a : Fin m, weilPunctCurveSectionLift σ a (Opposite.unop opW) → ↑M)
  map {_ _} f := AddCommGrpCat.ofHom
    { toFun := fun s a γ =>
        s a ⟨CategoryTheory.CategoryStruct.comp γ.1
          ((AlgebraicGeometry.Scheme.Etale.forget X).map f.unop).left,
          (CategoryTheory.Category.assoc γ.1
            ((AlgebraicGeometry.Scheme.Etale.forget X).map f.unop).left _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp γ.1)
              ((AlgebraicGeometry.Scheme.Etale.forget X).map f.unop).w).trans γ.2)⟩
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  map_id _ := AddCommGrpCat.ext fun s => funext fun a => funext fun γ =>
    congrArg (s a) (Subtype.ext (CategoryTheory.Category.comp_id γ.1))
  map_comp _ _ := AddCommGrpCat.ext fun s => funext fun a => funext fun γ =>
    congrArg (s a) (Subtype.ext (CategoryTheory.Category.assoc γ.1 _ _).symm)

def weilPunctCurveSkyscraperMap {S₀ X : AlgebraicGeometry.Scheme.{u}} {m : ℕ}
    (σ : Fin m → Quiver.Hom S₀ X) {M₁ M₂ : AddCommGrpCat.{u}} (φ : Quiver.Hom M₁ M₂) :
    Quiver.Hom (weilPunctCurveSkyscraperPresheaf σ M₁)
      (weilPunctCurveSkyscraperPresheaf σ M₂) where
  app _ := AddCommGrpCat.ofHom
    { toFun := fun s a γ => φ.hom (s a γ)
      map_zero' := funext fun _ => funext fun _ => φ.hom.map_zero
      map_add' := fun s₁ s₂ => funext fun a => funext fun γ =>
        φ.hom.map_add (s₁ a γ) (s₂ a γ) }
  naturality _ _ _ := AddCommGrpCat.ext fun _ => rfl
noncomputable abbrev weilEtaleTerminalSkyscraperPresheaf (Y : AlgebraicGeometry.Scheme.{u})
    (M : AddCommGrpCat.{u}) :
    CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
  let T_Y : Y.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y)
  { obj := fun W => CategoryTheory.Limits.piObj (fun _ : Quiver.Hom T_Y (Opposite.unop W) => M)
    map := fun {W₁ W₂} f =>
      CategoryTheory.Limits.Pi.lift (fun τ : Quiver.Hom T_Y (Opposite.unop W₂) =>
        CategoryTheory.Limits.Pi.π (fun _ : Quiver.Hom T_Y (Opposite.unop W₁) => M)
          (CategoryTheory.CategoryStruct.comp τ f.unop))
    map_id := fun W => by
      apply CategoryTheory.Limits.Pi.hom_ext
      intro τ
      simp
    map_comp := fun {W₁ W₂ W₃} f g => by
      apply CategoryTheory.Limits.Pi.hom_ext
      intro τ
      simp }

