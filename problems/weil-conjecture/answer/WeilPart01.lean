def WeilEllPrimaryConstructibleStep (ℓ : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) :
    ℕ → CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u} → Prop :=
  fun m =>
    Nat.rec
      (motive := fun _ => CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u} → Prop)
      (fun G => CategoryTheory.Limits.IsZero G)
      (fun _ prev G =>
        ∃ (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})),
          SC.ShortExact ∧
          Nonempty (CategoryTheory.Iso SC.X₂ G) ∧
          prev SC.X₁ ∧
          WeilIsConstructibleModPrimeSheaf ℓ Y SC.X₃)
      m

def WeilEllPrimaryConstructible (ℓ : ℕ) (Y : AlgebraicGeometry.Scheme.{u})
    (G : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) : Prop :=
  ∃ m : ℕ, WeilEllPrimaryConstructibleStep ℓ Y m G
noncomputable def weilCurvePowOver (k : Type u) [Field k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))) :
    ℕ → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
  Nat.rec
    (CategoryTheory.Over.mk
      (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k))))
    (fun _ P =>
      CategoryTheory.Over.mk
        (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.fst P.hom C.hom) P.hom))

noncomputable def weilCurvePowProj (k : Type u) [Field k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))) :
    ∀ (d : ℕ), Fin d → ((weilCurvePowOver k C d).left ⟶ C.left) :=
  Nat.rec
    (fun j => Fin.elim0 j)
    (fun d prev j =>
      let P := weilCurvePowOver k C d
      Fin.cases
        (CategoryTheory.Limits.pullback.snd P.hom C.hom)
        (fun i => CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.fst P.hom C.hom) (prev i))
        j)

noncomputable def weilCurveDivSum (X : AlgebraicGeometry.Scheme.{u}) {d : ℕ}
    (Q : Fin d → { x : ↥X // IsClosed ({x} : Set ↥X) }) :
    ({ x : ↥X // IsClosed ({x} : Set ↥X) } →₀ ℤ) :=
  Finset.univ.sum fun j : Fin d => Finsupp.single (Q j) (1 : ℤ)

def weilCurvePowMatchesTuple (k : Type u) [Field k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))) {d : ℕ}
    (z : ↥(weilCurvePowOver k C d).left)
    (Q : Fin d → { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }) : Prop :=
  IsClosed ({z} : Set ↥(weilCurvePowOver k C d).left) ∧
  ∀ j : Fin d, (weilCurvePowProj k C d j).base z = (Q j).1

def weilCurveEffSubsingleton (X : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral X]
    (D : ({ x : ↥X // IsClosed ({x} : Set ↥X) } →₀ ℤ)) : Prop :=
  Subsingleton
    { E' : ({ x : ↥X // IsClosed ({x} : Set ↥X) } →₀ ℤ) //
      (∀ x, 0 ≤ E' x) ∧
      QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) E' =
        QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) D }

def WeilCurveDivisorAndAffineChartHolds (k : Type u) [Field k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left] : Prop :=
  let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
  let K := ↑C.left.functionField
  ∃ (k_to_K : k →+* K) (div_fn : Additive (Units K) →+ (Pt →₀ ℤ)),
    div_fn.range = weilCurvePrincipalSubgroup C.left ∧
    (∀ (u₁ u₂ : Units K) (h : (u₁ : K) + (u₂ : K) ≠ 0) (x : Pt),
      min (div_fn (Additive.ofMul u₁) x) (div_fn (Additive.ofMul u₂) x) ≤
        div_fn (Additive.ofMul (Units.mk0 ((u₁ : K) + (u₂ : K)) h)) x) ∧
    (∀ (c : Units k),
      div_fn (Additive.ofMul (Units.map k_to_K.toMonoidHom c)) = 0) ∧
    (∀ x : Pt,
      let Rx := ↑(C.left.presheaf.stalk x.1)
      let mx := IsLocalRing.maximalIdeal Rx
      IsDiscreteValuationRing Rx ∧
      (∀ u : Units K,
        (0 ≤ div_fn (Additive.ofMul u) x ↔ ∃ r : Rx, algebraMap Rx K r = (u : K)) ∧
        (1 ≤ div_fn (Additive.ofMul u) x ↔ ∃ r ∈ mx, algebraMap Rx K r = (u : K)))) ∧
    (∀ D : Pt →₀ ℤ,
      weilCurveEffSubsingleton C.left D ↔
        ∀ u₁ u₂ : Units K,
          (∀ x : Pt, 0 ≤ div_fn (Additive.ofMul u₁) x + D x) →
          (∀ x : Pt, 0 ≤ div_fn (Additive.ofMul u₂) x + D x) →
          ∃ c : k, (u₁ : K) = k_to_K c * (u₂ : K)) ∧
    (∀ S_pts : Finset Pt,
      ∃ (U₀ : C.left.Opens) (_ : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}))
        (t : ↑(C.left.presheaf.obj (Opposite.op U₀))),
        AlgebraicGeometry.IsAffineOpen U₀ ∧
        (∀ x ∈ S_pts, x.1 ∈ U₀) ∧
        (let B₀ := ↑(C.left.presheaf.obj (Opposite.op U₀))
         let φ_k : k →+* B₀ :=
           (CategoryTheory.CategoryStruct.comp
             (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
             (CategoryTheory.CategoryStruct.comp
               (CategoryTheory.CategoryStruct.comp U₀.ι C.hom).appTop
               (U₀.topIso).hom)).hom
         (C.left.germToFunctionField U₀).hom.comp φ_k = k_to_K ∧
         (∃ ht : (C.left.germToFunctionField U₀).hom t ≠ 0,
           ∀ x : Pt, x.1 ∉ U₀ →
             div_fn (Additive.ofMul (Units.mk0 _ ht)) x < 0) ∧
         (∃ (n : ℕ) (b : Fin n → B₀),
           1 ≤ n ∧
           Function.Bijective (fun c : Fin n → Polynomial k =>
             Finset.univ.sum fun i : Fin n => Polynomial.eval₂RingHom φ_k t (c i) * b i)) ∧
         (∀ x : Pt, x.1 ∈ U₀ →
           ∃ (g_x z_x : B₀),
             x.1 ∈ C.left.basicOpen g_x ∧
             (Polynomial.eval₂RingHom
               ((algebraMap B₀ (Localization.Away g_x)).comp φ_k)
               (algebraMap B₀ (Localization.Away g_x) z_x)).Etale) ∧
         (∀ K_pos : ℕ,
           ∃ (N_V : ℕ) (v_bas : Fin N_V → B₀),
             1 ≤ N_V ∧
             Function.Injective (fun coeff : Fin N_V → k =>
               Finset.univ.sum fun i : Fin N_V => φ_k (coeff i) * v_bas i) ∧
             ∀ F : B₀,
               (∃ coeff : Fin N_V → k,
                 F = Finset.univ.sum fun i : Fin N_V => φ_k (coeff i) * v_bas i) ↔
               (∀ (x : Pt) (hF : (C.left.germToFunctionField U₀).hom F ≠ 0)
                  (ht : (C.left.germToFunctionField U₀).hom t ≠ 0),
                 x.1 ∉ U₀ →
                 (K_pos : ℤ) * div_fn (Additive.ofMul (Units.mk0 _ ht)) x ≤
                   div_fn (Additive.ofMul (Units.mk0 _ hF)) x))))
def WeilAltCdStalkZeroAt (S : AlgebraicGeometry.Scheme.{u})
    (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (x : ↥S) : Prop :=
  let Ω := AlgebraicClosure ↥(S.residueField x)
  let gx : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S :=
    CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω)))
      (S.fromSpecResidueField x)
  ∀ (U : S.Etale)
    (u : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω))
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left),
    CategoryTheory.CategoryStruct.comp u
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).hom = gx →
    ∀ s : ↥(ℱ.obj.obj (Opposite.op U)),
      ∃ (V : S.Etale) (v : Quiver.Hom V U)
        (w : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω))
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj V).left),
        CategoryTheory.CategoryStruct.comp w
          ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left = u ∧
        ℱ.obj.map (Opposite.op v) s = 0

noncomputable def weilAltCdHigherDirectImage {X S : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom X S) (q : ℕ)
    (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) :
    CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
  let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor S.Etale X.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
  (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
    (CategoryTheory.Functor.comp B.op (CategoryTheory.Sheaf.cohomologyPresheaf G q))
def WeilTopDegFiniteFreePushforward (k : Type u) [Field k] (n δ q : ℕ) (ζ : kˣ)
    (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f : Quiver.Hom Y₁.left Y₂.left)
    (f_shriek : weilEtaleTorsionH Y₁.left n q →+ weilEtaleTorsionH Y₂.left n q) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor Y₂.left.Etale Y₁.left.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
  let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget Y₁.left
  let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget Y₂.left
  let J₁ := Y₁.left.smallEtaleTopology
  let J₂ := Y₂.left.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  ∃ (_ : B.IsContinuous J₂ J₁),
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    ∃ (P_pull : CategoryTheory.Functor
          (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u})
          (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}))
      (adj_pull : CategoryTheory.Adjunction P_pull P_push)
      (_ : P_pull.Additive)
      (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
      (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
      (T₁ : Y₁.left.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (T₂ : Y₂.left.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (ιℤ : Quiver.Hom (C₁.obj Aℤ) (P_pull.obj (C₂.obj Aℤ))),
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
      let πℤ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
        (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
          ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
            (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
              ((C₁.obj Aℤ).obj.map (Opposite.op τ))))
      let εM : Quiver.Hom (P_pull.obj (P_push.obj (C₁.obj AM))) (C₁.obj AM) :=
        adj_pull.counit.app (C₁.obj AM)
      let leray : CategoryTheory.Abelian.Ext (C₂.obj Aℤ) (P_push.obj (C₁.obj AM)) q →
          weilEtaleTorsionH Y₁.left n q :=
        fun α => (CategoryTheory.Abelian.Ext.mk₀ εM).postcomp (C₁.obj Aℤ) (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull _ _ _ _ _
              (C₂.obj Aℤ) (P_push.obj (C₁.obj AM)) q) α)
            (Nat.zero_add q))
      let kMap₁ : ∀ U : Y₁.left.Etale,
          k →+* ↑(((Fgt₁.obj U).left).presheaf.obj (Opposite.op ⊤)) :=
        fun U => CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appTop
              (CategoryTheory.CategoryStruct.comp (Fgt₁.obj U).hom Y₁.hom)))
      let kMap₂ : ∀ U : Y₂.left.Etale,
          k →+* ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) :=
        fun U => CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appTop
              (CategoryTheory.CategoryStruct.comp (Fgt₂.obj U).hom Y₂.hom)))
      CategoryTheory.CategoryStruct.comp ιℤ πℤ =
        CategoryTheory.CategoryStruct.id (C₁.obj Aℤ) ∧
      CategoryTheory.CategoryStruct.comp πℤ ιℤ =
        CategoryTheory.CategoryStruct.id (P_pull.obj (C₂.obj Aℤ)) ∧
      Function.Bijective leray ∧
      ∃ (ι₁ : ∀ U : Y₁.left.Etale,
            ↑((C₁.obj AM).obj.obj (Opposite.op U)) →
              ↑(((Fgt₁.obj U).left).presheaf.obj (Opposite.op ⊤)))
        (ι₂ : ∀ U : Y₂.left.Etale,
            ↑((C₂.obj AM).obj.obj (Opposite.op U)) →
              ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)))
        (τM : Quiver.Hom (P_push.obj (C₁.obj AM)) (C₂.obj AM)),
        (∀ U : Y₁.left.Etale, Function.Injective (ι₁ U)) ∧
        (∀ U : Y₂.left.Etale, Function.Injective (ι₂ U)) ∧
        (∀ {U' U : Y₁.left.Etale} (u : Quiver.Hom U' U)
            (s : ↑((C₁.obj AM).obj.obj (Opposite.op U))),
          ι₁ U' (((C₁.obj AM).obj.map (Opposite.op u)) s) =
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt₁.map u).left))
              (ι₁ U s)) ∧
        (∀ {U' U : Y₂.left.Etale} (u : Quiver.Hom U' U)
            (s : ↑((C₂.obj AM).obj.obj (Opposite.op U))),
          ι₂ U' (((C₂.obj AM).obj.map (Opposite.op u)) s) =
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt₂.map u).left))
              (ι₂ U s)) ∧
        (∀ a : ZMod n,
          ι₁ T₁ ((adj₁.unit.app AM) (ULift.up a)) = (kMap₁ T₁ ((ζ : kˣ) : k)) ^ a.val) ∧
        (∀ a : ZMod n,
          ι₂ T₂ ((adj₂.unit.app AM) (ULift.up a)) = (kMap₂ T₂ ((ζ : kˣ) : k)) ^ a.val) ∧
        (∀ (U : Y₂.left.Etale)
            (M : Type u) (_ : AddCommGroup M)
            (_ : Module ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
            (bM : Module.Basis (Fin δ)
              ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
            (e : M ≃+ ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))),
          (∀ (r₀ : ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))) (m : M),
            e (r₀ • m) =
              @Mul.mul ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)) _
                (CommRingCat.Hom.hom
                  (AlgebraicGeometry.Scheme.Hom.appTop
                    (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f)) r₀)
                (e m)) →
          ∀ (σ : ↑((C₁.obj AM).obj.obj (Opposite.op (B.obj U))))
            (L : M →ₗ[↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))] M),
            (∀ m : M, e (L m) = ι₁ (B.obj U) σ * e m) →
            ι₂ U ((τM.hom.app (Opposite.op U)) σ) =
              ((LinearMap.toMatrix bM bM) L).det) ∧
        (∀ (u : weilEtaleTorsionH Y₁.left n q)
            (α : CategoryTheory.Abelian.Ext (C₂.obj Aℤ) (P_push.obj (C₁.obj AM)) q),
          leray α = u →
          f_shriek u = (CategoryTheory.Abelian.Ext.mk₀ τM).postcomp (C₂.obj Aℤ) (Nat.add_zero q) α)
