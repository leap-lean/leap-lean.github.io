structure WeilAlgClosedProjectiveLefschetzPencil (F : Type u) [Field F] (m : ℕ)
    (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))) where
  toPencil : WeilRationalLefschetzPencil F m Z₁
  hProj_B₀ : IsProjectiveOverField F toPencil.B₀
  hProj_Y₂ : IsProjectiveOverField F toPencil.Y₂
  hInt_Ztilde : AlgebraicGeometry.IsIntegral toPencil.Z_tilde.left
  hInt_Y₂ : AlgebraicGeometry.IsIntegral toPencil.Y₂.left
  hInt_Zu₀ : AlgebraicGeometry.IsIntegral toPencil.Z_u₀.left
  hInt_H₀ : AlgebraicGeometry.IsIntegral toPencil.H₀.left
  hSing_proj_atlas :
    AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) toPencil.f₀.left ∨
    ∃ (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
          (weilProjectiveSpaceOver F 1).left)
      (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
      (S_aff : Finset F)
      (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
      (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
      (ι_disc : C_disc ⟶ weilProjectiveSpaceOver F 2)
      (U_disc_reg : C_disc.left.Opens)
      (r_chart : ℕ)
      (R'_2d B'_2d : Fin r_chart → CommRingCat.{u})
      (e_B2d : ∀ α : Fin r_chart, AlgebraicGeometry.Spec (R'_2d α) ⟶ (weilProjectiveSpaceOver F 2).left)
      (h_2d : ∀ α : Fin r_chart, R'_2d α)
      (ψ_B2d : ∀ α : Fin r_chart, MvPolynomial (Fin 2) F →+* R'_2d α)
      (e_Y2d : ∀ α : Fin r_chart, AlgebraicGeometry.Spec (B'_2d α) ⟶ toPencil.Y₂.left)
      (q_2d : ∀ α : Fin r_chart, AlgebraicGeometry.Spec (B'_2d α) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin (m + 1) × Fin 2) (R'_2d α) ⧸ Ideal.span
            {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
              MvPolynomial.C (h_2d α)}))),
      AlgebraicGeometry.IsOpenImmersion j_aff ∧
      j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      s_inf ≫ (weilProjectiveSpaceOver F 1).hom = 𝟙 _ ∧
      (Set.range j_aff.base)ᶜ = Set.range s_inf.base ∧
      (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
        j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
          ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal } ∧
      Set.range toPencil.u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (toPencil.f₀.left ∣_ U₀) ∧
      AlgebraicGeometry.IsIntegral C_disc.left ∧
      AlgebraicGeometry.GeometricallyIrreducible C_disc.hom ∧
      AlgebraicGeometry.IsProper C_disc.hom ∧
      AlgebraicGeometry.IsClosedImmersion ι_disc.left ∧
      Nonempty U_disc_reg ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_disc_reg.ι ≫ C_disc.hom) ∧
      (∃ U₂_sm : (weilProjectiveSpaceOver F 2).left.Opens,
        (U₂_sm : Set (weilProjectiveSpaceOver F 2).left) = (Set.range ι_disc.left.base)ᶜ ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (toPencil.g₂.left ∣_ U₂_sm)) ∧
      toPencil.ι_line.left.base ⁻¹' (Set.range ι_disc.left.base) = (U₀ : Set _)ᶜ ∧
      toPencil.ι_line.left.base '' ((U₀ : Set _)ᶜ) ⊆
        ι_disc.left.base '' (U_disc_reg : Set C_disc.left) ∧
      (∃ (x_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ toPencil.Z_tilde.left)
         (R'_inf B'_inf : CommRingCat.{u})
         (u_inf : AlgebraicGeometry.Spec R'_inf)
         (e_B_inf : AlgebraicGeometry.Spec R'_inf ⟶ (weilProjectiveSpaceOver F 1).left)
         (h_inf : R'_inf) (ψ_B_inf : Polynomial F →+* R'_inf)
         (v_inf : AlgebraicGeometry.Spec B'_inf)
         (e_Y_inf : AlgebraicGeometry.Spec B'_inf ⟶ toPencil.Z_tilde.left)
         (q_inf : AlgebraicGeometry.Spec B'_inf ⟶ AlgebraicGeometry.Spec (CommRingCat.of
           (MvPolynomial (Fin (m + 1) × Fin 2) R'_inf ⧸ Ideal.span
             {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
               MvPolynomial.C h_inf}))),
        x_inf ≫ toPencil.f₀.left = s_inf ∧
        (∀ z : toPencil.Z_tilde.left, toPencil.f₀.left.base z ∈ Set.range s_inf.base →
          z ∉ Set.range x_inf.base →
            ∃ V : toPencil.Z_tilde.left.Opens, z ∈ V ∧
              AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ toPencil.f₀.left)) ∧
        AlgebraicGeometry.Etale e_B_inf ∧ AlgebraicGeometry.Etale e_Y_inf ∧
        AlgebraicGeometry.Etale q_inf ∧
        ψ_B_inf Polynomial.X = h_inf ∧
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B_inf)) ∧
        e_B_inf ≫ (weilProjectiveSpaceOver F 1).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B_inf) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
        h_inf ∈ u_inf.asIdeal ∧
        (∀ idx : Fin (m + 1) × Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q_inf.base v_inf).asIdeal) ∧
        Ideal.Quotient.mk _ (MvPolynomial.C h_inf) ∈ (q_inf.base v_inf).asIdeal ∧
        e_Y_inf ≫ toPencil.f₀.left =
          q_inf ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_B_inf ∧
        (∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
          e_B_inf.base u_inf = s_inf.base pt ∧ e_Y_inf.base v_inf = x_inf.base pt)) ∧
      (∀ a ∈ S_aff,
        let s_a : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a)) ≫ j_aff
        ∃ (x_a : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ toPencil.Z_tilde.left)
          (R'_a B'_a : CommRingCat.{u})
          (u_a : AlgebraicGeometry.Spec R'_a)
          (e_B_a : AlgebraicGeometry.Spec R'_a ⟶ (weilProjectiveSpaceOver F 1).left)
          (h_a : R'_a) (ψ_B_a : Polynomial F →+* R'_a)
          (v_a : AlgebraicGeometry.Spec B'_a)
          (e_Y_a : AlgebraicGeometry.Spec B'_a ⟶ toPencil.Z_tilde.left)
          (q_a : AlgebraicGeometry.Spec B'_a ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin (m + 1) × Fin 2) R'_a ⧸ Ideal.span
              {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
                MvPolynomial.C h_a}))),
          x_a ≫ toPencil.f₀.left = s_a ∧
          (∀ z : toPencil.Z_tilde.left, toPencil.f₀.left.base z ∈ Set.range s_a.base →
            z ∉ Set.range x_a.base →
              ∃ V : toPencil.Z_tilde.left.Opens, z ∈ V ∧
                AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ toPencil.f₀.left)) ∧
          AlgebraicGeometry.Etale e_B_a ∧ AlgebraicGeometry.Etale e_Y_a ∧
          AlgebraicGeometry.Etale q_a ∧
          ψ_B_a Polynomial.X = h_a ∧
          AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B_a)) ∧
          e_B_a ≫ (weilProjectiveSpaceOver F 1).hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B_a) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
          h_a ∈ u_a.asIdeal ∧
          (∀ idx : Fin (m + 1) × Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q_a.base v_a).asIdeal) ∧
          Ideal.Quotient.mk _ (MvPolynomial.C h_a) ∈ (q_a.base v_a).asIdeal ∧
          e_Y_a ≫ toPencil.f₀.left =
            q_a ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_B_a ∧
          (∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
            e_B_a.base u_a = s_a.base pt ∧ e_Y_a.base v_a = x_a.base pt)) ∧
      (∀ α : Fin r_chart,
        AlgebraicGeometry.Etale (e_B2d α) ∧
        AlgebraicGeometry.Etale (e_Y2d α) ∧
        AlgebraicGeometry.Etale (q_2d α) ∧
        ψ_B2d α (MvPolynomial.X 0) = h_2d α ∧
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_B2d α))) ∧
        e_B2d α ≫ (weilProjectiveSpaceOver F 2).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_B2d α)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ∧
        (e_B2d α).base ⁻¹' (Set.range ι_disc.left.base) =
          { u : AlgebraicGeometry.Spec (R'_2d α) | h_2d α ∈ u.asIdeal } ∧
        e_Y2d α ≫ toPencil.g₂.left =
          q_2d α ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_B2d α) ∧
      (∀ c ∈ U_disc_reg, ∃ y_c : toPencil.Y₂.left,
        toPencil.g₂.left.base y_c = ι_disc.left.base c ∧
        (∀ y' : toPencil.Y₂.left, toPencil.g₂.left.base y' = ι_disc.left.base c → y' ≠ y_c →
          ∃ V : toPencil.Y₂.left.Opens, y' ∈ V ∧
            AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ toPencil.g₂.left)) ∧
        ∃ (α : Fin r_chart) (u_pt : AlgebraicGeometry.Spec (R'_2d α))
          (v_pt : AlgebraicGeometry.Spec (B'_2d α)),
          (e_B2d α).base u_pt = ι_disc.left.base c ∧
          (e_Y2d α).base v_pt = y_c ∧
          (∀ idx : Fin (m + 1) × Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ ((q_2d α).base v_pt).asIdeal) ∧
          Ideal.Quotient.mk _ (MvPolynomial.C (h_2d α)) ∈ ((q_2d α).base v_pt).asIdeal)
def WeilCupPDHasVerdierDualSheafRep (S : AlgebraicGeometry.Scheme.{u}) (n : ℕ) : Prop :=
  let R := ULift.{u, 0} (ZMod n)
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  ∀ (C : CategoryTheory.Functor 𝒞 (ModuleCat.{u, u} R)),
    CategoryTheory.Limits.PreservesFiniteLimits C →
    CategoryTheory.Limits.PreservesColimitsOfSize.{u, u} C →
    ∃ (𝒥 : 𝒞)
      (Ψ : ∀ F : 𝒞, (↑(C.obj F) →ₗ[R] R) ≃ Quiver.Hom F 𝒥),
      CategoryTheory.Injective 𝒥 ∧
      (∀ (F : 𝒞) (ψ₁ ψ₂ : ↑(C.obj F) →ₗ[R] R),
        Ψ F (ψ₁ + ψ₂) = Ψ F ψ₁ + Ψ F ψ₂) ∧
      (∀ {F₁ F₂ : 𝒞} (f : Quiver.Hom F₁ F₂) (ψ : ↑(C.obj F₂) →ₗ[R] R),
        CategoryTheory.CategoryStruct.comp f (Ψ F₂ ψ) =
          Ψ F₁ (ψ.comp (C.map f).hom))

def WeilCupPDHasVerdierDualExtPackage (S : AlgebraicGeometry.Scheme.{u}) (d n : ℕ)
    (τ : weilCupPDModH S n (2 * d) →+ ZMod n) : Prop :=
  let R := ULift.{u, 0} (ZMod n)
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  let oneR := weilCupPDModUnit S n
  (∀ (F : 𝒞) (φ : CategoryTheory.Abelian.Ext.{u} oneR F (2 * d) →+ ZMod n),
    ∃! f : CategoryTheory.Abelian.Ext.{u} F oneR 0,
      ∀ α : CategoryTheory.Abelian.Ext.{u} oneR F (2 * d),
        τ (α.comp f (Nat.add_zero (2 * d))) = φ α) ∧
  (∀ (A : 𝒞),
    (∀ k : ℕ, 1 ≤ k → Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR A k)) →
    ∀ q : ℕ, q < 2 * d → Subsingleton (CategoryTheory.Abelian.Ext.{u} A oneR q)) ∧
  (∃ E_top : ∀ G : 𝒞,
      (CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod n) ≃+
        CategoryTheory.Abelian.Ext.{u} G oneR (2 * d),
    ∀ (G : 𝒞) (φ : CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod n)
      (α : CategoryTheory.Abelian.Ext.{u} oneR G 0),
      α.comp (E_top G φ) (Nat.zero_add (2 * d)) =
        E_top oneR (φ.comp (α.postcomp oneR (Nat.add_zero 0))))
def WeilEtaleTrianglePullbackMapsTo {Y₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
    (π₁ : Quiver.Hom Y₁ Y₀) (π₂ : Quiver.Hom Y₂ Y₀) (h : Quiver.Hom Y₁ Y₂)
    (h_eq : CategoryTheory.CategoryStruct.comp h π₂ = π₁)
    (F₀ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ)
    [(weilEtaleSitePullback π₁).IsContinuous Y₀.smallEtaleTopology Y₁.smallEtaleTopology]
    [(weilEtaleSitePullback π₂).IsContinuous Y₀.smallEtaleTopology Y₂.smallEtaleTopology]
    [((weilEtaleSitePullback π₁).sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₀.smallEtaleTopology Y₁.smallEtaleTopology).IsRightAdjoint]
    [((weilEtaleSitePullback π₂).sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₀.smallEtaleTopology Y₂.smallEtaleTopology).IsRightAdjoint]
    (x₂ : (((weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u}
      Y₀.smallEtaleTopology Y₂.smallEtaleTopology).obj F₀).H q)
    (x₁ : (((weilEtaleSitePullback π₁).sheafPullback AddCommGrpCat.{u}
      Y₀.smallEtaleTopology Y₁.smallEtaleTopology).obj F₀).H q) : Prop :=
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B₁ : CategoryTheory.Functor Y₀.Etale Y₁.Etale := weilEtaleSitePullback π₁
  let B₂ : CategoryTheory.Functor Y₀.Etale Y₂.Etale := weilEtaleSitePullback π₂
  let B_h : CategoryTheory.Functor Y₂.Etale Y₁.Etale := weilEtaleSitePullback h
  ∃ (_ : B_h.IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology),
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    ∃ (_ : pf_h.IsRightAdjoint),
      let pb₁ := B₁.sheafPullback AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₁.smallEtaleTopology
      let pb₂ := B₂.sheafPullback AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₂.smallEtaleTopology
      let pb_h := B_h.sheafPullback AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
      let adj₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₁.smallEtaleTopology
      let adj₂ := B₂.sheafAdjunctionContinuous AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₂.smallEtaleTopology
      let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
      ∃ (_ : pb_h.Additive)
        (_ : CategoryTheory.Limits.PreservesFiniteLimits pb_h)
        (_ : CategoryTheory.Limits.PreservesFiniteColimits pb_h),
        let e_B : CategoryTheory.Iso B₁ (CategoryTheory.Functor.comp B₂ B_h) :=
          CategoryTheory.Iso.trans
            (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm)
            (CategoryTheory.MorphismProperty.Over.pullbackComp h π₂)
        letI : (CategoryTheory.Functor.comp B₂ B_h).IsContinuous Y₀.smallEtaleTopology Y₁.smallEtaleTopology :=
          CategoryTheory.Functor.isContinuous_comp B₂ B_h
            Y₀.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology
        let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_B
          AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₁.smallEtaleTopology
        let β : Quiver.Hom (pb_h.obj (pb₂.obj F₀)) (pb₁.obj F₀) :=
          (adj_h.homEquiv (pb₂.obj F₀) (pb₁.obj F₀)).symm
            ((adj₂.homEquiv F₀ (pf_h.obj (pb₁.obj F₀))).symm
              (CategoryTheory.CategoryStruct.comp
                (adj₁.unit.app F₀)
                (e_pf.hom.app (pb₁.obj F₀))))
        let Pℤ₂ := (CategoryTheory.Functor.const (Opposite Y₂.Etale)).obj (AddCommGrpCat.of (ULift.{u} ℤ))
        let Pℤ₁ := (CategoryTheory.Functor.const (Opposite Y₁.Etale)).obj (AddCommGrpCat.of (ULift.{u} ℤ))
        let Fℤ₂ := (CategoryTheory.constantSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        let Fℤ₁ := (CategoryTheory.constantSheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        let η₁ := CategoryTheory.Functor.whiskerLeft B_h.op
          ((CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ₁)
        let uℤ := ((CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
          Pℤ₂ (pf_h.obj Fℤ₁)).symm η₁
        let cℤ := (adj_h.homEquiv Fℤ₂ Fℤ₁).symm uℤ
        ∃ (hcℤ : CategoryTheory.IsIso cℤ),
          let inv_cℤ := @CategoryTheory.inv _ _ _ _ cℤ hcℤ
          (CategoryTheory.Abelian.Ext.mk₀ β).postcomp Fℤ₁ (Nat.add_zero q)
            ((CategoryTheory.Abelian.Ext.mk₀ inv_cℤ).precomp (pb_h.obj (pb₂.obj F₀)) (Nat.zero_add q)
              ((pb_h.mapExtAddHom Fℤ₂ (pb₂.obj F₀) q) x₂)) = x₁

def WeilFilteredRingColimitCohomologyHolds (k : Type u) [Field k] : Prop :=
  ∃ (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology),
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
    let pf_of : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}}, Quiver.Hom Z₁ Z₂ →
        CategoryTheory.Functor (CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u})
          (CategoryTheory.Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u}) :=
      fun {Z₁ Z₂} f => (weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    ∃ (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂), (pf_of f).IsRightAdjoint),
      letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂), (pf_of f).IsRightAdjoint := @hr_all
      let pb_of : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}}, Quiver.Hom Z₁ Z₂ →
          CategoryTheory.Functor (CategoryTheory.Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u})
            (CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}) :=
        fun {Z₁ Z₂} f => (weilEtaleSitePullback f).sheafPullback AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      ∀ (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
        (D₀ : Type u) [CommRing D₀] [Algebra k D₀]
        (D : CategoryTheory.Functor ℐ CommRingCat.{u})
        (α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of D₀)) D)
        (c : CategoryTheory.Limits.Cocone D) (_ : CategoryTheory.Limits.IsColimit c)
        (f_inf : Quiver.Hom (CommRingCat.of D₀) c.pt),
        (∀ i : ℐ, CategoryTheory.CategoryStruct.comp (α.app i) (c.ι.app i) = f_inf) →
        let Z₀ := AlgebraicGeometry.Spec (CommRingCat.of D₀)
        let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k D₀))
        let P₁ := weilProjectiveSpaceOver k 1
        let X₀ := CategoryTheory.Limits.pullback s₀ P₁.hom
        let p₁₀ := CategoryTheory.Limits.pullback.fst s₀ P₁.hom
        let p_i : ∀ i : ℐ, Quiver.Hom (AlgebraicGeometry.Spec (D.obj i)) Z₀ :=
          fun i => AlgebraicGeometry.Spec.map (α.app i)
        let p_inf : Quiver.Hom (AlgebraicGeometry.Spec c.pt) Z₀ :=
          AlgebraicGeometry.Spec.map f_inf
        let u_i : ∀ i : ℐ, Quiver.Hom (AlgebraicGeometry.Spec c.pt) (AlgebraicGeometry.Spec (D.obj i)) :=
          fun i => AlgebraicGeometry.Spec.map (c.ι.app i)
        (∀ (G : CategoryTheory.Sheaf Z₀.smallEtaleTopology AddCommGrpCat.{u}),
          (∀ (s_inf : ((pb_of p_inf).obj G).H 0),
            ∃ (i : ℐ) (hu : CategoryTheory.CategoryStruct.comp (u_i i) (p_i i) = p_inf)
              (s_i : ((pb_of (p_i i)).obj G).H 0),
              WeilEtaleTrianglePullbackMapsTo p_inf (p_i i) (u_i i) hu G 0 s_i s_inf) ∧
          (∀ (i : ℐ) (hu : CategoryTheory.CategoryStruct.comp (u_i i) (p_i i) = p_inf)
            (s_i : ((pb_of (p_i i)).obj G).H 0),
            WeilEtaleTrianglePullbackMapsTo p_inf (p_i i) (u_i i) hu G 0 s_i 0 →
            ∃ (j : ℐ) (θ : Quiver.Hom i j)
              (hθ : CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Spec.map (D.map θ)) (p_i i) = p_i j),
              WeilEtaleTrianglePullbackMapsTo (p_i j) (p_i i) (AlgebraicGeometry.Spec.map (D.map θ)) hθ G 0 s_i 0)) ∧
        (∀ (F₀ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ)
          (X_inf : AlgebraicGeometry.Scheme.{u})
          (f_infX : Quiver.Hom X_inf (AlgebraicGeometry.Spec c.pt))
          (π_inf : Quiver.Hom X_inf X₀)
          (_ : CategoryTheory.IsPullback f_infX π_inf p_inf p₁₀)
          (X_lvl : ℐ → AlgebraicGeometry.Scheme.{u})
          (f_lvl : ∀ i : ℐ, Quiver.Hom (X_lvl i) (AlgebraicGeometry.Spec (D.obj i)))
          (π_lvl : ∀ i : ℐ, Quiver.Hom (X_lvl i) X₀)
          (_ : ∀ i : ℐ, CategoryTheory.IsPullback (f_lvl i) (π_lvl i) (p_i i) p₁₀)
          (uX : ∀ i : ℐ, Quiver.Hom X_inf (X_lvl i))
          (_ : ∀ i : ℐ, CategoryTheory.CategoryStruct.comp (uX i) (f_lvl i) =
            CategoryTheory.CategoryStruct.comp f_infX (u_i i))
          (huX : ∀ i : ℐ, CategoryTheory.CategoryStruct.comp (uX i) (π_lvl i) = π_inf)
          (vX : ∀ {i j : ℐ}, Quiver.Hom i j → Quiver.Hom (X_lvl j) (X_lvl i))
          (_ : ∀ {i j : ℐ} (θ : Quiver.Hom i j),
            CategoryTheory.CategoryStruct.comp (vX θ) (f_lvl i) =
              CategoryTheory.CategoryStruct.comp (f_lvl j) (AlgebraicGeometry.Spec.map (D.map θ)))
          (hvX : ∀ {i j : ℐ} (θ : Quiver.Hom i j),
            CategoryTheory.CategoryStruct.comp (vX θ) (π_lvl i) = π_lvl j),
          (∀ (x_inf : ((pb_of π_inf).obj F₀).H q),
            ∃ (i : ℐ) (x_i : ((pb_of (π_lvl i)).obj F₀).H q),
              WeilEtaleTrianglePullbackMapsTo π_inf (π_lvl i) (uX i) (huX i) F₀ q x_i x_inf) ∧
          (∀ (i : ℐ) (x_i : ((pb_of (π_lvl i)).obj F₀).H q),
            WeilEtaleTrianglePullbackMapsTo π_inf (π_lvl i) (uX i) (huX i) F₀ q x_i 0 →
            ∃ (j : ℐ) (θ : Quiver.Hom i j),
              WeilEtaleTrianglePullbackMapsTo (π_lvl j) (π_lvl i) (vX θ) (hvX θ) F₀ q x_i 0))

def WeilPointedEtaleStrictLocalBridgeHolds (k : Type u) [Field k] (ℓ : ℕ) : Prop :=
  ∀ (R₀ : Type u) [CommRing R₀] [Algebra k R₀] [Algebra.FiniteType k R₀]
    (E : Type u) [CommRing E] [Algebra k E] [Algebra.FiniteType k E]
    (ψ₀ : R₀ →ₐ[k] E) (τ_E : E →ₐ[k] k),
    ∃ (ℐ₀ : Type u) (_ : CategoryTheory.SmallCategory ℐ₀) (_ : CategoryTheory.IsFiltered ℐ₀)
      (D₀ : CategoryTheory.Functor ℐ₀ CommRingCat.{u})
      (α₀ : Quiver.Hom ((CategoryTheory.Functor.const ℐ₀).obj (CommRingCat.of R₀)) D₀)
      (A₀ : Type u) (_ : CommRing A₀) (_ : Algebra k A₀)
      (f_A₀ : R₀ →ₐ[k] A₀) (τ₀ : A₀ →ₐ[k] k)
      (c₀ : CategoryTheory.Limits.Cocone D₀) (_ : CategoryTheory.Limits.IsColimit c₀)
      (e_pt₀ : CategoryTheory.Iso c₀.pt (CommRingCat.of A₀))
      (τ_lvl₀ : ∀ i : ℐ₀, ↑(D₀.obj i) →+* k)
      (ℐ₁ : Type u) (_ : CategoryTheory.SmallCategory ℐ₁) (_ : CategoryTheory.IsFiltered ℐ₁)
      (D₁ : CategoryTheory.Functor ℐ₁ CommRingCat.{u})
      (α₁ : Quiver.Hom ((CategoryTheory.Functor.const ℐ₁).obj (CommRingCat.of E)) D₁)
      (A₁ : Type u) (_ : CommRing A₁) (_ : Algebra k A₁)
      (f_A₁ : E →ₐ[k] A₁) (τ₁ : A₁ →ₐ[k] k)
      (c₁ : CategoryTheory.Limits.Cocone D₁) (_ : CategoryTheory.Limits.IsColimit c₁)
      (e_pt₁ : CategoryTheory.Iso c₁.pt (CommRingCat.of A₁))
      (τ_lvl₁ : ∀ j : ℐ₁, ↑(D₁.obj j) →+* k)
      (ψ_A : A₀ →ₐ[k] A₁),
      (∀ i : ℐ₀, RingHom.Etale (CommRingCat.Hom.hom (α₀.app i))) ∧
      (∀ i : ℐ₀, CategoryTheory.CategoryStruct.comp (α₀.app i)
        (CategoryTheory.CategoryStruct.comp (c₀.ι.app i) e_pt₀.hom) = CommRingCat.ofHom f_A₀.toRingHom) ∧
      (∀ (i : ℐ₀) (x : ↑(D₀.obj i)),
        τ₀ (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c₀.ι.app i) e_pt₀.hom) x) = τ_lvl₀ i x) ∧
      (τ₀.comp f_A₀ = τ_E.comp ψ₀) ∧
      WeilIsStrictLocalNoetherianAlgClosedRing k A₀ τ₀ ∧
      (∀ j : ℐ₁, RingHom.Etale (CommRingCat.Hom.hom (α₁.app j))) ∧
      (∀ j : ℐ₁, CategoryTheory.CategoryStruct.comp (α₁.app j)
        (CategoryTheory.CategoryStruct.comp (c₁.ι.app j) e_pt₁.hom) = CommRingCat.ofHom f_A₁.toRingHom) ∧
      (∀ (j : ℐ₁) (x : ↑(D₁.obj j)),
        τ₁ (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c₁.ι.app j) e_pt₁.hom) x) = τ_lvl₁ j x) ∧
      (τ₁.comp f_A₁ = τ_E) ∧
      WeilIsStrictLocalNoetherianAlgClosedRing k A₁ τ₁ ∧
      (τ₁.comp ψ_A = τ₀) ∧
      (ψ_A.comp f_A₀ = f_A₁.comp ψ₀) ∧
      (∀ (g'_A : Quiver.Hom
          (CategoryTheory.Limits.pullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁)))
            (weilProjectiveSpaceOver k 1).hom)
          (CategoryTheory.Limits.pullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)))
            (weilProjectiveSpaceOver k 1).hom)),
        CategoryTheory.CategoryStruct.comp g'_A
          (CategoryTheory.Limits.pullback.fst
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)))
            (weilProjectiveSpaceOver k 1).hom) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Limits.pullback.fst
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁)))
              (weilProjectiveSpaceOver k 1).hom)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_A.toRingHom)) →
        CategoryTheory.CategoryStruct.comp g'_A
          (CategoryTheory.Limits.pullback.snd
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)))
            (weilProjectiveSpaceOver k 1).hom) =
          CategoryTheory.Limits.pullback.snd
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁)))
            (weilProjectiveSpaceOver k 1).hom →
        ∀ (F₀ : CategoryTheory.Sheaf
            (CategoryTheory.Limits.pullback
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)))
              (weilProjectiveSpaceOver k 1).hom).smallEtaleTopology
            AddCommGrpCat.{u}) (q : ℕ),
          ℓ • CategoryTheory.CategoryStruct.id F₀ = 0 →
          WeilEtaleCohomologyPullbackBijective g'_A F₀ q) ∧
      (∀ (M : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of A₀)).smallEtaleTopology
          AddCommGrpCat.{u}),
        WeilEtaleCohomologyPullbackBijective
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_A.toRingHom)) M 0)
def WeilHasVerdierDualSheafRep (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) : Prop :=
  let R := ULift.{u, 0} (ZMod m)
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  ∀ (C : CategoryTheory.Functor 𝒞 (ModuleCat.{u, u} R)),
    CategoryTheory.Limits.PreservesFiniteLimits C →
    CategoryTheory.Limits.PreservesColimitsOfSize.{u, u} C →
    ∃ (𝒥 : 𝒞)
      (Ψ : ∀ F : 𝒞, (↑(C.obj F) →ₗ[R] R) ≃ Quiver.Hom F 𝒥),
      CategoryTheory.Injective 𝒥 ∧
      (∀ (F : 𝒞) (ψ₁ ψ₂ : ↑(C.obj F) →ₗ[R] R),
        Ψ F (ψ₁ + ψ₂) = Ψ F ψ₁ + Ψ F ψ₂) ∧
      (∀ {F₁ F₂ : 𝒞} (f : Quiver.Hom F₁ F₂) (ψ : ↑(C.obj F₂) →ₗ[R] R),
        CategoryTheory.CategoryStruct.comp f (Ψ F₂ ψ) =
          Ψ F₁ (ψ.comp (C.map f).hom))

def WeilHasVerdierDualExtPackage (S : AlgebraicGeometry.Scheme.{u}) (d m : ℕ)
    (τ : weilEtaleModuleH S m (2 * d) →+ ZMod m) : Prop :=
  let R := ULift.{u, 0} (ZMod m)
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  let oneR := weilEtaleModuleUnit S m
  (∀ (F : 𝒞) (φ : CategoryTheory.Abelian.Ext.{u} oneR F (2 * d) →+ ZMod m),
    ∃! f : CategoryTheory.Abelian.Ext.{u} F oneR 0,
      ∀ α : CategoryTheory.Abelian.Ext.{u} oneR F (2 * d),
        τ (α.comp f (Nat.add_zero (2 * d))) = φ α) ∧
  (∀ (A : 𝒞),
    (∀ k : ℕ, 1 ≤ k → Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR A k)) →
    ∀ q : ℕ, q < 2 * d → Subsingleton (CategoryTheory.Abelian.Ext.{u} A oneR q)) ∧
  (∃ E_top : ∀ G : 𝒞,
      (CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod m) ≃+
        CategoryTheory.Abelian.Ext.{u} G oneR (2 * d),
    ∀ (G : 𝒞) (φ : CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod m)
      (α : CategoryTheory.Abelian.Ext.{u} oneR G 0),
      α.comp (E_top G φ) (Nat.zero_add (2 * d)) =
        E_top oneR (φ.comp (α.postcomp oneR (Nat.add_zero 0))))
noncomputable abbrev weilCupPDTraceLocalTorsionSheaf (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    (U : S.Etale) :
    CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
  CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology U
    (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))

noncomputable def weilCupPDTraceLocalTorsionCounit (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    (U : S.Etale) :
    Quiver.Hom (weilCupPDTraceLocalTorsionSheaf S m U) (weilEtaleTorsionSheaf S m) :=
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let J := S.smallEtaleTopology
  CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
    (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
      ((CategoryTheory.Functor.const (Opposite S.Etale)).obj AM)).app
      (Opposite.op U))

noncomputable def weilCupPDTraceLocalTorsionMap (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    {U₁ U₂ : S.Etale} (u : Quiver.Hom U₁ U₂) :
    Quiver.Hom (weilCupPDTraceLocalTorsionSheaf S m U₁)
      (weilCupPDTraceLocalTorsionSheaf S m U₂) :=
  CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
    (CategoryTheory.CategoryStruct.comp
      (CategoryTheory.Sheaf.freeYonedaHomEquiv
        (CategoryTheory.CategoryStruct.id (weilCupPDTraceLocalTorsionSheaf S m U₂)))
      ((weilCupPDTraceLocalTorsionSheaf S m U₂).obj.map (Opposite.op u)))

noncomputable abbrev weilCupPDTraceLocalTorsionH (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    (U : S.Etale) (q : ℕ) : Type u :=
  (weilCupPDTraceLocalTorsionSheaf S m U).H q

noncomputable def weilCupPDTraceLocalTorsionMapH (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    {U₁ U₂ : S.Etale} (u : Quiver.Hom U₁ U₂) (q : ℕ) :
    weilCupPDTraceLocalTorsionH S m U₁ q →+ weilCupPDTraceLocalTorsionH S m U₂ q :=
  (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDTraceLocalTorsionMap S m u)).postcomp
    ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero q)

noncomputable def weilCupPDTraceLocalTorsionCounitH (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    (U : S.Etale) (q : ℕ) :
    weilCupPDTraceLocalTorsionH S m U q →+ weilEtaleTorsionH S m q :=
  (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDTraceLocalTorsionCounit S m U)).postcomp
    ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero q)

def WeilCupPDTraceHasTorsionEffacement (S : AlgebraicGeometry.Scheme.{u}) (d m : ℕ)
    (tr_m : weilEtaleTorsionH S m (2 * d) →+ ZMod m) : Prop :=
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  ∀ (x : ↥S),
    let κ := S.residueField x
    let Ω := AlgebraicClosure ↥κ
    let gx : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
        (S.fromSpecResidueField x)
    ∀ (U : S.Etale) (γ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (Fgt.obj U).left),
      CategoryTheory.CategoryStruct.comp γ (Fgt.obj U).hom = gx →
      ∃ (U' : S.Etale) (v : Quiver.Hom U' U)
        (γ' : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (Fgt.obj U').left),
        CategoryTheory.CategoryStruct.comp γ' (Fgt.obj U').hom = gx ∧
        CategoryTheory.CategoryStruct.comp γ' (Fgt.map v).left = γ ∧
        (∀ (q : ℕ), q < 2 * d → ∀ z : weilCupPDTraceLocalTorsionH S m U' q,
          weilCupPDTraceLocalTorsionMapH S m v q z = 0) ∧
        Function.Bijective (fun z : weilCupPDTraceLocalTorsionH S m U' (2 * d) =>
          tr_m (weilCupPDTraceLocalTorsionCounitH S m U' (2 * d) z))

