    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (W : Y.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
    (ψ_w : MvPolynomial (Fin d) k →+* ↑(Y.left.presheaf.obj (Opposite.op W)))
    (g : MvPolynomial (Fin d) k)
    (Γ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π_Y : Quiver.Hom Γ.left Y.left)
    (π_P : Quiver.Hom Γ.left P_ov.left)
    (U_g : P_ov.left.Opens)
    (iso_Ug : CategoryTheory.Iso U_g.toScheme
      (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g))))
    (j_Γ : Quiver.Hom
      (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g)))) Γ.left)
    (j_Y : Quiver.Hom
      (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g)))) Y.left) : Prop :=
  AlgebraicGeometry.IsProper Γ.hom ∧
  AlgebraicGeometry.IsIntegral Γ.left ∧
  topologicalKrullDim Γ.left = (d : WithBot ℕ∞) ∧
  CategoryTheory.CategoryStruct.comp π_Y Y.hom = Γ.hom ∧
  CategoryTheory.CategoryStruct.comp π_P P_ov.hom = Γ.hom ∧
  CategoryTheory.CategoryStruct.comp iso_Ug.inv U_g.ι =
    CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin d) k) (Localization.Away g))))
      ι_d ∧
  AlgebraicGeometry.IsOpenImmersion j_Γ ∧
  AlgebraicGeometry.IsOpenImmersion j_Y ∧
  j_Y = CategoryTheory.CategoryStruct.comp
    (AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom
        (algebraMap ↑(Y.left.presheaf.obj (Opposite.op W)) (Localization.Away (ψ_w g)))))
    hW.fromSpec ∧
  CategoryTheory.CategoryStruct.comp j_Γ π_Y = j_Y ∧
  CategoryTheory.CategoryStruct.comp j_Γ π_P =
    CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Localization.awayMap ψ_w g)))
      (CategoryTheory.CategoryStruct.comp iso_Ug.inv U_g.ι) ∧
  Set.range j_Γ.base = π_P.base ⁻¹' (U_g : Set ↥P_ov.left)

def WeilTopDegKummerZeroBdrySiteNorm (k : Type u) [Field k] (n : ℕ) (ζ : kˣ)
