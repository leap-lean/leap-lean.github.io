def WeilRingHomIdempotentBijective {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) : Prop :=
  (∀ e₁ e₂ : R, IsIdempotentElem e₁ → IsIdempotentElem e₂ → φ e₁ = φ e₂ → e₁ = e₂) ∧
  (∀ e₀ : S, IsIdempotentElem e₀ → ∃ e : R, IsIdempotentElem e ∧ φ e = e₀)

def WeilIsTwoChartProjLineCoverRings
    (A : Type u) [CommRing A] (𝔪 : Ideal A)
    (B B₀ : Type u) [CommRing B] [Algebra A B] [CommRing B₀] (red₀ : B →+* B₀)
    (M₀ M₁ M₀₁ : Type u)
    [CommRing M₀] [Algebra A M₀] [Algebra (Polynomial A) M₀] [IsScalarTower A (Polynomial A) M₀]
    [Module.Finite (Polynomial A) M₀]
    [CommRing M₁] [Algebra A M₁] [Algebra (Polynomial A) M₁] [IsScalarTower A (Polynomial A) M₁]
    [Module.Finite (Polynomial A) M₁]
    [CommRing M₀₁] [Algebra A M₀₁] : Prop :=
  ∃ (ρ₀ : M₀ →ₐ[A] M₀₁) (ρ₁ : M₁ →ₐ[A] M₀₁)
    (i₀ : B →ₐ[A] M₀) (i₁ : B →ₐ[A] M₁)
    (j₀ : B₀ →+* (M₀ ⧸ Ideal.map (algebraMap A M₀) 𝔪))
    (j₁ : B₀ →+* (M₁ ⧸ Ideal.map (algebraMap A M₁) 𝔪)),
    ρ₀ (algebraMap (Polynomial A) M₀ Polynomial.X) *
      ρ₁ (algebraMap (Polynomial A) M₁ Polynomial.X) = 1 ∧
    (∀ z : M₀₁, ∃ (n : ℕ) (x₀ : M₀),
      (ρ₀ (algebraMap (Polynomial A) M₀ Polynomial.X)) ^ n * z = ρ₀ x₀) ∧
    (∀ x₀ : M₀, ρ₀ x₀ = 0 → ∃ n : ℕ,
      (algebraMap (Polynomial A) M₀ Polynomial.X) ^ n * x₀ = 0) ∧
    (∀ z : M₀₁, ∃ (n : ℕ) (x₁ : M₁),
      (ρ₁ (algebraMap (Polynomial A) M₁ Polynomial.X)) ^ n * z = ρ₁ x₁) ∧
    (∀ x₁ : M₁, ρ₁ x₁ = 0 → ∃ n : ℕ,
      (algebraMap (Polynomial A) M₁ Polynomial.X) ^ n * x₁ = 0) ∧
    (∀ b : B, ρ₀ (i₀ b) = ρ₁ (i₁ b)) ∧
    (∀ b₁ b₂ : B, i₀ b₁ = i₀ b₂ → i₁ b₁ = i₁ b₂ → b₁ = b₂) ∧
    (∀ (x₀ : M₀) (x₁ : M₁), ρ₀ x₀ = ρ₁ x₁ → ∃ b : B, i₀ b = x₀ ∧ i₁ b = x₁) ∧
    (∀ (b₀ : B₀) (x₀ : M₀) (x₁ : M₁),
      Ideal.Quotient.mk (Ideal.map (algebraMap A M₀) 𝔪) x₀ = j₀ b₀ →
      Ideal.Quotient.mk (Ideal.map (algebraMap A M₁) 𝔪) x₁ = j₁ b₀ →
      Ideal.Quotient.mk (Ideal.map (algebraMap A M₀₁) 𝔪) (ρ₀ x₀) =
        Ideal.Quotient.mk (Ideal.map (algebraMap A M₀₁) 𝔪) (ρ₁ x₁)) ∧
    (∀ b₁ b₂ : B₀, j₀ b₁ = j₀ b₂ → j₁ b₁ = j₁ b₂ → b₁ = b₂) ∧
    (∀ (x₀ : M₀) (x₁ : M₁),
      Ideal.Quotient.mk (Ideal.map (algebraMap A M₀₁) 𝔪) (ρ₀ x₀) =
        Ideal.Quotient.mk (Ideal.map (algebraMap A M₀₁) 𝔪) (ρ₁ x₁) →
      ∃ b₀ : B₀,
        j₀ b₀ = Ideal.Quotient.mk (Ideal.map (algebraMap A M₀) 𝔪) x₀ ∧
        j₁ b₀ = Ideal.Quotient.mk (Ideal.map (algebraMap A M₁) 𝔪) x₁) ∧
    (∀ b : B,
      j₀ (red₀ b) = Ideal.Quotient.mk (Ideal.map (algebraMap A M₀) 𝔪) (i₀ b) ∧
      j₁ (red₀ b) = Ideal.Quotient.mk (Ideal.map (algebraMap A M₁) 𝔪) (i₁ b))
def weilAltLocConstPresheaf (S : AlgebraicGeometry.Scheme.{u}) (n : ℕ) :
    CategoryTheory.Functor S.Etaleᵒᵖ AddCommGrpCat.{u} :=
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  { obj := fun U =>
      AddCommGrpCat.of (LocallyConstant ↥(Fgt.obj (Opposite.unop U)).left (ULift.{u} (ZMod n)))
    map := fun {_ _} f =>
      AddCommGrpCat.ofHom
        { toFun := fun g =>
            { toFun := fun x => g ((Fgt.map f.unop).left x)
              isLocallyConstant := fun t =>
                (Fgt.map f.unop).left.continuous.isOpen_preimage _ (g.isLocallyConstant t) }
          map_zero' := LocallyConstant.ext (fun _ => rfl)
          map_add' := fun _ _ => LocallyConstant.ext (fun _ => rfl) }
    map_id := fun _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl))
    map_comp := fun _ _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl)) }

def weilAltZeroBdrySubgroup (S : AlgebraicGeometry.Scheme.{u}) (V : S.Opens) (n : ℕ)
    (U : S.Etale) :
    AddSubgroup
      (LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left
        (ULift.{u} (ZMod n))) where
  carrier := { g | ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left,
    ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).hom x ∉ (V : Set ↥S) → g x = 0 }
  add_mem' := fun {a b} ha hb x hx => (LocallyConstant.add_apply a b x).trans
    ((congrArg₂ (· + ·) (ha x hx) (hb x hx)).trans (add_zero 0))
  zero_mem' := fun _ _ => rfl
  neg_mem' := fun {a} ha x hx => (LocallyConstant.neg_apply a x).trans
    ((congrArg Neg.neg (ha x hx)).trans neg_zero)

def weilAltZeroBdrySubpresheaf (S : AlgebraicGeometry.Scheme.{u}) (V : S.Opens) (n : ℕ) :
    CategoryTheory.Functor S.Etaleᵒᵖ AddCommGrpCat.{u} :=
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  { obj := fun U => AddCommGrpCat.of ↥(weilAltZeroBdrySubgroup S V n (Opposite.unop U))
    map := fun {U₁ U₂} f =>
      AddCommGrpCat.ofHom
        { toFun := fun g =>
            ⟨{ toFun := fun x => g.1 ((Fgt.map f.unop).left x)
               isLocallyConstant := fun t =>
                 (Fgt.map f.unop).left.continuous.isOpen_preimage _ (g.1.isLocallyConstant t) },
             fun x hx => g.2 ((Fgt.map f.unop).left x) (fun hmem =>
               hx (Eq.mp (congrArg (· ∈ (V : Set ↥S))
                 ((AlgebraicGeometry.Scheme.Hom.comp_apply (Fgt.map f.unop).left
                   (Fgt.obj (Opposite.unop U₁)).hom x).symm.trans
                   (congrArg (fun k : Quiver.Hom (Fgt.obj (Opposite.unop U₂)).left S => k x)
                     (Fgt.map f.unop).w))) hmem))⟩
          map_zero' := Subtype.ext (LocallyConstant.ext (fun _ => rfl))
          map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext (fun _ => rfl)) }
    map_id := fun _ => AddCommGrpCat.ext (fun _ => Subtype.ext (LocallyConstant.ext (fun _ => rfl)))
    map_comp := fun _ _ => AddCommGrpCat.ext (fun _ => Subtype.ext (LocallyConstant.ext (fun _ => rfl))) }

def weilAltZeroBdrySubpresheafι (S : AlgebraicGeometry.Scheme.{u}) (V : S.Opens) (n : ℕ) :
    weilAltZeroBdrySubpresheaf S V n ⟶ weilAltLocConstPresheaf S n where
  app := fun U => AddCommGrpCat.ofHom (weilAltZeroBdrySubgroup S V n (Opposite.unop U)).subtype
  naturality := fun _ _ _ => AddCommGrpCat.ext (fun _ => rfl)

def weilAltLocConstConstHom (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) (n : ℕ) :
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n)) ⟶
      (weilAltLocConstPresheaf S n).obj (Opposite.op U) :=
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  AddCommGrpCat.ofHom
    { toFun := fun a => LocallyConstant.const ↥(Fgt.obj U).left a
      map_zero' := LocallyConstant.ext (fun _ => rfl)
      map_add' := fun _ _ => LocallyConstant.ext (fun _ => rfl) }

noncomputable def weilAltLocConstPullbackNat {Y₀ X₀ : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom Y₀ X₀) (n : ℕ) :
    weilAltLocConstPresheaf X₀ n ⟶
      (weilEtaleSitePullback f).op ⋙ weilAltLocConstPresheaf Y₀ n :=
  let B := weilEtaleSitePullback f
  let FgtX := AlgebraicGeometry.Scheme.Etale.forget X₀
  let FgtY := AlgebraicGeometry.Scheme.Etale.forget Y₀
  { app := fun U =>
      let pr₁ : Quiver.Hom (FgtY.obj (B.obj (Opposite.unop U))).left
          (FgtX.obj (Opposite.unop U)).left :=
        CategoryTheory.Limits.pullback.fst (FgtX.obj (Opposite.unop U)).hom f
      AddCommGrpCat.ofHom
        { toFun := fun g =>
            { toFun := fun y => g (pr₁ y)
              isLocallyConstant := fun t =>
                pr₁.continuous.isOpen_preimage _ (g.isLocallyConstant t) }
          map_zero' := LocallyConstant.ext (fun _ => rfl)
          map_add' := fun _ _ => LocallyConstant.ext (fun _ => rfl) }
    naturality := fun {U₁ U₂} u =>
      AddCommGrpCat.ext (fun (g : LocallyConstant ↥(FgtX.obj (Opposite.unop U₁)).left (ULift.{u} (ZMod n))) =>
        LocallyConstant.ext (fun y =>
          congrArg g
            ((AlgebraicGeometry.Scheme.Hom.comp_apply
              (FgtY.map (B.map u.unop)).left
              (CategoryTheory.Limits.pullback.fst (FgtX.obj (Opposite.unop U₁)).hom f) y).symm.trans
            ((congrArg (fun k : Quiver.Hom (FgtY.obj (B.obj (Opposite.unop U₂))).left
                (FgtX.obj (Opposite.unop U₁)).left => k y)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            (AlgebraicGeometry.Scheme.Hom.comp_apply
              (CategoryTheory.Limits.pullback.fst (FgtX.obj (Opposite.unop U₂)).hom f)
              (FgtX.map u.unop).left y))).symm)) }
