    let P_rel : CategoryTheory.Functor (Opposite (Pd δ).Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp (weilEtaleSitePullback (π_fst δ)).op Q_rel
    ((CategoryTheory.constantSheafAdj (Pd δ).smallEtaleTopology AddCommGrpCat.{u} hT_δ).homEquiv
      (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ r))))
      (weilEtaleHigherDirectImage (π_fst δ) 2
        (weilEtaleTorsionSheaf (Pd (δ + 1)) (ℓ ^ r)))
      (γ_rel δ r)) (ULift.up 1) =
    (((CategoryTheory.sheafificationAdjunction (Pd δ).smallEtaleTopology
      AddCommGrpCat.{u}).unit.app P_rel).app
      (Opposite.op T_δ))
      (weilPolyP1CohomologyTermToPresheaf (Pd (δ + 1))
        ((weilEtaleSitePullback (π_fst δ)).obj T_δ) hT_top
