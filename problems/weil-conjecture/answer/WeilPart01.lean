def WeilCurveMidExtIsShriekDualMap.{u}
    (S : AlgebraicGeometry.Scheme.{u}) (U : S.Opens) (m M : ℕ)
    (h_et_V : ∀ {V : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom V U.toScheme),
      AlgebraicGeometry.Etale π → AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp π U.ι))
    (Γ : Type u) [Group Γ]
    (V : AlgebraicGeometry.Scheme.{u})
    (π : Quiver.Hom V U.toScheme) (hπ_et : AlgebraicGeometry.Etale π)
    (act : Γ → Quiver.Hom V V)
    (τ_rep : Γ →* (Matrix (Fin M) (Fin M) (ZMod m))ˣ)
    (𝒥 ℳ_dual : CategoryTheory.Sheaf S.smallEtaleTopology
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))))
    (triv_dual : ∀ W : S.Etale,
      let ι_V : Quiver.Hom V S := CategoryTheory.CategoryStruct.comp π U.ι
      let W_V := CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom ι_V
      ↑(ℳ_dual.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_V (Fin M → ZMod m))
    (Ψ : CategoryTheory.Abelian.Ext.{u} (weilEtaleModuleUnit S m) ℳ_dual 1 →+
      CategoryTheory.Abelian.Ext.{u} 𝒥 (weilEtaleModuleUnit S m) 1) : Prop :=
  let R := ULift.{u, 0} (ZMod m)
  let J_top := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J_top (ModuleCat.{u, u} R)
  let oneR := weilEtaleModuleUnit S m
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  let ι_V : Quiver.Hom V S := CategoryTheory.CategoryStruct.comp π U.ι
  let hι_et : AlgebraicGeometry.Etale ι_V := h_et_V π hπ_et
  let obj_WV : S.Etale → S.Etale := fun W =>
    let h_W : Quiver.Hom (Fgt.obj W).left S := (Fgt.obj W).hom
    letI : AlgebraicGeometry.Etale h_W := W.prop
    letI : AlgebraicGeometry.Etale ι_V := hι_et
    CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst h_W ι_V) h_W)
      inferInstance
  ∃ (T_sh : CategoryTheory.Functor 𝒞 𝒞)
    (hAdd : T_sh.Additive)
    (hLim : CategoryTheory.Limits.PreservesFiniteLimits T_sh)
    (hColim : CategoryTheory.Limits.PreservesFiniteColimits T_sh)
    (triv_T : ∀ (𝒢 : 𝒞) (W : S.Etale),
      ↑((T_sh.obj 𝒢).obj.obj (Opposite.op W)) →ₗ[R]
        (Fin M → ↑(𝒢.obj.obj (Opposite.op (obj_WV W)))))
    (e_one : CategoryTheory.Iso 𝒥 (T_sh.obj oneR))
    (ε_tr : Quiver.Hom (T_sh.obj ℳ_dual) oneR),
    (∀ (𝒢 : 𝒞) (W : S.Etale),
      let h_W := (Fgt.obj W).hom
      Function.Injective (triv_T 𝒢 W) ∧
      Set.range (triv_T 𝒢 W) =
        { f |
          (∃ W₀ : (Fgt.obj W).left.Opens,
            ((TopologicalSpace.Opens.map h_W.base).obj U) ⊔ W₀ = ⊤ ∧
            let W₀_V : ((Fgt.obj (obj_WV W)).left).Opens :=
              (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst h_W ι_V).base).obj W₀
            letI : AlgebraicGeometry.Etale (Fgt.obj (obj_WV W)).hom := (obj_WV W).prop
            let obj_W₀V : S.Etale :=
              CategoryTheory.MorphismProperty.Over.mk ⊤
                (CategoryTheory.CategoryStruct.comp W₀_V.ι (Fgt.obj (obj_WV W)).hom)
                inferInstance
            let inc_W₀ : Quiver.Hom obj_W₀V (obj_WV W) :=
              CategoryTheory.MorphismProperty.Over.homMk W₀_V.ι rfl trivial
            ∀ i : Fin M, (𝒢.obj.map (Opposite.op inc_W₀)).hom (f i) = 0) ∧
          (∀ (g : Γ) (m_g : Quiver.Hom (obj_WV W) (obj_WV W)),
            CategoryTheory.CategoryStruct.comp (Fgt.map m_g).left
              (CategoryTheory.Limits.pullback.fst h_W ι_V) =
              CategoryTheory.Limits.pullback.fst h_W ι_V →
            CategoryTheory.CategoryStruct.comp (Fgt.map m_g).left
              (CategoryTheory.Limits.pullback.snd h_W ι_V) =
              CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd h_W ι_V)
                (act g) →
            ∀ i : Fin M,
              (𝒢.obj.map (Opposite.op m_g)).hom (f i) =
