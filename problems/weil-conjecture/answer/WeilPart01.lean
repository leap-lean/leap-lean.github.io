        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) e_U.hom
        let W_r := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_r
        ↑((ℰ₀ r).obj.obj (Opposite.op W)) →+
          (LocallyConstant ↥W_r (Fin N → ZMod (ℓ ^ (r + 1)))),
      ∀ r : ℕ,
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) e_U.hom
        let π_succ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (B (r + 1)))) U₀.toScheme :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B (r + 1))))) e_U.hom
        let A_r : AddCommGrpCat.{u} :=
          AddCommGrpCat.uliftFunctor.{u, 0}.obj
            (AddCommGrpCat.of (Fin N → ZMod (ℓ ^ (r + 1))))
        WeilIsEtaleSheafPullback π_r (ℰ₀ r)
          ((CategoryTheory.constantSheaf V_r.smallEtaleTopology AddCommGrpCat.{u}).obj A_r) ∧
        (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
          let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
          let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
          ∀ (u_r : Quiver.Hom W₁_r W₂_r),
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst h₁ π_r)
                ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
              CategoryTheory.Limits.pullback.snd h₁ π_r →
            ∀ (s : ↑((ℰ₀ r).obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
              triv r W₁ (((ℰ₀ r).obj.map (Opposite.op u)) s) y₁ =
                triv r W₂ s (u_r.base y₁)) ∧
        ∀ (W : U₀.toScheme.Etale),
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_r := CategoryTheory.Limits.pullback h_W π_r
          let W_succ := CategoryTheory.Limits.pullback h_W π_succ
          Function.Injective (triv r W) ∧
          Set.range (triv r W) =
            { f | ∀ (σ : B r ≃ₐ[R₀] B r) (m_σ : Quiver.Hom W_r W_r),
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π_r) =
                CategoryTheory.Limits.pullback.fst h_W π_r →
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W π_r) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W π_r)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_r, f (m_σ.base y) = ((τ_rep r σ).val).mulVec (f y) } ∧
          ∀ (s_up : ↑((ℰ₀ (r + 1)).obj.obj (Opposite.op W)))
            (m_ι : Quiver.Hom W_succ W_r),
            CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.fst h_W π_r) =
              CategoryTheory.Limits.pullback.fst h_W π_succ →
            CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.snd h_W π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W π_succ)
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom)) →
            ∀ (y_up : ↥W_succ) (i : Fin N),
              triv r W (((τ_ℰ r).hom.app (Opposite.op W)) s_up) (m_ι.base y_up) i =
                ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
                  (triv (r + 1) W s_up y_up i))

def WeilCurveZeroExtSystem.{u} (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)))
      (weilProjectiveSpaceOver F 1).left)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (u₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F))
      (weilProjectiveSpaceOver F 1).left)
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)]
    (H_geom : Subgroup ((Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ))
    (A_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (A_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin N) (Fin N) (PadicInt ℓ))
    (𝒥₀ : ℕ → CategoryTheory.Sheaf (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
      AddCommGrpCat.{u})
    (τ_𝒥 : ∀ r : ℕ, Quiver.Hom (𝒥₀ (r + 1)) (𝒥₀ r)) : Prop :=
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  let D₀ := (weilProjectiveSpaceOver F 1).left
  ∃ (a₀ : F) (_ : a₀ ∉ S_aff)
    (B L_fld : ℕ → Type u)
    (_ : ∀ r, CommRing (B r)) (_ : ∀ r, IsDomain (B r)) (_ : ∀ r, Field (L_fld r))
    (_ : ∀ r, Algebra F (B r)) (_ : ∀ r, Algebra (Polynomial F) (B r)) (_ : ∀ r, Algebra R₀ (B r))
    (_ : ∀ r, Algebra F (L_fld r)) (_ : ∀ r, Algebra (Polynomial F) (L_fld r))
    (_ : ∀ r, Algebra (RatFunc F) (L_fld r))
    (_ : ∀ r, Algebra (B r) (L_fld r)) (_ : ∀ r, Algebra R₀ (L_fld r))
    (_ : ∀ r, IsScalarTower F (Polynomial F) (B r)) (_ : ∀ r, IsScalarTower (Polynomial F) R₀ (B r))
    (_ : ∀ r, IsScalarTower F (RatFunc F) (L_fld r))
    (_ : ∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_fld r))
    (_ : ∀ r, IsScalarTower (Polynomial F) (B r) (L_fld r))
    (_ : ∀ r, IsScalarTower R₀ (B r) (L_fld r))
    (_ : ∀ r, Module.Finite R₀ (B r)) (_ : ∀ r, Algebra.Etale R₀ (B r))
    (_ : ∀ r, IsFractionRing (B r) (L_fld r)) (_ : ∀ r, IsIntegralClosure (B r) R₀ (L_fld r))
    (_ : ∀ r, FiniteDimensional (RatFunc F) (L_fld r)) (_ : ∀ r, IsGalois (RatFunc F) (L_fld r))
    (τ_rep : ∀ r : ℕ, (B r ≃ₐ[R₀] B r) →* (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))))ˣ)
    (ι_B : ∀ r : ℕ, B r →ₐ[R₀] B (r + 1))
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme),
    u₀ = CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a₀))) j_aff ∧
    CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀))) j_aff ∧
    (∀ (r : ℕ) (h : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ), h ∈ H_geom →
      ∃ σ : B r ≃ₐ[R₀] B r,
        (∀ x : B r, IsIntegral F x → σ x = x) ∧
        (τ_rep r σ).val = (h.val).map (PadicInt.toZModPow (r + 1))) ∧
    (∀ (r : ℕ) (σ : B r ≃ₐ[R₀] B r),
      (∀ x : B r, IsIntegral F x → σ x = x) →
      ∃ h ∈ H_geom, (τ_rep r σ).val = (h.val).map (PadicInt.toZModPow (r + 1))) ∧
    (∀ r : ℕ, Function.Injective (ι_B r) ∧
      ∀ τ : B (r + 1) ≃ₐ[R₀] B (r + 1),
        ∃ σ : B r ≃ₐ[R₀] B r,
          (∀ b : B r, τ (ι_B r b) = ι_B r (σ b)) ∧
          ((τ_rep (r + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) _) =
            (τ_rep r σ).val) ∧
    (∃ Q_u : ∀ r : ℕ, Ideal (B r),
      (∀ r : ℕ, (Q_u r).IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_u r) =
          Ideal.span {Polynomial.X - Polynomial.C a₀} ∧
        Ideal.comap (ι_B r).toRingHom (Q_u (r + 1)) = Q_u r ∧
        ∃ σ_u : B r ≃ₐ[R₀] B r,
          (∀ b : B r, σ_u.symm b - b ^ Nat.card F ∈ Q_u r) ∧
          (τ_rep r σ_u).val = (A_u.val).map (PadicInt.toZModPow (r + 1)))) ∧
    (∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
      ∃ Q_P : ∀ r : ℕ, Ideal (B r),
        ∀ r : ℕ, (Q_P r).IsMaximal ∧
          Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_P r) = Ideal.span {P} ∧
          Ideal.comap (ι_B r).toRingHom (Q_P (r + 1)) = Q_P r ∧
          ∃ σ : B r ≃ₐ[R₀] B r,
            (∀ b : B r, σ.symm b - b ^ (Nat.card F ^ d) ∈ Q_P r) ∧
            (τ_rep r σ).val = (A_mat d P hP).map (PadicInt.toZModPow (r + 1))) ∧
    (∃ triv_! : ∀ (r : ℕ) (W : D₀.Etale),
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) e_U.hom
        let ι_r : Quiver.Hom V_r D₀ := CategoryTheory.CategoryStruct.comp π_r U₀.ι
        let W_r := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).hom ι_r
        ↑((𝒥₀ r).obj.obj (Opposite.op W)) →+
          (LocallyConstant ↥W_r (Fin N → ZMod (ℓ ^ (r + 1)))),
      ∀ r : ℕ,
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) e_U.hom
        let ι_r : Quiver.Hom V_r D₀ := CategoryTheory.CategoryStruct.comp π_r U₀.ι
        let π_succ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (B (r + 1)))) U₀.toScheme :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B (r + 1))))) e_U.hom
        let ι_succ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (B (r + 1)))) D₀ :=
          CategoryTheory.CategoryStruct.comp π_succ U₀.ι
        (∀ {W₁ W₂ : D₀.Etale} (u : Quiver.Hom W₁ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W₂).hom
          let W₁_r := CategoryTheory.Limits.pullback h₁ ι_r
          let W₂_r := CategoryTheory.Limits.pullback h₂ ι_r
          ∀ (u_r : Quiver.Hom W₁_r W₂_r),
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ ι_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst h₁ ι_r)
                ((AlgebraicGeometry.Scheme.Etale.forget D₀).map u).left →
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ ι_r) =
              CategoryTheory.Limits.pullback.snd h₁ ι_r →
            ∀ (s : ↑((𝒥₀ r).obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
              triv_! r W₁ (((𝒥₀ r).obj.map (Opposite.op u)) s) y₁ =
                triv_! r W₂ s (u_r.base y₁)) ∧
        ∀ (W : D₀.Etale),
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).hom
          let W_r := CategoryTheory.Limits.pullback h_W ι_r
          let W_succ := CategoryTheory.Limits.pullback h_W ι_succ
          Function.Injective (triv_! r W) ∧
          Set.range (triv_! r W) =
            { f |
              (∃ W₀ : ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).left.Opens,
                ((TopologicalSpace.Opens.map h_W.base).obj U₀) ⊔ W₀ = ⊤ ∧
                ∀ y : ↥W_r, (CategoryTheory.Limits.pullback.fst h_W ι_r).base y ∈ W₀ → f y = 0) ∧
              (∀ (σ : B r ≃ₐ[R₀] B r) (m_σ : Quiver.Hom W_r W_r),
                CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W ι_r) =
                  CategoryTheory.Limits.pullback.fst h_W ι_r →
                CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W ι_r) =
                  CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.Limits.pullback.snd h_W ι_r)
                    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
                ∀ y : ↥W_r, f (m_σ.base y) = ((τ_rep r σ).val).mulVec (f y)) } ∧
          ∀ (s_up : ↑((𝒥₀ (r + 1)).obj.obj (Opposite.op W)))
            (m_ι : Quiver.Hom W_succ W_r),
            CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.fst h_W ι_r) =
              CategoryTheory.Limits.pullback.fst h_W ι_succ →
            CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.snd h_W ι_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W ι_succ)
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom)) →
            ∀ (y_up : ↥W_succ) (i : Fin N),
              triv_! r W (((τ_𝒥 r).hom.app (Opposite.op W)) s_up) (m_ι.base y_up) i =
                ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
                  (triv_! (r + 1) W s_up y_up i))
noncomputable def weilSingDevPencilHigherDirectImage (F : Type u) [Field F]
    {Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))}
    (f₀ : Quiver.Hom Z_tilde (weilProjectiveSpaceOver F 1)) (ℓ q r : ℕ) :
    CategoryTheory.Sheaf (weilProjectiveSpaceOver F 1).left.smallEtaleTopology AddCommGrpCat.{u} :=
  weilEtaleHigherDirectImage f₀.left q (weilEtaleTorsionSheaf Z_tilde.left (ℓ ^ (r + 1)))

noncomputable def weilSingDevPencilHigherDirectImageMap (F : Type u) [Field F]
    {Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))}
    (f₀ : Quiver.Hom Z_tilde (weilProjectiveSpaceOver F 1)) (ℓ q r : ℕ) :
    Quiver.Hom
      (weilSingDevPencilHigherDirectImage F f₀ ℓ q (r + 1))
      (weilSingDevPencilHigherDirectImage F f₀ ℓ q r) :=
  weilEtaleHigherDirectImageMap f₀.left q
    ((CategoryTheory.constantSheaf Z_tilde.left.smallEtaleTopology AddCommGrpCat.{u}).map
      (AddCommGrpCat.uliftFunctor.{u, 0}.map
        (AddCommGrpCat.ofHom
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))).toAddMonoidHom)))

def WeilSingDevIs1dPencilOdpDatum (F : Type u) [Field F] (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (f₀ : Quiver.Hom Z_tilde (weilProjectiveSpaceOver F 1))
    (u₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F))
      (weilProjectiveSpaceOver F 1).left)
    (j_aff : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)))
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F))
      (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens) : Prop :=
  AlgebraicGeometry.IsOpenImmersion j_aff ∧
  CategoryTheory.CategoryStruct.comp j_aff (weilProjectiveSpaceOver F 1).hom =
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
  CategoryTheory.CategoryStruct.comp s_inf (weilProjectiveSpaceOver F 1).hom =
    CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of F)) ∧
  (Set.range j_aff.base)ᶜ = Set.range s_inf.base ∧
  (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
    j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
      ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal } ∧
  Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left) ∧
  AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (f₀.left ∣_ U₀) ∧
  (∃ x_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F)) Z_tilde.left,
    CategoryTheory.CategoryStruct.comp x_inf f₀.left = s_inf ∧
    (∀ z : Z_tilde.left, f₀.left.base z ∈ Set.range s_inf.base →
      z ∉ Set.range x_inf.base →
        ∃ V : Z_tilde.left.Opens, z ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1)
            (CategoryTheory.CategoryStruct.comp V.ι f₀.left)) ∧
    ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
      IsEtaleSplitOdpPointOver m f₀ (x_inf.base pt) (s_inf.base pt)) ∧
  (∀ a ∈ S_aff,
    let s_a : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F))
        (weilProjectiveSpaceOver F 1).left :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))) j_aff
    ∃ x_a : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F)) Z_tilde.left,
      CategoryTheory.CategoryStruct.comp x_a f₀.left = s_a ∧
      (∀ z : Z_tilde.left, f₀.left.base z ∈ Set.range s_a.base →
        z ∉ Set.range x_a.base →
          ∃ V : Z_tilde.left.Opens, z ∈ V ∧
            AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1)
              (CategoryTheory.CategoryStruct.comp V.ι f₀.left)) ∧
      ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
        IsEtaleSplitOdpPointOver m f₀ (x_a.base pt) (s_a.base pt))

def WeilSingDevTowerWithInertia.{u} (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)))
      (weilProjectiveSpaceOver F 1).left)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (u₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F))
      (weilProjectiveSpaceOver F 1).left)
    (ℓ M : ℕ) [Fact (Nat.Prime ℓ)]
    (J : Matrix (Fin M) (Fin M) (Padic ℓ))
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
    (F_u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ)
    (F_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin M) (Fin M) (PadicInt ℓ))
    (Δ : Set (Fin M → Padic ℓ))
    (ℒ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
    (τ_ℒ : ∀ r : ℕ, Quiver.Hom (ℒ₀ (r + 1)) (ℒ₀ r)) : Prop :=
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  let S_gen : Set ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ) :=
    { u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ |
      u ∈ G_geom ∧ ∃ v ∈ Δ, ∃ c : Padic ℓ,
        ∀ x : Fin M → Padic ℓ,
          ((u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
            x + (c * dotProduct x (J.mulVec v)) • v }
  ∃ (a₀ : F) (_ : a₀ ∉ S_aff)
    (B L_fld : ℕ → Type u)
    (_ : ∀ r, CommRing (B r)) (_ : ∀ r, IsDomain (B r)) (_ : ∀ r, Field (L_fld r))
    (_ : ∀ r, Algebra F (B r)) (_ : ∀ r, Algebra (Polynomial F) (B r)) (_ : ∀ r, Algebra R₀ (B r))
    (_ : ∀ r, Algebra F (L_fld r)) (_ : ∀ r, Algebra (Polynomial F) (L_fld r))
    (_ : ∀ r, Algebra (RatFunc F) (L_fld r))
    (_ : ∀ r, Algebra (B r) (L_fld r)) (_ : ∀ r, Algebra R₀ (L_fld r))
    (_ : ∀ r, IsScalarTower F (Polynomial F) (B r)) (_ : ∀ r, IsScalarTower (Polynomial F) R₀ (B r))
    (_ : ∀ r, IsScalarTower F (RatFunc F) (L_fld r))
    (_ : ∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_fld r))
    (_ : ∀ r, IsScalarTower (Polynomial F) (B r) (L_fld r))
    (_ : ∀ r, IsScalarTower R₀ (B r) (L_fld r))
    (_ : ∀ r, Module.Finite R₀ (B r)) (_ : ∀ r, Algebra.Etale R₀ (B r))
    (_ : ∀ r, IsFractionRing (B r) (L_fld r)) (_ : ∀ r, IsIntegralClosure (B r) R₀ (L_fld r))
    (_ : ∀ r, FiniteDimensional (RatFunc F) (L_fld r)) (_ : ∀ r, IsGalois (RatFunc F) (L_fld r))
    (ρ : ∀ r : ℕ, (B r ≃ₐ[R₀] B r) →* (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ)
    (ι_B : ∀ r : ℕ, B r →ₐ[R₀] B (r + 1))
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme),
    u₀ = CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a₀))) j_aff ∧
    CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀))) j_aff ∧
    (∀ r : ℕ, Function.Injective (ρ r)) ∧
    (∀ (r : ℕ) (g : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ), g ∈ G_geom →
      ∃ σ : B r ≃ₐ[R₀] B r,
        (∀ x : B r, IsIntegral F x → σ x = x) ∧
        (ρ r σ).val = (g.val).map (PadicInt.toZModPow (r + 1))) ∧
    (∀ (r : ℕ) (σ : B r ≃ₐ[R₀] B r),
      (∀ x : B r, IsIntegral F x → σ x = x) →
      ∃ g ∈ G_geom, (ρ r σ).val = (g.val).map (PadicInt.toZModPow (r + 1))) ∧
    (∀ r : ℕ, Function.Injective (ι_B r) ∧
      ∀ τ : B (r + 1) ≃ₐ[R₀] B (r + 1),
        ∃ σ : B r ≃ₐ[R₀] B r,
          (∀ b : B r, τ (ι_B r b) = ι_B r (σ b)) ∧
          ((ρ (r + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) _) =
            (ρ r σ).val) ∧
    (∃ Q_u : ∀ r : ℕ, Ideal (B r),
      (∀ r : ℕ, (Q_u r).IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_u r) =
          Ideal.span {Polynomial.X - Polynomial.C a₀} ∧
        Ideal.comap (ι_B r).toRingHom (Q_u (r + 1)) = Q_u r ∧
        ∃ σ_u : B r ≃ₐ[R₀] B r,
          (∀ b : B r, σ_u.symm b - b ^ Nat.card F ∈ Q_u r) ∧
          (ρ r σ_u).val = (F_u.val).map (PadicInt.toZModPow (r + 1)))) ∧
    (∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
      ∃ Q_P : ∀ r : ℕ, Ideal (B r),
        ∀ r : ℕ, (Q_P r).IsMaximal ∧
          Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_P r) = Ideal.span {P} ∧
          Ideal.comap (ι_B r).toRingHom (Q_P (r + 1)) = Q_P r ∧
          ∃ σ : B r ≃ₐ[R₀] B r,
            (∀ b : B r, σ.symm b - b ^ (Nat.card F ^ d) ∈ Q_P r) ∧
            (ρ r σ).val = (F_mat d P hP).map (PadicInt.toZModPow (r + 1))) ∧
    (∃ triv : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) e_U.hom
        let W_r := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_r
        ↑((ℒ₀ r).obj.obj (Opposite.op W)) →+
          (LocallyConstant ↥W_r (Fin M → ZMod (ℓ ^ (r + 1)))),
      ∀ r : ℕ,
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) e_U.hom
        let π_succ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (B (r + 1)))) U₀.toScheme :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B (r + 1))))) e_U.hom
        let A_r : AddCommGrpCat.{u} :=
          AddCommGrpCat.uliftFunctor.{u, 0}.obj
            (AddCommGrpCat.of (Fin M → ZMod (ℓ ^ (r + 1))))
        WeilIsEtaleSheafPullback π_r (ℒ₀ r)
          ((CategoryTheory.constantSheaf V_r.smallEtaleTopology AddCommGrpCat.{u}).obj A_r) ∧
        (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
          let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
          let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
          ∀ (u_r : Quiver.Hom W₁_r W₂_r),
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst h₁ π_r)
                ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
              CategoryTheory.Limits.pullback.snd h₁ π_r →
            ∀ (s : ↑((ℒ₀ r).obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
              triv r W₁ (((ℒ₀ r).obj.map (Opposite.op u)) s) y₁ =
                triv r W₂ s (u_r.base y₁)) ∧
        ∀ (W : U₀.toScheme.Etale),
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_r := CategoryTheory.Limits.pullback h_W π_r
          let W_succ := CategoryTheory.Limits.pullback h_W π_succ
          Function.Injective (triv r W) ∧
          Set.range (triv r W) =
            { f | ∀ (σ : B r ≃ₐ[R₀] B r) (m_σ : Quiver.Hom W_r W_r),
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π_r) =
                CategoryTheory.Limits.pullback.fst h_W π_r →
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W π_r) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W π_r)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_r, f (m_σ.base y) = ((ρ r σ).val).mulVec (f y) } ∧
          ∀ (s_up : ↑((ℒ₀ (r + 1)).obj.obj (Opposite.op W)))
            (m_ι : Quiver.Hom W_succ W_r),
            CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.fst h_W π_r) =
              CategoryTheory.Limits.pullback.fst h_W π_succ →
            CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.snd h_W π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W π_succ)
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom)) →
            ∀ (y_up : ↥W_succ) (i : Fin M),
              triv r W (((τ_ℒ r).hom.app (Opposite.op W)) s_up) (m_ι.base y_up) i =
                ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
                  (triv (r + 1) W s_up y_up i)) ∧
    ∀ r : ℕ,
      let C₀_r := integralClosure (Polynomial F) (L_fld r)
      let A_inf_r := Algebra.adjoin F ({algebraMap (RatFunc F) (L_fld r) (RatFunc.X)⁻¹} : Set (L_fld r))
      let t_inf_r : ↥A_inf_r :=
        ⟨algebraMap (RatFunc F) (L_fld r) (RatFunc.X)⁻¹, Algebra.self_mem_adjoin_singleton F _⟩
      let C_inf_r := integralClosure ↥A_inf_r (L_fld r)
      (∀ (a : F), a ∈ S_aff →
        ∀ (Q : Ideal ↥C₀_r), Q.IsPrime →
          Ideal.comap (algebraMap (Polynomial F) ↥C₀_r) Q =
            Ideal.span {Polynomial.X - Polynomial.C a} →
          ∀ (σ_L : L_fld r ≃ₐ[RatFunc F] L_fld r) (σ_B : B r ≃ₐ[R₀] B r),
            (∀ x : L_fld r, IsIntegral F x → σ_L x = x) →
            (∀ b : B r, σ_L (algebraMap (B r) (L_fld r) b) =
              algebraMap (B r) (L_fld r) (σ_B b)) →
            (∀ y : ↥C₀_r,
              σ_L (y : L_fld r) - (y : L_fld r) ∈ Subtype.val '' (Q : Set ↥C₀_r)) →
            ∃ u ∈ S_gen, (ρ r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1))) ∧
      (∀ (Q_inf : Ideal ↥C_inf_r), Q_inf.IsPrime →
        Ideal.comap (algebraMap ↥A_inf_r ↥C_inf_r) Q_inf = Ideal.span {t_inf_r} →
        ∀ (σ_L : L_fld r ≃ₐ[RatFunc F] L_fld r) (σ_B : B r ≃ₐ[R₀] B r),
          (∀ x : L_fld r, IsIntegral F x → σ_L x = x) →
          (∀ b : B r, σ_L (algebraMap (B r) (L_fld r) b) =
            algebraMap (B r) (L_fld r) (σ_B b)) →
          (∀ y : ↥C_inf_r,
            σ_L (y : L_fld r) - (y : L_fld r) ∈ Subtype.val '' (Q_inf : Set ↥C_inf_r)) →
          ∃ u ∈ S_gen, (ρ r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1)))
structure WeilEtaleSitePullbackData (Z₁ Z₂ : AlgebraicGeometry.Scheme.{u})
    (h : Quiver.Hom Z₁ Z₂) : Prop where
  hCont : (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology
  hAdj :
    letI := hCont
    ((weilEtaleSitePullback h).sheafPushforwardContinuous
      AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint
  hAdd_pb :
    letI := hCont
    letI := hAdj
    ((weilEtaleSitePullback h).sheafPullback
      AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).Additive
  hAdd_pf :
    letI := hCont
    ((weilEtaleSitePullback h).sheafPushforwardContinuous
      AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).Additive
  hLim_pb :
    letI := hCont
    letI := hAdj
    CategoryTheory.Limits.PreservesFiniteLimits
      ((weilEtaleSitePullback h).sheafPullback
        AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
  hColim_pb :
    letI := hCont
    letI := hAdj
    CategoryTheory.Limits.PreservesFiniteColimits
      ((weilEtaleSitePullback h).sheafPullback
        AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
  hConstIso :
    letI := hCont
    letI := hAdj
    ∀ {T₁ : Z₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      {T₂ : Z₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (A : AddCommGrpCat.{u}),
      CategoryTheory.IsIso (weilEtaleConstPullbackHom h hT₁ hT₂ A)

abbrev WeilEtaleSitePullbackSys.{u} : Prop :=
  ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
    WeilEtaleSitePullbackData Z₁ Z₂ h

structure WeilTwoStepAcyclicRes (Y S : AlgebraicGeometry.Scheme.{u})
    (f : Quiver.Hom Y S) (M : ℕ)
    (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) : Type (u + 1) where
  A₀ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}
  Q₁ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}
  A₁ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}
  Q₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}
  u₀ : Quiver.Hom F A₀
  v₀ : Quiver.Hom A₀ Q₁
  h₀ : CategoryTheory.CategoryStruct.comp u₀ v₀ = 0
  hSE₀ : (CategoryTheory.ShortComplex.mk u₀ v₀ h₀).ShortExact
  u₁ : Quiver.Hom Q₁ A₁
  v₁ : Quiver.Hom A₁ Q₂
  h₁ : CategoryTheory.CategoryStruct.comp u₁ v₁ = 0
  hSE₁ : (CategoryTheory.ShortComplex.mk u₁ v₁ h₁).ShortExact
  hTor_F : M • CategoryTheory.CategoryStruct.id F = 0
  hTor_A₀ : M • CategoryTheory.CategoryStruct.id A₀ = 0
  hTor_Q₁ : M • CategoryTheory.CategoryStruct.id Q₁ = 0
  hTor_A₁ : M • CategoryTheory.CategoryStruct.id A₁ = 0
  hTor_Q₂ : M • CategoryTheory.CategoryStruct.id Q₂ = 0
  hGlob_A₀ : ∀ q : ℕ, 1 ≤ q → Subsingleton (A₀.H q)
  hGlob_A₁ : ∀ q : ℕ, 1 ≤ q → Subsingleton (A₁.H q)
  hDir_A₀ : ∀ q : ℕ, 1 ≤ q → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f q A₀)
  hDir_A₁ : ∀ q : ℕ, 1 ≤ q → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f q A₁)

def WeilHasInjKernelTerms {Y S : AlgebraicGeometry.Scheme.{u}} {f : Quiver.Hom Y S}
    (M : ℕ) {F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
    (R : WeilTwoStepAcyclicRes Y S f M F) : Prop :=
  (∃ (J₀ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
      (_ : CategoryTheory.Injective J₀),
    Nonempty (CategoryTheory.Iso R.A₀
      (CategoryTheory.Limits.kernel (M • CategoryTheory.CategoryStruct.id J₀)))) ∧
  (∃ (J₁ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
      (_ : CategoryTheory.Injective J₁),
    Nonempty (CategoryTheory.Iso R.A₁
      (CategoryTheory.Limits.kernel (M • CategoryTheory.CategoryStruct.id J₁))))

structure WeilTwoStepResHom {Y S : AlgebraicGeometry.Scheme.{u}} {f : Quiver.Hom Y S}
    {M₁ M₂ : ℕ} {F₁ F₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
    (R₁ : WeilTwoStepAcyclicRes Y S f M₁ F₁)
    (R₂ : WeilTwoStepAcyclicRes Y S f M₂ F₂)
    (φ : Quiver.Hom F₁ F₂) : Type (u + 1) where
  α₀ : Quiver.Hom R₁.A₀ R₂.A₀
  φ₁ : Quiver.Hom R₁.Q₁ R₂.Q₁
  α₁ : Quiver.Hom R₁.A₁ R₂.A₁
  φ₂ : Quiver.Hom R₁.Q₂ R₂.Q₂
  comm_u₀ : CategoryTheory.CategoryStruct.comp R₁.u₀ α₀ =
    CategoryTheory.CategoryStruct.comp φ R₂.u₀
  comm_v₀ : CategoryTheory.CategoryStruct.comp R₁.v₀ φ₁ =
    CategoryTheory.CategoryStruct.comp α₀ R₂.v₀
  comm_u₁ : CategoryTheory.CategoryStruct.comp R₁.u₁ α₁ =
    CategoryTheory.CategoryStruct.comp φ₁ R₂.u₁
  comm_v₁ : CategoryTheory.CategoryStruct.comp R₁.v₁ φ₂ =
    CategoryTheory.CategoryStruct.comp α₁ R₂.v₁

noncomputable def weilTwoStepTheta {Y S : AlgebraicGeometry.Scheme.{u}} {f : Quiver.Hom Y S}
    {M : ℕ} {F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
    (sys : WeilEtaleSitePullbackSys.{u}) (δ : ℕ)
    (R : WeilTwoStepAcyclicRes Y S f M F) :
    (letI := (sys f).hCont
     ((weilEtaleSitePullback f).sheafPushforwardContinuous
       AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology).obj R.Q₂).H (2 * δ) →+
      F.H (2 * (δ + 1)) :=
  letI := (sys f).hCont
  letI := (sys f).hAdj
  letI := (sys f).hAdd_pb
  letI := (sys f).hLim_pb
  letI := (sys f).hColim_pb
  let pf_f := (weilEtaleSitePullback f).sheafPushforwardContinuous
    AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology
  let pb_f := (weilEtaleSitePullback f).sheafPullback
    AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology
  let adj_f := (weilEtaleSitePullback f).sheafAdjunctionContinuous
    AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
  let hT_S := weilEtaleIdTerminalIsTerminal.{u} S
  let ιℤ_f : Quiver.Hom Fℤ_Y (pb_f.obj Fℤ_S) :=
    @CategoryTheory.inv _ _ _ _ (weilEtaleConstPullbackHom f hT_Y hT_S Aℤ)
      ((sys f).hConstIso hT_Y hT_S Aℤ)
  (R.hSE₀.extClass.postcomp Fℤ_Y (rfl : (2 * δ + 1) + 1 = 2 * (δ + 1))).comp
    ((R.hSE₁.extClass.postcomp Fℤ_Y (rfl : 2 * δ + 1 = 2 * δ + 1)).comp
      (((CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app R.Q₂)).postcomp Fℤ_Y
          (Nat.add_zero (2 * δ))).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).precomp (pb_f.obj (pf_f.obj R.Q₂))
            (Nat.zero_add (2 * δ))).comp
          (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_f _ _ _ _ _
            Fℤ_S (pf_f.obj R.Q₂) (2 * δ)))))

def WeilIsTwoStepDeltaBar {Y S : AlgebraicGeometry.Scheme.{u}} {f : Quiver.Hom Y S}
    {M : ℕ} {F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
    (sys : WeilEtaleSitePullbackSys.{u})
    (R : WeilTwoStepAcyclicRes Y S f M F)
    (δ_bar : Quiver.Hom
      (letI := (sys f).hCont
       ((weilEtaleSitePullback f).sheafPushforwardContinuous
         AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology).obj R.Q₂)
      (weilEtaleHigherDirectImage f 2 F)) : Prop :=
  letI := (sys f).hCont
  let pf_f := (weilEtaleSitePullback f).sheafPushforwardContinuous
    AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology
  let P_F2 : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
    CategoryTheory.Functor.comp (weilEtaleSitePullback f).op
      (CategoryTheory.Sheaf.cohomologyPresheaf F 2)
  let η_sh := (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
    AddCommGrpCat.{u}).unit.app P_F2
  ∀ (V : S.Etale) (s : ↑((pf_f.obj R.Q₂).obj.obj (Opposite.op V))),
    (δ_bar.hom.app (Opposite.op V)) s =
      (η_sh.app (Opposite.op V))
        (((CategoryTheory.Abelian.Ext.mk₀
            ((weilPolyP1CohomologyRepHomEquiv Y ((weilEtaleSitePullback f).obj V) R.Q₂).symm s)).comp
          R.hSE₁.extClass (Nat.zero_add 1)).comp
          R.hSE₀.extClass (Nat.one_add 1))

noncomputable def weilTwoStepDeltaBarMapH {Y : AlgebraicGeometry.Scheme.{u}}
    (S : AlgebraicGeometry.Scheme.{u}) {f : Quiver.Hom Y S}
    {Q_S : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
    {F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
    (δ : ℕ) (δ_bar : Quiver.Hom Q_S (weilEtaleHigherDirectImage f 2 F)) :
    Q_S.H (2 * δ) →+ (weilEtaleHigherDirectImage f 2 F).H (2 * δ) :=
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  (CategoryTheory.Abelian.Ext.mk₀ δ_bar).postcomp
    ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
    (Nat.add_zero (2 * δ))
noncomputable def weilMidDevOpenHigherDirectImage (F : Type u) [Field F]
    {Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))}
    (f₀ : Quiver.Hom Z_tilde (weilProjectiveSpaceOver F 1))
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens) (ℓ q r : ℕ) :
    CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u} :=
  weilEtaleHigherDirectImage (f₀.left ∣_ U₀) q
    (weilEtaleTorsionSheaf (f₀.left ⁻¹ᵁ U₀).toScheme (ℓ ^ (r + 1)))

noncomputable def weilMidDevOpenHigherDirectImageMap (F : Type u) [Field F]
    {Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))}
    (f₀ : Quiver.Hom Z_tilde (weilProjectiveSpaceOver F 1))
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens) (ℓ q r : ℕ) :
    Quiver.Hom
      (weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q (r + 1))
      (weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q r) :=
  weilEtaleHigherDirectImageMap (f₀.left ∣_ U₀) q
    ((CategoryTheory.constantSheaf (f₀.left ⁻¹ᵁ U₀).toScheme.smallEtaleTopology
        AddCommGrpCat.{u}).map
      (AddCommGrpCat.uliftFunctor.{u, 0}.map
        (AddCommGrpCat.ofHom
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1)))
            (ZMod (ℓ ^ (r + 1)))).toAddMonoidHom)))

structure WeilMidDevSmoothMonodromyPackage.{u} (F : Type u) [Finite F] [Field F] (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (f₀ : Quiver.Hom Z_tilde (weilProjectiveSpaceOver F 1))
    (u₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F))
      (weilProjectiveSpaceOver F 1).left)
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
