        ∀ (K : ℕ) (_hK : 1 ≤ K) (i : Fin 3),
          let m := K - 1
          let M_i := ((M_lat_V σ i).map (PadicInt.toZModPow K)).mulVecLin
          ∃ q_i : (Fin (b_V σ i) → ZMod (ℓ ^ K)) →+ (𝒦 m).H i.1,
