      (hAdj_g : ((weilEtaleSitePullback g).sheafPushforwardContinuous
        AddCommGrpCat.{u} Y.smallEtaleTopology W_top.smallEtaleTopology).IsRightAdjoint),
    let pf_g := (weilEtaleSitePullback g).sheafPushforwardContinuous
