    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme),
    u₀ = CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a₀))) j_aff ∧
    CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀))) j_aff ∧
    (∀ r : ℕ, Function.Injective (ρ r)) ∧
    (∀ (r : ℕ) (g : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ), g ∈ G_geom →
      ∃ σ : B r ≃ₐ[R₀] B r,
        (∀ x : B r, IsIntegral F x → σ x = x) ∧
        (ρ r σ).val = (g.val).map (PadicInt.toZModPow (r + 1))) ∧
    (∀ (r : ℕ) (σ : B r ≃ₐ[R₀] B r),
      (∀ x : B r, IsIntegral F x → σ x = x) →
      ∃ g ∈ G_geom, (ρ r σ).val = (g.val).map (PadicInt.toZModPow (r + 1))) ∧
    (∀ r : ℕ, Function.Injective (ι_B r) ∧
      ∀ τ : B (r + 1) ≃ₐ[R₀] B (r + 1),
        ∃ σ : B r ≃ₐ[R₀] B r,
          (∀ b : B r, τ (ι_B r b) = ι_B r (σ b)) ∧
          ((ρ (r + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) _) =
            (ρ r σ).val) ∧
    (∃ Q_u : ∀ r : ℕ, Ideal (B r),
      (∀ r : ℕ, (Q_u r).IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_u r) =
          Ideal.span {Polynomial.X - Polynomial.C a₀} ∧
        Ideal.comap (ι_B r).toRingHom (Q_u (r + 1)) = Q_u r ∧
        ∃ σ_u : B r ≃ₐ[R₀] B r,
          (∀ b : B r, σ_u.symm b - b ^ Nat.card F ∈ Q_u r) ∧
          (ρ r σ_u).val = (F_u.val).map (PadicInt.toZModPow (r + 1)))) ∧
    (∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
      ∃ Q_P : ∀ r : ℕ, Ideal (B r),
        ∀ r : ℕ, (Q_P r).IsMaximal ∧
          Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_P r) = Ideal.span {P} ∧
          Ideal.comap (ι_B r).toRingHom (Q_P (r + 1)) = Q_P r ∧
          ∃ σ : B r ≃ₐ[R₀] B r,
            (∀ b : B r, σ.symm b - b ^ (Nat.card F ^ d) ∈ Q_P r) ∧
            (ρ r σ).val = (F_mat d P hP).map (PadicInt.toZModPow (r + 1))) ∧
    (∃ triv : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) e_U.hom
        let W_r := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_r
        ↑((ℒ₀ r).obj.obj (Opposite.op W)) →+
          (LocallyConstant ↥W_r (Fin M → ZMod (ℓ ^ (r + 1)))),
      ∀ r : ℕ,
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) e_U.hom
        let π_succ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (B (r + 1)))) U₀.toScheme :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B (r + 1))))) e_U.hom
        let A_r : AddCommGrpCat.{u} :=
          AddCommGrpCat.uliftFunctor.{u, 0}.obj
            (AddCommGrpCat.of (Fin M → ZMod (ℓ ^ (r + 1))))
        WeilIsEtaleSheafPullback π_r (ℒ₀ r)
          ((CategoryTheory.constantSheaf V_r.smallEtaleTopology AddCommGrpCat.{u}).obj A_r) ∧
        (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
          let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
          let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
          ∀ (u_r : Quiver.Hom W₁_r W₂_r),
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst h₁ π_r)
                ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
              CategoryTheory.Limits.pullback.snd h₁ π_r →
            ∀ (s : ↑((ℒ₀ r).obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
              triv r W₁ (((ℒ₀ r).obj.map (Opposite.op u)) s) y₁ =
                triv r W₂ s (u_r.base y₁)) ∧
        ∀ (W : U₀.toScheme.Etale),
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_r := CategoryTheory.Limits.pullback h_W π_r
          let W_succ := CategoryTheory.Limits.pullback h_W π_succ
          Function.Injective (triv r W) ∧
          Set.range (triv r W) =
            { f | ∀ (σ : B r ≃ₐ[R₀] B r) (m_σ : Quiver.Hom W_r W_r),
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π_r) =
                CategoryTheory.Limits.pullback.fst h_W π_r →
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W π_r) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W π_r)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_r, f (m_σ.base y) = ((ρ r σ).val).mulVec (f y) } ∧
          ∀ (s_up : ↑((ℒ₀ (r + 1)).obj.obj (Opposite.op W)))
            (m_ι : Quiver.Hom W_succ W_r),
            CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.fst h_W π_r) =
              CategoryTheory.Limits.pullback.fst h_W π_succ →
            CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.snd h_W π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W π_succ)
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom)) →
            ∀ (y_up : ↥W_succ) (i : Fin M),
              triv r W (((τ_ℒ r).hom.app (Opposite.op W)) s_up) (m_ι.base y_up) i =
                ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
                  (triv (r + 1) W s_up y_up i)) ∧
    (∀ r : ℕ,
      let C₀_r := integralClosure (Polynomial F) (L_fld r)
      let A_inf_r := Algebra.adjoin F ({algebraMap (RatFunc F) (L_fld r) (RatFunc.X)⁻¹} : Set (L_fld r))
      let t_inf_r : ↥A_inf_r :=
        ⟨algebraMap (RatFunc F) (L_fld r) (RatFunc.X)⁻¹, Algebra.self_mem_adjoin_singleton F _⟩
      let C_inf_r := integralClosure ↥A_inf_r (L_fld r)
      (∀ (a : F), a ∈ S_aff →
        ∀ (Q : Ideal ↥C₀_r), Q.IsPrime →
          Ideal.comap (algebraMap (Polynomial F) ↥C₀_r) Q =
            Ideal.span {Polynomial.X - Polynomial.C a} →
          ∀ (σ_L : L_fld r ≃ₐ[RatFunc F] L_fld r) (σ_B : B r ≃ₐ[R₀] B r),
            (∀ x : L_fld r, IsIntegral F x → σ_L x = x) →
            (∀ b : B r, σ_L (algebraMap (B r) (L_fld r) b) =
              algebraMap (B r) (L_fld r) (σ_B b)) →
            (∀ y : ↥C₀_r,
              σ_L (y : L_fld r) - (y : L_fld r) ∈ Subtype.val '' (Q : Set ↥C₀_r)) →
            ∃ u ∈ S_gen, (ρ r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1))) ∧
      (∀ (Q_inf : Ideal ↥C_inf_r), Q_inf.IsPrime →
        Ideal.comap (algebraMap ↥A_inf_r ↥C_inf_r) Q_inf = Ideal.span {t_inf_r} →
        ∀ (σ_L : L_fld r ≃ₐ[RatFunc F] L_fld r) (σ_B : B r ≃ₐ[R₀] B r),
          (∀ x : L_fld r, IsIntegral F x → σ_L x = x) →
          (∀ b : B r, σ_L (algebraMap (B r) (L_fld r) b) =
            algebraMap (B r) (L_fld r) (σ_B b)) →
          (∀ y : ↥C_inf_r,
            σ_L (y : L_fld r) - (y : L_fld r) ∈ Subtype.val '' (Q_inf : Set ↥C_inf_r)) →
          ∃ u ∈ S_gen, (ρ r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1)))) ∧
    (e_U = D.e_U ∧
      ∃ j_B : ∀ r : ℕ,
          letI := D.hCR r; letI := D.hAR_B r
          B r →ₐ[R₀] D.B_V r,
        ∀ r : ℕ,
          letI := D.hCR r; letI := D.hCR (r + 1); letI := D.hAF_B r; letI := D.hAR_B r; letI := D.hAR_B (r + 1)
          Function.Injective (j_B r) ∧
          (∀ b : B r, D.ι_BV r (j_B r b) = j_B (r + 1) (ι_B r b)) ∧
          ∀ τ : D.B_V r ≃ₐ[R₀] D.B_V r,
            let A_adap := ((P_chg⁻¹).val.map (PadicInt.toZModPow (r + 1))) *
              (D.ρ_V r τ).val * (P_chg.val.map (PadicInt.toZModPow (r + 1)))
            (∀ (i j : Fin D.N), (M₀ ≤ i.1 ∧ j.1 < M₀) → A_adap i j = 0) ∧
            (∀ (i j : Fin D.N), (M₀ + M ≤ i.1 ∧ j.1 < M₀ + M) → A_adap i j = 0) ∧
            ((∀ x : D.B_V r, IsIntegral F x → τ x = x) →
              (∀ (i j : Fin D.N), i.1 < M₀ → j.1 < M₀ →
                A_adap i j = if i = j then 1 else 0) ∧
              (∀ (i j : Fin D.N), M₀ + M ≤ i.1 → M₀ + M ≤ j.1 →
                A_adap i j = if i = j then 1 else 0)) ∧
            ∃ σ : B r ≃ₐ[R₀] B r,
              (∀ b : B r, τ (j_B r b) = j_B r (σ b)) ∧
              ∀ (k₁ k₂ : Fin M),
                A_adap ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩ = (ρ r σ).val k₁ k₂)
noncomputable def weilCurveTrGeomCoverOver (F : Type u) [Field F]
    (B₀ : Type u) [CommRing B₀] [Algebra F B₀] :
    CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)) :=
  CategoryTheory.Over.mk
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F B₀)))

noncomputable def weilCurveTrGeomDeckHom (F : Type u) [Field F]
    (R₀ : Type u) [CommRing R₀] [Algebra (Polynomial F) R₀]
    (B₀ : Type u) [CommRing B₀] [Algebra F B₀] [Algebra (Polynomial F) B₀]
    [Algebra R₀ B₀] [IsScalarTower F (Polynomial F) B₀] [IsScalarTower (Polynomial F) R₀ B₀]
    (σ : B₀ ≃ₐ[R₀] B₀) :
    Quiver.Hom (weilGeomScheme F (weilCurveTrGeomCoverOver F B₀))
      (weilGeomScheme F (weilCurveTrGeomCoverOver F B₀)) :=
  let V_ov := weilCurveTrGeomCoverOver F B₀
  let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
  let m_σ : Quiver.Hom V_ov.left V_ov.left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)
  let hm : CategoryTheory.CategoryStruct.comp m_σ V_ov.hom = V_ov.hom :=
    (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
      (congrArg AlgebraicGeometry.Spec.map
        ((CommRingCat.ofHom_comp _ _).symm.trans
          (congrArg CommRingCat.ofHom (RingHom.ext fun c =>
            let h1 : algebraMap F B₀ c =
                algebraMap R₀ B₀ (algebraMap (Polynomial F) R₀ (algebraMap F (Polynomial F) c)) :=
              (IsScalarTower.algebraMap_apply F (Polynomial F) B₀ c).trans
                (IsScalarTower.algebraMap_apply (Polynomial F) R₀ B₀
                  (algebraMap F (Polynomial F) c))
            (congrArg σ.symm h1).trans
              ((σ.symm.commutes (algebraMap (Polynomial F) R₀ (algebraMap F (Polynomial F) c))).trans
                h1.symm)))))
  CategoryTheory.Limits.pullback.map V_ov.hom f₂ V_ov.hom f₂
    m_σ (CategoryTheory.CategoryStruct.id _) (CategoryTheory.CategoryStruct.id _)
    ((CategoryTheory.Category.comp_id _).trans hm.symm)
    ((CategoryTheory.Category.id_comp f₂).trans (CategoryTheory.Category.comp_id f₂).symm)

structure WeilCurveTrFreeComplex (m : ℕ) where
  n₀ : ℕ
  n₁ : ℕ
  n₂ : ℕ
  D₀ : Matrix (Fin n₁) (Fin n₀) (ZMod m)
  D₁ : Matrix (Fin n₂) (Fin n₁) (ZMod m)
  hD : D₁ * D₀ = 0
  Φ₀ : Matrix (Fin n₀) (Fin n₀) (ZMod m)
  Φ₁ : Matrix (Fin n₁) (Fin n₁) (ZMod m)
  Φ₂ : Matrix (Fin n₂) (Fin n₂) (ZMod m)
  hΦ₀ : D₀ * Φ₀ = Φ₁ * D₀
  hΦ₁ : D₁ * Φ₁ = Φ₂ * D₁

def weilCurveTrAltTrace {m : ℕ} (C : WeilCurveTrFreeComplex m) : ZMod m :=
  Matrix.trace C.Φ₀ - Matrix.trace C.Φ₁ + Matrix.trace C.Φ₂

def WeilCurveTrHasBoundedLatticeModel (ℓ K B : ℕ) [Fact (Nat.Prime ℓ)]
    (C : WeilCurveTrFreeComplex (ℓ ^ K))
    (b : Fin 3 → ℕ)
    (M_lat : ∀ i : Fin 3, Matrix (Fin (b i)) (Fin (b i)) (PadicInt ℓ)) : Prop :=
  let M₀ := ((M_lat 0).map (PadicInt.toZModPow K)).mulVecLin
  let M₁ := ((M_lat 1).map (PadicInt.toZModPow K)).mulVecLin
  let M₂ := ((M_lat 2).map (PadicInt.toZModPow K)).mulVecLin
  let d₀ := C.D₀.mulVecLin
  let d₁ := C.D₁.mulVecLin
  let φ₀ := C.Φ₀.mulVecLin
  let φ₁ := C.Φ₁.mulVecLin
  let φ₂ := C.Φ₂.mulVecLin
  (∃ q₀ : (Fin (b 0) → ZMod (ℓ ^ K)) →ₗ[ZMod (ℓ ^ K)] (Fin C.n₀ → ZMod (ℓ ^ K)),
    (∀ x, d₀ (q₀ x) = 0) ∧
    (∀ x, q₀ (M₀ x) = φ₀ (q₀ x)) ∧
    (∀ x, q₀ x = 0 → (ℓ ^ B : ℕ) • x = 0) ∧
    (∀ y, d₀ y = 0 → ∃ x, q₀ x = (ℓ ^ B : ℕ) • y)) ∧
  (∃ q₁ : (Fin (b 1) → ZMod (ℓ ^ K)) →ₗ[ZMod (ℓ ^ K)] (Fin C.n₁ → ZMod (ℓ ^ K)),
    (∀ x, d₁ (q₁ x) = 0) ∧
    (∀ x, q₁ (M₁ x) - φ₁ (q₁ x) ∈ LinearMap.range d₀) ∧
    (∀ x, q₁ x ∈ LinearMap.range d₀ → (ℓ ^ B : ℕ) • x = 0) ∧
    (∀ y, d₁ y = 0 → ∃ x, (ℓ ^ B : ℕ) • y - q₁ x ∈ LinearMap.range d₀)) ∧
  (∃ q₂ : (Fin (b 2) → ZMod (ℓ ^ K)) →ₗ[ZMod (ℓ ^ K)] (Fin C.n₂ → ZMod (ℓ ^ K)),
    (∀ x, q₂ (M₂ x) - φ₂ (q₂ x) ∈ LinearMap.range d₁) ∧
    (∀ x, q₂ x ∈ LinearMap.range d₁ → (ℓ ^ B : ℕ) • x = 0) ∧
    (∀ y : Fin C.n₂ → ZMod (ℓ ^ K), ∃ x, (ℓ ^ B : ℕ) • y - q₂ x ∈ LinearMap.range d₁))

structure WeilCurveTrGroupComplex (Γ : Type u) [Group Γ] (m : ℕ) where
  M₀ : Type u
  M₁ : Type u
  M₂ : Type u
  [add₀ : AddCommGroup M₀]
  [add₁ : AddCommGroup M₁]
  [add₂ : AddCommGroup M₂]
  [mod₀ : Module (MonoidAlgebra (ZMod m) Γ) M₀]
  [mod₁ : Module (MonoidAlgebra (ZMod m) Γ) M₁]
  [mod₂ : Module (MonoidAlgebra (ZMod m) Γ) M₂]
  δ₀ : M₀ →ₗ[MonoidAlgebra (ZMod m) Γ] M₁
  δ₁ : M₁ →ₗ[MonoidAlgebra (ZMod m) Γ] M₂
  hδ : δ₁.comp δ₀ = 0
  Φ₀ : M₀ →ₗ[MonoidAlgebra (ZMod m) Γ] M₀
  Φ₁ : M₁ →ₗ[MonoidAlgebra (ZMod m) Γ] M₁
  Φ₂ : M₂ →ₗ[MonoidAlgebra (ZMod m) Γ] M₂
  hΦ₀ : δ₀.comp Φ₀ = Φ₁.comp δ₀
  hΦ₁ : δ₁.comp Φ₁ = Φ₂.comp δ₁

instance instAddCommGroupWeilCurveTrGroupComplexM₀ {Γ : Type u} [Group Γ] {m : ℕ}
    (M : WeilCurveTrGroupComplex Γ m) : AddCommGroup M.M₀ :=
  M.add₀

instance instAddCommGroupWeilCurveTrGroupComplexM₁ {Γ : Type u} [Group Γ] {m : ℕ}
    (M : WeilCurveTrGroupComplex Γ m) : AddCommGroup M.M₁ :=
  M.add₁

instance instAddCommGroupWeilCurveTrGroupComplexM₂ {Γ : Type u} [Group Γ] {m : ℕ}
    (M : WeilCurveTrGroupComplex Γ m) : AddCommGroup M.M₂ :=
  M.add₂

instance instModuleWeilCurveTrGroupComplexM₀ {Γ : Type u} [Group Γ] {m : ℕ}
    (M : WeilCurveTrGroupComplex Γ m) : Module (MonoidAlgebra (ZMod m) Γ) M.M₀ :=
  M.mod₀

instance instModuleWeilCurveTrGroupComplexM₁ {Γ : Type u} [Group Γ] {m : ℕ}
    (M : WeilCurveTrGroupComplex Γ m) : Module (MonoidAlgebra (ZMod m) Γ) M.M₁ :=
  M.mod₁

instance instModuleWeilCurveTrGroupComplexM₂ {Γ : Type u} [Group Γ] {m : ℕ}
    (M : WeilCurveTrGroupComplex Γ m) : Module (MonoidAlgebra (ZMod m) Γ) M.M₂ :=
  M.mod₂

def WeilCurveTrIsEqFlat (Γ : Type u) [Group Γ] (m : ℕ)
    (X : Type u) [AddCommGroup X] [Module (MonoidAlgebra (ZMod m) Γ) X] : Prop :=
  let R := MonoidAlgebra (ZMod m) Γ
  ∀ (a b c : ℕ) (B : Fin c → Fin b → R) (A : Fin b → Fin a → R),
    (∀ u : Fin b → R,
      (∀ i : Fin a, ∑ j : Fin b, A j i * u j = 0) ↔
      ∃ w : Fin c → R, ∀ j : Fin b, u j = ∑ k : Fin c, B k j * w k) →
    ∀ x : Fin b → X,
      (∀ i : Fin a, ∑ j : Fin b, A j i • x j = 0) ↔
      ∃ z : Fin c → X, ∀ j : Fin b, x j = ∑ k : Fin c, B k j • z k

def WeilCurveTrHasGroupCohomLatticeModel {Γ : Type u} [Group Γ] (ℓ K B : ℕ) [Fact (Nat.Prime ℓ)]
    (M : WeilCurveTrGroupComplex Γ (ℓ ^ K))
    (σ : Γ)
    (b : Fin 3 → ℕ)
    (M_lat : ∀ i : Fin 3, Matrix (Fin (b i)) (Fin (b i)) (PadicInt ℓ)) : Prop :=
  let g_σ : MonoidAlgebra (ZMod (ℓ ^ K)) Γ :=
    MonoidAlgebra.single σ (1 : ZMod (ℓ ^ K))
  let s_scalar : ZMod (ℓ ^ K) → MonoidAlgebra (ZMod (ℓ ^ K)) Γ :=
    fun c => MonoidAlgebra.single (1 : Γ) c
  let M₀ := ((M_lat 0).map (PadicInt.toZModPow K)).mulVecLin
  let M₁ := ((M_lat 1).map (PadicInt.toZModPow K)).mulVecLin
  let M₂ := ((M_lat 2).map (PadicInt.toZModPow K)).mulVecLin
  (∃ q₀ : (Fin (b 0) → ZMod (ℓ ^ K)) →+ M.M₀,
    (∀ (c : ZMod (ℓ ^ K)) x, q₀ (c • x) = s_scalar c • q₀ x) ∧
    (∀ x, M.δ₀ (q₀ x) = 0) ∧
    (∀ x, q₀ (M₀ x) = g_σ • M.Φ₀ (q₀ x)) ∧
    (∀ x, q₀ x = 0 → (ℓ ^ B : ℕ) • x = 0) ∧
    (∀ y : M.M₀, M.δ₀ y = 0 → ∃ x, q₀ x = (ℓ ^ B : ℕ) • y)) ∧
  (∃ q₁ : (Fin (b 1) → ZMod (ℓ ^ K)) →+ M.M₁,
    (∀ (c : ZMod (ℓ ^ K)) x, q₁ (c • x) = s_scalar c • q₁ x) ∧
    (∀ x, M.δ₁ (q₁ x) = 0) ∧
    (∀ x, ∃ z : M.M₀, q₁ (M₁ x) - g_σ • M.Φ₁ (q₁ x) = M.δ₀ z) ∧
    (∀ x, (∃ z : M.M₀, q₁ x = M.δ₀ z) → (ℓ ^ B : ℕ) • x = 0) ∧
    (∀ y : M.M₁, M.δ₁ y = 0 → ∃ x, ∃ z : M.M₀, (ℓ ^ B : ℕ) • y - q₁ x = M.δ₀ z)) ∧
  (∃ q₂ : (Fin (b 2) → ZMod (ℓ ^ K)) →+ M.M₂,
    (∀ (c : ZMod (ℓ ^ K)) x, q₂ (c • x) = s_scalar c • q₂ x) ∧
    (∀ x, ∃ z : M.M₁, q₂ (M₂ x) - g_σ • M.Φ₂ (q₂ x) = M.δ₁ z) ∧
    (∀ x, (∃ z : M.M₁, q₂ x = M.δ₁ z) → (ℓ ^ B : ℕ) • x = 0) ∧
    (∀ y : M.M₂, ∃ x, ∃ z : M.M₁, (ℓ ^ B : ℕ) • y - q₂ x = M.δ₁ z))

def WeilCurveTrHasRepInvBridge {Γ : Type u} [Group Γ] (ℓ N s K : ℕ)
    (hsK : s + 1 ≤ K)
    (τ_rep : Γ →* (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (s + 1))))ˣ)
    (F_K : WeilCurveTrFreeComplex (ℓ ^ K))
    (M : WeilCurveTrGroupComplex Γ (ℓ ^ K)) : Prop :=
  let cast_s := ZMod.castHom (pow_dvd_pow ℓ hsK) (ZMod (ℓ ^ (s + 1)))
  let R_K := MonoidAlgebra (ZMod (ℓ ^ K)) Γ
  let s_scalar : ZMod (ℓ ^ K) → R_K := fun c => MonoidAlgebra.single (1 : Γ) c
  let d₀_bar := ((F_K.D₀).map cast_s).mulVecLin
  let d₁_bar := ((F_K.D₁).map cast_s).mulVecLin
  let φ₀_bar := ((F_K.Φ₀).map cast_s).mulVecLin
  let φ₁_bar := ((F_K.Φ₁).map cast_s).mulVecLin
  let φ₂_bar := ((F_K.Φ₂).map cast_s).mulVecLin
  ∃ (I₀ I₁ I₂ : Type u)
    (_ : AddCommGroup I₀) (_ : AddCommGroup I₁) (_ : AddCommGroup I₂)
    (_ : Module (ZMod (ℓ ^ (s + 1))) I₀)
    (_ : Module (ZMod (ℓ ^ (s + 1))) I₁)
    (_ : Module (ZMod (ℓ ^ (s + 1))) I₂)
    (δI₀ : I₀ →ₗ[ZMod (ℓ ^ (s + 1))] I₁)
    (δI₁ : I₁ →ₗ[ZMod (ℓ ^ (s + 1))] I₂)
    (ψ₀ : I₀ →ₗ[ZMod (ℓ ^ (s + 1))] I₀)
    (ψ₁ : I₁ →ₗ[ZMod (ℓ ^ (s + 1))] I₁)
    (ψ₂ : I₂ →ₗ[ZMod (ℓ ^ (s + 1))] I₂)
    (q_M₀ : (Fin N → M.M₀) →+ I₀)
    (q_M₁ : (Fin N → M.M₁) →+ I₁)
    (q_M₂ : (Fin N → M.M₂) →+ I₂)
    (γ_F₀ : (Fin F_K.n₀ → ZMod (ℓ ^ (s + 1))) →ₗ[ZMod (ℓ ^ (s + 1))] I₀)
    (γ_F₁ : (Fin F_K.n₁ → ZMod (ℓ ^ (s + 1))) →ₗ[ZMod (ℓ ^ (s + 1))] I₁)
    (γ_F₂ : (Fin F_K.n₂ → ZMod (ℓ ^ (s + 1))) →ₗ[ZMod (ℓ ^ (s + 1))] I₂),
    δI₁.comp δI₀ = 0 ∧
    δI₀.comp ψ₀ = ψ₁.comp δI₀ ∧
    δI₁.comp ψ₁ = ψ₂.comp δI₁ ∧
    Function.Surjective q_M₀ ∧ Function.Surjective q_M₁ ∧ Function.Surjective q_M₂ ∧
    (∀ v : Fin N → M.M₀, δI₀ (q_M₀ v) = q_M₁ (fun i => M.δ₀ (v i))) ∧
    (∀ v : Fin N → M.M₁, δI₁ (q_M₁ v) = q_M₂ (fun i => M.δ₁ (v i))) ∧
    (∀ v : Fin N → M.M₀, ψ₀ (q_M₀ v) = q_M₀ (fun i => M.Φ₀ (v i))) ∧
    (∀ v : Fin N → M.M₁, ψ₁ (q_M₁ v) = q_M₁ (fun i => M.Φ₁ (v i))) ∧
    (∀ v : Fin N → M.M₂, ψ₂ (q_M₂ v) = q_M₂ (fun i => M.Φ₂ (v i))) ∧
    (∀ (c : ZMod (ℓ ^ K)) (v : Fin N → M.M₀),
      q_M₀ (fun i => s_scalar c • v i) = cast_s c • q_M₀ v) ∧
    (∀ (c : ZMod (ℓ ^ K)) (v : Fin N → M.M₁),
      q_M₁ (fun i => s_scalar c • v i) = cast_s c • q_M₁ v) ∧
    (∀ (c : ZMod (ℓ ^ K)) (v : Fin N → M.M₂),
      q_M₂ (fun i => s_scalar c • v i) = cast_s c • q_M₂ v) ∧
    (let Rel {X : Type u} [AddCommGroup X] [Module R_K X] : AddSubgroup (Fin N → X) :=
       AddSubgroup.closure (
         { u | ∃ w : Fin N → X, u = (ℓ ^ (s + 1) : ℕ) • w } ∪
         { u | ∃ (g : Γ) (w : Fin N → X),
           u = (fun i => (MonoidAlgebra.single g (1 : ZMod (ℓ ^ K)) : R_K) • w i) -
             (fun i => ∑ j : Fin N,
               s_scalar (((τ_rep g⁻¹).val i j).val : ZMod (ℓ ^ K)) • w j) })
     q_M₀.ker = Rel ∧ q_M₁.ker = Rel ∧ q_M₂.ker = Rel) ∧
    δI₀.comp γ_F₀ = γ_F₁.comp d₀_bar ∧
    δI₁.comp γ_F₁ = γ_F₂.comp d₁_bar ∧
    ψ₀.comp γ_F₀ = γ_F₀.comp φ₀_bar ∧
    ψ₁.comp γ_F₁ = γ_F₁.comp φ₁_bar ∧
    ψ₂.comp γ_F₂ = γ_F₂.comp φ₂_bar ∧
    (∀ x, d₀_bar x = 0 → γ_F₀ x = 0 → x = 0) ∧
    (∀ y : I₀, δI₀ y = 0 → ∃ x, d₀_bar x = 0 ∧ γ_F₀ x = y) ∧
    (∀ x, d₁_bar x = 0 → (∃ z, γ_F₁ x = δI₀ z) → x ∈ LinearMap.range d₀_bar) ∧
    (∀ y : I₁, δI₁ y = 0 → ∃ x, d₁_bar x = 0 ∧ ∃ z, y - γ_F₁ x = δI₀ z) ∧
    (∀ x, (∃ z, γ_F₂ x = δI₁ z) → x ∈ LinearMap.range d₁_bar) ∧
    (∀ y : I₂, ∃ x, ∃ z, y - γ_F₂ x = δI₁ z)

def WeilCurveTrGeomCoverZeroExt.{u} (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B₀ : Type u) [CommRing B₀] [Algebra F B₀] [Algebra (Polynomial F) B₀]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [IsScalarTower F (Polynomial F) B₀]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
