structure WeilGysinSupportClass (Z Y : AlgebraicGeometry.Scheme.{u})
    (i : Quiver.Hom Z Y) (m q : ℕ) : Type u where
  hCont :
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor Y.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
    B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology
  val :
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor Y.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
    letI := hCont
    let R := ULift.{u, 0} (ZMod m)
    let i_push := B.sheafPushforwardContinuous (ModuleCat.{u, u} R) Y.smallEtaleTopology Z.smallEtaleTopology
    let One_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)).obj (ModuleCat.of R R)
    let One_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)).obj (ModuleCat.of R R)
    CategoryTheory.Abelian.Ext.{u} (i_push.obj One_Z) One_Y q

noncomputable abbrev weilGysinSupportExtGroup {Z Y : AlgebraicGeometry.Scheme.{u}}
    {i : Quiver.Hom Z Y} {m q : ℕ}
    (τ₀ : WeilGysinSupportClass Z Y i m q) : Type u :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor Y.Etale Z.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
  letI := τ₀.hCont
  let R := ULift.{u, 0} (ZMod m)
  let i_push := B.sheafPushforwardContinuous (ModuleCat.{u, u} R) Y.smallEtaleTopology Z.smallEtaleTopology
  let One_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)).obj (ModuleCat.of R R)
  let One_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)).obj (ModuleCat.of R R)
  CategoryTheory.Abelian.Ext.{u} (i_push.obj One_Z) One_Y q

def WeilGysinForgetsTo {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y} {m q : ℕ}
    (τ : WeilGysinSupportClass Z Y i m q) (cl : weilEtaleTorsionH Y m q) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let R := ULift.{u, 0} (ZMod m)
  let J_Y := Y.smallEtaleTopology
  let J_Z := Z.smallEtaleTopology
  let R_mod := ModuleCat.of R R
  let C_Y := CategoryTheory.constantSheaf J_Y (ModuleCat.{u, u} R)
  let C_Z := CategoryTheory.constantSheaf J_Z (ModuleCat.{u, u} R)
  let One_Y := C_Y.obj R_mod
  let One_Z := C_Z.obj R_mod
  let B_i : CategoryTheory.Functor Y.Etale Z.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
  letI := τ.hCont
  let i_push := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R) J_Y J_Z
  let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let C_ab := CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}
  let Fℤ := C_ab.obj Aℤ
  let FM := C_ab.obj AM
  let ιM : Quiver.Hom AM (F_fg.obj R_mod) := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let z_to_m : Quiver.Hom Aℤ AM :=
    AddCommGrpCat.ofHom
      { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod m)
        map_zero' := congrArg ULift.up Int.cast_zero
        map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }
  ∃ (U : CategoryTheory.Functor
      (CategoryTheory.Sheaf J_Y (ModuleCat.{u, u} R))
      (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})),
    (∀ ℱ : CategoryTheory.Sheaf J_Y (ModuleCat.{u, u} R),
      (U.obj ℱ).obj = CategoryTheory.Functor.comp ℱ.obj F_fg) ∧
    (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J_Y (ModuleCat.{u, u} R)} (u : Quiver.Hom ℱ₁ ℱ₂)
      (V : Opposite Y.Etale),
      HEq ((U.map u).hom.app V) (F_fg.map (u.hom.app V))) ∧
    ∃ (hAdd : U.Additive) (hLim : CategoryTheory.Limits.PreservesFiniteLimits U)
      (hColim : CategoryTheory.Limits.PreservesFiniteColimits U)
      (T_Y : Y.Etale) (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
      (T_Z : Z.Etale) (hT_Z : CategoryTheory.Limits.IsTerminal T_Z),
      letI := hAdd
      letI := hLim
      letI := hColim
      let adj_ab := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT_Y
      let adj_Y := CategoryTheory.constantSheafAdj J_Y (ModuleCat.{u, u} R) hT_Y
      let adj_Z := CategoryTheory.constantSheafAdj J_Z (ModuleCat.{u, u} R) hT_Z
      let τ_i : Quiver.Hom (B_i.obj T_Y) T_Z := hT_Z.from (B_i.obj T_Y)
      let q_i : Quiver.Hom One_Y (i_push.obj One_Z) :=
        (adj_Y.homEquiv R_mod (i_push.obj One_Z)).symm
          (CategoryTheory.CategoryStruct.comp (adj_Z.unit.app R_mod) (One_Z.obj.map τ_i.op))
      ∃ (u_unit : Quiver.Hom (F_fg.obj R_mod) ((U.obj One_Y).obj.obj (Opposite.op T_Y))),
        HEq u_unit (F_fg.map (adj_Y.unit.app R_mod)) ∧
        let αM : Quiver.Hom FM (U.obj One_Y) :=
          (adj_ab.homEquiv AM (U.obj One_Y)).symm
            (CategoryTheory.CategoryStruct.comp ιM u_unit)
        let ιℤ : Quiver.Hom Fℤ (U.obj One_Y) :=
          CategoryTheory.CategoryStruct.comp (C_ab.map z_to_m) αM
        ∃ (πM : Quiver.Hom (U.obj One_Y) FM),
          CategoryTheory.CategoryStruct.comp αM πM = CategoryTheory.CategoryStruct.id FM ∧
          CategoryTheory.CategoryStruct.comp πM αM = CategoryTheory.CategoryStruct.id (U.obj One_Y) ∧
          cl = (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ (Nat.add_zero q)
            ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U _ _ _ _ _ One_Y One_Y q)
                ((CategoryTheory.Abelian.Ext.mk₀ q_i).comp τ.val (Nat.zero_add q)))
              (Nat.zero_add q))

def WeilGysinSupportPullback {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
    (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y) (m q : ℕ)
    (τ' : WeilGysinSupportClass Z' Y' i' m q)
    (τ : WeilGysinSupportClass Z Y i m q) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i' :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i' :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let R := ULift.{u, 0} (ZMod m)
  let R_mod := ModuleCat.of R R
  let B_i : CategoryTheory.Functor Y.Etale Z.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
  let B_i' : CategoryTheory.Functor Y'.Etale Z'.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i'
  let B_g : CategoryTheory.Functor Y.Etale Y'.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
  letI := τ.hCont
  letI := τ'.hCont
  let i_push := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R) Y.smallEtaleTopology Z.smallEtaleTopology
  let i'_push := B_i'.sheafPushforwardContinuous (ModuleCat.{u, u} R) Y'.smallEtaleTopology Z'.smallEtaleTopology
  let One_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)).obj R_mod
  let One_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)).obj R_mod
  let One_Y' := (CategoryTheory.constantSheaf Y'.smallEtaleTopology (ModuleCat.{u, u} R)).obj R_mod
  let One_Z' := (CategoryTheory.constantSheaf Z'.smallEtaleTopology (ModuleCat.{u, u} R)).obj R_mod
  ∃ (hCont_g : B_g.IsContinuous Y.smallEtaleTopology Y'.smallEtaleTopology),
    letI := hCont_g
    let g_push := B_g.sheafPushforwardContinuous (ModuleCat.{u, u} R) Y.smallEtaleTopology Y'.smallEtaleTopology
    ∃ (P_pull : CategoryTheory.Functor
        (CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R))
        (CategoryTheory.Sheaf Y'.smallEtaleTopology (ModuleCat.{u, u} R)))
      (adj_pull : CategoryTheory.Adjunction P_pull g_push)
      (hAdd : P_pull.Additive)
      (hLim : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
      (hColim : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
      (T_Y : Y.Etale) (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
      (T_Z : Z.Etale) (hT_Z : CategoryTheory.Limits.IsTerminal T_Z)
      (T_Y' : Y'.Etale) (hT_Y' : CategoryTheory.Limits.IsTerminal T_Y')
      (T_Z' : Z'.Etale) (hT_Z' : CategoryTheory.Limits.IsTerminal T_Z'),
      letI := hAdd
      letI := hLim
      letI := hColim
      let adj_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology (ModuleCat.{u, u} R) hT_Y
      let adj_Z := CategoryTheory.constantSheafAdj Z.smallEtaleTopology (ModuleCat.{u, u} R) hT_Z
      let adj_Y' := CategoryTheory.constantSheafAdj Y'.smallEtaleTopology (ModuleCat.{u, u} R) hT_Y'
      let adj_Z' := CategoryTheory.constantSheafAdj Z'.smallEtaleTopology (ModuleCat.{u, u} R) hT_Z'
      let τ_i : Quiver.Hom (B_i.obj T_Y) T_Z := hT_Z.from (B_i.obj T_Y)
      let τ_i' : Quiver.Hom (B_i'.obj T_Y') T_Z' := hT_Z'.from (B_i'.obj T_Y')
      let τ_g : Quiver.Hom (B_g.obj T_Y) T_Y' := hT_Y'.from (B_g.obj T_Y)
      let q_i : Quiver.Hom One_Y (i_push.obj One_Z) :=
        (adj_Y.homEquiv R_mod (i_push.obj One_Z)).symm
          (CategoryTheory.CategoryStruct.comp (adj_Z.unit.app R_mod) (One_Z.obj.map τ_i.op))
      let q_i' : Quiver.Hom One_Y' (i'_push.obj One_Z') :=
        (adj_Y'.homEquiv R_mod (i'_push.obj One_Z')).symm
          (CategoryTheory.CategoryStruct.comp (adj_Z'.unit.app R_mod) (One_Z'.obj.map τ_i'.op))
      let π_Y : Quiver.Hom (P_pull.obj One_Y) One_Y' :=
        (adj_pull.homEquiv One_Y One_Y').symm
          ((adj_Y.homEquiv R_mod (g_push.obj One_Y')).symm
            (CategoryTheory.CategoryStruct.comp (adj_Y'.unit.app R_mod) (One_Y'.obj.map τ_g.op)))
      ∃ (ι_Y : Quiver.Hom One_Y' (P_pull.obj One_Y))
        (β : Quiver.Hom (i'_push.obj One_Z') (P_pull.obj (i_push.obj One_Z))),
        CategoryTheory.CategoryStruct.comp ι_Y π_Y = CategoryTheory.CategoryStruct.id One_Y' ∧
        CategoryTheory.CategoryStruct.comp π_Y ι_Y = CategoryTheory.CategoryStruct.id (P_pull.obj One_Y) ∧
        CategoryTheory.CategoryStruct.comp q_i' β =
          CategoryTheory.CategoryStruct.comp ι_Y (P_pull.map q_i) ∧
        τ'.val = (CategoryTheory.Abelian.Ext.mk₀ π_Y).postcomp (i'_push.obj One_Z') (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ β).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull _ _ _ _ _
              (i_push.obj One_Z) One_Y q) τ.val)
            (Nat.zero_add q))

def WeilGysinSupportGysinComp {S Z Y : AlgebraicGeometry.Scheme.{u}}
    {s : Quiver.Hom S Z} {i : Quiver.Hom Z Y} {si : Quiver.Hom S Y}
    (_hsi : CategoryTheory.CategoryStruct.comp s i = si)
    {m a b c : ℕ} (hab : a + b = c)
    (τ_Z : WeilGysinSupportClass S Z s m a)
    (τ_Y : WeilGysinSupportClass Z Y i m b)
    (τ_SY : WeilGysinSupportClass S Y si m c) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) s :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) s :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) si :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) si :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let R := ULift.{u, 0} (ZMod m)
  let R_mod := ModuleCat.of R R
  let B_s : CategoryTheory.Functor Z.Etale S.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ s
  let B_i : CategoryTheory.Functor Y.Etale Z.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
  let B_si : CategoryTheory.Functor Y.Etale S.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ si
  letI := τ_Z.hCont
  letI := τ_Y.hCont
  letI := τ_SY.hCont
  let s_push := B_s.sheafPushforwardContinuous (ModuleCat.{u, u} R) Z.smallEtaleTopology S.smallEtaleTopology
  let i_push := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R) Y.smallEtaleTopology Z.smallEtaleTopology
  let si_push := B_si.sheafPushforwardContinuous (ModuleCat.{u, u} R) Y.smallEtaleTopology S.smallEtaleTopology
  let One_S := (CategoryTheory.constantSheaf S.smallEtaleTopology (ModuleCat.{u, u} R)).obj R_mod
  let One_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)).obj R_mod
  let One_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)).obj R_mod
  ∃ (hAdd : i_push.Additive)
    (hLim : CategoryTheory.Limits.PreservesFiniteLimits i_push)
    (hColim : CategoryTheory.Limits.PreservesFiniteColimits i_push)
    (T_S : S.Etale) (hT_S : CategoryTheory.Limits.IsTerminal T_S)
    (T_Z : Z.Etale) (hT_Z : CategoryTheory.Limits.IsTerminal T_Z)
    (T_Y : Y.Etale) (hT_Y : CategoryTheory.Limits.IsTerminal T_Y),
    letI := hAdd
    letI := hLim
    letI := hColim
    let adj_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology (ModuleCat.{u, u} R) hT_S
    let adj_Z := CategoryTheory.constantSheafAdj Z.smallEtaleTopology (ModuleCat.{u, u} R) hT_Z
    let adj_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology (ModuleCat.{u, u} R) hT_Y
    let τ_s : Quiver.Hom (B_s.obj T_Z) T_S := hT_S.from (B_s.obj T_Z)
    let τ_i : Quiver.Hom (B_i.obj T_Y) T_Z := hT_Z.from (B_i.obj T_Y)
    let τ_si : Quiver.Hom (B_si.obj T_Y) T_S := hT_S.from (B_si.obj T_Y)
    let q_s : Quiver.Hom One_Z (s_push.obj One_S) :=
      (adj_Z.homEquiv R_mod (s_push.obj One_S)).symm
        (CategoryTheory.CategoryStruct.comp (adj_S.unit.app R_mod) (One_S.obj.map τ_s.op))
    let q_i : Quiver.Hom One_Y (i_push.obj One_Z) :=
      (adj_Y.homEquiv R_mod (i_push.obj One_Z)).symm
        (CategoryTheory.CategoryStruct.comp (adj_Z.unit.app R_mod) (One_Z.obj.map τ_i.op))
    let q_si : Quiver.Hom One_Y (si_push.obj One_S) :=
      (adj_Y.homEquiv R_mod (si_push.obj One_S)).symm
        (CategoryTheory.CategoryStruct.comp (adj_S.unit.app R_mod) (One_S.obj.map τ_si.op))
    ∃ (α_push : Quiver.Hom (si_push.obj One_S) (i_push.obj (s_push.obj One_S)))
      (β_push : Quiver.Hom (i_push.obj (s_push.obj One_S)) (si_push.obj One_S)),
      CategoryTheory.CategoryStruct.comp α_push β_push =
        CategoryTheory.CategoryStruct.id (si_push.obj One_S) ∧
      CategoryTheory.CategoryStruct.comp β_push α_push =
        CategoryTheory.CategoryStruct.id (i_push.obj (s_push.obj One_S)) ∧
      CategoryTheory.CategoryStruct.comp q_si α_push =
        CategoryTheory.CategoryStruct.comp q_i (i_push.map q_s) ∧
      τ_SY.val =
        ((CategoryTheory.Abelian.Ext.mk₀ α_push).comp
          ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ i_push _ _ _ _ _
            (s_push.obj One_S) One_Z a) τ_Z.val)
          (Nat.zero_add a)).comp τ_Y.val hab

def WeilGysinIsEtaleOriginChart {k : Type u} [Field k] (c : ℕ)
    {Y : AlgebraicGeometry.Scheme.{u}}
    (p_Y : Quiver.Hom Y (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) Y)
    (U : Y.Opens)
    (s_U : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) U.toScheme)
    (u : Quiver.Hom U.toScheme (weilGysinAffineSpace k c)) : Prop :=
  AlgebraicGeometry.Etale u ∧
  CategoryTheory.CategoryStruct.comp u (weilGysinAffineStruct k c) =
    CategoryTheory.CategoryStruct.comp U.ι p_Y ∧
  CategoryTheory.CategoryStruct.comp s_U U.ι = s ∧
  CategoryTheory.IsPullback s_U
    (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    u (weilGysinAffineOrigin k c)

def WeilGysinIsPointClass {k : Type u} [Field k] {c m : ℕ}
    (τ_c : WeilGysinSupportClass (AlgebraicGeometry.Spec (CommRingCat.of k))
      (weilGysinAffineSpace k c) (weilGysinAffineOrigin k c) m (2 * c))
    (Y : AlgebraicGeometry.Scheme.{u})
    (p_Y : Quiver.Hom Y (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) Y)
    (cl : weilEtaleTorsionH Y m (2 * c)) : Prop :=
  ∃ (U : Y.Opens)
    (s_U : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) U.toScheme)
    (u : Quiver.Hom U.toScheme (weilGysinAffineSpace k c))
    (_ : WeilGysinIsEtaleOriginChart c p_Y s U s_U u)
    (τ_Y : WeilGysinSupportClass (AlgebraicGeometry.Spec (CommRingCat.of k)) Y s m (2 * c))
    (τ_U : WeilGysinSupportClass (AlgebraicGeometry.Spec (CommRingCat.of k)) U.toScheme s_U m (2 * c)),
    WeilGysinSupportPullback U.ι s_U s m (2 * c) τ_U τ_Y ∧
    WeilGysinSupportPullback u s_U (weilGysinAffineOrigin k c) m (2 * c) τ_U τ_c ∧
    WeilGysinForgetsTo τ_Y cl

def WeilGysinIsTubularGraphChart {k : Type u} [Field k] (d : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Γ_φ : Quiver.Hom X.left (CategoryTheory.Limits.pullback X.hom X.hom))
    (U_x : X.left.Opens)
    (V_x : (CategoryTheory.Limits.pullback X.hom X.hom).Opens)
    (γ_x : Quiver.Hom U_x.toScheme V_x.toScheme)
    (p₁_Vx : Quiver.Hom V_x.toScheme U_x.toScheme)
    (u_x : Quiver.Hom U_x.toScheme (weilGysinAffineSpace k d))
    (v_x : Quiver.Hom V_x.toScheme (weilGysinAffineSpace k d))
    (Ψ_x : Quiver.Hom V_x.toScheme (weilGysinAffineSpace k (2 * d))) : Prop :=
  let P := CategoryTheory.Limits.pullback X.hom X.hom
  let p₁ := CategoryTheory.Limits.pullback.fst X.hom X.hom
  let p_P := CategoryTheory.CategoryStruct.comp p₁ X.hom
  Γ_φ.base ⁻¹' (V_x : Set P) = (U_x : Set X.left) ∧
  CategoryTheory.CategoryStruct.comp γ_x V_x.ι =
    CategoryTheory.CategoryStruct.comp U_x.ι Γ_φ ∧
  CategoryTheory.CategoryStruct.comp p₁_Vx U_x.ι =
    CategoryTheory.CategoryStruct.comp V_x.ι p₁ ∧
  AlgebraicGeometry.Etale u_x ∧
  CategoryTheory.CategoryStruct.comp u_x (weilGysinAffineStruct k d) =
    CategoryTheory.CategoryStruct.comp U_x.ι X.hom ∧
  AlgebraicGeometry.SmoothOfRelativeDimension d v_x ∧
  CategoryTheory.CategoryStruct.comp v_x (weilGysinAffineStruct k d) =
    CategoryTheory.CategoryStruct.comp V_x.ι p_P ∧
  AlgebraicGeometry.Etale Ψ_x ∧
  CategoryTheory.CategoryStruct.comp Ψ_x (weilGysinAffineStruct k (2 * d)) =
    CategoryTheory.CategoryStruct.comp V_x.ι p_P ∧
  CategoryTheory.IsPullback γ_x
    (CategoryTheory.CategoryStruct.comp U_x.ι X.hom)
    v_x (weilGysinAffineOrigin k d) ∧
  CategoryTheory.CategoryStruct.comp Ψ_x
    (weilGysinAffineProjLeft k d d (2 * d) (Nat.two_mul d).symm) =
    CategoryTheory.CategoryStruct.comp p₁_Vx u_x ∧
  CategoryTheory.CategoryStruct.comp Ψ_x
    (weilGysinAffineProjRight k d d (2 * d) (Nat.two_mul d).symm) = v_x ∧
  CategoryTheory.CategoryStruct.comp γ_x Ψ_x =
    CategoryTheory.CategoryStruct.comp u_x
      (weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm)

def WeilGysinIsAffineOriginThomTower (k : Type u) [Field k] (ℓ : ℕ)
    (τ : ∀ (c r : ℕ), WeilGysinSupportClass
      (AlgebraicGeometry.Spec (CommRingCat.of k))
      (weilGysinAffineSpace k c) (weilGysinAffineOrigin k c) (ℓ ^ r) (2 * c)) : Prop :=
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  (∀ (c : ℕ) (Y : AlgebraicGeometry.Scheme.{u})
      (p_Y : Quiver.Hom Y S_k) [AlgebraicGeometry.IsSeparated p_Y]
      (s : Quiver.Hom S_k Y),
    CategoryTheory.CategoryStruct.comp s p_Y = CategoryTheory.CategoryStruct.id S_k →
    (∀ (U : Y.Opens) (s_U : Quiver.Hom S_k U.toScheme)
        (u : Quiver.Hom U.toScheme (weilGysinAffineSpace k c)),
      WeilGysinIsEtaleOriginChart c p_Y s U s_U u →
      ∀ r : ℕ,
        ∃ (τ_Y : WeilGysinSupportClass S_k Y s (ℓ ^ r) (2 * c))
          (τ_U : WeilGysinSupportClass S_k U.toScheme s_U (ℓ ^ r) (2 * c))
          (cl : weilEtaleTorsionH Y (ℓ ^ r) (2 * c)),
          WeilGysinSupportPullback U.ι s_U s (ℓ ^ r) (2 * c) τ_U τ_Y ∧
          WeilGysinSupportPullback u s_U (weilGysinAffineOrigin k c) (ℓ ^ r) (2 * c) τ_U (τ c r) ∧
          WeilGysinForgetsTo τ_Y cl) ∧
    (∀ (r : ℕ) (cl₁ cl₂ : weilEtaleTorsionH Y (ℓ ^ r) (2 * c)),
      WeilGysinIsPointClass (τ c r) Y p_Y s cl₁ →
      WeilGysinIsPointClass (τ c r) Y p_Y s cl₂ →
      cl₁ = cl₂) ∧
    (∀ (r : ℕ) (cl_succ : weilEtaleTorsionH Y (ℓ ^ (r + 1)) (2 * c))
        (cl_curr : weilEtaleTorsionH Y (ℓ ^ r) (2 * c)),
      WeilGysinIsPointClass (τ c (r + 1)) Y p_Y s cl_succ →
      WeilGysinIsPointClass (τ c r) Y p_Y s cl_curr →
      weilEtaleTorsionTransition Y ℓ r (2 * c) cl_succ = cl_curr)) ∧
  ((∃ e₀ : ∀ r : ℕ, weilEtaleTorsionH S_k (ℓ ^ r) 0 ≃+ ZMod (ℓ ^ r),
      (∀ (r : ℕ) (u : weilEtaleTorsionH S_k (ℓ ^ (r + 1)) 0),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (e₀ (r + 1) u) =
          e₀ r (weilEtaleTorsionTransition S_k ℓ r 0 u)) ∧
      (∀ (r : ℕ) (cl₀ : weilEtaleTorsionH S_k (ℓ ^ r) 0),
        WeilGysinIsPointClass (τ 0 r) S_k
          (CategoryTheory.CategoryStruct.id S_k) (CategoryTheory.CategoryStruct.id S_k) cl₀ →
        e₀ r cl₀ = 1)) ∧
    (∀ r : ℕ, ∃ e₁ : weilGysinSupportExtGroup (τ 1 r) ≃+ ZMod (ℓ ^ r), e₁ (τ 1 r).val = 1)) ∧
  (∀ (d r : ℕ)
      (X : CategoryTheory.Over S_k)
      [AlgebraicGeometry.IsSeparated X.hom]
      [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
      (s : Quiver.Hom S_k X.left),
    CategoryTheory.CategoryStruct.comp s X.hom = CategoryTheory.CategoryStruct.id S_k →
    let P := CategoryTheory.Limits.pullback X.hom X.hom
    let p₁ := CategoryTheory.Limits.pullback.fst X.hom X.hom
    let p₂ := CategoryTheory.Limits.pullback.snd X.hom X.hom
    let Δ := CategoryTheory.Limits.pullback.diagonal X.hom
    ∀ (h4d : 2 * d + 2 * d = 2 * (2 * d))
      (cl_X : weilEtaleTorsionH X.left (ℓ ^ r) (2 * d))
      (cl_P : weilEtaleTorsionH P (ℓ ^ r) (2 * (2 * d)))
      (p₁_r p₂_r : weilEtaleTorsionH X.left (ℓ ^ r) (2 * d) →+ weilEtaleTorsionH P (ℓ ^ r) (2 * d))
      (c_P_r : weilEtaleTorsionH P (ℓ ^ r) (2 * d) →+
        weilEtaleTorsionH P (ℓ ^ r) (2 * d) →+ weilEtaleTorsionH P (ℓ ^ r) (2 * (2 * d))),
      WeilGysinIsPointClass (τ d r) X.left X.hom s cl_X →
      WeilGysinIsPointClass (τ (2 * d) r) P
        (CategoryTheory.CategoryStruct.comp p₁ X.hom)
        (CategoryTheory.CategoryStruct.comp s Δ) cl_P →
      WeilLefschetzTorsionPullback p₁ (ℓ ^ r) (2 * d) p₁_r →
      WeilLefschetzTorsionPullback p₂ (ℓ ^ r) (2 * d) p₂_r →
      WeilLefschetzIsTorsionCup P (ℓ ^ r) (2 * d) (2 * d) (2 * (2 * d)) h4d c_P_r →
      c_P_r (p₁_r cl_X) (p₂_r cl_X) = cl_P) ∧
  (∀ (a b ab : ℕ) (hab : a + b = ab) (hab2 : 2 * a + 2 * b = 2 * ab) (r : ℕ),
    ∃ (h_orig : CategoryTheory.CategoryStruct.comp
          (weilGysinAffineOrigin k a) (weilGysinAffineLeftAxis k a b ab hab) =
        weilGysinAffineOrigin k ab)
      (τ_axis : WeilGysinSupportClass (weilGysinAffineSpace k a)
        (weilGysinAffineSpace k ab) (weilGysinAffineLeftAxis k a b ab hab) (ℓ ^ r) (2 * b)),
      WeilGysinSupportPullback (weilGysinAffineProjRight k a b ab hab)
        (weilGysinAffineLeftAxis k a b ab hab) (weilGysinAffineOrigin k b)
        (ℓ ^ r) (2 * b) τ_axis (τ b r) ∧
      WeilGysinSupportGysinComp h_orig hab2 (τ a r) τ_axis (τ ab r))
noncomputable def weilEtaleCechPair {X : AlgebraicGeometry.Scheme.{u}} {W U : X.Etale} (w : W ⟶ U) :
    ℕ → Σ Z : X.Etale, Z ⟶ U
  | 0 => ⟨W, w⟩
  | p + 1 =>
    let prev := weilEtaleCechPair w p
    ⟨CategoryTheory.Limits.pullback prev.2 w,
      CategoryTheory.Limits.pullback.fst prev.2 w ≫ prev.2⟩

noncomputable abbrev weilEtaleCechObj {X : AlgebraicGeometry.Scheme.{u}} {W U : X.Etale}
    (w : W ⟶ U) (p : ℕ) : X.Etale :=
  (weilEtaleCechPair w p).1

noncomputable abbrev weilEtaleCechHom {X : AlgebraicGeometry.Scheme.{u}} {W U : X.Etale}
    (w : W ⟶ U) (p : ℕ) : weilEtaleCechObj w p ⟶ U :=
  (weilEtaleCechPair w p).2

noncomputable def weilEtaleCechProjSub {X : AlgebraicGeometry.Scheme.{u}} {W U : X.Etale} (w : W ⟶ U) :
    ∀ (p : ℕ), Fin (p + 1) → { π : weilEtaleCechObj w p ⟶ W // π ≫ w = weilEtaleCechHom w p }
  | 0 => fun _ => ⟨CategoryTheory.CategoryStruct.id W, CategoryTheory.Category.id_comp w⟩
  | p + 1 =>
    Fin.lastCases
      ⟨CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w p) w,
        CategoryTheory.Limits.pullback.condition.symm⟩
      (fun j =>
        let prev := weilEtaleCechProjSub w p j
        ⟨CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w p) w ≫ prev.1,
          (CategoryTheory.Category.assoc _ _ _).trans (congrArg _ prev.2)⟩)

noncomputable abbrev weilEtaleCechProj {X : AlgebraicGeometry.Scheme.{u}} {W U : X.Etale}
    (w : W ⟶ U) (p : ℕ) (i : Fin (p + 1)) : weilEtaleCechObj w p ⟶ W :=
  (weilEtaleCechProjSub w p i).1

noncomputable def weilEtaleCechLiftSub {X : AlgebraicGeometry.Scheme.{u}} {W U Z : X.Etale}
    (w : W ⟶ U) (h : Z ⟶ U) :
    ∀ (p : ℕ) (g : Fin (p + 1) → (Z ⟶ W)),
      (∀ i, g i ≫ w = h) → { l : Z ⟶ weilEtaleCechObj w p // l ≫ weilEtaleCechHom w p = h }
  | 0, g, hg => ⟨g 0, hg 0⟩
  | p + 1, g, hg =>
    let prev := weilEtaleCechLiftSub w h p (fun i => g i.castSucc) (fun i => hg i.castSucc)
    ⟨CategoryTheory.Limits.pullback.lift prev.1 (g (Fin.last (p + 1)))
        (prev.2.trans (hg (Fin.last (p + 1))).symm),
      (CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans prev.2⟩

noncomputable def weilEtaleCechFace {X : AlgebraicGeometry.Scheme.{u}} {W U : X.Etale}
    (w : W ⟶ U) (p : ℕ) (j : Fin (p + 2)) :
    weilEtaleCechObj w (p + 1) ⟶ weilEtaleCechObj w p :=
  (weilEtaleCechLiftSub w (weilEtaleCechHom w (p + 1)) p
    (fun i => weilEtaleCechProj w (p + 1) (j.succAbove i))
    (fun i => (weilEtaleCechProjSub w (p + 1) (j.succAbove i)).2)).1

noncomputable def weilEtaleCechDiff {X : AlgebraicGeometry.Scheme.{u}}
    (P : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})
    {W U : X.Etale} (w : W ⟶ U) (p : ℕ) :
    ↥(P.obj (Opposite.op (weilEtaleCechObj w p))) →+
      ↥(P.obj (Opposite.op (weilEtaleCechObj w (p + 1)))) :=
  Finset.univ.sum fun j : Fin (p + 2) =>
    (-1 : ℤ) ^ (j : ℕ) • (P.map (weilEtaleCechFace w p j).op).hom

noncomputable def weilEtaleKPresheaf (X : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral X] :
    CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u} :=
  letI : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
  let η_X := X.fromSpecStalk (genericPoint ↥X)
  let F_pb :=
    (AlgebraicGeometry.Scheme.Etale.forget X ⋙
      CategoryTheory.Over.pullback η_X ⋙
      CategoryTheory.Over.forget _).op
  let G_ring : CategoryTheory.Functor (Opposite AlgebraicGeometry.Scheme.{u}) CommRingCat.{u} :=
    { obj := fun Z => (Opposite.unop Z).presheaf.obj (Opposite.op ⊤)
      map := fun f => (Opposite.unop f).appTop
      map_id := fun _ => AlgebraicGeometry.Scheme.Hom.id_appTop
      map_comp := fun f g => AlgebraicGeometry.Scheme.Hom.comp_appTop (Opposite.unop g) (Opposite.unop f) }
  let U_add : CategoryTheory.Functor CommRingCat.{u} AddCommGrpCat.{u} :=
    { obj := fun R => AddCommGrpCat.of (Additive (Units ↑R))
      map := fun φ => AddCommGrpCat.ofHom (MonoidHom.toAdditive (Units.map φ.hom.toMonoidHom))
      map_id := fun _ => AddCommGrpCat.ext fun _ => rfl
      map_comp := fun _ _ => AddCommGrpCat.ext fun _ => rfl }
  F_pb ⋙ G_ring ⋙ U_add

noncomputable def weilEtaleKSheaf (X : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral X] :
    CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
  (CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
    (weilEtaleKPresheaf X)

noncomputable def weilGalUnitsRep (E L : Type u) [Field E] [Field L] [Algebra E L] :
    Rep.{u, u, u} (ULift.{u} ℤ) Gal(L/E) :=
  letI : Module (ULift.{u} ℤ) (Additive Lˣ) :=
    { smul := fun n x => n.down • x
      one_smul := fun x => one_zsmul x
      mul_smul := fun m n x => mul_zsmul x m.down n.down
      smul_zero := fun n => zsmul_zero n.down
      smul_add := fun n x y => zsmul_add x y n.down
      add_smul := fun m n x => add_zsmul x m.down n.down
      zero_smul := fun x => zero_zsmul x }
  Rep.of
    { toFun := fun σ =>
        { toAddHom := (MonoidHom.toAdditive (Units.map σ.toRingHom.toMonoidHom)).toAddHom
          map_smul' := fun n x =>
            map_zsmul (MonoidHom.toAdditive (Units.map σ.toRingHom.toMonoidHom)) n.down x }
      map_one' := LinearMap.ext fun _ => rfl
      map_mul' := fun _ _ => LinearMap.ext fun _ => rfl }
def WeilAltLerayStalkZeroOutside {S : AlgebraicGeometry.Scheme.{u}}
    (V : S.Opens)
    (F : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) : Prop :=
  ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (gy : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S),
    (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), gy.base pt ∉ V) →
    ∀ (W : S.Etale)
      (gw : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω))
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left),
      CategoryTheory.CategoryStruct.comp gw
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom = gy →
      ∀ (σ : F.obj.obj (Opposite.op W)),
        ∃ (W' : S.Etale) (u : Quiver.Hom W' W)
          (gw' : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω))
            ((AlgebraicGeometry.Scheme.Etale.forget S).obj W').left),
          CategoryTheory.CategoryStruct.comp gw'
            ((AlgebraicGeometry.Scheme.Etale.forget S).map u).left = gw ∧
          F.obj.map (Opposite.op u) σ = 0
def WeilEtalePushforwardPreservesEpi {X' S' : AlgebraicGeometry.Scheme.{u}}
    (f' : Quiver.Hom X' S') : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f' :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f' :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_f' : CategoryTheory.Functor S'.Etale X'.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f'
  ∃ (_ : B_f'.IsContinuous S'.smallEtaleTopology X'.smallEtaleTopology),
    let pf_f' := B_f'.sheafPushforwardContinuous AddCommGrpCat.{u}
      S'.smallEtaleTopology X'.smallEtaleTopology
    ∀ (G₁ G₂ : CategoryTheory.Sheaf X'.smallEtaleTopology AddCommGrpCat.{u})
      (α : Quiver.Hom G₁ G₂) [CategoryTheory.Epi α],
      CategoryTheory.Epi (pf_f'.map α)

def WeilEtaleSquareDegreeZeroPBC {X S S' X' : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom X S) (g : Quiver.Hom S' S)
    (f' : Quiver.Hom X' S') (g' : Quiver.Hom X' X)
    (hpb : CategoryTheory.IsPullback g' f' f g) : Prop :=
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_f : CategoryTheory.Functor S.Etale X.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
  let B_g : CategoryTheory.Functor S.Etale S'.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
  let B_f' : CategoryTheory.Functor S'.Etale X'.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f'
  let B_g' : CategoryTheory.Functor X.Etale X'.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g'
  ∃ (_ : B_f.IsContinuous S.smallEtaleTopology X.smallEtaleTopology)
    (_ : B_g.IsContinuous S.smallEtaleTopology S'.smallEtaleTopology)
    (_ : B_f'.IsContinuous S'.smallEtaleTopology X'.smallEtaleTopology)
    (_ : B_g'.IsContinuous X.smallEtaleTopology X'.smallEtaleTopology),
    let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology
    let pf_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
    let pf_f' := B_f'.sheafPushforwardContinuous AddCommGrpCat.{u} S'.smallEtaleTopology X'.smallEtaleTopology
    let pf_g' := B_g'.sheafPushforwardContinuous AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
    ∃ (_ : pf_g.IsRightAdjoint) (_ : pf_g'.IsRightAdjoint),
      let pb_g' := B_g'.sheafPullback AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
      let adj_g := B_g.sheafAdjunctionContinuous AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
      let adj_g' := B_g'.sheafAdjunctionContinuous AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
      let e_fun : CategoryTheory.Iso (CategoryTheory.Functor.comp B_f B_g')
          (CategoryTheory.Functor.comp B_g B_f') :=
        CategoryTheory.Iso.trans
          (CategoryTheory.Iso.symm (CategoryTheory.MorphismProperty.Over.pullbackComp g' f))
          (CategoryTheory.Iso.trans
            (CategoryTheory.MorphismProperty.Over.pullbackCongr hpb.w)
            (CategoryTheory.MorphismProperty.Over.pullbackComp f' g))
      letI : (CategoryTheory.Functor.comp B_f B_g').IsContinuous
          S.smallEtaleTopology X'.smallEtaleTopology :=
        CategoryTheory.Functor.isContinuous_comp B_f B_g'
          S.smallEtaleTopology X.smallEtaleTopology X'.smallEtaleTopology
      letI : (CategoryTheory.Functor.comp B_g B_f').IsContinuous
          S.smallEtaleTopology X'.smallEtaleTopology :=
        CategoryTheory.Functor.isContinuous_comp B_g B_f'
          S.smallEtaleTopology S'.smallEtaleTopology X'.smallEtaleTopology
      let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_fun
        AddCommGrpCat.{u} S.smallEtaleTopology X'.smallEtaleTopology
      ∀ (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
        CategoryTheory.IsIso
          ((adj_g.homEquiv (pf_f.obj F) (pf_f'.obj (pb_g'.obj F))).symm
            (CategoryTheory.CategoryStruct.comp
              (pf_f.map (adj_g'.unit.app F))
              (e_pf.hom.app (pb_g'.obj F))))

def WeilLocalRingEtaleSectionLifting (Q : Type u) [CommRing Q] : Prop :=
  ∃ (_ : IsLocalRing Q),
    ∀ (E : Type u) [CommRing E] [Algebra Q E] [Algebra.Etale Q E],
      (∃ q : Ideal E, q.IsPrime ∧ Ideal.comap (algebraMap Q E) q = IsLocalRing.maximalIdeal Q) →
      Nonempty (E →ₐ[Q] Q)

def WeilPointedEtaleClopenSplittingAndDescent
    (R₀ B₀ Ω : Type u) [CommRing R₀] [CommRing B₀] [Algebra R₀ B₀] [Field Ω] [Algebra R₀ Ω] : Prop :=
  ∃ (R₁ : Type u) (_ : CommRing R₁) (_ : Algebra R₀ R₁) (_ : Algebra.Etale R₀ R₁)
    (_ : Algebra R₁ Ω) (_ : IsScalarTower R₀ R₁ Ω)
    (r : ℕ) (B₁ : Fin r → Type u) (_ : ∀ m, CommRing (B₁ m)) (_ : ∀ m, Algebra R₁ (B₁ m))
    (e₁ : TensorProduct R₀ R₁ B₀ ≃ₐ[R₁] (∀ m : Fin r, B₁ m)),
    let b₁_hom : ∀ m : Fin r, B₀ →+* B₁ m := fun m =>
      (Pi.evalAlgHom R₁ B₁ m).toRingHom.comp
        (e₁.toAlgHom.toRingHom.comp
          (Algebra.TensorProduct.includeRight : B₀ →ₐ[R₀] TensorProduct R₀ R₁ B₀).toRingHom)
    ∀ m : Fin r,
      WeilLocalRingEtaleSectionLifting (TensorProduct R₁ Ω (B₁ m)) ∧
      (∀ (R₂ : Type u) [CommRing R₂] [Algebra R₁ R₂] [Algebra.Etale R₁ R₂]
        [Algebra R₂ Ω] [IsScalarTower R₁ R₂ Ω]
        (W₀ : Type u) [CommRing W₀] [Algebra B₀ W₀] [Algebra.Etale B₀ W₀]
        (α₀ : W₀ →+* TensorProduct R₁ Ω (B₁ m)),
        α₀.comp (algebraMap B₀ W₀) =
          (Algebra.TensorProduct.includeRight : B₁ m →ₐ[R₁] TensorProduct R₁ Ω (B₁ m)).toRingHom.comp (b₁_hom m) →
        ∃ (R₃ : Type u) (_ : CommRing R₃) (_ : Algebra R₁ R₃) (_ : Algebra R₂ R₃)
          (_ : IsScalarTower R₁ R₂ R₃) (_ : Algebra.Etale R₂ R₃)
          (_ : Algebra R₃ Ω) (_ : IsScalarTower R₂ R₃ Ω) (_ : IsScalarTower R₁ R₃ Ω)
          (α_tilde : W₀ →+* TensorProduct R₁ R₃ (B₁ m)),
          α_tilde.comp (algebraMap B₀ W₀) =
            (Algebra.TensorProduct.includeRight : B₁ m →ₐ[R₁] TensorProduct R₁ R₃ (B₁ m)).toRingHom.comp (b₁_hom m) ∧
          (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₃ Ω) (AlgHom.id R₁ (B₁ m))).toRingHom.comp α_tilde = α₀) ∧
      (∀ (R₂ : Type u) [CommRing R₂] [Algebra R₁ R₂] [Algebra.Etale R₁ R₂]
        [Algebra R₂ Ω] [IsScalarTower R₁ R₂ Ω]
        (W₀ : Type u) [CommRing W₀] [Algebra B₀ W₀] [Algebra.Etale B₀ W₀]
        (α₁ α₂ : W₀ →+* TensorProduct R₁ R₂ (B₁ m)),
        α₁.comp (algebraMap B₀ W₀) =
          (Algebra.TensorProduct.includeRight : B₁ m →ₐ[R₁] TensorProduct R₁ R₂ (B₁ m)).toRingHom.comp (b₁_hom m) →
        α₂.comp (algebraMap B₀ W₀) =
          (Algebra.TensorProduct.includeRight : B₁ m →ₐ[R₁] TensorProduct R₁ R₂ (B₁ m)).toRingHom.comp (b₁_hom m) →
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₂ Ω) (AlgHom.id R₁ (B₁ m))).toRingHom.comp α₁ =
          (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₂ Ω) (AlgHom.id R₁ (B₁ m))).toRingHom.comp α₂ →
        ∃ (R₃ : Type u) (_ : CommRing R₃) (_ : Algebra R₁ R₃) (_ : Algebra R₂ R₃)
          (_ : IsScalarTower R₁ R₂ R₃) (_ : Algebra.Etale R₂ R₃)
          (_ : Algebra R₃ Ω) (_ : IsScalarTower R₂ R₃ Ω) (_ : IsScalarTower R₁ R₃ Ω),
          (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₂ R₃) (AlgHom.id R₁ (B₁ m))).toRingHom.comp α₁ =
            (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₂ R₃) (AlgHom.id R₁ (B₁ m))).toRingHom.comp α₂)
def IsEtaleLocalOdpHypersurfaceAt (k : Type u) [Field k] (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (L : MvPolynomial (Fin (M + 1)) k) (z₀ : Z_bar.left) : Prop :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
    MvPolynomial.gradedAlgebra
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  ∃ (hL : L ∈ 𝒜 1)
    (α₀ : Fin (M + 1))
    (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜 1)
    (V : Z_bar.left.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V) (hz₀ : z₀ ∈ V)
    (hVα : V ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α₀)))
    (ψ_V : MvPolynomial (Fin (2 * m + 2)) k →+* ↑(Z_bar.left.presheaf.obj (Opposite.op V)))
    (Q : MvPolynomial (Fin (2 * m + 2)) k),
    AlgebraicGeometry.Etale (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_V)) ∧
    (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_V) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V.ι ≫ Z_bar.hom) ∧
    (∀ i : Fin (2 * m + 2), ψ_V (MvPolynomial.X i) ∈ (hAffV.primeIdealOf ⟨z₀, hz₀⟩).asIdeal) ∧
    Q ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) k 2 ∧
    Matrix.det (Matrix.of fun i j : Fin (2 * m + 2) =>
      MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q))) ≠ 0 ∧
    let p_z := (hAffV.primeIdealOf ⟨z₀, hz₀⟩).asIdeal
    let ℓ_V := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X α₀) hXα zero_lt_one).hom ≫
      ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α₀)) V hVα).hom
      (HomogeneousLocalization.mk ⟨1, ⟨L, hL⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩)
    algebraMap _ (Localization.AtPrime p_z) (ℓ_V - ψ_V Q) ∈
      (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 3

def IsCubicVeroneseEmbeddedOver (k : Type u) [Field k] (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M) : Prop :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
    MvPolynomial.gradedAlgebra
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  3 ≤ M ∧
  AlgebraicGeometry.IsClosedImmersion ι_bar.left ∧
  (∀ L : MvPolynomial (Fin (M + 1)) k, L ∈ 𝒜 1 → L ≠ 0 →
    ∃ z : Z_bar.left, ι_bar.left.base z ∉ weilProjHyperplaneSet k M L) ∧
  (∀ z₀ : Z_bar.left, IsClosed ({z₀} : Set Z_bar.left) →
    ∃ L : MvPolynomial (Fin (M + 1)) k, L ∈ 𝒜 1 ∧ L ≠ 0 ∧
      IsEtaleLocalOdpHypersurfaceAt k m M Z_bar ι_bar L z₀) ∧
  (∀ (z₁ z₂ : Z_bar.left),
    IsClosed ({z₁} : Set Z_bar.left) → IsClosed ({z₂} : Set Z_bar.left) → z₁ ≠ z₂ →
    ∀ (α₁ α₂ : Fin (M + 1))
      (hX₁ : (MvPolynomial.X α₁ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜 1)
      (hX₂ : (MvPolynomial.X α₂ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜 1)
      (V₁ V₂ : Z_bar.left.Opens)
      (hAff₁ : AlgebraicGeometry.IsAffineOpen V₁) (hz₁ : z₁ ∈ V₁)
      (hAff₂ : AlgebraicGeometry.IsAffineOpen V₂) (hz₂ : z₂ ∈ V₂)
      (hV₁ : V₁ ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α₁)))
      (hV₂ : V₂ ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α₂)))
      (ψ₁ : MvPolynomial (Fin (2 * m + 2)) k →+* ↑(Z_bar.left.presheaf.obj (Opposite.op V₁)))
      (ψ₂ : MvPolynomial (Fin (2 * m + 2)) k →+* ↑(Z_bar.left.presheaf.obj (Opposite.op V₂))),
      AlgebraicGeometry.Etale (V₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)) →
      (V₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V₁.ι ≫ Z_bar.hom) →
      (∀ i : Fin (2 * m + 2), ψ₁ (MvPolynomial.X i) ∈ (hAff₁.primeIdealOf ⟨z₁, hz₁⟩).asIdeal) →
      AlgebraicGeometry.Etale (V₂.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂)) →
      (V₂.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V₂.ι ≫ Z_bar.hom) →
      (∀ i : Fin (2 * m + 2), ψ₂ (MvPolynomial.X i) ∈ (hAff₂.primeIdealOf ⟨z₂, hz₂⟩).asIdeal) →
      ∀ (c₁ c₂ : k) (v₁ v₂ : Fin (2 * m + 2) → k),
        ∃ (L : MvPolynomial (Fin (M + 1)) k) (hL : L ∈ 𝒜 1),
          let p₁ := (hAff₁.primeIdealOf ⟨z₁, hz₁⟩).asIdeal
          let p₂ := (hAff₂.primeIdealOf ⟨z₂, hz₂⟩).asIdeal
          let ℓ₁ := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X α₁) hX₁ zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α₁)) V₁ hV₁).hom
            (HomogeneousLocalization.mk ⟨1, ⟨L, hL⟩, ⟨MvPolynomial.X α₁, hX₁⟩, ⟨1, pow_one _⟩⟩)
          let ℓ₂ := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X α₂) hX₂ zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α₂)) V₂ hV₂).hom
            (HomogeneousLocalization.mk ⟨1, ⟨L, hL⟩, ⟨MvPolynomial.X α₂, hX₂⟩, ⟨1, pow_one _⟩⟩)
          algebraMap _ (Localization.AtPrime p₁)
              (ℓ₁ - ψ₁ (MvPolynomial.C c₁ + ∑ i, MvPolynomial.C (v₁ i) * MvPolynomial.X i)) ∈
            (IsLocalRing.maximalIdeal (Localization.AtPrime p₁)) ^ 2 ∧
          algebraMap _ (Localization.AtPrime p₂)
              (ℓ₂ - ψ₂ (MvPolynomial.C c₂ + ∑ i, MvPolynomial.C (v₂ i) * MvPolynomial.X i)) ∈
            (IsLocalRing.maximalIdeal (Localization.AtPrime p₂)) ^ 2) ∧
  (m = 0 → ∀ (L : MvPolynomial (Fin (M + 1)) k), L ∈ 𝒜 1 → L ≠ 0 →
    ∀ (C_L : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (ι_CL : C_L ⟶ Z_bar),
      IsHomogeneousHypersurfacePullbackOver k M 1 ι_bar L ι_CL.left →
      ConnectedSpace ↥C_L.left →
      (AlgebraicGeometry.SmoothOfRelativeDimension 1 C_L.hom ∨
        ∃ x₀ : C_L.left, IsClosed ({x₀} : Set C_L.left) ∧
          (∀ y : C_L.left, y ≠ x₀ → ∃ V : C_L.left.Opens, y ∈ V ∧
            AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ C_L.hom)) ∧
          ∃ (V' : AlgebraicGeometry.Scheme.{u}) (v₀ : V') (e₁ : V' ⟶ C_L.left)
            (e₂ : V' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) k ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
            AlgebraicGeometry.Etale e₁ ∧ AlgebraicGeometry.Etale e₂ ∧ e₁.base v₀ = x₀ ∧
            (∀ b : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X b) ∈ (e₂.base v₀).asIdeal) ∧
            e₁ ≫ C_L.hom = e₂ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) →
      IrreducibleSpace ↥C_L.left)

def IsStandardProjLineCoord (k : Type u) [Field k]
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      (weilProjectiveSpaceOver k 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
      (weilProjectiveSpaceOver k 1).left) : Prop :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
    MvPolynomial.gradedAlgebra
  let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
  AlgebraicGeometry.IsOpenImmersion j_aff ∧
  j_aff ≫ (weilProjectiveSpaceOver k 1).hom =
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
  s_inf ≫ (weilProjectiveSpaceOver k 1).hom =
    𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
  Set.range j_aff.base = (weilProjHyperplaneSet k 1 (MvPolynomial.X 0))ᶜ ∧
  (Set.range j_aff.base)ᶜ = Set.range s_inf.base ∧
  ∃ h_jaff : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))).Opens) ≤
      (TopologicalSpace.Opens.map j_aff.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X 0)),
    ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X 0)
        (MvPolynomial.isHomogeneous_X k 0) zero_lt_one).hom ≫
      j_aff.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X 0)) ⊤ h_jaff ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom).hom
      (HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X 1, MvPolynomial.isHomogeneous_X k 1⟩,
          ⟨MvPolynomial.X 0, MvPolynomial.isHomogeneous_X k 0⟩, ⟨1, pow_one _⟩⟩) =
      Polynomial.X

def IsStandardProjLineInPlane (k : Type u) [Field k]
    (ι_line : weilProjectiveSpaceOver k 1 ⟶ weilProjectiveSpaceOver k 2) : Prop :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
    MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
    MvPolynomial.gradedAlgebra
  let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
  let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k
  AlgebraicGeometry.IsClosedImmersion ι_line.left ∧
  Set.range ι_line.left.base = weilProjHyperplaneSet k 2 (MvPolynomial.X 2) ∧
  ∀ b : Fin 2,
    let U₁ := AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b)
    let U₂ := AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X b.castSucc)
    ∃ h_b : U₁ ≤ (TopologicalSpace.Opens.map ι_line.left.base).obj U₂,
      (∀ a : Fin 2,
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X b.castSucc)
            (MvPolynomial.isHomogeneous_X k b.castSucc) zero_lt_one).hom ≫
          ι_line.left.appLE U₂ U₁ h_b).hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X a.castSucc, MvPolynomial.isHomogeneous_X k a.castSucc⟩,
              ⟨MvPolynomial.X b.castSucc, MvPolynomial.isHomogeneous_X k b.castSucc⟩,
              ⟨1, pow_one _⟩⟩) =
        (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b)
          (MvPolynomial.isHomogeneous_X k b) zero_lt_one).hom.hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X a, MvPolynomial.isHomogeneous_X k a⟩,
              ⟨MvPolynomial.X b, MvPolynomial.isHomogeneous_X k b⟩, ⟨1, pow_one _⟩⟩)) ∧
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X b.castSucc)
          (MvPolynomial.isHomogeneous_X k b.castSucc) zero_lt_one).hom ≫
        ι_line.left.appLE U₂ U₁ h_b).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X 2, MvPolynomial.isHomogeneous_X k 2⟩,
            ⟨MvPolynomial.X b.castSucc, MvPolynomial.isHomogeneous_X k b.castSucc⟩,
            ⟨1, pow_one _⟩⟩) = 0

def IsLinearNetIncidenceFamily (k : Type u) [Field k] (M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (L : Fin 3 → MvPolynomial (Fin (M + 1)) k)
    (Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π_Y : Y₂ ⟶ Z_bar) (g₂ : Y₂ ⟶ weilProjectiveSpaceOver k 2) : Prop :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
    MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
    MvPolynomial.gradedAlgebra
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k
  ∃ (hcomm : π_Y.left ≫ Z_bar.hom = g₂.left ≫ (weilProjectiveSpaceOver k 2).hom)
    (hL : ∀ r : Fin 3, L r ∈ 𝒜_M 1),
    AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.lift π_Y.left g₂.left hcomm) ∧
    ∀ (α : Fin (M + 1)) (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
      (β : Fin 3) (hWβ : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1)
      (U_Z : Z_bar.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_Z)
      (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)))
      (U_P : (weilProjectiveSpaceOver k 2).left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_P)
      (hUP : U_P ≤ AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X β))
      (W_pb : (CategoryTheory.Limits.pullback Z_bar.hom (weilProjectiveSpaceOver k 2).hom).Opens)
      (_ : AlgebraicGeometry.IsAffineOpen W_pb)
      (hWZ : W_pb ≤ (TopologicalSpace.Opens.map
        (CategoryTheory.Limits.pullback.fst Z_bar.hom (weilProjectiveSpaceOver k 2).hom).base).obj U_Z)
      (hWP : W_pb ≤ (TopologicalSpace.Opens.map
        (CategoryTheory.Limits.pullback.snd Z_bar.hom (weilProjectiveSpaceOver k 2).hom).base).obj U_P),
      let ℓ_r : Fin 3 → ↑(Z_bar.left.presheaf.obj (Opposite.op U_Z)) := fun r =>
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
          ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) U_Z hUZ).hom
          (HomogeneousLocalization.mk ⟨1, ⟨L r, hL r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
      let w_r : Fin 3 → ↑((weilProjectiveSpaceOver k 2).left.presheaf.obj (Opposite.op U_P)) := fun r =>
        (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β) hWβ zero_lt_one).hom ≫
          (weilProjectiveSpaceOver k 2).left.presheaf.map (CategoryTheory.homOfLE hUP).op)).hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X r, MvPolynomial.isHomogeneous_X k r⟩,
              ⟨MvPolynomial.X β, hWβ⟩, ⟨1, pow_one _⟩⟩)
      RingHom.ker ((CategoryTheory.Limits.pullback.lift π_Y.left g₂.left hcomm).app W_pb).hom =
        Ideal.span {∑ r : Fin 3,
          ((CategoryTheory.Limits.pullback.fst Z_bar.hom (weilProjectiveSpaceOver k 2).hom).appLE
            U_Z W_pb hWZ).hom (ℓ_r r) *
          ((CategoryTheory.Limits.pullback.snd Z_bar.hom (weilProjectiveSpaceOver k 2).hom).appLE
            U_P W_pb hWP).hom (w_r r)}

structure WeilAlgClosedDualNetAndPencilLine (k : Type u) [Field k] (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M) where
  L : Fin 3 → MvPolynomial (Fin (M + 1)) k
  j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
    (weilProjectiveSpaceOver k 1).left
  s_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
    (weilProjectiveSpaceOver k 1).left
  ι_line : weilProjectiveSpaceOver k 1 ⟶ weilProjectiveSpaceOver k 2
  u_val : k
  hCoord_line : IsStandardProjLineCoord k j_aff s_inf
  hLine_plane : IsStandardProjLineInPlane k ι_line
  hL_homog : ∀ r : Fin 3, L r ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1
  hL_linIndep : ∀ c : Fin 3 → k, c ≠ 0 → (∑ r : Fin 3, MvPolynomial.C (c r) * L r) ≠ 0
  hTrans_axis : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m) 2 ![L 0, L 1]
  hNet_m0 : m = 0 → ∀ z : Z_bar.left,
    ∃ r : Fin 3, ι_bar.left.base z ∉ weilProjHyperplaneSet k M (L r)
  hNet_pos : 1 ≤ m → IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m - 1) 3 L
  hTrans_u₀ : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m + 1) 1
    ![L 0 + MvPolynomial.C u_val * L 1]
  hDichotomy :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
      MvPolynomial.gradedAlgebra
    (∀ (t : Fin 2 → k), t ≠ 0 →
      IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m + 1) 1
        ![MvPolynomial.C (t 0) * L 0 + MvPolynomial.C (t 1) * L 1]) ∨
    ∃ (S_aff : Finset k)
      (U₀ : (weilProjectiveSpaceOver k 1).left.Opens)
      (D_disc : ℕ)
      (P_disc : MvPolynomial (Fin 3) k)
      (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (ι_disc : C_disc ⟶ weilProjectiveSpaceOver k 2)
      (U_disc_reg : C_disc.left.Opens),
      1 ≤ D_disc ∧
      Irreducible P_disc ∧
      IsHomogeneousHypersurfacePullbackOver k 2 D_disc
        (𝟙 (weilProjectiveSpaceOver k 2)) P_disc ι_disc.left ∧
      AlgebraicGeometry.IsIntegral C_disc.left ∧
      AlgebraicGeometry.GeometricallyIrreducible C_disc.hom ∧
      AlgebraicGeometry.IsProper C_disc.hom ∧
      Nonempty U_disc_reg ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_disc_reg.ι ≫ C_disc.hom) ∧
      u_val ∉ S_aff ∧
      (U₀ : Set (weilProjectiveSpaceOver k 1).left) =
        j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) |
          ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal } ∧
      ι_line.left.base ⁻¹' (Set.range ι_disc.left.base) = (U₀ : Set _)ᶜ ∧
      ι_line.left.base '' ((U₀ : Set _)ᶜ) ⊆
        ι_disc.left.base '' (U_disc_reg : Set C_disc.left) ∧
      MvPolynomial.eval ![0, 1, 0] (MvPolynomial.pderiv (0 : Fin 3) P_disc) ≠ 0 ∧
      (∀ a ∈ S_aff,
        MvPolynomial.eval ![1, a, 0] (MvPolynomial.pderiv (1 : Fin 3) P_disc) ≠ 0) ∧
      (∀ w : Fin 3 → k, w ≠ 0 → MvPolynomial.eval w P_disc ≠ 0 →
        IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m + 1) 1
          ![∑ r : Fin 3, MvPolynomial.C (w r) * L r]) ∧
      (∀ c : C_disc.left, c ∈ U_disc_reg → IsClosed ({c} : Set C_disc.left) →
        ∃ (w : Fin 3 → k) (z_c : Z_bar.left) (hClosed_zc : IsClosed ({z_c} : Set Z_bar.left)),
          w ≠ 0 ∧
          (∀ (F : MvPolynomial (Fin 3) k) (d : ℕ),
            F ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d →
            (F ∈ ProjectiveSpectrum.asHomogeneousIdeal (ι_disc.left.base c) ↔
              MvPolynomial.eval w F = 0)) ∧
          IsEtaleLocalOdpHypersurfaceAt k m M Z_bar ι_bar
            (∑ r : Fin 3, MvPolynomial.C (w r) * L r) z_c ∧
          IsTransversalLinearSlice k M Z_bar ι_bar
            ⟨{z_c}ᶜ, hClosed_zc.isOpen_compl⟩ (2 * m + 1) 1
            ![∑ r : Fin 3, MvPolynomial.C (w r) * L r])

structure WeilAlgClosedIncidenceSlicePackage (k : Type u) [Field k] (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (L : Fin 3 → MvPolynomial (Fin (M + 1)) k)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      (weilProjectiveSpaceOver k 1).left)
    (ι_line : weilProjectiveSpaceOver k 1 ⟶ weilProjectiveSpaceOver k 2)
    (u_val : k) where
  B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))
  hProp_B₀ : AlgebraicGeometry.IsProper B₀.hom
  hSm_B₀ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) B₀.hom
  hProj_B₀ : IsProjectiveOverField k B₀
  ι_B : B₀ ⟶ Z_bar
  hCl_B : AlgebraicGeometry.IsClosedImmersion ι_B.left
  hRange_B₀ : Set.range ι_B.left.base =
    { z : Z_bar.left |
      ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 0) ∧
      ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 1) }
  U_axis : Z_bar.left.Opens
  hU_axis_eq : (U_axis : Set Z_bar.left) = (Set.range ι_B.left.base)ᶜ
  hU_axis_ne : Nonempty U_axis
  Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))
  hInt_Ztilde : AlgebraicGeometry.IsIntegral Z_tilde.left
  hGeom_Ztilde : AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom
  hProp_Ztilde : AlgebraicGeometry.IsProper Z_tilde.hom
  hSm_Ztilde : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom
  hProj_Ztilde : IsProjectiveOverField k Z_tilde
  π₀ : Z_tilde ⟶ Z_bar
  hProp_π₀ : AlgebraicGeometry.IsProper π₀.left
  hSurj_π₀ : AlgebraicGeometry.Surjective π₀.left
  hIso_π₀ : CategoryTheory.IsIso (π₀.left ∣_ U_axis)
  f₀ : Z_tilde ⟶ weilProjectiveSpaceOver k 1
  hFlat_f₀ : AlgebraicGeometry.Flat f₀.left
  hProp_f₀ : AlgebraicGeometry.IsProper f₀.left
  hSurj_f₀ : AlgebraicGeometry.Surjective f₀.left
  hFibConn_f₀ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver k 1).left),
    ConnectedSpace ↥(CategoryTheory.Limits.pullback f₀.left s)
  Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))
  hInt_Y₂ : AlgebraicGeometry.IsIntegral Y₂.left
  hGeom_Y₂ : AlgebraicGeometry.GeometricallyIrreducible Y₂.hom
  hProp_Y₂ : AlgebraicGeometry.IsProper Y₂.hom
  hSm_Y₂ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 3) Y₂.hom
  hProj_Y₂ : IsProjectiveOverField k Y₂
  π_Y : Y₂ ⟶ Z_bar
  g₂ : Y₂ ⟶ weilProjectiveSpaceOver k 2
  hNet_inc : IsLinearNetIncidenceFamily k M Z_bar ι_bar L Y₂ π_Y g₂
  hFlat_g₂ : AlgebraicGeometry.Flat g₂.left
  hProp_g₂ : AlgebraicGeometry.IsProper g₂.left
  ι_Ytilde : Z_tilde ⟶ Y₂
  hPb_line : CategoryTheory.IsPullback ι_Ytilde.left f₀.left g₂.left ι_line.left
  hπ₀_eq : ι_Ytilde ≫ π_Y = π₀
  Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))
  hInt_Zu₀ : AlgebraicGeometry.IsIntegral Z_u₀.left
  hGeom_Zu₀ : AlgebraicGeometry.GeometricallyIrreducible Z_u₀.hom
  hProp_Zu₀ : AlgebraicGeometry.IsProper Z_u₀.hom
  hSm_Zu₀ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_u₀.hom
  hProj_Zu₀ : IsProjectiveOverField k Z_u₀
  ι_Zu₀ : Z_u₀.left ⟶ Z_tilde.left
  hPb_Zu₀ : CategoryTheory.IsPullback ι_Zu₀ Z_u₀.hom f₀.left
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom u_val)) ≫ j_aff)
  H₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))
  hInt_H₀ : AlgebraicGeometry.IsIntegral H₀.left
  hGeom_H₀ : AlgebraicGeometry.GeometricallyIrreducible H₀.hom
  hProp_H₀ : AlgebraicGeometry.IsProper H₀.hom
  hSm_H₀ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) H₀.hom
  hProj_H₀ : IsProjectiveOverField k H₀
  i_H : H₀ ⟶ Z_u₀
  hCl_H : AlgebraicGeometry.IsClosedImmersion i_H.left
