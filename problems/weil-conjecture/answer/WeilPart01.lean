def WeilIsModuleEtalePullback {S_src S_tgt : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom S_src S_tgt) (m i : ℕ)
    (pull : weilEtaleModuleH S_tgt m i →+ weilEtaleModuleH S_src m i) : Prop :=
  let R_m : Type u := ULift.{u, 0} (ZMod m)
  let ModCat := ModuleCat.{u, u} R_m
  let OneMod := fun S : AlgebraicGeometry.Scheme.{u} => weilEtaleModuleUnit S m
  haveI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    ⟨fun _ _ => inferInstance⟩
  haveI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    ⟨fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg⟩
  let B : CategoryTheory.Functor S_tgt.Etale S_src.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  ∃ (hB : B.IsContinuous S_tgt.smallEtaleTopology S_src.smallEtaleTopology),
    let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B ModCat _
      S_tgt.smallEtaleTopology S_src.smallEtaleTopology hB
    ∃ (P_pull : CategoryTheory.Functor
          (CategoryTheory.Sheaf S_tgt.smallEtaleTopology ModCat)
          (CategoryTheory.Sheaf S_src.smallEtaleTopology ModCat))
      (adj : CategoryTheory.Adjunction P_pull P_push)
      (_ : P_pull.Additive)
      (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
      (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull),
      ∀ (T_tgt : S_tgt.Etale) (hT_tgt : CategoryTheory.Limits.IsTerminal T_tgt)
        (T_src : S_src.Etale) (hT_src : CategoryTheory.Limits.IsTerminal T_src),
        let adjMod_tgt := CategoryTheory.constantSheafAdj S_tgt.smallEtaleTopology ModCat hT_tgt
        let adjMod_src := CategoryTheory.constantSheafAdj S_src.smallEtaleTopology ModCat hT_src
        let ε : Quiver.Hom (P_pull.obj (OneMod S_tgt)) (OneMod S_src) :=
          (adj.homEquiv (OneMod S_tgt) (OneMod S_src)).symm
            ((adjMod_tgt.homEquiv (ModuleCat.of R_m R_m) (P_push.obj (OneMod S_src))).symm
              (CategoryTheory.CategoryStruct.comp
                (adjMod_src.unit.app (ModuleCat.of R_m R_m))
                ((OneMod S_src).obj.map (Opposite.op (hT_src.from (B.obj T_tgt))))))
        ∃ (η : Quiver.Hom (OneMod S_src) (P_pull.obj (OneMod S_tgt))),
          CategoryTheory.CategoryStruct.comp ε η = CategoryTheory.CategoryStruct.id _ ∧
          CategoryTheory.CategoryStruct.comp η ε = CategoryTheory.CategoryStruct.id _ ∧
          ∀ α : weilEtaleModuleH S_tgt m i,
            pull α = (CategoryTheory.Abelian.Ext.mk₀ η).comp
              (((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull _ _ _ _ _
                (OneMod S_tgt) (OneMod S_tgt) i) α).comp
                (CategoryTheory.Abelian.Ext.mk₀ ε) (Nat.add_zero i)) (Nat.zero_add i)
