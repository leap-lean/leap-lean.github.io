                LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget Γ.left).obj U).left (ULift.{u} (ZMod n)) →
                  ↑(((AlgebraicGeometry.Scheme.Etale.forget Γ.left).obj U).left.presheaf.obj (Opposite.op ⊤)))
