import Mathlib
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

noncomputable abbrev weilExtField (F : Type u) [Field F] (n : ℕ) : Type u :=
  (Polynomial.X ^ (Nat.card F ^ n) - Polynomial.X : Polynomial F).SplittingField

noncomputable def weilPointCount (F : Type u) [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))) (n : ℕ) : ℕ :=
  Nat.card (CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap F (weilExtField F n)))) ⟶ X)

noncomputable def weilLogDerivSeries (F : Type u) [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))) : PowerSeries ℤ :=
  PowerSeries.mk fun n => if n = 0 then 0 else (weilPointCount F X n : ℤ)

noncomputable def weilProjectiveSpaceOver (K : Type u) [CommRing K] (N : ℕ) :
    CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
    MvPolynomial.gradedAlgebra
  CategoryTheory.Over.mk
    (AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0))))

noncomputable def weilBaseChangeOver (F F₁ : Type u) [CommRing F] [CommRing F₁] [Algebra F F₁]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))) :
    CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F₁)) :=
  CategoryTheory.Over.mk
    (CategoryTheory.Limits.pullback.snd X.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F₁))))

def HasSmoothProjectiveAlteration (F : Type u) [Field F] (d : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))) : Prop :=
  ∃ (F₁ : Type u) (_ : Field F₁) (_ : Algebra F F₁) (_ : FiniteDimensional F F₁)
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F₁))),
    AlgebraicGeometry.GeometricallyIrreducible Y.hom ∧
    AlgebraicGeometry.IsProper Y.hom ∧
    AlgebraicGeometry.SmoothOfRelativeDimension d Y.hom ∧
    (∃ (N : ℕ) (ι : Y ⟶ weilProjectiveSpaceOver F₁ N),
      AlgebraicGeometry.IsClosedImmersion ι.left) ∧
    ∃ (φ : Y ⟶ weilBaseChangeOver F F₁ X),
      AlgebraicGeometry.IsProper φ.left ∧
      AlgebraicGeometry.Surjective φ.left ∧
      ∃ (U : (weilBaseChangeOver F F₁ X).left.Opens),
        Nonempty U ∧
        AlgebraicGeometry.IsFinite (φ.left ∣_ U) ∧
        AlgebraicGeometry.Etale (φ.left ∣_ U) ∧
        AlgebraicGeometry.Surjective (φ.left ∣_ U)
def IsProjectiveOverField (k : Type u) [Field k]
    (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))) : Prop :=
  ∃ (N : ℕ) (ι : V ⟶ weilProjectiveSpaceOver k N),
    AlgebraicGeometry.IsClosedImmersion ι.left

def IsGenFiniteEtaleAlterationOver (k : Type u) [Field k]
    {V W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (φ : W ⟶ V) : Prop :=
  AlgebraicGeometry.IsProper φ.left ∧
  AlgebraicGeometry.Surjective φ.left ∧
  ∃ (U : V.left.Opens),
    Nonempty U ∧
    AlgebraicGeometry.IsFinite (φ.left ∣_ U) ∧
    AlgebraicGeometry.Etale (φ.left ∣_ U) ∧
    AlgebraicGeometry.Surjective (φ.left ∣_ U)

def IsSncDivisorSupport (k : Type u) [Field k] (m : ℕ)
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z : Set W.left) : Prop :=
  ∃ (r : ℕ) (D : Fin r → AlgebraicGeometry.Scheme.{u})
    (ιD : ∀ i : Fin r, D i ⟶ W.left),
    (∀ i : Fin r, AlgebraicGeometry.IsClosedImmersion (ιD i)) ∧
    (∀ i : Fin r, AlgebraicGeometry.IsIntegral (D i)) ∧
    (_root_.Pairwise fun i j : Fin r => Set.range (ιD i).base ≠ Set.range (ιD j).base) ∧
    Z = (⋃ i : Fin r, Set.range (ιD i).base) ∧
    ∀ x : W.left, ∃ (U : W.left.Opens),
      AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U ∧
      ∃ (ψ : MvPolynomial (Fin m) k →+* ↑(W.left.presheaf.obj (Opposite.op U))),
        AlgebraicGeometry.Etale (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
        (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = U.ι ≫ W.hom) ∧
        ∃ (α : {i : Fin r // Nonempty ↑((TopologicalSpace.Opens.map (ιD i).base).obj U)} → Fin m),
          Function.Injective α ∧
          ∀ (i : Fin r) (hi : Nonempty ↑((TopologicalSpace.Opens.map (ιD i).base).obj U)),
            RingHom.ker ((ιD i).app U).hom =
              Ideal.span {ψ (MvPolynomial.X (α ⟨i, hi⟩))}

def IsSemistablePointedCurveOver (k : Type u) [Field k]
    {C B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (f : C ⟶ B) (U_B : B.left.Opens) (n : ℕ) (τ : Fin n → (B ⟶ C)) : Prop :=
  AlgebraicGeometry.Flat f.left ∧
  AlgebraicGeometry.IsProper f.left ∧
  AlgebraicGeometry.LocallyOfFinitePresentation f.left ∧
  AlgebraicGeometry.Surjective f.left ∧
  (∀ (K : Type u) [Field K] [IsAlgClosed K]
      (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B.left),
    ConnectedSpace ↥(CategoryTheory.Limits.pullback f.left s)) ∧
  AlgebraicGeometry.SmoothOfRelativeDimension 1 (f.left ∣_ U_B) ∧
  (∀ j : Fin n, τ j ≫ f = 𝟙 B) ∧
  (_root_.Pairwise fun i j : Fin n =>
    Disjoint (Set.range (τ i).left.base) (Set.range (τ j).left.base)) ∧
  (∀ (j : Fin n) (b : B.left), ∃ V : C.left.Opens,
    (τ j).left.base b ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ f.left)) ∧
  (∀ x : C.left,
    (∃ V : C.left.Opens,
      x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ f.left)) ∨
    (∃ (R' : CommRingCat.{u}) (e_B : AlgebraicGeometry.Spec R' ⟶ B.left) (h : R')
        (V' : AlgebraicGeometry.Scheme.{u}) (v₀ : V') (e_C : V' ⟶ C.left)
        (q : V' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) R' ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}))),
      AlgebraicGeometry.Etale e_B ∧
      AlgebraicGeometry.Etale e_C ∧
      AlgebraicGeometry.Etale q ∧
      e_C.base v₀ = x ∧
      (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (q.base v₀).asIdeal) ∧
      Ideal.Quotient.mk _ (MvPolynomial.C h) ∈ (q.base v₀).asIdeal ∧
      e_C ≫ f.left =
        q ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_B))
def IsEquidimGenSmoothCurveFibOver (k : Type u) [Field k]
    {X B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (f : X ⟶ B) (U_B : B.left.Opens) : Prop :=
  AlgebraicGeometry.IsProper f.left ∧
  AlgebraicGeometry.Surjective f.left ∧
  AlgebraicGeometry.SmoothOfRelativeDimension 1 (f.left ∣_ U_B) ∧
  ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B.left),
    ConnectedSpace ↥(CategoryTheory.Limits.pullback f.left s) ∧
    ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f.left s),
      topologicalKrullDim ↥E = (1 : WithBot ℕ∞) ∧
      ∃ (q : ↥(CategoryTheory.Limits.pullback f.left s)) (W : X.left.Opens),
        q ∈ E ∧
        (CategoryTheory.Limits.pullback.fst f.left s).base q ∈ W ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f.left)

def IsThreeSecantPointedCurveFibOver (k : Type u) [Field k]
    {X B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (f : X ⟶ B) (U_B : B.left.Opens) (n : ℕ) (σ : Fin n → (B ⟶ X)) : Prop :=
  3 ≤ n ∧
  IsEquidimGenSmoothCurveFibOver k f U_B ∧
  (∀ j : Fin n, σ j ≫ f = 𝟙 B) ∧
  (_root_.Pairwise fun i j : Fin n =>
    Disjoint ((σ i).left.base '' (U_B : Set B.left)) ((σ j).left.base '' (U_B : Set B.left))) ∧
  ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B.left)
      (E : Set ↥(CategoryTheory.Limits.pullback f.left s)),
    E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f.left s) →
    ∃ (j₁ j₂ j₃ : Fin n)
      (q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback f.left s))
      (W₁ W₂ W₃ : X.left.Opens),
      q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
      q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
      (CategoryTheory.Limits.pullback.fst f.left s).base q₁ ∈ Set.range (σ j₁).left.base ∧
      (CategoryTheory.Limits.pullback.fst f.left s).base q₂ ∈ Set.range (σ j₂).left.base ∧
      (CategoryTheory.Limits.pullback.fst f.left s).base q₃ ∈ Set.range (σ j₃).left.base ∧
      (CategoryTheory.Limits.pullback.fst f.left s).base q₁ ∈ W₁ ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₁.ι ≫ f.left) ∧
      (CategoryTheory.Limits.pullback.fst f.left s).base q₂ ∈ W₂ ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₂.ι ≫ f.left) ∧
      (CategoryTheory.Limits.pullback.fst f.left s).base q₃ ∈ W₃ ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₃.ι ≫ f.left)

def HasOpenPointedCurvePullbackIsoOver (k : Type u) [Field k]
    {X₂ B₂ B₃ C₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (f₂ : X₂ ⟶ B₂) {n : ℕ} (σ : Fin n → (B₂ ⟶ X₂))
    (ψ₃ : B₃ ⟶ B₂) (U₃ : B₃.left.Opens)
    (g₃ : C₃ ⟶ B₃) (τ₃ : Fin n → (B₃ ⟶ C₃)) : Prop :=
  let V₃ : C₃.left.Opens := (TopologicalSpace.Opens.map g₃.left.base).obj U₃
  ∃ (ι₃ : V₃.toScheme ⟶ X₂.left)
    (hcomm : ι₃ ≫ f₂.left = V₃.ι ≫ g₃.left ≫ ψ₃.left),
    AlgebraicGeometry.IsOpenImmersion
      (CategoryTheory.Limits.pullback.lift ι₃ (V₃.ι ≫ g₃.left) hcomm) ∧
    Set.range (CategoryTheory.Limits.pullback.lift ι₃ (V₃.ι ≫ g₃.left) hcomm).base =
      (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base ⁻¹' (U₃ : Set B₃.left) ∧
    ∀ j : Fin n,
      ∃ s₃ : U₃.toScheme ⟶ V₃.toScheme,
        s₃ ≫ V₃.ι = U₃.ι ≫ (τ₃ j).left ∧
        s₃ ≫ ι₃ = U₃.ι ≫ ψ₃.left ≫ (σ j).left
def IsEtaleLocalNcDivisor (k : Type u) [Field k] (d : ℕ)
    (S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z : Set S.left) : Prop :=
  IsClosed Z ∧
  ∀ x : S.left, ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
    (e_S : AlgebraicGeometry.Spec R' ⟶ S.left)
    (ψ : MvPolynomial (Fin d) k →+* R')
    (I : Finset (Fin d)),
    AlgebraicGeometry.Etale e_S ∧
    AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
    e_S.base v₀ = x ∧
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_S ≫ S.hom) ∧
    (∀ i ∈ I, ψ (MvPolynomial.X i) ∈ v₀.asIdeal) ∧
    e_S.base ⁻¹' Z = {v : AlgebraicGeometry.Spec R' | ∃ i ∈ I, ψ (MvPolynomial.X i) ∈ v.asIdeal}

def IsToroidalSquarefreePair (k : Type u) [Field k] (m N : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z : Set X.left) : Prop :=
  IsClosed Z ∧
  ∃ (E : Fin N → AlgebraicGeometry.Scheme.{u})
    (ιE : ∀ α : Fin N, E α ⟶ X.left),
    (∀ α : Fin N, AlgebraicGeometry.IsClosedImmersion (ιE α)) ∧
    (∀ α : Fin N, AlgebraicGeometry.IsIntegral (E α)) ∧
    (∀ α : Fin N, AlgebraicGeometry.SmoothOfRelativeDimension (m - 2) (ιE α ≫ X.hom)) ∧
    (_root_.Pairwise fun α β : Fin N => Set.range (ιE α).base ≠ Set.range (ιE β).base) ∧
    ({x : X.left | ¬ ∃ V : X.left.Opens,
      x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom)} =
      ⋃ α : Fin N, Set.range (ιE α).base) ∧
    ∀ x : X.left,
      ((∃ V : X.left.Opens,
          x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom)) ∧
        ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
          (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
          (ψ : MvPolynomial (Fin (m + 1)) k →+* R')
          (I : Finset (Fin (m + 1))),
          AlgebraicGeometry.Etale e_X ∧
          AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
          e_X.base v₀ = x ∧
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_X ≫ X.hom) ∧
          (∀ i ∈ I, ψ (MvPolynomial.X i) ∈ v₀.asIdeal) ∧
          e_X.base ⁻¹' Z =
            {v : AlgebraicGeometry.Spec R' | ∃ i ∈ I, ψ (MvPolynomial.X i) ∈ v.asIdeal}) ∨
      (∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
          (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
          (S_exp S_bdry : Finset (Fin m))
          (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
              {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
                ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)}))),
        AlgebraicGeometry.Etale e_X ∧
        AlgebraicGeometry.Etale q ∧
        e_X.base v₀ = x ∧
        2 ≤ S_exp.card ∧
        S_exp ⊆ S_bdry ∧
        (q ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom) ∧
        (∀ a : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v₀).asIdeal) ∧
        (∀ i ∈ S_bdry,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v₀).asIdeal) ∧
        e_X.base ⁻¹' Z =
          {v : AlgebraicGeometry.Spec R' |
            ∃ i ∈ S_bdry,
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal} ∧
        (∀ α : Fin N, x ∉ Set.range (ιE α).base →
          e_X.base ⁻¹' Set.range (ιE α).base = ∅) ∧
        (∀ α : Fin N, x ∈ Set.range (ιE α).base →
          ∃ i ∈ S_exp, ∃ j ∈ S_exp, i ≠ j ∧
            e_X.base ⁻¹' Set.range (ιE α).base =
              {v : AlgebraicGeometry.Spec R' |
                (∀ a : Fin 2,
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v).asIdeal) ∧
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal ∧
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j)) ∈ (q.base v).asIdeal}))
def IsBaseChangeAlterationModel (F : Type u) [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))))
    (φ_bar : W ⟶ weilBaseChangeOver F (AlgebraicClosure F) X)
    (U_bar : (weilBaseChangeOver F (AlgebraicClosure F) X).left.Opens)
    (L : IntermediateField F (AlgebraicClosure F))
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L)))
    (φ : Y ⟶ weilBaseChangeOver F ↥L X)
    (U : (weilBaseChangeOver F ↥L X).left.Opens) : Prop :=
  ∃ (p_W : W.left ⟶ Y.left)
    (p_X : (weilBaseChangeOver F (AlgebraicClosure F) X).left ⟶
      (weilBaseChangeOver F ↥L X).left),
    CategoryTheory.IsPullback p_W W.hom Y.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L (AlgebraicClosure F)))) ∧
    CategoryTheory.IsPullback p_X
      (weilBaseChangeOver F (AlgebraicClosure F) X).hom
      (weilBaseChangeOver F ↥L X).hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L (AlgebraicClosure F)))) ∧
    p_W ≫ φ.left = φ_bar.left ≫ p_X ∧
    (TopologicalSpace.Opens.map p_X.base).obj U = U_bar
noncomputable abbrev weilGeomScheme (K : Type u) [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))) :
    AlgebraicGeometry.Scheme.{u} :=
  (weilBaseChangeOver K (AlgebraicClosure K) Z).left

noncomputable def weilGeomFrobHom (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))) :
    Quiver.Hom (weilGeomScheme K Z) (weilGeomScheme K Z) :=
  let ψ := (@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
    (AlgebraicClosure K) _ _ _).symm
  let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
  let i₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom)
  let hcomp : CategoryTheory.CategoryStruct.comp
      (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
      (CommRingCat.ofHom ψ.toRingHom) =
      CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)) :=
    (CommRingCat.ofHom_comp _ _).symm.trans (congrArg CommRingCat.ofHom (RingHom.ext ψ.commutes))
  CategoryTheory.Limits.pullback.map Z.hom f₂ Z.hom f₂
    (CategoryTheory.CategoryStruct.id Z.left) i₂
    (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of K)))
    ((CategoryTheory.Category.comp_id Z.hom).trans (CategoryTheory.Category.id_comp Z.hom).symm)
    ((CategoryTheory.Category.comp_id f₂).trans
      ((congrArg AlgebraicGeometry.Spec.map hcomp.symm).trans
        (AlgebraicGeometry.Spec.map_comp _ _)))

noncomputable abbrev weilEtaleTorsionSheaf (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
    CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
  (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))

noncomputable abbrev weilEtaleTorsionH (S : AlgebraicGeometry.Scheme.{u}) (m i : ℕ) : Type u :=
  (weilEtaleTorsionSheaf S m).H i

noncomputable def weilEtaleTorsionTransition (S : AlgebraicGeometry.Scheme.{u}) (ℓ r i : ℕ) :
    weilEtaleTorsionH S (ℓ ^ (r + 1)) i →+ weilEtaleTorsionH S (ℓ ^ r) i :=
  (CategoryTheory.Abelian.Ext.mk₀
    ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map
      (AddCommGrpCat.uliftFunctor.{u, 0}.map
        (AddCommGrpCat.ofHom
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom)))).postcomp
    ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero i)

noncomputable def weilEtaleIntegralSystem (S : AlgebraicGeometry.Scheme.{u}) (ℓ i : ℕ) :
    AddSubgroup (∀ r : ℕ, weilEtaleTorsionH S (ℓ ^ r) i) :=
  AddMonoidHom.ker (AddMonoidHom.pi fun r =>
    (weilEtaleTorsionTransition S ℓ r i).comp
      (Pi.evalAddMonoidHom (fun k => weilEtaleTorsionH S (ℓ ^ k) i) (r + 1)) -
    Pi.evalAddMonoidHom (fun k => weilEtaleTorsionH S (ℓ ^ k) i) r)

def WeilIsTorsionGeomFrobAction (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    (m i : ℕ) (f : weilEtaleTorsionH (weilGeomScheme K Z) m i →+
      weilEtaleTorsionH (weilGeomScheme K Z) m i) : Prop :=
  let S := weilGeomScheme K Z
  let g := weilGeomFrobHom K Z
  let J := S.smallEtaleTopology
  let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  let Fℤ := C.obj (AddCommGrpCat.of (ULift.{u} ℤ))
  let FM := weilEtaleTorsionSheaf S m
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  ∃ (G : CategoryTheory.Functor S.Etale S.Etale),
    (∀ U : S.Etale, (Fgt.obj (G.obj U)).left = (Fgt.obj U).left ∧
      HEq (Fgt.obj (G.obj U)).hom (CategoryTheory.CategoryStruct.comp (Fgt.obj U).hom g)) ∧
    (∀ {U₁ U₂ : S.Etale} (u : Quiver.Hom U₁ U₂), HEq (Fgt.map (G.map u)).left (Fgt.map u).left) ∧
    ∃ (_ : G.IsContinuous J J),
      let P := G.sheafPushforwardContinuous AddCommGrpCat.{u} J J
      ∃ (_ : P.Additive) (_ : CategoryTheory.Limits.PreservesFiniteLimits P)
        (_ : CategoryTheory.Limits.PreservesFiniteColimits P)
        (T : S.Etale) (hT : CategoryTheory.Limits.IsTerminal T) (μ : Quiver.Hom (G.obj T) T),
        (Fgt.obj T).left = S ∧
        HEq (Fgt.obj T).hom (CategoryTheory.CategoryStruct.id S) ∧
        HEq (Fgt.map μ).left g ∧
        let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
        let αℤ : Quiver.Hom Fℤ (P.obj Fℤ) :=
          (adj.homEquiv (AddCommGrpCat.of (ULift.{u} ℤ)) (P.obj Fℤ)).symm
            (CategoryTheory.CategoryStruct.comp (adj.unit.app (AddCommGrpCat.of (ULift.{u} ℤ))) (Fℤ.obj.map μ.op))
        let αM : Quiver.Hom FM (P.obj FM) :=
          (adj.homEquiv (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))) (P.obj FM)).symm
            (CategoryTheory.CategoryStruct.comp (adj.unit.app _) (FM.obj.map μ.op))
        ∃ (βM : Quiver.Hom (P.obj FM) FM),
          CategoryTheory.CategoryStruct.comp αM βM = CategoryTheory.CategoryStruct.id FM ∧
          CategoryTheory.CategoryStruct.comp βM αM = CategoryTheory.CategoryStruct.id (P.obj FM) ∧
          ∀ x : weilEtaleTorsionH S m i,
            f x = (CategoryTheory.Abelian.Ext.mk₀ βM).postcomp Fℤ (Nat.add_zero i)
              ((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P _ _ _ _ _ Fℤ FM i) x) (Nat.zero_add i))

structure WeilEllAdicCohomologyModel (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i : ℕ) where
  V : Type u
  [addCommGroup : AddCommGroup V]
  [module : Module (Padic ℓ) V]
  [finite : Module.Finite (Padic ℓ) V]
  frob : V →ₗ[Padic ℓ] V
  frobTorsion : ∀ r : ℕ, weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) i →+
    weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) i
  hfrobTorsion : ∀ r : ℕ, WeilIsTorsionGeomFrobAction K Z (ℓ ^ r) i (frobTorsion r)
  equiv : TensorProduct ℤ ℚ ↥(weilEtaleIntegralSystem (weilGeomScheme K Z) ℓ i) ≃+ V
  hsmul : ∀ (z : PadicInt ℓ) (x y : ↥(weilEtaleIntegralSystem (weilGeomScheme K Z) ℓ i)),
    (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
      equiv (TensorProduct.tmul ℤ (1 : ℚ) y) = (z : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x)
  hfrob : ∀ (x y : ↥(weilEtaleIntegralSystem (weilGeomScheme K Z) ℓ i)),
    (∀ r : ℕ, y.1 r = frobTorsion r (x.1 r)) →
      frob (equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) = equiv (TensorProduct.tmul ℤ (1 : ℚ) y)

instance instAddCommGroupWeilEllAdicCohomologyModelV {K : Type u} [Finite K] [Field K]
    {Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))}
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {i : ℕ}
    (M : WeilEllAdicCohomologyModel K Z ℓ i) : AddCommGroup M.V :=
  M.addCommGroup

instance instModuleWeilEllAdicCohomologyModelV {K : Type u} [Finite K] [Field K]
    {Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))}
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {i : ℕ}
    (M : WeilEllAdicCohomologyModel K Z ℓ i) : Module (Padic ℓ) M.V :=
  M.module

instance instModuleFiniteWeilEllAdicCohomologyModelV {K : Type u} [Finite K] [Field K]
    {Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))}
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {i : ℕ}
    (M : WeilEllAdicCohomologyModel K Z ℓ i) : Module.Finite (Padic ℓ) M.V :=
  M.finite
def IsSchemeFunctionField (X : AlgebraicGeometry.Scheme.{u})
    (F : Type u) [Field F]
    (η : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X) : Prop :=
  ∀ (U : X.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
    Nonempty ↥U →
    ∃ (φ : X.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of F),
      @IsFractionRing ↑(X.presheaf.obj (Opposite.op U)) _ F _ φ.hom.toAlgebra ∧
      AlgebraicGeometry.Spec.map φ ≫ hU.fromSpec = η

def IsGeometricStablePointedCurve {C S : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C)) : Prop :=
  3 ≤ n ∧
  AlgebraicGeometry.Flat g ∧
  AlgebraicGeometry.IsProper g ∧
  AlgebraicGeometry.LocallyOfFinitePresentation g ∧
  AlgebraicGeometry.Surjective g ∧
  (∀ j : Fin n, τ j ≫ g = 𝟙 S) ∧
  (_root_.Pairwise fun i j : Fin n =>
    Disjoint (Set.range (τ i).base) (Set.range (τ j).base)) ∧
  (∀ (j : Fin n) (b : S), ∃ V : C.Opens,
    (τ j).base b ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)) ∧
  (∀ (K : Type u) [Field K] [IsAlgClosed K]
      (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ S),
    ConnectedSpace ↥(CategoryTheory.Limits.pullback g s) ∧
    (∀ y : ↥(CategoryTheory.Limits.pullback g s),
      (∃ V : (CategoryTheory.Limits.pullback g s).Opens,
        y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
          (V.ι ≫ CategoryTheory.Limits.pullback.snd g s)) ∨
      (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ CategoryTheory.Limits.pullback g s)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = y ∧
        (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
        e₁ ≫ CategoryTheory.Limits.pullback.snd g s =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))) ∧
    (∀ (E : Set ↥(CategoryTheory.Limits.pullback g s))
        (E_sch : AlgebraicGeometry.Scheme.{u})
        (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g s),
      E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s) →
      AlgebraicGeometry.IsClosedImmersion ιE →
      AlgebraicGeometry.IsIntegral E_sch →
      Set.range ιE.base = E →
      (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver K 1).left,
        ιE ≫ CategoryTheory.Limits.pullback.snd g s =
          isoP1.hom ≫ (weilProjectiveSpaceOver K 1).hom) →
      ∃ q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback g s),
        q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
        q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
        (∀ q ∈ ({q₁, q₂, q₃} : Set ↥(CategoryTheory.Limits.pullback g s)),
          (∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s),
            E' ≠ E ∧ q ∈ E') ∨
          (∃ j : Fin n,
            (CategoryTheory.Limits.pullback.fst g s).base q ∈ Set.range (τ j).base))))

def HasLocalPointedPullbackIsoOnOpen (k : Type u) [Field k]
    {X₂ B₂ B₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (f₂ : X₂ ⟶ B₂) {n : ℕ} (σ : Fin n → (B₂ ⟶ X₂))
    (ψ₃ : B₃ ⟶ B₂) (U₃ W_a : B₃.left.Opens)
    {C_a : AlgebraicGeometry.Scheme.{u}}
    (g_a : C_a ⟶ W_a.toScheme) (τ_a : Fin n → (W_a.toScheme ⟶ C_a)) : Prop :=
  let V_a : C_a.Opens := (TopologicalSpace.Opens.map (g_a ≫ W_a.ι).base).obj U₃
  ∃ (ι_a : V_a.toScheme ⟶ X₂.left)
    (hcomm_a : ι_a ≫ f₂.left = V_a.ι ≫ g_a ≫ W_a.ι ≫ ψ₃.left),
    AlgebraicGeometry.IsOpenImmersion
      (CategoryTheory.Limits.pullback.lift ι_a (V_a.ι ≫ g_a ≫ W_a.ι) hcomm_a) ∧
    Set.range (CategoryTheory.Limits.pullback.lift ι_a (V_a.ι ≫ g_a ≫ W_a.ι) hcomm_a).base =
      (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base ⁻¹'
        ((W_a ⊓ U₃ : B₃.left.Opens) : Set B₃.left) ∧
    ∀ j : Fin n,
      ∃ s_a : (W_a ⊓ U₃).toScheme ⟶ V_a.toScheme,
        s_a ≫ V_a.ι = B₃.left.homOfLE inf_le_left ≫ τ_a j ∧
        s_a ≫ ι_a = (W_a ⊓ U₃).ι ≫ ψ₃.left ≫ (σ j).left
def IsReducedClosedBlowupOver (k : Type u) [Field k]
    {X X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (K : Set X.left) (π : X' ⟶ X) : Prop :=
  IsClosed K ∧
  (∃ (U₀ : X.left.Opens),
    (U₀ : Set X.left) = Kᶜ ∧
    Nonempty U₀ ∧
    CategoryTheory.IsIso (π.left ∣_ U₀)) ∧
  ∀ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
    (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
    (r : ℕ) (g : Fin r → R'),
    AlgebraicGeometry.Etale e_X →
    (Ideal.span (Set.range g)).IsRadical →
    (∀ b : Fin r, g b ∈ nonZeroDivisors R') →
    e_X.base ⁻¹' K = {v : AlgebraicGeometry.Spec R' | ∀ a : Fin r, g a ∈ v.asIdeal} →
    ∀ x' : X'.left,
      π.left.base x' = e_X.base v₀ →
      ∃ (b : Fin r) (B' : CommRingCat.{u}) (w₀ : AlgebraicGeometry.Spec B')
        (e'_X : AlgebraicGeometry.Spec B' ⟶ X'.left)
        (q_b : AlgebraicGeometry.Spec B' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin r) R' ⧸
            RingHom.ker ((MvPolynomial.aeval (R := R')
              (fun a : Fin r =>
                algebraMap R' (Localization.Away (g b)) (g a) *
                  IsLocalization.Away.invSelf (S := Localization.Away (g b)) (g b))).toRingHom)))),
        AlgebraicGeometry.Etale e'_X ∧
        AlgebraicGeometry.Etale q_b ∧
        e'_X.base w₀ = x' ∧
        (q_b ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((Ideal.Quotient.mk _).comp MvPolynomial.C))).base w₀ = v₀ ∧
        e'_X ≫ π.left =
          q_b ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_X
def IsProjectiveIdealBlowupOver (k : Type u) [Field k]
    {X X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (I : X.left.IdealSheafData) (π : X' ⟶ X) : Prop :=
  AlgebraicGeometry.IsIntegral X'.left ∧
  IsProjectiveOverField k X' ∧
  AlgebraicGeometry.IsProper π.left ∧
  AlgebraicGeometry.Surjective π.left ∧
  (∀ (U₀ : X.left.Opens),
    Disjoint (U₀ : Set X.left) (I.support : Set X.left) →
    CategoryTheory.IsIso (π.left ∣_ U₀)) ∧
  (∀ (U : X.left.affineOpens) (B' : CommRingCat.{u})
      (φ_U : ↑(X.left.presheaf.obj (Opposite.op U.1)) →+* B')
      (r : ℕ) (g : Fin r → B'),
    AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U)) →
    (∀ b : Fin r, g b ∈ nonZeroDivisors B') →
    Ideal.map φ_U (I.ideal U) = Ideal.span (Set.range g) →
    ∃ (W : Fin r → (CategoryTheory.Limits.pullback π.left
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U) ≫ U.2.fromSpec)).Opens)
      (isoW : ∀ b : Fin r, (W b).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
        ↥(Algebra.adjoin B' (Set.range fun a : Fin r =>
          IsLocalization.mk' (Localization.Away (g b)) (g a)
            ⟨g b, Submonoid.mem_powers (g b)⟩)))),
      (⨆ b : Fin r, W b) = ⊤ ∧
      (∀ b : Fin r,
        (W b).ι ≫ CategoryTheory.Limits.pullback.snd π.left
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U) ≫ U.2.fromSpec) =
          (isoW b).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B' _))))

def IsToroidalResolutionState (k : Type u) [Field k] (m : ℕ)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_B₁ : Set B₁.left)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_X : Set X.left) (f : X ⟶ B₁)
    (K : ℕ) (T : Fin K → TopologicalSpace.Closeds ↥X.left) (n_T : Fin K → ℕ) : Prop :=
  IsClosed Z_X ∧
  (∃ (x₀ : X.left) (V₀ : X.left.Opens),
    x₀ ∈ V₀ ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V₀.ι ≫ X.hom)) ∧
  (∀ α : Fin K, 2 ≤ n_T α) ∧
  (∀ α : Fin K, IsIrreducible (T α : Set X.left)) ∧
  (_root_.Pairwise fun α β : Fin K => T α ≠ T β) ∧
  ∃ (r_B : ℕ) (D_B : Fin r_B → AlgebraicGeometry.Scheme.{u})
    (ιD_B : ∀ i : Fin r_B, D_B i ⟶ B₁.left),
    (∀ i : Fin r_B, AlgebraicGeometry.IsClosedImmersion (ιD_B i)) ∧
    (∀ i : Fin r_B, AlgebraicGeometry.IsIntegral (D_B i)) ∧
    (_root_.Pairwise fun i j : Fin r_B => Set.range (ιD_B i).base ≠ Set.range (ιD_B j).base) ∧
    Z_B₁ = (⋃ i : Fin r_B, Set.range (ιD_B i).base) ∧
    (∀ y : B₁.left, ∃ (U : B₁.left.Opens),
      AlgebraicGeometry.IsAffineOpen U ∧ y ∈ U ∧
      ∃ (ψ : MvPolynomial (Fin m) k →+* ↑(B₁.left.presheaf.obj (Opposite.op U))),
        AlgebraicGeometry.Etale (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
        (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = U.ι ≫ B₁.hom) ∧
        ∃ (α : {i : Fin r_B // Nonempty ↑((TopologicalSpace.Opens.map (ιD_B i).base).obj U)} → Fin m),
          Function.Injective α ∧
          ∀ (i : Fin r_B) (hi : Nonempty ↑((TopologicalSpace.Opens.map (ιD_B i).base).obj U)),
            RingHom.ker ((ιD_B i).app U).hom =
              Ideal.span {ψ (MvPolynomial.X (α ⟨i, hi⟩))}) ∧
    ∀ x : X.left,
      ((∀ α : Fin K, x ∉ (T α : Set X.left)) ∧
        ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
          (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
          (ψ : MvPolynomial (Fin (m + 1)) k →+* R')
          (I : Finset (Fin (m + 1))),
          AlgebraicGeometry.Etale e_X ∧
          AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
          e_X.base v₀ = x ∧
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_X ≫ X.hom) ∧
          (∀ i ∈ I, ψ (MvPolynomial.X i) ∈ v₀.asIdeal) ∧
          e_X.base ⁻¹' Z_X =
            {v : AlgebraicGeometry.Spec R' | ∃ i ∈ I, ψ (MvPolynomial.X i) ∈ v.asIdeal}) ∨
      (∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
          (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
          (a : Fin m → ℕ) (S_bdry : Finset (Fin m))
          (ρ : {c : Fin m // 1 ≤ a c} → Fin r_B)
          (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
              {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
                ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c}))),
        AlgebraicGeometry.Etale e_X ∧
        AlgebraicGeometry.Etale q ∧
        e_X.base v₀ = x ∧
        2 ≤ (∑ c : Fin m, a c) ∧
        (∀ c : Fin m, 1 ≤ a c → c ∈ S_bdry) ∧
        Function.Injective ρ ∧
        (q ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom) ∧
        (∀ b : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v₀).asIdeal) ∧
        (∀ c ∈ S_bdry,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v₀).asIdeal) ∧
        e_X.base ⁻¹' Z_X =
          {v : AlgebraicGeometry.Spec R' |
            ∃ c ∈ S_bdry,
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v).asIdeal} ∧
        (∀ (c : Fin m) (hc : 1 ≤ a c),
          (e_X ≫ f.left).base ⁻¹' Set.range (ιD_B (ρ ⟨c, hc⟩)).base =
            {v : AlgebraicGeometry.Spec R' |
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v).asIdeal}) ∧
        (∀ α : Fin K, x ∉ (T α : Set X.left) →
          e_X.base ⁻¹' (T α : Set X.left) = ∅) ∧
        (∀ α : Fin K, x ∈ (T α : Set X.left) →
          ∃ c : Fin m, a c = n_T α ∧
            e_X.base ⁻¹' (T α : Set X.left) =
              {v : AlgebraicGeometry.Spec R' |
                (∀ b : Fin 2,
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v).asIdeal}) ∧
        (∀ c : Fin m, 2 ≤ a c →
          ∃ α : Fin K, x ∈ (T α : Set X.left) ∧
            e_X.base ⁻¹' (T α : Set X.left) =
              {v : AlgebraicGeometry.Spec R' |
                (∀ b : Fin 2,
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v).asIdeal}))

def IsEtaleToroidalSquarefreeData (k : Type u) [Field k] (m N : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z : Set X.left) : Prop :=
  IsClosed Z ∧
  ∃ (E : Fin N → AlgebraicGeometry.Scheme.{u})
    (ιE : ∀ α : Fin N, E α ⟶ X.left),
    (∀ α : Fin N, AlgebraicGeometry.IsClosedImmersion (ιE α)) ∧
    (∀ α : Fin N, AlgebraicGeometry.IsIntegral (E α)) ∧
    (∀ (α : Fin N) (z : E α),
      ∃ (R' : CommRingCat.{u}) (w₀ : AlgebraicGeometry.Spec R')
        (e_E : AlgebraicGeometry.Spec R' ⟶ E α)
        (ψ_E : MvPolynomial (Fin (m - 2)) k →+* R'),
        AlgebraicGeometry.Etale e_E ∧
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_E)) ∧
        e_E.base w₀ = z ∧
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_E) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
            e_E ≫ ιE α ≫ X.hom)) ∧
    (_root_.Pairwise fun α β : Fin N => Set.range (ιE α).base ≠ Set.range (ιE β).base) ∧
    ∀ x : X.left,
      ((x ∉ ⋃ α : Fin N, Set.range (ιE α).base) ∧
        ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
          (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
          (ψ : MvPolynomial (Fin (m + 1)) k →+* R')
          (I : Finset (Fin (m + 1))),
          AlgebraicGeometry.Etale e_X ∧
          AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
          e_X.base v₀ = x ∧
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_X ≫ X.hom) ∧
          (∀ i ∈ I, ψ (MvPolynomial.X i) ∈ v₀.asIdeal) ∧
          e_X.base ⁻¹' Z =
            {v : AlgebraicGeometry.Spec R' | ∃ i ∈ I, ψ (MvPolynomial.X i) ∈ v.asIdeal}) ∨
      ((x ∈ ⋃ α : Fin N, Set.range (ιE α).base) ∧
        ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
          (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
          (S_exp S_bdry : Finset (Fin m))
          (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
              {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
                ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)}))),
          AlgebraicGeometry.Etale e_X ∧
          AlgebraicGeometry.Etale q ∧
          e_X.base v₀ = x ∧
          2 ≤ S_exp.card ∧
          S_exp ⊆ S_bdry ∧
          (q ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom) ∧
          (∀ a : Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v₀).asIdeal) ∧
          (∀ i ∈ S_bdry,
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v₀).asIdeal) ∧
          e_X.base ⁻¹' Z =
            {v : AlgebraicGeometry.Spec R' |
              ∃ i ∈ S_bdry,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal} ∧
          (∀ α : Fin N, x ∉ Set.range (ιE α).base →
            e_X.base ⁻¹' Set.range (ιE α).base = ∅) ∧
          (∀ α : Fin N, x ∈ Set.range (ιE α).base →
            ∃ i ∈ S_exp, ∃ j ∈ S_exp, i ≠ j ∧
              e_X.base ⁻¹' Set.range (ιE α).base =
                {v : AlgebraicGeometry.Spec R' |
                  (∀ a : Fin 2,
                    Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v).asIdeal) ∧
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal ∧
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j)) ∈ (q.base v).asIdeal}))
def IsLocalThreeSecantSmoothSubschemeOver (k : Type u) [Field k]
    {X B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (f : X ⟶ B) (W_B : B.left.Opens)
    {H : AlgebraicGeometry.Scheme.{u}} (ιH : H ⟶ X.left) : Prop :=
  ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B.left),
    Set.range s.base ⊆ (W_B : Set B.left) →
    ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f.left s),
      ∃ (q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback f.left s))
        (W₁ W₂ W₃ : X.left.Opens),
        q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
        q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
        (CategoryTheory.Limits.pullback.fst f.left s).base q₁ ∈ Set.range ιH.base ∧
        (CategoryTheory.Limits.pullback.fst f.left s).base q₂ ∈ Set.range ιH.base ∧
        (CategoryTheory.Limits.pullback.fst f.left s).base q₃ ∈ Set.range ιH.base ∧
        (CategoryTheory.Limits.pullback.fst f.left s).base q₁ ∈ W₁ ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₁.ι ≫ f.left) ∧
        (CategoryTheory.Limits.pullback.fst f.left s).base q₂ ∈ W₂ ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₂.ι ≫ f.left) ∧
        (CategoryTheory.Limits.pullback.fst f.left s).base q₃ ∈ W₃ ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₃.ι ≫ f.left)

def HasPullbackSectionCoverOverOpen
    {D B₀ B₂ : AlgebraicGeometry.Scheme.{u}}
    (p : D ⟶ B₀) (ψ : B₂ ⟶ B₀) (W : B₀.Opens) : Prop :=
  ∃ (k_D : ℕ) (γ : Fin k_D → (B₂ ⟶ CategoryTheory.Limits.pullback p ψ)),
    (∀ j : Fin k_D, γ j ≫ CategoryTheory.Limits.pullback.snd p ψ = 𝟙 B₂) ∧
    (CategoryTheory.Limits.pullback.snd p ψ).base ⁻¹' (ψ.base ⁻¹' (W : Set B₀)) ⊆
      ⋃ j : Fin k_D, Set.range (γ j).base
noncomputable def weilBaseChangeMap (F E K : Type u) [CommRing F] [CommRing E] [CommRing K]
    [Algebra F E] [Algebra E K] [Algebra F K] [IsScalarTower F E K]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))) :
    (weilBaseChangeOver F K X).left ⟶ (weilBaseChangeOver F E X).left :=
  (CategoryTheory.Limits.pullback.lift
    (CategoryTheory.Limits.pullback.fst X.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F K))))
    (CategoryTheory.Limits.pullback.snd X.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F K))) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E K)))
    (by
      rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq F E K]
      exact CategoryTheory.Limits.pullback.condition) :
    CategoryTheory.Limits.pullback X.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F K))) ⟶
    CategoryTheory.Limits.pullback X.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E))))
def IsSplitEtaleNcPair (k : Type u) [Field k] (m k₀ : ℕ)
    (S' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_total : Set S'.left) : Prop :=
  ∃ (q : ℕ) (H : Fin q → AlgebraicGeometry.Scheme.{u})
    (ιH : ∀ a : Fin q, H a ⟶ S'.left) (Z_nc : Set S'.left),
    (∀ a : Fin q, AlgebraicGeometry.IsClosedImmersion (ιH a)) ∧
    (∀ a : Fin q, AlgebraicGeometry.IsIntegral (H a)) ∧
    (∀ a : Fin q, AlgebraicGeometry.SmoothOfRelativeDimension m (ιH a ≫ S'.hom)) ∧
    (_root_.Pairwise fun a₁ a₂ : Fin q => Set.range (ιH a₁).base ≠ Set.range (ιH a₂).base) ∧
    IsClosed Z_nc ∧
    Z_total = (⋃ a : Fin q, Set.range (ιH a).base) ∪ Z_nc ∧
    ∀ x : S'.left, ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
      (e_S : AlgebraicGeometry.Spec R' ⟶ S'.left)
      (ψ : MvPolynomial (Fin (m + 1)) k →+* R')
      (α_snc : {a : Fin q // x ∈ Set.range (ιH a).base} → Fin (m + 1))
      (I_nc : Finset (Fin (m + 1))),
      AlgebraicGeometry.Etale e_S ∧
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
      e_S.base v₀ = x ∧
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_S ≫ S'.hom) ∧
      Function.Injective α_snc ∧
      (∀ (a : {a : Fin q // x ∈ Set.range (ιH a).base}) (j : Fin (m + 1)),
        j ∈ I_nc → α_snc a ≠ j) ∧
      I_nc.card ≤ k₀ ∧
      (∀ a : {a : Fin q // x ∈ Set.range (ιH a).base},
        ψ (MvPolynomial.X (α_snc a)) ∈ v₀.asIdeal) ∧
      (∀ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v₀.asIdeal) ∧
      (∀ a : Fin q, x ∉ Set.range (ιH a).base →
        e_S.base ⁻¹' Set.range (ιH a).base = ∅) ∧
      (∀ a : Fin q, ∀ hax : x ∈ Set.range (ιH a).base,
        e_S.base ⁻¹' Set.range (ιH a).base =
          {v : AlgebraicGeometry.Spec R' | ψ (MvPolynomial.X (α_snc ⟨a, hax⟩)) ∈ v.asIdeal}) ∧
      e_S.base ⁻¹' Z_nc =
        {v : AlgebraicGeometry.Spec R' | ∃ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v.asIdeal}

def IsMaxMultiplicityNcCenter (k : Type u) [Field k] (m b : ℕ)
    (S' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (q : ℕ) (H : Fin q → AlgebraicGeometry.Scheme.{u})
    (ιH : ∀ a : Fin q, H a ⟶ S'.left) (Z_nc : Set S'.left)
    (s : ℕ) (C_comp : Fin s → AlgebraicGeometry.Scheme.{u})
    (ιC : ∀ β : Fin s, C_comp β ⟶ S'.left) : Prop :=
  (∀ a : Fin q, AlgebraicGeometry.IsClosedImmersion (ιH a)) ∧
  (∀ a : Fin q, AlgebraicGeometry.IsIntegral (H a)) ∧
  (∀ a : Fin q, AlgebraicGeometry.SmoothOfRelativeDimension m (ιH a ≫ S'.hom)) ∧
  (_root_.Pairwise fun a₁ a₂ : Fin q => Set.range (ιH a₁).base ≠ Set.range (ιH a₂).base) ∧
  IsClosed Z_nc ∧
  (∀ β : Fin s, AlgebraicGeometry.IsClosedImmersion (ιC β)) ∧
  (∀ β : Fin s, AlgebraicGeometry.IsIntegral (C_comp β)) ∧
  (∀ β : Fin s, AlgebraicGeometry.SmoothOfRelativeDimension (m - 1 - b) (ιC β ≫ S'.hom)) ∧
  (_root_.Pairwise fun β₁ β₂ : Fin s => Disjoint (Set.range (ιC β₁).base) (Set.range (ιC β₂).base)) ∧
  (⋃ β : Fin s, Set.range (ιC β).base) ⊆ Z_nc ∧
  ∀ x : S'.left, ∃ (R' : CommRingCat.{u}) (_ : IsDomain R') (v₀ : AlgebraicGeometry.Spec R')
    (e_S : AlgebraicGeometry.Spec R' ⟶ S'.left)
    (ψ : MvPolynomial (Fin (m + 1)) k →+* R')
    (α_snc : {a : Fin q // x ∈ Set.range (ιH a).base} → Fin (m + 1))
    (I_nc : Finset (Fin (m + 1))),
    AlgebraicGeometry.Etale e_S ∧
    AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
    e_S.base v₀ = x ∧
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_S ≫ S'.hom) ∧
    Function.Injective α_snc ∧
    (∀ (a : {a : Fin q // x ∈ Set.range (ιH a).base}) (j : Fin (m + 1)),
      j ∈ I_nc → α_snc a ≠ j) ∧
    (∀ a : {a : Fin q // x ∈ Set.range (ιH a).base},
      ψ (MvPolynomial.X (α_snc a)) ∈ v₀.asIdeal) ∧
    (∀ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v₀.asIdeal) ∧
    (∀ a : Fin q, x ∉ Set.range (ιH a).base →
      e_S.base ⁻¹' Set.range (ιH a).base = ∅) ∧
    (∀ a : Fin q, ∀ hax : x ∈ Set.range (ιH a).base,
      e_S.base ⁻¹' Set.range (ιH a).base =
        {v : AlgebraicGeometry.Spec R' | ψ (MvPolynomial.X (α_snc ⟨a, hax⟩)) ∈ v.asIdeal}) ∧
    e_S.base ⁻¹' Z_nc =
      {v : AlgebraicGeometry.Spec R' | ∃ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v.asIdeal} ∧
    (∀ β : Fin s, x ∉ Set.range (ιC β).base →
      e_S.base ⁻¹' Set.range (ιC β).base = ∅) ∧
    ((x ∉ ⋃ β : Fin s, Set.range (ιC β).base ∧ I_nc.card ≤ b + 1) ∨
      (∃ β : Fin s, x ∈ Set.range (ιC β).base ∧ I_nc.card = b + 2 ∧
        e_S.base ⁻¹' Set.range (ιC β).base =
          {v : AlgebraicGeometry.Spec R' | ∀ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v.asIdeal}))
def IsAffineNormalScheme (X : AlgebraicGeometry.Scheme.{u}) : Prop :=
  ∀ (U : X.Opens), AlgebraicGeometry.IsAffineOpen U → Nonempty U →
    IsDomain ↑(X.presheaf.obj (Opposite.op U)) ∧
    IsIntegrallyClosed ↑(X.presheaf.obj (Opposite.op U))

def IsOpenGraphStrictTransformPairOver (k : Type u) [Field k]
    {X₂ B₂ B₃ C₃ X₃ T₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (f₂ : X₂ ⟶ B₂) {n : ℕ} (σ : Fin n → (B₂ ⟶ X₂))
    (ψ₃ : B₃ ⟶ B₂) (U₃ : B₃.left.Opens)
    (g₃ : C₃ ⟶ B₃) (τ₃ : Fin n → (B₃ ⟶ C₃))
    (pX₃ : X₃ ⟶ B₃) (qX₃ : X₃ ⟶ X₂)
    (pT₃ : T₃ ⟶ B₃) (rC₃ : T₃ ⟶ C₃) (rX₃ : T₃ ⟶ X₃) : Prop :=
  let V₃_C : C₃.left.Opens := (TopologicalSpace.Opens.map g₃.left.base).obj U₃
  let V₃_X : X₃.left.Opens := (TopologicalSpace.Opens.map pX₃.left.base).obj U₃
  let V₃_T : T₃.left.Opens := (TopologicalSpace.Opens.map pT₃.left.base).obj U₃
  let W₃_pb : (CategoryTheory.Limits.pullback f₂.left ψ₃.left).Opens :=
    (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base).obj U₃
  AlgebraicGeometry.IsIntegral X₃.left ∧
  IsProjectiveOverField k X₃ ∧
  AlgebraicGeometry.Flat (pX₃.left ∣_ U₃) ∧
  AlgebraicGeometry.Surjective (pX₃.left ∣_ U₃) ∧
  AlgebraicGeometry.IsIntegral T₃.left ∧
  IsProjectiveOverField k T₃ ∧
  AlgebraicGeometry.Flat (pT₃.left ∣_ U₃) ∧
  AlgebraicGeometry.Surjective (pT₃.left ∣_ U₃) ∧
  (∃ hcommX : qX₃.left ≫ f₂.left = pX₃.left ≫ ψ₃.left,
    AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift qX₃.left pX₃.left hcommX) ∧
    CategoryTheory.IsIso
      ((CategoryTheory.Limits.pullback.lift qX₃.left pX₃.left hcommX) ∣_ W₃_pb)) ∧
  (∃ hcommT : rC₃.left ≫ g₃.left = rX₃.left ≫ pX₃.left,
    rC₃ ≫ g₃ = pT₃ ∧
    AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift rC₃.left rX₃.left hcommT)) ∧
  CategoryTheory.IsIso (rC₃.left ∣_ V₃_C) ∧
  CategoryTheory.IsIso (rX₃.left ∣_ V₃_X) ∧
  (∀ j : Fin n, ∃ uT₃ : U₃.toScheme ⟶ V₃_T.toScheme,
    uT₃ ≫ V₃_T.ι ≫ rC₃.left = U₃.ι ≫ (τ₃ j).left ∧
    uT₃ ≫ V₃_T.ι ≫ rX₃.left ≫ qX₃.left = U₃.ι ≫ ψ₃.left ≫ (σ j).left)

def IsFlattenedNormalPointedCorrespondenceOver (k : Type u) [Field k]
    {X₂ B₂ B C X_B T_B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (f₂ : X₂ ⟶ B₂) {n : ℕ} (σ : Fin n → (B₂ ⟶ X₂))
    (ψ : B ⟶ B₂) (U_B : B.left.Opens)
    (f : C ⟶ B) (τ : Fin n → (B ⟶ C))
    (f_XB : X_B ⟶ B) (σ_B : Fin n → (B ⟶ X_B)) (qX_B : X_B ⟶ X₂)
    (f_TB : T_B ⟶ B) (pr₁ : T_B ⟶ C) (pr₂ : T_B ⟶ X_B) : Prop :=
  let V_CB : C.left.Opens := (TopologicalSpace.Opens.map f.left.base).obj U_B
  let V_XB : X_B.left.Opens := (TopologicalSpace.Opens.map f_XB.left.base).obj U_B
  let W_B_pb : (CategoryTheory.Limits.pullback f₂.left ψ.left).Opens :=
    (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.snd f₂.left ψ.left).base).obj U_B
  3 ≤ n ∧
  IsAffineNormalScheme B.left ∧
  IsAffineNormalScheme C.left ∧
  AlgebraicGeometry.IsIntegral X_B.left ∧
  IsProjectiveOverField k X_B ∧
  AlgebraicGeometry.IsProper f_XB.left ∧
  AlgebraicGeometry.Flat f_XB.left ∧
  AlgebraicGeometry.Surjective f_XB.left ∧
  (∀ j : Fin n, σ_B j ≫ f_XB = 𝟙 B ∧ σ_B j ≫ qX_B = ψ ≫ σ j) ∧
  (∃ hcommXB : qX_B.left ≫ f₂.left = f_XB.left ≫ ψ.left,
    CategoryTheory.IsIso
      ((CategoryTheory.Limits.pullback.lift qX_B.left f_XB.left hcommXB) ∣_ W_B_pb)) ∧
  (∀ (W : X_B.left.Opens),
    AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f_XB.left) →
    ∀ x ∈ W, ∃ (U : X_B.left.Opens),
      AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U ∧ U ≤ W ∧
      IsDomain ↑(X_B.left.presheaf.obj (Opposite.op U)) ∧
      IsIntegrallyClosed ↑(X_B.left.presheaf.obj (Opposite.op U))) ∧
  (∀ (K : Type u) [Field K] [IsAlgClosed K]
      (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B.left)
      (E : Set ↥(CategoryTheory.Limits.pullback f_XB.left s)),
    E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f_XB.left s) →
    topologicalKrullDim ↥E = (1 : WithBot ℕ∞) ∧
    ∃ (j₁ j₂ j₃ : Fin n)
      (q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback f_XB.left s))
      (W₁ W₂ W₃ : X_B.left.Opens),
      q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
      q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
      (CategoryTheory.Limits.pullback.fst f_XB.left s).base q₁ ∈ Set.range (σ_B j₁).left.base ∧
      (CategoryTheory.Limits.pullback.fst f_XB.left s).base q₂ ∈ Set.range (σ_B j₂).left.base ∧
      (CategoryTheory.Limits.pullback.fst f_XB.left s).base q₃ ∈ Set.range (σ_B j₃).left.base ∧
      (CategoryTheory.Limits.pullback.fst f_XB.left s).base q₁ ∈ W₁ ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₁.ι ≫ f_XB.left) ∧
      (CategoryTheory.Limits.pullback.fst f_XB.left s).base q₂ ∈ W₂ ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₂.ι ≫ f_XB.left) ∧
      (CategoryTheory.Limits.pullback.fst f_XB.left s).base q₃ ∈ W₃ ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₃.ι ≫ f_XB.left)) ∧
  AlgebraicGeometry.IsIntegral T_B.left ∧
  IsProjectiveOverField k T_B ∧
  AlgebraicGeometry.Flat f_TB.left ∧
  (∃ hcommTB : pr₁.left ≫ f.left = pr₂.left ≫ f_XB.left,
    pr₁ ≫ f = f_TB ∧
    pr₂ ≫ f_XB = f_TB ∧
    AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift pr₁.left pr₂.left hcommTB)) ∧
  CategoryTheory.IsIso (pr₁.left ∣_ V_CB) ∧
  CategoryTheory.IsIso (pr₂.left ∣_ V_XB) ∧
  (∀ j : Fin n, ∃ τ_tilde : B ⟶ T_B,
    τ_tilde ≫ pr₁ = τ j ∧ τ_tilde ≫ pr₂ = σ_B j)
def WeilSymplecticCurveTracePackage.{u} (ℓ q n : ℕ) [Fact (Nat.Prime ℓ)]
    (γ : AlgebraicClosure (Padic ℓ)) : Prop :=
  γ ≠ 0 ∧
  ∃ (M : ℕ) (c : ℕ → ℕ) (A : ∀ d : ℕ, Fin (c d) → Matrix (Fin M) (Fin M) ℚ),
    c 0 = 0 ∧
    (∀ d : ℕ, 1 ≤ d → c d ≤ q ^ d) ∧
    (∀ (d : ℕ) (j : Fin (c d)) (z : ℂ),
      z ∈ ((A d j).charpoly).aroots ℂ →
        z ≠ 0 ∧ ((q : ℂ) ^ (n * d)) / z ∈ ((A d j).charpoly).aroots ℂ) ∧
    (∃ (V₁ : Type u) (_ : AddCommGroup V₁) (_ : Module (Padic ℓ) V₁)
        (_ : Module.Finite (Padic ℓ) V₁) (Φ₁ : V₁ →ₗ[Padic ℓ] V₁),
      γ ∈ (Φ₁.charpoly).aroots (AlgebraicClosure (Padic ℓ)) ∧
      ((q : AlgebraicClosure (Padic ℓ)) ^ (n + 1)) / γ ∈
        (Φ₁.charpoly).aroots (AlgebraicClosure (Padic ℓ)) ∧
      ∀ r : ℕ, 1 ≤ r →
        ((∑ d ∈ Nat.divisors r, ∑ j : Fin (c d),
            (d : ℚ) * Matrix.trace (A d j ^ (r / d)) : ℚ) : Padic ℓ) =
          - LinearMap.trace (Padic ℓ) V₁ (Φ₁ ^ r)) ∧
    ∀ k : ℕ, 1 ≤ k →
      ∃ (N_k : ℕ) (V₂ₖ : Type u) (_ : AddCommGroup V₂ₖ) (_ : Module (Padic ℓ) V₂ₖ)
          (_ : Module.Finite (Padic ℓ) V₂ₖ) (Φ₂ₖ : V₂ₖ →ₗ[Padic ℓ] V₂ₖ),
        ∀ r : ℕ, 1 ≤ r →
          ((∑ d ∈ Nat.divisors r, ∑ j : Fin (c d),
              (d : ℚ) * (Matrix.trace (A d j ^ (r / d))) ^ (2 * k) : ℚ) : Padic ℓ) =
            (N_k : Padic ℓ) * ((q : Padic ℓ) ^ (k * n + 1)) ^ r -
              LinearMap.trace (Padic ℓ) V₂ₖ (Φ₂ₖ ^ r)
def weilSchemeEndPow {S : AlgebraicGeometry.Scheme.{u}} (g : Quiver.Hom S S) :
    ℕ → Quiver.Hom S S
  | 0 => CategoryTheory.CategoryStruct.id S
  | k + 1 => CategoryTheory.CategoryStruct.comp g (weilSchemeEndPow g k)

def WeilIsTorsionEtalePullback {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom S₁ S₂) (m i : ℕ)
    (p : weilEtaleTorsionH S₂ m i →+ weilEtaleTorsionH S₁ m i) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor S₂.Etale S₁.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  let J₁ := S₁.smallEtaleTopology
  let J₂ := S₂.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  ∃ (_ : B.IsContinuous J₂ J₁),
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    ∃ (_ : P_push.IsRightAdjoint),
      let P_pull := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
      let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
      ∃ (_ : P_pull.Additive)
        (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
        (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
        (T₁ : S₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        (T₂ : S₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
        let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
        let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
        let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
        let πℤ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
          (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
            ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
              (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
                ((C₁.obj Aℤ).obj.map τ.op)))
        let πM : Quiver.Hom (P_pull.obj (C₂.obj AM)) (C₁.obj AM) :=
          (adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM)).symm
            ((adj₂.homEquiv AM (P_push.obj (C₁.obj AM))).symm
              (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM)
                ((C₁.obj AM).obj.map τ.op)))
        ∃ (ιℤ : Quiver.Hom (C₁.obj Aℤ) (P_pull.obj (C₂.obj Aℤ))),
          CategoryTheory.CategoryStruct.comp ιℤ πℤ = CategoryTheory.CategoryStruct.id (C₁.obj Aℤ) ∧
          CategoryTheory.CategoryStruct.comp πℤ ιℤ = CategoryTheory.CategoryStruct.id (P_pull.obj (C₂.obj Aℤ)) ∧
          ∀ x : weilEtaleTorsionH S₂ m i,
            p x = (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp (C₁.obj Aℤ) (Nat.add_zero i)
              ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull _ _ _ _ _ (C₂.obj Aℤ) (C₂.obj AM) i) x)
                (Nat.zero_add i))
noncomputable abbrev weilEtaleModuleUnit (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
    CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) :=
  (CategoryTheory.constantSheaf S.smallEtaleTopology
    (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))).obj
    (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m)))

noncomputable abbrev weilEtaleModuleH (S : AlgebraicGeometry.Scheme.{u}) (m i : ℕ) : Type u :=
  CategoryTheory.Abelian.Ext.{u} (weilEtaleModuleUnit S m) (weilEtaleModuleUnit S m) i

def WeilIsModuleToTorsionComparison (S : AlgebraicGeometry.Scheme.{u}) (m i : ℕ)
    (θ : weilEtaleModuleH S m i →+ weilEtaleTorsionH S m i) : Prop :=
  let R := ULift.{u, 0} (ZMod m)
  let J := S.smallEtaleTopology
  let Cℤ := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  let Fℤ := Cℤ.obj (AddCommGrpCat.of (ULift.{u} ℤ))
  let FM := weilEtaleTorsionSheaf S m
  let oneR := weilEtaleModuleUnit S m
  let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let ιM : Quiver.Hom (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
      (FgtMod.obj (ModuleCat.of R R)) :=
    AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let ιℤ : Quiver.Hom (AddCommGrpCat.of (ULift.{u} ℤ))
      (FgtMod.obj (ModuleCat.of R R)) :=
    CategoryTheory.CategoryStruct.comp
      (AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ)) :
        Quiver.Hom (AddCommGrpCat.of (ULift.{u} ℤ))
          (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ)))
      (CategoryTheory.CategoryStruct.comp
        (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod m))))
        ιM)
  ∃ (U : CategoryTheory.Functor
      (CategoryTheory.Sheaf J (ModuleCat.{u, u} R))
      (CategoryTheory.Sheaf J AddCommGrpCat.{u})),
    (∀ ℱ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R),
      (U.obj ℱ).obj = CategoryTheory.Functor.comp ℱ.obj FgtMod) ∧
    (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)} (u : Quiver.Hom ℱ₁ ℱ₂)
      (W : (S.Etale)ᵒᵖ),
      HEq ((U.map u).hom.app W) (FgtMod.map (u.hom.app W))) ∧
    ∃ (_ : U.Additive) (_ : CategoryTheory.Limits.PreservesFiniteLimits U)
      (_ : CategoryTheory.Limits.PreservesFiniteColimits U)
      (T : S.Etale) (hT : CategoryTheory.Limits.IsTerminal T),
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj T).left = S ∧
      HEq ((AlgebraicGeometry.Scheme.Etale.forget S).obj T).hom
        (CategoryTheory.CategoryStruct.id S) ∧
      let adjℤ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
      let adjR := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) hT
      ∃ (u_unit : Quiver.Hom (FgtMod.obj (ModuleCat.of R R))
          ((U.obj oneR).obj.obj (Opposite.op T))),
        HEq u_unit (FgtMod.map (adjR.unit.app (ModuleCat.of R R))) ∧
        let ηℤ : Quiver.Hom Fℤ (U.obj oneR) :=
          (adjℤ.homEquiv (AddCommGrpCat.of (ULift.{u} ℤ)) (U.obj oneR)).symm
            (CategoryTheory.CategoryStruct.comp ιℤ u_unit)
        let αM : Quiver.Hom FM (U.obj oneR) :=
          (adjℤ.homEquiv (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
            (U.obj oneR)).symm
            (CategoryTheory.CategoryStruct.comp ιM u_unit)
        ∃ (βM : Quiver.Hom (U.obj oneR) FM),
          CategoryTheory.CategoryStruct.comp αM βM = CategoryTheory.CategoryStruct.id FM ∧
          CategoryTheory.CategoryStruct.comp βM αM =
            CategoryTheory.CategoryStruct.id (U.obj oneR) ∧
          ∀ x : weilEtaleModuleH S m i,
            θ x = (CategoryTheory.Abelian.Ext.mk₀ βM).postcomp Fℤ (Nat.add_zero i)
              ((CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U _ _ _ _ _ oneR oneR i) x)
                (Nat.zero_add i))
def IsValuationRingAlgPackage {K : Type u} [Field K] (m : ℕ) (V : ValuationSubring K) : Prop :=
  Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)) ∧
  Nat.card (PrimeSpectrum ↥V) ≤ m + 1 ∧
  HenselianLocalRing ↥V ∧
  (∀ (a : K), a ≠ 0 → ∀ (d : ℕ), 1 ≤ d →
    ∃ (b : K) (u : ↥V), IsUnit u ∧ b ^ d * V.subtype u = a) ∧
  (∀ (P : Ideal ↥V) [P.IsPrime], P ≠ ⊥ → IsAlgClosed P.ResidueField) ∧
  (∀ (r : ℕ) (J : Ideal (MvPolynomial (Fin r) ↥V)),
    (∀ (c : ↥V) (f : MvPolynomial (Fin r) ↥V), c ≠ 0 → MvPolynomial.C c * f ∈ J → f ∈ J) →
    J.FG)

def IsValuationPointedCurveModel {K : Type u} [Field K] (V : ValuationSubring K)
    {C_K : AlgebraicGeometry.Scheme.{u}}
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι_gen : C_K ⟶ C) : Prop :=
  AlgebraicGeometry.IsIntegral C ∧
  AlgebraicGeometry.Flat g ∧
  AlgebraicGeometry.IsProper g ∧
  AlgebraicGeometry.LocallyOfFinitePresentation g ∧
  AlgebraicGeometry.Surjective g ∧
  (∃ (M : ℕ) (ιP : C ⟶ (weilProjectiveSpaceOver ↥V M).left),
    AlgebraicGeometry.IsClosedImmersion ιP ∧
    ιP ≫ (weilProjectiveSpaceOver ↥V M).hom = g) ∧
  (∀ j : Fin n, τ j ≫ g = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V))) ∧
  CategoryTheory.IsPullback ι_gen p_K g
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
  (∀ j : Fin n, σ_K j ≫ ι_gen =
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) ≫ τ j)

def IsStrictlySemistableCurveOverValuation {K : Type u} [Field K] (V : ValuationSubring K)
    {U : AlgebraicGeometry.Scheme.{u}}
    (g_U : U ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)) : Prop :=
  AlgebraicGeometry.IsIntegral U ∧
  AlgebraicGeometry.Flat g_U ∧
  AlgebraicGeometry.IsSeparated g_U ∧
  AlgebraicGeometry.LocallyOfFinitePresentation g_U ∧
  ∀ y : U,
    (∃ (W : U.Opens)
        (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
      y ∈ W ∧
      AlgebraicGeometry.Etale e ∧
      W.ι ≫ g_U = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∨
    (∃ (W : U.Opens) (a : ↥V)
        (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))),
      y ∈ W ∧
      a ≠ 0 ∧
      AlgebraicGeometry.Etale e ∧
      W.ι ≫ g_U = e ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))

def IsResolvedLocalStrictlySemistableMod {K : Type u} [Field K] (V : ValuationSubring K)
    {C_K C' : AlgebraicGeometry.Scheme.{u}}
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (n : ℕ) (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C') (U' : C'.Opens)
    {U_ss : AlgebraicGeometry.Scheme.{u}}
    (h_mod : U'.toScheme ⟶ U_ss)
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (C'' : AlgebraicGeometry.Scheme.{u})
    (g'' : C'' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom : C'' ⟶ U'.toScheme)
    (τ'' : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C'')
    (ι_C'' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C'') : Prop :=
  let U_K : C_K.Opens := (TopologicalSpace.Opens.map ι'.base).obj U'
  IsStrictlySemistableCurveOverValuation V g'' ∧
  AlgebraicGeometry.IsProper f_dom ∧
  f_dom ≫ U'.ι ≫ g' = g'' ∧
  (∃ (f_ss : C'' ⟶ U_ss),
    f_dom ≫ h_mod = f_ss ∧ AlgebraicGeometry.IsProper f_ss) ∧
  ι_C'' ≫ f_dom = ι_U' ∧
  CategoryTheory.IsPullback ι_C'' (U_K.ι ≫ p_K) g''
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
  (∀ j : Fin n,
    let S_j : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens :=
      (TopologicalSpace.Opens.map (τ' j).base).obj U'
    (τ'' j ≫ f_dom) ≫ U'.ι = S_j.ι ≫ τ' j) ∧
  (_root_.Pairwise fun i j : Fin n =>
    Disjoint (Set.range (τ'' i).base) (Set.range (τ'' j).base)) ∧
  (∀ (j : Fin n)
      (b : AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U')),
    ∃ V_sm : C''.Opens,
      (τ'' j).base b ∈ V_sm ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g''))

def IsSemistableValuationPointedModel {K : Type u} [Field K] (V : ValuationSubring K)
    {C_K : AlgebraicGeometry.Scheme.{u}}
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ_semi : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
    (ι_semi : C_K ⟶ C_semi) : Prop :=
  IsValuationPointedCurveModel V p_K n σ_K C_semi g_semi τ_semi ι_semi ∧
  (_root_.Pairwise fun i j : Fin n =>
    Disjoint (Set.range (τ_semi i).base) (Set.range (τ_semi j).base)) ∧
  (∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
    ∃ V_sm : C_semi.Opens,
      (τ_semi j).base b ∈ V_sm ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_semi)) ∧
  (∀ (K' : Type u) [Field K'] [IsAlgClosed K']
      (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
    ConnectedSpace ↥(CategoryTheory.Limits.pullback g_semi s) ∧
    ∀ y : ↥(CategoryTheory.Limits.pullback g_semi s),
      (∃ V_sm : (CategoryTheory.Limits.pullback g_semi s).Opens,
        y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
          (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g_semi s)) ∨
      (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ CategoryTheory.Limits.pullback g_semi s)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) K' ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = y ∧
        (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
        e₁ ≫ CategoryTheory.Limits.pullback.snd g_semi s =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))))
def HasEtaleSmoothRoofOver (k : Type u) [Field k] (d : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (x : X.left) : Prop :=
  ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
    (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
    (ψ : MvPolynomial (Fin d) k →+* R'),
    AlgebraicGeometry.Etale e_X ∧
    AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
    e_X.base v₀ = x ∧
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_X ≫ X.hom)
noncomputable abbrev weilBlowupChartSubalg (R : Type u) [CommRing R] {L : ℕ}
    (h : Fin (L + 1) → R) (β : Fin (L + 1)) : Subalgebra R (Localization.Away (h β)) :=
  Algebra.adjoin R (Set.range fun α : Fin (L + 1) =>
    algebraMap R (Localization.Away (h β)) (h α) *
      IsLocalization.Away.invSelf (S := Localization.Away (h β)) (h β))
def IsShrunkNodalSncDatumAt (k : Type u) [Field k] (m : ℕ)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (r_B : ℕ) (D_B : Fin r_B → AlgebraicGeometry.Scheme.{u})
    (ιD_B : ∀ i : Fin r_B, D_B i ⟶ B₁.left)
    (C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z₁ : Set C₁.left) (f₁ : C₁ ⟶ B₁) (S_rel : Set C₁.left) (x : C₁.left)
    (R'_B : CommRingCat.{u}) (e_B : AlgebraicGeometry.Spec R'_B ⟶ B₁.left)
    (ψ_B : MvPolynomial (Fin m) k →+* ↑R'_B)
    (p_B : AlgebraicGeometry.Spec R'_B) (I₀ : Finset (Fin m))
    (ρ₀ : {c : Fin m // c ∈ I₀} → Fin r_B) (h : ↑R'_B)
    (B' : CommRingCat.{u}) (v' : AlgebraicGeometry.Spec B')
    (e_C : AlgebraicGeometry.Spec B' ⟶ C₁.left)
    (ψ_nodal : (MvPolynomial (Fin 2) ↑R'_B ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}) →+* ↑B') : Prop :=
  AlgebraicGeometry.Etale e_B ∧
  AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B)) ∧
  AlgebraicGeometry.Etale e_C ∧
  AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_nodal)) ∧
  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B) ≫
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_B ≫ B₁.hom) ∧
  (e_C ≫ f₁.left =
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_nodal) ≫
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_B) ∧
  e_C.base v' = x ∧
  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
    (ψ_nodal.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)))).base v' = p_B ∧
  (∀ b : Fin 2,
    ψ_nodal (Ideal.Quotient.mk _ (MvPolynomial.X b)) ∈ v'.asIdeal) ∧
  (∀ c ∈ I₀, ψ_B (MvPolynomial.X c) ∈ p_B.asIdeal) ∧
  h ∈ p_B.asIdeal ∧
  Function.Injective ρ₀ ∧
  (∀ (q : Ideal ↑R'_B), q.IsPrime → q ≤ p_B.asIdeal → h ∈ q →
    ∃ c ∈ I₀, ψ_B (MvPolynomial.X c) ∈ q) ∧
  e_C.base ⁻¹' Z₁ =
    {v : AlgebraicGeometry.Spec B' |
      ∃ c ∈ I₀,
        ψ_nodal (Ideal.Quotient.mk _ (MvPolynomial.C (ψ_B (MvPolynomial.X c)))) ∈ v.asIdeal} ∧
  (∀ (c : Fin m) (hc : c ∈ I₀),
    (e_C ≫ f₁.left).base ⁻¹' Set.range (ιD_B (ρ₀ ⟨c, hc⟩)).base =
      {v : AlgebraicGeometry.Spec B' |
        ψ_nodal (Ideal.Quotient.mk _ (MvPolynomial.C (ψ_B (MvPolynomial.X c)))) ∈ v.asIdeal}) ∧
  e_C.base ⁻¹' S_rel =
    {v : AlgebraicGeometry.Spec B' |
      ∀ b : Fin 2,
        ψ_nodal (Ideal.Quotient.mk _ (MvPolynomial.X b)) ∈ v.asIdeal}

def IsRelativeToroidalChartAt (k : Type u) [Field k] (m : ℕ)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (r_B : ℕ) (D_B : Fin r_B → AlgebraicGeometry.Scheme.{u})
    (ιD_B : ∀ i : Fin r_B, D_B i ⟶ B₁.left)
    (C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z₁ : Set C₁.left) (f₁ : C₁ ⟶ B₁) (S_rel : Set C₁.left) (x : C₁.left)
    (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
    (e_X : AlgebraicGeometry.Spec R' ⟶ C₁.left)
    (a : Fin m → ℕ) (S_bdry : Finset (Fin m))
    (ρ : {c : Fin m // 1 ≤ a c} → Fin r_B)
    (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
        ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
          ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} :
          Set (MvPolynomial (Fin 2 ⊕ Fin m) k))))) : Prop :=
  AlgebraicGeometry.Etale e_X ∧
  AlgebraicGeometry.Etale q ∧
  e_X.base v₀ = x ∧
  1 ≤ (∑ c : Fin m, a c) ∧
  (∀ c : Fin m, 1 ≤ a c → c ∈ S_bdry) ∧
  Function.Injective ρ ∧
  (q ≫ AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ C₁.hom) ∧
  (∀ b : Fin 2,
    Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v₀).asIdeal) ∧
  (∀ c ∈ S_bdry,
    Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v₀).asIdeal) ∧
  e_X.base ⁻¹' Z₁ =
    {v : AlgebraicGeometry.Spec R' |
      ∃ c ∈ S_bdry,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v).asIdeal} ∧
  (∀ (c : Fin m) (hc : 1 ≤ a c),
    (e_X ≫ f₁.left).base ⁻¹' Set.range (ιD_B (ρ ⟨c, hc⟩)).base =
      {v : AlgebraicGeometry.Spec R' |
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v).asIdeal}) ∧
  e_X.base ⁻¹' S_rel =
    {v : AlgebraicGeometry.Spec R' |
      ∀ b : Fin 2,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal} ∧
  (∀ c : Fin m, 1 ≤ a c →
    IsIrreducible {v : AlgebraicGeometry.Spec R' |
      (∀ b : Fin 2,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
      Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v).asIdeal}) ∧
  ∃ (R'_B : CommRingCat.{u}) (e_B : AlgebraicGeometry.Spec R'_B ⟶ B₁.left)
    (ψ_B : MvPolynomial (Fin m) k →+* ↑R'_B)
    (ψ_rel : (MvPolynomial (Fin 2) ↑R'_B ⧸ Ideal.span
      ({MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C (∏ c : Fin m, ψ_B (MvPolynomial.X c) ^ a c)} :
        Set (MvPolynomial (Fin 2) ↑R'_B))) →+* ↑R')
    (φ_q : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
      ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} :
        Set (MvPolynomial (Fin 2 ⊕ Fin m) k))) →+* ↑R'),
    q = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_q) ∧
    AlgebraicGeometry.Etale e_B ∧
    AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B)) ∧
    AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_rel)) ∧
    (e_X ≫ f₁.left =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_rel) ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_B) ∧
    (∀ b : Fin 2,
      ψ_rel (Ideal.Quotient.mk _ (MvPolynomial.X b)) =
        φ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)))) ∧
    (∀ c : Fin m,
      ψ_rel (Ideal.Quotient.mk _ (MvPolynomial.C (ψ_B (MvPolynomial.X c)))) =
        φ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c))))
def IsAffineChartOpenPointedIso (k : Type u) [Field k]
    {X₂ B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (f₂ : X₂ ⟶ B₂) {n : ℕ} (σ : Fin n → (B₂ ⟶ X₂))
    {A : CommRingCat.{u}} (π_A : AlgebraicGeometry.Spec A ⟶ B₂.left)
    (D_A : (AlgebraicGeometry.Spec A).Opens)
    {C_A : AlgebraicGeometry.Scheme.{u}}
    (g_A : C_A ⟶ AlgebraicGeometry.Spec A)
    (τ_A : Fin n → (AlgebraicGeometry.Spec A ⟶ C_A)) : Prop :=
  let V_D : C_A.Opens := (TopologicalSpace.Opens.map g_A.base).obj D_A
  ∃ (ι_D : V_D.toScheme ⟶ X₂.left)
    (hcomm_D : ι_D ≫ f₂.left = V_D.ι ≫ g_A ≫ π_A),
    AlgebraicGeometry.IsOpenImmersion
      (CategoryTheory.Limits.pullback.lift ι_D (V_D.ι ≫ g_A) hcomm_D) ∧
    Set.range (CategoryTheory.Limits.pullback.lift ι_D (V_D.ι ≫ g_A) hcomm_D).base =
      (CategoryTheory.Limits.pullback.snd f₂.left π_A).base ⁻¹'
        (D_A : Set (AlgebraicGeometry.Spec A)) ∧
    ∀ j : Fin n,
      ∃ s_D : D_A.toScheme ⟶ V_D.toScheme,
        s_D ≫ V_D.ι = D_A.ι ≫ τ_A j ∧
        s_D ≫ ι_D = D_A.ι ≫ π_A ≫ (σ j).left
def HasGeomFiberNodalRoofAt {R₀ A₀ : Type u} [CommRing R₀] [CommRing A₀]
    (f₀ : R₀ →+* A₀) (q₀ : PrimeSpectrum A₀) : Prop :=
  letI : Algebra R₀ A₀ := f₀.toAlgebra
  let p₀ : PrimeSpectrum R₀ := PrimeSpectrum.comap f₀ q₀
  let K : Type u := AlgebraicClosure p₀.asIdeal.ResidueField
  let toK : R₀ →+* K :=
    (algebraMap p₀.asIdeal.ResidueField K).comp (algebraMap R₀ p₀.asIdeal.ResidueField)
  letI : Algebra R₀ K := toK.toAlgebra
  ∃ (D_K : Type u) (_ : CommRing D_K) (m₀ : PrimeSpectrum D_K)
    (ψ₁ : TensorProduct R₀ A₀ K →+* D_K)
    (ψ₂ : (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* D_K),
    ψ₁.Etale ∧
    ψ₂.Etale ∧
    PrimeSpectrum.comap (ψ₁.comp Algebra.TensorProduct.includeLeftRingHom) m₀ = q₀ ∧
    (∀ i : Fin 2, ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ m₀.asIdeal) ∧
    ψ₁.comp Algebra.TensorProduct.includeRight.toRingHom =
      ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)

def HasSplitFiberNodeAt {R₁ A₁ : Type u} [CommRing R₁] [CommRing A₁]
    (f₁ : R₁ →+* A₁) (q₁ : PrimeSpectrum A₁) (u₁ v₁ : A₁) : Prop :=
  letI : Algebra R₁ A₁ := f₁.toAlgebra
  let p₁ : PrimeSpectrum R₁ := PrimeSpectrum.comap f₁ q₁
  let κ₁ : Type u := p₁.asIdeal.ResidueField
  let F₁ : Type u := TensorProduct R₁ A₁ κ₁
  let toF₁ : A₁ →+* F₁ := Algebra.TensorProduct.includeLeftRingHom
  let toκ₁ : κ₁ →+* F₁ := Algebra.TensorProduct.includeRight.toRingHom
  u₁ ∈ q₁.asIdeal ∧
  v₁ ∈ q₁.asIdeal ∧
  HasGeomFiberNodalRoofAt f₁ q₁ ∧
  ∃ (m₁ : PrimeSpectrum F₁),
    PrimeSpectrum.comap toF₁ m₁ = q₁ ∧
    (∀ z : F₁, ∃ c : κ₁, z - toκ₁ c ∈ m₁.asIdeal) ∧
    (let L₁ := Localization.AtPrime m₁.asIdeal
     let loc : F₁ →+* L₁ := algebraMap F₁ L₁
     let 𝔪 : Ideal L₁ := IsLocalRing.maximalIdeal L₁
     Ideal.span {loc (toF₁ u₁), loc (toF₁ v₁)} = 𝔪 ∧
     (∀ c₀ c₁ : κ₁,
       loc (toκ₁ c₀) * loc (toF₁ u₁) + loc (toκ₁ c₁) * loc (toF₁ v₁) ∈ 𝔪 ^ 2 →
       c₀ = 0 ∧ c₁ = 0) ∧
     loc (toF₁ u₁) * loc (toF₁ v₁) ∈ 𝔪 ^ 3)

def HasStandardNodalRingRoofAt {R₀ A₀ : Type u} [CommRing R₀] [CommRing A₀]
    (f₀ : R₀ →+* A₀) (q₀ : PrimeSpectrum A₀) : Prop :=
  ∃ (R' : Type u) (_ : CommRing R') (eR : R₀ →+* R') (h : R')
    (D : Type u) (_ : CommRing D) (v₀ : PrimeSpectrum D)
    (eA : A₀ →+* D)
    (φ_q : (MvPolynomial (Fin 2) R' ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}) →+* D),
    eR.Etale ∧
    eA.Etale ∧
    φ_q.Etale ∧
    PrimeSpectrum.comap eA v₀ = q₀ ∧
    (∀ i : Fin 2, φ_q (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ v₀.asIdeal) ∧
    φ_q (Ideal.Quotient.mk _ (MvPolynomial.C h)) ∈ v₀.asIdeal ∧
    eA.comp f₀ = (φ_q.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp eR
def HasGLProjBundleAtlas {C S : AlgebraicGeometry.Scheme.{u}} (g : C ⟶ S) : Prop :=
  ∃ (s₀ r₀ : ℕ) (U : Fin (s₀ + 1) → S.Opens),
    (∀ α : Fin (s₀ + 1), AlgebraicGeometry.IsAffineOpen (U α)) ∧
    (⋃ α : Fin (s₀ + 1), (U α : Set S)) = Set.univ ∧
    ∃ (j_loc : ∀ α : Fin (s₀ + 1),
        let V : C.Opens := (TopologicalSpace.Opens.map g.base).obj (U α)
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1))
          ↑(S.presheaf.obj (Opposite.op (U α)))) := MvPolynomial.gradedAlgebra
        V.toScheme ⟶
          AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1))
            ↑(S.presheaf.obj (Opposite.op (U α)))))
      (T : ∀ α β : Fin (s₀ + 1),
        Matrix.GeneralLinearGroup (Fin (r₀ + 1))
          ↑(S.presheaf.obj (Opposite.op (U α ⊓ U β)))),
      (∀ α : Fin (s₀ + 1), AlgebraicGeometry.IsClosedImmersion (j_loc α)) ∧
      (∀ α : Fin (s₀ + 1),
        let V : C.Opens := (TopologicalSpace.Opens.map g.base).obj (U α)
        let A : Type u := ↑(S.presheaf.obj (Opposite.op (U α)))
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A) :=
          MvPolynomial.gradedAlgebra
        j_loc α ≫
          (AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A 0)))) =
          g.resLE (U α) V (le_refl _) ≫ (U α).toSpecΓ) ∧
      (∀ α : Fin (s₀ + 1), (T α α).val = 1) ∧
      (∀ α β γ : Fin (s₀ + 1),
        let u₁ : U α ⊓ U β ⊓ U γ ⟶ U α ⊓ U β := CategoryTheory.homOfLE inf_le_left
        let u₂ : U α ⊓ U β ⊓ U γ ⟶ U β ⊓ U γ :=
          CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
        let u₃ : U α ⊓ U β ⊓ U γ ⟶ U α ⊓ U γ :=
          CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
        Matrix.map (T α β).val (S.presheaf.map u₁.op).hom *
          Matrix.map (T β γ).val (S.presheaf.map u₂.op).hom =
          Matrix.map (T α γ).val (S.presheaf.map u₃.op).hom) ∧
      ∃ (j_ov : ∀ α β : Fin (s₀ + 1),
          let V_ov : C.Opens := (TopologicalSpace.Opens.map g.base).obj (U α ⊓ U β)
          let A_ov : Type u := ↑(S.presheaf.obj (Opposite.op (U α ⊓ U β)))
          letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_ov) :=
            MvPolynomial.gradedAlgebra
          V_ov.toScheme ⟶
            AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_ov)),
        ∀ α β : Fin (s₀ + 1),
          let V_ov : C.Opens := (TopologicalSpace.Opens.map g.base).obj (U α ⊓ U β)
          let A_α : Type u := ↑(S.presheaf.obj (Opposite.op (U α)))
          let A_β : Type u := ↑(S.presheaf.obj (Opposite.op (U β)))
          let A_ov : Type u := ↑(S.presheaf.obj (Opposite.op (U α ⊓ U β)))
          letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_α) :=
            MvPolynomial.gradedAlgebra
          letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_β) :=
            MvPolynomial.gradedAlgebra
          letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_ov) :=
            MvPolynomial.gradedAlgebra
          (j_ov α β ≫
            (AlgebraicGeometry.Proj.toSpecZero
                (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_ov) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (algebraMap A_ov ↥(MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_ov 0)))) =
            g.resLE (U α ⊓ U β) V_ov (le_refl _) ≫ (U α ⊓ U β).toSpecΓ) ∧
          ∃ (P_map : MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_α →+*ᵍ
              MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_ov)
            (hP_map : HomogeneousIdeal.irrelevant
                (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_ov) ≤
              HomogeneousIdeal.map P_map
                (HomogeneousIdeal.irrelevant
                  (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_α)))
            (Q_map : MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_β →+*ᵍ
              MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_ov)
            (hQ_map : HomogeneousIdeal.irrelevant
                (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_ov) ≤
              HomogeneousIdeal.map Q_map
                (HomogeneousIdeal.irrelevant
                  (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A_β))),
            (∀ c : A_α,
              P_map.toRingHom (MvPolynomial.C c) =
                MvPolynomial.C
                  ((S.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom c)) ∧
            (∀ i : Fin (r₀ + 1),
              P_map.toRingHom (MvPolynomial.X i) = MvPolynomial.X i) ∧
            j_ov α β ≫ AlgebraicGeometry.Proj.map P_map hP_map =
              C.homOfLE ((TopologicalSpace.Opens.map g.base).monotone inf_le_left) ≫ j_loc α ∧
            (∀ c : A_β,
              Q_map.toRingHom (MvPolynomial.C c) =
                MvPolynomial.C
                  ((S.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom c)) ∧
            (∀ j : Fin (r₀ + 1),
              Q_map.toRingHom (MvPolynomial.X j) =
                ∑ i : Fin (r₀ + 1),
                  (MvPolynomial.C ((T α β).val i j) : MvPolynomial (Fin (r₀ + 1)) A_ov) *
                    (MvPolynomial.X i : MvPolynomial (Fin (r₀ + 1)) A_ov)) ∧
            j_ov α β ≫ AlgebraicGeometry.Proj.map Q_map hQ_map =
              C.homOfLE ((TopologicalSpace.Opens.map g.base).monotone inf_le_right) ≫ j_loc β

def HasLocalCurveIsoMatrixBridge (k : Type u) [Field k] : Prop :=
  ∀ (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [Algebra k B₀] [Algebra.FiniteType k B₀]
    (L : Type u) [Field L] [Algebra B₀ L] [IsFractionRing B₀ L]
    (n : ℕ)
    (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀))
    (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ C₁))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀))
    (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ C₂)),
    IsGeometricStablePointedCurve g₁ n τ₁ →
    IsGeometricStablePointedCurve g₂ n τ₂ →
    let η_L := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L))
    AlgebraicGeometry.SmoothOfRelativeDimension 1 (CategoryTheory.Limits.pullback.snd g₁ η_L) →
    ∀ (φ_L : CategoryTheory.Limits.pullback g₁ η_L ≅ CategoryTheory.Limits.pullback g₂ η_L),
      φ_L.hom ≫ CategoryTheory.Limits.pullback.snd g₂ η_L =
        CategoryTheory.Limits.pullback.snd g₁ η_L →
      (∀ j : Fin n, ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
          CategoryTheory.Limits.pullback g₁ η_L),
        s₁ ≫ CategoryTheory.Limits.pullback.fst g₁ η_L = η_L ≫ τ₁ j →
        s₁ ≫ CategoryTheory.Limits.pullback.snd g₁ η_L =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L)) →
        (s₁ ≫ φ_L.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ η_L = η_L ≫ τ₂ j) →
      ∀ (q : PrimeSpectrum B₀),
        ∃ (h₀ : B₀) (_ : h₀ ∉ q.asIdeal) (r₀ : ℕ)
          (M : Matrix.GeneralLinearGroup (Fin (r₀ + 1)) L),
          let u_h := AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap B₀ (Localization.Away h₀)))
          (∀ (ψ_h : Localization.Away h₀ →+* L),
            ψ_h.comp (algebraMap B₀ (Localization.Away h₀)) = algebraMap B₀ L →
            (∃ M₀ : Matrix.GeneralLinearGroup (Fin (r₀ + 1)) (Localization.Away h₀),
              ∀ i j : Fin (r₀ + 1), ψ_h (M₀.val i j) = M.val i j) →
            ∃ (φ_h : CategoryTheory.Limits.pullback g₁ u_h ≅
                CategoryTheory.Limits.pullback g₂ u_h),
              φ_h.hom ≫ CategoryTheory.Limits.pullback.snd g₂ u_h =
                CategoryTheory.Limits.pullback.snd g₁ u_h ∧
              (∀ j : Fin n, ∀ (s₁ : AlgebraicGeometry.Spec
                  (CommRingCat.of (Localization.Away h₀)) ⟶
                    CategoryTheory.Limits.pullback g₁ u_h),
                s₁ ≫ CategoryTheory.Limits.pullback.fst g₁ u_h = u_h ≫ τ₁ j →
                s₁ ≫ CategoryTheory.Limits.pullback.snd g₁ u_h =
                  𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h₀))) →
                (s₁ ≫ φ_h.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ u_h = u_h ≫ τ₂ j) ∧
              (∀ (w₁ : CategoryTheory.Limits.pullback g₁ η_L ⟶
                  CategoryTheory.Limits.pullback g₁ u_h),
                w₁ ≫ CategoryTheory.Limits.pullback.fst g₁ u_h =
                  CategoryTheory.Limits.pullback.fst g₁ η_L →
                w₁ ≫ CategoryTheory.Limits.pullback.snd g₁ u_h =
                  CategoryTheory.Limits.pullback.snd g₁ η_L ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h) →
                (w₁ ≫ φ_h.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ u_h =
                  φ_L.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_L)) ∧
          (∀ (ψ_h : Localization.Away h₀ →+* L),
            ψ_h.comp (algebraMap B₀ (Localization.Away h₀)) = algebraMap B₀ L →
            ∀ (p : PrimeSpectrum (Localization.Away h₀)),
              let u_p := AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  (algebraMap (Localization.Away h₀) (Localization.AtPrime p.asIdeal))) ≫ u_h
              (∃ (φ_p : CategoryTheory.Limits.pullback g₁ u_p ≅
                  CategoryTheory.Limits.pullback g₂ u_p),
                φ_p.hom ≫ CategoryTheory.Limits.pullback.snd g₂ u_p =
                  CategoryTheory.Limits.pullback.snd g₁ u_p ∧
                (∀ j : Fin n, ∀ (s₁ : AlgebraicGeometry.Spec
                    (CommRingCat.of (Localization.AtPrime p.asIdeal)) ⟶
                      CategoryTheory.Limits.pullback g₁ u_p),
                  s₁ ≫ CategoryTheory.Limits.pullback.fst g₁ u_p = u_p ≫ τ₁ j →
                  s₁ ≫ CategoryTheory.Limits.pullback.snd g₁ u_p =
                    𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (Localization.AtPrime p.asIdeal))) →
                  (s₁ ≫ φ_p.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ u_p = u_p ≫ τ₂ j) ∧
                (∀ (v_p : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
                    AlgebraicGeometry.Spec (CommRingCat.of (Localization.AtPrime p.asIdeal)))
                  (w₁ : CategoryTheory.Limits.pullback g₁ η_L ⟶
                    CategoryTheory.Limits.pullback g₁ u_p),
                  v_p ≫ u_p = η_L →
                  w₁ ≫ CategoryTheory.Limits.pullback.fst g₁ u_p =
                    CategoryTheory.Limits.pullback.fst g₁ η_L →
                  w₁ ≫ CategoryTheory.Limits.pullback.snd g₁ u_p =
                    CategoryTheory.Limits.pullback.snd g₁ η_L ≫ v_p →
                  (w₁ ≫ φ_p.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ u_p =
                    φ_L.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_L)) →
              ∀ i j : Fin (r₀ + 1),
                (∃ a b : Localization.Away h₀,
                  b ∉ p.asIdeal ∧ ψ_h b * M.val i j = ψ_h a) ∧
                (∃ a b : Localization.Away h₀,
                  b ∉ p.asIdeal ∧ ψ_h b * (M⁻¹).val i j = ψ_h a))
def IsWeilEtaleTranscendenceParam (K F : Type u) [Field K] [Field F] [Algebra K F]
    (W : ValuationSubring F) : Prop :=
  ∃ (x : F),
    x ∈ W ∧
    Transcendental K x ∧
    let Lx := IntermediateField.adjoin K ({x} : Set F)
    let Vx := W.comap Lx.val.toRingHom
    RingHom.Etale ((Lx.val.toRingHom.comp Vx.subtype).codRestrict W.toSubring (fun y => y.2))

def IsWeilAnalyticUnramifiedGen (K_hat F_hat : Type u)
    [NontriviallyNormedField K_hat] [NontriviallyNormedField F_hat]
    [IsUltrametricDist F_hat] [Algebra K_hat F_hat] (x : F_hat) : Prop :=
  let Lx : Subfield F_hat :=
    (IntermediateField.adjoin K_hat ({x} : Set F_hat)).toSubfield.topologicalClosure
  let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
  let OLx : ValuationSubring ↥Lx := OF.comap Lx.subtype
  letI : Algebra ↥Lx F_hat := Lx.toAlgebra
  let φ : ↥OLx →+* ↥OF :=
    (Lx.subtype.comp OLx.subtype).codRestrict OF.toSubring (fun y => y.2)
  letI : Algebra ↥OLx ↥OF := φ.toAlgebra
  FiniteDimensional ↥Lx F_hat ∧ Module.Finite ↥OLx ↥OF ∧ RingHom.Etale φ

def HasWeilImmediateCosetAndPerturb (K_hat F_hat : Type u)
    [NontriviallyNormedField K_hat] [CompleteSpace K_hat]
    [IsUltrametricDist K_hat] [IsAlgClosed K_hat]
    [NontriviallyNormedField F_hat] [CompleteSpace F_hat]
    [IsUltrametricDist F_hat] [Algebra K_hat F_hat] : Prop :=
  (∀ (y₀ z : F_hat),
    z ∉ Set.range (algebraMap K_hat F_hat) →
    (let Ly₀ : Subfield F_hat :=
      (IntermediateField.adjoin K_hat ({y₀} : Set F_hat)).toSubfield.topologicalClosure
     letI : Algebra ↥Ly₀ F_hat := Ly₀.toAlgebra
     FiniteDimensional ↥Ly₀ F_hat) →
    let Lz : Subfield F_hat :=
      (IntermediateField.adjoin K_hat ({z} : Set F_hat)).toSubfield.topologicalClosure
    letI : Algebra ↥Lz F_hat := Lz.toAlgebra
    FiniteDimensional ↥Lz F_hat ∧
    ∃ r_z : ℝ, 0 < r_z ∧
      (∀ c : K_hat, r_z ≤ ‖z - algebraMap K_hat F_hat c‖) ∧
      (∀ ε : ℝ, 0 < ε → ∃ c : K_hat, ‖z - algebraMap K_hat F_hat c‖ < r_z + ε) ∧
      (∀ z' : F_hat, ‖z - z'‖ < r_z →
        let Lz' : Subfield F_hat :=
          (IntermediateField.adjoin K_hat ({z'} : Set F_hat)).toSubfield.topologicalClosure
        letI : Algebra ↥Lz' F_hat := Lz'.toAlgebra
        Module.finrank ↥Lz F_hat = Module.finrank ↥Lz' F_hat) ∧
      (∀ z' : F_hat, ‖z - z'‖ < r_z / 2 →
        IsWeilAnalyticUnramifiedGen K_hat F_hat z →
        IsWeilAnalyticUnramifiedGen K_hat F_hat z')) ∧
  (∀ (p : ℕ), p.Prime → (p : K_hat) = 0 →
    ∀ (M₁ M₂ : Subfield F_hat) (hLE : M₁ ≤ M₂),
      Set.range (algebraMap K_hat F_hat) ⊆ (M₁ : Set F_hat) →
      IsClosed (M₁ : Set F_hat) →
      IsClosed (M₂ : Set F_hat) →
      (letI : Algebra ↥M₁ ↥M₂ := (Subfield.inclusion hLE).toAlgebra
       FiniteDimensional ↥M₁ ↥M₂ ∧ Module.finrank ↥M₁ ↥M₂ = p) →
      (∀ w ∈ M₂, w ≠ 0 → ∃ u ∈ M₁, ‖w‖ = ‖u‖) →
      (∀ w ∈ M₂, ‖w‖ ≤ 1 → ∃ u ∈ M₁, ‖u‖ ≤ 1 ∧ ‖w - u‖ < 1) →
      ∃ (a b α : F_hat) (s : ℝ),
        a ∈ M₁ ∧ b ∈ M₁ ∧ α ∈ M₂ ∧ 0 < s ∧
        (a = 0 ∨ ‖a‖ ^ p = s ^ (p - 1)) ∧
        (∀ x ∈ M₁, s < ‖x ^ p - a * x + b‖) ∧
        (∀ ε : ℝ, 0 < ε → ∃ x ∈ M₁, ‖x ^ p - a * x + b‖ < s + ε) ∧
        ‖α ^ p - a * α + b‖ < s ∧
        (a ≠ 0 → ∃ β ∈ M₂, β ^ p - a * β + b = 0))

def HasWeilAnalyticOneDimUniformization (_k : Type u) : Prop :=
  ∀ (K_hat F_hat : Type u)
    [NontriviallyNormedField K_hat] [CompleteSpace K_hat]
    [IsUltrametricDist K_hat] [IsAlgClosed K_hat]
    [NontriviallyNormedField F_hat] [CompleteSpace F_hat]
    [IsUltrametricDist F_hat] [Algebra K_hat F_hat],
    (∀ p : ℕ, p.Prime → (p : K_hat) = 0 ∨ ‖(p : K_hat)‖ = 1) →
    (∀ c : K_hat, ‖algebraMap K_hat F_hat c‖ = ‖c‖) →
    ∀ (y₀ : F_hat),
      y₀ ∉ Set.range (algebraMap K_hat F_hat) →
      (let Ly₀ : Subfield F_hat :=
        (IntermediateField.adjoin K_hat ({y₀} : Set F_hat)).toSubfield.topologicalClosure
       letI : Algebra ↥Ly₀ F_hat := Ly₀.toAlgebra
       FiniteDimensional ↥Ly₀ F_hat) →
      (∃ (x₀ : F_hat) (ε : ℝ), 0 < ε ∧
        ∀ x' : F_hat, ‖x' - x₀‖ < ε → IsWeilAnalyticUnramifiedGen K_hat F_hat x') ∧
      (let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
       let OK : ValuationSubring K_hat := OF.comap (algebraMap K_hat F_hat)
       let κF := IsLocalRing.ResidueField ↥OF
       let κ_hom : ↥OK →+* κF :=
         (IsLocalRing.residue ↥OF).comp
           (((algebraMap K_hat F_hat).comp OK.subtype).codRestrict OF.toSubring (fun c => c.2))
       ∀ (x : F_hat) (hx : x ∈ OF),
         let x_res : κF := IsLocalRing.residue ↥OF ⟨x, hx⟩
         let K_res : Subfield κF := Subfield.closure (Set.range κ_hom)
         let Kx_res : Subfield κF := Subfield.closure (Set.range κ_hom ∪ {x_res})
         letI : Algebra ↥K_res κF := K_res.toAlgebra
         letI : Algebra ↥Kx_res κF := Kx_res.toAlgebra
         Transcendental ↥K_res x_res →
         Algebra.IsSeparable ↥Kx_res κF →
         IsWeilAnalyticUnramifiedGen K_hat F_hat x)
def IsIdealCocycleRationalMapToProj (k : Type u) [Field k]
    {X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (I : X.left.IdealSheafData)
    (U_compl : X.left.Opens)
    {m : ℕ} (U_cov : Fin m → X.left.affineOpens) (L : ℕ)
    (h : ∀ i : Fin m, Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op (U_cov i).1)))
    (Φ₀ : U_compl.toScheme ⟶ (weilProjectiveSpaceOver k L).left) : Prop :=
  let 𝒜_L := MvPolynomial.homogeneousSubmodule (Fin (L + 1)) k
  letI : GradedAlgebra 𝒜_L := MvPolynomial.gradedAlgebra
  let P_L := weilProjectiveSpaceOver k L
  (U_compl : Set X.left) = (I.support : Set X.left)ᶜ ∧
  (⨆ i : Fin m, (U_cov i).1) = ⊤ ∧
  (∀ i : Fin m, I.ideal (U_cov i) = Ideal.span (Set.range (h i))) ∧
  (∀ i j : Fin m,
    AlgebraicGeometry.IsAffineOpen ((U_cov i).1 ⊓ (U_cov j).1) ∧
    ∃ u : ↑(X.left.presheaf.obj (Opposite.op ((U_cov i).1 ⊓ (U_cov j).1))),
      IsUnit u ∧
      ∀ a : Fin (L + 1),
        X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op (h i a) =
          u * X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op (h j a)) ∧
  (Φ₀ ≫ P_L.hom = U_compl.ι ≫ X.hom) ∧
  (∀ (i : Fin m) (V : X.left.affineOpens) (hi : V.1 ≤ (U_cov i).1) (α : Fin (L + 1)),
    let R_V := ↑(X.left.presheaf.obj (Opposite.op V.1))
    let h_V : Fin (L + 1) → R_V :=
      fun β => X.left.presheaf.map (CategoryTheory.homOfLE hi).op (h i β)
    let C_α := HomogeneousLocalization.Away 𝒜_L (MvPolynomial.X α)
    let w_α : AlgebraicGeometry.Spec (CommRingCat.of C_α) ⟶ P_L.left :=
      AlgebraicGeometry.Proj.awayι 𝒜_L (MvPolynomial.X α)
        (MvPolynomial.isHomogeneous_X k α) zero_lt_one
    ∃ (ι_Vα : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h_V α))) ⟶
        U_compl.toScheme)
      (ψ_Vα : C_α →+* Localization.Away (h_V α)),
      AlgebraicGeometry.IsOpenImmersion ι_Vα ∧
      (ι_Vα ≫ U_compl.ι =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R_V (Localization.Away (h_V α)))) ≫ V.2.fromSpec) ∧
      (ι_Vα ≫ Φ₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Vα) ≫ w_α) ∧
      ((U_compl.ι.base ⁻¹' (V.1 : Set X.left)) ∩ (Φ₀.base ⁻¹' Set.range w_α.base) =
        Set.range ι_Vα.base) ∧
      (∀ β : Fin (L + 1),
        ψ_Vα (HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜_L)
          (MvPolynomial.isHomogeneous_X k α) (MvPolynomial.isHomogeneous_X k β)) =
        IsLocalization.mk' (Localization.Away (h_V α)) (h_V β)
          ⟨h_V α, Submonoid.mem_powers (h_V α)⟩))
abbrev weilDegMonomialIdx (M₀ d₀ : ℕ) : Type :=
  {e : Fin (M₀ + 1) → Fin (d₀ + 1) // (∑ μ : Fin (M₀ + 1), (e μ : ℕ)) = d₀}

noncomputable def weilHomogeneousPoly {k : Type u} [CommRing k] (M₀ d₀ : ℕ)
    (c : weilDegMonomialIdx M₀ d₀ → k) : MvPolynomial (Fin (M₀ + 1)) k :=
  ∑ e : weilDegMonomialIdx M₀ d₀,
    MvPolynomial.C (c e) *
      ∏ μ : Fin (M₀ + 1), (MvPolynomial.X μ : MvPolynomial (Fin (M₀ + 1)) k) ^ (e.1 μ : ℕ)

def IsHomogeneousHypersurfacePullbackOver (k : Type u) [Field k] (M₀ d₀ : ℕ)
    {X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (ιX : X ⟶ weilProjectiveSpaceOver k M₀)
    (F : MvPolynomial (Fin (M₀ + 1)) k)
    {H : AlgebraicGeometry.Scheme.{u}} (ιH : H ⟶ X.left) : Prop :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) :=
    MvPolynomial.gradedAlgebra
  AlgebraicGeometry.IsClosedImmersion ιH ∧
  ∃ (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k (d₀ • 1)),
    Set.range ιH.base =
      (((TopologicalSpace.Opens.map ιX.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) F) :
            Set X.left)ᶜ) ∧
    ∀ (μ : Fin (M₀ + 1))
      (hXμ : MvPolynomial.X μ ∈ MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k 1)
      (U : X.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U)
      (hU_sub : U ≤ (TopologicalSpace.Opens.map ιX.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) (MvPolynomial.X μ))),
      RingHom.ker (ιH.app U).hom =
        Ideal.span {(ιX.left.appLE
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) (MvPolynomial.X μ))
          U hU_sub).hom
          ((AlgebraicGeometry.Proj.awayToSection
            (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) (MvPolynomial.X μ)).hom
            (HomogeneousLocalization.Away.mk
              (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) hXμ d₀ F hF))}
noncomputable def weilProjCenterComplOpen (k : Type u) [Field k] (m : ℕ) :
    (weilProjectiveSpaceOver k (m + 1)).left.Opens :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k) :=
    MvPolynomial.gradedAlgebra
  ⨆ i : Fin (m + 1),
    AlgebraicGeometry.Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k)
      (MvPolynomial.X i.castSucc)

def IsCenterComplLinearProjection (k : Type u) [Field k] (m : ℕ)
    (pr : ((weilProjCenterComplOpen k m : (weilProjectiveSpaceOver k (m + 1)).left.Opens) :
      AlgebraicGeometry.Scheme.{u}) ⟶ (weilProjectiveSpaceOver k m).left) : Prop :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) :=
    MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k) :=
    MvPolynomial.gradedAlgebra
  (pr ≫ (weilProjectiveSpaceOver k m).hom =
    (weilProjCenterComplOpen k m).ι ≫ (weilProjectiveSpaceOver k (m + 1)).hom) ∧
  ∃ (hdeg : ∀ (i : ℕ) (p : MvPolynomial (Fin (m + 1)) k),
      p ∈ MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k i →
      MvPolynomial.rename Fin.castSucc p ∈
        MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k i),
    ∀ (b : Fin (m + 1)),
      (∀ (u : ↥(weilProjCenterComplOpen k m)),
        pr.base u ∈ AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) (MvPolynomial.X b) ↔
        u.1 ∈ AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k) (MvPolynomial.X b.castSucc)) ∧
      ∃ (hsub : Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin (m + 1)) k) ≤
          Submonoid.comap (MvPolynomial.rename Fin.castSucc).toRingHom
            (Submonoid.powers (MvPolynomial.X b.castSucc : MvPolynomial (Fin (m + 1 + 1)) k)))
        (h_le : AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k) (MvPolynomial.X b.castSucc) ≤
          weilProjCenterComplOpen k m)
        (hb₀ : (MvPolynomial.X b : MvPolynomial (Fin (m + 1)) k) ∈
          MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k 1)
        (hb₁ : (MvPolynomial.X b.castSucc : MvPolynomial (Fin (m + 1 + 1)) k) ∈
          MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k 1)
        (hpos : 0 < 1),
        (weilProjectiveSpaceOver k (m + 1)).left.homOfLE h_le ≫ pr =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k)
            (MvPolynomial.X b.castSucc) hb₁ hpos).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.map
              { toRingHom := (MvPolynomial.rename Fin.castSucc).toRingHom, map_mem := @hdeg }
              hsub)) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k)
            (MvPolynomial.X b) hb₀ hpos).inv ≫
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) (MvPolynomial.X b)).ι
def IsLocalRelativeStableMod {K : Type u} [Field K] (V : ValuationSubring K)
    {C_K C' : AlgebraicGeometry.Scheme.{u}}
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (n : ℕ) (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C') (U' : C'.Opens)
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (C_bar : AlgebraicGeometry.Scheme.{u})
    (g_bar : C_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_bar : C_bar ⟶ U'.toScheme)
    (τ_bar : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C_bar)
    (ι_bar : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C_bar) : Prop :=
  let U_K : C_K.Opens := (TopologicalSpace.Opens.map ι'.base).obj U'
  IsStrictlySemistableCurveOverValuation V g_bar ∧
  AlgebraicGeometry.IsProper f_bar ∧
  f_bar ≫ U'.ι ≫ g' = g_bar ∧
  ι_bar ≫ f_bar = ι_U' ∧
  CategoryTheory.IsPullback ι_bar (U_K.ι ≫ p_K) g_bar
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
  (∀ j : Fin n,
    let S_j : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens :=
      (TopologicalSpace.Opens.map (τ' j).base).obj U'
    (τ_bar j ≫ f_bar) ≫ U'.ι = S_j.ι ≫ τ' j) ∧
  (_root_.Pairwise fun i j : Fin n =>
    Disjoint (Set.range (τ_bar i).base) (Set.range (τ_bar j).base)) ∧
  (∀ (j : Fin n)
      (b : AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U')),
    ∃ V_sm : C_bar.Opens,
      (τ_bar j).base b ∈ V_sm ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_bar)) ∧
  (∀ (K' : Type u) [Field K'] [IsAlgClosed K']
      (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (E : Set ↥(CategoryTheory.Limits.pullback g_bar s))
      (E_sch : AlgebraicGeometry.Scheme.{u})
      (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g_bar s),
    E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_bar s) →
    AlgebraicGeometry.IsClosedImmersion ιE →
    AlgebraicGeometry.IsIntegral E_sch →
    Set.range ιE.base = E →
    (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver K' 1).left,
      ιE ≫ CategoryTheory.Limits.pullback.snd g_bar s =
        isoP1.hom ≫ (weilProjectiveSpaceOver K' 1).hom) →
    (∃ x₀ : U'.toScheme,
      ∀ q ∈ E, f_bar.base ((CategoryTheory.Limits.pullback.fst g_bar s).base q) = x₀) →
    ∃ q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback g_bar s),
      q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
      q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
      (∀ q ∈ ({q₁, q₂, q₃} : Set ↥(CategoryTheory.Limits.pullback g_bar s)),
        (∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_bar s),
          E' ≠ E ∧ q ∈ E') ∨
        (∃ j : Fin n,
          (CategoryTheory.Limits.pullback.fst g_bar s).base q ∈ Set.range (τ_bar j).base)))

def IsUnembeddedSemistablePointedModel {K : Type u} [Field K] (V : ValuationSubring K)
    {C_K C' : AlgebraicGeometry.Scheme.{u}}
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_semi : C_semi ⟶ C')
    (τ_semi : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
    (ι_semi : C_K ⟶ C_semi) : Prop :=
  IsStrictlySemistableCurveOverValuation V g_semi ∧
  AlgebraicGeometry.IsProper f_semi ∧
  f_semi ≫ g' = g_semi ∧
  AlgebraicGeometry.IsProper g_semi ∧
  AlgebraicGeometry.Surjective g_semi ∧
  (∀ j : Fin n, τ_semi j ≫ f_semi = τ' j) ∧
  (∀ j : Fin n, τ_semi j ≫ g_semi = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V))) ∧
  CategoryTheory.IsPullback ι_semi p_K g_semi
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
  (∀ j : Fin n, σ_K j ≫ ι_semi =
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) ≫ τ_semi j) ∧
  (_root_.Pairwise fun i j : Fin n =>
    Disjoint (Set.range (τ_semi i).base) (Set.range (τ_semi j).base)) ∧
  (∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
    ∃ V_sm : C_semi.Opens,
      (τ_semi j).base b ∈ V_sm ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_semi)) ∧
  (∀ (K' : Type u) [Field K'] [IsAlgClosed K']
      (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
    ConnectedSpace ↥(CategoryTheory.Limits.pullback g_semi s) ∧
    ∀ y : ↥(CategoryTheory.Limits.pullback g_semi s),
      (∃ V_sm : (CategoryTheory.Limits.pullback g_semi s).Opens,
        y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
          (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g_semi s)) ∨
      (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ CategoryTheory.Limits.pullback g_semi s)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) K' ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = y ∧
        (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
        e₁ ≫ CategoryTheory.Limits.pullback.snd g_semi s =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))))
def HasStandardSemistableLocalizationPresentation {K : Type u} [Field K]
    (V : ValuationSubring K) {E : Type u} [Field E] [Algebra K E]
    (R : Subring E)
    (hVR : ∀ y : ↥V, ((algebraMap K E).comp V.subtype) y ∈ R) : Prop :=
  (∃ (ψ : Polynomial ↥V →+* ↥R) (g₀ : Polynomial ↥V),
    ψ.comp Polynomial.C = RingHom.codRestrict ((algebraMap K E).comp V.subtype) R hVR ∧
    @IsLocalization.Away _ _ g₀ ↥R _ ψ.toAlgebra) ∨
  (∃ (a : ↥V)
      (ψ : (MvPolynomial (Fin 2) ↥V ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+* ↥R)
      (g₀ : MvPolynomial (Fin 2) ↥V ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}),
    a ≠ 0 ∧
    ψ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
      RingHom.codRestrict ((algebraMap K E).comp V.subtype) R hVR ∧
    @IsLocalization.Away _ _ g₀ ↥R _ ψ.toAlgebra)

def HasSmoothCurveLocalRegularityAndOverringOpen
    (C_K : AlgebraicGeometry.Scheme.{u})
    (F : Type u) [Field F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K) : Prop :=
  (∀ (f : F) (z : C_K),
    ∃ (W : C_K.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
      (φ : C_K.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
      z ∈ W ∧
      @IsFractionRing ↑(C_K.presheaf.obj (Opposite.op W)) _ F _ φ.hom.toAlgebra ∧
      AlgebraicGeometry.Spec.map φ ≫ hW.fromSpec = η_F ∧
      (f ∈ Set.range φ.hom ∨ f⁻¹ ∈ Set.range φ.hom)) ∧
  (∀ (V_K : C_K.Opens) (hVK : AlgebraicGeometry.IsAffineOpen V_K)
      (φ_K : C_K.presheaf.obj (Opposite.op V_K) ⟶ CommRingCat.of F)
      (G : Finset F),
    Nonempty ↥V_K.toScheme →
    @IsFractionRing ↑(C_K.presheaf.obj (Opposite.op V_K)) _ F _ φ_K.hom.toAlgebra →
    AlgebraicGeometry.Spec.map φ_K ≫ hVK.fromSpec = η_F →
    let B_K : Subring F := Subring.closure (Set.range φ_K.hom ∪ (G : Set F))
    let ψ_BK : C_K.presheaf.obj (Opposite.op V_K) ⟶ CommRingCat.of ↥B_K :=
      CommRingCat.ofHom (RingHom.codRestrict φ_K.hom B_K (fun a =>
        Subring.subset_closure (Or.inl ⟨a, rfl⟩)))
    let ι_BK : AlgebraicGeometry.Spec (CommRingCat.of ↥B_K) ⟶ V_K.toScheme :=
      AlgebraicGeometry.Spec.map ψ_BK ≫ hVK.isoSpec.inv
    AlgebraicGeometry.IsOpenImmersion ι_BK ∧
    Set.range ι_BK.base =
      {z : ↥V_K.toScheme | ∀ f ∈ G,
        ∃ (W : C_K.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
          (φ : C_K.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
          V_K.ι.base z ∈ W ∧
          AlgebraicGeometry.Spec.map φ ≫ hW.fromSpec = η_F ∧
          f ∈ Set.range φ.hom})

def IsStrictlySemistableSubringCoverForCoords {K : Type u} [Field K]
    (V : ValuationSubring K) {F : Type u} [Field F] [Algebra K F]
    (M₀ : ℕ) (ξ : Fin (M₀ + 1) → F) : Prop :=
  ∃ (r₀ : ℕ)
    (r_idx : Fin r₀ → Fin (M₀ + 1))
    (B : Fin r₀ → Subring F)
    (hVB : ∀ (i : Fin r₀) (y : ↥V), ((algebraMap K F).comp V.subtype) y ∈ B i)
    (G : Fin r₀ → Finset F),
    (∀ i : Fin r₀, ξ (r_idx i) ≠ 0) ∧
    (∀ (i : Fin r₀) (s : Fin (M₀ + 1)), ξ s / ξ (r_idx i) ∈ B i) ∧
    (∀ (i : Fin r₀) (f : F), f ∈ G i → f ∈ B i ∧ f ≠ 0) ∧
    (∀ i : Fin r₀,
      Subring.closure
        (Set.range ((algebraMap K F).comp V.subtype) ∪
          Set.range (fun s : Fin (M₀ + 1) => ξ s / ξ (r_idx i)) ∪
          (G i : Set F)) = B i) ∧
    (∀ i : Fin r₀,
      IsStrictlySemistableCurveOverValuation V
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (RingHom.codRestrict ((algebraMap K F).comp V.subtype) (B i) (hVB i))))) ∧
    (∀ (W : ValuationSubring F),
      (∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ W) →
      ∃ i : Fin r₀, (B i : Set F) ⊆ (W : Set F))
def HasStablePointedGeomFiber {C S : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C))
    (K' : Type u) [Field K']
    (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ S) : Prop :=
  ∀ (E : Set ↥(CategoryTheory.Limits.pullback g s))
      (E_sch : AlgebraicGeometry.Scheme.{u})
      (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g s),
    E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s) →
    AlgebraicGeometry.IsClosedImmersion ιE →
    AlgebraicGeometry.IsIntegral E_sch →
    Set.range ιE.base = E →
    (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver K' 1).left,
      ιE ≫ CategoryTheory.Limits.pullback.snd g s =
        isoP1.hom ≫ (weilProjectiveSpaceOver K' 1).hom) →
    ∃ q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback g s),
      q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
      q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
      (∀ q ∈ ({q₁, q₂, q₃} : Set ↥(CategoryTheory.Limits.pullback g s)),
        (∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s),
          E' ≠ E ∧ q ∈ E') ∨
        (∃ j : Fin n,
          (CategoryTheory.Limits.pullback.fst g s).base q ∈ Set.range (τ j).base))

def IsClosedFiberUnstableP1Datum {K : Type u} [Field K] (V : ValuationSubring K)
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))) : Prop :=
  let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
  let Y := CategoryTheory.Limits.pullback g s₀
  let Y'_set : Set ↥Y := ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E'
  let Δ : Set ↥Y := Z ∩ Y'_set
  Z ∈ irreducibleComponents ↥Y ∧
  AlgebraicGeometry.IsClosedImmersion ιZ ∧
  AlgebraicGeometry.IsIntegral Z_sch ∧
  Set.range ιZ.base = Z ∧
  (∃ isoP1 : Z_sch ≅ (weilProjectiveSpaceOver k₀ 1).left,
    ιZ ≫ CategoryTheory.Limits.pullback.snd g s₀ =
      isoP1.hom ≫ (weilProjectiveSpaceOver k₀ 1).hom) ∧
  IsClosed Y'_set ∧
  Y'_set.Nonempty ∧
  Z ∪ Y'_set = Set.univ ∧
  Δ.Finite ∧
  1 ≤ Δ.ncard ∧ Δ.ncard ≤ 2 ∧
  (∀ (q : ↥Y) (j : Fin n), q ∈ Δ →
    (CategoryTheory.Limits.pullback.fst g s₀).base q ∉ Set.range (τ j).base) ∧
  (∀ q ∈ Δ, ¬ ∃ V_sm : Y.Opens,
    q ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
      (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g s₀)) ∧
  (Δ.ncard = 2 → ∀ (q : ↥Y) (j : Fin n), q ∈ Z →
    (CategoryTheory.Limits.pullback.fst g s₀).base q ∉ Set.range (τ j).base) ∧
  (Δ.ncard = 1 → ∀ (i j : Fin n) (q₁ q₂ : ↥Y),
    q₁ ∈ Z → q₂ ∈ Z →
    (CategoryTheory.Limits.pullback.fst g s₀).base q₁ ∈ Set.range (τ i).base →
    (CategoryTheory.Limits.pullback.fst g s₀).base q₂ ∈ Set.range (τ j).base →
    i = j) ∧
  2 ≤ Nat.card ↥(irreducibleComponents ↥Y)

def HasTwoPointPinchAt (K' : Type u) [Field K']
    {X_fib : AlgebraicGeometry.Scheme.{u}}
    (p_fib : X_fib ⟶ AlgebraicGeometry.Spec (CommRingCat.of K'))
    (y : ↥X_fib) : Prop :=
  ∃ (W_y : X_fib.Opens) (hy : y ∈ W_y)
    (A' : CommRingCat.{u})
    (ιK : CommRingCat.of K' ⟶ A')
    (ev₁ ev₂ : A' ⟶ CommRingCat.of K'),
    ιK ≫ ev₁ = 𝟙 (CommRingCat.of K') ∧
    ιK ≫ ev₂ = 𝟙 (CommRingCat.of K') ∧
    RingHom.ker ev₁.hom ≠ RingHom.ker ev₂.hom ∧
    (∃ V₁ : (AlgebraicGeometry.Spec A').Opens,
      (⟨RingHom.ker ev₁.hom, RingHom.ker_isPrime ev₁.hom⟩ : PrimeSpectrum A') ∈ V₁ ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1
        (V₁.ι ≫ AlgebraicGeometry.Spec.map ιK)) ∧
    (∃ V₂ : (AlgebraicGeometry.Spec A').Opens,
      (⟨RingHom.ker ev₂.hom, RingHom.ker_isPrime ev₂.hom⟩ : PrimeSpectrum A') ∈ V₂ ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1
        (V₂.ι ≫ AlgebraicGeometry.Spec.map ιK)) ∧
    ∃ (hK : ∀ c : K', ιK.hom c ∈ RingHom.eqLocus ev₁.hom ev₂.hom)
      (isoW : W_y.toScheme ≅
        AlgebraicGeometry.Spec (CommRingCat.of ↥(RingHom.eqLocus ev₁.hom ev₂.hom))),
      isoW.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (ιK.hom.codRestrict (RingHom.eqLocus ev₁.hom ev₂.hom).toSubsemiring hK)) =
        W_y.ι ≫ p_fib ∧
      (isoW.hom.base ⟨y, hy⟩).asIdeal =
        RingHom.ker (ev₁.hom.comp (RingHom.eqLocus ev₁.hom ev₂.hom).subtype)
def IsDivisorialClosedVal {K : Type u} [Field K] (V : ValuationSubring K)
    {U_ss : AlgebraicGeometry.Scheme.{u}}
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    {F_ss : Type u} [Field F_ss]
    (η_ss : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_ss)
    (W : ValuationSubring F_ss) : Prop :=
  ∃ (ψ_ss : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ U_ss)
    (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W))
    (t : ↥W),
    mW.asIdeal = IsLocalRing.maximalIdeal ↥W ∧
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_ss = η_ss ∧
    IsClosed ({ψ_ss.base mW} : Set U_ss) ∧
    (g_ss.base (ψ_ss.base mW)).asIdeal ≠ ⊥ ∧
    ∀ (P : Polynomial ↥V),
      (∃ i : ℕ, P.coeff i ∉ (g_ss.base (ψ_ss.base mW)).asIdeal) →
      Polynomial.eval₂ (AlgebraicGeometry.Spec.preimage (ψ_ss ≫ g_ss)).hom t P ∉
        IsLocalRing.maximalIdeal ↥W

def IsValResolvedOnMod {K : Type u} [Field K] (V : ValuationSubring K)
    {U_ss : AlgebraicGeometry.Scheme.{u}}
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    {F_ss : Type u} [Field F_ss]
    {X : AlgebraicGeometry.Scheme.{u}}
    (p_X : X ⟶ U_ss)
    (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X)
    (W : ValuationSubring F_ss) : Prop :=
  ∃ (ψ_X : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X)
    (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W))
    (U : X.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
    (φ_U : X.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of ↥W)
    (f : ↑(X.presheaf.obj (Opposite.op U))),
    mW.asIdeal = IsLocalRing.maximalIdeal ↥W ∧
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_X = η_X ∧
    ψ_X.base mW ∈ U ∧
    AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec = ψ_X ∧
    ∀ (P : Polynomial ↥V),
      (∃ i : ℕ, P.coeff i ∉ (g_ss.base ((ψ_X ≫ p_X).base mW)).asIdeal) →
      Polynomial.eval₂ (AlgebraicGeometry.Spec.preimage (ψ_X ≫ p_X ≫ g_ss)).hom
        (φ_U.hom f) P ∉ IsLocalRing.maximalIdeal ↥W

def HasStrictlySemistablePointBlowups {K : Type u} [Field K] (V : ValuationSubring K) : Prop :=
  (∀ (X : AlgebraicGeometry.Scheme.{u})
      (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (z : X) (W : X.Opens) (hz : z ∈ W)
      (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V)))
      (s₁ c₁ π₁ : ↥V),
    IsStrictlySemistableCurveOverValuation V g_X →
    IsClosed ({z} : Set X) →
    (g_X.base z).asIdeal ≠ ⊥ →
    AlgebraicGeometry.Etale e →
    W.ι ≫ g_X = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
    s₁ ∉ (g_X.base z).asIdeal →
    π₁ ∈ (g_X.base z).asIdeal →
    π₁ ≠ 0 →
    Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁ ∈ (e.base ⟨z, hz⟩).asIdeal →
    ∃ (X' : AlgebraicGeometry.Scheme.{u})
      (g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_bl : X' ⟶ X)
      (U_iso : X.Opens)
      (V_sm' : X'.Opens)
      (e' : V_sm'.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
      IsStrictlySemistableCurveOverValuation V g_X' ∧
      V_sm' ≤ (TopologicalSpace.Opens.map f_bl.base).obj W ∧
      AlgebraicGeometry.IsProper f_bl ∧
      f_bl ≫ g_X = g_X' ∧
      CategoryTheory.IsIso (f_bl ∣_ U_iso) ∧
      (∀ x : X, (g_X.base x).asIdeal = ⊥ → x ∈ U_iso) ∧
      AlgebraicGeometry.Etale e' ∧
      V_sm'.ι ≫ g_X' = e' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm'.ι ≫ g_X') ∧
      (∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
          (ψ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ X')
          (mR : AlgebraicGeometry.Spec (CommRingCat.of R))
          (ψ_W : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ W.toScheme),
        mR.asIdeal = IsLocalRing.maximalIdeal R →
        (ψ ≫ f_bl).base mR = z →
        ψ_W ≫ W.ι = ψ ≫ f_bl →
        ∀ (q : R),
          (AlgebraicGeometry.Spec.preimage (ψ ≫ g_X')).hom π₁ ≠ 0 →
          (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom
              (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁) =
            (AlgebraicGeometry.Spec.preimage (ψ ≫ g_X')).hom π₁ * q →
          ∃ (ψ_V : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ V_sm'.toScheme),
            ψ_V ≫ V_sm'.ι = ψ ∧
            (AlgebraicGeometry.Spec.preimage (ψ ≫ g_X')).hom π₁ *
                (AlgebraicGeometry.Spec.preimage (ψ_V ≫ e')).hom Polynomial.X =
              (AlgebraicGeometry.Spec.preimage (ψ ≫ g_X')).hom π₁ * q)) ∧
  (∀ (X : AlgebraicGeometry.Scheme.{u})
      (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (z : X) (W : X.Opens) (hz : z ∈ W) (a : ↥V)
      (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})))
      (s₁ π₁ a' : ↥V),
    IsStrictlySemistableCurveOverValuation V g_X →
    IsClosed ({z} : Set X) →
    (g_X.base z).asIdeal ≠ ⊥ →
    a ≠ 0 →
    AlgebraicGeometry.Etale e →
    W.ι ≫ g_X = e ≫ AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) →
    a = π₁ * a' →
    s₁ ∉ (g_X.base z).asIdeal →
    π₁ ∈ (g_X.base z).asIdeal →
    (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e.base ⟨z, hz⟩).asIdeal) →
    ∃ (X' : AlgebraicGeometry.Scheme.{u})
      (g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_bl : X' ⟶ X)
      (U_iso : X.Opens)
      (V_sm' : X'.Opens)
      (e_sm : V_sm'.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
      IsStrictlySemistableCurveOverValuation V g_X' ∧
      AlgebraicGeometry.IsProper f_bl ∧
      f_bl ≫ g_X = g_X' ∧
      CategoryTheory.IsIso (f_bl ∣_ U_iso) ∧
      (∀ x : X, (g_X.base x).asIdeal = ⊥ → x ∈ U_iso) ∧
      (∀ (x : X) (V_sm : X.Opens),
        x ∈ V_sm → AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X) → x ∈ U_iso) ∧
      AlgebraicGeometry.Etale e_sm ∧
      V_sm'.ι ≫ g_X' = e_sm ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm'.ι ≫ g_X') ∧
      (∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
          (ψ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ X')
          (mR : AlgebraicGeometry.Spec (CommRingCat.of R))
          (ψ_W : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ W.toScheme)
          (q : R),
        mR.asIdeal = IsLocalRing.maximalIdeal R →
        (ψ ≫ f_bl).base mR = z →
        ψ_W ≫ W.ι = ψ ≫ f_bl →
        IsUnit q →
        (AlgebraicGeometry.Spec.preimage (ψ ≫ g_X')).hom π₁ ≠ 0 →
        (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom
            (Ideal.Quotient.mk _ (MvPolynomial.C s₁ * MvPolynomial.X 0)) =
          (AlgebraicGeometry.Spec.preimage (ψ ≫ g_X')).hom π₁ * q →
        Set.range ψ.base ⊆ (V_sm' : Set X')))
def WeilLefschetzIsRelFrobPow (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    (n : ℕ) (φ : Quiver.Hom (weilGeomScheme K Z) (weilGeomScheme K Z)) : Prop :=
  let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
  let fst := CategoryTheory.Limits.pullback.fst Z.hom f₂
  let snd := CategoryTheory.Limits.pullback.snd Z.hom f₂
  CategoryTheory.CategoryStruct.comp φ snd = snd ∧
  (CategoryTheory.CategoryStruct.comp φ fst).base = fst.base ∧
  ∀ (U₀ : Z.left.Opens),
    ∃ (hU : (TopologicalSpace.Opens.map fst.base).obj U₀ ≤
        (TopologicalSpace.Opens.map (CategoryTheory.CategoryStruct.comp φ fst).base).obj U₀),
      ∀ a₀ : ↑(Z.left.presheaf.obj (Opposite.op U₀)),
        ((CategoryTheory.CategoryStruct.comp φ fst).appLE U₀
          ((TopologicalSpace.Opens.map fst.base).obj U₀) hU).hom a₀ =
          ((fst.app U₀).hom a₀) ^ (Nat.card K ^ n)

def WeilLefschetzTorsionPullback {W₁ W₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom W₁ W₂) (m i : ℕ)
    (p : weilEtaleTorsionH W₂ m i →+ weilEtaleTorsionH W₁ m i) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor W₂.Etale W₁.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  let J₁ := W₁.smallEtaleTopology
  let J₂ := W₂.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  ∃ (hCont : B.IsContinuous J₂ J₁),
    letI := hCont
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    ∃ (P_pull : CategoryTheory.Functor
        (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u})
        (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}))
      (adj_pull : CategoryTheory.Adjunction P_pull P_push)
      (hAdd : P_pull.Additive)
      (hLim : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
      (hColim : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
      (T₁ : W₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (T₂ : W₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
      letI := hAdd
      letI := hLim
      letI := hColim
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
      let πℤ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
        (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
          ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
            (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ) ((C₁.obj Aℤ).obj.map τ.op)))
      let πM : Quiver.Hom (P_pull.obj (C₂.obj AM)) (C₁.obj AM) :=
        (adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM)).symm
          ((adj₂.homEquiv AM (P_push.obj (C₁.obj AM))).symm
            (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM) ((C₁.obj AM).obj.map τ.op)))
      ∃ (ιℤ : Quiver.Hom (C₁.obj Aℤ) (P_pull.obj (C₂.obj Aℤ))),
        CategoryTheory.CategoryStruct.comp ιℤ πℤ = CategoryTheory.CategoryStruct.id (C₁.obj Aℤ) ∧
        CategoryTheory.CategoryStruct.comp πℤ ιℤ = CategoryTheory.CategoryStruct.id (P_pull.obj (C₂.obj Aℤ)) ∧
        ∀ x : weilEtaleTorsionH W₂ m i,
          p x = (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp (C₁.obj Aℤ) (Nat.add_zero i)
            ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull _ _ _ _ _ (C₂.obj Aℤ) (C₂.obj AM) i) x)
              (Nat.zero_add i))

def WeilLefschetzIsTorsionCup (W : AlgebraicGeometry.Scheme.{u})
    (m a b c : ℕ) (hab : a + b = c)
    (cup : weilEtaleTorsionH W m a →+ weilEtaleTorsionH W m b →+ weilEtaleTorsionH W m c) : Prop :=
  let R := ULift.{u, 0} (ZMod m)
  let J := W.smallEtaleTopology
  let R_mod := ModuleCat.of R R
  let C_mod := CategoryTheory.constantSheaf J (ModuleCat.{u, u} R)
  let One_mod := C_mod.obj R_mod
  let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let C_ab := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  let Fℤ := C_ab.obj Aℤ
  let FM := C_ab.obj AM
  let ιM : Quiver.Hom AM (F_fg.obj R_mod) := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let z_to_m : Quiver.Hom Aℤ AM :=
    AddCommGrpCat.ofHom
      { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod m)
        map_zero' := congrArg ULift.up Int.cast_zero
        map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }
  ∃ (U : CategoryTheory.Functor
      (CategoryTheory.Sheaf J (ModuleCat.{u, u} R))
      (CategoryTheory.Sheaf J AddCommGrpCat.{u})),
    (∀ ℱ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R),
      (U.obj ℱ).obj = CategoryTheory.Functor.comp ℱ.obj F_fg) ∧
    (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)} (u : Quiver.Hom ℱ₁ ℱ₂)
      (V : (W.Etale)ᵒᵖ),
      HEq ((U.map u).hom.app V) (F_fg.map (u.hom.app V))) ∧
    ∃ (hAdd : U.Additive) (hLim : CategoryTheory.Limits.PreservesFiniteLimits U)
      (hColim : CategoryTheory.Limits.PreservesFiniteColimits U)
      (T : W.Etale) (hT : CategoryTheory.Limits.IsTerminal T),
      letI := hAdd
      letI := hLim
      letI := hColim
      let adj_ab := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
      let adj_mod := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) hT
      ∃ (u_unit : Quiver.Hom (F_fg.obj R_mod) ((U.obj One_mod).obj.obj (Opposite.op T))),
        HEq u_unit (F_fg.map (adj_mod.unit.app R_mod)) ∧
        let αM : Quiver.Hom FM (U.obj One_mod) :=
          (adj_ab.homEquiv AM (U.obj One_mod)).symm
            (CategoryTheory.CategoryStruct.comp ιM u_unit)
        let ιℤ : Quiver.Hom Fℤ (U.obj One_mod) :=
          CategoryTheory.CategoryStruct.comp (C_ab.map z_to_m) αM
        ∃ (πM : Quiver.Hom (U.obj One_mod) FM),
          CategoryTheory.CategoryStruct.comp αM πM = CategoryTheory.CategoryStruct.id FM ∧
          CategoryTheory.CategoryStruct.comp πM αM = CategoryTheory.CategoryStruct.id (U.obj One_mod) ∧
          let θ : ∀ (k : ℕ), CategoryTheory.Abelian.Ext.{u} One_mod One_mod k → weilEtaleTorsionH W m k :=
            fun k γ =>
              (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ (Nat.add_zero k)
                ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
                  ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U _ _ _ _ _ One_mod One_mod k) γ)
                  (Nat.zero_add k))
          ∀ (α : CategoryTheory.Abelian.Ext.{u} One_mod One_mod a)
            (β : CategoryTheory.Abelian.Ext.{u} One_mod One_mod b),
            cup (θ a α) (θ b β) = θ c (α.comp β hab)

structure WeilLefschetzEllAdicSpace (W : AlgebraicGeometry.Scheme.{u})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) where
  V : Type u
  [addCommGroup : AddCommGroup V]
  [module : Module (Padic ℓ) V]
  equiv : TensorProduct ℤ ℚ ↥(weilEtaleIntegralSystem W ℓ m) ≃+ V
  hsmul : ∀ (z : PadicInt ℓ) (x y : ↥(weilEtaleIntegralSystem W ℓ m)),
    (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
      equiv (TensorProduct.tmul ℤ (1 : ℚ) y) = (z : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x)

instance instAddCommGroupWeilLefschetzEllAdicSpaceV {W : AlgebraicGeometry.Scheme.{u}}
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {m : ℕ}
    (H : WeilLefschetzEllAdicSpace W ℓ m) : AddCommGroup H.V := H.addCommGroup

instance instModuleWeilLefschetzEllAdicSpaceV {W : AlgebraicGeometry.Scheme.{u}}
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {m : ℕ}
    (H : WeilLefschetzEllAdicSpace W ℓ m) : Module (Padic ℓ) H.V := H.module

def WeilLefschetzIsEllAdicPullback {W₁ W₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom W₁ W₂) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ)
    (H₁ : WeilLefschetzEllAdicSpace W₁ ℓ m)
    (H₂ : WeilLefschetzEllAdicSpace W₂ ℓ m)
    (f : H₂.V →ₗ[Padic ℓ] H₁.V) : Prop :=
  ∃ p : ∀ r : ℕ, weilEtaleTorsionH W₂ (ℓ ^ r) m →+ weilEtaleTorsionH W₁ (ℓ ^ r) m,
    (∀ r : ℕ, WeilLefschetzTorsionPullback h (ℓ ^ r) m (p r)) ∧
    ∀ (x : ↥(weilEtaleIntegralSystem W₂ ℓ m)) (y : ↥(weilEtaleIntegralSystem W₁ ℓ m)),
      (∀ r : ℕ, y.1 r = p r (x.1 r)) →
        f (H₂.equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) =
          H₁.equiv (TensorProduct.tmul ℤ (1 : ℚ) y)

def WeilLefschetzIsEllAdicCup (W : AlgebraicGeometry.Scheme.{u})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (a b c : ℕ) (hab : a + b = c)
    (H_a : WeilLefschetzEllAdicSpace W ℓ a)
    (H_b : WeilLefschetzEllAdicSpace W ℓ b)
    (H_c : WeilLefschetzEllAdicSpace W ℓ c)
    (cup : H_a.V →ₗ[Padic ℓ] H_b.V →ₗ[Padic ℓ] H_c.V) : Prop :=
  ∃ c_tors : ∀ r : ℕ, weilEtaleTorsionH W (ℓ ^ r) a →+
      weilEtaleTorsionH W (ℓ ^ r) b →+ weilEtaleTorsionH W (ℓ ^ r) c,
    (∀ r : ℕ, WeilLefschetzIsTorsionCup W (ℓ ^ r) a b c hab (c_tors r)) ∧
    ∀ (x : ↥(weilEtaleIntegralSystem W ℓ a))
      (y : ↥(weilEtaleIntegralSystem W ℓ b))
      (z : ↥(weilEtaleIntegralSystem W ℓ c)),
      (∀ r : ℕ, z.1 r = c_tors r (x.1 r) (y.1 r)) →
        cup (H_a.equiv (TensorProduct.tmul ℤ (1 : ℚ) x))
            (H_b.equiv (TensorProduct.tmul ℤ (1 : ℚ) y)) =
          H_c.equiv (TensorProduct.tmul ℤ (1 : ℚ) z)
def HasSpreadSmoothOrNodalAt
    {Y : AlgebraicGeometry.Scheme.{u}} {Ω : Type u} [Field Ω]
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω)) (y : Y) : Prop :=
  (∃ V : Y.Opens, y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ p_Y)) ∨
  (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
      (e₁ : U' ⟶ Y)
      (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) Ω ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
    AlgebraicGeometry.Etale e₁ ∧
    AlgebraicGeometry.Etale e₂ ∧
    e₁.base u₀ = y ∧
    (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
    e₁ ≫ p_Y =
      e₂ ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))

def HasSpreadGeomStableFiber
    {C S : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C))
    (Ω : Type u) [Field Ω]
    (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S) : Prop :=
  ConnectedSpace ↥(CategoryTheory.Limits.pullback g s) ∧
  (∀ y : ↥(CategoryTheory.Limits.pullback g s),
    HasSpreadSmoothOrNodalAt (CategoryTheory.Limits.pullback.snd g s) y) ∧
  (∀ (E : Set ↥(CategoryTheory.Limits.pullback g s))
      (E_sch : AlgebraicGeometry.Scheme.{u})
      (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g s),
    E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s) →
    AlgebraicGeometry.IsClosedImmersion ιE →
    AlgebraicGeometry.IsIntegral E_sch →
    Set.range ιE.base = E →
    (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left,
      ιE ≫ CategoryTheory.Limits.pullback.snd g s =
        isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) →
    ∃ q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback g s),
      q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
      q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
      (∀ q ∈ ({q₁, q₂, q₃} : Set ↥(CategoryTheory.Limits.pullback g s)),
        (∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s),
          E' ≠ E ∧ q ∈ E') ∨
        (∃ j : Fin n,
          (CategoryTheory.Limits.pullback.fst g s).base q ∈ Set.range (τ j).base)))
def HasOverringSemistableChartWitness {K : Type u} [Field K]
    (V₁ : ValuationSubring K) {E : Type u} [Field E] [Algebra K E]
    (Vx : ValuationSubring E) (S₁ : Finset E) : Prop :=
  let v₁Map : ↥V₁ →+* E := (algebraMap K E).comp V₁.subtype
  (∃ (u : E) (g₁ : Polynomial ↥V₁),
    u ∈ Vx ∧
    Transcendental K u ∧
    Polynomial.eval₂ v₁Map u g₁ ≠ 0 ∧
    (Polynomial.eval₂ v₁Map u g₁)⁻¹ ∈ Vx ∧
    ∀ z ∈ S₁, ∃ (n : ℕ) (P : Polynomial ↥V₁),
      z * (Polynomial.eval₂ v₁Map u g₁) ^ n = Polynomial.eval₂ v₁Map u P) ∨
  (∃ (u w : E) (a₁ : ↥V₁) (G₁ : MvPolynomial (Fin 2) ↥V₁),
    u ∈ Vx ∧
    w ∈ Vx ∧
    Transcendental K u ∧
    a₁ ≠ 0 ∧
    u * w = v₁Map a₁ ∧
    MvPolynomial.eval₂ v₁Map (fun i : Fin 2 => if i = 0 then u else w) G₁ ≠ 0 ∧
    (MvPolynomial.eval₂ v₁Map (fun i : Fin 2 => if i = 0 then u else w) G₁)⁻¹ ∈ Vx ∧
    ∀ z ∈ S₁, ∃ (n : ℕ) (P : MvPolynomial (Fin 2) ↥V₁),
      z * (MvPolynomial.eval₂ v₁Map (fun i : Fin 2 => if i = 0 then u else w) G₁) ^ n =
        MvPolynomial.eval₂ v₁Map (fun i : Fin 2 => if i = 0 then u else w) P)

structure PerturbedRationalFactorization (K : Type u) [Field K]
    (E : Type u) [Field E] [Algebra K E]
    (x₀ : E) (Vx : ValuationSubring E) (S₁ : Finset E) : Type u where
  p_exp : ℕ
  M : ℕ
  hExpChar : ExpChar K p_exp
  hp_pos : 1 ≤ p_exp
  hM : 1 ≤ M
  e : Fin M → ℕ
  p_val : Fin M → E
  β : Fin M → ↥(Vx.comap (algebraMap K E))
  s_err : Fin M → ↥(Vx.comap (algebraMap K E))
  δ : Fin M → ↥(Vx.comap (algebraMap K E))
  Δ : ↥(Vx.comap (algebraMap K E))
  I_bdd : Finset (Fin M)
  n_f : E → ↥(Vx.comap (algebraMap K E))
  m_f : E → ↥(Vx.comap (algebraMap K E))
  U_pos : E → Polynomial ↥(Vx.comap (algebraMap K E))
  U_neg : E → Polynomial ↥(Vx.comap (algebraMap K E))
  a_exp : E → Fin M → ℕ
  b_exp : E → Fin M → ℕ
  k₀ : Fin M
  hp_mem : ∀ i : Fin M, p_val i ∈ Vx ∧ p_val i ≠ 0
  hΔ_ne : Δ ≠ 0
  hΔ_nonunit : (((algebraMap K E).comp (Vx.comap (algebraMap K E)).subtype) Δ)⁻¹ ∉ Vx
  hp_eq : ∀ i : Fin M,
    let v₁Map := (algebraMap K E).comp (Vx.comap (algebraMap K E)).subtype
    p_val i = (x₀ - v₁Map (β i)) ^ (p_exp ^ (e i)) -
      v₁Map (Δ ^ (2 * (∏ j : Fin M, p_exp ^ (e j))) * s_err i)
  hδ_bdd : ∀ i ∈ I_bdd,
    let v₁Map := (algebraMap K E).comp (Vx.comap (algebraMap K E)).subtype
    δ i ≠ 0 ∧ v₁Map (δ i) / p_val i ∈ Vx ∧ p_val i / v₁Map (δ i) ∉ Vx ∧ δ i ∣ Δ
  h_inf : ∀ i : Fin M, i ∉ I_bdd →
    let V₁ := Vx.comap (algebraMap K E)
    let v₁Map := (algebraMap K E).comp V₁.subtype
    ∀ d : ↥V₁, d ≠ 0 → p_val i / v₁Map d ∈ Vx ∧ v₁Map d / p_val i ∉ Vx
  h_inf_subsingleton : ∀ i j : Fin M, i ∉ I_bdd → j ∉ I_bdd → i = j
  hf_rep : ∀ f ∈ S₁, f ≠ 0 →
    let v₁Map := (algebraMap K E).comp (Vx.comap (algebraMap K E)).subtype
    n_f f ≠ 0 ∧
    m_f f ≠ 0 ∧
    Polynomial.eval₂ v₁Map x₀ (U_pos f) ≠ 0 ∧
    (Polynomial.eval₂ v₁Map x₀ (U_pos f))⁻¹ ∈ Vx ∧
    Polynomial.eval₂ v₁Map x₀ (U_neg f) ≠ 0 ∧
    (Polynomial.eval₂ v₁Map x₀ (U_neg f))⁻¹ ∈ Vx ∧
    (∀ i : Fin M, a_exp f i = 0 ∨ b_exp f i = 0) ∧
    (∀ i : Fin M, i ∉ I_bdd → b_exp f i = 0) ∧
    m_f f * (∏ i ∈ I_bdd, (δ i) ^ (b_exp f i)) ∣ Δ ∧
    f * (v₁Map (m_f f) * Polynomial.eval₂ v₁Map x₀ (U_neg f) *
        ∏ i : Fin M, (p_val i) ^ (b_exp f i)) =
      v₁Map (n_f f) * Polynomial.eval₂ v₁Map x₀ (U_pos f) *
        ∏ i : Fin M, (p_val i) ^ (a_exp f i)
  hk₀_max : ∀ i : Fin M,
    let v₁Map := (algebraMap K E).comp (Vx.comap (algebraMap K E)).subtype
    (x₀ - v₁Map (β k₀)) / (x₀ - v₁Map (β i)) ∈ Vx
noncomputable def weilProjBasicOpen (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)) :
    (weilProjectiveSpaceOver R N).left.Opens :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
    MvPolynomial.gradedAlgebra
  AlgebraicGeometry.Proj.basicOpen
    (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (MvPolynomial.X a)

def IsCommRingProjCoordSystem (R : Type u) [CommRing R] (N : ℕ)
    (hAff : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
    (c_R : ∀ a : Fin (N + 1),
      R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (t_R : ∀ a : Fin (N + 1), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a)))) : Prop :=
  AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R N).hom ∧
  (⨆ a : Fin (N + 1), weilProjBasicOpen R N a) = ⊤ ∧
  (∀ a : Fin (N + 1),
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_R a)) =
      (hAff a).fromSpec ≫ (weilProjectiveSpaceOver R N).hom) ∧
  (∀ a : Fin (N + 1),
    ∃ (θ : MvPolynomial (Fin N) R ≃+*
        ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R N a)))),
      θ.toRingHom.comp MvPolynomial.C = c_R a) ∧
  (∀ a : Fin (N + 1), t_R a a = 1) ∧
  (∀ a : Fin (N + 1),
    Subring.closure (Set.range (c_R a) ∪ Set.range (t_R a)) = ⊤) ∧
  (∀ (a : Fin (N + 1)) (A : Type u) [CommRing A] (ρ : R →+* A) (v : Fin (N + 1) → A),
    v a = 1 →
    ∃ (ψ : ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))) →+* A),
      ψ.comp (c_R a) = ρ ∧ ∀ b : Fin (N + 1), ψ (t_R a b) = v b) ∧
  (∀ a a' : Fin (N + 1),
    (weilProjectiveSpaceOver R N).left.basicOpen (t_R a a') =
      weilProjBasicOpen R N a ⊓ weilProjBasicOpen R N a') ∧
  (∀ (a a' : Fin (N + 1)) (r : R),
    ((weilProjectiveSpaceOver R N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_right).op).hom (c_R a' r) =
    ((weilProjectiveSpaceOver R N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_left).op).hom (c_R a r)) ∧
  (∀ (a a' b : Fin (N + 1)),
    ((weilProjectiveSpaceOver R N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_right).op).hom (t_R a' b) *
    ((weilProjectiveSpaceOver R N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_left).op).hom (t_R a a') =
    ((weilProjectiveSpaceOver R N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_left).op).hom (t_R a b))

def IsCommRingProjBaseChange (R S : Type u) [CommRing R] [CommRing S]
    (φ_RS : R →+* S) (N : ℕ)
    (c_R : ∀ a : Fin (N + 1),
      R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (t_R : ∀ a : Fin (N + 1), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (c_S : ∀ a : Fin (N + 1),
      S →+* ↑((weilProjectiveSpaceOver S N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen S N a))))
    (t_S : ∀ a : Fin (N + 1), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver S N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen S N a))))
    (Φ : (weilProjectiveSpaceOver S N).left ⟶ (weilProjectiveSpaceOver R N).left) : Prop :=
  Φ ≫ (weilProjectiveSpaceOver R N).hom =
    (weilProjectiveSpaceOver S N).hom ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS) ∧
  CategoryTheory.IsPullback Φ (weilProjectiveSpaceOver S N).hom
    (weilProjectiveSpaceOver R N).hom
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)) ∧
  ∀ a : Fin (N + 1),
    ∃ (heq : (TopologicalSpace.Opens.map Φ.base).obj (weilProjBasicOpen R N a) =
        weilProjBasicOpen S N a),
      (∀ r : R,
        (Φ.app (weilProjBasicOpen R N a) ≫
          (weilProjectiveSpaceOver S N).left.presheaf.map (CategoryTheory.eqToHom heq.symm).op).hom
            (c_R a r) = c_S a (φ_RS r)) ∧
      (∀ b : Fin (N + 1),
        (Φ.app (weilProjBasicOpen R N a) ≫
          (weilProjectiveSpaceOver S N).left.presheaf.map (CategoryTheory.eqToHom heq.symm).op).hom
            (t_R a b) = t_S a b)

def IsSegreGenericClosedImmersion {K : Type u} [Field K]
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    {F : Type u} [Field F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K)
    (M₀ : ℕ) (ξ : Fin (M₀ + 1) → F) (V_K0 : Fin (M₀ + 1) → C_K.Opens)
    (L : ℕ) (f : Fin L → F) (M : ℕ)
    (eSeg : Fin (M + 1) ≃ Fin (M₀ + 1) × Finset (Fin L))
    (t_KM : ∀ a : Fin (M + 1), Fin (M + 1) →
      ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K M a))))
    (Ψ_K : C_K ⟶ (weilProjectiveSpaceOver K M).left) : Prop :=
  AlgebraicGeometry.IsClosedImmersion Ψ_K ∧
  Ψ_K ≫ (weilProjectiveSpaceOver K M).hom = p_K ∧
  ∀ α : Fin (M + 1),
    let W_α : C_K.Opens := (TopologicalSpace.Opens.map Ψ_K.base).obj (weilProjBasicOpen K M α)
    (ξ (eSeg α).1 = 0 → W_α = ⊥) ∧
    (ξ (eSeg α).1 ≠ 0 →
      Nonempty ↥W_α ∧
      (∀ (hW : AlgebraicGeometry.IsAffineOpen W_α)
          (φ_W : C_K.presheaf.obj (Opposite.op W_α) ⟶ CommRingCat.of F),
        AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_F →
        ∀ β : Fin (M + 1),
          φ_W.hom ((Ψ_K.app (weilProjBasicOpen K M α)).hom (t_KM α β)) =
            (ξ (eSeg β).1 / ξ (eSeg α).1) *
              (∏ γ ∈ (eSeg β).2 \ (eSeg α).2, f γ) *
              (∏ γ ∈ (eSeg α).2 \ (eSeg β).2, (f γ)⁻¹)) ∧
      (W_α : Set C_K) =
        {z : C_K | z ∈ V_K0 (eSeg α).1 ∧
          (∀ γ : Fin L, γ ∉ (eSeg α).2 →
            ∃ (W : C_K.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
              (φ : C_K.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
              z ∈ W ∧ AlgebraicGeometry.Spec.map φ ≫ hW.fromSpec = η_F ∧
              f γ ∈ Set.range φ.hom) ∧
          (∀ γ : Fin L, γ ∈ (eSeg α).2 →
            ∃ (W : C_K.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
              (φ : C_K.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
              z ∈ W ∧ AlgebraicGeometry.Spec.map φ ≫ hW.fromSpec = η_F ∧
              (f γ)⁻¹ ∈ Set.range φ.hom)})
def IsWeilType23ModRamified (K_hat E_hat : Type u)
    [NontriviallyNormedField K_hat] [NontriviallyNormedField E_hat]
    [IsUltrametricDist E_hat] [Algebra K_hat E_hat]
    (E_max : Subfield K_hat) (L : Subfield E_hat) : Prop :=
  Set.range (algebraMap K_hat E_hat) ⊆ (L : Set E_hat) ∧
  IsClosed (L : Set E_hat) ∧
  ((∃ (T : E_hat) (L_coeff : Subfield E_hat)
      (hT : T ∈ L_coeff)
      (hE_sub : ∀ e : ↥E_max, algebraMap K_hat E_hat (e : K_hat) ∈ L_coeff),
      L_coeff ≤ L ∧
      (∀ P : Polynomial ↥E_max, P ≠ 0 →
        ‖Polynomial.aeval T (Polynomial.map ((algebraMap K_hat E_hat).comp E_max.subtype) P)‖ = 1) ∧
      (∀ z ∈ L_coeff, ‖z‖ ≤ 1) ∧
      (∀ u ∈ L, u ≠ 0 → ∃ c : K_hat, ‖u‖ = ‖c‖) ∧
      (∀ w ∈ L, ‖w‖ ≤ 1 → ∃ z ∈ L_coeff, ‖w - z‖ < 1) ∧
      (let ιE : ↥E_max →+* ↥L_coeff :=
         ((algebraMap K_hat E_hat).comp E_max.subtype).codRestrict L_coeff.toSubring hE_sub
       letI : Algebra ↥E_max ↥L_coeff := ιE.toAlgebra
       let Kt : IntermediateField ↥E_max ↥L_coeff :=
         IntermediateField.adjoin ↥E_max ({⟨T, hT⟩} : Set ↥L_coeff)
       FiniteDimensional ↥Kt ↥L_coeff ∧ Algebra.IsSeparable ↥Kt ↥L_coeff) ∧
      (let L_T : Subfield E_hat :=
         (IntermediateField.adjoin K_hat ({T} : Set E_hat)).toSubfield.topologicalClosure
       ∃ B_fin : Finset E_hat, (↑B_fin : Set E_hat) ⊆ (L_coeff : Set E_hat) ∧
         ∀ u ∈ L, ∃ c : E_hat → E_hat, (∀ b ∈ B_fin, c b ∈ L_T) ∧
           u = ∑ b ∈ B_fin, c b * b)) ∨
   (∃ T₀ : E_hat, T₀ ∈ L ∧ T₀ ≠ 0 ∧ (∀ c : K_hat, ‖T₀‖ ≠ ‖c‖) ∧
      L = (IntermediateField.adjoin K_hat ({T₀} : Set E_hat)).toSubfield.topologicalClosure))
def weilProjHyperplaneSet (k : Type u) [Field k] (N : ℕ)
    (F : MvPolynomial (Fin (N + 1)) k) :
    Set (weilProjectiveSpaceOver k N).left :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
    MvPolynomial.gradedAlgebra
  (((AlgebraicGeometry.Proj.basicOpen
    (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) F :
    (weilProjectiveSpaceOver k N).left.Opens).1)ᶜ :
    Set (weilProjectiveSpaceOver k N).left)

def IsLinearProjChartMorphism (k : Type u) [Field k] (N ν : ℕ)
    (X : AlgebraicGeometry.Scheme.{u})
    (ι_X : X ⟶ (weilProjectiveSpaceOver k N).left)
    (F : Fin ν → MvPolynomial (Fin (N + 1)) k)
    (G : MvPolynomial (Fin (N + 1)) k)
    (W : X.Opens)
    (ψ : (W : AlgebraicGeometry.Scheme.{u}) ⟶ (weilProjectiveSpaceOver k ν).left) : Prop :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
    MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k) :=
    MvPolynomial.gradedAlgebra
  ∃ (hW : W ≤ (TopologicalSpace.Opens.map ι_X.base).obj
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) G))
    (hdeg : ∀ (i : ℕ) (p : MvPolynomial (Fin (ν + 1)) k),
      p ∈ MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k i →
      MvPolynomial.eval₂Hom MvPolynomial.C (Fin.snoc F G) p ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k i)
    (hsub : Submonoid.powers (MvPolynomial.X (Fin.last ν) : MvPolynomial (Fin (ν + 1)) k) ≤
      Submonoid.comap (MvPolynomial.eval₂Hom MvPolynomial.C (Fin.snoc F G))
        (Submonoid.powers G))
    (hG : G ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
    (hT : (MvPolynomial.X (Fin.last ν) : MvPolynomial (Fin (ν + 1)) k) ∈
      MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k 1)
    (hpos : 0 < 1),
    ψ = X.homOfLE hW ≫
      (ι_X ∣_ AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) G) ≫
      (AlgebraicGeometry.Proj.basicOpenIsoSpec
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) G hG hpos).hom ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (HomogeneousLocalization.map
          { toRingHom := MvPolynomial.eval₂Hom MvPolynomial.C (Fin.snoc F G), map_mem := @hdeg }
          hsub)) ≫
      AlgebraicGeometry.Proj.awayι
        (MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k)
        (MvPolynomial.X (Fin.last ν)) hT hpos

def IsTransversalLinearSlice (k : Type u) [Field k] (N : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_X : X ⟶ weilProjectiveSpaceOver k N)
    (U : X.left.Opens) (d ν : ℕ) (F : Fin ν → MvPolynomial (Fin (N + 1)) k) : Prop :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
    MvPolynomial.gradedAlgebra
  (∀ j : Fin ν, F j ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1) ∧
  ∀ x : X.left, x ∈ U →
    (∀ j : Fin ν, ι_X.left.base x ∈ weilProjHyperplaneSet k N (F j)) →
    ∃ (α₀ : Fin (N + 1)) (V : X.left.Opens)
      (_ : AlgebraicGeometry.IsAffineOpen V) (_ : x ∈ V) (_ : V ≤ U)
      (hVα : V ≤ (TopologicalSpace.Opens.map ι_X.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X α₀)))
      (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (N + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
      (hpos : 0 < 1)
      (s : ℕ)
      (φ : MvPolynomial (Fin (s + ν + d)) k →+* ↑(X.left.presheaf.obj (Opposite.op V)))
      (q : Fin s → MvPolynomial (Fin (s + ν + d)) k)
      (f_lift : Fin ν → MvPolynomial (Fin (s + ν + d)) k)
      (idx : Fin (s + ν) → Fin (s + ν + d)),
      Function.Surjective φ ∧
      Function.Injective idx ∧
      (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V.ι ≫ X.hom) ∧
      RingHom.ker φ = Ideal.span (Set.range q) ∧
      (∀ (j : Fin ν) (hFj : F j ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1),
        φ (f_lift j) =
          ((AlgebraicGeometry.Proj.basicOpenIsoAway
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
            (MvPolynomial.X α₀) hXα hpos).hom ≫
            ι_X.left.appLE
              (AlgebraicGeometry.Proj.basicOpen
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X α₀))
              V hVα).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨F j, hFj⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩)) ∧
      IsUnit (Matrix.det (Matrix.of fun a b : Fin s =>
        φ (MvPolynomial.pderiv (idx (Fin.castAdd ν b)) (q a)))) ∧
      IsUnit (Matrix.det (Matrix.of fun a b : Fin (s + ν) =>
        φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a))))
def IsClosedPointRelExceptionalDatum {K : Type u} [Field K] (V : ValuationSubring K)
    {C' C_cur : AlgebraicGeometry.Scheme.{u}}
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (n : ℕ) (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (U' : C'.Opens)
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom_cur : C_cur ⟶ U'.toScheme)
    (τ_cur : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C_cur)
    (P : PrimeSpectrum ↥V)
    (x₀ : ↥U'.toScheme)
    (Z : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))))) : Prop :=
  let s_P := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))
  let Y_P := CategoryTheory.Limits.pullback g_cur s_P
  let Δ_Z : Set ↥Y_P :=
    {q ∈ Z | ∃ E' ∈ irreducibleComponents ↥Y_P, E' ≠ Z ∧ q ∈ E'}
  P.asIdeal ≠ ⊥ ∧
  IsClosed ({x₀} : Set ↥U'.toScheme) ∧
  (U'.ι ≫ g').base x₀ = P ∧
  Z ∈ irreducibleComponents ↥Y_P ∧
  (∃ (Z_sch : AlgebraicGeometry.Scheme.{u}) (ιZ : Z_sch ⟶ Y_P)
      (isoP1 : Z_sch ≅ (weilProjectiveSpaceOver P.asIdeal.ResidueField 1).left),
    AlgebraicGeometry.IsClosedImmersion ιZ ∧
    AlgebraicGeometry.IsIntegral Z_sch ∧
    Set.range ιZ.base = Z ∧
    ιZ ≫ CategoryTheory.Limits.pullback.snd g_cur s_P =
      isoP1.hom ≫ (weilProjectiveSpaceOver P.asIdeal.ResidueField 1).hom) ∧
  (∀ q ∈ Z,
    f_dom_cur.base ((CategoryTheory.Limits.pullback.fst g_cur s_P).base q) = x₀) ∧
  1 ≤ Δ_Z.ncard ∧
  Δ_Z.ncard ≤ 2 ∧
  (Δ_Z.ncard = 2 →
    ∀ (j : Fin n) (q : ↥Y_P), q ∈ Z →
      (CategoryTheory.Limits.pullback.fst g_cur s_P).base q ∉ Set.range (τ_cur j).base) ∧
  (Δ_Z.ncard = 1 →
    ({j : Fin n | ∃ q ∈ Z,
      (CategoryTheory.Limits.pullback.fst g_cur s_P).base q ∈
        Set.range (τ_cur j).base}).Subsingleton)

def IsIsolatedStrictlySemistableModChart {K : Type u} [Field K] (V : ValuationSubring K)
    {U_ss C_cur : AlgebraicGeometry.Scheme.{u}}
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_ss_cur : C_cur ⟶ U_ss)
    (P : PrimeSpectrum ↥V) (u₀ : ↥U_ss)
    (ϖ : ↥V) (W_B : U_ss.Opens)
    (hu₀ : u₀ ∈ W_B)
    (g_WB : W_B.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (Z_mod : Set ↥W_B.toScheme) (hZ_closed : IsClosed Z_mod) : Prop :=
  let u₀_WB : ↥W_B.toScheme := ⟨u₀, hu₀⟩
  let X_0 : C_cur.Opens := (TopologicalSpace.Opens.map f_ss_cur.base).obj W_B
  let f_0 : X_0.toScheme ⟶ W_B.toScheme := f_ss_cur ∣_ W_B
  let ι_VP : ↥V →+* ↥(V.ofPrime P.asIdeal) :=
    Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
  ϖ ∉ P.asIdeal ∧
  (∀ Q : PrimeSpectrum ↥V, ϖ ∉ Q.asIdeal ↔ Q.asIdeal ≤ P.asIdeal) ∧
  (∀ x : K, x ∈ V.ofPrime P.asIdeal ↔ ∃ (a : ↥V) (k : ℕ), x * (V.subtype ϖ) ^ k = V.subtype a) ∧
  AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)) ∧
  AlgebraicGeometry.IsAffineOpen W_B ∧
  g_WB ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) = W_B.ι ≫ g_ss ∧
  Z_mod.Finite ∧
  (∀ y ∈ Z_mod, ((W_B.ι ≫ g_ss).base y).asIdeal ≠ ⊥) ∧
  CategoryTheory.IsIso (f_0 ∣_ (⟨Z_modᶜ, hZ_closed.isOpen_compl⟩ : W_B.toScheme.Opens)) ∧
  (∀ y ∈ Z_mod, u₀_WB ∈ closure ({y} : Set ↥W_B.toScheme)) ∧
  ((∃ (e₀ : W_B.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥(V.ofPrime P.asIdeal))))
      (m₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥(V.ofPrime P.asIdeal))))),
      AlgebraicGeometry.Etale e₀ ∧
      e₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) = g_WB ∧
      Polynomial.X ∈ m₀.asIdeal ∧
      (∀ r : ↥(V.ofPrime P.asIdeal), r ∈ IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) →
        Polynomial.C r ∈ m₀.asIdeal) ∧
      e₀.base ⁻¹' {m₀} = {u₀_WB} ∧
      ∀ y ∈ Z_mod, e₀.base ⁻¹' {e₀.base y} = {y}) ∨
   (∃ (a₀ : ↥(V.ofPrime P.asIdeal))
      (e₀ : W_B.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) ↥(V.ofPrime P.asIdeal) ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀})))
      (m₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) ↥(V.ofPrime P.asIdeal) ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀})))),
      a₀ ≠ 0 ∧
      a₀ ∈ IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) ∧
      AlgebraicGeometry.Etale e₀ ∧
      e₀ ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = g_WB ∧
      (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ m₀.asIdeal) ∧
      (∀ r : ↥(V.ofPrime P.asIdeal), r ∈ IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) →
        Ideal.Quotient.mk _ (MvPolynomial.C r) ∈ m₀.asIdeal) ∧
      e₀.base ⁻¹' {m₀} = {u₀_WB} ∧
      ∀ y ∈ Z_mod, e₀.base ⁻¹' {e₀.base y} = {y}))

def IsSingleComponentChartContraction {K : Type u} [Field K] (V : ValuationSubring K)
    {W_B_sch X_0_sch : AlgebraicGeometry.Scheme.{u}}
    (P : PrimeSpectrum ↥V)
    (g_WB : W_B_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (f_0 : X_0_sch ⟶ W_B_sch)
    (Z_mod : Set ↥W_B_sch)
    (Z_X0 : Set ↥X_0_sch)
    (isLeaf : Prop)
    (X'_0 : AlgebraicGeometry.Scheme.{u})
    (g'_0 : X'_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (f'_0 : X'_0 ⟶ W_B_sch)
    (q_0 : X_0_sch ⟶ X'_0)
    (Mod_q0 : Set ↥X'_0)
    (hMod_closed : IsClosed Mod_q0)
    (z_new : ↥X'_0) : Prop :=
  let ι_VP : ↥V →+* ↥(V.ofPrime P.asIdeal) :=
    Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
  let F_exc : Set ↥X_0_sch := q_0.base ⁻¹' Mod_q0
  IsStrictlySemistableCurveOverValuation (V.ofPrime P.asIdeal) g'_0 ∧
  q_0 ≫ f'_0 = f_0 ∧
  f'_0 ≫ g_WB = g'_0 ∧
  AlgebraicGeometry.IsProper q_0 ∧
  AlgebraicGeometry.IsProper f'_0 ∧
  AlgebraicGeometry.Surjective q_0 ∧
  f'_0.base '' Mod_q0 ⊆ Z_mod ∧
  CategoryTheory.IsIso (q_0 ∣_ (⟨Mod_q0ᶜ, hMod_closed.isOpen_compl⟩ : X'_0.Opens)) ∧
  (isLeaf → ∀ z ∈ Mod_q0, ∃ V_sm : X'_0.Opens,
    z ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g'_0)) ∧
  z_new ∈ Mod_q0 ∧
  (g'_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base z_new = P ∧
  F_exc ∩ (f_0 ≫ g_WB ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base ⁻¹' {P} = Z_X0 ∧
  Mod_q0 ∩ (g'_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base ⁻¹' {P} = {z_new} ∧
  (∀ Q : PrimeSpectrum ↥V,
    (Mod_q0 ∩ (g'_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base ⁻¹' {Q}).Subsingleton) ∧
  (∃ (Q₀ : PrimeSpectrum ↥V) (z₀ : ↥X'_0),
    Q₀.asIdeal ≠ ⊥ ∧
    Q₀.asIdeal ≤ P.asIdeal ∧
    z₀ ∈ Mod_q0 ∧
    (g'_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base z₀ = Q₀ ∧
    IsIrreducible (q_0.base ⁻¹' {z₀}) ∧
    F_exc = closure (q_0.base ⁻¹' {z₀})) ∧
  (∀ y ∈ F_exc, ∃ z ∈ Z_X0, z ∈ closure ({y} : Set ↥X_0_sch))
def IsOverlapAffineNormalScheme (X : AlgebraicGeometry.Scheme.{u}) : Prop :=
  ∀ (U : X.Opens), AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
    ∃ (_ : IsDomain ↑(X.presheaf.obj (Opposite.op U))),
      IsIntegrallyClosed ↑(X.presheaf.obj (Opposite.op U))

def IsSingleElementaryBlowupStep {K : Type u} [Field K] (V : ValuationSubring K)
    {Z Z' : AlgebraicGeometry.Scheme.{u}}
    (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g_Z' : Z' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_bl : Z' ⟶ Z) : Prop :=
  IsStrictlySemistableCurveOverValuation V g_Z' ∧
  AlgebraicGeometry.IsProper f_bl ∧
  f_bl ≫ g_Z = g_Z' ∧
  (∀ z : Z, _root_.IsConnected (f_bl.base ⁻¹' ({z} : Set Z))) ∧
  (∃ U_iso : Z.Opens,
    CategoryTheory.IsIso (f_bl ∣_ U_iso) ∧
    ∀ x : Z, (g_Z.base x).asIdeal = ⊥ → x ∈ U_iso) ∧
  (∀ (P : Ideal ↥V) [P.IsPrime], P ≠ ⊥ →
    let s_P : AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))
    let F := CategoryTheory.Limits.pullback g_Z s_P
    let F' := CategoryTheory.Limits.pullback g_Z' s_P
    ∀ (f_P : F' ⟶ F),
      f_P ≫ CategoryTheory.Limits.pullback.fst g_Z s_P =
        CategoryTheory.Limits.pullback.fst g_Z' s_P ≫ f_bl →
      f_P ≫ CategoryTheory.Limits.pullback.snd g_Z s_P =
        CategoryTheory.Limits.pullback.snd g_Z' s_P →
      CategoryTheory.IsIso f_P ∨
      ∃ (w₀ : ↥F) (U_w : F.Opens) (E_new : Set ↥F')
        (E_sch : AlgebraicGeometry.Scheme.{u}) (ιE : E_sch ⟶ F'),
        IsClosed ({w₀} : Set ↥F) ∧
        (U_w : Set ↥F) = ({w₀} : Set ↥F)ᶜ ∧
        CategoryTheory.IsIso (f_P ∣_ U_w) ∧
        f_P.base ⁻¹' ({w₀} : Set ↥F) = E_new ∧
        E_new ∈ irreducibleComponents ↥F' ∧
        AlgebraicGeometry.IsClosedImmersion ιE ∧
        AlgebraicGeometry.IsIntegral E_sch ∧
        Set.range ιE.base = E_new ∧
        (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver P.ResidueField 1).left,
          ιE ≫ CategoryTheory.Limits.pullback.snd g_Z' s_P =
            isoP1.hom ≫ (weilProjectiveSpaceOver P.ResidueField 1).hom) ∧
        let R_rest : Set ↥F' :=
          ⋃ (H ∈ irreducibleComponents ↥F') (_ : H ≠ E_new), H
        (((∃ V_sm : Z.Opens,
            (CategoryTheory.Limits.pullback.fst g_Z s_P).base w₀ ∈ V_sm ∧
            AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_Z)) ∧
          ∃ w₁ : ↥F', E_new ∩ R_rest = {w₁}) ∨
        ((∀ V_sm : Z.Opens,
            AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_Z) →
            (CategoryTheory.Limits.pullback.fst g_Z s_P).base w₀ ∉ V_sm) ∧
          ∃ w₁ w₂ : ↥F', w₁ ≠ w₂ ∧ E_new ∩ R_rest = {w₁, w₂})))

def IsElementaryBlowupTower {K : Type u} [Field K] (V : ValuationSubring K)
    {Z Z' : AlgebraicGeometry.Scheme.{u}}
    (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g_Z' : Z' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (p : Z' ⟶ Z) : Prop :=
  ∃ (N : ℕ)
    (Cseq : Fin (N + 1) → AlgebraicGeometry.Scheme.{u})
    (gseq : ∀ i : Fin (N + 1), Cseq i ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (fstep : ∀ i : Fin N, Cseq i.succ ⟶ Cseq i.castSucc)
    (ptow : ∀ i : Fin (N + 1), Cseq i ⟶ Z)
    (e₀ : Cseq 0 ≅ Z)
    (eN : Z' ≅ Cseq (Fin.last N)),
    e₀.hom = ptow 0 ∧
    e₀.hom ≫ g_Z = gseq 0 ∧
    (∀ i : Fin N,
      IsSingleElementaryBlowupStep V (gseq i.castSucc) (gseq i.succ) (fstep i) ∧
      ptow i.succ = fstep i ≫ ptow i.castSucc) ∧
    eN.hom ≫ gseq (Fin.last N) = g_Z' ∧
    eN.hom ≫ ptow (Fin.last N) = p

def HasOverlapElementaryBlowupOracle {K : Type u} [Field K] (V : ValuationSubring K) : Prop :=
  (∀ (X : AlgebraicGeometry.Scheme.{u})
      (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (z : X) (W : X.Opens) (hz : z ∈ W)
      (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V)))
      (s₁ c₁ π₁ : ↥V),
    IsStrictlySemistableCurveOverValuation V g_X →
    IsClosed ({z} : Set X) →
    (g_X.base z).asIdeal ≠ ⊥ →
    AlgebraicGeometry.Etale e →
    W.ι ≫ g_X = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
    s₁ ∉ (g_X.base z).asIdeal →
    π₁ ∈ (g_X.base z).asIdeal →
    π₁ ≠ 0 →
    Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁ ∈ (e.base ⟨z, hz⟩).asIdeal →
    ∃ (X' : AlgebraicGeometry.Scheme.{u})
      (g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_bl : X' ⟶ X)
      (U_iso : X.Opens)
      (V_sm' : X'.Opens)
      (e' : V_sm'.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
      IsSingleElementaryBlowupStep V g_X g_X' f_bl ∧
      V_sm' ≤ (TopologicalSpace.Opens.map f_bl.base).obj W ∧
      CategoryTheory.IsIso (f_bl ∣_ U_iso) ∧
      (∀ x : X, (g_X.base x).asIdeal = ⊥ → x ∈ U_iso) ∧
      AlgebraicGeometry.Etale e' ∧
      V_sm'.ι ≫ g_X' = e' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm'.ι ≫ g_X') ∧
      (∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
          (ψ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ X')
          (mR : AlgebraicGeometry.Spec (CommRingCat.of R))
          (ψ_W : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ W.toScheme),
        mR.asIdeal = IsLocalRing.maximalIdeal R →
        (ψ ≫ f_bl).base mR = z →
        ψ_W ≫ W.ι = ψ ≫ f_bl →
        ∀ (q : R),
          (AlgebraicGeometry.Spec.preimage (ψ ≫ g_X')).hom π₁ ≠ 0 →
          (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom
              (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁) =
            (AlgebraicGeometry.Spec.preimage (ψ ≫ g_X')).hom π₁ * q →
          ∃ (ψ_V : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ V_sm'.toScheme),
            ψ_V ≫ V_sm'.ι = ψ ∧
            (AlgebraicGeometry.Spec.preimage (ψ ≫ g_X')).hom π₁ *
                (AlgebraicGeometry.Spec.preimage (ψ_V ≫ e')).hom Polynomial.X =
              (AlgebraicGeometry.Spec.preimage (ψ ≫ g_X')).hom π₁ * q)) ∧
  (∀ (X : AlgebraicGeometry.Scheme.{u})
      (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (z : X) (W : X.Opens) (hz : z ∈ W) (a : ↥V)
      (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})))
      (s₁ π₁ a' : ↥V),
    IsStrictlySemistableCurveOverValuation V g_X →
    IsClosed ({z} : Set X) →
    (g_X.base z).asIdeal ≠ ⊥ →
    a ≠ 0 →
    AlgebraicGeometry.Etale e →
    W.ι ≫ g_X = e ≫ AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) →
    a = π₁ * a' →
    s₁ ∉ (g_X.base z).asIdeal →
    π₁ ∈ (g_X.base z).asIdeal →
    (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e.base ⟨z, hz⟩).asIdeal) →
    ∃ (X' : AlgebraicGeometry.Scheme.{u})
      (g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_bl : X' ⟶ X)
      (U_iso : X.Opens)
      (V_sm' : X'.Opens)
      (e_sm : V_sm'.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
      IsSingleElementaryBlowupStep V g_X g_X' f_bl ∧
      CategoryTheory.IsIso (f_bl ∣_ U_iso) ∧
      (∀ x : X, (g_X.base x).asIdeal = ⊥ → x ∈ U_iso) ∧
      (∀ (x : X) (V_sm : X.Opens),
        x ∈ V_sm → AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X) → x ∈ U_iso) ∧
      AlgebraicGeometry.Etale e_sm ∧
      V_sm'.ι ≫ g_X' = e_sm ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm'.ι ≫ g_X') ∧
      (∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
          (ψ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ X')
          (mR : AlgebraicGeometry.Spec (CommRingCat.of R))
          (ψ_W : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ W.toScheme)
          (q : R),
        mR.asIdeal = IsLocalRing.maximalIdeal R →
        (ψ ≫ f_bl).base mR = z →
        ψ_W ≫ W.ι = ψ ≫ f_bl →
        IsUnit q →
        (AlgebraicGeometry.Spec.preimage (ψ ≫ g_X')).hom π₁ ≠ 0 →
        (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom
            (Ideal.Quotient.mk _ (MvPolynomial.C s₁ * MvPolynomial.X 0)) =
          (AlgebraicGeometry.Spec.preimage (ψ ≫ g_X')).hom π₁ * q →
        Set.range ψ.base ⊆ (V_sm' : Set X')))
def IsLocalSemistableBlowupModel {K : Type u} [Field K] (V : ValuationSubring K)
    {A_loc : CommRingCat.{u}}
    (g_loc : AlgebraicGeometry.Spec A_loc ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (I_center : Ideal ↑A_loc)
    {M : AlgebraicGeometry.Scheme.{u}}
    (p_M : M ⟶ AlgebraicGeometry.Spec A_loc) : Prop :=
  AlgebraicGeometry.IsProper p_M ∧
  CategoryTheory.IsIso
    (p_M ∣_ ⟨(PrimeSpectrum.zeroLocus (I_center : Set ↑A_loc))ᶜ,
      (PrimeSpectrum.isClosed_zeroLocus (I_center : Set ↑A_loc)).isOpen_compl⟩) ∧
  ∀ y : M,
    (∃ (U : M.Opens)
        (e : U.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
      y ∈ U ∧
      AlgebraicGeometry.Etale e ∧
      U.ι ≫ p_M ≫ g_loc = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∨
    (∃ (U : M.Opens) (b : ↥V)
        (e : U.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}))),
      y ∈ U ∧
      b ≠ 0 ∧
      AlgebraicGeometry.Etale e ∧
      U.ι ≫ p_M ≫ g_loc = e ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))
def IsClosedFiberPolarProjLineMap (k₀ : Type u) [Field k₀]
    {Y : AlgebraicGeometry.Scheme.{u}}
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (r_pts k₁ : ℕ)
    (σ_bar : Fin (r_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Y))
    (π_bar : Y ⟶ (weilProjectiveSpaceOver k₀ 1).left) : Prop :=
  let pt₀ : PrimeSpectrum k₀ := ⊥
  let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀
  letI : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
  let U_Y0 : Y.Opens :=
    (TopologicalSpace.Opens.map π_bar.base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X 0))
  let U_Y1 : Y.Opens :=
    (TopologicalSpace.Opens.map π_bar.base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X 1))
  1 ≤ k₁ ∧
  π_bar ≫ (weilProjectiveSpaceOver k₀ 1).hom = p_Y ∧
  (∀ i : Fin (r_pts + 1), σ_bar i ≫ p_Y = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀))) ∧
  Function.Injective (fun i : Fin (r_pts + 1) => (σ_bar i).base pt₀) ∧
  (∀ i : Fin (r_pts + 1), ∃ V_sm : Y.Opens,
    (σ_bar i).base pt₀ ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Y)) ∧
  (∀ E ∈ irreducibleComponents ↥Y, ∃ i : Fin (r_pts + 1), (σ_bar i).base pt₀ ∈ E) ∧
  AlgebraicGeometry.IsFinite π_bar ∧
  (U_Y0 : Set ↥Y) = (⋃ i : Fin (r_pts + 1), Set.range (σ_bar i).base)ᶜ ∧
  ∃ (W_bar : Fin (r_pts + 1) → Y.Opens)
    (t_bar u_bar : ∀ i : Fin (r_pts + 1), ↑(Y.presheaf.obj (Opposite.op (W_bar i)))),
    ∀ i : Fin (r_pts + 1),
      ∃ (hW_le : W_bar i ≤ U_Y1)
        (hσ_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
          (TopologicalSpace.Opens.map (σ_bar i).base).obj (W_bar i))
        (hX1 : (MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ 1)
        (hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ (1 • 1)),
        AlgebraicGeometry.IsAffineOpen (W_bar i) ∧
        (σ_bar i).base pt₀ ∈ W_bar i ∧
        IsUnit (u_bar i) ∧
        W_bar i ⊓ U_Y0 = Y.basicOpen (t_bar i) ∧
        RingHom.ker (((σ_bar i).appLE (W_bar i) ⊤ hσ_le).hom) = Ideal.span {t_bar i} ∧
        (π_bar.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X 1)) (W_bar i) hW_le).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜₁ (MvPolynomial.X 1)).hom
            (HomogeneousLocalization.Away.mk 𝒜₁ hX1 1 (MvPolynomial.X 0) hX0)) =
          u_bar i * (t_bar i) ^ k₁

def IsLiftedSmoothDivisorSystem {K : Type u} [Field K] (V : ValuationSubring K)
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (r_pts : ℕ)
    (γ_div : Fin (r_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (W_div : Fin (r_pts + 1) → C.Opens)
    (t_div : ∀ i : Fin (r_pts + 1), ↑(C.presheaf.obj (Opposite.op (W_div i)))) : Prop :=
  (∀ i : Fin (r_pts + 1),
    γ_div i ≫ g = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) ∧
    AlgebraicGeometry.IsClosedImmersion (γ_div i) ∧
    AlgebraicGeometry.IsAffineOpen (W_div i) ∧
    t_div i ≠ 0 ∧
    (∃ h_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens) ≤
        (TopologicalSpace.Opens.map (γ_div i).base).obj (W_div i),
      RingHom.ker (((γ_div i).appLE (W_div i) ⊤ h_le).hom) = Ideal.span {t_div i}) ∧
    (C.basicOpen (t_div i) : Set ↥C) = (W_div i : Set ↥C) \ Set.range (γ_div i).base) ∧
  (∀ i j : Fin (r_pts + 1), i ≠ j → Disjoint (W_div i : Set ↥C) (Set.range (γ_div j).base)) ∧
  (∀ (P : PrimeSpectrum ↥V),
    let s_P := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))
    ∀ E_P ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s_P),
      ∃ (i : Fin (r_pts + 1)) (q_P : ↥(CategoryTheory.Limits.pullback g s_P)),
        q_P ∈ E_P ∧
        (CategoryTheory.Limits.pullback.fst g s_P).base q_P ∈ Set.range (γ_div i).base)
def IsUnstableP1HenselianPencil {K : Type u} [Field K] (V : ValuationSubring K)
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁))) : Prop :=
  let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
  let Y := CategoryTheory.Limits.pullback g s₀
  let fstY := CategoryTheory.Limits.pullback.fst g s₀
  let sndY := CategoryTheory.Limits.pullback.snd g s₀
  let Y'_set : Set ↥Y := ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E'
  let Δ : Set ↥Y := Z ∩ Y'_set
  let R₀ := C.presheaf.obj (Opposite.op V₀)
  let R₁ := C.presheaf.obj (Opposite.op V₁)
  letI : Algebra ↥V ↑R₀ := (
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₀ le_top).hom.toAlgebra
  letI : Algebra ↥V ↑R₁ := (
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₁ le_top).hom.toAlgebra
  AlgebraicGeometry.IsAffineOpen V₀ ∧
  AlgebraicGeometry.IsAffineOpen V₁ ∧
  V₀ ⊔ V₁ = ⊤ ∧
  C.basicOpen h₀ = V₀ ⊓ V₁ ∧
  C.basicOpen t₀ = V₀ ⊓ V₁ ∧
  (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom h₀ *
    (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom t₀ = 1 ∧
  (Polynomial.aeval (R := ↥V) h₀).toRingHom.Finite ∧
  (Polynomial.aeval (R := ↥V) t₀).toRingHom.Finite ∧
  (∀ r : ℕ, 1 ≤ r →
    Module.Free ↥V (↑R₀ ⧸ Ideal.span ({h₀ ^ r} : Set ↑R₀)) ∧
    Module.Finite ↥V (↑R₀ ⧸ Ideal.span ({h₀ ^ r} : Set ↑R₀)) ∧
    Nontrivial (↑R₀ ⧸ Ideal.span ({h₀ ^ r} : Set ↑R₀))) ∧
  (∀ r : ℕ, 1 ≤ r →
    Module.Free ↥V (↑R₁ ⧸ Ideal.span ({t₀ ^ r} : Set ↑R₁)) ∧
    Module.Finite ↥V (↑R₁ ⧸ Ideal.span ({t₀ ^ r} : Set ↑R₁)) ∧
    Nontrivial (↑R₁ ⧸ Ideal.span ({t₀ ^ r} : Set ↑R₁))) ∧
  (∀ Q : Polynomial ↥V, Q.Monic →
    Module.Free ↥V (↑R₁ ⧸ Ideal.span ({Polynomial.aeval t₀ Q} : Set ↑R₁)) ∧
    Module.Finite ↥V (↑R₁ ⧸ Ideal.span ({Polynomial.aeval t₀ Q} : Set ↑R₁))) ∧
  eZ + eY = 1 ∧
  eZ * eY ∈ Ideal.span ({h₀} : Set ↑R₀) ∧
  Module.Free ↥V (↑R₀ ⧸ Ideal.span ({h₀, eY} : Set ↑R₀)) ∧
  Module.Finite ↥V (↑R₀ ⧸ Ideal.span ({h₀, eY} : Set ↑R₀)) ∧
  Nontrivial (↑R₀ ⧸ Ideal.span ({h₀, eY} : Set ↑R₀)) ∧
  Module.Free ↥V (↑R₀ ⧸ Ideal.span ({h₀, eZ} : Set ↑R₀)) ∧
  Module.Finite ↥V (↑R₀ ⧸ Ideal.span ({h₀, eZ} : Set ↑R₀)) ∧
  Nontrivial (↑R₀ ⧸ Ideal.span ({h₀, eZ} : Set ↑R₀)) ∧
  (∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
    (τ j).base b ∈ V₀ ∧ (τ j).base b ∈ V₁) ∧
  (∀ q ∈ Δ, fstY.base q ∈ V₁) ∧
  (∀ x : ↥V₀, x.1 ∉ (C.basicOpen h₀ : Set C) →
    ∃ V_sm : C.Opens, x.1 ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g)) ∧
  (∀ (K' : Type u) [Field K'] [IsAlgClosed K']
      (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (E : Set ↥(CategoryTheory.Limits.pullback g s)),
    E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s) →
    (((CategoryTheory.Limits.pullback.fst g s).base ⁻¹' ((V₀ ⊓ V₁ : C.Opens) : Set C)) ∩ E).Nonempty) ∧
  (irreducibleComponents ↥Y).Finite ∧
  AlgebraicGeometry.IsReduced Y ∧
  Z ⊆ fstY.base ⁻¹' ((V₁ ⊔ C.basicOpen eZ : C.Opens) : Set C) ∧
  Y'_set ⊆ fstY.base ⁻¹' ((V₁ ⊔ C.basicOpen eY : C.Opens) : Set C) ∧
  (∀ E' ∈ (irreducibleComponents ↥Y) \ {Z}, (E' \ fstY.base ⁻¹' (V₁ : Set C)).Nonempty) ∧
  (∃ (Y'_sch : AlgebraicGeometry.Scheme.{u}) (ιY' : Y'_sch ⟶ Y),
    AlgebraicGeometry.IsClosedImmersion ιY' ∧
    AlgebraicGeometry.IsReduced Y'_sch ∧
    Set.range ιY'.base = Y'_set ∧
    (∀ q : ↥Y'_sch, ιY'.base q ∈ Δ →
      ∃ V_sm : Y'_sch.Opens,
        q ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ ιY' ≫ sndY)) ∧
    let V₀_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₀
    let V₁_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₁
    ∃ (u₁_V₁ : ↑(Y.presheaf.obj (Opposite.op V₁_Y)))
      (u₁_V₀ : ↑(Y.presheaf.obj (Opposite.op V₀_Y))),
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op).hom
          ((fstY.appLE V₀ V₀_Y le_rfl).hom (h₀ ^ 2)) *
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀_Y ⊓ V₁_Y ≤ V₁_Y)).op).hom u₁_V₁ =
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op).hom u₁_V₀ ∧
      (∀ q ∈ Δ, q ∉ (Y.basicOpen u₁_V₁ : Set Y)) ∧
      Y'_set \ (V₁_Y : Set Y) ⊆ (Y.basicOpen u₁_V₀ : Set Y) ∧
      AlgebraicGeometry.IsAffineOpen
        ((TopologicalSpace.Opens.map ιY'.base).obj (Y.basicOpen u₁_V₁ ⊔ Y.basicOpen u₁_V₀)))

def IsUnstableP1ContractionProjMap {K : Type u} [Field K] (V : ValuationSubring K)
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (V₀ V₁ : C.Opens)
    (eZ : ↑(C.presheaf.obj (Opposite.op V₀)))
    (N' : ℕ)
    (φ : C ⟶ (weilProjectiveSpaceOver ↥V N').left) : Prop :=
  let P_next := weilProjectiveSpaceOver ↥V N'
  let C_next := AlgebraicGeometry.Scheme.Hom.image φ
  let ιP_next := AlgebraicGeometry.Scheme.Hom.imageι φ
  let q_img := AlgebraicGeometry.Scheme.Hom.toImage φ
  let g_next := ιP_next ≫ P_next.hom
  let W_compl : C.Opens := V₁ ⊔ C.basicOpen eZ
  let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
  φ ≫ P_next.hom = g ∧
  ∃ (U_next₀ : C_next.Opens) (f₁ : ↑(C.presheaf.obj (Opposite.op W_compl))),
    AlgebraicGeometry.IsAffineOpen U_next₀ ∧
    (TopologicalSpace.Opens.map q_img.base).obj U_next₀ = W_compl ∧
    (∀ (F' : Type u) [Field F']
        (s : AlgebraicGeometry.Spec (CommRingCat.of F') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (q_s : CategoryTheory.Limits.pullback g s ⟶ CategoryTheory.Limits.pullback g_next s),
      q_s ≫ CategoryTheory.Limits.pullback.fst g_next s = CategoryTheory.Limits.pullback.fst g s ≫ q_img →
      q_s ≫ CategoryTheory.Limits.pullback.snd g_next s = CategoryTheory.Limits.pullback.snd g s →
      let X_s := CategoryTheory.Limits.pullback g s
      let X_next_s := CategoryTheory.Limits.pullback g_next s
      let U₀_s : X_next_s.Opens :=
        (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g_next s).base).obj U_next₀
      let W₀_s : X_s.Opens :=
        (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g s).base).obj W_compl
      let f₁_s : ↑(X_s.presheaf.obj (Opposite.op W₀_s)) :=
        ((CategoryTheory.Limits.pullback.fst g s).appLE W_compl W₀_s le_rfl).hom f₁
      letI : Algebra F' ↑(X_s.presheaf.obj (Opposite.op W₀_s)) := (
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F')).inv ≫
          AlgebraicGeometry.Scheme.Hom.appLE (CategoryTheory.Limits.pullback.snd g s) ⊤ W₀_s le_top).hom.toAlgebra
      AlgebraicGeometry.IsAffineOpen U₀_s ∧
      ∃ (heq₀ : W₀_s ≤ (TopologicalSpace.Opens.map q_s.base).obj U₀_s),
        (TopologicalSpace.Opens.map q_s.base).obj U₀_s = W₀_s ∧
        Function.Bijective (q_s.appLE U₀_s W₀_s heq₀).hom ∧
        (∀ c₁ : F',
          ∃ U₁_c : X_next_s.Opens,
            AlgebraicGeometry.IsAffineOpen U₁_c ∧
            U₀_s ⊔ U₁_c = ⊤ ∧
            let W₁_c : X_s.Opens := (TopologicalSpace.Opens.map q_s.base).obj U₁_c
            W₀_s ⊓ W₁_c = X_s.basicOpen (f₁_s - algebraMap F' _ c₁) ∧
            Function.Bijective (q_s.appLE U₁_c W₁_c le_rfl).hom)) ∧
    (∀ z ∈ Z,
      z ∉ (CategoryTheory.Limits.pullback g s₀).basicOpen
        (((CategoryTheory.Limits.pullback.fst g s₀).appLE W_compl
          ((TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g s₀).base).obj W_compl)
          le_rfl).hom f₁))
def IsFiberRelExceptionalP1 {K : Type u} [Field K] (V : ValuationSubring K)
    {C' C_cur : AlgebraicGeometry.Scheme.{u}}
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (n : ℕ) (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (U' : C'.Opens)
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom_cur : C_cur ⟶ U'.toScheme)
    (τ_cur : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C_cur)
    (Q : PrimeSpectrum ↥V)
    (x_Q : ↥U'.toScheme)
    (E_Q : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V Q.asIdeal.ResidueField))))) : Prop :=
  let s_Q := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap ↥V Q.asIdeal.ResidueField))
  let Y_Q := CategoryTheory.Limits.pullback g_cur s_Q
  let Δ_EQ : Set ↥Y_Q :=
    {q ∈ E_Q | ∃ E' ∈ irreducibleComponents ↥Y_Q, E' ≠ E_Q ∧ q ∈ E'}
  let M_EQ : Set (Fin n) :=
    {j : Fin n | ∃ q ∈ E_Q,
      (CategoryTheory.Limits.pullback.fst g_cur s_Q).base q ∈ Set.range (τ_cur j).base}
  Q.asIdeal ≠ ⊥ ∧
  (U'.ι ≫ g').base x_Q = Q ∧
  E_Q ∈ irreducibleComponents ↥Y_Q ∧
  (∃ (E_sch : AlgebraicGeometry.Scheme.{u}) (ιE : E_sch ⟶ Y_Q)
      (isoP1 : E_sch ≅ (weilProjectiveSpaceOver Q.asIdeal.ResidueField 1).left),
    AlgebraicGeometry.IsClosedImmersion ιE ∧
    AlgebraicGeometry.IsIntegral E_sch ∧
    Set.range ιE.base = E_Q ∧
    ιE ≫ CategoryTheory.Limits.pullback.snd g_cur s_Q =
      isoP1.hom ≫ (weilProjectiveSpaceOver Q.asIdeal.ResidueField 1).hom) ∧
  (∀ q ∈ E_Q,
    f_dom_cur.base ((CategoryTheory.Limits.pullback.fst g_cur s_Q).base q) = x_Q) ∧
  Δ_EQ.Finite ∧
  Δ_EQ.ncard + M_EQ.ncard ≤ 2
def HasLocalP1BranchWitness {R_z : Type u} [CommRing R_z]
    {A_loc : CommRingCat.{u}} (φ_Rz : CommRingCat.of R_z ⟶ A_loc)
    (I_center : Ideal ↑A_loc)
    {M : AlgebraicGeometry.Scheme.{u}} (p_M : M ⟶ AlgebraicGeometry.Spec A_loc)
    {κ : Type u} [Field κ] (ρ_P : R_z →+* κ) (ε_A : ↑A_loc →+* κ)
    (γ_M : (weilProjectiveSpaceOver κ 1).left ⟶ M)
    (s_e : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ (weilProjectiveSpaceOver κ 1).left) :
    Prop :=
  s_e ≫ (weilProjectiveSpaceOver κ 1).hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) ∧
  ∃ (d_br : ↑A_loc)
    (τ_br : ↑A_loc →+* Polynomial κ)
    (σ_br : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial κ)) ⟶ M),
    d_br ∈ I_center ∧
    τ_br.comp φ_Rz.hom = Polynomial.C.comp ρ_P ∧
    τ_br d_br = Polynomial.X ∧
    (Polynomial.evalRingHom 0).comp τ_br = ε_A ∧
    (∀ (D : Type u) [CommRing D] (ι_κ : κ →+* D) (φ_D : ↑A_loc →+* D),
      φ_D.comp φ_Rz.hom = ι_κ.comp ρ_P →
      RingHom.ker τ_br ≤ RingHom.ker φ_D →
      (Polynomial.eval₂RingHom ι_κ (φ_D d_br)).comp τ_br = φ_D) ∧
    σ_br ≫ p_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_br) ∧
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0)) ≫ σ_br =
      s_e ≫ γ_M

def IsLocalOverlapBlowupModel {K : Type u} [Field K] (V : ValuationSubring K)
    (P_z : Ideal ↥V) [P_z.IsPrime] (π₁ : ↥V)
    {R_z : Type u} [CommRing R_z] [Algebra ↥V R_z]
    {A_loc : CommRingCat.{u}} (φ_Rz : CommRingCat.of R_z ⟶ A_loc)
    (I_sec : Ideal ↑A_loc) (isNodalMode : Bool)
    {M : AlgebraicGeometry.Scheme.{u}} (p_M : M ⟶ AlgebraicGeometry.Spec A_loc) : Prop :=
  let g_loc : AlgebraicGeometry.Spec A_loc ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz)
  let I_center : Ideal ↑A_loc := I_sec ⊔ Ideal.span {φ_Rz.hom (algebraMap ↥V R_z π₁)}
  AlgebraicGeometry.IsProper p_M ∧
  CategoryTheory.IsIso
    (p_M ∣_ ⟨(PrimeSpectrum.zeroLocus (I_center : Set ↑A_loc))ᶜ,
      (PrimeSpectrum.isClosed_zeroLocus (I_center : Set ↑A_loc)).isOpen_compl⟩) ∧
  (∀ y : M,
    (∃ (U : M.Opens)
        (e_U : U.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
      y ∈ U ∧
      AlgebraicGeometry.Etale e_U ∧
      U.ι ≫ p_M ≫ g_loc = e_U ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∨
    (∃ (U : M.Opens) (b : ↥V)
        (e_U : U.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}))),
      y ∈ U ∧
      b ≠ 0 ∧
      AlgebraicGeometry.Etale e_U ∧
      U.ι ≫ p_M ≫ g_loc = e_U ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))) ∧
  (∀ (P : Ideal ↥V) [P.IsPrime],
    P ≤ P_z →
    π₁ ∈ P →
    ∀ (ρ_P : R_z →+* P.ResidueField),
      ρ_P.comp (algebraMap ↥V R_z) = algebraMap ↥V P.ResidueField →
      (∃ u_iso_P : ↑A_loc,
        (∀ q : ↥(AlgebraicGeometry.Spec A_loc),
          (g_loc.base q).asIdeal = P → u_iso_P ∉ q.asIdeal) ∧
        CategoryTheory.IsIso (p_M ∣_ PrimeSpectrum.basicOpen u_iso_P)) ∨
      (∃ (ε_A : ↑A_loc →+* P.ResidueField)
         (γ_M : (weilProjectiveSpaceOver P.ResidueField 1).left ⟶ M)
         (U_pure : M.Opens),
        ε_A.comp φ_Rz.hom = ρ_P ∧
        I_center ≤ RingHom.ker ε_A ∧
        CategoryTheory.IsPullback γ_M (weilProjectiveSpaceOver P.ResidueField 1).hom
          p_M (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_A)) ∧
        (∀ m : M, m ∈ U_pure → ((p_M ≫ g_loc).base m).asIdeal = P →
          I_center ≤ (p_M.base m).asIdeal) ∧
        Nonempty ↥((TopologicalSpace.Opens.map γ_M.base).obj U_pure) ∧
        ((isNodalMode = false ∧
          ∃ (s_e1 : AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField) ⟶
              (weilProjectiveSpaceOver P.ResidueField 1).left),
            HasLocalP1BranchWitness φ_Rz I_center p_M ρ_P ε_A γ_M s_e1 ∧
            ∀ e : ↥(weilProjectiveSpaceOver P.ResidueField 1).left,
              γ_M.base e ∉ U_pure ↔ e ∈ Set.range s_e1.base) ∨
         (isNodalMode = true ∧
          ∃ (s_e1 s_e2 : AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField) ⟶
              (weilProjectiveSpaceOver P.ResidueField 1).left),
            HasLocalP1BranchWitness φ_Rz I_center p_M ρ_P ε_A γ_M s_e1 ∧
            HasLocalP1BranchWitness φ_Rz I_center p_M ρ_P ε_A γ_M s_e2 ∧
            Disjoint (Set.range s_e1.base) (Set.range s_e2.base) ∧
            ∀ e : ↥(weilProjectiveSpaceOver P.ResidueField 1).left,
              γ_M.base e ∉ U_pure ↔
                e ∈ Set.range s_e1.base ∪ Set.range s_e2.base))))
def HasStrictlySemistableResidueFiberGeom {K : Type u} [Field K]
    (V : ValuationSubring K) (P : Ideal ↥V) [P.IsPrime] : Prop :=
  let s_P : AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))
  ∀ (W : AlgebraicGeometry.Scheme.{u})
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
    IsStrictlySemistableCurveOverValuation V g_W →
    CompactSpace ↥W →
    let F_W := CategoryTheory.Limits.pullback g_W s_P
    let fst_W := CategoryTheory.Limits.pullback.fst g_W s_P
    let snd_W := CategoryTheory.Limits.pullback.snd g_W s_P
    AlgebraicGeometry.IsPreimmersion fst_W ∧
    Set.range fst_W.base = {z : W | (g_W.base z).asIdeal = P} ∧
    TopologicalSpace.NoetherianSpace ↥F_W ∧
    (irreducibleComponents ↥F_W).Finite ∧
    AlgebraicGeometry.IsReduced F_W ∧
    (∀ w : ↥F_W,
      (∃ V_sm : W.Opens,
        fst_W.base w ∈ V_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_W)) ↔
      (∃ U_sm : F_W.Opens,
        w ∈ U_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_sm.ι ≫ snd_W))) ∧
    (∀ (w : ↥F_W) (U_sm : F_W.Opens),
      w ∈ U_sm →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_sm.ι ≫ snd_W) →
      ∀ H₁ ∈ irreducibleComponents ↥F_W, ∀ H₂ ∈ irreducibleComponents ↥F_W,
        w ∈ H₁ → w ∈ H₂ → H₁ = H₂) ∧
    (∀ (w : ↥F_W) (H₁ H₂ H₃ : Set ↥F_W),
      H₁ ∈ irreducibleComponents ↥F_W →
      H₂ ∈ irreducibleComponents ↥F_W →
      H₃ ∈ irreducibleComponents ↥F_W →
      w ∈ H₁ → w ∈ H₂ → w ∈ H₃ →
      H₁ = H₂ ∨ H₁ = H₃ ∨ H₂ = H₃) ∧
    (∀ (w : ↥F_W) (H₁ H₂ : Set ↥F_W),
      H₁ ∈ irreducibleComponents ↥F_W →
      H₂ ∈ irreducibleComponents ↥F_W →
      H₁ ≠ H₂ → w ∈ H₁ → w ∈ H₂ →
      IsClosed ({w} : Set ↥F_W)) ∧
    (∀ Z : Set ↥F_W,
      IsClosed Z → IsIrreducible Z →
      (∃ u₁ u₂ : ↥F_W, u₁ ≠ u₂ ∧ u₁ ∈ Z ∧ u₂ ∈ Z) →
      Z ∈ irreducibleComponents ↥F_W) ∧
    (∀ H ∈ irreducibleComponents ↥F_W,
      (∃ u₁ u₂ : ↥F_W, u₁ ≠ u₂ ∧ u₁ ∈ H ∧ u₂ ∈ H) ∧
      (∀ Z : Set ↥F_W, IsClosed Z → Z ⊆ H → Z ≠ H → Z.Finite) ∧
      (∃ (H_sch : AlgebraicGeometry.Scheme.{u}) (ιH : H_sch ⟶ F_W),
        AlgebraicGeometry.IsClosedImmersion ιH ∧
        AlgebraicGeometry.IsIntegral H_sch ∧
        Set.range ιH.base = H ∧
        IsOverlapAffineNormalScheme H_sch) ∧
      (∀ (E_sch : AlgebraicGeometry.Scheme.{u}) (φ : E_sch ⟶ F_W) (U₀ : F_W.Opens),
        AlgebraicGeometry.IsIntegral E_sch →
        AlgebraicGeometry.IsProper φ →
        Set.range φ.base = H →
        (H ∩ (U₀ : Set ↥F_W)).Nonempty →
        (φ.base ⁻¹' ((U₀ : Set ↥F_W)ᶜ)).Finite →
        AlgebraicGeometry.IsClosedImmersion (φ ∣_ U₀) →
        AlgebraicGeometry.IsClosedImmersion φ ∧ Function.Injective φ.base))
def IsValDiscLE (R : Type u) [CommRing R] (c₁ π₁ c₂ π₂ : R) : Prop :=
  (∃ r : R, π₁ = r * π₂) ∧ (∃ r : R, c₁ - c₂ = r * π₂)

def IsValDiscEq (R : Type u) [CommRing R] (c₁ π₁ c₂ π₂ : R) : Prop :=
  IsValDiscLE R c₁ π₁ c₂ π₂ ∧ IsValDiscLE R c₂ π₂ c₁ π₁

def IsDiscBoundaryIdx (R : Type u) [CommRing R] (a_opt : Option R)
    (c_d π_d : R) : Prop :=
  IsValDiscEq R c_d π_d 0 1 ∨ ∃ a₀ : R, a_opt = some a₀ ∧ IsValDiscEq R c_d π_d 0 a₀

def IsJoinClosedDiscTree (R : Type u) [CommRing R] [IsLocalRing R]
    (a_opt : Option R) {N : ℕ} (c π : Fin N → R) : Prop :=
  (∀ i : Fin N, π i ≠ 0) ∧
  (∀ i j : Fin N, IsValDiscEq R (c i) (π i) (c j) (π j) → i = j) ∧
  (∃ i_top : Fin N, c i_top = 0 ∧ π i_top = 1) ∧
  (∀ a₀ : R, a_opt = some a₀ →
    a₀ ≠ 0 ∧ a₀ ∈ IsLocalRing.maximalIdeal R ∧
    (∃ i_bot : Fin N, c i_bot = 0 ∧ π i_bot = a₀) ∧
    (∀ i : Fin N, IsValDiscLE R (c i) (π i) 0 a₀ → IsValDiscEq R (c i) (π i) 0 a₀)) ∧
  (∀ i : Fin N, ¬ IsValDiscEq R (c i) (π i) 0 1 →
    c i ∈ IsLocalRing.maximalIdeal R ∧ π i ∈ IsLocalRing.maximalIdeal R) ∧
  (∀ i j : Fin N, ∃ k : Fin N,
    IsValDiscLE R (c i) (π i) (c k) (π k) ∧
    IsValDiscLE R (c j) (π j) (c k) (π k) ∧
    ∀ (c' π' : R), π' ≠ 0 →
      IsValDiscLE R (c i) (π i) c' π' →
      IsValDiscLE R (c j) (π j) c' π' →
      IsValDiscLE R (c k) (π k) c' π')

def IsDiscHasseCover (R : Type u) [CommRing R] {N : ℕ} (c π : Fin N → R)
    (i_par i_ch : Fin N) : Prop :=
  i_par ≠ i_ch ∧
  IsValDiscLE R (c i_ch) (π i_ch) (c i_par) (π i_par) ∧
  ∀ k : Fin N,
    IsValDiscLE R (c i_ch) (π i_ch) (c k) (π k) →
    IsValDiscLE R (c k) (π k) (c i_par) (π i_par) →
    k = i_ch ∨ k = i_par

def IsStandardModelCoordDatum {K : Type u} [Field K] (R : ValuationSubring K)
    (a_opt : Option ↥R)
    (M_0 : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0)
    {F_0 : Type u} [Field F_0]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (φ_KF0 : K →+* F_0)
    (T_0 : F_0) : Prop :=
  IsSchemeFunctionField M_0 F_0 η_M0 ∧
  η_M0 ≫ g_M0 =
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF0.comp R.subtype)) ∧
  ((a_opt = none ∧
    ∃ (iso : M_0 ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥R)))
      (φ_top : CommRingCat.of (Polynomial ↥R) ⟶ CommRingCat.of F_0),
      iso.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) = g_M0 ∧
      Polynomial.X ∈ (iso.hom.base m_0).asIdeal ∧
      (∀ r ∈ IsLocalRing.maximalIdeal ↥R, Polynomial.C r ∈ (iso.hom.base m_0).asIdeal) ∧
      AlgebraicGeometry.Spec.map φ_top ≫ iso.inv = η_M0 ∧
      φ_top.hom Polynomial.X = T_0) ∨
   (∃ (a₀ : ↥R)
      (iso : M_0 ≅ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) ↥R ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀})))
      (φ_top : CommRingCat.of
        (MvPolynomial (Fin 2) ↥R ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}) ⟶ CommRingCat.of F_0),
      a_opt = some a₀ ∧
      a₀ ≠ 0 ∧
      a₀ ∈ IsLocalRing.maximalIdeal ↥R ∧
      iso.hom ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = g_M0 ∧
      (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (iso.hom.base m_0).asIdeal) ∧
      (∀ r ∈ IsLocalRing.maximalIdeal ↥R,
        Ideal.Quotient.mk _ (MvPolynomial.C r) ∈ (iso.hom.base m_0).asIdeal) ∧
      AlgebraicGeometry.Spec.map φ_top ≫ iso.inv = η_M0 ∧
      φ_top.hom (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = T_0))

def IsDiscValuationOnWB {K : Type u} [Field K] (R : ValuationSubring K)
    {W_B_sch : AlgebraicGeometry.Scheme.{u}}
    (u₀_WB : ↥W_B_sch)
    {F_WB : Type u} [Field F_WB]
    (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ W_B_sch)
    (φ_KF : K →+* F_WB)
    (T_WB : F_WB) (c_d π_d : ↥R)
    (W : ValuationSubring F_WB) : Prop :=
  ∃ (ψ_WB : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ W_B_sch)
    (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W))
    (hR : ∀ r : ↥R, φ_KF (R.subtype r) ∈ W)
    (w : ↥W),
    mW.asIdeal = IsLocalRing.maximalIdeal ↥W ∧
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_WB = η_WB ∧
    ψ_WB.base mW = u₀_WB ∧
    (∀ r : ↥R, (⟨φ_KF (R.subtype r), hR r⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔
      r ∈ IsLocalRing.maximalIdeal ↥R) ∧
    φ_KF (R.subtype π_d) * W.subtype w = T_WB - φ_KF (R.subtype c_d) ∧
    ∀ (Q : Polynomial ↥R),
      (∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal ↥R) →
      Polynomial.eval₂ ((φ_KF.comp R.subtype).codRestrict W.toSubring hR) w Q ∉
        IsLocalRing.maximalIdeal ↥W

def IsComponentStalkVal {K : Type u} [Field K] (R : ValuationSubring K)
    {Y : AlgebraicGeometry.Scheme.{u}}
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    {F : Type u} [Field F]
    (η_Y : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y)
    (E : Set ↥(CategoryTheory.Limits.pullback g_Y
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))))
    (W : ValuationSubring F) : Prop :=
  let s_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
    (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
  ∃ (ψ_Y : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Y)
    (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
    mW.asIdeal = IsLocalRing.maximalIdeal ↥W ∧
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_Y = η_Y ∧
    (CategoryTheory.Limits.pullback.fst g_Y s_R).base '' E =
      closure ({ψ_Y.base mW} : Set ↥Y)

def IsBaseDiscTreeModel {K : Type u} [Field K] (R : ValuationSubring K)
    (a_opt : Option ↥R)
    {M_0 : AlgebraicGeometry.Scheme.{u}}
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0)
    {F_0 : Type u} [Field F_0]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (φ_KF0 : K →+* F_0) (T_0 : F_0)
    {N : ℕ} (c π : Fin N → ↥R)
    (M_T : AlgebraicGeometry.Scheme.{u})
    (g_MT : M_T ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f_MT : M_T ⟶ M_0)
    (η_MT : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_T)
    (Z_MT : Set ↥M_0)
    (B_comp : Fin N → Set ↥(CategoryTheory.Limits.pullback g_MT
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))))) : Prop :=
  let s_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
    (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
  let Y_MT := CategoryTheory.Limits.pullback g_MT s_R
  IsStrictlySemistableCurveOverValuation R g_MT ∧
  AlgebraicGeometry.IsProper f_MT ∧
  f_MT ≫ g_M0 = g_MT ∧
  η_MT ≫ f_MT = η_M0 ∧
  ∃ (hZ_cl : IsClosed Z_MT),
    CategoryTheory.IsIso (f_MT ∣_ (⟨Z_MTᶜ, hZ_cl.isOpen_compl⟩ : M_0.Opens)) ∧
    (∀ y ∈ Z_MT, (g_M0.base y).asIdeal ≠ ⊥ ∧ m_0 ∈ closure ({y} : Set ↥M_0) ∧
      ∃ i : Fin N, ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) ∧
        π i ∈ (g_M0.base y).asIdeal ∧
        ∃ (W_0 : ValuationSubring F_0) (ψ_M0 : AlgebraicGeometry.Spec (CommRingCat.of ↥W_0) ⟶ M_0)
          (pW0 : AlgebraicGeometry.Spec (CommRingCat.of ↥W_0)),
          IsDiscValuationOnWB R m_0 η_M0 φ_KF0 T_0 (c i) (π i) W_0 ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_0.subtype) ≫ ψ_M0 = η_M0 ∧
          ψ_M0.base pW0 = y) ∧
    Function.Injective B_comp ∧
    (∀ i : Fin N, B_comp i ∈ irreducibleComponents ↥Y_MT) ∧
    (∀ i : Fin N, ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) →
      (∀ q ∈ B_comp i, f_MT.base ((CategoryTheory.Limits.pullback.fst g_MT s_R).base q) = m_0) ∧
      ∃ W_0 : ValuationSubring F_0,
        IsComponentStalkVal R g_MT η_MT (B_comp i) W_0 ∧
        IsDiscValuationOnWB R m_0 η_M0 φ_KF0 T_0 (c i) (π i) W_0) ∧
    (∀ i : Fin N, IsDiscBoundaryIdx ↥R a_opt (c i) (π i) →
      ∃ q ∈ B_comp i, f_MT.base ((CategoryTheory.Limits.pullback.fst g_MT s_R).base q) ≠ m_0) ∧
    (∀ E ∈ irreducibleComponents ↥Y_MT,
      (∀ q ∈ E, f_MT.base ((CategoryTheory.Limits.pullback.fst g_MT s_R).base q) = m_0) →
      ∃ i : Fin N, ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) ∧ E = B_comp i) ∧
    (∀ (i j : Fin N),
      IsDiscHasseCover ↥R c π i j →
      ∃! q : ↥Y_MT, q ∈ B_comp i ∧ q ∈ B_comp j) ∧
    (∀ (i j₁ j₂ : Fin N),
      ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) → j₁ ≠ i → j₂ ≠ i →
      ∀ q : ↥Y_MT, q ∈ B_comp i → q ∈ B_comp j₁ → q ∈ B_comp j₂ → j₁ = j₂) ∧
    (∀ (i : Fin N), ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) →
      ∀ (q : ↥Y_MT) (E' : Set ↥Y_MT),
        q ∈ B_comp i → E' ∈ irreducibleComponents ↥Y_MT → E' ≠ B_comp i → q ∈ E' →
        ∃ j : Fin N, (IsDiscHasseCover ↥R c π i j ∨ IsDiscHasseCover ↥R c π j i) ∧
          E' = B_comp j ∧
          ∃ (U_nod : M_T.Opens) (a_n : ↥R)
            (e_n : U_nod.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) ↥R ⧸ Ideal.span
                {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_n}))),
            a_n ≠ 0 ∧ a_n ∈ IsLocalRing.maximalIdeal ↥R ∧
            AlgebraicGeometry.Etale e_n ∧
            U_nod.ι ≫ g_MT = e_n ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
            ∃ hq : (CategoryTheory.Limits.pullback.fst g_MT s_R).base q ∈ U_nod,
              (∀ b : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X b) ∈
                (e_n.base ⟨_, hq⟩).asIdeal) ∧
              ∃ b₀ : Fin 2, ∀ x : ↥U_nod,
                (g_MT.base x.1).asIdeal = IsLocalRing.maximalIdeal ↥R →
                (x.1 ∈ (CategoryTheory.Limits.pullback.fst g_MT s_R).base '' E' ↔
                  Ideal.Quotient.mk _ (MvPolynomial.X b₀) ∈ (e_n.base x).asIdeal))

def IsBaseOneStepContractionModel {K : Type u} [Field K] (R : ValuationSubring K)
    {M_0 : AlgebraicGeometry.Scheme.{u}}
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0)
    (isLeaf : Prop)
    (M_tilde M' : AlgebraicGeometry.Scheme.{u})
    (g_tilde : M_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f'_M : M' ⟶ M_0)
    (q_M : M_tilde ⟶ M')
    (Mod_qM : Set ↥M')
    (z_new_M : ↥M')
    (Q₀_R : PrimeSpectrum ↥R)
    (z₀_M : ↥M')
    (E_Z_M : Set ↥M_tilde) : Prop :=
  IsStrictlySemistableCurveOverValuation R g_tilde ∧
  IsStrictlySemistableCurveOverValuation R g'_M ∧
  f'_M ≫ g_M0 = g'_M ∧
  (q_M ≫ f'_M) ≫ g_M0 = g_tilde ∧
  AlgebraicGeometry.IsProper q_M ∧
  AlgebraicGeometry.IsProper f'_M ∧
  AlgebraicGeometry.Surjective q_M ∧
  (∃ (hMod_cl : IsClosed Mod_qM),
    CategoryTheory.IsIso (q_M ∣_ (⟨Mod_qMᶜ, hMod_cl.isOpen_compl⟩ : M'.Opens))) ∧
  (isLeaf → ∀ z ∈ Mod_qM, ∃ V_sm : M'.Opens,
    z ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g'_M)) ∧
  Q₀_R.asIdeal ≠ ⊥ ∧
  z_new_M ∈ Mod_qM ∧
  z₀_M ∈ Mod_qM ∧
  f'_M.base z_new_M = m_0 ∧
  (g'_M.base z_new_M).asIdeal = IsLocalRing.maximalIdeal ↥R ∧
  g'_M.base z₀_M = Q₀_R ∧
  (∃ (σ_Mod : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶ M')
     (τ₀ τ₁ : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶ M_tilde),
    AlgebraicGeometry.IsClosedImmersion σ_Mod ∧
    σ_Mod ≫ g'_M =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk Q₀_R.asIdeal)) ∧
    Set.range σ_Mod.base = Mod_qM ∧
    τ₀ ≫ q_M = σ_Mod ∧
    τ₁ ≫ q_M = σ_Mod ∧
    Disjoint (Set.range τ₀.base) (Set.range τ₁.base)) ∧
  IsIrreducible (q_M.base ⁻¹' {z₀_M}) ∧
  q_M.base ⁻¹' Mod_qM = closure (q_M.base ⁻¹' {z₀_M}) ∧
  q_M.base ⁻¹' {z_new_M} = E_Z_M
def IsSegreTwoChartCurveDomination {K : Type u} [Field K] (V : ValuationSubring K)
    {C_semi : AlgebraicGeometry.Scheme.{u}}
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (η_semi : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_semi)
    (C_tilde : AlgebraicGeometry.Scheme.{u})
    (g_tilde : C_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (q : C_tilde ⟶ C_semi)
    (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_tilde)
    (U_dom : C_semi.Opens)
    (b : ℕ) (K_bad : Fin b → Set ↥C_semi) (y_bad : Fin b → ↥C_semi)
    (V_tilde₀ V_tilde₁ : C_tilde.Opens)
    (T₀ : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀)))
    (S₁ : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₁))) : Prop :=
  Function.Injective φ_VF ∧
  η_semi ≫ g_semi = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_VF) ∧
  η_tilde ≫ q = η_semi ∧
  AlgebraicGeometry.IsIntegral C_tilde ∧
  AlgebraicGeometry.IsProper g_tilde ∧
  AlgebraicGeometry.LocallyOfFinitePresentation g_tilde ∧
  AlgebraicGeometry.IsProper q ∧
  q ≫ g_semi = g_tilde ∧
  (∀ U : C_semi.Opens, Function.Bijective (q.app U).hom) ∧
  (∀ (W_aff : C_semi.Opens) (hAff : AlgebraicGeometry.IsAffineOpen W_aff),
    Nonempty ↥W_aff →
    ∃ ψ : ↑(C_semi.presheaf.obj (Opposite.op W_aff)) →+* F,
      Function.Injective ψ ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ hAff.fromSpec = η_semi) ∧
  (∀ (W_aff : C_tilde.Opens) (hAff : AlgebraicGeometry.IsAffineOpen W_aff),
    Nonempty ↥W_aff →
    ∃ ψ : ↑(C_tilde.presheaf.obj (Opposite.op W_aff)) →+* F,
      Function.Injective ψ ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ hAff.fromSpec = η_tilde) ∧
  CategoryTheory.IsIso (q ∣_ U_dom) ∧
  (U_dom : Set ↥C_semi)ᶜ = (⋃ ν : Fin b, K_bad ν) ∧
  (∀ ν : Fin b, IsClosed (K_bad ν) ∧ y_bad ν ∈ K_bad ν ∧
    (g_semi.base (y_bad ν)).asIdeal = IsLocalRing.maximalIdeal ↥V) ∧
  (∀ ν ν' : Fin b, ν ≠ ν' → Disjoint (K_bad ν) (K_bad ν')) ∧
  (∀ ν : Fin b,
    ∃ (r_ν : ℕ) (P_ν : Fin r_ν → Ideal ↥V) (_ : ∀ j, (P_ν j).IsPrime)
      (σ_ν : ∀ j : Fin r_ν, AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ P_ν j)) ⟶ C_semi),
      (∀ j : Fin r_ν,
        P_ν j ≠ ⊥ ∧
        σ_ν j ≫ g_semi = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (P_ν j))) ∧
        ∀ pt : PrimeSpectrum (↥V ⧸ P_ν j),
          Ideal.comap (Ideal.Quotient.mk (P_ν j)) pt.asIdeal = IsLocalRing.maximalIdeal ↥V →
          (σ_ν j).base pt = y_bad ν) ∧
      K_bad ν = ⋃ j : Fin r_ν, Set.range (σ_ν j).base) ∧
  V_tilde₀ ⊔ V_tilde₁ = ⊤ ∧
  AlgebraicGeometry.IsAffineOpen V_tilde₀ ∧ Nonempty ↥V_tilde₀ ∧
  AlgebraicGeometry.IsAffineOpen V_tilde₁ ∧ Nonempty ↥V_tilde₁ ∧
  V_tilde₀ ⊓ V_tilde₁ = C_tilde.basicOpen T₀ ∧
  V_tilde₀ ⊓ V_tilde₁ = C_tilde.basicOpen S₁ ∧
  (C_tilde.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom T₀ *
    (C_tilde.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom S₁ = 1 ∧
  (∃ (c₀ : ↥V →+* ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀)))
     (d₀ : ℕ) (gen₀ : Fin d₀ → ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀))),
    (∀ v : ↥V, c₀ v =
      (g_tilde.appTop ≫ C_tilde.presheaf.map (CategoryTheory.homOfLE le_top).op).hom
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv.hom v)) ∧
    ∀ w : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₀)),
      ∃ P : Fin d₀ → Polynomial ↥V,
        w = ∑ μ : Fin d₀, Polynomial.eval₂ c₀ T₀ (P μ) * gen₀ μ) ∧
  (∃ (c₁ : ↥V →+* ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₁)))
     (d₁ : ℕ) (gen₁ : Fin d₁ → ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₁))),
    (∀ v : ↥V, c₁ v =
      (g_tilde.appTop ≫ C_tilde.presheaf.map (CategoryTheory.homOfLE le_top).op).hom
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv.hom v)) ∧
    ∀ w : ↑(C_tilde.presheaf.obj (Opposite.op V_tilde₁)),
      ∃ P : Fin d₁ → Polynomial ↥V,
        w = ∑ μ : Fin d₁, Polynomial.eval₂ c₁ S₁ (P μ) * gen₁ μ)

def IsDivisorAdaptedSubringCover {K : Type u} [Field K] (V : ValuationSubring K)
    {C_semi : AlgebraicGeometry.Scheme.{u}}
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (r_pts : ℕ)
    (γ_div : Fin (r_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
    (W_div : Fin (r_pts + 1) → C_semi.Opens)
    (t_div : ∀ i : Fin (r_pts + 1), ↑(C_semi.presheaf.obj (Opposite.op (W_div i))))
    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (N : ℕ) (W : Fin (N + 1) → C_semi.Opens)
    (tag : Fin (N + 1) → Option (Fin (r_pts + 1)))
    (B : Finset (Fin (N + 1)) → Subring F)
    (t_loc : Fin (N + 1) → F)
    (φ_cov : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
      ↑(C_semi.presheaf.obj (Opposite.op (Finset.inf S W))) ≃+* ↥(B S)) : Prop :=
  Function.Injective φ_VF ∧
  (⨆ a : Fin (N + 1), W a) = ⊤ ∧
  (∀ (S : Finset (Fin (N + 1))) (hS : S.Nonempty),
    AlgebraicGeometry.IsAffineOpen (Finset.inf S W) ∧
    Nonempty ↥(Finset.inf S W) ∧
    ∀ v : ↥V,
      ((φ_cov S hS)
        ((g_semi.appTop ≫ C_semi.presheaf.map (CategoryTheory.homOfLE le_top).op).hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv.hom v)) : F) = φ_VF v) ∧
  (∀ (S S' : Finset (Fin (N + 1))) (hS : S.Nonempty) (hS' : S'.Nonempty) (hsub : S ⊆ S'),
    B S ≤ B S' ∧
    ∀ s : ↑(C_semi.presheaf.obj (Opposite.op (Finset.inf S W))),
      ((φ_cov S' hS')
        ((C_semi.presheaf.map (CategoryTheory.homOfLE (Finset.inf_mono hsub)).op).hom s) : F) =
      ((φ_cov S hS) s : F)) ∧
  (∀ a : Fin (N + 1), t_loc a ∈ B {a} ∧ t_loc a ≠ 0) ∧
  (∀ (S : Finset (Fin (N + 1))), S.Nonempty →
    ∀ a ∈ S, ∀ b ∈ S, t_loc a / t_loc b ∈ B S) ∧
  (∀ a : Fin (N + 1),
    (tag a = none →
      Disjoint (W a : Set ↥C_semi) (⋃ i : Fin (r_pts + 1), Set.range (γ_div i).base) ∧
      t_loc a = 1) ∧
    ∀ i : Fin (r_pts + 1), tag a = some i →
      W a ≤ W_div i ∧
      ∃ h_le : Finset.inf {a} W ≤ W_div i,
        t_loc a = ((φ_cov {a} (Finset.singleton_nonempty a))
          ((C_semi.presheaf.map (CategoryTheory.homOfLE h_le).op).hom (t_div i)) : F)) ∧
  (∀ i : Fin (r_pts + 1),
    ∃ a : Fin (N + 1), tag a = some i ∧ Set.range (γ_div i).base ⊆ (W a : Set ↥C_semi))

def HasNoetherianDoubleComplexModelAt {K : Type u} [Field K] (V : ValuationSubring K)
    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (N : ℕ) (B : Finset (Fin (N + 1)) → Subring F)
    (t_loc : Fin (N + 1) → F) (k : ℕ) (S_F : Finset F) : Prop :=
  ∃ (R_β : Subring ↥V) (B_β D_β₀ D_β₁ D_β₀₁ : Finset (Fin (N + 1)) → Subring F),
    IsNoetherianRing ↥R_β ∧
    IsLocalRing ↥R_β ∧
    IsLocalHom R_β.subtype ∧
    (∀ (S : Finset (Fin (N + 1))), S.Nonempty →
      (∀ z ∈ S_F, z ∈ B S → z ∈ B_β S) ∧
      ∃ (hR : ∀ r : ↥R_β, φ_VF (R_β.subtype r) ∈ B_β S)
        (hV : ∀ v : ↥V, φ_VF v ∈ B S)
        (hle : B_β S ≤ B S),
        B_β S ≤ D_β₀ S ∧
        B_β S ≤ D_β₁ S ∧
        D_β₀ S ≤ D_β₀₁ S ∧
        D_β₁ S ≤ D_β₀₁ S ∧
        D_β₀ S ⊓ D_β₁ S = B_β S ∧
        (∀ a ∈ S, ∀ b ∈ S, t_loc a / t_loc b ∈ B_β S) ∧
        (let φ_R : ↥R_β →+* ↥(B_β S) := (φ_VF.comp R_β.subtype).codRestrict (B_β S) hR
         let φ_RB : ↥R_β →+* ↥(B S) := (φ_VF.comp R_β.subtype).codRestrict (B S) (fun r => hV (R_β.subtype r))
         letI : Algebra ↥R_β ↥(B_β S) := φ_R.toAlgebra
         letI : Algebra ↥R_β ↥(B S) := φ_RB.toAlgebra
         let f₁ : ↥(B_β S) →ₐ[↥R_β] ↥(B S) :=
           { toRingHom := Subring.inclusion hle, commutes' := fun _ => Subtype.ext rfl }
         let f₂ : ↥V →ₐ[↥R_β] ↥(B S) :=
           { toRingHom := φ_VF.codRestrict (B S) hV, commutes' := fun _ => Subtype.ext rfl }
         Module.Flat ↥R_β ↥(B_β S) ∧
         Function.Bijective (Algebra.TensorProduct.productMap f₁ f₂))) ∧
    (∀ (S S' : Finset (Fin (N + 1))), S.Nonempty → S ⊆ S' →
      B_β S ≤ B_β S' ∧ D_β₀ S ≤ D_β₀ S' ∧ D_β₁ S ≤ D_β₁ S' ∧ D_β₀₁ S ≤ D_β₀₁ S') ∧
    (∀ S : Finset (Fin (N + 1)), 2 ≤ S.card →
      ∀ z ∈ D_β₀₁ S, ∃ z₀ ∈ D_β₀ S, ∃ z₁ ∈ D_β₁ S, z = z₀ - z₁) ∧
    (∀ a : Fin (N + 1),
      ∃ G_Q : Finset F,
        (∀ g ∈ G_Q, g ∈ D_β₀₁ {a}) ∧
        ∀ z ∈ D_β₀₁ {a}, ∃ z₀ ∈ D_β₀ {a}, ∃ z₁ ∈ D_β₁ {a}, ∃ c : ↥G_Q → ↥R_β,
          z = z₀ - z₁ + ∑ g : ↥G_Q, φ_VF (R_β.subtype (c g)) * (g : F)) ∧
    (∃ G_M : Finset F,
      (∀ g ∈ G_M, ∀ a : Fin (N + 1), (t_loc a) ^ k * g ∈ D_β₀₁ {a}) ∧
      ∀ ξ : F, (∀ a : Fin (N + 1), (t_loc a) ^ k * ξ ∈ D_β₀₁ {a}) →
        ∃ ξ₀ ξ₁ : F,
          (∀ a : Fin (N + 1), (t_loc a) ^ k * ξ₀ ∈ D_β₀ {a}) ∧
          (∀ a : Fin (N + 1), (t_loc a) ^ k * ξ₁ ∈ D_β₁ {a}) ∧
          ∃ c : ↥G_M → ↥R_β,
            ξ = ξ₀ - ξ₁ + ∑ g : ↥G_M, φ_VF (R_β.subtype (c g)) * (g : F)) ∧
    (∀ D_ε ∈ ({D_β₀, D_β₁, D_β₀₁} : Set (Finset (Fin (N + 1)) → Subring F)),
      ∀ (p : ℕ) (ξ : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I} → F),
        (∀ I, (t_loc (I.1 0)) ^ k * ξ I ∈ D_ε (Finset.univ.image I.1)) →
        (∀ J : {J : Fin (p + 3) → Fin (N + 1) // StrictMono J},
          (∑ q : Fin (p + 3), (-1 : F) ^ (q : ℕ) *
            ξ ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩) = 0) →
        ∃ η : {I : Fin (p + 1) → Fin (N + 1) // StrictMono I} → F,
          (∀ I, (t_loc (I.1 0)) ^ k * η I ∈ D_ε (Finset.univ.image I.1)) ∧
          ∀ I : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I},
            (∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
              η ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩) = ξ I)
def IsRankOneGaussLinearVal {L F : Type u} [Field L] [Field F]
    (W₀ : ValuationSubring L) (φ_LF : L →+* F) (t : F)
    (W_Z : ValuationSubring F) (α_Z π_Z : L) : Prop :=
  π_Z ≠ 0 ∧
  (∀ V' : ValuationSubring F, W_Z ≤ V' → V' ≠ ⊤ → V' = W_Z) ∧
  ∃ (hW₀ : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W_Z)
    (hu : (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹ ∈ W_Z),
    IsUnit (⟨(t - φ_LF α_Z) * (φ_LF π_Z)⁻¹, hu⟩ : ↥W_Z) ∧
    (∀ r : ↥W₀,
      (⟨φ_LF (W₀.subtype r), hW₀ r⟩ : ↥W_Z) ∈ IsLocalRing.maximalIdeal ↥W_Z ↔
        r ∈ IsLocalRing.maximalIdeal ↥W₀) ∧
    (∀ Q : Polynomial ↥W₀,
      (∃ i : ℕ, Q.coeff i ∉ IsLocalRing.maximalIdeal ↥W₀) →
      Polynomial.eval₂ ((φ_LF.comp W₀.subtype).codRestrict W_Z.toSubring hW₀)
        ⟨(t - φ_LF α_Z) * (φ_LF π_Z)⁻¹, hu⟩ Q ∉ IsLocalRing.maximalIdeal ↥W_Z) ∧
    (∀ w : ↥W_Z,
      ∃ P Q : Polynomial ↥W₀,
        (∃ i : ℕ, Q.coeff i ∉ IsLocalRing.maximalIdeal ↥W₀) ∧
        w * Polynomial.eval₂ ((φ_LF.comp W₀.subtype).codRestrict W_Z.toSubring hW₀)
              ⟨(t - φ_LF α_Z) * (φ_LF π_Z)⁻¹, hu⟩ Q -
          Polynomial.eval₂ ((φ_LF.comp W₀.subtype).codRestrict W_Z.toSubring hW₀)
            ⟨(t - φ_LF α_Z) * (φ_LF π_Z)⁻¹, hu⟩ P ∈ IsLocalRing.maximalIdeal ↥W_Z)

def IsRankOneComponentStalkCenter {L F : Type u} [Field L] [Field F]
    (W₀ : ValuationSubring L)
    {ℰ : AlgebraicGeometry.Scheme.{u}}
    (g_ℰ : ℰ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥W₀))
    (η_ℰ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ ℰ)
    (Z : Set ↥(CategoryTheory.Limits.pullback g_ℰ
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥W₀ (IsLocalRing.maximalIdeal ↥W₀).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g_ℰ
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥W₀ (IsLocalRing.maximalIdeal ↥W₀).ResidueField))))
    (W_Z : ValuationSubring F) : Prop :=
  let k₀ := (IsLocalRing.maximalIdeal ↥W₀).ResidueField
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ k₀))
  AlgebraicGeometry.IsClosedImmersion ιZ ∧
  AlgebraicGeometry.IsIntegral Z_sch ∧
  Set.range ιZ.base = Z ∧
  ∃ (K_Z : Type u) (_ : Field K_Z)
    (η_Z : AlgebraicGeometry.Spec (CommRingCat.of K_Z) ⟶ Z_sch)
    (pt_Z : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_Z)))
    (U_Z : ℰ.Opens) (hUZ : AlgebraicGeometry.IsAffineOpen U_Z)
    (hη_mem : (CategoryTheory.Limits.pullback.fst g_ℰ s₀).base
      (ιZ.base (η_Z.base pt_Z)) ∈ U_Z)
    (φ_UZ : CommRingCat.of ↑(ℰ.presheaf.obj (Opposite.op U_Z)) ⟶ CommRingCat.of F)
    (hB_WZ : ∀ b : ↑(ℰ.presheaf.obj (Opposite.op U_Z)), φ_UZ.hom b ∈ W_Z)
    (e_W : (IsLocalRing.maximalIdeal ↥W_Z).ResidueField ≃+* K_Z),
    AlgebraicGeometry.IsDominant η_Z ∧
    IsSchemeFunctionField Z_sch K_Z η_Z ∧
    AlgebraicGeometry.Spec.map φ_UZ ≫ hUZ.fromSpec = η_ℰ ∧
    (∀ x : F, x ∈ W_Z ↔
      ∃ (b s : ↑(ℰ.presheaf.obj (Opposite.op U_Z))),
        s ∉ (hUZ.primeIdealOf
          ⟨(CategoryTheory.Limits.pullback.fst g_ℰ s₀).base
            (ιZ.base (η_Z.base pt_Z)), hη_mem⟩).asIdeal ∧
        φ_UZ.hom s * x = φ_UZ.hom b) ∧
    (∀ b : ↑(ℰ.presheaf.obj (Opposite.op U_Z)),
      (⟨φ_UZ.hom b, hB_WZ b⟩ : ↥W_Z) ∈ IsLocalRing.maximalIdeal ↥W_Z ↔
        b ∈ (hUZ.primeIdealOf
          ⟨(CategoryTheory.Limits.pullback.fst g_ℰ s₀).base
            (ιZ.base (η_Z.base pt_Z)), hη_mem⟩).asIdeal) ∧
    AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥W_Z (IsLocalRing.maximalIdeal ↥W_Z).ResidueField)) ≫
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (φ_UZ.hom.codRestrict W_Z.toSubring hB_WZ)) ≫
      hUZ.fromSpec =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_W.symm.toRingHom) ≫
        η_Z ≫ ιZ ≫ CategoryTheory.Limits.pullback.fst g_ℰ s₀
def HasLocalSemistableCurveBranchChart (κ : Type u) [Field κ]
    {F : AlgebraicGeometry.Scheme.{u}}
    (snd : F ⟶ AlgebraicGeometry.Spec (CommRingCat.of κ)) (w : ↥F) : Prop :=
  (∃ (D : Type u) (_ : CommRing D) (j : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ F)
      (q_D : AlgebraicGeometry.Spec (CommRingCat.of D)),
    IsDomain D ∧
    IsIntegrallyClosed D ∧
    AlgebraicGeometry.IsOpenImmersion j ∧
    j.base q_D = w ∧
    (∃ p₁ p₂ : AlgebraicGeometry.Spec (CommRingCat.of D), p₁ ≠ p₂) ∧
    (∀ Z : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of D)),
      IsClosed Z → Z ≠ Set.univ →
      Z.Finite ∧
      ∀ p ∈ Z, ∃ σ : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ F,
        σ ≫ snd = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) ∧
        Set.range σ.base = {j.base p})) ∨
  ((∀ U_sm : F.Opens, w ∈ U_sm →
      ¬ AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_sm.ι ≫ snd)) ∧
   ∃ (B' : Type u) (_ : CommRing B') (j : AlgebraicGeometry.Spec (CommRingCat.of B') ⟶ F)
      (q' : AlgebraicGeometry.Spec (CommRingCat.of B')) (b : Fin 2 → B'),
    IsReduced B' ∧
    AlgebraicGeometry.IsOpenImmersion j ∧
    j.base q' = w ∧
    (∃ σ₀ : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ F,
      σ₀ ≫ snd = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) ∧
      Set.range σ₀.base = {w}) ∧
    PrimeSpectrum.zeroLocus ({b 0} : Set B') ∪
      PrimeSpectrum.zeroLocus ({b 1} : Set B') = Set.univ ∧
    PrimeSpectrum.zeroLocus ({b 0} : Set B') ∩
      PrimeSpectrum.zeroLocus ({b 1} : Set B') = {q'} ∧
    (∀ i : Fin 2,
      (Ideal.span {b i} : Ideal B').IsPrime ∧
      let D_i := B' ⧸ Ideal.span {b i}
      ∃ (_ : IsDomain D_i),
        IsIntegrallyClosed D_i ∧
        (∃ p₁ p₂ : AlgebraicGeometry.Spec (CommRingCat.of D_i), p₁ ≠ p₂) ∧
        (∀ Z : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of D_i)),
          IsClosed Z → Z ≠ Set.univ →
          Z.Finite ∧
          ∀ p ∈ Z, ∃ σ : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ F,
            σ ≫ snd = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) ∧
            Set.range σ.base =
              {j.base ((AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {b i})))).base p)})))
def IsClosedFiberVeroneseSeed {K : Type u} [Field K] (V : ValuationSubring K)
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (m₀ : ℕ)
    (f₁_bar : ↑((CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))).presheaf.obj
      (Opposite.op ((TopologicalSpace.Opens.map
        (CategoryTheory.Limits.pullback.fst g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))).base).obj V₁)))) : Prop :=
  let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
  let Y := CategoryTheory.Limits.pullback g s₀
  let fstY := CategoryTheory.Limits.pullback.fst g s₀
  let sndY := CategoryTheory.Limits.pullback.snd g s₀
  let Y'_set : Set ↥Y := ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E'
  let V₀_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₀
  let V₁_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₁
  let R₀_Y := Y.presheaf.obj (Opposite.op V₀_Y)
  let R₁_Y := Y.presheaf.obj (Opposite.op V₁_Y)
  let R₀₁_Y := Y.presheaf.obj (Opposite.op (V₀_Y ⊓ V₁_Y))
  letI : Algebra k₀ ↑R₁_Y := (
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE sndY ⊤ V₁_Y le_top).hom.toAlgebra
  let res₀_Y : ↑R₀_Y →+* ↑R₀₁_Y :=
    (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op).hom
  let res₁_Y : ↑R₁_Y →+* ↑R₀₁_Y :=
    (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀_Y ⊓ V₁_Y ≤ V₁_Y)).op).hom
  let h₀_Y : ↑R₀_Y := (fstY.appLE V₀ V₀_Y le_rfl).hom h₀
  let eZ_Y : ↑R₀_Y := (fstY.appLE V₀ V₀_Y le_rfl).hom eZ
  let eY_Y : ↑R₀_Y := (fstY.appLE V₀ V₀_Y le_rfl).hom eY
  let t₀_Y : ↑R₁_Y := (fstY.appLE V₁ V₁_Y le_rfl).hom t₀
  let I_Z_Y : Ideal ↑R₀_Y := Ideal.span ({h₀_Y, eY_Y} : Set ↑R₀_Y)
  6 ≤ m₀ ∧
  (∃ (x₀_f₁ xZ_f₁ : ↑R₀_Y),
    x₀_f₁ ∈ I_Z_Y ^ m₀ ∧
    res₀_Y x₀_f₁ = res₀_Y (h₀_Y ^ m₀) * res₁_Y f₁_bar ∧
    xZ_f₁ * h₀_Y ^ m₀ = eZ_Y ^ m₀ * x₀_f₁ ∧
    Y'_set \ (V₁_Y : Set Y) ⊆ (Y.basicOpen x₀_f₁ : Set Y) ∧
    (∀ z ∈ Z, fstY.base z ∈ V₀ → z ∉ (Y.basicOpen xZ_f₁ : Set Y))) ∧
  (∀ (c₀ c₁ : k₀), algebraMap k₀ ↑R₁_Y c₀ + c₁ • f₁_bar = 0 → c₀ = 0 ∧ c₁ = 0) ∧
  (∀ z ∈ Z, fstY.base z ∈ V₁ → z ∉ (Y.basicOpen f₁_bar : Set Y)) ∧
  (∀ r : ℕ, 1 ≤ r → ∀ z : ↑R₀₁_Y,
    ∃ x₀ ∈ I_Z_Y ^ (r * m₀), ∃ x₁ : ↑R₁_Y,
      res₁_Y (t₀_Y ^ (r * m₀)) * res₀_Y x₀ - res₁_Y x₁ = z) ∧
  (∀ (r : ℕ), 1 ≤ r →
    ∀ x₁ : ↑R₁_Y,
      (∃ x₀ ∈ I_Z_Y ^ (r * m₀), res₀_Y x₀ = res₀_Y (h₀_Y ^ (r * m₀)) * res₁_Y x₁) →
      x₁ ∈ (Submodule.span k₀
        {u : ↑R₁_Y | ∃ x₀ ∈ I_Z_Y ^ m₀, res₀_Y x₀ = res₀_Y (h₀_Y ^ m₀) * res₁_Y u}) ^ r)

def IsRelativeVeroneseBasisPkg {K : Type u} [Field K] (V : ValuationSubring K)
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (m₀ N' : ℕ)
    (f : Fin (N' + 1) → ↑(C.presheaf.obj (Opposite.op V₁)))
    (f_Y f_Z : Fin (N' + 1) → ↑(C.presheaf.obj (Opposite.op V₀))) : Prop :=
  let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
  let Y := CategoryTheory.Limits.pullback g s₀
  let fstY := CategoryTheory.Limits.pullback.fst g s₀
  let V₀_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₀
  let V₁_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₁
  let R₀ := C.presheaf.obj (Opposite.op V₀)
  let R₁ := C.presheaf.obj (Opposite.op V₁)
  let R₀₁ := C.presheaf.obj (Opposite.op (V₀ ⊓ V₁))
  letI : Algebra ↥V ↑R₁ := (
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₁ le_top).hom.toAlgebra
  let res₀ : ↑R₀ →+* ↑R₀₁ :=
    (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom
  let res₁ : ↑R₁ →+* ↑R₀₁ :=
    (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
  let I_Z : Ideal ↑R₀ := Ideal.span ({h₀, eY} : Set ↑R₀)
  1 ≤ m₀ ∧
  1 ≤ N' ∧
  f 0 = 1 ∧
  f_Y 0 = h₀ ^ m₀ ∧
  f_Z 0 = eZ ^ m₀ ∧
  (∀ a : Fin (N' + 1), f_Y a ∈ I_Z ^ m₀) ∧
  (∀ a : Fin (N' + 1), res₀ (f_Y a) = res₀ (h₀ ^ m₀) * res₁ (f a)) ∧
  (∀ a : Fin (N' + 1), f_Z a * h₀ ^ m₀ = eZ ^ m₀ * f_Y a) ∧
  (∃ r_u : ℕ, eY ^ r_u ∈ Ideal.span ({f_Y 0, f_Y (1 : Fin (N' + 1))} : Set ↑R₀)) ∧
  (∀ z ∈ Z, fstY.base z ∈ V₁ →
    z ∉ (Y.basicOpen ((fstY.appLE V₁ V₁_Y le_rfl).hom (f (1 : Fin (N' + 1)))) : Set Y)) ∧
  (∀ z ∈ Z, fstY.base z ∈ V₀ →
    z ∉ (Y.basicOpen ((fstY.appLE V₀ V₀_Y le_rfl).hom (f_Z (1 : Fin (N' + 1)))) : Set Y)) ∧
  (∀ r : ℕ, 1 ≤ r → ∀ z : ↑R₀₁,
    ∃ x₀ ∈ I_Z ^ (r * m₀), ∃ x₁ : ↑R₁,
      res₁ (t₀ ^ (r * m₀)) * res₀ x₀ - res₁ x₁ = z) ∧
  (∀ r : ℕ, 1 ≤ r →
    ∃ (D_r : ℕ) (B_r : Fin D_r → MvPolynomial (Fin (N' + 1)) ↥V),
      (∀ i : Fin D_r, B_r i ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) ↥V r) ∧
      (∀ x₁ : ↑R₁,
        (∃ x₀ ∈ I_Z ^ (r * m₀), res₀ x₀ = res₀ (h₀ ^ (r * m₀)) * res₁ x₁) ↔
          ∃ c : Fin D_r → ↥V,
            x₁ = ∑ i : Fin D_r, c i • MvPolynomial.aeval f (B_r i)) ∧
      (∀ c : Fin D_r → ↥V,
        (∑ i : Fin D_r, c i • MvPolynomial.aeval f (B_r i)) = 0 → ∀ i : Fin D_r, c i = 0))

def IsThreeChartContractionImagePkg {K : Type u} [Field K] (V : ValuationSubring K)
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (V₀ V₁ : C.Opens)
    (eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (m₀ N' : ℕ)
    (f : Fin (N' + 1) → ↑(C.presheaf.obj (Opposite.op V₁)))
    (f_Y f_Z : Fin (N' + 1) → ↑(C.presheaf.obj (Opposite.op V₀)))
    (φ : C ⟶ (weilProjectiveSpaceOver ↥V N').left)
    (U_next₀ : (AlgebraicGeometry.Scheme.Hom.image φ).Opens)
    (f₁_gl : ↑(C.presheaf.obj (Opposite.op (V₁ ⊔ C.basicOpen eZ)))) : Prop :=
  let 𝒜_V := MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) ↥V
  letI : GradedAlgebra 𝒜_V := MvPolynomial.gradedAlgebra
  let P_next := weilProjectiveSpaceOver ↥V N'
  let q_img := AlgebraicGeometry.Scheme.Hom.toImage φ
  let ιP_next := AlgebraicGeometry.Scheme.Hom.imageι φ
  let W_compl : C.Opens := V₁ ⊔ C.basicOpen eZ
  let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
  let R₀ := C.presheaf.obj (Opposite.op V₀)
  let R₁ := C.presheaf.obj (Opposite.op V₁)
  letI : Algebra ↥V ↑R₀ := (
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₀ le_top).hom.toAlgebra
  letI : Algebra ↥V ↑R₁ := (
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₁ le_top).hom.toAlgebra
  φ ≫ P_next.hom = g ∧
  AlgebraicGeometry.Surjective q_img ∧
  U_next₀ =
    (TopologicalSpace.Opens.map ιP_next.base).obj (weilProjBasicOpen ↥V N' 0) ∧
  AlgebraicGeometry.IsAffineOpen U_next₀ ∧
  (TopologicalSpace.Opens.map q_img.base).obj U_next₀ = W_compl ∧
  (C.presheaf.map (CategoryTheory.homOfLE (le_sup_left : V₁ ≤ W_compl)).op).hom f₁_gl =
    f (1 : Fin (N' + 1)) ∧
  (C.presheaf.map (CategoryTheory.homOfLE (le_sup_right : C.basicOpen eZ ≤ W_compl)).op).hom f₁_gl *
    (C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le eZ)).op).hom (eZ ^ m₀) =
    (C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le eZ)).op).hom
      (f_Z (1 : Fin (N' + 1))) ∧
  (∀ z ∈ Z,
    z ∉ (CategoryTheory.Limits.pullback g s₀).basicOpen
      (((CategoryTheory.Limits.pullback.fst g s₀).appLE W_compl
        ((TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g s₀).base).obj W_compl)
        le_rfl).hom f₁_gl)) ∧
  (∃ (ψ₁ : MvPolynomial (Fin (N' + 1)) ↥V →+* ↑(V₁.toScheme.presheaf.obj (Opposite.op ⊤)))
     (hψ₁ : Ideal.map ψ₁ (HomogeneousIdeal.irrelevant 𝒜_V).toIdeal = ⊤)
     (ψ_Z : MvPolynomial (Fin (N' + 1)) ↥V →+* ↑((C.basicOpen eZ).toScheme.presheaf.obj (Opposite.op ⊤)))
     (hψ_Z : Ideal.map ψ_Z (HomogeneousIdeal.irrelevant 𝒜_V).toIdeal = ⊤)
     (ψ_Y : MvPolynomial (Fin (N' + 1)) ↥V →+* ↑((C.basicOpen eY).toScheme.presheaf.obj (Opposite.op ⊤)))
     (hψ_Y : Ideal.map ψ_Y (HomogeneousIdeal.irrelevant 𝒜_V).toIdeal = ⊤),
    (∀ (c : ↥V), ψ₁ (MvPolynomial.C c) =
      (V₁.topIso.inv).hom (algebraMap ↥V ↑R₁ c)) ∧
    (∀ (a : Fin (N' + 1)), ψ₁ (MvPolynomial.X a) = (V₁.topIso.inv).hom (f a)) ∧
    V₁.ι ≫ φ = AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜_V ψ₁ hψ₁ ∧
    (∀ (c : ↥V), ψ_Z (MvPolynomial.C c) =
      ((C.basicOpen eZ).topIso.inv).hom
        ((C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le eZ)).op).hom (algebraMap ↥V ↑R₀ c))) ∧
    (∀ (a : Fin (N' + 1)),
      ψ_Z (MvPolynomial.X a) *
        ((C.basicOpen eZ).topIso.inv).hom
          ((C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le eZ)).op).hom (eZ ^ m₀)) =
        ((C.basicOpen eZ).topIso.inv).hom
          ((C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le eZ)).op).hom (f_Z a))) ∧
    (C.basicOpen eZ).ι ≫ φ = AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜_V ψ_Z hψ_Z ∧
    (∀ (c : ↥V), ψ_Y (MvPolynomial.C c) =
      ((C.basicOpen eY).topIso.inv).hom
        ((C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le eY)).op).hom (algebraMap ↥V ↑R₀ c))) ∧
    (∀ (a : Fin (N' + 1)),
      ψ_Y (MvPolynomial.X a) =
        ((C.basicOpen eY).topIso.inv).hom
          ((C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le eY)).op).hom (f_Y a))) ∧
    (C.basicOpen eY).ι ≫ φ = AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜_V ψ_Y hψ_Y) ∧
  (∀ (a : Fin (N' + 1))
     (hXa : (MvPolynomial.X a : MvPolynomial (Fin (N' + 1)) ↥V) ∈ 𝒜_V 1)
     (r : ℕ) (P : MvPolynomial (Fin (N' + 1)) ↥V) (hP : P ∈ 𝒜_V (r • 1)),
    ((AlgebraicGeometry.Proj.awayToSection 𝒜_V (MvPolynomial.X a)).hom
      (HomogeneousLocalization.Away.mk 𝒜_V hXa r P hP)) ∈
      RingHom.ker ((φ.app (weilProjBasicOpen ↥V N' a)).hom) ↔
    MvPolynomial.aeval f (MvPolynomial.X a * P) = 0)
noncomputable abbrev weilNodalIdeal (R : Type u) [CommRing R] (a : R) :
    Ideal (MvPolynomial (Fin 2) R) :=
  Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}

abbrev weilNodalQuot (R : Type u) [CommRing R] (a : R) : Type u :=
  MvPolynomial (Fin 2) R ⧸ weilNodalIdeal R a

def IsChartedBaseDiscTreeModel {K : Type u} [Field K] (R : ValuationSubring K)
    (a_opt : Option ↥R)
    {M_0 : AlgebraicGeometry.Scheme.{u}}
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0)
    {F_0 : Type u} [Field F_0]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (φ_KF0 : K →+* F_0) (T_0 : F_0)
    {N : ℕ} (c π : Fin N → ↥R)
    (M_T : AlgebraicGeometry.Scheme.{u})
    (g_MT : M_T ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f_MT : M_T ⟶ M_0)
    (η_MT : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_T)
    (Z_MT : Set ↥M_0)
    (B_comp : Fin N → Set ↥(CategoryTheory.Limits.pullback g_MT
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))))) : Prop :=
  let s_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
    (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
  let fst_R := CategoryTheory.Limits.pullback.fst g_MT s_R
  IsBaseDiscTreeModel R a_opt g_M0 m_0 η_M0 φ_KF0 T_0 c π M_T g_MT f_MT η_MT Z_MT B_comp ∧
  ((⋃ i : Fin N, B_comp i) = Set.univ) ∧
  (∀ i j : Fin N, i ≠ j → ¬ IsDiscHasseCover ↥R c π i j → ¬ IsDiscHasseCover ↥R c π j i →
    Disjoint (B_comp i) (B_comp j)) ∧
  (∀ (i : Fin N),
    ¬ (∃ a₀ : ↥R, a_opt = some a₀ ∧ IsValDiscEq ↥R (c i) (π i) 0 a₀) →
    ∀ (c_tilde : ↥R),
      (∀ (j : Fin N), IsDiscHasseCover ↥R c π i j →
        ∀ r : ↥R, c j - c i = r * π i → r - c_tilde ∉ IsLocalRing.maximalIdeal ↥R) →
      ∃ (h : Polynomial ↥R)
        (ι_U : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h)) ⟶ M_T)
        (φ_U : Localization.Away h →+* F_0),
        Polynomial.eval c_tilde h ∉ IsLocalRing.maximalIdeal ↥R ∧
        AlgebraicGeometry.IsOpenImmersion ι_U ∧
        ι_U ≫ g_MT = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((algebraMap (Polynomial ↥R) (Localization.Away h)).comp Polynomial.C)) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U) ≫ ι_U = η_MT ∧
        φ_KF0 (R.subtype (π i)) *
            φ_U (algebraMap (Polynomial ↥R) (Localization.Away h) Polynomial.X) =
          T_0 - φ_KF0 (R.subtype (c i)) ∧
        ∀ (p : PrimeSpectrum (Localization.Away h)) (k : Fin N),
          (g_MT.base (ι_U.base p)).asIdeal = IsLocalRing.maximalIdeal ↥R →
          (ι_U.base p ∈ fst_R.base '' (B_comp k) ↔ k = i)) ∧
  (∀ (i : Fin N) (a₀ : ↥R),
    a_opt = some a₀ → IsValDiscEq ↥R (c i) (π i) 0 a₀ →
    ∃ (h : Polynomial ↥R)
      (ι_U : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h)) ⟶ M_T),
      Polynomial.eval 1 h ∉ IsLocalRing.maximalIdeal ↥R ∧
      AlgebraicGeometry.IsOpenImmersion ι_U ∧
      ι_U ≫ g_MT = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap (Polynomial ↥R) (Localization.Away h)).comp Polynomial.C)) ∧
      (∀ p : PrimeSpectrum (Localization.Away h),
        (g_MT.base (ι_U.base p)).asIdeal = IsLocalRing.maximalIdeal ↥R →
        f_MT.base (ι_U.base p) ≠ m_0) ∧
      (∀ (p : PrimeSpectrum (Localization.Away h)) (k : Fin N),
        (g_MT.base (ι_U.base p)).asIdeal = IsLocalRing.maximalIdeal ↥R →
        (ι_U.base p ∈ fst_R.base '' (B_comp k) ↔ k = i))) ∧
  (∀ (i_p i_c : Fin N),
    IsDiscHasseCover ↥R c π i_p i_c →
    ∃ (c_e c' : ↥R),
      (∃ r : ↥R, c_e - c i_c = r * π i_c) ∧
      π i_c = c' * π i_p ∧
      c' ≠ 0 ∧
      c' ∈ IsLocalRing.maximalIdeal ↥R ∧
      ∃ (h : weilNodalQuot ↥R c')
        (ι_U : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h)) ⟶ M_T)
        (φ_U : Localization.Away h →+* F_0),
        h ∉ Ideal.span {Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X 0),
              Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X 1)} ⊔
            Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal ↥R c')).comp MvPolynomial.C)
              (IsLocalRing.maximalIdeal ↥R) ∧
        AlgebraicGeometry.IsOpenImmersion ι_U ∧
        ι_U ≫ g_MT = AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk (weilNodalIdeal ↥R c')).comp MvPolynomial.C) ≫
            CommRingCat.ofHom (algebraMap (weilNodalQuot ↥R c') (Localization.Away h))) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U) ≫ ι_U = η_MT ∧
        φ_KF0 (R.subtype (π i_p)) *
            φ_U (algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
              (Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X 0))) =
          T_0 - φ_KF0 (R.subtype c_e) ∧
        (T_0 - φ_KF0 (R.subtype c_e)) *
            φ_U (algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
              (Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X 1))) =
          φ_KF0 (R.subtype (π i_c)) ∧
        ∀ (p : PrimeSpectrum (Localization.Away h)) (k : Fin N),
          (g_MT.base (ι_U.base p)).asIdeal = IsLocalRing.maximalIdeal ↥R →
          (ι_U.base p ∈ fst_R.base '' (B_comp k) ↔
            (k = i_p ∧ algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
              (Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X 1)) ∈ p.asIdeal) ∨
            (k = i_c ∧ algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
              (Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X 0)) ∈ p.asIdeal)))

def HasStandardGaussDiscValuations {K : Type u} [Field K] (R : ValuationSubring K)
    (a_opt : Option ↥R)
    {M_0 : AlgebraicGeometry.Scheme.{u}}
    (_g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0)
    {F_0 : Type u} [Field F_0]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (φ_KF0 : K →+* F_0) (T_0 : F_0) : Prop :=
  (∀ r : ↥R, T_0 ≠ φ_KF0 (R.subtype r)) ∧
  (∀ P : Polynomial ↥R, P ≠ 0 → Polynomial.eval₂ (φ_KF0.comp R.subtype) T_0 P ≠ 0) ∧
  ∀ (c_d π_d : ↥R),
    π_d ≠ 0 →
    c_d ∈ IsLocalRing.maximalIdeal ↥R →
    π_d ∈ IsLocalRing.maximalIdeal ↥R →
    (∀ a₀ : ↥R, a_opt = some a₀ → ¬ IsValDiscLE ↥R c_d π_d 0 a₀) →
    ∃ (W_0 : ValuationSubring F_0) (hR : ∀ r : ↥R, φ_KF0 (R.subtype r) ∈ W_0),
      IsDiscValuationOnWB R m_0 η_M0 φ_KF0 T_0 c_d π_d W_0 ∧
      (∀ (Q : PrimeSpectrum ↥R),
        ∃ pW : PrimeSpectrum ↥W_0,
          ∀ r : ↥R, (⟨φ_KF0 (R.subtype r), hR r⟩ : ↥W_0) ∈ pW.asIdeal ↔ r ∈ Q.asIdeal) ∧
      (∀ (h : Polynomial ↥R) (φ_U : Localization.Away h →+* F_0),
        (∃ j : ℕ, h.coeff j ∉ IsLocalRing.maximalIdeal ↥R) →
        φ_U.comp ((algebraMap (Polynomial ↥R) (Localization.Away h)).comp Polynomial.C) =
          φ_KF0.comp R.subtype →
        φ_KF0 (R.subtype π_d) *
            φ_U (algebraMap (Polynomial ↥R) (Localization.Away h) Polynomial.X) =
          T_0 - φ_KF0 (R.subtype c_d) →
        ∃ (ρ_U : Localization.Away h →+* ↥W_0),
          W_0.subtype.comp ρ_U = φ_U ∧
          ∀ f : Localization.Away h,
            ρ_U f ∈ IsLocalRing.maximalIdeal ↥W_0 ↔
              f ∈ Ideal.map ((algebraMap (Polynomial ↥R) (Localization.Away h)).comp Polynomial.C)
                (IsLocalRing.maximalIdeal ↥R))

def HasLocalSmoothLeafBlowup {K : Type u} [Field K] (R : ValuationSubring K) : Prop :=
  ∀ (h_p : Polynomial ↥R) (c_tilde π_tilde : ↥R),
    Polynomial.eval c_tilde h_p ∉ IsLocalRing.maximalIdeal ↥R →
    π_tilde ≠ 0 →
    π_tilde ∈ IsLocalRing.maximalIdeal ↥R →
    let B := Localization.Away h_p
    let g_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap (Polynomial ↥R) B).comp Polynomial.C))
    let h_0 : Polynomial ↥R :=
      h_p.comp (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X)
    ∃ (Q₀_R : PrimeSpectrum ↥R)
      (U_bl : AlgebraicGeometry.Scheme.{u})
      (g_Ubl : U_bl ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
      (p_bl : U_bl ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
      (σ_loc : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B))
      (τ₀_loc τ₁_loc : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶ U_bl)
      (h_1 : weilNodalQuot ↥R π_tilde)
      (ι_0 : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_0)) ⟶ U_bl)
      (ι_1 : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_1)) ⟶ U_bl)
      (ψ_0 : B →+* Localization.Away h_0)
      (ψ_1 : B →+* Localization.Away h_1),
      Q₀_R.asIdeal ≠ ⊥ ∧
      π_tilde ∈ Q₀_R.asIdeal ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 g_B ∧
      AlgebraicGeometry.IsIntegral U_bl ∧
      p_bl ≫ g_B = g_Ubl ∧
      AlgebraicGeometry.IsProper p_bl ∧
      AlgebraicGeometry.Flat g_Ubl ∧
      AlgebraicGeometry.LocallyOfFinitePresentation g_Ubl ∧
      σ_loc ≫ g_B =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk Q₀_R.asIdeal)) ∧
      (∀ q : PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal),
        algebraMap (Polynomial ↥R) B (Polynomial.X - Polynomial.C c_tilde) ∈
          (σ_loc.base q).asIdeal) ∧
      τ₀_loc ≫ p_bl = σ_loc ∧
      τ₁_loc ≫ p_bl = σ_loc ∧
      Disjoint (Set.range τ₀_loc.base) (Set.range τ₁_loc.base) ∧
      (∃ hMod_cl : IsClosed (Set.range σ_loc.base),
        CategoryTheory.IsIso
          (p_bl ∣_ (⟨(Set.range σ_loc.base)ᶜ, hMod_cl.isOpen_compl⟩ :
            (AlgebraicGeometry.Spec (CommRingCat.of B)).Opens))) ∧
      (∃ q_gen : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)),
        g_B.base (σ_loc.base q_gen) = Q₀_R ∧
        IsIrreducible (p_bl.base ⁻¹' {σ_loc.base q_gen}) ∧
        p_bl.base ⁻¹' (Set.range σ_loc.base) = closure (p_bl.base ⁻¹' {σ_loc.base q_gen})) ∧
      (∀ c_val : ↥R, Polynomial.eval c_val h_0 ∉ IsLocalRing.maximalIdeal ↥R) ∧
      h_1 ∉ Ideal.span {Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 0),
            Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 1)} ⊔
          Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde)).comp MvPolynomial.C)
            (IsLocalRing.maximalIdeal ↥R) ∧
      AlgebraicGeometry.IsOpenImmersion ι_0 ∧
      AlgebraicGeometry.IsOpenImmersion ι_1 ∧
      Set.range ι_0.base ∪ Set.range ι_1.base = Set.univ ∧
      ι_0 ≫ p_bl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0) ∧
      ι_1 ≫ p_bl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_1) ∧
      (∀ r : ↥R,
        ψ_0 (algebraMap (Polynomial ↥R) B (Polynomial.C r)) =
          algebraMap (Polynomial ↥R) (Localization.Away h_0) (Polynomial.C r)) ∧
      ψ_0 (algebraMap (Polynomial ↥R) B Polynomial.X) =
        algebraMap (Polynomial ↥R) (Localization.Away h_0)
          (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X) ∧
      (∀ r : ↥R,
        ψ_1 (algebraMap (Polynomial ↥R) B (Polynomial.C r)) =
          algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_1)
            (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.C r))) ∧
      ψ_1 (algebraMap (Polynomial ↥R) B Polynomial.X) =
        algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_1)
          (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde)
            (MvPolynomial.C c_tilde + MvPolynomial.X 0)) ∧
      (∀ {F : Type u} [Field F] (φ_B : B →+* F),
        φ_B (algebraMap (Polynomial ↥R) B (Polynomial.C π_tilde)) ≠ 0 →
        φ_B (algebraMap (Polynomial ↥R) B (Polynomial.X - Polynomial.C c_tilde)) ≠ 0 →
        ∃ (φ_0 : Localization.Away h_0 →+* F) (φ_1 : Localization.Away h_1 →+* F),
          φ_0.comp ψ_0 = φ_B ∧
          φ_1.comp ψ_1 = φ_B ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_0) ≫ ι_0 =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_1) ≫ ι_1 ∧
          φ_B (algebraMap (Polynomial ↥R) B (Polynomial.C π_tilde)) *
              φ_0 (algebraMap (Polynomial ↥R) (Localization.Away h_0) Polynomial.X) =
            φ_B (algebraMap (Polynomial ↥R) B (Polynomial.X - Polynomial.C c_tilde)) ∧
          φ_B (algebraMap (Polynomial ↥R) B (Polynomial.X - Polynomial.C c_tilde)) *
              φ_1 (algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_1)
                (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 1))) =
            φ_B (algebraMap (Polynomial ↥R) B (Polynomial.C π_tilde))) ∧
      (∃ (q_max : PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal)),
        (g_B.base (σ_loc.base q_max)).asIdeal = IsLocalRing.maximalIdeal ↥R ∧
        let E_loc : Set ↥U_bl := p_bl.base ⁻¹' {σ_loc.base q_max}
        let S_strict : Set ↥U_bl :=
          closure (p_bl.base ⁻¹' ({x : PrimeSpectrum B |
            (g_B.base x).asIdeal = IsLocalRing.maximalIdeal ↥R} \ {σ_loc.base q_max}))
        IsClosed E_loc ∧ IsIrreducible E_loc ∧
        IsClosed S_strict ∧ IsIrreducible S_strict ∧
        E_loc ∪ S_strict = {y : ↥U_bl | (g_Ubl.base y).asIdeal = IsLocalRing.maximalIdeal ↥R} ∧
        (∃! y_nod : ↥U_bl, y_nod ∈ E_loc ∧ y_nod ∈ S_strict) ∧
        (∀ p : PrimeSpectrum (Localization.Away h_0),
          (g_Ubl.base (ι_0.base p)).asIdeal = IsLocalRing.maximalIdeal ↥R →
          ι_0.base p ∈ E_loc ∧ ι_0.base p ∉ S_strict) ∧
        (∀ p : PrimeSpectrum (Localization.Away h_1),
          (g_Ubl.base (ι_1.base p)).asIdeal = IsLocalRing.maximalIdeal ↥R →
          (ι_1.base p ∈ S_strict ↔
            algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_1)
              (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 1)) ∈ p.asIdeal) ∧
          (ι_1.base p ∈ E_loc ↔
            algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_1)
              (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 0)) ∈ p.asIdeal)))

def HasLocalNodalSubdivBlowup {K : Type u} [Field K] (R : ValuationSubring K) : Prop :=
  ∀ (π_tilde b' : ↥R),
    π_tilde ≠ 0 →
    π_tilde ∈ IsLocalRing.maximalIdeal ↥R →
    b' ≠ 0 →
    b' ∈ IsLocalRing.maximalIdeal ↥R →
    ∀ (h_e : weilNodalQuot ↥R (b' * π_tilde)),
      h_e ∉ Ideal.span {Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X 0),
            Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X 1)} ⊔
          Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))).comp MvPolynomial.C)
            (IsLocalRing.maximalIdeal ↥R) →
      let B := Localization.Away h_e
      let g_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥R) :=
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
              ((Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))).comp MvPolynomial.C) ≫
            CommRingCat.ofHom (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B))
      ∃ (Q₀_R : PrimeSpectrum ↥R)
        (U_bl : AlgebraicGeometry.Scheme.{u})
        (g_Ubl : U_bl ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
        (p_bl : U_bl ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
        (σ_loc : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of B))
        (τ₀_loc τ₁_loc : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶ U_bl)
        (h_0 : weilNodalQuot ↥R π_tilde) (h_1 : weilNodalQuot ↥R b')
        (ι_0 : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_0)) ⟶ U_bl)
        (ι_1 : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_1)) ⟶ U_bl)
        (ψ_0 : B →+* Localization.Away h_0)
        (ψ_1 : B →+* Localization.Away h_1),
        Q₀_R.asIdeal ≠ ⊥ ∧
        π_tilde ∈ Q₀_R.asIdeal ∧
        b' ∈ Q₀_R.asIdeal ∧
        AlgebraicGeometry.IsIntegral U_bl ∧
        p_bl ≫ g_B = g_Ubl ∧
        AlgebraicGeometry.IsProper p_bl ∧
        AlgebraicGeometry.Flat g_Ubl ∧
        AlgebraicGeometry.LocallyOfFinitePresentation g_Ubl ∧
        σ_loc ≫ g_B =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk Q₀_R.asIdeal)) ∧
        (∀ (q : PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal)) (b_idx : Fin 2),
          algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
            (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X b_idx)) ∈
            (σ_loc.base q).asIdeal) ∧
        τ₀_loc ≫ p_bl = σ_loc ∧
        τ₁_loc ≫ p_bl = σ_loc ∧
        Disjoint (Set.range τ₀_loc.base) (Set.range τ₁_loc.base) ∧
        (∃ hMod_cl : IsClosed (Set.range σ_loc.base),
          CategoryTheory.IsIso
            (p_bl ∣_ (⟨(Set.range σ_loc.base)ᶜ, hMod_cl.isOpen_compl⟩ :
              (AlgebraicGeometry.Spec (CommRingCat.of B)).Opens))) ∧
        (∃ q_gen : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)),
          g_B.base (σ_loc.base q_gen) = Q₀_R ∧
          IsIrreducible (p_bl.base ⁻¹' {σ_loc.base q_gen}) ∧
          p_bl.base ⁻¹' (Set.range σ_loc.base) = closure (p_bl.base ⁻¹' {σ_loc.base q_gen})) ∧
        h_0 ∉ Ideal.span {Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 0),
              Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 1)} ⊔
            Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde)).comp MvPolynomial.C)
              (IsLocalRing.maximalIdeal ↥R) ∧
        h_1 ∉ Ideal.span {Ideal.Quotient.mk (weilNodalIdeal ↥R b') (MvPolynomial.X 0),
              Ideal.Quotient.mk (weilNodalIdeal ↥R b') (MvPolynomial.X 1)} ⊔
            Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal ↥R b')).comp MvPolynomial.C)
              (IsLocalRing.maximalIdeal ↥R) ∧
        AlgebraicGeometry.IsOpenImmersion ι_0 ∧
        AlgebraicGeometry.IsOpenImmersion ι_1 ∧
        Set.range ι_0.base ∪ Set.range ι_1.base = Set.univ ∧
        ι_0 ≫ p_bl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0) ∧
        ι_1 ≫ p_bl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_1) ∧
        (∀ r : ↥R,
          ψ_0 (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
              (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.C r))) =
            algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_0)
              (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.C r))) ∧
        ψ_0 (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
            (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X 0))) =
          algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_0)
            (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 0)) ∧
        ψ_0 (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
            (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X 1))) =
          algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_0)
            (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde)
              (MvPolynomial.C b' * MvPolynomial.X 1)) ∧
        (∀ r : ↥R,
          ψ_1 (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
              (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.C r))) =
            algebraMap (weilNodalQuot ↥R b') (Localization.Away h_1)
              (Ideal.Quotient.mk (weilNodalIdeal ↥R b') (MvPolynomial.C r))) ∧
        ψ_1 (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
            (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X 0))) =
          algebraMap (weilNodalQuot ↥R b') (Localization.Away h_1)
            (Ideal.Quotient.mk (weilNodalIdeal ↥R b')
              (MvPolynomial.C π_tilde * MvPolynomial.X 0)) ∧
        ψ_1 (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
            (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X 1))) =
          algebraMap (weilNodalQuot ↥R b') (Localization.Away h_1)
            (Ideal.Quotient.mk (weilNodalIdeal ↥R b') (MvPolynomial.X 1)) ∧
        (∀ {F : Type u} [Field F] (φ_B : B →+* F),
          φ_B (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
            (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.C π_tilde))) ≠ 0 →
          φ_B (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
            (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.C b'))) ≠ 0 →
          φ_B (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
            (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X 0))) ≠ 0 →
          ∃ (φ_0 : Localization.Away h_0 →+* F) (φ_1 : Localization.Away h_1 →+* F),
            φ_0.comp ψ_0 = φ_B ∧
            φ_1.comp ψ_1 = φ_B ∧
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_0) ≫ ι_0 =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_1) ≫ ι_1 ∧
            φ_B (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X 0))) *
                φ_0 (algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_0)
                  (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 1))) =
              φ_B (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))
                  (MvPolynomial.C π_tilde))) ∧
            φ_B (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))
                  (MvPolynomial.C π_tilde))) *
                φ_1 (algebraMap (weilNodalQuot ↥R b') (Localization.Away h_1)
                  (Ideal.Quotient.mk (weilNodalIdeal ↥R b') (MvPolynomial.X 0))) =
              φ_B (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X 0)))) ∧
        (∃ (q_max : PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal)),
          (g_B.base (σ_loc.base q_max)).asIdeal = IsLocalRing.maximalIdeal ↥R ∧
          let E_loc : Set ↥U_bl := p_bl.base ⁻¹' {σ_loc.base q_max}
          let S_0 : Set ↥U_bl :=
            closure (p_bl.base ⁻¹' ({x : PrimeSpectrum B |
              (g_B.base x).asIdeal = IsLocalRing.maximalIdeal ↥R ∧
              algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))
                  (MvPolynomial.X 1)) ∈ x.asIdeal} \
                {σ_loc.base q_max}))
          let S_1 : Set ↥U_bl :=
            closure (p_bl.base ⁻¹' ({x : PrimeSpectrum B |
              (g_B.base x).asIdeal = IsLocalRing.maximalIdeal ↥R ∧
              algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))
                  (MvPolynomial.X 0)) ∈ x.asIdeal} \
                {σ_loc.base q_max}))
          IsClosed E_loc ∧ IsIrreducible E_loc ∧
          IsClosed S_0 ∧ IsIrreducible S_0 ∧
          IsClosed S_1 ∧ IsIrreducible S_1 ∧
          Disjoint S_0 S_1 ∧
          E_loc ∪ S_0 ∪ S_1 =
            {y : ↥U_bl | (g_Ubl.base y).asIdeal = IsLocalRing.maximalIdeal ↥R} ∧
          (∃! y_nod0 : ↥U_bl, y_nod0 ∈ E_loc ∧ y_nod0 ∈ S_0) ∧
          (∃! y_nod1 : ↥U_bl, y_nod1 ∈ E_loc ∧ y_nod1 ∈ S_1) ∧
          (∀ p : PrimeSpectrum (Localization.Away h_0),
            (g_Ubl.base (ι_0.base p)).asIdeal = IsLocalRing.maximalIdeal ↥R →
            ι_0.base p ∉ S_1 ∧
            (ι_0.base p ∈ S_0 ↔
              algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_0)
                (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 1)) ∈ p.asIdeal) ∧
            (ι_0.base p ∈ E_loc ↔
              algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_0)
                (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 0)) ∈ p.asIdeal)) ∧
          (∀ p : PrimeSpectrum (Localization.Away h_1),
            (g_Ubl.base (ι_1.base p)).asIdeal = IsLocalRing.maximalIdeal ↥R →
            ι_1.base p ∉ S_0 ∧
            (ι_1.base p ∈ E_loc ↔
              algebraMap (weilNodalQuot ↥R b') (Localization.Away h_1)
                (Ideal.Quotient.mk (weilNodalIdeal ↥R b') (MvPolynomial.X 1)) ∈ p.asIdeal) ∧
            (ι_1.base p ∈ S_1 ↔
              algebraMap (weilNodalQuot ↥R b') (Localization.Away h_1)
                (Ideal.Quotient.mk (weilNodalIdeal ↥R b') (MvPolynomial.X 0)) ∈ p.asIdeal)) ∧
          (∀ (δ_e c_tilde : ↥R),
            δ_e - c_tilde ∉ IsLocalRing.maximalIdeal ↥R →
            ∃ (h_Z : Polynomial ↥R)
              (ι_Z : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_Z)) ⟶ U_bl)
              (ψ_Z : B →+* Localization.Away h_Z),
              Polynomial.eval c_tilde h_Z ∉ IsLocalRing.maximalIdeal ↥R ∧
              IsUnit (algebraMap (Polynomial ↥R) (Localization.Away h_Z)
                (Polynomial.X - Polynomial.C δ_e)) ∧
              AlgebraicGeometry.IsOpenImmersion ι_Z ∧
              ι_Z ≫ p_bl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Z) ∧
              (∀ r : ↥R,
                ψ_Z (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                    (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))
                      (MvPolynomial.C r))) =
                  algebraMap (Polynomial ↥R) (Localization.Away h_Z) (Polynomial.C r)) ∧
              ψ_Z (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                  (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X 0))) =
                algebraMap (Polynomial ↥R) (Localization.Away h_Z)
                  (Polynomial.C π_tilde * (Polynomial.X - Polynomial.C δ_e)) ∧
              algebraMap (Polynomial ↥R) (Localization.Away h_Z)
                  (Polynomial.X - Polynomial.C δ_e) *
                ψ_Z (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                    (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))
                      (MvPolynomial.X 1))) =
                algebraMap (Polynomial ↥R) (Localization.Away h_Z) (Polynomial.C b') ∧
              (∀ {F : Type u} [Field F] (φ_B : B →+* F)
                 (φ_0 : Localization.Away h_0 →+* F),
                φ_0.comp ψ_0 = φ_B →
                φ_B (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                  (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))
                    (MvPolynomial.C π_tilde))) ≠ 0 →
                φ_B (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                  (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))
                    (MvPolynomial.X 0))) ≠ 0 →
                ∃ (φ_Z : Localization.Away h_Z →+* F),
                  φ_Z.comp ψ_Z = φ_B ∧
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Z) ≫ ι_Z =
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_0) ≫ ι_0 ∧
                  φ_B (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                      (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))
                        (MvPolynomial.C π_tilde))) *
                    (φ_Z (algebraMap (Polynomial ↥R) (Localization.Away h_Z) Polynomial.X) -
                      φ_B (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                        (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))
                          (MvPolynomial.C δ_e)))) =
                    φ_B (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) B
                      (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))
                        (MvPolynomial.X 0)))) ∧
              (∀ p : PrimeSpectrum (Localization.Away h_Z),
                (g_Ubl.base (ι_Z.base p)).asIdeal = IsLocalRing.maximalIdeal ↥R →
                ι_Z.base p ∈ E_loc ∧ ι_Z.base p ∉ S_0 ∧ ι_Z.base p ∉ S_1)))
structure WeilLineBundle (C : AlgebraicGeometry.Scheme.{u}) : Type u where
  m : ℕ
  V : Fin m → C.Opens
  hCov : (⋃ a : Fin m, (V a : Set C)) = Set.univ
  u : ∀ a b : Fin m, (↑(C.presheaf.obj (Opposite.op (V a ⊓ V b))))ˣ
  u_refl : ∀ a : Fin m, (u a a).val = 1
  u_cocycle : ∀ a b c : Fin m,
    let w₁ : V a ⊓ V b ⊓ V c ⟶ V a ⊓ V b := CategoryTheory.homOfLE inf_le_left
    let w₂ : V a ⊓ V b ⊓ V c ⟶ V b ⊓ V c :=
      CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
    let w₃ : V a ⊓ V b ⊓ V c ⟶ V a ⊓ V c :=
      CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
    (C.presheaf.map w₁.op).hom (u a b).val *
      (C.presheaf.map w₂.op).hom (u b c).val =
      (C.presheaf.map w₃.op).hom (u a c).val

def WeilPullbackLineBundle {C' C : AlgebraicGeometry.Scheme.{u}}
    (φ : C' ⟶ C) (M : WeilLineBundle C) (M' : WeilLineBundle C') : Prop :=
  ∃ (eIdx : Fin M'.m ≃ Fin M.m),
    (∀ a : Fin M'.m, M'.V a = (TopologicalSpace.Opens.map φ.base).obj (M.V (eIdx a))) ∧
    ∀ a b : Fin M'.m,
      ∀ (hEq : M'.V a ⊓ M'.V b =
          (TopologicalSpace.Opens.map φ.base).obj (M.V (eIdx a) ⊓ M.V (eIdx b))),
        (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq hEq.symm)).op).hom (M'.u a b).val =
          (φ.app (M.V (eIdx a) ⊓ M.V (eIdx b))).hom (M.u (eIdx a) (eIdx b)).val

def IsWeilTricanonicalSection {C : AlgebraicGeometry.Scheme.{u}}
    (M : WeilLineBundle C) (W : C.Opens)
    (s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (W ⊓ M.V a)))) : Prop :=
  ∀ a b : Fin M.m,
    let w₁ : W ⊓ (M.V a ⊓ M.V b) ⟶ W ⊓ M.V a :=
      CategoryTheory.homOfLE (inf_le_inf_left W inf_le_left)
    let w₂ : W ⊓ (M.V a ⊓ M.V b) ⟶ M.V a ⊓ M.V b :=
      CategoryTheory.homOfLE inf_le_right
    let w₃ : W ⊓ (M.V a ⊓ M.V b) ⟶ W ⊓ M.V b :=
      CategoryTheory.homOfLE (inf_le_inf_left W inf_le_right)
    (C.presheaf.map w₁.op).hom (s a) =
      ((C.presheaf.map w₂.op).hom (M.u a b).val) ^ 3 *
        (C.presheaf.map w₃.op).hom (s b)

def IsLineBundleProjMorphism {C : AlgebraicGeometry.Scheme.{u}}
    (M : WeilLineBundle C) (W : C.Opens)
    {A : Type u} [CommRing A] (φ_A : A →+* ↑(C.presheaf.obj (Opposite.op W)))
    (r₀ : ℕ)
    (e : Fin (r₀ + 1) → ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (W ⊓ M.V a))))
    (j : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A) :=
           MvPolynomial.gradedAlgebra
         W.toScheme ⟶
           AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A)) : Prop :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A) :=
    MvPolynomial.gradedAlgebra
  ∀ a : Fin M.m,
    ∃ (f_a : MvPolynomial (Fin (r₀ + 1)) A →+*
        ↑((W ⊓ M.V a).toScheme.presheaf.obj (Opposite.op ⊤)))
      (hf_a : Ideal.map f_a
        (HomogeneousIdeal.irrelevant
          (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A)).toIdeal = ⊤),
      (∀ c : A, f_a (MvPolynomial.C c) =
        (W ⊓ M.V a).topIso.inv.hom
          ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W ⊓ M.V a ≤ W)).op).hom (φ_A c))) ∧
      (∀ i : Fin (r₀ + 1), f_a (MvPolynomial.X i) = (W ⊓ M.V a).topIso.inv.hom (e i a)) ∧
      C.homOfLE (inf_le_left : W ⊓ M.V a ≤ W) ≫ j =
        AlgebraicGeometry.Proj.fromOfGlobalSections
          (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A) f_a hf_a

def IsGeometricFiberLogCanonical {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (M : WeilLineBundle C) : Prop :=
  ∃ (hAff : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
    (ψ_log : ∀ a : Fin M.m,
      letI : Algebra Ω ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          g.appLE ⊤ (M.V a) (fun _ _ => trivial)).hom).toAlgebra
      KaehlerDifferential Ω ↑(C.presheaf.obj (Opposite.op (M.V a))) →ₗ[↑(C.presheaf.obj (Opposite.op (M.V a)))]
        ↑(C.presheaf.obj (Opposite.op (M.V a)))),
    (∀ a b : Fin M.m,
      letI : Algebra Ω ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          g.appLE ⊤ (M.V a) (fun _ _ => trivial)).hom).toAlgebra
      letI : Algebra Ω ↑(C.presheaf.obj (Opposite.op (M.V b))) :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          g.appLE ⊤ (M.V b) (fun _ _ => trivial)).hom).toAlgebra
      letI : Algebra Ω ↑(C.presheaf.obj (Opposite.op (M.V a ⊓ M.V b))) :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          g.appLE ⊤ (M.V a ⊓ M.V b) (fun _ _ => trivial)).hom).toAlgebra
      ∃ (ψ_ov : KaehlerDifferential Ω ↑(C.presheaf.obj (Opposite.op (M.V a ⊓ M.V b))) →ₗ[↑(C.presheaf.obj (Opposite.op (M.V a ⊓ M.V b)))]
          ↑(C.presheaf.obj (Opposite.op (M.V a ⊓ M.V b)))),
        (∀ x_a : ↑(C.presheaf.obj (Opposite.op (M.V a))),
          ψ_ov (KaehlerDifferential.D Ω _
            ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : M.V a ⊓ M.V b ≤ M.V a)).op).hom x_a)) =
            (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : M.V a ⊓ M.V b ≤ M.V a)).op).hom
              (ψ_log a (KaehlerDifferential.D Ω _ x_a))) ∧
        (∀ x_b : ↑(C.presheaf.obj (Opposite.op (M.V b))),
          ψ_ov (KaehlerDifferential.D Ω _
            ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : M.V a ⊓ M.V b ≤ M.V b)).op).hom x_b)) =
            (M.u a b).val *
              (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : M.V a ⊓ M.V b ≤ M.V b)).op).hom
                (ψ_log b (KaehlerDifferential.D Ω _ x_b)))) ∧
    (∀ (a : Fin M.m) (p : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a)))),
      let y : C := (hAff a).fromSpec.base p
      ((∀ j : Fin n, y ∉ Set.range (τ j).base) →
        (∃ V_sm : C.Opens, y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g)) →
        ¬(Ideal.span (Set.range (ψ_log a)) ≤ p.asIdeal)) ∧
      ((∃ j : Fin n, y ∈ Set.range (τ j).base) →
        Ideal.map (algebraMap ↑(C.presheaf.obj (Opposite.op (M.V a)))
          (Localization.AtPrime p.asIdeal)) (Ideal.span (Set.range (ψ_log a))) =
          IsLocalRing.maximalIdeal (Localization.AtPrime p.asIdeal))) ∧
    (∀ (a : Fin M.m) (A' : Type u) [CommRing A']
        (u₀ : PrimeSpectrum A')
        (e₁ : AlgebraicGeometry.Spec (CommRingCat.of A') ⟶ (M.V a).toScheme)
        (e₂ : AlgebraicGeometry.Spec (CommRingCat.of A') ⟶
          AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) Ω ⧸
              Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))))),
      AlgebraicGeometry.Etale e₁ →
      AlgebraicGeometry.Etale e₂ →
      (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) →
      e₁ ≫ (M.V a).ι ≫ g =
        e₂ ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) →
      let φ₁ : ↑(C.presheaf.obj (Opposite.op (M.V a))) →+* A' :=
        ((M.V a).topIso.inv ≫ e₁.appTop ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A')).hom).hom
      let φ₂ : (MvPolynomial (Fin 2) Ω ⧸
          Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))) →+* A' :=
        (AlgebraicGeometry.Spec.preimage e₂).hom
      letI : Algebra Ω ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          g.appLE ⊤ (M.V a) (fun _ _ => trivial)).hom).toAlgebra
      letI : Algebra Ω A' :=
        (φ₁.comp (algebraMap Ω ↑(C.presheaf.obj (Opposite.op (M.V a))))).toAlgebra
      ∃ (ψ'_A : KaehlerDifferential Ω A' →ₗ[A'] A')
        (h_s : A') (_ : h_s ∉ u₀.asIdeal),
        (∀ b : ↑(C.presheaf.obj (Opposite.op (M.V a))),
          ψ'_A (KaehlerDifferential.D Ω A' (φ₁ b)) =
            φ₁ (ψ_log a (KaehlerDifferential.D Ω _ b))) ∧
        (∀ i : Fin 2,
          ∃ (ξ : (Localization.Away h_s)ˣ),
            algebraMap A' (Localization.Away h_s)
                (ψ'_A (KaehlerDifferential.D Ω A'
                  (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))))) =
              ξ.val * algebraMap A' (Localization.Away h_s)
                (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)))))

def HasFiberTricanonicalProperties {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (M : WeilLineBundle C) : Prop :=
  (∃ W₀ W₁ : C.Opens,
    AlgebraicGeometry.IsAffineOpen W₀ ∧ AlgebraicGeometry.IsAffineOpen W₁ ∧ W₀ ⊔ W₁ = ⊤) ∧
  (∀ c : ∀ p : Fin M.m × Fin M.m, ↑(C.presheaf.obj (Opposite.op (M.V p.1 ⊓ M.V p.2))),
    (∀ a : Fin M.m, c (a, a) = 0) →
    (∀ a b d : Fin M.m,
      let w₁ : M.V a ⊓ M.V b ⊓ M.V d ⟶ M.V a ⊓ M.V b := CategoryTheory.homOfLE inf_le_left
      let w₂ : M.V a ⊓ M.V b ⊓ M.V d ⟶ M.V b ⊓ M.V d :=
        CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
      let w₃ : M.V a ⊓ M.V b ⊓ M.V d ⟶ M.V a ⊓ M.V d :=
        CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
      (C.presheaf.map w₁.op).hom (c (a, b)) +
        ((C.presheaf.map w₁.op).hom (M.u a b).val) ^ 3 *
          (C.presheaf.map w₂.op).hom (c (b, d)) =
        (C.presheaf.map w₃.op).hom (c (a, d))) →
    ∃ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (M.V a))),
      ∀ a b : Fin M.m,
        c (a, b) =
          (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : M.V a ⊓ M.V b ≤ M.V a)).op).hom (s a) -
            (M.u a b).val ^ 3 *
              (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : M.V a ⊓ M.V b ≤ M.V b)).op).hom (s b)) ∧
  ∃ (r₀ : ℕ) (_ : 3 ≤ r₀)
    (e : Fin (r₀ + 1) → ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a)))),
    (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M ⊤ (e i)) ∧
    (∀ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))),
      IsWeilTricanonicalSection M ⊤ s →
      ∃! c : Fin (r₀ + 1) → Ω,
        ∀ a : Fin M.m,
          s a = ∑ i : Fin (r₀ + 1),
            (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M.V a ≤ ⊤)).op).hom
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ g.appTop).hom (c i)) *
              e i a) ∧
    ∀ (e' : Fin (r₀ + 1) → ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a)))),
      (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M ⊤ (e' i)) →
      (∀ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))),
        IsWeilTricanonicalSection M ⊤ s →
        ∃! c : Fin (r₀ + 1) → Ω,
          ∀ a : Fin M.m,
            s a = ∑ i : Fin (r₀ + 1),
              (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M.V a ≤ ⊤)).op).hom
                (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ g.appTop).hom (c i)) *
                e' i a) →
      ∃ (j : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) Ω) :=
               MvPolynomial.gradedAlgebra
             (⊤ : C.Opens).toScheme ⟶
               AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) Ω)),
        IsLineBundleProjMorphism M ⊤
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ g.appTop).hom r₀ e' j ∧
        AlgebraicGeometry.IsClosedImmersion j

def HasLocalFreeTricanonicalBaseChange {R : Type u} [CommRing R]
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (M : WeilLineBundle C) : Prop :=
  ∀ q : PrimeSpectrum R,
    ∃ (h : R) (_ : h ∉ q.asIdeal) (r₀ : ℕ) (_ : 3 ≤ r₀)
      (e_raw : Fin (r₀ + 1) → ∀ a : Fin M.m,
        ↑((CategoryTheory.Limits.pullback g
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap R (Localization.Away h))))).presheaf.obj
          (Opposite.op
            (⊤ ⊓ (TopologicalSpace.Opens.map
              (CategoryTheory.Limits.pullback.fst g
                (AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap R (Localization.Away h))))).base).obj (M.V a))))),
      ∀ (R' : Type u) [CommRing R'] (ψ : Localization.Away h →+* R'),
        let u_h := AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R (Localization.Away h)))
        let u' := AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (ψ.comp (algebraMap R (Localization.Away h))))
        let C' := CategoryTheory.Limits.pullback g u'
        let snd' := CategoryTheory.Limits.pullback.snd g u'
        ∀ (w' : C' ⟶ CategoryTheory.Limits.pullback g u_h),
          w' ≫ CategoryTheory.Limits.pullback.fst g u_h =
            CategoryTheory.Limits.pullback.fst g u' →
          w' ≫ CategoryTheory.Limits.pullback.snd g u_h =
            snd' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) →
          ∀ (M' : WeilLineBundle C') (eIdx : Fin M'.m ≃ Fin M.m)
            (hV : ∀ a : Fin M'.m,
              ⊤ ⊓ M'.V a =
                (TopologicalSpace.Opens.map w'.base).obj
                  (⊤ ⊓ (TopologicalSpace.Opens.map
                    (CategoryTheory.Limits.pullback.fst g u_h).base).obj (M.V (eIdx a)))),
            (∀ a b : Fin M'.m,
              ∀ hEq : M'.V a ⊓ M'.V b =
                  (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g u').base).obj
                    (M.V (eIdx a) ⊓ M.V (eIdx b)),
                (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq hEq.symm)).op).hom
                    (M'.u a b).val =
                  ((CategoryTheory.Limits.pullback.fst g u').app
                    (M.V (eIdx a) ⊓ M.V (eIdx b))).hom (M.u (eIdx a) (eIdx b)).val) →
            let e' : Fin (r₀ + 1) → ∀ a : Fin M'.m,
                ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))) :=
              fun i a =>
                (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV a))).op).hom
                  ((w'.app _).hom (e_raw i (eIdx a)))
            (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M' ⊤ (e' i)) ∧
            (∀ s' : ∀ a : Fin M'.m, ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))),
              IsWeilTricanonicalSection M' ⊤ s' →
              ∃! c : Fin (r₀ + 1) → R',
                ∀ a : Fin M'.m,
                  s' a = ∑ i : Fin (r₀ + 1),
                    (C'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M'.V a ≤ ⊤)).op).hom
                      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
                        snd'.appTop).hom (c i)) * e' i a) ∧
            ∃ (j' : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) R') :=
                      MvPolynomial.gradedAlgebra
                    (⊤ : C'.Opens).toScheme ⟶
                      AlgebraicGeometry.Proj
                        (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) R')),
              IsLineBundleProjMorphism M' ⊤
                ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫ snd'.appTop).hom
                r₀ e' j' ∧
              AlgebraicGeometry.IsClosedImmersion j'

def HasPointedCurveIsoCocycle {R : Type u} [CommRing R] {n : ℕ}
    {C₁ C₂ : AlgebraicGeometry.Scheme.{u}}
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₁))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₂))
    (M₁ : WeilLineBundle C₁) (M₂ : WeilLineBundle C₂) : Prop :=
  ∃ (α : ∀ (R' : Type u) [CommRing R'] [IsNoetherianRing R'] (ρ : R →+* R'),
        let u_ρ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)
        ∀ (φ : CategoryTheory.Limits.pullback g₁ u_ρ ≅ CategoryTheory.Limits.pullback g₂ u_ρ)
          (a : Fin M₁.m) (b : Fin M₂.m),
          (↑((CategoryTheory.Limits.pullback g₁ u_ρ).presheaf.obj (Opposite.op
            ((TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g₁ u_ρ).base).obj (M₁.V a) ⊓
              (TopologicalSpace.Opens.map
                (φ.hom ≫ CategoryTheory.Limits.pullback.fst g₂ u_ρ).base).obj (M₂.V b)))))ˣ)
    (β : ∀ (R' : Type u) [CommRing R'] [IsNoetherianRing R'] (ρ : R →+* R'),
        let u_ρ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)
        ∀ (φ : CategoryTheory.Limits.pullback g₁ u_ρ ≅ CategoryTheory.Limits.pullback g₂ u_ρ)
          (b : Fin M₂.m) (a : Fin M₁.m),
          (↑((CategoryTheory.Limits.pullback g₂ u_ρ).presheaf.obj (Opposite.op
            ((TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g₂ u_ρ).base).obj (M₂.V b) ⊓
              (TopologicalSpace.Opens.map
                (φ.inv ≫ CategoryTheory.Limits.pullback.fst g₁ u_ρ).base).obj (M₁.V a)))))ˣ),
    (∀ (R' : Type u) [CommRing R'] [IsNoetherianRing R'] (ρ : R →+* R'),
      let u_ρ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)
      let C₁' := CategoryTheory.Limits.pullback g₁ u_ρ
      let C₂' := CategoryTheory.Limits.pullback g₂ u_ρ
      let fst₁' := CategoryTheory.Limits.pullback.fst g₁ u_ρ
      let snd₁' := CategoryTheory.Limits.pullback.snd g₁ u_ρ
      let fst₂' := CategoryTheory.Limits.pullback.fst g₂ u_ρ
      let snd₂' := CategoryTheory.Limits.pullback.snd g₂ u_ρ
      ∀ (φ : C₁' ≅ C₂'),
        φ.hom ≫ snd₂' = snd₁' →
        (∀ j : Fin n, ∀ s₁ : AlgebraicGeometry.Spec (CommRingCat.of R') ⟶ C₁',
          s₁ ≫ fst₁' = u_ρ ≫ τ₁ j →
          s₁ ≫ snd₁' = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R')) →
          (s₁ ≫ φ.hom) ≫ fst₂' = u_ρ ≫ τ₂ j) →
        (∀ (a a' : Fin M₁.m) (b : Fin M₂.m),
          let W₁ : C₁'.Opens := (TopologicalSpace.Opens.map fst₁'.base).obj (M₁.V a) ⊓
            (TopologicalSpace.Opens.map (φ.hom ≫ fst₂').base).obj (M₂.V b)
          let W₂ : C₁'.Opens := (TopologicalSpace.Opens.map fst₁'.base).obj (M₁.V a') ⊓
            (TopologicalSpace.Opens.map (φ.hom ≫ fst₂').base).obj (M₂.V b)
          let h_u : W₁ ⊓ W₂ ≤ (TopologicalSpace.Opens.map fst₁'.base).obj (M₁.V a ⊓ M₁.V a') :=
            inf_le_inf inf_le_left inf_le_left
          (C₁'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op).hom
              (α R' ρ φ a b).val =
            (C₁'.presheaf.map (CategoryTheory.homOfLE h_u).op).hom
              ((fst₁'.app (M₁.V a ⊓ M₁.V a')).hom (M₁.u a a').val) *
              (C₁'.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op).hom
                (α R' ρ φ a' b).val) ∧
        (∀ (a : Fin M₁.m) (b b' : Fin M₂.m),
          let W₁ : C₁'.Opens := (TopologicalSpace.Opens.map fst₁'.base).obj (M₁.V a) ⊓
            (TopologicalSpace.Opens.map (φ.hom ≫ fst₂').base).obj (M₂.V b)
          let W₂ : C₁'.Opens := (TopologicalSpace.Opens.map fst₁'.base).obj (M₁.V a) ⊓
            (TopologicalSpace.Opens.map (φ.hom ≫ fst₂').base).obj (M₂.V b')
          let h_u : W₁ ⊓ W₂ ≤
              (TopologicalSpace.Opens.map (φ.hom ≫ fst₂').base).obj (M₂.V b ⊓ M₂.V b') :=
            inf_le_inf inf_le_right inf_le_right
          (C₁'.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op).hom
              (α R' ρ φ a b').val =
            (C₁'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op).hom
              (α R' ρ φ a b).val *
              (C₁'.presheaf.map (CategoryTheory.homOfLE h_u).op).hom
                (((φ.hom ≫ fst₂').app (M₂.V b ⊓ M₂.V b')).hom (M₂.u b b').val)) ∧
        (∀ (b b' : Fin M₂.m) (a : Fin M₁.m),
          let W₁ : C₂'.Opens := (TopologicalSpace.Opens.map fst₂'.base).obj (M₂.V b) ⊓
            (TopologicalSpace.Opens.map (φ.inv ≫ fst₁').base).obj (M₁.V a)
          let W₂ : C₂'.Opens := (TopologicalSpace.Opens.map fst₂'.base).obj (M₂.V b') ⊓
            (TopologicalSpace.Opens.map (φ.inv ≫ fst₁').base).obj (M₁.V a)
          let h_u : W₁ ⊓ W₂ ≤ (TopologicalSpace.Opens.map fst₂'.base).obj (M₂.V b ⊓ M₂.V b') :=
            inf_le_inf inf_le_left inf_le_left
          (C₂'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op).hom
              (β R' ρ φ b a).val =
            (C₂'.presheaf.map (CategoryTheory.homOfLE h_u).op).hom
              ((fst₂'.app (M₂.V b ⊓ M₂.V b')).hom (M₂.u b b').val) *
              (C₂'.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op).hom
                (β R' ρ φ b' a).val) ∧
        (∀ (b : Fin M₂.m) (a a' : Fin M₁.m),
          let W₁ : C₂'.Opens := (TopologicalSpace.Opens.map fst₂'.base).obj (M₂.V b) ⊓
            (TopologicalSpace.Opens.map (φ.inv ≫ fst₁').base).obj (M₁.V a)
          let W₂ : C₂'.Opens := (TopologicalSpace.Opens.map fst₂'.base).obj (M₂.V b) ⊓
            (TopologicalSpace.Opens.map (φ.inv ≫ fst₁').base).obj (M₁.V a')
          let h_u : W₁ ⊓ W₂ ≤
              (TopologicalSpace.Opens.map (φ.inv ≫ fst₁').base).obj (M₁.V a ⊓ M₁.V a') :=
            inf_le_inf inf_le_right inf_le_right
          (C₂'.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op).hom
              (β R' ρ φ b a').val =
            (C₂'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op).hom
              (β R' ρ φ b a).val *
              (C₂'.presheaf.map (CategoryTheory.homOfLE h_u).op).hom
                (((φ.inv ≫ fst₁').app (M₁.V a ⊓ M₁.V a')).hom (M₁.u a a').val)) ∧
        (∀ (a : Fin M₁.m) (b : Fin M₂.m)
            (h_ab : (TopologicalSpace.Opens.map fst₁'.base).obj (M₁.V a) ⊓
                (TopologicalSpace.Opens.map (φ.hom ≫ fst₂').base).obj (M₂.V b) ≤
              (TopologicalSpace.Opens.map φ.hom.base).obj
                ((TopologicalSpace.Opens.map fst₂'.base).obj (M₂.V b) ⊓
                  (TopologicalSpace.Opens.map (φ.inv ≫ fst₁').base).obj (M₁.V a))),
          (α R' ρ φ a b).val *
            (C₁'.presheaf.map (CategoryTheory.homOfLE h_ab).op).hom
              ((φ.hom.app _).hom (β R' ρ φ b a).val) = 1) ∧
        (∀ (b : Fin M₂.m) (a : Fin M₁.m)
            (h_ba : (TopologicalSpace.Opens.map fst₂'.base).obj (M₂.V b) ⊓
                (TopologicalSpace.Opens.map (φ.inv ≫ fst₁').base).obj (M₁.V a) ≤
              (TopologicalSpace.Opens.map φ.inv.base).obj
                ((TopologicalSpace.Opens.map fst₁'.base).obj (M₁.V a) ⊓
                  (TopologicalSpace.Opens.map (φ.hom ≫ fst₂').base).obj (M₂.V b))),
          (β R' ρ φ b a).val *
            (C₂'.presheaf.map (CategoryTheory.homOfLE h_ba).op).hom
              ((φ.inv.app _).hom (α R' ρ φ a b).val) = 1)) ∧
    (∀ (R' R'' : Type u) [CommRing R'] [IsNoetherianRing R'] [CommRing R''] [IsNoetherianRing R'']
        (ρ' : R →+* R') (ρ'' : R →+* R'') (ψ : R' →+* R''),
      ψ.comp ρ' = ρ'' →
      let u' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ')
      let u'' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ'')
      let C₁' := CategoryTheory.Limits.pullback g₁ u'
      let C₂' := CategoryTheory.Limits.pullback g₂ u'
      let C₁'' := CategoryTheory.Limits.pullback g₁ u''
      let C₂'' := CategoryTheory.Limits.pullback g₂ u''
      ∀ (φ' : C₁' ≅ C₂') (φ'' : C₁'' ≅ C₂'')
        (w₁ : C₁'' ⟶ C₁') (w₂ : C₂'' ⟶ C₂'),
        φ'.hom ≫ CategoryTheory.Limits.pullback.snd g₂ u' =
          CategoryTheory.Limits.pullback.snd g₁ u' →
        (∀ j : Fin n, ∀ s₁ : AlgebraicGeometry.Spec (CommRingCat.of R') ⟶ C₁',
          s₁ ≫ CategoryTheory.Limits.pullback.fst g₁ u' = u' ≫ τ₁ j →
          s₁ ≫ CategoryTheory.Limits.pullback.snd g₁ u' =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R')) →
          (s₁ ≫ φ'.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ u' = u' ≫ τ₂ j) →
        φ''.hom ≫ CategoryTheory.Limits.pullback.snd g₂ u'' =
          CategoryTheory.Limits.pullback.snd g₁ u'' →
        (∀ j : Fin n, ∀ s₁ : AlgebraicGeometry.Spec (CommRingCat.of R'') ⟶ C₁'',
          s₁ ≫ CategoryTheory.Limits.pullback.fst g₁ u'' = u'' ≫ τ₁ j →
          s₁ ≫ CategoryTheory.Limits.pullback.snd g₁ u'' =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R'')) →
          (s₁ ≫ φ''.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ u'' = u'' ≫ τ₂ j) →
        w₁ ≫ CategoryTheory.Limits.pullback.fst g₁ u' =
          CategoryTheory.Limits.pullback.fst g₁ u'' →
        w₁ ≫ CategoryTheory.Limits.pullback.snd g₁ u' =
          CategoryTheory.Limits.pullback.snd g₁ u'' ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) →
        w₂ ≫ CategoryTheory.Limits.pullback.fst g₂ u' =
          CategoryTheory.Limits.pullback.fst g₂ u'' →
        w₂ ≫ CategoryTheory.Limits.pullback.snd g₂ u' =
          CategoryTheory.Limits.pullback.snd g₂ u'' ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) →
        w₁ ≫ φ'.hom = φ''.hom ≫ w₂ →
        ∀ (a : Fin M₁.m) (b : Fin M₂.m)
          (h_w : (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g₁ u'').base).obj (M₁.V a) ⊓
              (TopologicalSpace.Opens.map
                (φ''.hom ≫ CategoryTheory.Limits.pullback.fst g₂ u'').base).obj (M₂.V b) ≤
            (TopologicalSpace.Opens.map w₁.base).obj
              ((TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g₁ u').base).obj (M₁.V a) ⊓
                (TopologicalSpace.Opens.map
                  (φ'.hom ≫ CategoryTheory.Limits.pullback.fst g₂ u').base).obj (M₂.V b))),
          (α R'' ρ'' φ'' a b).val =
            (C₁''.presheaf.map (CategoryTheory.homOfLE h_w).op).hom
              ((w₁.app _).hom (α R' ρ' φ' a b).val))
def IsEtaleSubringCoverOverValuation {K : Type u} [Field K] (V : ValuationSubring K)
    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (N : ℕ) (B : Finset (Fin (N + 1)) → Subring F)
    (r_a : Fin (N + 1) → ℕ)
    (P_a : ∀ a : Fin (N + 1), Fin (r_a a) → Ideal ↥V)
    (ρ_a : ∀ (a : Fin (N + 1)) (j : Fin (r_a a)), ↥(B {a}) →+* (↥V ⧸ P_a a j)) : Prop :=
  Function.Injective φ_VF ∧
  (∀ (S : Finset (Fin (N + 1))), S.Nonempty →
    (∀ v : ↥V, φ_VF v ∈ B S) ∧
    B S = Subring.closure (⋃ a ∈ S, (B {a} : Set F)) ∧
    ∀ a ∈ S,
      ∃ (r : ℕ) (f γ : Fin r → F),
        (∀ i : Fin r, f i ∈ B {a} ∧ γ i ∈ B S) ∧
        (∑ i : Fin r, γ i * f i) = 1 ∧
        ∀ (i : Fin r), ∀ z ∈ B S, ∃ n : ℕ, (f i) ^ n * z ∈ B {a}) ∧
  (∀ a : Fin (N + 1),
    ((∃ θ : Polynomial ↥V →+* ↥(B {a}),
        Function.Injective θ ∧ θ.Etale ∧ ∀ v : ↥V, (θ (Polynomial.C v) : F) = φ_VF v) ∨
     (∃ (α : ↥V) (θ : (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C α}) →+* ↥(B {a})),
        α ≠ 0 ∧ Function.Injective θ ∧ θ.Etale ∧
        ∀ v : ↥V, (θ (Ideal.Quotient.mk _ (MvPolynomial.C v)) : F) = φ_VF v)) ∧
    ∀ (j : Fin (r_a a)) (v : ↥V) (hv : φ_VF v ∈ B {a}),
      ρ_a a j ⟨φ_VF v, hv⟩ = Ideal.Quotient.mk (P_a a j) v)

def IsTwoChartPencilSubringSystem {K : Type u} [Field K] (V : ValuationSubring K)
    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (R_t0 R_t1 : Subring F) (t₀ s₁ : F)
    (d₀ : ℕ) (gen₀ : Fin d₀ → F)
    (d₁ : ℕ) (gen₁ : Fin d₁ → F) : Prop :=
  t₀ ∈ R_t0 ∧
  s₁ ∈ R_t1 ∧
  t₀ * s₁ = 1 ∧
  (∀ v : ↥V, φ_VF v ∈ R_t0 ∧ φ_VF v ∈ R_t1) ∧
  (∀ μ : Fin d₀, gen₀ μ ∈ R_t0) ∧
  (∀ ν : Fin d₁, gen₁ ν ∈ R_t1) ∧
  (∀ w ∈ R_t0, ∃ P : Fin d₀ → Polynomial ↥V,
    w = ∑ μ : Fin d₀, Polynomial.eval₂ φ_VF t₀ (P μ) * gen₀ μ) ∧
  (∀ w ∈ R_t1, ∃ P : Fin d₁ → Polynomial ↥V,
    w = ∑ ν : Fin d₁, Polynomial.eval₂ φ_VF s₁ (P ν) * gen₁ ν)
def IsRegularSimpleNodalSurface (Ω : Type u) [Field Ω] (n : ℕ)
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C)) : Prop :=
  let η_K := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
  AlgebraicGeometry.IsIntegral C ∧
  AlgebraicGeometry.Flat g ∧
  AlgebraicGeometry.IsProper g ∧
  AlgebraicGeometry.LocallyOfFinitePresentation g ∧
  AlgebraicGeometry.Surjective g ∧
  AlgebraicGeometry.SmoothOfRelativeDimension 1 (CategoryTheory.Limits.pullback.snd g η_K) ∧
  (∀ j : Fin n, τ j ≫ g = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))) ∧
  (_root_.Pairwise fun i j : Fin n =>
    Disjoint (Set.range (τ i).base) (Set.range (τ j).base)) ∧
  (∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω))),
    ∃ V : C.Opens, (τ j).base b ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)) ∧
  (∀ x : C,
    (∃ V : C.Opens,
      x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)) ∨
    (∃ (A' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec A')
        (e_C : AlgebraicGeometry.Spec A' ⟶ C)
        (q : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C PowerSeries.X}))),
      AlgebraicGeometry.Etale e_C ∧
      AlgebraicGeometry.Etale q ∧
      e_C.base v₀ = x ∧
      (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (q.base v₀).asIdeal) ∧
      Ideal.Quotient.mk _ (MvPolynomial.C PowerSeries.X) ∈ (q.base v₀).asIdeal ∧
      e_C ≫ g =
        q ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))))

def IsTwoBridgeRationalComponent (Ω : Type u) [Field Ω] (n : ℕ)
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C))
    (E : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))) : Prop :=
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s_Ω) ∧
  (∃ (E_sch : AlgebraicGeometry.Scheme.{u})
      (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g s_Ω)
      (isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left),
    AlgebraicGeometry.IsClosedImmersion ιE ∧
    AlgebraicGeometry.IsIntegral E_sch ∧
    Set.range ιE.base = E ∧
    ιE ≫ CategoryTheory.Limits.pullback.snd g s_Ω =
      isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) ∧
  (∀ q ∈ E, ∀ j : Fin n,
    (CategoryTheory.Limits.pullback.fst g s_Ω).base q ∉ Set.range (τ j).base) ∧
  ∃ q₁ q₂ : ↥(CategoryTheory.Limits.pullback g s_Ω),
    q₁ ≠ q₂ ∧ q₁ ∈ E ∧ q₂ ∈ E ∧
    (∃ E₁ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s_Ω),
      E₁ ≠ E ∧ q₁ ∈ E₁) ∧
    (∃ E₂ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s_Ω),
      E₂ ≠ E ∧ q₂ ∈ E₂) ∧
    (∀ q ∈ E,
      (∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s_Ω),
        E' ≠ E ∧ q ∈ E') → q = q₁ ∨ q = q₂)

def IsRegularSimpleNodalPointedModel (Ω : Type u) [Field Ω] (n : ℕ)
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C)) : Prop :=
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  3 ≤ n ∧
  IsRegularSimpleNodalSurface Ω n g τ ∧
  ConnectedSpace ↥(CategoryTheory.Limits.pullback g s_Ω) ∧
  (∀ (E : Set ↥(CategoryTheory.Limits.pullback g s_Ω))
      (E_sch : AlgebraicGeometry.Scheme.{u})
      (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g s_Ω),
    E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s_Ω) →
    AlgebraicGeometry.IsClosedImmersion ιE →
    AlgebraicGeometry.IsIntegral E_sch →
    Set.range ιE.base = E →
    (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left,
      ιE ≫ CategoryTheory.Limits.pullback.snd g s_Ω =
        isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) →
    IsTwoBridgeRationalComponent Ω n g τ E ∨
    (∃ q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback g s_Ω),
      q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
      q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
      (∀ q ∈ ({q₁, q₂, q₃} : Set ↥(CategoryTheory.Limits.pullback g s_Ω)),
        (∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s_Ω),
          E' ≠ E ∧ q ∈ E') ∨
        (∃ j : Fin n,
          (CategoryTheory.Limits.pullback.fst g s_Ω).base q ∈ Set.range (τ j).base))))

def IsPowerSeriesNodeResolution (Ω : Type u) [Field Ω] (n : ℕ)
    {C C_res : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C))
    (g_res : C_res ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_res : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C_res))
    (q_res : C_res ⟶ C) : Prop :=
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  let η_K := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
  IsRegularSimpleNodalPointedModel Ω n g_res τ_res ∧
  q_res ≫ g = g_res ∧
  (∀ j : Fin n, τ_res j ≫ q_res = τ j) ∧
  AlgebraicGeometry.IsProper q_res ∧
  AlgebraicGeometry.Surjective q_res ∧
  (∀ (v₁ : CategoryTheory.Limits.pullback g_res η_K ⟶ CategoryTheory.Limits.pullback g η_K),
    v₁ ≫ CategoryTheory.Limits.pullback.fst g η_K =
      CategoryTheory.Limits.pullback.fst g_res η_K ≫ q_res →
    v₁ ≫ CategoryTheory.Limits.pullback.snd g η_K =
      CategoryTheory.Limits.pullback.snd g_res η_K →
    CategoryTheory.IsIso v₁) ∧
  (∀ U : C.Opens, CategoryTheory.IsIso (q_res.app U)) ∧
  (∀ x : C, _root_.IsConnected (q_res.base ⁻¹' {x})) ∧
  (∀ x : C, ¬(q_res.base ⁻¹' {x}).Subsingleton →
    ∀ z ∈ q_res.base ⁻¹' {x},
      ∃ q₀ : ↥(CategoryTheory.Limits.pullback g_res s_Ω),
        (CategoryTheory.Limits.pullback.fst g_res s_Ω).base q₀ = z ∧
        ∃ E : Set ↥(CategoryTheory.Limits.pullback g_res s_Ω),
          IsTwoBridgeRationalComponent Ω n g_res τ_res E ∧ q₀ ∈ E) ∧
  (∀ E : Set ↥(CategoryTheory.Limits.pullback g_res s_Ω),
    IsTwoBridgeRationalComponent Ω n g_res τ_res E →
    ((fun q => q_res.base ((CategoryTheory.Limits.pullback.fst g_res s_Ω).base q)) '' E).Subsingleton)
noncomputable def weilPointEvalRingHom {Ω : Type u} [CommRing Ω]
    {X : AlgebraicGeometry.Scheme.{u}}
    (ι : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X)
    (U : X.Opens)
    (hU : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
      (TopologicalSpace.Opens.map ι.base).obj U) :
    ↑(X.presheaf.obj (Opposite.op U)) →+* Ω :=
  (ι.appLE U ⊤ hU ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom).hom

def IsNodalCurveLogNormalizationPackage {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (M : WeilLineBundle C)
    (c δ : ℕ)
    (E_set : Fin (c + 1) → Set C)
    (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
    (p_norm : ∀ α : Fin (c + 1), E_norm α ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
    (F : Fin (c + 1) → Type u)
    [∀ α : Fin (c + 1), Field (F α)]
    [∀ α : Fin (c + 1), Algebra Ω (F α)]
    (η_F : ∀ α : Fin (c + 1), AlgebraicGeometry.Spec (CommRingCat.of (F α)) ⟶ E_norm α)
    (z_node : Fin δ → C)
    (α₀ : Fin δ → Fin (c + 1)) (P₀ : ∀ r : Fin δ, E_norm (α₀ r))
    (α₁ : Fin δ → Fin (c + 1)) (P₁ : ∀ r : Fin δ, E_norm (α₁ r)) : Prop :=
  (Function.Injective E_set ∧
    Set.range E_set = irreducibleComponents ↥C ∧
    (⋃ α : Fin (c + 1), E_set α) = Set.univ) ∧
  (∀ α : Fin (c + 1),
    AlgebraicGeometry.IsIntegral (E_norm α) ∧
    AlgebraicGeometry.IsProper (p_norm α) ∧
    AlgebraicGeometry.SmoothOfRelativeDimension 1 (p_norm α) ∧
    AlgebraicGeometry.IsFinite (ν α) ∧
    ν α ≫ g = p_norm α ∧
    Set.range (ν α).base = E_set α ∧
    (∀ P : E_norm α, IsClosed ({P} : Set (E_norm α)) ↔ IsClosed ({(ν α).base P} : Set C)) ∧
    η_F α ≫ p_norm α = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω (F α))) ∧
    IsSchemeFunctionField (E_norm α) (F α) (η_F α)) ∧
  (∀ α : Fin (c + 1),
    (∀ r : Fin δ, ¬(α₀ r = α ∧ α₁ r = α)) → AlgebraicGeometry.IsClosedImmersion (ν α)) ∧
  (Function.Injective z_node ∧
    (∀ r : Fin δ,
      IsClosed ({z_node r} : Set C) ∧
      IsClosed ({P₀ r} : Set (E_norm (α₀ r))) ∧
      IsClosed ({P₁ r} : Set (E_norm (α₁ r))) ∧
      (ν (α₀ r)).base (P₀ r) = z_node r ∧
      (ν (α₁ r)).base (P₁ r) = z_node r ∧
      (⟨α₀ r, P₀ r⟩ : Σ α : Fin (c + 1), E_norm α) ≠ ⟨α₁ r, P₁ r⟩ ∧
      (∀ (α : Fin (c + 1)) (P : E_norm α),
        (ν α).base P = z_node r →
        (⟨α, P⟩ : Σ β : Fin (c + 1), E_norm β) = ⟨α₀ r, P₀ r⟩ ∨
          (⟨α, P⟩ : Σ β : Fin (c + 1), E_norm β) = ⟨α₁ r, P₁ r⟩)) ∧
    (∀ x : C, x ∉ Set.range z_node →
      (∃ V : C.Opens, x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)) ∧
      ∃! pair : Σ α : Fin (c + 1), E_norm α, (ν pair.1).base pair.2 = x) ∧
    (∀ α β : Fin (c + 1), α ≠ β → E_set α ∩ E_set β ⊆ Set.range z_node) ∧
    (∀ j : Fin n, ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
      IsClosed ({(τ j).base q} : Set C) ∧ (τ j).base q ∉ Set.range z_node)) ∧
  (∀ (U : C.Opens) (s₁ s₂ : ↑(C.presheaf.obj (Opposite.op U))),
    (∀ α : Fin (c + 1), ((ν α).app U).hom s₁ = ((ν α).app U).hom s₂) → s₁ = s₂) ∧
  ∃ (hAff : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
    (hAffW : ∀ (α : Fin (c + 1)) (a : Fin M.m),
      AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)))
    (hAffW_ov : ∀ (α : Fin (c + 1)) (a b : Fin M.m),
      AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a ⊓ M.V b)))
    (pt_C : ∀ (x : C), IsClosed ({x} : Set C) →
      (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (pt_E : ∀ (α : Fin (c + 1)) (P : E_norm α), IsClosed ({P} : Set (E_norm α)) →
      (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E_norm α)),
    (∀ (x : C) (hx : IsClosed ({x} : Set C)),
      pt_C x hx ≫ g = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ∧
      (∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), (pt_C x hx).base q = x) ∧
      ∀ (a : Fin M.m) (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a))))
        (h_in : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
          (TopologicalSpace.Opens.map (pt_C x hx).base).obj (M.V a)),
        (hAff a).fromSpec.base p_x = x →
        RingHom.ker (weilPointEvalRingHom (pt_C x hx) (M.V a) h_in) = p_x.asIdeal) ∧
    (∀ (α : Fin (c + 1)) (P : E_norm α) (hP : IsClosed ({P} : Set (E_norm α))),
      pt_E α P hP ≫ p_norm α = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ∧
      (∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), (pt_E α P hP).base q = P) ∧
      (∀ hx : IsClosed ({(ν α).base P} : Set C), pt_E α P hP ≫ ν α = pt_C ((ν α).base P) hx) ∧
      ∀ (W : (E_norm α).Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
        (p_P : PrimeSpectrum ↑((E_norm α).presheaf.obj (Opposite.op W)))
        (h_in : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
          (TopologicalSpace.Opens.map (pt_E α P hP).base).obj W),
        hW.fromSpec.base p_P = P →
        RingHom.ker (weilPointEvalRingHom (pt_E α P hP) W h_in) = p_P.asIdeal) ∧
    (∀ (a : Fin M.m)
        (s_tilde : ∀ α : Fin (c + 1),
          ↑((E_norm α).presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a))))),
      (∀ (r : Fin δ), z_node r ∈ M.V a →
        ∀ (hP₀ : IsClosed ({P₀ r} : Set (E_norm (α₀ r))))
          (hP₁ : IsClosed ({P₁ r} : Set (E_norm (α₁ r))))
          (h_in₀ : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
            (TopologicalSpace.Opens.map (pt_E (α₀ r) (P₀ r) hP₀).base).obj
              ((TopologicalSpace.Opens.map (ν (α₀ r)).base).obj (M.V a)))
          (h_in₁ : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
            (TopologicalSpace.Opens.map (pt_E (α₁ r) (P₁ r) hP₁).base).obj
              ((TopologicalSpace.Opens.map (ν (α₁ r)).base).obj (M.V a))),
          weilPointEvalRingHom (pt_E (α₀ r) (P₀ r) hP₀) _ h_in₀ (s_tilde (α₀ r)) =
            weilPointEvalRingHom (pt_E (α₁ r) (P₁ r) hP₁) _ h_in₁ (s_tilde (α₁ r))) →
      ∃ s : ↑(C.presheaf.obj (Opposite.op (M.V a))),
        ∀ α : Fin (c + 1), ((ν α).app (M.V a)).hom s = s_tilde α) ∧
    (∀ (a : Fin M.m)
        (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a))))
        (α : Fin (c + 1))
        (p_P : PrimeSpectrum ↑((E_norm α).presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)))))
        (b : ↑(C.presheaf.obj (Opposite.op (M.V a)))),
      let x : C := (hAff a).fromSpec.base p_x
      IsClosed ({x} : Set C) →
      x ∉ Set.range z_node →
      (ν α).base ((hAffW α a).fromSpec.base p_P) = x →
      ((ν α).app (M.V a)).hom b ∈ p_P.asIdeal →
      ((ν α).app (M.V a)).hom b ∉ p_P.asIdeal ^ 2 →
      b ∈ p_x.asIdeal ∧
        IsLocalRing.maximalIdeal (Localization.AtPrime p_x.asIdeal) ≤
          Ideal.span ({algebraMap _ (Localization.AtPrime p_x.asIdeal) b} :
              Set (Localization.AtPrime p_x.asIdeal)) ⊔
            (IsLocalRing.maximalIdeal (Localization.AtPrime p_x.asIdeal)) ^ 2) ∧
    (∀ (a : Fin M.m)
        (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a))))
        (r : Fin δ)
        (p₀ : PrimeSpectrum ↑((E_norm (α₀ r)).presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map (ν (α₀ r)).base).obj (M.V a)))))
        (p₁ : PrimeSpectrum ↑((E_norm (α₁ r)).presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map (ν (α₁ r)).base).obj (M.V a)))))
        (b₀ b₁ : ↑(C.presheaf.obj (Opposite.op (M.V a)))),
      (hAff a).fromSpec.base p_x = z_node r →
      (hAffW (α₀ r) a).fromSpec.base p₀ = P₀ r →
      (hAffW (α₁ r) a).fromSpec.base p₁ = P₁ r →
      ((ν (α₀ r)).app (M.V a)).hom b₀ ∈ p₀.asIdeal →
      ((ν (α₀ r)).app (M.V a)).hom b₀ ∉ p₀.asIdeal ^ 2 →
      ((ν (α₁ r)).app (M.V a)).hom b₀ ∈ p₁.asIdeal ^ 2 →
      ((ν (α₀ r)).app (M.V a)).hom b₁ ∈ p₀.asIdeal ^ 2 →
      ((ν (α₁ r)).app (M.V a)).hom b₁ ∈ p₁.asIdeal →
      ((ν (α₁ r)).app (M.V a)).hom b₁ ∉ p₁.asIdeal ^ 2 →
      b₀ ∈ p_x.asIdeal ∧
        b₁ ∈ p_x.asIdeal ∧
        IsLocalRing.maximalIdeal (Localization.AtPrime p_x.asIdeal) ≤
          Ideal.span ({algebraMap _ (Localization.AtPrime p_x.asIdeal) b₀,
              algebraMap _ (Localization.AtPrime p_x.asIdeal) b₁} :
              Set (Localization.AtPrime p_x.asIdeal)) ⊔
            (IsLocalRing.maximalIdeal (Localization.AtPrime p_x.asIdeal)) ^ 2) ∧
    ∃ (Ψ_log : ∀ (α : Fin (c + 1)) (a : Fin M.m),
        Nonempty ↥((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)) →
        (KaehlerDifferential Ω (F α) →ₗ[F α] F α)),
      (∀ (α : Fin (c + 1)) (a b : Fin M.m)
          (ha : Nonempty ↥((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)))
          (hb : Nonempty ↥((TopologicalSpace.Opens.map (ν α).base).obj (M.V b)))
          (φ_ab : (E_norm α).presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a ⊓ M.V b))) ⟶
              CommRingCat.of (F α)),
        AlgebraicGeometry.Spec.map φ_ab ≫ (hAffW_ov α a b).fromSpec = η_F α →
        ∀ ω : KaehlerDifferential Ω (F α),
          Ψ_log α a ha ω =
            φ_ab.hom (((ν α).app (M.V a ⊓ M.V b)).hom (M.u a b).val) * Ψ_log α b hb ω) ∧
      (∀ (α : Fin (c + 1)) (a : Fin M.m)
          (ha : Nonempty ↥((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)))
          (φ_a : (E_norm α).presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a))) ⟶
              CommRingCat.of (F α)),
        AlgebraicGeometry.Spec.map φ_a ≫ (hAffW α a).fromSpec = η_F α →
        ∀ (p_P : PrimeSpectrum ↑((E_norm α).presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)))))
          (t_P : ↑((E_norm α).presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a))))),
          let P : E_norm α := (hAffW α a).fromSpec.base p_P
          IsClosed ({P} : Set (E_norm α)) →
          t_P ∈ p_P.asIdeal →
          t_P ∉ p_P.asIdeal ^ 2 →
          (((ν α).base P ∉ Set.range z_node ∧
              ∀ j : Fin n, (ν α).base P ∉ Set.range (τ j).base) →
            ∃ a_num b_den : ↑((E_norm α).presheaf.obj
                (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)))),
              a_num ∉ p_P.asIdeal ∧ b_den ∉ p_P.asIdeal ∧
              φ_a.hom b_den * Ψ_log α a ha (KaehlerDifferential.D Ω (F α) (φ_a.hom t_P)) =
                φ_a.hom a_num) ∧
          (((ν α).base P ∈ Set.range z_node ∨
              ∃ j : Fin n, (ν α).base P ∈ Set.range (τ j).base) →
            ∃ a_num b_den : ↑((E_norm α).presheaf.obj
                (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)))),
              a_num ∉ p_P.asIdeal ∧ b_den ∉ p_P.asIdeal ∧
              φ_a.hom b_den * Ψ_log α a ha (KaehlerDifferential.D Ω (F α) (φ_a.hom t_P)) =
                φ_a.hom a_num * φ_a.hom t_P))

def HasSmoothCurveRiemannRochPackage (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (E_sm : AlgebraicGeometry.Scheme.{u})
    (p_sm : E_sm ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (F : Type u) [Field F] [Algebra Ω F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ E_sm) : Prop :=
  Set.Infinite {P : E_sm | IsClosed ({P} : Set E_sm)} ∧
  (∀ S : Set E_sm, IsClosed S → S ≠ Set.univ →
    S.Finite ∧ ∀ P ∈ S, IsClosed ({P} : Set E_sm)) ∧
  ∃ (ord : E_sm → F → WithTop ℤ)
    (g_E : ℕ)
    (x_sep : F)
    (K_div : E_sm → ℤ),
    (∀ P : E_sm, IsClosed ({P} : Set E_sm) →
      (∀ f : F, ord P f = ⊤ ↔ f = 0) ∧
      (∀ x y : F, ord P (x * y) = ord P x + ord P y) ∧
      (∀ x y : F, min (ord P x) (ord P y) ≤ ord P (x + y)) ∧
      (∀ c : Ω, c ≠ 0 → ord P (algebraMap Ω F c) = 0) ∧
      (∀ u : F, ord P u = (1 : WithTop ℤ) → KaehlerDifferential.D Ω F u ≠ 0)) ∧
    (∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
      Nonempty ↥W →
      ∀ (φ_W : E_sm.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
        AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_F →
        Function.Injective φ_W.hom ∧
        (∀ c : Ω,
          φ_W.hom
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
              p_sm.appLE ⊤ W le_top).hom c) = algebraMap Ω F c) ∧
        (∀ f : F,
          f ∈ Set.range φ_W.hom ↔
            ∀ P : E_sm, P ∈ W → IsClosed ({P} : Set E_sm) → (0 : WithTop ℤ) ≤ ord P f) ∧
        (∀ p_P : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W)),
          IsClosed ({hW.fromSpec.base p_P} : Set E_sm) →
          (∃ t_P : ↑(E_sm.presheaf.obj (Opposite.op W)),
            t_P ∈ p_P.asIdeal ∧ t_P ∉ p_P.asIdeal ^ 2) ∧
          (∀ b : ↑(E_sm.presheaf.obj (Opposite.op W)),
            b ∈ p_P.asIdeal ↔ (1 : WithTop ℤ) ≤ ord (hW.fromSpec.base p_P) (φ_W.hom b)) ∧
          (∀ b : ↑(E_sm.presheaf.obj (Opposite.op W)),
            b ∈ p_P.asIdeal ^ 2 ↔
              (2 : WithTop ℤ) ≤ ord (hW.fromSpec.base p_P) (φ_W.hom b)))) ∧
    KaehlerDifferential.D Ω F x_sep ≠ 0 ∧
    (∀ P : E_sm, ¬IsClosed ({P} : Set E_sm) → K_div P = 0) ∧
    {P : E_sm | K_div P ≠ 0}.Finite ∧
    (∑ᶠ P : E_sm, K_div P) = (2 : ℤ) * (g_E : ℤ) - 2 ∧
    (∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
      Nonempty ↥W →
      ∀ (φ_W : E_sm.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
        AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_F →
        ∀ (p_P : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W)))
          (t_P : ↑(E_sm.presheaf.obj (Opposite.op W))),
          let P : E_sm := hW.fromSpec.base p_P
          IsClosed ({P} : Set E_sm) →
          t_P ∈ p_P.asIdeal →
          t_P ∉ p_P.asIdeal ^ 2 →
          KaehlerDifferential.D Ω F (φ_W.hom t_P) ≠ 0 ∧
          ∃ δ_P : F,
            δ_P ≠ 0 ∧
            ord P δ_P = (K_div P : WithTop ℤ) ∧
            KaehlerDifferential.D Ω F x_sep = δ_P • KaehlerDifferential.D Ω F (φ_W.hom t_P)) ∧
    (g_E = 0 →
      ∃ isoP1 : E_sm ≅ (weilProjectiveSpaceOver Ω 1).left,
        isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom = p_sm) ∧
    (∀ f : F, f ≠ 0 →
      {P : E_sm | IsClosed ({P} : Set E_sm) ∧ ord P f ≠ 0}.Finite ∧
      ∃ d_f : E_sm → ℤ,
        (∀ P : E_sm, ¬IsClosed ({P} : Set E_sm) → d_f P = 0) ∧
        (∀ P : E_sm, IsClosed ({P} : Set E_sm) → ord P f = (d_f P : WithTop ℤ)) ∧
        (∑ᶠ P : E_sm, d_f P) = 0) ∧
    (∀ (D : E_sm → ℤ),
      (∀ P : E_sm, ¬IsClosed ({P} : Set E_sm) → D P = 0) →
      {P : E_sm | D P ≠ 0}.Finite →
      (2 : ℤ) * (g_E : ℤ) - 2 < (∑ᶠ P : E_sm, D P) →
      (∀ (L_D : Submodule Ω F),
        (∀ f : F, f ∈ L_D ↔
          ∀ P : E_sm, IsClosed ({P} : Set E_sm) → (-(D P) : WithTop ℤ) ≤ ord P f) →
        FiniteDimensional Ω ↥L_D ∧
          (Module.finrank Ω ↥L_D : ℤ) = (∑ᶠ P : E_sm, D P) + 1 - (g_E : ℤ)) ∧
      (∀ (m_cov : ℕ) (W_cov : Fin m_cov → E_sm.Opens),
        (∀ a : Fin m_cov, AlgebraicGeometry.IsAffineOpen (W_cov a)) →
        (⋃ a : Fin m_cov, (W_cov a : Set E_sm)) = Set.univ →
        ∀ (c_F : Fin m_cov → Fin m_cov → F),
          (∀ a : Fin m_cov, Nonempty ↥(W_cov a) → c_F a a = 0) →
          (∀ a b : Fin m_cov, Nonempty ↥(W_cov a) → Nonempty ↥(W_cov b) →
            ∀ P : E_sm, P ∈ W_cov a ⊓ W_cov b → IsClosed ({P} : Set E_sm) →
              (-(D P) : WithTop ℤ) ≤ ord P (c_F a b)) →
          (∀ a b d : Fin m_cov,
            Nonempty ↥(W_cov a) → Nonempty ↥(W_cov b) → Nonempty ↥(W_cov d) →
            c_F a b + c_F b d = c_F a d) →
          ∃ f_F : Fin m_cov → F,
            (∀ a : Fin m_cov, Nonempty ↥(W_cov a) →
              ∀ P : E_sm, P ∈ W_cov a → IsClosed ({P} : Set E_sm) →
                (-(D P) : WithTop ℤ) ≤ ord P (f_F a)) ∧
            (∀ a b : Fin m_cov, Nonempty ↥(W_cov a) → Nonempty ↥(W_cov b) →
              c_F a b = f_F a - f_F b))) ∧
    (∀ f : F, KaehlerDifferential.D Ω F f ≠ 0 →
      ∃ (U_f : E_sm.Opens) (hUf : AlgebraicGeometry.IsAffineOpen U_f),
        (U_f : Set E_sm) = {z : E_sm | ¬IsClosed ({z} : Set E_sm) ∨ (0 : WithTop ℤ) ≤ ord z f} ∧
        Nonempty ↥U_f ∧
        ∀ (φ_Uf : E_sm.presheaf.obj (Opposite.op U_f) ⟶ CommRingCat.of F),
          AlgebraicGeometry.Spec.map φ_Uf ≫ hUf.fromSpec = η_F →
          ∃ (ψ_poly : Polynomial Ω →+* ↑(E_sm.presheaf.obj (Opposite.op U_f))),
            (∀ c : Ω,
              ψ_poly (Polynomial.C c) =
                (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                  p_sm.appLE ⊤ U_f le_top).hom c)) ∧
            φ_Uf.hom (ψ_poly Polynomial.X) = f ∧
            ψ_poly.Finite)

def HasTricanonicalSeparationData (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (M : WeilLineBundle C)
    (hAff : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
    (c : ℕ)
    (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
    (p_norm : ∀ α : Fin (c + 1), E_norm α ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
    (r₀ : ℕ)
    (e' : Fin (r₀ + 1) → ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a)))) : Prop :=
  let e'_Va : Fin (r₀ + 1) → ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
    fun i a =>
      (C.presheaf.map (CategoryTheory.homOfLE (le_inf le_top (le_refl (M.V a)))).op).hom (e' i a)
  let φ_Ω_Va : ∀ a : Fin M.m, Ω →+* ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
    fun a =>
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        g.appLE ⊤ (M.V a) le_top).hom
  (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M ⊤ (e' i)) ∧
  (∀ a : Fin M.m,
    Ideal.span (Set.range fun i : Fin (r₀ + 1) => e' i a) = ⊤) ∧
  (∀ (a_x a_y : Fin M.m)
      (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a_x))))
      (p_y : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a_y)))),
    let x : C := (hAff a_x).fromSpec.base p_x
    let y : C := (hAff a_y).fromSpec.base p_y
    IsClosed ({x} : Set C) →
    IsClosed ({y} : Set C) →
    x ≠ y →
    ∃ (i k : Fin (r₀ + 1)) (v_ix v_kx v_iy v_ky : Ω),
      e'_Va i a_x - φ_Ω_Va a_x v_ix ∈ p_x.asIdeal ∧
      e'_Va k a_x - φ_Ω_Va a_x v_kx ∈ p_x.asIdeal ∧
      e'_Va i a_y - φ_Ω_Va a_y v_iy ∈ p_y.asIdeal ∧
      e'_Va k a_y - φ_Ω_Va a_y v_ky ∈ p_y.asIdeal ∧
      v_ix * v_ky ≠ v_iy * v_kx) ∧
  (∀ (a : Fin M.m)
      (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a))))
      (k : Fin (r₀ + 1))
      (he_not_mem : e'_Va k a ∉ p_x.asIdeal),
    IsClosed ({(hAff a).fromSpec.base p_x} : Set C) →
    let O_x := Localization.AtPrime p_x.asIdeal
    let m_x := IsLocalRing.maximalIdeal O_x
    ∃ c_val : Fin (r₀ + 1) → Ω,
      (∀ i : Fin (r₀ + 1),
        IsLocalization.mk' O_x (e'_Va i a) (⟨e'_Va k a, he_not_mem⟩ : p_x.asIdeal.primeCompl) -
          algebraMap _ O_x (φ_Ω_Va a (c_val i)) ∈ m_x) ∧
      m_x ≤ Ideal.span (Set.range fun i : Fin (r₀ + 1) =>
        IsLocalization.mk' O_x (e'_Va i a) (⟨e'_Va k a, he_not_mem⟩ : p_x.asIdeal.primeCompl) -
          algebraMap _ O_x (φ_Ω_Va a (c_val i))) ⊔ m_x ^ 2) ∧
  (∀ k : Fin (r₀ + 1),
    let U_k : C.Opens := ⨆ a : Fin M.m, C.basicOpen (e'_Va k a)
    ∃ (ratio : Fin (r₀ + 1) → ↑(C.presheaf.obj (Opposite.op U_k)))
      (c_lin : Fin (r₀ + 1) → Ω),
      (∀ (i : Fin (r₀ + 1)) (a : Fin M.m),
        (C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le (e'_Va k a))).op).hom
            (e'_Va k a) *
          (C.presheaf.map
              (CategoryTheory.homOfLE (le_iSup (fun b : Fin M.m => C.basicOpen (e'_Va k b)) a)).op).hom
            (ratio i) =
        (C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le (e'_Va k a))).op).hom
          (e'_Va i a)) ∧
      ∀ α : Fin (c + 1),
        let W_αk : (E_norm α).Opens := (TopologicalSpace.Opens.map (ν α).base).obj U_k
        W_αk = ⊥ ∨
          (AlgebraicGeometry.IsAffineOpen W_αk ∧
            ∃ ψ_poly : Polynomial Ω →+* ↑((E_norm α).presheaf.obj (Opposite.op W_αk)),
              (∀ d : Ω,
                ψ_poly (Polynomial.C d) =
                  (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                    (p_norm α).appLE ⊤ W_αk le_top).hom d)) ∧
              ψ_poly Polynomial.X =
                (∑ i : Fin (r₀ + 1),
                  (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                      (p_norm α).appLE ⊤ W_αk le_top).hom (c_lin i)) *
                    ((ν α).app U_k).hom (ratio i)) ∧
              ψ_poly.Finite))
abbrev WeilStrictMonoTuple (m p : ℕ) : Type :=
  { α : Fin (p + 1) → Fin m // StrictMono α }

def weilChartInter {C : AlgebraicGeometry.Scheme.{u}}
    (M : WeilLineBundle C) {p : ℕ} (α : WeilStrictMonoTuple M.m p) : C.Opens :=
  Finset.univ.inf' ⟨0, Finset.mem_univ (0 : Fin (p + 1))⟩ (fun k => M.V (α.1 k))

abbrev WeilTricanonicalCechCochain {C : AlgebraicGeometry.Scheme.{u}}
    (M : WeilLineBundle C) (p : ℕ) : Type u :=
  ∀ α : WeilStrictMonoTuple M.m p, ↑(C.presheaf.obj (Opposite.op (weilChartInter M α)))

noncomputable def weilCechSmul {R : Type u} [CommRing R]
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (M : WeilLineBundle C) (p : ℕ)
    (r : R) (c : WeilTricanonicalCechCochain M p) :
    WeilTricanonicalCechCochain M p :=
  fun α =>
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
      g.appLE ⊤ (weilChartInter M α) (fun _ _ => trivial)).hom r) * c α

noncomputable def weilTricanonicalCechDiff {C : AlgebraicGeometry.Scheme.{u}}
    (M : WeilLineBundle C) (p : ℕ)
    (c : WeilTricanonicalCechCochain M p) :
    WeilTricanonicalCechCochain M (p + 1) :=
  fun β =>
    let h01 : weilChartInter M β ≤ M.V (β.1 0) ⊓ M.V (β.1 1) :=
      le_inf (Finset.inf'_le _ (Finset.mem_univ (0 : Fin (p + 2))))
        (Finset.inf'_le _ (Finset.mem_univ (1 : Fin (p + 2))))
    let face : Fin (p + 2) → WeilStrictMonoTuple M.m p :=
      fun j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
    let hFace : ∀ j : Fin (p + 2), weilChartInter M β ≤ weilChartInter M (face j) :=
      fun j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
    ((C.presheaf.map (CategoryTheory.homOfLE h01).op).hom (M.u (β.1 0) (β.1 1)).val) ^ 3 *
      (C.presheaf.map (CategoryTheory.homOfLE (hFace 0)).op).hom (c (face 0)) +
    ∑ k : Fin (p + 1),
      (-1) ^ ((k : ℕ) + 1) *
        (C.presheaf.map (CategoryTheory.homOfLE (hFace k.succ)).op).hom (c (face k.succ))
def IsLocalLogCanonicalChart {S C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C))
    (U : S.Opens) (V : C.Opens) (k : ℕ)
    (π : MvPolynomial (Fin (k + 1)) ↑(S.presheaf.obj (Opposite.op U)) →+*
      ↑(C.presheaf.obj (Opposite.op V)))
    (F : Fin k → MvPolynomial (Fin (k + 1)) ↑(S.presheaf.obj (Opposite.op U)))
    (tag : Option (Fin n))
    (t : ↑(C.presheaf.obj (Opposite.op V))) : Prop :=
  AlgebraicGeometry.IsAffineOpen U ∧
  AlgebraicGeometry.IsAffineOpen V ∧
  ∃ (hV_le : V ≤ (TopologicalSpace.Opens.map g.base).obj U),
    π.comp MvPolynomial.C = (g.appLE U V hV_le).hom ∧
    Function.Surjective π ∧
    RingHom.ker π = Ideal.span (Set.range F) ∧
    (tag = none →
      (∀ j : Fin n, Disjoint (V : Set C) (Set.range (τ j).base)) ∧ t = 1) ∧
    (∀ j₀ : Fin n, tag = some j₀ →
      (∀ j : Fin n, j ≠ j₀ → Disjoint (V : Set C) (Set.range (τ j).base)) ∧
      (∃ hU_sec : U ≤ (TopologicalSpace.Opens.map (τ j₀).base).obj V,
        RingHom.ker (((τ j₀).appLE V U hU_sec).hom) = Ideal.span {t}) ∧
      (∀ b : ↑(C.presheaf.obj (Opposite.op V)), b * t = 0 → b = 0) ∧
      (∃ r₀ : Fin (k + 1),
        IsUnit (Matrix.det ((Matrix.of fun (i : Fin (k + 1)) (j : Fin k) =>
          π (MvPolynomial.pderiv i (F j))).submatrix r₀.succAbove id))))

def IsRelativeLogCanonicalAtlas {S C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C)) (M : WeilLineBundle C) : Prop :=
  (∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a)) ∧
  ∃ (U_base : Fin M.m → S.Opens)
    (k_lci : Fin M.m → ℕ)
    (π_lci : ∀ a : Fin M.m,
      MvPolynomial (Fin (k_lci a + 1)) ↑(S.presheaf.obj (Opposite.op (U_base a))) →+*
        ↑(C.presheaf.obj (Opposite.op (M.V a))))
    (F_lci : ∀ a : Fin M.m,
      Fin (k_lci a) → MvPolynomial (Fin (k_lci a + 1)) ↑(S.presheaf.obj (Opposite.op (U_base a))))
    (tag : Fin M.m → Option (Fin n))
    (t_mark : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (M.V a))))
    (hV_le : ∀ a : Fin M.m, M.V a ≤ (TopologicalSpace.Opens.map g.base).obj (U_base a)),
    (∀ a : Fin M.m,
      IsLocalLogCanonicalChart g n τ (U_base a) (M.V a) (k_lci a) (π_lci a) (F_lci a) (tag a) (t_mark a)) ∧
    (∀ a b : Fin M.m,
      let A_ab := ↑(S.presheaf.obj (Opposite.op (U_base a ⊓ U_base b)))
      let B_ab := ↑(C.presheaf.obj (Opposite.op (M.V a ⊓ M.V b)))
      let h_ab : M.V a ⊓ M.V b ≤ (TopologicalSpace.Opens.map g.base).obj (U_base a ⊓ U_base b) :=
        inf_le_inf (hV_le a) (hV_le b)
      letI : Algebra A_ab B_ab := (g.appLE (U_base a ⊓ U_base b) (M.V a ⊓ M.V b) h_ab).hom.toAlgebra
      ∃ (ψ_ov : KaehlerDifferential A_ab B_ab →ₗ[B_ab] B_ab),
        (∀ r : Fin (k_lci a + 1),
          ψ_ov (KaehlerDifferential.D A_ab B_ab
            ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : M.V a ⊓ M.V b ≤ M.V a)).op).hom
              (π_lci a (MvPolynomial.X r)))) =
            (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : M.V a ⊓ M.V b ≤ M.V a)).op).hom
              (t_mark a * (-1) ^ (r : ℕ) *
                Matrix.det ((Matrix.of fun (i : Fin (k_lci a + 1)) (j : Fin (k_lci a)) =>
                  π_lci a (MvPolynomial.pderiv i (F_lci a j))).submatrix r.succAbove id))) ∧
        (∀ s : Fin (k_lci b + 1),
          ψ_ov (KaehlerDifferential.D A_ab B_ab
            ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : M.V a ⊓ M.V b ≤ M.V b)).op).hom
              (π_lci b (MvPolynomial.X s)))) =
            (M.u a b).val *
              (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : M.V a ⊓ M.V b ≤ M.V b)).op).hom
                (t_mark b * (-1) ^ (s : ℕ) *
                  Matrix.det ((Matrix.of fun (i : Fin (k_lci b + 1)) (j : Fin (k_lci b)) =>
                    π_lci b (MvPolynomial.pderiv i (F_lci b j))).submatrix s.succAbove id))))
def IsSmoothCurveRRData (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (E_sm : AlgebraicGeometry.Scheme.{u})
    (p_sm : E_sm ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (F : Type u) [Field F] [Algebra Ω F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ E_sm)
    (ord : E_sm → F → WithTop ℤ)
    (g_E : ℕ)
    (x_sep : F)
    (K_div : E_sm → ℤ) : Prop :=
  Set.Infinite {P : E_sm | IsClosed ({P} : Set E_sm)} ∧
  (∀ S : Set E_sm, IsClosed S → S ≠ Set.univ →
    S.Finite ∧ ∀ P ∈ S, IsClosed ({P} : Set E_sm)) ∧
  (∀ P : E_sm, IsClosed ({P} : Set E_sm) →
    (∀ f : F, ord P f = ⊤ ↔ f = 0) ∧
    (∀ x y : F, ord P (x * y) = ord P x + ord P y) ∧
    (∀ x y : F, min (ord P x) (ord P y) ≤ ord P (x + y)) ∧
    (∀ c : Ω, c ≠ 0 → ord P (algebraMap Ω F c) = 0) ∧
    (∀ u : F, ord P u = (1 : WithTop ℤ) → KaehlerDifferential.D Ω F u ≠ 0)) ∧
  (∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
    Nonempty ↥W →
    ∀ (φ_W : E_sm.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
      AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_F →
      Function.Injective φ_W.hom ∧
      (∀ c : Ω,
        φ_W.hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            p_sm.appLE ⊤ W le_top).hom c) = algebraMap Ω F c) ∧
      (∀ f : F,
        f ∈ Set.range φ_W.hom ↔
          ∀ P : E_sm, P ∈ W → IsClosed ({P} : Set E_sm) → (0 : WithTop ℤ) ≤ ord P f) ∧
      (∀ p_P : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W)),
        IsClosed ({hW.fromSpec.base p_P} : Set E_sm) →
        (∃ t_P : ↑(E_sm.presheaf.obj (Opposite.op W)),
          t_P ∈ p_P.asIdeal ∧ t_P ∉ p_P.asIdeal ^ 2) ∧
        (∀ b : ↑(E_sm.presheaf.obj (Opposite.op W)),
          b ∈ p_P.asIdeal ↔ (1 : WithTop ℤ) ≤ ord (hW.fromSpec.base p_P) (φ_W.hom b)) ∧
        (∀ b : ↑(E_sm.presheaf.obj (Opposite.op W)),
          b ∈ p_P.asIdeal ^ 2 ↔
            (2 : WithTop ℤ) ≤ ord (hW.fromSpec.base p_P) (φ_W.hom b)))) ∧
  KaehlerDifferential.D Ω F x_sep ≠ 0 ∧
  (∀ P : E_sm, ¬IsClosed ({P} : Set E_sm) → K_div P = 0) ∧
  {P : E_sm | K_div P ≠ 0}.Finite ∧
  (∑ᶠ P : E_sm, K_div P) = (2 : ℤ) * (g_E : ℤ) - 2 ∧
  (∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
    Nonempty ↥W →
    ∀ (φ_W : E_sm.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
      AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_F →
      ∀ (p_P : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W)))
        (t_P : ↑(E_sm.presheaf.obj (Opposite.op W))),
        let P : E_sm := hW.fromSpec.base p_P
        IsClosed ({P} : Set E_sm) →
        t_P ∈ p_P.asIdeal →
        t_P ∉ p_P.asIdeal ^ 2 →
        KaehlerDifferential.D Ω F (φ_W.hom t_P) ≠ 0 ∧
        ∃ δ_P : F,
          δ_P ≠ 0 ∧
          ord P δ_P = (K_div P : WithTop ℤ) ∧
          KaehlerDifferential.D Ω F x_sep = δ_P • KaehlerDifferential.D Ω F (φ_W.hom t_P)) ∧
  (g_E = 0 →
    ∃ isoP1 : E_sm ≅ (weilProjectiveSpaceOver Ω 1).left,
      isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom = p_sm) ∧
  (∀ f : F, f ≠ 0 →
    {P : E_sm | IsClosed ({P} : Set E_sm) ∧ ord P f ≠ 0}.Finite ∧
    ∃ d_f : E_sm → ℤ,
      (∀ P : E_sm, ¬IsClosed ({P} : Set E_sm) → d_f P = 0) ∧
      (∀ P : E_sm, IsClosed ({P} : Set E_sm) → ord P f = (d_f P : WithTop ℤ)) ∧
      (∑ᶠ P : E_sm, d_f P) = 0) ∧
  (∀ (D : E_sm → ℤ),
    (∀ P : E_sm, ¬IsClosed ({P} : Set E_sm) → D P = 0) →
    {P : E_sm | D P ≠ 0}.Finite →
    (2 : ℤ) * (g_E : ℤ) - 2 < (∑ᶠ P : E_sm, D P) →
    (∀ (L_D : Submodule Ω F),
      (∀ f : F, f ∈ L_D ↔
        ∀ P : E_sm, IsClosed ({P} : Set E_sm) → (-(D P) : WithTop ℤ) ≤ ord P f) →
      FiniteDimensional Ω ↥L_D ∧
        (Module.finrank Ω ↥L_D : ℤ) = (∑ᶠ P : E_sm, D P) + 1 - (g_E : ℤ)) ∧
    (∀ (m_cov : ℕ) (W_cov : Fin m_cov → E_sm.Opens),
      (∀ a : Fin m_cov, AlgebraicGeometry.IsAffineOpen (W_cov a)) →
      (⋃ a : Fin m_cov, (W_cov a : Set E_sm)) = Set.univ →
      ∀ (c_F : Fin m_cov → Fin m_cov → F),
        (∀ a : Fin m_cov, Nonempty ↥(W_cov a) → c_F a a = 0) →
        (∀ a b : Fin m_cov, Nonempty ↥(W_cov a) → Nonempty ↥(W_cov b) →
          ∀ P : E_sm, P ∈ W_cov a ⊓ W_cov b → IsClosed ({P} : Set E_sm) →
            (-(D P) : WithTop ℤ) ≤ ord P (c_F a b)) →
        (∀ a b d : Fin m_cov,
          Nonempty ↥(W_cov a) → Nonempty ↥(W_cov b) → Nonempty ↥(W_cov d) →
          c_F a b + c_F b d = c_F a d) →
        ∃ f_F : Fin m_cov → F,
          (∀ a : Fin m_cov, Nonempty ↥(W_cov a) →
            ∀ P : E_sm, P ∈ W_cov a → IsClosed ({P} : Set E_sm) →
              (-(D P) : WithTop ℤ) ≤ ord P (f_F a)) ∧
          (∀ a b : Fin m_cov, Nonempty ↥(W_cov a) → Nonempty ↥(W_cov b) →
            c_F a b = f_F a - f_F b))) ∧
  (∀ f : F, KaehlerDifferential.D Ω F f ≠ 0 →
    ∃ (U_f : E_sm.Opens) (hUf : AlgebraicGeometry.IsAffineOpen U_f),
      (U_f : Set E_sm) = {z : E_sm | ¬IsClosed ({z} : Set E_sm) ∨ (0 : WithTop ℤ) ≤ ord z f} ∧
      Nonempty ↥U_f ∧
      ∀ (φ_Uf : E_sm.presheaf.obj (Opposite.op U_f) ⟶ CommRingCat.of F),
        AlgebraicGeometry.Spec.map φ_Uf ≫ hUf.fromSpec = η_F →
        ∃ (ψ_poly : Polynomial Ω →+* ↑(E_sm.presheaf.obj (Opposite.op U_f))),
          (∀ c : Ω,
            ψ_poly (Polynomial.C c) =
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                p_sm.appLE ⊤ U_f le_top).hom c)) ∧
          φ_Uf.hom (ψ_poly Polynomial.X) = f ∧
          ψ_poly.Finite)

def IsNodalStabilityDivisorSystem {Ω : Type u} [Field Ω]
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (c δ : ℕ)
    (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
    (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
    (z_node : Fin δ → C)
    (α₀ α₁ : Fin δ → Fin (c + 1))
    (g_E : Fin (c + 1) → ℕ)
    (B_div B_self_div D_div : ∀ α : Fin (c + 1), E_norm α → ℤ) : Prop :=
  let _ := g
  (∀ (α : Fin (c + 1)) (P : E_norm α),
    ((B_div α P = 1 ∧ IsClosed ({P} : Set (E_norm α)) ∧
        (ν α).base P ∈ Set.range z_node) ∨
      (B_div α P = 0 ∧ (ν α).base P ∉ Set.range z_node)) ∧
    ((B_self_div α P = 1 ∧ IsClosed ({P} : Set (E_norm α)) ∧
        ∃ r : Fin δ, α₀ r = α ∧ α₁ r = α ∧ (ν α).base P = z_node r) ∨
      (B_self_div α P = 0 ∧
        ¬∃ r : Fin δ, α₀ r = α ∧ α₁ r = α ∧ (ν α).base P = z_node r)) ∧
    ((D_div α P = 1 ∧ IsClosed ({P} : Set (E_norm α)) ∧
        ∃ j : Fin n, (ν α).base P ∈ Set.range (τ j).base) ∨
      (D_div α P = 0 ∧ ∀ j : Fin n, (ν α).base P ∉ Set.range (τ j).base)) ∧
    B_self_div α P ≤ B_div α P ∧
    (B_div α P = 0 ∨ D_div α P = 0)) ∧
  (∀ α : Fin (c + 1),
    {P : E_norm α | B_div α P ≠ 0}.Finite ∧
    {P : E_norm α | B_self_div α P ≠ 0}.Finite ∧
    {P : E_norm α | D_div α P ≠ 0}.Finite) ∧
  (∀ α : Fin (c + 1),
    let d_α : ℤ := (2 : ℤ) * (g_E α : ℤ) - 2 +
      (∑ᶠ P : E_norm α, B_div α P) + (∑ᶠ P : E_norm α, D_div α P)
    (1 : ℤ) ≤ d_α ∧
    (2 : ℤ) * (g_E α : ℤ) ≤ 3 * d_α - (∑ᶠ P : E_norm α, B_div α P) ∧
    (2 : ℤ) * (g_E α : ℤ) + 1 ≤ 3 * d_α - (∑ᶠ P : E_norm α, B_self_div α P)) ∧
  (4 : ℤ) ≤
    (∑ α : Fin (c + 1),
      (3 * ((2 : ℤ) * (g_E α : ℤ) - 2 +
        (∑ᶠ P : E_norm α, B_div α P) + (∑ᶠ P : E_norm α, D_div α P)) +
        1 - (g_E α : ℤ))) - (δ : ℤ)

def HasNodalTricanonicalDivisorBridge (Ω : Type u) [Field Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (M : WeilLineBundle C)
    (hAff : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
    (c δ : ℕ)
    (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
    (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
    (F : Fin (c + 1) → Type u)
    [∀ α : Fin (c + 1), Field (F α)]
    [∀ α : Fin (c + 1), Algebra Ω (F α)]
    (η_F : ∀ α : Fin (c + 1), AlgebraicGeometry.Spec (CommRingCat.of (F α)) ⟶ E_norm α)
    (z_node : Fin δ → C)
    (ord : ∀ α : Fin (c + 1), E_norm α → F α → WithTop ℤ)
    (K_div B_div B_self_div D_div : ∀ α : Fin (c + 1), E_norm α → ℤ)
    (lam_triv : ∀ (α : Fin (c + 1)) (a : Fin M.m),
      Nonempty ↥((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)) → F α)
    (secFunc : (∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a)))) →
      ∀ α : Fin (c + 1), F α) : Prop :=
  let toVa : (∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a)))) →
      ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
    fun s a =>
      (C.presheaf.map (CategoryTheory.homOfLE (le_inf le_top (le_refl (M.V a)))).op).hom (s a)
  let Δ_div : ∀ α : Fin (c + 1), E_norm α → ℤ :=
    fun α P => 3 * K_div α P + 3 * B_div α P + 3 * D_div α P
  (∀ (α : Fin (c + 1)) (a : Fin M.m)
      (ha : Nonempty ↥((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)))
      (hW : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a))),
    lam_triv α a ha ≠ 0 ∧
    (∀ P : E_norm α,
      P ∈ (TopologicalSpace.Opens.map (ν α).base).obj (M.V a) →
      IsClosed ({P} : Set (E_norm α)) →
      ord α P ((lam_triv α a ha) ^ 3) = (Δ_div α P : WithTop ℤ)) ∧
    (∀ s : ∀ b : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V b))),
      IsWeilTricanonicalSection M ⊤ s →
      (∀ P : E_norm α, IsClosed ({P} : Set (E_norm α)) →
        (-(Δ_div α P) : WithTop ℤ) ≤ ord α P (secFunc s α)) ∧
      ∀ (φ_a : (E_norm α).presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a))) ⟶
            CommRingCat.of (F α)),
        AlgebraicGeometry.Spec.map φ_a ≫ hW.fromSpec = η_F α →
        φ_a.hom (((ν α).app (M.V a)).hom (toVa s a)) =
          secFunc s α * (lam_triv α a ha) ^ 3)) ∧
  (∀ (N_lin : ℕ)
      (e_fam : Fin N_lin → ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))))
      (c_coef : Fin N_lin → Ω)
      (s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a)))),
    (∀ i : Fin N_lin, IsWeilTricanonicalSection M ⊤ (e_fam i)) →
    (∀ a : Fin M.m,
      s a = ∑ i : Fin N_lin,
        (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M.V a ≤ ⊤)).op).hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ g.appTop).hom (c_coef i)) *
          e_fam i a) →
    IsWeilTricanonicalSection M ⊤ s ∧
      ∀ α : Fin (c + 1),
        secFunc s α = ∑ i : Fin N_lin, algebraMap Ω (F α) (c_coef i) * secFunc (e_fam i) α) ∧
  (∀ r : Fin δ,
    ∃ s_r : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))),
      IsWeilTricanonicalSection M ⊤ s_r ∧
      (∀ (a : Fin M.m) (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a)))),
        (hAff a).fromSpec.base p_x = z_node r →
        toVa s_r a ∉ p_x.asIdeal) ∧
      (∀ r' : Fin δ, r' ≠ r →
        ∀ (a : Fin M.m) (p_y : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a)))),
          (hAff a).fromSpec.base p_y = z_node r' →
          toVa s_r a ∈ p_y.asIdeal)) ∧
  (∀ (α : Fin (c + 1)) (f_α : F α),
    (∀ P : E_norm α, IsClosed ({P} : Set (E_norm α)) →
      (-(Δ_div α P - B_div α P) : WithTop ℤ) ≤ ord α P f_α) →
    ∃ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))),
      IsWeilTricanonicalSection M ⊤ s ∧
      secFunc s α = f_α ∧
      (∀ β : Fin (c + 1), β ≠ α → secFunc s β = 0) ∧
      (∀ (r : Fin δ) (a : Fin M.m)
          (p_z : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a)))),
        (hAff a).fromSpec.base p_z = z_node r →
        toVa s a ∈ p_z.asIdeal)) ∧
  (∀ (α : Fin (c + 1)) (f_α : F α),
    (∀ P : E_norm α, IsClosed ({P} : Set (E_norm α)) →
      (-(Δ_div α P - B_self_div α P) : WithTop ℤ) ≤ ord α P f_α) →
    ∃ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))),
      IsWeilTricanonicalSection M ⊤ s ∧
      secFunc s α = f_α)
def HasPowerSeriesNodalRoofAt (Ω : Type u) [Field Ω]
    {C : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (x : C) (m : ℕ) : Prop :=
  let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)}
  1 ≤ m ∧
  ∃ (A' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec A')
    (e_C : AlgebraicGeometry.Spec A' ⟶ C)
    (q : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m))),
    AlgebraicGeometry.Etale e_C ∧
    AlgebraicGeometry.Etale q ∧
    e_C.base v₀ = x ∧
    (∀ i : Fin 2, Ideal.Quotient.mk J_m (MvPolynomial.X i) ∈ (q.base v₀).asIdeal) ∧
    Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω)) ∈ (q.base v₀).asIdeal ∧
    e_C ≫ g =
      q ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C))

def IsLocalPowerSeriesNodeBlowupModel (Ω : Type u) [Field Ω] (m : ℕ)
    {M_m : AlgebraicGeometry.Scheme.{u}}
    (p_m : M_m ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
        ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω)))))) : Prop :=
  let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
    Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
      Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
  let P_m := MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m
  let I_nod : Ideal P_m := Ideal.span
    {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
     Ideal.Quotient.mk J_m (MvPolynomial.X 1),
     Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}
  let g_Pm : AlgebraicGeometry.Spec (CommRingCat.of P_m) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C))
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  2 ≤ m ∧
  AlgebraicGeometry.IsIntegral M_m ∧
  AlgebraicGeometry.Flat (p_m ≫ g_Pm) ∧
  AlgebraicGeometry.LocallyOfFinitePresentation (p_m ≫ g_Pm) ∧
  AlgebraicGeometry.IsProper p_m ∧
  AlgebraicGeometry.Surjective p_m ∧
  CategoryTheory.IsIso
    (p_m ∣_ ⟨(PrimeSpectrum.zeroLocus (I_nod : Set P_m))ᶜ,
      (PrimeSpectrum.isClosed_zeroLocus (I_nod : Set P_m)).isOpen_compl⟩) ∧
  (∀ U : (AlgebraicGeometry.Spec (CommRingCat.of P_m)).Opens,
    CategoryTheory.IsIso (p_m.app U)) ∧
  (∀ q₀ : AlgebraicGeometry.Spec (CommRingCat.of P_m),
    _root_.IsConnected (p_m.base ⁻¹' {q₀})) ∧
  (∃ (W_cov : Fin 3 → M_m.Opens)
      (hAff : ∀ r : Fin 3, AlgebraicGeometry.IsAffineOpen (W_cov r))
      (d_gen : ∀ r : Fin 3, ↑(M_m.presheaf.obj (Opposite.op (W_cov r)))),
    (⋃ r : Fin 3, (W_cov r : Set M_m)) = Set.univ ∧
    ∀ r : Fin 3,
      d_gen r ∈ nonZeroDivisors ↑(M_m.presheaf.obj (Opposite.op (W_cov r))) ∧
      Ideal.map (AlgebraicGeometry.Spec.preimage ((hAff r).fromSpec ≫ p_m)).hom I_nod =
        Ideal.span {d_gen r}) ∧
  (∀ (B : Type u) [CommRing B]
      (ψ : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of P_m))
      (d : B),
    d ∈ nonZeroDivisors B →
    Ideal.map (AlgebraicGeometry.Spec.preimage ψ).hom I_nod = Ideal.span {d} →
    (∃ ψ_lift : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ M_m, ψ_lift ≫ p_m = ψ) ∧
    (∀ ψ₁ ψ₂ : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ M_m,
      ψ₁ ≫ p_m = ψ → ψ₂ ≫ p_m = ψ → ψ₁ = ψ₂)) ∧
  ((m ≤ 3 ∧ ∀ y : M_m,
      (∃ V : M_m.Opens, y ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ p_m ≫ g_Pm)) ∨
      HasPowerSeriesNodalRoofAt Ω (p_m ≫ g_Pm) y 1) ∨
   (4 ≤ m ∧ ∃ y_sing : M_m,
      p_m.base y_sing ∈ PrimeSpectrum.zeroLocus (I_nod : Set P_m) ∧
      HasPowerSeriesNodalRoofAt Ω (p_m ≫ g_Pm) y_sing (m - 2) ∧
      ∀ y : M_m, y ≠ y_sing →
        (∃ V : M_m.Opens, y ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ p_m ≫ g_Pm)) ∨
        HasPowerSeriesNodalRoofAt Ω (p_m ≫ g_Pm) y 1)) ∧
  (let Y_m := CategoryTheory.Limits.pullback (p_m ≫ g_Pm) s_Ω
   let fst_m := CategoryTheory.Limits.pullback.fst (p_m ≫ g_Pm) s_Ω
   let snd_m := CategoryTheory.Limits.pullback.snd (p_m ≫ g_Pm) s_Ω
   ∃ (k_exc : ℕ) (E_exc : Fin k_exc → AlgebraicGeometry.Scheme.{u})
     (ι_exc : ∀ a : Fin k_exc, E_exc a ⟶ Y_m)
     (iso_exc : ∀ a : Fin k_exc, E_exc a ≅ (weilProjectiveSpaceOver Ω 1).left)
     (L_br : Fin 2 → Set ↥Y_m),
     1 ≤ k_exc ∧
     (∀ a : Fin k_exc, AlgebraicGeometry.IsClosedImmersion (ι_exc a) ∧
       AlgebraicGeometry.IsIntegral (E_exc a) ∧
       Set.range (ι_exc a).base ∈ irreducibleComponents ↥Y_m ∧
       ι_exc a ≫ snd_m = (iso_exc a).hom ≫ (weilProjectiveSpaceOver Ω 1).hom) ∧
     (∀ b : Fin 2, L_br b ∈ irreducibleComponents ↥Y_m ∧
       (L_br b ∩ {q : ↥Y_m | p_m.base (fst_m.base q) ∉
         PrimeSpectrum.zeroLocus (I_nod : Set P_m)}).Nonempty) ∧
     Disjoint (L_br 0) (L_br 1) ∧
     {q : ↥Y_m | p_m.base (fst_m.base q) ∈ PrimeSpectrum.zeroLocus (I_nod : Set P_m)} =
       (⋃ a : Fin k_exc, Set.range (ι_exc a).base) ∧
     irreducibleComponents ↥Y_m =
       (⋃ a : Fin k_exc, {Set.range (ι_exc a).base}) ∪ {L_br 0, L_br 1} ∧
     (∀ b : Fin 2, ∃! q : ↥Y_m, q ∈ L_br b ∧
       p_m.base (fst_m.base q) ∈ PrimeSpectrum.zeroLocus (I_nod : Set P_m)) ∧
     (∀ a : Fin k_exc, ∃ q₁ q₂ : ↥Y_m,
       q₁ ≠ q₂ ∧ q₁ ∈ Set.range (ι_exc a).base ∧ q₂ ∈ Set.range (ι_exc a).base ∧
       (∃ E₁ ∈ irreducibleComponents ↥Y_m, E₁ ≠ Set.range (ι_exc a).base ∧ q₁ ∈ E₁) ∧
       (∃ E₂ ∈ irreducibleComponents ↥Y_m, E₂ ≠ Set.range (ι_exc a).base ∧ q₂ ∈ E₂) ∧
       ∀ q ∈ Set.range (ι_exc a).base,
         (∃ E' ∈ irreducibleComponents ↥Y_m, E' ≠ Set.range (ι_exc a).base ∧ q ∈ E') →
         q = q₁ ∨ q = q₂))

def IsPartialPowerSeriesNodeResolution (Ω : Type u) [Field Ω] (n : ℕ)
    {C C' : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C))
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C'))
    (q' : C' ⟶ C)
    (Z_blown : Set C)
    (r : ℕ) (pts : Fin r → C') (mults : Fin r → ℕ) : Prop :=
  let S := AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω))
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  let η_K := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
  AlgebraicGeometry.IsIntegral C' ∧
  AlgebraicGeometry.Flat g' ∧
  AlgebraicGeometry.IsProper g' ∧
  AlgebraicGeometry.LocallyOfFinitePresentation g' ∧
  AlgebraicGeometry.Surjective g' ∧
  AlgebraicGeometry.SmoothOfRelativeDimension 1
    (CategoryTheory.Limits.pullback.snd g' η_K) ∧
  (∀ j : Fin n, τ' j ≫ g' = 𝟙 S) ∧
  (_root_.Pairwise fun i j : Fin n =>
    Disjoint (Set.range (τ' i).base) (Set.range (τ' j).base)) ∧
  (∀ (j : Fin n) (b : S), ∃ V : C'.Opens,
    (τ' j).base b ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g')) ∧
  q' ≫ g = g' ∧
  (∀ j : Fin n, τ' j ≫ q' = τ j) ∧
  AlgebraicGeometry.IsProper q' ∧
  AlgebraicGeometry.Surjective q' ∧
  (∀ U : C.Opens, CategoryTheory.IsIso (q'.app U)) ∧
  (∀ x : C, _root_.IsConnected (q'.base ⁻¹' {x})) ∧
  Z_blown.Finite ∧
  (∀ x ∈ Z_blown, IsClosed ({x} : Set C) ∧
    PowerSeries.X ∈ (g.base x).asIdeal ∧
    ∀ j : Fin n, x ∉ Set.range (τ j).base) ∧
  (∃ U_iso : C.Opens, (U_iso : Set C) = Z_blownᶜ ∧ CategoryTheory.IsIso (q' ∣_ U_iso)) ∧
  (∀ x ∈ Z_blown, ∀ z ∈ q'.base ⁻¹' {x},
    ∃ q₀ : ↥(CategoryTheory.Limits.pullback g' s_Ω),
      (CategoryTheory.Limits.pullback.fst g' s_Ω).base q₀ = z ∧
      ∃ E : Set ↥(CategoryTheory.Limits.pullback g' s_Ω),
        IsTwoBridgeRationalComponent Ω n g' τ' E ∧ q₀ ∈ E ∧
        ((fun q => q'.base ((CategoryTheory.Limits.pullback.fst g' s_Ω).base q)) '' E).Subsingleton) ∧
  Function.Injective pts ∧
  (∀ i : Fin r, 2 ≤ mults i ∧ HasPowerSeriesNodalRoofAt Ω g' (pts i) (mults i)) ∧
  (∀ z : C', z ∉ Set.range pts →
    (∃ V : C'.Opens, z ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g')) ∨
    HasPowerSeriesNodalRoofAt Ω g' z 1)
def IsDedekindChartForCoord (Ω X F : Type u) [Field Ω] [Field F] [Algebra Ω F]
    (IsPlace : X → Prop) (ord : X → F → WithTop ℤ) (t : F) : Prop :=
  let At := Algebra.adjoin Ω ({t} : Set F)
  let Bt := integralClosure (↥At) F
  Transcendental Ω t ∧
  (let Lt := IntermediateField.adjoin Ω ({t} : Set F)
   FiniteDimensional (↥Lt) F ∧ Algebra.IsSeparable (↥Lt) F) ∧
  (∀ v : F,
    v ∈ Bt ↔ ∀ P : X, IsPlace P → (0 : WithTop ℤ) ≤ ord P t → (0 : WithTop ℤ) ≤ ord P v) ∧
  (∀ 𝔪 : Ideal (↥Bt), 𝔪.IsMaximal →
    ∃ P : X, IsPlace P ∧ (0 : WithTop ℤ) ≤ ord P t ∧
      ∀ b : ↥Bt, b ∈ 𝔪 ↔ (1 : WithTop ℤ) ≤ ord P (b : F)) ∧
  (∀ P Q : X, IsPlace P → IsPlace Q →
    (0 : WithTop ℤ) ≤ ord P t → (0 : WithTop ℤ) ≤ ord Q t →
    (∀ b : ↥Bt, (1 : WithTop ℤ) ≤ ord P (b : F) ↔ (1 : WithTop ℤ) ≤ ord Q (b : F)) →
    P = Q)

def IsSmoothCurveLocalValuationPackage (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (E_sm : AlgebraicGeometry.Scheme.{u})
    (p_sm : E_sm ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (F : Type u) [Field F] [Algebra Ω F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ E_sm)
    (ord : E_sm → F → WithTop ℤ)
    (x_sep : F)
    (K_div : E_sm → ℤ) : Prop :=
  Set.Infinite {P : E_sm | IsClosed ({P} : Set E_sm)} ∧
  (∀ S : Set E_sm, IsClosed S → S ≠ Set.univ →
    S.Finite ∧ ∀ P ∈ S, IsClosed ({P} : Set E_sm)) ∧
  (∀ P : E_sm, IsClosed ({P} : Set E_sm) →
    (∀ f : F, ord P f = ⊤ ↔ f = 0) ∧
    (∀ x y : F, ord P (x * y) = ord P x + ord P y) ∧
    (∀ x y : F, min (ord P x) (ord P y) ≤ ord P (x + y)) ∧
    (∀ c : Ω, c ≠ 0 → ord P (algebraMap Ω F c) = 0) ∧
    (∀ u : F, ord P u = (1 : WithTop ℤ) → KaehlerDifferential.D Ω F u ≠ 0) ∧
    (∃ ϖ : F, ord P ϖ = (1 : WithTop ℤ)) ∧
    (∀ v : F, (0 : WithTop ℤ) ≤ ord P v →
      ∃ c : Ω, (1 : WithTop ℤ) ≤ ord P (v - algebraMap Ω F c))) ∧
  (∀ f : F, f ≠ 0 → {P : E_sm | IsClosed ({P} : Set E_sm) ∧ ord P f ≠ 0}.Finite) ∧
  (∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
    Nonempty ↥W →
    ∀ (φ_W : E_sm.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
      AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_F →
      Function.Injective φ_W.hom ∧
      (∀ c : Ω,
        φ_W.hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            p_sm.appLE ⊤ W le_top).hom c) = algebraMap Ω F c) ∧
      (∀ f : F,
        f ∈ Set.range φ_W.hom ↔
          ∀ P : E_sm, P ∈ W → IsClosed ({P} : Set E_sm) → (0 : WithTop ℤ) ≤ ord P f) ∧
      (∀ p_P : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W)),
        IsClosed ({hW.fromSpec.base p_P} : Set E_sm) →
        (∃ t_P : ↑(E_sm.presheaf.obj (Opposite.op W)),
          t_P ∈ p_P.asIdeal ∧ t_P ∉ p_P.asIdeal ^ 2) ∧
        (∀ b : ↑(E_sm.presheaf.obj (Opposite.op W)),
          b ∈ p_P.asIdeal ↔ (1 : WithTop ℤ) ≤ ord (hW.fromSpec.base p_P) (φ_W.hom b)) ∧
        (∀ b : ↑(E_sm.presheaf.obj (Opposite.op W)),
          b ∈ p_P.asIdeal ^ 2 ↔
            (2 : WithTop ℤ) ≤ ord (hW.fromSpec.base p_P) (φ_W.hom b)))) ∧
  KaehlerDifferential.D Ω F x_sep ≠ 0 ∧
  (∀ f : F, KaehlerDifferential.D Ω F f ≠ 0 →
    Transcendental Ω f ∧
    let Lf := IntermediateField.adjoin Ω ({f} : Set F)
    FiniteDimensional ↥Lf F ∧ Algebra.IsSeparable ↥Lf F) ∧
  (∀ P : E_sm, ¬IsClosed ({P} : Set E_sm) → K_div P = 0) ∧
  {P : E_sm | K_div P ≠ 0}.Finite ∧
  (∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
    Nonempty ↥W →
    ∀ (φ_W : E_sm.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
      AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_F →
      ∀ (p_P : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W)))
        (t_P : ↑(E_sm.presheaf.obj (Opposite.op W))),
        let P : E_sm := hW.fromSpec.base p_P
        IsClosed ({P} : Set E_sm) →
        t_P ∈ p_P.asIdeal →
        t_P ∉ p_P.asIdeal ^ 2 →
        KaehlerDifferential.D Ω F (φ_W.hom t_P) ≠ 0 ∧
        ∃ δ_P : F,
          δ_P ≠ 0 ∧
          ord P δ_P = (K_div P : WithTop ℤ) ∧
          KaehlerDifferential.D Ω F x_sep = δ_P • KaehlerDifferential.D Ω F (φ_W.hom t_P)) ∧
  (∀ P : E_sm, IsClosed ({P} : Set E_sm) →
    ∀ t_P : F, ord P t_P = (1 : WithTop ℤ) →
      KaehlerDifferential.D Ω F t_P ≠ 0 ∧
      ∃ δ_P : F,
        δ_P ≠ 0 ∧
        ord P δ_P = (K_div P : WithTop ℤ) ∧
        KaehlerDifferential.D Ω F x_sep = δ_P • KaehlerDifferential.D Ω F t_P)

def IsSmoothCurveDedekindValuationData (Ω X F : Type u) [Field Ω] [Field F] [Algebra Ω F]
    (IsPlace : X → Prop) (ord : X → F → WithTop ℤ) (x_sep : F) (K_div : X → ℤ) : Prop :=
  Set.Infinite {P : X | IsPlace P} ∧
  (∀ P : X, IsPlace P →
    (∀ f : F, ord P f = ⊤ ↔ f = 0) ∧
    (∀ x y : F, ord P (x * y) = ord P x + ord P y) ∧
    (∀ x y : F, min (ord P x) (ord P y) ≤ ord P (x + y)) ∧
    (∀ c : Ω, c ≠ 0 → ord P (algebraMap Ω F c) = 0) ∧
    (∃ ϖ : F, ord P ϖ = (1 : WithTop ℤ)) ∧
    (∀ v : F, (0 : WithTop ℤ) ≤ ord P v →
      ∃ c : Ω, (1 : WithTop ℤ) ≤ ord P (v - algebraMap Ω F c))) ∧
  (∀ f : F, f ≠ 0 → {P : X | IsPlace P ∧ ord P f ≠ 0}.Finite) ∧
  KaehlerDifferential.D Ω F x_sep ≠ 0 ∧
  IsDedekindChartForCoord Ω X F IsPlace ord x_sep ∧
  IsDedekindChartForCoord Ω X F IsPlace ord x_sep⁻¹ ∧
  (∀ P : X, ¬IsPlace P → K_div P = 0) ∧
  {P : X | K_div P ≠ 0}.Finite ∧
  (∀ P : X, IsPlace P →
    ∀ t_P : F, ord P t_P = (1 : WithTop ℤ) →
      KaehlerDifferential.D Ω F t_P ≠ 0 ∧
      ∃ δ_P : F,
        δ_P ≠ 0 ∧
        ord P δ_P = (K_div P : WithTop ℤ) ∧
        KaehlerDifferential.D Ω F x_sep = δ_P • KaehlerDifferential.D Ω F t_P)

def IsTwoChartDivisorSpaces (Ω X F : Type u) [Field Ω] [Field F] [Algebra Ω F]
    (IsPlace : X → Prop) (ord : X → F → WithTop ℤ) (x_sep : F) (D : X → ℤ)
    (E₀ E_inf E₀_inf L_D : Submodule Ω F) : Prop :=
  (∀ v : F, v ∈ E₀ ↔
    ∀ P : X, IsPlace P → (0 : WithTop ℤ) ≤ ord P x_sep → (-(D P) : WithTop ℤ) ≤ ord P v) ∧
  (∀ v : F, v ∈ E_inf ↔
    ∀ P : X, IsPlace P → ord P x_sep ≤ (0 : WithTop ℤ) → (-(D P) : WithTop ℤ) ≤ ord P v) ∧
  (∀ v : F, v ∈ E₀_inf ↔
    ∀ P : X, IsPlace P → ord P x_sep = (0 : WithTop ℤ) → (-(D P) : WithTop ℤ) ≤ ord P v) ∧
  (∀ v : F, v ∈ L_D ↔
    ∀ P : X, IsPlace P → (-(D P) : WithTop ℤ) ≤ ord P v)
def IsNodalCurvePreNormalizationData (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (c δ : ℕ)
    (E_set : Fin (c + 1) → Set C)
    (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
    (p_norm : ∀ α : Fin (c + 1), E_norm α ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
    (F : Fin (c + 1) → Type u)
    [∀ α : Fin (c + 1), Field (F α)]
    [∀ α : Fin (c + 1), Algebra Ω (F α)]
    (η_F : ∀ α : Fin (c + 1), AlgebraicGeometry.Spec (CommRingCat.of (F α)) ⟶ E_norm α)
    (z_node : Fin δ → C)
    (pt_C : ∀ (x : C), IsClosed ({x} : Set C) →
      (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (pt_E : ∀ (α : Fin (c + 1)) (P : E_norm α), IsClosed ({P} : Set (E_norm α)) →
      (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E_norm α)) : Prop :=
  (C.IsSeparated ∧ AlgebraicGeometry.IsReduced C) ∧
  (Function.Injective E_set ∧
    Set.range E_set = irreducibleComponents ↥C ∧
    (⋃ α : Fin (c + 1), E_set α) = Set.univ) ∧
  (∀ α : Fin (c + 1),
    AlgebraicGeometry.IsIntegral (E_norm α) ∧
    AlgebraicGeometry.IsProper (p_norm α) ∧
    AlgebraicGeometry.SmoothOfRelativeDimension 1 (p_norm α) ∧
    AlgebraicGeometry.IsFinite (ν α) ∧
    ν α ≫ g = p_norm α ∧
    Set.range (ν α).base = E_set α ∧
    (∀ P : E_norm α, IsClosed ({P} : Set (E_norm α)) ↔ IsClosed ({(ν α).base P} : Set C)) ∧
    η_F α ≫ p_norm α = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω (F α))) ∧
    IsSchemeFunctionField (E_norm α) (F α) (η_F α)) ∧
  (Function.Injective z_node ∧
    (∀ r : Fin δ,
      IsClosed ({z_node r} : Set C) ∧
      ¬∃ V : C.Opens, z_node r ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)) ∧
    (∀ x : C, x ∉ Set.range z_node →
      (∃ V : C.Opens, x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)) ∧
      ∃! pair : Σ α : Fin (c + 1), E_norm α, (ν pair.1).base pair.2 = x) ∧
    (∀ α β : Fin (c + 1), α ≠ β → E_set α ∩ E_set β ⊆ Set.range z_node) ∧
    (∀ j : Fin n, ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
      IsClosed ({(τ j).base q} : Set C) ∧ (τ j).base q ∉ Set.range z_node)) ∧
  (∀ (U : C.Opens) (s₁ s₂ : ↑(C.presheaf.obj (Opposite.op U))),
    (∀ α : Fin (c + 1), ((ν α).app U).hom s₁ = ((ν α).app U).hom s₂) → s₁ = s₂) ∧
  (∀ (x : C) (hx : IsClosed ({x} : Set C)),
    pt_C x hx ≫ g = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ∧
    (∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), (pt_C x hx).base q = x) ∧
    ∀ (V : C.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
      (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op V)))
      (h_in : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
        (TopologicalSpace.Opens.map (pt_C x hx).base).obj V),
      hV.fromSpec.base p_x = x →
      RingHom.ker (weilPointEvalRingHom (pt_C x hx) V h_in) = p_x.asIdeal) ∧
  (∀ (α : Fin (c + 1)) (P : E_norm α) (hP : IsClosed ({P} : Set (E_norm α))),
    pt_E α P hP ≫ p_norm α = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ∧
    (∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), (pt_E α P hP).base q = P) ∧
    (∀ hx : IsClosed ({(ν α).base P} : Set C), pt_E α P hP ≫ ν α = pt_C ((ν α).base P) hx) ∧
    ∀ (W : (E_norm α).Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
      (p_P : PrimeSpectrum ↑((E_norm α).presheaf.obj (Opposite.op W)))
      (h_in : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
        (TopologicalSpace.Opens.map (pt_E α P hP).base).obj W),
      hW.fromSpec.base p_P = P →
      RingHom.ker (weilPointEvalRingHom (pt_E α P hP) W h_in) = p_P.asIdeal) ∧
  (∀ (V : C.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
      (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op V)))
      (α : Fin (c + 1)),
    hV.fromSpec.base p_x ∉ Set.range z_node →
    hV.fromSpec.base p_x ∈ E_set α →
    ∃ b_sm : ↑(C.presheaf.obj (Opposite.op V)),
      b_sm ∉ p_x.asIdeal ∧
      (∀ β : Fin (c + 1), β ≠ α → ((ν β).app V).hom b_sm = 0) ∧
      (∀ b : ↑(C.presheaf.obj (Opposite.op V)),
        ((ν α).app V).hom b = 0 → ∃ k : ℕ, b_sm ^ k * b = 0) ∧
      (∀ s_tilde : ↑((E_norm α).presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj V))),
        ∃ (k : ℕ) (b : ↑(C.presheaf.obj (Opposite.op V))),
          (((ν α).app V).hom b_sm) ^ k * s_tilde = ((ν α).app V).hom b)) ∧
  (∀ (V : C.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
      (hW : ∀ α : Fin (c + 1),
        AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map (ν α).base).obj V))
      (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op V)))
      (α : Fin (c + 1))
      (p_P : PrimeSpectrum ↑((E_norm α).presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj V))))
      (b : ↑(C.presheaf.obj (Opposite.op V))),
    let x : C := hV.fromSpec.base p_x
    IsClosed ({x} : Set C) →
    x ∉ Set.range z_node →
    (ν α).base ((hW α).fromSpec.base p_P) = x →
    ((ν α).app V).hom b ∈ p_P.asIdeal →
    ((ν α).app V).hom b ∉ p_P.asIdeal ^ 2 →
    b ∈ p_x.asIdeal ∧
      IsLocalRing.maximalIdeal (Localization.AtPrime p_x.asIdeal) ≤
        Ideal.span ({algebraMap _ (Localization.AtPrime p_x.asIdeal) b} :
            Set (Localization.AtPrime p_x.asIdeal)) ⊔
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_x.asIdeal)) ^ 2) ∧
  (∀ (V : C.Opens) (_ : AlgebraicGeometry.IsAffineOpen V)
      (α : Fin (c + 1))
      (hW : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map (ν α).base).obj V)),
    Nonempty ↥((TopologicalSpace.Opens.map (ν α).base).obj V) →
    ∀ (φ_V : (E_norm α).presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj V)) ⟶
          CommRingCat.of (F α)),
      AlgebraicGeometry.Spec.map φ_V ≫ hW.fromSpec = η_F α →
      let θ : ↑(C.presheaf.obj (Opposite.op V)) →+* F α :=
        φ_V.hom.comp (((ν α).app V).hom)
      letI : Algebra ↑(C.presheaf.obj (Opposite.op V)) (F α) := θ.toAlgebra
      letI : (RingHom.ker θ).IsPrime := RingHom.ker_isPrime θ
      IsLocalization (RingHom.ker θ).primeCompl (F α) ∧
      ∀ c : Ω,
        θ (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          g.appLE ⊤ V (fun _ _ => trivial)).hom c) = algebraMap Ω (F α) c) ∧
  (∀ (α : Fin (c + 1)) (W : (E_norm α).Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
    Nonempty ↥W →
    ∀ (φ_W : (E_norm α).presheaf.obj (Opposite.op W) ⟶ CommRingCat.of (F α)),
      AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_F α →
      ∀ (p_P : PrimeSpectrum ↑((E_norm α).presheaf.obj (Opposite.op W)))
        (t_P : ↑((E_norm α).presheaf.obj (Opposite.op W))),
        IsClosed ({hW.fromSpec.base p_P} : Set (E_norm α)) →
        t_P ∈ p_P.asIdeal →
        t_P ∉ p_P.asIdeal ^ 2 →
        p_P.asIdeal.IsMaximal ∧
        (∀ z : ↑((E_norm α).presheaf.obj (Opposite.op W)),
          z ∈ p_P.asIdeal →
          ∃ s_z q_z : ↑((E_norm α).presheaf.obj (Opposite.op W)),
            s_z ∉ p_P.asIdeal ∧ s_z * z = q_z * t_P) ∧
        (∀ b_tilde : ↑((E_norm α).presheaf.obj (Opposite.op W)),
          ∃ u_b v_b : ↑((E_norm α).presheaf.obj (Opposite.op W)),
            v_b ∉ p_P.asIdeal ∧
            φ_W.hom v_b • KaehlerDifferential.D Ω (F α) (φ_W.hom b_tilde) =
              φ_W.hom u_b • KaehlerDifferential.D Ω (F α) (φ_W.hom t_P)))

def HasNodalEtaleBranchAndPinchingData (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (c δ : ℕ)
    (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
    (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
    (F : Fin (c + 1) → Type u)
    [∀ α : Fin (c + 1), Field (F α)]
    [∀ α : Fin (c + 1), Algebra Ω (F α)]
    (η_F : ∀ α : Fin (c + 1), AlgebraicGeometry.Spec (CommRingCat.of (F α)) ⟶ E_norm α)
    (z_node : Fin δ → C)
    (pt_E : ∀ (α : Fin (c + 1)) (P : E_norm α), IsClosed ({P} : Set (E_norm α)) →
      (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E_norm α))
    (α₀ : Fin δ → Fin (c + 1)) (P₀ : ∀ r : Fin δ, E_norm (α₀ r))
    (α₁ : Fin δ → Fin (c + 1)) (P₁ : ∀ r : Fin δ, E_norm (α₁ r)) : Prop :=
  (∀ α : Fin (c + 1),
    (∀ r : Fin δ, ¬(α₀ r = α ∧ α₁ r = α)) → AlgebraicGeometry.IsClosedImmersion (ν α)) ∧
  (∀ r : Fin δ,
    IsClosed ({P₀ r} : Set (E_norm (α₀ r))) ∧
    IsClosed ({P₁ r} : Set (E_norm (α₁ r))) ∧
    (ν (α₀ r)).base (P₀ r) = z_node r ∧
    (ν (α₁ r)).base (P₁ r) = z_node r ∧
    (⟨α₀ r, P₀ r⟩ : Σ α : Fin (c + 1), E_norm α) ≠ ⟨α₁ r, P₁ r⟩ ∧
    (∀ (α : Fin (c + 1)) (P : E_norm α),
      (ν α).base P = z_node r →
      (⟨α, P⟩ : Σ β : Fin (c + 1), E_norm β) = ⟨α₀ r, P₀ r⟩ ∨
        (⟨α, P⟩ : Σ β : Fin (c + 1), E_norm β) = ⟨α₁ r, P₁ r⟩)) ∧
  (∀ (V : C.Opens) (_ : AlgebraicGeometry.IsAffineOpen V)
      (s_tilde : ∀ α : Fin (c + 1),
        ↑((E_norm α).presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj V)))),
    (∀ (r : Fin δ), z_node r ∈ V →
      ∀ (hP₀ : IsClosed ({P₀ r} : Set (E_norm (α₀ r))))
        (hP₁ : IsClosed ({P₁ r} : Set (E_norm (α₁ r))))
        (h_in₀ : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
          (TopologicalSpace.Opens.map (pt_E (α₀ r) (P₀ r) hP₀).base).obj
            ((TopologicalSpace.Opens.map (ν (α₀ r)).base).obj V))
        (h_in₁ : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
          (TopologicalSpace.Opens.map (pt_E (α₁ r) (P₁ r) hP₁).base).obj
            ((TopologicalSpace.Opens.map (ν (α₁ r)).base).obj V)),
        weilPointEvalRingHom (pt_E (α₀ r) (P₀ r) hP₀) _ h_in₀ (s_tilde (α₀ r)) =
          weilPointEvalRingHom (pt_E (α₁ r) (P₁ r) hP₁) _ h_in₁ (s_tilde (α₁ r))) →
    ∃ s : ↑(C.presheaf.obj (Opposite.op V)),
      ∀ α : Fin (c + 1), ((ν α).app V).hom s = s_tilde α) ∧
  (∀ (V : C.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
      (hW : ∀ α : Fin (c + 1),
        AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map (ν α).base).obj V))
      (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op V)))
      (r : Fin δ)
      (p₀ : PrimeSpectrum ↑((E_norm (α₀ r)).presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map (ν (α₀ r)).base).obj V))))
      (p₁ : PrimeSpectrum ↑((E_norm (α₁ r)).presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map (ν (α₁ r)).base).obj V))))
      (b₀ b₁ : ↑(C.presheaf.obj (Opposite.op V))),
    hV.fromSpec.base p_x = z_node r →
    (hW (α₀ r)).fromSpec.base p₀ = P₀ r →
    (hW (α₁ r)).fromSpec.base p₁ = P₁ r →
    ((ν (α₀ r)).app V).hom b₀ ∈ p₀.asIdeal →
    ((ν (α₀ r)).app V).hom b₀ ∉ p₀.asIdeal ^ 2 →
    ((ν (α₁ r)).app V).hom b₀ ∈ p₁.asIdeal ^ 2 →
    ((ν (α₀ r)).app V).hom b₁ ∈ p₀.asIdeal ^ 2 →
    ((ν (α₁ r)).app V).hom b₁ ∈ p₁.asIdeal →
    ((ν (α₁ r)).app V).hom b₁ ∉ p₁.asIdeal ^ 2 →
    b₀ ∈ p_x.asIdeal ∧
      b₁ ∈ p_x.asIdeal ∧
      IsLocalRing.maximalIdeal (Localization.AtPrime p_x.asIdeal) ≤
        Ideal.span ({algebraMap _ (Localization.AtPrime p_x.asIdeal) b₀,
            algebraMap _ (Localization.AtPrime p_x.asIdeal) b₁} :
            Set (Localization.AtPrime p_x.asIdeal)) ⊔
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_x.asIdeal)) ^ 2) ∧
  (∀ (V : C.Opens) (_ : AlgebraicGeometry.IsAffineOpen V)
      (α : Fin (c + 1))
      (hW : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map (ν α).base).obj V))
      (_ : Nonempty ↥((TopologicalSpace.Opens.map (ν α).base).obj V))
      (φ_V : (E_norm α).presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj V)) ⟶
          CommRingCat.of (F α)),
    AlgebraicGeometry.Spec.map φ_V ≫ hW.fromSpec = η_F α →
    ∀ (p_P : PrimeSpectrum ↑((E_norm α).presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj V))))
      (t_P : ↑((E_norm α).presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj V)))),
      IsClosed ({hW.fromSpec.base p_P} : Set (E_norm α)) →
      t_P ∈ p_P.asIdeal →
      t_P ∉ p_P.asIdeal ^ 2 →
      ∀ r : Fin δ,
        (ν α).base (hW.fromSpec.base p_P) = z_node r →
        ∃ (A' : Type u) (instRingA' : CommRing A'),
          letI : CommRing A' := instRingA'
          ∃ (u₀ : PrimeSpectrum A')
            (e₁ : AlgebraicGeometry.Spec (CommRingCat.of A') ⟶ V.toScheme)
            (e₂ : AlgebraicGeometry.Spec (CommRingCat.of A') ⟶
              AlgebraicGeometry.Spec (CommRingCat.of
                (MvPolynomial (Fin 2) Ω ⧸
                  Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
                    Set (MvPolynomial (Fin 2) Ω))))),
            AlgebraicGeometry.Etale e₁ ∧
          AlgebraicGeometry.Etale e₂ ∧
          (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
          e₁ ≫ V.ι ≫ g =
            e₂ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
          ∃ (i_br : Fin 2)
            (K_br : Type u)
            (instFieldK : Field K_br)
            (instAlgΩK : Algebra Ω K_br)
            (instAlgFK : Algebra (F α) K_br),
            letI : Field K_br := instFieldK
            letI : Algebra Ω K_br := instAlgΩK
            letI : Algebra (F α) K_br := instAlgFK
            ∃ (_ : IsScalarTower Ω (F α) K_br)
              (π_br : A' →+* K_br)
              (R_br : Subring K_br),
              let φ₁ : ↑(C.presheaf.obj (Opposite.op V)) →+* A' :=
                (V.topIso.inv ≫ e₁.appTop ≫
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A')).hom).hom
              let φ₂ : (MvPolynomial (Fin 2) Ω ⧸
                  Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
                    Set (MvPolynomial (Fin 2) Ω))) →+* A' :=
                (AlgebraicGeometry.Spec.preimage e₂).hom
              let x_br : A' := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i_br))
              letI : Algebra A' K_br := π_br.toAlgebra
              letI : (RingHom.ker π_br).IsPrime := RingHom.ker_isPrime π_br
              (∀ b : ↑(C.presheaf.obj (Opposite.op V)),
                π_br (φ₁ b) = algebraMap (F α) K_br (φ_V.hom (((ν α).app V).hom b))) ∧
              IsLocalization (RingHom.ker π_br).primeCompl K_br ∧
              (∀ a' : A', π_br a' ∈ R_br) ∧
              (∀ s : A', s ∉ u₀.asIdeal → ∃ s_inv : K_br, s_inv ∈ R_br ∧ π_br s * s_inv = 1) ∧
              (∃ w w_inv u_diff u_inv : K_br,
                w ∈ R_br ∧ w_inv ∈ R_br ∧ w * w_inv = 1 ∧
                u_diff ∈ R_br ∧ u_inv ∈ R_br ∧ u_diff * u_inv = 1 ∧
                algebraMap (F α) K_br (φ_V.hom t_P) = w * π_br x_br ∧
                KaehlerDifferential.D Ω K_br (algebraMap (F α) K_br (φ_V.hom t_P)) =
                  u_diff • KaehlerDifferential.D Ω K_br (π_br x_br)) ∧
              (∀ y : F α,
                algebraMap (F α) K_br y ∈ R_br →
                (∃ y_inv : K_br, y_inv ∈ R_br ∧ algebraMap (F α) K_br y * y_inv = 1) →
                ∃ a_num b_den : ↑((E_norm α).presheaf.obj
                    (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj V))),
                  a_num ∉ p_P.asIdeal ∧ b_den ∉ p_P.asIdeal ∧
                  φ_V.hom b_den * y = φ_V.hom a_num))
def HasNCBranchAt (Ω : Type u) [Field Ω]
    {W : AlgebraicGeometry.Scheme.{u}}
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (q₀ : ↥(CategoryTheory.Limits.pullback g_W
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (a b : ℕ) : Prop :=
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  ∃ (R₀ : CommRingCat.{u}) (p₀ : AlgebraicGeometry.Spec R₀)
    (ι_U : AlgebraicGeometry.Spec R₀ ⟶ W) (z₁ z₂ : R₀)
    (A' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec A')
    (e_U : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec R₀)
    (u v ε : A'),
    AlgebraicGeometry.IsOpenImmersion ι_U ∧
    ι_U.base p₀ = (CategoryTheory.Limits.pullback.fst g_W s_Ω).base q₀ ∧
    IsDomain R₀ ∧
    p₀.asIdeal = Ideal.span ({z₁, z₂} : Set R₀) ∧
    z₁ ≠ 0 ∧
    (∀ y : R₀, z₂ * y ∈ Ideal.span ({z₁} : Set R₀) → y ∈ Ideal.span ({z₁} : Set R₀)) ∧
    (∀ r : R₀, ∃ c : Ω,
      r - (AlgebraicGeometry.Spec.preimage (ι_U ≫ g_W)).hom (PowerSeries.C c) ∈ p₀.asIdeal) ∧
    AlgebraicGeometry.Etale e_U ∧
    IsDomain A' ∧
    e_U.base ⁻¹' {p₀} = {v₀} ∧
    v₀.asIdeal = Ideal.span ({u, v} : Set A') ∧
    u ≠ 0 ∧
    (∀ y : A', v * y ∈ Ideal.span ({u} : Set A') → y ∈ Ideal.span ({u} : Set A')) ∧
    (∀ r' : A', ∃ c : Ω,
      r' - (AlgebraicGeometry.Spec.preimage (e_U ≫ ι_U ≫ g_W)).hom (PowerSeries.C c) ∈ v₀.asIdeal) ∧
    IsUnit ε ∧
    1 ≤ a ∧
    (AlgebraicGeometry.Spec.preimage (e_U ≫ ι_U ≫ g_W)).hom PowerSeries.X = ε * u ^ a * v ^ b

def IsNC2DPointedSurface (Ω : Type u) [Field Ω] (n : ℕ)
    {W : AlgebraicGeometry.Scheme.{u}}
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W)) : Prop :=
  let η_K := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  AlgebraicGeometry.IsIntegral W ∧
  AlgebraicGeometry.Flat g_W ∧
  AlgebraicGeometry.IsProper g_W ∧
  AlgebraicGeometry.LocallyOfFinitePresentation g_W ∧
  AlgebraicGeometry.Surjective g_W ∧
  AlgebraicGeometry.SmoothOfRelativeDimension 1 (CategoryTheory.Limits.pullback.snd g_W η_K) ∧
  (∀ j : Fin n, τ_W j ≫ g_W = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))) ∧
  (_root_.Pairwise fun i j : Fin n =>
    Disjoint (Set.range (τ_W i).base) (Set.range (τ_W j).base)) ∧
  (∀ q₀ : ↥(CategoryTheory.Limits.pullback g_W s_Ω),
    IsClosed ({q₀} : Set ↥(CategoryTheory.Limits.pullback g_W s_Ω)) →
    ∃ a b : ℕ, HasNCBranchAt Ω g_W q₀ a b)

def IsNC2DClosedPointBlowup (Ω : Type u) [Field Ω] (n : ℕ)
    {W W' : AlgebraicGeometry.Scheme.{u}}
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
    (g_W' : W' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W'))
    (q₀ : ↥(CategoryTheory.Limits.pullback g_W
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (π : W' ⟶ W) : Prop :=
  let η_K := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  let w₀ := (CategoryTheory.Limits.pullback.fst g_W s_Ω).base q₀
  IsClosed ({q₀} : Set ↥(CategoryTheory.Limits.pullback g_W s_Ω)) ∧
  IsNC2DPointedSurface Ω n g_W' τ_W' ∧
  π ≫ g_W = g_W' ∧
  (∀ j : Fin n, τ_W' j ≫ π = τ_W j) ∧
  AlgebraicGeometry.IsProper π ∧
  AlgebraicGeometry.Surjective π ∧
  (∀ (v_K : CategoryTheory.Limits.pullback g_W' η_K ⟶ CategoryTheory.Limits.pullback g_W η_K),
    v_K ≫ CategoryTheory.Limits.pullback.fst g_W η_K =
      CategoryTheory.Limits.pullback.fst g_W' η_K ≫ π →
    v_K ≫ CategoryTheory.Limits.pullback.snd g_W η_K =
      CategoryTheory.Limits.pullback.snd g_W' η_K →
    CategoryTheory.IsIso v_K) ∧
  (∀ U : W.Opens, w₀ ∉ (U : Set ↥W) → CategoryTheory.IsIso (π ∣_ U)) ∧
  (∀ U : W.Opens, CategoryTheory.IsIso (π.app U)) ∧
  ∃ (E_exc : Set ↥(CategoryTheory.Limits.pullback g_W' s_Ω))
    (η_exc : ↥(CategoryTheory.Limits.pullback g_W' s_Ω))
    (ι_exc : (weilProjectiveSpaceOver Ω 1).left ⟶ CategoryTheory.Limits.pullback g_W' s_Ω)
    (R₀ R₁ R₂ : CommRingCat.{u}) (p₀ : AlgebraicGeometry.Spec R₀)
    (ι₀ : AlgebraicGeometry.Spec R₀ ⟶ W)
    (ι₁ : AlgebraicGeometry.Spec R₁ ⟶ W')
    (ι₂ : AlgebraicGeometry.Spec R₂ ⟶ W')
    (φ₁ : R₀ ⟶ R₁) (φ₂ : R₀ ⟶ R₂)
    (z₁ z₂ : R₀) (s₁ : R₁) (s₂ : R₂),
    E_exc ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_W' s_Ω) ∧
    IsGenericPoint η_exc E_exc ∧
    AlgebraicGeometry.IsClosedImmersion ι_exc ∧
    Set.range ι_exc.base = E_exc ∧
    ι_exc ≫ CategoryTheory.Limits.pullback.snd g_W' s_Ω = (weilProjectiveSpaceOver Ω 1).hom ∧
    (CategoryTheory.Limits.pullback.fst g_W' s_Ω).base ⁻¹' (π.base ⁻¹' {w₀}) = E_exc ∧
    π.base ⁻¹' {w₀} = (CategoryTheory.Limits.pullback.fst g_W' s_Ω).base '' E_exc ∧
    AlgebraicGeometry.IsOpenImmersion ι₀ ∧
    AlgebraicGeometry.IsOpenImmersion ι₁ ∧
    AlgebraicGeometry.IsOpenImmersion ι₂ ∧
    IsDomain R₀ ∧ IsDomain R₁ ∧ IsDomain R₂ ∧
    ι₀.base p₀ = w₀ ∧
    p₀.asIdeal = Ideal.span ({z₁, z₂} : Set R₀) ∧
    (∀ r : R₀, ∃ c : Ω,
      r - (AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_W)).hom (PowerSeries.C c) ∈ p₀.asIdeal) ∧
    ι₁ ≫ π = AlgebraicGeometry.Spec.map φ₁ ≫ ι₀ ∧
    ι₂ ≫ π = AlgebraicGeometry.Spec.map φ₂ ≫ ι₀ ∧
    π.base ⁻¹' (Set.range ι₀.base) = Set.range ι₁.base ∪ Set.range ι₂.base ∧
    φ₁.hom z₁ ≠ 0 ∧
    φ₁.hom z₂ = φ₁.hom z₁ * s₁ ∧
    φ₂.hom z₂ ≠ 0 ∧
    φ₂.hom z₁ = φ₂.hom z₂ * s₂ ∧
    (∃ q_exc : AlgebraicGeometry.Spec R₁,
      q_exc.asIdeal = Ideal.span ({φ₁.hom z₁} : Set R₁) ∧
      ι₁.base q_exc = (CategoryTheory.Limits.pullback.fst g_W' s_Ω).base η_exc ∧
      (∀ c : Ω,
        s₁ - (AlgebraicGeometry.Spec.preimage (ι₁ ≫ g_W')).hom (PowerSeries.C c) ∉
          q_exc.asIdeal) ∧
      ((∀ y : R₁, y ∉ q_exc.asIdeal →
          y * (AlgebraicGeometry.Spec.preimage (ι₁ ≫ g_W')).hom PowerSeries.X ∉
            Ideal.span ({(φ₁.hom z₁) ^ 2} : Set R₁)) →
        {q : ↥(CategoryTheory.Limits.pullback g_W' s_Ω) |
          q ∈ E_exc ∧ IsClosed ({q} : Set ↥(CategoryTheory.Limits.pullback g_W' s_Ω)) ∧
          ∃ a b : ℕ, 1 ≤ b ∧ HasNCBranchAt Ω g_W' q a b}.Subsingleton))

def IsNC2DBlowupTower (Ω : Type u) [Field Ω] (n : ℕ)
    {C_base : AlgebraicGeometry.Scheme.{u}}
    (g_base : C_base ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_base : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C_base))
    (k : ℕ)
    (W_seq : Fin (k + 1) → AlgebraicGeometry.Scheme.{u})
    (g_seq : ∀ i : Fin (k + 1), W_seq i ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_seq : ∀ i : Fin (k + 1), Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W_seq i))
    (centers : ∀ i : Fin k,
      ↥(CategoryTheory.Limits.pullback (g_seq i.castSucc)
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (maps : ∀ i : Fin k, W_seq i.succ ⟶ W_seq i.castSucc)
    (π_from : ∀ i : Fin (k + 1), W_seq i ⟶ C_base) : Prop :=
  IsNC2DPointedSurface Ω n (g_seq 0) (τ_seq 0) ∧
  CategoryTheory.IsIso (π_from 0) ∧
  π_from 0 ≫ g_base = g_seq 0 ∧
  (∀ j : Fin n, τ_seq 0 j ≫ π_from 0 = τ_base j) ∧
  (∀ i : Fin k, maps i ≫ π_from i.castSucc = π_from i.succ) ∧
  (∀ i : Fin k,
    IsNC2DClosedPointBlowup Ω n (g_seq i.castSucc) (τ_seq i.castSucc)
      (g_seq i.succ) (τ_seq i.succ) (centers i) (maps i))

def HasNonclosedComponentCenters (Ω : Type u) [Field Ω]
    {W Y : AlgebraicGeometry.Scheme.{u}}
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (α_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))) : Prop :=
  let η_K := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  ∀ (V L : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V]
    [Field L] [Algebra V L] [IsFractionRing V L]
    (u_K : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ CategoryTheory.Limits.pullback g_W η_K)
    (v_W : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ W)
    (v_Y : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ Y)
    (m_V : AlgebraicGeometry.Spec (CommRingCat.of V))
    (q_W : ↥(CategoryTheory.Limits.pullback g_W s_Ω))
    (q_Y : ↥(CategoryTheory.Limits.pullback g_Y s_Ω)),
    AlgebraicGeometry.IsDominant u_K →
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ v_W =
      u_K ≫ CategoryTheory.Limits.pullback.fst g_W η_K →
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ v_Y =
      u_K ≫ α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y η_K →
    v_W ≫ g_W = v_Y ≫ g_Y →
    m_V.asIdeal = IsLocalRing.maximalIdeal V →
    v_W.base m_V = (CategoryTheory.Limits.pullback.fst g_W s_Ω).base q_W →
    v_Y.base m_V = (CategoryTheory.Limits.pullback.fst g_Y s_Ω).base q_Y →
    (∃ F' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_Ω),
      IsGenericPoint q_Y F') →
    ¬ IsClosed ({q_W} : Set ↥(CategoryTheory.Limits.pullback g_W s_Ω))
def HasWeilLciKaehlerAndNodalAlgebra.{u} : Prop :=
  (∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
      (k : ℕ) (π : MvPolynomial (Fin (k + 1)) A →+* B)
      (F : Fin k → MvPolynomial (Fin (k + 1)) A),
    π.comp MvPolynomial.C = algebraMap A B →
    Function.Surjective π →
    RingHom.ker π = Ideal.span (Set.range F) →
    let J_B : Matrix (Fin (k + 1)) (Fin k) B :=
      Matrix.of fun i j => π (MvPolynomial.pderiv i (F j))
    let q_B : (Fin (k + 1) → B) →ₗ[B] KaehlerDifferential A B :=
      LinearMap.lsum B (fun _ : Fin (k + 1) => B) B fun r =>
        LinearMap.toSpanSingleton B (KaehlerDifferential A B)
          (KaehlerDifferential.D A B (π (MvPolynomial.X r)))
    Function.Surjective q_B ∧
    LinearMap.ker q_B = LinearMap.range J_B.mulVecLin) ∧
  (∀ (A B A' D : Type u) [CommRing A] [CommRing B] [CommRing A'] [CommRing D]
      [Algebra A B] [Algebra A' D] [Algebra A A'] [Algebra B D] [Algebra A D]
      [IsScalarTower A B D] [IsScalarTower A A' D],
    (Algebra.FormallyUnramified A A' ∧ Algebra.FormallyEtale B D) ∨
      Algebra.IsPushout A A' B D →
    (∃ e_Ω : TensorProduct B D (KaehlerDifferential A B) ≃ₗ[D] KaehlerDifferential A' D,
      ∀ (d : D) (b : B),
        e_Ω (TensorProduct.tmul B d (KaehlerDifferential.D A B b)) =
          d • KaehlerDifferential.D A' D (algebraMap B D b)) ∧
    ∀ (k : ℕ) (x_B : Fin (k + 1) → B) (J_B : Matrix (Fin (k + 1)) (Fin k) B),
      let q_B : (Fin (k + 1) → B) →ₗ[B] KaehlerDifferential A B :=
        LinearMap.lsum B (fun _ : Fin (k + 1) => B) B fun r =>
          LinearMap.toSpanSingleton B (KaehlerDifferential A B)
            (KaehlerDifferential.D A B (x_B r))
      let J_D : Matrix (Fin (k + 1)) (Fin k) D := J_B.map (algebraMap B D)
      let q_D : (Fin (k + 1) → D) →ₗ[D] KaehlerDifferential A' D :=
        LinearMap.lsum D (fun _ : Fin (k + 1) => D) D fun r =>
          LinearMap.toSpanSingleton D (KaehlerDifferential A' D)
            (KaehlerDifferential.D A' D (algebraMap B D (x_B r)))
      Function.Surjective q_B →
      LinearMap.ker q_B = LinearMap.range J_B.mulVecLin →
      Function.Surjective q_D ∧
      LinearMap.ker q_D = LinearMap.range J_D.mulVecLin) ∧
  (∀ (B : Type u) [CommRing B] (Ω_mod : Type u) [AddCommGroup Ω_mod] [Module B Ω_mod]
      (k : ℕ) (J : Matrix (Fin (k + 1)) (Fin k) B)
      (q : (Fin (k + 1) → B) →ₗ[B] Ω_mod),
    Function.Surjective q →
    LinearMap.ker q = LinearMap.range J.mulVecLin →
    ∃ ψ : Ω_mod →ₗ[B] B,
      ∀ v : Fin (k + 1) → B,
        ψ (q v) = ∑ r : Fin (k + 1),
          v r * (-1) ^ (r : ℕ) * Matrix.det (J.submatrix r.succAbove id)) ∧
  (∀ (R S_sm : Type u) [CommRing R] [CommRing S_sm] [Algebra R S_sm],
    Algebra.IsStandardSmoothOfRelativeDimension 1 R S_sm →
    ∃ (k₂ : ℕ) (J₂ : Matrix (Fin (k₂ + 1)) (Fin k₂) S_sm)
      (q₂ : (Fin (k₂ + 1) → S_sm) →ₗ[S_sm] KaehlerDifferential R S_sm),
      Function.Surjective q₂ ∧
      LinearMap.ker q₂ = LinearMap.range J₂.mulVecLin ∧
      Function.Injective J₂.mulVecLin ∧
      IsUnit (Matrix.det (J₂.submatrix (0 : Fin (k₂ + 1)).succAbove id))) ∧
  (∀ (Ω A'' : Type u) [CommRing Ω] [CommRing A'']
      (φ₂ : (MvPolynomial (Fin 2) Ω ⧸
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))) →+* A''),
    RingHom.Flat φ₂ →
    let x₀ : A'' := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
    let x₁ : A'' := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
    let J_node : Matrix (Fin 2) (Fin 1) A'' :=
      Matrix.of fun (i : Fin 2) (_ : Fin 1) => Fin.cases x₁ (fun _ => x₀) i
    Function.Injective J_node.mulVecLin ∧
    (∀ [Algebra Ω A''],
      φ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap Ω A'' →
      RingHom.Etale φ₂ →
      let q_node : (Fin 2 → A'') →ₗ[A''] KaehlerDifferential Ω A'' :=
        LinearMap.lsum A'' (fun _ : Fin 2 => A'') A'' fun r =>
          LinearMap.toSpanSingleton A'' (KaehlerDifferential Ω A'')
            (KaehlerDifferential.D Ω A'' (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X r))))
      Function.Surjective q_node ∧
      LinearMap.ker q_node = LinearMap.range J_node.mulVecLin)) ∧
  (∀ (R S : Type u) [CommRing R] [CommRing S] (φ : R →+* S),
    RingHom.Flat φ →
    (∀ (Q : Ideal S) [Q.IsPrime] (P : Ideal R) [P.IsPrime],
      P = Ideal.comap φ Q →
      ∀ r : R, φ r = 0 → algebraMap R (Localization.AtPrime P) r = 0) ∧
    (∀ t : R, (∀ r : R, r * t = 0 → r = 0) → ∀ s : S, s * φ t = 0 → s = 0))

def HasWeilSeparatedAffineAndFiberPushout.{u} : Prop :=
  (∀ (X Y : AlgebraicGeometry.Scheme.{u}) (g : X ⟶ Y),
    AlgebraicGeometry.IsProper g →
    Y.IsSeparated → X.IsSeparated) ∧
  (∀ (X : AlgebraicGeometry.Scheme.{u}),
    X.IsSeparated →
    ∀ (U₁ U₂ : X.Opens),
      AlgebraicGeometry.IsAffineOpen U₁ →
      AlgebraicGeometry.IsAffineOpen U₂ →
      AlgebraicGeometry.IsAffineOpen (U₁ ⊓ U₂)) ∧
  (∀ (X : AlgebraicGeometry.Scheme.{u}) (U₁ U₂ : X.Opens),
    AlgebraicGeometry.IsAffineOpen U₁ →
    AlgebraicGeometry.IsAffineOpen U₂ →
    ∀ (h : U₂ ≤ U₁),
      RingHom.Etale (X.presheaf.map (CategoryTheory.homOfLE h).op).hom ∧
      RingHom.Flat (X.presheaf.map (CategoryTheory.homOfLE h).op).hom) ∧
  (∀ (X Y : AlgebraicGeometry.Scheme.{u}) (g : X ⟶ Y),
    AlgebraicGeometry.Flat g →
    ∀ (U : Y.Opens) (W : X.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      AlgebraicGeometry.IsAffineOpen W →
      ∀ (hW : W ≤ (TopologicalSpace.Opens.map g.base).obj U),
        RingHom.Flat (g.appLE U W hW).hom) ∧
  (∀ (X Y : AlgebraicGeometry.Scheme.{u}) (g : X ⟶ Y),
    AlgebraicGeometry.Etale g →
    ∀ (U : Y.Opens) (W : X.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      AlgebraicGeometry.IsAffineOpen W →
      ∀ (hW : W ≤ (TopologicalSpace.Opens.map g.base).obj U),
        RingHom.Etale (g.appLE U W hW).hom ∧
        RingHom.Flat (g.appLE U W hW).hom) ∧
  (∀ (X : AlgebraicGeometry.Scheme.{u}) (V : X.Opens),
    AlgebraicGeometry.IsAffineOpen V →
    ∀ (A' : Type u) [CommRing A']
      (e₁ : AlgebraicGeometry.Spec (CommRingCat.of A') ⟶ V.toScheme),
      AlgebraicGeometry.Etale e₁ →
      RingHom.Etale ((V.topIso.inv ≫ e₁.appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A')).hom).hom) ∧
      RingHom.Flat ((V.topIso.inv ≫ e₁.appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A')).hom).hom)) ∧
  (∀ (R₀ A' : Type u) [CommRing R₀] [CommRing A']
      (e₂ : AlgebraicGeometry.Spec (CommRingCat.of A') ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₀)),
    AlgebraicGeometry.Etale e₂ →
    RingHom.Etale (AlgebraicGeometry.Spec.preimage e₂).hom ∧
    RingHom.Flat (AlgebraicGeometry.Spec.preimage e₂).hom) ∧
  (∀ (Ω : Type u) [Field Ω] (Y : AlgebraicGeometry.Scheme.{u})
      (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (W₀ V_sm : Y.Opens),
    AlgebraicGeometry.IsAffineOpen W₀ →
    AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p) →
    ∀ y : Y, y ∈ W₀ → y ∈ V_sm →
      ∃ (V_std : Y.Opens),
        V_std ≤ W₀ ∧
        y ∈ V_std ∧
        AlgebraicGeometry.IsAffineOpen V_std ∧
        letI : Algebra Ω ↑(Y.presheaf.obj (Opposite.op V_std)) :=
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            p.appLE ⊤ V_std (fun _ _ => trivial)).hom).toAlgebra
        Algebra.IsStandardSmoothOfRelativeDimension 1 Ω ↑(Y.presheaf.obj (Opposite.op V_std))) ∧
  (∀ (C S : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S)
      (U : S.Opens) (W : C.Opens),
    AlgebraicGeometry.IsAffineOpen U →
    AlgebraicGeometry.IsAffineOpen W →
    ∀ (hWU : W ≤ (TopologicalSpace.Opens.map g.base).obj U)
      (R₀ : Type u) [CommRing R₀]
      [Algebra ↑(S.presheaf.obj (Opposite.op U)) R₀]
      (s : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ S)
      (hs : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of R₀)).Opens) ≤
        (TopologicalSpace.Opens.map s.base).obj U),
      (s.appLE U ⊤ hs ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom).hom =
        algebraMap ↑(S.presheaf.obj (Opposite.op U)) R₀ →
      let C_R := CategoryTheory.Limits.pullback g s
      let fst := CategoryTheory.Limits.pullback.fst g s
      let snd := CategoryTheory.Limits.pullback.snd g s
      ∀ (W' : C_R.Opens) (hW' : W' = (TopologicalSpace.Opens.map fst.base).obj W),
        let A := ↑(S.presheaf.obj (Opposite.op U))
        let D := ↑(C.presheaf.obj (Opposite.op W))
        let D_R := ↑(C_R.presheaf.obj (Opposite.op W'))
        letI : Algebra A D := (g.appLE U W hWU).hom.toAlgebra
        letI : Algebra R₀ D_R :=
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
            snd.appLE ⊤ W' (fun _ _ => trivial)).hom).toAlgebra
        letI : Algebra D D_R := (fst.appLE W W' (le_of_eq hW')).hom.toAlgebra
        letI : Algebra A D_R :=
          ((fst.appLE W W' (le_of_eq hW')).hom.comp (g.appLE U W hWU).hom).toAlgebra
        AlgebraicGeometry.IsAffineOpen W' ∧
        ∃ (_ : IsScalarTower A D D_R) (_ : IsScalarTower A R₀ D_R),
          Algebra.IsPushout A R₀ D D_R ∧
          ∃ e_push : TensorProduct A D R₀ ≃+* D_R,
            ∀ (d : D) (r₀ : R₀),
              e_push (TensorProduct.tmul A d r₀) =
                (fst.appLE W W' (le_of_eq hW')).hom d *
                  (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
                    snd.appLE ⊤ W' (fun _ _ => trivial)).hom r₀)) ∧
  (∀ (X Y : AlgebraicGeometry.Scheme.{u}) (f : X ⟶ Y)
      (V₁ V₂ : Y.Opens) (U₁ U₂ : X.Opens),
    AlgebraicGeometry.IsAffineOpen V₁ →
    AlgebraicGeometry.IsAffineOpen V₂ →
    AlgebraicGeometry.IsAffineOpen U₁ →
    AlgebraicGeometry.IsAffineOpen U₂ →
    ∀ (hV : V₂ ≤ V₁) (hU : U₂ ≤ U₁)
      (hU₁ : U₁ = (TopologicalSpace.Opens.map f.base).obj V₁)
      (hU₂ : U₂ = (TopologicalSpace.Opens.map f.base).obj V₂),
      let B₁ := ↑(Y.presheaf.obj (Opposite.op V₁))
      let B₂ := ↑(Y.presheaf.obj (Opposite.op V₂))
      let A₁ := ↑(X.presheaf.obj (Opposite.op U₁))
      let A₂ := ↑(X.presheaf.obj (Opposite.op U₂))
      letI : Algebra B₁ A₁ := (f.appLE V₁ U₁ (le_of_eq hU₁)).hom.toAlgebra
      letI : Algebra B₁ B₂ := (Y.presheaf.map (CategoryTheory.homOfLE hV).op).hom.toAlgebra
      ∃ e_pre : TensorProduct B₁ A₁ B₂ ≃+* A₂,
        ∀ (a₁ : A₁) (b₂ : B₂),
          e_pre (TensorProduct.tmul B₁ a₁ b₂) =
            (X.presheaf.map (CategoryTheory.homOfLE hU).op).hom a₁ *
              (f.appLE V₂ U₂ (le_of_eq hU₂)).hom b₂)
def IsAffinePowerSeriesPointBlowup (Ω : Type u) [Field Ω]
    {A : Type u} [CommRing A]
    (φ_R : PowerSeries Ω →+* A)
    (m_A : Ideal A)
    {U_tilde : AlgebraicGeometry.Scheme.{u}}
    (π_U : U_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of A)) : Prop :=
  AlgebraicGeometry.IsIntegral U_tilde ∧
  AlgebraicGeometry.Flat
    (π_U ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R)) ∧
  AlgebraicGeometry.LocallyOfFinitePresentation
    (π_U ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R)) ∧
  AlgebraicGeometry.IsProper π_U ∧
  AlgebraicGeometry.Surjective π_U ∧
  CategoryTheory.IsIso
    (π_U ∣_ ⟨(PrimeSpectrum.zeroLocus (m_A : Set A))ᶜ,
      (PrimeSpectrum.isClosed_zeroLocus (m_A : Set A)).isOpen_compl⟩) ∧
  (∃ (N_cov : ℕ) (V_cov : Fin N_cov → U_tilde.Opens)
      (hAffV : ∀ ℓ : Fin N_cov, AlgebraicGeometry.IsAffineOpen (V_cov ℓ))
      (t_gen : ∀ ℓ : Fin N_cov, ↑(U_tilde.presheaf.obj (Opposite.op (V_cov ℓ)))),
    (⋃ ℓ : Fin N_cov, (V_cov ℓ : Set U_tilde)) = Set.univ ∧
    ∀ ℓ : Fin N_cov,
      t_gen ℓ ∈ nonZeroDivisors ↑(U_tilde.presheaf.obj (Opposite.op (V_cov ℓ))) ∧
      Ideal.map (AlgebraicGeometry.Spec.preimage ((hAffV ℓ).fromSpec ≫ π_U)).hom m_A =
        Ideal.span {t_gen ℓ}) ∧
  (∀ (B : Type u) [CommRing B]
      (ψ : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A))
      (t_B : B),
    t_B ∈ nonZeroDivisors B →
    Ideal.map (AlgebraicGeometry.Spec.preimage ψ).hom m_A = Ideal.span {t_B} →
    (∃ ψ_lift : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ U_tilde, ψ_lift ≫ π_U = ψ) ∧
    (∀ ψ₁ ψ₂ : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ U_tilde,
      ψ₁ ≫ π_U = ψ → ψ₂ ≫ π_U = ψ → ψ₁ = ψ₂))
def IsCurvePlaceValuation (Ω X F : Type u) [Field Ω] [Field F] [Algebra Ω F]
    (IsPlace : X → Prop) (ord : X → F → WithTop ℤ) : Prop :=
  (∀ P : X, IsPlace P →
    (∀ f : F, ord P f = ⊤ ↔ f = 0) ∧
    (∀ x y : F, ord P (x * y) = ord P x + ord P y) ∧
    (∀ x y : F, min (ord P x) (ord P y) ≤ ord P (x + y)) ∧
    (∀ c : Ω, c ≠ 0 → ord P (algebraMap Ω F c) = 0) ∧
    (∃ ϖ : F, ord P ϖ = (1 : WithTop ℤ)) ∧
    (∀ v : F, (0 : WithTop ℤ) ≤ ord P v →
      ∃ c : Ω, (1 : WithTop ℤ) ≤ ord P (v - algebraMap Ω F c))) ∧
  (∀ f : F, f ≠ 0 → {P : X | IsPlace P ∧ ord P f ≠ 0}.Finite)

def weilRatLocalSet (Ω F : Type u) [Field Ω] [Field F] [Algebra Ω F] (t : F) (c : Ω) : Set F :=
  {u : F | ∃ P Q : Polynomial Ω,
    Polynomial.eval c Q ≠ 0 ∧ u * Polynomial.aeval t Q = Polynomial.aeval t P}

def weilSemilocalIntSet (Ω X F : Type u) [Field Ω] [Field F] [Algebra Ω F]
    (IsPlace : X → Prop) (ord : X → F → WithTop ℤ) (t : F) (c : Ω) : Set F :=
  {v : F | ∀ P : X, IsPlace P →
    (1 : WithTop ℤ) ≤ ord P (t - algebraMap Ω F c) → (0 : WithTop ℤ) ≤ ord P v}
def HasWeilIsoKaehlerTransport (R₀ : Type u) : Prop :=
  let _ := R₀
  (∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (k : ℕ)
      (π : MvPolynomial (Fin (k + 1)) A →+* B)
      (F : Fin k → MvPolynomial (Fin (k + 1)) A),
    π.comp MvPolynomial.C = algebraMap A B →
    Function.Surjective π →
    RingHom.ker π = Ideal.span (Set.range F) →
    let q_B : (Fin (k + 1) → B) →ₗ[B] KaehlerDifferential A B :=
      Fintype.linearCombination B fun r : Fin (k + 1) =>
        KaehlerDifferential.D A B (π (MvPolynomial.X r))
    let J_B : Matrix (Fin (k + 1)) (Fin k) B :=
      Matrix.of fun (i : Fin (k + 1)) (j : Fin k) => π (MvPolynomial.pderiv i (F j))
    Function.Surjective q_B ∧ LinearMap.ker q_B = LinearMap.range J_B.mulVecLin) ∧
  (∀ (A A' B B' : Type u) [CommRing A] [CommRing A'] [CommRing B] [CommRing B']
      [Algebra A A'] [Algebra A B] [Algebra A B'] [Algebra A' B'] [Algebra B B']
      [IsScalarTower A A' B'] [IsScalarTower A B B'] [Algebra.IsPushout A A' B B'],
    (∀ (k : ℕ) (x : Fin (k + 1) → B) (J : Matrix (Fin (k + 1)) (Fin k) B),
      let q_B : (Fin (k + 1) → B) →ₗ[B] KaehlerDifferential A B :=
        Fintype.linearCombination B fun r : Fin (k + 1) => KaehlerDifferential.D A B (x r)
      let q_B' : (Fin (k + 1) → B') →ₗ[B'] KaehlerDifferential A' B' :=
        Fintype.linearCombination B' fun r : Fin (k + 1) =>
          KaehlerDifferential.D A' B' (algebraMap B B' (x r))
      let J_B' : Matrix (Fin (k + 1)) (Fin k) B' := J.map (algebraMap B B')
      Function.Surjective q_B →
      LinearMap.ker q_B = LinearMap.range J.mulVecLin →
      Function.Surjective q_B' ∧ LinearMap.ker q_B' = LinearMap.range J_B'.mulVecLin) ∧
    (∀ (ψ : KaehlerDifferential A B →ₗ[B] B),
      ∃ (ψ' : KaehlerDifferential A' B' →ₗ[B'] B'),
        ∀ b : B,
          ψ' (KaehlerDifferential.D A' B' (algebraMap B B' b)) =
            algebraMap B B' (ψ (KaehlerDifferential.D A B b)))) ∧
  (∀ (R' A' B' D : Type u) [CommRing R'] [CommRing A'] [CommRing B'] [CommRing D]
      [Algebra R' A'] [Algebra R' D] [Algebra A' B'] [Algebra A' D] [Algebra B' D]
      [IsScalarTower R' A' D] [IsScalarTower A' B' D]
      [Algebra.FormallyUnramified R' A'] [Algebra.FormallyEtale B' D],
    (∀ (k : ℕ) (x : Fin (k + 1) → B') (J : Matrix (Fin (k + 1)) (Fin k) B'),
      let q_B' : (Fin (k + 1) → B') →ₗ[B'] KaehlerDifferential A' B' :=
        Fintype.linearCombination B' fun r : Fin (k + 1) => KaehlerDifferential.D A' B' (x r)
      let q_D : (Fin (k + 1) → D) →ₗ[D] KaehlerDifferential R' D :=
        Fintype.linearCombination D fun r : Fin (k + 1) =>
          KaehlerDifferential.D R' D (algebraMap B' D (x r))
      let J_D : Matrix (Fin (k + 1)) (Fin k) D := J.map (algebraMap B' D)
      Function.Surjective q_B' →
      LinearMap.ker q_B' = LinearMap.range J.mulVecLin →
      Function.Surjective q_D ∧ LinearMap.ker q_D = LinearMap.range J_D.mulVecLin) ∧
    (∀ (ψ' : KaehlerDifferential A' B' →ₗ[B'] B'),
      ∃ (ψ_D : KaehlerDifferential R' D →ₗ[D] D),
        ∀ b' : B',
          ψ_D (KaehlerDifferential.D R' D (algebraMap B' D b')) =
            algebraMap B' D (ψ' (KaehlerDifferential.D A' B' b'))))

def IsPulledBackChartLogFunctional {R R' : Type u} [CommRing R] [CommRing R']
    {C X' : AlgebraicGeometry.Scheme.{u}}
    (p' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of R'))
    (f_C : X' ⟶ C)
    (U : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens)
    (V : C.Opens) (k : ℕ)
    (π : MvPolynomial (Fin (k + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U)) →+*
      ↑(C.presheaf.obj (Opposite.op V)))
    (F : Fin k → MvPolynomial (Fin (k + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U)))
    (t : ↑(C.presheaf.obj (Opposite.op V)))
    (W : X'.Opens)
    (hW_le : W ≤ (TopologicalSpace.Opens.map f_C.base).obj V)
    (δ_log : ↑(X'.presheaf.obj (Opposite.op W)) → ↑(X'.presheaf.obj (Opposite.op W))) : Prop :=
  let D := ↑(X'.presheaf.obj (Opposite.op W))
  letI : Algebra R' D :=
    ((p'.appLE ⊤ W (fun _ _ => trivial)).hom.comp
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv.hom).toAlgebra
  ∃ (ψ_log : KaehlerDifferential R' D →ₗ[D] D),
    (∀ d : D, δ_log d = ψ_log (KaehlerDifferential.D R' D d)) ∧
    (∀ r : Fin (k + 1),
      δ_log ((f_C.appLE V W hW_le).hom (π (MvPolynomial.X r))) =
        (f_C.appLE V W hW_le).hom
          (t * (-1) ^ (r : ℕ) *
            Matrix.det ((Matrix.of fun (i : Fin (k + 1)) (j : Fin k) =>
              π (MvPolynomial.pderiv i (F j))).submatrix r.succAbove id))) ∧
    (∀ ω : KaehlerDifferential R' D,
      ∃ v : Fin (k + 1) → D,
        ω = ∑ r : Fin (k + 1),
          v r • KaehlerDifferential.D R' D ((f_C.appLE V W hW_le).hom (π (MvPolynomial.X r)))) ∧
    (∀ z : D, (∀ d : D, δ_log d * z = 0) → z = 0)
def IsPowerSeriesNodalBlowupRingPkg (Ω : Type u) [Field Ω] (m : ℕ)
    (L Laur : Type u) [CommRing L] [CommRing Laur]
    (p₀ p₁ : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m) →+*
      weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ 1))
    (p₂ : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m) →+*
      weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ (m - 2)))
    (ι_base : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m) →+* L)
    (ι₀ ι₁ : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ 1) →+* L)
    (ι₂ : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ (m - 2)) →+* L)
    (φ_Laur : PowerSeries Ω →+* Laur) (ξ ξ_inv : Laur)
    (f_02 f_12 : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ 1) →+* Laur)
    (f_20 f_21 : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ (m - 2)) →+* Laur) :
    Prop :=
  let RStar := PowerSeries Ω
  let X_ps : RStar := PowerSeries.X
  let J_m := weilNodalIdeal RStar (X_ps ^ m)
  let J_1 := weilNodalIdeal RStar (X_ps ^ 1)
  let J_m2 := weilNodalIdeal RStar (X_ps ^ (m - 2))
  let P_m := weilNodalQuot RStar (X_ps ^ m)
  let I_nod : Ideal P_m := Ideal.span
    {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
     Ideal.Quotient.mk J_m (MvPolynomial.X 1),
     Ideal.Quotient.mk J_m (MvPolynomial.C X_ps)}
  2 ≤ m ∧
  IsDomain L ∧
  IsDomain Laur ∧
  (∀ k : ℕ,
    IsDomain (weilNodalQuot RStar (X_ps ^ k)) ∧
    ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))).comp MvPolynomial.C).Flat ∧
    ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))).comp MvPolynomial.C).FinitePresentation) ∧
  Function.Injective ι_base ∧
  Function.Injective ι₀ ∧
  Function.Injective ι₁ ∧
  Function.Injective ι₂ ∧
  @IsLocalization.Away P_m _ (Ideal.Quotient.mk J_m (MvPolynomial.C X_ps)) L _ ι_base.toAlgebra ∧
  ι₀.comp p₀ = ι_base ∧
  ι₁.comp p₁ = ι_base ∧
  ι₂.comp p₂ = ι_base ∧
  (∀ c : RStar,
    p₀ (Ideal.Quotient.mk J_m (MvPolynomial.C c)) = Ideal.Quotient.mk J_1 (MvPolynomial.C c) ∧
    p₁ (Ideal.Quotient.mk J_m (MvPolynomial.C c)) = Ideal.Quotient.mk J_1 (MvPolynomial.C c) ∧
    p₂ (Ideal.Quotient.mk J_m (MvPolynomial.C c)) = Ideal.Quotient.mk J_m2 (MvPolynomial.C c)) ∧
  p₀ (Ideal.Quotient.mk J_m (MvPolynomial.X 0)) = Ideal.Quotient.mk J_1 (MvPolynomial.X 0) ∧
  p₀ (Ideal.Quotient.mk J_m (MvPolynomial.X 1)) =
    Ideal.Quotient.mk J_1 (MvPolynomial.C (X_ps ^ (m - 1)) * MvPolynomial.X 1) ∧
  p₁ (Ideal.Quotient.mk J_m (MvPolynomial.X 0)) =
    Ideal.Quotient.mk J_1 (MvPolynomial.C (X_ps ^ (m - 1)) * MvPolynomial.X 0) ∧
  p₁ (Ideal.Quotient.mk J_m (MvPolynomial.X 1)) = Ideal.Quotient.mk J_1 (MvPolynomial.X 1) ∧
  p₂ (Ideal.Quotient.mk J_m (MvPolynomial.X 0)) =
    Ideal.Quotient.mk J_m2 (MvPolynomial.C X_ps * MvPolynomial.X 0) ∧
  p₂ (Ideal.Quotient.mk J_m (MvPolynomial.X 1)) =
    Ideal.Quotient.mk J_m2 (MvPolynomial.C X_ps * MvPolynomial.X 1) ∧
  Ideal.Quotient.mk J_1 (MvPolynomial.X 0) ∈ nonZeroDivisors (weilNodalQuot RStar (X_ps ^ 1)) ∧
  Ideal.map p₀ I_nod = Ideal.span {Ideal.Quotient.mk J_1 (MvPolynomial.X 0)} ∧
  Ideal.Quotient.mk J_1 (MvPolynomial.X 1) ∈ nonZeroDivisors (weilNodalQuot RStar (X_ps ^ 1)) ∧
  Ideal.map p₁ I_nod = Ideal.span {Ideal.Quotient.mk J_1 (MvPolynomial.X 1)} ∧
  Ideal.Quotient.mk J_m2 (MvPolynomial.C X_ps) ∈
    nonZeroDivisors (weilNodalQuot RStar (X_ps ^ (m - 2))) ∧
  Ideal.map p₂ I_nod = Ideal.span {Ideal.Quotient.mk J_m2 (MvPolynomial.C X_ps)} ∧
  (∀ (C_loc : Type u) [CommRing C_loc] [Algebra (weilNodalQuot RStar (X_ps ^ 1)) C_loc],
    IsLocalization.Away (p₀ (Ideal.Quotient.mk J_m (MvPolynomial.X 0))) C_loc →
    @IsLocalization.Away P_m _ (Ideal.Quotient.mk J_m (MvPolynomial.X 0)) C_loc _
      ((algebraMap (weilNodalQuot RStar (X_ps ^ 1)) C_loc).comp p₀).toAlgebra) ∧
  (∀ (C_loc : Type u) [CommRing C_loc] [Algebra (weilNodalQuot RStar (X_ps ^ 1)) C_loc],
    IsLocalization.Away (p₁ (Ideal.Quotient.mk J_m (MvPolynomial.X 1))) C_loc →
    @IsLocalization.Away P_m _ (Ideal.Quotient.mk J_m (MvPolynomial.X 1)) C_loc _
      ((algebraMap (weilNodalQuot RStar (X_ps ^ 1)) C_loc).comp p₁).toAlgebra) ∧
  (∀ (C_loc : Type u) [CommRing C_loc] [Algebra (weilNodalQuot RStar (X_ps ^ (m - 2))) C_loc],
    IsLocalization.Away (p₂ (Ideal.Quotient.mk J_m (MvPolynomial.C X_ps))) C_loc →
    @IsLocalization.Away P_m _ (Ideal.Quotient.mk J_m (MvPolynomial.C X_ps)) C_loc _
      ((algebraMap (weilNodalQuot RStar (X_ps ^ (m - 2))) C_loc).comp p₂).toAlgebra) ∧
  (∀ z : L, (∃ c₀, ι₀ c₀ = z) → (∃ c₁, ι₁ c₁ = z) → ∃ a : P_m, ι_base a = z) ∧
  (∀ (B : Type u) [CommRing B] (θ : P_m →+* B) (d : B),
    d ∈ nonZeroDivisors B →
    Ideal.map θ I_nod = Ideal.span {d} →
    ∃ (b₀ b₁ b₂ : B),
      Ideal.span {b₀, b₁, b₂} = ⊤ ∧
      (∀ (B₀ : Type u) [CommRing B₀] [Algebra B B₀],
        IsLocalization.Away b₀ B₀ →
        ∃ lam₀ : weilNodalQuot RStar (X_ps ^ 1) →+* B₀,
          lam₀.comp p₀ = (algebraMap B B₀).comp θ) ∧
      (∀ (B₁ : Type u) [CommRing B₁] [Algebra B B₁],
        IsLocalization.Away b₁ B₁ →
        ∃ lam₁ : weilNodalQuot RStar (X_ps ^ 1) →+* B₁,
          lam₁.comp p₁ = (algebraMap B B₁).comp θ) ∧
      (∀ (B₂ : Type u) [CommRing B₂] [Algebra B B₂],
        IsLocalization.Away b₂ B₂ →
        ∃ lam₂ : weilNodalQuot RStar (X_ps ^ (m - 2)) →+* B₂,
          lam₂.comp p₂ = (algebraMap B B₂).comp θ)) ∧
  ξ * ξ_inv = 1 ∧
  (∀ (A : Type u) [CommRing A] (ρ : RStar →+* A) (u u_inv : A),
    u * u_inv = 1 →
    ∃ ψ : Laur →+* A, ψ.comp φ_Laur = ρ ∧ ψ ξ = u ∧ ψ ξ_inv = u_inv) ∧
  (∃ (α_02 α_12 : Laur →+* L),
    Function.Injective α_02 ∧
    Function.Injective α_12 ∧
    α_02.comp f_02 = ι₀ ∧
    α_02.comp f_20 = ι₂ ∧
    α_12.comp f_12 = ι₁ ∧
    α_12.comp f_21 = ι₂) ∧
  (∀ c : RStar,
    f_02 (Ideal.Quotient.mk J_1 (MvPolynomial.C c)) = φ_Laur c ∧
    f_20 (Ideal.Quotient.mk J_m2 (MvPolynomial.C c)) = φ_Laur c ∧
    f_12 (Ideal.Quotient.mk J_1 (MvPolynomial.C c)) = φ_Laur c ∧
    f_21 (Ideal.Quotient.mk J_m2 (MvPolynomial.C c)) = φ_Laur c) ∧
  f_02 (Ideal.Quotient.mk J_1 (MvPolynomial.X 0)) = φ_Laur X_ps * ξ_inv ∧
  f_02 (Ideal.Quotient.mk J_1 (MvPolynomial.X 1)) = ξ ∧
  f_20 (Ideal.Quotient.mk J_m2 (MvPolynomial.X 0)) = ξ_inv ∧
  f_20 (Ideal.Quotient.mk J_m2 (MvPolynomial.X 1)) = φ_Laur (X_ps ^ (m - 2)) * ξ ∧
  f_12 (Ideal.Quotient.mk J_1 (MvPolynomial.X 0)) = ξ ∧
  f_12 (Ideal.Quotient.mk J_1 (MvPolynomial.X 1)) = φ_Laur X_ps * ξ_inv ∧
  f_21 (Ideal.Quotient.mk J_m2 (MvPolynomial.X 0)) = φ_Laur (X_ps ^ (m - 2)) * ξ ∧
  f_21 (Ideal.Quotient.mk J_m2 (MvPolynomial.X 1)) = ξ_inv

def IsPowerSeriesThreeChartBlowupData (Ω : Type u) [Field Ω] (m : ℕ)
    {M_m : AlgebraicGeometry.Scheme.{u}}
    (p_m : M_m ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
        ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω))))))
    (ι₀ ι₁ : AlgebraicGeometry.Spec (CommRingCat.of
      (weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ 1))) ⟶ M_m)
    (ι₂ : AlgebraicGeometry.Spec (CommRingCat.of
      (weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ (m - 2)))) ⟶ M_m) :
    Prop :=
  let RStar := PowerSeries Ω
  let X_ps : RStar := PowerSeries.X
  let J_m := weilNodalIdeal RStar (X_ps ^ m)
  let J_1 := weilNodalIdeal RStar (X_ps ^ 1)
  let J_m2 := weilNodalIdeal RStar (X_ps ^ (m - 2))
  let P_m := weilNodalQuot RStar (X_ps ^ m)
  M_m.IsSeparated ∧
  AlgebraicGeometry.IsOpenImmersion ι₀ ∧
  AlgebraicGeometry.IsOpenImmersion ι₁ ∧
  AlgebraicGeometry.IsOpenImmersion ι₂ ∧
  ((Set.range ι₀.base ∪ Set.range ι₁.base ∪ Set.range ι₂.base) = Set.univ) ∧
  (ι₀.base ⁻¹' Set.range ι₁.base =
    (PrimeSpectrum.basicOpen
      (Ideal.Quotient.mk J_1 (MvPolynomial.C (X_ps ^ (m - 2)) * MvPolynomial.X 1 ^ 2))).1) ∧
  (ι₁.base ⁻¹' Set.range ι₀.base =
    (PrimeSpectrum.basicOpen
      (Ideal.Quotient.mk J_1 (MvPolynomial.C (X_ps ^ (m - 2)) * MvPolynomial.X 0 ^ 2))).1) ∧
  (ι₀.base ⁻¹' Set.range ι₂.base =
    (PrimeSpectrum.basicOpen (Ideal.Quotient.mk J_1 (MvPolynomial.X 1))).1) ∧
  (ι₂.base ⁻¹' Set.range ι₀.base =
    (PrimeSpectrum.basicOpen (Ideal.Quotient.mk J_m2 (MvPolynomial.X 0))).1) ∧
  (ι₁.base ⁻¹' Set.range ι₂.base =
    (PrimeSpectrum.basicOpen (Ideal.Quotient.mk J_1 (MvPolynomial.X 0))).1) ∧
  (ι₂.base ⁻¹' Set.range ι₁.base =
    (PrimeSpectrum.basicOpen (Ideal.Quotient.mk J_m2 (MvPolynomial.X 1))).1) ∧
  ∃ (Laur : Type u) (_ : CommRing Laur)
    (φ_Laur : RStar →+* Laur) (ξ ξ_inv : Laur)
    (p₀ p₁ : P_m →+* weilNodalQuot RStar (X_ps ^ 1))
    (p₂ : P_m →+* weilNodalQuot RStar (X_ps ^ (m - 2)))
    (f_02 f_12 : weilNodalQuot RStar (X_ps ^ 1) →+* Laur)
    (f_20 f_21 : weilNodalQuot RStar (X_ps ^ (m - 2)) →+* Laur),
    ξ * ξ_inv = 1 ∧
    (∀ (A : Type u) [CommRing A] (ρ : RStar →+* A) (u u_inv : A),
      u * u_inv = 1 →
      ∃ ψ : Laur →+* A, ψ.comp φ_Laur = ρ ∧ ψ ξ = u ∧ ψ ξ_inv = u_inv) ∧
    ι₀ ≫ p_m = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀) ∧
    ι₁ ≫ p_m = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁) ∧
    ι₂ ≫ p_m = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₂) ∧
    (∀ c : RStar,
      p₀ (Ideal.Quotient.mk J_m (MvPolynomial.C c)) = Ideal.Quotient.mk J_1 (MvPolynomial.C c) ∧
      p₁ (Ideal.Quotient.mk J_m (MvPolynomial.C c)) = Ideal.Quotient.mk J_1 (MvPolynomial.C c) ∧
      p₂ (Ideal.Quotient.mk J_m (MvPolynomial.C c)) = Ideal.Quotient.mk J_m2 (MvPolynomial.C c)) ∧
    p₀ (Ideal.Quotient.mk J_m (MvPolynomial.X 0)) = Ideal.Quotient.mk J_1 (MvPolynomial.X 0) ∧
    p₀ (Ideal.Quotient.mk J_m (MvPolynomial.X 1)) =
      Ideal.Quotient.mk J_1 (MvPolynomial.C (X_ps ^ (m - 1)) * MvPolynomial.X 1) ∧
    p₁ (Ideal.Quotient.mk J_m (MvPolynomial.X 0)) =
      Ideal.Quotient.mk J_1 (MvPolynomial.C (X_ps ^ (m - 1)) * MvPolynomial.X 0) ∧
    p₁ (Ideal.Quotient.mk J_m (MvPolynomial.X 1)) = Ideal.Quotient.mk J_1 (MvPolynomial.X 1) ∧
    p₂ (Ideal.Quotient.mk J_m (MvPolynomial.X 0)) =
      Ideal.Quotient.mk J_m2 (MvPolynomial.C X_ps * MvPolynomial.X 0) ∧
    p₂ (Ideal.Quotient.mk J_m (MvPolynomial.X 1)) =
      Ideal.Quotient.mk J_m2 (MvPolynomial.C X_ps * MvPolynomial.X 1) ∧
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_02) ≫ ι₀ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_20) ≫ ι₂ ∧
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_12) ≫ ι₁ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_21) ≫ ι₂ ∧
    (∀ c : RStar,
      f_02 (Ideal.Quotient.mk J_1 (MvPolynomial.C c)) = φ_Laur c ∧
      f_20 (Ideal.Quotient.mk J_m2 (MvPolynomial.C c)) = φ_Laur c ∧
      f_12 (Ideal.Quotient.mk J_1 (MvPolynomial.C c)) = φ_Laur c ∧
      f_21 (Ideal.Quotient.mk J_m2 (MvPolynomial.C c)) = φ_Laur c) ∧
    f_02 (Ideal.Quotient.mk J_1 (MvPolynomial.X 0)) = φ_Laur X_ps * ξ_inv ∧
    f_02 (Ideal.Quotient.mk J_1 (MvPolynomial.X 1)) = ξ ∧
    f_20 (Ideal.Quotient.mk J_m2 (MvPolynomial.X 0)) = ξ_inv ∧
    f_20 (Ideal.Quotient.mk J_m2 (MvPolynomial.X 1)) = φ_Laur (X_ps ^ (m - 2)) * ξ ∧
    f_12 (Ideal.Quotient.mk J_1 (MvPolynomial.X 0)) = ξ ∧
    f_12 (Ideal.Quotient.mk J_1 (MvPolynomial.X 1)) = φ_Laur X_ps * ξ_inv ∧
    f_21 (Ideal.Quotient.mk J_m2 (MvPolynomial.X 0)) = φ_Laur (X_ps ^ (m - 2)) * ξ ∧
    f_21 (Ideal.Quotient.mk J_m2 (MvPolynomial.X 1)) = ξ_inv
structure WeilPresheafModule (X : AlgebraicGeometry.Scheme.{u}) : Type (u + 1) where
  sec : X.Opens → Type u
  instAddCommGroup : ∀ U : X.Opens, AddCommGroup (sec U)
  instModule : ∀ U : X.Opens,
    @Module ↑(X.presheaf.obj (Opposite.op U)) (sec U) _ (instAddCommGroup U).toAddCommMonoid
  res : ∀ {U W : X.Opens}, W ≤ U →
    @AddMonoidHom (sec U) (sec W)
      (instAddCommGroup U).toAddZero (instAddCommGroup W).toAddZero
  res_smul : ∀ {U W : X.Opens} (h : W ≤ U)
    (a : ↑(X.presheaf.obj (Opposite.op U))) (x : sec U),
    res h (@SMul.smul _ _ (instModule U).toSMul a x) =
      @SMul.smul _ _ (instModule W).toSMul
        ((X.presheaf.map (CategoryTheory.homOfLE h).op).hom a) (res h x)
  res_id : ∀ (U : X.Opens) (x : sec U), res (le_refl U) x = x
  res_comp : ∀ {U W T : X.Opens} (h₁ : W ≤ U) (h₂ : T ≤ W) (x : sec U),
    res h₂ (res h₁ x) = res (le_trans h₂ h₁) x

instance instAddCommGroupWeilPresheafModuleSec {X : AlgebraicGeometry.Scheme.{u}}
    (F : WeilPresheafModule X) (U : X.Opens) : AddCommGroup (F.sec U) :=
  F.instAddCommGroup U

instance instModuleWeilPresheafModuleSec {X : AlgebraicGeometry.Scheme.{u}}
    (F : WeilPresheafModule X) (U : X.Opens) :
    Module ↑(X.presheaf.obj (Opposite.op U)) (F.sec U) :=
  F.instModule U

def weilCoverChartInter {X : AlgebraicGeometry.Scheme.{u}} {m : ℕ}
    (V : Fin m → X.Opens) {p : ℕ} (α : WeilStrictMonoTuple m p) : X.Opens :=
  Finset.univ.inf' ⟨0, Finset.mem_univ (0 : Fin (p + 1))⟩ (fun k => V (α.1 k))

abbrev WeilModuleCechCochain {X : AlgebraicGeometry.Scheme.{u}} {m : ℕ}
    (V : Fin m → X.Opens) (F : WeilPresheafModule X) (p : ℕ) : Type u :=
  ∀ α : WeilStrictMonoTuple m p, F.sec (weilCoverChartInter V α)

noncomputable def weilModuleCechSmul {R : Type u} [CommRing R]
    {X : AlgebraicGeometry.Scheme.{u}}
    (g : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    {m : ℕ} (V : Fin m → X.Opens) (F : WeilPresheafModule X) (p : ℕ)
    (r : R) (c : WeilModuleCechCochain V F p) :
    WeilModuleCechCochain V F p :=
  fun α =>
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
      g.appLE ⊤ (weilCoverChartInter V α) (fun _ _ => trivial)).hom r) • c α

noncomputable def weilModuleCechDiff {X : AlgebraicGeometry.Scheme.{u}} {m : ℕ}
    (V : Fin m → X.Opens) (F : WeilPresheafModule X) (p : ℕ)
    (c : WeilModuleCechCochain V F p) :
    WeilModuleCechCochain V F (p + 1) :=
  fun β =>
    let face : Fin (p + 2) → WeilStrictMonoTuple m p :=
      fun j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
    let hFace : ∀ j : Fin (p + 2), weilCoverChartInter V β ≤ weilCoverChartInter V (face j) :=
      fun j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
    ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • F.res (hFace j) (c (face j))

def IsWeilCoherentSubChartModule {X : AlgebraicGeometry.Scheme.{u}} {m : ℕ}
    (V : Fin m → X.Opens) (F : WeilPresheafModule X) : Prop :=
  (∀ (U : X.Opens), AlgebraicGeometry.IsAffineOpen U → (∃ a : Fin m, U ≤ V a) →
    Module.Finite ↑(X.presheaf.obj (Opposite.op U)) (F.sec U)) ∧
  (∀ (U W : X.Opens), AlgebraicGeometry.IsAffineOpen U → AlgebraicGeometry.IsAffineOpen W →
    (∃ a : Fin m, U ≤ V a) → ∀ (hWU : W ≤ U),
      letI : Algebra ↑(X.presheaf.obj (Opposite.op U)) ↑(X.presheaf.obj (Opposite.op W)) :=
        RingHom.toAlgebra (X.presheaf.map (CategoryTheory.homOfLE hWU).op).hom
      ∃ (φ : TensorProduct ↑(X.presheaf.obj (Opposite.op U))
            ↑(X.presheaf.obj (Opposite.op W)) (F.sec U) ≃ₗ[↑(X.presheaf.obj (Opposite.op W))]
            F.sec W),
        ∀ (b : ↑(X.presheaf.obj (Opposite.op W))) (x : F.sec U),
          φ (TensorProduct.tmul ↑(X.presheaf.obj (Opposite.op U)) b x) = b • F.res hWU x)

def IsWeilSupportedOn {X : AlgebraicGeometry.Scheme.{u}} {m : ℕ}
    (V : Fin m → X.Opens) (F : WeilPresheafModule X)
    (S : TopologicalSpace.Closeds ↥X) : Prop :=
  ∀ (U : X.Opens), AlgebraicGeometry.IsAffineOpen U → (∃ a : Fin m, U ≤ V a) →
    Disjoint (U : Set ↥X) (S : Set ↥X) → ∀ x : F.sec U, x = 0

def IsWeilClosedSubschemeStructureModule {X : AlgebraicGeometry.Scheme.{u}}
    (I : X.IdealSheafData) (F : WeilPresheafModule X) : Prop :=
  ∃ (e : ∀ U : X.Opens,
      F.sec U ≃+ ↑(I.subscheme.presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map I.subschemeι.base).obj U)))),
    (∀ (U : X.Opens) (a : ↑(X.presheaf.obj (Opposite.op U))) (x : F.sec U),
      e U (a • x) = (I.subschemeι.app U).hom a * e U x) ∧
    (∀ {U W : X.Opens} (h : W ≤ U)
      (h' : (TopologicalSpace.Opens.map I.subschemeι.base).obj W ≤
        (TopologicalSpace.Opens.map I.subschemeι.base).obj U)
      (x : F.sec U),
      e W (F.res h x) =
        (I.subscheme.presheaf.map (CategoryTheory.homOfLE h').op).hom (e U x))

def HasFiniteWeilModuleCechCohomology {R : Type u} [CommRing R]
    {X : AlgebraicGeometry.Scheme.{u}}
    (g : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    {m : ℕ} (V : Fin m → X.Opens) (F : WeilPresheafModule X) : Prop :=
  (∃ (k₀ : ℕ) (gen₀ : Fin k₀ → WeilModuleCechCochain V F 0),
    (∀ j : Fin k₀, weilModuleCechDiff V F 0 (gen₀ j) = 0) ∧
    ∀ z : WeilModuleCechCochain V F 0,
      weilModuleCechDiff V F 0 z = 0 →
      ∃ c : Fin k₀ → R,
        z = ∑ j : Fin k₀, weilModuleCechSmul g V F 0 (c j) (gen₀ j)) ∧
  (∀ p : ℕ,
    ∃ (k : ℕ) (gen : Fin k → WeilModuleCechCochain V F (p + 1)),
      (∀ j : Fin k, weilModuleCechDiff V F (p + 1) (gen j) = 0) ∧
      ∀ z : WeilModuleCechCochain V F (p + 1),
        weilModuleCechDiff V F (p + 1) z = 0 →
        ∃ (c : Fin k → R) (b : WeilModuleCechCochain V F p),
          z = (∑ j : Fin k, weilModuleCechSmul g V F (p + 1) (c j) (gen j)) +
            weilModuleCechDiff V F p b)
def IsLinearBlowupQuot {R₀ R₁ : CommRingCat.{u}} (z₁ z₂ : R₀) (φ₁ : R₀ ⟶ R₁) (s₁ : R₁) : Prop :=
  φ₁.hom z₂ = φ₁.hom z₁ * s₁ ∧
  (∀ (B : Type u) [CommRing B] (ρ : R₀ →+* B) (t : B),
    ρ z₂ = ρ z₁ * t →
    (∃ ψ : R₁ →+* B, ψ.comp φ₁.hom = ρ ∧ ψ s₁ = t) ∧
    (∀ ψ₁ ψ₂ : R₁ →+* B,
      ψ₁.comp φ₁.hom = ρ → ψ₁ s₁ = t → ψ₂.comp φ₁.hom = ρ → ψ₂ s₁ = t → ψ₁ = ψ₂))

def IsNC2DRegularSeqBlowupRingPkg (Ω : Type u) [Field Ω]
    (R₀ R₁ R₂ L₀ : CommRingCat.{u}) (p₀ : AlgebraicGeometry.Spec R₀)
    (φ₀ : PowerSeries Ω →+* R₀) (z₁ z₂ : R₀)
    (φ_res : R₀ →+* Ω)
    (φ₁ : R₀ ⟶ R₁) (φ₂ : R₀ ⟶ R₂) (s₁ : R₁) (s₂ : R₂)
    (ι_L0 : R₀ ⟶ L₀) (ι_L1 : R₁ ⟶ L₀) (ι_L2 : R₂ ⟶ L₀)
    (ψ_exc1 : R₁ →+* Polynomial Ω) (ψ_exc2 : R₂ →+* Polynomial Ω)
    (q_exc : AlgebraicGeometry.Spec R₁) : Prop :=
  IsDomain R₀ ∧ IsDomain R₁ ∧ IsDomain R₂ ∧ IsDomain L₀ ∧
  z₁ ≠ 0 ∧ z₂ ≠ 0 ∧ z₁ * z₂ ≠ 0 ∧
  (∀ y : R₀, z₁ * y ∈ Ideal.span ({z₂} : Set R₀) → y ∈ Ideal.span ({z₂} : Set R₀)) ∧
  p₀.asIdeal.IsMaximal ∧
  PrimeSpectrum.zeroLocus (p₀.asIdeal : Set R₀) = {p₀} ∧
  Function.Surjective φ_res ∧
  RingHom.ker φ_res = p₀.asIdeal ∧
  (∀ c : Ω, φ_res (φ₀ (PowerSeries.C c)) = c) ∧
  IsLinearBlowupQuot z₁ z₂ φ₁ s₁ ∧
  IsLinearBlowupQuot z₂ z₁ φ₂ s₂ ∧
  (φ₁.hom.comp φ₀).Flat ∧ (φ₂.hom.comp φ₀).Flat ∧
  (φ₁.hom.comp φ₀).FinitePresentation ∧ (φ₂.hom.comp φ₀).FinitePresentation ∧
  φ₁.hom (φ₀ PowerSeries.X) ≠ 0 ∧
  φ₁.hom z₁ ≠ 0 ∧ φ₂.hom z₂ ≠ 0 ∧ s₁ ≠ 0 ∧ s₂ ≠ 0 ∧
  Function.Injective ι_L0.hom ∧ Function.Injective ι_L1.hom ∧ Function.Injective ι_L2.hom ∧
  φ₁ ≫ ι_L1 = ι_L0 ∧ φ₂ ≫ ι_L2 = ι_L0 ∧
  ι_L1.hom s₁ * ι_L2.hom s₂ = 1 ∧
  @IsLocalization.Away R₀ _ (z₁ * z₂) L₀ _ ι_L0.hom.toAlgebra ∧
  @IsLocalization.Away R₁ _ (φ₁.hom z₁ * s₁) L₀ _ ι_L1.hom.toAlgebra ∧
  @IsLocalization.Away R₂ _ (φ₂.hom z₂ * s₂) L₀ _ ι_L2.hom.toAlgebra ∧
  (∀ (C_loc : Type u) [CommRing C_loc] [Algebra R₁ C_loc],
    IsLocalization.Away (φ₁.hom z₁) C_loc →
    @IsLocalization.Away R₀ _ z₁ C_loc _ ((algebraMap R₁ C_loc).comp φ₁.hom).toAlgebra) ∧
  (∀ (C_loc : Type u) [CommRing C_loc] [Algebra R₂ C_loc],
    IsLocalization.Away (φ₂.hom z₂) C_loc →
    @IsLocalization.Away R₀ _ z₂ C_loc _ ((algebraMap R₂ C_loc).comp φ₂.hom).toAlgebra) ∧
  (∀ (f : R₀), f ≠ 0 →
    ∀ (x₁ : R₁) (x₂ : R₂) (k₁ k₂ : ℕ),
      ι_L1.hom x₁ * (ι_L0.hom f) ^ k₂ = ι_L2.hom x₂ * (ι_L0.hom f) ^ k₁ →
      ∃ (a₀ : R₀) (m : ℕ),
        ι_L0.hom a₀ * (ι_L0.hom f) ^ k₁ = ι_L1.hom x₁ * (ι_L0.hom f) ^ m) ∧
  Function.Surjective ψ_exc1 ∧
  RingHom.ker ψ_exc1 = Ideal.span ({φ₁.hom z₁} : Set R₁) ∧
  ψ_exc1 s₁ = Polynomial.X ∧
  (∀ r : R₀, ψ_exc1 (φ₁.hom r) = Polynomial.C (φ_res r)) ∧
  Function.Surjective ψ_exc2 ∧
  RingHom.ker ψ_exc2 = Ideal.span ({φ₂.hom z₂} : Set R₂) ∧
  ψ_exc2 s₂ = Polynomial.X ∧
  (∀ r : R₀, ψ_exc2 (φ₂.hom r) = Polynomial.C (φ_res r)) ∧
  q_exc.asIdeal = Ideal.span ({φ₁.hom z₁} : Set R₁) ∧
  (∀ c : Ω, s₁ - φ₁.hom (φ₀ (PowerSeries.C c)) ∉ q_exc.asIdeal)

def IsNC2DAffineBlowupModel (Ω : Type u) [Field Ω]
    (R₀ R₁ R₂ : CommRingCat.{u}) (p₀ : AlgebraicGeometry.Spec R₀)
    (g_R₀ : AlgebraicGeometry.Spec R₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (φ_res : R₀ →+* Ω) (φ₁ : R₀ ⟶ R₁) (φ₂ : R₀ ⟶ R₂)
    (s₁ : R₁) (s₂ : R₂) (q_exc : AlgebraicGeometry.Spec R₁)
    {U_tilde : AlgebraicGeometry.Scheme.{u}}
    (π_U : U_tilde ⟶ AlgebraicGeometry.Spec R₀)
    (ι_U1 : AlgebraicGeometry.Spec R₁ ⟶ U_tilde)
    (ι_U2 : AlgebraicGeometry.Spec R₂ ⟶ U_tilde)
    (Φ_U : (weilProjectiveSpaceOver Ω 1).left ⟶ U_tilde)
    (η_P1 : ↥(weilProjectiveSpaceOver Ω 1).left) : Prop :=
  AlgebraicGeometry.IsIntegral U_tilde ∧
  AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver Ω 1).left ∧
  AlgebraicGeometry.Flat (π_U ≫ g_R₀) ∧
  AlgebraicGeometry.LocallyOfFinitePresentation (π_U ≫ g_R₀) ∧
  AlgebraicGeometry.IsProper π_U ∧
  AlgebraicGeometry.Surjective π_U ∧
  CategoryTheory.IsIso
    (π_U ∣_ ⟨(PrimeSpectrum.zeroLocus (p₀.asIdeal : Set R₀))ᶜ,
      (PrimeSpectrum.isClosed_zeroLocus (p₀.asIdeal : Set R₀)).isOpen_compl⟩) ∧
  (∀ V : (AlgebraicGeometry.Spec R₀).Opens, CategoryTheory.IsIso (π_U.app V)) ∧
  AlgebraicGeometry.IsOpenImmersion ι_U1 ∧
  AlgebraicGeometry.IsOpenImmersion ι_U2 ∧
  Set.range ι_U1.base ∪ Set.range ι_U2.base = Set.univ ∧
  ι_U1 ≫ π_U = AlgebraicGeometry.Spec.map φ₁ ∧
  ι_U2 ≫ π_U = AlgebraicGeometry.Spec.map φ₂ ∧
  ι_U1.base '' (PrimeSpectrum.basicOpen s₁).1 = ι_U2.base '' (PrimeSpectrum.basicOpen s₂).1 ∧
  AlgebraicGeometry.IsClosedImmersion Φ_U ∧
  Φ_U ≫ π_U =
    (weilProjectiveSpaceOver Ω 1).hom ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_res) ∧
  Set.range Φ_U.base = π_U.base ⁻¹' {p₀} ∧
  IsGenericPoint η_P1 Set.univ ∧
  Φ_U.base η_P1 = ι_U1.base q_exc ∧
  (∃ y₀ y₁ : ↥(weilProjectiveSpaceOver Ω 1).left, y₀ ≠ y₁)

def IsNC2DGluedBlowupGeom (Ω : Type u) [Field Ω] (n : ℕ)
    {W W' : AlgebraicGeometry.Scheme.{u}}
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
    (g_W' : W' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W'))
    (q₀ : ↥(CategoryTheory.Limits.pullback g_W
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (π : W' ⟶ W)
    (E_exc : Set ↥(CategoryTheory.Limits.pullback g_W'
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (η_exc : ↥(CategoryTheory.Limits.pullback g_W'
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (ι_exc : (weilProjectiveSpaceOver Ω 1).left ⟶
      CategoryTheory.Limits.pullback g_W'
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))
    (R₀ R₁ R₂ : CommRingCat.{u}) (p₀ : AlgebraicGeometry.Spec R₀)
    (ι₀ : AlgebraicGeometry.Spec R₀ ⟶ W)
    (ι₁ : AlgebraicGeometry.Spec R₁ ⟶ W')
    (ι₂ : AlgebraicGeometry.Spec R₂ ⟶ W')
    (φ₁ : R₀ ⟶ R₁) (φ₂ : R₀ ⟶ R₂)
    (z₁ z₂ : R₀) (s₁ : R₁) (s₂ : R₂)
    (q_exc : AlgebraicGeometry.Spec R₁) : Prop :=
  let η_K := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  let w₀ := (CategoryTheory.Limits.pullback.fst g_W s_Ω).base q₀
  AlgebraicGeometry.IsIntegral W' ∧
  AlgebraicGeometry.Flat g_W' ∧
  AlgebraicGeometry.IsProper g_W' ∧
  AlgebraicGeometry.LocallyOfFinitePresentation g_W' ∧
  AlgebraicGeometry.Surjective g_W' ∧
  AlgebraicGeometry.SmoothOfRelativeDimension 1 (CategoryTheory.Limits.pullback.snd g_W' η_K) ∧
  (∀ j : Fin n, τ_W' j ≫ g_W' = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))) ∧
  (_root_.Pairwise fun i j : Fin n =>
    Disjoint (Set.range (τ_W' i).base) (Set.range (τ_W' j).base)) ∧
  π ≫ g_W = g_W' ∧
  (∀ j : Fin n, τ_W' j ≫ π = τ_W j) ∧
  AlgebraicGeometry.IsProper π ∧
  AlgebraicGeometry.Surjective π ∧
  (∀ (v_K : CategoryTheory.Limits.pullback g_W' η_K ⟶ CategoryTheory.Limits.pullback g_W η_K),
    v_K ≫ CategoryTheory.Limits.pullback.fst g_W η_K =
      CategoryTheory.Limits.pullback.fst g_W' η_K ≫ π →
    v_K ≫ CategoryTheory.Limits.pullback.snd g_W η_K =
      CategoryTheory.Limits.pullback.snd g_W' η_K →
    CategoryTheory.IsIso v_K) ∧
  (∀ U : W.Opens, w₀ ∉ (U : Set ↥W) → CategoryTheory.IsIso (π ∣_ U)) ∧
  (∀ U : W.Opens, CategoryTheory.IsIso (π.app U)) ∧
  (∃ hw₀_cl : IsClosed ({w₀} : Set ↥W),
    let W_compl : W.Opens := ⟨({w₀} : Set ↥W)ᶜ, hw₀_cl.isOpen_compl⟩
    ∃ ι_compl : W_compl.toScheme ⟶ W',
      AlgebraicGeometry.IsOpenImmersion ι_compl ∧
      ι_compl ≫ π = W_compl.ι ∧
      π.base ⁻¹' (W_compl : Set ↥W) = Set.range ι_compl.base) ∧
  E_exc ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_W' s_Ω) ∧
  IsGenericPoint η_exc E_exc ∧
  AlgebraicGeometry.IsClosedImmersion ι_exc ∧
  Set.range ι_exc.base = E_exc ∧
  ι_exc ≫ CategoryTheory.Limits.pullback.snd g_W' s_Ω = (weilProjectiveSpaceOver Ω 1).hom ∧
  (CategoryTheory.Limits.pullback.fst g_W' s_Ω).base ⁻¹' (π.base ⁻¹' {w₀}) = E_exc ∧
  π.base ⁻¹' {w₀} = (CategoryTheory.Limits.pullback.fst g_W' s_Ω).base '' E_exc ∧
  AlgebraicGeometry.IsOpenImmersion ι₀ ∧
  AlgebraicGeometry.IsOpenImmersion ι₁ ∧
  AlgebraicGeometry.IsOpenImmersion ι₂ ∧
  IsDomain R₀ ∧ IsDomain R₁ ∧ IsDomain R₂ ∧
  ι₀.base p₀ = w₀ ∧
  p₀.asIdeal = Ideal.span ({z₁, z₂} : Set R₀) ∧
  (∀ r : R₀, ∃ c : Ω,
    r - (AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_W)).hom (PowerSeries.C c) ∈ p₀.asIdeal) ∧
  ι₁ ≫ π = AlgebraicGeometry.Spec.map φ₁ ≫ ι₀ ∧
  ι₂ ≫ π = AlgebraicGeometry.Spec.map φ₂ ≫ ι₀ ∧
  π.base ⁻¹' (Set.range ι₀.base) = Set.range ι₁.base ∪ Set.range ι₂.base ∧
  ι₁.base '' (PrimeSpectrum.basicOpen s₁).1 = ι₂.base '' (PrimeSpectrum.basicOpen s₂).1 ∧
  φ₁.hom z₁ ≠ 0 ∧
  φ₁.hom z₂ = φ₁.hom z₁ * s₁ ∧
  φ₂.hom z₂ ≠ 0 ∧
  φ₂.hom z₁ = φ₂.hom z₂ * s₂ ∧
  q_exc.asIdeal = Ideal.span ({φ₁.hom z₁} : Set R₁) ∧
  ι₁.base q_exc = (CategoryTheory.Limits.pullback.fst g_W' s_Ω).base η_exc ∧
  (∀ c : Ω,
    s₁ - (AlgebraicGeometry.Spec.preimage (ι₁ ≫ g_W')).hom (PowerSeries.C c) ∉
      q_exc.asIdeal)

def HasAffineNCChartAt (Ω : Type u) [Field Ω]
    (R_ch : CommRingCat.{u}) (P_ch : AlgebraicGeometry.Spec R_ch)
    (φ_ch : PowerSeries Ω →+* R_ch) (a b : ℕ) : Prop :=
  ∃ (z₁' z₂' : R_ch) (A'_ch : CommRingCat.{u}) (v'_ch : AlgebraicGeometry.Spec A'_ch)
    (e_ch : AlgebraicGeometry.Spec A'_ch ⟶ AlgebraicGeometry.Spec R_ch)
    (u' v' ε' : A'_ch),
    IsDomain R_ch ∧
    P_ch.asIdeal = Ideal.span ({z₁', z₂'} : Set R_ch) ∧
    z₁' ≠ 0 ∧
    (∀ y : R_ch, z₂' * y ∈ Ideal.span ({z₁'} : Set R_ch) → y ∈ Ideal.span ({z₁'} : Set R_ch)) ∧
    (∀ r : R_ch, ∃ c : Ω, r - φ_ch (PowerSeries.C c) ∈ P_ch.asIdeal) ∧
    AlgebraicGeometry.Etale e_ch ∧
    IsDomain A'_ch ∧
    e_ch.base ⁻¹' {P_ch} = {v'_ch} ∧
    v'_ch.asIdeal = Ideal.span ({u', v'} : Set A'_ch) ∧
    u' ≠ 0 ∧
    (∀ y : A'_ch, v' * y ∈ Ideal.span ({u'} : Set A'_ch) → y ∈ Ideal.span ({u'} : Set A'_ch)) ∧
    (∀ r' : A'_ch, ∃ c : Ω,
      r' - (AlgebraicGeometry.Spec.preimage e_ch).hom (φ_ch (PowerSeries.C c)) ∈ v'_ch.asIdeal) ∧
    IsUnit ε' ∧
    1 ≤ a ∧
    (AlgebraicGeometry.Spec.preimage e_ch).hom (φ_ch PowerSeries.X) = ε' * u' ^ a * v' ^ b
def IsNC2DGraphClosure (Ω : Type u) [Field Ω]
    {W Y Γ : AlgebraicGeometry.Scheme.{u}}
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (α_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (ι_Γ : Γ ⟶ CategoryTheory.Limits.pullback g_W g_Y)
    (e_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ⟶ Γ) : Prop :=
  let η_K := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
  let p₁ := ι_Γ ≫ CategoryTheory.Limits.pullback.fst g_W g_Y
  let p₂ := ι_Γ ≫ CategoryTheory.Limits.pullback.snd g_W g_Y
  AlgebraicGeometry.IsIntegral Γ ∧
  AlgebraicGeometry.IsClosedImmersion ι_Γ ∧
  AlgebraicGeometry.IsProper p₁ ∧
  AlgebraicGeometry.IsOpenImmersion e_K ∧
  AlgebraicGeometry.IsOpenImmersion (CategoryTheory.Limits.pullback.fst g_W η_K) ∧
  AlgebraicGeometry.IsOpenImmersion (CategoryTheory.Limits.pullback.fst g_Y η_K) ∧
  e_K ≫ p₁ = CategoryTheory.Limits.pullback.fst g_W η_K ∧
  e_K ≫ p₂ = α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y η_K ∧
  Set.range e_K.base =
    p₁.base ⁻¹' Set.range (CategoryTheory.Limits.pullback.fst g_W η_K).base ∧
  Set.range e_K.base =
    p₂.base ⁻¹' Set.range (CategoryTheory.Limits.pullback.fst g_Y η_K).base
def nc2dNodePullbackSet (Ω : Type u) [Field Ω]
    {Z : AlgebraicGeometry.Scheme.{u}}
    (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (φ : (weilProjectiveSpaceOver Ω 1).left ⟶
      CategoryTheory.Limits.pullback g_Z
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))) :
    Set ↥(weilProjectiveSpaceOver Ω 1).left :=
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  {p : ↥(weilProjectiveSpaceOver Ω 1).left |
    IsClosed ({φ.base p} : Set ↥(CategoryTheory.Limits.pullback g_Z s_Ω)) ∧
    ∃ a b : ℕ, 1 ≤ b ∧ HasNCBranchAt Ω g_Z (φ.base p) a b}

def nc2dMarkPullbackSet (Ω : Type u) [Field Ω] (n : ℕ)
    {Z : AlgebraicGeometry.Scheme.{u}}
    (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_Z : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z))
    (φ : (weilProjectiveSpaceOver Ω 1).left ⟶
      CategoryTheory.Limits.pullback g_Z
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))) :
    Set ↥(weilProjectiveSpaceOver Ω 1).left :=
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  {p : ↥(weilProjectiveSpaceOver Ω 1).left |
    ∃ j : Fin n,
      (CategoryTheory.Limits.pullback.fst g_Z s_Ω).base (φ.base p) ∈
        Set.range (τ_Z j).base}
def IsValidLaurentExp (N : ℕ) (d : ℤ) {p : ℕ}
    (α : WeilStrictMonoTuple (N + 1) p) (a : Fin (N + 1) → ℤ) : Prop :=
  (∑ j : Fin (N + 1), a j = d) ∧
  ∀ j : Fin (N + 1), (∀ l : Fin (p + 1), α.1 l ≠ j) → 0 ≤ a j

def IsValidLaurentCochain (B : Type u) [CommRing B] (N : ℕ) (d : ℤ) (p : ℕ)
    (f : WeilStrictMonoTuple (N + 1) p → ((Fin (N + 1) → ℤ) →₀ B)) : Prop :=
  ∀ (α : WeilStrictMonoTuple (N + 1) p) (a : Fin (N + 1) → ℤ),
    ¬IsValidLaurentExp N d α a → f α a = 0

noncomputable def weilLaurentCechDiff (B : Type u) [CommRing B] (N : ℕ) (p : ℕ)
    (f : WeilStrictMonoTuple (N + 1) p → ((Fin (N + 1) → ℤ) →₀ B)) :
    WeilStrictMonoTuple (N + 1) (p + 1) → ((Fin (N + 1) → ℤ) →₀ B) :=
  fun β =>
    ∑ j : Fin (p + 2),
      ((-1 : ℤ) ^ (j : ℕ)) •
        f ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩

noncomputable def weilProjTransitionElem (B : Type u) [CommRing B] (N : ℕ)
    (j k : Fin (N + 1)) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
      MvPolynomial.gradedAlgebra
    ↑((AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B)).presheaf.obj
      (Opposite.op (AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B)
        (MvPolynomial.X j * MvPolynomial.X k)))) :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
    MvPolynomial.gradedAlgebra
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B
  let hj : MvPolynomial.X j ∈ 𝒜 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X j)).mpr
      (MvPolynomial.isHomogeneous_X B j)
  let hk : MvPolynomial.X k ∈ 𝒜 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X k)).mpr
      (MvPolynomial.isHomogeneous_X B k)
  let hjk : MvPolynomial.X j * MvPolynomial.X k ∈ 𝒜 2 :=
    SetLike.mul_mem_graded hj hk
  let hjj : MvPolynomial.X j ^ 2 ∈ 𝒜 (1 • 2) :=
    (one_nsmul 2).symm ▸ SetLike.pow_mem_graded 2 hj
  (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X j * MvPolynomial.X k)).hom
    (HomogeneousLocalization.Away.mk 𝒜 hjk 1 (MvPolynomial.X j ^ 2) hjj)

def IsWeilProjNegTwistedFreeSum (B : Type u) [CommRing B] (N D s : ℕ)
    (E : WeilPresheafModule
      (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
         MvPolynomial.gradedAlgebra
       AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))) : Prop :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
    MvPolynomial.gradedAlgebra
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B
  let P_B := AlgebraicGeometry.Proj 𝒜
  let W_std : Fin (N + 1) → P_B.Opens :=
    fun k => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X k)
  ∃ (ev : ∀ (U : P_B.Opens) (k : Fin (N + 1)), U ≤ W_std k →
        E.sec U ≃ₗ[↑(P_B.presheaf.obj (Opposite.op U))]
          (Fin s → ↑(P_B.presheaf.obj (Opposite.op U)))),
    (∀ {U W : P_B.Opens} (k : Fin (N + 1)) (hUk : U ≤ W_std k) (hWU : W ≤ U)
      (x : E.sec U) (l : Fin s),
      ev W k (le_trans hWU hUk) (E.res hWU x) l =
        (P_B.presheaf.map (CategoryTheory.homOfLE hWU).op).hom (ev U k hUk x l)) ∧
    (∀ (U : P_B.Opens) (j k : Fin (N + 1)) (hUj : U ≤ W_std j) (hUk : U ≤ W_std k)
      (x : E.sec U) (l : Fin s),
      let hUjk : U ≤ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X j * MvPolynomial.X k) :=
        le_trans (le_inf hUj hUk)
          (le_of_eq (AlgebraicGeometry.Proj.basicOpen_mul 𝒜 (MvPolynomial.X j) (MvPolynomial.X k)).symm)
      ev U j hUj x l =
        ((P_B.presheaf.map (CategoryTheory.homOfLE hUjk).op).hom
          (weilProjTransitionElem B N j k)) ^ D * ev U k hUk x l)

def HasWeilSubChartShortExactSeq {X : AlgebraicGeometry.Scheme.{u}} {m : ℕ}
    (V : Fin m → X.Opens) (K E G : WeilPresheafModule X) : Prop :=
  ∃ (ι : ∀ (U : X.Opens), (∃ k : Fin m, U ≤ V k) →
        K.sec U →ₗ[↑(X.presheaf.obj (Opposite.op U))] E.sec U)
    (π : ∀ (U : X.Opens), (∃ k : Fin m, U ≤ V k) →
        E.sec U →ₗ[↑(X.presheaf.obj (Opposite.op U))] G.sec U),
    (∀ {U W : X.Opens} (hU : ∃ k : Fin m, U ≤ V k) (hW : ∃ k : Fin m, W ≤ V k)
      (hWU : W ≤ U) (x : K.sec U),
      E.res hWU (ι U hU x) = ι W hW (K.res hWU x)) ∧
    (∀ {U W : X.Opens} (hU : ∃ k : Fin m, U ≤ V k) (hW : ∃ k : Fin m, W ≤ V k)
      (hWU : W ≤ U) (y : E.sec U),
      G.res hWU (π U hU y) = π W hW (E.res hWU y)) ∧
    (∀ (U : X.Opens), AlgebraicGeometry.IsAffineOpen U →
      ∀ (hU : ∃ k : Fin m, U ≤ V k),
        Function.Injective (ι U hU) ∧
        Function.Surjective (π U hU) ∧
        LinearMap.ker (π U hU) = LinearMap.range (ι U hU))
def weilMonomialSet (n d : ℕ) : Finset (Fin n → ℕ) :=
  (Fintype.piFinset (fun _ : Fin n => Finset.range (d + 1))).filter
    (fun u => ∑ i : Fin n, u i = d)

def weilUpperShadow (n d : ℕ) (ℱ : Finset (Fin n → ℕ)) : Finset (Fin n → ℕ) :=
  (weilMonomialSet n (d + 1)).filter
    (fun w => ∀ i : Fin n, 1 ≤ w i → Function.update w i (w i - 1) ∈ ℱ)

noncomputable def weilLexRank (n d : ℕ) (u : Fin n → ℕ) : ℕ :=
  letI := Classical.decPred (fun v : Fin n → ℕ => toLex v < toLex u)
  ((weilMonomialSet n d).filter (fun v => toLex v < toLex u)).card

noncomputable def weilLexInitSeg (n d c : ℕ) : Finset (Fin n → ℕ) :=
  (weilMonomialSet n d).filter (fun u => weilLexRank n d u < c)

def IsWeilSliceCompressed (n : ℕ) (ℱ : Finset (Fin (n + 1) → ℕ)) : Prop :=
  ∀ (idx : Fin (n + 1)) (a : ℕ) (u v : Fin n → ℕ),
    idx.insertNth a u ∈ ℱ →
    (∑ j : Fin n, v j = ∑ j : Fin n, u j) →
    toLex v < toLex u →
    idx.insertNth a v ∈ ℱ
def IsAffineNodalOverlapAt (k : Type u) [Field k] (m : ℕ)
    (a₁ a₂ : Fin m → ℕ) (c₁ c₂ : Fin m) : Prop :=
  ∃ (A₀ C₀ : Type u) (_ : CommRing A₀) (_ : CommRing C₀) (f₀ : A₀ →+* C₀)
    (R_B1 R_B2 R₁ R₂ : Type u) (_ : CommRing R_B1) (_ : CommRing R_B2)
    (_ : CommRing R₁) (_ : CommRing R₂)
    (α₁ : A₀ →+* R_B1) (α₂ : A₀ →+* R_B2)
    (β₁ : C₀ →+* R₁) (β₂ : C₀ →+* R₂)
    (u₁ : Ideal R₁) (_ : u₁.IsPrime) (u₂ : Ideal R₂) (_ : u₂.IsPrime)
    (h₁ : R_B1) (h₂ : R_B2)
    (ψ_rel1 : (MvPolynomial (Fin 2) R_B1 ⧸ Ideal.span
      ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h₁} :
        Set (MvPolynomial (Fin 2) R_B1))) →+* R₁)
    (ψ_rel2 : (MvPolynomial (Fin 2) R_B2 ⧸ Ideal.span
      ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h₂} :
        Set (MvPolynomial (Fin 2) R_B2))) →+* R₂)
    (φ₁ : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
      ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a₁ c} :
        Set (MvPolynomial (Fin 2 ⊕ Fin m) k))) →+* R₁)
    (φ₂ : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
      ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a₂ c} :
        Set (MvPolynomial (Fin 2 ⊕ Fin m) k))) →+* R₂),
    α₁.Etale ∧ α₂.Etale ∧ β₁.Etale ∧ β₂.Etale ∧
    ψ_rel1.Etale ∧ ψ_rel2.Etale ∧ φ₁.Etale ∧ φ₂.Etale ∧
    u₁.comap β₁ = u₂.comap β₂ ∧
    ψ_rel1.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C.comp α₁)) = β₁.comp f₀ ∧
    ψ_rel2.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C.comp α₂)) = β₂.comp f₀ ∧
    (∀ b : Fin 2, ψ_rel1 (Ideal.Quotient.mk _ (MvPolynomial.X b)) =
      φ₁ (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)))) ∧
    (∀ b : Fin 2, ψ_rel2 (Ideal.Quotient.mk _ (MvPolynomial.X b)) =
      φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)))) ∧
    u₁.comap φ₁ = Ideal.span
      {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
       Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
       Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁))} ∧
    u₂.comap φ₂ = Ideal.span
      {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
       Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
       Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₂))}
abbrev toroidalModelRing (k : Type u) [CommRing k] (m : ℕ) (S_exp : Finset (Fin m)) : Type u :=
  MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
    ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
      ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)} : Set (MvPolynomial (Fin 2 ⊕ Fin m) k))

noncomputable abbrev affineBlowupRatioRing (R : Type u) [CommRing R] {r : ℕ}
    (g : Fin r → R) (b : Fin r) : Type u :=
  MvPolynomial (Fin r) R ⧸
    RingHom.ker ((MvPolynomial.aeval (R := R)
      (fun a : Fin r =>
        algebraMap R (Localization.Away (g b)) (g a) *
          IsLocalization.Away.invSelf (S := Localization.Away (g b)) (g b))).toRingHom)

noncomputable def toroidalCenterGen (k : Type u) [CommRing k] {m : ℕ}
    (S_exp : Finset (Fin m)) (i₀ j₀ : Fin m) : Fin 4 → toroidalModelRing k m S_exp :=
  ![Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
    Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
    Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i₀)),
    Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j₀))]

def IsToroidalSquarefreeWitness (k : Type u) [Field k] (m N_tot : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z : Set X.left)
    (E : Fin N_tot → AlgebraicGeometry.Scheme.{u})
    (ιE : ∀ α : Fin N_tot, E α ⟶ X.left) : Prop :=
  (∀ α : Fin N_tot, AlgebraicGeometry.IsClosedImmersion (ιE α)) ∧
  (∀ α : Fin N_tot, AlgebraicGeometry.IsIntegral (E α)) ∧
  (∀ α : Fin N_tot, AlgebraicGeometry.SmoothOfRelativeDimension (m - 2) (ιE α ≫ X.hom)) ∧
  (_root_.Pairwise fun α β : Fin N_tot => Set.range (ιE α).base ≠ Set.range (ιE β).base) ∧
  ({x : X.left | ¬ ∃ V : X.left.Opens,
    x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom)} =
    ⋃ α : Fin N_tot, Set.range (ιE α).base) ∧
  ∀ x : X.left,
    ((∃ V : X.left.Opens,
        x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom)) ∧
      ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
        (ψ : MvPolynomial (Fin (m + 1)) k →+* R')
        (I : Finset (Fin (m + 1))),
        AlgebraicGeometry.Etale e_X ∧
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
        e_X.base v₀ = x ∧
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_X ≫ X.hom) ∧
        (∀ i ∈ I, ψ (MvPolynomial.X i) ∈ v₀.asIdeal) ∧
        e_X.base ⁻¹' Z =
          {v : AlgebraicGeometry.Spec R' | ∃ i ∈ I, ψ (MvPolynomial.X i) ∈ v.asIdeal}) ∨
    (∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
        (S_exp S_bdry : Finset (Fin m))
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec
          (CommRingCat.of (toroidalModelRing k m S_exp))),
      AlgebraicGeometry.Etale e_X ∧
      AlgebraicGeometry.Etale q ∧
      e_X.base v₀ = x ∧
      2 ≤ S_exp.card ∧
      S_exp ⊆ S_bdry ∧
      (q ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom) ∧
      (∀ a : Fin 2,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v₀).asIdeal) ∧
      (∀ i ∈ S_bdry,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v₀).asIdeal) ∧
      e_X.base ⁻¹' Z =
        {v : AlgebraicGeometry.Spec R' |
          ∃ i ∈ S_bdry,
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal} ∧
      (∀ α : Fin N_tot, x ∉ Set.range (ιE α).base →
        e_X.base ⁻¹' Set.range (ιE α).base = ∅) ∧
      (∀ α : Fin N_tot, x ∈ Set.range (ιE α).base →
        ∃ i ∈ S_exp, ∃ j ∈ S_exp, i ≠ j ∧
          e_X.base ⁻¹' Set.range (ιE α).base =
            {v : AlgebraicGeometry.Spec R' |
              (∀ a : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j)) ∈ (q.base v).asIdeal}))

def HasFourChartToroidalBlowupAlgebra (k : Type u) [Field k] (m : ℕ) : Prop :=
  (∀ (S : Finset (Fin m)) (a b : Fin m),
    a ∈ S → b ∈ S → a ≠ b →
    let M_S := toroidalModelRing k m S
    let J_M : Ideal M_S := Ideal.span
      {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
       Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
       Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr a)),
       Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr b))}
    J_M.IsPrime ∧
    (∀ c : Fin m, c ≠ a → c ≠ b →
      Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∉ J_M) ∧
    Nonempty ((M_S ⧸ J_M) ≃ₐ[k] MvPolynomial (Fin (m - 2)) k) ∧
    (∀ (B : Type u) [CommRing B] [Algebra M_S B] [Algebra.Etale M_S B],
      (Ideal.map (algebraMap M_S B) J_M).IsRadical)) ∧
  (∀ (S_exp : Finset (Fin m)) (_ : 2 ≤ S_exp.card) (i₀ j₀ : Fin m),
    i₀ ∈ S_exp → j₀ ∈ S_exp → i₀ ≠ j₀ →
    let M := toroidalModelRing k m S_exp
    let g_M := toroidalCenterGen k S_exp i₀ j₀
    (∀ (R' : Type u) [CommRing R'] [Algebra M R'] [Algebra.Etale M R'],
      let g : Fin 4 → R' := fun b => algebraMap M R' (g_M b)
      (Ideal.span (Set.range g)).IsRadical ∧
      (∀ b : Fin 4, g b ∈ nonZeroDivisors R') ∧
      (∀ b : Fin 4, ∃ φ_b : affineBlowupRatioRing M g_M b →+* affineBlowupRatioRing R' g b,
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_b)) ∧
        φ_b.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          ((Ideal.Quotient.mk _).comp MvPolynomial.C).comp (algebraMap M R'))) ∧
    (∀ (b : Fin 4) (a_div a_oth : Fin 2),
      ((b = 0 ∧ a_div = 0 ∧ a_oth = 1) ∨ (b = 1 ∧ a_div = 1 ∧ a_oth = 0)) →
      ∃ Φ_b : MvPolynomial (Fin (m + 1)) k ≃ₐ[k] affineBlowupRatioRing M g_M b,
        Φ_b.symm (((Ideal.Quotient.mk _).comp MvPolynomial.C)
          (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a_div)))) = MvPolynomial.X 0 ∧
        Φ_b.symm (((Ideal.Quotient.mk _).comp MvPolynomial.C)
          (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a_oth)))) =
            MvPolynomial.X 0 * ∏ i ∈ S_exp, MvPolynomial.X i.succ ∧
        ∀ ℓ : Fin m,
          Φ_b.symm (((Ideal.Quotient.mk _).comp MvPolynomial.C)
            (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr ℓ)))) =
            if ℓ = i₀ ∨ ℓ = j₀ then MvPolynomial.X 0 * MvPolynomial.X ℓ.succ
            else MvPolynomial.X ℓ.succ) ∧
    (∀ (b : Fin 4) (c_div c_oth : Fin m),
      ((b = 2 ∧ c_div = i₀ ∧ c_oth = j₀) ∨ (b = 3 ∧ c_div = j₀ ∧ c_oth = i₀)) →
      ∃ Φ_b : toroidalModelRing k m (S_exp.erase c_div) ≃ₐ[k] affineBlowupRatioRing M g_M b,
        (∀ a : Fin 2,
          Φ_b.symm (((Ideal.Quotient.mk _).comp MvPolynomial.C)
            (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)))) =
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c_div) * MvPolynomial.X (Sum.inl a))) ∧
        (∀ ℓ : Fin m,
          Φ_b.symm (((Ideal.Quotient.mk _).comp MvPolynomial.C)
            (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr ℓ)))) =
            if ℓ = c_oth then
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c_div) * MvPolynomial.X (Sum.inr c_oth))
            else Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr ℓ)))))

def HasToroidalBlowupEtaleCharts (k : Type u) [Field k] (m N : ℕ)
    (X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z' : Set X'.left) (S_α : Fin N → Set X'.left) : Prop :=
  (∀ (α : Fin N) (x' : X'.left), x' ∈ S_α α →
    ∃ (B' : CommRingCat.{u}) (w₀ : AlgebraicGeometry.Spec B')
      (e'_X : AlgebraicGeometry.Spec B' ⟶ X'.left)
      (J' : Ideal B')
      (ψ_E : MvPolynomial (Fin (m - 2)) k →+* (↥B' ⧸ J')),
      AlgebraicGeometry.Etale e'_X ∧
      e'_X.base w₀ = x' ∧
      J'.IsRadical ∧
      (PrimeSpectrum.zeroLocus (J' : Set B') : Set (AlgebraicGeometry.Spec B')) =
        e'_X.base ⁻¹' (S_α α) ∧
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_E)) ∧
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_E) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J')) ≫
            e'_X ≫ X'.hom)) ∧
  (∀ x' : X'.left,
    ((x' ∉ ⋃ α : Fin N, S_α α) ∧
      ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e'_X : AlgebraicGeometry.Spec R' ⟶ X'.left)
        (ψ : MvPolynomial (Fin (m + 1)) k →+* R')
        (I : Finset (Fin (m + 1))),
        AlgebraicGeometry.Etale e'_X ∧
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
        e'_X.base v₀ = x' ∧
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e'_X ≫ X'.hom) ∧
        (∀ i ∈ I, ψ (MvPolynomial.X i) ∈ v₀.asIdeal) ∧
        e'_X.base ⁻¹' Z' =
          {v : AlgebraicGeometry.Spec R' | ∃ i ∈ I, ψ (MvPolynomial.X i) ∈ v.asIdeal}) ∨
    ((x' ∈ ⋃ α : Fin N, S_α α) ∧
      ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e'_X : AlgebraicGeometry.Spec R' ⟶ X'.left)
        (S'_exp S'_bdry : Finset (Fin m))
        (q' : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec
          (CommRingCat.of (toroidalModelRing k m S'_exp))),
        AlgebraicGeometry.Etale e'_X ∧
        AlgebraicGeometry.Etale q' ∧
        e'_X.base v₀ = x' ∧
        2 ≤ S'_exp.card ∧
        S'_exp ⊆ S'_bdry ∧
        (q' ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e'_X ≫ X'.hom) ∧
        (∀ a : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q'.base v₀).asIdeal) ∧
        (∀ i ∈ S'_bdry,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q'.base v₀).asIdeal) ∧
        e'_X.base ⁻¹' Z' =
          {v : AlgebraicGeometry.Spec R' |
            ∃ i ∈ S'_bdry,
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q'.base v).asIdeal} ∧
        (∀ α : Fin N, x' ∉ S_α α →
          e'_X.base ⁻¹' (S_α α) = ∅) ∧
        (∀ α : Fin N, x' ∈ S_α α →
          ∃ i ∈ S'_exp, ∃ j ∈ S'_exp, i ≠ j ∧
            e'_X.base ⁻¹' (S_α α) =
              {v : AlgebraicGeometry.Spec R' |
                (∀ a : Fin 2,
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q'.base v).asIdeal) ∧
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q'.base v).asIdeal ∧
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j)) ∈ (q'.base v).asIdeal})))
noncomputable def weilEtaleHigherDirectImage {X S : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom X S) (q : ℕ)
    (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) :
    CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor S.Etale X.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
  let P : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u} :=
    CategoryTheory.Sheaf.cohomologyPresheaf F q
  (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
    (CategoryTheory.Functor.comp B.op P)

def WeilIsEtaleSheafPullback {X₁ X₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom X₁ X₂)
    (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
    (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor X₂.Etale X₁.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  ∃ (_ : B.IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology),
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    ∃ (_ : P_push.IsRightAdjoint),
      Nonempty (CategoryTheory.Iso
        ((B.sheafPullback AddCommGrpCat.{u} X₂.smallEtaleTopology X₁.smallEtaleTopology).obj F₂)
        F₁)

def WeilIsConstructibleModPrimeSheaf (ℓ : ℕ) (X : AlgebraicGeometry.Scheme.{u})
    (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) : Prop :=
  ℓ • CategoryTheory.CategoryStruct.id F = 0 ∧
  ∀ (Z : AlgebraicGeometry.Scheme.{u}) (iZ : Quiver.Hom Z X),
    AlgebraicGeometry.IsClosedImmersion iZ →
    AlgebraicGeometry.IsIntegral Z →
    ∃ (U : Z.Opens) (_ : Nonempty U)
      (V : AlgebraicGeometry.Scheme.{u}) (p : Quiver.Hom V (U : AlgebraicGeometry.Scheme.{u}))
      (A : AddCommGrpCat.{u}),
      AlgebraicGeometry.IsFinite p ∧
      AlgebraicGeometry.Etale p ∧
      AlgebraicGeometry.Surjective p ∧
      Finite A ∧
      ℓ • CategoryTheory.CategoryStruct.id A = 0 ∧
      WeilIsEtaleSheafPullback
        (CategoryTheory.CategoryStruct.comp p (CategoryTheory.CategoryStruct.comp U.ι iZ))
        F ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A)

def WeilProperModPrimeBaseChangeHolds (k : Type u) [Field k] (ℓ : ℕ) : Prop :=
  ∀ (X S S' X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType S.hom]
    (f : Quiver.Hom X S) (g : Quiver.Hom S' S)
    (f' : Quiver.Hom X' S') (g' : Quiver.Hom X' X),
    AlgebraicGeometry.IsProper f.left →
    CategoryTheory.IsPullback g'.left f'.left f.left g.left →
    ∀ (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})
      (F' : CategoryTheory.Sheaf X'.left.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      WeilIsEtaleSheafPullback g'.left F F' →
      ∀ (q : ℕ),
        WeilIsEtaleSheafPullback g.left
          (weilEtaleHigherDirectImage f.left q F)
          (weilEtaleHigherDirectImage f'.left q F')

def WeilP1ConstructiblePushforwardHolds (k : Type u) [Field k] (ℓ : ℕ) : Prop :=
  ∀ (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType B.hom]
    [AlgebraicGeometry.QuasiCompact B.hom]
    [AlgebraicGeometry.IsSeparated B.hom],
    let P₁ := weilProjectiveSpaceOver k 1
    let p₁ := CategoryTheory.Limits.pullback.fst B.hom P₁.hom
    ∀ (F : CategoryTheory.Sheaf (CategoryTheory.Limits.pullback B.hom P₁.hom).smallEtaleTopology
        AddCommGrpCat.{u}) (q : ℕ),
      WeilIsConstructibleModPrimeSheaf ℓ (CategoryTheory.Limits.pullback B.hom P₁.hom) F →
      WeilIsConstructibleModPrimeSheaf ℓ B.left (weilEtaleHigherDirectImage p₁ q F)
noncomputable def weilSmoothCenterReesRatio (R : Type u) [CommRing R] {n : ℕ}
    (f : Fin n → R) (a b : Fin n) : Localization.Away (f a) :=
  IsLocalization.mk' (Localization.Away (f a)) (f b) ⟨f a, Submonoid.mem_powers (f a)⟩

noncomputable def weilSmoothCenterReesSubalg (R : Type u) [CommRing R] {n : ℕ}
    (f : Fin n → R) (a : Fin n) : Subalgebra R (Localization.Away (f a)) :=
  Algebra.adjoin R (Set.range (weilSmoothCenterReesRatio R f a))

def IsSmoothCenterZariskiBlowup (k : Type u) [Field k]
    {X X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (C : Set X.left) {M L : ℕ} (W_cov : Fin (M + 1) → X.left.affineOpens)
    (h : ∀ ν : Fin (M + 1), Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op (W_cov ν).1)))
    (π : X' ⟶ X) : Prop :=
  (∀ U₀ : X.left.Opens, Disjoint (U₀ : Set X.left) C →
    CategoryTheory.IsIso (π.left ∣_ U₀)) ∧
  (∀ ν : Fin (M + 1),
    ∃ O_chart : Fin (L + 1) → X'.left.Opens,
      (⨆ a : Fin (L + 1), O_chart a) =
        (TopologicalSpace.Opens.map π.left.base).obj (W_cov ν).1 ∧
      (∀ a : Fin (L + 1), h ν a = 0 → O_chart a = ⊥) ∧
      (∀ a : Fin (L + 1), h ν a ≠ 0 →
        ∃ isoO : (O_chart a).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
            ↥(weilSmoothCenterReesSubalg
              (↑(X.left.presheaf.obj (Opposite.op (W_cov ν).1))) (h ν) a)),
          (O_chart a).ι ≫ π.left =
            isoO.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap _ _)) ≫
              (W_cov ν).2.fromSpec ∧
          ∀ a' : Fin (L + 1),
            isoO.hom.base ⁻¹' {v : AlgebraicGeometry.Spec (CommRingCat.of
                ↥(weilSmoothCenterReesSubalg
                  (↑(X.left.presheaf.obj (Opposite.op (W_cov ν).1))) (h ν) a)) |
              (⟨weilSmoothCenterReesRatio
                  (↑(X.left.presheaf.obj (Opposite.op (W_cov ν).1))) (h ν) a a',
                Algebra.subset_adjoin ⟨a', rfl⟩⟩ :
                ↥(weilSmoothCenterReesSubalg
                  (↑(X.left.presheaf.obj (Opposite.op (W_cov ν).1))) (h ν) a)) ∉ v.asIdeal} =
            (O_chart a).ι.base ⁻¹' (O_chart a' : Set X'.left)))
def WeilTopDegTorsionPullback {W₁ W₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom W₁ W₂) (m k : ℕ)
    (p : weilEtaleTorsionH W₂ m k →+ weilEtaleTorsionH W₁ m k) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor W₂.Etale W₁.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  let J₁ := W₁.smallEtaleTopology
  let J₂ := W₂.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  ∃ (_ : B.IsContinuous J₂ J₁),
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    ∃ (P_pull : CategoryTheory.Functor
          (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u})
          (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}))
      (adj_pull : CategoryTheory.Adjunction P_pull P_push)
      (_ : P_pull.Additive)
      (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
      (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
      (T₁ : W₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (T₂ : W₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
      let πℤ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
        (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
          ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
            (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
              ((C₁.obj Aℤ).obj.map (Opposite.op τ))))
      let πM : Quiver.Hom (P_pull.obj (C₂.obj AM)) (C₁.obj AM) :=
        (adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM)).symm
          ((adj₂.homEquiv AM (P_push.obj (C₁.obj AM))).symm
            (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM)
              ((C₁.obj AM).obj.map (Opposite.op τ))))
      ∃ (ιℤ : Quiver.Hom (C₁.obj Aℤ) (P_pull.obj (C₂.obj Aℤ))),
        CategoryTheory.CategoryStruct.comp ιℤ πℤ =
          CategoryTheory.CategoryStruct.id (C₁.obj Aℤ) ∧
        CategoryTheory.CategoryStruct.comp πℤ ιℤ =
          CategoryTheory.CategoryStruct.id (P_pull.obj (C₂.obj Aℤ)) ∧
        ∀ x : weilEtaleTorsionH W₂ m k,
          p x = (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp (C₁.obj Aℤ) (Nat.add_zero k)
            ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull _ _ _ _ _
                (C₂.obj Aℤ) (C₂.obj AM) k) x)
              (Nat.zero_add k))

def WeilTopDegIsIteratedAbsFrob (p ν : ℕ) (W : AlgebraicGeometry.Scheme.{u})
    (φ_abs : Quiver.Hom W W) : Prop :=
  (∀ U : W.Opens, ((p : ℕ) : ↑(W.presheaf.obj (Opposite.op U))) = 0) ∧
  φ_abs.base = (CategoryTheory.CategoryStruct.id W).base ∧
  ∀ (U : W.Opens) (e : U ≤ (TopologicalSpace.Opens.map φ_abs.base).obj U)
    (s : ↑(W.presheaf.obj (Opposite.op U))),
    (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appLE φ_abs U U e)) s = s ^ (p ^ ν)

def WeilTopDegFiniteLocallyFreeOfRank (δ : ℕ) {X Y : AlgebraicGeometry.Scheme.{u}}
    (φ : Quiver.Hom X Y) : Prop :=
  AlgebraicGeometry.IsFinite φ ∧
  ∀ y : ↥Y, ∃ V : Y.Opens,
    y ∈ V ∧
    AlgebraicGeometry.IsAffineOpen V ∧
    AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map φ.base).obj V) ∧
    ∃ (M : Type u) (_ : AddCommGroup M) (_ : Module ↑(Y.presheaf.obj (Opposite.op V)) M)
      (e : M ≃+ ↑(X.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map φ.base).obj V)))),
      (∀ (b : ↑(Y.presheaf.obj (Opposite.op V))) (m : M),
        e (b • m) = (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app φ V)) b * e m) ∧
      Nonempty (Module.Basis (Fin δ) ↑(Y.presheaf.obj (Opposite.op V)) M)
noncomputable abbrev weilEtaleLocalFreeSheaf (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    (U : S.Etale) :
    CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) :=
  CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology U
    (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m)))

noncomputable def weilEtaleLocalCounit (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    (U : S.Etale) :
    Quiver.Hom (weilEtaleLocalFreeSheaf S m U) (weilEtaleModuleUnit S m) :=
  let R := ULift.{u, 0} (ZMod m)
  let J := S.smallEtaleTopology
  CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
    (((CategoryTheory.sheafificationAdjunction J (ModuleCat.{u, u} R)).unit.app
      ((CategoryTheory.Functor.const (Opposite S.Etale)).obj (ModuleCat.of R R))).app
      (Opposite.op U))

noncomputable def weilEtaleLocalFreeMap (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    {U₁ U₂ : S.Etale} (u : Quiver.Hom U₁ U₂) :
    Quiver.Hom (weilEtaleLocalFreeSheaf S m U₁) (weilEtaleLocalFreeSheaf S m U₂) :=
  CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
    (CategoryTheory.CategoryStruct.comp
      (CategoryTheory.Sheaf.freeYonedaHomEquiv
        (CategoryTheory.CategoryStruct.id (weilEtaleLocalFreeSheaf S m U₂)))
      ((weilEtaleLocalFreeSheaf S m U₂).obj.map (Opposite.op u)))

noncomputable abbrev weilEtaleLocalModuleH (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    (U : S.Etale) (q : ℕ) : Type u :=
  CategoryTheory.Abelian.Ext.{u} (weilEtaleModuleUnit S m) (weilEtaleLocalFreeSheaf S m U) q

def WeilHasTruncatedGodementComplex (S : AlgebraicGeometry.Scheme.{u}) (d m : ℕ) : Prop :=
  let R := ULift.{u, 0} (ZMod m)
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  let oneR := weilEtaleModuleUnit S m
  let T_S : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
    (CategoryTheory.CategoryStruct.id S)
    (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))
  ∃ (𝒯 : ℕ → CategoryTheory.Functor 𝒞 𝒞)
    (η : CategoryTheory.NatTrans (CategoryTheory.Functor.id 𝒞) (𝒯 0))
    (diff : ∀ q : ℕ, CategoryTheory.NatTrans (𝒯 q) (𝒯 (q + 1))),
    (∀ q : ℕ, (𝒯 q).Additive) ∧
    (∀ q : ℕ, 2 * d < q → ∀ F : 𝒞, CategoryTheory.Limits.IsZero ((𝒯 q).obj F)) ∧
    (∀ F : 𝒞, CategoryTheory.Mono (η.app F)) ∧
    (∀ F : 𝒞, ∃ h₀ : CategoryTheory.CategoryStruct.comp (η.app F) ((diff 0).app F) = 0,
      (CategoryTheory.ShortComplex.mk (η.app F) ((diff 0).app F) h₀).Exact) ∧
    (∀ (q : ℕ) (F : 𝒞),
      ∃ hq : CategoryTheory.CategoryStruct.comp ((diff q).app F) ((diff (q + 1)).app F) = 0,
        (CategoryTheory.ShortComplex.mk ((diff q).app F) ((diff (q + 1)).app F) hq).Exact) ∧
    (∀ (q k : ℕ), 1 ≤ k → ∀ F : 𝒞,
      Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR ((𝒯 q).obj F) k)) ∧
    (∀ q : ℕ,
      let C_q : CategoryTheory.Functor 𝒞 (ModuleCat.{u, u} R) :=
        CategoryTheory.Functor.comp (𝒯 q)
          (CategoryTheory.Functor.comp (CategoryTheory.sheafToPresheaf J (ModuleCat.{u, u} R))
            ((CategoryTheory.evaluation (Opposite S.Etale) (ModuleCat.{u, u} R)).obj
              (Opposite.op T_S)))
      CategoryTheory.Limits.PreservesFiniteLimits C_q ∧
      CategoryTheory.Limits.PreservesFiniteColimits C_q ∧
      CategoryTheory.Limits.PreservesColimitsOfSize.{u, u} C_q)

def WeilHasLocalEffacement (S : AlgebraicGeometry.Scheme.{u}) (d m : ℕ)
    (τ : weilEtaleModuleH S m (2 * d) →+ ZMod m) : Prop :=
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  ∀ (x : ↥S),
    let κ := S.residueField x
    let Ω := AlgebraicClosure ↥κ
    let gx : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
        (S.fromSpecResidueField x)
    ∀ (U : S.Etale) (γ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (Fgt.obj U).left),
      CategoryTheory.CategoryStruct.comp γ (Fgt.obj U).hom = gx →
      ∃ (U' : S.Etale) (v : Quiver.Hom U' U)
        (γ' : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (Fgt.obj U').left),
        CategoryTheory.CategoryStruct.comp γ' (Fgt.obj U').hom = gx ∧
        CategoryTheory.CategoryStruct.comp γ' (Fgt.map v).left = γ ∧
        (∀ (q : ℕ), q < 2 * d → ∀ z : weilEtaleLocalModuleH S m U' q,
          z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalFreeMap S m v))
            (Nat.add_zero q) = 0) ∧
        Function.Bijective (fun z : weilEtaleLocalModuleH S m U' (2 * d) =>
          τ (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalCounit S m U'))
            (Nat.add_zero (2 * d))))
def WeilIsGenFiniteEtaleConstantModPrime (ℓ : ℕ) (Z : AlgebraicGeometry.Scheme.{u})
    (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) : Prop :=
  ℓ • CategoryTheory.CategoryStruct.id G = 0 ∧
  ∃ (U : Z.Opens) (_ : Nonempty U)
    (V : AlgebraicGeometry.Scheme.{u}) (p : Quiver.Hom V (U : AlgebraicGeometry.Scheme.{u}))
    (A : AddCommGrpCat.{u}),
    AlgebraicGeometry.IsFinite p ∧
    AlgebraicGeometry.Etale p ∧
    AlgebraicGeometry.Surjective p ∧
    Finite A ∧
    ℓ • CategoryTheory.CategoryStruct.id A = 0 ∧
    WeilIsEtaleSheafPullback (CategoryTheory.CategoryStruct.comp p U.ι) G
      ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A)
def WeilConstructibleModPrimeSerreHolds (k : Type u) [Field k] (ℓ : ℕ) : Prop :=
  (∀ (Y : AlgebraicGeometry.Scheme.{u})
      (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
      (IsEmpty Y → WeilIsConstructibleModPrimeSheaf ℓ Y F) ∧
      (CategoryTheory.Limits.IsZero F → WeilIsConstructibleModPrimeSheaf ℓ Y F)) ∧
  (∀ (Y : AlgebraicGeometry.Scheme.{u})
      (F₁ F₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
      Nonempty (CategoryTheory.Iso F₁ F₂) →
      WeilIsConstructibleModPrimeSheaf ℓ Y F₁ →
      WeilIsConstructibleModPrimeSheaf ℓ Y F₂) ∧
  (∀ (Y' Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.QuasiCompact Y'.hom] [AlgebraicGeometry.IsSeparated Y.hom]
      (g : Quiver.Hom Y' Y)
      (F : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}),
      ∃ (F' : CategoryTheory.Sheaf Y'.left.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback g.left F F' ∧
        (WeilIsConstructibleModPrimeSheaf ℓ Y.left F →
          WeilIsConstructibleModPrimeSheaf ℓ Y'.left F')) ∧
  (∀ (Y : AlgebraicGeometry.Scheme.{u})
      (G : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id G = 0 →
      ∀ (n : ℕ) (W : Fin n → Y.Opens),
        iSup W = ⊤ →
        (∀ a : Fin n,
          ∃ (G_a : CategoryTheory.Sheaf (W a : AlgebraicGeometry.Scheme.{u}).smallEtaleTopology
              AddCommGrpCat.{u}),
            WeilIsEtaleSheafPullback (W a).ι G G_a ∧
            WeilIsConstructibleModPrimeSheaf ℓ (W a : AlgebraicGeometry.Scheme.{u}) G_a) →
        WeilIsConstructibleModPrimeSheaf ℓ Y G) ∧
  (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType Y.hom]
      [AlgebraicGeometry.QuasiCompact Y.hom]
      [AlgebraicGeometry.IsSeparated Y.hom],
      (∀ (F₁ F₂ : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u})
          (φ : Quiver.Hom F₁ F₂),
          WeilIsConstructibleModPrimeSheaf ℓ Y.left F₁ →
          WeilIsConstructibleModPrimeSheaf ℓ Y.left F₂ →
          WeilIsConstructibleModPrimeSheaf ℓ Y.left (CategoryTheory.Limits.kernel φ) ∧
          WeilIsConstructibleModPrimeSheaf ℓ Y.left (CategoryTheory.Limits.cokernel φ)) ∧
      (∀ (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u})),
          SC.ShortExact →
          ℓ • CategoryTheory.CategoryStruct.id SC.X₂ = 0 →
          WeilIsConstructibleModPrimeSheaf ℓ Y.left SC.X₁ →
          WeilIsConstructibleModPrimeSheaf ℓ Y.left SC.X₃ →
          WeilIsConstructibleModPrimeSheaf ℓ Y.left SC.X₂))
def weilEtaleGmPresheaf (X : AlgebraicGeometry.Scheme.{u}) :
    CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u} :=
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget X
  let G_ring : CategoryTheory.Functor (Opposite X.Etale) CommRingCat.{u} :=
    { obj := fun U => ((Fgt.obj (Opposite.unop U)).left).presheaf.obj (Opposite.op ⊤)
      map := fun f => ((Fgt.map (Opposite.unop f)).left).appTop
      map_id := fun U =>
        (congrArg AlgebraicGeometry.Scheme.Hom.appTop
          (congrArg CategoryTheory.CommaMorphism.left (Fgt.map_id (Opposite.unop U)))).trans
          AlgebraicGeometry.Scheme.Hom.id_appTop
      map_comp := fun f g =>
        (congrArg AlgebraicGeometry.Scheme.Hom.appTop
          (congrArg CategoryTheory.CommaMorphism.left (Fgt.map_comp (Opposite.unop g) (Opposite.unop f)))).trans
          (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _) }
  let U_add : CategoryTheory.Functor CommRingCat.{u} AddCommGrpCat.{u} :=
    { obj := fun R => AddCommGrpCat.of (Additive (Units ↑R))
      map := fun φ => AddCommGrpCat.ofHom (MonoidHom.toAdditive (Units.map φ.hom.toMonoidHom))
      map_id := fun _ => AddCommGrpCat.ext fun _ => rfl
      map_comp := fun _ _ => AddCommGrpCat.ext fun _ => rfl }
  CategoryTheory.Functor.comp G_ring U_add

noncomputable def weilEtaleGmSheaf (X : AlgebraicGeometry.Scheme.{u}) :
    CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
  (CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
    (weilEtaleGmPresheaf X)

noncomputable def weilCurvePrincipalSubgroup (X : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral X] :
    AddSubgroup ({ x : ↥X // IsClosed ({x} : Set ↥X) } →₀ ℤ) :=
  AddSubgroup.closure
    { D : ({ x : ↥X // IsClosed ({x} : Set ↥X) } →₀ ℤ) |
      ∃ f : Units ↑X.functionField,
        ∀ x : { x : ↥X // IsClosed ({x} : Set ↥X) },
          let Rx := ↑(X.presheaf.stalk x.1)
          let mx := IsLocalRing.maximalIdeal Rx
          ∃ (a b : Rx) (na nb : ℕ),
            a ≠ 0 ∧ b ≠ 0 ∧
            algebraMap Rx ↑X.functionField a =
              (f : ↑X.functionField) * algebraMap Rx ↑X.functionField b ∧
            Ideal.span ({a} : Set Rx) = mx ^ na ∧
            Ideal.span ({b} : Set Rx) = mx ^ nb ∧
            D x = (na : ℤ) - (nb : ℤ) }

abbrev weilCurveClGroup (X : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral X] : Type u :=
  ({ x : ↥X // IsClosed ({x} : Set ↥X) } →₀ ℤ) ⧸ weilCurvePrincipalSubgroup X
noncomputable def weilAltClosedComplIdeal (S : AlgebraicGeometry.Scheme.{u}) (U : S.Opens) :
    S.IdealSheafData :=
  AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal
    ⟨(U : Set ↥S)ᶜ, U.isOpen.isClosed_compl⟩

def WeilAltIsEtaleSheetSplit (δ : ℕ) {W U : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom W U) : Prop :=
  ∀ u : ↥U, ∃ (V : AlgebraicGeometry.Scheme.{u}) (v : Quiver.Hom V U)
    (σ : Fin δ → Quiver.Hom V (CategoryTheory.Limits.pullback f v)),
    AlgebraicGeometry.Etale v ∧
    u ∈ Set.range v.base ∧
    (∀ j : Fin δ,
      CategoryTheory.CategoryStruct.comp (σ j) (CategoryTheory.Limits.pullback.snd f v) =
        CategoryTheory.CategoryStruct.id V) ∧
    (∀ j : Fin δ, AlgebraicGeometry.IsOpenImmersion (σ j)) ∧
    (∀ i j : Fin δ, i ≠ j → Disjoint (Set.range (σ i).base) (Set.range (σ j).base)) ∧
    (⋃ j : Fin δ, Set.range (σ j).base) = Set.univ

def WeilAltIsZeroBdryExact (S : AlgebraicGeometry.Scheme.{u}) (U : S.Opens) (n : ℕ)
    (K : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
    (ι : Quiver.Hom K (weilEtaleTorsionSheaf S n)) : Prop :=
  let I_Z : S.IdealSheafData := weilAltClosedComplIdeal S U
  let Z : AlgebraicGeometry.Scheme.{u} := I_Z.subscheme
  let i_Z : Quiver.Hom Z S := I_Z.subschemeι
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i_Z :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i_Z :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_Z : CategoryTheory.Functor S.Etale Z.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i_Z
  let J_S := S.smallEtaleTopology
  let J_Z := Z.smallEtaleTopology
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
  let C_S := CategoryTheory.constantSheaf J_S AddCommGrpCat.{u}
  let C_Z := CategoryTheory.constantSheaf J_Z AddCommGrpCat.{u}
  ∃ (_ : B_Z.IsContinuous J_S J_Z)
    (T_S : S.Etale) (hT_S : CategoryTheory.Limits.IsTerminal T_S)
    (T_Z : Z.Etale) (hT_Z : CategoryTheory.Limits.IsTerminal T_Z),
    let P_push_Z := B_Z.sheafPushforwardContinuous AddCommGrpCat.{u} J_S J_Z
    let adj_S := CategoryTheory.constantSheafAdj J_S AddCommGrpCat.{u} hT_S
    let adj_Z := CategoryTheory.constantSheafAdj J_Z AddCommGrpCat.{u} hT_Z
    let τ_Z : Quiver.Hom (B_Z.obj T_S) T_Z := hT_Z.from (B_Z.obj T_S)
    let ρ_Z : Quiver.Hom (C_S.obj AM) (P_push_Z.obj (C_Z.obj AM)) :=
      (adj_S.homEquiv AM (P_push_Z.obj (C_Z.obj AM))).symm
        (CategoryTheory.CategoryStruct.comp (adj_Z.unit.app AM)
          ((C_Z.obj AM).obj.map (Opposite.op τ_Z)))
    ∃ (h0 : CategoryTheory.CategoryStruct.comp ι ρ_Z = 0),
      (CategoryTheory.ShortComplex.mk ι ρ_Z h0).ShortExact

def WeilAltZeroBdryLerayInjective {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom S₁ S₂) (q : ℕ)
    (K₁ : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor S₂.Etale S₁.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  let J₁ := S₁.smallEtaleTopology
  let J₂ := S₂.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  ∀ (_ : B.IsContinuous J₂ J₁),
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    ∀ (_ : P_push.IsRightAdjoint),
      let P_pull := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
      let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
      ∀ (_ : P_pull.Additive)
        (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
        (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
        (T₁ : S₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        (T₂ : S₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
        let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
        let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
        let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
        let πℤ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
          (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
            ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
              (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
                ((C₁.obj Aℤ).obj.map (Opposite.op τ))))
        ∀ (ιℤ : Quiver.Hom (C₁.obj Aℤ) (P_pull.obj (C₂.obj Aℤ))),
          CategoryTheory.CategoryStruct.comp ιℤ πℤ =
            CategoryTheory.CategoryStruct.id (C₁.obj Aℤ) →
          CategoryTheory.CategoryStruct.comp πℤ ιℤ =
            CategoryTheory.CategoryStruct.id (P_pull.obj (C₂.obj Aℤ)) →
          ∀ z : CategoryTheory.Abelian.Ext (C₂.obj Aℤ) (P_push.obj K₁) q,
            (CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app K₁)).postcomp
              (C₁.obj Aℤ) (Nat.add_zero q)
              ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull _ _ _ _ _
                  (C₂.obj Aℤ) (P_push.obj K₁) q) z)
                (Nat.zero_add q)) = 0 →
            z = 0
def WeilCanonicalModPrimePBC (ℓ : ℕ) {X S : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom X S) : Prop :=
  ∀ (S' X' : AlgebraicGeometry.Scheme.{u})
      (g : Quiver.Hom S' S) (f' : Quiver.Hom X' S') (g' : Quiver.Hom X' X)
      (hpb : CategoryTheory.IsPullback g' f' f g),
    letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_f : CategoryTheory.Functor S.Etale X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let B_g : CategoryTheory.Functor S.Etale S'.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
    let B_f' : CategoryTheory.Functor S'.Etale X'.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f'
    let B_g' : CategoryTheory.Functor X.Etale X'.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g'
    ∃ (_ : B_f.IsContinuous S.smallEtaleTopology X.smallEtaleTopology)
      (_ : B_g.IsContinuous S.smallEtaleTopology S'.smallEtaleTopology)
      (_ : B_f'.IsContinuous S'.smallEtaleTopology X'.smallEtaleTopology)
      (_ : B_g'.IsContinuous X.smallEtaleTopology X'.smallEtaleTopology),
      let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology
      let pf_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
      let pf_f' := B_f'.sheafPushforwardContinuous AddCommGrpCat.{u} S'.smallEtaleTopology X'.smallEtaleTopology
      let pf_g' := B_g'.sheafPushforwardContinuous AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
      ∃ (_ : pf_g.IsRightAdjoint) (_ : pf_g'.IsRightAdjoint),
        let pb_g' := B_g'.sheafPullback AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
        let adj_g := B_g.sheafAdjunctionContinuous AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
        let adj_g' := B_g'.sheafAdjunctionContinuous AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
        let e_fun : CategoryTheory.Iso (CategoryTheory.Functor.comp B_f B_g') (CategoryTheory.Functor.comp B_g B_f') :=
          CategoryTheory.Iso.trans
            (CategoryTheory.Iso.symm (CategoryTheory.MorphismProperty.Over.pullbackComp g' f))
            (CategoryTheory.Iso.trans
              (CategoryTheory.MorphismProperty.Over.pullbackCongr hpb.w)
              (CategoryTheory.MorphismProperty.Over.pullbackComp f' g))
        letI : (CategoryTheory.Functor.comp B_f B_g').IsContinuous S.smallEtaleTopology X'.smallEtaleTopology :=
          CategoryTheory.Functor.isContinuous_comp B_f B_g'
            S.smallEtaleTopology X.smallEtaleTopology X'.smallEtaleTopology
        letI : (CategoryTheory.Functor.comp B_g B_f').IsContinuous S.smallEtaleTopology X'.smallEtaleTopology :=
          CategoryTheory.Functor.isContinuous_comp B_g B_f'
            S.smallEtaleTopology S'.smallEtaleTopology X'.smallEtaleTopology
        let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_fun
          AddCommGrpCat.{u} S.smallEtaleTopology X'.smallEtaleTopology
        (∀ (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
          ℓ • CategoryTheory.CategoryStruct.id F = 0 →
          CategoryTheory.IsIso
            ((adj_g.homEquiv (pf_f.obj F) (pf_f'.obj (pb_g'.obj F))).symm
              (CategoryTheory.CategoryStruct.comp
                (pf_f.map (adj_g'.unit.app F))
                (e_pf.hom.app (pb_g'.obj F))))) ∧
        (∀ (I : CategoryTheory.Sheaf X.smallEtaleTopology
            (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))))
          [CategoryTheory.Injective I] (q : ℕ),
          1 ≤ q →
          CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage f' q
              (pb_g'.obj
                ((CategoryTheory.Sheaf.composeAndSheafify X.smallEtaleTopology
                  (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
                    AddCommGrpCat.{u})).obj I))))
