    {K : CochainComplex 𝒞 ℕ} (S : ℕ → CochainComplex 𝒞 ℕ)
    (Φ_s : ∀ q : ℕ, S q ⟶ K) : ∀ r : ℕ, weilCochainBiprodRec S r ⟶ K
  | 0 => Φ_s 0
  | r + 1 => CategoryTheory.Limits.biprod.desc (weilCochainBiprodDescRec S Φ_s r) (Φ_s (r + 1))
structure WeilRingSplitOdpChartPkg (k : Type u) [Field k] (m : ℕ)
    (A_Z : Type u) [CommRing A_Z] [Algebra k A_Z] (ε_z : A_Z →+* k)
    (ℓ_0 ℓ_1 ℓ_2 : A_Z) : Type (u + 1) where
  dG : Fin (2 * m + 2) → MvPolynomial (Fin 2) A_Z
  delta_crit : MvPolynomial (Fin 2) A_Z
  R'_0 : CommRingCat.{u}
  φ_P : MvPolynomial (Fin 2) k →+* R'_0
  ε_R : R'_0 →+* k
  τ_crit : MvPolynomial (Fin 2) A_Z →+* R'_0
  N_diag : ℕ
  c_diag : Fin N_diag → MvPolynomial (Fin 2) A_Z
  r_diag : Fin N_diag → R'_0
  D_base : Fin 2 → (R'_0 → R'_0)
  B'_0 : CommRingCat.{u}
  e_Y0 : (MvPolynomial (Fin 2) A_Z ⧸ Ideal.span
    ({MvPolynomial.C ℓ_0 + MvPolynomial.X (0 : Fin 2) * MvPolynomial.C ℓ_1 +
      MvPolynomial.X (1 : Fin 2) * MvPolynomial.C ℓ_2} : Set (MvPolynomial (Fin 2) A_Z))) →+* B'_0
  q_0 : (MvPolynomial (Fin (m + 1) × Fin 2) R'_0 ⧸ Ideal.span
    ({(∑ j : Fin (m + 1), MvPolynomial.X (j, (0 : Fin 2)) * MvPolynomial.X (j, (1 : Fin 2))) -
      MvPolynomial.C (τ_crit (MvPolynomial.C ℓ_0 +
        MvPolynomial.X (0 : Fin 2) * MvPolynomial.C ℓ_1 +
        MvPolynomial.X (1 : Fin 2) * MvPolynomial.C ℓ_2))} :
      Set (MvPolynomial (Fin (m + 1) × Fin 2) R'_0))) →+* B'_0
  hφ_P_et : φ_P.Etale
  hε_R_φ : ∀ P : MvPolynomial (Fin 2) k, ε_R (φ_P P) = MvPolynomial.eval (0 : Fin 2 → k) P
  hε_R_τ : ∀ F : MvPolynomial (Fin 2) A_Z, ε_R (τ_crit F) = MvPolynomial.eval₂ ε_z (0 : Fin 2 → k) F
  hτ_φ : ∀ P : MvPolynomial (Fin 2) k,
    τ_crit (MvPolynomial.map (algebraMap k A_Z) P) = φ_P P
  hΔ_unit : ε_R (τ_crit delta_crit) ≠ 0
  hCrit_iff : ∀ p : PrimeSpectrum (MvPolynomial (Fin 2) A_Z),
    delta_crit ∉ p.asIdeal →
    ((∀ i : Fin (2 * m + 2), dG i ∈ p.asIdeal) ↔
      ∃ u : PrimeSpectrum R'_0, PrimeSpectrum.comap τ_crit u = p)
  hDiag_sum : ∑ s : Fin N_diag, τ_crit (c_diag s) * r_diag s = 1
  hDiag_isol : ∀ (D : Type u) [CommRing D]
      (α : MvPolynomial (Fin 2) A_Z →+* D) (β : R'_0 →+* D),
    α.comp (MvPolynomial.map (algebraMap k A_Z)) = β.comp φ_P →
    ∀ P : PrimeSpectrum D,
      (∑ s : Fin N_diag, α (c_diag s) * β (r_diag s)) ∉ P.asIdeal →
      (∀ i : Fin (2 * m + 2), α (dG i) ∈ P.asIdeal) →
      ∀ c : MvPolynomial (Fin 2) A_Z, α c - β (τ_crit c) ∈ P.asIdeal
  hSm_off_crit : ∀ i : Fin (2 * m + 2),
    let G_poly : MvPolynomial (Fin 2) A_Z :=
      MvPolynomial.C ℓ_0 + MvPolynomial.X (0 : Fin 2) * MvPolynomial.C ℓ_1 +
        MvPolynomial.X (1 : Fin 2) * MvPolynomial.C ℓ_2
    let I_G : Ideal (MvPolynomial (Fin 2) A_Z) :=
      Ideal.span ({G_poly} : Set (MvPolynomial (Fin 2) A_Z))
    let Q_ring := MvPolynomial (Fin 2) A_Z ⧸ I_G
    let f_base : MvPolynomial (Fin 2) k →+* Q_ring :=
      (Ideal.Quotient.mk I_G).comp (MvPolynomial.map (algebraMap k A_Z))
    RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 1)
      ((algebraMap Q_ring (Localization.Away (Ideal.Quotient.mk I_G (dG i)))).comp f_base)
  hD_lin : ∀ (b : Fin 2) (x y : R'_0),
    D_base b (x + y) = D_base b x + D_base b y ∧
    D_base b (x * y) = x * D_base b y + y * D_base b x
  hD_φ : ∀ (b : Fin 2) (P : MvPolynomial (Fin 2) k),
    D_base b (φ_P P) = φ_P (MvPolynomial.pderiv b P)
  hD_h0 :
    let h_0 := τ_crit (MvPolynomial.C ℓ_0 + MvPolynomial.X (0 : Fin 2) * MvPolynomial.C ℓ_1 +
      MvPolynomial.X (1 : Fin 2) * MvPolynomial.C ℓ_2)
    ε_R (D_base (0 : Fin 2) h_0) = ε_z ℓ_1 ∧ ε_R (D_base (1 : Fin 2) h_0) = ε_z ℓ_2
  he_Y0_et : e_Y0.Etale
  hq_0_et : q_0.Etale
  hComm_0 :
    e_Y0.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.map (algebraMap k A_Z))) =
      (q_0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp φ_P
  hSec_surj :
    let G_poly : MvPolynomial (Fin 2) A_Z :=
      MvPolynomial.C ℓ_0 + MvPolynomial.X (0 : Fin 2) * MvPolynomial.C ℓ_1 +
        MvPolynomial.X (1 : Fin 2) * MvPolynomial.C ℓ_2
    let h_0 := τ_crit G_poly
    ∀ u : PrimeSpectrum R'_0, h_0 ∈ u.asIdeal →
      ∃ v : PrimeSpectrum B'_0,
        PrimeSpectrum.comap (e_Y0.comp (Ideal.Quotient.mk _)) v =
          PrimeSpectrum.comap τ_crit u ∧
        PrimeSpectrum.comap (q_0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) v = u ∧
        (∀ idx : Fin (m + 1) × Fin 2,
          q_0 (Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∈ v.asIdeal) ∧
        q_0 (Ideal.Quotient.mk _ (MvPolynomial.C h_0)) ∈ v.asIdeal

def IsBoundaryAligned2dOdpChartAt (k : Type u) [Field k] (m : ℕ)
    (Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (g₂ : Y₂ ⟶ weilProjectiveSpaceOver k 2)
    (ι_line : weilProjectiveSpaceOver k 1 ⟶ weilProjectiveSpaceOver k 2)
    (b_idx : Fin 2)
    (s_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 1).left) : Prop :=
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
    MvPolynomial.gradedAlgebra
  let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k
  let U₂ := AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X b_idx.castSucc)
  ∃ (y_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Y₂.left)
    (R'_2 B'_2 : CommRingCat.{u})
    (u_2 : AlgebraicGeometry.Spec R'_2)
    (e_B2 : AlgebraicGeometry.Spec R'_2 ⟶ (weilProjectiveSpaceOver k 2).left)
    (h_2 : R'_2) (ψ_B2 : MvPolynomial (Fin 2) k →+* R'_2)
    (v_2 : AlgebraicGeometry.Spec B'_2)
    (e_Y2 : AlgebraicGeometry.Spec B'_2 ⟶ Y₂.left)
    (q_2 : AlgebraicGeometry.Spec B'_2 ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin (m + 1) × Fin 2) R'_2 ⧸ Ideal.span
        {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
          MvPolynomial.C h_2})))
    (h_le2 : (⊤ : (AlgebraicGeometry.Spec R'_2).Opens) ≤
      (TopologicalSpace.Opens.map e_B2.base).obj U₂),
    y_pt ≫ Y₂.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
    y_pt ≫ g₂.left = s_pt ≫ ι_line.left ∧
    (∀ y' : Y₂.left, g₂.left.base y' ∈ Set.range (s_pt ≫ ι_line.left).base →
      y' ∉ Set.range y_pt.base →
        ∃ V : Y₂.left.Opens, y' ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ g₂.left)) ∧
    AlgebraicGeometry.Etale e_B2 ∧
    AlgebraicGeometry.Etale e_Y2 ∧
    AlgebraicGeometry.Etale q_2 ∧
    ψ_B2 (MvPolynomial.X 0) = h_2 ∧
    ψ_B2 (MvPolynomial.X 1) =
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X b_idx.castSucc)
          (MvPolynomial.isHomogeneous_X k b_idx.castSucc) zero_lt_one).hom ≫
        e_B2.appLE U₂ ⊤ h_le2 ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso R'_2).hom).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X 2, MvPolynomial.isHomogeneous_X k 2⟩,
            ⟨MvPolynomial.X b_idx.castSucc, MvPolynomial.isHomogeneous_X k b_idx.castSucc⟩,
            ⟨1, pow_one _⟩⟩) ∧
    AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B2)) ∧
    e_B2 ≫ (weilProjectiveSpaceOver k 2).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B2) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ∧
    h_2 ∈ u_2.asIdeal ∧
    ψ_B2 (MvPolynomial.X 1) ∈ u_2.asIdeal ∧
    (∀ idx : Fin (m + 1) × Fin 2,
      Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q_2.base v_2).asIdeal) ∧
    Ideal.Quotient.mk _ (MvPolynomial.C h_2) ∈ (q_2.base v_2).asIdeal ∧
    e_Y2 ≫ g₂.left =
      q_2 ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_B2 ∧
    (∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k),
      e_B2.base u_2 = (s_pt ≫ ι_line.left).base pt ∧ e_Y2.base v_2 = y_pt.base pt)
noncomputable def weilMvPolyMapCoeffs {σ C : Type*} [CommSemiring C]
    (D : C → C) (f : MvPolynomial σ C) : MvPolynomial σ C :=
  ∑ m ∈ f.support, MvPolynomial.monomial m (D (f.coeff m))

noncomputable def weilQuadTransform {n : ℕ} {k S : Type*} [CommRing k] [CommRing S]
    (ρ : k →+* S) (C : Matrix (Fin n) (Fin n) k) (Q_S : Fin n → Fin n → S)
    (a b : Fin n) : S :=
  if b < a then 0
  else if a = b then
    ∑ i : Fin n, ∑ j : Fin n, Q_S i j * ρ (C i a) * ρ (C j a)
  else
    ∑ i : Fin n, ∑ j : Fin n, Q_S i j * (ρ (C i a) * ρ (C j b) + ρ (C i b) * ρ (C j a))

noncomputable def weilCritLocRingCat {A : Type u} [CommRing A] {d : ℕ}
    (dG : Fin d → MvPolynomial (Fin 2) A) (δ : MvPolynomial (Fin 2) A) : CommRingCat.{u} :=
  CommRingCat.of (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range dG)) δ))

noncomputable def weilCritLocTau {A : Type u} [CommRing A] {d : ℕ}
    (dG : Fin d → MvPolynomial (Fin 2) A) (δ : MvPolynomial (Fin 2) A) :
    MvPolynomial (Fin 2) A →+* weilCritLocRingCat dG δ :=
  (algebraMap (MvPolynomial (Fin 2) A ⧸ Ideal.span (Set.range dG))
    (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range dG)) δ))).comp
    (Ideal.Quotient.mk (Ideal.span (Set.range dG)))
noncomputable def weilCupPDTraceGlobCoeffMapH (S : AlgebraicGeometry.Scheme.{u})
    {m₁ m₂ : ℕ} (φ : ZMod m₁ →+ ZMod m₂) (q : ℕ) :
    weilEtaleTorsionH S m₁ q →+ weilEtaleTorsionH S m₂ q :=
  (CategoryTheory.Abelian.Ext.mk₀
    ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map
      (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ)))).postcomp
    ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero q)

noncomputable def weilCupPDTraceLocCoeffMapH (S : AlgebraicGeometry.Scheme.{u})
    {m₁ m₂ : ℕ} (φ : ZMod m₁ →+ ZMod m₂) (U : S.Etale) (q : ℕ) :
    weilCupPDTraceLocalTorsionH S m₁ U q →+ weilCupPDTraceLocalTorsionH S m₂ U q :=
  let c_φ := AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ)
  let map_S : Quiver.Hom (weilCupPDTraceLocalTorsionSheaf S m₁ U)
      (weilCupPDTraceLocalTorsionSheaf S m₂ U) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
      (CategoryTheory.CategoryStruct.comp c_φ
        (CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.CategoryStruct.id (weilCupPDTraceLocalTorsionSheaf S m₂ U))))
  (CategoryTheory.Abelian.Ext.mk₀ map_S).postcomp
    ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero q)

def WeilCupPDTraceHallStepPkg (k : Type u) [Field k] (n : ℕ)
    (Ψ : WeilCupPDTraceRoofSystem k n)
    (P : ℕ → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_aff : ∀ δ : ℕ, Quiver.Hom (weilAffineSpaceOver k δ).left (P δ).left)
    (m : ℕ) (hm_dvd : m ∣ n)
    (tr_m : ∀ δ : ℕ, weilEtaleTorsionH (P δ).left m (2 * δ) →+ ZMod m) : Prop :=
  Function.Bijective (tr_m 0) ∧
  (∀ (δ q : ℕ) (U : (P δ).left.Etale),
    AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget (P δ).left).obj U).left →
    2 * δ < q →
    Subsingleton (weilCupPDTraceLocalTorsionH (P δ).left m U q)) ∧
  (∀ (δ : ℕ) (j : Fin δ) (U₁ U₂ : (P δ).left.Etale)
      (u₁ : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (P δ).left).obj U₁).left
        (weilAffineSpaceOver k δ).left)
      (u₂ : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (P δ).left).obj U₂).left
        (weilAffineSpaceOver k δ).left)
      (e : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget (P δ).left).obj U₁).left
        ((AlgebraicGeometry.Scheme.Etale.forget (P δ).left).obj U₂).left)
      (h : WeilCupPDTraceIsAffineRoofIso k (P δ) (P δ) U₁ U₂ e),
    AlgebraicGeometry.Etale u₁ →
    AlgebraicGeometry.Etale u₂ →
    CategoryTheory.CategoryStruct.comp u₁ (ι_aff δ) =
      ((AlgebraicGeometry.Scheme.Etale.forget (P δ).left).obj U₁).hom →
    CategoryTheory.CategoryStruct.comp u₂ (ι_aff δ) =
      ((AlgebraicGeometry.Scheme.Etale.forget (P δ).left).obj U₂).hom →
    (∀ (i : Fin δ), i ≠ j →
      let pr_i : Quiver.Hom (weilAffineSpaceOver k δ).left
          (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Polynomial.aeval (MvPolynomial.X i : MvPolynomial (Fin δ) k)).toRingHom)
      CategoryTheory.CategoryStruct.comp u₁ pr_i =
        CategoryTheory.CategoryStruct.comp e.hom
          (CategoryTheory.CategoryStruct.comp u₂ pr_i)) →
    ∀ z : weilCupPDTraceLocalTorsionH (P δ).left n U₁ (2 * δ),
      tr_m δ
        (weilCupPDTraceLocalTorsionCounitH (P δ).left m U₁ (2 * δ)
          (weilCupPDTraceLocCoeffMapH (P δ).left
            (ZMod.castHom hm_dvd (ZMod m)).toAddMonoidHom U₁ (2 * δ) z)) =
      tr_m δ
        (weilCupPDTraceLocalTorsionCounitH (P δ).left m U₂ (2 * δ)
          (weilCupPDTraceLocCoeffMapH (P δ).left
            (ZMod.castHom hm_dvd (ZMod m)).toAddMonoidHom U₂ (2 * δ)
            (Ψ (P δ) (P δ) U₁ U₂ e h (2 * δ) z)))) ∧
  (∀ (δ : ℕ)
      (V : (P δ).left.Etale)
      (U : (P (δ + 1)).left.Etale)
      (u_V : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (P δ).left).obj V).left
        (weilAffineSpaceOver k δ).left)
      (u_U : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (P (δ + 1)).left).obj U).left
        (weilAffineSpaceOver k (δ + 1)).left)
      (h_UV : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (P (δ + 1)).left).obj U).left
        ((AlgebraicGeometry.Scheme.Etale.forget (P δ).left).obj V).left)
      (t_U : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget (P (δ + 1)).left).obj U).left
        (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))),
    AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget (P δ).left).obj V).left →
    AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget (P (δ + 1)).left).obj U).left →
    AlgebraicGeometry.Etale u_V →
    AlgebraicGeometry.Etale u_U →
    CategoryTheory.CategoryStruct.comp u_V (ι_aff δ) =
      ((AlgebraicGeometry.Scheme.Etale.forget (P δ).left).obj V).hom →
    CategoryTheory.CategoryStruct.comp u_U (ι_aff (δ + 1)) =
      ((AlgebraicGeometry.Scheme.Etale.forget (P (δ + 1)).left).obj U).hom →
    CategoryTheory.CategoryStruct.comp u_U
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (MvPolynomial.rename Fin.castSucc :
          MvPolynomial (Fin δ) k →ₐ[k] MvPolynomial (Fin (δ + 1)) k).toRingHom)) =
      CategoryTheory.CategoryStruct.comp h_UV u_V →
    CategoryTheory.CategoryStruct.comp u_U
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Polynomial.aeval (MvPolynomial.X (Fin.last δ) : MvPolynomial (Fin (δ + 1)) k)).toRingHom)) =
      t_U →
    AlgebraicGeometry.SmoothOfRelativeDimension 1 h_UV →
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω))
          ((AlgebraicGeometry.Scheme.Etale.forget (P δ).left).obj V).left),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback h_UV s)) →
    Function.Bijective
      (fun z : weilCupPDTraceLocalTorsionH (P δ).left m V (2 * δ) =>
        tr_m δ (weilCupPDTraceLocalTorsionCounitH (P δ).left m V (2 * δ) z)) →
    Function.Bijective
      (fun z : weilCupPDTraceLocalTorsionH (P (δ + 1)).left m U (2 * (δ + 1)) =>
        tr_m (δ + 1)
          (weilCupPDTraceLocalTorsionCounitH (P (δ + 1)).left m U (2 * (δ + 1)) z)))
