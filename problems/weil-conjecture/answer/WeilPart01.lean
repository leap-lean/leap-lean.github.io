        ∃ (e_R2 : CategoryTheory.Iso
            (weilEtaleHigherDirectImage f 2 (pf_g.obj G))
            (weilEtaleHigherDirectImage h_Wf 2 G)),
          (let Q₁ : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
             CategoryTheory.Sheaf.cohomologyPresheaf (pf_g.obj G) 2
