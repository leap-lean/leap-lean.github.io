    Quiver.Hom (weilGysinAffineSpace k c) (weilGysinAffineSpace k c) :=
  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.rename (R := k) π).toRingHom)

structure WeilGysinAbSupportClass (Z Y : AlgebraicGeometry.Scheme.{u})
    (i : Quiver.Hom Z Y) (m q : ℕ) : Type u where
  hCont :
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor Y.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
    B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology
  val :
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor Y.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
    letI := hCont
    let i_push_ab := B.sheafPushforwardContinuous AddCommGrpCat.{u} Y.smallEtaleTopology Z.smallEtaleTopology
    let Fℤ_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    CategoryTheory.Abelian.Ext.{u} (i_push_ab.obj Fℤ_Z) (weilEtaleTorsionSheaf Y m) q

noncomputable abbrev weilGysinAbSupportExtGroup {Z Y : AlgebraicGeometry.Scheme.{u}}
    {i : Quiver.Hom Z Y} {m q : ℕ}
    (α₀ : WeilGysinAbSupportClass Z Y i m q) : Type u :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor Y.Etale Z.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
  letI := α₀.hCont
  let i_push_ab := B.sheafPushforwardContinuous AddCommGrpCat.{u} Y.smallEtaleTopology Z.smallEtaleTopology
  let Fℤ_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  CategoryTheory.Abelian.Ext.{u} (i_push_ab.obj Fℤ_Z) (weilEtaleTorsionSheaf Y m) q

noncomputable def weilGysinAbSupportTransition {Z Y : AlgebraicGeometry.Scheme.{u}}
    {i : Quiver.Hom Z Y} (ℓ r q : ℕ)
    (α_succ : WeilGysinAbSupportClass Z Y i (ℓ ^ (r + 1)) q) :
    WeilGysinAbSupportClass Z Y i (ℓ ^ r) q :=
  { hCont := α_succ.hCont
    val :=
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B : CategoryTheory.Functor Y.Etale Z.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
      letI := α_succ.hCont
      let i_push_ab := B.sheafPushforwardContinuous AddCommGrpCat.{u} Y.smallEtaleTopology Z.smallEtaleTopology
      let Fℤ_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      (CategoryTheory.Abelian.Ext.mk₀
        ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).map
          (AddCommGrpCat.uliftFunctor.{u, 0}.map
            (AddCommGrpCat.ofHom
              (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom)))).postcomp
        (i_push_ab.obj Fℤ_Z) (Nat.add_zero q) α_succ.val }

def WeilGysinAbSupportPullback {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
    (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y) (m q : ℕ)
    (α' : WeilGysinAbSupportClass Z' Y' i' m q)
    (α : WeilGysinAbSupportClass Z Y i m q) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i' :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i' :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_i : CategoryTheory.Functor Y.Etale Z.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
  let B_i' : CategoryTheory.Functor Y'.Etale Z'.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i'
  let B_g : CategoryTheory.Functor Y.Etale Y'.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
  letI := α.hCont
  letI := α'.hCont
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let i_push := B_i.sheafPushforwardContinuous AddCommGrpCat.{u} Y.smallEtaleTopology Z.smallEtaleTopology
  let i'_push := B_i'.sheafPushforwardContinuous AddCommGrpCat.{u} Y'.smallEtaleTopology Z'.smallEtaleTopology
  let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_Y' := (CategoryTheory.constantSheaf Y'.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_Z' := (CategoryTheory.constantSheaf Z'.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let FM_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj AM
  let FM_Y' := (CategoryTheory.constantSheaf Y'.smallEtaleTopology AddCommGrpCat.{u}).obj AM
  ∃ (hCont_g : B_g.IsContinuous Y.smallEtaleTopology Y'.smallEtaleTopology),
    letI := hCont_g
    let g_push := B_g.sheafPushforwardContinuous AddCommGrpCat.{u} Y.smallEtaleTopology Y'.smallEtaleTopology
    ∃ (P_pull : CategoryTheory.Functor
        (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u}))
      (adj_pull : CategoryTheory.Adjunction P_pull g_push)
      (hAdd : P_pull.Additive)
      (hLim : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
      (hColim : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
      (T_Y : Y.Etale) (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
      (T_Z : Z.Etale) (hT_Z : CategoryTheory.Limits.IsTerminal T_Z)
      (T_Y' : Y'.Etale) (hT_Y' : CategoryTheory.Limits.IsTerminal T_Y')
      (T_Z' : Z'.Etale) (hT_Z' : CategoryTheory.Limits.IsTerminal T_Z'),
      letI := hAdd
      letI := hLim
      letI := hColim
      let adj_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT_Y
      let adj_Z := CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z
      let adj_Y' := CategoryTheory.constantSheafAdj Y'.smallEtaleTopology AddCommGrpCat.{u} hT_Y'
      let adj_Z' := CategoryTheory.constantSheafAdj Z'.smallEtaleTopology AddCommGrpCat.{u} hT_Z'
      let τ_i : Quiver.Hom (B_i.obj T_Y) T_Z := hT_Z.from (B_i.obj T_Y)
      let τ_i' : Quiver.Hom (B_i'.obj T_Y') T_Z' := hT_Z'.from (B_i'.obj T_Y')
      let τ_g : Quiver.Hom (B_g.obj T_Y) T_Y' := hT_Y'.from (B_g.obj T_Y)
      let q_i : Quiver.Hom Fℤ_Y (i_push.obj Fℤ_Z) :=
        (adj_Y.homEquiv Aℤ (i_push.obj Fℤ_Z)).symm
          (CategoryTheory.CategoryStruct.comp (adj_Z.unit.app Aℤ) (Fℤ_Z.obj.map τ_i.op))
      let q_i' : Quiver.Hom Fℤ_Y' (i'_push.obj Fℤ_Z') :=
        (adj_Y'.homEquiv Aℤ (i'_push.obj Fℤ_Z')).symm
          (CategoryTheory.CategoryStruct.comp (adj_Z'.unit.app Aℤ) (Fℤ_Z'.obj.map τ_i'.op))
      let πℤ_Y : Quiver.Hom (P_pull.obj Fℤ_Y) Fℤ_Y' :=
        (adj_pull.homEquiv Fℤ_Y Fℤ_Y').symm
          ((adj_Y.homEquiv Aℤ (g_push.obj Fℤ_Y')).symm
            (CategoryTheory.CategoryStruct.comp (adj_Y'.unit.app Aℤ) (Fℤ_Y'.obj.map τ_g.op)))
      let πM_Y : Quiver.Hom (P_pull.obj FM_Y) FM_Y' :=
        (adj_pull.homEquiv FM_Y FM_Y').symm
          ((adj_Y.homEquiv AM (g_push.obj FM_Y')).symm
            (CategoryTheory.CategoryStruct.comp (adj_Y'.unit.app AM) (FM_Y'.obj.map τ_g.op)))
      ∃ (ιℤ_Y : Quiver.Hom Fℤ_Y' (P_pull.obj Fℤ_Y))
        (β : Quiver.Hom (i'_push.obj Fℤ_Z') (P_pull.obj (i_push.obj Fℤ_Z))),
        CategoryTheory.CategoryStruct.comp ιℤ_Y πℤ_Y = CategoryTheory.CategoryStruct.id Fℤ_Y' ∧
        CategoryTheory.CategoryStruct.comp πℤ_Y ιℤ_Y = CategoryTheory.CategoryStruct.id (P_pull.obj Fℤ_Y) ∧
        CategoryTheory.CategoryStruct.comp q_i' β =
          CategoryTheory.CategoryStruct.comp ιℤ_Y (P_pull.map q_i) ∧
        α'.val = (CategoryTheory.Abelian.Ext.mk₀ πM_Y).postcomp (i'_push.obj Fℤ_Z') (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ β).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull _ _ _ _ _
              (i_push.obj Fℤ_Z) FM_Y q) α.val)
            (Nat.zero_add q))

def WeilGysinIsAbSupportComparison {Z Y : AlgebraicGeometry.Scheme.{u}}
    {i : Quiver.Hom Z Y} {m q : ℕ}
    (τ : WeilGysinSupportClass Z Y i m q)
    (α_ab : WeilGysinAbSupportClass Z Y i m q) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let R := ULift.{u, 0} (ZMod m)
  let R_mod := ModuleCat.of R R
  let J_Y := Y.smallEtaleTopology
  let J_Z := Z.smallEtaleTopology
  let B_i : CategoryTheory.Functor Y.Etale Z.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
  letI := τ.hCont
  let i_push_mod := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R) J_Y J_Z
  let i_push_ab := B_i.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_Z
  let One_Y := (CategoryTheory.constantSheaf J_Y (ModuleCat.{u, u} R)).obj R_mod
  let One_Z := (CategoryTheory.constantSheaf J_Z (ModuleCat.{u, u} R)).obj R_mod
  let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let C_ab_Y := CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}
  let C_ab_Z := CategoryTheory.constantSheaf J_Z AddCommGrpCat.{u}
  let Fℤ_Z := C_ab_Z.obj Aℤ
  let FM_Y := C_ab_Y.obj AM
  let ιM : Quiver.Hom AM (F_fg.obj R_mod) := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let z_to_m : Quiver.Hom Aℤ AM :=
    AddCommGrpCat.ofHom
      { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod m)
        map_zero' := congrArg ULift.up Int.cast_zero
        map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }
  ∃ (U_Y : CategoryTheory.Functor
      (CategoryTheory.Sheaf J_Y (ModuleCat.{u, u} R))
      (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}))
    (U_Z : CategoryTheory.Functor
      (CategoryTheory.Sheaf J_Z (ModuleCat.{u, u} R))
      (CategoryTheory.Sheaf J_Z AddCommGrpCat.{u})),
    (∀ ℱ : CategoryTheory.Sheaf J_Y (ModuleCat.{u, u} R),
      (U_Y.obj ℱ).obj = CategoryTheory.Functor.comp ℱ.obj F_fg) ∧
    (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J_Y (ModuleCat.{u, u} R)} (u : Quiver.Hom ℱ₁ ℱ₂)
      (V : Opposite Y.Etale),
      HEq ((U_Y.map u).hom.app V) (F_fg.map (u.hom.app V))) ∧
    (∀ 𝒢 : CategoryTheory.Sheaf J_Z (ModuleCat.{u, u} R),
      (U_Z.obj 𝒢).obj = CategoryTheory.Functor.comp 𝒢.obj F_fg) ∧
    (∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J_Z (ModuleCat.{u, u} R)} (u : Quiver.Hom 𝒢₁ 𝒢₂)
      (W : Opposite Z.Etale),
      HEq ((U_Z.map u).hom.app W) (F_fg.map (u.hom.app W))) ∧
    ∃ (hAdd : U_Y.Additive) (hLim : CategoryTheory.Limits.PreservesFiniteLimits U_Y)
      (hColim : CategoryTheory.Limits.PreservesFiniteColimits U_Y)
      (T_Y : Y.Etale) (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
      (T_Z : Z.Etale) (hT_Z : CategoryTheory.Limits.IsTerminal T_Z),
      letI := hAdd
      letI := hLim
      letI := hColim
      let adj_ab_Y := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT_Y
      let adj_mod_Y := CategoryTheory.constantSheafAdj J_Y (ModuleCat.{u, u} R) hT_Y
      let adj_ab_Z := CategoryTheory.constantSheafAdj J_Z AddCommGrpCat.{u} hT_Z
      let adj_mod_Z := CategoryTheory.constantSheafAdj J_Z (ModuleCat.{u, u} R) hT_Z
      ∃ (u_unit_Y : Quiver.Hom (F_fg.obj R_mod) ((U_Y.obj One_Y).obj.obj (Opposite.op T_Y)))
        (u_unit_Z : Quiver.Hom (F_fg.obj R_mod) ((U_Z.obj One_Z).obj.obj (Opposite.op T_Z)))
        (γ_push : Quiver.Hom (i_push_ab.obj (U_Z.obj One_Z)) (U_Y.obj (i_push_mod.obj One_Z))),
        HEq u_unit_Y (F_fg.map (adj_mod_Y.unit.app R_mod)) ∧
        HEq u_unit_Z (F_fg.map (adj_mod_Z.unit.app R_mod)) ∧
        (∀ V : Opposite Y.Etale,
          HEq (γ_push.hom.app V)
            (CategoryTheory.CategoryStruct.id (F_fg.obj (One_Z.obj.obj (Opposite.op (B_i.obj V.unop)))))) ∧
        let αM_Y : Quiver.Hom FM_Y (U_Y.obj One_Y) :=
          (adj_ab_Y.homEquiv AM (U_Y.obj One_Y)).symm
            (CategoryTheory.CategoryStruct.comp ιM u_unit_Y)
        let αM_Z : Quiver.Hom (C_ab_Z.obj AM) (U_Z.obj One_Z) :=
          (adj_ab_Z.homEquiv AM (U_Z.obj One_Z)).symm
            (CategoryTheory.CategoryStruct.comp ιM u_unit_Z)
        let ιℤ_Z : Quiver.Hom Fℤ_Z (U_Z.obj One_Z) :=
          CategoryTheory.CategoryStruct.comp (C_ab_Z.map z_to_m) αM_Z
        let ζ_Z : Quiver.Hom (i_push_ab.obj Fℤ_Z) (U_Y.obj (i_push_mod.obj One_Z)) :=
          CategoryTheory.CategoryStruct.comp (i_push_ab.map ιℤ_Z) γ_push
        ∃ (πM_Y : Quiver.Hom (U_Y.obj One_Y) FM_Y),
          CategoryTheory.CategoryStruct.comp αM_Y πM_Y = CategoryTheory.CategoryStruct.id FM_Y ∧
          CategoryTheory.CategoryStruct.comp πM_Y αM_Y = CategoryTheory.CategoryStruct.id (U_Y.obj One_Y) ∧
          α_ab.val = (CategoryTheory.Abelian.Ext.mk₀ πM_Y).postcomp (i_push_ab.obj Fℤ_Z) (Nat.add_zero q)
            ((CategoryTheory.Abelian.Ext.mk₀ ζ_Z).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U_Y _ _ _ _ _
                (i_push_mod.obj One_Z) One_Y q) τ.val)
              (Nat.zero_add q))
noncomputable def weilPicSurj_polyBasisEquiv {B R : Type u} [CommRing B] [CommRing R]
    [Algebra (Polynomial B) R] {r : ℕ} (b : Fin r → R)
    (hb : Function.Bijective (fun f : Fin r → Polynomial B =>
      Finset.univ.sum fun j => algebraMap (Polynomial B) R (f j) * b j)) :
    (Fin r → Polynomial B) ≃ₗ[Polynomial B] R :=
  LinearEquiv.ofBijective
    { toFun := fun f => Finset.univ.sum fun j => algebraMap (Polynomial B) R (f j) * b j
      map_add' := fun f g => by
        simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
      map_smul' := fun p f => by
        simp only [Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc, Finset.mul_sum,
          RingHom.id_apply, Algebra.smul_def] }
    hb

noncomputable def weilPicSurj_awayIdealBaseChangeEquiv {R S : Type u} [CommRing R] [CommRing S]
    [Algebra R S] (t : R) [IsLocalization.Away t S]
    (ht_reg : ∀ r : R, t * r = 0 → r = 0) (K : Ideal R) :
    TensorProduct R S ↥K ≃ₗ[S] ↥(Ideal.map (algebraMap R S) K) :=
  let F₀ : TensorProduct R S ↥K →ₗ[S] S :=
    (TensorProduct.AlgebraTensorModule.rid R S S).toLinearMap.comp
      (LinearMap.baseChange S K.subtype)
  have hF₀_mem : ∀ z, F₀ z ∈ Ideal.map (algebraMap R S) K := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul s x =>
      simp only [F₀, LinearMap.comp_apply, LinearMap.baseChange_tmul, Submodule.coe_subtype,
        LinearEquiv.coe_coe, TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def]
      exact Ideal.mul_mem_right s _ (Ideal.mem_map_of_mem _ x.2)
    | add z₁ z₂ ih₁ ih₂ => rw [map_add]; exact Ideal.add_mem _ ih₁ ih₂
  let F : TensorProduct R S ↥K →ₗ[S] ↥(Ideal.map (algebraMap R S) K) :=
    F₀.codRestrict (Ideal.map (algebraMap R S) K) hF₀_mem
  LinearEquiv.ofBijective F ⟨by
    have h_clear_tmul : ∀ z : TensorProduct R S ↥K,
        ∃ (m : ℕ) (x : ↥K), (algebraMap R S t ^ m) • z = (1 : S) ⊗ₜ[R] x := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨0, 0, by simp⟩
      | tmul s x =>
        let k := (IsLocalization.Away.sec t s).2
        let r := (IsLocalization.Away.sec t s).1
        refine ⟨k, r • x, ?_⟩
        have hsec := IsLocalization.Away.sec_spec t s
        rw [TensorProduct.smul_tmul', smul_eq_mul, ← map_pow, mul_comm, hsec,
          ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
      | add z₁ z₂ ih₁ ih₂ =>
        obtain ⟨m₁, x₁, h₁⟩ := ih₁
        obtain ⟨m₂, x₂, h₂⟩ := ih₂
        refine ⟨m₁ + m₂, (t ^ m₂) • x₁ + (t ^ m₁) • x₂, ?_⟩
        have hp1 : (algebraMap R S t ^ (m₁ + m₂)) • z₁ = (1 : S) ⊗ₜ[R] ((t ^ m₂) • x₁) := by
          rw [pow_add, mul_comm (algebraMap R S t ^ m₁), mul_smul, h₁,
            TensorProduct.smul_tmul', smul_eq_mul, mul_one, ← TensorProduct.smul_tmul,
            Algebra.smul_def, map_pow, mul_one]
        have hp2 : (algebraMap R S t ^ (m₁ + m₂)) • z₂ = (1 : S) ⊗ₜ[R] ((t ^ m₁) • x₂) := by
          rw [pow_add, mul_smul, h₂,
            TensorProduct.smul_tmul', smul_eq_mul, mul_one, ← TensorProduct.smul_tmul,
            Algebra.smul_def, map_pow, mul_one]
        rw [smul_add, hp1, hp2, TensorProduct.tmul_add]
    have hinj : Function.Injective (algebraMap R S) := by
      refine IsLocalization.injective S (M := Submonoid.powers t) (Submonoid.powers_le.mpr ?_)
      rw [mem_nonZeroDivisors_iff_right]
      intro x hx
      exact ht_reg x (by rw [mul_comm]; exact hx)
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro z hz
    rw [LinearMap.mem_ker] at hz
    have hF₀z : F₀ z = 0 := congrArg Subtype.val hz
    obtain ⟨m, x, hm⟩ := h_clear_tmul z
    have hx0 : algebraMap R S x.1 = 0 := by
      have h1 := congrArg F₀ hm
      rw [map_smul, hF₀z, smul_zero] at h1
      simpa [F₀, Algebra.smul_def] using h1.symm
    have hx_eq : x = 0 := Subtype.ext (hinj (hx0.trans (map_zero _).symm))
    rw [hx_eq, TensorProduct.tmul_zero] at hm
    have hu : IsUnit (algebraMap R S t ^ m) := (IsLocalization.Away.algebraMap_isUnit t).pow m
    exact (hu.smul_eq_zero).mp hm, by
    have h_clear_map : ∀ {w : S}, w ∈ Ideal.map (algebraMap R S) K →
        ∃ (m : ℕ) (r : R), r ∈ K ∧ algebraMap R S t ^ m * w = algebraMap R S r := by
      intro w hw
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hw
      · rintro _ ⟨x, hx, rfl⟩
        exact ⟨0, x, hx, by simp⟩
      · exact ⟨0, 0, K.zero_mem, by simp⟩
      · intro z₁ z₂ _ _ ⟨m₁, x₁, hx₁, h₁⟩ ⟨m₂, x₂, hx₂, h₂⟩
        refine ⟨m₁ + m₂, t ^ m₂ * x₁ + t ^ m₁ * x₂,
          K.add_mem (K.mul_mem_left _ hx₁) (K.mul_mem_left _ hx₂), ?_⟩
        calc
          algebraMap R S t ^ (m₁ + m₂) * (z₁ + z₂) =
              algebraMap R S t ^ m₂ * (algebraMap R S t ^ m₁ * z₁) +
              algebraMap R S t ^ m₁ * (algebraMap R S t ^ m₂ * z₂) := by ring
          _ = algebraMap R S (t ^ m₂ * x₁ + t ^ m₁ * x₂) := by
            rw [h₁, h₂, map_add, map_mul, map_mul, map_pow, map_pow]
      · intro s z₀ _ ⟨m, x, hx, h⟩
        let k := (IsLocalization.Away.sec t s).2
        let r := (IsLocalization.Away.sec t s).1
        have hsec := IsLocalization.Away.sec_spec t s
        refine ⟨k + m, r * x, K.mul_mem_left _ hx, ?_⟩
        calc
          algebraMap R S t ^ (k + m) * (s • z₀) =
              (s * algebraMap R S (t ^ k)) * (algebraMap R S t ^ m * z₀) := by
            rw [smul_eq_mul, map_pow]; ring
          _ = algebraMap R S (r * x) := by rw [hsec, h, map_mul]
    rintro ⟨w, hw⟩
    obtain ⟨m, r, hr, hmw⟩ := h_clear_map hw
    let u_t : Sˣ := (IsLocalization.Away.algebraMap_isUnit t).unit
    refine ⟨((u_t ^ m)⁻¹ : Sˣ).val ⊗ₜ[R] (⟨r, hr⟩ : ↥K), Subtype.ext ?_⟩
    simp only [F, F₀, LinearMap.codRestrict_apply, LinearMap.comp_apply,
      LinearMap.baseChange_tmul, Submodule.coe_subtype, LinearEquiv.coe_coe,
      TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def]
    have hut : (u_t ^ m : Sˣ).val = algebraMap R S t ^ m := by simp [u_t]
    rw [mul_comm (algebraMap R S r), ← hmw, ← hut, ← mul_assoc, Units.inv_mul, one_mul]⟩

noncomputable def weilPicSurj_mvPolyDeriv {A σ : Type u} [CommRing A] (s : σ)
    (Q : Polynomial (MvPolynomial σ A)) : Polynomial (MvPolynomial σ A) :=
  ∑ n ∈ Q.support, Polynomial.monomial n (MvPolynomial.pderiv s (Q.coeff n))
noncomputable abbrev weilC1AffEtSepHom (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂] :
    Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of E₂))
      (AlgebraicGeometry.Spec (CommRingCat.of E₁)) :=
  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₁ E₂))

noncomputable def weilC1AffEtAlg (F : Type u) [Field F]
    (U : (AlgebraicGeometry.Spec (CommRingCat.of F)).AffineEtale) :
    Algebra F ↑U.left.unop :=
  ((AlgebraicGeometry.Scheme.Spec.preimage U.hom).unop.hom).toAlgebra

noncomputable def weilC1AffEtForgetSite (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
    [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂] :
    CategoryTheory.Functor
      (AlgebraicGeometry.Spec (CommRingCat.of E₂)).AffineEtale
      (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale :=
  letI : Algebra.Etale E₁ E₂ :=
    @Algebra.Etale.mk E₁ E₂ _ _ _ (Algebra.FormallyEtale.of_isSeparable E₁ E₂)
      (Algebra.FinitePresentation.of_finiteType.mp inferInstance)
  letI : AlgebraicGeometry.Etale (weilC1AffEtSepHom E₁ E₂) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr inferInstance)
  { obj := fun V =>
      haveI : AlgebraicGeometry.Etale V.hom := V.prop
      AlgebraicGeometry.Scheme.AffineEtale.mk (R := V.left.unop)
        (CategoryTheory.CategoryStruct.comp V.hom (weilC1AffEtSepHom E₁ E₂))
    map := fun g =>
      CategoryTheory.MorphismProperty.CostructuredArrow.homMk g.left trivial
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (fun k => CategoryTheory.CategoryStruct.comp k (weilC1AffEtSepHom E₁ E₂)) g.w))
    map_id := fun _ => rfl
    map_comp := fun _ _ => rfl }

noncomputable def weilC1AffEtBaseChangeSite (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂] :
    CategoryTheory.Functor
      (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale
      (AlgebraicGeometry.Spec (CommRingCat.of E₂)).AffineEtale where
  obj U :=
    letI : Algebra E₁ ↑U.left.unop := weilC1AffEtAlg E₁ U
    have hEqHom :
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Spec.preimage U.hom).unop = U.hom :=
      AlgebraicGeometry.Scheme.Spec.map_preimage U.hom
    haveI : Algebra.Etale E₁ ↑U.left.unop :=
      RingHom.etale_algebraMap.mp
        ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hEqHom.symm ▸ U.prop))
    haveI : Algebra.Etale E₂ (TensorProduct E₁ E₂ ↑U.left.unop) :=
      Algebra.Etale.baseChange E₁ (↑U.left.unop) E₂
    haveI : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap E₂ (TensorProduct E₁ E₂ ↑U.left.unop)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    AlgebraicGeometry.Scheme.AffineEtale.mk
      (R := CommRingCat.of (TensorProduct E₁ E₂ ↑U.left.unop))
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap E₂ (TensorProduct E₁ E₂ ↑U.left.unop))))
  map {U₁ U₂} g :=
    letI : Algebra E₁ ↑U₁.left.unop := weilC1AffEtAlg E₁ U₁
    letI : Algebra E₁ ↑U₂.left.unop := weilC1AffEtAlg E₁ U₂
    let φ_g : ↑U₂.left.unop →ₐ[E₁] ↑U₁.left.unop :=
      { toRingHom := (g.left.unop).hom
        commutes' := fun r => by
          have hpre : CategoryTheory.CategoryStruct.comp g.left
              (AlgebraicGeometry.Scheme.Spec.preimage U₂.hom) =
              AlgebraicGeometry.Scheme.Spec.preimage U₁.hom :=
            AlgebraicGeometry.Scheme.Spec.map_injective
              ((AlgebraicGeometry.Scheme.Spec.map_comp _ _).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Scheme.Spec.map g.left))
                  (AlgebraicGeometry.Scheme.Spec.map_preimage U₂.hom)).trans
                  (g.w.trans (AlgebraicGeometry.Scheme.Spec.map_preimage U₁.hom).symm)))
          exact congrArg (fun k => k.unop.hom r) hpre }
    let ψ_g : TensorProduct E₁ E₂ ↑U₂.left.unop →ₐ[E₂] TensorProduct E₁ E₂ ↑U₁.left.unop :=
      Algebra.TensorProduct.map (AlgHom.id E₂ E₂) φ_g
    CategoryTheory.MorphismProperty.CostructuredArrow.homMk
      (Opposite.op (CommRingCat.ofHom ψ_g.toRingHom)) trivial
      ((AlgebraicGeometry.Scheme.Spec.map_comp _ _).symm.trans
        (congrArg AlgebraicGeometry.Spec.map
          (CommRingCat.hom_ext ψ_g.comp_algebraMap)))
  map_id U := by
    refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
    apply Opposite.unop_injective
    apply CommRingCat.hom_ext
    letI : Algebra E₁ ↑U.left.unop := weilC1AffEtAlg E₁ U
    apply RingHom.ext
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact (RingHom.map_zero _).trans (RingHom.map_zero _).symm
    | tmul x y => rfl
    | add x y ihx ihy =>
      exact (RingHom.map_add _ x y).trans ((congrArg₂ (· + ·) ihx ihy).trans
        (RingHom.map_add _ x y).symm)
  map_comp {U₁ U₂ U₃} f g := by
    refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
    apply Opposite.unop_injective
    apply CommRingCat.hom_ext
    letI : Algebra E₁ ↑U₁.left.unop := weilC1AffEtAlg E₁ U₁
    letI : Algebra E₁ ↑U₂.left.unop := weilC1AffEtAlg E₁ U₂
    letI : Algebra E₁ ↑U₃.left.unop := weilC1AffEtAlg E₁ U₃
    apply RingHom.ext
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact (RingHom.map_zero _).trans (RingHom.map_zero _).symm
    | tmul x y => rfl
    | add x y ihx ihy =>
      exact (RingHom.map_add _ x y).trans ((congrArg₂ (· + ·) ihx ihy).trans
        (RingHom.map_add _ x y).symm)
noncomputable def weilTopDegKummerHigherDirectImageMap {X S : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom X S) (q : ℕ)
    {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
    (φ : Quiver.Hom F₁ F₂) :
    Quiver.Hom (weilEtaleHigherDirectImage f q F₁) (weilEtaleHigherDirectImage f q F₂) :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor S.Etale X.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
  (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map
    (CategoryTheory.Functor.whiskerLeft B.op
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).map φ))

def WeilTopDegKummerPolyP1CoordPkg (k : Type u) [Field k]
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (ι_aff : ∀ δ : ℕ,
      Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left) : Prop :=
  AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom ∧
  AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k 1).left ∧
  IsProjectiveOverField k (weilProjectiveSpaceOver k 1) ∧
  AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver k 1).hom ∧
  AlgebraicGeometry.IsOpenImmersion ι_P1 ∧
  CategoryTheory.CategoryStruct.comp ι_P1 (weilProjectiveSpaceOver k 1).hom =
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) ∧
  (∃ s_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
      (weilProjectiveSpaceOver k 1).left,
    CategoryTheory.CategoryStruct.comp s_inf (weilProjectiveSpaceOver k 1).hom =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
    Disjoint (Set.range ι_P1.base) (Set.range s_inf.base) ∧
    Set.range ι_P1.base ∪ Set.range s_inf.base = Set.univ) ∧
  ι_aff 0 = (weilAffineSpaceOver k 0).hom ∧
  (∀ δ : ℕ,
    AlgebraicGeometry.IsProper (weilPolyP1Over k δ).hom ∧
    AlgebraicGeometry.IsIntegral (weilPolyP1Over k δ).left ∧
    AlgebraicGeometry.SmoothOfRelativeDimension δ (weilPolyP1Over k δ).hom ∧
    AlgebraicGeometry.IsOpenImmersion (ι_aff δ) ∧
    CategoryTheory.CategoryStruct.comp (ι_aff δ) (weilPolyP1Over k δ).hom =
      (weilAffineSpaceOver k δ).hom ∧
    CategoryTheory.CategoryStruct.comp (ι_aff (δ + 1))
      (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
        (weilProjectiveSpaceOver k 1).hom) =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (MvPolynomial.rename Fin.castSucc :
            MvPolynomial (Fin δ) k →ₐ[k] MvPolynomial (Fin (δ + 1)) k).toRingHom))
        (ι_aff δ) ∧
    CategoryTheory.CategoryStruct.comp (ι_aff (δ + 1))
      (CategoryTheory.Limits.pullback.snd (weilPolyP1Over k δ).hom
        (weilProjectiveSpaceOver k 1).hom) =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Polynomial.aeval
            (MvPolynomial.X (Fin.last δ) : MvPolynomial (Fin (δ + 1)) k)).toRingHom))
        ι_P1)

def WeilTopDegKummerPolyP1TracePkg (k : Type u) [Field k] (n : ℕ) (ζ : kˣ)
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (tr_P1 : weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left n 2 →+ ZMod n)
    (tr_Pd : ∀ δ : ℕ,
      weilEtaleTorsionH (weilPolyP1Over k δ).left n (2 * δ) →+ ZMod n) : Prop :=
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let Pd := fun δ : ℕ => (weilPolyP1Over k δ).left
  let π_fst := fun δ : ℕ => CategoryTheory.Limits.pullback.fst
    (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom
  let π_snd := fun δ : ℕ => CategoryTheory.Limits.pullback.snd
    (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let z_to_n := AddCommGrpCat.ofHom
    ({ toFun := fun z : ULift.{u} ℤ => ULift.up ((z.down : ℤ) : ZMod n)
       map_zero' := congrArg ULift.up Int.cast_zero
       map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) })
  Function.Bijective tr_P1 ∧
  (∀ δ : ℕ, Function.Bijective (tr_Pd δ)) ∧
  (∀ (δ : ℕ)
      (F : CategoryTheory.Sheaf (Pd δ).smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
    n • CategoryTheory.CategoryStruct.id F = 0 →
    2 * δ < q →
    Subsingleton (F.H q)) ∧
  tr_Pd 0 (CategoryTheory.Abelian.Ext.mk₀
    ((CategoryTheory.constantSheaf S_k.smallEtaleTopology AddCommGrpCat.{u}).map z_to_n)) = 1 ∧
  (∀ (P₁_ov : CategoryTheory.Over S_k),
    P₁_ov = weilProjectiveSpaceOver k 1 →
    ∀ (ι_1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) P₁_ov.left)
      (tr_1 : weilEtaleTorsionH P₁_ov.left n 2 →+ ZMod n),
      HEq ι_1 ι_P1 →
      HEq tr_1 tr_P1 →
      ∀ (hInt1 : AlgebraicGeometry.IsIntegral P₁_ov.left)
        (s_inf : Quiver.Hom S_k P₁_ov.left),
        letI : AlgebraicGeometry.IsIntegral P₁_ov.left := hInt1
        CategoryTheory.CategoryStruct.comp s_inf P₁_ov.hom =
          CategoryTheory.CategoryStruct.id S_k →
        Disjoint (Set.range ι_1.base) (Set.range s_inf.base) →
        ∃ (ι_kum : Quiver.Hom (weilEtaleTorsionSheaf P₁_ov.left n) (weilEtaleGmSheaf P₁_ov.left))
          (p_kum : Quiver.Hom (weilEtaleGmSheaf P₁_ov.left) (weilEtaleGmSheaf P₁_ov.left))
          (h0_kum : CategoryTheory.CategoryStruct.comp ι_kum p_kum = 0)
          (hEx_kum : (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).ShortExact)
          (T_P1 : P₁_ov.left.Etale) (hT_P1 : CategoryTheory.Limits.IsTerminal T_P1)
          (Div_sh : CategoryTheory.Sheaf P₁_ov.left.smallEtaleTopology AddCommGrpCat.{u})
          (ι_gm : Quiver.Hom (weilEtaleGmSheaf P₁_ov.left) (weilEtaleKSheaf P₁_ov.left))
          (div_mor : Quiver.Hom (weilEtaleKSheaf P₁_ov.left) Div_sh)
          (h0_div : CategoryTheory.CategoryStruct.comp ι_gm div_mor = 0)
          (hEx_div : (CategoryTheory.ShortComplex.mk ι_gm div_mor h0_div).ShortExact)
          (valDiv : ∀ U : P₁_ov.left.Etale,
            ↥(Div_sh.obj.obj (Opposite.op U)) →+
              ({ y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥P₁_ov.left) } → ℤ))
          (pt₀ : ↥S_k) (_hClosed_inf : IsClosed ({s_inf.base pt₀} : Set ↥P₁_ov.left)),
          let T_id : P₁_ov.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
            (CategoryTheory.CategoryStruct.id P₁_ov.left)
            (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id P₁_ov.left))
          let η_K := (CategoryTheory.sheafificationAdjunction P₁_ov.left.smallEtaleTopology
            AddCommGrpCat.{u}).unit.app (weilEtaleKPresheaf P₁_ov.left)
          p_kum = n • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf P₁_ov.left) ∧
          (∀ a : ZMod n,
            let adj_P1 := CategoryTheory.constantSheafAdj P₁_ov.left.smallEtaleTopology
              AddCommGrpCat.{u} hT_P1
            let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
            let u_sec := (CategoryTheory.CategoryStruct.comp
              (adj_P1.unit.app AM)
              (ι_kum.hom.app (Opposite.op T_P1))) (ULift.up a)
            let η_gm := (CategoryTheory.sheafificationAdjunction P₁_ov.left.smallEtaleTopology
              AddCommGrpCat.{u}).unit.app (weilEtaleGmPresheaf P₁_ov.left)
            ∃ u_pre : ↑((weilEtaleGmPresheaf P₁_ov.left).obj (Opposite.op T_P1)),
              (η_gm.app (Opposite.op T_P1)) u_pre = u_sec ∧
              ((Additive.toMul u_pre : Units _) :
                ↑(((AlgebraicGeometry.Scheme.Etale.forget P₁_ov.left).obj T_P1).left.presheaf.obj
                  (Opposite.op ⊤))) =
                (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
                  (AlgebraicGeometry.Scheme.Hom.appTop
                    (CategoryTheory.CategoryStruct.comp
                      ((AlgebraicGeometry.Scheme.Etale.forget P₁_ov.left).obj T_P1).hom
                      P₁_ov.hom))) ((ζ : kˣ) : k)) ^ a.val) ∧
          (∀ U : P₁_ov.left.Etale,
            Function.Injective (valDiv U) ∧
            Set.range (valDiv U) =
              { D | ∀ u : ↥U.left, ∃ V : U.left.Opens, u ∈ V ∧
                { y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥P₁_ov.left) } |
                  y.1 ∈ V ∧ D y ≠ 0 }.Finite } ∧
            (CompactSpace ↥U.left → Set.range (valDiv U) = { D | { y | D y ≠ 0 }.Finite })) ∧
          (∀ {U₁ U₂ : P₁_ov.left.Etale} (g : Quiver.Hom U₁ U₂)
              (d : ↥(Div_sh.obj.obj (Opposite.op U₂)))
              (y₁ : { y : ↥U₁.left // IsClosed ({U₁.hom.base y} : Set ↥P₁_ov.left) }),
            valDiv U₁ ((Div_sh.obj.map (Opposite.op g)).hom d) y₁ =
              valDiv U₂ d ⟨g.left.base y₁.1,
                Eq.mp (congrArg (fun z : ↥P₁_ov.left => IsClosed ({z} : Set ↥P₁_ov.left))
                  ((congrArg (fun h : Quiver.Hom U₁.left P₁_ov.left => h.base y₁.1)
                    (CategoryTheory.MorphismProperty.Over.w g)).symm.trans
                    (AlgebraicGeometry.Scheme.Hom.comp_apply g.left U₂.hom y₁.1))) y₁.2⟩) ∧
          (∀ f : Units ↑P₁_ov.left.functionField,
            ∃ s : ↥((weilEtaleKPresheaf P₁_ov.left).obj (Opposite.op T_id)),
              ∀ x : { x : ↥P₁_ov.left // IsClosed ({x} : Set ↥P₁_ov.left) },
                let Rx := ↑(P₁_ov.left.presheaf.stalk x.1)
                let mx := IsLocalRing.maximalIdeal Rx
                ∃ (a b : Rx) (na nb : ℕ),
                  a ≠ 0 ∧ b ≠ 0 ∧
                  algebraMap Rx ↑P₁_ov.left.functionField a =
                    (f : ↑P₁_ov.left.functionField) * algebraMap Rx ↑P₁_ov.left.functionField b ∧
                  Ideal.span ({a} : Set Rx) = mx ^ na ∧
                  Ideal.span ({b} : Set Rx) = mx ^ nb ∧
                  valDiv T_id
                    ((div_mor.hom.app (Opposite.op T_id)).hom
                      ((η_K.app (Opposite.op T_id)).hom s))
                    ⟨x.1, x.2⟩ = (na : ℤ) - (nb : ℤ)) ∧
          (∀ (hT_id : CategoryTheory.Limits.IsTerminal T_id)
              (d₀ : CategoryTheory.Abelian.Ext
                ((CategoryTheory.constantSheaf P₁_ov.left.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
                Div_sh 0)
              (D : { x : ↥P₁_ov.left // IsClosed ({x} : Set ↥P₁_ov.left) } →₀ ℤ),
