                LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget P_ov.left).obj U).left (ULift.{u} (ZMod n)) →
                  ↑(((AlgebraicGeometry.Scheme.Etale.forget P_ov.left).obj U).left.presheaf.obj (Opposite.op ⊤)))
