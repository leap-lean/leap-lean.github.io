      CategoryTheory.CategoryStruct.comp ιℤ_g (weilEtaleConstPullbackHom g hT_W hT_Y Aℤ) =
        CategoryTheory.CategoryStruct.id Fℤ_W →
      CategoryTheory.CategoryStruct.comp (weilEtaleConstPullbackHom g hT_W hT_Y Aℤ) ιℤ_g =
        CategoryTheory.CategoryStruct.id (pb_g.obj Fℤ_Y) →
      ∀ (G : CategoryTheory.Sheaf W_top.smallEtaleTopology AddCommGrpCat.{u})
        (hG_tor : (ℓ ^ r) • CategoryTheory.CategoryStruct.id G = 0)
        (hpf_tor : (ℓ ^ r) • CategoryTheory.CategoryStruct.id (pf_g.obj G) = 0)
        (hG_acyc : ∀ q : ℕ, 1 ≤ q → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g q G))
        (hz_gf : ∀ b : ℕ, 3 ≤ b →
