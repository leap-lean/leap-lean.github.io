    (B_s : Type u) [CommRing B_s]
    (φ_s : Localization.Away q →+* B_s)
    (j_s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B_s)) C_s)
    (c : ℕ) (e : Fin c → ℕ)
    (C_norm : Fin c → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (h_comp : ∀ i : Fin c, Quiver.Hom (C_norm i).left C_s)
    (d_rk : Fin c → ℕ) : Prop :=
  let B₀ := Localization.Away q
  letI : Algebra B₀ B_s := φ_s.toAlgebra
  (∀ i : Fin c,
    1 ≤ d_rk i ∧
    WeilTopDegFiniteLocallyFreeOfRank (d_rk i)
      (CategoryTheory.CategoryStruct.comp (h_comp i) g_s)) ∧
  ∃ (B_norm : Fin c → Type u)
    (hRingB : ∀ i : Fin c, CommRing (B_norm i)),
    letI : ∀ i : Fin c, CommRing (B_norm i) := hRingB
    ∃ (hAlgB : ∀ i : Fin c, Algebra B₀ (B_norm i)),
      letI : ∀ i : Fin c, Algebra B₀ (B_norm i) := hAlgB
      ∃ (ψ_comp : ∀ i : Fin c, B_s →ₐ[B₀] B_norm i)
        (j_norm : ∀ i : Fin c,
          Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (B_norm i))) (C_norm i).left),
        (∀ i : Fin c,
          AlgebraicGeometry.IsOpenImmersion (j_norm i) ∧
          CategoryTheory.CategoryStruct.comp (j_norm i) (h_comp i) =
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_comp i).toRingHom)) j_s ∧
          CategoryTheory.CategoryStruct.comp (j_norm i)
              (CategoryTheory.CategoryStruct.comp (h_comp i) g_s) =
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ (B_norm i))))
              (CategoryTheory.CategoryStruct.comp iso_U.inv U_s.ι) ∧
          Set.range (j_norm i).base =
            (CategoryTheory.CategoryStruct.comp (h_comp i) g_s).base ⁻¹' (U_s : Set ↥P₁_ov.left) ∧
          Nonempty (Module.Basis (Fin (d_rk i)) B₀ (B_norm i))) ∧
        (∀ (R : Type u) [CommRing R] [Algebra B₀ R] [Module.Flat B₀ R]
           (z : TensorProduct B₀ R B_s),
          Algebra.norm R z =
            Finset.univ.prod fun i : Fin c =>
              (Algebra.norm R (Algebra.TensorProduct.map (AlgHom.id R R) (ψ_comp i) z)) ^ (e i))

