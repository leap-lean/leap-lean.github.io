noncomputable def weilCochainShift1X {𝒞 : Type (u + 1)}
    [CategoryTheory.Category.{u + 1, u + 1} 𝒞] [CategoryTheory.Abelian 𝒞]
    (Z₀ : 𝒞) (A : CochainComplex 𝒞 ℕ) : ℕ → 𝒞
  | 0 => Z₀
  | p + 1 => A.X p

noncomputable def weilCochainShift1d {𝒞 : Type (u + 1)}
    [CategoryTheory.Category.{u + 1, u + 1} 𝒞] [CategoryTheory.Abelian 𝒞]
    (Z₀ : 𝒞) (A : CochainComplex 𝒞 ℕ) :
    ∀ p : ℕ, weilCochainShift1X Z₀ A p ⟶ weilCochainShift1X Z₀ A (p + 1)
  | 0 => 0
  | p + 1 => A.d p (p + 1)

noncomputable def weilCochainShift1 {𝒞 : Type (u + 1)}
    [CategoryTheory.Category.{u + 1, u + 1} 𝒞] [CategoryTheory.Abelian 𝒞]
    (Z₀ : 𝒞) (A : CochainComplex 𝒞 ℕ) : CochainComplex 𝒞 ℕ :=
  CochainComplex.of (weilCochainShift1X Z₀ A) (weilCochainShift1d Z₀ A) fun p => by
    cases p with
    | zero => exact CategoryTheory.Limits.zero_comp
    | succ r => exact A.d_comp_d r (r + 1) (r + 2)

noncomputable def weilCochainBiprodRec {𝒞 : Type (u + 1)}
