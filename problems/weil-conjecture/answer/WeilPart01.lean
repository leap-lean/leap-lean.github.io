noncomputable def weilGysinAxisRecollCanUnit
    {C₁ : Type u₁} [CategoryTheory.Category.{v₁, u₁} C₁]
    {C₂ : Type u₂} [CategoryTheory.Category.{v₂, u₂} C₂]
    (J₁ : CategoryTheory.GrothendieckTopology C₁)
    (J₂ : CategoryTheory.GrothendieckTopology C₂)
    (R : Type u) [CommRing R]
    [CategoryTheory.HasWeakSheafify J₁ (ModuleCat.{u, u} R)]
    [CategoryTheory.HasWeakSheafify J₂ (ModuleCat.{u, u} R)]
    (F : CategoryTheory.Functor C₁ C₂) [F.IsContinuous J₁ J₂] :
    Quiver.Hom
      ((CategoryTheory.constantSheaf J₁ (ModuleCat.{u, u} R)).obj (ModuleCat.of R R))
      ((F.sheafPushforwardContinuous (ModuleCat.{u, u} R) J₁ J₂).obj
        ((CategoryTheory.constantSheaf J₂ (ModuleCat.{u, u} R)).obj (ModuleCat.of R R))) :=
  let ModR := ModuleCat.{u, u} R
  let R_mod := ModuleCat.of R R
  ((CategoryTheory.sheafificationAdjunction J₁ ModR).homEquiv
    ((CategoryTheory.Functor.const (Opposite C₁)).obj R_mod)
    ((F.sheafPushforwardContinuous ModR J₁ J₂).obj
      ((CategoryTheory.constantSheaf J₂ ModR).obj R_mod))).symm
    (CategoryTheory.Functor.whiskerLeft F.op
      ((CategoryTheory.sheafificationAdjunction J₂ ModR).unit.app
        ((CategoryTheory.Functor.const (Opposite C₂)).obj R_mod)))
noncomputable def weilProjPlaneShiftedCoordVec (k : Type u) [Field k]
    (β : Fin 3) (w : Fin 3 → k) : Fin 3 → MvPolynomial (Fin 2) k :=
  Fin.succAboveCases β 1 (fun j => MvPolynomial.X j + MvPolynomial.C (w (β.succAbove j) / w β))

structure WeilPointed2dOdpChartData (k : Type u) [Field k] (m : ℕ)
    (Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (g₂ : Y₂ ⟶ weilProjectiveSpaceOver k 2)
    (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_disc : C_disc ⟶ weilProjectiveSpaceOver k 2)
    (P_disc : MvPolynomial (Fin 3) k)
    (c₀ : C_disc.left)
    (β : Fin 3) (w : Fin 3 → k) : Type (u + 1) where
  j_P : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶
    (weilProjectiveSpaceOver k 2).left
  y_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Y₂.left
  R'_2 : CommRingCat.{u}
  B'_2 : CommRingCat.{u}
  φ_2 : MvPolynomial (Fin 2) k →+* R'_2
  u_2 : AlgebraicGeometry.Spec R'_2
  v_2 : AlgebraicGeometry.Spec B'_2
  e_B2 : AlgebraicGeometry.Spec R'_2 ⟶ (weilProjectiveSpaceOver k 2).left
  h_2 : R'_2
  ψ_B2 : MvPolynomial (Fin 2) k →+* R'_2
  e_Y2 : AlgebraicGeometry.Spec B'_2 ⟶ Y₂.left
  q_2 : AlgebraicGeometry.Spec B'_2 ⟶
    AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin (m + 1) × Fin 2) R'_2 ⧸ Ideal.span
        {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
          MvPolynomial.C h_2}))
  hj_range : Set.range j_P.base =
    (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
      MvPolynomial.gradedAlgebra
    (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 3) k)
      (MvPolynomial.X β)).1)
  hj_hom : j_P ≫ (weilProjectiveSpaceOver k 2).hom =
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)
  hj_coord :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
      MvPolynomial.gradedAlgebra
    ∀ (h_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k))).Opens) ≤
        (TopologicalSpace.Opens.map j_P.base).obj
          (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 3) k)
            (MvPolynomial.X β)))
      (r : Fin 3),
      ((AlgebraicGeometry.Proj.basicOpenIsoAway (MvPolynomial.homogeneousSubmodule (Fin 3) k)
          (MvPolynomial.X β) (MvPolynomial.isHomogeneous_X k β) zero_lt_one).hom ≫
        j_P.appLE
          (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 3) k)
            (MvPolynomial.X β)) ⊤ h_le ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin 2) k))).hom).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X r, MvPolynomial.isHomogeneous_X k r⟩,
            ⟨MvPolynomial.X β, MvPolynomial.isHomogeneous_X k β⟩, ⟨1, pow_one _⟩⟩) =
        weilProjPlaneShiftedCoordVec k β w r
  he_B2_def : e_B2 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_2) ≫ j_P
  hy_hom : y_pt ≫ Y₂.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))
  hy_g₂ : y_pt ≫ g₂.left =
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 2 → k))) ≫ j_P
  he_B2_et : AlgebraicGeometry.Etale e_B2
  he_Y2_et : AlgebraicGeometry.Etale e_Y2
  hq_2_et : AlgebraicGeometry.Etale q_2
  hψ_X0 : ψ_B2 (MvPolynomial.X 0) = h_2
  hψ_X1_lead0 :
    MvPolynomial.eval (0 : Fin 2 → k)
      (MvPolynomial.pderiv (0 : Fin 2)
        (MvPolynomial.eval₂Hom MvPolynomial.C (weilProjPlaneShiftedCoordVec k β w) P_disc)) ≠ 0 →
    ψ_B2 (MvPolynomial.X 1) = φ_2 (MvPolynomial.X 1)
  hSpec_ψ_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B2))
  he_B2_hom : e_B2 ≫ (weilProjectiveSpaceOver k 2).hom =
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B2) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)
  he_B2_disc : e_B2.base ⁻¹' (Set.range ι_disc.left.base) =
    { u : AlgebraicGeometry.Spec R'_2 | h_2 ∈ u.asIdeal }
  hComm_2 : e_Y2 ≫ g₂.left =
    q_2 ≫ AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_B2
  hu_2_h : h_2 ∈ u_2.asIdeal
  hu_2_X : ∀ b : Fin 2, φ_2 (MvPolynomial.X b) ∈ u_2.asIdeal
  hv_2_X : ∀ idx : Fin (m + 1) × Fin 2,
    Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q_2.base v_2).asIdeal
  hv_2_C : Ideal.Quotient.mk _ (MvPolynomial.C h_2) ∈ (q_2.base v_2).asIdeal
  hPt_u2_v2 : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k),
    e_B2.base u_2 =
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 2 → k))) ≫ j_P).base pt ∧
    e_Y2.base v_2 = y_pt.base pt
  hu_2_eq : e_B2.base u_2 = ι_disc.left.base c₀
  hUniv_u : ∀ u : AlgebraicGeometry.Spec R'_2,
    h_2 ∈ u.asIdeal →
    ∃ v : AlgebraicGeometry.Spec B'_2,
      (q_2 ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))).base v = u ∧
      (∀ idx : Fin (m + 1) × Fin 2,
        Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q_2.base v).asIdeal) ∧
      Ideal.Quotient.mk _ (MvPolynomial.C h_2) ∈ (q_2.base v).asIdeal ∧
      (u = u_2 → e_Y2.base v = e_Y2.base v_2) ∧
      ∀ y' : Y₂.left,
        g₂.left.base y' = e_B2.base u →
        y' ≠ e_Y2.base v →
        ∃ V : Y₂.left.Opens, y' ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ g₂.left)
def WeilTransvTriIsSingularDatum (F : Type u) [Field F] (m : ℕ)
    (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (P : WeilRationalLefschetzPencil F m Z₁)
    (j_aff : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)))
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F))
      (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ι_disc : Quiver.Hom C_disc (weilProjectiveSpaceOver F 2))
    (U_disc_reg : C_disc.left.Opens) : Prop :=
  AlgebraicGeometry.IsOpenImmersion j_aff ∧
  CategoryTheory.CategoryStruct.comp j_aff (weilProjectiveSpaceOver F 1).hom =
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
  CategoryTheory.CategoryStruct.comp s_inf (weilProjectiveSpaceOver F 1).hom =
    CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of F)) ∧
  (Set.range j_aff.base)ᶜ = Set.range s_inf.base ∧
  (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
    j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
      ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal } ∧
  Set.range P.u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left) ∧
  AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (P.f₀.left ∣_ U₀) ∧
  AlgebraicGeometry.GeometricallyIrreducible C_disc.hom ∧
  AlgebraicGeometry.IsProper C_disc.hom ∧
  AlgebraicGeometry.IsClosedImmersion ι_disc.left ∧
  Nonempty U_disc_reg ∧
  AlgebraicGeometry.SmoothOfRelativeDimension 1
    (CategoryTheory.CategoryStruct.comp U_disc_reg.ι C_disc.hom) ∧
  (∃ U₂_sm : (weilProjectiveSpaceOver F 2).left.Opens,
    (U₂_sm : Set (weilProjectiveSpaceOver F 2).left) = (Set.range ι_disc.left.base)ᶜ ∧
    AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (P.g₂.left ∣_ U₂_sm)) ∧
  P.ι_line.left.base ⁻¹' (Set.range ι_disc.left.base) =
    (U₀ : Set (weilProjectiveSpaceOver F 1).left)ᶜ ∧
  P.ι_line.left.base '' ((U₀ : Set (weilProjectiveSpaceOver F 1).left)ᶜ) ⊆
    ι_disc.left.base '' (U_disc_reg : Set C_disc.left) ∧
  (∃ x_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F)) P.Z_tilde.left,
    CategoryTheory.CategoryStruct.comp x_inf P.f₀.left = s_inf ∧
    (∀ z : P.Z_tilde.left, P.f₀.left.base z ∈ Set.range s_inf.base →
      z ∉ Set.range x_inf.base →
        ∃ V : P.Z_tilde.left.Opens, z ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1)
            (CategoryTheory.CategoryStruct.comp V.ι P.f₀.left)) ∧
    ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
      IsEtaleSplitOdpPointOver m P.f₀ (x_inf.base pt) (s_inf.base pt)) ∧
  (∀ a ∈ S_aff,
    let s_a : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F))
        (weilProjectiveSpaceOver F 1).left :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))) j_aff
    ∃ x_a : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F)) P.Z_tilde.left,
      CategoryTheory.CategoryStruct.comp x_a P.f₀.left = s_a ∧
      (∀ z : P.Z_tilde.left, P.f₀.left.base z ∈ Set.range s_a.base →
        z ∉ Set.range x_a.base →
          ∃ V : P.Z_tilde.left.Opens, z ∈ V ∧
            AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1)
              (CategoryTheory.CategoryStruct.comp V.ι P.f₀.left)) ∧
      ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
        IsEtaleSplitOdpPointOver m P.f₀ (x_a.base pt) (s_a.base pt)) ∧
  (∀ c ∈ U_disc_reg, ∃ y_c : P.Y₂.left,
    P.g₂.left.base y_c = ι_disc.left.base c ∧
    (∀ y' : P.Y₂.left, P.g₂.left.base y' = ι_disc.left.base c → y' ≠ y_c →
      ∃ V : P.Y₂.left.Opens, y' ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1)
          (CategoryTheory.CategoryStruct.comp V.ι P.g₂.left)) ∧
    ∃ (R' : CommRingCat.{u}) (u_pt : AlgebraicGeometry.Spec R')
      (e_B : Quiver.Hom (AlgebraicGeometry.Spec R') (weilProjectiveSpaceOver F 2).left)
      (h : R') (V' : AlgebraicGeometry.Scheme.{u}) (v_pt : V')
      (e_Y : Quiver.Hom V' P.Y₂.left)
      (q : Quiver.Hom V' (AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin (m + 1) × Fin 2) R' ⧸ Ideal.span
          {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
            MvPolynomial.C h})))),
      AlgebraicGeometry.Etale e_B ∧
      AlgebraicGeometry.Etale e_Y ∧
      AlgebraicGeometry.Etale q ∧
      e_B.base u_pt = ι_disc.left.base c ∧
      e_Y.base v_pt = y_c ∧
      (∃ ψ_B : MvPolynomial (Fin 2) F →+* R',
        ψ_B (MvPolynomial.X 0) = h ∧
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B)) ∧
        CategoryTheory.CategoryStruct.comp e_B (weilProjectiveSpaceOver F 2).hom =
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))) ∧
      e_B.base ⁻¹' (Set.range ι_disc.left.base) =
        { u : AlgebraicGeometry.Spec R' | h ∈ u.asIdeal } ∧
      (∀ idx : Fin (m + 1) × Fin 2,
        Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q.base v_pt).asIdeal) ∧
      Ideal.Quotient.mk _ (MvPolynomial.C h) ∈ (q.base v_pt).asIdeal ∧
      CategoryTheory.CategoryStruct.comp e_Y P.g₂.left =
        CategoryTheory.CategoryStruct.comp q
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))
            e_B))

noncomputable def weilTransvTriClosedPointFiber (F : Type u) [Field F]
    {Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))}
    (f₀ : Quiver.Hom Z_tilde (weilProjectiveSpaceOver F 1))
    (j_aff : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)))
      (weilProjectiveSpaceOver F 1).left)
    (P_poly : Polynomial F) :
    CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AdjoinRoot P_poly))) :=
  CategoryTheory.Over.mk
    (CategoryTheory.Limits.pullback.snd f₀.left
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (AdjoinRoot.mk P_poly))) j_aff))

def WeilTransvTriIsGeomBaseSheafAction (F : Type u) [Finite F] [Field F]
    (Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ℱ₀ : CategoryTheory.Sheaf Y₀.left.smallEtaleTopology AddCommGrpCat.{u})
    (ℱ_bar : CategoryTheory.Sheaf (weilGeomScheme F Y₀).smallEtaleTopology AddCommGrpCat.{u})
    (hCont_pr :
      (weilEtaleSitePullback
        (CategoryTheory.Limits.pullback.fst Y₀.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))).IsContinuous
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology)
    (hAdj_pr :
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback
          (CategoryTheory.Limits.pullback.fst Y₀.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
        AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology hCont_pr).IsRightAdjoint)
    (iso_bar :
      CategoryTheory.Iso
        ((@CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback
            (CategoryTheory.Limits.pullback.fst Y₀.hom
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
          AddCommGrpCat.{u} _
          Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
          hCont_pr hAdj_pr).obj ℱ₀)
        ℱ_bar)
    (i : ℕ) (f_act : ℱ_bar.H i →+ ℱ_bar.H i) : Prop :=
  let S := weilGeomScheme F Y₀
  let f_ext := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
  let pr_Y : Quiver.Hom S Y₀.left := CategoryTheory.Limits.pullback.fst Y₀.hom f_ext
  let g_Y : Quiver.Hom S S := weilGeomFrobHom F Y₀
  let J₀ := Y₀.left.smallEtaleTopology
  let J := S.smallEtaleTopology
  let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  let Fℤ := C.obj (AddCommGrpCat.of (ULift.{u} ℤ))
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  let B_pr : CategoryTheory.Functor Y₀.left.Etale S.Etale := weilEtaleSitePullback pr_Y
  let adj_pr := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
    B_pr AddCommGrpCat.{u} _ J₀ J hCont_pr hAdj_pr
  ∃ (G : CategoryTheory.Functor S.Etale S.Etale),
    (∀ U : S.Etale, (Fgt.obj (G.obj U)).left = (Fgt.obj U).left ∧
      HEq (Fgt.obj (G.obj U)).hom (CategoryTheory.CategoryStruct.comp (Fgt.obj U).hom g_Y)) ∧
    (∀ {U₁ U₂ : S.Etale} (u : Quiver.Hom U₁ U₂),
      HEq (Fgt.map (G.map u)).left (Fgt.map u).left) ∧
    ∃ (hCont_G : G.IsContinuous J J),
      letI := hCont_G
      let P := G.sheafPushforwardContinuous AddCommGrpCat.{u} J J
      ∃ (hAdd_P : P.Additive) (hLim_P : CategoryTheory.Limits.PreservesFiniteLimits P)
        (hColim_P : CategoryTheory.Limits.PreservesFiniteColimits P)
        (T : S.Etale) (hT : CategoryTheory.Limits.IsTerminal T) (μ : Quiver.Hom (G.obj T) T),
        (Fgt.obj T).left = S ∧
        HEq (Fgt.obj T).hom (CategoryTheory.CategoryStruct.id S) ∧
        HEq (Fgt.map μ).left g_Y ∧
        let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
        let αℤ : Quiver.Hom Fℤ (P.obj Fℤ) :=
          (adj.homEquiv (AddCommGrpCat.of (ULift.{u} ℤ)) (P.obj Fℤ)).symm
            (CategoryTheory.CategoryStruct.comp
              (adj.unit.app (AddCommGrpCat.of (ULift.{u} ℤ))) (Fℤ.obj.map (Opposite.op μ)))
        ∃ (ν : CategoryTheory.NatTrans (CategoryTheory.Functor.comp B_pr G) B_pr),
          (∀ W : Y₀.left.Etale,
            HEq (CategoryTheory.CategoryStruct.comp (Fgt.map (ν.app W)).left
              (CategoryTheory.Limits.pullback.fst
                ((AlgebraicGeometry.Scheme.Etale.forget Y₀.left).obj W).hom pr_Y))
              (CategoryTheory.Limits.pullback.fst
                ((AlgebraicGeometry.Scheme.Etale.forget Y₀.left).obj W).hom pr_Y) ∧
            HEq (CategoryTheory.CategoryStruct.comp (Fgt.map (ν.app W)).left
              (CategoryTheory.Limits.pullback.snd
                ((AlgebraicGeometry.Scheme.Etale.forget Y₀.left).obj W).hom pr_Y))
              (CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd
                  ((AlgebraicGeometry.Scheme.Etale.forget Y₀.left).obj W).hom pr_Y)
                g_Y)) ∧
          ∃ (α_bar : Quiver.Hom ℱ_bar (P.obj ℱ_bar))
            (β_bar : Quiver.Hom (P.obj ℱ_bar) ℱ_bar),
            CategoryTheory.CategoryStruct.comp α_bar β_bar =
              CategoryTheory.CategoryStruct.id ℱ_bar ∧
            CategoryTheory.CategoryStruct.comp β_bar α_bar =
              CategoryTheory.CategoryStruct.id (P.obj ℱ_bar) ∧
            (∀ W : Y₀.left.Etale,
              (adj_pr.homEquiv ℱ₀ (P.obj ℱ_bar)
                (CategoryTheory.CategoryStruct.comp iso_bar.hom α_bar)).hom.app (Opposite.op W) =
              CategoryTheory.CategoryStruct.comp
                ((adj_pr.homEquiv ℱ₀ ℱ_bar iso_bar.hom).hom.app (Opposite.op W))
                (ℱ_bar.obj.map (Opposite.op (ν.app W)))) ∧
            ∀ x : ℱ_bar.H i,
              f_act x = (CategoryTheory.Abelian.Ext.mk₀ β_bar).postcomp Fℤ (Nat.add_zero i)
                ((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
                  ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P
                    hAdd_P hLim_P hColim_P _ _ Fℤ ℱ_bar i) x)
                  (Nat.zero_add i))

structure WeilTransvTriSheafCohomologyModel (F : Type u) [Finite F] [Field F]
    (Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i : ℕ)
    (ℳ₀ : ℕ → CategoryTheory.Sheaf Y₀.left.smallEtaleTopology AddCommGrpCat.{u})
    (τ₀ : ∀ r : ℕ, Quiver.Hom (ℳ₀ (r + 1)) (ℳ₀ r)) where
  hCont_pr :
    (weilEtaleSitePullback
      (CategoryTheory.Limits.pullback.fst Y₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))).IsContinuous
      Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
  hAdj_pr :
    (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback
        (CategoryTheory.Limits.pullback.fst Y₀.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
      AddCommGrpCat.{u} _
      Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology hCont_pr).IsRightAdjoint
  ℳ_bar : ℕ → CategoryTheory.Sheaf (weilGeomScheme F Y₀).smallEtaleTopology AddCommGrpCat.{u}
  τ_bar : ∀ r : ℕ, Quiver.Hom (ℳ_bar (r + 1)) (ℳ_bar r)
  iso_bar : ∀ r : ℕ,
    CategoryTheory.Iso
      ((@CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback
          (CategoryTheory.Limits.pullback.fst Y₀.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
        AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
        hCont_pr hAdj_pr).obj (ℳ₀ r))
      (ℳ_bar r)
  hτ_bar : ∀ r : ℕ,
    CategoryTheory.CategoryStruct.comp
      ((@CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback
          (CategoryTheory.Limits.pullback.fst Y₀.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
        AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
        hCont_pr hAdj_pr).map (τ₀ r))
      (iso_bar r).hom =
    CategoryTheory.CategoryStruct.comp (iso_bar (r + 1)).hom (τ_bar r)
  frobTorsion : ∀ r : ℕ, (ℳ_bar r).H i →+ (ℳ_bar r).H i
  hfrobTorsion : ∀ r : ℕ,
    WeilTransvTriIsGeomBaseSheafAction F Y₀ (ℳ₀ r) (ℳ_bar r) hCont_pr hAdj_pr (iso_bar r) i
      (frobTorsion r)
  V : Type u
  [addCommGroup : AddCommGroup V]
  [module : Module (Padic ℓ) V]
  [finite : Module.Finite (Padic ℓ) V]
  frob : V →ₗ[Padic ℓ] V
  sysSubgroup : AddSubgroup (∀ r : ℕ, (ℳ_bar r).H i)
  hsys : ∀ x : (∀ r : ℕ, (ℳ_bar r).H i),
    x ∈ sysSubgroup ↔ ∀ r : ℕ,
      (CategoryTheory.Abelian.Ext.mk₀ (τ_bar r)).postcomp
        ((CategoryTheory.constantSheaf (weilGeomScheme F Y₀).smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero i) (x (r + 1)) = x r
  equiv : TensorProduct ℤ ℚ ↥sysSubgroup ≃+ V
  hsmul : ∀ (z : PadicInt ℓ) (x y : ↥sysSubgroup),
    (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
      equiv (TensorProduct.tmul ℤ (1 : ℚ) y) =
        (z : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x)
  hfrob : ∀ (x y : ↥sysSubgroup),
    (∀ r : ℕ, y.1 r = frobTorsion r (x.1 r)) →
      frob (equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) = equiv (TensorProduct.tmul ℤ (1 : ℚ) y)

