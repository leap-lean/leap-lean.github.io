def WeilIsPinnedKummerPowerTower (k : Type u) [CommRing k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ℓ : ℕ) (ζ : ℕ → kˣ) : Prop :=
