        (adj_W.homEquiv Aℤ (h_res.obj Fℤ_S)).symm
          (CategoryTheory.CategoryStruct.comp (adj_S.unit.app Aℤ)
            (Fℤ_S.obj.map (Opposite.op τ_Mh)))
