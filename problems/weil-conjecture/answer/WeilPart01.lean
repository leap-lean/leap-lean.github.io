def WeilCupPDHasTruncatedGodement (S : AlgebraicGeometry.Scheme.{u}) (d m : ℕ) : Prop :=
  let R := ULift.{u, 0} (ZMod m)
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  let oneR := weilCupPDModUnit S m
  let T_S : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
    (CategoryTheory.CategoryStruct.id S)
    (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))
  ∃ (𝒯 : ℕ → CategoryTheory.Functor 𝒞 𝒞)
    (η : CategoryTheory.NatTrans (CategoryTheory.Functor.id 𝒞) (𝒯 0))
    (diff : ∀ q : ℕ, CategoryTheory.NatTrans (𝒯 q) (𝒯 (q + 1))),
    (∀ q : ℕ, (𝒯 q).Additive) ∧
    (∀ q : ℕ, 2 * d < q → ∀ F : 𝒞, CategoryTheory.Limits.IsZero ((𝒯 q).obj F)) ∧
    (∀ F : 𝒞, CategoryTheory.Mono (η.app F)) ∧
    (∀ F : 𝒞, ∃ h₀ : CategoryTheory.CategoryStruct.comp (η.app F) ((diff 0).app F) = 0,
      (CategoryTheory.ShortComplex.mk (η.app F) ((diff 0).app F) h₀).Exact) ∧
    (∀ (q : ℕ) (F : 𝒞),
      ∃ hq : CategoryTheory.CategoryStruct.comp ((diff q).app F) ((diff (q + 1)).app F) = 0,
        (CategoryTheory.ShortComplex.mk ((diff q).app F) ((diff (q + 1)).app F) hq).Exact) ∧
    (∀ (q k : ℕ), 1 ≤ k → ∀ F : 𝒞,
      Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR ((𝒯 q).obj F) k)) ∧
    (∀ q : ℕ,
      let C_q : CategoryTheory.Functor 𝒞 (ModuleCat.{u, u} R) :=
        CategoryTheory.Functor.comp (𝒯 q)
          (CategoryTheory.Functor.comp (CategoryTheory.sheafToPresheaf J (ModuleCat.{u, u} R))
            ((CategoryTheory.evaluation (Opposite S.Etale) (ModuleCat.{u, u} R)).obj
              (Opposite.op T_S)))
      CategoryTheory.Limits.PreservesFiniteLimits C_q ∧
      CategoryTheory.Limits.PreservesFiniteColimits C_q ∧
      CategoryTheory.Limits.PreservesColimitsOfSize.{u, u} C_q)

def WeilCupPDHasLocalEffacement (S : AlgebraicGeometry.Scheme.{u}) (d m : ℕ)
    (τ : weilCupPDModH S m (2 * d) →+ ZMod m) : Prop :=
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  ∀ (x : ↥S),
    let κ := S.residueField x
    let Ω := AlgebraicClosure ↥κ
    let gx : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
        (S.fromSpecResidueField x)
    ∀ (U : S.Etale) (γ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (Fgt.obj U).left),
      CategoryTheory.CategoryStruct.comp γ (Fgt.obj U).hom = gx →
      ∃ (U' : S.Etale) (v : Quiver.Hom U' U)
        (γ' : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (Fgt.obj U').left),
        CategoryTheory.CategoryStruct.comp γ' (Fgt.obj U').hom = gx ∧
        CategoryTheory.CategoryStruct.comp γ' (Fgt.map v).left = γ ∧
        (∀ (q : ℕ), q < 2 * d → ∀ z : weilCupPDLocalModH S m U' q,
          z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalFreeMap S m v))
            (Nat.add_zero q) = 0) ∧
        Function.Bijective (fun z : weilCupPDLocalModH S m U' (2 * d) =>
          τ (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalCounit S m U'))
            (Nat.add_zero (2 * d))))
def IsGoodAffineCurveClosedPointPoly {F : Type u} [Field F] (S_aff : Finset F) (d : ℕ)
    (P : Polynomial F) : Prop :=
  P.Monic ∧ Irreducible P ∧ P.natDegree = d ∧ ∀ s ∈ S_aff, P.eval s ≠ 0

def IsEtaleSplitOdpPointOver {F : Type u} [Field F] (m : ℕ)
    {Y B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))}
    (g : Y ⟶ B) (y₀ : Y.left) (b₀ : B.left) : Prop :=
  g.left.base y₀ = b₀ ∧
  ∃ (R' : CommRingCat.{u}) (u₀ : AlgebraicGeometry.Spec R') (e_B : AlgebraicGeometry.Spec R' ⟶ B.left)
    (h : R') (V' : AlgebraicGeometry.Scheme.{u}) (v₀ : V') (e_Y : V' ⟶ Y.left)
    (q : V' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin (m + 1) × Fin 2) R' ⧸ Ideal.span
        {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
          MvPolynomial.C h}))),
    AlgebraicGeometry.Etale e_B ∧
    AlgebraicGeometry.Etale e_Y ∧
    AlgebraicGeometry.Etale q ∧
    e_B.base u₀ = b₀ ∧
    e_Y.base v₀ = y₀ ∧
    (∃ ψ_B : Polynomial F →+* R',
      ψ_B Polynomial.X = h ∧
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B)) ∧
      e_B ≫ B.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∧
    h ∈ u₀.asIdeal ∧
    (∀ idx : Fin (m + 1) × Fin 2,
      Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q.base v₀).asIdeal) ∧
    Ideal.Quotient.mk _ (MvPolynomial.C h) ∈ (q.base v₀).asIdeal ∧
    e_Y ≫ g.left =
      q ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_B

structure WeilRationalLefschetzPencil (F : Type u) [Field F] (m : ℕ)
    (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))) where
  B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))
  hProp_B₀ : AlgebraicGeometry.IsProper B₀.hom
  hSm_B₀ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) B₀.hom
  ι_B : B₀ ⟶ Z₁
  hCl_B : AlgebraicGeometry.IsClosedImmersion ι_B.left
  U_axis : Z₁.left.Opens
  hU_axis_eq : (U_axis : Set Z₁.left) = (Set.range ι_B.left.base)ᶜ
  hU_axis_ne : Nonempty U_axis
  Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))
  hGeom_Ztilde : AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom
  hProp_Ztilde : AlgebraicGeometry.IsProper Z_tilde.hom
  hSm_Ztilde : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom
  hProj_Ztilde : IsProjectiveOverField F Z_tilde
  π₀ : Z_tilde ⟶ Z₁
  hProp_π₀ : AlgebraicGeometry.IsProper π₀.left
  hSurj_π₀ : AlgebraicGeometry.Surjective π₀.left
  hIso_π₀ : CategoryTheory.IsIso (π₀.left ∣_ U_axis)
  f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1
  hFlat_f₀ : AlgebraicGeometry.Flat f₀.left
  hProp_f₀ : AlgebraicGeometry.IsProper f₀.left
  hSurj_f₀ : AlgebraicGeometry.Surjective f₀.left
  hFibIrred_f₀ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver F 1).left),
    IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left s)
  Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))
  hGeom_Y₂ : AlgebraicGeometry.GeometricallyIrreducible Y₂.hom
  hProp_Y₂ : AlgebraicGeometry.IsProper Y₂.hom
  hSm_Y₂ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 3) Y₂.hom
  g₂ : Y₂ ⟶ weilProjectiveSpaceOver F 2
  hFlat_g₂ : AlgebraicGeometry.Flat g₂.left
  hProp_g₂ : AlgebraicGeometry.IsProper g₂.left
  ι_line : weilProjectiveSpaceOver F 1 ⟶ weilProjectiveSpaceOver F 2
  hCl_line : AlgebraicGeometry.IsClosedImmersion ι_line.left
  ι_Ytilde : Z_tilde ⟶ Y₂
  hPb_line : CategoryTheory.IsPullback ι_Ytilde.left f₀.left g₂.left ι_line.left
  u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left
  hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F))
  Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))
  hGeom_Zu₀ : AlgebraicGeometry.GeometricallyIrreducible Z_u₀.hom
  hProp_Zu₀ : AlgebraicGeometry.IsProper Z_u₀.hom
  hSm_Zu₀ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_u₀.hom
  hProj_Zu₀ : IsProjectiveOverField F Z_u₀
  ι_Zu₀ : Z_u₀.left ⟶ Z_tilde.left
  hPb_Zu₀ : CategoryTheory.IsPullback ι_Zu₀ Z_u₀.hom f₀.left u₀
  H₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))
  hGeom_H₀ : AlgebraicGeometry.GeometricallyIrreducible H₀.hom
  hProp_H₀ : AlgebraicGeometry.IsProper H₀.hom
  hSm_H₀ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) H₀.hom
  hProj_H₀ : IsProjectiveOverField F H₀
  i_H : H₀ ⟶ Z_u₀
  hCl_H : AlgebraicGeometry.IsClosedImmersion i_H.left
  hAff_compl_H : 1 ≤ m → ∃ U_aff : Z_u₀.left.Opens,
    (U_aff : Set Z_u₀.left) = (Set.range i_H.left.base)ᶜ ∧
    AlgebraicGeometry.IsAffineOpen U_aff
  hSing_dichotomy :
    AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) f₀.left ∨
    ∃ (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
          (weilProjectiveSpaceOver F 1).left)
      (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
      (S_aff : Finset F)
      (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
      (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
      (ι_disc : C_disc ⟶ weilProjectiveSpaceOver F 2)
      (U_disc_reg : C_disc.left.Opens),
      AlgebraicGeometry.IsOpenImmersion j_aff ∧
      j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      s_inf ≫ (weilProjectiveSpaceOver F 1).hom = 𝟙 _ ∧
      (Set.range j_aff.base)ᶜ = Set.range s_inf.base ∧
      (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
        j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
          ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal } ∧
      Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (f₀.left ∣_ U₀) ∧
      AlgebraicGeometry.GeometricallyIrreducible C_disc.hom ∧
      AlgebraicGeometry.IsProper C_disc.hom ∧
      AlgebraicGeometry.IsClosedImmersion ι_disc.left ∧
      Nonempty U_disc_reg ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_disc_reg.ι ≫ C_disc.hom) ∧
      (∃ U₂_sm : (weilProjectiveSpaceOver F 2).left.Opens,
        (U₂_sm : Set (weilProjectiveSpaceOver F 2).left) = (Set.range ι_disc.left.base)ᶜ ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (g₂.left ∣_ U₂_sm)) ∧
      ι_line.left.base ⁻¹' (Set.range ι_disc.left.base) = (U₀ : Set _)ᶜ ∧
      ι_line.left.base '' ((U₀ : Set _)ᶜ) ⊆ ι_disc.left.base '' (U_disc_reg : Set C_disc.left) ∧
      (∃ x_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z_tilde.left,
        x_inf ≫ f₀.left = s_inf ∧
        (∀ z : Z_tilde.left, f₀.left.base z ∈ Set.range s_inf.base →
          z ∉ Set.range x_inf.base →
            ∃ V : Z_tilde.left.Opens, z ∈ V ∧
              AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left)) ∧
        ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
          IsEtaleSplitOdpPointOver m f₀ (x_inf.base pt) (s_inf.base pt)) ∧
      (∀ a ∈ S_aff,
        let s_a : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a)) ≫ j_aff
        ∃ x_a : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z_tilde.left,
          x_a ≫ f₀.left = s_a ∧
          (∀ z : Z_tilde.left, f₀.left.base z ∈ Set.range s_a.base →
            z ∉ Set.range x_a.base →
              ∃ V : Z_tilde.left.Opens, z ∈ V ∧
                AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left)) ∧
          ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
            IsEtaleSplitOdpPointOver m f₀ (x_a.base pt) (s_a.base pt)) ∧
      (∀ c ∈ U_disc_reg, ∃ y_c : Y₂.left,
        g₂.left.base y_c = ι_disc.left.base c ∧
        (∀ y' : Y₂.left, g₂.left.base y' = ι_disc.left.base c → y' ≠ y_c →
          ∃ V : Y₂.left.Opens, y' ∈ V ∧
            AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ g₂.left)) ∧
        ∃ (R' : CommRingCat.{u}) (u_pt : AlgebraicGeometry.Spec R')
          (e_B : AlgebraicGeometry.Spec R' ⟶ (weilProjectiveSpaceOver F 2).left)
          (h : R') (V' : AlgebraicGeometry.Scheme.{u}) (v_pt : V') (e_Y : V' ⟶ Y₂.left)
          (q : V' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin (m + 1) × Fin 2) R' ⧸ Ideal.span
              {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
                MvPolynomial.C h}))),
          AlgebraicGeometry.Etale e_B ∧
          AlgebraicGeometry.Etale e_Y ∧
          AlgebraicGeometry.Etale q ∧
          e_B.base u_pt = ι_disc.left.base c ∧
          e_Y.base v_pt = y_c ∧
          (∃ ψ_B : MvPolynomial (Fin 2) F →+* R',
            ψ_B (MvPolynomial.X 0) = h ∧
            AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B)) ∧
            e_B ≫ (weilProjectiveSpaceOver F 2).hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
          e_B.base ⁻¹' (Set.range ι_disc.left.base) =
            { u : AlgebraicGeometry.Spec R' | h ∈ u.asIdeal } ∧
          (∀ idx : Fin (m + 1) × Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q.base v_pt).asIdeal) ∧
          Ideal.Quotient.mk _ (MvPolynomial.C h) ∈ (q.base v_pt).asIdeal ∧
          e_Y ≫ g₂.left =
            q ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_B)

noncomputable def WeilSymplecticLinInvDual (ℓ M : ℕ) [Fact (Nat.Prime ℓ)]
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ)) :
    Submodule (Padic ℓ) ((Fin M → Padic ℓ) →ₗ[Padic ℓ] Padic ℓ) where
  carrier := { φ | ∀ g ∈ G_geom,
    φ.comp (((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin) = φ }
  add_mem' ha hb g hg := by rw [LinearMap.add_comp, ha g hg, hb g hg]
  zero_mem' _ _ := LinearMap.zero_comp _
  smul_mem' c _ ha g hg := by rw [LinearMap.smul_comp, ha g hg]

noncomputable def WeilSymplecticTensorInvDual (ℓ M k : ℕ) [Fact (Nat.Prime ℓ)]
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ)) :
    Submodule (Padic ℓ)
      (TensorPower (Padic ℓ) (2 * k) (Fin M → Padic ℓ) →ₗ[Padic ℓ] Padic ℓ) where
  carrier := { φ | ∀ g ∈ G_geom,
    φ.comp (PiTensorProduct.map (fun _ : Fin (2 * k) =>
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin)) = φ }
  add_mem' ha hb g hg := by rw [LinearMap.add_comp, ha g hg, hb g hg]
  zero_mem' _ _ := LinearMap.zero_comp _
  smul_mem' c _ ha g hg := by rw [LinearMap.smul_comp, ha g hg]

def WeilGaloisModEllPowCover.{u} (F : Type u) [Field F] (S_aff : Finset F)
    (ℓ M k : ℕ) [Fact (Nat.Prime ℓ)]
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
    (F_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin M) (Fin M) (PadicInt ℓ)) : Prop :=
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  ∃ (B_k L_k : Type u) (_ : CommRing B_k) (_ : IsDomain B_k) (_ : Field L_k)
    (_ : Algebra F B_k) (_ : Algebra (Polynomial F) B_k) (_ : Algebra R₀ B_k)
    (_ : Algebra F L_k) (_ : Algebra (Polynomial F) L_k) (_ : Algebra (RatFunc F) L_k)
    (_ : Algebra B_k L_k) (_ : Algebra R₀ L_k)
    (_ : IsScalarTower F (Polynomial F) B_k) (_ : IsScalarTower (Polynomial F) R₀ B_k)
    (_ : IsScalarTower F (RatFunc F) L_k) (_ : IsScalarTower (Polynomial F) (RatFunc F) L_k)
    (_ : IsScalarTower (Polynomial F) B_k L_k) (_ : IsScalarTower R₀ B_k L_k)
    (_ : Module.Finite R₀ B_k) (_ : Algebra.Etale R₀ B_k)
    (_ : IsFractionRing B_k L_k) (_ : IsIntegralClosure B_k R₀ L_k)
    (_ : FiniteDimensional (RatFunc F) L_k) (_ : IsGalois (RatFunc F) L_k)
    (ρ_k : (B_k ≃ₐ[R₀] B_k) →* (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ k)))ˣ),
    (∀ B ∈ G_geom,
      ∃ σ : B_k ≃ₐ[R₀] B_k,
        (∀ x : B_k, IsIntegral F x → σ x = x) ∧
        (ρ_k σ).val = (B.val).map (PadicInt.toZModPow k)) ∧
    (∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
      ∃ (Q : Ideal B_k), Q.IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) B_k) Q = Ideal.span {P} ∧
        ∃ σ : B_k ≃ₐ[R₀] B_k,
          (∀ b : B_k, σ.symm b - b ^ (Nat.card F ^ d) ∈ Q) ∧
          (ρ_k σ).val = (F_mat d P hP).map (PadicInt.toZModPow k))

def WeilAffineCurveSymplecticSystem.{u} (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F) (ℓ n : ℕ) [Fact (Nat.Prime ℓ)]
    (γ' : AlgebraicClosure (Padic ℓ)) : Prop :=
  γ' ≠ 0 ∧
  ∃ (M : ℕ) (_ : 1 ≤ M)
    (J : Matrix (Fin M) (Fin M) (Padic ℓ))
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
    (F_u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ)
    (F_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin M) (Fin M) (PadicInt ℓ)),
    J.transpose = -J ∧
    J.det ≠ 0 ∧
    (∀ g ∈ G_geom,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J) ∧
    (∀ W_sub : Submodule (AlgebraicClosure (Padic ℓ)) (Fin M → AlgebraicClosure (Padic ℓ)),
      (∀ g ∈ G_geom, ∀ w ∈ W_sub,
        ((g.val).map (algebraMap (PadicInt ℓ) (AlgebraicClosure (Padic ℓ)))).mulVec w ∈ W_sub) →
      W_sub = ⊥ ∨ W_sub = ⊤) ∧
    (∃ Δ : Set (Fin M → Padic ℓ),
      Δ.Nonempty ∧ (∀ v ∈ Δ, v ≠ 0) ∧
      (∀ g ∈ G_geom, ∀ v ∈ Δ,
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec v ∈ Δ) ∧
      (∀ v ∈ Δ, ∀ t : PadicInt ℓ,
        ∃ g ∈ G_geom,
          ∀ x : Fin M → Padic ℓ,
            ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
              x + ((t : Padic ℓ) * dotProduct x (J.mulVec v)) • v)) ∧
    (∀ g ∈ G_geom, F_u * g * F_u⁻¹ ∈ G_geom) ∧
    (((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
      ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) =
        ((Nat.card F : Padic ℓ) ^ n) • J) ∧
    (∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
      ((F_mat d P hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
        ((F_mat d P hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))) =
          ((Nat.card F : Padic ℓ) ^ (n * d)) • J) ∧
    (∀ k : ℕ, 1 ≤ k → WeilGaloisModEllPowCover.{u} F S_aff ℓ M k G_geom F_mat) ∧
    (∃ (α_num β_den : List (AlgebraicClosure (Padic ℓ))),
      (∀ α ∈ α_num, α ≠ 0) ∧ (∀ β ∈ β_den, β ≠ 0) ∧
      ∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
        1 ≤ d →
          ∃ A_Q B_Q : Polynomial ℚ,
            A_Q.coeff 0 = 1 ∧ B_Q.coeff 0 = 1 ∧
            (A_Q.map (algebraMap ℚ (AlgebraicClosure (Padic ℓ)))) *
              (β_den.map (fun β => 1 - Polynomial.C (β ^ d) * Polynomial.X)).prod =
            (B_Q.map (algebraMap ℚ (AlgebraicClosure (Padic ℓ)))) *
              (α_num.map (fun α => 1 - Polynomial.C (α ^ d) * Polynomial.X)).prod *
              (((F_mat d P hP).map
                (algebraMap (PadicInt ℓ) (AlgebraicClosure (Padic ℓ)))).charpolyRev)) ∧
    (∃ (V₁ : Type u) (_ : AddCommGroup V₁) (_ : Module (Padic ℓ) V₁)
        (_ : Module.Finite (Padic ℓ) V₁) (Φ₁ : V₁ →ₗ[Padic ℓ] V₁),
      γ' ∈ (Φ₁.charpoly).aroots (AlgebraicClosure (Padic ℓ)) ∧
      ((Nat.card F : AlgebraicClosure (Padic ℓ)) ^ (n + 1)) / γ' ∈
        (Φ₁.charpoly).aroots (AlgebraicClosure (Padic ℓ)) ∧
      ∀ (r : ℕ) (e : ∀ d : ℕ,
          Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }) ≃
            { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
        1 ≤ r →
          (WeilSymplecticLinInvDual ℓ M G_geom = ⊥ →
            ∑ d ∈ Nat.divisors r,
              ∑ j : Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
                (d : Padic ℓ) *
                  Matrix.trace (((F_mat d (e d j).1 (e d j).2).map
                    (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ (r / d)) =
              - LinearMap.trace (Padic ℓ) V₁ (Φ₁ ^ r))) ∧
    (∀ k : ℕ, 1 ≤ k →
      ∃ (V₂ₖ : Type u) (_ : AddCommGroup V₂ₖ) (_ : Module (Padic ℓ) V₂ₖ)
          (_ : Module.Finite (Padic ℓ) V₂ₖ) (Φ₂ₖ : V₂ₖ →ₗ[Padic ℓ] V₂ₖ),
        ∀ (r : ℕ) (e : ∀ d : ℕ,
            Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }) ≃
              { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
          1 ≤ r →
            ((∀ φ ∈ WeilSymplecticTensorInvDual ℓ M k G_geom,
                φ.comp (PiTensorProduct.map (fun _ : Fin (2 * k) =>
                  ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin)) =
                  ((Nat.card F : Padic ℓ) ^ (k * n)) • φ) →
              ∑ d ∈ Nat.divisors r,
                ∑ j : Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
                  (d : Padic ℓ) *
                    (Matrix.trace (((F_mat d (e d j).1 (e d j).2).map
                      (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ (r / d))) ^ (2 * k) =
                (Module.finrank (Padic ℓ) ↥(WeilSymplecticTensorInvDual ℓ M k G_geom) : Padic ℓ) *
                  ((Nat.card F : Padic ℓ) ^ (k * n + 1)) ^ r -
                  LinearMap.trace (Padic ℓ) V₂ₖ (Φ₂ₖ ^ r)))
def WeilIsEtaleExternalCupProduct.{u} (S₁ S₂ S_W : AlgebraicGeometry.Scheme.{u})
    (pr₁ : Quiver.Hom S_W S₁) (pr₂ : Quiver.Hom S_W S₂) (m i₁ i₂ : ℕ)
    (μ : weilEtaleTorsionH S₁ m i₁ →+
      weilEtaleTorsionH S₂ m i₂ →+
      weilEtaleTorsionH S_W m (i₁ + i₂)) : Prop :=
  let R_m : Type u := ULift.{u, 0} (ZMod m)
  let ModCat := ModuleCat.{u, u} R_m
  let OneMod := fun S : AlgebraicGeometry.Scheme.{u} =>
    weilEtaleModuleUnit S m
  haveI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) pr₁ :=
    ⟨fun _ _ => inferInstance⟩
  haveI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) pr₁ :=
    ⟨fun h hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback h hg⟩
  haveI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) pr₂ :=
    ⟨fun _ _ => inferInstance⟩
  haveI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) pr₂ :=
    ⟨fun h hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback h hg⟩
  let B₁ : CategoryTheory.Functor S₁.Etale S_W.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ pr₁
  let B₂ : CategoryTheory.Functor S₂.Etale S_W.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ pr₂
  ∃ (hB₁ : B₁.IsContinuous S₁.smallEtaleTopology S_W.smallEtaleTopology)
    (hB₂ : B₂.IsContinuous S₂.smallEtaleTopology S_W.smallEtaleTopology),
    let P₁_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B₁ ModCat _
      S₁.smallEtaleTopology S_W.smallEtaleTopology hB₁
    let P₂_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B₂ ModCat _
      S₂.smallEtaleTopology S_W.smallEtaleTopology hB₂
    ∃ (P₁_pull : CategoryTheory.Functor (CategoryTheory.Sheaf S₁.smallEtaleTopology ModCat)
          (CategoryTheory.Sheaf S_W.smallEtaleTopology ModCat))
      (adj₁ : CategoryTheory.Adjunction P₁_pull P₁_push)
      (_ : P₁_pull.Additive)
      (_ : CategoryTheory.Limits.PreservesFiniteLimits P₁_pull)
      (_ : CategoryTheory.Limits.PreservesFiniteColimits P₁_pull)
      (P₂_pull : CategoryTheory.Functor (CategoryTheory.Sheaf S₂.smallEtaleTopology ModCat)
          (CategoryTheory.Sheaf S_W.smallEtaleTopology ModCat))
      (adj₂ : CategoryTheory.Adjunction P₂_pull P₂_push)
      (_ : P₂_pull.Additive)
      (_ : CategoryTheory.Limits.PreservesFiniteLimits P₂_pull)
      (_ : CategoryTheory.Limits.PreservesFiniteColimits P₂_pull)
      (T₁ : S₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (T₂ : S₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (T_W : S_W.Etale) (hT_W : CategoryTheory.Limits.IsTerminal T_W),
      let adjMod₁ := CategoryTheory.constantSheafAdj S₁.smallEtaleTopology ModCat hT₁
      let adjMod₂ := CategoryTheory.constantSheafAdj S₂.smallEtaleTopology ModCat hT₂
      let adjModW := CategoryTheory.constantSheafAdj S_W.smallEtaleTopology ModCat hT_W
      let ε₁ : Quiver.Hom (P₁_pull.obj (OneMod S₁)) (OneMod S_W) :=
        (adj₁.homEquiv (OneMod S₁) (OneMod S_W)).symm
          ((adjMod₁.homEquiv (ModuleCat.of R_m R_m) (P₁_push.obj (OneMod S_W))).symm
            (CategoryTheory.CategoryStruct.comp
              (adjModW.unit.app (ModuleCat.of R_m R_m))
              ((OneMod S_W).obj.map (Opposite.op (hT_W.from (B₁.obj T₁))))))
      let ε₂ : Quiver.Hom (P₂_pull.obj (OneMod S₂)) (OneMod S_W) :=
        (adj₂.homEquiv (OneMod S₂) (OneMod S_W)).symm
          ((adjMod₂.homEquiv (ModuleCat.of R_m R_m) (P₂_push.obj (OneMod S_W))).symm
            (CategoryTheory.CategoryStruct.comp
              (adjModW.unit.app (ModuleCat.of R_m R_m))
              ((OneMod S_W).obj.map (Opposite.op (hT_W.from (B₂.obj T₂))))))
      ∃ (η₁ : Quiver.Hom (OneMod S_W) (P₁_pull.obj (OneMod S₁)))
        (η₂ : Quiver.Hom (OneMod S_W) (P₂_pull.obj (OneMod S₂)))
        (Θ₁ : weilEtaleModuleH S₁ m i₁ →+ weilEtaleTorsionH S₁ m i₁)
        (Θ₂ : weilEtaleModuleH S₂ m i₂ →+ weilEtaleTorsionH S₂ m i₂)
        (Θ_W : weilEtaleModuleH S_W m (i₁ + i₂) →+ weilEtaleTorsionH S_W m (i₁ + i₂)),
        CategoryTheory.CategoryStruct.comp ε₁ η₁ = CategoryTheory.CategoryStruct.id _ ∧
        CategoryTheory.CategoryStruct.comp η₁ ε₁ = CategoryTheory.CategoryStruct.id _ ∧
        CategoryTheory.CategoryStruct.comp ε₂ η₂ = CategoryTheory.CategoryStruct.id _ ∧
        CategoryTheory.CategoryStruct.comp η₂ ε₂ = CategoryTheory.CategoryStruct.id _ ∧
        WeilIsModuleToTorsionComparison S₁ m i₁ Θ₁ ∧
        WeilIsModuleToTorsionComparison S₂ m i₂ Θ₂ ∧
        WeilIsModuleToTorsionComparison S_W m (i₁ + i₂) Θ_W ∧
        Function.Bijective Θ₁ ∧ Function.Bijective Θ₂ ∧ Function.Bijective Θ_W ∧
        ∀ (α₁ : weilEtaleModuleH S₁ m i₁) (α₂ : weilEtaleModuleH S₂ m i₂),
          let pull₁ : weilEtaleModuleH S_W m i₁ :=
            (CategoryTheory.Abelian.Ext.mk₀ η₁).comp
              (((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P₁_pull _ _ _ _ _
                (OneMod S₁) (OneMod S₁) i₁) α₁).comp
                (CategoryTheory.Abelian.Ext.mk₀ ε₁) (Nat.add_zero i₁)) (Nat.zero_add i₁)
          let pull₂ : weilEtaleModuleH S_W m i₂ :=
            (CategoryTheory.Abelian.Ext.mk₀ η₂).comp
              (((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P₂_pull _ _ _ _ _
                (OneMod S₂) (OneMod S₂) i₂) α₂).comp
                (CategoryTheory.Abelian.Ext.mk₀ ε₂) (Nat.add_zero i₂)) (Nat.zero_add i₂)
          μ (Θ₁ α₁) (Θ₂ α₂) = Θ_W (pull₁.comp pull₂ rfl)
noncomputable abbrev weilEtaleSitePullback {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom S₁ S₂) : CategoryTheory.Functor S₂.Etale S₁.Etale :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h

noncomputable def weilEtaleConstPullbackHom {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom S₁ S₂)
    [_hCont : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
    [_hAdj : ((weilEtaleSitePullback h).sheafPushforwardContinuous
      AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint]
    {T₁ : S₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
    {T₂ : S₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
    (A : AddCommGrpCat.{u}) :
    Quiver.Hom
      (((weilEtaleSitePullback h).sheafPullback
        AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology).obj
        ((CategoryTheory.constantSheaf S₂.smallEtaleTopology AddCommGrpCat.{u}).obj A))
      ((CategoryTheory.constantSheaf S₁.smallEtaleTopology AddCommGrpCat.{u}).obj A) :=
  let B := weilEtaleSitePullback h
  let J₁ := S₁.smallEtaleTopology
  let J₂ := S₂.smallEtaleTopology
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
  let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
  let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
  let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
  let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
  (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm
    ((adj₂.homEquiv A (P_push.obj (C₁.obj A))).symm
      (CategoryTheory.CategoryStruct.comp (adj₁.unit.app A)
        ((C₁.obj A).obj.map τ.op)))
def WeilHasOrdinaryGodementResolution (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) : Prop :=
  let R := ULift.{u, 0} (ZMod m)
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  let oneR := weilEtaleModuleUnit S m
  let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let U_m := CategoryTheory.Sheaf.composeAndSheafify J FgtMod
  ∃ (G : ℕ → CategoryTheory.Functor 𝒞 𝒞)
    (η : CategoryTheory.NatTrans (CategoryTheory.Functor.id 𝒞) (G 0))
    (diff : ∀ q : ℕ, CategoryTheory.NatTrans (G q) (G (q + 1))),
    (∀ q : ℕ, (G q).Additive ∧
      CategoryTheory.Limits.PreservesFiniteLimits (G q) ∧
      CategoryTheory.Limits.PreservesFiniteColimits (G q)) ∧
    (∀ F : 𝒞, CategoryTheory.Mono (η.app F)) ∧
    (∀ F : 𝒞, ∃ h₀ : CategoryTheory.CategoryStruct.comp (η.app F) ((diff 0).app F) = 0,
      (CategoryTheory.ShortComplex.mk (η.app F) ((diff 0).app F) h₀).Exact) ∧
    (∀ (q : ℕ) (F : 𝒞),
      ∃ hq : CategoryTheory.CategoryStruct.comp ((diff q).app F) ((diff (q + 1)).app F) = 0,
        (CategoryTheory.ShortComplex.mk ((diff q).app F) ((diff (q + 1)).app F) hq).Exact) ∧
    (∀ (q k : ℕ), 1 ≤ k → ∀ F : 𝒞,
      Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR ((G q).obj F) k)) ∧
    (∀ (q : ℕ) (F : 𝒞),
      Nonempty (CategoryTheory.Abelian.Ext.{u} oneR F q ≃+ ((U_m.obj F).H q)))
def WeilIsStrictLocalNoetherianAlgClosedRing (k : Type u) [Field k]
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k) : Prop :=
  IsNoetherianRing A ∧
  IsLocalRing A ∧
  (∀ a : A, τ_A a = 0 ↔ ¬ IsUnit a) ∧
  HenselianLocalRing A ∧
  (∀ (C : Type u) [CommRing C] [Algebra A C] [Algebra.Etale A C] (τ_C : C →+* k),
    (∀ a : A, τ_C (algebraMap A C a) = τ_A a) →
    ∃ σ_C : C →ₐ[A] A, ∀ c : C, τ_A (σ_C c) = τ_C c)

def WeilEtaleCohomologyPullbackBijective {Y₀ Y : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom Y₀ Y)
    (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
    (q : ℕ) : Prop :=
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_h : CategoryTheory.Functor Y.Etale Y₀.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  ∃ (_ : B_h.IsContinuous Y.smallEtaleTopology Y₀.smallEtaleTopology),
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} Y.smallEtaleTopology Y₀.smallEtaleTopology
    ∃ (_ : pf_h.IsRightAdjoint),
      let pb_h := B_h.sheafPullback AddCommGrpCat.{u} Y.smallEtaleTopology Y₀.smallEtaleTopology
      let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} Y.smallEtaleTopology Y₀.smallEtaleTopology
      ∃ (_ : pb_h.Additive)
        (_ : CategoryTheory.Limits.PreservesFiniteLimits pb_h)
        (_ : CategoryTheory.Limits.PreservesFiniteColimits pb_h),
        let Pℤ_Y := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj (AddCommGrpCat.of (ULift.{u} ℤ))
        let Pℤ_Y₀ := (CategoryTheory.Functor.const (Opposite Y₀.Etale)).obj (AddCommGrpCat.of (ULift.{u} ℤ))
        let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        let Fℤ_Y₀ := (CategoryTheory.constantSheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        let η₀ := CategoryTheory.Functor.whiskerLeft B_h.op
          ((CategoryTheory.sheafificationAdjunction Y₀.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ_Y₀)
        let uℤ := ((CategoryTheory.sheafificationAdjunction Y.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
          Pℤ_Y (pf_h.obj Fℤ_Y₀)).symm η₀
        let cℤ := (adj_h.homEquiv Fℤ_Y Fℤ_Y₀).symm uℤ
        ∃ (hcℤ : CategoryTheory.IsIso cℤ),
          let inv_cℤ := @CategoryTheory.inv _ _ _ _ cℤ hcℤ
          Function.Bijective (fun (x : CategoryTheory.Sheaf.H F q) =>
            (CategoryTheory.Abelian.Ext.mk₀ inv_cℤ).precomp (pb_h.obj F) (Nat.zero_add q)
              ((pb_h.mapExtAddHom Fℤ_Y F q) x))

