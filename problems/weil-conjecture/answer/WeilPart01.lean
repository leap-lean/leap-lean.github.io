    CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) :=
  (CategoryTheory.constantSheaf S.smallEtaleTopology
    (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))).obj
    (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m)))

noncomputable abbrev weilCupPDModH (S : AlgebraicGeometry.Scheme.{u}) (m j : ℕ) : Type u :=
  CategoryTheory.Abelian.Ext.{u} (weilCupPDModUnit S m) (weilCupPDModUnit S m) j

def WeilCupPDIsModComparison (S : AlgebraicGeometry.Scheme.{u}) (m j : ℕ)
    (θ : weilCupPDModH S m j →+ weilEtaleTorsionH S m j) : Prop :=
  let R := ULift.{u, 0} (ZMod m)
  let J := S.smallEtaleTopology
  let Cℤ := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  let Fℤ := Cℤ.obj (AddCommGrpCat.of (ULift.{u} ℤ))
  let FM := weilEtaleTorsionSheaf S m
  let oneR := weilCupPDModUnit S m
  let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let ιM : Quiver.Hom (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
      (FgtMod.obj (ModuleCat.of R R)) :=
    AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let ιℤ : Quiver.Hom (AddCommGrpCat.of (ULift.{u} ℤ))
      (FgtMod.obj (ModuleCat.of R R)) :=
    CategoryTheory.CategoryStruct.comp
      (AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ)) :
        Quiver.Hom (AddCommGrpCat.of (ULift.{u} ℤ))
          (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ)))
      (CategoryTheory.CategoryStruct.comp
        (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod m))))
        ιM)
  ∃ (U : CategoryTheory.Functor
      (CategoryTheory.Sheaf J (ModuleCat.{u, u} R))
      (CategoryTheory.Sheaf J AddCommGrpCat.{u})),
    (∀ ℱ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R),
      (U.obj ℱ).obj = CategoryTheory.Functor.comp ℱ.obj FgtMod) ∧
    (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)} (u : Quiver.Hom ℱ₁ ℱ₂)
      (W : Opposite S.Etale),
      HEq ((U.map u).hom.app W) (FgtMod.map (u.hom.app W))) ∧
    ∃ (_ : U.Additive) (_ : CategoryTheory.Limits.PreservesFiniteLimits U)
      (_ : CategoryTheory.Limits.PreservesFiniteColimits U)
      (T : S.Etale) (hT : CategoryTheory.Limits.IsTerminal T),
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj T).left = S ∧
      HEq ((AlgebraicGeometry.Scheme.Etale.forget S).obj T).hom
        (CategoryTheory.CategoryStruct.id S) ∧
      let adjℤ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
      let adjR := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) hT
      ∃ (u_unit : Quiver.Hom (FgtMod.obj (ModuleCat.of R R))
          ((U.obj oneR).obj.obj (Opposite.op T))),
        HEq u_unit (FgtMod.map (adjR.unit.app (ModuleCat.of R R))) ∧
        let ηℤ : Quiver.Hom Fℤ (U.obj oneR) :=
          (adjℤ.homEquiv (AddCommGrpCat.of (ULift.{u} ℤ)) (U.obj oneR)).symm
            (CategoryTheory.CategoryStruct.comp ιℤ u_unit)
        let αM : Quiver.Hom FM (U.obj oneR) :=
          (adjℤ.homEquiv (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
            (U.obj oneR)).symm
            (CategoryTheory.CategoryStruct.comp ιM u_unit)
        ∃ (βM : Quiver.Hom (U.obj oneR) FM),
          CategoryTheory.CategoryStruct.comp αM βM = CategoryTheory.CategoryStruct.id FM ∧
          CategoryTheory.CategoryStruct.comp βM αM =
            CategoryTheory.CategoryStruct.id (U.obj oneR) ∧
          ∀ x : weilCupPDModH S m j,
            θ x = (CategoryTheory.Abelian.Ext.mk₀ βM).postcomp Fℤ (Nat.add_zero j)
              ((CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U _ _ _ _ _ oneR oneR j) x)
                (Nat.zero_add j))

