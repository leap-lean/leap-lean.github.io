          WeilIsEtaleSheafPullback h (weilEtaleLocalTorsionSheaf S ℓ U_et) G₀ ∧
          CategoryTheory.Limits.IsZero G₀ := by
      intro Z S h U hDisj U_et
      let ℒ := weilEtaleLocalTorsionSheaf S ℓ U_et
      let F_pre : AddCommGrpCat.{u} ⥤ ((S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) :=
        { obj := fun M => CategoryTheory.Presheaf.freeYoneda U_et M
