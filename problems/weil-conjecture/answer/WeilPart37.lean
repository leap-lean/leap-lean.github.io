    obtain ⟨V₀, hz₀, hSm_V₀⟩ := hSm_away (pr_Z.base z) hfz₀ hxz₀
    let V : Z_bar.left.Opens := (TopologicalSpace.Opens.map pr_Z.base).obj V₀
    have hpb_V := (AlgebraicGeometry.isPullback_morphismRestrict pr_Z V₀).paste_vert hPb_fbar'
    exact ⟨V, hz₀,
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_V hSm_V₀⟩

  let Z_s : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)) :=
    CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f₀.left s)
  have : AlgebraicGeometry.IsProper Z_s.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback f₀.left s) inferInstance
  let Z_s_bar := weilBaseChangeOver F k Z_s
  have : AlgebraicGeometry.IsProper Z_s_bar.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback Z_s.hom g_k) inferInstance
  let pr_Zs : Z_s_bar.left ⟶ Z_s.left := CategoryTheory.Limits.pullback.fst Z_s.hom g_k
  let π_Zbar : Z_s_bar.left ⟶ Z_bar.left :=
    CategoryTheory.Limits.pullback.lift
