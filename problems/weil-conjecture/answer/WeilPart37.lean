    have hf_Xi_bij : Function.Bijective f_Xi := by
      rw [hFrobEqPull K X (ℓ ^ (r + 1)) (2 * d - 2 * c) f_Xi p_frob hf_Xi hp_frob']
      exact hPullIsoBij iso_frob (ℓ ^ (r + 1)) (2 * d - 2 * c)
        p_frob p_frob_inv hp_frob hp_frob_inv

    have hPD_gen : ∀ (q₂ : ℕ) (h_eq : 2 * d - (2 * d - 2 * c) = q₂)
        (hc_eq : (2 * d - 2 * c) + q₂ = 2 * d)
        (b : weilEtaleModuleH (weilGeomScheme K X) (ℓ ^ (r + 1)) q₂),
        (∀ a : weilEtaleModuleH (weilGeomScheme K X) (ℓ ^ (r + 1)) (2 * d - 2 * c),
          tr_X (r + 1) (θ_top (CategoryTheory.Abelian.Ext.comp a b hc_eq)) = 0) →
