        rw [hV.range_fromSpec]
        exact hzV
      obtain ⟨q_pt, hq_pt⟩ := hz_range
      have hsub_b : Set.range hV.fromSpec.base ⊆ Set.range (j_chart b).base := by
        rw [hV.range_fromSpec, hj_range b]
        exact fun w hw => (hV_sub hw).1
      have hsub_b' : Set.range hV.fromSpec.base ⊆ Set.range (j_chart b').base := by
        rw [hV.range_fromSpec, hj_range b']
        exact fun w hw => (hV_sub hw).2
      let m_b := IsOpenImmersion.lift (j_chart b) hV.fromSpec hsub_b
      let m_b' := IsOpenImmersion.lift (j_chart b') hV.fromSpec hsub_b'
      have hm_b : m_b ≫ j_chart b = hV.fromSpec :=
        IsOpenImmersion.lift_fac (j_chart b) hV.fromSpec hsub_b
      have hm_b' : m_b' ≫ j_chart b' = hV.fromSpec :=
        IsOpenImmersion.lift_fac (j_chart b') hV.fromSpec hsub_b'
      have _hOpen_mb : IsOpenImmersion m_b := by
        have : IsOpenImmersion (m_b ≫ j_chart b) := by
          rw [hm_b]
          exact hV.isOpenImmersion_fromSpec
        exact AlgebraicGeometry.IsOpenImmersion.of_comp m_b (j_chart b)
      let ρ_b : ↥(R_b b) →+* T := (AlgebraicGeometry.Spec.preimage m_b).hom
      let ρ_b' : ↥(R_b b') →+* T := (AlgebraicGeometry.Spec.preimage m_b').hom
      have hm_b_spec : Spec.map (CommRingCat.ofHom ρ_b) = m_b := by
        dsimp only [ρ_b]
        rw [CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]
      have hm_b'_spec : Spec.map (CommRingCat.ofHom ρ_b') = m_b' := by
        dsimp only [ρ_b']
        rw [CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]
      have hσ_eq : ρ_b.comp (algebraMap A ↥(R_b b)) = ρ_b'.comp (algebraMap A ↥(R_b b')) := by
        have hspec_eq :
            Spec.map (CommRingCat.ofHom (ρ_b.comp (algebraMap A ↥(R_b b)))) =
              Spec.map (CommRingCat.ofHom (ρ_b'.comp (algebraMap A ↥(R_b b')))) := by
          rw [CommRingCat.ofHom_comp, Spec.map_comp, hm_b_spec, ← hj_proj b,
            ← Category.assoc, hm_b,
            CommRingCat.ofHom_comp, Spec.map_comp, hm_b'_spec, ← hj_proj b',
            ← Category.assoc, hm_b']
        have hpre := congrArg (fun φ => (AlgebraicGeometry.Spec.preimage φ).hom) hspec_eq
        simpa only [AlgebraicGeometry.Spec.preimage_map, CommRingCat.hom_ofHom] using hpre
      let σ : A →+* T := ρ_b.comp (algebraMap A ↥(R_b b))
      have hgb_Rb_nz : algebraMap A ↥(R_b b) (g b) ≠ 0 := by
        intro h0
        apply hg_L_nz b
        rw [← RingHom.congr_fun (hι_alg b) (g b), RingHom.comp_apply, h0, map_zero]
      have hσ_gb_nz : σ (g b) ≠ 0 := by
        let G₁ : Set ↥(Spec (CommRingCat.of ↥(R_b b))) :=
          m_b.base '' (Set.univ : Set ↥(Spec (CommRingCat.of T)))
        let D_gb : (Spec (CommRingCat.of ↥(R_b b))).Opens :=
          PrimeSpectrum.basicOpen (algebraMap A ↥(R_b b) (g b))
        have hG₁_open : IsOpen G₁ := m_b.isOpenMap _ isOpen_univ
        have hG₁_ne : G₁.Nonempty := ⟨m_b.base q_pt, q_pt, trivial, rfl⟩
        have hD_ne : (D_gb : Set ↥(Spec (CommRingCat.of ↥(R_b b)))).Nonempty := by
          refine ⟨⟨⊥, inferInstance⟩, ?_⟩
          change algebraMap A ↥(R_b b) (g b) ∉ (⊥ : Ideal ↥(R_b b))
          rw [Ideal.mem_bot]
          exact hgb_Rb_nz
        obtain ⟨_, -, ⟨q₀, -, rfl⟩, hq₀_D⟩ :=
          PreirreducibleSpace.isPreirreducible_univ G₁ D_gb hG₁_open D_gb.2
            (by simpa using hG₁_ne) (by simpa using hD_ne)
        have hnot_mem : σ (g b) ∉ q₀.asIdeal := by
          rw [← hm_b_spec] at hq₀_D
          exact hq₀_D
        intro h0
        apply hnot_mem
        rw [h0]
        exact q₀.asIdeal.zero_mem
      have hrel₁ : σ (g b) * ρ_b (u b b') = σ (g b') := by
        have h := congrArg ρ_b (hu_eq b b')
        rwa [map_mul] at h
      have hrel₂ : σ (g b') * ρ_b' (u b' b) = σ (g b) := by
        have h := congrArg ρ_b' (hu_eq b' b)
        rw [map_mul] at h
        have hσ_b : ρ_b' (algebraMap A ↥(R_b b') (g b)) = σ (g b) :=
          (RingHom.congr_fun hσ_eq (g b)).symm
        have hσ_b' : ρ_b' (algebraMap A ↥(R_b b') (g b')) = σ (g b') :=
          (RingHom.congr_fun hσ_eq (g b')).symm
        rwa [hσ_b, hσ_b'] at h
      have hmul_zero : σ (g b) * (ρ_b (u b b') * ρ_b' (u b' b) - 1) = 0 := by
        rw [mul_sub, mul_one, ← mul_assoc, hrel₁, hrel₂, sub_self]
      have hunit_eq : ρ_b (u b b') * ρ_b' (u b' b) = 1 :=
        sub_eq_zero.mp ((mul_eq_zero.mp hmul_zero).resolve_left hσ_gb_nz)
      have hu_unit_T : IsUnit (ρ_b (u b b')) :=
        IsUnit.of_mul_eq_one (ρ_b' (u b' b)) hunit_eq
      have hmb_q_in : m_b.base q_pt ∈ PrimeSpectrum.basicOpen (u b b') := by
        rw [← hm_b_spec]
        change ρ_b (u b b') ∉ q_pt.asIdeal
        intro hmem
        exact q_pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem hu_unit_T)
      have hrange_loc :
          Set.range (PrimeSpectrum.comap (algebraMap ↥(R_b b) (Localization.Away (u b b')))) =
            (PrimeSpectrum.basicOpen (u b b') : Set (PrimeSpectrum ↥(R_b b))) :=
        PrimeSpectrum.localization_away_comap_range (Localization.Away (u b b')) (u b b')
      change m_b.base q_pt ∈ (PrimeSpectrum.basicOpen (u b b') : Set (PrimeSpectrum ↥(R_b b))) at hmb_q_in
      rw [← hrange_loc] at hmb_q_in
      rcases hmb_q_in with ⟨p_ov, hp_ov⟩
      refine ⟨p_ov, ?_⟩
      change (j_chart b).base (PrimeSpectrum.comap
        (algebraMap ↥(R_b b) (Localization.Away (u b b'))) p_ov) = z
      rw [hp_ov]
      change (m_b ≫ j_chart b).base q_pt = z
      rw [hm_b, hq_pt]

  
  let P_proj : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜_K
  let π_proj : P_proj ⟶ Spec (CommRingCat.of K) :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜_K ≫
      Spec.map (CommRingCat.ofHom (algebraMap K ↥(𝒜_K 0)))
  obtain ⟨Ψ, hΨ_hom, hΨ_pre, hΨ_chart⟩ :
      ∃ Ψ : P_sch ⟶ P_proj,
        Ψ ≫ π_proj =
          π_P ≫ Spec.map (CommRingCat.ofHom alg_A) ∧
        (∀ μ : Fin (M₀ + 1),
          (TopologicalSpace.Opens.map Ψ.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_K (MvPolynomial.X μ)) = W μ) ∧
        (∀ μ : Fin (M₀ + 1),
          (W μ).ι ≫ Ψ =
            (isoW μ).hom ≫ Spec.map (CommRingCat.ofHom (θ μ)) ≫
              AlgebraicGeometry.Proj.awayι 𝒜_K (MvPolynomial.X μ) (hX_hom μ) zero_lt_one) := by
    let 𝒰 : P_sch.OpenCover := P_sch.openCoverOfIsOpenCover W hW_cov
    let Ψ_chart : ∀ b : Fin (M₀ + 1), (W b).toScheme ⟶ P_proj :=
      fun b => (isoW b).hom ≫ Spec.map (CommRingCat.ofHom (θ b)) ≫
        AlgebraicGeometry.Proj.awayι 𝒜_K (MvPolynomial.X b) (hX_hom b) zero_lt_one
    have hΨ_glue : ∀ b b' : 𝒰.I₀,
        Limits.pullback.fst (𝒰.f b) (𝒰.f b') ≫ Ψ_chart b =
          Limits.pullback.snd (𝒰.f b) (𝒰.f b') ≫ Ψ_chart b' := by
      intro (b : Fin (M₀ + 1)) (b' : Fin (M₀ + 1))
      change Limits.pullback.fst (W b).ι (W b').ι ≫ Ψ_chart b =
        Limits.pullback.snd (W b).ι (W b').ι ≫ Ψ_chart b'
      let p₁ : Spec (CommRingCat.of (Localization.Away (u b b'))) ⟶ (W b).toScheme :=
        Spec.map (CommRingCat.ofHom (algebraMap ↥(R_b b) (Localization.Away (u b b')))) ≫
          (isoW b).inv
      let p₂ : Spec (CommRingCat.of (Localization.Away (u b b'))) ⟶ (W b').toScheme :=
        Spec.map (CommRingCat.ofHom ((τ b b').toRingHom.comp
