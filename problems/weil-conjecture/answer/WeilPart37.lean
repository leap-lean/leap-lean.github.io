            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F.symm.toRingHom) := by
          rw [hSpec_conj]; simp only [CategoryTheory.Category.assoc]
        _ = ((e_geom W).hom ≫ snd_k) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F.symm.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F.symm.toRingHom) := by
          rw [← hhom_snd]
        _ = (e_geom W).hom ≫ ((snd_k ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F.symm.toRingHom)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F.symm.toRingHom)) := by
          simp only [CategoryTheory.Category.assoc]
        _ = (e_geom W).hom ≫ ((weilGeomFrobHom F W ≫ snd_k) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F.symm.toRingHom)) :=
          congrArg ((e_geom W).hom ≫ ·) (congrArg (· ≫ _) hf₁_snd.symm)
