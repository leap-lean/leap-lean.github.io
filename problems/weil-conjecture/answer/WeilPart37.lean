    intro X₁ X₂ h
    let B : CategoryTheory.Functor X₂.Etale X₁.Etale := B_of h
    have _ : CategoryTheory.Limits.HasTerminal X₂.Etale := (hTerm_of X₂).hasTerminal
    have _ : CategoryTheory.Limits.HasFiniteLimits X₂.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have _ : CategoryTheory.Limits.PreservesFiniteLimits B :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback P_et h
    have _ : CategoryTheory.RepresentablyFlat B :=
      CategoryTheory.flat_of_preservesFiniteLimits B
    have hCompat : CategoryTheory.CompatiblePreserving X₁.smallEtaleTopology B :=
      CategoryTheory.compatiblePreservingOfFlat X₁.smallEtaleTopology B
    have hCov : CategoryTheory.CoverPreserving X₂.smallEtaleTopology X₁.smallEtaleTopology B := by
      refine ⟨fun {U S} hS => ?_⟩
      have hTop₂ :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) X₂ (le_refl P_et)
      have hTop₁ :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) X₁ (le_refl P_et)
      have hS₁ : S ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck U := by
        change S ∈ X₂.smallGrothendieckTopology P_et U at hS
        rwa [hTop₂] at hS
      have hS' :=
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) (S := X₂) U S).mp hS₁
      change S.functorPushforward B ∈ X₁.smallGrothendieckTopology P_et (B.obj U)
      rw [hTop₁]
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := X₁) (B.obj U) (S.functorPushforward B)).mpr ?_
      intro z
      let fstU := CategoryTheory.Limits.pullback.fst U.hom h
      obtain ⟨Y_et, f, y, hfS, _, hy⟩ := hS' (fstU z)
      have hBf_mem : (S.functorPushforward B).arrows (B.map f) :=
        CategoryTheory.Sieve.image_mem_functorPushforward B S hfS
      have hBf_et : P_et (B.map f).left :=
        CategoryTheory.MorphismProperty.of_postcomp P_et (B.map f).left (B.obj U).hom (B.obj U).prop
          (by rw [CategoryTheory.MorphismProperty.Over.w (B.map f)]; exact (B.obj Y_et).prop)
      have hOuter : CategoryTheory.IsPullback
          ((B.map f).left ≫ (B.obj U).hom) (CategoryTheory.Limits.pullback.fst Y_et.hom h)
          h (f.left ≫ U.hom) := by
        rw [CategoryTheory.MorphismProperty.Over.w (B.map f), CategoryTheory.MorphismProperty.Over.w f]
        exact (CategoryTheory.IsPullback.of_hasPullback Y_et.hom h).flip
      have hmap := CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ h f
      have hCommSq : (B.map f).left ≫ fstU =
          CategoryTheory.Limits.pullback.fst Y_et.hom h ≫ f.left :=
        (congrArg (· ≫ fstU) hmap).trans (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      have hRight : CategoryTheory.IsPullback (B.obj U).hom fstU h U.hom :=
        (CategoryTheory.IsPullback.of_hasPullback U.hom h).flip
      have hLeft : CategoryTheory.IsPullback (B.map f).left
          (CategoryTheory.Limits.pullback.fst Y_et.hom h) fstU f.left :=
        CategoryTheory.IsPullback.of_right hOuter hCommSq hRight
      obtain ⟨w₀, hw₀, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
      refine ⟨B.obj Y_et, B.map f, hLeft.isoPullback.inv w₀, hBf_mem, hBf_et, ?_⟩
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hLeft.isoPullback_inv_fst, hw₀]
    have hc : B.IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov
    let ι₂ : CategoryTheory.Functor X₂.AffineEtale X₂.Etale :=
      AlgebraicGeometry.Scheme.AffineEtale.Spec X₂
    let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology X₂
    let M₂ : Type u := CategoryTheory.SmallModel.{u} X₂.AffineEtale
    let e_sm : X₂.AffineEtale ≌ M₂ := CategoryTheory.equivSmallModel.{u} X₂.AffineEtale
    let J_M := e_sm.inverse.inducedTopology J_aff
    let K : CategoryTheory.Functor M₂ X₁.Etale := e_sm.inverse ⋙ (ι₂ ⋙ B)
    have _ : (ι₂ ⋙ B).IsContinuous J_aff X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp ι₂ B J_aff X₂.smallEtaleTopology X₁.smallEtaleTopology
    have _ : K.IsContinuous J_M X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp e_sm.inverse (ι₂ ⋙ B) J_M J_aff X₁.smallEtaleTopology
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let F_ι := ι₂.sheafPushforwardContinuous AddCommGrpCat.{u} J_aff X₂.smallEtaleTopology
    let F_sm := e_sm.inverse.sheafPushforwardContinuous AddCommGrpCat.{u} J_M J_aff
    let P_K := K.sheafPushforwardContinuous AddCommGrpCat.{u} J_M X₁.smallEtaleTopology
    let E_ι := F_ι.asEquivalence
    let E_sm := F_sm.asEquivalence
    have e_comp1 : P_push ⋙ F_ι ≅
        (ι₂ ⋙ B).sheafPushforwardContinuous AddCommGrpCat.{u} J_aff X₁.smallEtaleTopology :=
      CategoryTheory.Functor.sheafPushforwardContinuousComp ι₂ B AddCommGrpCat.{u}
        J_aff X₂.smallEtaleTopology X₁.smallEtaleTopology
    have e_comp2 :
        ((ι₂ ⋙ B).sheafPushforwardContinuous AddCommGrpCat.{u} J_aff X₁.smallEtaleTopology) ⋙ F_sm ≅
          P_K :=
      CategoryTheory.Functor.sheafPushforwardContinuousComp e_sm.inverse (ι₂ ⋙ B) AddCommGrpCat.{u}
        J_M J_aff X₁.smallEtaleTopology
    have e_tot : (P_push ⋙ E_ι.functor) ⋙ E_sm.functor ≅ P_K :=
      CategoryTheory.Functor.isoWhiskerRight e_comp1 E_sm.functor ≪≫ e_comp2
    have e_rhs : P_K ⋙ (E_sm.inverse ⋙ E_ι.inverse) ≅ P_push :=
      (CategoryTheory.Functor.isoWhiskerRight e_tot.symm (E_sm.inverse ⋙ E_ι.inverse)) ≪≫
      (CategoryTheory.Functor.associator _ _ _) ≪≫
      CategoryTheory.Functor.isoWhiskerLeft (P_push ⋙ E_ι.functor)
        ((CategoryTheory.Functor.associator _ _ _).symm ≪≫
          CategoryTheory.Functor.isoWhiskerRight E_sm.unitIso.symm E_ι.inverse ≪≫
          CategoryTheory.Functor.leftUnitor E_ι.inverse) ≪≫
      (CategoryTheory.Functor.associator _ _ _) ≪≫
      CategoryTheory.Functor.isoWhiskerLeft P_push E_ι.unitIso.symm ≪≫
      CategoryTheory.Functor.rightUnitor P_push
    let adj_K := K.sheafAdjunctionContinuous AddCommGrpCat.{u} J_M X₁.smallEtaleTopology
    let adj_tot := ((E_ι.toAdjunction.comp E_sm.toAdjunction).comp adj_K).ofNatIsoRight e_rhs
    exact ⟨hc, adj_tot.isRightAdjoint⟩

  have hc_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      (B_of h).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology :=
    fun h => (hSite h).choose
  have hr_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (B_of h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ h)).IsRightAdjoint :=
    fun h => (hSite h).choose_spec
  letI : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      (B_of h).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology := @hc_all
  letI : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      ((B_of h).sheafPushforwardContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology).IsRightAdjoint := @hr_all

  let pb_of : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u} ⥤
        CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u} :=
    fun {X₁ X₂} h =>
      (B_of h).sheafPullback AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology
  let pf_of : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u} ⥤
        CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u} :=
    fun {X₁ X₂} h =>
      (B_of h).sheafPushforwardContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology
  let adj_of : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      pb_of h ⊣ pf_of h :=
    fun {X₁ X₂} h =>
      (B_of h).sheafAdjunctionContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology

  have hPbZeroOfWitness : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}),
      (∃ F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u},
        WeilIsEtaleSheafPullback h F₂ F₁ ∧ CategoryTheory.Limits.IsZero F₁) →
      CategoryTheory.Limits.IsZero ((pb_of h).obj F₂) := by
    rintro X₁ X₂ h F₂ ⟨F₁, ⟨hc', hr', ⟨e₁⟩⟩, hZ₁⟩
    cases Subsingleton.elim hc' (hc_all h)
    cases Subsingleton.elim hr' (hr_all h)
    exact hZ₁.of_iso e₁

  have hZero_pbUY : CategoryTheory.Limits.IsZero ((pb_of U_Y.ι).obj G) :=
    hPbZeroOfWitness U_Y.ι G hG_U

  have hPbCompZero : ∀ (s : S_k ⟶ Y.left) (s_U : S_k ⟶ U_Y.toScheme),
      s_U ≫ U_Y.ι = s → CategoryTheory.Limits.IsZero ((pb_of s).obj G) := by
    intro s s_U hs_U
    let B_s := B_of s
    let B_UY := B_of U_Y.ι
    let B_sU := B_of s_U
    let e_B : B_s ≅ B_UY ⋙ B_sU :=
      (CategoryTheory.MorphismProperty.Over.pullbackCongr (P := P_et) hs_U.symm).trans
        (CategoryTheory.MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) s_U U_Y.ι)
    have : (B_UY ⋙ B_sU).IsContinuous J_Y J_k :=
      CategoryTheory.Functor.isContinuous_comp B_UY B_sU J_Y U_Y.toScheme.smallEtaleTopology J_k
    let e_pf : pf_of s ≅ pf_of s_U ⋙ pf_of U_Y.ι :=
      (CategoryTheory.Functor.sheafPushforwardContinuousIso e_B AddCommGrpCat.{u} J_Y J_k).trans
        (CategoryTheory.Functor.sheafPushforwardContinuousComp B_UY B_sU
          AddCommGrpCat.{u} J_Y U_Y.toScheme.smallEtaleTopology J_k).symm
    let adj_rhs := ((adj_of U_Y.ι).comp (adj_of s_U)).ofNatIsoRight e_pf.symm
    let e_pb : pb_of s ≅ pb_of U_Y.ι ⋙ pb_of s_U := (adj_of s).leftAdjointUniq adj_rhs
    have : CategoryTheory.Limits.PreservesColimitsOfSize.{0, 0} (pb_of s_U) :=
      (adj_of s_U).leftAdjoint_preservesColimits
    have : CategoryTheory.Limits.PreservesBinaryBiproducts (pb_of s_U) :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts (pb_of s_U)
    have : (pb_of s_U).Additive :=
      CategoryTheory.Functor.additive_of_preservesBinaryBiproducts (pb_of s_U)
    have hZ_iter : CategoryTheory.Limits.IsZero ((pb_of s_U).obj ((pb_of U_Y.ι).obj G)) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      rw [← (pb_of s_U).map_id, (CategoryTheory.Limits.IsZero.iff_id_eq_zero _).mp hZero_pbUY,
        (pb_of s_U).map_zero]
    exact hZ_iter.of_iso (e_pb.app G)

  
  
  
  have section_isPullback_diagonal :
      ∀ {W B : AlgebraicGeometry.Scheme.{u}} (p : W ⟶ B) (σ : B ⟶ W),
        σ ≫ p = 𝟙 B →
        ∃ g : W ⟶ CategoryTheory.Limits.pullback p p,
          CategoryTheory.IsPullback σ σ (CategoryTheory.Limits.pullback.diagonal p) g := by
    intro W B p σ hσ
    let Δ := CategoryTheory.Limits.pullback.diagonal p
    let g : W ⟶ CategoryTheory.Limits.pullback p p :=
      CategoryTheory.Limits.pullback.lift (𝟙 W) (p ≫ σ) (by
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
          hσ, CategoryTheory.Category.comp_id])
    have hg_fst : g ≫ CategoryTheory.Limits.pullback.fst p p = 𝟙 W :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hg_snd : g ≫ CategoryTheory.Limits.pullback.snd p p = p ≫ σ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hΔ_fst : Δ ≫ CategoryTheory.Limits.pullback.fst p p = 𝟙 W :=
      CategoryTheory.Limits.pullback.diagonal_fst p
    have hΔ_snd : Δ ≫ CategoryTheory.Limits.pullback.snd p p = 𝟙 W :=
      CategoryTheory.Limits.pullback.diagonal_snd p
    have hw : σ ≫ Δ = σ ≫ g := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hΔ_fst, CategoryTheory.Category.assoc, hg_fst]
      · rw [CategoryTheory.Category.assoc, hΔ_snd, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.assoc, hg_snd, ← CategoryTheory.Category.assoc,
          hσ, CategoryTheory.Category.id_comp]
    refine ⟨g, { w := hw, isLimit' := ⟨CategoryTheory.Limits.PullbackCone.IsLimit.mk hw
      (fun c => c.fst ≫ p)
      (fun c => ?_)
      (fun c => ?_)
      (fun c m hm _ => ?_)⟩ }⟩
    · have h1 : c.fst = c.snd := by
        have h := congrArg (· ≫ CategoryTheory.Limits.pullback.fst p p) c.condition
        simpa only [CategoryTheory.Category.assoc, hΔ_fst, hg_fst,
          CategoryTheory.Category.comp_id] using h
      have h2 : c.fst = c.snd ≫ (p ≫ σ) := by
        have h := congrArg (· ≫ CategoryTheory.Limits.pullback.snd p p) c.condition
        simpa only [CategoryTheory.Category.assoc, hΔ_snd, hg_snd,
          CategoryTheory.Category.comp_id] using h
      exact (CategoryTheory.Category.assoc c.fst p σ).trans
        ((congrArg (· ≫ (p ≫ σ)) h1).trans h2.symm)
    · have h1 : c.fst = c.snd := by
        have h := congrArg (· ≫ CategoryTheory.Limits.pullback.fst p p) c.condition
        simpa only [CategoryTheory.Category.assoc, hΔ_fst, hg_fst,
          CategoryTheory.Category.comp_id] using h
      have h2 : c.fst = c.snd ≫ (p ≫ σ) := by
        have h := congrArg (· ≫ CategoryTheory.Limits.pullback.snd p p) c.condition
        simpa only [CategoryTheory.Category.assoc, hΔ_snd, hg_snd,
          CategoryTheory.Category.comp_id] using h
      exact ((CategoryTheory.Category.assoc c.fst p σ).trans
        ((congrArg (· ≫ (p ≫ σ)) h1).trans h2.symm)).trans h1
    · calc
        m = m ≫ 𝟙 B := (CategoryTheory.Category.comp_id m).symm
        _ = m ≫ (σ ≫ p) := by rw [hσ]
        _ = (m ≫ σ) ≫ p := (CategoryTheory.Category.assoc m σ p).symm
        _ = c.fst ≫ p := by rw [hm]

  have hy₀_cl : AlgebraicGeometry.IsClosedImmersion y₀ := by
    obtain ⟨g_sec, hPb_y₀⟩ := section_isPullback_diagonal Y.hom y₀ hy₀
    have : AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.diagonal Y.hom) :=
      AlgebraicGeometry.IsSeparated.isClosedImmersion_diagonal (f := Y.hom)
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_y₀ inferInstance
  letI : AlgebraicGeometry.IsClosedImmersion y₀ := hy₀_cl

  have hSecDichot : ∀ (s : S_k ⟶ Y.left),
      s ≫ Y.hom = 𝟙 S_k →
      (∃ s_U : S_k ⟶ U_Y.toScheme, s_U ≫ U_Y.ι = s) ∨ s = y₀ := by
    intro s hs
    by_cases hmem : s.base pt_k ∈ U_Y
    · left
      have hrange : Set.range s.base ⊆ Set.range U_Y.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨q, rfl⟩
        rw [@Subsingleton.elim ↥S_k hSub_Sk q pt_k]
        exact hmem
      exact ⟨AlgebraicGeometry.IsOpenImmersion.lift U_Y.ι s hrange,
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_Y.ι s hrange⟩
    · right
      have hnot_compl : (s.base pt_k : ↥Y.left) ∉ (U_Y : Set Y.left) := hmem
      rw [hU_Y, Set.mem_compl_iff, Classical.not_not] at hnot_compl
      rcases hnot_compl with ⟨q₀, hq₀⟩
      have hbase_eq : s.base pt_k = y₀.base pt_k :=
        hq₀.symm.trans (congrArg y₀.base (@Subsingleton.elim ↥S_k hSub_Sk q₀ pt_k))
      obtain ⟨W₀, hAff_W₀, hy_W₀, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y₀.base pt_k)
          (U := (⊤ : Y.left.Opens)) trivial
      let R : CommRingCat.{u} := Y.left.presheaf.obj (Opposite.op W₀)
      let j : AlgebraicGeometry.Spec R ⟶ Y.left := hAff_W₀.fromSpec
      have hrange_y : Set.range y₀.base ⊆ Set.range j.base := by
        rw [hAff_W₀.range_fromSpec]
        rintro _ ⟨q, rfl⟩
        rw [@Subsingleton.elim ↥S_k hSub_Sk q pt_k]
        exact hy_W₀
      have hrange_s : Set.range s.base ⊆ Set.range j.base := by
        rw [hAff_W₀.range_fromSpec]
        rintro _ ⟨q, rfl⟩
        rw [@Subsingleton.elim ↥S_k hSub_Sk q pt_k, hbase_eq]
        exact hy_W₀
      let s_aff : S_k ⟶ AlgebraicGeometry.Spec R :=
        AlgebraicGeometry.IsOpenImmersion.lift j s hrange_s
      have hs_aff : s_aff ≫ j = s :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac j s hrange_s
      let y_aff : S_k ⟶ AlgebraicGeometry.Spec R :=
        AlgebraicGeometry.IsOpenImmersion.lift j y₀ hrange_y
      have hy_aff : y_aff ≫ j = y₀ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac j y₀ hrange_y
      have hj_inj : Function.Injective j.base :=
        j.isOpenEmbedding.toIsEmbedding.injective
      have haff_pt : s_aff.base pt_k = y_aff.base pt_k := by
        apply hj_inj
        have h1 : j.base (s_aff.base pt_k) = s.base pt_k := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hs_aff]
        have h2 : j.base (y_aff.base pt_k) = y₀.base pt_k := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hy_aff]
        exact h1.trans (hbase_eq.trans h2.symm)
      let φ_s : R ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage s_aff
      have hφ_s : AlgebraicGeometry.Spec.map φ_s = s_aff :=
        AlgebraicGeometry.Spec.map_preimage s_aff
      let φ_y : R ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage y_aff
      have hφ_y : AlgebraicGeometry.Spec.map φ_y = y_aff :=
        AlgebraicGeometry.Spec.map_preimage y_aff
      let α : CommRingCat.of k ⟶ R := AlgebraicGeometry.Spec.preimage (j ≫ Y.hom)
      have hα : AlgebraicGeometry.Spec.map α = j ≫ Y.hom :=
        AlgebraicGeometry.Spec.map_preimage (j ≫ Y.hom)
      have hα_s : α ≫ φ_s = 𝟙 (CommRingCat.of k) := by
        apply AlgebraicGeometry.Spec.map_inj.mp
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id, hφ_s, hα,
          ← CategoryTheory.Category.assoc, hs_aff, hs]
      have hα_y : α ≫ φ_y = 𝟙 (CommRingCat.of k) := by
        apply AlgebraicGeometry.Spec.map_inj.mp
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id, hφ_y, hα,
          ← CategoryTheory.Category.assoc, hy_aff, hy₀]
      have hmap_pt : (AlgebraicGeometry.Spec.map φ_s).base pt_k =
          (AlgebraicGeometry.Spec.map φ_y).base pt_k := by
        rwa [hφ_s, hφ_y]
      have hcomap : Ideal.comap φ_s.hom (⊥ : Ideal k) = Ideal.comap φ_y.hom (⊥ : Ideal k) :=
        congrArg PrimeSpectrum.asIdeal hmap_pt
      have hφ_eq : φ_s = φ_y := by
        apply CommRingCat.hom_ext
        ext r
        have hαy_app : ∀ c : k, φ_y.hom (α.hom c) = c :=
          fun c => ConcreteCategory.congr_hom hα_y c
        have hαs_app : ∀ c : k, φ_s.hom (α.hom c) = c :=
          fun c => ConcreteCategory.congr_hom hα_s c
        let r' : ↑R := r - α.hom (φ_y.hom r)
        have hr'_y : r' ∈ Ideal.comap φ_y.hom (⊥ : Ideal k) := by
          rw [Ideal.mem_comap, Ideal.mem_bot]
          dsimp [r']
          rw [map_sub, hαy_app, sub_self]
        rw [← hcomap, Ideal.mem_comap, Ideal.mem_bot] at hr'_y
        dsimp [r'] at hr'_y
        rw [map_sub, hαs_app] at hr'_y
        exact sub_eq_zero.mp hr'_y
      have hs_eq_y : s_aff = y_aff := by
        rw [← hφ_s, ← hφ_y, hφ_eq]
      rw [← hs_aff, ← hy_aff, hs_eq_y]

  
  
  
  have hSplit : ∀ (V : AlgebraicGeometry.Scheme.{u}) (q : V ⟶ S_k),
      AlgebraicGeometry.Etale q → Function.Surjective q.base →
      ∃ σ : S_k ⟶ V, σ ≫ q = 𝟙 S_k := by
    intro V q hqEt hqSurj
    let R_q : CategoryTheory.Sieve S_k :=
      CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q)
    have hSing : R_q ∈ AlgebraicGeometry.Scheme.etaleTopology S_k :=
      CategoryTheory.Precoverage.generate_mem_toGrothendieck
        ((AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff P_et q).mpr ⟨hqSurj, hqEt⟩)
    obtain ⟨Y', f, hf, y, hy⟩ :=
      (AlgebraicGeometry.Scheme.geometricFiber k).jointly_surjective R_q hSing (𝟙 S_k)
    rcases hf with ⟨W', g, h, hh, rfl⟩
    cases hh
    exact ⟨y ≫ g, (CategoryTheory.Category.assoc y g q).trans hy⟩

  have hTop_Tk : ∀ R ∈ J_k T_k, R = ⊤ := by
    intro R hR
    have heq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S_k (le_refl P_et)
    have hmem := (iff_of_eq (congrArg (fun J => R ∈ J T_k) heq)).mp hR
    obtain ⟨W, u, w₀, huR, huEt, -⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S_k) T_k R).mp hmem pt_k
    have huSurj : Function.Surjective u.left.base :=
      fun (x : ↥S_k) => ⟨w₀, @Subsingleton.elim ↥S_k hSub_Sk _ x⟩
    obtain ⟨s, hs⟩ := hSplit W.left u.left huEt huSurj
    have hu_w : u.left = W.hom :=
      (CategoryTheory.Category.comp_id u.left).symm.trans
        (CategoryTheory.MorphismProperty.Over.w u)
    have hs_hom : s ≫ W.hom = T_k.hom :=
      (congrArg (CategoryTheory.CategoryStruct.comp s) hu_w.symm).trans hs
    let s_et : T_k ⟶ W :=
      CategoryTheory.MorphismProperty.Over.homMk s hs_hom trivial
    have hcomp_id : s_et ≫ u = 𝟙 T_k :=
      CategoryTheory.MorphismProperty.Comma.Hom.ext hs (Subsingleton.elim _ _)
    exact CategoryTheory.Sieve.id_mem_iff_eq_top.mp (hcomp_id ▸ R.downward_closed huR s_et)

  have exists_k_section_of_maximal : ∀ (R_O : CommRingCat.{u})
      (p_W : AlgebraicGeometry.Spec R_O ⟶ S_k) [AlgebraicGeometry.LocallyOfFiniteType p_W]
      (m : Ideal ↑R_O) (hm : m.IsMaximal),
      ∃ σ : S_k ⟶ AlgebraicGeometry.Spec R_O,
        σ ≫ p_W = 𝟙 S_k ∧ σ.base pt_k = (⟨m, hm.isPrime⟩ : PrimeSpectrum ↑R_O) := by
    intro R_O p_W _ m hm_max
    have : m.IsMaximal := hm_max
    let φ_k : CommRingCat.of k ⟶ R_O := AlgebraicGeometry.Spec.preimage p_W
    have hφ_map : AlgebraicGeometry.Spec.map φ_k = p_W :=
      AlgebraicGeometry.Spec.map_preimage p_W
    have hFT_hom : RingHom.FiniteType φ_k.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp (hφ_map.symm ▸ inferInstance)
    let _ : Algebra k ↑R_O := φ_k.hom.toAlgebra
    have hFT_alg : Algebra.FiniteType k ↑R_O := hFT_hom
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_mv.toRingHom m
    have : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_mv.toRingHom hq_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp inferInstance
    have hker_eval : ∀ f ∈ RingHom.ker q_mv.toRingHom,
        (MvPolynomial.aeval a_pt).toRingHom f = 0 := by
      intro f hf
      have hmem_mv : f ∈ m_mv := by
        change q_mv.toRingHom f ∈ m
        rw [RingHom.mem_ker.mp hf]
        exact m.zero_mem
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem_mv
      exact hmem_mv
    let σ_R : ↑R_O →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_mv.toRingHom)
        (MvPolynomial.aeval a_pt).toRingHom hker_eval).comp
        (RingHom.quotientKerEquivOfSurjective hq_surj).symm.toRingHom
    have hσ_q : ∀ f : MvPolynomial (Fin n_mv) k, σ_R (q_mv f) = MvPolynomial.aeval a_pt f := by
      intro f
      change (Ideal.Quotient.lift (RingHom.ker q_mv.toRingHom)
        (MvPolynomial.aeval a_pt).toRingHom hker_eval)
        ((RingHom.quotientKerEquivOfSurjective hq_surj).symm (q_mv.toRingHom f)) = _
      have h_symm : (RingHom.quotientKerEquivOfSurjective hq_surj).symm (q_mv.toRingHom f) =
          Ideal.Quotient.mk (RingHom.ker q_mv.toRingHom) f := by
        apply (RingHom.quotientKerEquivOfSurjective hq_surj).injective
        rw [RingEquiv.apply_symm_apply]
        rfl
      rw [h_symm]
      rfl
    have hφ_σ : φ_k ≫ CommRingCat.ofHom σ_R = 𝟙 (CommRingCat.of k) := by
      apply CommRingCat.hom_ext
      ext c
      change σ_R (algebraMap k (↑R_O) c) = algebraMap k k c
      rw [← q_mv.commutes c, hσ_q (algebraMap k _ c), (MvPolynomial.aeval a_pt).commutes c]
    have hcomap_σ : Ideal.comap σ_R ⊥ = m := by
      ext r
      obtain ⟨f, rfl⟩ := hq_surj r
      change σ_R (q_mv f) ∈ (⊥ : Ideal k) ↔ q_mv f ∈ m
      rw [Ideal.mem_bot, hσ_q f, ← MvPolynomial.mem_vanishingIdeal_singleton_iff, ← ha_pt]
      rfl
    let σ : S_k ⟶ AlgebraicGeometry.Spec R_O :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_R)
    refine ⟨σ, ?_, ?_⟩
    · dsimp [σ]
      rw [← hφ_map, ← AlgebraicGeometry.Spec.map_comp, hφ_σ, AlgebraicGeometry.Spec.map_id]
    · apply PrimeSpectrum.ext
      exact hcomap_σ

  have hGen_Tk : ∀ (U : S_k.Etale) (R : CategoryTheory.Sieve U),
      (∀ (τ : Quiver.Hom T_k U), R.arrows τ) → R ∈ J_k U := by
    intro U R hArrows
    have heq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S_k (le_refl P_et)
    refine (iff_of_eq (congrArg (fun J => R ∈ J U) heq)).mpr ?_
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) (S := S_k) U R).mpr ?_
    intro x
    obtain ⟨O, hAff, hx_O, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    let R_O : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op O)
    have hx_range : x ∈ Set.range hAff.fromSpec.base := by
      rw [hAff.range_fromSpec]
      exact hx_O
    obtain ⟨p, hp_x⟩ := hx_range
    let p_W : AlgebraicGeometry.Spec R_O ⟶ S_k := hAff.fromSpec ≫ U.hom
    have : AlgebraicGeometry.Etale U.hom := U.prop
    have : AlgebraicGeometry.Etale p_W := inferInstance
    obtain ⟨m, hm_max, hm_le⟩ := Ideal.exists_le_maximal p.asIdeal p.isPrime.ne_top
    obtain ⟨σ, hσ_pW, hσ_pt⟩ := exists_k_section_of_maximal R_O p_W m hm_max
    have hEt_σ : AlgebraicGeometry.Etale σ := by
      have hEt_comp : AlgebraicGeometry.Etale (σ ≫ p_W) := by
        rw [hσ_pW]
        infer_instance
      exact CategoryTheory.MorphismProperty.of_postcomp
        (W' := P_et) P_et σ p_W inferInstance hEt_comp
    have : AlgebraicGeometry.Etale σ := hEt_σ
    have hOpen_σ : IsOpen (Set.range σ.base) := σ.isOpenMap.isOpen_range
    let q_pt : PrimeSpectrum ↑R_O := ⟨m, hm_max.isPrime⟩
    have hq_mem_cl : q_pt ∈ closure ({(p : ↥(AlgebraicGeometry.Spec R_O))} : Set _) :=
      (PrimeSpectrum.le_iff_mem_closure p q_pt).mp hm_le
    have hq_mem_rng : q_pt ∈ Set.range σ.base := ⟨pt_k, hσ_pt⟩
    obtain ⟨w_pt, ⟨z_pt, hz_pt⟩, h_in_sing⟩ :=
      mem_closure_iff.mp hq_mem_cl (Set.range σ.base) hOpen_σ hq_mem_rng
    have hp_eq : σ.base pt_k = p :=
      (congrArg σ.base (@Subsingleton.elim ↥S_k hSub_Sk pt_k z_pt)).trans
        (hz_pt.trans (Set.mem_singleton_iff.mp h_in_sing))
    let s_U : S_k ⟶ U.left := σ ≫ hAff.fromSpec
    have hs_U_hom : s_U ≫ U.hom = T_k.hom :=
      (CategoryTheory.Category.assoc σ hAff.fromSpec U.hom).trans hσ_pW
    have hs_U_et : AlgebraicGeometry.Etale s_U := inferInstance
    let τ_x : T_k ⟶ U :=
      CategoryTheory.MorphismProperty.Over.homMk s_U hs_U_hom trivial
    refine ⟨T_k, τ_x, pt_k, hArrows τ_x, hs_U_et, ?_⟩
    change hAff.fromSpec.base (σ.base pt_k) = x
    exact (congrArg hAff.fromSpec.base hp_eq).trans hp_x

  let R_pre : AddCommGrpCat.{u} → CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u} :=
    fun M =>
      { obj := fun W => AddCommGrpCat.of ((T_k ⟶ Opposite.unop W) → ↥M)
        map := fun f => AddCommGrpCat.ofHom
          { toFun := fun g τ => g (τ ≫ f.unop)
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        map_id := fun _ =>
          AddCommGrpCat.ext fun g => funext fun τ =>
            congrArg g (CategoryTheory.Category.comp_id τ)
        map_comp := fun f₁ f₂ =>
          AddCommGrpCat.ext fun g => funext fun τ =>
            congrArg g (CategoryTheory.Category.assoc τ f₂.unop f₁.unop).symm }
  have hR_sheaf : ∀ M : AddCommGrpCat.{u},
      CategoryTheory.Presheaf.IsSheaf J_k (R_pre M) := by
    intro M A₀ U S hS x hx
    have hτ : ∀ τ : T_k ⟶ U, S.arrows τ := by
      intro τ
      have hp : S.pullback τ = ⊤ := hTop_Tk (S.pullback τ)
        (J_k.pullback_stable τ hS)
      have hid : (S.pullback τ).arrows (𝟙 T_k) := by rw [hp]; trivial
      simpa [CategoryTheory.Category.id_comp] using hid
    let s_amalg : A₀ ⟶ (R_pre M).obj (Opposite.op U) :=
      AddCommGrpCat.ofHom
        { toFun := fun a τ => (x τ (hτ τ)).hom a (𝟙 T_k)
          map_zero' := by
            ext τ
            exact map_zero ((x τ (hτ τ)).hom) ▸ rfl
          map_add' := fun a b => by
            ext τ
            exact congrFun (map_add (x τ (hτ τ)).hom a b) (𝟙 T_k) }
    refine ⟨s_amalg, ?_, ?_⟩
    · intro V f hf
      refine AddCommGrpCat.ext fun a => funext fun ρ => ?_
      have hc := hx (𝟙 T_k) ρ (hτ (ρ ≫ f)) hf (CategoryTheory.Category.id_comp (ρ ≫ f))
      have hc_a := congrFun (ConcreteCategory.congr_hom hc a) (𝟙 T_k)
      simpa [s_amalg, R_pre, CategoryTheory.Category.id_comp] using hc_a
    · intro s' hs'
      refine AddCommGrpCat.ext fun a => funext fun τ => ?_
      have h1 := congrFun (ConcreteCategory.congr_hom (hs' τ (hτ τ)) a) (𝟙 T_k)
      simpa [s_amalg, R_pre, CategoryTheory.Category.id_comp] using h1
  let R_sh : AddCommGrpCat.{u} → CategoryTheory.Sheaf J_k AddCommGrpCat.{u} :=
    fun M => ⟨R_pre M, hR_sheaf M⟩

  let liftPre : ∀ (Q : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u})
      (M : AddCommGrpCat.{u}), (Q.obj (Opposite.op T_k) ⟶ M) → (Q ⟶ R_pre M) :=
    fun Q M f =>
      { app := fun W => AddCommGrpCat.ofHom
          { toFun := fun q τ => f.hom ((Q.map τ.op).hom q)
            map_zero' := by ext τ; simp
            map_add' := fun _ _ => by ext τ; simp }
        naturality := fun {W₁ W₂} u => by
          ext q τ
          change f.hom ((Q.map τ.op).hom ((Q.map u).hom q)) =
            f.hom ((Q.map (τ ≫ u.unop).op).hom q)
          have hop : (τ ≫ u.unop).op = u ≫ τ.op := rfl
          rw [hop, Q.map_comp]
          rfl }
  let evPre : ∀ (Q : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u})
      (M : AddCommGrpCat.{u}), (Q ⟶ R_pre M) → (Q.obj (Opposite.op T_k) ⟶ M) :=
    fun _ _ β => AddCommGrpCat.ofHom
      { toFun := fun q => (β.app (Opposite.op T_k)).hom q (𝟙 T_k)
        map_zero' := by
          change (β.app (Opposite.op T_k)).hom 0 (𝟙 T_k) = 0
          rw [map_zero]; rfl
        map_add' := fun q₁ q₂ => congrFun (map_add (β.app (Opposite.op T_k)).hom q₁ q₂) (𝟙 T_k) }
  have evPre_liftPre : ∀ (Q : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u})
      (M : AddCommGrpCat.{u}) (f : Q.obj (Opposite.op T_k) ⟶ M),
      evPre Q M (liftPre Q M f) = f := by
    intro Q M f
    ext q
    change f.hom ((Q.map (𝟙 T_k).op).hom q) = f.hom q
    have hop : (𝟙 T_k).op = 𝟙 (Opposite.op T_k) := rfl
    rw [hop, Q.map_id]; rfl
  have liftPre_evPre : ∀ (Q : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u})
      (M : AddCommGrpCat.{u}) (β : Q ⟶ R_pre M),
      liftPre Q M (evPre Q M β) = β := by
    intro Q M β
    ext W q τ
    have hnat := congrFun (ConcreteCategory.congr_hom (β.naturality τ.op) q) (𝟙 T_k)
    change (β.app (Opposite.op T_k)).hom ((Q.map τ.op).hom q) (𝟙 T_k) =
      (β.app W).hom q (𝟙 T_k ≫ τ) at hnat
    exact hnat.trans (congrArg ((β.app W).hom q) (CategoryTheory.Category.id_comp τ))

  have hHomZero : ∀ {B₁ B₂ : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}}
      (φ : B₁ ⟶ B₂), φ.hom.app (Opposite.op T_k) = 0 → φ = 0 := by
    intro B₁ B₂ φ h0
    apply CategoryTheory.Sheaf.hom_ext
    ext U_op s
    let U : S_k.Etale := Opposite.unop U_op
    let y : ↥(B₂.obj.obj (Opposite.op U)) := (φ.hom.app (Opposite.op U)).hom s
    change y = 0
    let R_y : CategoryTheory.Sieve U :=
      { arrows := fun _ u => (B₂.obj.map u.op).hom y = 0
        downward_closed := by
          intro V W u hu g
          have hop : (g ≫ u).op = u.op ≫ g.op := rfl
          rw [hop, B₂.obj.map_comp]
          change (B₂.obj.map g.op).hom ((B₂.obj.map u.op).hom y) = 0
          rw [hu, map_zero] }
    have hRy : R_y ∈ J_k U := by
      apply hGen_Tk U R_y
      intro τ
      change (B₂.obj.map τ.op).hom ((φ.hom.app (Opposite.op U)).hom s) = 0
      have hnat := ConcreteCategory.congr_hom (φ.hom.naturality τ.op) s
      change (φ.hom.app (Opposite.op T_k)).hom ((B₁.obj.map τ.op).hom s) =
        (B₂.obj.map τ.op).hom ((φ.hom.app (Opposite.op U)).hom s) at hnat
      rw [← hnat, h0]; rfl
    exact B₂.isSeparated U R_y hRy y 0 (fun _ u hu => by
      change (B₂.obj.map u.op).hom y = (B₂.obj.map u.op).hom 0
      rw [map_zero]
      exact hu)

  have hZeroSpec : ∀ (B : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}),
      Subsingleton ↥(B.obj.obj (Opposite.op T_k)) → CategoryTheory.Limits.IsZero B := by
    intro B hSub
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply hHomZero
    exact AddCommGrpCat.ext fun x => hSub.elim x 0

  have hEpiSurj : ∀ {A₁ A₂ : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}}
      (α : A₁ ⟶ A₂) [CategoryTheory.Epi α],
      Function.Surjective ((α.hom.app (Opposite.op T_k)).hom) := by
    intro A₁ A₂ α _
    rw [← AddCommGrpCat.epi_iff_surjective]
    refine ⟨fun {M} g₁ g₂ hg => ?_⟩
    let u₁ : A₂ ⟶ R_sh M := ⟨liftPre A₂.obj M g₁⟩
    let u₂ : A₂ ⟶ R_sh M := ⟨liftPre A₂.obj M g₂⟩
    have hcomp_lift : ∀ g : A₂.obj.obj (Opposite.op T_k) ⟶ M,
        α.hom ≫ liftPre A₂.obj M g = liftPre A₁.obj M (α.hom.app (Opposite.op T_k) ≫ g) := by
      intro g
      ext W q τ
      have hnat := ConcreteCategory.congr_hom (α.hom.naturality τ.op) q
      change g.hom ((A₂.obj.map τ.op).hom ((α.hom.app W).hom q)) =
        g.hom ((α.hom.app (Opposite.op T_k)).hom ((A₁.obj.map τ.op).hom q))
      exact congrArg g.hom hnat.symm
    have hu_eq : u₁ = u₂ := by
      apply (cancel_epi α).mp
      apply CategoryTheory.Sheaf.hom_ext
      change α.hom ≫ liftPre A₂.obj M g₁ = α.hom ≫ liftPre A₂.obj M g₂
      rw [hcomp_lift g₁, hcomp_lift g₂, hg]
    calc
      g₁ = evPre A₂.obj M u₁.hom := (evPre_liftPre A₂.obj M g₁).symm
      _ = evPre A₂.obj M u₂.hom := by rw [hu_eq]
      _ = g₂ := evPre_liftPre A₂.obj M g₂

  have hMonoSpec : ∀ {B₁ B₂ : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}}
      (φ : B₁ ⟶ B₂),
      Function.Injective ((φ.hom.app (Opposite.op T_k)).hom) → CategoryTheory.Mono φ := by
    intro B₁ B₂ φ hInj
    have : CategoryTheory.Mono (φ.hom.app (Opposite.op T_k)) :=
      (AddCommGrpCat.mono_iff_injective _).mpr hInj
    refine ⟨fun {B₀} w₁ w₂ hw => ?_⟩
    have hd_comp : (w₁ - w₂) ≫ φ = 0 := by rw [Preadditive.sub_comp, hw, sub_self]
    have hd_app : (w₁ - w₂).hom.app (Opposite.op T_k) = 0 := by
      apply (cancel_mono (φ.hom.app (Opposite.op T_k))).mp
      rw [CategoryTheory.Limits.zero_comp]
      exact congrArg (fun m : B₀ ⟶ B₂ => m.hom.app (Opposite.op T_k)) hd_comp
    exact sub_eq_zero.mp (hHomZero (w₁ - w₂) hd_app)

  have hEpiSpec : ∀ {B₁ B₂ : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}}
      (φ : B₁ ⟶ B₂),
      Function.Surjective ((φ.hom.app (Opposite.op T_k)).hom) → CategoryTheory.Epi φ := by
    intro B₁ B₂ φ hSurj
    have : CategoryTheory.Epi (φ.hom.app (Opposite.op T_k)) :=
      (AddCommGrpCat.epi_iff_surjective _).mpr hSurj
    refine ⟨fun {B₃} v₁ v₂ hv => ?_⟩
    have hd_comp : φ ≫ (v₁ - v₂) = 0 := by rw [Preadditive.comp_sub, hv, sub_self]
    have hd_app : (v₁ - v₂).hom.app (Opposite.op T_k) = 0 := by
      apply (cancel_epi (φ.hom.app (Opposite.op T_k))).mp
      rw [CategoryTheory.Limits.comp_zero]
      exact congrArg (fun m : B₁ ⟶ B₃ => m.hom.app (Opposite.op T_k)) hd_comp
    exact sub_eq_zero.mp (hHomZero (v₁ - v₂) hd_app)

  have hIsoSpec : ∀ {B₁ B₂ : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}}
      (φ : B₁ ⟶ B₂),
      Function.Bijective ((φ.hom.app (Opposite.op T_k)).hom) → CategoryTheory.IsIso φ := by
    intro B₁ B₂ φ ⟨hInj, hSurj⟩
    have : CategoryTheory.Mono φ := hMonoSpec φ hInj
    have : CategoryTheory.Epi φ := hEpiSpec φ hSurj
    exact CategoryTheory.isIso_of_mono_of_epi φ

  
  have hStalkColim : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (z : S_k ⟶ Z)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      let B_z := B_of z
      let pb_z := pb_of z
      let adj_z := adj_of z
      (∀ (x : ↥((pb_z.obj F).obj.obj (Opposite.op T_k))),
        ∃ (W : Z.Etale) (τ_W : Quiver.Hom T_k (B_z.obj W)) (s : ↥(F.obj.obj (Opposite.op W))),
          ((pb_z.obj F).obj.map τ_W.op).hom
            (((adj_z.unit.app F).hom.app (Opposite.op W)).hom s) = x) ∧
      (∀ (W : Z.Etale) (τ_W : Quiver.Hom T_k (B_z.obj W)) (s : ↥(F.obj.obj (Opposite.op W))),
        ((pb_z.obj F).obj.map τ_W.op).hom
          (((adj_z.unit.app F).hom.app (Opposite.op W)).hom s) = 0 →
        ∃ (W' : Z.Etale) (g : Quiver.Hom W' W) (τ_W' : Quiver.Hom T_k (B_z.obj W')),
          CategoryTheory.CategoryStruct.comp τ_W' (B_z.map g) = τ_W ∧
          (F.obj.map g.op).hom s = 0) := by
    intro Z z F B_z pb_z adj_z
    let F_z : CategoryTheory.Functor Z.Etale (Type u) :=
      B_z.comp (CategoryTheory.coyoneda.obj (Opposite.op T_k))
    have hCof_z : CategoryTheory.IsCofiltered F_z.Elements := by
      have _ : CategoryTheory.Limits.HasTerminal Z.Etale := (hTerm_of Z).hasTerminal
      have _ : CategoryTheory.Limits.HasFiniteLimits Z.Etale :=
        CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
      have _ : CategoryTheory.Limits.PreservesFiniteLimits B_z :=
        CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback P_et z
      have _ : CategoryTheory.Limits.PreservesFiniteLimits F_z :=
        CategoryTheory.Limits.comp_preservesFiniteLimits B_z
          (CategoryTheory.coyoneda.obj (Opposite.op T_k))
      exact CategoryTheory.Functor.isCofiltered_elements F_z
    have hJoint_z : ∀ {W : Z.Etale}, ∀ R ∈ Z.smallEtaleTopology W, ∀ (σ : F_z.obj W),
        ∃ (V : Z.Etale) (f : Quiver.Hom V W) (_ : R.arrows f) (τ : F_z.obj V),
          F_z.map f τ = σ := by
      intro W R hR σ
      have heq :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          Z (le_refl P_et)
      have hmem := (iff_of_eq (congrArg (fun J => R ∈ J W) heq)).mp hR
      let α : S_k ⟶ W.left := σ.left ≫ CategoryTheory.Limits.pullback.fst W.hom z
      have hσ_snd : σ.left ≫ CategoryTheory.Limits.pullback.snd W.hom z = 𝟙 S_k :=
        CategoryTheory.MorphismProperty.Over.w σ
      have hα_W : α ≫ W.hom = z :=
        (CategoryTheory.Category.assoc σ.left
          (CategoryTheory.Limits.pullback.fst W.hom z) W.hom).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp σ.left)
            (CategoryTheory.Limits.pullback.condition (f := W.hom) (g := z))).trans
            ((CategoryTheory.Category.assoc σ.left
              (CategoryTheory.Limits.pullback.snd W.hom z) z).symm.trans
              ((congrArg (fun m => m ≫ z) hσ_snd).trans
                (CategoryTheory.Category.id_comp z))))
      obtain ⟨V, f, v₀, hfR, hfEt, hfv₀⟩ :=
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) (S := Z) W R).mp hmem (α.base pt_k)
      have : AlgebraicGeometry.Etale f.left := hfEt
      let Q := CategoryTheory.Limits.pullback α f.left
      let fst_Q : Q ⟶ S_k := CategoryTheory.Limits.pullback.fst α f.left
      have hSurj_Q : Function.Surjective fst_Q.base := by
        obtain ⟨q₀, hq₀_fst, -⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback pt_k v₀ hfv₀.symm
        exact fun x => ⟨q₀, hq₀_fst.trans (@Subsingleton.elim ↥S_k hSub_Sk pt_k x)⟩
      obtain ⟨s_Q, hs_Q⟩ := hSplit Q fst_Q inferInstance hSurj_Q
      let β : S_k ⟶ V.left := s_Q ≫ CategoryTheory.Limits.pullback.snd α f.left
      have hβ_f : β ≫ f.left = α :=
        (CategoryTheory.Category.assoc s_Q
          (CategoryTheory.Limits.pullback.snd α f.left) f.left).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp s_Q)
            (CategoryTheory.Limits.pullback.condition (f := α) (g := f.left)).symm).trans
            ((CategoryTheory.Category.assoc s_Q fst_Q α).symm.trans
              ((congrArg (fun m => m ≫ α) hs_Q).trans
                (CategoryTheory.Category.id_comp α))))
      have hβ_V : β ≫ V.hom = z :=
        (congrArg (CategoryTheory.CategoryStruct.comp β)
          (CategoryTheory.MorphismProperty.Over.w f).symm).trans
          ((CategoryTheory.Category.assoc β f.left W.hom).symm.trans
            ((congrArg (fun m => m ≫ W.hom) hβ_f).trans hα_W))
      let τ_left : S_k ⟶ (B_z.obj V).left :=
        CategoryTheory.Limits.pullback.lift β (𝟙 S_k)
          (hβ_V.trans (CategoryTheory.Category.id_comp z).symm)
      let τ : F_z.obj V :=
        CategoryTheory.MorphismProperty.Over.homMk τ_left
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
      have h_left : τ_left ≫ (B_z.map f).left = σ.left := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · have hmap_fst : (B_z.map f).left ≫ CategoryTheory.Limits.pullback.fst W.hom z =
              CategoryTheory.Limits.pullback.fst V.hom z ≫ f.left :=
            (congrArg (fun m => m ≫ CategoryTheory.Limits.pullback.fst W.hom z)
              (CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ z f)).trans
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          exact (CategoryTheory.Category.assoc τ_left _ _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp τ_left) hmap_fst).trans
              ((CategoryTheory.Category.assoc τ_left _ _).symm.trans
                ((congrArg (fun m => m ≫ f.left)
                  (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans hβ_f)))
        · have hmap_snd : (B_z.map f).left ≫ CategoryTheory.Limits.pullback.snd W.hom z =
              CategoryTheory.Limits.pullback.snd V.hom z :=
            (congrArg (fun m => m ≫ CategoryTheory.Limits.pullback.snd W.hom z)
              (CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ z f)).trans
              (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          exact (CategoryTheory.Category.assoc τ_left _ _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp τ_left) hmap_snd).trans
              ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans hσ_snd.symm))
      exact ⟨V, f, hfR, τ,
        CategoryTheory.MorphismProperty.Comma.Hom.ext h_left (Subsingleton.elim _ _)⟩
    have hInit_z : CategoryTheory.InitiallySmall.{u} F_z.Elements := by
      have : CategoryTheory.IsCofiltered F_z.Elements := hCof_z
      let G_aff := AlgebraicGeometry.Scheme.AffineEtale.Spec Z
      let e_sm := CategoryTheory.equivSmallModel.{u} Z.AffineEtale
      let ι_Z := e_sm.inverse.comp G_aff
      let idxFn : (Σ m : CategoryTheory.SmallModel.{u} Z.AffineEtale, F_z.obj (ι_Z.obj m)) →
          F_z.Elements :=
        fun p => CategoryTheory.Functor.elementsMk F_z (ι_Z.obj p.1) p.2
      refine CategoryTheory.initiallySmall_of_small_weakly_initial_set (Set.range idxFn) ?_
      intro x
      have hCov : CategoryTheory.Sieve.coverByImage G_aff x.1 ∈ Z.smallEtaleTopology x.1 :=
        CategoryTheory.Functor.IsCoverDense.is_cover (G := G_aff) x.1
      obtain ⟨V, f, hf, τ, hτ_eq⟩ := hJoint_z _ hCov x.2
      rcases hf with ⟨s_cov⟩
      let A := s_cov.obj
      let m : CategoryTheory.SmallModel.{u} Z.AffineEtale := e_sm.functor.obj A
      let u_A : G_aff.obj A ⟶ ι_Z.obj m := G_aff.map (e_sm.unitIso.hom.app A)
      let v_A : ι_Z.obj m ⟶ G_aff.obj A := G_aff.map (e_sm.unitIso.inv.app A)
      have huv_A : u_A ≫ v_A = 𝟙 (G_aff.obj A) := by
        dsimp [u_A, v_A]
        rw [← G_aff.map_comp, e_sm.unitIso.hom_inv_id_app A]
        exact G_aff.map_id A
      let τ_m : F_z.obj (ι_Z.obj m) := F_z.map (s_cov.lift ≫ u_A) τ
      let k_m : ι_Z.obj m ⟶ x.1 := v_A ≫ s_cov.map
      have hk_eq : (s_cov.lift ≫ u_A) ≫ k_m = f := by
        dsimp [k_m]
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc u_A v_A s_cov.map,
          huv_A, CategoryTheory.Category.id_comp]
        exact s_cov.fac
      have hmap_km : F_z.map k_m τ_m = x.2 := by
        change (τ ≫ B_z.map (s_cov.lift ≫ u_A)) ≫ B_z.map k_m = x.2
        rw [CategoryTheory.Category.assoc, ← B_z.map_comp, hk_eq]
        exact hτ_eq
      exact ⟨idxFn ⟨m, τ_m⟩, ⟨⟨m, τ_m⟩, rfl⟩,
        ⟨CategoryTheory.Functor.Elements.homMk
          (x := idxFn ⟨m, τ_m⟩) (y := x) k_m hmap_km⟩⟩
    let Φ_z : CategoryTheory.GrothendieckTopology.Point.{u} Z.smallEtaleTopology :=
      { fiber := F_z
        isCofiltered := hCof_z
        initiallySmall := hInit_z
        jointly_surjective := @hJoint_z }
    let pf_z := pf_of z
    let A_stalk : AddCommGrpCat.{u} := (pb_z.obj F).obj.obj (Opposite.op T_k)
    let B_fib : AddCommGrpCat.{u} := Φ_z.presheafFiber.obj F.obj
    let c_leg : ∀ (W : Z.Etale), Φ_z.fiber.obj W → (F.obj.obj (Opposite.op W) ⟶ A_stalk) :=
      fun W τ_W => (adj_z.unit.app F).hom.app (Opposite.op W) ≫ (pb_z.obj F).obj.map τ_W.op
    have hc_compat : ∀ ⦃W' W : Z.Etale⦄ (g : W' ⟶ W) (τ_W' : Φ_z.fiber.obj W'),
        F.obj.map g.op ≫ c_leg W' τ_W' = c_leg W (Φ_z.fiber.map g τ_W') := by
      intro W' W g τ_W'
      have h1 : F.obj.map g.op ≫
          ((adj_z.unit.app F).hom.app (Opposite.op W') ≫
            (pb_z.obj F).obj.map τ_W'.op) =
          (F.obj.map g.op ≫ (adj_z.unit.app F).hom.app (Opposite.op W')) ≫
            (pb_z.obj F).obj.map τ_W'.op :=
        (CategoryTheory.Category.assoc _ _ _).symm
      have h2 : F.obj.map g.op ≫ (adj_z.unit.app F).hom.app (Opposite.op W') =
          (adj_z.unit.app F).hom.app (Opposite.op W) ≫
            (pb_z.obj F).obj.map (B_z.map g).op :=
        (adj_z.unit.app F).hom.naturality g.op
      have h3 : (pb_z.obj F).obj.map (B_z.map g).op ≫
          (pb_z.obj F).obj.map τ_W'.op =
          (pb_z.obj F).obj.map (τ_W' ≫ B_z.map g).op :=
        ((pb_z.obj F).obj.map_comp (B_z.map g).op τ_W'.op).symm
      exact h1.trans ((congrArg (fun m => m ≫ (pb_z.obj F).obj.map τ_W'.op) h2).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          (congrArg (CategoryTheory.CategoryStruct.comp
            ((adj_z.unit.app F).hom.app (Opposite.op W))) h3)))
    let ψ_BA : B_fib ⟶ A_stalk := Φ_z.presheafFiberDesc c_leg hc_compat
    have hBij_ψ : ∀ M : AddCommGrpCat.{u}, Function.Bijective (fun f : A_stalk ⟶ M => ψ_BA ≫ f) := by
      intro M
      let E₁ : (A_stalk ⟶ M) ≃ (pb_z.obj F ⟶ R_sh M) :=
        { toFun := fun f => ⟨liftPre (pb_z.obj F).obj M f⟩
          invFun := fun u => evPre (pb_z.obj F).obj M u.hom
          left_inv := fun f => evPre_liftPre (pb_z.obj F).obj M f
          right_inv := fun u =>
            CategoryTheory.Sheaf.hom_ext (liftPre_evPre (pb_z.obj F).obj M u.hom) }
      let E₂ : (pb_z.obj F ⟶ R_sh M) ≃ (F ⟶ pf_z.obj (R_sh M)) :=
        adj_z.homEquiv F (R_sh M)
      let d_leg : (F ⟶ pf_z.obj (R_sh M)) →
          ∀ (W : Z.Etale), Φ_z.fiber.obj W → (F.obj.obj (Opposite.op W) ⟶ M) :=
        fun η W τ_W => AddCommGrpCat.ofHom
          { toFun := fun s => (η.hom.app (Opposite.op W)).hom s τ_W
            map_zero' := by
              change (η.hom.app (Opposite.op W)).hom 0 τ_W = 0
              rw [map_zero]; rfl
            map_add' := fun s₁ s₂ =>
              congrFun (map_add (η.hom.app (Opposite.op W)).hom s₁ s₂) τ_W }
      have hd_compat : ∀ (η : F ⟶ pf_z.obj (R_sh M)) ⦃W' W : Z.Etale⦄
          (g : W' ⟶ W) (τ_W' : Φ_z.fiber.obj W'),
          F.obj.map g.op ≫ d_leg η W' τ_W' = d_leg η W (Φ_z.fiber.map g τ_W') := by
        intro η W' W g τ_W'
        ext s
        exact congrFun (ConcreteCategory.congr_hom (η.hom.naturality g.op) s) τ_W'
      let E₃ : (F ⟶ pf_z.obj (R_sh M)) ≃ (B_fib ⟶ M) :=
        { toFun := fun η => Φ_z.presheafFiberDesc (d_leg η) (hd_compat η)
          invFun := fun k =>
            ⟨{ app := fun W => AddCommGrpCat.ofHom
                 { toFun := fun s τ_W =>
                     k.hom ((Φ_z.toPresheafFiber (Opposite.unop W) τ_W F.obj).hom s)
                   map_zero' := by ext τ_W; simp
                   map_add' := fun _ _ => by ext τ_W; simp }
               naturality := fun {W₁ W₂} g =>
                 AddCommGrpCat.ext fun s => funext fun τ_W => by
                   change k.hom ((Φ_z.toPresheafFiber (Opposite.unop W₂) τ_W F.obj).hom
                       ((F.obj.map g).hom s)) =
                     k.hom ((Φ_z.toPresheafFiber (Opposite.unop W₁)
                       (Φ_z.fiber.map g.unop τ_W) F.obj).hom s)
                   congr 1
                   simpa using Φ_z.toPresheafFiber_w_apply g.unop τ_W F.obj s }⟩
          left_inv := fun η => by
            apply CategoryTheory.Sheaf.hom_ext
            refine CategoryTheory.NatTrans.ext (funext fun W =>
              AddCommGrpCat.ext fun s => funext fun τ_W => ?_)
            have hdesc := Φ_z.toPresheafFiber_presheafFiberDesc
              (d_leg η) (hd_compat η) (Opposite.unop W) τ_W
            exact ConcreteCategory.congr_hom hdesc s
          right_inv := fun k => by
            apply Φ_z.presheafFiber_hom_ext
            intro W τ_W
            let η_k : F ⟶ pf_z.obj (R_sh M) :=
              ⟨{ app := fun W₀ => AddCommGrpCat.ofHom
                   { toFun := fun s τ₀ =>
                       k.hom ((Φ_z.toPresheafFiber (Opposite.unop W₀) τ₀ F.obj).hom s)
                     map_zero' := by ext τ₀; simp
                     map_add' := fun _ _ => by ext τ₀; simp }
                 naturality := fun {W₁ W₂} g =>
                   AddCommGrpCat.ext fun s => funext fun τ₀ => by
                     change k.hom ((Φ_z.toPresheafFiber (Opposite.unop W₂) τ₀ F.obj).hom
                         ((F.obj.map g).hom s)) =
                       k.hom ((Φ_z.toPresheafFiber (Opposite.unop W₁)
                         (Φ_z.fiber.map g.unop τ₀) F.obj).hom s)
                     congr 1
                     simpa using Φ_z.toPresheafFiber_w_apply g.unop τ₀ F.obj s }⟩
            exact Φ_z.toPresheafFiber_presheafFiberDesc (d_leg η_k) (hd_compat η_k) W τ_W }
      have hComp_eq : (fun f : A_stalk ⟶ M => ψ_BA ≫ f) = E₃ ∘ E₂ ∘ E₁ := by
        funext f
        symm
        apply Φ_z.presheafFiber_hom_ext
        intro W τ_W
        have hLHS := Φ_z.toPresheafFiber_presheafFiberDesc
          (d_leg (E₂ (E₁ f))) (hd_compat (E₂ (E₁ f))) W τ_W
        have hRHS : Φ_z.toPresheafFiber W τ_W F.obj ≫ (ψ_BA ≫ f) = c_leg W τ_W ≫ f :=
          (CategoryTheory.Category.assoc _ _ _).symm.trans
            (congrArg (fun m => m ≫ f)
              (Φ_z.toPresheafFiber_presheafFiberDesc c_leg hc_compat W τ_W))
        refine hLHS.trans (Eq.trans ?_ hRHS.symm)
        ext s
        have hE₂ : E₂ (E₁ f) = adj_z.unit.app F ≫ pf_z.map (E₁ f) := by
          dsimp [E₂]
          rw [CategoryTheory.Adjunction.homEquiv_unit]
        change ((E₂ (E₁ f)).hom.app (Opposite.op W)).hom s τ_W = (c_leg W τ_W ≫ f).hom s
        rw [hE₂]
        rfl
      rw [hComp_eq]
      exact E₃.bijective.comp (E₂.bijective.comp E₁.bijective)
    obtain ⟨φ_AB, h_bf⟩ := (hBij_ψ B_fib).2 (𝟙 B_fib)
    dsimp only at h_bf
    have h_fb : φ_AB ≫ ψ_BA = 𝟙 A_stalk := by
      apply (hBij_ψ A_stalk).1
      dsimp only
      rw [← CategoryTheory.Category.assoc, h_bf, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.comp_id]
    have := AddCommGrpCat.FilteredColimits.forget_preservesFilteredColimits.{u}
    refine ⟨?_, ?_⟩
    · intro x
      obtain ⟨W, τ_W, s, hs⟩ := Φ_z.toPresheafFiber_jointly_surjective (P := F.obj) (φ_AB.hom x)
      refine ⟨W, τ_W, s, ?_⟩
      have h1 := congrArg ψ_BA.hom hs
      have hdesc := ConcreteCategory.congr_hom
        (Φ_z.toPresheafFiber_presheafFiberDesc c_leg hc_compat W τ_W) s
      have hfb_x := ConcreteCategory.congr_hom h_fb x
      exact hdesc.symm.trans (h1.trans hfb_x)
    · intro W τ_W s h0
      have hdesc_s := ConcreteCategory.congr_hom
        (Φ_z.toPresheafFiber_presheafFiberDesc c_leg hc_compat W τ_W) s
      have hψ_s : ψ_BA.hom ((Φ_z.toPresheafFiber W τ_W F.obj).hom s) = 0 :=
        hdesc_s.trans h0
      have h_eq0 : (Φ_z.toPresheafFiber W τ_W F.obj).hom s =
          (Φ_z.toPresheafFiber W τ_W F.obj).hom 0 := by
        have h2 := congrArg φ_AB.hom hψ_s
        have hbf_s := ConcreteCategory.congr_hom h_bf ((Φ_z.toPresheafFiber W τ_W F.obj).hom s)
        rw [map_zero] at h2 ⊢
        exact hbf_s.symm.trans h2
      obtain ⟨W', g, τ_W', hτ_eq, hs_eq⟩ :=
        (Φ_z.toPresheafFiber_eq_iff' W τ_W s 0).mp h_eq0
      exact ⟨W', g, τ_W', hτ_eq, hs_eq.trans (map_zero _)⟩

  
  have hPbMonoInj : ∀ (z : S_k ⟶ Y.left)
      {F₁ F₂ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
      (m : F₁ ⟶ F₂) [CategoryTheory.Mono m],
      Function.Injective (((pb_of z).map m).hom.app (Opposite.op T_k)).hom := by
    intro z F₁ F₂ m _
    refine (injective_iff_map_eq_zero _).mpr fun x hx => ?_
    obtain ⟨W, τ_W, s, hs⟩ := (hStalkColim Y.left z F₁).1 x
    have hnat_u := ConcreteCategory.congr_hom
      (congrArg (fun k : F₁ ⟶ (pf_of z).obj ((pb_of z).obj F₂) => k.hom.app (Opposite.op W))
        ((adj_of z).unit.naturality m)) s
    change (((adj_of z).unit.app F₂).hom.app (Opposite.op W)).hom ((m.hom.app (Opposite.op W)).hom s) =
      (((pb_of z).map m).hom.app (Opposite.op ((B_of z).obj W))).hom
        ((((adj_of z).unit.app F₁).hom.app (Opposite.op W)).hom s) at hnat_u
    have hnat_τ := (ConcreteCategory.congr_hom
      (((pb_of z).map m).hom.naturality τ_W.op)
      ((((adj_of z).unit.app F₁).hom.app (Opposite.op W)).hom s)).symm
    change (((pb_of z).obj F₂).obj.map τ_W.op).hom
        ((((pb_of z).map m).hom.app (Opposite.op ((B_of z).obj W))).hom
          ((((adj_of z).unit.app F₁).hom.app (Opposite.op W)).hom s)) =
      (((pb_of z).map m).hom.app (Opposite.op T_k)).hom
        ((((pb_of z).obj F₁).obj.map τ_W.op).hom
          ((((adj_of z).unit.app F₁).hom.app (Opposite.op W)).hom s)) at hnat_τ
    have hzero_F₂ : (((pb_of z).obj F₂).obj.map τ_W.op).hom
        ((((adj_of z).unit.app F₂).hom.app (Opposite.op W)).hom
          ((m.hom.app (Opposite.op W)).hom s)) = 0 := by
      rw [hnat_u, hnat_τ, hs, hx]
    obtain ⟨W', g, τ_W', hτ_eq, hg_zero⟩ :=
      (hStalkColim Y.left z F₂).2 W τ_W ((m.hom.app (Opposite.op W)).hom s) hzero_F₂
    have hm_nat := ConcreteCategory.congr_hom (m.hom.naturality g.op) s
    change (m.hom.app (Opposite.op W')).hom ((F₁.obj.map g.op).hom s) =
      (F₂.obj.map g.op).hom ((m.hom.app (Opposite.op W)).hom s) at hm_nat
    have : CategoryTheory.Mono (m.hom) :=
      (CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u}).map_mono m
    have : CategoryTheory.Mono (m.hom.app (Opposite.op W')) :=
      ((CategoryTheory.evaluation (Opposite Y.left.Etale) AddCommGrpCat.{u}).obj
        (Opposite.op W')).map_mono m.hom
    have hm_inj : Function.Injective ((m.hom.app (Opposite.op W')).hom) :=
      (AddCommGrpCat.mono_iff_injective _).mp inferInstance
    have hs_g0 : (F₁.obj.map g.op).hom s = 0 :=
      hm_inj ((hm_nat.trans hg_zero).trans (map_zero _).symm)
    have hunit_g := ConcreteCategory.congr_hom
      (((adj_of z).unit.app F₁).hom.naturality g.op) s
    have hu0 : ((((adj_of z).unit.app F₁).hom.app (Opposite.op W')).hom
        ((F₁.obj.map g.op).hom s)) = 0 := by
      rw [hs_g0]
      exact map_zero _
    have hstep : ((((pb_of z).obj F₁).obj.map ((B_of z).map g).op).hom
        ((((adj_of z).unit.app F₁).hom.app (Opposite.op W)).hom s)) = 0 :=
      hunit_g.symm.trans hu0
    rw [← hs, ← hτ_eq, CategoryTheory.op_comp, ((pb_of z).obj F₁).obj.map_comp]
    change (((pb_of z).obj F₁).obj.map τ_W'.op).hom
      ((((pb_of z).obj F₁).obj.map ((B_of z).map g).op).hom
        ((((adj_of z).unit.app F₁).hom.app (Opposite.op W)).hom s)) = 0
    rw [hstep, map_zero]

  have hSubOfIsZero : ∀ {X₀ : AlgebraicGeometry.Scheme.{u}}
