    have hσ_fst : σ_bar ≫ pr_Y = g_k ≫ σ := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hσ_snd : σ_bar ≫ Y_bar.hom = 𝟙 _ := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hOuter : CategoryTheory.IsPullback (σ_bar ≫ Y_bar.hom) g_k g_k (σ ≫ Y.hom) := by
      rw [hσ_snd, hσ]
      exact CategoryTheory.IsPullback.of_horiz_isIso
        ⟨by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]⟩
    have hpb_σ : CategoryTheory.IsPullback σ_bar g_k pr_Y σ :=
      CategoryTheory.IsPullback.of_right hOuter hσ_fst
        (CategoryTheory.IsPullback.of_hasPullback Y.hom g_k).flip
    refine ⟨σ_bar, hσ_fst, hσ_snd, hpb_σ, fun y => ⟨?_, ?_⟩⟩
    · rintro ⟨pt, hpt⟩
      obtain ⟨z, hz, _⟩ := AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_σ y pt hpt.symm
      exact ⟨z, hz⟩
    · rintro ⟨z, rfl⟩
      have hcomm : pr_Y.base (σ_bar.base z) = σ.base (g_k.base z) := by
        change (σ_bar ≫ pr_Y).base z = (g_k ≫ σ).base z
        rw [hσ_fst]
      exact ⟨g_k.base z, hcomm.symm⟩

  have hx_sec : x_s ≫ Z_tilde.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)) := by
