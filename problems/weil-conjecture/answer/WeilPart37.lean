        (CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K (2 * d₀)).hom
          (weilAffineSpaceOver K 1).hom ≫ (weilAffineSpaceOver K (2 * d₀)).hom)
    let pr1_aff_K : P_aff_K ⟶ weilAffineSpaceOver K (2 * d₀) :=
