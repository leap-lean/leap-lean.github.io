      have h_mono : CategoryTheory.Mono (i_W.inv ≫ W_b.ι) := by
        rw [hAffW.isoSpec_inv_ι]; infer_instance
      rw [← CategoryTheory.cancel_mono (i_W.inv ≫ W_b.ι), CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc i_W.hom, i_W.hom_inv_id, CategoryTheory.Category.id_comp,
        hq₁_ι]
      symm
      change (hAff₁.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁.toRingHom)) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ≫ i_W.inv ≫ W_b.ι = _
      have hcomp_C : CommRingCat.ofHom Polynomial.C ≫ CommRingCat.ofHom ψ₁.toRingHom =
          p_Q.appLE W_b U₁ hU₁_W := by
        apply CommRingCat.hom_ext; apply RingHom.ext; exact hψ₁_C
      dsimp only [i_W]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁.toRingHom)),
        ← AlgebraicGeometry.Spec.map_comp, hcomp_C, hAff₁.isoSpec_hom,
        ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE p_Q W_b U₁ hU₁_W,
        CategoryTheory.Category.assoc, ← hAffW.isoSpec_hom,
        ← CategoryTheory.Category.assoc hAffW.isoSpec.hom, hAffW.isoSpec.hom_inv_id,
        CategoryTheory.Category.id_comp,
        AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
    have hBasic₀ : (TopologicalSpace.Opens.map U₀.ι.base).obj U₁ =
        (TopologicalSpace.Opens.map j_0.hom.base).obj
          (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial R)) := by
      have h_u01 : (TopologicalSpace.Opens.map U₀.ι.base).obj U₁ =
          (TopologicalSpace.Opens.map U₀.ι.base).obj (U₀ ⊓ U₁) := by
        ext u
        have hu0 : U₀.ι.base u ∈ (U₀ : Set Z_t) := by
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι]; exact ⟨u, rfl⟩
        exact ⟨fun hu => ⟨hu0, hu⟩, fun hu => hu.2⟩
      rw [h_u01, hOv₀]
      have hpre_inv : (TopologicalSpace.Opens.map (j_0.inv ≫ U₀.ι).base).obj
          (Z_t.basicOpen (ψ₀ Polynomial.X)) =
          PrimeSpectrum.basicOpen (Polynomial.X : Polynomial R) := by
        have hj0_inv : j_0.inv ≫ U₀.ι =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.symm.toRingHom) ≫ hAff₀.fromSpec := by
          change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.symm.toRingHom) ≫
            hAff₀.isoSpec.inv) ≫ U₀.ι = _
          rw [CategoryTheory.Category.assoc, hAff₀.isoSpec_inv_ι]
        rw [hj0_inv]
        change (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.symm.toRingHom)).base).obj
          (hAff₀.fromSpec ⁻¹ᵁ Z_t.basicOpen (ψ₀ Polynomial.X)) = _
        rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, hAff₀.basicOpen_fromSpec_app,
          AlgebraicGeometry.SpecMap_preimage_basicOpen]
        congr 1
        exact ψ₀.symm_apply_apply Polynomial.X
      ext u
      have hu_eq : j_0.inv.base (j_0.hom.base u) = u := by
        change (j_0.hom ≫ j_0.inv).base u = u; rw [j_0.hom_inv_id]; rfl
      have hiff := SetLike.ext_iff.mp hpre_inv (j_0.hom.base u)
      change U₀.ι.base (j_0.inv.base (j_0.hom.base u)) ∈ Z_t.basicOpen (ψ₀ Polynomial.X) ↔
        j_0.hom.base u ∈ PrimeSpectrum.basicOpen (Polynomial.X : Polynomial R) at hiff
