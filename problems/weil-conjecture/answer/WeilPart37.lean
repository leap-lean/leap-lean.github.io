      have hW₂_le : W₂ ≤ D_raw α := inf_le_left
      have hPre₁ : (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hX α) zero_lt_one).base).obj W₁ =
          PrimeSpectrum.basicOpen m_el := by
        rw [hAwayEq α]
        change (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map isoA.inv).base).obj
          ((hAff α).fromSpec ⁻¹ᵁ P_sch.basicOpen (ρ_raw α α')) = _
        rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, (hAff α).basicOpen_fromSpec_app,
          AlgebraicGeometry.SpecMap_preimage_basicOpen]
        congr 1
        have hρ_eq : ρ_raw α α' = isoA.hom.hom m_el := by
          rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
        rw [hρ_eq]
        exact congrArg
          (fun f : CommRingCat.of (HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α)) ⟶
              CommRingCat.of (HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α)) => f.hom m_el)
          isoA.hom_inv_id
      have hPre₂ : (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hX α) zero_lt_one).base).obj W₂ =
          PrimeSpectrum.basicOpen m_el := by
        have hPreD : (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hX α) zero_lt_one).base).obj (D_raw α) = ⊤ := by
          rw [eq_top_iff]
          intro p _
          rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
          exact (isoS.inv.base p).2
        change (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hX α) zero_lt_one).base).obj (D_raw α) ⊓
          (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hX α) zero_lt_one).base).obj (D_raw α') = _
        rw [hPreD, top_inf_eq,
          AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_N (hX α) zero_lt_one (hX α') zero_lt_one,
          ← hm_eq]
      ext x
      by_cases hx : x ∈ D_raw α
      · let p := isoS.hom.base ⟨x, hx⟩
        have hp_base : (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hX α) zero_lt_one).base p = x := by
          rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
          change (D_raw α).ι.base ((isoS.hom ≫ isoS.inv).base ⟨x, hx⟩) = x
          rw [isoS.hom_inv_id]; rfl
        have hiff : p ∈ (TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hX α) zero_lt_one).base).obj W₂ ↔
            p ∈ (TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hX α) zero_lt_one).base).obj W₁ := by
          rw [hPre₁, hPre₂]
        change (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hX α) zero_lt_one).base p ∈ W₂ ↔
          (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hX α) zero_lt_one).base p ∈ W₁ at hiff
        rwa [hp_base] at hiff
      · exact ⟨fun hx₂ => absurd (hW₂_le hx₂) hx, fun hx₁ => absurd (hW₁_le hx₁) hx⟩
    refine ⟨hCov, hAff, hDiag, hOverlap, hBasicOv, fun α => ?_⟩
    let P_free := MvPolynomial (Fin N) K
    let ev_α : A →+* P_free :=
      MvPolynomial.eval₂Hom MvPolynomial.C (Fin.insertNth (α := fun _ => P_free) α 1 MvPolynomial.X)
    have hev_Xα : ev_α (MvPolynomial.X α) = 1 := by
      dsimp [ev_α]; rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same]
    have hev_succ : ∀ i : Fin N, ev_α (MvPolynomial.X (α.succAbove i)) = MvPolynomial.X i := by
      intro i; dsimp [ev_α]; rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]
    have hu_ev : IsUnit (ev_α (MvPolynomial.X α)) := by rw [hev_Xα]; exact isUnit_one
    let lift_α : Localization (Submonoid.powers (MvPolynomial.X α : A)) →+* P_free :=
      IsLocalization.Away.lift (MvPolynomial.X α) hu_ev
    let val_α : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α) →+*
        Localization (Submonoid.powers (MvPolynomial.X α : A)) :=
      algebraMap _ _
    let φ_α : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α) →+* P_free := lift_α.comp val_α
    let c_α : K →+* HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α) :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜_N
        (Submonoid.powers (MvPolynomial.X α : A))).comp (algebraMap K ↥(𝒜_N 0))
    let t_α : Fin N → HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α) :=
      fun i => HomogeneousLocalization.Away.mk 𝒜_N (hX α) 1
        (MvPolynomial.X (α.succAbove i)) (hX (α.succAbove i))
    let ψ_α : P_free →+* HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α) :=
      MvPolynomial.eval₂Hom c_α t_α
    have hval_c : ∀ c : K,
        val_α (c_α c) =
          algebraMap A (Localization (Submonoid.powers (MvPolynomial.X α : A)))
            (MvPolynomial.C c) := by
      intro c
      rw [HomogeneousLocalization.algebraMap_apply]
      dsimp [c_α]
      have hfz : (HomogeneousLocalization.fromZeroRingHom 𝒜_N
          (Submonoid.powers (MvPolynomial.X α : A)) (algebraMap K ↥(𝒜_N 0) c)).val =
        algebraMap A (Localization (Submonoid.powers (MvPolynomial.X α : A)))
          (algebraMap K ↥(𝒜_N 0) c).1 := rfl
      rw [hfz, halg0_val]
    have hφ_mk : ∀ (n : ℕ) (F : A) (hF : F ∈ 𝒜_N (n • 1)),
        φ_α (HomogeneousLocalization.Away.mk 𝒜_N (hX α) n F hF) = ev_α F := by
      intro n F hF
      change lift_α (HomogeneousLocalization.val
        (HomogeneousLocalization.Away.mk 𝒜_N (hX α) n F hF)) = ev_α F
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
      dsimp [lift_α, IsLocalization.Away.lift]
      rw [IsLocalization.lift_mk'_spec]
      change ev_α F = ev_α (MvPolynomial.X α ^ n) * ev_α F
      rw [map_pow, hev_Xα, one_pow, one_mul]
    have hφψ : φ_α.comp ψ_α = RingHom.id P_free := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext; intro c
        simp only [RingHom.comp_apply, ψ_α, MvPolynomial.eval₂Hom_C]
        change lift_α (val_α (c_α c)) = MvPolynomial.C c
        rw [hval_c, IsLocalization.Away.lift_eq]
        exact MvPolynomial.eval₂Hom_C _ _ _
      · intro i
        simp only [RingHom.comp_apply, ψ_α, MvPolynomial.eval₂Hom_X']
        rw [hφ_mk 1 (MvPolynomial.X (α.succAbove i)) (hX (α.succAbove i)), hev_succ i]; rfl
    have hψφ : ψ_α.comp φ_α =
        RingHom.id (HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α)) := by
      apply RingHom.ext; intro z
      rw [RingHom.comp_apply, RingHom.id_apply]
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_N (hX α) z
      rw [hφ_mk n a ha, HomogeneousLocalization.ext_iff_val]
      let L_α := Localization (Submonoid.powers (MvPolynomial.X α : A))
      let u_α : L_α := algebraMap A L_α (MvPolynomial.X α)
      have hu_α : IsUnit (u_α ^ n) :=
        (IsLocalization.Away.algebraMap_isUnit (MvPolynomial.X α)).pow n
      apply hu_α.mul_left_cancel
      have hrhs : u_α ^ n * (HomogeneousLocalization.Away.mk 𝒜_N (hX α) n a ha).val =
          algebraMap A L_α a := by
        rw [mul_comm, HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
        let s_n : Submonoid.powers (MvPolynomial.X α : A) :=
          ⟨MvPolynomial.X α ^ n, (Submonoid.powers (MvPolynomial.X α : A)).pow_mem
            (Submonoid.mem_powers _) n⟩
        have hpow : u_α ^ n = algebraMap A L_α s_n.1 := (map_pow _ _ n).symm
        rw [hpow]; exact IsLocalization.mk'_spec L_α a s_n
      have ht_mul : ∀ i : Fin N,
          u_α * val_α (t_α i) = algebraMap A L_α (MvPolynomial.X (α.succAbove i)) := by
        intro i
        rw [mul_comm, HomogeneousLocalization.algebraMap_apply]
        dsimp [t_α]
        rw [Localization.mk_eq_mk']
        let s_1 : Submonoid.powers (MvPolynomial.X α : A) :=
          ⟨MvPolynomial.X α ^ 1, (Submonoid.powers (MvPolynomial.X α : A)).pow_mem
            (Submonoid.mem_powers _) 1⟩
        have h1 : u_α = algebraMap A L_α s_1.1 := by dsimp [u_α, s_1]; rw [pow_one]
        rw [h1]; exact IsLocalization.mk'_spec L_α (MvPolynomial.X (α.succAbove i)) s_1
      have hlhs : u_α ^ n * (ψ_α (ev_α a)).val = algebraMap A L_α a := by
        rw [← HomogeneousLocalization.algebraMap_apply]
        change u_α ^ n * val_α (ψ_α (ev_α a)) = algebraMap A L_α a
        have ha_hom : MvPolynomial.IsHomogeneous a n := by
          have ha' : a ∈ 𝒜_N n := by simpa using ha
          exact (MvPolynomial.mem_homogeneousSubmodule n a).mp ha'
        conv_lhs => rw [MvPolynomial.as_sum a]
        conv_rhs => rw [MvPolynomial.as_sum a]
        rw [map_sum, map_sum, map_sum, Finset.mul_sum, map_sum]
        refine Finset.sum_congr rfl fun v hv => ?_
        have hv_ne := MvPolynomial.mem_support_iff.mp hv
        have hv_deg : v α + ∑ i : Fin N, v (α.succAbove i) = n := by
          have hdeg := ha_hom hv_ne
          dsimp [Finsupp.weight, LinearMap.toAddMonoidHom] at hdeg
          have hsum : (Finsupp.linearCombination ℕ (1 : Fin (N + 1) → ℕ) v) =
              ∑ k : Fin (N + 1), v k := by
            rw [Finsupp.linearCombination_apply, Finsupp.sum_fintype]
            · simp
            · intro; simp
          rw [hsum, Fin.sum_univ_succAbove v α] at hdeg
          exact hdeg
        have hmon : ∀ c : K, MvPolynomial.monomial v c =
            MvPolynomial.C c * MvPolynomial.X α ^ v α *
              ∏ i : Fin N, MvPolynomial.X (α.succAbove i) ^ v (α.succAbove i) := by
          intro c
          rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype]
          · rw [Fin.prod_univ_succAbove _ α, ← mul_assoc]
          · intro; exact pow_zero _
        rw [hmon (a.coeff v), ev_α.map_mul, ev_α.map_mul, ev_α.map_pow, hev_Xα,
          one_pow, mul_one, map_prod]
        have hev_C : ev_α (MvPolynomial.C (a.coeff v)) = MvPolynomial.C (a.coeff v) :=
          MvPolynomial.eval₂Hom_C _ _ _
        have hev_prod :
            (∏ i : Fin N, ev_α (MvPolynomial.X (α.succAbove i) ^ v (α.succAbove i))) =
            ∏ i : Fin N, MvPolynomial.X i ^ v (α.succAbove i) := by
          refine Finset.prod_congr rfl fun i _ => ?_
          rw [map_pow, hev_succ i]
        rw [hev_C, hev_prod, map_mul, map_prod]
        have hψ_C : ψ_α (MvPolynomial.C (a.coeff v)) = c_α (a.coeff v) :=
          MvPolynomial.eval₂Hom_C _ _ _
        have hψ_prod :
            (∏ i : Fin N, ψ_α (MvPolynomial.X i ^ v (α.succAbove i))) =
            ∏ i : Fin N, t_α i ^ v (α.succAbove i) := by
          refine Finset.prod_congr rfl fun i _ => ?_
          rw [map_pow]; dsimp [ψ_α]; rw [MvPolynomial.eval₂Hom_X']
        rw [hψ_C, hψ_prod, map_mul, hval_c, map_prod, ← hv_deg, pow_add,
          ← Finset.prod_pow_eq_pow_sum]
        have hprod_mul :
            (∏ i : Fin N, u_α ^ v (α.succAbove i)) *
              (∏ i : Fin N, val_α (t_α i ^ v (α.succAbove i))) =
            ∏ i : Fin N, algebraMap A L_α (MvPolynomial.X (α.succAbove i)) ^ v (α.succAbove i) := by
          rw [← Finset.prod_mul_distrib]
          refine Finset.prod_congr rfl fun i _ => ?_
          rw [map_pow, ← mul_pow, ht_mul i]
        calc
          (u_α ^ v α * ∏ i : Fin N, u_α ^ v (α.succAbove i)) *
              ((algebraMap A L_α) (MvPolynomial.C (a.coeff v)) *
                ∏ i : Fin N, val_α (t_α i ^ v (α.succAbove i)))
            = (algebraMap A L_α) (MvPolynomial.C (a.coeff v)) * u_α ^ v α *
                ((∏ i : Fin N, u_α ^ v (α.succAbove i)) *
                  ∏ i : Fin N, val_α (t_α i ^ v (α.succAbove i))) := by ring
          _ = (algebraMap A L_α) (MvPolynomial.C (a.coeff v)) *
                (algebraMap A L_α) (MvPolynomial.X α) ^ v α *
                ∏ i : Fin N,
                  (algebraMap A L_α) (MvPolynomial.X (α.succAbove i)) ^ v (α.succAbove i) := by
              rw [hprod_mul]
          _ = (algebraMap A L_α)
                (MvPolynomial.C (a.coeff v) * MvPolynomial.X α ^ v α *
                  ∏ i : Fin N, MvPolynomial.X (α.succAbove i) ^ v (α.succAbove i)) := by
              simp [map_mul, map_pow, map_prod]
      rw [hlhs, hrhs]
    let θ_α : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α) ≃+* P_free :=
      { φ_α with
        invFun := ψ_α
        left_inv := fun z => congrArg (fun f => f z) hψφ
        right_inv := fun p => congrArg (fun f => f p) hφψ }
    refine ⟨θ_α, hφ_mk, ?_, ?_⟩
    · intro c
      have hsymm_C : θ_α.symm (MvPolynomial.C c) = c_α c := MvPolynomial.eval₂Hom_C _ _ _
      let isoA := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α) (hX α) zero_lt_one
      have h_top_le : D_raw α ≤ (TopologicalSpace.Opens.map p_hom.base).obj ⊤ :=
        fun _ _ => trivial
      have hSpec_c : AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hX α) zero_lt_one ≫
          p_hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_α) := by
        dsimp [p_hom]
        rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hSpec_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_α) =
          AlgebraicGeometry.Spec.map
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
              p_hom.appLE ⊤ (D_raw α) h_top_le ≫ isoA.inv) := by
        rw [← hSpec_c, hAwayEq α, CategoryTheory.Category.assoc,
          hFromSpecComp p_hom (hAff α), ← AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Category.assoc]
      have hcat_eq : CommRingCat.ofHom c_α =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
            p_hom.appLE ⊤ (D_raw α) h_top_le ≫ isoA.inv :=
        AlgebraicGeometry.Spec.map_injective hSpec_eq
      have hcat_hom : CommRingCat.ofHom c_α ≫ isoA.hom =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
            p_hom.appLE ⊤ (D_raw α) h_top_le := by
        calc CommRingCat.ofHom c_α ≫ isoA.hom
          _ = ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
                p_hom.appLE ⊤ (D_raw α) h_top_le ≫ isoA.inv) ≫ isoA.hom :=
              congrArg (· ≫ isoA.hom) hcat_eq
          _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
                p_hom.appLE ⊤ (D_raw α) h_top_le := by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                isoA.inv_hom_id, CategoryTheory.Category.comp_id]
      rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom] at hcat_hom
      have h_eval := congrArg (fun f : CommRingCat.of K ⟶
        P_sch.presheaf.obj (Opposite.op (D_raw α)) => f.hom c) hcat_hom
      exact (congrArg (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α)).hom hsymm_C).trans
        h_eval
    · intro i
      have hsymm_X : θ_α.symm (MvPolynomial.X i) = t_α i := MvPolynomial.eval₂Hom_X' _ _ _
      exact congrArg (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α)).hom hsymm_X

  
  have hElimX0 : ∀ {n : ℕ} (q : MvPolynomial (Fin n) K),
      Function.Surjective
        ((Ideal.Quotient.mk (Ideal.span {q})).comp
          ((Polynomial.evalRingHom 0).comp (MvPolynomial.finSuccEquiv K n).toRingHom)) ∧
      RingHom.ker
        ((Ideal.Quotient.mk (Ideal.span {q})).comp
          ((Polynomial.evalRingHom 0).comp (MvPolynomial.finSuccEquiv K n).toRingHom)) =
        Ideal.span {MvPolynomial.X 0, MvPolynomial.rename Fin.succ q} := by
    intro n q
    let e := (MvPolynomial.finSuccEquiv K n).toRingEquiv
    have he_X0 : e (MvPolynomial.X 0) = Polynomial.X :=
      MvPolynomial.finSuccEquiv_X_zero
    have he_ren : ∀ p : MvPolynomial (Fin n) K,
        e (MvPolynomial.rename Fin.succ p) = Polynomial.C p := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C c =>
        rw [MvPolynomial.rename_C]
        change (MvPolynomial.finSuccEquiv K n) (algebraMap K _ c) = _
        rw [(MvPolynomial.finSuccEquiv K n).commutes,
          IsScalarTower.algebraMap_apply K (MvPolynomial (Fin n) K)
            (Polynomial (MvPolynomial (Fin n) K)),
          MvPolynomial.algebraMap_eq, Polynomial.algebraMap_eq]
      | add p₁ p₂ hp₁ hp₂ => rw [map_add, map_add, hp₁, hp₂, Polynomial.C_add]
      | mul_X p₁ i hp₁ =>
        have he_succ : e (MvPolynomial.X i.succ) = Polynomial.C (MvPolynomial.X i) :=
          MvPolynomial.finSuccEquiv_X_succ
        rw [map_mul, MvPolynomial.rename_X, map_mul, hp₁, he_succ, ← Polynomial.C_mul]
    refine ⟨?_, ?_⟩
    · intro x
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
      refine ⟨MvPolynomial.rename Fin.succ p, ?_⟩
      change Ideal.Quotient.mk _ (Polynomial.eval 0 (e (MvPolynomial.rename Fin.succ p))) = _
      rw [he_ren p, Polynomial.eval_C]
    · apply le_antisymm
      · intro P hP
        let Q := e P
        have hmk0 : Ideal.Quotient.mk (Ideal.span {q}) (Polynomial.eval 0 Q) = 0 := hP
        rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hmk0
        obtain ⟨s, hs⟩ := hmk0
        have hdvd : Polynomial.X - Polynomial.C 0 ∣ Q - Polynomial.C (Polynomial.eval 0 Q) :=
          Polynomial.X_sub_C_dvd_sub_C_eval
        rw [map_zero, sub_zero] at hdvd
        obtain ⟨R_poly, hR⟩ := hdvd
        have hQ_eq : Q = Polynomial.X * R_poly + Polynomial.C q * Polynomial.C s := by
          calc Q = (Q - Polynomial.C (Polynomial.eval 0 Q)) +
                Polynomial.C (Polynomial.eval 0 Q) := by ring
            _ = Polynomial.X * R_poly + Polynomial.C (q * s) := by rw [hR, hs]
            _ = Polynomial.X * R_poly + Polynomial.C q * Polynomial.C s := by rw [Polynomial.C_mul]
        have hP_eq : P = MvPolynomial.X 0 * e.symm R_poly +
            MvPolynomial.rename Fin.succ q * e.symm (Polynomial.C s) := by
          apply e.injective
          change Q = _
          rw [map_add, map_mul, map_mul, he_X0, he_ren q, e.apply_symm_apply, e.apply_symm_apply]
          exact hQ_eq
        rw [hP_eq]
        exact Ideal.add_mem _
          (Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert _ _)))
          (Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
      · rw [Ideal.span_le]
        rintro _ (rfl | rfl)
        · change Ideal.Quotient.mk _ (Polynomial.eval 0 (e (MvPolynomial.X 0))) = 0
          rw [he_X0, Polynomial.eval_X, map_zero]
        · change Ideal.Quotient.mk _ (Polynomial.eval 0 (e (MvPolynomial.rename Fin.succ q))) = 0
          rw [he_ren q, Polynomial.eval_C, Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.subset_span rfl

  
  
  
  have hFiberProdTensor : ∀ (Z Q : AlgebraicGeometry.Scheme.{u})
      (f_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
      (f_Q : Q ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
      (U_Z : Z.Opens) (hAffZ : AlgebraicGeometry.IsAffineOpen U_Z)
      (U_Q : Q.Opens) (hAffQ : AlgebraicGeometry.IsAffineOpen U_Q),
      let P := CategoryTheory.Limits.pullback f_Z f_Q
      let pr₁ := CategoryTheory.Limits.pullback.fst f_Z f_Q
      let pr₂ := CategoryTheory.Limits.pullback.snd f_Z f_Q
      let C : P.Opens :=
        (TopologicalSpace.Opens.map pr₁.base).obj U_Z ⊓
          (TopologicalSpace.Opens.map pr₂.base).obj U_Q
      let A := ↑(Z.presheaf.obj (Opposite.op U_Z))
      let R := ↑(Q.presheaf.obj (Opposite.op U_Q))
      letI : Algebra K A :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
          f_Z.appLE ⊤ U_Z le_top).hom).toAlgebra
      letI : Algebra K R :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
          f_Q.appLE ⊤ U_Q le_top).hom).toAlgebra
      AlgebraicGeometry.IsAffineOpen C ∧
      ∃ τ : TensorProduct K A R ≃+* ↑(P.presheaf.obj (Opposite.op C)),
        (∀ a : A, τ (a ⊗ₜ[K] 1) = (pr₁.appLE U_Z C inf_le_left).hom a) ∧
        (∀ r : R, τ (1 ⊗ₜ[K] r) = (pr₂.appLE U_Q C inf_le_right).hom r) := by
    intro Z Q f_Z f_Q U_Z hAffZ U_Q hAffQ P pr₁ pr₂ C A R
    letI : Algebra K A :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
        f_Z.appLE ⊤ U_Z le_top).hom).toAlgebra
    letI : Algebra K R :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
        f_Q.appLE ⊤ U_Q le_top).hom).toAlgebra
    let u₁ : CommRingCat.of K ⟶ Z.presheaf.obj (Opposite.op U_Z) :=
      CommRingCat.ofHom (algebraMap K A)
    let u₂ : CommRingCat.of K ⟶ Q.presheaf.obj (Opposite.op U_Q) :=
      CommRingCat.ofHom (algebraMap K R)
    let T_c := CommRingCat.of (TensorProduct K A R)
    let inl : Z.presheaf.obj (Opposite.op U_Z) ⟶ T_c :=
      CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
    let inr : Q.presheaf.obj (Opposite.op U_Q) ⟶ T_c :=
      CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom
    have hPb_Spec : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map inl) (AlgebraicGeometry.Spec.map inr)
        (AlgebraicGeometry.Spec.map u₁) (AlgebraicGeometry.Spec.map u₂) := by
      have hp0 := CategoryTheory.IsPullback.of_hasPullback
        (AlgebraicGeometry.Spec.map u₁) (AlgebraicGeometry.Spec.map u₂)
      have h_fst : CategoryTheory.Limits.pullback.fst
            (AlgebraicGeometry.Spec.map u₁) (AlgebraicGeometry.Spec.map u₂) =
          (AlgebraicGeometry.pullbackSpecIso K A R).hom ≫ AlgebraicGeometry.Spec.map inl :=
        (CategoryTheory.Iso.hom_inv_id_assoc (AlgebraicGeometry.pullbackSpecIso K A R) _).symm.trans
          (congrArg ((AlgebraicGeometry.pullbackSpecIso K A R).hom ≫ ·)
            (AlgebraicGeometry.pullbackSpecIso_inv_fst K A R))
      have h_snd : CategoryTheory.Limits.pullback.snd
            (AlgebraicGeometry.Spec.map u₁) (AlgebraicGeometry.Spec.map u₂) =
          (AlgebraicGeometry.pullbackSpecIso K A R).hom ≫ AlgebraicGeometry.Spec.map inr :=
        (CategoryTheory.Iso.hom_inv_id_assoc (AlgebraicGeometry.pullbackSpecIso K A R) _).symm.trans
          (congrArg ((AlgebraicGeometry.pullbackSpecIso K A R).hom ≫ ·)
            (AlgebraicGeometry.pullbackSpecIso_inv_snd K A R))
      exact hp0.of_iso (AlgebraicGeometry.pullbackSpecIso K A R)
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (by simpa using h_fst) (by simpa using h_snd) (by simp) (by simp)
    let j₁ : AlgebraicGeometry.Spec (Z.presheaf.obj (Opposite.op U_Z)) ⟶ Z := hAffZ.fromSpec
    let j₂ : AlgebraicGeometry.Spec (Q.presheaf.obj (Opposite.op U_Q)) ⟶ Q := hAffQ.fromSpec
    have hj₁_f : j₁ ≫ f_Z = AlgebraicGeometry.Spec.map u₁ := hFromSpecComp f_Z hAffZ
    have hj₂_f : j₂ ≫ f_Q = AlgebraicGeometry.Spec.map u₂ := hFromSpecComp f_Q hAffQ
    let P₁ := CategoryTheory.Limits.pullback j₁ pr₁
    let q₁A := CategoryTheory.Limits.pullback.fst j₁ pr₁
    let q₁P := CategoryTheory.Limits.pullback.snd j₁ pr₁
    have _ : AlgebraicGeometry.IsOpenImmersion q₁P := inferInstance
    have hp₀ := CategoryTheory.IsPullback.of_hasPullback f_Z f_Q
    have hp₁ := CategoryTheory.IsPullback.of_hasPullback j₁ pr₁
    have hp₀₁_flip : CategoryTheory.IsPullback (q₁P ≫ pr₂) q₁A f_Q (AlgebraicGeometry.Spec.map u₁) := by
      have hp := hp₁.flip.paste_horiz hp₀.flip; rwa [hj₁_f] at hp
    let P₁₂ := CategoryTheory.Limits.pullback j₂ (q₁P ≫ pr₂)
    let q₂R := CategoryTheory.Limits.pullback.fst j₂ (q₁P ≫ pr₂)
    let q₂P₁ := CategoryTheory.Limits.pullback.snd j₂ (q₁P ≫ pr₂)
    have _ : AlgebraicGeometry.IsOpenImmersion q₂P₁ := inferInstance
    have hp₂ := CategoryTheory.IsPullback.of_hasPullback j₂ (q₁P ≫ pr₂)
    have hp₁₂ : CategoryTheory.IsPullback (q₂P₁ ≫ q₁A) q₂R
        (AlgebraicGeometry.Spec.map u₁) (AlgebraicGeometry.Spec.map u₂) := by
      have hp := hp₂.flip.paste_horiz hp₀₁_flip.flip; rwa [hj₂_f] at hp
    let θ : AlgebraicGeometry.Spec T_c ≅ P₁₂ :=
      CategoryTheory.IsPullback.isoIsPullback
        (AlgebraicGeometry.Spec (Z.presheaf.obj (Opposite.op U_Z)))
        (AlgebraicGeometry.Spec (Q.presheaf.obj (Opposite.op U_Q))) hPb_Spec hp₁₂
    have hθ_fst : θ.hom ≫ (q₂P₁ ≫ q₁A) = AlgebraicGeometry.Spec.map inl :=
      CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPb_Spec hp₁₂
    have hθ_snd : θ.hom ≫ q₂R = AlgebraicGeometry.Spec.map inr :=
      CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPb_Spec hp₁₂
    let ψ : AlgebraicGeometry.Spec T_c ⟶ P := θ.hom ≫ q₂P₁ ≫ q₁P
    have _ : AlgebraicGeometry.IsOpenImmersion ψ := inferInstance
    have hψ_pr₁ : ψ ≫ pr₁ = AlgebraicGeometry.Spec.map inl ≫ j₁ := by
      calc (θ.hom ≫ q₂P₁ ≫ q₁P) ≫ pr₁
        _ = θ.hom ≫ q₂P₁ ≫ (q₁P ≫ pr₁) := by simp only [CategoryTheory.Category.assoc]
        _ = θ.hom ≫ q₂P₁ ≫ (q₁A ≫ j₁) := by rw [CategoryTheory.Limits.pullback.condition]
        _ = (θ.hom ≫ (q₂P₁ ≫ q₁A)) ≫ j₁ := by simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map inl ≫ j₁ := by rw [hθ_fst]
    have hψ_pr₂ : ψ ≫ pr₂ = AlgebraicGeometry.Spec.map inr ≫ j₂ := by
      calc (θ.hom ≫ q₂P₁ ≫ q₁P) ≫ pr₂
        _ = θ.hom ≫ (q₂P₁ ≫ (q₁P ≫ pr₂)) := by simp only [CategoryTheory.Category.assoc]
        _ = θ.hom ≫ (q₂R ≫ j₂) := by rw [CategoryTheory.Limits.pullback.condition]
        _ = (θ.hom ≫ q₂R) ≫ j₂ := by simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map inr ≫ j₂ := by rw [hθ_snd]
    have hq₁P_range : Set.range q₁P.base = pr₁.base ⁻¹' (U_Z : Set Z) := by
      have hr := AlgebraicGeometry.IsOpenImmersion.range_pullbackSnd j₁ pr₁
      have hj₁_or : j₁.opensRange = U_Z := TopologicalSpace.Opens.ext hAffZ.range_fromSpec
      rw [hr, hj₁_or]; rfl
    have hq₂P₁_range : Set.range q₂P₁.base = q₁P.base ⁻¹' (pr₂.base ⁻¹' (U_Q : Set Q)) := by
      have hr := AlgebraicGeometry.IsOpenImmersion.range_pullbackSnd j₂ (q₁P ≫ pr₂)
      have hj₂_or : j₂.opensRange = U_Q := TopologicalSpace.Opens.ext hAffQ.range_fromSpec
      rw [hr, hj₂_or]; rfl
    have hψ_range : Set.range ψ.base = (C : Set P) := by
      have hθ_surj : Function.Surjective θ.hom.base := fun pt =>
        ⟨θ.inv.base pt, by change (θ.inv ≫ θ.hom).base pt = pt; rw [θ.inv_hom_id]; rfl⟩
      change Set.range ((q₂P₁ ≫ q₁P).base ∘ θ.hom.base) = _
      rw [Set.range_comp, hθ_surj.range_eq, Set.image_univ]
      change Set.range (q₁P.base ∘ q₂P₁.base) = _
      rw [Set.range_comp, hq₂P₁_range]
      ext q; constructor
      · rintro ⟨q₁, hq₁_mem, rfl⟩
        have hp₁_mem : q₁P.base q₁ ∈ pr₁.base ⁻¹' (U_Z : Set Z) := by
          rw [← hq₁P_range]; exact ⟨q₁, rfl⟩
        exact ⟨hp₁_mem, hq₁_mem⟩
      · rintro ⟨hp₁_mem, hp₂_mem⟩
        change q ∈ pr₁.base ⁻¹' (U_Z : Set Z) at hp₁_mem
        rw [← hq₁P_range] at hp₁_mem
        obtain ⟨q₁, rfl⟩ := hp₁_mem; exact ⟨q₁, hp₂_mem, rfl⟩
    have hOpensRange : ψ.opensRange = C := TopologicalSpace.Opens.ext hψ_range
    have hAffC : AlgebraicGeometry.IsAffineOpen C :=
      hOpensRange ▸ AlgebraicGeometry.isAffineOpen_opensRange ψ
    let R_C := P.presheaf.obj (Opposite.op C)
    have hRangeEqFrom : Set.range ψ.base = Set.range hAffC.fromSpec.base :=
      hψ_range.trans hAffC.range_fromSpec.symm
    let β_C : AlgebraicGeometry.Spec T_c ≅ AlgebraicGeometry.Spec R_C :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq ψ hAffC.fromSpec hRangeEqFrom
    have hβC_fac : β_C.hom ≫ hAffC.fromSpec = ψ :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac ψ hAffC.fromSpec hRangeEqFrom
    let iso_T : T_c ≅ R_C :=
      { hom := AlgebraicGeometry.Spec.preimage β_C.inv
        inv := AlgebraicGeometry.Spec.preimage β_C.hom
        hom_inv_id := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
            AlgebraicGeometry.Spec.map_preimage, β_C.hom_inv_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
            AlgebraicGeometry.Spec.map_preimage, β_C.inv_hom_id, AlgebraicGeometry.Spec.map_id] }
    have hSpec_inv : AlgebraicGeometry.Spec.map iso_T.inv = β_C.hom :=
      AlgebraicGeometry.Spec.map_preimage β_C.hom
    have h_ψ_le : (⊤ : (AlgebraicGeometry.Spec T_c).Opens) ≤
        (TopologicalSpace.Opens.map ψ.base).obj C := by
      intro pt _; change ψ.base pt ∈ (C : Set P); rw [← hψ_range]; exact ⟨pt, rfl⟩
    have h_fromC_le : (⊤ : (AlgebraicGeometry.Spec R_C).Opens) ≤
        (TopologicalSpace.Opens.map hAffC.fromSpec.base).obj C :=
      fun pt _ => (hAffC.isoSpec.inv.base pt).2
    have hψ_app : ψ.appLE C ⊤ h_ψ_le =
        iso_T.inv ≫ (AlgebraicGeometry.Scheme.ΓSpecIso T_c).inv := by
      have h_comp_le : (⊤ : (AlgebraicGeometry.Spec T_c).Opens) ≤
          (TopologicalSpace.Opens.map (β_C.hom ≫ hAffC.fromSpec).base).obj C := by
        rwa [hβC_fac]
      have h1 : ψ.appLE C ⊤ h_ψ_le = (β_C.hom ≫ hAffC.fromSpec).appLE C ⊤ h_comp_le := by
        congr 1; exact hβC_fac.symm
      rw [h1, ← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE β_C.hom hAffC.fromSpec
        C ⊤ ⊤ h_fromC_le le_top]
      change hAffC.fromSpec.appLE C ⊤ h_fromC_le ≫ β_C.hom.appTop = _
      rw [hFromSpecApp hAffC h_fromC_le, ← hSpec_inv,
        ← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality]
    refine ⟨hAffC, iso_T.commRingCatIsoToRingEquiv, ?_, ?_⟩
    · intro a
      have h_lhs_le : (⊤ : (AlgebraicGeometry.Spec T_c).Opens) ≤
          (TopologicalSpace.Opens.map (ψ ≫ pr₁).base).obj U_Z :=
        h_ψ_le.trans ((TopologicalSpace.Opens.map ψ.base).monotone inf_le_left)
      have h_fromZ_le : (⊤ : (AlgebraicGeometry.Spec (Z.presheaf.obj (Opposite.op U_Z))).Opens) ≤
          (TopologicalSpace.Opens.map j₁.base).obj U_Z :=
        fun pt _ => (hAffZ.isoSpec.inv.base pt).2
      have h_rhs_le : (⊤ : (AlgebraicGeometry.Spec T_c).Opens) ≤
          (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map inl ≫ j₁).base).obj U_Z := by
        rwa [← hψ_pr₁]
      have hL : (ψ ≫ pr₁).appLE U_Z ⊤ h_lhs_le =
          pr₁.appLE U_Z C inf_le_left ≫ iso_T.inv ≫ (AlgebraicGeometry.Scheme.ΓSpecIso T_c).inv := by
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ψ pr₁ U_Z C ⊤ inf_le_left h_ψ_le, hψ_app]
      have hR : (AlgebraicGeometry.Spec.map inl ≫ j₁).appLE U_Z ⊤ h_rhs_le =
          inl ≫ (AlgebraicGeometry.Scheme.ΓSpecIso T_c).inv := by
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
          (AlgebraicGeometry.Spec.map inl) j₁ U_Z ⊤ ⊤ h_fromZ_le le_top]
        change j₁.appLE U_Z ⊤ h_fromZ_le ≫ (AlgebraicGeometry.Spec.map inl).appTop = _
        rw [hFromSpecApp hAffZ h_fromZ_le, ← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality]
      have hEqApp : (ψ ≫ pr₁).appLE U_Z ⊤ h_lhs_le =
          (AlgebraicGeometry.Spec.map inl ≫ j₁).appLE U_Z ⊤ h_rhs_le := by congr 1
      rw [hL, hR] at hEqApp
      have hEq1 := congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso T_c).hom ≫ iso_T.hom) hEqApp
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.comp_id, CategoryTheory.Iso.inv_hom_id_assoc] at hEq1
      exact (congrArg (fun f : Z.presheaf.obj (Opposite.op U_Z) ⟶ R_C => f.hom a) hEq1).symm
    · intro r
      have h_lhs_le : (⊤ : (AlgebraicGeometry.Spec T_c).Opens) ≤
          (TopologicalSpace.Opens.map (ψ ≫ pr₂).base).obj U_Q :=
        h_ψ_le.trans ((TopologicalSpace.Opens.map ψ.base).monotone inf_le_right)
      have h_fromQ_le : (⊤ : (AlgebraicGeometry.Spec (Q.presheaf.obj (Opposite.op U_Q))).Opens) ≤
          (TopologicalSpace.Opens.map j₂.base).obj U_Q :=
        fun pt _ => (hAffQ.isoSpec.inv.base pt).2
      have h_rhs_le : (⊤ : (AlgebraicGeometry.Spec T_c).Opens) ≤
          (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map inr ≫ j₂).base).obj U_Q := by
        rwa [← hψ_pr₂]
      have hL : (ψ ≫ pr₂).appLE U_Q ⊤ h_lhs_le =
          pr₂.appLE U_Q C inf_le_right ≫ iso_T.inv ≫ (AlgebraicGeometry.Scheme.ΓSpecIso T_c).inv := by
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ψ pr₂ U_Q C ⊤ inf_le_right h_ψ_le, hψ_app]
      have hR : (AlgebraicGeometry.Spec.map inr ≫ j₂).appLE U_Q ⊤ h_rhs_le =
          inr ≫ (AlgebraicGeometry.Scheme.ΓSpecIso T_c).inv := by
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
          (AlgebraicGeometry.Spec.map inr) j₂ U_Q ⊤ ⊤ h_fromQ_le le_top]
        change j₂.appLE U_Q ⊤ h_fromQ_le ≫ (AlgebraicGeometry.Spec.map inr).appTop = _
        rw [hFromSpecApp hAffQ h_fromQ_le, ← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality]
      have hEqApp : (ψ ≫ pr₂).appLE U_Q ⊤ h_lhs_le =
          (AlgebraicGeometry.Spec.map inr ≫ j₂).appLE U_Q ⊤ h_rhs_le := by congr 1
      rw [hL, hR] at hEqApp
      have hEq1 := congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso T_c).hom ≫ iso_T.hom) hEqApp
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.comp_id, CategoryTheory.Iso.inv_hom_id_assoc] at hEq1
      exact (congrArg (fun f : Q.presheaf.obj (Opposite.op U_Q) ⟶ R_C => f.hom r) hEq1).symm

  
  have hVertexQuotAlg : ∀ (A R : Type u) [CommRing A] [Algebra K A] [CommRing R] [Algebra K R]
      (b : Fin (2 * m + 2)) (ξ₁ : Fin (2 * m + 2) → A) (η_b : Fin (2 * m + 2) → R)
      (F : MvPolynomial (Fin (2 * m + 2)) K)
      (e₁ : (MvPolynomial (Fin (2 * m + 2)) K ⧸ Ideal.span {F}) ≃+* A),
      η_b b = 1 →
      MvPolynomial.aeval (fun a => Polynomial.C (η_b a) * Polynomial.X) F = 0 →
      (∀ c : K, e₁ (Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.C c)) = algebraMap K A c) →
      (∀ a : Fin (2 * m + 2), e₁ (Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X a)) = ξ₁ a) →
      let I₀ : Ideal (TensorProduct K A R) :=
        Ideal.span (Set.range fun ad : Fin (2 * m + 2) × Fin (2 * m + 2) =>
          (ξ₁ ad.1) ⊗ₜ[K] (η_b ad.2) - (ξ₁ ad.2) ⊗ₜ[K] (η_b ad.1))
      ∃ eq₀ : Polynomial R ≃+* (TensorProduct K A R ⧸ I₀),
        (∀ r : R, eq₀ (Polynomial.C r) = Ideal.Quotient.mk I₀ (1 ⊗ₜ[K] r)) ∧
        eq₀ Polynomial.X = Ideal.Quotient.mk I₀ ((ξ₁ b) ⊗ₜ[K] 1) := by
    intro A R _ _ _ _ b ξ₁ η_b F e₁ hη_bb hg_F he₁_C he₁_X I₀
    let g_poly : MvPolynomial (Fin (2 * m + 2)) K →ₐ[K] Polynomial R :=
      MvPolynomial.aeval (fun a => Polynomial.C (η_b a) * Polynomial.X)
    have hg_ker : ∀ x ∈ Ideal.span {F}, g_poly.toRingHom x = 0 := by
      intro x hx
      rw [Ideal.mem_span_singleton] at hx
      obtain ⟨s, rfl⟩ := hx
      change g_poly (F * s) = 0
      rw [map_mul, hg_F, zero_mul]
    let g_quot : (MvPolynomial (Fin (2 * m + 2)) K ⧸ Ideal.span {F}) →+* Polynomial R :=
      Ideal.Quotient.lift (Ideal.span {F}) g_poly.toRingHom hg_ker
    let g_A : A →ₐ[K] Polynomial R :=
      { g_quot.comp e₁.symm.toRingHom with
        commutes' := fun c => by
          change g_quot (e₁.symm (algebraMap K A c)) = algebraMap K (Polynomial R) c
          rw [← he₁_C c, e₁.symm_apply_apply]
          exact g_poly.commutes c }
    have hgA_ξ : ∀ a : Fin (2 * m + 2), g_A (ξ₁ a) = Polynomial.C (η_b a) * Polynomial.X := by
      intro a
      change g_quot (e₁.symm (ξ₁ a)) = _
      rw [← he₁_X a, e₁.symm_apply_apply]
      exact MvPolynomial.aeval_X _ a
    let c_alg : R →ₐ[K] Polynomial R := IsScalarTower.toAlgHom K R (Polynomial R)
    let α₀ : TensorProduct K A R →ₐ[K] Polynomial R :=
      Algebra.TensorProduct.lift g_A c_alg (fun _ _ => Commute.all _ _)
    have hα₀_ker : ∀ z ∈ I₀, α₀.toRingHom z = 0 := by
      intro z hz
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
      · rintro _ ⟨⟨a, d⟩, rfl⟩
        change α₀ ((ξ₁ a) ⊗ₜ[K] (η_b d) - (ξ₁ d) ⊗ₜ[K] (η_b a)) = 0
        dsimp only [α₀]
        rw [map_sub, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul,
          hgA_ξ a, hgA_ξ d]
        change (Polynomial.C (η_b a) * Polynomial.X) * Polynomial.C (η_b d) -
          (Polynomial.C (η_b d) * Polynomial.X) * Polynomial.C (η_b a) = 0
        ring
      · exact map_zero _
      · intro x₁ x₂ _ _ hx₁ hx₂; rw [map_add, hx₁, hx₂, add_zero]
      · intro c x₁ _ hx₁; rw [smul_eq_mul, map_mul, hx₁, mul_zero]
    let α₀_bar : (TensorProduct K A R ⧸ I₀) →+* Polynomial R :=
      Ideal.Quotient.lift I₀ α₀.toRingHom hα₀_ker
    let β₀ : Polynomial R →+* (TensorProduct K A R ⧸ I₀) :=
      Polynomial.eval₂RingHom
        ((Ideal.Quotient.mk I₀).comp Algebra.TensorProduct.includeRight.toRingHom)
        (Ideal.Quotient.mk I₀ ((ξ₁ b) ⊗ₜ[K] 1))
    have hαβ : α₀_bar.comp β₀ = RingHom.id (Polynomial R) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext; intro r
        simp only [RingHom.comp_apply, RingHom.id_apply, β₀, Polynomial.coe_eval₂RingHom,
          Polynomial.eval₂_C]
        change Ideal.Quotient.lift I₀ α₀.toRingHom hα₀_ker (Ideal.Quotient.mk I₀ (1 ⊗ₜ[K] r)) =
          Polynomial.C r
        rw [Ideal.Quotient.lift_mk]
        change (Algebra.TensorProduct.lift g_A c_alg _) (1 ⊗ₜ[K] r) = Polynomial.C r
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        exact Polynomial.algebraMap_apply r
      · simp only [RingHom.comp_apply, RingHom.id_apply, β₀, Polynomial.coe_eval₂RingHom,
          Polynomial.eval₂_X]
        change Ideal.Quotient.lift I₀ α₀.toRingHom hα₀_ker
          (Ideal.Quotient.mk I₀ ((ξ₁ b) ⊗ₜ[K] 1)) = Polynomial.X
        rw [Ideal.Quotient.lift_mk]
        change (Algebra.TensorProduct.lift g_A c_alg _) ((ξ₁ b) ⊗ₜ[K] 1) = Polynomial.X
        rw [Algebra.TensorProduct.lift_tmul, hgA_ξ b, hη_bb, map_one, map_one, one_mul, mul_one]
    have hβα : ∀ q : TensorProduct K A R ⧸ I₀, β₀ (α₀_bar q) = q := by
      intro q
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective q
      change β₀ (α₀ z) = Ideal.Quotient.mk I₀ z
      have h_on_A : ∀ x : A,
          β₀ (α₀ (x ⊗ₜ[K] 1)) = Ideal.Quotient.mk I₀ (x ⊗ₜ[K] 1) := by
        intro x
        obtain ⟨x₀, rfl⟩ := e₁.surjective x
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x₀
        induction P using MvPolynomial.induction_on with
        | C c =>
          rw [he₁_C c]
          have htmul_c : (algebraMap K A c) ⊗ₜ[K] (1 : R) = 1 ⊗ₜ[K] (algebraMap K R c) := by
            rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul,
              ← Algebra.algebraMap_eq_smul_one]
          rw [htmul_c]
          dsimp only [α₀]
          rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          change β₀ (algebraMap R (Polynomial R) (algebraMap K R c)) = _
          rw [Polynomial.algebraMap_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          rfl
        | add p₁ p₂ hp₁ hp₂ =>
          rw [map_add, map_add, TensorProduct.add_tmul, map_add, map_add, hp₁, hp₂, map_add]
        | mul_X p₁ a hp₁ =>
          rw [map_mul, map_mul, he₁_X a]
          have hmul_tmul : (e₁ (Ideal.Quotient.mk (Ideal.span {F}) p₁) * ξ₁ a) ⊗ₜ[K] (1 : R) =
              (e₁ (Ideal.Quotient.mk (Ideal.span {F}) p₁) ⊗ₜ[K] 1) * ((ξ₁ a) ⊗ₜ[K] 1) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
          rw [hmul_tmul, map_mul, map_mul, hp₁, map_mul]
          congr 1
          dsimp only [α₀]
          rw [Algebra.TensorProduct.lift_tmul, hgA_ξ a, map_one, mul_one, map_mul]
          change β₀ (Polynomial.C (η_b a)) * β₀ Polynomial.X = _
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, Polynomial.eval₂_X]
          change Ideal.Quotient.mk I₀ (1 ⊗ₜ[K] η_b a) *
            Ideal.Quotient.mk I₀ ((ξ₁ b) ⊗ₜ[K] 1) = _
          rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
          apply Eq.symm
          rw [Ideal.Quotient.eq]
          have hgen : (ξ₁ a) ⊗ₜ[K] (η_b b) - (ξ₁ b) ⊗ₜ[K] (η_b a) ∈ I₀ :=
            Ideal.subset_span ⟨(a, b), rfl⟩
          rwa [hη_bb] at hgen
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul x r =>
        have hsplit : x ⊗ₜ[K] r = (x ⊗ₜ[K] (1 : R)) * ((1 : A) ⊗ₜ[K] r) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hsplit, map_mul, map_mul, h_on_A x, map_mul]
        congr 1
        dsimp only [α₀]
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        change β₀ (algebraMap R (Polynomial R) r) = _
        rw [Polynomial.algebraMap_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rfl
      | add z₁ z₂ hz₁ hz₂ =>
        rw [map_add, map_add, hz₁, hz₂, map_add]
    refine ⟨{ β₀ with
              invFun := α₀_bar
              left_inv := fun P => congrArg (fun f => f P) hαβ
              right_inv := hβα }, ?_, ?_⟩
    · intro r; exact Polynomial.eval₂_C _ _
    · exact Polynomial.eval₂_X _ _

  have hDiagQuotAlg : ∀ (A R : Type u) [CommRing A] [Algebra K A] [CommRing R] [Algebra K R]
      (b : Fin (2 * m + 2)) (ξ₂ : Fin (2 * m + 2) → A) (s₂ : A) (η_b : Fin (2 * m + 2) → R)
      (e₂ : Polynomial R ≃+* A),
      η_b b = 1 →
      Function.Surjective (MvPolynomial.eval₂Hom (algebraMap K R) η_b) →
      (∀ c : K, e₂ (Polynomial.C (algebraMap K R c)) = algebraMap K A c) →
      (∀ a : Fin (2 * m + 2), e₂ (Polynomial.C (η_b a)) = ξ₂ a) →
      e₂ Polynomial.X = s₂ →
      let I₁ : Ideal (TensorProduct K A R) :=
        Ideal.span (Set.range fun ad : Fin (2 * m + 2) × Fin (2 * m + 2) =>
          (ξ₂ ad.1) ⊗ₜ[K] (η_b ad.2) - (ξ₂ ad.2) ⊗ₜ[K] (η_b ad.1))
      ∃ eq₁ : Polynomial R ≃+* (TensorProduct K A R ⧸ I₁),
        (∀ P : Polynomial R, eq₁ P = Ideal.Quotient.mk I₁ ((e₂ P) ⊗ₜ[K] 1)) ∧
        (∀ r : R, eq₁ (Polynomial.C r) = Ideal.Quotient.mk I₁ (1 ⊗ₜ[K] r)) ∧
        eq₁ Polynomial.X = Ideal.Quotient.mk I₁ (s₂ ⊗ₜ[K] 1) ∧
        (∀ z : A, eq₁ (e₂.symm z) = Ideal.Quotient.mk I₁ (z ⊗ₜ[K] 1)) := by
    intro A R _ _ _ _ b ξ₂ s₂ η_b e₂ hη_bb hSurj he₂_C he₂_ξ he₂_X I₁
    let g_A : A →ₐ[K] Polynomial R :=
      { e₂.symm.toRingHom with
        commutes' := fun c => by
          change e₂.symm (algebraMap K A c) = algebraMap K (Polynomial R) c
          rw [← he₂_C c, e₂.symm_apply_apply,
            IsScalarTower.algebraMap_apply K R (Polynomial R), Polynomial.algebraMap_eq] }
    let c_alg : R →ₐ[K] Polynomial R := IsScalarTower.toAlgHom K R (Polynomial R)
    let α₁ : TensorProduct K A R →ₐ[K] Polynomial R :=
      Algebra.TensorProduct.lift g_A c_alg (fun _ _ => Commute.all _ _)
    have hα₁_ker : ∀ z ∈ I₁, α₁.toRingHom z = 0 := by
      intro z hz
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
      · rintro _ ⟨⟨a, d⟩, rfl⟩
        change α₁ ((ξ₂ a) ⊗ₜ[K] (η_b d) - (ξ₂ d) ⊗ₜ[K] (η_b a)) = 0
        dsimp only [α₁]
        rw [map_sub, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul]
        change e₂.symm (ξ₂ a) * algebraMap R (Polynomial R) (η_b d) -
          e₂.symm (ξ₂ d) * algebraMap R (Polynomial R) (η_b a) = 0
        rw [← he₂_ξ a, ← he₂_ξ d, e₂.symm_apply_apply, e₂.symm_apply_apply,
          Polynomial.algebraMap_eq]
        ring
      · exact map_zero _
      · intro x₁ x₂ _ _ hx₁ hx₂; rw [map_add, hx₁, hx₂, add_zero]
      · intro c x₁ _ hx₁; rw [smul_eq_mul, map_mul, hx₁, mul_zero]
    let α₁_bar : (TensorProduct K A R ⧸ I₁) →+* Polynomial R :=
      Ideal.Quotient.lift I₁ α₁.toRingHom hα₁_ker
    let β₁ : Polynomial R →+* (TensorProduct K A R ⧸ I₁) :=
      ((Ideal.Quotient.mk I₁).comp Algebra.TensorProduct.includeLeftRingHom).comp e₂.toRingHom
    have hBridge : ∀ r : R,
        Ideal.Quotient.mk I₁ ((e₂ (Polynomial.C r)) ⊗ₜ[K] 1) = Ideal.Quotient.mk I₁ (1 ⊗ₜ[K] r) := by
      intro r
      obtain ⟨Q, rfl⟩ := hSurj r
      induction Q using MvPolynomial.induction_on with
      | C c =>
        rw [MvPolynomial.eval₂Hom_C, he₂_C c]
        have htmul_c : (algebraMap K A c) ⊗ₜ[K] (1 : R) = 1 ⊗ₜ[K] (algebraMap K R c) := by
          rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul,
            ← Algebra.algebraMap_eq_smul_one]
        rw [htmul_c]
      | add p₁ p₂ hp₁ hp₂ =>
        rw [map_add, Polynomial.C_add, map_add, TensorProduct.add_tmul, TensorProduct.tmul_add,
          map_add, map_add, hp₁, hp₂]
      | mul_X p₁ a hp₁ =>
        rw [map_mul, MvPolynomial.eval₂Hom_X', Polynomial.C_mul, map_mul]
        have hmul_l : (e₂ (Polynomial.C ((MvPolynomial.eval₂Hom (algebraMap K R) η_b) p₁)) *
              e₂ (Polynomial.C (η_b a))) ⊗ₜ[K] (1 : R) =
            (e₂ (Polynomial.C ((MvPolynomial.eval₂Hom (algebraMap K R) η_b) p₁)) ⊗ₜ[K] 1) *
              (e₂ (Polynomial.C (η_b a)) ⊗ₜ[K] 1) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        have hmul_r : (1 : A) ⊗ₜ[K]
            ((MvPolynomial.eval₂Hom (algebraMap K R) η_b) p₁ * η_b a) =
            (1 ⊗ₜ[K] (MvPolynomial.eval₂Hom (algebraMap K R) η_b) p₁) * (1 ⊗ₜ[K] η_b a) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        rw [hmul_l, hmul_r, map_mul, map_mul, hp₁]
        congr 1
        rw [he₂_ξ a, Ideal.Quotient.eq]
        have hgen : (ξ₂ a) ⊗ₜ[K] (η_b b) - (ξ₂ b) ⊗ₜ[K] (η_b a) ∈ I₁ :=
          Ideal.subset_span ⟨(a, b), rfl⟩
        have hξ_bb : ξ₂ b = 1 := by rw [← he₂_ξ b, hη_bb, Polynomial.C_1, map_one]
        rwa [hη_bb, hξ_bb] at hgen
    have hαβ : ∀ P : Polynomial R, α₁_bar (β₁ P) = P := by
      intro P
      change Ideal.Quotient.lift I₁ α₁.toRingHom hα₁_ker (Ideal.Quotient.mk I₁ ((e₂ P) ⊗ₜ[K] 1)) = P
      rw [Ideal.Quotient.lift_mk]
      change (Algebra.TensorProduct.lift g_A c_alg _) ((e₂ P) ⊗ₜ[K] 1) = P
      rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      exact e₂.symm_apply_apply P
    have hβα : ∀ q : TensorProduct K A R ⧸ I₁, β₁ (α₁_bar q) = q := by
      intro q
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective q
      change β₁ (α₁ z) = Ideal.Quotient.mk I₁ z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul x r =>
        dsimp only [α₁]
        rw [Algebra.TensorProduct.lift_tmul]
        change Ideal.Quotient.mk I₁ ((e₂ (e₂.symm x * algebraMap R (Polynomial R) r)) ⊗ₜ[K] 1) =
          Ideal.Quotient.mk I₁ (x ⊗ₜ[K] r)
        rw [Polynomial.algebraMap_apply, map_mul, e₂.apply_symm_apply]
        have hsplit_l : (x * e₂ (Polynomial.C r)) ⊗ₜ[K] (1 : R) =
            (x ⊗ₜ[K] 1) * (e₂ (Polynomial.C r) ⊗ₜ[K] 1) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        have hsplit_r : x ⊗ₜ[K] r = (x ⊗ₜ[K] 1) * (1 ⊗ₜ[K] r) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        change Ideal.Quotient.mk I₁ ((x * e₂ (Polynomial.C r)) ⊗ₜ[K] 1) =
          Ideal.Quotient.mk I₁ (x ⊗ₜ[K] r)
        rw [hsplit_l, hsplit_r, map_mul, map_mul, hBridge r]
      | add z₁ z₂ hz₁ hz₂ =>
        rw [map_add, map_add, hz₁, hz₂, map_add]
    exact ⟨{ β₁ with
             invFun := α₁_bar
             left_inv := hαβ
             right_inv := hβα },
      fun _ => rfl,
      hBridge,
      by change Ideal.Quotient.mk I₁ ((e₂ Polynomial.X) ⊗ₜ[K] 1) = _; rw [he₂_X],
      fun z => by change Ideal.Quotient.mk I₁ ((e₂ (e₂.symm z)) ⊗ₜ[K] 1) = _; rw [e₂.apply_symm_apply]⟩

  
  
  
  have hAffResIso : ∀ {Z_t Z : AlgebraicGeometry.Scheme.{u}} (π : Z_t ⟶ Z)
      (U_Z : Z.Opens) (hAffU : AlgebraicGeometry.IsAffineOpen U_Z)
      (V : Z_t.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V)
      (h_eq : (TopologicalSpace.Opens.map π.base).obj U_Z = V),
      Function.Bijective (π.appLE U_Z V h_eq.ge).hom →
      CategoryTheory.IsIso (π ∣_ U_Z) := by
    intro Z_t Z π U_Z hAffU V hAffV h_eq hBij
    subst h_eq
    let U_pre : Z_t.Opens := (TopologicalSpace.Opens.map π.base).obj U_Z
    have hAffPre : AlgebraicGeometry.IsAffineOpen U_pre := hAffV
    have hBijApp : Function.Bijective (π.app U_Z).hom := by
      rwa [AlgebraicGeometry.Scheme.Hom.app_eq_appLE π (U := U_Z)]
    let e_ring := RingEquiv.ofBijective (π.app U_Z).hom hBijApp
    let e_cat : Z.presheaf.obj (Opposite.op U_Z) ≅ Z_t.presheaf.obj (Opposite.op U_pre) :=
      e_ring.toCommRingCatIso
    have he_cat_hom : e_cat.hom = π.app U_Z := by
      apply CommRingCat.hom_ext; apply RingHom.ext; intro s; rfl
    have h_res_eq : (π ∣_ U_Z) =
        hAffPre.isoSpec.hom ≫ AlgebraicGeometry.Spec.map e_cat.hom ≫ hAffU.isoSpec.inv := by
      rw [← CategoryTheory.cancel_mono U_Z.ι, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, hAffU.isoSpec_inv_ι,
        AlgebraicGeometry.morphismRestrict_ι, hAffPre.isoSpec_hom, he_cat_hom,
        AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
        ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE π U_Z U_pre (le_refl _),
        CategoryTheory.Category.assoc, ← hAffU.isoSpec_hom,
        ← hAffU.isoSpec_inv_ι, ← CategoryTheory.Category.assoc hAffU.isoSpec.hom,
        hAffU.isoSpec.hom_inv_id, CategoryTheory.Category.id_comp,
        AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
    rw [h_res_eq]
    infer_instance

  have hPolyTorusBridge : ∀ (Z_t : AlgebraicGeometry.Scheme.{u})
      (p_Q : Z_t ⟶ Q_m.left)
      (W_b : Q_m.left.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W_b),
      let R := ↑(Q_m.left.presheaf.obj (Opposite.op W_b))
      letI : Algebra K R :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
          Q_m.hom.appLE ⊤ W_b le_top).hom).toAlgebra
      let i_W : W_b.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of R) := hAffW.isoSpec
      (i_W.inv ≫ W_b.ι ≫ Q_m.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K R))) ∧
      ∀ (U₀ U₁ : Z_t.Opens)
        (hAff₀ : AlgebraicGeometry.IsAffineOpen U₀)
        (hAff₁ : AlgebraicGeometry.IsAffineOpen U₁)
        (hU₀_W : U₀ ≤ (TopologicalSpace.Opens.map p_Q.base).obj W_b)
        (hU₁_W : U₁ ≤ (TopologicalSpace.Opens.map p_Q.base).obj W_b)
        (ψ₀ : Polynomial R ≃+* ↑(Z_t.presheaf.obj (Opposite.op U₀)))
        (ψ₁ : Polynomial R ≃+* ↑(Z_t.presheaf.obj (Opposite.op U₁))),
        (∀ r : R, ψ₀ (Polynomial.C r) = (p_Q.appLE W_b U₀ hU₀_W).hom r) →
        (∀ r : R, ψ₁ (Polynomial.C r) = (p_Q.appLE W_b U₁ hU₁_W).hom r) →
        U₀ ⊓ U₁ = Z_t.basicOpen (ψ₀ Polynomial.X) →
        U₁ ⊓ U₀ = Z_t.basicOpen (ψ₁ Polynomial.X) →
        (Z_t.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op).hom
            (ψ₀ Polynomial.X) *
          (Z_t.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op).hom
            (ψ₁ Polynomial.X) = 1 →
        ∃ (j_0 : U₀.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R)))
          (j_1 : U₁.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R))),
          (∃ (q_0 : U₀.toScheme ⟶ W_b.toScheme) (q_1 : U₁.toScheme ⟶ W_b.toScheme),
            q_0 ≫ W_b.ι = U₀.ι ≫ p_Q ∧
            q_1 ≫ W_b.ι = U₁.ι ≫ p_Q ∧
            q_0 ≫ i_W.hom =
              j_0.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
            q_1 ≫ i_W.hom =
              j_1.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∧
          (TopologicalSpace.Opens.map U₀.ι.base).obj U₁ =
            (TopologicalSpace.Opens.map j_0.hom.base).obj
              (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial R)) ∧
          (TopologicalSpace.Opens.map U₁.ι.base).obj U₀ =
            (TopologicalSpace.Opens.map j_1.hom.base).obj
              (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial R)) ∧
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (algebraMap (Polynomial R)
                  (Localization.Away (Polynomial.X : Polynomial R)))) ≫
            j_0.inv ≫ U₀.ι =
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (Polynomial.eval₂RingHom
                  ((algebraMap (Polynomial R)
                    (Localization.Away (Polynomial.X : Polynomial R))).comp Polynomial.C)
                  (IsLocalization.Away.invSelf
                    (S := Localization.Away (Polynomial.X : Polynomial R))
                    (Polynomial.X : Polynomial R)))) ≫
            j_1.inv ≫ U₁.ι := by
    intro Z_t p_Q W_b hAffW R
    letI : Algebra K R :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
        Q_m.hom.appLE ⊤ W_b le_top).hom).toAlgebra
    let i_W : W_b.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of R) := hAffW.isoSpec
    have hi_W_hom : i_W.inv ≫ W_b.ι ≫ Q_m.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K R)) := by
      rw [← CategoryTheory.Category.assoc, hAffW.isoSpec_inv_ι, hFromSpecComp Q_m.hom hAffW]
      rfl
    refine ⟨hi_W_hom, ?_⟩
    intro U₀ U₁ hAff₀ hAff₁ hU₀_W hU₁_W ψ₀ ψ₁ hψ₀_C hψ₁_C hOv₀ hOv₁ hProd1
    let spec₀ : AlgebraicGeometry.Spec (Z_t.presheaf.obj (Opposite.op U₀)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.symm.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : ψ₀.toRingHom.comp ψ₀.symm.toRingHom = RingHom.id _ :=
            RingHom.ext ψ₀.apply_symm_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : ψ₀.symm.toRingHom.comp ψ₀.toRingHom = RingHom.id _ :=
            RingHom.ext ψ₀.symm_apply_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    let spec₁ : AlgebraicGeometry.Spec (Z_t.presheaf.obj (Opposite.op U₁)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁.symm.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : ψ₁.toRingHom.comp ψ₁.symm.toRingHom = RingHom.id _ :=
            RingHom.ext ψ₁.apply_symm_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : ψ₁.symm.toRingHom.comp ψ₁.toRingHom = RingHom.id _ :=
            RingHom.ext ψ₁.symm_apply_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    let j_0 : U₀.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R)) :=
      hAff₀.isoSpec ≪≫ spec₀
    let j_1 : U₁.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R)) :=
      hAff₁.isoSpec ≪≫ spec₁
    have hRange₀ : Set.range (U₀.ι ≫ p_Q).base ⊆ Set.range W_b.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨u, rfl⟩
      have hu : U₀.ι.base u ∈ (U₀ : Set Z_t) := by
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι]; exact ⟨u, rfl⟩
      exact hU₀_W hu
    have hRange₁ : Set.range (U₁.ι ≫ p_Q).base ⊆ Set.range W_b.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨u, rfl⟩
      have hu : U₁.ι.base u ∈ (U₁ : Set Z_t) := by
