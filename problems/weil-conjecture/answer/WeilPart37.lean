    obtain ⟨f_top, hf_top⟩ := (hFrobModPkg K X).1 (ℓ ^ (r + 1)) (2 * d)
    obtain ⟨f_Zi, hf_Zi⟩ := (hFrobModPkg K Z).1 (ℓ ^ (r + 1)) (2 * d - 2 * c)
    obtain ⟨p_iZ, hp_iZ⟩ := hPullEx i_Z_bar.left (ℓ ^ (r + 1)) (2 * d - 2 * c)

    obtain ⟨iso_frob, hiso_frob⟩ := hFrobInv X
    obtain ⟨p_frob, hp_frob⟩ := hPullEx iso_frob.hom (ℓ ^ (r + 1)) (2 * d - 2 * c)
    obtain ⟨p_frob_inv, hp_frob_inv⟩ := hPullEx iso_frob.inv (ℓ ^ (r + 1)) (2 * d - 2 * c)
    have hp_frob' : WeilIsTorsionEtalePullback (weilGeomFrobHom K X)
