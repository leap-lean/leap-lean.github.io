import WeilPart36
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_sing_dev_odp_sq_section_stalk_and_nbhd_vanish (F : Type u) [Finite F] [Field F]
    (q_deg : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.IsProper (weilProjectiveSpaceOver F 1).hom]
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.IsProper f₀.left]
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (s : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hs_sec : s ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (f_bar : weilBaseChangeOver F (AlgebraicClosure F) Z_tilde ⟶
      weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1))
    [AlgebraicGeometry.IsProper f_bar.left]
    (hPb_fbar : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst Z_tilde.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      f_bar.left f₀.left
      (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hPBC : WeilProperModPrimeBaseChangeHolds (AlgebraicClosure F) ℓ)
    (hCont_pr0 :
      (weilEtaleSitePullback
        (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))).IsContinuous
        (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
        (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology)
    (hAdj_pr0 :
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback
          (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
        AddCommGrpCat.{u} _
        (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
        (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology hCont_pr0).IsRightAdjoint)
    (𝒩_bar : ℕ → CategoryTheory.Sheaf
      (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology AddCommGrpCat.{u})
    (iso_bar0 : ∀ r : ℕ,
      CategoryTheory.Iso
        ((@CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback
            (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
          AddCommGrpCat.{u} _
          (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
          (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
          hCont_pr0 hAdj_pr0).obj (weilSingDevPencilHigherDirectImage F f₀ ℓ q_deg r))
        (𝒩_bar r))
    (frob_E0 : ∀ r : ℕ, (𝒩_bar r).H 0 →+ (𝒩_bar r).H 0)
    (hfrob_E0 : ∀ r : ℕ,
      WeilTransvTriIsGeomBaseSheafAction F (weilProjectiveSpaceOver F 1)
        (weilSingDevPencilHigherDirectImage F f₀ ℓ q_deg r) (𝒩_bar r)
        hCont_pr0 hAdj_pr0 (iso_bar0 r) 0 (frob_E0 r))
    (r : ℕ) :
    let k := AlgebraicClosure F
    let D₀ := weilProjectiveSpaceOver F 1
    let D_bar := weilBaseChangeOver F k D₀
    let g_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    let U_bar : D_bar.left.Opens :=
      (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst D₀.hom g_k).base).obj U₀
    let Z_s : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)) :=
      CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f₀.left s)
    ∃ ev_s : (𝒩_bar r).H 0 →+ weilEtaleTorsionH (weilGeomScheme F Z_s) (ℓ ^ (r + 1)) q_deg,
      (∀ (frob_Zs : weilEtaleTorsionH (weilGeomScheme F Z_s) (ℓ ^ (r + 1)) q_deg →+
            weilEtaleTorsionH (weilGeomScheme F Z_s) (ℓ ^ (r + 1)) q_deg),
        WeilIsTorsionGeomFrobAction F Z_s (ℓ ^ (r + 1)) q_deg frob_Zs →
        ∀ ζ : (𝒩_bar r).H 0, ev_s (frob_E0 r ζ) = frob_Zs (ev_s ζ)) ∧
      (∀ η : (𝒩_bar r).H 0,
        ev_s η = 0 →
        ∃ W_s : D_bar.left.Etale,
          (CategoryTheory.Limits.pullback.fst D₀.hom g_k).base ⁻¹' (Set.range s.base) ⊆
            Set.range ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W_s).hom.base ∧
          ∀ W' : D_bar.left.Etale,
            Nonempty (W' ⟶ W_s) →
            (CategoryTheory.Abelian.Ext.addEquiv₀ η).hom.app (Opposite.op W') = 0) ∧
      (∀ (ξ : (𝒩_bar r).H 0),
        (∀ W : D_bar.left.Etale,
          Set.range ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W).hom.base ⊆
            (U_bar : Set D_bar.left) →
          (CategoryTheory.Abelian.Ext.addEquiv₀ ξ).hom.app (Opposite.op W) = 0) →
        ∀ (s_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar.left),
          s_bar ≫ CategoryTheory.Limits.pullback.fst D₀.hom g_k = g_k ≫ s →
          s_bar ≫ D_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) →
          ∃ (W₀ : AlgebraicGeometry.Scheme.{u}) (w₀ : W₀ ⟶ D_bar.left)
            (_ : AlgebraicGeometry.Etale w₀)
            (s_tilde : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W₀)
            (α_W : weilEtaleTorsionH (CategoryTheory.Limits.pullback f_bar.left w₀)
              (ℓ ^ (r + 1)) q_deg),
            s_tilde ≫ w₀ = s_bar ∧
            (∀ (ι_s : weilGeomScheme F Z_s ⟶ CategoryTheory.Limits.pullback f_bar.left w₀),
              ι_s ≫ CategoryTheory.Limits.pullback.fst f_bar.left w₀ ≫
                  CategoryTheory.Limits.pullback.fst Z_tilde.hom g_k =
                CategoryTheory.Limits.pullback.fst Z_s.hom g_k ≫
                  CategoryTheory.Limits.pullback.fst f₀.left s →
              ι_s ≫ CategoryTheory.Limits.pullback.fst f_bar.left w₀ ≫
                  (weilBaseChangeOver F k Z_tilde).hom =
                (weilBaseChangeOver F k Z_s).hom →
              ι_s ≫ CategoryTheory.Limits.pullback.snd f_bar.left w₀ =
                (weilBaseChangeOver F k Z_s).hom ≫ s_tilde →
              ∀ (p_s : weilEtaleTorsionH (CategoryTheory.Limits.pullback f_bar.left w₀)
                  (ℓ ^ (r + 1)) q_deg →+
                  weilEtaleTorsionH (weilGeomScheme F Z_s) (ℓ ^ (r + 1)) q_deg),
                WeilIsTorsionEtalePullback ι_s (ℓ ^ (r + 1)) q_deg p_s →
                p_s α_W = ev_s ξ) ∧
            (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
                (η_W : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W₀),
              Set.range (η_W ≫ w₀).base ⊆ (U_bar : Set D_bar.left) →
              ∀ (ι_η : CategoryTheory.Limits.pullback f_bar.left (η_W ≫ w₀) ⟶
                  CategoryTheory.Limits.pullback f_bar.left w₀),
                ι_η ≫ CategoryTheory.Limits.pullback.fst f_bar.left w₀ =
                  CategoryTheory.Limits.pullback.fst f_bar.left (η_W ≫ w₀) →
                ι_η ≫ CategoryTheory.Limits.pullback.snd f_bar.left w₀ =
                  CategoryTheory.Limits.pullback.snd f_bar.left (η_W ≫ w₀) ≫ η_W →
                ∀ (p_η : weilEtaleTorsionH (CategoryTheory.Limits.pullback f_bar.left w₀)
                    (ℓ ^ (r + 1)) q_deg →+
                    weilEtaleTorsionH (CategoryTheory.Limits.pullback f_bar.left (η_W ≫ w₀))
                      (ℓ ^ (r + 1)) q_deg),
                  WeilIsTorsionEtalePullback ι_η (ℓ ^ (r + 1)) q_deg p_η →
                  p_η α_W = 0)) :=
by
  classical
  intro k D₀ D_bar g_k U_bar Z_s
  let _ := hPBC

  
  have hLiftCov : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (S : AlgebraicGeometry.Scheme.{u})
      (U : S.Etale)
      (R : CategoryTheory.Sieve U),
      R ∈ S.smallEtaleTopology U →
      ∀ (x : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left),
        ∃ (V : S.Etale) (v : V ⟶ U)
          (x_tilde : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
            ((AlgebraicGeometry.Scheme.Etale.forget S).obj V).left),
          R.arrows v ∧
          x_tilde ≫ ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left = x := by
    clear * -
    intro K _ _ S U R hR x
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale.{u}
    let _ : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
      (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative P_et).toIsStableUnderComposition
    have hR' : R ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S)).toGrothendieck U := by
      have hEq : S.smallEtaleTopology =
          (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S)).toGrothendieck :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) S (le_refl P_et)
      exact Eq.mp (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J U) hEq) hR
    obtain ⟨pt_K⟩ : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := inferInstance
    obtain ⟨V₀, v₀, y₀, hv₀_mem, hv₀_et, hy₀⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology U R).mp hR' (x.base pt_K)
    have : AlgebraicGeometry.Etale v₀.left := hv₀_et
    let P := CategoryTheory.Limits.pullback v₀.left x
    let fst_P : P ⟶ V₀.left := CategoryTheory.Limits.pullback.fst v₀.left x
    let snd_P : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) :=
      CategoryTheory.Limits.pullback.snd v₀.left x
    have hpb_P : CategoryTheory.IsPullback fst_P snd_P v₀.left x :=
      CategoryTheory.IsPullback.of_hasPullback v₀.left x
    obtain ⟨p₀, _, _⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_P y₀ pt_K hy₀
    have : AlgebraicGeometry.Etale snd_P :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_P inferInstance
    obtain ⟨U_A, hAff, hp₀_mem, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := p₀) (U := (⊤ : P.Opens)) trivial
    let A_cat : CommRingCat.{u} := P.presheaf.obj (Opposite.op U_A)
    let A : Type u := ↑A_cat
    have hNonempty_SpecA : Nonempty ↥(AlgebraicGeometry.Spec A_cat) :=
      ⟨hAff.isoSpec.hom.base ⟨p₀, hp₀_mem⟩⟩
    have hNontriv_A : Nontrivial A :=
      PrimeSpectrum.nonempty_iff_nontrivial.mp hNonempty_SpecA
    let g_A : AlgebraicGeometry.Spec A_cat ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) :=
      hAff.fromSpec ≫ snd_P
    have : AlgebraicGeometry.Etale g_A := inferInstance
    let φ_KA : CommRingCat.of K ⟶ A_cat := AlgebraicGeometry.Spec.preimage g_A
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_KA = g_A :=
      AlgebraicGeometry.Spec.map_preimage g_A
    have hEt_φ_mor : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_KA) := by
      rwa [hSpec_φ]
    have hEt_φ_ring : RingHom.Etale φ_KA.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et)).mp hEt_φ_mor
    let _ : Algebra K A := φ_KA.hom.toAlgebra
    have : Algebra.Etale K A := RingHom.Etale.toAlgebra hEt_φ_ring
    obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K A).mp inferInstance
    let _ : Finite I := hFinI
    let _ : ∀ i : I, Field (Ai i) := hFieldAi
    let _ : ∀ i : I, Algebra K (Ai i) := hAlgAi
    have hNonempty_I : Nonempty I := by
      by_contra hEmpty
      rw [not_nonempty_iff] at hEmpty
      have : Subsingleton (∀ i : I, Ai i) := inferInstance
      have : Subsingleton A := e_prod.toEquiv.subsingleton
      exact false_of_nontrivial_of_subsingleton A
    obtain ⟨i₀⟩ := hNonempty_I
    have : Module.Finite K (Ai i₀) := (hFinSep i₀).1
    have : Algebra.IsIntegral K (Ai i₀) := Algebra.IsIntegral.of_finite K (Ai i₀)
    have hBij_i₀ : Function.Bijective (algebraMap K (Ai i₀)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e_i₀ : K ≃ₐ[K] Ai i₀ := AlgEquiv.ofBijective (Algebra.ofId K (Ai i₀)) hBij_i₀
    let ε_alg : A →ₐ[K] K :=
      e_i₀.symm.toAlgHom.comp ((Pi.evalAlgHom K Ai i₀).comp e_prod.toAlgHom)
    have hε_comp : φ_KA ≫ CommRingCat.ofHom ε_alg.toRingHom = 𝟙 (CommRingCat.of K) := by
      ext c
      exact ε_alg.commutes c
    let σ_A : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ AlgebraicGeometry.Spec A_cat :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_alg.toRingHom)
    have hσ_gA : σ_A ≫ g_A = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) := by
      rw [← hSpec_φ]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_alg.toRingHom) ≫
        AlgebraicGeometry.Spec.map φ_KA = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K))
      rw [← AlgebraicGeometry.Spec.map_comp, hε_comp, AlgebraicGeometry.Spec.map_id]
    let x_tilde : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj V₀).left :=
      σ_A ≫ hAff.fromSpec ≫ fst_P
    refine ⟨V₀, v₀, x_tilde, hv₀_mem, ?_⟩
    exact (CategoryTheory.Category.assoc σ_A (hAff.fromSpec ≫ fst_P) _).trans
      ((congrArg (σ_A ≫ ·) (CategoryTheory.Category.assoc hAff.fromSpec fst_P _)).trans
        ((congrArg (fun h => σ_A ≫ hAff.fromSpec ≫ h) hpb_P.w).trans
          ((congrArg (σ_A ≫ ·) (CategoryTheory.Category.assoc hAff.fromSpec snd_P x).symm).trans
            ((CategoryTheory.Category.assoc σ_A g_A x).symm.trans
              ((congrArg (· ≫ x) hσ_gA).trans (CategoryTheory.Category.id_comp x))))))

  
  let Z_bar := weilBaseChangeOver F k Z_tilde
  let pr_D : D_bar.left ⟶ D₀.left := CategoryTheory.Limits.pullback.fst D₀.hom g_k
  let pr_Z : Z_bar.left ⟶ Z_tilde.left := CategoryTheory.Limits.pullback.fst Z_tilde.hom g_k
  let Z_s_bar := weilBaseChangeOver F k Z_s
  let pr_Zs : Z_s_bar.left ⟶ Z_s.left := CategoryTheory.Limits.pullback.fst Z_s.hom g_k
  have hPb_fbar' : CategoryTheory.IsPullback pr_Z f_bar.left f₀.left pr_D := hPb_fbar
  have hProp_Dbar : AlgebraicGeometry.IsProper D_bar.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback D₀.hom g_k) inferInstance
  have _ : AlgebraicGeometry.LocallyOfFiniteType D_bar.hom := inferInstance
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_k : (ℓ : k) ≠ 0 := by
    intro h0
    have hF0 : (ℓ : F) = 0 := by
      apply (algebraMap F k).injective
      rw [map_natCast, map_zero]
      exact h0
    have hdvd : ringChar F ∣ ℓ := (ringChar.spec F ℓ).mp hF0
    rcases CharP.char_is_prime_or_zero F (ringChar F) with hp | hp0
    · exact hℓ ((Nat.Prime.dvd_iff_eq hℓ_prime hp.ne_one).mp hdvd)
    · rw [hp0, zero_dvd_iff] at hdvd
      exact hℓ_prime.ne_zero hdvd
  let s_bar0 : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar.left :=
    CategoryTheory.Limits.pullback.lift (g_k ≫ s) (𝟙 _)
      (by rw [CategoryTheory.Category.assoc, hs_sec, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp])
  have hs0_fst : s_bar0 ≫ pr_D = g_k ≫ s := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hs0_snd : s_bar0 ≫ D_bar.hom = 𝟙 _ := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hs0_uniq : ∀ s_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar.left,
      s_bar ≫ pr_D = g_k ≫ s →
      s_bar ≫ D_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) →
      s_bar = s_bar0 := by
    intro s_bar h1 h2
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact h1.trans hs0_fst.symm
    · exact h2.trans hs0_snd.symm
  have hOuter_s0 : CategoryTheory.IsPullback (s_bar0 ≫ D_bar.hom) g_k g_k (s ≫ D₀.hom) := by
    rw [hs0_snd, hs_sec]
    exact CategoryTheory.IsPullback.of_horiz_isIso
      ⟨by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]⟩
  have hpb_s0 : CategoryTheory.IsPullback s_bar0 g_k pr_D s :=
    CategoryTheory.IsPullback.of_right hOuter_s0 hs0_fst
      (CategoryTheory.IsPullback.of_hasPullback D₀.hom g_k).flip
  have hs0_pre : pr_D.base ⁻¹' (Set.range s.base) ⊆ Set.range s_bar0.base := by
    rintro y ⟨pt, hpt⟩
    obtain ⟨z, hz, _⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_s0 y pt hpt.symm
    exact ⟨z, hz⟩
  let π_Zbar : Z_s_bar.left ⟶ Z_bar.left :=
    CategoryTheory.Limits.pullback.lift
      (pr_Zs ≫ CategoryTheory.Limits.pullback.fst f₀.left s) Z_s_bar.hom
      (by
        have hcond_Zs : pr_Zs ≫ Z_s.hom = Z_s_bar.hom ≫ g_k :=
          CategoryTheory.Limits.pullback.condition
        have hf₀_w : f₀.left ≫ D₀.hom = Z_tilde.hom := f₀.w
        calc
          (pr_Zs ≫ CategoryTheory.Limits.pullback.fst f₀.left s) ≫ Z_tilde.hom =
              pr_Zs ≫ (CategoryTheory.Limits.pullback.fst f₀.left s ≫ f₀.left) ≫ D₀.hom := by
            rw [← hf₀_w]; simp only [CategoryTheory.Category.assoc]
          _ = pr_Zs ≫ (CategoryTheory.Limits.pullback.snd f₀.left s ≫ s) ≫ D₀.hom := by
            rw [CategoryTheory.Limits.pullback.condition]
          _ = pr_Zs ≫ Z_s.hom ≫ (s ≫ D₀.hom) := by
            dsimp [Z_s]; simp only [CategoryTheory.Category.assoc]
          _ = pr_Zs ≫ Z_s.hom := by rw [hs_sec, CategoryTheory.Category.comp_id]
          _ = Z_s_bar.hom ≫ g_k := hcond_Zs)
  have hπ_fst : π_Zbar ≫ pr_Z = pr_Zs ≫ CategoryTheory.Limits.pullback.fst f₀.left s :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hπ_snd : π_Zbar ≫ Z_bar.hom = Z_s_bar.hom :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hpb_paste_Zs : CategoryTheory.IsPullback
      (pr_Zs ≫ CategoryTheory.Limits.pullback.fst f₀.left s) Z_s_bar.hom f₀.left (g_k ≫ s) :=
    (CategoryTheory.IsPullback.of_hasPullback Z_s.hom g_k).paste_horiz
      (CategoryTheory.IsPullback.of_hasPullback f₀.left s)
  have hpb_outer_Zs : CategoryTheory.IsPullback
      (π_Zbar ≫ pr_Z) Z_s_bar.hom f₀.left (s_bar0 ≫ pr_D) := by
    rw [hπ_fst, hs0_fst]
    exact hpb_paste_Zs
  have hπ_fbar : π_Zbar ≫ f_bar.left = Z_s_bar.hom ≫ s_bar0 := by
    have hcond_Zs : pr_Zs ≫ Z_s.hom = Z_s_bar.hom ≫ g_k :=
      CategoryTheory.Limits.pullback.condition
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (π_Zbar ≫ f_bar.left) ≫ pr_D = (Z_s_bar.hom ≫ s_bar0) ≫ pr_D
      rw [CategoryTheory.Category.assoc, ← hPb_fbar'.w, ← CategoryTheory.Category.assoc,
        hπ_fst, CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
      change pr_Zs ≫ Z_s.hom ≫ s = (Z_s_bar.hom ≫ s_bar0) ≫ pr_D
      rw [← CategoryTheory.Category.assoc, hcond_Zs, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, hs0_fst]
    · change (π_Zbar ≫ f_bar.left) ≫ D_bar.hom = (Z_s_bar.hom ≫ s_bar0) ≫ D_bar.hom
      rw [CategoryTheory.Category.assoc, f_bar.w, hπ_snd, CategoryTheory.Category.assoc,
        hs0_snd, CategoryTheory.Category.comp_id]
  have hPb_Zs_bar : CategoryTheory.IsPullback π_Zbar Z_s_bar.hom f_bar.left s_bar0 :=
    CategoryTheory.IsPullback.of_right hpb_outer_Zs hπ_fbar hPb_fbar
  let φ_F := @FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) k _ _ _
  let i_2 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F.symm.toRingHom)
