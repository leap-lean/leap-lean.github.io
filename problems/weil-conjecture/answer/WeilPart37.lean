  have hOverFrobComm : ∀ {K : Type u} [Finite K] [Field K]
      {Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))}
      (φ : Y₁ ⟶ Y₂)
      (φ_bar : weilGeomScheme K Y₁ ⟶ weilGeomScheme K Y₂),
      let f_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
      φ_bar ≫ CategoryTheory.Limits.pullback.fst Y₂.hom f_K =
        CategoryTheory.Limits.pullback.fst Y₁.hom f_K ≫ φ.left →
      φ_bar ≫ (weilBaseChangeOver K (AlgebraicClosure K) Y₂).hom =
        (weilBaseChangeOver K (AlgebraicClosure K) Y₁).hom →
      φ_bar ≫ weilGeomFrobHom K Y₂ = weilGeomFrobHom K Y₁ ≫ φ_bar := by
    intro K _ _ Y₁ Y₂ φ φ_bar f_K hφ_fst hφ_snd
    let fst₁ : weilGeomScheme K Y₁ ⟶ Y₁.left := CategoryTheory.Limits.pullback.fst Y₁.hom f_K
    let fst₂ : weilGeomScheme K Y₂ ⟶ Y₂.left := CategoryTheory.Limits.pullback.fst Y₂.hom f_K
    let snd₁ : weilGeomScheme K Y₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K)) :=
      CategoryTheory.Limits.pullback.snd Y₁.hom f_K
    let snd₂ : weilGeomScheme K Y₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K)) :=
      CategoryTheory.Limits.pullback.snd Y₂.hom f_K
    let i_symm := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
        (AlgebraicClosure K) _ _ _).symm.toRingHom)
    have hφ_fst' : φ_bar ≫ fst₂ = fst₁ ≫ φ.left := hφ_fst
    have hφ_snd' : φ_bar ≫ snd₂ = snd₁ := hφ_snd
    have hf₁_snd : weilGeomFrobHom K Y₁ ≫ snd₁ = snd₁ ≫ i_symm := hFrobSnd K Y₁
    have hf₂_snd : weilGeomFrobHom K Y₂ ≫ snd₂ = snd₂ ≫ i_symm := hFrobSnd K Y₂
    apply CategoryTheory.Limits.pullback.hom_ext
    · calc
        (φ_bar ≫ weilGeomFrobHom K Y₂) ≫ fst₂ = φ_bar ≫ (weilGeomFrobHom K Y₂ ≫ fst₂) :=
          CategoryTheory.Category.assoc _ _ _
        _ = φ_bar ≫ fst₂ := congrArg (φ_bar ≫ ·) (hFrobFst K Y₂)
        _ = fst₁ ≫ φ.left := hφ_fst'
        _ = (weilGeomFrobHom K Y₁ ≫ fst₁) ≫ φ.left :=
          congrArg (· ≫ φ.left) (hFrobFst K Y₁).symm
        _ = weilGeomFrobHom K Y₁ ≫ (φ_bar ≫ fst₂) := by
          rw [CategoryTheory.Category.assoc, hφ_fst']
        _ = (weilGeomFrobHom K Y₁ ≫ φ_bar) ≫ fst₂ := (CategoryTheory.Category.assoc _ _ _).symm
    · calc
        (φ_bar ≫ weilGeomFrobHom K Y₂) ≫ snd₂ = φ_bar ≫ (weilGeomFrobHom K Y₂ ≫ snd₂) :=
          CategoryTheory.Category.assoc _ _ _
        _ = (φ_bar ≫ snd₂) ≫ i_symm := by rw [hf₂_snd, CategoryTheory.Category.assoc]
        _ = weilGeomFrobHom K Y₁ ≫ (φ_bar ≫ snd₂) := by rw [hφ_snd', hf₁_snd]
        _ = (weilGeomFrobHom K Y₁ ≫ φ_bar) ≫ snd₂ := (CategoryTheory.Category.assoc _ _ _).symm

