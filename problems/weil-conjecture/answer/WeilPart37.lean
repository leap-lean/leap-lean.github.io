theorem weil_sing_dev_odp_sq_split_quadric_cohomology_and_frob (K : Type u) [Finite K] [Field K]
    (m ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar K)
    (Q_K : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.IsProper Q_K.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) Q_K.hom]
    (ι_Q : Q_K.left ⟶ (weilProjectiveSpaceOver K (2 * m + 1)).left)
    (hι_hom : ι_Q ≫ (weilProjectiveSpaceOver K (2 * m + 1)).hom = Q_K.hom)
    (hSplit : IsHomogeneousHypersurfacePullbackOver K (2 * m + 1) 2
