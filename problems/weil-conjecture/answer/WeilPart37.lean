            rw [← hf₀_w]; simp only [CategoryTheory.Category.assoc]
          _ = pr_Zs ≫ (CategoryTheory.Limits.pullback.snd f₀.left s ≫ s) ≫ D₀.hom := by
            rw [CategoryTheory.Limits.pullback.condition]
          _ = pr_Zs ≫ Z_s.hom ≫ (s ≫ D₀.hom) := by
            dsimp [Z_s]; simp only [CategoryTheory.Category.assoc]
          _ = pr_Zs ≫ Z_s.hom := by rw [hs_sec, CategoryTheory.Category.comp_id]
          _ = Z_s_bar.hom ≫ g_k := hcond_Zs)
  have hπ_fst : π_Zbar ≫ pr_Z = pr_Zs ≫ CategoryTheory.Limits.pullback.fst f₀.left s :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hπ_snd : π_Zbar ≫ Z_bar.hom = Z_s_bar.hom :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hpb_paste_Zs : CategoryTheory.IsPullback
      (pr_Zs ≫ CategoryTheory.Limits.pullback.fst f₀.left s) Z_s_bar.hom f₀.left (g_k ≫ s) :=
    (CategoryTheory.IsPullback.of_hasPullback Z_s.hom g_k).paste_horiz
