              split_ifs with hx01
              · rw [Polynomial.coeff_monomial, if_neg]
                intro hx00
                apply hx_ne
                ext ⟨i, b⟩
                rw [hFin1Eq0 i]
                fin_cases b
                · exact hx00
                · exact hx01.trans h01.symm
              · exact Polynomial.coeff_zero _
            · intro hnot; exact absurd hd₀ hnot
          rw [hsum_eq] at hcoeff0
          exact (MvPolynomial.mem_support_iff.mp hd₀) hcoeff0
        have hPure1 : ∀ d₀ ∈ P.support, d₀ (0, 0) ≠ 0 := by
          intro d₀ hd₀ h00
          have hcoeff0 : (α_tilde_1 P).coeff (d₀ (0, 1)) = 0 := by rw [hP1, Polynomial.coeff_zero]
          rw [MvPolynomial.as_sum (p := P), map_sum, Polynomial.finset_sum_coeff] at hcoeff0
          have hsum_eq : (∑ x ∈ P.support,
              (α_tilde_1 (MvPolynomial.monomial x (P.coeff x))).coeff (d₀ (0, 1))) = P.coeff d₀ := by
            rw [Finset.sum_eq_single d₀]
            · rw [hMon1, if_pos h00, Polynomial.coeff_monomial, if_pos rfl]
            · intro x _ hx_ne
