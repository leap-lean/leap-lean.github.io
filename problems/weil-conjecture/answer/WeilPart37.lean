  obtain ⟨p_μ, hp_μ⟩ := hPullEx μ_R n_mod q_deg
  obtain ⟨p_jX, hp_jX⟩ := hPullEx j_X_open n_mod q_deg
  have hBij_jX : Function.Bijective p_jX :=
    weil_odp_punct_sm_bockstein_prime_pow_pullback_bijective ℓ j_X_open hModPrime_jX
      r q_deg p_jX hp_jX

  let Z_Ω := CategoryTheory.Limits.pullback f_bar.left (η_W ≫ w₀)
  let ι_η : Z_Ω ⟶ CategoryTheory.Limits.pullback f_bar.left w₀ :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst f_bar.left (η_W ≫ w₀))
      (CategoryTheory.Limits.pullback.snd f_bar.left (η_W ≫ w₀) ≫ η_W)
      ((CategoryTheory.Limits.pullback.condition).trans (Category.assoc _ _ _).symm)
  let ψ_Ω : Z_R_Ω_open ⟶ Z_Ω :=
    CategoryTheory.Limits.pullback.lift
      (j_X_open ≫ fst_tot ≫ V_tot.ι)
      snd_Ω
      (by
        have h1 : (j_X_open ≫ fst_tot ≫ V_tot.ι) ≫ f_bar.left =
            j_X_open ≫ (fst_tot ≫ f_tot) := by
          dsimp only [f_tot]
          simp only [Category.assoc]
        have h2 : j_X_open ≫ snd_tot = snd_Ω ≫ j_R :=
          CategoryTheory.Limits.pullback.condition
        rw [h1, CategoryTheory.Limits.pullback.condition, ← Category.assoc j_X_open, h2,
          Category.assoc, ← hg_tilde_w₀]
        dsimp only [η_W]
        simp only [Category.assoc])
  have hGen_comm : j_X_open ≫ μ_R = ψ_Ω ≫ ι_η := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · dsimp only [μ_R, ψ_Ω, ι_η]
      rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Limits.pullback.lift_fst]
    · have h2 : j_X_open ≫ snd_tot = snd_Ω ≫ j_R :=
        CategoryTheory.Limits.pullback.condition
      dsimp only [μ_R, ψ_Ω, ι_η, η_W]
      rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← Category.assoc ψ_Ω, CategoryTheory.Limits.pullback.lift_snd,
        ← Category.assoc j_X_open, h2]
      simp only [Category.assoc]

  obtain ⟨p_η, hp_η⟩ := hPullEx ι_η n_mod q_deg
  obtain ⟨p_ψΩ, hp_ψΩ⟩ := hPullEx ψ_Ω n_mod q_deg
  obtain ⟨p_gen, hp_gen⟩ := hPullEx (j_X_open ≫ μ_R) n_mod q_deg
  have hcomp_gen₁ : p_gen = p_jX.comp p_μ :=
    hPullComp j_X_open μ_R n_mod q_deg p_jX p_μ p_gen hp_jX hp_μ hp_gen
  have hp_gen' : WeilIsTorsionEtalePullback (ψ_Ω ≫ ι_η) n_mod q_deg p_gen := by
    rwa [← hGen_comm]
  have hcomp_gen₂ : p_gen = p_ψΩ.comp p_η :=
    hPullComp ψ_Ω ι_η n_mod q_deg p_ψΩ p_η p_gen hp_ψΩ hp_η hp_gen'
  have hp_η_zero : p_η α_W = 0 :=
    hα_gen Ω η_W hRange_ηW ι_η
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      p_η hp_η
  have hp_μ_zero : p_μ α_W = 0 := by
    apply hBij_jX.1
    rw [map_zero]
    calc p_jX (p_μ α_W)
        = p_gen α_W := by rw [hcomp_gen₁, AddMonoidHom.comp_apply]
      _ = p_ψΩ (p_η α_W) := by rw [hcomp_gen₂, AddMonoidHom.comp_apply]
      _ = 0 := by rw [hp_η_zero, map_zero]

  have hRange_Usm :
      Set.range ⇑(U_sm.ι ≫ CategoryTheory.Limits.pullback.fst f_bar.left s_bar) ⊆
        Set.range ⇑V_tot.ι := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨u, rfl⟩
    let y := U_sm.ι u
    have hy_U : y ∈ U_sm := by
      have hr : y ∈ Set.range ⇑U_sm.ι := ⟨u, rfl⟩
      rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at hr
    let z := (CategoryTheory.Limits.pullback.fst f_bar.left s_bar).base y
    have hz_s : f_bar.left.base z ∈ Set.range s_bar.base := by
      change (CategoryTheory.Limits.pullback.fst f_bar.left s_bar ≫ f_bar.left).base y ∈
        Set.range s_bar.base
      rw [CategoryTheory.Limits.pullback.condition]
      exact ⟨(CategoryTheory.Limits.pullback.snd f_bar.left s_bar).base y, rfl⟩
    have hz_not_x : z ∉ Set.range x_bar.base := hDisj y hy_U
    obtain ⟨V, hzV, hSmV⟩ := hSm_away z hz_s hz_not_x
    have hV_le : V ≤ V_tot := le_sSup hSmV
    exact hV_le hzV

  let g_U_Vtot : U_sm.toScheme ⟶ V_tot.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift V_tot.ι
      (U_sm.ι ≫ CategoryTheory.Limits.pullback.fst f_bar.left s_bar) hRange_Usm
  have hg_U_Vtot : g_U_Vtot ≫ V_tot.ι =
      U_sm.ι ≫ CategoryTheory.Limits.pullback.fst f_bar.left s_bar :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac V_tot.ι
      (U_sm.ι ≫ CategoryTheory.Limits.pullback.fst f_bar.left s_bar) hRange_Usm

  let lam_U : U_sm.toScheme ⟶ Z_R_open :=
    CategoryTheory.Limits.pullback.lift
      g_U_Vtot
      (U_sm.ι ≫ CategoryTheory.Limits.pullback.snd f_bar.left s_bar ≫ i_cl)
      (by
        dsimp only [f_tot]
        rw [← Category.assoc g_U_Vtot, hg_U_Vtot, Category.assoc U_sm.ι,
          CategoryTheory.Limits.pullback.condition, Category.assoc U_sm.ι, Category.assoc,
          hi_cl_gP])
  have hlam_μ : lam_U ≫ μ_R = ι_U := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · dsimp only [μ_R, lam_U]
      rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        ← Category.assoc lam_U, CategoryTheory.Limits.pullback.lift_fst,
        hg_U_Vtot, hι_U_fst]
    · dsimp only [μ_R, lam_U]
      rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← Category.assoc lam_U, CategoryTheory.Limits.pullback.lift_snd,
        Category.assoc, Category.assoc, hg_tilde_cl, hι_U_snd]

  obtain ⟨p_lam, hp_lam⟩ := hPullEx lam_U n_mod q_deg
  have hp_U' : WeilIsTorsionEtalePullback (lam_U ≫ μ_R) n_mod q_deg p_U := by
    rwa [hlam_μ]
  have hcomp_U : p_U = p_lam.comp p_μ :=
    hPullComp lam_U μ_R n_mod q_deg p_lam p_μ p_U hp_lam hp_μ hp_U'
  rw [hcomp_U, AddMonoidHom.comp_apply, hp_μ_zero, map_zero]

theorem weil_odp_fiber_integral_and_affine_ring_roof (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.IsProper (weilProjectiveSpaceOver F 1).hom]
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.IsProper f₀.left]
    (hFibIrred : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver F 1).left),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left s))
    (s : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hs_sec : s ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (x_s : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z_tilde.left)
    (hx_s : x_s ≫ f₀.left = s)
    (hSm_away : ∀ z : Z_tilde.left,
      f₀.left.base z ∈ Set.range s.base → z ∉ Set.range x_s.base →
      ∃ V : Z_tilde.left.Opens, z ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left))
    (hOdp_s : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
      IsEtaleSplitOdpPointOver m f₀ (x_s.base pt) (s.base pt))
    (x_s0 : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶
      (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f₀.left s)).left)
    (hx_s0_fst : x_s0 ≫ CategoryTheory.Limits.pullback.fst f₀.left s = x_s)
    (hx_s0_sec : x_s0 ≫
      (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f₀.left s)).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F))) :
    let Z_s : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)) :=
      CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f₀.left s)
    AlgebraicGeometry.IsIntegral Z_s.left ∧
    (∀ (E : Type u) [Field E] [Algebra F E],
      AlgebraicGeometry.IsIntegral (weilBaseChangeOver F E Z_s).left) ∧
    ∃ (U : Z_s.left.affineOpens)
      (alg_A₀ : F →+* ↑(Z_s.left.presheaf.obj (Opposite.op U.1)))
      (ε₀ : ↑(Z_s.left.presheaf.obj (Opposite.op U.1)) →+* F)
      (E₁ : Type u) (_ : Field E₁) (_ : Algebra F E₁) (_ : FiniteDimensional F E₁)
      (B' : Type u) (_ : CommRing B')
      (q₀ : PrimeSpectrum B')
      (φ₁ : ↑(Z_s.left.presheaf.obj (Opposite.op U.1)) →+* B')
      (φ₂ : (MvPolynomial (Fin (m + 1) × Fin 2) E₁ ⧸
        Ideal.span {∑ j : Fin (m + 1),
          (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) E₁) *
            MvPolynomial.X (j, 1)}) →+* B'),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom alg_A₀) = U.2.fromSpec ≫ Z_s.hom ∧
      alg_A₀.FiniteType ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε₀) ≫ U.2.fromSpec = x_s0 ∧
      ε₀.comp alg_A₀ = RingHom.id F ∧
      φ₁.Etale ∧
      φ₂.Etale ∧
      φ₁.comp alg_A₀ =
        φ₂.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C.comp (algebraMap F E₁))) ∧
      (PrimeSpectrum.comap φ₁ q₀).asIdeal = RingHom.ker ε₀ ∧
      (∀ idx : Fin (m + 1) × Fin 2,
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∈ q₀.asIdeal) ∧
      Ideal.map φ₁ (RingHom.ker ε₀) =
        Ideal.span (Set.range fun idx : Fin (m + 1) × Fin 2 =>
          φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx))) :=
by
  
  have h_s2 : ∀ (F₀ : Type u) [Field F₀] (m₀ : ℕ)
      (Y B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F₀)))
      [AlgebraicGeometry.IsProper B.hom]
      (g : Y ⟶ B)
      (s_b : AlgebraicGeometry.Spec (CommRingCat.of F₀) ⟶ B.left),
      s_b ≫ B.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F₀)) →
      ∀ (x_sb : AlgebraicGeometry.Spec (CommRingCat.of F₀) ⟶ Y.left),
      x_sb ≫ g.left = s_b →
      (∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F₀),
        IsEtaleSplitOdpPointOver m₀ g (x_sb.base pt) (s_b.base pt)) →
      ∀ (U : (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd g.left s_b)).left.affineOpens)
        (alg_A₀ : F₀ →+* ↑((CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd g.left s_b)).left.presheaf.obj (Opposite.op U.1)))
        (ε₀ : ↑((CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd g.left s_b)).left.presheaf.obj (Opposite.op U.1)) →+* F₀)
        (x_sb0 : AlgebraicGeometry.Spec (CommRingCat.of F₀) ⟶
          (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd g.left s_b)).left),
      x_sb0 ≫ CategoryTheory.Limits.pullback.fst g.left s_b = x_sb →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom alg_A₀) =
        U.2.fromSpec ≫ (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd g.left s_b)).hom →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε₀) ≫ U.2.fromSpec = x_sb0 →
      ∃ (E₁ : Type u) (_ : Field E₁) (_ : Algebra F₀ E₁) (_ : FiniteDimensional F₀ E₁)
        (_ : Algebra.IsSeparable F₀ E₁)
        (B₁ : Type u) (_ : CommRing B₁)
        (q₁ : PrimeSpectrum B₁)
        (φ₁₀ : ↑((CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd g.left s_b)).left.presheaf.obj (Opposite.op U.1)) →+* B₁)
        (φ₂₀ : (MvPolynomial (Fin (m₀ + 1) × Fin 2) E₁ ⧸
          Ideal.span {∑ j : Fin (m₀ + 1),
            (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) E₁) *
              MvPolynomial.X (j, 1)}) →+* B₁),
        φ₁₀.Etale ∧
        φ₂₀.Etale ∧
        φ₁₀.comp alg_A₀ =
          φ₂₀.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C.comp (algebraMap F₀ E₁))) ∧
        (PrimeSpectrum.comap φ₁₀ q₁).asIdeal = RingHom.ker ε₀ ∧
        (∀ idx : Fin (m₀ + 1) × Fin 2,
          φ₂₀ (Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∈ q₁.asIdeal) := by
    intro F₀ _ m₀ Y B _ g s_b hs_b x_sb hx_sb hOdp U alg_A₀ ε₀ x_sb0 hx_sb0_fst halg_A₀ hε₀_Spec
    have hPrimeBot : ∀ {K : Type u} [Field K] (p : PrimeSpectrum K), p.asIdeal = ⊥ := by
      intro K _ p
      rw [eq_bot_iff]
      intro x hx
      by_contra hne
      have h1 : (1 : K) ∈ p.asIdeal := by
        rw [← mul_inv_cancel₀ hne]
        exact p.asIdeal.mul_mem_right x⁻¹ hx
      exact p.isPrime.one_notMem h1
    let pt₀ : AlgebraicGeometry.Spec (CommRingCat.of F₀) := default
    obtain ⟨_, R', _u₀, e_B, h, V', v₀, e_Y, q, hEt_eB, hEt_eY, hEt_q, _, heY_v₀, _, _,
        hX_v₀, hh_v₀, hcomm_Odp⟩ := hOdp pt₀
    have : AlgebraicGeometry.Etale e_B := hEt_eB
    have : AlgebraicGeometry.Etale e_Y := hEt_eY
    have : AlgebraicGeometry.Etale q := hEt_q
    let J_R' : Ideal (MvPolynomial (Fin (m₀ + 1) × Fin 2) R') :=
      Ideal.span {(∑ j : Fin (m₀ + 1),
        (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) R') * MvPolynomial.X (j, 1)) -
        MvPolynomial.C h}
    let c_R' : R' →+* (MvPolynomial (Fin (m₀ + 1) × Fin 2) R' ⧸ J_R') :=
      (Ideal.Quotient.mk J_R').comp MvPolynomial.C
    let π_M : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (m₀ + 1) × Fin 2) R' ⧸ J_R')) ⟶
        AlgebraicGeometry.Spec R' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_R')
    let u₁ : AlgebraicGeometry.Spec R' := (q ≫ π_M).base v₀
    have he_B_u₁ : e_B.base u₁ = s_b.base pt₀ := by
      change (q ≫ π_M ≫ e_B).base v₀ = s_b.base pt₀
      rw [← hcomm_Odp]
      change g.left.base (e_Y.base v₀) = s_b.base pt₀
      rw [heY_v₀, ← hx_sb]
      rfl
    have hh_u₁ : h ∈ u₁.asIdeal := hh_v₀
    let S' := CategoryTheory.Limits.pullback e_B s_b
    let p_R' : S' ⟶ AlgebraicGeometry.Spec R' := CategoryTheory.Limits.pullback.fst e_B s_b
    let p_F : S' ⟶ AlgebraicGeometry.Spec (CommRingCat.of F₀) := CategoryTheory.Limits.pullback.snd e_B s_b
    have hPb_S' : CategoryTheory.IsPullback p_R' p_F e_B s_b :=
      CategoryTheory.IsPullback.of_hasPullback e_B s_b
    have : AlgebraicGeometry.Etale p_F :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_S' inferInstance
    obtain ⟨s'_0, hs'_R', _⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_S' u₁ pt₀ he_B_u₁
    obtain ⟨_, ⟨W_S, hWS, rfl⟩, hs'_WS, _⟩ :=
      TopologicalSpace.IsTopologicalBasis.exists_subset_of_mem_open
        (AlgebraicGeometry.Scheme.isBasis_affineOpens S') (Set.mem_univ s'_0) isOpen_univ
    let p₀_S : PrimeSpectrum ↑(S'.presheaf.obj (Opposite.op W_S)) :=
      hWS.primeIdealOf ⟨s'_0, hs'_WS⟩
    have hp₀_S : hWS.fromSpec.base p₀_S = s'_0 := hWS.fromSpec_primeIdealOf ⟨s'_0, hs'_WS⟩
    have : AlgebraicGeometry.IsOpenImmersion hWS.fromSpec := hWS.isOpenImmersion_fromSpec
    let alg_S : F₀ →+* ↑(S'.presheaf.obj (Opposite.op W_S)) :=
      (AlgebraicGeometry.Spec.preimage (hWS.fromSpec ≫ p_F)).hom
    have halg_S_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom alg_S) = hWS.fromSpec ≫ p_F :=
      AlgebraicGeometry.Spec.map_preimage _
    have halg_S_et : alg_S.Etale := by
      have hSpec_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom alg_S)) := by
        rw [halg_S_spec]; infer_instance
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hSpec_et
    let _ : Algebra F₀ ↑(S'.presheaf.obj (Opposite.op W_S)) := alg_S.toAlgebra
    have : Algebra.Etale F₀ ↑(S'.presheaf.obj (Opposite.op W_S)) :=
      RingHom.etale_algebraMap.mp halg_S_et
    obtain ⟨I_idx, hFinI, Ai, hFieldAi, hAlgAi, e_S, hAi⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod F₀ ↑(S'.presheaf.obj (Opposite.op W_S))).mp inferInstance
    let _ : Fintype I_idx := Fintype.ofFinite I_idx
    let _ : ∀ i, Field (Ai i) := hFieldAi
    let _ : ∀ i, Algebra F₀ (Ai i) := hAlgAi
    classical
    have hsum_idemp : (∑ i : I_idx, e_S.symm (Pi.single i (1 : Ai i))) = 1 := by
      rw [← map_sum]
      have h1 : (∑ i : I_idx, Pi.single i (1 : Ai i)) = 1 := by
        ext i; simp [Finset.sum_apply]
      rw [h1, map_one]
    have hex_i0 : ∃ i₀ : I_idx, e_S.symm (Pi.single i₀ (1 : Ai i₀)) ∉ p₀_S.asIdeal := by
      by_contra hall
      apply p₀_S.isPrime.one_notMem
      rw [← hsum_idemp]
      exact Ideal.sum_mem p₀_S.asIdeal (fun i _ => by by_contra hnot; exact hall ⟨i, hnot⟩)
    obtain ⟨i₀, hi₀_notMem⟩ := hex_i0
    have : FiniteDimensional F₀ (Ai i₀) := (hAi i₀).1
    have : Algebra.IsSeparable F₀ (Ai i₀) := (hAi i₀).2
    have : Algebra.FormallyEtale F₀ (Ai i₀) := Algebra.FormallyEtale.of_isSeparable F₀ (Ai i₀)
    have : Algebra.FinitePresentation F₀ (Ai i₀) :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance
    have : Algebra.Etale F₀ (Ai i₀) := {}
    have hEt_FE1 : (algebraMap F₀ (Ai i₀)).Etale := RingHom.etale_algebraMap.mpr inferInstance
    let s_i0 : ↑(S'.presheaf.obj (Opposite.op W_S)) := e_S.symm (Pi.single i₀ (1 : Ai i₀))
    let π_i0 : ↑(S'.presheaf.obj (Opposite.op W_S)) →+* Ai i₀ :=
      (Pi.evalRingHom Ai i₀).comp e_S.toRingHom
    have hπ_alg : π_i0.comp alg_S = algebraMap F₀ (Ai i₀) := by
      ext c
      exact congrFun (e_S.commutes c) i₀
    have hπ_surj : Function.Surjective π_i0 := by
      intro z
      refine ⟨e_S.symm (Pi.single i₀ z), ?_⟩
      change e_S (e_S.symm (Pi.single i₀ z)) i₀ = z
      simp
    have hker_π : RingHom.ker π_i0 = p₀_S.asIdeal := by
      have hle : RingHom.ker π_i0 ≤ p₀_S.asIdeal := by
        intro a ha
        have hsa0 : s_i0 * a = 0 := by
          apply e_S.injective
          rw [map_mul, map_zero]
          ext j
          dsimp [s_i0]
          rw [e_S.apply_symm_apply]
          by_cases hj : j = i₀
          · subst hj
            have ha' : e_S a j = 0 := ha
            simp [ha']
          · simp [hj]
        have hmem0 : s_i0 * a ∈ p₀_S.asIdeal := hsa0.symm ▸ p₀_S.asIdeal.zero_mem
        exact (p₀_S.isPrime.mem_or_mem hmem0).resolve_left hi₀_notMem
      have hmax : (RingHom.ker π_i0).IsMaximal := RingHom.ker_isMaximal_of_surjective π_i0 hπ_surj
      exact hmax.eq_of_le p₀_S.isPrime.ne_top hle
    let ι_E : AlgebraicGeometry.Spec (CommRingCat.of (Ai i₀)) ⟶ S' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_i0) ≫ hWS.fromSpec
    let pt_E1 : AlgebraicGeometry.Spec (CommRingCat.of (Ai i₀)) := default
    have hι_E_pt : ι_E.base pt_E1 = s'_0 := by
      have hspec_pt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_i0)).base pt_E1 = p₀_S := by
        apply PrimeSpectrum.ext
        change Ideal.comap π_i0 pt_E1.asIdeal = p₀_S.asIdeal
        rw [hPrimeBot pt_E1, ← RingHom.ker_eq_comap_bot, hker_π]
      change hWS.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_i0)).base pt_E1) = s'_0
      rw [hspec_pt, hp₀_S]
    let ρ_R' : R' →+* Ai i₀ := (AlgebraicGeometry.Spec.preimage (ι_E ≫ p_R')).hom
    let f_ρ : AlgebraicGeometry.Spec (CommRingCat.of (Ai i₀)) ⟶ AlgebraicGeometry.Spec R' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_R')
    have hf_ρ_eq : f_ρ = ι_E ≫ p_R' := AlgebraicGeometry.Spec.map_preimage _
    have hf_ρ_pt : f_ρ.base pt_E1 = u₁ := by
      rw [hf_ρ_eq]
      change p_R'.base (ι_E.base pt_E1) = u₁
      rw [hι_E_pt, hs'_R']
    have hker_ρ : RingHom.ker ρ_R' = u₁.asIdeal := by
      rw [RingHom.ker_eq_comap_bot, ← hPrimeBot pt_E1]
      exact congrArg PrimeSpectrum.asIdeal hf_ρ_pt
    have hρ_h : ρ_R' h = 0 := RingHom.mem_ker.mp (hker_ρ.symm ▸ hh_u₁)
    let g_E1 : AlgebraicGeometry.Spec (CommRingCat.of (Ai i₀)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of F₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F₀ (Ai i₀)))
    have hι_pF : ι_E ≫ p_F = g_E1 := by
      dsimp [ι_E, g_E1]
      rw [CategoryTheory.Category.assoc, ← halg_S_spec, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hπ_alg]
    have hf_ρ_eB : f_ρ ≫ e_B = g_E1 ≫ s_b := by
      rw [hf_ρ_eq, CategoryTheory.Category.assoc, hPb_S'.w, ← CategoryTheory.Category.assoc, hι_pF]
    let J_E1 : Ideal (MvPolynomial (Fin (m₀ + 1) × Fin 2) (Ai i₀)) :=
      Ideal.span {∑ j : Fin (m₀ + 1),
        (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) (Ai i₀)) *
          MvPolynomial.X (j, 1)}
    let c_E1 : Ai i₀ →+* (MvPolynomial (Fin (m₀ + 1) × Fin 2) (Ai i₀) ⧸ J_E1) :=
      (Ideal.Quotient.mk J_E1).comp MvPolynomial.C
    have hker_τ : ∀ a ∈ J_R', ((Ideal.Quotient.mk J_E1).comp (MvPolynomial.map ρ_R')) a = 0 := by
      intro a ha
      change a ∈ RingHom.ker ((Ideal.Quotient.mk J_E1).comp (MvPolynomial.map ρ_R'))
      refine Ideal.span_le.mpr ?_ ha
      rintro _ ⟨rfl⟩
      have hmap_gen : MvPolynomial.map ρ_R'
          ((∑ j : Fin (m₀ + 1),
            (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) R') * MvPolynomial.X (j, 1)) -
            MvPolynomial.C h) =
          ∑ j : Fin (m₀ + 1),
            (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) (Ai i₀)) *
              MvPolynomial.X (j, 1) := by
        simp [hρ_h]
      rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, hmap_gen]
      exact (Ideal.Quotient.eq_zero_iff_mem (I := J_E1)).mpr (Ideal.subset_span rfl)
    let τ_C : (MvPolynomial (Fin (m₀ + 1) × Fin 2) R' ⧸ J_R') →+*
        (MvPolynomial (Fin (m₀ + 1) × Fin 2) (Ai i₀) ⧸ J_E1) :=
      Ideal.Quotient.lift J_R' ((Ideal.Quotient.mk J_E1).comp (MvPolynomial.map ρ_R')) hker_τ
    have hτ_comm : τ_C.comp c_R' = c_E1.comp ρ_R' := by
      ext r
      change Ideal.Quotient.lift J_R' ((Ideal.Quotient.mk J_E1).comp (MvPolynomial.map ρ_R')) hker_τ
          (Ideal.Quotient.mk J_R' (MvPolynomial.C r)) =
        Ideal.Quotient.mk J_E1 (MvPolynomial.C (ρ_R' r))
      rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_C]
    have hPush_C1 : CategoryTheory.IsPushout
        (CommRingCat.ofHom c_R') (CommRingCat.ofHom ρ_R')
        (CommRingCat.ofHom τ_C) (CommRingCat.ofHom c_E1) := by
      have hcomm_cat : CommRingCat.ofHom c_R' ≫ CommRingCat.ofHom τ_C =
          CommRingCat.ofHom ρ_R' ≫ CommRingCat.ofHom c_E1 := by
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hτ_comm]
      let cocone := CategoryTheory.Limits.PushoutCocone.mk
        (CommRingCat.ofHom τ_C) (CommRingCat.ofHom c_E1) hcomm_cat
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.isColimitAux' cocone fun sc => ?_)
      let f₁ : (MvPolynomial (Fin (m₀ + 1) × Fin 2) R' ⧸ J_R') →+* sc.pt := sc.inl.hom
      let f₂ : Ai i₀ →+* sc.pt := sc.inr.hom
      have hsc_cond : ∀ r : R', f₁ (c_R' r) = f₂ (ρ_R' r) :=
        fun r => congrArg (fun φ => φ.hom r) sc.condition
      let ev : MvPolynomial (Fin (m₀ + 1) × Fin 2) (Ai i₀) →+* sc.pt :=
        MvPolynomial.eval₂Hom f₂ (fun idx => f₁ (Ideal.Quotient.mk J_R' (MvPolynomial.X idx)))
      have hker_ev : ∀ a ∈ J_E1, ev a = 0 := by
        intro a ha
        change a ∈ RingHom.ker ev
        refine Ideal.span_le.mpr ?_ ha
        rintro _ ⟨rfl⟩
        simp only [SetLike.mem_coe, RingHom.mem_ker, ev, map_sum, map_mul, MvPolynomial.eval₂Hom_X']
        have hrel_R' : Ideal.Quotient.mk J_R'
            (∑ j : Fin (m₀ + 1),
              (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) R') *
                MvPolynomial.X (j, 1)) = c_R' h := by
          dsimp [c_R']
          rw [Ideal.Quotient.eq]
          exact Ideal.subset_span rfl
        have hsum_f₁ : ∑ j : Fin (m₀ + 1),
            f₁ (Ideal.Quotient.mk J_R' (MvPolynomial.X (j, 0))) *
              f₁ (Ideal.Quotient.mk J_R' (MvPolynomial.X (j, 1))) =
            f₁ (Ideal.Quotient.mk J_R'
