        have hmap_s : AlgebraicGeometry.Spec.map φ_s = s_W :=
          AlgebraicGeometry.Spec.map_preimage s_W
        have hmap_α : AlgebraicGeometry.Spec.map α_k = j_W ≫ Y.hom :=
