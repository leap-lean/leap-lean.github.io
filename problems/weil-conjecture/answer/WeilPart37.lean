    have hDisjPullZero : ∀ {Z S : AlgebraicGeometry.Scheme.{u}} (h : Z ⟶ S) (U : S.Opens),
        (∀ z : ↥Z, h.base z ∉ (U : Set ↥S)) →
        let U_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι
