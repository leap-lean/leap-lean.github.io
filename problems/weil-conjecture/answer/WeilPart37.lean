      change (e_tot.hom ≫ e_tot.inv).base w = w
      rw [e_tot.hom_inv_id]
      rfl
    have hConn_pb : ConnectedSpace ↥(CategoryTheory.Limits.pullback e_hom f.left) :=
      @Function.Surjective.connectedSpace _ _ _ hConn_spec _ _ hSurj_inv e_tot.inv.continuous
    exact ⟨E, u_et, z_E, rfl, hConn_E, hConn_pb⟩

  
  
  
  have hAffZeroIso : Nonempty ((weilAffineSpaceOver k 0).left ≅
      AlgebraicGeometry.Spec (CommRingCat.of k)) := by
    let eq₀ : MvPolynomial (Fin 0) k ≃ₐ[k] k := MvPolynomial.isEmptyAlgEquiv k (Fin 0)
