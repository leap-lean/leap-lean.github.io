      _ = 𝟙 Fℤ_U ≫ ιℤ := by rw [h1]
      _ = ιℤ := CategoryTheory.Category.id_comp _

  have hψM_inv : (e_RP.inv.app FM_S ≫ πM) ≫ αM = 𝟙 (R_sh.obj FM_S) :=
    (hUnitInv hT'_U hT'_S AM).2

  obtain ⟨hExtIso, hExtBij⟩ := hStep5Ext
  let rx := CategoryTheory.Abelian.Ext.mapExactFunctor R_sh x
  let px := CategoryTheory.Abelian.Ext.mapExactFunctor P_pull x

  have hαRx_ψM :
      ((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp rx (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (e_RP.inv.app FM_S ≫ πM)) (Nat.add_zero q) = 0 := by
    have hiso := hExtIso e_RP q x
    change _ = rx at hiso
    rw [← hiso,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ αℤ)
        (CategoryTheory.Abelian.Ext.mk₀ (e_RP.inv.app Fℤ_S))
        (px.comp (CategoryTheory.Abelian.Ext.mk₀ (e_RP.hom.app FM_S)) (Nat.add_zero q))
        (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hαℤ_inv,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ) px
        (CategoryTheory.Abelian.Ext.mk₀ (e_RP.hom.app FM_S)) (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp px (Nat.zero_add q))
        (CategoryTheory.Abelian.Ext.mk₀ (e_RP.hom.app FM_S))
        (CategoryTheory.Abelian.Ext.mk₀ (e_RP.inv.app FM_S ≫ πM)) (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Category.assoc, e_RP.hom_inv_id_app FM_S,
      CategoryTheory.Category.id_comp]
    have hpU : p_U x =
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp px (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero q) :=
      hp_U_eq x
    exact hpU.symm.trans hx

  have hαRx : (CategoryTheory.Abelian.Ext.mk₀ αℤ).comp rx (Nat.zero_add q) = 0 := by
    have hpost := congrArg
      (fun t => t.comp (CategoryTheory.Abelian.Ext.mk₀ αM) (Nat.add_zero q)) hαRx_ψM
    rw [CategoryTheory.Abelian.Ext.zero_comp,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hψM_inv,
      CategoryTheory.Abelian.Ext.comp_mk₀_id] at hpost
    exact hpost

  obtain ⟨δ_U, hδ_bij0, hδ_κ⟩ := hStep4
  let Γ_U : CategoryTheory.Abelian.Ext.{u} Z_U FM_S q →+
      CategoryTheory.Abelian.Ext.{u} Fℤ_U (R_sh.obj FM_S) q :=
    ((CategoryTheory.Abelian.Ext.mk₀ δ_U).precomp (R_sh.obj FM_S) (Nat.zero_add q)).comp
      (R_sh.mapExtAddHom Z_U FM_S q)
  have hΓ_bij : Function.Bijective Γ_U :=
    hExtBij R_sh Z_U Fℤ_U δ_U hδ_bij0
      (fun ℐ _ m ω => by
        haveI : CategoryTheory.Injective (R_sh.obj ℐ) := hInj_R ℐ
        exact CategoryTheory.Abelian.Ext.eq_zero_of_injective ω)
      FM_S q

  apply hΓ_bij.1
  rw [map_zero]
  change (CategoryTheory.Abelian.Ext.mk₀ δ_U).comp
      (CategoryTheory.Abelian.Ext.mapExactFunctor R_sh
        ((CategoryTheory.Abelian.Ext.mk₀ κℤ_U).comp x (Nat.zero_add q)))
      (Nat.zero_add q) = 0
  rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
    CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
    ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
    CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hδ_κ]
  exact hαRx

theorem weil_sq_rmcc_closed_open_localTorsion_excision_shortExact (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (X Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.IsProper Z.hom]
    (i : Z.left ⟶ X.left)
    (hi_cl : AlgebraicGeometry.IsClosedImmersion i)
    (hi_hom : i ≫ X.hom = Z.hom)
    (U : X.left.Opens)
    (hU : (U : Set X.left) = (Set.range i.base)ᶜ)
    [_hc : (weilEtaleSitePullback i).IsContinuous
      X.left.smallEtaleTopology Z.left.smallEtaleTopology]
    [_hr : ((weilEtaleSitePullback i).sheafPushforwardContinuous
      AddCommGrpCat.{u} X.left.smallEtaleTopology Z.left.smallEtaleTopology).IsRightAdjoint]
    (T₁ : Z.left.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
    (T₂ : X.left.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂) :
    let m₀ := ℓ ^ (r + 1)
    let U_et : X.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι
      (inferInstance : AlgebraicGeometry.Etale U.ι)
    let adj_i := (weilEtaleSitePullback i).sheafAdjunctionContinuous
      AddCommGrpCat.{u} X.left.smallEtaleTopology Z.left.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
    let κ_U := weilEtaleLocalTorsionCounit X.left m₀ U_et
    let u_i := (adj_i.homEquiv (weilEtaleTorsionSheaf X.left m₀)
      (weilEtaleTorsionSheaf Z.left m₀))
      (weilEtaleConstPullbackHom i hT₁ hT₂ AM)
    (∃ hκu : κ_U ≫ u_i = 0, (CategoryTheory.ShortComplex.mk κ_U u_i hκu).ShortExact) ∧
    (∀ p : ℕ, 1 ≤ p →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage i p (weilEtaleTorsionSheaf Z.left m₀))) :=
by
  let _ := hℓ
  have : AlgebraicGeometry.IsClosedImmersion i := hi_cl
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have instPB : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong P_et h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have instSBC : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have := AddCommGrpCat.FilteredColimits.forget_preservesFilteredColimits.{u}
  let emptySieve : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C] (V : C),
      CategoryTheory.Sieve V :=
    fun _ => { arrows := fun _ _ => False, downward_closed := fun h _ => False.elim h }

  
  
  
  have hSite : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      ∃ (hc : (weilEtaleSitePullback h).IsContinuous
          X₂.smallEtaleTopology X₁.smallEtaleTopology),
        (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback h) AddCommGrpCat.{u} _
          X₂.smallEtaleTopology X₁.smallEtaleTopology hc).IsRightAdjoint := by
    intro X₁ X₂ h
    have := instPB h
    have := instSBC h
    let B : CategoryTheory.Functor X₂.Etale X₁.Etale := weilEtaleSitePullback h
    have : CategoryTheory.Limits.HasTerminal X₂.Etale :=
      (weilEtaleIdTerminalIsTerminal.{u} X₂).hasTerminal
    have : CategoryTheory.Limits.HasFiniteLimits X₂.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : CategoryTheory.Limits.PreservesFiniteLimits B :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback P_et h
    have : CategoryTheory.RepresentablyFlat B :=
      CategoryTheory.flat_of_preservesFiniteLimits B
    have hCompat : CategoryTheory.CompatiblePreserving X₁.smallEtaleTopology B :=
      CategoryTheory.compatiblePreservingOfFlat X₁.smallEtaleTopology B
    have hCov : CategoryTheory.CoverPreserving X₂.smallEtaleTopology X₁.smallEtaleTopology B := by
      refine ⟨fun {U₀ S} hS => ?_⟩
      have hTop₂ :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) X₂ (le_refl P_et)
      have hTop₁ :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) X₁ (le_refl P_et)
      have hS₁ : S ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck U₀ := by
        change S ∈ X₂.smallGrothendieckTopology P_et U₀ at hS
        rwa [hTop₂] at hS
      have hS' :=
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) (S := X₂) U₀ S).mp hS₁
      change S.functorPushforward B ∈ X₁.smallGrothendieckTopology P_et (B.obj U₀)
      rw [hTop₁]
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := X₁) (B.obj U₀) (S.functorPushforward B)).mpr ?_
      intro z
      let fstU := CategoryTheory.Limits.pullback.fst U₀.hom h
      obtain ⟨Y, f, y, hfS, _, hy⟩ := hS' (fstU.base z)
      have hBf_mem : (S.functorPushforward B).arrows (B.map f) :=
        CategoryTheory.Sieve.image_mem_functorPushforward B S hfS
      have hBf_et : P_et (B.map f).left :=
        CategoryTheory.MorphismProperty.of_postcomp P_et (B.map f).left (B.obj U₀).hom
          (B.obj U₀).prop (by rw [CategoryTheory.MorphismProperty.Over.w (B.map f)]; exact (B.obj Y).prop)
      have hOuter : CategoryTheory.IsPullback
          ((B.map f).left ≫ (B.obj U₀).hom) (CategoryTheory.Limits.pullback.fst Y.hom h)
          h (f.left ≫ U₀.hom) := by
        rw [CategoryTheory.MorphismProperty.Over.w (B.map f), CategoryTheory.MorphismProperty.Over.w f]
        exact (CategoryTheory.IsPullback.of_hasPullback Y.hom h).flip
      have hmap := CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ h f
      have hCommSq : (B.map f).left ≫ fstU =
          CategoryTheory.Limits.pullback.fst Y.hom h ≫ f.left :=
        (congrArg (· ≫ fstU) hmap).trans (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      have hRight : CategoryTheory.IsPullback (B.obj U₀).hom fstU h U₀.hom :=
        (CategoryTheory.IsPullback.of_hasPullback U₀.hom h).flip
      have hLeft : CategoryTheory.IsPullback (B.map f).left
          (CategoryTheory.Limits.pullback.fst Y.hom h) fstU f.left :=
        CategoryTheory.IsPullback.of_right hOuter hCommSq hRight
      obtain ⟨w₀, hw₀, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
      refine ⟨B.obj Y, B.map f, hLeft.isoPullback.inv.base w₀, hBf_mem, hBf_et, ?_⟩
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hLeft.isoPullback_inv_fst, hw₀]
    have hc : B.IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov
    let ι₂ : CategoryTheory.Functor X₂.AffineEtale X₂.Etale :=
      AlgebraicGeometry.Scheme.AffineEtale.Spec X₂
    let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology X₂
    let M₂ : Type u := CategoryTheory.SmallModel.{u} X₂.AffineEtale
    let e_sm : X₂.AffineEtale ≌ M₂ := CategoryTheory.equivSmallModel.{u} X₂.AffineEtale
    let J_M := e_sm.inverse.inducedTopology J_aff
    let K : CategoryTheory.Functor M₂ X₁.Etale := e_sm.inverse ⋙ (ι₂ ⋙ B)
    have : (ι₂ ⋙ B).IsContinuous J_aff X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp ι₂ B J_aff X₂.smallEtaleTopology X₁.smallEtaleTopology
    have : K.IsContinuous J_M X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp e_sm.inverse (ι₂ ⋙ B) J_M J_aff X₁.smallEtaleTopology
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} X₂.smallEtaleTopology X₁.smallEtaleTopology
    let F_ι := ι₂.sheafPushforwardContinuous AddCommGrpCat.{u} J_aff X₂.smallEtaleTopology
    let F_sm := e_sm.inverse.sheafPushforwardContinuous AddCommGrpCat.{u} J_M J_aff
    let P_K := K.sheafPushforwardContinuous AddCommGrpCat.{u} J_M X₁.smallEtaleTopology
    let E_ι := F_ι.asEquivalence
    let E_sm := F_sm.asEquivalence
    have e_comp1 : P_push ⋙ F_ι ≅
        (ι₂ ⋙ B).sheafPushforwardContinuous AddCommGrpCat.{u} J_aff X₁.smallEtaleTopology :=
      CategoryTheory.Functor.sheafPushforwardContinuousComp ι₂ B AddCommGrpCat.{u}
        J_aff X₂.smallEtaleTopology X₁.smallEtaleTopology
    have e_comp2 :
        ((ι₂ ⋙ B).sheafPushforwardContinuous AddCommGrpCat.{u} J_aff X₁.smallEtaleTopology) ⋙ F_sm ≅ P_K :=
      CategoryTheory.Functor.sheafPushforwardContinuousComp e_sm.inverse (ι₂ ⋙ B) AddCommGrpCat.{u}
        J_M J_aff X₁.smallEtaleTopology
    have e_tot : (P_push ⋙ E_ι.functor) ⋙ E_sm.functor ≅ P_K :=
      CategoryTheory.Functor.isoWhiskerRight e_comp1 E_sm.functor ≪≫ e_comp2
    have e_rhs : P_K ⋙ (E_sm.inverse ⋙ E_ι.inverse) ≅ P_push :=
      (CategoryTheory.Functor.isoWhiskerRight e_tot.symm (E_sm.inverse ⋙ E_ι.inverse)) ≪≫
      (CategoryTheory.Functor.associator _ _ _) ≪≫
      CategoryTheory.Functor.isoWhiskerLeft (P_push ⋙ E_ι.functor)
        ((CategoryTheory.Functor.associator _ _ _).symm ≪≫
          CategoryTheory.Functor.isoWhiskerRight E_sm.unitIso.symm E_ι.inverse ≪≫
          CategoryTheory.Functor.leftUnitor E_ι.inverse) ≪≫
      (CategoryTheory.Functor.associator _ _ _) ≪≫
      CategoryTheory.Functor.isoWhiskerLeft P_push E_ι.unitIso.symm ≪≫
      CategoryTheory.Functor.rightUnitor P_push
    let adj_K := K.sheafAdjunctionContinuous AddCommGrpCat.{u} J_M X₁.smallEtaleTopology
    let adj_tot := ((E_ι.toAdjunction.comp E_sm.toAdjunction).comp adj_K).ofNatIsoRight e_rhs
    exact ⟨hc, adj_tot.isRightAdjoint⟩

  have hConstPb : ∀ {Y₀ Y : AlgebraicGeometry.Scheme.{u}} (h : Y₀ ⟶ Y) (M : AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h
        ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj M)
        ((CategoryTheory.constantSheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}).obj M) := by
    intro Y₀ Y h M
    have := instPB h
    have := instSBC h
    obtain ⟨hc, hr⟩ := hSite h
    let B_h : CategoryTheory.Functor Y.Etale Y₀.Etale := weilEtaleSitePullback h
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} Y.smallEtaleTopology Y₀.smallEtaleTopology
    let pb_h := B_h.sheafPullback AddCommGrpCat.{u} Y.smallEtaleTopology Y₀.smallEtaleTopology
    let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} Y.smallEtaleTopology Y₀.smallEtaleTopology
    let T : Y.Etale := weilEtaleIdTerminal.{u} Y
    let T₀ : Y₀.Etale := weilEtaleIdTerminal.{u} Y₀
    let hT := weilEtaleIdTerminalIsTerminal.{u} Y
    let hT₀ := weilEtaleIdTerminalIsTerminal.{u} Y₀
    let pb_id_left : CategoryTheory.Limits.pullback (𝟙 Y) h ≅ Y₀ :=
      { hom := CategoryTheory.Limits.pullback.snd (𝟙 Y) h
        inv := CategoryTheory.Limits.pullback.lift h (𝟙 Y₀) (by simp)
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        inv_hom_id := CategoryTheory.Limits.pullback.lift_snd _ _ _ }
    let e_T : B_h.obj T ≅ T₀ :=
      CategoryTheory.MorphismProperty.Over.isoMk pb_id_left
        (CategoryTheory.Category.comp_id (CategoryTheory.Limits.pullback.snd (𝟙 Y) h))
    let PM_Y := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj M
    let PM_Y₀ := (CategoryTheory.Functor.const (Opposite Y₀.Etale)).obj M
    let FM_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj M
    let FM_Y₀ := (CategoryTheory.constantSheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}).obj M
    let shAdj := CategoryTheory.sheafificationAdjunction Y.smallEtaleTopology AddCommGrpCat.{u}
    let shAdj₀ := CategoryTheory.sheafificationAdjunction Y₀.smallEtaleTopology AddCommGrpCat.{u}
    let η₀ := CategoryTheory.Functor.whiskerLeft B_h.op (shAdj₀.unit.app PM_Y₀)
    let uM := (shAdj.homEquiv PM_Y (pf_h.obj FM_Y₀)).symm η₀
    let cM : pb_h.obj FM_Y ⟶ FM_Y₀ := (adj_h.homEquiv FM_Y FM_Y₀).symm uM
    let constEv : ∀ {D : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} D]
        {W₀ : D} (_ : CategoryTheory.Limits.IsTerminal W₀)
        (Q : CategoryTheory.Functor (Opposite D) AddCommGrpCat.{u}),
        (((CategoryTheory.Functor.const (Opposite D)).obj M) ⟶ Q) ≃
          (M ⟶ Q.obj (Opposite.op W₀)) :=
      fun {D} _ {W₀} hW₀ Q =>
        { toFun := fun α => α.app (Opposite.op W₀)
          invFun := fun g =>
            { app := fun W => g ≫ Q.map (hW₀.from (Opposite.unop W)).op
              naturality := fun {W₁ W₂} f => by
                dsimp
                rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, ← Q.map_comp]
                congr 2
                exact congrArg Quiver.Hom.op (hW₀.hom_ext _ _) }
          left_inv := fun α => by
            apply CategoryTheory.NatTrans.ext
            funext W
            dsimp
            have hnat := α.naturality (hW₀.from (Opposite.unop W)).op
            dsimp at hnat
            rw [CategoryTheory.Category.id_comp] at hnat
            exact hnat.symm
          right_inv := fun g => by
            dsimp
            have hid : hW₀.from W₀ = 𝟙 W₀ := hW₀.hom_ext _ _
            rw [hid]
            change g ≫ Q.map (𝟙 (Opposite.op W₀)) = g
            rw [Q.map_id, CategoryTheory.Category.comp_id] }
    have hBij : ∀ (F : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}),
        Function.Bijective (fun φ : FM_Y₀ ⟶ F => cM ≫ φ) := by
      intro F
      let E₁ : (pb_h.obj FM_Y ⟶ F) ≃ (M ⟶ F.obj.obj (Opposite.op (B_h.obj T))) :=
        (adj_h.homEquiv FM_Y F).trans
          ((shAdj.homEquiv PM_Y (pf_h.obj F)).trans (constEv hT (pf_h.obj F).obj))
      let e_map : F.obj.obj (Opposite.op T₀) ≅ F.obj.obj (Opposite.op (B_h.obj T)) :=
        F.obj.mapIso e_T.op
      let postIso : (M ⟶ F.obj.obj (Opposite.op T₀)) ≃
          (M ⟶ F.obj.obj (Opposite.op (B_h.obj T))) :=
        { toFun := fun g => g ≫ e_map.hom
          invFun := fun g => g ≫ e_map.inv
          left_inv := fun g => by simp
          right_inv := fun g => by simp }
      let E₂ : (FM_Y₀ ⟶ F) ≃ (M ⟶ F.obj.obj (Opposite.op (B_h.obj T))) :=
        (shAdj₀.homEquiv PM_Y₀ F).trans ((constEv hT₀ F.obj).trans postIso)
      have hE₁₂ : ∀ φ : FM_Y₀ ⟶ F, E₁ (cM ≫ φ) = E₂ φ := by
        intro φ
        have h1 : (adj_h.homEquiv FM_Y F) (cM ≫ φ) = uM ≫ pf_h.map φ :=
          (CategoryTheory.Adjunction.homEquiv_naturality_right adj_h cM φ).trans
            (congrArg (· ≫ pf_h.map φ) ((adj_h.homEquiv FM_Y FM_Y₀).apply_symm_apply uM))
        have h2 : (shAdj.homEquiv PM_Y (pf_h.obj F)) ((adj_h.homEquiv FM_Y F) (cM ≫ φ)) =
            η₀ ≫ (CategoryTheory.sheafToPresheaf Y.smallEtaleTopology AddCommGrpCat.{u}).map (pf_h.map φ) :=
          (congrArg (shAdj.homEquiv PM_Y (pf_h.obj F)) h1).trans
            ((CategoryTheory.Adjunction.homEquiv_naturality_right shAdj uM (pf_h.map φ)).trans
              (congrArg (· ≫ _) ((shAdj.homEquiv PM_Y (pf_h.obj FM_Y₀)).apply_symm_apply η₀)))
        have h3 : E₁ (cM ≫ φ) =
            (η₀ ≫ (CategoryTheory.sheafToPresheaf Y.smallEtaleTopology AddCommGrpCat.{u}).map
              (pf_h.map φ)).app (Opposite.op T) :=
          congrArg (fun α => α.app (Opposite.op T)) h2
        let ψ : PM_Y₀ ⟶ F.obj := (shAdj₀.homEquiv PM_Y₀ F) φ
        have hψ : ψ = shAdj₀.unit.app PM_Y₀ ≫ φ.hom :=
          CategoryTheory.Adjunction.homEquiv_unit shAdj₀ PM_Y₀ F φ
        have h3' : (η₀ ≫ (CategoryTheory.sheafToPresheaf Y.smallEtaleTopology AddCommGrpCat.{u}).map
            (pf_h.map φ)).app (Opposite.op T) = ψ.app (Opposite.op (B_h.obj T)) := by
          rw [hψ]; rfl
        have hnat := ψ.naturality e_T.hom.op
        dsimp [PM_Y₀] at hnat
        rw [CategoryTheory.Category.id_comp] at hnat
        exact (h3.trans h3').trans hnat
      have hEq : (fun φ : FM_Y₀ ⟶ F => cM ≫ φ) = (E₂.trans E₁.symm) := by
        funext φ
        exact E₁.injective ((hE₁₂ φ).trans (E₁.apply_symm_apply (E₂ φ)).symm)
      rw [hEq]
      exact (E₂.trans E₁.symm).bijective
    obtain ⟨dM, h_cd⟩ := (hBij (pb_h.obj FM_Y)).2 (𝟙 (pb_h.obj FM_Y))
    dsimp only at h_cd
    have h_dc : dM ≫ cM = 𝟙 FM_Y₀ := by
      apply (hBij FM_Y₀).1
      dsimp only
      rw [← CategoryTheory.Category.assoc, h_cd, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.comp_id]
    exact ⟨hc, hr, ⟨{ hom := cM, inv := dM, hom_inv_id := h_cd, inv_hom_id := h_dc }⟩⟩

  
  
  
  let fibOf : ∀ (W : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W) → CategoryTheory.Functor W.Etale (Type u) :=
    fun W Ω _ _ w =>
      { obj := fun E => { e : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E.left // e ≫ E.hom = w }
        map := fun {E₁ E₂} u => TypeCat.ofHom fun e =>
          ⟨e.1 ≫ u.left, by
            rw [CategoryTheory.Category.assoc, CategoryTheory.MorphismProperty.Over.w u, e.2]⟩
        map_id := fun E => by ext e; exact CategoryTheory.Category.comp_id e.1
        map_comp := fun u v => by ext e; exact (CategoryTheory.Category.assoc e.1 u.left v.left).symm }

  let pt : ∀ (W : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W) →
        CategoryTheory.GrothendieckTopology.Point.{u} W.smallEtaleTopology :=
    fun W Ω _ _ w =>
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let fib_w := fibOf W Ω w
      have hJoint : ∀ {E : W.Etale}, ∀ R ∈ W.smallEtaleTopology E, ∀ (e : fib_w.obj E),
          ∃ Y u, ∃ (_ : R.arrows u), ∃ e', fib_w.map u e' = e := by
        intro E R hR e
        have hTop :=
          AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
            (P := P_et) (Q := P_et) W (le_refl P_et)
        have hR₁ : R ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck E := by
          change R ∈ W.smallGrothendieckTopology P_et E at hR
          rwa [hTop] at hR
        obtain ⟨Y, u, y₀, huR, huP, hy₀⟩ :=
          (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
            (P := P_et) (Q := P_et) (S := W) E R).mp hR₁ (e.1.base default)
        have : AlgebraicGeometry.Etale u.left := huP
        let q := CategoryTheory.Limits.pullback.snd u.left e.1
        have hq_surj : Function.Surjective q.base := by
          intro s
          have hs : s = default := Subsingleton.elim s default
          have heq : u.left.base y₀ = e.1.base s := by rw [hs]; exact hy₀
          obtain ⟨z, _, hz⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₀ s heq
          exact ⟨z, hz⟩
        have hsing_mem : CategoryTheory.Presieve.singleton q ∈
            (AlgebraicGeometry.Scheme.precoverage P_et).coverings S_Ω :=
          (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff P_et q).mpr ⟨hq_surj, inferInstance⟩
        have hcov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q) ∈
            AlgebraicGeometry.Scheme.etaleTopology S_Ω :=
          CategoryTheory.Precoverage.generate_mem_toGrothendieck hsing_mem
        obtain ⟨_, _, ⟨_, g_Z, _, hsing, hfac⟩, z_Z, hz_Z⟩ :=
          (AlgebraicGeometry.Scheme.geometricFiber Ω).jointly_surjective
            (CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q)) hcov (𝟙 S_Ω)
        cases hsing
        let σ : S_Ω ⟶ CategoryTheory.Limits.pullback u.left e.1 := z_Z ≫ g_Z
        have hσq : σ ≫ q = 𝟙 S_Ω :=
          (CategoryTheory.Category.assoc z_Z g_Z q).trans ((congrArg (z_Z ≫ ·) hfac).trans hz_Z)
        let e'_mor : S_Ω ⟶ Y.left := σ ≫ CategoryTheory.Limits.pullback.fst u.left e.1
        have he'_u : e'_mor ≫ u.left = e.1 :=
          (CategoryTheory.Category.assoc σ (CategoryTheory.Limits.pullback.fst u.left e.1) u.left).trans
            ((congrArg (σ ≫ ·) (CategoryTheory.Limits.pullback.condition (f := u.left) (g := e.1))).trans
              ((CategoryTheory.Category.assoc σ q e.1).symm.trans
                ((congrArg (· ≫ e.1) hσq).trans (CategoryTheory.Category.id_comp e.1))))
        have he'_w : e'_mor ≫ Y.hom = w :=
          (congrArg (e'_mor ≫ ·) (CategoryTheory.MorphismProperty.Over.w u).symm).trans
            ((CategoryTheory.Category.assoc e'_mor u.left E.hom).symm.trans
              ((congrArg (· ≫ E.hom) he'_u).trans e.2))
        exact ⟨Y, u, huR, ⟨e'_mor, he'_w⟩, Subtype.ext he'_u⟩
      have : Nonempty fib_w.Elements :=
        ⟨CategoryTheory.Functor.elementsMk fib_w (weilEtaleIdTerminal.{u} W)
          ⟨w, CategoryTheory.Category.comp_id w⟩⟩
      have : CategoryTheory.IsCofilteredOrEmpty fib_w.Elements := by
        refine CategoryTheory.IsCofilteredOrEmpty.mk ?_ ?_
        · intro X₀ Y₀
          have : AlgebraicGeometry.Etale X₀.1.hom := X₀.1.prop
          have : AlgebraicGeometry.Etale Y₀.1.hom := Y₀.1.prop
          let fst := CategoryTheory.Limits.pullback.fst X₀.1.hom Y₀.1.hom
          let snd := CategoryTheory.Limits.pullback.snd X₀.1.hom Y₀.1.hom
          let E₁₂ : W.Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ (fst ≫ X₀.1.hom) inferInstance
          let l := CategoryTheory.Limits.pullback.lift X₀.2.1 Y₀.2.1 (X₀.2.2.trans Y₀.2.2.symm)
          let Z₀ : fib_w.Elements :=
            CategoryTheory.Functor.elementsMk fib_w E₁₂
              ⟨l, by
                change l ≫ fst ≫ X₀.1.hom = w
                rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
                exact X₀.2.2⟩
          let π₁ : Z₀ ⟶ X₀ :=
            ⟨CategoryTheory.MorphismProperty.Over.homMk fst rfl,
              Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _)⟩
          let π₂ : Z₀ ⟶ Y₀ :=
            ⟨CategoryTheory.MorphismProperty.Over.homMk snd CategoryTheory.Limits.pullback.condition.symm,
              Subtype.ext (CategoryTheory.Limits.pullback.lift_snd _ _ _)⟩
          exact ⟨Z₀, π₁, π₂, trivial⟩
        · intro X₀ Y₀ u v
          have : AlgebraicGeometry.Etale X₀.1.hom := X₀.1.prop
          have : AlgebraicGeometry.Etale Y₀.1.hom := Y₀.1.prop
          have hu_pt : X₀.2.1 ≫ u.1.left = Y₀.2.1 := congrArg Subtype.val u.2
          have hv_pt : X₀.2.1 ≫ v.1.left = Y₀.2.1 := congrArg Subtype.val v.2
          let Δ := CategoryTheory.Limits.pullback.diagonal Y₀.1.hom
          have : AlgebraicGeometry.IsOpenImmersion Δ :=
            AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal Y₀.1.hom
          let uv := CategoryTheory.Limits.pullback.lift u.1.left v.1.left
            ((CategoryTheory.MorphismProperty.Over.w u.1).trans
              (CategoryTheory.MorphismProperty.Over.w v.1).symm)
          let p₁ := CategoryTheory.Limits.pullback.fst Δ uv
          let j₀ := CategoryTheory.Limits.pullback.snd Δ uv
          let E₀ : W.Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ (j₀ ≫ X₀.1.hom) inferInstance
          have heq_pt : Y₀.2.1 ≫ Δ = X₀.2.1 ≫ uv := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · dsimp [Δ, uv]
              rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
                CategoryTheory.Limits.pullback.lift_fst, hu_pt]
            · dsimp [Δ, uv]
              rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
                CategoryTheory.Limits.pullback.lift_snd, hv_pt]
          let e₀_mor := CategoryTheory.Limits.pullback.lift Y₀.2.1 X₀.2.1 heq_pt
          let Z₀ : fib_w.Elements :=
            CategoryTheory.Functor.elementsMk fib_w E₀
              ⟨e₀_mor, by
                change e₀_mor ≫ j₀ ≫ X₀.1.hom = w
                rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
                exact X₀.2.2⟩
          let j_et : E₀ ⟶ X₀.1 := CategoryTheory.MorphismProperty.Over.homMk j₀ rfl
          let j_elem : Z₀ ⟶ X₀ :=
            ⟨j_et, Subtype.ext (CategoryTheory.Limits.pullback.lift_snd _ _ _)⟩
          refine ⟨Z₀, j_elem, ?_⟩
          ext1
          apply (AlgebraicGeometry.Scheme.Etale.forget W).map_injective
          refine CategoryTheory.Over.OverMorphism.ext ?_
          change j₀ ≫ u.1.left = j₀ ≫ v.1.left
          have hcond : p₁ ≫ Δ = j₀ ≫ uv := CategoryTheory.Limits.pullback.condition
          have h1 : p₁ = j₀ ≫ u.1.left := by
            have hc1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst Y₀.1.hom Y₀.1.hom) hcond
            dsimp [Δ, uv] at hc1
            rwa [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst] at hc1
          have h2 : p₁ = j₀ ≫ v.1.left := by
            have hc2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd Y₀.1.hom Y₀.1.hom) hcond
            dsimp [Δ, uv] at hc2
            rwa [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd] at hc2
          exact h1.symm.trans h2
      have hcof : CategoryTheory.IsCofiltered fib_w.Elements := CategoryTheory.IsCofiltered.mk
      have hism : CategoryTheory.InitiallySmall.{u} fib_w.Elements := by
        let ι_aff : CategoryTheory.Functor W.AffineEtale W.Etale :=
          AlgebraicGeometry.Scheme.AffineEtale.Spec W
        let M : Type u := CategoryTheory.SmallModel.{u} W.AffineEtale
        let e_M : W.AffineEtale ≌ M := CategoryTheory.equivSmallModel.{u} W.AffineEtale
        let Idx : Type u := Sigma fun (m : M) => fib_w.obj (ι_aff.obj (e_M.inverse.obj m))
        let φ : Idx → fib_w.Elements := fun p => CategoryTheory.Functor.elementsMk fib_w _ p.2
        have : Small.{u} ↑(Set.range φ) := small_range φ
        refine CategoryTheory.initiallySmall_of_small_weakly_initial_set (Set.range φ) ?_
        intro X₀
        obtain ⟨Y, u, ⟨⟨A, f_lift, g_map, hfac⟩⟩, e_Y, he_Y⟩ :=
          hJoint (CategoryTheory.Sieve.coverByImage ι_aff X₀.1)
            (CategoryTheory.Functor.is_cover_of_isCoverDense ι_aff W.smallEtaleTopology X₀.1) X₀.2
        let e_A : fib_w.obj (ι_aff.obj A) := fib_w.map f_lift e_Y
        let m : M := e_M.functor.obj A
        let iso_m : ι_aff.obj (e_M.inverse.obj m) ≅ ι_aff.obj A :=
          ι_aff.mapIso (e_M.unitIso.app A).symm
        let e_m : fib_w.obj (ι_aff.obj (e_M.inverse.obj m)) := fib_w.map iso_m.inv e_A
        refine ⟨φ ⟨m, e_m⟩, ⟨⟨m, e_m⟩, rfl⟩, ⟨⟨iso_m.hom ≫ g_map, ?_⟩⟩⟩
        apply Subtype.ext
        have h_inv_hom : iso_m.inv.left ≫ iso_m.hom.left = 𝟙 _ :=
          congrArg CategoryTheory.CommaMorphism.left
            (((AlgebraicGeometry.Scheme.Etale.forget W).map_comp iso_m.inv iso_m.hom).symm.trans
              ((congrArg (AlgebraicGeometry.Scheme.Etale.forget W).map iso_m.inv_hom_id).trans
                ((AlgebraicGeometry.Scheme.Etale.forget W).map_id _)))
        have h_fg : f_lift.left ≫ g_map.left = u.left :=
          congrArg CategoryTheory.CommaMorphism.left
            (((AlgebraicGeometry.Scheme.Etale.forget W).map_comp f_lift g_map).symm.trans
              (congrArg (AlgebraicGeometry.Scheme.Etale.forget W).map hfac))
        have h_hm : (iso_m.hom ≫ g_map).left = iso_m.hom.left ≫ g_map.left := rfl
        change ((e_Y.1 ≫ f_lift.left) ≫ iso_m.inv.left) ≫ (iso_m.hom ≫ g_map).left = X₀.2.1
        rw [h_hm, CategoryTheory.Category.assoc (e_Y.1 ≫ f_lift.left),
          ← CategoryTheory.Category.assoc iso_m.inv.left, h_inv_hom,
          CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, h_fg]
        exact congrArg Subtype.val he_Y
      CategoryTheory.GrothendieckTopology.Point.mk fib_w hcof hism hJoint

  have hCons : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (G : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
        CategoryTheory.Limits.IsZero ((pt W Ω w).sheafFiber.obj G)) →
      CategoryTheory.Limits.IsZero G := by
    intro W G hStalks
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply CategoryTheory.Sheaf.hom_ext
    ext E_op s
    let E : W.Etale := E_op.unop
    change (s : G.obj.obj (Opposite.op E)) = 0
    let R_s : CategoryTheory.Sieve E :=
      { arrows := fun _ u => G.obj.map u.op s = 0
        downward_closed := by
          intro Y₀ Z₀ u hu v
          rw [op_comp, G.obj.map_comp, AddCommGrpCat.comp_apply, hu, map_zero] }
    have hRs : R_s ∈ W.smallEtaleTopology E := by
      have hTop :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) W (le_refl P_et)
      change R_s ∈ W.smallGrothendieckTopology P_et E
      rw [hTop]
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := W) E R_s).mpr ?_
      intro x
      let Ω_x : Type u := AlgebraicClosure (E.left.residueField x)
      let x_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω_x) ⟶ E.left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (E.left.residueField x) Ω_x)) ≫
          E.left.fromSpecResidueField x
      let w_x : AlgebraicGeometry.Spec (CommRingCat.of Ω_x) ⟶ W := x_bar ≫ E.hom
      let Φ_x := pt W Ω_x w_x
      have hZero_x : CategoryTheory.Limits.IsZero (Φ_x.sheafFiber.obj G) := hStalks Ω_x w_x
      let pt_E : Φ_x.fiber.obj E := ⟨x_bar, rfl⟩
      have hι0 : Φ_x.toPresheafFiber E pt_E G.obj = 0 := hZero_x.eq_of_tgt _ 0
      have hrep_eq : (Φ_x.toPresheafFiber E pt_E G.obj) s =
          (Φ_x.toPresheafFiber E pt_E G.obj) 0 := by rw [hι0]; rfl
      obtain ⟨E', u_x, pt_E', hu_pt, hu_eq⟩ :=
        (Φ_x.toPresheafFiber_eq_iff' E pt_E s (0 : G.obj.obj (Opposite.op E))).mp hrep_eq
      have hu_s0 : G.obj.map u_x.op s = 0 := by rw [hu_eq, map_zero]
      have hu_et : P_et u_x.left :=
        CategoryTheory.MorphismProperty.of_postcomp P_et u_x.left E.hom E.prop
          (by rw [CategoryTheory.MorphismProperty.Over.w u_x]; exact E'.prop)
      have hu_base : u_x.left.base (pt_E'.1.base default) = x := by
        have hcomp_pt : pt_E'.1 ≫ u_x.left = x_bar := congrArg Subtype.val hu_pt
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hcomp_pt]
        dsimp [x_bar]
        exact Set.mem_singleton_iff.mp
          (AlgebraicGeometry.Scheme.range_fromSpecResidueField x ▸ ⟨_, rfl⟩)
      exact ⟨E', u_x, pt_E'.1.base default, hu_s0, hu_et, hu_base⟩
    exact G.isSeparated E R_s hRs s 0 (fun _ u hu => by
      change G.obj.map u.op s = G.obj.map u.op 0
      rw [map_zero]; exact hu)

  have hIsoOfStalkBij : ∀ (W : AlgebraicGeometry.Scheme.{u})
      {G₁ G₂ : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}}
      (Φ : G₁ ⟶ G₂),
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
        Function.Bijective (((pt W Ω w).sheafFiber (A := AddCommGrpCat.{u})).map Φ).hom) →
      CategoryTheory.IsIso Φ := by
    intro W G₁ G₂ Φ hBij
    have hIsoStalk : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
        CategoryTheory.IsIso (((pt W Ω w).sheafFiber (A := AddCommGrpCat.{u})).map Φ) := by
      intro Ω _ _ w
      let f_w := ((pt W Ω w).sheafFiber (A := AddCommGrpCat.{u})).map Φ
      have : CategoryTheory.Mono f_w := (AddCommGrpCat.mono_iff_injective f_w).mpr (hBij Ω w).1
      have : CategoryTheory.Epi f_w := (AddCommGrpCat.epi_iff_surjective f_w).mpr (hBij Ω w).2
      exact CategoryTheory.isIso_of_mono_of_epi f_w
    have hKerZero : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel Φ) := by
      apply hCons W (CategoryTheory.Limits.kernel Φ)
      intro Ω _ _ w
      let F_w := (pt W Ω w).sheafFiber (A := AddCommGrpCat.{u})
      have : CategoryTheory.IsIso (F_w.map Φ) := hIsoStalk Ω w
      have hZ : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel (F_w.map Φ)) :=
        CategoryTheory.Limits.isZero_kernel_of_mono (F_w.map Φ)
      exact hZ.of_iso (CategoryTheory.Limits.PreservesKernel.iso F_w Φ)
    have hCokerZero : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel Φ) := by
      apply hCons W (CategoryTheory.Limits.cokernel Φ)
      intro Ω _ _ w
      let F_w := (pt W Ω w).sheafFiber (A := AddCommGrpCat.{u})
      have : CategoryTheory.IsIso (F_w.map Φ) := hIsoStalk Ω w
      have hπ0 : CategoryTheory.Limits.cokernel.π (F_w.map Φ) = 0 := by
        rw [← CategoryTheory.cancel_epi (F_w.map Φ),
          CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero]
      have hZ : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel (F_w.map Φ)) := by
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero,
          ← CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π (F_w.map Φ)),
          CategoryTheory.Category.comp_id, CategoryTheory.Limits.comp_zero, hπ0]
      exact hZ.of_iso (CategoryTheory.Limits.PreservesCokernel.iso F_w Φ)
    have : CategoryTheory.Mono Φ := CategoryTheory.Preadditive.mono_of_isZero_kernel Φ hKerZero
    have : CategoryTheory.Epi Φ := CategoryTheory.Preadditive.epi_of_isZero_cokernel Φ hCokerZero
    exact CategoryTheory.isIso_of_mono_of_epi Φ

  have hPi_id : ∀ {I₁ I₂ : Type u} (f₁ : I₂ → I₁) (f₂ : I₁ → I₂)
      (_ : ∀ t : I₁, f₁ (f₂ t) = t) (M : AddCommGrpCat.{u}),
      CategoryTheory.Limits.Pi.lift
          (fun s : I₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (f₁ s)) ≫
        CategoryTheory.Limits.Pi.lift
          (fun t : I₁ => CategoryTheory.Limits.Pi.π (fun _ : I₂ => M) (f₂ t)) =
      𝟙 (∏ᶜ fun _ : I₁ => M) := by
    intro I₁ I₂ f₁ f₂ hfg M
    apply CategoryTheory.Limits.Pi.hom_ext
    intro t
    simp [hfg t]
  have hPi_map' : ∀ {I₁ I₂ J₁ J₂ : Type u} (fI : I₂ → I₁) (fJ : J₂ → J₁)
      (p₁ : J₁ → I₁) (p₂ : J₂ → I₂) (_ : ∀ s : J₂, p₁ (fJ s) = fI (p₂ s))
      (M : AddCommGrpCat.{u}),
      CategoryTheory.Limits.Pi.map' p₁ (fun _ : J₁ => 𝟙 M) ≫
        CategoryTheory.Limits.Pi.lift
          (fun s : J₂ => CategoryTheory.Limits.Pi.π (fun _ : J₁ => M) (fJ s)) =
      CategoryTheory.Limits.Pi.lift
          (fun s : I₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (fI s)) ≫
        CategoryTheory.Limits.Pi.map' p₂ (fun _ : J₂ => 𝟙 M) := by
    intro I₁ I₂ J₁ J₂ fI fJ p₁ p₂ hp M
    apply CategoryTheory.Limits.Pi.hom_ext
    intro s
    simp [hp s]
  have hPi_map : ∀ {I₁ I₂ : Type u} (fI : I₂ → I₁) {M₁ M₂ : AddCommGrpCat.{u}} (g : M₁ ⟶ M₂),
      CategoryTheory.Limits.Pi.map (fun _ : I₁ => g) ≫
        CategoryTheory.Limits.Pi.lift
          (fun s : I₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M₂) (fI s)) =
      CategoryTheory.Limits.Pi.lift
          (fun s : I₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M₁) (fI s)) ≫
        CategoryTheory.Limits.Pi.map (fun _ : I₂ => g) := by
    intro I₁ I₂ fI M₁ M₂ g
    apply CategoryTheory.Limits.Pi.hom_ext
    intro s
    simp

  have hStalkZeroOfPullZero : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
      (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h F₂ F₁ →
      CategoryTheory.Limits.IsZero F₁ →
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (x₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X₁),
        CategoryTheory.Limits.IsZero
          (((pt X₂ Ω (x₁ ≫ h)).sheafFiber (A := AddCommGrpCat.{u})).obj F₂) := by
    rintro X₁ X₂ h F₂ F₁ ⟨hc, hr, ⟨e_pb⟩⟩ hZ₁ Ω _ _ x₁
    have := instPB h
    have := instSBC h
    have := hc
    have := hr
    let B : CategoryTheory.Functor X₂.Etale X₁.Etale := weilEtaleSitePullback h
    let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let pb := B.sheafPullback AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let adj := B.sheafAdjunctionContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let Φ₁ := pt X₁ Ω x₁
    let Φ₂ := pt X₂ Ω (x₁ ≫ h)
    let α : ∀ (E₂ : X₂.Etale), Φ₁.fiber.obj (B.obj E₂) ≃ Φ₂.fiber.obj E₂ := fun E₂ =>
      { toFun := fun t =>
          ⟨t.1 ≫ CategoryTheory.Limits.pullback.fst E₂.hom h,
            (CategoryTheory.Category.assoc t.1
              (CategoryTheory.Limits.pullback.fst E₂.hom h) E₂.hom).trans
              ((congrArg (t.1 ≫ ·)
                (CategoryTheory.Limits.pullback.condition (f := E₂.hom) (g := h))).trans
                ((CategoryTheory.Category.assoc t.1
                  (CategoryTheory.Limits.pullback.snd E₂.hom h) h).symm.trans
                  (congrArg (· ≫ h) t.2)))⟩
        invFun := fun s =>
          ⟨CategoryTheory.Limits.pullback.lift s.1 x₁ s.2,
            CategoryTheory.Limits.pullback.lift_snd s.1 x₁ s.2⟩
        left_inv := fun t =>
          Subtype.ext
            (CategoryTheory.Limits.pullback.hom_ext
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans t.2.symm))
        right_inv := fun s => Subtype.ext (CategoryTheory.Limits.pullback.lift_fst s.1 x₁ s.2) }
    have hα_symm_nat : ∀ {E₂ E₂' : X₂.Etale} (u : E₂ ⟶ E₂') (s : Φ₂.fiber.obj E₂),
        Φ₁.fiber.map (B.map u) ((α E₂).symm s) = (α E₂').symm (Φ₂.fiber.map u s) := by
      intro E₂ E₂' u s
      apply Subtype.ext
      have hsu : (s.1 ≫ u.left) ≫ E₂'.hom = x₁ ≫ h :=
        (CategoryTheory.Category.assoc s.1 u.left E₂'.hom).trans
          ((congrArg (s.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w u)).trans s.2)
      change CategoryTheory.Limits.pullback.lift s.1 x₁ s.2 ≫ (B.map u).left =
        CategoryTheory.Limits.pullback.lift (s.1 ≫ u.left) x₁ hsu
      have hmap := CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ h u
      refine CategoryTheory.Limits.pullback.hom_ext ?_ ?_
      · exact (CategoryTheory.Category.assoc
            (CategoryTheory.Limits.pullback.lift s.1 x₁ s.2) (B.map u).left
            (CategoryTheory.Limits.pullback.fst E₂'.hom h)).trans
          ((congrArg (CategoryTheory.Limits.pullback.lift s.1 x₁ s.2 ≫ ·)
              ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst E₂'.hom h) hmap).trans
                (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
            ((CategoryTheory.Category.assoc
                (CategoryTheory.Limits.pullback.lift s.1 x₁ s.2)
                (CategoryTheory.Limits.pullback.fst E₂.hom h) u.left).symm.trans
              ((congrArg (· ≫ u.left)
                  (CategoryTheory.Limits.pullback.lift_fst s.1 x₁ s.2)).trans
                (CategoryTheory.Limits.pullback.lift_fst (s.1 ≫ u.left) x₁ hsu).symm)))
      · exact (CategoryTheory.Category.assoc
            (CategoryTheory.Limits.pullback.lift s.1 x₁ s.2) (B.map u).left
            (CategoryTheory.Limits.pullback.snd E₂'.hom h)).trans
          ((congrArg (CategoryTheory.Limits.pullback.lift s.1 x₁ s.2 ≫ ·)
              (CategoryTheory.MorphismProperty.Over.w (B.map u))).trans
            ((CategoryTheory.Limits.pullback.lift_snd s.1 x₁ s.2).trans
              (CategoryTheory.Limits.pullback.lift_snd (s.1 ≫ u.left) x₁ hsu).symm))
    let hom_app : ∀ (M : AddCommGrpCat.{u}) (j : (X₂.Etale)ᵒᵖ),
        ((pf.obj (Φ₁.skyscraperSheafFunctor.obj M)).obj).obj j ⟶
          ((Φ₂.skyscraperSheafFunctor.obj M).obj).obj j :=
      fun M j => CategoryTheory.Limits.Pi.lift (fun (s : Φ₂.fiber.obj j.unop) =>
        CategoryTheory.Limits.Pi.π (fun (_ : Φ₁.fiber.obj (B.obj j.unop)) => M) ((α j.unop).symm s))
    let inv_app : ∀ (M : AddCommGrpCat.{u}) (j : (X₂.Etale)ᵒᵖ),
        ((Φ₂.skyscraperSheafFunctor.obj M).obj).obj j ⟶
          ((pf.obj (Φ₁.skyscraperSheafFunctor.obj M)).obj).obj j :=
      fun M j => CategoryTheory.Limits.Pi.lift (fun (t : Φ₁.fiber.obj (B.obj j.unop)) =>
        CategoryTheory.Limits.Pi.π (fun (_ : Φ₂.fiber.obj j.unop) => M) (α j.unop t))
    let hom_nat : ∀ (M : AddCommGrpCat.{u}),
        (pf.obj (Φ₁.skyscraperSheafFunctor.obj M)).obj ⟶
          (Φ₂.skyscraperSheafFunctor.obj M).obj :=
      fun M =>
        { app := hom_app M
          naturality := fun j₁ j₂ f => by
            have hm₁ := CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map
              Φ₁ M (B.map f.unop).op
            have hm₂ := CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map
              Φ₂ M f
            exact (congrArg (· ≫ hom_app M j₂) hm₁).trans
              ((hPi_map' (α j₁.unop).symm (α j₂.unop).symm
                  (Φ₁.fiber.map (B.map f.unop)) (Φ₂.fiber.map f.unop)
                  (fun s => hα_symm_nat f.unop s) M).trans
                (congrArg (hom_app M j₁ ≫ ·) hm₂.symm)) }
    let inv_nat : ∀ (M : AddCommGrpCat.{u}),
        (Φ₂.skyscraperSheafFunctor.obj M).obj ⟶
          (pf.obj (Φ₁.skyscraperSheafFunctor.obj M)).obj :=
      fun M =>
        { app := inv_app M
          naturality := fun j₁ j₂ f => by
            have hm₁ := CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map
              Φ₁ M (B.map f.unop).op
            have hm₂ := CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map
              Φ₂ M f
            have hα_nat : ∀ t : Φ₁.fiber.obj (B.obj j₂.unop),
                Φ₂.fiber.map f.unop (α j₂.unop t) = α j₁.unop (Φ₁.fiber.map (B.map f.unop) t) := by
              intro t
              apply (α j₁.unop).symm.injective
              rw [(α j₁.unop).symm_apply_apply, ← hα_symm_nat f.unop (α j₂.unop t),
                (α j₂.unop).symm_apply_apply]
            exact (congrArg (· ≫ inv_app M j₂) hm₂).trans
              ((hPi_map' (α j₁.unop) (α j₂.unop)
                  (Φ₂.fiber.map f.unop) (Φ₁.fiber.map (B.map f.unop))
                  hα_nat M).trans
                (congrArg (inv_app M j₁ ≫ ·) hm₁.symm)) }
    let e_sky : Φ₁.skyscraperSheafFunctor ⋙ pf ≅ Φ₂.skyscraperSheafFunctor :=
      CategoryTheory.NatIso.ofComponents
        (fun M =>
          { hom := ⟨hom_nat M⟩
            inv := ⟨inv_nat M⟩
            hom_inv_id := by
              apply CategoryTheory.Sheaf.hom_ext
              ext j : 2
              exact hPi_id (α j.unop).symm (α j.unop) (α j.unop).symm_apply_apply M
            inv_hom_id := by
              apply CategoryTheory.Sheaf.hom_ext
              ext j : 2
              exact hPi_id (α j.unop) (α j.unop).symm (α j.unop).apply_symm_apply M })
        (fun {M₁ M₂} g => by
          apply CategoryTheory.Sheaf.hom_ext
          ext j : 2
          have hg₁ := CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app
            Φ₁ g (Opposite.op (B.obj j.unop))
          have hg₂ := CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app
            Φ₂ g j
          exact (congrArg (· ≫ hom_app M₂ j) hg₁).trans
            ((hPi_map (α j.unop).symm g).trans (congrArg (hom_app M₁ j ≫ ·) hg₂.symm)))
    let e_fib : pb ⋙ Φ₁.sheafFiber (A := AddCommGrpCat.{u}) ≅
        Φ₂.sheafFiber (A := AddCommGrpCat.{u}) :=
      ((adj.comp (Φ₁.skyscraperSheafAdjunction (A := AddCommGrpCat.{u}))).ofNatIsoRight
        e_sky).leftAdjointUniq (Φ₂.skyscraperSheafAdjunction (A := AddCommGrpCat.{u}))
    exact CategoryTheory.Limits.IsZero.of_iso
      ((Φ₁.sheafFiber (A := AddCommGrpCat.{u})).map_isZero hZ₁)
      (((Φ₁.sheafFiber (A := AddCommGrpCat.{u})).mapIso e_pb.symm).trans (e_fib.app F₂)).symm

  have hUnitStalkIso : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (Φ : CategoryTheory.GrothendieckTopology.Point.{u} W.smallEtaleTopology)
      (P : CategoryTheory.Functor (Opposite W.Etale) AddCommGrpCat.{u}),
      CategoryTheory.IsIso
        ((Φ.presheafFiber (A := AddCommGrpCat.{u})).map
          ((CategoryTheory.sheafificationAdjunction W.smallEtaleTopology AddCommGrpCat.{u}).unit.app P)) := by
    intro W Φ P
    let shAdj := CategoryTheory.sheafificationAdjunction W.smallEtaleTopology AddCommGrpCat.{u}
    let P_sh := (CategoryTheory.presheafToSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj P
    let η_P : P ⟶ P_sh.obj := shAdj.unit.app P
    let u_P : (Φ.presheafFiber (A := AddCommGrpCat.{u})).obj P ⟶
        (Φ.sheafFiber (A := AddCommGrpCat.{u})).obj P_sh :=
      (Φ.presheafFiber (A := AddCommGrpCat.{u})).map η_P
    let adj_pre := Φ.skyscraperPresheafAdjunction (A := AddCommGrpCat.{u})
    let adj_sh := Φ.skyscraperSheafAdjunction (A := AddCommGrpCat.{u})
    have hBij : ∀ (M : AddCommGrpCat.{u}),
        Function.Bijective (fun f : (Φ.sheafFiber (A := AddCommGrpCat.{u})).obj P_sh ⟶ M => u_P ≫ f) := by
      intro M
      let E₁ : ((Φ.sheafFiber (A := AddCommGrpCat.{u})).obj P_sh ⟶ M) ≃
          (P_sh ⟶ Φ.skyscraperSheafFunctor.obj M) :=
        adj_sh.homEquiv P_sh M
      let E₂ : (P_sh ⟶ Φ.skyscraperSheafFunctor.obj M) ≃
          (P ⟶ Φ.skyscraperPresheafFunctor.obj M) :=
        shAdj.homEquiv P (Φ.skyscraperSheafFunctor.obj M)
      let E₃ : (P ⟶ Φ.skyscraperPresheafFunctor.obj M) ≃
          ((Φ.presheafFiber (A := AddCommGrpCat.{u})).obj P ⟶ M) :=
        (adj_pre.homEquiv P M).symm
      have hEq : (fun f : (Φ.sheafFiber (A := AddCommGrpCat.{u})).obj P_sh ⟶ M => u_P ≫ f) =
          E₃ ∘ E₂ ∘ E₁ := by
        funext f
        apply (adj_pre.homEquiv P M).injective
        dsimp only [Function.comp_apply, E₃]
        rw [(adj_pre.homEquiv P M).apply_symm_apply]
        have h1 : (adj_pre.homEquiv P M) (u_P ≫ f) = η_P ≫ (adj_pre.homEquiv P_sh.obj M) f :=
          adj_pre.homEquiv_naturality_left η_P f
        have h2 : E₂ (E₁ f) = η_P ≫ (E₁ f).hom :=
          CategoryTheory.Adjunction.homEquiv_unit shAdj P (Φ.skyscraperSheafFunctor.obj M) (E₁ f)
        rw [h1, h2]
        congr 1
      rw [hEq]
      exact E₃.bijective.comp (E₂.bijective.comp E₁.bijective)
    obtain ⟨v_P, hv₁⟩ := (hBij ((Φ.presheafFiber (A := AddCommGrpCat.{u})).obj P)).2 (𝟙 _)
    dsimp only at hv₁
    have hv₂ : v_P ≫ u_P = 𝟙 _ := by
      apply (hBij _).1
      dsimp only
      exact (CategoryTheory.Category.assoc u_P v_P u_P).symm.trans
        ((congrArg (· ≫ u_P) hv₁).trans
          ((CategoryTheory.Category.id_comp u_P).trans (CategoryTheory.Category.comp_id u_P).symm))
    exact ⟨⟨v_P, hv₁, hv₂⟩⟩

  have hConstPreStalkIso : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W)
      (A : AddCommGrpCat.{u}),
      let Φ := pt W Ω w
      let P_W := (CategoryTheory.Functor.const (Opposite W.Etale)).obj A
      let pt_T : Φ.fiber.obj (weilEtaleIdTerminal.{u} W) := ⟨w, CategoryTheory.Category.comp_id w⟩
      (∀ (E : W.Etale) (pt_E : Φ.fiber.obj E),
        Φ.toPresheafFiber E pt_E P_W = Φ.toPresheafFiber (weilEtaleIdTerminal.{u} W) pt_T P_W) ∧
      CategoryTheory.IsIso (Φ.toPresheafFiber (weilEtaleIdTerminal.{u} W) pt_T P_W) := by
    intro W Ω _ _ w A Φ P_W pt_T
    have hAll : ∀ (E : W.Etale) (pt_E : Φ.fiber.obj E),
        Φ.toPresheafFiber E pt_E P_W = Φ.toPresheafFiber (weilEtaleIdTerminal.{u} W) pt_T P_W := by
      intro E pt_E
      let u_E : E ⟶ weilEtaleIdTerminal.{u} W :=
        (weilEtaleIdTerminalIsTerminal.{u} W).from E
      have hu_left : u_E.left = E.hom :=
        (CategoryTheory.Category.comp_id u_E.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w u_E)
      have hu_pt : Φ.fiber.map u_E pt_E = pt_T :=
        Subtype.ext ((congrArg (pt_E.1 ≫ ·) hu_left).trans pt_E.2)
      have hw := Φ.toPresheafFiber_w u_E pt_E P_W
      dsimp [P_W] at hw
      rw [CategoryTheory.Category.id_comp, hu_pt] at hw
      exact hw
    refine ⟨hAll, ?_⟩
    let c_const : ∀ (E : W.Etale), Φ.fiber.obj E → (P_W.obj (Opposite.op E) ⟶ A) :=
      fun _ _ => 𝟙 A
    have hc_const : ∀ ⦃E' E : W.Etale⦄ (g : E' ⟶ E) (p' : Φ.fiber.obj E'),
        P_W.map g.op ≫ c_const E' p' = c_const E (Φ.fiber.map g p') :=
      fun _ _ _ _ => CategoryTheory.Category.id_comp _
    let ι_A : A ⟶ (Φ.presheafFiber (A := AddCommGrpCat.{u})).obj P_W :=
      Φ.toPresheafFiber (weilEtaleIdTerminal.{u} W) pt_T P_W
    let π_A : (Φ.presheafFiber (A := AddCommGrpCat.{u})).obj P_W ⟶ A :=
      Φ.presheafFiberDesc c_const hc_const
    have h1 : ι_A ≫ π_A = 𝟙 A :=
      Φ.toPresheafFiber_presheafFiberDesc c_const hc_const (weilEtaleIdTerminal.{u} W) pt_T
    have h2 : π_A ≫ ι_A = 𝟙 _ := by
      apply Φ.presheafFiber_hom_ext
      intro E pt_E
      have hdesc := Φ.toPresheafFiber_presheafFiberDesc c_const hc_const E pt_E
      exact (CategoryTheory.Category.assoc (Φ.toPresheafFiber E pt_E P_W) π_A ι_A).symm.trans
        ((congrArg (· ≫ ι_A) hdesc).trans
          ((CategoryTheory.Category.id_comp ι_A).trans
            ((hAll E pt_E).symm.trans (CategoryTheory.Category.comp_id _).symm)))
    exact ⟨⟨π_A, h1, h2⟩⟩

  
  have hEmptySheafZero : ∀ {Y₀ : AlgebraicGeometry.Scheme.{u}} [IsEmpty ↥Y₀]
      (G : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Limits.IsZero G := by
    intro Y₀ _ G
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply CategoryTheory.Sheaf.hom_ext
    ext V_op s
    let V : Y₀.Etale := V_op.unop
    let v_hom : V.left ⟶ Y₀ := V.hom
    have hEmpV : IsEmpty ↥V.left := ⟨fun y => IsEmpty.false (v_hom.base y)⟩
    have hBot : emptySieve V ∈ Y₀.smallEtaleTopology V := by
      have hTop :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) Y₀ (le_refl P_et)
      change emptySieve V ∈ Y₀.smallGrothendieckTopology P_et V
      rw [hTop]
      exact (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := Y₀) V (emptySieve V)).mpr (fun y => hEmpV.elim y)
    exact G.isSeparated V (emptySieve V) hBot s 0 (fun _ _ hu => False.elim hu)

  have hEmptyHDIZero : ∀ {Y₀ S₀ : AlgebraicGeometry.Scheme.{u}} [IsEmpty ↥Y₀]
      (f₀ : Y₀ ⟶ S₀) (q : ℕ)
      (G : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f₀ q G) := by
    intro Y₀ S₀ _ f₀ q G
    have := instPB f₀
    have := instSBC f₀
    have hZG : CategoryTheory.Limits.IsZero G := hEmptySheafZero G
    have hidG : 𝟙 G = 0 := (CategoryTheory.Limits.IsZero.iff_id_eq_zero G).mp hZG
    let B₀ : CategoryTheory.Functor S₀.Etale Y₀.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ f₀
    let P₀ : CategoryTheory.Functor (Opposite S₀.Etale) AddCommGrpCat.{u} :=
      B₀.op ⋙ G.cohomologyPresheaf q
    have hZP₀ : CategoryTheory.Limits.IsZero P₀ := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext W_op x
      let x' : CategoryTheory.Abelian.Ext _ G q := x
      have hx1 : x' = x'.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 G)) (Nat.add_zero q) :=
        (CategoryTheory.Abelian.Ext.comp_mk₀_id x').symm
      have hx2 : x' = 0 := by
        rw [hx1, hidG, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero]
      exact hx2
    exact (CategoryTheory.presheafToSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}).map_isZero hZP₀

  
  have hClosedLift : ∀ {Y₀ W₀ : AlgebraicGeometry.Scheme.{u}} (i₀ : Y₀ ⟶ W₀)
      [AlgebraicGeometry.IsClosedImmersion i₀]
      (Ω : Type u) [Field Ω]
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W₀),
      Set.range w.base ⊆ Set.range i₀.base →
      ∃ w_lift : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y₀,
        w_lift ≫ i₀ = w ∧
        CategoryTheory.IsPullback w_lift
          (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
          i₀ w := by
    intro Y₀ W₀ i₀ _ Ω _ w hsub
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    have : AlgebraicGeometry.QuasiCompact w :=
      AlgebraicGeometry.QuasiCompact.mk (fun _ _ _ => (Set.toFinite _).isCompact)
    have hsupp : (w.ker.support : Set W₀) ⊆ (i₀.ker.support : Set W₀) := by
      rw [AlgebraicGeometry.Scheme.Hom.support_ker, AlgebraicGeometry.Scheme.Hom.support_ker]
      exact closure_mono hsub
    have hsup_le : w.ker.support ≤ i₀.ker.support := SetLike.coe_subset_coe.mp hsupp
    have hi_le_rad : i₀.ker ≤ w.ker.radical := by
      rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support]
      exact (AlgebraicGeometry.Scheme.IdealSheafData.le_support_iff_le_vanishingIdeal
        (I := i₀.ker) (Z := w.ker.support)).mp hsup_le
    have hrad_le : w.ker.radical ≤ w.ker := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.le_def]
      intro V x hx
      change x ∈ (w.ker.ideal V).radical at hx
      rcases hx with ⟨n, hn⟩
      rw [AlgebraicGeometry.Scheme.Hom.ker_apply] at hn ⊢
