        simpa using Ideal.sub_mem _ h1 h2
    let e_succ1 := (MvPolynomial.finSuccEquiv K (2 * m + 1)).toRingEquiv
    have he1_ren : ∀ p : MvPolynomial (Fin (2 * m + 1)) K,
        e_succ1 (MvPolynomial.rename Fin.succ p) = Polynomial.C p := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C c₀ =>
        rw [MvPolynomial.rename_C]
        change (MvPolynomial.finSuccEquiv K (2 * m + 1)) (algebraMap K _ c₀) = _
        rw [(MvPolynomial.finSuccEquiv K (2 * m + 1)).commutes,
          IsScalarTower.algebraMap_apply K (MvPolynomial (Fin (2 * m + 1)) K) _,
          MvPolynomial.algebraMap_eq, Polynomial.algebraMap_eq]
      | add p₁ p₂ hp₁ hp₂ => rw [map_add, map_add, hp₁, hp₂, Polynomial.C_add]
      | mul_X p₁ i hp₁ =>
        have hX_s : e_succ1 (MvPolynomial.X i.succ) = Polynomial.C (MvPolynomial.X i) :=
          MvPolynomial.finSuccEquiv_X_succ
        rw [map_mul, MvPolynomial.rename_X, map_mul, hp₁, hX_s, ← Polynomial.C_mul]
    let Φ_poly : MvPolynomial (Fin (2 * m + 2)) K →+* Polynomial (R_b c) :=
      (Polynomial.mapRingHom γ_c).comp e_succ1.toRingHom
    have hΦ_poly_ker : RingHom.ker Φ_poly =
        Ideal.span {MvPolynomial.rename Fin.succ (ev_cm F_m)} := by
      have hmap_ker : RingHom.ker (Polynomial.mapRingHom γ_c) =
          Ideal.span {Polynomial.C (ev_cm F_m)} := by
        rw [Polynomial.ker_mapRingHom, hγ_ker, Ideal.map_span, Set.image_singleton]
      apply le_antisymm
      · intro Q hQ
        have hmem : e_succ1 Q ∈ RingHom.ker (Polynomial.mapRingHom γ_c) := hQ
        rw [hmap_ker, Ideal.mem_span_singleton] at hmem
        obtain ⟨R_p, hR_p⟩ := hmem
        refine Ideal.mem_span_singleton.mpr ⟨e_succ1.symm R_p, ?_⟩
        apply e_succ1.injective
        rw [map_mul, he1_ren (ev_cm F_m), e_succ1.apply_symm_apply, hR_p]
      · rw [Ideal.span_singleton_le_iff_mem]
        change (Polynomial.mapRingHom γ_c) (e_succ1 (MvPolynomial.rename Fin.succ (ev_cm F_m))) = 0
        rw [he1_ren (ev_cm F_m)]
        change Polynomial.C (ev_cm F_m) ∈ RingHom.ker (Polynomial.mapRingHom γ_c)
        rw [hmap_ker]; exact Ideal.subset_span rfl
    let Ω_c : MvPolynomial (Fin (2 * m + 3)) K →+* Polynomial (R_b c) :=
      Φ_poly.comp ((Polynomial.evalRingHom 0).comp
        (MvPolynomial.finSuccEquiv K (2 * m + 2)).toRingEquiv.toRingHom)
    have hΩc_surj : Function.Surjective Ω_c := by
      have hmap_surj : Function.Surjective (Polynomial.mapRingHom γ_c) :=
        Polynomial.map_surjective γ_c hγ_surj
      have hev0_surj : Function.Surjective
          (Polynomial.evalRingHom (0 : MvPolynomial (Fin (2 * m + 2)) K)) :=
        fun p => ⟨Polynomial.C p, Polynomial.eval_C⟩
      exact (hmap_surj.comp e_succ1.surjective).comp
        (hev0_surj.comp (MvPolynomial.finSuccEquiv K (2 * m + 2)).surjective)
    have hΩc_ker : RingHom.ker Ω_c = RingHom.ker α_Zc := by
      obtain ⟨_, hElim_ker⟩ := hElimX0 (MvPolynomial.rename Fin.succ (ev_cm F_m))
      have hker_eq1 : RingHom.ker Ω_c =
          RingHom.ker ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.rename Fin.succ (ev_cm F_m)})).comp
            ((Polynomial.evalRingHom 0).comp
              (MvPolynomial.finSuccEquiv K (2 * m + 2)).toRingEquiv.toRingHom)) := by
        ext P
        change Φ_poly (Polynomial.eval 0 ((MvPolynomial.finSuccEquiv K (2 * m + 2)) P)) = 0 ↔
          Ideal.Quotient.mk _ (Polynomial.eval 0 ((MvPolynomial.finSuccEquiv K (2 * m + 2)) P)) = 0
        rw [← RingHom.mem_ker, hΦ_poly_ker, Ideal.Quotient.eq_zero_iff_mem]
      rw [hker_eq1, hElim_ker, ← hSpanc]
      exact hαc_ker.symm
    let e_Zc := (RingHom.quotientKerEquivOfSurjective hΩc_surj).symm.trans
      ((Ideal.quotEquivOfEq hΩc_ker).trans (RingHom.quotientKerEquivOfSurjective hαc_surj))
    have he_Zc_apply : ∀ P : MvPolynomial (Fin (2 * m + 3)) K,
        e_Zc (Ω_c P) = α_Zc P := by
      intro P
      have hsymm : (RingHom.quotientKerEquivOfSurjective hΩc_surj).symm (Ω_c P) =
          Ideal.Quotient.mk (RingHom.ker Ω_c) P := by
        apply (RingHom.quotientKerEquivOfSurjective hΩc_surj).injective
        rw [(RingHom.quotientKerEquivOfSurjective hΩc_surj).apply_symm_apply]
        rfl
      dsimp only [e_Zc, RingEquiv.trans_apply]
      rw [hsymm]
      rfl
    refine ⟨e_Zc, ?_, ?_, ?_⟩
    · intro c₀
      have hγ_C : γ_c (MvPolynomial.C c₀) = algebraMap K (R_b c) c₀ := by
        have hc0 := congrArg (fun φ : _ →+* _ => φ (MvPolynomial.C c₀)) hγ_comp
        simpa [ev_cm] using hc0
      have hΩ_C : Ω_c (MvPolynomial.C c₀) = Polynomial.C (algebraMap K (R_b c) c₀) := by
        change (Polynomial.mapRingHom γ_c) (e_succ1 (Polynomial.eval 0
          ((MvPolynomial.finSuccEquiv K (2 * m + 2)) (algebraMap K _ c₀)))) = _
        rw [(MvPolynomial.finSuccEquiv K (2 * m + 2)).commutes,
          IsScalarTower.algebraMap_apply K (MvPolynomial (Fin (2 * m + 2)) K) _,
          MvPolynomial.algebraMap_eq, Polynomial.algebraMap_eq, Polynomial.eval_C,
          ← MvPolynomial.rename_C Fin.succ c₀, he1_ren (MvPolynomial.C c₀),
          Polynomial.coe_mapRingHom, Polynomial.map_C, hγ_C]
      rw [← hΩ_C, he_Zc_apply]
      have hc := congrArg (fun φ : _ →+* _ => φ (MvPolynomial.C c₀)) hαc_comp
      simpa [ev_c2] using hc
    · intro a
      by_cases hac : a = c
      · subst hac
        rw [hη_diag a, Polynomial.C_1, map_one, hξ_diag a.succ.succ]
      · obtain ⟨i, rfl⟩ := Fin.exists_succAbove_eq hac
        have hγ_Xi : γ_c (MvPolynomial.X i) = η c (c.succAbove i) := by
          have hi := congrArg (fun φ : _ →+* _ => φ (MvPolynomial.X (c.succAbove i))) hγ_comp
          have hl : (γ_c.comp ev_cm) (MvPolynomial.X (c.succAbove i)) = γ_c (MvPolynomial.X i) := by
            dsimp only [RingHom.comp_apply, ev_cm]
            rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]
          exact hl.symm.trans (hi.trans (MvPolynomial.eval₂Hom_X' _ _ _))
        have hΩ_X : Ω_c (MvPolynomial.X i.succ.succ) =
            Polynomial.C (η c (c.succAbove i)) := by
          change (Polynomial.mapRingHom γ_c) (e_succ1 (Polynomial.eval 0
            ((MvPolynomial.finSuccEquiv K (2 * m + 2)) (MvPolynomial.X i.succ.succ)))) = _
          have he1_Xi : e_succ1 (MvPolynomial.X i.succ) = Polynomial.C (MvPolynomial.X i) :=
            MvPolynomial.finSuccEquiv_X_succ
          rw [MvPolynomial.finSuccEquiv_X_succ, Polynomial.eval_C, he1_Xi,
            Polynomial.coe_mapRingHom, Polynomial.map_C, hγ_Xi]
        have hevc2_Xi : ev_c2 (MvPolynomial.X (c.succAbove i).succ.succ) =
            MvPolynomial.X i.succ.succ := by
          have hsucc2 : (c.succAbove i).succ.succ = c.succ.succ.succAbove i.succ.succ := by
            rw [Fin.succ_succAbove_succ, Fin.succ_succAbove_succ]
          rw [hsucc2]; dsimp only [ev_c2]
          rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]
        rw [← hΩ_X, he_Zc_apply, ← hevc2_Xi]
        have ha := congrArg (fun φ : _ →+* _ => φ (MvPolynomial.X (c.succAbove i).succ.succ)) hαc_comp
        exact (RingHom.comp_apply _ _ _).symm.trans (ha.trans (MvPolynomial.eval₂Hom_X' _ _ _))
    · have hΩ_X1 : Ω_c (MvPolynomial.X 1) = Polynomial.X := by
        have h1_succ : (1 : Fin (2 * m + 3)) = (0 : Fin (2 * m + 2)).succ := rfl
        have he1_0 : e_succ1 (MvPolynomial.X 0) = Polynomial.X :=
          MvPolynomial.finSuccEquiv_X_zero
        change (Polynomial.mapRingHom γ_c) (e_succ1 (Polynomial.eval 0
          ((MvPolynomial.finSuccEquiv K (2 * m + 2)) (MvPolynomial.X 1)))) = _
        rw [h1_succ, MvPolynomial.finSuccEquiv_X_succ, Polynomial.eval_C, he1_0,
          Polynomial.coe_mapRingHom, Polynomial.map_X]
      rw [← hΩ_X1, he_Zc_apply, ← hevc2_X1]
      have h1 := congrArg (fun φ : _ →+* _ => φ (MvPolynomial.X 1)) hαc_comp
      exact (RingHom.comp_apply _ _ _).symm.trans (h1.trans (MvPolynomial.eval₂Hom_X' _ _ _))

  
  
  
  let P_prod := CategoryTheory.Limits.pullback Z_cone.hom Q_m.hom
  let pr₁ := CategoryTheory.Limits.pullback.fst Z_cone.hom Q_m.hom
  let pr₂ := CategoryTheory.Limits.pullback.snd Z_cone.hom Q_m.hom
  let Idx : Type := Fin (2 * (m + 1) + 2) × Fin (2 * m + 2)
  let MinorIdx : Type := Fin (2 * m + 2) × Fin (2 * m + 2)
  let C_prod : Idx → P_prod.Opens := fun γ =>
    (TopologicalSpace.Opens.map pr₁.base).obj (Z_chart γ.1) ⊓
      (TopologicalSpace.Opens.map pr₂.base).obj (W γ.2)

  have hCov_prod : (⨆ γ : Idx, C_prod γ) = ⊤ := by
    rw [eq_top_iff]; intro q _
    rw [TopologicalSpace.Opens.mem_iSup]
    have hq₁ : pr₁.base q ∈ Z_chart 1 ⊔ U_Z := by rw [hZ_cov]; trivial
    have hq₁_ex : ∃ μ : Fin (2 * (m + 1) + 2), pr₁.base q ∈ Z_chart μ := by
      rcases hq₁ with h1 | huz
      · exact ⟨1, h1⟩
      · change pr₁.base q ∈ ⨆ c : Fin (2 * m + 2), Z_chart c.succ.succ at huz
        rw [TopologicalSpace.Opens.mem_iSup] at huz
        obtain ⟨c, hc⟩ := huz
        exact ⟨c.succ.succ, hc⟩
    obtain ⟨μ, hμ⟩ := hq₁_ex
    have hq₂ : pr₂.base q ∈ (⨆ b : Fin (2 * m + 2), W b) := by rw [hW_cov]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hq₂
    obtain ⟨b, hb⟩ := hq₂
    exact ⟨(μ, b), ⟨hμ, hb⟩⟩

  let Φ_inc : ∀ γ : Idx, MinorIdx → ↑(P_prod.presheaf.obj (Opposite.op (C_prod γ))) :=
    fun γ ad =>
      (pr₁.appLE (Z_chart γ.1) (C_prod γ) inf_le_left).hom (ξ γ.1 ad.1.succ.succ) *
        (pr₂.appLE (W γ.2) (C_prod γ) inf_le_right).hom (η γ.2 ad.2) -
      (pr₁.appLE (Z_chart γ.1) (C_prod γ) inf_le_left).hom (ξ γ.1 ad.2.succ.succ) *
        (pr₂.appLE (W γ.2) (C_prod γ) inf_le_right).hom (η γ.2 ad.1)

  have hCocycle_prod : ∀ γ γ' : Idx,
      ∃ u : ↑(P_prod.presheaf.obj (Opposite.op (C_prod γ ⊓ C_prod γ'))),
        IsUnit u ∧
        ∀ ad : MinorIdx,
          (P_prod.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (Φ_inc γ ad) =
            u * (P_prod.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (Φ_inc γ' ad) := by
    rintro ⟨μ, b⟩ ⟨μ', b'⟩
    let O : P_prod.Opens := C_prod (μ, b) ⊓ C_prod (μ', b')
    have hO_Z : O ≤ (TopologicalSpace.Opens.map pr₁.base).obj (Z_chart μ ⊓ Z_chart μ') :=
      le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_left)
    have hO_W : O ≤ (TopologicalSpace.Opens.map pr₂.base).obj (W b ⊓ W b') :=
      le_inf (inf_le_left.trans inf_le_right) (inf_le_right.trans inf_le_right)
    let φ_Z := (pr₁.appLE (Z_chart μ ⊓ Z_chart μ') O hO_Z).hom
    let φ_W := (pr₂.appLE (W b ⊓ W b') O hO_W).hom
    let u_Z := (Z_cone.left.presheaf.map
      (CategoryTheory.homOfLE (inf_le_left : Z_chart μ ⊓ Z_chart μ' ≤ Z_chart μ)).op).hom (ξ μ μ')
    let v_Z := (Z_cone.left.presheaf.map
      (CategoryTheory.homOfLE (inf_le_right : Z_chart μ ⊓ Z_chart μ' ≤ Z_chart μ')).op).hom (ξ μ' μ)
    let u_W := (Q_m.left.presheaf.map
      (CategoryTheory.homOfLE (inf_le_left : W b ⊓ W b' ≤ W b)).op).hom (η b b')
    let v_W := (Q_m.left.presheaf.map
      (CategoryTheory.homOfLE (inf_le_right : W b ⊓ W b' ≤ W b')).op).hom (η b' b)
    have hu_Z : IsUnit u_Z := isUnit_iff_exists_inv.mpr ⟨v_Z, (hξ_ov μ μ').1⟩
    have hu_W : IsUnit u_W := isUnit_iff_exists_inv.mpr ⟨v_W, (hη_ov b b').1⟩
    refine ⟨φ_Z u_Z * φ_W u_W, (hu_Z.map φ_Z).mul (hu_W.map φ_W), fun ⟨a, d⟩ => ?_⟩
    have hZ_l : ∀ ν,
        (P_prod.presheaf.map (CategoryTheory.homOfLE (inf_le_left : O ≤ C_prod (μ, b))).op).hom
          ((pr₁.appLE (Z_chart μ) (C_prod (μ, b)) inf_le_left).hom (ξ μ ν)) =
        φ_Z ((Z_cone.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_left : Z_chart μ ⊓ Z_chart μ' ≤ Z_chart μ)).op).hom (ξ μ ν)) := by
      intro ν
      have hc : pr₁.appLE (Z_chart μ) (C_prod (μ, b)) inf_le_left ≫
          P_prod.presheaf.map (CategoryTheory.homOfLE (inf_le_left : O ≤ C_prod (μ, b))).op =
          Z_cone.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : Z_chart μ ⊓ Z_chart μ' ≤ Z_chart μ)).op ≫
            pr₁.appLE (Z_chart μ ⊓ Z_chart μ') O hO_Z := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE_map, AlgebraicGeometry.Scheme.Hom.map_appLE]
      exact congrArg (fun f : Z_cone.left.presheaf.obj (Opposite.op (Z_chart μ)) ⟶ _ => f.hom (ξ μ ν)) hc
    have hZ_r : ∀ ν,
        (P_prod.presheaf.map (CategoryTheory.homOfLE (inf_le_right : O ≤ C_prod (μ', b'))).op).hom
          ((pr₁.appLE (Z_chart μ') (C_prod (μ', b')) inf_le_left).hom (ξ μ' ν)) =
        φ_Z ((Z_cone.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_right : Z_chart μ ⊓ Z_chart μ' ≤ Z_chart μ')).op).hom (ξ μ' ν)) := by
      intro ν
      have hc : pr₁.appLE (Z_chart μ') (C_prod (μ', b')) inf_le_left ≫
          P_prod.presheaf.map (CategoryTheory.homOfLE (inf_le_right : O ≤ C_prod (μ', b'))).op =
          Z_cone.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : Z_chart μ ⊓ Z_chart μ' ≤ Z_chart μ')).op ≫
            pr₁.appLE (Z_chart μ ⊓ Z_chart μ') O hO_Z := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE_map, AlgebraicGeometry.Scheme.Hom.map_appLE]
      exact congrArg (fun f : Z_cone.left.presheaf.obj (Opposite.op (Z_chart μ')) ⟶ _ => f.hom (ξ μ' ν)) hc
    have hW_l : ∀ r,
        (P_prod.presheaf.map (CategoryTheory.homOfLE (inf_le_left : O ≤ C_prod (μ, b))).op).hom
          ((pr₂.appLE (W b) (C_prod (μ, b)) inf_le_right).hom (η b r)) =
        φ_W ((Q_m.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_left : W b ⊓ W b' ≤ W b)).op).hom (η b r)) := by
      intro r
      have hc : pr₂.appLE (W b) (C_prod (μ, b)) inf_le_right ≫
          P_prod.presheaf.map (CategoryTheory.homOfLE (inf_le_left : O ≤ C_prod (μ, b))).op =
          Q_m.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W b ⊓ W b' ≤ W b)).op ≫
            pr₂.appLE (W b ⊓ W b') O hO_W := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE_map, AlgebraicGeometry.Scheme.Hom.map_appLE]
      exact congrArg (fun f : Q_m.left.presheaf.obj (Opposite.op (W b)) ⟶ _ => f.hom (η b r)) hc
    have hW_r : ∀ r,
        (P_prod.presheaf.map (CategoryTheory.homOfLE (inf_le_right : O ≤ C_prod (μ', b'))).op).hom
          ((pr₂.appLE (W b') (C_prod (μ', b')) inf_le_right).hom (η b' r)) =
        φ_W ((Q_m.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_right : W b ⊓ W b' ≤ W b')).op).hom (η b' r)) := by
      intro r
      have hc : pr₂.appLE (W b') (C_prod (μ', b')) inf_le_right ≫
          P_prod.presheaf.map (CategoryTheory.homOfLE (inf_le_right : O ≤ C_prod (μ', b'))).op =
          Q_m.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W b ⊓ W b' ≤ W b')).op ≫
            pr₂.appLE (W b ⊓ W b') O hO_W := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE_map, AlgebraicGeometry.Scheme.Hom.map_appLE]
      exact congrArg (fun f : Q_m.left.presheaf.obj (Opposite.op (W b')) ⟶ _ => f.hom (η b' r)) hc
    dsimp only [Φ_inc]
    rw [map_sub, map_sub, map_mul, map_mul, map_mul, map_mul,
      hZ_l a.succ.succ, hZ_l d.succ.succ, hZ_r a.succ.succ, hZ_r d.succ.succ,
      hW_l d, hW_l a, hW_r d, hW_r a,
      (hξ_ov μ μ').2 a.succ.succ, (hξ_ov μ μ').2 d.succ.succ,
      (hη_ov b b').2 d, (hη_ov b b').2 a,
      map_mul φ_Z, map_mul φ_Z, map_mul φ_W, map_mul φ_W]
    dsimp only [u_Z, u_W]
    ring

  obtain ⟨Z_tilde_sch, ι_inc, hCl_inc, hChart_inc, hLift_inc⟩ :=
    hSubscheme P_prod Idx MinorIdx C_prod hCov_prod Φ_inc hCocycle_prod

  let Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
    CategoryTheory.Over.mk (ι_inc ≫ pr₁ ≫ Z_cone.hom)
  let π_Z : Z_tilde ⟶ Z_cone :=
    CategoryTheory.Over.homMk (ι_inc ≫ pr₁) (CategoryTheory.Category.assoc _ _ _)
  let p_Q : Z_tilde ⟶ Q_m :=
    CategoryTheory.Over.homMk (ι_inc ≫ pr₂) (by
      change (ι_inc ≫ CategoryTheory.Limits.pullback.snd Z_cone.hom Q_m.hom) ≫ Q_m.hom =
        ι_inc ≫ CategoryTheory.Limits.pullback.fst Z_cone.hom Q_m.hom ≫ Z_cone.hom
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition])

  have hProp_πZ : AlgebraicGeometry.IsProper π_Z.left := by
    change AlgebraicGeometry.IsProper (ι_inc ≫ pr₁)
    infer_instance
  have hProp_pQ : AlgebraicGeometry.IsProper p_Q.left := by
    change AlgebraicGeometry.IsProper (ι_inc ≫ pr₂)
    infer_instance
  have hProp_Ztilde : AlgebraicGeometry.IsProper Z_tilde.hom := by
    have _ : AlgebraicGeometry.IsProper π_Z.left := hProp_πZ
    change AlgebraicGeometry.IsProper (π_Z.left ≫ Z_cone.hom)
    infer_instance

  
  let C_tilde : Idx → Z_tilde.left.Opens :=
    fun γ => (TopologicalSpace.Opens.map ι_inc.base).obj (C_prod γ)
  let U_chart0 : Fin (2 * m + 2) → Z_tilde.left.Opens := fun b => C_tilde (1, b)
  let U_chart1 : Fin (2 * m + 2) → Z_tilde.left.Opens := fun b => C_tilde (b.succ.succ, b)
  have hCt_l : ∀ γ : Idx,
      C_tilde γ ≤ (TopologicalSpace.Opens.map π_Z.left.base).obj (Z_chart γ.1) :=
    fun _ _ h => h.1
  have hCt_r : ∀ γ : Idx,
      C_tilde γ ≤ (TopologicalSpace.Opens.map p_Q.left.base).obj (W γ.2) :=
    fun _ _ h => h.2

  have hAff_Cprod : ∀ γ : Idx, AlgebraicGeometry.IsAffineOpen (C_prod γ) :=
    fun γ => (hFiberProdTensor Z_cone.left Q_m.left Z_cone.hom Q_m.hom
      (Z_chart γ.1) (hAff_Z γ.1) (W γ.2) (hAff_W γ.2)).1

  have hOffDiagCollapse : ∀ c b : Fin (2 * m + 2),
      C_tilde (c.succ.succ, b) ≤ U_chart1 b ∧
      C_tilde (c.succ.succ, b) ≤ U_chart1 c := by
    intro c b
    let γ : Idx := (c.succ.succ, b)
    let V_cb : Z_tilde.left.Opens := C_tilde γ
    obtain ⟨_, e_Vcb, he_Vcb⟩ := hChart_inc γ (hAff_Cprod γ)
    let J_γ := Ideal.span (Set.range (Φ_inc γ))
    have hΦ_zero : (ι_inc.appLE (C_prod γ) V_cb (le_refl _)).hom (Φ_inc γ (c, b)) = 0 := by
      rw [he_Vcb]
      have hmem : Φ_inc γ (c, b) ∈ J_γ := Ideal.subset_span ⟨(c, b), rfl⟩
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
    have h_app1 : ∀ ν,
        (ι_inc.appLE (C_prod γ) V_cb (le_refl _)).hom
          ((pr₁.appLE (Z_chart c.succ.succ) (C_prod γ) inf_le_left).hom (ξ c.succ.succ ν)) =
        (π_Z.left.appLE (Z_chart c.succ.succ) V_cb (hCt_l γ)).hom (ξ c.succ.succ ν) := by
      intro ν
      have hc := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_inc pr₁
        (Z_chart c.succ.succ) (C_prod γ) V_cb inf_le_left (le_refl _)
      exact congrArg (fun f : Z_cone.left.presheaf.obj (Opposite.op (Z_chart c.succ.succ)) ⟶ _ =>
        f.hom (ξ c.succ.succ ν)) hc
    have h_app2 : ∀ a,
        (ι_inc.appLE (C_prod γ) V_cb (le_refl _)).hom
          ((pr₂.appLE (W b) (C_prod γ) inf_le_right).hom (η b a)) =
        (p_Q.left.appLE (W b) V_cb (hCt_r γ)).hom (η b a) := by
      intro a
      have hc := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_inc pr₂
        (W b) (C_prod γ) V_cb inf_le_right (le_refl _)
      exact congrArg (fun f : Q_m.left.presheaf.obj (Opposite.op (W b)) ⟶ _ =>
        f.hom (η b a)) hc
    let w_cb := (π_Z.left.appLE (Z_chart c.succ.succ) V_cb (hCt_l γ)).hom (ξ c.succ.succ b.succ.succ)
    let η_bc := (p_Q.left.appLE (W b) V_cb (hCt_r γ)).hom (η b c)
    have hmul_1 : w_cb * η_bc = 1 := by
      dsimp only [Φ_inc] at hΦ_zero
      rw [map_sub, map_mul, map_mul, h_app1 c.succ.succ, h_app1 b.succ.succ,
        h_app2 b, h_app2 c, hξ_diag c.succ.succ, hη_diag b, map_one, map_one, mul_one,
        sub_eq_zero] at hΦ_zero
      exact hΦ_zero.symm
    have hu_w : IsUnit w_cb := isUnit_iff_exists_inv.mpr ⟨η_bc, hmul_1⟩
    have hu_η : IsUnit η_bc := isUnit_iff_exists_inv'.mpr ⟨w_cb, hmul_1⟩
    have hw_bo : Z_tilde.left.basicOpen w_cb =
        V_cb ⊓ (TopologicalSpace.Opens.map π_Z.left.base).obj (Z_chart b.succ.succ) := by
      have hw_res : w_cb =
          (Z_tilde.left.presheaf.map (CategoryTheory.homOfLE (hCt_l γ)).op).hom
            ((π_Z.left.app (Z_chart c.succ.succ)).hom (ξ c.succ.succ b.succ.succ)) := by
        have hc : π_Z.left.app (Z_chart c.succ.succ) ≫
            Z_tilde.left.presheaf.map (CategoryTheory.homOfLE (hCt_l γ)).op =
            π_Z.left.appLE (Z_chart c.succ.succ) V_cb (hCt_l γ) := by
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE π_Z.left,
            AlgebraicGeometry.Scheme.Hom.appLE_map]
        exact congrArg (fun f : Z_cone.left.presheaf.obj (Opposite.op (Z_chart c.succ.succ)) ⟶ _ =>
          f.hom (ξ c.succ.succ b.succ.succ)) hc.symm
      rw [hw_res, Z_tilde.left.basicOpen_res,
        ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, ← hBasic_Z c.succ.succ b.succ.succ]
      ext z
      exact ⟨fun h => ⟨h.1, h.2.2⟩, fun h => ⟨h.1, ⟨h.1.1, h.2⟩⟩⟩
    have hη_bo : Z_tilde.left.basicOpen η_bc =
        V_cb ⊓ (TopologicalSpace.Opens.map p_Q.left.base).obj (W c) := by
      have hη_res : η_bc =
          (Z_tilde.left.presheaf.map (CategoryTheory.homOfLE (hCt_r γ)).op).hom
            ((p_Q.left.app (W b)).hom (η b c)) := by
        have hc : p_Q.left.app (W b) ≫
            Z_tilde.left.presheaf.map (CategoryTheory.homOfLE (hCt_r γ)).op =
            p_Q.left.appLE (W b) V_cb (hCt_r γ) := by
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE p_Q.left,
            AlgebraicGeometry.Scheme.Hom.appLE_map]
        exact congrArg (fun f : Q_m.left.presheaf.obj (Opposite.op (W b)) ⟶ _ =>
          f.hom (η b c)) hc.symm
      rw [hη_res, Z_tilde.left.basicOpen_res,
        ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, ← hBasic_W b c]
      ext z
      exact ⟨fun h => ⟨h.1, h.2.2⟩, fun h => ⟨h.1, ⟨h.1.2, h.2⟩⟩⟩
    have hV_w : V_cb ≤ (TopologicalSpace.Opens.map π_Z.left.base).obj (Z_chart b.succ.succ) := by
      have h1 := (Z_tilde.left.basicOpen_of_isUnit hu_w).symm.trans hw_bo
      exact h1.le.trans inf_le_right
    have hV_η : V_cb ≤ (TopologicalSpace.Opens.map p_Q.left.base).obj (W c) := by
      have h1 := (Z_tilde.left.basicOpen_of_isUnit hu_η).symm.trans hη_bo
      exact h1.le.trans inf_le_right
    exact ⟨fun z hz => ⟨hV_w hz, hz.2⟩, fun z hz => ⟨hz.1, hV_η hz⟩⟩

  have hPre_Zc : ∀ c : Fin (2 * m + 2),
      (TopologicalSpace.Opens.map π_Z.left.base).obj (Z_chart c.succ.succ) = U_chart1 c := by
    intro c
    apply le_antisymm
    · intro z hz
      have hzq : p_Q.left.base z ∈ (⨆ b : Fin (2 * m + 2), W b) := by rw [hW_cov]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hzq
      obtain ⟨b, hb⟩ := hzq
      exact (hOffDiagCollapse c b).2 ⟨hz, hb⟩
    · exact hCt_l (c.succ.succ, c)

  
  obtain ⟨e_Z1, he_Z1_C, he_Z1_X⟩ := hCone1
  have hChartData : ∀ b : Fin (2 * m + 2),
      letI : Algebra K (R_b b) := hAlg b
      (AlgebraicGeometry.IsAffineOpen (U_chart0 b) ∧
        AlgebraicGeometry.IsAffineOpen (U_chart1 b)) ∧
      (∃ ψ₀ : Polynomial (R_b b) ≃+*
          ↑(Z_tilde.left.presheaf.obj (Opposite.op (U_chart0 b))),
        (∀ r : R_b b, ψ₀ (Polynomial.C r) =
          (p_Q.left.appLE (W b) (U_chart0 b) (hCt_r (1, b))).hom r) ∧
        ψ₀ Polynomial.X =
          (π_Z.left.appLE (Z_chart 1) (U_chart0 b) (hCt_l (1, b))).hom (ξ 1 b.succ.succ)) ∧
      (∃ ψ₁ : Polynomial (R_b b) ≃+*
          ↑(Z_tilde.left.presheaf.obj (Opposite.op (U_chart1 b))),
        (∀ r : R_b b, ψ₁ (Polynomial.C r) =
          (p_Q.left.appLE (W b) (U_chart1 b) (hCt_r (b.succ.succ, b))).hom r) ∧
        ψ₁ Polynomial.X =
          (π_Z.left.appLE (Z_chart b.succ.succ) (U_chart1 b) (hCt_l (b.succ.succ, b))).hom
            (ξ b.succ.succ 1)) ∧
      CategoryTheory.IsIso (π_Z.left ∣_ Z_chart b.succ.succ) := by
    intro b
    letI : Algebra K (R_b b) := hAlg b
    obtain ⟨_, _, _, _, hSurj_b, hQuad_b⟩ := hChartQm b
    obtain ⟨e_Zb, he_Zb_C, he_Zb_ξ, he_Zb_X⟩ := hConePunct b
    
    let A₁ := ↑(Z_cone.left.presheaf.obj (Opposite.op (Z_chart 1)))
    letI : Algebra K A₁ :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
        Z_cone.hom.appLE ⊤ (Z_chart 1) le_top).hom).toAlgebra
    obtain ⟨hAff_C0, τ₀, hτ₀_1, hτ₀_2⟩ := hFiberProdTensor Z_cone.left Q_m.left
      Z_cone.hom Q_m.hom (Z_chart 1) (hAff_Z 1) (W b) (hAff_W b)
    obtain ⟨hAff_U0, e_V0, he_V0⟩ := hChart_inc (1, b) hAff_C0
    obtain ⟨eq₀, heq₀_C, heq₀_X⟩ := hVertexQuotAlg A₁ (R_b b) b
      (fun a => ξ 1 a.succ.succ) (η b) F_m e_Z1 (hη_diag b) hQuad_b he_Z1_C he_Z1_X
    let I₀ := Ideal.span (Set.range fun ad : MinorIdx =>
      (ξ 1 ad.1.succ.succ) ⊗ₜ[K] (η b ad.2) - (ξ 1 ad.2.succ.succ) ⊗ₜ[K] (η b ad.1))
    let J₀ := Ideal.span (Set.range (Φ_inc (1, b)))
    have hJ₀_eq : J₀ = Ideal.map τ₀.toRingHom I₀ := by
      dsimp [I₀, J₀]
      rw [Ideal.map_span, ← Set.range_comp]
      apply congrArg Ideal.span
      apply congrArg Set.range
      ext ⟨a, d⟩
      change Φ_inc (1, b) (a, d) = τ₀ ((ξ 1 a.succ.succ) ⊗ₜ[K] (η b d) -
        (ξ 1 d.succ.succ) ⊗ₜ[K] (η b a))
      have hmul_t : ∀ (x : A₁) (r : R_b b),
          τ₀ (x ⊗ₜ[K] r) =
            (pr₁.appLE (Z_chart 1) (C_prod (1, b)) inf_le_left).hom x *
              (pr₂.appLE (W b) (C_prod (1, b)) inf_le_right).hom r := by
        intro x r
        have hsp : x ⊗ₜ[K] r = (x ⊗ₜ[K] (1 : R_b b)) * ((1 : A₁) ⊗ₜ[K] r) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hsp, map_mul, hτ₀_1 x, hτ₀_2 r]
      rw [map_sub, hmul_t, hmul_t]
    let ψ₀ := eq₀.trans ((Ideal.quotientEquiv I₀ J₀ τ₀ hJ₀_eq).trans e_V0)
    have hψ₀_mk : ∀ t : TensorProduct K A₁ (R_b b),
        (Ideal.quotientEquiv I₀ J₀ τ₀ hJ₀_eq).trans e_V0 (Ideal.Quotient.mk I₀ t) =
          (ι_inc.appLE (C_prod (1, b)) (U_chart0 b) (le_refl _)).hom (τ₀ t) := by
      intro t; exact (he_V0 (τ₀ t)).symm
    have hψ₀_C : ∀ r : R_b b, ψ₀ (Polynomial.C r) =
        (p_Q.left.appLE (W b) (U_chart0 b) (hCt_r (1, b))).hom r := by
      intro r
      change (Ideal.quotientEquiv I₀ J₀ τ₀ hJ₀_eq).trans e_V0 (eq₀ (Polynomial.C r)) = _
      rw [heq₀_C r, hψ₀_mk, hτ₀_2 r]
      have hc := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_inc pr₂
        (W b) (C_prod (1, b)) (U_chart0 b) inf_le_right (le_refl _)
      exact congrArg (fun f : Q_m.left.presheaf.obj (Opposite.op (W b)) ⟶ _ => f.hom r) hc
    have hψ₀_X : ψ₀ Polynomial.X =
        (π_Z.left.appLE (Z_chart 1) (U_chart0 b) (hCt_l (1, b))).hom (ξ 1 b.succ.succ) := by
      change (Ideal.quotientEquiv I₀ J₀ τ₀ hJ₀_eq).trans e_V0 (eq₀ Polynomial.X) = _
      rw [heq₀_X, hψ₀_mk, hτ₀_1]
      have hc := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_inc pr₁
        (Z_chart 1) (C_prod (1, b)) (U_chart0 b) inf_le_left (le_refl _)
      exact congrArg (fun f : Z_cone.left.presheaf.obj (Opposite.op (Z_chart 1)) ⟶ _ =>
        f.hom (ξ 1 b.succ.succ)) hc
    
    let A₂ := ↑(Z_cone.left.presheaf.obj (Opposite.op (Z_chart b.succ.succ)))
    letI : Algebra K A₂ :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
        Z_cone.hom.appLE ⊤ (Z_chart b.succ.succ) le_top).hom).toAlgebra
    obtain ⟨hAff_C1, τ₁, hτ₁_1, hτ₁_2⟩ := hFiberProdTensor Z_cone.left Q_m.left
      Z_cone.hom Q_m.hom (Z_chart b.succ.succ) (hAff_Z b.succ.succ) (W b) (hAff_W b)
    obtain ⟨hAff_U1, e_V1, he_V1⟩ := hChart_inc (b.succ.succ, b) hAff_C1
    obtain ⟨eq₁, _, heq₁_C, heq₁_X, heq₁_symm⟩ := hDiagQuotAlg A₂ (R_b b) b
      (fun a => ξ b.succ.succ a.succ.succ) (ξ b.succ.succ 1) (η b) e_Zb
      (hη_diag b) hSurj_b he_Zb_C he_Zb_ξ he_Zb_X
    let I₁ := Ideal.span (Set.range fun ad : MinorIdx =>
      (ξ b.succ.succ ad.1.succ.succ) ⊗ₜ[K] (η b ad.2) -
      (ξ b.succ.succ ad.2.succ.succ) ⊗ₜ[K] (η b ad.1))
    let J₁ := Ideal.span (Set.range (Φ_inc (b.succ.succ, b)))
    have hJ₁_eq : J₁ = Ideal.map τ₁.toRingHom I₁ := by
      dsimp [I₁, J₁]
      rw [Ideal.map_span, ← Set.range_comp]
      apply congrArg Ideal.span
      apply congrArg Set.range
      ext ⟨a, d⟩
      change Φ_inc (b.succ.succ, b) (a, d) = τ₁ ((ξ b.succ.succ a.succ.succ) ⊗ₜ[K] (η b d) -
        (ξ b.succ.succ d.succ.succ) ⊗ₜ[K] (η b a))
      have hmul_t : ∀ (x : A₂) (r : R_b b),
          τ₁ (x ⊗ₜ[K] r) =
            (pr₁.appLE (Z_chart b.succ.succ) (C_prod (b.succ.succ, b)) inf_le_left).hom x *
              (pr₂.appLE (W b) (C_prod (b.succ.succ, b)) inf_le_right).hom r := by
        intro x r
        have hsp : x ⊗ₜ[K] r = (x ⊗ₜ[K] (1 : R_b b)) * ((1 : A₂) ⊗ₜ[K] r) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hsp, map_mul, hτ₁_1 x, hτ₁_2 r]
      rw [map_sub, hmul_t, hmul_t]
    let ψ₁ := eq₁.trans ((Ideal.quotientEquiv I₁ J₁ τ₁ hJ₁_eq).trans e_V1)
    have hψ₁_mk : ∀ t : TensorProduct K A₂ (R_b b),
        (Ideal.quotientEquiv I₁ J₁ τ₁ hJ₁_eq).trans e_V1 (Ideal.Quotient.mk I₁ t) =
          (ι_inc.appLE (C_prod (b.succ.succ, b)) (U_chart1 b) (le_refl _)).hom (τ₁ t) := by
      intro t; exact (he_V1 (τ₁ t)).symm
    have hψ₁_C : ∀ r : R_b b, ψ₁ (Polynomial.C r) =
        (p_Q.left.appLE (W b) (U_chart1 b) (hCt_r (b.succ.succ, b))).hom r := by
      intro r
      change (Ideal.quotientEquiv I₁ J₁ τ₁ hJ₁_eq).trans e_V1 (eq₁ (Polynomial.C r)) = _
      rw [heq₁_C r, hψ₁_mk, hτ₁_2 r]
      have hc := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_inc pr₂
        (W b) (C_prod (b.succ.succ, b)) (U_chart1 b) inf_le_right (le_refl _)
      exact congrArg (fun f : Q_m.left.presheaf.obj (Opposite.op (W b)) ⟶ _ => f.hom r) hc
    have hψ₁_X : ψ₁ Polynomial.X =
        (π_Z.left.appLE (Z_chart b.succ.succ) (U_chart1 b) (hCt_l (b.succ.succ, b))).hom
          (ξ b.succ.succ 1) := by
      change (Ideal.quotientEquiv I₁ J₁ τ₁ hJ₁_eq).trans e_V1 (eq₁ Polynomial.X) = _
      rw [heq₁_X, hψ₁_mk, hτ₁_1]
      have hc := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_inc pr₁
        (Z_chart b.succ.succ) (C_prod (b.succ.succ, b)) (U_chart1 b) inf_le_left (le_refl _)
      exact congrArg (fun f : Z_cone.left.presheaf.obj (Opposite.op (Z_chart b.succ.succ)) ⟶ _ =>
        f.hom (ξ b.succ.succ 1)) hc
    have hπ_bij : Function.Bijective
        (π_Z.left.appLE (Z_chart b.succ.succ) (U_chart1 b) (hPre_Zc b).ge).hom := by
      have h_eq_fn : ⇑(π_Z.left.appLE (Z_chart b.succ.succ) (U_chart1 b) (hPre_Zc b).ge).hom =
          ⇑(e_Zb.symm.trans ψ₁) := by
        ext z
        change (π_Z.left.appLE (Z_chart b.succ.succ) (U_chart1 b) (hCt_l (b.succ.succ, b))).hom z =
          (Ideal.quotientEquiv I₁ J₁ τ₁ hJ₁_eq).trans e_V1 (eq₁ (e_Zb.symm z))
        rw [heq₁_symm z, hψ₁_mk, hτ₁_1 z]
        have hc := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_inc pr₁
          (Z_chart b.succ.succ) (C_prod (b.succ.succ, b)) (U_chart1 b) inf_le_left (le_refl _)
        exact (congrArg (fun f : Z_cone.left.presheaf.obj (Opposite.op (Z_chart b.succ.succ)) ⟶ _ =>
          f.hom z) hc).symm
      rw [h_eq_fn]
      exact (e_Zb.symm.trans ψ₁).bijective
    have hIso_b : CategoryTheory.IsIso (π_Z.left ∣_ Z_chart b.succ.succ) :=
      hAffResIso π_Z.left (Z_chart b.succ.succ) (hAff_Z b.succ.succ)
        (U_chart1 b) hAff_U1 (hPre_Zc b) hπ_bij
    exact ⟨⟨hAff_U0, hAff_U1⟩, ⟨ψ₀, hψ₀_C, hψ₀_X⟩, ⟨ψ₁, hψ₁_C, hψ₁_X⟩, hIso_b⟩

  
  have hIso_πZ_UZ : CategoryTheory.IsIso (π_Z.left ∣_ U_Z) := by
    let O_cov : Fin (2 * m + 2) → U_Z.toScheme.Opens :=
      fun c => (TopologicalSpace.Opens.map U_Z.ι.base).obj (Z_chart c.succ.succ)
    have hO_top : (⨆ c : Fin (2 * m + 2), O_cov c) = ⊤ := by
      rw [eq_top_iff]; intro u _
      have hu : U_Z.ι.base u ∈ (U_Z : Set Z_cone.left) := by
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι]; exact ⟨u, rfl⟩
      change U_Z.ι.base u ∈ ⨆ c : Fin (2 * m + 2), Z_chart c.succ.succ at hu
      rw [TopologicalSpace.Opens.mem_iSup] at hu ⊢
      exact hu
    refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
      (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme)
      O_cov hO_top fun c => ?_
    change CategoryTheory.IsIso ((π_Z.left ∣_ U_Z) ∣_ O_cov c)
    have _ : CategoryTheory.IsIso (π_Z.left ∣_ Z_chart c.succ.succ) := (hChartData c).2.2.2
    have hRange_c : Set.range ((O_cov c).ι ≫ U_Z.ι).base =
        Set.range (Z_chart c.succ.succ).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      ext z; constructor
      · rintro ⟨v, rfl⟩
        have hv : (O_cov c).ι.base v ∈ (O_cov c : Set U_Z.toScheme) := by
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι]; exact ⟨v, rfl⟩
        exact hv
      · intro hzc
        have hz_UZ : z ∈ Set.range U_Z.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          dsimp only [U_Z]
          exact le_iSup (fun d : Fin (2 * m + 2) => Z_chart d.succ.succ) c hzc
        obtain ⟨u, rfl⟩ := hz_UZ
        have hu_Oc : u ∈ Set.range (O_cov c).ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]; exact hzc
        obtain ⟨v, rfl⟩ := hu_Oc
        exact ⟨v, rfl⟩
    let δ_c : (O_cov c).toScheme ≅ (Z_chart c.succ.succ).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq
        ((O_cov c).ι ≫ U_Z.ι) (Z_chart c.succ.succ).ι hRange_c
    have hδ_fac : δ_c.hom ≫ (Z_chart c.succ.succ).ι = (O_cov c).ι ≫ U_Z.ι :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac _ _ hRange_c
    have hp₁ := AlgebraicGeometry.isPullback_morphismRestrict (π_Z.left ∣_ U_Z) (O_cov c)
    have hp₂ := AlgebraicGeometry.isPullback_morphismRestrict π_Z.left U_Z
    have hp₁₂ := hp₁.paste_vert hp₂
    have hp_c := AlgebraicGeometry.isPullback_morphismRestrict π_Z.left (Z_chart c.succ.succ)
    let V_pre_c : Z_tilde.left.Opens :=
      (TopologicalSpace.Opens.map π_Z.left.base).obj (Z_chart c.succ.succ)
    have hp_c' : CategoryTheory.IsPullback
        ((π_Z.left ∣_ Z_chart c.succ.succ) ≫ δ_c.inv)
        V_pre_c.ι
        ((O_cov c).ι ≫ U_Z.ι) π_Z.left :=
      hp_c.of_iso (CategoryTheory.Iso.refl _) δ_c.symm
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (by simp)
        ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
        (by
          change (Z_chart c.succ.succ).ι ≫ 𝟙 _ = δ_c.inv ≫ ((O_cov c).ι ≫ U_Z.ι)
          rw [CategoryTheory.Category.comp_id, ← hδ_fac, CategoryTheory.Iso.inv_hom_id_assoc])
        (by simp)
    let θ_pb := CategoryTheory.IsPullback.isoIsPullback _ _ hp₁₂ hp_c'
    have hθ_fst : θ_pb.hom ≫ ((π_Z.left ∣_ Z_chart c.succ.succ) ≫ δ_c.inv) =
        (π_Z.left ∣_ U_Z) ∣_ O_cov c :=
      CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hp₁₂ hp_c'
    rw [← hθ_fst]
    infer_instance

  
  have hTorusCharts : ∀ b : Fin (2 * m + 2),
      letI : Algebra K (R_b b) := hAlg b
      ((i_Wb b).inv ≫ (W b).ι ≫ Q_m.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (R_b b)))) ∧
      ∃ (j_0b : (U_chart0 b).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial (R_b b))))
        (j_1b : (U_chart1 b).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial (R_b b)))),
        (∃ (q_0 : (U_chart0 b).toScheme ⟶ (W b).toScheme)
           (q_1 : (U_chart1 b).toScheme ⟶ (W b).toScheme),
          q_0 ≫ (W b).ι = (U_chart0 b).ι ≫ p_Q.left ∧
          q_1 ≫ (W b).ι = (U_chart1 b).ι ≫ p_Q.left ∧
          q_0 ≫ (i_Wb b).hom =
            j_0b.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
          q_1 ≫ (i_Wb b).hom =
            j_1b.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∧
        (TopologicalSpace.Opens.map (U_chart0 b).ι.base).obj (U_chart1 b) =
          (TopologicalSpace.Opens.map j_0b.hom.base).obj
            (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial (R_b b))) ∧
        (TopologicalSpace.Opens.map (U_chart1 b).ι.base).obj (U_chart0 b) =
          (TopologicalSpace.Opens.map j_1b.hom.base).obj
            (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial (R_b b))) ∧
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (algebraMap (Polynomial (R_b b))
                (Localization.Away (Polynomial.X : Polynomial (R_b b))))) ≫
          j_0b.inv ≫ (U_chart0 b).ι =
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (Polynomial.eval₂RingHom
                ((algebraMap (Polynomial (R_b b))
                   (Localization.Away (Polynomial.X : Polynomial (R_b b)))).comp Polynomial.C)
                (IsLocalization.Away.invSelf
                  (S := Localization.Away (Polynomial.X : Polynomial (R_b b)))
                  (Polynomial.X : Polynomial (R_b b))))) ≫
          j_1b.inv ≫ (U_chart1 b).ι := by
    intro b
    letI : Algebra K (R_b b) := hAlg b
    obtain ⟨⟨hAff0, hAff1⟩, ⟨ψ₀, hψ₀_C, hψ₀_X⟩, ⟨ψ₁, hψ₁_C, hψ₁_X⟩, _⟩ := hChartData b
    obtain ⟨hi_Wb_hom, hBridge⟩ := hPolyTorusBridge Z_tilde.left p_Q.left (W b) (hAff_W b)
    have hOv₀ : U_chart0 b ⊓ U_chart1 b = Z_tilde.left.basicOpen (ψ₀ Polynomial.X) := by
      rw [hψ₀_X]
      have hres : (π_Z.left.appLE (Z_chart 1) (U_chart0 b) (hCt_l (1, b))).hom (ξ 1 b.succ.succ) =
          (Z_tilde.left.presheaf.map (CategoryTheory.homOfLE (hCt_l (1, b))).op).hom
            ((π_Z.left.app (Z_chart 1)).hom (ξ 1 b.succ.succ)) := by
        have hc : π_Z.left.app (Z_chart 1) ≫
            Z_tilde.left.presheaf.map (CategoryTheory.homOfLE (hCt_l (1, b))).op =
            π_Z.left.appLE (Z_chart 1) (U_chart0 b) (hCt_l (1, b)) := by
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE π_Z.left,
            AlgebraicGeometry.Scheme.Hom.appLE_map]
        exact congrArg (fun f : Z_cone.left.presheaf.obj (Opposite.op (Z_chart 1)) ⟶ _ =>
          f.hom (ξ 1 b.succ.succ)) hc.symm
      rw [hres, Z_tilde.left.basicOpen_res,
        ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, ← hBasic_Z 1 b.succ.succ]
      ext z; constructor
      · rintro ⟨⟨hz1, hzb⟩, ⟨hz_b2, _⟩⟩
        exact ⟨⟨hz1, hzb⟩, ⟨hz1, hz_b2⟩⟩
      · rintro ⟨⟨hz1, hzb⟩, ⟨_, hz_b2⟩⟩
        exact ⟨⟨hz1, hzb⟩, ⟨hz_b2, hzb⟩⟩
    have hOv₁ : U_chart1 b ⊓ U_chart0 b = Z_tilde.left.basicOpen (ψ₁ Polynomial.X) := by
      rw [hψ₁_X]
      have hres : (π_Z.left.appLE (Z_chart b.succ.succ) (U_chart1 b)
            (hCt_l (b.succ.succ, b))).hom (ξ b.succ.succ 1) =
          (Z_tilde.left.presheaf.map (CategoryTheory.homOfLE
            (hCt_l (b.succ.succ, b))).op).hom
            ((π_Z.left.app (Z_chart b.succ.succ)).hom (ξ b.succ.succ 1)) := by
        have hc : π_Z.left.app (Z_chart b.succ.succ) ≫
            Z_tilde.left.presheaf.map (CategoryTheory.homOfLE
               (hCt_l (b.succ.succ, b))).op =
            π_Z.left.appLE (Z_chart b.succ.succ) (U_chart1 b) (hCt_l (b.succ.succ, b)) := by
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE π_Z.left,
            AlgebraicGeometry.Scheme.Hom.appLE_map]
        exact congrArg (fun f : Z_cone.left.presheaf.obj (Opposite.op (Z_chart b.succ.succ)) ⟶ _ =>
          f.hom (ξ b.succ.succ 1)) hc.symm
      rw [hres, Z_tilde.left.basicOpen_res,
        ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, ← hBasic_Z b.succ.succ 1]
      ext z; constructor
      · rintro ⟨⟨hz_b2, hzb⟩, ⟨hz1, _⟩⟩
        exact ⟨⟨hz_b2, hzb⟩, ⟨hz_b2, hz1⟩⟩
      · rintro ⟨⟨hz_b2, hzb⟩, ⟨_, hz1⟩⟩
        exact ⟨⟨hz_b2, hzb⟩, ⟨hz1, hzb⟩⟩
    have hProd1 :
        (Z_tilde.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : U_chart0 b ⊓ U_chart1 b ≤ U_chart0 b)).op).hom
          (ψ₀ Polynomial.X) *
        (Z_tilde.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_right : U_chart0 b ⊓ U_chart1 b ≤ U_chart1 b)).op).hom
          (ψ₁ Polynomial.X) = 1 := by
      rw [hψ₀_X, hψ₁_X]
      let U_ov := U_chart0 b ⊓ U_chart1 b
      have h_ov_Z : U_ov ≤
          (TopologicalSpace.Opens.map π_Z.left.base).obj (Z_chart 1 ⊓ Z_chart b.succ.succ) :=
        fun _ hz => ⟨hz.1.1, hz.2.1⟩
      have h0 : (Z_tilde.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_ov ≤ U_chart0 b)).op).hom
          ((π_Z.left.appLE (Z_chart 1) (U_chart0 b) (hCt_l (1, b))).hom (ξ 1 b.succ.succ)) =
          (π_Z.left.appLE (Z_chart 1 ⊓ Z_chart b.succ.succ) U_ov h_ov_Z).hom
            ((Z_cone.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (ξ 1 b.succ.succ)) := by
        have hc : π_Z.left.appLE (Z_chart 1) (U_chart0 b) (hCt_l (1, b)) ≫
            Z_tilde.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_ov ≤ U_chart0 b)).op =
            Z_cone.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : Z_chart 1 ⊓ Z_chart b.succ.succ ≤ Z_chart 1)).op ≫
              π_Z.left.appLE (Z_chart 1 ⊓ Z_chart b.succ.succ) U_ov h_ov_Z := by
          rw [AlgebraicGeometry.Scheme.Hom.appLE_map, AlgebraicGeometry.Scheme.Hom.map_appLE]
        exact congrArg (fun f : Z_cone.left.presheaf.obj (Opposite.op (Z_chart 1)) ⟶ _ =>
          f.hom (ξ 1 b.succ.succ)) hc
      have h1 : (Z_tilde.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_ov ≤ U_chart1 b)).op).hom
          ((π_Z.left.appLE (Z_chart b.succ.succ) (U_chart1 b) (hCt_l (b.succ.succ, b))).hom (ξ b.succ.succ 1)) =
          (π_Z.left.appLE (Z_chart 1 ⊓ Z_chart b.succ.succ) U_ov h_ov_Z).hom
            ((Z_cone.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (ξ b.succ.succ 1)) := by
        have hc : π_Z.left.appLE (Z_chart b.succ.succ) (U_chart1 b) (hCt_l (b.succ.succ, b)) ≫
            Z_tilde.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_ov ≤ U_chart1 b)).op =
            Z_cone.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : Z_chart 1 ⊓ Z_chart b.succ.succ ≤ Z_chart b.succ.succ)).op ≫
              π_Z.left.appLE (Z_chart 1 ⊓ Z_chart b.succ.succ) U_ov h_ov_Z := by
          rw [AlgebraicGeometry.Scheme.Hom.appLE_map, AlgebraicGeometry.Scheme.Hom.map_appLE]
        exact congrArg (fun f : Z_cone.left.presheaf.obj (Opposite.op (Z_chart b.succ.succ)) ⟶ _ =>
          f.hom (ξ b.succ.succ 1)) hc
      rw [h0, h1, ← map_mul, (hξ_ov 1 b.succ.succ).1, map_one]
    exact ⟨hi_Wb_hom,
      hBridge (U_chart0 b) (U_chart1 b) hAff0 hAff1
        (hCt_r (1, b)) (hCt_r (b.succ.succ, b))
        ψ₀ ψ₁ hψ₀_C hψ₁_C hOv₀ hOv₁ hProd1⟩

  choose j_0 j_1 hj_spec using fun b => (hTorusCharts b).2

  
  
  
  have hcond_g0 : (Q_m.hom ≫ p₀) ≫ Z_cone.hom = 𝟙 Q_m.left ≫ Q_m.hom := by
    rw [CategoryTheory.Category.assoc, hp₀_hom, CategoryTheory.Category.comp_id,
      CategoryTheory.Category.id_comp]
  let g₀ : Q_m.left ⟶ P_prod :=
    CategoryTheory.Limits.pullback.lift (Q_m.hom ≫ p₀) (𝟙 Q_m.left) hcond_g0
  let g_inf : Q_m.left ⟶ P_prod :=
    CategoryTheory.Limits.pullback.lift σ_inf.left (𝟙 Q_m.left)
      (by rw [CategoryTheory.Category.id_comp]; exact σ_inf.w)
  have hg0_pr1 : g₀ ≫ pr₁ = Q_m.hom ≫ p₀ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hg0_pr2 : g₀ ≫ pr₂ = 𝟙 Q_m.left :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hginf_pr1 : g_inf ≫ pr₁ = σ_inf.left :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hginf_pr2 : g_inf ≫ pr₂ = 𝟙 Q_m.left :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have _ : AlgebraicGeometry.IsProper pr₂ := by
    dsimp only [pr₂]; infer_instance

  have _hCl_g0 : AlgebraicGeometry.IsClosedImmersion g₀ := by
    have _ : AlgebraicGeometry.IsClosedImmersion (g₀ ≫ pr₂) := by rw [hg0_pr2]; infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp g₀ pr₂
  have _hCl_ginf : AlgebraicGeometry.IsClosedImmersion g_inf := by
    have _ : AlgebraicGeometry.IsClosedImmersion (g_inf ≫ pr₂) := by rw [hginf_pr2]; infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp g_inf pr₂

  
  have hW_g0_le : ∀ b : Fin (2 * m + 2),
      W b ≤ (TopologicalSpace.Opens.map g₀.base).obj (C_prod (1, b)) := by
    intro b y hyW
    have hy_pr1 : (g₀ ≫ pr₁).base y ∈ Z_chart 1 := by
      rw [hg0_pr1]
      exact hp₀_D1 (trivial :
        Q_m.hom.base y ∈ (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of K)).Opens))
    have hy_pr2 : (g₀ ≫ pr₂).base y ∈ W b := by
      rw [hg0_pr2]; exact hyW
    exact ⟨hy_pr1, hy_pr2⟩

  have hΦ_g0_zero : ∀ (b : Fin (2 * m + 2)) (ad : MinorIdx),
      (g₀.appLE (C_prod (1, b)) (W b) (hW_g0_le b)).hom (Φ_inc (1, b) ad) = 0 := by
    intro b ⟨a, d⟩
    have hp₀_Z1 : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of K)).Opens) ≤
        (TopologicalSpace.Opens.map p₀.base).obj (Z_chart 1) := hp₀_D1
    have h_p0_ξ : ∀ r : Fin (2 * m + 2),
        (p₀.appLE (Z_chart 1) ⊤ hp₀_Z1).hom (ξ 1 r.succ.succ) = 0 := by
      intro r
      have hc := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE p₀ f_Z
        (D_succ 1) (Z_chart 1) ⊤ (le_refl _) hp₀_Z1
      have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ (ρ_succ 1 r.succ.succ)) hc
      exact h1.trans (hp₀_coord r)
    have h_g0_ξ : ∀ r : Fin (2 * m + 2),
        (g₀.appLE (C_prod (1, b)) (W b) (hW_g0_le b)).hom
          ((pr₁.appLE (Z_chart 1) (C_prod (1, b)) inf_le_left).hom (ξ 1 r.succ.succ)) = 0 := by
      intro r
      have hc1 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE g₀ pr₁
        (Z_chart 1) (C_prod (1, b)) (W b) inf_le_left (hW_g0_le b)
      have h_le_g0 : W b ≤ (TopologicalSpace.Opens.map (g₀ ≫ pr₁).base).obj (Z_chart 1) :=
        fun _ hy => (hW_g0_le b hy).1
      have h_le_Qm : W b ≤ (TopologicalSpace.Opens.map (Q_m.hom ≫ p₀).base).obj (Z_chart 1) := by
        rwa [hg0_pr1] at h_le_g0
      have hc2 : (g₀ ≫ pr₁).appLE (Z_chart 1) (W b) h_le_g0 =
          p₀.appLE (Z_chart 1) ⊤ hp₀_Z1 ≫ Q_m.hom.appLE ⊤ (W b) le_top :=
        (h_appLE_eq hg0_pr1 _ _ h_le_g0 h_le_Qm).trans
          (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE Q_m.hom p₀ (Z_chart 1) ⊤ (W b) hp₀_Z1 le_top).symm
      have h_tot := hc1.trans hc2
      have h_eval := congrArg (fun φ => CommRingCat.Hom.hom φ (ξ 1 r.succ.succ)) h_tot
      change (g₀.appLE (C_prod (1, b)) (W b) (hW_g0_le b)).hom
          ((pr₁.appLE (Z_chart 1) (C_prod (1, b)) inf_le_left).hom (ξ 1 r.succ.succ)) =
        (Q_m.hom.appLE ⊤ (W b) le_top).hom ((p₀.appLE (Z_chart 1) ⊤ hp₀_Z1).hom (ξ 1 r.succ.succ))
        at h_eval
      rw [h_eval, h_p0_ξ r, map_zero]
    dsimp only [Φ_inc]
    rw [map_sub, map_mul, map_mul, h_g0_ξ a, h_g0_ξ d, zero_mul, zero_mul, sub_zero]

  obtain ⟨i₀_left, hi₀_fac⟩ :=
    hLift_inc Q_m.left g₀ (Fin (2 * m + 2)) W hW_cov (fun b => (1, b)) hW_g0_le hΦ_g0_zero

  have hi₀_pQ_left : i₀_left ≫ p_Q.left = 𝟙 Q_m.left := by
    change i₀_left ≫ ι_inc ≫ pr₂ = 𝟙 Q_m.left
    rw [← CategoryTheory.Category.assoc, hi₀_fac, hg0_pr2]
  have hi₀_πZ_left : i₀_left ≫ π_Z.left = Q_m.hom ≫ p₀ := by
    change i₀_left ≫ ι_inc ≫ pr₁ = _
    rw [← CategoryTheory.Category.assoc, hi₀_fac, hg0_pr1]
  let i₀ : Q_m ⟶ Z_tilde :=
    CategoryTheory.Over.homMk i₀_left (by
      change i₀_left ≫ π_Z.left ≫ Z_cone.hom = Q_m.hom
      rw [← CategoryTheory.Category.assoc, hi₀_πZ_left, CategoryTheory.Category.assoc,
        hp₀_hom, CategoryTheory.Category.comp_id])
  have hi₀_pQ : i₀ ≫ p_Q = 𝟙 Q_m := by
    ext1; exact hi₀_pQ_left
  have hi₀_cl : AlgebraicGeometry.IsClosedImmersion i₀.left := by
    have _ : AlgebraicGeometry.IsClosedImmersion (i₀.left ≫ p_Q.left) := by
      change AlgebraicGeometry.IsClosedImmersion (i₀_left ≫ p_Q.left)
      rw [hi₀_pQ_left]; infer_instance
    have _ : AlgebraicGeometry.IsProper p_Q.left := hProp_pQ
    exact AlgebraicGeometry.IsClosedImmersion.of_comp i₀.left p_Q.left

  
  have hW_ginf_le : ∀ b : Fin (2 * m + 2),
      W b ≤ (TopologicalSpace.Opens.map g_inf.base).obj (C_prod (b.succ.succ, b)) := by
    intro b y hyW
    have hy_pr1 : (g_inf ≫ pr₁).base y ∈ Z_chart b.succ.succ := by
      rw [hginf_pr1]
      exact hσ_Db b hyW
    have hy_pr2 : (g_inf ≫ pr₂).base y ∈ W b := by
      rw [hginf_pr2]; exact hyW
    exact ⟨hy_pr1, hy_pr2⟩

  have hΦ_ginf_zero : ∀ (b : Fin (2 * m + 2)) (ad : MinorIdx),
      (g_inf.appLE (C_prod (b.succ.succ, b)) (W b) (hW_ginf_le b)).hom
        (Φ_inc (b.succ.succ, b) ad) = 0 := by
    intro b ⟨a, d⟩
    have h_ginf_ξ : ∀ r : Fin (2 * m + 2),
        (g_inf.appLE (C_prod (b.succ.succ, b)) (W b) (hW_ginf_le b)).hom
          ((pr₁.appLE (Z_chart b.succ.succ) (C_prod (b.succ.succ, b)) inf_le_left).hom
            (ξ b.succ.succ r.succ.succ)) = η b r := by
      intro r
      have hc1 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE g_inf pr₁
        (Z_chart b.succ.succ) (C_prod (b.succ.succ, b)) (W b) inf_le_left (hW_ginf_le b)
      have hc2 : (g_inf ≫ pr₁).appLE (Z_chart b.succ.succ) (W b) (fun _ hy => (hW_ginf_le b hy).1) =
          σ_inf.left.appLE (Z_chart b.succ.succ) (W b) (hσ_Db b) :=
        h_appLE_eq hginf_pr1 _ _ _ _
      have hc3 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE σ_inf.left f_Z
        (D_succ b.succ.succ) (Z_chart b.succ.succ) (W b) (le_refl _) (hσ_Db b)
      have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ (ξ b.succ.succ r.succ.succ)) (hc1.trans hc2)
      have h2 := congrArg (fun φ => CommRingCat.Hom.hom φ (ρ_succ b.succ.succ r.succ.succ)) hc3
      exact h1.trans (h2.trans (hσ_coord b r))
    have h_ginf_η : ∀ r : Fin (2 * m + 2),
        (g_inf.appLE (C_prod (b.succ.succ, b)) (W b) (hW_ginf_le b)).hom
          ((pr₂.appLE (W b) (C_prod (b.succ.succ, b)) inf_le_right).hom (η b r)) = η b r := by
      intro r
      have hc1 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE g_inf pr₂
        (W b) (C_prod (b.succ.succ, b)) (W b) inf_le_right (hW_ginf_le b)
      have h_id_sub_Qm : W b ≤
          (TopologicalSpace.Opens.map (CategoryTheory.Over.Hom.left (𝟙 Q_m)).base).obj (W b) :=
        fun _ hy => hy
      have hc2 : (g_inf ≫ pr₂).appLE (W b) (W b) (fun _ hy => (hW_ginf_le b hy).2) = 𝟙 _ := by
        refine (h_appLE_eq hginf_pr2 (W b) (W b) _ h_id_sub_Qm).trans ?_
        have hid1 := AlgebraicGeometry.Scheme.Hom.app_eq_appLE (𝟙 Q_m.left) (U := W b)
        exact hid1.symm.trans (AlgebraicGeometry.Scheme.Hom.id_app (W b))
      exact congrArg (fun φ => CommRingCat.Hom.hom φ (η b r)) (hc1.trans hc2)
    dsimp only [Φ_inc]
    rw [map_sub, map_mul, map_mul, h_ginf_ξ a, h_ginf_ξ d, h_ginf_η d, h_ginf_η a]
    ring

  obtain ⟨i_inf_left, hi_inf_fac⟩ :=
    hLift_inc Q_m.left g_inf (Fin (2 * m + 2)) W hW_cov
      (fun b => (b.succ.succ, b)) hW_ginf_le hΦ_ginf_zero

  have hi_inf_pQ_left : i_inf_left ≫ p_Q.left = 𝟙 Q_m.left := by
    change i_inf_left ≫ ι_inc ≫ pr₂ = 𝟙 Q_m.left
    rw [← CategoryTheory.Category.assoc, hi_inf_fac, hginf_pr2]
  have hi_inf_πZ_left : i_inf_left ≫ π_Z.left = σ_inf.left := by
    change i_inf_left ≫ ι_inc ≫ pr₁ = _
    rw [← CategoryTheory.Category.assoc, hi_inf_fac, hginf_pr1]
  let i_inf : Q_m ⟶ Z_tilde :=
    CategoryTheory.Over.homMk i_inf_left (by
      change i_inf_left ≫ π_Z.left ≫ Z_cone.hom = Q_m.hom
      rw [← CategoryTheory.Category.assoc, hi_inf_πZ_left, σ_inf.w])
  have hi_inf_pQ : i_inf ≫ p_Q = 𝟙 Q_m := by
    ext1; exact hi_inf_pQ_left

  
  have hPb_i₀ : CategoryTheory.IsPullback i₀.left Q_m.hom π_Z.left p₀ := by
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk
        (show i₀.left ≫ π_Z.left = Q_m.hom ≫ p₀ from hi₀_πZ_left)
        (fun s => s.fst ≫ p_Q.left) ?_ ?_ ?_)
    · intro s
      have h_eq_prod : (s.fst ≫ p_Q.left ≫ i₀.left) ≫ ι_inc = s.fst ≫ ι_inc := by
        change (s.fst ≫ p_Q.left) ≫ (i₀_left ≫ ι_inc) = s.fst ≫ ι_inc
        rw [hi₀_fac]
        apply CategoryTheory.Limits.pullback.hom_ext
        · change ((s.fst ≫ p_Q.left) ≫ g₀) ≫ pr₁ = (s.fst ≫ ι_inc) ≫ pr₁
          have hpb_cond : pr₂ ≫ Q_m.hom = pr₁ ≫ Z_cone.hom :=
            CategoryTheory.Limits.pullback.condition.symm
          calc ((s.fst ≫ p_Q.left) ≫ g₀) ≫ pr₁
            _ = (s.fst ≫ p_Q.left) ≫ (g₀ ≫ pr₁) := CategoryTheory.Category.assoc _ _ _
            _ = (s.fst ≫ (ι_inc ≫ pr₂)) ≫ (Q_m.hom ≫ p₀) := by rw [hg0_pr1]; rfl
            _ = s.fst ≫ ι_inc ≫ (pr₂ ≫ Q_m.hom) ≫ p₀ := by simp only [CategoryTheory.Category.assoc]
            _ = s.fst ≫ ι_inc ≫ (pr₁ ≫ Z_cone.hom) ≫ p₀ := by rw [hpb_cond]
            _ = ((s.fst ≫ π_Z.left) ≫ Z_cone.hom) ≫ p₀ := by
                change s.fst ≫ ι_inc ≫ (pr₁ ≫ Z_cone.hom) ≫ p₀ =
                  ((s.fst ≫ (ι_inc ≫ pr₁)) ≫ Z_cone.hom) ≫ p₀
                simp only [CategoryTheory.Category.assoc]
            _ = ((s.snd ≫ p₀) ≫ Z_cone.hom) ≫ p₀ := by rw [s.condition]
            _ = (s.snd ≫ (p₀ ≫ Z_cone.hom)) ≫ p₀ := by
                rw [CategoryTheory.Category.assoc s.snd p₀ Z_cone.hom]
            _ = (s.snd ≫ p₀) := by rw [hp₀_hom, CategoryTheory.Category.comp_id]
            _ = s.fst ≫ π_Z.left := s.condition.symm
            _ = (s.fst ≫ ι_inc) ≫ pr₁ := (CategoryTheory.Category.assoc _ _ _).symm
        · change ((s.fst ≫ p_Q.left) ≫ g₀) ≫ pr₂ = (s.fst ≫ ι_inc) ≫ pr₂
          rw [CategoryTheory.Category.assoc, hg0_pr2, CategoryTheory.Category.comp_id]
          rfl
      rw [← CategoryTheory.cancel_mono ι_inc]
      simpa only [CategoryTheory.Category.assoc] using h_eq_prod
    · intro s
      have hpb_cond : pr₂ ≫ Q_m.hom = pr₁ ≫ Z_cone.hom :=
        CategoryTheory.Limits.pullback.condition.symm
      calc (s.fst ≫ p_Q.left) ≫ Q_m.hom
        _ = s.fst ≫ ι_inc ≫ (pr₂ ≫ Q_m.hom) := by
            change (s.fst ≫ (ι_inc ≫ pr₂)) ≫ Q_m.hom = _
            simp only [CategoryTheory.Category.assoc]
        _ = s.fst ≫ ι_inc ≫ (pr₁ ≫ Z_cone.hom) := by rw [hpb_cond]
        _ = (s.fst ≫ π_Z.left) ≫ Z_cone.hom := by
            change _ = (s.fst ≫ (ι_inc ≫ pr₁)) ≫ Z_cone.hom
            simp only [CategoryTheory.Category.assoc]
        _ = (s.snd ≫ p₀) ≫ Z_cone.hom := by rw [s.condition]
        _ = s.snd ≫ (p₀ ≫ Z_cone.hom) := CategoryTheory.Category.assoc _ _ _
        _ = s.snd := by rw [hp₀_hom, CategoryTheory.Category.comp_id]
    · intro s l hl_fst _
      have hi₀_pQ_id : i₀.left ≫ p_Q.left = 𝟙 Q_m.left := hi₀_pQ_left
      calc l = l ≫ 𝟙 Q_m.left := (CategoryTheory.Category.comp_id l).symm
        _ = l ≫ i₀.left ≫ p_Q.left := by rw [hi₀_pQ_id]
        _ = (l ≫ i₀.left) ≫ p_Q.left := (CategoryTheory.Category.assoc _ _ _).symm
        _ = s.fst ≫ p_Q.left := by rw [hl_fst]

  
  let V_plus : Z_tilde.left.Opens :=
    ⟨(Set.range i₀.left.base)ᶜ,
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding i₀.left).isClosed_range.isOpen_compl⟩
  have hVplus_compl : (V_plus : Set Z_tilde.left) = (Set.range i₀.left.base)ᶜ := rfl

  have hVplus_eq : V_plus = (TopologicalSpace.Opens.map π_Z.left.base).obj U_Z := by
    ext z
    change z ∉ Set.range i₀.left.base ↔ π_Z.left.base z ∈ (U_Z : Set Z_cone.left)
    rw [hUZ_compl, Set.mem_compl_iff]
    refine not_congr ⟨?_, ?_⟩
    · rintro ⟨q, rfl⟩
      refine ⟨Q_m.hom.base q, ?_⟩
      exact (congrArg (fun φ => φ.base q) hi₀_πZ_left).symm
    · rintro ⟨pt, hpt⟩
      obtain ⟨q, hq_i0, _⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_i₀ z pt hpt.symm
      exact ⟨q, hq_i0⟩

  have hRange_iinf : Set.range i_inf.left.base ⊆ Set.range V_plus.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι, hVplus_eq]
    rintro _ ⟨q, rfl⟩
    change (i_inf_left ≫ π_Z.left).base q ∈ (U_Z : Set Z_cone.left)
    rw [hi_inf_πZ_left]
    exact hσ_range ⟨q, rfl⟩
  let s_inf_V : Q_m.left ⟶ V_plus.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift V_plus.ι i_inf.left hRange_iinf
  have hs_inf_V : s_inf_V ≫ V_plus.ι = i_inf.left :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac V_plus.ι i_inf.left hRange_iinf

  
  have hWpQ_Vp : ∀ b : Fin (2 * m + 2),
      (TopologicalSpace.Opens.map p_Q.left.base).obj (W b) ⊓ V_plus = U_chart1 b := by
    intro b
    rw [hVplus_eq]
    apply le_antisymm
    · rintro z ⟨hzW, hzUZ⟩
      change π_Z.left.base z ∈ ⨆ c : Fin (2 * m + 2), Z_chart c.succ.succ at hzUZ
      rw [TopologicalSpace.Opens.mem_iSup] at hzUZ
      obtain ⟨c, hzc⟩ := hzUZ
      exact (hOffDiagCollapse c b).1 ⟨hzc, hzW⟩
    · intro z hz1
      refine ⟨hz1.2, ?_⟩
      change π_Z.left.base z ∈ ⨆ c : Fin (2 * m + 2), Z_chart c.succ.succ
      rw [TopologicalSpace.Opens.mem_iSup]
      exact ⟨b, hz1.1⟩

  have hWpQ_sup : ∀ b : Fin (2 * m + 2),
      (TopologicalSpace.Opens.map p_Q.left.base).obj (W b) = U_chart0 b ⊔ U_chart1 b := by
    intro b
    apply le_antisymm
    · intro z hzW
      have hz_top : π_Z.left.base z ∈ Z_chart 1 ⊔ U_Z := by rw [hZ_cov]; trivial
      rcases hz_top with hz1 | hzUZ
      · exact Or.inl ⟨hz1, hzW⟩
      · right
        rw [← hWpQ_Vp b, hVplus_eq]
        exact ⟨hzW, hzUZ⟩
    · rintro z (hz0 | hz1)
      · exact hz0.2
      · exact hz1.2

  
  
  
  refine ⟨Z_tilde, hProp_Ztilde, π_Z, hProp_πZ, p_Q, hProp_pQ,
    i₀, i_inf, V_plus, s_inf_V, R_b, hCR, hAlg, i_Wb, U_chart0, U_chart1, j_0, j_1,
    ⟨hIso_πZ_UZ, hi₀_pQ, hi_inf_pQ, hi₀_cl, hVplus_compl, hPb_i₀, hs_inf_V⟩,
    fun b => ⟨(hTorusCharts b).1, hWpQ_sup b, hWpQ_Vp b,
      (hj_spec b).1, (hj_spec b).2.1, (hj_spec b).2.2.1, (hj_spec b).2.2.2⟩,
    ?_⟩
  intro _hm hW_ov b
  let b₀ : Fin (2 * m + 2) := ⟨0, by omega⟩
  obtain ⟨⟨y, hy₀, hyb⟩⟩ := hW_ov b
  refine ⟨?_, ?_⟩
  · 
    have hz0_Z1 : π_Z.left.base (i₀.left.base y) ∈ Z_chart 1 := by
      change (i₀_left ≫ π_Z.left).base y ∈ Z_chart 1
      rw [hi₀_πZ_left]
      exact hp₀_D1 (trivial :
        Q_m.hom.base y ∈ (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of K)).Opens))
    have hz0_pQ : p_Q.left.base (i₀.left.base y) = y := by
      change (i₀_left ≫ p_Q.left).base y = y
      rw [hi₀_pQ_left]; rfl
    refine ⟨⟨i₀.left.base y, ⟨hz0_Z1, ?_⟩, ⟨hz0_Z1, ?_⟩⟩⟩
    · change p_Q.left.base (i₀.left.base y) ∈ W b₀
      rwa [hz0_pQ]
    · change p_Q.left.base (i₀.left.base y) ∈ W b
      rwa [hz0_pQ]
  · 
    letI : Algebra K (R_b b) := hAlg b
    obtain ⟨q_0, _, hq0_ι, _, hq0_i, _⟩ := (hj_spec b).1
    have hy_range : y ∈ Set.range (W b).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]; exact hyb
    obtain ⟨y_W, hy_W⟩ := hy_range
    let 𝔭 : PrimeSpectrum (R_b b) := (i_Wb b).hom.base y_W
    have _ : 𝔭.asIdeal.IsPrime := 𝔭.isPrime
    let ψ_ev : Polynomial (R_b b) →+* 𝔭.asIdeal.ResidueField :=
      Polynomial.eval₂RingHom (algebraMap (R_b b) 𝔭.asIdeal.ResidueField) 1
    let x_spec : PrimeSpectrum (Polynomial (R_b b)) :=
      ⟨RingHom.ker ψ_ev, RingHom.ker_isPrime ψ_ev⟩
    let u : (U_chart0 b).toScheme := (j_0 b).inv.base x_spec
    let z₁ : Z_tilde.left := (U_chart0 b).ι.base u
    have hu_j0 : (j_0 b).hom.base u = x_spec := by
      change ((j_0 b).inv ≫ (j_0 b).hom).base x_spec = x_spec
      rw [(j_0 b).inv_hom_id]; rfl
    have hx_basic : x_spec ∈ PrimeSpectrum.basicOpen (Polynomial.X : Polynomial (R_b b)) := by
      rw [PrimeSpectrum.mem_basicOpen]
      change ψ_ev Polynomial.X ≠ 0
      simp only [ψ_ev, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      exact one_ne_zero
    have hz₁_U1 : z₁ ∈ U_chart1 b := by
      have hu_pre : u ∈ (TopologicalSpace.Opens.map (U_chart0 b).ι.base).obj (U_chart1 b) := by
        rw [(hj_spec b).2.1]
        change (j_0 b).hom.base u ∈ PrimeSpectrum.basicOpen (Polynomial.X : Polynomial (R_b b))
        rwa [hu_j0]
      exact hu_pre
    have hz₁_U0b : z₁ ∈ (U_chart0 b : Set Z_tilde.left) := by
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι]; exact ⟨u, rfl⟩
    have hcomap_eq : ((AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Polynomial.C : R_b b →+* Polynomial (R_b b)))).base x_spec :
          PrimeSpectrum (R_b b)) = 𝔭 := by
      apply PrimeSpectrum.ext
      ext r
      change ψ_ev (Polynomial.C r) = 0 ↔ r ∈ 𝔭.asIdeal
      simp only [ψ_ev, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      exact Ideal.algebraMap_residueField_eq_zero
    have hq0_u : q_0.base u = y_W := by
      have h_iWb : (i_Wb b).hom.base (q_0.base u) = 𝔭 := by
        change (q_0 ≫ (i_Wb b).hom).base u = 𝔭
        rw [hq0_i]
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)).base
          ((j_0 b).hom.base u) = 𝔭
        rw [hu_j0]
        exact hcomap_eq
      calc q_0.base u
        _ = ((i_Wb b).hom ≫ (i_Wb b).inv).base (q_0.base u) := by
            rw [(i_Wb b).hom_inv_id]; rfl
        _ = (i_Wb b).inv.base ((i_Wb b).hom.base (q_0.base u)) := rfl
        _ = (i_Wb b).inv.base 𝔭 := by rw [h_iWb]
        _ = ((i_Wb b).hom ≫ (i_Wb b).inv).base y_W := rfl
        _ = y_W := by rw [(i_Wb b).hom_inv_id]; rfl
    have hz₁_pQ : p_Q.left.base z₁ = y := by
      change ((U_chart0 b).ι ≫ p_Q.left).base u = y
      rw [← hq0_ι]
      change (W b).ι.base (q_0.base u) = y
      rw [hq0_u, hy_W]
    have hz₁_U0_0 : z₁ ∈ U_chart0 b₀ := by
      refine ⟨hz₁_U0b.1, ?_⟩
      change p_Q.left.base z₁ ∈ W b₀
      rwa [hz₁_pQ]
    exact ⟨⟨z₁, hz₁_U0_0, hz₁_U1⟩⟩

theorem weil_split_quad_cone_blowup_p1_bundle_step (K : Type u) [Field K]
    (m : ℕ)
    (Q_succ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.IsProper Q_succ.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * (m + 1)) Q_succ.hom]
    (ι_succ : Q_succ.left ⟶ (weilProjectiveSpaceOver K (2 * (m + 1) + 1)).left)
    (hι_succ : ι_succ ≫ (weilProjectiveSpaceOver K (2 * (m + 1) + 1)).hom = Q_succ.hom)
    (hSplit_succ : IsHomogeneousHypersurfacePullbackOver K (2 * (m + 1) + 1) 2
      (𝟙 (weilProjectiveSpaceOver K (2 * (m + 1) + 1)))
      (∑ j ∈ Finset.range (m + 1 + 1),
        if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
          (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
            MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) K) *
            MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0)
      ι_succ) :
    AlgebraicGeometry.GeometricallyIrreducible Q_succ.hom ∧
    ∃ (O_succ : Q_succ.left.Opens)
      (e_O : O_succ.toScheme ≅ (weilAffineSpaceOver K (2 * m + 2)).left)
      (Z_cone : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      (_ : AlgebraicGeometry.IsProper Z_cone.hom)
      (i_Z : Z_cone ⟶ Q_succ)
      (Q_m : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      (_ : AlgebraicGeometry.IsProper Q_m.hom)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) Q_m.hom)
      (_ : 1 ≤ m → AlgebraicGeometry.GeometricallyIrreducible Q_m.hom)
      (ι_m : Q_m.left ⟶ (weilProjectiveSpaceOver K (2 * m + 1)).left)
      (p₀ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ Z_cone.left)
      (U_Z : Z_cone.left.Opens)
      (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      (_ : AlgebraicGeometry.IsProper Z_tilde.hom)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_tilde.hom)
      (_ : 1 ≤ m → AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom)
      (π_Z : Z_tilde ⟶ Z_cone)
      (_ : AlgebraicGeometry.IsProper π_Z.left)
      (_ : AlgebraicGeometry.Surjective π_Z.left)
      (p_Q : Z_tilde ⟶ Q_m)
      (_ : AlgebraicGeometry.IsProper p_Q.left)
      (i₀ i_inf : Q_m ⟶ Z_tilde)
      (V_plus : Z_tilde.left.Opens)
      (s_inf_V : Q_m.left ⟶ V_plus.toScheme)
      (W : Fin (2 * m + 2) → Q_m.left.Opens),
      (e_O.hom ≫ (weilAffineSpaceOver K (2 * m + 2)).hom = O_succ.ι ≫ Q_succ.hom ∧
        AlgebraicGeometry.IsClosedImmersion i_Z.left ∧
        (O_succ : Set Q_succ.left) = (Set.range i_Z.left.base)ᶜ) ∧
      (ι_m ≫ (weilProjectiveSpaceOver K (2 * m + 1)).hom = Q_m.hom ∧
        IsHomogeneousHypersurfacePullbackOver K (2 * m + 1) 2
          (𝟙 (weilProjectiveSpaceOver K (2 * m + 1)))
          (∑ j ∈ Finset.range (m + 1),
            if h : 2 * j + 1 < 2 * m + 1 + 1 then
              (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
                MvPolynomial (Fin (2 * m + 1 + 1)) K) *
                MvPolynomial.X ⟨2 * j + 1, h⟩
            else 0)
          ι_m) ∧
      (p₀ ≫ Z_cone.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) ∧
        (U_Z : Set Z_cone.left) = (Set.range p₀.base)ᶜ ∧
        CategoryTheory.IsIso (π_Z.left ∣_ U_Z)) ∧
      (i₀ ≫ p_Q = 𝟙 Q_m ∧
        i_inf ≫ p_Q = 𝟙 Q_m ∧
        AlgebraicGeometry.IsClosedImmersion i₀.left ∧
        (V_plus : Set Z_tilde.left) = (Set.range i₀.left.base)ᶜ ∧
        CategoryTheory.IsPullback i₀.left Q_m.hom π_Z.left p₀ ∧
        s_inf_V ≫ V_plus.ι = i_inf.left) ∧
      ((⨆ b : Fin (2 * m + 2), W b) = ⊤ ∧
        ∀ b : Fin (2 * m + 2),
          let V_b : V_plus.toScheme.Opens :=
            (TopologicalSpace.Opens.map (V_plus.ι ≫ p_Q.left).base).obj (W b)
          ∃ (e_Wb : (W b).toScheme ≅ (weilAffineSpaceOver K (2 * m)).left)
            (e_Vb : V_b.toScheme ≅
              CategoryTheory.Limits.pullback (weilAffineSpaceOver K (2 * m)).hom
                (weilAffineSpaceOver K 1).hom),
            e_Wb.hom ≫ (weilAffineSpaceOver K (2 * m)).hom = (W b).ι ≫ Q_m.hom ∧
            e_Vb.hom ≫
                CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K (2 * m)).hom
                  (weilAffineSpaceOver K 1).hom =
              ((V_plus.ι ≫ p_Q.left) ∣_ (W b)) ≫ e_Wb.hom) ∧
      (m = 0 →
        let W_tilde : Fin (2 * m + 2) → Z_tilde.left.Opens :=
          fun b => (TopologicalSpace.Opens.map p_Q.left.base).obj (W b)
        W_tilde ⟨0, by omega⟩ ⊓ W_tilde ⟨1, by omega⟩ = ⊥ ∧
        W_tilde ⟨0, by omega⟩ ⊔ W_tilde ⟨1, by omega⟩ = ⊤ ∧
        ∀ b : Fin (2 * m + 2),
          ∃ e_P1 : (W_tilde b).toScheme ≅ (weilProjectiveSpaceOver K 1).left,
            e_P1.hom ≫ (weilProjectiveSpaceOver K 1).hom = (W_tilde b).ι ≫ Z_tilde.hom) :=
by
  classical
  have hGeomOfInt : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))),
      AlgebraicGeometry.IsIntegral (weilBaseChangeOver K (AlgebraicClosure K) Y).left →
      AlgebraicGeometry.GeometricallyIrreducible Y.hom := by
    intro Y hInt
    exact weil_geometricallyIrreducible_of_algClosure_pullback K (AlgebraicClosure K) Y
      (weilBaseChangeOver K (AlgebraicClosure K) Y) hInt
      (CategoryTheory.Limits.pullback.fst Y.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      (CategoryTheory.IsPullback.of_hasPullback Y.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))

  obtain ⟨hHypEx, hConeVertex⟩ := weil_split_quad_hypersurface_pullback_and_cone_vertex K
  obtain ⟨hAffChartCrit, hQuadChart⟩ := weil_split_quad_chart_partner_elim_and_irred_cover K
  obtain ⟨hPolyProdAff, hP1Glue⟩ := weil_split_quad_affine_poly_product_and_p1_glue K

  
  obtain ⟨hW_succ_cov, he_W_succ, -, hW_succ_ov⟩ :=
    hQuadChart (m + 1) Q_succ ι_succ hι_succ hSplit_succ
  have hGeom_Qsucc : AlgebraicGeometry.GeometricallyIrreducible Q_succ.hom := by
    refine hGeomOfInt Q_succ ?_
    exact (hAffChartCrit (2 * (m + 1)) (2 * (m + 1) + 2) (by omega) Q_succ
      (fun b => (TopologicalSpace.Opens.map ι_succ.base).obj
        (weilProjBasicOpen K (2 * (m + 1) + 1) b))
      hW_succ_cov he_W_succ).2 (hW_succ_ov (Nat.le_add_left 1 m))
  let idx0_succ : Fin (2 * (m + 1) + 2) := ⟨0, by omega⟩
  let O_succ : Q_succ.left.Opens :=
    (TopologicalSpace.Opens.map ι_succ.base).obj
      (weilProjBasicOpen K (2 * (m + 1) + 1) idx0_succ)
  obtain ⟨e_O, he_O⟩ := he_W_succ idx0_succ

  
  have hX0_hom : (MvPolynomial.X 0 : MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 1 + 1)) K ((1 : ℕ) • 1) := by
    let z0 : Fin (2 * (m + 1) + 1 + 1) := 0
    change (MvPolynomial.X z0 : MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 1 + 1)) K 1
    rw [MvPolynomial.mem_homogeneousSubmodule]
    exact MvPolynomial.isHomogeneous_X K z0
  obtain ⟨Z_cone, i_Z, hSplit_Z⟩ :=
    hHypEx (2 * (m + 1) + 1) 1 (le_refl 1) Q_succ
      (CategoryTheory.Over.homMk ι_succ hι_succ) (MvPolynomial.X 0) hX0_hom
  have hiZ_cl : AlgebraicGeometry.IsClosedImmersion i_Z.left := hSplit_Z.1
  have hProp_Zcone : AlgebraicGeometry.IsProper Z_cone.hom := by
    rw [← i_Z.w]
    infer_instance
  have hO_compl : (O_succ : Set Q_succ.left) = (Set.range i_Z.left.base)ᶜ := by
    obtain ⟨_, hRange_iZ, _⟩ := hSplit_Z.2
    rw [hRange_iZ, compl_compl]
    have hidx0 : idx0_succ = (0 : Fin (2 * (m + 1) + 1 + 1)) := Fin.ext rfl
    dsimp only [O_succ, weilProjBasicOpen]
    rw [hidx0]
    rfl

  let F_split_m : MvPolynomial (Fin (2 * m + 1 + 1)) K :=
    ∑ j ∈ Finset.range (m + 1),
      if h : 2 * j + 1 < 2 * m + 1 + 1 then
        (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
          MvPolynomial (Fin (2 * m + 1 + 1)) K) *
          MvPolynomial.X ⟨2 * j + 1, h⟩
      else 0
  have hFm_hom : F_split_m ∈
      MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) K ((2 : ℕ) • 1) := by
    change F_split_m ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) K (1 + 1)
    refine Submodule.sum_mem _ fun j _ => ?_
    split_ifs with h
    · let i₁ : Fin (2 * m + 1 + 1) := ⟨2 * j, Nat.lt_of_succ_lt h⟩
      let i₂ : Fin (2 * m + 1 + 1) := ⟨2 * j + 1, h⟩
      rw [MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.IsHomogeneous.mul
        (MvPolynomial.isHomogeneous_X K i₁)
        (MvPolynomial.isHomogeneous_X K i₂)
    · exact Submodule.zero_mem _
  obtain ⟨Q_m, ι_m_ov, hSplit_m⟩ :=
    hHypEx (2 * m + 1) 2 (by decide) (weilProjectiveSpaceOver K (2 * m + 1))
      (𝟙 (weilProjectiveSpaceOver K (2 * m + 1))) F_split_m hFm_hom
  let ι_m : Q_m.left ⟶ (weilProjectiveSpaceOver K (2 * m + 1)).left := ι_m_ov.left
  have hι_m : ι_m ≫ (weilProjectiveSpaceOver K (2 * m + 1)).hom = Q_m.hom := ι_m_ov.w
  have hCl_m : AlgebraicGeometry.IsClosedImmersion ι_m := hSplit_m.1
  have hProp_P2m1 : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver K (2 * m + 1)).hom :=
    weil_canonical_and_projective_baseChange_models.1 K
      (weilProjectiveSpaceOver K (2 * m + 1))
      (weil_projectiveSpace_integral_krullDim_and_dim_zero_iso K (2 * m + 1)).2.1
  have hProp_Qm : AlgebraicGeometry.IsProper Q_m.hom := by
    rw [← hι_m]
    infer_instance

  
  let W : Fin (2 * m + 2) → Q_m.left.Opens :=
    fun b => (TopologicalSpace.Opens.map ι_m.base).obj (weilProjBasicOpen K (2 * m + 1) b)
  obtain ⟨hW_cov, he_Wb, hW_m0_disj, hW_ov⟩ :=
    hQuadChart m Q_m ι_m hι_m hSplit_m
  obtain ⟨hSm_Qm, hInt_Qm_imp⟩ :=
    hAffChartCrit (2 * m) (2 * m + 2) (by omega) Q_m W hW_cov he_Wb
  have hGeom_Qm : 1 ≤ m → AlgebraicGeometry.GeometricallyIrreducible Q_m.hom :=
