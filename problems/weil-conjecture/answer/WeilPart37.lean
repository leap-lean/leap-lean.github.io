        have hαs : α_k ≫ φ_s = 𝟙 (CommRingCat.of k) := by
          apply AlgebraicGeometry.Spec.map_inj.mp
          rw [AlgebraicGeometry.Spec.map_comp, hmap_s, hmap_α,
            ← CategoryTheory.Category.assoc, hs_W_fac, hs, AlgebraicGeometry.Spec.map_id]
        have hpt_bot : ∀ c : k, c ∈ pt_k.asIdeal ↔ c = 0 := by
          intro c
          refine ⟨fun hc => ?_, fun hc => by rw [hc]; exact pt_k.asIdeal.zero_mem⟩
          by_contra hc_ne
