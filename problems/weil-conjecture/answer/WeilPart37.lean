        have hy_W_fac : y_W ≫ j_W = y₀ :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac j_W y₀ hy_sub
        let s_W : S_k ⟶ AlgebraicGeometry.Spec R_W :=
          AlgebraicGeometry.IsOpenImmersion.lift j_W s hs_sub
        have hs_W_fac : s_W ≫ j_W = s :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac j_W s hs_sub
        have hsW_pt : s_W.base pt_k = y_W.base pt_k := by
          apply j_W.isOpenEmbedding.injective
          change (s_W ≫ j_W).base pt_k = (y_W ≫ j_W).base pt_k
          rw [hs_W_fac, hy_W_fac]
          exact hpt_eq
        let φ_y : R_W ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage y_W
        let φ_s : R_W ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage s_W
