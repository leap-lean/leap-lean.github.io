        rw [← ha_loc,
          CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero a_loc
            (CategoryTheory.Abelian.Ext.mk₀
              (weilCupPDLocalCounit (weilGeomScheme K X) (ℓ ^ (r + 1)) U_et))
            b₀ hc_top,
          hb₀_U, CategoryTheory.Abelian.Ext.comp_zero]
      have hPre_sub : CategoryTheory.Abelian.Ext.comp a (b₁ - (Nat.card K ^ c) • b₀) hc_top =
          CategoryTheory.Abelian.Ext.comp a b₁ hc_top -
            (Nat.card K ^ c) • CategoryTheory.Abelian.Ext.comp a b₀ hc_top := by
        change (a.precomp _ hc_top) (b₁ - (Nat.card K ^ c) • b₀) = _
        rw [map_sub, map_nsmul]
        rfl
      have hPost_γ₀ : θ_top (CategoryTheory.Abelian.Ext.comp
          ((Nat.card K ^ (d - c)) • a₀ - a) b₀ hc_top) =
          (Nat.card K ^ (d - c)) • θ_top (CategoryTheory.Abelian.Ext.comp a₀ b₀ hc_top) -
            θ_top (CategoryTheory.Abelian.Ext.comp a b₀ hc_top) := by
        have hpost : CategoryTheory.Abelian.Ext.comp ((Nat.card K ^ (d - c)) • a₀ - a) b₀ hc_top =
            (Nat.card K ^ (d - c)) • CategoryTheory.Abelian.Ext.comp a₀ b₀ hc_top -
              CategoryTheory.Abelian.Ext.comp a b₀ hc_top := by
          change (b₀.postcomp _ hc_top) ((Nat.card K ^ (d - c)) • a₀ - a) = _
          rw [map_sub, map_nsmul]
          rfl
        rw [hpost, map_sub, map_nsmul]
      have hexp : Nat.card K ^ d = Nat.card K ^ c * Nat.card K ^ (d - c) := by
        rw [← pow_add]
        congr 1
        omega
      have hDiffEq : θ_top (CategoryTheory.Abelian.Ext.comp a
          (b₁ - (Nat.card K ^ c) • b₀) hc_top) =
          (Nat.card K ^ c) • θ_top (CategoryTheory.Abelian.Ext.comp
