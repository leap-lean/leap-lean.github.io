          f_P p_Vp hf_P hp_Vp (w - p_p (p_iinf w)) hw₁_Vp

      have hw_split : w = p_p (p_iinf w) + (w - p_p (p_iinf w)) :=
        (add_sub_cancel (p_p (p_iinf w)) w).symm
      conv_lhs => rw [hw_split]
      conv_rhs => rw [hw_split]
      rw [map_add, hf_w₀, hf_w₁, smul_add]

  
  have hClopenPkg : ∀ (Y X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      (d_X : ℕ)
      (U₀ U₁ : Y.left.Opens)
      (_ : U₀ ⊓ U₁ = ⊥) (_ : U₀ ⊔ U₁ = ⊤)
      (e₀ : U₀.toScheme ≅ X.left) (_ : e₀.hom ≫ X.hom = U₀.ι ≫ Y.hom)
      (e₁ : U₁.toScheme ≅ X.left) (_ : e₁.hom ≫ X.hom = U₁.ι ≫ Y.hom),
      (∀ c : ℕ, Subsingleton (weilEtaleTorsionH (weilGeomScheme K X) (ℓ ^ (r + 1)) (2 * c + 1))) →
      (∀ c : ℕ, c ≤ d_X →
        ∀ (f_X : weilEtaleTorsionH (weilGeomScheme K X) (ℓ ^ (r + 1)) (2 * c) →+
              weilEtaleTorsionH (weilGeomScheme K X) (ℓ ^ (r + 1)) (2 * c)),
          WeilIsTorsionGeomFrobAction K X (ℓ ^ (r + 1)) (2 * c) f_X →
          ∀ u, f_X u = (Nat.card K ^ c) • u) →
      (∀ c : ℕ, Subsingleton (weilEtaleTorsionH (weilGeomScheme K Y) (ℓ ^ (r + 1)) (2 * c + 1))) ∧
      (∀ c : ℕ, c ≤ d_X →
        ∀ (f_Y : weilEtaleTorsionH (weilGeomScheme K Y) (ℓ ^ (r + 1)) (2 * c) →+
              weilEtaleTorsionH (weilGeomScheme K Y) (ℓ ^ (r + 1)) (2 * c)),
          WeilIsTorsionGeomFrobAction K Y (ℓ ^ (r + 1)) (2 * c) f_Y →
          ∀ w, f_Y w = (Nat.card K ^ c) • w) := by
    intro Y X d_X U₀ U₁ hInf hSup e₀ he₀ e₁ he₁ hX_odd hX_even
    let pr_Y : weilGeomScheme K Y ⟶ Y.left := CategoryTheory.Limits.pullback.fst Y.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
    let U₀_bar : (weilGeomScheme K Y).Opens := (TopologicalSpace.Opens.map pr_Y.base).obj U₀
    let U₁_bar : (weilGeomScheme K Y).Opens := (TopologicalSpace.Opens.map pr_Y.base).obj U₁
    have hInf_bar : U₀_bar ⊓ U₁_bar = ⊥ := by
      ext z
      change pr_Y.base z ∈ (U₀ ⊓ U₁ : Y.left.Opens) ↔ False
      rw [hInf]
      rfl
    have hSup_bar : U₀_bar ⊔ U₁_bar = ⊤ := by
      ext z
      change pr_Y.base z ∈ (U₀ ⊔ U₁ : Y.left.Opens) ↔ True
      rw [hSup]
      rfl
    obtain ⟨⟨e₀_bar, _⟩, hFrob_U₀⟩ := hOpenOverTransfer U₀ e₀ he₀
    obtain ⟨⟨e₁_bar, _⟩, hFrob_U₁⟩ := hOpenOverTransfer U₁ e₁ he₁
    refine ⟨?_, ?_⟩
    · intro c
      obtain ⟨p₀, hp₀⟩ := hPullEx U₀_bar.ι (ℓ ^ (r + 1)) (2 * c + 1)
      obtain ⟨p₁, hp₁⟩ := hPullEx U₁_bar.ι (ℓ ^ (r + 1)) (2 * c + 1)
      obtain ⟨p_e₀h, hp_e₀h⟩ := hPullEx e₀_bar.hom (ℓ ^ (r + 1)) (2 * c + 1)
      obtain ⟨p_e₀i, hp_e₀i⟩ := hPullEx e₀_bar.inv (ℓ ^ (r + 1)) (2 * c + 1)
      obtain ⟨p_e₁h, hp_e₁h⟩ := hPullEx e₁_bar.hom (ℓ ^ (r + 1)) (2 * c + 1)
      obtain ⟨p_e₁i, hp_e₁i⟩ := hPullEx e₁_bar.inv (ℓ ^ (r + 1)) (2 * c + 1)
      have hBij₀ := hPullIsoBij e₀_bar (ℓ ^ (r + 1)) (2 * c + 1) p_e₀h p_e₀i hp_e₀h hp_e₀i
      have hBij₁ := hPullIsoBij e₁_bar (ℓ ^ (r + 1)) (2 * c + 1) p_e₁h p_e₁i hp_e₁h hp_e₁i
      have hSub₀ : Subsingleton
          (weilEtaleTorsionH U₀_bar.toScheme (ℓ ^ (r + 1)) (2 * c + 1)) := by
        refine ⟨fun u v => ?_⟩
        obtain ⟨a, rfl⟩ := hBij₀.2 u
        obtain ⟨b, rfl⟩ := hBij₀.2 v
        exact congrArg p_e₀h ((hX_odd c).elim a b)
      have hSub₁ : Subsingleton
          (weilEtaleTorsionH U₁_bar.toScheme (ℓ ^ (r + 1)) (2 * c + 1)) := by
        refine ⟨fun u v => ?_⟩
        obtain ⟨a, rfl⟩ := hBij₁.2 u
        obtain ⟨b, rfl⟩ := hBij₁.2 v
        exact congrArg p_e₁h ((hX_odd c).elim a b)
      refine ⟨fun a b => sub_eq_zero.mp ?_⟩
      exact hClopenInj (weilGeomScheme K Y) U₀_bar U₁_bar hInf_bar hSup_bar
        (ℓ ^ (r + 1)) (2 * c + 1) p₀ p₁ hp₀ hp₁ (a - b) (hSub₀.elim _ _) (hSub₁.elim _ _)
    · intro c hc f_Y hf_Y w
      obtain ⟨p₀, hp₀⟩ := hPullEx U₀_bar.ι (ℓ ^ (r + 1)) (2 * c)
      obtain ⟨p₁, hp₁⟩ := hPullEx U₁_bar.ι (ℓ ^ (r + 1)) (2 * c)
      have hz₀ := hFrob_U₀ (2 * c) (Nat.card K ^ c) (hX_even c hc) f_Y p₀ hf_Y hp₀ w
      have hz₁ := hFrob_U₁ (2 * c) (Nat.card K ^ c) (hX_even c hc) f_Y p₁ hf_Y hp₁ w
      exact sub_eq_zero.mp (hClopenInj (weilGeomScheme K Y) U₀_bar U₁_bar hInf_bar hSup_bar
        (ℓ ^ (r + 1)) (2 * c) p₀ p₁ hp₀ hp₁ (f_Y w - (Nat.card K ^ c) • w) hz₀ hz₁)

  
