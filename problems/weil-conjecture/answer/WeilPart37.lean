    have hSm_WQ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) W_Q.hom :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_WQ1 hSm_Qs2
    have hMod_WQ : IsFieldPullbackModel F (AlgebraicClosure F) Q_s W_Q (p_WQ1 ≫ p_WQ2) := by
      change CategoryTheory.IsPullback (p_WQ1 ≫ p_WQ2) W_Q.hom Q_s.hom g_k
