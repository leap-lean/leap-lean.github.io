        invFun := ψ_cat.hom
        left_inv := fun s => congrArg (fun f => f.hom s) hφψ
        right_inv := fun r => congrArg (fun f => f.hom r) hψφ }
    have hρ_cat : CommRingCat.ofHom ρ.toRingHom = φ_cat := rfl
    have hρ_K : ∀ c : K, ρ (algebraMap K S_d c) = algebraMap K R c := by
