              CategoryTheory.Abelian.Ext.eq_zero_of_injective _
            exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (Z_obj W) hSE_F z hzj
              (rfl : (r₀ + 1) + 1 = r₀ + 2)
        let eqv_W := AddEquiv.ofBijective φ_W hBij_W
        refine ⟨⟨AddCommGrpCat.ofHom eqv_W.symm.toAddMonoidHom, ?_, ?_⟩⟩
        · ext a
          exact eqv_W.symm_apply_apply a
        · ext b
          exact eqv_W.apply_symm_apply b
      haveI : CategoryTheory.IsIso δ_pre :=
        (CategoryTheory.NatTrans.isIso_iff_isIso_app δ_pre).mpr hIso_app
      exact ⟨(E_Y.mapIso (CategoryTheory.asIso δ_pre)).symm⟩
    exact ⟨𝒥, 𝒬, inferInstance, hInj_PJ, j, p, hjp, hSE_F, ℬ, ι_B, inferInstance, π_B, δ₀,
      h₁, h₂, hSE₁, hSE₂, hfac, hIntertwine, hShift⟩
  
  have hΛ_inj : ∀ (q₀ : ℕ) (ℱ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
