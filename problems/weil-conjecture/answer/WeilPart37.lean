          rw [MvPolynomial.as_sum (p := P), map_sum, Polynomial.finset_sum_coeff] at hcoeff0
          have hsum_eq : (∑ x ∈ P.support,
              (α_tilde_0 (MvPolynomial.monomial x (P.coeff x))).coeff (d₀ (0, 0))) = P.coeff d₀ := by
            rw [Finset.sum_eq_single d₀]
            · rw [hMon0, if_pos h01, Polynomial.coeff_monomial, if_pos rfl]
            · intro x _ hx_ne
