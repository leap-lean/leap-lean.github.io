            ULift.ext _ _ (zsmul_one m)
          rw [map_zsmul map_π.hom m u_bty, hu_bty', ← map_zsmul g₀.hom m (ULift.up (1 : ℤ)),
            hm_up]
        let f_J : Fℤ_Y ⟶ pf_y₀.obj J_inj := (adj_Y.homEquiv Aℤ (pf_y₀.obj J_inj)).symm g_J
        have hf_J_comp : f_J ≫ (SC_A.map pf_y₀).g = f_Q := by
          apply (adj_Y.homEquiv Aℤ (pf_y₀.obj Q)).injective
          have hf_J_eq : (adj_Y.homEquiv Aℤ (pf_y₀.obj J_inj)) f_J = g_J :=
            (adj_Y.homEquiv Aℤ (pf_y₀.obj J_inj)).apply_symm_apply g_J
          exact (adj_Y.homEquiv_naturality_right f_J (pf_y₀.map π_A)).trans
            ((congrArg (· ≫ ((CategoryTheory.sheafSections J_Y AddCommGrpCat.{u}).obj
                (Opposite.op T_Y)).map (pf_y₀.map π_A)) hf_J_eq).trans hg_J_comp)
        have hq₀_fac : q₀ =
            (CategoryTheory.Abelian.Ext.mk₀ f_J).comp
              (CategoryTheory.Abelian.Ext.mk₀ (SC_A.map pf_y₀).g) (Nat.zero_add 0) := by
          rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hf_J_comp]
          exact (CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply q₀).symm
        rw [← hq₀, hq₀_fac,
          CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add 1),
          hSE_pf.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      | succ k₀ ih =>
        intro A
        refine ⟨fun x₁ x₂ => ?_⟩
        suffices h0 : ∀ x : (pf_y₀.obj A).H (k₀ + 2), x = 0 from (h0 x₁).trans (h0 x₂).symm
        intro x
        let J_inj := CategoryTheory.Injective.under A
        let ι_A : A ⟶ J_inj := CategoryTheory.Injective.ι A
        let Q := CategoryTheory.Limits.cokernel ι_A
        let π_A : J_inj ⟶ Q := CategoryTheory.Limits.cokernel.π ι_A
        let SC_A : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_k AddCommGrpCat.{u}) :=
          CategoryTheory.ShortComplex.mk ι_A π_A (CategoryTheory.Limits.cokernel.condition ι_A)
        have hSE_A : SC_A.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk'
            (CategoryTheory.ShortComplex.exact_of_g_is_cokernel _
              (CategoryTheory.Limits.cokernelIsCokernel _))
            inferInstance inferInstance
        obtain ⟨hEx_pf, hMono_pf⟩ :=
          (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_y₀).mp
            inferInstance SC_A hSE_A
        have hEpi_π : CategoryTheory.Epi (pf_y₀.map π_A) := hEpi_pf π_A
        have hSE_pf : (SC_A.map pf_y₀).ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk' hEx_pf hMono_pf hEpi_π
        haveI : CategoryTheory.Injective (SC_A.map pf_y₀).X₂ :=
          CategoryTheory.Adjunction.map_injective adj_y₀ J_inj inferInstance
        have hx_map0 :
            (x : CategoryTheory.Abelian.Ext Fℤ_Y (pf_y₀.obj A) (k₀ + 2)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (SC_A.map pf_y₀).f) (Nat.add_zero (k₀ + 2)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨q_next, hq_next⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_Y hSE_pf x hx_map0
            (rfl : (k₀ + 1) + 1 = k₀ + 2)
        have hq_zero : q_next = 0 := (ih Q).elim q_next 0
        rw [← hq_next, hq_zero, CategoryTheory.Abelian.Ext.zero_comp]

    intro p
    have hSub_pf := hVanish_pf p G₀
    refine ⟨fun u₁ u₂ => ?_⟩
    have hpost_eq :
        (u₁ : CategoryTheory.Abelian.Ext Fℤ_Y G (p + 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ η_G) (Nat.add_zero (p + 1)) =
        (u₂ : CategoryTheory.Abelian.Ext Fℤ_Y G (p + 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ η_G) (Nat.add_zero (p + 1)) :=
      hSub_pf.elim _ _
    have hcancel : ∀ u : CategoryTheory.Abelian.Ext Fℤ_Y G (p + 1),
        (u.comp (CategoryTheory.Abelian.Ext.mk₀ η_G) (Nat.add_zero (p + 1))).comp
          (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv η_G)) (Nat.add_zero (p + 1)) = u := by
      intro u
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
    rw [← hcancel u₁, ← hcancel u₂, hpost_eq]

  · 
    intro hG₀
    have hZero_pb_y₀ : CategoryTheory.Limits.IsZero (pb_y₀.obj G) :=
      hPbZeroOfWitness y₀ G hG₀
    have hZero_G : CategoryTheory.Limits.IsZero G := by
      refine hZeroCons G fun s hs => ?_
      rcases hSecDichot s hs with ⟨s_U, hs_U⟩ | rfl
      · exact hSubOfIsZero _ T_k (hPbCompZero s s_U hs_U)
      · exact hSubOfIsZero _ T_k hZero_pb_y₀
    refine ⟨fun x₁ x₂ => ?_⟩
    apply CategoryTheory.Abelian.Ext.homEquiv₀.injective
    exact hZero_G.eq_of_tgt _ _

theorem weil_odp_modif_degenerate_leray_edge_injective {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
    [_hc : (weilEtaleSitePullback f).IsContinuous Y.smallEtaleTopology X.smallEtaleTopology]
    [_hr : ((weilEtaleSitePullback f).sheafPushforwardContinuous
      AddCommGrpCat.{u} Y.smallEtaleTopology X.smallEtaleTopology).IsRightAdjoint] :
    let P_push := (weilEtaleSitePullback f).sheafPushforwardContinuous
      AddCommGrpCat.{u} Y.smallEtaleTopology X.smallEtaleTopology
    let P_pull := (weilEtaleSitePullback f).sheafPullback
      AddCommGrpCat.{u} Y.smallEtaleTopology X.smallEtaleTopology
    let adj_pull := (weilEtaleSitePullback f).sheafAdjunctionContinuous
      AddCommGrpCat.{u} Y.smallEtaleTopology X.smallEtaleTopology
    ∀ [P_pull.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits P_pull]
      [CategoryTheory.Limits.PreservesFiniteColimits P_pull]
      (ιℤ : (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶
        P_pull.obj ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))))
      (πℤ : P_pull.obj ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) ⟶
        (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))),
      ιℤ ≫ πℤ = 𝟙 _ →
      πℤ ≫ ιℤ = 𝟙 _ →
      ∀ (ℱ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q₀ : ℕ),
        (1 ≤ q₀ →
          (∀ (b p : ℕ), Subsingleton ((weilEtaleHigherDirectImage f (b + 1) ℱ).H (p + 1))) ∧
          Subsingleton ((weilEtaleHigherDirectImage f q₀ ℱ).H 0)) →
        Function.Injective
          (fun z : (P_push.obj ℱ).H (q₀ + 1) =>
            (CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app ℱ)).postcomp
              ((CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
                (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero (q₀ + 1))
              ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
                ((P_pull.mapExtAddHom
                  ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
                    (AddCommGrpCat.of (ULift.{u} ℤ)))
                  (P_push.obj ℱ) (q₀ + 1)) z) (Nat.zero_add (q₀ + 1)))) :=
by
  intro P_push P_pull adj_pull hAdd_pull hLim_pull hColim_pull ιℤ πℤ hιπ hπι ℱ₀ q₀ hHyp₀
  letI := hAdd_pull
  letI := hLim_pull
  letI := hColim_pull
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let J_X := X.smallEtaleTopology
  let J_Y := Y.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_X := (CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_Y := (CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}).obj Aℤ
  let B_f : CategoryTheory.Functor Y.Etale X.Etale := weilEtaleSitePullback f
  letI : P_push.IsRightAdjoint := _hr
  letI : P_push.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products P_push
  letI : CategoryTheory.Limits.PreservesFiniteLimits P_push := ⟨fun _ _ _ => inferInstance⟩
  
  let Λ : ∀ (n : ℕ) (ℋ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
      CategoryTheory.Abelian.Ext.{u} Fℤ_Y (P_push.obj ℋ) n →+
        CategoryTheory.Abelian.Ext.{u} (P_pull.obj Fℤ_Y) ℋ n :=
    fun n ℋ =>
      ((CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app ℋ)).postcomp
        (P_pull.obj Fℤ_Y) (Nat.add_zero n)).comp
        (P_pull.mapExtAddHom Fℤ_Y (P_push.obj ℋ) n)
  have hΛ₀_bij : ∀ (ℋ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
      Function.Bijective (Λ 0 ℋ) := by
    intro ℋ
    let eqv₀ : CategoryTheory.Abelian.Ext.{u} Fℤ_Y (P_push.obj ℋ) 0 ≃
        CategoryTheory.Abelian.Ext.{u} (P_pull.obj Fℤ_Y) ℋ 0 :=
      CategoryTheory.Abelian.Ext.homEquiv₀.trans
        ((adj_pull.homEquiv Fℤ_Y ℋ).symm.trans CategoryTheory.Abelian.Ext.homEquiv₀.symm)
    have heq : (Λ 0 ℋ : CategoryTheory.Abelian.Ext.{u} Fℤ_Y (P_push.obj ℋ) 0 →
        CategoryTheory.Abelian.Ext.{u} (P_pull.obj Fℤ_Y) ℋ 0) = eqv₀ := by
      funext z
      let u : Fℤ_Y ⟶ P_push.obj ℋ := CategoryTheory.Abelian.Ext.homEquiv₀ z
      have hz : z = CategoryTheory.Abelian.Ext.mk₀ u := by
        dsimp [u]
        rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.symm_apply_apply]
      change ((P_pull.mapExtAddHom Fℤ_Y (P_push.obj ℋ) 0 z).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app ℋ)) (Nat.add_zero 0)) =
        CategoryTheory.Abelian.Ext.homEquiv₀.symm ((adj_pull.homEquiv Fℤ_Y ℋ).symm u)
      rw [hz, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Adjunction.homEquiv_counit adj_pull Fℤ_Y ℋ u,
        CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
    rw [heq]
    exact eqv₀.bijective
  have hΛ_nat : ∀ {ℋ₁ ℋ₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
      (α : ℋ₁ ⟶ ℋ₂) (n : ℕ)
      (u₁ : CategoryTheory.Abelian.Ext.{u} Fℤ_Y (P_push.obj ℋ₁) n),
      Λ n ℋ₂ (u₁.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map α)) (Nat.add_zero n)) =
        (Λ n ℋ₁ u₁).comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero n) := by
    intro ℋ₁ ℋ₂ α n u₁
    change (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull
        (u₁.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map α)) (Nat.add_zero n))).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app ℋ₂)) (Nat.add_zero n) =
      ((CategoryTheory.Abelian.Ext.mapExactFunctor P_pull u₁).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app ℋ₁)) (Nat.add_zero n)).comp
        (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero n)
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc _ _ _
        (Nat.add_zero n) (Nat.zero_add 0) (Nat.add_zero n),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc _ _ _
        (Nat.add_zero n) (Nat.zero_add 0) (Nat.add_zero n),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    congr 2
    exact adj_pull.counit.naturality α
  have hMonoExt₀ : ∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
      (μ : 𝒢₁ ⟶ 𝒢₂) [CategoryTheory.Mono μ]
      {x₁ x₂ : CategoryTheory.Abelian.Ext.{u} Fℤ_Y 𝒢₁ 0},
      x₁.comp (CategoryTheory.Abelian.Ext.mk₀ μ) (Nat.add_zero 0) =
        x₂.comp (CategoryTheory.Abelian.Ext.mk₀ μ) (Nat.add_zero 0) →
      x₁ = x₂ := by
    intro 𝒢₁ 𝒢₂ μ _ x₁ x₂ hcomp
    let v₁ : Fℤ_Y ⟶ 𝒢₁ := CategoryTheory.Abelian.Ext.homEquiv₀ x₁
    let v₂ : Fℤ_Y ⟶ 𝒢₁ := CategoryTheory.Abelian.Ext.homEquiv₀ x₂
    have hx₁ : x₁ = CategoryTheory.Abelian.Ext.mk₀ v₁ := by
      dsimp [v₁]
      rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.symm_apply_apply]
    have hx₂ : x₂ = CategoryTheory.Abelian.Ext.mk₀ v₂ := by
      dsimp [v₂]
      rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.symm_apply_apply]
    rw [hx₁, hx₂, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hcomp
    have hv_μ : v₁ ≫ μ = v₂ ≫ μ := by
      have h1 := congrArg CategoryTheory.Abelian.Ext.homEquiv₀ hcomp
      rwa [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
        ← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
        Equiv.apply_symm_apply, Equiv.apply_symm_apply] at h1
    have hv : v₁ = v₂ := (CategoryTheory.cancel_mono μ).mp hv_μ
    rw [hx₁, hx₂, hv]
  have hSubIso : ∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
      (e : 𝒢₁ ≅ 𝒢₂) (d : ℕ),
      Subsingleton (𝒢₁.H d) → Subsingleton (𝒢₂.H d) := by
    intro 𝒢₁ 𝒢₂ e d hSub
    refine ⟨fun a b => ?_⟩
    have hab : a.comp (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero d) =
        b.comp (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero d) :=
      @Subsingleton.elim _ hSub _ _
    have hab' := congrArg
      (fun w : CategoryTheory.Abelian.Ext.{u} Fℤ_Y 𝒢₁ d =>
        w.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero d)) hab
    rwa [CategoryTheory.Abelian.Ext.comp_assoc _ _ _
        (Nat.add_zero d) (Nat.zero_add 0) (Nat.add_zero d),
      CategoryTheory.Abelian.Ext.comp_assoc _ _ _
        (Nat.add_zero d) (Nat.zero_add 0) (Nat.add_zero d),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id,
      CategoryTheory.Abelian.Ext.comp_mk₀_id,
      CategoryTheory.Abelian.Ext.comp_mk₀_id] at hab'
  
  let W_B : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u}) :=
    (CategoryTheory.Functor.whiskeringLeft (Opposite Y.Etale) (Opposite X.Etale)
      AddCommGrpCat.{u}).obj B_f.op
  let Sh_Y : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) :=
    CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}
  let E_Y := W_B.comp Sh_Y
  let Φ : ℕ → CategoryTheory.Functor
      (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) :=
    fun q => (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).comp E_Y
  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let Fgt_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
    AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
  let Sh_X := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
  let U_X := CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}
  let L_tot := Free_PSh ⋙ Sh_X
  let R_tot := U_X ⋙ Fgt_PSh
  let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite X.Etale) AddCommGrpCat.adj
  let adj_sh := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
  let adj_tot : L_tot ⊣ R_tot := adj_free.comp adj_sh
  let Z_fun : X.Etale ⥤ CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    CategoryTheory.yoneda ⋙ L_tot
  let Z_obj : Opposite X.Etale → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    fun W => Opposite.unop (Z_fun.op.obj W)
  let e_raw : ∀ (W : Opposite X.Etale) (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
      CategoryTheory.Abelian.Ext (Z_obj W) F 0 ≃ ↑((U_X.obj F).obj W) :=
    fun W F =>
      CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
        ((adj_tot.homEquiv (CategoryTheory.yoneda.obj (Opposite.unop W)) F).trans
          CategoryTheory.yonedaEquiv)
  have he_add : ∀ (W : Opposite X.Etale) (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
      (α₁ α₂ : CategoryTheory.Abelian.Ext (Z_obj W) F 0),
      e_raw W F (α₁ + α₂) = e_raw W F α₁ + e_raw W F α₂ := by
    intro W F α₁ α₂
    let V := Opposite.unop W
    let u₁ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
    let u₂ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
    have hu : CategoryTheory.Abelian.Ext.addEquiv₀ (α₁ + α₂) = u₁ + u₂ :=
      map_add CategoryTheory.Abelian.Ext.addEquiv₀ α₁ α₂
    let ψ : (Z_obj W ⟶ F) → (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X.obj F) :=
