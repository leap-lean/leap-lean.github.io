      have hcomp := AlgebraicGeometry.Scheme.Hom.appLE_map f_X hW (CategoryTheory.homOfLE hW').op
      exact congrArg (fun φ => φ.hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ)).hom (z_F μ))) hcomp

    have hJ_res : ∀ (μ : Fin (M₀ + 1)) {W W' : X₀.Opens} (hW : W ≤ C_open μ) (hW' : W' ≤ W),
