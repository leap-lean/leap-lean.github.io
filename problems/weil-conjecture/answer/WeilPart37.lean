    let z_F : ∀ μ : Fin (M₀ + 1), HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ) :=
      fun μ => HomogeneousLocalization.Away.mk 𝒜 (hX_deg μ) d₀ F hF
    let ℓ_sec : ∀ (μ : Fin (M₀ + 1)) (W : X₀.Opens), W ≤ C_open μ → ↑(X₀.presheaf.obj (Opposite.op W)) :=
      fun μ W hW =>
        (f_X.appLE (D μ) W hW).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ)).hom (z_F μ))
    let J_id : ∀ (μ : Fin (M₀ + 1)) (W : X₀.Opens), W ≤ C_open μ → Ideal ↑(X₀.presheaf.obj (Opposite.op W)) :=
      fun μ W hW => Ideal.span {ℓ_sec μ W hW}

    have hℓ_res : ∀ (μ : Fin (M₀ + 1)) {W W' : X₀.Opens} (hW : W ≤ C_open μ) (hW' : W' ≤ W),
