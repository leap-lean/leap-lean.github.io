      have hpt' : q_pt ∈ PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem
          (hX_succ 1) (hX_succ μ)) := by
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε₁)).base pt ∈
          (PrimeSpectrum.basicOpen _ : (AlgebraicGeometry.Spec (CommRingCat.of A₁)).Opens)
        rw [← hpre]
        exact hpt
      have hnot_mem : HomogeneousLocalization.Away.isLocalizationElem (hX_succ 1) (hX_succ μ) ∉
          q_pt.asIdeal :=
        (PrimeSpectrum.mem_basicOpen _ q_pt).mp hpt'
      apply False.elim
      apply hnot_mem
      change ε₁ (HomogeneousLocalization.Away.isLocalizationElem (hX_succ 1) (hX_succ μ)) ∈ pt.asIdeal
      have heval_zero : ε₁ (HomogeneousLocalization.Away.isLocalizationElem (hX_succ 1) (hX_succ μ)) = 0 := by
        dsimp only [HomogeneousLocalization.Away.isLocalizationElem]
        rw [hε₁_mk]
        dsimp only [ev₀, v₀]
        rw [pow_one, MvPolynomial.eval₂Hom_X', ite_eq_right_iff.mpr (fun h => False.elim (hμ h))]
      rw [heval_zero]
      exact pt.asIdeal.zero_mem

    have hp₀_P_D1 : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of K)).Opens) ≤
        (TopologicalSpace.Opens.map p₀_P.base).obj (D_succ 1) := by
      intro pt _
      have hor := AlgebraicGeometry.Proj.opensRange_awayι 𝒜_succ (MvPolynomial.X 1) (hX_succ 1) zero_lt_one
      have hmem : (AlgebraicGeometry.Proj.awayι 𝒜_succ (MvPolynomial.X 1) (hX_succ 1) zero_lt_one).base
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε₁)).base pt) ∈
          (AlgebraicGeometry.Proj.awayι 𝒜_succ (MvPolynomial.X 1) (hX_succ 1) zero_lt_one).opensRange :=
        ⟨_, rfl⟩
      rwa [hor] at hmem

    have hker_p₀_succ : ι_succ'.ker ≤ p₀_P.ker := by
      apply AlgebraicGeometry.Scheme.IdealSheafData.le_of_iSup_eq_top D_succ_aff hD_succ_cov
      intro μ
      rw [AlgebraicGeometry.Scheme.Hom.ker_apply, AlgebraicGeometry.Scheme.Hom.ker_apply]
      have hker_μ : RingHom.ker (ι_succ'.app (D_succ μ)).hom =
          Ideal.span {(AlgebraicGeometry.Scheme.Hom.appLE (𝟙 P_succ_sch) (D_succ μ) (D_succ μ) (le_refl _)).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X μ)).hom
              (HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ μ) 2 _ hF_succ_mem))} :=
        hKer_succ μ (hX_succ μ) (D_succ μ) (D_succ_aff μ).2 (le_refl _)
      change RingHom.ker (ι_succ'.app (D_succ μ)).hom ≤ RingHom.ker (p₀_P.app (D_succ μ)).hom
      rw [hker_μ, Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      by_cases hμ1 : μ = 1
      · subst hμ1
        let s₁ := (AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom
          (HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) 2 _ hF_succ_mem)
        rw [hIdAppLE P_succ_sch (D_succ 1) s₁]
        have happ_eq : p₀_P.app (D_succ 1) =
            p₀_P.appLE (D_succ 1) ⊤ hp₀_P_D1 ≫
              (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.map
                (CategoryTheory.homOfLE le_top).op := by
          rw [AlgebraicGeometry.Scheme.Hom.appLE_map, AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
        have happ_s₁ : (p₀_P.app (D_succ 1)).hom s₁ =
            ((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.map (CategoryTheory.homOfLE le_top).op).hom
              ((p₀_P.appLE (D_succ 1) ⊤ hp₀_P_D1).hom s₁) :=
          congrArg (fun φ => φ.hom s₁) happ_eq
        rw [happ_s₁, hp₀_P_eval p₀_P rfl hp₀_P_D1]
        have hev_F : ev₀ (∑ j ∈ Finset.range (m + 1 + 1),
            if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
              (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
                MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) K) *
                MvPolynomial.X ⟨2 * j + 1, h⟩
            else 0) = 0 := by
          rw [map_sum]
          apply Finset.sum_eq_zero
          intro j _
          split_ifs with hj
          · dsimp only [ev₀, v₀]
            rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
            have hne1 : (⟨2 * j, Nat.lt_of_succ_lt hj⟩ : Fin (2 * (m + 1) + 2)) ≠ 1 := by
              intro heq
              have hv := congrArg Fin.val heq
              change 2 * j = 1 at hv
              omega
            rw [ite_eq_right_iff.mpr (fun h => False.elim (hne1 h)), zero_mul]
          · exact map_zero _
        rw [hε₁_mk, hev_F, map_zero, map_zero]
      · have hbot := hp₀_P_pre_ne1 μ hμ1
        have hsub : Subsingleton
            ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj
              (Opposite.op ((TopologicalSpace.Opens.map p₀_P.base).obj (D_succ μ)))) := by
          rw [hbot]
          infer_instance
        exact hsub.elim _ _

    let p₀_Q : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ Q_succ.left :=
      AlgebraicGeometry.IsClosedImmersion.lift ι_succ' p₀_P hker_p₀_succ
    have hp₀_Q_fac : p₀_Q ≫ ι_succ' = p₀_P :=
      AlgebraicGeometry.IsClosedImmersion.lift_fac ι_succ' p₀_P hker_p₀_succ
    haveI hQC_p₀Q : AlgebraicGeometry.QuasiCompact p₀_Q := by
      haveI : AlgebraicGeometry.QuasiCompact (p₀_Q ≫ ι_succ') := by
        rw [hp₀_Q_fac]
        exact hQC_p₀P
      exact AlgebraicGeometry.QuasiCompact.of_comp p₀_Q ι_succ'

    have hker_p₀_Z : i_Z.left.ker ≤ p₀_Q.ker := by
      apply AlgebraicGeometry.Scheme.IdealSheafData.le_of_iSup_eq_top Q_aff hQ_aff_cov
      intro μ
      rw [AlgebraicGeometry.Scheme.Hom.ker_apply, AlgebraicGeometry.Scheme.Hom.ker_apply]
      rw [hKer_Z μ (hX_succ μ) (Q_aff μ).1 (Q_aff μ).2 (le_refl _),
        Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      by_cases hμ1 : μ = 1
      · subst hμ1
        let s₀ := (AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom
          (HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) 1 (MvPolynomial.X 0) hX0_mem)
        change (p₀_Q.app (Q_aff 1).1).hom ((ι_succ'.appLE (D_succ 1) (Q_aff 1).1 (le_refl _)).hom s₀) = 0
        have happ_comp : ι_succ'.appLE (D_succ 1) (Q_aff 1).1 (le_refl _) ≫ p₀_Q.app (Q_aff 1).1 =
            (p₀_Q ≫ ι_succ').appLE (D_succ 1)
              ((TopologicalSpace.Opens.map p₀_Q.base).obj (Q_aff 1).1) (le_refl _) := by
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
            AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
        have hval : (p₀_Q.app (Q_aff 1).1).hom ((ι_succ'.appLE (D_succ 1) (Q_aff 1).1 (le_refl _)).hom s₀) =
            ((p₀_Q ≫ ι_succ').appLE (D_succ 1)
              ((TopologicalSpace.Opens.map p₀_Q.base).obj (Q_aff 1).1) (le_refl _)).hom s₀ :=
          congrArg (fun φ => φ.hom s₀) happ_comp
        rw [hval]
        have htop_res : (p₀_Q ≫ ι_succ').appLE (D_succ 1)
            ((TopologicalSpace.Opens.map p₀_Q.base).obj (Q_aff 1).1) (le_refl _) =
            (p₀_Q ≫ ι_succ').appLE (D_succ 1) ⊤ (by rw [hp₀_Q_fac]; exact hp₀_P_D1) ≫
              (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.map
                (CategoryTheory.homOfLE le_top).op := by
          rw [AlgebraicGeometry.Scheme.Hom.appLE_map]
        have htop_s₀ : ((p₀_Q ≫ ι_succ').appLE (D_succ 1)
            ((TopologicalSpace.Opens.map p₀_Q.base).obj (Q_aff 1).1) (le_refl _)).hom s₀ =
            ((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.map (CategoryTheory.homOfLE le_top).op).hom
              (((p₀_Q ≫ ι_succ').appLE (D_succ 1) ⊤ (by rw [hp₀_Q_fac]; exact hp₀_P_D1)).hom s₀) :=
          congrArg (fun φ => φ.hom s₀) htop_res
        rw [htop_s₀, hp₀_P_eval (p₀_Q ≫ ι_succ') hp₀_Q_fac, hε₁_mk]
        have hev_X0 : ev₀ (MvPolynomial.X 0) = 0 := by
          dsimp only [ev₀, v₀]
          rw [MvPolynomial.eval₂Hom_X']
          have h01 : (0 : Fin (2 * (m + 1) + 2)) ≠ 1 := by
            intro h
            have hv := congrArg Fin.val h
            change 0 = 1 at hv
            omega
          rw [ite_eq_right_iff.mpr (fun h => False.elim (h01 h))]
        rw [hev_X0, map_zero, map_zero]
      · have hpre_bot : (TopologicalSpace.Opens.map p₀_Q.base).obj (Q_aff μ).1 = ⊥ := by
          change (TopologicalSpace.Opens.map (p₀_Q ≫ ι_succ').base).obj (D_succ μ) = ⊥
          rw [hp₀_Q_fac]
          exact hp₀_P_pre_ne1 μ hμ1
        have hsub : Subsingleton
            ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj
              (Opposite.op ((TopologicalSpace.Opens.map p₀_Q.base).obj (Q_aff μ).1))) := by
          rw [hpre_bot]
          infer_instance
        exact hsub.elim _ _

    let p₀ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ Z_cone.left :=
      AlgebraicGeometry.IsClosedImmersion.lift i_Z.left p₀_Q hker_p₀_Z
    have hp₀_fac : p₀ ≫ i_Z.left = p₀_Q :=
      AlgebraicGeometry.IsClosedImmersion.lift_fac i_Z.left p₀_Q hker_p₀_Z
    have hp₀_comp : p₀ ≫ i_Z.left ≫ ι_succ' = p₀_P := by
      rw [← CategoryTheory.Category.assoc, hp₀_fac, hp₀_Q_fac]
    have hp₀_hom : p₀ ≫ Z_cone.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) := by
      rw [← i_Z.w, ← CategoryTheory.Category.assoc, hp₀_fac, ← hι_succ]
      change (p₀_Q ≫ ι_succ') ≫ P_succ.hom = _
      rw [hp₀_Q_fac, hp₀_P_hom]
    have hp₀_D1 : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of K)).Opens) ≤
        (TopologicalSpace.Opens.map (p₀ ≫ i_Z.left ≫ ι_succ).base).obj
          (weilProjBasicOpen K (2 * (m + 1) + 1) 1) := by
      change ⊤ ≤ (TopologicalSpace.Opens.map (p₀ ≫ i_Z.left ≫ ι_succ').base).obj (D_succ 1)
      rw [hp₀_comp]
      exact hp₀_P_D1

    have hp₀_coord : ∀ a : Fin (2 * m + 2),
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K) :=
          MvPolynomial.gradedAlgebra
         ((p₀ ≫ i_Z.left ≫ ι_succ).appLE
           (weilProjBasicOpen K (2 * (m + 1) + 1) 1) ⊤ hp₀_D1).hom
           ((AlgebraicGeometry.Proj.awayToSection
             (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K)
             (MvPolynomial.X 1)).hom
             (HomogeneousLocalization.Away.mk
               (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K)
               (MvPolynomial.isHomogeneous_X K 1) 1
               (MvPolynomial.X a.succ.succ)
               (MvPolynomial.isHomogeneous_X K a.succ.succ)))) = 0 := by
      intro a
      let z_a : A₁ := HomogeneousLocalization.Away.mk 𝒜_succ
        (hX_succ 1) 1 (MvPolynomial.X a.succ.succ)
        (by rw [one_smul]; exact hX_succ a.succ.succ)
      change ((p₀ ≫ i_Z.left ≫ ι_succ').appLE (D_succ 1) ⊤ hp₀_D1).hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom z_a) = 0
      rw [hp₀_P_eval (p₀ ≫ i_Z.left ≫ ι_succ') hp₀_comp hp₀_D1 z_a]
      have hz_zero : ε₁ z_a = 0 := by
        dsimp only [z_a]
        rw [hε₁_mk]
        dsimp only [ev₀, v₀]
        rw [MvPolynomial.eval₂Hom_X']
        have hne : a.succ.succ ≠ 1 := by
          intro h
          have hv := congrArg Fin.val h
          change a.val + 2 = 1 at hv
          omega
        rw [ite_eq_right_iff.mpr (fun h => False.elim (hne h))]
      rw [hz_zero, map_zero]

    
    have hUZ_compl : (U_Z : Set Z_cone.left) = (Set.range p₀.base)ᶜ := by
      ext z
      rw [Set.mem_compl_iff]
      constructor
      · intro hz_UZ ⟨pt, hpt⟩
        rw [← hpt] at hz_UZ
        change p₀.base pt ∈ U_Z at hz_UZ
        rw [TopologicalSpace.Opens.mem_iSup] at hz_UZ
        obtain ⟨c, hc⟩ := hz_UZ
        have hpt_pre : pt ∈ (TopologicalSpace.Opens.map p₀_P.base).obj (D_succ c.succ.succ) := by
          rw [← hp₀_comp]
          exact hc
        have hc_ne1 : c.succ.succ ≠ 1 := by
          intro h
          have hv := congrArg Fin.val h
          change c.val + 2 = 1 at hv
          omega
        rw [hp₀_P_pre_ne1 c.succ.succ hc_ne1] at hpt_pre
        exact hpt_pre
      · intro hz_not_range
        by_contra hz_not_UZ
        have hz_top : z ∈ Z_chart 1 ⊔ U_Z := by
          rw [hZ1_UZ_top]
          trivial
        have hz1 : z ∈ Z_chart 1 := by
          rcases hz_top with h1 | h2
          · exact h1
          · exact False.elim (hz_not_UZ h2)
        let f_Z : Z_cone.left ⟶ P_succ_sch := i_Z.left ≫ ι_succ'
        haveI : AlgebraicGeometry.IsClosedImmersion f_Z := inferInstance
        have hAff_Z1 : AlgebraicGeometry.IsAffineOpen (Z_chart 1) :=
          (D_succ_aff 1).2.preimage f_Z
        let B₁ : Type u := ↑(Z_cone.left.presheaf.obj (Opposite.op (Z_chart 1)))
        let π₁ : A₁ →+* B₁ :=
          (AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1) ≫
            f_Z.app (D_succ 1)).hom
        have hπ₁_surj : Function.Surjective π₁ := by
          have hsurj_fZ : Function.Surjective (f_Z.app (D_succ 1)).hom :=
            AlgebraicGeometry.Scheme.Hom.app_surjective f_Z (D_succ 1) (D_succ_aff 1).2
          have hsurj_away : Function.Surjective
              (AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom := by
            rw [← AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜_succ (MvPolynomial.X 1)
              (hX_succ 1) zero_lt_one]
            exact fun y => ⟨(AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_succ (MvPolynomial.X 1)
              (hX_succ 1) zero_lt_one).inv.hom y,
              congrArg (fun φ => φ.hom y)
                (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_succ (MvPolynomial.X 1)
                  (hX_succ 1) zero_lt_one).inv_hom_id⟩
          exact hsurj_fZ.comp hsurj_away

        obtain ⟨q_z, hq_z⟩ : z ∈ Set.range hAff_Z1.fromSpec.base := by
          rwa [hAff_Z1.range_fromSpec]
        haveI : q_z.asIdeal.IsPrime := q_z.isPrime
        let 𝔭_z : Ideal A₁ := Ideal.comap π₁ q_z.asIdeal
        haveI : 𝔭_z.IsPrime := Ideal.IsPrime.comap π₁
        have h𝔭_ne_top : 𝔭_z ≠ ⊤ := Ideal.IsPrime.ne_top inferInstance

        have hX0_in_𝔭 : HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) 1
            (MvPolynomial.X 0) (by rw [one_smul]; exact hX_succ 0) ∈ 𝔭_z := by
          rw [Ideal.mem_comap]
          let t₀ : A₁ := HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) 1
            (MvPolynomial.X 0) (by rw [one_smul]; exact hX_succ 0)
          have hπ_zero : π₁ t₀ = 0 := by
            have hfZ_app : f_Z.app (D_succ 1) =
                ι_succ'.appLE (D_succ 1) (Q_aff 1).1 (le_refl _) ≫ i_Z.left.app (Q_aff 1).1 := by
              change (i_Z.left ≫ ι_succ').app (D_succ 1) = _
              rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
                AlgebraicGeometry.Scheme.Hom.app_eq_appLE i_Z.left,
                AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
              rfl
            have hval : π₁ t₀ =
                (i_Z.left.app (Q_aff 1).1).hom
                  ((ι_succ'.appLE (D_succ 1) (Q_aff 1).1 (le_refl _)).hom
                    ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom t₀)) :=
              congrArg (fun φ => φ.hom ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom t₀))
                hfZ_app
            have hzero_iZ : (i_Z.left.app (Q_aff 1).1).hom
                ((ι_succ'.appLE (D_succ 1) (Q_aff 1).1 (le_refl _)).hom
                  ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom t₀)) = 0 := by
              rw [← RingHom.mem_ker, hKer_Z 1 (hX_succ 1) (Q_aff 1).1 (Q_aff 1).2 (le_refl _)]
              exact Ideal.subset_span rfl
            exact hval.trans hzero_iZ
          rw [hπ_zero]
          exact q_z.asIdeal.zero_mem

        have hXc_in_𝔭 : ∀ c : Fin (2 * m + 2),
            HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) 1
              (MvPolynomial.X c.succ.succ) (by rw [one_smul]; exact hX_succ c.succ.succ) ∈ 𝔭_z := by
          intro c
          let t_c : A₁ := HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) 1
            (MvPolynomial.X c.succ.succ) (by rw [one_smul]; exact hX_succ c.succ.succ)
          change π₁ t_c ∈ q_z.asIdeal
          by_contra hnot_mem
          have hqz_bo : q_z ∈ PrimeSpectrum.basicOpen (π₁ t_c) := hnot_mem
          rw [← hAff_Z1.fromSpec_preimage_basicOpen (π₁ t_c)] at hqz_bo
          change hAff_Z1.fromSpec.base q_z ∈ Z_cone.left.basicOpen (π₁ t_c) at hqz_bo
          rw [hq_z] at hqz_bo
          have hπ_appLE : π₁ t_c = (f_Z.appLE (D_succ 1) (Z_chart 1) (le_refl _)).hom
              ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom t_c) := by
            dsimp only [π₁]
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
            rfl
          have hbo_eq : Z_cone.left.basicOpen (π₁ t_c) =
              Z_chart 1 ⊓ (TopologicalSpace.Opens.map f_Z.base).obj
                (P_succ_sch.basicOpen
                  ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom t_c)) := by
            rw [hπ_appLE]
            exact AlgebraicGeometry.Scheme.basicOpen_appLE f_Z (Z_chart 1) (D_succ 1) (le_refl _) _
          rw [hbo_eq] at hqz_bo
          have hfz_D1 : f_Z.base z ∈ D_succ 1 := hz1
          have hrange_D1 : Set.range
              (AlgebraicGeometry.Proj.awayι 𝒜_succ (MvPolynomial.X 1) (hX_succ 1) zero_lt_one).base =
              (D_succ 1 : Set P_succ_sch) :=
            congrArg (fun O : P_succ_sch.Opens => (O : Set P_succ_sch))
              (AlgebraicGeometry.Proj.opensRange_awayι 𝒜_succ (MvPolynomial.X 1) (hX_succ 1) zero_lt_one)
          obtain ⟨p_a, hp_a⟩ : f_Z.base z ∈ Set.range
              (AlgebraicGeometry.Proj.awayι 𝒜_succ (MvPolynomial.X 1) (hX_succ 1) zero_lt_one).base := by
            rwa [hrange_D1]
          have hpa_bo_proj : (AlgebraicGeometry.Proj.awayι 𝒜_succ (MvPolynomial.X 1)
              (hX_succ 1) zero_lt_one).base p_a ∈ P_succ_sch.basicOpen
              ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom t_c) := by
            rw [hp_a]
            exact hqz_bo.2
          have hpa_bo : p_a ∈ PrimeSpectrum.basicOpen t_c :=
            (hAwayPre N_succ 1 t_c p_a).mp hpa_bo_proj
          have htc_eq : HomogeneousLocalization.Away.isLocalizationElem
              (hX_succ 1) (hX_succ c.succ.succ) = t_c := by
            apply HomogeneousLocalization.val_injective
            dsimp only [HomogeneousLocalization.Away.isLocalizationElem, t_c]
            rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk]
            simp only [Localization.mk_eq_mk', IsLocalization.eq]
            refine ⟨1, ?_⟩
            simp only [Submonoid.coe_one, mul_one, pow_one, one_smul]
          rw [← htc_eq] at hpa_bo
          have hpre_c := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_succ
            (hX_succ 1) zero_lt_one (hX_succ c.succ.succ) zero_lt_one
          have hpa_Dc : (AlgebraicGeometry.Proj.awayι 𝒜_succ (MvPolynomial.X 1)
              (hX_succ 1) zero_lt_one).base p_a ∈ D_succ c.succ.succ := by
            change p_a ∈ (TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_succ (MvPolynomial.X 1) (hX_succ 1) zero_lt_one).base).obj
              (D_succ c.succ.succ)
            rwa [hpre_c]
          rw [hp_a] at hpa_Dc
          exact hz_not_UZ (TopologicalSpace.Opens.mem_iSup.mpr ⟨c, hpa_Dc⟩)

        have hXμ_in_𝔭 : ∀ μ : Fin (2 * (m + 1) + 2), μ ≠ 1 →
            HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) 1
              (MvPolynomial.X μ) (by rw [one_smul]; exact hX_succ μ) ∈ 𝔭_z := by
          intro μ hμ1
          refine Fin.cases
            (motive := fun ν : Fin ((2 * m + 2) + 2) => ν ≠ 1 →
              HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) 1
                (MvPolynomial.X ν) (by rw [one_smul]; exact hX_succ ν) ∈ 𝔭_z)
            (fun _ => hX0_in_𝔭)
            (fun ν => Fin.cases
              (motive := fun κ : Fin ((2 * m + 2) + 1) => κ.succ ≠ 1 →
                HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) 1
                  (MvPolynomial.X κ.succ) (by rw [one_smul]; exact hX_succ κ.succ) ∈ 𝔭_z)
              (fun h11 => False.elim (h11 rfl))
              (fun c _ => hXc_in_𝔭 c)
              ν)
            μ hμ1

        have hker_le_𝔭 : RingHom.ker ε₁ ≤ 𝔭_z := by
          intro y hy
          rw [RingHom.mem_ker] at hy
          obtain ⟨⟨d, ⟨G, hG_d⟩, ⟨den_P, hden_d⟩, hden_mem⟩, rfl⟩ :=
            HomogeneousLocalization.mk_surjective y
          have hden_ex : ∃ k : ℕ, (MvPolynomial.X 1) ^ k = den_P := hden_mem
          obtain ⟨k, hk_pow⟩ := hden_ex
          have hk_eq_d : k = d := by
            have hcoeff : ((MvPolynomial.X 1 : MvPolynomial (Fin (2 * (m + 1) + 2)) K) ^ k).coeff
                (Finsupp.single 1 k) = 1 := by
              rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.coeff_monomial,
                ite_eq_left_iff.mpr (fun h => False.elim (h rfl))]
            have hne : ((MvPolynomial.X 1 : MvPolynomial (Fin (2 * (m + 1) + 2)) K) ^ k).coeff
                (Finsupp.single 1 k) ≠ 0 := by
              rw [hcoeff]
              exact one_ne_zero
            rw [hk_pow] at hne
            have hdeg := hden_d hne
            rw [Finsupp.weight_apply, Finsupp.sum_single_index (zero_mul _)] at hdeg
            simpa only [Pi.one_apply, smul_eq_mul, mul_one] using hdeg
          subst hk_eq_d
          have hy_mk : HomogeneousLocalization.mk ⟨k, ⟨G, hG_d⟩, ⟨den_P, hden_d⟩, hden_mem⟩ =
              HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) k G (by rw [nsmul_one]; exact hG_d) := by
            apply HomogeneousLocalization.val_injective
            rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.Away.val_mk]
            simp only [Localization.mk_eq_mk']
            congr 1
            exact Subtype.ext hk_pow.symm
          rw [hy_mk] at hy ⊢
          rw [hε₁_mk] at hy
          have hev_mon : ∀ (e : Fin (2 * (m + 1) + 2) →₀ ℕ) (c : K),
              (∑ μ, e μ) = k →
              ev₀ (MvPolynomial.monomial e c) = if e = Finsupp.single 1 k then c else 0 := by
            intro e c hsum_e
            dsimp only [ev₀]
            rw [MvPolynomial.eval₂Hom_monomial, RingHom.id_apply]
            by_cases he_single : e = Finsupp.single 1 k
            · rw [if_pos he_single, he_single]
              have hp_single : ((Finsupp.single 1 k).prod fun i n => v₀ i ^ n) = v₀ 1 ^ k :=
                Finsupp.prod_single_index (pow_zero _)
              rw [hp_single]
              dsimp only [v₀]
              rw [if_pos rfl, one_pow, mul_one]
            · rw [if_neg he_single]
              have hex_ne1 : ∃ μ : Fin (2 * (m + 1) + 2), μ ≠ 1 ∧ e μ ≠ 0 := by
                by_contra hall_zero
                apply he_single
                ext μ
                by_cases hμ1 : μ = 1
                · subst hμ1
                  have hz_other : ∀ b ∈ Finset.univ, b ≠ (1 : Fin (2 * (m + 1) + 2)) → e b = 0 :=
                    fun b _ hb => Classical.byContradiction fun hne0 => hall_zero ⟨b, hb, hne0⟩
                  rw [Finsupp.single_eq_same, ← hsum_e,
                    Finset.sum_eq_single 1 hz_other
                      (fun hnot => False.elim (hnot (Finset.mem_univ 1)))]
                · rw [Finsupp.single_eq_of_ne hμ1]
                  exact Classical.byContradiction fun hne0 => hall_zero ⟨μ, hμ1, hne0⟩
              obtain ⟨μ₀, hμ₀_ne1, he_μ₀⟩ := hex_ne1
              have hprod_zero : (e.prod fun μ n => v₀ μ ^ n) = 0 := by
                rw [Finsupp.prod]
                apply Finset.prod_eq_zero (Finsupp.mem_support_iff.mpr he_μ₀)
                dsimp only [v₀]
                rw [if_neg hμ₀_ne1, zero_pow he_μ₀]
              rw [hprod_zero, mul_zero]
          have hdeg_supp : ∀ e ∈ G.support, (∑ μ, e μ) = k := by
            intro e he
            have hdeg := hG_d (MvPolynomial.mem_support_iff.mp he)
            rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => zero_mul _)] at hdeg
            simpa only [Pi.one_apply, smul_eq_mul, mul_one] using hdeg
          have hsingle_not_supp : Finsupp.single 1 k ∉ G.support := by
            intro hmem_s
            have hG_sum := G.as_sum
            have hev_G : ev₀ G = ∑ e ∈ G.support, ev₀ (MvPolynomial.monomial e (G.coeff e)) := by
              conv_lhs => rw [hG_sum]
              rw [map_sum]
            have hsum_ite : (∑ e ∈ G.support, ev₀ (MvPolynomial.monomial e (G.coeff e))) =
                ∑ e ∈ G.support, if e = Finsupp.single 1 k then G.coeff e else 0 :=
              Finset.sum_congr rfl fun e he => hev_mon e (G.coeff e) (hdeg_supp e he)
            rw [hev_G, hsum_ite, Finset.sum_ite_eq' G.support (Finsupp.single 1 k),
              if_pos hmem_s] at hy
            exact (MvPolynomial.mem_support_iff.mp hmem_s) hy
          have hmon_hom : ∀ e ∈ G.support,
              MvPolynomial.monomial e (G.coeff e) ∈ 𝒜_succ (k • 1) :=
            fun e he => hMonHom e (G.coeff e) k (hdeg_supp e he)
          have hmk_sum : HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) k G
              (by rw [nsmul_one]; exact hG_d) =
              ∑ e ∈ G.support.attach,
                HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) k
                  (MvPolynomial.monomial e.1 (G.coeff e.1)) (hmon_hom e.1 e.2) := by
            apply HomogeneousLocalization.val_injective
            simp only [← HomogeneousLocalization.algebraMap_apply, map_sum]
            simp only [HomogeneousLocalization.algebraMap_apply,
              HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
            have hpow_k_mem : (MvPolynomial.X 1 : MvPolynomial (Fin (2 * (m + 1) + 2)) K) ^ k ∈
                Submonoid.powers (MvPolynomial.X 1) := ⟨k, rfl⟩
            have hsum_mk' : ∀ (S : Finset {e // e ∈ G.support}),
                (∑ e ∈ S, IsLocalization.mk'
                  (Localization.Away (MvPolynomial.X 1 : MvPolynomial (Fin (2 * (m + 1) + 2)) K))
                  (MvPolynomial.monomial e.1 (G.coeff e.1)) ⟨(MvPolynomial.X 1) ^ k, hpow_k_mem⟩) =
                IsLocalization.mk' _ (∑ e ∈ S, MvPolynomial.monomial e.1 (G.coeff e.1))
                  ⟨(MvPolynomial.X 1) ^ k, hpow_k_mem⟩ := by
              intro S
              induction S using Finset.induction_on with
              | empty => simp [IsLocalization.mk'_zero]
              | @insert a s has ih =>
                rw [Finset.sum_insert has, Finset.sum_insert has, ih, ← IsLocalization.mk'_add]
                simp only [IsLocalization.eq]
                refine ⟨1, ?_⟩
                simp only [Submonoid.coe_one, Submonoid.coe_mul, mul_one, one_mul]
                ring
            rw [hsum_mk', Finset.sum_attach G.support (fun e => MvPolynomial.monomial e (G.coeff e)),
              ← G.as_sum]
          rw [hmk_sum]
          apply Submodule.sum_mem
          rintro ⟨e, he⟩ _
          have he_ne_single : e ≠ Finsupp.single 1 k := fun h => hsingle_not_supp (h ▸ he)
          have hex_μ₀ : ∃ μ₀ : Fin (2 * (m + 1) + 2), μ₀ ≠ 1 ∧ e μ₀ ≠ 0 := by
            by_contra hall_zero
            apply he_ne_single
            ext μ
            by_cases hμ1 : μ = 1
            · subst hμ1
              have hz_other : ∀ b ∈ Finset.univ, b ≠ (1 : Fin (2 * (m + 1) + 2)) → e b = 0 :=
                fun b _ hb => Classical.byContradiction fun hne0 => hall_zero ⟨b, hb, hne0⟩
              rw [Finsupp.single_eq_same, ← hdeg_supp e he,
                Finset.sum_eq_single 1 hz_other
                  (fun hnot => False.elim (hnot (Finset.mem_univ 1)))]
            · rw [Finsupp.single_eq_of_ne hμ1]
              exact Classical.byContradiction fun hne0 => hall_zero ⟨μ, hμ1, hne0⟩
          obtain ⟨μ₀, hμ₀_ne1, he_μ₀⟩ := hex_μ₀
          have hk_ge1 : 1 ≤ k := by
            have hle_sum : e μ₀ ≤ ∑ μ, e μ :=
              Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ μ₀)
            rw [hdeg_supp e he] at hle_sum
            omega
          let e' : Fin (2 * (m + 1) + 2) →₀ ℕ := e - Finsupp.single μ₀ 1
          have he_add : Finsupp.single μ₀ 1 + e' = e := by
            ext μ
            dsimp only [e']
            rw [Finsupp.add_apply, Finsupp.tsub_apply]
            by_cases hμμ₀ : μ = μ₀
            · subst hμμ₀
              rw [Finsupp.single_eq_same]
              omega
            · rw [Finsupp.single_eq_of_ne hμμ₀]
              omega
          have he'_sum : (∑ μ, e' μ) = k - 1 := by
            have hsum_add : (∑ μ, ((Finsupp.single μ₀ (1 : ℕ) + e') : Fin (2 * (m + 1) + 2) →₀ ℕ) μ) = k := by
              rw [he_add]
              exact hdeg_supp e he
            simp only [Finsupp.add_apply, Finset.sum_add_distrib] at hsum_add
            have hsum_single : (∑ x : Fin (2 * (m + 1) + 2), (Finsupp.single μ₀ (1 : ℕ)) x) = 1 := by
              rw [Finset.sum_eq_single μ₀
                (fun b _ hb => Finsupp.single_eq_of_ne hb)
                (fun hnot => False.elim (hnot (Finset.mem_univ μ₀))),
                Finsupp.single_eq_same]
            omega
          have he'_deg : MvPolynomial.monomial e' (G.coeff e) ∈ 𝒜_succ ((k - 1) • 1) :=
            hMonHom e' (G.coeff e) (k - 1) he'_sum
          have hmon_fac : HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) k
              (MvPolynomial.monomial e (G.coeff e)) (hmon_hom e he) =
              HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) 1 (MvPolynomial.X μ₀)
                (by rw [one_smul]; exact hX_succ μ₀) *
              HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ 1) (k - 1)
                (MvPolynomial.monomial e' (G.coeff e)) he'_deg := by
            apply HomogeneousLocalization.val_injective
            simp only [← HomogeneousLocalization.algebraMap_apply, map_mul]
            simp only [HomogeneousLocalization.algebraMap_apply]
            rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
              HomogeneousLocalization.Away.val_mk]
            simp only [Localization.mk_eq_mk', ← IsLocalization.mk'_mul, IsLocalization.eq]
            refine ⟨1, ?_⟩
            simp only [Submonoid.coe_one, Submonoid.coe_mul, mul_one, one_mul]
            have hX_mon : MvPolynomial.X μ₀ * MvPolynomial.monomial e' (G.coeff e) =
                MvPolynomial.monomial e (G.coeff e) := by
              rw [MvPolynomial.X, MvPolynomial.monomial_mul, one_mul, he_add]
            have hpow_k : (MvPolynomial.X 1 : MvPolynomial (Fin (2 * (m + 1) + 2)) K) ^ 1 *
                (MvPolynomial.X 1) ^ (k - 1) = (MvPolynomial.X 1) ^ k := by
              rw [← pow_add, show 1 + (k - 1) = k by omega]
            rw [hX_mon, hpow_k]
          rw [hmon_fac]
          exact Ideal.mul_mem_right _ _ (hXμ_in_𝔭 μ₀ hμ₀_ne1)

        have hker_max : (RingHom.ker ε₁).IsMaximal :=
          RingHom.ker_isMaximal_of_surjective ε₁ hε₁_surj
        have hker_eq_𝔭 : RingHom.ker ε₁ = 𝔭_z :=
          hker_max.eq_of_le h𝔭_ne_top hker_le_𝔭

        let pt₀ : AlgebraicGeometry.Spec (CommRingCat.of K) :=
          ⟨RingHom.ker (RingHom.id K), RingHom.ker_isPrime _⟩
        let z₀ : Z_cone.left := p₀.base pt₀
        have hz₀_1 : z₀ ∈ Z_chart 1 := hp₀_D1 (trivial : pt₀ ∈ ⊤)
        obtain ⟨q₀, hq₀⟩ : z₀ ∈ Set.range hAff_Z1.fromSpec.base := by
          rwa [hAff_Z1.range_fromSpec]
        have hcomap_q₀ : Ideal.comap π₁ q₀.asIdeal = RingHom.ker ε₁ := by
          ext y
          rw [← not_iff_not, Ideal.mem_comap, RingHom.mem_ker]
          have hlhs : π₁ y ∉ q₀.asIdeal ↔ z₀ ∈ Z_cone.left.basicOpen (π₁ y) := by
            change q₀ ∈ PrimeSpectrum.basicOpen (π₁ y) ↔ _
            rw [← hAff_Z1.fromSpec_preimage_basicOpen (π₁ y)]
            change hAff_Z1.fromSpec.base q₀ ∈ Z_cone.left.basicOpen (π₁ y) ↔ _
            rw [hq₀]
          have hπ_appLE : π₁ y = (f_Z.appLE (D_succ 1) (Z_chart 1) (le_refl _)).hom
              ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom y) := by
            dsimp only [π₁]
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
            rfl
          have hbo_y : Z_cone.left.basicOpen (π₁ y) =
              Z_chart 1 ⊓ (TopologicalSpace.Opens.map f_Z.base).obj
                (P_succ_sch.basicOpen
                  ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom y)) := by
            rw [hπ_appLE]
            exact AlgebraicGeometry.Scheme.basicOpen_appLE f_Z (Z_chart 1) (D_succ 1) (le_refl _) _
          have hfz₀ : f_Z.base z₀ = p₀_P.base pt₀ := by
            change (p₀ ≫ i_Z.left ≫ ι_succ').base pt₀ = p₀_P.base pt₀
            rw [hp₀_comp]
          have hmid_z₀ : z₀ ∈ Z_cone.left.basicOpen (π₁ y) ↔
              (AlgebraicGeometry.Proj.awayι 𝒜_succ (MvPolynomial.X 1) (hX_succ 1) zero_lt_one).base
                ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε₁)).base pt₀) ∈
              P_succ_sch.basicOpen
                ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom y) := by
            rw [hbo_y]
            refine ⟨fun h => ?_, fun h => ⟨hz₀_1, ?_⟩⟩
            · have h2 : f_Z.base z₀ ∈ P_succ_sch.basicOpen
                  ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom y) := h.2
              rwa [hfz₀] at h2
            · show f_Z.base z₀ ∈ P_succ_sch.basicOpen
                  ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X 1)).hom y)
              rwa [hfz₀]
          exact hlhs.trans (hmid_z₀.trans
            ((hAwayPre N_succ 1 y
              ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε₁)).base pt₀)).trans
              (PrimeSpectrum.mem_basicOpen y
                ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε₁)).base pt₀))))

        have hq₀_eq_qz : q₀ = q_z := by
          apply PrimeSpectrum.ext
          exact Ideal.comap_injective_of_surjective π₁ hπ₁_surj (hcomap_q₀.trans hker_eq_𝔭)
        apply hz_not_range
        refine ⟨pt₀, ?_⟩
        change z₀ = z
        rw [← hq₀, ← hq_z, hq₀_eq_qz]

    
    let v_pad : Fin (2 * (m + 1) + 2) → MvPolynomial (Fin (2 * m + 2)) K :=
      Fin.cases 0 (Fin.cases 0 (fun a : Fin (2 * m + 2) => MvPolynomial.X a))
    have hv_pad_0 : v_pad 0 = 0 := rfl
    have hv_pad_1 : v_pad 1 = 0 := rfl
    have hv_pad_succ2 : ∀ a : Fin (2 * m + 2), v_pad a.succ.succ = MvPolynomial.X a :=
      fun _ => rfl

    let ψ_ring : MvPolynomial (Fin (2 * (m + 1) + 2)) K →+* MvPolynomial (Fin (2 * m + 2)) K :=
      MvPolynomial.eval₂Hom MvPolynomial.C v_pad
    have hψ_mem : ∀ (i : ℕ) (p : MvPolynomial (Fin (2 * (m + 1) + 2)) K),
        p ∈ 𝒜_succ i → ψ_ring p ∈ 𝒜_m i := by
      intro i p hp
      change (MvPolynomial.eval₂ MvPolynomial.C v_pad p).IsHomogeneous i
      rw [← one_mul i]
      refine MvPolynomial.IsHomogeneous.eval₂ hp MvPolynomial.C v_pad
        (fun c => MvPolynomial.isHomogeneous_C _ c) (fun μ => ?_)
      refine Fin.cases
        (motive := fun ν : Fin ((2 * m + 2) + 2) => (v_pad ν).IsHomogeneous 1)
        (by rw [hv_pad_0]; exact MvPolynomial.isHomogeneous_zero _ _ _)
        (fun ν => Fin.cases
          (motive := fun κ : Fin ((2 * m + 2) + 1) => (v_pad κ.succ).IsHomogeneous 1)
          (by change (v_pad 1).IsHomogeneous 1; rw [hv_pad_1]; exact MvPolynomial.isHomogeneous_zero _ _ _)
          (fun a => by rw [hv_pad_succ2]; exact MvPolynomial.isHomogeneous_X K a)
          ν)
        μ

    let ψ_pad : 𝒜_succ →+*ᵍ 𝒜_m := { toRingHom := ψ_ring, map_mem := @hψ_mem }

    have h_irrel : HomogeneousIdeal.irrelevant 𝒜_m ≤
        HomogeneousIdeal.map ψ_pad (HomogeneousIdeal.irrelevant 𝒜_succ) := by
      rw [HomogeneousIdeal.irrelevant_le]
      intro i hi q hq
      let rq : MvPolynomial (Fin (2 * (m + 1) + 2)) K :=
        MvPolynomial.rename (fun a : Fin (2 * m + 2) => a.succ.succ) q
      have hρ_hom : rq.IsHomogeneous i :=
        MvPolynomial.IsHomogeneous.rename_isHomogeneous hq
      have hρ_irrel : rq ∈ (HomogeneousIdeal.irrelevant 𝒜_succ).toIdeal := by
        have hle := (HomogeneousIdeal.irrelevant_le 𝒜_succ).mp (le_refl _) i hi
        exact hle hρ_hom
      have hψ_ρ : ψ_pad rq = q := by
        change (MvPolynomial.eval₂Hom MvPolynomial.C v_pad)
          ((MvPolynomial.rename (fun a : Fin (2 * m + 2) => a.succ.succ)) q) = q
        rw [MvPolynomial.eval₂Hom_rename]
        have hcomp_v : v_pad ∘ (fun a : Fin (2 * m + 2) => a.succ.succ) = MvPolynomial.X :=
          funext hv_pad_succ2
        rw [hcomp_v]
        have heval_id : ∀ (p : MvPolynomial (Fin (2 * m + 2)) K),
            (MvPolynomial.eval₂Hom MvPolynomial.C MvPolynomial.X) p = p := by
          intro p
          induction p using MvPolynomial.induction_on with
          | C a => exact MvPolynomial.eval₂Hom_C _ _ a
          | add p₁ p₂ ih₁ ih₂ => rw [map_add, ih₁, ih₂]
          | mul_X p₁ a ih => rw [map_mul, ih, MvPolynomial.eval₂Hom_X']
        exact heval_id q
      change q ∈ Ideal.map ψ_pad.toRingHom (HomogeneousIdeal.irrelevant 𝒜_succ).toIdeal
      rw [← hψ_ρ]
      exact Ideal.mem_map_of_mem ψ_pad.toRingHom hρ_irrel

    let L_pad : P_m_sch ⟶ P_succ_sch := AlgebraicGeometry.Proj.map ψ_pad h_irrel

    have hL_pre0 : (TopologicalSpace.Opens.map L_pad.base).obj (D_succ 0) = ⊥ := by
      dsimp only [L_pad, D_succ]
      rw [AlgebraicGeometry.Proj.map_preimage_basicOpen ψ_pad h_irrel]
      have h0 : ψ_pad (MvPolynomial.X 0) = 0 := by
        change ψ_ring (MvPolynomial.X 0) = 0
        dsimp only [ψ_ring]
        rw [MvPolynomial.eval₂Hom_X', hv_pad_0]
      rw [h0, AlgebraicGeometry.Proj.basicOpen_zero]

    have hL_pre1 : (TopologicalSpace.Opens.map L_pad.base).obj (D_succ 1) = ⊥ := by
      dsimp only [L_pad, D_succ]
      rw [AlgebraicGeometry.Proj.map_preimage_basicOpen ψ_pad h_irrel]
      have h1 : ψ_pad (MvPolynomial.X 1) = 0 := by
        change ψ_ring (MvPolynomial.X 1) = 0
        dsimp only [ψ_ring]
        rw [MvPolynomial.eval₂Hom_X', hv_pad_1]
      rw [h1, AlgebraicGeometry.Proj.basicOpen_zero]

    have hψ_Xb : ∀ b : Fin (2 * m + 2), ψ_pad (MvPolynomial.X b.succ.succ) = MvPolynomial.X b := by
      intro b
      change ψ_ring (MvPolynomial.X b.succ.succ) = MvPolynomial.X b
      dsimp only [ψ_ring]
      rw [MvPolynomial.eval₂Hom_X', hv_pad_succ2]

    have hL_pre_b : ∀ b : Fin (2 * m + 2),
        (TopologicalSpace.Opens.map L_pad.base).obj (D_succ b.succ.succ) = D_m b := by
      intro b
      dsimp only [L_pad, D_succ, D_m]
      rw [AlgebraicGeometry.Proj.map_preimage_basicOpen ψ_pad h_irrel, hψ_Xb b]

    let f_P_m : P_m_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) := P_m.hom
    have hL_hom : L_pad ≫ f_P_succ = f_P_m := by
      have hD_m_openCov : TopologicalSpace.IsOpenCover D_m := hD_m_cov
      apply (P_m_sch.openCoverOfIsOpenCover D_m hD_m_openCov).hom_ext
      intro (b : Fin (2 * m + 2))
      change (D_m b).ι ≫ (L_pad ≫ f_P_succ) = (D_m b).ι ≫ f_P_m
      rw [← CategoryTheory.cancel_epi
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m (MvPolynomial.X b) (hX_m b) zero_lt_one).inv]
      have hinv_b : (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m (MvPolynomial.X b)
          (hX_m b) zero_lt_one).inv ≫ (D_m b).ι =
          AlgebraicGeometry.Proj.awayι 𝒜_m (MvPolynomial.X b) (hX_m b) zero_lt_one :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_m (MvPolynomial.X b) (hX_m b) zero_lt_one
      rw [← CategoryTheory.Category.assoc _ (D_m b).ι (L_pad ≫ f_P_succ), hinv_b,
        ← CategoryTheory.Category.assoc _ (D_m b).ι f_P_m, hinv_b]
      have h_on_ψ : AlgebraicGeometry.Proj.awayι 𝒜_m (ψ_pad (MvPolynomial.X b.succ.succ))
          (hψ_mem 1 _ (hX_succ b.succ.succ)) zero_lt_one ≫ (L_pad ≫ f_P_succ) =
          AlgebraicGeometry.Proj.awayι 𝒜_m (ψ_pad (MvPolynomial.X b.succ.succ))
            (hψ_mem 1 _ (hX_succ b.succ.succ)) zero_lt_one ≫ f_P_m := by
        rw [← CategoryTheory.Category.assoc _ L_pad f_P_succ,
          AlgebraicGeometry.Proj.awayι_comp_map ψ_pad h_irrel zero_lt_one
            (MvPolynomial.X b.succ.succ) (hX_succ b.succ.succ)]
        change (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (HomogeneousLocalization.Away.map ψ_pad (MvPolynomial.X b.succ.succ))) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_succ (MvPolynomial.X b.succ.succ)
            (hX_succ b.succ.succ) zero_lt_one) ≫
          (AlgebraicGeometry.Proj.toSpecZero 𝒜_succ ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥(𝒜_succ 0)))) =
          AlgebraicGeometry.Proj.awayι 𝒜_m (ψ_pad (MvPolynomial.X b.succ.succ))
            (hψ_mem 1 _ (hX_succ b.succ.succ)) zero_lt_one ≫
          (AlgebraicGeometry.Proj.toSpecZero 𝒜_m ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥(𝒜_m 0))))
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc
          (AlgebraicGeometry.Proj.awayι 𝒜_succ (MvPolynomial.X b.succ.succ) _ zero_lt_one),
          AlgebraicGeometry.Proj.awayι_toSpecZero,
          ← CategoryTheory.Category.assoc
            (AlgebraicGeometry.Proj.awayι 𝒜_m (ψ_pad (MvPolynomial.X b.succ.succ)) _ zero_lt_one),
          AlgebraicGeometry.Proj.awayι_toSpecZero]
        simp only [← AlgebraicGeometry.Spec.map_comp]
        congr 1
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        change (HomogeneousLocalization.Away.map ψ_pad (MvPolynomial.X b.succ.succ))
          (HomogeneousLocalization.fromZeroRingHom 𝒜_succ _ (algebraMap K ↥(𝒜_succ 0) c)) =
          HomogeneousLocalization.fromZeroRingHom 𝒜_m _ (algebraMap K ↥(𝒜_m 0) c)
        have hfz_s : HomogeneousLocalization.fromZeroRingHom 𝒜_succ
            (Submonoid.powers (MvPolynomial.X b.succ.succ)) (algebraMap K ↥(𝒜_succ 0) c) =
            HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ b.succ.succ) 0
              (algebraMap K ↥(𝒜_succ 0) c).1 (by rw [zero_smul]; exact (algebraMap K ↥(𝒜_succ 0) c).2) := by
          apply HomogeneousLocalization.val_injective
          change (HomogeneousLocalization.mk _).val = _
          rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.Away.val_mk]
          simp only [Localization.mk_eq_mk', IsLocalization.eq]
          exact ⟨1, by simp only [Submonoid.coe_one, SetLike.GradeZero.coe_one, pow_zero]⟩
        have hfz_m : HomogeneousLocalization.fromZeroRingHom 𝒜_m
            (Submonoid.powers (ψ_pad (MvPolynomial.X b.succ.succ))) (algebraMap K ↥(𝒜_m 0) c) =
            HomogeneousLocalization.Away.mk 𝒜_m (hψ_mem 1 _ (hX_succ b.succ.succ)) 0
              (algebraMap K ↥(𝒜_m 0) c).1 (by rw [zero_smul]; exact (algebraMap K ↥(𝒜_m 0) c).2) := by
          apply HomogeneousLocalization.val_injective
          change (HomogeneousLocalization.mk _).val = _
          rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.Away.val_mk]
          apply congrArg (Localization.mk (algebraMap K ↥(𝒜_m 0) c).1)
          apply Subtype.ext
          simp only [SetLike.GradeZero.coe_one, pow_zero]
        rw [hfz_s, hfz_m, HomogeneousLocalization.Away.map_mk]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk]
        apply congrArg (fun a => Localization.mk a _)
        have hcoe1 : (algebraMap K ↥(𝒜_succ 0) c).1 = MvPolynomial.C c := by
          rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul, SetLike.GradeZero.coe_one,
            Algebra.smul_def, mul_one]
          rfl
        have hcoe2 : (algebraMap K ↥(𝒜_m 0) c).1 = MvPolynomial.C c := by
          rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul, SetLike.GradeZero.coe_one,
            Algebra.smul_def, mul_one]
          rfl
        rw [hcoe1, hcoe2]
        change ψ_ring (MvPolynomial.C c) = MvPolynomial.C c
        exact MvPolynomial.eval₂Hom_C _ _ c
      have htrans_hom : ∀ (y : MvPolynomial (Fin (2 * m + 2)) K),
          ψ_pad (MvPolynomial.X b.succ.succ) = y →
          ∀ (hy : y ∈ 𝒜_m 1),
          AlgebraicGeometry.Proj.awayι 𝒜_m y hy zero_lt_one ≫ (L_pad ≫ f_P_succ) =
            AlgebraicGeometry.Proj.awayι 𝒜_m y hy zero_lt_one ≫ f_P_m := by
        intro y hy_eq
        subst hy_eq
        intro _
        exact h_on_ψ
      exact htrans_hom (MvPolynomial.X b) (hψ_Xb b) (hX_m b)

    haveI hQC_Lpad : AlgebraicGeometry.QuasiCompact L_pad := by
      haveI : AlgebraicGeometry.QuasiCompact (L_pad ≫ f_P_succ) := by
        rw [hL_hom]
        exact hProjQC N_m
      exact AlgebraicGeometry.QuasiCompact.of_comp L_pad f_P_succ

    have hL_sec : ∀ (b : Fin (2 * m + 2))
        (hle : D_m b ≤ (TopologicalSpace.Opens.map L_pad.base).obj (D_succ b.succ.succ))
        (z : HomogeneousLocalization.Away 𝒜_succ (MvPolynomial.X b.succ.succ)),
        (L_pad.appLE (D_succ b.succ.succ) (D_m b) hle).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X b.succ.succ)).hom z) =
        (AlgebraicGeometry.Proj.awayToSection 𝒜_m (MvPolynomial.X b)).hom
          (Eq.mp (congrArg (HomogeneousLocalization.Away 𝒜_m) (hψ_Xb b))
            (HomogeneousLocalization.Away.map ψ_pad (MvPolynomial.X b.succ.succ) z)) := by
      intro b hle z
      let s_b : MvPolynomial (Fin (2 * (m + 1) + 2)) K := MvPolynomial.X b.succ.succ
      have hs_b : s_b ∈ 𝒜_succ 1 := hX_succ b.succ.succ
      have hs'_b : ψ_pad s_b ∈ 𝒜_m 1 := hψ_mem 1 s_b hs_b
      let D_B' : P_m_sch.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_m (ψ_pad s_b)
      have hle' : D_B' ≤ L_pad ⁻¹ᵁ (D_succ b.succ.succ) :=
        le_of_eq (AlgebraicGeometry.Proj.map_preimage_basicOpen ψ_pad h_irrel s_b).symm
      have hres' : L_pad.resLE (D_succ b.succ.succ) D_B' hle' =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m (ψ_pad s_b) hs'_b zero_lt_one).hom ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map ψ_pad s_b)) ≫
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_succ s_b hs_b zero_lt_one).inv := by
        rw [← CategoryTheory.cancel_mono (D_succ b.succ.succ).ι,
          AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι,
          ← AlgebraicGeometry.Proj.awayι_comp_map ψ_pad h_irrel zero_lt_one s_b hs_b,
          ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_m (ψ_pad s_b) hs'_b zero_lt_one,
          CategoryTheory.Iso.hom_inv_id_assoc]
      have hA : (D_succ b.succ.succ).toSpecΓ ≫
          AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_succ s_b) =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_succ s_b hs_b zero_lt_one).hom :=
        (AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_succ s_b hs_b zero_lt_one).symm
      have hB : D_B'.toSpecΓ ≫
          AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_m (ψ_pad s_b)) =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m (ψ_pad s_b) hs'_b zero_lt_one).hom :=
        (AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_m (ψ_pad s_b) hs'_b zero_lt_one).symm
      have hspec' : D_B'.toSpecΓ ≫
          AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Proj.awayToSection 𝒜_succ s_b ≫
              L_pad.appLE (D_succ b.succ.succ) D_B' hle') =
          D_B'.toSpecΓ ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (HomogeneousLocalization.Away.map ψ_pad s_b) ≫
              AlgebraicGeometry.Proj.awayToSection 𝒜_m (ψ_pad s_b)) := by
        rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE, hres']
        simp only [CategoryTheory.Category.assoc, hA, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.comp_id]
        rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc, hB]
      have hAff_B' : AlgebraicGeometry.IsAffineOpen D_B' :=
        AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_m (ψ_pad s_b) hs'_b zero_lt_one
      haveI : CategoryTheory.IsIso D_B'.toSpecΓ := by
        rw [← hAff_B'.isoSpec_hom]
        infer_instance
      have hhom_eq := AlgebraicGeometry.Spec.map_injective ((CategoryTheory.cancel_epi D_B'.toSpecΓ).mp hspec')
      have hval' := congrArg (fun φ => φ.hom z) hhom_eq
      change (L_pad.appLE (D_succ b.succ.succ) D_B' hle').hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ s_b).hom z) =
        (AlgebraicGeometry.Proj.awayToSection 𝒜_m (ψ_pad s_b)).hom
          (HomogeneousLocalization.Away.map ψ_pad s_b z) at hval'
      have htrans : ∀ (y_m : MvPolynomial (Fin (2 * m + 2)) K) (hy_eq : ψ_pad s_b = y_m)
          (hle_y : AlgebraicGeometry.Proj.basicOpen 𝒜_m y_m ≤
            (TopologicalSpace.Opens.map L_pad.base).obj (D_succ b.succ.succ)),
          (L_pad.appLE (D_succ b.succ.succ) (AlgebraicGeometry.Proj.basicOpen 𝒜_m y_m) hle_y).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ s_b).hom z) =
          (AlgebraicGeometry.Proj.awayToSection 𝒜_m y_m).hom
            (Eq.mp (congrArg (HomogeneousLocalization.Away 𝒜_m) hy_eq)
              (HomogeneousLocalization.Away.map ψ_pad s_b z)) := by
        intro y_m hy_eq
        subst hy_eq
        intro hle_y
        exact hval'
      exact htrans (MvPolynomial.X b) (hψ_Xb b) hle

    have hL_bridge : ∀ (g : Q_m.left ⟶ P_succ_sch),
        g = ι_m' ≫ L_pad →
        ∀ (b : Fin (2 * m + 2))
          (hg_le : W b ≤ (TopologicalSpace.Opens.map g.base).obj (D_succ b.succ.succ))
          (z : HomogeneousLocalization.Away 𝒜_succ (MvPolynomial.X b.succ.succ)),
        (g.appLE (D_succ b.succ.succ) (W b) hg_le).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X b.succ.succ)).hom z) =
        (ι_m'.appLE (D_m b) (W b) (le_refl _)).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_m (MvPolynomial.X b)).hom
            (Eq.mp (congrArg (HomogeneousLocalization.Away 𝒜_m) (hψ_Xb b))
              (HomogeneousLocalization.Away.map ψ_pad (MvPolynomial.X b.succ.succ) z))) := by
      intro g hg_eq
      subst hg_eq
      intro b hg_le z
      have hcomp := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_m' L_pad
        (D_succ b.succ.succ) (D_m b) (W b) (le_of_eq (hL_pre_b b).symm) (le_refl _)
      let s_z := (AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X b.succ.succ)).hom z
      have hval : ((ι_m' ≫ L_pad).appLE (D_succ b.succ.succ) (W b) hg_le).hom s_z =
          (ι_m'.appLE (D_m b) (W b) (le_refl _)).hom
            ((L_pad.appLE (D_succ b.succ.succ) (D_m b) (le_of_eq (hL_pre_b b).symm)).hom s_z) :=
        congrArg (fun φ => φ.hom s_z) hcomp.symm
      rw [hval, hL_sec b (le_of_eq (hL_pre_b b).symm) z]

    have hAway_cast_mk : ∀ (b : Fin (2 * m + 2)) (d : ℕ)
        (G : MvPolynomial (Fin (2 * (m + 1) + 2)) K)
        (hb_deg : MvPolynomial.X b.succ.succ ∈ 𝒜_succ 1)
        (hG : G ∈ 𝒜_succ (d • 1))
        (hb_m : MvPolynomial.X b ∈ 𝒜_m 1)
        (hψG : ψ_ring G ∈ 𝒜_m (d • 1)),
        Eq.mp (congrArg (HomogeneousLocalization.Away 𝒜_m) (hψ_Xb b))
          (HomogeneousLocalization.Away.map ψ_pad (MvPolynomial.X b.succ.succ)
            (HomogeneousLocalization.Away.mk 𝒜_succ hb_deg d G hG)) =
        HomogeneousLocalization.Away.mk 𝒜_m hb_m d (ψ_ring G) hψG := by
      intro b d G hb_deg hG hb_m hψG
      have hgen : ∀ (y_m : MvPolynomial (Fin (2 * m + 2)) K)
          (hy_eq : ψ_pad (MvPolynomial.X b.succ.succ) = y_m)
          (hy_deg : y_m ∈ 𝒜_m 1),
          Eq.mp (congrArg (HomogeneousLocalization.Away 𝒜_m) hy_eq)
            (HomogeneousLocalization.Away.map ψ_pad (MvPolynomial.X b.succ.succ)
              (HomogeneousLocalization.Away.mk 𝒜_succ hb_deg d G hG)) =
          HomogeneousLocalization.Away.mk 𝒜_m hy_deg d (ψ_ring G) hψG := by
        intro y_m hy_eq
        subst hy_eq
        intro hy_deg
        change HomogeneousLocalization.Away.map ψ_pad (MvPolynomial.X b.succ.succ) _ = _
        rw [HomogeneousLocalization.Away.map_mk]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk]
        rfl
      exact hgen (MvPolynomial.X b) (hψ_Xb b) hb_m

    have hψ_Fsplit : ψ_ring
        (∑ j ∈ Finset.range (m + 1 + 1),
          if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
            (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
              MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) K) *
              MvPolynomial.X ⟨2 * j + 1, h⟩
          else 0) =
        (∑ k ∈ Finset.range (m + 1),
          if h : 2 * k + 1 < 2 * m + 1 + 1 then
            (MvPolynomial.X ⟨2 * k, Nat.lt_of_succ_lt h⟩ :
              MvPolynomial (Fin (2 * m + 1 + 1)) K) *
              MvPolynomial.X ⟨2 * k + 1, h⟩
          else 0) := by
      rw [Finset.sum_range_succ', map_add, map_sum]
      have h0_term : ψ_ring
          (if h : 2 * 0 + 1 < 2 * (m + 1) + 1 + 1 then
            (MvPolynomial.X ⟨2 * 0, Nat.lt_of_succ_lt h⟩ :
              MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) K) *
              MvPolynomial.X ⟨2 * 0 + 1, h⟩
          else 0) = 0 := by
        split_ifs with h0
        · dsimp only [ψ_ring]
          rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
          have idx0 : (⟨2 * 0, Nat.lt_of_succ_lt h0⟩ : Fin (2 * (m + 1) + 2)) = 0 := rfl
          rw [idx0, hv_pad_0, zero_mul]
        · exact map_zero _
      rw [h0_term, add_zero]
      apply Finset.sum_congr rfl
      intro k hk
      have hk_lt : k < m + 1 := Finset.mem_range.mp hk
      have h_s : 2 * (k + 1) + 1 < 2 * (m + 1) + 1 + 1 := by omega
      have h_m : 2 * k + 1 < 2 * m + 1 + 1 := by omega
      rw [dif_pos h_s, dif_pos h_m]
      dsimp only [ψ_ring]
      rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
      have hidx_even : (⟨2 * (k + 1), Nat.lt_of_succ_lt h_s⟩ : Fin ((2 * m + 2) + 2)) =
          (⟨2 * k, Nat.lt_of_succ_lt h_m⟩ : Fin (2 * m + 2)).succ.succ := by
        ext
        dsimp
        omega
      have hidx_odd : (⟨2 * (k + 1) + 1, h_s⟩ : Fin ((2 * m + 2) + 2)) =
          (⟨2 * k + 1, h_m⟩ : Fin (2 * m + 2)).succ.succ := by
        ext
        dsimp
        omega
      rw [hidx_even, hidx_odd, hv_pad_succ2, hv_pad_succ2]

    let g_P : Q_m.left ⟶ P_succ_sch := ι_m' ≫ L_pad
    haveI hQC_gP : AlgebraicGeometry.QuasiCompact g_P := inferInstance

    have hker_gP_succ : ι_succ'.ker ≤ g_P.ker := by
      apply AlgebraicGeometry.Scheme.IdealSheafData.le_of_iSup_eq_top D_succ_aff hD_succ_cov
      intro μ
      rw [AlgebraicGeometry.Scheme.Hom.ker_apply, AlgebraicGeometry.Scheme.Hom.ker_apply]
      have hker_μ : RingHom.ker (ι_succ'.app (D_succ μ)).hom =
          Ideal.span {(AlgebraicGeometry.Scheme.Hom.appLE (𝟙 P_succ_sch) (D_succ μ) (D_succ μ) (le_refl _)).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X μ)).hom
              (HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ μ) 2 _ hF_succ_mem))} :=
        hKer_succ μ (hX_succ μ) (D_succ μ) (D_succ_aff μ).2 (le_refl _)
      change RingHom.ker (ι_succ'.app (D_succ μ)).hom ≤ RingHom.ker (g_P.app (D_succ μ)).hom
      rw [hker_μ, Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      let s_μ := (AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X μ)).hom
        (HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ μ) 2 _ hF_succ_mem)
      rw [hIdAppLE P_succ_sch (D_succ μ) s_μ]
      refine Fin.cases
        (motive := fun ν : Fin ((2 * m + 2) + 2) =>
          (g_P.app (D_succ ν)).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X ν)).hom
              (HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ ν) 2 _ hF_succ_mem)) = 0)
        (by
          have hpre0 : (TopologicalSpace.Opens.map g_P.base).obj (D_succ 0) = ⊥ := by
            change (TopologicalSpace.Opens.map ι_m'.base).obj
              ((TopologicalSpace.Opens.map L_pad.base).obj (D_succ 0)) = ⊥
            rw [hL_pre0]
            rfl
          have hsub : Subsingleton ↑(Q_m.left.presheaf.obj
              (Opposite.op ((TopologicalSpace.Opens.map g_P.base).obj (D_succ 0)))) := by
            rw [hpre0]
            infer_instance
          exact hsub.elim _ _)
        (fun ν => Fin.cases
          (motive := fun κ : Fin ((2 * m + 2) + 1) =>
            (g_P.app (D_succ κ.succ)).hom
              ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X κ.succ)).hom
                (HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ κ.succ) 2 _ hF_succ_mem)) = 0)
          (by
            have hpre1 : (TopologicalSpace.Opens.map g_P.base).obj (D_succ 1) = ⊥ := by
              change (TopologicalSpace.Opens.map ι_m'.base).obj
                ((TopologicalSpace.Opens.map L_pad.base).obj (D_succ 1)) = ⊥
              rw [hL_pre1]
              rfl
            have hsub : Subsingleton ↑(Q_m.left.presheaf.obj
                (Opposite.op ((TopologicalSpace.Opens.map g_P.base).obj (D_succ 1)))) := by
              rw [hpre1]
              infer_instance
            exact hsub.elim _ _)
          (fun b => by
            have hW_eq : (TopologicalSpace.Opens.map g_P.base).obj (D_succ b.succ.succ) = W b := by
              change (TopologicalSpace.Opens.map ι_m'.base).obj
                ((TopologicalSpace.Opens.map L_pad.base).obj (D_succ b.succ.succ)) = W b
              rw [hL_pre_b b]
              rfl
            let s_bF := (AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X b.succ.succ)).hom
              (HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ b.succ.succ) 2 _ hF_succ_mem)
            have happ_res : g_P.app (D_succ b.succ.succ) =
                g_P.appLE (D_succ b.succ.succ) (W b) (le_of_eq hW_eq.symm) ≫
                  Q_m.left.presheaf.map (CategoryTheory.homOfLE (le_of_eq hW_eq)).op := by
              rw [AlgebraicGeometry.Scheme.Hom.appLE_map, AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
            have happ_s : (g_P.app (D_succ b.succ.succ)).hom s_bF =
                (Q_m.left.presheaf.map (CategoryTheory.homOfLE (le_of_eq hW_eq)).op).hom
                  ((g_P.appLE (D_succ b.succ.succ) (W b) (le_of_eq hW_eq.symm)).hom s_bF) :=
              congrArg (fun φ => φ.hom s_bF) happ_res
            rw [happ_s,
              hL_bridge g_P rfl b (le_of_eq hW_eq.symm),
              hAway_cast_mk b 2 _ (hX_succ b.succ.succ) hF_succ_mem (hX_m b)
                (by rw [hψ_Fsplit]; exact hF_m_mem)]
            have hker_Wb : RingHom.ker (ι_m'.app (D_m b)).hom =
                Ideal.span {(AlgebraicGeometry.Scheme.Hom.appLE (𝟙 P_m_sch) (D_m b) (D_m b) (le_refl _)).hom
                  ((AlgebraicGeometry.Proj.awayToSection 𝒜_m (MvPolynomial.X b)).hom
                    (HomogeneousLocalization.Away.mk 𝒜_m (hX_m b) 2 _ hF_m_mem))} :=
              hKer_m b (hX_m b) (D_m b)
                (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_m (MvPolynomial.X b)
                  (hX_m b) zero_lt_one) (le_refl _)
            have hzero_Wb : (ι_m'.appLE (D_m b) (W b) (le_refl _)).hom
                ((AlgebraicGeometry.Proj.awayToSection 𝒜_m (MvPolynomial.X b)).hom
                  (HomogeneousLocalization.Away.mk 𝒜_m (hX_m b) 2 (ψ_ring _)
                    (by rw [hψ_Fsplit]; exact hF_m_mem))) = 0 := by
              have hmk_eq : HomogeneousLocalization.Away.mk 𝒜_m (hX_m b) 2 (ψ_ring _)
                  (by rw [hψ_Fsplit]; exact hF_m_mem) =
                  HomogeneousLocalization.Away.mk 𝒜_m (hX_m b) 2 _ hF_m_mem := by
                apply HomogeneousLocalization.val_injective
                rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, hψ_Fsplit]
              rw [hmk_eq]
              let s_mF := (AlgebraicGeometry.Proj.awayToSection 𝒜_m (MvPolynomial.X b)).hom
                (HomogeneousLocalization.Away.mk 𝒜_m (hX_m b) 2 _ hF_m_mem)
              have happ_ιm : ι_m'.appLE (D_m b) (W b) (le_refl _) = ι_m'.app (D_m b) :=
                (AlgebraicGeometry.Scheme.Hom.app_eq_appLE ι_m').symm
              have happ_ιm_s : (ι_m'.appLE (D_m b) (W b) (le_refl _)).hom s_mF =
                  (ι_m'.app (D_m b)).hom s_mF :=
                congrArg (fun φ => φ.hom s_mF) happ_ιm
              have hzero_app : (ι_m'.app (D_m b)).hom s_mF = 0 := by
                rw [← RingHom.mem_ker, hker_Wb]
                rw [← hIdAppLE P_m_sch (D_m b) s_mF]
                exact Ideal.subset_span rfl
              exact happ_ιm_s.trans hzero_app
            rw [hzero_Wb, map_zero])
          ν)
        μ

    let g_Q : Q_m.left ⟶ Q_succ.left :=
      AlgebraicGeometry.IsClosedImmersion.lift ι_succ' g_P hker_gP_succ
    have hg_Q_fac : g_Q ≫ ι_succ' = g_P :=
      AlgebraicGeometry.IsClosedImmersion.lift_fac ι_succ' g_P hker_gP_succ
    haveI hQC_gQ : AlgebraicGeometry.QuasiCompact g_Q := by
      haveI : AlgebraicGeometry.QuasiCompact (g_Q ≫ ι_succ') := by
        rw [hg_Q_fac]
        exact hQC_gP
      exact AlgebraicGeometry.QuasiCompact.of_comp g_Q ι_succ'

    have hker_gQ_Z : i_Z.left.ker ≤ g_Q.ker := by
      apply AlgebraicGeometry.Scheme.IdealSheafData.le_of_iSup_eq_top Q_aff hQ_aff_cov
      intro μ
      rw [AlgebraicGeometry.Scheme.Hom.ker_apply, AlgebraicGeometry.Scheme.Hom.ker_apply]
      rw [hKer_Z μ (hX_succ μ) (Q_aff μ).1 (Q_aff μ).2 (le_refl _),
        Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      let s_μ0 := (AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X μ)).hom
        (HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ μ) 1 (MvPolynomial.X 0) hX0_mem)
      change (g_Q.app (Q_aff μ).1).hom ((ι_succ'.appLE (D_succ μ) (Q_aff μ).1 (le_refl _)).hom s_μ0) = 0
      have happ_comp : ι_succ'.appLE (D_succ μ) (Q_aff μ).1 (le_refl _) ≫ g_Q.app (Q_aff μ).1 =
          (g_Q ≫ ι_succ').appLE (D_succ μ)
            ((TopologicalSpace.Opens.map g_Q.base).obj (Q_aff μ).1) (le_refl _) := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
          AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
      have hval : (g_Q.app (Q_aff μ).1).hom ((ι_succ'.appLE (D_succ μ) (Q_aff μ).1 (le_refl _)).hom s_μ0) =
          ((g_Q ≫ ι_succ').appLE (D_succ μ)
            ((TopologicalSpace.Opens.map g_Q.base).obj (Q_aff μ).1) (le_refl _)).hom s_μ0 :=
        congrArg (fun φ => φ.hom s_μ0) happ_comp
      rw [hval]
      refine Fin.cases
        (motive := fun ν : Fin ((2 * m + 2) + 2) =>
          ((g_Q ≫ ι_succ').appLE (D_succ ν)
            ((TopologicalSpace.Opens.map g_Q.base).obj (Q_aff ν).1) (le_refl _)).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X ν)).hom
              (HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ ν) 1 (MvPolynomial.X 0) hX0_mem)) = 0)
        (by
          have hpre0 : (TopologicalSpace.Opens.map g_Q.base).obj (Q_aff 0).1 = ⊥ := by
            change (TopologicalSpace.Opens.map (g_Q ≫ ι_succ').base).obj (D_succ 0) = ⊥
            rw [hg_Q_fac]
            change (TopologicalSpace.Opens.map ι_m'.base).obj
              ((TopologicalSpace.Opens.map L_pad.base).obj (D_succ 0)) = ⊥
            rw [hL_pre0]
            rfl
          have hsub : Subsingleton ↑(Q_m.left.presheaf.obj
              (Opposite.op ((TopologicalSpace.Opens.map g_Q.base).obj (Q_aff 0).1))) := by
            rw [hpre0]
            infer_instance
          exact hsub.elim _ _)
        (fun ν => Fin.cases
          (motive := fun κ : Fin ((2 * m + 2) + 1) =>
            ((g_Q ≫ ι_succ').appLE (D_succ κ.succ)
              ((TopologicalSpace.Opens.map g_Q.base).obj (Q_aff κ.succ).1) (le_refl _)).hom
              ((AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X κ.succ)).hom
                (HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ κ.succ) 1 (MvPolynomial.X 0) hX0_mem)) = 0)
          (by
            have hpre1 : (TopologicalSpace.Opens.map g_Q.base).obj (Q_aff 1).1 = ⊥ := by
              change (TopologicalSpace.Opens.map (g_Q ≫ ι_succ').base).obj (D_succ 1) = ⊥
              rw [hg_Q_fac]
              change (TopologicalSpace.Opens.map ι_m'.base).obj
                ((TopologicalSpace.Opens.map L_pad.base).obj (D_succ 1)) = ⊥
              rw [hL_pre1]
              rfl
            have hsub : Subsingleton ↑(Q_m.left.presheaf.obj
                (Opposite.op ((TopologicalSpace.Opens.map g_Q.base).obj (Q_aff 1).1))) := by
              rw [hpre1]
              infer_instance
            exact hsub.elim _ _)
          (fun b => by
            have hW_eq : (TopologicalSpace.Opens.map g_Q.base).obj (Q_aff b.succ.succ).1 = W b := by
              change (TopologicalSpace.Opens.map (g_Q ≫ ι_succ').base).obj (D_succ b.succ.succ) = W b
              rw [hg_Q_fac]
              change (TopologicalSpace.Opens.map ι_m'.base).obj
                ((TopologicalSpace.Opens.map L_pad.base).obj (D_succ b.succ.succ)) = W b
              rw [hL_pre_b b]
              rfl
            let s_b0 := (AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X b.succ.succ)).hom
              (HomogeneousLocalization.Away.mk 𝒜_succ (hX_succ b.succ.succ) 1 (MvPolynomial.X 0) hX0_mem)
            have happ_res : (g_Q ≫ ι_succ').appLE (D_succ b.succ.succ)
                ((TopologicalSpace.Opens.map g_Q.base).obj (Q_aff b.succ.succ).1) (le_refl _) =
                (g_Q ≫ ι_succ').appLE (D_succ b.succ.succ) (W b) (le_of_eq hW_eq.symm) ≫
                  Q_m.left.presheaf.map (CategoryTheory.homOfLE (le_of_eq hW_eq)).op := by
              rw [AlgebraicGeometry.Scheme.Hom.appLE_map]
            have happ_s0 : ((g_Q ≫ ι_succ').appLE (D_succ b.succ.succ)
                ((TopologicalSpace.Opens.map g_Q.base).obj (Q_aff b.succ.succ).1) (le_refl _)).hom s_b0 =
                (Q_m.left.presheaf.map (CategoryTheory.homOfLE (le_of_eq hW_eq)).op).hom
                  (((g_Q ≫ ι_succ').appLE (D_succ b.succ.succ) (W b) (le_of_eq hW_eq.symm)).hom s_b0) :=
              congrArg (fun φ => φ.hom s_b0) happ_res
            rw [happ_s0, hL_bridge (g_Q ≫ ι_succ') hg_Q_fac b (le_of_eq hW_eq.symm)]
            have hψ_X0 : ψ_ring (MvPolynomial.X 0) = 0 := by
              dsimp only [ψ_ring]
              rw [MvPolynomial.eval₂Hom_X', hv_pad_0]
            rw [hAway_cast_mk b 1 (MvPolynomial.X 0) (hX_succ b.succ.succ) hX0_mem (hX_m b)
              (by rw [hψ_X0, one_smul]; exact MvPolynomial.isHomogeneous_zero _ _ _)]
            have hmk_zero : HomogeneousLocalization.Away.mk 𝒜_m (hX_m b) 1 (ψ_ring (MvPolynomial.X 0))
                (by rw [hψ_X0, one_smul]; exact MvPolynomial.isHomogeneous_zero _ _ _) = 0 := by
              apply HomogeneousLocalization.val_injective
              rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply,
                map_zero, HomogeneousLocalization.algebraMap_apply,
                HomogeneousLocalization.Away.val_mk, hψ_X0, Localization.mk_zero]
            rw [hmk_zero, map_zero, map_zero, map_zero])
          ν)
        μ

    let σ_left : Q_m.left ⟶ Z_cone.left :=
      AlgebraicGeometry.IsClosedImmersion.lift i_Z.left g_Q hker_gQ_Z
    have hσ_fac : σ_left ≫ i_Z.left = g_Q :=
      AlgebraicGeometry.IsClosedImmersion.lift_fac i_Z.left g_Q hker_gQ_Z
    have hσ_comp : σ_left ≫ i_Z.left ≫ ι_succ' = ι_m' ≫ L_pad := by
      rw [← CategoryTheory.Category.assoc, hσ_fac, hg_Q_fac]
    have hσ_w : σ_left ≫ Z_cone.hom = Q_m.hom := by
      rw [← i_Z.w, ← CategoryTheory.Category.assoc, hσ_fac, ← hι_succ]
      change (g_Q ≫ ι_succ') ≫ f_P_succ = Q_m.hom
      rw [hg_Q_fac]
      change (ι_m' ≫ L_pad) ≫ f_P_succ = Q_m.hom
      rw [CategoryTheory.Category.assoc, hL_hom]
      exact hι_m

    let σ_inf : Q_m ⟶ Z_cone := CategoryTheory.Over.homMk σ_left hσ_w

    have hσ_Db : ∀ b : Fin (2 * m + 2),
        W b ≤ (TopologicalSpace.Opens.map (σ_inf.left ≫ i_Z.left ≫ ι_succ).base).obj
          (weilProjBasicOpen K (2 * (m + 1) + 1) b.succ.succ) := by
      intro b
      have heq_open : (TopologicalSpace.Opens.map (σ_left ≫ i_Z.left ≫ ι_succ').base).obj
          (D_succ b.succ.succ) = W b := by
        rw [hσ_comp]
        change (TopologicalSpace.Opens.map ι_m'.base).obj
          ((TopologicalSpace.Opens.map L_pad.base).obj (D_succ b.succ.succ)) = W b
        rw [hL_pre_b b]
        rfl
      exact le_of_eq heq_open.symm

    have hσ_range : Set.range σ_inf.left.base ⊆ (U_Z : Set Z_cone.left) := by
      rintro _ ⟨q, rfl⟩
      have hW_cov : (⨆ b : Fin (2 * m + 2), W b) = ⊤ :=
        AlgebraicGeometry.Scheme.Hom.iSup_preimage_eq_top ι_m' hD_m_cov
      have hq_W : q ∈ (⨆ b : Fin (2 * m + 2), W b) := by
        rw [hW_cov]
        trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hq_W
      obtain ⟨b, hb⟩ := hq_W
      have hq_Zb : σ_inf.left.base q ∈ Z_chart b.succ.succ := hσ_Db b hb
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨b, hq_Zb⟩

    have hσ_coord : ∀ b a : Fin (2 * m + 2),
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K) :=
          MvPolynomial.gradedAlgebra
         letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) K) :=
          MvPolynomial.gradedAlgebra
         ((σ_inf.left ≫ i_Z.left ≫ ι_succ).appLE
           (weilProjBasicOpen K (2 * (m + 1) + 1) b.succ.succ) (W b) (hσ_Db b)).hom
           ((AlgebraicGeometry.Proj.awayToSection
             (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K)
             (MvPolynomial.X b.succ.succ)).hom
             (HomogeneousLocalization.Away.mk
               (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K)
               (MvPolynomial.isHomogeneous_X K b.succ.succ) 1
               (MvPolynomial.X a.succ.succ)
               (MvPolynomial.isHomogeneous_X K a.succ.succ))) =
         (ι_m.appLE (weilProjBasicOpen K (2 * m + 1) b) (W b) (le_refl _)).hom
           ((AlgebraicGeometry.Proj.awayToSection
             (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) K)
             (MvPolynomial.X b)).hom
             (HomogeneousLocalization.Away.mk
               (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) K)
               (MvPolynomial.isHomogeneous_X K b) 1
               (MvPolynomial.X a)
               (MvPolynomial.isHomogeneous_X K a)))) := by
      intro b a
      let z_ba : HomogeneousLocalization.Away 𝒜_succ (MvPolynomial.X b.succ.succ) :=
        HomogeneousLocalization.Away.mk 𝒜_succ
          (hX_succ b.succ.succ) 1
          (MvPolynomial.X a.succ.succ)
          (by rw [one_smul]; exact hX_succ a.succ.succ)
      have h1 := hL_bridge (σ_left ≫ i_Z.left ≫ ι_succ') hσ_comp b (hσ_Db b) z_ba
      have hψ_Xa : ψ_ring (MvPolynomial.X a.succ.succ) = MvPolynomial.X a := hψ_Xb a
      have h2 := hAway_cast_mk b 1 (MvPolynomial.X a.succ.succ)
        (hX_succ b.succ.succ)
        (by rw [one_smul]; exact hX_succ a.succ.succ)
        (hX_m b)
        (by rw [hψ_Xa, one_smul]; exact hX_m a)
      have h3_gen : ∀ (P : MvPolynomial (Fin (2 * m + 2)) K),
          P = MvPolynomial.X a →
          ∀ (hP : P ∈ 𝒜_m (1 • 1)),
          HomogeneousLocalization.Away.mk 𝒜_m (hX_m b) 1 P hP =
          HomogeneousLocalization.Away.mk 𝒜_m
            (MvPolynomial.isHomogeneous_X K b) 1
            (MvPolynomial.X a)
            (MvPolynomial.isHomogeneous_X K a) := by
        intro P hP_eq
        subst hP_eq
        intro _
        rfl
      have h3 := h3_gen (ψ_ring (MvPolynomial.X a.succ.succ)) hψ_Xa
        (by rw [hψ_Xa, one_smul]; exact hX_m a)
      exact h1.trans (congrArg
        (fun w => (ι_m'.appLE (D_m b) (W b) (le_refl _)).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_m (MvPolynomial.X b)).hom w))
        (h2.trans h3))

    exact ⟨hZ0_bot, hZ1_UZ_top, p₀, σ_inf, hp₀_D1, hσ_Db,
      hp₀_hom, hUZ_compl, hσ_range, hp₀_coord, hσ_coord⟩

theorem weil_split_quad_chart_partner_elim_and_irred_cover (K : Type u) [Field K] :
    (∀ (d M : ℕ) (hM : 1 ≤ M)
      (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      (C : Fin M → Y.left.Opens),
      (⨆ i : Fin M, C i) = ⊤ →
      (∀ i : Fin M,
        ∃ e_i : (C i).toScheme ≅ (weilAffineSpaceOver K d).left,
          e_i.hom ≫ (weilAffineSpaceOver K d).hom = (C i).ι ≫ Y.hom) →
      AlgebraicGeometry.SmoothOfRelativeDimension d Y.hom ∧
      ((∀ i : Fin M, Nonempty ↥(C ⟨0, hM⟩ ⊓ C i)) →
        AlgebraicGeometry.IsIntegral (weilBaseChangeOver K (AlgebraicClosure K) Y).left)) ∧
    (∀ (n₀ : ℕ)
      (Q : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      (ι : Q.left ⟶ (weilProjectiveSpaceOver K (2 * n₀ + 1)).left),
      ι ≫ (weilProjectiveSpaceOver K (2 * n₀ + 1)).hom = Q.hom →
      IsHomogeneousHypersurfacePullbackOver K (2 * n₀ + 1) 2
        (𝟙 (weilProjectiveSpaceOver K (2 * n₀ + 1)))
        (∑ j ∈ Finset.range (n₀ + 1),
          if h : 2 * j + 1 < 2 * n₀ + 1 + 1 then
            (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
              MvPolynomial (Fin (2 * n₀ + 1 + 1)) K) *
              MvPolynomial.X ⟨2 * j + 1, h⟩
          else 0)
        ι →
      let W : Fin (2 * n₀ + 2) → Q.left.Opens :=
        fun b => (TopologicalSpace.Opens.map ι.base).obj (weilProjBasicOpen K (2 * n₀ + 1) b)
      (⨆ b : Fin (2 * n₀ + 2), W b) = ⊤ ∧
      (∀ b : Fin (2 * n₀ + 2),
        ∃ e_Wb : (W b).toScheme ≅ (weilAffineSpaceOver K (2 * n₀)).left,
          e_Wb.hom ≫ (weilAffineSpaceOver K (2 * n₀)).hom = (W b).ι ≫ Q.hom) ∧
      (n₀ = 0 → W ⟨0, by omega⟩ ⊓ W ⟨1, by omega⟩ = ⊥) ∧
      (1 ≤ n₀ → ∀ b : Fin (2 * n₀ + 2), Nonempty ↥(W ⟨0, by omega⟩ ⊓ W b))) :=
by
  have hPt_uniq : ∀ {F : Type u} [Field F]
      (p q : ↥(AlgebraicGeometry.Spec (CommRingCat.of F))), p = q := by
    intro F _ p q
    have hp : (p : PrimeSpectrum F).asIdeal = ⊥ :=
      (Ideal.eq_bot_or_top (p : PrimeSpectrum F).asIdeal).resolve_right
        (p : PrimeSpectrum F).isPrime.ne_top
    have hq : (q : PrimeSpectrum F).asIdeal = ⊥ :=
      (Ideal.eq_bot_or_top (q : PrimeSpectrum F).asIdeal).resolve_right
        (q : PrimeSpectrum F).isPrime.ne_top
    exact PrimeSpectrum.ext (hp.trans hq.symm)

  refine ⟨?_, ?_⟩
  · 
    intro d M hM Y C hCov hChart
    dsimp only [weilAffineSpaceOver, CategoryTheory.Over.mk_left, CategoryTheory.Over.mk_hom]
      at hChart
    let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
    let Aff_d := AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin d) K))
    let Aff_hom : Aff_d ⟶ S_K :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin d) K))
    refine ⟨?_, ?_⟩
    · 
      refine AlgebraicGeometry.SmoothOfRelativeDimension.mk fun x => ?_
      have hx_cov : x ∈ (⨆ i : Fin M, C i) := by rw [hCov]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hx_cov
      rcases hx_cov with ⟨i, hxi⟩
      rcases hChart i with ⟨e_i, he_i⟩
      have hAff_Ci : AlgebraicGeometry.IsAffineOpen (C i) :=
        AlgebraicGeometry.IsAffine.of_isIso e_i.hom
      have h_le_top : C i ≤ (TopologicalSpace.Opens.map Y.hom.base).obj ⊤ :=
        fun _ _ => trivial
      refine ⟨⊤, AlgebraicGeometry.isAffineOpen_top S_K, C i, hAff_Ci, hxi, h_le_top, ?_⟩
      let δ_i : AlgebraicGeometry.Spec (Y.left.presheaf.obj (Opposite.op (C i))) ≅ Aff_d :=
        hAff_Ci.isoSpec.symm ≪≫ e_i
      let φ_cat : CommRingCat.of (MvPolynomial (Fin d) K) ⟶
          Y.left.presheaf.obj (Opposite.op (C i)) :=
        AlgebraicGeometry.Spec.preimage δ_i.hom
      let ψ_cat : Y.left.presheaf.obj (Opposite.op (C i)) ⟶
          CommRingCat.of (MvPolynomial (Fin d) K) :=
        AlgebraicGeometry.Spec.preimage δ_i.inv
      have hφψ : φ_cat ≫ ψ_cat = 𝟙 _ := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          AlgebraicGeometry.Spec.map_preimage, δ_i.inv_hom_id, AlgebraicGeometry.Spec.map_id]
      have hψφ : ψ_cat ≫ φ_cat = 𝟙 _ := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          AlgebraicGeometry.Spec.map_preimage, δ_i.hom_inv_id, AlgebraicGeometry.Spec.map_id]
      let e_tgt : MvPolynomial (Fin d) K ≃+* ↑(Y.left.presheaf.obj (Opposite.op (C i))) :=
        { φ_cat.hom with
          invFun := ψ_cat.hom
          left_inv := fun s => congrArg (fun f => f.hom s) hφψ
          right_inv := fun r => congrArg (fun f => f.hom r) hψφ }
      have hLHS :
          (C i).toSpecΓ ≫
            AlgebraicGeometry.Spec.map
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
                Y.hom.appLE ⊤ (C i) h_le_top) =
          (C i).ι ≫ Y.hom := by
        have htop_inv :
            (⊤ : S_K.Opens).toSpecΓ ≫
              AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv =
            (⊤ : S_K.Opens).ι := by
          rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_top,
            ← AlgebraicGeometry.SpecMap_ΓSpecIso_hom (CommRingCat.of K),
            CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Spec.map_comp,
            CategoryTheory.Iso.inv_hom_id,
            AlgebraicGeometry.Spec.map_id,
            CategoryTheory.Category.comp_id]
        rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE Y.hom ⊤ (C i) h_le_top,
          CategoryTheory.Category.assoc, htop_inv]
        simp
      have hRHS :
          (C i).toSpecΓ ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin d) K) ≫ φ_cat) =
          (C i).ι ≫ Y.hom := by
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage δ_i.hom]
        change (C i).toSpecΓ ≫ (hAff_Ci.isoSpec.inv ≫ e_i.hom) ≫ Aff_hom = (C i).ι ≫ Y.hom
        rw [← hAff_Ci.isoSpec_hom, ← CategoryTheory.Category.assoc hAff_Ci.isoSpec.hom,
