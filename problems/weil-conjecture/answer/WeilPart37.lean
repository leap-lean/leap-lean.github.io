      intro q₂ h_eq hc_eq
      subst h_eq
      have h_irrel : hc_eq = Nat.add_sub_of_le hi_le := Subsingleton.elim _ _
      subst h_irrel
      exact (hPD_X (r + 1) (2 * d - 2 * c) hi_le θ_top hθ_top).2
    have hPD_2c := hPD_gen (2 * c) (by omega) hc_top

    obtain ⟨b₀, hb₀⟩ := hθ_2c_bij.2 x
    obtain ⟨b₁, hb₁⟩ := hθ_2c_bij.2 (f_X x)
    have hOrthog : ∀ a : weilEtaleModuleH (weilGeomScheme K X) (ℓ ^ (r + 1)) (2 * d - 2 * c),
        tr_X (r + 1) (θ_top (CategoryTheory.Abelian.Ext.comp a
