              have hne_j01 : (⟨⟨(j.1, 1), (hj_ne0 j.1 (Finset.ne_of_mem_erase j.2)).2⟩,
                  hs_ne00 j.1 (Finset.ne_of_mem_erase j.2) 1 _⟩ : S_rest) ≠ s_j0 := by
                intro h
                have h2 : (1 : Fin 2) = 0 := congrArg (fun u : S_rest => u.1.1.2) h
