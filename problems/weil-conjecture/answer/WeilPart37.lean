      (∀ c : ℕ, Subsingleton (weilEtaleTorsionH (weilGeomScheme K Q) (ℓ ^ (r + 1)) (2 * c + 1))) ∧
      (∀ c : ℕ, c ≤ 2 * m₀ →
        ∀ (f_Q : weilEtaleTorsionH (weilGeomScheme K Q) (ℓ ^ (r + 1)) (2 * c) →+
              weilEtaleTorsionH (weilGeomScheme K Q) (ℓ ^ (r + 1)) (2 * c)),
