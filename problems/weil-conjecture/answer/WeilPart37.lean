          (weilAffineSpaceOver K 1).hom) rfl
    obtain ⟨pr1_aff_bar, hpr1_fst, _⟩ := hMakeBcHom pr1_aff_K
    obtain ⟨e_P_aff, he_P_aff⟩ :=
      hProdAffBc (2 * d₀) e_δ he_δ pr1_aff_bar.left hpr1_fst pr1_aff_bar.w

    have hW_bar_triv : ∀ j : Fin M,
        let V_bar_j : (weilGeomScheme K V_ov).Opens :=
          (TopologicalSpace.Opens.map f_V_bar.left.base).obj (W_bar j)
        ∃ (e_B : (W_bar j).toScheme ≅ (weilAffineSpaceOver (AlgebraicClosure K) (2 * d₀)).left)
          (e_V : V_bar_j.toScheme ≅
            CategoryTheory.Limits.pullback (weilAffineSpaceOver (AlgebraicClosure K) (2 * d₀)).hom
              (weilAffineSpaceOver (AlgebraicClosure K) 1).hom),
          e_B.hom ≫ (weilAffineSpaceOver (AlgebraicClosure K) (2 * d₀)).hom =
            (W_bar j).ι ≫ (weilBaseChangeOver K (AlgebraicClosure K) B).hom ∧
          e_V.hom ≫ CategoryTheory.Limits.pullback.fst
              (weilAffineSpaceOver (AlgebraicClosure K) (2 * d₀)).hom
              (weilAffineSpaceOver (AlgebraicClosure K) 1).hom =
            (f_V_bar.left ∣_ (W_bar j)) ≫ e_B.hom := by
      intro j V_bar_j
      obtain ⟨e_Wj, e_Vj, he_Wj, he_Vj⟩ := hW_triv j
      let V_j : V_plus.toScheme.Opens :=
        (TopologicalSpace.Opens.map (V_plus.ι ≫ p.left).base).obj (W j)
      let res_K : V_j.toScheme ⟶ (W j).toScheme := (V_plus.ι ≫ p.left) ∣_ (W j)
      have h_res_K : res_K ≫ (W j).ι = V_j.ι ≫ (V_plus.ι ≫ p.left) :=
        AlgebraicGeometry.morphismRestrict_ι (V_plus.ι ≫ p.left) (W j)
      have he_Vj' : e_Vj.hom ≫ CategoryTheory.Limits.pullback.fst
          (weilAffineSpaceOver K (2 * d₀)).hom (weilAffineSpaceOver K 1).hom =
          res_K ≫ e_Wj.hom := he_Vj
      let W_j_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
        CategoryTheory.Over.mk ((W j).ι ≫ B.hom)
      let V_j_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
        CategoryTheory.Over.mk (V_j.ι ≫ V_ov.hom)
      let f_Vj_ov : V_j_ov ⟶ W_j_ov :=
        @CategoryTheory.Over.homMk _ _ _ V_j_ov W_j_ov res_K (by
          change res_K ≫ (W j).ι ≫ B.hom = V_j.ι ≫ V_plus.ι ≫ P.hom
          rw [← CategoryTheory.Category.assoc, h_res_K, CategoryTheory.Category.assoc,
            CategoryTheory.Category.assoc, p.w])
      have he_Vj_hom : e_Vj.hom ≫ P_aff_K.hom = V_j_ov.hom := by
        change e_Vj.hom ≫ (CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K (2 * d₀)).hom
            (weilAffineSpaceOver K 1).hom ≫ (weilAffineSpaceOver K (2 * d₀)).hom) =
          V_j.ι ≫ V_plus.ι ≫ P.hom
        rw [← CategoryTheory.Category.assoc, he_Vj', CategoryTheory.Category.assoc, he_Wj,
          ← CategoryTheory.Category.assoc, h_res_K, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, p.w]
      obtain ⟨ι_Wj_bar, hιWj_fst, hpb_ιWj⟩ :=
        hMakeBcHom (X₁ := W_j_ov) (X₂ := B) (CategoryTheory.Over.homMk (W j).ι rfl)
