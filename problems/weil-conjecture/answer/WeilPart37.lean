              let e₁_hom : Quiver.Hom E₁.left W := E₁.hom
              let e₂_hom : Quiver.Hom E₂.left W := E₂.hom
              let g_l : Quiver.Hom E₁.left E₂.left := g.left
              let m₁ : Quiver.Hom (Limits.pullback e₁_hom h_W) (Limits.pullback e₂_hom h_W) :=
                ((B_hW.comp M_uPY).map g).left
              let m₂ : Quiver.Hom (Limits.pullback (e₁_hom ≫ w_X) j_X)
                  (Limits.pullback (e₂_hom ≫ w_X) j_X) :=
                ((M_wX.comp B_jX).map g).left
              let i₁ := (pbPaste E₁).isoPullback.hom
              let i₂ := (pbPaste E₂).isoPullback.hom
              change m₁ ≫ i₂ = i₁ ≫ m₂
              apply Limits.pullback.hom_ext
              · have hm₁_fst : m₁ ≫ Limits.pullback.fst e₂_hom h_W =
                    Limits.pullback.fst e₁_hom h_W ≫ g_l := Limits.pullback.lift_fst _ _ _
                have hm₂_fst : m₂ ≫ Limits.pullback.fst (e₂_hom ≫ w_X) j_X =
                    Limits.pullback.fst (e₁_hom ≫ w_X) j_X ≫ g_l := Limits.pullback.lift_fst _ _ _
                have hi₁_fst := (pbPaste E₁).isoPullback_hom_fst
                have hi₂_fst := (pbPaste E₂).isoPullback_hom_fst
                calc (m₁ ≫ i₂) ≫ Limits.pullback.fst (e₂_hom ≫ w_X) j_X
                    = m₁ ≫ (i₂ ≫ Limits.pullback.fst (e₂_hom ≫ w_X) j_X) := Category.assoc _ _ _
                  _ = m₁ ≫ Limits.pullback.fst e₂_hom h_W := congrArg (m₁ ≫ ·) hi₂_fst
                  _ = Limits.pullback.fst e₁_hom h_W ≫ g_l := hm₁_fst
                  _ = (i₁ ≫ Limits.pullback.fst (e₁_hom ≫ w_X) j_X) ≫ g_l := congrArg (· ≫ g_l) hi₁_fst.symm
                  _ = i₁ ≫ (Limits.pullback.fst (e₁_hom ≫ w_X) j_X ≫ g_l) := Category.assoc _ _ _
                  _ = i₁ ≫ (m₂ ≫ Limits.pullback.fst (e₂_hom ≫ w_X) j_X) := congrArg (i₁ ≫ ·) hm₂_fst.symm
                  _ = (i₁ ≫ m₂) ≫ Limits.pullback.fst (e₂_hom ≫ w_X) j_X := (Category.assoc _ _ _).symm
              · have hm₁_snd : m₁ ≫ Limits.pullback.snd e₂_hom h_W =
                    Limits.pullback.snd e₁_hom h_W := Limits.pullback.lift_snd _ _ _
                have hm₂_snd : m₂ ≫ Limits.pullback.snd (e₂_hom ≫ w_X) j_X =
                    Limits.pullback.snd (e₁_hom ≫ w_X) j_X := Limits.pullback.lift_snd _ _ _
                have hi₁_snd := (pbPaste E₁).isoPullback_hom_snd
                have hi₂_snd := (pbPaste E₂).isoPullback_hom_snd
                calc (m₁ ≫ i₂) ≫ Limits.pullback.snd (e₂_hom ≫ w_X) j_X
                    = m₁ ≫ (i₂ ≫ Limits.pullback.snd (e₂_hom ≫ w_X) j_X) := Category.assoc _ _ _
                  _ = m₁ ≫ (Limits.pullback.snd e₂_hom h_W ≫ u_PY) := congrArg (m₁ ≫ ·) hi₂_snd
                  _ = (m₁ ≫ Limits.pullback.snd e₂_hom h_W) ≫ u_PY := (Category.assoc _ _ _).symm
                  _ = Limits.pullback.snd e₁_hom h_W ≫ u_PY := congrArg (· ≫ u_PY) hm₁_snd
                  _ = i₁ ≫ Limits.pullback.snd (e₁_hom ≫ w_X) j_X := hi₁_snd.symm
                  _ = i₁ ≫ (m₂ ≫ Limits.pullback.snd (e₂_hom ≫ w_X) j_X) := congrArg (i₁ ≫ ·) hm₂_snd.symm
                  _ = (i₁ ≫ m₂) ≫ Limits.pullback.snd (e₂_hom ≫ w_X) j_X := (Category.assoc _ _ _).symm
            change FM_XU.obj.map ((M_wX.comp B_jX).map g).op ≫ FM_XU.obj.map (pasteIsoObj E₁).hom.op =
              FM_XU.obj.map (pasteIsoObj E₂).hom.op ≫ FM_XU.obj.map ((B_hW.comp M_uPY).map g).op
            rw [← FM_XU.obj.map_comp, ← FM_XU.obj.map_comp, ← op_comp, ← op_comp]
            exact congrArg (fun k => FM_XU.obj.map k.op) hcomm_XU.symm)
      let e_paste : shPull_wX.obj (P_push.obj FM_XU) ≅ pf_hW.obj (shPull_uPY.obj FM_XU) :=
        { hom := ObjectProperty.homMk e_paste_nat.hom
          inv := ObjectProperty.homMk e_paste_nat.inv
          hom_inv_id := Sheaf.hom_ext e_paste_nat.hom_inv_id
          inv_hom_id := Sheaf.hom_ext e_paste_nat.inv_hom_id }
      let η_tilde : weilEtaleTorsionSheaf W ℓ ⟶ pf_hW.obj (weilEtaleTorsionSheaf P_Y ℓ) :=
        δ_wX.hom ≫ shPull_wX.map η_M ≫ e_paste.hom ≫ pf_hW.map δ_uPY.inv
      have hη_tilde_eq : η_tilde = canonUnit h_W := by
        have hpre_eq : η_sh W ≫ η_tilde.hom = Functor.whiskerLeft B_hW.op (η_sh P_Y) := by
          ext E_op : 2
          obtain ⟨E'⟩ := E_op
          have h1 : (η_sh W).app (Opposite.op E') ≫ δ_wX.hom.hom.app (Opposite.op E') =
              (η_sh X).app (Opposite.op (M_wX.obj E')) :=
            NatTrans.congr_app hδ_wX (Opposite.op E')
          have h2 : (η_sh X).app (Opposite.op (M_wX.obj E')) ≫
              η_M.hom.app (Opposite.op (M_wX.obj E')) =
              (η_sh X_U).app (Opposite.op (B_jX.obj (M_wX.obj E'))) :=
            NatTrans.congr_app (hCanonUnit_unit j_X) (Opposite.op (M_wX.obj E'))
          have h3 := (η_sh X_U).naturality (pasteIsoObj E').hom.op
          dsimp [P_const] at h3
          rw [Category.id_comp] at h3
          let u_inv : (shPull_uPY.obj (weilEtaleTorsionSheaf X_U ℓ)).obj.obj (Opposite.op (B_hW.obj E')) ⟶
              (weilEtaleTorsionSheaf P_Y ℓ).obj.obj (Opposite.op (B_hW.obj E')) :=
            δ_uPY.inv.hom.app (Opposite.op (B_hW.obj E'))
          have hinv_id : δ_uPY.hom.hom.app (Opposite.op (B_hW.obj E')) ≫ u_inv = 𝟙 _ :=
            NatTrans.congr_app (congrArg (fun m => m.hom) δ_uPY.hom_inv_id)
              (Opposite.op (B_hW.obj E'))
          have h4' : (η_sh P_Y).app (Opposite.op (B_hW.obj E')) ≫
              δ_uPY.hom.hom.app (Opposite.op (B_hW.obj E')) =
              ((η_sh X_U).app (Opposite.op (M_uPY.obj (B_hW.obj E'))) :
                (P_const P_Y).obj (Opposite.op (B_hW.obj E')) ⟶
                  (shPull_uPY.obj (weilEtaleTorsionSheaf X_U ℓ)).obj.obj (Opposite.op (B_hW.obj E'))) :=
            NatTrans.congr_app hδ_uPY (Opposite.op (B_hW.obj E'))
          have h4_inv : (η_sh X_U).app (Opposite.op (M_uPY.obj (B_hW.obj E'))) ≫ u_inv =
              (η_sh P_Y).app (Opposite.op (B_hW.obj E')) :=
            (congrArg (fun m => m ≫ u_inv) h4'.symm).trans
              ((Category.assoc _ _ _).trans
                ((congrArg (fun m => (η_sh P_Y).app (Opposite.op (B_hW.obj E')) ≫ m) hinv_id).trans
                  (Category.comp_id _)))
          let tail₃ := δ_uPY.inv.hom.app (Opposite.op (B_hW.obj E'))
          let tail₂ := FM_XU.obj.map (pasteIsoObj E').hom.op ≫ tail₃
          let tail₁ := η_M.hom.app (Opposite.op (M_wX.obj E')) ≫ tail₂
          change (η_sh W).app (Opposite.op E') ≫ (δ_wX.hom.hom.app (Opposite.op E') ≫ tail₁) =
            (η_sh P_Y).app (Opposite.op (B_hW.obj E'))
          calc (η_sh W).app (Opposite.op E') ≫ (δ_wX.hom.hom.app (Opposite.op E') ≫ tail₁)
              = ((η_sh W).app (Opposite.op E') ≫ δ_wX.hom.hom.app (Opposite.op E')) ≫ tail₁ :=
                  (Category.assoc _ _ _).symm
            _ = (η_sh X).app (Opposite.op (M_wX.obj E')) ≫ tail₁ :=
                  congrArg (fun m => m ≫ tail₁) h1
            _ = ((η_sh X).app (Opposite.op (M_wX.obj E')) ≫
                  η_M.hom.app (Opposite.op (M_wX.obj E'))) ≫ tail₂ :=
                  (Category.assoc _ _ _).symm
            _ = (η_sh X_U).app (Opposite.op (B_jX.obj (M_wX.obj E'))) ≫ tail₂ :=
                  congrArg (fun m => m ≫ tail₂) h2
            _ = ((η_sh X_U).app (Opposite.op (B_jX.obj (M_wX.obj E'))) ≫
                  FM_XU.obj.map (pasteIsoObj E').hom.op) ≫ tail₃ :=
                  (Category.assoc _ _ _).symm
            _ = (η_sh X_U).app (Opposite.op (M_uPY.obj (B_hW.obj E'))) ≫ tail₃ :=
                  congrArg (fun m => m ≫ tail₃) h3.symm
            _ = (η_sh P_Y).app (Opposite.op (B_hW.obj E')) := h4_inv
        have hhom_tilde : ((sheafificationAdjunction W.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
            (P_const W) (pf_hW.obj (weilEtaleTorsionSheaf P_Y ℓ))) η_tilde =
            η_sh W ≫ η_tilde.hom := Adjunction.homEquiv_unit _ _ _ _
        exact ((sheafificationAdjunction W.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
          (P_const W) (pf_hW.obj (weilEtaleTorsionSheaf P_Y ℓ))).symm_apply_apply η_tilde ▸
          congrArg ((sheafificationAdjunction W.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
            (P_const W) (pf_hW.obj (weilEtaleTorsionSheaf P_Y ℓ))).symm (hhom_tilde.trans hpre_eq)
      have hBij_tilde : Function.Bijective ((η_tilde.hom.app (Opposite.op (T_id W))).hom) := by
        rw [hη_tilde_eq]; exact hBij_hW
      let iso_src : (weilEtaleTorsionSheaf W ℓ).obj.obj (Opposite.op (T_id W)) ≅
          FM_X.obj.obj (Opposite.op (M_wX.obj (T_id W))) :=
        (sheafToPresheaf W.smallEtaleTopology AddCommGrpCat.{u} ⋙
          (evaluation _ _).obj (Opposite.op (T_id W))).mapIso δ_wX
      let iso_tgt : (P_push.obj FM_XU).obj.obj (Opposite.op (M_wX.obj (T_id W))) ≅
          (pf_hW.obj (weilEtaleTorsionSheaf P_Y ℓ)).obj.obj (Opposite.op (T_id W)) :=
        (sheafToPresheaf W.smallEtaleTopology AddCommGrpCat.{u} ⋙
          (evaluation _ _).obj (Opposite.op (T_id W))).mapIso
          (e_paste ≪≫ pf_hW.mapIso δ_uPY.symm)
      have happ_TW : η_tilde.hom.app (Opposite.op (T_id W)) =
          iso_src.hom ≫ η_M.hom.app (Opposite.op (M_wX.obj (T_id W))) ≫ iso_tgt.hom := rfl
      have hBij_MW : Function.Bijective ((η_M.hom.app (Opposite.op (M_wX.obj (T_id W)))).hom) := by
        have h_eq_mw : (((η_M.hom.app (Opposite.op (M_wX.obj (T_id W)))).hom : _ → _) =
            iso_tgt.inv.hom ∘ (η_tilde.hom.app (Opposite.op (T_id W))).hom ∘ iso_src.inv.hom) := by
          funext x
          have hm : iso_src.inv ≫ η_tilde.hom.app (Opposite.op (T_id W)) ≫ iso_tgt.inv =
              η_M.hom.app (Opposite.op (M_wX.obj (T_id W))) := by
            rw [happ_TW]
            simp only [Category.assoc, iso_tgt.hom_inv_id, Category.comp_id, iso_src.inv_hom_id_assoc]
          exact ConcreteCategory.congr_hom hm.symm x
        change Function.Bijective (((η_M.hom.app (Opposite.op (M_wX.obj (T_id W)))).hom : _ → _))
        rw [h_eq_mw]
        exact (hIso_bij iso_tgt.symm).comp (hBij_tilde.comp (hIso_bij iso_src.symm))
      let σ_W : M_wX.obj (T_id W) ≅ W_et :=
        MorphismProperty.Over.isoMk (Iso.refl W) (Category.id_comp w_X)
      let iso_F_σ : FM_X.obj.obj (Opposite.op W_et) ≅
          FM_X.obj.obj (Opposite.op (M_wX.obj (T_id W))) :=
        FM_X.obj.mapIso σ_W.op
      let iso_P_σ : (P_push.obj FM_XU).obj.obj (Opposite.op W_et) ≅
          (P_push.obj FM_XU).obj.obj (Opposite.op (M_wX.obj (T_id W))) :=
        (P_push.obj FM_XU).obj.mapIso σ_W.op
      have hnat_σ : η_M.hom.app (Opposite.op W_et) ≫ iso_P_σ.hom =
          iso_F_σ.hom ≫ η_M.hom.app (Opposite.op (M_wX.obj (T_id W))) :=
        (η_M.hom.naturality σ_W.hom.op).symm
      have h_eq_wet : (((η_M.hom.app (Opposite.op W_et)).hom : _ → _) =
          iso_P_σ.inv.hom ∘ (η_M.hom.app (Opposite.op (M_wX.obj (T_id W)))).hom ∘ iso_F_σ.hom.hom) := by
        funext x
        have hm : η_M.hom.app (Opposite.op W_et) =
            iso_F_σ.hom ≫ η_M.hom.app (Opposite.op (M_wX.obj (T_id W))) ≫ iso_P_σ.inv := by
          rw [← Category.assoc, ← hnat_σ, Category.assoc, iso_P_σ.hom_inv_id, Category.comp_id]
        exact ConcreteCategory.congr_hom hm x
      change Function.Bijective (((η_M.hom.app (Opposite.op W_et)).hom : _ → _))
      rw [h_eq_wet]
      exact (hIso_bij iso_P_σ.symm).comp (hBij_MW.comp (hIso_bij iso_F_σ))

    have hCoverRef : ∀ E : X.Etale,
        ∃ (I : Type u) (W_f : I → X.Etale) (u_f : ∀ i : I, W_f i ⟶ E),
          Sieve.generate (Presieve.ofArrows W_f u_f) ∈ X.smallEtaleTopology E ∧
          ∀ i : I, Function.Bijective ((η_M.hom.app (Opposite.op (W_f i))).hom) := by
      intro E
      let e_hom : Quiver.Hom E.left X := E.hom
      have hex_pt : ∀ y : ↥E.left,
          ∃ (W_y : X.Etale) (u_y : W_y ⟶ E),
            Etale u_y.left ∧ y ∈ Set.range u_y.left.base ∧
            Function.Bijective ((η_M.hom.app (Opposite.op W_y)).hom) := by
        intro y
        obtain ⟨V, hxV, φ, hEt_φ, V_U, ι_VU, j_V, φ_U, hPb1, hPb2⟩ := hAtlas (e_hom.base y)
        let O'_y : E.left.Opens := (TopologicalSpace.Opens.map e_hom.base).obj V
        have hy_O' : y ∈ O'_y := hxV
        obtain ⟨O_y, hAff_Oy, hy_O, hSub_O⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hy_O'
        let _ : IsAffine O_y.toScheme := hAff_Oy
        have hOy_et : P_et O_y.ι := inferInstance
        let W_y : X.Etale := MorphismProperty.Over.mk ⊤ (O_y.ι ≫ e_hom)
          (MorphismProperty.comp_mem P_et _ _ hOy_et E.prop)
        let u_y : W_y ⟶ E := MorphismProperty.Over.homMk O_y.ι rfl trivial
        have hRange : Set.range (O_y.ι ≫ e_hom).base ⊆ Set.range V.ι.base := by
          rw [Scheme.Opens.range_ι]
          rintro _ ⟨z, rfl⟩
          have hz_Oy : O_y.ι.base z ∈ O_y := by
            have hr : O_y.ι.base z ∈ Set.range O_y.ι.base := ⟨z, rfl⟩
            rwa [Scheme.Opens.range_ι] at hr
          exact hSub_O hz_Oy
        let v_V : O_y.toScheme ⟶ V.toScheme := IsOpenImmersion.lift V.ι (O_y.ι ≫ e_hom) hRange
        have hv_fac : v_V ≫ V.ι = W_y.hom := IsOpenImmersion.lift_fac V.ι (O_y.ι ≫ e_hom) hRange
        have hBij_Wy := @hChartAffineBij W_y hAff_Oy V φ hEt_φ V_U ι_VU j_V φ_U hPb1 hPb2 v_V hv_fac
        exact ⟨W_y, u_y, hOy_et, ⟨⟨y, hy_O⟩, rfl⟩, hBij_Wy⟩
      refine ⟨↥E.left, fun y => (hex_pt y).choose, fun y => (hex_pt y).choose_spec.choose, ?_,
        fun y => (hex_pt y).choose_spec.choose_spec.2.2⟩
      have hTopX := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) X (le_refl P_et)
      refine Eq.mpr (congrArg (fun T => _ ∈ T E) hTopX) ?_
      refine (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) E _).mpr ?_
      intro y
      obtain ⟨hEt_y, ⟨z, hz⟩, _⟩ := (hex_pt y).choose_spec.choose_spec
      exact ⟨(hex_pt y).choose, (hex_pt y).choose_spec.choose, z,
        ⟨(hex_pt y).choose, 𝟙 _, (hex_pt y).choose_spec.choose, Presieve.ofArrows.mk y,
          Category.id_comp _⟩,
        hEt_y, hz⟩

    let homSecOf : ∀ {G : Sheaf X.smallEtaleTopology AddCommGrpCat.{u}} {E : X.Etale},
        ↥(G.obj.obj (Opposite.op E)) → (Aℤ ⟶ G.obj.obj (Opposite.op E)) :=
      fun {G E} sec => AddCommGrpCat.ofHom
        { toFun := fun n => n.down • sec
          map_zero' := zero_zsmul sec
          map_add' := fun a b => add_zsmul sec a.down b.down }

    have hGlobalInj : ∀ E : X.Etale, Function.Injective ((η_M.hom.app (Opposite.op E)).hom) := by
      intro E
      rw [injective_iff_map_eq_zero]
      intro s hs0
      obtain ⟨I, W_f, u_f, hCov, hBij_i⟩ := hCoverRef E
      let S_cov := Sieve.generate (Presieve.ofArrows W_f u_f)
      have hSep := (FM_X.property Aℤ S_cov hCov).isSeparatedFor
      have hEq0 : homSecOf (G := FM_X) s = (0 : Aℤ ⟶ FM_X.obj.obj (Opposite.op E)) := by
        refine hSep.ext (fun Z f hf => ?_)
        rcases hf with ⟨W₀, g, u₀, ⟨i⟩, rfl⟩
        have hnat_u := ConcreteCategory.congr_hom (η_M.hom.naturality (u_f i).op) s
        change (η_M.hom.app (Opposite.op (W_f i))).hom ((FM_X.obj.map (u_f i).op).hom s) =
          ((P_push.obj FM_XU).obj.map (u_f i).op).hom ((η_M.hom.app (Opposite.op E)).hom s) at hnat_u
        rw [hs0, map_zero] at hnat_u
        have hsi0 : (FM_X.obj.map (u_f i).op).hom s = 0 :=
          (hBij_i i).1 (hnat_u.trans (map_zero _).symm)
        change homSecOf (G := FM_X) s ≫ FM_X.obj.map (g ≫ u_f i).op =
          (0 : Aℤ ⟶ FM_X.obj.obj (Opposite.op E)) ≫ FM_X.obj.map (g ≫ u_f i).op
        rw [Limits.zero_comp]
        apply AddCommGrpCat.ext; intro ⟨n⟩
        change (FM_X.obj.map (g ≫ u_f i).op).hom (n • s) = 0
        rw [op_comp, FM_X.obj.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
          map_zsmul, hsi0, zsmul_zero, map_zero]
      have h1 := ConcreteCategory.congr_hom hEq0 (ULift.up (1 : ℤ))
      simpa [homSecOf] using h1

    have hGlobalSurj : ∀ E : X.Etale, Function.Surjective ((η_M.hom.app (Opposite.op E)).hom) := by
      intro E t
      obtain ⟨I, W_f, u_f, hCov, hBij_i⟩ := hCoverRef E
      let S_cov := Sieve.generate (Presieve.ofArrows W_f u_f)
      let s_i : ∀ i : I, ↥(FM_X.obj.obj (Opposite.op (W_f i))) :=
        fun i => ((hBij_i i).2 (((P_push.obj FM_XU).obj.map (u_f i).op).hom t)).choose
      have hs_i : ∀ i : I,
          (η_M.hom.app (Opposite.op (W_f i))).hom (s_i i) =
            ((P_push.obj FM_XU).obj.map (u_f i).op).hom t :=
        fun i => ((hBij_i i).2 (((P_push.obj FM_XU).obj.map (u_f i).op).hom t)).choose_spec
      have hUnpack : ∀ {Y₀ : X.Etale} (f : Y₀ ⟶ E), S_cov.arrows f →
          ∃ (i : I) (g : Y₀ ⟶ W_f i), g ≫ u_f i = f := by
        intro Y₀ f hf
        rcases hf with ⟨W₀, g, u₀, ⟨i⟩, hfac⟩
        exact ⟨i, g, hfac⟩
      let secFam : ∀ {Y₀ : X.Etale} (f : Y₀ ⟶ E), S_cov.arrows f →
          ↥(FM_X.obj.obj (Opposite.op Y₀)) :=
        fun {Y₀} f hf =>
          let i := (hUnpack f hf).choose
          let g := (hUnpack f hf).choose_spec.choose
          (FM_X.obj.map g.op).hom (s_i i)
      have hsecFam_map : ∀ {Y₀ : X.Etale} (f : Y₀ ⟶ E) (hf : S_cov.arrows f),
          (η_M.hom.app (Opposite.op Y₀)).hom (secFam f hf) =
            ((P_push.obj FM_XU).obj.map f.op).hom t := by
        intro Y₀ f hf
        set i := (hUnpack f hf).choose
        set g := (hUnpack f hf).choose_spec.choose
        have hg : g ≫ u_f i = f := (hUnpack f hf).choose_spec.choose_spec
        have hnat := ConcreteCategory.congr_hom (η_M.hom.naturality g.op) (s_i i)
        change (η_M.hom.app (Opposite.op Y₀)).hom ((FM_X.obj.map g.op).hom (s_i i)) =
          ((P_push.obj FM_XU).obj.map g.op).hom
            ((η_M.hom.app (Opposite.op (W_f i))).hom (s_i i)) at hnat
        have hfg : ((P_push.obj FM_XU).obj.map g.op).hom
            (((P_push.obj FM_XU).obj.map (u_f i).op).hom t) =
            ((P_push.obj FM_XU).obj.map f.op).hom t := by
          have hmap_eq : (P_push.obj FM_XU).obj.map f.op =
              (P_push.obj FM_XU).obj.map (u_f i).op ≫ (P_push.obj FM_XU).obj.map g.op := by
            rw [← (P_push.obj FM_XU).obj.map_comp, ← op_comp, hg]
          exact ConcreteCategory.congr_hom hmap_eq.symm t
        rw [hnat, hs_i i]
        exact hfg
      let fam : Presieve.FamilyOfElements (FM_X.obj ⋙ coyoneda.obj (Opposite.op Aℤ)) S_cov.arrows :=
        fun _ f hf => homSecOf (G := FM_X) (secFam f hf)
      have hCompat_fam : fam.Compatible := by
        intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
        have hEqZ : (FM_X.obj.map g₁.op).hom (secFam f₁ hf₁) =
            (FM_X.obj.map g₂.op).hom (secFam f₂ hf₂) := by
          apply hGlobalInj Z
          have hn₁ := ConcreteCategory.congr_hom (η_M.hom.naturality g₁.op) (secFam f₁ hf₁)
          have hn₂ := ConcreteCategory.congr_hom (η_M.hom.naturality g₂.op) (secFam f₂ hf₂)
          change (η_M.hom.app (Opposite.op Z)).hom ((FM_X.obj.map g₁.op).hom (secFam f₁ hf₁)) =
            ((P_push.obj FM_XU).obj.map g₁.op).hom
              ((η_M.hom.app (Opposite.op Y₁)).hom (secFam f₁ hf₁)) at hn₁
          change (η_M.hom.app (Opposite.op Z)).hom ((FM_X.obj.map g₂.op).hom (secFam f₂ hf₂)) =
            ((P_push.obj FM_XU).obj.map g₂.op).hom
              ((η_M.hom.app (Opposite.op Y₂)).hom (secFam f₂ hf₂)) at hn₂
          rw [hn₁, hn₂, hsecFam_map f₁ hf₁, hsecFam_map f₂ hf₂]
          have h12 : (g₁ ≫ f₁).op = (g₂ ≫ f₂).op := congrArg Opposite.op hcomm
          calc ((P_push.obj FM_XU).obj.map g₁.op).hom (((P_push.obj FM_XU).obj.map f₁.op).hom t)
              = ((P_push.obj FM_XU).obj.map (g₁ ≫ f₁).op).hom t := by
                  rw [op_comp, (P_push.obj FM_XU).obj.map_comp]; rfl
            _ = ((P_push.obj FM_XU).obj.map (g₂ ≫ f₂).op).hom t := by rw [h12]
            _ = ((P_push.obj FM_XU).obj.map g₂.op).hom (((P_push.obj FM_XU).obj.map f₂.op).hom t) := by
                  rw [op_comp, (P_push.obj FM_XU).obj.map_comp]; rfl
        apply AddCommGrpCat.ext; intro ⟨n⟩
        change (FM_X.obj.map g₁.op).hom (n • secFam f₁ hf₁) =
          (FM_X.obj.map g₂.op).hom (n • secFam f₂ hf₂)
        rw [map_zsmul, map_zsmul, hEqZ]
      have hSh_FX := FM_X.property Aℤ S_cov hCov
      let s_hom : Aℤ ⟶ FM_X.obj.obj (Opposite.op E) := hSh_FX.amalgamate fam hCompat_fam
      let s₀ : ↥(FM_X.obj.obj (Opposite.op E)) := s_hom.hom (ULift.up (1 : ℤ))
      refine ⟨s₀, ?_⟩
      have hSep_tgt := ((P_push.obj FM_XU).property Aℤ S_cov hCov).isSeparatedFor
      have hHomEq : homSecOf (G := P_push.obj FM_XU) ((η_M.hom.app (Opposite.op E)).hom s₀) =
          homSecOf (G := P_push.obj FM_XU) t := by
        refine hSep_tgt.ext (fun Y₀ f hf => ?_)
        have hgl_f := ConcreteCategory.congr_hom (hSh_FX.valid_glue hCompat_fam f hf) (ULift.up (1 : ℤ))
        change (FM_X.obj.map f.op).hom s₀ = (1 : ℤ) • secFam f hf at hgl_f
        rw [one_zsmul] at hgl_f
        have hnat_f := ConcreteCategory.congr_hom (η_M.hom.naturality f.op) s₀
        change (η_M.hom.app (Opposite.op Y₀)).hom ((FM_X.obj.map f.op).hom s₀) =
          ((P_push.obj FM_XU).obj.map f.op).hom ((η_M.hom.app (Opposite.op E)).hom s₀) at hnat_f
        rw [hgl_f, hsecFam_map f hf] at hnat_f
        apply AddCommGrpCat.ext; intro ⟨n⟩
        change ((P_push.obj FM_XU).obj.map f.op).hom (n • (η_M.hom.app (Opposite.op E)).hom s₀) =
          ((P_push.obj FM_XU).obj.map f.op).hom (n • t)
        rw [map_zsmul, map_zsmul, ← hnat_f]
      have h1 := ConcreteCategory.congr_hom hHomEq (ULift.up (1 : ℤ))
      simpa [homSecOf] using h1

    have _ : ∀ E_op : Opposite X.Etale, IsIso (η_M.hom.app E_op) := by
      intro E_op
      obtain ⟨E⟩ := E_op
      let e_E := AddEquiv.ofBijective ((η_M.hom.app (Opposite.op E)).hom)
        ⟨hGlobalInj E, hGlobalSurj E⟩
      exact ⟨⟨AddCommGrpCat.ofHom e_E.symm.toAddMonoidHom,
        AddCommGrpCat.ext e_E.symm_apply_apply,
        AddCommGrpCat.ext e_E.apply_symm_apply⟩⟩
    have _ : IsIso η_M.hom := NatIso.isIso_of_isIso_app η_M.hom
    let e_pre_η := asIso η_M.hom
    exact ⟨⟨ObjectProperty.homMk e_pre_η.inv,
      Sheaf.hom_ext e_pre_η.hom_inv_id,
      Sheaf.hom_ext e_pre_η.inv_hom_id⟩⟩

  rcases hψ_q with ⟨hc_jX, hr_jX, hAdd_jX, hLim_jX, hColim_jX,
    T_XU, hT_XU, T_X, hT_X, ιℤ, hι₁, hι₂, hψ_eq⟩
  let _ : (weilEtaleSitePullback j_X).IsContinuous X.smallEtaleTopology X_U.smallEtaleTopology := hc_jX
  let _ : ((weilEtaleSitePullback j_X).sheafPushforwardContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology X_U.smallEtaleTopology).IsRightAdjoint := hr_jX
  let pb_jX := (weilEtaleSitePullback j_X).sheafPullback AddCommGrpCat.{u}
    X.smallEtaleTopology X_U.smallEtaleTopology
  let adj_jX := (weilEtaleSitePullback j_X).sheafAdjunctionContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology X_U.smallEtaleTopology
  let _ : pb_jX.Additive := hAdd_jX
  let _ : Limits.PreservesFiniteLimits pb_jX := hLim_jX
  let _ : Limits.PreservesFiniteColimits pb_jX := hColim_jX
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let FM_X := weilEtaleTorsionSheaf X ℓ
  let FM_XU := weilEtaleTorsionSheaf X_U ℓ
  let πM := weilEtaleConstPullbackHom j_X hT_XU hT_X AM
  let η_M := (adj_jX.homEquiv FM_X FM_XU) πM
  have hIso_η : IsIso η_M := hUnitIso hT_XU hT_X
  have hBij_raw :=
    (weil_etale_bockstein_and_degenerate_leray_ext_calculus.{u}.2.2.1
      j_X hT_XU hT_X ιℤ hι₁ hι₂).1
      FM_X FM_XU η_M hIso_η hZero_X q
  let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let Fℤ_XU := (CategoryTheory.constantSheaf X_U.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let f_leray : weilEtaleTorsionH X ℓ q → weilEtaleTorsionH X_U ℓ q :=
    fun z =>
      (CategoryTheory.Abelian.Ext.mk₀ ((adj_jX.homEquiv FM_X FM_XU).symm η_M)).postcomp
        Fℤ_XU (Nat.add_zero q)
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((pb_jX.mapExtAddHom Fℤ_X FM_X q) z) (Nat.zero_add q))
  have hBij_f : Function.Bijective f_leray := hBij_raw
  have hfn_eq : (ψ_q : weilEtaleTorsionH X ℓ q → weilEtaleTorsionH X_U ℓ q) = f_leray := by
    funext z
    dsimp only [f_leray]
    rw [(adj_jX.homEquiv FM_X FM_XU).symm_apply_apply πM]
    exact hψ_eq z
  change Function.Bijective (ψ_q : weilEtaleTorsionH X ℓ q → weilEtaleTorsionH X_U ℓ q)
  rwa [hfn_eq]

theorem weil_odp_punct_sm_bockstein_prime_pow_pullback_bijective (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
    (hModPrime : ∀ (q : ℕ) (p₁ : weilEtaleTorsionH X₂ ℓ q →+ weilEtaleTorsionH X₁ ℓ q),
      WeilIsTorsionEtalePullback h ℓ q p₁ → Function.Bijective p₁)
    (r q : ℕ)
    (p : weilEtaleTorsionH X₂ (ℓ ^ (r + 1)) q →+ weilEtaleTorsionH X₁ (ℓ ^ (r + 1)) q)
    (hp : WeilIsTorsionEtalePullback h (ℓ ^ (r + 1)) q p) :
    Function.Bijective p :=
by
  
  have hZModSE : ∀ (n : ℕ),
      ∃ (u₀ : Quiver.Hom (AddCommGrpCat.of (ZMod (ℓ ^ n)))
            (AddCommGrpCat.of (ZMod (ℓ ^ (n + 1)))))
        (v₀ : Quiver.Hom (AddCommGrpCat.of (ZMod (ℓ ^ (n + 1))))
            (AddCommGrpCat.of (ZMod ℓ)))
        (huv₀ : CategoryTheory.CategoryStruct.comp u₀ v₀ = 0),
        (CategoryTheory.ShortComplex.mk u₀ v₀ huv₀).ShortExact := by
    intro n
    have hPrime : Nat.Prime ℓ := Fact.out
    have hℓ_pos : 0 < ℓ := hPrime.pos
    have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
    have : NeZero ℓ := ⟨hℓ_ne⟩
    have : NeZero (ℓ ^ n) := ⟨pow_ne_zero n hℓ_ne⟩
    have : NeZero (ℓ ^ (n + 1)) := ⟨pow_ne_zero (n + 1) hℓ_ne⟩
    let u_hom : ZMod (ℓ ^ n) →+ ZMod (ℓ ^ (n + 1)) :=
      { toFun := fun a => ((ℓ * a.val : ℕ) : ZMod (ℓ ^ (n + 1)))
        map_zero' := by simp
        map_add' := fun a b => by
          have hval : (a + b).val = (a.val + b.val) % (ℓ ^ n) := ZMod.val_add a b
          let q₀ := (a.val + b.val) / (ℓ ^ n)
          have hdiv : ℓ ^ n * q₀ + (a + b).val = a.val + b.val := by
            rw [hval]
            exact Nat.div_add_mod (a.val + b.val) (ℓ ^ n)
          have hmul : ℓ ^ (n + 1) * q₀ + ℓ * (a + b).val = ℓ * a.val + ℓ * b.val := by
            calc
              ℓ ^ (n + 1) * q₀ + ℓ * (a + b).val
                  = ℓ * (ℓ ^ n * q₀ + (a + b).val) := by rw [pow_succ']; ring
              _ = ℓ * (a.val + b.val) := by rw [hdiv]
              _ = ℓ * a.val + ℓ * b.val := Nat.mul_add ℓ a.val b.val
          have hcast := congrArg (fun m : ℕ => (m : ZMod (ℓ ^ (n + 1)))) hmul
          push_cast at hcast
          have hzero : ((ℓ ^ (n + 1) : ℕ) : ZMod (ℓ ^ (n + 1))) = 0 := CharP.cast_eq_zero _ _
          have hzero' : (ℓ : ZMod (ℓ ^ (n + 1))) ^ (n + 1) = 0 := by
            rw [← Nat.cast_pow]
            exact hzero
          rw [hzero', zero_mul, zero_add] at hcast
          push_cast
          exact hcast }
    let v_hom : ZMod (ℓ ^ (n + 1)) →+ ZMod ℓ :=
      (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero n)) (ZMod ℓ)).toAddMonoidHom
    let u₀ : Quiver.Hom (AddCommGrpCat.of (ZMod (ℓ ^ n)))
        (AddCommGrpCat.of (ZMod (ℓ ^ (n + 1)))) :=
      AddCommGrpCat.ofHom u_hom
    let v₀ : Quiver.Hom (AddCommGrpCat.of (ZMod (ℓ ^ (n + 1))))
        (AddCommGrpCat.of (ZMod ℓ)) :=
      AddCommGrpCat.ofHom v_hom
    have huv₀ : CategoryTheory.CategoryStruct.comp u₀ v₀ = 0 := by
      ext a
      change (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero n)) (ZMod ℓ))
        (((ℓ * a.val : ℕ) : ZMod (ℓ ^ (n + 1)))) = 0
      rw [map_natCast, Nat.cast_mul, CharP.cast_eq_zero, zero_mul]
    have hMono : CategoryTheory.Mono u₀ := by
      rw [AddCommGrpCat.mono_iff_injective]
      change Function.Injective u_hom
      rw [_root_.injective_iff_map_eq_zero]
      intro a ha
      have hlt : ℓ * a.val < ℓ ^ (n + 1) := by
        rw [pow_succ']
        exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt a) hℓ_pos
      have hval0 : ℓ * a.val = 0 := by
        have ha' : ((ℓ * a.val : ℕ) : ZMod (ℓ ^ (n + 1))) = 0 := ha
        have hv := congrArg ZMod.val ha'
        rwa [ZMod.val_natCast_of_lt hlt, ZMod.val_zero] at hv
      have ha_val : a.val = 0 := (mul_eq_zero.mp hval0).resolve_left hℓ_ne
      rw [← ZMod.natCast_zmod_val a, ha_val, Nat.cast_zero]
    have hEpi : CategoryTheory.Epi v₀ := by
      rw [AddCommGrpCat.epi_iff_surjective]
      intro c
      refine ⟨(c.val : ZMod (ℓ ^ (n + 1))), ?_⟩
      change (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero n)) (ZMod ℓ))
        (c.val : ZMod (ℓ ^ (n + 1))) = c
      rw [map_natCast, ZMod.natCast_zmod_val]
    have hExact : (CategoryTheory.ShortComplex.mk u₀ v₀ huv₀).Exact := by
      rw [CategoryTheory.ShortComplex.ab_exact_iff]
      intro b hb
      have hb_cast : ((b.val : ℕ) : ZMod ℓ) = 0 := by
        have hb' : (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero n)) (ZMod ℓ)) b = 0 := hb
        rw [← ZMod.natCast_zmod_val b, map_natCast] at hb'
        exact hb'
      obtain ⟨q₁, hq₁⟩ := (ZMod.natCast_eq_zero_iff b.val ℓ).mp hb_cast
      have hq₁_lt : q₁ < ℓ ^ n := by
        have hlt : ℓ * q₁ < ℓ * ℓ ^ n := by
          rw [← hq₁, ← pow_succ']
          exact ZMod.val_lt b
        exact Nat.lt_of_mul_lt_mul_left hlt
      refine ⟨(q₁ : ZMod (ℓ ^ n)), ?_⟩
      change ((ℓ * (q₁ : ZMod (ℓ ^ n)).val : ℕ) : ZMod (ℓ ^ (n + 1))) = b
      rw [ZMod.val_natCast_of_lt hq₁_lt, ← hq₁, ZMod.natCast_zmod_val]
    exact ⟨u₀, v₀, huv₀, CategoryTheory.ShortComplex.ShortExact.mk' hExact hMono hEpi⟩

  
  have hExtInj0 :
      ∀ {D : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} D]
        [CategoryTheory.Abelian D] [CategoryTheory.HasExt.{u} D]
        (U : D) {S : CategoryTheory.ShortComplex D} (hS : S.ShortExact)
        (a : CategoryTheory.Abelian.Ext U S.X₁ 0),
        ((CategoryTheory.Abelian.Ext.mk₀ S.f).postcomp U (Nat.add_zero 0)) a = 0 → a = 0 := by
    intro D _ _ _ U S hS a ha
    let f_a : Quiver.Hom U S.X₁ := CategoryTheory.Abelian.Ext.addEquiv₀ a
    have ha_mk : CategoryTheory.Abelian.Ext.mk₀ f_a = a :=
      CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply a
    have hcomp_mk : CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.comp f_a S.f) =
        CategoryTheory.Abelian.Ext.mk₀ (0 : Quiver.Hom U S.X₂) := by
      rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_zero, ha_mk]
      exact ha
    have hf_comp : CategoryTheory.CategoryStruct.comp f_a S.f =
        CategoryTheory.CategoryStruct.comp (0 : Quiver.Hom U S.X₁) S.f := by
      rw [CategoryTheory.Limits.zero_comp]
      exact (CategoryTheory.Abelian.Ext.mk₀_bijective U S.X₂).1 hcomp_mk
    have : CategoryTheory.Mono S.f := hS.mono_f
    have hf_zero : f_a = 0 := (cancel_mono S.f).mp hf_comp
    rw [← ha_mk, hf_zero, CategoryTheory.Abelian.Ext.mk₀_zero]

  have hExtEx2 :
      ∀ {D : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} D]
        [CategoryTheory.Abelian D] [CategoryTheory.HasExt.{u} D]
        (U : D) {S : CategoryTheory.ShortComplex D} (hS : S.ShortExact) (d : ℕ)
        (b : CategoryTheory.Abelian.Ext U S.X₂ d),
        ((CategoryTheory.Abelian.Ext.mk₀ S.g).postcomp U (Nat.add_zero d)) b = 0 ↔
          ∃ a : CategoryTheory.Abelian.Ext U S.X₁ d,
            ((CategoryTheory.Abelian.Ext.mk₀ S.f).postcomp U (Nat.add_zero d)) a = b := by
    intro D _ _ _ U S hS d b
    constructor
    · intro hb
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ U hS b hb
    · rintro ⟨a, rfl⟩
      change (a.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero d)).comp
        (CategoryTheory.Abelian.Ext.mk₀ S.g) (Nat.add_zero d) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero d) (Nat.add_zero 0)
        (Nat.add_zero d),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, S.zero,
        CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]

  have hExtEx3 :
      ∀ {D : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} D]
        [CategoryTheory.Abelian D] [CategoryTheory.HasExt.{u} D]
        (U : D) {S : CategoryTheory.ShortComplex D} (hS : S.ShortExact) (d : ℕ)
        (c : CategoryTheory.Abelian.Ext U S.X₃ d),
        (hS.extClass.postcomp U rfl) c = 0 ↔
          ∃ b : CategoryTheory.Abelian.Ext U S.X₂ d,
            ((CategoryTheory.Abelian.Ext.mk₀ S.g).postcomp U (Nat.add_zero d)) b = c := by
    intro D _ _ _ U S hS d c
    constructor
    · intro hc
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ U hS c rfl hc
    · rintro ⟨b, rfl⟩
      change (b.comp (CategoryTheory.Abelian.Ext.mk₀ S.g) (Nat.add_zero d)).comp
        hS.extClass rfl = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero d) (Nat.zero_add 1) rfl,
        hS.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]

  have hExtEx1 :
      ∀ {D : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} D]
        [CategoryTheory.Abelian D] [CategoryTheory.HasExt.{u} D]
        (U : D) {S : CategoryTheory.ShortComplex D} (hS : S.ShortExact) (d : ℕ)
        (a : CategoryTheory.Abelian.Ext U S.X₁ (d + 1)),
        ((CategoryTheory.Abelian.Ext.mk₀ S.f).postcomp U (Nat.add_zero (d + 1))) a = 0 ↔
          ∃ c : CategoryTheory.Abelian.Ext U S.X₃ d,
            (hS.extClass.postcomp U rfl) c = a := by
    intro D _ _ _ U S hS d a
    constructor
    · intro ha
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ U hS a ha rfl
    · rintro ⟨c, rfl⟩
      change (c.comp hS.extClass rfl).comp
        (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (d + 1)) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (rfl : d + 1 = d + 1) (Nat.add_zero 1)
        (Nat.add_zero (d + 1)),
        hS.extClass_comp, CategoryTheory.Abelian.Ext.comp_zero]

  have hExtFiveLemma :
      ∀ {D₁ D₂ : Type (u + 1)}
        [CategoryTheory.Category.{u + 1, u + 1} D₁] [CategoryTheory.Abelian D₁]
        [CategoryTheory.HasExt.{u} D₁]
        [CategoryTheory.Category.{u + 1, u + 1} D₂] [CategoryTheory.Abelian D₂]
        [CategoryTheory.HasExt.{u} D₂]
        (F : CategoryTheory.Functor D₂ D₁)
        [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
        [CategoryTheory.Limits.PreservesFiniteColimits F]
        (U₁ : D₁) (U₂ : D₂) (ιU : Quiver.Hom U₁ (F.obj U₂))
        {S₁ : CategoryTheory.ShortComplex D₁} (hS₁ : S₁.ShortExact)
        {S₂ : CategoryTheory.ShortComplex D₂} (hS₂ : S₂.ShortExact)
        (Ψ : (S₂.map F).Hom S₁),
        (∀ d : ℕ, Function.Bijective
          (((CategoryTheory.Abelian.Ext.mk₀ Ψ.τ₁).postcomp U₁ (Nat.add_zero d)).comp
            (((CategoryTheory.Abelian.Ext.mk₀ ιU).precomp (F.obj S₂.X₁) (Nat.zero_add d)).comp
              (F.mapExtAddHom U₂ S₂.X₁ d)))) →
        (∀ d : ℕ, Function.Bijective
          (((CategoryTheory.Abelian.Ext.mk₀ Ψ.τ₃).postcomp U₁ (Nat.add_zero d)).comp
            (((CategoryTheory.Abelian.Ext.mk₀ ιU).precomp (F.obj S₂.X₃) (Nat.zero_add d)).comp
              (F.mapExtAddHom U₂ S₂.X₃ d)))) →
        ∀ (k : ℕ), Function.Bijective
          (((CategoryTheory.Abelian.Ext.mk₀ Ψ.τ₂).postcomp U₁ (Nat.add_zero k)).comp
            (((CategoryTheory.Abelian.Ext.mk₀ ιU).precomp (F.obj S₂.X₂) (Nat.zero_add k)).comp
              (F.mapExtAddHom U₂ S₂.X₂ k))) := by
    intro D₁ D₂ _ _ _ _ _ _ F _ _ _ U₁ U₂ ιU S₁ hS₁ S₂ hS₂ Ψ hBij₁ hBij₃ k
    let Φ : ∀ {Y₂ : D₂} {Y₁ : D₁} (τ : Quiver.Hom (F.obj Y₂) Y₁) (d : ℕ),
        CategoryTheory.Abelian.Ext U₂ Y₂ d →+ CategoryTheory.Abelian.Ext U₁ Y₁ d :=
      fun {Y₂} {Y₁} τ d =>
        ((CategoryTheory.Abelian.Ext.mk₀ τ).postcomp U₁ (Nat.add_zero d)).comp
          (((CategoryTheory.Abelian.Ext.mk₀ ιU).precomp (F.obj Y₂) (Nat.zero_add d)).comp
            (F.mapExtAddHom U₂ Y₂ d))
    have hPhiNat : ∀ {Y₂ Y₂' : D₂} {Y₁ Y₁' : D₁}
        (g₂ : Quiver.Hom Y₂ Y₂') (g₁ : Quiver.Hom Y₁ Y₁')
        (τ : Quiver.Hom (F.obj Y₂) Y₁) (τ' : Quiver.Hom (F.obj Y₂') Y₁')
        (_ : CategoryTheory.CategoryStruct.comp τ g₁ =
          CategoryTheory.CategoryStruct.comp (F.map g₂) τ')
        (d : ℕ) (x : CategoryTheory.Abelian.Ext U₂ Y₂ d),
        Φ τ' d (((CategoryTheory.Abelian.Ext.mk₀ g₂).postcomp U₂ (Nat.add_zero d)) x) =
          ((CategoryTheory.Abelian.Ext.mk₀ g₁).postcomp U₁ (Nat.add_zero d)) (Φ τ d x) := by
      intro Y₂ Y₂' Y₁ Y₁' g₂ g₁ τ τ' hcomm d x
      let u := CategoryTheory.Abelian.Ext.mk₀ ιU
      let v := CategoryTheory.Abelian.Ext.mapExactFunctor F x
      let f₂_pull := CategoryTheory.Abelian.Ext.mk₀ (F.map g₂)
      let w' := CategoryTheory.Abelian.Ext.mk₀ τ'
      let w := CategoryTheory.Abelian.Ext.mk₀ τ
      let f₁ := CategoryTheory.Abelian.Ext.mk₀ g₁
      change (u.comp ((F.mapExtAddHom U₂ Y₂' d)
          (x.comp (CategoryTheory.Abelian.Ext.mk₀ g₂) (Nat.add_zero d)))
          (Nat.zero_add d)).comp w' (Nat.add_zero d) =
        ((u.comp ((F.mapExtAddHom U₂ Y₂ d) x)
          (Nat.zero_add d)).comp w (Nat.add_zero d)).comp f₁ (Nat.add_zero d)
      exact calc
        (u.comp ((F.mapExtAddHom U₂ Y₂' d)
            (x.comp (CategoryTheory.Abelian.Ext.mk₀ g₂) (Nat.add_zero d)))
            (Nat.zero_add d)).comp w' (Nat.add_zero d)
            = (u.comp (v.comp f₂_pull (Nat.add_zero d)) (Nat.zero_add d)).comp w'
                (Nat.add_zero d) := by
                dsimp only [v, f₂_pull]
                rw [CategoryTheory.Functor.mapExtAddHom_apply,
                  CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
                  CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
        _ = u.comp ((v.comp f₂_pull (Nat.add_zero d)).comp w' (Nat.add_zero d))
              (Nat.zero_add d) :=
              CategoryTheory.Abelian.Ext.comp_assoc u (v.comp f₂_pull (Nat.add_zero d)) w'
                (Nat.zero_add d) (Nat.add_zero d) (by omega : 0 + d + 0 = d)
        _ = u.comp (v.comp (f₂_pull.comp w' (Nat.add_zero 0)) (Nat.add_zero d))
              (Nat.zero_add d) :=
              congrArg (fun t => u.comp t (Nat.zero_add d))
                (CategoryTheory.Abelian.Ext.comp_assoc v f₂_pull w'
                  (Nat.add_zero d) (Nat.add_zero 0) (by omega : d + 0 + 0 = d))
        _ = u.comp (v.comp (w.comp f₁ (Nat.add_zero 0)) (Nat.add_zero d))
              (Nat.zero_add d) := by
              have hsq : f₂_pull.comp w' (Nat.add_zero 0) = w.comp f₁ (Nat.add_zero 0) := by
                dsimp only [f₂_pull, w', w, f₁]
                rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
                  CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hcomm]
              rw [hsq]
        _ = u.comp ((v.comp w (Nat.add_zero d)).comp f₁ (Nat.add_zero d))
              (Nat.zero_add d) :=
              congrArg (fun t => u.comp t (Nat.zero_add d))
                (CategoryTheory.Abelian.Ext.comp_assoc v w f₁
                  (Nat.add_zero d) (Nat.add_zero 0) (by omega : d + 0 + 0 = d)).symm
        _ = (u.comp (v.comp w (Nat.add_zero d)) (Nat.zero_add d)).comp f₁
              (Nat.add_zero d) :=
              (CategoryTheory.Abelian.Ext.comp_assoc u (v.comp w (Nat.add_zero d)) f₁
                (Nat.zero_add d) (Nat.add_zero d) (by omega : 0 + d + 0 = d)).symm
        _ = ((u.comp v (Nat.zero_add d)).comp w (Nat.add_zero d)).comp f₁
              (Nat.add_zero d) :=
              congrArg (fun t => t.comp f₁ (Nat.add_zero d))
                (CategoryTheory.Abelian.Ext.comp_assoc u v w
                  (Nat.zero_add d) (Nat.add_zero d) (by omega : 0 + d + 0 = d)).symm
        _ = ((u.comp ((F.mapExtAddHom U₂ Y₂ d) x)
              (Nat.zero_add d)).comp w (Nat.add_zero d)).comp f₁ (Nat.add_zero d) := by
                dsimp only [v]
                rw [CategoryTheory.Functor.mapExtAddHom_apply]
    have hDeltaNat : ∀ (d : ℕ) (c : CategoryTheory.Abelian.Ext U₂ S₂.X₃ d),
        Φ Ψ.τ₁ (d + 1) ((hS₂.extClass.postcomp U₂ rfl) c) =
          (hS₁.extClass.postcomp U₁ rfl) (Φ Ψ.τ₃ d c) := by
      intro d c
      have hS₂_F : (S₂.map F).ShortExact := hS₂.map_of_exact F
      let u := CategoryTheory.Abelian.Ext.mk₀ ιU
      let v := CategoryTheory.Abelian.Ext.mapExactFunctor F c
      let e₂ := hS₂_F.extClass
      let e₁ := hS₁.extClass
      let w₁ := CategoryTheory.Abelian.Ext.mk₀ Ψ.τ₁
      let w₃ := CategoryTheory.Abelian.Ext.mk₀ Ψ.τ₃
      have hExtNat : e₂.comp w₁ (Nat.add_zero 1) = w₃.comp e₁ (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS₂_F hS₁ Ψ
      change (u.comp ((F.mapExtAddHom U₂ S₂.X₁ (d + 1))
          (c.comp hS₂.extClass rfl)) (Nat.zero_add (d + 1))).comp w₁
          (Nat.add_zero (d + 1)) =
        ((u.comp ((F.mapExtAddHom U₂ S₂.X₃ d) c)
          (Nat.zero_add d)).comp w₃ (Nat.add_zero d)).comp e₁ rfl
      exact calc
        (u.comp ((F.mapExtAddHom U₂ S₂.X₁ (d + 1))
            (c.comp hS₂.extClass rfl)) (Nat.zero_add (d + 1))).comp w₁
            (Nat.add_zero (d + 1))
            = (u.comp (v.comp e₂ rfl) (Nat.zero_add (d + 1))).comp w₁
                (Nat.add_zero (d + 1)) := by
                dsimp only [v, e₂]
                rw [CategoryTheory.Functor.mapExtAddHom_apply,
                  CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
                  CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
        _ = u.comp ((v.comp e₂ rfl).comp w₁ (Nat.add_zero (d + 1))) (Nat.zero_add (d + 1)) :=
              CategoryTheory.Abelian.Ext.comp_assoc u (v.comp e₂ rfl) w₁
                (Nat.zero_add (d + 1)) (Nat.add_zero (d + 1))
                (by omega : 0 + (d + 1) + 0 = d + 1)
        _ = u.comp (v.comp (e₂.comp w₁ (Nat.add_zero 1)) rfl) (Nat.zero_add (d + 1)) :=
              congrArg (fun t => u.comp t (Nat.zero_add (d + 1)))
                (CategoryTheory.Abelian.Ext.comp_assoc v e₂ w₁
                  (rfl : d + 1 = d + 1) (Nat.add_zero 1) (by omega : d + 1 + 0 = d + 1))
        _ = u.comp (v.comp (w₃.comp e₁ (Nat.zero_add 1)) rfl) (Nat.zero_add (d + 1)) := by
              rw [hExtNat]
        _ = u.comp ((v.comp w₃ (Nat.add_zero d)).comp e₁ rfl) (Nat.zero_add (d + 1)) :=
              congrArg (fun t => u.comp t (Nat.zero_add (d + 1)))
                (CategoryTheory.Abelian.Ext.comp_assoc v w₃ e₁
                  (Nat.add_zero d) (Nat.zero_add 1) (by omega : d + 0 + 1 = d + 1)).symm
        _ = (u.comp (v.comp w₃ (Nat.add_zero d)) (Nat.zero_add d)).comp e₁ rfl :=
              (CategoryTheory.Abelian.Ext.comp_assoc u (v.comp w₃ (Nat.add_zero d)) e₁
                (Nat.zero_add d) (rfl : d + 1 = d + 1) (by omega : 0 + d + 1 = d + 1)).symm
        _ = ((u.comp v (Nat.zero_add d)).comp w₃ (Nat.add_zero d)).comp e₁ rfl :=
              congrArg (fun t => t.comp e₁ rfl)
                (CategoryTheory.Abelian.Ext.comp_assoc u v w₃
                  (Nat.zero_add d) (Nat.add_zero d) (by omega : 0 + d + 0 = d)).symm
        _ = ((u.comp ((F.mapExtAddHom U₂ S₂.X₃ d) c)
              (Nat.zero_add d)).comp w₃ (Nat.add_zero d)).comp e₁ rfl := by
                dsimp only [v]
                rw [CategoryTheory.Functor.mapExtAddHom_apply]
    have hBij₁' : ∀ d : ℕ, Function.Bijective (Φ Ψ.τ₁ d) := hBij₁
    have hBij₃' : ∀ d : ℕ, Function.Bijective (Φ Ψ.τ₃ d) := hBij₃
    let ι₁ : ∀ d : ℕ, CategoryTheory.Abelian.Ext U₁ S₁.X₁ d →+
        CategoryTheory.Abelian.Ext U₁ S₁.X₂ d :=
      fun d => (CategoryTheory.Abelian.Ext.mk₀ S₁.f).postcomp U₁ (Nat.add_zero d)
    let π₁ : ∀ d : ℕ, CategoryTheory.Abelian.Ext U₁ S₁.X₂ d →+
        CategoryTheory.Abelian.Ext U₁ S₁.X₃ d :=
      fun d => (CategoryTheory.Abelian.Ext.mk₀ S₁.g).postcomp U₁ (Nat.add_zero d)
    let δ₁ : ∀ d : ℕ, CategoryTheory.Abelian.Ext U₁ S₁.X₃ d →+
        CategoryTheory.Abelian.Ext U₁ S₁.X₁ (d + 1) :=
      fun d => hS₁.extClass.postcomp U₁ rfl
    let ι₂ : ∀ d : ℕ, CategoryTheory.Abelian.Ext U₂ S₂.X₁ d →+
        CategoryTheory.Abelian.Ext U₂ S₂.X₂ d :=
      fun d => (CategoryTheory.Abelian.Ext.mk₀ S₂.f).postcomp U₂ (Nat.add_zero d)
    let π₂ : ∀ d : ℕ, CategoryTheory.Abelian.Ext U₂ S₂.X₂ d →+
        CategoryTheory.Abelian.Ext U₂ S₂.X₃ d :=
      fun d => (CategoryTheory.Abelian.Ext.mk₀ S₂.g).postcomp U₂ (Nat.add_zero d)
    let δ₂ : ∀ d : ℕ, CategoryTheory.Abelian.Ext U₂ S₂.X₃ d →+
        CategoryTheory.Abelian.Ext U₂ S₂.X₁ (d + 1) :=
      fun d => hS₂.extClass.postcomp U₂ rfl
    have hInj₀_S₁ : ∀ a : CategoryTheory.Abelian.Ext U₁ S₁.X₁ 0, ι₁ 0 a = 0 → a = 0 :=
      hExtInj0 U₁ hS₁
    have hEx₂_S₁ : ∀ (d : ℕ) (b : CategoryTheory.Abelian.Ext U₁ S₁.X₂ d),
        π₁ d b = 0 ↔ ∃ a, ι₁ d a = b := hExtEx2 U₁ hS₁
    have hEx₂_S₂ : ∀ (d : ℕ) (b : CategoryTheory.Abelian.Ext U₂ S₂.X₂ d),
        π₂ d b = 0 ↔ ∃ a, ι₂ d a = b := hExtEx2 U₂ hS₂
    have hEx₃_S₁ : ∀ (d : ℕ) (c : CategoryTheory.Abelian.Ext U₁ S₁.X₃ d),
        δ₁ d c = 0 ↔ ∃ b, π₁ d b = c := hExtEx3 U₁ hS₁
    have hEx₃_S₂ : ∀ (d : ℕ) (c : CategoryTheory.Abelian.Ext U₂ S₂.X₃ d),
        δ₂ d c = 0 ↔ ∃ b, π₂ d b = c := hExtEx3 U₂ hS₂
    have hEx₁_S₁ : ∀ (d : ℕ) (a : CategoryTheory.Abelian.Ext U₁ S₁.X₁ (d + 1)),
        ι₁ (d + 1) a = 0 ↔ ∃ c, δ₁ d c = a := hExtEx1 U₁ hS₁
    have hEx₁_S₂ : ∀ (d : ℕ) (a : CategoryTheory.Abelian.Ext U₂ S₂.X₁ (d + 1)),
        ι₂ (d + 1) a = 0 ↔ ∃ c, δ₂ d c = a := hExtEx1 U₂ hS₂
    have hSq₁ : ∀ (d : ℕ) (x : CategoryTheory.Abelian.Ext U₂ S₂.X₁ d),
        Φ Ψ.τ₂ d (ι₂ d x) = ι₁ d (Φ Ψ.τ₁ d x) :=
      fun d x => hPhiNat S₂.f S₁.f Ψ.τ₁ Ψ.τ₂ Ψ.comm₁₂ d x
    have hSq₂ : ∀ (d : ℕ) (y : CategoryTheory.Abelian.Ext U₂ S₂.X₂ d),
        Φ Ψ.τ₃ d (π₂ d y) = π₁ d (Φ Ψ.τ₂ d y) :=
      fun d y => hPhiNat S₂.g S₁.g Ψ.τ₂ Ψ.τ₃ Ψ.comm₂₃ d y
    have hSq₃ : ∀ (d : ℕ) (c : CategoryTheory.Abelian.Ext U₂ S₂.X₃ d),
        Φ Ψ.τ₁ (d + 1) (δ₂ d c) = δ₁ d (Φ Ψ.τ₃ d c) := hDeltaNat
    change Function.Bijective (Φ Ψ.τ₂ k)
    refine ⟨?_, ?_⟩
    · rw [_root_.injective_iff_map_eq_zero]
      intro b₂ hb₂
      have hπ₂_zero : π₂ k b₂ = 0 := by
        apply (hBij₃' k).1
        rw [map_zero, hSq₂ k b₂, hb₂, map_zero]
      obtain ⟨a₂, rfl⟩ := (hEx₂_S₂ k b₂).mp hπ₂_zero
      have hι₁_zero : ι₁ k (Φ Ψ.τ₁ k a₂) = 0 := by
        rw [← hSq₁ k a₂, hb₂]
      cases k with
      | zero =>
        have hα₀_zero : Φ Ψ.τ₁ 0 a₂ = 0 := hInj₀_S₁ (Φ Ψ.τ₁ 0 a₂) hι₁_zero
        have ha₂_zero : a₂ = 0 := (hBij₁' 0).1 (hα₀_zero.trans (map_zero _).symm)
        rw [ha₂_zero, map_zero]
      | succ k' =>
        obtain ⟨c₁, hc₁⟩ := (hEx₁_S₁ k' (Φ Ψ.τ₁ (k' + 1) a₂)).mp hι₁_zero
        obtain ⟨c₂, hc₂⟩ := (hBij₃' k').2 c₁
        have hδ₂_eq : δ₂ k' c₂ = a₂ := by
          apply (hBij₁' (k' + 1)).1
          rw [hSq₃ k' c₂, hc₂, hc₁]
        rw [← hδ₂_eq]
        exact (hEx₁_S₂ k' (δ₂ k' c₂)).mpr ⟨c₂, rfl⟩
    · intro b₁
      obtain ⟨c₂, hc₂⟩ := (hBij₃' k).2 (π₁ k b₁)
      have hδ₂_zero : δ₂ k c₂ = 0 := by
        apply (hBij₁' (k + 1)).1
        rw [map_zero, hSq₃ k c₂, hc₂]
        exact (hEx₃_S₁ k (π₁ k b₁)).mpr ⟨b₁, rfl⟩
      obtain ⟨b₂', hb₂'⟩ := (hEx₃_S₂ k c₂).mp hδ₂_zero
      have hdiff_ker : π₁ k (b₁ - Φ Ψ.τ₂ k b₂') = 0 := by
        rw [map_sub, ← hSq₂ k b₂', hb₂', hc₂, sub_self]
      obtain ⟨a₁, ha₁⟩ := (hEx₂_S₁ k (b₁ - Φ Ψ.τ₂ k b₂')).mp hdiff_ker
      obtain ⟨a₂, ha₂⟩ := (hBij₁' k).2 a₁
      refine ⟨b₂' + ι₂ k a₂, ?_⟩
      rw [map_add, hSq₁ k a₂, ha₂, ha₁, add_sub_cancel]

  
  rcases hp with ⟨hCont, hRightAdj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, hπι, hp_eq⟩
  have : (weilEtaleSitePullback h).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology :=
    hCont
  have : ((weilEtaleSitePullback h).sheafPushforwardContinuous
      AddCommGrpCat.{u} X₂.smallEtaleTopology X₁.smallEtaleTopology).IsRightAdjoint :=
    hRightAdj
  let J₁ := X₁.smallEtaleTopology
  let J₂ := X₂.smallEtaleTopology
  let pb_h := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u} J₂ J₁
  have : pb_h.Additive := hAdd
  have : CategoryTheory.Limits.PreservesFiniteLimits pb_h := hLim
  have : CategoryTheory.Limits.PreservesFiniteColimits pb_h := hColim
  let U_lift := AddCommGrpCat.uliftFunctor.{u, 0}
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : ℕ → AddCommGrpCat.{u} := fun m₀ => U_lift.obj (AddCommGrpCat.of (ZMod m₀))
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  have hLim_C₁ : CategoryTheory.Limits.PreservesFiniteLimits C₁ :=
    CategoryTheory.Limits.comp_preservesFiniteLimits
      (CategoryTheory.Functor.const (Opposite X₁.Etale))
      (CategoryTheory.presheafToSheaf J₁ AddCommGrpCat.{u})
  have hLim_C₂ : CategoryTheory.Limits.PreservesFiniteLimits C₂ :=
    CategoryTheory.Limits.comp_preservesFiniteLimits
      (CategoryTheory.Functor.const (Opposite X₂.Etale))
      (CategoryTheory.presheafToSheaf J₂ AddCommGrpCat.{u})
  have hConstNat : ∀ {A A' : AddCommGrpCat.{u}} (φ : Quiver.Hom A A'),
      CategoryTheory.CategoryStruct.comp
        (pb_h.map (C₂.map φ))
        (weilEtaleConstPullbackHom h hT₁ hT₂ A') =
      CategoryTheory.CategoryStruct.comp
        (weilEtaleConstPullbackHom h hT₁ hT₂ A)
        (C₁.map φ) := by
    intro A A' φ
    dsimp only [weilEtaleConstPullbackHom]
    rw [← CategoryTheory.Adjunction.homEquiv_naturality_left_symm,
      ← CategoryTheory.Adjunction.homEquiv_naturality_right_symm]
    congr 1
    rw [← CategoryTheory.Adjunction.homEquiv_naturality_left_symm,
      ← CategoryTheory.Adjunction.homEquiv_naturality_right_symm]
    congr 1
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let τ : Quiver.Hom ((weilEtaleSitePullback h).obj T₂) T₁ :=
      hT₁.from ((weilEtaleSitePullback h).obj T₂)
    change CategoryTheory.CategoryStruct.comp φ
        (CategoryTheory.CategoryStruct.comp (adj₁.unit.app A')
          ((C₁.obj A').obj.map τ.op)) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (adj₁.unit.app A)
          ((C₁.obj A).obj.map τ.op))
        ((C₁.map φ).hom.app (Opposite.op ((weilEtaleSitePullback h).obj T₂)))
    have hnat₁ : CategoryTheory.CategoryStruct.comp φ (adj₁.unit.app A') =
        CategoryTheory.CategoryStruct.comp (adj₁.unit.app A)
          ((C₁.map φ).hom.app (Opposite.op T₁)) :=
      adj₁.unit.naturality φ
    rw [← CategoryTheory.Category.assoc, hnat₁, CategoryTheory.Category.assoc,
      CategoryTheory.Category.assoc]
    congr 1
    exact ((C₁.map φ).hom.naturality τ.op).symm

  let p_can : ∀ (m₀ k : ℕ), weilEtaleTorsionH X₂ m₀ k →+ weilEtaleTorsionH X₁ m₀ k :=
    fun m₀ k =>
      ((CategoryTheory.Abelian.Ext.mk₀
          (weilEtaleConstPullbackHom h hT₁ hT₂ (AM m₀))).postcomp
        (C₁.obj Aℤ) (Nat.add_zero k)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp
          (pb_h.obj (C₂.obj (AM m₀))) (Nat.zero_add k)).comp
          (pb_h.mapExtAddHom (C₂.obj Aℤ) (C₂.obj (AM m₀)) k))

  have hp_can_eq : p = p_can (ℓ ^ (r + 1)) q := AddMonoidHom.ext hp_eq

  have hModPrime_can : ∀ k : ℕ, Function.Bijective (p_can ℓ k) := by
    intro k
    refine hModPrime k (p_can ℓ k) ?_
    exact ⟨hCont, hRightAdj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, hπι, fun _ => rfl⟩

  have hAll : ∀ (s k : ℕ), Function.Bijective (p_can (ℓ ^ (s + 1)) k) := by
    intro s
    induction s with
    | zero =>
      intro k
      have h01 : ℓ ^ (0 + 1) = ℓ := pow_one ℓ
      exact Eq.ndrec (motive := fun m₀ => Function.Bijective (p_can m₀ k)) (hModPrime_can k)
        h01.symm
    | succ s ih =>
      obtain ⟨u₀, v₀, huv₀, hSE₀⟩ := hZModSE (s + 1)
      let S₀ : CategoryTheory.ShortComplex AddCommGrpCat.{0} :=
        CategoryTheory.ShortComplex.mk u₀ v₀ huv₀
      let S₁ : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}) :=
        (S₀.map U_lift).map C₁
      let S₂ : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}) :=
        (S₀.map U_lift).map C₂
      have hSE₁ : S₁.ShortExact := (hSE₀.map_of_exact U_lift).map_of_exact C₁
      have hSE₂ : S₂.ShortExact := (hSE₀.map_of_exact U_lift).map_of_exact C₂
      let Ψ : (S₂.map pb_h).Hom S₁ :=
        CategoryTheory.ShortComplex.Hom.mk
          (weilEtaleConstPullbackHom h hT₁ hT₂ (AM (ℓ ^ (s + 1))))
          (weilEtaleConstPullbackHom h hT₁ hT₂ (AM (ℓ ^ (s + 1 + 1))))
          (weilEtaleConstPullbackHom h hT₁ hT₂ (AM ℓ))
          (hConstNat (U_lift.map u₀)).symm
          (hConstNat (U_lift.map v₀)).symm
      intro k
      exact hExtFiveLemma pb_h (C₁.obj Aℤ) (C₂.obj Aℤ) ιℤ hSE₁ hSE₂ Ψ ih hModPrime_can k

  rw [hp_can_eq]
  exact hAll r q

theorem weil_sing_dev_odp_sq_punctured_smooth_fiber_vanish (k : Type u) [Field k] [IsAlgClosed k]
    (d_rel q_deg ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (P_base Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper P_base.hom]
    [AlgebraicGeometry.IsProper Z_bar.hom]
    (he_P : Nonempty (P_base ≅ weilProjectiveSpaceOver k 1))
    (f_bar : Z_bar ⟶ P_base)
    [AlgebraicGeometry.IsProper f_bar.left]
    (U_bar : P_base.left.Opens)
    (hU_ne : Nonempty ↥U_bar.toScheme)
    (hSm_U : AlgebraicGeometry.SmoothOfRelativeDimension d_rel (f_bar.left ∣_ U_bar))
    (s_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P_base.left)
    (hs_bar : s_bar ≫ P_base.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (x_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Z_bar.left)
    (hx_bar : x_bar ≫ f_bar.left = s_bar)
    (hSm_away : ∀ z : Z_bar.left,
      f_bar.left.base z ∈ Set.range s_bar.base → z ∉ Set.range x_bar.base →
      ∃ V : Z_bar.left.Opens, z ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension d_rel (V.ι ≫ f_bar.left))
    (W₀ : AlgebraicGeometry.Scheme.{u})
    (w₀ : W₀ ⟶ P_base.left)
    [AlgebraicGeometry.Etale w₀]
    (s_tilde : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W₀)
    (hs_tilde : s_tilde ≫ w₀ = s_bar)
    (α_W : weilEtaleTorsionH (CategoryTheory.Limits.pullback f_bar.left w₀) (ℓ ^ (r + 1)) q_deg)
    (hα_gen : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (η_W : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W₀),
      Set.range (η_W ≫ w₀).base ⊆ (U_bar : Set P_base.left) →
      ∀ (ι_η : CategoryTheory.Limits.pullback f_bar.left (η_W ≫ w₀) ⟶
          CategoryTheory.Limits.pullback f_bar.left w₀),
        ι_η ≫ CategoryTheory.Limits.pullback.fst f_bar.left w₀ =
          CategoryTheory.Limits.pullback.fst f_bar.left (η_W ≫ w₀) →
        ι_η ≫ CategoryTheory.Limits.pullback.snd f_bar.left w₀ =
          CategoryTheory.Limits.pullback.snd f_bar.left (η_W ≫ w₀) ≫ η_W →
        ∀ (p_η : weilEtaleTorsionH (CategoryTheory.Limits.pullback f_bar.left w₀)
            (ℓ ^ (r + 1)) q_deg →+
            weilEtaleTorsionH (CategoryTheory.Limits.pullback f_bar.left (η_W ≫ w₀))
              (ℓ ^ (r + 1)) q_deg),
          WeilIsTorsionEtalePullback ι_η (ℓ ^ (r + 1)) q_deg p_η →
          p_η α_W = 0)
    (U_sm : (CategoryTheory.Limits.pullback f_bar.left s_bar).Opens)
    (hDisj : ∀ y ∈ U_sm,
      (CategoryTheory.Limits.pullback.fst f_bar.left s_bar).base y ∉ Set.range x_bar.base)
    (ι_U : U_sm.toScheme ⟶ CategoryTheory.Limits.pullback f_bar.left w₀)
    (hι_U_fst : ι_U ≫ CategoryTheory.Limits.pullback.fst f_bar.left w₀ =
      U_sm.ι ≫ CategoryTheory.Limits.pullback.fst f_bar.left s_bar)
    (hι_U_snd : ι_U ≫ CategoryTheory.Limits.pullback.snd f_bar.left w₀ =
      U_sm.ι ≫ CategoryTheory.Limits.pullback.snd f_bar.left s_bar ≫ s_tilde)
    (p_U : weilEtaleTorsionH (CategoryTheory.Limits.pullback f_bar.left w₀)
        (ℓ ^ (r + 1)) q_deg →+
      weilEtaleTorsionH U_sm.toScheme (ℓ ^ (r + 1)) q_deg)
    (hp_U : WeilIsTorsionEtalePullback ι_U (ℓ ^ (r + 1)) q_deg p_U) :
    p_U α_W = 0 :=
by
  classical
  have _ := And.intro hSm_U hx_bar
  
  obtain ⟨e_P⟩ := he_P
  let P1 := weilProjectiveSpaceOver k 1
  let e_P_left : P_base.left ≅ P1.left := (CategoryTheory.Over.forget _).mapIso e_P
  obtain ⟨hInt_P1, -, -, -⟩ := weil_projectiveSpace_integral_krullDim_and_dim_zero_iso k 1
  have _ : AlgebraicGeometry.IsIntegral P1.left := hInt_P1
  have _ : IrreducibleSpace ↥P1.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral P1.left
  have hPre_Pbase : IsPreirreducible (Set.univ : Set ↥P_base.left) := by
    intro U V hU hV ⟨y₁, _, hy₁⟩ ⟨y₂, _, hy₂⟩
    have hx₁ : e_P_left.hom.base y₁ ∈ e_P_left.inv.base ⁻¹' U := by
      change (e_P_left.hom ≫ e_P_left.inv).base y₁ ∈ U
      rwa [e_P_left.hom_inv_id]
    have hx₂ : e_P_left.hom.base y₂ ∈ e_P_left.inv.base ⁻¹' V := by
      change (e_P_left.hom ≫ e_P_left.inv).base y₂ ∈ V
      rwa [e_P_left.hom_inv_id]
    obtain ⟨x₀, -, hxU, hxV⟩ := PreirreducibleSpace.isPreirreducible_univ
      (e_P_left.inv.base ⁻¹' U) (e_P_left.inv.base ⁻¹' V)
      (hU.preimage e_P_left.inv.continuous) (hV.preimage e_P_left.inv.continuous)
      ⟨e_P_left.hom.base y₁, trivial, hx₁⟩ ⟨e_P_left.hom.base y₂, trivial, hx₂⟩
    exact ⟨e_P_left.inv.base x₀, trivial, hxU, hxV⟩

  obtain ⟨-, ι_aff, hOpen_aff, ψ_s, hι_hom, hψ_fac⟩ :=
    weil_projSpace_standard_affine_chart_and_isSeparated k 1 k (s_bar ≫ e_P.hom.left)
  have _ : AlgebraicGeometry.IsOpenImmersion ι_aff := hOpen_aff
  have hψ_C : ∀ c : k, ψ_s (MvPolynomial.C c) = c := by
    have hSpec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_s.comp MvPolynomial.C)) =
        AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k)) := by
      calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_s.comp MvPolynomial.C))
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
              rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) ≫ ι_aff) ≫ P1.hom := by
              rw [← hι_hom, Category.assoc]
        _ = s_bar ≫ (e_P.hom.left ≫ P1.hom) := by rw [hψ_fac, Category.assoc]
        _ = s_bar ≫ P_base.hom := by rw [e_P.hom.w]
        _ = 𝟙 _ := hs_bar
        _ = AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k)) :=
              (AlgebraicGeometry.Spec.map_id _).symm
    have hHom := AlgebraicGeometry.Spec.map_injective hSpec
    intro c
    exact ConcreteCategory.congr_hom hHom c

  let U₀ := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
  let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U₀ :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))
  let e_alg : MvPolynomial (Fin 1) k ≃ₐ[k] Polynomial k := MvPolynomial.uniqueAlgEquiv k (Fin 1)
  let r₁ : MvPolynomial (Fin 1) k →+* Polynomial k := e_alg.toAlgHom.toRingHom
  let r₂ : Polynomial k →+* MvPolynomial (Fin 1) k := e_alg.symm.toAlgHom.toRingHom
  have hr₁₂ : r₁.comp r₂ = RingHom.id _ := RingHom.ext e_alg.apply_symm_apply
  have hr₂₁ : r₂.comp r₁ = RingHom.id _ := RingHom.ext e_alg.symm_apply_apply
  let f_iso : U₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) k)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom r₁)
  let g_iso : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) k)) ⟶ U₀ :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom r₂)
  have _ : CategoryTheory.IsIso f_iso :=
    ⟨⟨g_iso,
      by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hr₁₂,
           CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id],
      by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hr₂₁,
           CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]⟩⟩
  let φ_s : Polynomial k →+* k := ψ_s.comp r₂
  let a₀ : k := φ_s Polynomial.X
  have hφ_C : ∀ c : k, φ_s (Polynomial.C c) = c := by
    intro c
    change ψ_s (e_alg.symm (algebraMap k (Polynomial k) c)) = c
    rw [e_alg.symm.commutes c]
    exact hψ_C c
  let sh_pos : Polynomial k →+* Polynomial k :=
    (Polynomial.aeval (Polynomial.X + Polynomial.C a₀)).toRingHom
  let sh_neg : Polynomial k →+* Polynomial k :=
    (Polynomial.aeval (Polynomial.X - Polynomial.C a₀)).toRingHom
  have hsh₁ : sh_pos.comp sh_neg = RingHom.id (Polynomial k) := by
    apply Polynomial.ringHom_ext'
    · ext c; simp [sh_pos, sh_neg]
    · simp [sh_pos, sh_neg]
  have hsh₂ : sh_neg.comp sh_pos = RingHom.id (Polynomial k) := by
    apply Polynomial.ringHom_ext'
    · ext c; simp [sh_pos, sh_neg]
    · simp [sh_pos, sh_neg]
  let τ_a : U₀ ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom sh_pos)
  let τ_inv : U₀ ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom sh_neg)
  have _ : CategoryTheory.IsIso τ_a :=
    ⟨⟨τ_inv,
      by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hsh₁,
           CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id],
      by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hsh₂,
           CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]⟩⟩
  have hs₀_τ : s₀ ≫ τ_a = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_s) := by
    dsimp only [s₀, τ_a]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply Polynomial.ringHom_ext'
    · ext c
      change Polynomial.eval 0 (sh_pos (Polynomial.C c)) = φ_s (Polynomial.C c)
      simp [sh_pos, hφ_C c]
    · change Polynomial.eval 0 (sh_pos Polynomial.X) = φ_s Polynomial.X
      simp [sh_pos, a₀]
  let ι_chart : U₀ ⟶ P_base.left := τ_a ≫ f_iso ≫ ι_aff ≫ e_P_left.inv
  have _ : AlgebraicGeometry.IsOpenImmersion ι_chart := by
    dsimp only [ι_chart]
    infer_instance
  have hs₀_chart : s₀ ≫ ι_chart = s_bar := by
    dsimp only [ι_chart]
    rw [← Category.assoc s₀, hs₀_τ]
    have hgf : g_iso ≫ f_iso = 𝟙 _ := by
      dsimp only [g_iso, f_iso]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hr₂₁,
        CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    have hφ_gf : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_s) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) ≫ g_iso := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom r₂ ≫ CommRingCat.ofHom ψ_s) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom r₂)
      exact AlgebraicGeometry.Spec.map_comp _ _
    rw [hφ_gf, Category.assoc, ← Category.assoc g_iso, hgf, Category.id_comp,
      ← Category.assoc, hψ_fac, Category.assoc]
    change s_bar ≫ (e_P_left.hom ≫ e_P_left.inv) = s_bar
    rw [e_P_left.hom_inv_id, Category.comp_id]

  
  let Ω := AlgebraicClosure (FractionRing (Polynomial k))
  obtain ⟨R_bar, hCR_R, hDom_R, hLoc_R, p_R, t_bar, π_cl, φ_R_Ω,
    ℐ, hCat_I, hFilt_I, D, α, c, hc, e_pt,
    ⟨ht_eq, hπ_cl, hφ_comp, _, hLocAway⟩, ⟨hCocone, hStage⟩, hLiftTrait⟩ :=
    weil_odp_punct_sm_val_ring_colimit_and_pointed_etale_lift k ℓ
  let _ : CommRing R_bar := hCR_R
  let _ : IsDomain R_bar := hDom_R
  let _ : IsLocalRing R_bar := hLoc_R
  let _ : CategoryTheory.SmallCategory ℐ := hCat_I
  let _ : CategoryTheory.IsFiltered ℐ := hFilt_I

  let S_R := AlgebraicGeometry.Spec (CommRingCat.of R_bar)
  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  let g_R : S_R ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)
  let g_P : S_R ⟶ P_base.left := g_R ≫ ι_chart
  let i_cl : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ S_R :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl)
  let j_R : S_Ω ⟶ S_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)

  have hi_cl_gR : i_cl ≫ g_R = s₀ := by
    dsimp only [i_cl, g_R, s₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hπ_cl]
  have hi_cl_gP : i_cl ≫ g_P = s_bar := by
    dsimp only [g_P]
    rw [← Category.assoc, hi_cl_gR, hs₀_chart]

  obtain ⟨g_tilde, hg_tilde_w₀, hg_tilde_cl⟩ :=
    hLiftTrait w₀ g_P s_tilde (hs_tilde.trans hi_cl_gP.symm)

  let η_W : S_Ω ⟶ W₀ := j_R ≫ g_tilde
  let η₀ : S_Ω ⟶ U₀ :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k) Ω))
  have hη_w₀ : η_W ≫ w₀ = η₀ ≫ ι_chart := by
    dsimp only [η_W, η₀, j_R]
    rw [Category.assoc, hg_tilde_w₀]
    dsimp only [g_P, g_R]
    rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφ_comp]

  have hRange_ηW : Set.range (η_W ≫ w₀).base ⊆ (U_bar : Set P_base.left) := by
    obtain ⟨u_pt⟩ := hU_ne
    have hu_mem : U_bar.ι u_pt ∈ (U_bar : Set ↥P_base.left) := by
      have hr : U_bar.ι u_pt ∈ Set.range ⇑U_bar.ι := ⟨u_pt, rfl⟩
      rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at hr
    let pt₀ : PrimeSpectrum (Polynomial k) := ⊥
    have hOpenRange : IsOpen (Set.range ⇑ι_chart) := ι_chart.isOpenEmbedding.isOpen_range
    obtain ⟨_, -, hy_U, ⟨p_pt, rfl⟩⟩ :=
      hPre_Pbase (U_bar : Set ↥P_base.left) (Set.range ⇑ι_chart)
        U_bar.isOpen hOpenRange
        ⟨U_bar.ι u_pt, trivial, hu_mem⟩ ⟨ι_chart pt₀, trivial, ⟨pt₀, rfl⟩⟩
    let O_U : TopologicalSpace.Opens (PrimeSpectrum (Polynomial k)) :=
      (TopologicalSpace.Opens.map ι_chart.base).obj U_bar
    have hp_OU : p_pt ∈ O_U := hy_U
    have hspec : pt₀ ⤳ p_pt := (PrimeSpectrum.le_iff_specializes pt₀ p_pt).mp bot_le
    have hpt₀_U : ι_chart pt₀ ∈ (U_bar : Set ↥P_base.left) := hspec.mem_open O_U.isOpen hp_OU
    have hinj_PΩ : Function.Injective (algebraMap (Polynomial k) Ω) :=
      (IsScalarTower.algebraMap_eq (Polynomial k) (FractionRing (Polynomial k)) Ω) ▸
        ((RingHom.injective (algebraMap (FractionRing (Polynomial k)) Ω)).comp
          (IsFractionRing.injective (Polynomial k) (FractionRing (Polynomial k))))
    rintro _ ⟨pt_Ω, rfl⟩
    have hη₀_pt : η₀ pt_Ω = pt₀ := by
      have hsub : pt_Ω = (⊥ : PrimeSpectrum Ω) := Subsingleton.elim _ _
      rw [hsub]
      apply PrimeSpectrum.ext
      change Ideal.comap (algebraMap (Polynomial k) Ω) ⊥ = ⊥
      ext f
      rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.mem_bot]
      exact ⟨fun h0 => hinj_PΩ (h0.trans (map_zero _).symm), fun hf => by rw [hf, map_zero]⟩
    have hcomp_pt : (η_W ≫ w₀) pt_Ω = ι_chart (η₀ pt_Ω) := by
      rw [hη_w₀]
      rfl
    rw [hcomp_pt, hη₀_pt]
    exact hpt₀_U

  
  obtain ⟨hPur0, hPur2, hPur1⟩ :=
    weil_smooth_pencil_locConst_codim1_purity_and_kummer_zero k ℓ hℓ hPBC
      (fun δ m hm =>
        weil_smooth_pencil_locConst_affine_a1_higherDirectImage_isZero k ℓ hℓ hPBC δ m hm)
      d_rel
  obtain ⟨hBij0_A, hZero_A⟩ :=
    weil_odp_punct_sm_affine_val_ring_mod_prime_acyclic k d_rel ℓ hPur0 hPur2 hPur1
      R_bar p_R t_bar ht_eq Ω φ_R_Ω hLocAway ℐ D α c hc e_pt hCocone hStage

  let S_d := weilAffineSpaceOver k d_rel
  let g_k_R : S_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p_R.comp Polynomial.C))
  let A_R := CategoryTheory.Limits.pullback S_d.hom g_k_R
  let snd_AR := CategoryTheory.Limits.pullback.snd S_d.hom g_k_R
  let A_Ω := CategoryTheory.Limits.pullback j_R snd_AR
  let j_A : A_Ω ⟶ A_R := CategoryTheory.Limits.pullback.snd j_R snd_AR

  let S_sm : Set Z_bar.left.Opens :=
    { V : Z_bar.left.Opens | AlgebraicGeometry.SmoothOfRelativeDimension d_rel (V.ι ≫ f_bar.left) }
  let V_tot : Z_bar.left.Opens := sSup S_sm
  let f_tot : V_tot.toScheme ⟶ P_base.left := V_tot.ι ≫ f_bar.left
  let Z_R_open := CategoryTheory.Limits.pullback f_tot g_P
  let fst_tot := CategoryTheory.Limits.pullback.fst f_tot g_P
  let snd_tot := CategoryTheory.Limits.pullback.snd f_tot g_P
  let Z_R_Ω_open := CategoryTheory.Limits.pullback snd_tot j_R
  let j_X_open : Z_R_Ω_open ⟶ Z_R_open := CategoryTheory.Limits.pullback.fst snd_tot j_R
  let snd_Ω : Z_R_Ω_open ⟶ S_Ω := CategoryTheory.Limits.pullback.snd snd_tot j_R

  have hMvPush : ∀ (R₀ : Type u) [CommRing R₀] (c₀ : k →+* R₀),
      let g_k : CommRingCat.of k ⟶ CommRingCat.of R₀ := CommRingCat.ofHom c₀
      let inr_k : CommRingCat.of R₀ ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) R₀) :=
        CommRingCat.ofHom MvPolynomial.C
      ∃ (e_M : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin d_rel) R₀)) ≅
          CategoryTheory.Limits.pullback S_d.hom (AlgebraicGeometry.Spec.map g_k)),
        e_M.hom ≫ CategoryTheory.Limits.pullback.snd S_d.hom (AlgebraicGeometry.Spec.map g_k) =
          AlgebraicGeometry.Spec.map inr_k := by
    intro R₀ _ c₀ g_k inr_k
    let f_k : CommRingCat.of k ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) k) :=
      CommRingCat.ofHom MvPolynomial.C
    let inl_k : CommRingCat.of (MvPolynomial (Fin d_rel) k) ⟶
        CommRingCat.of (MvPolynomial (Fin d_rel) R₀) :=
      CommRingCat.ofHom (MvPolynomial.map c₀)
    have hcomm : f_k ≫ inl_k = g_k ≫ inr_k := by
      apply CommRingCat.hom_ext
      ext a
      simp [f_k, g_k, inl_k, inr_k]
    have hColim : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk inl_k inr_k hcomm) :=
      CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm
        (fun s => CommRingCat.ofHom
          (MvPolynomial.eval₂Hom s.inr.hom (fun i => s.inl.hom (MvPolynomial.X i))))
        (fun s => by
          apply CommRingCat.hom_ext
          apply MvPolynomial.ringHom_ext'
          · ext a
            simp only [inl_k, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
              MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
            exact (ConcreteCategory.congr_hom s.condition a).symm
          · intro i
            simp [inl_k])
        (fun s => by
          apply CommRingCat.hom_ext
          ext r₀
          simp [inr_k])
        (fun s m hm₁ hm₂ => by
          apply CommRingCat.hom_ext
          apply MvPolynomial.ringHom_ext'
          · ext r₀
            simpa [inr_k] using ConcreteCategory.congr_hom hm₂ r₀
          · intro i
            have h1 := ConcreteCategory.congr_hom hm₁ (MvPolynomial.X i)
            simpa [inl_k] using h1)
    have hPush : CategoryTheory.IsPushout f_k g_k inl_k inr_k :=
      CategoryTheory.IsPushout.of_isColimit hColim
    have hPb_std : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CategoryTheory.Limits.pushout.inl f_k g_k))
        (AlgebraicGeometry.Spec.map (CategoryTheory.Limits.pushout.inr f_k g_k))
        (AlgebraicGeometry.Spec.map f_k)
        (AlgebraicGeometry.Spec.map g_k) :=
      AlgebraicGeometry.isPullback_SpecMap_pushout f_k g_k
    let e_spec : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin d_rel) R₀)) ≅
        AlgebraicGeometry.Spec (CategoryTheory.Limits.pushout f_k g_k) :=
      { hom := AlgebraicGeometry.Spec.map hPush.isoPushout.inv
        inv := AlgebraicGeometry.Spec.map hPush.isoPushout.hom
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, hPush.isoPushout.hom_inv_id,
            AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, hPush.isoPushout.inv_hom_id,
            AlgebraicGeometry.Spec.map_id] }
    let e₂ := hPb_std.isoPullback
    have he₂_snd : (e_spec ≪≫ e₂).hom ≫
        CategoryTheory.Limits.pullback.snd (AlgebraicGeometry.Spec.map f_k)
          (AlgebraicGeometry.Spec.map g_k) =
        AlgebraicGeometry.Spec.map inr_k := by
      dsimp only [Iso.trans_hom, e_spec, e₂]
      rw [Category.assoc, CategoryTheory.IsPullback.isoPullback_hom_snd,
        ← AlgebraicGeometry.Spec.map_comp, hPush.inr_isoPushout_inv]
    exact ⟨e_spec ≪≫ e₂, he₂_snd⟩

  have hAtlas_ZR : ∀ x : ↥Z_R_open,
      ∃ (V_R : Z_R_open.Opens) (_ : x ∈ V_R)
        (φ_R : V_R.toScheme ⟶ A_R) (_ : AlgebraicGeometry.Etale φ_R)
        (V_U : AlgebraicGeometry.Scheme.{u})
        (ι_VU : V_U ⟶ Z_R_Ω_open) (j_V : V_U ⟶ V_R.toScheme) (φ_U : V_U ⟶ A_Ω),
        CategoryTheory.IsPullback ι_VU j_V j_X_open V_R.ι ∧
        CategoryTheory.IsPullback φ_U j_V j_A φ_R := by
    intro x
    have hx_tot : V_tot.ι (fst_tot x) ∈ V_tot := by
      have hr : V_tot.ι (fst_tot x) ∈ Set.range ⇑V_tot.ι := ⟨fst_tot x, rfl⟩
      rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at hr
    rw [TopologicalSpace.Opens.mem_sSup] at hx_tot
    obtain ⟨V₀ : Z_bar.left.Opens, hSm₀, hx_V₀⟩ := hx_tot
    let U_V₀ : V_tot.toScheme.Opens := (TopologicalSpace.Opens.map V_tot.ι.base).obj V₀
    have hRange1 : Set.range ⇑(U_V₀.ι ≫ V_tot.ι) ⊆ Set.range ⇑V₀.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      have hz' : U_V₀.ι z ∈ U_V₀ := by
        have hr : U_V₀.ι z ∈ Set.range ⇑U_V₀.ι := ⟨z, rfl⟩
        rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at hr
      exact hz'
    let e_U : U_V₀.toScheme ⟶ V₀.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift V₀.ι (U_V₀.ι ≫ V_tot.ι) hRange1
    have he_U : e_U ≫ V₀.ι = U_V₀.ι ≫ V_tot.ι :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac V₀.ι (U_V₀.ι ≫ V_tot.ι) hRange1
    have _ : AlgebraicGeometry.IsOpenImmersion e_U := inferInstance
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension d_rel (V₀.ι ≫ f_bar.left) := hSm₀
    have hSm_UV₀ : AlgebraicGeometry.SmoothOfRelativeDimension d_rel (U_V₀.ι ≫ f_tot) := by
      have h0 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + d_rel)
          (e_U ≫ (V₀.ι ≫ f_bar.left)) := inferInstance
      rwa [Nat.zero_add, ← Category.assoc, he_U, Category.assoc] at h0
    let W_x : Z_R_open.Opens := (TopologicalSpace.Opens.map fst_tot.base).obj U_V₀
    have hx_Wx : x ∈ W_x := hx_V₀
    have hPb_Wx : CategoryTheory.IsPullback
        (fst_tot ∣_ U_V₀) (W_x.ι ≫ snd_tot) (U_V₀.ι ≫ f_tot) g_P :=
      (AlgebraicGeometry.isPullback_morphismRestrict fst_tot U_V₀).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback f_tot g_P)
    have hSm_Wx : AlgebraicGeometry.SmoothOfRelativeDimension d_rel (W_x.ι ≫ snd_tot) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Wx hSm_UV₀
    obtain ⟨O_R, hAff_OR, O_W, hAff_OW, hx_OW, he_OW, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff d_rel (W_x.ι ≫ snd_tot)).mp
        hSm_Wx ⟨x, hx_Wx⟩
    let R_OR : CommRingCat.{u} := S_R.presheaf.obj (Opposite.op O_R)
    let R_OW : CommRingCat.{u} := W_x.toScheme.presheaf.obj (Opposite.op O_W)
    obtain ⟨γ : MvPolynomial (Fin d_rel) ↑R_OR →+* ↑R_OW, hγ_comp, hγ_et⟩ :=
      hStd.exists_etale_mvPolynomial
    let V_R : Z_R_open.Opens := W_x.ι.opensFunctor.obj O_W
    have hx_VR : x ∈ V_R := ⟨⟨x, hx_Wx⟩, hx_OW, rfl⟩
    have hRange_VR : Set.range ⇑V_R.ι = Set.range ⇑(O_W.ι ≫ W_x.ι) := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      ext y
      change y ∈ ⇑W_x.ι '' (O_W : Set ↥W_x.toScheme) ↔ y ∈ Set.range ⇑(O_W.ι ≫ W_x.ι)
      constructor
      · rintro ⟨w, hw, rfl⟩
        have hw_r : w ∈ Set.range ⇑O_W.ι := by
          rwa [AlgebraicGeometry.Scheme.Opens.range_ι]
        obtain ⟨z, rfl⟩ := hw_r
        exact ⟨z, rfl⟩
      · rintro ⟨z, rfl⟩
        have hz_OW : O_W.ι z ∈ O_W := by
          have hr : O_W.ι z ∈ Set.range ⇑O_W.ι := ⟨z, rfl⟩
          rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at hr
        exact ⟨O_W.ι z, hz_OW, rfl⟩
    let e_VR : V_R.toScheme ≅ O_W.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq V_R.ι (O_W.ι ≫ W_x.ι) hRange_VR
    have he_VR_fac : e_VR.hom ≫ O_W.ι ≫ W_x.ι = V_R.ι :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac V_R.ι (O_W.ι ≫ W_x.ι) hRange_VR
    have _ : CategoryTheory.IsIso O_W.toSpecΓ := by
      rw [← hAff_OW.isoSpec_hom]
      infer_instance
    let spec_γ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ)
    have _ : AlgebraicGeometry.Etale spec_γ :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hγ_et
    let φ₀ : V_R.toScheme ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin d_rel) ↑R_OR)) :=
      e_VR.hom ≫ O_W.toSpecΓ ≫ spec_γ
    have _ : AlgebraicGeometry.Etale φ₀ := by
      dsimp only [φ₀]
      infer_instance
    let m_snd :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (MvPolynomial.C : ↑R_OR →+* MvPolynomial (Fin d_rel) ↑R_OR))
    have hφ₀_comm : φ₀ ≫ m_snd ≫ hAff_OR.fromSpec = V_R.ι ≫ snd_tot := by
      have hγ_hom :
          CommRingCat.ofHom (MvPolynomial.C : ↑R_OR →+* MvPolynomial (Fin d_rel) ↑R_OR) ≫
            CommRingCat.ofHom γ = (W_x.ι ≫ snd_tot).appLE O_R O_W he_OW :=
        CommRingCat.hom_ext hγ_comp
      have hγ_map : spec_γ ≫ m_snd =
          AlgebraicGeometry.Spec.map ((W_x.ι ≫ snd_tot).appLE O_R O_W he_OW) :=
        (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
          (congrArg AlgebraicGeometry.Spec.map hγ_hom)
      have hOR_eq : O_R.toSpecΓ ≫ hAff_OR.fromSpec = O_R.ι := by
        rw [← hAff_OR.isoSpec_hom]
        exact hAff_OR.isoSpec_hom_fromSpec
      have hOW_comm : O_W.toSpecΓ ≫ spec_γ ≫ m_snd ≫ hAff_OR.fromSpec =
          O_W.ι ≫ W_x.ι ≫ snd_tot := by
        calc O_W.toSpecΓ ≫ spec_γ ≫ m_snd ≫ hAff_OR.fromSpec
            = (O_W.toSpecΓ ≫ (spec_γ ≫ m_snd)) ≫ hAff_OR.fromSpec := by
                simp only [Category.assoc]
          _ = ((W_x.ι ≫ snd_tot).resLE O_R O_W he_OW ≫ O_R.toSpecΓ) ≫ hAff_OR.fromSpec := by
                rw [hγ_map, AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE]
          _ = (W_x.ι ≫ snd_tot).resLE O_R O_W he_OW ≫ (O_R.toSpecΓ ≫ hAff_OR.fromSpec) := by
                simp only [Category.assoc]
          _ = O_W.ι ≫ W_x.ι ≫ snd_tot := by
                rw [hOR_eq, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
      calc (e_VR.hom ≫ O_W.toSpecΓ ≫ spec_γ) ≫ m_snd ≫ hAff_OR.fromSpec
          = e_VR.hom ≫ (O_W.toSpecΓ ≫ spec_γ ≫ m_snd ≫ hAff_OR.fromSpec) := by
              simp only [Category.assoc]
        _ = (e_VR.hom ≫ O_W.ι ≫ W_x.ι) ≫ snd_tot := by
              rw [hOW_comm]
              simp only [Category.assoc]
        _ = V_R.ι ≫ snd_tot := by rw [he_VR_fac]

    let c_O : CommRingCat.of k ⟶ R_OR :=
      AlgebraicGeometry.Spec.preimage (hAff_OR.fromSpec ≫ g_k_R)
    have hc_O_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_O.hom) =
        hAff_OR.fromSpec ≫ g_k_R :=
      AlgebraicGeometry.Spec.map_preimage (hAff_OR.fromSpec ≫ g_k_R)
    obtain ⟨e_MO₁, he_MO₁_snd⟩ := hMvPush ↑R_OR c_O.hom
    let e_congr :
        CategoryTheory.Limits.pullback S_d.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_O.hom)) ≅
        CategoryTheory.Limits.pullback S_d.hom (hAff_OR.fromSpec ≫ g_k_R) :=
      CategoryTheory.Limits.pullback.congrHom rfl hc_O_spec
    let e_MO₀ : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin d_rel) ↑R_OR)) ≅
        CategoryTheory.Limits.pullback S_d.hom (hAff_OR.fromSpec ≫ g_k_R) :=
      e_MO₁ ≪≫ e_congr
    have he_MO₀_snd : e_MO₀.hom ≫
        CategoryTheory.Limits.pullback.snd S_d.hom (hAff_OR.fromSpec ≫ g_k_R) = m_snd := by
      dsimp only [e_MO₀, Iso.trans_hom, e_congr]
      rw [Category.assoc, CategoryTheory.Limits.pullback.congrHom_hom,
        CategoryTheory.Limits.pullback.lift_snd, Category.comp_id]
      exact he_MO₁_snd
    let A_O := CategoryTheory.Limits.pullback snd_AR hAff_OR.fromSpec
    let ι_AO : A_O ⟶ A_R := CategoryTheory.Limits.pullback.fst snd_AR hAff_OR.fromSpec
    have _ : AlgebraicGeometry.IsOpenImmersion ι_AO := inferInstance
    have _ : AlgebraicGeometry.Etale ι_AO := inferInstance
    have hPb_AO_outer : CategoryTheory.IsPullback
        (ι_AO ≫ CategoryTheory.Limits.pullback.fst S_d.hom g_k_R)
        (CategoryTheory.Limits.pullback.snd snd_AR hAff_OR.fromSpec)
        S_d.hom (hAff_OR.fromSpec ≫ g_k_R) :=
      (CategoryTheory.IsPullback.of_hasPullback snd_AR hAff_OR.fromSpec).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback S_d.hom g_k_R)
    let e_AO : CategoryTheory.Limits.pullback S_d.hom (hAff_OR.fromSpec ≫ g_k_R) ≅ A_O :=
      hPb_AO_outer.isoPullback.symm
    let φ_R : V_R.toScheme ⟶ A_R := φ₀ ≫ e_MO₀.hom ≫ e_AO.hom ≫ ι_AO
    have hEt_φR : AlgebraicGeometry.Etale φ_R := by
      dsimp only [φ_R]
      infer_instance
    have hφR_snd : φ_R ≫ snd_AR = V_R.ι ≫ snd_tot := by
      calc (φ₀ ≫ e_MO₀.hom ≫ hPb_AO_outer.isoPullback.inv ≫ ι_AO) ≫ snd_AR
          = φ₀ ≫ e_MO₀.hom ≫ hPb_AO_outer.isoPullback.inv ≫
              (CategoryTheory.Limits.pullback.fst snd_AR hAff_OR.fromSpec ≫ snd_AR) := by
              dsimp only [ι_AO]
              simp only [Category.assoc]
        _ = φ₀ ≫ e_MO₀.hom ≫
              (hPb_AO_outer.isoPullback.inv ≫
                CategoryTheory.Limits.pullback.snd snd_AR hAff_OR.fromSpec) ≫
              hAff_OR.fromSpec := by
              rw [CategoryTheory.Limits.pullback.condition]
              simp only [Category.assoc]
        _ = φ₀ ≫ (e_MO₀.hom ≫
              CategoryTheory.Limits.pullback.snd S_d.hom (hAff_OR.fromSpec ≫ g_k_R)) ≫
              hAff_OR.fromSpec := by
              rw [CategoryTheory.IsPullback.isoPullback_inv_snd]
              simp only [Category.assoc]
        _ = φ₀ ≫ m_snd ≫ hAff_OR.fromSpec := by rw [he_MO₀_snd]
        _ = V_R.ι ≫ snd_tot := hφ₀_comm
    let V_U := CategoryTheory.Limits.pullback (V_R.ι ≫ snd_tot) j_R
    let j_V : V_U ⟶ V_R.toScheme := CategoryTheory.Limits.pullback.fst (V_R.ι ≫ snd_tot) j_R
    let p_VU_Ω : V_U ⟶ S_Ω := CategoryTheory.Limits.pullback.snd (V_R.ι ≫ snd_tot) j_R
    let ι_VU : V_U ⟶ Z_R_Ω_open :=
      CategoryTheory.Limits.pullback.lift (j_V ≫ V_R.ι) p_VU_Ω
        (by rw [Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
    let φ_U : V_U ⟶ A_Ω :=
      CategoryTheory.Limits.pullback.lift p_VU_Ω (j_V ≫ φ_R)
        (by rw [Category.assoc, hφR_snd, ← Category.assoc];
            exact CategoryTheory.Limits.pullback.condition.symm)
    have hPb1 : CategoryTheory.IsPullback ι_VU j_V j_X_open V_R.ι := by
      refine CategoryTheory.IsPullback.of_right
        (h₁₂ := snd_Ω) (h₂₂ := snd_tot) (v₁₃ := j_R) ?_
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback snd_tot j_R).flip
      dsimp only [ι_VU]
      rw [CategoryTheory.Limits.pullback.lift_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback (V_R.ι ≫ snd_tot) j_R).flip
    have hPb2 : CategoryTheory.IsPullback φ_U j_V j_A φ_R := by
      refine CategoryTheory.IsPullback.of_right
        (h₁₂ := CategoryTheory.Limits.pullback.fst j_R snd_AR) (h₂₂ := snd_AR) (v₁₃ := j_R) ?_
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback j_R snd_AR)
      dsimp only [φ_U]
      rw [CategoryTheory.Limits.pullback.lift_fst, hφR_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback (V_R.ι ≫ snd_tot) j_R).flip
    exact ⟨V_R, hx_VR, φ_R, hEt_φR, V_U, ι_VU, j_V, φ_U, hPb1, hPb2⟩

  have hModPrime_jX : ∀ (q : ℕ)
      (p₁ : weilEtaleTorsionH Z_R_open ℓ q →+ weilEtaleTorsionH Z_R_Ω_open ℓ q),
      WeilIsTorsionEtalePullback j_X_open ℓ q p₁ → Function.Bijective p₁ :=
    fun q p₁ hp₁ =>
      weil_odp_punct_sm_etale_atlas_mod_prime_pullback_bijective ℓ j_A j_X_open
        hBij0_A hZero_A hAtlas_ZR q p₁ hp₁

  
  obtain ⟨hPullEx, -, hPullComp, -, -⟩ := weil_etale_torsion_pullback_functoriality.{u}
  let n_mod := ℓ ^ (r + 1)

  let μ_R : Z_R_open ⟶ CategoryTheory.Limits.pullback f_bar.left w₀ :=
    CategoryTheory.Limits.pullback.lift (fst_tot ≫ V_tot.ι) (snd_tot ≫ g_tilde)
