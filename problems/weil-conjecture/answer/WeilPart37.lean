        rw [← CategoryTheory.Category.assoc, hStep1, CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (MvPolynomial.X b) (hX b) zero_lt_one,
          CategoryTheory.Iso.hom_inv_id_assoc,
          AlgebraicGeometry.morphismRestrict_ι]
      have hEqMor : awaySec ≫ f_Q.appLE (D b) (W' b) le_rfl = CommRingCat.ofHom β_b := by
        rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE f_Q]
        rfl
      rw [hEqMor] at hStep2
      exact ⟨hAff_Wb, hβ_surj, hβ_ker, hStep2⟩

    refine ⟨?_, ?_, ?_, ?_⟩
    · 
      change (⨆ b : Fin (2 * n₀ + 1 + 1), W' b) = ⊤
      rw [eq_top_iff]
      intro q _
      have hq : f_Q.base q ∈ (⨆ b : Fin (2 * n₀ + 1 + 1), D b) := by rw [hSupD]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hq ⊢
      exact hq

    · 
      intro b
      change ∃ e_Wb : (W' b).toScheme ≅
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (2 * n₀)) K)),
        e_Wb.hom ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin (2 * n₀)) K)) =
          (W' b).ι ≫ Q.hom
      obtain ⟨hAff_Wb, hβ_surj, hβ_ker, hStep2⟩ := hChartBase b
      let awaySec := AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X b)
      let β_b : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X b) →+*
          ↑(Q.left.presheaf.obj (Opposite.op (W' b))) :=
        ((f_Q.app (D b)).hom).comp awaySec.hom
      let P_odd := MvPolynomial (Fin (2 * n₀ + 1)) K
      let S₀ := MvPolynomial (Fin (2 * n₀)) K

      
      let ev_b : A →+* P_odd :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => P_odd) b 1 MvPolynomial.X)
      have hev_Xb : ev_b (MvPolynomial.X b) = 1 := by
        dsimp [ev_b]
        rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same]
      have hev_succ : ∀ i : Fin (2 * n₀ + 1),
          ev_b (MvPolynomial.X (b.succAbove i)) = MvPolynomial.X i := by
        intro i
        dsimp [ev_b]
        rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]
      have hu_ev : IsUnit (ev_b (MvPolynomial.X b)) := by
        rw [hev_Xb]
        exact isUnit_one
      let lift_b : Localization (Submonoid.powers (MvPolynomial.X b : A)) →+* P_odd :=
        IsLocalization.Away.lift (MvPolynomial.X b) hu_ev
      let val_b : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X b) →+*
          Localization (Submonoid.powers (MvPolynomial.X b : A)) :=
        algebraMap _ _
      let φ_b : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X b) →+* P_odd :=
        lift_b.comp val_b
      let c_b : K →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X b) :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜
          (Submonoid.powers (MvPolynomial.X b : A))).comp (algebraMap K ↥(𝒜 0))
      let t_b : Fin (2 * n₀ + 1) → HomogeneousLocalization.Away 𝒜 (MvPolynomial.X b) :=
        fun i => HomogeneousLocalization.Away.mk 𝒜 (hX b) 1
          (MvPolynomial.X (b.succAbove i)) (hX_smul1 (b.succAbove i))
      let ψ_b : P_odd →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X b) :=
        MvPolynomial.eval₂Hom c_b t_b

      have hval_c : ∀ c : K,
          val_b (c_b c) =
            algebraMap A (Localization (Submonoid.powers (MvPolynomial.X b : A)))
              (MvPolynomial.C c) := by
        intro c
        rw [HomogeneousLocalization.algebraMap_apply]
        dsimp [c_b]
        have hfz : (HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X b : A)) (algebraMap K ↥(𝒜 0) c)).val =
          algebraMap A (Localization (Submonoid.powers (MvPolynomial.X b : A)))
            (algebraMap K ↥(𝒜 0) c).1 := rfl
        rw [hfz, halg0_val]

      have hφ_mk : ∀ (n : ℕ) (a : A) (ha : a ∈ 𝒜 (n • 1)),
          φ_b (HomogeneousLocalization.Away.mk 𝒜 (hX b) n a ha) = ev_b a := by
        intro n a ha
        change lift_b (HomogeneousLocalization.val
          (HomogeneousLocalization.Away.mk 𝒜 (hX b) n a ha)) = ev_b a
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
        dsimp [lift_b, IsLocalization.Away.lift]
        rw [IsLocalization.lift_mk'_spec]
        change ev_b a = ev_b (MvPolynomial.X b ^ n) * ev_b a
        rw [map_pow, hev_Xb, one_pow, one_mul]

      have hφψ : φ_b.comp ψ_b = RingHom.id P_odd := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          simp only [RingHom.comp_apply, ψ_b, MvPolynomial.eval₂Hom_C]
          change lift_b (val_b (c_b c)) = MvPolynomial.C c
          rw [hval_c, IsLocalization.Away.lift_eq]
          dsimp [ev_b]
          exact MvPolynomial.eval₂Hom_C _ _ _
        · intro i
          simp only [RingHom.comp_apply, ψ_b, MvPolynomial.eval₂Hom_X']
          rw [hφ_mk 1 (MvPolynomial.X (b.succAbove i)) (hX_smul1 (b.succAbove i)), hev_succ i]
          rfl

      have hψφ : ψ_b.comp φ_b =
          RingHom.id (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X b)) := by
        apply RingHom.ext
        intro z
        rw [RingHom.comp_apply, RingHom.id_apply]
        obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX b) z
        rw [hφ_mk n a ha, HomogeneousLocalization.ext_iff_val]
        let L_b := Localization (Submonoid.powers (MvPolynomial.X b : A))
        let u_b : L_b := algebraMap A L_b (MvPolynomial.X b)
        have hu_b : IsUnit (u_b ^ n) :=
          (IsLocalization.Away.algebraMap_isUnit (MvPolynomial.X b)).pow n
        apply hu_b.mul_left_cancel
        have hrhs : u_b ^ n * (HomogeneousLocalization.Away.mk 𝒜 (hX b) n a ha).val =
            algebraMap A L_b a := by
          rw [mul_comm, HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
          let s_n : Submonoid.powers (MvPolynomial.X b : A) :=
            ⟨MvPolynomial.X b ^ n, (Submonoid.powers (MvPolynomial.X b : A)).pow_mem
              (Submonoid.mem_powers _) n⟩
          have hpow : u_b ^ n = algebraMap A L_b s_n.1 := (map_pow _ _ n).symm
          rw [hpow]
          exact IsLocalization.mk'_spec L_b a s_n
        have ht_mul : ∀ i : Fin (2 * n₀ + 1),
            u_b * val_b (t_b i) = algebraMap A L_b (MvPolynomial.X (b.succAbove i)) := by
          intro i
          rw [mul_comm, HomogeneousLocalization.algebraMap_apply]
          dsimp [t_b]
          rw [Localization.mk_eq_mk']
          let s_1 : Submonoid.powers (MvPolynomial.X b : A) :=
            ⟨MvPolynomial.X b ^ 1, (Submonoid.powers (MvPolynomial.X b : A)).pow_mem
              (Submonoid.mem_powers _) 1⟩
          have h1 : u_b = algebraMap A L_b s_1.1 := by
            dsimp [u_b, s_1]
            rw [pow_one]
          rw [h1]
          exact IsLocalization.mk'_spec L_b (MvPolynomial.X (b.succAbove i)) s_1
        have hlhs : u_b ^ n * (ψ_b (ev_b a)).val = algebraMap A L_b a := by
          rw [← HomogeneousLocalization.algebraMap_apply]
          change u_b ^ n * val_b (ψ_b (ev_b a)) = algebraMap A L_b a
          have ha_hom : MvPolynomial.IsHomogeneous a n := by
            have ha' : a ∈ 𝒜 n := by simpa using ha
            exact (MvPolynomial.mem_homogeneousSubmodule n a).mp ha'
          conv_lhs => rw [MvPolynomial.as_sum a]
          conv_rhs => rw [MvPolynomial.as_sum a]
          rw [map_sum, map_sum, map_sum, Finset.mul_sum, map_sum]
          refine Finset.sum_congr rfl fun v hv => ?_
          have hv_ne := MvPolynomial.mem_support_iff.mp hv
          have hv_deg : v b + ∑ i : Fin (2 * n₀ + 1), v (b.succAbove i) = n := by
            have hdeg := ha_hom hv_ne
            dsimp [Finsupp.weight, LinearMap.toAddMonoidHom] at hdeg
            have hsum : (Finsupp.linearCombination ℕ (1 : Fin (2 * n₀ + 1 + 1) → ℕ) v) =
                ∑ k : Fin (2 * n₀ + 1 + 1), v k := by
              rw [Finsupp.linearCombination_apply, Finsupp.sum_fintype]
              · simp
              · intro; simp
            rw [hsum, Fin.sum_univ_succAbove v b] at hdeg
            exact hdeg
          have hmon : ∀ c : K, MvPolynomial.monomial v c =
              MvPolynomial.C c * MvPolynomial.X b ^ v b *
                ∏ i : Fin (2 * n₀ + 1),
                  MvPolynomial.X (b.succAbove i) ^ v (b.succAbove i) := by
            intro c
            rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype]
            · rw [Fin.prod_univ_succAbove _ b, ← mul_assoc]
            · intro
              exact pow_zero _
          rw [hmon (a.coeff v), ev_b.map_mul, ev_b.map_mul, ev_b.map_pow, hev_Xb,
            one_pow, mul_one, map_prod]
          have hev_C : ev_b (MvPolynomial.C (a.coeff v)) = MvPolynomial.C (a.coeff v) :=
            MvPolynomial.eval₂Hom_C _ _ _
          have hev_prod :
              (∏ i : Fin (2 * n₀ + 1),
                ev_b (MvPolynomial.X (b.succAbove i) ^ v (b.succAbove i))) =
              ∏ i : Fin (2 * n₀ + 1), MvPolynomial.X i ^ v (b.succAbove i) := by
            refine Finset.prod_congr rfl fun i _ => ?_
            rw [map_pow, hev_succ i]
          rw [hev_C, hev_prod, map_mul, map_prod]
          have hψ_C : ψ_b (MvPolynomial.C (a.coeff v)) = c_b (a.coeff v) :=
            MvPolynomial.eval₂Hom_C _ _ _
          have hψ_prod :
              (∏ i : Fin (2 * n₀ + 1), ψ_b (MvPolynomial.X i ^ v (b.succAbove i))) =
              ∏ i : Fin (2 * n₀ + 1), t_b i ^ v (b.succAbove i) := by
            refine Finset.prod_congr rfl fun i _ => ?_
            rw [map_pow]
            dsimp [ψ_b]
            rw [MvPolynomial.eval₂Hom_X']
          rw [hψ_C, hψ_prod, map_mul, hval_c, map_prod, ← hv_deg, pow_add,
            ← Finset.prod_pow_eq_pow_sum]
          have hprod_mul :
              (∏ i : Fin (2 * n₀ + 1), u_b ^ v (b.succAbove i)) *
                (∏ i : Fin (2 * n₀ + 1), val_b (t_b i ^ v (b.succAbove i))) =
              ∏ i : Fin (2 * n₀ + 1),
                algebraMap A L_b (MvPolynomial.X (b.succAbove i)) ^ v (b.succAbove i) := by
            rw [← Finset.prod_mul_distrib]
            refine Finset.prod_congr rfl fun i _ => ?_
            rw [map_pow, ← mul_pow, ht_mul i]
          calc
            (u_b ^ v b * ∏ i : Fin (2 * n₀ + 1), u_b ^ v (b.succAbove i)) *
                ((algebraMap A L_b) (MvPolynomial.C (a.coeff v)) *
                  ∏ i : Fin (2 * n₀ + 1), val_b (t_b i ^ v (b.succAbove i)))
              = (algebraMap A L_b) (MvPolynomial.C (a.coeff v)) * u_b ^ v b *
                  ((∏ i : Fin (2 * n₀ + 1), u_b ^ v (b.succAbove i)) *
                    ∏ i : Fin (2 * n₀ + 1), val_b (t_b i ^ v (b.succAbove i))) := by ring
            _ = (algebraMap A L_b) (MvPolynomial.C (a.coeff v)) *
                  (algebraMap A L_b) (MvPolynomial.X b) ^ v b *
                  ∏ i : Fin (2 * n₀ + 1),
                    (algebraMap A L_b) (MvPolynomial.X (b.succAbove i)) ^ v (b.succAbove i) := by
                rw [hprod_mul]
            _ = (algebraMap A L_b)
                  (MvPolynomial.C (a.coeff v) * MvPolynomial.X b ^ v b *
                    ∏ i : Fin (2 * n₀ + 1),
                      MvPolynomial.X (b.succAbove i) ^ v (b.succAbove i)) := by
                simp [map_mul, map_pow, map_prod]
        rw [hlhs, hrhs]

      let θ_b : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X b) ≃+* P_odd :=
        { φ_b with
          invFun := ψ_b
          left_inv := fun z => congrArg (fun f => f z) hψφ
          right_inv := fun p => congrArg (fun f => f p) hφψ }

      
      let j₀ : ℕ := b.1 / 2
      have hj₀_mem : j₀ ∈ Finset.range (n₀ + 1) := Finset.mem_range.mpr (by omega)
      let b_hat : Fin (2 * n₀ + 1) := ⟨2 * j₀, by omega⟩
      let idx0 : Fin (2 * n₀ + 1) := 0
      let σ_b : Fin (2 * n₀ + 1) ≃ Fin (2 * n₀ + 1) := Equiv.swap idx0 b_hat
      let α_b : P_odd ≃ₐ[K] Polynomial S₀ :=
        (MvPolynomial.renameEquiv K σ_b).trans (MvPolynomial.finSuccEquiv K (2 * n₀))

      have hα_bhat : α_b (MvPolynomial.X b_hat) = Polynomial.X := by
        dsimp [α_b]
        change (MvPolynomial.finSuccEquiv K (2 * n₀))
          ((MvPolynomial.rename σ_b) (MvPolynomial.X b_hat)) = Polynomial.X
        rw [MvPolynomial.rename_X, Equiv.swap_apply_right]
        exact MvPolynomial.finSuccEquiv_X_zero

      have hα_ne : ∀ i : Fin (2 * n₀ + 1), i ≠ b_hat →
          ∃ p : S₀, α_b (MvPolynomial.X i) = Polynomial.C p := by
        intro i hi
        have hσ_ne0 : σ_b i ≠ 0 := by
          intro h0
          apply hi
          apply σ_b.injective
          have hb0 : σ_b b_hat = 0 := Equiv.swap_apply_right idx0 b_hat
          exact h0.trans hb0.symm
        let k_pred : Fin (2 * n₀) := (σ_b i).pred hσ_ne0
        have hk_succ : k_pred.succ = σ_b i := Fin.succ_pred (σ_b i) hσ_ne0
        refine ⟨MvPolynomial.X k_pred, ?_⟩
        dsimp [α_b]
        change (MvPolynomial.finSuccEquiv K (2 * n₀))
          ((MvPolynomial.rename σ_b) (MvPolynomial.X i)) = _
        rw [MvPolynomial.rename_X, ← hk_succ, MvPolynomial.finSuccEquiv_X_succ]

      have hα_other_var : ∀ a : Fin (2 * n₀ + 1 + 1), a.1 / 2 ≠ j₀ →
          ∃ p : S₀, α_b (ev_b (MvPolynomial.X a)) = Polynomial.C p := by
        intro a ha
        by_cases hlt : a.1 < b.1
        · have ha_lt : a.1 < 2 * j₀ := by omega
          let i : Fin (2 * n₀ + 1) := ⟨a.1, by omega⟩
          have hi_lt : i.castSucc < b := hlt
          have ha_eq : a = b.succAbove i := by
            rw [Fin.succAbove_of_castSucc_lt b i hi_lt]
            ext
            rfl
          have hi_ne : i ≠ b_hat := by
            intro heq
            have hval : i.1 = b_hat.1 := congrArg Fin.val heq
            dsimp [i, b_hat] at hval
            omega
          rw [ha_eq, hev_succ i]
          exact hα_ne i hi_ne
        · have ha_ge : 2 * j₀ + 2 ≤ a.1 := by omega
          let i : Fin (2 * n₀ + 1) := ⟨a.1 - 1, by omega⟩
          have hi_ge : b ≤ i.castSucc := by
            change b.1 ≤ a.1 - 1
            omega
          have ha_eq : a = b.succAbove i := by
            rw [Fin.succAbove_of_le_castSucc b i hi_ge]
            ext
            dsimp [i]
            omega
          have hi_ne : i ≠ b_hat := by
            intro heq
            have hval : i.1 = b_hat.1 := congrArg Fin.val heq
            dsimp [i, b_hat] at hval
            omega
          rw [ha_eq, hev_succ i]
          exact hα_ne i hi_ne

      let term : ℕ → A := fun j =>
        if h : 2 * j + 1 < 2 * n₀ + 1 + 1 then
          (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ : A) * MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0
      have hterm_j0 : α_b (ev_b (term j₀)) = Polynomial.X := by
        have hj0_bound : 2 * j₀ + 1 < 2 * n₀ + 1 + 1 := by omega
        dsimp [term]
        simp only [hj0_bound, ↓reduceDIte, map_mul]
        have hpar : b.1 = 2 * j₀ ∨ b.1 = 2 * j₀ + 1 := by omega
        rcases hpar with hb_even | hb_odd
        · have h0_eq : (⟨2 * j₀, Nat.lt_of_succ_lt hj0_bound⟩ : Fin (2 * n₀ + 1 + 1)) = b :=
            Fin.ext hb_even.symm
          have hle : b ≤ b_hat.castSucc := by
            change b.1 ≤ 2 * j₀
            omega
          have h1_eq : (⟨2 * j₀ + 1, hj0_bound⟩ : Fin (2 * n₀ + 1 + 1)) = b.succAbove b_hat := by
            rw [Fin.succAbove_of_le_castSucc b b_hat hle]
            rfl
          rw [h0_eq, h1_eq, hev_Xb, hev_succ b_hat, map_one, one_mul, hα_bhat]
        · have hlt : b_hat.castSucc < b := by
            change 2 * j₀ < b.1
            omega
          have h0_eq : (⟨2 * j₀, Nat.lt_of_succ_lt hj0_bound⟩ : Fin (2 * n₀ + 1 + 1)) =
              b.succAbove b_hat := by
            rw [Fin.succAbove_of_castSucc_lt b b_hat hlt]
            rfl
          have h1_eq : (⟨2 * j₀ + 1, hj0_bound⟩ : Fin (2 * n₀ + 1 + 1)) = b :=
            Fin.ext hb_odd.symm
          rw [h0_eq, h1_eq, hev_succ b_hat, hev_Xb, map_one, mul_one, hα_bhat]

      have hrest_C : ∃ Q_rest : S₀,
          (∑ j ∈ (Finset.range (n₀ + 1)).erase j₀, α_b (ev_b (term j))) =
            Polynomial.C Q_rest := by
        have hex : ∀ j : ℕ, ∃ q_j : S₀,
            j ∈ (Finset.range (n₀ + 1)).erase j₀ →
              α_b (ev_b (term j)) = Polynomial.C q_j := by
          intro j
          by_cases hj : j ∈ (Finset.range (n₀ + 1)).erase j₀
          · have hj_ne : j ≠ j₀ := (Finset.mem_erase.mp hj).1
            have hj_lt : j < n₀ + 1 := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
            have hj_bound : 2 * j + 1 < 2 * n₀ + 1 + 1 := by omega
            obtain ⟨p₁, hp₁⟩ :=
              hα_other_var ⟨2 * j, Nat.lt_of_succ_lt hj_bound⟩ (by dsimp; omega)
            obtain ⟨p₂, hp₂⟩ := hα_other_var ⟨2 * j + 1, hj_bound⟩ (by dsimp; omega)
            refine ⟨p₁ * p₂, fun _ => ?_⟩
            dsimp [term]
            simp only [hj_bound, ↓reduceDIte, map_mul]
            rw [hp₁, hp₂, ← Polynomial.C_mul]
          · exact ⟨0, fun hmem => False.elim (hj hmem)⟩
        choose q_fn hq_fn using hex
        refine ⟨∑ j ∈ (Finset.range (n₀ + 1)).erase j₀, q_fn j, ?_⟩
        rw [map_sum]
        exact Finset.sum_congr rfl fun j hj => hq_fn j hj

      obtain ⟨Q_rest, hQ_rest⟩ := hrest_C
      have hα_Fsplit : α_b (ev_b F_split) = Polynomial.X - Polynomial.C (-Q_rest) := by
        change α_b (ev_b (∑ j ∈ Finset.range (n₀ + 1), term j)) = _
        rw [map_sum, map_sum, ← Finset.add_sum_erase _ _ hj₀_mem, hterm_j0, hQ_rest,
          map_neg, sub_neg_eq_add]

      
      let Υ_b : Polynomial S₀ →+* ↑(Q.left.presheaf.obj (Opposite.op (W' b))) :=
        (β_b.comp θ_b.symm.toRingHom).comp α_b.symm.toRingHom
      have hΥ_surj : Function.Surjective Υ_b :=
        hβ_surj.comp (θ_b.symm.surjective.comp α_b.symm.surjective)
      have hGen_map : θ_b.symm (α_b.symm (Polynomial.X - Polynomial.C (-Q_rest))) =
          HomogeneousLocalization.Away.mk 𝒜 (hX b) 2 F_split hF := by
        rw [← hα_Fsplit, α_b.symm_apply_apply]
        have hθ : θ_b (HomogeneousLocalization.Away.mk 𝒜 (hX b) 2 F_split hF) = ev_b F_split :=
          hφ_mk 2 F_split hF
        rw [← hθ, θ_b.symm_apply_apply]
      have hΥ_ker : RingHom.ker Υ_b =
          Ideal.span {Polynomial.X - Polynomial.C (-Q_rest)} := by
        apply le_antisymm
        · intro P hP
          have hmem : θ_b.symm (α_b.symm P) ∈ RingHom.ker β_b := hP
          rw [hβ_ker, Ideal.mem_span_singleton] at hmem
          rcases hmem with ⟨s, hs⟩
          rw [← hGen_map] at hs
          obtain ⟨q_poly, rfl⟩ : ∃ q_poly : Polynomial S₀, θ_b.symm (α_b.symm q_poly) = s :=
            ⟨α_b (θ_b s), by simp⟩
          rw [← map_mul, ← map_mul] at hs
          have hPq := α_b.symm.injective (θ_b.symm.injective hs)
          rw [Ideal.mem_span_singleton]
          exact ⟨q_poly, hPq⟩
        · rw [Ideal.span_le, Set.singleton_subset_iff]
          change β_b (θ_b.symm (α_b.symm (Polynomial.X - Polynomial.C (-Q_rest)))) = 0
          rw [hGen_map]
          have hmem : HomogeneousLocalization.Away.mk 𝒜 (hX b) 2 F_split hF ∈
              RingHom.ker β_b := by
            rw [hβ_ker]
            exact Ideal.subset_span rfl
          exact hmem

      let Φ_Wb : S₀ →+* ↑(Q.left.presheaf.obj (Opposite.op (W' b))) :=
        Υ_b.comp Polynomial.C
      have hΦ_bij : Function.Bijective Φ_Wb := by
        refine ⟨?_, ?_⟩
        · intro s₁ s₂ hs
          have hsub : Polynomial.C (s₁ - s₂) ∈ RingHom.ker Υ_b := by
            change Υ_b (Polynomial.C (s₁ - s₂)) = 0
            rw [map_sub, map_sub]
            exact sub_eq_zero.mpr hs
          rw [hΥ_ker, Ideal.mem_span_singleton] at hsub
          rcases hsub with ⟨q_poly, hq_poly⟩
          have hev := congrArg (Polynomial.eval (-Q_rest)) hq_poly
          simp only [Polynomial.eval_C, Polynomial.eval_mul, Polynomial.eval_sub,
            Polynomial.eval_X, sub_self, zero_mul] at hev
          exact sub_eq_zero.mp hev
        · intro r
          obtain ⟨P, rfl⟩ := hΥ_surj r
          refine ⟨Polynomial.eval (-Q_rest) P, ?_⟩
          have hdvd : Polynomial.X - Polynomial.C (-Q_rest) ∣
              P - Polynomial.C (Polynomial.eval (-Q_rest) P) :=
            Polynomial.X_sub_C_dvd_sub_C_eval
          have hmem : P - Polynomial.C (Polynomial.eval (-Q_rest) P) ∈ RingHom.ker Υ_b := by
            rw [hΥ_ker, Ideal.mem_span_singleton]
            exact hdvd
          change Υ_b (Polynomial.C (Polynomial.eval (-Q_rest) P)) = Υ_b P
          have h0 : Υ_b P - Υ_b (Polynomial.C (Polynomial.eval (-Q_rest) P)) = 0 := by
            rw [← map_sub]
            exact hmem
          exact (sub_eq_zero.mp h0).symm

      let e_ring : S₀ ≃+* ↑(Q.left.presheaf.obj (Opposite.op (W' b))) :=
        RingEquiv.ofBijective Φ_Wb hΦ_bij
      let e_cat : CommRingCat.of S₀ ≅ Q.left.presheaf.obj (Opposite.op (W' b)) :=
        { hom := CommRingCat.ofHom e_ring.toRingHom
          inv := CommRingCat.ofHom e_ring.symm.toRingHom
          hom_inv_id := by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro x
            exact e_ring.symm_apply_apply x
          inv_hom_id := by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro x
            exact e_ring.apply_symm_apply x }
      have hΦ_scalar : ∀ c : K, Φ_Wb (MvPolynomial.C c) = β_b (c_b c) := by
        intro c
        change β_b (θ_b.symm (α_b.symm (Polynomial.C (MvPolynomial.C c)))) = β_b (c_b c)
        have halg_eq : Polynomial.C (MvPolynomial.C c : S₀) =
            algebraMap K (Polynomial S₀) c := by
          rw [IsScalarTower.algebraMap_apply K S₀ (Polynomial S₀),
            MvPolynomial.algebraMap_eq, Polynomial.algebraMap_eq]
        rw [halg_eq, α_b.symm.commutes, MvPolynomial.algebraMap_eq]
        have hψ_C : θ_b.symm (MvPolynomial.C c) = c_b c := by
          change ψ_b (MvPolynomial.C c) = c_b c
          exact MvPolynomial.eval₂Hom_C _ _ _
        rw [hψ_C]

      let spec_Wb : AlgebraicGeometry.Spec (Q.left.presheaf.obj (Opposite.op (W' b))) ≅
          AlgebraicGeometry.Spec (CommRingCat.of S₀) :=
        { hom := AlgebraicGeometry.Spec.map e_cat.hom
          inv := AlgebraicGeometry.Spec.map e_cat.inv
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, e_cat.inv_hom_id,
              AlgebraicGeometry.Spec.map_id]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, e_cat.hom_inv_id,
              AlgebraicGeometry.Spec.map_id] }
      refine ⟨hAff_Wb.isoSpec ≪≫ spec_Wb, ?_⟩
      have hcomp := congrArg (fun g => g ≫ P_hom) hStep2
      have hrhs : ((W' b).ι ≫ f_Q) ≫ P_hom = (W' b).ι ≫ Q.hom := by
        rw [CategoryTheory.Category.assoc]
        exact congrArg ((W' b).ι ≫ ·) hι
      rw [hrhs] at hcomp
      rw [← hcomp]
      dsimp only [spec_Wb, P_hom]
      rw [CategoryTheory.Iso.trans_hom, hAff_Wb.isoSpec_hom, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Spec.map_comp]
      congr 2
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      exact hΦ_scalar c

    · 
      intro hn0
      have hF0 : F_split =
          MvPolynomial.X (⟨0, by omega⟩ : Fin (2 * n₀ + 1 + 1)) *
            MvPolynomial.X (⟨1, by omega⟩ : Fin (2 * n₀ + 1 + 1)) := by
        dsimp [F_split]
        have hr : n₀ + 1 = 1 := by omega
        rw [hr, Finset.sum_range_one]
        split_ifs with h
        · rfl
        · omega
      ext q
      refine ⟨?_, False.elim⟩
      intro hq
      have hq01 : f_Q.base q ∈
          D (⟨0, by omega⟩ : Fin (2 * n₀ + 1 + 1)) ⊓
            D (⟨1, by omega⟩ : Fin (2 * n₀ + 1 + 1)) := hq
      have hmul :
          D (⟨0, by omega⟩ : Fin (2 * n₀ + 1 + 1)) ⊓
            D (⟨1, by omega⟩ : Fin (2 * n₀ + 1 + 1)) =
          AlgebraicGeometry.Proj.basicOpen 𝒜 F_split := by
        dsimp [D]
        rw [← AlgebraicGeometry.Proj.basicOpen_mul, hF0]
        rfl
      rw [hmul] at hq01
      have hmem_range : ι.base q ∈ Set.range ι.base := ⟨q, rfl⟩
      rw [hRange] at hmem_range
      exact hmem_range hq01

    · 
      intro hn1 b
      let b₀ : Fin (2 * n₀ + 1 + 1) := ⟨0, by omega⟩
      let k_b : ℕ := b.1
      let b' : Fin (2 * n₀ + 1 + 1) := ⟨k_b, b.2⟩
      change Nonempty ↥(W' b₀ ⊓ W' b')
      obtain ⟨hAff_W0, hβ0_surj, hβ0_ker, hStep2_0⟩ := hChartBase b₀
      let awaySec0 := AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X b₀)
      let β₀ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X b₀) →+*
          ↑(Q.left.presheaf.obj (Opposite.op (W' b₀))) :=
        ((f_Q.app (D b₀)).hom).comp awaySec0.hom

      
      let v_b : Fin (2 * n₀ + 1 + 1) → K := fun a =>
        if k_b = 0 then
          if a.1 = 0 then 1 else 0
        else if k_b = 1 then
          if a.1 = 0 then 1
          else if a.1 = 1 then 1
          else if a.1 = 2 then 1
          else if a.1 = 3 then -1
          else 0
        else
          if a.1 = 0 then 1
          else if a.1 = k_b then 1
          else 0
      have hv_b0 : v_b b₀ = 1 := by
        dsimp [v_b, b₀]
        split_ifs <;> rfl
      have hv_bb : v_b b' = 1 := by
        dsimp [v_b, b']
        split_ifs <;> first | rfl | omega
      have hv_F : MvPolynomial.eval v_b F_split = 0 := by
        dsimp [F_split]
        rw [map_sum]
        by_cases hb0 : k_b = 0
        · refine Finset.sum_eq_zero fun j _ => ?_
          split_ifs with h
          · rw [map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X]
            have h2j1 : v_b ⟨2 * j + 1, h⟩ = 0 := by
              dsimp [v_b]
              simp only [hb0, ↓reduceIte]
            rw [h2j1, mul_zero]
          · exact map_zero _
        · by_cases hb1 : k_b = 1
          · have h0_mem : (0 : ℕ) ∈ Finset.range (n₀ + 1) :=
              Finset.mem_range.mpr (by omega)
            have h1_mem : (1 : ℕ) ∈ (Finset.range (n₀ + 1)).erase 0 :=
              Finset.mem_erase.mpr ⟨by decide, Finset.mem_range.mpr (by omega)⟩
            rw [← Finset.add_sum_erase _ _ h0_mem, ← Finset.add_sum_erase _ _ h1_mem]
            have ht0 : (MvPolynomial.eval v_b)
                (if h : 2 * 0 + 1 < 2 * n₀ + 1 + 1 then
                  (MvPolynomial.X ⟨2 * 0, Nat.lt_of_succ_lt h⟩ : A) *
                    MvPolynomial.X ⟨2 * 0 + 1, h⟩
                else 0) = 1 := by
              split_ifs with h
              · rw [map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X]
                have hv0 : v_b ⟨2 * 0, Nat.lt_of_succ_lt h⟩ = 1 := by
                  dsimp only [v_b]
                  simp only [hb0, hb1, ↓reduceIte]
                  norm_num
                have hv1 : v_b ⟨2 * 0 + 1, h⟩ = 1 := by
                  dsimp only [v_b]
                  simp only [hb0, hb1, ↓reduceIte]
                  norm_num
                rw [hv0, hv1, mul_one]
              · omega
            have ht1 : (MvPolynomial.eval v_b)
                (if h : 2 * 1 + 1 < 2 * n₀ + 1 + 1 then
                  (MvPolynomial.X ⟨2 * 1, Nat.lt_of_succ_lt h⟩ : A) *
                    MvPolynomial.X ⟨2 * 1 + 1, h⟩
                else 0) = -1 := by
              split_ifs with h
              · rw [map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X]
                have hv2 : v_b ⟨2 * 1, Nat.lt_of_succ_lt h⟩ = 1 := by
                  dsimp only [v_b]
                  simp only [hb0, hb1, ↓reduceIte]
                  norm_num
                have hv3 : v_b ⟨2 * 1 + 1, h⟩ = -1 := by
                  dsimp only [v_b]
                  simp only [hb0, hb1, ↓reduceIte]
                  norm_num
                rw [hv2, hv3, one_mul]
              · omega
            have ht_rest :
                (∑ j ∈ ((Finset.range (n₀ + 1)).erase 0).erase 1,
                  (MvPolynomial.eval v_b)
                    (if h : 2 * j + 1 < 2 * n₀ + 1 + 1 then
                      (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ : A) *
                        MvPolynomial.X ⟨2 * j + 1, h⟩
                    else 0)) = 0 := by
              refine Finset.sum_eq_zero fun j hj => ?_
              have hj1 : j ≠ 1 := (Finset.mem_erase.mp hj).1
              have hj0 : j ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hj).2).1
              split_ifs with h
              · rw [map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X]
                have hv2j : v_b ⟨2 * j, Nat.lt_of_succ_lt h⟩ = 0 := by
                  dsimp [v_b]
                  split_ifs <;> first | rfl | omega
                rw [hv2j, zero_mul]
              · exact map_zero _
            rw [ht0, ht1, ht_rest]
            ring
          · refine Finset.sum_eq_zero fun j _ => ?_
            split_ifs with h
            · rw [map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X]
              rcases Nat.eq_zero_or_pos j with rfl | hj_pos
              · have h1_ne0 : 2 * 0 + 1 ≠ 0 := by omega
                have h1_ne : 2 * 0 + 1 ≠ k_b := by omega
                have hv1 : v_b ⟨2 * 0 + 1, h⟩ = 0 := by
                  dsimp only [v_b]
                  simp only [hb0, hb1, h1_ne0, h1_ne, ↓reduceIte]
                rw [hv1, mul_zero]
              · by_cases heq2j : 2 * j = k_b
                · have h2j1_nek : 2 * j + 1 ≠ k_b := by omega
                  have hv2j1 : v_b ⟨2 * j + 1, h⟩ = 0 := by
                    dsimp [v_b]
                    simp only [hb0, hb1, h2j1_nek, ↓reduceIte]
                  rw [hv2j1, mul_zero]
                · have h2j_ne0 : 2 * j ≠ 0 := by omega
                  have hv2j : v_b ⟨2 * j, Nat.lt_of_succ_lt h⟩ = 0 := by
                    dsimp [v_b]
                    simp only [hb0, hb1, h2j_ne0, heq2j, ↓reduceIte]
                  rw [hv2j, zero_mul]
            · exact map_zero _

      
      have hu_v0 : IsUnit ((MvPolynomial.eval v_b) (MvPolynomial.X b₀)) := by
        rw [MvPolynomial.eval_X, hv_b0]
        exact isUnit_one
      let lift_v : Localization (Submonoid.powers (MvPolynomial.X b₀ : A)) →+* K :=
        IsLocalization.Away.lift (MvPolynomial.X b₀) hu_v0
      let ε_b : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X b₀) →+* K :=
        lift_v.comp (algebraMap _ _)
      have hε_mk : ∀ (n : ℕ) (a : A) (ha : a ∈ 𝒜 (n • 1)),
          ε_b (HomogeneousLocalization.Away.mk 𝒜 (hX b₀) n a ha) = MvPolynomial.eval v_b a := by
        intro n a ha
        change lift_v (HomogeneousLocalization.val
          (HomogeneousLocalization.Away.mk 𝒜 (hX b₀) n a ha)) = MvPolynomial.eval v_b a
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
        dsimp [lift_v, IsLocalization.Away.lift]
        rw [IsLocalization.lift_mk'_spec]
        change MvPolynomial.eval v_b a =
          (MvPolynomial.eval v_b) (MvPolynomial.X b₀ ^ n) * MvPolynomial.eval v_b a
        rw [map_pow, MvPolynomial.eval_X, hv_b0, one_pow, one_mul]
      have hε_F : ε_b (HomogeneousLocalization.Away.mk 𝒜 (hX b₀) 2 F_split hF) = 0 := by
        rw [hε_mk 2 F_split hF, hv_F]
      have hε_Xb : ε_b (HomogeneousLocalization.Away.isLocalizationElem (hX b₀) (hX b')) ≠ 0 := by
        have helem_eq : HomogeneousLocalization.Away.isLocalizationElem (hX b₀) (hX b') =
            HomogeneousLocalization.Away.mk 𝒜 (hX b₀) 1 (MvPolynomial.X b') (hX_smul1 b') := by
          rw [HomogeneousLocalization.ext_iff_val]
          change Localization.mk (MvPolynomial.X b' ^ 1) ⟨MvPolynomial.X b₀ ^ 1, _⟩ =
            Localization.mk (MvPolynomial.X b') ⟨MvPolynomial.X b₀ ^ 1, _⟩
          simp [pow_one]
        rw [helem_eq, hε_mk 1 (MvPolynomial.X b') (hX_smul1 b'), MvPolynomial.eval_X, hv_bb]
        exact one_ne_zero

      have hker_le : ∀ z ∈ RingHom.ker β₀, ε_b z = 0 := by
        intro z hz
        rw [hβ0_ker, Ideal.mem_span_singleton] at hz
        rcases hz with ⟨s, rfl⟩
        rw [map_mul, hε_F, zero_mul]
      let ε_Q : ↑(Q.left.presheaf.obj (Opposite.op (W' b₀))) →+* K :=
        (Ideal.Quotient.lift (RingHom.ker β₀) ε_b hker_le).comp
          (RingHom.quotientKerEquivOfSurjective hβ0_surj).symm.toRingHom
      have hεQ_comp : ε_Q.comp β₀ = ε_b := by
        apply RingHom.ext
        intro z
        dsimp [ε_Q]
        have hq_symm : (RingHom.quotientKerEquivOfSurjective hβ0_surj).symm (β₀ z) =
            Ideal.Quotient.mk (RingHom.ker β₀) z := by
          apply (RingHom.quotientKerEquivOfSurjective hβ0_surj).injective
          rw [(RingHom.quotientKerEquivOfSurjective hβ0_surj).apply_symm_apply]
          rfl
        rw [hq_symm, Ideal.Quotient.lift_mk]

      let g_pt : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ Q.left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_Q) ≫ hAff_W0.fromSpec
      let pt_K : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := (⊥ : PrimeSpectrum K)
      let q_pt : ↥Q.left := g_pt.base pt_K
      have hq_W0 : q_pt ∈ W' b₀ := by
        change q_pt ∈ (W' b₀ : Set Q.left)
        rw [← hAff_W0.range_fromSpec]
        exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_Q)).base pt_K, rfl⟩
      have hfrom_ι : hAff_W0.fromSpec ≫ f_Q =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₀) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X b₀) (hX b₀) zero_lt_one := by
        rw [← hAff_W0.isoSpec_inv_ι, CategoryTheory.Category.assoc, ← hStep2_0,
          ← hAff_W0.isoSpec_hom, CategoryTheory.Iso.inv_hom_id_assoc]
      have hg_ι : g_pt ≫ f_Q =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_b) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X b₀) (hX b₀) zero_lt_one := by
        dsimp [g_pt]
        rw [CategoryTheory.Category.assoc, hfrom_ι, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hεQ_comp]
      have hq_Wb : q_pt ∈ W' b' := by
        change (g_pt ≫ f_Q).base pt_K ∈ D b'
        rw [hg_ι]
        have hpre := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜
          (hX b₀) zero_lt_one (hX b') zero_lt_one
        let p_away : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X b₀)) :=
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_b)).base pt_K
        change (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X b₀) (hX b₀) zero_lt_one).base
          p_away ∈ D b'
        have hmem_iff :
            (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X b₀) (hX b₀) zero_lt_one).base
              p_away ∈ D b' ↔
            p_away ∈ (TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X b₀) (hX b₀) zero_lt_one).base).obj
              (D b') := Iff.rfl
        rw [hmem_iff]
        dsimp [D]
        rw [hpre]
        change HomogeneousLocalization.Away.isLocalizationElem (hX b₀) (hX b') ∉ p_away.asIdeal
        intro hmem
        exact hε_Xb hmem
      exact ⟨⟨q_pt, hq_W0, hq_Wb⟩⟩

theorem weil_split_quad_affine_poly_product_and_p1_glue (K : Type u) [Field K] :
    (∀ (d : ℕ)
      (B V : AlgebraicGeometry.Scheme.{u})
      (p : V ⟶ B)
      (f_B : B ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
      (e_B : B ≅ (weilAffineSpaceOver K d).left),
      e_B.hom ≫ (weilAffineSpaceOver K d).hom = f_B →
      ∀ (R : Type u) [CommRing R] [Algebra K R]
        (i_B : B ≅ AlgebraicGeometry.Spec (CommRingCat.of R))
        (i_V : V ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R))),
        i_B.inv ≫ f_B = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K R)) →
        p ≫ i_B.hom = i_V.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
        (∃ e_prod : V ≅
            CategoryTheory.Limits.pullback (weilAffineSpaceOver K d).hom
              (weilAffineSpaceOver K 1).hom,
          e_prod.hom ≫
              CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K d).hom
                (weilAffineSpaceOver K 1).hom =
            p ≫ e_B.hom) ∧
        (∃ e_aff : V ≅ (weilAffineSpaceOver K (d + 1)).left,
          e_aff.hom ≫ (weilAffineSpaceOver K (d + 1)).hom = p ≫ f_B)) ∧
    (∀ (T : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      (U₀ U₁ : T.left.Opens),
      U₀ ⊔ U₁ = ⊤ →
      ∀ (i₀ : U₀.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K)))
        (i₁ : U₁.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K))),
        U₀.ι ≫ T.hom = i₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
        U₁.ι ≫ T.hom = i₁.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
        (TopologicalSpace.Opens.map U₀.ι.base).obj U₁ =
          (TopologicalSpace.Opens.map i₀.hom.base).obj
            (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)) →
        (TopologicalSpace.Opens.map U₁.ι.base).obj U₀ =
          (TopologicalSpace.Opens.map i₁.hom.base).obj
            (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)) →
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (algebraMap (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K)))) ≫
          i₀.inv ≫ U₀.ι =
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (Polynomial.eval₂RingHom
                ((algebraMap (Polynomial K)
                  (Localization.Away (Polynomial.X : Polynomial K))).comp Polynomial.C)
                (IsLocalization.Away.invSelf
                  (S := Localization.Away (Polynomial.X : Polynomial K))
                  (Polynomial.X : Polynomial K)))) ≫
          i₁.inv ≫ U₁.ι →
        ∃ e_P1 : T.left ≅ (weilProjectiveSpaceOver K 1).left,
          e_P1.hom ≫ (weilProjectiveSpaceOver K 1).hom = T.hom) :=
by
  refine ⟨?_, ?_⟩
  · 
    intro d B V p f_B e_B he_B R _ _ i_B i_V hi_B hp
    dsimp only [weilAffineSpaceOver, CategoryTheory.Over.mk_left, CategoryTheory.Over.mk_hom]
      at e_B he_B ⊢
    simp only [← MvPolynomial.algebraMap_eq] at he_B ⊢
    let S_d := MvPolynomial (Fin d) K
    let S_1 := MvPolynomial (Fin 1) K
    let S_d1 := MvPolynomial (Fin (d + 1)) K
    let δ_B : AlgebraicGeometry.Spec (CommRingCat.of R) ≅
        AlgebraicGeometry.Spec (CommRingCat.of S_d) :=
      i_B.symm ≪≫ e_B
    let φ_cat : CommRingCat.of S_d ⟶ CommRingCat.of R :=
      AlgebraicGeometry.Spec.preimage δ_B.hom
    let ψ_cat : CommRingCat.of R ⟶ CommRingCat.of S_d :=
      AlgebraicGeometry.Spec.preimage δ_B.inv
    have hφ_map : AlgebraicGeometry.Spec.map φ_cat = i_B.inv ≫ e_B.hom :=
      AlgebraicGeometry.Spec.map_preimage δ_B.hom
    have hφψ : φ_cat ≫ ψ_cat = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, δ_B.inv_hom_id, AlgebraicGeometry.Spec.map_id]
    have hψφ : ψ_cat ≫ φ_cat = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, δ_B.hom_inv_id, AlgebraicGeometry.Spec.map_id]
    let ρ : S_d ≃+* R :=
