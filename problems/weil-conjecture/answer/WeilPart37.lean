    let φ_K := @FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
      (AlgebraicClosure K) _ _ _
    let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
    let fst_Z : weilGeomScheme K Z ⟶ Z.left := CategoryTheory.Limits.pullback.fst Z.hom f₂
    let i_symm := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_K.symm.toRingHom)
    let i_inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_K.toRingHom)
    have hcomp_inv : CategoryTheory.CategoryStruct.comp
        (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
        (CommRingCat.ofHom φ_K.toRingHom) =
        CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)) :=
      (CommRingCat.ofHom_comp _ _).symm.trans (congrArg CommRingCat.ofHom (RingHom.ext φ_K.commutes))
    let g_inv : weilGeomScheme K Z ⟶ weilGeomScheme K Z :=
      CategoryTheory.Limits.pullback.map Z.hom f₂ Z.hom f₂
        (CategoryTheory.CategoryStruct.id Z.left) i_inv
        (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of K)))
        ((CategoryTheory.Category.comp_id Z.hom).trans (CategoryTheory.Category.id_comp Z.hom).symm)
        ((CategoryTheory.Category.comp_id f₂).trans
          ((congrArg AlgebraicGeometry.Spec.map hcomp_inv.symm).trans
            (AlgebraicGeometry.Spec.map_comp _ _)))
    have hg_fst : g_inv ≫ fst_Z = fst_Z :=
      (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans (CategoryTheory.Category.comp_id _)
    have hf_fst : weilGeomFrobHom K Z ≫ fst_Z = fst_Z := hFrobFst Z
    have hg_snd : g_inv ≫ (weilBaseChangeOver K (AlgebraicClosure K) Z).hom =
        (weilBaseChangeOver K (AlgebraicClosure K) Z).hom ≫ i_inv :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hf_snd : weilGeomFrobHom K Z ≫ (weilBaseChangeOver K (AlgebraicClosure K) Z).hom =
        (weilBaseChangeOver K (AlgebraicClosure K) Z).hom ≫ i_symm := hFrobSnd Z
    have h_i1 : i_symm ≫ i_inv = 𝟙 _ :=
      ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
        (congrArg AlgebraicGeometry.Spec.map
          ((CommRingCat.ofHom_comp _ _).symm.trans
            (congrArg CommRingCat.ofHom (RingHom.ext φ_K.symm_apply_apply))))).trans
        (AlgebraicGeometry.Spec.map_id _)
    have h_i2 : i_inv ≫ i_symm = 𝟙 _ :=
      ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
        (congrArg AlgebraicGeometry.Spec.map
          ((CommRingCat.ofHom_comp _ _).symm.trans
            (congrArg CommRingCat.ofHom (RingHom.ext φ_K.apply_symm_apply))))).trans
        (AlgebraicGeometry.Spec.map_id _)
    refine ⟨{
      hom := weilGeomFrobHom K Z
      inv := g_inv
      hom_inv_id := hBcHomExt _ _
        (by change (weilGeomFrobHom K Z ≫ g_inv) ≫ fst_Z = 𝟙 (weilGeomScheme K Z) ≫ fst_Z
            rw [CategoryTheory.Category.assoc, hg_fst, hf_fst, CategoryTheory.Category.id_comp])
        (by rw [CategoryTheory.Category.assoc, hg_snd, ← CategoryTheory.Category.assoc, hf_snd,
            CategoryTheory.Category.assoc, h_i1, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.id_comp])
      inv_hom_id := hBcHomExt _ _
        (by change (g_inv ≫ weilGeomFrobHom K Z) ≫ fst_Z = 𝟙 (weilGeomScheme K Z) ≫ fst_Z
            rw [CategoryTheory.Category.assoc, hf_fst, hg_fst, CategoryTheory.Category.id_comp])
        (by rw [CategoryTheory.Category.assoc, hf_snd, ← CategoryTheory.Category.assoc, hg_snd,
            CategoryTheory.Category.assoc, h_i2, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.id_comp]) }, rfl⟩

  have hOverFrob : ∀ {Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))}
      (φ : Y₁ ⟶ Y₂) (φ_bar : weilGeomScheme K Y₁ ⟶ weilGeomScheme K Y₂),
      φ_bar ≫ (CategoryTheory.Limits.pullback.fst Y₂.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :
          weilGeomScheme K Y₂ ⟶ Y₂.left) =
        (CategoryTheory.Limits.pullback.fst Y₁.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :
          weilGeomScheme K Y₁ ⟶ Y₁.left) ≫
          φ.left →
      φ_bar ≫ (weilBaseChangeOver K (AlgebraicClosure K) Y₂).hom =
        (weilBaseChangeOver K (AlgebraicClosure K) Y₁).hom →
      ∀ (q : ℕ)
        (f₁ : weilEtaleTorsionH (weilGeomScheme K Y₁) (ℓ ^ (r + 1)) q →+
          weilEtaleTorsionH (weilGeomScheme K Y₁) (ℓ ^ (r + 1)) q)
        (f₂ : weilEtaleTorsionH (weilGeomScheme K Y₂) (ℓ ^ (r + 1)) q →+
          weilEtaleTorsionH (weilGeomScheme K Y₂) (ℓ ^ (r + 1)) q)
        (p_φ : weilEtaleTorsionH (weilGeomScheme K Y₂) (ℓ ^ (r + 1)) q →+
          weilEtaleTorsionH (weilGeomScheme K Y₁) (ℓ ^ (r + 1)) q),
        WeilIsTorsionGeomFrobAction K Y₁ (ℓ ^ (r + 1)) q f₁ →
        WeilIsTorsionGeomFrobAction K Y₂ (ℓ ^ (r + 1)) q f₂ →
        WeilIsTorsionEtalePullback φ_bar (ℓ ^ (r + 1)) q p_φ →
        ∀ u, p_φ (f₂ u) = f₁ (p_φ u) := by
    intro Y₁ Y₂ φ φ_bar hfst hsnd q f₁ f₂ p_φ hf₁ hf₂ hp_φ u
    let fst₁ : weilGeomScheme K Y₁ ⟶ Y₁.left := CategoryTheory.Limits.pullback.fst Y₁.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
    let fst₂ : weilGeomScheme K Y₂ ⟶ Y₂.left := CategoryTheory.Limits.pullback.fst Y₂.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
    have hfst' : φ_bar ≫ fst₂ = fst₁ ≫ φ.left := hfst
    have hfrob₁ : weilGeomFrobHom K Y₁ ≫ fst₁ = fst₁ := hFrobFst Y₁
    have hfrob₂ : weilGeomFrobHom K Y₂ ≫ fst₂ = fst₂ := hFrobFst Y₂
    have hcomm : φ_bar ≫ weilGeomFrobHom K Y₂ = weilGeomFrobHom K Y₁ ≫ φ_bar := by
      apply hBcHomExt
      · change (φ_bar ≫ weilGeomFrobHom K Y₂) ≫ fst₂ =
          (weilGeomFrobHom K Y₁ ≫ φ_bar) ≫ fst₂
        rw [CategoryTheory.Category.assoc, hfrob₂, hfst',
          CategoryTheory.Category.assoc, hfst', ← CategoryTheory.Category.assoc, hfrob₁]
      · rw [CategoryTheory.Category.assoc, hFrobSnd Y₂, ← CategoryTheory.Category.assoc, hsnd,
          CategoryTheory.Category.assoc, hsnd, hFrobSnd Y₁]
    obtain ⟨p_g₁, hp_g₁⟩ := hPullEx (weilGeomFrobHom K Y₁) (ℓ ^ (r + 1)) q
    obtain ⟨p_g₂, hp_g₂⟩ := hPullEx (weilGeomFrobHom K Y₂) (ℓ ^ (r + 1)) q
    have hf₁_eq := hFrobEqPull K Y₁ (ℓ ^ (r + 1)) q f₁ p_g₁ hf₁ hp_g₁
    have hf₂_eq := hFrobEqPull K Y₂ (ℓ ^ (r + 1)) q f₂ p_g₂ hf₂ hp_g₂
    obtain ⟨p_comp, hp_comp⟩ := hPullEx (φ_bar ≫ weilGeomFrobHom K Y₂) (ℓ ^ (r + 1)) q
    have hc₁ := hPullComp φ_bar (weilGeomFrobHom K Y₂) (ℓ ^ (r + 1)) q
      p_φ p_g₂ p_comp hp_φ hp_g₂ hp_comp
    have hp_comp' : WeilIsTorsionEtalePullback
        (weilGeomFrobHom K Y₁ ≫ φ_bar) (ℓ ^ (r + 1)) q p_comp := by
      rwa [← hcomm]
    have hc₂ := hPullComp (weilGeomFrobHom K Y₁) φ_bar (ℓ ^ (r + 1)) q
      p_g₁ p_φ p_comp hp_g₁ hp_φ hp_comp'
    rw [hf₁_eq, hf₂_eq, ← AddMonoidHom.comp_apply, ← hc₁, hc₂, AddMonoidHom.comp_apply]

  
  have hOpenBcIso : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      (U : Y.left.Opens)
      (j_bar : weilGeomScheme K (CategoryTheory.Over.mk (U.ι ≫ Y.hom)) ⟶ weilGeomScheme K Y),
      CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (CategoryTheory.Over.mk (U.ι ≫ Y.hom)).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :
          weilGeomScheme K (CategoryTheory.Over.mk (U.ι ≫ Y.hom)) ⟶
            (CategoryTheory.Over.mk (U.ι ≫ Y.hom)).left)
        j_bar U.ι
        (CategoryTheory.Limits.pullback.fst Y.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :
          weilGeomScheme K Y ⟶ Y.left) →
      j_bar ≫ (weilBaseChangeOver K (AlgebraicClosure K) Y).hom =
        (weilBaseChangeOver K (AlgebraicClosure K) (CategoryTheory.Over.mk (U.ι ≫ Y.hom))).hom →
      let pr_Y : weilGeomScheme K Y ⟶ Y.left := CategoryTheory.Limits.pullback.fst Y.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
      let U_bar : (weilGeomScheme K Y).Opens := (TopologicalSpace.Opens.map pr_Y.base).obj U
      ∃ δ_U : U_bar.toScheme ≅ weilGeomScheme K (CategoryTheory.Over.mk (U.ι ≫ Y.hom)),
        δ_U.hom ≫ j_bar = U_bar.ι ∧
        δ_U.hom ≫ (weilBaseChangeOver K (AlgebraicClosure K)
          (CategoryTheory.Over.mk (U.ι ≫ Y.hom))).hom =
          U_bar.ι ≫ (weilBaseChangeOver K (AlgebraicClosure K) Y).hom := by
    intro Y U j_bar hpb_bc hj_snd pr_Y U_bar
    let fst_U : weilGeomScheme K (CategoryTheory.Over.mk (U.ι ≫ Y.hom)) ⟶ U.toScheme :=
      CategoryTheory.Limits.pullback.fst (CategoryTheory.Over.mk (U.ι ≫ Y.hom)).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
    have hpb_bc' : CategoryTheory.IsPullback fst_U j_bar U.ι pr_Y := hpb_bc
    have hpb_res : CategoryTheory.IsPullback (pr_Y ∣_ U : U_bar.toScheme ⟶ U.toScheme)
        U_bar.ι U.ι pr_Y :=
      AlgebraicGeometry.isPullback_morphismRestrict pr_Y U
    let hom_δ : U_bar.toScheme ⟶ weilGeomScheme K (CategoryTheory.Over.mk (U.ι ≫ Y.hom)) :=
      hpb_bc'.lift (pr_Y ∣_ U : U_bar.toScheme ⟶ U.toScheme) U_bar.ι hpb_res.w
    let inv_δ : weilGeomScheme K (CategoryTheory.Over.mk (U.ι ≫ Y.hom)) ⟶ U_bar.toScheme :=
      hpb_res.lift fst_U j_bar hpb_bc'.w
    have hj : hom_δ ≫ j_bar = U_bar.ι := hpb_bc'.lift_snd _ _ _
    have hsnd_δ : hom_δ ≫ (weilBaseChangeOver K (AlgebraicClosure K)
        (CategoryTheory.Over.mk (U.ι ≫ Y.hom))).hom =
        U_bar.ι ≫ (weilBaseChangeOver K (AlgebraicClosure K) Y).hom := by
      rw [← hj_snd, ← CategoryTheory.Category.assoc, hj]
    exact ⟨{
      hom := hom_δ
      inv := inv_δ
      hom_inv_id := hpb_res.hom_ext
        (by rw [CategoryTheory.Category.assoc, hpb_res.lift_fst, hpb_bc'.lift_fst,
            CategoryTheory.Category.id_comp])
        (by rw [CategoryTheory.Category.assoc, hpb_res.lift_snd, hpb_bc'.lift_snd,
            CategoryTheory.Category.id_comp])
      inv_hom_id := hpb_bc'.hom_ext
        (by rw [CategoryTheory.Category.assoc, hpb_bc'.lift_fst, hpb_res.lift_fst,
            CategoryTheory.Category.id_comp])
        (by rw [CategoryTheory.Category.assoc, hpb_bc'.lift_snd, hpb_res.lift_snd,
            CategoryTheory.Category.id_comp]) },
      hj, hsnd_δ⟩

  have hOpenOverTransfer : ∀ {Y X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))}
      (U : Y.left.Opens) (e : U.toScheme ≅ X.left)
      (_ : e.hom ≫ X.hom = U.ι ≫ Y.hom),
      let pr_Y : weilGeomScheme K Y ⟶ Y.left := CategoryTheory.Limits.pullback.fst Y.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
      let U_bar : (weilGeomScheme K Y).Opens := (TopologicalSpace.Opens.map pr_Y.base).obj U
      (∃ e_bar : U_bar.toScheme ≅ weilGeomScheme K X,
        e_bar.hom ≫ (weilBaseChangeOver K (AlgebraicClosure K) X).hom =
          U_bar.ι ≫ (weilBaseChangeOver K (AlgebraicClosure K) Y).hom) ∧
      (∀ (q c_val : ℕ),
        (∀ (f_X : weilEtaleTorsionH (weilGeomScheme K X) (ℓ ^ (r + 1)) q →+
              weilEtaleTorsionH (weilGeomScheme K X) (ℓ ^ (r + 1)) q),
          WeilIsTorsionGeomFrobAction K X (ℓ ^ (r + 1)) q f_X →
          ∀ u, f_X u = c_val • u) →
        ∀ (f_Y : weilEtaleTorsionH (weilGeomScheme K Y) (ℓ ^ (r + 1)) q →+
              weilEtaleTorsionH (weilGeomScheme K Y) (ℓ ^ (r + 1)) q)
          (p_U : weilEtaleTorsionH (weilGeomScheme K Y) (ℓ ^ (r + 1)) q →+
              weilEtaleTorsionH U_bar.toScheme (ℓ ^ (r + 1)) q),
          WeilIsTorsionGeomFrobAction K Y (ℓ ^ (r + 1)) q f_Y →
          WeilIsTorsionEtalePullback U_bar.ι (ℓ ^ (r + 1)) q p_U →
          ∀ w, p_U (f_Y w - c_val • w) = 0) := by
    intro Y X U e he pr_Y U_bar
    obtain ⟨j_bar, hj_fst, hpb_j⟩ :=
      hMakeBcHom (X₁ := CategoryTheory.Over.mk (U.ι ≫ Y.hom)) (X₂ := Y)
        (CategoryTheory.Over.homMk U.ι rfl)
    obtain ⟨e_ov_bar, _, he_hom_snd, he_inv_fst, he_inv_snd⟩ :=
      hMakeBcIso (X₁ := CategoryTheory.Over.mk (U.ι ≫ Y.hom)) (X₂ := X)
        (CategoryTheory.Over.isoMk e he)
    obtain ⟨δ_U, hδ_j, hδ_snd⟩ := hOpenBcIso Y U j_bar.left hpb_j j_bar.w
    refine ⟨⟨δ_U ≪≫ e_ov_bar, ?_⟩, ?_⟩
    · rw [CategoryTheory.Iso.trans_hom, CategoryTheory.Category.assoc, he_hom_snd, hδ_snd]
    · intro q c_val hX_frob f_Y p_U hf_Y hp_U w
      obtain ⟨f_Uov, hf_Uov⟩ :=
        (hFrobModPkg K (CategoryTheory.Over.mk (U.ι ≫ Y.hom))).1 (ℓ ^ (r + 1)) q
      obtain ⟨f_X, hf_X⟩ := (hFrobModPkg K X).1 (ℓ ^ (r + 1)) q
      obtain ⟨p_j, hp_j⟩ := hPullEx j_bar.left (ℓ ^ (r + 1)) q
      obtain ⟨p_δ, hp_δ⟩ := hPullEx δ_U.hom (ℓ ^ (r + 1)) q
      obtain ⟨p_ehom, hp_ehom⟩ := hPullEx e_ov_bar.hom (ℓ ^ (r + 1)) q
      obtain ⟨p_einv, hp_einv⟩ := hPullEx e_ov_bar.inv (ℓ ^ (r + 1)) q
      have hp_U_fac : p_U = p_δ.comp p_j := by
        apply hPullComp δ_U.hom j_bar.left (ℓ ^ (r + 1)) q p_δ p_j p_U hp_δ hp_j
        rwa [hδ_j]
      have hNat_j := hOverFrob (CategoryTheory.Over.homMk U.ι rfl) j_bar.left hj_fst j_bar.w
        q f_Uov f_Y p_j hf_Uov hf_Y hp_j w
      have hUov_frob : ∀ v, f_Uov v = c_val • v := by
        intro v
        have hBij_einv := hPullIsoBij e_ov_bar.symm (ℓ ^ (r + 1)) q p_einv p_ehom hp_einv hp_ehom
        apply hBij_einv.1
        have hNat_e := hOverFrob (CategoryTheory.Over.isoMk e he).inv e_ov_bar.inv
          he_inv_fst he_inv_snd q f_X f_Uov p_einv hf_X hf_Uov hp_einv v
        rw [hNat_e, hX_frob f_X hf_X (p_einv v), map_nsmul]
      rw [hp_U_fac, AddMonoidHom.comp_apply, map_sub, map_nsmul, hNat_j, hUov_frob (p_j w),
        sub_self, map_zero]

  
  have hAffBcIso : ∀ (N : ℕ),
      ∃ e : weilGeomScheme K (weilAffineSpaceOver K N) ≅
          (weilAffineSpaceOver (AlgebraicClosure K) N).left,
        e.hom ≫ (weilAffineSpaceOver (AlgebraicClosure K) N).hom =
          (weilBaseChangeOver K (AlgebraicClosure K) (weilAffineSpaceOver K N)).hom := by
    intro N
    let comm_eq : TensorProduct K (MvPolynomial (Fin N) K) (AlgebraicClosure K) ≃+*
        TensorProduct K (AlgebraicClosure K) (MvPolynomial (Fin N) K) :=
      (Algebra.TensorProduct.comm K (MvPolynomial (Fin N) K) (AlgebraicClosure K)).toRingEquiv
    let poly_eq : TensorProduct K (AlgebraicClosure K) (MvPolynomial (Fin N) K) ≃ₐ[AlgebraicClosure K]
        MvPolynomial (Fin N) (AlgebraicClosure K) :=
      MvPolynomial.algebraTensorAlgEquiv K (AlgebraicClosure K)
    let ring_eq := comm_eq.trans poly_eq.toRingEquiv
    have hSpecAlg : ∃ spec_alg : AlgebraicGeometry.Spec
        (CommRingCat.of (TensorProduct K (MvPolynomial (Fin N) K) (AlgebraicClosure K))) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin N) (AlgebraicClosure K))),
        spec_alg.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ring_eq.symm.toRingHom) :=
      ⟨{ hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ring_eq.symm.toRingHom)
         inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ring_eq.toRingHom)
         hom_inv_id := by
           rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
           have h : ring_eq.symm.toRingHom.comp ring_eq.toRingHom = RingHom.id _ :=
             RingHom.ext ring_eq.symm_apply_apply
           rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
         inv_hom_id := by
           rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
           have h : ring_eq.toRingHom.comp ring_eq.symm.toRingHom = RingHom.id _ :=
             RingHom.ext ring_eq.apply_symm_apply
           rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }, rfl⟩
    obtain ⟨spec_alg, hspec_hom⟩ := hSpecAlg
    let pb_iso := AlgebraicGeometry.pullbackSpecIso K (MvPolynomial (Fin N) K) (AlgebraicClosure K)
    have he_spec : (pb_iso ≪≫ spec_alg).hom ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (AlgebraicClosure K)
            (MvPolynomial (Fin N) (AlgebraicClosure K)))) =
        CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin N) K))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) := by
      rw [CategoryTheory.Iso.trans_hom, hspec_hom, CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h2 : ring_eq.symm.toRingHom.comp
          (algebraMap (AlgebraicClosure K) (MvPolynomial (Fin N) (AlgebraicClosure K))) =
          Algebra.TensorProduct.includeRight.toRingHom :=
        RingHom.ext fun c => by
          change comm_eq.symm (poly_eq.symm
            (algebraMap (AlgebraicClosure K) (MvPolynomial (Fin N) (AlgebraicClosure K)) c)) = _
          rw [poly_eq.symm.commutes c]
          rfl
      rw [h2]
      exact AlgebraicGeometry.pullbackSpecIso_hom_snd K (MvPolynomial (Fin N) K)
        (AlgebraicClosure K)
    exact ⟨pb_iso ≪≫ spec_alg, he_spec⟩

  have hProdAffBc : ∀ (δ : ℕ)
      (e_δ : weilGeomScheme K (weilAffineSpaceOver K δ) ≅
        (weilAffineSpaceOver (AlgebraicClosure K) δ).left)
      (_ : e_δ.hom ≫ (weilAffineSpaceOver (AlgebraicClosure K) δ).hom =
        (weilBaseChangeOver K (AlgebraicClosure K) (weilAffineSpaceOver K δ)).hom)
      (pr1_bar : weilGeomScheme K
          (CategoryTheory.Over.mk
            (CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K δ).hom
              (weilAffineSpaceOver K 1).hom ≫ (weilAffineSpaceOver K δ).hom)) ⟶
        weilGeomScheme K (weilAffineSpaceOver K δ)),
      pr1_bar ≫ (CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K δ).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :
          weilGeomScheme K (weilAffineSpaceOver K δ) ⟶ (weilAffineSpaceOver K δ).left) =
        (CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Over.mk
            (CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K δ).hom
              (weilAffineSpaceOver K 1).hom ≫ (weilAffineSpaceOver K δ).hom)).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :
          weilGeomScheme K
            (CategoryTheory.Over.mk
              (CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K δ).hom
                (weilAffineSpaceOver K 1).hom ≫ (weilAffineSpaceOver K δ).hom)) ⟶
            (CategoryTheory.Over.mk
              (CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K δ).hom
                (weilAffineSpaceOver K 1).hom ≫ (weilAffineSpaceOver K δ).hom)).left) ≫
          CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K δ).hom
            (weilAffineSpaceOver K 1).hom →
      pr1_bar ≫ (weilBaseChangeOver K (AlgebraicClosure K) (weilAffineSpaceOver K δ)).hom =
        (weilBaseChangeOver K (AlgebraicClosure K)
          (CategoryTheory.Over.mk
            (CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K δ).hom
              (weilAffineSpaceOver K 1).hom ≫ (weilAffineSpaceOver K δ).hom))).hom →
      ∃ e_P : weilGeomScheme K
          (CategoryTheory.Over.mk
