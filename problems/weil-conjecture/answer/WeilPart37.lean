        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : α_prod.symm.toRingHom.comp α_prod.toRingHom = RingHom.id _ :=
            RingHom.ext α_prod.symm_apply_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    let e_prod : V ≅
        CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K S_d)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K S_1))) :=
      i_V ≪≫ Spec_prod ≪≫ (AlgebraicGeometry.pullbackSpecIso K S_d S_1).symm
    have he_prod :
