      RingHom.ker ε₂ ≤ Ideal.comap φ₂₀ q₁.asIdeal →
      ∃ t_B : B₁, t_B ∉ q₁.asIdeal ∧
        let loc : B₁ →+* Localization.Away t_B := algebraMap B₁ (Localization.Away t_B)
        ∃ q₀ : PrimeSpectrum (Localization.Away t_B),
          (loc.comp φ₁₀).Etale ∧
          (loc.comp φ₂₀).Etale ∧
          PrimeSpectrum.comap loc q₀ = q₁ ∧
          Ideal.map (loc.comp φ₁₀) (RingHom.ker ε₁) = q₀.asIdeal ∧
          Ideal.map (loc.comp φ₂₀) (RingHom.ker ε₂) = q₀.asIdeal := by
    intro K₁ K₂ _ _ R₁ R₂ _ _ σ₁ ε₁ hε₁ σ₂ ε₂ hε₂ B₁ _ q₁ φ₁₀ hφ₁ φ₂₀ hφ₂ hq₁ hq₂
    have hSingle : ∀ (K : Type u) [Field K] (R : Type u) [CommRing R]
        (σ : K →+* R) (ε : R →+* K), ε.comp σ = RingHom.id K →
        ∀ (φ₀ : R →+* B₁), φ₀.Etale → RingHom.ker ε ≤ Ideal.comap φ₀ q₁.asIdeal →
        ∃ t : B₁, t ∉ q₁.asIdeal ∧ ∀ z ∈ q₁.asIdeal, t * z ∈ Ideal.map φ₀ (RingHom.ker ε) := by
      intro K _ R _ σ ε hε φ₀ hφ₀ hq
      let I : Ideal B₁ := Ideal.map φ₀ (RingHom.ker ε)
      have hI_le : I ≤ q₁.asIdeal := Ideal.map_le_iff_le_comap.mpr hq
      let π : B₁ →+* (B₁ ⧸ I) := Ideal.Quotient.mk I
      let _ : Algebra R K := ε.toAlgebra
      let _ : Algebra R B₁ := φ₀.toAlgebra
      let _ : Algebra K (B₁ ⧸ I) := (π.comp (φ₀.comp σ)).toAlgebra
      have : IsScalarTower R K K := IsScalarTower.of_algebraMap_eq' rfl
      have hTower_Q : ∀ r : R, r • (1 : B₁ ⧸ I) = (algebraMap R K r) • (1 : B₁ ⧸ I) := by
        intro r
        change π (φ₀ r) * 1 = π (φ₀ (σ (ε r))) * 1
        rw [mul_one, mul_one, Ideal.Quotient.eq]
        have hmem : r - σ (ε r) ∈ RingHom.ker ε := by
          rw [RingHom.mem_ker, map_sub]
          have h1 : ε (σ (ε r)) = (ε.comp σ) (ε r) := rfl
          rw [h1, hε, RingHom.id_apply, sub_self]
        rw [← map_sub]
        exact Ideal.mem_map_of_mem φ₀ hmem
      have : IsScalarTower R K (B₁ ⧸ I) := by
        refine IsScalarTower.of_algebraMap_eq fun r => ?_
        have h := hTower_Q r
        rwa [Algebra.smul_def, Algebra.smul_def, mul_one, mul_one] at h
      let π_alg : B₁ →ₐ[R] (B₁ ⧸ I) := Ideal.Quotient.mkₐ R I
      let fwd : TensorProduct R K B₁ →ₐ[K] (B₁ ⧸ I) :=
        Algebra.TensorProduct.lift (Algebra.ofId K (B₁ ⧸ I)) π_alg (fun _ _ => Commute.all _ _)
      have hker_incR : I ≤ RingHom.ker (Algebra.TensorProduct.includeRight : B₁ →ₐ[R] TensorProduct R K B₁).toRingHom := by
        rw [Ideal.map_le_iff_le_comap]
        intro r hr
        change (1 : K) ⊗ₜ[R] φ₀ r = 0
        have hsmul : φ₀ r = r • (1 : B₁) := by
          change φ₀ r = algebraMap R B₁ r * 1
          rw [mul_one]; rfl
        rw [hsmul, ← TensorProduct.smul_tmul]
        have hr0 : r • (1 : K) = 0 := by
          change ε r * 1 = 0
          rw [RingHom.mem_ker.mp hr, zero_mul]
        rw [hr0, TensorProduct.zero_tmul]
      let inv : (B₁ ⧸ I) →+* TensorProduct R K B₁ :=
        Ideal.Quotient.lift I (Algebra.TensorProduct.includeRight : B₁ →ₐ[R] TensorProduct R K B₁).toRingHom hker_incR
      have hleft : Function.LeftInverse inv fwd.toRingHom := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul c b =>
          have hf : fwd.toRingHom (c ⊗ₜ[R] b) = π (φ₀ (σ c) * b) := by
            change fwd (c ⊗ₜ[R] b) = π (φ₀ (σ c) * b)
            rw [Algebra.TensorProduct.lift_tmul]
            change π (φ₀ (σ c)) * π b = π (φ₀ (σ c) * b)
            rw [map_mul]
          rw [hf]
          change (1 : K) ⊗ₜ[R] (φ₀ (σ c) * b) = c ⊗ₜ[R] b
          have hsmul : φ₀ (σ c) * b = (σ c) • b := rfl
          rw [hsmul, ← TensorProduct.smul_tmul]
          have hc : (σ c) • (1 : K) = c := by
            change ε (σ c) * 1 = c
            have h1 : ε (σ c) = (ε.comp σ) c := rfl
            rw [h1, hε, RingHom.id_apply, mul_one]
          rw [hc]
        | add x y ihx ihy =>
          rw [map_add, map_add, ihx, ihy]
      have hright : Function.RightInverse inv fwd.toRingHom := by
        intro q
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q
        change fwd ((1 : K) ⊗ₜ[R] b) = π b
        simp [fwd, π_alg, π]
      let e_ring : TensorProduct R K B₁ ≃+* (B₁ ⧸ I) :=
        { fwd.toRingHom with
          invFun := inv
          left_inv := hleft
          right_inv := hright }
      let Θ : TensorProduct R K B₁ ≃ₐ[K] (B₁ ⧸ I) :=
        AlgEquiv.ofRingEquiv (f := e_ring) (fun c => fwd.commutes c)
      have : Algebra.Etale R B₁ := RingHom.etale_algebraMap.mp hφ₀
      have : Algebra.Etale K (TensorProduct R K B₁) := Algebra.Etale.baseChange R B₁ K
      have : Algebra.Etale K (B₁ ⧸ I) := Algebra.Etale.of_equiv Θ
      obtain ⟨J, hFinJ, L, hFieldL, hAlgL, e_Q, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K (B₁ ⧸ I)).mp inferInstance
      let _ : Fintype J := Fintype.ofFinite J
      let _ : ∀ j, Field (L j) := hFieldL
      let _ : ∀ j, Algebra K (L j) := hAlgL
      classical
      let f_prod : B₁ →+* (∀ j : J, L j) := e_Q.toRingHom.comp π
      have hf_surj : Function.Surjective f_prod := e_Q.surjective.comp Ideal.Quotient.mk_surjective
      have hker_f : RingHom.ker f_prod = I := by
        ext b
        simp only [RingHom.mem_ker, f_prod, RingHom.comp_apply]
        rw [show e_Q.toRingHom (π b) = 0 ↔ π b = 0 from map_eq_zero_iff _ e_Q.injective]
        exact Ideal.Quotient.eq_zero_iff_mem
      let P_prod : Ideal (∀ j : J, L j) := Ideal.map f_prod q₁.asIdeal
      have hcomap_P : Ideal.comap f_prod P_prod = q₁.asIdeal := by
        rw [Ideal.comap_map_of_surjective f_prod hf_surj, ← RingHom.ker_eq_comap_bot, hker_f,
          sup_eq_left.mpr hI_le]
      have h1_notMem : (1 : ∀ j : J, L j) ∉ P_prod := by
        intro h1
        have : (1 : B₁) ∈ Ideal.comap f_prod P_prod := by
          change f_prod 1 ∈ P_prod
          rwa [map_one]
        rw [hcomap_P] at this
        exact q₁.isPrime.one_notMem this
      have hsum_single : (∑ j : J, Pi.single j (1 : L j)) = (1 : ∀ j : J, L j) := by
        ext j
        simp [Finset.sum_apply]
      have hex_j : ∃ j₀ : J, Pi.single j₀ (1 : L j₀) ∉ P_prod := by
        by_contra hall
        apply h1_notMem
        rw [← hsum_single]
        exact Ideal.sum_mem P_prod (fun j _ => by by_contra hnot; exact hall ⟨j, hnot⟩)
      obtain ⟨j₀, hj₀_notMem⟩ := hex_j
      obtain ⟨t, ht_eq⟩ := hf_surj (Pi.single j₀ (1 : L j₀))
      have ht_notMem : t ∉ q₁.asIdeal := by
        intro ht
        have hmem := Ideal.mem_map_of_mem f_prod ht
        rw [ht_eq] at hmem
        exact hj₀_notMem hmem
      refine ⟨t, ht_notMem, fun z hz => ?_⟩
      let w : ∀ j : J, L j := f_prod z
      have hw_mem : w ∈ P_prod := Ideal.mem_map_of_mem f_prod hz
      have hw_j0 : w j₀ = 0 := by
        by_contra hne
        apply hj₀_notMem
        have hmul : Pi.single j₀ (w j₀)⁻¹ * w = Pi.single j₀ (1 : L j₀) := by
          ext j
          by_cases hj : j = j₀
          · subst hj; simp [inv_mul_cancel₀ hne]
          · simp [hj]
        rw [← hmul]
        exact P_prod.mul_mem_left _ hw_mem
      have htz_ker : t * z ∈ RingHom.ker f_prod := by
        rw [RingHom.mem_ker, map_mul, ht_eq]
        ext j
        by_cases hj : j = j₀
        · subst hj; simp [w, hw_j0]
        · simp [hj]
      rwa [hker_f] at htz_ker
    obtain ⟨t₁, ht₁, hAnn₁⟩ := hSingle K₁ R₁ σ₁ ε₁ hε₁ φ₁₀ hφ₁ hq₁
    obtain ⟨t₂, ht₂, hAnn₂⟩ := hSingle K₂ R₂ σ₂ ε₂ hε₂ φ₂₀ hφ₂ hq₂
    let t_B : B₁ := t₁ * t₂
    have ht_B : t_B ∉ q₁.asIdeal := q₁.isPrime.mul_notMem ht₁ ht₂
    refine ⟨t_B, ht_B, ?_⟩
    intro loc
    have hEt_loc_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc)) := by
      have : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc)) :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization t_B
      infer_instance
    have hEt_comp : ∀ {R : Type u} [CommRing R] (φ : R →+* B₁), φ.Etale → (loc.comp φ).Etale := by
      intro R _ φ hφ
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hφ
      have hcomp_et : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (loc.comp φ))) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
        infer_instance
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hcomp_et
    have hdisj : Disjoint (Submonoid.powers t_B : Set B₁) (q₁.asIdeal : Set B₁) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hmem
      exact ht_B (q₁.isPrime.mem_of_pow_mem n hmem)
    have hPrime_q0 : (Ideal.map loc q₁.asIdeal).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers t_B) (Localization.Away t_B)
        q₁.asIdeal q₁.isPrime hdisj
    let q₀ : PrimeSpectrum (Localization.Away t_B) := ⟨Ideal.map loc q₁.asIdeal, hPrime_q0⟩
    have hcomap_q0 : PrimeSpectrum.comap loc q₀ = q₁ := by
      ext x
      have hunder := IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers t_B)
        (Localization.Away t_B) q₁.isPrime hdisj
      change x ∈ Ideal.under B₁ (Ideal.map loc q₁.asIdeal) ↔ x ∈ q₁.asIdeal
      rw [hunder]
    have hUnit_tB : IsUnit (loc t_B) := IsLocalization.Away.algebraMap_isUnit t_B
    have hEq_leg : ∀ {R : Type u} [CommRing R] (J : Ideal R) (φ : R →+* B₁),
        J ≤ Ideal.comap φ q₁.asIdeal →
        (∀ z ∈ q₁.asIdeal, t_B * z ∈ Ideal.map φ J) →
        Ideal.map (loc.comp φ) J = q₀.asIdeal := by
      intro R _ J φ hJ hAnn
      rw [← Ideal.map_map]
      apply le_antisymm
      · exact Ideal.map_mono (Ideal.map_le_iff_le_comap.mpr hJ)
      · rw [Ideal.map_le_iff_le_comap]
        intro z hz
        change loc z ∈ Ideal.map loc (Ideal.map φ J)
        have htz : loc (t_B * z) ∈ Ideal.map loc (Ideal.map φ J) :=
          Ideal.mem_map_of_mem loc (hAnn z hz)
        obtain ⟨u, hu⟩ := hUnit_tB
        have hz_eq : loc z = ↑u⁻¹ * loc (t_B * z) := by
          rw [map_mul, ← hu, Units.inv_mul_cancel_left]
        rw [hz_eq]
        exact (Ideal.map loc (Ideal.map φ J)).mul_mem_left _ htz
    refine ⟨q₀, hEt_comp φ₁₀ hφ₁, hEt_comp φ₂₀ hφ₂, hcomap_q0, ?_, ?_⟩
    · apply hEq_leg (RingHom.ker ε₁) φ₁₀ hq₁
      intro z hz
      have h1 : t_B * z = t₂ * (t₁ * z) := by ring
      rw [h1]
      exact (Ideal.map φ₁₀ (RingHom.ker ε₁)).mul_mem_left _ (hAnn₁ z hz)
    · apply hEq_leg (RingHom.ker ε₂) φ₂₀ hq₂
      intro z hz
      have h2 : t_B * z = t₁ * (t₂ * z) := by ring
      rw [h2]
      exact (Ideal.map φ₂₀ (RingHom.ker ε₂)).mul_mem_left _ (hAnn₂ z hz)

  
  have h_s4 : ∀ (F₀ : Type u) [Field F₀] (m₀ : ℕ)
      (A₀ : Type u) [CommRing A₀] [Algebra F₀ A₀]
      (E₁ : Type u) [Field E₁] [Algebra F₀ E₁] [FiniteDimensional F₀ E₁] [Algebra.IsSeparable F₀ E₁]
      (B' : Type u) [CommRing B'] (q₀ : PrimeSpectrum B')
      (φ₁ : A₀ →+* B'), φ₁.Etale →
      ∀ (φ₂ : (MvPolynomial (Fin (m₀ + 1) × Fin 2) E₁ ⧸
        Ideal.span {∑ j : Fin (m₀ + 1),
          (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) E₁) *
            MvPolynomial.X (j, 1)}) →+* B'),
      φ₂.Etale →
      φ₁.comp (algebraMap F₀ A₀) =
        φ₂.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C.comp (algebraMap F₀ E₁))) →
      ∀ (E : Type u) [Field E] [Algebra F₀ E]
        (p_E : PrimeSpectrum (TensorProduct F₀ E A₀)),
      PrimeSpectrum.comap
        (Algebra.TensorProduct.includeRight : A₀ →ₐ[F₀] TensorProduct F₀ E A₀).toRingHom p_E =
        PrimeSpectrum.comap φ₁ q₀ →
      _root_.IsReduced (Localization.AtPrime p_E.asIdeal) := by
    intro F₀ _ m₀ A₀ _ _ E₁ _ _ _ _ B' _ q₀ φ₁ hφ₁_et φ₂ hφ₂_et hφ_alg E _ _ p_E hp_E
    have hEtComp : ∀ {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
        {f : R →+* S} {g : S →+* T}, f.Etale → g.Etale → (g.comp f).Etale := by
      intro R S T _ _ _ f g hf hg
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hg
      have hcomp : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (g.comp f))) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
        infer_instance
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hcomp
    have hConePushout : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (ρ : R₁ →+* R₂),
        let J₁ : Ideal (MvPolynomial (Fin (m₀ + 1) × Fin 2) R₁) :=
          Ideal.span {∑ j : Fin (m₀ + 1),
            (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) R₁) * MvPolynomial.X (j, 1)}
        let J₂ : Ideal (MvPolynomial (Fin (m₀ + 1) × Fin 2) R₂) :=
          Ideal.span {∑ j : Fin (m₀ + 1),
            (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) R₂) * MvPolynomial.X (j, 1)}
        ∃ τ : (MvPolynomial (Fin (m₀ + 1) × Fin 2) R₁ ⧸ J₁) →+*
            (MvPolynomial (Fin (m₀ + 1) × Fin 2) R₂ ⧸ J₂),
          τ.comp ((Ideal.Quotient.mk J₁).comp MvPolynomial.C) =
            ((Ideal.Quotient.mk J₂).comp MvPolynomial.C).comp ρ ∧
          CategoryTheory.IsPushout
            (CommRingCat.ofHom ((Ideal.Quotient.mk J₁).comp MvPolynomial.C))
            (CommRingCat.ofHom ρ)
            (CommRingCat.ofHom τ)
            (CommRingCat.ofHom ((Ideal.Quotient.mk J₂).comp MvPolynomial.C)) := by
      intro R₁ R₂ _ _ ρ J₁ J₂
      have hker : ∀ a ∈ J₁, ((Ideal.Quotient.mk J₂).comp (MvPolynomial.map ρ)) a = 0 := by
        intro a ha
        change a ∈ RingHom.ker ((Ideal.Quotient.mk J₂).comp (MvPolynomial.map ρ))
        refine Ideal.span_le.mpr ?_ ha
        rintro _ ⟨rfl⟩
        have hmap_gen : MvPolynomial.map ρ
            (∑ j : Fin (m₀ + 1),
              (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) R₁) * MvPolynomial.X (j, 1)) =
            ∑ j : Fin (m₀ + 1),
              (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) R₂) * MvPolynomial.X (j, 1) := by
          simp
        rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, hmap_gen]
        exact (Ideal.Quotient.eq_zero_iff_mem (I := J₂)).mpr (Ideal.subset_span rfl)
      let τ : (MvPolynomial (Fin (m₀ + 1) × Fin 2) R₁ ⧸ J₁) →+*
          (MvPolynomial (Fin (m₀ + 1) × Fin 2) R₂ ⧸ J₂) :=
        Ideal.Quotient.lift J₁ ((Ideal.Quotient.mk J₂).comp (MvPolynomial.map ρ)) hker
      have hcomm_hom : τ.comp ((Ideal.Quotient.mk J₁).comp MvPolynomial.C) =
          ((Ideal.Quotient.mk J₂).comp MvPolynomial.C).comp ρ := by
        ext r
        change Ideal.Quotient.lift J₁ ((Ideal.Quotient.mk J₂).comp (MvPolynomial.map ρ)) hker
            (Ideal.Quotient.mk J₁ (MvPolynomial.C r)) =
          Ideal.Quotient.mk J₂ (MvPolynomial.C (ρ r))
        rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_C]
      have hcomm_cat : CommRingCat.ofHom ((Ideal.Quotient.mk J₁).comp MvPolynomial.C) ≫
          CommRingCat.ofHom τ =
          CommRingCat.ofHom ρ ≫
            CommRingCat.ofHom ((Ideal.Quotient.mk J₂).comp MvPolynomial.C) := by
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hcomm_hom]
      let cocone := CategoryTheory.Limits.PushoutCocone.mk
        (CommRingCat.ofHom τ)
        (CommRingCat.ofHom ((Ideal.Quotient.mk J₂).comp MvPolynomial.C)) hcomm_cat
      refine ⟨τ, hcomm_hom, CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.isColimitAux' cocone fun sc => ?_)⟩
      let f₁ : (MvPolynomial (Fin (m₀ + 1) × Fin 2) R₁ ⧸ J₁) →+* sc.pt := sc.inl.hom
      let f₂ : R₂ →+* sc.pt := sc.inr.hom
      have hs_cond : ∀ r : R₁, f₁ (Ideal.Quotient.mk J₁ (MvPolynomial.C r)) = f₂ (ρ r) :=
        fun r => congrArg (fun φ => φ.hom r) sc.condition
      let ev : MvPolynomial (Fin (m₀ + 1) × Fin 2) R₂ →+* sc.pt :=
        MvPolynomial.eval₂Hom f₂ (fun idx => f₁ (Ideal.Quotient.mk J₁ (MvPolynomial.X idx)))
      have hker_ev : ∀ a ∈ J₂, ev a = 0 := by
        intro a ha
        change a ∈ RingHom.ker ev
        refine Ideal.span_le.mpr ?_ ha
        rintro _ ⟨rfl⟩
        simp only [SetLike.mem_coe, RingHom.mem_ker, ev, map_sum, map_mul, MvPolynomial.eval₂Hom_X']
        have hgen0 : Ideal.Quotient.mk J₁
            (∑ j : Fin (m₀ + 1),
              (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) R₁) *
                MvPolynomial.X (j, 1)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        have hmap : ∑ j : Fin (m₀ + 1),
            f₁ (Ideal.Quotient.mk J₁ (MvPolynomial.X (j, 0))) *
              f₁ (Ideal.Quotient.mk J₁ (MvPolynomial.X (j, 1))) =
            f₁ (Ideal.Quotient.mk J₁
              (∑ j : Fin (m₀ + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1))) := by
          simp [map_sum, map_mul]
        rw [hmap, hgen0, map_zero]
      let l_hom : (MvPolynomial (Fin (m₀ + 1) × Fin 2) R₂ ⧸ J₂) →+* sc.pt :=
        Ideal.Quotient.lift J₂ ev hker_ev
      refine ⟨CommRingCat.ofHom l_hom, ?_, ?_, ?_⟩
      · refine CommRingCat.hom_ext (RingHom.ext fun q => ?_)
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q
        change l_hom (τ (Ideal.Quotient.mk J₁ P)) = f₁ (Ideal.Quotient.mk J₁ P)
        induction P using MvPolynomial.induction_on with
        | C r =>
          have hl : l_hom (τ (Ideal.Quotient.mk J₁ (MvPolynomial.C r))) = f₂ (ρ r) := by
            simp [l_hom, τ, ev]
          rw [hl, hs_cond r]
        | add p₁ p₂ ih₁ ih₂ =>
          rw [map_add, map_add, map_add, map_add, ih₁, ih₂]
        | mul_X p idx ih =>
          have hx : l_hom (τ (Ideal.Quotient.mk J₁ (MvPolynomial.X idx))) =
              f₁ (Ideal.Quotient.mk J₁ (MvPolynomial.X idx)) := by
            simp [l_hom, τ, ev]
          rw [map_mul, map_mul, map_mul, map_mul, ih, hx]
      · refine CommRingCat.hom_ext (RingHom.ext fun r₂ => ?_)
        change l_hom (Ideal.Quotient.mk J₂ (MvPolynomial.C r₂)) = f₂ r₂
        simp [l_hom, ev]
      · intro m_cat hm_inl hm_inr
        let m_hom : (MvPolynomial (Fin (m₀ + 1) × Fin 2) R₂ ⧸ J₂) →+* sc.pt := m_cat.hom
        refine CommRingCat.hom_ext (RingHom.ext fun q => ?_)
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q
        change m_hom (Ideal.Quotient.mk J₂ P) = l_hom (Ideal.Quotient.mk J₂ P)
        induction P using MvPolynomial.induction_on with
        | C r₂ =>
          have h1 : m_hom (Ideal.Quotient.mk J₂ (MvPolynomial.C r₂)) = f₂ r₂ :=
            congrArg (fun φ => φ.hom r₂) hm_inr
          rw [h1]
          simp [l_hom, ev]
        | add p₁ p₂ ih₁ ih₂ =>
          rw [map_add, map_add, map_add, ih₁, ih₂]
        | mul_X p idx ih =>
          rw [map_mul, map_mul, map_mul, ih]
          congr 1
          have h2 : m_hom (τ (Ideal.Quotient.mk J₁ (MvPolynomial.X idx))) =
              f₁ (Ideal.Quotient.mk J₁ (MvPolynomial.X idx)) :=
            congrArg (fun φ => φ.hom (Ideal.Quotient.mk J₁ (MvPolynomial.X idx))) hm_inl
          have hτX : τ (Ideal.Quotient.mk J₁ (MvPolynomial.X idx)) =
              Ideal.Quotient.mk J₂ (MvPolynomial.X idx) := by
            simp [τ]
          rw [← hτX, h2, hτX]
          simp [l_hom, ev]
    have hTensorMapPushout : ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra F₀ R] [Algebra F₀ S]
        (g : R →ₐ[F₀] S),
        CategoryTheory.IsPushout
          (CommRingCat.ofHom g.toRingHom)
          (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : R →ₐ[F₀] TensorProduct F₀ E R).toRingHom)
          (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : S →ₐ[F₀] TensorProduct F₀ E S).toRingHom)
          (CommRingCat.ofHom (Algebra.TensorProduct.map (AlgHom.id F₀ E) g).toRingHom) := by
      intro R S _ _ _ _ g
      let incR_R := (Algebra.TensorProduct.includeRight : R →ₐ[F₀] TensorProduct F₀ E R).toRingHom
      let incR_S := (Algebra.TensorProduct.includeRight : S →ₐ[F₀] TensorProduct F₀ E S).toRingHom
      let g_E := (Algebra.TensorProduct.map (AlgHom.id F₀ E) g).toRingHom
      have hcomm : CommRingCat.ofHom g.toRingHom ≫ CommRingCat.ofHom incR_S =
          CommRingCat.ofHom incR_R ≫ CommRingCat.ofHom g_E := by
        refine CommRingCat.hom_ext (RingHom.ext fun r => ?_)
        change (1 : E) ⊗ₜ[F₀] g r = g_E ((1 : E) ⊗ₜ[F₀] r)
        simp [g_E]
      let cocone := CategoryTheory.Limits.PushoutCocone.mk
        (CommRingCat.ofHom incR_S) (CommRingCat.ofHom g_E) hcomm
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.isColimitAux' cocone fun sc => ?_)
      let f_S : S →+* sc.pt := sc.inl.hom
      let f_ER : TensorProduct F₀ E R →+* sc.pt := sc.inr.hom
      have hs_cond : ∀ r : R, f_S (g r) = f_ER ((1 : E) ⊗ₜ[F₀] r) :=
        fun r => congrArg (fun φ => φ.hom r) sc.condition
      let _ : Algebra F₀ sc.pt := (f_S.comp (algebraMap F₀ S)).toAlgebra
      let f_E_alg : E →ₐ[F₀] sc.pt :=
        { toRingHom := f_ER.comp Algebra.TensorProduct.includeLeftRingHom
          commutes' := fun c => by
            change f_ER (algebraMap F₀ E c ⊗ₜ[F₀] (1 : R)) = f_S (algebraMap F₀ S c)
            have htmul : algebraMap F₀ E c ⊗ₜ[F₀] (1 : R) = (1 : E) ⊗ₜ[F₀] algebraMap F₀ R c := by
              rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one]
            rw [htmul, ← hs_cond, g.commutes] }
      let f_S_alg : S →ₐ[F₀] sc.pt :=
        { toRingHom := f_S
          commutes' := fun _ => rfl }
      let l_alg : TensorProduct F₀ E S →ₐ[F₀] sc.pt :=
        Algebra.TensorProduct.lift f_E_alg f_S_alg (fun _ _ => Commute.all _ _)
      refine ⟨CommRingCat.ofHom l_alg.toRingHom, ?_, ?_, ?_⟩
      · refine CommRingCat.hom_ext (RingHom.ext fun b => ?_)
        change l_alg ((1 : E) ⊗ₜ[F₀] b) = f_S b
        rw [Algebra.TensorProduct.lift_tmul]
        change f_ER ((1 : E) ⊗ₜ[F₀] (1 : R)) * f_S b = f_S b
        rw [← Algebra.TensorProduct.one_def, map_one, one_mul]
      · refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
        change l_alg (g_E x) = f_ER x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul e r =>
          change l_alg (e ⊗ₜ[F₀] g r) = f_ER (e ⊗ₜ[F₀] r)
          rw [Algebra.TensorProduct.lift_tmul]
          change f_ER (e ⊗ₜ[F₀] 1) * f_S (g r) = f_ER (e ⊗ₜ[F₀] r)
          rw [hs_cond r, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        | add x y ihx ihy =>
          rw [map_add, map_add, map_add, ihx, ihy]
      · intro m_cat hm_inl hm_inr
        let m_hom : TensorProduct F₀ E S →+* sc.pt := m_cat.hom
        refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
        change m_hom x = l_alg x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul e b =>
          have hdecomp : (e ⊗ₜ[F₀] b : TensorProduct F₀ E S) = (e ⊗ₜ[F₀] 1) * (1 ⊗ₜ[F₀] b) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hdecomp, map_mul, map_mul]
          have h1 : m_hom (g_E (e ⊗ₜ[F₀] (1 : R))) = f_ER (e ⊗ₜ[F₀] (1 : R)) :=
            congrArg (fun φ => φ.hom (e ⊗ₜ[F₀] (1 : R))) hm_inr
          have hg1 : g_E (e ⊗ₜ[F₀] (1 : R)) = e ⊗ₜ[F₀] (1 : S) := by
            change (Algebra.TensorProduct.map (AlgHom.id F₀ E) g) (e ⊗ₜ[F₀] 1) = _
            rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one]
          have h1' : m_hom (e ⊗ₜ[F₀] (1 : S)) = f_ER (e ⊗ₜ[F₀] (1 : R)) := by
            rwa [hg1] at h1
          have h2 : m_hom ((1 : E) ⊗ₜ[F₀] b) = f_S b := congrArg (fun φ => φ.hom b) hm_inl
          rw [h1', h2, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul]
          change f_ER (e ⊗ₜ[F₀] 1) * f_S b =
            (f_ER (e ⊗ₜ[F₀] 1) * f_S 1) * (f_ER ((1 : E) ⊗ₜ[F₀] (1 : R)) * f_S b)
          rw [map_one, mul_one, ← Algebra.TensorProduct.one_def, map_one, one_mul]
        | add x y ihx ihy =>
          rw [map_add, map_add, ihx, ihy]
    have : Algebra.FormallyEtale F₀ E₁ := Algebra.FormallyEtale.of_isSeparable F₀ E₁
    have : Algebra.FinitePresentation F₀ E₁ := Algebra.FinitePresentation.of_finiteType.mp inferInstance
    have : Algebra.Etale F₀ E₁ := {}
    have hFE₁_et : (algebraMap F₀ E₁).Etale := RingHom.etale_algebraMap.mpr inferInstance
    obtain ⟨τ_FE₁, hτ_FE₁_comm, hPush_FE₁⟩ := hConePushout (algebraMap F₀ E₁)
    have hPb_FE₁ := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_FE₁
    have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F₀ E₁))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hFE₁_et
    have hEt_spec_τFE₁ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_FE₁)) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_FE₁.flip inferInstance
    have hτ_FE₁_et : τ_FE₁.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_spec_τFE₁
    let ψ₀ := φ₂.comp τ_FE₁
    have hψ₀_et : ψ₀.Etale := hEtComp hτ_FE₁_et hφ₂_et
    let _ : Algebra F₀ B' := (φ₁.comp (algebraMap F₀ A₀)).toAlgebra
    let φ₁_alg : A₀ →ₐ[F₀] B' := { toRingHom := φ₁, commutes' := fun _ => rfl }
    let Φ₁_E : TensorProduct F₀ E A₀ →+* TensorProduct F₀ E B' :=
      (Algebra.TensorProduct.map (AlgHom.id F₀ E) φ₁_alg).toRingHom
    have hPush_Φ₁ := hTensorMapPushout φ₁_alg
    have hPb_Φ₁ := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_Φ₁
    have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁_alg.toRingHom)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hφ₁_et
    have hEt_spec_Φ₁ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ₁_E)) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Φ₁ inferInstance
    have hΦ₁_et : Φ₁_E.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_spec_Φ₁
    have hΦ₁_flat : Φ₁_E.Flat := by
      let _ : Algebra (TensorProduct F₀ E A₀) (TensorProduct F₀ E B') := Φ₁_E.toAlgebra
      have : Algebra.Etale (TensorProduct F₀ E A₀) (TensorProduct F₀ E B') :=
        RingHom.etale_algebraMap.mp hΦ₁_et
      exact RingHom.flat_algebraMap_iff.mpr inferInstance
    obtain ⟨q_E, _, hq_E_comap⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_Φ₁ q₀ p_E hp_E.symm
    let J_F : Ideal (MvPolynomial (Fin (m₀ + 1) × Fin 2) F₀) :=
      Ideal.span {∑ j : Fin (m₀ + 1),
        (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) F₀) * MvPolynomial.X (j, 1)}
    let ψ₀_alg : (MvPolynomial (Fin (m₀ + 1) × Fin 2) F₀ ⧸ J_F) →ₐ[F₀] B' :=
      { toRingHom := ψ₀
        commutes' := fun c => by
          change φ₂ (τ_FE₁ (Ideal.Quotient.mk J_F (MvPolynomial.C c))) = φ₁ (algebraMap F₀ A₀ c)
          have h1 : τ_FE₁ (Ideal.Quotient.mk J_F (MvPolynomial.C c)) =
