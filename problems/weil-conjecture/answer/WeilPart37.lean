      let U_et : (weilGeomScheme K X).Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U_bar.ι
        (inferInstance : AlgebraicGeometry.Etale U_bar.ι)
      obtain ⟨a_loc, ha_loc⟩ := weil_wl_closed_compl_zero_bdry_lift
        hModInj hModEx i_Z_bar.left hcl_bar U_bar hUbar_compl (ℓ ^ (r + 1)) (2 * d - 2 * c)
        p_iZ hp_iZ θ_i hθ_i ((Nat.card K ^ (d - c)) • a₀ - a) hγ₀_Z
      have hb₀_U : (CategoryTheory.Abelian.Ext.mk₀
          (weilCupPDLocalCounit (weilGeomScheme K X) (ℓ ^ (r + 1)) U_et)).comp b₀
          (Nat.zero_add (2 * c)) = 0 := by
        apply hOpenCounitZero (weilGeomScheme K X) U_bar (ℓ ^ (r + 1)) (2 * c) hn_mod
          θ_2c p_U hθ_2c hp_U b₀
        rw [hb₀]
        exact hx_U
      have hγ₀_b₀ : CategoryTheory.Abelian.Ext.comp
