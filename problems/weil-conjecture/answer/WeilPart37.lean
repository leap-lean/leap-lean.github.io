        (IsLocalization.Away.invSelf (S := L_X) X_poly)

    
    let A := MvPolynomial (Fin (1 + 1)) K
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let other : Fin (1 + 1) → Fin (1 + 1) := ![1, 0]
    have h_other_ne : ∀ b : Fin (1 + 1), other b ≠ b := by decide
    have hX : ∀ b : Fin (1 + 1), (MvPolynomial.X b : A) ∈ 𝒜 1 :=
