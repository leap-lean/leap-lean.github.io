    (hOdp_s : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
      IsEtaleSplitOdpPointOver m f₀ (x_s.base pt) (s.base pt))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (f_bar : weilBaseChangeOver F (AlgebraicClosure F) Z_tilde ⟶
      weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1))
    [AlgebraicGeometry.IsProper f_bar.left]
    [AlgebraicGeometry.Flat f_bar.left]
    [AlgebraicGeometry.Surjective f_bar.left]
    (hPb_fbar : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst Z_tilde.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      f_bar.left f₀.left
      (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (e_P : weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1) ≅
      weilProjectiveSpaceOver (AlgebraicClosure F) 1)
    (hPBC : WeilProperModPrimeBaseChangeHolds (AlgebraicClosure F) ℓ)
    (hConstruct : ∀ q : ℕ,
      WeilIsConstructibleModPrimeSheaf ℓ
        (weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1)).left
        (weilEtaleHigherDirectImage f_bar.left q
          (weilEtaleTorsionSheaf (weilBaseChangeOver F (AlgebraicClosure F) Z_tilde).left ℓ)))
    (hCont_pr0 :
      (weilEtaleSitePullback
        (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))).IsContinuous
        (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
        (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology)
    (hAdj_pr0 :
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback
          (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
        AddCommGrpCat.{u} _
        (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
        (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology hCont_pr0).IsRightAdjoint)
    (𝒩_bar : ℕ → CategoryTheory.Sheaf
      (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology AddCommGrpCat.{u})
    (τ_bar0 : ∀ r : ℕ, Quiver.Hom (𝒩_bar (r + 1)) (𝒩_bar r))
    (iso_bar0 : ∀ r : ℕ,
      CategoryTheory.Iso
        ((@CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback
            (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
          AddCommGrpCat.{u} _
          (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
          (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
          hCont_pr0 hAdj_pr0).obj (weilSingDevPencilHigherDirectImage F f₀ ℓ (2 * m + 2) r))
        (𝒩_bar r))
    (hτ_bar0 : ∀ r : ℕ,
      CategoryTheory.CategoryStruct.comp
        ((@CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback
            (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
          AddCommGrpCat.{u} _
          (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
          (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
          hCont_pr0 hAdj_pr0).map (weilSingDevPencilHigherDirectImageMap F f₀ ℓ (2 * m + 2) r))
        (iso_bar0 r).hom =
      CategoryTheory.CategoryStruct.comp (iso_bar0 (r + 1)).hom (τ_bar0 r))
    (frob_E0 : ∀ r : ℕ, (𝒩_bar r).H 0 →+ (𝒩_bar r).H 0)
    (hfrob_E0 : ∀ r : ℕ,
      WeilTransvTriIsGeomBaseSheafAction F (weilProjectiveSpaceOver F 1)
        (weilSingDevPencilHigherDirectImage F f₀ ℓ (2 * m + 2) r) (𝒩_bar r)
        hCont_pr0 hAdj_pr0 (iso_bar0 r) 0 (frob_E0 r))
    (r : ℕ)
    (ξ : (𝒩_bar r).H 0)
    (hξ_U : ∀ (W : (weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1)).left.Etale),
      Set.range ((AlgebraicGeometry.Scheme.Etale.forget
        (weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1)).left).obj W).hom.base ⊆
        ((TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).base).obj U₀).1 →
      (CategoryTheory.Abelian.Ext.addEquiv₀ ξ).hom.app (Opposite.op W) = 0) :
    let k := AlgebraicClosure F
    let D₀ := weilProjectiveSpaceOver F 1
    let D_bar := weilBaseChangeOver F k D₀
    let g_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    ∃ W_s : D_bar.left.Etale,
      (CategoryTheory.Limits.pullback.fst D₀.hom g_k).base ⁻¹' (Set.range s.base) ⊆
        Set.range ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W_s).hom.base ∧
      ∀ W' : D_bar.left.Etale,
        Nonempty (W' ⟶ W_s) →
        (CategoryTheory.Abelian.Ext.addEquiv₀
          (frob_E0 r (frob_E0 r ξ) - ((Nat.card F) ^ (m + 1)) ^ 2 • ξ)).hom.app
          (Opposite.op W') = 0 :=
by
  classical
  intro k D₀ D_bar g_k
  let _ := hConstruct
  let _ := τ_bar0
  let _ := hτ_bar0

  
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_field : ∀ (E : Type u) [Field E], ℓ ≠ ringChar E → (ℓ : E) ≠ 0 := by
    intro E _ hℓE h0
    have hdvd : ringChar E ∣ ℓ := (ringChar.spec E ℓ).mp h0
    rcases CharP.char_is_prime_or_zero E (ringChar E) with hp | hp0
    · exact hℓE ((Nat.Prime.dvd_iff_eq hℓ_prime hp.ne_one).mp hdvd)
    · rw [hp0, zero_dvd_iff] at hdvd
      exact hℓ_prime.ne_zero hdvd
  have hchar_alg : ∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂],
      ringChar E₂ = ringChar E₁ := by
    intro E₁ E₂ _ _ _
    have hchar : CharP E₂ (ringChar E₁) :=
      (RingHom.charP_iff_charP (algebraMap E₁ E₂) (ringChar E₁)).mp inferInstance
    exact @ringChar.eq E₂ _ (ringChar E₁) hchar
  have hℓ_k : (ℓ : k) ≠ 0 := by
    apply hℓ_field k
    rw [hchar_alg F k]
    exact hℓ

  have hnotinj : ¬ Function.Injective (fun x : F => x ^ 2 - x) := by
    intro hinj
    have h01 : (0 : F) ^ 2 - 0 = (1 : F) ^ 2 - 1 := by ring
    exact zero_ne_one (hinj h01)
  have hnotsurj : ¬ Function.Surjective (fun x : F => x ^ 2 - x) :=
    mt (Finite.injective_iff_surjective.mpr) hnotinj
  rw [Function.Surjective, not_forall] at hnotsurj
  obtain ⟨c_quad, hc_quad⟩ := hnotsurj
  let Q_quad : Polynomial F := Polynomial.X ^ 2 - Polynomial.X - Polynomial.C c_quad
  have hQ_deg : Q_quad.natDegree = 2 := by
    dsimp [Q_quad]
    rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt,
      Polynomial.natDegree_sub_eq_left_of_natDegree_lt, Polynomial.natDegree_X_pow]
    · rw [Polynomial.natDegree_X, Polynomial.natDegree_X_pow]; decide
    · rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt, Polynomial.natDegree_X_pow]
      · exact (Polynomial.natDegree_C c_quad).trans_lt (by decide)
      · rw [Polynomial.natDegree_X, Polynomial.natDegree_X_pow]; decide
  have hQ_mon : Q_quad.Monic := by
    rw [Polynomial.Monic, Polynomial.leadingCoeff, hQ_deg]
    simp [Q_quad, Polynomial.coeff_X]
  have hQ_eval : ∀ x : F, Q_quad.eval x ≠ 0 := by
    intro x hx
    simp only [Q_quad, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C, sub_eq_zero] at hx
    exact hc_quad ⟨x, hx⟩
  have hQ_irr : Irreducible Q_quad := by
    rw [hQ_mon.irreducible_iff_natDegree']
    refine ⟨?_, ?_⟩
    · intro h1
      have : Q_quad.natDegree = (1 : Polynomial F).natDegree := congrArg Polynomial.natDegree h1
      rw [hQ_deg, Polynomial.natDegree_one] at this
      omega
    · intro f g _ hg hfg hmem
      rw [hQ_deg] at hmem
      have hg1 : g.natDegree = 1 := by
        simp only [Finset.mem_Ioc] at hmem
        omega
      have hroot : Q_quad.eval (-g.coeff 0) = 0 := by
        rw [← hfg, Polynomial.eval_mul]
        have hg_eval : g.eval (-g.coeff 0) = 0 := by
          conv_lhs => rw [Polynomial.eq_X_add_C_of_natDegree_le_one hg1.le]
          have hlc : g.coeff 1 = 1 := by
            have h := hg.leadingCoeff
            rwa [Polynomial.leadingCoeff, hg1] at h
          simp [hlc]
        rw [hg_eval, mul_zero]
      exact hQ_eval (-g.coeff 0) hroot
  have : Fact (Irreducible Q_quad) := ⟨hQ_irr⟩
  let F₂ : Type u := AdjoinRoot Q_quad
  let pb_quad : PowerBasis F F₂ := AdjoinRoot.powerBasis' hQ_mon
  have : FiniteDimensional F F₂ := PowerBasis.finite pb_quad
  have hdeg₂ : Module.finrank F F₂ = 2 := by
    rw [pb_quad.finrank, AdjoinRoot.powerBasis'_dim, hQ_deg]
  have : Finite F₂ := Module.finite_of_finite F
  have hcard₂ : Nat.card F₂ = Nat.card F ^ 2 := by
    rw [Module.natCard_eq_pow_finrank (K := F) (V := F₂), hdeg₂]
  have hℓ₂ : ℓ ≠ ringChar F₂ := by
    rw [hchar_alg F F₂]
    exact hℓ
  let k₂ : Type u := AlgebraicClosure F₂
  have hℓ_k₂_char : ℓ ≠ ringChar k₂ := by
    rw [hchar_alg F₂ k₂]
    exact hℓ₂

  have hFrobFst : ∀ (K : Type u) [Finite K] [Field K]
      (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))),
      weilGeomFrobHom K Z ≫
        (CategoryTheory.Limits.pullback.fst Z.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :
          weilGeomScheme K Z ⟶ Z.left) =
        CategoryTheory.Limits.pullback.fst Z.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :=
    fun K _ _ Z =>
      (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans (CategoryTheory.Category.comp_id _)
  have hFrobSnd : ∀ (K : Type u) [Finite K] [Field K]
      (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))),
      weilGeomFrobHom K Z ≫
        (CategoryTheory.Limits.pullback.snd Z.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :
          weilGeomScheme K Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K))) =
        (CategoryTheory.Limits.pullback.snd Z.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :
          weilGeomScheme K Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K))) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
            (AlgebraicClosure K) _ _ _).symm.toRingHom) :=
    fun K _ _ Z => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hSpecAlgEquivCancel : ∀ {R A B : Type u} [CommRing R] [CommRing A] [CommRing B]
      [Algebra R A] [Algebra R B] (e : A ≃ₐ[R] B),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.toRingHom) = 𝟙 _ ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.symm.toRingHom) = 𝟙 _ := by
    intro R A B _ _ _ _ _ e
    refine ⟨?_, ?_⟩
    · exact ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
        (congrArg AlgebraicGeometry.Spec.map
          ((CommRingCat.ofHom_comp _ _).symm.trans
            (congrArg CommRingCat.ofHom (RingHom.ext fun x => e.symm_apply_apply x))))).trans
        (AlgebraicGeometry.Spec.map_id _)
    · exact ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
        (congrArg AlgebraicGeometry.Spec.map
          ((CommRingCat.ofHom_comp _ _).symm.trans
            (congrArg CommRingCat.ofHom (RingHom.ext fun x => e.apply_symm_apply x))))).trans
        (AlgebraicGeometry.Spec.map_id _)
  have hFrobInv : ∀ (K : Type u) [Finite K] [Field K]
      (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))),
      ∃ g_inv : weilGeomScheme K Z ⟶ weilGeomScheme K Z,
        weilGeomFrobHom K Z ≫ g_inv = 𝟙 (weilGeomScheme K Z) ∧
        g_inv ≫ weilGeomFrobHom K Z = 𝟙 (weilGeomScheme K Z) := by
    intro K _ _ Z
    let φ_K := @FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
      (AlgebraicClosure K) _ _ _
    let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
    let fst_Z : weilGeomScheme K Z ⟶ Z.left := CategoryTheory.Limits.pullback.fst Z.hom f₂
    let snd_Z : weilGeomScheme K Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K)) :=
      CategoryTheory.Limits.pullback.snd Z.hom f₂
    let i_symm := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_K.symm.toRingHom)
    let i_inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_K.toRingHom)
    have hcomp_inv : CategoryTheory.CategoryStruct.comp
        (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
        (CommRingCat.ofHom φ_K.toRingHom) =
        CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)) :=
      (CommRingCat.ofHom_comp _ _).symm.trans (congrArg CommRingCat.ofHom (RingHom.ext φ_K.commutes))
    let g_inv : weilGeomScheme K Z ⟶ weilGeomScheme K Z :=
      CategoryTheory.Limits.pullback.map Z.hom f₂ Z.hom f₂
        (CategoryTheory.CategoryStruct.id Z.left) i_inv
        (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of K)))
        ((CategoryTheory.Category.comp_id Z.hom).trans (CategoryTheory.Category.id_comp Z.hom).symm)
        ((CategoryTheory.Category.comp_id f₂).trans
          ((congrArg AlgebraicGeometry.Spec.map hcomp_inv.symm).trans
            (AlgebraicGeometry.Spec.map_comp _ _)))
    have hg_fst : g_inv ≫ fst_Z = fst_Z :=
      (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans (CategoryTheory.Category.comp_id _)
    have hg_snd : g_inv ≫ snd_Z = snd_Z ≫ i_inv :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hf_snd : weilGeomFrobHom K Z ≫ snd_Z = snd_Z ≫ i_symm := hFrobSnd K Z
    obtain ⟨h_i1, h_i2⟩ := hSpecAlgEquivCancel φ_K
    refine ⟨g_inv, ?_, ?_⟩
    · apply CategoryTheory.Limits.pullback.hom_ext
      · calc
          (weilGeomFrobHom K Z ≫ g_inv) ≫ fst_Z = weilGeomFrobHom K Z ≫ (g_inv ≫ fst_Z) :=
            CategoryTheory.Category.assoc _ _ _
          _ = weilGeomFrobHom K Z ≫ fst_Z := congrArg (weilGeomFrobHom K Z ≫ ·) hg_fst
          _ = fst_Z := hFrobFst K Z
          _ = 𝟙 _ ≫ fst_Z := (CategoryTheory.Category.id_comp _).symm
      · calc
          (weilGeomFrobHom K Z ≫ g_inv) ≫ snd_Z = weilGeomFrobHom K Z ≫ (g_inv ≫ snd_Z) :=
            CategoryTheory.Category.assoc _ _ _
          _ = (weilGeomFrobHom K Z ≫ snd_Z) ≫ i_inv := by
            rw [hg_snd, CategoryTheory.Category.assoc]
          _ = snd_Z ≫ (i_symm ≫ i_inv) := by rw [hf_snd, CategoryTheory.Category.assoc]
          _ = snd_Z ≫ 𝟙 _ := congrArg (snd_Z ≫ ·) h_i1
          _ = 𝟙 _ ≫ snd_Z := by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    · apply CategoryTheory.Limits.pullback.hom_ext
      · calc
          (g_inv ≫ weilGeomFrobHom K Z) ≫ fst_Z = g_inv ≫ (weilGeomFrobHom K Z ≫ fst_Z) :=
            CategoryTheory.Category.assoc _ _ _
          _ = g_inv ≫ fst_Z := congrArg (g_inv ≫ ·) (hFrobFst K Z)
          _ = fst_Z := hg_fst
          _ = 𝟙 _ ≫ fst_Z := (CategoryTheory.Category.id_comp _).symm
      · calc
          (g_inv ≫ weilGeomFrobHom K Z) ≫ snd_Z = g_inv ≫ (weilGeomFrobHom K Z ≫ snd_Z) :=
            CategoryTheory.Category.assoc _ _ _
          _ = (g_inv ≫ snd_Z) ≫ i_symm := by rw [hf_snd, CategoryTheory.Category.assoc]
          _ = snd_Z ≫ (i_inv ≫ i_symm) := by rw [hg_snd, CategoryTheory.Category.assoc]
          _ = snd_Z ≫ 𝟙 _ := congrArg (snd_Z ≫ ·) h_i2
          _ = 𝟙 _ ≫ snd_Z := by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]

  have : Algebra.IsAlgebraic F k₂ := Algebra.IsAlgebraic.trans F F₂ k₂
  have : IsAlgClosure F k₂ := ⟨inferInstance, inferInstance⟩
  let κ₀ : k₂ ≃ₐ[F] k := IsAlgClosure.equiv F k₂ k
  let g_FF₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F₂))
  let g_F₂k₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F₂ k₂))
  let u_k₂_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₀.symm.toRingHom)
  let u_k_k₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₀.toRingHom)
  obtain ⟨hu_comp1, hu_comp2⟩ := hSpecAlgEquivCancel κ₀
  have hBaseEq1 : u_k₂_k ≫ g_k = g_F₂k₂ ≫ g_FF₂ :=
    ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
      (congrArg AlgebraicGeometry.Spec.map
        (((CommRingCat.ofHom_comp _ _).symm.trans
          (congrArg CommRingCat.ofHom (RingHom.ext fun c => κ₀.symm.commutes c))).trans
          (CommRingCat.ofHom_comp _ _)))).trans
      (AlgebraicGeometry.Spec.map_comp _ _)
  have hBaseEq2 : (u_k_k₂ ≫ g_F₂k₂) ≫ g_FF₂ = g_k := by
    calc
      (u_k_k₂ ≫ g_F₂k₂) ≫ g_FF₂ = u_k_k₂ ≫ (g_F₂k₂ ≫ g_FF₂) :=
        CategoryTheory.Category.assoc _ _ _
      _ = (u_k_k₂ ≫ u_k₂_k) ≫ g_k := by rw [← hBaseEq1, CategoryTheory.Category.assoc]
      _ = 𝟙 _ ≫ g_k := congrArg (· ≫ g_k) hu_comp2
      _ = g_k := CategoryTheory.Category.id_comp _
  let e_geom : ∀ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))),
      weilGeomScheme F₂ (weilBaseChangeOver F F₂ W) ≅ weilGeomScheme F W := fun W =>
    let W₂ := weilBaseChangeOver F F₂ W
    let fst₂ : weilGeomScheme F₂ W₂ ⟶ W₂.left := CategoryTheory.Limits.pullback.fst W₂.hom g_F₂k₂
