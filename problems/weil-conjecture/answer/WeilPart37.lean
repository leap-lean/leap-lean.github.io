        PrimeSpectrum.localization_away_comap_range (Localization.Away (u b μ)) (u b μ)
      change ((isoW b).hom.base w : PrimeSpectrum ↥(R_b b)) ∈
        (PrimeSpectrum.basicOpen (u b μ) : Set (PrimeSpectrum ↥(R_b b))) ↔ z ∈ (W μ : Set P_sch)
      rw [← hrange_loc]
      constructor
      · rintro ⟨p_ov, hp_ov⟩
        have hz_in : z ∈ (W b : Set P_sch) ∩ (W μ : Set P_sch) := by
          rw [← (hOverlap b μ).2]
          refine ⟨p_ov, ?_⟩
          change (j_chart b).base (PrimeSpectrum.comap
            (algebraMap ↥(R_b b) (Localization.Away (u b μ))) p_ov) = z
          rw [hp_ov]
          change (((isoW b).hom ≫ (isoW b).inv) ≫ (W b).ι).base w = z
          rw [Iso.hom_inv_id]
          rfl
        exact hz_in.2
      · intro hzμ
        have hz_in : z ∈ (W b : Set P_sch) ∩ (W μ : Set P_sch) := ⟨hzb, hzμ⟩
        rw [← (hOverlap b μ).2] at hz_in
        rcases hz_in with ⟨p_ov, hp_ov⟩
        refine ⟨p_ov, ?_⟩
        apply (j_chart b).isOpenEmbedding.injective
        change (Spec.map (CommRingCat.ofHom (algebraMap ↥(R_b b) (Localization.Away (u b μ)))) ≫
          j_chart b).base p_ov = (j_chart b).base ((isoW b).hom.base w)
        rw [hp_ov]
        change z = (((isoW b).hom ≫ (isoW b).inv) ≫ (W b).ι).base w
        rw [Iso.hom_inv_id]
        rfl
    exact ⟨Ψ, hΨ_hom, hΨ_pre, hΨ_chart⟩

  
  
  
  let V_Q : Fin (M₀ + 1) → Q_K.left.Opens :=
    fun b => (TopologicalSpace.Opens.map ι_QP.base).obj (W b)
  let κ : ∀ b : Fin (M₀ + 1), K →+* (↥(R_b b) ⧸ I_b b) :=
    fun b => ((Ideal.Quotient.mk (I_b b)).comp (algebraMap A ↥(R_b b))).comp alg_A

  obtain ⟨isoV, hisoV_QP, hisoV_hom⟩ :
      ∃ isoV : ∀ b : Fin (M₀ + 1), (V_Q b).toScheme ≅ Spec (CommRingCat.of (↥(R_b b) ⧸ I_b b)),
        (∀ b : Fin (M₀ + 1),
          (V_Q b).ι ≫ ι_QP =
            (isoV b).hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I_b b))) ≫
              (isoW b).inv ≫ (W b).ι) ∧
        (∀ b : Fin (M₀ + 1),
          (V_Q b).ι ≫ Q_K.hom =
            (isoV b).hom ≫ Spec.map (CommRingCat.ofHom (κ b))) := by
    have hV_each : ∀ b : Fin (M₀ + 1),
        ∃ isoVb : (V_Q b).toScheme ≅ Spec (CommRingCat.of (↥(R_b b) ⧸ I_b b)),
          ((V_Q b).ι ≫ ι_QP =
            isoVb.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I_b b))) ≫
              (isoW b).inv ≫ (W b).ι) ∧
          ((V_Q b).ι ≫ Q_K.hom =
            isoVb.hom ≫ Spec.map (CommRingCat.ofHom (κ b))) := by
      intro b
      let _ : Algebra A K := ε.toAlgebra
      have hκ_alg : ∀ a : A,
          κ b (algebraMap A K a) = Ideal.Quotient.mk (I_b b) (algebraMap A ↥(R_b b) a) := by
        intro a
        change Ideal.Quotient.mk (I_b b) (algebraMap A ↥(R_b b) (alg_A (ε a))) = _
        apply Ideal.Quotient.eq.mpr
        rw [← map_sub]
        apply Ideal.mem_map_of_mem
        rw [RingHom.mem_ker, map_sub,
          show ε (alg_A (ε a)) = (ε.comp alg_A) (ε a) from rfl,
          hε_id, RingHom.id_apply, sub_self]
      let κ_alg : K →ₐ[A] (↥(R_b b) ⧸ I_b b) :=
        { toRingHom := κ b
          commutes' := hκ_alg }
      let Φ_to : TensorProduct A ↥(R_b b) K →+* (↥(R_b b) ⧸ I_b b) :=
        (Algebra.TensorProduct.lift (Ideal.Quotient.mkₐ A (I_b b)) κ_alg
          (fun r c => mul_comm ((Ideal.Quotient.mkₐ A (I_b b)) r) (κ_alg c))).toRingHom
      have h_ker_incL : I_b b ≤
          RingHom.ker (Algebra.TensorProduct.includeLeftRingHom (A := ↥(R_b b)) (B := K) (R := A)) := by
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        change (algebraMap A ↥(R_b b) a) ⊗ₜ[A] (1 : K) = 0
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul,
          Algebra.smul_def, mul_one]
        have hεa : algebraMap A K a = 0 := ha
        rw [hεa, TensorProduct.tmul_zero]
      let Φ_inv : (↥(R_b b) ⧸ I_b b) →+* TensorProduct A ↥(R_b b) K :=
        Ideal.Quotient.lift (I_b b)
          (Algebra.TensorProduct.includeLeftRingHom (A := ↥(R_b b)) (B := K) (R := A))
          (fun x hx => h_ker_incL hx)
      have hΦ_left : Φ_inv.comp Φ_to = RingHom.id _ := by
        apply RingHom.ext
        intro t
        rw [RingHom.comp_apply, RingHom.id_apply]
        refine TensorProduct.inductionOn (motive := fun z => Φ_inv (Φ_to z) = z) t ?_ ?_
        · intro r c
          change Φ_inv (Ideal.Quotient.mk (I_b b) r * κ b c) = r ⊗ₜ[A] c
          change Φ_inv (Ideal.Quotient.mk (I_b b) (r * algebraMap A ↥(R_b b) (alg_A c))) = r ⊗ₜ[A] c
          change (r * algebraMap A ↥(R_b b) (alg_A c)) ⊗ₜ[A] (1 : K) = r ⊗ₜ[A] c
          have h_smul : r * algebraMap A ↥(R_b b) (alg_A c) = (alg_A c) • r := by
            rw [Algebra.smul_def, mul_comm]
          rw [h_smul, TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
          have hεc : algebraMap A K (alg_A c) = c :=
            RingHom.congr_fun hε_id c
          rw [hεc]
        · intro t₁ t₂ h₁ h₂
          rw [Φ_to.map_add, Φ_inv.map_add, h₁, h₂]
      have hΦ_right : Φ_to.comp Φ_inv = RingHom.id _ := by
        apply RingHom.ext
        intro q
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
        change Ideal.Quotient.mk (I_b b) r * κ b 1 = Ideal.Quotient.mk (I_b b) r
        rw [map_one, mul_one]
      let Φ_to_cat : CommRingCat.of (TensorProduct A ↥(R_b b) K) ⟶
          CommRingCat.of (↥(R_b b) ⧸ I_b b) :=
        CommRingCat.ofHom Φ_to
      let Φ_inv_cat : CommRingCat.of (↥(R_b b) ⧸ I_b b) ⟶
          CommRingCat.of (TensorProduct A ↥(R_b b) K) :=
        CommRingCat.ofHom Φ_inv
      let e_spec_tens : Spec (CommRingCat.of (TensorProduct A ↥(R_b b) K)) ≅
          Spec (CommRingCat.of (↥(R_b b) ⧸ I_b b)) :=
        { hom := Spec.map Φ_inv_cat
          inv := Spec.map Φ_to_cat
          hom_inv_id := by
            rw [← Spec.map_comp]
            have h1 : Φ_to_cat ≫ Φ_inv_cat = 𝟙 _ :=
              CommRingCat.hom_ext (RingHom.ext fun x => RingHom.congr_fun hΦ_left x)
            rw [h1, Spec.map_id]
          inv_hom_id := by
            rw [← Spec.map_comp]
            have h1 : Φ_inv_cat ≫ Φ_to_cat = 𝟙 _ :=
              CommRingCat.hom_ext (RingHom.ext fun x => RingHom.congr_fun hΦ_right x)
            rw [h1, Spec.map_id] }
      have hpb₁ : IsPullback (ι_QP ∣_ W b) ((V_Q b).ι ≫ Q_K.hom)
          ((W b).ι ≫ π_P) (Spec.map (CommRingCat.ofHom ε)) :=
        (AlgebraicGeometry.isPullback_morphismRestrict ι_QP (W b)).paste_vert hPb_Q
      have hpb_isoW : IsPullback (isoW b).hom ((W b).ι ≫ π_P)
          (Spec.map (CommRingCat.ofHom (algebraMap A ↥(R_b b)))) (𝟙 _) :=
        IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id, ← hW_proj b]⟩
      have hpb₂ : IsPullback ((ι_QP ∣_ W b) ≫ (isoW b).hom) ((V_Q b).ι ≫ Q_K.hom)
          (Spec.map (CommRingCat.ofHom (algebraMap A ↥(R_b b))))
          (Spec.map (CommRingCat.ofHom (algebraMap A K))) := by
        simpa only [Category.comp_id] using hpb₁.paste_horiz hpb_isoW
      let f_R := Spec.map (CommRingCat.ofHom (algebraMap A ↥(R_b b)))
      let f_K := Spec.map (CommRingCat.ofHom (algebraMap A K))
      let e_pb₁ := IsPullback.isoIsPullback _ _ hpb₂ (IsPullback.of_hasPullback f_R f_K)
      let e_spec := AlgebraicGeometry.pullbackSpecIso A ↥(R_b b) K
      let isoVb : (V_Q b).toScheme ≅ Spec (CommRingCat.of (↥(R_b b) ⧸ I_b b)) :=
        (e_pb₁.trans e_spec).trans e_spec_tens
      refine ⟨isoVb, ?_, ?_⟩
      · dsimp only [isoVb, Iso.trans_hom, e_spec_tens]
        have h_incL : CommRingCat.ofHom (Ideal.Quotient.mk (I_b b)) ≫ Φ_inv_cat =
            CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom := rfl
        rw [Category.assoc, Category.assoc,
          ← Category.assoc (Spec.map Φ_inv_cat),
          ← Spec.map_comp, h_incL,
          ← Category.assoc e_spec.hom,
          AlgebraicGeometry.pullbackSpecIso_hom_fst A ↥(R_b b) K,
          ← Category.assoc e_pb₁.hom,
          IsPullback.isoIsPullback_hom_fst,
          Category.assoc, Iso.hom_inv_id_assoc,
          AlgebraicGeometry.morphismRestrict_ι]
      · dsimp only [isoVb, Iso.trans_hom, e_spec_tens]
        have h_incR : CommRingCat.ofHom (κ b) ≫ Φ_inv_cat =
            CommRingCat.ofHom
              (↑(Algebra.TensorProduct.includeRight : K →ₐ[A] TensorProduct A ↥(R_b b) K) :
                K →+* TensorProduct A ↥(R_b b) K) := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro c
          change (algebraMap A ↥(R_b b) (alg_A c)) ⊗ₜ[A] (1 : K) = (1 : ↥(R_b b)) ⊗ₜ[A] c
          rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul,
            Algebra.smul_def, mul_one]
          have hεc : algebraMap A K (alg_A c) = c := RingHom.congr_fun hε_id c
          rw [hεc]
        have he_snd : e_spec.hom ≫
            Spec.map (CommRingCat.ofHom
              (↑(Algebra.TensorProduct.includeRight : K →ₐ[A] TensorProduct A ↥(R_b b) K) :
                K →+* TensorProduct A ↥(R_b b) K)) =
            Limits.pullback.snd f_R f_K := by
          rw [← AlgebraicGeometry.pullbackSpecIso_inv_snd A ↥(R_b b) K, Iso.hom_inv_id_assoc]
        rw [Category.assoc, Category.assoc, ← Spec.map_comp,
          h_incR, he_snd, IsPullback.isoIsPullback_hom_snd]
    obtain ⟨isoV, hspec⟩ := Classical.axiomOfChoice hV_each
    exact ⟨isoV, fun b => (hspec b).1, fun b => (hspec b).2⟩

  
  have hSmOfOpens : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (d : ℕ) (f : X ⟶ Y),
      (∀ x : ↥X, ∃ W_o : X.Opens, x ∈ W_o ∧
        AlgebraicGeometry.SmoothOfRelativeDimension d (W_o.ι ≫ f)) →
      AlgebraicGeometry.SmoothOfRelativeDimension d f := by
    intro X Y d f h
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro x
    obtain ⟨W_o, hxW, hSmW⟩ := h x
    obtain ⟨U_o, hU_aff, V_o, hV_aff, hxV, hV_le, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff d (W_o.ι ≫ f)).mp hSmW ⟨x, hxW⟩
    let V' : X.Opens := W_o.ι ''ᵁ V_o
    have hV'_aff : AlgebraicGeometry.IsAffineOpen V' := hV_aff.image_of_isOpenImmersion W_o.ι
    have hxV' : x ∈ V' := ⟨⟨x, hxW⟩, hxV, rfl⟩
    have hV'_le : V' ≤ (TopologicalSpace.Opens.map f.base).obj U_o := by
      rintro _ ⟨w, hwV, rfl⟩
      exact hV_le hwV
    have hV_le' : V_o ≤ (TopologicalSpace.Opens.map W_o.ι.base).obj V' :=
      fun w hw => ⟨w, hw, rfl⟩
    have happ_comp : (W_o.ι ≫ f).appLE U_o V_o hV_le =
        f.appLE U_o V' hV'_le ≫ W_o.ι.appLE V' V_o hV_le' :=
      (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE W_o.ι f U_o V' V_o hV'_le hV_le').symm
    have heq_V : V_o = (TopologicalSpace.Opens.map W_o.ι.base).obj V' := by
      ext w
      simp [V']
    have _ : CategoryTheory.IsIso (W_o.toScheme.presheaf.map (CategoryTheory.homOfLE hV_le').op) := by
      rw [show CategoryTheory.homOfLE hV_le' = CategoryTheory.eqToHom heq_V from rfl]
      infer_instance
    have _ : CategoryTheory.IsIso (W_o.ι.appLE V' V_o hV_le') := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE]
      infer_instance
    let e_V := asIso (W_o.ι.appLE V' V_o hV_le')
    have happ_eq : f.appLE U_o V' hV'_le =
        (W_o.ι ≫ f).appLE U_o V_o hV_le ≫ e_V.inv := by
      rw [happ_comp]
      dsimp only [e_V]
      rw [Category.assoc, asIso_inv, IsIso.hom_inv_id, Category.comp_id]
    refine ⟨U_o, hU_aff, V', hV'_aff, hxV', hV'_le, ?_⟩
    rw [happ_eq, CommRingCat.hom_comp]
    have hbij : Function.Bijective e_V.inv.hom :=
      ConcreteCategory.bijective_of_isIso e_V.inv
    have h0 : RingHom.IsStandardSmoothOfRelativeDimension 0 e_V.inv.hom := by
      let _ : Algebra ↑(W_o.toScheme.presheaf.obj (Opposite.op V_o))
          ↑(X.presheaf.obj (Opposite.op V')) := e_V.inv.hom.toAlgebra
      exact Algebra.IsStandardSmoothOfRelativeDimension.of_algebraMap_bijective hbij
    have hcomp := RingHom.IsStandardSmoothOfRelativeDimension.comp h0 hStd
    rwa [Nat.zero_add] at hcomp

  have hSm_Q : AlgebraicGeometry.SmoothOfRelativeDimension d_Q Q_K.hom := by
    apply hSmOfOpens
    intro x
    have hx_W : ι_QP.base x ∈ (⨆ b : Fin (M₀ + 1), W b : P_sch.Opens) := by
      rw [hW_cov]
      trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hx_W
    rcases hx_W with ⟨b, hxb⟩
    refine ⟨V_Q b, hxb, ?_⟩
    let e_poly : Spec (CommRingCat.of (↥(R_b b) ⧸ I_b b)) ≅
        Spec (CommRingCat.of (MvPolynomial (Fin d_Q) K)) :=
      { hom := Spec.map (CommRingCat.ofHom (ψ b).symm.toRingHom)
        inv := Spec.map (CommRingCat.ofHom (ψ b).toRingHom)
        hom_inv_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h2 : (ψ b).symm.toRingHom.comp (ψ b).toRingHom = RingHom.id _ := by
            apply RingHom.ext
            intro q
            exact (ψ b).symm_apply_apply q
          rw [h2, CommRingCat.ofHom_id, Spec.map_id]
        inv_hom_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h2 : (ψ b).toRingHom.comp (ψ b).symm.toRingHom = RingHom.id _ := by
            apply RingHom.ext
            intro p
            exact (ψ b).apply_symm_apply p
          rw [h2, CommRingCat.ofHom_id, Spec.map_id] }
    let e_Vb : (V_Q b).toScheme ≅ Spec (CommRingCat.of (MvPolynomial (Fin d_Q) K)) :=
      (isoV b).trans e_poly
    have _ : IsAffine (V_Q b).toScheme := AlgebraicGeometry.IsAffine.of_isIso e_Vb.hom
    have hVb_hom : (V_Q b).ι ≫ Q_K.hom =
        e_Vb.hom ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin d_Q) K)) := by
      rw [hisoV_hom b]
      dsimp only [e_Vb, Iso.trans_hom, e_poly]
      rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hcomp_C : (ψ b).symm.toRingHom.comp MvPolynomial.C = κ b := by
        apply RingHom.ext
        intro c
        apply (ψ b).injective
        change ψ b ((ψ b).symm (MvPolynomial.C c)) = ψ b (κ b c)
        rw [(ψ b).apply_symm_apply]
        exact (hψ_C b c).symm
      rw [hcomp_C]
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro v_pt
    refine ⟨⊤, AlgebraicGeometry.isAffineOpen_top _, ⊤, AlgebraicGeometry.isAffineOpen_top _,
      trivial, le_top, ?_⟩
    have happ_top_eq : ((V_Q b).ι ≫ Q_K.hom).appLE ⊤ ⊤ le_top =
        ((V_Q b).ι ≫ Q_K.hom).appTop := by
      unfold AlgebraicGeometry.Scheme.Hom.appLE
      change ((V_Q b).ι ≫ Q_K.hom).app ⊤ ≫ (V_Q b).toScheme.presheaf.map (𝟙 _) = _
      rw [CategoryTheory.Functor.map_id, Category.comp_id]
    let f_C := Spec.map (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin d_Q) K))
    let eK := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)
    let eP := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin d_Q) K))
    have hnat_C := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
      (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin d_Q) K))
    have hfC_top : f_C.appTop = eK.hom ≫ CommRingCat.ofHom MvPolynomial.C ≫ eP.inv := by
      rw [← Category.assoc, ← hnat_C, Category.assoc, eP.hom_inv_id, Category.comp_id]
    let e_Vb_top :
        (Spec (CommRingCat.of (MvPolynomial (Fin d_Q) K))).presheaf.obj (Opposite.op ⊤) ≅
          (V_Q b).toScheme.presheaf.obj (Opposite.op ⊤) :=
      { hom := e_Vb.hom.appTop
        inv := e_Vb.inv.appTop
        hom_inv_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_Vb.inv_hom_id]
          exact AlgebraicGeometry.Scheme.Hom.id_app ⊤
        inv_hom_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_Vb.hom_inv_id]
          exact AlgebraicGeometry.Scheme.Hom.id_app ⊤ }
    let e_right : CommRingCat.of (MvPolynomial (Fin d_Q) K) ≅
        (V_Q b).toScheme.presheaf.obj (Opposite.op ⊤) :=
      eP.symm.trans e_Vb_top
    have hVb_appLE : ((V_Q b).ι ≫ Q_K.hom).appLE ⊤ ⊤ le_top =
        eK.hom ≫ CommRingCat.ofHom MvPolynomial.C ≫ e_right.hom := by
      rw [happ_top_eq, hVb_hom, AlgebraicGeometry.Scheme.Hom.comp_appTop, hfC_top]
      dsimp only [e_right, Iso.trans_hom, Iso.symm_hom, e_Vb_top]
      simp only [Category.assoc]
    change RingHom.IsStandardSmoothOfRelativeDimension d_Q
      (((V_Q b).ι ≫ Q_K.hom).appLE ⊤ ⊤ le_top).hom
    rw [hVb_appLE, CommRingCat.hom_comp, CommRingCat.hom_comp]
    have h0_K : RingHom.IsStandardSmoothOfRelativeDimension 0 eK.hom.hom := by
      let _ : Algebra ↑((Spec (CommRingCat.of K)).presheaf.obj (Opposite.op ⊤)) K :=
        eK.hom.hom.toAlgebra
      exact Algebra.IsStandardSmoothOfRelativeDimension.of_algebraMap_bijective
        (ConcreteCategory.bijective_of_isIso eK.hom)
    have h0_R : RingHom.IsStandardSmoothOfRelativeDimension 0 e_right.hom.hom := by
      let _ : Algebra (MvPolynomial (Fin d_Q) K)
          ↑((V_Q b).toScheme.presheaf.obj (Opposite.op ⊤)) :=
        e_right.hom.hom.toAlgebra
      exact Algebra.IsStandardSmoothOfRelativeDimension.of_algebraMap_bijective
        (ConcreteCategory.bijective_of_isIso e_right.hom)
    have hd_P : RingHom.IsStandardSmoothOfRelativeDimension d_Q
        (MvPolynomial.C : K →+* MvPolynomial (Fin d_Q) K) := by
      have h := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial K (Fin d_Q)
      rw [Nat.card_eq_fintype_card, Fintype.card_fin] at h
      exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap d_Q).mpr h
    have hcomp1 := RingHom.IsStandardSmoothOfRelativeDimension.comp h0_R hd_P
    rw [Nat.zero_add] at hcomp1
    have hcomp2 := RingHom.IsStandardSmoothOfRelativeDimension.comp hcomp1 h0_K
    rwa [Nat.add_zero] at hcomp2

  
  
  
  let ι_Q : Q_K.left ⟶ P_proj := ι_QP ≫ Ψ
  have hι_Q_hom : ι_Q ≫ π_proj = Q_K.hom := by
    dsimp only [ι_Q]
    rw [Category.assoc, hΨ_hom, ← Category.assoc, hPb_Q.w, Category.assoc,
      ← Spec.map_comp, ← CommRingCat.ofHom_comp, hε_id,
      CommRingCat.ofHom_id, Spec.map_id, Category.comp_id]

  refine ⟨hSm_Q, ι_Q, hι_Q_hom, ?_⟩

  
  let D_chart : Fin (M₀ + 1) → P_proj.Opens :=
    fun μ => AlgebraicGeometry.Proj.basicOpen 𝒜_K (MvPolynomial.X μ)
  have hD_cov : (⨆ μ : Fin (M₀ + 1), D_chart μ) = ⊤ := by
    apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜_K
      (fun μ : Fin (M₀ + 1) => MvPolynomial.X μ)
      (fun μ => ⟨1, hX_hom μ⟩)
    rw [Algebra.eq_top_iff]
    intro P
    induction P using MvPolynomial.induction_on with
    | C c =>
      have hc : MvPolynomial.C c =
          algebraMap ↥(𝒜_K 0) (MvPolynomial (Fin (M₀ + 1)) K)
            ⟨MvPolynomial.C c, MvPolynomial.isHomogeneous_C _ c⟩ := rfl
      rw [hc]
      exact Subalgebra.algebraMap_mem _ _
    | add p₁ p₂ hp₁ hp₂ => exact Subalgebra.add_mem _ hp₁ hp₂
    | mul_X p μ hp =>
      exact Subalgebra.mul_mem _ hp (Algebra.subset_adjoin ⟨μ, rfl⟩)

  
  have hι_Q_pre : ∀ μ : Fin (M₀ + 1),
      (TopologicalSpace.Opens.map ι_Q.base).obj (D_chart μ) = V_Q μ := by
    intro μ
    change (TopologicalSpace.Opens.map ι_QP.base).obj
      ((TopologicalSpace.Opens.map Ψ.base).obj (D_chart μ)) = V_Q μ
    rw [hΨ_pre μ]

  have hι_Q_chart : ∀ (μ : Fin (M₀ + 1)) (hXμ : MvPolynomial.X μ ∈ 𝒜_K 1),
      (V_Q μ).ι ≫ ι_Q =
        (isoV μ).hom ≫ Spec.map (φ_cat μ) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_K (MvPolynomial.X μ) hXμ zero_lt_one := by
    intro μ hXμ
    have h_irrel : hXμ = hX_hom μ := Subsingleton.elim _ _
    subst h_irrel
    dsimp only [ι_Q, φ_cat]
    rw [← Category.assoc, hisoV_QP μ, Category.assoc, Category.assoc, Category.assoc,
      hΨ_chart μ, Iso.inv_hom_id_assoc, ← Category.assoc (Spec.map _),
      ← Spec.map_comp]

  have hι_Q_res_fac : ∀ (μ : Fin (M₀ + 1)) (hXμ : MvPolynomial.X μ ∈ 𝒜_K 1),
      ∃ e_tot : (ι_Q ⁻¹ᵁ D_chart μ).toScheme ≅ Spec (CommRingCat.of (↥(R_b μ) ⧸ I_b μ)),
        (ι_Q ∣_ D_chart μ) =
          e_tot.hom ≫ Spec.map (φ_cat μ) ≫
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_K (MvPolynomial.X μ) hXμ zero_lt_one).inv := by
    intro μ hXμ
    have hr1 : Set.range (ι_Q ⁻¹ᵁ D_chart μ).ι.base ⊆ Set.range (V_Q μ).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι, AlgebraicGeometry.Scheme.Opens.range_ι,
        show (ι_Q ⁻¹ᵁ D_chart μ : Q_K.left.Opens) = V_Q μ from hι_Q_pre μ]
    have hr2 : Set.range (V_Q μ).ι.base ⊆ Set.range (ι_Q ⁻¹ᵁ D_chart μ).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι, AlgebraicGeometry.Scheme.Opens.range_ι,
        show (ι_Q ⁻¹ᵁ D_chart μ : Q_K.left.Opens) = V_Q μ from hι_Q_pre μ]
    let f_pre1 := IsOpenImmersion.lift (V_Q μ).ι (ι_Q ⁻¹ᵁ D_chart μ).ι hr1
    let f_pre2 := IsOpenImmersion.lift (ι_Q ⁻¹ᵁ D_chart μ).ι (V_Q μ).ι hr2
    have hf1 : f_pre1 ≫ (V_Q μ).ι = (ι_Q ⁻¹ᵁ D_chart μ).ι :=
      IsOpenImmersion.lift_fac (V_Q μ).ι (ι_Q ⁻¹ᵁ D_chart μ).ι hr1
    have hf2 : f_pre2 ≫ (ι_Q ⁻¹ᵁ D_chart μ).ι = (V_Q μ).ι :=
      IsOpenImmersion.lift_fac (ι_Q ⁻¹ᵁ D_chart μ).ι (V_Q μ).ι hr2
    let e_pre : (ι_Q ⁻¹ᵁ D_chart μ).toScheme ≅ (V_Q μ).toScheme :=
      { hom := f_pre1
        inv := f_pre2
        hom_inv_id := by
          rw [← cancel_mono (ι_Q ⁻¹ᵁ D_chart μ).ι, Category.assoc, hf2, hf1, Category.id_comp]
        inv_hom_id := by
          rw [← cancel_mono (V_Q μ).ι, Category.assoc, hf1, hf2, Category.id_comp] }
    refine ⟨e_pre.trans (isoV μ), ?_⟩
    rw [← cancel_mono (D_chart μ).ι, AlgebraicGeometry.morphismRestrict_ι,
      ← hf1, Category.assoc, hι_Q_chart μ hXμ,
      ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_K (MvPolynomial.X μ) hXμ zero_lt_one]
    simp only [e_pre, Iso.trans_hom, Category.assoc]
    rfl

  
  have hCl_ιQ : IsClosedImmersion ι_Q := by
    refine (AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := @AlgebraicGeometry.IsClosedImmersion) D_chart hD_cov).mpr fun μ => ?_
    obtain ⟨e_tot, hfac⟩ := hι_Q_res_fac μ (hX_hom μ)
    rw [hfac]
    have _ : IsClosedImmersion (Spec.map (φ_cat μ)) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (φ_cat μ) (hφ_surj μ)
    infer_instance
  have _ : IsClosedImmersion ι_Q := hCl_ιQ

  refine ⟨hCl_ιQ, hF_hom, ?_, ?_⟩
  · 
    ext (p : P_proj)
    have hp_top : p ∈ (⨆ μ : Fin (M₀ + 1), D_chart μ) := by
      rw [hD_cov]
      trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hp_top
    rcases hp_top with ⟨μ, hp_μ⟩
    let b_spec := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_K (MvPolynomial.X μ)
      (hX_hom μ) zero_lt_one
    let p_spec : Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X μ))) :=
      b_spec.hom.base ⟨p, hp_μ⟩
    have hp_away : (AlgebraicGeometry.Proj.awayι 𝒜_K (MvPolynomial.X μ)
        (hX_hom μ) zero_lt_one).base p_spec = p := by
      rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_K (MvPolynomial.X μ)
        (hX_hom μ) zero_lt_one]
      change (D_chart μ).ι.base ((b_spec.hom ≫ b_spec.inv).base ⟨p, hp_μ⟩) = p
      rw [b_spec.hom_inv_id]
      rfl
    let f_μ := HomogeneousLocalization.Away.mk 𝒜_K (hX_hom μ) 2 F_hom hF_hom
    have h_range_iff : p ∈ Set.range ι_Q.base ↔ f_μ ∈ p_spec.asIdeal := by
      obtain ⟨e_tot, hfac⟩ := hι_Q_res_fac μ (hX_hom μ)
      constructor
      · rintro ⟨q, rfl⟩
        have hq_pre : q ∈ (ι_Q ⁻¹ᵁ D_chart μ) := hp_μ
        have hres_eq : (ι_Q ∣_ D_chart μ).base ⟨q, hq_pre⟩ = ⟨ι_Q.base q, hp_μ⟩ := by
          apply (D_chart μ).ι.isOpenEmbedding.injective
          change ((ι_Q ∣_ D_chart μ) ≫ (D_chart μ).ι).base ⟨q, hq_pre⟩ = ι_Q.base q
          rw [AlgebraicGeometry.morphismRestrict_ι]
          rfl
        have hp_spec_eq : p_spec =
            (Spec.map (φ_cat μ)).base (e_tot.hom.base ⟨q, hq_pre⟩) := by
          have h1 : p_spec = b_spec.hom.base ((ι_Q ∣_ D_chart μ).base ⟨q, hq_pre⟩) :=
            congrArg b_spec.hom.base hres_eq.symm
          rw [h1, hfac]
          change ((e_tot.hom ≫ Spec.map (φ_cat μ)) ≫
            (b_spec.inv ≫ b_spec.hom)).base ⟨q, hq_pre⟩ = _
          rw [b_spec.inv_hom_id, Category.comp_id]
          rfl
        rw [hp_spec_eq]
        change φ μ f_μ ∈ (e_tot.hom.base ⟨q, hq_pre⟩).asIdeal
        have hf_ker : f_μ ∈ RingHom.ker (φ μ) := by
          rw [hφ_ker μ (hX_hom μ)]
          exact Ideal.subset_span rfl
        rw [RingHom.mem_ker.mp hf_ker]
        exact (e_tot.hom.base ⟨q, hq_pre⟩).asIdeal.zero_mem
      · intro hf_mem
        have hker_le : RingHom.ker (φ μ) ≤ p_spec.asIdeal := by
          rw [hφ_ker μ (hX_hom μ), Ideal.span_singleton_le_iff_mem]
          exact hf_mem
        let q_ideal : Ideal (↥(R_b μ) ⧸ I_b μ) := Ideal.map (φ μ) p_spec.asIdeal
        have hcomap_map : Ideal.comap (φ μ) q_ideal = p_spec.asIdeal := by
          dsimp only [q_ideal]
          rw [Ideal.comap_map_of_surjective (φ μ) (hφ_surj μ), sup_eq_left]
          exact hker_le
        have hq_prime : q_ideal.IsPrime := by
          refine ⟨?_, ?_⟩
          · intro htop
            apply p_spec.isPrime.ne_top
            rw [← hcomap_map, htop]
            exact Ideal.comap_top
          · intro x y hxy
            obtain ⟨a, rfl⟩ := hφ_surj μ x
            obtain ⟨b₀, rfl⟩ := hφ_surj μ y
            have hab : a * b₀ ∈ p_spec.asIdeal := by
              rw [← hcomap_map]
              change φ μ (a * b₀) ∈ q_ideal
              rwa [map_mul]
            rcases p_spec.isPrime.mem_or_mem hab with ha | hb₀
            · exact Or.inl (Ideal.mem_map_of_mem (φ μ) ha)
            · exact Or.inr (Ideal.mem_map_of_mem (φ μ) hb₀)
        let q_quot : Spec (CommRingCat.of (↥(R_b μ) ⧸ I_b μ)) := ⟨q_ideal, hq_prime⟩
        have hq_quot : (Spec.map (φ_cat μ)).base q_quot = p_spec :=
          PrimeSpectrum.ext hcomap_map
        let q : Q_K.left := (V_Q μ).ι.base ((isoV μ).inv.base q_quot)
        refine ⟨q, ?_⟩
        change ((V_Q μ).ι ≫ ι_Q).base ((isoV μ).inv.base q_quot) = p
        rw [hι_Q_chart μ (hX_hom μ)]
        change (((isoV μ).inv ≫ (isoV μ).hom) ≫ Spec.map (φ_cat μ) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_K (MvPolynomial.X μ) (hX_hom μ) zero_lt_one).base
          q_quot = p
        rw [Iso.inv_hom_id, Category.id_comp]
        change (AlgebraicGeometry.Proj.awayι 𝒜_K (MvPolynomial.X μ)
          (hX_hom μ) zero_lt_one).base ((Spec.map (φ_cat μ)).base q_quot) = p
        rw [hq_quot, hp_away]
    have h_compl_iff :
        p ∈ (((TopologicalSpace.Opens.map (𝟙 P_proj : P_proj ⟶ P_proj).base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_K F_hom) : Set _)ᶜ) ↔
          f_μ ∈ p_spec.asIdeal := by
      change p ∉ (AlgebraicGeometry.Proj.basicOpen 𝒜_K F_hom : Set _) ↔ f_μ ∈ p_spec.asIdeal
      rw [← hp_away]
      have h_pre_F :=
        AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_K (hX_hom μ) zero_lt_one
          hF_hom (by decide : 0 < 2 • 1)
      have h_elem_eq : HomogeneousLocalization.Away.isLocalizationElem (hX_hom μ) hF_hom = f_μ := by
        rw [HomogeneousLocalization.ext_iff_val]
        change (HomogeneousLocalization.Away.mk 𝒜_K (hX_hom μ) (2 • 1) (F_hom ^ 1) _).val =
          (HomogeneousLocalization.Away.mk 𝒜_K (hX_hom μ) 2 F_hom hF_hom).val
        rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk]
        congr 1
        exact pow_one F_hom
      change p_spec ∉ ((TopologicalSpace.Opens.map
        (AlgebraicGeometry.Proj.awayι 𝒜_K (MvPolynomial.X μ) (hX_hom μ) zero_lt_one).base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_K F_hom) : Set _) ↔ f_μ ∈ p_spec.asIdeal
      rw [h_pre_F, h_elem_eq]
      change ¬ (f_μ ∉ p_spec.asIdeal) ↔ f_μ ∈ p_spec.asIdeal
      exact not_not
    exact h_range_iff.trans h_compl_iff.symm
  · 
    intro μ hXμ (U : P_proj.Opens) hU_aff hU_sub
    have hD_aff : IsAffineOpen (D_chart μ) :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_K (MvPolynomial.X μ) hXμ zero_lt_one
    let f_μ := HomogeneousLocalization.Away.mk 𝒜_K hXμ 2 F_hom hF_hom
    
    have hker_Dμ : RingHom.ker (ι_Q.app (D_chart μ)).hom =
        Ideal.span {((AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ)).hom f_μ)} := by
      obtain ⟨e_tot, hfac⟩ := hι_Q_res_fac μ hXμ
      have hfac_right : (ι_Q ∣_ D_chart μ) ≫ AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_K (MvPolynomial.X μ) =
          e_tot.hom ≫ Spec.map (φ_cat μ) := by
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_K (MvPolynomial.X μ) hXμ zero_lt_one,
          hfac, Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id]
      let C_μ := CommRingCat.of (HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X μ))
      let S_μ := CommRingCat.of (↥(R_b μ) ⧸ I_b μ)
      have h_away_top : (AlgebraicGeometry.Scheme.ΓSpecIso C_μ).inv ≫
          (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_K (MvPolynomial.X μ)).appTop =
          AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ) ≫
            (D_chart μ).topIso.inv := by
        change (AlgebraicGeometry.Scheme.ΓSpecIso C_μ).inv ≫
          (Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ))).appTop ≫
            (D_chart μ).toSpecΓ.appTop = _
        have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
          (AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ))
        have hnat_inv : (AlgebraicGeometry.Scheme.ΓSpecIso C_μ).inv ≫
            (Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ))).appTop =
            AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ) ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso _).inv := by
          rw [← cancel_mono (AlgebraicGeometry.Scheme.ΓSpecIso _).hom,
            Category.assoc, hnat, Iso.inv_hom_id_assoc,
            Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [← Category.assoc, hnat_inv, AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop,
          Category.assoc, Iso.inv_hom_id_assoc]
      have happ_eq := congrArg (fun m => (AlgebraicGeometry.Scheme.ΓSpecIso C_μ).inv ≫ m.appTop)
        hfac_right
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, ← Category.assoc, h_away_top,
        AlgebraicGeometry.Scheme.Hom.comp_appTop, ← Category.assoc] at happ_eq
      have hnat_φ := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (φ_cat μ)
      have hnat_φ_inv : (AlgebraicGeometry.Scheme.ΓSpecIso C_μ).inv ≫
          (Spec.map (φ_cat μ)).appTop =
          φ_cat μ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso S_μ).inv := by
        rw [← cancel_mono (AlgebraicGeometry.Scheme.ΓSpecIso S_μ).hom,
          Category.assoc, hnat_φ, Iso.inv_hom_id_assoc,
          Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [hnat_φ_inv] at happ_eq
      
      have heq_open : ((AlgebraicGeometry.Scheme.Hom.opensFunctor (D_chart μ).ι).obj ⊤) =
          D_chart μ := by
        ext x
        simp
      obtain ⟨r_iso, htop_res⟩ :
          ∃ r_iso : Q_K.left.presheaf.obj (Opposite.op (ι_Q ⁻¹ᵁ D_chart μ)) ≅
              (ι_Q ⁻¹ᵁ D_chart μ).toScheme.presheaf.obj (Opposite.op ⊤),
            (D_chart μ).topIso.inv ≫ (ι_Q ∣_ D_chart μ).appTop =
              ι_Q.app (D_chart μ) ≫ r_iso.hom := by
        let o_top : P_proj.Opens :=
          (AlgebraicGeometry.Scheme.Hom.opensFunctor (D_chart μ).ι).obj ⊤
        let o_sub : Q_K.left.Opens :=
          (AlgebraicGeometry.Scheme.Hom.opensFunctor (ι_Q ⁻¹ᵁ D_chart μ).ι).obj ⊤
        have ho_eq : o_top = D_chart μ := heq_open
        let e1 := Q_K.left.presheaf.mapIso
          ((TopologicalSpace.Opens.map ι_Q.base).mapIso (CategoryTheory.eqToIso ho_eq)).op
        let e2 : Q_K.left.presheaf.obj (Opposite.op (ι_Q ⁻¹ᵁ o_top)) ≅
            (ι_Q ⁻¹ᵁ D_chart μ).toScheme.presheaf.obj (Opposite.op ⊤) :=
          Q_K.left.presheaf.mapIso
            (CategoryTheory.eqToIso (show o_sub = ι_Q ⁻¹ᵁ o_top by ext x; simp [o_top, o_sub])).op
        have h1 : (D_chart μ).topIso.inv ≫ (ι_Q ∣_ D_chart μ).appTop =
            (P_proj.presheaf.map (CategoryTheory.eqToHom ho_eq).op ≫ ι_Q.app o_top) ≫
              e2.hom := by
          rw [AlgebraicGeometry.morphismRestrict_appTop]
          rfl
        refine ⟨e1.trans e2, ?_⟩
        rw [h1, ι_Q.naturality, Category.assoc]
        rfl
      rw [Category.assoc, htop_res] at happ_eq
      let iso_e_tot : S_μ ≅ (ι_Q ⁻¹ᵁ D_chart μ).toScheme.presheaf.obj (Opposite.op ⊤) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso S_μ).symm.trans
          { hom := e_tot.hom.appTop
            inv := e_tot.inv.appTop
            hom_inv_id := by
              rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_tot.inv_hom_id]
              exact AlgebraicGeometry.Scheme.Hom.id_app ⊤
            inv_hom_id := by
              rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_tot.hom_inv_id]
              exact AlgebraicGeometry.Scheme.Hom.id_app ⊤ }
      let iso_cod : S_μ ≅ Q_K.left.presheaf.obj (Opposite.op (ι_Q ⁻¹ᵁ D_chart μ)) :=
        iso_e_tot.trans r_iso.symm
      have hcomm_away : AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ) ≫
          ι_Q.app (D_chart μ) =
          φ_cat μ ≫ iso_cod.hom := by
        rw [← cancel_mono r_iso.hom]
        dsimp only [iso_cod, Iso.trans_hom, Iso.symm_hom, iso_e_tot]
        simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        exact happ_eq
      let e_away := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_K (MvPolynomial.X μ) hXμ zero_lt_one
      have he_away_hom : e_away.hom =
          AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ) :=
        AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜_K (MvPolynomial.X μ) hXμ zero_lt_one
      ext s
      rw [RingHom.mem_ker]
      let z := e_away.inv.hom s
      have hz_s : (AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ)).hom z = s := by
        rw [← he_away_hom]
        change (e_away.inv ≫ e_away.hom).hom s = s
        rw [e_away.inv_hom_id]
        rfl
      rw [← hz_s]
      have happ_z := congrArg (fun m => m.hom z) hcomm_away
      change (ι_Q.app (D_chart μ)).hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ)).hom z) =
        iso_cod.hom.hom (φ μ z) at happ_z
      rw [happ_z, map_eq_zero_iff iso_cod.hom.hom
        (ConcreteCategory.bijective_of_isIso iso_cod.hom).1,
        ← RingHom.mem_ker, hφ_ker μ hXμ, Ideal.mem_span_singleton', Ideal.mem_span_singleton']
      constructor
      · rintro ⟨w, hw⟩
        refine ⟨(AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ)).hom w, ?_⟩
        change (AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ)).hom w *
            (AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ)).hom f_μ =
          (AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ)).hom z
        rw [← map_mul, hw]
      · rintro ⟨s_w, hs_w⟩
        refine ⟨e_away.inv.hom s_w, ?_⟩
        apply (ConcreteCategory.bijective_of_isIso e_away.hom).1
        rw [he_away_hom, map_mul]
        have hs_w' : (AlgebraicGeometry.Proj.awayToSection 𝒜_K (MvPolynomial.X μ)).hom
            (e_away.inv.hom s_w) = s_w := by
          rw [← he_away_hom]
          change (e_away.inv ≫ e_away.hom).hom s_w = s_w
          rw [e_away.inv_hom_id]
          rfl
        rw [hs_w']
        exact hs_w
    
    have hU_sub' : U ≤ D_chart μ := hU_sub
    let U_aff : P_proj.affineOpens := ⟨U, hU_aff⟩
    let D_aff : P_proj.affineOpens := ⟨D_chart μ, hD_aff⟩
    have hle_aff : U_aff ≤ D_aff := hU_sub'
    have hker_U := AlgebraicGeometry.Scheme.Hom.ker_apply ι_Q U_aff
    have hker_D := AlgebraicGeometry.Scheme.Hom.ker_apply ι_Q D_aff
    have hmap := AlgebraicGeometry.Scheme.IdealSheafData.map_ideal ι_Q.ker hle_aff
    change RingHom.ker (ι_Q.app U_aff.1).hom = _
    rw [← hker_U, ← hmap, hker_D, hker_Dμ, Ideal.map_span, Set.image_singleton]
    congr 1

theorem weil_sing_dev_odp_sq_fiber_blowup_and_quadric_split (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom]
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom]
    (hProj_Ztilde : IsProjectiveOverField F Z_tilde)
    [AlgebraicGeometry.GeometricallyIrreducible (weilProjectiveSpaceOver F 1).hom]
    [AlgebraicGeometry.IsProper (weilProjectiveSpaceOver F 1).hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver F 1).hom]
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.Flat f₀.left]
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (hFibIrred : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver F 1).left),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left s))
    (s : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hs_sec : s ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (x_s : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z_tilde.left)
    (hx_s : x_s ≫ f₀.left = s)
    (hSm_away : ∀ z : Z_tilde.left,
      f₀.left.base z ∈ Set.range s.base → z ∉ Set.range x_s.base →
      ∃ V : Z_tilde.left.Opens, z ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left))
    (hOdp_s : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
      IsEtaleSplitOdpPointOver m f₀ (x_s.base pt) (s.base pt))
    (F₂ : Type u) [Field F₂] [Algebra F F₂] [FiniteDimensional F F₂]
    (hdeg₂ : Module.finrank F F₂ = 2) :
    let Z_s : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)) :=
      CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f₀.left s)
    ∃ (x_s0 : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z_s.left)
      (U_s : Z_s.left.Opens)
      (Z_tilde_s Q_s : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
      (_ : AlgebraicGeometry.GeometricallyIrreducible Z_tilde_s.hom)
      (_ : AlgebraicGeometry.IsProper Z_tilde_s.hom)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_tilde_s.hom)
      (_ : AlgebraicGeometry.IsProper Q_s.hom)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) Q_s.hom)
      (π_s : Z_tilde_s ⟶ Z_s)
      (i_Q : Q_s ⟶ Z_tilde_s)
      (ι_Q2 : (weilBaseChangeOver F F₂ Q_s).left ⟶
        (weilProjectiveSpaceOver F₂ (2 * m + 1)).left),
      (x_s0 ≫ CategoryTheory.Limits.pullback.fst f₀.left s = x_s ∧
        x_s0 ≫ Z_s.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F))) ∧
      (U_s : Set Z_s.left) = (Set.range x_s0.base)ᶜ ∧
      (AlgebraicGeometry.IsProper π_s.left ∧
        CategoryTheory.IsIso (π_s.left ∣_ U_s)) ∧
      (AlgebraicGeometry.IsClosedImmersion i_Q.left ∧
        Set.range i_Q.left.base =
          (((TopologicalSpace.Opens.map π_s.left.base).obj U_s : Z_tilde_s.left.Opens) :
            Set Z_tilde_s.left)ᶜ ∧
        CategoryTheory.IsPullback i_Q.left Q_s.hom π_s.left x_s0) ∧
      (ι_Q2 ≫ (weilProjectiveSpaceOver F₂ (2 * m + 1)).hom =
          (weilBaseChangeOver F F₂ Q_s).hom ∧
        IsHomogeneousHypersurfacePullbackOver F₂ (2 * m + 1) 2
          (𝟙 (weilProjectiveSpaceOver F₂ (2 * m + 1)))
          (∑ j ∈ Finset.range (m + 1),
            if h : 2 * j + 1 < 2 * m + 1 + 1 then
              (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
                MvPolynomial (Fin (2 * m + 1 + 1)) F₂) *
                MvPolynomial.X ⟨2 * j + 1, h⟩
            else 0)
          ι_Q2) :=
by
  intro Z_s
  
  have hSmOfOpens : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (d : ℕ) (f : X ⟶ Y),
      (∀ x : ↥X, ∃ W : X.Opens, x ∈ W ∧
        AlgebraicGeometry.SmoothOfRelativeDimension d (W.ι ≫ f)) →
      AlgebraicGeometry.SmoothOfRelativeDimension d f := by
    intro X Y d f h
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro x
    obtain ⟨W, hxW, hSmW⟩ := h x
    obtain ⟨U_o, hU_aff, V_o, hV_aff, hxV, hV_le, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff d (W.ι ≫ f)).mp hSmW ⟨x, hxW⟩
    let V' : X.Opens := W.ι ''ᵁ V_o
    have hV'_aff : AlgebraicGeometry.IsAffineOpen V' := hV_aff.image_of_isOpenImmersion W.ι
    have hxV' : x ∈ V' := ⟨⟨x, hxW⟩, hxV, rfl⟩
    have hV'_le : V' ≤ (TopologicalSpace.Opens.map f.base).obj U_o := by
      rintro _ ⟨w, hwV, rfl⟩
      exact hV_le hwV
    have hV_le' : V_o ≤ (TopologicalSpace.Opens.map W.ι.base).obj V' := by
      intro w hw
      exact ⟨w, hw, rfl⟩
    have happ_comp : (W.ι ≫ f).appLE U_o V_o hV_le =
        f.appLE U_o V' hV'_le ≫ W.ι.appLE V' V_o hV_le' :=
      (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE W.ι f U_o V' V_o hV'_le hV_le').symm
    have heq_V : V_o = (TopologicalSpace.Opens.map W.ι.base).obj V' := by
      ext w
      simp [V']
    have : CategoryTheory.IsIso (W.toScheme.presheaf.map (CategoryTheory.homOfLE hV_le').op) := by
      rw [show CategoryTheory.homOfLE hV_le' = CategoryTheory.eqToHom heq_V from rfl]
      infer_instance
    have : CategoryTheory.IsIso (W.ι.appLE V' V_o hV_le') := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE]
      infer_instance
    let e_V := asIso (W.ι.appLE V' V_o hV_le')
    have happ_eq : f.appLE U_o V' hV'_le =
        (W.ι ≫ f).appLE U_o V_o hV_le ≫ e_V.inv := by
      rw [happ_comp]
      dsimp [e_V]
      rw [CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
        CategoryTheory.Category.comp_id]
    refine ⟨U_o, hU_aff, V', hV'_aff, hxV', hV'_le, ?_⟩
    rw [happ_eq, CommRingCat.hom_comp]
    have hbij : Function.Bijective e_V.inv.hom :=
      ConcreteCategory.bijective_of_isIso e_V.inv
    have h0 : RingHom.IsStandardSmoothOfRelativeDimension 0 e_V.inv.hom := by
      letI : Algebra ↑(W.toScheme.presheaf.obj (Opposite.op V_o))
          ↑(X.presheaf.obj (Opposite.op V')) := e_V.inv.hom.toAlgebra
      exact Algebra.IsStandardSmoothOfRelativeDimension.of_algebraMap_bijective hbij
    exact Nat.zero_add d ▸ RingHom.IsStandardSmoothOfRelativeDimension.comp h0 hStd

  
  have hRedOfSm : ∀ (K₀ : Type u) [Field K₀] (d : ℕ)
      (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₀)))
      [AlgebraicGeometry.SmoothOfRelativeDimension d W.hom],
      AlgebraicGeometry.IsReduced W.left := by
    intro K₀ _ d W _
    have : ∀ x : ↥W.left, _root_.IsReduced ↑(W.left.presheaf.stalk x) := by
      intro x
      obtain ⟨U_o, _, V_o, hV_aff, hxV, hV_le, hStdSm⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff d W.hom).mp inferInstance x
      have : Nonempty U_o := ⟨⟨W.hom.base x, hV_le hxV⟩⟩
      let R := ↑((AlgebraicGeometry.Spec (CommRingCat.of K₀)).presheaf.obj (Opposite.op U_o))
      have : IsDomain R := inferInstance
      let S := ↑(W.left.presheaf.obj (Opposite.op V_o))
      obtain ⟨g_et, _, hg_et⟩ :=
        RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hStdSm
      letI : Algebra (MvPolynomial (Fin d) R) S := g_et.toAlgebra
      have : Algebra.Etale (MvPolynomial (Fin d) R) S :=
        RingHom.etale_algebraMap.mp hg_et
      let K_frac := FractionRing (MvPolynomial (Fin d) R)
      have hInj_lin : Function.Injective (Algebra.linearMap (MvPolynomial (Fin d) R) K_frac) :=
        IsFractionRing.injective (MvPolynomial (Fin d) R) K_frac
      have hInj_rtens : Function.Injective
          (LinearMap.rTensor S (Algebra.linearMap (MvPolynomial (Fin d) R) K_frac)) :=
        Module.Flat.rTensor_preserves_injective_linearMap
          (Algebra.linearMap (MvPolynomial (Fin d) R) K_frac) hInj_lin
      have hInj_incR : Function.Injective
          (Algebra.TensorProduct.includeRight :
            S →ₐ[MvPolynomial (Fin d) R] TensorProduct (MvPolynomial (Fin d) R) K_frac S) := by
        intro s₁ s₂ hs
        apply (TensorProduct.lid (MvPolynomial (Fin d) R) S).symm.injective
        apply hInj_rtens
        simpa using hs
      have : _root_.IsReduced (TensorProduct (MvPolynomial (Fin d) R) K_frac S) :=
        Algebra.FormallyUnramified.isReduced_of_field K_frac
          (TensorProduct (MvPolynomial (Fin d) R) K_frac S)
      have : _root_.IsReduced S := isReduced_of_injective _ hInj_incR
      letI : Algebra S ↑(W.left.presheaf.stalk x) :=
        TopCat.Presheaf.algebra_section_stalk W.left.presheaf ⟨x, hxV⟩
      let M_x := (hV_aff.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl
      have : IsLocalization M_x ↑(W.left.presheaf.stalk x) :=
        hV_aff.isLocalization_stalk ⟨x, hxV⟩
      refine ⟨fun z ⟨n, hn⟩ => ?_⟩
      obtain ⟨⟨s_n, m_d⟩, hsm⟩ := IsLocalization.surj M_x z
      have hsn : algebraMap S ↑(W.left.presheaf.stalk x) (s_n ^ n) = 0 := by
        rw [map_pow, ← hsm, mul_pow, hn, zero_mul]
      obtain ⟨c, hc⟩ := (IsLocalization.map_eq_zero_iff M_x _ _).mp hsn
      have hcs_nil : IsNilpotent ((c : S) * s_n) := ⟨n + 1, by
        have hring : ((c : S) * s_n) ^ (n + 1) = (c : S) ^ n * s_n * ((c : S) * s_n ^ n) := by
          ring
        rw [hring, hc, mul_zero]⟩
      have hcs0 : (c : S) * s_n = 0 := hcs_nil.eq_zero
      have hs_map0 : algebraMap S ↑(W.left.presheaf.stalk x) s_n = 0 :=
        (IsLocalization.map_eq_zero_iff M_x _ s_n).mpr ⟨c, hcs0⟩
      have hzm0 : z * algebraMap S ↑(W.left.presheaf.stalk x) m_d = 0 := hsm.trans hs_map0
      exact (IsLocalization.map_units ↑(W.left.presheaf.stalk x) m_d).mul_left_eq_zero.mp hzm0
    exact AlgebraicGeometry.isReduced_of_isReduced_stalk W.left

  
  let x_s0 : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z_s.left :=
    CategoryTheory.Limits.pullback.lift x_s (𝟙 _)
      (by rw [CategoryTheory.Category.id_comp]; exact hx_s)
  have hx_s0_fst : x_s0 ≫ CategoryTheory.Limits.pullback.fst f₀.left s = x_s :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hx_s0_sec : x_s0 ≫ Z_s.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)) :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hProp_Zs : AlgebraicGeometry.IsProper Z_s.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback f₀.left s) inferInstance
  have : AlgebraicGeometry.IsProper Z_s.hom := hProp_Zs
  have hx_s0_cl : AlgebraicGeometry.IsClosedImmersion x_s0 := by
    have : AlgebraicGeometry.IsClosedImmersion (x_s0 ≫ Z_s.hom) := by
      rw [hx_s0_sec]; infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp x_s0 Z_s.hom
  have : AlgebraicGeometry.IsClosedImmersion x_s0 := hx_s0_cl
  have hs_cl : AlgebraicGeometry.IsClosedImmersion s := by
    have : AlgebraicGeometry.IsClosedImmersion (s ≫ (weilProjectiveSpaceOver F 1).hom) := by
      rw [hs_sec]; infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp s (weilProjectiveSpaceOver F 1).hom
  have : AlgebraicGeometry.IsClosedImmersion s := hs_cl
  have hfst_cl : AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.fst f₀.left s) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback f₀.left s).flip inferInstance
  have : AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.fst f₀.left s) := hfst_cl
  have hProj_Zs : IsProjectiveOverField F Z_s := by
    rcases hProj_Ztilde with ⟨N, ι_Z, hCl_Z⟩
    have : AlgebraicGeometry.IsClosedImmersion ι_Z.left := hCl_Z
    let ι_s : Z_s ⟶ Z_tilde := CategoryTheory.Over.homMk
      (CategoryTheory.Limits.pullback.fst f₀.left s) (by
        dsimp [Z_s]
        rw [← f₀.w, ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc, hs_sec, CategoryTheory.Category.comp_id])
    refine ⟨N, ι_s ≫ ι_Z, ?_⟩
    change AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.fst f₀.left s ≫ ι_Z.left)
    infer_instance
  let U_s : Z_s.left.Opens :=
    ⟨(Set.range x_s0.base)ᶜ, x_s0.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hUs_eq : (U_s : Set Z_s.left) = (Set.range x_s0.base)ᶜ := rfl
  have hDisj_supp : Disjoint (U_s : Set Z_s.left) (x_s0.ker.support : Set Z_s.left) := by
    rw [AlgebraicGeometry.Scheme.Hom.support_ker, x_s0.isClosedEmbedding.isClosed_range.closure_eq,
      hUs_eq]
    exact disjoint_compl_left
  have hSm_Us : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (U_s.ι ≫ Z_s.hom) := by
    apply hSmOfOpens
    intro u
    have hu_not : U_s.ι.base u ∉ Set.range x_s0.base := u.2
    let z : Z_tilde.left := (CategoryTheory.Limits.pullback.fst f₀.left s).base (U_s.ι.base u)
    have hz_in : f₀.left.base z ∈ Set.range s.base := by
      have hc : (CategoryTheory.Limits.pullback.fst f₀.left s ≫ f₀.left).base (U_s.ι.base u) =
          (CategoryTheory.Limits.pullback.snd f₀.left s ≫ s).base (U_s.ι.base u) := by
        rw [CategoryTheory.Limits.pullback.condition]
      exact ⟨_, hc.symm⟩
    have hz_not : z ∉ Set.range x_s.base := by
      rintro ⟨pt, hpt⟩
      apply hu_not
      refine ⟨pt, ?_⟩
      apply (CategoryTheory.Limits.pullback.fst f₀.left s).isClosedEmbedding.injective
      change (x_s0 ≫ CategoryTheory.Limits.pullback.fst f₀.left s).base pt = z
      rwa [hx_s0_fst]
    obtain ⟨V, hzV, hSmV⟩ := hSm_away z hz_in hz_not
    let V_s : Z_s.left.Opens :=
      (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst f₀.left s).base).obj V
    have hpb_Vs : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f₀.left s ∣_ V) (V_s.ι ≫ Z_s.hom)
        (V.ι ≫ f₀.left) s :=
      (AlgebraicGeometry.isPullback_morphismRestrict
        (CategoryTheory.Limits.pullback.fst f₀.left s) V).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback f₀.left s)
    have : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V_s.ι ≫ Z_s.hom) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Vs hSmV
    let W : U_s.toScheme.Opens := (TopologicalSpace.Opens.map U_s.ι.base).obj V_s
    have hW_comp : W.ι ≫ U_s.ι ≫ Z_s.hom =
        (U_s.ι ∣_ V_s) ≫ (V_s.ι ≫ Z_s.hom) := by
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι,
        CategoryTheory.Category.assoc]
    refine ⟨W, hzV, ?_⟩
    rw [hW_comp]
    exact Nat.zero_add (2 * m + 1) ▸ inferInstance

  
  obtain ⟨hInt_Zs, hInt_Zs_bc, U, alg_A₀, ε₀, E₁, hField₁, hAlg₁, hFinDim₁,
      B', hRingB', q₀, φ₁, φ₂, halg_A₀, hFT_A₀, hε₀_Spec, hε₀_id,
      hφ₁_et, hφ₂_et, hφ_alg, hq₁, hq₂, hSpan_B⟩ :=
    weil_odp_fiber_integral_and_affine_ring_roof
      F m Z_tilde f₀ hFibIrred s hs_sec x_s hx_s hSm_away hOdp_s x_s0 hx_s0_fst hx_s0_sec
  letI : Field E₁ := hField₁
  letI : Algebra F E₁ := hAlg₁
  letI : FiniteDimensional F E₁ := hFinDim₁
  letI : CommRing B' := hRingB'
  have : AlgebraicGeometry.IsIntegral Z_s.left := hInt_Zs
  let pt_F : AlgebraicGeometry.Spec (CommRingCat.of F) := default
  have hp₀_U : x_s0.base pt_F ∈ U.1 := by
    change x_s0.base pt_F ∈ (U.1 : Set Z_s.left)
    rw [← U.2.range_fromSpec, ← hε₀_Spec]
    exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε₀)).base pt_F, rfl⟩
  have : Nonempty U.1 := ⟨⟨x_s0.base pt_F, hp₀_U⟩⟩
  have : IsDomain ↑(Z_s.left.presheaf.obj (Opposite.op U.1)) := inferInstance
  obtain ⟨s₀, _hs₀, Q₀, hQ₀_hom, hQ₀_det, hLoc⟩ :=
    weil_odp_ring_roof_tangent_quadric_and_rees_smooth
      F m ↑(Z_s.left.presheaf.obj (Opposite.op U.1)) alg_A₀ hFT_A₀ ε₀ hε₀_id
      E₁ B' q₀ φ₁ hφ₁_et φ₂ hφ₂_et hφ_alg hq₁ hq₂ hSpan_B
  let U' : Z_s.left.affineOpens := Z_s.left.affineBasicOpen s₀
  have hU' : AlgebraicGeometry.IsAffineOpen U'.1 := U'.2
  have : AlgebraicGeometry.IsOpenImmersion U'.2.fromSpec := hU'.isOpenImmersion_fromSpec
  let loc : ↑(Z_s.left.presheaf.obj (Opposite.op U.1)) →+*
      ↑(Z_s.left.presheaf.obj (Opposite.op U'.1)) :=
    (Z_s.left.presheaf.map (CategoryTheory.homOfLE (Z_s.left.basicOpen_le s₀)).op).hom
  have hLoc_inst : @IsLocalization.Away _ _ s₀
      ↑(Z_s.left.presheaf.obj (Opposite.op U'.1)) _ loc.toAlgebra := by
    letI : Algebra ↑(Z_s.left.presheaf.obj (Opposite.op U.1))
        ↑(Z_s.left.presheaf.obj (Opposite.op (Z_s.left.basicOpen s₀))) := loc.toAlgebra
    exact U.2.isLocalization_basicOpen s₀
  obtain ⟨ε', y, hε'_id, hε'_comp, hker_ε', hy_nz, hRees_field, hRees_algClosed⟩ :=
    hLoc ↑(Z_s.left.presheaf.obj (Opposite.op U'.1)) loc hLoc_inst
  let alg_A' : F →+* ↑(Z_s.left.presheaf.obj (Opposite.op U'.1)) := loc.comp alg_A₀
  have hfrom_U' : AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc) ≫ U.2.fromSpec =
      hU'.fromSpec := by
    dsimp [loc, U', hU', AlgebraicGeometry.Scheme.affineBasicOpen]
    exact U.2.map_fromSpec U'.2 (CategoryTheory.homOfLE (Z_s.left.basicOpen_le s₀)).op
  have hfrom_eq_U' : hU'.fromSpec = U'.2.fromSpec := rfl
  have halg_A'_hU' : AlgebraicGeometry.Spec.map (CommRingCat.ofHom alg_A') =
      hU'.fromSpec ≫ Z_s.hom := by
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (loc.comp alg_A₀)) =
      hU'.fromSpec ≫ Z_s.hom
    rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, halg_A₀,
      ← CategoryTheory.Category.assoc, hfrom_U']
  have halg_A' : AlgebraicGeometry.Spec.map (CommRingCat.ofHom alg_A') =
      U'.2.fromSpec ≫ Z_s.hom := halg_A'_hU'
  have hx_s0_hU' : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε') ≫ hU'.fromSpec = x_s0 := by
    rw [← hfrom_U', ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hε'_comp, hε₀_Spec]
  have hx_s0_U' : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε') ≫ U'.2.fromSpec = x_s0 := by
    rwa [← hfrom_eq_U']
  have hker_U' : x_s0.ker.ideal U' = RingHom.ker ε' := by
    rw [AlgebraicGeometry.Scheme.Hom.ker_apply, ← hx_s0_hU']
    ext a
    simp only [RingHom.mem_ker]
    rw [AlgebraicGeometry.Scheme.Hom.comp_app, hU'.fromSpec_app_self]
    have htop_eq : (TopologicalSpace.Opens.map hU'.fromSpec.base).obj U'.1 = ⊤ := by
      ext p; simp [hU'.range_fromSpec]
    let e_res := (AlgebraicGeometry.Spec
        (CommRingCat.of ↑(Z_s.left.presheaf.obj (Opposite.op U'.1)))).presheaf.mapIso
      (CategoryTheory.eqToIso htop_eq).op
    let e_F := (AlgebraicGeometry.Spec (CommRingCat.of F)).presheaf.mapIso
      (CategoryTheory.eqToIso
        (show (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε')).base).obj
            ((TopologicalSpace.Opens.map hU'.fromSpec.base).obj U'.1) = ⊤ by
          ext q; simp [htop_eq])).op
    have hcomm_app : e_res.hom ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε')).app
          ((TopologicalSpace.Opens.map hU'.fromSpec.base).obj U'.1) =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε')).appTop ≫ e_F.hom := by
      dsimp [e_res, e_F]
      exact (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε')).naturality _
    have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom ε')
    have hnat_inv : (AlgebraicGeometry.Scheme.ΓSpecIso (Z_s.left.presheaf.obj (Opposite.op U'.1))).inv ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε')).appTop =
        CommRingCat.ofHom ε' ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv := by
      rw [← CategoryTheory.Category.comp_id
        ((AlgebraicGeometry.Scheme.ΓSpecIso (Z_s.left.presheaf.obj (Opposite.op U'.1))).inv ≫
