            AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ) ≫ f_X.appLE (D μ) W hWμ := by
          rw [ha, CategoryTheory.Category.assoc, hb]
        exact congrArg (fun φ => φ.hom (z_F μ)) hc
      have hsec2 : (f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 x_prod) W hW_prod).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜 x_prod).hom (m₂ (z_F μ'))) =
          ℓ_sec μ' W hWμ' := by
        have ha := AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜 (hX_deg μ)
          (mul_comm (MvPolynomial.X μ) (MvPolynomial.X μ') : x_prod = MvPolynomial.X μ' * MvPolynomial.X μ)
        have hb := AlgebraicGeometry.Scheme.Hom.map_appLE f_X hW_prod
          (CategoryTheory.homOfLE (by rw [hD_prod]; exact inf_le_right :
            AlgebraicGeometry.Proj.basicOpen 𝒜 x_prod ≤ D μ')).op
        have hc : (CommRingCat.ofHom m₂ ≫ AlgebraicGeometry.Proj.awayToSection 𝒜 x_prod) ≫
            f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 x_prod) W hW_prod =
