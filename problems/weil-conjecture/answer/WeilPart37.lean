      by simp only [CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id_assoc,
        CategoryTheory.IsIso.inv_hom_id]⟩⟩

  have isIso_of_inv : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀]
      {J₀ : CategoryTheory.GrothendieckTopology C₀}
