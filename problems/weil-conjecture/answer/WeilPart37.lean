      ext u
      have hu_eq : j_1.inv.base (j_1.hom.base u) = u := by
        change (j_1.hom ≫ j_1.inv).base u = u; rw [j_1.hom_inv_id]; rfl
      have hiff := SetLike.ext_iff.mp hpre_inv (j_1.hom.base u)
      change U₁.ι.base (j_1.inv.base (j_1.hom.base u)) ∈ Z_t.basicOpen (ψ₁ Polynomial.X) ↔
