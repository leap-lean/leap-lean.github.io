  · 
    intro T U₀ U₁ hCov i₀ i₁ hi₀ hi₁ hOv₀ hOv₁ hGlue
    let X_poly : Polynomial K := Polynomial.X
    let L_X := Localization.Away X_poly
    let α_id : Polynomial K →+* L_X := algebraMap (Polynomial K) L_X
    let α_inv : Polynomial K →+* L_X :=
