      apply RingHom.ext; intro s
      have hs := congrArg (fun f : _ →+* _ => f (ψ₁.symm s)) hcomp_ψ₁
      simpa using hs
    have hj0_inv : j_0.inv ≫ U₀.ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.symm.toRingHom) ≫ hAff₀.fromSpec := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.symm.toRingHom) ≫
        hAff₀.isoSpec.inv) ≫ U₀.ι = _
      rw [CategoryTheory.Category.assoc, hAff₀.isoSpec_inv_ι]
    have hj1_inv : j_1.inv ≫ U₁.ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁.symm.toRingHom) ≫ hAff₁.fromSpec := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁.symm.toRingHom) ≫
        hAff₁.isoSpec.inv) ≫ U₁.ι = _
      rw [CategoryTheory.Category.assoc, hAff₁.isoSpec_inv_ι]
    have hL_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L) ≫ j_0.inv ≫ U₀.ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ω) ≫ hAffOv.fromSpec := by
      dsimp only [g₀_L] at hω_res₀
      rw [hj0_inv, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← hω_res₀, CommRingCat.ofHom_comp,
        AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
      congr 1
      exact hAff₀.map_fromSpec hAffOv (CategoryTheory.homOfLE (inf_le_left : U_ov ≤ U₀)).op
    have hR_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_L) ≫ j_1.inv ≫ U₁.ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ω) ≫ hAffOv.fromSpec := by
      rw [hj1_inv, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← hω_res₁, CommRingCat.ofHom_comp,
        AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
      congr 1
      exact hAff₁.map_fromSpec hAffOv (CategoryTheory.homOfLE (inf_le_right : U_ov ≤ U₁)).op
    exact hL_eq.trans hR_eq.symm

  
  
  
  let N_succ : ℕ := 2 * (m + 1) + 1
  let N_m : ℕ := 2 * m + 1
  let 𝒜_succ := MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K
  let 𝒜_m := MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) K
  letI : GradedAlgebra 𝒜_succ := MvPolynomial.gradedAlgebra
  letI : GradedAlgebra 𝒜_m := MvPolynomial.gradedAlgebra

  obtain ⟨hCov_Psucc, hAff_Dsucc, hDiag_ρsucc, hOv_ρsucc, hBasic_Dsucc, hDehom_succ⟩ :=
    hProjGen N_succ
  obtain ⟨hCov_Pm, hAff_Dm, hDiag_ρm, hOv_ρm, hBasic_Dm, hDehom_m⟩ :=
    hProjGen N_m

  let D_succ : Fin (2 * (m + 1) + 2) → (weilProjectiveSpaceOver K N_succ).left.Opens :=
    fun μ => weilProjBasicOpen K N_succ μ
  let D_m : Fin (2 * m + 2) → (weilProjectiveSpaceOver K N_m).left.Opens :=
    fun b => weilProjBasicOpen K N_m b
  let ρ_succ : ∀ μ : Fin (2 * (m + 1) + 2), Fin (2 * (m + 1) + 2) →
      ↑((weilProjectiveSpaceOver K N_succ).left.presheaf.obj (Opposite.op (D_succ μ))) :=
    fun μ ν =>
      (AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X μ)).hom
        (HomogeneousLocalization.Away.mk 𝒜_succ
          (MvPolynomial.isHomogeneous_X K μ) 1
          (MvPolynomial.X ν)
          (MvPolynomial.isHomogeneous_X K ν))
  let ρ_m : ∀ b : Fin (2 * m + 2), Fin (2 * m + 2) →
      ↑((weilProjectiveSpaceOver K N_m).left.presheaf.obj (Opposite.op (D_m b))) :=
    fun b a =>
      (AlgebraicGeometry.Proj.awayToSection 𝒜_m (MvPolynomial.X b)).hom
        (HomogeneousLocalization.Away.mk 𝒜_m
          (MvPolynomial.isHomogeneous_X K b) 1
          (MvPolynomial.X a)
          (MvPolynomial.isHomogeneous_X K a))

  let f_Z : Z_cone.left ⟶ (weilProjectiveSpaceOver K N_succ).left := i_Z.left ≫ ι_succ
  have hf_Z_hom : f_Z ≫ (weilProjectiveSpaceOver K N_succ).hom = Z_cone.hom := by
    change (i_Z.left ≫ ι_succ) ≫ _ = _
    rw [CategoryTheory.Category.assoc, hι_succ, i_Z.w]

  have _hCl_succ : AlgebraicGeometry.IsClosedImmersion ι_succ := hSplit_succ.1
  have _hCl_iZ : AlgebraicGeometry.IsClosedImmersion i_Z.left := hSplit_Z.1
  have _hCl_m : AlgebraicGeometry.IsClosedImmersion ι_m := hSplit_m.1
  have _hCl_fZ : AlgebraicGeometry.IsClosedImmersion f_Z := inferInstance

  have hW_cov : (⨆ b : Fin (2 * m + 2), W b) = ⊤ := by
    rw [eq_top_iff]; intro q _
    have hq : ι_m.base q ∈ (⨆ b : Fin (2 * m + 2), D_m b) := by rw [hCov_Pm]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hq ⊢
    exact hq
  have hAff_Z : ∀ μ : Fin (2 * (m + 1) + 2), AlgebraicGeometry.IsAffineOpen (Z_chart μ) :=
    fun μ => (hAff_Dsucc μ).preimage f_Z
  have hAff_W : ∀ b : Fin (2 * m + 2), AlgebraicGeometry.IsAffineOpen (W b) :=
    fun b => (hAff_Dm b).preimage ι_m

  let ξ : ∀ μ : Fin (2 * (m + 1) + 2), Fin (2 * (m + 1) + 2) →
      ↑(Z_cone.left.presheaf.obj (Opposite.op (Z_chart μ))) :=
    fun μ ν => (f_Z.appLE (D_succ μ) (Z_chart μ) (le_refl _)).hom (ρ_succ μ ν)
  let η : ∀ b : Fin (2 * m + 2), Fin (2 * m + 2) →
      ↑(Q_m.left.presheaf.obj (Opposite.op (W b))) :=
    fun b a => (ι_m.appLE (D_m b) (W b) (le_refl _)).hom (ρ_m b a)

  have hξ_diag : ∀ μ, ξ μ μ = 1 := by
    intro μ
    have h1 : ρ_succ μ μ = 1 := hDiag_ρsucc μ
    dsimp only [ξ]; rw [h1, map_one]
  have hη_diag : ∀ b, η b b = 1 := by
    intro b
    have h1 : ρ_m b b = 1 := hDiag_ρm b
    dsimp only [η]; rw [h1, map_one]

  have hPullOv : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (g : X ⟶ Y) {α_t : Type}
      (D : α_t → Y.Opens)
      (ρ : ∀ i : α_t, α_t → ↑(Y.presheaf.obj (Opposite.op (D i))))
      (hOv : ∀ i j : α_t,
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D i ⊓ D j ≤ D i)).op).hom (ρ i j) *
          (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D i ⊓ D j ≤ D j)).op).hom (ρ j i) = 1 ∧
        ∀ k : α_t,
          (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D i ⊓ D j ≤ D i)).op).hom (ρ i k) =
            (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D i ⊓ D j ≤ D i)).op).hom (ρ i j) *
              (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D i ⊓ D j ≤ D j)).op).hom (ρ j k))
      (i j : α_t),
      let C_g : α_t → X.Opens := fun r => (TopologicalSpace.Opens.map g.base).obj (D r)
      let ξ_g : ∀ r : α_t, α_t → ↑(X.presheaf.obj (Opposite.op (C_g r))) :=
        fun r k => (g.appLE (D r) (C_g r) (le_refl _)).hom (ρ r k)
      (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : C_g i ⊓ C_g j ≤ C_g i)).op).hom (ξ_g i j) *
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : C_g i ⊓ C_g j ≤ C_g j)).op).hom (ξ_g j i) = 1 ∧
      ∀ k : α_t,
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : C_g i ⊓ C_g j ≤ C_g i)).op).hom (ξ_g i k) =
          (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : C_g i ⊓ C_g j ≤ C_g i)).op).hom (ξ_g i j) *
            (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : C_g i ⊓ C_g j ≤ C_g j)).op).hom (ξ_g j k) := by
    intro X Y g α_t D ρ hOv i j C_g ξ_g
    have h_sub_ij : C_g i ⊓ C_g j ≤ (TopologicalSpace.Opens.map g.base).obj (D i ⊓ D j) :=
      fun _ h => h
    have hL : ∀ k : α_t,
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : C_g i ⊓ C_g j ≤ C_g i)).op).hom
          (ξ_g i k) =
        (g.appLE (D i ⊓ D j) (C_g i ⊓ C_g j) h_sub_ij).hom
          ((Y.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (ρ i k)) := by
      intro k
      have hc : g.appLE (D i) (C_g i) (le_refl _) ≫
          X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : C_g i ⊓ C_g j ≤ C_g i)).op =
          Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D i ⊓ D j ≤ D i)).op ≫
            g.appLE (D i ⊓ D j) (C_g i ⊓ C_g j) h_sub_ij := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE_map, AlgebraicGeometry.Scheme.Hom.map_appLE]
      exact congrArg (fun φ : Y.presheaf.obj (Opposite.op (D i)) ⟶ _ => φ.hom (ρ i k)) hc
    have hR : ∀ k : α_t,
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : C_g i ⊓ C_g j ≤ C_g j)).op).hom
          (ξ_g j k) =
        (g.appLE (D i ⊓ D j) (C_g i ⊓ C_g j) h_sub_ij).hom
          ((Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (ρ j k)) := by
      intro k
      have hc : g.appLE (D j) (C_g j) (le_refl _) ≫
          X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : C_g i ⊓ C_g j ≤ C_g j)).op =
          Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D i ⊓ D j ≤ D j)).op ≫
            g.appLE (D i ⊓ D j) (C_g i ⊓ C_g j) h_sub_ij := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE_map, AlgebraicGeometry.Scheme.Hom.map_appLE]
      exact congrArg (fun φ : Y.presheaf.obj (Opposite.op (D j)) ⟶ _ => φ.hom (ρ j k)) hc
    refine ⟨?_, fun k => ?_⟩
    · rw [hL j, hR i, ← map_mul, (hOv i j).1, map_one]
    · rw [hL k, hL j, hR k, ← map_mul, (hOv i j).2 k]

  have hξ_ov := hPullOv f_Z D_succ ρ_succ hOv_ρsucc
  have hη_ov := hPullOv ι_m D_m ρ_m hOv_ρm

  have hBasic_Z : ∀ μ μ' : Fin (2 * (m + 1) + 2),
      Z_chart μ ⊓ Z_chart μ' = Z_cone.left.basicOpen (ξ μ μ') := by
    intro μ μ'
    have happ_eq : ξ μ μ' = (f_Z.app (D_succ μ)).hom (ρ_succ μ μ') := by
      dsimp [ξ]; rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE f_Z]
    rw [happ_eq, ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, ← hBasic_Dsucc μ μ']
    rfl
  have hBasic_W : ∀ b b' : Fin (2 * m + 2),
      W b ⊓ W b' = Q_m.left.basicOpen (η b b') := by
    intro b b'
    have happ_eq : η b b' = (ι_m.app (D_m b)).hom (ρ_m b b') := by
      dsimp [η]; rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE ι_m]
    rw [happ_eq, ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, ← hBasic_Dm b b']
    rfl

  
  let R_b : Fin (2 * m + 2) → Type u :=
    fun b => ↑(Q_m.left.presheaf.obj (Opposite.op (W b)))
  let hCR : ∀ b : Fin (2 * m + 2), CommRing (R_b b) := fun _ => inferInstance
  let hAlg : ∀ b : Fin (2 * m + 2), Algebra K (R_b b) :=
    fun b => (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
      Q_m.hom.appLE ⊤ (W b) le_top).hom).toAlgebra
  let i_Wb : ∀ b : Fin (2 * m + 2),
      (W b).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (R_b b)) :=
    fun b => (hAff_W b).isoSpec

  
  let F_succ : MvPolynomial (Fin (2 * (m + 1) + 2)) K :=
    ∑ j ∈ Finset.range (m + 1 + 1),
      if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
        (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
          MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) K) *
          MvPolynomial.X ⟨2 * j + 1, h⟩
      else 0
  let F_m : MvPolynomial (Fin (2 * m + 2)) K :=
    ∑ j ∈ Finset.range (m + 1),
      if h : 2 * j + 1 < 2 * m + 1 + 1 then
        (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
          MvPolynomial (Fin (2 * m + 1 + 1)) K) *
          MvPolynomial.X ⟨2 * j + 1, h⟩
      else 0

  have hF_succ_decomp : F_succ =
      MvPolynomial.rename (Fin.succ ∘ Fin.succ) F_m +
        MvPolynomial.X 0 * MvPolynomial.X 1 := by
    dsimp [F_succ, F_m]
    rw [Finset.sum_range_succ', map_sum]
    congr 1
    refine Finset.sum_congr rfl fun k _ => ?_
    split_ifs with hk_succ hk hk
    · rw [map_mul, MvPolynomial.rename_X, MvPolynomial.rename_X]
      have h0 : (⟨2 * (k + 1), Nat.lt_of_succ_lt hk_succ⟩ : Fin (2 * (m + 1) + 2)) =
          (⟨2 * k, Nat.lt_of_succ_lt hk⟩ : Fin (2 * m + 2)).succ.succ := by
        ext; dsimp; omega
      have h1 : (⟨2 * (k + 1) + 1, hk_succ⟩ : Fin (2 * (m + 1) + 2)) =
          (⟨2 * k + 1, hk⟩ : Fin (2 * m + 2)).succ.succ := by
        ext; dsimp; omega
      rw [h0, h1]; rfl
    · omega
    · omega
    · rw [map_zero]

  have h_appLE_eq : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : X ⟶ Y}
      (hf : f₁ = f₂) (U : Y.Opens) (V : X.Opens)
      (h₁ : V ≤ (TopologicalSpace.Opens.map f₁.base).obj U)
      (h₂ : V ≤ (TopologicalSpace.Opens.map f₂.base).obj U),
      AlgebraicGeometry.Scheme.Hom.appLE f₁ U V h₁ =
        AlgebraicGeometry.Scheme.Hom.appLE f₂ U V h₂ := by
    intro X Y f₁ f₂ hf U V h₁ h₂
    subst hf; rfl

  
  obtain ⟨hFm_hom, _, hKer_m⟩ := hSplit_m.2
  have hChartQm : ∀ b : Fin (2 * m + 2),
      letI : Algebra K (R_b b) := hAlg b
      ∃ γ_b : MvPolynomial (Fin (2 * m + 1)) K →+* R_b b,
        Function.Surjective γ_b ∧
        RingHom.ker γ_b =
          Ideal.span {MvPolynomial.eval₂Hom MvPolynomial.C
            (Fin.insertNth b 1 MvPolynomial.X) F_m} ∧
        γ_b.comp (MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth b 1 MvPolynomial.X)) =
          MvPolynomial.eval₂Hom (algebraMap K (R_b b)) (η b) ∧
        Function.Surjective (MvPolynomial.eval₂Hom (algebraMap K (R_b b)) (η b)) ∧
        MvPolynomial.aeval (fun a => Polynomial.C (η b a) * Polynomial.X) F_m = 0 := by
    intro b
    letI : Algebra K (R_b b) := hAlg b
    obtain ⟨θ_b, hθ_mk, hθ_C, hθ_X⟩ := hDehom_m b
    let away_b := AlgebraicGeometry.Proj.awayToSection 𝒜_m (MvPolynomial.X b)
    let away_b_hom : HomogeneousLocalization.Away 𝒜_m (MvPolynomial.X b) →+*
        ↑((weilProjectiveSpaceOver K N_m).left.presheaf.obj (Opposite.op (D_m b))) :=
      away_b.hom
    have hAwayBij : Function.Bijective away_b_hom := by
      have heq := (AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜_m (MvPolynomial.X b)
        (MvPolynomial.isHomogeneous_X K b) zero_lt_one).symm
      change Function.Bijective away_b.hom
      dsimp only [away_b]
      rw [heq]
      exact (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_m (MvPolynomial.X b)
        (MvPolynomial.isHomogeneous_X K b) zero_lt_one).commRingCatIsoToRingEquiv.bijective
    have hι_surj : Function.Surjective (ι_m.app (D_m b)).hom :=
      AlgebraicGeometry.Scheme.Hom.app_surjective ι_m (D_m b) (hAff_Dm b)
    let β_b : HomogeneousLocalization.Away 𝒜_m (MvPolynomial.X b) →+* R_b b :=
      ((ι_m.appLE (D_m b) (W b) (le_refl _)).hom).comp away_b_hom
    have hβ_eq : β_b = ((ι_m.app (D_m b)).hom).comp away_b_hom := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
    have hβ_surj : Function.Surjective β_b := by
      rw [hβ_eq]; exact hι_surj.comp hAwayBij.2
    let P_m_sch : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜_m
    let U_b_raw : P_m_sch.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_m (MvPolynomial.X b)
    have h_id_sub : U_b_raw ≤
        (TopologicalSpace.Opens.map
          (CategoryTheory.Over.Hom.left (𝟙 (weilProjectiveSpaceOver K N_m))).base).obj U_b_raw :=
      fun _ hx => hx
    have hker_raw0 := hKer_m b (MvPolynomial.isHomogeneous_X K b) U_b_raw (hAff_Dm b) h_id_sub
    have hid_Pm : AlgebraicGeometry.Scheme.Hom.appLE (𝟙 P_m_sch) U_b_raw U_b_raw
        (fun _ hx => hx) = 𝟙 _ :=
      (AlgebraicGeometry.Scheme.Hom.app_eq_appLE (𝟙 P_m_sch) (U := U_b_raw)).symm.trans
        (AlgebraicGeometry.Scheme.Hom.id_app U_b_raw)
    have hid_eval_m : (AlgebraicGeometry.Scheme.Hom.appLE (𝟙 P_m_sch) U_b_raw U_b_raw
          (fun _ hx => hx)).hom
        (away_b.hom (HomogeneousLocalization.Away.mk 𝒜_m
          (MvPolynomial.isHomogeneous_X K b) 2 F_m hFm_hom)) =
        away_b.hom (HomogeneousLocalization.Away.mk 𝒜_m
          (MvPolynomial.isHomogeneous_X K b) 2 F_m hFm_hom) :=
      congrArg (fun φ => CommRingCat.Hom.hom φ _) hid_Pm
    have hker_raw : RingHom.ker (ι_m.app (D_m b)).hom =
        Ideal.span {away_b_hom (HomogeneousLocalization.Away.mk 𝒜_m
          (MvPolynomial.isHomogeneous_X K b) 2 F_m hFm_hom)} :=
      hker_raw0.trans (congrArg (fun x => Ideal.span {x}) hid_eval_m)
    let γ_b : MvPolynomial (Fin (2 * m + 1)) K →+* R_b b := β_b.comp θ_b.symm.toRingHom
    have hγ_surj : Function.Surjective γ_b := hβ_surj.comp θ_b.symm.surjective
    let ev_b : MvPolynomial (Fin (2 * m + 2)) K →+* MvPolynomial (Fin (2 * m + 1)) K :=
      MvPolynomial.eval₂Hom MvPolynomial.C (Fin.insertNth b 1 MvPolynomial.X)
    have hGen_b : θ_b.symm (ev_b F_m) =
        HomogeneousLocalization.Away.mk 𝒜_m (MvPolynomial.isHomogeneous_X K b) 2 F_m hFm_hom := by
      rw [← hθ_mk 2 F_m hFm_hom, θ_b.symm_apply_apply]
    have hγ_ker : RingHom.ker γ_b = Ideal.span {ev_b F_m} := by
      apply le_antisymm
      · intro P hP
        have hmem : away_b_hom (θ_b.symm P) ∈ RingHom.ker (ι_m.app (D_m b)).hom := by
          change (((ι_m.app (D_m b)).hom).comp away_b_hom) (θ_b.symm P) = 0
          rwa [← hβ_eq]
        rw [hker_raw, Ideal.mem_span_singleton] at hmem
        obtain ⟨s, hs⟩ := hmem
        obtain ⟨z, rfl⟩ := hAwayBij.2 s
        rw [← hGen_b, ← map_mul] at hs
        have hz_eq := hAwayBij.1 hs
        refine Ideal.mem_span_singleton.mpr ⟨θ_b z, ?_⟩
        apply θ_b.symm.injective
        rw [map_mul, θ_b.symm_apply_apply, hz_eq]
      · rw [Ideal.span_singleton_le_iff_mem]
        change β_b (θ_b.symm (ev_b F_m)) = 0
        rw [hGen_b, hβ_eq]
        change away_b_hom _ ∈ RingHom.ker (ι_m.app (D_m b)).hom
        rw [hker_raw]
        exact Ideal.subset_span rfl
    have hγ_comp : γ_b.comp ev_b = MvPolynomial.eval₂Hom (algebraMap K (R_b b)) (η b) := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext; intro c
        simp only [RingHom.comp_apply, ev_b, MvPolynomial.eval₂Hom_C]
        change (ι_m.appLE (D_m b) (W b) (le_refl _)).hom (away_b.hom (θ_b.symm (MvPolynomial.C c))) =
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
            Q_m.hom.appLE ⊤ (W b) le_top).hom c
        rw [hθ_C c]
        have happ_m : (weilProjectiveSpaceOver K N_m).hom.appLE ⊤ (D_m b) (fun _ _ => trivial) ≫
            ι_m.appLE (D_m b) (W b) (le_refl _) =
            Q_m.hom.appLE ⊤ (W b) le_top :=
          (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_m
            (weilProjectiveSpaceOver K N_m).hom ⊤ (D_m b) (W b)
            (fun _ _ => trivial) (le_refl _)).trans
            (h_appLE_eq hι_m ⊤ (W b) _ _)
        have h1 := congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ ·) happ_m
        exact congrArg (fun φ : CommRingCat.of K ⟶ _ => φ.hom c) h1
      · intro a
        simp only [RingHom.comp_apply, ev_b, MvPolynomial.eval₂Hom_X']
        by_cases hab : a = b
        · subst hab
          rw [Fin.insertNth_apply_same, map_one, hη_diag a]
        · obtain ⟨i, rfl⟩ := Fin.exists_succAbove_eq hab
          rw [Fin.insertNth_apply_succAbove]
          change (ι_m.appLE (D_m b) (W b) (le_refl _)).hom (away_b.hom (θ_b.symm (MvPolynomial.X i))) = _
          rw [hθ_X i]
    have hSurj_η : Function.Surjective (MvPolynomial.eval₂Hom (algebraMap K (R_b b)) (η b)) := by
      rw [← hγ_comp]
      intro r
      obtain ⟨P, rfl⟩ := hγ_surj r
      refine ⟨MvPolynomial.rename b.succAbove P, ?_⟩
      have h_id : ev_b.comp (MvPolynomial.rename b.succAbove).toRingHom = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext; intro c; simp [ev_b]
        · intro i; simp [ev_b, Fin.insertNth_apply_succAbove]
      have hP := congrArg (fun φ : _ →+* _ => φ P) h_id
      change γ_b ((ev_b.comp (MvPolynomial.rename b.succAbove).toRingHom) P) = γ_b P
      rw [hP]; rfl
    have hQuad_zero : MvPolynomial.aeval (fun a => Polynomial.C (η b a) * Polynomial.X) F_m = 0 := by
      have hFm_η : (MvPolynomial.eval₂Hom (algebraMap K (R_b b)) (η b)) F_m = 0 := by
        rw [← hγ_comp, RingHom.comp_apply]
        have hmem : ev_b F_m ∈ RingHom.ker γ_b := by rw [hγ_ker]; exact Ideal.subset_span rfl
        exact hmem
      dsimp only [F_m] at hFm_η ⊢
      rw [map_sum] at hFm_η ⊢
      have hterm : ∀ j : ℕ,
          (MvPolynomial.aeval (fun a => Polynomial.C (η b a) * Polynomial.X))
            (if h : 2 * j + 1 < 2 * m + 1 + 1 then
              (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ : MvPolynomial (Fin (2 * m + 2)) K) *
                MvPolynomial.X ⟨2 * j + 1, h⟩
            else 0) =
          Polynomial.C
            ((MvPolynomial.eval₂Hom (algebraMap K (R_b b)) (η b))
              (if h : 2 * j + 1 < 2 * m + 1 + 1 then
                (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ : MvPolynomial (Fin (2 * m + 2)) K) *
                  MvPolynomial.X ⟨2 * j + 1, h⟩
                else 0)) * Polynomial.X ^ 2 := by
        intro j
        split_ifs with h
        · rw [map_mul, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X,
            MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', Polynomial.C_mul]
          ring
        · rw [map_zero, map_zero, map_zero, zero_mul]
      rw [Finset.sum_congr rfl fun j _ => hterm j, ← Finset.sum_mul,
        ← map_sum Polynomial.C, hFm_η, map_zero, zero_mul]
    exact ⟨γ_b, hγ_surj, hγ_ker, hγ_comp, hSurj_η, hQuad_zero⟩

  
  obtain ⟨hFsucc_hom, _, hKer_succ⟩ := hSplit_succ.2
  obtain ⟨hX0_hom, _, hKer_Z⟩ := hSplit_Z.2
  have hChartZ : ∀ μ : Fin (2 * (m + 1) + 2),
      ∃ α_Z : MvPolynomial (Fin (2 * (m + 1) + 1)) K →+*
          ↑(Z_cone.left.presheaf.obj (Opposite.op (Z_chart μ))),
        Function.Surjective α_Z ∧
        RingHom.ker α_Z =
          Ideal.span
            {MvPolynomial.eval₂Hom MvPolynomial.C (Fin.insertNth μ 1 MvPolynomial.X)
               (MvPolynomial.X 0),
             MvPolynomial.eval₂Hom MvPolynomial.C (Fin.insertNth μ 1 MvPolynomial.X) F_succ} ∧
        α_Z.comp (MvPolynomial.eval₂Hom MvPolynomial.C (Fin.insertNth μ 1 MvPolynomial.X)) =
          MvPolynomial.eval₂Hom
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
              Z_cone.hom.appLE ⊤ (Z_chart μ) le_top).hom) (ξ μ) := by
    intro μ
    obtain ⟨θ_μ, hθ_mk, hθ_C, hθ_X⟩ := hDehom_succ μ
    let away_μ := AlgebraicGeometry.Proj.awayToSection 𝒜_succ (MvPolynomial.X μ)
    let away_μ_hom : HomogeneousLocalization.Away 𝒜_succ (MvPolynomial.X μ) →+*
        ↑((weilProjectiveSpaceOver K N_succ).left.presheaf.obj (Opposite.op (D_succ μ))) :=
      away_μ.hom
    have hAwayBij : Function.Bijective away_μ_hom := by
      have heq := (AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜_succ (MvPolynomial.X μ)
        (MvPolynomial.isHomogeneous_X K μ) zero_lt_one).symm
      change Function.Bijective away_μ.hom
      dsimp only [away_μ]
      rw [heq]
      exact (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_succ (MvPolynomial.X μ)
        (MvPolynomial.isHomogeneous_X K μ) zero_lt_one).commRingCatIsoToRingEquiv.bijective
    let Q_chart_μ : Q_succ.left.Opens := (TopologicalSpace.Opens.map ι_succ.base).obj (D_succ μ)
    have hAff_Qμ : AlgebraicGeometry.IsAffineOpen Q_chart_μ := (hAff_Dsucc μ).preimage ι_succ
    have hι_surj : Function.Surjective (ι_succ.app (D_succ μ)).hom :=
      AlgebraicGeometry.Scheme.Hom.app_surjective ι_succ (D_succ μ) (hAff_Dsucc μ)
    have hiZ_surj : Function.Surjective (i_Z.left.app Q_chart_μ).hom :=
      AlgebraicGeometry.Scheme.Hom.app_surjective i_Z.left Q_chart_μ hAff_Qμ
    let P_s_sch : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜_succ
    let U_μ_raw : P_s_sch.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_succ (MvPolynomial.X μ)
    have h_id_sub : U_μ_raw ≤
        (TopologicalSpace.Opens.map
          (CategoryTheory.Over.Hom.left (𝟙 (weilProjectiveSpaceOver K N_succ))).base).obj U_μ_raw :=
      fun _ hx => hx
    have hker_s0 := hKer_succ μ (MvPolynomial.isHomogeneous_X K μ) U_μ_raw (hAff_Dsucc μ) h_id_sub
    have hid_Ps : AlgebraicGeometry.Scheme.Hom.appLE (𝟙 P_s_sch) U_μ_raw U_μ_raw
