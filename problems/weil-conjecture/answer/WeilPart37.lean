        dsimp only [p₁, p₂]
        rw [Category.assoc, Category.assoc]
        exact (hOverlap b b').1
      have hp_pre : (TopologicalSpace.Opens.map (W b).ι.base).obj (W b').ι.opensRange =
          p₁.opensRange := by
        apply TopologicalSpace.Opens.ext
        ext w
        change (W b).ι.base w ∈ Set.range (W b').ι.base ↔ w ∈ Set.range p₁.base
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        constructor
        · intro hwb'
          have hz_mem : (W b).ι.base w ∈ (W b : Set P_sch) ∩ (W b' : Set P_sch) :=
            ⟨w.2, hwb'⟩
          rw [← (hOverlap b b').2] at hz_mem
          rcases hz_mem with ⟨q, hq⟩
          have hq' : (p₁ ≫ (W b).ι).base q = (W b).ι.base w := hq
          exact ⟨q, (W b).ι.isOpenEmbedding.injective hq'⟩
        · rintro ⟨q, rfl⟩
          have hmem : (p₁ ≫ (W b).ι).base q ∈ (W b : Set P_sch) ∩ (W b' : Set P_sch) := by
            rw [← (hOverlap b b').2]
            exact ⟨q, rfl⟩
          exact hmem.2
      have hpb_ov : IsPullback p₁ p₂ (W b).ι (W b').ι :=
        (AlgebraicGeometry.IsOpenImmersion.isPullback p₂ p₁ (W b').ι (W b).ι hp_comm hp_pre).flip
      let e_pb := IsPullback.isoIsPullback (W b).toScheme (W b').toScheme hpb_ov
        (IsPullback.of_hasPullback (W b).ι (W b').ι)
      rw [← cancel_epi e_pb.hom, ← Category.assoc e_pb.hom, ← Category.assoc e_pb.hom]
      dsimp only [e_pb]
      rw [IsPullback.isoIsPullback_hom_fst, IsPullback.isoIsPullback_hom_snd]
      obtain ⟨θ_ov_fn, hθ_ov1, hθ_ov2⟩ := hθ_ov b b'
      have h_lhs : p₁ ≫ Ψ_chart b =
          Spec.map (CommRingCat.ofHom θ_ov_fn) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_K (MvPolynomial.X b * MvPolynomial.X b')
