theorem weil_odp_modif_prime_pow_pbc_point_pullback (k : Type u) [Field k] [IsAlgClosed k]
    (q₀ ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (Y_tilde Y E : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Y.hom]
    (π : Y_tilde ⟶ Y)
    [AlgebraicGeometry.IsProper π.left]
    (y₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Y.left)
    (hy₀ : y₀ ≫ Y.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (i_E : E.left ⟶ Y_tilde.left)
    (hPb_E : CategoryTheory.IsPullback i_E E.hom π.left y₀) :
    WeilIsEtaleSheafPullback y₀
      (weilEtaleHigherDirectImage π.left q₀ (weilEtaleTorsionSheaf Y_tilde.left (ℓ ^ (r + 1))))
      (weilEtaleHigherDirectImage E.hom q₀ (weilEtaleTorsionSheaf E.left (ℓ ^ (r + 1)))) :=
by
  classical
