  let U_sm : (CategoryTheory.Limits.pullback f_bar.left s_bar).Opens :=
    (TopologicalSpace.Opens.map e_Zs.inv.base).obj U_Y
  have hDisj_Usm : ∀ y ∈ U_sm,
      (CategoryTheory.Limits.pullback.fst f_bar.left s_bar).base y ∉ Set.range x_bar.base := by
    intro y hy hmem
