            · intro hnot; exact absurd hd₀ hnot
          rw [hsum_eq] at hcoeff0
          exact (MvPolynomial.mem_support_iff.mp hd₀) hcoeff0
        rw [MvPolynomial.as_sum (p := P)]
        refine Ideal.sum_mem J_E fun d hd => ?_
        have hd0 : 1 ≤ d (0, 0) := Nat.pos_of_ne_zero (hPure1 d hd)
        have hd1 : 1 ≤ d (0, 1) := Nat.pos_of_ne_zero (hPure0 d hd)
