                φ_cat := by
        have h1 := congrArg
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom ≫ ·) hMorEq
        rwa [CategoryTheory.Iso.hom_inv_id_assoc] at h1
      have hSmC : RingHom.IsStandardSmoothOfRelativeDimension d
          (MvPolynomial.C : K →+* MvPolynomial (Fin d) K) := by
        unfold RingHom.IsStandardSmoothOfRelativeDimension
        have halg : (MvPolynomial.C : K →+* MvPolynomial (Fin d) K).toAlgebra =
