      hCanonUnit_eq_mate j_X hT_XU hT_X
    rw [hη_M_eq]

    have hChartAffineBij : ∀ (W_et : X.Etale) [IsAffine W_et.left]
        (V : X.Opens) (φ : V.toScheme ⟶ Y) (hEt_φ : Etale φ)
        (V_U : Scheme.{u}) (ι_VU : V_U ⟶ X_U) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ U)
        (_hPb1 : IsPullback ι_VU j_V j_X V.ι) (_hPb2 : IsPullback φ_U j_V j_Y φ)
        (v_V : W_et.left ⟶ V.toScheme)
        (_hv_fac : v_V ≫ V.ι = W_et.hom),
        Function.Bijective ((η_M.hom.app (Opposite.op W_et)).hom) := by
      intro W_et _ V φ hEt_φ V_U ι_VU j_V φ_U hPb1 hPb2 v_V hv_fac
      let W : Scheme.{u} := W_et.left
      let w_X : W ⟶ X := W_et.hom
      have hw_X_et : Etale w_X := W_et.prop
      have hV_et : Etale V.ι := inferInstance
      have hv_et : Etale v_V :=
        MorphismProperty.of_postcomp P_et v_V V.ι hV_et (hv_fac.symm ▸ hw_X_et)
      let _ : Etale v_V := hv_et
      let _ : Etale φ := hEt_φ
      let w_Y : W ⟶ Y := v_V ≫ φ
      have hw_Y_et : Etale w_Y := inferInstance
      let _ : Etale w_Y := hw_Y_et
      let P_Y := Limits.pullback j_Y w_Y
      let h_W : P_Y ⟶ W := Limits.pullback.snd j_Y w_Y
      let _ := hCont_pull h_W
      obtain ⟨ψ₀, hψ₀, hConj_hW⟩ := hDeg0PullbackAndConj h_W
      have hBij_hW : Function.Bijective (((canonUnit h_W).hom.app (Opposite.op (T_id W))).hom) :=
        hConj_hW (hBij0_Y W w_Y ψ₀ hψ₀)
      let pb0 : IsPullback (Limits.pullback.fst j_V v_V) (Limits.pullback.snd j_V v_V) j_V v_V :=
        IsPullback.of_hasPullback j_V v_V
      have hPb_WY : IsPullback (Limits.pullback.fst j_V v_V ≫ φ_U)
          (Limits.pullback.snd j_V v_V) j_Y w_Y :=
        pb0.paste_horiz hPb2
      have hPb_WX₀ : IsPullback (Limits.pullback.snd j_V v_V)
          (Limits.pullback.fst j_V v_V ≫ ι_VU) (v_V ≫ V.ι) j_X :=
        (pb0.paste_horiz hPb1).flip
      have hPb_WX : IsPullback (Limits.pullback.snd j_V v_V)
          (Limits.pullback.fst j_V v_V ≫ ι_VU) w_X j_X := by
        rwa [hv_fac] at hPb_WX₀
      let e_WY : Limits.pullback j_V v_V ≅ P_Y := hPb_WY.isoPullback
      let u_PY : P_Y ⟶ X_U := e_WY.inv ≫ Limits.pullback.fst j_V v_V ≫ ι_VU
      have hι_VU_et : Etale ι_VU :=
        MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb1.flip hV_et
      let _ : Etale ι_VU := hι_VU_et
      have hu_PY_et : Etale u_PY := by dsimp [u_PY]; infer_instance
      have hPb_W : IsPullback h_W u_PY w_X j_X := by
        refine IsPullback.of_iso hPb_WX e_WY (Iso.refl W) (Iso.refl X_U) (Iso.refl X)
          ?_ ?_ (Category.id_comp w_X).symm (Category.id_comp j_X).symm
        · dsimp [h_W, e_WY]
          rw [Category.comp_id]
          exact hPb_WY.isoPullback_hom_snd.symm
        · dsimp [u_PY]
          rw [Category.comp_id, e_WY.hom_inv_id_assoc]
      let M_wX : Functor W.Etale X.Etale := MorphismProperty.Over.map (P := P_et) ⊤ hw_X_et
      let M_uPY : Functor P_Y.Etale X_U.Etale := MorphismProperty.Over.map (P := P_et) ⊤ hu_PY_et
      let shPull_wX : Functor (Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
          (Sheaf W.smallEtaleTopology AddCommGrpCat.{u}) :=
        @Functor.sheafPushforwardContinuous _ _ _ _ M_wX AddCommGrpCat.{u} _
          W.smallEtaleTopology X.smallEtaleTopology (hCont_map hw_X_et)
      let shPull_uPY : Functor (Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u})
          (Sheaf P_Y.smallEtaleTopology AddCommGrpCat.{u}) :=
        @Functor.sheafPushforwardContinuous _ _ _ _ M_uPY AddCommGrpCat.{u} _
          P_Y.smallEtaleTopology X_U.smallEtaleTopology (hCont_map hu_PY_et)
      let B_hW := weilEtaleSitePullback h_W
      let pf_hW := B_hW.sheafPushforwardContinuous AddCommGrpCat.{u}
        W.smallEtaleTopology P_Y.smallEtaleTopology
      obtain ⟨δ_wX₀, hδ_wX₀⟩ := hSliceConstIso hw_X_et
      let δ_wX : weilEtaleTorsionSheaf W ℓ ≅ shPull_wX.obj (weilEtaleTorsionSheaf X ℓ) := δ_wX₀
      have hδ_wX : η_sh W ≫ δ_wX.hom.hom = Functor.whiskerLeft M_wX.op (η_sh X) := hδ_wX₀
      obtain ⟨δ_uPY₀, hδ_uPY₀⟩ := hSliceConstIso hu_PY_et
      let δ_uPY : weilEtaleTorsionSheaf P_Y ℓ ≅ shPull_uPY.obj (weilEtaleTorsionSheaf X_U ℓ) := δ_uPY₀
      have hδ_uPY : η_sh P_Y ≫ δ_uPY.hom.hom = Functor.whiskerLeft M_uPY.op (η_sh X_U) := hδ_uPY₀
      let pbPaste : ∀ E' : W.Etale,
