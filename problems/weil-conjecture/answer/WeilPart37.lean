        have hb := AlgebraicGeometry.Scheme.Hom.map_appLE f_X hW_prod
          (CategoryTheory.homOfLE (by rw [hD_prod]; exact inf_le_left :
            AlgebraicGeometry.Proj.basicOpen 𝒜 x_prod ≤ D μ)).op
        have hc : (CommRingCat.ofHom m₁ ≫ AlgebraicGeometry.Proj.awayToSection 𝒜 x_prod) ≫
