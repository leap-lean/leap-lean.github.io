          { homEquiv := fun _ _ => CategoryTheory.Presheaf.freeYonedaHomEquiv
            homEquiv_naturality_left_symm := fun {_ _ _} _ _ => by
              apply CategoryTheory.Presheaf.freeYonedaHomEquiv.injective
              rw [Equiv.apply_symm_apply, CategoryTheory.Presheaf.freeYonedaHomEquiv_comp]
              dsimp [F_pre]
              rw [Equiv.apply_symm_apply, CategoryTheory.Category.assoc,
