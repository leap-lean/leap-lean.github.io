      obtain ⟨pt, hpt⟩ : x ∈ Set.range hAffU.fromSpec.base := by
        rwa [hAffU.range_fromSpec]
      have hxC : x ∈ (⨆ μ : Fin (M₀ + 1), C_open μ) := by
        rw [hC_cov]
        trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hxC
      obtain ⟨μ₀, hxμ₀⟩ := hxC
      let W_pt : (AlgebraicGeometry.Spec (X₀.presheaf.obj (Opposite.op U.1))).Opens :=
        (TopologicalSpace.Opens.map hAffU.fromSpec.base).obj (C_open μ₀)
      have hpt_W : pt ∈ W_pt := by
        change hAffU.fromSpec.base pt ∈ C_open μ₀
        rwa [hpt]
      obtain ⟨B, ⟨g₀, rfl⟩, hpt_B, hB_sub⟩ :=
        TopologicalSpace.IsTopologicalBasis.exists_subset_of_mem_open
          PrimeSpectrum.isTopologicalBasis_basic_opens hpt_W W_pt.isOpen
      refine ⟨μ₀, g₀, ?_, ?_⟩
      · have hpre := hAffU.fromSpec_preimage_basicOpen g₀
        have hpt_pre : pt ∈ (TopologicalSpace.Opens.map hAffU.fromSpec.base).obj (X₀.basicOpen g₀) := by
          rw [hpre]
          exact hpt_B
        change hAffU.fromSpec.base pt ∈ X₀.basicOpen g₀ at hpt_pre
        rwa [hpt] at hpt_pre
      · intro y hy
        obtain ⟨q, rfl⟩ : y ∈ Set.range hAffU.fromSpec.base := by
          rw [hAffU.range_fromSpec]
          exact X₀.basicOpen_le g₀ hy
        have hq : q ∈ PrimeSpectrum.basicOpen g₀ := by
          rw [← hAffU.fromSpec_preimage_basicOpen g₀]
          exact hy
        exact hB_sub hq

    have hex_fin_cov : ∀ (U : X₀.affineOpens),
        ∃ (T : Finset ↑(X₀.presheaf.obj (Opposite.op U.1))),
          (∀ g ∈ T, ∃ μ : Fin (M₀ + 1), X₀.basicOpen g ≤ C_open μ) ∧
          Ideal.span (↑T : Set ↑(X₀.presheaf.obj (Opposite.op U.1))) = ⊤ := by
      intro U
      have hAffU : AlgebraicGeometry.IsAffineOpen U.1 := U.2
      let R_U : Type u := ↑(X₀.presheaf.obj (Opposite.op U.1))
      let S_good : Set R_U := {g : R_U | ∃ μ : Fin (M₀ + 1), X₀.basicOpen g ≤ C_open μ}
      have hspan_top : Ideal.span S_good = ⊤ := by
        by_contra hne
        obtain ⟨𝔪, h𝔪_max, hle_𝔪⟩ := Ideal.exists_le_maximal (Ideal.span S_good) hne
        haveI : 𝔪.IsPrime := h𝔪_max.isPrime
        let pt : AlgebraicGeometry.Spec (X₀.presheaf.obj (Opposite.op U.1)) := ⟨𝔪, inferInstance⟩
        have hxU : hAffU.fromSpec.base pt ∈ U.1 := by
          have hmem : hAffU.fromSpec.base pt ∈ Set.range hAffU.fromSpec.base := ⟨pt, rfl⟩
          rwa [hAffU.range_fromSpec] at hmem
        obtain ⟨μ₀, g₀, hxg₀, hg₀_le⟩ := hex_local_basic U (hAffU.fromSpec.base pt) hxU
        have hg₀_mem : g₀ ∈ Ideal.span S_good := Ideal.subset_span ⟨μ₀, hg₀_le⟩
        have hg₀_in_𝔪 : g₀ ∈ 𝔪 := hle_𝔪 hg₀_mem
        have hpt_bo : pt ∈ PrimeSpectrum.basicOpen g₀ := by
          rw [← hAffU.fromSpec_preimage_basicOpen g₀]
          exact hxg₀
        exact hpt_bo hg₀_in_𝔪
      have h1_mem : (1 : R_U) ∈ Ideal.span S_good := by
        rw [hspan_top]
        trivial
      rw [Submodule.mem_span_iff_exists_finset_subset] at h1_mem
      obtain ⟨_, T, hT_sub, _, hsum⟩ := h1_mem
      refine ⟨T, fun g hg => hT_sub hg, ?_⟩
      rw [Ideal.eq_top_iff_one, ← hsum]
      exact Submodule.sum_mem _ fun g hg => Submodule.smul_mem _ _ (Ideal.subset_span hg)

    have hmap_basicOpen : ∀ (U : X₀.affineOpens) (f : ↑(X₀.presheaf.obj (Opposite.op U.1))),
        Ideal.map (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le f)).op).hom (ideal_fn U) =
          ideal_fn (X₀.affineBasicOpen f) := by
      intro U f
      have hAffU : AlgebraicGeometry.IsAffineOpen U.1 := U.2
      let V_f : X₀.affineOpens := X₀.affineBasicOpen f
      let R_U : Type u := ↑(X₀.presheaf.obj (Opposite.op U.1))
      let R_f : Type u := ↑(X₀.presheaf.obj (Opposite.op V_f.1))
      have hVf_le : V_f.1 ≤ U.1 := X₀.basicOpen_le f
      let res_f : R_U →+* R_f :=
        (X₀.presheaf.map (CategoryTheory.homOfLE hVf_le).op).hom
      have hloc_f : letI : Algebra R_U R_f := res_f.toAlgebra; IsLocalization.Away f R_f :=
        hAffU.isLocalization_basicOpen f
      let J_Vf : Ideal R_f := ideal_fn V_f
      change Ideal.map res_f (ideal_fn U) = J_Vf
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro a ha
        rw [Ideal.mem_comap]
        dsimp only [J_Vf, ideal_fn]
        refine Ideal.mem_iInf.mpr fun μ => Ideal.mem_iInf.mpr fun h => Ideal.mem_iInf.mpr fun hh => ?_
        rw [Ideal.mem_comap]
        obtain ⟨g₀, k, hk_eq⟩ : ∃ (g₀ : R_U) (k : ℕ), h * res_f (f ^ k) = res_f g₀ := by
          letI : Algebra R_U R_f := res_f.toAlgebra
          haveI : IsLocalization.Away f R_f := hloc_f
          obtain ⟨⟨g₀, ⟨_, k, rfl⟩⟩, hk_eq⟩ := IsLocalization.surj (Submonoid.powers f) h
          exact ⟨g₀, k, hk_eq⟩
        let g₁ : R_U := f * g₀
        have hg₁_res : res_f g₁ = h * res_f (f ^ (k + 1)) := by
          dsimp only [g₁]
          rw [map_mul, ← hk_eq, pow_succ', map_mul]
          ring
        have hbo_eq : X₀.basicOpen g₁ = X₀.basicOpen h := by
          have hbo_g1_le : X₀.basicOpen g₁ ≤ V_f.1 := by
            change X₀.basicOpen g₁ ≤ X₀.basicOpen f
            dsimp only [g₁]
            rw [hBasicOpenMul]
            exact inf_le_left
          have hbo_res : X₀.basicOpen (res_f g₁) = X₀.basicOpen g₁ := by
            dsimp only [res_f]
            rw [hBasicOpenRes]
            exact inf_eq_right.mpr hbo_g1_le
          rw [← hbo_res, hg₁_res, hBasicOpenMul]
          have hpow_bo : X₀.basicOpen (res_f (f ^ (k + 1))) = V_f.1 := by
            dsimp only [res_f]
            rw [hBasicOpenRes, hBasicOpenPow _ _ _ (Nat.succ_pos k)]
            exact inf_idem _
          rw [hpow_bo]
          exact inf_eq_left.mpr (X₀.basicOpen_le h)
        have hg₁_C : X₀.basicOpen g₁ ≤ C_open μ := by
          rw [hbo_eq]
          exact hh
        have ha_g₁ : (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g₁)).op).hom a ∈
            J_id μ (X₀.basicOpen g₁) hg₁_C := by
          have hle : ideal_fn U ≤
              Ideal.comap (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g₁)).op).hom
                (J_id μ (X₀.basicOpen g₁) hg₁_C) :=
            iInf_le_of_le μ (iInf_le_of_le g₁ (iInf_le _ hg₁_C))
          exact Ideal.mem_comap.mp (hle ha)
        have hmap := Ideal.mem_map_of_mem
          (X₀.presheaf.map (CategoryTheory.homOfLE (le_of_eq hbo_eq.symm)).op).hom ha_g₁
        rw [hJ_res μ hg₁_C (le_of_eq hbo_eq.symm), hPresheafComp] at hmap
        dsimp only [res_f]
        rwa [hPresheafComp]
      · intro b hb
        obtain ⟨a₀, n₀, hn₀_eq, hu_fn₀⟩ :
            ∃ (a₀ : R_U) (n₀ : ℕ), b * res_f (f ^ n₀) = res_f a₀ ∧ IsUnit (res_f (f ^ n₀)) := by
          letI : Algebra R_U R_f := res_f.toAlgebra
          haveI : IsLocalization.Away f R_f := hloc_f
          obtain ⟨⟨a₀, ⟨_, n₀, rfl⟩⟩, hn₀_eq⟩ := IsLocalization.surj (Submonoid.powers f) b
          exact ⟨a₀, n₀, hn₀_eq, by
            change IsUnit (algebraMap R_U R_f (f ^ n₀))
            rw [map_pow]
            exact (IsLocalization.Away.algebraMap_isUnit f).pow n₀⟩
        obtain ⟨u₀, hu₀⟩ := hu_fn₀
        suffices ha₀_mem : res_f a₀ ∈ Ideal.map res_f (ideal_fn U) by
          have hb_eq : b = ↑u₀⁻¹ * res_f a₀ := by
            rw [← hn₀_eq, ← hu₀, mul_comm b, Units.inv_mul_cancel_left]
          rw [hb_eq]
          exact Ideal.mul_mem_left _ _ ha₀_mem
        rw [hLocMemMap res_f f hloc_f (ideal_fn U) a₀]
        obtain ⟨T, hT_chart, hT_span⟩ := hex_fin_cov U
        let μ_fn : ↥T → Fin (M₀ + 1) := fun g => Classical.choose (hT_chart g.1 g.2)
        have hμ_fn : ∀ g : ↥T, X₀.basicOpen g.1 ≤ C_open (μ_fn g) :=
          fun g => Classical.choose_spec (hT_chart g.1 g.2)
        have hex_k : ∀ g : ↥T, ∃ k : ℕ,
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g.1)).op).hom (f ^ k * a₀) ∈
              J_id (μ_fn g) (X₀.basicOpen g.1) (hμ_fn g) := by
          intro g
          have hAff_g : AlgebraicGeometry.IsAffineOpen (X₀.basicOpen g.1) :=
            (X₀.affineBasicOpen g.1).2
          let R_g : Type u := ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen g.1)))
          let res_g : R_U →+* R_g :=
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g.1)).op).hom
          let f_on_g : R_g := res_g f
          let R_gf : Type u := ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen f_on_g)))
          let res_gf : R_g →+* R_gf :=
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le f_on_g)).op).hom
          have hloc_gf : letI : Algebra R_g R_gf := res_gf.toAlgebra; IsLocalization.Away f_on_g R_gf :=
            hAff_g.isLocalization_basicOpen f_on_g
          let g_on_f : R_f := res_f g.1
          have hbo_gf : X₀.basicOpen g_on_f = X₀.basicOpen f_on_g := by
            dsimp only [g_on_f, f_on_g, res_f, res_g]
            rw [hBasicOpenRes, hBasicOpenRes, inf_comm]
            rfl
          have hg_on_f_C : X₀.basicOpen g_on_f ≤ C_open (μ_fn g) := by
            dsimp only [g_on_f, res_f]
            rw [hBasicOpenRes]
            exact inf_le_right.trans (hμ_fn g)
          have ha₀_Vf : res_f a₀ ∈ J_Vf := by
            rw [← hn₀_eq]
            exact Ideal.mul_mem_right _ _ hb
          have ha₀_gf : (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g_on_f)).op).hom
              (res_f a₀) ∈ J_id (μ_fn g) (X₀.basicOpen g_on_f) hg_on_f_C := by
            have hle : J_Vf ≤
                Ideal.comap (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g_on_f)).op).hom
                  (J_id (μ_fn g) (X₀.basicOpen g_on_f) hg_on_f_C) :=
              iInf_le_of_le (μ_fn g) (iInf_le_of_le g_on_f (iInf_le _ hg_on_f_C))
            exact Ideal.mem_comap.mp (hle ha₀_Vf)
          have hmap_gf := Ideal.mem_map_of_mem
            (X₀.presheaf.map (CategoryTheory.homOfLE (le_of_eq hbo_gf.symm)).op).hom ha₀_gf
          rw [hJ_res (μ_fn g) hg_on_f_C (le_of_eq hbo_gf.symm)] at hmap_gf
          have hcomp_gf : (X₀.presheaf.map (CategoryTheory.homOfLE (le_of_eq hbo_gf.symm)).op).hom
              ((X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g_on_f)).op).hom (res_f a₀)) =
              res_gf (res_g a₀) := by
            dsimp only [res_f, res_g, res_gf]
            rw [hPresheafComp, hPresheafComp, hPresheafComp]
          rw [hcomp_gf, ← hJ_res (μ_fn g) (hμ_fn g) (X₀.basicOpen_le f_on_g)] at hmap_gf
          obtain ⟨k, hk⟩ := (hLocMemMap res_gf f_on_g hloc_gf _ (res_g a₀)).mp hmap_gf
          refine ⟨k, ?_⟩
          change res_g (f ^ k * a₀) ∈ _
          rwa [map_mul, map_pow]
        let k_fn : ↥T → ℕ := fun g => Classical.choose (hex_k g)
        have hk_fn : ∀ g : ↥T,
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g.1)).op).hom
              (f ^ (k_fn g) * a₀) ∈ J_id (μ_fn g) (X₀.basicOpen g.1) (hμ_fn g) :=
          fun g => Classical.choose_spec (hex_k g)
        let m₀ : ℕ := T.attach.sup k_fn
        let x₀ : R_U := f ^ m₀ * a₀
        have hx₀_T : ∀ g : ↥T,
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g.1)).op).hom x₀ ∈
              J_id (μ_fn g) (X₀.basicOpen g.1) (hμ_fn g) := by
          intro g
          have hle_m : k_fn g ≤ m₀ := Finset.le_sup (Finset.mem_attach T g)
          have hx₀_split : x₀ = f ^ (m₀ - k_fn g) * (f ^ (k_fn g) * a₀) := by
            dsimp only [x₀]
            rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hle_m]
          rw [hx₀_split, map_mul]
          exact Ideal.mul_mem_left _ _ (hk_fn g)
        refine ⟨m₀, Ideal.mem_iInf.mpr fun μ' => Ideal.mem_iInf.mpr fun h =>
          Ideal.mem_iInf.mpr fun hh => ?_⟩
        rw [Ideal.mem_comap]
        have hAff_h : AlgebraicGeometry.IsAffineOpen (X₀.basicOpen h) :=
          (X₀.affineBasicOpen h).2
        let R_h : Type u := ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen h)))
        let res_h : R_U →+* R_h :=
          (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le h)).op).hom
        have hex_r : ∀ g : ↥T, ∃ r : ℕ,
            res_h (g.1 ^ r) * res_h x₀ ∈ J_id μ' (X₀.basicOpen h) hh := by
          intro g
          let g_on_h : R_h := res_h g.1
          let R_hg : Type u := ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen g_on_h)))
          let res_hg : R_h →+* R_hg :=
            (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g_on_h)).op).hom
          have hloc_hg : letI : Algebra R_h R_hg := res_hg.toAlgebra; IsLocalization.Away g_on_h R_hg :=
            hAff_h.isLocalization_basicOpen g_on_h
          have hbo_le_g : X₀.basicOpen g_on_h ≤ X₀.basicOpen g.1 := by
            dsimp only [g_on_h, res_h]
            rw [hBasicOpenRes]
            exact inf_le_right
          have hmap_hg := Ideal.mem_map_of_mem
            (X₀.presheaf.map (CategoryTheory.homOfLE hbo_le_g).op).hom (hx₀_T g)
          rw [hJ_res (μ_fn g) (hμ_fn g) hbo_le_g,
            hJ_overlap (μ_fn g) μ' (hbo_le_g.trans (hμ_fn g))
              ((X₀.basicOpen_le g_on_h).trans hh),
            ← hJ_res μ' hh (X₀.basicOpen_le g_on_h)] at hmap_hg
          have hcomp_hg : (X₀.presheaf.map (CategoryTheory.homOfLE hbo_le_g).op).hom
              ((X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g.1)).op).hom x₀) =
              res_hg (res_h x₀) := by
            dsimp only [res_h, res_hg]
            rw [hPresheafComp, hPresheafComp]
          rw [hcomp_hg] at hmap_hg
          obtain ⟨r, hr⟩ := (hLocMemMap res_hg g_on_h hloc_hg _ (res_h x₀)).mp hmap_hg
          refine ⟨r, ?_⟩
          rwa [map_pow]
        let r_fn : ↥T → ℕ := fun g => Classical.choose (hex_r g)
        have hr_fn : ∀ g : ↥T, res_h (g.1 ^ (r_fn g)) * res_h x₀ ∈ J_id μ' (X₀.basicOpen h) hh :=
          fun g => Classical.choose_spec (hex_r g)
        let R_max : ℕ := T.attach.sup r_fn
        let I_ann : Ideal R_U :=
          Ideal.comap res_h (Submodule.comap (LinearMap.mulRight R_h (res_h x₀))
            (J_id μ' (X₀.basicOpen h) hh))
        have hpow_top : Ideal.span ((fun z : R_U => z ^ R_max) '' (↑T : Set R_U)) = ⊤ :=
          Ideal.span_pow_eq_top (↑T : Set R_U) hT_span R_max
        have htop_le : (⊤ : Ideal R_U) ≤ I_ann := by
          rw [← hpow_top, Ideal.span_le]
          rintro _ ⟨g, hgT, rfl⟩
          change res_h (g ^ R_max) * res_h x₀ ∈ J_id μ' (X₀.basicOpen h) hh
          have hle_R : r_fn ⟨g, hgT⟩ ≤ R_max := Finset.le_sup (Finset.mem_attach T ⟨g, hgT⟩)
          have hpow_split : g ^ R_max = g ^ (R_max - r_fn ⟨g, hgT⟩) * g ^ (r_fn ⟨g, hgT⟩) := by
            rw [← pow_add, Nat.sub_add_cancel hle_R]
          rw [hpow_split, map_mul, mul_assoc]
          exact Ideal.mul_mem_left _ _ (hr_fn ⟨g, hgT⟩)
        have h1_ann : (1 : R_U) ∈ I_ann := htop_le trivial
        change res_h 1 * res_h x₀ ∈ J_id μ' (X₀.basicOpen h) hh at h1_ann
        rwa [map_one, one_mul] at h1_ann

    let supportSet : Set X₀ :=
      (((TopologicalSpace.Opens.map f_X.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜 F) : Set X₀)ᶜ)
    have hsupport_iff : ∀ (U : X₀.affineOpens), ∀ x ∈ (U : X₀.Opens),
        x ∈ supportSet ↔ x ∈ X₀.zeroLocus (ideal_fn U : Set ↑(X₀.presheaf.obj (Opposite.op U.1))) := by
      intro U x hxU
      have hAffU : AlgebraicGeometry.IsAffineOpen U.1 := U.2
      obtain ⟨μ₀, g₀, hxg₀, hg₀_C⟩ := hex_local_basic U x hxU
      let R_U : Type u := ↑(X₀.presheaf.obj (Opposite.op U.1))
      let V_g₀ := X₀.affineBasicOpen g₀
      let R_g₀ : Type u := ↑(X₀.presheaf.obj (Opposite.op (X₀.basicOpen g₀)))
      let res_g₀ : R_U →+* R_g₀ :=
        (X₀.presheaf.map (CategoryTheory.homOfLE (X₀.basicOpen_le g₀)).op).hom
      have hloc_g₀ : letI : Algebra R_U R_g₀ := res_g₀.toAlgebra; IsLocalization.Away g₀ R_g₀ :=
        hAffU.isLocalization_basicOpen g₀
      let ℓ₀ : R_g₀ := ℓ_sec μ₀ (X₀.basicOpen g₀) hg₀_C
      have hmap_span : Ideal.map res_g₀ (ideal_fn U) = Ideal.span {ℓ₀} :=
        (hmap_basicOpen U g₀).trans (hideal_on_chart V_g₀ μ₀ hg₀_C)
      rw [AlgebraicGeometry.Scheme.mem_zeroLocus_iff]
      have hzero_iff : (∀ s ∈ (ideal_fn U : Set R_U), x ∉ X₀.basicOpen s) ↔ x ∉ X₀.basicOpen ℓ₀ := by
        constructor
        · intro hall hx_ℓ₀
          have hℓ₀_mem : ℓ₀ ∈ Ideal.map res_g₀ (ideal_fn U) := by
            rw [hmap_span]
            exact Ideal.subset_span rfl
          have hsurj_ℓ₀ : ∃ (a : R_U) (k : ℕ), a ∈ ideal_fn U ∧ ℓ₀ * res_g₀ (g₀ ^ k) = res_g₀ a := by
            letI : Algebra R_U R_g₀ := res_g₀.toAlgebra
            haveI : IsLocalization.Away g₀ R_g₀ := hloc_g₀
            have hmem' : ℓ₀ ∈ Ideal.map (algebraMap R_U R_g₀) (ideal_fn U) := hℓ₀_mem
            rw [IsLocalization.mem_map_algebraMap_iff (Submonoid.powers g₀) R_g₀] at hmem'
            obtain ⟨⟨⟨a, ha⟩, ⟨_, k, rfl⟩⟩, hka⟩ := hmem'
            exact ⟨a, k, ha, hka⟩
          obtain ⟨a, k, ha_mem, hka⟩ := hsurj_ℓ₀
          have hx_gk : x ∈ X₀.basicOpen (res_g₀ (g₀ ^ k)) := by
            rcases Nat.eq_zero_or_pos k with rfl | hk_pos
            · rw [pow_zero, map_one, AlgebraicGeometry.Scheme.basicOpen_of_isUnit X₀ isUnit_one]
              exact hxg₀
            · dsimp only [res_g₀]
              rw [hBasicOpenRes, hBasicOpenPow _ _ _ hk_pos, inf_idem]
              exact hxg₀
          have hx_prod : x ∈ X₀.basicOpen (ℓ₀ * res_g₀ (g₀ ^ k)) := by
            rw [hBasicOpenMul]
            exact ⟨hx_ℓ₀, hx_gk⟩
          rw [hka] at hx_prod
          dsimp only [res_g₀] at hx_prod
          rw [hBasicOpenRes] at hx_prod
          exact hall a ha_mem hx_prod.2
        · intro hx_not_ℓ₀ s hs hx_s
          have hres_s : res_g₀ s ∈ Ideal.span {ℓ₀} := by
            rw [← hmap_span]
