            CategoryTheory.Presheaf.freeYonedaHomEquiv.symm
              (c ≫ CategoryTheory.Presheaf.freeYonedaHomEquiv
                (𝟙 (CategoryTheory.Presheaf.freeYoneda U_et M₂)))
          map_id := fun _ => by
            rw [CategoryTheory.Category.id_comp, Equiv.symm_apply_apply]
          map_comp := fun {_ _ _} c₁ c₂ => by
            apply CategoryTheory.Presheaf.freeYonedaHomEquiv.injective
            rw [Equiv.apply_symm_apply, CategoryTheory.Presheaf.freeYonedaHomEquiv_comp,
