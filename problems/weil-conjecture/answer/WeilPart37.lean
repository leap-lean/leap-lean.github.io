      {X₂ G₂ F₂ : C} {X₁ G₁ F₁ : D} (n : ℕ)
      (icℤ : X₁ ⟶ F.obj X₂)
      (c₂ : G₂ ⟶ F₂) (c_h : F.obj F₂ ⟶ F₁)
      (β : F.obj G₂ ⟶ G₁) (c₁ : G₁ ⟶ F₁)
      (_h_coc : β ≫ c₁ = F.map c₂ ≫ c_h)
      (x₂ : CategoryTheory.Abelian.Ext.{u} X₂ G₂ n),
      (CategoryTheory.Abelian.Ext.mk₀.{u} c_h).postcomp X₁ (Nat.add_zero n)
        ((CategoryTheory.Abelian.Ext.mk₀.{u} icℤ).comp
          (F.mapExtAddHom X₂ F₂ n
            (((CategoryTheory.Abelian.Ext.mk₀.{u} c₂).postcomp X₂ (Nat.add_zero n)) x₂))
          (Nat.zero_add n)) =
      ((CategoryTheory.Abelian.Ext.mk₀.{u} c₁).postcomp X₁ (Nat.add_zero n))
        ((((CategoryTheory.Abelian.Ext.mk₀.{u} β).postcomp X₁ (Nat.add_zero n)).comp
          (((CategoryTheory.Abelian.Ext.mk₀.{u} icℤ).precomp (F.obj G₂) (Nat.zero_add n)).comp
            (F.mapExtAddHom X₂ G₂ n))) x₂) := by
    intro C D _ _ _ _ _ _ F _ _ _ X₂ G₂ F₂ X₁ G₁ F₁ n icℤ c₂ c_h β c₁ h_coc x₂
    let w : CategoryTheory.Abelian.Ext.{u} (F.obj X₂) (F.obj G₂) n :=
      F.mapExtAddHom X₂ G₂ n x₂
    have hMap : F.mapExtAddHom X₂ F₂ n (x₂.comp (CategoryTheory.Abelian.Ext.mk₀.{u} c₂) (Nat.add_zero n)) =
        w.comp (CategoryTheory.Abelian.Ext.mk₀.{u} (F.map c₂)) (Nat.add_zero n) :=
      (CategoryTheory.Functor.mapExtAddHom_apply F X₂ F₂ n _).trans
        ((CategoryTheory.Abelian.Ext.mapExactFunctor_comp F
          x₂ (CategoryTheory.Abelian.Ext.mk₀.{u} c₂) (Nat.add_zero n)).trans
          (congrArg₂
            (fun (a : CategoryTheory.Abelian.Ext.{u} (F.obj X₂) (F.obj G₂) n)
                 (b : CategoryTheory.Abelian.Ext.{u} (F.obj G₂) (F.obj F₂) 0) =>
              a.comp b (Nat.add_zero n))
            (CategoryTheory.Functor.mapExtAddHom_apply F X₂ G₂ n x₂).symm
            (CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ F c₂)))
    change ((CategoryTheory.Abelian.Ext.mk₀.{u} icℤ).comp
        (F.mapExtAddHom X₂ F₂ n (x₂.comp (CategoryTheory.Abelian.Ext.mk₀.{u} c₂) (Nat.add_zero n)))
        (Nat.zero_add n)).comp
        (CategoryTheory.Abelian.Ext.mk₀.{u} c_h) (Nat.add_zero n) =
      (((CategoryTheory.Abelian.Ext.mk₀.{u} icℤ).comp w (Nat.zero_add n)).comp
        (CategoryTheory.Abelian.Ext.mk₀.{u} β) (Nat.add_zero n)).comp
        (CategoryTheory.Abelian.Ext.mk₀.{u} c₁) (Nat.add_zero n)
    rw [hMap,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀.{u} icℤ) w (CategoryTheory.Abelian.Ext.mk₀.{u} (F.map c₂))
        (Nat.zero_add n),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        ((CategoryTheory.Abelian.Ext.mk₀.{u} icℤ).comp w (Nat.zero_add n))
        (CategoryTheory.Abelian.Ext.mk₀.{u} (F.map c₂))
        (CategoryTheory.Abelian.Ext.mk₀.{u} c_h) (Nat.add_zero n),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← h_coc,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        ((CategoryTheory.Abelian.Ext.mk₀.{u} icℤ).comp w (Nat.zero_add n))
        (CategoryTheory.Abelian.Ext.mk₀.{u} β)
        (CategoryTheory.Abelian.Ext.mk₀.{u} c₁) (Nat.add_zero n)]

  have hTriTorsIff : ∀ {Z₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (π₁ : Quiver.Hom Y₁ Z₀) (π₂ : Quiver.Hom Y₂ Z₀) (h : Quiver.Hom Y₁ Y₂)
      (h_eq : CategoryTheory.CategoryStruct.comp h π₂ = π₁)
      (p_h : weilEtaleTorsionH Y₂ ℓ q →+ weilEtaleTorsionH Y₁ ℓ q),
      WeilIsTorsionEtalePullback h ℓ q p_h →
      ∀ (x₂ : ((pb_of π₂).obj (weilEtaleTorsionSheaf Z₀ ℓ)).H q)
        (x₁ : ((pb_of π₁).obj (weilEtaleTorsionSheaf Z₀ ℓ)).H q),
        WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq (weilEtaleTorsionSheaf Z₀ ℓ) q x₂ x₁ ↔
          p_h (Φ_of π₂ x₂) = Φ_of π₁ x₁ := by
    intro Z₀ Y₁ Y₂ π₁ π₂ h h_eq p_h hp_h x₂ x₁
    haveI : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom W₁ W₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    haveI : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom W₁ W₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let pb_h := pb_of h
    haveI : pb_h.Additive := (hSite.1 h).1
    haveI : CategoryTheory.Limits.PreservesFiniteLimits pb_h := (hSite.1 h).2.1
    haveI : CategoryTheory.Limits.PreservesFiniteColimits pb_h := (hSite.1 h).2.2.1
    let G₀ := weilEtaleTorsionSheaf Z₀ ℓ
    let cℤ_h := weilSliceColimConstZHom.{u} (@hc_all) (@hr_all) h
    let inv_cℤ_h := @CategoryTheory.inv _ _ _ _ cℤ_h ((hSite.1 h).2.2.2)
    let e_B : CategoryTheory.Iso (weilEtaleSitePullback π₁)
        (CategoryTheory.Functor.comp (weilEtaleSitePullback π₂) (weilEtaleSitePullback h)) :=
      CategoryTheory.Iso.trans
        (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm)
        (CategoryTheory.MorphismProperty.Over.pullbackComp h π₂)
    have hCoc : weilEtalePullMateInv.{u} π₁ π₂ h h_eq G₀ ≫ cM_of π₁ =
        pb_h.map (cM_of π₂) ≫ cM_of h :=
      hAbsMateCocycle Z₀.smallEtaleTopology Y₁.smallEtaleTopology Y₂.smallEtaleTopology
        (weilEtaleSitePullback π₁) (weilEtaleSitePullback π₂) (weilEtaleSitePullback h) e_B AM
    have hComm : p_h (Φ_of π₂ x₂) =
        Φ_of π₁ (weilSliceColimTrianglePullHom.{u} (@hc_all) (@hr_all) hSite
          π₁ π₂ h h_eq G₀ q x₂) :=
      (hPullCanon h p_h hp_h (Φ_of π₂ x₂)).trans
        (hExtIntertwine pb_h q inv_cℤ_h (cM_of π₂) (cM_of h)
          (weilEtalePullMateInv.{u} π₁ π₂ h h_eq G₀) (cM_of π₁) hCoc x₂)
    rw [hDet π₁ π₂ h h_eq G₀ x₂ x₁, hComm]
    exact ⟨congrArg (Φ_of π₁), fun hEq => (hPhiBij π₁).1 hEq⟩

  
  
  
  
  let X_inf : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec c_E.pt
  obtain ⟨p_hom, hp_hom⟩ := hPullEx e_X.hom ℓ q
  obtain ⟨p_inv, hp_inv⟩ := hPullEx e_X.inv ℓ q
  obtain ⟨p_idX, hp_idX⟩ := hPullEx (CategoryTheory.CategoryStruct.id X) ℓ q
  obtain ⟨p_idInf, hp_idInf⟩ := hPullEx (CategoryTheory.CategoryStruct.id X_inf) ℓ q

  have hp_inv_hom_id : ∀ ξ : weilEtaleTorsionH X ℓ q, p_inv (p_hom ξ) = ξ := by
    have hp_idX_eq := hPullId ℓ q p_idX hp_idX
    have hp_comp : WeilIsTorsionEtalePullback (e_X.inv ≫ e_X.hom) ℓ q p_idX :=
      e_X.inv_hom_id.symm ▸ hp_idX
    have hcomp_eq := hPullComp e_X.inv e_X.hom ℓ q p_inv p_hom p_idX hp_inv hp_hom hp_comp
    intro ξ
    have h1 := DFunLike.congr_fun (hcomp_eq.symm.trans hp_idX_eq) ξ
    exact h1

  have hp_hom_inv_id : ∀ y : weilEtaleTorsionH X_inf ℓ q, p_hom (p_inv y) = y := by
    have hp_idInf_eq := hPullId ℓ q p_idInf hp_idInf
    have hp_comp : WeilIsTorsionEtalePullback (e_X.hom ≫ e_X.inv) ℓ q p_idInf :=
      e_X.hom_inv_id.symm ▸ hp_idInf
    have hcomp_eq := hPullComp e_X.hom e_X.inv ℓ q p_hom p_inv p_idInf hp_hom hp_inv hp_comp
    intro y
    have h1 := DFunLike.congr_fun (hcomp_eq.symm.trans hp_idInf_eq) y
    exact h1

  let B_ℤ : CommRingCat.{u} := CommRingCat.of (ULift.{u} ℤ)
  let zHom : ∀ (R : CommRingCat.{u}), Quiver.Hom B_ℤ R := fun R =>
    CommRingCat.ofHom
      { toFun := fun x => Int.cast x.down
        map_one' := Int.cast_one
        map_mul' := fun x y => Int.cast_mul x.down y.down
        map_zero' := Int.cast_zero
        map_add' := fun x y => Int.cast_add x.down y.down }
  have hzHom_comp : ∀ {R S : CommRingCat.{u}} (g : Quiver.Hom R S),
      CategoryTheory.CategoryStruct.comp (zHom R) g = zHom S := by
    intro R S g
    apply CommRingCat.hom_ext
    ext x
    exact map_intCast g.hom x.down

  let α : Quiver.Hom ((CategoryTheory.Functor.const 𝒥).obj B_ℤ) E :=
    { app := fun j => zHom (E.obj j)
      naturality := fun _ _ θ =>
        (CategoryTheory.Category.id_comp _).trans (hzHom_comp (E.map θ)).symm }
  let f_inf : Quiver.Hom B_ℤ c_E.pt := zHom c_E.pt
  have hα_coc : ∀ j : 𝒥, CategoryTheory.CategoryStruct.comp (α.app j) (c_E.ι.app j) = f_inf :=
    fun j => hzHom_comp (c_E.ι.app j)

  let Z₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec B_ℤ
  let G₀ : CategoryTheory.Sheaf Z₀.smallEtaleTopology AddCommGrpCat.{u} :=
    weilEtaleTorsionSheaf Z₀ ℓ
  let π_j : ∀ j : 𝒥, Quiver.Hom (AlgebraicGeometry.Spec (E.obj j)) Z₀ :=
    fun j => AlgebraicGeometry.Spec.map (α.app j)
  let π_inf : Quiver.Hom X_inf Z₀ := AlgebraicGeometry.Spec.map f_inf
  let u_j : ∀ j : 𝒥, Quiver.Hom X_inf (AlgebraicGeometry.Spec (E.obj j)) :=
    fun j => AlgebraicGeometry.Spec.map (c_E.ι.app j)

  obtain ⟨hColimLift, hColimZero⟩ := hAff_q 𝒥 B_ℤ E α c_E hc_E f_inf hα_coc G₀

  refine ⟨?_, ?_⟩
  · 
    intro ξ
    obtain ⟨s_inf, hs_inf⟩ := (hPhiBij π_inf).2 (p_hom ξ)
    obtain ⟨j, hu, s_j, hMaps⟩ := hColimLift s_inf
    refine ⟨j, Φ_of (π_j j) s_j, fun p_j hp_j => ?_⟩
    obtain ⟨p_uj, hp_uj⟩ := hPullEx (u_j j) ℓ q
    have hp_uj_eq : p_uj (Φ_of (π_j j) s_j) = p_hom ξ :=
      ((hTriTorsIff π_inf (π_j j) (u_j j) hu p_uj hp_uj s_j s_inf).mp hMaps).trans hs_inf
    have hp_j_comp : p_j = p_inv.comp p_uj :=
      hPullComp e_X.inv (u_j j) ℓ q p_inv p_uj p_j hp_inv hp_uj hp_j
    rw [hp_j_comp, AddMonoidHom.comp_apply, hp_uj_eq]
    exact hp_inv_hom_id ξ
  · 
    intro j ξ_j p_j hp_j hp_j0
    obtain ⟨p_uj, hp_uj⟩ := hPullEx (u_j j) ℓ q
    have hp_j_comp : p_j = p_inv.comp p_uj :=
      hPullComp e_X.inv (u_j j) ℓ q p_inv p_uj p_j hp_inv hp_uj hp_j
    have hp_uj_zero : p_uj ξ_j = 0 := by
      have h1 : p_inv (p_uj ξ_j) = 0 := by
        rw [← AddMonoidHom.comp_apply, ← hp_j_comp, hp_j0]
      calc p_uj ξ_j = p_hom (p_inv (p_uj ξ_j)) := (hp_hom_inv_id (p_uj ξ_j)).symm
        _ = p_hom 0 := congrArg p_hom h1
        _ = 0 := map_zero p_hom
    obtain ⟨s_j, hs_j⟩ := (hPhiBij (π_j j)).2 ξ_j
    have hu : CategoryTheory.CategoryStruct.comp (u_j j) (π_j j) = π_inf :=
      (AlgebraicGeometry.Spec.map_comp (α.app j) (c_E.ι.app j)).symm.trans
        (congrArg AlgebraicGeometry.Spec.map (hα_coc j))
    have hMaps0 : WeilEtaleTrianglePullbackMapsTo π_inf (π_j j) (u_j j) hu G₀ q s_j 0 := by
      refine (hTriTorsIff π_inf (π_j j) (u_j j) hu p_uj hp_uj s_j 0).mpr ?_
      rw [hs_j, hp_uj_zero, map_zero]
    obtain ⟨j', θ, hθ, hMaps_θ⟩ := hColimZero j hu s_j hMaps0
    refine ⟨j', θ, fun p_θ hp_θ => ?_⟩
    have hθ_eq :=
      (hTriTorsIff (π_j j') (π_j j) (AlgebraicGeometry.Spec.map (E.map θ)) hθ p_θ hp_θ s_j 0).mp
        hMaps_θ
    rw [← hs_j, hθ_eq, map_zero]

theorem weil_odp_val_acyc_higherDirectImage_zero_of_stage_effacement (ℓ b : ℕ) [Fact (Nat.Prime ℓ)]
    {U₀ Y₀ U₁ Y₁ : AlgebraicGeometry.Scheme.{u}}
    (j₀ : U₀ ⟶ Y₀) (j₁ : U₁ ⟶ Y₁)
    (hEff : ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Y₁) [AlgebraicGeometry.Etale w]
        (ξ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j₁ w) ℓ b),
      (∃ (W₀ : AlgebraicGeometry.Scheme.{u}) (w₀ : W₀ ⟶ Y₀) (_ : AlgebraicGeometry.Etale w₀)
          (τ : W ⟶ W₀)
          (τ_U : CategoryTheory.Limits.pullback j₁ w ⟶ CategoryTheory.Limits.pullback j₀ w₀)
          (ξ₀ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j₀ w₀) ℓ b),
        CategoryTheory.IsPullback τ_U
          (CategoryTheory.Limits.pullback.snd j₁ w)
          (CategoryTheory.Limits.pullback.snd j₀ w₀) τ ∧
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage j₀ b (weilEtaleTorsionSheaf U₀ ℓ)) ∧
        ∀ (p_τ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j₀ w₀) ℓ b →+
            weilEtaleTorsionH (CategoryTheory.Limits.pullback j₁ w) ℓ b),
          WeilIsTorsionEtalePullback τ_U ℓ b p_τ → p_τ ξ₀ = ξ) ∨
      (∃ (W₀ : AlgebraicGeometry.Scheme.{u}) (w₀ : W₀ ⟶ Y₀) (_ : AlgebraicGeometry.Etale w₀)
          (τ : W ⟶ W₀)
          (τ_U : CategoryTheory.Limits.pullback j₁ w ⟶ CategoryTheory.Limits.pullback j₀ w₀)
          (ξ₀ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j₀ w₀) ℓ b)
          (I : Type u) (V : I → AlgebraicGeometry.Scheme.{u})
          (v : ∀ a : I, V a ⟶ W₀) (_ : ∀ a : I, AlgebraicGeometry.Etale (v a)),
        CategoryTheory.IsPullback τ_U
          (CategoryTheory.Limits.pullback.snd j₁ w)
          (CategoryTheory.Limits.pullback.snd j₀ w₀) τ ∧
        (⋃ a : I, Set.range (v a).base) = Set.univ ∧
        (∀ (p_τ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j₀ w₀) ℓ b →+
            weilEtaleTorsionH (CategoryTheory.Limits.pullback j₁ w) ℓ b),
          WeilIsTorsionEtalePullback τ_U ℓ b p_τ → p_τ ξ₀ = ξ) ∧
        (∀ (a : I)
            (p_a : weilEtaleTorsionH (CategoryTheory.Limits.pullback j₀ w₀) ℓ b →+
              weilEtaleTorsionH
                (CategoryTheory.Limits.pullback
                  (CategoryTheory.Limits.pullback.snd j₀ w₀) (v a)) ℓ b),
          WeilIsTorsionEtalePullback
            (CategoryTheory.Limits.pullback.fst
              (CategoryTheory.Limits.pullback.snd j₀ w₀) (v a)) ℓ b p_a →
          p_a ξ₀ = 0))) :
    CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage j₁ b (weilEtaleTorsionSheaf U₁ ℓ)) :=
by
  classical
  haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hop_comp : ∀ {C : Type _} [CategoryTheory.Category C] {A B D : C}
      (g₁ : A ⟶ B) (g₂ : B ⟶ D),
      (g₁ ≫ g₂).op = g₂.op ≫ g₁.op := fun _ _ => rfl

  have hMemEtale : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Etale)
      (R : CategoryTheory.Sieve U),
      R ∈ Z.smallEtaleTopology U ↔
        ∀ (x : ↥U.left), ∃ (Y : Z.Etale) (g : Y ⟶ U) (y : ↥Y.left),
          R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base y = x := by
    intro Z U R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      Z (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) Z
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance U R
    exact (iff_of_eq
      (congrArg (fun K : CategoryTheory.GrothendieckTopology Z.Etale => R ∈ K U) heq)).trans hiff

  obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}

  have hPullTri : ∀ {S₁ S₂ S₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : S₁ ⟶ S₂) (h₂ : S₂ ⟶ S₃) (h₁₂ : S₁ ⟶ S₃)
      (p₁ : weilEtaleTorsionH S₂ ℓ b →+ weilEtaleTorsionH S₁ ℓ b)
      (p₂ : weilEtaleTorsionH S₃ ℓ b →+ weilEtaleTorsionH S₂ ℓ b)
      (p₁₂ : weilEtaleTorsionH S₃ ℓ b →+ weilEtaleTorsionH S₁ ℓ b),
      h₁ ≫ h₂ = h₁₂ →
      WeilIsTorsionEtalePullback h₁ ℓ b p₁ →
      WeilIsTorsionEtalePullback h₂ ℓ b p₂ →
      WeilIsTorsionEtalePullback h₁₂ ℓ b p₁₂ →
      ∀ z : weilEtaleTorsionH S₃ ℓ b, p₁₂ z = p₁ (p₂ z) := by
    intro S₁ S₂ S₃ h₁ h₂ h₁₂ p₁ p₂ p₁₂ h_eq hp₁ hp₂ hp₁₂ z
    subst h_eq
    exact DFunLike.congr_fun (hPullComp h₁ h₂ ℓ b p₁ p₂ p₁₂ hp₁ hp₂ hp₁₂) z

  have hBranch1Cover : ∀ (W₀ : AlgebraicGeometry.Scheme.{u})
      (w₀ : W₀ ⟶ Y₀) (hw₀ : AlgebraicGeometry.Etale w₀)
      (ξ₀ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j₀ w₀) ℓ b),
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage j₀ b (weilEtaleTorsionSheaf U₀ ℓ)) →
      ∃ (I : Type u) (V : I → AlgebraicGeometry.Scheme.{u})
        (v : ∀ a : I, V a ⟶ W₀) (_ : ∀ a : I, AlgebraicGeometry.Etale (v a)),
        (⋃ a : I, Set.range (v a).base) = Set.univ ∧
        (∀ (a : I)
            (p_a : weilEtaleTorsionH (CategoryTheory.Limits.pullback j₀ w₀) ℓ b →+
              weilEtaleTorsionH
                (CategoryTheory.Limits.pullback
                  (CategoryTheory.Limits.pullback.snd j₀ w₀) (v a)) ℓ b),
          WeilIsTorsionEtalePullback
            (CategoryTheory.Limits.pullback.fst
              (CategoryTheory.Limits.pullback.snd j₀ w₀) (v a)) ℓ b p_a →
          p_a ξ₀ = 0) := by
    intro W₀ w₀ hw₀ ξ₀ hZero₀
    let J_Y₀ := Y₀.smallEtaleTopology
    let G_U₀ := weilEtaleTorsionSheaf U₀ ℓ
    let B_j₀ : CategoryTheory.Functor Y₀.Etale U₀.Etale := weilEtaleSitePullback j₀
    let Q₀ : CategoryTheory.Functor (Opposite Y₀.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B_j₀.op (G_U₀.cohomologyPresheaf b)
    have hZeroSh₀ : CategoryTheory.Limits.IsZero (CategoryTheory.sheafify J_Y₀ Q₀) :=
      (CategoryTheory.sheafToPresheaf J_Y₀ AddCommGrpCat.{u}).map_isZero hZero₀
    let η₀ := CategoryTheory.toSheafify J_Y₀ Q₀
    have hη₀_zero : η₀ = 0 := hZeroSh₀.eq_of_tgt η₀ 0
