            CategoryTheory.CategoryStruct.comp (α_sys m)
              (pf_π.map (weilEtaleLocalTorsionCounit X m U_Yt_et))) := by
      have hpb_res : CategoryTheory.IsPullback (π_left ∣_ U_Y) U_Yt.ι U_Y.ι π_left :=
