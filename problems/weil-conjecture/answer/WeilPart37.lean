          _ = (fst₂ ≫ W₂.hom) ≫ g_FF₂ := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (snd₂ ≫ g_F₂k₂) ≫ g_FF₂ := by rw [hc₂]
          _ = snd₂ ≫ (g_F₂k₂ ≫ g_FF₂) := CategoryTheory.Category.assoc _ _ _
