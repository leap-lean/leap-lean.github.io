            (η_sh S').app (Opposite.op (B_v.obj (M_v.obj E'))) :=
          NatTrans.congr_app (hCanonUnit_unit v) (Opposite.op (M_v.obj E'))
        have h3 := (η_sh S').naturality (adj_site.unit.app E').op
        dsimp [P_const] at h3
        rw [Category.id_comp] at h3
        let m_unit : (pf_v.obj (weilEtaleTorsionSheaf S' ℓ)).obj.obj (Opposite.op (M_v.obj E')) ⟶
            (weilEtaleTorsionSheaf S' ℓ).obj.obj (Opposite.op E') :=
          (weilEtaleTorsionSheaf S' ℓ).obj.map (adj_site.unit.app E').op
        have hδ_inv_app : δ_inv.hom.app (Opposite.op E') =
            (canonUnit v).hom.app (Opposite.op (M_v.obj E')) ≫ m_unit := by
          dsimp [δ_inv]
          rw [Adjunction.homEquiv_counit]
          rfl
        change (η_sh S').app (Opposite.op E') ≫
            (δ_hom.hom.app (Opposite.op E') ≫ δ_inv.hom.app (Opposite.op E')) =
          (η_sh S').app (Opposite.op E') ≫ 𝟙 _
        calc (η_sh S').app (Opposite.op E') ≫
              (δ_hom.hom.app (Opposite.op E') ≫ δ_inv.hom.app (Opposite.op E'))
            = ((η_sh S').app (Opposite.op E') ≫ δ_hom.hom.app (Opposite.op E')) ≫
                δ_inv.hom.app (Opposite.op E') := (Category.assoc _ _ _).symm
          _ = (η_sh S).app (Opposite.op (M_v.obj E')) ≫ δ_inv.hom.app (Opposite.op E') :=
                congrArg (fun m => m ≫ δ_inv.hom.app (Opposite.op E')) h1
          _ = (η_sh S).app (Opposite.op (M_v.obj E')) ≫
                ((canonUnit v).hom.app (Opposite.op (M_v.obj E')) ≫ m_unit) :=
                congrArg (fun m => (η_sh S).app (Opposite.op (M_v.obj E')) ≫ m) hδ_inv_app
          _ = ((η_sh S).app (Opposite.op (M_v.obj E')) ≫
                (canonUnit v).hom.app (Opposite.op (M_v.obj E'))) ≫ m_unit :=
                (Category.assoc _ _ _).symm
          _ = (η_sh S').app (Opposite.op (B_v.obj (M_v.obj E'))) ≫ m_unit :=
                congrArg (fun m => m ≫ m_unit) h2
          _ = (η_sh S').app (Opposite.op E') := h3.symm
          _ = (η_sh S').app (Opposite.op E') ≫ 𝟙 _ := (Category.comp_id _).symm
      have h_inv_hom : δ_inv ≫ δ_hom = 𝟙 (shPull_v.obj (weilEtaleTorsionSheaf S ℓ)) := by
        apply (adj_sh.homEquiv (weilEtaleTorsionSheaf S ℓ) (shPull_v.obj (weilEtaleTorsionSheaf S ℓ))).injective
        rw [Adjunction.homEquiv_naturality_right adj_sh δ_inv δ_hom,
          (adj_sh.homEquiv _ _).apply_symm_apply,
          Adjunction.homEquiv_unit adj_sh, pf_v.map_id]
        have hid_unit : adj_sh.unit.app (weilEtaleTorsionSheaf S ℓ) ≫
            𝟙 (pf_v.obj (shPull_v.obj (weilEtaleTorsionSheaf S ℓ))) =
            adj_sh.unit.app (weilEtaleTorsionSheaf S ℓ) := Category.comp_id _
        rw [hid_unit]
        refine ((sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
          (P_const S) (pf_v.obj (shPull_v.obj (weilEtaleTorsionSheaf S ℓ)))).injective
          (Eq.trans (Adjunction.homEquiv_unit _ _ _ _)
            (Eq.trans ?_ (Adjunction.homEquiv_unit _ _ _ _).symm))
        ext E_op : 2
        obtain ⟨E⟩ := E_op
        let d_app : (pf_v.obj (weilEtaleTorsionSheaf S' ℓ)).obj.obj (Opposite.op E) ⟶
            (pf_v.obj (shPull_v.obj (weilEtaleTorsionSheaf S ℓ))).obj.obj (Opposite.op E) :=
          δ_hom.hom.app (Opposite.op (B_v.obj E))
        let m_mid : (P_const S).obj (Opposite.op E) ⟶
            (pf_v.obj (shPull_v.obj (weilEtaleTorsionSheaf S ℓ))).obj.obj (Opposite.op E) :=
          (η_sh S).app (Opposite.op (M_v.obj (B_v.obj E)))
        have h1 : (η_sh S).app (Opposite.op E) ≫ (canonUnit v).hom.app (Opposite.op E) =
            ((η_sh S').app (Opposite.op (B_v.obj E)) :
              (P_const S).obj (Opposite.op E) ⟶
                (pf_v.obj (weilEtaleTorsionSheaf S' ℓ)).obj.obj (Opposite.op E)) :=
          NatTrans.congr_app (hCanonUnit_unit v) (Opposite.op E)
        have h2 : ((η_sh S').app (Opposite.op (B_v.obj E)) :
              (P_const S).obj (Opposite.op E) ⟶
                (pf_v.obj (weilEtaleTorsionSheaf S' ℓ)).obj.obj (Opposite.op E)) ≫ d_app = m_mid :=
          NatTrans.congr_app hδ_hom (Opposite.op (B_v.obj E))
        have h3 := (η_sh S).naturality (adj_site.counit.app E).op
        dsimp [P_const] at h3
        rw [Category.id_comp] at h3
        have h3' : m_mid =
            (η_sh S).app (Opposite.op E) ≫ (weilEtaleTorsionSheaf S ℓ).obj.map (adj_site.counit.app E).op := h3
        change (η_sh S).app (Opposite.op E) ≫ ((canonUnit v).hom.app (Opposite.op E) ≫ d_app) =
          (η_sh S).app (Opposite.op E) ≫ (weilEtaleTorsionSheaf S ℓ).obj.map (adj_site.counit.app E).op
        exact Eq.trans (Category.assoc _ _ _).symm
          (Eq.trans (congrArg (fun m => m ≫ d_app) h1) (Eq.trans h2 h3'))
      exact ⟨{ hom := δ_hom, inv := δ_inv, hom_inv_id := h_hom_inv, inv_hom_id := h_inv_hom },
        hδ_hom⟩

    let B_jX := weilEtaleSitePullback j_X
    let P_push := B_jX.sheafPushforwardContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology X_U.smallEtaleTopology
    let FM_X := weilEtaleTorsionSheaf X ℓ
    let FM_XU := weilEtaleTorsionSheaf X_U ℓ
    let η_M : FM_X ⟶ P_push.obj FM_XU := canonUnit j_X
    have hη_M_eq : (((weilEtaleSitePullback j_X).sheafAdjunctionContinuous AddCommGrpCat.{u}
        X.smallEtaleTopology X_U.smallEtaleTopology).homEquiv FM_X FM_XU
