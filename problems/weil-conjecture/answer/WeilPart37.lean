    let Spec_prod : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct K S_d S_1)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_prod.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_prod.symm.toRingHom)
        hom_inv_id := by
