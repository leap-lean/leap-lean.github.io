  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
  let P_pull := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
  let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
  let const₁ := (CategoryTheory.Functor.const (Opposite S₁.Etale)).obj AM
  let const₂ := (CategoryTheory.Functor.const (Opposite S₂.Etale)).obj AM
  let adj_sh₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
  let adj_sh₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
  let η_sh₁ : const₁ ⟶ (C₁.obj AM).obj := adj_sh₁.unit.app const₁
  let η_sh₂ : const₂ ⟶ (C₂.obj AM).obj := adj_sh₂.unit.app const₂
  let u_pre : const₂ ⟶ (P_push.obj (C₁.obj AM)).obj :=
    CategoryTheory.Functor.whiskerLeft B.op η_sh₁
  let u_sh : C₂.obj AM ⟶ P_push.obj (C₁.obj AM) :=
    (adj_sh₂.homEquiv const₂ (P_push.obj (C₁.obj AM))).symm u_pre
  have hu_fac : η_sh₂ ≫ u_sh.hom = u_pre := by
    have h1 := (adj_sh₂.homEquiv const₂ (P_push.obj (C₁.obj AM))).apply_symm_apply u_pre
    rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
    exact h1
  have hu_iso_on_conn : ∀ (O_et : S₂.Etale),
      ConnectedSpace ↥O_et.left →
