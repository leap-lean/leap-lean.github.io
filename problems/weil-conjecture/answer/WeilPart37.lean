theorem weil_finite_field_deg2_even_quadForm_split (F : Type u) [Finite F] [Field F]
    (F₂ : Type u) [Field F₂] [Algebra F F₂] [FiniteDimensional F F₂]
    (hdeg₂ : Module.finrank F F₂ = 2)
    (m : ℕ)
    (Q₀ : MvPolynomial (Fin (2 * m + 1 + 1)) F)
    (hQ_homog : Q₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) F 2)
    (hQ_det : Matrix.det (Matrix.of fun i j : Fin (2 * m + 1 + 1) =>
      MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q₀))) ≠ 0) :
    let F_split : MvPolynomial (Fin (2 * m + 1 + 1)) F₂ :=
      ∑ j ∈ Finset.range (m + 1),
        if h : 2 * j + 1 < 2 * m + 1 + 1 then
          (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
            MvPolynomial (Fin (2 * m + 1 + 1)) F₂) *
            MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0
    (∃ hF_split : F_split ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) F₂ (2 • 1),
      ∀ (μ : Fin (2 * m + 1 + 1))
        (hXμ : MvPolynomial.X μ ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) F₂ 1),
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) F₂) :=
          MvPolynomial.gradedAlgebra
        ∃ e_μ : (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) F₂) (MvPolynomial.X μ) ⧸
            Ideal.span {HomogeneousLocalization.Away.mk
              (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) F₂)
              hXμ 2 F_split hF_split}) ≃+*
            MvPolynomial (Fin (2 * m)) F₂,
          ∀ c : F₂,
            e_μ (Ideal.Quotient.mk _
              (HomogeneousLocalization.Away.mk
                (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) F₂)
                hXμ 0 (MvPolynomial.C c) (MvPolynomial.isHomogeneous_C _ c))) =
              MvPolynomial.C c) ∧
    (∃ (M N : Matrix (Fin (2 * m + 1 + 1)) (Fin (2 * m + 1 + 1)) F₂),
      M * N = 1 ∧
      N * M = 1 ∧
      MvPolynomial.eval₂ (MvPolynomial.C.comp (algebraMap F F₂))
        (fun a => ∑ b : Fin (2 * m + 1 + 1),
          MvPolynomial.C (M a b) * MvPolynomial.X b) Q₀ = F_split) :=
by
  have hAwayEquiv : ∀ (K : Type u) [CommRing K] (N : ℕ) (μ : Fin (N + 1))
      (hXμ : MvPolynomial.X μ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
        MvPolynomial.gradedAlgebra
      ∃ e_away : HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X μ) ≃+*
          MvPolynomial {a : Fin (N + 1) // a ≠ μ} K,
        ∀ (d : ℕ) (P : MvPolynomial (Fin (N + 1)) K)
          (hP : P ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (d • 1)),
          e_away (HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXμ d P hP) =
            MvPolynomial.eval₂ MvPolynomial.C
              (fun a => if h : a = μ then 1 else MvPolynomial.X ⟨a, h⟩) P := by
    clear * -
    intro K _ N μ hXμ
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let S := MvPolynomial (Fin (N + 1)) K
    let τ := {a : Fin (N + 1) // a ≠ μ}
    let S_τ := MvPolynomial τ K
    let X_μ : S := MvPolynomial.X μ
    let M_pow : Submonoid S := Submonoid.powers X_μ
    let w : Fin (N + 1) → S_τ := fun a => if h : a = μ then 1 else MvPolynomial.X ⟨a, h⟩
    let dehom : S →+* S_τ := MvPolynomial.eval₂Hom MvPolynomial.C w
    have hdehom_Xμ : dehom X_μ = 1 := by
      change MvPolynomial.eval₂ MvPolynomial.C w (MvPolynomial.X μ) = 1
      rw [MvPolynomial.eval₂_X]
      simp [w]
    have hdehom_pow : ∀ y : M_pow, dehom y.1 = 1 := by
      rintro ⟨_, k, rfl⟩
      simp [map_pow, hdehom_Xμ]
    have hUnit : ∀ y : M_pow, IsUnit (dehom y.1) := fun y => by
      rw [hdehom_pow y]
      exact isUnit_one
    let β_loc : Localization M_pow →+* S_τ := IsLocalization.lift hUnit
    have hβ_loc_mk : ∀ (P : S) (y : M_pow), β_loc (Localization.mk P y) = dehom P := by
      intro P y
      rw [Localization.mk_eq_mk']
      exact (IsLocalization.lift_mk'_spec hUnit P (dehom P) y).mpr (by rw [hdehom_pow y, one_mul])
    let valHom : HomogeneousLocalization.Away 𝒜 X_μ →+* Localization M_pow :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let β : HomogeneousLocalization.Away 𝒜 X_μ →+* S_τ := β_loc.comp valHom
    have hβ_mk : ∀ (d : ℕ) (P : S) (hP : P ∈ 𝒜 (d • 1)),
        β (HomogeneousLocalization.Away.mk 𝒜 hXμ d P hP) = dehom P := by
      intro d P hP
      change β_loc (HomogeneousLocalization.val (HomogeneousLocalization.Away.mk 𝒜 hXμ d P hP)) = _
      rw [HomogeneousLocalization.Away.val_mk, hβ_loc_mk]
    let ι_K : K →+* HomogeneousLocalization.Away 𝒜 X_μ :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 M_pow).comp (algebraMap K ↥(𝒜 0))
    have hC_mem : ∀ c : K, MvPolynomial.C c ∈ 𝒜 (0 • 1) := by
      intro c
      rw [zero_smul]
      exact (MvPolynomial.mem_homogeneousSubmodule 0 (MvPolynomial.C c)).mpr
        (MvPolynomial.isHomogeneous_C _ c)
    have hι_K_eq : ∀ c : K,
        ι_K c = HomogeneousLocalization.Away.mk 𝒜 hXμ 0 (MvPolynomial.C c) (hC_mem c) := by
      intro c
      apply HomogeneousLocalization.val_injective M_pow
      rw [HomogeneousLocalization.Away.val_mk]
      have h1 : (⟨X_μ ^ 0, pow_mem (Submonoid.mem_powers X_μ) 0⟩ : M_pow) = (1 : M_pow) := by
        apply Subtype.ext
        simp
      rw [h1]
      rfl
    have hX_mem : ∀ a : Fin (N + 1), MvPolynomial.X a ∈ 𝒜 (1 • 1) := by
      intro a
      rw [one_smul]
      exact (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X a)).mpr
        (MvPolynomial.isHomogeneous_X K a)
    let u : τ → HomogeneousLocalization.Away 𝒜 X_μ := fun b =>
      HomogeneousLocalization.Away.mk 𝒜 hXμ 1 (MvPolynomial.X b.1) (hX_mem b.1)
    let α : S_τ →+* HomogeneousLocalization.Away 𝒜 X_μ := MvPolynomial.eval₂Hom ι_K u
    have hβα : β.comp α = RingHom.id S_τ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change β (MvPolynomial.eval₂ ι_K u (MvPolynomial.C c)) = MvPolynomial.C c
        rw [MvPolynomial.eval₂_C, hι_K_eq c, hβ_mk]
        exact MvPolynomial.eval₂_C MvPolynomial.C w c
      · intro b
        change β (MvPolynomial.eval₂ ι_K u (MvPolynomial.X b)) = MvPolynomial.X b
        rw [MvPolynomial.eval₂_X]
        dsimp [u]
        rw [hβ_mk]
        change MvPolynomial.eval₂ MvPolynomial.C w (MvPolynomial.X b.1) = MvPolynomial.X b
        rw [MvPolynomial.eval₂_X]
        simp [w, b.2]
    have hαβ : α.comp β = RingHom.id (HomogeneousLocalization.Away 𝒜 X_μ) := by
      let φ : S →+* Localization M_pow := valHom.comp (α.comp dehom)
      have hφ_C : ∀ c : K, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        have hdC : dehom (MvPolynomial.C c) = MvPolynomial.C c :=
          MvPolynomial.eval₂_C MvPolynomial.C w c
        have hαC : α (MvPolynomial.C c) = HomogeneousLocalization.Away.mk 𝒜 hXμ 0 (MvPolynomial.C c) (hC_mem c) := by
          change MvPolynomial.eval₂ ι_K u (MvPolynomial.C c) = _
          rw [MvPolynomial.eval₂_C, hι_K_eq c]
        change HomogeneousLocalization.val (α (dehom (MvPolynomial.C c))) = _
        rw [hdC, hαC, HomogeneousLocalization.Away.val_mk]
        have h1 : (⟨X_μ ^ 0, pow_mem (Submonoid.mem_powers X_μ) 0⟩ : M_pow) = (1 : M_pow) := by
          apply Subtype.ext
          simp
        rw [h1]
      have hφ_X : ∀ a : Fin (N + 1),
          φ (MvPolynomial.X a) =
            Localization.mk (MvPolynomial.X a) ⟨X_μ ^ 1, pow_mem (Submonoid.mem_powers X_μ) 1⟩ := by
        intro a
        have hdX : dehom (MvPolynomial.X a) = w a := MvPolynomial.eval₂_X MvPolynomial.C w a
        change HomogeneousLocalization.val (α (dehom (MvPolynomial.X a))) = _
        rw [hdX]
        dsimp [w]
        by_cases ha : a = μ
        · subst ha
          rw [dite_eq_left_of_eq_true (eq_true rfl), map_one, HomogeneousLocalization.val_one]
          have hself : Localization.mk X_μ ⟨X_μ, Submonoid.mem_powers X_μ⟩ = 1 :=
            Localization.mk_self ⟨X_μ, Submonoid.mem_powers X_μ⟩
          rw [← hself]
          have h1 : (⟨X_μ, Submonoid.mem_powers X_μ⟩ : M_pow) =
              ⟨X_μ ^ 1, pow_mem (Submonoid.mem_powers X_μ) 1⟩ := by
            apply Subtype.ext
            simp
          rw [h1]
        · rw [dite_eq_right_of_eq_false (eq_false ha)]
          have hαX : α (MvPolynomial.X ⟨a, ha⟩) = u ⟨a, ha⟩ := MvPolynomial.eval₂_X ι_K u ⟨a, ha⟩
          rw [hαX]
          exact HomogeneousLocalization.Away.val_mk 𝒜 1 hXμ (MvPolynomial.X a) (hX_mem a)
      have hφ_X_pow : ∀ (a : Fin (N + 1)) (k : ℕ),
          φ (MvPolynomial.X a ^ k) =
            Localization.mk (MvPolynomial.X a ^ k)
              ⟨X_μ ^ k, pow_mem (Submonoid.mem_powers X_μ) k⟩ := by
        intro a k
        induction k with
        | zero =>
          simp only [pow_zero, map_one]
          have h1 : (⟨1, pow_mem (Submonoid.mem_powers X_μ) 0⟩ : M_pow) = 1 := Subtype.ext rfl
          rw [h1, Localization.mk_one]
        | succ k ih =>
          rw [pow_succ, map_mul, ih, hφ_X, Localization.mk_mul]
          congr 1
          apply Subtype.ext
          simp [pow_succ]
      have hφ_prod : ∀ (s : Fin (N + 1) →₀ ℕ) (T : Finset (Fin (N + 1))),
          φ (∏ a ∈ T, MvPolynomial.X a ^ s a) =
            Localization.mk (∏ a ∈ T, MvPolynomial.X a ^ s a)
              ⟨X_μ ^ (∑ a ∈ T, s a), pow_mem (Submonoid.mem_powers X_μ) (∑ a ∈ T, s a)⟩ := by
        intro s T
        induction T using Finset.induction_on with
        | empty =>
          simp only [Finset.prod_empty, Finset.sum_empty, pow_zero, map_one]
          have h1 : (⟨1, pow_mem (Submonoid.mem_powers X_μ) 0⟩ : M_pow) = 1 := Subtype.ext rfl
          rw [h1, Localization.mk_one]
        | @insert a T ha ih =>
          rw [Finset.prod_insert ha, Finset.sum_insert ha, map_mul, hφ_X_pow, ih, Localization.mk_mul]
          congr 1
          apply Subtype.ext
          simp [pow_add]
      have hφ_monomial : ∀ (s : Fin (N + 1) →₀ ℕ) (c : K) (d : ℕ),
          (∑ a ∈ s.support, s a) = d →
          φ (MvPolynomial.monomial s c) =
            Localization.mk (MvPolynomial.monomial s c)
              ⟨X_μ ^ d, pow_mem (Submonoid.mem_powers X_μ) d⟩ := by
        intro s c d hdeg
        rw [MvPolynomial.monomial_eq, Finsupp.prod, map_mul, hφ_C, hφ_prod, Localization.mk_mul]
        congr 1
        apply Subtype.ext
        simp [hdeg]
      have hφ_homog : ∀ (d : ℕ) (P : S), P.IsHomogeneous d →
          φ P = Localization.mk P ⟨X_μ ^ d, pow_mem (Submonoid.mem_powers X_μ) d⟩ := by
        intro d P hP
        have hsum : ∀ (T : Finset (Fin (N + 1) →₀ ℕ)),
            (∀ s ∈ T, (∑ a ∈ s.support, s a) = d) →
            φ (∑ s ∈ T, MvPolynomial.monomial s (P.coeff s)) =
              Localization.mk (∑ s ∈ T, MvPolynomial.monomial s (P.coeff s))
                ⟨X_μ ^ d, pow_mem (Submonoid.mem_powers X_μ) d⟩ := by
          intro T
          induction T using Finset.induction_on with
          | empty =>
            intro _
            simp [Localization.mk_zero]
          | @insert s T hs ih =>
            intro hT
            rw [Finset.sum_insert hs, map_add,
              hφ_monomial s (P.coeff s) d (hT s (Finset.mem_insert_self s T)),
              ih (fun s' hs' => hT s' (Finset.mem_insert_of_mem hs')),
              Localization.add_mk_self]
        have hsupp : ∀ s ∈ P.support, (∑ a ∈ s.support, s a) = d := by
          intro s hs
          have hmem := hP (MvPolynomial.mem_support_iff.mp hs)
          simpa [Finsupp.weight_apply, Finsupp.sum] using hmem
        conv_lhs => rw [MvPolynomial.as_sum P]
        conv_rhs => rw [MvPolynomial.as_sum P]
        exact hsum P.support hsupp
      apply RingHom.ext
      intro z
      obtain ⟨d, P, hP, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hXμ z
      apply HomogeneousLocalization.val_injective M_pow
      simp only [RingHom.comp_apply, RingHom.id_apply, hβ_mk]
      change φ P = HomogeneousLocalization.val (HomogeneousLocalization.Away.mk 𝒜 hXμ d P hP)
      have hP_homog : P.IsHomogeneous d := by
        dsimp [𝒜] at hP
        rw [mul_one] at hP
        exact (MvPolynomial.mem_homogeneousSubmodule d P).mp hP
      rw [hφ_homog d P hP_homog, HomogeneousLocalization.Away.val_mk]
    exact ⟨RingEquiv.ofRingHom β α hβα hαβ, fun d P hP => hβ_mk d P hP⟩

  have hDehomQuotEquiv : ∀ (K : Type u) [CommRing K] (m₀ : ℕ) (μ : Fin (2 * m₀ + 1 + 1)),
      let F_sp : MvPolynomial (Fin (2 * m₀ + 1 + 1)) K :=
        ∑ j ∈ Finset.range (m₀ + 1),
          if h : 2 * j + 1 < 2 * m₀ + 1 + 1 then
            (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
              MvPolynomial (Fin (2 * m₀ + 1 + 1)) K) *
              MvPolynomial.X ⟨2 * j + 1, h⟩
          else 0
      let f_dehom : MvPolynomial {a : Fin (2 * m₀ + 1 + 1) // a ≠ μ} K :=
        MvPolynomial.eval₂ MvPolynomial.C
          (fun a => if h : a = μ then 1 else MvPolynomial.X ⟨a, h⟩) F_sp
      ∃ e_elim :
          (MvPolynomial {a : Fin (2 * m₀ + 1 + 1) // a ≠ μ} K ⧸ Ideal.span {f_dehom}) ≃+*
          MvPolynomial (Fin (2 * m₀)) K,
        ∀ c : K, e_elim (Ideal.Quotient.mk _ (MvPolynomial.C c)) = MvPolynomial.C c := by
    clear * -
    intro K _ m₀ μ F_sp f_dehom
    let τ := {a : Fin (2 * m₀ + 1 + 1) // a ≠ μ}
    have hμ_lt : μ.1 < 2 * m₀ + 1 + 1 := μ.isLt
    let j₀ : Fin (m₀ + 1) := ⟨μ.1 / 2, by omega⟩
    have hj₀_eq : j₀.1 = μ.1 / 2 := rfl
    let μ' : Fin (2 * m₀ + 1 + 1) :=
      ⟨if μ.1 % 2 = 0 then 2 * (μ.1 / 2) + 1 else 2 * (μ.1 / 2), by split_ifs <;> omega⟩
    have hμ' : μ' ≠ μ := by
      intro h
      have hval := congrArg Fin.val h
      dsimp [μ'] at hval
      split_ifs at hval <;> omega
    let u₀ : τ := ⟨μ', hμ'⟩
    let τ' := {x : τ // x ≠ u₀}
    have hy₀_ne_μ : ∀ (j : Fin (m₀ + 1)), j ≠ j₀ →
        (⟨2 * j.1, by omega⟩ : Fin (2 * m₀ + 1 + 1)) ≠ μ := by
      intro j hj h
      apply hj
      ext
      have hval := congrArg Fin.val h
      rw [hj₀_eq]
      dsimp at hval
      omega
    have hy₀_ne_u₀ : ∀ (j : Fin (m₀ + 1)) (hj : j ≠ j₀),
        (⟨⟨2 * j.1, by omega⟩, hy₀_ne_μ j hj⟩ : τ) ≠ u₀ := by
      intro j hj h
      apply hj
      ext
      have hval := congrArg (fun x : τ => x.1.1) h
      rw [hj₀_eq]
      dsimp [u₀, μ'] at hval
      split_ifs at hval <;> omega
    have hy₁_ne_μ : ∀ (j : Fin (m₀ + 1)), j ≠ j₀ →
        (⟨2 * j.1 + 1, by omega⟩ : Fin (2 * m₀ + 1 + 1)) ≠ μ := by
      intro j hj h
      apply hj
      ext
      have hval := congrArg Fin.val h
      rw [hj₀_eq]
      dsimp at hval
      omega
    have hy₁_ne_u₀ : ∀ (j : Fin (m₀ + 1)) (hj : j ≠ j₀),
        (⟨⟨2 * j.1 + 1, by omega⟩, hy₁_ne_μ j hj⟩ : τ) ≠ u₀ := by
      intro j hj h
      apply hj
      ext
      have hval := congrArg (fun x : τ => x.1.1) h
      rw [hj₀_eq]
      dsimp [u₀, μ'] at hval
      split_ifs at hval <;> omega
    let r₀ : MvPolynomial τ' K :=
      ∑ j : Fin (m₀ + 1),
        if hj : j = j₀ then 0
        else
          MvPolynomial.X ⟨⟨⟨2 * j.1, by omega⟩, hy₀_ne_μ j hj⟩, hy₀_ne_u₀ j hj⟩ *
            MvPolynomial.X ⟨⟨⟨2 * j.1 + 1, by omega⟩, hy₁_ne_μ j hj⟩, hy₁_ne_u₀ j hj⟩
    have hF_sp_fin : F_sp =
        ∑ j : Fin (m₀ + 1),
          (MvPolynomial.X ⟨2 * j.1, by omega⟩ : MvPolynomial (Fin (2 * m₀ + 1 + 1)) K) *
            MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩ := by
      dsimp [F_sp]
      rw [← Fin.sum_univ_eq_sum_range]
      refine Finset.sum_congr rfl fun j _ => ?_
      have hj_lt : 2 * j.1 + 1 < 2 * m₀ + 1 + 1 := by omega
      rw [dite_eq_left_of_eq_true (eq_true hj_lt)]
    let w : Fin (2 * m₀ + 1 + 1) → MvPolynomial τ K :=
      fun a => if h : a = μ then 1 else MvPolynomial.X ⟨a, h⟩
    have hf_dehom_eq : f_dehom = MvPolynomial.X u₀ + MvPolynomial.rename Subtype.val r₀ := by
      change MvPolynomial.eval₂ MvPolynomial.C w F_sp = _
      rw [hF_sp_fin, MvPolynomial.eval₂_sum, map_sum]
      have hXu₀_sum : (MvPolynomial.X u₀ : MvPolynomial τ K) =
          ∑ j : Fin (m₀ + 1), if j = j₀ then MvPolynomial.X u₀ else 0 := by
        simp
      rw [hXu₀_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
      by_cases hj : j = j₀
      · subst hj
        simp only [↓reduceIte, ↓reduceDIte, map_zero, add_zero]
        by_cases hpar : μ.1 % 2 = 0
        · have hev : (⟨2 * j₀.1, by omega⟩ : Fin (2 * m₀ + 1 + 1)) = μ := by
            ext; dsimp [j₀]; omega
          have hod : (⟨2 * j₀.1 + 1, by omega⟩ : Fin (2 * m₀ + 1 + 1)) = μ' := by
            ext; dsimp [j₀, μ']; simp [hpar]
          rw [hev, hod]
          simp only [w, ↓reduceDIte, hμ', one_mul]
          rfl
        · have hev : (⟨2 * j₀.1, by omega⟩ : Fin (2 * m₀ + 1 + 1)) = μ' := by
            ext; dsimp [j₀, μ']; simp [hpar]
          have hod : (⟨2 * j₀.1 + 1, by omega⟩ : Fin (2 * m₀ + 1 + 1)) = μ := by
            ext; dsimp [j₀]; omega
          rw [hev, hod]
          simp only [w, hμ', ↓reduceDIte, mul_one]
          rfl
      · simp only [hj, ↓reduceIte, ↓reduceDIte, zero_add, map_mul, MvPolynomial.rename_X]
        have h0 : w ⟨2 * j.1, by omega⟩ = MvPolynomial.X ⟨⟨2 * j.1, by omega⟩, hy₀_ne_μ j hj⟩ :=
          dite_eq_right_of_eq_false (eq_false (hy₀_ne_μ j hj))
        have h1 : w ⟨2 * j.1 + 1, by omega⟩ = MvPolynomial.X ⟨⟨2 * j.1 + 1, by omega⟩, hy₁_ne_μ j hj⟩ :=
          dite_eq_right_of_eq_false (eq_false (hy₁_ne_μ j hj))
        rw [h0, h1]
    let I : Ideal (MvPolynomial τ K) := Ideal.span {f_dehom}
    let Φ : MvPolynomial τ K →+* MvPolynomial τ' K :=
      MvPolynomial.eval₂Hom MvPolynomial.C (fun x : τ => if hx : x = u₀ then -r₀ else MvPolynomial.X ⟨x, hx⟩)
    have hΦ_rename : Φ.comp (MvPolynomial.rename Subtype.val).toRingHom = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change MvPolynomial.eval₂ MvPolynomial.C _ ((MvPolynomial.rename Subtype.val) (MvPolynomial.C c)) = _
        rw [MvPolynomial.rename_C, MvPolynomial.eval₂_C]
        rfl
      · intro y
        change MvPolynomial.eval₂ MvPolynomial.C _ ((MvPolynomial.rename Subtype.val) (MvPolynomial.X y)) = _
        rw [MvPolynomial.rename_X, MvPolynomial.eval₂_X]
        simp [y.2]
    have hΦ_ker : I ≤ RingHom.ker Φ := by
      rw [Ideal.span_le]
      intro p hp
      change Φ p = 0
      rw [Set.mem_singleton_iff.mp hp, hf_dehom_eq, map_add]
      have h1 : Φ (MvPolynomial.X u₀) = -r₀ := by
        change MvPolynomial.eval₂ MvPolynomial.C _ (MvPolynomial.X u₀) = -r₀
        rw [MvPolynomial.eval₂_X]
        simp
      have h2 : Φ (MvPolynomial.rename Subtype.val r₀) = r₀ := by
        have h := RingHom.congr_fun hΦ_rename r₀
        simpa using h
      rw [h1, h2, neg_add_cancel]
    let Φ_bar : (MvPolynomial τ K ⧸ I) →+* MvPolynomial τ' K :=
      Ideal.Quotient.lift I Φ hΦ_ker
    let Ψ : MvPolynomial τ' K →+* (MvPolynomial τ K ⧸ I) :=
      (Ideal.Quotient.mk I).comp (MvPolynomial.rename Subtype.val).toRingHom
    have hΦΨ : Φ_bar.comp Ψ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change Φ (MvPolynomial.rename Subtype.val (MvPolynomial.C c)) = MvPolynomial.C c
        have h := RingHom.congr_fun hΦ_rename (MvPolynomial.C c)
        simpa using h
      · intro y
        change Φ (MvPolynomial.rename Subtype.val (MvPolynomial.X y)) = MvPolynomial.X y
        have h := RingHom.congr_fun hΦ_rename (MvPolynomial.X y)
        simpa using h
    have hΨΦ : Ψ.comp Φ_bar = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        change Ψ (Φ (MvPolynomial.C c)) = Ideal.Quotient.mk I (MvPolynomial.C c)
        have h1 : Φ (MvPolynomial.C c) = MvPolynomial.C c := MvPolynomial.eval₂_C _ _ c
        rw [h1]
        change Ideal.Quotient.mk I (MvPolynomial.rename Subtype.val (MvPolynomial.C c)) = _
        rw [MvPolynomial.rename_C]
      · intro x
        change Ψ (Φ (MvPolynomial.X x)) = Ideal.Quotient.mk I (MvPolynomial.X x)
        by_cases hx : x = u₀
        · subst hx
          have hΦu : Φ (MvPolynomial.X u₀) = -r₀ := by
            change MvPolynomial.eval₂ MvPolynomial.C _ (MvPolynomial.X u₀) = -r₀
            rw [MvPolynomial.eval₂_X]
            simp
          rw [hΦu, map_neg]
          change -(Ideal.Quotient.mk I (MvPolynomial.rename Subtype.val r₀)) =
            Ideal.Quotient.mk I (MvPolynomial.X u₀)
          rw [← map_neg]
          apply Ideal.Quotient.eq.mpr
          have hdiff : -MvPolynomial.rename Subtype.val r₀ - MvPolynomial.X u₀ = -f_dehom := by
            rw [hf_dehom_eq]; ring
          rw [hdiff]
          exact I.neg_mem (Ideal.subset_span (Set.mem_singleton f_dehom))
        · have hΦx : Φ (MvPolynomial.X x) = MvPolynomial.X ⟨x, hx⟩ := by
            change MvPolynomial.eval₂ MvPolynomial.C _ (MvPolynomial.X x) = _
            rw [MvPolynomial.eval₂_X]
            simp [hx]
          rw [hΦx]
          change Ideal.Quotient.mk I (MvPolynomial.rename Subtype.val (MvPolynomial.X ⟨x, hx⟩)) = _
          rw [MvPolynomial.rename_X]
    let e₁ : (MvPolynomial τ K ⧸ I) ≃+* MvPolynomial τ' K :=
      RingEquiv.ofRingHom Φ_bar Ψ hΦΨ hΨΦ
    let e_step1 : τ ≃ Fin (2 * m₀ + 1) := (finSuccAboveEquiv μ).symm
    let ν : Fin (2 * m₀ + 1) := e_step1 u₀
    let e_mid : τ' ≃ {k : Fin (2 * m₀ + 1) // k ≠ ν} :=
      { toFun := fun ⟨x, hx⟩ => ⟨e_step1 x, fun h => hx (e_step1.injective h)⟩
        invFun := fun ⟨k, hk⟩ => ⟨e_step1.symm k, fun h => hk (by dsimp [ν]; rw [← h, e_step1.apply_symm_apply])⟩
        left_inv := fun ⟨x, _⟩ => Subtype.ext (e_step1.symm_apply_apply x)
        right_inv := fun ⟨k, _⟩ => Subtype.ext (e_step1.apply_symm_apply k) }
    let σ_eq : τ' ≃ Fin (2 * m₀) := e_mid.trans (finSuccAboveEquiv ν).symm
    let e_elim := e₁.trans (MvPolynomial.renameEquiv K σ_eq).toRingEquiv
    refine ⟨e_elim, fun c => ?_⟩
    change (MvPolynomial.rename σ_eq) (Φ (MvPolynomial.C c)) = MvPolynomial.C c
    have h1 : Φ (MvPolynomial.C c) = MvPolynomial.C c := MvPolynomial.eval₂_C _ _ c
    rw [h1, MvPolynomial.rename_C]

  have hHomog2 : ∀ (R : Type u) [CommRing R] (n : ℕ),
      (∀ (Q : MvPolynomial (Fin n) R),
        Q ∈ MvPolynomial.homogeneousSubmodule (Fin n) R 2 →
        let H : Matrix (Fin n) (Fin n) R :=
          Matrix.of fun i j => MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q))
        (∀ (c : R) (v : Fin n → R), MvPolynomial.eval (c • v) Q = c ^ 2 * MvPolynomial.eval v Q) ∧
        (∀ u v : Fin n → R,
          MvPolynomial.eval (u + v) Q - MvPolynomial.eval u Q - MvPolynomial.eval v Q =
            dotProduct u (H.mulVec v))) ∧
      (∀ (P₁ P₂ : MvPolynomial (Fin n) R),
        P₁ ∈ MvPolynomial.homogeneousSubmodule (Fin n) R 2 →
        P₂ ∈ MvPolynomial.homogeneousSubmodule (Fin n) R 2 →
        (∀ v : Fin n → R, MvPolynomial.eval v P₁ = MvPolynomial.eval v P₂) →
        P₁ = P₂) := by
    clear * -
    intro R _ n
    have hsum2 : ∀ (a b : Fin n) (f : Fin n → Fin n → R),
        (∑ i : Fin n, ∑ j : Fin n, if i = a ∧ j = b then f i j else 0) = f a b := by
      intro a b f
      rw [Finset.sum_eq_single a]
      · rw [Finset.sum_eq_single b]
        · simp
        · intro j _ hjb; simp [hjb]
        · intro hb; exact False.elim (hb (Finset.mem_univ b))
      · intro i _ hia; exact Finset.sum_eq_zero fun j _ => by simp [hia]
      · intro ha; exact False.elim (ha (Finset.mem_univ a))
    let e : Fin n → (Fin n → R) := fun i => Pi.single i 1
    let recOp : MvPolynomial (Fin n) R → MvPolynomial (Fin n) R := fun P =>
      (∑ i : Fin n, MvPolynomial.C (MvPolynomial.eval (e i) P) * (MvPolynomial.X i) ^ 2) +
      (∑ i : Fin n, ∑ j ∈ Finset.univ.filter (fun j => i < j),
        MvPolynomial.C (MvPolynomial.eval (e i + e j) P - MvPolynomial.eval (e i) P - MvPolynomial.eval (e j) P) *
          MvPolynomial.X i * MvPolynomial.X j)
    let Good2 : MvPolynomial (Fin n) R → Prop := fun Q =>
      (∀ (c : R) (v : Fin n → R), MvPolynomial.eval (c • v) Q = c ^ 2 * MvPolynomial.eval v Q) ∧
      (∀ u v : Fin n → R,
        MvPolynomial.eval (u + v) Q - MvPolynomial.eval u Q - MvPolynomial.eval v Q =
          ∑ i : Fin n, ∑ j : Fin n,
            u i * MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q)) * v j) ∧
      recOp Q = Q
    have hGood_zero : Good2 0 := by
      refine ⟨fun c v => by simp, fun u v => by simp, ?_⟩
      simp [recOp]
    have hGood_add : ∀ A B : MvPolynomial (Fin n) R, Good2 A → Good2 B → Good2 (A + B) := by
      intro A B ⟨hA1, hA2, hA3⟩ ⟨hB1, hB2, hB3⟩
      refine ⟨fun c v => ?_, fun u v => ?_, ?_⟩
      · rw [map_add, map_add, hA1, hB1, mul_add]
      · have lhs_eq :
            MvPolynomial.eval (u + v) (A + B) - MvPolynomial.eval u (A + B) - MvPolynomial.eval v (A + B) =
            (MvPolynomial.eval (u + v) A - MvPolynomial.eval u A - MvPolynomial.eval v A) +
            (MvPolynomial.eval (u + v) B - MvPolynomial.eval u B - MvPolynomial.eval v B) := by
          simp only [map_add]; ring
        rw [lhs_eq, hA2, hB2, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun j _ => ?_
        simp only [map_add]
        ring
      · dsimp [recOp] at hA3 hB3 ⊢
        have hsq : ∑ i : Fin n, MvPolynomial.C (MvPolynomial.eval (e i) (A + B)) * MvPolynomial.X i ^ 2 =
            (∑ i : Fin n, MvPolynomial.C (MvPolynomial.eval (e i) A) * MvPolynomial.X i ^ 2) +
            (∑ i : Fin n, MvPolynomial.C (MvPolynomial.eval (e i) B) * MvPolynomial.X i ^ 2) := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          simp only [map_add, add_mul]
        have hcr : (∑ i : Fin n, ∑ j ∈ Finset.univ.filter (fun j => i < j),
              MvPolynomial.C (MvPolynomial.eval (e i + e j) (A + B) -
                MvPolynomial.eval (e i) (A + B) - MvPolynomial.eval (e j) (A + B)) *
                MvPolynomial.X i * MvPolynomial.X j) =
            (∑ i : Fin n, ∑ j ∈ Finset.univ.filter (fun j => i < j),
              MvPolynomial.C (MvPolynomial.eval (e i + e j) A -
                MvPolynomial.eval (e i) A - MvPolynomial.eval (e j) A) *
                MvPolynomial.X i * MvPolynomial.X j) +
            (∑ i : Fin n, ∑ j ∈ Finset.univ.filter (fun j => i < j),
              MvPolynomial.C (MvPolynomial.eval (e i + e j) B -
                MvPolynomial.eval (e i) B - MvPolynomial.eval (e j) B) *
                MvPolynomial.X i * MvPolynomial.X j) := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun j _ => ?_
          have hsub : MvPolynomial.eval (e i + e j) (A + B) -
              MvPolynomial.eval (e i) (A + B) - MvPolynomial.eval (e j) (A + B) =
              (MvPolynomial.eval (e i + e j) A - MvPolynomial.eval (e i) A - MvPolynomial.eval (e j) A) +
              (MvPolynomial.eval (e i + e j) B - MvPolynomial.eval (e i) B - MvPolynomial.eval (e j) B) := by
            simp only [map_add]; ring
          rw [hsub, map_add, add_mul, add_mul]
        rw [hsq, hcr]
        calc _ =
            ((∑ i : Fin n, MvPolynomial.C (MvPolynomial.eval (e i) A) * MvPolynomial.X i ^ 2) +
              ∑ i : Fin n, ∑ j ∈ Finset.univ.filter (fun j => i < j),
                MvPolynomial.C (MvPolynomial.eval (e i + e j) A -
                  MvPolynomial.eval (e i) A - MvPolynomial.eval (e j) A) *
                  MvPolynomial.X i * MvPolynomial.X j) +
            ((∑ i : Fin n, MvPolynomial.C (MvPolynomial.eval (e i) B) * MvPolynomial.X i ^ 2) +
              ∑ i : Fin n, ∑ j ∈ Finset.univ.filter (fun j => i < j),
                MvPolynomial.C (MvPolynomial.eval (e i + e j) B -
                  MvPolynomial.eval (e i) B - MvPolynomial.eval (e j) B) *
                  MvPolynomial.X i * MvPolynomial.X j) := by ring
          _ = A + B := by rw [hA3, hB3]
    have hGood_sq : ∀ (c : R) (k : Fin n), Good2 (MvPolynomial.C c * (MvPolynomial.X k) ^ 2) := by
      intro c k
      set M₁ : MvPolynomial (Fin n) R := MvPolynomial.C c * (MvPolynomial.X k) ^ 2
      have hH : ∀ i j : Fin n,
          MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i M₁)) =
            if i = k ∧ j = k then 2 * c else 0 := by
        intro i j
        dsimp [M₁]
        simp only [sq, Derivation.leibniz, MvPolynomial.pderiv_C, MvPolynomial.pderiv_X,
          Pi.single_apply, smul_eq_mul, mul_zero, add_zero]
        by_cases hik : i = k
        · subst hik
          simp only [↓reduceIte, mul_one, true_and, map_add, MvPolynomial.pderiv_X, Pi.single_apply]
          by_cases hjk : j = i
          · subst hjk
            simp only [↓reduceIte, map_mul, map_add, map_one, MvPolynomial.constantCoeff_C]
            ring
          · simp [Ne.symm hjk, hjk]
        · simp [Ne.symm hik, hik]
      have hpol : ∀ u v : Fin n → R,
          MvPolynomial.eval (u + v) M₁ - MvPolynomial.eval u M₁ - MvPolynomial.eval v M₁ =
            ∑ i : Fin n, ∑ j : Fin n,
              u i * MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i M₁)) * v j := by
        intro u v
        have hrhs : (∑ i : Fin n, ∑ j : Fin n,
              u i * MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i M₁)) * v j) =
            u k * (2 * c) * v k := by
          have hcongr : (∑ i : Fin n, ∑ j : Fin n,
                u i * MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i M₁)) * v j) =
              ∑ i : Fin n, ∑ j : Fin n, if i = k ∧ j = k then u i * (2 * c) * v j else 0 := by
            refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
            rw [hH i j]
            split_ifs <;> ring
          rw [hcongr]
          exact hsum2 k k (fun i j => u i * (2 * c) * v j)
        rw [hrhs]
        simp only [M₁, map_mul, map_pow, MvPolynomial.eval_C, MvPolynomial.eval_X, Pi.add_apply]
        ring
      refine ⟨fun c₀ v => ?_, hpol, ?_⟩
      · simp only [M₁, map_mul, map_pow, MvPolynomial.eval_C, MvPolynomial.eval_X, Pi.smul_apply, smul_eq_mul]
        ring
      · dsimp [recOp]
        have h1 : ∑ i : Fin n, MvPolynomial.C (MvPolynomial.eval (e i) M₁) * MvPolynomial.X i ^ 2 = M₁ := by
          have hev : ∀ i : Fin n, MvPolynomial.eval (e i) M₁ = if i = k then c else 0 := by
            intro i
            simp only [M₁, e, map_mul, map_pow, MvPolynomial.eval_C, MvPolynomial.eval_X]
            by_cases hik : i = k
            · subst hik; simp
            · simp [hik]
          simp_rw [hev, apply_ite MvPolynomial.C, map_zero, ite_mul, zero_mul]
          simp [M₁]
        have h2 : (∑ i : Fin n, ∑ j ∈ Finset.univ.filter (fun j => i < j),
            MvPolynomial.C (MvPolynomial.eval (e i + e j) M₁ -
              MvPolynomial.eval (e i) M₁ - MvPolynomial.eval (e j) M₁) *
              MvPolynomial.X i * MvPolynomial.X j) = 0 := by
          refine Finset.sum_eq_zero fun i _ => Finset.sum_eq_zero fun j hj => ?_
          have hij : i ≠ j := (Finset.mem_filter.mp hj).2.ne
          have hev_ij : MvPolynomial.eval (e i + e j) M₁ - MvPolynomial.eval (e i) M₁ -
              MvPolynomial.eval (e j) M₁ = 2 * c * (e i k * e j k) := by
            simp only [M₁, map_mul, map_pow, MvPolynomial.eval_C, MvPolynomial.eval_X, Pi.add_apply]
            ring
          have hprod0 : e i k * e j k = 0 := by
            dsimp [e]
            by_cases hki : k = i
            · subst hki
              rw [Pi.single_eq_of_ne hij, mul_zero]
            · rw [Pi.single_eq_of_ne hki, zero_mul]
          rw [hev_ij, hprod0, mul_zero, map_zero, zero_mul, zero_mul]
        rw [h1, h2, add_zero]
    have hGood_cross : ∀ (c : R) (k ℓ : Fin n), k < ℓ →
        Good2 (MvPolynomial.C c * MvPolynomial.X k * MvPolynomial.X ℓ) := by
      intro c k ℓ hkℓ
      have hkℓ_ne : k ≠ ℓ := hkℓ.ne
      set M₂ : MvPolynomial (Fin n) R := MvPolynomial.C c * MvPolynomial.X k * MvPolynomial.X ℓ
      have hH : ∀ i j : Fin n,
          MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i M₂)) =
            (if i = k ∧ j = ℓ then c else 0) + (if i = ℓ ∧ j = k then c else 0) := by
        intro i j
        have hM₂_assoc : M₂ = MvPolynomial.C c * (MvPolynomial.X k * MvPolynomial.X ℓ) := mul_assoc _ _ _
        rw [hM₂_assoc]
        simp only [Derivation.leibniz, MvPolynomial.pderiv_C, MvPolynomial.pderiv_X,
          Pi.single_apply, smul_eq_mul, mul_zero, add_zero]
        by_cases hik : i = k
        · subst hik
          have hiℓ : i ≠ ℓ := hkℓ_ne
          simp only [↓reduceIte, Ne.symm hiℓ, hiℓ, mul_zero, add_zero, true_and, false_and]
          by_cases hjℓ : j = ℓ
          · subst hjℓ; simp
          · simp [Ne.symm hjℓ, hjℓ]
        · by_cases hiℓ : i = ℓ
          · subst hiℓ
            have hik' : i ≠ k := hkℓ_ne.symm
            simp only [↓reduceIte, Ne.symm hik', hik', mul_one, mul_zero, zero_add, add_zero,
              false_and, true_and, MvPolynomial.pderiv_X, Pi.single_apply]
            by_cases hjk : j = k
            · subst hjk; simp
            · simp [Ne.symm hjk, hjk]
          · simp [Ne.symm hik, Ne.symm hiℓ, hik, hiℓ]
      have hpol : ∀ u v : Fin n → R,
          MvPolynomial.eval (u + v) M₂ - MvPolynomial.eval u M₂ - MvPolynomial.eval v M₂ =
            ∑ i : Fin n, ∑ j : Fin n,
              u i * MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i M₂)) * v j := by
        intro u v
        have hrhs : (∑ i : Fin n, ∑ j : Fin n,
              u i * MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i M₂)) * v j) =
            u k * c * v ℓ + u ℓ * c * v k := by
          have hcongr : (∑ i : Fin n, ∑ j : Fin n,
                u i * MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i M₂)) * v j) =
              (∑ i : Fin n, ∑ j : Fin n, if i = k ∧ j = ℓ then u i * c * v j else 0) +
              (∑ i : Fin n, ∑ j : Fin n, if i = ℓ ∧ j = k then u i * c * v j else 0) := by
            rw [← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [hH i j]
            split_ifs <;> ring
          rw [hcongr, hsum2 k ℓ (fun i j => u i * c * v j), hsum2 ℓ k (fun i j => u i * c * v j)]
        rw [hrhs]
        simp only [M₂, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, Pi.add_apply]
        ring
      refine ⟨fun c₀ v => ?_, hpol, ?_⟩
      · simp only [M₂, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, Pi.smul_apply, smul_eq_mul]
        ring
      · dsimp [recOp]
        have h1 : ∑ i : Fin n, MvPolynomial.C (MvPolynomial.eval (e i) M₂) * MvPolynomial.X i ^ 2 = 0 := by
          refine Finset.sum_eq_zero fun i _ => ?_
          have hev : MvPolynomial.eval (e i) M₂ = 0 := by
            simp only [M₂, e, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
            by_cases hki : k = i
            · subst hki
              rw [Pi.single_eq_of_ne hkℓ_ne.symm, mul_zero]
            · rw [Pi.single_eq_of_ne hki, mul_zero, zero_mul]
          rw [hev, map_zero, zero_mul]
        have h2 : (∑ i : Fin n, ∑ j ∈ Finset.univ.filter (fun j => i < j),
            MvPolynomial.C (MvPolynomial.eval (e i + e j) M₂ -
              MvPolynomial.eval (e i) M₂ - MvPolynomial.eval (e j) M₂) *
              MvPolynomial.X i * MvPolynomial.X j) = M₂ := by
          have hcoeff : ∀ (i j : Fin n), i < j →
              MvPolynomial.eval (e i + e j) M₂ - MvPolynomial.eval (e i) M₂ - MvPolynomial.eval (e j) M₂ =
                if i = k then (if j = ℓ then c else 0) else 0 := by
            intro i j hij
            have hp : MvPolynomial.eval (e i + e j) M₂ - MvPolynomial.eval (e i) M₂ - MvPolynomial.eval (e j) M₂ =
                c * (e i k * e j ℓ + e i ℓ * e j k) := by
              simp only [M₂, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, Pi.add_apply]
              ring
            rw [hp]
            dsimp [e]
            by_cases hik : i = k
            · subst hik
              rw [Pi.single_eq_same, Pi.single_eq_of_ne hkℓ_ne.symm, zero_mul, add_zero, one_mul]
              simp only [↓reduceIte]
              by_cases hjℓ : j = ℓ
              · subst hjℓ; simp
              · rw [Pi.single_eq_of_ne (Ne.symm hjℓ), mul_zero]
                simp [hjℓ]
            · rw [Pi.single_eq_of_ne (Ne.symm hik), zero_mul, zero_add]
              simp only [hik, ↓reduceIte]
              by_cases hiℓ : i = ℓ
              · subst hiℓ
                have hkj : k ≠ j := (lt_trans hkℓ hij).ne
                rw [Pi.single_eq_of_ne hkj, mul_zero, mul_zero]
              · rw [Pi.single_eq_of_ne (Ne.symm hiℓ), zero_mul, mul_zero]
          have hinner : ∀ i : Fin n,
              (∑ j ∈ Finset.univ.filter (fun j => i < j),
                MvPolynomial.C (MvPolynomial.eval (e i + e j) M₂ -
                  MvPolynomial.eval (e i) M₂ - MvPolynomial.eval (e j) M₂) *
                  MvPolynomial.X i * MvPolynomial.X j) =
                if i = k then M₂ else 0 := by
            intro i
            have hcongr : (∑ j ∈ Finset.univ.filter (fun j => i < j),
                  MvPolynomial.C (MvPolynomial.eval (e i + e j) M₂ -
                    MvPolynomial.eval (e i) M₂ - MvPolynomial.eval (e j) M₂) *
                    MvPolynomial.X i * MvPolynomial.X j) =
                ∑ j ∈ Finset.univ.filter (fun j => i < j),
                  if i = k then (if j = ℓ then MvPolynomial.C c * MvPolynomial.X i * MvPolynomial.X j else 0) else 0 := by
              refine Finset.sum_congr rfl fun j hj => ?_
              rw [hcoeff i j (Finset.mem_filter.mp hj).2]
              split_ifs <;> simp
            rw [hcongr]
            by_cases hik : i = k
            · subst hik
              simp only [↓reduceIte, Finset.sum_ite_eq', Finset.mem_filter, Finset.mem_univ,
                hkℓ, and_self, M₂]
            · simp [hik]
          simp_rw [hinner]
          simp
        rw [h1, zero_add, h2]
    have hGood_all : ∀ Q : MvPolynomial (Fin n) R,
        Q ∈ MvPolynomial.homogeneousSubmodule (Fin n) R 2 → Good2 Q := by
      intro Q hQ
      rw [MvPolynomial.mem_homogeneousSubmodule] at hQ
      have hmon : ∀ s ∈ Q.support, Good2 (MvPolynomial.monomial s (Q.coeff s)) := by
        intro s hs
        have hdeg : (∑ a ∈ s.support, s a) = 2 := by
          have h1 := hQ (MvPolynomial.mem_support_iff.mp hs)
          simpa [Finsupp.weight_apply, Finsupp.sum] using h1
        have hpos : ∀ a ∈ s.support, 1 ≤ s a := fun a ha =>
          Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp ha)
        have hcard_le : s.support.card ≤ 2 := by
          calc s.support.card = ∑ _a ∈ s.support, 1 := Finset.card_eq_sum_ones s.support
            _ ≤ ∑ a ∈ s.support, s a := Finset.sum_le_sum hpos
            _ = 2 := hdeg
        have hcard_ne0 : s.support.card ≠ 0 := by
          intro h0
          rw [Finset.card_eq_zero.mp h0, Finset.sum_empty] at hdeg
          omega
        have hcases : s.support.card = 1 ∨ s.support.card = 2 := by omega
        rcases hcases with hc1 | hc2
        · obtain ⟨k, hk⟩ := Finset.card_eq_one.mp hc1
          have hsk : s k = 2 := by
            rw [hk, Finset.sum_singleton] at hdeg
            exact hdeg
          have hs_eq : s = Finsupp.single k 2 := by
            ext a
            by_cases hak : a = k
            · subst hak; simp [hsk]
            · have hnot : a ∉ s.support := by rw [hk]; simp [hak]
              rw [Finsupp.notMem_support_iff.mp hnot]
              simp [Ne.symm hak]
          have hmon_eq : MvPolynomial.monomial s (Q.coeff s) =
              MvPolynomial.C (Q.coeff s) * (MvPolynomial.X k) ^ 2 := by
            rw [hs_eq, MvPolynomial.X_pow_eq_monomial, MvPolynomial.C_mul_monomial, mul_one]
          rw [hmon_eq]
          exact hGood_sq (Q.coeff s) k
        · obtain ⟨a, b, hab, hab_eq⟩ := Finset.card_eq_two.mp hc2
          let k := min a b
          let ℓ := max a b
          have hkℓ : k < ℓ := min_lt_max.mpr hab
          have hsupp_eq : s.support = {k, ℓ} := by
            rcases lt_or_gt_of_ne hab with hlt | hgt
            · simp [k, ℓ, min_eq_left hlt.le, max_eq_right hlt.le, hab_eq]
            · simp [k, ℓ, min_eq_right hgt.le, max_eq_left hgt.le, hab_eq, Finset.pair_comm]
          have hsum_pair : s k + s ℓ = 2 := by
            rw [hsupp_eq, Finset.sum_pair hkℓ.ne] at hdeg
            exact hdeg
          have hsk_pos : 1 ≤ s k := hpos k (by rw [hsupp_eq]; simp)
          have hsℓ_pos : 1 ≤ s ℓ := hpos ℓ (by rw [hsupp_eq]; simp)
          have hsk1 : s k = 1 := by omega
          have hsℓ1 : s ℓ = 1 := by omega
          have hs_eq : s = Finsupp.single k 1 + Finsupp.single ℓ 1 := by
            ext x
            by_cases hxk : x = k
            · subst hxk
              simp [hsk1, hkℓ.ne.symm]
            · by_cases hxℓ : x = ℓ
              · subst hxℓ
                simp [hsℓ1, hkℓ.ne]
              · have hnot : x ∉ s.support := by rw [hsupp_eq]; simp [hxk, hxℓ]
                rw [Finsupp.notMem_support_iff.mp hnot]
                simp [Ne.symm hxk, Ne.symm hxℓ]
          have hmon_eq : MvPolynomial.monomial s (Q.coeff s) =
              MvPolynomial.C (Q.coeff s) * MvPolynomial.X k * MvPolynomial.X ℓ := by
            rw [hs_eq, mul_assoc, MvPolynomial.X, MvPolynomial.X,
              MvPolynomial.monomial_mul_monomial, MvPolynomial.C_mul_monomial, mul_one, mul_one]
          rw [hmon_eq]
          exact hGood_cross (Q.coeff s) k ℓ hkℓ
      rw [MvPolynomial.as_sum Q]
      exact Finset.sum_induction (fun s => MvPolynomial.monomial s (Q.coeff s)) Good2
        hGood_add hGood_zero hmon
    refine ⟨fun Q hQ => ?_, fun P₁ P₂ hP₁ hP₂ heval => ?_⟩
    · obtain ⟨h1, h2, _⟩ := hGood_all Q hQ
      refine ⟨h1, fun u v => ?_⟩
      rw [h2 u v]
      simp only [dotProduct, Matrix.mulVec, Matrix.of_apply, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      ring
    · have h1 := (hGood_all P₁ hP₁).2.2
      have h2 := (hGood_all P₂ hP₂).2.2
      have hrec_eq : recOp P₁ = recOp P₂ := by
        dsimp [recOp]
        simp only [heval]
      rw [← h1, hrec_eq, h2]

  have hOrthoPlanes : ∀ (K : Type u) [Field K] (r : ℕ)
      (V : Type u) [AddCommGroup V] [Module K V] [FiniteDimensional K V]
      (hdim : Module.finrank K V = 2 * r)
      (q : V → K)
      (B : V →ₗ[K] V →ₗ[K] K)
      (hq_smul : ∀ (c : K) (v : V), q (c • v) = c ^ 2 * q v)
      (hpolar : ∀ u v : V, q (u + v) - q u - q v = B u v)
      (hsymm : ∀ u v : V, B u v = B v u)
      (hnondeg : ∀ u : V, (∀ v : V, B u v = 0) → u = 0),
      ∃ u w : Fin r → V,
        (∀ j j' : Fin r, j ≠ j' →
          B (u j) (u j') = 0 ∧ B (u j) (w j') = 0 ∧ B (w j) (u j') = 0 ∧ B (w j) (w j') = 0) ∧
        (∀ j : Fin r, 4 * q (u j) * q (w j) - (B (u j) (w j)) ^ 2 ≠ 0) := by
    clear * -
    intro K _ r
    induction r with
    | zero =>
      intro V _ _ _ _ _ _ _ _ _ _
      exact ⟨Fin.elim0, Fin.elim0, fun j => Fin.elim0 j, fun j => Fin.elim0 j⟩
    | succ r' ih =>
      intro V _ _ _ hdim q B hq_smul hpolar hsymm hnondeg
      have hB_diag : ∀ v : V, B v v = 2 * q v := by
        intro v
        have h1 := hpolar v v
        have h2 : v + v = (2 : K) • v := (two_smul K v).symm
        rw [h2, hq_smul] at h1
        rw [← h1]
        ring
      have hdisc_B : ∀ u₀ w₀ : V,
          4 * q u₀ * q w₀ - (B u₀ w₀) ^ 2 = B u₀ u₀ * B w₀ w₀ - (B u₀ w₀) ^ 2 := by
        intro u₀ w₀
        rw [hB_diag u₀, hB_diag w₀]
        ring
      have hex_plane : ∃ u₀ w₀ : V, B u₀ u₀ * B w₀ w₀ - (B u₀ w₀) ^ 2 ≠ 0 := by
        have hpos : 0 < Module.finrank K V := by omega
        have : Nontrivial V := Module.finrank_pos_iff.mp hpos
        obtain ⟨v₁, hv₁⟩ := exists_ne (0 : V)
        by_cases hv₁_diag : B v₁ v₁ = 0
        · have hex_w : ∃ w₀ : V, B v₁ w₀ ≠ 0 := by
            by_contra hall
            exact hv₁ (hnondeg v₁ (fun w => not_ne_iff.mp (fun h => hall ⟨w, h⟩)))
          obtain ⟨w₀, hw₀⟩ := hex_w
          refine ⟨v₁, w₀, ?_⟩
          rw [hv₁_diag, zero_mul, zero_sub]
          exact neg_ne_zero.mpr (pow_ne_zero 2 hw₀)
        · let W₁ : Submodule K V := LinearMap.ker (B v₁)
          have hker_dim : 0 < Module.finrank K W₁ := by
            have hrk := LinearMap.finrank_range_add_finrank_ker (B v₁)
            rw [hdim] at hrk
            change Module.finrank K (LinearMap.range (B v₁)) + Module.finrank K W₁ = 2 * (r' + 1) at hrk
            have hrle : Module.finrank K (LinearMap.range (B v₁)) ≤ 1 := by
              calc Module.finrank K (LinearMap.range (B v₁))
                  ≤ Module.finrank K K := Submodule.finrank_le _
                _ = 1 := Module.finrank_self K
            omega
          have : Nontrivial W₁ := Module.finrank_pos_iff.mp hker_dim
          obtain ⟨z₁, hz₁⟩ := exists_ne (0 : W₁)
          have hz₁_val : (z₁ : V) ≠ 0 := fun h => hz₁ (Subtype.ext h)
          have hz₁_orth : B v₁ z₁.1 = 0 := LinearMap.mem_ker.mp z₁.2
          by_cases hz₁_diag : B z₁.1 z₁.1 = 0
          · have hex_w : ∃ w₀ : V, B z₁.1 w₀ ≠ 0 := by
              by_contra hall
              exact hz₁_val (hnondeg z₁.1 (fun w => not_ne_iff.mp (fun h => hall ⟨w, h⟩)))
            obtain ⟨w₀, hw₀⟩ := hex_w
            refine ⟨z₁.1, w₀, ?_⟩
            rw [hz₁_diag, zero_mul, zero_sub]
            exact neg_ne_zero.mpr (pow_ne_zero 2 hw₀)
          · refine ⟨v₁, z₁.1, ?_⟩
            rw [hz₁_orth, sq, zero_mul, sub_zero]
            exact mul_ne_zero hv₁_diag hz₁_diag
      obtain ⟨u₀, w₀, hΔ₀⟩ := hex_plane
      set Δ₀ : K := B u₀ u₀ * B w₀ w₀ - (B u₀ w₀) ^ 2
      let π_P : V →ₗ[K] K × K := LinearMap.prod (B u₀) (B w₀)
      let W_perp : Submodule K V := LinearMap.ker π_P
      let lift_P : K → K → V := fun x₁ x₂ =>
        (Δ₀⁻¹ * (B w₀ w₀ * x₁ - B u₀ w₀ * x₂)) • u₀ +
          (Δ₀⁻¹ * (-B u₀ w₀ * x₁ + B u₀ u₀ * x₂)) • w₀
      have hlift_u₀ : ∀ x₁ x₂ : K, B u₀ (lift_P x₁ x₂) = x₁ := by
        intro x₁ x₂
        dsimp [lift_P]
        rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
        calc (Δ₀⁻¹ * (B w₀ w₀ * x₁ - B u₀ w₀ * x₂)) * B u₀ u₀ +
              (Δ₀⁻¹ * (-B u₀ w₀ * x₁ + B u₀ u₀ * x₂)) * B u₀ w₀
            = (Δ₀⁻¹ * Δ₀) * x₁ := by dsimp [Δ₀]; ring
          _ = x₁ := by rw [inv_mul_cancel₀ hΔ₀, one_mul]
      have hlift_w₀ : ∀ x₁ x₂ : K, B w₀ (lift_P x₁ x₂) = x₂ := by
        intro x₁ x₂
        dsimp [lift_P]
        rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul, hsymm w₀ u₀]
        calc (Δ₀⁻¹ * (B w₀ w₀ * x₁ - B u₀ w₀ * x₂)) * B u₀ w₀ +
              (Δ₀⁻¹ * (-B u₀ w₀ * x₁ + B u₀ u₀ * x₂)) * B w₀ w₀
            = (Δ₀⁻¹ * Δ₀) * x₂ := by dsimp [Δ₀]; ring
          _ = x₂ := by rw [inv_mul_cancel₀ hΔ₀, one_mul]
      have hrange_top : LinearMap.range π_P = ⊤ := by
        rw [LinearMap.range_eq_top]
        rintro ⟨x₁, x₂⟩
        refine ⟨lift_P x₁ x₂, ?_⟩
        ext
        · exact hlift_u₀ x₁ x₂
        · exact hlift_w₀ x₁ x₂
      have hdim_W : Module.finrank K W_perp = 2 * r' := by
        have hrk := LinearMap.finrank_range_add_finrank_ker π_P
        rw [hdim] at hrk
        have hr_dim : Module.finrank K (LinearMap.range π_P) = 2 := by
          rw [hrange_top, finrank_top, Module.finrank_prod, Module.finrank_self]
        change Module.finrank K (LinearMap.range π_P) + Module.finrank K W_perp = 2 * (r' + 1) at hrk
        omega
      let B' : W_perp →ₗ[K] W_perp →ₗ[K] K :=
        { toFun := fun x => (B x.1).comp W_perp.subtype
          map_add' := fun x y => by ext z; simp
          map_smul' := fun c x => by ext z; simp }
      have hnondeg_W : ∀ z : W_perp, (∀ y : W_perp, B' z y = 0) → z = 0 := by
        intro z hz
        apply Subtype.ext
        apply hnondeg z.1
        intro v
        let pv : V := lift_P (B u₀ v) (B w₀ v)
        have hsub_mem : v - pv ∈ W_perp := by
          rw [LinearMap.mem_ker, LinearMap.prod_apply, Prod.ext_iff]
          dsimp
          rw [map_sub, map_sub, hlift_u₀, hlift_w₀, sub_self, sub_self]
          exact ⟨rfl, rfl⟩
        have hz_mem := LinearMap.mem_ker.mp z.2
        rw [LinearMap.prod_apply, Prod.ext_iff] at hz_mem
        have hzu : B z.1 u₀ = 0 := (hsymm z.1 u₀).trans hz_mem.1
        have hzw : B z.1 w₀ = 0 := (hsymm z.1 w₀).trans hz_mem.2
        have hz_pv : B z.1 pv = 0 := by
          dsimp [pv, lift_P]
          rw [map_add, map_smul, map_smul, hzu, hzw, smul_zero, smul_zero, add_zero]
        have hz_sub : B z.1 (v - pv) = 0 := hz ⟨v - pv, hsub_mem⟩
        have hv_split : v = (v - pv) + pv := (sub_add_cancel v pv).symm
        rw [hv_split, map_add, hz_sub, hz_pv, add_zero]
      obtain ⟨u', w', hortho', hdisc'⟩ :=
        ih W_perp hdim_W (fun x => q x.1) B'
          (fun c x => hq_smul c x.1)
          (fun x y => hpolar x.1 y.1)
          (fun x y => hsymm x.1 y.1)
          hnondeg_W
      let u : Fin (r' + 1) → V := Fin.cases u₀ (fun k => (u' k).1)
      let w : Fin (r' + 1) → V := Fin.cases w₀ (fun k => (w' k).1)
      refine ⟨u, w, ?_, ?_⟩
      · intro j j'
        refine Fin.cases ?_ ?_ j
        · refine Fin.cases ?_ ?_ j'
          · intro hne; exact False.elim (hne rfl)
          · intro k' _
            have hu'_mem := LinearMap.mem_ker.mp (u' k').2
            rw [LinearMap.prod_apply, Prod.ext_iff] at hu'_mem
            have hw'_mem := LinearMap.mem_ker.mp (w' k').2
            rw [LinearMap.prod_apply, Prod.ext_iff] at hw'_mem
            simp only [u, w, Fin.cases_zero, Fin.cases_succ]
            exact ⟨hu'_mem.1, hw'_mem.1, hu'_mem.2, hw'_mem.2⟩
        · intro k
          refine Fin.cases ?_ ?_ j'
          · intro _
            have hu_mem := LinearMap.mem_ker.mp (u' k).2
            rw [LinearMap.prod_apply, Prod.ext_iff] at hu_mem
            have hw_mem := LinearMap.mem_ker.mp (w' k).2
            rw [LinearMap.prod_apply, Prod.ext_iff] at hw_mem
            simp only [u, w, Fin.cases_zero, Fin.cases_succ]
            exact ⟨(hsymm _ _).trans hu_mem.1, (hsymm _ _).trans hu_mem.2,
              (hsymm _ _).trans hw_mem.1, (hsymm _ _).trans hw_mem.2⟩
          · intro k' hne
            have hkk' : k ≠ k' := fun h => hne (congrArg Fin.succ h)
            simp only [u, w, Fin.cases_succ]
            exact hortho' k k' hkk'
      · intro j
        refine Fin.cases ?_ ?_ j
        · simp only [u, w, Fin.cases_zero, hdisc_B]
          exact hΔ₀
        · intro k
          simp only [u, w, Fin.cases_succ]
          exact hdisc' k

  have hBinarySplit : ∀ (a b c : F), 4 * a * c - b ^ 2 ≠ 0 →
      ∃ p r p' r' : F₂, ∀ x y : F₂,
        algebraMap F F₂ a * (p * x + r * y) ^ 2 +
          algebraMap F F₂ b * (p * x + r * y) * (p' * x + r' * y) +
          algebraMap F F₂ c * (p' * x + r' * y) ^ 2 = x * y := by
    clear * - hdeg₂
    intro a b c hdisc
    let a₂ : F₂ := algebraMap F F₂ a
    let b₂ : F₂ := algebraMap F F₂ b
    let c₂ : F₂ := algebraMap F F₂ c
    by_cases ha : a = 0
    · have hb : b ≠ 0 := by
        intro hb0
        apply hdisc
        rw [ha, hb0]
        ring
      have hb₂ : b₂ ≠ 0 := (map_ne_zero (algebraMap F F₂)).mpr hb
      have ha₂ : a₂ = 0 := by simp [a₂, ha]
      refine ⟨b₂⁻¹, -b₂⁻¹ * c₂, 0, 1, fun x y => ?_⟩
      change a₂ * (b₂⁻¹ * x + (-b₂⁻¹ * c₂) * y) ^ 2 +
          b₂ * (b₂⁻¹ * x + (-b₂⁻¹ * c₂) * y) * (0 * x + 1 * y) +
          c₂ * (0 * x + 1 * y) ^ 2 = x * y
      rw [ha₂]
      calc (0 : F₂) * (b₂⁻¹ * x + (-b₂⁻¹ * c₂) * y) ^ 2 +
            b₂ * (b₂⁻¹ * x + (-b₂⁻¹ * c₂) * y) * (0 * x + 1 * y) +
            c₂ * (0 * x + 1 * y) ^ 2
          = (b₂ * b₂⁻¹) * (x - c₂ * y) * y + c₂ * y ^ 2 := by ring
        _ = x * y := by rw [mul_inv_cancel₀ hb₂]; ring
    · have ha₂ : a₂ ≠ 0 := (map_ne_zero (algebraMap F F₂)).mpr ha
      let β : F := a⁻¹ * b
      let γ : F := a⁻¹ * c
      let f : Polynomial F := Polynomial.X ^ 2 + Polynomial.C β * Polynomial.X + Polynomial.C γ
      have hf_deg1 : (Polynomial.X ^ 2 + Polynomial.C β * Polynomial.X : Polynomial F).natDegree = 2 := by
        rw [Polynomial.natDegree_add_eq_left_of_natDegree_lt, Polynomial.natDegree_X_pow]
        calc (Polynomial.C β * Polynomial.X).natDegree
            ≤ (Polynomial.C β).natDegree + (Polynomial.X : Polynomial F).natDegree :=
              Polynomial.natDegree_mul_le
          _ = 0 + 1 := by rw [Polynomial.natDegree_C, Polynomial.natDegree_X]
          _ < (Polynomial.X ^ 2 : Polynomial F).natDegree := by
              rw [Polynomial.natDegree_X_pow]; decide
      have hf_deg : f.natDegree = 2 := by
        dsimp [f]
        rw [Polynomial.natDegree_add_eq_left_of_natDegree_lt, hf_deg1]
        rw [hf_deg1, Polynomial.natDegree_C]
        decide
      have hf_mon : f.Monic := by
        rw [Polynomial.Monic, Polynomial.leadingCoeff, hf_deg]
        simp [f]
      have hex_root : ∃ α₁ : F₂, α₁ ^ 2 + algebraMap F F₂ β * α₁ + algebraMap F F₂ γ = 0 := by
        by_cases hrootF : ∃ r₀ : F, f.eval r₀ = 0
        · obtain ⟨r₀, hr₀⟩ := hrootF
          simp only [f, Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_mul,
            Polynomial.eval_X, Polynomial.eval_C] at hr₀
          refine ⟨algebraMap F F₂ r₀, ?_⟩
          simpa only [map_add, map_pow, map_mul, map_zero] using congrArg (algebraMap F F₂) hr₀
        · classical
          have hno_root : ∀ r₀ : F, f.eval r₀ ≠ 0 := fun r₀ h => hrootF ⟨r₀, h⟩
          have hf_irr : Irreducible f := by
            rw [hf_mon.irreducible_iff_natDegree']
            refine ⟨?_, ?_⟩
            · intro h1
              have hd := congrArg Polynomial.natDegree h1
              rw [hf_deg, Polynomial.natDegree_one] at hd
              omega
            · intro g₁ g₂ _ hg₂ hg₁₂ hmem
              rw [hf_deg] at hmem
              have hg₂_deg : g₂.natDegree = 1 := by
                simp only [Finset.mem_Ioc] at hmem
                omega
              have hroot : f.eval (-g₂.coeff 0) = 0 := by
                rw [← hg₁₂, Polynomial.eval_mul]
                have hg₂_ev : g₂.eval (-g₂.coeff 0) = 0 := by
                  conv_lhs => rw [Polynomial.eq_X_add_C_of_natDegree_le_one hg₂_deg.le]
                  have hlc : g₂.coeff 1 = 1 := by
                    have h := hg₂.leadingCoeff
                    rwa [Polynomial.leadingCoeff, hg₂_deg] at h
                  simp [hlc]
                rw [hg₂_ev, mul_zero]
              exact hno_root (-g₂.coeff 0) hroot
          have : Fact (Irreducible f) := ⟨hf_irr⟩
          let pb : PowerBasis F (AdjoinRoot f) := AdjoinRoot.powerBasis' hf_mon
          have : FiniteDimensional F (AdjoinRoot f) := PowerBasis.finite pb
          have : Finite (AdjoinRoot f) := Module.finite_of_finite F
          have : Finite F₂ := Module.finite_of_finite F
          let q₂ := Nat.card F₂
          have hcard_F : 2 ≤ Nat.card F := Finite.one_lt_card
          have hq₂_eq : q₂ = Nat.card F ^ 2 := by
            dsimp [q₂]
            rw [Module.natCard_eq_pow_finrank (K := F) (V := F₂), hdeg₂]
          have hq₂_ge : 4 ≤ q₂ := by
            rw [hq₂_eq]
            calc 4 = 2 ^ 2 := rfl
              _ ≤ Nat.card F ^ 2 := Nat.pow_le_pow_left hcard_F 2
          have hcard_AR : Nat.card (AdjoinRoot f) = q₂ := by
            rw [Module.natCard_eq_pow_finrank (K := F) (V := AdjoinRoot f),
              pb.finrank, AdjoinRoot.powerBasis'_dim, hf_deg, hq₂_eq]
          let _ : Fintype (AdjoinRoot f) := Fintype.ofFinite (AdjoinRoot f)
          let _ : Fintype F₂ := Fintype.ofFinite F₂
          have hfintype_AR : Fintype.card (AdjoinRoot f) = q₂ :=
            Nat.card_eq_fintype_card.symm.trans hcard_AR
          have hfintype_F₂ : Fintype.card F₂ = q₂ := Nat.card_eq_fintype_card.symm
          have hpow_AR : (AdjoinRoot.root f) ^ q₂ = AdjoinRoot.root f := by
            rw [← hfintype_AR]
            exact FiniteField.pow_card (AdjoinRoot.root f)
          have hmk_zero : AdjoinRoot.mk f (Polynomial.X ^ q₂ - Polynomial.X) = 0 := by
            rw [map_sub, map_pow, AdjoinRoot.mk_X, hpow_AR, sub_self]
          obtain ⟨h₀, hh₀⟩ := AdjoinRoot.mk_eq_zero.mp hmk_zero
          let f₂ : Polynomial F₂ := f.map (algebraMap F F₂)
          let h₂ : Polynomial F₂ := h₀.map (algebraMap F F₂)
          let G₂ : Polynomial F₂ := Polynomial.X ^ q₂ - Polynomial.X
          have hG₂_eq : G₂ = f₂ * h₂ := by
            have hm := congrArg (Polynomial.map (algebraMap F F₂)) hh₀
            simpa only [G₂, f₂, h₂, Polynomial.map_sub, Polynomial.map_pow,
              Polynomial.map_X, Polynomial.map_mul] using hm
          have hG₂_deg : G₂.natDegree = q₂ := by
            dsimp [G₂]
            rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt, Polynomial.natDegree_X_pow]
            rw [Polynomial.natDegree_X, Polynomial.natDegree_X_pow]
            omega
          have hG₂_ne : G₂ ≠ 0 := by
            intro h0
            rw [h0, Polynomial.natDegree_zero] at hG₂_deg
            omega
          have hf₂_ne : f₂ ≠ 0 := left_ne_zero_of_mul (hG₂_eq ▸ hG₂_ne)
          have hh₂_ne : h₂ ≠ 0 := right_ne_zero_of_mul (hG₂_eq ▸ hG₂_ne)
          have hf₂_deg : f₂.natDegree = 2 := (hf_mon.natDegree_map (algebraMap F F₂)).trans hf_deg
          have hh₂_deg : h₂.natDegree = q₂ - 2 := by
            have hmul := Polynomial.natDegree_mul hf₂_ne hh₂_ne
            rw [← hG₂_eq, hG₂_deg, hf₂_deg] at hmul
            omega
          have hex_f₂ : ∃ α₁ : F₂, f₂.eval α₁ = 0 := by
            by_contra hnone
            have hsub : (Finset.univ : Finset F₂) ⊆ h₂.roots.toFinset := by
              intro z _
              have hGz : G₂.eval z = 0 := by
                simp only [G₂, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X]
                rw [← hfintype_F₂, FiniteField.pow_card z, sub_self]
              rw [hG₂_eq, Polynomial.eval_mul] at hGz
              have hfz : f₂.eval z ≠ 0 := fun h => hnone ⟨z, h⟩
              have hhz : h₂.eval z = 0 := (mul_eq_zero.mp hGz).resolve_left hfz
              exact Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hh₂_ne).mpr hhz)
            have hcard_le : q₂ ≤ q₂ - 2 := by
              calc q₂ = Fintype.card F₂ := hfintype_F₂.symm
                _ = (Finset.univ : Finset F₂).card := rfl
                _ ≤ h₂.roots.toFinset.card := Finset.card_le_card hsub
                _ ≤ h₂.roots.card := Multiset.toFinset_card_le _
                _ ≤ h₂.natDegree := Polynomial.card_roots' h₂
                _ = q₂ - 2 := hh₂_deg
            omega
          obtain ⟨α₁, hα₁⟩ := hex_f₂
          refine ⟨α₁, ?_⟩
          simpa only [f₂, f, Polynomial.map_add, Polynomial.map_pow, Polynomial.map_mul,
            Polynomial.map_X, Polynomial.map_C, Polynomial.eval_add, Polynomial.eval_pow,
            Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_C] using hα₁
      obtain ⟨α₁, hα₁⟩ := hex_root
      let β₂ : F₂ := algebraMap F F₂ β
      let γ₂ : F₂ := algebraMap F F₂ γ
      have hβ₂_eq : β₂ = a₂⁻¹ * b₂ := by simp [β₂, β, a₂, b₂]
      have hγ₂_eq : γ₂ = a₂⁻¹ * c₂ := by simp [γ₂, γ, a₂, c₂]
      have hb₂_eq : b₂ = a₂ * β₂ := by rw [hβ₂_eq, mul_inv_cancel_left₀ ha₂]
      have hc₂_eq : c₂ = a₂ * γ₂ := by rw [hγ₂_eq, mul_inv_cancel_left₀ ha₂]
      have hγ₂_val : γ₂ = -(α₁ ^ 2 + β₂ * α₁) := eq_neg_of_add_eq_zero_right hα₁
      let α₂ : F₂ := -β₂ - α₁
      let δ : F₂ := α₁ - α₂
      have hb₂_vieta : b₂ = -a₂ * (α₁ + α₂) := by
        rw [hb₂_eq]; dsimp [α₂]; ring
      have hc₂_vieta : c₂ = a₂ * α₁ * α₂ := by
        rw [hc₂_eq, hγ₂_val]; dsimp [α₂]; ring
      have hdisc₂ : 4 * a₂ * c₂ - b₂ ^ 2 ≠ 0 := by
        have hm : algebraMap F F₂ (4 * a * c - b ^ 2) = 4 * a₂ * c₂ - b₂ ^ 2 := by
          simp only [map_sub, map_mul, map_pow, map_ofNat, a₂, b₂, c₂]
        rw [← hm]
        exact (map_ne_zero (algebraMap F F₂)).mpr hdisc
      have hδ : δ ≠ 0 := by
        intro hδ0
        have hsq : a₂ ^ 2 * δ ^ 2 = -(4 * a₂ * c₂ - b₂ ^ 2) := by
          rw [hb₂_vieta, hc₂_vieta]; dsimp [δ]; ring
        have h0 : a₂ ^ 2 * δ ^ 2 = 0 := by rw [hδ0]; ring
        rw [h0] at hsq
        exact hdisc₂ (neg_eq_zero.mp hsq.symm)
      let p : F₂ := -α₂ * a₂⁻¹ * δ⁻¹
      let r : F₂ := α₁ * δ⁻¹
      let p' : F₂ := -a₂⁻¹ * δ⁻¹
      let r' : F₂ := δ⁻¹
      refine ⟨p, r, p', r', fun x y => ?_⟩
      set s : F₂ := p * x + r * y
      set t : F₂ := p' * x + r' * y
      have hs₁ : s - α₁ * t = a₂⁻¹ * x := by
        calc s - α₁ * t = (α₁ - α₂) * δ⁻¹ * a₂⁻¹ * x := by dsimp [s, t, p, r, p', r']; ring
          _ = (δ * δ⁻¹) * a₂⁻¹ * x := rfl
          _ = a₂⁻¹ * x := by rw [mul_inv_cancel₀ hδ, one_mul]
      have hs₂ : s - α₂ * t = y := by
        calc s - α₂ * t = (α₁ - α₂) * δ⁻¹ * y := by dsimp [s, t, p, r, p', r']; ring
          _ = (δ * δ⁻¹) * y := rfl
          _ = y := by rw [mul_inv_cancel₀ hδ, one_mul]
      calc a₂ * s ^ 2 + b₂ * s * t + c₂ * t ^ 2
          = a₂ * (s - α₁ * t) * (s - α₂ * t) := by rw [hb₂_vieta, hc₂_vieta]; ring
        _ = (a₂ * a₂⁻¹) * x * y := by rw [hs₁, hs₂]; ring
        _ = x * y := by rw [mul_inv_cancel₀ ha₂, one_mul]

  intro F_split
  have hF_split_homog : F_split ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) F₂ (2 • 1) := by
    rw [MvPolynomial.mem_homogeneousSubmodule]
    refine MvPolynomial.IsHomogeneous.sum _ _ _ fun j _ => ?_
    split_ifs with h
    · have h11 : (1 : ℕ) + 1 = 2 • 1 := rfl
      rw [← h11]
      exact (MvPolynomial.isHomogeneous_X F₂ _).mul (MvPolynomial.isHomogeneous_X F₂ _)
    · exact MvPolynomial.isHomogeneous_zero _ _ _
  refine ⟨?_, ?_⟩
  · refine ⟨hF_split_homog, fun μ hXμ => ?_⟩
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) F₂
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    obtain ⟨e_away, he_mk⟩ := hAwayEquiv F₂ (2 * m + 1) μ hXμ
    obtain ⟨e_elim, he_C⟩ := hDehomQuotEquiv F₂ m μ
    let g₀ := HomogeneousLocalization.Away.mk 𝒜 hXμ 2 F_split hF_split_homog
    let f_dehom : MvPolynomial {a : Fin (2 * m + 1 + 1) // a ≠ μ} F₂ :=
      MvPolynomial.eval₂ MvPolynomial.C
        (fun a => if h : a = μ then 1 else MvPolynomial.X ⟨a, h⟩) F_split
    have hg₀_eq : e_away g₀ = f_dehom := he_mk 2 F_split hF_split_homog
    let I₀ := Ideal.span {g₀}
    let J₀ := Ideal.span {f_dehom}
    have hker_fwd : I₀ ≤ RingHom.ker ((Ideal.Quotient.mk J₀).comp e_away.toRingHom) := by
      rw [Ideal.span_le]
      intro x hx
      change Ideal.Quotient.mk J₀ (e_away x) = 0
      rw [Set.mem_singleton_iff.mp hx, hg₀_eq]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton f_dehom))
    have hker_inv : J₀ ≤ RingHom.ker ((Ideal.Quotient.mk I₀).comp e_away.symm.toRingHom) := by
      rw [Ideal.span_le]
      intro y hy
      change Ideal.Quotient.mk I₀ (e_away.symm y) = 0
      rw [Set.mem_singleton_iff.mp hy, ← hg₀_eq, e_away.symm_apply_apply]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton g₀))
    let q_fwd := Ideal.Quotient.lift I₀ ((Ideal.Quotient.mk J₀).comp e_away.toRingHom) hker_fwd
    let q_inv := Ideal.Quotient.lift J₀ ((Ideal.Quotient.mk I₀).comp e_away.symm.toRingHom) hker_inv
    have hq_fg : q_fwd.comp q_inv = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply RingHom.ext
      intro y
      change Ideal.Quotient.mk J₀ (e_away (e_away.symm y)) = Ideal.Quotient.mk J₀ y
      rw [e_away.apply_symm_apply]
    have hq_gf : q_inv.comp q_fwd = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply RingHom.ext
      intro x
      change Ideal.Quotient.mk I₀ (e_away.symm (e_away x)) = Ideal.Quotient.mk I₀ x
      rw [e_away.symm_apply_apply]
    let e_quot := RingEquiv.ofRingHom q_fwd q_inv hq_fg hq_gf
    let e_μ := e_quot.trans e_elim
    refine ⟨e_μ, fun c => ?_⟩
    change e_elim (Ideal.Quotient.mk J₀ (e_away (HomogeneousLocalization.Away.mk 𝒜 hXμ 0
      (MvPolynomial.C c) (MvPolynomial.isHomogeneous_C _ c)))) = MvPolynomial.C c
    have hC0 : MvPolynomial.C c ∈ 𝒜 (0 • 1) := MvPolynomial.isHomogeneous_C _ c
    have heC := he_mk 0 (MvPolynomial.C c) hC0
    rw [heC, MvPolynomial.eval₂_C]
    exact he_C c
  · let n := 2 * m + 1 + 1
    let H₀ : Matrix (Fin n) (Fin n) F :=
      Matrix.of fun i j => MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q₀))
    obtain ⟨hqF_smul, hpolar_F⟩ := (hHomog2 F n).1 Q₀ hQ_homog
    let B_F : (Fin n → F) →ₗ[F] (Fin n → F) →ₗ[F] F :=
      { toFun := fun u =>
          { toFun := fun v => dotProduct u (H₀.mulVec v)
            map_add' := fun v₁ v₂ => by rw [Matrix.mulVec_add, dotProduct_add]
            map_smul' := fun c v => by rw [Matrix.mulVec_smul, dotProduct_smul]; rfl }
        map_add' := fun u₁ u₂ => LinearMap.ext fun v => add_dotProduct u₁ u₂ (H₀.mulVec v)
        map_smul' := fun c u => LinearMap.ext fun v => smul_dotProduct c u (H₀.mulVec v) }
    have hBF_symm : ∀ u v : Fin n → F, B_F u v = B_F v u := by
      intro u v
      change dotProduct u (H₀.mulVec v) = dotProduct v (H₀.mulVec u)
      rw [← hpolar_F u v, ← hpolar_F v u, add_comm u v]
      ring
    have hBF_nondeg : ∀ u : Fin n → F, (∀ v : Fin n → F, B_F u v = 0) → u = 0 :=
      (Matrix.nondegenerate_def.mp (Matrix.nondegenerate_of_det_ne_zero hQ_det)).1
    have hdim_Fn : Module.finrank F (Fin n → F) = 2 * (m + 1) := by
      rw [Module.finrank_fin_fun]
      dsimp [n]
      omega
    obtain ⟨u_pl, w_pl, hortho, hdisc_j⟩ :=
      hOrthoPlanes F (m + 1) (Fin n → F) hdim_Fn (fun v => MvPolynomial.eval v Q₀)
        B_F hqF_smul hpolar_F hBF_symm hBF_nondeg
    have hsplit_all : ∀ j : Fin (m + 1), ∃ p r p' r' : F₂, ∀ x y : F₂,
        algebraMap F F₂ (MvPolynomial.eval (u_pl j) Q₀) * (p * x + r * y) ^ 2 +
          algebraMap F F₂ (B_F (u_pl j) (w_pl j)) * (p * x + r * y) * (p' * x + r' * y) +
          algebraMap F F₂ (MvPolynomial.eval (w_pl j) Q₀) * (p' * x + r' * y) ^ 2 = x * y :=
      fun j => hBinarySplit _ _ _ (hdisc_j j)
    let p_c : Fin (m + 1) → F₂ := fun j => Classical.choose (hsplit_all j)
    let r_c : Fin (m + 1) → F₂ := fun j => Classical.choose (Classical.choose_spec (hsplit_all j))
    let p'_c : Fin (m + 1) → F₂ := fun j =>
      Classical.choose (Classical.choose_spec (Classical.choose_spec (hsplit_all j)))
    let r'_c : Fin (m + 1) → F₂ := fun j =>
      Classical.choose (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hsplit_all j))))
    have h_plane_eq : ∀ (j : Fin (m + 1)) (x y : F₂),
        algebraMap F F₂ (MvPolynomial.eval (u_pl j) Q₀) * (p_c j * x + r_c j * y) ^ 2 +
          algebraMap F F₂ (B_F (u_pl j) (w_pl j)) * (p_c j * x + r_c j * y) * (p'_c j * x + r'_c j * y) +
          algebraMap F F₂ (MvPolynomial.eval (w_pl j) Q₀) * (p'_c j * x + r'_c j * y) ^ 2 = x * y :=
      fun j => Classical.choose_spec
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hsplit_all j))))
    let Q₂ : MvPolynomial (Fin n) F₂ := MvPolynomial.map (algebraMap F F₂) Q₀
    have hQ₂_homog : Q₂ ∈ MvPolynomial.homogeneousSubmodule (Fin n) F₂ 2 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]
      have hQ₀_h : Q₀.IsHomogeneous 2 := (MvPolynomial.mem_homogeneousSubmodule 2 Q₀).mp hQ_homog
      intro s hs
      apply hQ₀_h
      intro h0
      apply hs
      rw [MvPolynomial.coeff_map, h0, map_zero]
    let H₂ : Matrix (Fin n) (Fin n) F₂ :=
      Matrix.of fun i j => MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q₂))
    obtain ⟨hq₂_smul, hpolar_₂⟩ := (hHomog2 F₂ n).1 Q₂ hQ₂_homog
    have heval_lift : ∀ z : Fin n → F,
        MvPolynomial.eval (fun a => algebraMap F F₂ (z a)) Q₂ =
          algebraMap F F₂ (MvPolynomial.eval z Q₀) := by
      intro z
      rw [MvPolynomial.eval_map]
      let ϕ : MvPolynomial (Fin n) F →+* F₂ := (algebraMap F F₂).comp (MvPolynomial.eval z)
      have hϕ := MvPolynomial.map_mvPolynomial_eq_eval₂ ϕ Q₀
      have hC : ϕ.comp MvPolynomial.C = algebraMap F F₂ := by ext r; simp [ϕ]
      have hX : (fun a => ϕ (MvPolynomial.X a)) = (fun a => algebraMap F F₂ (z a)) := by ext a; simp [ϕ]
      rw [hC, hX] at hϕ
      exact hϕ.symm
    have hpolar_lift : ∀ z z' : Fin n → F,
        dotProduct (fun a => algebraMap F F₂ (z a)) (H₂.mulVec (fun a => algebraMap F F₂ (z' a))) =
          algebraMap F F₂ (B_F z z') := by
      intro z z'
      rw [← hpolar_₂]
      have hadd : (fun a => algebraMap F F₂ (z a)) + (fun a => algebraMap F F₂ (z' a)) =
          (fun a => algebraMap F F₂ ((z + z') a)) := by ext a; simp [map_add]
      rw [hadd, heval_lift, heval_lift, heval_lift, ← map_sub, ← map_sub, hpolar_F]
      rfl
    let u₂ : Fin (m + 1) → (Fin n → F₂) := fun j a => algebraMap F F₂ (u_pl j a)
    let w₂ : Fin (m + 1) → (Fin n → F₂) := fun j a => algebraMap F F₂ (w_pl j a)
    have hplane_val : ∀ (j : Fin (m + 1)) (x y : F₂),
        MvPolynomial.eval ((p_c j * x + r_c j * y) • u₂ j + (p'_c j * x + r'_c j * y) • w₂ j) Q₂ =
          x * y := by
      intro j x y
      set s := p_c j * x + r_c j * y
      set t := p'_c j * x + r'_c j * y
      have hp := hpolar_₂ (s • u₂ j) (t • w₂ j)
      have hval : MvPolynomial.eval (s • u₂ j + t • w₂ j) Q₂ =
          MvPolynomial.eval (s • u₂ j) Q₂ + MvPolynomial.eval (t • w₂ j) Q₂ +
            dotProduct (s • u₂ j) (H₂.mulVec (t • w₂ j)) := by
        rw [← hp]; ring
      rw [hval, hq₂_smul, hq₂_smul, smul_dotProduct, Matrix.mulVec_smul, dotProduct_smul,
        smul_eq_mul, smul_eq_mul, heval_lift, heval_lift, hpolar_lift]
      calc s ^ 2 * algebraMap F F₂ (MvPolynomial.eval (u_pl j) Q₀) +
            t ^ 2 * algebraMap F F₂ (MvPolynomial.eval (w_pl j) Q₀) +
            s * (t * algebraMap F F₂ (B_F (u_pl j) (w_pl j)))
          = algebraMap F F₂ (MvPolynomial.eval (u_pl j) Q₀) * s ^ 2 +
            algebraMap F F₂ (B_F (u_pl j) (w_pl j)) * s * t +
            algebraMap F F₂ (MvPolynomial.eval (w_pl j) Q₀) * t ^ 2 := by ring
        _ = x * y := h_plane_eq j x y
    have hplane_ortho : ∀ (j j' : Fin (m + 1)), j ≠ j' → ∀ (s t s' t' : F₂),
        dotProduct (s • u₂ j + t • w₂ j) (H₂.mulVec (s' • u₂ j' + t' • w₂ j')) = 0 := by
      intro j j' hne s t s' t'
      obtain ⟨h1, h2, h3, h4⟩ := hortho j j' hne
      simp only [add_dotProduct, smul_dotProduct, Matrix.mulVec_add, Matrix.mulVec_smul,
        dotProduct_add, dotProduct_smul, smul_eq_mul, u₂, w₂, hpolar_lift,
        h1, h2, h3, h4, map_zero, mul_zero, add_zero]
    let v_col : Fin n → (Fin n → F₂) := fun b =>
      let jb : Fin (m + 1) := ⟨b.1 / 2, by have := b.isLt; dsimp [n] at this; omega⟩
      if b.1 % 2 = 0 then p_c jb • u₂ jb + p'_c jb • w₂ jb
      else r_c jb • u₂ jb + r'_c jb • w₂ jb
    let M : Matrix (Fin n) (Fin n) F₂ := Matrix.of fun a b => v_col b a
    let pairEquiv : Fin (m + 1) × Fin 2 ≃ Fin n :=
      { toFun := fun ⟨j, c⟩ => ⟨2 * j.1 + c.1, by have := j.isLt; have := c.isLt; dsimp [n]; omega⟩
        invFun := fun b => (⟨b.1 / 2, by have := b.isLt; dsimp [n] at this; omega⟩, ⟨b.1 % 2, by omega⟩)
        left_inv := fun ⟨j, c⟩ => by
          ext <;> dsimp <;> have := j.isLt <;> have := c.isLt <;> omega
        right_inv := fun b => by
          ext; dsimp; have := b.isLt; omega }
    let z_plane : (Fin n → F₂) → Fin (m + 1) → (Fin n → F₂) := fun x j =>
      (p_c j * x ⟨2 * j.1, by have := j.isLt; dsimp [n]; omega⟩ +
        r_c j * x ⟨2 * j.1 + 1, by have := j.isLt; dsimp [n]; omega⟩) • u₂ j +
      (p'_c j * x ⟨2 * j.1, by have := j.isLt; dsimp [n]; omega⟩ +
        r'_c j * x ⟨2 * j.1 + 1, by have := j.isLt; dsimp [n]; omega⟩) • w₂ j
    have hmulVec_eq : ∀ x : Fin n → F₂, M.mulVec x = ∑ j : Fin (m + 1), z_plane x j := by
      intro x
      ext a
      simp only [Matrix.mulVec, dotProduct, M, Matrix.of_apply, Finset.sum_apply]
      rw [← Equiv.sum_comp pairEquiv (fun b => v_col b a * x b), Fintype.sum_prod_type]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Fin.sum_univ_two]
      have hev_div : (2 * j.1) / 2 = j.1 := by omega
      have hev_mod : (2 * j.1) % 2 = 0 := by omega
      have hod_div : (2 * j.1 + 1) / 2 = j.1 := by omega
      have hod_mod : (2 * j.1 + 1) % 2 ≠ 0 := by omega
      have hjb0 : (⟨(2 * j.1) / 2, by omega⟩ : Fin (m + 1)) = j := Fin.ext hev_div
      have hjb1 : (⟨(2 * j.1 + 1) / 2, by omega⟩ : Fin (m + 1)) = j := Fin.ext hod_div
      have hv0 : v_col (pairEquiv (j, 0)) a = p_c j * u₂ j a + p'_c j * w₂ j a := by
        dsimp [v_col, pairEquiv]
        simp [hev_mod, Pi.add_apply, Pi.smul_apply]
      have hv1 : v_col (pairEquiv (j, 1)) a = r_c j * u₂ j a + r'_c j * w₂ j a := by
        dsimp [v_col, pairEquiv]
        simp [hjb1, Pi.add_apply, Pi.smul_apply]
      have hx0 : pairEquiv (j, 0) = ⟨2 * j.1, by have := j.isLt; dsimp [n]; omega⟩ := rfl
      have hx1 : pairEquiv (j, 1) = ⟨2 * j.1 + 1, by have := j.isLt; dsimp [n]; omega⟩ := rfl
      rw [hv0, hv1, hx0, hx1]
      simp only [z_plane, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      ring
    have heval_sum_planes : ∀ (x : Fin n → F₂) (T : Finset (Fin (m + 1))),
        MvPolynomial.eval (∑ j ∈ T, z_plane x j) Q₂ =
          ∑ j ∈ T, MvPolynomial.eval (z_plane x j) Q₂ := by
      intro x T
      induction T using Finset.induction_on with
      | empty =>
        have h0 := hq₂_smul 0 0
        simp only [zero_smul, sq, zero_mul] at h0
        simpa only [Finset.sum_empty] using h0
      | @insert j T hj ih =>
        rw [Finset.sum_insert hj, Finset.sum_insert hj]
        have hp := hpolar_₂ (z_plane x j) (∑ j' ∈ T, z_plane x j')
        have horth_sum : dotProduct (z_plane x j) (H₂.mulVec (∑ j' ∈ T, z_plane x j')) = 0 := by
          rw [Matrix.mulVec_sum, dotProduct_sum]
          refine Finset.sum_eq_zero fun j' hj' => ?_
          have hjj' : j ≠ j' := fun h => hj (h ▸ hj')
          exact hplane_ortho j j' hjj' _ _ _ _
        rw [horth_sum] at hp
        have hadd : MvPolynomial.eval (z_plane x j + ∑ j' ∈ T, z_plane x j') Q₂ =
            MvPolynomial.eval (z_plane x j) Q₂ + MvPolynomial.eval (∑ j' ∈ T, z_plane x j') Q₂ := by
          linear_combination hp
        rw [hadd, ih]
    have hF_split_eval : ∀ x : Fin n → F₂,
        MvPolynomial.eval x F_split =
          ∑ j : Fin (m + 1),
            x ⟨2 * j.1, by have := j.isLt; dsimp [n]; omega⟩ *
              x ⟨2 * j.1 + 1, by have := j.isLt; dsimp [n]; omega⟩ := by
      intro x
      dsimp [F_split]
      rw [map_sum, ← Fin.sum_univ_eq_sum_range]
      refine Finset.sum_congr rfl fun j _ => ?_
      have hj_lt : 2 * j.1 + 1 < 2 * m + 1 + 1 := by omega
      rw [dite_eq_left_of_eq_true (eq_true hj_lt), map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X]
    have heval_M : ∀ x : Fin n → F₂,
        MvPolynomial.eval (M.mulVec x) Q₂ = MvPolynomial.eval x F_split := by
      intro x
      rw [hmulVec_eq x, heval_sum_planes x Finset.univ, hF_split_eval x]
      refine Finset.sum_congr rfl fun j _ => hplane_val j _ _
    let P_lhs : MvPolynomial (Fin n) F₂ :=
      MvPolynomial.eval₂ (MvPolynomial.C.comp (algebraMap F F₂))
        (fun a => ∑ b : Fin n, MvPolynomial.C (M a b) * MvPolynomial.X b) Q₀
    have hPlhs_homog : P_lhs ∈ MvPolynomial.homogeneousSubmodule (Fin n) F₂ 2 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]
      have hQ₀_h : Q₀.IsHomogeneous 2 := (MvPolynomial.mem_homogeneousSubmodule 2 Q₀).mp hQ_homog
      have h12 : 1 * 2 = 2 := rfl
      rw [← h12]
      refine hQ₀_h.eval₂ _ _ (fun r => MvPolynomial.isHomogeneous_C _ _) (fun a => ?_)
      refine MvPolynomial.IsHomogeneous.sum _ _ _ fun b _ => ?_
      have h01 : 0 + 1 = 1 := rfl
      rw [← h01]
      exact (MvPolynomial.isHomogeneous_C _ (M a b)).mul (MvPolynomial.isHomogeneous_X F₂ b)
    have heval_Plhs : ∀ x : Fin n → F₂,
        MvPolynomial.eval x P_lhs = MvPolynomial.eval x F_split := by
      intro x
      dsimp [P_lhs]
      rw [MvPolynomial.eval_eval₂]
      have hC_eq : (MvPolynomial.eval x).comp (MvPolynomial.C.comp (algebraMap F F₂)) =
          algebraMap F F₂ := by ext r; simp
      have hX_eq : (fun a => MvPolynomial.eval x
          (∑ b : Fin n, MvPolynomial.C (M a b) * MvPolynomial.X b)) = M.mulVec x := by
        ext a
        simp [Matrix.mulVec, dotProduct]
      rw [hC_eq, hX_eq, ← MvPolynomial.eval_map]
      exact heval_M x
    have hF_split_h2 : F_split ∈ MvPolynomial.homogeneousSubmodule (Fin n) F₂ 2 := by
      simpa using hF_split_homog
    have hPlhs_eq : P_lhs = F_split :=
      (hHomog2 F₂ n).2 P_lhs F_split hPlhs_homog hF_split_h2 heval_Plhs
    let τ_swap : Fin n → Fin n := fun b =>
      ⟨if b.1 % 2 = 0 then b.1 + 1 else b.1 - 1, by have := b.isLt; dsimp [n] at this ⊢; split_ifs <;> omega⟩
    have hτ_inv : ∀ b : Fin n, τ_swap (τ_swap b) = b := by
      intro b
      ext
      have hb_lt := b.isLt
      dsimp [n] at hb_lt
      dsimp [τ_swap]
      split_ifs <;> omega
    let J_split : Matrix (Fin n) (Fin n) F₂ :=
      Matrix.of fun b b' => if b' = τ_swap b then 1 else 0
    have hJ_sq : J_split * J_split = 1 := by
      ext b b'
      simp only [J_split, Matrix.mul_apply, Matrix.of_apply, Matrix.one_apply]
      rw [Finset.sum_eq_single (τ_swap b)]
      · simp only [↓reduceIte, one_mul, hτ_inv, eq_comm]
      · intro k _ hk
        simp [hk]
      · intro hnot
        exact False.elim (hnot (Finset.mem_univ _))
    have hpolar_Fsplit : ∀ x y : Fin n → F₂,
        MvPolynomial.eval (x + y) F_split - MvPolynomial.eval x F_split - MvPolynomial.eval y F_split =
          ∑ b₀ : Fin n, x b₀ * y (τ_swap b₀) := by
      intro x y
      rw [hF_split_eval (x + y), hF_split_eval x, hF_split_eval y,
        ← Equiv.sum_comp pairEquiv (fun b₀ => x b₀ * y (τ_swap b₀)), Fintype.sum_prod_type]
      rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Fin.sum_univ_two]
      have hp0 : pairEquiv (j, 0) = ⟨2 * j.1, by have := j.isLt; dsimp [n]; omega⟩ := rfl
      have hp1 : pairEquiv (j, 1) = ⟨2 * j.1 + 1, by have := j.isLt; dsimp [n]; omega⟩ := rfl
      have hτ0 : τ_swap ⟨2 * j.1, by have := j.isLt; dsimp [n]; omega⟩ =
          ⟨2 * j.1 + 1, by have := j.isLt; dsimp [n]; omega⟩ := by
        ext; dsimp [τ_swap]; split_ifs <;> omega
      have hτ1 : τ_swap ⟨2 * j.1 + 1, by have := j.isLt; dsimp [n]; omega⟩ =
          ⟨2 * j.1, by have := j.isLt; dsimp [n]; omega⟩ := by
        ext; dsimp [τ_swap]; split_ifs <;> omega
      rw [hp0, hp1, hτ0, hτ1]
      simp only [Pi.add_apply]
      ring
    have hMHM : M.transpose * H₂ * M = J_split := by
      ext b b'
      let e_b : Fin n → F₂ := Pi.single b 1
      let e_b' : Fin n → F₂ := Pi.single b' 1
      have hentry : (M.transpose * H₂ * M) b b' =
          dotProduct (M.mulVec e_b) (H₂.mulVec (M.mulVec e_b')) := by
        have hcol_b : M.mulVec e_b = fun i => M i b := by
          ext i; simp [e_b, Matrix.mulVec, dotProduct, Pi.single_apply]
        have hcol_b' : M.mulVec e_b' = fun k => M k b' := by
          ext k; simp [e_b', Matrix.mulVec, dotProduct, Pi.single_apply]
        rw [hcol_b, hcol_b']
        simp only [Matrix.mul_apply, Matrix.transpose_apply, dotProduct, Matrix.mulVec,
          Finset.sum_mul, Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun k _ => ?_
        ring
      rw [hentry, ← hpolar_₂, ← Matrix.mulVec_add, heval_M, heval_M, heval_M, hpolar_Fsplit]
      rw [Finset.sum_eq_single b]
      · simp only [e_b, e_b', Pi.single_eq_same, one_mul, J_split, Matrix.of_apply, Pi.single_apply]
        by_cases hswap : τ_swap b = b'
        · subst hswap; simp
        · simp [hswap, Ne.symm hswap]
      · intro b₀ _ hb₀
        simp [e_b, Pi.single_eq_of_ne hb₀]
      · intro hnot
        exact False.elim (hnot (Finset.mem_univ b))
    let N : Matrix (Fin n) (Fin n) F₂ := J_split * M.transpose * H₂
    have hNM : N * M = 1 := by
      calc N * M = J_split * (M.transpose * H₂ * M) := by
            dsimp [N]; simp only [Matrix.mul_assoc]
        _ = J_split * J_split := by rw [hMHM]
        _ = 1 := hJ_sq
    have hMN : M * N = 1 := by
      have hdet : N.det * M.det = 1 := by rw [← Matrix.det_mul, hNM, Matrix.det_one]
      have hM_unit : IsUnit M.det := isUnit_iff_ne_zero.mpr (right_ne_zero_of_mul_eq_one hdet)
      have hN_eq : N = M⁻¹ := by
        calc N = N * (M * M⁻¹) := by rw [Matrix.mul_nonsing_inv M hM_unit, Matrix.mul_one]
          _ = (N * M) * M⁻¹ := (Matrix.mul_assoc N M M⁻¹).symm
          _ = M⁻¹ := by rw [hNM, Matrix.one_mul]
      rw [hN_eq]
      exact Matrix.mul_nonsing_inv M hM_unit
    exact ⟨M, N, hMN, hNM, hPlhs_eq⟩

theorem weil_rees_fiber_proj_gluing_and_hypersurface_pullback (K : Type u) [Field K]
    (M₀ d_Q : ℕ)
    (A : Type u) [CommRing A] [IsDomain A]
    (alg_A : K →+* A)
    (ε : A →+* K) (hε_id : ε.comp alg_A = RingHom.id K)
    (g : Fin (M₀ + 1) → A)
    (hg_nz : ∀ b : Fin (M₀ + 1), g b ≠ 0)
    (hKer_ε : RingHom.ker ε = Ideal.span (Set.range g))
    (F_hom : MvPolynomial (Fin (M₀ + 1)) K)
    (hF_hom : F_hom ∈ MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) K (2 • 1))
    (hChartSmooth : ∀ (μ : Fin (M₀ + 1))
        (hXμ : MvPolynomial.X μ ∈ MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) K 1),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) K) :=
        MvPolynomial.gradedAlgebra
      ∃ e_μ : (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) K) (MvPolynomial.X μ) ⧸
          Ideal.span {HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) K)
            hXμ 2 F_hom hF_hom}) ≃+*
          MvPolynomial (Fin d_Q) K,
        ∀ c : K,
          e_μ (Ideal.Quotient.mk _
            (HomogeneousLocalization.Away.mk
              (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) K)
              hXμ 0 (MvPolynomial.C c) (MvPolynomial.isHomogeneous_C _ c))) =
            MvPolynomial.C c)
    (hReesRel : ∀ (b : Fin (M₀ + 1)),
      let R_b := Algebra.adjoin A
        (Set.range fun a : Fin (M₀ + 1) =>
          IsLocalization.mk' (Localization.Away (g b)) (g a)
            ⟨g b, Submonoid.mem_powers (g b)⟩)
      ∀ (d : ℕ) (P : MvPolynomial (Fin (M₀ + 1)) K),
        P ∈ MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) K d →
        (MvPolynomial.eval₂ ((algebraMap A ↥R_b).comp alg_A)
          (fun a => ⟨IsLocalization.mk' (Localization.Away (g b)) (g a)
            ⟨g b, Submonoid.mem_powers (g b)⟩, Algebra.subset_adjoin ⟨a, rfl⟩⟩) P ∈
            Ideal.map (algebraMap A ↥R_b) (RingHom.ker ε) ↔
        MvPolynomial.eval₂ MvPolynomial.C
          (fun a => if a = b then 1 else MvPolynomial.X a) P ∈
          Ideal.span {MvPolynomial.eval₂ MvPolynomial.C
            (fun a => if a = b then 1 else MvPolynomial.X a) F_hom}))
    (P_sch : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral P_sch] [P_sch.IsSeparated]
    (π_P : P_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
    (hIso_away : ∀ b : Fin (M₀ + 1),
      CategoryTheory.IsIso (π_P ∣_ PrimeSpectrum.basicOpen (g b)))
    (W : Fin (M₀ + 1) → P_sch.Opens)
    (isoW : ∀ b : Fin (M₀ + 1), (W b).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
      ↥(Algebra.adjoin A (Set.range fun a : Fin (M₀ + 1) =>
        IsLocalization.mk' (Localization.Away (g b)) (g a)
          ⟨g b, Submonoid.mem_powers (g b)⟩))))
    (hW_cov : (⨆ b : Fin (M₀ + 1), W b) = ⊤)
    (hW_proj : ∀ b : Fin (M₀ + 1),
      (W b).ι ≫ π_P =
        (isoW b).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A _)))
    (Q_K : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    (ι_QP : Q_K.left ⟶ P_sch)
    (hPb_Q : CategoryTheory.IsPullback ι_QP Q_K.hom π_P
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε))) :
    AlgebraicGeometry.SmoothOfRelativeDimension d_Q Q_K.hom ∧
    ∃ ι_Q : Q_K.left ⟶ (weilProjectiveSpaceOver K M₀).left,
      ι_Q ≫ (weilProjectiveSpaceOver K M₀).hom = Q_K.hom ∧
      IsHomogeneousHypersurfacePullbackOver K M₀ 2
        (𝟙 (weilProjectiveSpaceOver K M₀)) F_hom ι_Q :=
by
  classical
  have _ := hKer_ε
  
  
  
  let L := FractionRing A
  have hInj_AL : Function.Injective (algebraMap A L) := IsFractionRing.injective A L
  have hg_L_nz : ∀ b : Fin (M₀ + 1), algebraMap A L (g b) ≠ 0 :=
    fun b h0 => hg_nz b (hInj_AL (h0.trans (map_zero (algebraMap A L)).symm))

  let R_b (b : Fin (M₀ + 1)) : Subalgebra A (Localization.Away (g b)) :=
    Algebra.adjoin A (Set.range fun a : Fin (M₀ + 1) =>
      IsLocalization.mk' (Localization.Away (g b)) (g a) ⟨g b, Submonoid.mem_powers (g b)⟩)
  let u (b a : Fin (M₀ + 1)) : ↥(R_b b) :=
    ⟨IsLocalization.mk' (Localization.Away (g b)) (g a) ⟨g b, Submonoid.mem_powers (g b)⟩,
      Algebra.subset_adjoin ⟨a, rfl⟩⟩
  let I_b (b : Fin (M₀ + 1)) : Ideal ↥(R_b b) :=
    Ideal.map (algebraMap A ↥(R_b b)) (RingHom.ker ε)

  
  have hPullbackHom : ∀ {R₀ S₀ : Type u} [NonAssocSemiring R₀] [NonAssocSemiring S₀]
      (j : S₀ →+* L) (hj : Function.Injective j) (f : R₀ →+* L)
      (hf : ∀ r : R₀, ∃ s : S₀, j s = f r),
      ∃ f_lift : R₀ →+* S₀, j.comp f_lift = f := by
    intro R₀ S₀ _ _ j hj f hf
    refine ⟨
      { toFun := fun r => (hf r).choose
        map_one' := hj (by rw [(hf 1).choose_spec, map_one, map_one])
        map_mul' := fun x y => hj (by
          rw [(hf (x * y)).choose_spec, map_mul, map_mul, (hf x).choose_spec, (hf y).choose_spec])
        map_zero' := hj (by rw [(hf 0).choose_spec, map_zero, map_zero])
        map_add' := fun x y => hj (by
          rw [(hf (x + y)).choose_spec, map_add, map_add,
            (hf x).choose_spec, (hf y).choose_spec]) }, ?_⟩
    ext r
    exact (hf r).choose_spec

  
  have hAwayLiftPkg : ∀ {D : Type u} [CommRing D] (j_D : D →+* L) (hj_D : Function.Injective j_D)
      (r : D) (hr : j_D r ≠ 0),
      ∃ (j_loc : Localization.Away r →+* L),
        Function.Injective j_loc ∧
        j_loc.comp (algebraMap D (Localization.Away r)) = j_D ∧
        j_loc (IsLocalization.Away.invSelf (S := Localization.Away r) r) = (j_D r)⁻¹ := by
    intro D _ j_D hj_D r hr
    let _ : Algebra D L := j_D.toAlgebra
    have hr_unit : IsUnit (algebraMap D L r) := IsUnit.mk0 (j_D r) hr
    obtain ⟨φ, hφ_eq⟩ : ∃ φ : Localization.Away r →+* L,
        ∀ d : D, φ (algebraMap D (Localization.Away r) d) = j_D d :=
      ⟨IsLocalization.Away.lift (S := Localization.Away r) r hr_unit,
        IsLocalization.Away.lift_eq (S := Localization.Away r) r hr_unit⟩
    have hφ_comp : φ.comp (algebraMap D (Localization.Away r)) = j_D := by
      ext d
      exact hφ_eq d
    have hφ_inv : φ (IsLocalization.Away.invSelf (S := Localization.Away r) r) = (j_D r)⁻¹ := by
      apply mul_left_cancel₀ hr
      rw [mul_inv_cancel₀ hr]
      have hmul : algebraMap D (Localization.Away r) r *
          IsLocalization.Away.invSelf (S := Localization.Away r) r = 1 :=
        IsLocalization.Away.mul_invSelf r
      have hmap := congrArg φ hmul
      rwa [map_mul, map_one, hφ_eq r] at hmap
    have hφ_inj : Function.Injective φ := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨d, s⟩, hds⟩ := IsLocalization.surj (Submonoid.powers r) x
      have hmap := congrArg φ hds
      rw [map_mul, hx, zero_mul, hφ_eq d] at hmap
      have hd0 : d = 0 := hj_D (hmap.symm.trans (map_zero j_D).symm)
      rw [hd0, map_zero] at hds
      exact (IsLocalization.map_units (Localization.Away r) s).mul_left_eq_zero.mp hds
    exact ⟨φ, hφ_inj, hφ_comp, hφ_inv⟩

  
  have hlam_pkg : ∀ b : Fin (M₀ + 1),
      ∃ (lam_b : Localization.Away (g b) →+* L),
        Function.Injective lam_b ∧
        lam_b.comp (algebraMap A (Localization.Away (g b))) = algebraMap A L ∧
        ∀ a : Fin (M₀ + 1),
          lam_b (IsLocalization.mk' (Localization.Away (g b)) (g a) ⟨g b, Submonoid.mem_powers (g b)⟩) =
            algebraMap A L (g a) * (algebraMap A L (g b))⁻¹ := by
    intro b
    obtain ⟨lam_b, hlam_inj, hlam_comp, _⟩ := hAwayLiftPkg (algebraMap A L) hInj_AL (g b) (hg_L_nz b)
    refine ⟨lam_b, hlam_inj, hlam_comp, fun a => ?_⟩
    apply mul_left_cancel₀ (hg_L_nz b)
    have hspec : algebraMap A (Localization.Away (g b)) (g b) *
        IsLocalization.mk' (Localization.Away (g b)) (g a) ⟨g b, Submonoid.mem_powers (g b)⟩ =
        algebraMap A (Localization.Away (g b)) (g a) :=
      IsLocalization.mk'_spec' (Localization.Away (g b)) (g a) ⟨g b, Submonoid.mem_powers (g b)⟩
    have hmap := congrArg lam_b hspec
    rw [map_mul, show lam_b (algebraMap A _ (g b)) = algebraMap A L (g b) from
      RingHom.congr_fun hlam_comp (g b),
      show lam_b (algebraMap A _ (g a)) = algebraMap A L (g a) from
      RingHom.congr_fun hlam_comp (g a)] at hmap
    rw [hmap, mul_comm (algebraMap A L (g a)), ← mul_assoc,
      mul_inv_cancel₀ (hg_L_nz b), one_mul]

  obtain ⟨lam_fn, hlam_spec⟩ := Classical.axiomOfChoice hlam_pkg
  have hlam_inj : ∀ b, Function.Injective (lam_fn b) := fun b => (hlam_spec b).1
  have hlam_comp : ∀ b, (lam_fn b).comp (algebraMap A (Localization.Away (g b))) = algebraMap A L :=
    fun b => (hlam_spec b).2.1
  have hlam_mk : ∀ b a,
      lam_fn b (IsLocalization.mk' (Localization.Away (g b)) (g a) ⟨g b, Submonoid.mem_powers (g b)⟩) =
        algebraMap A L (g a) * (algebraMap A L (g b))⁻¹ :=
    fun b a => (hlam_spec b).2.2 a

  let ι_b : ∀ b : Fin (M₀ + 1), ↥(R_b b) →+* L :=
    fun b => (lam_fn b).comp (R_b b).val.toRingHom
  have hι_inj : ∀ b, Function.Injective (ι_b b) :=
    fun b => (hlam_inj b).comp Subtype.val_injective
  have hDom_Rb : ∀ b : Fin (M₀ + 1), IsDomain ↥(R_b b) :=
    fun b => Function.Injective.isDomain (ι_b b) (hι_inj b)
  haveI : ∀ b : Fin (M₀ + 1), IsDomain ↥(R_b b) := hDom_Rb

  have hι_alg : ∀ b : Fin (M₀ + 1), (ι_b b).comp (algebraMap A ↥(R_b b)) = algebraMap A L := by
    intro b
    ext r
    exact RingHom.congr_fun (hlam_comp b) r
  have hι_u : ∀ b a : Fin (M₀ + 1),
      ι_b b (u b a) = algebraMap A L (g a) * (algebraMap A L (g b))⁻¹ :=
    fun b a => hlam_mk b a
  have hu_nz_L : ∀ b a : Fin (M₀ + 1), ι_b b (u b a) ≠ 0 := by
    intro b a
    rw [hι_u]
    exact mul_ne_zero (hg_L_nz a) (inv_ne_zero (hg_L_nz b))
  have hu_eq : ∀ b b' : Fin (M₀ + 1),
      algebraMap A ↥(R_b b) (g b) * u b b' = algebraMap A ↥(R_b b) (g b') := by
    intro b b'
    apply hι_inj b
    rw [map_mul, show ι_b b (algebraMap A ↥(R_b b) (g b)) = algebraMap A L (g b) from
      RingHom.congr_fun (hι_alg b) (g b),
      show ι_b b (algebraMap A ↥(R_b b) (g b')) = algebraMap A L (g b') from
      RingHom.congr_fun (hι_alg b) (g b'), hι_u]
    rw [mul_comm (algebraMap A L (g b')), ← mul_assoc, mul_inv_cancel₀ (hg_L_nz b), one_mul]

  
  have hι_ov_pkg : ∀ b b' : Fin (M₀ + 1),
      ∃ (ι_ov : Localization.Away (u b b') →+* L),
        Function.Injective ι_ov ∧
        ι_ov.comp (algebraMap ↥(R_b b) (Localization.Away (u b b'))) = ι_b b ∧
        ι_ov (IsLocalization.Away.invSelf (S := Localization.Away (u b b')) (u b b')) =
          algebraMap A L (g b) * (algebraMap A L (g b'))⁻¹ := by
    intro b b'
    obtain ⟨ι_ov, h_inj, h_comp, h_inv⟩ :=
      hAwayLiftPkg (ι_b b) (hι_inj b) (u b b') (hu_nz_L b b')
    refine ⟨ι_ov, h_inj, h_comp, ?_⟩
    rw [h_inv, hι_u, mul_inv_rev, inv_inv]

  obtain ⟨ι_ov, hι_ov_spec⟩ :
      ∃ ι_ov : ∀ b b' : Fin (M₀ + 1), Localization.Away (u b b') →+* L,
        ∀ b b', Function.Injective (ι_ov b b') ∧
          (ι_ov b b').comp (algebraMap ↥(R_b b) (Localization.Away (u b b'))) = ι_b b ∧
          ι_ov b b' (IsLocalization.Away.invSelf (S := Localization.Away (u b b')) (u b b')) =
            algebraMap A L (g b) * (algebraMap A L (g b'))⁻¹ := by
    refine ⟨fun b b' => (hι_ov_pkg b b').choose, fun b b' => (hι_ov_pkg b b').choose_spec⟩
  have hι_ov_inj : ∀ b b', Function.Injective (ι_ov b b') := fun b b' => (hι_ov_spec b b').1
  have hι_ov_comp : ∀ b b',
      (ι_ov b b').comp (algebraMap ↥(R_b b) (Localization.Away (u b b'))) = ι_b b :=
    fun b b' => (hι_ov_spec b b').2.1
  have hι_ov_inv : ∀ b b',
      ι_ov b b' (IsLocalization.Away.invSelf (S := Localization.Away (u b b')) (u b b')) =
        algebraMap A L (g b) * (algebraMap A L (g b'))⁻¹ :=
    fun b b' => (hι_ov_spec b b').2.2
  have hι_ov_alg : ∀ b b' : Fin (M₀ + 1),
      ((ι_ov b b').comp (algebraMap ↥(R_b b) (Localization.Away (u b b')))).comp
        (algebraMap A ↥(R_b b)) = algebraMap A L := by
    intro b b'
    rw [hι_ov_comp, hι_alg]

  have hτ_hom_pkg : ∀ b b' : Fin (M₀ + 1),
      ∃ τ_hom : Localization.Away (u b' b) →+* Localization.Away (u b b'),
        (ι_ov b b').comp τ_hom = ι_ov b' b := by
    intro b b'
    have h_mem : ∀ y : ↥(R_b b'), ∃ s : Localization.Away (u b b'), ι_ov b b' s = ι_b b' y := by
      rintro ⟨y, hy⟩
      induction hy using Algebra.adjoin_induction with
      | mem x hx =>
        rcases hx with ⟨a, rfl⟩
        refine ⟨algebraMap ↥(R_b b) (Localization.Away (u b b')) (u b a) *
          IsLocalization.Away.invSelf (S := Localization.Away (u b b')) (u b b'), ?_⟩
        rw [map_mul, show ι_ov b b' (algebraMap _ _ (u b a)) = ι_b b (u b a) from
          RingHom.congr_fun (hι_ov_comp b b') (u b a), hι_u, hι_ov_inv]
        change algebraMap A L (g a) * (algebraMap A L (g b))⁻¹ *
            (algebraMap A L (g b) * (algebraMap A L (g b'))⁻¹) =
          lam_fn b' (IsLocalization.mk' (Localization.Away (g b')) (g a) ⟨g b', _⟩)
        rw [hlam_mk b' a, mul_assoc, inv_mul_cancel_left₀ (hg_L_nz b)]
      | algebraMap r =>
        refine ⟨algebraMap ↥(R_b b) (Localization.Away (u b b')) (algebraMap A ↥(R_b b) r), ?_⟩
        have h1 := RingHom.congr_fun (hι_ov_alg b b') r
        have h2 := RingHom.congr_fun (hlam_comp b') r
        exact h1.trans h2.symm
      | add x₁ x₂ hx₁ hx₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨s₁, hs₁⟩
        rcases ih₂ with ⟨s₂, hs₂⟩
        refine ⟨s₁ + s₂, ?_⟩
        rw [map_add, hs₁, hs₂]
        exact (map_add (ι_b b') ⟨x₁, hx₁⟩ ⟨x₂, hx₂⟩).symm
      | mul x₁ x₂ hx₁ hx₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨s₁, hs₁⟩
        rcases ih₂ with ⟨s₂, hs₂⟩
        refine ⟨s₁ * s₂, ?_⟩
        rw [map_mul, hs₁, hs₂]
        exact (map_mul (ι_b b') ⟨x₁, hx₁⟩ ⟨x₂, hx₂⟩).symm
    obtain ⟨α, hα⟩ := hPullbackHom (ι_ov b b') (hι_ov_inj b b') (ι_b b') h_mem
    have hα_u : α (u b' b) =
        IsLocalization.Away.invSelf (S := Localization.Away (u b b')) (u b b') := by
      apply hι_ov_inj b b'
      rw [show ι_ov b b' (α (u b' b)) = ι_b b' (u b' b) from RingHom.congr_fun hα (u b' b),
        hι_u, hι_ov_inv]
    let _ : Algebra ↥(R_b b') (Localization.Away (u b b')) := α.toAlgebra
    have hu_unit : IsUnit (algebraMap ↥(R_b b') (Localization.Away (u b b')) (u b' b)) := by
      change IsUnit (α (u b' b))
      rw [hα_u]
      exact IsUnit.of_mul_eq_one (algebraMap ↥(R_b b) _ (u b b'))
        (by rw [mul_comm]; exact IsLocalization.Away.mul_invSelf (u b b'))
    obtain ⟨τ_hom, hτ_eq⟩ :
        ∃ τ_hom : Localization.Away (u b' b) →+* Localization.Away (u b b'),
          ∀ y : ↥(R_b b'), τ_hom (algebraMap ↥(R_b b') (Localization.Away (u b' b)) y) = α y :=
      ⟨IsLocalization.Away.lift (S := Localization.Away (u b' b)) (u b' b) hu_unit,
        IsLocalization.Away.lift_eq (S := Localization.Away (u b' b)) (u b' b) hu_unit⟩
    refine ⟨τ_hom, ?_⟩
    ext x
    obtain ⟨⟨y, s⟩, hys⟩ := IsLocalization.surj (Submonoid.powers (u b' b)) x
    rcases s.2 with ⟨n, hn⟩
    have hs_nz : ι_ov b' b (algebraMap ↥(R_b b') (Localization.Away (u b' b)) (s : ↥(R_b b'))) ≠ 0 := by
      rw [show ι_ov b' b (algebraMap ↥(R_b b') (Localization.Away (u b' b)) (s : ↥(R_b b'))) =
          ι_b b' (s : ↥(R_b b')) from
        RingHom.congr_fun (hι_ov_comp b' b) (s : ↥(R_b b')), ← hn, map_pow]
      exact pow_ne_zero n (hu_nz_L b' b)
    apply mul_right_cancel₀ hs_nz
    have h_s_eq : ι_ov b b' (τ_hom (algebraMap ↥(R_b b') _ (s : ↥(R_b b')))) =
        ι_ov b' b (algebraMap ↥(R_b b') _ (s : ↥(R_b b'))) := by
      rw [hτ_eq (s : ↥(R_b b')),
        show ι_ov b b' (α (s : ↥(R_b b'))) = ι_b b' (s : ↥(R_b b')) from
          RingHom.congr_fun hα (s : ↥(R_b b')),
        show ι_ov b' b (algebraMap ↥(R_b b') _ (s : ↥(R_b b'))) = ι_b b' (s : ↥(R_b b')) from
          RingHom.congr_fun (hι_ov_comp b' b) (s : ↥(R_b b'))]
    have h1 := congrArg (fun w => ι_ov b b' (τ_hom w)) hys
    have h2 := congrArg (ι_ov b' b) hys
    simp only [map_mul] at h1 h2
    rw [RingHom.comp_apply, ← h_s_eq, h1, hτ_eq y,
      show ι_ov b b' (α y) = ι_b b' y from RingHom.congr_fun hα y,
      ← show ι_ov b' b (algebraMap _ _ y) = ι_b b' y from RingHom.congr_fun (hι_ov_comp b' b) y,
      ← h2, h_s_eq]

  obtain ⟨τ, hτ_frac⟩ :
      ∃ τ : ∀ b b' : Fin (M₀ + 1), Localization.Away (u b' b) ≃+* Localization.Away (u b b'),
        ∀ b b', (ι_ov b b').comp (τ b b').toRingHom = ι_ov b' b := by
    let τ_hom : ∀ b b' : Fin (M₀ + 1), Localization.Away (u b' b) →+* Localization.Away (u b b') :=
      fun b b' => (hτ_hom_pkg b b').choose
    have h_fr : ∀ b b', (ι_ov b b').comp (τ_hom b b') = ι_ov b' b :=
      fun b b' => (hτ_hom_pkg b b').choose_spec
    refine ⟨fun b b' =>
      { toFun := τ_hom b b'
        invFun := τ_hom b' b
        left_inv := fun x => hι_ov_inj b' b (by
          have h1 := RingHom.congr_fun (h_fr b' b) (τ_hom b b' x)
          have h2 := RingHom.congr_fun (h_fr b b') x
          exact h1.trans h2)
        right_inv := fun x => hι_ov_inj b b' (by
          have h1 := RingHom.congr_fun (h_fr b b') (τ_hom b' b x)
          have h2 := RingHom.congr_fun (h_fr b' b) x
          exact h1.trans h2)
        map_mul' := (τ_hom b b').map_mul'
        map_add' := (τ_hom b b').map_add' }, h_fr⟩

  
  
  
  let 𝒜_K := MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) K
  letI : GradedAlgebra 𝒜_K := MvPolynomial.gradedAlgebra
  have hX_hom : ∀ b : Fin (M₀ + 1), MvPolynomial.X b ∈ 𝒜_K 1 :=
    fun b => MvPolynomial.isHomogeneous_X K b

  let valHom : ∀ (S : Submonoid (MvPolynomial (Fin (M₀ + 1)) K)),
      HomogeneousLocalization 𝒜_K S →+* Localization S :=
    fun _ =>
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }

  let ev_L : MvPolynomial (Fin (M₀ + 1)) K →+* L :=
    MvPolynomial.eval₂Hom ((algebraMap A L).comp alg_A) (fun a => algebraMap A L (g a))
  let ev_Rb : ∀ b : Fin (M₀ + 1), MvPolynomial (Fin (M₀ + 1)) K →+* ↥(R_b b) :=
    fun b => MvPolynomial.eval₂Hom ((algebraMap A ↥(R_b b)).comp alg_A) (fun a => u b a)

  have hι_ev_Rb : ∀ (b : Fin (M₀ + 1)) (d : ℕ) (P : MvPolynomial (Fin (M₀ + 1)) K),
      P ∈ 𝒜_K d →
      ι_b b (ev_Rb b P) = ev_L P * ((algebraMap A L (g b))⁻¹) ^ d := by
    intro b d P hP
    have hP_hom : MvPolynomial.IsHomogeneous P d :=
      (MvPolynomial.mem_homogeneousSubmodule d P).mp hP
    have hcomp_ev : (ι_b b).comp (ev_Rb b) =
        MvPolynomial.eval₂Hom ((algebraMap A L).comp alg_A)
          (fun a => algebraMap A L (g a) * (algebraMap A L (g b))⁻¹) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [RingHom.comp_apply, ev_Rb, MvPolynomial.eval₂Hom_C]
        exact RingHom.congr_fun (hι_alg b) (alg_A c)
      · intro a
        simp only [RingHom.comp_apply, ev_Rb, MvPolynomial.eval₂Hom_X', hι_u]
    change ((ι_b b).comp (ev_Rb b)) P = ev_L P * ((algebraMap A L (g b))⁻¹) ^ d
    rw [hcomp_ev]
    conv_lhs => rw [P.as_sum]
    conv_rhs => rw [P.as_sum]
    rw [map_sum, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun m hm => ?_
    have hdeg : (∑ a : Fin (M₀ + 1), m a) = d := by
      have hw := hP_hom (MvPolynomial.mem_support_iff.mp hm)
      rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => by simp)] at hw
      simpa only [Pi.one_apply, smul_eq_mul, mul_one] using hw
    simp only [ev_L, MvPolynomial.eval₂Hom_monomial, mul_pow]
    rw [Finsupp.prod_fintype _ _ (fun _ => by simp),
      Finsupp.prod_fintype _ _ (fun _ => by simp),
      Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg, mul_assoc]

  
  have hHomLocFracPkg : ∀ (f : MvPolynomial (Fin (M₀ + 1)) K) (hf_nz : ev_L f ≠ 0),
      ∃ θ_f : HomogeneousLocalization.Away 𝒜_K f →+* L,
        (∀ {m : ℕ} (hf_deg : f ∈ 𝒜_K m) (n : ℕ) (Q : MvPolynomial (Fin (M₀ + 1)) K)
          (hQ : Q ∈ 𝒜_K (n • m)),
          θ_f (HomogeneousLocalization.Away.mk 𝒜_K hf_deg n Q hQ) =
            ev_L Q * ((ev_L f)⁻¹) ^ n) ∧
        (∀ c : K,
          θ_f (HomogeneousLocalization.fromZeroRingHom 𝒜_K (Submonoid.powers f)
            (algebraMap K ↥(𝒜_K 0) c)) = algebraMap A L (alg_A c)) := by
    intro f hf_nz
    have h_units : ∀ y : Submonoid.powers f, IsUnit (ev_L y) := by
      rintro ⟨_, n, rfl⟩
      rw [map_pow]
      exact IsUnit.pow n (IsUnit.mk0 (ev_L f) hf_nz)
    obtain ⟨lift_loc, hlift_eq⟩ :
        ∃ lift_loc : Localization (Submonoid.powers f) →+* L,
          ∀ p : MvPolynomial (Fin (M₀ + 1)) K,
            lift_loc (algebraMap _ (Localization (Submonoid.powers f)) p) = ev_L p :=
      ⟨IsLocalization.lift (M := Submonoid.powers f) h_units,
        IsLocalization.lift_eq (M := Submonoid.powers f) h_units⟩
    refine ⟨lift_loc.comp (valHom (Submonoid.powers f)), ?_, ?_⟩
    · intro m hf_deg n Q hQ
      change lift_loc (HomogeneousLocalization.val
        (HomogeneousLocalization.Away.mk 𝒜_K hf_deg n Q hQ)) = _
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply]
      apply mul_left_cancel₀ (pow_ne_zero n hf_nz)
      have hspec := congrArg lift_loc
        (IsLocalization.mk'_spec' (Localization (Submonoid.powers f)) Q
          ⟨f ^ n, pow_mem (Submonoid.mem_powers f) n⟩)
      rw [map_mul, hlift_eq, hlift_eq] at hspec
      change ev_L (f ^ n) * _ = _ at hspec
      rw [map_pow] at hspec
      rw [hspec, mul_comm (ev_L Q), ← mul_assoc, ← mul_pow,
        mul_inv_cancel₀ hf_nz, one_pow, one_mul]
    · intro c
      change lift_loc (Localization.mk (MvPolynomial.C c) 1) = _
      rw [Localization.mk_eq_mk'_apply]
      have hspec := congrArg lift_loc
        (IsLocalization.mk'_spec' (Localization (Submonoid.powers f)) (MvPolynomial.C c)
          (1 : Submonoid.powers f))
      rw [map_mul, hlift_eq, hlift_eq] at hspec
      change ev_L 1 * _ = ev_L (MvPolynomial.C c) at hspec
      rw [map_one, one_mul] at hspec
      rw [hspec]
      simp [ev_L]

  
  obtain ⟨θ, hθ_mk, hθ_zero⟩ :
      ∃ θ : ∀ b : Fin (M₀ + 1), HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X b) →+* ↥(R_b b),
        (∀ (b : Fin (M₀ + 1)) (hXb : MvPolynomial.X b ∈ 𝒜_K 1) (d : ℕ)
          (P : MvPolynomial (Fin (M₀ + 1)) K) (hP : P ∈ 𝒜_K (d • 1)),
          θ b (HomogeneousLocalization.Away.mk 𝒜_K hXb d P hP) = ev_Rb b P) ∧
        (∀ b : Fin (M₀ + 1),
          (θ b).comp ((HomogeneousLocalization.fromZeroRingHom 𝒜_K
            (Submonoid.powers (MvPolynomial.X b))).comp (algebraMap K ↥(𝒜_K 0))) =
            (algebraMap A ↥(R_b b)).comp alg_A) := by
    have hθ_each : ∀ b : Fin (M₀ + 1),
        ∃ θ_b : HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X b) →+* ↥(R_b b),
          (∀ (hXb : MvPolynomial.X b ∈ 𝒜_K 1) (d : ℕ) (P : MvPolynomial (Fin (M₀ + 1)) K)
            (hP : P ∈ 𝒜_K (d • 1)),
            θ_b (HomogeneousLocalization.Away.mk 𝒜_K hXb d P hP) = ev_Rb b P) ∧
          (θ_b.comp ((HomogeneousLocalization.fromZeroRingHom 𝒜_K
            (Submonoid.powers (MvPolynomial.X b))).comp (algebraMap K ↥(𝒜_K 0))) =
            (algebraMap A ↥(R_b b)).comp alg_A) := by
      intro b
      have hXb_nz : ev_L (MvPolynomial.X b) ≠ 0 := by simp [ev_L, hg_L_nz b]
      obtain ⟨θ_frac, hθ_frac_mk, hθ_frac_zero⟩ := hHomLocFracPkg (MvPolynomial.X b) hXb_nz
      have h_mem : ∀ z : HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X b),
          ∃ r : ↥(R_b b), ι_b b r = θ_frac z := by
        intro z
        obtain ⟨d, P, hP, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_K (hX_hom b) z
        refine ⟨ev_Rb b P, ?_⟩
        have hP' : P ∈ 𝒜_K d := by simpa using hP
        rw [hι_ev_Rb b d P hP', hθ_frac_mk (hX_hom b) d P hP]
        simp [ev_L]
      obtain ⟨θ_b, hθ_b⟩ := hPullbackHom (ι_b b) (hι_inj b) θ_frac h_mem
      refine ⟨θ_b, fun hXb d P hP => ?_, ?_⟩
      · apply hι_inj b
        have hP' : P ∈ 𝒜_K d := by simpa using hP
        rw [show ι_b b (θ_b _) = θ_frac _ from RingHom.congr_fun hθ_b _,
          hθ_frac_mk hXb d P hP, hι_ev_Rb b d P hP']
        simp [ev_L]
      · apply RingHom.ext
        intro c
        apply hι_inj b
        simp only [RingHom.comp_apply]
        have h1 := RingHom.congr_fun hθ_b
          (HomogeneousLocalization.fromZeroRingHom 𝒜_K (Submonoid.powers (MvPolynomial.X b))
            (algebraMap K ↥(𝒜_K 0) c))
        exact h1.trans ((hθ_frac_zero c).trans (RingHom.congr_fun (hι_alg b) (alg_A c)).symm)
    obtain ⟨θ, hθ_spec⟩ := Classical.axiomOfChoice hθ_each
    exact ⟨θ, fun b => (hθ_spec b).1, fun b => (hθ_spec b).2⟩

  have hθ_elem : ∀ b b' : Fin (M₀ + 1),
      θ b (HomogeneousLocalization.Away.isLocalizationElem (hX_hom b) (hX_hom b')) = u b b' := by
    intro b b'
    change θ b (HomogeneousLocalization.Away.mk 𝒜_K (hX_hom b) 1 (MvPolynomial.X b' ^ 1) _) = u b b'
    rw [hθ_mk]
    simp [ev_Rb]

  
  have hθ_ov : ∀ b b' : Fin (M₀ + 1),
      ∃ θ_ov : HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X b * MvPolynomial.X b') →+*
          Localization.Away (u b b'),
        θ_ov.comp (HomogeneousLocalization.awayMap 𝒜_K (hX_hom b') rfl) =
          (algebraMap ↥(R_b b) (Localization.Away (u b b'))).comp (θ b) ∧
        θ_ov.comp (HomogeneousLocalization.awayMap 𝒜_K (hX_hom b) (mul_comm _ _)) =
          (τ b b').toRingHom.comp
            ((algebraMap ↥(R_b b') (Localization.Away (u b' b))).comp (θ b')) := by
    intro b b'
    have hXbb'_hom : MvPolynomial.X b * MvPolynomial.X b' ∈ 𝒜_K (1 + 1) :=
      SetLike.GradedMul.mul_mem (hX_hom b) (hX_hom b')
    have hXbb'_nz : ev_L (MvPolynomial.X b * MvPolynomial.X b') ≠ 0 := by
      simp [ev_L, mul_ne_zero (hg_L_nz b) (hg_L_nz b')]
    obtain ⟨θ_ov_frac, hθ_ov_mk, _⟩ :=
      hHomLocFracPkg (MvPolynomial.X b * MvPolynomial.X b') hXbb'_nz
    have h_mem : ∀ w : HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X b * MvPolynomial.X b'),
        ∃ s : Localization.Away (u b b'), ι_ov b b' s = θ_ov_frac w := by
      intro w
      obtain ⟨n, Q, hQ, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_K hXbb'_hom w
      have hQ' : Q ∈ 𝒜_K (2 * n) := by
        have hdeg : n • (1 + 1) = 2 * n := by
          simp only [nsmul_eq_mul, Nat.cast_id]
          omega
        rwa [← hdeg]
      refine ⟨algebraMap ↥(R_b b) (Localization.Away (u b b')) (ev_Rb b Q) *
        (IsLocalization.Away.invSelf (S := Localization.Away (u b b')) (u b b')) ^ n, ?_⟩
      rw [map_mul, map_pow,
        show ι_ov b b' (algebraMap _ _ (ev_Rb b Q)) = ι_b b (ev_Rb b Q) from
          RingHom.congr_fun (hι_ov_comp b b') (ev_Rb b Q),
        hι_ev_Rb b (2 * n) Q hQ', hι_ov_inv, hθ_ov_mk hXbb'_hom n Q hQ]
      simp only [ev_L, map_mul, MvPolynomial.eval₂Hom_X']
      have hgb := hg_L_nz b
      rw [two_mul, pow_add, mul_pow, mul_inv_rev, mul_pow]
      have h_canc : ((algebraMap A L (g b))⁻¹) ^ n *
          (((algebraMap A L (g b))⁻¹) ^ n * (algebraMap A L (g b) ^ n *
            ((algebraMap A L (g b'))⁻¹) ^ n)) =
          ((algebraMap A L (g b'))⁻¹) ^ n * ((algebraMap A L (g b))⁻¹) ^ n := by
        rw [← mul_assoc (((algebraMap A L (g b))⁻¹) ^ n) (algebraMap A L (g b) ^ n),
          ← mul_pow, inv_mul_cancel₀ hgb, one_pow, one_mul, mul_comm]
      rw [mul_assoc (ev_L Q), mul_assoc (((algebraMap A L (g b))⁻¹) ^ n), h_canc]
    obtain ⟨θ_ov, hθ_ov_comp⟩ := hPullbackHom (ι_ov b b') (hι_ov_inj b b') θ_ov_frac h_mem
    refine ⟨θ_ov, ?_, ?_⟩
    · ext z
      apply hι_ov_inj b b'
      obtain ⟨d, P, hP, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_K (hX_hom b) z
      simp only [RingHom.comp_apply]
      rw [show ι_ov b b' (θ_ov _) = θ_ov_frac _ from RingHom.congr_fun hθ_ov_comp _,
        show ι_ov b b' (algebraMap _ _ _) = ι_b b _ from RingHom.congr_fun (hι_ov_comp b b') _,
        hθ_mk b (hX_hom b) d P hP]
      have hP' : P ∈ 𝒜_K d := by simpa using hP
      rw [hι_ev_Rb b d P hP', HomogeneousLocalization.awayMap_mk]
      rw [hθ_ov_mk _ d _ _]
      simp only [ev_L, map_mul, map_pow, MvPolynomial.eval₂Hom_X']
      have hgb' := hg_L_nz b'
      rw [mul_inv_rev, mul_pow, mul_assoc (ev_L P),
        ← mul_assoc (algebraMap A L (g b') ^ d), ← mul_pow,
        mul_inv_cancel₀ hgb', one_pow, one_mul]
    · ext z'
      apply hι_ov_inj b b'
      obtain ⟨d, P, hP, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_K (hX_hom b') z'
      simp only [RingHom.comp_apply]
      have hτ_eq := RingHom.congr_fun (hτ_frac b b')
        (algebraMap ↥(R_b b') (Localization.Away (u b' b)) (θ b'
          (HomogeneousLocalization.Away.mk 𝒜_K (hX_hom b') d P hP)))
      change ι_ov b b' ((τ b b').toRingHom _) = _ at hτ_eq
      rw [show ι_ov b b' (θ_ov _) = θ_ov_frac _ from RingHom.congr_fun hθ_ov_comp _,
        hτ_eq,
        show ι_ov b' b (algebraMap _ _ _) = ι_b b' _ from RingHom.congr_fun (hι_ov_comp b' b) _,
        hθ_mk b' (hX_hom b') d P hP]
      have hP' : P ∈ 𝒜_K d := by simpa using hP
      rw [hι_ev_Rb b' d P hP', HomogeneousLocalization.awayMap_mk]
      rw [hθ_ov_mk _ d _ _]
      simp only [ev_L, map_mul, map_pow, MvPolynomial.eval₂Hom_X']
      have hgb := hg_L_nz b
      rw [mul_inv_rev, mul_pow, mul_comm (((algebraMap A L (g b'))⁻¹) ^ d),
        mul_assoc (ev_L P), ← mul_assoc (algebraMap A L (g b) ^ d), ← mul_pow,
        mul_inv_cancel₀ hgb, one_pow, one_mul]

  
  let φ_cat : ∀ b : Fin (M₀ + 1),
      CommRingCat.of (HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X b)) ⟶
        CommRingCat.of (↥(R_b b) ⧸ I_b b) :=
    fun b => CommRingCat.ofHom (θ b) ≫ CommRingCat.ofHom (Ideal.Quotient.mk (I_b b))
  let φ : ∀ b : Fin (M₀ + 1),
      HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X b) →+* (↥(R_b b) ⧸ I_b b) :=
    fun b => (φ_cat b).hom
  have hφ_apply : ∀ (b : Fin (M₀ + 1))
      (z : HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X b)),
      φ b z = Ideal.Quotient.mk (I_b b) (θ b z) :=
    fun _ _ => rfl

  have hφ_surj : ∀ b : Fin (M₀ + 1), Function.Surjective (φ b) := by
    intro b q
    obtain ⟨⟨y, hy⟩, rfl⟩ := Ideal.Quotient.mk_surjective q
    have h_ind : ∀ (x : Localization.Away (g b)) (hx : x ∈ R_b b),
        ∃ z : HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X b),
          φ b z = Ideal.Quotient.mk (I_b b) ⟨x, hx⟩ := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem w hw =>
        rcases hw with ⟨a, rfl⟩
        refine ⟨HomogeneousLocalization.Away.isLocalizationElem (hX_hom b) (hX_hom a), ?_⟩
        rw [hφ_apply, hθ_elem]
      | algebraMap r =>
        let c := ε r
        have h_ker : r - alg_A c ∈ RingHom.ker ε := by
          rw [RingHom.mem_ker, map_sub,
            show ε (alg_A c) = (ε.comp alg_A) c from rfl, hε_id, RingHom.id_apply, sub_self]
        have h_mem_I : algebraMap A ↥(R_b b) r - algebraMap A ↥(R_b b) (alg_A c) ∈ I_b b := by
          rw [← map_sub]
          exact Ideal.mem_map_of_mem (algebraMap A ↥(R_b b)) h_ker
        have h_quot_eq : Ideal.Quotient.mk (I_b b) (algebraMap A ↥(R_b b) r) =
            Ideal.Quotient.mk (I_b b) (algebraMap A ↥(R_b b) (alg_A c)) :=
          Ideal.Quotient.eq.mpr h_mem_I
        change ∃ z, φ b z = Ideal.Quotient.mk (I_b b) (algebraMap A ↥(R_b b) r)
        rw [h_quot_eq]
        refine ⟨HomogeneousLocalization.fromZeroRingHom 𝒜_K (Submonoid.powers (MvPolynomial.X b))
          (algebraMap K ↥(𝒜_K 0) c), ?_⟩
        rw [hφ_apply]
        exact congrArg (Ideal.Quotient.mk (I_b b)) (RingHom.congr_fun (hθ_zero b) c)
      | add x₁ x₂ hx₁ hx₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨z₁, hz₁⟩
        rcases ih₂ with ⟨z₂, hz₂⟩
        refine ⟨z₁ + z₂, ?_⟩
        change φ b (z₁ + z₂) = Ideal.Quotient.mk (I_b b) (⟨x₁, hx₁⟩ + ⟨x₂, hx₂⟩)
        rw [map_add, map_add, hz₁, hz₂]
      | mul x₁ x₂ hx₁ hx₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨z₁, hz₁⟩
        rcases ih₂ with ⟨z₂, hz₂⟩
        refine ⟨z₁ * z₂, ?_⟩
        change φ b (z₁ * z₂) = Ideal.Quotient.mk (I_b b) (⟨x₁, hx₁⟩ * ⟨x₂, hx₂⟩)
        rw [map_mul, map_mul, hz₁, hz₂]
    exact h_ind y hy

  have hφ_ker : ∀ (b : Fin (M₀ + 1)) (hXb : MvPolynomial.X b ∈ 𝒜_K 1),
      RingHom.ker (φ b) =
        Ideal.span {HomogeneousLocalization.Away.mk 𝒜_K hXb 2 F_hom hF_hom} := by
    intro b hXb
    let dehom_b : MvPolynomial (Fin (M₀ + 1)) K →+* MvPolynomial (Fin (M₀ + 1)) K :=
      MvPolynomial.eval₂Hom MvPolynomial.C (fun a => if a = b then 1 else MvPolynomial.X a)
    have h_units : ∀ y : Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin (M₀ + 1)) K),
        IsUnit (dehom_b y) := by
      rintro ⟨_, n, rfl⟩
      simp [dehom_b]
    obtain ⟨lift_dehom, hlift_dehom_eq⟩ :
        ∃ lift_dehom : Localization
            (Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin (M₀ + 1)) K)) →+*
            MvPolynomial (Fin (M₀ + 1)) K,
          ∀ p : MvPolynomial (Fin (M₀ + 1)) K,
            lift_dehom (algebraMap _
              (Localization (Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin (M₀ + 1)) K)))
              p) = dehom_b p :=
      ⟨IsLocalization.lift
        (M := Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin (M₀ + 1)) K)) h_units,
        IsLocalization.lift_eq
          (M := Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin (M₀ + 1)) K)) h_units⟩
    let δ_b : HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X b) →+*
        MvPolynomial (Fin (M₀ + 1)) K :=
      lift_dehom.comp (valHom (Submonoid.powers (MvPolynomial.X b)))
    have hδ_mk : ∀ (d : ℕ) (P : MvPolynomial (Fin (M₀ + 1)) K) (hP : P ∈ 𝒜_K (d • 1)),
        δ_b (HomogeneousLocalization.Away.mk 𝒜_K hXb d P hP) = dehom_b P := by
      intro d P hP
      change lift_dehom (HomogeneousLocalization.val
        (HomogeneousLocalization.Away.mk 𝒜_K hXb d P hP)) = dehom_b P
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply]
      have hspec := congrArg lift_dehom
        (IsLocalization.mk'_spec' (Localization (Submonoid.powers (MvPolynomial.X b))) P
          ⟨MvPolynomial.X b ^ d, pow_mem (Submonoid.mem_powers (MvPolynomial.X b)) d⟩)
      rw [map_mul, hlift_dehom_eq, hlift_dehom_eq] at hspec
      change dehom_b (MvPolynomial.X b ^ d) * _ = dehom_b P at hspec
      have h1 : dehom_b (MvPolynomial.X b ^ d) = 1 := by simp [dehom_b]
      rwa [h1, one_mul] at hspec
    let c₀ : K →+* HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X b) :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜_K (Submonoid.powers (MvPolynomial.X b))).comp
        (algebraMap K ↥(𝒜_K 0))
    let η_b : MvPolynomial (Fin (M₀ + 1)) K →+*
        HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X b) :=
      MvPolynomial.eval₂Hom c₀
        (fun a => if a = b then 1 else
          HomogeneousLocalization.Away.isLocalizationElem hXb (hX_hom a))
    have hη_dehom : ∀ (d : ℕ) (P : MvPolynomial (Fin (M₀ + 1)) K) (hP : P ∈ 𝒜_K (d • 1)),
        η_b (dehom_b P) = HomogeneousLocalization.Away.mk 𝒜_K hXb d P hP := by
      intro d P hP
      rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.Away.val_mk]
      let S := Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin (M₀ + 1)) K)
      let ψ_val : MvPolynomial (Fin (M₀ + 1)) K →+* Localization S :=
        (valHom S).comp (η_b.comp dehom_b)
      have hmem_pow : ∀ n : ℕ, (MvPolynomial.X b : MvPolynomial (Fin (M₀ + 1)) K) ^ n ∈ S :=
        fun n => pow_mem (Submonoid.mem_powers (MvPolynomial.X b)) n
      change ψ_val P = Localization.mk P ⟨MvPolynomial.X b ^ d, _⟩
      have hψ_C : ∀ c : K, ψ_val (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        simp [ψ_val, dehom_b, η_b, valHom, c₀, HomogeneousLocalization.fromZeroRingHom]
        rfl
      have hψ_X : ∀ a : Fin (M₀ + 1),
          ψ_val (MvPolynomial.X a) =
            Localization.mk (MvPolynomial.X a) ⟨MvPolynomial.X b, Submonoid.mem_powers _⟩ := by
        intro a
        simp only [ψ_val, RingHom.comp_apply, dehom_b, MvPolynomial.eval₂Hom_X']
        by_cases hab : a = b
        · subst hab
          simp only [↓reduceIte, map_one]
          exact (Localization.mk_self ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩).symm
        · simp only [hab, ↓reduceIte, η_b, MvPolynomial.eval₂Hom_X', valHom,
            RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk,
            HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk]
          congr 1 <;> simp [pow_one]
      have hmk_prod : ∀ {ι : Type} (s : Finset ι)
          (num : ι → MvPolynomial (Fin (M₀ + 1)) K) (deg : ι → ℕ),
          (∏ i ∈ s, Localization.mk (num i) ⟨MvPolynomial.X b ^ deg i, hmem_pow (deg i)⟩ :
            Localization S) =
            Localization.mk (∏ i ∈ s, num i)
              ⟨MvPolynomial.X b ^ (∑ i ∈ s, deg i), hmem_pow _⟩ := by
        intro ι s num deg
        induction s using Finset.induction_on with
        | empty =>
          simp only [Finset.prod_empty, Finset.sum_empty, pow_zero]
          exact Localization.mk_one.symm
        | @insert i s hi ih =>
          rw [Finset.prod_insert hi, Finset.prod_insert hi, ih, Localization.mk_mul]
          congr 1
          ext
          simp [Finset.sum_insert hi, pow_add]
      have hmk_sum : ∀ {ι : Type} (s : Finset ι)
          (num : ι → MvPolynomial (Fin (M₀ + 1)) K) (den : S),
          (∑ i ∈ s, Localization.mk (num i) den : Localization S) =
            Localization.mk (∑ i ∈ s, num i) den := by
        intro ι s num den
        induction s using Finset.induction_on with
        | empty => simp only [Finset.sum_empty, Localization.mk_zero]
        | @insert i s hi ih =>
          rw [Finset.sum_insert hi, Finset.sum_insert hi, ih, Localization.add_mk_self]
      have hP' : MvPolynomial.IsHomogeneous P d := by
        have h1 : P ∈ MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) K (d • 1) := hP
        rw [nsmul_one] at h1
        exact (MvPolynomial.mem_homogeneousSubmodule d P).mp h1
      conv_lhs => rw [P.as_sum]
      conv_rhs => rw [P.as_sum]
      rw [map_sum, ← hmk_sum P.support (fun (v : Fin (M₀ + 1) →₀ ℕ) =>
        MvPolynomial.monomial v (P.coeff v)) ⟨MvPolynomial.X b ^ d, hmem_pow d⟩]
      refine Finset.sum_congr rfl fun m hm => ?_
      have hdeg : (∑ a : Fin (M₀ + 1), m a) = d := by
        have hw := hP' (MvPolynomial.mem_support_iff.mp hm)
        rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => by simp)] at hw
        simpa only [Pi.one_apply, smul_eq_mul, mul_one] using hw
      rw [MvPolynomial.monomial_eq, Finsupp.prod_pow, map_mul, hψ_C, map_prod]
      have hprod_eq : (∏ a : Fin (M₀ + 1), ψ_val (MvPolynomial.X a ^ m a)) =
          ∏ a : Fin (M₀ + 1),
            Localization.mk (MvPolynomial.X a ^ m a)
              ⟨MvPolynomial.X b ^ m a, hmem_pow (m a)⟩ := by
        refine Finset.prod_congr rfl fun a _ => ?_
        rw [map_pow, hψ_X, Localization.mk_pow]
        rfl
      rw [hprod_eq, hmk_prod, Localization.mk_mul]
      congr 1
      ext
      simp [hdeg]
    have hηδ : ∀ z : HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X b),
        η_b (δ_b z) = z := by
      intro z
      obtain ⟨d, P, hP, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_K hXb z
      rw [hδ_mk d P hP, hη_dehom d P hP]
    let f_b := HomogeneousLocalization.Away.mk 𝒜_K hXb 2 F_hom hF_hom
    ext z
    obtain ⟨d, P, hP, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_K hXb z
    have hP_d : P ∈ MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) K d := by
      change P ∈ 𝒜_K d
      rwa [nsmul_one] at hP
    have h_iff : HomogeneousLocalization.Away.mk 𝒜_K hXb d P hP ∈ RingHom.ker (φ b) ↔
        δ_b (HomogeneousLocalization.Away.mk 𝒜_K hXb d P hP) ∈ Ideal.span {δ_b f_b} := by
      rw [RingHom.mem_ker, show φ b _ = Ideal.Quotient.mk (I_b b) (θ b _) from rfl,
        hθ_mk b hXb d P hP, Ideal.Quotient.eq_zero_iff_mem, hδ_mk d P hP, hδ_mk 2 F_hom hF_hom]
      exact hReesRel b d P hP_d
    rw [h_iff]
    constructor
    · intro hmem
      rw [Ideal.mem_span_singleton'] at hmem ⊢
      rcases hmem with ⟨Q, hQ⟩
      refine ⟨η_b Q, ?_⟩
      calc η_b Q * f_b = η_b Q * η_b (δ_b f_b) := by rw [hηδ f_b]
        _ = η_b (Q * δ_b f_b) := (map_mul η_b _ _).symm
        _ = η_b (δ_b (HomogeneousLocalization.Away.mk 𝒜_K hXb d P hP)) := by rw [hQ]
        _ = HomogeneousLocalization.Away.mk 𝒜_K hXb d P hP := hηδ _
    · intro hmem
      rw [Ideal.mem_span_singleton'] at hmem ⊢
      rcases hmem with ⟨w, hw⟩
      exact ⟨δ_b w, by rw [← map_mul, hw]⟩

  have hψ_pkg : ∀ b : Fin (M₀ + 1),
      ∃ ψ_b : (↥(R_b b) ⧸ I_b b) ≃+* MvPolynomial (Fin d_Q) K,
        ∀ c : K, ψ_b (Ideal.Quotient.mk (I_b b) (algebraMap A ↥(R_b b) (alg_A c))) =
          MvPolynomial.C c := by
    intro b
    obtain ⟨e_b, he_b⟩ := hChartSmooth b (hX_hom b)
    let e_quot := (RingHom.quotientKerEquivOfSurjective (hφ_surj b)).symm.trans
      ((Ideal.quotEquivOfEq (hφ_ker b (hX_hom b))).trans e_b)
    refine ⟨e_quot, fun c => ?_⟩
    let z_c := HomogeneousLocalization.Away.mk 𝒜_K (hX_hom b) 0 (MvPolynomial.C c)
      (MvPolynomial.isHomogeneous_C _ c)
    have hφ_zc : φ b z_c = Ideal.Quotient.mk (I_b b) (algebraMap A ↥(R_b b) (alg_A c)) := by
      change Ideal.Quotient.mk (I_b b) (θ b z_c) = _
      rw [hθ_mk b (hX_hom b) 0 (MvPolynomial.C c) (MvPolynomial.isHomogeneous_C _ c)]
      simp [ev_Rb]
    rw [← hφ_zc]
    dsimp [e_quot]
    have hsymm : (RingHom.quotientKerEquivOfSurjective (hφ_surj b)).symm (φ b z_c) =
        Ideal.Quotient.mk (RingHom.ker (φ b)) z_c := by
      apply (RingHom.quotientKerEquivOfSurjective (hφ_surj b)).injective
      rw [RingEquiv.apply_symm_apply]
      rfl
    rw [hsymm]
    exact he_b c

  obtain ⟨ψ, hψ_C⟩ := Classical.axiomOfChoice hψ_pkg

  
  
  
  let j_chart : ∀ b : Fin (M₀ + 1), Spec (CommRingCat.of ↥(R_b b)) ⟶ P_sch :=
    fun b => (isoW b).inv ≫ (W b).ι
  have hj_open : ∀ b : Fin (M₀ + 1), IsOpenImmersion (j_chart b) :=
    fun _ => inferInstance
  have hj_range : ∀ b : Fin (M₀ + 1), Set.range (j_chart b).base = (W b : Set P_sch) := by
    intro b
    ext z
    constructor
    · rintro ⟨p, rfl⟩
      exact ((isoW b).inv.base p).2
    · intro hz
      refine ⟨(isoW b).hom.base ⟨z, hz⟩, ?_⟩
      change (((isoW b).hom ≫ (isoW b).inv) ≫ (W b).ι).base ⟨z, hz⟩ = z
      rw [Iso.hom_inv_id]
      rfl
  have hj_proj : ∀ b : Fin (M₀ + 1),
      j_chart b ≫ π_P = Spec.map (CommRingCat.ofHom (algebraMap A ↥(R_b b))) := by
    intro b
    dsimp only [j_chart]
    rw [Category.assoc, hW_proj b, Iso.inv_hom_id_assoc]

  
  
  
  have hOverlap : ∀ b b' : Fin (M₀ + 1),
      let ι₁ : Spec (CommRingCat.of (Localization.Away (u b b'))) ⟶ P_sch :=
        Spec.map (CommRingCat.ofHom (algebraMap ↥(R_b b) (Localization.Away (u b b')))) ≫
          j_chart b
      let ι₂ : Spec (CommRingCat.of (Localization.Away (u b b'))) ⟶ P_sch :=
        Spec.map (CommRingCat.ofHom ((τ b b').toRingHom.comp
          (algebraMap ↥(R_b b') (Localization.Away (u b' b))))) ≫
          j_chart b'
      ι₁ = ι₂ ∧ Set.range ι₁.base = (W b : Set P_sch) ∩ (W b' : Set P_sch) := by
    intro b b' ι₁ ι₂
    have _hDom_ov : IsDomain (Localization.Away (u b b')) :=
      Function.Injective.isDomain (ι_ov b b') (hι_ov_inj b b')
    let η : Spec (CommRingCat.of L) ⟶ Spec (CommRingCat.of (Localization.Away (u b b'))) :=
      Spec.map (CommRingCat.ofHom (ι_ov b b'))
    have _hDom_η : IsDominant η := by
      rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
      ext p
      simp only [Set.mem_univ, iff_true, mem_closure_iff]
      intro O hO hpO
      let p_bot_L : Spec (CommRingCat.of L) := ⟨⊥, inferInstance⟩
      let p_bot_D : Spec (CommRingCat.of (Localization.Away (u b b'))) := ⟨⊥, inferInstance⟩
      have hη_bot : η.base p_bot_L = p_bot_D := by
        apply PrimeSpectrum.ext
        ext x
        change ι_ov b b' x ∈ (⊥ : Ideal L) ↔ x ∈ (⊥ : Ideal (Localization.Away (u b b')))
        simp only [Ideal.mem_bot]
        exact ⟨fun hx => hι_ov_inj b b' (hx.trans (map_zero _).symm),
          fun hx => by rw [hx, map_zero]⟩
      have hp_spec : p_bot_D ⤳ p := (PrimeSpectrum.le_iff_specializes p_bot_D p).mp bot_le
      exact ⟨η.base p_bot_L, by rw [hη_bot]; exact hp_spec.mem_open hO hpO, p_bot_L, rfl⟩
    have hι_eq : ι₁ = ι₂ := by
      apply AlgebraicGeometry.ext_of_isDominant η
      let q_gen : Spec (CommRingCat.of L) ⟶ Spec (CommRingCat.of A) :=
        Spec.map (CommRingCat.ofHom (algebraMap A L))
      have hq₁ : (η ≫ ι₁) ≫ π_P = q_gen := by
        dsimp only [η, ι₁, q_gen]
        rw [Category.assoc, Category.assoc, hj_proj b, ← Category.assoc,
          ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← Spec.map_comp,
          ← CommRingCat.ofHom_comp, hι_ov_alg b b']
      have hq₂ : (η ≫ ι₂) ≫ π_P = q_gen := by
        dsimp only [η, ι₂, q_gen]
        rw [Category.assoc, Category.assoc, hj_proj b', ← Category.assoc,
          ← Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hcomp_eq : ((ι_ov b b').comp ((τ b b').toRingHom.comp
            (algebraMap ↥(R_b b') (Localization.Away (u b' b))))).comp (algebraMap A ↥(R_b b')) =
            algebraMap A L := by
          ext a
          simp only [RingHom.comp_apply]
          have h1 := RingHom.congr_fun (hτ_frac b b')
            (algebraMap ↥(R_b b') (Localization.Away (u b' b)) (algebraMap A ↥(R_b b') a))
          exact h1.trans (RingHom.congr_fun (hι_ov_alg b' b) a)
        exact congrArg (fun φ => Spec.map (CommRingCat.ofHom φ)) hcomp_eq
      let U_b : (Spec (CommRingCat.of A)).Opens := PrimeSpectrum.basicOpen (g b)
      let V_Ub : P_sch.Opens := π_P ⁻¹ᵁ U_b
      have hq_sub : Set.range q_gen.base ⊆ (U_b : Set (Spec (CommRingCat.of A))) := by
        rintro _ ⟨pt, rfl⟩
        change algebraMap A L (g b) ∉ pt.asIdeal
        intro hmem
        exact pt.isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem _ hmem (IsUnit.mk0 _ (hg_L_nz b)))
      have hr₁ : Set.range (η ≫ ι₁).base ⊆ Set.range V_Ub.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨pt, rfl⟩
        change ((η ≫ ι₁) ≫ π_P).base pt ∈ U_b
        rw [hq₁]
        exact hq_sub ⟨pt, rfl⟩
      have hr₂ : Set.range (η ≫ ι₂).base ⊆ Set.range V_Ub.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨pt, rfl⟩
        change ((η ≫ ι₂) ≫ π_P).base pt ∈ U_b
        rw [hq₂]
        exact hq_sub ⟨pt, rfl⟩
      let lift₁ := IsOpenImmersion.lift V_Ub.ι (η ≫ ι₁) hr₁
      let lift₂ := IsOpenImmersion.lift V_Ub.ι (η ≫ ι₂) hr₂
      have hl₁ : lift₁ ≫ V_Ub.ι = η ≫ ι₁ := IsOpenImmersion.lift_fac V_Ub.ι (η ≫ ι₁) hr₁
      have hl₂ : lift₂ ≫ V_Ub.ι = η ≫ ι₂ := IsOpenImmersion.lift_fac V_Ub.ι (η ≫ ι₂) hr₂
      have _ : IsIso (π_P ∣_ U_b) := hIso_away b
      have h_eq_lifts : lift₁ = lift₂ := by
        rw [← cancel_mono (π_P ∣_ U_b), ← cancel_mono U_b.ι]
        calc (lift₁ ≫ (π_P ∣_ U_b)) ≫ U_b.ι
            = lift₁ ≫ ((π_P ∣_ U_b) ≫ U_b.ι) := Category.assoc _ _ _
          _ = lift₁ ≫ (V_Ub.ι ≫ π_P) := by rw [AlgebraicGeometry.morphismRestrict_ι]
          _ = (lift₁ ≫ V_Ub.ι) ≫ π_P := (Category.assoc _ _ _).symm
          _ = (η ≫ ι₁) ≫ π_P := by rw [hl₁]
          _ = (η ≫ ι₂) ≫ π_P := by rw [hq₁, hq₂]
          _ = (lift₂ ≫ V_Ub.ι) ≫ π_P := by rw [hl₂]
          _ = lift₂ ≫ (V_Ub.ι ≫ π_P) := Category.assoc _ _ _
          _ = lift₂ ≫ ((π_P ∣_ U_b) ≫ U_b.ι) := by rw [AlgebraicGeometry.morphismRestrict_ι]
          _ = (lift₂ ≫ (π_P ∣_ U_b)) ≫ U_b.ι := (Category.assoc _ _ _).symm
      rw [← hl₁, ← hl₂, h_eq_lifts]
    refine ⟨hι_eq, Set.Subset.antisymm ?_ ?_⟩
    · intro z hz
      have hz₁ : z ∈ (W b : Set P_sch) := by
        rw [← hj_range b]
        rcases hz with ⟨p, rfl⟩
        exact ⟨_, rfl⟩
      have hz₂ : z ∈ (W b' : Set P_sch) := by
        rw [← hj_range b']
        rw [hι_eq] at hz
        rcases hz with ⟨p, rfl⟩
        exact ⟨_, rfl⟩
