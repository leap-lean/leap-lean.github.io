            (Limits.pullback.snd e'_hom h_W ≫ u_PY) (e'_hom ≫ w_X) j_X :=
        fun E' => (IsPullback.of_hasPullback E'.hom h_W).paste_vert hPb_W
      let pasteIsoObj : ∀ E' : W.Etale, (B_hW.comp M_uPY).obj E' ≅ (M_wX.comp B_jX).obj E' :=
        fun E' => MorphismProperty.Over.isoMk (pbPaste E').isoPullback (pbPaste E').isoPullback_hom_snd
      let e_paste_nat : (shPull_wX.obj (P_push.obj FM_XU)).obj ≅
          (pf_hW.obj (shPull_uPY.obj FM_XU)).obj :=
        NatIso.ofComponents
          (fun E_op => FM_XU.obj.mapIso (pasteIsoObj E_op.unop).op)
          (fun {E₁_op E₂_op} g_op => by
            let g := g_op.unop
            let E₁ := E₂_op.unop
            let E₂ := E₁_op.unop
            have hcomm_XU : ((B_hW.comp M_uPY).map g) ≫ (pasteIsoObj E₂).hom =
