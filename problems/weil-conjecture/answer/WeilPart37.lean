    have hSecDichotomy : ∀ (s : S_k ⟶ Y₀),
        s ≫ Y.hom = 𝟙 S_k →
        (∃ s_U : S_k ⟶ U_Y.toScheme, s_U ≫ U_Y.ι = s) ∨ s = y₀ := by
      intro s hs
