    (weilGeomFrobHom F Z_tilde_s ≫ weilGeomFrobHom F Z_tilde_s) n_mod (2 * m + 2)
    p_eZts_hom p_sq_Zts p_conj_lhs hp_eZts_hom hp_sq_Zts hp_conj_rhs
  have hf_Zts_sq_val : f_Zts (f_Zts (p_π (ev_s ξ))) =
      ((Nat.card F ^ (m + 1)) ^ 2) • p_π (ev_s ξ) := by
    apply hBij_eZts.1
    have hlhs : p_eZts_hom (f_Zts (f_Zts (p_π (ev_s ξ)))) = f_2m2 α₂ := by
      dsimp [α₂]
      rw [hf_Zts_eq, hf_2m2_eq, ← AddMonoidHom.comp_apply p_frob_Zts, ← hcomp_sq_Zts,
        ← AddMonoidHom.comp_apply p_eZts_hom, ← hcomp_conj_rhs, hcomp_conj_lhs,
        AddMonoidHom.comp_apply]
    rw [hlhs, hf_α₂, map_nsmul]

  have hπ_frob_comm := hOverFrobComm π_s π_bar.left hπ_bar_fst π_bar.w
  obtain ⟨p_π_frob, hp_π_frob⟩ :=
    hPullEx (π_bar.left ≫ weilGeomFrobHom F Z_s) n_mod (2 * m + 2)
  have hcomp_π_1 := hPullComp π_bar.left (weilGeomFrobHom F Z_s) n_mod (2 * m + 2)
    p_π p_frob_Zs p_π_frob hp_π hp_frob_Zs hp_π_frob
  have hp_π_frob' : WeilIsTorsionEtalePullback
      (weilGeomFrobHom F Z_tilde_s ≫ π_bar.left) n_mod (2 * m + 2) p_π_frob := by
    rwa [← hπ_frob_comm]
  have hcomp_π_2 := hPullComp (weilGeomFrobHom F Z_tilde_s) π_bar.left n_mod (2 * m + 2)
    p_frob_Zts p_π p_π_frob hp_frob_Zts hp_π hp_π_frob'
  have hNat_π : ∀ u, p_π (f_Zs u) = f_Zts (p_π u) := by
    intro u
    rw [hf_Zs_eq, hf_Zts_eq, ← AddMonoidHom.comp_apply, ← hcomp_π_1, hcomp_π_2,
      AddMonoidHom.comp_apply]

  have hf_Zs_sq_val : f_Zs (f_Zs (ev_s ξ)) = ((Nat.card F ^ (m + 1)) ^ 2) • ev_s ξ := by
    apply hInj_pπ
    rw [hNat_π, hNat_π, hf_Zts_sq_val, map_nsmul]

  let η : (𝒩_bar r).H 0 :=
    frob_E0 r (frob_E0 r ξ) - ((Nat.card F) ^ (m + 1)) ^ 2 • ξ
  have hev_η : ev_s η = 0 := by
    dsimp [η]
    rw [map_sub, map_nsmul, hEv_frob f_Zs hf_Zs, hEv_frob f_Zs hf_Zs, hf_Zs_sq_val, sub_self]
  exact hEv_zero η hev_η

theorem weil_sing_dev_outer_leray_milnor_specialization (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom]
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom]
    (hProj_Ztilde : IsProjectiveOverField F Z_tilde)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.Flat f₀.left]
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (hFibIrred : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver F 1).left),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left s))
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_u₀.hom]
    [AlgebraicGeometry.IsProper Z_u₀.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_u₀.hom]
    (hProj_Zu₀ : IsProjectiveOverField F Z_u₀)
    (ι_Zu₀ : Z_u₀.left ⟶ Z_tilde.left)
    (hPb_Zu₀ : CategoryTheory.IsPullback ι_Zu₀ Z_u₀.hom f₀.left u₀)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (h1d : WeilSingDevIs1dPencilOdpDatum F m Z_tilde f₀ u₀ j_aff s_inf S_aff U₀)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (M_Zu_low : WeilEllAdicCohomologyModel F Z_u₀ ℓ (2 * m))
    (M_Zu_high : WeilEllAdicCohomologyModel F Z_u₀ ℓ (2 * m + 2))
    (E2_2 : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ 2
      (weilSingDevPencilHigherDirectImage F f₀ ℓ (2 * m))
      (weilSingDevPencilHigherDirectImageMap F f₀ ℓ (2 * m)))
    (E2_0 : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ 0
      (weilSingDevPencilHigherDirectImage F f₀ ℓ (2 * m + 2))
      (weilSingDevPencilHigherDirectImageMap F f₀ ℓ (2 * m + 2)))
    (γ' : AlgebraicClosure (Padic ℓ)) :
    (γ' ∈ ((E2_2.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) →
      ∃ α_low ∈ ((M_Zu_low.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)),
        γ' = (Nat.card F : AlgebraicClosure (Padic ℓ)) * α_low) ∧
    (γ' ∈ ((E2_0.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) →
      γ' ^ 2 = ((Nat.card F : AlgebraicClosure (Padic ℓ)) ^ (m + 1)) ^ 2 ∨
      γ' ∈ ((M_Zu_high.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) :=
by
  classical
  
  have hExtNsmul :
      ∀ {Y : AlgebraicGeometry.Scheme.{u}}
        {A B : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}} (m₀ k₀ : ℕ),
        m₀ • (𝟙 B) = 0 →
        ∀ w : CategoryTheory.Abelian.Ext A B k₀, m₀ • w = 0 := by
    clear * -
    intro Y A B m₀ k₀ hB w
    have hComp : ∀ t : ℕ,
        w.comp (CategoryTheory.Abelian.Ext.mk₀ (t • 𝟙 B)) (Nat.add_zero k₀) =
          t • (w.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 B)) (Nat.add_zero k₀)) := by
      intro t
      induction t with
      | zero =>
        rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero]
      | succ t ih =>
        rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
          CategoryTheory.Abelian.Ext.comp_add, ih]
    have hm := hComp m₀
    rw [hB, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero,
      CategoryTheory.Abelian.Ext.comp_mk₀_id] at hm
    exact hm.symm
  have hSheafHNsmul :
      ∀ {Y : AlgebraicGeometry.Scheme.{u}}
        {ℱ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}} (m₀ k₀ : ℕ),
        m₀ • (𝟙 ℱ) = 0 →
        ∀ w : ℱ.H k₀, m₀ • w = 0 := by
    clear * - hExtNsmul
    intro Y ℱ m₀ k₀ hℱ w
    let Fℤ := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let w' : CategoryTheory.Abelian.Ext Fℤ ℱ k₀ := w
    change m₀ • w' = 0
    exact hExtNsmul m₀ k₀ hℱ w'
  have hFM_zero : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (m₀ : ℕ),
      m₀ • (𝟙 (weilEtaleTorsionSheaf Y m₀)) = 0 := by
    clear * -
    intro Y m₀
    let J := Y.smallEtaleTopology
    let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    have : C.Additive := by
      dsimp [C]
      unfold CategoryTheory.constantSheaf
      infer_instance
    let U := AddCommGrpCat.uliftFunctor.{u, 0}
    let A_m := AddCommGrpCat.of (ZMod m₀)
    have hAm : m₀ • (𝟙 A_m) = 0 := by
      ext a
      change m₀ • a = 0
      rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
    have hUm : m₀ • (𝟙 (U.obj A_m)) = 0 := by
      rw [← U.map_id, ← Functor.map_nsmul, hAm, U.map_zero]
    change m₀ • (𝟙 (C.obj (U.obj A_m))) = 0
    rw [← C.map_id, ← Functor.map_nsmul, hUm, C.map_zero]
  have hTorsionAnn : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (m₀ i₀ : ℕ)
      (w : weilEtaleTorsionH Y m₀ i₀), m₀ • w = 0 :=
    fun Y m₀ i₀ w => hSheafHNsmul m₀ i₀ (hFM_zero Y m₀) w
  have hSub0_tors : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (i₀ : ℕ),
      Subsingleton (weilEtaleTorsionH Y 1 i₀) := by
    intro Y i₀
    refine ⟨fun a b => ?_⟩
    have ha := hTorsionAnn Y 1 i₀ a
    have hb := hTorsionAnn Y 1 i₀ b
    rw [one_nsmul] at ha hb
    exact ha.trans hb.symm
  have hTorsionPullbackDir :
      ∀ (X S S' : AlgebraicGeometry.Scheme.{u})
        (f : X ⟶ S) (pr : S' ⟶ S) (n q i₀ : ℕ)
        (hCont : (weilEtaleSitePullback pr).IsContinuous S.smallEtaleTopology S'.smallEtaleTopology)
        (hAdj : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback pr) AddCommGrpCat.{u} _
          S.smallEtaleTopology S'.smallEtaleTopology hCont).IsRightAdjoint)
        (ℳ_bar : CategoryTheory.Sheaf S'.smallEtaleTopology AddCommGrpCat.{u})
        (iso_bar : CategoryTheory.Iso
          ((@CategoryTheory.Functor.sheafPullback _ _ _ _
            (weilEtaleSitePullback pr) AddCommGrpCat.{u} _
            S.smallEtaleTopology S'.smallEtaleTopology hCont hAdj).obj
            (weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf X n)))
          ℳ_bar)
        (u : ℳ_bar.H i₀),
        n • u = 0 := by
    clear * - hExtNsmul hSheafHNsmul hFM_zero
    intro X S S' f pr n q i₀ hCont hAdj ℳ_bar iso_bar u
    let FM := weilEtaleTorsionSheaf X n
    have hFM : n • (𝟙 FM) = 0 := hFM_zero X n
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor S.Etale X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let P : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Sheaf.cohomologyPresheaf FM q
    have hBP : n • (𝟙 (CategoryTheory.Functor.comp B.op P)) = 0 := by
      have hApp : ∀ (t : ℕ) (V : Opposite S.Etale)
          (x : ↑((CategoryTheory.Functor.comp B.op P).obj V)),
          ((t • 𝟙 (CategoryTheory.Functor.comp B.op P)).app V).hom x = t • x := by
        intro t V x
        induction t with
        | zero => simp
        | succ t ih =>
          rw [succ_nsmul, succ_nsmul, NatTrans.app_add, AddCommGrpCat.hom_add,
            AddMonoidHom.add_apply, ih, NatTrans.id_app, AddCommGrpCat.hom_id,
            AddMonoidHom.id_apply]
      ext V x
      rw [hApp n V x]
      exact hExtNsmul n q hFM x
    let shf := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    have : shf.Additive :=
      CategoryTheory.Adjunction.left_adjoint_additive
        (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u})
    have hDir : n • (𝟙 (weilEtaleHigherDirectImage f q FM)) = 0 := by
      change n • (𝟙 (shf.obj (CategoryTheory.Functor.comp B.op P))) = 0
      rw [← shf.map_id, ← Functor.map_nsmul, hBP, shf.map_zero]
    have := hCont
    have := hAdj
    let pf := (weilEtaleSitePullback pr).sheafPushforwardContinuous
      AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
    let pb := (weilEtaleSitePullback pr).sheafPullback
      AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
    have : pf.Additive :=
      { map_add := by
          intro G₁ G₂ α β
          ext W
          rfl }
    have : pb.Additive :=
      CategoryTheory.Adjunction.left_adjoint_additive
        ((weilEtaleSitePullback pr).sheafAdjunctionContinuous
          AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology)
    have hPb : n • (𝟙 (pb.obj (weilEtaleHigherDirectImage f q FM))) = 0 := by
      rw [← pb.map_id, ← Functor.map_nsmul, hDir, pb.map_zero]
    have hM : n • (𝟙 ℳ_bar) = 0 := by
      have hid : 𝟙 ℳ_bar = iso_bar.inv ≫ 𝟙 _ ≫ iso_bar.hom := by simp
      rw [hid, ← Preadditive.comp_nsmul, ← Preadditive.nsmul_comp, hPb,
        Limits.zero_comp, Limits.comp_zero]
    exact hSheafHNsmul n i₀ hM u
  have hmem_gen : ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (ℓ₀ i₀ : ℕ)
      (y : ∀ r : ℕ, weilEtaleTorsionH S₀ (ℓ₀ ^ r) i₀),
      y ∈ weilEtaleIntegralSystem S₀ ℓ₀ i₀ ↔
        ∀ r : ℕ, weilEtaleTorsionTransition S₀ ℓ₀ r i₀ (y (r + 1)) = y r := by
    clear * -
    intro S₀ ℓ₀ i₀ y
    change (AddMonoidHom.pi fun r =>
        (weilEtaleTorsionTransition S₀ ℓ₀ r i₀).comp
          (Pi.evalAddMonoidHom (fun k => weilEtaleTorsionH S₀ (ℓ₀ ^ k) i₀) (r + 1)) -
        Pi.evalAddMonoidHom (fun k => weilEtaleTorsionH S₀ (ℓ₀ ^ k) i₀) r) y = 0 ↔ _
    refine ⟨fun h r => sub_eq_zero.mp (congrFun h r),
      fun h => funext fun r => sub_eq_zero.mpr (h r)⟩
  
  have hEllAdicOuter :
      ∀ (ℓ₀ : ℕ) [Fact (Nat.Prime ℓ₀)]
        (q_card m₀ : ℕ) (_ : 2 ≤ q_card)
        (H_low : ℕ → Type u) [∀ s, AddCommGroup (H_low s)]
        (_ : Subsingleton (H_low 0))
        (tr_low : ∀ s : ℕ, H_low (s + 1) →+ H_low s)
        (L_low : AddSubgroup (∀ s : ℕ, H_low s))
        (_ : ∀ x : ∀ s : ℕ, H_low s, x ∈ L_low ↔ ∀ s : ℕ, tr_low s (x (s + 1)) = x s)
        (_ : ∀ (s : ℕ) (u : H_low s), (ℓ₀ ^ s) • u = 0)
        (H_E2 : ℕ → Type u) [∀ r, AddCommGroup (H_E2 r)]
        (tr_E2 : ∀ r : ℕ, H_E2 (r + 1) →+ H_E2 r)
        (L_E2 : AddSubgroup (∀ r : ℕ, H_E2 r))
        (_ : ∀ z : ∀ r : ℕ, H_E2 r, z ∈ L_E2 ↔ ∀ r : ℕ, tr_E2 r (z (r + 1)) = z r)
        (V_low V_E2 : Type u)
        [AddCommGroup V_low] [Module (Padic ℓ₀) V_low] [Module.Finite (Padic ℓ₀) V_low]
        [AddCommGroup V_E2] [Module (Padic ℓ₀) V_E2] [Module.Finite (Padic ℓ₀) V_E2]
        (frob_low : V_low →ₗ[Padic ℓ₀] V_low)
        (frob_E2 : V_E2 →ₗ[Padic ℓ₀] V_E2)
        (frobTors_low : ∀ s : ℕ, H_low s →+ H_low s)
        (frobTors_E2 : ∀ r : ℕ, H_E2 r →+ H_E2 r)
        (_ : ∀ (s : ℕ) (u : H_low (s + 1)),
          tr_low s (frobTors_low (s + 1) u) = frobTors_low s (tr_low s u))
        (equiv_low : TensorProduct ℤ ℚ ↥L_low ≃+ V_low)
        (equiv_E2 : TensorProduct ℤ ℚ ↥L_E2 ≃+ V_E2)
        (_ : ∀ (z : PadicInt ℓ₀) (x y : ↥L_low),
          (∀ s : ℕ, y.1 s = (PadicInt.toZModPow s z).val • x.1 s) →
            equiv_low (TensorProduct.tmul ℤ (1 : ℚ) y) =
              (z : Padic ℓ₀) • equiv_low (TensorProduct.tmul ℤ (1 : ℚ) x))
        (_ : ∀ (z : PadicInt ℓ₀) (x y : ↥L_E2),
          (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
            equiv_E2 (TensorProduct.tmul ℤ (1 : ℚ) y) =
              (z : Padic ℓ₀) • equiv_E2 (TensorProduct.tmul ℤ (1 : ℚ) x))
        (_ : ∀ (x y : ↥L_low),
          (∀ s : ℕ, y.1 s = frobTors_low s (x.1 s)) →
            frob_low (equiv_low (TensorProduct.tmul ℤ (1 : ℚ) x)) =
              equiv_low (TensorProduct.tmul ℤ (1 : ℚ) y))
        (_ : ∀ (x y : ↥L_E2),
          (∀ r : ℕ, y.1 r = frobTors_E2 r (x.1 r)) →
            frob_E2 (equiv_E2 (TensorProduct.tmul ℤ (1 : ℚ) x)) =
              equiv_E2 (TensorProduct.tmul ℤ (1 : ℚ) y))
        (Θ : ∀ r : ℕ, H_low (r + 1) →+ H_E2 r)
        (_ : ∀ r : ℕ, Function.Bijective (Θ r))
        (_ : ∀ (r : ℕ) (x : H_low (r + 2)),
          tr_E2 r (Θ (r + 1) x) = Θ r (tr_low (r + 1) x))
        (_ : ∀ (r : ℕ) (x : H_low (r + 1)),
          frobTors_E2 r (Θ r x) = q_card • Θ r (frobTors_low (r + 1) x))
        (H_E0 : ℕ → Type u) [∀ r, AddCommGroup (H_E0 r)]
        (tr_E0 : ∀ r : ℕ, H_E0 (r + 1) →+ H_E0 r)
        (L_E0 : AddSubgroup (∀ r : ℕ, H_E0 r))
        (_ : ∀ x : ∀ r : ℕ, H_E0 r, x ∈ L_E0 ↔ ∀ r : ℕ, tr_E0 r (x (r + 1)) = x r)
        (_ : ∀ (r : ℕ) (u : H_E0 r), (ℓ₀ ^ (r + 1)) • u = 0)
        (H_high : ℕ → Type u) [∀ s, AddCommGroup (H_high s)]
        (_ : Subsingleton (H_high 0))
        (tr_high : ∀ s : ℕ, H_high (s + 1) →+ H_high s)
        (L_high : AddSubgroup (∀ s : ℕ, H_high s))
        (_ : ∀ y : ∀ s : ℕ, H_high s, y ∈ L_high ↔ ∀ s : ℕ, tr_high s (y (s + 1)) = y s)
        (V_E0 V_high : Type u)
        [AddCommGroup V_E0] [Module (Padic ℓ₀) V_E0] [Module.Finite (Padic ℓ₀) V_E0]
        [AddCommGroup V_high] [Module (Padic ℓ₀) V_high] [Module.Finite (Padic ℓ₀) V_high]
        (frob_E0 : V_E0 →ₗ[Padic ℓ₀] V_E0)
        (frob_high : V_high →ₗ[Padic ℓ₀] V_high)
        (frobTors_E0 : ∀ r : ℕ, H_E0 r →+ H_E0 r)
        (frobTors_high : ∀ s : ℕ, H_high s →+ H_high s)
        (_ : ∀ (r : ℕ) (u : H_E0 (r + 1)),
          tr_E0 r (frobTors_E0 (r + 1) u) = frobTors_E0 r (tr_E0 r u))
        (_ : ∀ (s : ℕ) (u : H_high (s + 1)),
          tr_high s (frobTors_high (s + 1) u) = frobTors_high s (tr_high s u))
        (equiv_E0 : TensorProduct ℤ ℚ ↥L_E0 ≃+ V_E0)
        (equiv_high : TensorProduct ℤ ℚ ↥L_high ≃+ V_high)
        (_ : ∀ (z : PadicInt ℓ₀) (x y : ↥L_E0),
          (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
            equiv_E0 (TensorProduct.tmul ℤ (1 : ℚ) y) =
              (z : Padic ℓ₀) • equiv_E0 (TensorProduct.tmul ℤ (1 : ℚ) x))
        (_ : ∀ (z : PadicInt ℓ₀) (x y : ↥L_high),
          (∀ s : ℕ, y.1 s = (PadicInt.toZModPow s z).val • x.1 s) →
            equiv_high (TensorProduct.tmul ℤ (1 : ℚ) y) =
              (z : Padic ℓ₀) • equiv_high (TensorProduct.tmul ℤ (1 : ℚ) x))
        (_ : ∀ (x y : ↥L_E0),
          (∀ r : ℕ, y.1 r = frobTors_E0 r (x.1 r)) →
            frob_E0 (equiv_E0 (TensorProduct.tmul ℤ (1 : ℚ) x)) =
              equiv_E0 (TensorProduct.tmul ℤ (1 : ℚ) y))
        (_ : ∀ (x y : ↥L_high),
          (∀ s : ℕ, y.1 s = frobTors_high s (x.1 s)) →
            frob_high (equiv_high (TensorProduct.tmul ℤ (1 : ℚ) x)) =
