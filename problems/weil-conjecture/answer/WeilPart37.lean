        (Fgt_of m₂).comp (L_0 d)
      let adj_ER0 : Ext_0 ⊣ Res_0 :=
        CategoryTheory.Adjunction.mkOfHomEquiv
          { homEquiv := fun W V =>
              { toFun := fun φ => ModuleCat.ofHom
                  { toAddHom := (((adj_L d).homEquiv ((Fgt_of m₂).obj W) V) φ).hom.toAddHom
                    map_smul' := fun c w => by
                      let f_add := (((adj_L d).homEquiv ((Fgt_of m₂).obj W) V) φ).hom
                      change f_add (c • w) = c.down.val • f_add w
                      rw [hMod_smul m₂ W c w]
                      exact map_nsmul f_add c.down.val w }
                invFun := fun ψ =>
                  ((adj_L d).homEquiv ((Fgt_of m₂).obj W) V).symm
                    (AddCommGrpCat.ofHom ψ.hom.toAddHom)
                left_inv := fun φ => by
                  apply ModuleCat.hom_ext
                  apply LinearMap.ext
                  intro q
                  obtain ⟨w, rfl⟩ := QuotientAddGroup.mk_surjective q
                  rfl
                right_inv := fun ψ => by
                  apply ModuleCat.hom_ext; apply LinearMap.ext; intro w; rfl }
            homEquiv_naturality_left_symm := fun {W₁ W₂ V} f ψ => by
              apply ModuleCat.hom_ext
              apply LinearMap.ext
              intro q
              obtain ⟨w, rfl⟩ := QuotientAddGroup.mk_surjective q
              rfl
            homEquiv_naturality_right := fun {W V₁ V₂} φ g => by
              apply ModuleCat.hom_ext; apply LinearMap.ext; intro w; rfl }
      have hHSC_Res : J_X.HasSheafCompose Res_0 := hSheafCompOfAdj adj_ER0
      let Res_sh := @CategoryTheory.sheafCompose _ _ _ _ _ _ J_X Res_0 hHSC_Res
      let Tors_sh := @CategoryTheory.sheafCompose _ _ _ _ _ _ J_X (Tors_0 m₂ d) (hHSC_Tors m₂ d hd)
      let adj_RT_sh : Res_sh ⊣ Tors_sh :=
        CategoryTheory.Adjunction.mkOfHomEquiv
          { homEquiv := fun M N =>
              { toFun := fun η =>
                  CategoryTheory.InducedCategory.homMk
                    { app := fun W => ((adj_RT0 m₂ d hd).homEquiv (M.obj.obj W) (N.obj.obj W))
                        (η.hom.app W)
                      naturality := fun {W₁ W₂} f => by
                        let η₁ : Res_0.obj (M.obj.obj W₁) ⟶ N.obj.obj W₁ := η.hom.app W₁
                        let η₂ : Res_0.obj (M.obj.obj W₂) ⟶ N.obj.obj W₂ := η.hom.app W₂
                        have hnat : Res_0.map (M.obj.map f) ≫ η₂ = η₁ ≫ N.obj.map f :=
                          η.hom.naturality f
                        change M.obj.map f ≫
                            ((adj_RT0 m₂ d hd).homEquiv (M.obj.obj W₂) (N.obj.obj W₂)) η₂ =
                          ((adj_RT0 m₂ d hd).homEquiv (M.obj.obj W₁) (N.obj.obj W₁)) η₁ ≫
                            (Tors_0 m₂ d).map (N.obj.map f)
                        rw [← (adj_RT0 m₂ d hd).homEquiv_naturality_left, hnat,
                          (adj_RT0 m₂ d hd).homEquiv_naturality_right] }
                invFun := fun θ =>
                  CategoryTheory.InducedCategory.homMk
                    { app := fun W => ((adj_RT0 m₂ d hd).homEquiv (M.obj.obj W) (N.obj.obj W)).symm
                        (θ.hom.app W)
                      naturality := fun {W₁ W₂} f => by
                        let θ₁ : M.obj.obj W₁ ⟶ (Tors_0 m₂ d).obj (N.obj.obj W₁) := θ.hom.app W₁
                        let θ₂ : M.obj.obj W₂ ⟶ (Tors_0 m₂ d).obj (N.obj.obj W₂) := θ.hom.app W₂
                        have hnat : M.obj.map f ≫ θ₂ = θ₁ ≫ (Tors_0 m₂ d).map (N.obj.map f) :=
                          θ.hom.naturality f
                        change Res_0.map (M.obj.map f) ≫
                            ((adj_RT0 m₂ d hd).homEquiv (M.obj.obj W₂) (N.obj.obj W₂)).symm θ₂ =
                          ((adj_RT0 m₂ d hd).homEquiv (M.obj.obj W₁) (N.obj.obj W₁)).symm θ₁ ≫
                            N.obj.map f
                        rw [← (adj_RT0 m₂ d hd).homEquiv_naturality_right_symm, ← hnat,
                          (adj_RT0 m₂ d hd).homEquiv_naturality_left_symm] }
                left_inv := fun η => by
                  apply CategoryTheory.InducedCategory.hom_ext
                  apply CategoryTheory.NatTrans.ext
                  funext W
                  exact Equiv.symm_apply_apply _ (η.hom.app W)
                right_inv := fun θ => by
                  apply CategoryTheory.InducedCategory.hom_ext
                  apply CategoryTheory.NatTrans.ext
                  funext W
                  exact Equiv.apply_symm_apply _ (θ.hom.app W) }
            homEquiv_naturality_left_symm := fun {M₁ M₂ N} f θ => by
              apply CategoryTheory.InducedCategory.hom_ext
              apply CategoryTheory.NatTrans.ext
              funext W
              exact (adj_RT0 m₂ d hd).homEquiv_naturality_left_symm (f.hom.app W) (θ.hom.app W)
            homEquiv_naturality_right := fun {M N₁ N₂} η g => by
              apply CategoryTheory.InducedCategory.hom_ext
              apply CategoryTheory.NatTrans.ext
              funext W
              exact (adj_RT0 m₂ d hd).homEquiv_naturality_right (η.hom.app W) (g.hom.app W) }
      have : Res_sh.PreservesMonomorphisms :=
        { preserves := fun {M₁ M₂} f hf => by
            have _ := hPFL_U d
            have hMono_Ud : CategoryTheory.Mono ((U_dir d).map f) := inferInstance
            have hEq_map : (U_dir m₂).map (Res_sh.map f) = (U_dir d).map f := by
              apply CategoryTheory.InducedCategory.hom_ext
              apply CategoryTheory.NatTrans.ext
              funext W
              rfl
            have hMono_Um₂ : CategoryTheory.Mono ((U_dir m₂).map (Res_sh.map f)) := by
              rwa [hEq_map]
            refine ⟨fun {Z₀} g₁ g₂ hg => (hFaithful_U m₂).map_injective ?_⟩
            rw [← CategoryTheory.cancel_mono ((U_dir m₂).map (Res_sh.map f)),
              ← (U_dir m₂).map_comp, ← (U_dir m₂).map_comp, hg] }
      exact CategoryTheory.Injective.injective_of_adjoint adj_RT_sh I
    refine ⟨?_, ?_, ?_⟩
    · intro s M
      have _ := hPow_gt1 s
      exact hTorU (ℓ ^ (s + 1)) M
    · intro s F hF
      let m := ℓ ^ (s + 1)
      have _ : Fact (1 < m) := hPow_gt1 s
      have hF_sec : ∀ (V : (X.Etale)ᵒᵖ) (x : F.obj.obj V), m • x = 0 := by
        intro V x
        have h0 : (m • (𝟙 F : F ⟶ F)).hom.app V = 0 := by rw [hF]; rfl
        rw [hNsmul_app] at h0
        have h1 := CategoryTheory.ConcreteCategory.congr_hom h0 x
        simpa using h1
      let M_F := (C_dir m).obj F
      let e_MF : F ≅ (U_dir m).obj M_F :=
        { hom := CategoryTheory.InducedCategory.homMk
            { app := fun V => AddCommGrpCat.ofHom
                { toFun := fun x => ⟨x, hF_sec V x⟩
                  map_zero' := rfl
                  map_add' := fun _ _ => rfl }
              naturality := fun {_ _} _ => by ext x; rfl }
          inv := CategoryTheory.InducedCategory.homMk
            { app := fun V => AddCommGrpCat.ofHom
