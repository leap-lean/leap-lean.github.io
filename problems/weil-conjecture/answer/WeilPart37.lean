                      rw [hMod_smul m V c va]
                      exact map_nsmul ψ.hom c.down.val a }
                left_inv := fun φ => by
                  apply ModuleCat.hom_ext
                  apply LinearMap.ext
                  intro q
                  obtain ⟨a, rfl⟩ := QuotientAddGroup.mk_surjective q
