    let e₀_spec : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 0) k)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq₀.toRingHom)
        hom_inv_id := by
