          _ = snd_k ≫ ((u_k_k₂ ≫ g_F₂k₂) ≫ g_FF₂) := by rw [hBaseEq2]
          _ = (snd_k ≫ u_k_k₂ ≫ g_F₂k₂) ≫ g_FF₂ := by simp only [CategoryTheory.Category.assoc])
