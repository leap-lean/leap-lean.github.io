          (g_lam j' ≫ AlgebraicGeometry.Spec.map (E_diag.map θ)) 0
          p_lamj' p_Wθ p_nat rfl hp_lamj' hp_Wθ hp_nat x_j
        have hnat2 := hPullTri (AlgebraicGeometry.Spec.map (U_diag.map θ)) (g_lam j)
          (g_lam j' ≫ AlgebraicGeometry.Spec.map (E_diag.map θ)) 0
          p_Uθ p_lamj p_nat (hglam_θ θ).symm hp_Uθ hp_lamj hp_nat x_j
        have hlam_zero : p_lamj' (p_Wθ x_j) = 0 := by
          rw [← hnat1, hnat2, hθ_zero p_Uθ hp_Uθ]
        have hxθ_zero : p_Wθ x_j = 0 :=
          (hBij_lam j' p_lamj' hp_lamj').1 (hlam_zero.trans (map_zero p_lamj').symm)
        have hcoc := hPullTri (u_W j') (AlgebraicGeometry.Spec.map (E_diag.map θ)) (u_W j) 0
          p_Wj' p_Wθ p_Wj (huW_θ θ) hp_Wj' hp_Wθ hp_Wj x_j
        rw [← hx_eq, hcoc, hxθ_zero, map_zero]
      intro x₁ x₂ hx₁₂
      have hsub : ψ₀ (x₁ - x₂) = 0 := by
        rw [map_sub, hx₁₂, sub_self]
      exact sub_eq_zero.mp (hker (x₁ - x₂) hsub)
    · intro y
      obtain ⟨j, y_j, hy_j⟩ := hLift_U y
      obtain ⟨p_Wj, hp_Wj⟩ := hPullEx (u_W j) ℓ 0
      obtain ⟨p_Uj, hp_Uj⟩ := hPullEx (u_U j) ℓ 0
      obtain ⟨p_lamj, hp_lamj⟩ := hPullEx (g_lam j) ℓ 0
      obtain ⟨p_sq, hp_sq⟩ := hPullEx (u_U j ≫ g_lam j) ℓ 0
      obtain ⟨x_j, hx_j⟩ := (hBij_lam j p_lamj hp_lamj).2 y_j
      refine ⟨p_Wj x_j, ?_⟩
      have hsq1 := hPullTri (u_U j) (g_lam j) (u_U j ≫ g_lam j) 0
        p_Uj p_lamj p_sq rfl hp_Uj hp_lamj hp_sq x_j
      have hsq2 := hPullTri (CategoryTheory.Limits.pullback.snd j_A w) (u_W j)
        (u_U j ≫ g_lam j) 0 ψ₀ p_Wj p_sq (hSq_j j).symm hψ₀ hp_Wj hp_sq x_j
      rw [← hsq2, hsq1, hx_j, hy_j p_Uj hp_Uj]
  · intro b hb
    refine weil_odp_val_acyc_higherDirectImage_zero_of_stage_effacement ℓ b j_d j_A ?_
    intro W _ w _ ξ
    obtain ⟨𝒥, hCatJ, hFiltJ, E_diag, U_diag, lam_diag, c_W, hc_W, c_U, hc_U, lam_inf,
      e_W, e_WU, -, hStages⟩ :=
      weil_odp_val_acyc_affine_etale_colimit_and_kummer_stage_descent
        k d_rel ℓ R_bar p_R t_bar ht_eq Ω φ_R_Ω hLoc ℐ D α c hc e_pt hCocone hStage W w
    let _ : CategoryTheory.SmallCategory 𝒥 := hCatJ
    let _ : CategoryTheory.IsFiltered 𝒥 := hFiltJ
    obtain ⟨hLift_U, -⟩ :=
      weil_odp_val_acyc_filtered_colimit_torsionH ℓ b 𝒥 U_diag c_U hc_U
        (CategoryTheory.Limits.pullback j_A w) e_WU
    obtain ⟨j, ξ_Uj, hξ_Uj⟩ := hLift_U ξ
    obtain ⟨w_j, hw_j, e_Uj, he_Uj_snd, hPb_j,
      j₁, θ, w₁, hw₁, e_Uj₁, he_Uj₁_snd, hPb_j₁, hfst_θ, hsnd_θ⟩ := hStages j
    obtain ⟨p_eUj_inv, hp_eUj_inv⟩ := hPullEx e_Uj.inv ℓ b
    let τ_j : W ⟶ AlgebraicGeometry.Spec (E_diag.obj j) :=
      e_W.inv ≫ AlgebraicGeometry.Spec.map (c_W.ι.app j)
    let τ_Uj : CategoryTheory.Limits.pullback j_A w ⟶
        CategoryTheory.Limits.pullback j_d w_j :=
      e_WU.inv ≫ AlgebraicGeometry.Spec.map (c_U.ι.app j) ≫ e_Uj.hom
    have hp_τ_j : ∀ (p_τ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j_d w_j) ℓ b →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback j_A w) ℓ b),
        WeilIsTorsionEtalePullback τ_Uj ℓ b p_τ → p_τ (p_eUj_inv ξ_Uj) = ξ := by
      intro p_τ hp_τ
      obtain ⟨p_uUj, hp_uUj⟩ :=
        hPullEx (e_WU.inv ≫ AlgebraicGeometry.Spec.map (c_U.ι.app j)) ℓ b
      have hτ_inv : τ_Uj ≫ e_Uj.inv =
          e_WU.inv ≫ AlgebraicGeometry.Spec.map (c_U.ι.app j) := by
        dsimp only [τ_Uj]
        rw [Category.assoc, Category.assoc, e_Uj.hom_inv_id, Category.comp_id]
      have htri := hPullTri τ_Uj e_Uj.inv
        (e_WU.inv ≫ AlgebraicGeometry.Spec.map (c_U.ι.app j)) b
        p_τ p_eUj_inv p_uUj hτ_inv hp_τ hp_eUj_inv hp_uUj ξ_Uj
      exact htri.symm.trans (hξ_Uj p_uUj hp_uUj)
    by_cases hb2 : 2 ≤ b
    · exact Or.inl ⟨AlgebraicGeometry.Spec (E_diag.obj j), w_j, hw_j,
        τ_j, τ_Uj, p_eUj_inv ξ_Uj, hPb_j, hPur2 b hb2, hp_τ_j⟩
    · have hb1 : b = 1 := by omega
      subst hb1
      let _ : AlgebraicGeometry.Etale w_j := hw_j
      let _ : AlgebraicGeometry.Etale w₁ := hw₁
      let π_W : AlgebraicGeometry.Spec (E_diag.obj j₁) ⟶
          AlgebraicGeometry.Spec (E_diag.obj j) :=
        AlgebraicGeometry.Spec.map (E_diag.map θ)
      let π_WU : CategoryTheory.Limits.pullback j_d w₁ ⟶
          CategoryTheory.Limits.pullback j_d w_j :=
        e_Uj₁.inv ≫ AlgebraicGeometry.Spec.map (U_diag.map θ) ≫ e_Uj.hom
      have hcomm_πWU : π_WU ≫ CategoryTheory.Limits.pullback.snd j_d w_j =
          CategoryTheory.Limits.pullback.snd j_d w₁ ≫ π_W := by
        dsimp only [π_WU, π_W]
        calc (e_Uj₁.inv ≫ AlgebraicGeometry.Spec.map (U_diag.map θ) ≫ e_Uj.hom) ≫
                CategoryTheory.Limits.pullback.snd j_d w_j
            = e_Uj₁.inv ≫ (AlgebraicGeometry.Spec.map (U_diag.map θ) ≫
                (e_Uj.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_j)) := by
                simp only [Category.assoc]
          _ = e_Uj₁.inv ≫ AlgebraicGeometry.Spec.map (lam_diag.app j ≫ U_diag.map θ) := by
                rw [he_Uj_snd, ← AlgebraicGeometry.Spec.map_comp]
          _ = e_Uj₁.inv ≫ AlgebraicGeometry.Spec.map (E_diag.map θ ≫ lam_diag.app j₁) := by
                rw [← lam_diag.naturality θ]
          _ = e_Uj₁.inv ≫ AlgebraicGeometry.Spec.map (lam_diag.app j₁) ≫
                AlgebraicGeometry.Spec.map (E_diag.map θ) := by
                rw [AlgebraicGeometry.Spec.map_comp]
          _ = (e_Uj₁.inv ≫ e_Uj₁.hom) ≫ CategoryTheory.Limits.pullback.snd j_d w₁ ≫
                AlgebraicGeometry.Spec.map (E_diag.map θ) := by
                rw [← he_Uj₁_snd]
                simp only [Category.assoc]
                rfl
          _ = CategoryTheory.Limits.pullback.snd j_d w₁ ≫
                AlgebraicGeometry.Spec.map (E_diag.map θ) := by
                rw [e_Uj₁.inv_hom_id, Category.id_comp]
      obtain ⟨p_WU, hp_WU⟩ := hPullEx π_WU ℓ 1
      obtain ⟨I, V, -, v, hEt_v, hCover, hKill⟩ :=
        hPur1 (AlgebraicGeometry.Spec (E_diag.obj j))
          (AlgebraicGeometry.Spec (E_diag.obj j₁))
          w_j w₁ π_W π_WU hfst_θ hsnd_θ hcomm_πWU (p_eUj_inv ξ_Uj) p_WU hp_WU
      let τ_j₁ : W ⟶ AlgebraicGeometry.Spec (E_diag.obj j₁) :=
        e_W.inv ≫ AlgebraicGeometry.Spec.map (c_W.ι.app j₁)
      let τ_Uj₁ : CategoryTheory.Limits.pullback j_A w ⟶
          CategoryTheory.Limits.pullback j_d w₁ :=
        e_WU.inv ≫ AlgebraicGeometry.Spec.map (c_U.ι.app j₁) ≫ e_Uj₁.hom
      have hτ_comp : τ_Uj₁ ≫ π_WU = τ_Uj := by
        dsimp only [τ_Uj₁, π_WU, τ_Uj]
        calc (e_WU.inv ≫ AlgebraicGeometry.Spec.map (c_U.ι.app j₁) ≫ e_Uj₁.hom) ≫
                (e_Uj₁.inv ≫ AlgebraicGeometry.Spec.map (U_diag.map θ) ≫ e_Uj.hom)
            = e_WU.inv ≫ AlgebraicGeometry.Spec.map (c_U.ι.app j₁) ≫
                (e_Uj₁.hom ≫ e_Uj₁.inv) ≫
                AlgebraicGeometry.Spec.map (U_diag.map θ) ≫ e_Uj.hom := by
                simp only [Category.assoc]
          _ = e_WU.inv ≫ (AlgebraicGeometry.Spec.map (c_U.ι.app j₁) ≫
                AlgebraicGeometry.Spec.map (U_diag.map θ)) ≫ e_Uj.hom := by
                rw [e_Uj₁.hom_inv_id, Category.id_comp]
                simp only [Category.assoc]
          _ = e_WU.inv ≫ AlgebraicGeometry.Spec.map (U_diag.map θ ≫ c_U.ι.app j₁) ≫
                e_Uj.hom := by
                rw [← AlgebraicGeometry.Spec.map_comp]
          _ = e_WU.inv ≫ AlgebraicGeometry.Spec.map (c_U.ι.app j) ≫ e_Uj.hom := by
                rw [c_U.w θ]
      have hp_τ_j₁ : ∀ (p_τ₁ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j_d w₁) ℓ 1 →+
            weilEtaleTorsionH (CategoryTheory.Limits.pullback j_A w) ℓ 1),
          WeilIsTorsionEtalePullback τ_Uj₁ ℓ 1 p_τ₁ →
          p_τ₁ (p_WU (p_eUj_inv ξ_Uj)) = ξ := by
        intro p_τ₁ hp_τ₁
        obtain ⟨p_τ₀, hp_τ₀⟩ := hPullEx τ_Uj ℓ 1
        have htri := hPullTri τ_Uj₁ π_WU τ_Uj 1 p_τ₁ p_WU p_τ₀ hτ_comp
          hp_τ₁ hp_WU hp_τ₀ (p_eUj_inv ξ_Uj)
        exact htri.symm.trans (hp_τ_j p_τ₀ hp_τ₀)
      exact Or.inr ⟨AlgebraicGeometry.Spec (E_diag.obj j₁), w₁, hw₁,
        τ_j₁, τ_Uj₁, p_WU (p_eUj_inv ξ_Uj), I, V, v, hEt_v, hPb_j₁, hCover, hp_τ_j₁, hKill⟩

theorem weil_odp_punct_sm_etale_atlas_mod_prime_pullback_bijective (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Y U X X_U : AlgebraicGeometry.Scheme.{u}}
    (j_Y : U ⟶ Y) (j_X : X_U ⟶ X)
    (hBij0_Y : ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
        (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback j_Y w) ℓ 0),
      WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j_Y w) ℓ 0 ψ₀ →
      Function.Bijective ψ₀)
    (hZero_Y : ∀ (b : ℕ), 1 ≤ b →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage j_Y b (weilEtaleTorsionSheaf U ℓ)))
    (hAtlas : ∀ x : ↥X,
      ∃ (V : X.Opens) (_ : x ∈ V)
        (φ : V.toScheme ⟶ Y) (_ : AlgebraicGeometry.Etale φ)
        (V_U : AlgebraicGeometry.Scheme.{u})
        (ι_VU : V_U ⟶ X_U) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ U),
        CategoryTheory.IsPullback ι_VU j_V j_X V.ι ∧
        CategoryTheory.IsPullback φ_U j_V j_Y φ)
    (q : ℕ)
    (ψ_q : weilEtaleTorsionH X ℓ q →+ weilEtaleTorsionH X_U ℓ q)
    (hψ_q : WeilIsTorsionEtalePullback j_X ℓ q ψ_q) :
    Function.Bijective ψ_q :=
by
  classical
  let P_et : MorphismProperty Scheme.{u} := @AlgebraicGeometry.Etale
  obtain ⟨hPullEx, hPullId, hPullComp, -, -⟩ := weil_etale_torsion_pullback_functoriality.{u}

  have hCont_pull : ∀ {Z₁ Z₂ : Scheme.{u}} (h : Z₁ ⟶ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := by
    intro Z₁ Z₂ h
    obtain ⟨_, hc, _⟩ := hPullEx h ℓ 0
    exact hc

  have hCont_map : ∀ {S' S : Scheme.{u}} {v : S' ⟶ S} (hv : Etale v),
      (MorphismProperty.Over.map (P := P_et) ⊤ hv).IsContinuous
        S'.smallEtaleTopology S.smallEtaleTopology := by
    intro S' S v hv
    let M_v : Functor S'.Etale S.Etale := MorphismProperty.Over.map (P := P_et) ⊤ hv
    have hCov : CoverPreserving S'.smallEtaleTopology S.smallEtaleTopology M_v := by
      refine CoverPreserving.mk ?_
      intro U₀ R hR
      have hEq1 := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S' (le_refl P_et)
      have hEq2 := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S (le_refl P_et)
      have hR' : R ∈ (Scheme.smallPretopology P_et P_et).toGrothendieck U₀ :=
        Eq.mp (congrArg (fun T => R ∈ T U₀) hEq1) hR
      have hMem := (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U₀ R).mp hR'
      have hGoal : Sieve.functorPushforward M_v R ∈
          (Scheme.smallPretopology P_et P_et).toGrothendieck (M_v.obj U₀) := by
        refine (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) (M_v.obj U₀) _).mpr ?_
        intro x
        obtain ⟨V, f, y, hfR, hfEt, hfy⟩ := hMem x
        exact ⟨M_v.obj V, M_v.map f, y, ⟨V, f, 𝟙 (M_v.obj V), hfR, (Category.id_comp _).symm⟩, hfEt, hfy⟩
      exact Eq.mpr (congrArg (fun T => Sieve.functorPushforward M_v R ∈ T (M_v.obj U₀)) hEq2) hGoal
    have hCompat : CompatiblePreserving S.smallEtaleTopology M_v := by
      refine CompatiblePreserving.mk ?_
      intro ℱ W T x hx Y₁ Y₂ Z f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
      let z_hom : Quiver.Hom Z.left S := Z.hom
      let y₁_hom : Quiver.Hom Y₁.left S' := Y₁.hom
      let y₂_hom : Quiver.Hom Y₂.left S' := Y₂.hom
      let w_hom : Quiver.Hom W.left S' := W.hom
      let f₁_l : Quiver.Hom Z.left Y₁.left := f₁.left
      let f₂_l : Quiver.Hom Z.left Y₂.left := f₂.left
      let g₁_l : Quiver.Hom Y₁.left W.left := g₁.left
      let g₂_l : Quiver.Hom Y₂.left W.left := g₂.left
      have hfg_l : CategoryStruct.comp f₁_l g₁_l = CategoryStruct.comp f₂_l g₂_l :=
        congrArg (fun m => m.left) hfg
      let w_Z : Quiver.Hom Z.left S' := CategoryStruct.comp f₁_l y₁_hom
      have hw_Zv : CategoryStruct.comp w_Z v = z_hom :=
        (Category.assoc f₁_l y₁_hom v).trans (MorphismProperty.Over.w f₁)
      have hw_Z : P_et w_Z :=
        MorphismProperty.of_postcomp P_et w_Z v hv (hw_Zv.symm ▸ Z.prop)
      have hw₂ : CategoryStruct.comp f₂_l y₂_hom = w_Z := by
        have hg₁_w : CategoryStruct.comp g₁_l w_hom = y₁_hom := MorphismProperty.Over.w g₁
        have hg₂_w : CategoryStruct.comp g₂_l w_hom = y₂_hom := MorphismProperty.Over.w g₂
        calc CategoryStruct.comp f₂_l y₂_hom
            = CategoryStruct.comp f₂_l (CategoryStruct.comp g₂_l w_hom) :=
              congrArg (CategoryStruct.comp f₂_l) hg₂_w.symm
          _ = CategoryStruct.comp (CategoryStruct.comp f₂_l g₂_l) w_hom :=
              (Category.assoc f₂_l g₂_l w_hom).symm
          _ = CategoryStruct.comp (CategoryStruct.comp f₁_l g₁_l) w_hom :=
              congrArg (fun k => CategoryStruct.comp k w_hom) hfg_l.symm
          _ = CategoryStruct.comp f₁_l (CategoryStruct.comp g₁_l w_hom) :=
              Category.assoc f₁_l g₁_l w_hom
          _ = w_Z := congrArg (CategoryStruct.comp f₁_l) hg₁_w
      let Z_S' : S'.Etale := MorphismProperty.Over.mk ⊤ w_Z hw_Z
      let f₁_lift : Quiver.Hom Z_S' Y₁ := MorphismProperty.Over.homMk f₁_l rfl trivial
      let f₂_lift : Quiver.Hom Z_S' Y₂ := MorphismProperty.Over.homMk f₂_l hw₂ trivial
      have h_lift_eq : CategoryStruct.comp f₁_lift g₁ = CategoryStruct.comp f₂_lift g₂ :=
        MorphismProperty.Comma.Hom.ext hfg_l (Subsingleton.elim _ _)
      have hx_eq := hx f₁_lift f₂_lift hg₁ hg₂ h_lift_eq
      let ι_Z : Quiver.Hom Z (M_v.obj Z_S') :=
        MorphismProperty.Over.homMk (CategoryStruct.id Z.left)
          ((Category.id_comp _).trans hw_Zv) trivial
      have hι₁ : CategoryStruct.comp ι_Z (M_v.map f₁_lift) = f₁ :=
        MorphismProperty.Comma.Hom.ext (Category.id_comp f₁_l) (Subsingleton.elim _ _)
      have hι₂ : CategoryStruct.comp ι_Z (M_v.map f₂_lift) = f₂ :=
        MorphismProperty.Comma.Hom.ext (Category.id_comp f₂_l) (Subsingleton.elim _ _)
      have hmap₁ : ℱ.obj.map f₁.op =
          CategoryStruct.comp (ℱ.obj.map (M_v.map f₁_lift).op) (ℱ.obj.map ι_Z.op) := by
        rw [← hι₁, op_comp, ℱ.obj.map_comp]
      have hmap₂ : ℱ.obj.map f₂.op =
          CategoryStruct.comp (ℱ.obj.map (M_v.map f₂_lift).op) (ℱ.obj.map ι_Z.op) := by
        rw [← hι₂, op_comp, ℱ.obj.map_comp]
      change (ConcreteCategory.hom (ℱ.obj.map f₁.op)) (x g₁ hg₁) =
        (ConcreteCategory.hom (ℱ.obj.map f₂.op)) (x g₂ hg₂)
      rw [hmap₁, hmap₂]
      exact congrArg (ConcreteCategory.hom (ℱ.obj.map ι_Z.op)) hx_eq
    exact Functor.isContinuous_of_coverPreserving hCompat hCov

  have hZero_X : ∀ (b : ℕ), 1 ≤ b →
      Limits.IsZero (weilEtaleHigherDirectImage j_X b (weilEtaleTorsionSheaf X_U ℓ)) := by
    let P_et : MorphismProperty Scheme.{u} := @AlgebraicGeometry.Etale
    have _ : ∀ {Z₁ Z₂ : Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        MorphismProperty.HasPullbacksAlong P_et h :=
      fun _ => MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have _ : ∀ {Z₁ Z₂ : Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        MorphismProperty.IsStableUnderBaseChangeAlong P_et h :=
      fun _ => MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

    have hShPullSheafify : ∀ {S' S : Scheme.{u}} {v : S' ⟶ S} (hv : Etale v)
        (Q : Functor (Opposite S.Etale) AddCommGrpCat.{u}),
        let M_v : Functor S'.Etale S.Etale := MorphismProperty.Over.map (P := P_et) ⊤ hv
        let shPull_v : Functor (Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
            (Sheaf S'.smallEtaleTopology AddCommGrpCat.{u}) :=
          @Functor.sheafPushforwardContinuous _ _ _ _ M_v AddCommGrpCat.{u} _
            S'.smallEtaleTopology S.smallEtaleTopology (hCont_map hv)
        Nonempty (shPull_v.obj ((presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Q) ≅
          (presheafToSheaf S'.smallEtaleTopology AddCommGrpCat.{u}).obj (M_v.op.comp Q)) := by
      intro S' S v hv Q M_v shPull_v
      let B_v := weilEtaleSitePullback v
      let J_S' := S'.smallEtaleTopology
      let J_S := S.smallEtaleTopology
      let pf_v : Functor (Sheaf J_S' AddCommGrpCat.{u}) (Sheaf J_S AddCommGrpCat.{u}) :=
        @Functor.sheafPushforwardContinuous _ _ _ _ B_v AddCommGrpCat.{u} _
          J_S J_S' (hCont_pull v)
      let W_Mv := (Functor.whiskeringLeft (Opposite S'.Etale) (Opposite S.Etale)
        AddCommGrpCat.{u}).obj M_v.op
      let W_Bv := (Functor.whiskeringLeft (Opposite S.Etale) (Opposite S'.Etale)
        AddCommGrpCat.{u}).obj B_v.op
      let adj_site : M_v ⊣ B_v := MorphismProperty.Over.mapPullbackAdj P_et ⊤ v hv trivial
      let adj_W : W_Mv ⊣ W_Bv :=
        Adjunction.mkOfUnitCounit
          { unit :=
              { app := fun P =>
                  { app := fun W => P.map (adj_site.counit.app W.unop).op
                    naturality := fun {W₁ W₂} u => by
                      change P.map u.unop.op ≫ P.map (adj_site.counit.app W₂.unop).op =
                        P.map (adj_site.counit.app W₁.unop).op ≫ P.map (M_v.map (B_v.map u.unop)).op
                      rw [← P.map_comp, ← P.map_comp, ← op_comp, ← op_comp]
                      exact congrArg (fun k => P.map k.op) (adj_site.counit.naturality u.unop).symm }
                naturality := fun {_ _} φ => by ext W : 2; exact (φ.naturality _).symm }
            counit :=
              { app := fun P =>
                  { app := fun U₀ => P.map (adj_site.unit.app U₀.unop).op
