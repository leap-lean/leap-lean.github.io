              AlgebraicGeometry.Scheme.Hom.appLE_map p_Q hU₀_W
                (CategoryTheory.homOfLE (inf_le_left : U_ov ≤ U₀)).op
            exact congrArg (fun f : Q_m.left.presheaf.obj (Opposite.op W_b) ⟶ _ => f.hom r)
              (h1.trans h0.symm)
          rw [hCr_ov, ← hψ₀_C r]
          have hω0 := congrArg (fun f : _ →+* _ => f (ψ₀ (Polynomial.C r))) hω_res₀
          change ω (res₀ (ψ₀ (Polynomial.C r))) = ι_L (ψ₀.symm (ψ₀ (Polynomial.C r))) at hω0
          rw [hω0, ψ₀.symm_apply_apply]
        · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
            σ_L, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          have hu_X : IsUnit (ι_L X_poly) := IsLocalization.Away.algebraMap_isUnit X_poly
          apply hu_X.mul_left_cancel
          have hω_X0 : ω (res₀ (ψ₀ X_poly)) = ι_L X_poly := by
            have h0 := congrArg (fun f : _ →+* _ => f (ψ₀ X_poly)) hω_res₀
            change ω (res₀ (ψ₀ X_poly)) = ι_L (ψ₀.symm (ψ₀ X_poly)) at h0
            rwa [ψ₀.symm_apply_apply] at h0
          calc ι_L X_poly * ω (res₁ (ψ₁ X_poly))
            _ = ω (res₀ (ψ₀ X_poly)) * ω (res₁ (ψ₁ X_poly)) := by rw [← hω_X0]
            _ = ω (res₀ (ψ₀ X_poly) * res₁ (ψ₁ X_poly)) := (map_mul ω _ _).symm
            _ = ω 1 := congrArg ω hProd1
            _ = 1 := map_one ω
            _ = ι_L X_poly * IsLocalization.Away.invSelf (S := L_X) X_poly :=
