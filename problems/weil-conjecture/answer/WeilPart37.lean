      (2 * m) hSm_WQ

  exact ⟨x_s0, U_s, Z_tilde_s, Q_s, hGeom_Zts, hProp_Zts, hSm_Zts, hProp_Qs, hSm_Qs,
    π_s, i_Q, ι_Q2, ⟨hx_s0_fst, hx_s0_sec⟩, hUs_eq, ⟨hProp_πs, hIso_πs⟩,
    ⟨hiQ_cl, hiQ_compl, hPb_iQ⟩, ⟨hι_Q2_hom, hSplit_Q2⟩⟩

theorem weil_split_quad_dim_zero_and_p1_chart_decomp (K : Type u) [Field K] :
    (∀ (Q₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      (ι₀ : Q₀.left ⟶ (weilProjectiveSpaceOver K (2 * 0 + 1)).left),
      ι₀ ≫ (weilProjectiveSpaceOver K (2 * 0 + 1)).hom = Q₀.hom →
      IsHomogeneousHypersurfacePullbackOver K (2 * 0 + 1) 2
        (𝟙 (weilProjectiveSpaceOver K (2 * 0 + 1)))
        (∑ j ∈ Finset.range (0 + 1),
          if h : 2 * j + 1 < 2 * 0 + 1 + 1 then
            (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
              MvPolynomial (Fin (2 * 0 + 1 + 1)) K) *
              MvPolynomial.X ⟨2 * j + 1, h⟩
          else 0)
        ι₀ →
      ∃ (U₀ U₁ : Q₀.left.Opens),
        U₀ ⊓ U₁ = ⊥ ∧
        U₀ ⊔ U₁ = ⊤ ∧
        CategoryTheory.IsIso (U₀.ι ≫ Q₀.hom) ∧
        CategoryTheory.IsIso (U₁.ι ≫ Q₀.hom)) ∧
    (AlgebraicGeometry.GeometricallyIrreducible (weilProjectiveSpaceOver K 1).hom ∧
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver K 1).hom ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver K 1).hom ∧
      ∃ (i₀_P1 : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ (weilProjectiveSpaceOver K 1).left)
        (V_P1 : (weilProjectiveSpaceOver K 1).left.Opens)
        (s_inf_P1 : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ V_P1.toScheme)
        (e_VP1 : V_P1.toScheme ≅ (weilAffineSpaceOver K 1).left),
        i₀_P1 ≫ (weilProjectiveSpaceOver K 1).hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) ∧
        AlgebraicGeometry.IsClosedImmersion i₀_P1 ∧
        (V_P1 : Set (weilProjectiveSpaceOver K 1).left) = (Set.range i₀_P1.base)ᶜ ∧
        s_inf_P1 ≫ V_P1.ι ≫ (weilProjectiveSpaceOver K 1).hom =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) ∧
        e_VP1.hom ≫ (weilAffineSpaceOver K 1).hom =
          V_P1.ι ≫ (weilProjectiveSpaceOver K 1).hom) :=
by
  let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin 2) K
  letI : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
  let S_K : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K)
  let P1_sch : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜₁
  let P1_hom : P1_sch ⟶ S_K :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜₁ ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥(𝒜₁ 0)))
  let A1_sch : AlgebraicGeometry.Scheme.{u} :=
    AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) K))
  let A1_hom : A1_sch ⟶ S_K :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin 1) K))
  have hX : ∀ μ : Fin 2, (MvPolynomial.X μ : MvPolynomial (Fin 2) K) ∈ 𝒜₁ 1 :=
    fun μ => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K μ)

  
  have hMonEq : ∀ (d : Fin 2 →₀ ℕ) (c : K),
      (MvPolynomial.monomial d c : MvPolynomial (Fin 2) K) =
        MvPolynomial.C c * (MvPolynomial.X 0) ^ (d 0) * (MvPolynomial.X 1) ^ (d 1) := by
    intro d c
    rw [MvPolynomial.monomial_eq,
      Finsupp.prod_of_support_subset d (Finset.subset_univ _) _ (fun _ _ => pow_zero _),
      Fin.prod_univ_two, ← mul_assoc]

  have hCoeffDeg : ∀ {G : MvPolynomial (Fin 2) K} {n : ℕ},
      MvPolynomial.IsHomogeneous G n →
      ∀ (d : Fin 2 →₀ ℕ), G.coeff d ≠ 0 → d 0 + d 1 = n := by
    intro G n hG d hd
    have hw := hG hd
    rw [Finsupp.weight_apply,
      Finsupp.sum_of_support_subset d (Finset.subset_univ _) _ (fun _ _ => by simp),
      Fin.sum_univ_two] at hw
    simpa using hw

  have hMonHom : ∀ {G : MvPolynomial (Fin 2) K} {n : ℕ},
      MvPolynomial.IsHomogeneous G n → ∀ d ∈ G.support, d 0 + d 1 = n := by
    intro G n hG d hd
    exact hCoeffDeg hG d (MvPolynomial.mem_support_iff.mp hd)

  have hκ0_bij : Function.Bijective (algebraMap K ↥(𝒜₁ 0)) := by
    refine ⟨?_, ?_⟩
    · intro c₁ c₂ h
      have h1 : (MvPolynomial.C c₁ : MvPolynomial (Fin 2) K) = MvPolynomial.C c₂ :=
        congrArg Subtype.val h
      have h2 := congrArg (fun p : MvPolynomial (Fin 2) K => p.coeff 0) h1
      simpa using h2
    · intro x
      refine ⟨x.1.coeff 0, Subtype.ext ?_⟩
      change MvPolynomial.C (x.1.coeff 0) = x.1
      ext d
      by_cases hd : d = 0
      · subst hd
        simp
      · rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr (fun h0 => False.elim (hd h0.symm))]
        by_contra hne
        have hsum := hCoeffDeg ((MvPolynomial.mem_homogeneousSubmodule 0 x.1).mp x.2) d (Ne.symm hne)
        apply hd
        ext i
        fin_cases i <;> simp at * <;> omega

  have hCov : ∀ p : ProjectiveSpectrum 𝒜₁,
      (MvPolynomial.X 0 : MvPolynomial (Fin 2) K) ∉ p.asHomogeneousIdeal ∨
      (MvPolynomial.X 1 : MvPolynomial (Fin 2) K) ∉ p.asHomogeneousIdeal := by
    intro p
    by_contra hnot
    have hX0_mem : (MvPolynomial.X 0 : MvPolynomial (Fin 2) K) ∈ p.asHomogeneousIdeal := by
      by_contra h0
      exact hnot (Or.inl h0)
    have hX1_mem : (MvPolynomial.X 1 : MvPolynomial (Fin 2) K) ∈ p.asHomogeneousIdeal := by
      by_contra h1
      exact hnot (Or.inr h1)
    apply p.not_irrelevant_le
    intro Q hQ
    have hQ0 : Q.coeff 0 = 0 := by
      classical
      have hsum := DirectSum.sum_support_decompose 𝒜₁ Q
      have hc := congrArg (fun p : MvPolynomial (Fin 2) K => p.coeff 0) hsum.symm
      dsimp at hc
      rw [hc, MvPolynomial.coeff_sum]
      apply Finset.sum_eq_zero
      intro i _
      by_cases hi : i = 0
      · subst hi
        have h0 : (DirectSum.decompose 𝒜₁ Q 0 : MvPolynomial (Fin 2) K) = 0 :=
          (HomogeneousIdeal.mem_irrelevant_iff 𝒜₁ Q).mp hQ
        simp [h0]
      · by_contra hne
        have hdeg := hCoeffDeg
          ((MvPolynomial.mem_homogeneousSubmodule i _).mp (DirectSum.decompose 𝒜₁ Q i).2) 0 hne
        simp at hdeg
        exact hi hdeg.symm
    change Q ∈ p.asHomogeneousIdeal.toIdeal
    rw [MvPolynomial.as_sum Q]
    apply Ideal.sum_mem
    intro d hd_mem
    have hd_ne : d ≠ 0 := by
      intro hd0
      subst hd0
      exact (MvPolynomial.mem_support_iff.mp hd_mem) hQ0
    have hd_nz : d 0 ≠ 0 ∨ d 1 ≠ 0 := by
      by_contra hboth
      have h00 : d 0 = 0 := by
        by_contra h0
        exact hboth (Or.inl h0)
      have h01 : d 1 = 0 := by
        by_contra h1
        exact hboth (Or.inr h1)
      apply hd_ne
      ext j
      fin_cases j
      · exact h00
      · exact h01
    rw [hMonEq d (Q.coeff d)]
    rcases hd_nz with hd0 | hd1
    · obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hd0
      rw [hk, pow_succ]
      convert Ideal.mul_mem_left p.asHomogeneousIdeal.toIdeal
        (MvPolynomial.C (Q.coeff d) * MvPolynomial.X 0 ^ k * MvPolynomial.X 1 ^ d 1) hX0_mem using 1
      ring
    · obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hd1
      rw [hk, pow_succ, ← mul_assoc]
      exact Ideal.mul_mem_left _ _ hX1_mem

  
  let F_split : MvPolynomial (Fin (2 * 0 + 1 + 1)) K :=
    ∑ j ∈ Finset.range (0 + 1),
      if h : 2 * j + 1 < 2 * 0 + 1 + 1 then
        (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
          MvPolynomial (Fin (2 * 0 + 1 + 1)) K) *
          MvPolynomial.X ⟨2 * j + 1, h⟩
      else 0

  have hF_eq : F_split = MvPolynomial.X 0 * MvPolynomial.X 1 := by
    dsimp [F_split]
    rw [Finset.sum_singleton]
    split_ifs with h
    · rfl
    · omega

  have hEquiv : ∀ μ : Fin 2,
      let μ' : Fin 2 := if μ = 0 then 1 else 0
      ∃ e : MvPolynomial (Fin 1) K ≃+* HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X μ),
        (∀ c : K,
          e (MvPolynomial.C c) =
            HomogeneousLocalization.fromZeroRingHom 𝒜₁ (Submonoid.powers (MvPolynomial.X μ))
              (algebraMap K ↥(𝒜₁ 0) c)) ∧
        e (MvPolynomial.X 0) =
          HomogeneousLocalization.Away.isLocalizationElem (hX μ) (hX μ') ∧
        ∀ hF : F_split ∈ 𝒜₁ (2 • 1),
          e (MvPolynomial.X 0) =
            HomogeneousLocalization.Away.mk 𝒜₁ (hX μ) 2 F_split hF := by
    intro μ
    let μ' : Fin 2 := if μ = 0 then 1 else 0
    have hμμ' : μ' ≠ μ := by
      fin_cases μ <;> decide
    let M_μ : Submonoid (MvPolynomial (Fin 2) K) := Submonoid.powers (MvPolynomial.X μ)
    let H_μ := HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X μ)
    have hpow_mem : ∀ n : ℕ, (MvPolynomial.X μ : MvPolynomial (Fin 2) K) ^ n ∈ M_μ :=
      fun n => pow_mem (Submonoid.mem_powers (MvPolynomial.X μ)) n
    let ι_K : K →+* H_μ :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜₁ M_μ).comp (algebraMap K ↥(𝒜₁ 0))
    let t_μ : H_μ := HomogeneousLocalization.Away.isLocalizationElem (hX μ) (hX μ')
    let α_μ : MvPolynomial (Fin 1) K →+* H_μ :=
      MvPolynomial.eval₂Hom ι_K (fun _ : Fin 1 => t_μ)
    let w_μ : Fin 2 → MvPolynomial (Fin 1) K :=
      fun j => if j = μ then 1 else MvPolynomial.X 0
    let dehom_μ : MvPolynomial (Fin 2) K →+* MvPolynomial (Fin 1) K :=
      MvPolynomial.eval₂Hom MvPolynomial.C w_μ
    have hdehom_M : ∀ y : M_μ, dehom_μ y.1 = 1 := by
      rintro ⟨_, n, rfl⟩
      simp [dehom_μ, w_μ]
    have hUnit_M : ∀ y : M_μ, IsUnit (dehom_μ y.1) := by
      intro y
      rw [hdehom_M y]
      exact isUnit_one
    let β_loc : Localization M_μ →+* MvPolynomial (Fin 1) K :=
      IsLocalization.lift (M := M_μ) (g := dehom_μ) hUnit_M
    have hβ_loc_mk : ∀ (G : MvPolynomial (Fin 2) K) (y : M_μ),
        β_loc (Localization.mk G y) = dehom_μ G := by
      intro G y
      rw [Localization.mk_eq_mk']
      exact (IsLocalization.lift_mk'_spec _ _ _ _).mpr (by rw [hdehom_M y, one_mul])
    let valHom : H_μ →+* Localization M_μ :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let β_μ : H_μ →+* MvPolynomial (Fin 1) K := β_loc.comp valHom
    have hLeftInv : β_μ.comp α_μ = RingHom.id (MvPolynomial (Fin 1) K) := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change β_loc (α_μ (MvPolynomial.C c)).val = MvPolynomial.C c
        have hval : (α_μ (MvPolynomial.C c)).val =
            (Localization.mk (MvPolynomial.C c) 1 : Localization M_μ) := by
          simp only [α_μ, MvPolynomial.eval₂Hom_C]
          rfl
        rw [hval, hβ_loc_mk]
        simp [dehom_μ]
      · intro i
        have hi : i = 0 := Subsingleton.elim i 0
        subst hi
        change β_loc (α_μ (MvPolynomial.X 0)).val = MvPolynomial.X 0
        have hval : (α_μ (MvPolynomial.X 0)).val =
            (Localization.mk ((MvPolynomial.X μ') ^ 1)
              ⟨(MvPolynomial.X μ) ^ 1, hpow_mem 1⟩ : Localization M_μ) := by
          simp only [α_μ, MvPolynomial.eval₂Hom_X']
          rfl
        rw [hval, hβ_loc_mk]
        simp [dehom_μ, w_μ, hμμ']
    have hLocPow : ∀ (a : MvPolynomial (Fin 2) K) (s : M_μ) (k : ℕ),
        (Localization.mk a s) ^ k = Localization.mk (a ^ k) (s ^ k) := by
      intro a s k
      induction k with
      | zero => simp [Localization.mk_one]
      | succ k ih => rw [pow_succ, pow_succ, pow_succ, ih, Localization.mk_mul]
    have hLocSum : ∀ (S : Finset (Fin 2 →₀ ℕ))
        (f : (Fin 2 →₀ ℕ) → MvPolynomial (Fin 2) K) (s : M_μ),
        (∑ i ∈ S, Localization.mk (f i) s) = Localization.mk (∑ i ∈ S, f i) s := by
      classical
      intro S f s
      induction S using Finset.induction_on with
      | empty => simp [Localization.mk_zero]
      | @insert a S ha ih =>
        rw [Finset.sum_insert ha, Finset.sum_insert ha, ih, Localization.add_mk_self]
    have hHomRound : ∀ {n : ℕ} {G : MvPolynomial (Fin 2) K},
        MvPolynomial.IsHomogeneous G n →
        (α_μ (dehom_μ G)).val =
          (Localization.mk G ⟨(MvPolynomial.X μ) ^ n, hpow_mem n⟩ : Localization M_μ) := by
      intro n G hG
      change valHom (α_μ (dehom_μ G)) =
        (Localization.mk G ⟨(MvPolynomial.X μ) ^ n, hpow_mem n⟩ : Localization M_μ)
      conv_lhs => rw [MvPolynomial.as_sum G]
      rw [map_sum, map_sum, map_sum]
      have hterm : ∀ d ∈ G.support,
          valHom (α_μ (dehom_μ (MvPolynomial.monomial d (G.coeff d)))) =
            (Localization.mk (MvPolynomial.monomial d (G.coeff d))
              ⟨(MvPolynomial.X μ) ^ n, hpow_mem n⟩ : Localization M_μ) := by
        intro d hd_mem
        have hd_sum : d 0 + d 1 = n := hMonHom hG d hd_mem
        rw [hMonEq d (G.coeff d)]
        have hC_val : valHom (α_μ (MvPolynomial.C (G.coeff d))) =
            (Localization.mk (MvPolynomial.C (G.coeff d)) 1 : Localization M_μ) := by
          simp only [α_μ, MvPolynomial.eval₂Hom_C]
          rfl
        have hX0_val : valHom (α_μ (MvPolynomial.X 0)) =
            (Localization.mk ((MvPolynomial.X μ') ^ 1)
              ⟨(MvPolynomial.X μ) ^ 1, hpow_mem 1⟩ : Localization M_μ) := by
          simp only [α_μ, MvPolynomial.eval₂Hom_X']
          rfl
        fin_cases μ
        · have hdehom_term :
              dehom_μ (MvPolynomial.C (G.coeff d) *
                MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1) =
                MvPolynomial.C (G.coeff d) * (MvPolynomial.X 0) ^ d 1 := by
            simp [dehom_μ, w_μ]
          rw [hdehom_term, map_mul, map_mul, map_pow, map_pow, hC_val, hX0_val,
            hLocPow, Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
          refine ⟨1, ?_⟩
          dsimp [μ']
          rw [← hd_sum]
          ring
        · have hdehom_term :
              dehom_μ (MvPolynomial.C (G.coeff d) *
                MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1) =
                MvPolynomial.C (G.coeff d) * (MvPolynomial.X 0) ^ d 0 := by
            simp [dehom_μ, w_μ]
          rw [hdehom_term, map_mul, map_mul, map_pow, map_pow, hC_val, hX0_val,
            hLocPow, Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
          refine ⟨1, ?_⟩
          dsimp [μ']
          rw [← hd_sum]
          ring
      rw [Finset.sum_congr rfl hterm, hLocSum, ← MvPolynomial.as_sum G]
    have hRightInv : ∀ z : H_μ, α_μ (β_μ z) = z := by
      intro z
      refine Quotient.inductionOn' z fun nd => HomogeneousLocalization.val_injective M_μ ?_
      obtain ⟨n, hn⟩ := nd.den_mem
      have hden_hom : MvPolynomial.IsHomogeneous nd.den.1 nd.deg :=
        (MvPolynomial.mem_homogeneousSubmodule nd.deg _).mp nd.den.2
      have hnum_hom : MvPolynomial.IsHomogeneous nd.num.1 nd.deg :=
        (MvPolynomial.mem_homogeneousSubmodule nd.deg _).mp nd.num.2
      have hcoeff1 : ((MvPolynomial.X μ : MvPolynomial (Fin 2) K) ^ n).coeff
          (Finsupp.single μ n) = 1 := by
        rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.coeff_monomial]
        simp
      have hcoeff_ne : nd.den.1.coeff (Finsupp.single μ n) ≠ 0 := by
        rw [← hn, hcoeff1]
        exact one_ne_zero
      have hnm : n = nd.deg := by
        have hsum := hCoeffDeg hden_hom (Finsupp.single μ n) hcoeff_ne
        fin_cases μ <;> simpa using hsum
      have hnum_hom_n : MvPolynomial.IsHomogeneous nd.num.1 n := hnm ▸ hnum_hom
      have hval_nd : (HomogeneousLocalization.mk nd : H_μ).val =
          Localization.mk nd.num.1 ⟨nd.den.1, nd.den_mem⟩ :=
        HomogeneousLocalization.val_mk nd
      have hβ_nd : β_μ (HomogeneousLocalization.mk nd) = dehom_μ nd.num.1 := by
        change β_loc (HomogeneousLocalization.mk nd : H_μ).val = dehom_μ nd.num.1
        rw [hval_nd, hβ_loc_mk]
      change (α_μ (β_μ (HomogeneousLocalization.mk nd))).val =
        (HomogeneousLocalization.mk nd : H_μ).val
      rw [hβ_nd, hHomRound hnum_hom_n, hval_nd]
      exact congrArg (Localization.mk nd.num.1) (Subtype.ext hn)
    let e_μ : MvPolynomial (Fin 1) K ≃+* H_μ :=
      { α_μ with
        invFun := β_μ
        left_inv := fun P => DFunLike.congr_fun hLeftInv P
        right_inv := hRightInv }
    refine ⟨e_μ, ?_, ?_, ?_⟩
    · intro c
      change α_μ (MvPolynomial.C c) = _
      simp [α_μ, ι_K, M_μ]
    · change α_μ (MvPolynomial.X 0) = t_μ
      simp [α_μ]
    · intro hF
      apply HomogeneousLocalization.val_injective M_μ
      have h1 : (e_μ (MvPolynomial.X 0)).val =
          (Localization.mk ((MvPolynomial.X μ') ^ 1)
            ⟨(MvPolynomial.X μ) ^ 1, hpow_mem 1⟩ : Localization M_μ) := by
        change (α_μ (MvPolynomial.X 0)).val = _
        simp only [α_μ, MvPolynomial.eval₂Hom_X']
        rfl
      have h2 : (HomogeneousLocalization.Away.mk 𝒜₁ (hX μ) 2 F_split hF).val =
          (Localization.mk F_split ⟨(MvPolynomial.X μ) ^ 2, hpow_mem 2⟩ : Localization M_μ) :=
        HomogeneousLocalization.Away.val_mk 𝒜₁ 2 (hX μ) F_split hF
      rw [h1, h2, hF_eq, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      fin_cases μ <;> dsimp [μ'] <;> ring

  
  let ev₀ : MvPolynomial (Fin 1) K →+* K := MvPolynomial.eval (0 : Fin 1 → K)
  have hMonEq1 : ∀ (d : Fin 1 →₀ ℕ) (c : K),
      (MvPolynomial.monomial d c : MvPolynomial (Fin 1) K) =
        MvPolynomial.C c * (MvPolynomial.X 0) ^ (d 0) := by
    intro d c
    rw [MvPolynomial.monomial_eq,
      Finsupp.prod_of_support_subset d (Finset.subset_univ _) _ (fun _ _ => pow_zero _),
      Fin.prod_univ_one]

  have hModX0 : ∀ P : MvPolynomial (Fin 1) K,
      P - MvPolynomial.C (ev₀ P) ∈ Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) K)} := by
    intro P
    have hEqP : P - MvPolynomial.C (ev₀ P) =
        ∑ d ∈ P.support,
          (MvPolynomial.monomial d (P.coeff d) -
            MvPolynomial.C (ev₀ (MvPolynomial.monomial d (P.coeff d)))) := by
      conv_lhs => rw [MvPolynomial.as_sum P]
      rw [map_sum, map_sum, ← Finset.sum_sub_distrib]
    rw [hEqP]
    apply Ideal.sum_mem
    intro d _
    rw [hMonEq1 d (P.coeff d)]
    rcases Nat.eq_zero_or_pos (d 0) with hd0 | hd_pos
    · rw [hd0]
      simp [ev₀]
    · obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hd_pos.ne'
      rw [hk, pow_succ]
      have hev : ev₀ (MvPolynomial.C (P.coeff d) *
          (MvPolynomial.X 0 ^ k * MvPolynomial.X 0)) = 0 := by
        simp [ev₀]
      rw [hev, map_zero, sub_zero, ← mul_assoc]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

  have hKer_ev₀ : RingHom.ker ev₀ = Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) K)} := by
    apply le_antisymm
    · intro P hP
      have hmem := hModX0 P
      change ev₀ P = 0 at hP
      rwa [hP, map_zero, sub_zero] at hmem
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      change ev₀ (MvPolynomial.X 0) = 0
      simp [ev₀]

  have hMax_X0 : (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) K)}).IsMaximal := by
    rw [Ideal.isMaximal_iff]
    refine ⟨?_, ?_⟩
    · intro h1
      have h1' : (1 : MvPolynomial (Fin 1) K) ∈ RingHom.ker ev₀ := hKer_ev₀ ▸ h1
      change ev₀ 1 = 0 at h1'
      rw [map_one] at h1'
      exact one_ne_zero h1'
    · intro J P hIJ hPX0 hPJ
      have hev_ne : ev₀ P ≠ 0 := by
        intro h0
        apply hPX0
        rw [← hKer_ev₀]
        exact h0
      have hC_mem : MvPolynomial.C (ev₀ P) ∈ J := by
        have hsub : P - MvPolynomial.C (ev₀ P) ∈ J := hIJ (hModX0 P)
        have hEq : MvPolynomial.C (ev₀ P) = P - (P - MvPolynomial.C (ev₀ P)) := by ring
        rw [hEq]
        exact J.sub_mem hPJ hsub
      have h1_mem := J.mul_mem_left (MvPolynomial.C (ev₀ P)⁻¹) hC_mem
      rwa [← map_mul, inv_mul_cancel₀ hev_ne, map_one] at h1_mem

  have hQuotBij : ∀ {R : Type u} [CommRing R] (ψ : MvPolynomial (Fin 1) K →+* R),
      Function.Surjective ψ →
      RingHom.ker ψ = Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) K)} →
      Function.Bijective (ψ.comp MvPolynomial.C) := by
    intro R _ ψ hSurj hKer
    refine ⟨?_, ?_⟩
    · intro c₁ c₂ hc
      change ψ (MvPolynomial.C c₁) = ψ (MvPolynomial.C c₂) at hc
      have hsub : MvPolynomial.C (c₁ - c₂) ∈ RingHom.ker ψ := by
        change ψ (MvPolynomial.C (c₁ - c₂)) = 0
        rw [map_sub, map_sub]
        exact sub_eq_zero.mpr hc
      rw [hKer, ← hKer_ev₀] at hsub
      change ev₀ (MvPolynomial.C (c₁ - c₂)) = 0 at hsub
      simp only [ev₀, MvPolynomial.eval_C] at hsub
      exact sub_eq_zero.mp hsub
    · intro r
      obtain ⟨P, rfl⟩ := hSurj r
      refine ⟨ev₀ P, ?_⟩
      have hmem : P - MvPolynomial.C (ev₀ P) ∈ RingHom.ker ψ := hKer ▸ hModX0 P
      change ψ (P - MvPolynomial.C (ev₀ P)) = 0 at hmem
      rw [map_sub] at hmem
      exact (sub_eq_zero.mp hmem).symm

  
  let D_proj : Fin 2 → P1_sch.Opens :=
    fun μ => AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X μ)
  choose e_away he_away using hEquiv
  let spec_e : ∀ μ : Fin 2,
      AlgebraicGeometry.Spec (CommRingCat.of
        (HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X μ))) ≅ A1_sch :=
    fun μ =>
      { hom := AlgebraicGeometry.Spec.map (e_away μ).toCommRingCatIso.hom
        inv := AlgebraicGeometry.Spec.map (e_away μ).toCommRingCatIso.inv
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, (e_away μ).toCommRingCatIso.inv_hom_id,
            AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, (e_away μ).toCommRingCatIso.hom_inv_id,
            AlgebraicGeometry.Spec.map_id] }
  let e_chart : ∀ μ : Fin 2, (D_proj μ).toScheme ≅ A1_sch :=
    fun μ =>
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X μ) (hX μ) zero_lt_one ≪≫
        spec_e μ

  have he_chart_inv : ∀ μ : Fin 2, (e_chart μ).inv ≫ (D_proj μ).ι ≫ P1_hom = A1_hom := by
    intro μ
    dsimp [e_chart, spec_e, P1_hom, A1_hom, D_proj]
    rw [CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X μ) (hX μ) zero_lt_one).inv,
      AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι,
      AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    change (e_away μ).symm
      (HomogeneousLocalization.fromZeroRingHom 𝒜₁ (Submonoid.powers (MvPolynomial.X μ))
        (algebraMap K ↥(𝒜₁ 0) c)) = MvPolynomial.C c
    rw [← (he_away μ).1 c, (e_away μ).symm_apply_apply]

  have he_chart_hom : ∀ μ : Fin 2, (e_chart μ).hom ≫ A1_hom = (D_proj μ).ι ≫ P1_hom := by
    intro μ
