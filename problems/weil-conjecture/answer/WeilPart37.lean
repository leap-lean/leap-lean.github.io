      ((P_pull.mapExtAddHom Fℤ_Y (P_push.obj ℱ₀) (q₀ + 1)) z)
      (CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app ℱ₀))
      (Nat.zero_add (q₀ + 1)) (Nat.add_zero (q₀ + 1)) (Nat.zero_add (q₀ + 1))
