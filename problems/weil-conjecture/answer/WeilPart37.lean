                CategoryTheory.MorphismProperty.Comma.Hom.ext
                  (CategoryTheory.Limits.pullback.hom_ext
                    ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                      ((CategoryTheory.Category.assoc
                          (CategoryTheory.Limits.pullback.lift f.left Z.hom _)
                          ((B_h.map g).left) _).trans
