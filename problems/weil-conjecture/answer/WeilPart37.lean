              φ.hom.app (Opposite.op (B_h.obj T₂_h))
            let φ_T₁ : one₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h)) ⟶
                𝒢.obj.obj (Opposite.op T₁_h) :=
              φ.hom.app (Opposite.op T₁_h)
            let g_τ : 𝒢.obj.obj (Opposite.op (B_h.obj T₂_h)) ⟶ 𝒢.obj.obj (Opposite.op T₁_h) :=
              𝒢.obj.map τ_iso.inv.op
            let s_τ : one₂.obj.obj (Opposite.op (Sigma_h.obj (B_h.obj T₂_h))) ⟶
                one₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h)) :=
              one₂.obj.map (Sigma_h.map τ_iso.inv).op
            let m_T₂ : one₂.obj.obj (Opposite.op T₂_h) ⟶
                one₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h)) :=
              one₂.obj.map (hT₂_h.from (Sigma_h.obj T₁_h)).op
            have h1 : adj₁.homEquiv AM_ℓ 𝒢 (eConstR 𝒢 φ) =
                post_τ 𝒢 (adj₂.homEquiv AM_ℓ (P_push_h.obj 𝒢) (adj_RP.homEquiv one₂ 𝒢 φ)) :=
              Equiv.apply_symm_apply (adj₁.homEquiv AM_ℓ 𝒢) _
            have h2 : (adj₂.homEquiv AM_ℓ (P_push_h.obj 𝒢) (adj_RP.homEquiv one₂ 𝒢 φ) :
                  AM_ℓ ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂_h))) =
                u₂ ≫ ((adj_RP.homEquiv one₂ 𝒢 φ).hom.app (Opposite.op T₂_h) :
                  one₂.obj.obj (Opposite.op T₂_h) ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂_h))) :=
              CategoryTheory.Adjunction.homEquiv_unit adj₂ AM_ℓ (P_push_h.obj 𝒢)
                (adj_RP.homEquiv one₂ 𝒢 φ)
            have h3 : ((adj_RP.homEquiv one₂ 𝒢 φ).hom.app (Opposite.op T₂_h) :
                  one₂.obj.obj (Opposite.op T₂_h) ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂_h))) =
                c₂ ≫ φ_BT₂ :=
              congrArg
                (fun k : one₂ ⟶ P_push_h.obj 𝒢 =>
                  (k.hom.app (Opposite.op T₂_h) :
                    one₂.obj.obj (Opposite.op T₂_h) ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂_h))))
                (CategoryTheory.Adjunction.homEquiv_unit adj_RP one₂ 𝒢 φ)
            have hLHS : adj₁.homEquiv AM_ℓ 𝒢 (eConstR 𝒢 φ) = (u₂ ≫ (c₂ ≫ φ_BT₂)) ≫ g_τ :=
              h1.trans
                (congrArg (fun m : AM_ℓ ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂_h)) => m ≫ g_τ)
                  (h2.trans (congrArg (u₂ ≫ ·) h3)))
            have hRHS : adj₁.homEquiv AM_ℓ 𝒢 (α_h ≫ φ) = (u₂ ≫ m_T₂) ≫ φ_T₁ := by
              rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
                show adj₁.homEquiv AM_ℓ (R_h.obj one₂) α_h =
                  adj₂.unit.app AM_ℓ ≫ one₂.obj.map (Opposite.op (hT₂_h.from (Sigma_h.obj T₁_h))) from
                  Equiv.apply_symm_apply _ _,
                hop_eq (hT₂_h.from (Sigma_h.obj T₁_h))]
              rfl
            have hφ_nat : φ_BT₂ ≫ g_τ = s_τ ≫ φ_T₁ :=
              (φ.hom.naturality τ_iso.inv.op).symm
            have hc_s : c₂ ≫ s_τ = m_T₂ := by
              dsimp only [c₂, s_τ, m_T₂]
              rw [← one₂.obj.map_comp, ← CategoryTheory.op_comp,
                show Sigma_h.map τ_iso.inv ≫ adj_SigmaB.counit.app T₂_h =
                  hT₂_h.from (Sigma_h.obj T₁_h) from hT₂_h.hom_ext _ _]
            calc
              adj₁.homEquiv AM_ℓ 𝒢 (eConstR 𝒢 φ)
                = (u₂ ≫ (c₂ ≫ φ_BT₂)) ≫ g_τ := hLHS
              _ = u₂ ≫ c₂ ≫ (φ_BT₂ ≫ g_τ) := by simp only [CategoryTheory.Category.assoc]
              _ = u₂ ≫ (c₂ ≫ s_τ) ≫ φ_T₁ := by rw [hφ_nat, ← CategoryTheory.Category.assoc c₂]
              _ = (u₂ ≫ m_T₂) ≫ φ_T₁ := by rw [hc_s, CategoryTheory.Category.assoc]
              _ = adj₁.homEquiv AM_ℓ 𝒢 (α_h ≫ φ) := hRHS.symm
          let β_h : R_h.obj one₂ ⟶ one₁ := (eConstR one₁).symm (𝟙 one₁)
          have hαβ : α_h ≫ β_h = 𝟙 one₁ :=
            (heConstR_apply one₁ β_h).symm.trans (Equiv.apply_symm_apply (eConstR one₁) _)
          have hβα : β_h ≫ α_h = 𝟙 (R_h.obj one₂) := by
            apply (eConstR (R_h.obj one₂)).injective
            rw [heConstR_apply, heConstR_apply, ← CategoryTheory.Category.assoc, hαβ,
              CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
          exact ⟨⟨β_h, hαβ, hβα⟩⟩

        
        have hLocalCounitRestrictIso : ∀ (W : Y₂.Opens) (e : Y₁ ⟶ W.toScheme)
            [CategoryTheory.IsIso e],
            e ≫ W.ι = h →
            let W_et : Y₂.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W.ι
              (inferInstance : AlgebraicGeometry.Etale W.ι)
            CategoryTheory.IsIso (R_h.map (weilEtaleLocalTorsionCounit Y₂ ℓ W_et)) := by
          intro W e _ hh_eq W_et
          let T₁_h := etaleIdTerm Y₁
          let hT₁_h := etaleIdIsTerm Y₁
          let T₂_h := etaleIdTerm Y₂
          let hT₂_h := etaleIdIsTerm Y₂
          let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
          let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
          let one₁ := C₁.obj AM_ℓ
          let one₂ := C₂.obj AM_ℓ
          let ℒ₂ := weilEtaleLocalTorsionSheaf Y₂ ℓ W_et
          let κ₂ := weilEtaleLocalTorsionCounit Y₂ ℓ W_et
          let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁_h
          let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂_h
          have hW_subterm : ∀ {Z : Y₂.Etale} (u₁ u₂ : Z ⟶ W_et), u₁ = u₂ := by
            intro Z u₁ u₂
            refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
            have hw₁ : u₁.left ≫ W.ι = Z.hom := CategoryTheory.MorphismProperty.Over.w u₁
            have hw₂ : u₂.left ≫ W.ι = Z.hom := CategoryTheory.MorphismProperty.Over.w u₂
            exact (CategoryTheory.cancel_mono W.ι).mp (hw₁.trans hw₂.symm)
          have hpb_e : CategoryTheory.IsPullback e (𝟙 Y₁) W.ι h :=
            CategoryTheory.IsPullback.of_isLimit
              (CategoryTheory.Limits.PullbackCone.IsLimit.mk
                (hh_eq.trans (CategoryTheory.Category.id_comp h).symm)
                (fun s => s.snd)
                (fun s => by
                  apply (CategoryTheory.cancel_mono W.ι).mp
                  rw [CategoryTheory.Category.assoc, hh_eq]
                  exact s.condition.symm)
                (fun s => CategoryTheory.Category.comp_id s.snd)
                (fun s m _ hm₂ => (CategoryTheory.Category.comp_id m).symm.trans hm₂))
          let τ_Bh : T₁_h ≅ B_h.obj W_et :=
            { hom := CategoryTheory.MorphismProperty.Over.homMk
                hpb_e.isoPullback.hom
                hpb_e.isoPullback_hom_snd
                trivial
              inv := CategoryTheory.MorphismProperty.Over.homMk
                hpb_e.isoPullback.inv
                hpb_e.isoPullback_inv_snd
                trivial
              hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
                hpb_e.isoPullback.hom_inv_id (Subsingleton.elim _ _)
              inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
                hpb_e.isoPullback.inv_hom_id (Subsingleton.elim _ _) }
          let post_Bh : ∀ 𝒢 : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u},
              (AM_ℓ ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj W_et))) ≃
                (AM_ℓ ⟶ 𝒢.obj.obj (Opposite.op T₁_h)) :=
            fun 𝒢 =>
              { toFun := fun ψ => ψ ≫ 𝒢.obj.map τ_Bh.hom.op
                invFun := fun ψ => ψ ≫ 𝒢.obj.map τ_Bh.inv.op
                left_inv := fun ψ => by
                  dsimp only
                  rw [CategoryTheory.Category.assoc, ← 𝒢.obj.map_comp, ← CategoryTheory.op_comp,
                    τ_Bh.inv_hom_id, CategoryTheory.op_id, 𝒢.obj.map_id,
                    CategoryTheory.Category.comp_id]
                right_inv := fun ψ => by
                  dsimp only
                  rw [CategoryTheory.Category.assoc, ← 𝒢.obj.map_comp, ← CategoryTheory.op_comp,
                    τ_Bh.hom_inv_id, CategoryTheory.op_id, 𝒢.obj.map_id,
                    CategoryTheory.Category.comp_id] }
          let eLocR : ∀ 𝒢 : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u},
              (R_h.obj ℒ₂ ⟶ 𝒢) ≃ (one₁ ⟶ 𝒢) :=
            fun 𝒢 =>
              (adj_RP.homEquiv ℒ₂ 𝒢).trans
                (CategoryTheory.Sheaf.freeYonedaHomEquiv.trans
                  ((post_Bh 𝒢).trans (adj₁.homEquiv AM_ℓ 𝒢).symm))
          let σ_W : Sigma_h.obj T₁_h ⟶ W_et :=
            CategoryTheory.MorphismProperty.Over.homMk e
              (hh_eq.trans (CategoryTheory.Category.id_comp h).symm) trivial
          let ξ₂ := CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 ℒ₂)
          let δ_h : one₁ ⟶ R_h.obj ℒ₂ :=
            (adj₁.homEquiv AM_ℓ (R_h.obj ℒ₂)).symm (ξ₂ ≫ ℒ₂.obj.map σ_W.op)
          have heLocR_apply : ∀ (𝒢 : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u})
              (φ : R_h.obj ℒ₂ ⟶ 𝒢),
              eLocR 𝒢 φ = δ_h ≫ φ := by
            intro 𝒢 φ
            apply (adj₁.homEquiv AM_ℓ 𝒢).injective
            let φ_BW : ℒ₂.obj.obj (Opposite.op (Sigma_h.obj (B_h.obj W_et))) ⟶
                𝒢.obj.obj (Opposite.op (B_h.obj W_et)) :=
              φ.hom.app (Opposite.op (B_h.obj W_et))
            let φ_T₁ : ℒ₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h)) ⟶
                𝒢.obj.obj (Opposite.op T₁_h) :=
              φ.hom.app (Opposite.op T₁_h)
            let g_counit : ℒ₂.obj.obj (Opposite.op W_et) ⟶
                ℒ₂.obj.obj (Opposite.op (Sigma_h.obj (B_h.obj W_et))) :=
              ℒ₂.obj.map (adj_SigmaB.counit.app W_et).op
            let g_τBh : 𝒢.obj.obj (Opposite.op (B_h.obj W_et)) ⟶
                𝒢.obj.obj (Opposite.op T₁_h) :=
              𝒢.obj.map τ_Bh.hom.op
            let g_Sτ : ℒ₂.obj.obj (Opposite.op (Sigma_h.obj (B_h.obj W_et))) ⟶
                ℒ₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h)) :=
              ℒ₂.obj.map (Sigma_h.map τ_Bh.hom).op
            let g_σW : ℒ₂.obj.obj (Opposite.op W_et) ⟶
                ℒ₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h)) :=
              ℒ₂.obj.map σ_W.op
            let vRP_raw := CategoryTheory.Sheaf.freeYonedaHomEquiv (adj_RP.homEquiv ℒ₂ 𝒢 φ)
            let vRP : AM_ℓ ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj W_et)) := vRP_raw
            let appRP_raw := (adj_RP.homEquiv ℒ₂ 𝒢 φ).hom.app (Opposite.op W_et)
            let appRP : ℒ₂.obj.obj (Opposite.op W_et) ⟶
                𝒢.obj.obj (Opposite.op (B_h.obj W_et)) := appRP_raw
            have h1_raw : adj₁.homEquiv AM_ℓ 𝒢 (eLocR 𝒢 φ) = vRP_raw ≫ g_τBh :=
              Equiv.apply_symm_apply (adj₁.homEquiv AM_ℓ 𝒢) _
            have h1 : adj₁.homEquiv AM_ℓ 𝒢 (eLocR 𝒢 φ) = vRP ≫ g_τBh := h1_raw
            have h2_raw :=
              (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
                (CategoryTheory.Category.id_comp (adj_RP.homEquiv ℒ₂ 𝒢 φ)).symm).trans
                (hFreeComp (𝟙 ℒ₂) (adj_RP.homEquiv ℒ₂ 𝒢 φ))
            have h2 : vRP = ξ₂ ≫ appRP := h2_raw
            have h3 : appRP = g_counit ≫ φ_BW :=
              congrArg
                (fun k : ℒ₂ ⟶ P_push_h.obj 𝒢 =>
                  (k.hom.app (Opposite.op W_et) :
                    ℒ₂.obj.obj (Opposite.op W_et) ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj W_et))))
                (CategoryTheory.Adjunction.homEquiv_unit adj_RP ℒ₂ 𝒢 φ)
            have hφ_nat : φ_BW ≫ g_τBh = g_Sτ ≫ φ_T₁ :=
              (φ.hom.naturality τ_Bh.hom.op).symm
            have hc_s : g_counit ≫ g_Sτ = g_σW := by
              rw [← ℒ₂.obj.map_comp, ← CategoryTheory.op_comp,
                hW_subterm (Sigma_h.map τ_Bh.hom ≫ adj_SigmaB.counit.app W_et) σ_W]
            have hRHS : adj₁.homEquiv AM_ℓ 𝒢 (δ_h ≫ φ) = (ξ₂ ≫ g_σW) ≫ φ_T₁ := by
              rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
              have hδ_val : (adj₁.homEquiv AM_ℓ (R_h.obj ℒ₂) δ_h :
                  AM_ℓ ⟶ ℒ₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h))) = ξ₂ ≫ g_σW :=
                Equiv.apply_symm_apply _ _
              exact congrArg (· ≫ φ_T₁) hδ_val
            have h23 : vRP = ξ₂ ≫ (g_counit ≫ φ_BW) :=
              h2.trans (congrArg (ξ₂ ≫ ·) h3)
            exact h1.trans
              ((congrArg (· ≫ g_τBh) h23).trans
                ((CategoryTheory.Category.assoc ξ₂ (g_counit ≫ φ_BW) g_τBh).trans
                  ((congrArg (ξ₂ ≫ ·) (CategoryTheory.Category.assoc g_counit φ_BW g_τBh)).trans
                    ((congrArg (fun k => ξ₂ ≫ (g_counit ≫ k)) hφ_nat).trans
                      ((congrArg (ξ₂ ≫ ·) (CategoryTheory.Category.assoc g_counit g_Sτ φ_T₁).symm).trans
                        ((congrArg (fun k => ξ₂ ≫ (k ≫ φ_T₁)) hc_s).trans
                          ((CategoryTheory.Category.assoc ξ₂ g_σW φ_T₁).symm.trans hRHS.symm)))))))
          let β_loc : R_h.obj ℒ₂ ⟶ one₁ := (eLocR one₁).symm (𝟙 one₁)
          have hδβ : δ_h ≫ β_loc = 𝟙 one₁ :=
            (heLocR_apply one₁ β_loc).symm.trans (Equiv.apply_symm_apply (eLocR one₁) _)
          have hβδ : β_loc ≫ δ_h = 𝟙 (R_h.obj ℒ₂) := by
            apply (eLocR (R_h.obj ℒ₂)).injective
            rw [heLocR_apply, heLocR_apply, ← CategoryTheory.Category.assoc, hδβ,
              CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
          have hIso_δ : CategoryTheory.IsIso δ_h := ⟨⟨β_loc, hδβ, hβδ⟩⟩
          haveI := hIso_δ
          let α_const_h : one₁ ⟶ R_h.obj one₂ :=
            (adj₁.homEquiv AM_ℓ (R_h.obj one₂)).symm
              (adj₂.unit.app AM_ℓ ≫
                one₂.obj.map (Opposite.op (hT₂_h.from (Sigma_h.obj T₁_h))))
          have hIso_αc : CategoryTheory.IsIso α_const_h := hConstIso T₂_h hT₂_h
          have hδ_κ : δ_h ≫ R_h.map κ₂ = α_const_h := by
            apply (adj₁.homEquiv AM_ℓ (R_h.obj one₂)).injective
            let P_const₂ := (CategoryTheory.Functor.const (Opposite Y₂.Etale)).obj AM_ℓ
            let η_const₂ := (CategoryTheory.sheafificationAdjunction J₂
              AddCommGrpCat.{u}).unit.app P_const₂
            let η₂_app : ∀ Z : Y₂.Etale, AM_ℓ ⟶ one₂.obj.obj (Opposite.op Z) :=
              fun Z => η_const₂.app (Opposite.op Z)
            have hL : (adj₁.homEquiv AM_ℓ (R_h.obj one₂) (δ_h ≫ R_h.map κ₂) :
                AM_ℓ ⟶ one₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h))) =
                η₂_app (Sigma_h.obj T₁_h) := by
              let f_σ : ℒ₂.obj.obj (Opposite.op W_et) ⟶
                  ℒ₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h)) := ℒ₂.obj.map σ_W.op
              let g_σ : one₂.obj.obj (Opposite.op W_et) ⟶
                  one₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h)) := one₂.obj.map σ_W.op
              let κ_ST₁ : ℒ₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h)) ⟶
                  one₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h)) :=
                κ₂.hom.app (Opposite.op (Sigma_h.obj T₁_h))
              let κ_W : ℒ₂.obj.obj (Opposite.op W_et) ⟶ one₂.obj.obj (Opposite.op W_et) :=
                κ₂.hom.app (Opposite.op W_et)
              have h0 : (adj₁.homEquiv AM_ℓ (R_h.obj one₂) (δ_h ≫ R_h.map κ₂) :
                  AM_ℓ ⟶ one₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h))) =
                  (adj₁.homEquiv AM_ℓ (R_h.obj ℒ₂) δ_h :
                    AM_ℓ ⟶ ℒ₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h))) ≫ κ_ST₁ :=
                CategoryTheory.Adjunction.homEquiv_naturality_right adj₁ δ_h (R_h.map κ₂)
              have hδ_val : (adj₁.homEquiv AM_ℓ (R_h.obj ℒ₂) δ_h :
                  AM_ℓ ⟶ ℒ₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h))) = ξ₂ ≫ f_σ :=
                Equiv.apply_symm_apply _ _
              have hnatκ : f_σ ≫ κ_ST₁ = κ_W ≫ g_σ :=
                κ₂.hom.naturality σ_W.op
              have hidκ : ξ₂ ≫ κ_W = η₂_app W_et :=
                (hFreeComp (𝟙 ℒ₂) κ₂).symm.trans
                  ((congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
                    (CategoryTheory.Category.id_comp κ₂)).trans
                    (Equiv.apply_symm_apply _ _))
              have hnatη : 𝟙 AM_ℓ ≫ η₂_app (Sigma_h.obj T₁_h) = η₂_app W_et ≫ g_σ :=
                η_const₂.naturality σ_W.op
              exact h0.trans
                ((congrArg (· ≫ κ_ST₁) hδ_val).trans
                  ((CategoryTheory.Category.assoc ξ₂ f_σ κ_ST₁).trans
                    ((congrArg (ξ₂ ≫ ·) hnatκ).trans
                      ((CategoryTheory.Category.assoc ξ₂ κ_W g_σ).symm.trans
                        ((congrArg (· ≫ g_σ) hidκ).trans
                          (hnatη.symm.trans (CategoryTheory.Category.id_comp _)))))))
            have hR : (adj₁.homEquiv AM_ℓ (R_h.obj one₂) α_const_h :
                AM_ℓ ⟶ one₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h))) =
                η₂_app (Sigma_h.obj T₁_h) := by
              have hval : adj₁.homEquiv AM_ℓ (R_h.obj one₂) α_const_h =
                  adj₂.unit.app AM_ℓ ≫
                    one₂.obj.map (Opposite.op (hT₂_h.from (Sigma_h.obj T₁_h))) :=
                Equiv.apply_symm_apply _ _
              have hadj₂_unit : adj₂.unit.app AM_ℓ = η₂_app T₂_h := by
                change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT₂_h).comp
                  (CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u})).unit.app AM_ℓ = _
                rw [CategoryTheory.Adjunction.comp_unit_app,
                  CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
                rfl
              have hnatη : 𝟙 AM_ℓ ≫ η₂_app (Sigma_h.obj T₁_h) =
                  η₂_app T₂_h ≫
                    one₂.obj.map (Opposite.op (hT₂_h.from (Sigma_h.obj T₁_h))) :=
                η_const₂.naturality (Opposite.op (hT₂_h.from (Sigma_h.obj T₁_h)))
              exact hval.trans
                ((congrArg (· ≫ _) hadj₂_unit).trans
                  (hnatη.symm.trans (CategoryTheory.Category.id_comp _)))
            exact hL.trans hR.symm
          have hmap_eq : R_h.map κ₂ = CategoryTheory.inv δ_h ≫ α_const_h := by
            rw [← hδ_κ, CategoryTheory.IsIso.inv_hom_id_assoc]
          rw [hmap_eq]
          exact isIso_of_comp (isIso_of_inv δ_h) hIso_αc

        exact ⟨hc_post, hc_pull, adj_SigmaB, adj_RP, hAdd_Rh, hLim_Rh, hColim_Rh,
          ⟨e_sh⟩, hConstIso, hLocalCounitRestrictIso⟩

      
      let π_U : U_Yt.toScheme ⟶ U_Y.toScheme := π_left ∣_ U_Y
      have : CategoryTheory.IsIso π_U := hIso_U
      let j_V : U_Y.toScheme ⟶ X := CategoryTheory.inv π_U ≫ U_Yt.ι
      have hj_V : AlgebraicGeometry.Etale j_V := inferInstance
      have hU_et : AlgebraicGeometry.Etale U_Y.ι := inferInstance

      have hpb_left : CategoryTheory.IsPullback (CategoryTheory.inv π_U) (𝟙 U_Y.toScheme)
          π_U (𝟙 U_Y.toScheme) :=
        CategoryTheory.IsPullback.of_vert_isIso ⟨by simp⟩
      have hpb_res : CategoryTheory.IsPullback U_Yt.ι π_U π_left U_Y.ι :=
        (AlgebraicGeometry.isPullback_morphismRestrict π_left U_Y).flip
      have hpb_pasted : CategoryTheory.IsPullback j_V (𝟙 U_Y.toScheme) π_left U_Y.ι := by
        have hp := hpb_left.paste_horiz hpb_res
        simpa only [CategoryTheory.Category.id_comp] using hp
      have hpb_jV : CategoryTheory.IsPullback (𝟙 U_Y.toScheme) j_V U_Y.ι π_left :=
        hpb_pasted.flip

      let Sigma_U := weilEtalePostcomp U_Y.ι hU_et
      let Sigma_V := weilEtalePostcomp j_V hj_V

      have hpb_W : ∀ (W : U_Y.toScheme.Etale),
          CategoryTheory.IsPullback (𝟙 W.left) (W.hom ≫ j_V) (W.hom ≫ U_Y.ι) π_left := by
        intro W
        let w_hom : W.left ⟶ U_Y.toScheme := W.hom
        have htop : CategoryTheory.IsPullback (𝟙 W.left) w_hom w_hom (𝟙 U_Y.toScheme) :=
          CategoryTheory.IsPullback.of_horiz_isIso ⟨by simp⟩
        have hp := htop.paste_vert hpb_jV
        simpa only [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id] using hp

      let θ : Sigma_V ≅ Sigma_U ⋙ B_π :=
        CategoryTheory.NatIso.ofComponents
          (fun W =>
            { hom := CategoryTheory.MorphismProperty.Over.homMk
                (hpb_W W).isoPullback.hom
                (hpb_W W).isoPullback_hom_snd
                trivial
              inv := CategoryTheory.MorphismProperty.Over.homMk
                (hpb_W W).isoPullback.inv
                ((CategoryTheory.Category.assoc _ W.hom j_V).symm.trans (hpb_W W).isoPullback_inv_snd)
                trivial
              hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
                (hpb_W W).isoPullback.hom_inv_id (Subsingleton.elim _ _)
              inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
                (hpb_W W).isoPullback.inv_hom_id (Subsingleton.elim _ _) })
          (fun {W₁ W₂} g => by
            refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
            let m_g : CategoryTheory.Limits.pullback (W₁.hom ≫ U_Y.ι) π_left ⟶
                CategoryTheory.Limits.pullback (W₂.hom ≫ U_Y.ι) π_left :=
              ((Sigma_U ⋙ B_π).map g).left
            apply CategoryTheory.Limits.pullback.hom_ext
            · have hL : (g.left ≫ (hpb_W W₂).isoPullback.hom) ≫
                  CategoryTheory.Limits.pullback.fst (W₂.hom ≫ U_Y.ι) π_left = g.left :=
                (CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (g.left ≫ ·) (hpb_W W₂).isoPullback_hom_fst).trans
                    (CategoryTheory.Category.comp_id g.left))
              have hmap_fst : m_g ≫ CategoryTheory.Limits.pullback.fst (W₂.hom ≫ U_Y.ι) π_left =
                  CategoryTheory.Limits.pullback.fst (W₁.hom ≫ U_Y.ι) π_left ≫ g.left :=
                CategoryTheory.Limits.pullback.lift_fst _ _ _
              have hR : ((hpb_W W₁).isoPullback.hom ≫ ((Sigma_U ⋙ B_π).map g).left) ≫
                  CategoryTheory.Limits.pullback.fst (W₂.hom ≫ U_Y.ι) π_left = g.left :=
                (CategoryTheory.Category.assoc _ m_g _).trans
                  ((congrArg ((hpb_W W₁).isoPullback.hom ≫ ·) hmap_fst).trans
                    ((CategoryTheory.Category.assoc _ _ g.left).symm.trans
                      ((congrArg (· ≫ g.left) (hpb_W W₁).isoPullback_hom_fst).trans
                        (CategoryTheory.Category.id_comp g.left))))
              exact hL.trans hR.symm
            · have hgw : g.left ≫ W₂.hom = W₁.hom := CategoryTheory.MorphismProperty.Over.w g
              have hL : (g.left ≫ (hpb_W W₂).isoPullback.hom) ≫
                  CategoryTheory.Limits.pullback.snd (W₂.hom ≫ U_Y.ι) π_left = W₁.hom ≫ j_V :=
                (CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (g.left ≫ ·) (hpb_W W₂).isoPullback_hom_snd).trans
                    ((CategoryTheory.Category.assoc g.left W₂.hom j_V).symm.trans
                      (congrArg (· ≫ j_V) hgw)))
              have hmap_snd : m_g ≫ CategoryTheory.Limits.pullback.snd (W₂.hom ≫ U_Y.ι) π_left =
                  CategoryTheory.Limits.pullback.snd (W₁.hom ≫ U_Y.ι) π_left :=
                CategoryTheory.Limits.pullback.lift_snd _ _ _
              have hR : ((hpb_W W₁).isoPullback.hom ≫ ((Sigma_U ⋙ B_π).map g).left) ≫
                  CategoryTheory.Limits.pullback.snd (W₂.hom ≫ U_Y.ι) π_left = W₁.hom ≫ j_V :=
                (CategoryTheory.Category.assoc _ m_g _).trans
                  ((congrArg ((hpb_W W₁).isoPullback.hom ≫ ·) hmap_snd).trans
                    (hpb_W W₁).isoPullback_hom_snd)
              exact hL.trans hR.symm)

      
      let J_U := U_Y.toScheme.smallEtaleTopology
      let C_U := CategoryTheory.constantSheaf J_U AddCommGrpCat.{u}
      let Λ_X := weilEtaleTorsionSheaf X ℓ
      let Λ_Y := weilEtaleTorsionSheaf Y₀ ℓ
      let Λ_U := C_U.obj AM_ℓ

      obtain ⟨hc_post_U, hc_pull_U, _, adj_RU, hAdd_RU, hLim_RU, hColim_RU, ⟨e_sh_U⟩,
        hConstIso_U, hLocIso_U⟩ := hPostcompPkg U_Y.ι hU_et
      obtain ⟨hc_post_V, _, _, _, hAdd_RV, _, _, ⟨e_sh_V⟩, hConstIso_V, hLocIso_V⟩ :=
        hPostcompPkg j_V hj_V

      letI : Sigma_U.IsContinuous J_U J_Y := hc_post_U
      letI : (weilEtaleSitePullback U_Y.ι).IsContinuous J_Y J_U := hc_pull_U
      let R_U := Sigma_U.sheafPushforwardContinuous AddCommGrpCat.{u} J_U J_Y
      letI : R_U.Additive := hAdd_RU
      letI : CategoryTheory.Limits.PreservesFiniteLimits R_U := hLim_RU
      letI : CategoryTheory.Limits.PreservesFiniteColimits R_U := hColim_RU

      letI : Sigma_V.IsContinuous J_U J_X := hc_post_V
      let R_V := Sigma_V.sheafPushforwardContinuous AddCommGrpCat.{u} J_U J_X
      letI : R_V.Additive := hAdd_RV

      have hPb_RU : ∀ (ℱ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback U_Y.ι ℱ (R_U.obj ℱ) := by
        intro ℱ
        let hr_U : ((weilEtaleSitePullback U_Y.ι).sheafPushforwardContinuous
            AddCommGrpCat.{u} J_Y J_U).IsRightAdjoint := ⟨R_U, ⟨adj_RU⟩⟩
        letI := hr_U
        let adj_BU := (weilEtaleSitePullback U_Y.ι).sheafAdjunctionContinuous
          AddCommGrpCat.{u} J_Y J_U
        exact ⟨hc_pull_U, hr_U, ⟨(adj_BU.leftAdjointUniq adj_RU).app ℱ⟩⟩

      let Θ_of : ∀ (ℱ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
          R_U.obj (pf_π.obj ℱ) ≅ R_V.obj ℱ :=
        fun ℱ =>
          { hom :=
              { hom :=
                  { app := fun W => ℱ.obj.map (θ.hom.app (Opposite.unop W)).op
                    naturality := fun {W₁ W₂} f => by
                      change ℱ.obj.map (B_π.map (Sigma_U.map f.unop)).op ≫
                          ℱ.obj.map (θ.hom.app (Opposite.unop W₂)).op =
                        ℱ.obj.map (θ.hom.app (Opposite.unop W₁)).op ≫
                          ℱ.obj.map (Sigma_V.map f.unop).op
                      rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp, ← CategoryTheory.op_comp,
                        ← CategoryTheory.op_comp]
                      exact congrArg (fun m => ℱ.obj.map m.op) (θ.hom.naturality f.unop).symm } }
            inv :=
              { hom :=
                  { app := fun W => ℱ.obj.map (θ.inv.app (Opposite.unop W)).op
                    naturality := fun {W₁ W₂} f => by
                      change ℱ.obj.map (Sigma_V.map f.unop).op ≫
                          ℱ.obj.map (θ.inv.app (Opposite.unop W₂)).op =
                        ℱ.obj.map (θ.inv.app (Opposite.unop W₁)).op ≫
                          ℱ.obj.map (B_π.map (Sigma_U.map f.unop)).op
                      rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp, ← CategoryTheory.op_comp,
                        ← CategoryTheory.op_comp]
                      exact congrArg (fun m => ℱ.obj.map m.op) (θ.inv.naturality f.unop).symm } }
            hom_inv_id := CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun W => by
              change ℱ.obj.map (θ.hom.app (Opposite.unop W)).op ≫
                  ℱ.obj.map (θ.inv.app (Opposite.unop W)).op = 𝟙 _
              rw [← ℱ.obj.map_comp, ← CategoryTheory.op_comp, θ.inv_hom_id_app]
              exact ℱ.obj.map_id _))
            inv_hom_id := CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun W => by
              change ℱ.obj.map (θ.inv.app (Opposite.unop W)).op ≫
                  ℱ.obj.map (θ.hom.app (Opposite.unop W)).op = 𝟙 _
              rw [← ℱ.obj.map_comp, ← CategoryTheory.op_comp, θ.hom_inv_id_app]
              exact ℱ.obj.map_id _)) }

      have hΘ_nat : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (φ : ℱ₁ ⟶ ℱ₂),
          R_U.map (pf_π.map φ) ≫ (Θ_of ℱ₂).hom = (Θ_of ℱ₁).hom ≫ R_V.map φ := by
        intro ℱ₁ ℱ₂ φ
        exact CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun W =>
          (φ.hom.naturality (θ.hom.app (Opposite.unop W)).op).symm))

      let T_U := etaleIdTerm U_Y.toScheme
      let hT_U := etaleIdIsTerm U_Y.toScheme
      let adj_U := CategoryTheory.constantSheafAdj J_U AddCommGrpCat.{u} hT_U
      let adj_X := CategoryTheory.constantSheafAdj J_X AddCommGrpCat.{u} hT_Yt
      let adj_Y := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT_Y

      let α_U : Λ_U ⟶ R_U.obj Λ_Y :=
        (adj_U.homEquiv AM_ℓ (R_U.obj Λ_Y)).symm
          (adj_Y.unit.app AM_ℓ ≫ Λ_Y.obj.map (Opposite.op (hT_Y.from (Sigma_U.obj T_U))))
      have hIso_αU : CategoryTheory.IsIso α_U := hConstIso_U T_Y hT_Y
      haveI := hIso_αU

      let α_V : Λ_U ⟶ R_V.obj Λ_X :=
        (adj_U.homEquiv AM_ℓ (R_V.obj Λ_X)).symm
          (adj_X.unit.app AM_ℓ ≫ Λ_X.obj.map (Opposite.op (hT_Yt.from (Sigma_V.obj T_U))))
      have hIso_αV : CategoryTheory.IsIso α_V := hConstIso_V T_Yt hT_Yt
      haveI := hIso_αV

      let u_M_ℓ : Λ_Y ⟶ pf_π.obj Λ_X :=
        (adj_π.homEquiv Λ_Y Λ_X) (weilEtaleConstPullbackHom π_left hT_Yt hT_Y AM_ℓ)
      have hu_M_eq : u_M_ℓ = (adj_Y.homEquiv AM_ℓ (pf_π.obj Λ_X)).symm
          (adj_X.unit.app AM_ℓ ≫ Λ_X.obj.map (hT_Yt.from (B_π.obj T_Y)).op) :=
        Equiv.apply_symm_apply (adj_π.homEquiv Λ_Y Λ_X) _

      have hTriangle : α_U ≫ R_U.map u_M_ℓ ≫ (Θ_of Λ_X).hom = α_V := by
        apply (adj_U.homEquiv AM_ℓ (R_V.obj Λ_X)).injective
        let P_const_X := (CategoryTheory.Functor.const (Opposite X.Etale)).obj AM_ℓ
        let η_sh_X := (CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}).unit.app P_const_X
        let η_app : ∀ (Z : X.Etale), AM_ℓ ⟶ Λ_X.obj.obj (Opposite.op Z) :=
          fun Z => η_sh_X.app (Opposite.op Z)
        have hη_nat : ∀ {Z₁ Z₂ : X.Etale} (m : Z₁ ⟶ Z₂),
            η_app Z₂ ≫ Λ_X.obj.map m.op = η_app Z₁ := by
          intro Z₁ Z₂ m
          have hnat : 𝟙 AM_ℓ ≫ η_app Z₁ = η_app Z₂ ≫ Λ_X.obj.map m.op :=
            η_sh_X.naturality m.op
          exact hnat.symm.trans (CategoryTheory.Category.id_comp (η_app Z₁))
        have hadj_X_unit : adj_X.unit.app AM_ℓ = η_app T_Yt := by
          change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_Yt).comp
            (CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u})).unit.app AM_ℓ = _
          rw [CategoryTheory.Adjunction.comp_unit_app,
            CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
          rfl
        have hRHS : adj_U.homEquiv AM_ℓ (R_V.obj Λ_X) α_V = η_app (Sigma_V.obj T_U) := by
          have h1 : adj_U.homEquiv AM_ℓ (R_V.obj Λ_X) α_V =
              adj_X.unit.app AM_ℓ ≫ Λ_X.obj.map (Opposite.op (hT_Yt.from (Sigma_V.obj T_U))) :=
            Equiv.apply_symm_apply _ _
          exact h1.trans
            ((congrArg (· ≫ _) hadj_X_unit).trans
              ((congrArg (η_app T_Yt ≫ Λ_X.obj.map ·)
                  (hop_eq (hT_Yt.from (Sigma_V.obj T_U)))).trans
                (hη_nat (hT_Yt.from (Sigma_V.obj T_U)))))
        have hLHS : adj_U.homEquiv AM_ℓ (R_V.obj Λ_X) (α_U ≫ R_U.map u_M_ℓ ≫ (Θ_of Λ_X).hom) =
            η_app (Sigma_V.obj T_U) := by
          let m_Y : Sigma_U.obj T_U ⟶ T_Y := hT_Y.from (Sigma_U.obj T_U)
          let f_uY : AM_ℓ ⟶ Λ_Y.obj.obj (Opposite.op T_Y) := adj_Y.unit.app AM_ℓ
          let f_mY : Λ_Y.obj.obj (Opposite.op T_Y) ⟶ Λ_Y.obj.obj (Opposite.op (Sigma_U.obj T_U)) :=
            Λ_Y.obj.map m_Y.op
          let f_uSTU : Λ_Y.obj.obj (Opposite.op (Sigma_U.obj T_U)) ⟶
              Λ_X.obj.obj (Opposite.op (B_π.obj (Sigma_U.obj T_U))) :=
            u_M_ℓ.hom.app (Opposite.op (Sigma_U.obj T_U))
          let f_uT2 : Λ_Y.obj.obj (Opposite.op T_Y) ⟶ Λ_X.obj.obj (Opposite.op (B_π.obj T_Y)) :=
            u_M_ℓ.hom.app (Opposite.op T_Y)
          let f_BmY : Λ_X.obj.obj (Opposite.op (B_π.obj T_Y)) ⟶
              Λ_X.obj.obj (Opposite.op (B_π.obj (Sigma_U.obj T_U))) :=
            Λ_X.obj.map (B_π.map m_Y).op
          let f_θ : Λ_X.obj.obj (Opposite.op (B_π.obj (Sigma_U.obj T_U))) ⟶
              Λ_X.obj.obj (Opposite.op (Sigma_V.obj T_U)) :=
            Λ_X.obj.map (θ.hom.app T_U).op
          let f_T1 : Λ_X.obj.obj (Opposite.op T_Yt) ⟶ Λ_X.obj.obj (Opposite.op (B_π.obj T_Y)) :=
            Λ_X.obj.map (hT_Yt.from (B_π.obj T_Y)).op
          have h1 : adj_U.homEquiv AM_ℓ (R_V.obj Λ_X) (α_U ≫ (R_U.map u_M_ℓ ≫ (Θ_of Λ_X).hom)) =
              adj_U.homEquiv AM_ℓ (R_U.obj Λ_Y) α_U ≫
                ((R_U.map u_M_ℓ ≫ (Θ_of Λ_X).hom).hom.app (Opposite.op T_U)) :=
            CategoryTheory.Adjunction.homEquiv_naturality_right adj_U α_U
              (R_U.map u_M_ℓ ≫ (Θ_of Λ_X).hom)
          have hαU_val : adj_U.homEquiv AM_ℓ (R_U.obj Λ_Y) α_U = f_uY ≫ f_mY :=
            (Equiv.apply_symm_apply (adj_U.homEquiv AM_ℓ (R_U.obj Λ_Y)) _).trans
              (congrArg (f_uY ≫ Λ_Y.obj.map ·) (hop_eq m_Y))
          have happ : ((R_U.map u_M_ℓ ≫ (Θ_of Λ_X).hom).hom.app (Opposite.op T_U) :
              Λ_Y.obj.obj (Opposite.op (Sigma_U.obj T_U)) ⟶
                Λ_X.obj.obj (Opposite.op (Sigma_V.obj T_U))) = f_uSTU ≫ f_θ := rfl
          have hu_nat : f_mY ≫ f_uSTU = f_uT2 ≫ f_BmY :=
            u_M_ℓ.hom.naturality m_Y.op
          have hu_T₂ : f_uY ≫ f_uT2 = η_app T_Yt ≫ f_T1 := by
            have h_eq1 : f_uY ≫ f_uT2 = adj_Y.homEquiv AM_ℓ (pf_π.obj Λ_X) u_M_ℓ :=
              (CategoryTheory.Adjunction.homEquiv_unit adj_Y AM_ℓ (pf_π.obj Λ_X) u_M_ℓ).symm
            exact h_eq1.trans
              ((congrArg (adj_Y.homEquiv AM_ℓ (pf_π.obj Λ_X)) hu_M_eq).trans
                ((Equiv.apply_symm_apply _ _).trans (congrArg (· ≫ f_T1) hadj_X_unit)))
          have step1 : adj_U.homEquiv AM_ℓ (R_V.obj Λ_X) (α_U ≫ R_U.map u_M_ℓ ≫ (Θ_of Λ_X).hom) =
              (f_uY ≫ f_mY) ≫ (f_uSTU ≫ f_θ) :=
            h1.trans (congrArg₂ CategoryTheory.CategoryStruct.comp hαU_val happ)
          have step2 : (f_uY ≫ f_mY) ≫ (f_uSTU ≫ f_θ) =
              ((f_uY ≫ f_uT2) ≫ f_BmY) ≫ f_θ :=
            (CategoryTheory.Category.assoc f_uY f_mY (f_uSTU ≫ f_θ)).trans
              (((congrArg (f_uY ≫ ·) (CategoryTheory.Category.assoc f_mY f_uSTU f_θ).symm).trans
                (congrArg (fun k => f_uY ≫ (k ≫ f_θ)) hu_nat)).trans
                ((congrArg (f_uY ≫ ·) (CategoryTheory.Category.assoc f_uT2 f_BmY f_θ)).trans
                  ((CategoryTheory.Category.assoc f_uY f_uT2 (f_BmY ≫ f_θ)).symm.trans
                    (CategoryTheory.Category.assoc (f_uY ≫ f_uT2) f_BmY f_θ).symm)))
          have step3 : ((f_uY ≫ f_uT2) ≫ f_BmY) ≫ f_θ = η_app (Sigma_V.obj T_U) :=
            (congrArg (fun k => (k ≫ f_BmY) ≫ f_θ) hu_T₂).trans
              ((congrArg (fun k => (k ≫ f_BmY) ≫ f_θ) (hη_nat (hT_Yt.from (B_π.obj T_Y)))).trans
                ((congrArg (· ≫ f_θ) (hη_nat (B_π.map m_Y))).trans
                  (hη_nat (θ.hom.app T_U))))
          exact step1.trans (step2.trans step3)
        exact hLHS.trans hRHS.symm

      have hIso_uM : CategoryTheory.IsIso (R_U.map u_M_ℓ) := by
        have hmap_eq : R_U.map u_M_ℓ =
            CategoryTheory.inv α_U ≫ α_V ≫ (Θ_of Λ_X).inv := by
          rw [← hTriangle]
          simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
            CategoryTheory.Category.comp_id, CategoryTheory.IsIso.inv_hom_id_assoc]
        rw [hmap_eq]
        exact isIso_of_comp (isIso_of_inv α_U)
          (isIso_of_comp hIso_αV ⟨⟨(Θ_of Λ_X).hom, (Θ_of Λ_X).inv_hom_id, (Θ_of Λ_X).hom_inv_id⟩⟩)

      let κ_Y_ℓ := weilEtaleLocalTorsionCounit Y₀ ℓ U_Y_et
      let κ_X_ℓ := weilEtaleLocalTorsionCounit X ℓ U_Yt_et
      have hIso_κY : CategoryTheory.IsIso (R_U.map κ_Y_ℓ) :=
        hLocIso_U U_Y (𝟙 U_Y.toScheme) (CategoryTheory.Category.id_comp U_Y.ι)
      have hIso_κX : CategoryTheory.IsIso (R_V.map κ_X_ℓ) :=
        hLocIso_V U_Yt (CategoryTheory.inv π_U) rfl
      have hIso_pfκX : CategoryTheory.IsIso (R_U.map (pf_π.map κ_X_ℓ)) := by
        have hκ_eq : R_U.map (pf_π.map κ_X_ℓ) =
            (Θ_of (weilEtaleLocalTorsionSheaf X ℓ U_Yt_et)).hom ≫
              R_V.map κ_X_ℓ ≫ (Θ_of Λ_X).inv := by
          calc
            R_U.map (pf_π.map κ_X_ℓ)
              = (R_U.map (pf_π.map κ_X_ℓ) ≫ (Θ_of Λ_X).hom) ≫ (Θ_of Λ_X).inv := by
                  rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
                    CategoryTheory.Category.comp_id]
            _ = (Θ_of (weilEtaleLocalTorsionSheaf X ℓ U_Yt_et)).hom ≫
                  R_V.map κ_X_ℓ ≫ (Θ_of Λ_X).inv := by
                  rw [hΘ_nat κ_X_ℓ, CategoryTheory.Category.assoc]
        rw [hκ_eq]
        let e₁ := Θ_of (weilEtaleLocalTorsionSheaf X ℓ U_Yt_et)
        let e₂ := Θ_of Λ_X
        exact isIso_of_comp ⟨⟨e₁.inv, e₁.hom_inv_id, e₁.inv_hom_id⟩⟩
          (isIso_of_comp hIso_κX ⟨⟨e₂.hom, e₂.inv_hom_id, e₂.hom_inv_id⟩⟩)
      haveI := hIso_pfκX

      have hRU_comm : R_U.map κ_Y_ℓ ≫ R_U.map u_M_ℓ =
          R_U.map (α_sys ℓ) ≫ R_U.map (pf_π.map κ_X_ℓ) := by
        rw [← R_U.map_comp, ← R_U.map_comp, hα_counit ℓ]
      have hIso_αℓ : CategoryTheory.IsIso (R_U.map (α_sys ℓ)) := by
        have hα_eq : R_U.map (α_sys ℓ) =
            (R_U.map κ_Y_ℓ ≫ R_U.map u_M_ℓ) ≫
              CategoryTheory.inv (R_U.map (pf_π.map κ_X_ℓ)) := by
          rw [hRU_comm, CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
            CategoryTheory.Category.comp_id]
        rw [hα_eq]
        exact isIso_of_comp (isIso_of_comp hIso_κY hIso_uM)
          (isIso_of_inv (R_U.map (pf_π.map κ_X_ℓ)))
      haveI := hIso_αℓ

      have hKerZero_U : CategoryTheory.Limits.IsZero
          (R_U.obj (CategoryTheory.Limits.kernel (α_sys ℓ))) :=
        (CategoryTheory.Limits.isZero_kernel_of_mono (R_U.map (α_sys ℓ))).of_iso
          (CategoryTheory.Limits.PreservesKernel.iso R_U (α_sys ℓ))
      have hCokZero_U : CategoryTheory.Limits.IsZero
          (R_U.obj (CategoryTheory.Limits.cokernel (α_sys ℓ))) :=
        (CategoryTheory.Limits.isZero_cokernel_of_epi (R_U.map (α_sys ℓ))).of_iso
          (CategoryTheory.Limits.PreservesCokernel.iso R_U (α_sys ℓ))

      
      have hGA_X : CategoryTheory.IsGrothendieckAbelian.{u}
          (CategoryTheory.Sheaf (AlgebraicGeometry.Scheme.AffineEtale.topology X) AddCommGrpCat.{u}) :=
        CategoryTheory.Sheaf.isGrothendieckAbelian_of_essentiallySmall
          (AlgebraicGeometry.Scheme.AffineEtale.topology X) AddCommGrpCat.{u}
      have : CategoryTheory.EnoughInjectives (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) :=
        (AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv X AddCommGrpCat.{u}).enoughInjectives_iff.mp
          (@CategoryTheory.IsGrothendieckAbelian.enoughInjectives _ _ _ hGA_X)

      let U_X_sh := CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}
      let Sh_X := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
      let adj_sh_X := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
      have : Sh_X.Additive := CategoryTheory.Adjunction.left_adjoint_additive adj_sh_X
      let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
        (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
      let Forget_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
        AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
      let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite X.Etale) AddCommGrpCat.adj
      let L_tot : ((Opposite X.Etale) ⥤ Type u) ⥤ CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
        Free_PSh ⋙ Sh_X
      let R_tot : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} ⥤ ((Opposite X.Etale) ⥤ Type u) :=
        U_X_sh ⋙ Forget_PSh
      let adj_tot : L_tot ⊣ R_tot := adj_free.comp adj_sh_X
      let Z_fun : X.Etale ⥤ CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
        CategoryTheory.yoneda ⋙ L_tot
      let Z_obj : Opposite X.Etale → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
        fun W => Opposite.unop (Z_fun.op.obj W)

      let e_raw : ∀ (W : Opposite X.Etale) (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
          CategoryTheory.Abelian.Ext (Z_obj W) F 0 ≃ ↑((U_X_sh.obj F).obj W) :=
        fun W F =>
          CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
            ((adj_tot.homEquiv (CategoryTheory.yoneda.obj (Opposite.unop W)) F).trans
              CategoryTheory.yonedaEquiv)
      have he_add : ∀ (W : Opposite X.Etale) (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
          (α₁ α₂ : CategoryTheory.Abelian.Ext (Z_obj W) F 0),
          e_raw W F (α₁ + α₂) = e_raw W F α₁ + e_raw W F α₂ := by
        intro W F α₁ α₂
        let V := Opposite.unop W
        let u₁ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
        let u₂ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
        have hu : CategoryTheory.Abelian.Ext.addEquiv₀ (α₁ + α₂) = u₁ + u₂ :=
          map_add CategoryTheory.Abelian.Ext.addEquiv₀ α₁ α₂
        let ψ : (Z_obj W ⟶ F) → (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X_sh.obj F) :=
          fun u => adj_sh_X.homEquiv (Free_PSh.obj (CategoryTheory.yoneda.obj V)) F u
        have hψ : ψ (u₁ + u₂) = ψ u₁ + ψ u₂ := by
          dsimp [ψ]
          rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
            CategoryTheory.Adjunction.homEquiv_unit]
          have hmap : U_X_sh.map (u₁ + u₂) = U_X_sh.map u₁ + U_X_sh.map u₂ := rfl
          rw [hmap, CategoryTheory.Preadditive.comp_add]
        let eval_hom : (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X_sh.obj F) →
            ↑((U_X_sh.obj F).obj W) :=
          fun φ => CategoryTheory.yonedaEquiv
            (adj_free.homEquiv (CategoryTheory.yoneda.obj V) (U_X_sh.obj F) φ)
        let g₀ := ((adj_free.unit.app (CategoryTheory.yoneda.obj V)).app W) (𝟙 V)
        have hyon : ∀ (φ : Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X_sh.obj F),
            eval_hom φ = (φ.app W) g₀ := by
          intro φ
          dsimp [eval_hom]
          rw [CategoryTheory.yonedaEquiv_apply, CategoryTheory.Adjunction.homEquiv_unit]
          rfl
        have he_eq : ∀ (α : CategoryTheory.Abelian.Ext (Z_obj W) F 0),
            e_raw W F α = eval_hom (ψ (CategoryTheory.Abelian.Ext.addEquiv₀ α)) := by
          intro α
          dsimp [e_raw, eval_hom, ψ, adj_tot]
          rw [CategoryTheory.Adjunction.comp_homEquiv]
          rfl
        rw [he_eq (α₁ + α₂), he_eq α₁, he_eq α₂, hu, hψ, hyon, hyon, hyon,
          CategoryTheory.NatTrans.app_add]
        rfl
      let e_add : ∀ (W : Opposite X.Etale) (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
          ↑(((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F).obj W) ≃+
            ↑((U_X_sh.obj F).obj W) :=
        fun W F => AddEquiv.mk' (e_raw W F) (he_add W F)
      let θ₀_comp : ∀ (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (W : Opposite X.Etale),
          ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F).obj W ≅
            (U_X_sh.obj F).obj W :=
        fun F W =>
          { hom := AddCommGrpCat.ofHom (e_add W F).toAddMonoidHom
            inv := AddCommGrpCat.ofHom (e_add W F).symm.toAddMonoidHom
            hom_inv_id := by ext x; exact (e_add W F).symm_apply_apply x
            inv_hom_id := by ext y; exact (e_add W F).apply_symm_apply y }
      let θ₀_obj : ∀ (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
          (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F ≅ U_X_sh.obj F :=
        fun F => CategoryTheory.NatIso.ofComponents (fun W => θ₀_comp F W) (by
          intro W₁ W₂ ω
          have hmap_ω_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F).map ω =
              ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app F := rfl
          rw [hmap_ω_mor, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) F]
          ext α
          let u : Z_obj W₁ ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α
          have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
            (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
          change e_raw W₂ F
              ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp α (Nat.zero_add 0)) =
            ((U_X_sh.obj F).map ω) (e_raw W₁ F α)
          rw [hα]
          have hZw : (Z_fun.op.map ω).unop = L_tot.map (CategoryTheory.yoneda.map ω.unop) := rfl
          rw [hZw, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
          dsimp [e_raw]
          rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
            CategoryTheory.Adjunction.homEquiv_naturality_left,
            ← CategoryTheory.yonedaEquiv_naturality',
            ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
          rfl)
      let θ₀ : CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0 ≅ U_X_sh :=
        CategoryTheory.NatIso.ofComponents θ₀_obj (by
          intro F₁ F₂ φ
          ext W α
          have hmap_φ_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ).app W =
              (CategoryTheory.Abelian.extFunctorObj (Z_obj W) 0).map φ := rfl
          let u : Z_obj W ⟶ F₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α
          have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
            (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
          change e_raw W F₂ ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ).app W) α) =
            ((U_X_sh.map φ).app W) (e_raw W F₁ α)
          rw [hmap_φ_mor, CategoryTheory.Abelian.extFunctorObj_map, hα]
          have hpost : ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (Z_obj W) (Nat.add_zero 0))
              (CategoryTheory.Abelian.Ext.mk₀ u) =
              CategoryTheory.Abelian.Ext.mk₀ (u ≫ φ) :=
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ u φ
          change e_raw W F₂ (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (Z_obj W) (Nat.add_zero 0))
              (CategoryTheory.Abelian.Ext.mk₀ u)) = _
          rw [hpost]
          dsimp [e_raw]
          rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
            CategoryTheory.Adjunction.homEquiv_naturality_right,
            CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply,
            ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
          rfl)

      let Ψ : ℕ → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} ⥤
          CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
        fun k_deg => CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X k_deg ⋙ Sh_X
      let ε₀ : Ψ 0 ≅ CategoryTheory.Functor.id (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) :=
        CategoryTheory.Functor.isoWhiskerRight θ₀ Sh_X ≪≫ CategoryTheory.asIso adj_sh_X.counit

      have hPresheafExact : ∀ (K : CategoryTheory.ShortComplex
          (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})),
          (∀ (W : Opposite X.Etale),
            (K.map ((CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W)).Exact) →
          K.Exact := by
        intro K hW
        rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
          CategoryTheory.Functor.isZero_iff]
        intro W
        let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
        have hZW : CategoryTheory.Limits.IsZero (K.map evW).leftHomology :=
          (CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology (K.map evW)).mp (hW W)
        exact hZW.of_iso (K.mapLeftHomologyIso evW).symm

      have hInjΨZero : ∀ (ℐ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
          [CategoryTheory.Injective ℐ] (k_deg : ℕ),
          CategoryTheory.Limits.IsZero ((Ψ (k_deg + 1)).obj ℐ) := by
        intro ℐ _ k_deg
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
        have hpre0 : 𝟙 (ℐ.cohomologyPresheaf (k_deg + 1)) = 0 := by
          ext W x
          exact CategoryTheory.Abelian.Ext.eq_zero_of_injective x
        change 𝟙 (Sh_X.obj (ℐ.cohomologyPresheaf (k_deg + 1))) = 0
        rw [← Sh_X.map_id, hpre0, Sh_X.map_zero]

      have hΨPosZero : ∀ (b : ℕ) (ℱ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
          CategoryTheory.Limits.IsZero ((Ψ (b + 1)).obj ℱ) := by
        intro b
        induction b with
        | zero =>
          intro ℱ
          let ℐ := CategoryTheory.Injective.under ℱ
          let ι_ℱ : ℱ ⟶ ℐ := CategoryTheory.Injective.ι ℱ
          let SC := CategoryTheory.ShortComplex.mk ι_ℱ
            (CategoryTheory.Limits.cokernel.π ι_ℱ)
            (CategoryTheory.Limits.cokernel.condition ι_ℱ)
          have hSE : SC.ShortExact :=
            CategoryTheory.ShortComplex.ShortExact.mk'
              (CategoryTheory.ShortComplex.exact_of_g_is_cokernel _
                (CategoryTheory.Limits.cokernelIsCokernel ι_ℱ))
              inferInstance inferInstance
          let δ_pre : SC.X₃.cohomologyPresheaf 0 ⟶ SC.X₁.cohomologyPresheaf 1 :=
            { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)
              naturality := by
                intro W₁ W₂ ω
                have hL : (SC.X₃.cohomologyPresheaf 0).map ω =
                    ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app SC.X₃ := rfl
                have hR : (SC.X₁.cohomologyPresheaf 1).map ω =
                    ((CategoryTheory.Abelian.extFunctor 1).map (Z_fun.op.map ω)).app SC.X₁ := rfl
                rw [hL, hR,
                  CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) SC.X₃,
                  CategoryTheory.Abelian.extFunctor_map_app 1 (Z_fun.op.map ω) SC.X₁]
                ext α
                exact CategoryTheory.Abelian.Ext.comp_assoc
                  (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
                  (Nat.zero_add 0) rfl (by omega) }
          have hg_app : ∀ (W : Opposite X.Etale),
              (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map SC.g).app W) =
                AddCommGrpCat.ofHom
                  ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero 0)) :=
            fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) 0 SC.g
          have hf_app : ∀ (W : Opposite X.Etale),
              (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.f).app W) =
                AddCommGrpCat.ofHom
                  ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero 1)) :=
            fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) 1 SC.f
          have hcomp₁_pre :
              (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map SC.g ≫ δ_pre = 0 := by
            ext W x
            have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE 0 1 rfl
            have hz : AddCommGrpCat.ofHom
                  ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero 0)) ≫
                AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) = 0 :=
              (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
            rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hg_app W]
            exact congrArg (fun φ => φ x) hz
          have hcomp₂_pre :
              δ_pre ≫ (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.f = 0 := by
            ext W x
            have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE 0 1 rfl
            have hz : AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) ≫
                AddCommGrpCat.ofHom
                  ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero 1)) = 0 :=
              (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
            rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hf_app W]
            exact congrArg (fun φ => φ x) hz
          let B_pre := CategoryTheory.ShortComplex.mk
            δ_pre ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.f) hcomp₂_pre
          have hB_pre_ex : B_pre.Exact := by
            apply hPresheafExact B_pre
            intro W
            let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
            have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE 0 1 rfl
            let eW : B_pre.map evW ≅ _ :=
              CategoryTheory.ShortComplex.isoMk
                (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
                (by dsimp [B_pre, evW, δ_pre]; ext x; rfl)
                (by dsimp [B_pre, evW]; rw [hf_app W]; ext x; rfl)
            exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
          let Δ₀ : (Ψ 0).obj SC.X₃ ⟶ (Ψ 1).obj SC.X₁ := Sh_X.map δ_pre
          have hcomp₁ : (Ψ 0).map SC.g ≫ Δ₀ = 0 := by
            change Sh_X.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map SC.g) ≫
              Sh_X.map δ_pre = 0
            rw [← Sh_X.map_comp, hcomp₁_pre, Sh_X.map_zero]
          have hcomp₂ : Δ₀ ≫ (Ψ 1).map SC.f = 0 := by
            change Sh_X.map δ_pre ≫
              Sh_X.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.f) = 0
            rw [← Sh_X.map_comp, hcomp₂_pre, Sh_X.map_zero]
          have hEx₂ : (CategoryTheory.ShortComplex.mk Δ₀ ((Ψ 1).map SC.f) hcomp₂).Exact :=
            hB_pre_ex.map Sh_X
          have hZ_I1 : CategoryTheory.Limits.IsZero ((Ψ 1).obj SC.X₂) := hInjΨZero ℐ 0
          have hf_zero : (Ψ 1).map SC.f = 0 := hZ_I1.eq_of_tgt ((Ψ 1).map SC.f) 0
          have hEpi_Δ₀ : CategoryTheory.Epi Δ₀ := hEx₂.epi_f hf_zero
          have hEpi_SCg : CategoryTheory.Epi SC.g := hSE.epi_g
          have hΨ0_g_fac : (Ψ 0).map SC.g = ε₀.hom.app SC.X₂ ≫ SC.g ≫ ε₀.inv.app SC.X₃ := by
            calc
              (Ψ 0).map SC.g
                = ((Ψ 0).map SC.g ≫ ε₀.hom.app SC.X₃) ≫ ε₀.inv.app SC.X₃ := by
                    rw [CategoryTheory.Category.assoc, ε₀.hom_inv_id_app,
                      CategoryTheory.Category.comp_id]
              _ = (ε₀.hom.app SC.X₂ ≫
                    (CategoryTheory.Functor.id
                      (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})).map SC.g) ≫
                    ε₀.inv.app SC.X₃ := by
                    rw [ε₀.hom.naturality SC.g]
              _ = ε₀.hom.app SC.X₂ ≫ SC.g ≫ ε₀.inv.app SC.X₃ := by
                    simp only [CategoryTheory.Functor.id_map, CategoryTheory.Category.assoc]
          have hEpi_Ψ0_g : CategoryTheory.Epi ((Ψ 0).map SC.g) := by
            rw [hΨ0_g_fac]
            exact CategoryTheory.epi_comp _ _
          have hΔ₀_zero : Δ₀ = 0 := by
            apply (cancel_epi ((Ψ 0).map SC.g)).mp
            rw [hcomp₁, CategoryTheory.Limits.comp_zero]
          rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
          change 𝟙 ((Ψ 1).obj SC.X₁) = 0
          apply (cancel_epi Δ₀).mp
          rw [CategoryTheory.Category.comp_id, CategoryTheory.Limits.comp_zero, hΔ₀_zero]
        | succ k_deg ih =>
          intro ℱ
          let ℐ := CategoryTheory.Injective.under ℱ
          let ι_ℱ : ℱ ⟶ ℐ := CategoryTheory.Injective.ι ℱ
          let SC := CategoryTheory.ShortComplex.mk ι_ℱ
            (CategoryTheory.Limits.cokernel.π ι_ℱ)
            (CategoryTheory.Limits.cokernel.condition ι_ℱ)
          have hSE : SC.ShortExact :=
            CategoryTheory.ShortComplex.ShortExact.mk'
              (CategoryTheory.ShortComplex.exact_of_g_is_cokernel _
                (CategoryTheory.Limits.cokernelIsCokernel ι_ℱ))
              inferInstance inferInstance
          let q_deg := k_deg + 1
          let δ_pre : SC.X₃.cohomologyPresheaf q_deg ⟶ SC.X₁.cohomologyPresheaf (q_deg + 1) :=
            { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)
              naturality := by
                intro W₁ W₂ ω
                have hL : (SC.X₃.cohomologyPresheaf q_deg).map ω =
                    ((CategoryTheory.Abelian.extFunctor q_deg).map (Z_fun.op.map ω)).app SC.X₃ := rfl
                have hR : (SC.X₁.cohomologyPresheaf (q_deg + 1)).map ω =
                    ((CategoryTheory.Abelian.extFunctor (q_deg + 1)).map (Z_fun.op.map ω)).app SC.X₁ := rfl
                rw [hL, hR,
                  CategoryTheory.Abelian.extFunctor_map_app q_deg (Z_fun.op.map ω) SC.X₃,
                  CategoryTheory.Abelian.extFunctor_map_app (q_deg + 1) (Z_fun.op.map ω) SC.X₁]
                ext α
                exact CategoryTheory.Abelian.Ext.comp_assoc
                  (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
                  (Nat.zero_add q_deg) rfl (by omega) }
          have hg_app : ∀ (W : Opposite X.Etale),
              (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q_deg).map SC.g).app W) =
                AddCommGrpCat.ofHom
                  ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero q_deg)) :=
            fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) q_deg SC.g
          have hf_app : ∀ (W : Opposite X.Etale),
              (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q_deg + 1)).map SC.f).app W) =
