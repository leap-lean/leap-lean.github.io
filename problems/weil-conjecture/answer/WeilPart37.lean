by
  classical
  intro m₀ U_Yt U_Y_et U_Yt_et
  let _ := hℓ
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have hop_eq : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀]
      {A B : C₀} (f : A ⟶ B),
      (Opposite.op f : Opposite.op B ⟶ Opposite.op A) = f.op :=
    fun f => (Quiver.Hom.op_unop (Opposite.op f)).symm.trans
      (congrArg Quiver.Hom.op Quiver.Hom.unop_op')

  have isIso_of_comp : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀]
      {J₀ : CategoryTheory.GrothendieckTopology C₀}
