          let bf_sch : CategoryTheory.Limits.pullback y_hom h ⟶ CategoryTheory.Limits.pullback v_hom h :=
            ((CategoryTheory.Over.pullback h).map u_over).left
          have hbf_fst : bf_sch ≫ fst_V = fst_Y ≫ f_sch :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hbf_snd : bf_sch ≫ snd_V = snd_Y :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hfy : f_sch ≫ v_hom = y_hom := CategoryTheory.Over.w u_over
          have h_outer : CategoryTheory.IsPullback (bf_sch ≫ snd_V) fst_Y h (f_sch ≫ v_hom) := by
            rw [hbf_snd, hfy]
            exact (CategoryTheory.IsPullback.of_hasPullback y_hom h).flip
          have hpb : CategoryTheory.IsPullback bf_sch fst_Y fst_V f_sch :=
