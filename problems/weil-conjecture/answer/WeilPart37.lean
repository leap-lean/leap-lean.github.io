          exact hy_W
        have hs_sub : Set.range s.base ⊆ Set.range j_W.base := by
          rw [hAff_W.range_fromSpec]
          rintro _ ⟨q', rfl⟩
          rw [Subsingleton.elim q' pt_k, hpt_eq]
          exact hy_W
        let y_W : S_k ⟶ AlgebraicGeometry.Spec R_W :=
