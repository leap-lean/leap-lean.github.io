  have he_geom_frob : ∀ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))),
      weilGeomFrobHom F₂ (weilBaseChangeOver F F₂ W) ≫ (e_geom W).hom =
        (e_geom W).hom ≫ weilGeomFrobHom F W ≫ weilGeomFrobHom F W := by
    intro W
    let φ_F := @FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) k _ _ _
    let φ_F₂ := @FiniteField.frobeniusAlgEquivOfAlgebraic F₂ _ (Fintype.ofFinite F₂) k₂ _ _ _
    have hcard_eq_F : @Fintype.card F (Fintype.ofFinite F) = Nat.card F :=
      @Nat.card_eq_fintype_card F (Fintype.ofFinite F) |>.symm
