      CategoryTheory.IsIso (u_sh.hom.app (Opposite.op O_et)) := by
    intro O_et hC1 hC2
    have : ConnectedSpace ↥O_et.left := hC1
    have : ConnectedSpace ↥(B.obj O_et).left := hC2
    have : CategoryTheory.IsIso (η_sh₂.app (Opposite.op O_et)) :=
      h_unit_iso_conn S₂ AM O_et
    have : CategoryTheory.IsIso (u_pre.app (Opposite.op O_et)) :=
      h_unit_iso_conn S₁ AM (B.obj O_et)
    have hfac_O : η_sh₂.app (Opposite.op O_et) ≫ u_sh.hom.app (Opposite.op O_et) =
