                ((CategoryTheory.Category.assoc f₂.left g₂.left Z.hom).symm.trans
                  ((congrArg (· ≫ Z.hom) hf12_left.symm).trans
                    ((CategoryTheory.Category.assoc f₁.left g₁.left Z.hom).trans
