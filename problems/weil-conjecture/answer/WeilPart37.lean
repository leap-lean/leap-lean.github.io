    have hevc2_X1 : ev_c2 (MvPolynomial.X 1) = MvPolynomial.X 1 := by
      have h1_eq : (1 : Fin (2 * (m + 1) + 2)) =
          c.succ.succ.succAbove (1 : Fin (2 * m + 3)) := by
        rw [Fin.succAbove_of_castSucc_lt]
        · rfl
        · change 1 < c.1 + 2; omega
      rw [h1_eq]; dsimp only [ev_c2]; rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]
    have hevc2_ren : ev_c2.comp (MvPolynomial.rename (Fin.succ ∘ Fin.succ)).toRingHom =
        (MvPolynomial.rename (Fin.succ ∘ Fin.succ)).toRingHom.comp ev_cm := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext; intro c₀; simp [ev_c2, ev_cm]
      · intro a
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
