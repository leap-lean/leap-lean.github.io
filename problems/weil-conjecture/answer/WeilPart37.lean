theorem weil_odp_modif_open_iso_unit_and_higherDirectImage_restrict {X Y : AlgebraicGeometry.Scheme.{u}} (π_left : X ⟶ Y)
    (U : Y.Opens) (hIso_U : CategoryTheory.IsIso (π_left ∣_ U))
    (m₀ : ℕ)
    [_hc : (weilEtaleSitePullback π_left).IsContinuous Y.smallEtaleTopology X.smallEtaleTopology]
    [_hr : ((weilEtaleSitePullback π_left).sheafPushforwardContinuous
      AddCommGrpCat.{u} Y.smallEtaleTopology X.smallEtaleTopology).IsRightAdjoint]
    (T₁ : X.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
    (T₂ : Y.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂) :
    let adj_pull := (weilEtaleSitePullback π_left).sheafAdjunctionContinuous
      AddCommGrpCat.{u} Y.smallEtaleTopology X.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
    let u_M := (adj_pull.homEquiv (weilEtaleTorsionSheaf Y m₀) (weilEtaleTorsionSheaf X m₀))
      (weilEtaleConstPullbackHom π_left hT₁ hT₂ AM)
    (∀ (G_U : CategoryTheory.Sheaf U.toScheme.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback U.ι (CategoryTheory.Limits.kernel u_M) G_U →
      CategoryTheory.Limits.IsZero G_U) ∧
    (∀ (G_U : CategoryTheory.Sheaf U.toScheme.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback U.ι (CategoryTheory.Limits.cokernel u_M) G_U →
      CategoryTheory.Limits.IsZero G_U) ∧
    (∀ (b : ℕ) (G_U : CategoryTheory.Sheaf U.toScheme.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback U.ι
        (weilEtaleHigherDirectImage π_left (b + 1) (weilEtaleTorsionSheaf X m₀)) G_U →
      CategoryTheory.Limits.IsZero G_U) :=
by
  intro adj_pull AM u_M
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  let etaleIdTerm : ∀ (Z : AlgebraicGeometry.Scheme.{u}), Z.Etale :=
    fun Z => CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 Z)
      (inferInstance : AlgebraicGeometry.Etale (𝟙 Z))
  have etaleIdIsTerm : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (etaleIdTerm Z) := by
    intro Z
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => CategoryTheory.MorphismProperty.Over.homMk W.hom
        (CategoryTheory.Category.comp_id W.hom) trivial)
      (fun W m => CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _))
    have hw : m.left ≫ 𝟙 Z = W.hom := CategoryTheory.MorphismProperty.Over.w m
    exact (CategoryTheory.Category.comp_id m.left).symm.trans hw

  have hop_eq : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀]
      {A B : C₀} (f : A ⟶ B),
      (Opposite.op f : Opposite.op B ⟶ Opposite.op A) = f.op :=
    fun f => (Quiver.Hom.op_unop (Opposite.op f)).symm.trans
      (congrArg Quiver.Hom.op Quiver.Hom.unop_op')

  
  have hPostcompPkg : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (h : Y₁ ⟶ Y₂) (hh : AlgebraicGeometry.Etale h),
      let J₁ := Y₁.smallEtaleTopology
      let J₂ := Y₂.smallEtaleTopology
      let Sigma_h := weilEtalePostcomp h hh
      let B_h := weilEtaleSitePullback h
      ∃ (hc_post : Sigma_h.IsContinuous J₁ J₂) (hc_pull : B_h.IsContinuous J₂ J₁),
        letI := hc_post
        letI := hc_pull
        let R_h := Sigma_h.sheafPushforwardContinuous AddCommGrpCat.{u} J₁ J₂
        let P_push_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
        let W_Sigma := (CategoryTheory.Functor.whiskeringLeft (Opposite Y₁.Etale)
          (Opposite Y₂.Etale) AddCommGrpCat.{u}).obj Sigma_h.op
        Nonempty (R_h ⊣ P_push_h) ∧
        R_h.Additive ∧
        CategoryTheory.Limits.PreservesFiniteLimits R_h ∧
        CategoryTheory.Limits.PreservesFiniteColimits R_h ∧
        Nonempty (CategoryTheory.presheafToSheaf J₂ AddCommGrpCat.{u} ⋙ R_h ≅
          W_Sigma ⋙ CategoryTheory.presheafToSheaf J₁ AddCommGrpCat.{u}) ∧
        ∀ (T₂_h : Y₂.Etale) (hT₂_h : CategoryTheory.Limits.IsTerminal T₂_h),
          let T₁_h := etaleIdTerm Y₁
          let hT₁_h := etaleIdIsTerm Y₁
          let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
          let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
          let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁_h
          let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂_h
          CategoryTheory.IsIso
            ((adj₁.homEquiv AM (R_h.obj (C₂.obj AM))).symm
              (adj₂.unit.app AM ≫
                (C₂.obj AM).obj.map (Opposite.op (hT₂_h.from (Sigma_h.obj T₁_h))))) := by
    intro Y₁ Y₂ h hh J₁ J₂ Sigma_h B_h
    have hc_post : Sigma_h.IsContinuous J₁ J₂ := by
      refine CategoryTheory.Functor.isContinuous_of_coverPreserving
        (CategoryTheory.CompatiblePreserving.mk ?_)
        (CategoryTheory.CoverPreserving.mk ?_)
      · intro ℱ Z T x hx V₁ V₂ W f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
        have hf12_left : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
          congrArg (fun k => k.left) hfg
        have hf₁_w : f₁.left ≫ (V₁.hom ≫ h) = W.hom :=
          CategoryTheory.MorphismProperty.Over.w f₁
        have hg₁_w : g₁.left ≫ Z.hom = V₁.hom :=
          CategoryTheory.MorphismProperty.Over.w g₁
        have hg₂_w : g₂.left ≫ Z.hom = V₂.hom :=
          CategoryTheory.MorphismProperty.Over.w g₂
        have hEt_V₁h : AlgebraicGeometry.Etale (V₁.hom ≫ h) :=
          CategoryTheory.MorphismProperty.comp_mem P_et V₁.hom h V₁.prop hh
        have hEt_comp_f₁ : AlgebraicGeometry.Etale (f₁.left ≫ (V₁.hom ≫ h)) := by
          rw [hf₁_w]
          exact W.prop
        have hEt_f₁ : AlgebraicGeometry.Etale f₁.left :=
          CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
            f₁.left (V₁.hom ≫ h) hEt_V₁h hEt_comp_f₁
        have hEt_Wtilde : AlgebraicGeometry.Etale (f₁.left ≫ V₁.hom) :=
          CategoryTheory.MorphismProperty.comp_mem P_et f₁.left V₁.hom hEt_f₁ V₁.prop
        let W_tilde : Y₁.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (f₁.left ≫ V₁.hom) hEt_Wtilde
        have hf₂_hom : f₂.left ≫ V₂.hom = f₁.left ≫ V₁.hom :=
          (congrArg (f₂.left ≫ ·) hg₂_w.symm).trans
            ((CategoryTheory.Category.assoc f₂.left g₂.left Z.hom).symm.trans
              ((congrArg (· ≫ Z.hom) hf12_left.symm).trans
                ((CategoryTheory.Category.assoc f₁.left g₁.left Z.hom).trans
                  (congrArg (f₁.left ≫ ·) hg₁_w))))
        let f₁_tilde : W_tilde ⟶ V₁ :=
          CategoryTheory.MorphismProperty.Over.homMk f₁.left rfl trivial
        let f₂_tilde : W_tilde ⟶ V₂ :=
          CategoryTheory.MorphismProperty.Over.homMk f₂.left hf₂_hom trivial
        have hf_tilde_eq : f₁_tilde ≫ g₁ = f₂_tilde ≫ g₂ :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext hf12_left (Subsingleton.elim _ _)
        have hcompat := hx f₁_tilde f₂_tilde hg₁ hg₂ hf_tilde_eq
        let κ : W ⟶ Sigma_h.obj W_tilde :=
          CategoryTheory.MorphismProperty.Over.homMk (𝟙 W.left)
            ((CategoryTheory.Category.id_comp _).trans
              ((CategoryTheory.Category.assoc f₁.left V₁.hom h).trans hf₁_w))
            trivial
        have hκ₁ : κ ≫ Sigma_h.map f₁_tilde = f₁ :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext
            (CategoryTheory.Category.id_comp f₁.left) (Subsingleton.elim _ _)
        have hκ₂ : κ ≫ Sigma_h.map f₂_tilde = f₂ :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext
            (CategoryTheory.Category.id_comp f₂.left) (Subsingleton.elim _ _)
        rw [← hκ₁, ← hκ₂, CategoryTheory.op_comp, CategoryTheory.op_comp,
          ℱ.obj.map_comp, ℱ.obj.map_comp,
          CategoryTheory.ConcreteCategory.comp_apply,
          CategoryTheory.ConcreteCategory.comp_apply]
        exact congrArg (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map κ.op)) hcompat
      · intro V S_cov hS_cov
        have hJ₁ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          Y₁ (le_refl P_et)
        have hJ₂ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          Y₂ (le_refl P_et)
        have hS_pre : S_cov ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck V := by
          change S_cov ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Y₁ V at hS_cov
          rwa [hJ₁] at hS_cov
        have hS_pts :=
          (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
            (P := P_et) (Q := P_et) V S_cov).mp hS_pre
        suffices hgoal : S_cov.functorPushforward Sigma_h ∈
            (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck (Sigma_h.obj V) by
          change S_cov.functorPushforward Sigma_h ∈
            AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Y₂ (Sigma_h.obj V)
          rwa [hJ₂]
        refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) (Sigma_h.obj V) (S_cov.functorPushforward Sigma_h)).mpr fun z => ?_
        obtain ⟨W_et, u, y, hu_S, hu_et, hy⟩ := hS_pts z
        exact ⟨Sigma_h.obj W_et, Sigma_h.map u, y,
          ⟨W_et, u, 𝟙 (Sigma_h.obj W_et), hu_S, (CategoryTheory.Category.id_comp _).symm⟩,
          hu_et, hy⟩

    have : CategoryTheory.MorphismProperty.HasPullbacksAlong P_et h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

    let adj_SigmaB : Sigma_h ⊣ B_h :=
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun Z V =>
            { toFun := fun f =>
                CategoryTheory.MorphismProperty.Over.homMk
                  (CategoryTheory.Limits.pullback.lift f.left Z.hom
                    (CategoryTheory.MorphismProperty.Over.w f))
                  (CategoryTheory.Limits.pullback.lift_snd _ _ _)
                  trivial
              invFun := fun k =>
                CategoryTheory.MorphismProperty.Over.homMk
                  (k.left ≫ CategoryTheory.Limits.pullback.fst V.hom h)
                  ((CategoryTheory.Category.assoc k.left
                      (CategoryTheory.Limits.pullback.fst V.hom h) V.hom).trans
                    ((congrArg (k.left ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                      ((CategoryTheory.Category.assoc k.left
                          (CategoryTheory.Limits.pullback.snd V.hom h) h).symm.trans
                        (congrArg (· ≫ h) (CategoryTheory.MorphismProperty.Over.w k)))))
                  trivial
              left_inv := fun f =>
                CategoryTheory.MorphismProperty.Comma.Hom.ext
                  (CategoryTheory.Limits.pullback.lift_fst _ _ _) (Subsingleton.elim _ _)
              right_inv := fun k =>
                CategoryTheory.MorphismProperty.Comma.Hom.ext
                  (CategoryTheory.Limits.pullback.hom_ext
                    (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                    ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                      (CategoryTheory.MorphismProperty.Over.w k).symm))
                  (Subsingleton.elim _ _) }
          homEquiv_naturality_left_symm := fun {Z' Z V} f k =>
            CategoryTheory.MorphismProperty.Comma.Hom.ext
              (CategoryTheory.Category.assoc f.left k.left _) (Subsingleton.elim _ _)
          homEquiv_naturality_right := fun {Z V V'} f g =>
            CategoryTheory.MorphismProperty.Comma.Hom.ext
              (CategoryTheory.Limits.pullback.hom_ext
                ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                  ((CategoryTheory.Category.assoc
                      (CategoryTheory.Limits.pullback.lift f.left Z.hom _)
                      ((B_h.map g).left) _).trans
                    ((congrArg
                        (CategoryTheory.Limits.pullback.lift f.left Z.hom
                          (CategoryTheory.MorphismProperty.Over.w f) ≫ ·)
                        (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                      ((CategoryTheory.Category.assoc _ _ g.left).symm.trans
                        (congrArg (· ≫ g.left)
                          (CategoryTheory.Limits.pullback.lift_fst _ _ _))))).symm)
                ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                  ((CategoryTheory.Category.assoc
                      (CategoryTheory.Limits.pullback.lift f.left Z.hom _)
                      ((B_h.map g).left) _).trans
                    ((congrArg
                        (CategoryTheory.Limits.pullback.lift f.left Z.hom
                          (CategoryTheory.MorphismProperty.Over.w f) ≫ ·)
                        (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                      (CategoryTheory.Limits.pullback.lift_snd _ _ _))).symm))
              (Subsingleton.elim _ _) }

    have hc_pull : B_h.IsContinuous J₂ J₁ := by
      let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget Y₁
      let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget Y₂
      have : CategoryTheory.Limits.PreservesLimits (CategoryTheory.Over.pullback h) :=
        (CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits
      have : CategoryTheory.Limits.PreservesFiniteLimits (B_h ⋙ Fgt₁) := by
        change CategoryTheory.Limits.PreservesFiniteLimits (Fgt₂ ⋙ CategoryTheory.Over.pullback h)
        infer_instance
      have : CategoryTheory.Limits.PreservesFiniteLimits B_h :=
        CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves B_h Fgt₁
      have : CategoryTheory.RepresentablyFlat B_h :=
        CategoryTheory.flat_of_preservesFiniteLimits B_h
      refine CategoryTheory.Functor.isContinuous_of_coverPreserving
        (CategoryTheory.compatiblePreservingOfFlat J₁ B_h)
        (CategoryTheory.CoverPreserving.mk ?_)
      intro V R_cov hR_cov
      have hJ₂ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Y₂ (le_refl P_et)
      have hJ₁ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Y₁ (le_refl P_et)
      have hR' : R_cov ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck V := by
        change R_cov ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Y₂ V at hR_cov
        rwa [hJ₂] at hR_cov
      have hR'' :=
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) V R_cov).mp hR'
      suffices hgoal : R_cov.functorPushforward B_h ∈
          (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck (B_h.obj V) by
        change R_cov.functorPushforward B_h ∈
          AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Y₁ (B_h.obj V)
        rwa [hJ₁]
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (B_h.obj V) (R_cov.functorPushforward B_h)).mpr fun x => ?_
      let v_hom : (Fgt₂.obj V).left ⟶ Y₂ := (Fgt₂.obj V).hom
      let fst_V : CategoryTheory.Limits.pullback v_hom h ⟶ (Fgt₂.obj V).left :=
        CategoryTheory.Limits.pullback.fst v_hom h
      let snd_V : CategoryTheory.Limits.pullback v_hom h ⟶ Y₁ :=
        CategoryTheory.Limits.pullback.snd v_hom h
      obtain ⟨W_et, f_et, w, hRf, hf_et, hw⟩ := hR'' (fst_V x)
      let y_hom : (Fgt₂.obj W_et).left ⟶ Y₂ := (Fgt₂.obj W_et).hom
      let f_sch : (Fgt₂.obj W_et).left ⟶ (Fgt₂.obj V).left := (Fgt₂.map f_et).left
      let fst_Y : CategoryTheory.Limits.pullback y_hom h ⟶ (Fgt₂.obj W_et).left :=
        CategoryTheory.Limits.pullback.fst y_hom h
      let snd_Y : CategoryTheory.Limits.pullback y_hom h ⟶ Y₁ :=
        CategoryTheory.Limits.pullback.snd y_hom h
      let u_over : Fgt₂.obj W_et ⟶ Fgt₂.obj V := Fgt₂.map f_et
      let bf_sch : CategoryTheory.Limits.pullback y_hom h ⟶ CategoryTheory.Limits.pullback v_hom h :=
        ((CategoryTheory.Over.pullback h).map u_over).left
      have hbf_fst : bf_sch ≫ fst_V = fst_Y ≫ f_sch :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hbf_snd : bf_sch ≫ snd_V = snd_Y :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hfy : f_sch ≫ v_hom = y_hom := CategoryTheory.Over.w u_over
      have h_outer : CategoryTheory.IsPullback (bf_sch ≫ snd_V) fst_Y h (f_sch ≫ v_hom) := by
        rw [hbf_snd, hfy]
        exact (CategoryTheory.IsPullback.of_hasPullback y_hom h).flip
      have hpb : CategoryTheory.IsPullback bf_sch fst_Y fst_V f_sch :=
        CategoryTheory.IsPullback.of_right h_outer hbf_fst
          (CategoryTheory.IsPullback.of_hasPullback v_hom h).flip
      obtain ⟨z, hz_fst, -⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x w
        (hw.symm : fst_V x = f_sch w)
      have hbf_et : P_et bf_sch :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip hf_et
      have hpush_arrow : (R_cov.functorPushforward B_h).arrows (B_h.map f_et) :=
        ⟨W_et, f_et, 𝟙 (B_h.obj W_et), hRf, (CategoryTheory.Category.id_comp _).symm⟩
      refine ⟨B_h.obj W_et, B_h.map f_et, hpb.isoPullback.inv z, hpush_arrow, hbf_et, ?_⟩
      have hinv_fst : hpb.isoPullback.inv ≫ bf_sch = CategoryTheory.Limits.pullback.fst fst_V f_sch :=
        hpb.isoPullback_inv_fst
      change (hpb.isoPullback.inv ≫ bf_sch) z = x
      rw [hinv_fst]
      exact hz_fst

    have : Sigma_h.IsContinuous J₁ J₂ := hc_post
    have : B_h.IsContinuous J₂ J₁ := hc_pull
    let R_h := Sigma_h.sheafPushforwardContinuous AddCommGrpCat.{u} J₁ J₂
    let P_push_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let W_Sigma := (CategoryTheory.Functor.whiskeringLeft (Opposite Y₁.Etale)
      (Opposite Y₂.Etale) AddCommGrpCat.{u}).obj Sigma_h.op
    let W_B := (CategoryTheory.Functor.whiskeringLeft (Opposite Y₂.Etale)
      (Opposite Y₁.Etale) AddCommGrpCat.{u}).obj B_h.op

    let adj_pre : W_Sigma ⊣ W_B :=
      CategoryTheory.Adjunction.mkOfUnitCounit
        { unit :=
            { app := fun P =>
                { app := fun V => P.map (adj_SigmaB.counit.app (Opposite.unop V)).op
                  naturality := fun {V₁ V₂} f => by
                    change P.map f ≫ P.map (adj_SigmaB.counit.app (Opposite.unop V₂)).op =
                      P.map (adj_SigmaB.counit.app (Opposite.unop V₁)).op ≫
                        P.map (Sigma_h.map (B_h.map f.unop)).op
                    rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp]
                    congr 1
                    exact Quiver.Hom.unop_inj (adj_SigmaB.counit.naturality f.unop).symm }
              naturality := fun {P₁ P₂} u =>
                CategoryTheory.NatTrans.ext (funext fun V =>
                  (u.naturality (adj_SigmaB.counit.app (Opposite.unop V)).op).symm) }
          counit :=
            { app := fun Q =>
                { app := fun W => Q.map (adj_SigmaB.unit.app (Opposite.unop W)).op
                  naturality := fun {W₁ W₂} f => by
                    change Q.map (B_h.map (Sigma_h.map f.unop)).op ≫
                        Q.map (adj_SigmaB.unit.app (Opposite.unop W₂)).op =
                      Q.map (adj_SigmaB.unit.app (Opposite.unop W₁)).op ≫ Q.map f
                    rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp]
                    congr 1
                    exact Quiver.Hom.unop_inj (adj_SigmaB.unit.naturality f.unop).symm }
              naturality := fun {Q₁ Q₂} u =>
                CategoryTheory.NatTrans.ext (funext fun W =>
                  (u.naturality (adj_SigmaB.unit.app (Opposite.unop W)).op).symm) }
          left_triangle :=
            CategoryTheory.NatTrans.ext (funext fun P =>
              CategoryTheory.NatTrans.ext (funext fun W => by
                change P.map (adj_SigmaB.counit.app (Sigma_h.obj (Opposite.unop W))).op ≫
                  P.map (Sigma_h.map (adj_SigmaB.unit.app (Opposite.unop W))).op =
                  𝟙 (P.obj (Opposite.op (Sigma_h.obj (Opposite.unop W))))
                rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.op_comp,
                  adj_SigmaB.left_triangle_components (Opposite.unop W)]
                exact P.map_id _))
          right_triangle :=
            CategoryTheory.NatTrans.ext (funext fun Q =>
              CategoryTheory.NatTrans.ext (funext fun V => by
                change Q.map (B_h.map (adj_SigmaB.counit.app (Opposite.unop V))).op ≫
                  Q.map (adj_SigmaB.unit.app (B_h.obj (Opposite.unop V))).op =
                  𝟙 (Q.obj (Opposite.op (B_h.obj (Opposite.unop V))))
                rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.op_comp,
                  adj_SigmaB.right_triangle_components (Opposite.unop V)]
                exact Q.map_id _)) }

    let adj_RP : R_h ⊣ P_push_h :=
      CategoryTheory.Adjunction.mkOfUnitCounit
        { unit :=
            { app := fun ℱ =>
                { hom := adj_pre.unit.app ℱ.obj }
              naturality := fun {ℱ₁ ℱ₂} u =>
                CategoryTheory.Sheaf.hom_ext (adj_pre.unit.naturality u.hom) }
          counit :=
            { app := fun ℋ =>
                { hom := adj_pre.counit.app ℋ.obj }
              naturality := fun {ℋ₁ ℋ₂} u =>
                CategoryTheory.Sheaf.hom_ext (adj_pre.counit.naturality u.hom) }
          left_triangle :=
            CategoryTheory.NatTrans.ext (funext fun ℱ =>
              CategoryTheory.Sheaf.hom_ext (congrFun (congrArg CategoryTheory.NatTrans.app
                adj_pre.left_triangle) ℱ.obj))
          right_triangle :=
            CategoryTheory.NatTrans.ext (funext fun ℋ =>
              CategoryTheory.Sheaf.hom_ext (congrFun (congrArg CategoryTheory.NatTrans.app
                adj_pre.right_triangle) ℋ.obj)) }

    let U₁ := CategoryTheory.sheafToPresheaf J₁ AddCommGrpCat.{u}
    let U₂ := CategoryTheory.sheafToPresheaf J₂ AddCommGrpCat.{u}
    let Sh₁ := CategoryTheory.presheafToSheaf J₁ AddCommGrpCat.{u}
    let Sh₂ := CategoryTheory.presheafToSheaf J₂ AddCommGrpCat.{u}

    have hAdd_Rh : R_h.Additive :=
      CategoryTheory.Functor.Additive.mk (fun {ℱ₁ ℱ₂} {f g} =>
        CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun _ => rfl)))
    have hLim_Rh : CategoryTheory.Limits.PreservesFiniteLimits R_h := by
      have : CategoryTheory.Limits.PreservesLimitsOfSize.{0, 0} U₂ :=
        (CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).rightAdjoint_preservesLimits
      have : CategoryTheory.Limits.PreservesFiniteLimits (R_h ⋙ U₁) := by
        change CategoryTheory.Limits.PreservesFiniteLimits (U₂ ⋙ W_Sigma)
        infer_instance
      exact CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves R_h U₁
    have hColim_Rh : CategoryTheory.Limits.PreservesFiniteColimits R_h := by
      have : CategoryTheory.Limits.PreservesColimitsOfSize.{0, 0} R_h :=
        adj_RP.leftAdjoint_preservesColimits
      infer_instance
    let e_right : P_push_h ⋙ U₂ ≅ U₁ ⋙ W_B :=
      CategoryTheory.NatIso.ofComponents (fun _ => CategoryTheory.Iso.refl _)
        (fun _ => by ext W x; rfl)
    let adj_L := ((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).comp
      adj_RP).ofNatIsoRight e_right
    let adj_R := adj_pre.comp (CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u})
    let e_sh : Sh₂ ⋙ R_h ≅ W_Sigma ⋙ Sh₁ :=
      CategoryTheory.Adjunction.leftAdjointUniq adj_L adj_R

    refine ⟨hc_post, hc_pull, ⟨adj_RP⟩, hAdd_Rh, hLim_Rh, hColim_Rh, ⟨e_sh⟩, ?_⟩
    intro T₂_h hT₂_h T₁_h hT₁_h C₁ C₂ adj₁ adj₂
    have : CategoryTheory.Limits.PreservesLimitsOfSize.{0, 0} B_h :=
      adj_SigmaB.rightAdjoint_preservesLimits
    have hBT₂ : CategoryTheory.Limits.IsTerminal (B_h.obj T₂_h) :=
      CategoryTheory.Limits.IsTerminal.isTerminalObj B_h T₂_h hT₂_h
    let τ_iso : B_h.obj T₂_h ≅ T₁_h :=
      CategoryTheory.Limits.IsTerminal.uniqueUpToIso hBT₂ hT₁_h
    let one₁ := C₁.obj AM
    let one₂ := C₂.obj AM
    let post_τ : ∀ 𝒢 : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u},
        (AM ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂_h))) ≃
          (AM ⟶ 𝒢.obj.obj (Opposite.op T₁_h)) :=
      fun 𝒢 =>
        { toFun := fun ψ => ψ ≫ 𝒢.obj.map τ_iso.inv.op
          invFun := fun ψ => ψ ≫ 𝒢.obj.map τ_iso.hom.op
          left_inv := fun ψ => by
            dsimp only
            rw [CategoryTheory.Category.assoc, ← 𝒢.obj.map_comp, ← CategoryTheory.op_comp,
              τ_iso.hom_inv_id, CategoryTheory.op_id, 𝒢.obj.map_id, CategoryTheory.Category.comp_id]
          right_inv := fun ψ => by
            dsimp only
            rw [CategoryTheory.Category.assoc, ← 𝒢.obj.map_comp, ← CategoryTheory.op_comp,
              τ_iso.inv_hom_id, CategoryTheory.op_id, 𝒢.obj.map_id, CategoryTheory.Category.comp_id] }
    let eConstR : ∀ 𝒢 : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u},
        (R_h.obj one₂ ⟶ 𝒢) ≃ (one₁ ⟶ 𝒢) :=
      fun 𝒢 =>
        (adj_RP.homEquiv one₂ 𝒢).trans
          ((adj₂.homEquiv AM (P_push_h.obj 𝒢)).trans
            ((post_τ 𝒢).trans (adj₁.homEquiv AM 𝒢).symm))
    let α_h : one₁ ⟶ R_h.obj one₂ :=
      (adj₁.homEquiv AM (R_h.obj one₂)).symm
        (adj₂.unit.app AM ≫ one₂.obj.map (Opposite.op (hT₂_h.from (Sigma_h.obj T₁_h))))
    have heConstR_apply : ∀ (𝒢 : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u})
        (φ : R_h.obj one₂ ⟶ 𝒢),
        eConstR 𝒢 φ = α_h ≫ φ := by
      intro 𝒢 φ
      apply (adj₁.homEquiv AM 𝒢).injective
      let u₂ : AM ⟶ one₂.obj.obj (Opposite.op T₂_h) := adj₂.unit.app AM
      let c₂ : one₂.obj.obj (Opposite.op T₂_h) ⟶
          one₂.obj.obj (Opposite.op (Sigma_h.obj (B_h.obj T₂_h))) :=
        one₂.obj.map (adj_SigmaB.counit.app T₂_h).op
      let φ_BT₂ : one₂.obj.obj (Opposite.op (Sigma_h.obj (B_h.obj T₂_h))) ⟶
          𝒢.obj.obj (Opposite.op (B_h.obj T₂_h)) :=
        φ.hom.app (Opposite.op (B_h.obj T₂_h))
      let φ_T₁ : one₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h)) ⟶
          𝒢.obj.obj (Opposite.op T₁_h) :=
        φ.hom.app (Opposite.op T₁_h)
      let g_τ : 𝒢.obj.obj (Opposite.op (B_h.obj T₂_h)) ⟶ 𝒢.obj.obj (Opposite.op T₁_h) :=
        𝒢.obj.map τ_iso.inv.op
      let s_τ : one₂.obj.obj (Opposite.op (Sigma_h.obj (B_h.obj T₂_h))) ⟶
          one₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h)) :=
        one₂.obj.map (Sigma_h.map τ_iso.inv).op
      let m_T₂ : one₂.obj.obj (Opposite.op T₂_h) ⟶
          one₂.obj.obj (Opposite.op (Sigma_h.obj T₁_h)) :=
        one₂.obj.map (hT₂_h.from (Sigma_h.obj T₁_h)).op
      have h1 : adj₁.homEquiv AM 𝒢 (eConstR 𝒢 φ) =
          post_τ 𝒢 (adj₂.homEquiv AM (P_push_h.obj 𝒢) (adj_RP.homEquiv one₂ 𝒢 φ)) :=
        Equiv.apply_symm_apply (adj₁.homEquiv AM 𝒢) _
      have h2 : (adj₂.homEquiv AM (P_push_h.obj 𝒢) (adj_RP.homEquiv one₂ 𝒢 φ) :
            AM ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂_h))) =
          u₂ ≫ ((adj_RP.homEquiv one₂ 𝒢 φ).hom.app (Opposite.op T₂_h) :
            one₂.obj.obj (Opposite.op T₂_h) ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂_h))) :=
        CategoryTheory.Adjunction.homEquiv_unit adj₂ AM (P_push_h.obj 𝒢)
          (adj_RP.homEquiv one₂ 𝒢 φ)
      have h3 : ((adj_RP.homEquiv one₂ 𝒢 φ).hom.app (Opposite.op T₂_h) :
            one₂.obj.obj (Opposite.op T₂_h) ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂_h))) =
          c₂ ≫ φ_BT₂ :=
        congrArg
          (fun k : one₂ ⟶ P_push_h.obj 𝒢 =>
            (k.hom.app (Opposite.op T₂_h) :
              one₂.obj.obj (Opposite.op T₂_h) ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂_h))))
          (CategoryTheory.Adjunction.homEquiv_unit adj_RP one₂ 𝒢 φ)
      have hLHS : adj₁.homEquiv AM 𝒢 (eConstR 𝒢 φ) = (u₂ ≫ (c₂ ≫ φ_BT₂)) ≫ g_τ :=
        h1.trans
          (congrArg (fun m : AM ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂_h)) => m ≫ g_τ)
            (h2.trans (congrArg (u₂ ≫ ·) h3)))
      have hRHS : adj₁.homEquiv AM 𝒢 (α_h ≫ φ) = (u₂ ≫ m_T₂) ≫ φ_T₁ := by
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
          show adj₁.homEquiv AM (R_h.obj one₂) α_h =
            adj₂.unit.app AM ≫ one₂.obj.map (Opposite.op (hT₂_h.from (Sigma_h.obj T₁_h))) from
            Equiv.apply_symm_apply _ _,
          hop_eq (hT₂_h.from (Sigma_h.obj T₁_h))]
        rfl
      have hφ_nat : φ_BT₂ ≫ g_τ = s_τ ≫ φ_T₁ :=
        (φ.hom.naturality τ_iso.inv.op).symm
      have hc_s : c₂ ≫ s_τ = m_T₂ := by
        dsimp only [c₂, s_τ, m_T₂]
        rw [← one₂.obj.map_comp, ← CategoryTheory.op_comp,
          show Sigma_h.map τ_iso.inv ≫ adj_SigmaB.counit.app T₂_h =
            hT₂_h.from (Sigma_h.obj T₁_h) from hT₂_h.hom_ext _ _]
      calc
        adj₁.homEquiv AM 𝒢 (eConstR 𝒢 φ)
          = (u₂ ≫ (c₂ ≫ φ_BT₂)) ≫ g_τ := hLHS
        _ = u₂ ≫ c₂ ≫ (φ_BT₂ ≫ g_τ) := by simp only [CategoryTheory.Category.assoc]
        _ = u₂ ≫ (c₂ ≫ s_τ) ≫ φ_T₁ := by rw [hφ_nat, ← CategoryTheory.Category.assoc c₂]
        _ = (u₂ ≫ m_T₂) ≫ φ_T₁ := by rw [hc_s, CategoryTheory.Category.assoc]
        _ = adj₁.homEquiv AM 𝒢 (α_h ≫ φ) := hRHS.symm
    let β_h : R_h.obj one₂ ⟶ one₁ :=
      (eConstR one₁).symm (𝟙 one₁)
    have hαβ : α_h ≫ β_h = 𝟙 one₁ :=
      (heConstR_apply one₁ β_h).symm.trans (Equiv.apply_symm_apply (eConstR one₁) _)
    have hβα : β_h ≫ α_h = 𝟙 (R_h.obj one₂) := by
      apply (eConstR (R_h.obj one₂)).injective
      rw [heConstR_apply, heConstR_apply, ← CategoryTheory.Category.assoc, hαβ,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    exact ⟨⟨β_h, hαβ, hβα⟩⟩

  
  let V_open : X.Opens := (TopologicalSpace.Opens.map π_left.base).obj U
  let π_U : V_open.toScheme ⟶ U.toScheme := π_left ∣_ U
  have : CategoryTheory.IsIso π_U := hIso_U
  let j_V : U.toScheme ⟶ X := CategoryTheory.inv π_U ≫ V_open.ι
  have hj_V : AlgebraicGeometry.Etale j_V := inferInstance
  have hU_et : AlgebraicGeometry.Etale U.ι := inferInstance

  have hpb_left : CategoryTheory.IsPullback (CategoryTheory.inv π_U) (𝟙 U.toScheme) π_U (𝟙 U.toScheme) :=
    CategoryTheory.IsPullback.of_vert_isIso ⟨by simp⟩
  have hpb_res : CategoryTheory.IsPullback V_open.ι π_U π_left U.ι :=
    (AlgebraicGeometry.isPullback_morphismRestrict π_left U).flip
  have hpb_pasted : CategoryTheory.IsPullback j_V (𝟙 U.toScheme) π_left U.ι := by
    have hp := hpb_left.paste_horiz hpb_res
    simpa only [CategoryTheory.Category.id_comp] using hp
  have hpb_jV : CategoryTheory.IsPullback (𝟙 U.toScheme) j_V U.ι π_left :=
    hpb_pasted.flip

  let Sigma_U := weilEtalePostcomp U.ι hU_et
  let Sigma_V := weilEtalePostcomp j_V hj_V
  let B_π := weilEtaleSitePullback π_left

  have hpb_W : ∀ (W : U.toScheme.Etale),
      CategoryTheory.IsPullback (𝟙 W.left) (W.hom ≫ j_V) (W.hom ≫ U.ι) π_left := by
    intro W
    let w_hom : W.left ⟶ U.toScheme := W.hom
    have htop : CategoryTheory.IsPullback (𝟙 W.left) w_hom w_hom (𝟙 U.toScheme) :=
      CategoryTheory.IsPullback.of_horiz_isIso ⟨by simp⟩
    have hp := htop.paste_vert hpb_jV
    simpa only [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id] using hp

  let θ : Sigma_V ≅ Sigma_U ⋙ B_π :=
    CategoryTheory.NatIso.ofComponents
      (fun W =>
        { hom := CategoryTheory.MorphismProperty.Over.homMk
            (hpb_W W).isoPullback.hom
            (hpb_W W).isoPullback_hom_snd
            trivial
          inv := CategoryTheory.MorphismProperty.Over.homMk
            (hpb_W W).isoPullback.inv
            ((CategoryTheory.Category.assoc _ W.hom j_V).symm.trans (hpb_W W).isoPullback_inv_snd)
            trivial
          hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            (hpb_W W).isoPullback.hom_inv_id (Subsingleton.elim _ _)
          inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            (hpb_W W).isoPullback.inv_hom_id (Subsingleton.elim _ _) })
      (fun {W₁ W₂} g => by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        have : CategoryTheory.MorphismProperty.HasPullbacksAlong P_et π_left :=
          CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
        have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et π_left :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
        let m_g : CategoryTheory.Limits.pullback (W₁.hom ≫ U.ι) π_left ⟶
            CategoryTheory.Limits.pullback (W₂.hom ≫ U.ι) π_left :=
          ((Sigma_U ⋙ B_π).map g).left
        apply CategoryTheory.Limits.pullback.hom_ext
        · have hL : (g.left ≫ (hpb_W W₂).isoPullback.hom) ≫
              CategoryTheory.Limits.pullback.fst (W₂.hom ≫ U.ι) π_left = g.left :=
            (CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (g.left ≫ ·) (hpb_W W₂).isoPullback_hom_fst).trans
                (CategoryTheory.Category.comp_id g.left))
          have hmap_fst : m_g ≫ CategoryTheory.Limits.pullback.fst (W₂.hom ≫ U.ι) π_left =
              CategoryTheory.Limits.pullback.fst (W₁.hom ≫ U.ι) π_left ≫ g.left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hR : ((hpb_W W₁).isoPullback.hom ≫ ((Sigma_U ⋙ B_π).map g).left) ≫
              CategoryTheory.Limits.pullback.fst (W₂.hom ≫ U.ι) π_left = g.left :=
            (CategoryTheory.Category.assoc _ m_g _).trans
              ((congrArg ((hpb_W W₁).isoPullback.hom ≫ ·) hmap_fst).trans
                ((CategoryTheory.Category.assoc _ _ g.left).symm.trans
                  ((congrArg (· ≫ g.left) (hpb_W W₁).isoPullback_hom_fst).trans
                    (CategoryTheory.Category.id_comp g.left))))
          exact hL.trans hR.symm
        · have hgw : g.left ≫ W₂.hom = W₁.hom := CategoryTheory.MorphismProperty.Over.w g
          have hL : (g.left ≫ (hpb_W W₂).isoPullback.hom) ≫
              CategoryTheory.Limits.pullback.snd (W₂.hom ≫ U.ι) π_left = W₁.hom ≫ j_V :=
            (CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (g.left ≫ ·) (hpb_W W₂).isoPullback_hom_snd).trans
                ((CategoryTheory.Category.assoc g.left W₂.hom j_V).symm.trans
                  (congrArg (· ≫ j_V) hgw)))
          have hmap_snd : m_g ≫ CategoryTheory.Limits.pullback.snd (W₂.hom ≫ U.ι) π_left =
              CategoryTheory.Limits.pullback.snd (W₁.hom ≫ U.ι) π_left :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hR : ((hpb_W W₁).isoPullback.hom ≫ ((Sigma_U ⋙ B_π).map g).left) ≫
              CategoryTheory.Limits.pullback.snd (W₂.hom ≫ U.ι) π_left = W₁.hom ≫ j_V :=
            (CategoryTheory.Category.assoc _ m_g _).trans
              ((congrArg ((hpb_W W₁).isoPullback.hom ≫ ·) hmap_snd).trans
                (hpb_W W₁).isoPullback_hom_snd)
          exact hL.trans hR.symm)

  
  let J_X := X.smallEtaleTopology
  let J_Y := Y.smallEtaleTopology
  let J_U := U.toScheme.smallEtaleTopology
  let C_X := CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}
  let C_Y := CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}
  let C_U := CategoryTheory.constantSheaf J_U AddCommGrpCat.{u}
  let Λ_X := weilEtaleTorsionSheaf X m₀
  let Λ_Y := weilEtaleTorsionSheaf Y m₀
  let Λ_U := C_U.obj AM
  let P_push := B_π.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_X

  obtain ⟨hc_post_U, hc_pull_U, ⟨adj_RU⟩, hAdd_RU, hLim_RU, hColim_RU, ⟨e_sh_U⟩, hConstIso_U⟩ :=
    hPostcompPkg U.ι hU_et
  obtain ⟨hc_post_V, hc_pull_V, ⟨adj_RV⟩, hAdd_RV, _, _, ⟨e_sh_V⟩, hConstIso_V⟩ :=
    hPostcompPkg j_V hj_V

  have : Sigma_U.IsContinuous J_U J_Y := hc_post_U
  have : (weilEtaleSitePullback U.ι).IsContinuous J_Y J_U := hc_pull_U
  let R_U := Sigma_U.sheafPushforwardContinuous AddCommGrpCat.{u} J_U J_Y
  have : R_U.Additive := hAdd_RU
  have : CategoryTheory.Limits.PreservesFiniteLimits R_U := hLim_RU
  have : CategoryTheory.Limits.PreservesFiniteColimits R_U := hColim_RU

  have : Sigma_V.IsContinuous J_U J_X := hc_post_V
  let R_V := Sigma_V.sheafPushforwardContinuous AddCommGrpCat.{u} J_U J_X
  have : R_V.Additive := hAdd_RV

  have hZeroOfRU : ∀ (ℱ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
      (G_U : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}),
      CategoryTheory.Limits.IsZero (R_U.obj ℱ) →
      WeilIsEtaleSheafPullback U.ι ℱ G_U →
      CategoryTheory.Limits.IsZero G_U := by
    intro ℱ G_U hZ ⟨hc', hr', ⟨e_G⟩⟩
    have h_hc : hc' = hc_pull_U := Subsingleton.elim _ _
    subst h_hc
    have := hr'
    let adj_B := (weilEtaleSitePullback U.ι).sheafAdjunctionContinuous AddCommGrpCat.{u} J_Y J_U
    let e_left := CategoryTheory.Adjunction.leftAdjointUniq adj_B adj_RU
    exact hZ.of_iso (e_G.symm.trans (e_left.app ℱ))

  let T_U := etaleIdTerm U.toScheme
  let hT_U := etaleIdIsTerm U.toScheme
  let adj_U := CategoryTheory.constantSheafAdj J_U AddCommGrpCat.{u} hT_U
  let adj_X := CategoryTheory.constantSheafAdj J_X AddCommGrpCat.{u} hT₁
  let adj_Y := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT₂

  let α_U : Λ_U ⟶ R_U.obj Λ_Y :=
    (adj_U.homEquiv AM (R_U.obj Λ_Y)).symm
      (adj_Y.unit.app AM ≫ Λ_Y.obj.map (Opposite.op (hT₂.from (Sigma_U.obj T_U))))
  have : CategoryTheory.IsIso α_U := hConstIso_U T₂ hT₂

  let α_V : Λ_U ⟶ R_V.obj Λ_X :=
    (adj_U.homEquiv AM (R_V.obj Λ_X)).symm
      (adj_X.unit.app AM ≫ Λ_X.obj.map (Opposite.op (hT₁.from (Sigma_V.obj T_U))))
  have : CategoryTheory.IsIso α_V := hConstIso_V T₁ hT₁

  let Θ_X : R_U.obj (P_push.obj Λ_X) ≅ R_V.obj Λ_X :=
    { hom :=
        { hom :=
            { app := fun W => Λ_X.obj.map (θ.hom.app (Opposite.unop W)).op
              naturality := fun {W₁ W₂} f => by
                change Λ_X.obj.map (B_π.map (Sigma_U.map f.unop)).op ≫
                    Λ_X.obj.map (θ.hom.app (Opposite.unop W₂)).op =
                  Λ_X.obj.map (θ.hom.app (Opposite.unop W₁)).op ≫
                    Λ_X.obj.map (Sigma_V.map f.unop).op
                rw [← Λ_X.obj.map_comp, ← Λ_X.obj.map_comp, ← CategoryTheory.op_comp,
                  ← CategoryTheory.op_comp]
                exact congrArg (fun m => Λ_X.obj.map m.op) (θ.hom.naturality f.unop).symm } }
      inv :=
        { hom :=
            { app := fun W => Λ_X.obj.map (θ.inv.app (Opposite.unop W)).op
              naturality := fun {W₁ W₂} f => by
                change Λ_X.obj.map (Sigma_V.map f.unop).op ≫
                    Λ_X.obj.map (θ.inv.app (Opposite.unop W₂)).op =
                  Λ_X.obj.map (θ.inv.app (Opposite.unop W₁)).op ≫
                    Λ_X.obj.map (B_π.map (Sigma_U.map f.unop)).op
                rw [← Λ_X.obj.map_comp, ← Λ_X.obj.map_comp, ← CategoryTheory.op_comp,
                  ← CategoryTheory.op_comp]
                exact congrArg (fun m => Λ_X.obj.map m.op) (θ.inv.naturality f.unop).symm } }
      hom_inv_id := CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun W => by
        change Λ_X.obj.map (θ.hom.app (Opposite.unop W)).op ≫
            Λ_X.obj.map (θ.inv.app (Opposite.unop W)).op = 𝟙 _
        rw [← Λ_X.obj.map_comp, ← CategoryTheory.op_comp, θ.inv_hom_id_app]
        exact Λ_X.obj.map_id _))
      inv_hom_id := CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun W => by
        change Λ_X.obj.map (θ.inv.app (Opposite.unop W)).op ≫
            Λ_X.obj.map (θ.hom.app (Opposite.unop W)).op = 𝟙 _
        rw [← Λ_X.obj.map_comp, ← CategoryTheory.op_comp, θ.hom_inv_id_app]
        exact Λ_X.obj.map_id _)) }

  have hu_M_eq : u_M = (adj_Y.homEquiv AM (P_push.obj Λ_X)).symm
      (adj_X.unit.app AM ≫ Λ_X.obj.map (hT₁.from (B_π.obj T₂)).op) :=
    Equiv.apply_symm_apply (adj_pull.homEquiv Λ_Y Λ_X) _

  have hTriangle : α_U ≫ R_U.map u_M ≫ Θ_X.hom = α_V := by
    apply (adj_U.homEquiv AM (R_V.obj Λ_X)).injective
    let P_const_X := (CategoryTheory.Functor.const (Opposite X.Etale)).obj AM
    let η_sh_X := (CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}).unit.app P_const_X
    let η_app : ∀ (Z : X.Etale), AM ⟶ Λ_X.obj.obj (Opposite.op Z) :=
      fun Z => η_sh_X.app (Opposite.op Z)
    have hη_nat : ∀ {Z₁ Z₂ : X.Etale} (m : Z₁ ⟶ Z₂),
        η_app Z₂ ≫ Λ_X.obj.map m.op = η_app Z₁ := by
      intro Z₁ Z₂ m
      have hnat : 𝟙 AM ≫ η_app Z₁ = η_app Z₂ ≫ Λ_X.obj.map m.op :=
        η_sh_X.naturality m.op
      exact hnat.symm.trans (CategoryTheory.Category.id_comp (η_app Z₁))
    have hadj_X_unit : adj_X.unit.app AM = η_app T₁ := by
      change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT₁).comp
        (CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u})).unit.app AM = _
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    have hRHS : adj_U.homEquiv AM (R_V.obj Λ_X) α_V =
        η_app (Sigma_V.obj T_U) := by
      have h1 : adj_U.homEquiv AM (R_V.obj Λ_X) α_V =
          adj_X.unit.app AM ≫ Λ_X.obj.map (Opposite.op (hT₁.from (Sigma_V.obj T_U))) :=
        Equiv.apply_symm_apply _ _
      exact h1.trans
        ((congrArg (· ≫ _) hadj_X_unit).trans
          ((congrArg (η_app T₁ ≫ Λ_X.obj.map ·) (hop_eq (hT₁.from (Sigma_V.obj T_U)))).trans
            (hη_nat (hT₁.from (Sigma_V.obj T_U)))))
    have hLHS : adj_U.homEquiv AM (R_V.obj Λ_X) (α_U ≫ R_U.map u_M ≫ Θ_X.hom) =
        η_app (Sigma_V.obj T_U) := by
      let m_Y : Sigma_U.obj T_U ⟶ T₂ := hT₂.from (Sigma_U.obj T_U)
      let f_uY : AM ⟶ Λ_Y.obj.obj (Opposite.op T₂) := adj_Y.unit.app AM
      let f_mY : Λ_Y.obj.obj (Opposite.op T₂) ⟶ Λ_Y.obj.obj (Opposite.op (Sigma_U.obj T_U)) :=
        Λ_Y.obj.map m_Y.op
      let f_uSTU : Λ_Y.obj.obj (Opposite.op (Sigma_U.obj T_U)) ⟶
          Λ_X.obj.obj (Opposite.op (B_π.obj (Sigma_U.obj T_U))) :=
        u_M.hom.app (Opposite.op (Sigma_U.obj T_U))
      let f_uT2 : Λ_Y.obj.obj (Opposite.op T₂) ⟶ Λ_X.obj.obj (Opposite.op (B_π.obj T₂)) :=
        u_M.hom.app (Opposite.op T₂)
      let f_BmY : Λ_X.obj.obj (Opposite.op (B_π.obj T₂)) ⟶
          Λ_X.obj.obj (Opposite.op (B_π.obj (Sigma_U.obj T_U))) :=
        Λ_X.obj.map (B_π.map m_Y).op
      let f_θ : Λ_X.obj.obj (Opposite.op (B_π.obj (Sigma_U.obj T_U))) ⟶
          Λ_X.obj.obj (Opposite.op (Sigma_V.obj T_U)) :=
        Λ_X.obj.map (θ.hom.app T_U).op
      let f_T1 : Λ_X.obj.obj (Opposite.op T₁) ⟶ Λ_X.obj.obj (Opposite.op (B_π.obj T₂)) :=
        Λ_X.obj.map (hT₁.from (B_π.obj T₂)).op
      have h1 : adj_U.homEquiv AM (R_V.obj Λ_X) (α_U ≫ (R_U.map u_M ≫ Θ_X.hom)) =
          adj_U.homEquiv AM (R_U.obj Λ_Y) α_U ≫
            ((R_U.map u_M ≫ Θ_X.hom).hom.app (Opposite.op T_U)) :=
        CategoryTheory.Adjunction.homEquiv_naturality_right adj_U α_U (R_U.map u_M ≫ Θ_X.hom)
      have hαU_val : adj_U.homEquiv AM (R_U.obj Λ_Y) α_U = f_uY ≫ f_mY :=
        (Equiv.apply_symm_apply (adj_U.homEquiv AM (R_U.obj Λ_Y)) _).trans
          (congrArg (f_uY ≫ Λ_Y.obj.map ·) (hop_eq m_Y))
      have happ : ((R_U.map u_M ≫ Θ_X.hom).hom.app (Opposite.op T_U) :
          Λ_Y.obj.obj (Opposite.op (Sigma_U.obj T_U)) ⟶
            Λ_X.obj.obj (Opposite.op (Sigma_V.obj T_U))) = f_uSTU ≫ f_θ := rfl
      have hu_nat : f_mY ≫ f_uSTU = f_uT2 ≫ f_BmY :=
        u_M.hom.naturality m_Y.op
      have hu_T₂ : f_uY ≫ f_uT2 = η_app T₁ ≫ f_T1 := by
        have h_eq1 : f_uY ≫ f_uT2 = adj_Y.homEquiv AM (P_push.obj Λ_X) u_M :=
          (CategoryTheory.Adjunction.homEquiv_unit adj_Y AM (P_push.obj Λ_X) u_M).symm
        exact h_eq1.trans
          ((congrArg (adj_Y.homEquiv AM (P_push.obj Λ_X)) hu_M_eq).trans
            ((Equiv.apply_symm_apply _ _).trans (congrArg (· ≫ f_T1) hadj_X_unit)))
      have step1 : adj_U.homEquiv AM (R_V.obj Λ_X) (α_U ≫ R_U.map u_M ≫ Θ_X.hom) =
          (f_uY ≫ f_mY) ≫ (f_uSTU ≫ f_θ) :=
        h1.trans (congrArg₂ CategoryTheory.CategoryStruct.comp hαU_val happ)
      have step2 : (f_uY ≫ f_mY) ≫ (f_uSTU ≫ f_θ) =
          ((f_uY ≫ f_uT2) ≫ f_BmY) ≫ f_θ :=
        (CategoryTheory.Category.assoc f_uY f_mY (f_uSTU ≫ f_θ)).trans
          (((congrArg (f_uY ≫ ·) (CategoryTheory.Category.assoc f_mY f_uSTU f_θ).symm).trans
            (congrArg (fun k => f_uY ≫ (k ≫ f_θ)) hu_nat)).trans
            ((congrArg (f_uY ≫ ·) (CategoryTheory.Category.assoc f_uT2 f_BmY f_θ)).trans
              ((CategoryTheory.Category.assoc f_uY f_uT2 (f_BmY ≫ f_θ)).symm.trans
                (CategoryTheory.Category.assoc (f_uY ≫ f_uT2) f_BmY f_θ).symm)))
      have step3 : ((f_uY ≫ f_uT2) ≫ f_BmY) ≫ f_θ = η_app (Sigma_V.obj T_U) :=
        (congrArg (fun k => (k ≫ f_BmY) ≫ f_θ) hu_T₂).trans
          ((congrArg (fun k => (k ≫ f_BmY) ≫ f_θ) (hη_nat (hT₁.from (B_π.obj T₂)))).trans
            ((congrArg (· ≫ f_θ) (hη_nat (B_π.map m_Y))).trans
              (hη_nat (θ.hom.app T_U))))
      exact step1.trans (step2.trans step3)
    exact hLHS.trans hRHS.symm

  have hIso_RU_uM : CategoryTheory.IsIso (R_U.map u_M) := by
    let inv_map : R_U.obj (P_push.obj Λ_X) ⟶ R_U.obj Λ_Y :=
      Θ_X.hom ≫ CategoryTheory.inv α_V ≫ α_U
    refine ⟨⟨inv_map, ?_, ?_⟩⟩
    · have h1 : (α_U ≫ R_U.map u_M ≫ Θ_X.hom) ≫ CategoryTheory.inv α_V ≫ α_U = α_U := by
        rw [hTriangle, CategoryTheory.IsIso.hom_inv_id_assoc]
      have h2 : α_U ≫ (R_U.map u_M ≫ inv_map) = α_U ≫ 𝟙 (R_U.obj Λ_Y) := by
        dsimp only [inv_map]
        calc
          α_U ≫ R_U.map u_M ≫ Θ_X.hom ≫ CategoryTheory.inv α_V ≫ α_U
            = (α_U ≫ R_U.map u_M ≫ Θ_X.hom) ≫ CategoryTheory.inv α_V ≫ α_U := by
                simp only [CategoryTheory.Category.assoc]
          _ = α_U := h1
          _ = α_U ≫ 𝟙 (R_U.obj Λ_Y) := (CategoryTheory.Category.comp_id α_U).symm
      exact (cancel_epi α_U).mp h2
    · dsimp only [inv_map]
      calc
        (Θ_X.hom ≫ CategoryTheory.inv α_V ≫ α_U) ≫ R_U.map u_M
          = Θ_X.hom ≫ CategoryTheory.inv α_V ≫
              ((α_U ≫ R_U.map u_M ≫ Θ_X.hom) ≫ Θ_X.inv) := by
              simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
                CategoryTheory.Category.comp_id]
        _ = Θ_X.hom ≫ CategoryTheory.inv α_V ≫ (α_V ≫ Θ_X.inv) := by rw [hTriangle]
        _ = 𝟙 _ := by
              simp only [CategoryTheory.IsIso.inv_hom_id_assoc, CategoryTheory.Iso.hom_inv_id]

  have : CategoryTheory.IsIso (R_U.map u_M) := hIso_RU_uM

  have hKerZero : CategoryTheory.Limits.IsZero (R_U.obj (CategoryTheory.Limits.kernel u_M)) :=
    (CategoryTheory.Limits.isZero_kernel_of_mono (R_U.map u_M)).of_iso
      (CategoryTheory.Limits.PreservesKernel.iso R_U u_M)

  have hCokZero : CategoryTheory.Limits.IsZero (R_U.obj (CategoryTheory.Limits.cokernel u_M)) :=
    (CategoryTheory.Limits.isZero_cokernel_of_epi (R_U.map u_M)).of_iso
      (CategoryTheory.Limits.PreservesCokernel.iso R_U u_M)

  
  have hGA_X : CategoryTheory.IsGrothendieckAbelian.{u}
      (CategoryTheory.Sheaf (AlgebraicGeometry.Scheme.AffineEtale.topology X) AddCommGrpCat.{u}) :=
    CategoryTheory.Sheaf.isGrothendieckAbelian_of_essentiallySmall
      (AlgebraicGeometry.Scheme.AffineEtale.topology X) AddCommGrpCat.{u}
  have : CategoryTheory.EnoughInjectives (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) :=
    (AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv X AddCommGrpCat.{u}).enoughInjectives_iff.mp
      (@CategoryTheory.IsGrothendieckAbelian.enoughInjectives _ _ _ hGA_X)

  let U_X := CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}
  let Sh_X := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
  let adj_sh_X := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
  have : Sh_X.Additive := CategoryTheory.Adjunction.left_adjoint_additive adj_sh_X
  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let Forget_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
    AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
  let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite X.Etale) AddCommGrpCat.adj
  let L_tot : ((Opposite X.Etale) ⥤ Type u) ⥤ CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    Free_PSh ⋙ Sh_X
  let R_tot : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} ⥤ ((Opposite X.Etale) ⥤ Type u) :=
    U_X ⋙ Forget_PSh
  let adj_tot : L_tot ⊣ R_tot := adj_free.comp adj_sh_X
  let Z_fun : X.Etale ⥤ CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    CategoryTheory.yoneda ⋙ L_tot
  let Z_obj : Opposite X.Etale → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    fun W => Opposite.unop (Z_fun.op.obj W)

  let e_raw : ∀ (W : Opposite X.Etale) (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
      CategoryTheory.Abelian.Ext (Z_obj W) F 0 ≃ ↑((U_X.obj F).obj W) :=
    fun W F =>
      CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
        ((adj_tot.homEquiv (CategoryTheory.yoneda.obj (Opposite.unop W)) F).trans
          CategoryTheory.yonedaEquiv)
  have he_add : ∀ (W : Opposite X.Etale) (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
      (α₁ α₂ : CategoryTheory.Abelian.Ext (Z_obj W) F 0),
      e_raw W F (α₁ + α₂) = e_raw W F α₁ + e_raw W F α₂ := by
    intro W F α₁ α₂
    let V := Opposite.unop W
    let u₁ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
    let u₂ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
    have hu : CategoryTheory.Abelian.Ext.addEquiv₀ (α₁ + α₂) = u₁ + u₂ :=
      map_add CategoryTheory.Abelian.Ext.addEquiv₀ α₁ α₂
    let ψ : (Z_obj W ⟶ F) → (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X.obj F) :=
      fun u => adj_sh_X.homEquiv (Free_PSh.obj (CategoryTheory.yoneda.obj V)) F u
    have hψ : ψ (u₁ + u₂) = ψ u₁ + ψ u₂ := by
      dsimp [ψ]
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.Adjunction.homEquiv_unit]
      have hmap : U_X.map (u₁ + u₂) = U_X.map u₁ + U_X.map u₂ := rfl
      rw [hmap, CategoryTheory.Preadditive.comp_add]
    let eval_hom : (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X.obj F) →
        ↑((U_X.obj F).obj W) :=
      fun φ => CategoryTheory.yonedaEquiv
        (adj_free.homEquiv (CategoryTheory.yoneda.obj V) (U_X.obj F) φ)
    let g₀ := ((adj_free.unit.app (CategoryTheory.yoneda.obj V)).app W) (𝟙 V)
    have hyon : ∀ (φ : Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X.obj F),
        eval_hom φ = (φ.app W) g₀ := by
      intro φ
      dsimp [eval_hom]
      rw [CategoryTheory.yonedaEquiv_apply, CategoryTheory.Adjunction.homEquiv_unit]
      rfl
    have he_eq : ∀ (α : CategoryTheory.Abelian.Ext (Z_obj W) F 0),
        e_raw W F α = eval_hom (ψ (CategoryTheory.Abelian.Ext.addEquiv₀ α)) := by
      intro α
      dsimp [e_raw, eval_hom, ψ, adj_tot]
      rw [CategoryTheory.Adjunction.comp_homEquiv]
      rfl
    rw [he_eq (α₁ + α₂), he_eq α₁, he_eq α₂, hu, hψ, hyon, hyon, hyon,
      CategoryTheory.NatTrans.app_add]
    rfl
  let e_add : ∀ (W : Opposite X.Etale) (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
      ↑(((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F).obj W) ≃+
        ↑((U_X.obj F).obj W) :=
    fun W F => AddEquiv.mk' (e_raw W F) (he_add W F)
  let θ₀_comp : ∀ (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (W : Opposite X.Etale),
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F).obj W ≅
        (U_X.obj F).obj W :=
    fun F W =>
      { hom := AddCommGrpCat.ofHom (e_add W F).toAddMonoidHom
        inv := AddCommGrpCat.ofHom (e_add W F).symm.toAddMonoidHom
        hom_inv_id := by ext x; exact (e_add W F).symm_apply_apply x
        inv_hom_id := by ext y; exact (e_add W F).apply_symm_apply y }
  let θ₀_obj : ∀ (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
      (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F ≅ U_X.obj F :=
    fun F => CategoryTheory.NatIso.ofComponents (fun W => θ₀_comp F W) (by
      intro W₁ W₂ ω
      have hmap_ω_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F).map ω =
          ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app F := rfl
      rw [hmap_ω_mor, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) F]
      ext α
      let u : Z_obj W₁ ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α
      have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
      change e_raw W₂ F
          ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp α (Nat.zero_add 0)) =
        ((U_X.obj F).map ω) (e_raw W₁ F α)
      rw [hα]
      have hZw : (Z_fun.op.map ω).unop = L_tot.map (CategoryTheory.yoneda.map ω.unop) := rfl
      rw [hZw, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      dsimp [e_raw]
      rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
        CategoryTheory.Adjunction.homEquiv_naturality_left,
        ← CategoryTheory.yonedaEquiv_naturality',
        ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
      rfl)
  let θ₀ : CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0 ≅ U_X :=
    CategoryTheory.NatIso.ofComponents θ₀_obj (by
      intro F₁ F₂ φ
      ext W α
      have hmap_φ_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ).app W =
          (CategoryTheory.Abelian.extFunctorObj (Z_obj W) 0).map φ := rfl
      let u : Z_obj W ⟶ F₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α
      have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
      change e_raw W F₂ ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ).app W) α) =
        ((U_X.map φ).app W) (e_raw W F₁ α)
      rw [hmap_φ_mor, CategoryTheory.Abelian.extFunctorObj_map, hα]
      have hpost : ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (Z_obj W) (Nat.add_zero 0))
          (CategoryTheory.Abelian.Ext.mk₀ u) =
          CategoryTheory.Abelian.Ext.mk₀ (u ≫ φ) :=
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ u φ
      change e_raw W F₂ (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (Z_obj W) (Nat.add_zero 0))
          (CategoryTheory.Abelian.Ext.mk₀ u)) = _
      rw [hpost]
      dsimp [e_raw]
      rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
        CategoryTheory.Adjunction.homEquiv_naturality_right,
        CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply,
        ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
      rfl)

  let Ψ : ℕ → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} ⥤
      CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    fun q => CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q ⋙ Sh_X
  let ε₀ : Ψ 0 ≅ CategoryTheory.Functor.id (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) :=
    CategoryTheory.Functor.isoWhiskerRight θ₀ Sh_X ≪≫ CategoryTheory.asIso adj_sh_X.counit

  have hPresheafExact : ∀ (K : CategoryTheory.ShortComplex
      (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})),
      (∀ (W : Opposite X.Etale),
        (K.map ((CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W)).Exact) →
      K.Exact := by
    intro K hW
    rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
      CategoryTheory.Functor.isZero_iff]
    intro W
    let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
    have hZW : CategoryTheory.Limits.IsZero (K.map evW).leftHomology :=
      (CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology (K.map evW)).mp (hW W)
    exact hZW.of_iso (K.mapLeftHomologyIso evW).symm

  have hInjΨZero : ∀ (ℐ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
      [CategoryTheory.Injective ℐ] (k : ℕ),
      CategoryTheory.Limits.IsZero ((Ψ (k + 1)).obj ℐ) := by
    intro ℐ _ k
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    have hpre0 : 𝟙 (ℐ.cohomologyPresheaf (k + 1)) = 0 := by
      ext W x
      exact CategoryTheory.Abelian.Ext.eq_zero_of_injective x
    change 𝟙 (Sh_X.obj (ℐ.cohomologyPresheaf (k + 1))) = 0
    rw [← Sh_X.map_id, hpre0, Sh_X.map_zero]

