          simp only [CategoryTheory.Category.assoc]
        _ = (e_geom W).hom ≫ weilGeomFrobHom F W ≫ (weilGeomFrobHom F W ≫ snd_k) :=
          congrArg ((e_geom W).hom ≫ weilGeomFrobHom F W ≫ ·) hf₁_snd.symm
        _ = ((e_geom W).hom ≫ weilGeomFrobHom F W ≫ weilGeomFrobHom F W) ≫ snd_k := by
