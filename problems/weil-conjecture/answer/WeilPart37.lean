    have hcomp₂ := hPullComp e.inv e.hom m₀ i₀ p_inv p_hom p_id₂ hp_inv hp_hom hc₂
    have hcomp₁ := hPullComp e.hom e.inv m₀ i₀ p_hom p_inv p_id₁ hp_hom hp_inv hc₁
    rw [hid₂] at hcomp₂
    rw [hid₁] at hcomp₁
    refine Function.bijective_iff_has_inverse.mpr ⟨p_inv, fun x => ?_, fun y => ?_⟩
    · exact DFunLike.congr_fun hcomp₂.symm x
    · exact DFunLike.congr_fun hcomp₁.symm y

  obtain ⟨ev_s, hEv_frob, hEv_zero, hEv_lift⟩ :=
    weil_sing_dev_odp_sq_section_stalk_and_nbhd_vanish
      F (2 * m + 2) Z_tilde f₀ U₀ s hs_sec ℓ hℓ f_bar hPb_fbar hPBC
