    refine ⟨j_0, j_1, ⟨q_0, q_1, hq₀_ι, hq₁_ι, hq₀_i, hq₁_i⟩, hBasic₀, hBasic₁, ?_⟩
    
    let X_poly : Polynomial R := Polynomial.X
    let L_X := Localization.Away X_poly
    let ι_L : Polynomial R →+* L_X := algebraMap (Polynomial R) L_X
    let σ_L : Polynomial R →+* L_X :=
      Polynomial.eval₂RingHom (ι_L.comp Polynomial.C)
        (IsLocalization.Away.invSelf (S := L_X) X_poly)
    let U_ov : Z_t.Opens := U₀ ⊓ U₁
    let B₀ : Z_t.Opens := Z_t.basicOpen (ψ₀ X_poly)
    have hAffB₀ : AlgebraicGeometry.IsAffineOpen B₀ := hAff₀.basicOpen (ψ₀ X_poly)
    have hAffOv : AlgebraicGeometry.IsAffineOpen U_ov := by
      dsimp only [U_ov]; rw [hOv₀]; exact hAffB₀
    let res₀ : ↑(Z_t.presheaf.obj (Opposite.op U₀)) →+* ↑(Z_t.presheaf.obj (Opposite.op U_ov)) :=
      (Z_t.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
    let res₁ : ↑(Z_t.presheaf.obj (Opposite.op U₁)) →+* ↑(Z_t.presheaf.obj (Opposite.op U_ov)) :=
      (Z_t.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
    let resB₀ : ↑(Z_t.presheaf.obj (Opposite.op U₀)) →+* ↑(Z_t.presheaf.obj (Opposite.op B₀)) :=
      (Z_t.presheaf.map (CategoryTheory.homOfLE (Z_t.basicOpen_le (ψ₀ X_poly))).op).hom
    let _ : Algebra ↑(Z_t.presheaf.obj (Opposite.op U₀)) ↑(Z_t.presheaf.obj (Opposite.op B₀)) :=
      resB₀.toAlgebra
    have _ : IsLocalization.Away (ψ₀ X_poly) ↑(Z_t.presheaf.obj (Opposite.op B₀)) :=
      hAff₀.isLocalization_basicOpen (ψ₀ X_poly)
    let g₀_L : ↑(Z_t.presheaf.obj (Opposite.op U₀)) →+* L_X :=
      ι_L.comp ψ₀.symm.toRingHom
    have hu_g₀ : IsUnit (g₀_L (ψ₀ X_poly)) := by
      change IsUnit (ι_L (ψ₀.symm (ψ₀ X_poly)))
      rw [ψ₀.symm_apply_apply]
      exact IsLocalization.Away.algebraMap_isUnit X_poly
    let ω_B₀ : ↑(Z_t.presheaf.obj (Opposite.op B₀)) →+* L_X :=
      IsLocalization.Away.lift (ψ₀ X_poly) hu_g₀
    let eq_B₀_Ov : ↑(Z_t.presheaf.obj (Opposite.op U_ov)) →+* ↑(Z_t.presheaf.obj (Opposite.op B₀)) :=
      (Z_t.presheaf.map (CategoryTheory.homOfLE hOv₀.ge).op).hom
    let ω : ↑(Z_t.presheaf.obj (Opposite.op U_ov)) →+* L_X := ω_B₀.comp eq_B₀_Ov
    have hω_res₀ : ω.comp res₀ = g₀_L := by
      have hres_eq : eq_B₀_Ov.comp res₀ = resB₀ := by
        apply RingHom.ext; intro s
        have hc : Z_t.presheaf.map (CategoryTheory.homOfLE inf_le_left).op ≫
            Z_t.presheaf.map (CategoryTheory.homOfLE hOv₀.ge).op =
            Z_t.presheaf.map (CategoryTheory.homOfLE (Z_t.basicOpen_le (ψ₀ X_poly))).op := by
          rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.op_comp]; rfl
        exact congrArg (fun f : Z_t.presheaf.obj (Opposite.op U₀) ⟶ _ => f.hom s) hc
      calc ω.comp res₀
        _ = ω_B₀.comp (eq_B₀_Ov.comp res₀) := rfl
        _ = ω_B₀.comp resB₀ := by rw [hres_eq]
        _ = g₀_L := IsLocalization.Away.lift_comp (ψ₀ X_poly) hu_g₀
    have hω_res₁ : ω.comp res₁ = σ_L.comp ψ₁.symm.toRingHom := by
      have hcomp_ψ₁ : (ω.comp res₁).comp ψ₁.toRingHom = σ_L := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext; intro r
          simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
