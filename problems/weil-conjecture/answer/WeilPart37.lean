      have hsec1 : (f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 x_prod) W hW_prod).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜 x_prod).hom (m₁ (z_F μ))) =
