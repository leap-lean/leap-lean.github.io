        conv_lhs => rw [MvPolynomial.as_sum a]
        conv_rhs => rw [MvPolynomial.as_sum a]
        rw [map_sum, map_sum, map_sum, Finset.mul_sum, map_sum]
        refine Finset.sum_congr rfl fun v hv => ?_
        have hv_ne := MvPolynomial.mem_support_iff.mp hv
