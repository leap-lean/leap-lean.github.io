  have : IrreducibleSpace ↥Zts_2.left :=
    (irreducibleSpace_def ↥Zts_2.left).mpr hIrred_Zts2_univ
  have : AlgebraicGeometry.IsIntegral Zts_2.left :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Zts_2.left
  have : Zts_2.left.IsSeparated := by
    rw [AlgebraicGeometry.Scheme.isSeparated_iff]
    have hterm : CategoryTheory.Limits.terminal.from Zts_2.left =
        Zts_2.hom ≫ CategoryTheory.Limits.terminal.from
          (AlgebraicGeometry.Spec (CommRingCat.of F₂)) :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    rw [hterm]
    infer_instance

  obtain ⟨hDom_A2, _, hFlat_incR2, j_P2, hj_P2_open, _, _, _, hIso_away2, ι_QP, hPb_QP⟩ :=
    hFieldChartPkg F₂
  have : IsDomain (TensorProduct F F₂ A') := hDom_A2
  have : AlgebraicGeometry.IsOpenImmersion j_P2 := hj_P2_open

  let F_split : MvPolynomial (Fin (2 * m + 1 + 1)) F₂ :=
    ∑ j ∈ Finset.range (m + 1),
      if h : 2 * j + 1 < 2 * m + 1 + 1 then
        (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
