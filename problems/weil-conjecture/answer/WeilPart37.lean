          rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
          simp [MvPolynomial.optionEquivLeft_X_none]
        have hΦ_Xne : ∀ (idx : Fin (m₀ + 1) × Fin 2) (h : idx ≠ (0, 1)),
