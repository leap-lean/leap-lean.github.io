  have hSecPb : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      (σ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ Y.left),
      σ ≫ Y.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) →
      let pr_Y : weilGeomScheme K Y ⟶ Y.left := CategoryTheory.Limits.pullback.fst Y.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
      ∃ σ_bar : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K)) ⟶ weilGeomScheme K Y,
        σ_bar ≫ pr_Y =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ σ ∧
        σ_bar ≫ (weilBaseChangeOver K (AlgebraicClosure K) Y).hom =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K))) ∧
        (∀ y : weilGeomScheme K Y, pr_Y.base y ∈ Set.range σ.base ↔ y ∈ Set.range σ_bar.base) := by
    intro Y σ hσ pr_Y
    let g_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
    let σ_bar : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K)) ⟶ weilGeomScheme K Y :=
      CategoryTheory.Limits.pullback.lift (g_k ≫ σ) (𝟙 _) (by
        rw [CategoryTheory.Category.assoc, hσ, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp])
    have hσ_fst : σ_bar ≫ pr_Y = g_k ≫ σ := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hσ_snd : σ_bar ≫ (weilBaseChangeOver K (AlgebraicClosure K) Y).hom = 𝟙 _ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hpb_Y : CategoryTheory.IsPullback (weilBaseChangeOver K (AlgebraicClosure K) Y).hom
        pr_Y g_k Y.hom :=
      (CategoryTheory.IsPullback.of_hasPullback Y.hom g_k).flip
    have hOuter : CategoryTheory.IsPullback
        (σ_bar ≫ (weilBaseChangeOver K (AlgebraicClosure K) Y).hom) g_k g_k (σ ≫ Y.hom) := by
      rw [hσ_snd, hσ]
      exact CategoryTheory.IsPullback.of_horiz_isIso
        ⟨by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]⟩
    have hpb_σ : CategoryTheory.IsPullback σ_bar g_k pr_Y σ :=
      CategoryTheory.IsPullback.of_right hOuter hσ_fst hpb_Y
    refine ⟨σ_bar, hσ_fst, hσ_snd, fun y => ⟨?_, ?_⟩⟩
    · rintro ⟨pt, hpt⟩
      obtain ⟨z, hz, _⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_σ y pt hpt.symm
      exact ⟨z, hz⟩
    · rintro ⟨z, rfl⟩
      exact ⟨g_k.base z, (congrArg (fun f => f.base z) hσ_fst).symm⟩

  have hResPbIso : ∀ {X₁ B₁ X₀ B₀ : AlgebraicGeometry.Scheme.{u}}
      (q_X : X₁ ⟶ X₀) (f₁ : X₁ ⟶ B₁) (f₀' : X₀ ⟶ B₀) (q_B : B₁ ⟶ B₀)
      (_ : CategoryTheory.IsPullback q_X f₁ f₀' q_B) (W₀ : B₀.Opens)
      (_ : CategoryTheory.IsIso (f₀' ∣_ W₀)),
      let W₁ : B₁.Opens := (TopologicalSpace.Opens.map q_B.base).obj W₀
      CategoryTheory.IsIso (f₁ ∣_ W₁) := by
    intro X₁ B₁ X₀ B₀ q_X f₁ f₀' q_B hpb W₀ hf₀_iso W₁
    let _ : CategoryTheory.IsIso (f₀' ∣_ W₀) := hf₀_iso
    have hrange_W : Set.range (W₁.ι ≫ q_B).base ⊆ Set.range W₀.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      exact w.2
    let u_W : W₁.toScheme ⟶ W₀.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift W₀.ι (W₁.ι ≫ q_B) hrange_W
    have hu_W : u_W ≫ W₀.ι = W₁.ι ≫ q_B :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W₀.ι (W₁.ι ≫ q_B) hrange_W
    have hpb_res₁ := (AlgebraicGeometry.isPullback_morphismRestrict f₁ W₁).flip
    have hpb_res₀ := (AlgebraicGeometry.isPullback_morphismRestrict f₀' W₀).flip
    have hpb_paste := hpb_res₁.paste_horiz hpb
    have hcond : ((f₁ ⁻¹ᵁ W₁).ι ≫ q_X) ≫ f₀' = ((f₁ ∣_ W₁) ≫ u_W) ≫ W₀.ι := by
      calc
        ((f₁ ⁻¹ᵁ W₁).ι ≫ q_X) ≫ f₀' = (f₁ ∣_ W₁) ≫ (W₁.ι ≫ q_B) := hpb_paste.w
        _ = (f₁ ∣_ W₁) ≫ (u_W ≫ W₀.ι) := by rw [hu_W]
        _ = ((f₁ ∣_ W₁) ≫ u_W) ≫ W₀.ι := (CategoryTheory.Category.assoc _ _ _).symm
    let u_V : (f₁ ⁻¹ᵁ W₁).toScheme ⟶ (f₀' ⁻¹ᵁ W₀).toScheme :=
      hpb_res₀.lift ((f₁ ⁻¹ᵁ W₁).ι ≫ q_X) ((f₁ ∣_ W₁) ≫ u_W) hcond
    have hpb_outer : CategoryTheory.IsPullback (u_V ≫ (f₀' ⁻¹ᵁ W₀).ι) (f₁ ∣_ W₁) f₀'
        (u_W ≫ W₀.ι) := by
      rw [hpb_res₀.lift_fst, hu_W]
      exact hpb_paste
    have hpb_res : CategoryTheory.IsPullback u_V (f₁ ∣_ W₁) (f₀' ∣_ W₀) u_W :=
      CategoryTheory.IsPullback.of_right hpb_outer (hpb_res₀.lift_snd _ _ _) hpb_res₀
    let s_inv : W₁.toScheme ⟶ (f₁ ⁻¹ᵁ W₁).toScheme :=
      hpb_res.lift (u_W ≫ inv (f₀' ∣_ W₀)) (𝟙 _) (by simp)
    refine ⟨⟨s_inv, ?_, hpb_res.lift_snd _ _ _⟩⟩
    apply hpb_res.hom_ext
    · rw [CategoryTheory.Category.assoc, hpb_res.lift_fst, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc, ← hpb_res.w, CategoryTheory.Category.assoc,
        CategoryTheory.IsIso.hom_inv_id, CategoryTheory.Category.comp_id]
    · rw [CategoryTheory.Category.assoc, hpb_res.lift_snd, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]

  
  have hMainInd : ∀ (m₀ : ℕ)
      (Q : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      [AlgebraicGeometry.IsProper Q.hom]
      [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m₀) Q.hom]
      (ι : Q.left ⟶ (weilProjectiveSpaceOver K (2 * m₀ + 1)).left),
      ι ≫ (weilProjectiveSpaceOver K (2 * m₀ + 1)).hom = Q.hom →
      IsHomogeneousHypersurfacePullbackOver K (2 * m₀ + 1) 2
        (𝟙 (weilProjectiveSpaceOver K (2 * m₀ + 1)))
        (∑ j ∈ Finset.range (m₀ + 1),
          if h : 2 * j + 1 < 2 * m₀ + 1 + 1 then
            (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
              MvPolynomial (Fin (2 * m₀ + 1 + 1)) K) *
              MvPolynomial.X ⟨2 * j + 1, h⟩
