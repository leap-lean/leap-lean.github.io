        have hψ_X : ψ b Polynomial.X = t_el b := by simp [ψ]
        rw [hψ_C, hψ_X, map_mul, map_pow, hval_c, ← hv_deg, pow_add]
        calc
          (u_b ^ v b * u_b ^ v (other b)) *
              ((algebraMap A L_b) (MvPolynomial.C (a.coeff v)) *
                valHom b (t_el b) ^ v (other b))
            = (algebraMap A L_b) (MvPolynomial.C (a.coeff v)) *
                u_b ^ v b * (u_b * valHom b (t_el b)) ^ v (other b) := by
              rw [mul_pow]
