    exact ⟨((inv (π_P2 ∣_ PrimeSpectrum.basicOpen (g_2 0))).base q_bot).1⟩
  have : AlgebraicGeometry.IsIntegral P_2 :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion j_P2
  have : P_2.IsSeparated := by
    rw [AlgebraicGeometry.Scheme.isSeparated_iff]
    have hterm : CategoryTheory.Limits.terminal.from P_2 =
