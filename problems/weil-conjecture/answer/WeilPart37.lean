    obtain ⟨δ_Vp, hδ_Vp_j, _⟩ := hOpenBcIso P V_plus j_V_bar.left hpb_jV j_V_bar.w
    let pr_P : weilGeomScheme K P ⟶ P.left := CategoryTheory.Limits.pullback.fst P.hom
