    · letI : CategoryTheory.IsIso (π_Z.left ∣_ U_Z) := hIso_πZ_UZ
      let e_res := CategoryTheory.asIso (π_Z.left ∣_ U_Z)
      obtain ⟨y_uz, hy_uz⟩ : z ∈ Set.range U_Z.ι.base := by
        rwa [AlgebraicGeometry.Scheme.Opens.range_ι]
      let u := e_res.inv.base y_uz
      let V_uz : Z_tilde.left.Opens := (TopologicalSpace.Opens.map π_Z.left.base).obj U_Z
      refine ⟨V_uz.ι.base u, ?_⟩
      have hcomm : ((π_Z.left ∣_ U_Z) ≫ U_Z.ι).base u = (V_uz.ι ≫ π_Z.left).base u :=
        congrArg (fun f => f.base u) (AlgebraicGeometry.morphismRestrict_ι π_Z.left U_Z)
      change (V_uz.ι ≫ π_Z.left).base u = z
      rw [← hcomm]
      have hu : (π_Z.left ∣_ U_Z).base u = y_uz := by
        change (e_res.inv ≫ e_res.hom).base y_uz = y_uz
        rw [e_res.inv_hom_id]
        rfl
      change U_Z.ι.base ((π_Z.left ∣_ U_Z).base u) = z
      rw [hu, hy_uz]
    · have hz_range : z ∈ Set.range p₀.base := by
        by_contra hnot
        have hz_compl : z ∈ (Set.range p₀.base)ᶜ := hnot
        rw [← hUZ_compl] at hz_compl
        exact hz hz_compl
      obtain ⟨pt, hpt⟩ := hz_range
      obtain ⟨e_W0, -⟩ := he_Wb ⟨0, by omega⟩
      obtain ⟨x₀⟩ :
        Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (2 * m)) K))) :=
        inferInstance
      let q₀ : Q_m.left := (W ⟨0, by omega⟩).ι.base (e_W0.inv.base x₀)
      refine ⟨i₀.left.base q₀, ?_⟩
      have hcomm0 : (i₀.left ≫ π_Z.left).base q₀ = (Q_m.hom ≫ p₀).base q₀ :=
        congrArg (fun f => f.base q₀) hPb_i₀.w
      change (i₀.left ≫ π_Z.left).base q₀ = z
      rw [hcomm0]
      change p₀.base (Q_m.hom.base q₀) = z
      rw [Subsingleton.elim (Q_m.hom.base q₀) pt]
      exact hpt

  
  have hChartBridges : ∀ b : Fin (2 * m + 2),
      (∃ e_aff0 : (U_chart0 b).toScheme ≅ (weilAffineSpaceOver K (2 * m + 1)).left,
        e_aff0.hom ≫ (weilAffineSpaceOver K (2 * m + 1)).hom =
          (U_chart0 b).ι ≫ Z_tilde.hom) ∧
      (∃ e_aff1 : (U_chart1 b).toScheme ≅ (weilAffineSpaceOver K (2 * m + 1)).left,
        e_aff1.hom ≫ (weilAffineSpaceOver K (2 * m + 1)).hom =
          (U_chart1 b).ι ≫ Z_tilde.hom) ∧
      (let V_b : V_plus.toScheme.Opens :=
          (TopologicalSpace.Opens.map (V_plus.ι ≫ p_Q.left).base).obj (W b)
       ∃ (e_Wb : (W b).toScheme ≅ (weilAffineSpaceOver K (2 * m)).left)
         (e_Vb : V_b.toScheme ≅
           CategoryTheory.Limits.pullback (weilAffineSpaceOver K (2 * m)).hom
             (weilAffineSpaceOver K 1).hom),
         e_Wb.hom ≫ (weilAffineSpaceOver K (2 * m)).hom = (W b).ι ≫ Q_m.hom ∧
         e_Vb.hom ≫
             CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K (2 * m)).hom
               (weilAffineSpaceOver K 1).hom =
           ((V_plus.ι ≫ p_Q.left) ∣_ (W b)) ≫ e_Wb.hom) := by
    intro b
    letI : CommRing (R_b b) := hCR b
    letI : Algebra K (R_b b) := hAlg b
    obtain ⟨e_Wb, he_Wb_hom⟩ := he_Wb b
    obtain ⟨hi_Wb_hom, _, hWpQ_Vp, ⟨q_0, q_1, hq0_ι, hq1_ι, hq0_i, hq1_i⟩, _, _, _⟩ :=
      hCharts b
    obtain ⟨_, ⟨e_aff0, he_aff0⟩⟩ :=
      hPolyProdAff (2 * m) (W b).toScheme (U_chart0 b).toScheme q_0
        ((W b).ι ≫ Q_m.hom) e_Wb he_Wb_hom (R_b b) (i_Wb b) (j_0 b) hi_Wb_hom hq0_i
    obtain ⟨⟨e_prod1, he_prod1⟩, ⟨e_aff1, he_aff1⟩⟩ :=
      hPolyProdAff (2 * m) (W b).toScheme (U_chart1 b).toScheme q_1
        ((W b).ι ≫ Q_m.hom) e_Wb he_Wb_hom (R_b b) (i_Wb b) (j_1 b) hi_Wb_hom hq1_i
    have he_aff0' : e_aff0.hom ≫ (weilAffineSpaceOver K (2 * m + 1)).hom =
        (U_chart0 b).ι ≫ Z_tilde.hom := by
      rw [he_aff0, ← CategoryTheory.Category.assoc, hq0_ι, CategoryTheory.Category.assoc, p_Q.w]
    have he_aff1' : e_aff1.hom ≫ (weilAffineSpaceOver K (2 * m + 1)).hom =
        (U_chart1 b).ι ≫ Z_tilde.hom := by
      rw [he_aff1, ← CategoryTheory.Category.assoc, hq1_ι, CategoryTheory.Category.assoc, p_Q.w]
    refine ⟨⟨e_aff0, he_aff0'⟩, ⟨e_aff1, he_aff1'⟩, ?_⟩
    intro V_b
    have hRange_Vb : Set.range (V_b.ι ≫ V_plus.ι).base = Set.range (U_chart1 b).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      ext z
      constructor
      · rintro ⟨v, rfl⟩
        have hv_Vb : V_b.ι.base v ∈ (V_b : Set V_plus.toScheme) := by
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
          exact ⟨v, rfl⟩
        have hz_W : p_Q.left.base ((V_b.ι ≫ V_plus.ι).base v) ∈ W b := hv_Vb
        have hz_Vp : (V_b.ι ≫ V_plus.ι).base v ∈ (V_plus : Set Z_tilde.left) := by
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
          exact ⟨V_b.ι.base v, rfl⟩
        have hz_inf : (V_b.ι ≫ V_plus.ι).base v ∈
            (TopologicalSpace.Opens.map p_Q.left.base).obj (W b) ⊓ V_plus :=
          ⟨hz_W, hz_Vp⟩
        rwa [hWpQ_Vp] at hz_inf
      · intro hz1
        have hz_inf : z ∈ (TopologicalSpace.Opens.map p_Q.left.base).obj (W b) ⊓ V_plus := by
          rwa [hWpQ_Vp]
        have hz_Vp : z ∈ Set.range V_plus.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          exact hz_inf.2
        obtain ⟨u, rfl⟩ := hz_Vp
        have hu_Vb : u ∈ Set.range V_b.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          exact hz_inf.1
        obtain ⟨v, rfl⟩ := hu_Vb
        exact ⟨v, rfl⟩
    let δ_b : V_b.toScheme ≅ (U_chart1 b).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (V_b.ι ≫ V_plus.ι) (U_chart1 b).ι hRange_Vb
    have hδ_fac : δ_b.hom ≫ (U_chart1 b).ι = V_b.ι ≫ V_plus.ι :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac
        (V_b.ι ≫ V_plus.ι) (U_chart1 b).ι hRange_Vb
    have hδ_q1 : δ_b.hom ≫ q_1 = (V_plus.ι ≫ p_Q.left) ∣_ (W b) := by
      rw [← CategoryTheory.cancel_mono (W b).ι, CategoryTheory.Category.assoc, hq1_ι,
        ← CategoryTheory.Category.assoc, hδ_fac,
        AlgebraicGeometry.morphismRestrict_ι (V_plus.ι ≫ p_Q.left) (W b),
        CategoryTheory.Category.assoc]
    refine ⟨e_Wb, δ_b ≪≫ e_prod1, he_Wb_hom, ?_⟩
    rw [CategoryTheory.Iso.trans_hom, CategoryTheory.Category.assoc, he_prod1,
      ← CategoryTheory.Category.assoc, hδ_q1]

  let C_Zt : Fin (2 * (2 * m + 2)) → Z_tilde.left.Opens :=
    fun k => if h : k.1 < 2 * m + 2 then U_chart0 ⟨k.1, h⟩
      else U_chart1 ⟨k.1 - (2 * m + 2), by omega⟩
  have hCZt_cov : (⨆ k : Fin (2 * (2 * m + 2)), C_Zt k) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    have hz_W : p_Q.left.base z ∈ (⨆ b : Fin (2 * m + 2), W b) := by
      rw [hW_cov]
      trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hz_W ⊢
    obtain ⟨b, hb⟩ := hz_W
    have hz_b : z ∈ (TopologicalSpace.Opens.map p_Q.left.base).obj (W b) := hb
    rw [(hCharts b).2.1] at hz_b
    rcases hz_b with hz0 | hz1
    · refine ⟨⟨b.1, by omega⟩, ?_⟩
      dsimp only [C_Zt]
      rw [dif_pos b.2]
      exact hz0
    · refine ⟨⟨b.1 + (2 * m + 2), by omega⟩, ?_⟩
      have hnot : ¬ (b.1 + (2 * m + 2) < 2 * m + 2) := by omega
      have hsub : (⟨b.1 + (2 * m + 2) - (2 * m + 2), by omega⟩ : Fin (2 * m + 2)) = b := by
        ext
        dsimp
        omega
      dsimp only [C_Zt]
      rw [dif_neg hnot, hsub]
      exact hz1
  have hCZt_chart : ∀ k : Fin (2 * (2 * m + 2)),
      ∃ e_k : (C_Zt k).toScheme ≅ (weilAffineSpaceOver K (2 * m + 1)).left,
        e_k.hom ≫ (weilAffineSpaceOver K (2 * m + 1)).hom = (C_Zt k).ι ≫ Z_tilde.hom := by
    intro k
    by_cases hk : k.1 < 2 * m + 2
    · have hC_eq : C_Zt k = U_chart0 ⟨k.1, hk⟩ := dif_pos hk
      rw [hC_eq]
      exact (hChartBridges ⟨k.1, hk⟩).1
    · have hC_eq : C_Zt k = U_chart1 ⟨k.1 - (2 * m + 2), by omega⟩ := dif_neg hk
      rw [hC_eq]
      exact (hChartBridges ⟨k.1 - (2 * m + 2), by omega⟩).2.1
  obtain ⟨hSm_Ztilde, hInt_Zt_imp⟩ :=
    hAffChartCrit (2 * m + 1) (2 * (2 * m + 2)) (by omega) Z_tilde C_Zt hCZt_cov hCZt_chart
  have hGeom_Ztilde : 1 ≤ m → AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom := by
    intro hm
    refine hGeomOfInt Z_tilde (hInt_Zt_imp fun k => ?_)
    have hC0 : C_Zt ⟨0, by omega⟩ = U_chart0 ⟨0, by omega⟩ := dif_pos (Nat.zero_lt_succ _)
    rw [hC0]
    by_cases hk : k.1 < 2 * m + 2
    · have hCk : C_Zt k = U_chart0 ⟨k.1, hk⟩ := dif_pos hk
      rw [hCk]
      exact (hZt_ov hm (hW_ov hm) ⟨k.1, hk⟩).1
    · have hCk : C_Zt k = U_chart1 ⟨k.1 - (2 * m + 2), by omega⟩ := dif_neg hk
      rw [hCk]
      exact (hZt_ov hm (hW_ov hm) ⟨k.1 - (2 * m + 2), by omega⟩).2

  
  have hClauseF : m = 0 →
      let W_tilde : Fin (2 * m + 2) → Z_tilde.left.Opens :=
        fun b => (TopologicalSpace.Opens.map p_Q.left.base).obj (W b)
      W_tilde ⟨0, by omega⟩ ⊓ W_tilde ⟨1, by omega⟩ = ⊥ ∧
      W_tilde ⟨0, by omega⟩ ⊔ W_tilde ⟨1, by omega⟩ = ⊤ ∧
      ∀ b : Fin (2 * m + 2),
        ∃ e_P1 : (W_tilde b).toScheme ≅ (weilProjectiveSpaceOver K 1).left,
          e_P1.hom ≫ (weilProjectiveSpaceOver K 1).hom = (W_tilde b).ι ≫ Z_tilde.hom := by
    intro hm0 W_tilde
    have hW01_bot : W_tilde ⟨0, by omega⟩ ⊓ W_tilde ⟨1, by omega⟩ = ⊥ := by
      have hdisj := hW_m0_disj hm0
      ext z
      change p_Q.left.base z ∈ (W ⟨0, by omega⟩ ⊓ W ⟨1, by omega⟩ : Q_m.left.Opens) ↔ False
      rw [hdisj]
      rfl
    have hW01_top : W_tilde ⟨0, by omega⟩ ⊔ W_tilde ⟨1, by omega⟩ = ⊤ := by
      rw [eq_top_iff]
      intro z _
      have hz : p_Q.left.base z ∈ (⨆ b : Fin (2 * m + 2), W b) := by
        rw [hW_cov]
        trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hz
      obtain ⟨b, hb⟩ := hz
      have hb01 : b = ⟨0, by omega⟩ ∨ b = ⟨1, by omega⟩ := by
        rcases b with ⟨val, hval⟩
        have hlt2 : val = 0 ∨ val = 1 := by omega
        rcases hlt2 with rfl | rfl
        · left; rfl
        · right; rfl
      rcases hb01 with rfl | rfl
      · exact Or.inl hb
      · exact Or.inr hb
    refine ⟨hW01_bot, hW01_top, fun b => ?_⟩
    letI : IsEmpty (Fin (2 * m)) := ⟨fun ⟨_, hi⟩ => by omega⟩
    let eq_m0 : MvPolynomial (Fin (2 * m)) K ≃ₐ[K] K :=
      MvPolynomial.isEmptyAlgEquiv K (Fin (2 * m))
    have hsymm_m0 : eq_m0.symm.toRingHom = algebraMap K (MvPolynomial (Fin (2 * m)) K) :=
      RingHom.ext eq_m0.symm.commutes
    let e_A0 : (weilAffineSpaceOver K (2 * m)).left ≅
        AlgebraicGeometry.Spec (CommRingCat.of K) :=
      { hom := (weilAffineSpaceOver K (2 * m)).hom
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_m0.toRingHom)
        hom_inv_id := by
          change AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (2 * m)) K))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_m0.toRingHom) = 𝟙 _
          rw [← hsymm_m0, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : eq_m0.symm.toRingHom.comp eq_m0.toRingHom = RingHom.id _ :=
            RingHom.ext eq_m0.symm_apply_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_m0.toRingHom) ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (2 * m)) K))) = 𝟙 _
          rw [← hsymm_m0, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : eq_m0.toRingHom.comp eq_m0.symm.toRingHom = RingHom.id _ :=
            RingHom.ext eq_m0.apply_symm_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    letI : CommRing (R_b b) := hCR b
    letI : Algebra K (R_b b) := hAlg b
    obtain ⟨e_Wb, he_Wb_hom⟩ := he_Wb b
    obtain ⟨hi_Wb_hom, hWtilde_eq, _, ⟨q_0, q_1, hq0_ι, hq1_ι, hq0_i, hq1_i⟩,
        hOv0_R, hOv1_R, hGlue_R⟩ := hCharts b
    let g_iso : AlgebraicGeometry.Spec (CommRingCat.of (R_b b)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of K) :=
      (i_Wb b).symm ≪≫ e_Wb ≪≫ e_A0
    have hg_iso_hom : g_iso.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (R_b b))) := by
      change (i_Wb b).inv ≫ e_Wb.hom ≫ (weilAffineSpaceOver K (2 * m)).hom = _
      rw [he_Wb_hom, hi_Wb_hom]
    let r_inv_cat : CommRingCat.of (R_b b) ⟶ CommRingCat.of K :=
      AlgebraicGeometry.Spec.preimage g_iso.inv
    have hr_map : AlgebraicGeometry.Spec.map r_inv_cat = g_iso.inv :=
      AlgebraicGeometry.Spec.map_preimage g_iso.inv
    have h_left_id : CommRingCat.ofHom (algebraMap K (R_b b)) ≫ r_inv_cat = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, hr_map, ← hg_iso_hom, g_iso.inv_hom_id,
        AlgebraicGeometry.Spec.map_id]
    have h_right_id : r_inv_cat ≫ CommRingCat.ofHom (algebraMap K (R_b b)) = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, hr_map, ← hg_iso_hom, g_iso.hom_inv_id,
        AlgebraicGeometry.Spec.map_id]
    let e_R : K ≃+* R_b b :=
      { algebraMap K (R_b b) with
        invFun := r_inv_cat.hom
        left_inv := fun c => congrArg (fun f => f.hom c) h_left_id
        right_inv := fun r => congrArg (fun f => f.hom r) h_right_id }
    have he_R_hom : (e_R : K →+* R_b b) = algebraMap K (R_b b) := rfl
    let e_P : Polynomial K ≃+* Polynomial (R_b b) := Polynomial.mapEquiv e_R
    have he_P_X : e_P Polynomial.X = Polynomial.X := by
      rw [Polynomial.mapEquiv_apply, Polynomial.map_X]
    have he_P_symm_X : e_P.symm Polynomial.X = Polynomial.X := by
      apply e_P.injective
      rw [e_P.apply_symm_apply, he_P_X]
    have he_P_C : e_P.toRingHom.comp Polynomial.C =
        (Polynomial.C : R_b b →+* Polynomial (R_b b)).comp (algebraMap K (R_b b)) := by
      apply RingHom.ext
      intro c
      change (Polynomial.mapEquiv e_R) (Polynomial.C c) = Polynomial.C (algebraMap K (R_b b) c)
      rw [Polynomial.mapEquiv_apply, Polynomial.map_C]
      rfl
    let Spec_P : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial (R_b b))) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_P.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_P.symm.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : e_P.toRingHom.comp e_P.symm.toRingHom = RingHom.id _ :=
            RingHom.ext e_P.apply_symm_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : e_P.symm.toRingHom.comp e_P.toRingHom = RingHom.id _ :=
            RingHom.ext e_P.symm_apply_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }

    let T_b : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
      CategoryTheory.Over.mk ((W_tilde b).ι ≫ Z_tilde.hom)
    let U₀ : (W_tilde b).toScheme.Opens :=
      (TopologicalSpace.Opens.map (W_tilde b).ι.base).obj (U_chart0 b)
    let U₁ : (W_tilde b).toScheme.Opens :=
      (TopologicalSpace.Opens.map (W_tilde b).ι.base).obj (U_chart1 b)
    have hU01_top : U₀ ⊔ U₁ = ⊤ := by
      rw [eq_top_iff]
      intro w _
      let z_w : Z_tilde.left := (W_tilde b).ι.base w
      have hw : z_w ∈ (W_tilde b : Set Z_tilde.left) := by
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
        exact ⟨w, rfl⟩
      exact Eq.mp (congrArg (fun O : Z_tilde.left.Opens => z_w ∈ (O : Set Z_tilde.left)) hWtilde_eq) hw
    have hRange_U0 : Set.range (U₀.ι ≫ (W_tilde b).ι).base = Set.range (U_chart0 b).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      ext z
      constructor
      · rintro ⟨u, rfl⟩
        have hu : U₀.ι.base u ∈ (U₀ : Set (W_tilde b).toScheme) := by
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
          exact ⟨u, rfl⟩
        exact hu
      · intro hz0
        have hz_W : z ∈ Set.range (W_tilde b).ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          change z ∈ (TopologicalSpace.Opens.map p_Q.left.base).obj (W b)
          rw [hWtilde_eq]
          exact Or.inl hz0
        obtain ⟨w, rfl⟩ := hz_W
        have hw_U0 : w ∈ Set.range U₀.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          exact hz0
        obtain ⟨u, rfl⟩ := hw_U0
        exact ⟨u, rfl⟩
    have hRange_U1 : Set.range (U₁.ι ≫ (W_tilde b).ι).base = Set.range (U_chart1 b).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      ext z
      constructor
      · rintro ⟨u, rfl⟩
        have hu : U₁.ι.base u ∈ (U₁ : Set (W_tilde b).toScheme) := by
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
          exact ⟨u, rfl⟩
        exact hu
      · intro hz1
        have hz_W : z ∈ Set.range (W_tilde b).ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          change z ∈ (TopologicalSpace.Opens.map p_Q.left.base).obj (W b)
          rw [hWtilde_eq]
          exact Or.inr hz1
        obtain ⟨w, rfl⟩ := hz_W
        have hw_U1 : w ∈ Set.range U₁.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          exact hz1
        obtain ⟨u, rfl⟩ := hw_U1
        exact ⟨u, rfl⟩
    let γ₀ : U₀.toScheme ≅ (U_chart0 b).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (U₀.ι ≫ (W_tilde b).ι) (U_chart0 b).ι hRange_U0
    let γ₁ : U₁.toScheme ≅ (U_chart1 b).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (U₁.ι ≫ (W_tilde b).ι) (U_chart1 b).ι hRange_U1
    have hγ₀_hom : γ₀.hom ≫ (U_chart0 b).ι = U₀.ι ≫ (W_tilde b).ι :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac
        (U₀.ι ≫ (W_tilde b).ι) (U_chart0 b).ι hRange_U0
    have hγ₀_inv : γ₀.inv ≫ U₀.ι ≫ (W_tilde b).ι = (U_chart0 b).ι :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac
        (U₀.ι ≫ (W_tilde b).ι) (U_chart0 b).ι hRange_U0
    have hγ₁_hom : γ₁.hom ≫ (U_chart1 b).ι = U₁.ι ≫ (W_tilde b).ι :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac
        (U₁.ι ≫ (W_tilde b).ι) (U_chart1 b).ι hRange_U1
    have hγ₁_inv : γ₁.inv ≫ U₁.ι ≫ (W_tilde b).ι = (U_chart1 b).ι :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac
        (U₁.ι ≫ (W_tilde b).ι) (U_chart1 b).ι hRange_U1

    let i₀_loc : U₀.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K)) :=
      γ₀ ≪≫ j_0 b ≪≫ Spec_P
    let i₁_loc : U₁.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K)) :=
      γ₁ ≪≫ j_1 b ≪≫ Spec_P
    have hSpecP_C : Spec_P.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ≫
          (i_Wb b).inv ≫ (W b).ι ≫ Q_m.hom := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_P.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) = _
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, he_P_C,
        CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, ← hi_Wb_hom]
    have hi₀_loc : U₀.ι ≫ T_b.hom =
        i₀_loc.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      change U₀.ι ≫ (W_tilde b).ι ≫ Z_tilde.hom =
        (γ₀.hom ≫ (j_0 b).hom ≫ Spec_P.hom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hSpecP_C,
        ← CategoryTheory.Category.assoc (j_0 b).hom, ← hq0_i,
        CategoryTheory.Category.assoc q_0 (i_Wb b).hom,
        ← CategoryTheory.Category.assoc (i_Wb b).hom (i_Wb b).inv,
        (i_Wb b).hom_inv_id, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc q_0 (W b).ι, hq0_ι,
        CategoryTheory.Category.assoc (U_chart0 b).ι p_Q.left Q_m.hom, p_Q.w,
        ← CategoryTheory.Category.assoc γ₀.hom, hγ₀_hom, CategoryTheory.Category.assoc]
    have hi₁_loc : U₁.ι ≫ T_b.hom =
        i₁_loc.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      change U₁.ι ≫ (W_tilde b).ι ≫ Z_tilde.hom =
        (γ₁.hom ≫ (j_1 b).hom ≫ Spec_P.hom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hSpecP_C,
        ← CategoryTheory.Category.assoc (j_1 b).hom, ← hq1_i,
        CategoryTheory.Category.assoc q_1 (i_Wb b).hom,
        ← CategoryTheory.Category.assoc (i_Wb b).hom (i_Wb b).inv,
        (i_Wb b).hom_inv_id, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc q_1 (W b).ι, hq1_ι,
        CategoryTheory.Category.assoc (U_chart1 b).ι p_Q.left Q_m.hom, p_Q.w,
        ← CategoryTheory.Category.assoc γ₁.hom, hγ₁_hom, CategoryTheory.Category.assoc]

    have hSpecP_basic :
        (TopologicalSpace.Opens.map Spec_P.hom.base).obj
          (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)) =
        PrimeSpectrum.basicOpen (Polynomial.X : Polynomial (R_b b)) := by
      apply SetLike.ext
      intro (p : PrimeSpectrum (Polynomial (R_b b)))
      exact (PrimeSpectrum.mem_basicOpen (Polynomial.X : Polynomial K)
          (PrimeSpectrum.comap e_P.toRingHom p)).trans
        ((not_congr (Iff.of_eq (congrArg (· ∈ p.asIdeal) he_P_X))).trans
          (PrimeSpectrum.mem_basicOpen (Polynomial.X : Polynomial (R_b b)) p).symm)
    have hOv₀_loc : (TopologicalSpace.Opens.map U₀.ι.base).obj U₁ =
        (TopologicalSpace.Opens.map i₀_loc.hom.base).obj
          (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)) := by
      apply SetLike.ext
      intro u
      have hlhs : u ∈ (TopologicalSpace.Opens.map U₀.ι.base).obj U₁ ↔
          γ₀.hom.base u ∈ (TopologicalSpace.Opens.map (U_chart0 b).ι.base).obj (U_chart1 b) := by
        change (U₀.ι ≫ (W_tilde b).ι).base u ∈ U_chart1 b ↔
          (γ₀.hom ≫ (U_chart0 b).ι).base u ∈ U_chart1 b
        rw [hγ₀_hom]
      have hmid1 :
          γ₀.hom.base u ∈ (TopologicalSpace.Opens.map (U_chart0 b).ι.base).obj (U_chart1 b) ↔
            (j_0 b).hom.base (γ₀.hom.base u) ∈
              PrimeSpectrum.basicOpen (Polynomial.X : Polynomial (R_b b)) :=
        Iff.of_eq (congrArg (fun O => γ₀.hom.base u ∈ O) hOv0_R)
      have hmid2 :
          (j_0 b).hom.base (γ₀.hom.base u) ∈
              PrimeSpectrum.basicOpen (Polynomial.X : Polynomial (R_b b)) ↔
            (j_0 b).hom.base (γ₀.hom.base u) ∈
              (TopologicalSpace.Opens.map Spec_P.hom.base).obj
                (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)) :=
        Iff.of_eq (congrArg (fun O => (j_0 b).hom.base (γ₀.hom.base u) ∈ O) hSpecP_basic.symm)
      exact hlhs.trans (hmid1.trans hmid2)
    have hOv₁_loc : (TopologicalSpace.Opens.map U₁.ι.base).obj U₀ =
        (TopologicalSpace.Opens.map i₁_loc.hom.base).obj
          (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)) := by
      apply SetLike.ext
      intro u
      have hlhs : u ∈ (TopologicalSpace.Opens.map U₁.ι.base).obj U₀ ↔
          γ₁.hom.base u ∈ (TopologicalSpace.Opens.map (U_chart1 b).ι.base).obj (U_chart0 b) := by
        change (U₁.ι ≫ (W_tilde b).ι).base u ∈ U_chart0 b ↔
          (γ₁.hom ≫ (U_chart1 b).ι).base u ∈ U_chart0 b
        rw [hγ₁_hom]
      have hmid1 :
          γ₁.hom.base u ∈ (TopologicalSpace.Opens.map (U_chart1 b).ι.base).obj (U_chart0 b) ↔
            (j_1 b).hom.base (γ₁.hom.base u) ∈
              PrimeSpectrum.basicOpen (Polynomial.X : Polynomial (R_b b)) :=
        Iff.of_eq (congrArg (fun O => γ₁.hom.base u ∈ O) hOv1_R)
      have hmid2 :
          (j_1 b).hom.base (γ₁.hom.base u) ∈
              PrimeSpectrum.basicOpen (Polynomial.X : Polynomial (R_b b)) ↔
            (j_1 b).hom.base (γ₁.hom.base u) ∈
              (TopologicalSpace.Opens.map Spec_P.hom.base).obj
                (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)) :=
        Iff.of_eq (congrArg (fun O => (j_1 b).hom.base (γ₁.hom.base u) ∈ O) hSpecP_basic.symm)
      exact hlhs.trans (hmid1.trans hmid2)

    have hGlue_loc :
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (algebraMap (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K)))) ≫
          i₀_loc.inv ≫ U₀.ι =
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (Polynomial.eval₂RingHom
                ((algebraMap (Polynomial K)
                  (Localization.Away (Polynomial.X : Polynomial K))).comp Polynomial.C)
                (IsLocalization.Away.invSelf
                  (S := Localization.Away (Polynomial.X : Polynomial K))
                  (Polynomial.X : Polynomial K)))) ≫
          i₁_loc.inv ≫ U₁.ι := by
      let X_K : Polynomial K := Polynomial.X
      let X_R : Polynomial (R_b b) := Polynomial.X
      let L_K := Localization.Away X_K
      let L_R := Localization.Away X_R
      let g_to_LK : Polynomial (R_b b) →+* L_K :=
        (algebraMap (Polynomial K) L_K).comp e_P.symm.toRingHom
      have hu_XR : IsUnit (g_to_LK X_R) := by
        change IsUnit (algebraMap (Polynomial K) L_K (e_P.symm Polynomial.X))
        rw [he_P_symm_X]
        exact IsLocalization.Away.algebraMap_isUnit X_K
      let φ_loc : L_R →+* L_K :=
        IsLocalization.Away.lift X_R hu_XR
      have hφ_comp : φ_loc.comp (algebraMap (Polynomial (R_b b)) L_R) = g_to_LK :=
        IsLocalization.Away.lift_comp X_R hu_XR
      have hφ_inv : φ_loc (IsLocalization.Away.invSelf (S := L_R) X_R) =
          IsLocalization.Away.invSelf (S := L_K) X_K := by
        have hu_XK : IsUnit (algebraMap (Polynomial K) L_K X_K) :=
          IsLocalization.Away.algebraMap_isUnit X_K
        apply hu_XK.mul_right_inj.mp
        have hX_map : φ_loc (algebraMap (Polynomial (R_b b)) L_R X_R) =
            algebraMap (Polynomial K) L_K X_K := by
          rw [IsLocalization.Away.lift_eq]
          change algebraMap (Polynomial K) L_K (e_P.symm Polynomial.X) = _
          rw [he_P_symm_X]
        rw [← hX_map, ← map_mul, IsLocalization.Away.mul_invSelf, map_one, hX_map,
          IsLocalization.Away.mul_invSelf]
      have hφ_eval : φ_loc.comp
          (Polynomial.eval₂RingHom ((algebraMap (Polynomial (R_b b)) L_R).comp Polynomial.C)
            (IsLocalization.Away.invSelf (S := L_R) X_R)) =
          (Polynomial.eval₂RingHom ((algebraMap (Polynomial K) L_K).comp Polynomial.C)
            (IsLocalization.Away.invSelf (S := L_K) X_K)).comp e_P.symm.toRingHom := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro r
          simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          rw [IsLocalization.Away.lift_eq]
          have hsymm_C : e_P.symm (Polynomial.C r) = Polynomial.C (e_R.symm r) := by
            apply e_P.injective
            rw [e_P.apply_symm_apply, Polynomial.mapEquiv_apply, Polynomial.map_C]
            exact congrArg Polynomial.C (e_R.apply_symm_apply r).symm
          change algebraMap (Polynomial K) L_K (e_P.symm (Polynomial.C r)) =
            Polynomial.eval₂ ((algebraMap (Polynomial K) L_K).comp Polynomial.C)
              (IsLocalization.Away.invSelf X_K) (e_P.symm (Polynomial.C r))
          rw [hsymm_C, Polynomial.eval₂_C, RingHom.comp_apply]
        · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
            he_P_symm_X, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hφ_inv]
      rw [← CategoryTheory.cancel_mono (W_tilde b).ι]
      have hlhs_eq :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) L_K)) ≫
            i₀_loc.inv ≫ U₀.ι) ≫ (W_tilde b).ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial (R_b b)) L_R)) ≫
            (j_0 b).inv ≫ (U_chart0 b).ι := by
        have hSpec_alg : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial (R_b b)) L_R)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) L_K)) ≫
              Spec_P.inv := by
          change _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) L_K)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_P.symm.toRingHom)
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφ_comp]
          change AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom e_P.symm.toRingHom ≫
                CommRingCat.ofHom (algebraMap (Polynomial K) L_K)) = _
          rw [AlgebraicGeometry.Spec.map_comp]
        rw [← CategoryTheory.Category.assoc
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc)), hSpec_alg]
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) L_K)) ≫
            ((Spec_P.inv ≫ (j_0 b).inv ≫ γ₀.inv) ≫ U₀.ι) ≫ (W_tilde b).ι = _
        simp only [CategoryTheory.Category.assoc, hγ₀_inv]
      have hrhs_eq :
          (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (Polynomial.eval₂RingHom ((algebraMap (Polynomial K) L_K).comp Polynomial.C)
                  (IsLocalization.Away.invSelf (S := L_K) X_K))) ≫
            i₁_loc.inv ≫ U₁.ι) ≫ (W_tilde b).ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (Polynomial.eval₂RingHom ((algebraMap (Polynomial (R_b b)) L_R).comp Polynomial.C)
                  (IsLocalization.Away.invSelf (S := L_R) X_R))) ≫
            (j_1 b).inv ≫ (U_chart1 b).ι := by
        have hSpec_ev : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (Polynomial.eval₂RingHom ((algebraMap (Polynomial (R_b b)) L_R).comp Polynomial.C)
                  (IsLocalization.Away.invSelf (S := L_R) X_R))) =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (Polynomial.eval₂RingHom ((algebraMap (Polynomial K) L_K).comp Polynomial.C)
                  (IsLocalization.Away.invSelf (S := L_K) X_K))) ≫
              Spec_P.inv := by
          change _ = _ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_P.symm.toRingHom)
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφ_eval,
            CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
        rw [← CategoryTheory.Category.assoc
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc)), hSpec_ev]
        change _ ≫ ((Spec_P.inv ≫ (j_1 b).inv ≫ γ₁.inv) ≫ U₁.ι) ≫ (W_tilde b).ι = _
        simp only [CategoryTheory.Category.assoc, hγ₁_inv]
      rw [hlhs_eq, hrhs_eq, hGlue_R]
    exact hP1Glue T_b U₀ U₁ hU01_top i₀_loc i₁_loc hi₀_loc hi₁_loc hOv₀_loc hOv₁_loc hGlue_loc

  exact ⟨hGeom_Qsucc, O_succ, e_O, Z_cone, hProp_Zcone, i_Z,
    Q_m, hProp_Qm, hSm_Qm, hGeom_Qm, ι_m, p₀, U_Z,
    Z_tilde, hProp_Ztilde, hSm_Ztilde, hGeom_Ztilde,
    π_Z, hProp_πZ, hSurj_πZ, p_Q, hProp_pQ,
    i₀, i_inf, V_plus, s_inf_V, W,
    ⟨he_O, hiZ_cl, hO_compl⟩,
    ⟨hι_m, hSplit_m⟩,
    ⟨hp₀_hom, hUZ_compl, hIso_πZ_UZ⟩,
    ⟨hi₀_pQ, hi_inf_pQ, hi₀_cl, hVplus_compl, hPb_i₀, hs_inf_V⟩,
    ⟨hW_cov, fun b => (hChartBridges b).2.2⟩,
    hClauseF⟩

theorem weil_split_quad_affine_bundle_cohomology_pullback_bijective (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hA1Zero : ∀ (δ b : ℕ), 1 ≤ b →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage
          (CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver k δ).hom
            (weilAffineSpaceOver k 1).hom)
          b
          (weilEtaleTorsionSheaf
            (CategoryTheory.Limits.pullback (weilAffineSpaceOver k δ).hom
              (weilAffineSpaceOver k 1).hom) ℓ))) :
    (∀ (N q : ℕ), 1 ≤ q →
      Subsingleton (weilEtaleTorsionH (weilAffineSpaceOver k N).left (ℓ ^ (r + 1)) q)) ∧
    (∀ (B V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f : V ⟶ B) (δ M : ℕ) (W : Fin M → B.left.Opens),
      (⨆ j : Fin M, W j) = ⊤ →
      (∀ j : Fin M,
        let V_j : V.left.Opens := (TopologicalSpace.Opens.map f.left.base).obj (W j)
        ∃ (e_B : (W j).toScheme ≅ (weilAffineSpaceOver k δ).left)
          (e_V : V_j.toScheme ≅
            CategoryTheory.Limits.pullback (weilAffineSpaceOver k δ).hom
              (weilAffineSpaceOver k 1).hom),
          e_B.hom ≫ (weilAffineSpaceOver k δ).hom = (W j).ι ≫ B.hom ∧
          e_V.hom ≫
              CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver k δ).hom
                (weilAffineSpaceOver k 1).hom =
            (f.left ∣_ (W j)) ≫ e_B.hom) →
      ∀ (q : ℕ)
        (p_f : weilEtaleTorsionH B.left (ℓ ^ (r + 1)) q →+
          weilEtaleTorsionH V.left (ℓ ^ (r + 1)) q),
        WeilIsTorsionEtalePullback f.left (ℓ ^ (r + 1)) q p_f →
        Function.Bijective p_f) :=
by
  classical
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  
  obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  have hPullIsoBij : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (e : S₁ ≅ S₂) (m₀ i₀ : ℕ),
      ∃ p_hom : weilEtaleTorsionH S₂ m₀ i₀ →+ weilEtaleTorsionH S₁ m₀ i₀,
        Function.Bijective p_hom := by
    intro S₁ S₂ e m₀ i₀
    obtain ⟨p_hom, hp_hom⟩ := hPullEx e.hom m₀ i₀
    obtain ⟨p_inv, hp_inv⟩ := hPullEx e.inv m₀ i₀
    obtain ⟨p_id₂, hp_id₂⟩ := hPullEx (𝟙 S₂) m₀ i₀
    obtain ⟨p_id₁, hp_id₁⟩ := hPullEx (𝟙 S₁) m₀ i₀
    have hid₂ := hPullId m₀ i₀ p_id₂ hp_id₂
    have hid₁ := hPullId m₀ i₀ p_id₁ hp_id₁
    have hc₂ : WeilIsTorsionEtalePullback (e.inv ≫ e.hom) m₀ i₀ p_id₂ := by
      rwa [e.inv_hom_id]
    have hc₁ : WeilIsTorsionEtalePullback (e.hom ≫ e.inv) m₀ i₀ p_id₁ := by
      rwa [e.hom_inv_id]
    have hcomp₂ := hPullComp e.inv e.hom m₀ i₀ p_inv p_hom p_id₂ hp_inv hp_hom hc₂
    have hcomp₁ := hPullComp e.hom e.inv m₀ i₀ p_hom p_inv p_id₁ hp_hom hp_inv hc₁
    rw [hid₂] at hcomp₂
    rw [hid₁] at hcomp₁
    refine ⟨p_hom, Function.bijective_iff_has_inverse.mpr ⟨p_inv, fun x => ?_, fun y => ?_⟩⟩
    · exact DFunLike.congr_fun hcomp₂.symm x
    · exact DFunLike.congr_fun hcomp₁.symm y

  
  have h_mem_etale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (g : Y ⟶ W) (y : ↥Y.left),
          R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  have h_mor_etale : ∀ {S : AlgebraicGeometry.Scheme.{u}} {Y₁ Y₂ : S.Etale} (u : Y₁ ⟶ Y₂),
      AlgebraicGeometry.Etale u.left := by
    intro S Y₁ Y₂ u
    have hw : u.left ≫ Y₂.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w u
    have hcomp : AlgebraicGeometry.Etale (u.left ≫ Y₂.hom) := hw.symm ▸ Y₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      u.left Y₂.hom Y₂.prop hcomp

  
  
  
  have h_unit_iso_conn : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u})
      (E₀ : Z.Etale) [ConnectedSpace ↥E₀.left],
      CategoryTheory.IsIso
        (((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj A)).app (Opposite.op E₀)) := by
    intro Z A E₀ _
    let P_A : CategoryTheory.Functor (Opposite Z.Etale) AddCommGrpCat.{u} :=
      { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥A)
        map := fun {E₁ E₂} g =>
          AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom (Z := ↥A) g.unop.left.base.hom)
        map_id := fun _ => by
          apply AddCommGrpCat.ext; intro g; ext x; rfl
        map_comp := fun _ _ => by
          apply AddCommGrpCat.ext; intro h; ext x; rfl }
    let P_const := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj A
    let θ_A : P_const ⟶ P_A :=
      { app := fun E =>
          AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom (X := ↥E.unop.left) (Y := ↥A))
        naturality := fun _ _ _ => by
          apply AddCommGrpCat.ext; intro a; ext x; rfl }
    have hP_sheaf : CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology P_A := by
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro E S hS
      have hcov := (h_mem_etale Z E S).mp hS
      let eval_c : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w : S.arrows.category) (_ : ↥c.pt), LocallyConstant ↥w.obj.left.left ↥A :=
        fun c w m_pt => (c.π.app (Opposite.op w)).hom m_pt
      have h_ov : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w₁ w₂ : S.arrows.category) (m_pt : ↥c.pt)
          (y₁ : ↥w₁.obj.left.left) (y₂ : ↥w₂.obj.left.left),
          w₁.obj.hom.left.base y₁ = w₂.obj.hom.left.base y₂ →
          eval_c c w₁ m_pt y₁ = eval_c c w₂ m_pt y₂ := by
        intro c w₁ w₂ m_pt y₁ y₂ hy_eq
        let u₁ : w₁.obj.left ⟶ E := w₁.obj.hom
        let u₂ : w₂.obj.left ⟶ E := w₂.obj.hom
        have hu₂_et : AlgebraicGeometry.Etale u₂.left := h_mor_etale u₂
        let Z_sch := CategoryTheory.Limits.pullback u₁.left u₂.left
        let p₁ : Z_sch ⟶ w₁.obj.left.left := CategoryTheory.Limits.pullback.fst u₁.left u₂.left
        let p₂ : Z_sch ⟶ w₂.obj.left.left := CategoryTheory.Limits.pullback.snd u₁.left u₂.left
        have hp₁_et : AlgebraicGeometry.Etale p₁ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback u₁.left u₂.left).flip hu₂_et
        have hZ_et : AlgebraicGeometry.Etale (p₁ ≫ w₁.obj.left.hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            p₁ w₁.obj.left.hom hp₁_et w₁.obj.left.prop
        let Z_et : Z.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ w₁.obj.left.hom) hZ_et
        let q₁ : Z_et ⟶ w₁.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
        have hq₂_w : p₂ ≫ w₂.obj.left.hom = Z_et.hom :=
          (congrArg (p₂ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₂).symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ E.hom) CategoryTheory.Limits.pullback.condition.symm).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (p₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₁)))))
        let q₂ : Z_et ⟶ w₂.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₂ hq₂_w trivial
        have hq_comm : q₁ ≫ u₁ = q₂ ≫ u₂ := by
          apply (AlgebraicGeometry.Scheme.Etale.forget Z).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact CategoryTheory.Limits.pullback.condition
        let w₁₂ : S.arrows.category :=
          ⟨CategoryTheory.Over.mk (q₁ ≫ u₁), S.downward_closed w₁.property q₁⟩
        let mor₁ : w₁₂ ⟶ w₁ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₁ rfl)
        let mor₂ : w₁₂ ⟶ w₂ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₂ hq_comm.symm)
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy_eq
        have hev₁ : eval_c c w₁ m_pt (p₁.base z) = eval_c c w₁₂ m_pt z :=
          congrArg (fun φ => (φ.hom m_pt : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₁.op)
        have hev₂ : eval_c c w₂ m_pt (p₂.base z) = eval_c c w₁₂ m_pt z :=
          congrArg (fun φ => (φ.hom m_pt : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₂.op)
        rw [← hz₁, ← hz₂, hev₁, hev₂]
      refine ⟨{
        lift := fun c =>
          let g_fn : ↥c.pt → ↥E.left → ↥A := fun m_pt x =>
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            eval_c c w_x m_pt y_x
          have hg_eq : ∀ (m_pt : ↥c.pt) (w : S.arrows.category) (y : ↥w.obj.left.left),
              g_fn m_pt (w.obj.hom.left.base y) = eval_c c w m_pt y := by
            intro m_pt w y
            let x := w.obj.hom.left.base y
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            exact h_ov c w_x w m_pt y_x y hy_x
          have hg_lc : ∀ m_pt : ↥c.pt, IsLocallyConstant (g_fn m_pt) := by
            intro m_pt
            rw [IsLocallyConstant.iff_isOpen_fiber]
            intro a
            rw [isOpen_iff_forall_mem_open]
            intro x hx
            let ch := hcov x
            let Y_x := ch.choose
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hEt_x := ch.choose_spec.choose_spec.choose_spec.2.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            let f_x : LocallyConstant ↥Y_x.left ↥A := eval_c c w_x m_pt
            let O : Set ↥Y_x.left := f_x ⁻¹' {a}
            have hO_open : IsOpen O := f_x.isLocallyConstant {a}
            have : AlgebraicGeometry.Etale u_x.left := hEt_x
            have hu_open : IsOpen (u_x.left.base '' O) := u_x.left.isOpenMap O hO_open
            refine ⟨u_x.left.base '' O, ?_, hu_open, ⟨y_x, ?_, hy_x⟩⟩
            · rintro _ ⟨y', hy', rfl⟩
              change g_fn m_pt (w_x.obj.hom.left.base y') = a
              rw [hg_eq m_pt w_x y']
              exact hy'
            · change f_x y_x = a
              have hfx : f_x y_x = g_fn m_pt x := rfl
              rw [hfx]
              exact hx
          AddCommGrpCat.ofHom
            { toFun := fun m_pt => ⟨g_fn m_pt, hg_lc m_pt⟩
              map_zero' := by
                apply LocallyConstant.ext; intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                have h0 : eval_c c w_x 0 = 0 := map_zero (c.π.app (Opposite.op w_x)).hom
                exact congrArg (fun g : LocallyConstant ↥w_x.obj.left.left ↥A => g y_x) h0
              map_add' := fun m₁ m₂ => by
                apply LocallyConstant.ext; intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                have hadd : eval_c c w_x (m₁ + m₂) = eval_c c w_x m₁ + eval_c c w_x m₂ :=
                  map_add (c.π.app (Opposite.op w_x)).hom m₁ m₂
                exact congrArg (fun g : LocallyConstant ↥w_x.obj.left.left ↥A => g y_x) hadd }
        fac := fun c j_idx => by
          apply AddCommGrpCat.ext; intro m_pt
          change _ = eval_c c j_idx.unop m_pt
          ext y
          let x := j_idx.unop.obj.hom.left.base y
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          exact h_ov c w_x j_idx.unop m_pt y_x y hy_x
        uniq := fun c k_mor hk => by
          apply AddCommGrpCat.ext; intro m_pt
          let km : LocallyConstant ↥E.left ↥A := k_mor.hom m_pt
          change km = _
          apply LocallyConstant.ext; intro x
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          have hkx := congrArg
            (fun φ => (φ.hom m_pt : LocallyConstant ↥w_x.obj.left.left ↥A) y_x)
            (hk (Opposite.op w_x))
          change km (u_x.left.base y_x) = eval_c c w_x m_pt y_x at hkx
          rw [hy_x] at hkx
          exact hkx
      }⟩
    have hLocInj : CategoryTheory.Presheaf.IsLocallyInjective Z.smallEtaleTopology θ_A := by
      refine CategoryTheory.Presheaf.IsLocallyInjective.mk ?_
      intro E a₁ a₂ ha
      by_cases hEmp : IsEmpty ↥E.unop.left
      · have hbot : ⊥ ∈ Z.smallEtaleTopology E.unop := by
          let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme :=
            @AlgebraicGeometry.Etale
          let E' : P.Over ⊤ Z := E.unop
          change (⊥ : CategoryTheory.Sieve E') ∈
            ((CategoryTheory.MorphismProperty.Over.forget P ⊤ Z).restrictedTopology
              (AlgebraicGeometry.Scheme.overGrothendieckTopology P Z)) E'
          rw [CategoryTheory.Functor.mem_restrictedTopology_iff]
          exact (CategoryTheory.GrothendieckTopology.mem_over_iff _ _).mpr
            (CategoryTheory.GrothendieckTopology.superset_covering _ bot_le
              (AlgebraicGeometry.Scheme.bot_mem_grothendieckTopology E.unop.left))
        exact Z.smallEtaleTopology.superset_covering bot_le hbot
      · obtain ⟨x₀⟩ := not_isEmpty_iff.mp hEmp
        have ha_eq : a₁ = a₂ := congrArg (fun g : LocallyConstant ↥E.unop.left ↥A => g x₀) ha
        subst ha_eq
        have htop : CategoryTheory.Presheaf.equalizerSieve
            (F := P_const) (X := E) a₁ a₁ = ⊤ :=
          CategoryTheory.Sieve.id_mem_iff_eq_top.mp rfl
        rw [htop]
        exact Z.smallEtaleTopology.top_mem E.unop
    have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective Z.smallEtaleTopology θ_A := by
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
      intro E g_sec
      refine (h_mem_etale Z E (CategoryTheory.Presheaf.imageSieve θ_A g_sec)).mpr ?_
      intro x
      let f_lc : LocallyConstant ↥E.left ↥A := g_sec
      let a : ↥A := f_lc x
      let O_a : E.left.Opens := ⟨f_lc ⁻¹' {a}, f_lc.isLocallyConstant {a}⟩
      have hY_et : AlgebraicGeometry.Etale (O_a.ι ≫ E.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          O_a.ι E.hom inferInstance E.prop
      let Y_a : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_a.ι ≫ E.hom) hY_et
      let u_a : Y_a ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_a.ι rfl trivial
      refine ⟨Y_a, u_a, ⟨x, rfl⟩, ?_, inferInstance, rfl⟩
      refine ⟨a, ?_⟩
      ext y
      exact y.2.symm
    have hW_θ : Z.smallEtaleTopology.W θ_A :=
      (Z.smallEtaleTopology.W_iff_isLocallyBijective θ_A).mpr ⟨hLocInj, hLocSurj⟩
    have hIso_map : CategoryTheory.IsIso
        ((CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map θ_A) :=
      (Z.smallEtaleTopology.W_iff θ_A).mp hW_θ
    let ℒ_A : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} := ⟨P_A, hP_sheaf⟩
    let adj_sh := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let Υ_A : (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj A ⟶ ℒ_A :=
      (adj_sh.homEquiv P_const ℒ_A).symm θ_A
    have hΥ_eq : Υ_A =
        (CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map θ_A ≫
          adj_sh.counit.app ℒ_A :=
      CategoryTheory.Adjunction.homEquiv_counit adj_sh P_const ℒ_A θ_A
    have hIso_counit : CategoryTheory.IsIso (adj_sh.counit.app ℒ_A) := inferInstance
    have : CategoryTheory.IsIso Υ_A := by
      rw [hΥ_eq]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_map hIso_counit
    let Γ_E₀ := (CategoryTheory.sheafSections Z.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op E₀)
    have hIso_ΥE₀ : CategoryTheory.IsIso (Υ_A.hom.app (Opposite.op E₀)) := by
      change CategoryTheory.IsIso (Γ_E₀.map Υ_A)
      infer_instance
    have h_unit_Υ : adj_sh.unit.app P_const ≫ Υ_A.hom = θ_A := by
      have h1 := (adj_sh.homEquiv P_const ℒ_A).apply_symm_apply θ_A
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact h1
    have h_comp_E₀ :
        (adj_sh.unit.app P_const).app (Opposite.op E₀) ≫ Υ_A.hom.app (Opposite.op E₀) =
          θ_A.app (Opposite.op E₀) :=
      congrArg (fun η => η.app (Opposite.op E₀)) h_unit_Υ
    have h_bij : Function.Bijective ⇑(θ_A.app (Opposite.op E₀)).hom := by
      refine ⟨?_, ?_⟩
      · intro a₁ a₂ ha
        obtain ⟨v₀⟩ : Nonempty ↥E₀.left := ConnectedSpace.toNonempty
        exact congrArg (fun g : LocallyConstant ↥E₀.left ↥A => g v₀) ha
      · intro g
        have : PreconnectedSpace ↥E₀.left := ConnectedSpace.toPreconnectedSpace
        have : Nonempty ↥A := ⟨0⟩
        obtain ⟨a, rfl⟩ := LocallyConstant.exists_eq_const g
        exact ⟨a, rfl⟩
    have hIso_θ : CategoryTheory.IsIso (θ_A.app (Opposite.op E₀)) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective (θ_A.app (Opposite.op E₀))).mpr h_bij
    rw [← h_comp_E₀] at hIso_θ
    exact @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _
      ((adj_sh.unit.app P_const).app (Opposite.op E₀)) (Υ_A.hom.app (Opposite.op E₀))
      hIso_ΥE₀ hIso_θ

  have hConstUnitIso : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (g : Quiver.Hom X Y)
      [_hc : (weilEtaleSitePullback g).IsContinuous Y.smallEtaleTopology X.smallEtaleTopology]
      {T_X : X.Etale} (hT_X : CategoryTheory.Limits.IsTerminal T_X)
      {T_Y : Y.Etale} (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
      (A : AddCommGrpCat.{u}),
      (∀ (D : Y.Etale) (y : ↥D.left),
        ∃ (E : Y.Etale) (u : Quiver.Hom E D) (z : ↥E.left),
          u.left.base z = y ∧
          ConnectedSpace ↥E.left ∧
          ConnectedSpace ↥((weilEtaleSitePullback g).obj E).left) →
      let B_g := weilEtaleSitePullback g
      let J_X := X.smallEtaleTopology
      let J_Y := Y.smallEtaleTopology
      let C_X := CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}
      let C_Y := CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}
      let pf_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_X
      let adj_X := CategoryTheory.constantSheafAdj J_X AddCommGrpCat.{u} hT_X
      let adj_Y := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT_Y
      let τ := hT_X.from (B_g.obj T_Y)
      CategoryTheory.IsIso
        ((adj_Y.homEquiv A (pf_g.obj (C_X.obj A))).symm
          (CategoryTheory.CategoryStruct.comp (adj_X.unit.app A)
            ((C_X.obj A).obj.map τ.op))) := by
    intro X Y g _hc T_X hT_X T_Y hT_Y A hBasis B_g J_X J_Y C_X C_Y pf_g adj_X adj_Y τ
    set η_g : C_Y.obj A ⟶ pf_g.obj (C_X.obj A) :=
      (adj_Y.homEquiv A (pf_g.obj (C_X.obj A))).symm
        (CategoryTheory.CategoryStruct.comp (adj_X.unit.app A) ((C_X.obj A).obj.map τ.op))
    let constX := (CategoryTheory.Functor.const (Opposite X.Etale)).obj A
    let constY := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj A
    let adj_shX := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
    let adj_shY := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
    let η_X : constX ⟶ (C_X.obj A).obj := adj_shX.unit.app constX
    let η_Y : constY ⟶ (C_Y.obj A).obj := adj_shY.unit.app constY
    let u_pre : constY ⟶ (pf_g.obj (C_X.obj A)).obj :=
      CategoryTheory.Functor.whiskerLeft B_g.op η_X
    let u_sh : C_Y.obj A ⟶ pf_g.obj (C_X.obj A) :=
      (adj_shY.homEquiv constY (pf_g.obj (C_X.obj A))).symm u_pre
    have hu_fac : η_Y ≫ u_sh.hom = u_pre := by
      have h1 := (adj_shY.homEquiv constY (pf_g.obj (C_X.obj A))).apply_symm_apply u_pre
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact h1
    have hη_eq_ush : η_g = u_sh := by
      apply (adj_Y.homEquiv A (pf_g.obj (C_X.obj A))).injective
      have hlhs : (adj_Y.homEquiv A (pf_g.obj (C_X.obj A))) η_g =
          η_X.app (Opposite.op T_X) ≫ (C_X.obj A).obj.map τ.op :=
        (adj_Y.homEquiv A (pf_g.obj (C_X.obj A))).apply_symm_apply _
      have hrhs : (adj_Y.homEquiv A (pf_g.obj (C_X.obj A))) u_sh =
          η_X.app (Opposite.op (B_g.obj T_Y)) :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_Y A (pf_g.obj (C_X.obj A)) u_sh).trans
          (congrArg (fun ν : constY ⟶ (pf_g.obj (C_X.obj A)).obj => ν.app (Opposite.op T_Y)) hu_fac)
      have hnat : η_X.app (Opposite.op T_X) ≫ (C_X.obj A).obj.map τ.op =
          η_X.app (Opposite.op (B_g.obj T_Y)) :=
        (η_X.naturality τ.op).symm.trans (CategoryTheory.Category.id_comp _)
      exact hlhs.trans (hnat.trans hrhs.symm)
    rw [hη_eq_ush]
    have hu_iso_on_conn : ∀ (E : Y.Etale),
        ConnectedSpace ↥E.left →
        ConnectedSpace ↥(B_g.obj E).left →
        CategoryTheory.IsIso (u_sh.hom.app (Opposite.op E)) := by
      intro E hC1 hC2
      have : ConnectedSpace ↥E.left := hC1
      have : ConnectedSpace ↥(B_g.obj E).left := hC2
      have : CategoryTheory.IsIso (η_Y.app (Opposite.op E)) := h_unit_iso_conn Y A E
      have : CategoryTheory.IsIso (u_pre.app (Opposite.op E)) := h_unit_iso_conn X A (B_g.obj E)
      have hfac_E : η_Y.app (Opposite.op E) ≫ u_sh.hom.app (Opposite.op E) =
          u_pre.app (Opposite.op E) :=
        congrArg (fun ν => ν.app (Opposite.op E)) hu_fac
      exact CategoryTheory.IsIso.of_isIso_fac_left hfac_E
    have hMono_ush : CategoryTheory.Mono u_sh := by
      have hMono_hom : CategoryTheory.Mono u_sh.hom := by
        rw [CategoryTheory.NatTrans.mono_iff_mono_app]
        intro W_op
        obtain ⟨D⟩ := W_op
        rw [AddCommGrpCat.mono_iff_injective, injective_iff_map_eq_zero]
        intro s hs
        let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
        have hSheaf_ℤ : CategoryTheory.Presieve.IsSheaf J_Y
            ((C_Y.obj A).obj.comp (CategoryTheory.coyoneda.obj (Opposite.op Aℤ))) :=
          (C_Y.obj A).property Aℤ
        let homOfSec : ↥((C_Y.obj A).obj.obj (Opposite.op D)) →
            (Aℤ ⟶ (C_Y.obj A).obj.obj (Opposite.op D)) :=
          fun z => AddCommGrpCat.ofHom
            { toFun := fun n => n.down • z
              map_zero' := zero_zsmul z
              map_add' := fun a b => add_zsmul z a.down b.down }
        let R_D : CategoryTheory.Sieve D :=
          { arrows := fun {_} u => ((C_Y.obj A).obj.map u.op).hom s = 0
            downward_closed := fun {_ _} u hu v => by
              change ((C_Y.obj A).obj.map (u.op ≫ v.op)).hom s = 0
              rw [(C_Y.obj A).obj.map_comp]
              change ((C_Y.obj A).obj.map v.op).hom (((C_Y.obj A).obj.map u.op).hom s) = 0
              rw [hu, map_zero] }
        have hRD_mem : R_D ∈ J_Y D := by
          refine (h_mem_etale Y D R_D).mpr (fun y => ?_)
          obtain ⟨E, u, z, hy, hC1, hC2⟩ := hBasis D y
          have hIso_E : CategoryTheory.IsIso (u_sh.hom.app (Opposite.op E)) :=
            hu_iso_on_conn E hC1 hC2
          have hInj_E : Function.Injective ⇑(u_sh.hom.app (Opposite.op E)).hom :=
            ((CategoryTheory.ConcreteCategory.isIso_iff_bijective
              (u_sh.hom.app (Opposite.op E))).mp hIso_E).1
          refine ⟨E, u, z, ?_, h_mor_etale u, hy⟩
          apply hInj_E
          rw [map_zero]
          have hnat := congrArg (fun φ => φ.hom s) (u_sh.hom.naturality u.op)
          change (u_sh.hom.app (Opposite.op E)).hom (((C_Y.obj A).obj.map u.op).hom s) =
            ((pf_g.obj (C_X.obj A)).obj.map u.op).hom ((u_sh.hom.app (Opposite.op D)).hom s) at hnat
          rw [hnat, hs, map_zero]
        have hSep := (hSheaf_ℤ R_D hRD_mem).isSeparatedFor
        have heq_hom : homOfSec s = (0 : Aℤ ⟶ (C_Y.obj A).obj.obj (Opposite.op D)) := by
          refine hSep.ext (fun V u hu => ?_)
          apply AddCommGrpCat.ext; intro ⟨n⟩
          change ((C_Y.obj A).obj.map u.op).hom (n • s) = ((C_Y.obj A).obj.map u.op).hom 0
          rw [map_zero, map_zsmul, hu, zsmul_zero]
        have h1 := CategoryTheory.ConcreteCategory.congr_hom heq_hom (ULift.up (1 : ℤ))
        simpa [homOfSec] using h1
      exact (CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u}).mono_of_mono_map hMono_hom
    have hEpi_ush : CategoryTheory.Epi u_sh := by
      refine (CategoryTheory.Sheaf.isLocallySurjective_iff_epi'
        (A := AddCommGrpCat.{u}) u_sh).mp ?_
      rw [← CategoryTheory.Sheaf.isLocallySurjective_sheafToPresheaf_map_iff]
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
      intro D t
      refine (h_mem_etale Y D (CategoryTheory.Presheaf.imageSieve u_sh.hom t)).mpr ?_
      intro y
      obtain ⟨E, u, z, hy, hC1, hC2⟩ := hBasis D y
      have hIso_E : CategoryTheory.IsIso (u_sh.hom.app (Opposite.op E)) :=
        hu_iso_on_conn E hC1 hC2
      refine ⟨E, u, z, ?_, h_mor_etale u, hy⟩
      refine ⟨(CategoryTheory.inv (u_sh.hom.app (Opposite.op E))).hom
          (((pf_g.obj (C_X.obj A)).obj.map u.op).hom t), ?_⟩
      change (CategoryTheory.inv (u_sh.hom.app (Opposite.op E)) ≫
          u_sh.hom.app (Opposite.op E)).hom
          (((pf_g.obj (C_X.obj A)).obj.map u.op).hom t) =
        ((pf_g.obj (C_X.obj A)).obj.map u.op).hom t
      rw [CategoryTheory.IsIso.inv_hom_id]
      rfl
    exact CategoryTheory.isIso_of_mono_of_epi u_sh

  
  
  
  have hPullbackIsoLeft : ∀ {X₁ X₂ Y S : AlgebraicGeometry.Scheme.{u}}
      (e : X₁ ≅ X₂) (g₁ : X₁ ⟶ S) (g₂ : X₂ ⟶ S) (h : Y ⟶ S),
      e.hom ≫ g₂ = g₁ →
      Nonempty (CategoryTheory.Limits.pullback g₁ h ≅ CategoryTheory.Limits.pullback g₂ h) := by
    intro X₁ X₂ Y S e g₁ g₂ h he
    refine ⟨{
      hom := CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g₁ h ≫ e.hom)
        (CategoryTheory.Limits.pullback.snd g₁ h)
        (by rw [CategoryTheory.Category.assoc, he, CategoryTheory.Limits.pullback.condition])
      inv := CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g₂ h ≫ e.inv)
        (CategoryTheory.Limits.pullback.snd g₂ h)
        (by rw [CategoryTheory.Category.assoc, ← he, ← CategoryTheory.Category.assoc e.inv,
            e.inv_hom_id, CategoryTheory.Category.id_comp, CategoryTheory.Limits.pullback.condition])
      hom_inv_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst_assoc, CategoryTheory.Category.assoc,
            e.hom_inv_id, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
      inv_hom_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst_assoc, CategoryTheory.Category.assoc,
            e.inv_hom_id, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp] }⟩

  have hBundleConnBasis : ∀ (B V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f : V ⟶ B) (δ M : ℕ) (W : Fin M → B.left.Opens),
      (⨆ j : Fin M, W j) = ⊤ →
      (∀ j : Fin M,
        let V_j : V.left.Opens := (TopologicalSpace.Opens.map f.left.base).obj (W j)
        ∃ (e_B : (W j).toScheme ≅ (weilAffineSpaceOver k δ).left)
          (e_V : V_j.toScheme ≅
            CategoryTheory.Limits.pullback (weilAffineSpaceOver k δ).hom
              (weilAffineSpaceOver k 1).hom),
          e_B.hom ≫ (weilAffineSpaceOver k δ).hom = (W j).ι ≫ B.hom ∧
          e_V.hom ≫
              CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver k δ).hom
                (weilAffineSpaceOver k 1).hom =
            (f.left ∣_ (W j)) ≫ e_B.hom) →
      ∀ (D : B.left.Etale) (y : ↥D.left),
        ∃ (E : B.left.Etale) (u : Quiver.Hom E D) (z : ↥E.left),
          u.left.base z = y ∧
          ConnectedSpace ↥E.left ∧
          ConnectedSpace ↥((weilEtaleSitePullback f.left).obj E).left := by
    intro B V f δ M W hCov hTriv D y
    have hy_top : D.hom.base y ∈ (⨆ j : Fin M, W j) := by
      rw [hCov]; trivial
    obtain ⟨j, hy_Wj⟩ := TopologicalSpace.Opens.mem_iSup.mp hy_top
    obtain ⟨e_B, e_V, _, he_V⟩ := hTriv j
    let O₁ : D.left.Opens := (TopologicalSpace.Opens.map D.hom.base).obj (W j)
    have hy_O₁ : y ∈ O₁ := hy_Wj
    obtain ⟨O₂, hAff2, hy_O₂, hO₂_le⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y) (U := O₁) hy_O₁
    have : AlgebraicGeometry.IsAffine O₂.toScheme := hAff2
    have hrange_O₂ : Set.range (O₂.ι ≫ D.hom).base ⊆ Set.range (W j).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      exact hO₂_le w.2
    let v_W : O₂.toScheme ⟶ (W j).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift (W j).ι (O₂.ι ≫ D.hom) hrange_O₂
    have hv_W : v_W ≫ (W j).ι = O₂.ι ≫ D.hom :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (W j).ι (O₂.ι ≫ D.hom) hrange_O₂
    have hEt_O₂D : AlgebraicGeometry.Etale (O₂.ι ≫ D.hom) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        O₂.ι D.hom inferInstance D.prop
    have hEt_vW : AlgebraicGeometry.Etale v_W :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        v_W (W j).ι (inferInstance : AlgebraicGeometry.Etale (W j).ι) (hv_W.symm ▸ hEt_O₂D)
    let u_X : O₂.toScheme ⟶ (weilAffineSpaceOver k δ).left := v_W ≫ e_B.hom
    have : AlgebraicGeometry.Etale u_X :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        v_W e_B.hom hEt_vW inferInstance
    let y₂ : ↥O₂.toScheme := ⟨y, hy_O₂⟩
    let ψ := AlgebraicGeometry.Scheme.homeoOfIso O₂.toScheme.isoSpec
    let p₂ := ψ y₂
    obtain ⟨𝔪, h_max, h_le⟩ := Ideal.exists_le_maximal p₂.asIdeal p₂.isPrime.ne_top
    let q_max : PrimeSpectrum ↑(O₂.toScheme.presheaf.obj (Opposite.op ⊤)) := ⟨𝔪, h_max.isPrime⟩
    let x₀ : ↥O₂.toScheme := ψ.symm q_max
    have hq_cl : IsClosed ({q_max} : Set (PrimeSpectrum ↑(O₂.toScheme.presheaf.obj (Opposite.op ⊤)))) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_max).mpr h_max
    have hx₀_cl : IsClosed ({x₀} : Set ↥O₂.toScheme) := by
      have himg : ψ.symm '' ({q_max} : Set _) = {x₀} := Set.image_singleton
      rw [← himg]
      exact ψ.symm.isClosed_image.mpr hq_cl
    have hp_spec : p₂ ⤳ q_max := (PrimeSpectrum.le_iff_specializes p₂ q_max).mp h_le
    have hy₂_spec : y₂ ⤳ x₀ := by
      have hmap := hp_spec.map ψ.symm.continuous
      rwa [ψ.symm_apply_apply] at hmap
    obtain ⟨U, hAffU, hx₀_U, hIntU⟩ :=
      (weil_algClosed_smooth_etale_local_domain_and_connected_integral k).1 δ O₂.toScheme u_X x₀ hx₀_cl
    have : AlgebraicGeometry.IsAffine U.toScheme := hAffU
    have : AlgebraicGeometry.IsIntegral U.toScheme := hIntU
    have hy₂_U : y₂ ∈ U := hy₂_spec.mem_open U.isOpen hx₀_U
    let z_E : ↥U.toScheme := ⟨y₂, hy₂_U⟩
    let u_mor : U.toScheme ⟶ D.left := U.ι ≫ O₂.ι
    have hEt_umor : AlgebraicGeometry.Etale u_mor :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        U.ι O₂.ι inferInstance inferInstance
    let e_hom : U.toScheme ⟶ B.left := u_mor ≫ D.hom
    have hEt_ehom : AlgebraicGeometry.Etale e_hom :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        u_mor D.hom hEt_umor D.prop
    let E : B.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ e_hom hEt_ehom
    let u_et : E ⟶ D := CategoryTheory.MorphismProperty.Over.homMk u_mor rfl trivial
    have : IrreducibleSpace ↥U.toScheme := AlgebraicGeometry.irreducibleSpace_of_isIntegral U.toScheme
    have hConn_E : ConnectedSpace ↥E.left := IrreducibleSpace.connectedSpace ↥U.toScheme
    
    let V_j : V.left.Opens := (TopologicalSpace.Opens.map f.left.base).obj (W j)
    let f_j : V_j.toScheme ⟶ (W j).toScheme := f.left ∣_ (W j)
    let w_U : U.toScheme ⟶ (W j).toScheme := U.ι ≫ v_W
    have hw_E : w_U ≫ (W j).ι = e_hom := by
      dsimp [w_U, e_hom, u_mor]
      rw [CategoryTheory.Category.assoc, hv_W, CategoryTheory.Category.assoc]
    have hSq_top : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst w_U f_j)
        (CategoryTheory.Limits.pullback.snd w_U f_j) w_U f_j :=
      CategoryTheory.IsPullback.of_hasPullback w_U f_j
    have hSq_res : CategoryTheory.IsPullback f_j V_j.ι (W j).ι f.left :=
      AlgebraicGeometry.isPullback_morphismRestrict f.left (W j)
    have hPb_E : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst w_U f_j)
        (CategoryTheory.Limits.pullback.snd w_U f_j ≫ V_j.ι) e_hom f.left := by
      rw [← hw_E]
      exact hSq_top.paste_vert hSq_res
    let e_to_E := hPb_E.isoPullback
    let S_δ := weilAffineSpaceOver k δ
    let S_1 := weilAffineSpaceOver k 1
    let pr₁ := CategoryTheory.Limits.pullback.fst S_δ.hom S_1.hom
    have hSq_triv : CategoryTheory.IsPullback f_j e_V.hom e_B.hom pr₁ :=
      CategoryTheory.IsPullback.of_vert_isIso ⟨he_V.symm⟩
    have hSq_aff : CategoryTheory.IsPullback pr₁
        (CategoryTheory.Limits.pullback.snd S_δ.hom S_1.hom) S_δ.hom S_1.hom :=
      CategoryTheory.IsPullback.of_hasPullback S_δ.hom S_1.hom
    let p_U : U.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      (w_U ≫ e_B.hom) ≫ S_δ.hom
    have hPb_aff : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst w_U f_j)
        ((CategoryTheory.Limits.pullback.snd w_U f_j ≫ e_V.hom) ≫
          CategoryTheory.Limits.pullback.snd S_δ.hom S_1.hom)
        p_U S_1.hom :=
      (hSq_top.paste_vert hSq_triv).paste_vert hSq_aff
    let e_to_aff := hPb_aff.isoPullback
    have hDomA : IsDomain ↑(U.toScheme.presheaf.obj (Opposite.op ⊤)) :=
      @AlgebraicGeometry.IsIntegral.component_integral U.toScheme _ ⊤ ⟨⟨z_E, trivial⟩⟩
    let A := ↑(U.toScheme.presheaf.obj (Opposite.op ⊤))
    let e_U : U.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of A) := U.toScheme.isoSpec
    let φ_hom : CommRingCat.of k ⟶ CommRingCat.of A :=
      AlgebraicGeometry.Spec.preimage (e_U.inv ≫ p_U)
    let _ : Algebra k A := φ_hom.hom.toAlgebra
    have h_pU : e_U.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)) = p_U := by
      have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)) = e_U.inv ≫ p_U :=
        AlgebraicGeometry.Spec.map_preimage (e_U.inv ≫ p_U)
      rw [h1, CategoryTheory.Iso.hom_inv_id_assoc]
    obtain ⟨e_pb1⟩ := hPullbackIsoLeft e_U p_U
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))) S_1.hom h_pU
    let e_pb2 := AlgebraicGeometry.pullbackSpecIso k A (MvPolynomial (Fin 1) k)
    let e_alg : TensorProduct k A (MvPolynomial (Fin 1) k) ≃+* MvPolynomial (Fin 1) A :=
      (MvPolynomial.algebraTensorAlgEquiv k A).toRingEquiv
    let e_pb3 : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A (MvPolynomial (Fin 1) k))) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) A)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h : e_alg.symm.toRingHom.comp e_alg.toRingHom = RingHom.id _ :=
            RingHom.ext e_alg.symm_apply_apply
          rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h : e_alg.toRingHom.comp e_alg.symm.toRingHom = RingHom.id _ :=
            RingHom.ext e_alg.apply_symm_apply
          rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    let e_tot : CategoryTheory.Limits.pullback e_hom f.left ≅
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) A)) :=
      (((e_to_E.symm ≪≫ e_to_aff) ≪≫ e_pb1) ≪≫ e_pb2) ≪≫ e_pb3
    have : AlgebraicGeometry.IsIntegral
        (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) A))) := inferInstance
    have : IrreducibleSpace
        ↥(AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) A))) :=
