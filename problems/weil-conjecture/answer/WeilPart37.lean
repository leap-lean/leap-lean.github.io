    let homSec : Aℤ ⟶ R_X.obj.obj (Opposite.op E) :=
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • sec
          map_zero' := zero_zsmul sec
          map_add' := fun a₁ a₂ => add_zsmul sec a₁.down a₂.down }
    let zeroHom : Aℤ ⟶ R_X.obj.obj (Opposite.op E) := 0
    let zeroFam : Presieve.FamilyOfElements (R_X.obj ⋙ coyoneda.obj (Opposite.op Aℤ)) R_van.arrows :=
      fun W' _ _ => (0 : Aℤ ⟶ R_X.obj.obj (Opposite.op W'))
    have hAmalg₁ : zeroFam.IsAmalgamation homSec := by
      intro W' f hf
      apply AddCommGrpCat.ext
      intro n
      change (R_X.obj.map f.op).hom (n.down • sec) = 0
      rw [map_zsmul, hf, zsmul_zero]
    have hAmalg₂ : zeroFam.IsAmalgamation zeroHom := by
      intro W' f _
      change zeroHom ≫ R_X.obj.map f.op = 0
      exact Limits.zero_comp
    have hEq0 : homSec = zeroHom := hIsSep zeroFam homSec zeroHom hAmalg₁ hAmalg₂
    change sec = 0
    have h1 := congrArg (fun φ : Aℤ ⟶ R_X.obj.obj (Opposite.op E) => φ.hom (ULift.up (1 : ℤ))) hEq0
    simpa only [homSec, zeroHom, AddCommGrpCat.hom_ofHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk,
      one_zsmul, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] using h1

  have hUnitIso : ∀
      [_hc : (weilEtaleSitePullback j_X).IsContinuous X.smallEtaleTopology X_U.smallEtaleTopology]
      [_hr : ((weilEtaleSitePullback j_X).sheafPushforwardContinuous AddCommGrpCat.{u}
        X.smallEtaleTopology X_U.smallEtaleTopology).IsRightAdjoint]
      {T_XU : X_U.Etale} (hT_XU : Limits.IsTerminal T_XU)
      {T_X : X.Etale} (hT_X : Limits.IsTerminal T_X),
      IsIso (((weilEtaleSitePullback j_X).sheafAdjunctionContinuous AddCommGrpCat.{u}
        X.smallEtaleTopology X_U.smallEtaleTopology).homEquiv
        (weilEtaleTorsionSheaf X ℓ) (weilEtaleTorsionSheaf X_U ℓ)
        (weilEtaleConstPullbackHom j_X hT_XU hT_X
          (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))))) := by
    intro _hc _hr T_XU hT_XU T_X hT_X
    have h_hc_jX : _hc = hCont_pull j_X := Subsingleton.elim _ _
    subst h_hc_jX
    let P_et : MorphismProperty Scheme.{u} := @AlgebraicGeometry.Etale
    have _ : ∀ {Z₁ Z₂ : Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        MorphismProperty.HasPullbacksAlong P_et h :=
      fun _ => MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have _ : ∀ {Z₁ Z₂ : Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        MorphismProperty.IsStableUnderBaseChangeAlong P_et h :=
      fun _ => MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))

    let T_id : ∀ S : Scheme.{u}, S.Etale :=
      fun S => MorphismProperty.Over.mk ⊤ (CategoryStruct.id S) (MorphismProperty.id_mem P_et S)
    have hT_id : ∀ S : Scheme.{u}, Limits.IsTerminal (T_id S) :=
      fun S => Limits.IsTerminal.ofUniqueHom
        (fun Y₀ => MorphismProperty.Over.homMk Y₀.hom (Category.comp_id Y₀.hom) trivial)
        (fun Y₀ m => MorphismProperty.Comma.Hom.ext
          ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)) (Subsingleton.elim _ _))
    let P_const : ∀ S : Scheme.{u}, Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
      fun S => (Functor.const (Opposite S.Etale)).obj AM
    let η_sh : ∀ S : Scheme.{u}, P_const S ⟶ (weilEtaleTorsionSheaf S ℓ).obj :=
      fun S => (sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app (P_const S)
    have hConstUnit : ∀ {S : Scheme.{u}} {T_S : S.Etale} (hT_S : Limits.IsTerminal T_S),
        (constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S).unit.app AM =
          (η_sh S).app (Opposite.op T_S) := by
      intro S T_S hT_S
      dsimp [constantSheafAdj, η_sh, P_const]
      exact Category.id_comp _
    let canonUnit : ∀ {S₁ S₂ : Scheme.{u}} (h : S₁ ⟶ S₂)
        [hc_h : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology],
        weilEtaleTorsionSheaf S₂ ℓ ⟶
          ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
            S₂.smallEtaleTopology S₁.smallEtaleTopology).obj (weilEtaleTorsionSheaf S₁ ℓ) :=
      fun {S₁ S₂} h _ =>
        ((sheafificationAdjunction S₂.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
          (P_const S₂)
          (((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
            S₂.smallEtaleTopology S₁.smallEtaleTopology).obj (weilEtaleTorsionSheaf S₁ ℓ))).symm
          (Functor.whiskerLeft (weilEtaleSitePullback h).op (η_sh S₁))
    have hCanonUnit_unit : ∀ {S₁ S₂ : Scheme.{u}} (h : S₁ ⟶ S₂)
        [hc_h : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology],
        η_sh S₂ ≫ (canonUnit h).hom = Functor.whiskerLeft (weilEtaleSitePullback h).op (η_sh S₁) := by
      intro S₁ S₂ h _
      change (sheafificationAdjunction S₂.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
        (P_const S₂) _ (canonUnit h) = _
      exact ((sheafificationAdjunction S₂.smallEtaleTopology AddCommGrpCat.{u}).homEquiv _ _).apply_symm_apply _
    have hCanonUnit_eq_mate : ∀ {S₁ S₂ : Scheme.{u}} (h : S₁ ⟶ S₂)
        [hc_h : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
        [hr_h : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
          S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint]
        {T₁ : S₁.Etale} (hT₁ : Limits.IsTerminal T₁)
        {T₂ : S₂.Etale} (hT₂ : Limits.IsTerminal T₂),
        (((weilEtaleSitePullback h).sheafAdjunctionContinuous AddCommGrpCat.{u}
          S₂.smallEtaleTopology S₁.smallEtaleTopology).homEquiv
          (weilEtaleTorsionSheaf S₂ ℓ) (weilEtaleTorsionSheaf S₁ ℓ)
          (weilEtaleConstPullbackHom h hT₁ hT₂ AM)) = canonUnit h := by
      intro S₁ S₂ h _ _ T₁ hT₁ T₂ hT₂
      let B_h := weilEtaleSitePullback h
      let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      let adj_pull := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      let adj₁ := constantSheafAdj S₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
      let adj₂ := constantSheafAdj S₂.smallEtaleTopology AddCommGrpCat.{u} hT₂
      let τ : B_h.obj T₂ ⟶ T₁ := hT₁.from (B_h.obj T₂)
      dsimp [weilEtaleConstPullbackHom]
      rw [(adj_pull.homEquiv _ _).apply_symm_apply]
      apply (adj₂.homEquiv AM (pf_h.obj (weilEtaleTorsionSheaf S₁ ℓ))).injective
      rw [(adj₂.homEquiv AM _).apply_symm_apply, Adjunction.homEquiv_unit, hConstUnit hT₂]
      have happ : (η_sh S₂).app (Opposite.op T₂) ≫ (canonUnit h).hom.app (Opposite.op T₂) =
          (η_sh S₁).app (Opposite.op (B_h.obj T₂)) :=
        NatTrans.congr_app (hCanonUnit_unit h) (Opposite.op T₂)
      have hnat := (η_sh S₁).naturality τ.op
      dsimp [P_const] at hnat
      rw [Category.id_comp] at hnat
      exact (congrArg (· ≫ (weilEtaleTorsionSheaf S₁ ℓ).obj.map τ.op) (hConstUnit hT₁)).trans
        (hnat.symm.trans happ.symm)

    have hIso_bij : ∀ {A₁ A₂ : AddCommGrpCat.{u}} (e : A₁ ≅ A₂), Function.Bijective e.hom.hom := by
      intro A₁ A₂ e
      refine Function.bijective_iff_has_inverse.mpr ⟨e.inv.hom, fun x => ?_, fun y => ?_⟩
      · exact ConcreteCategory.congr_hom e.hom_inv_id x
      · exact ConcreteCategory.congr_hom e.inv_hom_id y

    have hDeg0PullbackAndConj : ∀ {S₁ S₂ : Scheme.{u}} (h : S₁ ⟶ S₂),
        let _ := hCont_pull h
        (∃ ψ₀ : weilEtaleTorsionH S₂ ℓ 0 →+ weilEtaleTorsionH S₁ ℓ 0,
          WeilIsTorsionEtalePullback h ℓ 0 ψ₀ ∧
          (Function.Bijective ψ₀ →
            Function.Bijective (((canonUnit h).hom.app (Opposite.op (T_id S₂))).hom))) := by
      intro S₁ S₂ h
      obtain ⟨ψ₀, hψ₀_is⟩ := hPullEx h ℓ 0
      refine ⟨ψ₀, hψ₀_is, fun hBij_ψ₀ => ?_⟩
      rcases hψ₀_is with ⟨hc_h, hr_h, hAdd_pb, hLim_pb, hColim_pb,
        T₁, hT₁, T₂, hT₂, ιℤ, _hιℤ_πℤ, hπℤ_ιℤ, hψ₀_eq⟩
      have h_hc_eq : hc_h = hCont_pull h := Subsingleton.elim _ _
      subst h_hc_eq
      let _ : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint := hr_h
      let B_h := weilEtaleSitePullback h
      let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      let pb_h := B_h.sheafPullback AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      let _ : pb_h.Additive := hAdd_pb
      let _ : Limits.PreservesFiniteLimits pb_h := hLim_pb
      let _ : Limits.PreservesFiniteColimits pb_h := hColim_pb
      have hT_Bid : Limits.IsTerminal (B_h.obj (T_id S₂)) :=
        Limits.IsTerminal.ofUniqueHom
          (fun Y₀ => MorphismProperty.Over.homMk
            (Limits.pullback.lift (Y₀.hom ≫ h) Y₀.hom (Category.comp_id (Y₀.hom ≫ h)))
            (Limits.pullback.lift_snd _ _ _) trivial)
          (fun Y₀ m => by
            refine MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
            have hm_snd : m.left ≫ Limits.pullback.snd (𝟙 S₂) h = Y₀.hom := MorphismProperty.Over.w m
            apply Limits.pullback.hom_ext
            · calc m.left ≫ Limits.pullback.fst (𝟙 S₂) h
                  = (m.left ≫ Limits.pullback.fst (𝟙 S₂) h) ≫ 𝟙 S₂ := (Category.comp_id _).symm
                _ = m.left ≫ (Limits.pullback.fst (𝟙 S₂) h ≫ 𝟙 S₂) := Category.assoc _ _ _
                _ = m.left ≫ (Limits.pullback.snd (𝟙 S₂) h ≫ h) :=
                    congrArg (m.left ≫ ·) Limits.pullback.condition
                _ = (m.left ≫ Limits.pullback.snd (𝟙 S₂) h) ≫ h := (Category.assoc _ _ _).symm
                _ = Y₀.hom ≫ h := congrArg (· ≫ h) hm_snd
                _ = Limits.pullback.lift (Y₀.hom ≫ h) Y₀.hom _ ≫ Limits.pullback.fst (𝟙 S₂) h :=
                    (Limits.pullback.lift_fst _ _ _).symm
            · exact hm_snd.trans (Limits.pullback.lift_snd _ _ _).symm)
      let e_T₂ : T_id S₂ ≅ T₂ := (hT_id S₂).uniqueUpToIso hT₂
      have hT_B2 : Limits.IsTerminal (B_h.obj T₂) := hT_Bid.ofIso (B_h.mapIso e_T₂)
      let τ : B_h.obj T₂ ⟶ T₁ := hT₁.from (B_h.obj T₂)
      let e_τ : B_h.obj T₂ ≅ T₁ := hT_B2.uniqueUpToIso hT₁
      have hτ_eq : τ = e_τ.hom := hT₁.hom_ext _ _
      have _ : IsIso τ := by rw [hτ_eq]; infer_instance
      let C₁ := constantSheaf S₁.smallEtaleTopology AddCommGrpCat.{u}
      let C₂ := constantSheaf S₂.smallEtaleTopology AddCommGrpCat.{u}
      let adj₁ := constantSheafAdj S₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
      let adj₂ := constantSheafAdj S₂.smallEtaleTopology AddCommGrpCat.{u} hT₂
      let πℤ := weilEtaleConstPullbackHom h hT₁ hT₂ Aℤ
      let πM := weilEtaleConstPullbackHom h hT₁ hT₂ AM
      have hπℤ_ιℤ' : πℤ ≫ ιℤ = 𝟙 (pb_h.obj (C₂.obj Aℤ)) := hπℤ_ιℤ
      have hψ₀_eq' : ∀ x : weilEtaleTorsionH S₂ ℓ 0,
          ψ₀ x = (Abelian.Ext.mk₀ πM).postcomp (C₁.obj Aℤ) (Nat.add_zero 0)
            ((Abelian.Ext.mk₀ ιℤ).comp
              ((pb_h.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) 0) x) (Nat.zero_add 0)) := hψ₀_eq
      let evℤ : ∀ M : AddCommGrpCat.{u}, (Aℤ ⟶ M) ≃ ↥M :=
        fun M =>
          { toFun := fun u => u.hom (ULift.up (1 : ℤ))
            invFun := fun m => AddCommGrpCat.ofHom
              { toFun := fun n => n.down • m
                map_zero' := zero_zsmul m
                map_add' := fun a b => add_zsmul m a.down b.down }
            left_inv := fun u => by
              apply AddCommGrpCat.ext; intro ⟨n⟩
              change n • u.hom (ULift.up (1 : ℤ)) = u.hom (ULift.up n)
              have hlin : ∀ k : ℤ, u.hom (ULift.up k) = k • u.hom (ULift.up (1 : ℤ)) := by
                intro k
                induction k using Int.induction_on with
                | zero =>
                  rw [zero_zsmul]
                  exact map_zero u.hom
                | succ m ih =>
                  have hup : (ULift.up ((m : ℤ) + 1) : Aℤ) = ULift.up (m : ℤ) + ULift.up 1 := rfl
                  rw [hup, map_add, ih, add_zsmul, one_zsmul]
                | pred m ih =>
                  have hup : (ULift.up (-(m : ℤ) - 1) : Aℤ) = ULift.up (-(m : ℤ)) - ULift.up 1 := rfl
                  rw [hup, map_sub, ih, sub_zsmul, one_zsmul]
                  exact sub_eq_add_neg _ _
              exact (hlin n).symm
            right_inv := fun m => one_zsmul m }
      let sec₁ : weilEtaleTorsionH S₁ ℓ 0 ≃ ↥((weilEtaleTorsionSheaf S₁ ℓ).obj.obj (Opposite.op T₁)) :=
        Abelian.Ext.addEquiv₀.toEquiv.trans
          ((adj₁.homEquiv Aℤ (weilEtaleTorsionSheaf S₁ ℓ)).trans (evℤ _))
      let sec₂ : weilEtaleTorsionH S₂ ℓ 0 ≃ ↥((weilEtaleTorsionSheaf S₂ ℓ).obj.obj (Opposite.op T₂)) :=
        Abelian.Ext.addEquiv₀.toEquiv.trans
          ((adj₂.homEquiv Aℤ (weilEtaleTorsionSheaf S₂ ℓ)).trans (evℤ _))
      let τ_equiv : ↥((weilEtaleTorsionSheaf S₁ ℓ).obj.obj (Opposite.op T₁)) ≃
          ↥((weilEtaleTorsionSheaf S₁ ℓ).obj.obj (Opposite.op (B_h.obj T₂))) :=
        { toFun := fun s => ((weilEtaleTorsionSheaf S₁ ℓ).obj.map τ.op).hom s
          invFun := fun s => ((weilEtaleTorsionSheaf S₁ ℓ).obj.map (inv τ).op).hom s
          left_inv := fun s => by
            change (((weilEtaleTorsionSheaf S₁ ℓ).obj.map τ.op ≫
              (weilEtaleTorsionSheaf S₁ ℓ).obj.map (inv τ).op).hom) s = s
            rw [← (weilEtaleTorsionSheaf S₁ ℓ).obj.map_comp, ← op_comp, IsIso.inv_hom_id]
            change ((weilEtaleTorsionSheaf S₁ ℓ).obj.map (𝟙 (Opposite.op T₁))).hom s = s
            rw [(weilEtaleTorsionSheaf S₁ ℓ).obj.map_id]; rfl
          right_inv := fun s => by
            change (((weilEtaleTorsionSheaf S₁ ℓ).obj.map (inv τ).op ≫
              (weilEtaleTorsionSheaf S₁ ℓ).obj.map τ.op).hom) s = s
            rw [← (weilEtaleTorsionSheaf S₁ ℓ).obj.map_comp, ← op_comp, IsIso.hom_inv_id]
            change ((weilEtaleTorsionSheaf S₁ ℓ).obj.map (𝟙 (Opposite.op (B_h.obj T₂)))).hom s = s
            rw [(weilEtaleTorsionSheaf S₁ ℓ).obj.map_id]; rfl }
      have hConj : ∀ x : weilEtaleTorsionH S₂ ℓ 0,
          τ_equiv (sec₁ (ψ₀ x)) = ((canonUnit h).hom.app (Opposite.op T₂)).hom (sec₂ x) := by
        intro x
        let f : C₂.obj Aℤ ⟶ weilEtaleTorsionSheaf S₂ ℓ := Abelian.Ext.addEquiv₀ x
        have hx : x = Abelian.Ext.mk₀ f := (Abelian.Ext.mk₀_addEquiv₀_apply x).symm
        have hψx : ψ₀ x = Abelian.Ext.mk₀ (ιℤ ≫ pb_h.map f ≫ πM) := by
          rw [hψ₀_eq' x, hx]
          have hmap_f : (pb_h.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) 0) (Abelian.Ext.mk₀ f) =
              Abelian.Ext.mk₀ (pb_h.map f) := Abelian.Ext.mapExactFunctor_mk₀ pb_h f
          change (((Abelian.Ext.mk₀ ιℤ).comp
              ((pb_h.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) 0) (Abelian.Ext.mk₀ f))
              (Nat.zero_add 0)).comp (Abelian.Ext.mk₀ πM) (Nat.add_zero 0)) = _
          rw [hmap_f, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, Category.assoc]
        let f₁ : C₁.obj Aℤ ⟶ weilEtaleTorsionSheaf S₁ ℓ := ιℤ ≫ pb_h.map f ≫ πM
        have hπf₁ : πℤ ≫ f₁ = pb_h.map f ≫ πM := by
          dsimp [f₁]; rw [← Category.assoc πℤ ιℤ, hπℤ_ιℤ', Category.id_comp]
        have hLHS_mate : adj₂.homEquiv Aℤ (pf_h.obj (weilEtaleTorsionSheaf S₁ ℓ))
            (adj_h.homEquiv (C₂.obj Aℤ) (weilEtaleTorsionSheaf S₁ ℓ) (πℤ ≫ f₁)) =
            (adj₁.homEquiv Aℤ (weilEtaleTorsionSheaf S₁ ℓ) f₁) ≫
              (weilEtaleTorsionSheaf S₁ ℓ).obj.map τ.op := by
          rw [Adjunction.homEquiv_naturality_right adj_h πℤ f₁]
          dsimp only [πℤ, weilEtaleConstPullbackHom]
          rw [(adj_h.homEquiv _ _).apply_symm_apply,
            Adjunction.homEquiv_naturality_right adj₂ _ (pf_h.map f₁),
            (adj₂.homEquiv _ _).apply_symm_apply,
            Adjunction.homEquiv_unit adj₁]
          change (adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ.op) ≫
              f₁.hom.app (Opposite.op (B_h.obj T₂)) =
            (adj₁.unit.app Aℤ ≫ f₁.hom.app (Opposite.op T₁)) ≫
              (weilEtaleTorsionSheaf S₁ ℓ).obj.map τ.op
          rw [Category.assoc, Category.assoc, ← f₁.hom.naturality τ.op]
        have hhom_eq : (adj₁.homEquiv Aℤ (weilEtaleTorsionSheaf S₁ ℓ) f₁) ≫
            (weilEtaleTorsionSheaf S₁ ℓ).obj.map τ.op =
            (adj₂.homEquiv Aℤ (weilEtaleTorsionSheaf S₂ ℓ) f) ≫
              (canonUnit h).hom.app (Opposite.op T₂) := by
          rw [← hLHS_mate, hπf₁, Adjunction.homEquiv_naturality_left adj_h f πM,
            hCanonUnit_eq_mate h hT₁ hT₂, Adjunction.homEquiv_naturality_right adj₂ f (canonUnit h)]
          rfl
        rw [hψx]
        dsimp [sec₁, sec₂, τ_equiv, evℤ]
        rw [← Abelian.Ext.addEquiv₀_symm_apply f₁, AddEquiv.apply_symm_apply]
        have heval := ConcreteCategory.congr_hom hhom_eq (ULift.up (1 : ℤ))
        have hfx : Abelian.Ext.addEquiv₀ x = f := rfl
        rw [hfx]
        exact heval
      have hBij_T₂ : Function.Bijective (((canonUnit h).hom.app (Opposite.op T₂)).hom) := by
        have hcomp_eq : (((canonUnit h).hom.app (Opposite.op T₂)).hom : _ → _) =
            (τ_equiv ∘ sec₁ ∘ ψ₀ ∘ sec₂.symm) := by
          funext s
          have hc := hConj (sec₂.symm s)
          rw [sec₂.apply_symm_apply] at hc
          exact hc.symm
        change Function.Bijective (((canonUnit h).hom.app (Opposite.op T₂)).hom : _ → _)
        rw [hcomp_eq]
        exact τ_equiv.bijective.comp (sec₁.bijective.comp (hBij_ψ₀.comp sec₂.symm.bijective))
      let iso_F_T₂ : (weilEtaleTorsionSheaf S₂ ℓ).obj.obj (Opposite.op (T_id S₂)) ≅
          (weilEtaleTorsionSheaf S₂ ℓ).obj.obj (Opposite.op T₂) :=
        (weilEtaleTorsionSheaf S₂ ℓ).obj.mapIso e_T₂.symm.op
      let iso_P_T₂ : (pf_h.obj (weilEtaleTorsionSheaf S₁ ℓ)).obj.obj (Opposite.op (T_id S₂)) ≅
          (pf_h.obj (weilEtaleTorsionSheaf S₁ ℓ)).obj.obj (Opposite.op T₂) :=
        (pf_h.obj (weilEtaleTorsionSheaf S₁ ℓ)).obj.mapIso e_T₂.symm.op
      have hnat_T₂ : (canonUnit h).hom.app (Opposite.op (T_id S₂)) ≫ iso_P_T₂.hom =
          iso_F_T₂.hom ≫ (canonUnit h).hom.app (Opposite.op T₂) :=
        ((canonUnit h).hom.naturality e_T₂.inv.op).symm
      have h_eq_Tid : (((canonUnit h).hom.app (Opposite.op (T_id S₂))).hom : _ → _) =
          iso_P_T₂.inv.hom ∘ ((canonUnit h).hom.app (Opposite.op T₂)).hom ∘ iso_F_T₂.hom.hom := by
        funext s
        have hm : (canonUnit h).hom.app (Opposite.op (T_id S₂)) =
            iso_F_T₂.hom ≫ (canonUnit h).hom.app (Opposite.op T₂) ≫ iso_P_T₂.inv := by
          rw [← Category.assoc, ← hnat_T₂, Category.assoc, iso_P_T₂.hom_inv_id, Category.comp_id]
        exact ConcreteCategory.congr_hom hm s
      change Function.Bijective (((canonUnit h).hom.app (Opposite.op (T_id S₂))).hom : _ → _)
      rw [h_eq_Tid]
      exact (hIso_bij iso_P_T₂.symm).comp (hBij_T₂.comp (hIso_bij iso_F_T₂))

    have hSliceConstIso : ∀ {S' S : Scheme.{u}} {v : S' ⟶ S} (hv : Etale v),
        let M_v : Functor S'.Etale S.Etale := MorphismProperty.Over.map (P := P_et) ⊤ hv
        let shPull_v : Functor (Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
            (Sheaf S'.smallEtaleTopology AddCommGrpCat.{u}) :=
          @Functor.sheafPushforwardContinuous _ _ _ _ M_v AddCommGrpCat.{u} _
            S'.smallEtaleTopology S.smallEtaleTopology (hCont_map hv)
        ∃ (δ_v : weilEtaleTorsionSheaf S' ℓ ≅ shPull_v.obj (weilEtaleTorsionSheaf S ℓ)),
          η_sh S' ≫ δ_v.hom.hom = Functor.whiskerLeft M_v.op (η_sh S) := by
      intro S' S v hv M_v shPull_v
      let B_v := weilEtaleSitePullback v
      let pf_v : Functor (Sheaf S'.smallEtaleTopology AddCommGrpCat.{u})
          (Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
        @Functor.sheafPushforwardContinuous _ _ _ _ B_v AddCommGrpCat.{u} _
          S.smallEtaleTopology S'.smallEtaleTopology (hCont_pull v)
      let W_Mv := (Functor.whiskeringLeft (Opposite S'.Etale) (Opposite S.Etale)
        AddCommGrpCat.{u}).obj M_v.op
      let W_Bv := (Functor.whiskeringLeft (Opposite S.Etale) (Opposite S'.Etale)
        AddCommGrpCat.{u}).obj B_v.op
      let adj_site : M_v ⊣ B_v := MorphismProperty.Over.mapPullbackAdj P_et ⊤ v hv trivial
      let adj_W : W_Mv ⊣ W_Bv :=
        Adjunction.mkOfUnitCounit
          { unit :=
              { app := fun P =>
                  { app := fun W => P.map (adj_site.counit.app W.unop).op
                    naturality := fun {W₁ W₂} u => by
                      change P.map u.unop.op ≫ P.map (adj_site.counit.app W₂.unop).op =
                        P.map (adj_site.counit.app W₁.unop).op ≫ P.map (M_v.map (B_v.map u.unop)).op
                      rw [← P.map_comp, ← P.map_comp, ← op_comp, ← op_comp]
                      exact congrArg (fun k => P.map k.op) (adj_site.counit.naturality u.unop).symm }
                naturality := fun {_ _} φ => by ext W : 2; exact (φ.naturality _).symm }
            counit :=
              { app := fun Q =>
                  { app := fun U₀ => Q.map (adj_site.unit.app U₀.unop).op
                    naturality := fun {U₁ U₂} u => by
                      change Q.map (B_v.map (M_v.map u.unop)).op ≫ Q.map (adj_site.unit.app U₂.unop).op =
                        Q.map (adj_site.unit.app U₁.unop).op ≫ Q.map u.unop.op
                      rw [← Q.map_comp, ← Q.map_comp, ← op_comp, ← op_comp]
                      exact congrArg (fun k => Q.map k.op) (adj_site.unit.naturality u.unop).symm }
                naturality := fun {_ _} ψ => by ext U₀ : 2; exact (ψ.naturality _).symm }
            left_triangle := by
              ext P : 2; ext U₀ : 2
              change P.map (adj_site.counit.app (M_v.obj U₀.unop)).op ≫
                P.map (M_v.map (adj_site.unit.app U₀.unop)).op = 𝟙 _
              rw [← P.map_comp, ← op_comp, adj_site.left_triangle_components U₀.unop]
              exact P.map_id _
            right_triangle := by
              ext Q : 2; ext W : 2
              change Q.map (B_v.map (adj_site.counit.app W.unop)).op ≫
                Q.map (adj_site.unit.app (B_v.obj W.unop)).op = 𝟙 _
              rw [← Q.map_comp, ← op_comp, adj_site.right_triangle_components W.unop]
              exact Q.map_id _ }
      let adj_sh : shPull_v ⊣ pf_v :=
        Adjunction.mkOfUnitCounit
          { unit :=
              { app := fun ℱ => ObjectProperty.homMk (adj_W.unit.app ℱ.obj)
                naturality := fun {_ _} φ => Sheaf.hom_ext (adj_W.unit.naturality φ.hom) }
            counit :=
              { app := fun 𝒢 => ObjectProperty.homMk (adj_W.counit.app 𝒢.obj)
                naturality := fun {_ _} ψ => Sheaf.hom_ext (adj_W.counit.naturality ψ.hom) }
            left_triangle := by
              ext ℱ : 2; apply Sheaf.hom_ext; exact NatTrans.congr_app adj_W.left_triangle ℱ.obj
            right_triangle := by
              ext 𝒢 : 2; apply Sheaf.hom_ext; exact NatTrans.congr_app adj_W.right_triangle 𝒢.obj }
      let _ : B_v.IsContinuous S.smallEtaleTopology S'.smallEtaleTopology := hCont_pull v
      let δ_hom : weilEtaleTorsionSheaf S' ℓ ⟶ shPull_v.obj (weilEtaleTorsionSheaf S ℓ) :=
        ((sheafificationAdjunction S'.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
          (P_const S') (shPull_v.obj (weilEtaleTorsionSheaf S ℓ))).symm
          (Functor.whiskerLeft M_v.op (η_sh S))
      have hδ_hom : η_sh S' ≫ δ_hom.hom = Functor.whiskerLeft M_v.op (η_sh S) :=
        ((sheafificationAdjunction S'.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
          (P_const S') (shPull_v.obj (weilEtaleTorsionSheaf S ℓ))).apply_symm_apply _
      let δ_inv : shPull_v.obj (weilEtaleTorsionSheaf S ℓ) ⟶ weilEtaleTorsionSheaf S' ℓ :=
        (adj_sh.homEquiv (weilEtaleTorsionSheaf S ℓ) (weilEtaleTorsionSheaf S' ℓ)).symm (canonUnit v)
      have h_hom_inv : δ_hom ≫ δ_inv = 𝟙 (weilEtaleTorsionSheaf S' ℓ) := by
        refine ((sheafificationAdjunction S'.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
          (P_const S') (weilEtaleTorsionSheaf S' ℓ)).injective
          (Eq.trans (Adjunction.homEquiv_unit _ _ _ _)
            (Eq.trans ?_ (Adjunction.homEquiv_unit _ _ _ _).symm))
        ext E_op : 2
        obtain ⟨E'⟩ := E_op
        have h1 : (η_sh S').app (Opposite.op E') ≫ δ_hom.hom.app (Opposite.op E') =
            (η_sh S).app (Opposite.op (M_v.obj E')) :=
