        · obtain ⟨m₀, hm₀⟩ : ∃ m₀ : ℕ, k₀ = m₀ + 1 := ⟨k₀ - 1, (Nat.sub_add_cancel hk₀).symm⟩
          rw [hm₀] at hH_zero ⊢
          obtain ⟨e_m⟩ := hShift m₀
          exact hSubIso e_m 0 hH_zero
      have hSub_R1 : Subsingleton ((weilEtaleHigherDirectImage f 1 ℱ).H k₀) := by
        rcases Nat.eq_zero_or_pos k₀ with hk0 | hkpos
        · rw [hk0] at hH_zero ⊢
          exact hH_zero
        · obtain ⟨p₀, hp₀⟩ : ∃ p₀ : ℕ, k₀ = p₀ + 1 := ⟨k₀ - 1, (Nat.sub_add_cancel hkpos).symm⟩
          rw [hp₀]
          exact hH_pos 0 p₀
      rw [injective_iff_map_eq_zero]
      intro z hz
      have hzf : z.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map j))
          (Nat.add_zero (k₀ + 2)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨b₀, hb₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_Y hSE₁ z hzf
          (rfl : (k₀ + 1) + 1 = k₀ + 2)
      have hb₀_ext : (Λ (k₀ + 1) 𝒬
          (b₀.comp (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero (k₀ + 1)))).comp
          hSE_F.extClass (rfl : (k₀ + 1) + 1 = k₀ + 2) = 0 := by
        rw [← hIntertwine (k₀ + 1) b₀, hb₀, hz]
      obtain ⟨u₀, hu₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ (P_pull.obj Fℤ_Y) hSE_F
          (Λ (k₀ + 1) 𝒬 (b₀.comp (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero (k₀ + 1))))
          (rfl : (k₀ + 1) + 1 = k₀ + 2) hb₀_ext
      have hu₀_zero : u₀ = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective u₀
      have hΛQ_zero : Λ (k₀ + 1) 𝒬
          (b₀.comp (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero (k₀ + 1))) = 0 := by
        rw [← hu₀, hu₀_zero, CategoryTheory.Abelian.Ext.zero_comp]
      have hb₀_ι_zero :
          b₀.comp (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero (k₀ + 1)) = 0 :=
        hInj_Q (hΛQ_zero.trans (map_zero (Λ (k₀ + 1) 𝒬)).symm)
      obtain ⟨w₀, hw₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_Y hSE₂ b₀ hb₀_ι_zero
          (rfl : k₀ + 1 = k₀ + 1)
      have hw₀_zero : w₀ = 0 := @Subsingleton.elim _ hSub_R1 w₀ 0
      have hb₀_zero : b₀ = 0 := by
        rw [← hw₀, hw₀_zero, CategoryTheory.Abelian.Ext.zero_comp]
      rw [← hb₀, hb₀_zero, CategoryTheory.Abelian.Ext.zero_comp]
  
  let pre_ι : CategoryTheory.Abelian.Ext.{u} (P_pull.obj Fℤ_Y) ℱ₀ (q₀ + 1) →
