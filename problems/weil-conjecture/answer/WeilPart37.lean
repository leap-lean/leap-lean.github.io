    exact CategoryTheory.IsPullback.of_vert_isIso
      ⟨by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]⟩
  have hSm_Zts : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_tilde_s.hom := by
    let φ_F : Z_tilde_s ⟶ weilSpecFieldOver F :=
      CategoryTheory.Over.homMk Z_tilde_s.hom (CategoryTheory.Category.comp_id _)
    let φ_k : Zts_bar ⟶ weilSpecFieldOver (AlgebraicClosure F) :=
      CategoryTheory.Over.homMk Zts_bar.hom (CategoryTheory.Category.comp_id _)
    exact (hFpqc.2.1 Z_tilde_s (weilSpecFieldOver F) Zts_bar
      (weilSpecFieldOver (AlgebraicClosure F)) fst_Zts_bar g_k φ_F φ_k
      hpb_Zts_bar hMod_base CategoryTheory.Limits.pullback.condition).2.2.2.2.2.1
      (2 * m + 1) hSm_Zts_bar

  
  have : Algebra.IsAlgebraic F F₂ := Algebra.IsAlgebraic.of_finite F F₂
  let ι_F₂ : F₂ →ₐ[F] AlgebraicClosure F := IsAlgClosed.lift
  letI : Algebra F₂ (AlgebraicClosure F) := ι_F₂.toRingHom.toAlgebra
  have : IsScalarTower F F₂ (AlgebraicClosure F) :=
    IsScalarTower.of_algebraMap_eq' ι_F₂.comp_algebraMap.symm
  let g_FF₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F₂))
  let g_F₂k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F₂ (AlgebraicClosure F)))
  have hg_comp : g_F₂k ≫ g_FF₂ = g_k := by
    dsimp [g_F₂k, g_FF₂, g_k]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
