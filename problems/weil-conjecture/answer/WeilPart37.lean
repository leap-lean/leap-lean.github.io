      dsimp [lift_ev, IsLocalization.Away.lift]
      rw [IsLocalization.lift_mk'_spec]
      change ev b a = ev b (MvPolynomial.X b ^ n) * ev b a
      rw [map_pow, hev_Xb b, one_pow, one_mul]

