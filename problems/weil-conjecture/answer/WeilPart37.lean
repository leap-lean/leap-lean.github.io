    let s_inv : U_bar.toScheme ⟶ (π_bar ⁻¹ᵁ U_bar).toScheme :=
      hpb_Ubar.lift (u_W ≫ inv (π_s.left ∣_ U_s)) (𝟙 _) (by simp)
    refine ⟨⟨s_inv, ?_, hpb_Ubar.lift_snd _ _ _⟩⟩
    apply hpb_Ubar.hom_ext
    · rw [CategoryTheory.Category.assoc, hpb_Ubar.lift_fst, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc, ← hpb_Ubar.w, CategoryTheory.Category.assoc,
        CategoryTheory.IsIso.hom_inv_id, CategoryTheory.Category.comp_id]
    · rw [CategoryTheory.Category.assoc, hpb_Ubar.lift_snd, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]
  have : CategoryTheory.IsIso (π_bar ∣_ U_bar) := hIso_Ubar
  have : AlgebraicGeometry.IsIntegral U_bar.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion U_bar.ι
  have : IrreducibleSpace ↥U_bar.toScheme :=
    (AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced U_bar.toScheme).mp
      inferInstance |>.1
  let inv_res : U_bar.toScheme ⟶ Uts_bar.toScheme := inv (π_bar ∣_ U_bar)
  have hUts_irred : IsIrreducible (Uts_bar : Set ↥Zts_bar.left) := by
    have himg : (inv_res ≫ Uts_bar.ι).base '' (Set.univ : Set ↥U_bar.toScheme) =
        (Uts_bar : Set ↥Zts_bar.left) := by
      ext z
      simp only [Set.mem_image, Set.mem_univ, true_and]
      constructor
      · rintro ⟨u, rfl⟩
        exact (inv_res.base u).2
      · intro hz
        refine ⟨(π_bar ∣_ U_bar).base ⟨z, hz⟩, ?_⟩
        change (((π_bar ∣_ U_bar) ≫ inv_res) ≫ Uts_bar.ι).base ⟨z, hz⟩ = z
        rw [CategoryTheory.IsIso.hom_inv_id]; rfl
    rw [← himg]
    exact IsIrreducible.image (IrreducibleSpace.isIrreducible_univ ↥U_bar.toScheme)
      _ (inv_res ≫ Uts_bar.ι).continuous.continuousOn
  have hClosure_univ : closure (Uts_bar : Set ↥Zts_bar.left) = Set.univ := by
    ext z_bar
    simp only [Set.mem_univ, iff_true]
    by_cases hz : z_bar ∈ Uts_bar
    · exact subset_closure hz
    · obtain ⟨R'_k, hRingR', v₀, e_Y, ψ_et, i₀, _, hEt_ψ, hv₀, _, hi₀⟩ := hExcRoof z_bar hz
      letI : CommRing R'_k := hRingR'
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_et)) := hEt_ψ
      rw [mem_closure_iff]
      intro O hO hzO
      let O_R : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R'_k)) := e_Y.base ⁻¹' O
      have hOR_open : IsOpen O_R := hO.preimage e_Y.continuous
      have hv₀_OR : v₀ ∈ O_R := by
        change e_Y.base v₀ ∈ O; rwa [hv₀]
      let f_ψ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_et)
      have hOpen_G : IsOpen (f_ψ.base '' O_R) := f_ψ.isOpenMap O_R hOR_open
      have hNe_G : (f_ψ.base '' O_R).Nonempty := ⟨f_ψ.base v₀, v₀, hv₀_OR, rfl⟩
      let D_X : (AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin (2 * m + 1)) (AlgebraicClosure F)))).Opens :=
        PrimeSpectrum.basicOpen (MvPolynomial.X i₀)
      have hX_ne : (MvPolynomial.X i₀ : MvPolynomial (Fin (2 * m + 1)) (AlgebraicClosure F)) ≠ 0 :=
        MvPolynomial.X_ne_zero i₀
      have hNe_DX : (D_X : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin (2 * m + 1)) (AlgebraicClosure F))))).Nonempty := by
        refine ⟨⟨⊥, inferInstance⟩, ?_⟩
        change MvPolynomial.X i₀ ∉
          (⊥ : Ideal (MvPolynomial (Fin (2 * m + 1)) (AlgebraicClosure F)))
        simp [hX_ne]
      obtain ⟨_, -, ⟨v, hv_OR, rfl⟩, hp_DX⟩ :=
        PreirreducibleSpace.isPreirreducible_univ (f_ψ.base '' O_R) D_X hOpen_G D_X.2
          (by simpa using hNe_G) (by simpa using hNe_DX)
      exact ⟨e_Y.base v, hv_OR, hi₀ v hp_DX⟩
  have hUniv_irred : IsIrreducible (Set.univ : Set ↥Zts_bar.left) := by
    rw [← hClosure_univ]
    exact hUts_irred.closure
  have : IrreducibleSpace ↥Zts_bar.left :=
    (irreducibleSpace_def ↥Zts_bar.left).mpr hUniv_irred
  have hInt_Zts_bar : AlgebraicGeometry.IsIntegral Zts_bar.left :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Zts_bar.left

  have hGeom_Zts : AlgebraicGeometry.GeometricallyIrreducible Z_tilde_s.hom :=
    weil_geometricallyIrreducible_of_algClosure_pullback
      F (AlgebraicClosure F) Z_tilde_s Zts_bar hInt_Zts_bar fst_Zts_bar hpb_Zts_bar
  have hFpqc := weil_fpqc_field_descent_morphism_and_fiber_props F (AlgebraicClosure F)
  have hMod_base : IsFieldPullbackModel F (AlgebraicClosure F)
