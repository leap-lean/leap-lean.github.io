              (TensorProduct F E ↑(Z_s.left.presheaf.obj (Opposite.op U.1)))) ⟶ Z_sE.left :=
            hPb_ZsE.lift
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR) ≫ U.2.fromSpec)
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom incL))
              (by rw [CategoryTheory.Category.assoc, ← halg_A₀]; exact hPb_Spec.w.symm)
          have hj_UE_fst : j_UE ≫ fst_ZsE =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR) ≫ U.2.fromSpec :=
            hPb_ZsE.lift_fst _ _ _
          have hj_UE_snd : j_UE ≫ Z_sE.hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom incL) :=
            hPb_ZsE.lift_snd _ _ _
          have hPb_UE : CategoryTheory.IsPullback
              j_UE (AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR))
              fst_ZsE U.2.fromSpec := by
            refine CategoryTheory.IsPullback.of_right ?_ hj_UE_fst hPb_ZsE.flip
            rw [hj_UE_snd, ← halg_A₀]
            exact hPb_Spec
          have : AlgebraicGeometry.IsOpenImmersion j_UE :=
            CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
              hPb_UE.flip inferInstance
          let m₀ : AlgebraicGeometry.Spec (Z_s.left.presheaf.obj (Opposite.op U.1)) :=
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε₀)).base pt₀
          have hm₀_eq : m₀ = PrimeSpectrum.comap φ₁ q₀ := by
            apply PrimeSpectrum.ext
            change Ideal.comap ε₀ pt₀.asIdeal = (PrimeSpectrum.comap φ₁ q₀).asIdeal
            rw [hPrimeBot pt₀, ← RingHom.ker_eq_comap_bot, hq₀_comap]
          have hm₀_img : fst_ZsE.base z_E = U.2.fromSpec.base m₀ := by
            change z₀ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε₀) ≫ U.2.fromSpec).base pt₀
            rw [hε₀_Spec]
            exact hpt.symm
          obtain ⟨p_E, hp_E_j, hp_E_incR⟩ :=
            AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_UE z_E m₀ hm₀_img
          let p_E' : PrimeSpectrum
              (TensorProduct F E ↑(Z_s.left.presheaf.obj (Opposite.op U.1))) := p_E
          have hp_E_comap : PrimeSpectrum.comap incR p_E' = PrimeSpectrum.comap φ₁ q₀ := by
            rw [← hm₀_eq]
            exact hp_E_incR
          have : _root_.IsReduced (Localization.AtPrime p_E'.asIdeal) :=
            h_s4 F m ↑(Z_s.left.presheaf.obj (Opposite.op U.1)) E₁
              (Localization.Away t_B) q₀ φ₁ hφ₁_et φ₂ hφ₂_et hφ_alg E p_E' hp_E_comap
          have hIso_stalk : CategoryTheory.IsIso (j_UE.stalkMap p_E) :=
            AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap j_UE p_E
          have hInj_stalk : Function.Injective (j_UE.stalkMap p_E).hom :=
            (ConcreteCategory.bijective_of_isIso (j_UE.stalkMap p_E)).1
          let toAtPrime :=
            (AlgebraicGeometry.StructureSheaf.stalkIso
              (TensorProduct F E ↑(Z_s.left.presheaf.obj (Opposite.op U.1))) p_E').symm.toRingEquiv.toRingHom
          have hInj_comp : Function.Injective (toAtPrime.comp (j_UE.stalkMap p_E).hom) :=
            (AlgebraicGeometry.StructureSheaf.stalkIso _ p_E').symm.injective.comp hInj_stalk
          have hRed_img : _root_.IsReduced ↑(Z_sE.left.presheaf.stalk (j_UE.base p_E)) :=
            isReduced_of_injective _ hInj_comp
          rwa [hp_E_j] at hRed_img
        · let z_tilde : ↥Z_tilde.left := (CategoryTheory.Limits.pullback.fst f₀.left s).base z₀
          have hz_in : f₀.left.base z_tilde ∈ Set.range s.base := by
            have hc : (CategoryTheory.Limits.pullback.fst f₀.left s ≫ f₀.left).base z₀ =
                (Z_s.hom ≫ s).base z₀ := by
              exact congrArg (fun φ => φ.base z₀) hPb_Zs.w
            exact ⟨Z_s.hom.base z₀, hc.symm⟩
          have hz_not : z_tilde ∉ Set.range x_s.base := by
            rintro ⟨pt, hpt⟩
            apply hz₀
            refine ⟨pt, ?_⟩
            apply (CategoryTheory.Limits.pullback.fst f₀.left s).isClosedEmbedding.injective
            change (x_s0 ≫ CategoryTheory.Limits.pullback.fst f₀.left s).base pt = z_tilde
            rwa [hx_s0_fst]
          obtain ⟨V, hzV, hSmV⟩ := hSm_away z_tilde hz_in hz_not
          let f_E_tilde : Z_sE.left ⟶ Z_tilde.left :=
            fst_ZsE ≫ CategoryTheory.Limits.pullback.fst f₀.left s
          let V_E : Z_sE.left.Opens := (TopologicalSpace.Opens.map f_E_tilde.base).obj V
          have hz_VE : z_E ∈ V_E := hzV
          have hPb_VE : CategoryTheory.IsPullback
              (f_E_tilde ∣_ V) (V_E.ι ≫ Z_sE.hom) (V.ι ≫ f₀.left) (g_E ≫ s) :=
            (AlgebraicGeometry.isPullback_morphismRestrict f_E_tilde V).paste_vert
              (hPb_ZsE.paste_horiz hPb_Zs)
          have : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V_E.ι ≫ Z_sE.hom) :=
            CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_VE hSmV
          have : _root_.IsReduced ↑(V_E.toScheme.presheaf.stalk ⟨z_E, hz_VE⟩) :=
            hRedStalkOfSm E (2 * m + 1) V_E.toScheme (V_E.ι ≫ Z_sE.hom) ⟨z_E, hz_VE⟩
          have : CategoryTheory.IsIso (V_E.ι.stalkMap ⟨z_E, hz_VE⟩) :=
            AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap V_E.ι ⟨z_E, hz_VE⟩
          have hInj_VE : Function.Injective (V_E.ι.stalkMap ⟨z_E, hz_VE⟩).hom :=
            (ConcreteCategory.bijective_of_isIso (V_E.ι.stalkMap ⟨z_E, hz_VE⟩)).1
          exact isReduced_of_injective _ hInj_VE
      exact AlgebraicGeometry.isReduced_of_isReduced_stalk Z_sE.left
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Z_sE.left
  have hInt_Zs : AlgebraicGeometry.IsIntegral Z_s.left := by
    have : AlgebraicGeometry.IsIntegral (weilBaseChangeOver F F Z_s).left := hInt_all F
    let g_F := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F))
    have hg_F_id : g_F = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)) := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id F)) = _
      rw [CommRingCat.ofHom_id]
      exact AlgebraicGeometry.Spec.map_id (CommRingCat.of F)
    let fst_F : CategoryTheory.Limits.pullback Z_s.hom g_F ⟶ Z_s.left :=
      CategoryTheory.Limits.pullback.fst Z_s.hom g_F
    let sec_F : Z_s.left ⟶ CategoryTheory.Limits.pullback Z_s.hom g_F :=
      CategoryTheory.Limits.pullback.lift (𝟙 Z_s.left) Z_s.hom
        (by rw [CategoryTheory.Category.id_comp, hg_F_id, CategoryTheory.Category.comp_id])
    have hIso_sec : CategoryTheory.IsIso sec_F := by
      refine ⟨⟨fst_F, CategoryTheory.Limits.pullback.lift_fst _ _ _, ?_⟩⟩
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.id_comp]
        calc
          fst_F ≫ Z_s.hom = CategoryTheory.Limits.pullback.snd Z_s.hom g_F ≫ g_F :=
            CategoryTheory.Limits.pullback.condition
          _ = CategoryTheory.Limits.pullback.snd Z_s.hom g_F ≫ 𝟙 _ :=
            congrArg (CategoryTheory.Limits.pullback.snd Z_s.hom g_F ≫ ·) hg_F_id
          _ = CategoryTheory.Limits.pullback.snd Z_s.hom g_F :=
            CategoryTheory.Category.comp_id _
    let sec_F' : Z_s.left ⟶ (weilBaseChangeOver F F Z_s).left := sec_F
    have : CategoryTheory.IsIso sec_F' := hIso_sec
    have : Nonempty ↥Z_s.left := ⟨p₀⟩
    exact AlgebraicGeometry.isIntegral_of_isOpenImmersion sec_F'
  exact ⟨hInt_Zs, hInt_all, U, alg_A₀, ε₀, E₁, hField₁, hAlg₁, hFinDim₁,
    Localization.Away t_B, inferInstance, q₀, φ₁, φ₂, halg_A₀, hFT_A₀, hε₀_Spec, hε₀_id,
    hφ₁_et, hφ₂_et, hφ_alg, hq₀_comap, hq₀_X, hSpan_eq⟩

theorem weil_mvPolynomial_deg2_polar_congruence_and_hyperbolic_det (F E : Type u) [Field F] [Field E]
    (φ : F →+* E) (m : ℕ) :
    let F_std : MvPolynomial (Fin (2 * m + 1 + 1)) E :=
      ∑ j : Fin (m + 1),
        (MvPolynomial.X ⟨2 * j.1, by omega⟩ : MvPolynomial (Fin (2 * m + 1 + 1)) E) *
          MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩
    Matrix.det (Matrix.of fun i j : Fin (2 * m + 1 + 1) =>
      MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i F_std))) ≠ 0 ∧
    (∀ Q : MvPolynomial (Fin (2 * m + 1 + 1)) F,
      Matrix.of (fun i j : Fin (2 * m + 1 + 1) =>
        MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i (MvPolynomial.map φ Q)))) =
      (Matrix.of fun i j : Fin (2 * m + 1 + 1) =>
        MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q))).map φ) ∧
    (∀ (c : E) (Q : MvPolynomial (Fin (2 * m + 1 + 1)) E),
      Matrix.of (fun i j : Fin (2 * m + 1 + 1) =>
        MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i (MvPolynomial.C c * Q)))) =
      c • Matrix.of (fun i j : Fin (2 * m + 1 + 1) =>
        MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q)))) ∧
    (∀ (Q : MvPolynomial (Fin (2 * m + 1 + 1)) E),
      Q ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) E 2 →
      ∀ (L : Matrix (Fin (2 * m + 1 + 1)) (Fin (2 * m + 1 + 1)) E),
        let Q_L : MvPolynomial (Fin (2 * m + 1 + 1)) E :=
          MvPolynomial.eval₂ MvPolynomial.C
            (fun a => ∑ b : Fin (2 * m + 1 + 1), MvPolynomial.C (L a b) * MvPolynomial.X b) Q
        Matrix.of (fun i j : Fin (2 * m + 1 + 1) =>
          MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q_L))) =
        L.transpose * (Matrix.of fun i j : Fin (2 * m + 1 + 1) =>
          MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q))) * L) :=
by
  let N := 2 * m + 1 + 1
  have hpderiv_X : ∀ a b : Fin N,
      MvPolynomial.pderiv a (MvPolynomial.X b : MvPolynomial (Fin N) E) =
        if b = a then 1 else 0 := by
    intro a b
    rw [MvPolynomial.pderiv_X, Pi.single_apply]
  refine ⟨?_, ?_, ?_, ?_⟩
  · let F_std : MvPolynomial (Fin N) E :=
      ∑ j : Fin (m + 1),
        (MvPolynomial.X ⟨2 * j.1, by omega⟩ : MvPolynomial (Fin N) E) *
          MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩
    let H_std : Matrix (Fin N) (Fin N) E :=
      Matrix.of fun i j : Fin N =>
        MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i F_std))
    change Matrix.det H_std ≠ 0
    let τ : Fin N → Fin N := fun i => ⟨2 * (i.1 / 2) + (1 - i.1 % 2), by omega⟩
    have hτ_invol : ∀ i : Fin N, τ (τ i) = i := by
      intro i
      ext
      dsimp [τ]
      omega
    have h_pair : ∀ u v i k : Fin N,
        MvPolynomial.constantCoeff
          (MvPolynomial.pderiv k
            (MvPolynomial.pderiv i
              ((MvPolynomial.X u : MvPolynomial (Fin N) E) * MvPolynomial.X v))) =
          (if u = i then (if v = k then (1 : E) else 0) else 0) +
            (if v = i then (if u = k then (1 : E) else 0) else 0) := by
      intro u v i k
      have h1 : MvPolynomial.pderiv i
          ((MvPolynomial.X u : MvPolynomial (Fin N) E) * MvPolynomial.X v) =
          (if u = i then MvPolynomial.X v else 0) + (if v = i then MvPolynomial.X u else 0) := by
        rw [MvPolynomial.pderiv_mul, hpderiv_X, hpderiv_X]
        simp only [ite_mul, one_mul, zero_mul, mul_ite, mul_one, mul_zero]
      rw [h1]
      simp only [map_add, apply_ite (MvPolynomial.pderiv k), map_zero, hpderiv_X,
        apply_ite MvPolynomial.constantCoeff, map_one]
    have hH_std_entry : ∀ i k : Fin N, H_std i k = if k = τ i then (1 : E) else 0 := by
      intro i k
      dsimp [H_std, F_std]
      simp only [map_sum, h_pair]
      let j₀ : Fin (m + 1) := ⟨i.1 / 2, by omega⟩
      rw [Finset.sum_eq_single j₀]
      · by_cases hpar : i.1 % 2 = 0
        · have heven_eq : (⟨2 * j₀.1, by omega⟩ : Fin N) = i := by ext; dsimp [j₀]; omega
          have hodd_ne : (⟨2 * j₀.1 + 1, by omega⟩ : Fin N) ≠ i := by
            rw [Ne, Fin.ext_iff]; dsimp [j₀]; omega
          have hodd_τ : (⟨2 * j₀.1 + 1, by omega⟩ : Fin N) = τ i := by
            ext; dsimp [j₀, τ]; omega
          simp only [heven_eq, hodd_ne, ↓reduceIte, add_zero]
          rw [hodd_τ]
          by_cases hk : k = τ i
          · subst hk; simp
          · simp [hk, Ne.symm hk]
        · have heven_ne : (⟨2 * j₀.1, by omega⟩ : Fin N) ≠ i := by
            rw [Ne, Fin.ext_iff]; dsimp [j₀]; omega
          have hodd_eq : (⟨2 * j₀.1 + 1, by omega⟩ : Fin N) = i := by ext; dsimp [j₀]; omega
          have heven_τ : (⟨2 * j₀.1, by omega⟩ : Fin N) = τ i := by
            ext; dsimp [j₀, τ]; omega
          simp only [heven_ne, hodd_eq, ↓reduceIte, zero_add]
          rw [heven_τ]
          by_cases hk : k = τ i
          · subst hk; simp
          · simp [hk, Ne.symm hk]
      · intro j _ hj
        have heven_ne : (⟨2 * j.1, by omega⟩ : Fin N) ≠ i := by
          rw [Ne, Fin.ext_iff] at hj ⊢; dsimp [j₀] at hj ⊢; omega
        have hodd_ne : (⟨2 * j.1 + 1, by omega⟩ : Fin N) ≠ i := by
          rw [Ne, Fin.ext_iff] at hj ⊢; dsimp [j₀] at hj ⊢; omega
        simp only [heven_ne, hodd_ne, ↓reduceIte, add_zero]
      · intro h_abs
        exact (h_abs (Finset.mem_univ j₀)).elim
    have hH_std_sq : H_std * H_std = 1 := by
      ext i ℓ
      rw [Matrix.mul_apply, Matrix.one_apply]
      simp only [hH_std_entry]
      rw [Finset.sum_eq_single (τ i)]
      · simp only [↓reduceIte, one_mul, hτ_invol]
        by_cases hℓ : i = ℓ
        · subst hℓ; simp
        · simp [hℓ, Ne.symm hℓ]
      · intro k _ hk
        simp only [hk, ↓reduceIte, zero_mul]
      · intro h_abs
        exact (h_abs (Finset.mem_univ _)).elim
    intro hdet0
    have h1 : Matrix.det H_std * Matrix.det H_std = 1 := by
      rw [← Matrix.det_mul, hH_std_sq, Matrix.det_one]
    rw [hdet0, zero_mul] at h1
    exact zero_ne_one h1
  · intro Q
    ext i j
    simp only [Matrix.of_apply, Matrix.map_apply, MvPolynomial.pderiv_map,
      MvPolynomial.constantCoeff_map]
  · intro c Q
    ext i j
    simp only [Matrix.of_apply, Matrix.smul_apply, smul_eq_mul, MvPolynomial.pderiv_C_mul,
      map_mul, MvPolynomial.constantCoeff_C]
  · intro Q _hQ L
    let g : Fin N → MvPolynomial (Fin N) E :=
      fun a => ∑ b : Fin N, MvPolynomial.C (L a b) * MvPolynomial.X b
    have hpderiv_g : ∀ a i : Fin N, MvPolynomial.pderiv i (g a) = MvPolynomial.C (L a i) := by
      intro a i
      dsimp [g]
      simp only [map_sum, MvPolynomial.pderiv_C_mul, hpderiv_X, mul_ite, mul_one, mul_zero,
        Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
    have hchain : ∀ (P : MvPolynomial (Fin N) E) (i : Fin N),
        MvPolynomial.pderiv i (MvPolynomial.eval₂ MvPolynomial.C g P) =
          ∑ a : Fin N, MvPolynomial.C (L a i) *
            MvPolynomial.eval₂ MvPolynomial.C g (MvPolynomial.pderiv a P) := by
      intro P
      refine MvPolynomial.induction_on
        (motive := fun P => ∀ i : Fin N,
          MvPolynomial.pderiv i (MvPolynomial.eval₂ MvPolynomial.C g P) =
            ∑ a : Fin N, MvPolynomial.C (L a i) *
              MvPolynomial.eval₂ MvPolynomial.C g (MvPolynomial.pderiv a P))
        P ?_ ?_ ?_
      · intro r i
        simp only [MvPolynomial.eval₂_C, MvPolynomial.pderiv_C, MvPolynomial.eval₂_zero,
          mul_zero, Finset.sum_const_zero]
      · intro p q hp hq i
        rw [MvPolynomial.eval₂_add, map_add, hp i, hq i, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [← mul_add, ← MvPolynomial.eval₂_add, ← map_add]
      · intro p n hp i
        rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, MvPolynomial.pderiv_mul,
          hp i, hpderiv_g n i]
        have hrhs :
            (∑ a : Fin N, MvPolynomial.C (L a i) *
              MvPolynomial.eval₂ MvPolynomial.C g
                (MvPolynomial.pderiv a (p * MvPolynomial.X n))) =
            (∑ a : Fin N, (MvPolynomial.C (L a i) *
              MvPolynomial.eval₂ MvPolynomial.C g (MvPolynomial.pderiv a p)) * g n) +
            (∑ a : Fin N, MvPolynomial.C (L a i) *
              (MvPolynomial.eval₂ MvPolynomial.C g p *
                MvPolynomial.eval₂ MvPolynomial.C g (MvPolynomial.pderiv a (MvPolynomial.X n)))) := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [MvPolynomial.pderiv_mul, MvPolynomial.eval₂_add, MvPolynomial.eval₂_mul,
            MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, mul_add, mul_assoc]
        rw [hrhs, ← Finset.sum_mul]
        congr 1
        rw [Finset.sum_eq_single n]
        · rw [hpderiv_X]
          simp only [↓reduceIte, MvPolynomial.eval₂_one, mul_one]
          rw [mul_comm]
        · intro a _ ha
          rw [hpderiv_X]
          simp only [Ne.symm ha, ↓reduceIte, MvPolynomial.eval₂_zero, mul_zero]
        · intro h_abs
          exact (h_abs (Finset.mem_univ n)).elim
    have hconst_ev_hom :
        MvPolynomial.constantCoeff.comp (MvPolynomial.eval₂Hom MvPolynomial.C g) =
          (MvPolynomial.constantCoeff : MvPolynomial (Fin N) E →+* E) := by
      apply MvPolynomial.ringHom_ext'
      · ext r
        simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
      · intro a
        simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', MvPolynomial.constantCoeff_X]
        dsimp [g]
        simp only [map_sum, map_mul, MvPolynomial.constantCoeff_C, MvPolynomial.constantCoeff_X,
          mul_zero, Finset.sum_const_zero]
    have hconst_ev : ∀ P : MvPolynomial (Fin N) E,
        MvPolynomial.constantCoeff (MvPolynomial.eval₂ MvPolynomial.C g P) =
          MvPolynomial.constantCoeff P := by
      intro P
      have h := RingHom.congr_fun hconst_ev_hom P
      simpa only [RingHom.comp_apply, MvPolynomial.coe_eval₂Hom] using h
    ext i j
    simp only [Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply]
    change MvPolynomial.constantCoeff
        (MvPolynomial.pderiv j (MvPolynomial.pderiv i (MvPolynomial.eval₂ MvPolynomial.C g Q))) = _
    rw [hchain Q i, map_sum]
    have hstep2 :
        (∑ a : Fin N, MvPolynomial.pderiv j
          (MvPolynomial.C (L a i) *
            MvPolynomial.eval₂ MvPolynomial.C g (MvPolynomial.pderiv a Q))) =
        ∑ a : Fin N, MvPolynomial.C (L a i) *
          (∑ b : Fin N, MvPolynomial.C (L b j) *
            MvPolynomial.eval₂ MvPolynomial.C g
              (MvPolynomial.pderiv b (MvPolynomial.pderiv a Q))) := by
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [MvPolynomial.pderiv_C_mul, hchain (MvPolynomial.pderiv a Q) j]
    rw [hstep2]
    simp only [map_sum, map_mul, MvPolynomial.constantCoeff_C, hconst_ev]
    simp only [Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun a _ => ?_
    ring

theorem weil_etale_roof_away_field_quotient_and_algClosed_lift (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (A₀ : Type u) [CommRing A₀]
    (alg_A₀ : F →+* A₀)
    (ε₀ : A₀ →+* F) (hε_id : ε₀.comp alg_A₀ = RingHom.id F)
    (E₁ : Type u) [Field E₁] [Algebra F E₁] [FiniteDimensional F E₁]
    (B' : Type u) [CommRing B']
    (q₀ : PrimeSpectrum B')
    (φ₁ : A₀ →+* B') (hφ₁_et : φ₁.Etale)
    (φ₂ : (MvPolynomial (Fin (m + 1) × Fin 2) E₁ ⧸
      Ideal.span {∑ j : Fin (m + 1),
        (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) E₁) *
          MvPolynomial.X (j, 1)}) →+* B')
    (hφ₂_et : φ₂.Etale)
    (hφ_alg : φ₁.comp alg_A₀ =
      φ₂.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C.comp (algebraMap F E₁))))
    (hq₁ : (PrimeSpectrum.comap φ₁ q₀).asIdeal = RingHom.ker ε₀)
    (hq₂ : ∀ idx : Fin (m + 1) × Fin 2,
      φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∈ q₀.asIdeal)
    (hSpan_B : Ideal.map φ₁ (RingHom.ker ε₀) =
      Ideal.span (Set.range fun idx : Fin (m + 1) × Fin 2 =>
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx)))) :
    (∃ (B₁ E'₁ : Type u) (_ : CommRing B₁) (_ : Field E'₁)
      (alg_FE'₁ : F →+* E'₁) (alg_E₁E'₁ : E₁ →+* E'₁)
      (ψ₁ : A₀ →+* B₁)
      (ψ₂ : (MvPolynomial (Fin (m + 1) × Fin 2) E₁ ⧸
        Ideal.span {∑ j : Fin (m + 1),
          (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) E₁) *
            MvPolynomial.X (j, 1)}) →+* B₁)
      (ε_B₁ : B₁ →+* E'₁),
      ψ₁.Flat ∧
      ψ₂.Flat ∧
      Function.Surjective ε_B₁ ∧
      alg_E₁E'₁.comp (algebraMap F E₁) = alg_FE'₁ ∧
      ψ₁.comp alg_A₀ =
        ψ₂.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C.comp (algebraMap F E₁))) ∧
      ε_B₁.comp ψ₁ = alg_FE'₁.comp ε₀ ∧
      (∀ e : E₁, ε_B₁ (ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.C e))) = alg_E₁E'₁ e) ∧
      RingHom.ker ε_B₁ = Ideal.map ψ₁ (RingHom.ker ε₀) ∧
      Ideal.map ψ₁ (RingHom.ker ε₀) =
        Ideal.span (Set.range fun idx : Fin (m + 1) × Fin 2 =>
          ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx)))) ∧
    (∀ (s₀ : A₀) (_hs₀ : ε₀ s₀ ≠ 0)
      (A' : Type u) [CommRing A'] (loc : A₀ →+* A'),
      @IsLocalization.Away A₀ _ s₀ A' _ loc.toAlgebra →
      ∀ (ε' : A' →+* F),
        ε'.comp loc = ε₀ →
        ε'.comp (loc.comp alg_A₀) = RingHom.id F →
        letI : Algebra F A' := (loc.comp alg_A₀).toAlgebra
        ∃ (B''_k : Type u) (_ : CommRing B''_k)
          (f_k : TensorProduct F (AlgebraicClosure F) A' →+* B''_k)
          (ψ_Ck : (MvPolynomial (Fin (m + 1) × Fin 2) (AlgebraicClosure F) ⧸
            Ideal.span {∑ j : Fin (m + 1),
              (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) (AlgebraicClosure F)) *
                MvPolynomial.X (j, 1)}) →+* B''_k)
          (χ_k : B''_k →+* AlgebraicClosure F),
          f_k.Etale ∧
          ψ_Ck.Etale ∧
          f_k.comp Algebra.TensorProduct.includeLeftRingHom =
            ψ_Ck.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) ∧
          χ_k.comp (f_k.comp Algebra.TensorProduct.includeLeftRingHom) =
            RingHom.id (AlgebraicClosure F) ∧
          (∀ a : A', χ_k (f_k (1 ⊗ₜ[F] a)) = algebraMap F (AlgebraicClosure F) (ε' a)) ∧
          Ideal.map f_k
            (Ideal.map
              (Algebra.TensorProduct.includeRight :
                A' →ₐ[F] TensorProduct F (AlgebraicClosure F) A').toRingHom
              (RingHom.ker ε')) =
            Ideal.span (Set.range fun idx : Fin (m + 1) × Fin 2 =>
              ψ_Ck (Ideal.Quotient.mk _ (MvPolynomial.X idx)))) :=
by
  let _ := hq₂
  
  have hEtaleFlat : ∀ {R T : Type u} [CommRing R] [CommRing T] (g : R →+* T),
      g.Etale → g.Flat := by
    intro R T _ _ g hg
    let _ : Algebra R T := g.toAlgebra
    have _ : Algebra.Etale R T := RingHom.etale_algebraMap.mp hg
    exact RingHom.flat_algebraMap_iff.mpr inferInstance

  
  have hTensorMapEtale : ∀ (K R₁ R₂ : Type u) [CommRing K] [CommRing R₁] [CommRing R₂]
      [Algebra F K] [Algebra F R₁] [Algebra F R₂] (g : R₁ →ₐ[F] R₂),
      g.toRingHom.Etale →
      (Algebra.TensorProduct.map (AlgHom.id F K) g).toRingHom.Etale := by
    intro K R₁ R₂ _ _ _ _ _ _ g hg
    let _ : Algebra R₁ R₂ := g.toRingHom.toAlgebra
    have _ : IsScalarTower F R₁ R₂ :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun r => (g.commutes r).symm)
    have _ : Algebra.Etale R₁ R₂ := RingHom.etale_algebraMap.mp hg
    let RK := TensorProduct F R₁ K
    have _ : Algebra.Etale RK (TensorProduct R₁ RK R₂) := Algebra.Etale.baseChange R₁ R₂ RK
    have h1 : (Algebra.TensorProduct.includeLeftRingHom : RK →+* TensorProduct R₁ RK R₂).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
    let e_can : TensorProduct R₁ R₂ RK ≃ₐ[R₁] TensorProduct F R₂ K :=
      Algebra.TensorProduct.cancelBaseChange F R₁ R₁ R₂ K
    let compHom : TensorProduct F K R₁ →+* TensorProduct F K R₂ :=
      (Algebra.TensorProduct.comm F R₂ K).toRingHom.comp
        (e_can.toRingHom.comp
          ((Algebra.TensorProduct.comm R₁ RK R₂).toRingHom.comp
            ((Algebra.TensorProduct.includeLeftRingHom : RK →+* TensorProduct R₁ RK R₂).comp
              (Algebra.TensorProduct.comm F K R₁).toRingHom)))
    have hEt : compHom.Etale :=
      RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.stableUnderComposition _ _
          (RingHom.Etale.stableUnderComposition _ _
            (RingHom.Etale.stableUnderComposition _ _
              (RingHom.Etale.of_bijective (Algebra.TensorProduct.comm F K R₁).bijective) h1)
            (RingHom.Etale.of_bijective (Algebra.TensorProduct.comm R₁ RK R₂).bijective))
          (RingHom.Etale.of_bijective e_can.bijective))
        (RingHom.Etale.of_bijective (Algebra.TensorProduct.comm F R₂ K).bijective)
    have hEq : (Algebra.TensorProduct.map (AlgHom.id F K) g).toRingHom = compHom := by
      apply RingHom.ext
      intro z
      refine TensorProduct.inductionOn (motive := fun w =>
        (Algebra.TensorProduct.map (AlgHom.id F K) g).toRingHom w = compHom w) z ?_ ?_
      · intro k r₁
        change k ⊗ₜ[F] (g r₁) =
          (Algebra.TensorProduct.comm F R₂ K)
            (e_can ((1 : R₂) ⊗ₜ[R₁] (r₁ ⊗ₜ[F] k)))
        rw [Algebra.TensorProduct.cancelBaseChange_tmul]
        have hsmul : r₁ • (1 : R₂) = g r₁ := by
          change g r₁ * 1 = g r₁
          exact mul_one _
        rw [hsmul]
        rfl
      · intro x y hx hy
        rw [map_add, map_add, hx, hy]
    rwa [hEq]

  
  let h_poly : ∀ (R : Type u) [CommRing R], MvPolynomial (Fin (m + 1) × Fin 2) R :=
    fun R _ => ∑ j : Fin (m + 1),
      (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) R) * MvPolynomial.X (j, 1)
  have hConePkg : ∃ (C_F : Type u) (_ : CommRing C_F) (_ : Algebra F C_F)
      (x_F : Fin (m + 1) × Fin 2 → C_F),
      ∀ (L : Type u) [Field L] [Algebra F L],
        let C_L := MvPolynomial (Fin (m + 1) × Fin 2) L ⧸ Ideal.span {h_poly L}
        ∃ (ι_FL : C_F →ₐ[F] C_L) (e_CL : TensorProduct F L C_F ≃ₐ[L] C_L),
          (∀ idx, ι_FL (x_F idx) = Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∧
          (∀ x, e_CL ((1 : L) ⊗ₜ[F] x) = ι_FL x) ∧
          (∀ c : L, e_CL.symm (Ideal.Quotient.mk _ (MvPolynomial.C c)) = c ⊗ₜ[F] 1) ∧
          (∀ idx, e_CL.symm (Ideal.Quotient.mk _ (MvPolynomial.X idx)) =
            (1 : L) ⊗ₜ[F] (x_F idx)) := by
    let C_F0 : Type u := MvPolynomial (Fin (m + 1) × Fin 2) F ⧸ Ideal.span {h_poly F}
    refine ⟨C_F0, inferInstance, inferInstance,
      fun idx => Ideal.Quotient.mk _ (MvPolynomial.X idx), ?_⟩
    intro L _ _ C_L
    let p_FL : MvPolynomial (Fin (m + 1) × Fin 2) F →ₐ[F] C_L :=
      ((Ideal.Quotient.mkₐ L (Ideal.span {h_poly L})).restrictScalars F).comp
        (MvPolynomial.mapAlgHom (Algebra.ofId F L))
    have hp_ker : ∀ a ∈ Ideal.span {h_poly F}, p_FL a = 0 := by
      intro a ha
      rw [Ideal.mem_span_singleton] at ha
      rcases ha with ⟨q, rfl⟩
      rw [map_mul]
      suffices hp0 : p_FL (h_poly F) = 0 from mul_eq_zero_of_left hp0 _
      change Ideal.Quotient.mk (Ideal.span {h_poly L})
        ((MvPolynomial.map (algebraMap F L)) (h_poly F)) = 0
      have hmap : (MvPolynomial.map (algebraMap F L)) (h_poly F) = h_poly L := by
        simp [h_poly, map_sum, map_mul]
      rw [hmap]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    let ι_FL : C_F0 →ₐ[F] C_L := Ideal.Quotient.liftₐ (Ideal.span {h_poly F}) p_FL hp_ker
    have hι_X : ∀ idx, ι_FL (Ideal.Quotient.mk _ (MvPolynomial.X idx)) =
        Ideal.Quotient.mk _ (MvPolynomial.X idx) := by
      intro idx
      change p_FL (MvPolynomial.X idx) = _
      simp [p_FL]
    let α_L : TensorProduct F L C_F0 →ₐ[L] C_L :=
      Algebra.TensorProduct.lift (Algebra.ofId L C_L) ι_FL (fun _ _ => Commute.all _ _)
    let q_L : MvPolynomial (Fin (m + 1) × Fin 2) L →ₐ[L] TensorProduct F L C_F0 :=
      MvPolynomial.aeval (fun idx : Fin (m + 1) × Fin 2 =>
        (1 : L) ⊗ₜ[F] Ideal.Quotient.mk (Ideal.span {h_poly F}) (MvPolynomial.X idx))
    have hq_ker : ∀ a ∈ Ideal.span {h_poly L}, q_L a = 0 := by
      suffices hle : Ideal.span {h_poly L} ≤ RingHom.ker q_L.toRingHom from
        fun a ha => hle ha
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      change q_L (h_poly L) = 0
      have hsum : q_L (h_poly L) =
          (1 : L) ⊗ₜ[F] Ideal.Quotient.mk (Ideal.span {h_poly F}) (h_poly F) := by
        dsimp [h_poly]
        rw [map_sum, map_sum, TensorProduct.tmul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X,
          Algebra.TensorProduct.tmul_mul_tmul, one_mul, map_mul]
      have h0 : Ideal.Quotient.mk (Ideal.span {h_poly F}) (h_poly F) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [hsum, h0, TensorProduct.tmul_zero]
    let β_L : C_L →ₐ[L] TensorProduct F L C_F0 :=
      Ideal.Quotient.liftₐ (Ideal.span {h_poly L}) q_L hq_ker
    have hαβ : α_L.comp β_L = AlgHom.id L C_L := by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro idx
      change α_L (q_L (MvPolynomial.X idx)) = Ideal.Quotient.mk _ (MvPolynomial.X idx)
      rw [MvPolynomial.aeval_X]
      dsimp [α_L]
      rw [map_one, one_mul, hι_X]
    have hβα : β_L.comp α_L = AlgHom.id L (TensorProduct F L C_F0) := by
      apply Algebra.TensorProduct.ext
      · ext
      · apply Ideal.Quotient.algHom_ext
        apply MvPolynomial.algHom_ext
        intro idx
        change β_L (α_L ((1 : L) ⊗ₜ[F] Ideal.Quotient.mk _ (MvPolynomial.X idx))) =
          (1 : L) ⊗ₜ[F] Ideal.Quotient.mk _ (MvPolynomial.X idx)
        dsimp [α_L]
        rw [map_one, one_mul, hι_X]
        change q_L (MvPolynomial.X idx) = _
        exact MvPolynomial.aeval_X _ idx
    let e_CL : TensorProduct F L C_F0 ≃ₐ[L] C_L := AlgEquiv.ofAlgHom α_L β_L hαβ hβα
    refine ⟨ι_FL, e_CL, hι_X, ?_, ?_, ?_⟩
    · intro x
      change α_L ((1 : L) ⊗ₜ[F] x) = ι_FL x
      dsimp [α_L]
      rw [map_one, one_mul]
    · intro c
      change β_L (algebraMap L C_L c) = c ⊗ₜ[F] 1
      rw [β_L.commutes]
      rfl
    · intro idx
      change q_L (MvPolynomial.X idx) = _
      exact MvPolynomial.aeval_X _ idx

  
  
  
  have hPart1 : ∃ (B₁ E'₁ : Type u) (_ : CommRing B₁) (_ : Field E'₁)
      (_ : Algebra F E'₁) (_ : Algebra.IsAlgebraic F E'₁)
      (alg_E₁E'₁ : E₁ →+* E'₁)
      (ψ₁ : A₀ →+* B₁)
      (ψ₂ : (MvPolynomial (Fin (m + 1) × Fin 2) E₁ ⧸ Ideal.span {h_poly E₁}) →+* B₁)
      (ε_B₁ : B₁ →+* E'₁),
      ψ₁.Etale ∧
      ψ₂.Etale ∧
      Function.Surjective ε_B₁ ∧
      alg_E₁E'₁.comp (algebraMap F E₁) = algebraMap F E'₁ ∧
      ψ₁.comp alg_A₀ =
        ψ₂.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C.comp (algebraMap F E₁))) ∧
      ε_B₁.comp ψ₁ = (algebraMap F E'₁).comp ε₀ ∧
      (∀ e : E₁, ε_B₁ (ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.C e))) = alg_E₁E'₁ e) ∧
      RingHom.ker ε_B₁ = Ideal.map ψ₁ (RingHom.ker ε₀) ∧
      Ideal.map ψ₁ (RingHom.ker ε₀) =
        Ideal.span (Set.range fun idx : Fin (m + 1) × Fin 2 =>
          ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx))) := by
    let 𝔪₀ : Ideal A₀ := RingHom.ker ε₀
    let J_B : Ideal B' := Ideal.map φ₁ 𝔪₀
    let Q : Type u := B' ⧸ J_B
    let π_Q : B' →+* Q := Ideal.Quotient.mk J_B
    let _ : Algebra F Q := (π_Q.comp (φ₁.comp alg_A₀)).toAlgebra

    have ha_sub_ker : ∀ a : A₀, a - alg_A₀ (ε₀ a) ∈ 𝔪₀ := by
      intro a
      change ε₀ (a - alg_A₀ (ε₀ a)) = 0
      rw [map_sub, show ε₀ (alg_A₀ (ε₀ a)) = (ε₀.comp alg_A₀) (ε₀ a) from rfl,
        hε_id, RingHom.id_apply, sub_self]

    have _ : Algebra.Etale F Q := by
      let _ : Algebra A₀ F := ε₀.toAlgebra
      let _ : Algebra A₀ B' := φ₁.toAlgebra
      have hπ_φ₁_eq : ∀ a : A₀, π_Q (φ₁ a) = π_Q (φ₁ (alg_A₀ (ε₀ a))) := by
        intro a
        rw [← sub_eq_zero, ← map_sub, ← map_sub]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem φ₁ (ha_sub_ker a))
      have _ : IsScalarTower A₀ F Q :=
        ⟨fun a c q => by
          rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def]
          change π_Q (φ₁ (alg_A₀ (ε₀ a * c))) * q =
            π_Q (φ₁ a) * (π_Q (φ₁ (alg_A₀ c)) * q)
          rw [map_mul alg_A₀, map_mul φ₁, map_mul π_Q, ← hπ_φ₁_eq a, mul_assoc]⟩
      have _ : Algebra.Etale A₀ B' := RingHom.etale_algebraMap.mp hφ₁_et
      have _ : Algebra.Etale F (TensorProduct A₀ F B') := Algebra.Etale.baseChange A₀ B' F
      let π_Q_alg : B' →ₐ[A₀] Q := Ideal.Quotient.mkₐ A₀ J_B
      let Θ_hom : TensorProduct A₀ F B' →ₐ[F] Q :=
        Algebra.TensorProduct.lift (Algebra.ofId F Q) π_Q_alg (fun _ _ => Commute.all _ _)
      let incR_B : B' →+* TensorProduct A₀ F B' :=
        (Algebra.TensorProduct.includeRight : B' →ₐ[A₀] TensorProduct A₀ F B').toRingHom
      have hJB_le : J_B ≤ RingHom.ker incR_B := by
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        change (1 : F) ⊗ₜ[A₀] (φ₁ a) = 0
        have hsmul : φ₁ a = a • (1 : B') := by
          change φ₁ a = φ₁ a * 1
          exact (mul_one _).symm
        rw [hsmul, ← TensorProduct.smul_tmul]
        have haF : a • (1 : F) = 0 := by
          change ε₀ a * 1 = 0
          rw [RingHom.mem_ker.mp ha, zero_mul]
        rw [haF, TensorProduct.zero_tmul]
      let Θ_inv : Q →+* TensorProduct A₀ F B' :=
        Ideal.Quotient.lift J_B incR_B (fun _ hb => hJB_le hb)
      have hLeftInv : Function.LeftInverse Θ_inv Θ_hom := by
        intro z
        refine TensorProduct.inductionOn (motive := fun w => Θ_inv (Θ_hom w) = w) z ?_ ?_
        · intro c b
          dsimp [Θ_hom]
          change Θ_inv (π_Q (φ₁ (alg_A₀ c)) * π_Q b) = c ⊗ₜ[A₀] b
          rw [← map_mul]
          change (1 : F) ⊗ₜ[A₀] (φ₁ (alg_A₀ c) * b) = c ⊗ₜ[A₀] b
          have hsmulB : φ₁ (alg_A₀ c) * b = (alg_A₀ c) • b := rfl
          rw [hsmulB, ← TensorProduct.smul_tmul]
          congr 1
          change ε₀ (alg_A₀ c) * 1 = c
          rw [mul_one, show ε₀ (alg_A₀ c) = (ε₀.comp alg_A₀) c from rfl, hε_id, RingHom.id_apply]
        · intro x y hx hy
          rw [map_add, map_add, hx, hy]
      have hSurjΘ : Function.Surjective Θ_hom := by
        intro q
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q
        refine ⟨(1 : F) ⊗ₜ[A₀] b, ?_⟩
        dsimp [Θ_hom]
        rw [map_one, one_mul]
        rfl
      exact Algebra.Etale.of_equiv (AlgEquiv.ofBijective Θ_hom ⟨hLeftInv.injective, hSurjΘ⟩)

    obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod F Q).mp inferInstance
    let _ : Finite I := hFinI
    let _ : ∀ i, Field (Ai i) := hFieldAi
    let _ : ∀ i, Algebra F (Ai i) := hAlgAi
    let _ : Fintype I := Fintype.ofFinite I
    classical

    let ρ : B' →+* (∀ i : I, Ai i) := e_prod.toRingHom.comp π_Q
    have hρ_surj : Function.Surjective ρ :=
      e_prod.surjective.comp Ideal.Quotient.mk_surjective
    have hρ_eq_zero : ∀ b : B', ρ b = 0 ↔ b ∈ J_B := by
      intro b
      change e_prod (π_Q b) = 0 ↔ b ∈ J_B
      rw [map_eq_zero_iff e_prod e_prod.injective, Ideal.Quotient.eq_zero_iff_mem]
    have hJB_le_q₀ : J_B ≤ q₀.asIdeal := by
      rw [Ideal.map_le_iff_le_comap]
      exact hq₁.symm.le

    let t : I → B' := fun i => (hρ_surj (Pi.single i (1 : Ai i))).choose
    have ht_spec : ∀ i : I, ρ (t i) = Pi.single i (1 : Ai i) :=
      fun i => (hρ_surj (Pi.single i (1 : Ai i))).choose_spec

    have hsum_one_sub_mem : (1 : B') - ∑ i : I, t i ∈ q₀.asIdeal := by
      apply hJB_le_q₀
      rw [← hρ_eq_zero, map_sub, map_one, map_sum]
      suffices hsum : (∑ i : I, ρ (t i)) = 1 by rw [hsum, sub_self]
      ext j
      rw [Finset.sum_apply, Pi.one_apply]
      simp_rw [ht_spec]
      rw [Finset.sum_eq_single j]
      · exact Pi.single_eq_same j 1
      · intro i _ hij
        exact Pi.single_eq_of_ne hij.symm 1
      · intro hj
        exact absurd (Finset.mem_univ j) hj

    obtain ⟨i₀, _ht₀_not_mem⟩ : ∃ i₀ : I, t i₀ ∉ q₀.asIdeal := by
      by_contra h_all
      simp only [not_exists, Classical.not_not] at h_all
      have hsum_mem : ∑ i : I, t i ∈ q₀.asIdeal :=
        q₀.asIdeal.sum_mem fun i _ => h_all i
      have hone_mem : (1 : B') ∈ q₀.asIdeal := by
        have hadd := q₀.asIdeal.add_mem hsum_one_sub_mem hsum_mem
        rwa [sub_add_cancel] at hadd
      exact q₀.isPrime.one_notMem hone_mem

    let t₀ : B' := t i₀
    let E'₁ : Type u := Ai i₀
    let _ : Field E'₁ := hFieldAi i₀
    let _ : Algebra F E'₁ := hAlgAi i₀
    have _ : Module.Finite F E'₁ := (hFinSep i₀).1
    have hIsAlgE'₁ : Algebra.IsAlgebraic F E'₁ := Algebra.IsAlgebraic.of_finite F E'₁
    let alg_FE'₁ : F →+* E'₁ := algebraMap F E'₁

    let π₀ : B' →+* E'₁ := (Pi.evalRingHom Ai i₀).comp ρ
    have hπ₀_t₀ : π₀ t₀ = 1 := by
      change ρ (t i₀) i₀ = 1
      rw [ht_spec i₀, Pi.single_eq_same]
    have hπ₀_surj : Function.Surjective π₀ := by
      intro z
      obtain ⟨b, hb⟩ := hρ_surj (Pi.single i₀ z)
      refine ⟨b, ?_⟩
      change ρ b i₀ = z
      rw [hb, Pi.single_eq_same]
    have hJB_le_ker_π₀ : ∀ b : B', b ∈ J_B → π₀ b = 0 := by
      intro b hb
      change ρ b i₀ = 0
      rw [(hρ_eq_zero b).mpr hb, Pi.zero_apply]
    have hAnn : ∀ b : B', π₀ b = 0 ↔ t₀ * b ∈ J_B := by
      intro b
      constructor
      · intro hb0
        rw [← hρ_eq_zero]
        ext j
        rw [map_mul, Pi.mul_apply, Pi.zero_apply, ht_spec i₀]
        by_cases hj : j = i₀
        · subst hj
          change Pi.single j 1 j * π₀ b = 0
          rw [hb0, mul_zero]
        · rw [Pi.single_eq_of_ne hj 1, zero_mul]
      · intro htb
        have h0 : π₀ (t₀ * b) = 0 := hJB_le_ker_π₀ _ htb
        rwa [map_mul, hπ₀_t₀, one_mul] at h0
    have hπ₀_φ₁ : π₀.comp φ₁ = alg_FE'₁.comp ε₀ := by
      ext a
      change π₀ (φ₁ a) = alg_FE'₁ (ε₀ a)
      have hdiff : φ₁ a - φ₁ (alg_A₀ (ε₀ a)) ∈ J_B := by
        rw [← map_sub]
        exact Ideal.mem_map_of_mem φ₁ (ha_sub_ker a)
      have hsub0 : π₀ (φ₁ a) - π₀ (φ₁ (alg_A₀ (ε₀ a))) = 0 := by
        rw [← map_sub]
        exact hJB_le_ker_π₀ _ hdiff
      rw [sub_eq_zero.mp hsub0]
      change (e_prod (algebraMap F Q (ε₀ a))) i₀ = algebraMap F E'₁ (ε₀ a)
      rw [e_prod.commutes]
      rfl

    let B₁ : Type u := Localization.Away t₀
    let loc_t : B' →+* B₁ := algebraMap B' B₁
    have hloc_t_et : loc_t.Etale := by
      have _ : Algebra.FormallyEtale B' B₁ :=
        Algebra.FormallyEtale.of_isLocalization (Submonoid.powers t₀)
      have _ : Algebra.FinitePresentation B' B₁ :=
        IsLocalization.Away.finitePresentation t₀
      have _ : Algebra.Etale B' B₁ := Algebra.Etale.mk
      exact RingHom.etale_algebraMap.mpr inferInstance

    let ψ₁ : A₀ →+* B₁ := loc_t.comp φ₁
    let ψ₂ : (MvPolynomial (Fin (m + 1) × Fin 2) E₁ ⧸ Ideal.span {h_poly E₁}) →+* B₁ :=
      loc_t.comp φ₂
    have hψ₁_et : ψ₁.Etale := RingHom.Etale.stableUnderComposition _ _ hφ₁_et hloc_t_et
    have hψ₂_et : ψ₂.Etale := RingHom.Etale.stableUnderComposition _ _ hφ₂_et hloc_t_et

    have ht₀_unit : IsUnit (π₀ t₀) := by
      rw [hπ₀_t₀]
      exact isUnit_one
    let ε_B₁ : B₁ →+* E'₁ := IsLocalization.Away.lift t₀ ht₀_unit
    have hε_loct : ∀ b : B', ε_B₁ (loc_t b) = π₀ b :=
      fun b => IsLocalization.Away.lift_eq t₀ ht₀_unit b
    have hSurj_ε : Function.Surjective ε_B₁ := by
      intro z
      obtain ⟨b, hb⟩ := hπ₀_surj z
      exact ⟨loc_t b, (hε_loct b).trans hb⟩
    have hε_ψ₁ : ε_B₁.comp ψ₁ = alg_FE'₁.comp ε₀ := by
      ext a
      change ε_B₁ (loc_t (φ₁ a)) = (alg_FE'₁.comp ε₀) a
      rw [hε_loct, ← hπ₀_φ₁]
      rfl

    let alg_E₁E'₁ : E₁ →+* E'₁ :=
      (ε_B₁.comp ψ₂).comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)
    have hψ_alg : ψ₁.comp alg_A₀ =
        ψ₂.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C.comp (algebraMap F E₁))) := by
      change (loc_t.comp φ₁).comp alg_A₀ = (loc_t.comp φ₂).comp _
      rw [RingHom.comp_assoc, hφ_alg, ← RingHom.comp_assoc]
    have hComp_E : alg_E₁E'₁.comp (algebraMap F E₁) = alg_FE'₁ := by
      ext c
      change alg_E₁E'₁ (algebraMap F E₁ c) = alg_FE'₁ c
      have h1 : alg_E₁E'₁ (algebraMap F E₁ c) =
          (ε_B₁.comp (ψ₂.comp ((Ideal.Quotient.mk _).comp
            (MvPolynomial.C.comp (algebraMap F E₁))))) c := rfl
      rw [h1, ← hψ_alg, ← RingHom.comp_assoc, hε_ψ₁]
      change alg_FE'₁ ((ε₀.comp alg_A₀) c) = alg_FE'₁ c
      rw [hε_id, RingHom.id_apply]

    have hker_εB₁ : RingHom.ker ε_B₁ = Ideal.map ψ₁ (RingHom.ker ε₀) := by
      have hmap_eq : Ideal.map ψ₁ (RingHom.ker ε₀) = Ideal.map loc_t J_B := by
        dsimp [ψ₁, J_B, 𝔪₀]
        exact (Ideal.map_map φ₁ loc_t).symm
      rw [hmap_eq]
      apply le_antisymm
      · intro x hx
        obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj (Submonoid.powers t₀) x
        have hbs' : x * loc_t s.1 = loc_t b := hbs
        have hπb : π₀ b = 0 := by
          have h1 := congrArg ε_B₁ hbs'
          simp only [map_mul, hε_loct, RingHom.mem_ker.mp hx, zero_mul] at h1
          exact h1.symm
        have htb_mem : t₀ * b ∈ J_B := (hAnn b).mp hπb
        let hu₀_unit := IsLocalization.map_units B₁ ⟨t₀, Submonoid.mem_powers t₀⟩
        let hus_unit := IsLocalization.map_units B₁ s
        let u₀ : B₁ˣ := hu₀_unit.unit
        let u_s : B₁ˣ := hus_unit.unit
        have hx_eq : x = loc_t (t₀ * b) * (↑u₀⁻¹ * ↑u_s⁻¹) := by
          have hu₀ : (u₀ : B₁) = loc_t t₀ := hu₀_unit.unit_spec
          have hus : (u_s : B₁) = loc_t s.1 := hus_unit.unit_spec
          calc
            x = (x * (u_s : B₁)) * ↑u_s⁻¹ := by rw [mul_assoc, Units.mul_inv, mul_one]
            _ = loc_t b * ↑u_s⁻¹ := by rw [hus, hbs']
            _ = ((u₀ : B₁) * ↑u₀⁻¹) * (loc_t b * ↑u_s⁻¹) := by rw [Units.mul_inv, one_mul]
            _ = ((u₀ : B₁) * loc_t b) * (↑u₀⁻¹ * ↑u_s⁻¹) := by ring
            _ = loc_t (t₀ * b) * (↑u₀⁻¹ * ↑u_s⁻¹) := by rw [hu₀, ← map_mul]
        rw [hx_eq]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem loc_t htb_mem)
      · rw [Ideal.map_le_iff_le_comap]
        intro b hb
        change ε_B₁ (loc_t b) = 0
        rw [hε_loct]
        exact hJB_le_ker_π₀ b hb

    have hSpan_B₁ : Ideal.map ψ₁ (RingHom.ker ε₀) =
        Ideal.span (Set.range fun idx : Fin (m + 1) × Fin 2 =>
          ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx))) := by
      change Ideal.map (loc_t.comp φ₁) (RingHom.ker ε₀) = _
      rw [← Ideal.map_map, hSpan_B, Ideal.map_span, ← Set.range_comp]
      rfl

    exact ⟨B₁, E'₁, inferInstance, inferInstance, inferInstance, hIsAlgE'₁, alg_E₁E'₁,
      ψ₁, ψ₂, ε_B₁, hψ₁_et, hψ₂_et, hSurj_ε, hComp_E, hψ_alg, hε_ψ₁,
      fun _ => rfl, hker_εB₁, hSpan_B₁⟩

  obtain ⟨B₁, E'₁, hRingB₁, hFieldE'₁, hAlgFE'₁, hIsAlgFE'₁, alg_E₁E'₁, ψ₁, ψ₂, ε_B₁,
    hψ₁_et, hψ₂_et, hSurj_ε, hComp_E, hψ_alg, hε_ψ₁, hε_ψ₂, hker_εB₁, hSpan_B₁⟩ := hPart1
  let _ : CommRing B₁ := hRingB₁
  let _ : Field E'₁ := hFieldE'₁
  let _ : Algebra F E'₁ := hAlgFE'₁
  have _ : Algebra.IsAlgebraic F E'₁ := hIsAlgFE'₁
  let alg_FE'₁ : F →+* E'₁ := algebraMap F E'₁

  refine ⟨⟨B₁, E'₁, hRingB₁, hFieldE'₁, alg_FE'₁, alg_E₁E'₁, ψ₁, ψ₂, ε_B₁,
    hEtaleFlat ψ₁ hψ₁_et, hEtaleFlat ψ₂ hψ₂_et, hSurj_ε, hComp_E, hψ_alg, hε_ψ₁,
    hε_ψ₂, hker_εB₁, hSpan_B₁⟩, ?_⟩

  
  
  
  intro s₀ _hs₀ A' _ loc hAway ε' hε'_loc _hε'_id
  let _ : Algebra F A' := (loc.comp alg_A₀).toAlgebra

  
  have hker_ε' : RingHom.ker ε' = Ideal.map loc (RingHom.ker ε₀) := by
    let _ : Algebra A₀ A' := loc.toAlgebra
    have _ : IsLocalization.Away s₀ A' := hAway
    apply le_antisymm
    · intro x hx
      obtain ⟨⟨a₀, m_s⟩, hms⟩ := IsLocalization.surj (Submonoid.powers s₀) x
      have hms' : x * loc m_s.1 = loc a₀ := hms
      have ha₀_ker : a₀ ∈ RingHom.ker ε₀ := by
        change ε₀ a₀ = 0
        have h1 := congrArg ε' hms'
        rw [map_mul, RingHom.mem_ker.mp hx, zero_mul] at h1
        have h2 : ε' (loc a₀) = ε₀ a₀ := by
          change (ε'.comp loc) a₀ = ε₀ a₀
          rw [hε'_loc]
        exact h2.symm.trans h1.symm
      let hus_unit := IsLocalization.map_units A' m_s
      let u_s : A'ˣ := hus_unit.unit
      have hx_eq : x = loc a₀ * ↑u_s⁻¹ := by
        have hus : (u_s : A') = loc m_s.1 := hus_unit.unit_spec
        calc
          x = (x * (u_s : A')) * ↑u_s⁻¹ := by rw [mul_assoc, Units.mul_inv, mul_one]
          _ = loc a₀ * ↑u_s⁻¹ := by rw [hus, hms']
      rw [hx_eq]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem loc ha₀_ker)
    · rw [Ideal.map_le_iff_le_comap]
      intro a₀ ha₀
      change (ε'.comp loc) a₀ = 0
      rw [hε'_loc]
      exact ha₀

  
  let _ : Algebra A₀ A' := loc.toAlgebra
  let _ : Algebra A₀ B₁ := ψ₁.toAlgebra
  have _ : Algebra.Etale A₀ B₁ := RingHom.etale_algebraMap.mp hψ₁_et
  let S : Type u := TensorProduct A₀ A' B₁
  let ψ₁_s_alg : A' →ₐ[F] S := Algebra.TensorProduct.includeLeft
  let ψ₁_s : A' →+* S := ψ₁_s_alg.toRingHom
  let loc_B : B₁ →+* S := (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₀] S).toRingHom

  have hψ₁_s_et : ψ₁_s.Etale := by
    have _ : Algebra.Etale A' S := Algebra.Etale.baseChange A₀ B₁ A'
    exact RingHom.etale_algebraMap.mpr inferInstance

  have hloc_B_et : loc_B.Etale := by
    have _ : IsLocalization.Away s₀ A' := hAway
    have _ : Algebra.FormallyEtale A₀ A' :=
      Algebra.FormallyEtale.of_isLocalization (Submonoid.powers s₀)
    have _ : Algebra.FinitePresentation A₀ A' :=
      IsLocalization.Away.finitePresentation s₀
    have _ : Algebra.Etale A₀ A' := Algebra.Etale.mk
    have _ : Algebra.Etale B₁ (TensorProduct A₀ B₁ A') := Algebra.Etale.baseChange A₀ A' B₁
    have h1 : (Algebra.TensorProduct.includeLeftRingHom : B₁ →+* TensorProduct A₀ B₁ A').Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
    have hEq : loc_B =
        (Algebra.TensorProduct.comm A₀ B₁ A').toRingHom.comp
          Algebra.TensorProduct.includeLeftRingHom := by
      ext b
      rfl
    rw [hEq]
    exact RingHom.Etale.stableUnderComposition _ _ h1
      (RingHom.Etale.of_bijective (Algebra.TensorProduct.comm A₀ B₁ A').bijective)

  have hpush_comm : ψ₁_s.comp loc = loc_B.comp ψ₁ := by
    ext a₀
    change (loc a₀) ⊗ₜ[A₀] (1 : B₁) = (1 : A') ⊗ₜ[A₀] (ψ₁ a₀)
    have hL : loc a₀ = a₀ • (1 : A') := by
      change loc a₀ = loc a₀ * 1
      exact (mul_one _).symm
    have hR : ψ₁ a₀ = a₀ • (1 : B₁) := by
      change ψ₁ a₀ = ψ₁ a₀ * 1
      exact (mul_one _).symm
    rw [hL, hR, TensorProduct.smul_tmul]

  have halgMap_FS : ∀ c : F, algebraMap F S c = loc_B (ψ₁ (alg_A₀ c)) := by
    intro c
    change (ψ₁_s.comp loc) (alg_A₀ c) = loc_B (ψ₁ (alg_A₀ c))
    rw [hpush_comm]
    rfl

  let B''_k : Type u := TensorProduct F (AlgebraicClosure F) S
  let f_k_alg : TensorProduct F (AlgebraicClosure F) A' →ₐ[F] B''_k :=
    Algebra.TensorProduct.map (AlgHom.id F (AlgebraicClosure F)) ψ₁_s_alg
  have hf_k_et : f_k_alg.toRingHom.Etale :=
    hTensorMapEtale (AlgebraicClosure F) A' S ψ₁_s_alg hψ₁_s_et
  let f_k := f_k_alg.toRingHom
  have hfk_left : f_k.comp Algebra.TensorProduct.includeLeftRingHom =
      Algebra.TensorProduct.includeLeftRingHom := by
    ext c
    change (Algebra.TensorProduct.map (AlgHom.id F (AlgebraicClosure F)) ψ₁_s_alg) (c ⊗ₜ[F] 1) =
      c ⊗ₜ[F] 1
    rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one]

  
  let σ_k : E'₁ →ₐ[F] AlgebraicClosure F := IsAlgClosed.lift
  have hε_S_exists : ∃ ε_S : S →+* E'₁,
      (∀ a : A', ε_S (ψ₁_s a) = alg_FE'₁ (ε' a)) ∧
      (∀ b : B₁, ε_S (loc_B b) = ε_B₁ b) := by
    let _ : Algebra A₀ E'₁ := (alg_FE'₁.comp ε₀).toAlgebra
    let left_S : A' →ₐ[A₀] E'₁ :=
      { toRingHom := alg_FE'₁.comp ε'
        commutes' := fun a₀ => by
          change alg_FE'₁ ((ε'.comp loc) a₀) = alg_FE'₁ (ε₀ a₀)
          rw [hε'_loc] }
    let right_S : B₁ →ₐ[A₀] E'₁ :=
      { toRingHom := ε_B₁
        commutes' := fun a₀ => by
          change (ε_B₁.comp ψ₁) a₀ = (alg_FE'₁.comp ε₀) a₀
          rw [hε_ψ₁] }
    let lift_S : S →ₐ[A₀] E'₁ :=
      Algebra.TensorProduct.lift left_S right_S (fun _ _ => Commute.all _ _)
    refine ⟨lift_S.toRingHom, ?_, ?_⟩
    · intro a
      change lift_S (a ⊗ₜ[A₀] 1) = alg_FE'₁ (ε' a)
      dsimp [lift_S]
      rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      rfl
    · intro b
      change lift_S (1 ⊗ₜ[A₀] b) = ε_B₁ b
      dsimp [lift_S]
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
  obtain ⟨ε_S, hε_S_left, hε_S_right⟩ := hε_S_exists

  let χ_S_alg : S →ₐ[F] AlgebraicClosure F :=
    { toRingHom := σ_k.toRingHom.comp ε_S
      commutes' := fun c => by
        change σ_k (ε_S (algebraMap F S c)) = algebraMap F (AlgebraicClosure F) c
        rw [halgMap_FS, hε_S_right,
          show ε_B₁ (ψ₁ (alg_A₀ c)) = (ε_B₁.comp ψ₁) (alg_A₀ c) from rfl, hε_ψ₁]
        change σ_k (algebraMap F E'₁ ((ε₀.comp alg_A₀) c)) = _
        rw [hε_id, RingHom.id_apply, σ_k.commutes] }
  let χ_k_alg : B''_k →ₐ[AlgebraicClosure F] AlgebraicClosure F :=
    Algebra.TensorProduct.lift
      (Algebra.ofId (AlgebraicClosure F) (AlgebraicClosure F))
      χ_S_alg (fun _ _ => Commute.all _ _)
  let χ_k := χ_k_alg.toRingHom

  have hχ_id : χ_k.comp (f_k.comp Algebra.TensorProduct.includeLeftRingHom) =
      RingHom.id (AlgebraicClosure F) := by
    rw [hfk_left]
    ext c
    exact χ_k_alg.commutes c

  have hχ_A' : ∀ a : A', χ_k (f_k (1 ⊗ₜ[F] a)) = algebraMap F (AlgebraicClosure F) (ε' a) := by
    intro a
    have h1 : χ_k (f_k (1 ⊗ₜ[F] a)) =
        (Algebra.TensorProduct.lift
          (Algebra.ofId (AlgebraicClosure F) (AlgebraicClosure F))
          χ_S_alg (fun _ _ => Commute.all _ _)) (1 ⊗ₜ[F] (ψ₁_s a)) := rfl
    rw [h1, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
    change σ_k (ε_S (ψ₁_s a)) = _
    rw [hε_S_left]
    exact σ_k.commutes (ε' a)

  
  obtain ⟨C_F, hRingCF, hAlgCF, x_F, hConeEquiv⟩ := hConePkg
  let _ : CommRing C_F := hRingCF
  let _ : Algebra F C_F := hAlgCF
  obtain ⟨ι_FE₁, e_CE₁, hι_FE₁_X, he_CE₁_right, _, _⟩ := hConeEquiv E₁
  obtain ⟨_, e_Ck, _, _, he_Ck_symm_C, he_Ck_symm_X⟩ := hConeEquiv (AlgebraicClosure F)

  have hι_FE₁_et : ι_FE₁.toRingHom.Etale := by
    let _ : PerfectField F := PerfectField.ofFinite
    have _ : Algebra.IsAlgebraic F E₁ := Algebra.IsAlgebraic.of_finite F E₁
    have _ : Algebra.IsSeparable F E₁ := Algebra.IsAlgebraic.isSeparable_of_perfectField
    have _ : Algebra.FormallyEtale F E₁ := Algebra.FormallyEtale.of_isSeparable F E₁
    have _ : Algebra.FiniteType F E₁ := Module.Finite.finiteType E₁
    have _ : Algebra.FinitePresentation F E₁ :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance
    have _ : Algebra.Etale F E₁ := Algebra.Etale.mk
    have _ : Algebra.Etale C_F (TensorProduct F C_F E₁) := Algebra.Etale.baseChange F E₁ C_F
    have hIncEt : (algebraMap C_F (TensorProduct F C_F E₁)).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
    have hCommEt : (Algebra.TensorProduct.comm F C_F E₁).toRingHom.Etale :=
      RingHom.Etale.of_bijective (Algebra.TensorProduct.comm F C_F E₁).bijective
    have heCE₁Et : e_CE₁.toRingHom.Etale :=
      RingHom.Etale.of_bijective e_CE₁.bijective
    have hEq : ι_FE₁.toRingHom =
        e_CE₁.toRingHom.comp
          ((Algebra.TensorProduct.comm F C_F E₁).toRingHom.comp
            (algebraMap C_F (TensorProduct F C_F E₁))) := by
      apply RingHom.ext
      intro x
      exact (he_CE₁_right x).symm
    rw [hEq]
    exact RingHom.Etale.stableUnderComposition _ _
      (RingHom.Etale.stableUnderComposition _ _ hIncEt hCommEt) heCE₁Et

  let g₂ : (MvPolynomial (Fin (m + 1) × Fin 2) E₁ ⧸ Ideal.span {h_poly E₁}) →+* S :=
    loc_B.comp ψ₂
  have hg₂_et : g₂.Etale := RingHom.Etale.stableUnderComposition _ _ hψ₂_et hloc_B_et
  let g₀ : C_F →+* S := g₂.comp ι_FE₁.toRingHom
  have hg₀_et : g₀.Etale := RingHom.Etale.stableUnderComposition _ _ hι_FE₁_et hg₂_et
  let g₀_alg : C_F →ₐ[F] S :=
    { toRingHom := g₀
      commutes' := fun c => by
        change g₂ (ι_FE₁ (algebraMap F C_F c)) = algebraMap F S c
        rw [halgMap_FS, ι_FE₁.commutes, IsScalarTower.algebraMap_apply F E₁
          (MvPolynomial (Fin (m + 1) × Fin 2) E₁ ⧸ Ideal.span {h_poly E₁})]
        change loc_B ((ψ₂.comp ((Ideal.Quotient.mk _).comp
          (MvPolynomial.C.comp (algebraMap F E₁)))) c) = loc_B ((ψ₁.comp alg_A₀) c)
        rw [← hψ_alg] }

  let G_k_alg : TensorProduct F (AlgebraicClosure F) C_F →ₐ[F] B''_k :=
    Algebra.TensorProduct.map (AlgHom.id F (AlgebraicClosure F)) g₀_alg
  have hG_k_et : G_k_alg.toRingHom.Etale :=
    hTensorMapEtale (AlgebraicClosure F) C_F S g₀_alg hg₀_et
  have heCk_et : e_Ck.symm.toRingHom.Etale :=
    RingHom.Etale.of_bijective e_Ck.symm.bijective
  let ψ_Ck := G_k_alg.toRingHom.comp e_Ck.symm.toRingHom
  have hψ_Ck_et : ψ_Ck.Etale :=
    RingHom.Etale.stableUnderComposition _ _ heCk_et hG_k_et

  have hfk_alg : f_k.comp Algebra.TensorProduct.includeLeftRingHom =
      ψ_Ck.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) := by
    rw [hfk_left]
    ext c
    change c ⊗ₜ[F] 1 = G_k_alg (e_Ck.symm (Ideal.Quotient.mk _ (MvPolynomial.C c)))
    rw [he_Ck_symm_C]
    change c ⊗ₜ[F] 1 =
      (Algebra.TensorProduct.map (AlgHom.id F (AlgebraicClosure F)) g₀_alg) (c ⊗ₜ[F] 1)
    rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one]

  have hψ_Ck_X : ∀ idx : Fin (m + 1) × Fin 2,
      ψ_Ck (Ideal.Quotient.mk _ (MvPolynomial.X idx)) =
        (1 : AlgebraicClosure F) ⊗ₜ[F] g₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx)) := by
    intro idx
    change G_k_alg (e_Ck.symm (Ideal.Quotient.mk _ (MvPolynomial.X idx))) = _
    rw [he_Ck_symm_X]
    change (Algebra.TensorProduct.map (AlgHom.id F (AlgebraicClosure F)) g₀_alg)
      ((1 : AlgebraicClosure F) ⊗ₜ[F] x_F idx) = _
    rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
    change (1 : AlgebraicClosure F) ⊗ₜ[F] g₂ (ι_FE₁ (x_F idx)) = _
    rw [hι_FE₁_X]

  
  let incR_A' : A' →+* TensorProduct F (AlgebraicClosure F) A' :=
    (Algebra.TensorProduct.includeRight :
      A' →ₐ[F] TensorProduct F (AlgebraicClosure F) A').toRingHom
  let incR_S : S →+* B''_k :=
    (Algebra.TensorProduct.includeRight : S →ₐ[F] B''_k).toRingHom
  have hfk_incR : f_k.comp incR_A' = incR_S.comp ψ₁_s := by
    ext a
    rfl
  have hSpan_Bk : Ideal.map f_k (Ideal.map incR_A' (RingHom.ker ε')) =
      Ideal.span (Set.range fun idx : Fin (m + 1) × Fin 2 =>
        ψ_Ck (Ideal.Quotient.mk _ (MvPolynomial.X idx))) := by
    rw [Ideal.map_map, hfk_incR, hker_ε', Ideal.map_map, RingHom.comp_assoc, hpush_comm,
      ← RingHom.comp_assoc, ← Ideal.map_map, hSpan_B₁, Ideal.map_span, ← Set.range_comp]
    congr 1
    ext z
    simp only [Set.mem_range, Function.comp_apply]
    constructor <;> rintro ⟨idx, rfl⟩ <;> refine ⟨idx, ?_⟩
    · exact hψ_Ck_X idx
    · exact (hψ_Ck_X idx).symm

  exact ⟨B''_k, inferInstance, f_k, ψ_Ck, χ_k, hf_k_et, hψ_Ck_et, hfk_alg, hχ_id, hχ_A', hSpan_Bk⟩

theorem weil_odp_flat_graded_quadric_descent_and_nakayama (F : Type u) [Field F]
    (m : ℕ)
    (A₀ : Type u) [CommRing A₀] [IsDomain A₀]
    (alg_A₀ : F →+* A₀) (hFT : alg_A₀.FiniteType)
    (ε₀ : A₀ →+* F) (hε_id : ε₀.comp alg_A₀ = RingHom.id F)
    (B₁ E₁ E'₁ : Type u) [CommRing B₁] [Field E₁] [Field E'₁]
    (alg_FE₁ : F →+* E₁) (alg_FE'₁ : F →+* E'₁) (alg_E₁E'₁ : E₁ →+* E'₁)
    (ψ₁ : A₀ →+* B₁) (hψ₁_flat : ψ₁.Flat)
    (ψ₂ : (MvPolynomial (Fin (m + 1) × Fin 2) E₁ ⧸
      Ideal.span {∑ j : Fin (m + 1),
        (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) E₁) *
          MvPolynomial.X (j, 1)}) →+* B₁)
    (hψ₂_flat : ψ₂.Flat)
    (ε_B₁ : B₁ →+* E'₁)
    (hSurj_ε : Function.Surjective ε_B₁)
    (hComp_E : alg_E₁E'₁.comp alg_FE₁ = alg_FE'₁)
    (hψ_alg : ψ₁.comp alg_A₀ =
      ψ₂.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C.comp alg_FE₁)))
    (hε_ψ₁ : ε_B₁.comp ψ₁ = alg_FE'₁.comp ε₀)
    (hε_ψ₂ : ∀ e : E₁, ε_B₁ (ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.C e))) = alg_E₁E'₁ e)
    (hker_εB₁ : RingHom.ker ε_B₁ = Ideal.map ψ₁ (RingHom.ker ε₀))
    (hSpan_B₁ : Ideal.map ψ₁ (RingHom.ker ε₀) =
      Ideal.span (Set.range fun idx : Fin (m + 1) × Fin 2 =>
        ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx)))) :
    let F_std : MvPolynomial (Fin (2 * m + 1 + 1)) E'₁ :=
      ∑ j : Fin (m + 1),
        (MvPolynomial.X ⟨2 * j.1, by omega⟩ : MvPolynomial (Fin (2 * m + 1 + 1)) E'₁) *
          MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩
    ∃ (s₀ : A₀) (_hs₀ : ε₀ s₀ ≠ 0)
      (Q₀ : MvPolynomial (Fin (2 * m + 1 + 1)) F),
      Q₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) F 2 ∧
      (∃ (L_inv R_inv : Matrix (Fin (2 * m + 1 + 1)) (Fin (2 * m + 1 + 1)) E'₁)
          (c_scale : E'₁),
        L_inv * R_inv = 1 ∧
        c_scale ≠ 0 ∧
        MvPolynomial.map alg_FE'₁ Q₀ =
          MvPolynomial.C c_scale *
            MvPolynomial.eval₂ MvPolynomial.C
              (fun a => ∑ b : Fin (2 * m + 1 + 1),
                MvPolynomial.C (L_inv a b) * MvPolynomial.X b) F_std) ∧
      (∀ (A' : Type u) [CommRing A'] (loc : A₀ →+* A'),
        @IsLocalization.Away A₀ _ s₀ A' _ loc.toAlgebra →
        let alg_A' : F →+* A' := loc.comp alg_A₀
        letI : Algebra F A' := alg_A'.toAlgebra
        ∃ (ε' : A' →+* F) (y : Fin (2 * m + 1 + 1) → A')
          (_hε'_id : ε'.comp alg_A' = RingHom.id F),
          ε'.comp loc = ε₀ ∧
          RingHom.ker ε' = Ideal.span (Set.range y) ∧
          (∀ b : Fin (2 * m + 1 + 1), y b ≠ 0) ∧
          ∀ (K : Type u) [Field K] [Algebra F K]
            (d : ℕ) (P : MvPolynomial (Fin (2 * m + 1 + 1)) K),
            P ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) K d →
            (MvPolynomial.eval₂ Algebra.TensorProduct.includeLeftRingHom
              (fun a => (1 : K) ⊗ₜ[F] y a) P ∈
              (Ideal.span (Set.range fun a : Fin (2 * m + 1 + 1) =>
                (1 : K) ⊗ₜ[F] y a)) ^ (d + 1) ↔
              P ∈ Ideal.span {MvPolynomial.map (algebraMap F K) Q₀})) :=
by
  
  
  
  have homog_mul_comp_lt : ∀ {σ : Type} {R : Type u} [CommSemiring R]
      {Q : MvPolynomial σ R} {m₀ d : ℕ},
      Q.IsHomogeneous m₀ → d < m₀ → ∀ (G : MvPolynomial σ R),
      MvPolynomial.homogeneousComponent d (Q * G) = 0 := by
    intro σ R _ Q m₀ d hQ hd G
    classical
    ext s
    rw [MvPolynomial.coeff_homogeneousComponent]
    change (if Finsupp.degree s = d then (Q * G).coeff s else 0) = 0
    split_ifs with hs
    · rw [MvPolynomial.coeff_mul]
      apply Finset.sum_eq_zero
      intro p hp
      have hp_eq : p.1 + p.2 = s := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
      have hdeg : Finsupp.degree p.1 + Finsupp.degree p.2 = d := by
        rw [← map_add, hp_eq, hs]
      have hp1_ne : Finsupp.degree p.1 ≠ m₀ := by omega
      rw [hQ.coeff_eq_zero hp1_ne, zero_mul]
    · rfl

  have homog_mul_comp_le : ∀ {σ : Type} {R : Type u} [CommSemiring R]
      {Q : MvPolynomial σ R} {m₀ d : ℕ},
      Q.IsHomogeneous m₀ → m₀ ≤ d → ∀ (G : MvPolynomial σ R),
      MvPolynomial.homogeneousComponent d (Q * G) =
        Q * MvPolynomial.homogeneousComponent (d - m₀) G := by
    intro σ R _ Q m₀ d hQ hd G
    classical
    ext s
    rw [MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_mul, MvPolynomial.coeff_mul]
    by_cases hs : Finsupp.degree s = d
    · simp only [hs, ↓reduceIte]
      apply Finset.sum_congr rfl
      intro p hp
      have hp_eq : p.1 + p.2 = s := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
      by_cases hc : Q.coeff p.1 = 0
      · rw [hc, zero_mul, zero_mul]
      · have hp1 : Finsupp.degree p.1 = m₀ := by
          by_contra hne
          exact hc (hQ.coeff_eq_zero hne)
        have hp2 : Finsupp.degree p.2 = d - m₀ := by
          have hdeg : Finsupp.degree p.1 + Finsupp.degree p.2 = d := by
            rw [← map_add, hp_eq, hs]
          omega
        rw [MvPolynomial.coeff_homogeneousComponent]
        simp only [hp2, ↓reduceIte]
    · simp only [hs, ↓reduceIte]
      symm
      apply Finset.sum_eq_zero
      intro p hp
      have hp_eq : p.1 + p.2 = s := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
      by_cases hc : Q.coeff p.1 = 0
      · rw [hc, zero_mul]
      · have hp1 : Finsupp.degree p.1 = m₀ := by
          by_contra hne
          exact hc (hQ.coeff_eq_zero hne)
        have hp2 : Finsupp.degree p.2 ≠ d - m₀ := by
          intro heq
          apply hs
          rw [← hp_eq, map_add, hp1, heq]
          omega
        rw [MvPolynomial.coeff_homogeneousComponent]
        simp only [hp2, ↓reduceIte, mul_zero]

  have homog_mem_span_quad : ∀ {σ : Type} {R : Type u} [CommRing R]
      {Q P : MvPolynomial σ R} {d : ℕ},
      Q ∈ MvPolynomial.homogeneousSubmodule σ R 2 →
      P ∈ MvPolynomial.homogeneousSubmodule σ R d →
      P ∈ Ideal.span {Q} →
      (d < 2 ∧ P = 0) ∨
      (2 ≤ d ∧ ∃ H ∈ MvPolynomial.homogeneousSubmodule σ R (d - 2), P = Q * H) := by
    intro σ R _ Q P d hQ hP hmem
    rw [Ideal.mem_span_singleton] at hmem
    rcases hmem with ⟨G, rfl⟩
    rw [MvPolynomial.mem_homogeneousSubmodule] at hQ
    have hP_comp : MvPolynomial.homogeneousComponent d (Q * G) = Q * G := by
      rw [MvPolynomial.homogeneousComponent_of_mem hP]
      simp
    by_cases hd : d < 2
    · left
      refine ⟨hd, ?_⟩
      rw [← hP_comp, homog_mul_comp_lt hQ hd G]
    · right
      have hd2 : 2 ≤ d := by omega
      refine ⟨hd2, MvPolynomial.homogeneousComponent (d - 2) G, ?_, ?_⟩
      · rw [MvPolynomial.mem_homogeneousSubmodule]
        exact MvPolynomial.homogeneousComponent_isHomogeneous (d - 2) G
      · rw [← hP_comp, homog_mul_comp_le hQ hd2 G]

  have finsupp_prod_mem_pow : ∀ {σ : Type} {A : Type u} [CommRing A]
      (I : Ideal A) (w : σ → A),
      (∀ a, w a ∈ I) → ∀ (s : σ →₀ ℕ),
      (s.prod fun a e => w a ^ e) ∈ I ^ (Finsupp.degree s) := by
    intro σ A _ I w hw s
    classical
    refine Finsupp.induction s ?_ ?_
    · simp [Ideal.one_eq_top]
    · intro a b s' _ _ ih
      have hprod : ((Finsupp.single a b + s').prod fun x e => w x ^ e) =
          w a ^ b * (s'.prod fun x e => w x ^ e) := by
        rw [Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _),
          Finsupp.prod_single_index (h := fun x e => w x ^ e) (pow_zero _)]
      rw [hprod, map_add, Finsupp.degree_single, pow_add]
      exact Ideal.mul_mem_mul (Ideal.pow_mem_pow (hw a) b) ih

  have eval₂_mem_pow_of_homog : ∀ {σ : Type} {K₀ A : Type u} [CommSemiring K₀] [CommRing A]
      (φ : K₀ →+* A) (I : Ideal A) (w : σ → A),
      (∀ a, w a ∈ I) → ∀ {d : ℕ} {P : MvPolynomial σ K₀},
      P ∈ MvPolynomial.homogeneousSubmodule σ K₀ d →
      MvPolynomial.eval₂ φ w P ∈ I ^ d := by
    intro σ K₀ A _ _ φ I w hw d P hP
    rw [MvPolynomial.mem_homogeneousSubmodule] at hP
    have hP_sum : MvPolynomial.eval₂ φ w P =
        ∑ s ∈ P.support, MvPolynomial.eval₂ φ w (MvPolynomial.monomial s (P.coeff s)) := by
      change (MvPolynomial.eval₂Hom φ w) P =
        ∑ s ∈ P.support, (MvPolynomial.eval₂Hom φ w) (MvPolynomial.monomial s (P.coeff s))
      conv_lhs => rw [MvPolynomial.as_sum P]
      exact map_sum (MvPolynomial.eval₂Hom φ w) _ P.support
    rw [hP_sum]
    refine Submodule.sum_mem _ fun s hs => ?_
    rw [MvPolynomial.eval₂_monomial]
    have hs_deg : Finsupp.degree s = d := by
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp hs) (hP.coeff_eq_zero hne)
    rw [← hs_deg]
    exact Ideal.mul_mem_left _ _ (finsupp_prod_mem_pow I w hw s)

  have homogeneousComponent_eq_zero_of_mem_span_X_pow : ∀ {σ : Type} {R : Type u} [CommRing R]
      (n : ℕ) {f : MvPolynomial σ R},
      f ∈ (Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R))) ^ n →
      ∀ k < n, MvPolynomial.homogeneousComponent k f = 0 := by
    intro σ R _
    classical
    let J : ℕ → Ideal (MvPolynomial σ R) := fun n =>
      { carrier := { f : MvPolynomial σ R | ∀ (s : σ →₀ ℕ), Finsupp.degree s < n → f.coeff s = 0 }
        zero_mem' := fun _ _ => rfl
        add_mem' := fun {f g} hf hg s hs => by
          change (f + g).coeff s = 0
          rw [AddMonoidAlgebra.coeff_add, Finsupp.add_apply, hf s hs, hg s hs, add_zero]
        smul_mem' := fun c {f} hf s hs => by
          change (c * f).coeff s = 0
          rw [MvPolynomial.coeff_mul]
          apply Finset.sum_eq_zero
          intro p hp
          have hp_eq : p.1 + p.2 = s := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
          have hp2 : Finsupp.degree p.2 < n := by
            have : Finsupp.degree p.1 + Finsupp.degree p.2 = Finsupp.degree s := by
              rw [← map_add, hp_eq]
            omega
          rw [hf p.2 hp2, mul_zero] }
    have hM_le : Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R)) ≤ J 1 := by
      rw [Ideal.span_le]
      rintro _ ⟨a, rfl⟩ s hs
      have hXa : (MvPolynomial.X a : MvPolynomial σ R).IsHomogeneous 1 :=
        MvPolynomial.isHomogeneous_X R a
      have hne : Finsupp.degree s ≠ 1 := by omega
      exact hXa.coeff_eq_zero hne
    have hMul_le : ∀ n, J 1 * J n ≤ J (n + 1) := by
      intro n
      rw [Submodule.mul_le]
      intro f hf g hg s hs
      change (f * g).coeff s = 0
      rw [MvPolynomial.coeff_mul]
      apply Finset.sum_eq_zero
      intro p hp
      have hp_eq : p.1 + p.2 = s := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
      have hsum : Finsupp.degree p.1 + Finsupp.degree p.2 = Finsupp.degree s := by
        rw [← map_add, hp_eq]
      by_cases hp1 : Finsupp.degree p.1 < 1
      · rw [hf p.1 hp1, zero_mul]
      · have hp2 : Finsupp.degree p.2 < n := by omega
        rw [hg p.2 hp2, mul_zero]
    have hPow_le : ∀ n,
        (Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R))) ^ n ≤ J n := by
      intro n
      induction n with
      | zero =>
        rw [pow_zero, Ideal.one_eq_top]
        intro f _ s hs
        omega
      | succ n ih =>
        rw [pow_succ', Submodule.mul_le]
        intro a ha b hb
        exact hMul_le n (Submodule.mul_mem_mul (hM_le ha) (ih hb))
    intro n f hf k hk
    have hfJ := hPow_le n hf
    ext s
    rw [MvPolynomial.coeff_homogeneousComponent]
    change (if Finsupp.degree s = k then f.coeff s else 0) = 0
    split_ifs with hs
    · exact hfJ s (by omega)
    · rfl

  
  
  
  let H_cone : MvPolynomial (Fin (m + 1) × Fin 2) E₁ :=
    ∑ j : Fin (m + 1),
      (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) E₁) *
        MvPolynomial.X (j, 1)
  let C₁ := MvPolynomial (Fin (m + 1) × Fin 2) E₁ ⧸ Ideal.span {H_cone}
  let x_model : Fin (2 * m + 1 + 1) → C₁ := fun a =>
    Ideal.Quotient.mk _ (MvPolynomial.X (⟨a.1 / 2, by omega⟩, ⟨a.1 % 2, by omega⟩))
  let F_std_E₁ : MvPolynomial (Fin (2 * m + 1 + 1)) E₁ :=
    ∑ j : Fin (m + 1),
      (MvPolynomial.X ⟨2 * j.1, by omega⟩ : MvPolynomial (Fin (2 * m + 1 + 1)) E₁) *
        MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩

  have hConePkg :
      (F_std_E₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) E₁ 2 ∧
        F_std_E₁ ≠ 0) ∧
      ∃ (ε_C₁ : C₁ →+* E₁),
        ε_C₁.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = RingHom.id E₁ ∧
        RingHom.ker ε_C₁ = Ideal.span (Set.range fun idx : Fin (m + 1) × Fin 2 =>
          (Ideal.Quotient.mk (Ideal.span {H_cone})) (MvPolynomial.X idx)) ∧
        RingHom.ker ε_C₁ = Ideal.span (Set.range x_model) ∧
        ∀ (d : ℕ) (P : MvPolynomial (Fin (2 * m + 1 + 1)) E₁),
          P ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) E₁ d →
          (MvPolynomial.eval₂ ((Ideal.Quotient.mk _).comp MvPolynomial.C) x_model P ∈
            (RingHom.ker ε_C₁) ^ (d + 1) ↔ P ∈ Ideal.span {F_std_E₁}) := by
    have hF_hom : F_std_E₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) E₁ 2 := by
      refine Submodule.sum_mem _ fun j _ => ?_
      rw [MvPolynomial.mem_homogeneousSubmodule]
      exact (MvPolynomial.isHomogeneous_X E₁ _).mul (MvPolynomial.isHomogeneous_X E₁ _)
    have hF_ne : F_std_E₁ ≠ 0 := by
      let w₀ : Fin (2 * m + 1 + 1) → E₁ := fun b => if b.1 < 2 then 1 else 0
      intro h0
      have hev : MvPolynomial.eval w₀ F_std_E₁ = 1 := by
        dsimp [F_std_E₁]
        rw [map_sum, Finset.sum_eq_single (0 : Fin (m + 1))]
        · simp [w₀]
        · intro j _ hj
          have hj0 : j.1 ≠ 0 := Fin.val_ne_of_ne hj
          have hge : ¬ (2 * j.1 < 2) := by omega
          rw [map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X]
          dsimp [w₀]
          simp only [hge, ↓reduceIte, zero_mul]
        · intro habs
          exact False.elim (habs (Finset.mem_univ _))
      rw [h0, map_zero] at hev
      exact zero_ne_one hev
    have hH_const : MvPolynomial.constantCoeff H_cone = 0 := by
      dsimp [H_cone]
      rw [map_sum]
      apply Finset.sum_eq_zero
      intro j _
      rw [map_mul, MvPolynomial.constantCoeff_X, zero_mul]
    have hSpan_le_ker : Ideal.span {H_cone} ≤ RingHom.ker MvPolynomial.constantCoeff := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      exact hH_const
    let ε_C₁ : C₁ →+* E₁ := Ideal.Quotient.lift (Ideal.span {H_cone}) MvPolynomial.constantCoeff
      (fun _ ha => hSpan_le_ker ha)
    have hε_id_C : ε_C₁.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = RingHom.id E₁ := by
      ext e
      change MvPolynomial.constantCoeff
        (MvPolynomial.C e : MvPolynomial (Fin (m + 1) × Fin 2) E₁) = e
      simp
    have hKer_const : RingHom.ker (MvPolynomial.constantCoeff :
        MvPolynomial (Fin (m + 1) × Fin 2) E₁ →+* E₁) =
        Ideal.span (Set.range MvPolynomial.X) := by
      apply le_antisymm
      · intro f hf
        have hf0 : f.coeff 0 = 0 := hf
        rw [MvPolynomial.as_sum f]
        refine Submodule.sum_mem _ fun s hs => ?_
        have hs0 : s ≠ 0 := by
          intro h0
          subst h0
          exact (MvPolynomial.mem_support_iff.mp hs) hf0
        have hex : ∃ idx, s idx ≠ 0 := by
          by_contra hall
          apply hs0
          ext idx
          by_contra hne
          exact hall ⟨idx, hne⟩
        rcases hex with ⟨idx, hidx⟩
        let s' : (Fin (m + 1) × Fin 2) →₀ ℕ := s - Finsupp.single idx 1
        have hs_eq : Finsupp.single idx 1 + s' = s := by
          ext idx'
          dsimp [s']
          by_cases h : idx = idx'
          · subst h
            simp only [Finsupp.single_eq_same]
            omega
          · simp [h]
        have hmon : MvPolynomial.monomial s (f.coeff s) =
            MvPolynomial.X idx * MvPolynomial.monomial s' (f.coeff s) := by
          rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, hs_eq, one_mul]
        rw [hmon]
        exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨idx, rfl⟩)
      · rw [Ideal.span_le]
        rintro _ ⟨idx, rfl⟩
        simp
    have hker_idx : RingHom.ker ε_C₁ = Ideal.span (Set.range fun idx : Fin (m + 1) × Fin 2 =>
        (Ideal.Quotient.mk (Ideal.span {H_cone})) (MvPolynomial.X idx)) := by
      have hmap : Ideal.span (Set.range fun idx : Fin (m + 1) × Fin 2 =>
          (Ideal.Quotient.mk (Ideal.span {H_cone})) (MvPolynomial.X idx)) =
          Ideal.map (Ideal.Quotient.mk (Ideal.span {H_cone}))
            (Ideal.span (Set.range MvPolynomial.X)) := by
        rw [Ideal.map_span, ← Set.range_comp]
        rfl
      rw [hmap, ← hKer_const]
      apply le_antisymm
      · intro z hz
        rcases Ideal.Quotient.mk_surjective z with ⟨f, rfl⟩
        exact Ideal.mem_map_of_mem _ hz
      · rw [Ideal.map_le_iff_le_comap]
        intro f hf
        exact hf
    let e_idx : Fin (2 * m + 1 + 1) ≃ Fin (m + 1) × Fin 2 :=
      { toFun := fun a => (⟨a.1 / 2, by omega⟩, ⟨a.1 % 2, by omega⟩)
        invFun := fun p => ⟨2 * p.1.1 + p.2.1, by omega⟩
        left_inv := fun a => by ext; dsimp; omega
        right_inv := fun ⟨j, c⟩ => by ext <;> dsimp <;> omega }
    have hrange_x : Set.range x_model = Set.range (fun idx : Fin (m + 1) × Fin 2 =>
        (Ideal.Quotient.mk (Ideal.span {H_cone})) (MvPolynomial.X idx)) := by
      ext z
      simp only [Set.mem_range]
      constructor
      · rintro ⟨a, rfl⟩
        exact ⟨e_idx a, rfl⟩
      · rintro ⟨idx, rfl⟩
        refine ⟨e_idx.symm idx, ?_⟩
        change Ideal.Quotient.mk _ (MvPolynomial.X (e_idx (e_idx.symm idx))) = _
        rw [e_idx.apply_symm_apply]
    have hker_x : RingHom.ker ε_C₁ = Ideal.span (Set.range x_model) := by
      rw [hrange_x, hker_idx]
    refine ⟨⟨hF_hom, hF_ne⟩, ε_C₁, hε_id_C, hker_idx, hker_x, ?_⟩
    intro d P hP
    let ρ : MvPolynomial (Fin (2 * m + 1 + 1)) E₁ ≃ₐ[E₁] MvPolynomial (Fin (m + 1) × Fin 2) E₁ :=
      MvPolynomial.renameEquiv E₁ e_idx
    let π_C : MvPolynomial (Fin (2 * m + 1 + 1)) E₁ →+* C₁ :=
      (Ideal.Quotient.mk (Ideal.span {H_cone})).comp ρ.toRingHom
    have heval_eq : MvPolynomial.eval₂ ((Ideal.Quotient.mk (Ideal.span {H_cone})).comp MvPolynomial.C)
        x_model P = π_C P := by
      let evHom : MvPolynomial (Fin (2 * m + 1 + 1)) E₁ →+* C₁ :=
        MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (Ideal.span {H_cone})).comp MvPolynomial.C) x_model
      change evHom P = π_C P
      suffices heq : evHom = π_C by rw [heq]
      apply MvPolynomial.ringHom_ext
      · intro c; simp [evHom, π_C, ρ]
      · intro a; simp [evHom, π_C, ρ, x_model, e_idx]
    rw [heval_eq]
    have hρ_F : ρ F_std_E₁ = H_cone := by
      dsimp [F_std_E₁, H_cone, ρ]
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro j _
      rw [map_mul, MvPolynomial.renameEquiv_apply, MvPolynomial.renameEquiv_apply,
        MvPolynomial.rename_X, MvPolynomial.rename_X]
      have h0 : e_idx ⟨2 * j.1, by omega⟩ = (j, 0) := by ext <;> dsimp [e_idx] <;> omega
      have h1 : e_idx ⟨2 * j.1 + 1, by omega⟩ = (j, 1) := by ext <;> dsimp [e_idx] <;> omega
      rw [h0, h1]
    have hker_π : RingHom.ker π_C = Ideal.span {F_std_E₁} := by
      ext f
      rw [RingHom.mem_ker]
      change Ideal.Quotient.mk (Ideal.span {H_cone}) (ρ f) = 0 ↔ _
      rw [Ideal.Quotient.eq_zero_iff_mem, ← hρ_F, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
      constructor
      · rintro ⟨G, hG⟩
        refine ⟨ρ.symm G, ?_⟩
        apply ρ.injective
        rw [map_mul, hG, ρ.apply_symm_apply]
      · rintro ⟨G, rfl⟩
        exact ⟨ρ G, map_mul ρ _ _⟩
    let 𝔐 : Ideal (MvPolynomial (Fin (2 * m + 1 + 1)) E₁) :=
      Ideal.span (Set.range MvPolynomial.X)
    have hmap_M : Ideal.map π_C 𝔐 = RingHom.ker ε_C₁ := by
      rw [hker_x]
      dsimp [𝔐]
      rw [Ideal.map_span, ← Set.range_comp]
      congr 1
      ext z
      simp [π_C, ρ, x_model, e_idx]
    have hsurj_π : Function.Surjective π_C :=
      Ideal.Quotient.mk_surjective.comp ρ.surjective
    constructor
    · intro hmem_pow
      rw [← hmap_M, ← Ideal.map_pow] at hmem_pow
      rw [Ideal.mem_map_iff_of_surjective π_C hsurj_π] at hmem_pow
      rcases hmem_pow with ⟨R_rem, hR_mem, hR_eq⟩
      have hsub : P - R_rem ∈ RingHom.ker π_C := by
        rw [RingHom.mem_ker, map_sub, hR_eq, sub_self]
      rw [hker_π, Ideal.mem_span_singleton] at hsub
      rcases hsub with ⟨G, hG⟩
      have hP_eq : P = F_std_E₁ * G + R_rem := by
        calc P = P - R_rem + R_rem := (sub_add_cancel P R_rem).symm
        _ = F_std_E₁ * G + R_rem := by rw [hG]
      have hR_comp : MvPolynomial.homogeneousComponent d R_rem = 0 :=
        homogeneousComponent_eq_zero_of_mem_span_X_pow (d + 1) hR_mem d (Nat.lt_succ_self d)
      have hP_comp : MvPolynomial.homogeneousComponent d P = P := by
        rw [MvPolynomial.homogeneousComponent_of_mem hP]
        simp
      have hFG_comp : P = MvPolynomial.homogeneousComponent d (F_std_E₁ * G) := by
        conv_lhs => rw [← hP_comp, hP_eq]
        rw [map_add, hR_comp, add_zero]
      rw [MvPolynomial.mem_homogeneousSubmodule] at hF_hom
      by_cases hd : d < 2
      · rw [hFG_comp, homog_mul_comp_lt hF_hom hd G]
        exact Ideal.zero_mem _
      · have hd2 : 2 ≤ d := by omega
        rw [hFG_comp, homog_mul_comp_le hF_hom hd2 G, Ideal.mem_span_singleton]
        exact ⟨_, rfl⟩
    · intro hmem_span
      rw [← hker_π, RingHom.mem_ker] at hmem_span
      rw [hmem_span]
      exact Ideal.zero_mem _

  
  
  
  have linear_eval₂_comp_eq_id : ∀ {N : ℕ} {L : Type u} [CommRing L]
      (M₁ M₂ : Matrix (Fin N) (Fin N) L), M₁ * M₂ = 1 →
      (MvPolynomial.eval₂Hom MvPolynomial.C
        (fun a : Fin N => ∑ b : Fin N, MvPolynomial.C (M₂ a b) * MvPolynomial.X b)).comp
      (MvPolynomial.eval₂Hom MvPolynomial.C
        (fun a : Fin N => ∑ b : Fin N, MvPolynomial.C (M₁ a b) * MvPolynomial.X b)) =
      RingHom.id (MvPolynomial (Fin N) L) := by
    intro N L _ M₁ M₂ hM
    apply MvPolynomial.ringHom_ext
    · intro c; simp
    · intro a
      simp only [RingHom.comp_apply, RingHom.id_apply, MvPolynomial.coe_eval₂Hom,
        MvPolynomial.eval₂_X]
      change (MvPolynomial.eval₂Hom MvPolynomial.C
        (fun i : Fin N => ∑ c : Fin N, MvPolynomial.C (M₂ i c) * MvPolynomial.X c))
        (∑ b : Fin N, MvPolynomial.C (M₁ a b) * MvPolynomial.X b) = MvPolynomial.X a
      rw [map_sum]
      have hterm : ∀ b : Fin N,
          (MvPolynomial.eval₂Hom MvPolynomial.C
            (fun i : Fin N => ∑ c : Fin N, MvPolynomial.C (M₂ i c) * MvPolynomial.X c))
            (MvPolynomial.C (M₁ a b) * MvPolynomial.X b) =
          ∑ c : Fin N, MvPolynomial.C (M₁ a b * M₂ b c) * MvPolynomial.X c := by
        intro b
        rw [map_mul, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C, MvPolynomial.eval₂_X,
          Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro c _
        rw [← mul_assoc, ← MvPolynomial.C_mul]
      simp_rw [hterm]
      rw [Finset.sum_comm]
      have hinner : ∀ c : Fin N,
          (∑ b : Fin N, MvPolynomial.C (M₁ a b * M₂ b c) * MvPolynomial.X c) =
          MvPolynomial.C ((M₁ * M₂) a c) * MvPolynomial.X c := by
        intro c
        rw [← Finset.sum_mul, ← map_sum, Matrix.mul_apply]
      simp_rw [hinner, hM]
      rw [Finset.sum_eq_single a]
      · simp
      · intro c _ hca
        rw [Matrix.one_apply_ne hca.symm, map_zero, zero_mul]
      · intro habs
        exact False.elim (habs (Finset.mem_univ a))

  have finsupp_prod_sub_mem_pow_succ : ∀ {σ : Type} {S : Type u} [CommRing S]
      (I : Ideal S) (u w : σ → S),
      (∀ a, u a ∈ I) → (∀ a, w a ∈ I) → (∀ a, u a - w a ∈ I ^ 2) →
      ∀ (s : σ →₀ ℕ),
      (s.prod fun a e => u a ^ e) - (s.prod fun a e => w a ^ e) ∈ I ^ (Finsupp.degree s + 1) := by
    intro σ S _ I u w hu hw hsub s
    have hmul_step : ∀ (k₁ k₂ : ℕ) {a₁ b₁ a₂ b₂ : S},
        a₁ ∈ I ^ k₁ → b₂ ∈ I ^ k₂ →
        a₁ - b₁ ∈ I ^ (k₁ + 1) → a₂ - b₂ ∈ I ^ (k₂ + 1) →
        a₁ * a₂ - b₁ * b₂ ∈ I ^ (k₁ + k₂ + 1) := by
      intro k₁ k₂ a₁ b₁ a₂ b₂ ha₁ hb₂ hd₁ hd₂
      have hid : a₁ * a₂ - b₁ * b₂ = a₁ * (a₂ - b₂) + (a₁ - b₁) * b₂ := by ring
      rw [hid]
      have ht₁ : a₁ * (a₂ - b₂) ∈ I ^ (k₁ + k₂ + 1) := by
        have h := Ideal.mul_mem_mul ha₁ hd₂
        rwa [← pow_add, show k₁ + (k₂ + 1) = k₁ + k₂ + 1 by omega] at h
      have ht₂ : (a₁ - b₁) * b₂ ∈ I ^ (k₁ + k₂ + 1) := by
        have h := Ideal.mul_mem_mul hd₁ hb₂
        rwa [← pow_add, show (k₁ + 1) + k₂ = k₁ + k₂ + 1 by omega] at h
      exact (I ^ (k₁ + k₂ + 1)).add_mem ht₁ ht₂
    have hpow_step : ∀ (a : σ) (e : ℕ), u a ^ e - w a ^ e ∈ I ^ (e + 1) := by
      intro a e
      induction e with
      | zero => simp
      | succ e ih =>
        rw [pow_succ (u a), pow_succ (w a)]
        have hw1 : w a ∈ I ^ 1 := (pow_one I).symm ▸ hw a
        have hu1 : u a - w a ∈ I ^ (1 + 1) := hsub a
        exact hmul_step e 1 (Ideal.pow_mem_pow (hu a) e) hw1 ih hu1
    classical
    refine Finsupp.induction s ?_ ?_
    · simp
    · intro a b s' _ _ ih
      rw [Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _),
        Finsupp.prod_single_index (h := fun x e => u x ^ e) (pow_zero _),
        Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _),
        Finsupp.prod_single_index (h := fun x e => w x ^ e) (pow_zero _),
        map_add, Finsupp.degree_single]
      exact hmul_step b (Finsupp.degree s') (Ideal.pow_mem_pow (hu a) b)
        (finsupp_prod_mem_pow I w hw s') (hpow_step a b) ih

  have hFlatRoofTransfer : ∀ (K₁ K₂ L : Type u) [Field K₁] [Field K₂] [Field L]
      (ι₁ : K₁ →+* L) (ι₂ : K₂ →+* L) (N : ℕ)
      (R₁ R₂ S : Type u) [CommRing R₁] [CommRing R₂] [CommRing S]
      (alg₁ : K₁ →+* R₁) (ε₁ : R₁ →+* K₁) (_ : ε₁.comp alg₁ = RingHom.id K₁)
      (alg₂ : K₂ →+* R₂) (ε₂ : R₂ →+* K₂) (_ : ε₂.comp alg₂ = RingHom.id K₂)
      (ε_S : S →+* L) (_ : Function.Surjective ε_S)
      (ψ₁₀ : R₁ →+* S) (_ : ψ₁₀.Flat)
      (ψ₂₀ : R₂ →+* S) (_ : ψ₂₀.Flat)
      (_ : ε_S.comp ψ₁₀ = ι₁.comp ε₁)
      (_ : ε_S.comp ψ₂₀ = ι₂.comp ε₂)
      (_ : RingHom.ker ε_S = Ideal.map ψ₁₀ (RingHom.ker ε₁))
      (_ : RingHom.ker ε_S = Ideal.map ψ₂₀ (RingHom.ker ε₂))
      (x₂ : Fin N → R₂) (_ : RingHom.ker ε₂ = Ideal.span (Set.range x₂))
      (F₂ : MvPolynomial (Fin N) K₂)
      (_ : F₂ ∈ MvPolynomial.homogeneousSubmodule (Fin N) K₂ 2)
      (_ : F₂ ≠ 0)
      (_ : ∀ (d : ℕ) (P₂ : MvPolynomial (Fin N) K₂),
        P₂ ∈ MvPolynomial.homogeneousSubmodule (Fin N) K₂ d →
        (MvPolynomial.eval₂ alg₂ x₂ P₂ ∈ (RingHom.ker ε₂) ^ (d + 1) ↔
          P₂ ∈ Ideal.span {F₂})),
      ∃ (y₀ : Fin N → R₁) (Q₀ : MvPolynomial (Fin N) K₁)
        (L_inv R_inv : Matrix (Fin N) (Fin N) L) (c_scale : L),
        (∀ a : Fin N, y₀ a ∈ RingHom.ker ε₁) ∧
        RingHom.ker ε₁ ≤ Ideal.span (Set.range y₀) ⊔ (RingHom.ker ε₁) • (RingHom.ker ε₁) ∧
        (∀ a : Fin N, y₀ a ≠ 0) ∧
        Q₀ ∈ MvPolynomial.homogeneousSubmodule (Fin N) K₁ 2 ∧
        (L_inv * R_inv = 1 ∧ c_scale ≠ 0 ∧
          MvPolynomial.map ι₁ Q₀ =
            MvPolynomial.C c_scale *
              MvPolynomial.eval₂ MvPolynomial.C
                (fun a => ∑ b : Fin N, MvPolynomial.C (L_inv a b) * MvPolynomial.X b)
                (MvPolynomial.map ι₂ F₂)) ∧
        (∀ (d : ℕ) (P₁ : MvPolynomial (Fin N) K₁),
          P₁ ∈ MvPolynomial.homogeneousSubmodule (Fin N) K₁ d →
          (MvPolynomial.eval₂ alg₁ y₀ P₁ ∈ (RingHom.ker ε₁) ^ (d + 1) ↔
            P₁ ∈ Ideal.span {Q₀})) := by
    intro K₁ K₂ L _ _ _ ι₁ ι₂ N R₁ R₂ S _ _ _ alg₁ ε₁ hε₁_id alg₂ ε₂ hε₂_id
      ε_S hSurj_S ψ₁₀ hψ₁₀_flat ψ₂₀ hψ₂₀_flat hComp₁ hComp₂ hMap₁ hMap₂
      x₂ hx₂_span F₂ hF₂_hom hF₂_ne hF₂_iff
    classical
    let grSub : ∀ {K₀ R₀ : Type u} [Field K₀] [CommRing R₀] (ε : R₀ →+* K₀) (d : ℕ),
        Submodule R₀ (R₀ ⧸ (RingHom.ker ε) ^ (d + 1)) :=
      fun {_ _} _ _ ε d =>
        LinearMap.ker (Submodule.factor
          (Ideal.pow_le_pow_right (Nat.le_succ d) :
            (RingHom.ker ε) ^ (d + 1) ≤ (RingHom.ker ε) ^ d))
    have hMemGr : ∀ {K₀ R₀ : Type u} [Field K₀] [CommRing R₀] (ε : R₀ →+* K₀) (d : ℕ) (r : R₀),
        Ideal.Quotient.mk ((RingHom.ker ε) ^ (d + 1)) r ∈ grSub ε d ↔
          r ∈ (RingHom.ker ε) ^ d := by
      intro K₀ R₀ _ _ ε d r
      change Submodule.factor _ (((RingHom.ker ε) ^ (d + 1)).mkQ r) = 0 ↔ _
      rw [Submodule.factor_mk]
      exact Ideal.Quotient.eq_zero_iff_mem
    have hAnnGr : ∀ {K₀ R₀ : Type u} [Field K₀] [CommRing R₀] (ε : R₀ →+* K₀) (d : ℕ)
        {m₀ : R₀}, m₀ ∈ RingHom.ker ε → ∀ (v : ↥(grSub ε d)), m₀ • v = 0 := by
      intro K₀ R₀ _ _ ε d m₀ hm ⟨q, hq⟩
      rcases Ideal.Quotient.mk_surjective q with ⟨r, rfl⟩
      have hr : r ∈ (RingHom.ker ε) ^ d := (hMemGr ε d r).mp hq
      apply Subtype.ext
      change Ideal.Quotient.mk ((RingHom.ker ε) ^ (d + 1)) (m₀ * r) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, pow_succ']
      exact Ideal.mul_mem_mul hm hr
    let mkGrMod : ∀ {K₀ R₀ : Type u} [Field K₀] [CommRing R₀] (ε : R₀ →+* K₀)
        (hSurj : Function.Surjective ε) (d : ℕ), Module K₀ ↥(grSub ε d) :=
      fun {K₀ R₀} _ _ ε hSurj d =>
        let smulFun : K₀ → ↥(grSub ε d) → ↥(grSub ε d) :=
          fun c v => (Function.surjInv hSurj c) • v
        have hsmul_eps : ∀ (r : R₀) (v : ↥(grSub ε d)), smulFun (ε r) v = r • v := by
          intro r v
          have hsub : Function.surjInv hSurj (ε r) - r ∈ RingHom.ker ε := by
            change ε (Function.surjInv hSurj (ε r) - r) = 0
            rw [map_sub, Function.surjInv_eq hSurj (ε r), sub_self]
          have h0 : Ideal.Quotient.mk ((RingHom.ker ε) ^ (d + 1))
              (Function.surjInv hSurj (ε r) - r) * v.1 = 0 :=
            congrArg Subtype.val (hAnnGr ε d hsub v)
          rw [map_sub, sub_mul, sub_eq_zero] at h0
          exact Subtype.ext h0
        { smul := smulFun
          one_smul := fun v => by
            change smulFun 1 v = v
            rw [← map_one ε, hsmul_eps, one_smul]
          mul_smul := fun c₁ c₂ v => by
            rcases hSurj c₁ with ⟨r₁, rfl⟩
            rcases hSurj c₂ with ⟨r₂, rfl⟩
            change smulFun (ε r₁ * ε r₂) v = smulFun (ε r₁) (smulFun (ε r₂) v)
            rw [← map_mul, hsmul_eps, hsmul_eps, hsmul_eps, mul_smul]
          smul_zero := fun c => smul_zero (Function.surjInv hSurj c)
          smul_add := fun c v₁ v₂ => smul_add (Function.surjInv hSurj c) v₁ v₂
          add_smul := fun c₁ c₂ v => by
            rcases hSurj c₁ with ⟨r₁, rfl⟩
            rcases hSurj c₂ with ⟨r₂, rfl⟩
            change smulFun (ε r₁ + ε r₂) v = smulFun (ε r₁) v + smulFun (ε r₂) v
            rw [← map_add, hsmul_eps, hsmul_eps, hsmul_eps, add_smul]
          zero_smul := fun v => by
            change smulFun 0 v = 0
            rw [← map_zero ε, hsmul_eps, zero_smul] }
    have hGrSmulEps : ∀ {K₀ R₀ : Type u} [Field K₀] [CommRing R₀] (ε : R₀ →+* K₀)
        (hSurj : Function.Surjective ε) (d : ℕ) (r : R₀) (v : ↥(grSub ε d)),
        @HSMul.hSMul K₀ ↥(grSub ε d) ↥(grSub ε d)
          (@instHSMul K₀ ↥(grSub ε d) (mkGrMod ε hSurj d).toSMul) (ε r) v = r • v := by
      intro K₀ R₀ _ _ ε hSurj d r v
      have hsub : Function.surjInv hSurj (ε r) - r ∈ RingHom.ker ε := by
        change ε (Function.surjInv hSurj (ε r) - r) = 0
        rw [map_sub, Function.surjInv_eq hSurj (ε r), sub_self]
      have h0 : Ideal.Quotient.mk ((RingHom.ker ε) ^ (d + 1))
          (Function.surjInv hSurj (ε r) - r) * v.1 = 0 :=
        congrArg Subtype.val (hAnnGr ε d hsub v)
      rw [map_sub, sub_mul, sub_eq_zero] at h0
      exact Subtype.ext h0

    have hFlatBC : ∀ {K₀ L₀ R₀ S₀ : Type u} [Field K₀] [Field L₀] [CommRing R₀] [CommRing S₀]
        (ι : K₀ →+* L₀)
        (alg_R : K₀ →+* R₀) (ε_R : R₀ →+* K₀) (_hεR_id : ε_R.comp alg_R = RingHom.id K₀)
        (hSurj_R : Function.Surjective ε_R)
        (ε_S₀ : S₀ →+* L₀) (hSurj_S₀ : Function.Surjective ε_S₀)
        (φ : R₀ →+* S₀) (hFlat : φ.Flat)
        (hComp : ε_S₀.comp φ = ι.comp ε_R)
        (hMap : RingHom.ker ε_S₀ = Ideal.map φ (RingHom.ker ε_R))
        (d : ℕ),
        letI : Algebra K₀ L₀ := ι.toAlgebra
        letI : Module K₀ ↥(grSub ε_R d) := mkGrMod ε_R hSurj_R d
        letI : Module L₀ ↥(grSub ε_S₀ d) := mkGrMod ε_S₀ hSurj_S₀ d
        ∃ Θ : TensorProduct K₀ L₀ ↥(grSub ε_R d) ≃ₗ[L₀] ↥(grSub ε_S₀ d),
          ∀ (c : L₀) (r : R₀)
            (hr : Ideal.Quotient.mk ((RingHom.ker ε_R) ^ (d + 1)) r ∈ grSub ε_R d),
            Θ (c ⊗ₜ[K₀] ⟨Ideal.Quotient.mk _ r, hr⟩) =
              c • ⟨Ideal.Quotient.mk ((RingHom.ker ε_S₀) ^ (d + 1)) (φ r),
                (hMemGr ε_S₀ d (φ r)).mpr (by
                  rw [hMap, ← Ideal.map_pow]
                  exact Ideal.mem_map_of_mem φ ((hMemGr ε_R d r).mp hr))⟩ := by
      intro K₀ L₀ R₀ S₀ _ _ _ _ ι alg_R ε_R hεR_id hSurj_R ε_S₀ hSurj_S₀ φ hFlat hComp hMap d
      letI : Algebra K₀ L₀ := ι.toAlgebra
      letI : Module K₀ ↥(grSub ε_R d) := mkGrMod ε_R hSurj_R d
      letI : Module L₀ ↥(grSub ε_S₀ d) := mkGrMod ε_S₀ hSurj_S₀ d
      have hφ_pow_le : ∀ n : ℕ,
          (RingHom.ker ε_R) ^ n ≤ RingHom.ker ((Ideal.Quotient.mk ((RingHom.ker ε_S₀) ^ n)).comp φ) := by
        intro n r hr
        rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, hMap, ← Ideal.map_pow]
        exact Ideal.mem_map_of_mem φ hr
      let φ_quot : ∀ n : ℕ, (R₀ ⧸ (RingHom.ker ε_R) ^ n) →+* (S₀ ⧸ (RingHom.ker ε_S₀) ^ n) :=
        fun n => Ideal.Quotient.lift ((RingHom.ker ε_R) ^ n)
          ((Ideal.Quotient.mk ((RingHom.ker ε_S₀) ^ n)).comp φ)
          (fun _ hr => hφ_pow_le n hr)
      have hφ_mem : ∀ v : ↥(grSub ε_R d), φ_quot (d + 1) v.1 ∈ grSub ε_S₀ d := by
        rintro ⟨q, hq⟩
        rcases Ideal.Quotient.mk_surjective q with ⟨r, rfl⟩
        change Ideal.Quotient.mk ((RingHom.ker ε_S₀) ^ (d + 1)) (φ r) ∈ grSub ε_S₀ d
        rw [hMemGr, hMap, ← Ideal.map_pow]
        exact Ideal.mem_map_of_mem φ ((hMemGr ε_R d r).mp hq)
      let φ_G : ↥(grSub ε_R d) →+ ↥(grSub ε_S₀ d) :=
        { toFun := fun v => ⟨φ_quot (d + 1) v.1, hφ_mem v⟩
          map_zero' := by apply Subtype.ext; exact map_zero (φ_quot (d + 1))
          map_add' := fun v₁ v₂ => by apply Subtype.ext; exact map_add (φ_quot (d + 1)) v₁.1 v₂.1 }
      have hφ_G_smul : ∀ (k : K₀) (v : ↥(grSub ε_R d)), φ_G (k • v) = (ι k) • φ_G v := by
        intro k v
        have hk_eps : ε_R (alg_R k) = k := by
          change (ε_R.comp alg_R) k = k
          rw [hεR_id, RingHom.id_apply]
        conv_lhs => rw [← hk_eps, hGrSmulEps ε_R hSurj_R d (alg_R k) v]
        have hιk : ι k = ε_S₀ (φ (alg_R k)) := by
          conv_lhs => rw [← hk_eps]
          change (ι.comp ε_R) (alg_R k) = (ε_S₀.comp φ) (alg_R k)
          rw [hComp]
        rw [hιk, hGrSmulEps ε_S₀ hSurj_S₀ d (φ (alg_R k)) (φ_G v)]
        rcases v with ⟨q, hq⟩
        rcases Ideal.Quotient.mk_surjective q with ⟨r, rfl⟩
        apply Subtype.ext
        change Ideal.Quotient.mk ((RingHom.ker ε_S₀) ^ (d + 1)) (φ (alg_R k * r)) =
          Ideal.Quotient.mk ((RingHom.ker ε_S₀) ^ (d + 1)) (φ (alg_R k) * φ r)
        rw [map_mul]
      letI : Module K₀ ↥(grSub ε_S₀ d) := Module.compHom ↥(grSub ε_S₀ d) ι
      haveI : IsScalarTower K₀ L₀ ↥(grSub ε_S₀ d) :=
        ⟨fun k c w => by
          change (ι k * c) • w = (ι k) • (c • w)
          rw [mul_smul]⟩
      let φ_G_lin : ↥(grSub ε_R d) →ₗ[K₀] ↥(grSub ε_S₀ d) :=
        { toAddHom := φ_G.toAddHom
          map_smul' := fun k v => hφ_G_smul k v }
      let f_bilin : L₀ →ₗ[L₀] (↥(grSub ε_R d) →ₗ[K₀] ↥(grSub ε_S₀ d)) :=
        { toFun := fun c =>
            { toFun := fun v => c • φ_G_lin v
              map_add' := fun v₁ v₂ => by rw [map_add, smul_add]
              map_smul' := fun k v => by
                change c • φ_G (k • v) = (ι k) • (c • φ_G v)
                rw [hφ_G_smul, ← mul_smul, mul_comm, mul_smul] }
          map_add' := fun c₁ c₂ => LinearMap.ext fun v => add_smul c₁ c₂ (φ_G_lin v)
          map_smul' := fun c₁ c₂ => LinearMap.ext fun v => mul_smul c₁ c₂ (φ_G_lin v) }
      let Θ_lin : TensorProduct K₀ L₀ ↥(grSub ε_R d) →ₗ[L₀] ↥(grSub ε_S₀ d) :=
        TensorProduct.AlgebraTensorModule.lift f_bilin
      have hBij : Function.Bijective Θ_lin := by
        letI : Algebra R₀ S₀ := φ.toAlgebra
        haveI : Module.Flat R₀ S₀ := RingHom.flat_algebraMap_iff.mp hFlat
        have hmS_tmul_zero : ∀ {m₀ : S₀}, m₀ ∈ RingHom.ker ε_S₀ → ∀ (v : ↥(grSub ε_R d)),
            m₀ ⊗ₜ[R₀] v = (0 : TensorProduct R₀ S₀ ↥(grSub ε_R d)) := by
          intro m₀ hm v
          rw [hMap] at hm
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hm
          · rintro _ ⟨r, hr, rfl⟩
            change (algebraMap R₀ S₀ r) ⊗ₜ[R₀] v = 0
            rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, hAnnGr ε_R d hr v,
              TensorProduct.tmul_zero]
          · exact TensorProduct.zero_tmul _ v
          · intro s₁ s₂ _ _ ih₁ ih₂
            rw [TensorProduct.add_tmul, ih₁, ih₂, add_zero]
          · intro s x _ ih
            change s • (x ⊗ₜ[R₀] v) = 0
            rw [ih, smul_zero]
        letI modR₀_TP : Module R₀ (TensorProduct K₀ L₀ ↥(grSub ε_R d)) :=
          Module.compHom (TensorProduct K₀ L₀ ↥(grSub ε_R d)) (ι.comp ε_R)
        let Φ_bilin : S₀ →ₗ[R₀] (↥(grSub ε_R d) →ₗ[R₀] TensorProduct K₀ L₀ ↥(grSub ε_R d)) :=
          { toFun := fun s =>
              { toFun := fun v => (ε_S₀ s) ⊗ₜ[K₀] v
                map_add' := fun v₁ v₂ => TensorProduct.tmul_add _ _ _
                map_smul' := fun r v => by
                  change (ε_S₀ s) ⊗ₜ[K₀] (r • v) = (ι (ε_R r)) • ((ε_S₀ s) ⊗ₜ[K₀] v)
                  rw [← hGrSmulEps ε_R hSurj_R d r v, ← TensorProduct.smul_tmul,
                    Algebra.smul_def, TensorProduct.smul_tmul']
                  rfl }
            map_add' := fun s₁ s₂ => LinearMap.ext fun v => by
              change (ε_S₀ (s₁ + s₂)) ⊗ₜ[K₀] v = (ε_S₀ s₁) ⊗ₜ[K₀] v + (ε_S₀ s₂) ⊗ₜ[K₀] v
              rw [map_add, TensorProduct.add_tmul]
            map_smul' := fun r s => LinearMap.ext fun v => by
              change (ε_S₀ (φ r * s)) ⊗ₜ[K₀] v = (ι (ε_R r)) • ((ε_S₀ s) ⊗ₜ[K₀] v)
              rw [map_mul, show ε_S₀ (φ r) = (ε_S₀.comp φ) r from rfl, hComp,
                RingHom.comp_apply, TensorProduct.smul_tmul']
              rfl }
        let Φ_map : TensorProduct R₀ S₀ ↥(grSub ε_R d) →+ TensorProduct K₀ L₀ ↥(grSub ε_R d) :=
          (TensorProduct.lift Φ_bilin).toAddMonoidHom
        letI modK₀_TPS : Module K₀ (TensorProduct R₀ S₀ ↥(grSub ε_R d)) :=
          Module.compHom (TensorProduct R₀ S₀ ↥(grSub ε_R d)) (φ.comp alg_R)
        let Ψ_bilin : L₀ →ₗ[K₀] (↥(grSub ε_R d) →ₗ[K₀] TensorProduct R₀ S₀ ↥(grSub ε_R d)) :=
          { toFun := fun c =>
              { toFun := fun v => (Function.surjInv hSurj_S₀ c) ⊗ₜ[R₀] v
                map_add' := fun v₁ v₂ => TensorProduct.tmul_add _ _ _
                map_smul' := fun k v => by
                  change (Function.surjInv hSurj_S₀ c) ⊗ₜ[R₀] (k • v) =
                    (φ (alg_R k)) • ((Function.surjInv hSurj_S₀ c) ⊗ₜ[R₀] v)
                  have hk_eps : ε_R (alg_R k) = k := by
                    change (ε_R.comp alg_R) k = k
                    rw [hεR_id, RingHom.id_apply]
                  conv_lhs => rw [← hk_eps, hGrSmulEps ε_R hSurj_R d (alg_R k) v]
                  rw [← TensorProduct.smul_tmul]
                  rfl }
            map_add' := fun c₁ c₂ => LinearMap.ext fun v => by
              change (Function.surjInv hSurj_S₀ (c₁ + c₂)) ⊗ₜ[R₀] v =
                (Function.surjInv hSurj_S₀ c₁) ⊗ₜ[R₀] v +
                (Function.surjInv hSurj_S₀ c₂) ⊗ₜ[R₀] v
              rw [← TensorProduct.add_tmul]
              have hsub : Function.surjInv hSurj_S₀ (c₁ + c₂) -
                  (Function.surjInv hSurj_S₀ c₁ + Function.surjInv hSurj_S₀ c₂) ∈ RingHom.ker ε_S₀ := by
                change ε_S₀ _ = 0
                rw [map_sub, map_add, Function.surjInv_eq hSurj_S₀,
                  Function.surjInv_eq hSurj_S₀, Function.surjInv_eq hSurj_S₀, sub_self]
              have h0 := hmS_tmul_zero hsub v
              have hid : Function.surjInv hSurj_S₀ (c₁ + c₂) =
                  (Function.surjInv hSurj_S₀ (c₁ + c₂) -
                    (Function.surjInv hSurj_S₀ c₁ + Function.surjInv hSurj_S₀ c₂)) +
                  (Function.surjInv hSurj_S₀ c₁ + Function.surjInv hSurj_S₀ c₂) :=
                (sub_add_cancel _ _).symm
              conv_lhs => rw [hid, TensorProduct.add_tmul, h0, zero_add]
            map_smul' := fun k c => LinearMap.ext fun v => by
              change (Function.surjInv hSurj_S₀ (ι k * c)) ⊗ₜ[R₀] v =
                (φ (alg_R k) * Function.surjInv hSurj_S₀ c) ⊗ₜ[R₀] v
              have hk_eps : ε_R (alg_R k) = k := by
                change (ε_R.comp alg_R) k = k
                rw [hεR_id, RingHom.id_apply]
              have hsub : Function.surjInv hSurj_S₀ (ι k * c) -
                  φ (alg_R k) * Function.surjInv hSurj_S₀ c ∈ RingHom.ker ε_S₀ := by
                change ε_S₀ _ = 0
                rw [map_sub, map_mul, Function.surjInv_eq hSurj_S₀,
                  Function.surjInv_eq hSurj_S₀,
                  show ε_S₀ (φ (alg_R k)) = (ε_S₀.comp φ) (alg_R k) from rfl,
                  hComp, RingHom.comp_apply, hk_eps, sub_self]
              have h0 := hmS_tmul_zero hsub v
              have hid : Function.surjInv hSurj_S₀ (ι k * c) =
                  (Function.surjInv hSurj_S₀ (ι k * c) -
                    φ (alg_R k) * Function.surjInv hSurj_S₀ c) +
                  φ (alg_R k) * Function.surjInv hSurj_S₀ c :=
                (sub_add_cancel _ _).symm
              conv_lhs => rw [hid, TensorProduct.add_tmul, h0, zero_add] }
        let Ψ_map : TensorProduct K₀ L₀ ↥(grSub ε_R d) →+ TensorProduct R₀ S₀ ↥(grSub ε_R d) :=
          (TensorProduct.lift Ψ_bilin).toAddMonoidHom
        have hΦΨ : ∀ u : TensorProduct K₀ L₀ ↥(grSub ε_R d), Φ_map (Ψ_map u) = u := by
          intro u
          induction u using TensorProduct.induction_on with
          | zero => simp
          | tmul c v =>
            change (ε_S₀ (Function.surjInv hSurj_S₀ c)) ⊗ₜ[K₀] v = c ⊗ₜ[K₀] v
            rw [Function.surjInv_eq hSurj_S₀ c]
          | add u₁ u₂ ih₁ ih₂ => rw [map_add, map_add, ih₁, ih₂]
        have hΨΦ : ∀ z : TensorProduct R₀ S₀ ↥(grSub ε_R d), Ψ_map (Φ_map z) = z := by
          intro z
          induction z using TensorProduct.induction_on with
          | zero => simp
          | tmul s v =>
            change (Function.surjInv hSurj_S₀ (ε_S₀ s)) ⊗ₜ[R₀] v = s ⊗ₜ[R₀] v
            have hsub : Function.surjInv hSurj_S₀ (ε_S₀ s) - s ∈ RingHom.ker ε_S₀ := by
              change ε_S₀ _ = 0
              rw [map_sub, Function.surjInv_eq hSurj_S₀, sub_self]
            have h0 := hmS_tmul_zero hsub v
            have hid : Function.surjInv hSurj_S₀ (ε_S₀ s) =
                (Function.surjInv hSurj_S₀ (ε_S₀ s) - s) + s := (sub_add_cancel _ _).symm
            conv_lhs => rw [hid, TensorProduct.add_tmul, h0, zero_add]
          | add z₁ z₂ ih₁ ih₂ => rw [map_add, map_add, ih₁, ih₂]
        have hΨ_bij : Function.Bijective Ψ_map :=
          ⟨Function.LeftInverse.injective hΦΨ, Function.RightInverse.surjective hΨΦ⟩
        let i_R : ↥(grSub ε_R d) →ₗ[R₀] (R₀ ⧸ (RingHom.ker ε_R) ^ (d + 1)) := (grSub ε_R d).subtype
        let p_R : (R₀ ⧸ (RingHom.ker ε_R) ^ (d + 1)) →ₗ[R₀] (R₀ ⧸ (RingHom.ker ε_R) ^ d) :=
          Submodule.factor (Ideal.pow_le_pow_right (Nat.le_succ d))
        let p_S : (S₀ ⧸ (RingHom.ker ε_S₀) ^ (d + 1)) →ₗ[S₀] (S₀ ⧸ (RingHom.ker ε_S₀) ^ d) :=
          Submodule.factor (Ideal.pow_le_pow_right (Nat.le_succ d))
        have hi_inj : Function.Injective (LinearMap.lTensor S₀ i_R) :=
          Module.Flat.lTensor_preserves_injective_linearMap i_R (grSub ε_R d).subtype_injective
        have hexact_R : Function.Exact i_R p_R := by
          rw [LinearMap.exact_iff]
          exact (Submodule.range_subtype (grSub ε_R d)).symm
        have hexact_S : Function.Exact (LinearMap.lTensor S₀ i_R) (LinearMap.lTensor S₀ p_R) :=
          Module.Flat.lTensor_exact S₀ hexact_R
        let α_eq : ∀ n : ℕ,
            TensorProduct R₀ S₀ (R₀ ⧸ (RingHom.ker ε_R) ^ n) ≃+ (S₀ ⧸ (RingHom.ker ε_S₀) ^ n) :=
          fun n =>
            (Algebra.TensorProduct.quotIdealMapEquivTensorQuot S₀ ((RingHom.ker ε_R) ^ n)).symm.toAddEquiv.trans
              (Ideal.quotEquivOfEq (by
                rw [Ideal.map_pow, show algebraMap R₀ S₀ = φ from rfl, ← hMap])).toAddEquiv
        have hα_tmul : ∀ (n : ℕ) (s : S₀) (r : R₀),
            α_eq n (s ⊗ₜ[R₀] Ideal.Quotient.mk ((RingHom.ker ε_R) ^ n) r) =
              Ideal.Quotient.mk ((RingHom.ker ε_S₀) ^ n) (φ r * s) := by
          intro n s r
          dsimp [α_eq]
          rfl
        have hα_comm : ∀ x : TensorProduct R₀ S₀ (R₀ ⧸ (RingHom.ker ε_R) ^ (d + 1)),
            p_S (α_eq (d + 1) x) = α_eq d (LinearMap.lTensor S₀ p_R x) := by
          intro x
          induction x using TensorProduct.induction_on with
          | zero => simp
          | tmul s q =>
            rcases Ideal.Quotient.mk_surjective q with ⟨r, rfl⟩
            rw [hα_tmul, LinearMap.lTensor_tmul]
            change p_S (((RingHom.ker ε_S₀) ^ (d + 1)).mkQ (φ r * s)) =
              α_eq d (s ⊗ₜ[R₀] p_R (((RingHom.ker ε_R) ^ (d + 1)).mkQ r))
            rw [Submodule.factor_mk, Submodule.factor_mk]
            exact (hα_tmul d s r).symm
          | add x₁ x₂ ih₁ ih₂ => rw [map_add, map_add, map_add, map_add, ih₁, ih₂]
        have hβ_mem : ∀ z : TensorProduct R₀ S₀ ↥(grSub ε_R d),
            α_eq (d + 1) (LinearMap.lTensor S₀ i_R z) ∈ grSub ε_S₀ d := by
          intro z
          change p_S (α_eq (d + 1) (LinearMap.lTensor S₀ i_R z)) = 0
          rw [hα_comm, hexact_S.apply_apply_eq_zero z, map_zero]
        let β : TensorProduct R₀ S₀ ↥(grSub ε_R d) →+ ↥(grSub ε_S₀ d) :=
          { toFun := fun z => ⟨α_eq (d + 1) (LinearMap.lTensor S₀ i_R z), hβ_mem z⟩
            map_zero' := by apply Subtype.ext; simp
            map_add' := fun z₁ z₂ => by apply Subtype.ext; simp }
        have hβ_bij : Function.Bijective β := by
          refine ⟨?_, ?_⟩
          · intro z₁ z₂ heq
            have h1 : α_eq (d + 1) (LinearMap.lTensor S₀ i_R z₁) =
                α_eq (d + 1) (LinearMap.lTensor S₀ i_R z₂) := congrArg Subtype.val heq
            exact hi_inj ((α_eq (d + 1)).injective h1)
          · rintro ⟨q_S, hq_S⟩
            let x := (α_eq (d + 1)).symm q_S
            have hx_ker : LinearMap.lTensor S₀ p_R x = 0 := by
              apply (α_eq d).injective
              rw [← hα_comm, AddEquiv.apply_symm_apply, map_zero]
              exact hq_S
            rcases (hexact_S x).mp hx_ker with ⟨z, hz⟩
            refine ⟨z, Subtype.ext ?_⟩
            change α_eq (d + 1) (LinearMap.lTensor S₀ i_R z) = q_S
            rw [hz, AddEquiv.apply_symm_apply]
        have hΘ_eq : (Θ_lin : TensorProduct K₀ L₀ ↥(grSub ε_R d) → ↥(grSub ε_S₀ d)) =
            β ∘ Ψ_map := by
          funext u
          induction u using TensorProduct.induction_on with
          | zero =>
            apply Subtype.ext
            simp [β]
          | tmul c v =>
            rcases v with ⟨q, hq⟩
            rcases Ideal.Quotient.mk_surjective q with ⟨r, rfl⟩
            apply Subtype.ext
            let s := Function.surjInv hSurj_S₀ c
            have hs_c : ε_S₀ s = c := Function.surjInv_eq hSurj_S₀ c
            have hL : (Θ_lin (c ⊗ₜ[K₀] ⟨Ideal.Quotient.mk ((RingHom.ker ε_R) ^ (d + 1)) r, hq⟩)).1 =
                Ideal.Quotient.mk ((RingHom.ker ε_S₀) ^ (d + 1)) (s * φ r) := by
              change (c • φ_G ⟨Ideal.Quotient.mk ((RingHom.ker ε_R) ^ (d + 1)) r, hq⟩).1 = _
              rw [← hs_c, hGrSmulEps ε_S₀ hSurj_S₀ d s _]
              rfl
            have hR : (β (Ψ_map (c ⊗ₜ[K₀] ⟨Ideal.Quotient.mk ((RingHom.ker ε_R) ^ (d + 1)) r, hq⟩))).1 =
                Ideal.Quotient.mk ((RingHom.ker ε_S₀) ^ (d + 1)) (φ r * s) := by
              change α_eq (d + 1) (s ⊗ₜ[R₀] Ideal.Quotient.mk ((RingHom.ker ε_R) ^ (d + 1)) r) = _
              exact hα_tmul (d + 1) s r
            rw [hL, Function.comp_apply, hR, mul_comm]
          | add u₁ u₂ ih₁ ih₂ =>
            simp only [Function.comp_apply, map_add] at ih₁ ih₂ ⊢
            rw [ih₁, ih₂]
        rw [hΘ_eq]
        exact hβ_bij.comp hΨ_bij
      refine ⟨LinearEquiv.ofBijective Θ_lin hBij, fun c r hr => ?_⟩
      rfl

    have hSurj₁ : Function.Surjective ε₁ := fun c =>
      ⟨alg₁ c, by change (ε₁.comp alg₁) c = c; rw [hε₁_id, RingHom.id_apply]⟩
    have hSurj₂ : Function.Surjective ε₂ := fun c =>
      ⟨alg₂ c, by change (ε₂.comp alg₂) c = c; rw [hε₂_id, RingHom.id_apply]⟩

    letI modG₁ : ∀ d : ℕ, Module K₁ ↥(grSub ε₁ d) := mkGrMod ε₁ hSurj₁
    letI modG₂ : ∀ d : ℕ, Module K₂ ↥(grSub ε₂ d) := mkGrMod ε₂ hSurj₂
    letI modGS : ∀ d : ℕ, Module L ↥(grSub ε_S d) := mkGrMod ε_S hSurj_S
    letI algK₁L : Algebra K₁ L := ι₁.toAlgebra
    letI algK₂L : Algebra K₂ L := ι₂.toAlgebra

    have hSmulAlg₁ : ∀ (d : ℕ) (c : K₁) (v : ↥(grSub ε₁ d)), c • v = (alg₁ c) • v := by
      intro d c v
      have hc : ε₁ (alg₁ c) = c := by change (ε₁.comp alg₁) c = c; rw [hε₁_id, RingHom.id_apply]
      conv_lhs => rw [← hc]
      exact hGrSmulEps ε₁ hSurj₁ d (alg₁ c) v
    have hSmulAlg₂ : ∀ (d : ℕ) (c : K₂) (v : ↥(grSub ε₂ d)), c • v = (alg₂ c) • v := by
      intro d c v
      have hc : ε₂ (alg₂ c) = c := by change (ε₂.comp alg₂) c = c; rw [hε₂_id, RingHom.id_apply]
      conv_lhs => rw [← hc]
      exact hGrSmulEps ε₂ hSurj₂ d (alg₂ c) v

    obtain ⟨Θ₁_1, hΘ₁_1⟩ := hFlatBC ι₁ alg₁ ε₁ hε₁_id hSurj₁ ε_S hSurj_S ψ₁₀ hψ₁₀_flat hComp₁ hMap₁ 1
    obtain ⟨Θ₂_1, hΘ₂_1⟩ := hFlatBC ι₂ alg₂ ε₂ hε₂_id hSurj₂ ε_S hSurj_S ψ₂₀ hψ₂₀_flat hComp₂ hMap₂ 1

    have hx₂_mem : ∀ b : Fin N, x₂ b ∈ RingHom.ker ε₂ := by
      intro b; rw [hx₂_span]; exact Ideal.subset_span ⟨b, rfl⟩
    let v_x₂ : Fin N → ↥(grSub ε₂ 1) := fun b =>
      ⟨Ideal.Quotient.mk ((RingHom.ker ε₂) ^ 2) (x₂ b),
        (hMemGr ε₂ 1 (x₂ b)).mpr ((pow_one (RingHom.ker ε₂)).symm ▸ hx₂_mem b)⟩
    have hli_x₂ : LinearIndependent K₂ v_x₂ := by
      rw [Fintype.linearIndependent_iff]
      intro c hc b₀
      have hc_val : (∑ b : Fin N, c b • v_x₂ b).1 =
          Ideal.Quotient.mk ((RingHom.ker ε₂) ^ 2) (∑ b : Fin N, alg₂ (c b) * x₂ b) := by
        rw [AddSubmonoidClass.coe_finsetSum, map_sum]
        apply Finset.sum_congr rfl
        intro b _
        rw [hSmulAlg₂ 1 (c b) (v_x₂ b)]
        rfl
      have hsum_mem : (∑ b : Fin N, alg₂ (c b) * x₂ b) ∈ (RingHom.ker ε₂) ^ 2 := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, ← hc_val, hc]; rfl
      let P₂ : MvPolynomial (Fin N) K₂ :=
        ∑ b : Fin N, MvPolynomial.C (c b) * MvPolynomial.X b
      have hP₂_hom : P₂ ∈ MvPolynomial.homogeneousSubmodule (Fin N) K₂ 1 := by
        refine Submodule.sum_mem _ fun b _ => ?_
        rw [MvPolynomial.mem_homogeneousSubmodule]
        exact (MvPolynomial.isHomogeneous_X K₂ b).C_mul (c b)
      have hP₂_eval : MvPolynomial.eval₂ alg₂ x₂ P₂ = ∑ b : Fin N, alg₂ (c b) * x₂ b := by
        change (MvPolynomial.eval₂Hom alg₂ x₂)
          (∑ b : Fin N, MvPolynomial.C (c b) * MvPolynomial.X b) = _
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro b _
        rw [map_mul, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C, MvPolynomial.eval₂_X]
      have hP₂_span : P₂ ∈ Ideal.span {F₂} := by
        apply (hF₂_iff 1 P₂ hP₂_hom).mp
        rw [hP₂_eval]; exact hsum_mem
      have hP₂_zero : P₂ = 0 := by
        rcases homog_mem_span_quad hF₂_hom hP₂_hom hP₂_span with ⟨_, h0⟩ | ⟨hge, _⟩
        · exact h0
        · omega
      have hcoeff : P₂.coeff (Finsupp.single b₀ 1) = c b₀ := by
        dsimp [P₂]
        rw [MvPolynomial.coeff_sum]
        have hterm : ∀ b : Fin N,
            (MvPolynomial.C (c b) * MvPolynomial.X b).coeff (Finsupp.single b₀ 1) =
              if b₀ = b then c b else 0 := by
          intro b
          rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X]
          by_cases h : b₀ = b
          · subst h; simp
          · have hne : Finsupp.single b 1 ≠ Finsupp.single b₀ 1 := by
              intro heq
              have := DFunLike.congr_fun heq b
              simp [h] at this
            simp [h, hne]
        simp_rw [hterm]
        simp
      rw [← hcoeff, hP₂_zero]; rfl
    have hsp_x₂ : ⊤ ≤ Submodule.span K₂ (Set.range v_x₂) := by
      rintro ⟨q, hq⟩ _
      rcases Ideal.Quotient.mk_surjective q with ⟨z, rfl⟩
      have hz : z ∈ Ideal.span (Set.range x₂) := by
        rw [← hx₂_span, ← pow_one (RingHom.ker ε₂)]
        exact (hMemGr ε₂ 1 z).mp hq
      have hspan_ind : ∀ {w : R₂} (hw : w ∈ Ideal.span (Set.range x₂)),
          (⟨Ideal.Quotient.mk ((RingHom.ker ε₂) ^ 2) w,
            (hMemGr ε₂ 1 w).mpr (by rw [pow_one, hx₂_span]; exact hw)⟩ : ↥(grSub ε₂ 1)) ∈
            Submodule.span K₂ (Set.range v_x₂) := by
        intro w hw
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hw
        · rintro _ ⟨b, rfl⟩
          exact Submodule.subset_span ⟨b, rfl⟩
        · convert Submodule.zero_mem _
          exact map_zero _
        · intro w₁ w₂ hw₁ hw₂ ih₁ ih₂
          convert Submodule.add_mem _ ih₁ ih₂
          exact map_add _ w₁ w₂
        · intro r w₀ hw₀ ih
          have hsmul_eq : (⟨Ideal.Quotient.mk ((RingHom.ker ε₂) ^ 2) (r • w₀),
              (hMemGr ε₂ 1 (r • w₀)).mpr (by
                rw [pow_one, hx₂_span]
                exact Ideal.mul_mem_left _ r hw₀)⟩ : ↥(grSub ε₂ 1)) =
              (ε₂ r) • ⟨Ideal.Quotient.mk ((RingHom.ker ε₂) ^ 2) w₀,
                (hMemGr ε₂ 1 w₀).mpr (by rw [pow_one, hx₂_span]; exact hw₀)⟩ := by
            rw [hGrSmulEps ε₂ hSurj₂ 1 r _]; rfl
          rw [hsmul_eq]
          exact Submodule.smul_mem _ (ε₂ r) ih
      exact hspan_ind hz

    let bx_R₂ : Module.Basis (Fin N) K₂ ↥(grSub ε₂ 1) := Module.Basis.mk hli_x₂ hsp_x₂
    let bx_S : Module.Basis (Fin N) L ↥(grSub ε_S 1) := (bx_R₂.baseChange L).map Θ₂_1
    have hbx_S_val : ∀ b : Fin N,
        (bx_S b).1 = Ideal.Quotient.mk ((RingHom.ker ε_S) ^ 2) (ψ₂₀ (x₂ b)) := by
      intro b
      change (Θ₂_1 ((bx_R₂.baseChange L) b)).1 = _
      rw [Module.Basis.baseChange_apply]
      dsimp [bx_R₂]
      rw [Module.Basis.mk_apply, hΘ₂_1 1 (x₂ b) _, one_smul]

    let b_raw : Module.Basis _ K₁ ↥(grSub ε₁ 1) := Module.Basis.ofVectorSpace K₁ ↥(grSub ε₁ 1)
    let b_raw_S : Module.Basis _ L ↥(grSub ε_S 1) := (b_raw.baseChange L).map Θ₁_1
    let e_κ := b_raw_S.indexEquiv bx_S
    let by_R₁ : Module.Basis (Fin N) K₁ ↥(grSub ε₁ 1) := b_raw.reindex e_κ

    let y₀ : Fin N → R₁ := fun a => Classical.choose (Ideal.Quotient.mk_surjective (by_R₁ a).1)
    have hy₀_mk : ∀ a : Fin N, Ideal.Quotient.mk ((RingHom.ker ε₁) ^ 2) (y₀ a) = (by_R₁ a).1 :=
      fun a => Classical.choose_spec (Ideal.Quotient.mk_surjective (by_R₁ a).1)
    have hy₀_mem : ∀ a : Fin N, y₀ a ∈ RingHom.ker ε₁ := by
      intro a
      rw [← pow_one (RingHom.ker ε₁), ← hMemGr ε₁ 1 (y₀ a), hy₀_mk a]
      exact (by_R₁ a).2
    have hy₀_nz : ∀ a : Fin N, y₀ a ≠ 0 := by
      intro a h0
      apply by_R₁.ne_zero a
      apply Subtype.ext
      rw [← hy₀_mk a, h0, map_zero]; rfl
    have hNak_le : RingHom.ker ε₁ ≤ Ideal.span (Set.range y₀) ⊔ (RingHom.ker ε₁) • (RingHom.ker ε₁) := by
      intro z hz
      let vz : ↥(grSub ε₁ 1) :=
        ⟨Ideal.Quotient.mk ((RingHom.ker ε₁) ^ 2) z, (hMemGr ε₁ 1 z).mpr (by rwa [pow_one])⟩
      let c : Fin N → K₁ := fun a => by_R₁.repr vz a
      have hsum_vz : ∑ a : Fin N, c a • by_R₁ a = vz := by_R₁.sum_repr vz
      have hmk_eq : Ideal.Quotient.mk ((RingHom.ker ε₁) ^ 2) (∑ a : Fin N, alg₁ (c a) * y₀ a) =
          Ideal.Quotient.mk ((RingHom.ker ε₁) ^ 2) z := by
        have hval := congrArg Subtype.val hsum_vz
        rw [AddSubmonoidClass.coe_finsetSum] at hval
        rw [map_sum]
        change _ = vz.1
        rw [← hval]
        apply Finset.sum_congr rfl
        intro a _
        rw [hSmulAlg₁ 1 (c a) (by_R₁ a)]
        change Ideal.Quotient.mk ((RingHom.ker ε₁) ^ 2) (alg₁ (c a)) *
          Ideal.Quotient.mk ((RingHom.ker ε₁) ^ 2) (y₀ a) =
          (alg₁ (c a)) • (by_R₁ a).1
        rw [hy₀_mk a]; rfl
      have hdiff_mem : z - ∑ a : Fin N, alg₁ (c a) * y₀ a ∈ (RingHom.ker ε₁) • (RingHom.ker ε₁) := by
        rw [Ideal.smul_eq_mul, ← sq, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, hmk_eq, sub_self]
      have hlin_mem : (∑ a : Fin N, alg₁ (c a) * y₀ a) ∈ Ideal.span (Set.range y₀) :=
        Submodule.sum_mem _ fun a _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨a, rfl⟩)
      have hz_id : z = (∑ a : Fin N, alg₁ (c a) * y₀ a) + (z - ∑ a : Fin N, alg₁ (c a) * y₀ a) := by
        ring
      rw [hz_id]
      exact Submodule.add_mem_sup hlin_mem hdiff_mem

    let bu_S : Module.Basis (Fin N) L ↥(grSub ε_S 1) := (by_R₁.baseChange L).map Θ₁_1
    have hbu_S_val : ∀ a : Fin N,
        (bu_S a).1 = Ideal.Quotient.mk ((RingHom.ker ε_S) ^ 2) (ψ₁₀ (y₀ a)) := by
      intro a
      change (Θ₁_1 ((by_R₁.baseChange L) a)).1 = _
      rw [Module.Basis.baseChange_apply]
      have hby_eq : by_R₁ a = ⟨Ideal.Quotient.mk ((RingHom.ker ε₁) ^ 2) (y₀ a),
          (hy₀_mk a).symm ▸ (by_R₁ a).2⟩ := Subtype.ext (hy₀_mk a).symm
      rw [hby_eq, hΘ₁_1 1 (y₀ a) _, one_smul]

    let L_inv : Matrix (Fin N) (Fin N) L := (bu_S.toMatrix bx_S).transpose
    let R_inv : Matrix (Fin N) (Fin N) L := (bx_S.toMatrix bu_S).transpose
    have hLR : L_inv * R_inv = 1 := by
      dsimp [L_inv, R_inv]
      rw [← Matrix.transpose_mul, Module.Basis.toMatrix_mul_toMatrix, Module.Basis.toMatrix_self,
        Matrix.transpose_one]
    have hRL : R_inv * L_inv = 1 := by
      dsimp [L_inv, R_inv]
      rw [← Matrix.transpose_mul, Module.Basis.toMatrix_mul_toMatrix, Module.Basis.toMatrix_self,
        Matrix.transpose_one]
    have hbu_expand : ∀ a : Fin N, bu_S a = ∑ b : Fin N, R_inv a b • bx_S b := by
      intro a; dsimp [R_inv]; exact (bx_S.sum_toMatrix_smul_self bu_S a).symm

    let grMonom : ∀ {K₀ R₀ : Type u} [Field K₀] [CommRing R₀] (ε : R₀ →+* K₀)
        (w : Fin N → R₀) (_hw : ∀ a, w a ∈ RingHom.ker ε) (d : ℕ) (s : Fin N →₀ ℕ),
        ↥(grSub ε d) :=
      fun {_ _} _ _ ε w hw d s =>
        if hs : Finsupp.degree s = d then
          ⟨Ideal.Quotient.mk ((RingHom.ker ε) ^ (d + 1)) (s.prod fun a e => w a ^ e),
            (hMemGr ε d _).mpr (hs ▸ finsupp_prod_mem_pow (RingHom.ker ε) w hw s)⟩
        else 0
    let evalGr : ∀ {K₀ R₀ : Type u} [Field K₀] [CommRing R₀] (ε : R₀ →+* K₀)
        (hSurj : Function.Surjective ε) (w : Fin N → R₀) (hw : ∀ a, w a ∈ RingHom.ker ε) (d : ℕ),
        letI : Module K₀ ↥(grSub ε d) := mkGrMod ε hSurj d
        MvPolynomial (Fin N) K₀ →ₗ[K₀] ↥(grSub ε d) :=
      fun {K₀ R₀} _ _ ε hSurj w hw d =>
        letI : Module K₀ ↥(grSub ε d) := mkGrMod ε hSurj d
        { toFun := fun P => ∑ s ∈ P.support, P.coeff s • grMonom ε w hw d s
          map_add' := fun P Q => by
            have hP : ∑ s ∈ P.support, P.coeff s • grMonom ε w hw d s =
                ∑ s ∈ P.support ∪ Q.support, P.coeff s • grMonom ε w hw d s :=
              Finset.sum_subset Finset.subset_union_left (fun s _ hs => by
                have hc : P.coeff s = 0 := by
                  by_contra hne; exact hs (MvPolynomial.mem_support_iff.mpr hne)
                rw [hc, zero_smul])
            have hQ : ∑ s ∈ Q.support, Q.coeff s • grMonom ε w hw d s =
                ∑ s ∈ P.support ∪ Q.support, Q.coeff s • grMonom ε w hw d s :=
              Finset.sum_subset Finset.subset_union_right (fun s _ hs => by
                have hc : Q.coeff s = 0 := by
                  by_contra hne; exact hs (MvPolynomial.mem_support_iff.mpr hne)
                rw [hc, zero_smul])
            have hPQ : ∑ s ∈ (P + Q).support, (P + Q).coeff s • grMonom ε w hw d s =
                ∑ s ∈ P.support ∪ Q.support, (P + Q).coeff s • grMonom ε w hw d s :=
              Finset.sum_subset MvPolynomial.support_add (fun s _ hs => by
                have hc : (P + Q).coeff s = 0 := by
                  by_contra hne; exact hs (MvPolynomial.mem_support_iff.mpr hne)
                rw [hc, zero_smul])
            rw [hP, hQ, hPQ, ← Finset.sum_add_distrib]
            apply Finset.sum_congr rfl
            intro s _
            change ((P.coeff + Q.coeff) s) • _ = _
            rw [Finsupp.add_apply, add_smul]
          map_smul' := fun c P => by
            change ∑ s ∈ (c • P).support, (c • P).coeff s • grMonom ε w hw d s =
              c • ∑ s ∈ P.support, P.coeff s • grMonom ε w hw d s
            have hcP : ∑ s ∈ (c • P).support, (c • P).coeff s • grMonom ε w hw d s =
                ∑ s ∈ P.support, (c • P).coeff s • grMonom ε w hw d s :=
              Finset.sum_subset MvPolynomial.support_smul (fun s _ hs => by
                have hc0 : (c • P).coeff s = 0 := by
                  by_contra hne; exact hs (MvPolynomial.mem_support_iff.mpr hne)
                rw [hc0, zero_smul])
            rw [hcP, Finset.smul_sum]
            apply Finset.sum_congr rfl
            intro s _
            rw [MvPolynomial.coeff_smul, smul_eq_mul, mul_smul] }

    have hEvalGrZeroIff : ∀ {K₀ R₀ : Type u} [Field K₀] [CommRing R₀]
        (alg_R : K₀ →+* R₀) (ε_R : R₀ →+* K₀) (hεR_id : ε_R.comp alg_R = RingHom.id K₀)
        (hSurj_R : Function.Surjective ε_R)
        (w₀ : Fin N → R₀) (hw₀ : ∀ a, w₀ a ∈ RingHom.ker ε_R)
        (d : ℕ) (P₀ : MvPolynomial (Fin N) K₀),
        P₀ ∈ MvPolynomial.homogeneousSubmodule (Fin N) K₀ d →
        (evalGr ε_R hSurj_R w₀ hw₀ d P₀ = 0 ↔
          MvPolynomial.eval₂ alg_R w₀ P₀ ∈ (RingHom.ker ε_R) ^ (d + 1)) := by
      intro K₀ R₀ _ _ alg_R ε_R hεR_id hSurj_R w₀ hw₀ d P₀ hP₀
      letI : Module K₀ ↥(grSub ε_R d) := mkGrMod ε_R hSurj_R d
      rw [MvPolynomial.mem_homogeneousSubmodule] at hP₀
      have hval : (evalGr ε_R hSurj_R w₀ hw₀ d P₀).1 =
          Ideal.Quotient.mk ((RingHom.ker ε_R) ^ (d + 1)) (MvPolynomial.eval₂ alg_R w₀ P₀) := by
        have hev_sum : MvPolynomial.eval₂ alg_R w₀ P₀ =
            ∑ s ∈ P₀.support, MvPolynomial.eval₂ alg_R w₀ (MvPolynomial.monomial s (P₀.coeff s)) := by
          change (MvPolynomial.eval₂Hom alg_R w₀) P₀ = _
          conv_lhs => rw [MvPolynomial.as_sum P₀]
          exact map_sum _ _ P₀.support
        rw [hev_sum, map_sum]
        change (∑ s ∈ P₀.support, P₀.coeff s • grMonom ε_R w₀ hw₀ d s).1 = _
        rw [AddSubmonoidClass.coe_finsetSum]
        apply Finset.sum_congr rfl
        intro s hs
        have hs_deg : Finsupp.degree s = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp hs) (hP₀.coeff_eq_zero hne)
        have hc_eps : ε_R (alg_R (P₀.coeff s)) = P₀.coeff s := by
          change (ε_R.comp alg_R) (P₀.coeff s) = P₀.coeff s
          rw [hεR_id, RingHom.id_apply]
        conv_lhs => rw [← hc_eps, hGrSmulEps ε_R hSurj_R d (alg_R (P₀.coeff s)) _]
        dsimp [grMonom]
        simp only [hs_deg, ↓reduceDIte, MvPolynomial.eval₂_monomial]
        rfl
      rw [← Subtype.val_inj, hval]
      exact Ideal.Quotient.eq_zero_iff_mem

    have hEvalGrBC : ∀ {K₀ L₀ R₀ S₀ : Type u} [Field K₀] [Field L₀] [CommRing R₀] [CommRing S₀]
        (ι : K₀ →+* L₀)
        (alg_R : K₀ →+* R₀) (ε_R : R₀ →+* K₀) (hεR_id : ε_R.comp alg_R = RingHom.id K₀)
        (hSurj_R : Function.Surjective ε_R)
        (ε_S₀ : S₀ →+* L₀) (hSurj_S₀ : Function.Surjective ε_S₀)
        (φ : R₀ →+* S₀)
        (hComp : ε_S₀.comp φ = ι.comp ε_R)
        (hMap : RingHom.ker ε_S₀ = Ideal.map φ (RingHom.ker ε_R))
        (w₀ : Fin N → R₀) (hw₀ : ∀ a, w₀ a ∈ RingHom.ker ε_R)
        (hwS : ∀ a, φ (w₀ a) ∈ RingHom.ker ε_S₀)
        (d : ℕ),
        letI : Algebra K₀ L₀ := ι.toAlgebra
        letI : Module K₀ ↥(grSub ε_R d) := mkGrMod ε_R hSurj_R d
        letI : Module L₀ ↥(grSub ε_S₀ d) := mkGrMod ε_S₀ hSurj_S₀ d
        ∀ (Θ : TensorProduct K₀ L₀ ↥(grSub ε_R d) ≃ₗ[L₀] ↥(grSub ε_S₀ d)),
          (∀ (c : L₀) (r : R₀)
            (hr : Ideal.Quotient.mk ((RingHom.ker ε_R) ^ (d + 1)) r ∈ grSub ε_R d),
            Θ (c ⊗ₜ[K₀] ⟨Ideal.Quotient.mk _ r, hr⟩) =
              c • ⟨Ideal.Quotient.mk ((RingHom.ker ε_S₀) ^ (d + 1)) (φ r),
                (hMemGr ε_S₀ d (φ r)).mpr (by
                  rw [hMap, ← Ideal.map_pow]
                  exact Ideal.mem_map_of_mem φ ((hMemGr ε_R d r).mp hr))⟩) →
          ∀ (b : L₀) (P₀ : MvPolynomial (Fin N) K₀),
            evalGr ε_S₀ hSurj_S₀ (φ ∘ w₀) hwS d (MvPolynomial.C b * MvPolynomial.map ι P₀) =
              Θ (b ⊗ₜ[K₀] evalGr ε_R hSurj_R w₀ hw₀ d P₀) := by
      intro K₀ L₀ R₀ S₀ _ _ _ _ ι alg_R ε_R _ hSurj_R ε_S₀ hSurj_S₀ φ _ hMap w₀ hw₀ hwS d
      letI : Algebra K₀ L₀ := ι.toAlgebra
      letI : Module K₀ ↥(grSub ε_R d) := mkGrMod ε_R hSurj_R d
      letI : Module L₀ ↥(grSub ε_S₀ d) := mkGrMod ε_S₀ hSurj_S₀ d
      intro Θ hΘ b P₀
      have hCmul : MvPolynomial.C b * MvPolynomial.map ι P₀ = b • MvPolynomial.map ι P₀ :=
        (MvPolynomial.smul_eq_C_mul _ _).symm
      rw [hCmul, map_smul]
      have hmap_sum : MvPolynomial.map ι P₀ =
          ∑ s ∈ P₀.support, MvPolynomial.monomial s (ι (P₀.coeff s)) := by
        conv_lhs => rw [MvPolynomial.as_sum P₀]
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro s _
        exact MvPolynomial.map_monomial ι s (P₀.coeff s)
      have hLHS : evalGr ε_S₀ hSurj_S₀ (φ ∘ w₀) hwS d (MvPolynomial.map ι P₀) =
          ∑ s ∈ P₀.support, (ι (P₀.coeff s)) • grMonom ε_S₀ (φ ∘ w₀) hwS d s := by
        rw [hmap_sum, map_sum]
        apply Finset.sum_congr rfl
        intro s _
        change ∑ t ∈ (MvPolynomial.monomial s (ι (P₀.coeff s))).support, _ = _
        have hsub : (MvPolynomial.monomial s (ι (P₀.coeff s))).support ⊆ {s} :=
          MvPolynomial.support_monomial_subset
        rw [Finset.sum_subset hsub (fun t _ ht => by
          have hc0 : (MvPolynomial.monomial s (ι (P₀.coeff s))).coeff t = 0 := by
            by_contra hne; exact ht (MvPolynomial.mem_support_iff.mpr hne)
          rw [hc0, zero_smul])]
        simp [MvPolynomial.coeff_monomial]
      rw [hLHS, Finset.smul_sum]
      change _ = Θ (b ⊗ₜ[K₀] ∑ s ∈ P₀.support, P₀.coeff s • grMonom ε_R w₀ hw₀ d s)
      rw [TensorProduct.tmul_sum, map_sum]
      apply Finset.sum_congr rfl
      intro s _
      rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_comm]
      dsimp [grMonom]
      split_ifs with hs_deg
      · rw [hΘ _ _ _, smul_smul]
        congr 1
        apply Subtype.ext
        change Ideal.Quotient.mk _ (s.prod fun a e => φ (w₀ a) ^ e) =
          Ideal.Quotient.mk _ (φ (s.prod fun a e => w₀ a ^ e))
        congr 1
        refine Finsupp.induction s ?_ ?_
        · simp
        · intro a e s' _ _ ih
          rw [Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _),
            Finsupp.prod_single_index (h := fun x k => φ (w₀ x) ^ k) (pow_zero _),
            Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _),
            Finsupp.prod_single_index (h := fun x k => w₀ x ^ k) (pow_zero _),
            map_mul, map_pow, ih]
      · simp

    let u : Fin N → S := ψ₁₀ ∘ y₀
    let x : Fin N → S := ψ₂₀ ∘ x₂
    have hu_mem : ∀ a : Fin N, u a ∈ RingHom.ker ε_S := by
      intro a; rw [hMap₁]; exact Ideal.mem_map_of_mem ψ₁₀ (hy₀_mem a)
    have hx_mem : ∀ b : Fin N, x b ∈ RingHom.ker ε_S := by
      intro b; rw [hMap₂]; exact Ideal.mem_map_of_mem ψ₂₀ (hx₂_mem b)

    have hKer_S_x : ∀ (d : ℕ) (P : MvPolynomial (Fin N) L),
        P ∈ MvPolynomial.homogeneousSubmodule (Fin N) L d →
        (evalGr ε_S hSurj_S x hx_mem d P = 0 ↔ P ∈ Ideal.span {MvPolynomial.map ι₂ F₂}) := by
      intro d P hP
      obtain ⟨Θ₂_d, hΘ₂_d⟩ :=
        hFlatBC ι₂ alg₂ ε₂ hε₂_id hSurj₂ ε_S hSurj_S ψ₂₀ hψ₂₀_flat hComp₂ hMap₂ d
      let b_LK₂ := Module.Basis.ofVectorSpace K₂ L
      let π₂ : Module.Basis.ofVectorSpaceIndex K₂ L → (L →ₗ[K₂] K₂) :=
        fun i => (Finsupp.lapply i).comp b_LK₂.repr.toLinearMap
      let P_coord : Module.Basis.ofVectorSpaceIndex K₂ L → MvPolynomial (Fin N) K₂ :=
        fun i => ∑ s ∈ P.support, MvPolynomial.monomial s (π₂ i (P.coeff s))
      have hP_coord_hom : ∀ i, P_coord i ∈ MvPolynomial.homogeneousSubmodule (Fin N) K₂ d := by
        rw [MvPolynomial.mem_homogeneousSubmodule] at hP
        intro i
        refine Submodule.sum_mem _ fun s hs => ?_
        rw [MvPolynomial.mem_homogeneousSubmodule]
        have hs_deg : Finsupp.degree s = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp hs) (hP.coeff_eq_zero hne)
        rw [← hs_deg]
        exact MvPolynomial.isHomogeneous_monomial _ rfl
      let S_P : Finset (Module.Basis.ofVectorSpaceIndex K₂ L) :=
        P.support.biUnion (fun s => (b_LK₂.repr (P.coeff s)).support)
      have hP_decomp : P =
          ∑ i ∈ S_P, MvPolynomial.C (b_LK₂ i) * MvPolynomial.map ι₂ (P_coord i) := by
        ext t
        rw [MvPolynomial.coeff_sum]
        have hterm : ∀ i ∈ S_P,
            (MvPolynomial.C (b_LK₂ i) * MvPolynomial.map ι₂ (P_coord i)).coeff t =
              (π₂ i (P.coeff t)) • b_LK₂ i := by
          intro i _
          rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map, Algebra.smul_def, mul_comm]
          congr 2
          dsimp [P_coord]
          rw [MvPolynomial.coeff_sum]
          by_cases ht : t ∈ P.support
          · rw [Finset.sum_eq_single t]
            · simp [MvPolynomial.coeff_monomial]
            · intro s _ hst; simp [MvPolynomial.coeff_monomial, hst]
            · intro habs; exact False.elim (habs ht)
          · have hc0 : P.coeff t = 0 := by
              by_contra hne; exact ht (MvPolynomial.mem_support_iff.mpr hne)
            rw [hc0, map_zero]
            apply Finset.sum_eq_zero
            intro s hs
            have hst : s ≠ t := fun heq => ht (heq ▸ hs)
            simp [MvPolynomial.coeff_monomial, hst]
        rw [Finset.sum_congr rfl hterm]
        symm
        by_cases ht : t ∈ P.support
        · apply b_LK₂.repr.injective
          rw [map_sum]
          ext j
          rw [Finsupp.finsetSum_apply]
          have hrepr : ∀ i ∈ S_P, (b_LK₂.repr ((π₂ i (P.coeff t)) • b_LK₂ i)) j =
              if i = j then (b_LK₂.repr (P.coeff t)) i else 0 := by
            intro i _
            rw [map_smul, b_LK₂.repr_self, Finsupp.smul_single', mul_one, Finsupp.single_apply]
            rfl
          rw [Finset.sum_congr rfl hrepr, Finset.sum_ite_eq']
          split_ifs with hjS
          · rfl
          · symm
            by_contra hne
            exact hjS (Finset.mem_biUnion.mpr ⟨t, ht, Finsupp.mem_support_iff.mpr hne⟩)
        · have hc0 : P.coeff t = 0 := by
            by_contra hne; exact ht (MvPolynomial.mem_support_iff.mpr hne)
          rw [hc0]
          apply Finset.sum_eq_zero
          intro i _; rw [map_zero, zero_smul]
      constructor
      · intro hev0
        have hsum_tp : ∑ i ∈ S_P, (b_LK₂ i) ⊗ₜ[K₂] (evalGr ε₂ hSurj₂ x₂ hx₂_mem d (P_coord i)) = 0 := by
          apply Θ₂_d.injective
          rw [map_zero, map_sum]
          conv_rhs => rw [← hev0, hP_decomp, map_sum]
          apply Finset.sum_congr rfl
          intro i _
          exact (hEvalGrBC ι₂ alg₂ ε₂ hε₂_id hSurj₂ ε_S hSurj_S ψ₂₀ hComp₂ hMap₂
            x₂ hx₂_mem hx_mem d Θ₂_d hΘ₂_d (b_LK₂ i) (P_coord i)).symm
        have hi_mem : ∀ i ∈ S_P, P_coord i ∈ Ideal.span {F₂} := by
          intro i hiS
          apply (hF₂_iff d (P_coord i) (hP_coord_hom i)).mp
          rw [← hEvalGrZeroIff alg₂ ε₂ hε₂_id hSurj₂ x₂ hx₂_mem d (P_coord i) (hP_coord_hom i)]
          let proj_i : TensorProduct K₂ L ↥(grSub ε₂ d) →ₗ[K₂] ↥(grSub ε₂ d) :=
            (TensorProduct.lid K₂ ↥(grSub ε₂ d)).toLinearMap.comp
              (LinearMap.rTensor ↥(grSub ε₂ d) (π₂ i))
          have hproj0 : proj_i
              (∑ j ∈ S_P, (b_LK₂ j) ⊗ₜ[K₂] (evalGr ε₂ hSurj₂ x₂ hx₂_mem d (P_coord j))) = 0 := by
            rw [hsum_tp, map_zero]
          rw [map_sum] at hproj0
          have hproj_term : ∀ j ∈ S_P,
              proj_i ((b_LK₂ j) ⊗ₜ[K₂] (evalGr ε₂ hSurj₂ x₂ hx₂_mem d (P_coord j))) =
                if j = i then evalGr ε₂ hSurj₂ x₂ hx₂_mem d (P_coord j) else 0 := by
            intro j _
            dsimp [proj_i, π₂]
            rw [b_LK₂.repr_self, Finsupp.single_apply]
            split_ifs <;> simp
          rw [Finset.sum_congr rfl hproj_term, Finset.sum_ite_eq' S_P i] at hproj0
          simpa [hiS] using hproj0
        rw [hP_decomp]
        refine Submodule.sum_mem _ fun i hiS => ?_
        rcases Ideal.mem_span_singleton.mp (hi_mem i hiS) with ⟨G_i, hG_i⟩
        rw [hG_i, map_mul]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton.mpr ⟨_, rfl⟩)
      · intro hmem_F₂
        have hF₂L_hom : MvPolynomial.map ι₂ F₂ ∈ MvPolynomial.homogeneousSubmodule (Fin N) L 2 := by
          rw [MvPolynomial.mem_homogeneousSubmodule]
          exact ((MvPolynomial.mem_homogeneousSubmodule 2 F₂).mp hF₂_hom).map ι₂
        rcases homog_mem_span_quad hF₂L_hom hP hmem_F₂ with ⟨_, rfl⟩ | ⟨hd2, H, hH_hom, rfl⟩
        · exact map_zero _
        · let H_coord : Module.Basis.ofVectorSpaceIndex K₂ L → MvPolynomial (Fin N) K₂ :=
            fun i => ∑ s ∈ H.support, MvPolynomial.monomial s (π₂ i (H.coeff s))
          have hH_coord_hom : ∀ i, H_coord i ∈ MvPolynomial.homogeneousSubmodule (Fin N) K₂ (d - 2) := by
            rw [MvPolynomial.mem_homogeneousSubmodule] at hH_hom
            intro i
            refine Submodule.sum_mem _ fun s hs => ?_
            rw [MvPolynomial.mem_homogeneousSubmodule]
            have hs_deg : Finsupp.degree s = d - 2 := by
              by_contra hne
              exact (MvPolynomial.mem_support_iff.mp hs) (hH_hom.coeff_eq_zero hne)
            rw [← hs_deg]
            exact MvPolynomial.isHomogeneous_monomial _ rfl
          let S_H : Finset (Module.Basis.ofVectorSpaceIndex K₂ L) :=
            H.support.biUnion (fun s => (b_LK₂.repr (H.coeff s)).support)
          have hH_decomp : H =
              ∑ i ∈ S_H, MvPolynomial.C (b_LK₂ i) * MvPolynomial.map ι₂ (H_coord i) := by
            ext t
            rw [MvPolynomial.coeff_sum]
            have hterm : ∀ i ∈ S_H,
                (MvPolynomial.C (b_LK₂ i) * MvPolynomial.map ι₂ (H_coord i)).coeff t =
                  (π₂ i (H.coeff t)) • b_LK₂ i := by
              intro i _
              rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map, Algebra.smul_def, mul_comm]
              congr 2
              dsimp [H_coord]
              rw [MvPolynomial.coeff_sum]
              by_cases ht : t ∈ H.support
              · rw [Finset.sum_eq_single t]
                · simp [MvPolynomial.coeff_monomial]
                · intro s _ hst; simp [MvPolynomial.coeff_monomial, hst]
                · intro habs; exact False.elim (habs ht)
              · have hc0 : H.coeff t = 0 := by
                  by_contra hne; exact ht (MvPolynomial.mem_support_iff.mpr hne)
                rw [hc0, map_zero]
                apply Finset.sum_eq_zero
                intro s hs
                have hst : s ≠ t := fun heq => ht (heq ▸ hs)
                simp [MvPolynomial.coeff_monomial, hst]
            rw [Finset.sum_congr rfl hterm]
            symm
            by_cases ht : t ∈ H.support
            · apply b_LK₂.repr.injective
              rw [map_sum]
              ext j
              rw [Finsupp.finsetSum_apply]
              have hrepr : ∀ i ∈ S_H, (b_LK₂.repr ((π₂ i (H.coeff t)) • b_LK₂ i)) j =
                  if i = j then (b_LK₂.repr (H.coeff t)) i else 0 := by
                intro i _
                rw [map_smul, b_LK₂.repr_self, Finsupp.smul_single', mul_one, Finsupp.single_apply]
                rfl
              rw [Finset.sum_congr rfl hrepr, Finset.sum_ite_eq']
              split_ifs with hjS
              · rfl
              · symm
                by_contra hne
                exact hjS (Finset.mem_biUnion.mpr ⟨t, ht, Finsupp.mem_support_iff.mpr hne⟩)
            · have hc0 : H.coeff t = 0 := by
                by_contra hne; exact ht (MvPolynomial.mem_support_iff.mpr hne)
              rw [hc0]
              apply Finset.sum_eq_zero
              intro i _; rw [map_zero, zero_smul]
          rw [hH_decomp, Finset.mul_sum, map_sum]
          apply Finset.sum_eq_zero
          intro i _
          have hmul_eq : MvPolynomial.map ι₂ F₂ *
              (MvPolynomial.C (b_LK₂ i) * MvPolynomial.map ι₂ (H_coord i)) =
              MvPolynomial.C (b_LK₂ i) * MvPolynomial.map ι₂ (F₂ * H_coord i) := by
            rw [map_mul]; ring
          rw [hmul_eq, hEvalGrBC ι₂ alg₂ ε₂ hε₂_id hSurj₂ ε_S hSurj_S ψ₂₀ hComp₂ hMap₂
            x₂ hx₂_mem hx_mem d Θ₂_d hΘ₂_d (b_LK₂ i) (F₂ * H_coord i)]
          have hFH_hom : F₂ * H_coord i ∈ MvPolynomial.homogeneousSubmodule (Fin N) K₂ d := by
            have hd_eq : 2 + (d - 2) = d := by omega
            rw [← hd_eq, MvPolynomial.mem_homogeneousSubmodule]
            exact ((MvPolynomial.mem_homogeneousSubmodule 2 F₂).mp hF₂_hom).mul
              ((MvPolynomial.mem_homogeneousSubmodule (d - 2) (H_coord i)).mp (hH_coord_hom i))
          have hFH_zero : evalGr ε₂ hSurj₂ x₂ hx₂_mem d (F₂ * H_coord i) = 0 := by
            rw [hEvalGrZeroIff alg₂ ε₂ hε₂_id hSurj₂ x₂ hx₂_mem d _ hFH_hom]
            exact (hF₂_iff d (F₂ * H_coord i) hFH_hom).mpr (Ideal.mem_span_singleton.mpr ⟨_, rfl⟩)
          rw [hFH_zero, TensorProduct.tmul_zero, map_zero]

    let σ_R : MvPolynomial (Fin N) L →+* MvPolynomial (Fin N) L :=
      MvPolynomial.eval₂Hom MvPolynomial.C
        (fun a : Fin N => ∑ b : Fin N, MvPolynomial.C (R_inv a b) * MvPolynomial.X b)
    let σ_L : MvPolynomial (Fin N) L →+* MvPolynomial (Fin N) L :=
      MvPolynomial.eval₂Hom MvPolynomial.C
        (fun a : Fin N => ∑ b : Fin N, MvPolynomial.C (L_inv a b) * MvPolynomial.X b)
    have hσ_RL : σ_L.comp σ_R = RingHom.id _ := linear_eval₂_comp_eq_id R_inv L_inv hRL
    have hσ_LR : σ_R.comp σ_L = RingHom.id _ := linear_eval₂_comp_eq_id L_inv R_inv hLR

    have hEvalGr_varChange : ∀ (d : ℕ) (P : MvPolynomial (Fin N) L),
        P ∈ MvPolynomial.homogeneousSubmodule (Fin N) L d →
        evalGr ε_S hSurj_S u hu_mem d P = evalGr ε_S hSurj_S x hx_mem d (σ_R P) := by
      intro d P hP
      rw [MvPolynomial.mem_homogeneousSubmodule] at hP
      let R_tilde : Fin N → Fin N → S := fun a b => Function.surjInv hSurj_S (R_inv a b)
      have hR_tilde_eps : ∀ a b : Fin N, ε_S (R_tilde a b) = R_inv a b :=
        fun a b => Function.surjInv_eq hSurj_S (R_inv a b)
      let w : Fin N → S := fun a => ∑ b : Fin N, R_tilde a b * x b
      have hw_mem : ∀ a : Fin N, w a ∈ RingHom.ker ε_S := fun a =>
        Submodule.sum_mem _ fun b _ => Ideal.mul_mem_left _ _ (hx_mem b)
      have huw_sub : ∀ a : Fin N, u a - w a ∈ (RingHom.ker ε_S) ^ 2 := by
        intro a
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
        change Ideal.Quotient.mk ((RingHom.ker ε_S) ^ 2) (ψ₁₀ (y₀ a)) = _
        rw [← hbu_S_val a, hbu_expand a, AddSubmonoidClass.coe_finsetSum, map_sum]
        apply Finset.sum_congr rfl
        intro b _
        rw [← hR_tilde_eps a b, hGrSmulEps ε_S hSurj_S 1 (R_tilde a b) (bx_S b)]
        change Ideal.Quotient.mk ((RingHom.ker ε_S) ^ 2) (R_tilde a b) * (bx_S b).1 = _
        rw [hbx_S_val b, ← map_mul]
        rfl
      have hMonom_eq : ∀ s : Fin N →₀ ℕ, Finsupp.degree s = d →
          grMonom ε_S u hu_mem d s = evalGr ε_S hSurj_S x hx_mem d (σ_R (MvPolynomial.monomial s 1)) := by
        intro s hs_deg
        have huw_gr : grMonom ε_S u hu_mem d s = grMonom ε_S w hw_mem d s := by
          dsimp [grMonom]
          simp only [hs_deg, ↓reduceDIte]
          apply Subtype.ext
          change Ideal.Quotient.mk ((RingHom.ker ε_S) ^ (d + 1)) (s.prod fun a e => u a ^ e) =
            Ideal.Quotient.mk ((RingHom.ker ε_S) ^ (d + 1)) (s.prod fun a e => w a ^ e)
          rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem, ← hs_deg]
          exact finsupp_prod_sub_mem_pow_succ (RingHom.ker ε_S) u w hu_mem hw_mem huw_sub s
        rw [huw_gr]
        let g_S : Fin N → MvPolynomial (Fin N) S :=
          fun a => ∑ b : Fin N, MvPolynomial.C (R_tilde a b) * MvPolynomial.X b
        let W_S : MvPolynomial (Fin N) S :=
          MvPolynomial.eval₂ MvPolynomial.C g_S (MvPolynomial.monomial s (1 : S))
        have hg_S_hom : ∀ a : Fin N, (g_S a).IsHomogeneous 1 := by
          intro a
          change g_S a ∈ MvPolynomial.homogeneousSubmodule (Fin N) S 1
          refine Submodule.sum_mem _ fun b _ => ?_
          rw [MvPolynomial.mem_homogeneousSubmodule]
          exact (MvPolynomial.isHomogeneous_X S b).C_mul (R_tilde a b)
        have hWS_hom : W_S.IsHomogeneous d := by
          have hmon_hom : (MvPolynomial.monomial s (1 : S)).IsHomogeneous d :=
            MvPolynomial.isHomogeneous_monomial 1 hs_deg
          have h1d := hmon_hom.eval₂ MvPolynomial.C g_S
            (fun r => MvPolynomial.isHomogeneous_C (Fin N) r) hg_S_hom
          rwa [one_mul] at h1d
        have heval_WS : MvPolynomial.eval x W_S = (s.prod fun a e => w a ^ e) := by
          let compHom : MvPolynomial (Fin N) S →+* S :=
            (MvPolynomial.eval x).comp (MvPolynomial.eval₂Hom MvPolynomial.C g_S)
          have hcomp_eq : compHom = MvPolynomial.eval w := by
            apply MvPolynomial.ringHom_ext
            · intro r; simp [compHom]
            · intro a
              simp only [compHom, RingHom.comp_apply, MvPolynomial.coe_eval₂Hom,
                MvPolynomial.eval₂_X, MvPolynomial.eval_X, g_S, map_sum, map_mul,
                MvPolynomial.eval_C, w]
          change compHom (MvPolynomial.monomial s 1) = _
          rw [hcomp_eq, MvPolynomial.eval_monomial, one_mul]
        have hmap_WS : MvPolynomial.map ε_S W_S = σ_R (MvPolynomial.monomial s (1 : L)) := by
          let homL : MvPolynomial (Fin N) S →+* MvPolynomial (Fin N) L :=
            (MvPolynomial.map ε_S).comp (MvPolynomial.eval₂Hom MvPolynomial.C g_S)
          let homR : MvPolynomial (Fin N) S →+* MvPolynomial (Fin N) L :=
            σ_R.comp (MvPolynomial.map ε_S)
          have hhom_eq : homL = homR := by
            apply MvPolynomial.ringHom_ext
            · intro r; simp [homL, homR, σ_R]
            · intro a
              simp only [homL, homR, RingHom.comp_apply, MvPolynomial.coe_eval₂Hom,
                MvPolynomial.eval₂_X, MvPolynomial.map_X, g_S, σ_R, map_sum, map_mul,
                MvPolynomial.map_C, hR_tilde_eps]
          have h1 : homL (MvPolynomial.monomial s 1) = MvPolynomial.map ε_S W_S := rfl
          rw [← h1, hhom_eq]
          change σ_R (MvPolynomial.map ε_S (MvPolynomial.monomial s 1)) = _
          rw [MvPolynomial.map_monomial, map_one]
        have hgr_w : grMonom ε_S w hw_mem d s =
            ∑ t ∈ W_S.support, ε_S (W_S.coeff t) • grMonom ε_S x hx_mem d t := by
          dsimp [grMonom]
          simp only [hs_deg, ↓reduceDIte]
          apply Subtype.ext
          rw [AddSubmonoidClass.coe_finsetSum]
          change Ideal.Quotient.mk ((RingHom.ker ε_S) ^ (d + 1)) (s.prod fun a e => w a ^ e) = _
          rw [← heval_WS]
          have hWS_sum : MvPolynomial.eval x W_S =
              ∑ t ∈ W_S.support, MvPolynomial.eval x (MvPolynomial.monomial t (W_S.coeff t)) := by
            conv_lhs => rw [MvPolynomial.as_sum W_S]
            exact map_sum (MvPolynomial.eval x) _ W_S.support
          rw [hWS_sum, map_sum]
          apply Finset.sum_congr rfl
          intro t ht
          have ht_deg : Finsupp.degree t = d := by
            by_contra hne
            exact (MvPolynomial.mem_support_iff.mp ht) (hWS_hom.coeff_eq_zero hne)
          rw [hGrSmulEps ε_S hSurj_S d (W_S.coeff t) _]
          simp only [ht_deg, ↓reduceDIte, MvPolynomial.eval_monomial]
          rfl
        rw [hgr_w, ← hmap_WS]
        change _ = ∑ t ∈ (MvPolynomial.map ε_S W_S).support,
          (MvPolynomial.map ε_S W_S).coeff t • grMonom ε_S x hx_mem d t
        symm
        refine Finset.sum_subset (MvPolynomial.support_map_subset ε_S W_S) ?_
        intro t _ ht_not
        have hc0 : (MvPolynomial.map ε_S W_S).coeff t = 0 := by
          by_contra hne; exact ht_not (MvPolynomial.mem_support_iff.mpr hne)
        rw [MvPolynomial.coeff_map] at hc0 ⊢
        rw [hc0, zero_smul]
      have hP_sum : P = ∑ s ∈ P.support, P.coeff s • MvPolynomial.monomial s (1 : L) := by
        conv_lhs => rw [MvPolynomial.as_sum P]
        apply Finset.sum_congr rfl
        intro s _
        rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
      have hσ_sum : σ_R P = ∑ s ∈ P.support, P.coeff s • σ_R (MvPolynomial.monomial s (1 : L)) := by
        conv_lhs => rw [hP_sum]
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro s _
        rw [MvPolynomial.smul_eq_C_mul, map_mul, MvPolynomial.smul_eq_C_mul]
        simp [σ_R]
      rw [hσ_sum, map_sum]
      change ∑ s ∈ P.support, P.coeff s • grMonom ε_S u hu_mem d s = _
      apply Finset.sum_congr rfl
      intro s hs
      have hs_deg : Finsupp.degree s = d := by
        by_contra hne
        exact (MvPolynomial.mem_support_iff.mp hs) (hP.coeff_eq_zero hne)
      rw [map_smul, hMonom_eq s hs_deg]

    let F_pulled : MvPolynomial (Fin N) L := σ_L (MvPolynomial.map ι₂ F₂)
    have hF_pulled_hom : F_pulled ∈ MvPolynomial.homogeneousSubmodule (Fin N) L 2 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]
      have hF₂L : (MvPolynomial.map ι₂ F₂).IsHomogeneous 2 :=
        ((MvPolynomial.mem_homogeneousSubmodule 2 F₂).mp hF₂_hom).map ι₂
      have hgL : ∀ a : Fin N,
          (∑ b : Fin N, MvPolynomial.C (L_inv a b) * MvPolynomial.X b).IsHomogeneous 1 := by
        intro a
        change _ ∈ MvPolynomial.homogeneousSubmodule (Fin N) L 1
        refine Submodule.sum_mem _ fun b _ => ?_
        rw [MvPolynomial.mem_homogeneousSubmodule]
        exact (MvPolynomial.isHomogeneous_X L b).C_mul (L_inv a b)
      have h12 := hF₂L.eval₂ MvPolynomial.C _
        (fun r => MvPolynomial.isHomogeneous_C (Fin N) r) hgL
      rwa [one_mul] at h12
    have hσR_F_pulled : σ_R F_pulled = MvPolynomial.map ι₂ F₂ := by
      change (σ_R.comp σ_L) (MvPolynomial.map ι₂ F₂) = _
      rw [hσ_LR, RingHom.id_apply]
    have hF_pulled_ne : F_pulled ≠ 0 := by
      intro h0
      have hmap0 : MvPolynomial.map ι₂ F₂ = 0 := by rw [← hσR_F_pulled, h0, map_zero]
      exact hF₂_ne (MvPolynomial.map_injective ι₂ ι₂.injective (hmap0.trans (map_zero _).symm))
    have hKer_S_u : ∀ (d : ℕ) (P : MvPolynomial (Fin N) L),
        P ∈ MvPolynomial.homogeneousSubmodule (Fin N) L d →
        (evalGr ε_S hSurj_S u hu_mem d P = 0 ↔ P ∈ Ideal.span {F_pulled}) := by
      intro d P hP
      rw [hEvalGr_varChange d P hP]
      have hσR_P_hom : σ_R P ∈ MvPolynomial.homogeneousSubmodule (Fin N) L d := by
        rw [MvPolynomial.mem_homogeneousSubmodule] at hP ⊢
        have hgR : ∀ a : Fin N,
            (∑ b : Fin N, MvPolynomial.C (R_inv a b) * MvPolynomial.X b).IsHomogeneous 1 := by
          intro a
          change _ ∈ MvPolynomial.homogeneousSubmodule (Fin N) L 1
          refine Submodule.sum_mem _ fun b _ => ?_
          rw [MvPolynomial.mem_homogeneousSubmodule]
          exact (MvPolynomial.isHomogeneous_X L b).C_mul (R_inv a b)
        have h1d := hP.eval₂ MvPolynomial.C _
          (fun r => MvPolynomial.isHomogeneous_C (Fin N) r) hgR
        rwa [one_mul] at h1d
      rw [hKer_S_x d (σ_R P) hσR_P_hom, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
      constructor
      · rintro ⟨G, hG⟩
        refine ⟨σ_L G, ?_⟩
        have h1 : (σ_L.comp σ_R) P = σ_L (MvPolynomial.map ι₂ F₂ * G) := by
          rw [RingHom.comp_apply, hG]
        rw [hσ_RL, RingHom.id_apply, map_mul] at h1
        exact h1
      · rintro ⟨G, rfl⟩
        exact ⟨σ_R G, by rw [map_mul, hσR_F_pulled]⟩

    obtain ⟨Θ₁_2, hΘ₁_2⟩ := hFlatBC ι₁ alg₁ ε₁ hε₁_id hSurj₁ ε_S hSurj_S ψ₁₀ hψ₁₀_flat hComp₁ hMap₁ 2
    let b_LK₁ := Module.Basis.ofVectorSpace K₁ L
    let π₁ : Module.Basis.ofVectorSpaceIndex K₁ L → (L →ₗ[K₁] K₁) :=
      fun j => (Finsupp.lapply j).comp b_LK₁.repr.toLinearMap
    let F_coord : Module.Basis.ofVectorSpaceIndex K₁ L → MvPolynomial (Fin N) K₁ :=
      fun j => ∑ s ∈ F_pulled.support, MvPolynomial.monomial s (π₁ j (F_pulled.coeff s))
    have hF_coord_hom : ∀ j, F_coord j ∈ MvPolynomial.homogeneousSubmodule (Fin N) K₁ 2 := by
      have hFp := (MvPolynomial.mem_homogeneousSubmodule 2 F_pulled).mp hF_pulled_hom
      intro j
      refine Submodule.sum_mem _ fun s hs => ?_
      rw [MvPolynomial.mem_homogeneousSubmodule]
      have hs_deg : Finsupp.degree s = 2 := by
        by_contra hne
        exact (MvPolynomial.mem_support_iff.mp hs) (hFp.coeff_eq_zero hne)
      rw [← hs_deg]
      exact MvPolynomial.isHomogeneous_monomial _ rfl
    let S_F : Finset (Module.Basis.ofVectorSpaceIndex K₁ L) :=
      F_pulled.support.biUnion (fun s => (b_LK₁.repr (F_pulled.coeff s)).support)
    have hF_decomp : F_pulled =
        ∑ j ∈ S_F, MvPolynomial.C (b_LK₁ j) * MvPolynomial.map ι₁ (F_coord j) := by
      ext t
      rw [MvPolynomial.coeff_sum]
      have hterm : ∀ j ∈ S_F,
          (MvPolynomial.C (b_LK₁ j) * MvPolynomial.map ι₁ (F_coord j)).coeff t =
            (π₁ j (F_pulled.coeff t)) • b_LK₁ j := by
        intro j _
        rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map, Algebra.smul_def, mul_comm]
        congr 2
        dsimp [F_coord]
        rw [MvPolynomial.coeff_sum]
        by_cases ht : t ∈ F_pulled.support
        · rw [Finset.sum_eq_single t]
          · simp [MvPolynomial.coeff_monomial]
          · intro s _ hst; simp [MvPolynomial.coeff_monomial, hst]
          · intro habs; exact False.elim (habs ht)
        · have hc0 : F_pulled.coeff t = 0 := by
            by_contra hne; exact ht (MvPolynomial.mem_support_iff.mpr hne)
          rw [hc0, map_zero]
          apply Finset.sum_eq_zero
          intro s hs
          have hst : s ≠ t := fun heq => ht (heq ▸ hs)
          simp [MvPolynomial.coeff_monomial, hst]
      rw [Finset.sum_congr rfl hterm]
      symm
      by_cases ht : t ∈ F_pulled.support
      · apply b_LK₁.repr.injective
        rw [map_sum]
        ext k
        rw [Finsupp.finsetSum_apply]
        have hrepr : ∀ j ∈ S_F, (b_LK₁.repr ((π₁ j (F_pulled.coeff t)) • b_LK₁ j)) k =
            if j = k then (b_LK₁.repr (F_pulled.coeff t)) j else 0 := by
          intro j _
          rw [map_smul, b_LK₁.repr_self, Finsupp.smul_single', mul_one, Finsupp.single_apply]
          rfl
        rw [Finset.sum_congr rfl hrepr, Finset.sum_ite_eq']
        split_ifs with hkS
        · rfl
        · symm
          by_contra hne
          exact hkS (Finset.mem_biUnion.mpr ⟨t, ht, Finsupp.mem_support_iff.mpr hne⟩)
      · have hc0 : F_pulled.coeff t = 0 := by
          by_contra hne; exact ht (MvPolynomial.mem_support_iff.mpr hne)
        rw [hc0]
        apply Finset.sum_eq_zero
        intro j _; rw [map_zero, zero_smul]

    have hex_j₀ : ∃ j₀ ∈ S_F, F_coord j₀ ≠ 0 := by
      by_contra hall
      apply hF_pulled_ne
      rw [hF_decomp]
      apply Finset.sum_eq_zero
      intro j hj
      have hj0 : F_coord j = 0 := by
        by_contra hne; exact hall ⟨j, hj, hne⟩
      rw [hj0, map_zero, mul_zero]
    rcases hex_j₀ with ⟨j₀, hj₀_mem, hQ₀_ne⟩
    let Q₀ : MvPolynomial (Fin N) K₁ := F_coord j₀
    have hQ₀_hom : Q₀ ∈ MvPolynomial.homogeneousSubmodule (Fin N) K₁ 2 := hF_coord_hom j₀

    have hFp_eval0 : evalGr ε_S hSurj_S u hu_mem 2 F_pulled = 0 :=
      (hKer_S_u 2 F_pulled hF_pulled_hom).mpr (Ideal.subset_span rfl)
    have hF_tp_zero : ∑ j ∈ S_F, (b_LK₁ j) ⊗ₜ[K₁] (evalGr ε₁ hSurj₁ y₀ hy₀_mem 2 (F_coord j)) = 0 := by
      apply Θ₁_2.injective
      rw [map_zero, map_sum]
      conv_rhs => rw [← hFp_eval0, hF_decomp, map_sum]
      apply Finset.sum_congr rfl
      intro j _
      exact (hEvalGrBC ι₁ alg₁ ε₁ hε₁_id hSurj₁ ε_S hSurj_S ψ₁₀ hComp₁ hMap₁
        y₀ hy₀_mem hu_mem 2 Θ₁_2 hΘ₁_2 (b_LK₁ j) (F_coord j)).symm
    have hQ₀_evalGr0 : evalGr ε₁ hSurj₁ y₀ hy₀_mem 2 Q₀ = 0 := by
      let proj_j₀ : TensorProduct K₁ L ↥(grSub ε₁ 2) →ₗ[K₁] ↥(grSub ε₁ 2) :=
        (TensorProduct.lid K₁ ↥(grSub ε₁ 2)).toLinearMap.comp
          (LinearMap.rTensor ↥(grSub ε₁ 2) (π₁ j₀))
      have hproj0 : proj_j₀
          (∑ j ∈ S_F, (b_LK₁ j) ⊗ₜ[K₁] (evalGr ε₁ hSurj₁ y₀ hy₀_mem 2 (F_coord j))) = 0 := by
        rw [hF_tp_zero, map_zero]
      rw [map_sum] at hproj0
      have hproj_term : ∀ j ∈ S_F,
          proj_j₀ ((b_LK₁ j) ⊗ₜ[K₁] (evalGr ε₁ hSurj₁ y₀ hy₀_mem 2 (F_coord j))) =
            if j = j₀ then evalGr ε₁ hSurj₁ y₀ hy₀_mem 2 (F_coord j) else 0 := by
        intro j _
        dsimp [proj_j₀, π₁]
        rw [b_LK₁.repr_self, Finsupp.single_apply]
        split_ifs <;> simp
      rw [Finset.sum_congr rfl hproj_term, Finset.sum_ite_eq' S_F j₀] at hproj0
      simpa [hj₀_mem] using hproj0
    have hQ₀_eval_mem : MvPolynomial.eval₂ alg₁ y₀ Q₀ ∈ (RingHom.ker ε₁) ^ 3 :=
      (hEvalGrZeroIff alg₁ ε₁ hε₁_id hSurj₁ y₀ hy₀_mem 2 Q₀ hQ₀_hom).mp hQ₀_evalGr0

    have hmapQ₀_hom : MvPolynomial.map ι₁ Q₀ ∈ MvPolynomial.homogeneousSubmodule (Fin N) L 2 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]
      exact ((MvPolynomial.mem_homogeneousSubmodule 2 Q₀).mp hQ₀_hom).map ι₁
    have hmapQ₀_span : MvPolynomial.map ι₁ Q₀ ∈ Ideal.span {F_pulled} := by
      apply (hKer_S_u 2 (MvPolynomial.map ι₁ Q₀) hmapQ₀_hom).mp
      have h1mul : MvPolynomial.map ι₁ Q₀ = MvPolynomial.C (1 : L) * MvPolynomial.map ι₁ Q₀ := by
        simp
      rw [h1mul, hEvalGrBC ι₁ alg₁ ε₁ hε₁_id hSurj₁ ε_S hSurj_S ψ₁₀ hComp₁ hMap₁
        y₀ hy₀_mem hu_mem 2 Θ₁_2 hΘ₁_2 1 Q₀, hQ₀_evalGr0, TensorProduct.tmul_zero, map_zero]
    have hscale_ex : ∃ c_scale : L, c_scale ≠ 0 ∧
        MvPolynomial.map ι₁ Q₀ = MvPolynomial.C c_scale * F_pulled := by
      rcases homog_mem_span_quad hF_pulled_hom hmapQ₀_hom hmapQ₀_span with
        ⟨habs, _⟩ | ⟨_, H₀, hH₀_hom, hQ_eq⟩
      · omega
      · rw [MvPolynomial.mem_homogeneousSubmodule] at hH₀_hom
        let c_scale : L := H₀.coeff 0
        have hH₀_eq : H₀ = MvPolynomial.C c_scale := by
          ext s
          by_cases hs0 : s = 0
          · subst hs0; simp [c_scale]
          · have hs_deg : Finsupp.degree s ≠ 0 := by
              intro hdeg0
              apply hs0
              ext a
              simp only [Finsupp.coe_zero, Pi.zero_apply]
              have hle : s a ≤ Finsupp.degree s := by
                dsimp [Finsupp.degree]
                by_cases ha : a ∈ s.support
                · exact Finset.single_le_sum (fun _ _ => Nat.zero_le _) ha
                · have hsa : s a = 0 := Finsupp.notMem_support_iff.mp ha
                  omega
              omega
            rw [hH₀_hom.coeff_eq_zero hs_deg, MvPolynomial.coeff_C]
            simp [Ne.symm hs0]
        have hQ_C : MvPolynomial.map ι₁ Q₀ = MvPolynomial.C c_scale * F_pulled := by
          rw [hQ_eq, hH₀_eq, mul_comm]
        have hc_nz : c_scale ≠ 0 := by
          intro hc0
          rw [hc0, map_zero, zero_mul] at hQ_C
          exact hQ₀_ne (MvPolynomial.map_injective ι₁ ι₁.injective (hQ_C.trans (map_zero _).symm))
        exact ⟨c_scale, hc_nz, hQ_C⟩
    rcases hscale_ex with ⟨c_scale, hc_nz, hQ₀_map_eq⟩

    refine ⟨y₀, Q₀, L_inv, R_inv, c_scale, hy₀_mem, hNak_le, hy₀_nz, hQ₀_hom,
      ⟨hLR, hc_nz, hQ₀_map_eq⟩, ?_⟩
    intro d P₁ hP₁
    constructor
    · intro hP₁_mem_pow
      obtain ⟨Θ₁_d, hΘ₁_d⟩ :=
        hFlatBC ι₁ alg₁ ε₁ hε₁_id hSurj₁ ε_S hSurj_S ψ₁₀ hψ₁₀_flat hComp₁ hMap₁ d
      have hP₁_gr0 : evalGr ε₁ hSurj₁ y₀ hy₀_mem d P₁ = 0 :=
        (hEvalGrZeroIff alg₁ ε₁ hε₁_id hSurj₁ y₀ hy₀_mem d P₁ hP₁).mpr hP₁_mem_pow
      have hmapP₁_hom : MvPolynomial.map ι₁ P₁ ∈ MvPolynomial.homogeneousSubmodule (Fin N) L d := by
        rw [MvPolynomial.mem_homogeneousSubmodule]
        exact ((MvPolynomial.mem_homogeneousSubmodule d P₁).mp hP₁).map ι₁
      have hmapP₁_Fp : MvPolynomial.map ι₁ P₁ ∈ Ideal.span {F_pulled} := by
        apply (hKer_S_u d (MvPolynomial.map ι₁ P₁) hmapP₁_hom).mp
        have h1mul : MvPolynomial.map ι₁ P₁ = MvPolynomial.C (1 : L) * MvPolynomial.map ι₁ P₁ := by
          simp
        rw [h1mul, hEvalGrBC ι₁ alg₁ ε₁ hε₁_id hSurj₁ ε_S hSurj_S ψ₁₀ hComp₁ hMap₁
          y₀ hy₀_mem hu_mem d Θ₁_d hΘ₁_d 1 P₁, hP₁_gr0, TensorProduct.tmul_zero, map_zero]
      rcases Ideal.mem_span_singleton.mp hmapP₁_Fp with ⟨G_L, hG_L⟩
      have hFp_eq_Q : F_pulled = MvPolynomial.C c_scale⁻¹ * MvPolynomial.map ι₁ Q₀ := by
        rw [hQ₀_map_eq, ← mul_assoc, ← MvPolynomial.C_mul, inv_mul_cancel₀ hc_nz,
          MvPolynomial.C_1, one_mul]
      let H_L : MvPolynomial (Fin N) L := MvPolynomial.C c_scale⁻¹ * G_L
      have hmapP₁_Q : MvPolynomial.map ι₁ P₁ = MvPolynomial.map ι₁ Q₀ * H_L := by
        rw [hG_L, hFp_eq_Q]; ring
      let ι₁_lin : K₁ →ₗ[K₁] L := Algebra.linearMap K₁ L
      have hι₁_ker : LinearMap.ker ι₁_lin = ⊥ :=
        LinearMap.ker_eq_bot.mpr ι₁.injective
      obtain ⟨π₀, hπ₀⟩ := LinearMap.exists_leftInverse_of_injective ι₁_lin hι₁_ker
      have hπ₀_id : ∀ k : K₁, π₀ (ι₁ k) = k := fun k => LinearMap.congr_fun hπ₀ k
      let P_ret : MvPolynomial (Fin N) L → MvPolynomial (Fin N) K₁ :=
        fun f => ∑ s ∈ f.support, MvPolynomial.monomial s (π₀ (f.coeff s))
      have hPret_coeff : ∀ (f : MvPolynomial (Fin N) L) (t : Fin N →₀ ℕ),
          (P_ret f).coeff t = π₀ (f.coeff t) := by
        intro f t
        dsimp [P_ret]
        rw [MvPolynomial.coeff_sum]
        by_cases ht : t ∈ f.support
        · rw [Finset.sum_eq_single t]
          · simp [MvPolynomial.coeff_monomial]
          · intro s _ hst; simp [MvPolynomial.coeff_monomial, hst]
          · intro habs; exact False.elim (habs ht)
        · have hc0 : f.coeff t = 0 := by
            by_contra hne; exact ht (MvPolynomial.mem_support_iff.mpr hne)
          rw [hc0, map_zero]
          apply Finset.sum_eq_zero
          intro s hs
          have hst : s ≠ t := fun heq => ht (heq ▸ hs)
          simp [MvPolynomial.coeff_monomial, hst]
      have hP₁_retract : P₁ = Q₀ * P_ret H_L := by
        ext t
        have hL : P₁.coeff t = (P_ret (MvPolynomial.map ι₁ P₁)).coeff t := by
          rw [hPret_coeff, MvPolynomial.coeff_map, hπ₀_id]
        rw [hL, hmapP₁_Q, hPret_coeff, MvPolynomial.coeff_mul, MvPolynomial.coeff_mul, map_sum]
        apply Finset.sum_congr rfl
        intro p _
        rw [MvPolynomial.coeff_map, hPret_coeff]
        change π₀ ((Q₀.coeff p.1) • H_L.coeff p.2) = Q₀.coeff p.1 * π₀ (H_L.coeff p.2)
        rw [map_smul, smul_eq_mul]
      rw [hP₁_retract]
      exact Ideal.mem_span_singleton.mpr ⟨_, rfl⟩
    · intro hP₁_span
      rcases homog_mem_span_quad hQ₀_hom hP₁ hP₁_span with ⟨_, rfl⟩ | ⟨hd2, H₁, hH₁_hom, rfl⟩
      · simp
      · change MvPolynomial.eval₂ alg₁ y₀ (Q₀ * H₁) ∈ (RingHom.ker ε₁) ^ (d + 1)
        rw [MvPolynomial.eval₂_mul]
        have hH₁_mem : MvPolynomial.eval₂ alg₁ y₀ H₁ ∈ (RingHom.ker ε₁) ^ (d - 2) :=
          eval₂_mem_pow_of_homog alg₁ (RingHom.ker ε₁) y₀ hy₀_mem hH₁_hom
        have hmul_mem := Ideal.mul_mem_mul hQ₀_eval_mem hH₁_mem
        rw [← pow_add] at hmul_mem
        have hadd : 3 + (d - 2) = d + 1 := by omega
        rwa [hadd] at hmul_mem

  
  
  
  have hNakAway : ∀ (N : ℕ) (y₀ : Fin N → A₀),
      (∀ a : Fin N, y₀ a ∈ RingHom.ker ε₀) →
      RingHom.ker ε₀ ≤ Ideal.span (Set.range y₀) ⊔ (RingHom.ker ε₀) • (RingHom.ker ε₀) →
      (∀ a : Fin N, y₀ a ≠ 0) →
      ∃ (s₀ : A₀) (_hs₀ : ε₀ s₀ ≠ 0),
        ∀ (A' : Type u) [CommRing A'] (loc : A₀ →+* A'),
          @IsLocalization.Away A₀ _ s₀ A' _ loc.toAlgebra →
          let alg_A' : F →+* A' := loc.comp alg_A₀
          ∃ (ε' : A' →+* F) (y : Fin N → A') (_hε'_id : ε'.comp alg_A' = RingHom.id F),
            ε'.comp loc = ε₀ ∧
            RingHom.ker ε' = Ideal.span (Set.range y) ∧
            (∀ b : Fin N, y b ≠ 0) ∧
            ∀ (d : ℕ) (P : MvPolynomial (Fin N) F),
              P ∈ MvPolynomial.homogeneousSubmodule (Fin N) F d →
              (MvPolynomial.eval₂ alg_A' y P ∈ (RingHom.ker ε') ^ (d + 1) ↔
                MvPolynomial.eval₂ alg_A₀ y₀ P ∈ (RingHom.ker ε₀) ^ (d + 1)) := by
    intro N y₀ hy₀_mem hNak_le hy₀_nz
    let 𝔪₀ : Ideal A₀ := RingHom.ker ε₀
    have hm₀_fg : 𝔪₀.FG := by
      let _ : Algebra F A₀ := alg_A₀.toAlgebra
      have _ : Algebra.FiniteType F A₀ := hFT
      have _ : IsNoetherianRing A₀ := Algebra.FiniteType.isNoetherianRing F A₀
      exact IsNoetherian.noetherian 𝔪₀
    obtain ⟨s₀, hs₀_sub, hs₀_smul⟩ :=
      Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup hm₀_fg (le_refl 𝔪₀) hNak_le
    have hs₀_eps : ε₀ s₀ = 1 := by
      have h0 : ε₀ (s₀ - 1) = 0 := hs₀_sub
      rw [map_sub, map_one] at h0
      exact sub_eq_zero.mp h0
    have hs₀_nz_F : ε₀ s₀ ≠ 0 := by rw [hs₀_eps]; exact one_ne_zero
    have hs₀_ne : s₀ ≠ 0 := by
      intro h0; rw [h0, map_zero] at hs₀_nz_F; exact hs₀_nz_F rfl
    refine ⟨s₀, hs₀_nz_F, ?_⟩
    intro A' _ loc hAway alg_A'
    let _ : Algebra A₀ A' := loc.toAlgebra
    have hs₀_unit : IsUnit (ε₀ s₀) := isUnit_iff_ne_zero.mpr hs₀_nz_F
    let ε' : A' →+* F := IsLocalization.Away.lift s₀ hs₀_unit
    have hε'_loc : ε'.comp loc = ε₀ := by
      ext a; exact IsLocalization.Away.lift_eq s₀ hs₀_unit a
    have hε'_id : ε'.comp alg_A' = RingHom.id F := by
      change (ε'.comp loc).comp alg_A₀ = RingHom.id F
      rw [hε'_loc]; exact hε_id
    let y : Fin N → A' := fun b => loc (y₀ b)
    have hloc_inj : Function.Injective loc := by
      intro a₁ a₂ heq
      change algebraMap A₀ A' a₁ = algebraMap A₀ A' a₂ at heq
      rw [IsLocalization.eq_iff_exists (Submonoid.powers s₀) A'] at heq
      rcases heq with ⟨⟨c, hc⟩, hc_eq⟩
      rw [Submonoid.mem_powers_iff] at hc
      rcases hc with ⟨k, rfl⟩
      exact mul_left_cancel₀ (pow_ne_zero k hs₀_ne) hc_eq
    have hy_nz : ∀ b : Fin N, y b ≠ 0 := by
      intro b h0; apply hy₀_nz b; apply hloc_inj; rw [map_zero]; exact h0
    have hker_map : RingHom.ker ε' = Ideal.map loc 𝔪₀ := by
      apply le_antisymm
      · intro w hw
        obtain ⟨⟨a, s, hs⟩, hsurj⟩ := IsLocalization.surj (Submonoid.powers s₀) w
        change w * loc s = loc a at hsurj
        rw [Submonoid.mem_powers_iff] at hs
        rcases hs with ⟨k, rfl⟩
        have ha_ker : a ∈ 𝔪₀ := by
          change ε₀ a = 0
          rw [← hε'_loc, RingHom.comp_apply, ← hsurj, map_mul,
            show ε' w = 0 from hw, zero_mul]
        have hu : IsUnit (loc (s₀ ^ k)) :=
          IsLocalization.map_units A' (⟨s₀ ^ k, ⟨k, rfl⟩⟩ : Submonoid.powers s₀)
        rcases hu with ⟨u, hu_eq⟩
        have hw_eq : w = loc a * ↑u⁻¹ := by
          calc w = w * (↑u * ↑u⁻¹) := by rw [Units.mul_inv, mul_one]
            _ = (w * loc (s₀ ^ k)) * ↑u⁻¹ := by rw [hu_eq, mul_assoc]
            _ = loc a * ↑u⁻¹ := by rw [hsurj]
        rw [hw_eq]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem loc ha_ker)
      · rw [Ideal.map_le_iff_le_comap]
        intro a ha
        change ε' (loc a) = 0
        rw [show ε' (loc a) = (ε'.comp loc) a from rfl, hε'_loc]; exact ha
    have hmap_span : Ideal.map loc 𝔪₀ = Ideal.span (Set.range y) := by
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro z hz
        change loc z ∈ Ideal.span (Set.range y)
        have hsz : s₀ * z ∈ Ideal.span (Set.range y₀) :=
          hs₀_smul (Submodule.smul_mem_pointwise_smul z s₀ (𝔪₀ : Submodule A₀ A₀) hz)
        have hloc_sz : loc (s₀ * z) ∈ Ideal.map loc (Ideal.span (Set.range y₀)) :=
          Ideal.mem_map_of_mem loc hsz
        have hspan_y : Ideal.map loc (Ideal.span (Set.range y₀)) = Ideal.span (Set.range y) := by
          rw [Ideal.map_span, ← Set.range_comp]; rfl
        rw [hspan_y, map_mul] at hloc_sz
        have hu : IsUnit (loc s₀) :=
          IsLocalization.map_units A' (⟨s₀, ⟨1, pow_one s₀⟩⟩ : Submonoid.powers s₀)
        rcases hu with ⟨u, hu_eq⟩
        have hz_eq : loc z = ↑u⁻¹ * (loc s₀ * loc z) := by
          rw [← hu_eq, ← mul_assoc, Units.inv_mul, one_mul]
        rw [hz_eq]
        exact Ideal.mul_mem_left _ _ hloc_sz
      · rw [Ideal.span_le]
        rintro _ ⟨b, rfl⟩
        exact Ideal.mem_map_of_mem loc (hy₀_mem b)
    have hker_y : RingHom.ker ε' = Ideal.span (Set.range y) := hker_map.trans hmap_span
    refine ⟨ε', y, hε'_id, hε'_loc, hker_y, hy_nz, ?_⟩
    intro d P hP
    set z : A₀ := MvPolynomial.eval₂ alg_A₀ y₀ P
    have heval_loc : MvPolynomial.eval₂ alg_A' y P = loc z := by
      dsimp [z, alg_A', y]
      exact (MvPolynomial.hom_eval₂ P alg_A₀ loc y₀).symm
    rw [heval_loc, hker_map, ← Ideal.map_pow]
    constructor
    · intro hmem
      let J_pow : Ideal A₀ := 𝔪₀ ^ (d + 1)
      let K_loc : Ideal A' :=
        { carrier := { w : A' | ∃ k : ℕ, ∃ r ∈ J_pow, w * loc (s₀ ^ k) = loc r }
          zero_mem' := ⟨0, 0, J_pow.zero_mem, by simp⟩
          add_mem' := by
            rintro w₁ w₂ ⟨k₁, r₁, hr₁, hw₁⟩ ⟨k₂, r₂, hr₂, hw₂⟩
            refine ⟨k₁ + k₂, r₁ * s₀ ^ k₂ + r₂ * s₀ ^ k₁,
              J_pow.add_mem (Ideal.mul_mem_right _ _ hr₁) (Ideal.mul_mem_right _ _ hr₂), ?_⟩
            rw [pow_add, map_mul, map_add, map_mul, map_mul]
            calc (w₁ + w₂) * (loc (s₀ ^ k₁) * loc (s₀ ^ k₂))
                = (w₁ * loc (s₀ ^ k₁)) * loc (s₀ ^ k₂) + (w₂ * loc (s₀ ^ k₂)) * loc (s₀ ^ k₁) := by ring
              _ = loc r₁ * loc (s₀ ^ k₂) + loc r₂ * loc (s₀ ^ k₁) := by rw [hw₁, hw₂]
          smul_mem' := by
            rintro c w ⟨k, r, hr, hw⟩
            obtain ⟨⟨a, s, hs⟩, hcs⟩ := IsLocalization.surj (Submonoid.powers s₀) c
            change c * loc s = loc a at hcs
            rw [Submonoid.mem_powers_iff] at hs
            rcases hs with ⟨m_pow, rfl⟩
            refine ⟨m_pow + k, a * r, Ideal.mul_mem_left _ _ hr, ?_⟩
            change (c * w) * loc (s₀ ^ (m_pow + k)) = loc (a * r)
            rw [pow_add, map_mul, map_mul]
            calc (c * w) * (loc (s₀ ^ m_pow) * loc (s₀ ^ k))
                = (c * loc (s₀ ^ m_pow)) * (w * loc (s₀ ^ k)) := by ring
              _ = loc a * loc r := by rw [hcs, hw] }
      have hmap_le : Ideal.map loc J_pow ≤ K_loc := by
        rw [Ideal.map_le_iff_le_comap]
        intro r hr
        exact ⟨0, r, hr, by simp⟩
      obtain ⟨k, r, hr, hzr⟩ := hmap_le hmem
      rw [← map_mul] at hzr
      have hsk_z : s₀ ^ k * z = r := by rw [mul_comm]; exact hloc_inj hzr
      have hsk_mem : s₀ ^ k * z ∈ 𝔪₀ ^ (d + 1) := by rw [hsk_z]; exact hr
      have hsk_sub : ∀ n : ℕ, s₀ ^ n - 1 ∈ 𝔪₀ := by
        intro n
        induction n with
        | zero => simp
        | succ n ih =>
          have heq : s₀ ^ (n + 1) - 1 = s₀ * (s₀ ^ n - 1) + (s₀ - 1) := by ring
          rw [heq]
          exact 𝔪₀.add_mem (Ideal.mul_mem_left _ _ ih) hs₀_sub
      have hz_d : z ∈ 𝔪₀ ^ d := eval₂_mem_pow_of_homog alg_A₀ 𝔪₀ y₀ hy₀_mem hP
      have hsub_mem : (s₀ ^ k - 1) * z ∈ 𝔪₀ ^ (d + 1) := by
        rw [pow_succ']
        exact Ideal.mul_mem_mul (hsk_sub k) hz_d
      have hz_id : z = s₀ ^ k * z - (s₀ ^ k - 1) * z := by ring
      rw [hz_id]
      exact (𝔪₀ ^ (d + 1)).sub_mem hsk_mem hsub_mem
    · intro hz_mem
      exact Ideal.mem_map_of_mem loc hz_mem

  
  
  
  have hFieldTensorIff : ∀ (K : Type u) [Field K] [Algebra F K]
      (N : ℕ) (A' : Type u) [CommRing A'] [Algebra F A']
      (y : Fin N → A') (Q₀ : MvPolynomial (Fin N) F),
      Q₀ ∈ MvPolynomial.homogeneousSubmodule (Fin N) F 2 →
      (∀ (d₀ : ℕ) (P₀ : MvPolynomial (Fin N) F),
        P₀ ∈ MvPolynomial.homogeneousSubmodule (Fin N) F d₀ →
        (MvPolynomial.eval₂ (algebraMap F A') y P₀ ∈ (Ideal.span (Set.range y)) ^ (d₀ + 1) ↔
          P₀ ∈ Ideal.span {Q₀})) →
      ∀ (d : ℕ) (P : MvPolynomial (Fin N) K),
        P ∈ MvPolynomial.homogeneousSubmodule (Fin N) K d →
        (MvPolynomial.eval₂ Algebra.TensorProduct.includeLeftRingHom
          (fun a => (1 : K) ⊗ₜ[F] y a) P ∈
          (Ideal.span (Set.range fun a : Fin N => (1 : K) ⊗ₜ[F] y a)) ^ (d + 1) ↔
          P ∈ Ideal.span {MvPolynomial.map (algebraMap F K) Q₀}) := by
    intro K _ _ N A' _ _ y Q₀ hQ₀_hom hF_iff d P hP
    let I_F : Ideal A' := Ideal.span (Set.range y)
    let incR : A' →+* TensorProduct F K A' :=
      (Algebra.TensorProduct.includeRight : A' →ₐ[F] TensorProduct F K A').toRingHom
    let y_K : Fin N → TensorProduct F K A' := fun a => (1 : K) ⊗ₜ[F] y a
    let I_K : Ideal (TensorProduct F K A') := Ideal.span (Set.range y_K)
    let Q₀_K : MvPolynomial (Fin N) K := MvPolynomial.map (algebraMap F K) Q₀
    have hIK_map : I_K = Ideal.map incR I_F := by
      dsimp [I_K, I_F, y_K, incR]
      rw [Ideal.map_span, ← Set.range_comp]; rfl
    constructor
    · intro hmem_K
      classical
      let b_K := Module.Basis.ofVectorSpace F K
      let π : Module.Basis.ofVectorSpaceIndex F K → (K →ₗ[F] F) :=
        fun i => (Finsupp.lapply i).comp b_K.repr.toLinearMap
      let π_tilde : Module.Basis.ofVectorSpaceIndex F K → (TensorProduct F K A' →ₗ[F] A') :=
        fun i => (TensorProduct.lid F A').toLinearMap.comp (LinearMap.rTensor A' (π i))
      have hπ_tmul : ∀ i (c : K) (a : A'), π_tilde i (c ⊗ₜ[F] a) = algebraMap F A' (π i c) * a := by
        intro i c a
        change (π i c) • a = algebraMap F A' (π i c) * a
        exact Algebra.smul_def _ _
      have hπ_right_mul : ∀ i (z : TensorProduct F K A') (a' : A'),
          π_tilde i (z * incR a') = π_tilde i z * a' := by
        intro i z a'
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul c a =>
          change π_tilde i ((c ⊗ₜ[F] a) * (1 ⊗ₜ[F] a')) = π_tilde i (c ⊗ₜ[F] a) * a'
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, hπ_tmul, hπ_tmul, mul_assoc]
        | add z₁ z₂ ih₁ ih₂ =>
          rw [add_mul, map_add, map_add, add_mul, ih₁, ih₂]
      have hπ_pow_mul : ∀ {z : TensorProduct F K A'}, z ∈ I_K ^ (d + 1) →
          ∀ (s : TensorProduct F K A') i, π_tilde i (s * z) ∈ I_F ^ (d + 1) := by
        intro z hz
        rw [hIK_map, ← Ideal.map_pow] at hz
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
        · rintro _ ⟨w, hw, rfl⟩ s i
          rw [hπ_right_mul]
          exact Ideal.mul_mem_left _ _ hw
        · intro s i; simp
        · intro z₁ z₂ _ _ ih₁ ih₂ s i
          rw [mul_add, map_add]
          exact (I_F ^ (d + 1)).add_mem (ih₁ s i) (ih₂ s i)
        · intro t z₀ _ ih s i
          change π_tilde i (s * (t * z₀)) ∈ I_F ^ (d + 1)
          rw [← mul_assoc]
          exact ih (s * t) i
      have hπ_pow : ∀ i, π_tilde i
          (MvPolynomial.eval₂ Algebra.TensorProduct.includeLeftRingHom y_K P) ∈ I_F ^ (d + 1) := by
        intro i
        simpa only [one_mul] using hπ_pow_mul hmem_K 1 i
      let P_proj : Module.Basis.ofVectorSpaceIndex F K → MvPolynomial (Fin N) F :=
        fun i => ∑ s ∈ P.support, MvPolynomial.monomial s (π i (P.coeff s))
      have hP_proj_hom : ∀ i, P_proj i ∈ MvPolynomial.homogeneousSubmodule (Fin N) F d := by
        rw [MvPolynomial.mem_homogeneousSubmodule] at hP
        intro i
        dsimp [P_proj]
        refine Submodule.sum_mem _ fun s hs => ?_
        rw [MvPolynomial.mem_homogeneousSubmodule]
        have hs_deg : Finsupp.degree s = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp hs) (hP.coeff_eq_zero hne)
        rw [← hs_deg]
        exact MvPolynomial.isHomogeneous_monomial (π i (P.coeff s)) rfl
      have hyK_prod : ∀ s : Fin N →₀ ℕ,
          (s.prod fun a e => y_K a ^ e) = incR (s.prod fun a e => y a ^ e) := by
        intro s
        refine Finsupp.induction s ?_ ?_
        · simp
        · intro a b s' _ _ ih
          rw [Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _),
            Finsupp.prod_single_index (h := fun x e => y_K x ^ e) (pow_zero _),
            Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _),
            Finsupp.prod_single_index (h := fun x e => y x ^ e) (pow_zero _),
            map_mul, map_pow, ih]
          rfl
      have hπ_eval : ∀ i,
          π_tilde i (MvPolynomial.eval₂ Algebra.TensorProduct.includeLeftRingHom y_K P) =
            MvPolynomial.eval₂ (algebraMap F A') y (P_proj i) := by
        intro i
        have hLHS : MvPolynomial.eval₂ Algebra.TensorProduct.includeLeftRingHom y_K P =
            ∑ s ∈ P.support,
              MvPolynomial.eval₂ Algebra.TensorProduct.includeLeftRingHom y_K
                (MvPolynomial.monomial s (P.coeff s)) := by
          change (MvPolynomial.eval₂Hom Algebra.TensorProduct.includeLeftRingHom y_K) P = _
          conv_lhs => rw [MvPolynomial.as_sum P]
          exact map_sum _ _ P.support
        rw [hLHS, map_sum]
        dsimp [P_proj]
        change _ = (MvPolynomial.eval₂Hom (algebraMap F A') y)
          (∑ s ∈ P.support, MvPolynomial.monomial s (π i (P.coeff s)))
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro s _
        change π_tilde i (MvPolynomial.eval₂ Algebra.TensorProduct.includeLeftRingHom y_K
          (MvPolynomial.monomial s (P.coeff s))) =
          MvPolynomial.eval₂ (algebraMap F A') y (MvPolynomial.monomial s (π i (P.coeff s)))
        rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial, hyK_prod s, hπ_right_mul]
        change π_tilde i ((P.coeff s) ⊗ₜ[F] 1) * _ = _
        rw [hπ_tmul, mul_one]
      have hP_proj_mem : ∀ i, P_proj i ∈ Ideal.span {Q₀} := by
        intro i
        apply (hF_iff d (P_proj i) (hP_proj_hom i)).mp
        rw [← hπ_eval i]; exact hπ_pow i
      let S_P : Finset (Module.Basis.ofVectorSpaceIndex F K) :=
        P.support.biUnion (fun s => (b_K.repr (P.coeff s)).support)
      have hP_reconstruct : P =
          ∑ i ∈ S_P, MvPolynomial.C (b_K i) * MvPolynomial.map (algebraMap F K) (P_proj i) := by
        ext t
        rw [MvPolynomial.coeff_sum]
        have hterm : ∀ i ∈ S_P,
            (MvPolynomial.C (b_K i) * MvPolynomial.map (algebraMap F K) (P_proj i)).coeff t =
              algebraMap F K ((P_proj i).coeff t) * b_K i := by
          intro i _
          rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map, mul_comm]
        rw [Finset.sum_congr rfl hterm]
        have hP_proj_coeff : ∀ i, (P_proj i).coeff t = π i (P.coeff t) := by
          intro i
          dsimp [P_proj]
          rw [MvPolynomial.coeff_sum]
          by_cases ht : t ∈ P.support
          · rw [Finset.sum_eq_single t]
            · simp [MvPolynomial.coeff_monomial]
            · intro s _ hst; simp [MvPolynomial.coeff_monomial, hst]
            · intro habs; exact False.elim (habs ht)
          · have hc0 : P.coeff t = 0 := by
              by_contra hne; exact ht (MvPolynomial.mem_support_iff.mpr hne)
            rw [hc0, map_zero]
            apply Finset.sum_eq_zero
            intro s hs
            have hst : s ≠ t := fun heq => ht (heq ▸ hs)
            simp [MvPolynomial.coeff_monomial, hst]
        simp_rw [hP_proj_coeff, ← Algebra.smul_def]
        symm
        by_cases ht : t ∈ P.support
        · apply b_K.repr.injective
          rw [map_sum]
          ext j
          rw [Finsupp.finsetSum_apply]
          have hrepr_term : ∀ i ∈ S_P, (b_K.repr ((π i (P.coeff t)) • b_K i)) j =
              if i = j then (b_K.repr (P.coeff t)) i else 0 := by
            intro i _
            rw [map_smul, b_K.repr_self, Finsupp.smul_single', mul_one, Finsupp.single_apply]
            rfl
          rw [Finset.sum_congr rfl hrepr_term, Finset.sum_ite_eq']
          split_ifs with hjS
          · rfl
          · symm
            by_contra hne
            exact hjS (Finset.mem_biUnion.mpr ⟨t, ht, Finsupp.mem_support_iff.mpr hne⟩)
        · have hc0 : P.coeff t = 0 := by
            by_contra hne; exact ht (MvPolynomial.mem_support_iff.mpr hne)
          rw [hc0]
          apply Finset.sum_eq_zero
          intro i _; rw [map_zero, zero_smul]
      rw [hP_reconstruct]
      refine Submodule.sum_mem _ fun i _ => ?_
      rcases Ideal.mem_span_singleton.mp (hP_proj_mem i) with ⟨G_i, hG_i⟩
      rw [hG_i, map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton.mpr ⟨_, rfl⟩)
    · intro hmem_span
      have hQ₀_eval_F : MvPolynomial.eval₂ (algebraMap F A') y Q₀ ∈ I_F ^ 3 :=
        (hF_iff 2 Q₀ hQ₀_hom).mpr (Ideal.subset_span rfl)
      have hinc_comp : incR.comp (algebraMap F A') =
          Algebra.TensorProduct.includeLeftRingHom.comp (algebraMap F K) := by
        ext c
        change (1 : K) ⊗ₜ[F] algebraMap F A' c = algebraMap F K c ⊗ₜ[F] (1 : A')
        rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
      have hQ₀K_eval : MvPolynomial.eval₂ Algebra.TensorProduct.includeLeftRingHom y_K Q₀_K =
          incR (MvPolynomial.eval₂ (algebraMap F A') y Q₀) := by
        dsimp [Q₀_K, y_K]
        rw [MvPolynomial.eval₂_map, ← hinc_comp]
        exact (MvPolynomial.hom_eval₂ Q₀ (algebraMap F A') incR y).symm
      have hQ₀K_mem : MvPolynomial.eval₂ Algebra.TensorProduct.includeLeftRingHom y_K Q₀_K ∈ I_K ^ 3 := by
        rw [hQ₀K_eval, hIK_map, ← Ideal.map_pow]
        exact Ideal.mem_map_of_mem incR hQ₀_eval_F
      have hQ₀K_hom : Q₀_K ∈ MvPolynomial.homogeneousSubmodule (Fin N) K 2 := by
        rw [MvPolynomial.mem_homogeneousSubmodule]
        exact ((MvPolynomial.mem_homogeneousSubmodule 2 Q₀).mp hQ₀_hom).map _
      rcases homog_mem_span_quad hQ₀K_hom hP hmem_span with ⟨_, rfl⟩ | ⟨hd2, H, hH_hom, rfl⟩
      · simp
      · change MvPolynomial.eval₂ Algebra.TensorProduct.includeLeftRingHom y_K (Q₀_K * H) ∈ I_K ^ (d + 1)
        rw [MvPolynomial.eval₂_mul]
        have hyK_mem : ∀ a : Fin N, y_K a ∈ I_K := fun a => Ideal.subset_span ⟨a, rfl⟩
        have hH_mem : MvPolynomial.eval₂ Algebra.TensorProduct.includeLeftRingHom y_K H ∈ I_K ^ (d - 2) :=
          eval₂_mem_pow_of_homog _ I_K y_K hyK_mem hH_hom
        have hmul_mem := Ideal.mul_mem_mul hQ₀K_mem hH_mem
        rw [← pow_add] at hmul_mem
        have hadd : 3 + (d - 2) = d + 1 := by omega
        rwa [hadd] at hmul_mem

  
  
  
  obtain ⟨⟨hF_std_E₁_hom, hF_std_E₁_ne⟩, ε_C₁, hε_C₁_id, hker_C₁_idx, hker_C₁_x, hCone_iff⟩ :=
    hConePkg

  have hε_ψ₂_comp : ε_B₁.comp ψ₂ = alg_E₁E'₁.comp ε_C₁ := by
    apply RingHom.ext
    intro z
    rcases Ideal.Quotient.mk_surjective z with ⟨p, rfl⟩
    let fL : MvPolynomial (Fin (m + 1) × Fin 2) E₁ →+* E'₁ :=
      (ε_B₁.comp ψ₂).comp (Ideal.Quotient.mk (Ideal.span {H_cone}))
    let fR : MvPolynomial (Fin (m + 1) × Fin 2) E₁ →+* E'₁ :=
      (alg_E₁E'₁.comp ε_C₁).comp (Ideal.Quotient.mk (Ideal.span {H_cone}))
    change fL p = fR p
    suffices heq : fL = fR by rw [heq]
    apply MvPolynomial.ringHom_ext
    · intro e
      change ε_B₁ (ψ₂ ((Ideal.Quotient.mk _) (MvPolynomial.C e))) =
        alg_E₁E'₁ ((ε_C₁.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) e)
      rw [hε_ψ₂ e, hε_C₁_id, RingHom.id_apply]
    · intro idx
      have hL0 : ε_B₁ (ψ₂ ((Ideal.Quotient.mk _) (MvPolynomial.X idx))) = 0 := by
        rw [← RingHom.mem_ker, hker_εB₁, hSpan_B₁]
        exact Ideal.subset_span ⟨idx, rfl⟩
      have hR0 : ε_C₁ ((Ideal.Quotient.mk _) (MvPolynomial.X idx)) = 0 := by
        rw [← RingHom.mem_ker, hker_C₁_idx]
        exact Ideal.subset_span ⟨idx, rfl⟩
      change ε_B₁ (ψ₂ ((Ideal.Quotient.mk _) (MvPolynomial.X idx))) =
        alg_E₁E'₁ (ε_C₁ ((Ideal.Quotient.mk _) (MvPolynomial.X idx)))
      rw [hL0, hR0, map_zero]

  have hker_B₁_ψ₂ : RingHom.ker ε_B₁ = Ideal.map ψ₂ (RingHom.ker ε_C₁) := by
    rw [hker_εB₁, hSpan_B₁, hker_C₁_idx, Ideal.map_span, ← Set.range_comp]
    rfl

  obtain ⟨y₀, Q₀, L_inv, R_inv, c_scale, hy₀_mem, hNak_le, hy₀_nz, hQ₀_hom,
      ⟨hLR, hc_nz, hQ₀_map_raw⟩, hA₀_iff⟩ :=
    hFlatRoofTransfer F E₁ E'₁ alg_FE'₁ alg_E₁E'₁ (2 * m + 1 + 1) A₀ C₁ B₁
      alg_A₀ ε₀ hε_id ((Ideal.Quotient.mk _).comp MvPolynomial.C) ε_C₁ hε_C₁_id
      ε_B₁ hSurj_ε ψ₁ hψ₁_flat ψ₂ hψ₂_flat hε_ψ₁ hε_ψ₂_comp hker_εB₁ hker_B₁_ψ₂
      x_model hker_C₁_x F_std_E₁ hF_std_E₁_hom hF_std_E₁_ne hCone_iff

  have hmap_F_std : MvPolynomial.map alg_E₁E'₁ F_std_E₁ =
      ∑ j : Fin (m + 1),
        (MvPolynomial.X ⟨2 * j.1, by omega⟩ : MvPolynomial (Fin (2 * m + 1 + 1)) E'₁) *
          MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩ := by
    dsimp [F_std_E₁]
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro j _
    rw [map_mul, MvPolynomial.map_X, MvPolynomial.map_X]

  rw [hmap_F_std] at hQ₀_map_raw

  obtain ⟨s₀, hs₀, hLoc⟩ := hNakAway (2 * m + 1 + 1) y₀ hy₀_mem hNak_le hy₀_nz

  refine ⟨s₀, hs₀, Q₀, hQ₀_hom, ⟨L_inv, R_inv, c_scale, hLR, hc_nz, hQ₀_map_raw⟩, ?_⟩
  intro A' _ loc hAway
  let alg_A' : F →+* A' := loc.comp alg_A₀
  letI : Algebra F A' := alg_A'.toAlgebra
  obtain ⟨ε', y, hε'_id, hε'_loc, hker_ε', hy_nz, hLoc_iff⟩ := hLoc A' loc hAway
  refine ⟨ε', y, hε'_id, hε'_loc, hker_ε', hy_nz, ?_⟩
  intro K _ _ d P hP
  have hF_iff : ∀ (d₀ : ℕ) (P₀ : MvPolynomial (Fin (2 * m + 1 + 1)) F),
      P₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) F d₀ →
      (MvPolynomial.eval₂ (algebraMap F A') y P₀ ∈ (Ideal.span (Set.range y)) ^ (d₀ + 1) ↔
        P₀ ∈ Ideal.span {Q₀}) := by
    intro d₀ P₀ hP₀
    rw [← hker_ε']
    exact (hLoc_iff d₀ P₀ hP₀).trans (hA₀_iff d₀ P₀ hP₀)
  exact hFieldTensorIff K (2 * m + 1 + 1) A' y Q₀ hQ₀_hom hF_iff d P hP

theorem weil_rees_transformed_generators_and_dehom_iff (F K : Type u) [Field F] [Field K] [Algebra F K]
    (N₀ : ℕ)
    (A' : Type u) [CommRing A'] (alg_A' : F →+* A')
    (ε' : A' →+* F) (hε'_id : ε'.comp alg_A' = RingHom.id F)
    (y : Fin (N₀ + 1) → A') (hker_ε' : RingHom.ker ε' = Ideal.span (Set.range y))
    (Q₀ : MvPolynomial (Fin (N₀ + 1)) F)
    (hQ₀_hom : Q₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) F 2) :
    letI : Algebra F A' := alg_A'.toAlgebra
    IsDomain (TensorProduct F K A') →
    (∀ (d : ℕ) (P : MvPolynomial (Fin (N₀ + 1)) K),
      P ∈ MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) K d →
      (MvPolynomial.eval₂ Algebra.TensorProduct.includeLeftRingHom
        (fun a => (1 : K) ⊗ₜ[F] y a) P ∈
        (Ideal.span (Set.range fun a : Fin (N₀ + 1) => (1 : K) ⊗ₜ[F] y a)) ^ (d + 1) ↔
        P ∈ Ideal.span {MvPolynomial.map (algebraMap F K) Q₀})) →
    ∀ (M N : Matrix (Fin (N₀ + 1)) (Fin (N₀ + 1)) K),
      M * N = 1 →
      N * M = 1 →
      ∀ (F_hom : MvPolynomial (Fin (N₀ + 1)) K),
        MvPolynomial.eval₂ (MvPolynomial.C.comp (algebraMap F K))
          (fun a => ∑ b : Fin (N₀ + 1), MvPolynomial.C (M a b) * MvPolynomial.X b) Q₀ = F_hom →
        let g : Fin (N₀ + 1) → TensorProduct F K A' :=
          fun b => ∑ a : Fin (N₀ + 1), (N b a) ⊗ₜ[F] (y a)
        let ε_K : TensorProduct F K A' →+* K :=
          (Algebra.TensorProduct.lift (Algebra.ofId K K)
            { toRingHom := (algebraMap F K).comp ε'
              commutes' := fun c => by
                change algebraMap F K (ε' (alg_A' c)) = algebraMap F K c
                rw [show ε' (alg_A' c) = (ε'.comp alg_A') c from rfl, hε'_id,
                  RingHom.id_apply] }
            (fun _ _ => mul_comm _ _)).toRingHom
        Ideal.map
          (Algebra.TensorProduct.includeRight : A' →ₐ[F] TensorProduct F K A').toRingHom
          (RingHom.ker ε') = Ideal.span (Set.range g) ∧
        RingHom.ker ε_K = Ideal.span (Set.range g) ∧
        (∀ b : Fin (N₀ + 1), g b ≠ 0) ∧
        ∀ (b : Fin (N₀ + 1)),
          let R_Kb := Algebra.adjoin (TensorProduct F K A')
            (Set.range fun a : Fin (N₀ + 1) =>
              IsLocalization.mk' (Localization.Away (g b)) (g a)
                ⟨g b, Submonoid.mem_powers (g b)⟩)
          ∀ (d : ℕ) (P : MvPolynomial (Fin (N₀ + 1)) K),
            P ∈ MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) K d →
            (MvPolynomial.eval₂
              ((algebraMap (TensorProduct F K A') ↥R_Kb).comp
                Algebra.TensorProduct.includeLeftRingHom)
              (fun a => ⟨IsLocalization.mk' (Localization.Away (g b)) (g a)
                ⟨g b, Submonoid.mem_powers (g b)⟩, Algebra.subset_adjoin ⟨a, rfl⟩⟩) P ∈
                Ideal.map (algebraMap (TensorProduct F K A') ↥R_Kb) (RingHom.ker ε_K) ↔
            MvPolynomial.eval₂ MvPolynomial.C
              (fun a => if a = b then 1 else MvPolynomial.X a) P ∈
              Ideal.span {MvPolynomial.eval₂ MvPolynomial.C
                (fun a => if a = b then 1 else MvPolynomial.X a) F_hom}) :=
by
  let _ : Algebra F A' := alg_A'.toAlgebra
  intro hDom_K hGraded M N hMN hNM F_hom hF_hom g ε_K
  have : IsDomain (TensorProduct F K A') := hDom_K
  let B := TensorProduct F K A'
  let incL : K →+* B := Algebra.TensorProduct.includeLeftRingHom
  let incR : A' →+* B := (Algebra.TensorProduct.includeRight : A' →ₐ[F] B).toRingHom
  let y_K : Fin (N₀ + 1) → B := fun a => (1 : K) ⊗ₜ[F] y a
  let I_y : Ideal B := Ideal.span (Set.range y_K)
  let I_g : Ideal B := Ideal.span (Set.range g)
  have hg_mul : ∀ b : Fin (N₀ + 1), g b = ∑ a : Fin (N₀ + 1), incL (N b a) * y_K a := by
    intro b
    refine Finset.sum_congr rfl fun a _ => ?_
    change (N b a) ⊗ₜ[F] (y a) = ((N b a) ⊗ₜ[F] (1 : A')) * ((1 : K) ⊗ₜ[F] (y a))
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  have hSpan_eq : I_y = I_g := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨a, rfl⟩
      have hy_eq : y_K a = ∑ b : Fin (N₀ + 1), incL (M a b) * g b := by
        calc
          y_K a = ∑ a' : Fin (N₀ + 1),
              incL ((1 : Matrix (Fin (N₀ + 1)) (Fin (N₀ + 1)) K) a a') * y_K a' := by
            rw [Finset.sum_eq_single a]
            · simp
            · intro a' _ ha'
              simp [Ne.symm ha']
            · intro ha
              exact absurd (Finset.mem_univ a) ha
          _ = ∑ a' : Fin (N₀ + 1), incL ((M * N) a a') * y_K a' := by rw [hMN]
          _ = ∑ a' : Fin (N₀ + 1),
                ∑ b : Fin (N₀ + 1), incL (M a b) * (incL (N b a') * y_K a') := by
            refine Finset.sum_congr rfl fun a' _ => ?_
            rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
            refine Finset.sum_congr rfl fun b _ => ?_
            rw [map_mul, mul_assoc]
          _ = ∑ b : Fin (N₀ + 1), incL (M a b) * g b := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun b _ => ?_
            rw [← Finset.mul_sum, ← hg_mul b]
      rw [hy_eq]
      exact Submodule.sum_mem I_g fun b _ => I_g.mul_mem_left _ (Ideal.subset_span ⟨b, rfl⟩)
    · rw [Ideal.span_le]
      rintro _ ⟨b, rfl⟩
      rw [hg_mul b]
      exact Submodule.sum_mem I_y fun a _ => I_y.mul_mem_left _ (Ideal.subset_span ⟨a, rfl⟩)
  have hMap_yK : Ideal.map incR (RingHom.ker ε') = I_y := by
    rw [hker_ε', Ideal.map_span, ← Set.range_comp]
    rfl
  have hMap_ker : Ideal.map incR (RingHom.ker ε') = I_g := hMap_yK.trans hSpan_eq
  have hKer_εK : RingHom.ker ε_K = I_g := by
    rw [← hMap_ker]
    apply le_antisymm
    · intro z hz
      have hdecomp : ∀ w : B, w - (ε_K w) ⊗ₜ[F] (1 : A') ∈ Ideal.map incR (RingHom.ker ε') := by
        intro w
        refine @TensorProduct.inductionOn F _ K A' _ _ _ _
          (fun w => w - (ε_K w) ⊗ₜ[F] (1 : A') ∈ Ideal.map incR (RingHom.ker ε'))
          w ?_ ?_
        · intro k a
          have ha_ker : a - alg_A' (ε' a) ∈ RingHom.ker ε' := by
            change ε' (a - alg_A' (ε' a)) = 0
            rw [map_sub, show ε' (alg_A' (ε' a)) = (ε'.comp alg_A') (ε' a) from rfl,
              hε'_id, RingHom.id_apply, sub_self]
          have h_tmul : (ε_K (k ⊗ₜ[F] a)) ⊗ₜ[F] (1 : A') = k ⊗ₜ[F] alg_A' (ε' a) := by
            have hε_ka : ε_K (k ⊗ₜ[F] a) = ε' a • k := by
              change k * algebraMap F K (ε' a) = ε' a • k
              rw [Algebra.smul_def, mul_comm]
            rw [hε_ka, TensorProduct.smul_tmul]
            congr 1
            change alg_A' (ε' a) * 1 = alg_A' (ε' a)
            exact mul_one _
          have hsub : k ⊗ₜ[F] a - (ε_K (k ⊗ₜ[F] a)) ⊗ₜ[F] (1 : A') =
              (k ⊗ₜ[F] (1 : A')) * incR (a - alg_A' (ε' a)) := by
            rw [h_tmul, ← TensorProduct.tmul_sub]
            change k ⊗ₜ[F] (a - alg_A' (ε' a)) = (k ⊗ₜ[F] 1) * (1 ⊗ₜ[F] (a - alg_A' (ε' a)))
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hsub]
          exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem incR ha_ker)
        · intro x₁ x₂ hx₁ hx₂
          have hadd : (x₁ + x₂) - (ε_K (x₁ + x₂)) ⊗ₜ[F] (1 : A') =
              (x₁ - (ε_K x₁) ⊗ₜ[F] (1 : A')) + (x₂ - (ε_K x₂) ⊗ₜ[F] (1 : A')) := by
            rw [map_add, TensorProduct.add_tmul]
            abel
          rw [hadd]
          exact Ideal.add_mem _ hx₁ hx₂
      have hz0 : ε_K z = 0 := hz
      have hmem := hdecomp z
      rwa [hz0, TensorProduct.zero_tmul, sub_zero] at hmem
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      change (1 : K) * algebraMap F K (ε' a) = 0
      rw [RingHom.mem_ker.mp ha, map_zero, mul_zero]
  let R_poly := MvPolynomial (Fin (N₀ + 1)) K
  let ell : Matrix (Fin (N₀ + 1)) (Fin (N₀ + 1)) K → Fin (N₀ + 1) → R_poly :=
    fun L i => ∑ j : Fin (N₀ + 1), MvPolynomial.C (L i j) * MvPolynomial.X j
  have hell_hom : ∀ (L : Matrix (Fin (N₀ + 1)) (Fin (N₀ + 1)) K) (i : Fin (N₀ + 1)),
      (ell L i).IsHomogeneous 1 := by
    intro L i
    rw [← MvPolynomial.mem_homogeneousSubmodule]
    refine Submodule.sum_mem _ fun j _ => ?_
    rw [MvPolynomial.mem_homogeneousSubmodule]
    exact (MvPolynomial.isHomogeneous_X K j).C_mul (L i j)
  let σ_M : R_poly →ₐ[K] R_poly := MvPolynomial.aeval (ell M)
  let σ_N : R_poly →ₐ[K] R_poly := MvPolynomial.aeval (ell N)
  have hσ_comp : ∀ (L₁ L₂ : Matrix (Fin (N₀ + 1)) (Fin (N₀ + 1)) K),
      L₁ * L₂ = 1 →
      (MvPolynomial.aeval (ell L₂)).comp (MvPolynomial.aeval (ell L₁)) = AlgHom.id K R_poly := by
    intro L₁ L₂ hL
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, ell, map_sum, map_mul,
      MvPolynomial.aeval_C]
    rw [MvPolynomial.algebraMap_eq]
    calc
      ∑ j : Fin (N₀ + 1), MvPolynomial.C (L₁ i j) *
          ∑ k : Fin (N₀ + 1), MvPolynomial.C (L₂ j k) * MvPolynomial.X k
        = ∑ k : Fin (N₀ + 1), (∑ j : Fin (N₀ + 1), MvPolynomial.C (L₁ i j * L₂ j k)) *
            MvPolynomial.X k := by
          simp_rw [Finset.mul_sum, ← mul_assoc, ← MvPolynomial.C_mul]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [Finset.sum_mul]
      _ = ∑ k : Fin (N₀ + 1), MvPolynomial.C ((L₁ * L₂) i k) * MvPolynomial.X k := by
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [Matrix.mul_apply, map_sum]
      _ = ∑ k : Fin (N₀ + 1), MvPolynomial.C ((1 : Matrix (Fin (N₀ + 1)) (Fin (N₀ + 1)) K) i k) *
            MvPolynomial.X k := by rw [hL]
      _ = MvPolynomial.X i := by
          rw [Finset.sum_eq_single i]
          · simp
          · intro k _ hk
            simp [Ne.symm hk]
          · intro hi
            exact absurd (Finset.mem_univ i) hi
  have hNM_id : σ_N.comp σ_M = AlgHom.id K R_poly := hσ_comp M N hMN
  have hMN_id : σ_M.comp σ_N = AlgHom.id K R_poly := hσ_comp N M hNM
  let Q_K : R_poly := MvPolynomial.map (algebraMap F K) Q₀
  have hQK_hom : Q_K.IsHomogeneous 2 :=
    ((MvPolynomial.mem_homogeneousSubmodule 2 Q₀).mp hQ₀_hom).map (algebraMap F K)
  have hσM_QK : σ_M Q_K = F_hom := by
    change MvPolynomial.aeval (ell M) (MvPolynomial.map (algebraMap F K) Q₀) = F_hom
    rw [MvPolynomial.aeval_def, MvPolynomial.algebraMap_eq, MvPolynomial.eval₂_map]
    exact hF_hom
  have hF_hom2 : F_hom.IsHomogeneous 2 := by
    rw [← hσM_QK]
    simpa only [one_mul] using hQK_hom.aeval (ell M) (hell_hom M)
  have hσN_F : σ_N F_hom = Q_K := by
    rw [← hσM_QK]
    exact AlgHom.congr_fun hNM_id Q_K
  let ev_y : R_poly →+* B := MvPolynomial.eval₂Hom incL y_K
  let ev_g : R_poly →+* B := MvPolynomial.eval₂Hom incL g
  have hev_comp : ev_y.comp σ_N.toRingHom = ev_g := by
    apply MvPolynomial.ringHom_ext'
    · ext c
      change MvPolynomial.eval₂ incL y_K (MvPolynomial.aeval (ell N) (MvPolynomial.C c)) =
        MvPolynomial.eval₂ incL g (MvPolynomial.C c)
      rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq, MvPolynomial.eval₂_C,
        MvPolynomial.eval₂_C]
    · intro b
      change MvPolynomial.eval₂ incL y_K (MvPolynomial.aeval (ell N) (MvPolynomial.X b)) =
        MvPolynomial.eval₂ incL g (MvPolynomial.X b)
      rw [MvPolynomial.aeval_X, MvPolynomial.eval₂_X]
      dsimp only [ell]
      rw [MvPolynomial.eval₂_sum]
      refine (Finset.sum_congr rfl fun a _ => ?_).trans (hg_mul b).symm
      rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C, MvPolynomial.eval₂_X]
  have hGraded_g : ∀ (d : ℕ) (P : R_poly),
      P ∈ MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) K d →
      (MvPolynomial.eval₂ incL g P ∈ I_g ^ (d + 1) ↔ P ∈ Ideal.span {F_hom}) := by
    intro d P hP
    have hP_hom : P.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule d P).mp hP
    have hσNP : σ_N P ∈ MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) K d := by
      rw [MvPolynomial.mem_homogeneousSubmodule]
      simpa only [one_mul] using hP_hom.aeval (ell N) (hell_hom N)
    have hev_eq : MvPolynomial.eval₂ incL g P = MvPolynomial.eval₂ incL y_K (σ_N P) := by
      change ev_g P = ev_y (σ_N P)
      rw [← hev_comp]
      rfl
    rw [hev_eq, ← hSpan_eq, hGraded d (σ_N P) hσNP, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
    constructor
    · rintro ⟨H, hH⟩
      refine ⟨σ_M H, ?_⟩
      calc
        P = (σ_M.comp σ_N) P := (AlgHom.congr_fun hMN_id P).symm
        _ = σ_M (σ_N P) := rfl
        _ = σ_M (Q_K * H) := by rw [hH]
        _ = F_hom * σ_M H := by rw [map_mul, hσM_QK]
    · rintro ⟨H, rfl⟩
      exact ⟨σ_N H, by rw [map_mul, hσN_F]⟩
  have hg_nz : ∀ b : Fin (N₀ + 1), g b ≠ 0 := by
    intro b hgb0
    have hXb_hom : (MvPolynomial.X b : R_poly) ∈ MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) K 1 :=
      MvPolynomial.isHomogeneous_X K b
    have hev_Xb : MvPolynomial.eval₂ incL g (MvPolynomial.X b : R_poly) ∈ I_g ^ (1 + 1) := by
      rw [MvPolynomial.eval₂_X, hgb0]
      exact Ideal.zero_mem _
    have hXb_mem := (hGraded_g 1 (MvPolynomial.X b) hXb_hom).mp hev_Xb
    rw [Ideal.mem_span_singleton] at hXb_mem
    rcases hXb_mem with ⟨H, hXH⟩
    have hXb_ne : (MvPolynomial.X b : R_poly) ≠ 0 := MvPolynomial.X_ne_zero b
    have hF_ne : F_hom ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at hXH
      exact hXb_ne hXH
    have hH_ne : H ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hXH
      exact hXb_ne hXH
    have hdeg := congrArg MvPolynomial.totalDegree hXH
    rw [MvPolynomial.totalDegree_X, MvPolynomial.totalDegree_mul_of_isDomain hF_ne hH_ne,
      hF_hom2.totalDegree hF_ne] at hdeg
    omega
  refine ⟨hMap_ker, hKer_εK, hg_nz, ?_⟩
  intro b R_Kb
  let S_b := Localization.Away (g b)
  let loc : B →+* S_b := algebraMap B S_b
  let ι_b : B →+* ↥R_Kb := algebraMap B ↥R_Kb
  let u : Fin (N₀ + 1) → ↥R_Kb := fun a =>
    ⟨IsLocalization.mk' S_b (g a) ⟨g b, Submonoid.mem_powers (g b)⟩,
      Algebra.subset_adjoin ⟨a, rfl⟩⟩
  let J_b : Ideal ↥R_Kb := Ideal.map ι_b I_g
  have hu_mul_loc : ∀ a : Fin (N₀ + 1), loc (g b) * (u a).1 = loc (g a) :=
    fun a => IsLocalization.mk'_spec' S_b (g a) ⟨g b, Submonoid.mem_powers (g b)⟩
  have hu_mul : ∀ a : Fin (N₀ + 1), ι_b (g b) * u a = ι_b (g a) := by
    intro a
    apply Subtype.ext
    exact hu_mul_loc a
  have hunit_gb : IsUnit (loc (g b)) := IsLocalization.Away.algebraMap_isUnit (g b)
  have hu_self : u b = 1 := by
    apply Subtype.ext
    apply hunit_gb.mul_left_cancel
    change loc (g b) * (u b).1 = loc (g b) * 1
    rw [hu_mul_loc b, mul_one]
  have hJb_span : J_b = Ideal.span {ι_b (g b)} := by
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
      rintro _ ⟨a, rfl⟩
      exact Ideal.mem_span_singleton.mpr ⟨u a, (hu_mul a).symm⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mem_map_of_mem ι_b (Ideal.subset_span ⟨b, rfl⟩)
  let ev_u : R_poly →+* ↥R_Kb := MvPolynomial.eval₂Hom (ι_b.comp incL) u
  have hev_clear : ∀ (d₀ : ℕ) (Q : R_poly), Q.IsHomogeneous d₀ →
      loc (g b) ^ d₀ * (ev_u Q).1 = loc (ev_g Q) := by
    intro d₀ Q hQ
    change loc (g b) ^ d₀ * R_Kb.val (MvPolynomial.eval₂ (ι_b.comp incL) u Q) =
      loc (MvPolynomial.eval₂ incL g Q)
    have hlhs : R_Kb.val (MvPolynomial.eval₂ (ι_b.comp incL) u Q) =
        ∑ m ∈ Q.support,
          R_Kb.val ((ι_b.comp incL) (Q.coeff m) * ∏ a : Fin (N₀ + 1), u a ^ m a) := by
      rw [MvPolynomial.eval₂_eq']
      exact map_sum R_Kb.val _ Q.support
    have hrhs : loc (MvPolynomial.eval₂ incL g Q) =
        ∑ m ∈ Q.support, loc (incL (Q.coeff m) * ∏ a : Fin (N₀ + 1), g a ^ m a) := by
      rw [MvPolynomial.eval₂_eq']
      exact map_sum loc _ Q.support
    rw [hlhs, hrhs, Finset.mul_sum]
    refine Finset.sum_congr rfl fun m hm => ?_
    have hm_ne : Q.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
    have hm_deg : (∑ a : Fin (N₀ + 1), m a) = d₀ := by
      have hdeg : Finsupp.degree m = d₀ := by
        by_contra hne
        exact hm_ne (hQ.coeff_eq_zero hne)
      rw [← hdeg, Finsupp.degree_apply]
      exact (Finset.sum_subset (Finset.subset_univ m.support) fun a _ ha => by simpa using ha).symm
    have hpow_prod : loc (g b) ^ d₀ = ∏ a : Fin (N₀ + 1), loc (g b) ^ m a := by
      rw [← hm_deg, ← Finset.prod_pow_eq_pow_sum]
    simp only [map_mul, map_prod, map_pow, RingHom.comp_apply]
    change loc (g b) ^ d₀ * (loc (incL (Q.coeff m)) * ∏ a : Fin (N₀ + 1), (u a).1 ^ m a) =
      loc (incL (Q.coeff m)) * ∏ a : Fin (N₀ + 1), loc (g a) ^ m a
    calc
      loc (g b) ^ d₀ * (loc (incL (Q.coeff m)) * ∏ a : Fin (N₀ + 1), (u a).1 ^ m a)
        = loc (incL (Q.coeff m)) *
            ((∏ a : Fin (N₀ + 1), loc (g b) ^ m a) * ∏ a : Fin (N₀ + 1), (u a).1 ^ m a) := by
          rw [hpow_prod]
          ring
      _ = loc (incL (Q.coeff m)) * ∏ a : Fin (N₀ + 1), (loc (g b) * (u a).1) ^ m a := by
          rw [← Finset.prod_mul_distrib]
          congr 1
          refine Finset.prod_congr rfl fun a _ => (mul_pow _ _ _).symm
      _ = loc (incL (Q.coeff m)) * ∏ a : Fin (N₀ + 1), loc (g a) ^ m a := by
          congr 1
          refine Finset.prod_congr rfl fun a _ => by rw [hu_mul_loc a]
  let δ_b : R_poly →+* R_poly :=
    MvPolynomial.eval₂Hom MvPolynomial.C (fun a => if a = b then 1 else MvPolynomial.X a)
  have hev_δ : ev_u.comp δ_b = ev_u := by
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext
      intro c
      change ev_u (MvPolynomial.eval₂ MvPolynomial.C
          (fun a' => if a' = b then 1 else MvPolynomial.X a') (MvPolynomial.C c)) =
        MvPolynomial.eval₂ (ι_b.comp incL) u (MvPolynomial.C c)
      rw [MvPolynomial.eval₂_C]
      rfl
    · intro a
      change ev_u (MvPolynomial.eval₂ MvPolynomial.C
          (fun a' => if a' = b then 1 else MvPolynomial.X a') (MvPolynomial.X a)) =
        MvPolynomial.eval₂ (ι_b.comp incL) u (MvPolynomial.X a)
      rw [MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
      split_ifs with hab
      · subst hab
        rw [map_one]
        exact hu_self.symm
      · exact MvPolynomial.eval₂_X _ _ _
  have hev_F_mem : ev_u F_hom ∈ J_b := by
    let S3 : Ideal B :=
      { carrier := { z : B | ∃ v : ↥R_Kb, loc (g b) ^ 3 * v.1 = loc z }
        zero_mem' := ⟨0, by simp⟩
        add_mem' := by
          rintro z₁ z₂ ⟨v₁, hv₁⟩ ⟨v₂, hv₂⟩
          refine ⟨v₁ + v₂, ?_⟩
          change loc (g b) ^ 3 * (v₁.1 + v₂.1) = loc (z₁ + z₂)
          rw [mul_add, hv₁, hv₂, map_add]
        smul_mem' := by
          rintro r z ⟨v, hv⟩
          refine ⟨ι_b r * v, ?_⟩
          change loc (g b) ^ 3 * (loc r * v.1) = loc (r * z)
          rw [← mul_left_comm, hv, map_mul] }
    have hIg3_le : I_g ^ 3 ≤ S3 := by
      rw [show I_g ^ 3 = I_g * I_g * I_g by ring]
      rw [Ideal.mul_le]
      intro x hx z hz
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro x₁ hx₁ x₂ hx₂
        have h_span1 : x₁ ∈ Ideal.span (Set.range g) := hx₁
        refine Submodule.span_induction ?_ ?_ ?_ ?_ h_span1
        · rintro _ ⟨a₁, rfl⟩
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hx₂
          · rintro _ ⟨a₂, rfl⟩
            refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
            · rintro _ ⟨a₃, rfl⟩
              refine ⟨u a₁ * u a₂ * u a₃, ?_⟩
              change loc (g b) ^ 3 * ((u a₁).1 * (u a₂).1 * (u a₃).1) =
                loc (g a₁ * g a₂ * g a₃)
              calc
                loc (g b) ^ 3 * ((u a₁).1 * (u a₂).1 * (u a₃).1)
                  = (loc (g b) * (u a₁).1) * (loc (g b) * (u a₂).1) *
                      (loc (g b) * (u a₃).1) := by ring
                _ = loc (g a₁) * loc (g a₂) * loc (g a₃) := by
                    rw [hu_mul_loc a₁, hu_mul_loc a₂, hu_mul_loc a₃]
                _ = loc (g a₁ * g a₂ * g a₃) := by simp only [map_mul]
            · simp only [mul_zero]; exact S3.zero_mem
            · intro w₁ w₂ _ _ hw₁ hw₂
              rw [mul_add]; exact S3.add_mem hw₁ hw₂
            · intro r w _ hw
              rw [smul_eq_mul, show g a₁ * g a₂ * (r * w) = r * (g a₁ * g a₂ * w) by ring]
              exact S3.mul_mem_left r hw
          · simp only [mul_zero, zero_mul]; exact S3.zero_mem
          · intro w₁ w₂ _ _ hw₁ hw₂
            rw [mul_add, add_mul]; exact S3.add_mem hw₁ hw₂
          · intro r w _ hw
            rw [smul_eq_mul, show g a₁ * (r * w) * z = r * (g a₁ * w * z) by ring]
            exact S3.mul_mem_left r hw
        · simp only [zero_mul]; exact S3.zero_mem
        · intro w₁ w₂ _ _ hw₁ hw₂
          rw [add_mul, add_mul]; exact S3.add_mem hw₁ hw₂
        · intro r w _ hw
          rw [smul_eq_mul, show r * w * x₂ * z = r * (w * x₂ * z) by ring]
          exact S3.mul_mem_left r hw
      · intro w₁ w₂ hw₁ hw₂
        rw [add_mul]
        exact S3.add_mem hw₁ hw₂
    have hevF_Ig3 : ev_g F_hom ∈ I_g ^ 3 :=
      (hGraded_g 2 F_hom ((MvPolynomial.mem_homogeneousSubmodule 2 F_hom).mpr hF_hom2)).mpr
        (Ideal.subset_span rfl)
    obtain ⟨v_F, hv_F⟩ := hIg3_le hevF_Ig3
    have hclear_F := hev_clear 2 F_hom hF_hom2
    have heq_S : loc (g b) ^ 2 * (ev_u F_hom).1 = loc (g b) ^ 2 * (ι_b (g b) * v_F).1 := by
      change loc (g b) ^ 2 * (ev_u F_hom).1 = loc (g b) ^ 2 * (loc (g b) * v_F.1)
      rw [hclear_F, ← hv_F]
      ring
    have heq_sub : ev_u F_hom = ι_b (g b) * v_F :=
      Subtype.ext ((hunit_gb.pow 2).mul_left_cancel heq_S)
    rw [hJb_span, Ideal.mem_span_singleton]
    exact ⟨v_F, heq_sub⟩
  have hadjoin_clear : ∀ {z : S_b}, z ∈ R_Kb →
      ∃ e : ℕ, ∃ x ∈ I_g ^ e, loc (g b) ^ e * z = loc x := by
    intro z hz
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
    · rintro _ ⟨a, rfl⟩
      refine ⟨1, g a, ?_, ?_⟩
      · rw [pow_one]; exact Ideal.subset_span ⟨a, rfl⟩
      · rw [pow_one]; exact hu_mul_loc a
    · intro r
      refine ⟨0, r, ?_, ?_⟩
      · rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
      · rw [pow_zero, one_mul]
    · rintro z₁ z₂ _ _ ⟨e₁, x₁, hx₁, heq₁⟩ ⟨e₂, x₂, hx₂, heq₂⟩
      have hgb_Ig : g b ∈ I_g := Ideal.subset_span ⟨b, rfl⟩
      refine ⟨e₁ + e₂, g b ^ e₂ * x₁ + g b ^ e₁ * x₂, ?_, ?_⟩
      · refine Ideal.add_mem _ ?_ ?_
        · rw [Nat.add_comm, pow_add]
          exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hgb_Ig e₂) hx₁
        · rw [pow_add]
          exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hgb_Ig e₁) hx₂
      · calc
          loc (g b) ^ (e₁ + e₂) * (z₁ + z₂)
            = loc (g b) ^ e₂ * (loc (g b) ^ e₁ * z₁) +
                loc (g b) ^ e₁ * (loc (g b) ^ e₂ * z₂) := by ring
          _ = loc (g b) ^ e₂ * loc x₁ + loc (g b) ^ e₁ * loc x₂ := by rw [heq₁, heq₂]
          _ = loc (g b ^ e₂ * x₁ + g b ^ e₁ * x₂) := by simp only [map_add, map_mul, map_pow]
    · rintro z₁ z₂ _ _ ⟨e₁, x₁, hx₁, heq₁⟩ ⟨e₂, x₂, hx₂, heq₂⟩
      refine ⟨e₁ + e₂, x₁ * x₂, ?_, ?_⟩
      · rw [pow_add]
        exact Ideal.mul_mem_mul hx₁ hx₂
      · calc
          loc (g b) ^ (e₁ + e₂) * (z₁ * z₂)
            = (loc (g b) ^ e₁ * z₁) * (loc (g b) ^ e₂ * z₂) := by ring
          _ = loc x₁ * loc x₂ := by rw [heq₁, heq₂]
          _ = loc (x₁ * x₂) := (map_mul loc x₁ x₂).symm
  have hloc_inj : Function.Injective loc := by
    refine IsLocalization.injective (M := Submonoid.powers (g b)) S_b ?_
    rintro m ⟨k, rfl⟩
    exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero k (hg_nz b))
  intro d P hP
  rw [hKer_εK]
  change ev_u P ∈ J_b ↔ δ_b P ∈ Ideal.span {δ_b F_hom}
  constructor
  · intro hmem
    rw [hJb_span, Ideal.mem_span_singleton] at hmem
    rcases hmem with ⟨w, hw⟩
    obtain ⟨e, x, hx, heq_w⟩ := hadjoin_clear w.2
    have hP_hom : P.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule d P).mp hP
    have hclear_P := hev_clear d P hP_hom
    have hloc_eq : loc (g b ^ e * ev_g P) = loc (g b ^ (d + 1) * x) := by
      have hw_val : (ev_u P).1 = loc (g b) * w.1 := congrArg Subtype.val hw
      calc
        loc (g b ^ e * ev_g P)
          = loc (g b) ^ e * loc (ev_g P) := by rw [map_mul, map_pow]
        _ = loc (g b) ^ e * (loc (g b) ^ d * (ev_u P).1) := by rw [← hclear_P]
        _ = loc (g b) ^ e * (loc (g b) ^ d * (loc (g b) * w.1)) := by rw [hw_val]
        _ = loc (g b) ^ (d + 1) * (loc (g b) ^ e * w.1) := by ring
        _ = loc (g b) ^ (d + 1) * loc x := by rw [heq_w]
        _ = loc (g b ^ (d + 1) * x) := by rw [map_mul, map_pow]
    have hB_eq : g b ^ e * ev_g P = g b ^ (d + 1) * x := hloc_inj hloc_eq
    have hgb_Ig : g b ∈ I_g := Ideal.subset_span ⟨b, rfl⟩
    have hev_mem : MvPolynomial.eval₂ incL g ((MvPolynomial.X b : R_poly) ^ e * P) ∈
        I_g ^ (d + e + 1) := by
      change ev_g ((MvPolynomial.X b : R_poly) ^ e * P) ∈ I_g ^ (d + e + 1)
      have hev_Xb : ev_g (MvPolynomial.X b) = g b := MvPolynomial.eval₂_X incL g b
      have hev_mul : ev_g ((MvPolynomial.X b : R_poly) ^ e * P) = g b ^ e * ev_g P := by
        rw [map_mul, map_pow, hev_Xb]
      rw [hev_mul, hB_eq, show d + e + 1 = (d + 1) + e by omega, pow_add]
      exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hgb_Ig (d + 1)) hx
    have hXP_hom : ((MvPolynomial.X b : R_poly) ^ e * P) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) K (d + e) := by
      rw [MvPolynomial.mem_homogeneousSubmodule, Nat.add_comm d e]
      have hX_pow : ((MvPolynomial.X b : R_poly) ^ e).IsHomogeneous e := by
        simpa only [one_mul] using (MvPolynomial.isHomogeneous_X K b).pow e
      exact hX_pow.mul hP_hom
    have hXP_span := (hGraded_g (d + e) _ hXP_hom).mp hev_mem
    rw [Ideal.mem_span_singleton] at hXP_span ⊢
    rcases hXP_span with ⟨H, hH⟩
    refine ⟨δ_b H, ?_⟩
    have hδ_Xb : δ_b (MvPolynomial.X b) = 1 := by
      change MvPolynomial.eval₂ MvPolynomial.C
        (fun a => if a = b then 1 else MvPolynomial.X a) (MvPolynomial.X b) = 1
      rw [MvPolynomial.eval₂_X]
      simp only [↓reduceIte]
    calc
      δ_b P = 1 ^ e * δ_b P := by rw [one_pow, one_mul]
      _ = δ_b ((MvPolynomial.X b : R_poly) ^ e * P) := by rw [map_mul, map_pow, hδ_Xb]
      _ = δ_b (F_hom * H) := by rw [hH]
      _ = δ_b F_hom * δ_b H := map_mul δ_b F_hom H
  · intro hmem
    rw [Ideal.mem_span_singleton] at hmem
    rcases hmem with ⟨G, hG⟩
    have hev_P : ev_u P = ev_u (δ_b P) := (RingHom.congr_fun hev_δ P).symm
    have hev_F : ev_u (δ_b F_hom) = ev_u F_hom := RingHom.congr_fun hev_δ F_hom
    rw [hev_P, hG, map_mul, hev_F]
    exact J_b.mul_mem_right (ev_u G) hev_F_mem

theorem weil_flat_rees_generator_swap_without_nzd (A C B : Type u) [CommRing A] [CommRing C] [CommRing B]
    (f_A : A →+* B) (hf_A : f_A.Etale)
    (f_C : C →+* B) (hf_C : f_C.Etale)
    (ι₁ ι₂ : Type) [Fintype ι₁] [Fintype ι₂]
    (u : ι₁ → A) (v : ι₂ → C)
    (hSpan : Ideal.span (Set.range (f_A ∘ u)) = Ideal.span (Set.range (f_C ∘ v)))
    (b : ι₁)
    (𝔓 : PrimeSpectrum ↥(Algebra.adjoin A
      (Set.range fun a : ι₁ =>
        IsLocalization.mk' (Localization.Away (u b)) (u a)
          ⟨u b, Submonoid.mem_powers (u b)⟩)))
    (κ : Type u) [Field κ]
    (φ_B : B →+* κ)
    (φ_R : ↥(Algebra.adjoin A
      (Set.range fun a : ι₁ =>
        IsLocalization.mk' (Localization.Away (u b)) (u a)
          ⟨u b, Submonoid.mem_powers (u b)⟩)) →+* κ)
    (hφ_comp : φ_B.comp f_A = φ_R.comp (algebraMap A _))
    (hker_φR : RingHom.ker φ_R = 𝔓.asIdeal) :
    ∃ (idx₀ : ι₂)
      (R' : Type u) (_ : CommRing R')
      (v₀ : PrimeSpectrum R')
      (α_et : ↥(Algebra.adjoin A
        (Set.range fun a : ι₁ =>
          IsLocalization.mk' (Localization.Away (u b)) (u a)
            ⟨u b, Submonoid.mem_powers (u b)⟩)) →+* R')
      (β_et : ↥(Algebra.adjoin C
        (Set.range fun idx' : ι₂ =>
          IsLocalization.mk' (Localization.Away (v idx₀)) (v idx')
            ⟨v idx₀, Submonoid.mem_powers (v idx₀)⟩)) →+* R')
      (γ_B : B →+* R')
      (η₀ : R'),
      α_et.Etale ∧
      β_et.Etale ∧
      α_et.comp (algebraMap A _) = γ_B.comp f_A ∧
      β_et.comp (algebraMap C _) = γ_B.comp f_C ∧
      PrimeSpectrum.comap α_et v₀ = 𝔓 ∧
      β_et (algebraMap C _ (v idx₀)) = η₀ * α_et (algebraMap A _ (u b)) :=
by
  
  have hEtaleAway : ∀ (S : Type u) [CommRing S] (t : S),
      (algebraMap S (Localization.Away t)).Etale := by
    clear * -
    intro S _ t
    have : Algebra.FormallyEtale S (Localization.Away t) :=
      Algebra.FormallyEtale.of_isLocalization (Submonoid.powers t)
    have : Algebra.FinitePresentation S (Localization.Away t) :=
      IsLocalization.Away.finitePresentation t
    have : Algebra.Etale S (Localization.Away t) := {}
    exact RingHom.etale_algebraMap.mpr inferInstance

  
  have hEtaleReesBaseChange :
      ∀ (R B₀ : Type u) [CommRing R] [CommRing B₀]
        (f : R →+* B₀) (_ : f.Etale) {ι : Type} (w : ι → R) (i : ι),
        let R_w := Algebra.adjoin R (Set.range fun a : ι =>
          IsLocalization.mk' (Localization.Away (w i)) (w a)
            ⟨w i, Submonoid.mem_powers (w i)⟩)
        let B_w := Algebra.adjoin B₀ (Set.range fun a : ι =>
          IsLocalization.mk' (Localization.Away (f (w i))) (f (w a))
            ⟨f (w i), Submonoid.mem_powers (f (w i))⟩)
        ∃ σ : ↥R_w →+* ↥B_w,
          σ.Etale ∧
          σ.comp (algebraMap R ↥R_w) = (algebraMap B₀ ↥B_w).comp f ∧
          ∀ (𝔓₀ : PrimeSpectrum ↥R_w) (κ₀ : Type u) [Field κ₀]
            (ψ_B : B₀ →+* κ₀) (ψ_R : ↥R_w →+* κ₀),
            ψ_B.comp f = ψ_R.comp (algebraMap R ↥R_w) →
            RingHom.ker ψ_R = 𝔓₀.asIdeal →
            ∃ w₁ : PrimeSpectrum ↥B_w, PrimeSpectrum.comap σ w₁ = 𝔓₀ := by
    clear * -
    intro R B₀ _ _ f hf ι w i R_w B_w
    letI : Algebra R B₀ := f.toAlgebra
    have : Algebra.Etale R B₀ := RingHom.etale_algebraMap.mp hf
    have : Algebra.Smooth R B₀ :=
      RingHom.smooth_algebraMap.mp ((RingHom.etale_iff_formallyUnramified_and_smooth f).mp hf).2
    have : Module.Flat R B₀ := Algebra.Smooth.flat R B₀
    let S_R := Localization.Away (w i)
    let S_B := Localization.Away (f (w i))
    let M_map : TensorProduct R B₀ ↥R_w →ₐ[B₀] TensorProduct R B₀ S_R :=
      Algebra.TensorProduct.map (AlgHom.id B₀ B₀) R_w.val
    have hM_lin : M_map.toLinearMap.restrictScalars R =
        LinearMap.lTensor B₀ R_w.val.toLinearMap := by
      apply TensorProduct.ext'
      intro b' y
      rfl
    have hM_inj : Function.Injective M_map := by
      have h1 : Function.Injective (LinearMap.lTensor B₀ R_w.val.toLinearMap) :=
        Module.Flat.lTensor_preserves_injective_linearMap R_w.val.toLinearMap Subtype.val_injective
      intro z₁ z₂ hz
      apply h1
      rw [← hM_lin]
      exact hz
    let E_loc : TensorProduct R B₀ S_R ≃ₐ[B₀] S_B :=
      IsLocalization.Away.tensorEquiv B₀ (w i) S_R
    let T_map : TensorProduct R B₀ ↥R_w →ₐ[B₀] S_B := E_loc.toAlgHom.comp M_map
    have hT_inj : Function.Injective T_map := E_loc.injective.comp hM_inj
    let g₁ : S_R →+* S_B :=
      E_loc.toAlgHom.toRingHom.comp
        (Algebra.TensorProduct.includeRight : S_R →ₐ[R] TensorProduct R B₀ S_R).toRingHom
    have hg₁_alg : ∀ r : R, g₁ (algebraMap R S_R r) = algebraMap B₀ S_B (f r) := by
      intro r
      change E_loc ((1 : B₀) ⊗ₜ[R] algebraMap R S_R r) = algebraMap B₀ S_B (f r)
      have htmul : (1 : B₀) ⊗ₜ[R] algebraMap R S_R r = (f r) ⊗ₜ[R] (1 : S_R) := by
        rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        rfl
      rw [htmul]
      exact E_loc.commutes (f r)
    have hg₁_gen : ∀ a : ι,
        g₁ (IsLocalization.mk' S_R (w a) ⟨w i, Submonoid.mem_powers (w i)⟩) =
          IsLocalization.mk' S_B (f (w a)) ⟨f (w i), Submonoid.mem_powers (f (w i))⟩ := by
      intro a
      have hu_i : IsUnit (algebraMap B₀ S_B (f (w i))) :=
        IsLocalization.map_units S_B ⟨f (w i), Submonoid.mem_powers (f (w i))⟩
      apply hu_i.mul_right_cancel
      calc
        g₁ (IsLocalization.mk' S_R (w a) ⟨w i, Submonoid.mem_powers (w i)⟩) *
            algebraMap B₀ S_B (f (w i))
          = g₁ (IsLocalization.mk' S_R (w a) ⟨w i, Submonoid.mem_powers (w i)⟩) *
              g₁ (algebraMap R S_R (w i)) := by rw [hg₁_alg (w i)]
        _ = g₁ (IsLocalization.mk' S_R (w a) ⟨w i, Submonoid.mem_powers (w i)⟩ *
              algebraMap R S_R (w i)) := (map_mul g₁ _ _).symm
        _ = g₁ (algebraMap R S_R (w a)) := by
              rw [IsLocalization.mk'_spec S_R (w a) ⟨w i, Submonoid.mem_powers (w i)⟩]
        _ = algebraMap B₀ S_B (f (w a)) := hg₁_alg (w a)
        _ = IsLocalization.mk' S_B (f (w a)) ⟨f (w i), Submonoid.mem_powers (f (w i))⟩ *
              algebraMap B₀ S_B (f (w i)) :=
              (IsLocalization.mk'_spec S_B (f (w a))
                ⟨f (w i), Submonoid.mem_powers (f (w i))⟩).symm
    have hT_tmul : ∀ (b' : B₀) (y : ↥R_w),
        T_map (b' ⊗ₜ[R] y) = algebraMap B₀ S_B b' * g₁ y.1 := by
      intro b' y
      have hmul : (b' ⊗ₜ[R] y : TensorProduct R B₀ ↥R_w) =
          algebraMap B₀ (TensorProduct R B₀ ↥R_w) b' * ((1 : B₀) ⊗ₜ[R] y) := by
        change b' ⊗ₜ[R] y = (b' ⊗ₜ[R] (1 : ↥R_w)) * ((1 : B₀) ⊗ₜ[R] y)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [hmul, map_mul, T_map.commutes b']
      rfl
    let B_w_R : Subalgebra R S_R :=
      { carrier := {z : S_R | g₁ z ∈ B_w}
        mul_mem' := fun {x y} hx hy => by
          change g₁ (x * y) ∈ B_w
          rw [map_mul]
          exact B_w.mul_mem hx hy
        one_mem' := by
          change g₁ 1 ∈ B_w
          rw [map_one]
          exact B_w.one_mem
        add_mem' := fun {x y} hx hy => by
          change g₁ (x + y) ∈ B_w
          rw [map_add]
          exact B_w.add_mem hx hy
        zero_mem' := by
          change g₁ 0 ∈ B_w
          rw [map_zero]
          exact B_w.zero_mem
        algebraMap_mem' := fun r => by
          change g₁ (algebraMap R S_R r) ∈ B_w
          rw [hg₁_alg r]
          exact B_w.algebraMap_mem (f r) }
    have hRw_le : R_w ≤ B_w_R := by
      rw [Algebra.adjoin_le_iff]
      rintro _ ⟨a, rfl⟩
      change g₁ (IsLocalization.mk' S_R (w a) ⟨w i, Submonoid.mem_powers (w i)⟩) ∈ B_w
      rw [hg₁_gen a]
      exact Algebra.subset_adjoin ⟨a, rfl⟩
    let P_sub : Submodule R (TensorProduct R B₀ ↥R_w) :=
      { carrier := {z | T_map z ∈ B_w}
        add_mem' := fun {z₁ z₂} hz₁ hz₂ => by
          change T_map (z₁ + z₂) ∈ B_w
          rw [map_add]
          exact B_w.add_mem hz₁ hz₂
        zero_mem' := by
          change T_map 0 ∈ B_w
          rw [map_zero]
          exact B_w.zero_mem
        smul_mem' := fun r z hz => by
          change T_map (r • z) ∈ B_w
          rw [← IsScalarTower.algebraMap_smul B₀ r z, map_smul]
          exact B_w.smul_mem hz (algebraMap R B₀ r) }
    have hP_mkQ : P_sub.mkQ = 0 := by
      apply TensorProduct.ext'
      intro b' y
      rw [LinearMap.zero_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      change T_map (b' ⊗ₜ[R] y) ∈ B_w
      rw [hT_tmul b' y]
      exact B_w.mul_mem (B_w.algebraMap_mem b') (hRw_le y.2)
    have hRange : T_map.range = B_w := by
      apply le_antisymm
      · rintro _ ⟨z, rfl⟩
        have hz0 : P_sub.mkQ z = 0 := by rw [hP_mkQ]; rfl
        exact (Submodule.Quotient.mk_eq_zero P_sub).mp hz0
      · rw [Algebra.adjoin_le_iff]
        rintro _ ⟨a, rfl⟩
        let y_a : ↥R_w :=
          ⟨IsLocalization.mk' S_R (w a) ⟨w i, Submonoid.mem_powers (w i)⟩,
            Algebra.subset_adjoin ⟨a, rfl⟩⟩
        refine ⟨(1 : B₀) ⊗ₜ[R] y_a, ?_⟩
        change T_map ((1 : B₀) ⊗ₜ[R] y_a) =
          IsLocalization.mk' S_B (f (w a)) ⟨f (w i), Submonoid.mem_powers (f (w i))⟩
        rw [hT_tmul, map_one, one_mul]
        exact hg₁_gen a
    let τ : TensorProduct R B₀ ↥R_w ≃ₐ[B₀] ↥B_w :=
      (AlgEquiv.ofInjective T_map hT_inj).trans (Subalgebra.equivOfEq T_map.range B_w hRange)
    let σ : ↥R_w →+* ↥B_w :=
      τ.toRingHom.comp
        (Algebra.TensorProduct.includeRight : ↥R_w →ₐ[R] TensorProduct R B₀ ↥R_w).toRingHom
    have hσ_et : σ.Etale := by
      have : Algebra.Etale ↥R_w (TensorProduct R ↥R_w B₀) := Algebra.Etale.baseChange R B₀ ↥R_w
      have hEt_base :=
        (RingHom.etale_algebraMap (R := ↥R_w) (S := TensorProduct R ↥R_w B₀)).mpr inferInstance
      let e_tot : TensorProduct R ↥R_w B₀ ≃+* ↥B_w :=
        (Algebra.TensorProduct.comm R ↥R_w B₀).toRingEquiv.trans τ.toRingEquiv
      have hEt_comp := RingHom.Etale.stableUnderComposition _ e_tot.toRingHom hEt_base
        (RingHom.Etale.of_bijective e_tot.bijective)
      have hσ_eq : e_tot.toRingHom.comp
          (@algebraMap ↥R_w (TensorProduct R ↥R_w B₀)
            CommRing.toCommSemiring CommRing.toCommSemiring.toSemiring inferInstance) = σ := by
        apply RingHom.ext
        intro y
        rfl
      rwa [hσ_eq] at hEt_comp
    have hσ_comp : σ.comp (algebraMap R ↥R_w) = (algebraMap B₀ ↥B_w).comp f := by
      apply RingHom.ext
      intro r
      change τ ((1 : B₀) ⊗ₜ[R] algebraMap R ↥R_w r) = algebraMap B₀ ↥B_w (f r)
      have htmul : ((1 : B₀) ⊗ₜ[R] algebraMap R ↥R_w r : TensorProduct R B₀ ↥R_w) =
          (f r) ⊗ₜ[R] (1 : ↥R_w) := by
        rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        rfl
      rw [htmul]
      exact τ.commutes (f r)
    refine ⟨σ, hσ_et, hσ_comp, ?_⟩
    intro 𝔓₀ κ₀ _ ψ_B ψ_R hψ_comp hker_ψR
    letI : Algebra R κ₀ := (ψ_B.comp f).toAlgebra
    let ψ_B_alg : B₀ →ₐ[R] κ₀ :=
      { ψ_B with commutes' := fun _ => rfl }
    let ψ_R_alg : ↥R_w →ₐ[R] κ₀ :=
      { ψ_R with commutes' := fun r => (RingHom.congr_fun hψ_comp r).symm }
    let Θ : TensorProduct R B₀ ↥R_w →+* κ₀ :=
      (Algebra.TensorProduct.lift ψ_B_alg ψ_R_alg (fun _ _ => mul_comm _ _)).toRingHom
    let w₀ : PrimeSpectrum (TensorProduct R B₀ ↥R_w) := ⟨RingHom.ker Θ, RingHom.ker_isPrime Θ⟩
    let w₁ : PrimeSpectrum ↥B_w := PrimeSpectrum.comap τ.symm.toRingHom w₀
    refine ⟨w₁, ?_⟩
    apply PrimeSpectrum.ext
    ext y
    change Θ (τ.symm (τ ((1 : B₀) ⊗ₜ[R] y))) = 0 ↔ y ∈ 𝔓₀.asIdeal
    rw [τ.symm_apply_apply]
    have hΘ_y : Θ ((1 : B₀) ⊗ₜ[R] y) = ψ_R y := by
      change ψ_B 1 * ψ_R y = ψ_R y
      rw [map_one, one_mul]
    rw [hΘ_y, ← RingHom.mem_ker, hker_ψR]

  
  have hReesTransition :
      ∀ (B₀ : Type u) [CommRing B₀] {ι_a ι_b : Type} [Fintype ι_a] [Fintype ι_b]
        (u' : ι_a → B₀) (v' : ι_b → B₀)
        (_ : Ideal.span (Set.range u') = Ideal.span (Set.range v'))
        (i₀ : ι_a),
        let B_ui := Algebra.adjoin B₀ (Set.range fun a : ι_a =>
          IsLocalization.mk' (Localization.Away (u' i₀)) (u' a)
            ⟨u' i₀, Submonoid.mem_powers (u' i₀)⟩)
        ∃ η : ι_b → ↥B_ui,
          (∀ j : ι_b, (η j).1 = IsLocalization.mk' (Localization.Away (u' i₀)) (v' j)
            ⟨u' i₀, Submonoid.mem_powers (u' i₀)⟩) ∧
          Ideal.span (Set.range η) = ⊤ := by
    clear * -
    intro B₀ _ ι_a ι_b _ _ u' v' hSpan' i₀ B_ui
    let S_i := Localization.Away (u' i₀)
    let p_i : Submonoid.powers (u' i₀) := ⟨u' i₀, Submonoid.mem_powers (u' i₀)⟩
    have hu_unit : IsUnit (algebraMap B₀ S_i (u' i₀)) := IsLocalization.map_units S_i p_i
    have hv_mem : ∀ j : ι_b, ∃ c : ι_a → B₀, ∑ a : ι_a, c a * u' a = v' j := by
      intro j
      have hj : v' j ∈ Ideal.span (Set.range u') := by
        rw [hSpan']
        exact Ideal.subset_span ⟨j, rfl⟩
      obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hj
      exact ⟨c, by simpa only [smul_eq_mul] using hc⟩
    choose c hc using hv_mem
    let gen_u : ι_a → ↥B_ui := fun a =>
      ⟨IsLocalization.mk' S_i (u' a) p_i, Algebra.subset_adjoin ⟨a, rfl⟩⟩
    let η : ι_b → ↥B_ui := fun j =>
      ∑ a : ι_a, algebraMap B₀ ↥B_ui (c j a) * gen_u a
    have hη_val : ∀ j : ι_b, (η j).1 = IsLocalization.mk' S_i (v' j) p_i := by
      intro j
      apply hu_unit.mul_right_cancel
      change B_ui.val (η j) * algebraMap B₀ S_i (u' i₀) = _
      dsimp only [η]
      rw [map_sum, Finset.sum_mul]
      have h_each : ∀ a : ι_a,
          B_ui.val (algebraMap B₀ ↥B_ui (c j a) * gen_u a) * algebraMap B₀ S_i (u' i₀) =
            algebraMap B₀ S_i (c j a * u' a) := by
        intro a
        rw [map_mul, B_ui.val.commutes (c j a), mul_assoc]
        change algebraMap B₀ S_i (c j a) *
          (IsLocalization.mk' S_i (u' a) p_i * algebraMap B₀ S_i (u' i₀)) = _
        rw [IsLocalization.mk'_spec S_i (u' a) p_i, ← map_mul]
      calc
        (∑ a : ι_a, B_ui.val (algebraMap B₀ ↥B_ui (c j a) * gen_u a) *
            algebraMap B₀ S_i (u' i₀))
          = ∑ a : ι_a, algebraMap B₀ S_i (c j a * u' a) :=
              Finset.sum_congr rfl fun a _ => h_each a
        _ = algebraMap B₀ S_i (∑ a : ι_a, c j a * u' a) := (map_sum (algebraMap B₀ S_i) _ _).symm
        _ = algebraMap B₀ S_i (v' j) := by rw [hc j]
        _ = IsLocalization.mk' S_i (v' j) p_i * algebraMap B₀ S_i (u' i₀) :=
              (IsLocalization.mk'_spec S_i (v' j) p_i).symm
    have hu_mem : u' i₀ ∈ Ideal.span (Set.range v') := by
      rw [← hSpan']
      exact Ideal.subset_span ⟨i₀, rfl⟩
    obtain ⟨d, hd_raw⟩ := Ideal.mem_span_range_iff_exists_fun.mp hu_mem
    have hd : ∑ j : ι_b, d j * v' j = u' i₀ := by simpa only [smul_eq_mul] using hd_raw
    let S_one : ↥B_ui := ∑ j : ι_b, algebraMap B₀ ↥B_ui (d j) * η j
    have hS_mem : S_one ∈ Ideal.span (Set.range η) :=
      Submodule.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
    have hS_eq_one : S_one = 1 := by
      apply Subtype.ext
      apply hu_unit.mul_right_cancel
      change B_ui.val S_one * algebraMap B₀ S_i (u' i₀) = (1 : S_i) * algebraMap B₀ S_i (u' i₀)
      dsimp only [S_one]
      rw [map_sum, Finset.sum_mul]
      have h_each : ∀ j : ι_b,
          B_ui.val (algebraMap B₀ ↥B_ui (d j) * η j) * algebraMap B₀ S_i (u' i₀) =
            algebraMap B₀ S_i (d j * v' j) := by
        intro j
        rw [map_mul, B_ui.val.commutes (d j), mul_assoc]
        change algebraMap B₀ S_i (d j) * ((η j).1 * algebraMap B₀ S_i (u' i₀)) = _
        rw [hη_val j, IsLocalization.mk'_spec S_i (v' j) p_i, ← map_mul]
      calc
        (∑ j : ι_b, B_ui.val (algebraMap B₀ ↥B_ui (d j) * η j) * algebraMap B₀ S_i (u' i₀))
          = ∑ j : ι_b, algebraMap B₀ S_i (d j * v' j) :=
              Finset.sum_congr rfl fun j _ => h_each j
        _ = algebraMap B₀ S_i (∑ j : ι_b, d j * v' j) := (map_sum (algebraMap B₀ S_i) _ _).symm
        _ = algebraMap B₀ S_i (u' i₀) := by rw [hd]
        _ = (1 : S_i) * algebraMap B₀ S_i (u' i₀) := (one_mul _).symm
    rw [hS_eq_one] at hS_mem
    exact ⟨η, hη_val, (Ideal.eq_top_iff_one _).mpr hS_mem⟩

  
  have hDoubleAwaySwap :
      ∀ (B₀ U₀ V₀ : Type u) [CommRing B₀] [CommRing U₀] [Algebra B₀ U₀]
        [CommRing V₀] [Algebra B₀ V₀]
        {ι_a ι_b : Type} (u' : ι_a → B₀) (v' : ι_b → B₀) (i₀ : ι_a) (j₀ : ι_b)
        (ι_U : U₀ →ₐ[B₀] Localization.Away (u' i₀))
        (ι_V : V₀ →ₐ[B₀] Localization.Away (v' j₀))
        (_ : Function.Injective ι_U) (_ : Function.Injective ι_V)
        (_ : ι_U.range = Algebra.adjoin B₀ (Set.range fun a : ι_a =>
          IsLocalization.mk' (Localization.Away (u' i₀)) (u' a)
            ⟨u' i₀, Submonoid.mem_powers (u' i₀)⟩))
        (_ : ι_V.range = Algebra.adjoin B₀ (Set.range fun j : ι_b =>
          IsLocalization.mk' (Localization.Away (v' j₀)) (v' j)
            ⟨v' j₀, Submonoid.mem_powers (v' j₀)⟩))
        (η : ι_b → U₀) (ξ : ι_a → V₀)
        (_ : ∀ j : ι_b, ι_U (η j) = IsLocalization.mk' (Localization.Away (u' i₀)) (v' j)
          ⟨u' i₀, Submonoid.mem_powers (u' i₀)⟩)
        (_ : ∀ a : ι_a, ι_V (ξ a) = IsLocalization.mk' (Localization.Away (v' j₀)) (u' a)
          ⟨v' j₀, Submonoid.mem_powers (v' j₀)⟩),
        ∃ ϕ : Localization.Away (ξ i₀) ≃+* Localization.Away (η j₀),
          ∀ x : B₀,
            ϕ (algebraMap V₀ (Localization.Away (ξ i₀)) (algebraMap B₀ V₀ x)) =
              algebraMap U₀ (Localization.Away (η j₀)) (algebraMap B₀ U₀ x) := by
    clear * -
    intro B₀ U₀ V₀ _ _ _ _ _ ι_a ι_b u' v' i₀ j₀ ι_U ι_V hιU_inj hιV_inj
      hU_range hV_range η ξ hη hξ
    let x₀ : B₀ := u' i₀
    let y₀ : B₀ := v' j₀
    let S_x := Localization.Away x₀
    let S_y := Localization.Away y₀
    let S_prod := Localization.Away (x₀ * y₀)
    have hxy_unit : IsUnit (algebraMap B₀ S_prod (x₀ * y₀)) :=
      IsLocalization.map_units S_prod ⟨x₀ * y₀, Submonoid.mem_powers (x₀ * y₀)⟩
    obtain ⟨inv_xy, hinv_xy⟩ := hxy_unit.exists_right_inv
    have hx_unit : IsUnit (algebraMap B₀ S_prod x₀) :=
      IsUnit.of_mul_eq_one (algebraMap B₀ S_prod y₀ * inv_xy)
        (by rw [← mul_assoc, ← map_mul, hinv_xy])
    have hy_unit : IsUnit (algebraMap B₀ S_prod y₀) :=
      IsUnit.of_mul_eq_one (algebraMap B₀ S_prod x₀ * inv_xy)
        (by rw [← mul_assoc, mul_comm (algebraMap B₀ S_prod y₀), ← map_mul, hinv_xy])
    let lam_U : S_x →+* S_prod := IsLocalization.Away.lift x₀ hx_unit
    let lam_V : S_y →+* S_prod := IsLocalization.Away.lift y₀ hy_unit
    have hlamU_eq : ∀ z : B₀, lam_U (algebraMap B₀ S_x z) = algebraMap B₀ S_prod z :=
      IsLocalization.Away.lift_eq x₀ hx_unit
    have hlamV_eq : ∀ z : B₀, lam_V (algebraMap B₀ S_y z) = algebraMap B₀ S_prod z :=
      IsLocalization.Away.lift_eq y₀ hy_unit
    let g_U : U₀ →+* S_prod := lam_U.comp ι_U.toRingHom
    let g_V : V₀ →+* S_prod := lam_V.comp ι_V.toRingHom
    have hgU_mul : ∀ j : ι_b,
        g_U (η j) * algebraMap B₀ S_prod x₀ = algebraMap B₀ S_prod (v' j) := by
      intro j
      change lam_U (ι_U (η j)) * algebraMap B₀ S_prod x₀ = _
      rw [← hlamU_eq x₀, ← map_mul, hη j,
        IsLocalization.mk'_spec S_x (v' j) ⟨x₀, Submonoid.mem_powers x₀⟩, hlamU_eq (v' j)]
    have hgV_mul : ∀ a : ι_a,
        g_V (ξ a) * algebraMap B₀ S_prod y₀ = algebraMap B₀ S_prod (u' a) := by
      intro a
      change lam_V (ι_V (ξ a)) * algebraMap B₀ S_prod y₀ = _
      rw [← hlamV_eq y₀, ← map_mul, hξ a,
        IsLocalization.mk'_spec S_y (u' a) ⟨y₀, Submonoid.mem_powers y₀⟩, hlamV_eq (u' a)]
    have hRecip : g_U (η j₀) * g_V (ξ i₀) = 1 := by
      apply (hx_unit.mul hy_unit).mul_right_cancel
      calc
        (g_U (η j₀) * g_V (ξ i₀)) * (algebraMap B₀ S_prod x₀ * algebraMap B₀ S_prod y₀)
          = (g_U (η j₀) * algebraMap B₀ S_prod x₀) * (g_V (ξ i₀) * algebraMap B₀ S_prod y₀) := by
              ring
        _ = algebraMap B₀ S_prod y₀ * algebraMap B₀ S_prod x₀ := by
              rw [hgU_mul j₀, hgV_mul i₀]
        _ = 1 * (algebraMap B₀ S_prod x₀ * algebraMap B₀ S_prod y₀) := by ring
    have hη_unit : IsUnit (g_U (η j₀)) := IsUnit.of_mul_eq_one (g_V (ξ i₀)) hRecip
    have hξ_unit : IsUnit (g_V (ξ i₀)) :=
      IsUnit.of_mul_eq_one (g_U (η j₀)) (by rw [mul_comm, hRecip])
    let Φ₁ : Localization.Away (η j₀) →+* S_prod := IsLocalization.Away.lift (η j₀) hη_unit
    let Φ₂ : Localization.Away (ξ i₀) →+* S_prod := IsLocalization.Away.lift (ξ i₀) hξ_unit
    have hΦ₁_eq : ∀ w : U₀, Φ₁ (algebraMap U₀ _ w) = g_U w :=
      IsLocalization.Away.lift_eq (η j₀) hη_unit
    have hΦ₂_eq : ∀ w : V₀, Φ₂ (algebraMap V₀ _ w) = g_V w :=
      IsLocalization.Away.lift_eq (ξ i₀) hξ_unit
    have hΦ₁_inv : Φ₁ (IsLocalization.Away.invSelf (η j₀)) = g_V (ξ i₀) := by
      apply hη_unit.mul_left_cancel
      calc
        g_U (η j₀) * Φ₁ (IsLocalization.Away.invSelf (η j₀))
          = Φ₁ (algebraMap U₀ _ (η j₀) * IsLocalization.Away.invSelf (η j₀)) := by
              rw [map_mul, hΦ₁_eq (η j₀)]
        _ = 1 := by rw [IsLocalization.Away.mul_invSelf (η j₀), map_one]
        _ = g_U (η j₀) * g_V (ξ i₀) := hRecip.symm
    have hΦ₂_inv : Φ₂ (IsLocalization.Away.invSelf (ξ i₀)) = g_U (η j₀) := by
      apply hξ_unit.mul_left_cancel
      calc
        g_V (ξ i₀) * Φ₂ (IsLocalization.Away.invSelf (ξ i₀))
          = Φ₂ (algebraMap V₀ _ (ξ i₀) * IsLocalization.Away.invSelf (ξ i₀)) := by
              rw [map_mul, hΦ₂_eq (ξ i₀)]
        _ = 1 := by rw [IsLocalization.Away.mul_invSelf (ξ i₀), map_one]
        _ = g_V (ξ i₀) * g_U (η j₀) := hRecip.symm.trans (mul_comm _ _)
    have hΦ₁_inj : Function.Injective Φ₁ := by
      rw [injective_iff_map_eq_zero]
      intro ζ hζ
      obtain ⟨⟨w, s⟩, hws⟩ := IsLocalization.surj (Submonoid.powers (η j₀)) ζ
      dsimp only at hws
      have hgw : lam_U (ι_U w) = 0 := by
        have h1 := congrArg Φ₁ hws
        rw [map_mul, hζ, zero_mul, hΦ₁_eq w] at h1
        exact h1.symm
      obtain ⟨⟨b₀, s_x⟩, hbs⟩ := IsLocalization.surj (Submonoid.powers x₀) (ι_U w)
      dsimp only at hbs
      obtain ⟨d, hd_pow⟩ := s_x.2
      dsimp only at hd_pow
      have hb₀_zero : algebraMap B₀ S_prod b₀ = 0 := by
        have h1 := congrArg lam_U hbs
        rw [map_mul, hgw, zero_mul, hlamU_eq b₀] at h1
        exact h1.symm
      obtain ⟨m_xy, hm_xy⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (x₀ * y₀)) S_prod b₀).mp hb₀_zero
      obtain ⟨k, hk_pow⟩ := m_xy.2
      dsimp only at hk_pow
      have h_ann : x₀ ^ k * (y₀ ^ k * b₀) = 0 := by
        have hk : (x₀ * y₀) ^ k * b₀ = 0 := by
          rw [hk_pow]
          exact hm_xy
        calc
          x₀ ^ k * (y₀ ^ k * b₀) = (x₀ * y₀) ^ k * b₀ := by ring
          _ = 0 := hk
      have hu_Sx : IsUnit (algebraMap B₀ S_x x₀) :=
        IsLocalization.map_units S_x ⟨x₀, Submonoid.mem_powers x₀⟩
      have hw_ann_Sx : ι_U ((η j₀) ^ k * w) = 0 := by
        apply ((hu_Sx.pow k).mul ((hu_Sx.pow k).mul (hu_Sx.pow d))).mul_right_cancel
        have h_eta_x : ι_U (η j₀) * algebraMap B₀ S_x x₀ = algebraMap B₀ S_x y₀ := by
          rw [hη j₀]
          exact IsLocalization.mk'_spec S_x y₀ ⟨x₀, Submonoid.mem_powers x₀⟩
        have h_w_x : ι_U w * algebraMap B₀ S_x x₀ ^ d = algebraMap B₀ S_x b₀ := by
          rw [← map_pow, hd_pow]
          exact hbs
        calc
          ι_U ((η j₀) ^ k * w) *
              (algebraMap B₀ S_x x₀ ^ k * (algebraMap B₀ S_x x₀ ^ k * algebraMap B₀ S_x x₀ ^ d))
            = algebraMap B₀ S_x x₀ ^ k *
                ((ι_U (η j₀) * algebraMap B₀ S_x x₀) ^ k *
                  (ι_U w * algebraMap B₀ S_x x₀ ^ d)) := by
                rw [map_mul, map_pow]
                ring
          _ = algebraMap B₀ S_x x₀ ^ k * (algebraMap B₀ S_x y₀ ^ k * algebraMap B₀ S_x b₀) := by
                rw [h_eta_x, h_w_x]
          _ = algebraMap B₀ S_x (x₀ ^ k * (y₀ ^ k * b₀)) := by
                simp only [map_mul, map_pow]
          _ = algebraMap B₀ S_x 0 := by rw [h_ann]
          _ = 0 *
                (algebraMap B₀ S_x x₀ ^ k *
                  (algebraMap B₀ S_x x₀ ^ k * algebraMap B₀ S_x x₀ ^ d)) := by
                rw [map_zero, zero_mul]
      have hw_ann : (η j₀) ^ k * w = 0 := hιU_inj (by rw [hw_ann_Sx, map_zero])
      have hu_η : IsUnit (algebraMap U₀ (Localization.Away (η j₀)) (η j₀)) :=
        IsLocalization.map_units (Localization.Away (η j₀))
          ⟨η j₀, Submonoid.mem_powers (η j₀)⟩
      have hw_loc_zero : algebraMap U₀ (Localization.Away (η j₀)) w = 0 := by
        apply (hu_η.pow k).mul_left_cancel
        rw [← map_pow, ← map_mul, hw_ann, map_zero, mul_zero]
      have hu_s : IsUnit (algebraMap U₀ (Localization.Away (η j₀)) s.1) :=
        IsLocalization.map_units (Localization.Away (η j₀)) s
      apply hu_s.mul_right_cancel
      rw [hws, hw_loc_zero, zero_mul]
    have hΦ₂_inj : Function.Injective Φ₂ := by
      rw [injective_iff_map_eq_zero]
      intro ζ hζ
      obtain ⟨⟨w, s⟩, hws⟩ := IsLocalization.surj (Submonoid.powers (ξ i₀)) ζ
      dsimp only at hws
      have hgw : lam_V (ι_V w) = 0 := by
        have h1 := congrArg Φ₂ hws
        rw [map_mul, hζ, zero_mul, hΦ₂_eq w] at h1
        exact h1.symm
      obtain ⟨⟨b₀, s_y⟩, hbs⟩ := IsLocalization.surj (Submonoid.powers y₀) (ι_V w)
      dsimp only at hbs
      obtain ⟨d, hd_pow⟩ := s_y.2
      dsimp only at hd_pow
      have hb₀_zero : algebraMap B₀ S_prod b₀ = 0 := by
        have h1 := congrArg lam_V hbs
        rw [map_mul, hgw, zero_mul, hlamV_eq b₀] at h1
        exact h1.symm
      obtain ⟨m_xy, hm_xy⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (x₀ * y₀)) S_prod b₀).mp hb₀_zero
      obtain ⟨k, hk_pow⟩ := m_xy.2
      dsimp only at hk_pow
      have h_ann : y₀ ^ k * (x₀ ^ k * b₀) = 0 := by
        have hk : (x₀ * y₀) ^ k * b₀ = 0 := by
          rw [hk_pow]
          exact hm_xy
        calc
          y₀ ^ k * (x₀ ^ k * b₀) = (x₀ * y₀) ^ k * b₀ := by ring
          _ = 0 := hk
      have hu_Sy : IsUnit (algebraMap B₀ S_y y₀) :=
        IsLocalization.map_units S_y ⟨y₀, Submonoid.mem_powers y₀⟩
      have hw_ann_Sy : ι_V ((ξ i₀) ^ k * w) = 0 := by
        apply ((hu_Sy.pow k).mul ((hu_Sy.pow k).mul (hu_Sy.pow d))).mul_right_cancel
        have h_xi_y : ι_V (ξ i₀) * algebraMap B₀ S_y y₀ = algebraMap B₀ S_y x₀ := by
          rw [hξ i₀]
          exact IsLocalization.mk'_spec S_y x₀ ⟨y₀, Submonoid.mem_powers y₀⟩
        have h_w_y : ι_V w * algebraMap B₀ S_y y₀ ^ d = algebraMap B₀ S_y b₀ := by
          rw [← map_pow, hd_pow]
          exact hbs
        calc
          ι_V ((ξ i₀) ^ k * w) *
              (algebraMap B₀ S_y y₀ ^ k * (algebraMap B₀ S_y y₀ ^ k * algebraMap B₀ S_y y₀ ^ d))
            = algebraMap B₀ S_y y₀ ^ k *
                ((ι_V (ξ i₀) * algebraMap B₀ S_y y₀) ^ k *
                  (ι_V w * algebraMap B₀ S_y y₀ ^ d)) := by
                rw [map_mul, map_pow]
                ring
          _ = algebraMap B₀ S_y y₀ ^ k * (algebraMap B₀ S_y x₀ ^ k * algebraMap B₀ S_y b₀) := by
                rw [h_xi_y, h_w_y]
          _ = algebraMap B₀ S_y (y₀ ^ k * (x₀ ^ k * b₀)) := by
                simp only [map_mul, map_pow]
          _ = algebraMap B₀ S_y 0 := by rw [h_ann]
          _ = 0 *
                (algebraMap B₀ S_y y₀ ^ k *
                  (algebraMap B₀ S_y y₀ ^ k * algebraMap B₀ S_y y₀ ^ d)) := by
                rw [map_zero, zero_mul]
      have hw_ann : (ξ i₀) ^ k * w = 0 := hιV_inj (by rw [hw_ann_Sy, map_zero])
      have hu_ξ : IsUnit (algebraMap V₀ (Localization.Away (ξ i₀)) (ξ i₀)) :=
        IsLocalization.map_units (Localization.Away (ξ i₀))
          ⟨ξ i₀, Submonoid.mem_powers (ξ i₀)⟩
      have hw_loc_zero : algebraMap V₀ (Localization.Away (ξ i₀)) w = 0 := by
        apply (hu_ξ.pow k).mul_left_cancel
        rw [← map_pow, ← map_mul, hw_ann, map_zero, mul_zero]
      have hu_s : IsUnit (algebraMap V₀ (Localization.Away (ξ i₀)) s.1) :=
        IsLocalization.map_units (Localization.Away (ξ i₀)) s
      apply hu_s.mul_right_cancel
      rw [hws, hw_loc_zero, zero_mul]
    have hΦ₁_B : ∀ z : B₀,
        Φ₁ (algebraMap U₀ _ (algebraMap B₀ U₀ z)) = algebraMap B₀ S_prod z := by
      intro z
      rw [hΦ₁_eq]
      change lam_U (ι_U (algebraMap B₀ U₀ z)) = algebraMap B₀ S_prod z
      rw [ι_U.commutes z, hlamU_eq z]
    have hΦ₂_B : ∀ z : B₀,
        Φ₂ (algebraMap V₀ _ (algebraMap B₀ V₀ z)) = algebraMap B₀ S_prod z := by
      intro z
      rw [hΦ₂_eq]
      change lam_V (ι_V (algebraMap B₀ V₀ z)) = algebraMap B₀ S_prod z
      rw [ι_V.commutes z, hlamV_eq z]
    let sub_y_in_1 : Subalgebra B₀ S_y :=
      { carrier := {t : S_y | lam_V t ∈ Φ₁.range}
        mul_mem' := fun hx hy => by
          change lam_V (_ * _) ∈ Φ₁.range
          rw [map_mul]
          exact Φ₁.range.mul_mem hx hy
        one_mem' := by
          change lam_V 1 ∈ Φ₁.range
          rw [map_one]
          exact Φ₁.range.one_mem
        add_mem' := fun hx hy => by
          change lam_V (_ + _) ∈ Φ₁.range
          rw [map_add]
          exact Φ₁.range.add_mem hx hy
        zero_mem' := by
          change lam_V 0 ∈ Φ₁.range
          rw [map_zero]
          exact Φ₁.range.zero_mem
        algebraMap_mem' := fun z => by
          change lam_V (algebraMap B₀ S_y z) ∈ Φ₁.range
          rw [hlamV_eq z]
          exact ⟨algebraMap U₀ _ (algebraMap B₀ U₀ z), hΦ₁_B z⟩ }
    have hV_le_1 : ι_V.range ≤ sub_y_in_1 := by
      rw [hV_range, Algebra.adjoin_le_iff]
      rintro _ ⟨j, rfl⟩
      refine ⟨algebraMap U₀ _ (η j) * IsLocalization.Away.invSelf (η j₀), ?_⟩
      rw [map_mul, hΦ₁_eq (η j), hΦ₁_inv]
      apply (hx_unit.mul hy_unit).mul_right_cancel
      have h_rhs :
          lam_V (IsLocalization.mk' S_y (v' j) ⟨y₀, Submonoid.mem_powers y₀⟩) *
              lam_V (algebraMap B₀ S_y y₀) =
            algebraMap B₀ S_prod (v' j) := by
        rw [← lam_V.map_mul, IsLocalization.mk'_spec S_y (v' j) ⟨y₀, Submonoid.mem_powers y₀⟩,
          hlamV_eq (v' j)]
      calc
        (g_U (η j) * g_V (ξ i₀)) * (algebraMap B₀ S_prod x₀ * algebraMap B₀ S_prod y₀)
          = (g_U (η j) * algebraMap B₀ S_prod x₀) * (g_V (ξ i₀) * algebraMap B₀ S_prod y₀) := by
              ring
        _ = algebraMap B₀ S_prod (v' j) * algebraMap B₀ S_prod x₀ := by
              rw [hgU_mul j, hgV_mul i₀]
        _ = (lam_V (IsLocalization.mk' S_y (v' j) ⟨y₀, Submonoid.mem_powers y₀⟩) *
              lam_V (algebraMap B₀ S_y y₀)) * algebraMap B₀ S_prod x₀ := by
              rw [h_rhs]
        _ = lam_V (IsLocalization.mk' S_y (v' j) ⟨y₀, Submonoid.mem_powers y₀⟩) *
              (algebraMap B₀ S_prod x₀ * algebraMap B₀ S_prod y₀) := by
              rw [hlamV_eq y₀]
              ring
    let sub_x_in_2 : Subalgebra B₀ S_x :=
      { carrier := {t : S_x | lam_U t ∈ Φ₂.range}
        mul_mem' := fun hx hy => by
          change lam_U (_ * _) ∈ Φ₂.range
          rw [map_mul]
          exact Φ₂.range.mul_mem hx hy
        one_mem' := by
          change lam_U 1 ∈ Φ₂.range
          rw [map_one]
          exact Φ₂.range.one_mem
        add_mem' := fun hx hy => by
          change lam_U (_ + _) ∈ Φ₂.range
          rw [map_add]
          exact Φ₂.range.add_mem hx hy
        zero_mem' := by
          change lam_U 0 ∈ Φ₂.range
          rw [map_zero]
          exact Φ₂.range.zero_mem
        algebraMap_mem' := fun z => by
          change lam_U (algebraMap B₀ S_x z) ∈ Φ₂.range
          rw [hlamU_eq z]
          exact ⟨algebraMap V₀ _ (algebraMap B₀ V₀ z), hΦ₂_B z⟩ }
    have hU_le_2 : ι_U.range ≤ sub_x_in_2 := by
      rw [hU_range, Algebra.adjoin_le_iff]
      rintro _ ⟨a, rfl⟩
      refine ⟨algebraMap V₀ _ (ξ a) * IsLocalization.Away.invSelf (ξ i₀), ?_⟩
      rw [map_mul, hΦ₂_eq (ξ a), hΦ₂_inv]
      apply (hx_unit.mul hy_unit).mul_right_cancel
      have h_rhs :
          lam_U (IsLocalization.mk' S_x (u' a) ⟨x₀, Submonoid.mem_powers x₀⟩) *
              lam_U (algebraMap B₀ S_x x₀) =
            algebraMap B₀ S_prod (u' a) := by
        rw [← lam_U.map_mul, IsLocalization.mk'_spec S_x (u' a) ⟨x₀, Submonoid.mem_powers x₀⟩,
          hlamU_eq (u' a)]
      calc
        (g_V (ξ a) * g_U (η j₀)) * (algebraMap B₀ S_prod x₀ * algebraMap B₀ S_prod y₀)
          = (g_V (ξ a) * algebraMap B₀ S_prod y₀) * (g_U (η j₀) * algebraMap B₀ S_prod x₀) := by
              ring
        _ = algebraMap B₀ S_prod (u' a) * algebraMap B₀ S_prod y₀ := by
              rw [hgV_mul a, hgU_mul j₀]
        _ = (lam_U (IsLocalization.mk' S_x (u' a) ⟨x₀, Submonoid.mem_powers x₀⟩) *
              lam_U (algebraMap B₀ S_x x₀)) * algebraMap B₀ S_prod y₀ := by
              rw [h_rhs]
        _ = lam_U (IsLocalization.mk' S_x (u' a) ⟨x₀, Submonoid.mem_powers x₀⟩) *
              (algebraMap B₀ S_prod x₀ * algebraMap B₀ S_prod y₀) := by
              rw [hlamU_eq x₀]
              ring
    have hRange : Φ₂.range = Φ₁.range := by
      apply le_antisymm
      · rintro _ ⟨ζ, rfl⟩
        obtain ⟨⟨w_V, s_V⟩, hws_V⟩ := IsLocalization.surj (Submonoid.powers (ξ i₀)) ζ
        obtain ⟨r, hr_pow⟩ := s_V.2
        have hζ_eq : ζ = algebraMap V₀ _ w_V * (IsLocalization.Away.invSelf (ξ i₀)) ^ r := by
          have h1 := congrArg (· * (IsLocalization.Away.invSelf (ξ i₀)) ^ r) hws_V
          dsimp only at h1
          rw [mul_assoc, ← hr_pow, map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf,
            one_pow, mul_one] at h1
          exact h1
        rw [hζ_eq, map_mul, map_pow, hΦ₂_eq w_V, hΦ₂_inv]
        exact Φ₁.range.mul_mem
          (hV_le_1 ⟨w_V, rfl⟩)
          (Φ₁.range.pow_mem ⟨algebraMap U₀ _ (η j₀), hΦ₁_eq (η j₀)⟩ r)
      · rintro _ ⟨ζ, rfl⟩
        obtain ⟨⟨w_U, s_U⟩, hws_U⟩ := IsLocalization.surj (Submonoid.powers (η j₀)) ζ
        obtain ⟨r, hr_pow⟩ := s_U.2
        have hζ_eq : ζ = algebraMap U₀ _ w_U * (IsLocalization.Away.invSelf (η j₀)) ^ r := by
          have h1 := congrArg (· * (IsLocalization.Away.invSelf (η j₀)) ^ r) hws_U
          dsimp only at h1
          rw [mul_assoc, ← hr_pow, map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf,
            one_pow, mul_one] at h1
          exact h1
        rw [hζ_eq, map_mul, map_pow, hΦ₁_eq w_U, hΦ₁_inv]
        exact Φ₂.range.mul_mem
          (hU_le_2 ⟨w_U, rfl⟩)
          (Φ₂.range.pow_mem ⟨algebraMap V₀ _ (ξ i₀), hΦ₂_eq (ξ i₀)⟩ r)
    let e_V : Localization.Away (ξ i₀) ≃+* ↥Φ₂.range :=
      RingEquiv.ofBijective Φ₂.rangeRestrict
        ⟨fun p q h => hΦ₂_inj (congrArg Subtype.val h), Φ₂.rangeRestrict_surjective⟩
    let e_U : Localization.Away (η j₀) ≃+* ↥Φ₁.range :=
      RingEquiv.ofBijective Φ₁.rangeRestrict
        ⟨fun p q h => hΦ₁_inj (congrArg Subtype.val h), Φ₁.rangeRestrict_surjective⟩
    let ϕ : Localization.Away (ξ i₀) ≃+* Localization.Away (η j₀) :=
      e_V.trans ((RingEquiv.subringCongr hRange).trans e_U.symm)
    have hϕ_Φ : ∀ z : Localization.Away (ξ i₀), Φ₁ (ϕ z) = Φ₂ z := by
      intro z
      change (e_U (e_U.symm ((RingEquiv.subringCongr hRange) (e_V z)))).1 = (e_V z).1
      rw [e_U.apply_symm_apply]
      rfl
    refine ⟨ϕ, fun x => ?_⟩
    apply hΦ₁_inj
    rw [hϕ_Φ, hΦ₂_B x, hΦ₁_B x]

  
  let u' : ι₁ → B := f_A ∘ u
  let v' : ι₂ → B := f_C ∘ v
  obtain ⟨σ_A, hσA_et, hσA_comp, hσA_lift⟩ :=
    hEtaleReesBaseChange A B f_A hf_A u b
  obtain ⟨w₁, hw₁_comap⟩ := hσA_lift 𝔓 κ φ_B φ_R hφ_comp hker_φR
  obtain ⟨η, hη_val, hη_span⟩ := hReesTransition B u' v' hSpan b
  have h_exists_idx₀ : ∃ idx₀ : ι₂, η idx₀ ∉ w₁.asIdeal := by
    by_contra h_none
    have h_all : ∀ idx' : ι₂, η idx' ∈ w₁.asIdeal :=
      fun idx' => Classical.not_not.mp fun h => h_none ⟨idx', h⟩
    have hle : Ideal.span (Set.range η) ≤ w₁.asIdeal :=
      Ideal.span_le.mpr (Set.range_subset_iff.mpr h_all)
    rw [hη_span] at hle
    exact w₁.isPrime.ne_top (top_le_iff.mp hle)
  obtain ⟨idx₀, hη_not_mem⟩ := h_exists_idx₀
  obtain ⟨σ_C, hσC_et, hσC_comp, _⟩ :=
    hEtaleReesBaseChange C B f_C hf_C v idx₀
  obtain ⟨ξ, hξ_val, _⟩ := hReesTransition B v' u' hSpan.symm idx₀
  let B_ub := Algebra.adjoin B (Set.range fun a : ι₁ =>
    IsLocalization.mk' (Localization.Away (u' b)) (u' a)
      ⟨u' b, Submonoid.mem_powers (u' b)⟩)
  let B_v0 := Algebra.adjoin B (Set.range fun idx' : ι₂ =>
    IsLocalization.mk' (Localization.Away (v' idx₀)) (v' idx')
      ⟨v' idx₀, Submonoid.mem_powers (v' idx₀)⟩)
  obtain ⟨ϕ, hϕ_B⟩ :=
    hDoubleAwaySwap B ↥B_ub ↥B_v0 u' v' b idx₀ B_ub.val B_v0.val
      Subtype.val_injective Subtype.val_injective
      (Subalgebra.range_val B_ub) (Subalgebra.range_val B_v0)
      η ξ hη_val hξ_val
  have hFinish :
      ∀ (R_A R_C U₀ V₀ : Type u) [CommRing R_A] [CommRing R_C] [CommRing U₀] [CommRing V₀]
        (ι_AR : A →+* R_A) (ι_CR : C →+* R_C)
        (ι_BU : B →+* U₀) (ι_BV : B →+* V₀)
        (σ_A : R_A →+* U₀) (_ : σ_A.Etale)
        (σ_C : R_C →+* V₀) (_ : σ_C.Etale)
        (_ : σ_A.comp ι_AR = ι_BU.comp f_A)
        (_ : σ_C.comp ι_CR = ι_BV.comp f_C)
        (𝔓₀ : PrimeSpectrum R_A) (w₁ : PrimeSpectrum U₀)
        (_ : PrimeSpectrum.comap σ_A w₁ = 𝔓₀)
        (η_U : U₀) (_ : η_U ∉ w₁.asIdeal)
        (ξ_V : V₀)
        (ϕ : Localization.Away ξ_V ≃+* Localization.Away η_U)
        (_ : ∀ x : B,
          ϕ (algebraMap V₀ (Localization.Away ξ_V) (ι_BV x)) =
            algebraMap U₀ (Localization.Away η_U) (ι_BU x))
        (idx₀ : ι₂)
        (_ : ι_BU (f_C (v idx₀)) = η_U * ι_BU (f_A (u b))),
        ∃ (R' : Type u) (_ : CommRing R')
          (v₀ : PrimeSpectrum R')
          (α_et : R_A →+* R')
          (β_et : R_C →+* R')
          (γ_B : B →+* R')
          (η₀ : R'),
          α_et.Etale ∧
          β_et.Etale ∧
          α_et.comp ι_AR = γ_B.comp f_A ∧
          β_et.comp ι_CR = γ_B.comp f_C ∧
          PrimeSpectrum.comap α_et v₀ = 𝔓₀ ∧
          β_et (ι_CR (v idx₀)) = η₀ * α_et (ι_AR (u b)) := by
    clear * - hEtaleAway
    intro R_A R_C U₀ V₀ _ _ _ _ ι_AR ι_CR ι_BU ι_BV σ_A hσA_et σ_C hσC_et
      hσA_comp hσC_comp 𝔓₀ w₁ hw₁_comap η_U hη_not_mem ξ_V ϕ hϕ_B idx₀ h_rel_U
    let R' := Localization.Away η_U
    have hw₁_range : w₁ ∈ Set.range (PrimeSpectrum.comap (algebraMap U₀ R')) := by
      rw [PrimeSpectrum.localization_away_comap_range R' η_U]
      exact hη_not_mem
    obtain ⟨v₀, hv₀_comap⟩ := hw₁_range
    let α_et : R_A →+* R' := (algebraMap U₀ R').comp σ_A
    let β_et : R_C →+* R' := ϕ.toRingHom.comp ((algebraMap V₀ (Localization.Away ξ_V)).comp σ_C)
    let γ_B : B →+* R' := (algebraMap U₀ R').comp ι_BU
    let η₀ : R' := algebraMap U₀ R' η_U
    have hα_et : α_et.Etale :=
      RingHom.Etale.stableUnderComposition _ _ hσA_et (hEtaleAway U₀ η_U)
    have hβ_et : β_et.Etale :=
      RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.stableUnderComposition _ _ hσC_et (hEtaleAway V₀ ξ_V))
        (RingHom.Etale.of_bijective ϕ.bijective)
    have hα_comp : α_et.comp ι_AR = γ_B.comp f_A := by
      dsimp only [α_et, γ_B]
      rw [RingHom.comp_assoc, hσA_comp, ← RingHom.comp_assoc]
    have hβ_comp : β_et.comp ι_CR = γ_B.comp f_C := by
      apply RingHom.ext
      intro c
      dsimp only [β_et, γ_B, RingHom.comp_apply, RingEquiv.coe_toRingHom]
      have h1 := RingHom.congr_fun hσC_comp c
      dsimp only [RingHom.comp_apply] at h1
      rw [h1]
      exact hϕ_B (f_C c)
    have hv₀_𝔓 : PrimeSpectrum.comap α_et v₀ = 𝔓₀ := by
      have hcomp_ps : PrimeSpectrum.comap α_et v₀ =
          PrimeSpectrum.comap σ_A (PrimeSpectrum.comap (algebraMap U₀ R') v₀) := by
        apply PrimeSpectrum.ext
        rfl
      rw [hcomp_ps, hv₀_comap, hw₁_comap]
    have hη₀_rel : β_et (ι_CR (v idx₀)) = η₀ * α_et (ι_AR (u b)) := by
      have hL : β_et (ι_CR (v idx₀)) = algebraMap U₀ R' (ι_BU (f_C (v idx₀))) :=
        RingHom.congr_fun hβ_comp (v idx₀)
      have hR : α_et (ι_AR (u b)) = algebraMap U₀ R' (ι_BU (f_A (u b))) :=
        RingHom.congr_fun hα_comp (u b)
      rw [hL, hR, h_rel_U, map_mul]
    exact ⟨R', inferInstance, v₀, α_et, β_et, γ_B, η₀,
      hα_et, hβ_et, hα_comp, hβ_comp, hv₀_𝔓, hη₀_rel⟩
  have h_rel_ub : algebraMap B ↥B_ub (f_C (v idx₀)) =
      η idx₀ * algebraMap B ↥B_ub (f_A (u b)) := by
    apply Subtype.ext
    change algebraMap B (Localization.Away (u' b)) (v' idx₀) =
      (η idx₀).1 * algebraMap B (Localization.Away (u' b)) (u' b)
    rw [hη_val idx₀]
    exact (IsLocalization.mk'_spec (Localization.Away (u' b)) (v' idx₀)
      ⟨u' b, Submonoid.mem_powers (u' b)⟩).symm
  exact ⟨idx₀, hFinish _ _ ↥B_ub ↥B_v0 (algebraMap A _) (algebraMap C _)
    (algebraMap B ↥B_ub) (algebraMap B ↥B_v0)
    σ_A hσA_et σ_C hσC_et hσA_comp hσC_comp 𝔓 w₁ hw₁_comap
    (η idx₀) hη_not_mem (ξ b) ϕ hϕ_B idx₀ h_rel_ub⟩

theorem weil_odp_model_rees_chart_mvPolynomial_equiv (k : Type u) [Field k]
    (m : ℕ) (idx₀ : Fin (m + 1) × Fin 2) :
    let C_k := MvPolynomial (Fin (m + 1) × Fin 2) k ⧸
      Ideal.span {∑ j : Fin (m + 1),
        (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) k) *
          MvPolynomial.X (j, 1)}
    let v_Ck : Fin (m + 1) × Fin 2 → C_k :=
      fun idx => Ideal.Quotient.mk _ (MvPolynomial.X idx)
    let R_C := Algebra.adjoin C_k
      (Set.range fun idx' : Fin (m + 1) × Fin 2 =>
        IsLocalization.mk' (Localization.Away (v_Ck idx₀)) (v_Ck idx')
          ⟨v_Ck idx₀, Submonoid.mem_powers (v_Ck idx₀)⟩)
    ∃ (e_poly : MvPolynomial (Fin (2 * m + 1)) k ≃+* ↥R_C)
      (i₀ : Fin (2 * m + 1)),
      e_poly.toRingHom.comp MvPolynomial.C =
        (algebraMap C_k ↥R_C).comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) ∧
      e_poly (MvPolynomial.X i₀) = algebraMap C_k ↥R_C (v_Ck idx₀) :=
by
  intro C_k v_Ck R_C
  let j₀ : Fin (m + 1) := idx₀.1
  let c₀ : Fin 2 := idx₀.2
  have hidx₀_eq : (j₀, c₀) = idx₀ := Prod.mk.eta
  let c₁ : Fin 2 := if c₀ = 0 then 1 else 0
  have hfin2 : ∀ c : Fin 2, c = 0 ∨ c = 1 := by
    intro ⟨val, hlt⟩
    rcases Nat.eq_zero_or_pos val with rfl | hpos
    · left; rfl
    · right; apply Fin.ext; change val = 1; omega
  have hc₁_ne : c₁ ≠ c₀ := by
    rcases hfin2 c₀ with h0 | h1
    · change (if c₀ = 0 then (1 : Fin 2) else 0) ≠ c₀
      rw [h0]; decide
    · change (if c₀ = 0 then (1 : Fin 2) else 0) ≠ c₀
      rw [h1]; decide
  have hfin2_dichot : ∀ c : Fin 2, c = c₀ ∨ c = c₁ := by
    intro c
    change c = c₀ ∨ c = (if c₀ = 0 then (1 : Fin 2) else 0)
    rcases hfin2 c with rfl | rfl <;> rcases hfin2 c₀ with h0 | h1
    · rw [h0]; left; rfl
    · rw [h1]; right; decide
    · rw [h0]; right; decide
    · rw [h1]; left; rfl
  have hmul_j₀ : ∀ {R : Type u} [CommSemiring R] (f : Fin 2 → R),
      f 0 * f 1 = f c₀ * f c₁ := by
    intro R _ f
    change f 0 * f 1 = f c₀ * f (if c₀ = 0 then 1 else 0)
    rcases hfin2 c₀ with h0 | h1
    · rw [h0]; rfl
    · rw [h1]; exact mul_comm (f 0) (f 1)
  let S_rem := {j : Fin (m + 1) // j ≠ j₀}
  have hsum_split : ∀ {M : Type u} [AddCommMonoid M] (f : Fin (m + 1) → M),
      (∑ j : Fin (m + 1), f j) = f j₀ + ∑ s : S_rem, f s.1 := by
    intro M _ f
    rw [← Finset.add_sum_erase Finset.univ f (Finset.mem_univ j₀)]
    congr 1
    exact Finset.sum_subtype (Finset.univ.erase j₀)
      (fun j => by simp [Finset.mem_erase]) f
  let I_free : Type := Option (S_rem × Fin 2)
  let σ_inner : S_rem × Fin 2 ≃ Fin (2 * m) :=
    ((finSuccAboveEquiv j₀).symm.prodCongr (Equiv.refl (Fin 2))).trans
      (finProdFinEquiv.trans (finCongr (Nat.mul_comm m 2)))
  let σ_fin : I_free ≃ Fin (2 * m + 1) :=
    (Equiv.optionCongr σ_inner).trans (finSuccEquiv (2 * m)).symm
  let i₀ : Fin (2 * m + 1) := σ_fin none
  let P_free : Type u := MvPolynomial I_free k
  let T₀ : P_free := MvPolynomial.X none
  let Q_Z : P_free :=
    ∑ s : S_rem,
      (MvPolynomial.X (some (s, 0)) : P_free) * MvPolynomial.X (some (s, 1))
  let F_odp : MvPolynomial (Fin (m + 1) × Fin 2) k :=
    ∑ j : Fin (m + 1),
      (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) k) *
        MvPolynomial.X (j, 1)
  let L_C := Localization.Away (v_Ck idx₀)
  let w : Fin (m + 1) × Fin 2 → L_C :=
    fun idx' => IsLocalization.mk' L_C (v_Ck idx')
      ⟨v_Ck idx₀, Submonoid.mem_powers (v_Ck idx₀)⟩
  let u : Fin (m + 1) × Fin 2 → ↥R_C :=
    fun idx' => ⟨w idx', Algebra.subset_adjoin ⟨idx', rfl⟩⟩
  let ι_k : k →+* ↥R_C :=
    (algebraMap C_k ↥R_C).comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)
  let g_free : I_free → ↥R_C := fun x =>
    match x with
    | none => algebraMap C_k ↥R_C (v_Ck idx₀)
    | some sc => u (sc.1.1, sc.2)
  let Θ : P_free →+* ↥R_C := MvPolynomial.eval₂Hom ι_k g_free
  let Φ_fwd : P_free →+* L_C := R_C.val.toRingHom.comp Θ
  let α : L_C := algebraMap C_k L_C (v_Ck idx₀)
  have hΦ_T₀ : Φ_fwd T₀ = α := by
    change R_C.val (Θ (MvPolynomial.X none)) = α
    rw [MvPolynomial.eval₂Hom_X']
    exact R_C.val.commutes (v_Ck idx₀)
  have hΦ_some : ∀ (s : S_rem) (c : Fin 2),
      Φ_fwd (MvPolynomial.X (some (s, c))) = w (s.1, c) := by
    intro s c
    change R_C.val (Θ (MvPolynomial.X (some (s, c)))) = w (s.1, c)
    rw [MvPolynomial.eval₂Hom_X']
    rfl
  have hα_mul : ∀ idx' : Fin (m + 1) × Fin 2,
      α * w idx' = algebraMap C_k L_C (v_Ck idx') :=
    fun idx' => IsLocalization.mk'_spec' L_C (v_Ck idx')
      ⟨v_Ck idx₀, Submonoid.mem_powers (v_Ck idx₀)⟩
  have hα_unit : IsUnit α :=
    IsLocalization.Away.algebraMap_isUnit (S := L_C) (v_Ck idx₀)
  have hα2_unit : IsUnit (α * α) := hα_unit.mul hα_unit
  have hF_odp_zero : (Ideal.Quotient.mk (Ideal.span {F_odp}) F_odp : C_k) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
  have hv_rel : v_Ck (j₀, c₀) * v_Ck (j₀, c₁) =
      - ∑ s : S_rem, v_Ck (s.1, 0) * v_Ck (s.1, 1) := by
    have hsum0 : ∑ j : Fin (m + 1), v_Ck (j, 0) * v_Ck (j, 1) = 0 := by
      simpa only [F_odp, map_sum, map_mul] using hF_odp_zero
    rw [hsum_split (fun j => v_Ck (j, 0) * v_Ck (j, 1)),
      hmul_j₀ (fun c => v_Ck (j₀, c))] at hsum0
    exact eq_neg_of_add_eq_zero_left hsum0
  have hw_j₀_c₁ : Φ_fwd (-Q_Z) = w (j₀, c₁) := by
    apply hα2_unit.mul_left_cancel
    have hRHS : (α * α) * w (j₀, c₁) =
        algebraMap C_k L_C (v_Ck (j₀, c₀) * v_Ck (j₀, c₁)) := by
      calc
        (α * α) * w (j₀, c₁) = α * (α * w (j₀, c₁)) := mul_assoc α α _
        _ = α * algebraMap C_k L_C (v_Ck (j₀, c₁)) := by rw [hα_mul]
        _ = algebraMap C_k L_C (v_Ck idx₀) * algebraMap C_k L_C (v_Ck (j₀, c₁)) := rfl
        _ = algebraMap C_k L_C (v_Ck (j₀, c₀) * v_Ck (j₀, c₁)) := by
          rw [hidx₀_eq, map_mul]
    have hLHS : (α * α) * Φ_fwd (-Q_Z) =
        algebraMap C_k L_C (- ∑ s : S_rem, v_Ck (s.1, 0) * v_Ck (s.1, 1)) := by
      have hQ_map : Φ_fwd (-Q_Z) = - ∑ s : S_rem, w (s.1, 0) * w (s.1, 1) := by
        change Φ_fwd (- ∑ s : S_rem, MvPolynomial.X (some (s, 0)) * MvPolynomial.X (some (s, 1))) = _
        rw [map_neg, map_sum]
        congr 1
        refine Finset.sum_congr rfl fun s _ => ?_
        rw [map_mul, hΦ_some s 0, hΦ_some s 1]
      rw [hQ_map, mul_neg, Finset.mul_sum, map_neg, map_sum]
      congr 1
      refine Finset.sum_congr rfl fun s _ => ?_
      calc
        (α * α) * (w (s.1, 0) * w (s.1, 1)) =
            (α * w (s.1, 0)) * (α * w (s.1, 1)) := by ring
        _ = algebraMap C_k L_C (v_Ck (s.1, 0)) * algebraMap C_k L_C (v_Ck (s.1, 1)) := by
          rw [hα_mul, hα_mul]
        _ = algebraMap C_k L_C (v_Ck (s.1, 0) * v_Ck (s.1, 1)) := (map_mul _ _ _).symm
    rw [hLHS, hRHS, hv_rel]
  have hw_range : ∀ idx' : Fin (m + 1) × Fin 2, w idx' ∈ Φ_fwd.range := by
    rintro ⟨j, c⟩
    by_cases hj : j ≠ j₀
    · exact ⟨MvPolynomial.X (some (⟨j, hj⟩, c)), hΦ_some ⟨j, hj⟩ c⟩
    · have hj_eq : j = j₀ := Decidable.of_not_not hj
      rw [hj_eq]
      rcases hfin2_dichot c with hc0 | hc1
      · rw [hc0, hidx₀_eq]
        refine ⟨1, ?_⟩
        rw [map_one]
        exact (IsLocalization.mk'_self L_C (Submonoid.mem_powers (v_Ck idx₀))).symm
      · rw [hc1]
        exact ⟨-Q_Z, hw_j₀_c₁⟩
  have halg_range : ∀ z : C_k, algebraMap C_k L_C z ∈ Φ_fwd.range := by
    intro z
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective z
    refine MvPolynomial.induction_on
      (motive := fun Q => algebraMap C_k L_C (Ideal.Quotient.mk _ Q) ∈ Φ_fwd.range) P ?_ ?_ ?_
    · intro a
      refine ⟨MvPolynomial.C a, ?_⟩
      change R_C.val (Θ (MvPolynomial.C a)) = _
      rw [MvPolynomial.eval₂Hom_C]
      rfl
    · intro p q hp hq
      rw [map_add, map_add]
      exact Φ_fwd.range.add_mem hp hq
    · intro p idx' hp
      rw [map_mul, map_mul]
      refine Φ_fwd.range.mul_mem hp ?_
      have hv_eq : algebraMap C_k L_C (v_Ck idx') = Φ_fwd T₀ * w idx' := by
        rw [hΦ_T₀, hα_mul]
      change algebraMap C_k L_C (v_Ck idx') ∈ Φ_fwd.range
      rw [hv_eq]
      exact Φ_fwd.range.mul_mem ⟨T₀, rfl⟩ (hw_range idx')
  have hRC_range : ∀ {x : L_C}, x ∈ R_C → x ∈ Φ_fwd.range := by
    intro x hx
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx
    · rintro _ ⟨idx', rfl⟩
      exact hw_range idx'
    · intro r
      exact halg_range r
    · intro a b _ _ ha hb
      exact Φ_fwd.range.add_mem ha hb
    · intro a b _ _ ha hb
      exact Φ_fwd.range.mul_mem ha hb
  have hΘ_surj : Function.Surjective Θ := by
    intro y
    obtain ⟨p, hp⟩ := hRC_range y.2
    exact ⟨p, Subtype.ext hp⟩
  let h_sub : Fin (m + 1) × Fin 2 → P_free := fun idx =>
    if hj : idx.1 ≠ j₀ then
      T₀ * MvPolynomial.X (some (⟨idx.1, hj⟩, idx.2))
    else if idx.2 = c₀ then
      T₀
    else
      -(T₀ * Q_Z)
  let Ψ_pol : MvPolynomial (Fin (m + 1) × Fin 2) k →+* P_free :=
    MvPolynomial.eval₂Hom MvPolynomial.C h_sub
  have hh_sub_j₀_c₀ : h_sub (j₀, c₀) = T₀ := by
    simp only [h_sub, ne_eq, not_true_eq_false, ↓reduceDIte, ↓reduceIte]
  have hh_sub_j₀_c₁ : h_sub (j₀, c₁) = -(T₀ * Q_Z) := by
    simp only [h_sub, ne_eq, not_true_eq_false, ↓reduceDIte, hc₁_ne, ↓reduceIte]
  have hh_sub_rem : ∀ (s : S_rem) (c : Fin 2),
      h_sub (s.1, c) = T₀ * MvPolynomial.X (some (s, c)) := by
    intro s c
    dsimp [h_sub]
    exact dite_cond_eq_true (eq_true s.2)
  have hΨ_F_odp : Ψ_pol F_odp = 0 := by
    change Ψ_pol (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) = 0
    have h1 : Ψ_pol (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) =
        ∑ j : Fin (m + 1), h_sub (j, 0) * h_sub (j, 1) := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
    rw [h1, hsum_split (fun j => h_sub (j, 0) * h_sub (j, 1)),
      hmul_j₀ (fun c => h_sub (j₀, c)), hh_sub_j₀_c₀, hh_sub_j₀_c₁]
    have h2 : (∑ s : S_rem, h_sub (s.1, 0) * h_sub (s.1, 1)) = (T₀ * T₀) * Q_Z := by
      change _ = (T₀ * T₀) * ∑ s : S_rem,
        MvPolynomial.X (some (s, 0)) * MvPolynomial.X (some (s, 1))
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [hh_sub_rem s 0, hh_sub_rem s 1]
      ring
    rw [h2]
    ring
  have hΨ_ker : ∀ a ∈ Ideal.span {F_odp}, Ψ_pol a = 0 := by
    have hle : Ideal.span {F_odp} ≤ RingHom.ker Ψ_pol := by
      rw [Ideal.span_singleton_le_iff_mem]
      exact RingHom.mem_ker.mpr hΨ_F_odp
    intro a ha
    exact RingHom.mem_ker.mp (hle ha)
  let Ψ_bar : C_k →+* P_free := Ideal.Quotient.lift (Ideal.span {F_odp}) Ψ_pol hΨ_ker
  have hΨ_bar_v₀ : Ψ_bar (v_Ck idx₀) = T₀ := by
    rw [← hidx₀_eq]
    change Ideal.Quotient.lift _ Ψ_pol hΨ_ker (Ideal.Quotient.mk _ (MvPolynomial.X (j₀, c₀))) = T₀
    rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', hh_sub_j₀_c₀]
  have hΨ_bar_rem : ∀ (s : S_rem) (c : Fin 2),
      Ψ_bar (v_Ck (s.1, c)) = T₀ * MvPolynomial.X (some (s, c)) := by
    intro s c
    change Ideal.Quotient.lift _ Ψ_pol hΨ_ker (Ideal.Quotient.mk _ (MvPolynomial.X (s.1, c))) = _
    rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', hh_sub_rem s c]
  let L_free := Localization.Away T₀
  let ι_free : P_free →+* L_free := algebraMap P_free L_free
  have hT₀_ne : T₀ ≠ 0 := MvPolynomial.X_ne_zero none
  have hpowers_nzd : Submonoid.powers T₀ ≤ nonZeroDivisors P_free := by
    rintro _ ⟨n, rfl⟩
    exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n hT₀_ne)
  have hι_inj : Function.Injective ι_free :=
    IsLocalization.injective L_free hpowers_nzd
  have hu_T₀ : IsUnit (ι_free T₀) :=
    IsLocalization.Away.algebraMap_isUnit (S := L_free) T₀
  let ψ_to_L : C_k →+* L_free := ι_free.comp Ψ_bar
  have hu_v₀ : IsUnit (ψ_to_L (v_Ck idx₀)) := by
    change IsUnit (ι_free (Ψ_bar (v_Ck idx₀)))
    rw [hΨ_bar_v₀]
    exact hu_T₀
  let Ψ_loc : L_C →+* L_free :=
    IsLocalization.Away.lift (S := L_C) (v_Ck idx₀) hu_v₀
  have hΨ_loc_alg : ∀ z : C_k, Ψ_loc (algebraMap C_k L_C z) = ι_free (Ψ_bar z) :=
    fun z => IsLocalization.Away.lift_eq (S := L_C) (v_Ck idx₀) hu_v₀ z
  have hΨ_loc_w : ∀ (s : S_rem) (c : Fin 2),
      Ψ_loc (w (s.1, c)) = ι_free (MvPolynomial.X (some (s, c))) := by
    intro s c
    apply hu_T₀.mul_left_cancel
    calc
      ι_free T₀ * Ψ_loc (w (s.1, c))
        = ι_free (Ψ_bar (v_Ck idx₀)) * Ψ_loc (w (s.1, c)) := by rw [hΨ_bar_v₀]
      _ = Ψ_loc α * Ψ_loc (w (s.1, c)) := by rw [← hΨ_loc_alg]
      _ = Ψ_loc (α * w (s.1, c)) := (map_mul Ψ_loc _ _).symm
      _ = Ψ_loc (algebraMap C_k L_C (v_Ck (s.1, c))) := by rw [hα_mul]
      _ = ι_free (Ψ_bar (v_Ck (s.1, c))) := hΨ_loc_alg _
      _ = ι_free (T₀ * MvPolynomial.X (some (s, c))) := by rw [hΨ_bar_rem s c]
      _ = ι_free T₀ * ι_free (MvPolynomial.X (some (s, c))) := map_mul ι_free _ _
  have hcomp_id : Ψ_loc.comp Φ_fwd = ι_free := by
    apply MvPolynomial.ringHom_ext
    · intro r
      change Ψ_loc (R_C.val (Θ (MvPolynomial.C r))) = ι_free (MvPolynomial.C r)
      rw [MvPolynomial.eval₂Hom_C]
      change Ψ_loc (algebraMap C_k L_C (Ideal.Quotient.mk _ (MvPolynomial.C r))) = _
      rw [hΨ_loc_alg]
      change ι_free (Ideal.Quotient.lift _ Ψ_pol hΨ_ker (Ideal.Quotient.mk _ (MvPolynomial.C r))) = _
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · intro x
      cases x with
      | none =>
        change Ψ_loc (Φ_fwd T₀) = ι_free T₀
        rw [hΦ_T₀, hΨ_loc_alg, hΨ_bar_v₀]
      | some sc =>
        rcases sc with ⟨s, c⟩
        change Ψ_loc (Φ_fwd (MvPolynomial.X (some (s, c)))) = _
        rw [hΦ_some s c, hΨ_loc_w s c]
  have hΘ_inj : Function.Injective Θ := by
    intro p₁ p₂ h
    have hΦ : Φ_fwd p₁ = Φ_fwd p₂ := congrArg Subtype.val h
    have hι : ι_free p₁ = ι_free p₂ := by
      rw [← hcomp_id]
      exact congrArg Ψ_loc hΦ
    exact hι_inj hι
  let e_free : P_free ≃+* ↥R_C := RingEquiv.ofBijective Θ ⟨hΘ_inj, hΘ_surj⟩
  let e_ren : MvPolynomial (Fin (2 * m + 1)) k ≃+* P_free :=
    (MvPolynomial.renameEquiv k σ_fin.symm).toRingEquiv
  let e_poly : MvPolynomial (Fin (2 * m + 1)) k ≃+* ↥R_C := e_ren.trans e_free
  refine ⟨e_poly, i₀, ?_, ?_⟩
  · apply RingHom.ext
    intro r
    change Θ (MvPolynomial.rename σ_fin.symm (MvPolynomial.C r)) = ι_k r
    rw [MvPolynomial.rename_C, MvPolynomial.eval₂Hom_C]
  · change Θ (MvPolynomial.rename σ_fin.symm (MvPolynomial.X (σ_fin none))) =
      algebraMap C_k ↥R_C (v_Ck idx₀)
    rw [MvPolynomial.rename_X, σ_fin.symm_apply_apply, MvPolynomial.eval₂Hom_X']

theorem weil_odp_ring_roof_tangent_quadric_and_rees_smooth (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (A₀ : Type u) [CommRing A₀] [IsDomain A₀]
    (alg_A₀ : F →+* A₀) (hFT : alg_A₀.FiniteType)
    (ε₀ : A₀ →+* F) (hε_id : ε₀.comp alg_A₀ = RingHom.id F)
    (E₁ : Type u) [Field E₁] [Algebra F E₁] [FiniteDimensional F E₁]
    (B' : Type u) [CommRing B']
    (q₀ : PrimeSpectrum B')
    (φ₁ : A₀ →+* B') (hφ₁_et : φ₁.Etale)
    (φ₂ : (MvPolynomial (Fin (m + 1) × Fin 2) E₁ ⧸
      Ideal.span {∑ j : Fin (m + 1),
        (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) E₁) *
          MvPolynomial.X (j, 1)}) →+* B')
    (hφ₂_et : φ₂.Etale)
    (hφ_alg : φ₁.comp alg_A₀ =
      φ₂.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C.comp (algebraMap F E₁))))
