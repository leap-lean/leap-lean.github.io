                right_inv := fun φ => by
                  apply ModuleCat.hom_ext; apply LinearMap.ext; intro v; rfl }
            homEquiv_naturality_left_symm := fun _ _ => by ext v; rfl
            homEquiv_naturality_right := fun _ _ => by
              apply ModuleCat.hom_ext; apply LinearMap.ext; intro v; rfl }
    have hSheafCompOfAdj : ∀ {D₁ D₂ : Type (u + 1)}
        [CategoryTheory.Category.{u, u + 1} D₁] [CategoryTheory.Category.{u, u + 1} D₂]
        {L_f : CategoryTheory.Functor D₁ D₂} {R_f : CategoryTheory.Functor D₂ D₁}
        (adj : L_f ⊣ R_f),
        J_X.HasSheafCompose R_f := by
      intro D₁ D₂ _ _ L_f R_f adj
      refine ⟨fun P hP A₀ => ?_⟩
      let e_iso : (P.comp R_f).comp (CategoryTheory.coyoneda.obj (Opposite.op A₀)) ≅
          P.comp (CategoryTheory.coyoneda.obj (Opposite.op (L_f.obj A₀))) :=
        CategoryTheory.NatIso.ofComponents
          (fun W => (adj.homEquiv A₀ (P.obj W)).symm.toIso)
          (fun {W₁ W₂} f => by
            ext u
            dsimp
            exact adj.homEquiv_naturality_right_symm u (P.map f))
      exact CategoryTheory.Presieve.isSheaf_iso J_X e_iso.symm (hP (L_f.obj A₀))
    have hHSC_Fgt : ∀ (m : ℕ) [Fact (1 < m)], J_X.HasSheafCompose (Fgt_of m) :=
      fun m _ => hSheafCompOfAdj (adj_L m)
    have hHSC_C0 : ∀ (m : ℕ) [Fact (1 < m)], J_X.HasSheafCompose (C_0 m) :=
      fun m _ => hSheafCompOfAdj (adj_R m)
    let U_dir : ∀ (m : ℕ) [Fact (1 < m)],
        CategoryTheory.Functor
          (CategoryTheory.Sheaf J_X (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))))
          (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) :=
      fun m _ => @CategoryTheory.sheafCompose _ _ _ _ _ _ J_X (Fgt_of m) (hHSC_Fgt m)
    let C_dir : ∀ (m : ℕ) [Fact (1 < m)],
        CategoryTheory.Functor
          (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
          (CategoryTheory.Sheaf J_X (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))) :=
      fun m _ => @CategoryTheory.sheafCompose _ _ _ _ _ _ J_X (C_0 m) (hHSC_C0 m)
    let adj_LU : ∀ (m : ℕ) [Fact (1 < m)],
        CategoryTheory.Sheaf.composeAndSheafify J_X (L_0 m) ⊣ U_dir m :=
      fun m _ =>
        let _ := hHSC_Fgt m
        CategoryTheory.Sheaf.adjunction J_X (adj_L m)
    let e_U : ∀ (m : ℕ) [Fact (1 < m)], U_sh m ≅ U_dir m :=
      fun m _ =>
        let adj_sh := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
        (CategoryTheory.Functor.associator (U_dir m)
          (CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u})
          (CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u})) ≪≫
        CategoryTheory.Functor.isoWhiskerLeft (U_dir m) (CategoryTheory.asIso adj_sh.counit) ≪≫
        CategoryTheory.Functor.rightUnitor (U_dir m)
    have hFaithful_U : ∀ (m : ℕ) [Fact (1 < m)], (U_dir m).Faithful := by
      intro m _
      refine ⟨fun {M₁ M₂} f₁ f₂ hf => ?_⟩
      apply CategoryTheory.InducedCategory.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      have hW := congrArg (fun h => h.hom.app W) hf
      exact CategoryTheory.ConcreteCategory.congr_hom hW x
    have hPFL_U : ∀ (m : ℕ) [Fact (1 < m)],
        CategoryTheory.Limits.PreservesFiniteLimits (U_dir m) := by
      intro m _
      have : (U_dir m).IsRightAdjoint := (adj_LU m).isRightAdjoint
      exact inferInstance
    have hNsmul_app : ∀ {G₁ G₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
        (k₀ : ℕ) (g : G₁ ⟶ G₂) (W : (X.Etale)ᵒᵖ),
        (k₀ • g).hom.app W = k₀ • (g.hom.app W) := by
      intro G₁ G₂ k₀ g W
      induction k₀ with
      | zero => rw [zero_nsmul, zero_nsmul]; rfl
      | succ n ih =>
        rw [succ_nsmul, succ_nsmul]
        change (n • g).hom.app W + g.hom.app W = n • (g.hom.app W) + g.hom.app W
        rw [ih]
    have hTorU : ∀ (m : ℕ) [Fact (1 < m)]
        (M : CategoryTheory.Sheaf J_X (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))),
        m • CategoryTheory.CategoryStruct.id ((U_sh m).obj M) = 0 := by
      intro m _ M
      have hTor_dir : m • CategoryTheory.CategoryStruct.id ((U_dir m).obj M) = 0 := by
        apply CategoryTheory.InducedCategory.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext W
        apply AddCommGrpCat.ext
        intro x
        rw [hNsmul_app]
        change (m • x : ↥(M.obj.obj W)) = 0
        exact hMod_tor m (M.obj.obj W) x
      let isoM := (e_U m).app M
      rw [← CategoryTheory.cancel_mono isoM.hom, CategoryTheory.Limits.zero_comp,
        CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.comp_id isoM.hom, ← CategoryTheory.Preadditive.comp_nsmul,
        hTor_dir, CategoryTheory.Limits.comp_zero]
    let Tors_0 : ∀ (m₂ d : ℕ) [Fact (1 < d)],
        CategoryTheory.Functor
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m₂)))
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod d))) :=
      fun m₂ d _ => (Fgt_of m₂).comp (C_0 d)
    let modRes_of : ∀ (m₂ d : ℕ) [Fact (1 < m₂)] [Fact (1 < d)], d ∣ m₂ →
        ∀ (V : ModuleCat.{u, u} (ULift.{u, 0} (ZMod d))),
          Module (ULift.{u, 0} (ZMod m₂)) ↥V :=
      fun m₂ d _ _ hd V => mkMod m₂ ↥V (fun v => by
        rcases hd with ⟨k₀, rfl⟩
        rw [mul_nsmul, hMod_tor d V v, nsmul_zero])
    let Res_0_of : ∀ (m₂ d : ℕ) [Fact (1 < m₂)] [Fact (1 < d)], d ∣ m₂ →
        CategoryTheory.Functor
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod d)))
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m₂))) :=
      fun m₂ d _ _ hd =>
        letI : ∀ (V : ModuleCat.{u, u} (ULift.{u, 0} (ZMod d))),
            Module (ULift.{u, 0} (ZMod m₂)) ↥V := modRes_of m₂ d hd
        { obj := fun V => ModuleCat.of (ULift.{u, 0} (ZMod m₂)) ↥V
          map := fun {V₁ V₂} f =>
            ModuleCat.ofHom
              { toAddHom := f.hom.toAddHom
                map_smul' := fun c v => map_nsmul f.hom c.down.val v }
          map_id := fun _ => by apply ModuleCat.hom_ext; apply LinearMap.ext; intro v; rfl
          map_comp := fun _ _ => by apply ModuleCat.hom_ext; apply LinearMap.ext; intro v; rfl }
    let adj_RT0 : ∀ (m₂ d : ℕ) [Fact (1 < m₂)] [Fact (1 < d)] (hd : d ∣ m₂),
        Res_0_of m₂ d hd ⊣ Tors_0 m₂ d :=
      fun m₂ d _ _ hd =>
        letI : ∀ (A : AddCommGrpCat.{u}),
            Module (ULift.{u, 0} (ZMod d)) ↥(nsmulAddMonoidHom d : ↥A →+ ↥A).ker :=
          modKer_of d
        letI : ∀ (V : ModuleCat.{u, u} (ULift.{u, 0} (ZMod d))),
            Module (ULift.{u, 0} (ZMod m₂)) ↥V := modRes_of m₂ d hd
        CategoryTheory.Adjunction.mkOfHomEquiv
          { homEquiv := fun V W =>
              { toFun := fun φ => ModuleCat.ofHom
                  { toFun := fun v => ⟨φ.hom v, by
                      simp only [AddMonoidHom.mem_ker, nsmulAddMonoidHom_apply]
                      have hadd : φ.hom (d • v) = d • φ.hom v := map_nsmul φ.hom d v
                      rw [← hadd, hMod_tor d V v, map_zero]⟩
                    map_add' := fun v₁ v₂ => Subtype.ext (map_add φ.hom v₁ v₂)
