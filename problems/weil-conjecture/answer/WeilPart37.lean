            MvPolynomial (Fin (2 * m + 1 + 1)) K) *
            MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0)
      ι_Q) :
    Subsingleton (weilEtaleTorsionH (weilGeomScheme K Q_K) (ℓ ^ (r + 1)) (2 * m + 1)) ∧
    ∀ (f_Q : weilEtaleTorsionH (weilGeomScheme K Q_K) (ℓ ^ (r + 1)) (2 * m) →+
        weilEtaleTorsionH (weilGeomScheme K Q_K) (ℓ ^ (r + 1)) (2 * m)),
      WeilIsTorsionGeomFrobAction K Q_K (ℓ ^ (r + 1)) (2 * m) f_Q →
      ∀ w : weilEtaleTorsionH (weilGeomScheme K Q_K) (ℓ ^ (r + 1)) (2 * m),
        f_Q w = (Nat.card K ^ m) • w :=
by
  
  have hAbelianDimShift : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      (oneR : 𝒞) (d : ℕ) (T : ℕ → 𝒞) (η : oneR ⟶ T 0) (diff : ∀ q : ℕ, T q ⟶ T (q + 1)),
      CategoryTheory.Limits.IsZero (T (2 * d + 1)) →
      CategoryTheory.Mono η →
      (∃ h₀ : η ≫ diff 0 = 0, (CategoryTheory.ShortComplex.mk η (diff 0) h₀).Exact) →
      (∀ q : ℕ, ∃ hq : diff q ≫ diff (q + 1) = 0,
        (CategoryTheory.ShortComplex.mk (diff q) (diff (q + 1)) hq).Exact) →
      (∀ (q k₀ : ℕ), 1 ≤ k₀ → Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (T q) k₀)) →
      ∀ (i : ℕ), 2 * d < i → Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR oneR i) := by
    intro 𝒞 _ _ _ oneR d T η diff hZero_top hMono_η hEx0 hEx hAcyc i hi
    have hSES : ∀ q : ℕ,
        ∃ (f : CategoryTheory.Limits.kernel (diff q) ⟶ T q)
          (g : T q ⟶ CategoryTheory.Limits.kernel (diff (q + 1))) (hfg : f ≫ g = 0),
          (CategoryTheory.ShortComplex.mk f g hfg).ShortExact := by
      intro q
      obtain ⟨hq, hEx_q⟩ := hEx q
      have hfg : CategoryTheory.Limits.kernel.ι (diff q) ≫
          CategoryTheory.Limits.kernel.lift (diff (q + 1)) (diff q) hq = 0 := by
        rw [← CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι (diff (q + 1))),
          CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι,
          CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.kernel.condition]
      have hEpi_g : CategoryTheory.Epi
          (CategoryTheory.Limits.kernel.lift (diff (q + 1)) (diff q) hq) :=
        (CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift _).mp hEx_q
      have hKer : CategoryTheory.Limits.IsLimit
          (CategoryTheory.Limits.KernelFork.ofι (CategoryTheory.Limits.kernel.ι (diff q)) hfg) :=
        CategoryTheory.Limits.KernelFork.IsLimit.ofι _ hfg
          (fun x hx => CategoryTheory.Limits.kernel.lift (diff q) x (by
            rw [← CategoryTheory.Limits.kernel.lift_ι (diff (q + 1)) (diff q) hq,
              ← CategoryTheory.Category.assoc, hx, CategoryTheory.Limits.zero_comp]))
          (fun _ _ => CategoryTheory.Limits.kernel.lift_ι _ _ _)
          (fun _ _ _ hm => by
            rw [← CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι (diff q))]
            exact hm.trans (CategoryTheory.Limits.kernel.lift_ι _ _ _).symm)
      exact ⟨_, _, hfg,
        { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hKer
          mono_f := inferInstance
          epi_g := hEpi_g }⟩
    have hExtIsoSub : ∀ {A B : 𝒞} (_ : A ≅ B) (m₀ : ℕ),
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR B m₀) →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR A m₀) := by
      intro A B e m₀ hSubB
      refine ⟨fun a b => ?_⟩
      have ha : a.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero m₀) =
          b.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero m₀) :=
        hSubB.elim _ _
      have ha2 :=
        congrArg (fun x => x.comp (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero m₀)) ha
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero a _ _ (Nat.add_zero m₀),
        CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero b _ _ (Nat.add_zero m₀),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id,
        CategoryTheory.Abelian.Ext.comp_mk₀_id, CategoryTheory.Abelian.Ext.comp_mk₀_id] at ha2
      exact ha2
    have hZ_top : ∀ k₀ : ℕ, 1 ≤ k₀ →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR
          (CategoryTheory.Limits.kernel (diff (2 * d))) k₀) := by
      intro k₀ hk₀
      have hdiff_zero : diff (2 * d) = 0 := hZero_top.eq_of_tgt _ _
      have he_top : ∃ e_top : CategoryTheory.Limits.kernel (diff (2 * d)) ≅ T (2 * d), True :=
        ⟨{ hom := CategoryTheory.Limits.kernel.ι (diff (2 * d))
           inv := CategoryTheory.Limits.kernel.lift (diff (2 * d)) (𝟙 _)
             (by rw [hdiff_zero, CategoryTheory.Limits.comp_zero])
           hom_inv_id := by
             rw [← CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι (diff (2 * d))),
               CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι,
               CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
           inv_hom_id := CategoryTheory.Limits.kernel.lift_ι _ _ _ }, trivial⟩
      obtain ⟨e_top, -⟩ := he_top
      exact hExtIsoSub e_top k₀ (hAcyc (2 * d) k₀ hk₀)
    have hStep : ∀ s : ℕ, s ≤ 2 * d → ∀ k₀ : ℕ, 1 ≤ k₀ →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR
          (CategoryTheory.Limits.kernel (diff (2 * d - s))) (k₀ + s)) := by
      intro s
      induction s with
      | zero =>
        intro _ k₀ hk₀
        simpa using hZ_top k₀ hk₀
      | succ s ih =>
        intro hs k₀ hk₀
        have h_idx : 2 * d - s = 2 * d - (s + 1) + 1 := by omega
        obtain ⟨f, g, hfg, hSE⟩ := hSES (2 * d - (s + 1))
        have hSub_Znext : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR
            (CategoryTheory.Limits.kernel (diff (2 * d - (s + 1) + 1))) (k₀ + s)) := by
          rw [← h_idx]
          exact ih (by omega) k₀ hk₀
        have hSub_T : Subsingleton
            (CategoryTheory.Abelian.Ext.{u} oneR (T (2 * d - (s + 1))) (k₀ + (s + 1))) :=
          hAcyc _ _ (by omega)
        refine ⟨fun a b => ?_⟩
        have hdiff : (a - b).comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero _) = 0 :=
          hSub_T.elim _ _
        obtain ⟨c, hc⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ oneR hSE (a - b)
          hdiff (show (k₀ + s) + 1 = k₀ + (s + 1) by omega)
        rw [hSub_Znext.elim c 0, CategoryTheory.Abelian.Ext.zero_comp] at hc
        exact sub_eq_zero.mp hc.symm
    have hZ0 : Subsingleton
        (CategoryTheory.Abelian.Ext.{u} oneR (CategoryTheory.Limits.kernel (diff 0)) i) := by
      have h1 := hStep (2 * d) (le_refl _) (i - 2 * d) (by omega)
      have h_eq : i - 2 * d + 2 * d = i := by omega
      rw [Nat.sub_self, h_eq] at h1
      exact h1
    obtain ⟨h₀, hEx_0⟩ := hEx0
    have _ : CategoryTheory.Epi (CategoryTheory.Limits.kernel.lift (diff 0) η h₀) :=
      (CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift _).mp hEx_0
    have _ : CategoryTheory.Mono (CategoryTheory.Limits.kernel.lift (diff 0) η h₀) :=
      CategoryTheory.mono_of_mono_fac (CategoryTheory.Limits.kernel.lift_ι (diff 0) η h₀)
    have _ : CategoryTheory.IsIso (CategoryTheory.Limits.kernel.lift (diff 0) η h₀) :=
      CategoryTheory.isIso_of_mono_of_epi _
    exact hExtIsoSub (CategoryTheory.asIso (CategoryTheory.Limits.kernel.lift (diff 0) η h₀)) i hZ0

