        (∀ (m : ℕ),
          let AM_m := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
          let u_M_m := (adj_π.homEquiv (weilEtaleTorsionSheaf Y₀ m) (weilEtaleTorsionSheaf X m))
