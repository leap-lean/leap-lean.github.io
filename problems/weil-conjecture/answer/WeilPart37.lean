  obtain ⟨hPullEx, hPullId, hPullComp, _, hFrobEqPull⟩ := weil_etale_torsion_pullback_functoriality

  have hPullIsoBij : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (e : S₁ ≅ S₂) (m₀ i₀ : ℕ)
      (p_hom : weilEtaleTorsionH S₂ m₀ i₀ →+ weilEtaleTorsionH S₁ m₀ i₀)
      (p_inv : weilEtaleTorsionH S₁ m₀ i₀ →+ weilEtaleTorsionH S₂ m₀ i₀),
      WeilIsTorsionEtalePullback e.hom m₀ i₀ p_hom →
      WeilIsTorsionEtalePullback e.inv m₀ i₀ p_inv →
      Function.Bijective p_hom := by
    intro S₁ S₂ e m₀ i₀ p_hom p_inv hp_hom hp_inv
    obtain ⟨p_id₂, hp_id₂⟩ := hPullEx (𝟙 S₂) m₀ i₀
    obtain ⟨p_id₁, hp_id₁⟩ := hPullEx (𝟙 S₁) m₀ i₀
    have hid₂ := hPullId m₀ i₀ p_id₂ hp_id₂
    have hid₁ := hPullId m₀ i₀ p_id₁ hp_id₁
    have hc₂ : WeilIsTorsionEtalePullback (e.inv ≫ e.hom) m₀ i₀ p_id₂ := by
