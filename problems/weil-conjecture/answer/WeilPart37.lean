                      exact congrArg Subtype.val (map_nsmul ψ.hom c.down.val v) }
                left_inv := fun φ => by
                  apply ModuleCat.hom_ext; apply LinearMap.ext; intro v; rfl
                right_inv := fun ψ => by
                  apply ModuleCat.hom_ext; apply LinearMap.ext; intro v; rfl }
            homEquiv_naturality_left_symm := fun _ _ => by
              apply ModuleCat.hom_ext; apply LinearMap.ext; intro v; rfl
            homEquiv_naturality_right := fun _ _ => by
              apply ModuleCat.hom_ext; apply LinearMap.ext; intro v; rfl }
    have hHSC_Tors : ∀ (m₂ d : ℕ) [Fact (1 < m₂)] [Fact (1 < d)],
        d ∣ m₂ → J_X.HasSheafCompose (Tors_0 m₂ d) :=
      fun m₂ d _ _ hd => hSheafCompOfAdj (adj_RT0 m₂ d hd)
    have hTorsInj : ∀ (m₂ d : ℕ) [Fact (1 < m₂)] [Fact (1 < d)] (hd : d ∣ m₂)
        (I : CategoryTheory.Sheaf J_X (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m₂))))
        [CategoryTheory.Injective I],
        CategoryTheory.Injective
          ((@CategoryTheory.sheafCompose _ _ _ _ _ _ J_X (Tors_0 m₂ d)
