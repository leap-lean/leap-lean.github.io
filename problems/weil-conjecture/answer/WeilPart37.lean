      @Nat.card_eq_fintype_card F₂ (Fintype.ofFinite F₂) |>.symm
    have hφ_conj : ∀ y : k₂, κ₀ (φ_F₂ y) = φ_F (φ_F (κ₀ y)) := by
      intro y
      have h1 : φ_F₂ y = y ^ Nat.card F₂ := by
        change (@FiniteField.frobeniusAlgEquivOfAlgebraic F₂ _ (Fintype.ofFinite F₂) k₂ _ _ _) y = _
        rw [FiniteField.frobeniusAlgEquivOfAlgebraic_apply, hcard_eq_F₂]
      have h2 : ∀ x : k, φ_F x = x ^ Nat.card F := by
        intro x
        change (@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) k _ _ _) x = _
        rw [FiniteField.frobeniusAlgEquivOfAlgebraic_apply, hcard_eq_F]
      rw [h1, hcard₂, map_pow, h2, h2, ← pow_mul, sq]
    have hψ_pt : ∀ z : k, φ_F₂.symm (κ₀.symm z) = κ₀.symm (φ_F.symm (φ_F.symm z)) := by
      intro z
      apply κ₀.injective
      rw [κ₀.apply_symm_apply]
      apply φ_F.injective
      apply φ_F.injective
      rw [φ_F.apply_symm_apply, φ_F.apply_symm_apply, ← hφ_conj, φ_F₂.apply_symm_apply,
        κ₀.apply_symm_apply]
    have hSpec_conj :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F₂.symm.toRingHom) ≫ u_k₂_k =
          u_k₂_k ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F.symm.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F.symm.toRingHom) :=
      ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
        (congrArg AlgebraicGeometry.Spec.map
          (((CommRingCat.ofHom_comp _ _).symm.trans
            (congrArg CommRingCat.ofHom (RingHom.ext hψ_pt))).trans
            ((CommRingCat.ofHom_comp _ _).trans
              (congrArg (· ≫ _) (CommRingCat.ofHom_comp _ _)))))).trans
        ((AlgebraicGeometry.Spec.map_comp _ _).trans
          (congrArg (_ ≫ ·) (AlgebraicGeometry.Spec.map_comp _ _)))
    let W₂ := weilBaseChangeOver F F₂ W
    let fst_k : weilGeomScheme F W ⟶ W.left := CategoryTheory.Limits.pullback.fst W.hom g_k
    let snd_k : weilGeomScheme F W ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      CategoryTheory.Limits.pullback.snd W.hom g_k
    let fst₂ : weilGeomScheme F₂ W₂ ⟶ W₂.left := CategoryTheory.Limits.pullback.fst W₂.hom g_F₂k₂
    let snd₂ : weilGeomScheme F₂ W₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₂) :=
      CategoryTheory.Limits.pullback.snd W₂.hom g_F₂k₂
    let fst₁ : W₂.left ⟶ W.left := CategoryTheory.Limits.pullback.fst W.hom g_FF₂
    have hhom_fst : (e_geom W).hom ≫ fst_k = fst₂ ≫ fst₁ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hhom_snd : (e_geom W).hom ≫ snd_k = snd₂ ≫ u_k₂_k :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hf₂_snd : weilGeomFrobHom F₂ W₂ ≫ snd₂ =
        snd₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F₂.symm.toRingHom) :=
