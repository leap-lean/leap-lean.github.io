                right_inv := fun ψ => by ext a; rfl }
            homEquiv_naturality_left_symm := fun {A₁ A₂ V} f ψ => by
              apply ModuleCat.hom_ext
              apply LinearMap.ext
              intro q
              obtain ⟨a, rfl⟩ := QuotientAddGroup.mk_surjective q
              rfl
            homEquiv_naturality_right := fun {A V₁ V₂} φ g => by ext a; rfl }
    let C_0 : ∀ (m : ℕ) [Fact (1 < m)],
        CategoryTheory.Functor AddCommGrpCat.{u}
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) :=
      fun m _ =>
        letI : ∀ (A : AddCommGrpCat.{u}),
            Module (ULift.{u, 0} (ZMod m)) ↥(nsmulAddMonoidHom m : ↥A →+ ↥A).ker :=
          modKer_of m
        { obj := fun A =>
            ModuleCat.of (ULift.{u, 0} (ZMod m)) ↥(nsmulAddMonoidHom m : ↥A →+ ↥A).ker
          map := fun {A B} f =>
            ModuleCat.ofHom
              { toFun := fun x => ⟨f.hom x.1, by
                  simp only [AddMonoidHom.mem_ker, nsmulAddMonoidHom_apply]
                  rw [← map_nsmul, show m • x.1 = 0 from x.2, map_zero]⟩
                map_add' := fun x y => Subtype.ext (map_add f.hom x.1 y.1)
                map_smul' := fun c x => Subtype.ext (map_nsmul f.hom c.down.val x.1) }
          map_id := fun _ => by
            apply ModuleCat.hom_ext; apply LinearMap.ext; intro x; rfl
          map_comp := fun _ _ => by
            apply ModuleCat.hom_ext; apply LinearMap.ext; intro x; rfl }
    let adj_R : ∀ (m : ℕ) [Fact (1 < m)], Fgt_of m ⊣ C_0 m :=
      fun m _ =>
        letI : ∀ (A : AddCommGrpCat.{u}),
            Module (ULift.{u, 0} (ZMod m)) ↥(nsmulAddMonoidHom m : ↥A →+ ↥A).ker :=
          modKer_of m
        CategoryTheory.Adjunction.mkOfHomEquiv
          { homEquiv := fun V A =>
              { toFun := fun ψ => ModuleCat.ofHom
                  { toFun := fun v => ⟨ψ.hom v, by
                      simp only [AddMonoidHom.mem_ker, nsmulAddMonoidHom_apply]
                      rw [← map_nsmul, hMod_tor m V v, map_zero]⟩
                    map_add' := fun v₁ v₂ => Subtype.ext (map_add ψ.hom v₁ v₂)
