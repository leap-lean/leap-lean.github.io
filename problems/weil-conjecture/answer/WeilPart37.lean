    intro q₀
    induction q₀ with
    | zero =>
      intro ℱ _
      obtain ⟨𝒥, 𝒬, _, hInj_PJ, j, p, hjp, hSE_F, ℬ, ι_B, hMono_ιB, π_B, _,
          h₁, _, hSE₁, _, hfac, hIntertwine, _⟩ := hStep ℱ
      letI : CategoryTheory.Injective (P_push.obj 𝒥) := hInj_PJ
      letI : CategoryTheory.Mono ι_B := hMono_ιB
      rw [injective_iff_map_eq_zero]
      intro z hz
      have hzf : z.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map j)) (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨b₀, hb₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_Y hSE₁ z hzf rfl
      have hb₀_ext : (Λ 0 𝒬 (b₀.comp (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero 0))).comp
          hSE_F.extClass rfl = 0 := by
        rw [← hIntertwine 0 b₀, hb₀, hz]
      obtain ⟨u₀, hu₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ (P_pull.obj Fℤ_Y) hSE_F
          (Λ 0 𝒬 (b₀.comp (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero 0))) rfl hb₀_ext
      obtain ⟨u₁, hu₁⟩ := (hΛ₀_bij 𝒥).2 u₀
      have hΛQ_eq : Λ 0 𝒬 ((u₁.comp (CategoryTheory.Abelian.Ext.mk₀ π_B) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero 0)) =
          Λ 0 𝒬 (b₀.comp (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero 0)) := by
        rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _
            (Nat.add_zero 0) (Nat.zero_add 0) (Nat.add_zero 0),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hfac, hΛ_nat p 0 u₁, hu₁, hu₀]
      have hb₀_ι : (u₁.comp (CategoryTheory.Abelian.Ext.mk₀ π_B) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero 0) =
          b₀.comp (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero 0) :=
        (hΛ₀_bij 𝒬).1 hΛQ_eq
