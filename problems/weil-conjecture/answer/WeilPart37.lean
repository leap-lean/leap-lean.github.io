  let Zts_2 := weilBaseChangeOver F F₂ Z_tilde_s
  let p_Zts2 : Zts_2.left ⟶ Z_tilde_s.left :=
    CategoryTheory.Limits.pullback.fst Z_tilde_s.hom g_FF₂
  have hpb_Zts2 : CategoryTheory.IsPullback p_Zts2 Zts_2.hom Z_tilde_s.hom g_FF₂ :=
    CategoryTheory.IsPullback.of_hasPullback Z_tilde_s.hom g_FF₂
  have : AlgebraicGeometry.IsProper Zts_2.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Zts2 hProp_Zts
  have : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Zts_2.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Zts2 hSm_Zts
  have : AlgebraicGeometry.IsReduced Zts_2.left := hRedOfSm F₂ (2 * m + 1) Zts_2
  let q_bar_2 : Zts_bar.left ⟶ Zts_2.left :=
    hpb_Zts2.lift fst_Zts_bar (Zts_bar.hom ≫ g_F₂k)
      (by rw [CategoryTheory.Category.assoc, hg_comp]; exact hpb_Zts_bar.w)
  have hPb_bar_2 : CategoryTheory.IsPullback q_bar_2 Zts_bar.hom Zts_2.hom g_F₂k := by
    refine CategoryTheory.IsPullback.of_right ?_ (hpb_Zts2.lift_snd _ _ _) hpb_Zts2
    rw [hpb_Zts2.lift_fst, hg_comp]
    exact hpb_Zts_bar
  have hg_F₂k_surj : AlgebraicGeometry.Surjective g_F₂k :=
    ⟨fun _ => ⟨default, Subsingleton.elim _ _⟩⟩
  have hq_surj : AlgebraicGeometry.Surjective q_bar_2 :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_bar_2.flip hg_F₂k_surj
  have hIrred_Zts2_univ : IsIrreducible (Set.univ : Set ↥Zts_2.left) := by
    have himg : q_bar_2.base '' (Set.univ : Set ↥Zts_bar.left) = Set.univ :=
      Set.image_univ_of_surjective hq_surj.1
    rw [← himg]
    exact IsIrreducible.image (IrreducibleSpace.isIrreducible_univ ↥Zts_bar.left)
