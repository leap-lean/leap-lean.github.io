        let R_W : CommRingCat.{u} := Y₀.presheaf.obj (Opposite.op W)
        let j_W : AlgebraicGeometry.Spec R_W ⟶ Y₀ := hAff_W.fromSpec
        have hy_sub : Set.range y₀.base ⊆ Set.range j_W.base := by
