  have hKerOpenFrob : ∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      [AlgebraicGeometry.GeometricallyIrreducible X.hom]
      [AlgebraicGeometry.IsProper X.hom]
      (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
      {Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))}
      (i_Z : Z ⟶ X) (_ : AlgebraicGeometry.IsClosedImmersion i_Z.left)
      (U : X.left.Opens) (_ : (U : Set X.left) = (Set.range i_Z.left.base)ᶜ)
      (c : ℕ) (_ : c ≤ d),
      (∀ (f_Z : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ (r + 1)) (2 * d - 2 * c) →+
            weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ (r + 1)) (2 * d - 2 * c)),
        WeilIsTorsionGeomFrobAction K Z (ℓ ^ (r + 1)) (2 * d - 2 * c) f_Z →
        ∀ z, f_Z z = (Nat.card K ^ (d - c)) • z) →
      let pr_X : weilGeomScheme K X ⟶ X.left := CategoryTheory.Limits.pullback.fst X.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
      let U_bar : (weilGeomScheme K X).Opens := (TopologicalSpace.Opens.map pr_X.base).obj U
      ∀ (f_X : weilEtaleTorsionH (weilGeomScheme K X) (ℓ ^ (r + 1)) (2 * c) →+
            weilEtaleTorsionH (weilGeomScheme K X) (ℓ ^ (r + 1)) (2 * c))
        (p_U : weilEtaleTorsionH (weilGeomScheme K X) (ℓ ^ (r + 1)) (2 * c) →+
            weilEtaleTorsionH U_bar.toScheme (ℓ ^ (r + 1)) (2 * c)),
        WeilIsTorsionGeomFrobAction K X (ℓ ^ (r + 1)) (2 * c) f_X →
        WeilIsTorsionEtalePullback U_bar.ι (ℓ ^ (r + 1)) (2 * c) p_U →
        ∀ x : weilEtaleTorsionH (weilGeomScheme K X) (ℓ ^ (r + 1)) (2 * c),
          p_U x = 0 → f_X x = (Nat.card K ^ c) • x := by
    intro X _ _ d _ Z i_Z hiZ_cl U hU_compl c hc_le hZ_frob pr_X U_bar f_X p_U hf_X hp_U x hx_U
    obtain ⟨hInt_X, hProp_X, hSm_X⟩ := weil_smooth_algClosure_baseChange_integral K X d
    let _ : AlgebraicGeometry.IsProper (weilBaseChangeOver K (AlgebraicClosure K) X).hom := hProp_X
    let _ : AlgebraicGeometry.SmoothOfRelativeDimension d
      (weilBaseChangeOver K (AlgebraicClosure K) X).hom := hSm_X
    obtain ⟨tr_X, _, _, hPD_X⟩ :=
      weil_etale_smooth_proper_torsion_poincare_duality (AlgebraicClosure K)
        (weilBaseChangeOver K (AlgebraicClosure K) X) hInt_X d ℓ hℓ_k_char
