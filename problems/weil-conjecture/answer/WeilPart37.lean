      have hab : CategoryTheory.Abelian.Ext.comp a b (Nat.add_sub_of_le hi_le) = 0 := by
        rw [← ha_loc,
          CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero a_loc
            (CategoryTheory.Abelian.Ext.mk₀
              (weilCupPDLocalCounit (weilGeomScheme K X) (ℓ ^ (r + 1)) U_et))
            b (Nat.add_sub_of_le hi_le),
          hb_counit, CategoryTheory.Abelian.Ext.comp_zero]
