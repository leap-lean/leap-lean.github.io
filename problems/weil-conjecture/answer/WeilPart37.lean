    let Φ₂_E := (Algebra.TensorProduct.map (AlgHom.id F₀ E) ψ₀_alg).toRingHom
    have hPush_Φ₂ := hTensorMapPushout ψ₀_alg
    have hPb_Φ₂ := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_Φ₂
    have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀_alg.toRingHom)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ₀_et
    have hEt_spec_Φ₂ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Etale) hPb_Φ₂ inferInstance
    have hΦ₂_et :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_spec_Φ₂
    let J_E : Ideal (MvPolynomial (Fin (m₀ + 1) × Fin 2) E) :=
      Ideal.span {∑ j : Fin (m₀ + 1),
        (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m₀ + 1) × Fin 2) E) * MvPolynomial.X (j, 1)}
    obtain ⟨τ_FE, _, hPush_FE⟩ := hConePushout (algebraMap F₀ E)
    have hPush_tens_CE :=
      CommRingCat.isPushout_tensorProduct F₀ E (MvPolynomial (Fin (m₀ + 1) × Fin 2) F₀ ⧸ J_F)
    let iso_CE := hPush_FE.flip.isoPushout ≪≫ hPush_tens_CE.isoPushout.symm
    have hIso_et : iso_CE.hom.hom.Etale := by
      have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map iso_CE.hom) :=
        ⟨⟨AlgebraicGeometry.Spec.map iso_CE.inv,
          by rw [← AlgebraicGeometry.Spec.map_comp, iso_CE.inv_hom_id, AlgebraicGeometry.Spec.map_id],
          by rw [← AlgebraicGeometry.Spec.map_comp, iso_CE.hom_inv_id, AlgebraicGeometry.Spec.map_id]⟩⟩
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom iso_CE.hom.hom)) :=
        inferInstance
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp this
    let C_E := MvPolynomial (Fin (m₀ + 1) × Fin 2) E ⧸ J_E
    let ψ_CE : C_E →+* TensorProduct F₀ E B' := Φ₂_E.comp iso_CE.hom.hom
    have hψ_CE_et : ψ_CE.Etale := hEtComp hIso_et hΦ₂_et
    have hTwoField : ∃ (K₁ K₂ : Type u) (_ : Field K₁) (_ : Field K₂)
        (β₁ : C_E →+* K₁) (β₂ : C_E →+* K₂),
        Function.Injective (RingHom.prod β₁ β₂) := by
      rcases Nat.eq_zero_or_pos m₀ with rfl | hm_pos
      · let α_tilde_0 : MvPolynomial (Fin 1 × Fin 2) E →+* Polynomial E :=
          MvPolynomial.eval₂Hom Polynomial.C (fun idx => if idx.2 = 0 then Polynomial.X else 0)
        let α_tilde_1 : MvPolynomial (Fin 1 × Fin 2) E →+* Polynomial E :=
          MvPolynomial.eval₂Hom Polynomial.C (fun idx => if idx.2 = 1 then Polynomial.X else 0)
        have hker0 : ∀ a ∈ J_E, α_tilde_0 a = 0 := by
          intro a ha
          change a ∈ RingHom.ker α_tilde_0
          refine Ideal.span_le.mpr ?_ ha
          rintro _ ⟨rfl⟩
          simp [α_tilde_0]
        have hker1 : ∀ a ∈ J_E, α_tilde_1 a = 0 := by
          intro a ha
          change a ∈ RingHom.ker α_tilde_1
          refine Ideal.span_le.mpr ?_ ha
          rintro _ ⟨rfl⟩
          simp [α_tilde_1]
        let α₀ : C_E →+* Polynomial E := Ideal.Quotient.lift J_E α_tilde_0 hker0
        let α₁ : C_E →+* Polynomial E := Ideal.Quotient.lift J_E α_tilde_1 hker1
        let ι_K : Polynomial E →+* FractionRing (Polynomial E) :=
          algebraMap (Polynomial E) (FractionRing (Polynomial E))
        have hι_inj : Function.Injective ι_K :=
          IsFractionRing.injective (Polynomial E) (FractionRing (Polynomial E))
        refine ⟨FractionRing (Polynomial E), FractionRing (Polynomial E), inferInstance, inferInstance,
          ι_K.comp α₀, ι_K.comp α₁, ?_⟩
        rw [injective_iff_map_eq_zero]
        intro q hq
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q
        have hP0 : α_tilde_0 P = 0 := by
          apply hι_inj
          rw [map_zero]
          exact congrArg Prod.fst hq
        have hP1 : α_tilde_1 P = 0 := by
          apply hι_inj
          rw [map_zero]
          exact congrArg Prod.snd hq
        rw [Ideal.Quotient.eq_zero_iff_mem]
        have hMon0 : ∀ (d : (Fin 1 × Fin 2) →₀ ℕ) (c : E),
            α_tilde_0 (MvPolynomial.monomial d c) =
              if d (0, 1) = 0 then Polynomial.monomial (d (0, 0)) c else 0 := by
          intro d c
          change MvPolynomial.eval₂ Polynomial.C (fun idx => if idx.2 = 0 then Polynomial.X else 0)
              (MvPolynomial.monomial d c) = _
          rw [MvPolynomial.eval₂_monomial,
            Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
            Fintype.prod_prod_type, Fin.prod_univ_one, Fin.prod_univ_two]
          simp only [Fin.isValue, ↓reduceIte, show ((1 : Fin 2) = 0) = False by decide]
          by_cases hd : d (0, 1) = 0
          · simp [hd, Polynomial.C_mul_X_pow_eq_monomial]
          · simp [hd, zero_pow hd]
        have hMon1 : ∀ (d : (Fin 1 × Fin 2) →₀ ℕ) (c : E),
            α_tilde_1 (MvPolynomial.monomial d c) =
              if d (0, 0) = 0 then Polynomial.monomial (d (0, 1)) c else 0 := by
          intro d c
          change MvPolynomial.eval₂ Polynomial.C (fun idx => if idx.2 = 1 then Polynomial.X else 0)
              (MvPolynomial.monomial d c) = _
          rw [MvPolynomial.eval₂_monomial,
            Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
            Fintype.prod_prod_type, Fin.prod_univ_one, Fin.prod_univ_two]
          simp only [Fin.isValue, ↓reduceIte, show ((0 : Fin 2) = 1) = False by decide]
          by_cases hd : d (0, 0) = 0
          · simp [hd, Polynomial.C_mul_X_pow_eq_monomial]
          · simp [hd, zero_pow hd]
        have hFin1Eq0 : ∀ i : Fin (0 + 1), i = 0 := fun i => Fin.ext (Nat.lt_one_iff.mp i.2)
        have hPure0 : ∀ d₀ ∈ P.support, d₀ (0, 1) ≠ 0 := by
          intro d₀ hd₀ h01
