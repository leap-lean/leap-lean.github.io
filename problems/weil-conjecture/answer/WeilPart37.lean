          rw [Fin.sum_univ_one, MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul_monomial,
            MvPolynomial.monomial_mul_monomial, one_mul, one_mul, ← hd_eq]
        rw [hmon_eq]
        exact J_E.mul_mem_right _ (Ideal.subset_span rfl)
      · let S_rem := {idx : Fin (m₀ + 1) × Fin 2 // idx ≠ (0, 1)}
        let e_var : Fin (m₀ + 1) × Fin 2 ≃ Option S_rem :=
          { toFun := fun idx => if h : idx = (0, 1) then none else some ⟨idx, h⟩
            invFun := fun o => o.elim (0, 1) Subtype.val
            left_inv := fun idx => by by_cases h : idx = (0, 1) <;> simp [h]
