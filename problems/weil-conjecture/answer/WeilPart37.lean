  let inv_ψ₀ : weilEtaleTorsionH S₁ ℓ 0 → weilEtaleTorsionH S₂ ℓ 0 :=
    fun y =>
      e₂.symm ((adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj AM)) (πℤ ≫ e₁ y) ≫ CategoryTheory.inv η_M)
  refine Function.bijective_iff_has_inverse.mpr ⟨inv_ψ₀, fun x => ?_, fun y => ?_⟩
  · dsimp [inv_ψ₀]
    rw [he₁_ψ x, ← CategoryTheory.Category.assoc πℤ, hι₂, CategoryTheory.Category.id_comp,
      (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj AM)).apply_symm_apply,
      CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
      CategoryTheory.Category.comp_id, e₂.symm_apply_apply]
  · apply e₁.injective
    rw [he₁_ψ (inv_ψ₀ y)]
    dsimp [inv_ψ₀]
    rw [e₂.apply_symm_apply, CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
      CategoryTheory.Category.comp_id,
      (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj AM)).symm_apply_apply,
      ← CategoryTheory.Category.assoc ιℤ, hι₁, CategoryTheory.Category.id_comp]

theorem weil_odp_val_acyc_filtered_colimit_torsionH (ℓ q : ℕ) [Fact (Nat.Prime ℓ)]
    (𝒥 : Type u) [CategoryTheory.SmallCategory 𝒥] [CategoryTheory.IsFiltered 𝒥]
    (E : 𝒥 ⥤ CommRingCat.{u})
    (c_E : CategoryTheory.Limits.Cocone E) (hc_E : CategoryTheory.Limits.IsColimit c_E)
    (X : AlgebraicGeometry.Scheme.{u})
    (e_X : AlgebraicGeometry.Spec c_E.pt ≅ X) :
    (∀ (ξ : weilEtaleTorsionH X ℓ q),
      ∃ (j : 𝒥) (ξ_j : weilEtaleTorsionH (AlgebraicGeometry.Spec (E.obj j)) ℓ q),
        ∀ (p_j : weilEtaleTorsionH (AlgebraicGeometry.Spec (E.obj j)) ℓ q →+
            weilEtaleTorsionH X ℓ q),
          WeilIsTorsionEtalePullback
            (e_X.inv ≫ AlgebraicGeometry.Spec.map (c_E.ι.app j)) ℓ q p_j →
          p_j ξ_j = ξ) ∧
    (∀ (j : 𝒥)
        (ξ_j : weilEtaleTorsionH (AlgebraicGeometry.Spec (E.obj j)) ℓ q)
        (p_j : weilEtaleTorsionH (AlgebraicGeometry.Spec (E.obj j)) ℓ q →+
          weilEtaleTorsionH X ℓ q),
      WeilIsTorsionEtalePullback
        (e_X.inv ≫ AlgebraicGeometry.Spec.map (c_E.ι.app j)) ℓ q p_j →
      p_j ξ_j = 0 →
      ∃ (j' : 𝒥) (θ : j ⟶ j'),
        ∀ (p_θ : weilEtaleTorsionH (AlgebraicGeometry.Spec (E.obj j)) ℓ q →+
            weilEtaleTorsionH (AlgebraicGeometry.Spec (E.obj j')) ℓ q),
          WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map (E.map θ)) ℓ q p_θ →
          p_θ ξ_j = 0) :=
by
  
  obtain ⟨hc_all, hr_all, hSite⟩ :=
    weil_etale_site_pullback_rightAdjoint_and_exact_package.{u}
  have hEtDesc : WeilFilteredColimitEtaleDescentHolds.{u} :=
    weil_filtered_colimit_etale_presentation_and_cover_descent.{u}
  have hAff0 : WeilAffineFilteredRingColimitAtDegreeHolds.{u} (@hc_all) (@hr_all) 0 :=
    weil_affine_filtered_ring_colimit_degree_zero (@hc_all) (@hr_all) hSite hEtDesc
  have hAff_q : WeilAffineFilteredRingColimitAtDegreeHolds.{u} (@hc_all) (@hr_all) q :=
    weil_affine_filtered_ring_colimit_all_degrees_of_deg_zero (@hc_all) (@hr_all) hSite hEtDesc hAff0 q
  obtain ⟨hPullEx, hPullId, hPullComp, -, -⟩ :=
    weil_etale_torsion_pullback_functoriality.{u}

  haveI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  haveI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all

  
  
  
  
  
  have hShfEq : ∀ {C₁ C₂ : Type (u + 1)}
      [CategoryTheory.Category.{u, u + 1} C₁]
      [CategoryTheory.Category.{u, u + 1} C₂]
      (J₁ : CategoryTheory.GrothendieckTopology C₁)
      (J₂ : CategoryTheory.GrothendieckTopology C₂)
      [CategoryTheory.HasWeakSheafify J₁ AddCommGrpCat.{u}]
      [CategoryTheory.HasWeakSheafify J₂ AddCommGrpCat.{u}]
      (B_h : CategoryTheory.Functor C₂ C₁)
      [B_h.IsContinuous J₂ J₁]
      [(B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁).IsRightAdjoint]
      (T₁ : C₁) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (T₂ : C₂) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (A : AddCommGrpCat.{u}),
      let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
      let P₁ := (CategoryTheory.Functor.const (Opposite C₁)).obj A
      let P₂ := (CategoryTheory.Functor.const (Opposite C₂)).obj A
      let F₁ := (CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj A
      let F₂ := (CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}).obj A
      let adj_c₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj_c₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let τ : B_h.obj T₂ ⟶ T₁ := hT₁.from (B_h.obj T₂)
      (adj_h.homEquiv F₂ F₁).symm
        ((adj_c₂.homEquiv A (pf_h.obj F₁)).symm
          (adj_c₁.unit.app A ≫ F₁.obj.map (Opposite.op τ))) =
      (adj_h.homEquiv F₂ F₁).symm
        (((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv
          P₂ (pf_h.obj F₁)).symm
          (CategoryTheory.Functor.whiskerLeft B_h.op
            ((CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}).unit.app P₁))) := by
    intro C₁ C₂ _ _ J₁ J₂ _ _ B_h _ _ T₁ hT₁ T₂ hT₂ A
    dsimp only
    congr 1
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let P₁ := (CategoryTheory.Functor.const (Opposite C₁)).obj A
    let P₂ := (CategoryTheory.Functor.const (Opposite C₂)).obj A
    let F₁ := (CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj A
    let adj_c₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj_c₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let η_sh₁ := (CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}).unit.app P₁
    let η_sh₂ := (CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).unit.app P₂
    let τ : B_h.obj T₂ ⟶ T₁ := hT₁.from (B_h.obj T₂)
    have hUnit₁ : adj_c₁.unit.app A = η_sh₁.app (Opposite.op T₁) :=
      (CategoryTheory.Adjunction.comp_unit_app
        (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT₁)
        (CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}) A).trans
        ((CategoryTheory.eq_whisker
          (CategoryTheory.constantPresheafAdj_unit_app AddCommGrpCat.{u} hT₁ A)
          (η_sh₁.app (Opposite.op T₁))).trans
          (CategoryTheory.Category.id_comp _))
    have hUnit₂ : adj_c₂.unit.app A = η_sh₂.app (Opposite.op T₂) :=
      (CategoryTheory.Adjunction.comp_unit_app
        (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT₂)
        (CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}) A).trans
        ((CategoryTheory.eq_whisker
          (CategoryTheory.constantPresheafAdj_unit_app AddCommGrpCat.{u} hT₂ A)
          (η_sh₂.app (Opposite.op T₂))).trans
          (CategoryTheory.Category.id_comp _))
    let η₁ := CategoryTheory.Functor.whiskerLeft B_h.op η_sh₁
    let u_sh := ((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv
      P₂ (pf_h.obj F₁)).symm η₁
    apply (adj_c₂.homEquiv A (pf_h.obj F₁)).injective
    have hL : (adj_c₂.homEquiv A (pf_h.obj F₁))
        ((adj_c₂.homEquiv A (pf_h.obj F₁)).symm
          (adj_c₁.unit.app A ≫ F₁.obj.map (Opposite.op τ))) =
        η_sh₁.app (Opposite.op (B_h.obj T₂)) := by
      rw [(adj_c₂.homEquiv A (pf_h.obj F₁)).apply_symm_apply, hUnit₁]
      exact (η_sh₁.naturality (Opposite.op τ)).symm.trans (CategoryTheory.Category.id_comp _)
    have hR : (adj_c₂.homEquiv A (pf_h.obj F₁)) u_sh =
        η_sh₁.app (Opposite.op (B_h.obj T₂)) := by
      have h2 : (adj_c₂.homEquiv A (pf_h.obj F₁)) u_sh =
          adj_c₂.unit.app A ≫ u_sh.hom.app (Opposite.op T₂) :=
        CategoryTheory.Adjunction.homEquiv_unit adj_c₂ A (pf_h.obj F₁) u_sh
      have h3 : η_sh₂.app (Opposite.op T₂) ≫ u_sh.hom.app (Opposite.op T₂) =
          η₁.app (Opposite.op T₂) :=
        congrArg (fun γ => γ.app (Opposite.op T₂))
          ((CategoryTheory.Adjunction.homEquiv_unit
            (CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u})
            P₂ (pf_h.obj F₁) u_sh).symm.trans
            (((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv
              P₂ (pf_h.obj F₁)).apply_symm_apply η₁))
      exact h2.trans ((CategoryTheory.eq_whisker hUnit₂ _).trans h3)
    exact hL.trans hR.symm

  have hTermPb : ∀ {Y Z₀ : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom Y Z₀),
      CategoryTheory.Limits.IsTerminal
        ((weilEtaleSitePullback π).obj (weilEtaleIdTerminal.{u} Z₀)) := by
    intro Y Z₀ π
    let T_Z := weilEtaleIdTerminal.{u} Z₀
    let t_hom : Quiver.Hom T_Z.left Z₀ := T_Z.hom
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W =>
        let w_hom : Quiver.Hom W.left Y := W.hom
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift (w_hom ≫ π) w_hom
            (CategoryTheory.Category.comp_id (w_hom ≫ π)))
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial)
      (fun W m => by
        let w_hom : Quiver.Hom W.left Y := W.hom
        let m_left : Quiver.Hom W.left (CategoryTheory.Limits.pullback t_hom π) := m.left
        have hm_snd : m_left ≫ CategoryTheory.Limits.pullback.snd t_hom π = w_hom :=
          CategoryTheory.MorphismProperty.Over.w m
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.comp_id
              (m_left ≫ CategoryTheory.Limits.pullback.fst t_hom π)).symm.trans
            ((CategoryTheory.Category.assoc m_left
              (CategoryTheory.Limits.pullback.fst t_hom π) t_hom).trans
              (((congrArg (m_left ≫ ·)
                  (CategoryTheory.Limits.pullback.condition (f := t_hom) (g := π))).trans
                ((CategoryTheory.Category.assoc m_left
                  (CategoryTheory.Limits.pullback.snd t_hom π) π).symm.trans
                  (congrArg (· ≫ π) hm_snd))).trans
                (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm))
        · exact hm_snd.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm)

  have hConstIso : ∀ {Y Z₀ : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom Y Z₀)
      (A : AddCommGrpCat.{u}),
      let B_π := weilEtaleSitePullback π
      let pf_π := B_π.sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₀.smallEtaleTopology Y.smallEtaleTopology
      let pb_π := B_π.sheafPullback AddCommGrpCat.{u}
        Z₀.smallEtaleTopology Y.smallEtaleTopology
      let adj_π := B_π.sheafAdjunctionContinuous AddCommGrpCat.{u}
        Z₀.smallEtaleTopology Y.smallEtaleTopology
      let P_Y := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj A
      let P_Z := (CategoryTheory.Functor.const (Opposite Z₀.Etale)).obj A
      let F_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj A
      let G₀ := (CategoryTheory.constantSheaf Z₀.smallEtaleTopology AddCommGrpCat.{u}).obj A
      let c_π : pb_π.obj G₀ ⟶ F_Y :=
        (adj_π.homEquiv G₀ F_Y).symm
          (((CategoryTheory.sheafificationAdjunction Z₀.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
            P_Z (pf_π.obj F_Y)).symm
            (CategoryTheory.Functor.whiskerLeft B_π.op
              ((CategoryTheory.sheafificationAdjunction Y.smallEtaleTopology AddCommGrpCat.{u}).unit.app P_Y)))
      ∃ ic_π : F_Y ⟶ pb_π.obj G₀,
        c_π ≫ ic_π = CategoryTheory.CategoryStruct.id (pb_π.obj G₀) ∧
        ic_π ≫ c_π = CategoryTheory.CategoryStruct.id F_Y := by
    intro Y Z₀ π A
    dsimp only
    let B_π := weilEtaleSitePullback π
    let J_Y := Y.smallEtaleTopology
    let J_Z := Z₀.smallEtaleTopology
    let C_Y := CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}
    let C_Z := CategoryTheory.constantSheaf J_Z AddCommGrpCat.{u}
    let pf_π := B_π.sheafPushforwardContinuous AddCommGrpCat.{u} J_Z J_Y
    let pb_π := B_π.sheafPullback AddCommGrpCat.{u} J_Z J_Y
    let adj_π := B_π.sheafAdjunctionContinuous AddCommGrpCat.{u} J_Z J_Y
    let T_Y := weilEtaleIdTerminal.{u} Y
    let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
    let T_Z := weilEtaleIdTerminal.{u} Z₀
    let hT_Z := weilEtaleIdTerminalIsTerminal.{u} Z₀
    let hBT_Z := hTermPb π
    let adj_Y := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT_Y
    let adj_Z := CategoryTheory.constantSheafAdj J_Z AddCommGrpCat.{u} hT_Z
    let adj_comp := adj_Z.comp adj_π
    let τ_iso : B_π.obj T_Z ≅ T_Y :=
      { hom := hT_Y.from (B_π.obj T_Z)
        inv := hBT_Z.from T_Y
        hom_inv_id := hBT_Z.hom_ext _ _
        inv_hom_id := hT_Y.hom_ext _ _ }
    let θ_τ : (CategoryTheory.sheafSections J_Y AddCommGrpCat.{u}).obj (Opposite.op T_Y) ≅
        pf_π ⋙ (CategoryTheory.sheafSections J_Z AddCommGrpCat.{u}).obj (Opposite.op T_Z) :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ =>
          { hom := ℱ.obj.map τ_iso.hom.op
            inv := ℱ.obj.map τ_iso.inv.op
            hom_inv_id := by
              change ℱ.obj.map τ_iso.hom.op ≫ ℱ.obj.map τ_iso.inv.op =
                𝟙 (ℱ.obj.obj (Opposite.op T_Y))
              rw [← CategoryTheory.Functor.map_comp, ← op_comp, τ_iso.inv_hom_id, op_id,
                CategoryTheory.Functor.map_id]
            inv_hom_id := by
              change ℱ.obj.map τ_iso.inv.op ≫ ℱ.obj.map τ_iso.hom.op =
                𝟙 (ℱ.obj.obj (Opposite.op (B_π.obj T_Z)))
              rw [← CategoryTheory.Functor.map_comp, ← op_comp, τ_iso.hom_inv_id, op_id,
                CategoryTheory.Functor.map_id] })
        (fun u => (u.hom.naturality τ_iso.hom.op).symm)
    let α_iso : C_Z ⋙ pb_π ≅ C_Y :=
      adj_comp.leftAdjointUniq (adj_Y.ofNatIsoRight θ_τ)
    have hc_eq : (adj_π.homEquiv (C_Z.obj A) (C_Y.obj A)).symm
        (((CategoryTheory.sheafificationAdjunction J_Z AddCommGrpCat.{u}).homEquiv
          ((CategoryTheory.Functor.const (Opposite Z₀.Etale)).obj A)
          (pf_π.obj (C_Y.obj A))).symm
          (CategoryTheory.Functor.whiskerLeft B_π.op
            ((CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}).unit.app
              ((CategoryTheory.Functor.const (Opposite Y.Etale)).obj A)))) =
        α_iso.hom.app A := by
      rw [← hShfEq J_Y J_Z B_π T_Y hT_Y T_Z hT_Z A]
      apply (adj_comp.homEquiv A (C_Y.obj A)).injective
      rw [CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app]
      have hcomp_symm :
          (adj_π.homEquiv (C_Z.obj A) (C_Y.obj A)).symm
            ((adj_Z.homEquiv A (pf_π.obj (C_Y.obj A))).symm
              (adj_Y.unit.app A ≫ (C_Y.obj A).obj.map (Opposite.op (hT_Y.from (B_π.obj T_Z))))) =
          (adj_comp.homEquiv A (C_Y.obj A)).symm
            (adj_Y.unit.app A ≫ (C_Y.obj A).obj.map τ_iso.hom.op) := by
        dsimp only [adj_comp, τ_iso]
        rw [CategoryTheory.Adjunction.comp_homEquiv]
        rfl
      rw [hcomp_symm, Equiv.apply_symm_apply]
      rfl
    refine ⟨α_iso.inv.app A, ?_, ?_⟩
    · rw [hc_eq]
      exact α_iso.hom_inv_id_app A
    · rw [hc_eq]
      exact α_iso.inv_hom_id_app A

  have hPostcompBij : ∀ {D : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} D] [CategoryTheory.Abelian D]
      [CategoryTheory.HasExt.{u} D]
      {X_obj G₁ G₂ : D} (n : ℕ)
      (c : G₁ ⟶ G₂) (ic : G₂ ⟶ G₁),
      c ≫ ic = CategoryTheory.CategoryStruct.id G₁ →
      ic ≫ c = CategoryTheory.CategoryStruct.id G₂ →
      Function.Bijective ((CategoryTheory.Abelian.Ext.mk₀.{u} c).postcomp X_obj (Nat.add_zero n)) := by
    intro D _ _ _ X_obj G₁ G₂ n c ic h_cic h_icc
    refine Function.bijective_iff_has_inverse.mpr
      ⟨(CategoryTheory.Abelian.Ext.mk₀.{u} ic).postcomp X_obj (Nat.add_zero n),
       fun z => ?_, fun y => ?_⟩
    · change (z.comp (CategoryTheory.Abelian.Ext.mk₀.{u} c) (Nat.add_zero n)).comp
        (CategoryTheory.Abelian.Ext.mk₀.{u} ic) (Nat.add_zero n) = z
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        z (CategoryTheory.Abelian.Ext.mk₀.{u} c) (CategoryTheory.Abelian.Ext.mk₀.{u} ic)
        (Nat.add_zero n),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_cic]
      exact CategoryTheory.Abelian.Ext.comp_mk₀_id z
    · change (y.comp (CategoryTheory.Abelian.Ext.mk₀.{u} ic) (Nat.add_zero n)).comp
        (CategoryTheory.Abelian.Ext.mk₀.{u} c) (Nat.add_zero n) = y
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        y (CategoryTheory.Abelian.Ext.mk₀.{u} ic) (CategoryTheory.Abelian.Ext.mk₀.{u} c)
        (Nat.add_zero n),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_icc]
      exact CategoryTheory.Abelian.Ext.comp_mk₀_id y

  have hInvUniq : ∀ {D : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} D]
      {W₁ W₂ : D} {p : W₁ ⟶ W₂} {q₁ q₂ : W₂ ⟶ W₁},
      q₁ ≫ p = CategoryTheory.CategoryStruct.id W₂ →
      p ≫ q₂ = CategoryTheory.CategoryStruct.id W₁ →
