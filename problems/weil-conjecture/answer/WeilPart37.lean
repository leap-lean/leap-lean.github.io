    · rintro z ⟨hzb, hzb'⟩
      have hz_inf : z ∈ (W b ⊓ W b' : P_sch.Opens) := ⟨hzb, hzb'⟩
      obtain ⟨V, hV, hzV, hV_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hz_inf
      have _hNe_V : Nonempty V := ⟨⟨z, hzV⟩⟩
      let T := ↑(P_sch.presheaf.obj (Opposite.op V))
      have _hDom_T : IsDomain T := inferInstance
