      apply RingHom.ext
      intro a
      simp only [CommRingCat.hom_ofHom, RingHom.comp_apply, IsLocalization.Away.lift_eq]
      exact ConcreteCategory.congr_hom hm_W a
  have hLoc_inf : @IsLocalization.Away ↑c_W.pt _ t_inf ↑c_U.pt _ lam_inf.hom.toAlgebra :=
    hAwayOfAlgebraMap t_inf
  have hLoc_stage : ∀ j : 𝒥,
      @IsLocalization.Away ↑(E_diag.obj j) _ (x j) ↑(U_diag.obj j) _
        (lam_diag.app j).hom.toAlgebra :=
    fun j => hAwayOfAlgebraMap (x j)
  have hPush_stage : ∀ j : 𝒥,
      CategoryTheory.IsPushout (c_W.ι.app j) (lam_diag.app j) lam_inf (c_U.ι.app j) := by
    intro j
    let f_W : ↑(E_diag.obj j) →+* ↑c_W.pt := (c_W.ι.app j).hom
    let f_U : Localization.Away (x j) →+* Localization.Away t_inf := (c_U.ι.app j).hom
    have hcomp_j : f_U.comp (algebraMap ↑(E_diag.obj j) (Localization.Away (x j))) =
        (algebraMap ↑c_W.pt (Localization.Away t_inf)).comp f_W := by
      apply RingHom.ext
      intro a
      exact ConcreteCategory.congr_hom (hcomm_cocone j).symm a
    have _ : IsLocalization
        (Submonoid.map f_W (Submonoid.powers (x j)))
        (Localization.Away t_inf) := by
      rw [Submonoid.map_powers, hx_colim j]
      infer_instance
    exact CommRingCat.isPushout_of_isLocalization
      (R := ↑(E_diag.obj j)) (S := ↑c_W.pt)
      (Rₘ := Localization.Away (x j)) (Sₘ := Localization.Away t_inf)
      f_W f_U hcomp_j (Submonoid.powers (x j))

  
  obtain ⟨e_WU, hcomm_inf⟩ :=
    hRelAffineAwayPullback c_R t_bar φ_R_Ω hLoc
      c_W.pt c_U.pt lam_inf W e_W w f_E hfE_fst hfE_snd hLoc_inf

  
  have hPb_Yd : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (MvPolynomial.map (Polynomial.C : k →+* Polynomial k))))
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom
          (MvPolynomial.C : Polynomial k →+* MvPolynomial (Fin d_rel) (Polynomial k))))
      S_d.hom p_A1 :=
    AlgebraicGeometry.isPullback_SpecMap_of_isPushout
      (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin d_rel) k))
      (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
      (CommRingCat.ofHom (MvPolynomial.map (Polynomial.C : k →+* Polynomial k)))
      (CommRingCat.ofHom
        (MvPolynomial.C : Polynomial k →+* MvPolynomial (Fin d_rel) (Polynomial k)))
      (hMvPushout d_rel (Polynomial.C : k →+* Polynomial k))
  let e_Yd : AlgebraicGeometry.Spec
      (CommRingCat.of (MvPolynomial (Fin d_rel) (Polynomial k))) ≅ Y_d :=
    hPb_Yd.isoPullback
  have he_Yd_fst : e_Yd.hom ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (MvPolynomial.map (Polynomial.C : k →+* Polynomial k))) :=
    hPb_Yd.isoPullback_hom_fst
  have he_Yd_snd : e_Yd.hom ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom
          (MvPolynomial.C : Polynomial k →+* MvPolynomial (Fin d_rel) (Polynomial k))) :=
    hPb_Yd.isoPullback_hom_snd
  have hLoc_Gm : @IsLocalization.Away (Polynomial k) _ Polynomial.X
      (Localization.Away (Polynomial.X : Polynomial k)) _
      (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))).toAlgebra :=
    hAwayOfAlgebraMap (Polynomial.X : Polynomial k)
  have mk_stage : ∀ (j₀ : 𝒥) (ϖ₀ : ↑(D.obj j₀.right)) (u₀ : (↑(D.obj j₀.right))ˣ)
      (e₀ : ℕ) (ψ₀ : Polynomial k →+* ↑(D.obj j₀.right)),
      1 ≤ e₀ →
      (α.app j₀.right).hom Polynomial.X = ↑u₀ * ϖ₀ ^ e₀ →
      ψ₀ Polynomial.X = ϖ₀ →
      ψ₀.Etale →
      let f_Y₀ : CommRingCat.of (MvPolynomial (Fin d_rel) (Polynomial k)) ⟶ E_diag.obj j₀ :=
        CommRingCat.ofHom (MvPolynomial.map ψ₀) ≫ p_poly j₀
      ∃ (w₀ : AlgebraicGeometry.Spec (E_diag.obj j₀) ⟶ Y_d)
        (_ : AlgebraicGeometry.Etale w₀)
        (e_Uj₀ : AlgebraicGeometry.Spec (U_diag.obj j₀) ≅ CategoryTheory.Limits.pullback j_d w₀),
        w₀ ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.map (Polynomial.C : k →+* Polynomial k)) ≫ f_Y₀) ∧
        w₀ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom MvPolynomial.C ≫ f_Y₀) ∧
        e_Uj₀.hom ≫ CategoryTheory.Limits.pullback.snd j_d w₀ =
          AlgebraicGeometry.Spec.map (lam_diag.app j₀) ∧
        CategoryTheory.IsPullback
          (e_WU.inv ≫ AlgebraicGeometry.Spec.map (c_U.ι.app j₀) ≫ e_Uj₀.hom)
          (CategoryTheory.Limits.pullback.snd j_A w)
          (CategoryTheory.Limits.pullback.snd j_d w₀)
          (e_W.inv ≫ AlgebraicGeometry.Spec.map (c_W.ι.app j₀)) := by
    intro j₀ ϖ₀ u₀ e₀ ψ₀ he₀ hX₀ hψ₀_X hψ₀_et f_Y₀
    have hPb_ψ : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            (MvPolynomial.C : ↑(D.obj j₀.right) →+* MvPolynomial (Fin d_rel) ↑(D.obj j₀.right))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map ψ₀)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀))
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            (MvPolynomial.C : Polynomial k →+* MvPolynomial (Fin d_rel) (Polynomial k)))) :=
      (AlgebraicGeometry.isPullback_SpecMap_of_isPushout
        (CommRingCat.ofHom
          (MvPolynomial.C : Polynomial k →+* MvPolynomial (Fin d_rel) (Polynomial k)))
        (CommRingCat.ofHom ψ₀)
        (CommRingCat.ofHom (MvPolynomial.map ψ₀))
        (CommRingCat.ofHom
          (MvPolynomial.C : ↑(D.obj j₀.right) →+* MvPolynomial (Fin d_rel) ↑(D.obj j₀.right)))
        (hMvPushout d_rel ψ₀)).flip
    have hEt_spec_ψ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ₀_et
    have hEt_map_ψ : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map ψ₀))) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ψ hEt_spec_ψ
    have hEt_ppoly : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (p_poly j₀)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (hp_et j₀)
    let w₀ : AlgebraicGeometry.Spec (E_diag.obj j₀) ⟶ Y_d :=
      AlgebraicGeometry.Spec.map f_Y₀ ≫ e_Yd.hom
    have hw₀_et : AlgebraicGeometry.Etale w₀ := by
      have hw₀_eq : w₀ =
          AlgebraicGeometry.Spec.map (p_poly j₀) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map ψ₀)) ≫ e_Yd.hom := by
        dsimp only [w₀, f_Y₀]
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc]
      rw [hw₀_eq]
      infer_instance
    have hw₀_fst : w₀ ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.map (Polynomial.C : k →+* Polynomial k)) ≫ f_Y₀) := by
      dsimp only [w₀]
      rw [Category.assoc, he_Yd_fst, hSpecMapComp_Sd]
    have hw₀_snd : w₀ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C ≫ f_Y₀) := by
      dsimp only [w₀]
      rw [Category.assoc, he_Yd_snd, ← AlgebraicGeometry.Spec.map_comp]
    let u_E₀ : (↑(E_diag.obj j₀))ˣ :=
      Units.map ((p_poly j₀).hom.comp MvPolynomial.C).toMonoidHom u₀
    have hfY_X : f_Y₀.hom (MvPolynomial.C Polynomial.X) =
        (p_poly j₀).hom (MvPolynomial.C ϖ₀) := by
      dsimp only [f_Y₀]
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
        MvPolynomial.map_C, hψ₀_X]
    have hx_fac : x j₀ = ↑u_E₀ * (f_Y₀.hom (MvPolynomial.C Polynomial.X)) ^ e₀ := by
      dsimp only [x, u_E₀]
      rw [hfY_X, hX₀, map_mul, map_mul, map_pow, map_pow]
      rfl
    have hLoc_x₀ : @IsLocalization.Away ↑(E_diag.obj j₀) _
        (↑u_E₀ * (f_Y₀.hom (MvPolynomial.C Polynomial.X)) ^ e₀)
        ↑(U_diag.obj j₀) _ (lam_diag.app j₀).hom.toAlgebra := by
      rw [← hx_fac]
      exact hLoc_stage j₀
    have hLoc_fY : @IsLocalization.Away ↑(E_diag.obj j₀) _
        (f_Y₀.hom (MvPolynomial.C Polynomial.X))
        ↑(U_diag.obj j₀) _ (lam_diag.app j₀).hom.toAlgebra :=
      hAwayUnitPow (f_Y₀.hom (MvPolynomial.C Polynomial.X)) u_E₀ e₀ he₀
        (lam_diag.app j₀).hom hLoc_x₀
    obtain ⟨e_Uj₀, he_Uj₀_snd₀⟩ :=
      hRelAffineAwayPullback (Polynomial.C : k →+* Polynomial k) Polynomial.X
        (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))) hLoc_Gm
        (E_diag.obj j₀) (U_diag.obj j₀) (lam_diag.app j₀)
        (AlgebraicGeometry.Spec (E_diag.obj j₀)) (Iso.refl _) w₀ f_Y₀
        (by rw [Iso.refl_hom, Category.id_comp]; exact hw₀_fst)
        (by rw [Iso.refl_hom, Category.id_comp]; exact hw₀_snd)
        hLoc_fY
    have he_Uj₀_snd : e_Uj₀.hom ≫ CategoryTheory.Limits.pullback.snd j_d w₀ =
        AlgebraicGeometry.Spec.map (lam_diag.app j₀) := by
      rw [Iso.refl_hom, Category.comp_id] at he_Uj₀_snd₀
      exact he_Uj₀_snd₀
    have hPb_spec₀ : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (c_U.ι.app j₀))
        (AlgebraicGeometry.Spec.map lam_inf)
        (AlgebraicGeometry.Spec.map (lam_diag.app j₀))
        (AlgebraicGeometry.Spec.map (c_W.ι.app j₀)) :=
      (AlgebraicGeometry.isPullback_SpecMap_of_isPushout
        (c_W.ι.app j₀) (lam_diag.app j₀) lam_inf (c_U.ι.app j₀) (hPush_stage j₀)).flip
    have hPb_sq₀ : CategoryTheory.IsPullback
        (e_WU.inv ≫ AlgebraicGeometry.Spec.map (c_U.ι.app j₀) ≫ e_Uj₀.hom)
        (CategoryTheory.Limits.pullback.snd j_A w)
        (CategoryTheory.Limits.pullback.snd j_d w₀)
        (e_W.inv ≫ AlgebraicGeometry.Spec.map (c_W.ι.app j₀)) :=
      CategoryTheory.IsPullback.of_iso hPb_spec₀
        e_WU e_Uj₀ e_W (Iso.refl _)
        (by rw [e_WU.hom_inv_id_assoc])
        hcomm_inf.symm
        (by rw [Iso.refl_hom, Category.comp_id, he_Uj₀_snd])
        (by rw [Iso.refl_hom, Category.comp_id, e_W.hom_inv_id_assoc])
    exact ⟨w₀, hw₀_et, e_Uj₀, hw₀_fst, hw₀_snd, he_Uj₀_snd, hPb_sq₀⟩

  
  refine ⟨𝒥, inferInstance, inferInstance, E_diag, U_diag, lam_diag, c_W, hc_W, c_U, hc_U,
    lam_inf, e_W, e_WU, ⟨hcomm_inf, hcomm_cocone⟩, fun j => ?_⟩
  obtain ⟨ϖ, u, e, ψ_i, he, _, hX_eq, hψ_C, hψ_X, hψ_et,
    i₁, θ₀, β, ψ₁, hβ_pow, hψ₁_C, hψ₁_X, hψ₁_et⟩ := hStage j.right
  obtain ⟨w_j, hw_j, e_Uj, hwj_fst, hwj_snd, he_Uj_snd, hPb_j⟩ :=
    mk_stage j ϖ u e ψ_i he hX_eq hψ_X hψ_et
  let j₁ : 𝒥 := CategoryTheory.Under.mk (j.hom ≫ θ₀)
  let θ : j ⟶ j₁ := CategoryTheory.Under.homMk θ₀ (CategoryTheory.Under.mk_hom _).symm
  let u₁ : (↑(D.obj i₁))ˣ := Units.map (D.map θ₀).hom.toMonoidHom u
  have he₁ : 1 ≤ ℓ * e := Nat.mul_pos (Fact.out : Nat.Prime ℓ).pos he
  have hα_θ₀ : α.app j.right ≫ D.map θ₀ = α.app i₁ := by
    have hn := α.naturality θ₀
    dsimp only [Functor.const_obj_obj, Functor.const_obj_map] at hn
    rw [Category.id_comp] at hn
    exact hn.symm
  have hX₁_eq : (α.app i₁).hom Polynomial.X = ↑u₁ * β ^ (ℓ * e) := by
    have h1 := ConcreteCategory.congr_hom hα_θ₀ Polynomial.X
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1
    rw [← h1, hX_eq, map_mul, map_pow, hβ_pow, ← pow_mul]
    rfl
  obtain ⟨w₁, hw₁, e_Uj₁, hw₁_fst, hw₁_snd, he_Uj₁_snd, hPb_j₁⟩ :=
    mk_stage j₁ β u₁ (ℓ * e) ψ₁ he₁ hX₁_eq hψ₁_X hψ₁_et
  have hψ₁_C_comp : ψ₁.comp Polynomial.C = (D.map θ₀).hom.comp (ψ_i.comp Polynomial.C) := by
    rw [hψ₁_C, hψ_C]
    ext a
    simp only [RingHom.comp_apply]
    have h1 := ConcreteCategory.congr_hom hα_θ₀ (Polynomial.C a)
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using h1.symm
  have hKummer_fst :
      AlgebraicGeometry.Spec.map (E_diag.map θ) ≫ w_j ≫
          CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
        w₁ ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 := by
    have hp_θ : D_poly.map θ₀ ≫ p_poly j₁ = p_poly j ≫ E_diag.map θ := hp_nat θ
    have h_hom_eq :
        (CommRingCat.ofHom (MvPolynomial.map (Polynomial.C : k →+* Polynomial k)) ≫
          CommRingCat.ofHom (MvPolynomial.map ψ_i) ≫ p_poly j) ≫ E_diag.map θ =
        CommRingCat.ofHom (MvPolynomial.map (Polynomial.C : k →+* Polynomial k)) ≫
          CommRingCat.ofHom (MvPolynomial.map ψ₁) ≫ p_poly j₁ := by
      calc (CommRingCat.ofHom (MvPolynomial.map (Polynomial.C : k →+* Polynomial k)) ≫
              CommRingCat.ofHom (MvPolynomial.map ψ_i) ≫ p_poly j) ≫ E_diag.map θ
          = CommRingCat.ofHom (MvPolynomial.map (Polynomial.C : k →+* Polynomial k)) ≫
              CommRingCat.ofHom (MvPolynomial.map ψ_i) ≫ (p_poly j ≫ E_diag.map θ) := by
              simp only [Category.assoc]
        _ = (CommRingCat.ofHom (MvPolynomial.map (Polynomial.C : k →+* Polynomial k)) ≫
              CommRingCat.ofHom (MvPolynomial.map ψ_i) ≫ D_poly.map θ₀) ≫ p_poly j₁ := by
              rw [← hp_θ]
              simp only [Category.assoc]
        _ = (CommRingCat.ofHom (MvPolynomial.map (Polynomial.C : k →+* Polynomial k)) ≫
              CommRingCat.ofHom (MvPolynomial.map ψ₁)) ≫ p_poly j₁ := by
              congr 1
              apply CommRingCat.hom_ext
              apply RingHom.ext
              intro p
              simp only [D_poly, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
                MvPolynomial.map_map, ← hψ₁_C_comp]
        _ = CommRingCat.ofHom (MvPolynomial.map (Polynomial.C : k →+* Polynomial k)) ≫
              CommRingCat.ofHom (MvPolynomial.map ψ₁) ≫ p_poly j₁ := by
              simp only [Category.assoc]
    rw [hwj_fst, hSpecMapComp_Sd, h_hom_eq, ← hw₁_fst]
  have hKummer_snd :
      AlgebraicGeometry.Spec.map (E_diag.map θ) ≫ w_j ≫
          CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
        w₁ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 ≫ κ_A1 := by
    have hp_θ : D_poly.map θ₀ ≫ p_poly j₁ = p_poly j ≫ E_diag.map θ := hp_nat θ
    have hpoly_kum : (D.map θ₀).hom.comp ψ_i =
        ψ₁.comp ((Polynomial.aeval ((Polynomial.X : Polynomial k) ^ ℓ)).toRingHom) := by
      apply Polynomial.ringHom_ext'
      · ext a
        change (D.map θ₀).hom (ψ_i (Polynomial.C a)) =
          ψ₁ ((Polynomial.aeval ((Polynomial.X : Polynomial k) ^ ℓ)) (Polynomial.C a))
        rw [Polynomial.aeval_C]
        exact (RingHom.congr_fun hψ₁_C_comp a).symm
      · change (D.map θ₀).hom (ψ_i Polynomial.X) =
          ψ₁ ((Polynomial.aeval ((Polynomial.X : Polynomial k) ^ ℓ)) Polynomial.X)
        rw [hψ_X, hβ_pow, Polynomial.aeval_X, map_pow, hψ₁_X]
    have h_hom_eq :
        (CommRingCat.ofHom MvPolynomial.C ≫
          CommRingCat.ofHom (MvPolynomial.map ψ_i) ≫ p_poly j) ≫ E_diag.map θ =
        CommRingCat.ofHom ((Polynomial.aeval ((Polynomial.X : Polynomial k) ^ ℓ)).toRingHom) ≫
          CommRingCat.ofHom MvPolynomial.C ≫
          CommRingCat.ofHom (MvPolynomial.map ψ₁) ≫ p_poly j₁ := by
      have hleft :
          CommRingCat.ofHom
              (MvPolynomial.C : Polynomial k →+* MvPolynomial (Fin d_rel) (Polynomial k)) ≫
            CommRingCat.ofHom (MvPolynomial.map ψ_i) ≫ D_poly.map θ₀ =
          CommRingCat.ofHom
              ((Polynomial.aeval ((Polynomial.X : Polynomial k) ^ ℓ)).toRingHom) ≫
            CommRingCat.ofHom MvPolynomial.C ≫
            CommRingCat.ofHom (MvPolynomial.map ψ₁) := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro f_pol
        simp only [D_poly, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          MvPolynomial.map_C]
        exact congrArg MvPolynomial.C (RingHom.congr_fun hpoly_kum f_pol)
      calc (CommRingCat.ofHom MvPolynomial.C ≫
              CommRingCat.ofHom (MvPolynomial.map ψ_i) ≫ p_poly j) ≫ E_diag.map θ
          = (CommRingCat.ofHom MvPolynomial.C ≫
              CommRingCat.ofHom (MvPolynomial.map ψ_i) ≫ D_poly.map θ₀) ≫ p_poly j₁ := by
              rw [Category.assoc, Category.assoc, ← hp_θ]
              simp only [Category.assoc]
        _ = CommRingCat.ofHom ((Polynomial.aeval ((Polynomial.X : Polynomial k) ^ ℓ)).toRingHom) ≫
              CommRingCat.ofHom MvPolynomial.C ≫
              CommRingCat.ofHom (MvPolynomial.map ψ₁) ≫ p_poly j₁ := by
              rw [hleft]
              simp only [Category.assoc]
    calc AlgebraicGeometry.Spec.map (E_diag.map θ) ≫ w_j ≫
            CategoryTheory.Limits.pullback.snd S_d.hom p_A1
        = AlgebraicGeometry.Spec.map (E_diag.map θ) ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom MvPolynomial.C ≫
                CommRingCat.ofHom (MvPolynomial.map ψ_i) ≫ p_poly j) := by
            rw [hwj_snd]
      _ = AlgebraicGeometry.Spec.map
            ((CommRingCat.ofHom MvPolynomial.C ≫
              CommRingCat.ofHom (MvPolynomial.map ψ_i) ≫ p_poly j) ≫ E_diag.map θ) :=
            (AlgebraicGeometry.Spec.map_comp _ _).symm
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Polynomial.aeval ((Polynomial.X : Polynomial k) ^ ℓ)).toRingHom) ≫
              CommRingCat.ofHom MvPolynomial.C ≫
              CommRingCat.ofHom (MvPolynomial.map ψ₁) ≫ p_poly j₁) := by
            rw [h_hom_eq]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom MvPolynomial.C ≫
              CommRingCat.ofHom (MvPolynomial.map ψ₁) ≫ p_poly j₁) ≫ κ_A1 :=
            AlgebraicGeometry.Spec.map_comp _ _
      _ = (w₁ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1) ≫ κ_A1 := by
            rw [hw₁_snd]
      _ = w₁ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 ≫ κ_A1 :=
            Category.assoc _ _ _
  exact ⟨w_j, hw_j, e_Uj, he_Uj_snd, hPb_j,
    j₁, θ, w₁, hw₁, e_Uj₁, he_Uj₁_snd, hPb_j₁, hKummer_fst, hKummer_snd⟩

theorem weil_odp_val_acyc_stage_deg0_pullback_bijective (k : Type u) [Field k] [IsAlgClosed k]
    (d_rel ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPur0 :
      let S_d := weilAffineSpaceOver k d_rel
      let A1_k := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
      let Gm_k := AlgebraicGeometry.Spec
        (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial k)))
      let j_Gm : Gm_k ⟶ A1_k := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (Polynomial k)
          (Localization.Away (Polynomial.X : Polynomial k))))
      let p_A1 : A1_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
      let Y_d := CategoryTheory.Limits.pullback S_d.hom p_A1
      let U_d := CategoryTheory.Limits.pullback j_Gm
        (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
      let j_d : U_d ⟶ Y_d :=
        CategoryTheory.Limits.pullback.snd j_Gm
          (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Y_d) [AlgebraicGeometry.Etale w],
        ConnectedSpace ↥W → Nonempty ↥W →
        ConnectedSpace ↥(CategoryTheory.Limits.pullback j_d w) ∧
        Nonempty ↥(CategoryTheory.Limits.pullback j_d w)) :
    let S_d := weilAffineSpaceOver k d_rel
    let A1_k := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
    let Gm_k := AlgebraicGeometry.Spec
      (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial k)))
    let j_Gm : Gm_k ⟶ A1_k := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (Polynomial k)
        (Localization.Away (Polynomial.X : Polynomial k))))
    let p_A1 : A1_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
    let Y_d := CategoryTheory.Limits.pullback S_d.hom p_A1
    let j_d := CategoryTheory.Limits.pullback.snd j_Gm
      (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
    ∀ (W₀ : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W₀]
      (w₀ : W₀ ⟶ Y_d) [AlgebraicGeometry.Etale w₀]
      (ψ₀ : weilEtaleTorsionH W₀ ℓ 0 →+
        weilEtaleTorsionH (CategoryTheory.Limits.pullback j_d w₀) ℓ 0),
      WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j_d w₀) ℓ 0 ψ₀ →
      Function.Bijective ψ₀ :=
by
  classical
  intro S_d A1_k Gm_k j_Gm p_A1 Y_d j_d W₀ hAff_W₀ w₀ hEt_w₀ ψ₀ hψ₀
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  
  have h_mem_etale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have heq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S (le_refl (@AlgebraicGeometry.Etale :
          CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  have h_mor_etale : ∀ {S : AlgebraicGeometry.Scheme.{u}} {Y₁ Y₂ : S.Etale} (u : Y₁ ⟶ Y₂),
      AlgebraicGeometry.Etale u.left := by
    intro S Y₁ Y₂ u
    have hw : u.left ≫ Y₂.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w u
    have hcomp : AlgebraicGeometry.Etale (u.left ≫ Y₂.hom) := hw.symm ▸ Y₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      u.left Y₂.hom Y₂.prop hcomp

  
  have h_noeth_clopen : ∀ {X : Type u} [TopologicalSpace X]
      [TopologicalSpace.NoetherianSpace X] (p₀ : X),
      IsClopen (connectedComponent p₀) := by
    intro X _ _ p₀
    refine ⟨isClosed_connectedComponent, ?_⟩
    rw [← isClosed_compl_iff]
    let S : Set (Set X) := {I ∈ irreducibleComponents X | Disjoint I (connectedComponent p₀)}
    have hFin : S.Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.subset (fun _ h => h.1)
    have hEq : (⋃ I ∈ S, I) = (connectedComponent p₀)ᶜ := by
      ext z
      simp only [Set.mem_iUnion, Set.mem_compl_iff]
      constructor
      · rintro ⟨I, ⟨_, hDisj⟩, hzI⟩ hzC
        exact Set.disjoint_left.mp hDisj hzI hzC
      · intro hz_not
        refine ⟨irreducibleComponent z,
          ⟨irreducibleComponent_mem_irreducibleComponents z, ?_⟩,
          mem_irreducibleComponent⟩
        rw [Set.disjoint_left]
        intro w hwI hwC
        have hPre : _root_.IsPreconnected (irreducibleComponent z) :=
          IsPreirreducible.isPreconnected isIrreducible_irreducibleComponent.2
        have hsub : irreducibleComponent z ⊆ connectedComponent w :=
          _root_.IsPreconnected.subset_connectedComponent hPre hwI
        rw [← connectedComponent_eq hwC] at hsub
        exact hz_not (hsub mem_irreducibleComponent)
    rw [← hEq]
    exact hFin.isClosed_biUnion (fun I hI => isClosed_of_mem_irreducibleComponents I hI.1)

  have hLFT_Sd : AlgebraicGeometry.LocallyOfFiniteType S_d.hom := by
    change AlgebraicGeometry.LocallyOfFiniteType
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin d_rel) k)))
    rw [← MvPolynomial.algebraMap_eq]
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr
      ((RingHom.finiteType_algebraMap (A := k) (B := MvPolynomial (Fin d_rel) k)).mpr
        inferInstance)
  have hLFT_pA1 : AlgebraicGeometry.LocallyOfFiniteType p_A1 := by
    change AlgebraicGeometry.LocallyOfFiniteType
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))
    rw [← Polynomial.algebraMap_eq]
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr
      ((RingHom.finiteType_algebraMap (A := k) (B := Polynomial k)).mpr inferInstance)
  have _ : AlgebraicGeometry.LocallyOfFiniteType S_d.hom := hLFT_Sd
  have _ : AlgebraicGeometry.LocallyOfFiniteType p_A1 := hLFT_pA1
  have _ : AlgebraicGeometry.LocallyOfFiniteType
      (CategoryTheory.Limits.pullback.fst S_d.hom p_A1) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback S_d.hom p_A1).flip hLFT_pA1

  let S₁ := CategoryTheory.Limits.pullback j_d w₀
  let S₂ := W₀
  let h_mor : S₁ ⟶ S₂ := CategoryTheory.Limits.pullback.snd j_d w₀
  have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h_mor :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.Etale) h_mor :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor S₂.Etale S₁.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h_mor

  have h_basis : ∀ (E : S₂.Etale) (x : ↥E.left),
      ∃ (O_et : S₂.Etale) (f_O : O_et ⟶ E) (y : ↥O_et.left),
        AlgebraicGeometry.Etale f_O.left ∧
        f_O.left.base y = x ∧
        ConnectedSpace ↥O_et.left ∧
        ConnectedSpace ↥(B.obj O_et).left := by
    intro E x
    obtain ⟨U_x, hAff_Ux, hx_Ux, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := (⊤ : E.left.Opens)) trivial
    let R₀ : CommRingCat.{u} := E.left.presheaf.obj (Opposite.op U_x)
    have _ : AlgebraicGeometry.Etale E.hom := E.prop
    let f_k : AlgebraicGeometry.Spec R₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      hAff_Ux.isoSpec.inv ≫ U_x.ι ≫ E.hom ≫ w₀ ≫
        CategoryTheory.Limits.pullback.fst S_d.hom p_A1 ≫ S_d.hom
    have hLFT_fk : AlgebraicGeometry.LocallyOfFiniteType f_k := by
      dsimp [f_k]
      infer_instance
    have hNoeth_R₀ : IsNoetherianRing ↑R₀ := by
      have hf_eq : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage f_k) = f_k :=
        AlgebraicGeometry.Spec.map_preimage f_k
      have hLFT_map : AlgebraicGeometry.LocallyOfFiniteType
          (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage f_k)) := by
        rw [hf_eq]
        exact hLFT_fk
      have hFT : (AlgebraicGeometry.Spec.preimage f_k).hom.FiniteType :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_map
      let _ : Algebra k ↑R₀ := (AlgebraicGeometry.Spec.preimage f_k).hom.toAlgebra
      have _ : Algebra.FiniteType k ↑R₀ := hFT
      exact Algebra.FiniteType.isNoetherianRing k ↑R₀
    have _ : IsNoetherianRing ↑R₀ := hNoeth_R₀
    let x₀ : ↥U_x.toScheme := ⟨x, hx_Ux⟩
    let p₀ : PrimeSpectrum ↑R₀ := hAff_Ux.isoSpec.hom.base x₀
    obtain ⟨e, -, he⟩ :=
      PrimeSpectrum.exists_idempotent_basicOpen_eq_of_isClopen (h_noeth_clopen p₀)
    let D_e : (AlgebraicGeometry.Spec R₀).Opens := PrimeSpectrum.basicOpen e
    have hAff_De : AlgebraicGeometry.IsAffineOpen D_e :=
      AlgebraicGeometry.IsAffineOpen.Spec_basicOpen e
    have _ : AlgebraicGeometry.IsAffine D_e.toScheme := hAff_De
    have hp₀_De : p₀ ∈ D_e := by
      change p₀ ∈ (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum ↑R₀))
      rw [← he]
      exact mem_connectedComponent
    let y₀ : ↥D_e.toScheme := ⟨p₀, hp₀_De⟩
    have hConn_De : ConnectedSpace ↥D_e.toScheme := by
      have hConn_set : _root_.IsConnected
          ((D_e : (AlgebraicGeometry.Spec R₀).Opens) : Set ↥(AlgebraicGeometry.Spec R₀)) := by
        change _root_.IsConnected (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum ↑R₀))
        rw [← he]
        exact isConnected_connectedComponent
      exact isConnected_iff_connectedSpace.mp hConn_set
    let u_O : D_e.toScheme ⟶ E.left := D_e.ι ≫ hAff_Ux.isoSpec.inv ≫ U_x.ι
    have hEt_uO : AlgebraicGeometry.Etale u_O := by
      dsimp [u_O]
      infer_instance
    have huO_y₀ : u_O.base y₀ = x := by
      change U_x.ι.base (hAff_Ux.isoSpec.inv.base (D_e.ι.base y₀)) = x
      have h1 : D_e.ι.base y₀ = p₀ := AlgebraicGeometry.Scheme.Opens.ι_apply D_e y₀
      have h2 : hAff_Ux.isoSpec.inv.base p₀ = x₀ := by
        change (hAff_Ux.isoSpec.hom ≫ hAff_Ux.isoSpec.inv).base x₀ = x₀
        rw [hAff_Ux.isoSpec.hom_inv_id]
        rfl
      rw [h1, h2]
      exact AlgebraicGeometry.Scheme.Opens.ι_apply U_x x₀
    let e_O : D_e.toScheme ⟶ S₂ := u_O ≫ E.hom
    have hEt_eO : AlgebraicGeometry.Etale e_O :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        u_O E.hom hEt_uO E.prop
    have hEt_eOw₀ : AlgebraicGeometry.Etale (e_O ≫ w₀) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        e_O w₀ hEt_eO hEt_w₀
    have _ : AlgebraicGeometry.Etale (e_O ≫ w₀) := hEt_eOw₀
    let O_et : S₂.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ e_O hEt_eO
    let f_O : O_et ⟶ E := CategoryTheory.MorphismProperty.Over.homMk u_O rfl trivial
    obtain ⟨hConn_jw, -⟩ := hPur0 D_e.toScheme (e_O ≫ w₀) hConn_De ⟨y₀⟩
    have hPb_paste : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd e_O h_mor ≫
          CategoryTheory.Limits.pullback.fst j_d w₀)
        (CategoryTheory.Limits.pullback.fst e_O h_mor)
        j_d (e_O ≫ w₀) :=
      (CategoryTheory.IsPullback.of_hasPullback e_O h_mor).flip.paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback j_d w₀)
    let e_paste := hPb_paste.isoPullback
    have hSurj_paste : Function.Surjective e_paste.inv.base := by
      intro z
      refine ⟨e_paste.hom.base z, ?_⟩
      change (e_paste.hom ≫ e_paste.inv).base z = z
      rw [e_paste.hom_inv_id]
      rfl
    have hConn_BO : ConnectedSpace ↥(CategoryTheory.Limits.pullback e_O h_mor) :=
      @Function.Surjective.connectedSpace _ _ _ hConn_jw _ _ hSurj_paste e_paste.inv.continuous
    exact ⟨O_et, f_O, y₀, hEt_uO, huO_y₀, hConn_De, hConn_BO⟩

  
  have h_unit_iso_conn : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u})
      (E₀ : Z.Etale) [ConnectedSpace ↥E₀.left],
      CategoryTheory.IsIso
        (((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj A)).app (Opposite.op E₀)) := by
    intro Z A E₀ _
    let P_A : CategoryTheory.Functor (Opposite Z.Etale) AddCommGrpCat.{u} :=
      { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥A)
        map := fun {E₁ E₂} f =>
          AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom (Z := ↥A) f.unop.left.base.hom)
        map_id := fun _ => by
          apply AddCommGrpCat.ext
          intro g
          ext x
          rfl
        map_comp := fun _ _ => by
          apply AddCommGrpCat.ext
          intro g
          ext x
          rfl }
    let P_const := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj A
    let θ_A : P_const ⟶ P_A :=
      { app := fun E =>
          AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom (X := ↥E.unop.left) (Y := ↥A))
        naturality := fun _ _ _ => by
          apply AddCommGrpCat.ext
          intro a
          ext x
          rfl }
    have hP_sheaf : CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology P_A := by
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro E S hS
      have hcov := (h_mem_etale Z E S).mp hS
      let eval_c : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w : S.arrows.category) (_ : ↥c.pt), LocallyConstant ↥w.obj.left.left ↥A :=
        fun c w m_pt => (c.π.app (Opposite.op w)).hom m_pt
      have h_ov : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w₁ w₂ : S.arrows.category) (m_pt : ↥c.pt)
          (y₁ : ↥w₁.obj.left.left) (y₂ : ↥w₂.obj.left.left),
          w₁.obj.hom.left.base y₁ = w₂.obj.hom.left.base y₂ →
          eval_c c w₁ m_pt y₁ = eval_c c w₂ m_pt y₂ := by
        intro c w₁ w₂ m_pt y₁ y₂ hy_eq
        let u₁ : w₁.obj.left ⟶ E := w₁.obj.hom
        let u₂ : w₂.obj.left ⟶ E := w₂.obj.hom
        have hu₂_et : AlgebraicGeometry.Etale u₂.left := h_mor_etale u₂
        let Z_sch := CategoryTheory.Limits.pullback u₁.left u₂.left
        let p₁ : Z_sch ⟶ w₁.obj.left.left := CategoryTheory.Limits.pullback.fst u₁.left u₂.left
        let p₂ : Z_sch ⟶ w₂.obj.left.left := CategoryTheory.Limits.pullback.snd u₁.left u₂.left
        have hp₁_et : AlgebraicGeometry.Etale p₁ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback u₁.left u₂.left).flip hu₂_et
        have hZ_et : AlgebraicGeometry.Etale (p₁ ≫ w₁.obj.left.hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            p₁ w₁.obj.left.hom hp₁_et w₁.obj.left.prop
        let Z_et : Z.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ w₁.obj.left.hom) hZ_et
        let q₁ : Z_et ⟶ w₁.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
        have hq₂_w : p₂ ≫ w₂.obj.left.hom = Z_et.hom :=
          (congrArg (p₂ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₂).symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ E.hom) CategoryTheory.Limits.pullback.condition.symm).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (p₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₁)))))
        let q₂ : Z_et ⟶ w₂.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₂ hq₂_w trivial
        have hq_comm : q₁ ≫ u₁ = q₂ ≫ u₂ := by
          apply (AlgebraicGeometry.Scheme.Etale.forget Z).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact CategoryTheory.Limits.pullback.condition
        let w₁₂ : S.arrows.category :=
          ⟨CategoryTheory.Over.mk (q₁ ≫ u₁), S.downward_closed w₁.property q₁⟩
        let mor₁ : w₁₂ ⟶ w₁ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₁ rfl)
        let mor₂ : w₁₂ ⟶ w₂ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₂ hq_comm.symm)
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy_eq
        have hev₁ : eval_c c w₁ m_pt (p₁.base z) = eval_c c w₁₂ m_pt z :=
          congrArg (fun φ => (φ.hom m_pt : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₁.op)
        have hev₂ : eval_c c w₂ m_pt (p₂.base z) = eval_c c w₁₂ m_pt z :=
          congrArg (fun φ => (φ.hom m_pt : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₂.op)
        rw [← hz₁, ← hz₂, hev₁, hev₂]
      refine ⟨{
        lift := fun c =>
          let g_fn : ↥c.pt → ↥E.left → ↥A := fun m_pt x =>
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            eval_c c w_x m_pt y_x
          have hg_eq : ∀ (m_pt : ↥c.pt) (w : S.arrows.category) (y : ↥w.obj.left.left),
              g_fn m_pt (w.obj.hom.left.base y) = eval_c c w m_pt y := by
            intro m_pt w y
            let x := w.obj.hom.left.base y
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            exact h_ov c w_x w m_pt y_x y hy_x
          have hg_lc : ∀ m_pt : ↥c.pt, IsLocallyConstant (g_fn m_pt) := by
            intro m_pt
            rw [IsLocallyConstant.iff_isOpen_fiber]
            intro a
            rw [isOpen_iff_forall_mem_open]
            intro x hx
            let ch := hcov x
            let Y_x := ch.choose
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hEt_x := ch.choose_spec.choose_spec.choose_spec.2.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            let f_x : LocallyConstant ↥Y_x.left ↥A := eval_c c w_x m_pt
            let O : Set ↥Y_x.left := f_x ⁻¹' {a}
            have hO_open : IsOpen O := f_x.isLocallyConstant {a}
            have : AlgebraicGeometry.Etale u_x.left := hEt_x
            have hu_open : IsOpen (u_x.left.base '' O) := u_x.left.isOpenMap O hO_open
            refine ⟨u_x.left.base '' O, ?_, hu_open, ⟨y_x, ?_, hy_x⟩⟩
            · rintro _ ⟨y', hy', rfl⟩
              change g_fn m_pt (w_x.obj.hom.left.base y') = a
              rw [hg_eq m_pt w_x y']
              exact hy'
            · change f_x y_x = a
              have hfx : f_x y_x = g_fn m_pt x := rfl
              rw [hfx]
              exact hx
          AddCommGrpCat.ofHom
            { toFun := fun m_pt => ⟨g_fn m_pt, hg_lc m_pt⟩
              map_zero' := by
                apply LocallyConstant.ext
                intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                have h0 : eval_c c w_x 0 = 0 := map_zero (c.π.app (Opposite.op w_x)).hom
                exact congrArg (fun f : LocallyConstant ↥w_x.obj.left.left ↥A => f y_x) h0
              map_add' := fun m₁ m₂ => by
                apply LocallyConstant.ext
                intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                have hadd : eval_c c w_x (m₁ + m₂) = eval_c c w_x m₁ + eval_c c w_x m₂ :=
                  map_add (c.π.app (Opposite.op w_x)).hom m₁ m₂
                exact congrArg (fun f : LocallyConstant ↥w_x.obj.left.left ↥A => f y_x) hadd }
        fac := fun c j_idx => by
          apply AddCommGrpCat.ext
          intro m_pt
          change _ = eval_c c j_idx.unop m_pt
          ext y
          let x := j_idx.unop.obj.hom.left.base y
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          exact h_ov c w_x j_idx.unop m_pt y_x y hy_x
        uniq := fun c k hk => by
          apply AddCommGrpCat.ext
          intro m_pt
          let km : LocallyConstant ↥E.left ↥A := k.hom m_pt
          change km = _
          apply LocallyConstant.ext
          intro x
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          have hkx := congrArg
            (fun φ => (φ.hom m_pt : LocallyConstant ↥w_x.obj.left.left ↥A) y_x)
            (hk (Opposite.op w_x))
          change km (u_x.left.base y_x) = eval_c c w_x m_pt y_x at hkx
          rw [hy_x] at hkx
          exact hkx
      }⟩
    have hLocInj : CategoryTheory.Presheaf.IsLocallyInjective Z.smallEtaleTopology θ_A := by
      refine CategoryTheory.Presheaf.IsLocallyInjective.mk ?_
      intro E a₁ a₂ ha
      by_cases hEmp : IsEmpty ↥E.unop.left
      · have hbot : ⊥ ∈ Z.smallEtaleTopology E.unop := by
          let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme :=
            @AlgebraicGeometry.Etale
          let E' : P.Over ⊤ Z := E.unop
          change (⊥ : CategoryTheory.Sieve E') ∈
            ((CategoryTheory.MorphismProperty.Over.forget P ⊤ Z).restrictedTopology
              (AlgebraicGeometry.Scheme.overGrothendieckTopology P Z)) E'
          rw [CategoryTheory.Functor.mem_restrictedTopology_iff]
          exact (CategoryTheory.GrothendieckTopology.mem_over_iff _ _).mpr
            (CategoryTheory.GrothendieckTopology.superset_covering _ bot_le
              (AlgebraicGeometry.Scheme.bot_mem_grothendieckTopology E.unop.left))
        exact Z.smallEtaleTopology.superset_covering bot_le hbot
      · obtain ⟨x₀⟩ := not_isEmpty_iff.mp hEmp
        have ha_eq : a₁ = a₂ := congrArg (fun f : LocallyConstant ↥E.unop.left ↥A => f x₀) ha
        subst ha_eq
        have htop : CategoryTheory.Presheaf.equalizerSieve
            (F := P_const) (X := E) a₁ a₁ = ⊤ := by
          apply CategoryTheory.Sieve.id_mem_iff_eq_top.mp
          rfl
        rw [htop]
        exact Z.smallEtaleTopology.top_mem E.unop
    have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective Z.smallEtaleTopology θ_A := by
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
      intro E f
      refine (h_mem_etale Z E (CategoryTheory.Presheaf.imageSieve θ_A f)).mpr ?_
      intro x
      let f_lc : LocallyConstant ↥E.left ↥A := f
      let a : ↥A := f_lc x
      let O_a : E.left.Opens := ⟨f_lc ⁻¹' {a}, f_lc.isLocallyConstant {a}⟩
      have hY_et : AlgebraicGeometry.Etale (O_a.ι ≫ E.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          O_a.ι E.hom inferInstance E.prop
      let Y_a : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_a.ι ≫ E.hom) hY_et
      let u_a : Y_a ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_a.ι rfl trivial
      refine ⟨Y_a, u_a, ⟨x, rfl⟩, ?_, inferInstance, rfl⟩
      refine ⟨a, ?_⟩
      ext y
      exact y.2.symm
    have hW_θ : Z.smallEtaleTopology.W θ_A :=
      (Z.smallEtaleTopology.W_iff_isLocallyBijective θ_A).mpr ⟨hLocInj, hLocSurj⟩
    have hIso_map : CategoryTheory.IsIso
        ((CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map θ_A) :=
      (Z.smallEtaleTopology.W_iff θ_A).mp hW_θ
    let ℒ_A : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} := ⟨P_A, hP_sheaf⟩
    let adj_sh := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let Υ_A : (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj A ⟶ ℒ_A :=
      (adj_sh.homEquiv P_const ℒ_A).symm θ_A
    have hΥ_eq : Υ_A =
        (CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map θ_A ≫
          adj_sh.counit.app ℒ_A := by
      dsimp [Υ_A]
      exact CategoryTheory.Adjunction.homEquiv_counit adj_sh P_const ℒ_A θ_A
    have hIso_counit : CategoryTheory.IsIso (adj_sh.counit.app ℒ_A) := inferInstance
    have : CategoryTheory.IsIso Υ_A := by
      rw [hΥ_eq]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_map hIso_counit
    let Γ_E₀ := (CategoryTheory.sheafSections Z.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op E₀)
    have hIso_ΥE₀ : CategoryTheory.IsIso (Υ_A.hom.app (Opposite.op E₀)) := by
      change CategoryTheory.IsIso (Γ_E₀.map Υ_A)
      infer_instance
    have h_unit_Υ : adj_sh.unit.app P_const ≫ Υ_A.hom = θ_A := by
      have h1 := (adj_sh.homEquiv P_const ℒ_A).apply_symm_apply θ_A
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
